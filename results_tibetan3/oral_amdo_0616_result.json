{
  "leixing": "oral_amdo",
  "entries": [
    {
      "id": 1,
      "tibetan": "ས་འམ་ཆུ་ཀླུང་གི་རྒྱུད་དམཉ།",
      "chinese": "一个或多个河流的河道。"
    },
    {
      "id": 2,
      "tibetan": "གཟུགས་བརྙན་དེ་ཆུ་ཀླུང་གི་རྒྱུན་གྱིས་ཀྱང་ཁྱེར་བར་མི་ནུས་སོ།",
      "chinese": "连大江大河也无法冲走。"
    },
    {
      "id": 3,
      "tibetan": "དང་བ་སྣ་ཚོགས་དེ་དག་གིས་ཀྱང་གཟུགས་བརྙན་དེ་ལ་གོས་པར་མི་འགྱུར་ཏེ།",
      "chinese": "而且这些各种情感也不会使这种形象受到影响。"
    },
    {
      "id": 4,
      "tibetan": "དེ་དག་ཏུ་གཟུགས་བརྙན་རྣམ་པར་དམིགས་པའང་ཡོད་ཅིང་དེ་དག་གིས་བཟུང་བ་འདྲ་ཡང་གཟུགས་བརྙན་གང་དུ་དམིགས་པར་གྱུར་པ་དེས་དེའི་ཆ་བཟུངསྲེབ་མེད་དོ།",
      "chinese": "它们也都有形象形式的倾向，虽然它们似乎抓住了形象，但依照它们所抓住的形象形式而变。"
    },
    {
      "id": 5,
      "tibetan": "འདི་ནི་བདག་གི་ཡེ་ཤེས་ཀྱི་རྒྱུད་དོ།",
      "chinese": "这是我的圣经。"
    },
    {
      "id": 6,
      "tibetan": "འདི་ནི་བདག་གི་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་ཏོ་ཞེས་གཉིས་སུ་མི་བྱེད་དོ།",
      "chinese": "这就是我所谓的佛光之道。"
    },
    {
      "id": 7,
      "tibetan": "བདག་གི་ཡུལ་དང་གཞནཙྭགྱི་ཡུལ་རྣམ་པར་དབྱེ་བའང་རབ་ཏུ་ཤེས་སོ།",
      "chinese": "我家与人家，亦分明于此。"
    },
    {
      "id": 8,
      "tibetan": "རྗེས་སུ་སོང་བའི་ལུས་ཀྱང་འཇིག་རྟེན་ཐམས་ཅད་དུ་ཕྱིན་པར་བྱེད་དོ།",
      "chinese": "行走的身影，遍于世界。"
    },
    {
      "id": 9,
      "tibetan": "བདེ་བ་དང་སྡུག་བསྔལ་ཐམས་ཅད་ཀྱི་ཕྱིན་ཅི་ལོག་གིས་ལསྤྲུལ་པ་དང་།",
      "chinese": "一切幸福与痛苦的反面，都是神变。"
    },
    {
      "id": 10,
      "tibetan": "ཚིག་གི་ལམ་གྱི་བྱིན་གྱི་རླབས་ཀྱིསཤེསྤྲུལ་པ་དང་།",
      "chinese": "语音幻化，语音变身。"
    },
    {
      "id": 11,
      "tibetan": "ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་ཡོངས་སུ་རྟོག་པས་སྤྲུལ་པ་དང་།",
      "chinese": "一切烦恼都是虚空幻想的产物。"
    },
    {
      "id": 12,
      "tibetan": "ཀུན་ནས་ཉོན་མོངས་པ་མ་ཡིན།",
      "chinese": "并非普遍的。"
    },
    {
      "id": 13,
      "tibetan": "ནམ་མཁའ་ལྟ་བུའི་ངག་གི་ལས་རབ་ཏུ་འཐོབ་༧བོ།",
      "chinese": "有如天空般的口头禅。"
    },
    {
      "id": 14,
      "tibetan": "འདི་ལྟ་སྟེ་དཔེར་ན་ནམ་མཁའ་ནི་ཀུན་ནས་ཉོན་མོངས་པས་ཉོན་མོངས་པར་གྱུར་པའང་མེད་ལ་རྣམ་པར་བྱང་བས་རྣམ་པར་བྱང་བར་གྱུར་པ་ཡང་མེད་དོ།",
      "chinese": "比如空中，空中并不是被烦恼所烦恼，也不是被清净所清净。"
    },
    {
      "id": 15,
      "tibetan": "འདི་ལྟ་སྟེ་དཔེར་ན་ནམ་མཁའ་ནི་འཇིག་རྟེན་ཐམས་ཅད་ཀྱི་མངོན་སུམ་དུ་གྱུར་པ་ཡིནམོ།",
      "chinese": "比方说，天空是一切的实在。"
    },
    {
      "id": 16,
      "tibetan": "དབྱངས་ཀྱིས་མོས་པ་རབ་ཏུ་འཐོབ།",
      "chinese": "音乐引起极大的喜悦。"
    },
    {
      "id": 17,
      "tibetan": "བུ་མོ་དེ་བཞིན་རྣམ་པར་དུལ་བ་ཉེ་བར་སྟོནས།",
      "chinese": "像那个女孩那样乖巧的向我走近。"
    },
    {
      "id": 18,
      "tibetan": "ཇི་ལྟར་ཉོན་མོངས་དེ་བཞིན་རྣམ་པར་བྱང་བ་རབ་ཏུ་ཤེས།",
      "chinese": "如何知道烦恼以及解除烦恼。"
    },
    {
      "id": 19,
      "tibetan": "བཟོད་པ་བཅུ་པོ་འདི་དག་དེ་དག་གི།",
      "chinese": "这十条仁慈的训诫。"
    },
    {
      "id": 20,
      "tibetan": "སྐྱེས་བུ་དམ་པ་དེ་ལྟར་ཁྱོད་ཀྱིས་འཇིག་རྟེན་ཐམས་ཅད་གྲངས་ཀྱི་རྗེས་སུ་འཇུག་པར་བྱ་བའི་ཕྱིར།",
      "chinese": "正如君主那样，你把一切归于数字之后。"
    },
    {
      "id": 21,
      "tibetan": "བྱང་བྱིང་བྱང་བྱིང་ན་ཆེམ་ཆེམ་མོ།",
      "chinese": "北风吹，树叶摇曳。"
    },
    {
      "id": 22,
      "tibetan": "ཆོ་མ་ཆོ་མ་ན་ཁྲམ་ཁྲིམ་མོ།",
      "chinese": "乔玛乔玛病了。"
    },
    {
      "id": 23,
      "tibetan": "ཁྲམ་ཁྲིམ་ཁྲམ་ཁྲིམ་ན་ནབ་གི་ནུབ་བོ།",
      "chinese": "我很疼。"
    },
    {
      "id": 24,
      "tibetan": "ཡག་ཡག་ཡག་ཡག་ན་ཐམ་ཐིམ་མོ།",
      "chinese": "美美美美就可以美美美美了。"
    },
    {
      "id": 25,
      "tibetan": "གཞལ་འཁོར་གཞལ་འཁོར་ན་གཞལ་ཐིམ་མོ།",
      "chinese": "圆周内测为圆周。"
    },
    {
      "id": 26,
      "tibetan": "རེམ་འདྲོལ་རེམ་འདྲོལ་ན་རྫི་ངད་དོ།",
      "chinese": "火烧，火烧，热得人受不了。"
    },
    {
      "id": 27,
      "tibetan": "བུན་ལོབ་བུན་ལོབ་ན་ལམ་ལོམ་མོ།",
      "chinese": "哐当哐当，砰砰砰。"
    },
    {
      "id": 28,
      "tibetan": "འབུམ་རྡིབ་འབུམ་རྡིབ་ན་གམ་གུམ་མོ།",
      "chinese": "万劫不复！"
    },
    {
      "id": 29,
      "tibetan": "སྐད་ཅིག་རེ་རེརསའཇིག་པ་བརྗོད་དུ་མེད།་",
      "chinese": "每一刻都在不断地消逝"
    },
    {
      "id": 30,
      "tibetan": "སྐྲ་རྩེ་རེ་རེ་ཀུན་ལ་ཡང་དག་འཇུག།",
      "chinese": "每一根头发都在正确的位置。"
    },
    {
      "id": 31,
      "tibetan": "མིང་གི་ཚོགས་ཀྱང་བརྗོད་དུ་མེད་པ་སྟེ།",
      "chinese": "无可比拟的。"
    },
    {
      "id": 32,
      "tibetan": "འོད་ཟེརསྙིརེ་རེ་ལས་ཀྱང་བརྗོད་མེད་པའི།",
      "chinese": "每一道光芒都传递着"
    },
    {
      "id": 33,
      "tibetan": "པད་མོ་བརྗོད་དུ་མེད་པ་མང་པོ་འབྱུང་།",
      "chinese": "会有很多不堪回首的回忆。"
    },
    {
      "id": 34,
      "tibetan": "པད་མོ་རེ་རེ་ལས་ཀྱང་ཡེབརྗོད་མེད་པའི།",
      "chinese": "比一朵朵牡丹还要无语。"
    },
    {
      "id": 35,
      "tibetan": "ཁ་དོག་རེ་རེ་དེ་བཞིན་བརྗོད་དུ་མེད།",
      "chinese": "每一种颜色都如此绚丽。"
    },
    {
      "id": 36,
      "tibetan": "པད་མོ་རེ་རེ་ལོ་མཚཚབརྗོད་དུ་མེད།",
      "chinese": "一朵朵荷花年年不减。"
    },
    {
      "id": 37,
      "tibetan": "ལོ་མ་རེ་རེའི་འོད་གཟེར་ཧུ་༧བརྗོད་དུ་མེད།",
      "chinese": "每片叶子光芒耀眼"
    },
    {
      "id": 38,
      "tibetan": "ཁ་དོག་རེ་རེ་བརྗོད་མེད་༧དེ་དག་ལས།",
      "chinese": "每个颜色没有7个字。"
    },
    {
      "id": 39,
      "tibetan": "ཟླ་བསྔོ་རེ་རེ་ལས་ཀྱང་བརྗོད་མེད་པའི།",
      "chinese": "比每个月更无语"
    },
    {
      "id": 40,
      "tibetan": "ཁ་དོག་རེ་རེ་ལས་ཀྱང་བརྗོད་མེད་པའི།",
      "chinese": "比每一种颜色都更无语的"
    },
    {
      "id": 41,
      "tibetan": "ཉི་མ་རེ་རེ་ལས་ཀྱང་བརྗོད་མེད་པའི།",
      "chinese": "一天比一天更好。"
    },
    {
      "id": 42,
      "tibetan": "ཁ་དོག་རེ་རེ་ལས་ཀྱང་བརྗོད་མེད་རྟེཔའི།",
      "chinese": "每一种颜色都暗示着"
    },
    {
      "id": 43,
      "tibetan": "འོད་ཟེར་༥༡རེ་རེ་ལའང་བརྗོད་མེད་པའི།",
      "chinese": "每一道51光束。"
    },
    {
      "id": 44,
      "tibetan": "སེང་གེའི་ཁྲི་མང་སྣ་ཚོགས་རེ་རེ་ལས།",
      "chinese": "每一座狮子宝座"
    },
    {
      "id": 45,
      "tibetan": "རྣམ་པར་སྣང་བ་སྣ་ཚོགས་རེ་རེ་ལས།",
      "chinese": "各种各样的形象。"
    },
    {
      "id": 46,
      "tibetan": "རི་རབ་པད་མོའི་མཆོག་དང་ལྡན་པ་འབྱུང་།",
      "chinese": "将产生如莲花般的佛身。"
    },
    {
      "id": 47,
      "tibetan": "རི་རབ་གཅིག་གིས་ཡོངས་སུ་རྒྱས་པ་སྟེ།",
      "chinese": "一座山崩地裂。"
    },
    {
      "id": 48,
      "tibetan": "རི་རབ་ལྷག་མ་རྣམས་ཀྱང་དེ་ཙམ་མོ།",
      "chinese": "剩下的诸山亦是如此。"
    },
    {
      "id": 49,
      "tibetan": "འཁོར་ལོ་རེ་རེ་བསྐོར་བས་བརྗོད་མེད་པའི།",
      "chinese": "每转一轮。"
    },
    {
      "id": 50,
      "tibetan": "ཤིན་ཏུ་བསྟན་པ་བརྗོད་མེད་རེ་རེ་ཡང་ཤེ།",
      "chinese": "非常指出没有一句也没有。"
    },
    {
      "id": 51,
      "tibetan": "རྣམ་པར་བསྟན་པ་དེ་དག་རེ་རེ་ཞིང་།",
      "chinese": "这些现象，"
    },
    {
      "id": 52,
      "tibetan": "བསྟན་པ་རེ་རེ་ཞིང་ཡང་བརྗོད་མེད་པའི།",
      "chinese": "每一教，都是无限的。"
    },
    {
      "id": 53,
      "tibetan": "ཚིག་གི་རྣམ་པ་མི་མཐུན་བརྗོད་དུ་མེད།",
      "chinese": "言词不同，表达不一。"
    },
    {
      "id": 54,
      "tibetan": "སྐད་ཅིག་རེ་རེ་དུ་སྤྱོད་ཡུལ་གྱུར་པ་ལ།",
      "chinese": "并且每一瞬间都成为被用到的对象。"
    },
    {
      "id": 55,
      "tibetan": "དག་དང་ཉོན་མོངས་བརྗོད་དུ་མེད་པ་སྟེ།",
      "chinese": "正与邪。"
    },
    {
      "id": 56,
