{
  "leixing": "oral_lhasa",
  "entries": [
    {
      "id": 1,
      "tibetan": "མཉམ་པ་ཉིད་དུ་གནས་པར་ངེས་ཤིང་།",
      "chinese": "同时存在。"
    },
    {
      "id": 2,
      "tibetan": "བོན་སྐུ་འགྱུར་བ་མེད་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "是本雕塑无误的单子。"
    },
    {
      "id": 3,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "皇上。"
    },
    {
      "id": 4,
      "tibetan": "གསལ་བའི་སྒྲོན་མེ་འདེགས་པར་ངེས་ཤིང་།",
      "chinese": "就会举明灯。"
    },
    {
      "id": 5,
      "tibetan": "རང་རིག་ཡེ་ཤེས་སྟོན་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "自证清明之名的名单。"
    },
    {
      "id": 6,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊！"
    },
    {
      "id": 7,
      "tibetan": "འཇིག་རྟེན་འཁོར་ལོ་བསྒྱུར་བའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "改变世界的单子"
    },
    {
      "id": 8,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "大王。"
    },
    {
      "id": 9,
      "tibetan": "སེམས་སྐྱེད་མ་བཞི་དང་ལྡན་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "心怀四念的托雅。"
    },
    {
      "id": 10,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王者。"
    },
    {
      "id": 11,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "大王。"
    },
    {
      "id": 12,
      "tibetan": "ཝ་ནི་དོན་ལ་ཝལ་ཝོལ་མེད་པར།",
      "chinese": "狐狸心思不杂。"
    },
    {
      "id": 13,
      "tibetan": "དོན་དམ་གཅིག་ཏུ་རྣམ་པར་ངེས་ཤིང་།",
      "chinese": "其实是一种认同。"
    },
    {
      "id": 14,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "大王。"
    },
    {
      "id": 15,
      "tibetan": "མ་བཅོས་མཉམ་པའི་ངང་ལ་གནས་པར་ངེས་ཤིང་།",
      "chinese": "自然地保持平衡。"
    },
    {
      "id": 16,
      "tibetan": "ཆ་ལུགས་ལྔ་དང་ལྡན་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "五体投地，奉行守信。"
    },
    {
      "id": 17,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "大王，"
    },
    {
      "id": 18,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊！"
    },
    {
      "id": 19,
      "tibetan": "སྤྲུལ་པའི་འོད་ཟེར་འགྱེད་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "是光辉的化身，光明的记录。"
    },
    {
      "id": 20,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊。"
    },
    {
      "id": 21,
      "tibetan": "སྐྱེ་ཤི་རྩད་ནས་གཅོད་པར་ངེས་ཤིང་།",
      "chinese": "必定要生杀大计"
    },
    {
      "id": 22,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "大王。"
    },
    {
      "id": 23,
      "tibetan": "རང་རིག་བདག་ཞལ་མཐོང་བའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "我见了智旦的单子。"
    },
    {
      "id": 24,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "陛下。"
    },
    {
      "id": 25,
      "tibetan": "ངང་པ་ལྟ་བུའི་འགྲོས་དང་ལྡན་པར་ངེས་ཤིང་།",
      "chinese": "一定会像鹅一样快捷地。"
    },
    {
      "id": 26,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "大王，"
    },
    {
      "id": 27,
      "tibetan": "རང་འབྱུང་འགག་པ་མེད་པར་ངེས་ཤིང་།",
      "chinese": "自然不生阻塞。"
    },
    {
      "id": 28,
      "tibetan": "ཐབས་ཤེས་ཟུང་དུ་འབྲེལ་བའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "方法结合的单子。"
    },
    {
      "id": 29,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "大王。"
    },
    {
      "id": 30,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "大王。"
    },
    {
      "id": 31,
      "tibetan": "བདུད་དང་མུ་སྟེགས་སྐྲག་པར་ངེས་ཤིང་།",
      "chinese": "魔鬼和邪恶会害怕。"
    },
    {
      "id": 32,
      "tibetan": "ཕ་རོལ་བར་ཆོད་ཟློག་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "对对方抵销的单据。"
    },
    {
      "id": 33,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊！"
    },
    {
      "id": 34,
      "tibetan": "མ་བཅོས་པའི་ཐིག་ལེ་གཅིག་ལ་འཇོག་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "只存放一个未经处理的零件的单子。"
    },
    {
      "id": 35,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊！"
    },
    {
      "id": 36,
      "tibetan": "དབུ་སྐྲ་ཐོན་མཐིང་གཡས་སུ་འཁྱིལ་པར་ངེས་ཤིང་།",
      "chinese": "头发必定是右旋的。"
    },
    {
      "id": 37,
      "tibetan": "འགྲོ་དྲུག་ཐར་ལམ་དབྱིངས་སུ་འདྲེན་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "六道解脱咒。"
    },
    {
      "id": 38,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊！"
    },
    {
      "id": 39,
      "tibetan": "དོན་དམ་བོན་ཉིད་ཀློང་དུ་བདེན་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "真实的灵性是天书。"
    },
    {
      "id": 40,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊。"
    },
    {
      "id": 41,
      "tibetan": "ཚེག་ནི་མི་འཁྲུགས་མཉམ་པར་འབྱེད་པ་ལ།",
      "chinese": "点是用来分开不相干的。"
    },
    {
      "id": 42,
      "tibetan": "བརྒྱ་སྟོང་ཁྲི་འབུམ་བརྗོད་ལས་འདས་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "数不尽的帐单！"
    },
    {
      "id": 43,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊！"
    },
    {
      "id": 44,
      "tibetan": "བཀྲ་ཤིས་རྟགས་ཀྱིས་བརྒྱན་པར་ཤེས་ཤིང་།",
      "chinese": "以吉祥的象征作装饰。"
    },
    {
      "id": 45,
      "tibetan": "ཞིང་ཁམས་བདེ་ལེགས་སྟེར་བའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "“给他安息的单子”"
    },
    {
      "id": 46,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王大哥。"
    },
    {
      "id": 47,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊。"
    },
    {
      "id": 48,
      "tibetan": "འགྲོ་བ་གང་འདུལ་མཁྱེན་པར་ངེས་ཤིང་།",
      "chinese": "能解众生。"
    },
    {
      "id": 49,
      "tibetan": "ཐབས་དང་ཐུགས་རྗེ་ཟུང་དུ་འབྲེལ་བའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "方法与谢意结合的帐单。"
    },
    {
      "id": 50,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "皇上。"
    },
    {
      "id": 51,
      "tibetan": "སྤྲུལ་པ་བྱེ་བ་ས་ཡ་འགྱེད་པར་ངེས་ཤིང་།",
      "chinese": "将会显现出数以千万计的化身。"
    },
    {
      "id": 52,
      "tibetan": "རྗེས་བཞག་མཐའ་རུ་རྒྱས་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "在留在后边的扩展的账户。"
    },
    {
      "id": 53,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊！"
    },
    {
      "id": 54,
      "tibetan": "ལགས་སོ།",
      "chinese": "是！"
    },
    {
      "id": 55,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "大王。"
    },
    {
      "id": 56,
      "tibetan": "རབ་ཏུ་དཔུང་སོགས་བརྗིད་པར་ངེས་ཤིང་།",
      "chinese": "显得十分壮大。"
    },
    {
      "id": 57,
      "tibetan": "གཟི་མདངས་གཞན་ལས་དཔག་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "光辉万丈的招单。"
    },
    {
      "id": 58,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王，陛下。"
    },
    {
      "id": 59,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊。"
    },
    {
      "id": 60,
      "tibetan": "སྐྱེ་མེད་བོན་སྐུ་ལྡན་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "无生有佛的准则。"
    },
    {
      "id": 61,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "皇上。"
    },
    {
      "id": 62,
      "tibetan": "ལོངས་སྤྱོད་རྫོགས་སྐུ་ལྡན་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "享受完毕，勘合帖。"
    },
    {
      "id": 63,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊！"
    },
    {
      "id": 64,
      "tibetan": "རཾ་ནི་སོ་སོར་རྟོགས་པའི་ཡེ་ཤེས་འདོད་ཆགས་རྒྱ་མཚོ་སྐེམ་པར་ངེས་ཤིང་།",
      "chinese": "热是会使欲望海涌退去的。"
    },
    {
      "id": 65,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊！"
    },
    {
      "id": 66,
      "tibetan": "ཛ་ནི་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ང་རྒྱལ་དྲེགས་པ་འཇོམས་པར་ངེས་ཤིང་།",
      "chinese": "智慧如同太阳，它会驱除傲慢。"
    },
    {
      "id": 67,
      "tibetan": "ངོ་བོ་ཉིད་སྐུ་ལྡན་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "是本来就有身分的帐子。"
    },
    {
      "id": 68,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王啊！"
    },
    {
      "id": 69,
      "tibetan": "ཧཱུྃ་ནི་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་ཕྲག་དོག་བཙོན་ར་བཤིག་པར་ངེས་ཤིང་།",
      "chinese": "咒语是成就事业的圣诞，忌妒是毁灭圣诞。"
    },
    {
      "id": 70,
      "tibetan": "མངོན་བྱང་སྐུ་རུ་ལྡན་པའི་ཐོ་ཡིག་ལགས་སོ།",
      "chinese": "可见身上的明信片。"
    },
    {
      "id": 71,
      "tibetan": "ཤིན་ཏུ་ཡང་ཞལ་འཛུམ་པར་མཛད་དོ།",
      "chinese": "非常微笑。"
    },
    {
