      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王者，"
    },
    {
      "id": 76,
      "tibetan": "རྒྱལ་པོ་ལགས།",
      "chinese": "王，"
    },
    {
      "id": 77,
