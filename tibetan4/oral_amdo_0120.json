    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་བསླབ་པར་བྱའོ་ཞེས་རྗེས་སུ་བཅའ་བའི་སྐྱེསྒོ་ནས་གནང་བ་མཛད་དེ།",
    "གང་ཟག་ནི་དགེ་སློང་དོན་ཉུང་ངུ་དག་ཉོན་མོངས་པ་དང་ཉེས་པ་ནི་མེད་དོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་ཤིང་ལ་མི་གང་ཙམ་ལས་མཇོར་མི་འཛེག་པར་བསླབ་པར་བྱའོ་ཞེས་བཀའ་སྩལ་ནས།",
    "སྟག་གིས་མཆོང་བ་བྱས་ཏེ་བསད་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཉོན་མོངས་པ་དང་ཉེས་པ་ནི་མེད་དོ།",
    "དེ་ལ་བདག་གིས་ཚེ་དང་ལྡན་པ་དག་ལ་ཅི་འདི་ལ་ཁྱེད་ཡོངས་སུ་དག་གམ་ཞེས་འདྲིའོ།",
    "སྡོམ་ལ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་དང་།",
    "གང་ཁས་བླང་བར་འོས་པ་ལ་ཁས་བླང་བར་བྱའོ་ཞེས་བྱ་བས་ནི་འཁྲུག་ལོང་གི་ཙུ་རྒྱུ་བཞི་ལས་བྱུང་བའི་འཁྲུག་ལོང་གི་རྩོད་པ་བཞི།",
    "འཁྲུག་ལོང་གི་རྩོད་པ་བཞི་གང་ཞེ་ན།",
    "ཚུལ་ཤིང་མང་པོ་སྦྱིན་པར་འོས་པ་ནི་འཁྲུག་ལོང་གི་རྒྱུ་དང་པོ་དངོས་པོའི་དེ་བཞིན་ཉིད་ལ་ལོག་པར་བསྒྲུབས་པ་ལས་བྱུང་བའི་འཁྲུག་ལོང་འགྱེད་པའི་ཕྱིར་རྩོད་པ་ཡིན་ཏེ།",
    "ཚུལ་ཤིང་མང་པོ་སྦྱིན་པར་འོས་པ་ནི་འཁྲུག་ལོང་གི་རྒྱུ་གཉིས་པ་གདམས་ངག་ལ་སོགས་པ་འཇོག་པས་གཞན་སྤོང་བ་ལས་བྱུང་བའི་འཁྲུག་ལོང་མི་བསྡམས་པའི་ཕྱིར་རྩོད་པ་རྒྱུ་དང་བཅས་པ་ཉིད་ཡིན་ཏེ།",
    "རྩོད་པ་བྱུང་བར་འགྱུར་བ་རྨྱེརྣམས་ཞེས་བྱ་བ་ནི་འཁྲུག་ལོང་གི་རྒྱུ་བཞི་ལས་བྱུང་བའི་འཁྲུག་ལོང་གི་རྩོད་པ་བཞི་པོ་རྣམས་སོ།",
    "མཇུག་གི་གནས་སྐབས་སམ།",
    "དེ་ལ་བདག་གིས་ཚེ་དང་ལྡན་པ་དག་ལ་ཇི་འདི་ལ་ཁྱེད་ཡོངས་སུ་དག་གམ་ཞེས་འདྲིའོ།",
    "དགྲ་བོས་མི་མཐུན་པར་སྨྲས་པའི་ཚིག་གི་ཕྱིར་སེམས་གཞོལ་བ་ཡིན་གྱིས་སྐྱེཁྲོ་བ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་དགྲ་བོས་མི་མཐུན་པར་སྨྲས་པའི་ཚིག་གི་པེཕྱིར་སེམས་གཞོལ་བ་འཁྲུག་ལོང་ཡིན་ལ་དེ་ཉིད་རྩོད་པ་མ་ཡིན་ན།",
    "འདི་ལྟར་འཐབ་པ་ལ་སོགས་པའི་དགྲ་བོས་མི་མཐུན་པར་སྨྲ་བའི་ཚིག་གི་ཙུཕྱིར་སེམས་གཞོལ་བའི་འཁྲུག་ལོང་འདིའི་འཁོར་ཡིན་ཏེ།",
    "བྱ་བའི་རྒྱུ་ལས་རྩོད་པ་ནི་བྱ་བའི་ཕྱིར་རྩོད་པའོ་ཞེས་གསུངས་པ་ལ་རྩོད་པ་བཞི་པོ་གང་དག་ཡིན་པ་དེ་དག་གི་ངོ་བོ་ངེས་པར་གཟུང་བའི་ཕྱིར་འཁྲུག་ལོང་གི་རྒྱུ་བཞི་ལས་འཁྲུག་ལོང་གི་རྩོད་པ་བཞི་གོ་རིམས་བཞིན་དུ་འབྱུང་སྟེ་ཞེས་སྤེསྟེགསུངས་སོ།",
    "འཁྲུག་ལོང་གི་རྒྱུ་བཞི་གང་ཞེ་ན།",
    "རང་གི་ངོ་བོ་ཉིད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལ་དཔྱོད་པ་ཞེས་བྱ་བ་ནི་ཅིའི་ཕྱིར་ཁྱོད་ཀྱི་བྱ་བ་འདི་ནི་མ་བྱས་པར་བྱ་བ་མ་ཡིན་པར་འདི་ནི་བྱ་ཞེའམ།",
    "དངོས་པོའི་རྣམ་པ་ལ་དཔྱོད་པ་དེ་ནི་འཁྲུག་ལོང་གི་རྒྱུ་དང་པོ་ཡིན་ནོ།",
    "དགྲ་བོས་མི་མཐུན་པར་སྨྲས་པའི་ཚིག་གི་ཕྱིར་སེམས་གཞོལ་བའི་འཁྲུག་ལོང་འཐབ་པ་དང་།",
    "ཚེ་དང་ལྡན་པ་ཁྱོད་ལ་བརྗོད་པ་དང་བཅས་པ་ཉིད་བྱས་ཁྱོད་ཀྱིས་གནས་འདི་ནས་མ་ཞུས་པར་འགྲོ་བར་མི་བྱའོ།",
    "གསོ་སྦྱོང་གི་དུས་སུ་དེ་ལ་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་དེའི་གསོ་སྦྱོང་གཞག་པར་བྱའོ།",
    "སྨྱོན་ཀྱེཔས་བྱས་པས་གླེང་བ་དག་གིས་སྤོང་བའོ།",
    "དེ་ལྟར་གདམས་ངག་ལ་སོགས་པ་འཇོག་པས་གཞན་སྒོང་བ་དེ་ནི་འཁྲུག་ལོང་གི་རྒྱུ་གཉིས་པ་ཡིན་ནོ།",
    "ཕྱིར་ཟློག་པར་བྱེད་པ་ཉིད་ཀྱིས་མཐུན་པ་མི་སྦྱིན་པ་འདི་ནི་འཁྲུག་ལོང་གི་རྒྱུ་བཞི་པ་ཡིན་ནོ།",
    "ཕྱིར་ཟློག་པར་བྱེད་པ་ཉིད་ཀྱིས་མཐུན་པ་མི་སྦྱིན་པ་དེ་ལ་བརྟེན་ཏེ་དགྲ་བོས་མི་མཐུན་པར་སྨྲས་པའི་ཚིག་གིས་ཕྱིར་སེམས་གཞོལ་བའི་འཁྲུག་ལོང་འཐབ་པ་དང་།་",
    "འདིར་གཞུང་གི་ཞུ་བ་ལས་ཞི་བ་ཐམས་ཅད་ནི་བྱ་བའི་ཕྱིར་རྩོད་པར་གཞུག་ཏུ་གོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འགྱེད་པ་གཉིས་རང་གིས་མི་ནུས་ན་ཚོགས་པར་དབྱུང་བ་དག་གིས་ལེགས་པར་བསྒྲུབས་པས་ཞི་བར་འགྱུར་རོབྱེ།",
    "གཟུ་བོ་དེ་དག་གིས་དོན་དང་ལོག་པར་བསྒྲུབས།",
    "དེ་དག་གིས་མ་༧ནུས་ཤིང་གཞན་མི་བྱེད་ན་གང་ལས་བླངས་པ་དེ་ལས་དབུལ་བ་དང་།",
    "མ་མོ་འཛིན་པ་དག་ལ་སྔར་བྱུང་བ་བརྗོད་དེ།",
    "དེ་དག་གིས་མ་ནུས་ན་གནས་བརྟན་མཐུ་དང་ལྡན་པ་ལ་སྔར་བྱུང་བ་བརྗོད་དེ།",
    "གླེང་བ་པོའི་གང་ཟག་འགྱེད་པ་གཉིས་རང་གིས་རྩོད་པ་དེ་ཉེ་བར་ཞི་བར་བྱེད་མི་ཞུནུས་ན།",
    "ལུས་དང་ངག་གིས་ཁྲུ་འཇུག་པ་དང་།",
    "ཞེ་སྡང་གིས་འགྲོ་བ་མ་ཡིན་པ་དང་།",
    "གཏི་མུག་གིས་འགྲོ་བ་མ་ཡིན་པ་དང་།",
    "གནས་མལ་བཤམ་པ་བྱས་ནས་གཎྜི་ཚུ་བརྡུངས་ཏེ་དྲིས་པའི་ཚིག་གིས་དགེ་སློང་རྣམས་ལ་ཡང་དག་པར་བསྒོ་ཤཱསྟོནས།"
  ]
}