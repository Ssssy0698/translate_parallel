    "དུར་ཁྲོད་དུ་ཚོའཇུག་མ་ཆེན་མོ་བརྒྱད་ཀྱི་སྔགས་ཀྱི་ཚིག་གོ།",
    "གཡོན་པའི་མཛུབ་༢མོ་བརྐྱང་བ་ནི་གདོང་དྲག་ལྷ་མའི་ཕྱག་རྒྱའོ།",
    "ཁུ་ཚུར་སོ་སོར་བཅངས་ནས་མཐེ་༡ཆུང་གཉིས་འཁྱུད་དེ་མཛུབ་༣མོ་གཉིས་བརྐྱང་ནས་ཁའི་ཕྱོགས་སུ་སྦྱར་བ་ནི་མཆེ་༤རིབ་གཙིགས་མའི་༥ཕྱག་རྒྱའོ།",
    "ལག་༦པ་གཡོན་པ་ཁུ་ཚུར་བཅངས་ཏེ་གུང་མོ་བརྐྱང་བ་ནི་རྒན་མོ་གདོང་གི་ཕྱག་རྒྱའོ།",
    "ཕྱག་རྒྱ་དེ་ཉིད་ལས་༧གུང་མོ་བཀུག་ཅིང་སྲིན་ལག་བརྐྱང་བ་ནི་པདྨའི་མིག་ཅན་མའི་ཕྱག་རྒྱའོ།",
    "ལག་པ་གཡས་པ་ཁུ་ཚུར་བཅངས་ནས་མཛུབ་༡་མོ་བརྐྱང་བ་ནི་སྤྱོད་ངན་མའི་ཕྱག་རྒྱའོ།",
    "དུར་ཁྲོད་དུ་འཇུག་མའི་འབྱུང་མོ་ཆེན་མོ་བརྒྱད་ཀྱི་ཕྱག་རྒྱའི་མཚན་ཉིད་ཀྱི་ཆོ་ག་རྒྱས་པའི་ལེའུའོ།",
    "དུར་ཁྲོད་འཇུག་པའི་འབྱུང་ཆེན་མོ་༡༥།",
    "བྲན་མོའི་སྒྲུབ་ཐབས་དམ་པའོ།",
    "དུར་ཁྲོད་དུ་སོང་ནས་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་སྔོན་དུ་བསྙེན་པ་བྱས་པར་འགྱུར་རོལ།",
    "མཚན་མོ་དུར་ཁྲོད་དུ་སོང་ནས་སེང་ལྡེང་གི་ཡམ་ཤིང་ཞོ་དང་སྦྲང་རྩི་དང་མར་གྱིས་བྱུག་༡༨པས་སྦྱིན་སྲེག་༡༩བརྒྱ་བྱས་ན་དེ་ནས་འབྱུང་མོ་དུར་ཁྲོད་དུ་འཇུག་མ་མྱུར་དུ་འོང་སྟེ།",
    "དེ་ནས་༢་ཞིང་བསྐྱེད་པའི་ཞིང་གི་ལས་བྱེད་ཅིང་ཉི་མ་རེ་རེ་ཞིང་༢༡དོང་ཙེ་༢་རེ་རེ་སྟེར་རོ།",
    "མཚན་མོའི་ཞིང་གི་གསེབ་༢་ཏུ་སོང་སྟེ་ཉ་དང་ཤས་ཇི་ལྟར་གསུངས་པའི་གཏོར་མ་སྦྱིན་ཞིང་ལན་ཉི་ཤུ་རྩ་གཅིག་༡ཡོངས་སུ་བཟླས་ན་ལས་ཀྱི་ཤ་ཟ་མོ་ཇི་ལྟར་བསྟན་པའི་ལས་ཐམས་ཅད་བྱེད་དོ།",
    "མཚན་མོ་དུར་ཁྲོད་དུ་སོང་སྟེ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་ཤ་ཟ་མོ་ཉན་རྣམ་སྒྱུ་མྱུར་དུ་བཟང་མོའི་གཟུགས་ཀྱིས་འོང་སྟེ་མངག་གཞུག་མར་འགྱུར་རོ།",
    "མཚན་མོ་དུར་ཁྲོད་དུ་སོང་ནས་སྟོང་ཕྲག་བརྒྱ་དབཟླས་ན་ཤ་ཟ་མོ་ཉན་རྣམ་ཅའབྱུང་མོའི་འཁོར་ལྔ་བརྒྱས་ཡོངས་སུ་བསྐོར་ཏེ་མྱུར་དུ་འོང་ངོ།",
    "དཔག་ཚད་བརྒྱ་ནས་ཀྱང་བུད་མེད་བཟང་མོ་བླངས་ནས་སྟེར་རོ།",
    "དེ་ནས་འབྱུང་མོ་གཏུམ་མོ་ཆེན་མོ་ཀ་ཏ་ཡ་ན་གཏུམ་མོ་ཆེན་མོ་རྣམས་༡་ལངས་ཏེ།་",
    "ཀ་ཏ་ཡ་ན་ཆེན་མོའིའོ་༡༩ སློ་ཨོཾ་ཧྲཱི་ཧྲཱི་རྩུ་ཧཱུཾ་ཧེ་ཧེ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "དྲག་མོ་ཀ་ཏ་ཡ་ནའིའོ་མི།",
    "ལོ་ཙ་ནི་ཀཱ་མེ་ཤྭ་རི་ཛ་ག་ཏ་མོ་ཧ་ནི་སུ་བྷ་གེ་གཉྩ་ན་ཨ་མ་ལོ་བྷཱུ་ཥ་ཎི་ནུ་པཱུ་ར་ཤསྡོ།",
    "ཀ་ཏ་ཡ་ན་ནི་ཞུ་འབྱུང་མོ་བརྒྱད་ཀྱི་རིག་སྔགས་བཀླགས་༥པ་ཙམ་གྱིས་འགྲུབ་པའོ།",
    "སོར་མོ་རྣམས་ཕན་ཚུན་དུ་བསྣོལ་ར་ནས་མཛུབ་ར།",
    "མོ་བརྐྱང་སྟེ་བཀུག་པ་ནི་ཀ་ཏ་ཡ་ན་ཞིབ་མའི་ཕྱག་རྒྱའོ།",
    "འབྱུང་མོ་མ་ལུས་པ་འགུགས་པའོ།",
    "ཕྱག་རྒྱ་འདི་ཉིད་ལས་གུང་མོ་ཁར་གཏད་ནས་མཐེའུ་ཆུང་གཉིས་བཀུག་པ་ནི་འབྱུང་མོ་ཐམས་ཅད་གསོད་པ་སྟེ།",
    "ཁུ་ཚུར་གཉིས་༡སོ་སོར་བཅངས་མིནས་མཛུབ་རྡོ་མོ་གཉིས་བརྐྱང་བ་ནི་ཀ་ཏ་ཡ་ན་དྲེགས་མའི་ཕྱག་རྒྱ་སྟེ།",
    "དྲི་དང་སྤོས་དང་དེ་བཞིན་དུ་མེ་ཏོག་གིས་མཆོད་ཅིང་ཉ་དང་ཤའི་གཏོར་མ་ཡང་བྱིན་ན་འབྱུང་མོ་༤ཐམས་ཅད་སྐད་ཅིག་དེ་ལ་བྲན་མོར་འགྱུར་རོ།",
    "ཁུ་ཚུར་གཉིས་དམ་དུ་བཅིངས་ནས་མཛུབ་༥མོ་གཉིས་འཁྱུད་རི་པ་ནི་འབྱུང་མོའི་ཕྱག་རྒྱ་སྟེ།",
    "དེ་ཉིད་ཀ་ཏ་ཡ་ན་གཏུམ་མོ་རྣ་ཆ་ཅན་གྱི་༧ཕྱག་རྒྱའོ།",
    "མཛུབ་ནམོ་གཉིས་བརྐྱང་བ་ནི་འབྱུང་མོ་ཐམས་ཅད་སྒྲུབ་ཅིང་འབྱུང་མོ་རྣམས་བསྒྱེལ་༩ཞིང་གསོད་པའི་ཕྱག་རྒྱ་སྟེ།",
    "ཁུ་ཚུར་སོ་སོར་བཅངས་༡་ནས་མཐེའུ་ཆུང་གཉིས་འཁྱུད་ཉུ་དེ་མཛུབ་༡༥མོ་གཉིས་བརྐྱང་སྟེ་བཀུག་པ་ནི་འཇིག་རྟེན་གསུམ་འགུགས་པར་བྱེད་པའི་ཕྱག་རྒྱ་སྟེ་དྲག་པོ་དང་ཚངས་པ་དང་བརྒྱ་བྱིན་དུ་བཅས་པ་ཡང་འགུགས་ན་འབྱུང་མོ་དང་༡༥ཕྲན་ཚེགས་༡་རྣམས་ལྟ་ཅི་སྨོས་ཏེ་དེ་ནི་ཀ་ཏ་ཡ་ན་མཛེས་མའི་ཕྱག་རྒྱའོ།",
    "འབྱུང་མོ་ཆེན་མོ་ཀ་ཏ་ཡ་ན་བརྒྱད་ཀྱི་ཕྱག་རྒྱའི་ཆོ་ག་རྒྱས་པའི་ལེའུའོ།",
    "དུར་ཁྲོད་དུ་སོང་ནས་བརྒྱ་ཕྲག་བརྒྱད་བཟླས་ན་ཉི་མ་གསུམ་ན་འབྱུང་མོ་ཐམས་ཅད་མྱུར་དུ་འོངས་ཏེ་༡༩།",
    "འོངས་པ་ལ་ཐོད་པ་ཁྲག་གིས་ཡོངས་སུ་བཀང་སྟེ་མཆོད་ཡོན་བྱིན་ན་དགའ་བར་འགྱུར་ཏེ།",
    "དེ་ནས་རྡོ་རྗེ་འཆང་གི་ཁྱིམ་དུ་སོང་སྟེ་༡༥སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་དེས་སྔོན་དུ་བསྙེན་པ་བྱས་པར་འགྱུར་རོ།",
    "མཚན་མོ་ཡང་དཔལ་རྡོ་རྗེ་འཆང་གི་ཁྱིམ་དུ་སོང་སྟེ་བཟླས་ན་བུད་མེད་བཟང་མོའི་གཟུགས་ཀྱིས་འདུག་ནས་མཆོག་སྟེར་རོ།",
    "མཚན་མོ་ལིང་ག་གཅིག་པར་སོང་སྟེ་སྟོང་ཕྲག་གཅིག་བཟླས་ན་ཉི་མ་གཅིག་རིན་རྐང་གདུབ་ཀྱི་སྒྲ་ཐོས་སོ།",
    "ཉི་མ་གཉིས་ན་བུད་མེད་བཟང་མོ་མདུན་དུ་འདུག་སྟེ།",
    "ཀྱེ་ལྷ་མོ་ཆེན་མོ་གིསབསྙེན་བཀུར་གྱིས་ཤིག་ཅེས་སྨྲས་ན་ཇི་སྲིད་འཚོའི་༥བར་དུ་བསྙེན་བཀུར་མར་འགྱུར་རོ།",
    "གཞན་ཡང་ངལ་སོ་༨བའི་ཁྱིམ་དུ་སོང་སྟེ་འདུག་ན་རྫས་བླངས་ནས་༥༩སྟེར་བར་བྱེད་དོ།",
    "འཛམ་བུའི་གླིང་གི་ཁོངས་སུ་གཏོགས་པ་ན་གཟུགས་མཆོག་དང་ལྡན་པའི་བུ་མོ་བླངས་ནས་སྟེར་རོ།",
    "མཚན་མོ་ཆུ་བོ་འདུས་པའི་འགྲམ་དུ་སོང་སྟེ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་འབྱུང་མོ་བུད་མེད་བཟང་མོའི་གཟུགས་ཅན་དུ་འཁོར་དང་བཅས་ནས་འོང་སྟེ།",
    "མི་སྨྲ་བར་གྱུར་པས་ཆགས་པ་སྤྱད་ན་ཉི་མ་རེ་རེ་ཞིང་༡༢རྟག་ཏུ་གནས་པར་འགྱུར་རོ།",
    "མཚན་མོ་སྐྱེད་མོས་མཚལ་དུ་སོང་སྟེ་བརྒྱད་སྟོང་བཟླས་ན་ཉི་མ་གསུམ་ན་རྐང་གདུབ་ཀྱི་སྒྲ་ཐོས་སོ།",
    "ཉི་མ་བཞི་ན་འབྱུང་མོ་འོང་བ་མཐོང་ངོ།",
    "ལྷའི་མུ་ཏིག་གི་དོ་ཤལ་མལ་དུ་བོར་ནས་ཐོ་རངས་ཀྱིས་འགྲོ་སྟེ་དེས་ཀྱང་མུ་ཏིག་གི་དོ་ཤལ་བླང་བར་བྱའོ།་།",
    "ལོ་ལྔ་སྟོང་འཚོ་ཞིང་གང་གི་ཚེ་འཆི་བ་ན་རྒྱལ་རིགས་སུ་སྐྱེའོ།",
    "མཚན་མོ་རྒྱལ་པོའི་ཁབ་ཏུ་སོང་སྟེ།",
    "འོངས་པ་ལ་མེ་ཏོག་གི་མཆོད་ཡོན་བྱིན་ན་མ་དང་སྲིང་མོ་དང་ཆུང་མར་འགྱུར་རོ།",
    "གལ་ཏེ་སྲིང་མོར་གྱུར་ན་ནི་རྒྱལ་སྲིད་སྟེར་ཞིང་དཔག་ཚད་སྟོང་ནས་ཀྱང་བུད་མེད་བླངས་ནས་སྟེར་རོ།",
    "གལ་ཏེ་ཆུང་མར་གྱུར་ན་ནི་བུད་མེད་མཛེས་མ་ལྟ་བུས་ལུས་ཀྱི་ལོངས་སྤྱོད་སྟེར་ཞིང་རེ་བ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་དོ།་།",
    "ལོ་ཁྲི་འཚོ་ཞིང་གང་གི་ཚེ་འཆི་བ་ན་རྒྱལ་རིགས་སུ་སྐྱེ་བར་བྱེད་དོ།",
    "དེ་ནས་ཟླ་བ་ཉ་བ་ལ་ཁྲི་བཟླས་པ་བྱས་ནས་མཚན་མོ་ལྷ་ཁང་དུ་སོང་སྟེ།",
    "འོངས་པ་ལ་ཁྲག་གི་མཆོད་ཡོན་བྱིན་ན་དགའ་བར་འགྱུར་ཞིང་མངག་གཞུག་མར་གེའགྱུར་རོ།",
    "ཉི་མ་རེ་རེ་ཞིང་༥༥དོང་ཙེ་༤༦་ལྔ་ལྔ་སྟེར་ཞིང་ལྷའི་འདོད་པའི་བཟའ་བ་སྟེར་རོ།",
    "བྲན་ཕོ་༩དང་ནི་བྲན་མོ་དག།",
    "ར་སྐྱེས་ནག་པོའི་ཤ་བཙོང་བའི་སྔགས་ཏེ་མཚན་མོ་དུར་ཁྲོད་དུ་སོང་ནས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ན་ཤ་ཐམས་ཅད་བཙོང་བའི་སལས་འགྲུབ་པར་༡་འགྱུར་རོ།",
    "མཚན་མོ་དུར་༡་ཁྲོད་དུ་སོང་ནས་ཤ་སྲང་བརྒྱད་ཁྱེར་ནས་ཕྱོགས་བཞིར་རྣམ་པར་བལྟས་ཏེ།",
    "ཀྱེ་ཀྱེ་དུར་༣ཁྲོད་ན་གནས་པའི་འབྱུང་མོ་རྣམས་ཤ་ཉོའམ་ཞེས་བོས་ནས།",
    "ལྷའི་བུ་མོ་དུ་མ་དང་།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སེལ་བ།",
    "ལྷ་ཆེན་པོ་མ་འོངས་པའི་དུས་ན་འཛམ་བུའི་གླིང་གི་མི་རྣམས་ལ་ཕན་པའི་དོན་དུ་འབྱུང་པོ་ཐམས་ཅད་དང་།",
    "མི་འམ་ཅི་རྣམས་བྲན་མོར་སྒྲུབ་༦པའི་ཐབས་ཁྲོ་བོའི་བདག་པོ་ཆེན་པོས་གསུངས་ཤིག།",
    "གཡོན་པའི་ཕྱག་གིས་སྡིགས་མཛུབ་༤མཛད།",
    "མཐེའུ་ཆུང་དང་ནི་གུང་མོ་དག།",
    "འོད་ཟེར་སྟོང་གིས་མཛེས་པ་ནི།",
    "ལྷ་མོ་ཨུ་མ་བྲི་བར་བྱ།",
    "དཔལ་གྱི་ལྷ་མོ་བྲི་བར་བྱ།",
    "ཟླ་བའི་ལྷ་མོ་བྲི་བར་བྱ།"
