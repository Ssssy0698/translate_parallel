    "དེ་ལྟ་བུས་ཆོ་ག་རྒྱས་པ་བསྒྲུབས་ན་གདོད་འགྲུབ་པར་འགྱུར་ཏེ།",
    "རིག་སྔགས་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "ནས་ལོ་གཅིག་མ་ལོན་པ་ལ་སྦྱིན་པར་མི་བྱ་སྟེ།",
    "ཡང་ན་སློབ་དཔོན་གྱིས་རབ་ཏུ་སྦྱང་བ་བྱས་ནས་གཟོད་གཟུང་བར་ཀུན་བྱའོ།",
    "ཁྲོས་ནས་བྱང་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་བདུག་རི་པར་བྱའོ།",
    "བྲ་༢༥མ་ཙན་དྷས་སྦྱིན་སྲེག་བྱས་ན་འཇིགས་པར་བྱེད་དོ།",
    "ལག་པ་ལ་བཟླས་བརྗོད་བྱས་ཏེ་གང་དོན་དུ་བསྒྲུབ་པ་དེ་༧བླང་བར་བྱའོ།",
    "ལན་བརྒྱད་བཟླས་བརྗོད་བྱས་ནས།",
    "གང་ཅི་ཡང་རུང་བ་ཡང་འདྲེན་པར་བྱེད་དོ།",
    "མར་དང་སྦྲང་རི་རིརྩི་ལ་བཟླས་བརྗོད་བྱས་པས་བྱའོ།",
    "ཤིང་ལ་གཏོར་ན་ལོ་མ་རྣམས་རྙིས་༢༢པར་འགྱུར་རོ།་",
    "ཐམས་ཅད་དབྲོག་༡་པའི་སྔགས་ཀྱིས་འགྲུབ་པར་འགྱུར་རོ།",
    "ཡུངས་ཀུར་ལ་བསྔགས་པས་ཀྱང་སྒོ་ལ་བསྣུན་པར་བྱའོ།",
    "གནོད་པར་བྱ་བ་ལ་སྦྱིན་སྲེག་བྱས་ནས་དེའི་འོག་ཏུ་བདུག་པས་ཝ་དགྲོལ་བར་བྱའོ།",
    "ལན་བདུན་བཟླས་བརྗོད་བྱས་ཏེ།",
    "སྐུད་པ་ལ་ལན་ཉི་ཤུ་རྩ་གཅིག་བཟླས་བརྗོད་བྱས་ནས།",
    "མདུད་པ་བྱས་ཏེ་སརྐེད་པ་ལ་བཏགས་༣སྟོན་ཁུ་བ་དང་ཁྲག་བཅིངས་པར་འགྱུར་ཏེ།་",
    "དེ་ཡང་འཁོར་དང་བཅས་པར་བྱའོ།",
    "སྐུ་གདུང་དང་ལྡན་པའི་མཆོད་རྟེན་གྱི་དྲུང་དུའམ་ཡང་ན་ཆེད་དུ་སྐུ་གདུང་བཞག་སྟེ་སྐུ་གཟུགས་ཁ་ནུབ་ཕྱོགས་སུ་བསྟན་ལ་སྐུ་གཟུགས་ཀྱི་མདུན་དུ་གསེར་དང་དངུལ་དང་ཟངས་རྣམ་༡་གསུམ་ལས་བྱས་པའི་རྡོ་རྗེ་རས་སར་༡༢པ་མ་ཉམས་པའི་སྟེང་དུ་བཞག་སྟེ་སྟེང་གཡོགས་༡༩པར་བྱའོན།",
    "དེ་ནས་ཉེ་བར་འགྲོ་བའི་གཞོན་ནུ་ཟླ་བ་ཕྱེད་གསུམ་ལ་བསྒྲུབ་པར་བྱ་སྟེ།",
    "ལྷ་བཤོས་ཀྱང་རྟག་པར་དབུལ་བར་བྱའོ།",
    "མར་གྱི་མར་མེ་ཅི་འབྱོར་པ་ཡང་མཚན་རངས་པར་༤སྦྱར་རོ།",
    "དེ་ལྟར་སྦྱར་ན་འགྲུབ་པར་འགྱུར་ཏེ།",
    "འཁྲུག་པར་བྱ་བ་ལ་ནི་བའི་མར་གྱིས་བྱའོ།",
    "ལས་འདི་དག་དང་གཞན་ཡང་གྲངས་མེད་པ་དག་བྱེད་པར་འགྱུར་ཏེ།་",
    "རོ་བསྲེགས་པའི་སོལ་བས་གཟུགས་བྲིས་ལ་ས་༡་ལས་བྱས་པའི་རྡོ་རྗེས་བཀབ་ན་གདོན་དབུགས་ཆད་པར་འགྱུར་རོ།",
    "ཐིང་རིལ་གྱི་སྒོ་༢་ངའི་ཤུན་ལྤགས་ན་རྣམས་ཆ་བསྙམས་ན་ཏེ་ཞག་གསུམ་སྨྱུང་བ་བྱས་ནས་བརྒྱ་སྟོང་བཟླས་བརྗོད་བྱའོ།",
    "དེ་ལྟར་བྱས་ན་ལུས་མི་སྣང་བར་འགྲུབ་པར་འགྱུར་རོ།",
    "སྐལ་བ་བཟང་པོ་དང་ལྡན་ཞིང་བཟའ་བ་དང་བཏུང་༡རྟབ་དང་ལྡན་པར་འགྱུར་རོ།",
    "ལུས་མི་སྣང་བ་བསྒྲུབ་པ་ནི་ཞག་གསུམ་སྨྱུང་བ་བྱས་ཏེ།",
    "ལན་ཚྭ་༢༢ལས་དུག་མའི་གཟུགས་བྱས་ལ་དེའི་རྐང་པའི་དྲུང་དུ་སྦྱིན་སྲེག་བྱས་ཏེ་རོ་བསྲེགས་པའི་སོལ་བས་གཟུགས་བྲིས་ལ་འཇིམ་པ་དལས་རྡོ་རྗེ་བྱས་པས་བཀབ་ན་དབུགས་ཆད་པར་འགྱུར་རོ།",
    "ཡར་གྱི་ངོ་ཚེས་གཅིག་ལ་བརྩམས་༢༥ལ་སྐུ་གདུང་དང་ལྡན་པའི་༢སྐུ་གཟུགས་བཞག་སྟེ།",
    "འབྱུང་པོའི་ཟས་སྦྱིན་པར་བྱའོ།",
    "དུས་གསུམ་དུ་ལན་བརྒྱད་བརྒྱ་བཟླས་བརྗོད་བྱས་ལ་སྦྱིན་སྲེག་ཀྱང་བྱའོ།",
    "ཡང་ན་རྨི་ལམ་ལེགས་པར་སྟོན་པའམ།",
    "ཅི་འདོད་པ་ཐམས་ཅད་སྦྱིན་པར་འགྱུར་གྱི་བར་དུ་ཕོ་ཉ་མའི་ཚེབཟླས་བརྗོད་གྲངས་མེད་པར་བྱའོ།",
    "ལན་བདུན་བཟླས་བརྗོད་བྱས་པའི་ཆུ་དང་སྐུད་༩པས་བྱའོ།",
    "དེ་ལྟར་དེ་བསྒྲུབ་པ་ནི་འདོད་པ་ཐམས་ཅད་སྦྱིན་པར་འགྱུར་ཏེ།",
    "འདིས་བསྒྲུབས་ན་འདོད་པ་ཐམས་ཅད་སྦྱིན་པར་འགྱུར་ཏེ།",
    "གནོད་པར་བྱ་བ་ནི་ཤིང་ཤུན་ཐག་གུའམ།",
    "དུས་གསུམ་དུ་ཁྲུས་བྱེད་ཅིང་གཙང་མས་གོས་གཙང་མ་བགོས་ནས་བྱའོ།",
    "ཟས་སུ་འོ་མ་དང་འབྲས་ཆན་ཛོ་ཟིཟ་ཞིང་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ཐབ་ཁུང་གྲུ་བཞི་པ་བྱས་ཏེ།",
    "ཕྱེའི་འདེ་༡ཉགུ་ཟ་ཞིང་དུས་གསུམ་དུ་ཁྲུས་བྱས་པ་དང་།",
    "མཇུག་ཏུ་ཟླ་བ་ཉ་ལ་ཞག་གཅིག་སྨྱུང་བ་ཝ་བྱས་ཏེ།",
    "འདོད་པ་ཐམས་ཅད་སྦྱིན་པར་འགྱུར་རོ།་།",
    "ཞག་གསུམ་སྨྱུང་བར་༢་བྱས་ནས།",
    "ཟླ་བ་དྲུག་ཚང་ནས་འབྲས་བུ་ཡོད་པར་འགྱུར་རོ།",
    "གྲོག་མཁར་༩གྱི་ས་ལས་བྱས་པའི་རྡོ་རྗེ་སྲིད་དུ་སོར་བརྒྱད་ཡོད་པ་རྩེ་ལྔ་པ་བླངས་ཏེ་བསྲུང་བ་བྱས་ཤིང་ཆོ་ག་བཞིན་དུ་ལྷ་བཤོས་ཕུལ་ནས་དངོས་གྲུབ་འགྲུབ་པའི་གནས་གང་ཡིན་པར་ཉི་མ་འམ་ཟླ་བ་ལ་གཟའ་འཇུག་པའི་ཚེ།",
    "མཆོད་རྟེན་གྱི་དྲུང་ངམ་སྐུ་གཟུགས་སམ།",
    "དབུ་བ་བྱུང་ཙོནས་འཐུངས་ན་ནི་ཐོས་པ་འཛིན་པར་འགྱུར་རོ།",
    "གཙང་མའི་ཕྱོགས་སུ་གྲོག་མཁར་གྱི་ས་ལས་སྟེགས་བུ་སོར་བརྒྱད་༥པ་བྱས་ནས་དེར་ཁ་ནུབ་ཕྱོགས་སུ་བསྟན་ཏེ་བཞག་ལ།",
    "དགང་བླུགས་༨ཕུལ་ལ་ཙནྡན་དམར་པོའི་ཕྱེ་མ་༩༧སྦྲང་རྩི་དང་མར་དང་སྦྱར་བའི་སྲེག་བླུགས་ཁོལན་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བྱས་ན་འགྲུབ་པར་འགྱུར་རོ།་།",
    "མར་འཐུང་བར་འདོད་པས་ནི་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ཞག་གཅིག་སྨྱུང་བར་༢་བྱས་ཏེ།",
    "ཟླ་བ་ཉ་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ།",
    "ལག་པས་མནན་ལ་ལན་བརྒྱད་སྟོང་བཟླས་བརྗོད་བྱས་ན་ལས་ཐམས་ཅད་དང་འཇིགས་པ་ཐམས་ཅད་དང་།",
    "མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་སྐུད་པ་ནག་པོ་ལ་ལན་བརྒྱད་བརྒྱ་བཟླས་བརྗོད་བྱས་ཏེ་མདུད་པ་བོར་ན་འཇིགས་པ་ཐམས་ཅད་བསྲུང་བ་རྣམས་ལ་སུ་ཡང་འགལ་བར་མི་བྱེད་དོ།",
    "རིག་སྔགས་ཞུ་དག་པར་འདོད་ན་ཡར་གྱི་ངོ་ཚེས་གཅིག་ལ་བརྩམས་ཏེ།",
    "ཟས་སུ་དཀར་གསུམ་ཟོས་ལ་རིག་སྔགས་ཞུ་དག་པར་འདོད་པ་དེ་གྲོ་ག་༥༥",
    "དེ་ཡང་བུམ་པ་མི་གནག་༩༧ཅིང་རྩ་བ་མེད་པའི་ནང་དུ་གཞུག་པར་བྱའོ།",
    "གཙང་མས་གོས་གཙང་མ་བགོས་ནནས་དེ་ཉིད་ཀྱི་དྲུང་དུས་ལ་ཉལ་བར་བྱའོ།",
    "གྲངས་ངེས་པ་མེད་པས་༡་བཟླས་བརྗོད་བྱས་ལ་ཚེས་བཅུ་དྲུག་ལ་ཁ་ཕྱེ་ན་ཐམས་ཅད་ཞུ་དག་པར་འགྱུར་རོ།",
    "དེ་ནས་སྐུ་གདུང་དང་ལྡན་པའི་མཆོད་རྟེན་ནམ་སྐུ་གཟུགས་ཀྱི་དྲུང་དུ་རས་ཀྱི་སྐུ་གཟུགས་ཁ་ནུབ་ཕྱོགས་སུ་བསྟན་ནས།",
    "གཏོར་མ་ལ་སོགས་པ་ཡང་བྱས་ནས་མར་གྱི་༧མར་མེ་གཉིས་སྤར་ལ།",
    "རྨི་ལམ་དུ་སྟོན་པར་གྱུར་གྱི་བར་དུ་རྡོ་རྗེ་ལ་བསྣུན་ན་དེ་ནས་ལས་ཐམས་ཅད་བྱེད་པར་འགྱུར་རོ།",
    "དུས་གསུམ་དུ་ཡུངས་ཀུར་མར་དང་སྦྱར་བའི་སྦྱིན་སྲེག་བྱ་བ་ནི་ལྷག་པར་ཡང་གཙུག་ནས་བྱུང་བའི་ཆོ་གའི་ཁྱད་པར་གྱི་ཐབས་ཡིན་ནོ།",
    "གནོད་སྦྱིན་དང་འབྱུང་པོ་དང་སྲིན་པོ་དང་ཤ་ཟ་དང་ཡི་དགས་ལ་སོགས་པ་བསལ་བ་དང་གཞིག་རི་པར་བྱ་བ་ནི།",
    "འབྱུང་པོའི་ཟས་ཀྱིས་ནི་སྤྱིར་ཡང་འབེབས་པར་འགྱུར་རོ།",
    "སྲད་བུ་ལ་མདུད་པ་བྱས་ཏེ་བཟླས་བརྗོད་ལན་བརྒྱད་བརྒྱ་དང་མདུད་པ་ལན་བརྒྱད་བརྒྱ་བྱའོ།",
    "རས་སྔོན་པོ་ལ་ལན་བདུན་བཟླས་བརྗོད་བྱས་ཏེ་རོ་སྨད་དུ་བཅིངས་ན་སུས་༡་ཀྱང་མི་ཐུབ་པའི་རྒྱན་དུ་འགྱུར་རོ།",
    "རྩོད་པ་ཐམས་ཅད་ལ་ཝ་བསྲུང་བའི་ཕྱིར་བཅིངས་ན་རྒྱལ་ཞིང་༥༡༧ཕེབས་པར་འགྱུར་རོ།",
    "ཞི་བར་བྱ་བ་དང་རྒྱས་པར་བྱ་བ་དང་།་",
    "དམ་ཚིག་འཛིན་དུ་གཞུག་ནོཔར་བྱ་བ་ལ་ནི་ཆོ་ག་བཞིན་དུ་བཟླས་བརྗོད་དང་།",
    "སྲོག་ཆགས་ཀྱི་གནས་མེད་པར་བཀྲ་ཤིས་པའི་ཕྱོགས་སུ་མར་གྱི་ངོ་ཞག་བརྒྱད་ལས་ཡོངས་སུ་སྦྱང་བ་༥༦བརྩམས་ནས་དཀྱིལ་འཁོར་ཁྲུ་བཅུ་དྲུག་གྲུ་༧བཞི་པ་བྱས་ནས།",
    "སྒོ་བཞི་གདོད་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་གྱི་༡༡དབུས་སུ་ལག་ན་རྡོ་རྗེ་གནས་པའི་སྟེགས་བུ་བྱས་ལ་དེའི་ཕྱོགས་གཅིག་ཏུ་གུར་གུམ་༡༢གྱིས་རྡོ་རྗེ་སོར་བརྒྱད་ཙམ་བྲིའོ།",
    "དེའི་སྟེང་དུ་ཡང་ཙནྡན་དམར་པོ་ལས་རྡོ་རྗེ་སོར་བརྒྱད་པ་བྱས་ལ་གཞག་གོ།",
    "སྟེགས་བུ་དེར་སྐུ་གདུང་དང་ལྡན་པའི་སྐུ་གཟུགས་བཞག་ལ་དེའི་མདུན་དུ་ལྷ་དང་རྡོ་རྗེ་དྲི་ནིཐམས་ཅད་ཀྱིས་ལེགས་པར་བྲི་བར་བྱ་སྟེ་ཁྲུ་གང་ཚུན་༤",
    "ཡུངས་ཀུར་གྱིས་སྦྱིན་སྲེག་བྱས་ལ་དེ་ནས་བཟླས་བརྗོད་ལན་བརྒྱད་སྟོང་བྱའོ།",
    "དེའི་མཇུག་རིན་ཏུ་ཞག་གསུམ་སྨྱུང་བ་བྱས་ཏེ།",
    "ནམ་མཁའ་ལ་འཕགས་༥༩༥པར་གྱུར་གྱི་བར་དུ་བཟླས་བརྗོད་བྱའོ།",
    "ཕན་འདོགས་ནུས་པར་འགྱུར་རོ།",
    "འདི་ནི་ཕོ་ཉ་མ་༦ཐམས་ཅད་ཀྱི་རྡོ་རྗེ་བསྒྲུབ་པ་སྤྱིའི་ཆོ་ག་ཡིན་༢ཏེ་ལས་ཐམས་ཅད་ཀྱང་ལས་ཀྱི་རྡོ་རྗེ་ལག་ན་ཐོགས་པར་བྱའོ།",
    "འདོད་པ་ཐམས་ཅད་སྦྱིན་པར་འགྱུར་རོ།",
    "དེ་ནས་ལན་བདུན་བཟླས་བརྗོད་བྱས་ཏེ་དཀྱིལ་འཁོར་དེའི་སྟེང་དུ་བཞག་ལ་དེ་ནས་རིག་སྔགས་བརྗོད་པར་བྱ་སྟེ།",
    "མི་འགྲུབ་པ་ལྟ་ན་སོ་སོར་གྱེས་པར་གྱུར་ཅིག་ཅེས་བྱའོ།་།",
    "དེ་ནས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ལྟས་རི་སྟོན་པར་འགྱུར་ཏེ།",
    "གཙང་ཞིང་ཚངས་པར་སྤྱོད་པ་དང་།",
    "སྨྱུང་བར་བྱས་པས་བྱའོ།",
    "མ་ད་ནའི་ཤིང་ལས་གཟུགས་བྱས་ནས་ཚ་བ་གསུམ་གྱིས་བཀང་ལ་ཚིགས་བདུན་དུ་མ་༢ད་ནའི་ཚེར་མ་བདུན་གྱིས་བཏབ་ནས།",
    "ཞག་བདུན་གྱི་བར་དུ་ཁ་ཤར་ཕྱོགས་སུ་བསྟན་ཏེ་དུས་གསུམ་དུ་ལན་བརྒྱད་བརྒྱ་བཟླས་བརྗོད་བྱས་ནས་མཇུག་ཏུ་ལན་སྟོང་བྱས་ན་འགྲུབ་པར་འགྱུར་རོ།་",
    "ལན་བརྒྱད་སྟོང་བཟླས་བརྗོད་བྱས་ནས་དགྲའི་གཟུགས་བྲིས་ལ་རྟག་ཏུ་མགོ་བོ་དང་།",
    "བདག་ཉིད་ཀྱི་མཐུ་བསྐྱེད་པར་འདོད་ན་སྐུ་གདུང་དང་ལྡན་པའི་མཆོད་རྟེན་གྱི་དྲུང་དུ་བདུག་པ་དང་།",
    "རོ་བསྲེགས་པའི་མེ་འབར་བའི་ནང་དུ་བོར་ནས་འབྱུང་པོའི་གཏོར་མ་ཐམས་ཅད་ཕུལ་ལ་གྲངས་ངེས་པ་མེད་པར་བཟླས་བརྗོད་བྱའོ།",
    "དེ་ནས་རྨི་ལམ་དུ་མི་ནག་པོ་མཐོང་བར་འགྱུར་ཏེ་གྲུབ་ཟིན་ནོ་ཞེས་ཟེར་བ་དང་ནང་པར་ལངས་ཏེ་དེས་མིག་བསྐུས་༡ལྷན་ལུས་མི་སྣང་བར་འགྱུར་རོ།",
    "རྡུལ་ལ་ལན་བརྒྱད་བརྒྱ་བཟླས་བརྗོད་བྱས་ཏེ།",
    "དོན་ཡང་གྲུབ་པར་འགྱུར་རོ།",
    "གསལ་སྣང་བྱ་བར་འདོད་ན་སྨྱུང་བ་བྱས་ལ་བདུག་པ་དང་མེ་ཏོག་དང་།",
    "རིག་སྔགས་བཟླས་བརྗོད་བྱས་ན་ངེས་པར་རྟོགས་པར་ཝ་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ལ་ལན་གསུམ་བསྐོར་བ་བྱས་ཏེ།",
