    "རྡོ་རྗེ་སེམས་དཔའི་གནས་འདུག་ནས།",
    "རང་རང་ཕྱོགས་སུ་ལེགས་པར་བཞུགས་ནས་ཀྱང་།",
    "མཁའ་དབུགས་ནང་དུ་ཁྱབ་འདུག་པས།",
    "དུས་ཡུན་རིང་པོ་བརླན་བཤེར་ཅན་གྱི་ས་ཐོག་ཏུ་འདུག་པ།",
    "བཟོ་རིག་པའི་ཞབས་ཏོག་རྒྱུ་གསེར་དངུལ་ལ་སོགས་པ་ཟས་ནོར་གྱི་ཕུང་པོ་ཆེན་པོ་དགོས་པ་འདུག་ནའང་།",
    "ཤཱཀྱ་མུ་ཅོར་སྨྲ་བ་རྣམས་ཐུབ་པ་བཞིན་དུ་འདུག་པས་ཤཱཀྱ་ཐུབ་པ་ཞེས་ཀྱང་བཏགས་སོ།",
    "བརྒྱ་ལ་སྐྱེ་བོ་ཕལ་དང་བཞུགས་པར་གྱུར་ཀྱང་གདའ།",
    "རྒྱལ་པོ་ཡིད་མ་དགའ་བར་སེམས་ཤིང་འདུག་པ་གཞོན་ནུས་མཐོང་ནས།",
    "དགེ་སློང་དག་དེ་བཞིན་གཤེགས་པ་ལ་ཚེ་དང་ལྡན་པ་ཞེས་མ་ཟེར་ཞིག་ཁྱེད་རང་དག་ཡུན་རིང་པོར་མི་བདེ་བར་འགྱུར་རོ།",
    "སྐུ་འཁོར་མང་པོས་བསྐོར་འདུག་པ་ལ་ངེད་གཞན་རྣམས་ཀྱིས་འཕུར་ཕྱིན།",
    "གཅིག་འཕུར་མ་ཐུབ་པ་ཨུ་ཨུ་ཟེར་སྡུག་སྐད་ཀྱི་རྣམ་པ་དང་བཅས་ཏེ་བསྡད་འདུག་པ་ཞིག་རྨིས་པའི་སང་།",
    "ཁྱེད་ཀྱི་ཕྱག་ན་འདུག་པའི་ཐུབ་པའི་སྐུ་འདི་ཡང་སྟེར་དགོས་གསུངས་པས།",
    "འགྲོ་ཕན་རྒྱ་ཆེན་པོ་ཡོང་གསུངས་ཕྱག་ན་ནས་འབྲུ་ཁ་ཡར་འདུག་པ་ཡུམ་གྱི་སྐུ་ལ་གཏོར་བྱུང་ཟེར་རོ།",
    "འཚུབ་ཆ་ཨེན་ཙམ་གདའ་གསུངས།",
    "ཇི་ལྟར་གདའ་ཞུས་པས།",
    "རྗེ་གྲུབ་ཆེན་དང་མཇལ་ནས་ཞུས་པས་ལེགས་གདའ།",
    "གླེ་ལུང་ནང་པའི་དགོན་ཆུང་ན་སྔགས་འཆང་མཆོག་རྒྱལ་བ་བཞུགས་འདུག་པ་ལ།",
    "དེ་ལོ་དབུས་གཙང་ཀུན་ན་ཆར་ཤིན་ཏུ་དཀོན་པར་འདུག་པ་ལ།",
    "ཁོ་རང་ཡང་མྱུར་དུ་བསུ་མཁན་ཡོང་བ་ཡོད་ཟེར་དགའ་དགའ་ལས།",
    "སྔ་གོང་ངོར་ནས་མུས་ལ་ཕེབས་སྐབས་ཤིག་རུབ་མའི་ཐད་ལ་ཁ་དར་སྲབ་པོ་ཞིག་ཆགས་འདུག་པའི་སྟེང་ལ་ཊྛཾདཔོན་སློབ་དྲེས་ཁལ་ཀུན་ཕེབས་འཕྲལ་དར་ཞིག་ཅེས་ཀྱང་གླེང་ངོ།",
    "ད་གསེར་ག་བདག་པོའི་དཔེར་འདུག་ཅིང་།",
    "རིགས་ལྡན་མའི་མཆོད་ཆོག་ཅིག་དགོས་པ་འདུག་གསུངས།",
    "ལྷ་རྣམས་དགྱེས་ཟེར་བའི་བརྡའ་རུ་འདུག་མེ་ཏོག་ས་ལ་བབས་པ་འདི་རྣམས་འདོད་ཁམས་པའི་ལྷའི་མེ་ཏོག་དང་།",
    "བྱས་ན་ཕན་པར་འདུག་ཅེས་ཀྱང་གསུངས་པར་གྲགས་སོ།",
    "ད་གཅིག་བྲིས་པས་གསུམ་ཡོང་བ་འདུག་གསུངས་སྐྱ་རིས་དབུ་བཙུགས་ཤིང་།",
    "གསོལ་དཔོན་པས་ཏས་པའི་ཚུལ་གྱིས་སྐུ་ཁམས་ཅི་འདྲ་ཡོང་མི་ཤེས་པ་གདའ་བས་བསླབ་ཆ་བྱ་ཞུས་པས།",
    "རྗེ་འདིའི་ཐུགས་ལ་ངེད་རང་ཡང་བཙུན་པ་ཞིག་བྱེད་དགོས་པ་འདུག་སྙམ་པའི་ཐུགས་འདུན་དྲག་པོ་ཡང་ཡང་དུ་འཁྲུངས་ཤིང་།",
    "ཁྱེད་རང་ཡབ་ཡུམ་སོགས་ཀྱིས་གཏོང་ན།",
    "ངེད་གཉིས་པོས་མཐུན་འགྱུར་གང་ཡོང་རང་བྱེད་ཟེར་བས།",
    "སློབ་དཔོན་གྱི་ཞལ་ནས་དཔེ་འདི་བདག་མེད་བསྟོད་འགྲེལ་ཡིན་པ་འདུག་གསུངས་ཤིང་།",
    "འགྲེལ་པའི་འོག་ན་གཞུང་ཡང་བྲིས་འདུག་པས་འོག་ནས་སློབ་དཔོན་གྱིས་སྒྲོག་པར་མཛད་དེ།",
    "ཏིང་ངེ་འཛིན་ཁོ་རང་ལ་འཆར་རྒྱུ་གཅིག་གདའ་ཞེས་ཡང་ཡང་གསུངས་སོ་། ཞེས་ཐོས་ལ།",
    "ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་ཡན་ལག་དང་བཅས་པ།",
    "ཕྱག་གཡོག་རྣམས་ཀྱིས་དེ་བཞིན་དུ་བགྱིས་འདུག་པ་དེ་ལྟ་བུ་ནི་པཎ་ཆེན་དུས་གསུམ་མཁྱེན་པ་དེས།",
    "ད་ཡང་བདུད་རྩིའི་ཆང་ཞིག་མེད་པས་མི་ཡོང་བ་འདུག་གསུངས།",
    "ལྷད་བཅོས་བྱས་པ་ལྟ་བུའི་སྐྱོན་ཅུང་ཟད་ཡོད་དོགས་འདུག་བདག་ཉིད་ཆེན་པོ་ས་སྐྱ་པཎྜི་ཏ་བཞུགས་དུས་ཀྱང་འདི་རིགས་བྱུང་བ་ཐུགས་ཀྱིས་མ་བཟོད་པར་སྡོམ་གསུམ་རབ་དབྱེ་རྩོམ་དགོས་པ་ཡང་བྱུང་འདུག་པ།",
    "ལག་ཏུ་མ་ལོང་པ་དེ་འགྱོད་པར་གདའ་ཞེས་སོགས་ཞུ་བར་མཛད་པ་ན།",
    "ལ་སྟོད་བྱང་པའི་རྒྱུས་དེ་ཁྱེད་རང་བྱང་པ་རང་ག་ལོས་ཆེ་ཡང་།",
    "བློའི་གཏད་མཚམས་ཡག་པོ་ཡིན་པ་འདུག་ང་ཡི་བསམ་ཚོད།",
    "རིག་པའི་གནས་ལྔ་དག་ལ་བརྩོན་པར་མ་བྱས་ན་། ཞེས་སོགས་གསུངས་འདུག་ཅིང་།",
    "འཆི་བདག་ཁོ་གཏུག་ཏེ་སླེབས་ཙ་ན།",
    "དེས་ན་དེ་རིང་ཁྱེད་རང་ལོག་བྱོན།",
    "འཆི་ཁར་གདེང་ཚད་ཡོད་ཙམ་ཞིག་ཅི་ནས་ཀྱང་བྱེད་དགོས་པ་འདུག་སྙམ་པའི་ངང་ནས།",
    "འདི་བྱེད་མེད་པའི་ངང་ནས་གྲྭ་ཚང་དུ་སླེབས་འདུག་ཅིང་།",
    "སྔ་ཞབས་གོང་གླིང་ཁའི་སྤྱི་རྫས་སོགས་ལ་འཐོར་གྱེག་ཆེན་པོ་བྱུང་འདུག་ཟེར་བའི་སྙན་དུ་རིམ་པས་སོན་པའི་ཤིས་ནས།",
    "བཀའ་བཀྱོན་ཟུར་ཆགས་སུ་ཕེབས་པ་ཞིག་ཡོད་འདུག་ཀྱང་།",
    "སྤྱིར་ཡང་དགོན་གོག་འཛིན་པའི་མི་ལ་བྱེད་དཀའ་རྣམ་གྲངས་འཇིག་རྟེན་བཟའ་དཔོན་རྒན་པོ་ལས་ཟུར་ན་མི་འདུག་ལྷག་པར་ཕ་བཟང་པོ་བུའི་སེ་ཐར་གྱི་དཔེས་སེམས་དཔའ་ཆེན་པོ་ནས་བཟུང་སྐྱེས་བུ་དམ་པ་ཁོ་ནས་བསྐྱངས་ཤུལ།",
    "ཆིབས་བཤོལ་རྒྱུན་རིང་བསྒྲགས་ཏེ་བཞུགས་དགོས་པ་བྱུང་བ་ཡིན་འདུག་ཅིང་།",
    "ཁྱེད་རང་གོ་རྒྱ་ཆེ་ཞིང་མཐའ་ཆོད་པར་འདུག་དེས་ན་དུས་སྙིགས་མའི་སྐབས་འདིར་སྐྱེས་བུ་དམ་པ་རྣམས་དབེན་པར་སྒོམ་སྒྲུབ་ལ་བརྩོན་པ་བས།",
    "མཁན་ཆེན་པས་ངེད་རང་ལ་བསྟོད་བཀུར་། བསྔགས་པ་དང་བཅས་ཐུགས་མཐོང་དཔེ་མེད་གནང་བ་ཡིན་འདུག་ཀྱང་།",
    "འགྱུར་རང་ཞིག་བྱ་དགོས་པ་འདུག་སྙམ་པའི་ཐུགས་བསྐྱེད་བཟང་པོ་འཁྲུངས་པ་ཡང་བྱུང་གསུངས་ཤིང་།",
    "ཐུབ་བསྟན་རྣམ་རྒྱལ་བ་ཁོང་མཁན་སློབ་ཀྱི་སྐབས་རང་དར་རྒྱས་ཆེ་བ་བྱུང་ཡོད་པ་འདུག་གསུང་བ་སོགས་དུས་རྒྱུན་ལྡན་དུ་དད་གུས་དང་།",
    "ད་ཁྱེད་ལ་འོད་གསལ་ཉིན་སྣང་མཚན་སྣང་འདྲེ་ནུས་པ་ཤར་འདུག་པས།",
    "གསང་སྤྱོད་ལ་འགྱེལ་ཞིག་མི་ཡོང་བའི་ཁག་འཁུར་གསུངས་པ་འདུག་པས།",
    "དེ་ལྟར་ན་བློ་དཔང་མཐོ་ཞིང་ཤིན་ཏུ་ལེགས་འདུག་པ།",
    "ངེད་རང་ལན་གཅིག་ཕྱོགས་ལ་འགྲོ་དགོས་འདུག་པས།",
    "འདི་ཕྱོགས་སུ་ཁོར་ཙམ་ཞིག་ཅེས་ཀྱང་བྱོན་གསུང་བ་འདུག་པས།",
    "དེ་མི་འོངས་ལ་རང་ལ་འོང་གྱིན་འདུག་གོ་ཞེས་གསུངས་བྱུང་པས།",
    "གཉེར་སྨར་པོ་བྱུང་ཡོད་པ་འདུག་ཀྱང་།",
    "མནལ་ལམ་དུ་ཁྲི་མང་པོ་འདུག་པ་སུའི་ཡིན་དྲིས་པས།",
    "དེ་རྣམས་ལས་ཆེ་བ་ཅིག་འདུག་པ་དྲིས་པས།",
    "གདན་ས་ཆེན་པོ་འདིའི་ཞབས་འདེགས་སུ་ཆེ་བ་བྱུང་འདུག་པ་ཅིས་ཀྱང་ངོ་མཚར་ཆེའོ།",
    "དེ་ཉིད་ཁོ་ན་ལ་དགྱེས་པར་འདུག་སྙམ་པ་འབྱུང་ཞིང་།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "ད་དུང་ཁོག་པའི་ནང་ན་སྲིན་འབུ་ཅུང་ཟད་ཡོད་ཚོད་དུ་འདུག་ཅེས་སྒྲིབ་གཡོགས་དང་བཅས་ཏེ་གསུང་ངོ།",
    "དེ་དུས་སྦྱིན་བདག་མ་དེ་གང་དུ་སྐྱེ་སོགས་ཤེས་པ་ཙམ་བྱུང་ཞེས་དད་ལྡན་འགའ་ཞིག་ལ་གསུངས་འདུག་ཅིང་།",
    "དེ་མཚོན་བྱེད་དཔེའི་ཡེ་ཤེས་རྟགས་རུང་ཙམ་དུ་གདའ།",
    "ཁོ་བོ་སྐྱེ་རན་ཙ་ན་སྐྱེས།",
    "སྨིན་རན་ཙ་ན་སྨིན།",
    "ད་འཆི་རན་ཙ་ན་འཆི་ཞེས་གསུངས་ཤིང་།",
    "མ་བདེ་བ་བྱུང་དུས་ང་རང་ལ་དྲིས།",
    "སང་ཙ་ན་ཟ་རྒྱུ་ཐེ་ཚོམ་ལས་མི་ཡོང་གསུངས་བའི་བཀའ་གནང་མཛད།",
    "ད་མཚོན་བྱ་དོན་གྱི་ཡེ་ཤེས་ཀྱང་མྱུར་དུ་འཆར་བ་གདའ་གསུངས།",
    "ད་རྗེས་ཐོབ་ཏུ་གྲོགས་མེད་གཅིག་པོར་བསྡད་ཙ་ན་སྣང་བ་ཐམས་ཅད་ཉམས་སྣང་འབའ་ཞིག་ཏུ་འཆར།",
    "མི་གཅིག་རྩར་བྱུང་བའི་ཐུག་སྒྲ་སོགས་བྱུང་ཙ་ན་ཁང་ཁྱིམ་ལ་སོགས་སྣང་བ་རང་ག་མ་འདི་འཆར།",
    "དེ་ལམ་འབྲས་པས་ངོ་བོ་ཉིད་གསུམ་སྐྱོང་ཚུལ་དེ་ཀ་ལ་ཉམས་ལེན་བྱས་པའི་འབྲས་བུར་འདུག་གསུངས།",
    "དེ་རྣམས་དཀོར་རྫས་སུ་འདུག་གསུངས་ཤིང་།",
    "རྗེ་འདིས་ཐོག་འདིའི་སྐྱོན་འདི་ན་འདུག་པས་ཤུ་འབུབ་གྱིས་གསུངས་པས་དེ་ཇི་ལྟ་བ་བཞིན་འདུག་པས།",
    "འདིར་དཀོར་ཆེ་བས་འགྲིབ་འགྲོ་ཡི་འདུག་ཅེས་གསུངས་འདུག་ཅིང་།",
    "ད་ཕྱིན་བཙུན་པ་ཡིན་པས་ངང་བློ་རིང་དགོས་ཞེས་སོགས་གསུངས་འདུག་པ་དང་།",
    "མར་རིལ་གསུམ་འདུག་པ་ལ་ཆུང་ཤོས་འདི་ཁྱེར་ཡོང་བ་ཡིན་ཨང་གསུངས་བྱུང་པས།",
    "ཐུགས་མཁྱེན་གྱིས་དགོངས་པར་འདུག་ཟེར་མཆི་མ་གཏོང་ཞིང་།",
    "ཐུགས་མཁྱེན་དང་འོད་གསལ་སྒྲིབ་མེད་དུ་མངའ་བ་ལ་ཐེ་ཚོམ་མི་འདུག་སྙམ་དགེ་སློང་ཤིན་ཏུ་འཇིགས།",
    "ཁྱེད་རྣམས་ལ་འཚུབ་ཆ་ཆེན་པོ་འདུག་པས་ཡང་ན་ཚེ་ལ་བར་ཆད་བྱུང་དོགས་འདུག་ཡང་ན་ནོར་གོད་ཆེན་པོ་ཡོང་བ་འདྲ་གསུངས་ཤིང་ཅུང་ཟད་ཐུགས་འཚུབ་པའི་རྣམ་པ་མཛད་ཀྱིན་འདུག་པ་ལ།",
    "ཁྱེད་ལ་རྨིས་ལམ་འདིའི་རྗེས་སུ་འདི་བྱུང་འདུག་པ་ཅེས་གོ་རིམ་རྣམས་མ་འཁྲུགས་པ་གསུངས་ཤིང་ལེགས་ཉེས་ཀྱི་ལུང་བསྟན་གནང་བྱུང་བས།",
    "ཡང་ལན་ཅིག་སྐུ་མདུན་ན་ཨ་ཙ་ར་མང་པོ་གྲོས་བྱེད་ཀྱིན་འདུག་གསུངས།",
    "རྗེ་འདི་ཉིད་ལྟ་སྟངས་ཀྱི་ངང་ལ་ཅུང་ཟད་ཀྱང་མི་གཡོ་བར་བཞུགས་འདུག་པས།",
    "དེ་མ་བྱས་པར་འདིའི་ལུང་བྱས་པས་ཁོ་མ་དགའ་ཟེར་བ་ཡིན་པ་འདུག་གསུངས་བྱུང་བས།",
    "མུས་སྟོང་དཔོན་སོགས་སྐུ་གཞོགས་ན་ཡོད་པ་ཐམས་ཅད་ལ་མཐུན་པར་ལུས་ཀྱི་ཕུང་བྱེད་པའི་ཟིལ་ཆེན་པོ་མི་བཟོད་པ་ལྟ་བུ་བྱུང་ཞེས་པ་ཁོང་རང་རྣམས་ལས་དངོས་ཐོས་པས།",
    "འདིར་སྡོད་ཟེར་བ་ཡིན་སྙམ་བསྡད་པས་ནམ་ལངས་མཚམས་རྗེ་དབོན་རྣམས་དེར་སླེབས་ནས་དངོས་པོ་ཐམས་ཅད་གྱར་མེད་དུ་ཕྱག་ཏུ་འབྱོར་འདུག་པ་འདི་ལྟ་བུའི་མཐུ་རྩལ་ནི་སྔོན་གྱི་རྗེ་བཙུན་ས་སྐྱ་པའི་གོང་མ་རྣམས་དང་།",
    "དེ་རྣམས་བཀའ་ཡེ་ཤེས་ཀྱི་མགོན་པོ་ཕྱག་དྲུག་པའི་སྤྲུལ་པའི་འཁོར་དུ་འདུག་གསུངས།",
    "ངེད་ལ་ལུང་བསྟན་ཕལ་ཆེར་ཡེ་ཤེས་ཀྱི་མགོན་པོ་འདིས་བྱེད་ཀྱིན་འདུག་ཅེས་དད་ལྡན་གྱི་བུ་སློབ་འགའ་ཞིག་ལ་གསུངས་པ་ལས་བརྒྱུད་དེ་ཐོས་ལ།",
    "དུས་ཕྱིས་ཛམ་དམར་དང་དབྱུག་གུ་མ་སོགས་ལ་དགེ་སྦྱོར་རྩེ་གཅིག་བྱེད་པ་ལ་སོ་མ་སོད་པ་ལས་མི་འདུག་སྙམ་ནན་ཏན་ཆེར་མ་བྱས།",
    "རྣལ་འབྱོར་པའི་གཟི་བརྗིད་གདུག་འདྲེ་ཚོས་མ་བཟོད་ཚོད་དུ་གདའ་ཞེས་གསུངས་ཤིང་།",
    "མནལ་སད་པ་དང་ཉིད་ཀྱི་ཐུགས་ལ་འདི་ན་སྔར་གྱི་གདན་ས་རྙིང་པ་རྣམས་ལ་ཡང་བར་ཆད་བྱེད་པའི་འབྱུང་པོ་ཞིག་ཡོད་འདུག་ཀྱང་།",
    "རྗེ་རང་ལ་གླགས་མི་རྙེད་པ་འདུག་སྙམ་པ་འཁྲུངས་ཤིང་།",
    "མགོ་ན་ནས་དེང་སང་བར་དྲན་པས་མ་ཟིན་འདུག་ད་ལྟ་གང་བྱས་པ་ཡིན་ཟེར་སྨྲེ་སྔགས་དུ་མ་ཞིག་འདོན་བཞིན་འདུག་གོ་ཞེས་ཀུན་ལ་གྲགས་སོ།",
    "སྐབས་དེར་མ་ཆེན་དྲན་མེད་དུ་བརྒྱལ་འདུག་པ།",
    "ཁོང་རང་མི་བརྒྱད་མི་ནོར་དང་བཅས་པ་ལ་ཕན་ཐོགས་ཆེན་པོ་བྱུང་བར་གྲགས་སོ།",
    "གླིང་གའི་ནུབ་རོང་ཆུ་ཚན་གྱི་གཞི་བདག་མ་དེ་སྔོན་རྗེ་སེམས་དཔའ་ཆེན་པས་བཞུགས་དུས་ཆབ་ལ་ཕེབས་སྐབས་སྦྲུལ་ཆེན་པོ་ཞིག་ཏུ་སྤྲུལ་ནས་ཡང་ཡང་ཕེབས་བསུ་ལ་ཡོང་བ་ཞིག་ཡོད་འདུག་པ་ལ།",
    "བདག་ཚེ་ཧ་ཅང་མི་རིང་བ་ཞིག་བྱུང་ན་ཐོས་བསམ་རྒྱ་ཆེར་བྱས་པ་ལ་དོན་མི་འདུག་པས་ཚེ་རིང་ཐུང་གང་འོང་དང་།",
    "སྐ་ཕྱྭ་བཏབ་པས་སྐ་ཚེ་རིང་པོ་ཡོང་བ་གདའ།",
    "ཅེས་གསུངས་པ་སོགས་མང་དག་གདའ་ནའང་ཡི་གེ་མང་དོགས་མ་བྲིས་ལགས།",
    "གནས་མཐོན་པོར་འཁྲུངས་པ་གཞིར་བཅས་སུ་འདུག་ལགས།",
    "ཞེས་གསུངས་པ་འདུག་པ་མཐོང་བས་སེམས་དགའ་བ་དང་སྤྲོ་བ་ཚད་ལས་འདས་པ་རབ་དགའི་ས་ཐོབ་པ་ལྟ་བུར་གྱུར་ཅིང་།",
    "དེ་ཙམ་གྱི་སྡུག་བསྔལ་རང་མི་འདུག་ཅིང་།",
    "ངེད་འདིར་གདན་ས་བྱས་ན་ནི་འདུ་འཛིའི་གཡེངས་པས་མི་ཚེ་སྟོང་ཟད་དུ་འགྲོ་བ་འདུག་ཅིང་།",
    "དེ་ལྟར་ཡིན་ན་ངོ་མཚར་ཆེ་འདུག་ཀྱང་།",
    "བསྲེག་སྦྱངས་གྱིས་ཀྱི་བརྡར་འདུག་དགོངས་ནས་སྐུ་མཚམས་གྲོལ་ཉིན་དབོན་ཆེན་རིན་ཆེན་སེང་གེ་པ་ལ།",
    "སླར་ས་ལ་བསྐང་དགོས་བྱུང་ཟེར་བས་མནལ་ལམ་གྱི་གཡང་ལ་གཅིག་ཤོར་གསུང་པ་དེ་འདི་ལ་ལྟ་བར་འདུག་ཀྱང་སྒྲོག་པ་བྱུང་ཞིང་།",
    "གླིང་གའི་དགེ་སློང་དྲག་བསྡུས་ཤིག་ཐུགས་དམ་བཟླས་པ་མཛད་ཀྱིན་བཞུགས་འདུག་པ་ལ།",
    "ལུང་བསྟན་ཀྱང་རྒྱས་པར་གནང་བའི་སྐབས་ཡིན་པ་འདུག་པས།",
    "སྔར་གྱི་མནལ་ལམ་དེ་ལ་ལྟ་བ་ཡིན་པ་འདུག་གསུངས།",
    "གནས་གསར་ཕྱོགས་སུ་ཡང་ཡང་འགྲོ་འདུག་དགོས་ལྷཔ་འདི་ལ་ཞེ་ནས་འཚེར་ཞིང་དགེ་སྦྱོར་ལ་གནོད་པོ་ཞིག་འདུག་པས།",
    "དེ་ཅིས་ཀྱང་ལེགས་གདའ།",
    "ཁྱེད་རང་ཡང་ད་ལམ་གཞན་ཕན་མཛད་པའི་ཐོག་མ་ལ་འགོ་ནོན་འདུག་པས།",
    "བར་སྲིད་དུ་ནི་འདུག་སུ་ཤི་བ་ཡིན་ནམ་གསུངས་པ་ལ།",
    "ཨ་ཨཱ་གསུངས་བྱུང་པ་ལ་སྐུའི་ཉེ་འཁོར་ན་ཡོད་པའི་དགེ་སློང་བྱམས་པ་དཔལ་གྱིས་ཅི་འདུག་ལགས་ཞུས་པ་ན།",
    "མི་སྲིད་ན་དང་ལེགས་གདའ་སྟེ།",
    "གང་ལྟར་མྱུར་དུ་གོ་འོང་བར་འདུག་ད་རི་ཁྲོད་འདིར་ལན་ཅིག་འདུག་བསམས་ཀྱང་།",
    "ཐུགས་ལ་སྤྲས་པ་འདི་དཀྱུས་མ་ན་མི་འདུག་པས་མ་ཐར་བ་འོང་ངམ་སྙམ་བག་ཚ་བ་ཙམ་བྱུང་བ་ན།",
    "བན་ཆུང་དེ་ཞལ་བཞི་པའི་སྤྲུལ་པ་ཡིན་ཚོད་དུ་གདའ།",
    "བདག་ཀྱང་ལོག་ནས་འགྲོ་ས་མེད་ཞབས་པས་འདིར་ཞབས་དྲུང་དུ་འདུག་ཆོག་པ་མཁྱེན་ཞུས་བྱུང་པ་ན།",
    "འདི་ཉིད་མཁྱེན་ཅིང་དགོངས་པའི་ལུང་བསྟན་རང་དུ་འདུག་སྙམ་པའི་ཐུགས་ལ་དད་པ་དང་ངེས་ཤེས་ལྷག་པར་འཁྲུངས་བཞིན་པའི་ངང་ནས།",
    "ད་ནི་ཁྱེད་རང་འཕྲིན་ལས་རིམ་གྱིས་ནམ་མཁའ་དང་མཉམ་པ་ཞིག་འོང་པས།",
    "དེང་སང་ངོར་ཚོར་ནི་འཇིགས་བྱེད་དྲུག་བཅུ་པ་རང་ལ་འཆོལ་བ་ཞིག་ཡོད་འདུག་སྟེ།",
    "ཁྱེད་བསྙེན་པ་ནུས་པ་སུ་འདུག་རང་ལ་བླ་བྲང་ནས་མཐུན་རྐྱེན་སྒྲབ་གསུངས་པ་དང་རྗེས་འབྲེལ།",
    "དེ་དུས་ཀྱི་མཐོང་སྣང་དེ་དཔལ་མགོན་ཞལ་བཞི་པ་ཤིན་ཏུ་དགེས་པའི་རྟགས་ཙམ་དུ་འདུག་གསུངས་ཀྱང་།",
    "དེ་ཡང་པུ་ཏྲ་ཆེན་པོའི་དངོས་གྲུབ་ཡིན་པས་བསྣམས་པ་ཞུ་གསུངས་པ་བཞིན་དེ་བཞིན་མཛད་ནས་གཡབ་དར་གྱི་ཁྲོད་ལ་འདུག་པ་དུས་ཕྱིས་ཁོ་བོས་ཀྱང་མཐོང་།",
    "འདི་ནི་བཙུན་རྒན་ཚེ་མཇུག་ལ་ཁ་དོན་སྨར་པོ་ཞིག་ཡོང་བའི་ལུང་བསྟན་དུ་གདའ་གསུངས་ཤིང་དགྱེས་ཚོར་ཆེན་པོ་མཛད་ཀྱིན་འདུག་ཟེར།",
    "ད་ནི་སྒོམ་སྒྲུབ་ལ་བསྒྲིལ་བ་ཞིག་ཅིས་ཀྱང་ལེགས་རྒྱུར་འདུག་པས།",
    "དེ་བཞིན་བྱ་དགོས་རྒྱུར་འདུག་དགོངས་ནས་གོང་མ་སྔགས་འཆང་འཇམ་པའི་དབྱངས་ཉིད་ལ་ཐབས་མཁས་ཀྱིས་དགོངས་པ་འགྲོལ་བར་མཛད་པས།",
    "ལྷས་བསད་ན་མཐོ་རིས་ཐོབ་ཀྱི་དཔེར་འདུག་ལགས་ཤིང་།",
    "ཇི་ལྟར་གསུངས་པ་བཞིན་དགུང་ལོ་བདུན་བཅུ་དོན་གཉིས་ཙམ་བཞུགས་འདུག་པས།",
    "བདག་ཆེན་འཇམ་པའི་དབྱངས་ཉིད་ཀྱང་ཞལ་འཛུམ་བག་དང་བཅས་ནས་ཇི་ལྟར་གསུངས་པ་དེ་བཞིན་རང་དུ་གདའོ།",
    "ས་སྐྱ་པའི་སྐུའི་ཆེ་བ་ལ་། གནོད་པ་འདུག་པས་གསུངས་ནས།",
    "འདྲིས་པ་མེད་པར་འདུག་པར་བྱ།",
    "གང་སྐ་ལྷག་པའི་ལྷ་ཡི་འཁོར་ལོར་གསལ་། གསལ་བ་དེ་གསུང་གྲག་སྟོང་རང་བཞིན་སྔགས།",
    "དེ་རིང་འདི་འོང་བ་ལ་ལྟ་བ་འདུག་གསུངས་ཤིང་།",
    "ཞེས་གསུངས་པ་འདུག་པ་བཞིན།",
    "དེ་ནུབ་མནལ་ལམ་གྱི་ཚུལ་དུ་རྗེ་ཉིད་བསམ་གཏན་ཕའི་སྒྲུབ་ཕུག་ན་བཞུགས་འདུག་པ་ལ་མི་དམར།",
    "ཁྱེད་རང་ལ་ཡང་གཞི་བྱེས་གང་དུ་ཡང་བར་ཆད་ཀྱི་རིགས་གཏན་ནས་མི་འོང་ཞེས་པའི་ལུང་བསྟན་ལྷུག་པར་གནང་བ་བཞིན།",
    "སྙུང་ཟུག་སོགས་གང་ལ་ཡང་དེར་འཛིན་མེད་པའི་བདེ་གསལ་མི་རྟོག་པའི་ངང་དུ་རྒྱུན་དུ་འཇོག་པ་ཞིག་མཛད་ཀྱིན་འདུག་གོ་ཞེས་དེ་དུས་ཞབས་དྲུང་ན་ཡོད་པའི་རྒྱུས་ཅན་ཐམས་ཅད་མགྲིན་གཅིག་ཏུ་གླེང་ལ།",
    "གཞན་རྣམས་ལ་དགེ་ཚུལ་གྱི་སྡོམ་པ་འབོགས་པ་སོགས་ལན་གྲངས་མང་དུ་མཛད་དེ་མཁན་སློབ་ཉི་ཟླ་ཟུང་འབྲེལ་འདི་གཉིས་ཀྱིས་ཐུབ་པ་བཀའ་དྲིན་ཅན་གྱི་བསྟན་པའི་གཞི་མ་རྨངས་ནས་བསླངས་པ་ལྟ་བུའི་རྣམ་དཀར་གྱི་མཛད་པ་མཐའ་ཡས་པ་ཞིག་དུས་དེ་ཉིད་དུ་བསྐྲན་པ་ཡིན་ནོ།",
    "གཞན་ཡང་རང་བཞིན་གྱི་ཐུགས་དུལ་བ་དང་།",
    "ཁྱེད་རང་སྒྲ་སྙན་སོགས་ལ་གསན་སྦྱོང་མཛད་པ་དང་།",
    "ཐོག་པ་རྒན་པ་འདི་འགྲོ་བའི་འོས་སུ་མི་འདུག་ཀྱང་།",
    "ལན་ཅིག་ཁམས་ལ་བྱོན་ནས་སླར་དབུས་གཙང་དུ་ཕེབས་དང་བསྟུན་ནས་མཛད་པས་ཆོག་པ་གདའ་ཞེས་གསུངས་པ་ལ།",
    "བཟང་ཆུག་བྱུང་ན་ཅིས་ཀྱང་བྱས་པས་ཡོང་འདུག་པའི་ཕེབས་སྒོ་གནང་ཞིང་།",
    "ད་ལན་ལམ་འབྲས་དེ་གྲོལ་ཆ་ཞུ་དགོས་པ་འདུག་ཅེས་བཀའ་ཕེབས་པ་བཞིན་མཆོད་ཡོན་ནས་ཀྱང་དགོངས་སྦྱར་ཞུས་ཤིང་།",
    "འདིའི་རྩིས་བཞེས་གནང་ནས་གདན་སར་ཕེབས་དགོས་པ་ཤར་ཀྱང་ཐག་རིང་མི་ས་། འདུག་པས་ཕར་འབྱོན་ཚུར་འབྱོན་མཛད་པས་འཐུས་པ་འདུག་པ།",
    "བག་ཕེབས་པའི་རྣམ་པ་ཅི་ཡང་ཞིག་མཛད་ཀྱིན་འདུག་པས་ངེད་ཀྱི་བསམ་པ་ལ།",
    "ནམ་མཁའ་ན་བྱོན་འདུག་གསུངས་པ་སོགས་དགེས་དགེས་ཀྱི་གསུང་དུ་མ་འབྱོན་གྱིན་འདུག་ཟེར་ལ།",
    "རྗེ་རང་ཉིད་ས་སྐྱའི་ལུང་པ་ཡིན་སྙམ་པ་ཞིག་ན་བཞུགས་འདུག་པ་ལ།",
    "ཅེས་པཎ་ཆེན་ལེགས་པའི་བློ་གྲོས་ཀྱིས་གསུངས་ནས་དགེས་དྲུང་དུ་མཇལ་ང་དགེས་དཔག་མེད་མཛད་འདུག་པ་དེ།",
    "ས་སྐྱའི་ཐུགས་འགན་འདི་བརྗིད་དྲགས་པས་བགྲེས་ཉམས་ཆེན་པོར་ཕེབས་འདུག་ཅིང་།",
    "ངེད་ལ་ཡང་དྲིན་ཆེན་པོར་གོ་དགོས་རྒྱུར་གདའ་སྟེ།",
    "ཞེས་སོགས་དུས་གསུམ་གསལ་ལེ་མཁྱེན་པའི་གསུང་མང་པོ་སྩོལ་བར་མཛད་འདུག་ཅིང་།",
    "དེ་ན་འཆམས་སྐུའི་མགོན་པོ་ཤིན་ཏུ་ཆེ་བ་ཞིག་ཀྱང་བཞུགས་འདུག་ལ།",
    "རིགས་ཀྱི་བུ་ལ་བརྒྱུད་ཀྱི་ལྷ་འགོ་ཟེར་བ་དེར་གདའ།",
    "དེ་ཉམས་ལེན་དང་བསྲེ་ཐུབ་པ་ཞིག་བྱུང་ན་དེ་ཕྱིན་ཆད་མགོ་བོ་ལ་ཐོད་པ་ལེན་མི་དགོས་རྒྱུ་དེར་གདའ།",
    "ཁྱེད་ས་སྐྱ་པའི་གདུང་བརྒྱུད་ལ་གྲུབ་ཚུལ་སྟོན་པ་ཟམ་མ་ཆད་པ་ཞིག་བྱུང་འདུག་ཀྱང་།",
    "ས་ལོ་ཆེན་པོ་སོགས་ཐོར་ཙམ་ལས་མ་བྱུང་འདུག་པས།",
    "བསྟན་པའི་ཁུར་སོགས་གཞན་ལས་ཕུལ་དུ་བྱུང་ངེས་འདུག་པས།",
    "རྒྱལ་བརྒྱུད་ཡོང་བ་ནི་དཀའ་བ་འདུག་འདི་རྣམས་ཞལ་བདག་ཀྱང་ཕུགས་ཡུལ་ཁྱེད་ཀྱིས་མཛད་འབུམ་པ་ཞིག་བྱུང་ན།",
    "ད་ནི་ཤད་རྩོལ་གྱིས་ཡོང་དགོས་ཚུལ་གནང་འདུག་པ་མཐོང་བས་རྐྱེན་བྱས་ཡིད་ལ་དགའ་སྤྲོ་དཔག་ཏུ་མེད་པ་ཐོབ་པའི་ངང་ནས།",
    "ཐུགས་དགེས་དགེས་དུ་མ་མཛད་ཀྱིན་འདུག་པས།",
    "ད་ལམ་ཁྱེད་རང་ཕྱོགས་འགྲུལ་ཐོག་མ་འདི་ལ་གཞིས་བྱེས་གང་དུ་ཡང་ཉེས་པ་མེད་པ་སོགས་འགྲུལ་མགོ་ནོན་པར་བྱུང་བས་ཤིན་ཏུ་ལེགས་བྱུང་ཞེས་སོགས་གསུང་གླེང་རྒྱུན་རིང་པོའི་བར་དུ་མཛད་ཅིང་།",
    "ང་ཡང་སུ་ལ་བསམས་ནས་སྡོད་དུ་འདུག་གང་ནའང་ངེད་ཀྱིས་སྔགས་འཆང་ཆེན་པོའི་བཀའ་ཆེམས་བློས་མ་ཐོང་བ་བྷཱུབཞིན་ངེད་ཀྱི་ངག་ཀྱང་ཁྱེད་ཀྱིས་མི་གཅོག་པ་བྱེད་དགོས།",
    "ཕྱིས་བསམ་པས་སྔགས་འཆང་ཉིད་རང་དག་པའི་ཞིང་དུ་མྱུར་དུ་ཕེབས་པའི་དགོངས་པ་དེ་དུས་ནས་གཏད་པའི་གསུང་དུ་ཞབས་འདུག་ཅིང་།",
    "གསེར་ག་བདག་པོའི་དཔེར་འདུག་པས།",
    "ལུས་ཀྱི་འདུག་སྟངས།",
    "དེ་ཕྱིན་ཆད་སྐུ་ཁམས་བཟང་བའི་མཐར་ཐུག་པ་ཞིག་འབྱུང་འདུག་ཅིང་།",
    "ང་ཡང་མ་ཤིཙམ་དང་འཕྲད་པར་འདུག་གསུངས་ནས་སྐུ་མཚམས་སྔར་བས་དམ་དུ་བཏང་།",
    "སྐུ་བསྙེལ་པོ་རང་ལས་མི་འདུག་ནའང་ཤིན་ཏུམཉེས་ཇ་མང་དུ་གསོལ།",
    "ནམ་མགོན་ཡང་དེ་སྐད་ཟེར་གྱིན་འདུག་ནའང་།",
    "ད་ང་ནི་ཕན་འདུག་གསུངས་ནས།",
    "ཕ་ལ་བུ་སྐྱེས་འདུག་གེ་གསུངས་པ་སོགས་ངོས་ཅག་ལ་མགོ་འདྲེན་དུ་དགོངས་པའི་བསྟོད་བཀུར་བསྔགས་གསུམ་དུ་མ་མཛད་ཅིང་།",
    "ནམ་ལྕོགས་བར་ཁུར་འདི་བྱེད་པ་ལས་འོས་མི་འདུག་ད་ལྟ་ཁྱེད་ཀྱི་བསམ་པ་ལ་འཆད་རྩོད་རྩོམ་སོགས་ཀྱི་སྒོ་ནས་མཁས་གྲགས་ཐོན་པ་ཞིག་བྱ་སྙམ་པ་འདུག་སྟེ།",
    "ཡབ་སྲས་གཉིས་ཀ་ཐུགས་བདེན་པའི་རང་བཞིན་དུ་ནི་གདའ།",
    "སྐབས་མང་པོར་ནི་མཆན་ཆེན་གྱི་ཡིན་ཚོད་དུ་འདུག་སྟེ།",
    "རྗེས་ཀྱང་བུ་ཊིཀ་སྟེང་ནས་ཚར་གསུམ་གསན་པས་དེའི་འབྲེལ་དང་ཞེན་པར་གདའ།",
    "དེ་ཚོའི་གསུང་སྐྱོར་ཙ་ན་ཁོང་ཀུན་གསང་འདུས་ལ་མི་ཚེ་ཕྱི་ཞིང་གྲིལ་བ་རྣམས་ཞེས་གསུངས་པ་སོགས་ཆེ་བརྗོད་མཛད་པ།",
    "ཤོག་རིལ་གསུམ་དང་མ་མཇལ་ཚོད་དུ་འདུག་སྟེ།",
    "རང་རང་ས་ཡི་བདག་པོ་རྣམས་བསྐུལ་ནས།",
    "མ་འབྱོན་གྱིན་འདུག་པས།",
    "དེ་ཀ་ལས་མ་འདས་པ་ཐག་ཆོད་དུ་འདུག་སྙམ་པ་ཐེ་ཚོམ་དང་བྲལ་བའི་ངེས་ཤེས་སྐྱེ་བ་མ་གཏོགས།",
    "རང་རང་སྐལ་བ་དང་འཚམས་པ།",
    "རྗེ་བཙུན་ཉིད་གང་ཡང་མི་གསུང་བ་ཡུན་རིང་དུ་བཞད་ཀྱིན་འདུག་པས་བློ་ཤིན་ཏུ་མ་བདེ་བ་ཞིག་བྱུང་སྟེ།",
    "དེའི་ཚོམས་ཀྱི་བཞུགས་ཁྲི་ལ་རྗེ་མུས་ཆེན་བཞུགས་འདུག་པ་དང་མ།",
    "སྐུ་ཁམས་འདི་ཡང་དྭངས་པོ་མི་འདུག་པས།",
    "ང་ཤི་བའི་རྗེས་སུ་སྒྲབ་ཁང་འདི་དོག་པས་མང་པོ་ཤོང་པར་ཡང་མི་འདུག་ཅིང་།",
    "ཅེས་སོགས་གསུངས་འདུག་ཅིང་།",
    "སྐབས་འགར་སྐུ་མདར་ཤིག་ཤིག་མཛད་ཀྱིན་འདུག་པ་ལ།",
    "ཞབས་དྲུང་ན་གནས་པ་རྣམས་ཀྱིས་སྐུ་མི་བདེ་བ་མི་འདུག་ལགས་སམ་ཞུས་པས།",
    "རྩ་མདུད་རྣམས་གྲོལ་བར་འདུག་གསུངས་ཤིང་།",
    "ངེད་ལ་ཡང་དེ་བཞིན་དུ་རྩིས་ན་ལོ་བརྒྱད་ཅུ་གྱ་ཞབས་གྲངས་ལོན་ཉེན་ཡང་འདུག་སྔོན་རོང་སྟོན་གྱི་ཚེ་སྒྲུབ་དང་།",
    "ཕྱག་ནམ་མཁའ་མཛོད་ཀྱི་ཕྱག་རྒྱ་དང་བཅས་ཞལ་འཛུམ་མཛད་ཀྱིན་འདུག་པས།",
    "རྗེ་དཔོན་གྱིས་ཅི་འདུག་ལགས་ཞུས་པས།",
    "དཔའ་བོ་དང་མཁའ་འགྲོ་མ་མང་པོ་གར་བྱེད་ཀྱིན་འདུག་ཁྱེད་ཀྱིས་མཐོང་ངམ་གསུངས།",
    "གཞན་ཅི་ཡང་མི་མཐོང་བ་འདུག་ལགས་ཞུས་པས་ཧི།",
    "འདི་རྣམས་སྟོང་གཟུགས་ཀྱི་ཉམས་ཡིན་པས་མི་རྟག་རྣམ་ཀུན་མཆོག་ལྡན་གྱི་ལྟ་བ་འདི་རང་ཟབ་པ་འདུག་གསུངས།",
    "རྗེ་ཉིད་ཀྱི་གསུང་ལས་ཟླ་བ་ཤར་བར་འདུག་གམ་ཐམས་ཅད་འོད་དཀར་པོས་གང་འདུག་གསུངས་བ་དང་།",
    "མི་འདུག་ལགས་ཞུས་པས་ཡང་ཅུང་ཟད་གཅིག་ནས་གསུངས་ལས།",
    "ཡང་ཅུང་ཟད་ནས་ཌཱ་ཀི་མ་འོད་གསལ་མ་བུ་ངོ་འཕྲོད་བྱུང་གསུངས་ཤིང་དགྱེས་སྤྲོ་དཔག་ཏུ་མེད་པའི་ཐུགས་ཉམས་མཛད་ཀྱིན་འདུག་ཅེས་ཐོས་ལ།",
    "ཞེས་སོགས་གསུངས་ཤིང་ཐུགས་ཅུང་མ་མཉེས་པའི་རྣམ་པ་མཛད་ཀྱིན་འདུག་པས།",
    "དེ་དུས་ཀྱང་དབུ་བྱིན་ལ་ཡང་དྲོད་ཚ་ཚིལ་ལེ་བ་རླངས་པ་དང་བཅས་འདུག་གོ་ཞེས་ཐོས་ལ།",
    "ཐབས་ཀྱིས་འཕོངས་ཤིང་རང་སེམས་ཧད་དེ་ལུས།",
    "རང་རང་ཕྱོགས་དང་རིགས་མཐུན་འབྲེལ་པ་ཡིས།",
    "ཤིན་ཏུ་ལྐོག་གྱུར་བརྗོད་བྱར་བྱེད་པ་ལ་ལུང་རང་ཉིད་མི་འགལ་བ་ཡིན་ཏེ།",
    "བློན་པོའི་གདན་ལ་བྲམ་ཟེ་པང་ནས་སྐྱེས་འདུག་གོ།",
    "རྒོལ་བའི་གདན་ལ་ནི་བྲམ་ཟེ་ཉེ་རྒྱལ་འདུག་གོ།",
    "འཕགས་པ་སློབ་ལམ་པ་རྣམས་ཀྱང་རང་ཉིད་འཇིགས་པ་དང་བཅས་པའི་ཕྱིར།",
    "དེའི་རྗེས་ལ་སེམས་ཉིད་ཀྱང་རང་བཞིན་གྱིས་འོད་གསལ་བའི་སྟོང་པ་ཉིད་ལ་བློ་གཞག་པར་བྱའོ།",
    "མི་སྡུག་པར་དྲན་ཡང་རང་ཉིད་མཚན་དང་དཔེ་བྱད་ཀྱིས་བརྒྱན་པའི་ལུས་སྒྲུབ་པ་དང་།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བས་མི་དཔོགས་པ་དང་།",
    "ཙ་ན་ཀ་ལ་སོགས་པ་དང་།",
    "འོན་ཀྱང་རང་ཉིད་སྐྱེས་སྦྱངས་བློ་གསལ་ཞིང་།",
    "གང་རང་བཞིན་གྱིས་མཉམ་པར་བཞག་པ་དང་།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "འཁྲུལ་པ་ཡང་རང་རིག་པའི་མཐར་ཐུག་པ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་གཞན་གྱིས་རྟོགས་པ་ལ་སྦྱོར་བ་མ་ཡིན་པའི་ཕྱིར་ལ་དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་ཉིད་ནི་རྣམ་པར་རྟོག་པར་མི་རིགས་སོ།",
    "སྔོན་པོ་ལ་སོགས་པ་ཡང་ངོ་ཞེས་སྔོན་པོ་ལ་སོགས་པར་གསལ་བར་བྱེད་པ་ཉིད་ཀྱང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱིས་རྣམ་པར་ཤེས་པའི་ཐ་སྙད་ཙམ་སྒྲུབ་པར་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
    "རང་རིག་པའི་ཤེས་པ་རྣམས་ཀྱང་རང་རིག་པ་ཙམ་དུ་བྱ་བས་སྔ་མ་དང་ཕྱི་མའི་དངོས་པོ་གང་དུ་ཡང་མི་འཛིན་པའི་ཕྱིར་རྒྱུད་གཅིག་ཉིད་དུ་བཏགས་པས་དངོས་པོར་མེད་པའི་ཕྱིར་དང་།",
    "གཞན་ཡང་གང་དུ་གང་རང་ལས་སྐྱེ་བ་ལ་ནི་ཡུལ་ལ་སོགས་པ་ངེས་པར་མི་འགྱུར་ཏེ།",
    "དེ་ཉིད་ཀྱིས་ན་ཐ་སྙད་དུ་ཡང་རང་ལས་སྐྱེ་བ་མི་སྲིད་ལ།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་ལ་དམིགས་དགོས་ཏེ།",
    "འཁོད་པ་ནི་ཉེ་བ་ན་འདུག་པའོ།",
    "མུ་ཁྱུད་འཛིན་གྱི་བ་ཚ་ཅན་ལས་ཕྱི་རོལ་གྱི་རྒྱ་མཚོ་ལ་འདུག་པའི་རང་བཞིན་གྱི་གླིང་བཞི་དང་།",
    "མཉམ་པའི་དོན་གྱི་གང་ཞིག་དཔེའི་རྒྱུ་དང་ཉེ་བར་འདུག་ནས་དྲུང་ན་གནས་པ་དེ་ཡང་རིགས་པ་མ་ཡིན་ཞེས་པའི་དོན་ལ།",
    "རྒྱུ་དང་ཉེ་བ་ན་མི་འདུག་པས་དེ་ཡང་བྱེད་པར་སླ་བ་མ་ཡིན་ནོ་ཞེས་པ་ནི་ཆེན་པོའི་འབྲིང་ངོ།",
    "དེ་རྣམས་རང་ཉིད་ཀྱིས་བསམ་གྱིས་མི་ཁྱབ་ཅིང་རང་ཉིད་ཀྱིས་མཐར་སོན་པ་མེད་པས་མཐའ་ཡས་པ་སྟེ།",
    "རྗེས་སུ་ཡི་རང་བ་ནི་བྱེད་པའི་དད་པ་ཤིན་ཏུ་གཟེངས་བསྟོད་ཅིང་རང་ཉིད་ཀྱིས་དེ་ཐམས་ཅད་བསྒྲུབ་པའི་བསམ་པ་ཤིན་ཏུ་ཡང་བྱེད་པས་སོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པས་དེའི་དེ་ལ་ནི་འདིར་ཅུང་ཟད་བྱེད་དུ་མེད་ལ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་དག་པ་སྟེ།",
    "ཤིན་ཏུ་སྟོང་པ་ཉིད་ནི་གང་ཟག་དང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་དོ།",
    "མཉམ་པ་ནི་དེ་རྣམས་དང་རང་བཞིན་གྱིས་ཏེ།",
    "བར་མཚམས་མེད་པས་ཡོད་པའི་ཕྱིར་དེ་ལ་ཆད་པ་མེད་པས་སོ་སོར་དབྱུང་དུ་མེད་པའི་རྟེན་ཅན་ཏེ་དྲི་མ་དང་བཅས་པའི་གནས་སྐབས་སུ་ཡང་རང་བཞིན་གྱིས་ཡོངས་སུ་དག་པའི་དེ་ཁོ་ན་ཉིད་ཀྱི་སྒྲིབ་པ་མེད་པའི་མྱ་ངན་ལས་འདས་པའི་ངོ་བོ་ཅན་གང་རྣམས་ལ་གང་དུ་དབྱུང་དུ་མེད་ཅེས་པ་ནི་དབྱུང་དུ་མེད་པའོ།",
    "ལྷ་རྣམས་བཅོམ་ལྡན་འདས་ལ་མཉན་པ་དང་ལྡན་པ་རྣམས་དགའ་ཞིང་རངས་ནས་སྤྲོ་བ་འདི་ནས་དེ་རུ་ཡོངས་སུ་བསྐྱོད་པ་དང་།",
    "དེ་ཡང་རང་བཞིན་ཉིད་ཀྱིས་དག་པའོ་ཞེས་དགོངས་པའོ།",
    "འཆག་པ་དང་གནས་པ་དང་འདུག་པ་དང་ཉལ་བ་རྣམས་ལ་རྣམ་པར་མི་གཡེང་བའོ་ཞེས་པ་ནི་དྲན་པ་དང་བཅས་པའི་ཤེས་བཞིན་གྱི་རྟགས་སོ།",
    "དེ་ལྟར་ན་ཡང་རང་ཉིད་ཀྱིས་ཕྱིར་མི་ལྡོག་པའི་ས་ལ་ཐེ་ཚོམ་དུ་མི་འགྱུར་རོ།",
    "གནས་པ་ནི་འདུག་པའོ།",
    "དག་ཀྱང་རང་བཞིན་དུ་མི་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་ཏེ།",
    "རྟེན་དང་རང་གཞན་དོན་དུ་འདིར།",
    "དེ་མིན་གནས་ཡིག་འདིའི་པར་མ་དངོས་ཕུད་ད་དུང་ནང་དོན་གསར་པ་འཁོད་པའི་ལག་བྲིས་ཞིག་ཀྱང་ཡོད་ཚོད་འདུག་འོན་ཀྱང་ལག་སོན་མ་བྱུང་ཞིང་།",
    "ཨུཏ་ཏནཙ་ནས་༥ཙང་ཀུནུ་ལ་པ་ཝ་༤༤ གཉན་རུ་ལྷ་ཁང་།",
    "༡༥༨ལོར་བཏབ་པར་གསུང་མཁན་ཡང་གདའ།",
    "འཛམ་གླིང་དཀར་ཆག་ཅེས་པའི་དེབ་ཤོག་གྲངས་༣༨ དང་བོད་ཀྱི་ས་རིག་ཅེས་པའི་ཤོག་གྲངས་༣ ༡ཐོག་གསེར་གླིང་རྒོད་ཚང་ཞེས་པར་སི་ལེ་རྒོད་ཚང་ཟེར་བྲིས་འདུག་པ་མ་ཟད།",
    "འཕན་པོ་སྒོ་ལར་གོ་ལ་ཞེས་ཀྱང་འབྲི་སྲོལ་འདུག་ལ་དེ་ནི་ལྷ་སའི་བྱང་ངོས་སུ་ཡོད་པས་ལ་དེ་བརྒལ་ཏེ་གླང་ཐང་བརྒྱུད་གཞུང་ལམ་དུ་བསྐྱོད་ན་ལྷ་སར་འབྱོར།",
    "ཀུན་བདེ་གླིང་ལ་ཀུན་འདུས་གླིང་དང་ཀུན་དགའ་གླིང་ཞེས་ཀྱང་འབྲི་མཁན་འདུག་བསྟན་རྒྱས་གླིང་།",
    "མ་རུ་སོགས་འབྲི་སྲོལ་འདུག་ཀྱང་ཁོ་བོས་གླེ་རུ་ཞེས་བྲིས་ན་ཅུང་འཚམ་པར་མཐོང་།",
    "ཕྱི་ཡི་སྐོར་ལམ་དུའང་རང་བྱོན་མང་པོ་བསྟན་རྒྱུ་ཡོད།",
    "དེ་ན་བི་རོ་ཙ་ནའི་སྒྲུབ་ཁང་ཡོད་པས་ཁོང་མཚམས་ཞུགས་སའི་སྒྲུབ་ཕུག་དང་སློབ་དཔོན་པད་མ་འབྱུང་གནས་ཀྱི་སྐུ་འདྲ།",
    "གོ་དཀར་ལ་ཞེས་ལ་མིང་འདོགས་མཁན་ནི་ལོ་ཆེན་བེ་རོ་ཙ་ན་ཡིན་སྐད།",
    "དེབ་སྔོན་ནང་དུ་དཔེ་དཀར་གླིང་བཅས་འཁོད་འདུག་པས།",
    "དམ་པ་དེའི་སྐུ་གདུང་མཆོད་རྟེན་མཆིམས་ཕུར་ཡོད་ཀྱང་ཧ་ལམ་དུས་རབས་ཉི་ཤུའི་དུས་དཀྱིལ་ཙམ་ལ་ཆུ་ལོག་ཀྱིས་རྐྱེན་པས་ནུབ་བཟོ་འདུག་གསུང་བཏུས་ཐེག་ཆེན་རྒྱ་མཚོ་ཤོག་གྲོངས་སྨདཀྱ་ཙྩལ་༡༦༨དང་།",
    "ཟུར་མཁར་ནི་ཟུང་ཀར་ཞེས་ཀྱང་འབྲི་སྲོལ་འདུག་ཟུར་མཁར་རྡོའི་མཆོད་རྟེན་ཆེན་པོ་ལྔ་ནི་ད་ལྟའང་མཇལ་རྒྱུ་ཡོད་པ་དེ་ནི་མཁྱེན་ལྔ་པའི་མཚོན་རྟགས་ཡིན།",
    "དེབ་སྔོན་ཤོག་གྲངས་༩༦དུ་བྲེ་སྟོན་འབུམ་ལ་འབར་གྱིས་དུས་རབས་བཅུ་གཅིག་ལ་གནས་གསར་ཞིག་ཕྱེས་པར་འཁོད་འདུག་ལ།",
    "བེ་རོ་ཙ་ན་བཞུགས་ས་སྤང་གོར་དགོན་དང་།",
    "གོང་དཀར་རྡོ་རྗེ་གདན་པ་ཀུན་དགའ་རྣམ་རྒྱལ་གྱི་མཚན་གཞན་ཞིག་ལ་ཐུ་མི་ཀུན་དགའ་རྣམ་རྒྱལ་ཡང་ཞུ་སྲོལ་འདུག་ཁོང་ནི་གྲ་ནང་རྒྱལ་ཆེན་གླིང་དུ་ཡབ་ཐུ་མི་སམ་བྷོ་ཊའི་གདུང་རྒྱུད་རྒྱལ་བ་ཤེས་རབ་དང་།",
    "ཕུ་མ་བྱང་ཐང་ལ་ཕོ་མ་ཆང་ཐང་ཞེས་ཀྱང་ཟེར་སྲོལ་འདུག་པས་དེར་ཡར་འབྲོག་གཡུ་མཚོ་ལས་ས་ཁ་མཐོ་བའི་ཕུ་མ་གཡུ་མཚོ་ཞེས་པའི་མཚོ་ཆེན་ཞིག་ཡོད་པ་དང་།",
    "དགའ་གདོང་དགོན་གྱི་བྱམས་པ་ཕལ་ཆེར་རྒྱ་གར་ཤར་ནས་སྐྲུན་པའི་ལི་དམར་གྱི་བྱམས་སྐུ་དེ་ཡིན་བཟོ་འདུག་བཀྲ་ཤིས་ལྷུན་པོ་ནས་གྱེན་དུ་ཕྱིན་པ་ན་གཏུམ་སྟོན་བློ་གྲོས་གྲགས་པས་བཏབ་ཅིང་མཆིམས་སྟོན་རིམ་བྱོན་སོགས་ཀྱི་གདན་ས་བཀའ་གདམས་བསྟན་པའི་འབྱུང་གནས་སྣར་ཐང་ཞེས་གྲགས་པ་དེར་སྤྱིར་རྟེན་གསུམ་བྱིན་ཅན་མང་པོ་དང་།",
    "དེ་མིན་རྒྱུན་ལྡན་གྱི་སྒྲུབ་ཁང་བྲག་ཕུག་མང་པོ་མཇལ་ས་ཏཱ་ར་ན་ཐའི་གསུང་རྩོམ་ནང་ཞིབ་ཏུ་འཁོད་འདུག་ཕུན་ཚོགས་གླིང་ཉེ་འཁོར་དུ་བྲག་རམ་མགོན་ཁང་ཡོད་པ་དེ་ནི་གྲགས་ཅན་བེ་ཁ་རྩེ་ཡི་བསྟེན་ཁང་ཡིན།",
    "ཞོང་རྡོ་རྗེ་གདན་ཞེས་པར་ལ་ལས་ཞང་ཞོང་རྡོ་རྗེ་གདན་ཞེས་འབྲི་མཁན་འདུག་ཀྱང་མ་དག་པར་མཐོང་།",
    "ཆུ་བོ་རི་དགོན་ནི་བཙན་པོ་ཁྲི་སྲོང་ལྡེའུ་བཙན་གྱི་སྐབས་ཕྱག་བཏབ་ཅིང་གླང་དར་མའི་༨ ༣༦༨༤༡སྐབས་སུའང་རང་སོར་གནས་ཡོད་པས་ཕྱིས་སུ་རྟ་སྟོན་ཇོ་ཡེ་ཡི་གདན་སར་གྱུར།",
    "ཡང་དེབ་ཐེར་འགའ་ཞིག་ཏུ་མངའ་རིས་རིག་འཛིན་ལེགས་ལྡན་རྡོ་རྗེ་ཞེས་པའང་འདུག་ཚེས་བཅུ་བཀོད་པའི་བླ་བྲང་ཞེས་པ་དེར་ཚེས་བཅུ་གླིང་ཡང་གྲགས་ཤིང་ཆུ་བོ་རིའི་ཤར་ངོས་སུ་ཡོད་པ་དང་།",
    "དགའ་གདོང་ནས་མར་ཕྱིན་པའི་སྟོད་ལུང་མདར་རི་སྒང་ཞིག་ཏུ་དངོས་གྲུབ་སྡིངས་ཞེས་སེར་སྲུང་འདུག་སའི་སྒྲུབ་ཁང་ཆུང་དུ་ཡོད།",
    "ཁ་ཕྱེད་ཙ་ན་དབུལ་བའི་སྡུག་བསྔལ་དང་བྲལ་ལོ།",
    "ཞེས་གསུངས་འདུག་པའི་ཕྱིར་རོ།",
    "འདི་བས་གདམས་ངག་ཀྱང་ང་རང་ཆེ།",
    "རྟོགས་པ་ཡང་ང་རང་མཐོ་སྟེ།",
