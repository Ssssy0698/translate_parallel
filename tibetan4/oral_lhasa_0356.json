    "བྱིས་པའི་སྤྱོད་ཡུལ་ནུབ་པར་ཡང་།",
    "ཟློག་པར་མི་ནུས་དཔའ་བོ་འདྲ།",
    "ཁྱད་པར་ཤིན་ཏུ་རྣལ་འབྱོར་གྱིས།",
    "སྡིག་ལྡན་རྐང་གཉིས་འཛོད་འོས་པར།",
    "གྲངས་མེད་ཁྱད་པར་འཕགས་པ་ཡི།",
    "གཟུགས་ཅན་འཐས་པ་འབིགས་པར་མི་ནུས་འདི་དག་ཀྱང་།",
    "མཁྱེན་པའི་སྤྱན་ཟུར་རྣོན་པོའི་སྟེན་དུ་མ་བཟོད་ནས།",
    "རྣལ་དུ་མ་ཕེབས་ཡིད་ཀྱང་འདེགས་འདེགས་མཐོང་མ་གྱུར།",
    "མཁའ་དང་འདྲེས་པར་སྙོམས་ཞུགས་གྱུར།",
    "ཐ་དད་མེད་པར་དམ་ཡང་བཅས།",
    "ཞིང་ཁམས་ཀུན་ཏུ་རོལ་པར་གྱུར།",
    "གཏོར་ཞིང་བླུགས་པའི་བྱ་བ་བྱས།",
    "གསང་བའི་ཡུལ་རྣམས་རིམ་གྲོ་པར།",
    "༢༢༤ ལེགས་པར་བསྒྲགས་ནས་སྐྱོད་བྱེད་ཟུང་།",
    "རྡོ་རྗེའི་མདུད་པར་ལེགས་བསྣོལ་ཅིང་།",
    "མྱ་ངན་དེ་ཡིས་ལྷ་དང་མིར་བཅས་འཛིན་མ་རྣམས་ཀྱང་བསྐྱོད་ཅིང་བག་མི་ཕེབས་པར་གྱུར།",
    "༢༢༧ རྐང་གཉིས་པ་རྣམས་མཆི་མའི་རྒྱུན་གྱིས་རྣམ་པར་འཁྲིལ་ལྡན་ལག་པའི་ལྕག་མ་འདར་བ་ཡིས།",
    "ངེས་པར་བརྟགས་ན་རྡོ་རྗེའི་ཁམས་འབའ་ཞིག།",
    "བརྗོད་འདས་དཀྱིལ་འཁོར་མཆོག་དང་མི་གཉིས་པར།",
    "བླ་བྲེ་བཞིན་དུ་རྣམ་པར་ངེས་པ་ཡིས།",
    "བསམ་འཕེལ་ཡིད་བཞིན་ནོར་བུ་རྣམ་པར་བཞག།",
    "རྣམ་པར་བཀོད་ཀྱང་ཡི་གེར་མི་བཟོད་དད་པའི་མེ་ཏོག་སྐྲུན་བྱེད་རྒྱུ།",
    "ངེས་པར་སྣང་བས་ཕྱེ་བར་འགྱུར།",
    "བསླུ་བ་མེད་པའི་སྐྱབས་གཅིག་ཀརྨ་པར།",
    "བཏུད་ནས་འཁྲུལ་སྣང་བདེན་པར་ཞེན་པ་ཡི།",
    "སྒྲུབ་ཕུག་ཕྱི་ནང་གནས་མཇལ་ཞིབ་པར་བྱས།",
    "གཞན་ཡང་སྐུ་གསུང་ཐུགས་རྟེན་མཛེས་པར་མཐོང་།",
    "དེ་ནས་རྟག་བརྟན་ཕུན་ཚོགས་གླིང་ཞེས་པར།",
    "མཆོད་སྡོང་ཁྱད་པར་འཕགས་པའི་མདུན་བདར་ནས།",
    "བསུ་བའི་ཚུལ་དུ་བྱས་ཞེས་ཡུལ་དེར་གླེང་།",
    "དར་རྒྱས་གླིང་དུ་གུར་ལ་བརྟེན་ནས་བསྡད།",
    "ཞག་པོ་གསུམ་པར་བཟླས་པ་ཅུང་ཟད་བྱས།",
    "མེ་ཏོག་ཕུལ་བས་ཞལ་དུ་བཞེས་པ་སོགས།",
    "ཞག་གཅིག་གནས་མལ་བྱས་པའི་ཐོ་རངས་ཁར།"
  ]
}