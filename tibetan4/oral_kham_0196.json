    "རྗེས་ཐོབ་ཤན་འབྱེད་ལྟེ་བ་གཏན་ལ་འབེབས་པའས་འདེན་པ་གཉིས་སུ་ཕྱེ་བ་ཡོད་ཀྱང་རང་རྒྱུད་ཀྱི་བདེན་གཉིས་བྱ་ཚུལ་དང་མི་འདྲབ་ཞིག་ཡིན།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "དེ་གསུམ་ཀྱི་ཀུན་གཞི་དང་རང་རིག་བདེན་གྲུབ་ཏུ་འདོདོ་པའི་གཞུང་འདི་ཞེས་ངེས་བཟུང་དགོས་ལ་དེ་མེད་པའི་ཕྱིར་དང་།",
    "འཁྲུངས་ནས་ཞག་ཤེས་ནས་རྫོགས་ཆེན་ལྔ་པའི་ཡང་སྲིད་དེར་འཁྲུངསའདུག་ཅེས་སྲས་སྨྲས་མེད་པ་ཡོངས་ལ་ཁྱབ་གདལ་དུ་གྲགས་པ་སོགས་དོ་མཚར་བའི་ལྟས་བསམ་གྱིས་མི་ཁྱབ་པ་དང་བཅས་ཏེ་མཚན་དཔེའི་འཁྲི་ཤིང་གསར་དུ་བཞད།",
    "དང་པོ་ལའང་རང་བཞིན་མ་དམིགས་པ་དང་།",
    "སྙིག་པ་བས་ཀྱང་ཆེར་སྙིག་དུས།",
    "རང་རང་ཡིད་ལ་གང་བསམ་། འདོད་དགུའི་སྤྲིན།",
    "དེ་ལྟར་དབེན་གསུམ་དང་ལུས་ཀྱི་བྱེད་པ་བཅིངས་པའི་འདུག་སྟངས་ཀྱིས་རྩ་གཡོ་མེད་དུ་འཆིང་།",
    "དེ་ཡང་མཐའ་༢གཅིག་ཏུ་མ་ངེས་པར་འདུག་ཅིང་ལྷབ་ལྷབ་འབར་བའི་རྣམ་པ་ཅན་དུ་བྱུང་ན།",
    "རྐང་པ་བརྐྱངས་བསྐུམ་དུ་འདུག།",
    "འཇུག་དུས་སེམས་དང་རྟགས་སྣང་བསྲེ།",
    "འཁོར་ལོ་སོ་སོར་བུམ་ཅན་འཛིན་པ་དང་འདུག་སྟངས་སྤོག་ཆོག་རྣམས་ཞིབ་པར་ཁྲིད་ཡིག་ལས་ཤེས་པར་བྱའོ།",
    "དེ་ཡང་རང་དང་ཡུམ་དུས་འཁོར་ཡབ་ཡུམ་དུ་གསལ་བཏབ་རྩ་གསུམ་འཁོར་ལོ་བཞིའམ་དྲུག་གསལ་དེ་དང་སྟོང་གཟུགས་བསྲེ་ཐུབ་ན་རབ།",
    "ཆ་དྲུག་ལ་ནི་འབུམ་ཕྲག་གཉིས་གཉིས་སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྦྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "ཚངས་དང་ཁྱབ་འཇུག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རྒྱལ་པོ་ལོ་ནི་མཐའ་དག་རྗེས་སུ་ཉིན་ཞག་དུས་སྦྱོར་ཆུ་ཚོད་དག་དང་ཆུ་ཡི་སྲང་རྣམས་ཏེ།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད།",
    "དེ་ལྟར་གཟའ་རྣམས་ཀྱི་ནི་རྒྱུ་བ་མཐའ་དག་དུས་ཀྱི་འཁོར་ལོ་དག་ལས་ཤིན་ཏུ་ངེས་པར་འགྱུར།",
    "དཀར་པོའི་མདའ་དང་ཆུ་གཏེར་ཟླ་བ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར།",
    "གང་ཞིག་མ་སྤྱད་ཕྱེད་ཀྱི་ཆུ་ཚོད་དེ་ནི་དུས་ཀྱི་ཉིན་ཞག་དུས་། ལ་ཆ་དམན་ཟླ་བ་སྟེ།",
    "དེ་ལ་ཡུད་ཙམ་སུམ་ཅུ་རྣམས་དང་ཉིན་ཞག་དུས་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ན་སྟེ།",
    "ཡང་དག་དུས་སྦྱོར་ཐམས་ཅད་ཀྱིས་ཏེ་སླར་ཡང་གལ་ཏེ་རང་ལུས་གཡོན་གྱི་རྩ་ལས་གྱུར་པ་ན།",
    "རང་རང་ཡི་གེས་ཤེས་བྱ་རྣམ་གསུམ་ཁྱབ་བདག་བགྲོད་པ་རྣལ་འབྱོར་པ་ཡིས་སྟོང་པའི་དབྱེ་བས་སོ།",
    "གལ་ཏེ་བྱ་བ་དང་། བཅས་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཇི་ལྟར་འགྲོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཡིས།",
    "ངེས་པར་འཇམ་པའི་མལ་སྟན་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་བསྲུང་བ་བྱས་ནས་ནི།",
    "ཕྱི་ནས་ཤེས་རབ་ལ་སོགས་དྲུག་ནི་རབ་ཏུ་གསལ་བར་བདག་པོར་ང་རང་པདྨའི་གདན་ལའོ།",
    "གདེངས་ཅན་རིགས་དང་བཅས་པ་རང་རང་ཕྱོགས་ཀྱི་བཞོན་པར་གནས་པའི་ལྷ་རྣམས་རྡོ་རྗེ་གདན་གྱིས་གནས།",
    "ཀཾ་ངཁྱབ་འཇུག་དུས་ཏེ་འཕྲོག་བྱེད་ཅེས་དང་ནོར་སྦྱིན་དག་ཀྱང་སཾ་དང་འདིར་ནི་ཆཉིད་དོ།",
    "དབྱེ་དང་བསྐྲད་པ་དག་ཀྱང་རང་ཝ།",
    "ཧཱུཾ་ཡིག་ཡེ་ཤེས་ལས་སྐྱེས་འཇིག་དུས་སྤྲིན་དང་མཚུངས་པ་རྩེ་ལྔ་འོད་ཟེར་དང་བཅས་ོ་དགོད་པར་བྱ།",
    "སྔགས་ཀྱིས་དགུག་པར་རབ་ཏུ་འགྱུར་ཏེ་གདོན་གྱི་ཚོགས་པ་མཐའ་དག་དུས་ཀྱི་སོས་ཟིན་རྗོད་པར་བྱེད།",
    "གཡས་པ་བརྐྱང་ཞིང་རང་རང་སྣོད་རྣམས་ཀྱིས་ནི་ལྷ་མིན་ཁྲག་འཐུང་སྐྲ་གྲོལ་གོས་དང་བྲལ་བ་སྟེ།",
    "སྣ་ཚོགས་དངོས་རྣམས་ཀྱིས་བྱེ་རྒྱལ་བ་དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཉིས་འགྱུར་མི་བདག་གཞན་རྣམས་ཚེས་ནི་བརྒྱད་གཉིས་དབྱེ་བ་ལ།",
    "རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྐང་པ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ།",
    "དེ་ཡི་དུས་སུ་རྒྱལ་པོའི་འགྲོ་བ་དག་ནི་རང་རང་ཚད་ཀྱིས་རྣམ་པར་ཉམས་པར་རབ་ཏུ་འགྱུར།",
    "༡༧༡ཤུ་འགའ་ཞིག་ལྷག་པའི་བརྒྱ་ཕྲག་གང་ཞིག་དུས་དང་དགུ་ཡིས་མི་རྣམས་ཀྱི་ནི་འཇིག་རྟེན་ཚད།",
    "ལུང་སྟོན་པའམ་བརྡའ་སྤྲོད་པ་དག་ལ་ལྷ་ཀླུས་བཀོད་པའི་རྐྱེན་དང་རང་བཞིན་སོགས་སུ་ཕྱེ་བའི་སྒྲ་སོགས་འདི་རིགས་འདི་མི་རིགས་ཞེས།",
    "རིགས་བཞི་དང་རང་བཞིན་གྱི་རིགས་ལྷན་ཅིག་པའི་རིགས་ལྔ་དང་།",
    "རང་བཞིན་མེད་ཀྱང་རྣལ་འབྱོར་པས་དམིགས་ཤིང་རང་རིག་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་ལྟར་གཙོ་བོ་རང་རང་ལས་མ་བྱུང་བའི་ཁམས་ལྷག་མ་གསུམ་ནི་ཁུ་བ་དང་རྡུལ་ཕན་ཚུན་འདུས་པའི་རྐྱེན་ལས་ཕལ་པའི་རྒྱུ་ལས་བྱུང་བའོ།",
    "འདིར་ཨི་ཡར་བསྒྱུར་བ་སོགས་བཞི་ཀ་ཙ་ན་སོགས་སྒྲ་གཞུང་རྣམས་ལ་ཡོངས་སུ་གྲགས་པ་ཡིན་ལ་ཨ་ཡིག་ཧར་བསྒྱུར་བ་འདི་ཀ་ཙ་ན་སོགས་སུ་མ་གྲགས་ཀྱང་ཤམ་བྷ་ལའི་འཇམ་དཔལ་བརྡ་སྤྲོད་ཀྱི་ལུགས་ལ་ཡོད་དོ།",
