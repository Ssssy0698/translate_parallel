    "ཡང་ན་འཕྱི་དྲགས་འདུག་ཅེས་གསུངས་པ་བཞིན་ནོ།",
    "དེ་བཞིན་ཁོ་རང་ཉིད་ཀྱི་མི་དམངས་ནས་ཀྱང་།",
    "ཁོང་རང་ཉིད་ཀྱི་ཚབ་བྱེད་གསུམ་ཟེར་བ་འདོན་གནང་མཛད་ཅིང་།",
    "ཚང་མས་མགྲིན་དབྱངས་གཅིག་གྱུར་གྱིས་ཚབ་བྱེད་གསུམ་ཡག་པོ་འདུག་དེའི་ནང་དོན་གཏིང་ཟབ་ལ།",
    "དེས་དུས་ཡུན་ངེས་ཅན་ཞིག་ནང་རང་ཉིད་ཀྱི་ཆབ་སྲིད་ལམ་ལུགས་ཀྱི་ཚེ་སྲོག་ཅུང་ཟད་བརྟན་དུ་བཟོས།",
    "ཁ་གཏད་གཅོག་པའི་ནུས་ཤུགས་ཀྱི་ས་བོན་ཞིག་དུས་དེ་ནས་བཏབ་ཅིང་།",
    "དེ་ནི་མནའ་གན་རྩིས་མེད་གཏོང་མཁན་གྱི་མི་དེས་དུས་ནམ་ཡང་རང་ཉིད་ཀྱི་ཁེ་ཕན་ཁོ་ནའི་ཆེད་དུ་འབད་བརྩོན་བྱེད་ཕྱིར་ཡིན།",
    "ཕན་ཚུན་གཉིས་ཀས་རང་རང་སོ་སོའི་ཀླད་པའི་ནང་ལྟ་བ་གང་ཡོད་པ་དེ་ལ་བརྩི་འཇོག་བྱས་ཚེ།",
    "དེས་མུ་མཐུད་དུ་ཁྱེད་རང་མི་སེར་སྤེལ་ཡུལ་ཞིག་བྱེད་འདོད་པ་ཡིན།",
    "ཇི་ལྟར་ལྷག་བསམ་ཟོལ་མེད་ངང་རང་ལ་ཞབས་འདེགས་ཞུ་རྒྱུ་ཡིན་མིན་གསལ་པོར་ཤེས་ཡོད།",
    "སྤྱང་ཀིས་ག་དུས་ཡིན་ནའང་ལུག་ཟ་བ་དང་།",
    "རྒྱལ་ཁབ་བམ་མི་རིགས་ཤིག་དུས་ནམ་ཡང་རྒྱལ་འཚོང་བ་དང་ཞབས་འདྲེན་པ་ཁྱུ་ཞིག་ལ་སྐྲག་ནས་བླ་འཁྱམས་མི་སྲིད།",
    "ཕྱི་རྒྱལ་བོད་མི་ཚོའི་ནང་དུའང་ངོ་ལོག་པ་ཡོད་འདུག་འདི་ནི་ང་མི་ཞིག་ཡིན་པའི་ཆ་ནས་ཁས་ལེན་གཙང་མ་ཞུ་ཐུབ།",
    "གལ་སྲིད་ཁྱེད་ཚོས་ངེས་པར་དུ་བསྒྲུབ་དགོས་ཀྱི་འདུག་ན།",
    "ཁྱེད་ཀྱི་ཐེ་ཚོམ་གྱིས་ཁྱེད་རང་ཉིད་འཕུང་བར་བྱེད་པ་ལ་ངས་ཡིད་ཆེས་གཙང་མ་ཞུ།",
    "དེ་ཡང་རང་མི་རིགས་དབར་ཕྲག་དོག་བྱེད་པ་དེ་སྤང་དགོས།",
    "དེ་ནི་བཅིངས་འགྲོལ་དང་རང་བཙན་གྱི་དཀའ་རྙོག་ཅིག་དང་།",
    "ཁྱེད་ཚོས་རང་རང་སོ་སོའི་ལངས་ཕྱོགས་ཀྱི་ཆེད་དུ་འཐབ་རྩོད་གྱིས་ཤིག་ཅེས་རྗོད་སྐབས།",
    "ཁོ་ཚོ་ནི་དུས་ནམ་ཡང་རང་བཙན་གྱི་ཁྱིམ་ཚང་གཉིས་ཡིན།",
    "ག་དུས་ཡིན་ཡང་འགལ་ཟླ་ལས་དཀའ་ངལ་སེལ་བྱེད་ཀྱི་འབྱུང་རྩ་བཙལ་ནའང་།",
    "ཁོ་རང་ཉིད་མཐོང་ཆུང་དམའ་འབེབས་བྱ་སའི་གནས་སུ་སྐྱེལ་བར་ངེས།",
    "ཁོ་རང་ཉིད་སེམས་ཤུགས་ཆག་བསྡད་པས།",
    "བྱ་དངོས་ལ་མཚོན་པར་བྱེད་པ་དེ་ཡང་རང་འགུལ་གྱིས་ཡིན་ཞེས་གསུངས་པ་དང་རྗེས་སུ་མཐུན།",
    "དེ་ལས་ཀྱང་རང་འགུལ་གྱིས་བྱ་དངོས་གཞན་དང་བར་ཐག་ཉེ་རུ་གཏོང་བའི་ནུས་པ་ལྡན་ཡོད།",
    "ཁོ་རང་ཉིད་ཀྱིས་མ་བསྒྲུབ་པའི་ཁར།",
    "ཁྱེད་རང་རྟར་མ་ཞོན་ལ།",
    "མ་འོངས་པའི་ལོ་ཟླའི་ནང་ཟོས་ནས་སྒུག་བསྡད་ན་འགྲིག་པར་འདོད་པའི་མི་དེ་དག་སྐབས་དེར་ཐུག་དུས་སྒུག་ན་བཟང་ཚུལ་གྱི་བསམ་འཆར་འདོན་མཁན་གྱི་མི་དེ་ཚོ་ཡང་བརླག་ནས་མེད་པར་འགྱུར།",
    "ཁ་ཁུ་སིམ་པོའི་ངང་རང་ཉིད་ཀྱི་ཆེད་དུ་འབད་བརྩོན་ཞུ།",
    "འགན་འཁྲིའི་བསམ་བློ་ཞིག་ཀྱང་རང་བཞིན་གྱིས་ལྡན་ཡོད།",
    "ཚེ་སྲོག་དང་རང་གཤིས་ལ་བརྙས་བཅོས་བྱས་པ་ལས་མ་འདས།",
    "ཚད་འདི་ལ་ཐུག་དུས།",
    "དེའི་ནང་རང་ཉིད་ཀྱི་མི་རིགས་དར་རྒྱས་ཡོང་བ་དང་།",
    "ཁྱེད་རང་གྲལ་མཇུག་ལ་འཇོག་པར་བྱ་སྟེ།",
    "བཙོན་པའི་ཕུང་བོ་སྦས་མི་ཚར་བའི་གནས་ཚུལ་ཐོན་འདུག་དེར་བརྟེན་རྐྱེན་ལམ་དུ་ཕྱིན་པའི་མི་ཁྲི་ཕྲག་ཁ་ཤས་ཀྱི་ཕ་མ་དང་བཟའ་ཟླ།",
    "ཁྱེད་རང་ཁྱེད་ཀྱི་ཕ་མའི་བུ་རྒོད་ཅིག་བྱེད་འོས་སམ།",
    "ག་དུས་ཡིན་རུང་བོད་སྡོད་ཨམ་བན་གྱི་བཀའ་ལ་ཉན་ངེས་ཡིན།",
    "རྐུན་མས་ཀྱང་རང་ཉིད་གནས་སྐབས་རིང་ཉེན་ཁ་ལས་ཐར་བ་ཤེས་ཤིང་།",
    "དེ་ནི་ཁྱེད་རང་ལ་ངོ་ཚ་མེད་ཁར།",
    "ཁྱེད་རང་འགྲིག་བཞག་ཟེར་དུས།",
    "ཁྱེད་རང་ནོར་བཞག་ཟེར་དུས།",
    "ཡང་ན་ཁོ་རང་ཉིད་སྟོབས་ཆེན་ཞིག་ཡིན་པ་གཞན་ལ་ངོས་ལེན་བྱེད་དུ་འཇུག་དགོས།",
    "འབྲས་བུ་ཞིག་དུས་ནམ་ཡང་མ་ཐོབ།",
    "དེ་ནི་ཁོ་རང་ཉིད་རང་ལ་བདག་པས་ཡིན།",
    "ཤེས་བཞིན་དུ་གཞན་གྱི་མགོ་སྐོར་འོག་འཚུད་འདོད་མཁན་ཡང་མང་པོ་འདུག་མི་ཁ་ཤས་ཀྱིས་ད་དུང་ལས་བཟོ་བ་རྣམས་ལ་རྡོ་རྗེ་ཕ་ལམ་གྱིས་བསླུ་བྲིད་བཏང་སྟེ།",
    "ཁྱེད་རང་ཅིའི་ཕྱིར་རང་བྱུང་ཁམས་ཀྱི་བྲག་རྡོ་ལ་མི་དགའ་བར།",
    "ཁྱེད་རང་མེ་ཏོག་ལ་དགའ་བའི་ཚད་དེ་དུད་འགྲོ་ལ་དགའ་བའི་ཚད་ལས་བརྒལ་ཡོད།",
    "ཁོ་ཚོ་ག་དུས་ཡིན་ནའང་ཞི་དུལ་བག་ཡོད་ཀྱི་ཚབ་བྱེད་མཁན་ཡིན་ལ།",
    "ཁ་ཐོར་དུ་བཏང་བའི་མི་ཡང་རང་ཉིད་གཅིག་པུ་ལོགས་སུ་སྡོད་མི་སྲིད།",
    "བདག་མེད་དུ་དོར་བའི་བཟོ་བཀོད་དེའི་ནང་མི་འདུག་མཁན་མེད་ཚེ།",
    "ཁོ་རང་རྒྱང་དུ་དོར་མཁན་དེ་ནི་ཁོའི་ལག་འོག་ཏུ་ཡོད་པའི་གཉོམ་ཆུང་ཞིག་ཡིན་པ་ལས།",
    "དེ་ཡང་རང་ཉིད་ཀྱི་སྟོབས་ཤུགས་ཀྱིས་ཁེབས་པའི་ཁྱབ་ཁོངས་དེའི་ནང་།"
  ]
}