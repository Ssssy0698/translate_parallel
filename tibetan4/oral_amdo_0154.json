    "རྒྱ་ཆེན་སྤྱོད་པའི་ལམ་ལ་རྣོ་བ་ཁྱོད།",
    "ཡང་དག་གྲོགས་ཀྱི་རྩེ་མོར་རབ་དགའི་ཚད།",
    "ལག་གི་རི་མོ་སྤེལ་བ་མྱོང་བས་སྤྲོ།",
    "ས་རྒྱ་ཆོད་པའི་ཚལེགས་ཚོགས་མ་དམིགས་མོད།",
    "ངོ་ཚའི་བསླབ་པ་ཕུལ་བའི་གཡབ་མོ་ལས།",
    "ཅི་ཟེར་ངག་ཉན་བ་ལང་ངུར་བས་བྲེལ།",
    "ཕ་རྒན་ཕྱི་མའི་ལྟད་མོར་གཏོང་བའི་བུ།",
    "ཉིན་རེ་བཞིན་དུ་བྲི་ཞིང་འབྲི་བའི་ཚུལ།",
    "ཁྱོད་ཀྱི་འབྱོར་བ་ཉམ་ངའི་གཅོང་རོང་དེར།",
    "རྐྱེན་ངན་ལམ་སློང་ཤེས་རབ་འོད་སྣང་གིས།",
    "བསམ་སྦྱོར་རྣམ་དག་ཆ་རེས་འབྲེལ་བ་ཡང་།",
    "ཁྱོད་ནི་ཁོ་བོར་དྲིན་གྱིས་ཆེ་བའི་ཚུལ།",
    "རེག་བྱ་ལྕི་བའི་འཕྲིན་ཡིག་ག་ལ་དགོས།",
    "སྲོག་གི་གཡོ་བ་རི་གཟར་འབབ་ཆུ་དང་མཚུངས་ཤིང་།",
    "རིན་ཆེན་གསུམ་ལ་འབོད་པའི་ངུ་དབྱངས་འདི་ཐལ་ལོ།",
    "རེ་བའི་མིག་འབུར་སྤྲང་བཙུན་ཁོ་བོ་ཡི་ཕྱོགས་སུ།",
    "ད་ལྟ་རང་ལོ་བཞི་བཅུའི་ངོ་མཐོང་གི་བར་དུ།",
    "མཆོག་གསུམ་ལས་འབྲས་གཡས་བཞག་གཡོན་བཞག་གི་ངང་ནས།",
    "རྣམ་དག་བློ་གྲོས་ཀུ་ཤའི་རྩེ་མོ་ལྟར་ཕྲ་ཡང་།",
    "རྡོ་རྗེ་འཆང་གིས་བཀའ་བསྒོས་དམ་བཞག་དེ་བསྙེལ་ཅི།",
    "སོང་ས་བསྡད་སར་ཐོས་བསམ་འཕེལ་བ་ཞིག་བྱུང་ན།",
    "ཤི་བ་བསྐུལ་མར་སོང་ན་ཡི་རང་གི་གནས་ཏེ།",
    "རྒ་ན་འཆི་དང་དགེ་སློང་བཞི་གཟིགས་པའི་རྐྱེན་གྱི།",
    "རང་རེའི་སྟོན་པ་ཡང་རབ་ཏུ་བྱུང་བ་མིན་ནམ།",
    "གཏན་འདུན་ལག་པའི་རྩེ་མོར་འཁྱིལ་བ་ཞིག་འདོད་ན།",
    "དགེ་ཕྲུག་ཐོས་བསམ་པ་རྡོ་སྦིས་གྲགས་པ་རྒྱ་མཚོ་གནས་བསྐོར་དུ་སོང་བ་ལ་ཐུགས་སྐྱོ་བའི་རྣམ་པས་གནང་བའོ།",
    "འཕགས་མ་གཅིག་ལྷག་བཅུ་ཕྲག་ཟུང་གི་དབུས།",
    "འདི་ནའང་གསར་འཚེའི་གླགས་འཇུག་དང་བྲལ་ཞིང་ཐོས་བསམ་གྱི་མོས་བློར་མཆིས།",
    "རྒྱ་ནག་འདི་དག་ལན་ཇུ་བེ་ཅིང་གི།",
    "རྒྱ་མ་ཡིན་པར་སྐད་ཀྱིས་ཤེས་མོད་ཀྱང་།",
    "རྒྱ་མོ་སྤྱོད་པས་ཉ་ལ་ཇི་བཞིན་དུ།",
    "རྒྱ་ཆེའི་ཁོག་འདོན་ཧ་ཅང་ཐལ་ཆེས་ནས།",
    "རྒྱ་ལ་ལྟོ་སྡུག་བྲན་མོའི་ལས་བགྱིས་པས།",
    "ད་དུང་བརྗོད་པར་བྱ་བ་མི་ཉུང་མོད།",
    "བློ་གྲོས་གཞལ་བྱའི་རྩེ་མོར་འཛེགས་པས་བཟང་།",
    "ཡེ་དག་གནས་ལུགས་རྗེན་པར་གཟིགས་པས་ཤེས།",
    "གསུང་གི་གངྒཱ་ཛམྦུའི་གསེར་བཟང་ཅན།",
    "འཕེལ་བས་རེ་ཞིག་ཅི་ཡང་མི་སྨྲ་ཐོབ།",
    "གཉིས་མེད་གསུང་གི་མཚར་སྡུག་ངོམ་བཞིན་དུ།",
    "ཚེ་འདིའི་སྣང་ཤས་གཞིལ་བའི་ལྟད་མོ་མཐོང་།",
    "ངོ་མཚར་པར་གྱི་ཕྱི་མོར་སྤེལ་བའི་ལས།",
    "བས་པར་སྨྲས་ན་ནོངས་པ་མི་རྫོགས་མོད།",
    "མོད་དཀོན་གོ་ལོག་རྩིས་ལ་འཇམ་པའི་དབྱངས།",
    "འབྱོར་པ་མཆོག་གི་དྲི་བཟང་འབུམ་འཕྲོ་བ།",
    "ཤིང་གླང་མགོ་ཟླའི་ཚེས་ལ་ཕྱག་གི་རིས།",
    "སྒྲ་དབྱངས་ལྷ་མོ་དགྱེས་པའི་ཉམས་འགྱུར་བརྒྱས།",
    "མ་ལུས་བློ་ཡི་ཁོང་བར་སོང་བའི་རྡུལ།",
    "མ་འདྲེས་ཕྲ་ཞིབ་སྨྲ་བའི་གློག་གི་ལྕེ།",
    "ཟུར་ཙམ་ཟུར་ཕྱིན་ལྡོན་པར་མི་ནུས་མོད།",
    "ཐལ་འགྱུར་སྤོང་བ་གཟུགས་སུ་བཞེད་ན་ཡང་།",
    "འདོད་ན་ཀུན་སློང་མིང་གིས་གདགས་པར་རུང་།",
    "དངོས་སུ་དམིགས་ནའང་རང་གི་སྟོབས་ཀྱིས་མིན།",
    "ཁ་ན་མ་ཐོ་མི་མངའ་དམ་པ་ཁྱོད།",
    "ཁྱོད་ལ་ལྟོས་པའི་གདུལ་བྱའི་དཔུང་གཉེན་དུ།",
    "ཞུ་མཆིད་ནགས་ན་དགའ་བའི་བུ་མོ་ཀྱེ།",
    "ཆེན་པོར་གྱུར་ཀྱང་མཆོག་གི་སེམས་རིན་ཆེན།",
    "མཚོ་མོ་རྣམ་བཞིའི་དགུང་ན་ལྡིང་འཁོར་རྩེན།",
    "དོན་གྱི་ངེས་པས་ཚིག་གི་རླབས་སྤྲོ་ཞིང་།",
    "རྣམ་གནོན་ཁྱོད་ཀྱི་སྟོབས་སུ་འབར་གྱུར་ཅིག།",
    "གུར་གུམ་གཞོན་ནུའི་ལང་ཚོར་སྨིན་པའི་གཟུགས།",
    "གཉིས་མེད་གསུང་བའི་ལུང་གི་ཆུ་བོ་ཆེ།",
    "སྐད་ཅིག་འོད་ལ་འགྲན་པ་དེང་གི་དུས།",
    "དྲི་ཟའི་བུ་མོར་འགྲོགས་པས་དགེ་ལགས་གྲང་།",
    "གང་གི་ངོས་ན་ང་ནི་འདི་འདྲ་ཞེས།",
    "རྗེན་པར་སྟོན་ལ་ཤེས་བྱ་རང་རང་གི།",
    "གཏན་གྱི་འདུན་མར་མོས་བློས་སྐྱིད་པོར་བདོག།",
    "རོ་ལྡན་ཚིག་གི་ལམ་འདིར་དལ་གྱིས་ལྡེམ།",
    "རྣམ་འབྱེད་ཤེས་རབ་འོད་སྣང་འབུམ་ཕྲག་གིས།",
    "མཁས་མང་ཚོགས་པའི་དབུས་ན་མི་འཇིགས་པ།",
    "འཆར་བའི་སྒོ་མོ་རྒྱ་མཚོ་ལྟ་བུར་ཟབ།",
    "གྲོང་ཚོ་མི་ཁྱིམ་དུད་འགྲོའི་བརྩི་བགྲང་སོགས།",
    "མ་ནོར་གསལ་གཟིགས་སྟོན་པ་ཐམས་ཅད་མཁྱེན།",
    "ནམ་ཞིག་སྲོག་གི་འཚོ་བ་གོང་བུའི་མར།",
    "འདྲ་མིན་ཁྱད་པར་དམ་པའི་གཟིགས་མོར་ཆེ།",
    "མ་བསད་ན་ཡང་ངང་གིས་འཆིར་འགྱུར་དང་།",
    "སུས་ཀྱང་བཟློག་དཀའ་འདི་ཀོ་ཡི་རེ་མུག།",
    "ཀུན་ནས་ཉོན་མོངས་རྣམ་བྱང་རྒྱུ་འབྲས་ཟུང་།",
    "ཟབ་མོའི་དོན་བཟང་ལྷུག་པར་མཚོན་པ་དང་།",
    "སྐབས་དང་སྐབས་ལ་ཕྱག་གི་རི་མོ་དག།",
    "བྷ་གི་ར་ཐའི་རྒྱུན་བཞིན་ཆད་མེད་སྩོལ།",
    "ཡིད་ཀྱི་ཐིག་ལེ་གང་གི་མདུན་སར་འཕུར།",
    "ཟླ་བ་སྟོང་གི་ལང་ཚོ་འཛིན་པ་དེས།",
    "རེག་ཅིང་མཐོང་ཐོས་དྲན་པའི་སྐྱེ་བོ་ཡང་།",
    "སྐལ་མཉམ་རྒྱུ་ལས་འདུས་བཟང་གིས།",
    "མཚོ་དང་རྫིང་གི་རྡོ་ལེབ་བཞིན།",
    "ངག་གི་སྐལ་བ་ལྷུན་པོའི་ཟླ།",
    "དགོང་མོ་ཞིག་ལ་སྐུ་རྩེད་དུ་གནང་། ། མདང་འཁོས་མེད་ཀྱི་བྷུ་སུ་ཀུ་བདག་ལ་གཟུགས་མེད་པའི་སྐད་ཅིག་གིས།",
    "དེ་ནས་གཉིད་མ་སད་དུ་སོང་བ་ན་སྔགས་པ་སྐྲ་རོལ་ཆེ་བ་ཞིག་ན་རེ།"
  ]
}