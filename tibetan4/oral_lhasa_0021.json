    "སྦྲན་པ་ལམ་འོངས་པ་བཟོད་པར་མཛད་པར་ཞུ་གསུངས་སོ།",
    "པཎ་ཆེན་འདི་ཉིད་དགྲ་བཅོམ་པར་གྲགས་པ་ལ་ཤིན་ཏུ་མི་དགོས་པའི་རྒྱ་གར་བཙུན་མ་ཁྲིད་བྱུང་།",
    "ཡུན་རིང་པོར་བཞུགས་སོ།",
    "ཁྱེད་ཀྱི་ལྷུང་བཟེད་ནས་ཟས་ཀྱི་ལྡག་ལྡོག་ལྷུང་བའི་ལས་སྒྲིབ་གྱིས་ཉེས་པར་བྱས།",
    "རྡོ་རྗེ་རྣམ་འཇོམས་དང་གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མའི་ཁྲུས་ཆོག་མཛད་དོ།",
    "ཡང་ཐང་པོ་ཆེར་གཉལ་པ་གཙང་ནག་པ་བྱ་བས།",
    "ཇོ་བོ་རྗེའི་ལུང་གཅིག་དྲངས་པ་ལ་ལོ་ཙཱ་བས་ཁ་བརྙས་གཅིག་བྱས།",
    "དེའི་ནང་པར་ནས་སྐད་འགགས་ཏེ།",
    "བཤགས་པ་མ་བྱས་ན་ཛི་བྷཾ་བྷཾ་ཀ་འབྲས་བྱ་བ་འོང་བ་ཡིན་ཏེ།",
    "དེ་བྱུང་ན་ལོ་ཙཱ་བ་དིག་པ་དང་ཁྱད་མེད་དུ་འགྱུར་བ་ཡིན་གསུངས་སོ།",
    "མགོན་པོའི་མདུན་བཞུགས་དྲི་མེད་བདག་དགོངས་གསོལ།",
    "དེ་བས་མཁྱེན་བརྩེ་མཐུ་ཆེན་ཐབས་མངའ་བ།",
    "དེ་བཤགས་ཡན་ལག་བདུན་ལྡན་ཉིན་མཚན་དུ།",
    "གནོང་འགྱོད་འཇིགས་དྲན་མཐོལ་བགྱིས་སོ་སོར་བཤགས།",
    "མཁྱེན་བརྩེའི་རྩིབས་རྣོ་ཏིང་འཛིན་ལྟེ་བ་བརྟན།",
    "མི་གཡོ་མི་ཟད་མི་འགྱུར་སྒྲིབ་མེད་པར།",
    "གསལ་བསིལ་དགོས་འབྱུང་མྱ་ངན་མི་འདའ་བཞུགས།",
    "མཐུན་འབྲས་དགའ་ལྡན་ཞབས་དྲུང་སྨིན་པར་མཛ་ད།",
    "སྣོད་བརྟགས་པས་ཤིན་ཏུ་ཡང་མཉེས་པར་གྱུར་ཏོ།",
    "ལྷོ་བྲག་དབུ་རུ་གཡོ་རུ་ལ་སོགས་པར་བསྐྱར་ནས་བྱོན།",
    "ཕྱིས་གཙང་དུ་བྱོན་ནས་ཀྱང་ལྷོ་འབྲི་མཚམས་དང་གྲོམ་པ་ས་སྐྱ་ལ་སོགས་པ་དང་།",
    "ཁབ་སྐུད་ཀྱི་བར་དུ་བསམ་གྱིས་མི་ཁྱབ་ཅིང་འཇིགས་སུ་རུང་བ་གནང་སྟེ།",
    "སྐབས་གཅིག་ཏུ་ལྷའི་བྱ་བ་རྒྱ་ཆེ་བས་སྒྲུབ་པར་དཀའ་བ་དང་།",
    "བྱམས་ཆེན་གྱི་བཟོ་མྱུར་དུ་བྱས་ན་ཚར་ནས་འོང་སྟེ།",
    "ད་ནི་རྗེ་བཙུན་སྒྲོལ་མའི་སྐུ་ཅིག་བཞེངས་སོ་ཞེས་ཀྱང་གསུངས།",
    "བཤེས་གཉེན་ལ་ལས་ཀྱང་རྗེ་བཙུན་སྒྲོལ་མ་བཞེངས་ན་ངེད་ཀྱིས་འདི་དང་འདི་ལྟར་བྱའོ་ཞེས་གྲོ་ག་བསྐུར་བ་ལ་སོགས་པ་བྱས་པ་ན།",
    "ཇ་སྐོལ་གྲོ་དྲངས་བྱས་པས།",
    "ཁྱད་པར་དུ་སཾསྐྲི་ཏའི་སྐད་ཀྱིས་ལས་ཆོག་བྱ་དགོས་པས་ཤིན་ཏུ་བག་ཚ་བར་ཡོད་དེ།",
    "སེམས་ནི་ངའི་བསོད་སྙོམས་ཕུལ་བ་ལ་མི་ལེགས་བྱེད་བཟང་པོ་མ་ཡིན་གསུངས།",
    "སྐྱིལ་ཀྲུང་ལ་ཞབས་གཉིས་བསྣོལ་མཚམས་བག་ཙམ་ཅིག་མ་འགྲིག་པར་བྱུང་བས་ཞབས་གཡོན་པའི་ངར་གདོང་པ་ལ་ཨེན་ཙམ་གཅིག་བརྐོས་པས་སྐུ་འོ་བརྒྱལ་བ་འདྲ་ཡང་འགྲིག་པར་བྱུང་ངོ།",
    "མགྲོན་ལྟར་ཕྱག་མཇལ་ནས་རག་དུང་ཕྱག་རྟེན་བྱས་པས་ལེན་དུ་མ་བཞེད་དེ་མི་ལེགས་ཡང་ཡང་གསུངས།",
    "སློབ་དབོན་ཐོགས་མེད་ཀྱི་ཞབས་རྗེས་ལོ་གྲངས་བྱས་ནས་སྤེལ།",
    "དགྲ་བཅོམ་པ་ཡིན་ནམ་མ་ཡིན་གཏན་ལ་འབེབས་པའི་བརྟག་སྤྱད་མང་དུ་བྱར་ཡོད་པ་ལེགས་པར་བྱས་ནས།",
    "དེ་ཉིད་དུ་དབྱར་ཟླ་བ་གསུམ་ཚུལ་དུ་བཞུགས་སོ།",
    "འབྲས་བུ་དཔག་ཏུ་མེད་པར་འགྱུར་རོ།",
    "འཁོར་རང་བཅས་པ་ལ་བསྙེན་བསྐུར་རྣམ་པ་དུ་མ་བྱས་ནས་སྤྱན་འདྲེན་དུ་འོང་བས།",
    "དེའི་སྐུ་གསུང་ཐུགས་བྱིན་གྱིས་རླབས་པ་ཞག་བཅུ་གསུམ་གྱི་བར་དུ་བྱེད་པར་འགྱུར་ཞིང་།",
    "དེའི་དང་པོ་མེ་ཏོག་གཅིག་དབུ་ལ་ཞོག་ཅིག་གསུངས་སོ།",
    "ཞེས་གསུངས་སོ།",
    "ཐེམ་སྐས་དེ་ཉིད་ཀྱི་སྟེང་དུ་སྔར་གྱི་གསུང་གླེང་རྒྱས་པར་མཛད་དེ་ཕན་ཚུན་གཉིས་ཀ་གཤེགས་བཞུད་མཛད་དོ།",
    "དགེ་སློང་རྡོ་རྗེ་འཕན་དང་བཅས་པ་རྣམ་གསུམ་ལ་རྒྱས་པར་གདམས་ངག་དང་བཅས་པ་གསུངས་ཤིང་གནང་།",
    "དང་བཅས་པ་ལོ་ཙཱ་བ་ལ་གནང་ནས།",
    "དུང་ཆུང་གཡས་སུ་འཁྱིལ་བ་གསུམ་གྱིས་བརྒྱན་ཏེ་མཆོད་བསྟོད་གཟུངས་སྔགས་དང་བཅས་པས་ཐུགས་དམ་མང་དུ་མཛད་ནས་བྱམས་ཆེན་གྱི་ཐུགས་ཀར་བཞུགས།",
    "རིང་བསྲེལ་གཅིག་ལོ་ཙཱ་བའི་སྲུང་བའི་རྟེན་གྱིས་གསུངས་ནས།",
    "དགྲ་བཅོམ་པས་བསྐུར་བའི་མེ་ཏོག་དང་རིང་བསྲེལ་ལྷན་ཅིག་སྦྲགས་ནས་དུས་དེ་ཉིད་དུ་གནང་།",
    "དེ་ནས་དགྲ་བཅོམ་པས་སྔར་བསྐུར་བའི་མེ་ཏོག་དཀར་པོ་དེ་བྱམས་ཆེན་གྱི་དབུ་ལ་བཞག་དེ་ཉིད་ཀྱི་ནང་པར་ཆུ་ཕོ་སྤྲེའུའི་ལོ་བྲེའི་ཟླ་བའི་ཚ་ས་བཅུ་གསུམ་ལ་རབ་གནས་ཆེན་པོ་མཛད་དོ།",
    "ཁྱད་པར་དུ་ཡང་སུ་འཇེབས་འཇེབས་ཀྱིས་བཞུགས་པའི་ཞུ་འབུལ་མང་པོ་བྱས་ཀྱང་།",
    "ཀསྨི་ར་དོན་ཆེན་པོ་གསུངས་ནས་ཡེ་མ་གསན།",
    "ནན་ཏན་ཆེན་པོས་ཤོལ་བཏབ་ཀྱང་མ་བཞེད་དེ་བར་ཆད་མེད་ཅེས་གསུངས།",
    "སྣམ་བུ་ཁུར་དུ་ལོངས་པ་གནང་བ་ཡང་མང་དུ་ཡོང་།",
    "དར་ཆེན་གྱི་ཁ་ཚ་ན་སྣ་ལྟབ་བྱས་པར་སྟབས་གཅིག་གསེར་རྣམས་སིལ་མར་བླུགས་ཏེ།",
    "པས་དོན་ཆེ་བར་བྱས།",
    "གསེར་སོགས་ཐུག་མེད་གནང་ཟིན་པས་ཐུགས་ལ་བསམ་གྱིས་མི་ཁྱབ་པ་བཏགས་ཟིན།",
