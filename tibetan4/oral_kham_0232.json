    "སེམས་ཀྱི་ཀུན་རྫོབ་པའི་ངོ་བོར་བཞག་པའི་གསལ་རིག་ཁོ་རང་བདེན་པས་སྟོང་པ་ཞིག་ཡིན་པས་སོ།",
    "ལང་ལང་ལིང་ལིང་དེ་ཡོད་སྐད་མི་འདུག།",
    "འོ་ན་ཇི་ལྟར་ཡིན་ན་དཔེའི་སྐབས་སུ་འཕྲེང་དམག་ཁོ་རང་གཉིས་བརྫུན་པར་གསུངས་པ་ལྟར་སེམས་རང་བརྫུན་པར་རྟོགས་དགོས།",
    "དེ་གཉིས་ཐམས་ཅད་ལྟོས་མེད་དེ་ལྟར་རམ་ཡང་ན་གཞན་ལ་ལྟོས་ནས་གྲུབ་པ་ཁོ་ན་སྟེབུམ་སོགས་རྣམས་རང་རང་།",
    "གཟུགས་བརྙན་མེད་པར་མི་འགྲོ་བ་ཅིག་འཇོག་ཤེས་ན་སྔོན་པོ་ལ་ཡང་རང་མཚན་གྱིས་གྲུབ་པར་སྣང་བའི་ཆ་ཐམས་ཅད་ནས་སྣང་བ་ལྟར་གྱི་དོན་དུ་མེད་ཀྱང་།",
    "དེ་ཡང་རང་ཅག་ལ་ཡོད་པར་ཡིད་ཆེས་ནས།",
    "དེའི་སྐབས་སུ་ཡང་རང་ཉིད་གང་དུ་འདུག་པའི་གནས་གཞལ་མེད་ཁང་དང་།",
    "ད་ལྟ་འདི་ལྟར་ཡིན་བྱ་རྒྱུ་ཡང་མེད་པས་རང་བཞིན་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བ་ཡིན་པར་འདུག།",
    "འགྲོ་འཆག་ཉལ་འདུག་ཅི་བྱེད་ཀྱང་མ་བཅོས་པར་བཟོ་མེད་དུ་བཞག་པས།",
    "ཡང་སྐྱེ་བོ་མང་པོའི་དབུས་སུ་འདུག་ལ།",
    "དེ་ཡང་རང་ཉིད་ལྷ་སྐུར་གསལ་བ་དེ།",
    "སྣང་བ་འདི་རྨི་ལམ་གྱི་སྣང་བ་ཡིན་འདུག།",
    "ད་ནང་ཕན་ཆད་རྨི་ལམ་ལ་རྨི་ལམ་དུ་ངོ་མ་ཤེས་འདུག་སྙམ་པའི་འདུན་པ་རྒྱུན་མི་འཆད་དུ་བཏང་ངོ།",
    "ཉིན་ཕྱེད་ཡན་ལག་མདང་རྨི་ལམ་ལ་རྨི་ལམ་དུ་ངོ་མ་ཤེས་འདུག།",
    "ཉི་ཕྱེད་ཡན་དུ་སྣང་བ་འདི་རྨི་ལམ་རང་ཡིན་འདུག་སྙམ་པའི་འདུན་པ་བཏང་།",
    "ཉིན་ཕྱེད་མན་དུ་སྣང་བ་འདི་རྨི་ལམ་གྱི་སྣང་བ་ཡིན་པ་འདུག།",
    "བདེན་པར་གྲུབ་པ་ཅུང་ཟད་ཀྱང་མི་འདུག་སྙམ་དུ་བསམ་ལ།",
    "དེ་ཉིད་ཉམས་བདེ་ཁྲིལ་ལེ་འདུག་པ་ལ་སེམས་རྩེ་གཅིག་ཏུ་བསྟད་ཅིང་།",
    "དེ་རྣམས་འོད་དུ་ལྟེམ་ལྟེམ་འདུག་པ་ལ་སེམས་བསྟད་དོ།",
    "དེ་རྣམས་འོད་དུ་ལྟེམ་ལྟེམ་འདུག་པ་ལ་སེམས་བསྟད་ཅིང་།",
    "དེ་ཉིད་འོད་དུ་ལྡེམ་ལྡེམ་འདུག་པ་ལ་སེམས་བསྟད་ཅིང་།",
    "སྣོད་བཅུད་ཐམས་ཅད་སྨིག་རྒྱུ་ལྟར་མེར་མེར་ཤིག་ཤིག་ཏུ་འདུག་པར་བསམ།",
    "ཡང་རང་ཉིད་ལྷ་སྐུར་སྒོམ་ཞིང་།",
    "རང་རང་སོ་སོ་ཡི་དམ་དུ་གསལ་བའི་སྐུ་ལུས་ལ་ཐིམ།",
    "ལུས་སྒུར་ཏེ་འདུག་པའམ།",
    "དེ་ནས་ཡང་ཞག་འགའ་ལུས་སྟོང་སང་ངེ་བ་འདུག་པར་བསམ་པ་དང་།",
    "འཕོངས་སྟེགས་སྐུམ་ཁྲུ་གང་ཙམ་གྱི་སྟེང་དུ་འཕོངས་བཞག་ལ་སྟེགས་ཀྱིས་འདུག།",
    "བྱི་ལའི་འདུག་སྟངས་ནི།",
    "རིགས་དྲུག་རྣམས་རང་རང་སོ་སོའི་བསམ་པ་དང་མཐུན་པའི་ལོངས་སྦྱོད་བྱུང་སྟེ་ཚིམས་པར་བསམ།",
    "ཡང་རང་ཉིད་ཀྱི་སྤྱི་བོའི་སྟེང་ནས་ནམ་མཁའ་དེའི་ཡང་སྟེང་ན་རྒྱལ་ཆེན་རིགས་བཞི།",
    "འགྲོ་འཆག་ཉལ་འདུག་སོགས་ཐུན་མཚམས་རྣམས་སུ་ཡང་དྲན་པའི་རྟེན་དངོས་པོ་ཇི་ལྟར་རིགས་པ་ཞིག་བཞག་ལ།",
    "བོ་རོ་ཙ་ན་ནས་ལོ་ཆེན་རིན་ཆེན་བཟང་པོའི་སྐབས།",
    "བྱེར་བསྡུ་ཞིང་རང་གནས་འཇོམས།",
    "ཕྱེ་མ་ཁྲག་དུས་གླང་ཆེན་དགུ་པའམ་བཅུ་གསུམ།",
    "རྒྱུ་ཤལ་བཤལ་རྩ་དམར་སྐྱུག་དུས་གུར་གུམ་དང་།",
    "ཁྲག་རུལ་དུད་ཁུ་སྐྱུག་དུས་སེ་འབྲུ་དང་།",
    "ཅོང་ཞི་ཞིབ་བཏགས་ཐོ་རང་རངས་སེང་སིངས་པོས་ཕུལ།",
    "ཞིག་དུས་འཕྲལ་དུ་ཚ་ལའི་འཕྲུལ་བཤལ་གཏོང་།",
    "ཚད་རྟགས་འདུག་ན་གློ་ཚད་ཀུན་སེལ་ལོ།",
    "ག་དུར་ཚབ་ལུག་མུར་གཏོང་བའི་ཕྱག་ལེན་འདུག།",
    "རང་རང་འདུ་བའི་ཁ་འཛིན་དཔུང་དང་བཅས།",
    "རང་རང་ཁ་བསྒྱུར་བསྣོན་པ་མཆོག་ཏུ་བསྔགས།",
    "ཚ་གྲངས་རང་རང་སྐབས་ཐོབ་ལྟག་པ་སྤྲད།",
    "སྨྲ་བ་སྤང་ལ་དལ་འདུག་སྐོམ་པ་སེལ།",
    "བཅོས་ཐབས་རང་རང་འདུ་བ་སྤྱི་དང་བསྟུན།",
    "ཁྱད་ཐོན་འདུག་པས་འདི་ཉིད་བསྟན་པ་བསྔགས།",
    "རང་རང་སྐབས་ཐོབ་བརྩིས་པའི་རིག་པས་དཔྱད།",
    "ཞེས་པ་སྟོང་བཟླས་ཐོ་རང་རངས་དུས་ལ་བཏབ།",
    "ཕོ་ལོང་སྦོ་འཁྲོག་རང་རང་སྟེང་དུ་སྐྱོངས།",
    "རྒྱུ་རྐྱེན་བསྟན་སྟན་སྲབ་ཙོག་པུར་འདུག་པ་དང་།",
    "གཞན་བསྟན་བཞོན་བསྟེན་རླན་སྟེང་ཡུན་རིང་འདུག་ལས་འབྱུང་།",
    "རང་རང་ཁ་འཛིན་མེ་གཟའ་ག་པུར་དང་།",
    "རང་རང་ངོ་བོ་མཉམ་པ་ཡི།",
    "སྔོགས་བཏབ་ཙམ་གྱིས་འཚོ་བ་འདུག་ཅེས་ཐོས།",
    "དུག་རིགས་རང་རང་ཁ་དོག་དངོས་སུ་འཁྲུ།",
    "སྲོད་དང་ཐོ་རང་རངས་ལྟག་སྤྲད་བྱེར་བ་སྡུད།",
    "གཞི་འཛིན་གང་རུང་ཐོ་རང་རངས་ཆུ་བསྐོལ་དབུལ།",
    "སྔགས་པ་དང་རང་གཞན་གཉིས་ཀས་ཤ་ཆང་སྒོག་ཙོང་སྤུངས།",
    "དེང་ནས་ཀུན་བཟང་རང་༣༥ཞལ་མ་མཐོང་བར།",
    "རང་རང་དགེ་འབྲས་སྤྱོད་པས་འཚོ་གྱུར་ཅིག།",
    "ཟླ་མེད་རང་རང་འཁོར་ཚོགས་རྒྱ་མཚོར་བཅས།",
    "འབུམ་ཕྲག་དུས་གཅིག་བརྡུངས་པའི་དབྱངས་སྙན་གྱིས།",
    "བདེ་བའི་སྟན་ལ་འདུག་ཏེ་སྐྱབས་ཡུལ་གསལ་བཏབ་༢ལ་ཐོག་མར་སྐྱབས་སུ་འགྲོ་བ་ནི།",
    "མཆོད་གཏོར་བཤམས་ལ་རང་ཉིད་བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "མ་འདུག་རང་རང་གནས་སུ་དེངས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཚེ་བརྐུས་པ་དང་།",
    "སྒྲུབ་པ་པོ་རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ་ཐོག་མར་བརྒྱུད་འདེབས་བྱ་བ་ནི།",
    "ཕྱོགས་ལ་པདྨའི་འདུག་སྟངས་ཀྱིས།",
