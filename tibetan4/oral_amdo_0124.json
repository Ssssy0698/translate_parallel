    "ལྷག་ཕྱེན་ཡང་སླར་མ་བྱིན་ཅིག་དགེ་སློང་གིས་རང་གི་སྟོད་གཡོགས་དང་སྨད་གཡོགས་ལྷག་པར་གྱུར་པ་སླར་་པེ་མ་བྱིན་ནམ།",
    "གོས་ཀྱི་རིན་ཁྱིམ་བདག་གིས་སྔར་གཟས་པ་ལས་ལྷག་པར་བབེེངས་པའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་གཞུགས་ཞུསོ།",
    "དེའི་ཚེ་ཁྱེམ་བདག་ཁྱོ་ཤུག་གཉིས་ཡོད་དེ།",
    "དེ་ཡང་སོ་སོར་འཕྱོ་ཞིང་བྲན་མོ་ལ་བརྡེག་པ་དང་།",
    "བྲན་མོ་དེས་ཐོས་ནས་བྲན་མོ་ནང་གཅིག་བསྙེན་དགའ་བོ་དེར་འོངས་པ་ལ་ཁོའི་དྲིན་སླར་གླན་པའི་ཕྱིར་བསྙེན་དགའ་བོ་ལ་ཟོང་སྤགས་པ་སྦྲན་ཏོ།",
    "ཁྱེད་ཀྱིས་ང་ལ་སྦྱིན་པར་གཟས་པ་དེ་ང་ལ་བྱིན་ཅིག་ཅེས་སྨྲས་ན་འཕྲལ་དུ་མ་འབྱོར་པ་དང་ཚོང་པ་ཕྱུག་པོ་གཅིག་ལ་ཁྱེམ་བདག་སྐྱིར་སོང་བ་དང་།",
    "དེའི་མཛའ་བོ་དག་གིས་མཐོང་ནས།་",
    "ཁྱོད་མར་འཐུངས་སམ།",
    "བདག་གིས་ནི་མར་ཡང་མ་འཐུངས་ཏེ་བུ་ལོན་ཀྱི་ཕྱིར་བཟུང་ངོ།",
    "ཁྱོད་ཉིད་ཀྱི་ཚེའམ་ཕ་མེས་ཀྱི་ཚེ་ཆགས།",
    "གང་ཡང་མ་ཡིན་ཏེ་ཤཱཀྱའི་བུ་དག་གིས་ཏེ་གང་བྱེན་པ་དེ་ནི་མི་ལེན་ཏེ་ལྷག་པར་སློང་ངོ།",
    "དེ་ལྟར་གྱུར་པ་ལ་སྙན་དུ་བདས་ནས་དགེ་སློང་ཞུགི་ཚུལ་མ་ཡིན་ཞེས་སྨད་དེ།",
    "ཁྱེམ་བདག་ཅེས་བྱ་བ་ནི་སྐྱེས་པ་དང་བུད་མེད་དོ།",
    "བདག་གི་གོས་ཀྱི་རིན་དེས་དེ་ལྟར་ན་འདི་འདྲའི་གོས་གྱིས་ཤིག་ཅེས་བྱ་བ་ནི་བལ་ལས་བྱས་པ་དང་།",
    "དགེ་སློང་གིས་སྔར་མ་སྦྲན་པར་རྣམ་པར་རྟོག་པ་སྐྱེད་ཤཱད་ནས་ཕྲིན་དང་།",
    "ཁྱེམ་བདག་ལ་རྔ་མོའི་བལ་དང་།",
    "དེའི་ཚེ་ཁྱིམ་བདག་ཁྱོ་ཤུག་གཉིས་ཤིག་ཡོད་དེ།",
    "ཁྱད་པར་ནི་ཁྱེམ་བདག་དང་ཁྱིམ་བདག་གི་ཆུང་མས་དགེ་སློང་ལ་གོས་ཀྱི་རིན་སོ་སོར་བཞག་པ་ཙམ་ཞིག་ཡོད་དོ།",
    "སོ་སོར་ཞེས་བྱ་བ་ནི་ཁྱིམ་བདག་ཀྱང་བདག་རང་གི་ནོར་ཡིན་པ་དང་།",
    "ཆུང་མ་ཡང་༨་རང་གི་ནོར་གུད་པ་ཡིན་པ་ལས་དེ་གཉིས་གཅིག་ཏུ་བསྡུས་ནས་དགེ་སློང་ལ་བྱིན་པ་ནི་སོ་སོ་ནས་ཞེས་བྱ་བའོཧཱུཾ།",
    "བྲམ་ཟེ་དབྱར་བྱེད་ཀྱིས་གོས་ཀྱི་རིན་ཚོང་པ་ཞིག་ལ་ཕྱི་བཞིན་དུ་ཡོད་པར་བསྐུར་བ་ལས་མཉན་དུ་ཡོད་པར་བསྙེན་དགའ་བོས་ཟོང་ཚོང་བའི་གན་དུ་སོང་སྟེ།",
    "ཟོང་ཚོང་བ་ཞིག་གི་ལག་ཏུ་བཞག་གོ།",
    "སྤོས་འཚོང་གི་མས་དེ་ལྟར་ཆད་པ་ཀཱར་ཥཱ་པ་ཎ་ལྔ་བརྒྱ་བཅད་པ་དེ་སུས་ལེན་ཚོ་ཞེས་སྨྲས་པ་དང་།",
    "ཤཱཀྱའི་དགེ་སྤྱོང་ཚོརྟེདག་ལ་དགའ་བས་དེ་ལྟར་གྱུར་ཏོ་ཞེས་འཛེར་བ་དགེ་སློང་དག་གིས་ཐོས་ཏེ་སྙན་དུ་གསོལ་ཏོ།",
    "དགེ་སློང་གི་ཕྱིར་ཞེས་བྱ་བ་ནི།",
    "ཕོ་ཉའི་ལག་ཏུ་ཞེས་བྱ་བ་ནི་བུད་མེད་དམ་སྐྱེས་པ་འམ་མ་ནིང་ལའོ།",
    "དགེ་སློང་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "དགེ་སློང་ལ་འཕགས་པ་རྒྱལ་པོ་དང་བྲམ་ཟེ་ལ་སོགས་པ་མིང་འདི་ཞེས་བགྱེ་བས་ཁྱོད་ལ་གོས་ཀྱི་རིན་འདི་བསྐུར་གྱིས་འཕགས་པ་ཐུགས་བརྩེ་བའི་བེེད་དུ་འདི་དག་བཞེས་སུ་གསོལ་ཞེས་དེ་སྐད་ཟེར་བ་དང་།",
    "གལ་ཏེ་ཕོ་ཉ་དེས་དགེ་སློང་དེ་ལ་འཕགས་པ་རྣམས་ཀྱི་ཞལ་ཏ་བགྱིད་པ་འགའ་མཆིས་སམ་ཞེས་དེ་སྐད་ཟེར་བ་དང་གོས་འདོད་པའི་དགེ་སློང་གིས་༥ཞལ་ཏ་བྱེད་པ་སྟོན་ཅིག།",
    "ཚེ་དང་ལྡན་པ་ཕོ་ཉ་འདི་ནི་དགེ་སློང་གི་ཞལ་ཏ་བྱེད་པའོ།",
    "དེ་ནས་ཕོ་ཉས་གོས་ཀྱི་རིན་ཁྱེར་ལ་ཞལ་ཏ་པའི་དེར་སོང་སྟེ་ཕྱིན་ནས་ཞལ་ཏ་པ་ལ་ཚེ་དང་ལྡན་པ་ཞལ་ཏ་པ་ཤེས་པར་གྱིས་ཤིག།",
    "དེ་ནས་ཕོ་ཉས་འཕགས་པ་ཞལ་ཏ་བ་བདག་ལ་བསྟན་པ་ལ་ཀྱེགོས་བདག་གིས་ཕུལ་ཅིག་པར་གཏད་པ་མེལགས་ཀྱིས་དེར་ལོང་ཞེས་བསྒོ་ཤིག།",
    "དེ་ནས་དགེ་སློང་གིས་ཞལ་ཏ་བྱེད་པའི་གན་དུ་སོང་སྟེ།",
    "ཚེ་དང་ལྡན་པ་བདག་གིས་གོས་དགོས་སོ་ཞེས་ལན་གཉིས་ལན་གསུམ་སྐུལ་ཅིག།",
    "བསྐུལ་བའི་སྒོ་དྲུག་ནི་ཁྱོད་བྱོན་ཏམ་ཞེ་ན།",
    "ཕྲིན་དང་ཕྲིན་ཡིག་གིས་ལན་ལྔ་དྲུག་ལས་ལྷག་པར་བརྩལ་ཏེ་གོས་གྲུབ་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།་།",
    "དགེ་སློང་གིས་ཁྱེམ་པ་སྨྱོན་པ་དང་།",
    "ཕྱིས་མུ་སྟེགས་ཅན་རྣམས་དགེ་སྦྱོང་མགོ་རེག་དེ་ལ་བསོད་སྙོམས་སྦྱིན་པར་སུ་སྤྲོ་ཞེས་མི་སྙན་པར་འཛེར་བ་དགེ་སློང་དག་གིས་སྙན་དུ་གསོལ་ནས།",
    "ཆུང་ངུ་ནི་ཁྲུ་ཕྱེད་དང་གསུམ་མོ།་།",
    "ས་ནག་གི་ནང་དུ་བཙོས་པ་དང་།",
    "ཕྲིན་དང་ཕྲིན་ཡིག་གིས་བྱེད་དུ་བཅུག་པ་ནི་རིམ་པ་གོང་མ་བཞིན་དུ་སྦྱར་རོ།",
    "དེ་དག་གིས་བཟང་པོ་འདོད་པའི་ཕྱིར་དཀར་པོ་ཅུང་ཟད་མཚན་མ་ཙམ་ཞིག་བསྲེས་ཤིང་བྱེད་པས་དོན་ཉུང་བའི་དགེ་སློང་རྣམས་འཕྱ་སྟེ།",
    "བྱེད་ཅེས་བྱ་བ་ནི་བདག་གིས་བྱས་པའམ་གཞན་ཀྱིས་བྱས་པའོ།",
    "དེ་ལ་ཉེས་པ་ནི་དགེ་སློང་གིས་བལ་སྲང་བཅུ་ལས་སྟན་གཅིག་ཏྲོབྱེད་ན་དེ་ལ་ལུག་བལ་ནག་པོ་འབའ་ཞིག་ལས་སྲང་ལྔ་ཆུག་ཤིག།",
    "གལ་ཏེ་དགེ་སློང་གིས་ཕྱེད་ལུག་བལ་ནག་པོ་ལས་མ་བཅུག་གམ།",
    "སྟན་རྙིང་པ་དགེ་སློང་གིས་ལོ་དྲུག་གི་བར་དུ་ཆོངས་ཤིག།",
    "མི་འདོད་བཞིན་དུ་ཞེས་ཕྱེབྱ་བ་ནི་མ་དད་པར་ལོ་དྲུག་གི་བར་དུ་ཆོངས་ཤིག་པའོ།",
    "དགེ་སློང་གིས་ལོ་གང་ལ་སྟན་བྱས་ནས་དེ་ཉིད་ཀྱི་ལོ་ལ་སྟན་ཕྱི་མ་གཉིས་པ་བྱེད་ན་ཉེས་བྱས་སོ།",
    "གདིང་བ་སར་པ་ལ་རྙིང་པ་མཐོ་གང་གིས་གླན་པའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "དགེ་སློང་དག་ཉིན་པར་བསམ་གཏན་བྱེད་པའི་གནས་ན་ཆོ་དགེ་སློང་དག་ཉིན་པར་སྟན་ལ་ཧུ་སྐྱིལ་མོ་ཀྲུང་བཅས་ཏེ་འདུག་འདུག་པས།",
    "དགེ་སློང་དག་གིས་སྟན་རྙིང་པ་རྣམས་བླ་གབ་མེད་པར་ཕྱི་རོལ་དུ་བོར་ཏེ།",
    "བདག་ཅག་ནི་ཁྲོན་པའི་སྦལ་བ་དང་འདྲ་སྟེ་གར་ཡང་མི་འོང་བས་རྙེད་པ་ཡང་ཉུང་ན་དེརྙེད་པ་སྒྲུབ་ཅིང་འཕགས་པ་འཆར་བ་པོ་ནི་གཞི་ན་གཙུག་ཁང་སྲུང་དུ་བཞག་ལ་བདག་ཅག་ལྔ་ཧཱུཾནི་བལ་ཡུལ་དུ་རྙེད་པ་སྒྲུབ་ཏུ་འདོང་ངོ་ཞེས་ནས་ཚོང་པ་དག་༩ཡུལ་དུ་འགྲོ་བ་དང་ལྷན་ཅིག་ཏུ་བལ་ཡུལ་དུ་སོང་སྟེ།",
    "བཞིས་ནི་བལ་ཁུར་རེ་རེ་ཁྱེར།",
    "གཅིག་གིས་ནི་བཞི་པོའི་ཡོ་བྱད་རྣམས་ཁུར་ཁྱེར་ཏེ།",
    "རི་བྲགས་ཀྱི་དགེ་སློང་དང་གྲོང་མི་དག་གིས་མཐོང་ནས།",
    "བལ་ལང་གིས་དམག་འོང་ངོ་རི་བྲགས་ཀྱི་གྲོང་མི་རྣམས་འབྲོས་པ་དང་།",
    "བཙུན་པ་མད་དོ་ཞེས་གསོལ་ནས་དགེ་སྤྱོང་གི་བྱ་བ་མ་ཡིན་དགོས་པ་དང་མཐུན་པ་དང་རིགས་པ་མ་ཡིན་ཞེས་སྨད་ནས།",
    "སྐྱེ་བོ་མང་པོ་འགྲོ་བའི་ལམ་མོ།",
    "ལུག་གི་བལ་ཞེས་བྱ་བ་ནི་སྤུའོ།",
    "བླངས་ནས་དཔག་ཚད་གསུམ་ཀྱི་བར་དུ་རང་གིས་ཁྱེར་ཅིག་ཅེས་བྱ་བ་ནི་དཔག་ཚད་གསུམ་ལས་མི་འདའ་བར་བྱ་བའོཕྱེ།",
    "དེ་ལས་འདས་པར་ཞེས་བྱ་བ་ནི་ཐལ་བའོ།",
    "རྒྱང་གྲགས་ཕྱེད་དམ་གྲོང་གཅིག་ནས་གཅིག་ཐུཏུ་བྱུང་ན་ཉེས་བྱས་རེ་རེར་འགྱུར་རོ།",
    "བདག་ལ་བལ་ཉུང་ཞིག་མཆིས་ན་སྐྱེ་དགུའི་བདག་མོ་ལ་བཅོལ་ལོ་ཞེས་བྱས་པ་དང་།",
    "དེ་ནས་སྐྱེ་དགུའི་བདག་མོ་ཡང་བལ་མང་པོ་དེ་མཐོང་ནས་བལ་མང་མོད་ཀྱི་སྐྱེས་བུ་དམ་པ་རྣམས་ནི་ཁས་བླངས་པ་རྣམས་ལ་ལྕོགས་པར་བྱ་དགོས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གཟིགས་ནས་བཀས་རྨས་པ་ཇི་རྒྱ་ལྟར་གྱུར།",
    "ལུག་གི་བལ་ཞེས་བྱ་བ་ནི་སྤུའོ།",
    "འདབ་མ་གཅིག་ཙམ་མོ།",
    "ཁྱིམ་མི་མོ་ལ་བཅོལ་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "མི་རུང་བ་དང་འདྲེས་པ་ནི་རྔ་མོའི་བལ་དང་།",
    "ཁྱིམ་པ་མོ་དང་།",
    "ལ་ལ་ན་རེ་ཤཱཀྱའི་དགེ་སྤྱོང་དག་ལ་གསེར་རུང་ངོ་ཞེས་ཟེར་རོ།",
    "ལ་ལ་ནི་མི་རུང་ངོ་ཞེས་ཟེར་རོལ་ལ་ན་རེ་གསེར་དངུལ་སུ་ལ་རུང་བ་དེ་ལ་ནི་འདོད་པའི་ཡོན་ཏན་ལྔ་དང་ཤིང་རྟ་ལ་སོགས་པ་ཡང་རུང་ངོ།",
    "ཤིང་རྟ་ལ་སོགས་པ་རཱི་ཡོན་བདག་གིས་ཕུལ་བ་ནི་ལེན་དུ་རུང་ངོ་ཞེས་གནང་བ་དང་།",
    "རོ་ཉེ་དང་ཚོན་མོ་སྟེང་ལ་རེག་ན་ཉེས་པ་མེད་དོ།",
    "དགེ་སློང་གིས་སྙན་དུ་གསོལ་ཏེ།",
    "ཁྱེམ་བདག་དད་པས་བྱིན་ན་དགེ་སློང་དག་གིས་ལེན་དུ་རུང་བར་ཐུགས་རྗེས་དགོངས་ཏེ།",
    "ལོང་ཤིག་བླངས་ནས་སྦྱིན་བདག་གིས་བསྔོས་ཏེ་ཚོངས་ཤིག་ཡང་ན་ཀུན་དགའ་ར་བ་པའམ།",
    "ཡོན་བདག་ཤིའམ་ཡོན་བདག་མེད་ན་གསེར་དངུལ་དགེ་སློང་གཅིག་གི་རྗོམདུན་དུ་ཞོག་ལ་དངོས་པོ་རུང་བ་མ་ཡིན་པ་འདི་བདག་གིས་རྙེད་དེ།",
    "དགེ་སློང་གིས་ཤཱཕྲིན་དང་ཕྲིན་ཡིག་དང་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་དེ་ལེན་དུ་བཅོལ་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "བདག་གིར་བྱ་བའི་སེམས་མེད་དེ།",
    "གཞན་ལ་སྦྱིན་པར་བསམ་པ་དང་མི་རུང་བས་རུང་བའི་དངོས་པོ་གཞན་བཙལ་ལོ་སྙམ་མོ།",
    "དེའི་གྲོགས་དག་གིས་ཛེ་ཏའི་ཚལ་དུ་ངོམ་དུ་བཏང་བ་དང་།",
    "དེ་ནས་གཅེར་བུ་པའི་གྲོགས་པོ་དག་གིས་འདུག་ཏུ་མ་སྟེར་ཏེ་ནན་ཐུར་ཆེར་བྱས་ནས་ཕྱིར་ལེན་དུ་བཅུག་པ་དང་།",
    "མ་བྱིན་ན་ཁྲག་གིས་སྒྱུགས་ཏེ་འཆི་བས་སླར་བྱིན་ཅིག་པར་བཀས་གཏད་དེ་དེས་ཁྱིམ་ཕྱགས་ནས་སླར་བྱིན་ནོ་དེ་ལྟར་མཚན་མ་བཏབ་པས་བཟང་ངན་བརྗེས་པ་དག་བྱུང་མོད་ཀྱི་བསླབ་པ་མ་བཅས་སོ།",
    "དུང་གིས་མུ་ཏིག་བརྗེ་སྤུབ་དང་།",
    "དགེ་སློང་གིས་གསེར་དངུལ་ལམ།",
    "དགེ་སློང་མ་དང་དགེ་ཚུལ་ཕོ་མོ་ལ་ཡང་དེ་བཞིན་ནོ།",
    "གཉིས་ཀ་ལེན་པར་མི་གནང་བས་ན་ཉོ་ཞིང་ཚོང་བྱེད་པ་ལ་ཞུགས་ཏེ།",
    "དངོས་ནི་རིན་འོག་ཏུ་ཐལ་བྱུང་དུ་གཏོང་ཞིང་སྤོགས་བྱེད་དེ་ཇི་ལྟར་ཁྲུན་ཉོ་ཞིང་འཚོང་ཞེ་ན།",
    "བསམ་པ་ནི་ཅིས་ཐ་དད་ལྡུཅེས་མི་སྙན་པར་ཟེར་བ་དེ་དགེ་སློང་དག་གིས་སྙན་དུ་གསོལ་ཏོ།",
    "མད་དོ་ཞེས་གསོལ་ནས་དགེ་སྦྱོང་ཕྱེགི་བྱ་བ་མ་ཡིན་རིགས་པ་མ་ཡིན་ཞེས་སྨད་ནས་ཉོ་ཚོང་བྱེད་དུ་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "དགེ་སློང་གིས་ཁེའི་ཕྱིར་འཚོང་།",
    "དེའི་ཚེ་ན་བྱང་ཕྱོགས་ཀྱི་ཚོང་པ་སྔོན་ཆད་གཙུག་ལག་ཁང་དག་མ་མཐོང་བས་དེའི་གཙུག་ལག་ཁང་ཆེན་པོ་ཞིག་འདུག་པ་གསར་དུ་མཐོང་ནས་དེ་ན་དགེ་སློང་འཁོད་པ་རྗོདག་ལ་འཕགས་པ་དག་ལ་བདག་གིས་བཤོས་གསོལ་ན་བདག་ཅག་གསར་དུ་ལྷགས་པས་འབྲས་མ་མཆིས་ཀྱིས་ཟོང་གིས་འབྲས་འཇལ་ལོ་ཞེས་བྱས་པ་དང་།",
    "ཟོང་གིས་འབྲས་གསར་བ་ཉོས་ལ།",
    "དེ་ན་གཅིག་ན་རེ་འཕགས་པ་ལ་ཡོན་ཞིག་འབུལ་ན་ཅི་མཁོ་ཞེས་བྱས་པ་དང་།",
    "དེ་བྱུང་ཡང་དེའི་མོད་ལ་བསླབ་པ་མ་བཅས་སོ།",
    "དགེ་སློང་གི་བྱ་བ་མ་ཡིན་རིགས་པ་མ་ཡིན་ཞུཞེས་སྨད་ནས།",
    "ཆོངས་ཤིག་ཅེས་བྱ་བ་ནི་ཞག་བཅུའི་བར་དུ་བདག་གིར་བཅངས་པའོ།",
    "དེ་ལས་འདས་པར་བཅངས་ན་ཞེས་བྱ་བ་ནི་ཞག་བཅུ་ལས་ཐལ་བའོ།",
    "ཡང་ན་སྔ་མ་སྤངས་ཏེ་ཕྱི་མ་བྱིན་གྱིས་མ་བརླབས་ན་ཚེས་བཅུ་གཅིག་གི་སྐྱ་རེངས་ཤར་ན་སྤང་བའི་ཐོང་བར་འགྱུར་རོ།",
    "དགེ་སློང་གིས་ལྷུང་བཟེད་ལྷག་པ་དེ་སྤང་བར་བྱ་བ་མ་སྤངས།",
    "དགེ་སློང་སྨྱོས་པའི་ཚེ་ཞག་ཐལ་བ་ཉེས་པ་ཆོམེད་དོ།",
    "ཁྱོད་དེ་ལྟ་བུའི་བྱ་བ་འབའ་ཞིག་བྱེད་ཅིང་ཐན་སྐྱེལ་ཏམ་ཞེས་བྱས་ནས་དེའི་འོག་ཏུ་གཞན་རྔེད་པ་དང་དེ་ལ་བཞམས་ཏེ་ཁྱེམ་གང་ཙམ་ན་ཡོད་པ་ཞིབ་ཏུ་དྲིས་ནས་ཚོང་དུས་སུ་བསྙེན་དགའ་བོ་གོམ་པ་བརྒྱངས་ཏེ་སོང་བ་དང་།",
    "ངའི་ཅི་དག་བསྒྲུབས་ཏེ་ཕྱིན་ན་ཕན་མོད་ཅེས་བྱས་པ་གྷུདང་།",
    "འོ་ན་ངས་ཅི་བྱ་ཁྲུང་བཟེད་དེ་ཉོས་ཏེ་ང་ལ་བྱིན་དུན་ཕན་མོད།",
    "དགེ་སློང་གཞོན་ནུ་ཞིག་གིས་སྨྲས་པ་གནས་བརྟན་ལྷུང་བཟེད་བཟང་པོ་ཡོད་བཞིན་དུ་གཞན་ལ་བསླང་བའི་རིགས་སམ་ཞེས་བྱས་པ་དང་།",
    "ལྷན་པ་ལྔར་མ་ཚང་གི་བར་དུ་གཞན་ཚོལ་དུ་མི་གནང་བར་བཅས་སོ།་།",
    "གང་གིས་ལྷུང་བཟེད་བཟང་པོ་ཁྱེར་བ་དེའི་ལྷུང་བཟེད་ངན་པ་གནས་བརྟན་ནས་གཅིག་ཏུ་བརྗེས་ལ་ནན་གྱིས་༧དགེ་སློང་གསར་བུ་ལ་བྱིན་ཅིག།",
    "དགེ་སློང་ལྷུང་བཟེད་ལྷག་པ་འཆང་བའི་ཆད་པ་ཡང་དགེ་སློང་གི་འཁོར་ཐམས་ཅད་ཀྱི་ལྷུང་བཟེད་ངན་པར་གྱུར་པ་དགེ་སློང་དེ་ལ་བྱིན་ཏེ།",
    "གཞན་ལ་ཡང་མ་བྱིན་པར་ཐ་མ་ཆག་པ་ལ་༢ཐུག་གི་བར་དུ་དལ་བུས་བགས་ཀྱིས་སྤྱད་ཅིག་ཅེས་སྒོ་༩སྣཤིག།",
    "དགེ་སློང་གིས་ལྷུང་བཟེད་སྤྱད་བཟོད་པ་ཡོད་ལ་ལྷན་པ་ལྔས་མ་བཏབ་པ་ལས་ལྷུང་བཟེད་ལྷག་པ་གཞན་ཞིག་ཚོལ་ན་ཚོལ་བའི་ཚེ་ཉེས་བྱས་སོ།",
    "ཡུགས་ས་མོ་བལ་འཁལ་བ་ལྔ་བརྒྱ་ཙམ་ཞིག་ཛེ་ཏའི་ཚལ་བྱུ་ཤར་སྒོ་ན་འདུག་པ་མཐོང་ནས་བསྙེན་དགའ་བོ་དེ་དག་གི་གན་དུ་སོང་བ་དང་།",
    "བུད་མེད་གཅིག་གིས་ནི་ཕྱག་བྱས་ཀྱི་གཞན་གྱིས་ནི་མ་བྱས་སོ།",
    "བསྙེན་དགའ་བོས་བུད་མེད་གཞན་གྱིས་ནི་ཚེ་ཕྱི་མའི་ས་བོན་མ་བཏབ་ཀྱི་བུ་མོ་འདི་གཅིག་པུས་ཚེ་ཕྱི་མའི་ས་བོན་བཏབ་པོ་ཞེས་སྨྲས་པ་དང་།",
    "དེ་ཇི་ལྟ་བུ་ཞེས་བུད་མེད་རྣམས་ཀྱིས་དྲིས་པ་དང་།",
    "ཕྱིས་ཡང་སྐུད་པ་རྙེད་ནས་སྤྱི་ཅེར་ལ་བཅོལ་བ་དང་སྔ་མའི་རྔན་པ་མ་སྟེར་བས་ཕྱི་མ་ཡང་མ་བཏུབ་ནས་དེ་བཟོ་དཔོན་གྱེ་གིགན་དུ་སོང་སྟེ།",
    "ཐ་མར་སྐུད་པ་སྐྱེལ་བའི་རང་རྟ་མནོས་ནས་རང་རྟས་བཟོ་དཔོན་གྱི་ཚིག་གིས་ཐོགས་ཤིག་པར་བསྒོ་ན།",
    "མ་བཏུབ་ནས་ལན་དུ་མར་མཐུས་བསྡིགས་ཤིང་ནན་ཐུར་གྱིས་འཐག་ཏུ་བཅུག་པས་ན་ཐ་ག་པས་བཏགས་ཟིན་པའི་འོག་ཏུ་འཕགས་པ་བདག་ཅག་གིས་སྣེཆང་རིན་ཞིག་འཕགས་པ་ལ་གསོལ་ལོ་ཞེས་བྱས་ན་བཀྲེན་པ་ཁྱོད་ཅི་བཅང་བ་ངའི་ཡིན་ནམ་དུག་འཐུང་ན་ཅི་ཉེས་ཞེས་བསྒོ་བ་དང་།",
    "དགེ་སྦྱོང་གི་བྱ་བ་མ་ཡིན་ཞེས་རྣམ་གྲངས་དུ་མའི་སྒོ་ནས་སྨད་ནས།",
    "བདག་གིས་བསླངས་པའི་སྐུད་པ་ཞེས་བྱ་བ་ནི་ཇི་ཙམ་དུ་དད་པ་སྟེ།་",
    "ཁ་གཅིག་གིས་ནི་ཞོ་ཕྱེད་ཕྱེད་ཁྱ་སྦྱིན་པའོ།",
    "དེའི་ཚེ་ན་ཁྱིམ་བདག་ཁྱོ་ཤུག་གཉིས་སོ་སོར་འཕྱོ་ཞིང་ཉལ་པོ་བྱེད་པས་ནོར་ཀུན་འཐོར་ཞིང་འགྲིབས་པར་གྱུར་ཏེ།",
    "ཁྱོ་ཤུག་གཉིས་ཀྱིས་ལེན་དུ་མར་བྲན་མོར་བརྡེགས་སོ།",
    "ཁོས་དེ་ནི་བདེན་ནོ་ཞེས་ནས་བྲན་མོ་ལ་གོས་ཤིག་བྱིན་ནོ།",
    "བདག་གིས་ལེན་རྔུགཞན་ནི་མི་ནུས་ཀྱིས་གཏམ་སྙན་པ་ཙམ་བསྐྱལ་ལོ་སྙམ་ནས་གཏམ་འདི་བསྙེན་དགའ་བོ་ལ་སྦྲན་ནོ་སྙམ་ནས་བསྙེན་དགའ་བོ་དེར་འོངས་པ་ལ་འཕགས་པ་དགའ་བ་སྐྱེད་ཅིག་ཅེས་བྱས་ནས།",
    "བཙུན་མོ་ཕྲེང་ལྡན་མ་ལ་བསོད་སྙོམས་བླངས་པའི་ལ་དུ་ལྷུང་བཟེད་གང་ཐ་ག་པ་ལ་གྲ་རྔན་དུ་བྱིན་ནོ།",
    "དེ་ནས་ཐ་ག་པས་སྐུད་པ་མ་ཆོག་ནས་ཆུང་མ་དང་ཁྱོ་ལས་སོ་སོར་ལན་རེ་བླངས་ཏེ་བསྣན་ནོ།",
    "བསྙེན་དགའ་བོས་སྦྱིན་པའི་ཚིགས་བཅད་སྔར་བླངས་ཏེ་ཐལ་བྱུང་དུ་ཁྱེར་རོ།",
    "དེ་ནས་ཕྱིས་ཐ་ག་པས་ཁྱེམ་བདག་ལ་གླ་རྔན་བདས་ན་ཁྱོད་ཀྱིས་ངའི་གོས་དངོས་ཀྱང་སྟོར་བར་བྱས་ན།",
    "བསྙེན་དགའ་བོ་ལ་གླ་རྔན་བདས་ན་ཁྱོད་ཁྱིམ་བདག་ལས་ལོང་ཤིག་སྤྱོཅེས་ནས་ལན་དུ་མར་བདས་ན་ཡང་མ་སྟེར་ནས་སླད་ཀྱིས་བདས་ན་ངའི་ལ་དུའི་མར་དང་སྦྲང་རྩི་དང་སྤོད་ཚུན་ཆད་བརྩིས་ན་ཡང་གླ་ལྷག་པར་གྱུར་ནས་ཐ་ག་པ་བཟུང་སྟེ་ཉི་ཚན་ལ་གཞག་གོ།",
    "དགེ་སློང་གི་བྱ་བ་མ་ཡིན་ཚུལ་མ་ཡིན་ཞེས་རྣམ་གྲངས་དུ་མས་སྨད་ནས་སླན་ཆད་བྱིན་ཕྲོགས་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "ཕྲོགས་ཞེས་བྱ་བ་ནི་བདག་གིས་སོ།",
    "ཉེས་པ་ནི་ལུས་དང་ངག་གི་སྒོ་ནས་བྱིན་ཟིན་པའི་འོག་ཏུ་ཁྱེར་ལ་ཤོག་ཅེས་སྨྲས་སམ།",
    "དེའི་ཚེ་ཁྱེམ་བདག་ཅིག་གིས་རི་བྲགས་ཤིག་གི་གྲོང་ཞིག་ཏུ་བཙུག་ཀླུལག་ཁང་ཞིག་བརྩིགས་ཏེ་དགེ་སློང་དྲུག་ཅུའི་འཚོ་བའི་ཡོ་བྱད་ཅིག་སྦྱར་ནས་གཙུག་ལག་ཁང་དུ་བཀོད་དེ།",
    "དེའི་བུས་ཀྱང་དགེ་སློང་དག་གི་འཚོ་བ་མ་འབྱོར་ནས་དགེ་སློང་གཞན་ནི་སོ་སོར་གྱེས་སོ།",
    "དེ་ནས་ཚོང་པ་དད་པ་དག་གིས་དགེ་སློང་དྲུག་ཅུ་དབྱར་ཟླ་བ་གསུམ་གྱི་འཚོ་བའི་ཟོང་དེ་གཉིས་ལ་བྱིན་ཏེ་དགེ་སློང་སྤྱན་དྲོངས་ཤིག་ཅེས་ཚོང་པ་དག་གིས་བསྒོ་བ་དང་།",
    "རྒན་པོ་གཅིག་ནི་མཉན་དུ་ཡོད་པར་སྤྱན་འདྲེན་དུ་སོང་ཞུན་བསྙེན་དགའ་བོ་དང་སྒོར་ཕྲད་ནས་དེར་དགེ་སློང་གིས་དེ་ལྟར་ཡོན་བདག་གིས་འཚོ་བ་སྦྱར་ཏེ་སྤྱན་འདྲེན་ཏོ་ཞེས་བྱས་པ་དང་།",
    "ཁྱའདི་ན་དགེ་སློང་གནས་པ་ནི་རྒྱལ་པོས་ཡོན་བདག་བྱས་ཏེ་འཚོ་བ་ཤིན་ཏུ་འབྱོར་པ་དང་ལྡན་པ་ཤ་སྟག་གནས་པས་ཁྱོད་ཀྱི་དེར་སུ་ཞིག་འགྲོ།",
    "དགེ་སློང་དག་གིས་ལེན་ཅིང་འགྱེད་པའི་དུས་མ་ཡིན་ནོ་ཞེས་མ་བླངས་པ་དང་།",
    "དགེ་སློང་དག་གིས་གོས་སྔར་བླངས་ནས་མཛོད་ཀྱི་ནང་དུ་སྦས་པས་གོས་དག་རུལ་བར་གྱུར་ཏོ།",
    "ལོང་ཤིག་ཅེས་བྱ་བ་ནི་བདག་གི་ཕྱིར་རོ།",
    "དེ་ལས་འདས་པར་བཅངས་ན་ཞེས་བྱ་བ་ནི་ཐལ་བའོ།",
    "གཙུག་ལག་ཁང་འདི་བདག་གིས་ཕའི་ཕྱིར་ཡང་མ་བརྩིགས་མའི་ཕྱིར་ཡང་མ་བརྩིགས་འཕགས་པ་ཁྱེད་ཀྱི་ཕྱིར་བརྩིགས་ན་གུད་དུ་མི་གཤེགས་ཤིང་འདིར་ཚུལ་དུ་འཇུག་པར་ཅི་གནང་ཞེས་གསོལ་ནས་དེའི་སེམས་བསྲུང་བའི་ཕྱིར་དགེ་སློང་དེ་དག་ཀྱང་དེར་གནས་སོ།",
    "སྟོན་ཟླ་ཐ་ཆུངས་གཡོན་ཅན་གྱི་རྐུན་པོ་དག་གིས་བགྲོས་པ།",
    "དེ་དག་གི་ནང་ན་དགེ་སློང་གི་ཐུརྒྱུས་ཤེས་པ་གཅིག་ཕྱེན་རེ་སྒོའི་ཐེམ་པ་བརྒྱ་རྒལ་ཞིང་ལྟོ་འགེངས་པ་དེ་དག་ལ་ཅང་མེད་པའི་རིགས་ན་ཞེས་བྱས་ན་དེ་བས་ཀྱང་རྒྱུས་མཁས་པ་གཅིག་༦ན་རེ་དེ་དག་རྙེད་པ་རབ་ཏུ་མང་ངོ་ཞེས་ནས་དེ་ན་ཡོད་དམ་རྔེད་པ་བརྟགས་བྱེཔའི་ཕྱིར་གཉིས་ཤིག་ལྷ་ཁང་གི་ནང་དུ་ཞུགས་ཏེ།",
    "རྐུན་པོ་དེ་དག་གིས་ཀྱང་ཤིག་ཏུ་རྟོག་༡༤ནས་ནམ་ཚུལ་ནས་བྱུང་བའི་དུས་དང་སྦྱར་ཏེ།",
    "དོགས་པ་དང་ཚོ་འཇིགས་པ་དང་བཅས་ཞེས་བྱ་བ་ནི་རྐུན་པོ་དང་གཅན་གཟན་དང་སྦྲང་བུས་འཇིགས་པའོ།",
    "དེ་ལས་འདས་པར་བྲལ་ན་ཞེས་བྱ་བ་ནི་སྐྱ་རེངས་ཀྱིས་ཆོད་པའོ།",
    "ཤིན་ཏུ་མི་མཛེས་པ་རི་དྭགས་དགྲའི་མ་ས་གས་མཐོང་ནས་དེ་ལྟ་བུ་གེམི་མཛེས་པ་ཁྱིམ་པ་དག་གིས་མཐོང་ན་འཕྱ་ན་ཁྲུས་བྱེད་པའི་ཡོལ་བ་གནང་བའི་རིགས་སོ་ཞེས་སྙན་དུ་གསོལ་ནས་དབྱར་གྱི་རས་ཆོངས་ཤིག་པར་བཀས་གནང་ངོ།",
    "བྱེད་པ་མང་བས་ལུང་འབོགས་ཉུ་པ་དང་ཀློག་པའི་བར་ཆད་དུ་གྱུར་ནས་དབྱར་སྔོན་རོལ་དུ་ཡང་ཚོལ་ལ།",
    "དགེ་སློང་གིས་དཔྱིད་ཟླ་བ་གཅིག་གི་སྔོན་ལོགས་ཞེས་བྱ་བ་ནི་དེའི་སྔོན་ལོགས་སུ་རས་ཆེན་ཚོལ་བའོ།",
    "དེ་དག་གིས་ཡུན་རིང་དུ་བཅངས་ན་སྤང་བར་འགྱུར་རོ།",
    "སྤྱིར་རྙེད་པ་གང་ཟག་གི་ཕྱིར་བསྔོས་པའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "བསོད་སྟོམས་སྤྱིར་བཤོས་གསོལ་ཏེ་རས་ཡུག་གཅིག་ཅིག་ཡོན་དུ་ཕུལ་ལོ་ཞེས་ནས་ཁྱིམ་བདག་གིས་ཁས་བླངས་སོ།",
    "ཁྱིམ་བདག་ན་རེ་འོ་ན་འཕགས་པ་བཞེས་སུ་གསོལ།",
    "ཁྱེམ་བདག་གིས་དེའི་རྒྱུས་ཞིབ་ཏུ་སྨྲས་སོ།་།",
    "བསོད་སྙོམས་པས་ཀྱང་བདག་དང་ཁྱེམ་བདག་གིས་ནི་མ་ནོངས་ཏེ།",
    "གསོ་དཀའ་བ་དགང་དཀའ་བ་ཆོག་མི་ཤེས་པ་དགེ་སྦྱོང་གི་བྱ་བ་མ་ཡིན་ཞེས་རྣམ་གྲངས་དུ་མར་སྨད་ནས།",
    "སྤྱིར་བསྔོས་པ་གང་ཟག་བདག་གིར་བྱས་ན་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "གང་ཟག་བདག་གིར་བསྔོས་ཞེས་བྱ་བ་ནི་བདག་རང་གི་ཆེད་དུ་བསྔོས་པའོ།",
    "ཉེས་པ་ནི་གང་ཟག་གཅིག་གི་རྙེད་པ་བདག་གིར་བསྔོས་སམ།",
    "དགེ་སློང་གིས་གང་ཟག་གཅིག་གི་རྙེད་པ་ཕ་རོལ་གཉིས་ལ་བསྔོས་སམ་མང་པོ་ཡང་རུང་སྟེ།",
    "དེ་བཞིན་དུ་གཙུག་ལག་ཁང་གི་ཡོ་བྱད་དང་།",
    "གཙུག་ལག་ཁང་གི་རྒྱན་གྱི་ཡོ་བྱད་དང་མཆོད་རྟེན་གྱི་ཕང་ལོ་རིམ་བཞིན་དུ་འདུག་པ་ལས་ལྟག་འོག་བསྣོར་ན་ཉེས་བྱས་སོ།",
    "རང་གིས་བྱིན་གྱིས་རློབས་ཤིག་ཅེས་བྱ་བ་ནི་བདག་གིས་སོ།",
    "གཞག་པར་བྱ་བའི་བཟའ་བའོ་ཞེས་བྱ་བ་ནི་རང་གིས་བླངས་ནས་བཟའ་བར་བྱ་བའོ།",
    "དེ་ལྟར་མ་བྱས་ན་ཚེས་བརྒྱད་ཀྱི་སྐྱ་རེངས་ཤར་ནས་སྤང་བའི་ལྷང་བར་འགྱུར་རོ།",
    "ཇི་ལྟ་བུར་ཟོས་པ་ཡང་ཉིན་གཅིག་བཞིན་དུ་དེ་ནི་བདག་གིས་ཉི་མ་གཅིག་ཟོས་ལྷག་མ་ཡང་བཟའོ་ཞེས་ཚངས་པ་མཚུངས་པར་སྤྱོད་པའི་མདུན་དུ་ཞག་བདུན་གྱི་བར་དུ་རྗོད་ཅིག།",
    "དེ་བཞིན་དུ་ཁྱིམ་བདག་གིས་བཙལ་ཀྱང་མ་རྙེད་དོ།",
    "བྲམ་ཟེ་དག་གིས་གཡོ་བྱས་ནས་ཤཱཀྱའི་དགེ་སློང་མེ་བཞི་སྐྱེས་ལ།",
    "གཙུག་ལག་གིས་རྒོལ་ཅིག་ཅེས་བྱས་ནས།",
    "དེ་གཉིས་ཀྱང་སྐྱེད་མོས་ཚལ་ཞིག་ཏུ་དུས་བྱས་ནས།",
    "བྲམ་ཟེ་ནི་དེའི་མཚན་ཐོག་ཐག་བདག་གི་སྤུཕྱོགས་དང་གཞན་ཀྱི་ཕྱོགས་ལ་སེམས་སེམས་ཏེ་ནམ་ནངས་ནས་དུས་སར་ཕྱིན་པ་དང་།",
    "དགེ་སློང་མེ་བཞི་སྐྱེས་ནི་དེའི་ཉིན་མོ་བསོད་སྙོམས་ལ་སོང་སོང་སྟེ་སླར་ལོག་པ་དང་།",
    "དགེ་སློང་ཁྱོད་ཅིའི་ཕྱིར་འདིར་མི་འོང་ཞེས་བྱས་པ་དང་།",
    "བྲམ་ཟེས་འུཁྱོད་ང་ལ་ཆེད་དུ་བསམས་ཏེ་ཐོ་འཚམས་སམ་ཅི་ཞེས་བྱས་པ་དང་དེ་བཞིན་ནོ་ཞེས་སྨྲས་པ་དང་།",
    "དེ་ལ་དགེ་སློང་གི་འདུ་ཤེས་སྦས་ནས་མཐོང་ངོ།",
    "དགེ་སློང་གིས་མིའི་སྐྱོན་ནས་འབོད་པའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "དགེ་སྦྱོང་གི་བྱ་བ་མ་ཡིན།",
    "དགེ་སློང་གིས་མིའི་སྐྱོན་ནས་འབོད་པར་བསམས་ཏེ།",
    "དགེ་སློང་ལ་ཚེ་དང་ལྡན་པ་ཁྱོད་རྒྱལ་རིགས་དང་བྲམ་ཟེའི་རིགས་ལས་རབ་ཏུ་བྱུང་བས་ཁྱོད་ལ་དགེ་སྦྱོང་དང་ཚངས་པ་མེད་དོ་ཞེས་བྱས་ན་དགེ་སྦྱོང་སྤ་གོང་ཡང་རུང་ལ་མ་གོང་ཡང་རུང་ཊུསྟེ་ཉེས་བྱས་སུ་འགྱུར་རོ།"
  ]
