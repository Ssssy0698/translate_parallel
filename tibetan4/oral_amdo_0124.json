    "དགེ་སློང་ཡང་ཞེ་སྡང་ལ་གནས་པ་ཞེས་བྱ་བ་ནི་བདག་གིས་སྒུར་པ་གདབ་པར་འདོད་པའོ།",
    "མ་མཐོང་མ་ཐོས་མི་དོགས་པར་འདུ་ཤེས་དང་བློ་གྲོས་སྦས་ནས་མཐོང་ངོ་ཐོས་སོ་དོགས་སོ་ཞེས་སྨྲས་ན་ལྷག་མ་རེ་རེར་འགྱུར་རོ།",
    "བཟོད་པ་དང་བློ་གྲོས་དང་འདུ་ཤེས་སྦས་ནས་མ་བརྗེད་སྒྲུདོ་ཞེས་སྨྲས་ན་ལྷག་མ་གྲུརེ་རེར་འགྱུར་རོ།",
    "དོགས་ལ་དོགས་བཞིན་དུ་ངས་མཐོང་ངོ་ཞེས་སྨྲ་ན་ཚིག་རེ་རེ་ཀོཞིང་ལྷག་མ་རེ་རེར་འགྱུར་རོ།",
    "རི་མོ་བྲིས་པ་དང་།",
    "བདག་གིས་ཤེས་པ་བཞིན་དུ་འཇིག་རྟེན་ཀུན་གྱིས་ཤེས་པ་ནི་ཉེས་པ་མེད་དོ།",
    "དགེ་སློང་གིས་དགེ་སློང་ལ་ཕྲིན་དང་ཕྲིན་ཛེེཡིག་དང་ལག་བརྡ་དང་གཅིག་ནས་གཅིག་དུ་བརྒྱུད་དེ་སྐུར་ན་སྤོམ་པོར་འགྱུར་རོ།་",
    "དགེ་སློང་གིས་དགེ་སློང་སྦྱོན་པ་དང་སེམས་འཁྲུགས་པ་དང་།",
    "མུ་སྟེགས་ཅན་དུ་སོང་བ་དང་།",
    "དེའི་འགྲམ་ཡན་ཙ་མན་གྱད་བུ་ནོར་ཉིན་པར་དེར་གནས་ཤིང་བསྒོམ་མོ།",
    "འཕགས་པ་མོད་གལ་གྱི་བུ་དང་།",
    "དེའི་ཉིན་པར་འཕགས་པ་མོད་གལ་ལ་སོགས་པ་ལ་ཕྱག་བྱས་ནས།",
    "ད་ནི་བག་ཙམ་བྱུ་ཆ་ལས་བླངས་བྱཔས་རུང་གིས་དགེ་སློང་དག་ལ་བསྙད་དུ་འདོང་ངོ་ཞེས་བྱས་ནས།",
    "དགེ་སློང་དག་གིས་ཚེ་དང་ལྡན་པ་ཁྱོད་ཐུ་གཉིས་ལྷ་དང་མི་ནི་ཤིན་ཏུ་སྤངས་ཀྱི།",
    "དགེ་སློང་དག་གིས་ཡང་གོང་མ་བཞིན་དུ་ཅིའི་ཕྱིར་༧མཐོང་།",
    "ལེགས་པ་རྣམ་པ་བཅུ་ལ་གཟིགས་ནས།",
    "ཞེ་སྡང་ཅན་ཞེས་བྱ་བ་ནི་ཞེ་སྡང་གིས་ཀུན་ནས་བསྐོར་བའོ།",
    "དེ་ཅི་ནས་ཀྱང་ཚངས་པར་སྤྱོད་པ་དང་དབྲལ་ཕྱེལོ་སྙམ་པ་ནི་དེ་ཅི་ནས་ཀྱང་དགེ་སློང་གི་དངོས་པོ་དང་དབྲལ་ལོ་སྙམ་དུ་སེམས་པའོ།་།",
    "གཞན་གྱི་ཆ་མ་ཡིན་པས་རྩོད་པ་ཡང་བག་ཙམ་གྱི་ཐུཆ་ལས་འགའ་ཞིག་ཅེས་བྱ་བ་ནི་རི་དྭགས་ཕོ་མོས་འཁྲིག་པའི་ཆ་ལས་བླངས་པའོ།",
    "ཉེས་བྱས་བྱུང་བ་མཐོང་བ་ལ་དེས་འདུ་ཤེས་སྦས་ན་བློ་གྲོས་སྦས་ནས་ཕས་ཕམ་པ་བྱུང་ངོ་ཞེས་བྱ་བ་རྔུ་སྨྲས་ན་ཐམས་ཅད་དུ་ལྷག་མར་འགྱུར་བ་དེ་རེ་རེར་སྤྱོར་ཅིག།",
    "ཀ་ཌ་མོ་ར་ཀ་ཏི་༦་དང་།",
    "དགེ་སློང་ཁ་ཅིག་གིས་བྱང་གི་སྒྲ་མི་སྙན་གྱི་གླིང་ནས་ཊུམ་བཏབ་མ་རྨོས་པའི་འབྲས་ལེན།",
    "ངས་ཤཱ་རིའི་བུ་དང་མོད་གལ་གྱི་བུ་ལ་ཡང་མ་གཏད་ན་སྐྱེས་བུ་བླུན་པོ་ཁྱོད་ལ་ཅི་སྨོས་ཞེས་མ་གནང་ངོ།",
    "དེ་ནས་ལྷ་སྦྱིན་གྱིས་དགེ་སློང་གྲོགས་ཀ་ཌ་ཀྱེ་མོ་ར་ཀ་ལ་སོགས་པ་ལྔ་པོ་ལ་ཁེ་མོ་ཚུར་ཤོག།",
    "དེ་ལྟར་གྱུར་པ་དགེ་སློང་གིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་ཏོ།",
    "སེམས་ནི་རེག་པའོ།",
    "ལན་གཉིས་ལན་གསུམ་ཞེས་བྱ་བ་ནི་ཧ་ཅང་ཉུང་རྨྱེ་ན་ཡང་གཡེངས་༡པ་ཁ་ཅིག་གིས་མི་གོ་ལ་ཧ་ཅང་མང་ཀྱེན་ཡང་རིང་དུ་ཐོགས་པའི་ཕྱིར་རོ།",
    "ཀ་ཌ་༧མོ་ར་ཀ་ལ་སོགས་པ་ལ་དེ་ལྟ་བུར་རྗེས་སུ་ཕྱོགས་པ་བདེན་ནམ་ཞེས་སྨྲས་པ་དང་།",
    "དགེ་སྦྱོང་གི་བྱ་བ་མ་ཡིན་ན་ཞེས་རྣམ་གྲངས་དུ་མའི་སྒོ་ནས་སྨད་ཌནས།",
    "དེ་དག་༤ལ་གནས་ཀྱི་སྒོ་ནས་རིགས་སུན་པ་ནི་བུད་མེད་དང་ཕྱེ་སྟེགས་གད་རྒྱངས་བྱེད།་",
    "དེ་ལ་ལོངས་སྤྱོད་ཀྱི་སྒོ་ནས་རིགས་སུན་པ་ནི་བུད་མེད་དང་སྣོད་གཅིག་གི་ནང་དུ་ཟ།་",
    "དེ་ལྟར་རྩེད་མོ་སྣ་ཚོགས་བྱེད་པས་ན།་",
    "དེ་ནས་དུས་གཞན་ཞིག་ན་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ཡུལ་སྣང་བ་ཅན་དུ་ལྗོངས་རྒྱུ་ཞིང་འགྲོ་བ་ལས་དེའི་ནུབ་མོ་སྲིན་བུའི་རིའི་ནགས་ན་གནས།",
    "བསོད་སྙོམས་ཀྱང་མ་རྙེད་ལན་ཀྱང་མ་ཐོབ་ནས་ཀུན་དགའ་བོས་བསམས་པ་ཉན་ཐོས་བྱིས་པ་མི་མཁས་པ་མི་གསལ་བ་འགའ་ཞིག་གིས་རིགས་ཀྱི་བུ་མོ་དག་ལ་ཁ་ངན་ནམ་ལུས་ཀྱིས་ཀུན་དུ་རེག་པ་ཞིག་བྱས་སོ་སྙམ་དུ་སེམས་སོ།",
    "དགེ་སློང་གནས་བརྟན་དག་དང་ངུར་ཁ་དང་དམར་གྱི་དགེ་སློང་དག་དང་ཕྲད་ནས་དེ་ན་གནས་པའི་དགེ་སློང་གཅིག་གིས་ཀྱང་བལྟར་ཡང་མི་བཏུབ་ཕྱག་ཀྱང་མི་འཚལ་ལོ།",
    "དགེ་སློང་རྣམས་བདག་ཅག་གིས་ཉེས་པ་སྣ་ཚོགས་བྱས་ཏེ།",
    "གནས་བརྟན་དག་གིས་གསོལ་བ་དང་།",
    "སྣང་བ་ཞེས་བྱ་བ་ནི་མིག་གི་རྣམ་པར་ཤེས་པས་སོ།",
    "ལ་འདོད་པས་ཞེ་སྡང་གིས་གཏི་མུག་གིས་འཇིགས་པས་འགྲོ་ཞེས་ཟེར་ན་ཐམས་ཅད་དུ་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཁྱེད་ཀྱིས་བདག་ལ་བསྒོ་བས་ཆོག་གིས་ཞེས་ཟེར་བ་ནི་བཀའ་བློ་མི་བདེ་བ་ལ་གནས་པའོ།",
    "ཁྱིམ་བདག་གི་ཆུང་མ་སྦེད་མའི་ཁྱིམ་དུ་སོང་ངོ།",
    "ལེགས་པ་བཅུ་གཟིགས་ནས་བཀའ་སྩལ་པ།",
    "གཉིས་ཊུཞེས་བྱ་བ་ནི་སྐྱེས་པ་དང་བུད་མེད་གཉིས་སོ།",
    "བུད་མེད་དམ།",
    "སྐྱབས་ཡོད་པ་ཞེས་བྱ་བ་ནི་རྩིག་པ་འམ་སབ་མོའམ།",
    "དགེ་སློང་བུད་མེད་དང་སྟན་གཅིག་རྨྱེལ་འདུག་པའམ།་",
    "ཉེས་པ་མཐོང་ན་སྡོཁས་མི་ལེན་ན་ཉེས་པའི་ངོ་བོ་ཉིད་ཚོལ་བའི་དགེ་སློང་གིས་ཆད་པ་རབ་ཏུ་དབྱུང་བར་མི་བྱ།",
    "དེ་དག་གང་གིས་གླེང་བ་དེ་བྱེད་དུ་གཞུག་གོ།",
    "གཙུག་ལག་ཁང་ཆག་ཆག་གདབ་པ་ལ་སོགས་པ་ལས་སྣ་རེ་བྱེད་ཀྱང་གོས་ལན་རེ་བརྗེ་ཞིང་གོན་ནས་ཙོ་ཁ་ཏོན་དང་ཧཱུཾལུང་དབོག་པ་དང་།",
    "ཞག་བཅུ་གཅིག་གི་སྐྱ་རེངས་ཤར་ན་སྤང་བར་འགྱུར་རོ།",
    "ཆོངས་ཤིག་ཅེས་བྱ་བ་ནི་བདག་གིར་བྱ་བའོ།",
    "དེ་ལས་འདས་པར་བཅངས་ན་ནི་ཞེས་བྱ་བ་ནི་ཞག་བཅུ་ལས་ཐལ་བའོ།་",
