    "དེ་ལས་འཕྲོས་ཏེ་ཕ་ཁོ་ལ་སོགས་ཀྱིས་རྩོད་སྤོང་འགོག་ཚུལ་དང་རང་ལུགས་ཀྱི་དམིགས་རྐྱེན་འཇོག་ཚུལ་སོགས་རྗེ་བསྟན་པའི་སྒྲོན་མེའི་དམིགས་བརྟག་འགྲེལ་བར་གསལ་བས་དེར་ལྟོས།",
    "འདི་པས་རང་མྱོང་རང་མཚན་མེད་། རྗེ་གུང་ཐང་བློ་གྲོས་རྒྱ་མཚོའི་དྲང་ངེས་དཀའ་འགྲེལ་སོགས།",
    "གཉིས་པ་རང་ལུགས་ལ་རང་རྒྱུད་དང་རང་མཚན་གྱིས་གྲུབ་པའི་དམ་བཅའ་དང་ཁས་ལེན་སོགས་མེད་ཀྱང་རྒྱུ་འབྲས་དང་ཕྲད་མ་ཕྲད་སོགས་བསྒྲུབ་བྱ་སྒྲུབ་བྱེད་ཐ་སྙད་སྒྱུ་མ་ལྟ་བུར་ཐམས་ཅད་འཐད་པར་ལུང་རིགས་དུ་མས་སྒྲུབ་བོ།",
    "བྱ་བ་དེ་བྱེད་པ་ལས་རྫས་གཞན་དུ་མ་གྲུབ་པའི་ཁས་བླང་རང་ལ་མེད་པའི་ཕྱིར།",
    "ཁོ་རང་ཀུན་གཞི་ལ་སྣང་བ་ནི་མ་ཡིན་ནོ།",
    "ཐམས་ཅད་རང་རང་ཇི་ལྟ་བ་བཞིན་དུ་སྣང་བར་འདོད་དོ།",
    "གནས་སྐབས་ལྡོག་དུས་དང་།",
    "༢༢ ཕྲག་དོག་སེར་སྣ་འགྱོད་པ་ཁྲོ་བ་ང་རྒྱལ་ལྔ་བདེན་བཞིའི་འདོད་ཆགས་ཁོང་ཁྲོ་ཐེ་ཚོམ་བཞི་བཞི་སྟེ་ཉེར་གཅིག་ལ་འགོག་ལམ་བཀོལ་བའི་ལྷག་མའི་བཅུ་དགུའི་དམིགས་པ་ལ་ཁམས་ཐ་མ་གསུམ་བཞི་ཚན་གཅིག་དུས་གསུམ་ཟག་བཅས་འདུ་བྱས་ཏེ་བཅུ་གཉིས།",
    "ཚིག་འདྱི་བཀོད་རྒྱུ་ཕྲན་བུ་ནོར་འདུག་ཞུ་རྒྱུ་ཡྱིན།",
    "ལས་བསོམས་འབྱི་སྟངས་དང་ཕག་ལས་གནང་སྟངས་དེ་ཚོ་སྱི་ཡོངས་ཀྱི་ཐོག་ནས་ཧ་ཅང་ཡག་པོ་ཆགས་འདུག་ཅེས་བསགས་བརོད་ཅྐྱིག་ཞུ་རྒྱུ་ཡོད།",
    "ད་དུང་ཡང་དེ་འདའྱི་འཐུས་ཤོར་གྱི་ཆ་ནས་མང་པོ་ཞྱིག་མཐོང་བསད་པ་དེ་འད་ཞྱིག་འདུག་སོན་མ་ཡྱིན་ན་ངས་གོས་ཚོགས་དེ་འདའྐྱི་ནང་དུ་ཞུས་པ་ཡྱིན།",
    "དེའྐྱི་བཀའ་ལན་དེ་ཚོ་ཏག་ཏག་གནང་གྱི་མྱི་འདུག་དེ་རྱིང་སར་ཡང་དན་གསོ་ཞུ་རྒྱུ་ཡྱིན།",
    "གོས་ཚོགས་ཚོགས་དང་མ་ཚོགས་ཁྱད་པར་མྱི་འདུག་འདྱི་བྱེད་དུས་སོབ་གྲྭའྱི་ནང་དུ་བོད་ནས་ཕེབས་ཐུབ་ཀྱི་མེད་པའྱི་སོར་ལ་དཔེ་མཚོན་ཁ་ཤས་ཞྱིག་ཞུ་ཡྱི་ཡྱིན།",
    "཈ེ་བའྱི་ཆར་བོད་ནང་གྱི་མྱི་འགས་གསུངས་ཀྱི་འདུག་སོན་མ་ངའྱི་ཕྲུ་གུ་རྒྱ་གར་ལ་བཏང་བ་ཡྱིན།",
    "ང་རང་ལ་རྒྱ་གར་ནང་དུ་ཕ་མ་སྤུན་མཆེད་དེ་འད་སུའང་མེད།",
    "ཁྱྱིམ་ཚང་ནང་དུ་སོད་བཅུག་གྱི་མེད་པ་དེ་འད་བྱས་ནས་ཕྲུ་གུ་སྱི་ཡོངས་ཀྱི་ཐོག་ལ་ཧ་ཅང་གྱི་འཐུས་ཤོར་འགོ་ཡྱི་འདུག་དེ་བྱེད་རྒྱུ་གང་ཡང་མྱི་འདུག་བོད་ཁྱྱིམ་གྱི་འགན་འཛིན་དྲུང་དུ་ཐེངས་མ་ཁ་ཤས་བཅར་ནས་བསམ་འཆར་ཕུལ་བ་ཡྱིན།",
    "ཕྲུ་གུ་གསུམ་མ་གཏོགས་གཞན་དག་ཚང་མ་ཡྱིག་རྒྱུགས་འཕྲོད་མྱི་འདུག་དེ་འདའྱི་གནས་སྟངས་བྱུང་བ་དེ་ལོ་སོན་མ་ནས་ངས་ཞུས་པ་ཡྱིན།",
    "དེ་མྱིན་སོབ་ཕྲུག་མང་པོ་ཞྱིག་ན་འགོ་ཡྱི་འདུག་ཅེས་དེ་ལྟར་ཁོང་བཞུགས་པའྱི་རྱིང་དེ་ལ་ཚོད་བལྟ་བྱས་ཏེ།",
    "ངེས་པར་དུ་དེ་སར་དགོས་རྒྱུ་གལ་ཆེན་པོ་ཆགས་འདུག་ཅེས་དེ་གཅྱིག་ཞུ་རྒྱུ་ཡྱིན།",
    "སྱིར་བཏང་ང་རང་གྱིས་གོ་བ་ལེན་སྟངས་བྱས་ན།",
    "ཏན་ཏན་དེ་འད་ཞྱིག་གྱི་བསམ་ཚུལ་ཤུགས་ཆེན་པོ་ཞྱིག་སེབས་ཀྱི་འདུག་དེའྱི་ཐོག་ལ་དམྐྱིགས་བསལ་འབད་བརོན་ཞུས་ནས་ཤུགས་གཅྱིག་རྒྱག་ཐུབ་ན་བསམས་ནས་ད་ལྟ་ག་སྒྲྱིག་ཞུ་ཡྱི་ཡོད་ཞུ་རྒྱུ་ཡྱིན།",
    "རྒས་འཁོགས་དབུ་སྐྲ་དཀར་པོ་དེ་ཚོས་སོན་མའྱི་གཞུང་ཡྱིག་དེ་ཚོ་གང་འད་བྱིས་ཀྱི་འདུག་གམ།",
    "སོ་སོའི་བོད་ཀྱི་སད་དང་ཡྱི་གེ་ཡར་རྒྱས་གཏོང་རྒྱུར་གང་འད་བྱས་ནས་ཡར་རྒྱས་གཏོང་གྱི་འདུག་གམ།",
    "དེ་རྱིང་གྱི་ལས་བསོམས་དེའྐྱི་ནང་ལ་ཤོག་ལེ་བཅུ་ཙམ་མཐོང་རྒྱུ་འདུག་ཀང་འབྲུག་ནང་གྱི་སོབ་གྲྭ་ཡོད་པ་སོབ་ཕྲུག་ཞྱིག་ཡོད།",
    "འགོ་བརོད་རང་ལ་རྒྱ་བལ་འབྲུག་གསུམ་གསུངས་ཀྱི་འདུག་ཀང་།",
    "དེ་ཙམ་གྱིས་འདོད་པ་ཚིམ་གྐྱི་མྱི་འདུག་སོ་སོ་ལྟ་བུ་ཡྱིན་ན་དྱི་བ་ཞུ་རྒྱུར།",
    "ལོ་དེར་དེ་འད་བྱུང་འདུག་དང་ལོ་འདྱིར་དེ་འད་བྱུང་འདུག་ཅེས་བསྟན་རྒྱུ་ཡོད་ན།",
    "བརྒྱད་པ་བཅས་ཀྱིས་ཟུར་འདོན་བྱས་པའྱི་སོབ་ཚན་ཞྱིག་གོ་སྒྲྱིག་གནང་འདུག་དེ་འདའྱི་སྱི་ཚན་སོབ་དེབ་དེ་ག་དུས་སོབ་ཀྱི་ཡོད་དམ།",
    "དེ་འདའྱི་སོབ་དེབ་དེ་ག་དུས་སོབ་ཀྱི་ཡོད་དམ།",
    "དེ་ཁ་གསལ་གང་ཡང་མྱི་འདུག་དེ་དུས་ནམ་ལ་ཚོགས་པ།",
    "གོ་སབས་གནང་དགོས་འདུག་གསུངས་པ་དེ་ངེས་པར་ཞུ་ཆོག་པ་ཞེས་ཞུ་རྒྱུ་ཡྱིན།",
    "གངས་ཀ་དེ་ངས་གསལ་པོ་ཞྱིག་དན་གྱི་མྱི་འདུག་ཕལ་ཆེར་སུམ་ཅུ་སོ་གངས་ཤྱིག་མ་གཏོགས་ལྷག་མེད་སམ།",
    "དེ་ར་བ་ནས་འགྱིག་གྱི་མྱི་འདུག་ཟེར་ནས།",
    "དེ་འདའྱི་དཀའ་ངལ་ཞྱིག་རང་བཞྱིན་གྱིས་ཆགས་ཀྱི་འདུག་དེ་ནས་རྒྱ་བལ་འབྲུག་གསུམ་ནང་སོབ་གྲྭ་ཁག་༧༢ བྱིས་འདུག་གསུངས་པ་དེའྱི་ནང་འབྲུག་ཅེས་བྱིས་པ་དེར་དགོངས་སེལ་ཞུ་རྒྱུ་ཡྱིན།",
    "འགོད་ནོར་ཐེབས་འདུག་དགོངས་སེལ་ཞུ་རྒྱུ་ཡྱིན།",
    "དེས་འཐུས་ཀྱི་འདུག་སམ།",
    "དེའྱི་ནང་སོབ་ཁྱིད་ཧ་ཅང་ཡག་པོ་བྱེད་ཀྱི་འདུག་ཟེར།",
    "སད་ཡྱིག་ག་཈ྱིས་པ་ག་དུས་འགོ་འཛུགས་དགོས་ཀྐྱི་ཡོད་མེད།",
    "གསུམ་པ་ག་དུས་འགོ་འཛུགས་དགོས་ཡོད་མེད།",
    "བསྐྱར་ཞྱིབ་གནང་དགོས་པ་འདུག་གམ་མྱི་འདུག་ལག་ལེན་བསྟར་མ་ཐུབ་པ་དེ་ཚོ་ད་ལྟ་མ་ཐུབ་ན།",
    "གནས་སབས་གཞག་དགོས་འདུག་གམ།",
    "ཡག་པོ་ཡོང་བ་འདུག་ཅེས་ཞུ་རྒྱུ་ཡྱིན།",
    "ཡྱིན་གསུངས་ཀྱི་འདུག་ཟེར་དུས་ཚོད་བལྟ།",
    "ལེན་རྒྱུའྱི་བརྒྱུད་རྱིམ་དེ་དེ་ག་རང་གནང་དགོས་པ་འདུག་གམ།",
    "ངའྱི་ཐོག་ནས་དམྱིགས་བསལ་ཞུ་ཚོད་འཐྐྱིག་གྱི་མྱི་འདུག་ཡྱིན་ནའང་ས་མཚམས་འད་པོ་དེ་ང་རང་གྱིས་འདྱི་འད་བལྟས་ན།",
    "ཕལ་ཆེར་དེ་བྱེད་མྱི་ཐུབ་པ་མེད་པ་ཞྱིག་འདུག་ཅེས་ཞུ་རྒྱུ་ཡྱིན།",
    "༡༧ བར་བོད་ནང་རང་ལུས་མེར་བསྲེགས་གནང་མཁན་གྲངས་༡༣༡ པ་དང་།",
    "ར་བའྱི་ངས་བརོད་པ་ག་཈ྱིས་པའྱི་སབས་སུ་བཟོ་བཅོས་འཁྱེར་ཡོང་ན་མ་འགྱིག་པ་མྱི་འདུག་སེ།",
    "འདྱི་ཡྱིན་དུས་དེ་རྱིང་བཅར་ཐུབ་ཀྱི་མྱི་འདུག་སང་཈ྱིན་ཕེབས་ཀྱི་ཡོད་ཅེས་ཞུ་རྒྱུ་ཡྱིན།",
    "དུས་ལ་བབས་འདུག་འདྱི་ཕྱིས་དགས་མྱི་འདུག་ཞུ་རྒྱུ་འདྱི་ཡྱིན།",
    "གཅྱིག་འདྱི་ད་ལྟ་ལོ་གསུམ་དགོས་ཀྱི་འདུག་གཅྱིག་འདྱིས་ལོ་བཞྱི་རང་གནས་ཐུབ་དགོས་ཀྱི་འདུག་ལབ་དུས།",
    "འདྱི་ཁ་གསལ་པོ་ཡྱིན་བསམ་གྱི་འདུག་ད་ལྟའྱི་སབས་སུ་ངའྱི་འདྱི་དཔལ་ལྡན་སྱིད་སྐྱོང་གྱི་ཁྱི་གཅྱིག་དང་འབུམ་གཅྱིག་དང་འབེལ་བ་གང་ཡང་མེད།",
    "དེ་འད་ཡྱིན་དུས་ག་པར་ལ་བལྟས་ནའང་སོར་བ་གང་དུ་བརྒྱབས་པ་ཡྱིན་ནའང་རྨོ་བག་ལེབ་འཚོང་མཁན་སྒོ་འགམ་སེབས་པ་འདུག་ཟེར་བ་བཞྱིན།",
    "ལོ་གསུམ་བྱས་པ་ཞྱིག་བྱུང་ན་ཡག་པོ་འདུག་ཅེས་པ་ལབ་རྒྱུ་དེ་ཏོག་ཙམ་གནས་སྟངས་གང་ཅྱིའྱི་ཐོག་ནས་བདེ་པོ་མེད་མཁན་འད་པོ་ཞྱིག་ཡྱིན་ན།",
    "འདྱི་ཡྱིན་དུས་ད་ལྟའྱི་ཆར་གདམ་ག་འདྱི་ཚང་མར་མེད་འགོ་བསམ་གྱི་འདུག་དཔེར་ན་སམ་བྷོ་ཉར་ཆ་བཞག་པ་ཡྱིན་ན།",
    "དེའྱི་སབས་ལ་ང་རང་ལ་ཚོར་བ་ཞྱིག་བྱུང་།",
    "ཡྱིན་ནའང་ང་རང་གྱིས་དེའྱི་སབས་ལ་བསམ་པའྱི་ནང་ལ་ངས་ཚིག་འདྱི་འད་ཞྱིག་བེད་སོད་བཏང་བ་ལ་བཀའ་བཀོན་བཏང་དགོས་བྱུང་ན།",
    "དེ་ཚོ་ལ་འདྱི་ལས་མང་ཙམ་མམ་ལྷག་པ་གསུངས་དགོས་པ་འདུག་སྟེ།",
    "དེ་ནས་མཐོ་སོབ་ལ་སོབ་ཡོན་སོན་མ་དང་མ་འད་བར་ཧ་ཅང་མང་པོ་གནང་འདུག་བསགས་བརོད་ཞུ་བཞྱིན་ཡོད།",
    "བདེན་པ་ཡྱིན་ན་དེ་ཚོའྱི་ཐོག་ལ་དགོངས་པ་བཞེས་དགོས་ཀྱི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡྱིན།",
    "དེ་འད་ཡོང་གྱི་འདུག་དེའྱི་མྱིང་ཐོ་དང་དེ་འད་དགོས་ཀྱི་ཡོད་གསུངས་དུས།",
    "དེ་འད་ར་བ་ནས་མེད་ཟེར་བའྱི་སོབ་གྲྭ་ཁག་ཅྱིག་ཡོང་གྱི་འདུག་བྱས་ཙང་བཀུར་འོས་སྱི་འཐུས་ལ་ང་རང་གྱིས་ལན་འདེབས་ཀྱི་ཚུལ་དུ་གང་ཡང་མྱིན།",
    "ཡྱིན་ཡང་དྱི་བ་ཁ་ཤས་ཤྱིག་ལུས་འདུག་པ་དེ་དག་ཞུ་རྒྱུ་ཡྱིན།",
    "ང་རང་གྱི་བསམ་ཚུལ་ལྟར་ན།",
    "ལ་བསྒྱུར་ཡང་ཞེས་པ་མྱིང་དེ་གནས་ཀྱི་འདུག་ཅེས་འབོད་བསྐུལ་ག་཈ྱིས་པ་ཞུ་རྒྱུ་ཡྱིན།",
    "ང་རང་གྱིས་ཀང་དེ་ལྟར་བསམ་གྱི་ཡོད།",
    "ང་རང་ཡྱིན་ན།",
    "དེ་ག་རང་ཆགས་ཀྱི་འདུག་ཁ་སང་གཅྱིག་ཞུས་པ་ཡྱིན།",
    "ཁོ་རང་རང་སོབ་གྲྭ་ཆུང་ཆུང་ཞྱིག་ནང་ཤན་ཤུགས་གང་ཡོང་ནའང་དེ་ག་རང་ནང་བསད་རྒྱུར་ཡག་པོ་མེད་དམ་ཟེར།",
    "ང་རང་སོབ་གྲྭའྱི་ནང་མར་བལྟ་བར་ཕྱིན་དུས།",
    "དེ་ནས་སོབ་གྲྭའྱི་ནང་ཕྲུ་གུ་ཚུར་འཇུག་རྒྱུ་དེ་ལ་ཕ་མ་ཁ་ཤས་ཀྱིས་ཚུར་ག་ཏོང་རྒྱུའྱི་འདོད་པ་འདུག་དེ་ཚོར་དགོངས་པ་བཞེས་དགོས་གསུངས་པ་དེ།",
    "དཔལ་ལྡན་ཚོགས་གཙོ་མཆོག་དྱི་བ་དེ་རྣམ་གངས་མ་འད་བ་ག་཈ྱིས་ཆགས་ཀྱི་འདུག་གཅྱིག་ད་ལྟ་དཔལ་ལྡན་སྱིད་སྐྱོང་མཆོག་ཤེས་རྱིག་བཀའ་བོན་དང་སྱིད་སྐྱོང་གཅྱིག་ལྕོགས་ཡྱིན་པའྱི་ཆ་ནས།",
    "ཕལ་ཆེར་༢༡༡ ལོའི་ཕྱི་ཟླ་༧ པ་ནས་བཟུང་གནས་སབས་ཤེས་རྱིག་གྱི་ཁྱབ་ཁོངས་ཡྱིན་ཞེས་པ་ཞྱིག་དེའྱི་ནང་ལ་བཀོད་འདུག་གནས་སབས་ཡྱིན་གསུང་དུས།",
    "ཁོ་རང་ཁོ་རང་ཁག་ཁག་འཇོག་པ་དེ་ལའང་དགེ་མཚན་མེད་དམ་ཞེས་དེ་གཅྱིག་ཡྱིན།",
    "དཀའ་ལས་གཅྱིག་པ་བརྒྱབས་པ་དེ་ལ་ཕོགས་དེ་གཅྱིག་པ་དགོས་ཀྱི་འདུག་ཟེར།",
    "དེ་ཚོར་ངེས་པར་དུ་དགོངས་པ་བཞེས་དགོས་ཀྱི་འདུག་ཅེས་ཞུ་རྒྱུ་གཅྱིག་ཡྱིན།",
    "ཆེ་མཐོང་ལྡན་པའྱི་ཐོག་ནས་བཞུགས་སའྱི་ཐོག་ལ་དགོངས་པ་བཞེས་དགོས་ཀྱི་འདུག་ཅེས་ཞུ་རྒྱུ་གཅྱིག་ཡྱིན།",
    "ག་ཕོགས་འད་མ་཈མ་ཡོང་ཐབས་ཐོག་ལ་དགོངས་པ་བཞེས་དགོས་པ་འདུག་གསུངས་པ་དེ།",
    "དེ་བཞྱིན་ཡོང་རྒྱུ་ཁག་པོ་ཞྱིག་ཆགས་ཀྱི་འདུག་དེ་མྱིན་སོབ་གྲྭའྱི་སེ་ཚན་སོ་སོའི་ཐོག་ནས་ཕྲན་བུ་ཕྲན་བུ་མ་འད་བ་ཏོག་ཙམ་ཡོང་གྱི་འདུག་ཁ་ཤས་ཐོག་ལ་ག་ཕོགས་ཀྱི་ཆ་ནས།",
    "འཕྲལ་དུ་ཁྱུ་གཅྱིག་ལ་བསྒྲྱིལ་རྒྱུ་དེ་ཏག་ཏག་ཅྱིག་ཡོང་གྱི་མྱི་འདུག་ལ།",
    "དེ་ནས་༩ པ་ལ་སྦུན་ཏར་ལ་དགེ་འོས་སོབ་ཁང་ནང་ལོ་གཅྱིག་གྱི་དགེ་འོས་གནང་བཞྱིན་པའྱི་དགེ་འོས་སོབ་མ་༢གསུངས་འདུག་བར་ལམ་ཕག་སེལ་ང་ག་཈ྱིས་ཕྱིན་པའྱི་སབས།",
    "ལན་འདེབས་པར་ལས་བསོམས་རྒྱས་པ་ཆ་ཚང་བཀླག་དགོས་པ་འདུག་དེ་ནས་སོན་མ་བོད་སོབ་འཛིན་ཚོགས་ནས་མཐོ་རྱིམ་སོབ་གྲྭ་ལ་ཨ་ཝ་༢ ལ་སོབ་ཡོན་ཡོད་པ་ཞྱིག་གོ་ཐོས་བྱུང་།",
    "དེ་ནས་ད་ལྟ་འདྱིར་སྱིན་བདག་ཁག་ཚང་མ་ལུང་དངས་གནང་འདུག་རྒྱབ་ལོགས་དེར།",
    "དྱི་བ་༢ ཆགས་ཀྱི་འདུག་དཱ།",
    "ལན་ཁོ་རང་ལ་ཆུ་ཚོད་གཅྱིག་འགོར་རྒྱུ་དེ་འད།",
    "ཡྱིན་ནའང་ཐུགས་མཁྱེན་པ་རྒྱས་པོ་ཆེན་པོ་དེ་ཚོ་འགོག་ཐུབ་ཀྱི་མྱི་འདུག་ཤོར་ནས།",
    "དེས་འགྱིག་གྱི་མྱི་འདུག་དུས་ཚོད་རྒྱས་བཅད་གནང་རོགས་གནང་ཞུ་རྒྱུ་ཡྱིན།",
    "དྭང་སོབ་ལའང་ཕེབས་མཁན་མྱི་འདུག་ཅེས་གསུང་སད་ཤོར་གྱི་འདུག་དེ་ཚོར་ཆ་བཞག་ནའང་ངེས་པར་དུ་ར་བའྱི་སྱི་འཐུས་ལྷན་ཚོགས་འཚམས་གཟྱིགས་སབས་སུ།",
    "དེ་བཙུགས་ནས་ད་ལོ་ཁོ་ཚོ་ཐོན་རྒྱུགས་ཀང་ཚང་མ་ཨང་དང་པོ་ལེན་འདུག་ཞུ་རྒྱུ་ཡྱིན།",
    "དེའྱི་ཐོག་འཕར་མ་སམ་བྷོ་ཉ་རང་གྱི་ཐོག་ནས་ག་ཏོང་དགོས་པ་དེ་འད་ཆགས་ཀྱི་འདུག་ཞུ་རྒྱུ་ཡྱིན།",
    "ད་དུང་ཡང་གྲུབ་འབས་ཐོན་མྱི་འདུག་ཞུ་རྒྱུ་ཡྱིན།",
    "ཁོ་ཚོ་རླངས་འཁོར་ག་དགོས་བྱེད་དུས་གོང་ཆེན་པོ་ཤོར་གྱི་འདུག་ཞུ་རྒྱུ་ཡྱིན།",
    "ཁོ་རང་རང་ནང་ལ་ཁོ་ཚོས་འོད་སེར་དེ་འད་བླུགས་པ་ཡྱིན་ན།",
    "ཡྱིན་ནའང་ཕ་གྱིར་འདྱི་བྱེད་ས་མྱིན་འདུག་གང་བྱེད་དགོས་པ་ཡྱིན་ན་བསམ་དུས།",
    "ང་ཡང་གཅྱིག་཈ོ་དགོས་ཀྱི་འདུག་གསུངས་བྱུང་།",
    "ལས་བསོམས་འདྱིའྱི་ནང་ལ་མ་སུ་རྱིའྱི་སོབ་གྲྭ་དང་དེ་འདའྱི་གནས་ཚུལ་གཅྱིག་ཀང་མྱི་འདུག་ལས་བསོམས་རྒྱས་པ་ནང་ཡོད་དམ།",
    "དེ་ནས་མ་སུ་རྱིའྱི་སོབ་གྲྭའྱི་སོར་ལས་བསོམས་ནང་ལ་མྱི་འདུག་གསུངས་པ་དེ།",
    "དེ་དང་ཆབས་གཅྱིག་དཔེ་མཛོད་ཐོག་འགན་ཁུར་ཆེན་པོ་ཞྱིག་ཆགས་ཡོང་གྱི་འདུག་ཁ་སང་ངས་སྙན་སེང་ཞུས་པ་བཞྱིན་དཔེ་མཛོད་ཀྱི་ལས་འགན་ཐོག་ལ་ཡྱིན་ནའང་འགྱུར་བ་ཞྱིག་འགོ་སྟེ།",
    "ཅུང་ཙམ་ཁ་ཤས་ལ་ཏག་ཏག་མ་ཡོང་བ་ཞྱིག་ཆགས་ཀྱི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡྱིན།",
    "མང་པོ་ཞྱིག་ལ་དོ་ཕོག་འགོ་མ་ཡོང་ངམ་བསམ་གྱི་འདུག་ར་སྟེང་བོད་ཁྱྱིམ་དེ་ཚོའྱི་ཁྱབ་ཁོངས་ནང་ངས་གོ་ཚོད་བྱས་པ་ཡྱིན་ན།",
    "འདྱིར་བཀའ་ལན་ཞྱིག་གནང་ཐུབ་ན་ཡག་པོ་འདུག་ཅེས་ཞུ་རྒྱུ་ཡྱིན།",
    "ཡྱིན་ན་ཡྱིན་པ་དང་མྱིན་ན་མྱིན་པའྱི་ཧ་ཅང་གྱིས་གསལ་པོ་གནང་གྱི་འདུག་བཅོས་མྱིན་གྱི་བསགས་བརོད་ཞུ་རྒྱུ་ཡྱིན།",
    "ཁྱེད་རང་བོད་པའྱི་སྱི་ཚོགས་ནང་ལ་ལས་ཀ་བྱེད་འདོད་མེད་དམ།",
    "དོན་ངོ་མ་འགན་འཁུར་ལན་འདེབས་བྱ་རྒྱུའྱི་ཚུལ་འཛིན་གྱི་མྱི་འདུག་སྙམ་པའྱི་ཚོར་སྣང་ཞྱིག་བྱུང་ཞེས་ཞུ་འདོད་བྱུང་།",
    "ཕོགས་མ་མཐའ་འདྱི་འད་ཞྱིག་ཟྱིན་དགོས་ཀྱི་འདུག་པས།",
    "དེ་འད་ཡྱིན་དུས་སབས་དེ་དང་ཚད་གཞྱི་ཞྱིག་བཟོས་གནང་འདུག་དེ་འད་ཡྱིན་དུས་དེ་འད་ཤུགས་ཆེན་པོ་ཞྱིག་སར་རྒྱུ་ལ་ཏན་ཏན་སེམས་ནས་བསམ་ན་ཡང་ལག་ལེན་ལ་འཁེལ་རྒྱུ་ཁག་པོ་ཡྱིན་བསད་མཁན།",
    "ལས་བསོམས་བསྡུས་པའྱི་ནང་དུའང་བལ་ཡུལ་སོབ་གྲྭའྱི་གནས་སྟངས་དེ་ཚོ་ཐེངས་ལྔ་ཙམ་ཞྱིག་ཡར་འཁོད་འདུག་ཡྱིན་ནའང་སྱི་འཐུས་རྒྱུན་ལས་ཀྱི་ཆབ་སྱིད་སེ་ཚན་གྱི་ལས་བསོམས་སྙན་ཐོའི་ནང་དུ་གང་ཡང་འཁོད་མྱི་འདུག་བྱས་ཙང་སབས་དེ་དུས་ཀྱི་ཤེས་རྱིག་བཀའ་བོན་དཔལ་ལྡན་སྱིད་སྐྱོང་མཆོག་དང་།",
    "ང་རང་ལ་དྱི་བ་གསུམ་ཡོད།",
    "བལ་ཡུལ་སོབ་གྲྭ་ཁག་ནས་འཛིན་རྱིམ་བཅུ་ག་཈ྱིས་ཐོན་པའྱི་སོབ་ཕྲུག་གྲངས་༡༥ ལ་སོབ་ཡོན་བགོ་འགེམས་ཞུས་ཡོད་གསུངས་འདུག་ངས་ད་ལྟ་དྱི་བ་ཞུ་རྒྱུར་བལ་ཡུལ་སོབ་གྲྭ་ཁག་ནས་ལོ་གཅྱིག་ལ་སོབ་ཕྲུག་བཅོ་ལྔ་ལས་ཐོན་གྱི་མེད་པ་དང་།",
    "གང་ལྟར་ཡར་རྒྱས་ཀྱི་ཕོགས་སུ་འགོ་སོད་ཀྱི་འདུག་ཅེས་ཞུ་རྒྱུ་འདྱི་ཡྱིན།",
    "སབས་དེར་འཕྲལ་དུ་གསུངས་ཆོག་ཆོག་ཅྱིག་མྱི་འདུག་སེ།",
    "དེ་འད་ཞྱིག་ཚོད་དཔག་གང་འད་གནང་གྱི་ཡོད་དམ་ཞེས་འདྱི་གཅྱིག་བཀའ་འདྱི་ཞུ་རྒྱུར་འདོད་པ་འདུག་དེ་བཞྱིན་གྱི་གཅྱིག་དེ་ཁ་སང་ངས་གོ་ནོར་ཐེབས་མེད་པ་ཡྱིན་ན།",
    "ང་རང་ལ་གང་ལྟར་འདྱིའྱི་ཐོག་ལ་སྒེར་གྱི་བསམ་ཚུལ་ཞྱིག་ཡོད།",
    "ང་རང་ལ་སེམས་འཚབ་ཡོད་སྟབས་གཅྱིག་ཞུས་པ་ཡྱིན་མ་གཏོགས།",
    "ར་བའྱི་ངས་ཐུགས་ཁུར་གནང་གྱི་མྱི་འདུག་ཞུ་ཡྱི་མེད།",
    "ཧ་ལམ་བརྒྱ་ཆ་ལྔ་བཅུ་ལྔ་བཅུ་བྱེད་ཀྱི་འདུག་བསམས་བྱུང་།",
    "འདྱིའྱི་ནང་དུ་གསལ་པོ་མེད་པ་ཞྱིག་གང་འདུག་ཅེ་ན།",
    "ཕྲུ་གུའྱི་ཤེས་ཚད་གོང་མཐོར་གཏོང་དགོས་པ་ལས་བརྒྱ་ཆ་ལོན་ཙམ་གྱིས་ཕན་ཐོགས་རྒྱུ་གང་ཡང་མྱི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡྱིན།",
    "ངས་འདྱིར་ཐོ་གཞུང་ཞྱིག་འཁྱེར་འདུག་སེ།",
    "སྤུས་ཚད་དེའྱི་སྒང་ལ་ཤུགས་མང་བ་བརྒྱབ་དགོས་ཀྱི་འདུག་སོན་མ་སོབ་མ་མང་པོ་ཡོད་དུས།",
    "སྤུས་ཚད་སྒང་ལ་ཤུགས་ངེས་པར་དུ་རྒྱག་དགོས་ཀྱི་འདུག་ཅེས་དེ་ཏན་ཏན་བསམ་བསད་ཀྱི་འདུག་འཆར་གཞྱི་བཞག་ཡོད་ཅེས་མར་སྙན་སེང་ཞུ་རྒྱུ་ཡྱིན།",
    "གྷོ་པལ་པུར་ཐོག་ལ་དམྱིགས་བསལ་དོ་སྣང་བྱེད་དགོས་ཀྱི་འདུག་གསུངས་པ་དེ་ཏན་ཏན་འགོག་ཐབས་དང་།",
    "ཡྱིན་ནའང་ཀ་རོར་སྒང་གསུམ་ནང་ལ་བྷོ་ཉྱི་ཡ་ཡྱིན་པ་མང་པོ་འདུག་ད་ལྟའྱི་ཆར་བོད་སོབ་འཛིན་ཚོགས་ཁོངས་ལ་བྷོ་ཉྱི་ཡ་ཡྱིན་ན།",
    "ལོ་འཁོར་འདྱིའྱི་ནང་བོད་རྱིགས་འདས་གོངས་སུ་ཕྱིན་པ་སྐྱབས་བཅོལ་ལག་དེབ་ཕྱིར་སོག་ཞུས་པ་གངས་༡ བྱུང་འདུག་༨།",
    "སར་མ་ལྔ་ནང་ཚུད་ལ་གསུང་ཐུབ་ན་ཡག་པོ་འདུག་ཞུ་རྒྱུ་ཡྱིན།",
    "ལྷག་པར་དུ་ད་བར་འབེལ་ཡོད་ལས་བྱེད་ཚང་མས་འགན་རང་འཁུར་གྱིས་ཕག་ལས་ཡག་པོ་གནང་བསད་པ་མཐོང་བསད་ཀྱི་འདུག་དེ་ཚོ་སྱི་ཡོངས་ཀྱི་བདེ་སྲུང་ལས་མྱི་ཚང་མ་ལ་བསགས་བརོད་ཞུ་རྒྱུ་ཡྱིན།",
    "དེ་ནས་ང་རང་གྱི་བསམ་ཚུལ་གཅྱིག་ཞུ་རྒྱུ་ཡོད།",
    "སབས་དེ་དུས་གང་གསུང་གྐྱི་འདུག་ཞུས་ན།",
    "ཡང་ང་དེབ་སེར་པོ་དེའྱི་གཅྱིག་ང་རང་གྱི་ངོ་ཤེས་པ་གཅྱིག་ད་ལྟ་ཁ་བྱང་སད་བཞག་པ་དེ་འད་གཅྱིག་བརྒྱུད།",
    "དེ་དུས་ང་རང་ཡར་བཅར་བ་ཡྱིན།",
    "ཁྱེད་རང་གྱིས་གཅྱིག་གསུང་རོགས་གནང་ཞུས་པ་ཡྱིན།",
    "ཡྱིན་ནའང་ལབ་ས་མྱིན་འདུག་དེ་ནས་མར་ཡོང་བ་ཡྱིན།",
    "དེ་སྱིར་བཏང་ནས་གཅྱིག་དེ་མྱིན་ནམ་བསམ་གྱི་འདུག་ཁ་སོན་཈ེ་ཆར་ར་རམ་ས་ལར་ད་ལམ་ནས་གནས་ཚུལ་བརྒྱུད་དེ།",
    "རོམ་དེ་གང་ཡྱིན་དང་སུས་བྱིས་པ་གསལ་པོ་བཀའ་མ་གནང་བ་ཡྱིན་པས་ཐག་ཆོད་པོས་ཞུ་ཐུབ་ཀྱི་མྱི་འདུག་ཡྱིན་ནའང་ད་ལོའི་ལོ་མགོར་ཡྱིན་ནམ་ན་ནྱིང་གྱི་ལོ་མཇུག་ལ་ཡྱིན་ནམ།",
    "ང་རང་གྱིས་དངོས་སུའང་རོགས་པ་བྱས་པ་དང་དཀའ་ངལ་འཕྲད་བསད་པ་དེ་འད་ཡོད་པ་ང་རང་གྱི་ངོ་ཤེས་པའམ་ངའྱི་སར་ཡོང་མཁན་དེ་འད་གང་ཙམ་ཡོད།",
    "དེ་འདའྱི་ཐོག་ནས་ཁོ་ཚོ་ལ་དཀའ་ངལ་གང་འཕྲད་ཀྱི་འདུག་ཞུས་ན།",
    "འཁྱིལ་ཐག་འཁོར་ནས་གཞན་དེའང་ཐག་མ་ཆོད་པའྱི་གནས་སྟངས་གཅྱིག་ཡོང་གྱི་འདུག་གནས་སོར་བའྱི་གནས་སྟངས་དེ་གཙང་མ་ཆགས་པ་ཡྱིན་ན།",
    "དེ་འདའྱི་སྐུ་ངལ་ཡོང་གྱི་ཡོད་པ་དེ་ཚོར་སྣང་ཡོང་གྱི་འདུག་ལ།",
    "དགེ་མཚན་གཅྱིག་ཡོང་བ་འདུག་ཅེས་འབོད་སྐུལ་ཞུ་རྒྱུ་ཡྱིན།",
    "ནང་མྱི་ཟླ་སྒྲྱིལ་ཞུ་མྱི་གངས་༩༤ བྱུང་བར་ཞྱིབ་འཇུག་མཆན་བཀོད་ཞུས་ཡོད་གསུངས་འདུག་དེ་དང་འབེལ་བ་ཡོད་པའྱི་ཐོག་ནས་དོགས་འདྱི་གཅྱིག་ཞུ་རྒྱུ་ཡོད།",
    "དེ་ལ་ཐབས་ཤེས་གང་ཡང་མྱི་འདུག་ཅེས་སྙན་སེང་ཞུ་རྒྱུ་ཡྱིན།",
    "ཡྱིན་ནའང་སྒྲྱིག་འཛུགས་དེའྱི་བྱེད་ཕོགས་ཐད་ལ་གཞན་དག་གྱི་གནས་སྟངས་ཞུ་ཐུབ་ཀྱི་མྱི་འདུག་འོན་ཀང་འབེལ་ཡོད་ཀྱིས་གནས་ཚུལ་མང་པོ་ཞྱིག་བཀའ་གནང་བ་དེ་ཚོ་ཚང་མ་རྒྱ་གར་གཞུང་གྱི་འབེལ་བ་ཡོད་ས་ཚང་མ་ལ་ཞུས་བསད་པ་ཞྱིག་དང་།",
    "བ་ཆེན་རྣམ་པ་ཚོས་གནང་གྱི་མྱི་འདུག་ཞུས་པ་ར་བ་཈ྱིད་ནས་མྱིན།",
    "དེ་ཡྱིན་དུས་ཚང་མར་གསལ་པོ་ཞུས་པ་ཡྱིན་ན་ཡག་པོ་འདུག་མ་གཏོགས།",
    "ཞྱིབ་འཇུག་ཚོགས་ཆུང་གྱི་གྲུབ་དོན་སྙན་ཐོ་དེ་བཀའ་ཤག་ལ་དུས་ཚོད་ག་དུས་འབྱོར་ཡོད་དམ།",
    "ང་རང་གྱིས་ཚོད་དཔག་བྱས་པ་ཡྱིན་ན།",
    "ཐུགས་ཁག་མེད་པ་འད་མཐོང་གྱི་འདུག་ཡྱིན་ནའང་གལ་སྱིད་གོས་ཚོགས་མ་ཚོགས་གོང་གྱི་ཟླ་བ་འགའ་ཤས་སོན་ལ་ཕེབས་ཡོད་པ་ཡྱིན་ན།",
    "ཟེར་བ་ཞྱིག་ཡོང་གྱི་འདུག་དེ་འད་གཅྱིག་ས་གནས་ཁག་ཚང་མར་གང་ཤེས།",
    "ལྡྱི་ལྱི་ལ་གལ་ཆེན་པོ་འདུག་དེའྱི་ཐོག་ནས་རྒྱ་གར་ས་ཆ་གལ་ཆེ་བ་ཆེ་བ་དེ་འད་ལ་གནང་ཐུབ་པ་བྱུང་བ་ཡྱིན་ན།",
    "ད་ལྟ་ཡྱིན་ནའང་མཐོང་དུས་དགའ་པོ་འདུག་ཡང་སེལ་ལད་འཁབ་ཀྱི་འདུག་ལབ་ན།",
    "ང་རང་གྱིས་རྒྱུན་དུ་ཧ་གོ་ཡྱི་ཡོད།",
    "དུས་ཐོག་དུས་ཐོག་ཐོ་གཞུང་དང་གནས་ཚུལ་གང་བྱུང་བར་ལྟ་རོག་ཡོང་རྒྱུར་དགེ་མཚན་མེད་དམ་བསམས་ནས།",
    "གང་ཡྱིན་ནའང་མྱི་ཆེད་བཙུགས་བྱས་ཏེ་དེ་ཚོ་ལ་རོག་ཞྱིབ་བྱེད་རྒྱུ་ངེས་པར་དུ་དགོས་འདུག་ཚང་མས་སྱི་ཚོགས་ཀྱི་ཐོག་ནས་གཞུང་འབེལ་མ་ཡྱིན་པའྱི་ཚོགས་པ་ཡྱིན་ནའང་།",
    "བཙོན་བཅུག་བྱས་འདུག་ཟེར་བ་དེ་ནོར་འདུག་བཀག་཈ར་བྱས་འདུག་ཞུ་རྒྱུའྱི་ཚིག་དེ་རང་ཡྱིན།",
    "ཁ་ནས་ལབ་སྟངས་ནོར་འདུག་དེ་དགོངས་སེལ་དང་སགས་ཕྱིར་འཐེན་གནང་རོགས་གནང་ཞུ་རྒྱུ་ཡྱིན།",
    "ངའྱི་སོག་ལ་཈ེན་ཁ་མཐོང་གྱི་འདུག་ན།",
    "གཞྱིས་ཆགས་དེ་ཚོ་མཐོང་སྟེ་ཡར་ལོག་ཡོང་བའྱི་སབས་ལ་ཧང་སངས་སངས་གནང་གྱི་འདུག་ལ་ཡྱིད་འཕྲོག་པོ་གནང་ནས།",
    "ད་ལྟ་ཕྱིན་པ་ཡྱིན་ན་ས་གནས་འགའ་ཤས་ནང་ལ་དེའྱི་གས་འགའ་ཤས་ད་དུང་ལྷག་བསད་འདུག་ལྷག་པ་ཙམ་མ་ཟད་ས་གནས་ཀྱི་གོས་ཚོགས་དང་རང་བདེན་ཚོགས་ཆུང་ནང་ལའང་ཐུགས་འགན་བཞེས་མཁན་དེ་ཚོའྱི་ནང་ལ་ཕེབས་བསད་པ་དེ་འད་འདུག་ཧ་ཅང་དགའ་པོ་བྱུང་།",
