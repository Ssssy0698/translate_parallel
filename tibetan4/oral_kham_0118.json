    "འགྲོ་འདུག་ལ་སོགས་པའི་སྤྱོད་ལམ་ཐམས་ཅད་གཞན་ལ་ཕན་པའི་བསམ་པ་དང་མི་འབྲལ་བའི་རྣལ་འབྱོར་གཅིག་པུས་ལམ་དུ་ཁྱེར་ཏེ།",
    "དེ་རང་ལ་འཛོམས་འདུག་ན་དགའ་བ་བསྒོམ།",
    "ཆགས་སྡང་སྤངས་ཤིང་དབེན་པ་བསྟེན་ནས་དལ་བར་བསྡད་དུ་ཕུང་པར་གདའ་བས།",
    "འདི་ཤིན་ཏུ་ངོ་མཚར་ཆེ་བར་གདའ་གསུངས། ཆ་",
    "ཞེ་འགྲས་པ་མེད་ཀྱང་རང་བཞིན་གྱིས་གནོད་པ།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "ཁོང་རང་ཡང་ངེས་ཤེས་སྐྱེས་ནས།",
    "ཕངས་པར་འདུག་གསུང་ནས་མ་གནང་།",
    "ད་ལྟའི་དུས་ལ་ཤིན་ཏུ་མང་ཞིང་ཕལ་ཆེར་འདི་ཁོ་ནར་འདུག་ཅིང་འབྱུང་ཡང་ཉེ་བས་རྟག་ཏུ་བག་གཟོན་བྱས་ཏེ་དྲུག་པོ་དེ་རྣམས་ཀུན་ཏུ་སྤང་བར་བྱའོ།",
    "པཏྟཾ་ཡང་བདག་གཅེས་འཛིན་ཇི་འདྲ་འདུག་བལྟ།",
    "དྲག་པོ་རྣམས་ཁ་འཇམ་འཁྲུལ་པའི་བདུད་ཀྱིས་བསླུས་ནས་གདའ།",
    "བདུད་ཀྱིས་བསླུས་ནས་གདའ།",
    "ལན་ཆགས་བུ་སྤེལ་གྱི་བདུད་ཀྱིས་བསླུས་ནས་གདའ།",
    "དགྲ་སྡང་གདོང་འཛུགས་བདུད་ཀྱིས་བསླུས་ནས་གདའ།",
    "ལར་བདུད་ནང་དུ་སོད་ན་ཕྱི་ནས་བདུད་མི་འབྱུང་སྟེ་བདུད་ངོ་མ་ཤེས་པ་ཁོ་ན་མང་བར་གདའ།",
    "ཀོ་ལོང་གཙང་བཙན་བས་དམ་པར་གདའ་སྟེ་ད།་",
    "ཞང་ཞུང་བ་བྱ་བ་གཉིས་ཡོད་དེ་གདན་ས་སུ་བྱེད་མ་འཆམ་འདུག་ཟེར།",
    "བདག་གཅེས་འཛིན་གྱི་འཁྲི་བ་གཏན་ནས་མེད་པ་གཅིག་བྱུང་བར་གདའ་སྟེ་རྒྱལ་སྲས་ཐོགས་མེད་པས།",
    "ཟབ་དགུའི་གདམས་ངག་ཐོས་ཀྱང་རང་རྒྱུད་མཚོ་གཏིང་རྡོ་བ་ལྟར་གྱུར་པའི།",
    "ཐུན་མཐར་ཚོགས་ཞིང་རང་ལ་བསྟིམས་ནས།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "རང་ཉིད་སེང་ཁྲི་ལ་འདུག་པ་དང་།",
    "གནས་ལྔའི་ལྕུག་ཕྲན་རྩེ་ལ་མ་ཚོར་ངང་ཕེབས་འདུག།",
    "སྟོབས་བཞིའི་ཁྲུས་རས་གཙང་མའི་བྱི་དོར་ལ་བརྩོན་དང་ སྲིད་པའི་དབུལ་བ་སེལ་ལ་དཀའ་རྒྱུ་རང་མི་འདུག།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "དེ་ཡང་བསྐལ་པ་འཇིག་དུས་ཀྱི་མེ་ལས་ཚ་ཞིང་།",
    "དེ་ཡང་རང་ཉིད་མངོན་མཐོ་དང་ཞི་བདེ་དོན་གཉེར་ཙམ་གྱི་ཆེད་དུ་སྐྱབས་སུ་འགྲོ་བ་ནི།",
    "ད་ལྟ་དེའི་ནུས་པ་བདག་ལ་མི་འདུག་ཀའ་བཀསཅ་ཆ་",
    "དྲང་པོར་འདུག་ལ་ཐུགས་སྒྲུབ་བར་ཆད་ཀུན་སེལ་གྱི་རིམ་པ་དང་པོའི་ཁྲིད་ལྷ་རྫས་མེ་ཏོགཡང་དག་ལྟོས།",
    "སྣོད་བཅུད་ལྷ་དང་གཞལ་ཡས་ཁང་དུ་གསལ་བ་ལས་མ་ཎི་པདྨེའི་སྒྲ་གྲགས་སྟོང་རང་བཞིན་མེད་པ་སྒྲོག་པར་བསམ་སྟེ་མ་ཎི་བགྲང་།",
    "མཁས་གྲུབ་དུ་མའི་འབྱུང་ཁུངས་ལྟ་བུར་གྱུར་པས་སྐབས་དེར་ཡང་རྒྱལ་བསྟན་ཡོངས་རྫོགས་འཛིན་སྤེལ་ནུས་པའི་སྐྱེས་བུ་དམ་པ་མང་རབ་ཅིག་ཡོད་འདུག་པར་མ་ཟད།",
    "གཟིམས་ཆུང་མཇལ་ཁའི་མཛད་ཐོ་རྒྱ་དེབ་ཁག་གཅིག་རང་འདུག་པ་དེར་ཞིབ་གསལ་འཁོད་པ་བཞིན་བྲིས་པར།",
    "དཔའ་ཐིང་ཞེས་པའི་ལུང་ཤུར་རྩྭ་ཆུ་ཤིང་གསུམ་འཛོམ་པ་ཞིག་ལ་ལྷ་ཁང་འདུག་པ་བརྒལ་ནས་རྒྱང་ཙམ་ཕེབས་ཟིན་ཀྱང་།",
    "ཨག་༣༥ན་ཚོམ་རིང་ཞིང་གཞོན་ཤ་ཆགས་པ་ཁོ་ནར་འདུག་པས་སྤ་ཤན་ངོ་མ་དང་ཁྱད་མི་འདུག་ཅེས་ཕེབས།",
    "ལོ་གྲངས་ཉིས་བརྒྱ་སུམ་བརྒྱ་ལོན་པ་འགའ་ཞིག་ཡོད་འདུག་ཀྱང་།",
    "སླེབས་བྱུང་ངམ་མ་བྱང་ཞེས་དྲིས་འདུག་པར།",
    "ཕྲན་ཚོ་ཡང་ངོ་ཚ་བ་ཞིག་འདུག་པས།",
    "དབུ་གུར་རྒྱ་ཁང་སོགས་བཞུགས་སྒྲིགས་གཟབ་གཤོམས་ཞུས་འདུག།",
    "ཕྱག་རྟགས་འབུལ་བཞེས་བཅས་གྲུབ་རྗེས་ཁྲིའུ་ཤིང་ལ་འདུག་ཏུ་བཅུག་ནས་དཀར་སྤྲོ་ཤིང་འབྲས་དང་།",
    "སྤིན་ཐུ་ཝང་ཁོ་རང་གཅིག་པུར་ནང་བཅར་གནས་ཚུལ་རྒྱས་བ་དང་།",
    "གང་ལེགས་འདུག་ཅེས་ཞུ་བ་གནང་།",
    "ཡིན་ཀྱང་ཚ་གྲང་སྙོམས་པོ་འདུག་ཅེས་ཞུ་བ་གནང་།",
    "མཚམས་འདི་ནས་མཛད་ལམ་འཕྲོ་ཅན་དུ་ལུས་འདུག་པས་ཞིབ་འགོད་མ་ཤེས་ཀྱང་།",
    "འགྲོ་བའི་དོན་དུ་སྐུ་ཉམས་སུ་བཞེས་དགོས་བྱུང་འདུག་པ་འདི་ཙམ་གྱི་བཀའ་དྲིན་ཡང་སྲིད་མཐའི་བར་དུ་འཁོར་དཀའ་བར་སྣང་།",
    "ཕྱོགས་ཕྱོགས་སུ་བརྟུལ་ཞུགས་སྔགས་པའི་ཆ་ལུགས་ཅན་ཁ་ཤས་ཚོགས་འཚོགས་ནས་འདུག་པར་ཁྱེད་རྣམས་ཞབས་བརྟན་གང་བྱེད་ཀྱི་ཡོད་ཅེས་དྲིས་པར།",
    "ཟོག་བདག་མེད་པར་ངོ་ཚབ་བྱམས་པ་ཟེར་བ་གྲྭ་གཟུགས་རྒྱ་གར་ཆས་སྤྲས་པ་ཞིག་འདུག་པར།",
    "དེ་ནས་ཚོང་བདག་ཁང་པར་ཕེབས་རྩིས་གནང་བར་སྒོ་འགྲམ་དུ་སྤྲེའུ་མི་ཚད་ཆེ་ཙམ་གསུམ་ཚིག་ཟའི་རྣམ་འགྱུར་གྱིས་བསྡད་འདུག་པར་ཕེབས་མ་ནུས་པ་ན།",
    "ཁྲག་ཀྱང་མང་དུ་འཛགས་འདུག་གཤིས།",
    "དེ་ནས་ལྷ་ལྡན་དུ་རྒྱ་བོད་ཞི་ཆིང་ལེགས་པར་འགྲིགས་ཏེ་ཨམ་བན་གཉིས་དཔུང་དང་བཅས་པ་རྒྱ་ཡུལ་དུ་ཕྱིར་ལོག་དུས་འཇམ་ཞོད་འཇགས་སུ་གྱུར་པ་ན།",
    "འབྲས་སྤུངས་པར་ཁང་དུ་བཞུགས་པའི་གསུང་རྟེན་ཁག་ལ་གོང་ས་ལྔ་པ་ཆེན་པོའི་སྐུ་དུས་པར་ཐོ་གསལ་འཁོད་ཀྱི་དཀར་ཆག་ཅིག་ལྗགས་སྒྲིགས་གནང་འདུག་ཀྱང་།",
    "ཞེས་གསུངས་པ་ལྟར་མཆོད་ཁང་རང་བཞེང་རྒྱུར་ཐུགས་གཏན་ཁེལ་དོན།",
    "སྒམ་འཆིང་སོགས་རང་རང་གཞུང་དོན་རུ་ང་མཛད་ཅིང་།",
    "རང་རང་ཕྱོགས་ཀྱིས་དགྲའི་གཉེན་པོ།",
    "མཇལ་དར་འབུལ་ལུགས་སོགས་རྒྱས་བསྡུས་མཐོ་༡༩༨ན་དམན་སྣ་ཚོགས་ཤིག་འདུག་སྟབས།",
    "ཁ་བཏགས་ཇ་མར་སོགས་གང་བྱུང་རང་དག་ཐོག།",
