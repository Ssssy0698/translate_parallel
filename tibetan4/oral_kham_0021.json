    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སའི་ཁམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཆུའི་ཁམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མེའི་ཁམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "ནམ་མཁའི་ཁམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མ་རིག་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འདུ་བྱེད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རྣམ་པར་ཤེས་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "མིང་དང་གཟུགས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྐྱེ་མཆེད་དྲུག་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཚོར་བའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་། ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "སྲེད་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ལེན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྲིད་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྐྱེ་བའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "རྒ་ཤིའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ནང་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཕྱི་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དྲན་པ་ཉེ་བར་བཞག་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྟོབས་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཀྱང་རང་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "བསམ་གཏན་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མཚན་མ་མེད་པ་དང་སྨོན་པ་མེད་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མི་འཇིགས་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཐམས་ཅད་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "གཟུགས་ཀྱང་རང་བཞིན་སྟོང་པ་བ་ཉིད་ཀྱི་ཕྱིར།",
    "ཚོར་བའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འདུ་ཤེས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འདུ་བྱེད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རྣམ་པར་ཤེས་པའང་རང་བཞིན་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "མིག་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རྣ་བའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྣའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ལྕེའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ལུས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཡིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "གཟུགས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྒྲའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དྲིའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "རོའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་། ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "སྣའི་རྣམ་པར་ཤེས་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ལྕེའི་རྣམ་པར་ཤེས་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སའི་ཁམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཆུའི་ཁམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མེའི་ཁམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ནམ་མཁའི་ཁམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མ་རིག་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འདུ་བྱེད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རྣམ་པར་ཤེས་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མིང་དང་གཟུགས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྐྱེ་མཆེད་དྲུག་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཚོར་བའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྲེད་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ལེན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྲིད་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྐྱེ་བའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "རྒ་ཤིའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ནང་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཕྱི་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་། ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དྲན་པ་ཉེ་བར་བཞག་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྟོབས་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "བསམ་གཏན་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སྨོན་པ་མེད་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "མི་འཇིགས་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "བྱམས་པ་ཆེན་པོའང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཐམས་ཅད་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རང་བཞིན་སྟོང་པ་ཉིད་མེད་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ལ་ཆགས་པ་མེད་དོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་། མེད་པའང་རང་བཞིན་སྟོང་པ་ཉིད་ལ་ཆགས་པ་མེད་དོ།",
    "འདུག་ན་འདུག་གོ་ཞེས་བྱ་བར་རབ་ཏུ་ཤེས་སོ།",
    "འགྲེང་བ་དང་འདུག་པ་ལའང་ཤེས་བཞིན་དུ་སྤྱོད་པ་ཡིན།",
    "དེ་ལྟར་སོ་སོར་ཕྱེ་ནས་འགྲེང་ངམ་འདུག་སྟེ་དེ་ལ་རབ་ཏུ་རྟོག་པ་དེ་བཞིན་དུ།",
    "འགྲེང་ངམ་འདུག་སྟེ།",
    "བདག་ནི་འདི་ལྟ་བུ་ཞིག་ན་འདུག་འདུག་གོ་མིང་ནི་འདི་ཞེས་བྱའོ།",
    "ཤེལ་དང་དངུལ་གྱི་ཁ་དོག་ཏུ་འདུག་པ།",
    "དངུལ་གྱི་ཁ་དོག་ཏུ་འདུག་པ་མ་ཡིན་ཏེ།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་གང་ཡིན་པ་དང་རང་བཞིན་སྟོང་པ་ཉིད་གང་ཡིན་པ་དང་།",
    "ཅེས་པ་དེ་ཡིན་ཞེས་བཀོད་འདུག་པ་དེ་དག་ནི་དོན་ལ་མི་གནས་པ་ཞིག་ཡིན།",
    "གཅིག་བསྡུས་རང་བཞིན་ལྡན་པའི་རིག་རྩལ་ཞིག་ཡིན་ཞེས་ཧ་ལམ་རྩོམ་རིག་ཅེས་པའི་གོ་དོན་དང་མཚུངས་པར་འགྲེལ་འདུག་པ་ལས་རྟོགས་ཐུབ།",
    "ཐ་ན་ལྷུག་རྩོམ་ཐུང་ངུ་ཞིག་ཡིན་རུང་རང་ཉིད་ཀྱིས་གསོག་འཇོག་བྱས་པ་མཐའ་དག་བེད་སྤྱོད་ཀྱི་ཡོད།",
    "རྩོམ་འབྲི་བའི་ཁྱབ་ཁོངས་ནི་རྩོམ་པ་པོའི་བསམ་གཞིགས་དང་རང་ངོས་ཀྱི་གཙོ་ཤུགས་ནུས་པ་འདོན་སྤེལ་བྱ་ཡུལ་ཞིག་ཡིན།",
    "དེ་ནི་ཚུར་སྣང་སྨྲ་བའི་བསམ་བློར་བརྟེན་དགོས་པ་དང་དེའང་རང་སྟོབས་དང་ངོ་བོ།",
    "བྲིས་ཤིག་ངེས་པར་དུ་བྲིས་ཤིག་བརྩམས་སྒྲུང་གཅིག་འདོན་མི་ཐུབ་ན་ཁྱེད་རང་ཐེངས་གཉིས་པ་བྲིས།",
    "ངོ་མ་བྱས་ན་ཁྱེད་རང་མང་ཙམ་འབྲི་དགོས།",
    "ཁྱེད་རང་ལྟོས་དང་།",
    "དྲི་ཞིམ་གྱི་ཁུ་བ་ལས་སྣོན་དང་སྙལ་བཟོ་བྱས་ནས་མངར་ཞིམ་ལྡན་པའི་སྦྲང་རྩི་བསྐྲུན་རྗེས་མི་རྣམས་ལ་ལེགས་སྐྱེས་འབུལ་གྱི་མི་འདུག་གམ།",
    "དེས་ན་ཁྱེད་རང་སྙན་ཚིག་རྩོམ་པའི་ཆ་རྐྱེན་མི་ལྡེང་བ་ཡོང་མི་སྲིད།",
    "༡ བོད་ལ་ཡིག་རྩོམ་ཐོག་མ་ག་དུས་བྱུང་བའི་ཐད་ལ་ཁྱེད་ལ་ལྟ་ཚུལ་ཅི་འདྲ་ཡོད་དམ།",
    "གདོད་མའི་རྒྱུ་ཆ་ནི་ཕྱི་ཡུལ་ཡིན་ལ་རྒྱུ་ཆ་དངོས་ནི་རྩོམ་པ་པོས་ལས་སྣོན་དང་བཙོ་སྦྱང་བྱས་ཟིན་པས་ཕྱི་ཡུལ་དང་རང་སྣང་ཡུལ་ཅན་གཅིག་གྱུར་བྱས་པ་ཞིག་ཡིན་ཏེ།",
    "ལ་ལུང་གང་ན་བདེ་སྐྱིད་མི་འདུག་ཀྱང་།",
    "དེ་དག་བདེན་མིན་ཅི་ཡིན་རུང་བསམ་གཞིགས་བྱེད་དགོས་པ་ཞིག་འདུག་གོ།",
    "བོད་ཀྱི་དེང་རབས་རྩོམ་འབྲིའི་གཞུང་ལུགས་ནང་ཐ་སྙད་འདིའི་འབོད་ཚུལ་སྣ་ཚོགས་ཤིག་འདུག་པ་སྟེ།",
    "དེར་ཇ་ཆང་དང་ཤ་སོགས་མང་པོ་སྟེར་གྱི་ཡོད་བཟོ་འདུག་ཅེས་སྨྲས་བྱུང་།",
    "གཏམ་རྒྱུད་ཀྱི་ཀྱག་ཀྱོག་རང་བཞིན་དང་རྦ་རླབས་ཀྱང་རང་བཞིན་དུ་ཐོན་པ་ཡིན།",
    "རང་ངོ་མས་མྱངས་པ་ཞིག་ཡིན་པའི་རྣམ་པ་བསྟན་དགོས་པས་དེས་ཀློག་པ་པོར་བདེན་པའི་རང་བཞིན་དང་རང་ངོས་ཀྱིས་དངོས་སུ་མྱངས་པའི་ཚོར་སྣང་སྦྱིན་ཐུབ།",
    "ངའི་འདོད་ཕྱོགས་ཀྱི་མཐོང་ལམ་སྨུག་པས་བཅད་འདུག་པ་ཤེས་མ་བྱུང་།",
    "ཁྱེད་ཀྱི་མདུན་ལམ་དེ་ཀྱག་ཀྱོག་དང་དྲང་བདེའི་ངང་མི་ཚེའི་ཤུལ་ལམ་གྱི་སྣེ་ལ་བརྐྱངས་འདུག་པ་མཐོང་བྱུང་།",
    "མཚོ་འགྲམ་གྱི་བྱེ་མ་ཕང་ཕུང་བརྡལ་བའི་ཁྲོད་ན་རི་དྭགས་དགོ་བའི་ཁྱུ་ཚོགས་ཤིག་རྔོན་པའི་མདེའུ་སྐད་ཐོས་པ་ལྟར་སྲོག་བསྡོས་ཀྱིས་མཆོང་རྒྱུགས་བྱེད་ཅིང་གདའ།",
    "འཁྲི་ཤིང་མཆོག་ཏུ་རྒྱས་ཤིང་མཛེས་པ་རྣམས་ནི་ཡིད་བཞིན་གྱི་མཚོ་དེ་བལྟ་བའི་ཕྱིར་འདུས་པ་ལྟར་འདུག་དེ་ལ་འདུས་པའི་རྨ་བྱ་དང་།",
    "བྱ་ཀ་ལནྟཀ་ལ་སོགས་པ་རྣམས་ནི་ཀུན་ཏུ་དགའ་བའི་གླུ་དབྱངས་ཀྱིས་བསྔགས་པ་བརྗོད་པ་བཞིན་དུ་འདུག་པ་དེར་ཕྱིན་པར་གྱུར་ཏོ།",
    "དར་ལྕོག་དང་དེ་བཞིན་རྒྱ་ཟོག་སྣ་ཚོགས་བཅས་འདུག་བར་སྐོར་ལྷོ་ཡི་ཁྲོམ་གཞུང་ཐོག་དཀར་ཡོལ་དང་།",
    "གོས་ཆེན་དང་དྲུའུ་རྩིའི་རིགས་བཅས་འདུག་དེ་ནས་ཁོ་གཉིས་ཀྱིས་བལ་པོའི་ཚོང་ཁང་ནང་བལྟས་པས་ཚོང་ཟོག་སྤང་དང་།",
    "ལམ་གཞུང་དེའི་རྒྱུད་དུ་ཁྲོམ་མང་པོ་བཏོན་འདུག་པ་དེ་དག་ནང་སྐུད་པ་སྒོ་ལི་དང་།",
    "དོན་དངོས་ཐོག་ཡིད་འགྱུར་ཐད་ཀར་མཚོན་པ་ནི་བགྲོ་གླེང་ནས་ཡིད་འགྱུར་མཚོན་པ་ཡིན་འདུག་༡ བྱ་བ་འདྲེན་པའི་ཁྲོད་ནས་ཡིད་འགྱུར་མཚོན་པ།",
