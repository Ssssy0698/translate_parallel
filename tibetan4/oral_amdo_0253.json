    "བདག་ནི་བར་སྐབས་དེར་ཤི་བའི་དུས་བྱེད་པར་འགྱུར་བར་མཐོང་ནས་དེ་མིག་མཆི་མས་གང་སྟེ་འདུག་པ་རྒྱལ་པོ་ཟས་གཙང་གིས་མཐོང་ནས་སྔང་ནས་ཚིགས་སུ་བཅད་དེ་སྨྲས་པ།",
    "སྐྱེས་པ་བུད་མེད་རྣམས་ཀྱིས་གང་ོམཐོང་ན།",
    "ག་ལས་བདག་གི་གཞོན་ིནུ་འཇིགས་པ་འམ།",
    "ཁྱོད་ཀྱི་མཆི་མས་བདག་ནི་འདར་བར་འགྱུར།",
    "དྲང་སྲོང་ཉོན་མོངས་མེད་ཀྱིས་ཀྱང་ཚིགས་སུ་བཅད་དེ་སྨྲས་པ།",
    "དྲག་པོའི་དུག་དང་སྦྲུལ་གྱི་དུག་རྣོན་དགི།",
    "གང་ཕྱིར་ཞི་བ་མི་འཐོབ་བདག་སྡུག་མོད།",
    "དྲང་སྲོང་ཉོན་མོངས་མེད་རྒྱུད་ཉོན་མོངས་པ་ཅན་གྱིས་བསམས་པ།",
    "ལྷ་ཁྱོད་ཡུན་རིང་པོ་ནས་ཀྱེ་མའོ་དྲང་སྲོང་ཉོན་མོངས་མེད་རྐང་ཁོ་ནས་སེར་སྐྱའི་གཞིར་ཞུགས་པར་གྱུར་ཀྱང་ཅི་མ་རུང་སྙམ་པའི་དགོངས་པ་བསྐྱེད་༧ པ།",
    "བདག་གིས་རྐང་གིས་སེར་སྐྱའི་གཞིར་ཞུགས་ཏེ་ད་ནི་རྐང་ཁོ་ནས་ཕྱིར་འབྱུང་གིས་ིཁྱོད་ཀྱིས་ལམ་བསྟར་བ་དང་།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་བློན་པོ་རྣམས་ལ་བསྒོ་བ།",
    "ཁྱེད་ཅག་གིས་བྱ་བ་དང་བྱེད་པ་གང་ཡིན་པ་དེ་བྱོས་ཤིག་ཅེས་དྲིལ་སྒྲོགས་ཤིག།",
    "གསེག་མ་དང་གྱོ་མོ་རྣམས་ིབསལ་ནས་ཙན་དན་གྱི་ཆུས་ཆག་ཆག་བཏབ།",
    "ཁྱེད་ཅག་གིས་བྱ་བ་དང་བྱེད་པ་གང་ཡིན་པ་དེ་བྱོས་ཤིག།",
    "༦༨ ༧ནས་དེ་ཉོན་མོངས་པའི་བློ་དང་ངན་གཡོའི་སྤྱོད་པས་རྒྱལ་པོ་ཟས་གཙང་བློན་པོའི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་བ་དང་།",
    "དེ་ལྟ་མོད་ཀྱི་ཤཱཀྱ་རྣམས་ཀྱི་ནང་དུ་བྱུང་བའི་གཞོན་ནུ་གང་ཡིན་པ་དེས་བདུད་རྩི་རྟོགས་པར་འགྱུར་ཞིང་།",
    "ཁྱོད་རབ་ཏུ་བྱུང་ནས་ཀྱང་རིགས་བརྗོད་པར་མི་བྱ།",
    "ཤར་གྱི་ཕྱོགས་སུ་ཁྱོད་འདུག་དང་།",
    "བཙུན་མོ་དང་ལྷན་ཅིག་གིས་དབྲོག་པར་བརྩམས་པ་དང་དེས་ཀྱང་མ་ནུས་སོ།",
    "འདི་རྣམས་ཀྱིས་བདག་གི་སྟོབས་ཉམས་ན་མི་རུང་གིས།",
    "མ་ལ་བདག་གི་མཛུབ་མོ་བཀུག་པས་གསེར་གྱི་གཞོང་པ་ནས་བཟུང་ངོ་སྙམ་ནས་དེས་མཛུབ་ིམོ་བཀུག་པས་གསེར་གྱི་གཞོང་པ་བཟུང་ནས་དྲངས་པ་དང་།",
    "གླང་པོ་ཆེ་ལྔ་བརྒྱ་པོ་དེ་དག་ཁ་ཕྱིར་བསྒྱུར་ཏེ་དྲངས་ནས་དེ་དག་གིས་ཀྱང་གསེར་གྱི་གཞོང་པ་དབྲོག་པར་མ་ནུས་སོ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་བསམས་པ།",
    "ཟ་བར་ལག་པ་གཉིས་ཀྱིས་ནི་གླང་པོ་ཆེ་སྟོང་ཐུབ་ཀྱིས་དེ་བས་ན་གཞོན་ནུའི་མིང་གླང་པོ་ཆེ་སྟོང་གི་སྟོབས་ཅན་ཞེས་གདགས་སོ་ཞེས་བཏགས་སོ།",
    "ཁྱེའུ་དང་རྩེད་མོ་དག་དང་ནི།",
    "དམག་དང་བཙུན་མོ་རྣམས་ཡིན་ནོ།",
    "འཇིག་རྟེན་ན་ནི་ཡི་གེ་འདི་ཙམ་སྤྱོད་ཀྱི་གཞན་ནི་བདག་གིས་མ་འཚལ་ཏོ།",
    "ལྷས་བྱིན་གྱི་མཐུ་སད་ཀྱིས་མ་ལ་བདག་གིས་ཀྱང་འདི་ལ་མཐུ་སད་པར་བྱའོ་སྙམ་ནས་མཇུག་ིམ་ནས་བཟུང་སྟེ་དྲི་མི་ཞིམ་པར་མི་འགྱུར་བར་བྱ་བར་མཐའ་ཡིན།",
    "འདི་ལྟར་བདག་ཅག་གིས་ཤིང་གང་དག་བཅད་པ་དེ་ཐམས་ཅད་ནི་འགྱེལ་ལ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་གཞོན་ནུ་མཚན་མཁན་རྣམས་ཀྱིས་ལུང་བསྟན་ཏོ་ཞེས་བྱ་བ་ིཐོས་སོ།",
    "བདག་ཅག་ནམ་མཁའི་ངོས་ལ་རྒྱུ་ཞིང་གླིང་བཞིརཕྱི་བཞིན་འདོང་གིས་འདི་ཁྱིམ་ཕུབ་ཅིག།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་སྨྲས་པ།",
    "གཞོན་ནུ་ལ་བུད་མེད་ཐམས་ཅད་བསྟན་ལ་འདི་གང་ལ་དགའ་བར་གྱུར་པ་དེ་ཆུང་མར་བླང་བར་ིབྱའོ།",
    "དེ་ནས་ཁ་ཅིག་གིས་སྨྲས་པ།",
    "ལྷ་གཞོན་ནུ་ནི་སྦྱིན་པ་ལ་དགའ་བས་རྒྱན་རྣམས་བུད་མེད་ལ་སྩོལ་དུ་སྩལ་ལ།",
    "དེ་གང་ལ་མགུ་བར་སྐྱེད་པར་གྱུར་པ་དེ་བཙུན་མོར་བླང་བར་བགྱིའོ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་སྨྲས་པ།",
    "དེ་ནས་བུད་མེད་ཐམས་ཅད་རང་གི་ཁྱིམ་གྱི་འབྱོར་པ་དང་མཐུན་པའི་ཆ་བྱད་དང་།",
    "ཤཱཀྱ་ིལག་ན་དབྱུག་པ་ཅན་གྱི་བུ་མོ་གྲགས་འཛིན་མ་ཞེས་བྱ་བ་གཟུགས་བཟང་བ་དང་།",
    "དེ་མ་སོང་ནས་ཤཱཀྱ་ིལག་ན་དབྱུག་པ་ཅན་གྱིས་སྨྲས་པ།་",
    "བུ་མོ་རྒྱན་མེད་པ་ནི་མ་ཡིན་མོད་ཀྱི།",
    "དེ་ཁོ་ན་བདག་གི་སྡུམ་ཐབ་ིལགས་སོ།",
    "བུ་མོ་གལ་ཏེ་དེ་ལྟ་ན་ཤིན་ཏུ་འགྲོ་དགོས་པས་སོང་ཤིག།",
    "ཤེས་ལྡན་དག་འདི་ནི་བུད་མེད་ཐམས་ཅད་ལས་ཁྱད་པར་དུ་༧འཕགས་པ་ཡིན་ཏེ།",
    "༣གཙང་གིས་གྲགས་འཛིན་མ་བུད་མེད་ཀྱི་འཁོར་ཉི་ཁྲི་དང་གཞོན་ནུ་ཤཱཀྱ་ཐུབ་པའི་བཙུན་མོར་བླངས་སོ།",
    "ཇི་ཙམ་ཉི་མ་མ་ཤར་བ་དེ་སྲིད་དུ་ནི་སེན་མོས་ཀྱང་གཅད་དུ་རུང་ལ།",
    "ཟས་གཙང་གི་ཡང་ཆུས་མ་རུང་སྟེ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་སྨྲས་པ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་ཁས་བླངས་སོ།",
    "འདུན་པས་འབབ་ཆུ་རོ་ཧི་ཀའི་འགྲམ་དུ་གཞོན་ནུ་རྣམས་ཀྱི་སྐྱེད་མོས་ཚལ་རེ་རེ་བརྩིགས་ནས་སྨྲས་པ།",
    "གཞོན་ནུ་དག་སྐྱེད་མོས་ཚལ་དུ་འདོང་།",
    "སྲིད་པ་གཞན་རྣམས་སུ་ནི་ཕལ་མོ་ཆེ་ཞིག་ཀྱང་བྱུང་ངོ།",
    "༣སྟེང་གི་ནམ་མཁའ་ལ་འཕངས་ཏེ་དུམ་བུ་གཉིས་སུ་ཆག་ནས་འབབ་ཆུ་རོ་ཧི་ཀའི་ཚུ་རོལ་གྱི་འགྲམ་དུ་དུམ་བུ་གཅིག།",
