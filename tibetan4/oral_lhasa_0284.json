    "འདི་གཉིས་ཀྱི་ནང་ན་འདི་ནི་ལེགས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཐ་དད་པར་དབྱེ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེའི་གནས་པ་དེ་ཉིད་ནི་ཟག་པ་ཟད་པར་འགྱུར་བའི་ཚུལ་བཞིན་ནོ།",
    "ལས་ཕུང་པོའི་ལྷག་མ་དང་བཅས་པའི་མྱ་ངན་ལས་འདས་པ་ལ་ཐུག་པའི་བར་དུ་ཡང་དག་པར་གཞོལ་བ་དང་།",
    "བདེ་བའི་དོན་དུ་ཡང་དག་པར་བརྩམས་པ་དང་།",
    "བསླབ་པ་གསུམ་པོ་འདི་དག་ནི་གཞི་དང་བཅས་པར་རིག་པར་བྱའོ།",
    "རྣམ་པར་གྲོལ་བའི་ཕུང་པོའི་ལྷག་མ་དང་བཅས་པའི་མྱ་ངན་ལས་འདས་པ་ནི་བསླབ་པའི་འབྲས་བུ་དང་པོའོ།",
    "བསླབ་པ་འབྲས་བུ་དང་བཅས་པ་དེ་དག་ཡང་དག་པར་འགྲུབ་པའི་ཚོགས་སུ་གྱུར་པ་ནི་ཉེས་པ་རྣམ་པ་བརྒྱད་ཀྱི་གཉེན་པོར་འདུ་ཤེས་རྣམ་པ་དགུ་འདྲིས་པར་བྱ་བ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "ཡང་སྲིད་པར་སྐྱེ་བའི་འདུ་བྱེད་ལ་འཆུམས་པ་དང་།",
    "ཉེས་པར་སྤྱོད་པའི་སྦྱོར་བ་དང་།",
    "སྨོན་ནས་ཚངས་པར་སྤྱོད་པ་ལ་གནས་པའོ།",
    "འདུ་ཤེས་འདྲིས་པར་བྱ་བ་རྣམ་པ་དགུ་གང་ཞེ་ན།",
    "འདུ་བྱེད་ཐམས་ཅད་ལ་ཉེས་དམིགས་ཀྱི་འདུ་ཤེས་འདྲིས་པར་བྱ་བ་དང་།",
    "མི་རྟག་པའི་འདུ་ཤེས་འདྲིས་པར་བྱ་བ་དང་།",
    "མི་རྟག་པ་ལ་སྡུག་བསྔལ་བའི་འདུ་ཤེས་འདྲིས་པར་བྱ་བ་དང་།",
    "སྡུག་བསྔལ་བ་ལ་བདག་མེད་པའི་འདུ་ཤེས་འདྲིས་པར་བྱ་བ་དང་།",
    "ཟས་ལ་མི་མཐུན་པའི་འདུ་ཤེས་འདྲིས་པར་བྱ་བ་དང་།",
    "མི་མཐུན་པའི་འདུ་ཤེས་འདྲིས་པར་བྱ་བ་དང་།",
    "ཡང་སྲིད་པར་སྐྱེ་བའི་ལས་བྱས་ཀྱང་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་མི་ཤེས་སོ།",
    "དེ་ལ་རྣམ་པར་བྱང་བ་ནི་རྣམ་པ་གཉིས་ཏེ།",
    "དེས་ན་ངེས་པར་འབྱེད་པ་མ་ཡིན་པ་ཞེས་བྱ་སྟེ།",
    "དེ་དེ་ལྟར་ཡང་ཐོག་མ་ཁོ་ནར་སྔ་མ་བཞིན་དུ་ལེགས་པར་གསུངས་པ་ནས་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའི་བར་དུ་འཐོབ་སྟེ།",
    "གཞན་ཡང་ཁ་ཅིག་ནི་སྔོན་ཚེ་རབས་གཞན་དག་ཏུ་གཅིག་ཏུ་ངེས་པར་ཕྱི་རོལ་སྤྱོད་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་རབ་ཏུ་བྱུང་ནས་ཀྱང་ལོག་པར་ལྟ་བ་ཁོ་ནར་འགྱུར་ཏེ།",
    "གང་ཟག་གསུམ་པོ་དེ་རྣམས་ཀྱི་ནང་ན་དང་པོ་ནི་སྔོན་འདིའི་རྒྱུ་ལ་སྤྱོད་པར་འགྱུར་ལ་ཚེ་འདི་ལ་ནི་སྔར་བག་མེད་པར་འགྱུར་བ་ལས་ཕྱིས་བག་ཡོད་པར་རིག་པར་བྱའོ།",
    "གང་ཟག་གཉིས་པ་ནི་སྔོན་འདི་དང་ཕྱི་རོལ་གཉིས་ཀའི་རྒྱུ་ལ་སྤྱོད་པར་གྱུར་ལ།",
    "ཚེ་འདི་ལ་ནི་གཅིག་ཏུ་ངེས་པར་བག་ཡོད་པར་རིག་པར་བྱའོ།",
    "གསུམ་པ་ནི་སྔོན་ཡང་གཅིག་ཏུ་ངེས་པར་ཕྱི་རོལ་སྤྱོད་པར་འགྱུར་ལ།",
    "ཚེ་འདི་ལ་ཡང་གཅིག་ཏུ་ངེས་པར་བག་མེད་པར་རིག་པར་བྱའོ།",
    "བཟློག་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ལ་དང་པོ་ནི་སྔོན་ཕྱི་རོལ་སྤྱོད་པར་གྱུར་ལ་ཚེ་འདི་ལ་ནི་སྔར་བག་ཡོད་པར་གྱུར་ནས།",
    "ཕྱིས་བག་མེད་པར་གྱུར་པར་རིག་པར་བྱའོ།",
    "གཉིས་པ་ནི་སྔོན་འདི་དང་ཕྱི་རོལ་གཉིས་ཀའི་རྒྱུ་སྤྱོད་པར་གྱུར་ལ།",
    "ཚེ་འདི་ལ་ནི་གཅིག་ཏུ་ངེས་པར་བག་མེད་པར་རིག་པར་བྱའོ།",
    "གསུམ་པ་ནི་སྔོན་གཅིག་ཏུ་ངེས་པར་ཕྱི་རོལ་གྱི་རྒྱུ་སྤྱོད་པར་གྱུར་ལ་ཚེ་འདི་ལ་ནི་གཅིག་ཏུ་ངེས་པར་བག་ཡོད་པར་རིག་པར་བྱའོ།",
    "ཚེ་འདི་ལ་རྣམ་པར་དག་པ་དང་།",
    "བདེ་འགྲོར་འགྲོ་བའི་ལམ་ལས་ཡང་དག་པར་འདས་པ་ལ་ནི་རྣམ་གྲངས་ལྔ་ཡོད་པར་རིག་པར་བྱ་སྟེ།",
    "རྣམ་པར་འཚེ་བ་དང་།",
    "མི་མཐུན་པར་སྤྱོད་པ་ཡན་ཆད་གང་ལ་གནས་ན་མི་སྡུག་པ་དང་།",
    "དེས་ན་བདག་ཉིད་ཤེས་པར་འགྱུར་ཏེ།",
    "ཕྱི་མ་ལ་སྲོག་གཅོད་པར་འགྱུར་ལ།",
    "མི་མཐུན་པའི་བར་དུ་སྤྱོད་པར་འགྱུར་ལ།",
    "འཕགས་པ་ཉན་ཐོས་དེའི་ནི་བདེ་འགྲོར་འགྲོ་བའི་ལམ་ལས་ཡང་དག་པར་འདའ་བར་བྱ་བ་ལུས་ཏེ།",
    "འཕགས་པ་ཉན་ཐོས་དེ་ནི་དེ་ཙམ་གྱིས་ཆོག་པར་མི་འཛིན་པར་གོང་དུ་ཟག་པ་ཟད་པར་བྱ་བའི་ཕྱིར་འདུན་པ་བསྐྱེད་ཅིང་ཆེད་དུ་གཏད་ནས་སེམས་སྐྱེད་པར་བྱེད་དེ།",
    "གལ་ཏེ་དེ་ལ་ཡང་དེ་ཉིད་ཉེས་དམིགས་ཡིན་པར་ཡང་དག་པར་མཐོང་ནས་བཏང་སྙོམས་དེ་རོ་མྱོང་བར་མི་བྱེད་ན་ནི་དེ་ཚེ་འདི་ལ་ཀུན་ཤེས་པའི་ཕུང་པོའི་ལྷག་མ་དང་བཅས་པ་ལ་བརྟེན་ནས།",
    "དེ་ལ་གསལ་བའི་རྣམ་གྲངས་སྔ་མ་ཤོས་ཀྱིས་ནི་ངན་འགྲོར་འགྲོ་བའི་ལམ་ལས་ཡང་དག་པར་འདའ་བར་རིག་པར་བྱའོ།",
    "ཡང་དག་པར་འདའ་བ་དང་།",
    "མྱ་ངན་ལས་འདས་པའི་རྣམ་གྲངས་བཞིས་ནི་བདེ་འགྲོར་འགྲོ་བའི་ལམ་ལས་ཡང་དག་པར་འདའ་བར་རིག་པར་བྱའོ།",
    "དེ་དག་གཉིས་ལས་འཕགས་པ་ཉན་ཐོས་ཀྱིས་སེམས་ཡོངས་སུ་དག་པར་བྱའོ།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་སྟེ།",
    "ཕྱིར་ཡང་སྲིད་པར་སྐྱེ་བའི་གཉེན་པོའི་ལམ་བསྒོམས་པས་གཟུགས་ཀྱི་འདོད་ཆགས་དང་བྲལ་བར་བྱས་ནས།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ཀྱི་བར་དུ་སྙོམས་པར་འཇུག་སྟེ།",
    "དེ་ལ་འཕགས་པའི་རྣམ་པར་གྲོལ་བ་ཞེས་མི་བྱའོ།",
    "དེ་བས་ན་འཕགས་པའི་རྣམ་པར་གྲོལ་བ་ཞེས་བྱའོ།",
    "འཕགས་པའི་རྣམ་པར་གྲོལ་བའོ།",
    "འཇིག་རྟེན་འོག་མ་གང་ལས་འདོད་ཆགས་དང་བྲལ་བར་འགྱུར་བ་དེའི་མི་རྟག་པ་ལ་སོགས་པའི་རྣམ་པས་སུན་འབྱིན་པར་བྱེད་པ་ནི་ཟིལ་གྱིས་གནོན་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ནི་ཡིད་ཀྱི་གནས་སུ་རིག་པར་བྱའོ།",
    "དེའི་རྣམ་པར་ཤེས་པ་དེ་མི་གཡོ་བའི་སྐྱེ་མཆེད་དུ་སྐྱེ་བར་འགྱུར་ཏེ།",
    "ས་འདི་རྣམས་ལས་རྒྱུ་གསུམ་གྱིས་མི་གཡོ་བར་རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "བསམ་གཏན་གཉིས་པ་དང་གསུམ་པ་རྣམས་ལ་ནི་གོང་ནས་གོང་དུ་གཡོ་བ་སྤངས་པའི་ཕྱིར་མི་གཡོ་བར་རིག་པར་བྱའོ།",
    "ཅུང་ཟད་ལ་དམིགས་པའི་སྙོམས་པར་འཇུག་པ་དེ་དག་ཐམས་ཅད་ཀྱང་གོང་ནས་ཡོད་པའི་འདུ་ཤེས་ཀྱི་སྙོམས་པར་འཇུག་པ་ཡིན་ནོ།",
    "གོང་ན་མེད་པའི་འདུ་ཤེས་ཀྱི་སྙོམས་པར་འཇུག་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ཡན་ཆད་ནི་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ཀྱི་སྙོམས་པར་འཇུག་པ་ཡིན་ཏེ།",
    "གཟུགས་ཀྱི་འདུ་ཤེས་དང་མི་གཡོ་བའི་འདུ་ཤེས་ནི་ས་འོག་མ་ཐམས་ཅད་ལ་སུན་ཕུང་ནས་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་སྟེ།",
    "ཟག་པ་མེད་པའི་ལམ་དེ་ལ་ཡང་འདུ་ཤེས་ཀྱི་སྙོམས་པར་འཇུག་པ་བཞིན་དུ་གོང་ན་ཡོད་པ་དང་།",
    "དེ་ལ་གོང་ན་ཡོད་པ་ནི་མི་རྟག་པའི་རྣམ་པར་དང་ལྡན་པའོ།",
