    "ཅི་གསུངས་ཐོས་བསམ་ཉུང་ནས་གདའ།",
    "ནགས་ཁྲོད་དབེན་པར་བཀོད་ཅེས་གདའ།",
    "གཞོན་ནུ་དེ་ལ་གནས་པར་གདའ།",
    "མི་ཆེན་མང་པོ་འདུག་ཅེས་ཐོས།",
    "དེ་ལྟར་ང་ལ་འབོད་མཁན་གདའ།",
    "དེ་ཐོབ་ཙམ་ལས་མི་གདའ་བ།",
    "གཟུགས་བརྙན་མང་པོ་འདི་འདྲ་གདའ།",
    "ཡང་ལན་ཅིག་བལ་བོར་བྱོན་ཙ་ན།",
    "ད་འོ་སྐོལ་གྲོགས་མཆེད་དུ་འདུག་དྲོ་ལ་བྱོན་གསུངས་ནས་ནང་དུ་ཁྲིད་དེ་ངོ་གནང་།",
    "ཡུལ་དེའི་ཡོན་བདག་ཕྱུག་པོ་ཅིག་འདུག་ང་ལ་ནོར་ཅིག་ཞུ་བྱས་པས།",
    "ཞེས་ཁྲུས་ཀྱི་རྣམ་འགྱུར་བྱེད་ཅིང་འདུག་ནས།",
    "གཞན་སྣོད་ལྡན་མི་གདའ་བས།",
    "བཙུན་ཆུང་ཆུང་ཆུང་དེ་ཆིབས་སྣ་བཞག་ནས་བང་རང་སྟེ་བཏང་ནས།",
    "འདིའི་བསྙེན་པའི་དགེ་སློང་ང་རང་མིན་པ་གཞན་གྱིས་མི་འོང་ཕྱོགས་གཉིས་ཇོ་བོ་ཡབ་སྲས་ཀྱིས་འཐེན་ནས་མཆི།",
    "དོ་ཞག་རྨི་ལམ་ན་ཕ་རྒན་ཁོང་རང་གསུང་ཅག་འབྱོན་གྱིན་གདའ་ཙ་ན་ཁས་བླང་འཚལ།",
    "ད་ལྟ་སྐུ་བསོད་ཀྱི་རྣམ་གཡེང་ཅིག་ཆེ་ཞིང་འདུག་པ་དང་།",
    "རྣམ་པ་གཅིག་ཏུ་བཙུན་ཆུང་འདི་ཡང་གཞོན་ནས་འདུག་པས།",
    "དེ་ལ་འདི་ནས་ཞག་གསུམ་ལྷུང་བ་ཅིག་བྱོན་དགོས་པར་གདའ་སྟེ།",
    "ཁྱེད་རང་གསུང་བ་བཞིན་དུ་བགྱི་གསུངས་པས།",
    "ལན་གཅིག་ཕྱག་ལ་ལ་བྱོན་ཙ་ན།",
    "ཁྱེད་དག་མགོན་པོ་དྲི་མ་མེད་པའི་དྲུང་དུ་རིང་ནས་གདའ་སྟེ།",
    "དེ་ནས་ཚོང་པ་བརྒྱ་སྒོར་ཅིག་ཉི་མ་ཤར་བ་དང་ལ་ལ་འཇོག་ཅིང་འདུག་ནས།",
    "ཞང་སྟོན་ངེད་ལ་བསྟན་མ་ཟེར་ཞིང་མ་འདུག་གམ།",
    "ཁོ་ཁྱེལ་ཅིག་ལ་གཉེ་བྱས་ནས་སྨེ་བ་དེ་ལ་ལག་པས་རང་རང་འཕྲུག་ཅིང་འདུག།",
    "དེ་ནས་ཁོའི་སྨེ་བ་དེ་མི་འདུག་པ་མཐོང་གཞན་ཅི་ཡང་རྟོགས་པ་མེད།",
    "དིང་སང་ནི་ཁོ་བོ་ལ་རྒྱལ་པོའི་ཆ་ལུགས་སུ་བསྟན་ནས་གདའ་ཞུས།",
    "རྟེན་དཀར་པོའི་ཆ་ལུགས་སུ་མཛད་ཅིང་གདའ་ཞུས།",
    "སྐུ་མཉེན་ལ་གཞོན་པ་མཛེས་པ་ཅིག་མཛད་ནས་གདའ་འོ།",
    "འདིས་བཀའ་གདམས་པ་འོང་བ་ཅིག་འདུག་སྟེ།",
    "གདམས་པ་བསྟན་སྟོན་མི་གདའ་སྐད།",
    "གཅིག་ཀྱང་གཞན་གསེར་གྱི་ཕྱིར་གདམས་ངག་ཅུང་ཟད་ཀྱང་མི་སྟོན་པ་ཅིག་འདུག་ཡིན་ན་བཙུན་ཆུང་མགོ་བསྐོར་ནས།",
    "ད་ལུང་བ་སྟོང་བ་ན་ཕར་འགྲོ་བས་དེ་དུས་བརྒྱགས་ཕྱེ་ཆད་ན་ཁྱེད་རང་འོ་བརྒྱལ་གསུང་།",
    "ཁྱེད་རང་གར་གཤེགས་པ་དེ་རང་ཡང་འགྲོ།",
    "འོ་སྐོལ་བཀའ་གདམས་པའི་དཔོན་སློབ་ཡིན་ཙ་ན།",
    "ཉ་ར་ཡུན་རིང་མཛད་ནས་གདའ་སྟེ།",
    "ཨོཾ་ཀཾ་ཀ་ཎི་ཀཾ་ཀ་ཎི་ཟེར་ནས་ཞལ་ནག་ཐོམ་མེ་བཞུགས་ནས་གདའ།",
    "ཞང་སྟོན་བཞད་ཅིང་བཞུགས་ནས་འདུག་འཕྲོ་ལ་ཞལ་ནས།",
    "དོ་ཞག་བསྙུང་བ་མི་གདའ་འམ་ཞུས་པས།",
    "ན་ཚ་མི་གདའ་སྟེ།",
    "སླེབས་ནས་གདའ་སྟེ་མི་འགྱོད་སྤྲོ་དགའ་བཅས།",
    "རི་མཐོ་བ་གདའ་སྟེ་ཁོ་བོ་ལ་ལྗིད་མི་མཆི།",
    "དེ་རིང་ནགས་ཀྱི་ལོགས་ན་འོད་མང་པོ་ཅིག་གདའ་འ་སྟེ་ཅི་ཡིན་ནམ་ཟེར་ནས།",
    "ཡང་ནངས་པར་དུས་དེ་ཙམ་ལ་བལྟར་བྱོན་ཙ་ན།",
    "ཤུལ་ན་མེ་ཏོག་དཀར་པོ་ཐོར་ཆུང་ཙམ་པ་ཅིག་ཀྱང་སྐྱེས་ནས་གདའ།་",
    "གནས་གསུམ་གྱི་ཐད་ཀ་ཐད་ཀ་ན་ཡིག་འབྲུ་གསུམ་གསུམ་ཡང་གདའ།",
    "ད་ལྟའི་བཙུན་པ་འཚོར་བྱེད་པ་མཐོང་ཙ་ན་བྱིས་པའི་ཁྱེར་ཀ་ཆེན་པོར་གདའ།",
    "བྱིས་པའི་ཁྱེར་ཀ་ཆེ་བར་གདའ།",
    "དེ་དུས་སུ་སྐད་སྙན་པོས་ཉིན་པར་གསལ་དག་སྙན་གསུམ་དུ་བཀླགས་ཙ་ན་རྒན་གཞོན་མེད་པར་དད་ནས།",
    "བཟའ་ཚོ་ཐམས་ཅད་བསྙེན་གནས་བསྲུང་ཙ་ན།",
    "དེ་ནས་བཞུ་མཁན་གྱི་དྲུང་དུ་དགེ་སྦྱོར་ཅིག་བྱེད་ཀྱིན་བསྡད་ཙ་ན།",
    "འབྲོམ་གྱིས་འདི་ཞུས་བྱ་བ་ཞུས་ལན་དུ་ཁྲིག་ཁྲིག་པ་ཅིག་འོང་ཐོང་བར་གདའ་སྟེ།",
    "འོ་སྐོལ་རྩམ་པ་ཉུང་བ་གཉིས་ལས་མི་གདའ་བ་གསུང་།",
    "འདིའི་ཁྱེའུ་དཀར་པོ་འདི་ཀུན་མི་ཉན་པར་འདུག་ཁྱེད་ཀྱིས་ད་དུང་འཐུད་ལ་ཞག་གསུམ་སྒྲུབ་པ་མཛོད།",
    "དགེ་སློང་སྣོད་ལྡན་མི་འདུག་ན་ཆིག་སྒྲུབ་བྱས་ཀྱང་བཏུབ་པ་ཡིན།་",
    "ཞལ་གྱི་དཀྱིལ་འཁོར་ལྷམ་མེ་འདུག་པ་དེ་ནི་མཐོང་།",
    "ད་ནི་ནངས་པར་ནས་ང་རང་གཅིག་པུ་ཧྲེང་ཧྲེང་བ་ཅིག་འོང་སྙམ་གཞན་ནི་ངག་ཏུ་མ་ཐོན།",
    "ཁྱེད་རང་ཡང་ཏིང་ངེ་འཛིན་གྱི་དམིགས་པ་གྱིས།",
    "སྐུ་ལ་འགྱུར་བ་མེད་པར་སྤྱན་ཟི་མེ་འདུག་དེ་ཉིད་ལ་ཞག་གསུམ་ཐར་བསྐྱངས་ནས་སྒྲུབ་པ་བགྱིས།",
    "ཤུལ་ཅིག་ཀྱང་མི་གདའ།",
    "ཚེམས་ཉི་ཤུ་རྩ་བརྒྱན་ཅུག་གེ་སྤུངས་འདུག་ནས་དེ་རྣམས་ལ་བལྟས་པས།",
    "རིང་བསྲེལ་ཁ་དོག་མང་པོ་ཁྲོམ་མེ་འདུག།",
    "སློབ་དཔོན་ནམ་རིན་ཁོང་རང་གུང་ལ་བཞུགས་ནས།",
    "མི་ཡེ་མི་འདུག་སྟེ།",
    "ལོག་ནས་སློབ་དཔོན་པའང་རྫུན་གསུང་ཐར་འདུགབསྐོར་བ་མ་སུ་ཡང་མི་འདུག་ཞུས་པས།",
    "སྟབས་ཀའི་འབུམ་པ་འདིའི་གསེར་ཏོག་མི་འདུག་པ་ཅིག་དང་།",
    "དེ་ནས་ཀྱང་སྟོང་གོག་གེ་བ་ཅིག་འདུག་པ་རྨིས་ཅི་ཡིན་ནམ་གསུང་སྟེ།",
    "ནོམ་མཁའ་ལ་འཇའ་ཚོན་འདུག་གམ་མི་འདུག་གསུང་།",
    "ཁོས་མང་པོ་གདའ་ཞུས་པས།",
    "༩ ནཡར་ལམ་ལ་རྒྱུ་དགོན་དུ་ཕྱིན་ནས་སློབ་དཔོན་པ་ཅན་དུ་བྱོན་དགོས་པར་གདའ་ཞུས་པས།",
    "སློབ་དཔོན་ནམ་རིན་པ་སྐུ་འབུམ་ལ་བསྐོར་བ་མཛད་ཅིང་འདུག་ནས།་",
    "ད་རྒྱ་ལ་ང་གུམ་སྲིད་ཀྱང་ཁྱེད་རང་རྣམས་རང་ས་ནས་བཙུན་ཚུགས་ལ་རྩལ་དུ་འདོན་པ་གལ་ཆེའོ།",
    "ན་ཚ་མི་དགོས་པར་གདའ་བས་འཆི་ངེས་སྟེ།",
    "ཁྱེད་རང་རྣམས་ཀྱང་ང་པད་འདབ་ཀྱི་ལེགས་པ་ལྷོ་རུ་ཞོག་ལ།",
    "ནངས་པར་ནམ་ལངས་ལ་ཁད་ཙ་ན།་",
    "སྐྱེས་པའི་ཐ་མ་འཆི་བར་གདའ་འོ་སྐོལ་དག་པའི་སྣང་བ་ཡུན་རིང་ངོ།",
    "ཐམས་ཅད་ཀྱིས་ནགས་ལ་བཞད་གད་ཐེག་གེ་ཕྱིན་ཙ་ན།",
    "ངེད་ཀྱང་ད་གཟོད་འཆི་ཙ་ན་འདི་ཁོ་ན་བཞིན་དུ་གྱུར་ཅིག་ཟེར།",
    "དབུ་ཐོད་དང་ཕྱག་ཞབས་ཀྱི་རུས་པ་འདྲ་འདུག་ནས་སྤྱན་དྲོངས་ཏེ།་",
    "ཉིང་ཆུང་གང་བྱུང་ནས་ཁོ་རང་ལ་འབྲེལ་ཡོད་རྣམས་ལ་བཀྱེ།",
    "ཁྱེད་རང་ཡང་ཐིག་ཡེ་རྫོགས་པ་ཅིག་ཞུས་གསུངས་ནས།",
    "འབྲོམ་ལ་གསོལ་བ་འདེབས་ཤིང་གདའ་འོ་དགོངས་པར་ཞུ་གསུངས་པས།",
    "ཆུ་དང་གཉེར་མའི་ཚུལ་དུ་གདའ་འོ་རྗེ།",
    "འཆི་བར་འདུག་སྙམ་ཟུག་རྡུ་ལྡང་།",
    "ཁྱི་ཕག་སྤྱོད་པ་བ་གླང་བརྟུལ་ཞུགས་ཉམས་ནས་གདའགདའ།",
    "ནུབ་ནས་གདའ།",
    "མི་གཙང་རྐྱལ་བུ་རལ་ནས་གདའ།",
    "སྒོམ་ངན་སྐྱུགས་ཕུང་བོ་འཐོར་ནས་གདའཤིང་ཆག་ནས་གདའ།",
    "གཙང་དང་མི་གཙང་རང་གྲོལ་བའི།",
    "ཧ་དཔྱད་ན་མི་གདའ་ཇི་ལྟར་ལགས།",
    "༦ད་ནི་གང་ནའང་བར་ཆོད་དང་རྐྱེན་ངན་པ་མི་གདའ་བས།",
    "རྒྱལ་བ་ཡབ་སྲས་ཀྱི་ཐུ་བོ་ང་རང་ཡིན་སྙམ་པ་འཁྲུངས་ཏེ།",
    "ད་གཟོད་ཕ་མི་བཞུགས་ཙ་ན་ང་འདི་ལྟ་བུ་སུ་ལ་ཞུ་སྙམ་པ་དང་།",
    "ཞེས་ལྷ་དང་རང་གཞན་འགྲོ་བ་ཐམས་ཅད་ཀྱིས་འུར་བ་བཟླས་ཤིང་།",
    "གཞན་ཡང་རང་ཉམས་སུ་ལེན་པར་སྤྲོ་བའི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུའི་རིགས་ཐམས་ཅད་ཀྱང་འདིར་སྒོམ་ཞིང་དེའི་སྔགས་བཟླས་པར་བྱའོ།",
