    "དེ་ནས་ལ་སྟོད་ཚོ་བཞིར་སླེབ་ཙ་ན།",
    "ཐོད་པའི་རྫས་ཆིལ་ཆིལ་ཁོང་ཞིང་འདུག་ནས།",
    "སེམས་དངོས་པོའི་འདུག་ཚུལ་གཏན་ལ་ཕབ་བོ།",
    "ཤེལ་གྱི་ཕ་བོང་དཀར་པོ་ཞིག་ལ་ནཱ་རོ་པའི་ཞབས་རྗེས་སྤུ་ཤད་དང་རྣལ་ཪིས་ཚུན་ཆད་མ་ཉམས་པར་འདུག་པ་མཐོང་།",
    "དེ་ནས་ཡང་གངྒཱའི་ཚུ་ཀའི་འགྲམ་པ་ལིངས་དྲ་ཞེས་པ་དེར་རྟོལ་བས་ངུཞིག་ཤིང་ཏོག་བསྲུང་ཞིང་འདུག་སྐད།",
    "ངའི་མ་ལ་སློངས་ཟེར་ནས་མ་སྦྱིན་པས་མ་དེ་ནི་ཛོ་ཀི་ནི་གཅིག་འདུག་པས།",
    "དེ་ནས་བལ་པོ་མཐིལ་དུ་སླེབ་ཙ་ན།",
    "སིད་ངྷི་སྟེར་བ་ཡིན་པ་ལ་འདི་རྣམས་འཇིགས་ཤིང་འདུག།",
    "ཅུང་ཞིག་ཙམ་ན་ཁོང་རང་བཞེངས་ནས་མཆིལ་པ་སྦྱར་གྱིས་ཤི་སྟེ།",
    "ཕུག་དོན་ལྷེབ་ལྷེབ་འཕུར་ལ་ཁད་ནས་འདུག་པས།",
    "དེར་ལ་ཆིངས་ཀྱི་བསམ་པ་ལ་འོ་ན་སྤྲུལ་པར་འདུག་པས་མར་པ་ལོ་ཙཱ་བ་རང་ཅན་དུ་འགྲོ་བ་ལས་མེད་སྙམ་ནས་ལོག་ནས་བྱོན་པས་གྲོངས་པ་དང་གཉིས་ཁ་ཐུག་གསུང་།",
    "ཐ་ན་གླང་སྒ་གཅིག་ལུས་ནས་འདུག་པ་ལ།",
    "ནང་ཆ་སློ་མ་གང་དང་མགོ་བོ་དང་ཁྱེར་ནས་འོངས་ལས་ཀ་གྲུབ་ནས་འདུག་རྒྱགས་ལྷག་ཞིག་འདུག་གམ་གཏང་རག་བཏང་དགོས་གསུང་།",
    "ང་མཁའ་འགྲོ་མ་དགའ་བའམ་ཇི་ཙུག་ཡིན་ནམ་ངས་མི་ཚུད་འདུག་པས།",
    "རྒྱབ་བསྟན་པས་རྡོ་སྐྱེད་སྐྱེད་ནས་སྒལ་པ་ཆེན་པོ་བྱུང་ནས་འདུག་སྐད།",
    "རྔོག་ཅན་དུ་བྱོན་པས་མར་མེ་བལྟམས་ནས་བལྟ་རྟོག་དང་ཡི་གེ་འབྲི་བ་ལགས་པ་བྱེད་ཀྱིན་འདུག།",
    "མེས་ཚོན་པོ་ཡང་སྒོམ་ཞིང་འདུག།",
    "དགོང་ཀ་ཞིག་མར་མེ་ལྟམ་ནས་དབུའི་སྟེང་དུ་བཞག་ནས་བསྒོམས་པས་ནམ་ལངས་ཀར་ཏིང་ངེ་འཛིན་ལས་བཞེས་ཙ་ན།",
    "ནམ་མཁའ་སྐྱ་འོད་དེ་བ་གཅིག་འདུག།",
    "དེར་ང་ལ་སྔར་མེད་ཀྱི་ཉམས་རྟགས་ཤིག་ཤར་ནས་འདུག་སྙམ་པ་ལ།",
    "སྔར་གྱི་མར་མེ་སྤྱི་ཐོག་ན་ཡོད་པ་དེ་བརྗེད་ཏེ་སྣང་བ་དེ་མར་མེའི་སྣང་བར་འདུག།",
    "དེར་གྲོང་དུ་བབས་ནས་ཕྱིན་པས་བོན་སྟོན་བྱེད་པ་ཞིག་འདུག།",
    "ཇེ་ཆུང་ལ་རྔུབ་དུ་ཆ་ནས་འདུག་སྐད།",
    "གཅེར་ཉལ་བྱེད་པའི་མི་གཅིག་མཐོང་ཞེས་གླུ་ལེན་ཞིང་འདུག་ནས་དེ་ཅན་དུ་འགྲོ་དགོས་སྙམ་པས།",
    "ཕྱག་ཕུལ་དེ་ནས་འབྲས་ཁལ་གཅིག་བཏེགས་ནས་འདུག་དེར་ང་ལ་བཏེགས་པ་ཡིན་ནམ་བྱས་པས།",
