    "ང་བྱར་མི་བཏུབ་པར་འདུག་ད་ང་རང་ཡོན་བདག་བྱེད་ཀྱི་རྩིགས་ཟེར་ནས་དེར་སྒོམ་ཆེན་རྣམས་ལ་ད་བཟོད་རྩིགས་བྱས་པས་དེ་ནས་ཉི་མཚན་དེ་བྱུང་ནས་བར་དུ་མ་ཆོད་སྐད་དོ།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་ངང་ལས་ཐ་མལ་པའི་སྣང་ང་མེད་པར་འདུག་གསུང་།",
    "བག་ཙམ་མ་བདེ་གསུང་དེར་ཞེ་ས་ཕུལ་ལ་ཅི་ཙུག་མ་བདེ་ལགས་པ་དྲི་སྙམ་ཙ་ན་ཞེ་ས་འབུལ་རྒྱགས་ལ་འདས་ནས་འདུག་གསུང་།",
    "དུས་ནི་གངས་ལ་ཉི་མ་ཤར་ཙམ་ནས་འདུག་གསུང་།",
    "དེ་ནས་སྒོར་ཕྱིན་པས་མི་མ་ཡིན་གྱིས་གང་ནས་འདུག།",
    "དེ་འགོང་པོར་འདུག་སྐད།",
    "རྙི་བཙུན་ཞིག་ཡོད་པས་སྐམ་པས་གདུང་ལེན་དུ་ཕྱིན་ཙ་ན།",
    "འོད་རྫ་མ་ཙམ་གཅིག་སྤུར་སྒྲོམ་ན་ཡར་ཧྲིལ་མར་ཧྲིལ་འདུག་སྐད་དེ་དུས་སུ་མཐོང་སྣང་རྣམ་པ་སྣ་ཚོགས་པ་བྱུང་སྟེ།",
    "དེ་ལ་སོགས་པ་རང་རང་ལ་མཐོང་སྣང་མི་མཐུན་པ་སྣ་ཚོགས་བྱུང་ངོ།",
    "ཕྱིས་ཀྱི་དེ་མ་ཞུ་ན་ཐུགས་ཀྱི་ཐག་པ་དང་བཅས་པར་བྱོན་པར་འདུག་གསུང་།",
    "ཡང་ཁོ་བོ་ཤེས་པ་ཡེངས་ཅིང་ཚེ་ན་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་མང་པོའི་འཇིག་ཆགས་མཐོང་བར་འདུག་གསུང་སྐད།",
    "ཨོཾ་ཤྲཱི་བེ་ཙ་ན་ཡེ་སྭཱ་ཧཱ་ཞེས་པ་བཟླས་ཞིང་གསོལ་བ་གདབ་པར་བྱའོ།",
    "དེ་ཁོ་ན་ཉིད་དུ་ན་སེམས་ཉིད་ཀྱང་རང་བཞིན་གྱི་འོད་གསལ་སྟོང་པ་ཉིད་སྐྱེ་འགག་མེད་ཅིང་སྤྲོས་པ་དང་བྲལ་བ་ཡིན་པ་ལས།",
    "ནམ་ཞིག་དུས་ལ་བབ་པ་ན་དེའི་དོན་བྱ་དགོས་ཏེ།",
    "འདུག་ཀྱང་རུང་།",
    "བསྲུང་བའི་ཚུལ་ནི་རང་རང་མི་འགལ་བར་ཚུལ་བཞིན་གསུངས་པའོ།",
    "སྐྱབས་ཐུབ་པ་ནི་ཁོ་རང་འཇིགས་པ་ལས་ཐར་བ་སྡུག་བསྔལ་མེད་པ་གཅིག་དགོས་ཏེ།",
    "བདག་ནི་མལ་ན་འདུག་བཞིན་དུ།",
    "དེ་ལྟར་ཡང་རང་ལ་འབྱོར་པ་ཆེ་བར་ཡོད་ན་དངོས་སུ་ཆུང་བས་མི་འོང་སྟེ།",
    "སྨོན་པ་སོར་ཆུད་པས་འཇུག་པ་ཡང་རང་བཞིན་གྱིས་སར་ཚུད་དོ།",
    "མདུན་ན་བྱེ་མའི་ལུང་པ་ཆེན་པོ་གཅིག་འདུག།",
    "དེའི་ནང་ན་མིག་ལོང་པ་ཡང་མང་པོ་འདུག།",
    "ནུབ་ཕྱོགས་ན་གདམས་པ་འདི་མང་དུ་ཡོད་པར་འདུག་དགོངས་ཏེ།",
    "བོད་ནའང་ལས་དང་སྐལ་བར་ལྡན་པའི་སྐྱེས་བུ་ཡོད་པ་ངོ་མཚར་གསུངས་ནས་མི་ལ་ལ་དམིགས་པའི་ཕྱག་དགུ་མཛད་པས་རྒྱ་གར་གྱི་ཤིང་རྣམས་ཀྱང་བོད་ལ་འདུདཔར་གདའ།",
    "ཚེ་ཡང་རིང་རབ་འདུག་པས།",
    "དུང་མཚོ་རས་པ་ཞེས་གྲགས་པར་གདའ།",
    "ཁོང་རང་བཞུགས་ཪིང་ལ་ཤོག་དྲིལ་ཐམས་ཅད་ཚང་མ་བུ་ཆེན་རྣམ་པ་བརྒྱད་ལའང་གནང་བར་གདའ།",
    "མཁའ་འགྲོས་ལུང་བསྟན་ནས་གདམས་པ་འདིའི་སྐོར་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པ་གནང་བར་གདའ།",
    "ང་སྐྱེ་སྒོམ་གྱི་འདོད་པ་གྲུབ་ནས་གདའ།",
    "མ་ཡིན་ཀྱང་སྟན་བདེ་བ་ལ་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་ཡངས་པའམ་ཐོག་བུ་ཡང་རུང་སྟེ་བསམ་གཏན་གྱི་ཡན་ལག་ལྔ་དང་ལྡན་པས་འདུག་སྟེ།",
    "ཨཱོྃ་བཛྲ་བེ་རོ་ཙ་ནི་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "གདུང་ལ་སོགས་པའི་ཐུན་ལ་བབ་པ་ན་བསམ་གཏན་གྱི་གནས་སུ་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "སྣོད་བཅུད་གཉིས་དང་རང་བཞིན་བྲལ།",
    "བསྐྱེད་དང་རྫོགས་དང་རང་བཞིན་ལས།",
    "གནས་ནི་ཐབས་ཀྱི་འདུག་སྟངས་སོ།",
    "ཉེ་གནས་ཤེས་རབ་འདུག་པར་གསུངས།",
    "མ་འགག་པར་རང་རིག་ཅིང་རང་གསལ་བར།",
    "དེ་ཡང་སྒྲིབ་བྱེད་རྟོག་པ་ལ་ཤིང་རང་མཚན་དུ་ཞེན་པ་དེས་བསྒྲིབ་བྱ་ཤིང་གསལ་རྣམས་ཀྱི་བདག་ཉིད་དམ་ངོ་བོ་ཐ་དད་ཀྱང་།",
    "ཤིང་རང་མཚན་མྱོང་བའི་བག་ཆགས་ལས་སྐྱེས་ཤིང་།",
    "དེ་ལྟར་ཡིན་ཀྱང་རང་མཚན་ཁོ་ན་ལ་བརྡ་གདགས་པ་ཡིན་ན།་",
    "སྤྱི་རྐྱང་པ་དང་རང་མཚན་རྐྱང་པ་བརྡ་ཡུལ་དུ་མི་འཐད་པས་སྤྱི་དང་ལྡན་པའི་གསལ་བ་ལ་བརྡ་བྱེད་དོ་ཞེས་འདོད་དོ།",
    "སྔར་ཤེས་རྒྱུའི་སྤྱི་དེ་ད་ལྟ་མཐོང་བ་འདི་ལའང་ཡོད་པར་འདུག་གོ་སྙམ་དུ་ཤེས་པར་འགྱུར་གྱི་འདི་སྔར་གྱི་དེའོ་སྙམ་དུ་འཁྲུལ་པར་མི་འགྱུར་རོ།",
    "དེས་ན་གལ་ཏེ་སྤྱི་ཁོ་རང་དངོས་པོར་ཡོད་པ་ཞིག་ན་གསལ་བ་ཀུན་མེད་ཀྱང་དེ་འཛིན་འབྱུང་ལ།",
    "ལྡོག་པ་ཀུན་ལ་ཡོད་ཀྱང་རང་རྐྱ་ཐུབ་པའི་དངོས་པོར་མེད་ལ།",
    "ཁྱད་པར་གང་ཡང་གསར་དུ་མ་བསྐྱེད་ཀྱང་རང་གྲུབ་ཟིན་གྱི་སྤྱི་དེ་གསལ་བས་ཡུལ་དེར་འཇོག་པའམ་གནས་པར་བྱེད་དོ་ཟེར་ན།",
    "གཅིག་འཇིག་པ་ན་དེ་དང་རང་བཞིན་གཅིག་པའི་གཞན་ཐམས་ཅད་འཇིག་པར་འགྱུར་རོ།",
    "རྗེས་དཔག་ཀྱང་རང་བཞིན་གྱི་རྟགས་མེད་དེ་རང་བཞིན་དེ་ནི་བསྒྲུབ་བྱ་ཡིན་པས་སོ།",
    "དེ་ལྟ་ན་སྒྲ་དང་དོན་དང་འབྲེལ་བ་གསུམ་དངོས་པོ་ཐ་དད་པ་ཀ་བ་བུམ་པ་སྣམ་བུ་བཞིན་དུ་ཡོད་པར་འགྱུར་བའི་ཕྱིར་དེ་འཛིན་གྱི་བློ་ཡང་ཐ་དད་དུ་འཛིན་པ་སྣ་ཚོགས་པའི་ཚུལ་དུ་འགྱུར་གྱི་མིང་དོན་བསྲེས་ནས་གཅིག་ཏུ་ཞེན་པར་མི་འགྱུར་ལ་དེ་ལྟ་ན་འབྲེལ་བ་དང་དངོས་པོར་ཡོད་པ་དེས་མིང་དོན་འབྲེལ་བ་ལ་ཅི་ཞིག་ཕན་ཏེ་ཁོ་རང་རང་རྐྱ་བར་འགྱུར་རོ།",
    "སྒྲ་ཙམ་ལས་ཐ་དད་དུ་ཚིག་འབྲུ་ཡོད་དོ་ཞེས་བྱ་བ་འདི་ལ་ཤིན་ཏུ་ཆེས་དད་པར་བྱ་བ་ཞིག་འདུག་གོ་ཞེས་ཤིན་ཏུ་ཆེས་མི་དད་པར་སྟོན་པའི་བསྟིང་ཚིག་གོ།",
    "རྒྱུ་དེ་ལས་དངོས་པོ་གཞན་སྐྱེས་པས་ཤིང་ནི་སྔ་མ་བཞིན་དུ་འཇིག་པ་མེད་པར་གནས་པའི་ཕྱིར་ཤིང་རང་ཉིད་ནི་མཐོང་བ་ཉིད་དུ་འགྱུར་ཏེ།",
    "གལ་ཏེ་ཕྱོགས་གཉིས་པ་ལྟར་འཇིག་པ་ཤིང་ལས་གཞན་ཉིད་མ་ཡིན་པར་འདོད་ན་ཤིང་རང་ཉིད་འཇིག་པ་ཉིད་ཀྱི་ངང་ཚུལ་ཅན་དུ་འགྱུར་ལ།",
    "གཞན་ཐ་དད་པར་མི་འཐད་པས་ན་ཤིང་རང་ཉིད་རྒྱུ་གཞན་ལ་མི་ལྟོས་པར་འཇིག་པར་གྲུབ་བོ།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་ངེས་ནས་སྒྲོན་མེ་སྣང་ཙམ་གྱིས་དངོས་པོ་གསལ་བ་ལྟར་རིག་བྱེད་ཀྱི་སྒྲ་སྣང་ཙམ་ནས་དོན་གོ་བ་ལས་སྐྱེས་བུས་ཚིག་འདི་ནི་འདིའི་དོན་ཅན་ནོ་ཞེས་བརྡ་སྦྱར་པ་ཡང་དོན་མེད་པ་ཅན་ཉིད་དུ་འགྱུར་རོ།",
    "གཞན་ལུགས་བཀག་དང་རང་ལུགས་བཞག།",
    "བཀག་དང་རང་ལ་མི་མཚུངས་ཚུལ།",
    "བཀག་དང་རང་ལ་མི་མཚུངས་པའོ།",
    "དེ་ཡི་ཚེ་ན་རྒྱུ་ཡི་ངོ་བོ་མ་ཙ་ནོར་བར་རྟོགས་པ་སྟེ་ཁོང་དུ་ཆུད་པའི་ཕྱིར་རྒྱུ་དང་འགལ་བ་དེ་ཡི་མི་མཐུན་ཕྱོགས་ཀྱང་ངེས་པར་འགྱུར་རོ།",
    "བཀག་དང་རང་ལ་མི་མཚུངས་ཚུལ།",
    "སྤྱི་དེ་ནི་གསལ་བ་ཡོད་ཀྱང་རུང་མེད་ཀྱང་རུང་དུས་ཀུན་གྱི་ཚེ་ནའང་རང་འཛིན་ཤེས་པ་སྐྱེད་པའི་ནུས་པ་མེད་པར་འགྱུར་རོ།",
    "གཞན་ཡང་རང་མཚན་མེད་པས་འདས་མ་འོངས་དང་ལོག་ཤེས་རྣམས་ལ་དེའི་རང་མཚན་ལྐོག་ཏུ་གྱུར་པའི་ཚུལ་གྱིས་ཇི་ལྟར་གཞལ་ཏེ་གཞལ་བྱ་རང་མཚན་མེད་པས་སོ།",
    "གསལ་བ་གཅིག་ལའང་གནས་སྐབས་ཁྱད་ཡོད་པ་དང་རང་བཞིན་ཕན་ཚུན་རྗེས་སུ་འགྲོ་བས་ཁྱད་མེད་པའི་ངོ་བོ་ཉིད་གཉིས་སུ་ཡོད་པ་ཅི་འགལ་སྙམ་ན་ཡང་།",
    "དེ་གསལ་བ་འཛིན་པའི་དུས་དེ་ཉིད་དུ་སྣང་རུང་ཡིན་པར་ཁས་བླངས་ལ་དེ་གསལ་བ་ཁོ་རང་མ་ཡིན་པར་ཡང་ཁས་བླངས་པས་ན།",
    "དེ་ཡང་རང་མཚན་ལ་མི་རྟག་པའི་སྤྱི་སྦྱར་ནས་བཟུང་ངོ་སྙམ་པ་རྣམས་ཀྱི་ཞེ་འདོད་ལ་གསུམ་སྟེ།",
    "གལ་ཏེ་རང་མཚན་ལ་ཡང་ཡང་ཤེས་པ་མེད་དུ་ཆུག་ཀྱང་རང་མཚན་དེ་ལ་ཡོད་པའི་སྤྱི་རྟག་པ་དེ་རང་མཚན་གྱི་སྒོ་ནས་ཡང་ཡང་ཤེས་པ་ཡིན་ནོ་ཞེ་ན།",
    "དུ་བ་སོགས་རྟགས་ལས་སྔར་གྱི་མེ་དེ་འདི་ན་ཡང་འདུག་གོ་སྙམ་པ་ནི་རྟགས་དེ་མེ་ཙམ་ལ་མ་འཁྲུལ་པ་ཡིན་པས་འབྲས་རྟགས་ཡིན་ཀྱང་སྔར་གྱི་དེ་འདིའོ་སྙམ་པ་ནི་འཁྲུལ་བ་ཡིན་ནོ།",
    "རིམ་ཅན་དུ་མཐོང་བ་ནི་གཅིག་དུས་ན་གཅིག་མེད་པས་དུས་ཅིག་ཅར་གསལ་སྣང་ཡོད་མི་སྲིད་ལ།",
    "རིགས་མེད་པའི་ཕྱིར་སྒྲས་ཀྱང་རང་མཚན་གོ་བར་མི་འགྱུར་རོ་ཞེ་ན།",
    "མི་མཐུན་པ་མཐའ་དག་བསྟན་ནས་འདི་ལ་མི་འཇུག་ཅེས་བསྟན་པར་ནི་སུས་ཀྱང་མི་ནུས་པས་སྒྲ་དང་རང་མཚན་འབྲེལ་མི་ནུས་ཏེ།",
    "གལ་ཏེ་བརྡ་དྲན་པ་དེ་ནི་དོན་དེ་མཐོང་བ་ཙམ་དང་རང་ཆས་སུ་འབྲེལ་ནས་སྐྱེ་བའི་ཕྱིར་བརྡ་དྲན་མེད་པ་མི་སྲིད་དོ་ཞེ་ན།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "དང་པོ་ལྟར་དོན་དང་བདེ་བ་གཉིས་ཀྱིས་སོ་སོ་སོ་སོར་ཏེ་ཡན་གར་བ་ཡང་རང་འཛིན་ཤེས་པ་སྐྱེད་ནུས་པ་ཡིན་ནོ་ཞེ་ན།",
    "འགའ་ཞིག་སྟེ་གྲངས་ཅན་པས་ནི་བདེ་སོགས་ཕྱི་རོལ་ན་དེ་ཙམ་ལྔའི་བདག་ཉིད་དུ་གནས་པ་ཉིད་དང་ནི་དེ་ཡང་སེམས་མེད་པ་དང་རང་ལས་གཞན་པར་གྱུར་པའི་ཤེས་པས་གཟུང་བར་སྨྲ་སྟེ་ཞེས་སོ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "མ་བསྟན་ཀྱང་འདི་ན་སྦྲུལ་འདུག་ཅེས་བརྗོད་པས་སྦྲུལ་འཛིན་སྐྱེ་བ་བཞིན་ནོ།",
    "བཀག་དང་རང་ལ་མི་མཚུངས་པའོ།",
    "དངོས་དང་རང་མྱོང་བ་ཡི་དཔེ།",
    "སྐྱེས་བུའི་རྒྱུད་ཀྱི་ཤེས་པ་སྔོ་སོགས་ཤེས་པ་བཞིན་དུ་སྔོ་འཛིན་ཡང་རང་བློ་རང་ལ་ལྐོག་ཏུ་མ་གྱུར་པར་མྱོང་བ་དང་དྲན་པས་གྲུབ་པ་ལ་བསྙོན་དུ་མེད་དོ།",
    "དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་ཡིན།",
    "ཡང་རང་རིག་འབྲས་བུ་སྟེ།",
    "དཀར་སྣང་ནི་མ་བསླད་པའི་ཕྱིར་རྣམ་པ་གཏོད་བྱེད་ཀྱི་ཕྱི་དོན་དུ་དུང་རང་ཉིད་དཀར་པོ་ཉིད་དུ་ཡོད་ཅེས་བརྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "ཇི་ལྟར་རང་རང་སོ་སོའི་མཐོང་བ་དེས་དོན་དེ་དང་དེ་ལྟ་བུར་རིག་པའི་ཐ་སྙད་བྱེད་ཀྱང་ཡུལ་གྱི་སྣང་བ་དེ་ལ་བརྟན་མི་བརྟན་དང་།",
    "དེའི་ཕྱིར་ཕྱི་དོན་འདོད་པའི་ལུགས་ལའང་རང་རིག་འབྲས་བུ་ཡིན་པར་འགྱུར་རོ།",
    "དེས་ན་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུ་ཡིན་ན་དོན་མི་འདོད་པའི་ལུགས་ལ་ལྟ་ཅི་སྨོས་ཞེས་ཤེས་པར་འགྱུར་རོ།",
    "མིན་ཀྱང་རང་རིག་འབྲས་མི་འགལ།",
    "དེ་ཡང་རང་ལ་རང་ཡུལ་དུ་བདེན་ན་ཡུལ་དང་ཡུལ་ཅན་དང་དེ་རིག་པ་གསུམ་དུ་གནས་པས་དེ་གསུམ་ཐ་དད་དུ་འགྱུར་ལ།",
    "གཉིས་སུ་སྣང་ཡང་དོན་ལ་གཉིས་སུ་མེད་དེ་ལས་རང་རིག་ཏུ་འཇོག་པའི་འཐད་པ་འགྲུབ་པའང་ཡིན་ལཔར་བློ་གཅིག་ཉིད་དེར་སྣང་བ་ཙམ་དུ་ཟད་པས་འཛིན་རྣམ་ཡན་གར་པ་རང་རིག་ཏུ་འགྱུར་གྱི་གཟུང་རྣམ་འཛིན་རྣམ་ལ་འཛིན་རྣམ་གཞན་མེད་ཀྱང་རང་རིག་མེད་པར་མི་འགྱུར་བའི་ལ་རང་རིག་མེད་པ་དང་།",
    "བསྙོན་དུ་མེད་པའི་བློ་རྣམ་བཅས་དང་རང་རིག་པ་ལ་སྡང་བའི་བསམ་པ་དོར་བར་བྱས་ན་ལེགས་སོ།",
    "འོན་ཀྱང་བློ་གཅིག་དུས་གཅིག་ཏུ་སྣ་ཚོགས་སུ་འཆར་དུ་རུང་བའི་ཕྱིར་བློ་དང་དོན་ཐ་དད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་བློ་ཡི་གཟུང་འཛིན་རྫས་གཅིག་ཏུ་གྲུབ་པས་རྣམ་བཅས་དང་རང་རིག་གྲུབ་པར་གྱུར་ན་དེ་འདྲའི་ལྷན་ཅིག་དམིགས་ངེས་དེས་ཕྱི་དོན་མེད་པར་འགྲུབ་སྟེ།",
    "གཞན་ལུགས་འགོག་དང་རང་ལུགས་བཞག།",
    "སྔར་ཞིག་ཟིན་དེ་ད་ལྟ་གསལ་པོར་སྣང་བ་མི་སྲིད་ཀྱང་རང་དང་དུས་མཉམ་པའི་རང་མཚན་ད་ལྟར་བ་དེ་རྗེན་ཅེར་གསལ་བར་སྣང་ངོ་ཟེར་ན།",
    "དོན་འདོད་པའི་ཞེན་ངོར་བྱས་ན་གཟུང་བའི་རྣམ་པ་དེས་ཁ་ཕྱིར་བལྟས་ཀྱི་དོན་རིག་པར་འདོད་པས་གཞན་རིག་དང་རང་རིག་ཐ་དད་པ་ལྟ་བུའི་ཚུལ་གཉིས་པ་ཅན་གྱི་བློར་བསྒྲུབས་ཀྱང་དོན་དུ་མྱོང་བ་དེ་ནི་རང་རིག་ཁོ་ན་ལས་གཞན་རིག་པ་མི་སྲིད་པར་ཤུགས་ཀྱིས་འགྲུབ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཞན་མཐོང་བ་དང་རང་མ་མཐོང་བའི་ཆ་ཞེས་པ་ནི་འཁྲུལ་བས་སྒྲོ་བཏགས་པ་ཙམ་ལས་ཅུང་ཟད་ཀྱང་མེད་དེ།",
    "དུས་མཉམ་པས་ནི་ཕན་མི་འདོགས་ལ་དུས་མི་མཉམ་པའི་རྒྱུ་སྔ་མས་ཀྱང་རང་འདྲའི་རྣམ་པ་བློ་ལ་མི་བྱེད་པར་འདོད་པས་ན་ཅི་ལྟར་ཡུལ་དང་ཡུལ་ཅན་དེ་ནི་མཐོང་བ་ཞེས་པ་དང་།",
    "བདེ་མྱོང་རང་བློ་མངོན་སུམ་སྒྲུབ།",
    "བདེ་མྱོང་རང་རིག་ཡིན་དམ་བཅའ།",
    "དེ་ལྟ་ན་རྣམ་བཅས་དང་རང་རིག་པ་གྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་དོན་ཙམ་མྱོང་བར་མ་ཟད་གཞན་ཤེས་པ་དེའང་རང་ཉིད་ཉམས་སུ་མྱོང་བའམ་མཐོང་བར་གདོན་མི་ཟ་སྟེ།",
    "ཐ་མའི་བློ་དེ་ཡང་རང་དུས་ཀྱི་སྐད་ཅིག་དེ་ལས་རིང་པོར་འཛིན་པ་མིན་པས་རིང་པོ་སུས་ཀྱང་མྱོང་བ་མེད་པ་དེས་ན་རིང་པོའི་བློ་དྲན་པར་མི་འགྱུར་ཏེ་དེ་འདྲའི་བློ་མེད་པས་སོ།",
    "དེ་གཉིས་ཡུན་རིང་ཐུང་འདྲ་ལ་བར་མ་ཆད་པར་འདུག་པ་མྱུར་བ་ཡང་འདྲའོ།",
    "དེ་ལྟ་ན་སྔོ་འཛིན་དེའང་རང་ཉིད་ཀྱི་ངོ་བོར་མྱོང་བ་དང་ཡུལ་ཅན་གྱི་ཚུལ་དུ་མི་སྣང་བར་སྔོན་པོ་བཞིན་དུ་ཡུལ་དུ་སྣང་བར་འགྱུར་རོ།",
    "དེ་ལས་སྐྱེས་པའི་ཤེས་པ་གསལ་བ་དེ་ཡང་རང་རིག་པས་མ་མྱོང་ན་གསལ་བར་མི་རྟོགས་ལ།",
    "དངོས་དང་རང་ལ་དེ་མི་མཚུངས།",
    "ལུང་རང་ལ་བརྟེན་ནས་ཀྱང་བསྒྲུབ་བྱ་དངོས་ལ་གནོད་པའམ།",
    "ལུང་དང་རང་ཚིག་བསྡུས་ཏེ་བཤད།",
    "དེ་ཡང་རང་ལུགས་ལ་རྡུལ་ཕྲན་རྟག་པ་མིན་ཀྱང་གཞན་ཕྱི་རོལ་པའི་འདོད་ངོར་མཐུན་ཕྱོགས་བྱས་ཚེ་དེ་ལ་རྟགས་འདི་མ་གྲུབ་པར་སྟོན་པའི་ཆེད་དོ།"
  ]
}