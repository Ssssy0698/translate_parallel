    "ཁྱོད་ཀྱི་སེམས་སམ་ཕུང་པོ་བདག་མི་འགྱུར།",
    "དེའང་གོང་གི་རིགས་པ་བསྟན་པ་ན་ཕ་རོལ་པོ་ན་རེ།",
    "ཅི་སྟེ་ལས་འབྲས་ཀྱི་འབྲེལ་བ་སྟོན་པའི་ཚེ་བདག་གི་སྒྲ་ཕུང་པོ་ལ་འཇུག་གི།",
    "གང་ཚེ་རྣལ་འབྱོར་པས་བདག་མེད་མཐོང་བ་དེའི་ཚེ་ན་གཞན་གྱིས་ཀུན་ཏུ་བརྟགས་པའི་ནང་གི་བྱེད་པའི་སྐྱེས་བུ་ཉིད་ལ་འཇུག་པས་བྱེད་པོར་འདོད་པའི་བདག་དེ་རྣལ་འབྱོར་པས་མེད་པར་མཐོང་བ་ཡིན་ཕྱིར་གོང་གི་སྐྱོན་མེད་དོ་ཞེ་ན།",
    "གོང་གི་སྐྱོན་ལ་འཇིགས་ནས་དེ་ལྟར་སྨྲ་བ་ཡིན་ནའང་།",
    "དེ་ལྟར་ན་ཁྱོད་རང་གི་ཕྱོགས་ཉམས་པར་འགྱུར་ཏེ།",
    "ཕུང་སོགས་ཡོད་ན་བདག་ཀྱང་ཡོད་པས་ཆགས་སོགས་ཀྱང་མི་ལྡོག་པར་ཐལ་བ་ནི།",
    "ཁྱོད་ཀྱི་རྣལ་འབྱོར་བདག་མེད་མཐོང་བ་ཡིས།",
    "ལུང་གི་དོན་ཕུང་པོ་བདག་ཏུ་འདོད་པ་མིན་པར་བསྟན་པ།",
    "ལུང་གི་དགོངས་པ་དགག་བྱ་གཅོད་ཕྱོགས་ནས་ཡིན་པར་བསྟན་པ།",
    "ཕུང་པོ་བདག་ཡིན་ན་ཚོགས་པ་ལས་རེ་རེ་བ་མིན་ཚུལ་དང་།",
    "དཔེར་ན་ཤིང་རྣམས་ལ་ནགས་ཚལ་ཞེས་བརྗོད་པ་ན་ཤིང་གི་ཚོགས་པ་ནགས་ཚལ་ཡིན་གྱི་ཤིང་རེ་རེ་ནགས་ཚལ་མིན་པ་བཞིན་ནོ།",
    "དེའི་ཉེས་སྤོང་གི་ལན་དགག་པ་གཉིས་ལས།",
    "བདག་ཉིད་བདག་གི་མགོན་ཡིན་ཏེ།",
    "བདག་ཉིད་བདག་གི་དགྲ་ཡང་ཡིན།",
    "ཚོགས་པ་རྫས་སུ་མེད་པ་བདག་ཡིན་པ་ལ་ལུང་དེ་དག་གིས་དངོས་སུ་གནོད་པས་ཚོགས་པ་བདག་མ་ཡིན་ནོ།",
    "དེས་ན་ཁྱོད་ཀྱི་བདག་དེ་ནི་ཚོགས་པ་མ་ཡིན་ནོ།",
    "ཞེས་པའི་ཉེས་སྤོང་གི་ལན་ལ།",
    "དེའི་ཉེས་སྤོང་གི་ལན་དགག་པ་གཉིས་ལས།",
    "ཚོགས་པ་ཙམ་བདག་ཡིན་ན་དཔེ་ཤིང་རྟའི་ཡན་ལག་ཚོགས་པ་ཤིང་རྟར་ཐལ་བས་དགག་པ་དང་།",
    "གཉིས་པ་དེའི་ཉེས་སྤོང་གི་ལན་འགག་པ་ནི།",
    "དེ་དག་ཉིད་ལ་བདག་ཅེས་ཁྱོད་འདོད་ཀྱི།",
    "གཟུགས་ཅན་ཀྱི་སྐྱེ་མཆེད་དེ་དག་ཁོ་ན་ཉིད་ལ་བདག་ཅེས་བྱ་བར་ཁྱོད་ཀྱིས་འདོད་དགོས་ཀྱི་སེམས་ལ་སོགས་པ་མིང་བཞིའི་ཕུང་པོ་འདུས་པའི་ངོ་བོ་ནི་བདག་མིན་པར་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་ན་སེམས་སོགས་དེ་དག་ལ་དབྱིབས་མེད་པའི་ཕྱིར་རོ།",
    "དེའི་ཉེས་སྤོང་གི་ལན་འགག་པ་གཉིས་ལས།",
    "བུམ་པ་དང་རྫ་མཁན་དག་ཀྱང་གཅིག་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "མེ་དང་ཤིང་གི་བདག་དང་ནི།",
    "གསུངས་པ་ལྟར་དུ་ངར་འཛིན་ལྷན་སྐྱེས་ཀྱིས་ཀྱང་དེ་རྣམས་ཐུན་མོང་དང་རེ་རེ་བ་དང་ཚོགས་པ་གསུམ་གང་ཡང་བདག་ཏུ་མི་དམིགས་པའི་ཚུལ་དང་།",
    "ཁམས་དྲུག་དང་ནི་མིག་སོགས་རེག་པ་ཡི།",
    "ཕུང་པོའི་ཚོགས་པ་ཙམ་དང་རེ་རེ་བ་བདག་མིན་ཏེ།",
    "དེ་བཞིན་དུ་མིག་སོགས་ཏེ་མིག་གི་འདུས་ཏེ་རེག་པ་ནས་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་བར་རེག་པ་ཡི་རྟེན་དྲུག་དག་ལ་བརྟེན་ནས་ཉེ་བར་བསྟན་ཞིང་།",
    "རེག་པའི་སྐྱེ་མཆེན་དྲུག་དང་།",
    "དེའང་འདིར་ངར་འཛིན་པའི་ཡུལ་ནི་ཕུང་པོ་རྣམས་དང་ཡང་སེམས་ཁོ་ནའོ་ཞེས་འཛིན་པ་མང་བཀུར་བ་དག་གི་ཕྱོགས་ཡིན་པ་ལྟར་ན་བདག་ཕུང་ངོ་བོ་གཅིག་ཏུ་ཁས་བླངས་བས་ན།",
    "ཁྱོད་ལྟར་ན་གང་གི་ཚེ་རྣལ་འབྱོར་པས་བདག་མེད་པར་རྟོགས་པ་དེ་ཡི་ཚེ་ཕུང་པོ་ལས་དོན་གཞན་པའི་རྟག་པའི་བདག་མེད་པར་རྟོགས་པའི་སྒོ་ནས་སྤོང་ཞིང་།",
    "རྟག་པའི་བདག་འདི་ནི་འཇིག་རྟེན་པ་གང་གིས་ཀྱང་ངར་འཛིན་པའི་རྟེན་དུའང་མི་འདོད་ལ།",
    "ཁྱོད་རང་གིས་ཁས་བླངས་དང་ཡང་འགལ་ཏེ།",
    "དཔེར་ན་མི་འགའ་ཞིག་གིས་རང་གི་ཁྱིམ་གྱི་རྩིག་ཕུག་ན་དུག་སྦྲུལ་གནས་པ་མཐོང་བཞིན་དུ་འདི་ན་གླང་ཆེན་མེད་ཅེས་སྦྲུལ་གྱི་དོགས་པ་བསལ་ཏེ།",
    "ཐུན་མོང་དུ་མཇུག་བསྡུ་བ་དང་གཉིས་ལས།",
    "ཕུང་པོ་དེ་རྣམས་ཡོད་མིན་གང་གི་ཕྱིར།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "གང་གི་ཕྱིར་ན་བདག་མེད་པ་དེའི་ཕྱིར་བདག་ལ་ཕུང་པོ་ལྡན་པའི་དོན་དུ་སྦྱོར་བ་མེད་དེ།",
    "མོ་གཤམ་གྱི་བུ་ལ་ཕུང་པོ་ལྡན་དོན་གྱི་སྦྱོར་བ་མེད་པ་བཞིན་ནོ།",
    "ཡིན་མོད་དེ་ནི་མུ་སྟེགས་པའི་ལུགས་དགག་པའི་ཕྱིར་ཡིན་ལ།",
    "རྩེ་མོ་མཐོ་བར་གྱུར་པ་དེ་དག་གོ།",
    "ཞེས་གསུངས་པ་ནི་ལྟ་བའི་རི་བོ་དེ་དག་གི་རྩ་བ་བདག་འཛིན་ལྷན་སྐྱེས་ལ་བརྟེན་ནས་ཀུན་ཏུ་བརྟགས་པས་ན་བདག་མེད་རྟོགས་པའི་ཡེ་ཤེས་ཀྱི་རྡོ་རྗེ་ཡིས་འཇིག་ལྟ་ལྷན་སྐྱེས་དེ་ཉིད་བཅོམ་པའི་ཚེ་ལྷན་སྐྱེས་ཀྱི་བདག་དེ་དང་ལྷན་ཅིག་ཏུ་འཇིག་པར་འགྱུར་བ་ནི་འཇིག་ཚོགས་ལ་ལྟ་བའི་རི་བོ་ཉོན་མོངས་པའི་བྲག་རྡོ་འཕེལ་བ།",
    "འཕགས་པ་མང་པོས་བཀུར་བ་ཁ་ཅིག་གིས་གང་ཟག་ནི་རྫས་སུ་ཡོད་དེ།",
    "བདག་ཉིད་བདག་གི་མགོན་ཡིན་གྱི།",
    "སུ་ཞིག་བདག་གི་མགོན་དུ་འགྱུར།",
    "བདག་གིས་བྱས་པའི་ལས་རྣམས་ནི།",
    "དེ་ལྟ་མོད་ཀྱི་བདག་དེ་ནི་ཕུང་པོ་དང་དེ་ཉིད་སྟེ་གཅིག་མིན་ཏེ།",
    "སྐྱེ་འཇིག་ཅན་དུ་ཐལ་བས་སོ།",
    "གང་ཟག་དེ་ནི་རང་གི་ངོ་བོས་ཤེས་བྱ་མིན་གྱི།",
    "ནས་ཤེས་པར་བྱེད་པས་རྣམ་པར་ཤེས་པ་དྲུག་གི་ཤེས་བྱར་ཡང་དེ་འདོད་ཅིང་།",
    "དངོས་པོར་གྲུབ་ན་བརྗོད་དུ་ཡོད་པར་ཐལ་བས་དགག་པ།",
    "བརྗོད་དུ་མེད་ན་དངོས་པོར་མེད་པར་ཐལ་བས་དགག་པ།",
    "གང་གི་ཕྱིར་དངོས་པོར་ཡོད་པ་ནི་རྣམ་པ་གཞན་མི་འཐད་པའི་ཕྱིར་དེ་ཉིད་དང་གཞན་དུ་བརྗོད་དུ་མེད་པ་མ་ཡིན་པས།",
    "ཁྱོད་ཀྱིས་འདོད་པའི་གང་ཟག་རྫས་སུ་མི་གྲུབ་སྟེ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "དེས་ན་བདག་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པར་བཞག་ཏུ་མེད་པ་དེ་ནི་རྫས་ཀྱི་དངོས་པོར་གྲུབ་པར་རྟོག་པར་མི་བྱ་བར་མིང་གིས་བཏགས་པའི་ཡོད་པ་ཙམ་དུ་ཤེས་པར་བྱའོ།",
    "གནས་མ་བུ་པ་ཁྱོད་ཀྱི་འདོད་པའི་བདག་དངོས་པོ་རྫས་སུ་མ་གྲུབ་སྟེ།",
    "གང་གི་ཕྱིར་ན་ཁྱོད་ཀྱིས་རྣམ་པར་ཤེས་པ་དངོས་པོར་ཡོད་པས་རང་གི་བདག་ཉིད་ལས་རྫས་གཞན་མིན་པར་འདོད་པ་དང་གཟུགས་ལ་སོགས་རྣམས་ལས་རྫས་གཞན་དུ་གྱུར་པ་འདོད་ཅིང་།",
    "ན་ཁྱོད་ཀྱི་བདག་ནི་དངོས་པོར་མེད་དེ།",
    "ཕུང་པོ་ནི་བདག་གི་རྟེན་མིན་ལ་བདག་ནི་ཕུང་པོ་རྣམས་ཀྱི་རྟེན་ཡང་མ་ཡིན་ནོ།",
    "ཤིང་རྟ་རང་གི་ཡན་ལག་ལས་གཞན་མིན།",
    "འདིར་བཀོད་པའི་དཔེ་ཤིང་རྟ་ཞེས་པའི་ཤེས་བྱ་འདི་ནི་རང་གི་ཡན་ལག་གཟེར་བུ་དང་སྲོག་ཤིང་སོགས་ལས་གཞན་ཐ་དད་དུ་གྱུར་པ་ཞིག་ཏུ་འདོད་པ་མིན་ཏེ།",
    "ཡན་ལག་རེ་རེ་བ་ཤིང་རྟར་མི་འདོད་པའི་ཕྱིར་རོ།",
    "ཡན་ལག་གི་དབྱིབས་སོ་སོ་བ་ཤིང་རྟཪ་འདོད་པ་དགག་པ་དང་།",
    "གཉིས་པ་ནི་ཡན་ལག་གི་སྔར་གྱི་དབྱིབས་ཁོ་ན་ཤིང་རྟར་འདོད་པ་དགག་པ་དང་།",
    "གལ་ཏེ་ཡན་ལག་གི་དབྱིབས་སྔར་ཡོད་པ།",
    "ཤིང་རྟ་བཅས་པ་དང་མ་བཅས་པ་དག་གི་གནས་སྐབས་ཀྱི་འཕང་ལོ་ལ་སོགས་ཀྱི་དབྱིབས་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཡན་ལག་གི་དབྱིབས་ཤིང་རྟ་ཉིད་མ་ཡིན།",
    "ལྟེ་བ་ལ་སོགས་པས་ཁྱད་པར་དུ་བྱས་པའི་དབྱིབས་ཅན་འཕང་ལོ་ལ་ནི་ཤིང་རྟའི་གནས་སྐབས་ན་རང་གི་དབྱིབས་གཞན་དུ་གྱུར་པ་གཟུང་དུ་ཡོད་པ་མིན་ལ།",
    "དེ་ཡི་ཕྱིར་ཡན་ལག་གི་དབྱིབས་ཤིང་རྟ་ཉིད་དུ་རིགས་པ་མ་ཡིན་ནོ།",
    "གང་ཕྱིར་ཁྱོད་ཀྱི་ཚོགས་པ་ཅང་མེད་པས།",
    "གང་གི་ཕྱིར་ན་ཁྱོད་ཀྱི་ཚོགས་པ་ཞེས་བྱ་བ་ནི་དངོས་པོར་གྱུར་པ་ཅང་གྲུབ་པ་མེད་པས་ཤིང་རྟའི་དབྱིབས་དེ་ནི་ཡན་ལག་ཚོགས་པའི་རྟེན་ཅན་གྱི་དབྱིབས་མ་ཡིན་པས་ན།",
    "ཁྱོད་ཀྱིས་འདི་ནི་ཇི་ལྟར་འདོད་དེ་ལྟར།",
    "ཁྱོད་ཀྱིས་མི་བདེན་པའི་ཚོགས་པ་ལ་བརྟེན་ནས་མི་བདེན་པའི་དབྱིབས་སུ་འདོགས་པ་འདི་ནི་ཇི་ལྟར་འཐད་པར་འདོད་པ་དེ་ལྟར་དུ།",
    "འབད་རྩོལ་བརྒྱ་ཕྲག་དག་གིས་ཀྱང་གང་གིས་ཤ་ཟ་བར་མི་ནུས་པའི་གྲིབ་མའམ་རི་དྭགས་ལྟ་བུ་ལ་རི་དྭགས་སུ་བདེན་པར་ཞེན་པ་ནི་དོན་མེད་པས་ཅི་ཞིག་བྱ་སྟེ་ཐམས་ཅད་བདེན་མེད་དུ་ཤེས་པར་གྱིས་ཤིག།",
    "ཤིང་རྟའི་ཡན་ལག་གི་ཚོགས་པ་ཤིང་རྟར་མི་རིགས་པ་ལྟར།",
    "རྣམ་པ་བདུན་གྱིས་འགྲུབ་འགྱུར་མིན་མོད་ཀྱིས།",
    "རང་གི་ཡན་ལག་བརྟེན་ནས་འདོགས་པ་ཡིན།",
    "ཤིང་རྟའི་ཐ་སྙད་རྒྱུན་ཆད་པར་ཐལ་བའི་ཉེས་པ་འདི་ནི་ཁྱོད་ཁོ་ན་ལ་འགྱུར་ཏེ།",
    "འོན་ཀྱང་རིགས་པའི་རྣམ་དཔྱད་མེད་པར་འཇིག་རྟེན་གྱི་ཐ་སྙད་ཉིད་ལ་ལྟོས་ནས་ཤིང་རྟ་འདིར་རང་གི་ཡན་ལག་འཕང་ལོ་ལ་སོགས་པ་ལ་བརྟེན་ནས་ཤིང་རྟ་འོན་ཅིག་ཅེས་སོགས་ཀྱི་ཐ་སྙད་འདོགས་པ་ཡིན་པས་སོ།",
    "དེས་ན་ཁོ་བོ་ཅག་གི་ཕྱོགས་ལ་འཇིག་རྟེན་ཐ་སྙད་རྒྱུན་ཆད་པར་མི་འགྱུར་ལ།",
    "འདིའི་མིང་གི་ཁྱད་པར་གང་ཡིན་པ་ཐམས་ཅད་ཀྱིས་འཇིག་རྟེན་ལ་གྲགས་པའི་སྒོ་ནས་བརྗོད་དུ་རུང་བར་ཁས་ལེན་ཏེ།",
    "རང་གི་ཡན་ལག་ཉེ་བར་ལེན་པ་ལ་ལྟོས་ནས་ཉེ་བར་ལེན་པོ་ཉིད་དུའང་འཇིག་རྟེན་ལ་གྲུབ་པས།",
    "གང་གི་ཕྱིར་འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་འདི་དེ་ལྟར་རྣམ་པར་དཔྱད་ན་ཡོད་པར་མི་འགྱུར་ཞིང་།",
    "གལ་ཏེ་ཤིང་རྟ་ཞེས་བྱ་བ་རང་བཞིན་གྱིས་གྲུབ་པ་འགའ་ཞིག་ཡོད་ན་རྣམ་པ་བདུན་ལས་གང་ཡང་རུང་བ་ཞིག་གིས་བདག་ཉིད་ཡོད་པ་རྙེད་པར་འགྱུར་ན་རྙེད་པའང་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་རྣམ་པ་བདུན་གྱིས་བཙལ་བ་ན་མེད་པའི་ཤིང་རྟ་གང་ཡིན་པ་དེ་ཇི་ལྟ་བུར་ཡོད་ཅེས་རྣལ་འབྱོར་པ་ཚུལ་བཞིན་དུ་དཔྱོད་པས་ཤིང་རྟ་འདིའི་ཡོད་པ་མི་རྙེད་པ་དེས་ན་ཤིང་རྟ་ཞེས་བྱ་བ་ནི་མ་རིག་པའི་ལིང་ཏོག་གིས་ཉམས་པར་བྱས་པ་དག་ཁོ་ནས་བརྟགས་པར་ཟད་ཀྱི་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ནོ་སྙམ་དུ་ངེས་ཤིང་།",
    "འང་གི་སྒྲས་ནི་ཀུན་རྫོབ་ཉམས་པར་ཡང་མི་འགྱུར་ཏེ།",
    "རྣལ་འབྱོར་པས་ཤིང་རྟ་མ་དམིགས་ལ་རག་མོད།",
    "སྣམ་བུ་ཚིག་པའི་ཐལ་བ་ལ་སྣལ་མ་འཚོལ་བ་ཁྱོད་ནི་བཞད་གད་དུ་བྱ་བར་རིགས་ཏེ།",
    "ཕུང་སོགས་དེ་དག་བདག་གི་ཉེ་བར་ལེན་པ་ཡིན་ལ།",
    "བདག་ཀྱང་དེ་དག་གི་ཉེ་བར་ལེན་པ་པོ་ཉིད་དུ་འདོད་པ་ཡིན་ནོ།",
    "ཁྱོད་ཀྱི་བདག་ནི་གང་ཞིག་ཡིན།",
    "འདི་ནི་སྐྱོན་དུ་ཐལ་བར་འགྱུར།",
    "དེ་སུན་ཕྱུང་བས་བདག་གི་བ་ཡང་མེད་ཚུལ།",
    "གང་ཞིག་རྣམ་པ་བདུན་གྱིས་བཙལ་ན་རྟག་པ་དང་མི་རྟག་པ་སོགས་མཐའ་གང་དུའང་མི་གནས་པའི་བདག་དེ་རང་བཞིན་གྱི་ཡོད་པ་མ་ཡིན་ན་བདག་གི་ཐ་སྙད་འདི་རྒྱུ་གང་ལས་བྱུང་སྙམ་ན།",
    "ཉིད་མེད་པར་བདག་གི་མེད།",
    "གཏི་མུག་གི་རྒྱུ་ལས་བདག་ཉིད་ཐ་སྙད་འདོགས་ཤིང་རིགས་པས་དཔྱད་ན་ཡོད་པ་མ་ཡིན་དེ་ཉིད་ཀྱི་ཕྱིར་རྣལ་འབྱོར་པ་དག་གིས་བདག་རྣམ་པ་ཐམས་ཅད་དུ་མ་དམིགས་ལ་དེ་མ་དམིགས་ན་བདག་གི་བ་ཡང་དམིགས་པར་མི་འགྱུར་རོ།",
    "བྱེད་པ་པོ་རྫ་མཁན་མེད་པ་ཅན་གྱི་བྱ་བའི་ལས་རྫ་བུམ་མེད་པ་དེའི་ཕྱིར་ཉེ་བར་ལེན་པ་པོ་བདག་ཉིད་མེད་པར་ཉེ་བར་བླང་བྱ་བདག་གི་བ་ཡང་མེད་དོ།",
    "དེ་ཕྱིར་བདག་དང་བདག་གིས་སྟོང་ལྟ་བས།",
    "གང་གི་སྒོ་ནས་འགྲོ་འདིས་བསྙད་བཞིན་རྟོགས་བྱ་སྟེ།",
    "འཇིག་རྟེན་ན་དངོས་པོ་གང་དག་གི་ཐ་སྙད་ཇི་ལྟར་འདོགས་ཤེ་ན།",
    "ཁ་དོག་དང་རི་མོ་ལྟ་བུ་ཡོན་ཏན་དང་།",
    "བུད་ཤིང་ལྟ་བུ་བསྲེག་བྱ་ལས་ལ་སོགས་པའི་རྣམ་བཞག་དང་།",
    "བྱེད་པ་པོ་མེ་ལྟ་བུ་ལ་སོགས་པའི་འཇིག་རྟེན་གྱི་བརྡ་ཐ་སྙད་ཀྱི་རྣམ་བཞག་གི་དོན་གང་ཡིན་པ་དེ་དག་ཐམས་ཅད་ལ་ཤིང་རྟའི་རྣམ་དཔྱད་ལྟར་བྱས་པས་རྣམ་པ་བདུན་གྱིས་ཚུལ་དུ་རང་བཞིན་གྱིས་གྲུབ་པ་བདེན་པ་གཉིས་ཆར་དུ་ཡོད་པ་མིན་ཞིང་།",
    "དེས་ན་རྒྱུ་འབྲས་ངོ་བོས་གྲུབ་ན་རྒྱུ་གང་ལས་འབྲས་བུ་གང་ཞིག་སྐྱེ་བར་འགྱུར་བ་རྒྱུ་འབྲས་དེ་གཉིས་གང་ཞིག་ལས་སྔར་གང་ཞིག་གྲུབ་པར་འགྱུར་བ་དེ་ཁྱོད་ཀྱིས་སྨྲོས་ཤིག།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་རྒྱུ་ཡིས་ཕྲད་ནས་འབྲས་བུ་སྐྱེད་བྱེད་ན།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་རྒྱུ་འབྲས་ངོ་བོ་ཉིད་ཀྱིས་གྲུབ་པར་འདོད་ན་རྒྱུ་ཡིས་འབྲས་བུ་ཕྲད་ནས་བསྐྱེད་དམ་མ་ཕྲད་པར་བསྐྱེད།",
    "གང་ཞིག་གང་གིས་བསྐྱེད་པར་འགྱུར་ཏེ་མི་འཐད་པར་འགྱུར་ཞིང་།",
    "ཁྱོད་ཀྱི་ལུགས་ལ་རྒྱུ་འབྲས་ཇི་ལྟར་ཞེ་ན།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "རང་བཞིན་མེད་ཀྱང་རབ་རིབ་ཅན་གྱིས་དམིགས་པའི་སྐྲ་ཤད་ལྟར་མ་དཔྱད་པའི་བློ་ངོར་སྣང་བ་ཙམ་ཡིན་པ་དེ་ཡི་ཕྱིར་རྒྱུ་དང་འབྲས་བུ་ཕྲད་དང་མ་ཕྲད་པ་ལ་སོགས་པ་བརྟགས་ནས་གནོད་བྱེད་བརྗོད་པ་དག་གིས་བདག་ལ་སྐྱོན་བརྗོད་དུ་མེད་ཅིང་།",
    "གཉིས་པ་ཐལ་བ་དེ་རང་གི་སུན་འབྱིན་ལ་ཡང་མཚུངས་པའི་རྩོད་སྤང་ལ།",
    "མཚུངས་པར་ཐལ་བས་རྩོད་པ་དང་།",
    "མ་འཕྲད་འབྱིན་ཞེས་སྐྱོན་འདི་ཁྱོད་ལའང་འབྱིན་མིན་ནམ།",
    "དེ་ཚེ་ཁྱོད་ཀྱིས་སུན་དབྱུང་སུན་འབྱིན་ནུས་མ་ཡིན།",
    "རང་གི་ཚིག་ལའང་ཐལ་བ་མཚུངས་པའི་ལྟག་ཆོད་ཀྱིས།",
    "ཁྱོད་ནི་སྐྱེ་བོ་དམ་པས་བཞེད་པར་མི་འགྱུར་ཞིང་།",
    "དེ་བཞིན་དུ་མིག་གིས་མ་ཕྲད་པ་ཁོ་ནར་ཡུལ་རུང་བ་ན་གནས་པའི་གཟུགས་མཐོང་གི་ཐམས་ཅད་མ་ཡིན་པ་དེ་བཞིན་དུ་རྒྱུས་ཀྱང་མ་ཕྲད་པར་འབྲས་བུ་སྐྱེད་དུ་ཟིན་ཀྱང་མ་ཕྲད་པ་ཐམས་ཅད་མི་སྐྱེད་ཀྱི་འབྲས་བུ་རུང་བ་ཁོ་ན་སྐྱེད་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་རིགས་པ་མེད་པར་རྒྱུ་འབྲས་ཀྱི་དངོས་པོ་ཀུན་ལ་སྐུར་པ་འདེབས་པ་དེའི་ཕྱིར་ཁྱོད་ནི་སྐྱེ་བོ་དམ་པ་རྣམས་ཀྱིས་བཞེད་པར་ཡང་མི་འགྱུར་ཞིང་ཞེས་ཞིང་ནི་སྐྱོན་གཞན་སྡུད་པའོ།",
    "ཡོད་པ་མིན་པས་ཐལ་བར་འགྱུར་བ་སྲིད་མ་ཡིན།",
    "འོན་ཏེ་མ་ཕྲད་པར་སུན་འབྱིན་བྱེད་ཅེས་དེ་ལྟར་དཔྱད་ན་ཁྱོད་རང་གི་ཚིག་ལའང་མཚུངས་སོ་ཞེས་སྨྲས་ཟིན་པའི་ཉེས་པ་འདི་ནི་རྒོལ་བ་གང་ལ་ངེས་པར་སུན་འབྱིན་དང་སུན་དབྱུང་བྱ་གཉིས་ཀ་རང་བཞིན་གྱིས་གྲུབ་བོ་ཞེས་ཕྱོགས་ཡོད་པར་སྨྲ་བ་དེ་ལའགྱུར་གྱི།",
    "དེས་ན་ཁྱོད་ཀྱི་ཐལ་བར་འགྱུར་བ་འདི་ནི་མཚུངས་པའི་གོ་སྐབས་སྲིད་པ་མ་ཡིན་ཏེ།",
    "དེར་ནི་མེད་ཀྱང་རང་གི་བྱད་བཞིན་མཛེས་པ་དག།",
    "དེ་ལ་བརྟེན་ནས་རང་གི་བྱད་བཞིན་མཛེས་པ་དང་མི་མཛེས་པའི་ཁྱད་པར་དག་སྒྲུབ་ཅིང་རྟོགས་པར་བྱེད་པ་དེ་བཞིན་དུ།",
    "གལ་ཏེ་རང་གི་གོ་བྱེད་གཏན་ཚིགས་དངོས་ཉིད་དང་།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གང་དག་མིག་དང་ཁབ་ལེན་ལ་སོགས་པ་མ་ཕྲད་པར་རང་གི་བྱ་བ་བྱེད་པར་རྣམ་པར་བཞག་པའི་དཔེ་དེ་དག་ཀྱང་བཀག་པར་རིགས་པར་བྱ་སྟེ།",
    "དེ་དག་ལའང་ཐལ་བར་འགྱུར་བ་མཚུངས་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་རྟོག་པ་ལྡོག་པ་ཉིད་བརྗོད་པར་འདོད་ཀྱི་དོན་དམ་པར་སུས་ཀྱང་རང་གི་ཕྱོགས་མ་བཞག་ཅིང་གཞན་གྱི་ཕྱོགས་བཟློག་པ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "རང་གི་ཚིག་ལ་ཐལ་བ་མཚུངས་པའི་རྩོད་པ་དང་།",
    "སུན་ཅི་ཕྱིན་དུ་རྒོལ་བར་ཐལ་བའི་རྩོད་པ་གཉིས་ལ་གནོད་བྱེད་དུ་བརྗོད་པའི་སུན་འབྱིན་གྱི་ལྷག་མ་དངོས་པོ་མཐའ་དག་ལ་སྐུར་པ་འདེབས་པར་ཐལ་བའི་རྩོད་པའི་སུན་འབྱིན་བདེན་གཉིས་ཀྱི་ལན་གྱི་ཕྱོགས་འདི་ཉིད་ཀྱིས་རྟོགས་པར་བྱ་སྟེ།",
    "ཐ་སྙད་དུ་རྟེན་འབྱུང་གི་སྐྱེ་བ་ཁས་བླངས་པ་ཡིན་ལ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་།",
    "ཡིན་ཕྱིར་མིག་ནི་མིག་གིས་སྟོང་།",
    "སྒྲ་དང་དྲི་རོ་རེག་བྱ་དང་།",
    "དོན་གཞན་གྱིས་སྟོང་པ་ལྟ་བུ་མིན་པར་གཟུགས་ནི་གཟུགས་རང་གི་ངོ་བོས་སྟོང་པ་ཡིན་ནོ།",
    "ཕྱི་དང་ནང་གི་སྐྱེ་མཆེད་གཉིས་ཀ་རང་གི་ངོ་བོས་སྟོང་པའི་རང་བཞིན་མེད་པ་གང་ཡིན་པ་དེ་ནི་ཕྱི་ནང་སྟོང་པ་ཉིད་ཡིན་ནོ།",
    "རང་གི་ངོ་བོས་སྟོང་པ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "དེས་ན་དོན་དམ་པ་ཞེས་བྱ་བ་ནི་མྱ་ངན་ལས་འདས་པ་ཡིན་ལ་དེ་ནི་དེ་ཡིས་ཏེ་རང་གི་ངོ་བོས་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ནི་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱའོ།",
    "འདུས་བྱས་ཀྱིས་བསྡུས་པའི་ཁམས་གསུམ་པོ་དེ་ཉིད་དེ་ཡིས་ཏེ་རང་གི་ངོ་བོས་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ནི་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བསྙད་དོ།",
    "ནམ་མཁའ་སོགས་འདུས་མ་བྱས་ཐམས་ཅད་ཀྱང་ལྟོས་ནས་བརྟགས་པ་ཙམ་ལས་དེ་ཡི་སྟེ་རང་གི་ངོ་བོས་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ནི་འདུས་མ་བྱས་སྟོང་པ་ཉིད་དོ།",
    "དོར་བ་མེད་པ་དེ་ཉིད་ཀྱིས་དེ་ཉིད་སྟོང་པ་གང་ཡིན་པ་སྟེ་རང་གི་ངོ་བོས་སྟོང་པས།",
    "འདིར་ནི་འཕགས་པའི་ཤེས་མཐོང་གིས་གསར་ཏུ་བྱས་སམ་སྙམ་པའི་དོགས་པ་བཟློག་པའི་ཕྱིར་བསྟན་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་།",
    "ཁམས་བཅོ་བརྒྱད་དང་རེག་དྲུག་དང་།",
    "མིག་ལ་སོགས་པ་ནང་གི་ཁམས་དྲུག་དང་།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་རྣམ་པར་ཤེས་པའི་ཁམས་དྲུག་སྟེ་ཁམས་བཅོ་བརྒྱད་དང་།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་ལ་སོགས་པ་རེག་པ་དྲུག་དང་།",
    "གནས་སྐབས་ཀྱི་ཁྱད་པར་ནི་ཀུན་སློང་གི་སེམས་ལས་གཞན་དུ་གཡེངས་བའི་གནས་སྐབས་དང་།",
    "མཚན་གཞི་ནི་སྡོམ་སྡོམ་མིན་བར་སྡོམ་ཐོབ་པའི་ལུས་ངག་གི་ལས་ཀྱི་བྱེ་བྲག་ཤིག་གོ།",
    "ཚོར་བ་ནི་དགེ་སྡིག་གི་རྣམ་སྨིན་སིམ་གདུང་སོགས་མྱོང་བའི་མཚན་ཉིད་ཅན་ནོ།",
    "རྟེན་གྱི་སྒོ་ནས་མིག་རྣ་སྣ་ལྕེ་ལུས་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་དྲུག་གམ།",
    "གཉིས་པ་ནི་འདི་ནི་སྐྱེས་པའོ་འདི་ནི་བུད་མེད་དོ་སྙམ་དུ་ཐ་སྙད་ཀྱི་སྤུ་རིས་སོ་སོར་ཕྱེ་ནས་འཛིན་པའོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་འདུ་ཤེས་ནས་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་འདུ་ཤེས་རྣམས་སོ།",
    "དབྱེ་ན་མིག་གི་རྣམ་པར་ཤེས་པ་ནས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་བར་གྱི་ཚོགས་དྲུག་སྟེ།",
    "དེ་ཡང་ཟག་བཅས་ཀྱི་ཕུང་པོ་ཙམ་གྱི་ལྡོག་པ་ནས་རང་གི་མཚན་ཉིད་ཀྱང་ཡིན་ནོ།",
    "ཕྱི་མ་ངན་སོང་དུ་མི་སྐྱེ་ཞིང་ལྷ་མིའི་བདེ་བ་དང་།",
    "གསུམ་པ་བདེ་གཤེགས་དགྱེས་པའི་བསམ་གཏན་ནི་ཤེས་བྱ་ཐམས་ཅད་མ་ལུས་པར་ཐུགས་སུ་ཆུད་ཅིང་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་མ་ལུས་པར་སྤངས་པས་ཅི་ལ་ཡང་རྣམ་པར་མི་རྟོག་པར་ལྷུན་གྱིས་གྲུབ་ནས་བདག་དང་གཞན་གྱི་དོན་མ་ལུས་པར་འཛིན་པའོ།",
    "དེ་ལྟར་ཕ་རོལ་དུ་ཕྱིན་པ་དྲུག་པོ་རྣམས་ཀྱི་རང་རང་གི་མཚན་ཉིད་ནི་བརྗོད་མ་ཐག་པ་འདི་དག་ཡིན་པར་བརྗོད་དོ།",
    "སྙོམས་འཇུག་གི་སྒྲིབ་པ་ལས་རྣམ་པར་གྲོལ་བར་བྱེད་པའོ།",
    "གཞན་ཡང་འགྲོ་བ་མ་ལུས་པ་རྣམས་ལ་གནས་སྐབས་དང་མཐར་ཐུག་གི་ཕན་པ་མཐའ་དག་ཉེ་བར་བསྒྲུབ་པར་བྱེད་པ་ནི་མཐར་ཐུག་གི་བྱམས་པ་ཆེན་པོའི་མཚན་ཉིད་ཞེས་བྱའོ།",
    "དུས་གསུམ་གྱི་ཤེས་བྱ་ལ་མ་ཆགས་མ་ཐོགས་པའི་ཡེ་ཤེས་ཀྱི་གཟིགས་པ་འཇུག་པའོ།",
    "མི་དམིགས་པ་དེ་ཉིད་རང་གི་ངོ་བོ་དེ་ཡིས་སྟོང་ཞིང་དབེན་པ་ཉིད་གང་ཡིན་པ་དེ་ནི་ཐེར་ཟུག་ཏུ་གནས་པའི་རྟག་བརྟན་དང་།",
    "དེ་ཡི་རང་གི་ངོ་བོ་གྲུབ་པ་མེད་པས་འདུས་པ་པ་ནི་དེ་ཉིད་ཀྱིས་སྟོང་པ་ཉིད་ཡིན་ལ།",
    "རང་གི་ངོ་བོས་སྟོང་པ།",
    "རང་གི་ལག་ན་གནས་པའི་སྐྱུ་རུ་ར་བཞིན་དུ།",
    "རྟག་ཏུ་འགོག་པར་གཏོགས་པའི་བསམ་ལྡན་ཡིན་མོད་ཀྱི།",
    "རང་གི་ལག་ན་གནས་པའི་སྐྱུ་རུ་ར་ཕྱི་ནང་མ་བསྒྲིབས་པར་གསལ་བར་སྣང་བ་བཞིན་དུ་སྲིད་གསུམ་འདི་དག་མ་ལུས་པ་གདོད་ནས་སྐྱེ་བ་མེད་པ་མངོན་སུམ་དུ་རྟོགས་ཏེ།",
    "ས་བདུན་པ་རིང་དུ་སོང་བ།",
    "གྲུ་ཆེན་པོ་རྒྱ་མཚོར་མ་ཐུག་གི་བར་དུ་སྐྱེས་བུས་རྩོལ་བས་འགྲོ་བ་དང་།",
    "ཟབ་མོའི་རྣམ་པ་དང་བློ་རྗེས་མཐུན་པ་སྦྱོར་ལམ་བཟོད་པ།",
    "ཟབ་མོ་མངོན་སུམ་རྟོགས་པ་མཐོང་ལམ་བཟོད་པ།",
    "ཟབ་མོའི་དོན་ལ་ཡུལ་དང་ཡུལ་ཅན་གཉིས་མེད་དུ་འདྲེས་ཤིང་གཉིས་སྣང་གི་གཡོ་རྩོལ་རག་པ་ནུབ་པས་བཟོད་པ་ཆེན་པོ་ས་འདིར་ཐོབ་པའོ།",
    "འདིར་ཞིང་གི་སྒྲས་ནི་ལྷག་མ་སྡུད་པའོ།",
    "ད་དུང་ཁྱོད་ལ་མེད་ཀྱི་འབད་རྩོལ་བརྩོན་འགྲུས་བརྩམ།",
    "དེ་ལྟར་ཉོན་མོངས་པ་ས་བོན་དང་བཅས་པ་ཟད་ཅིང་སྤངས་པས་ཁམས་གསུམ་ལས་འདས་ཏེ་མར་གྱུར་དུ་ཟིན་ཀྱང་།",
    "སྲིད་པའི་འགྲོ་བར་རང་གི་བདག་ཉིད་སྣ་ཚོགས་སྟོན་པར་བྱེད་པར་འགྱུར།",
    "བྱང་སེམས་རང་གི་སྐུ་གསུང་ཐུགས་ཀྱི་བདག་ཉིད་ཀྱི་ཆོ་འཕྲུལ་སྣ་ཚོགས་སྟོན་པར་བྱེད་པར་འགྱུར་རོ།",
    "བསམ་པའི་སྟོབས་ནི་ཉོན་མོངས་པ་ཀུན་ཏུ་སྤྱོད་པ་མེད་པ།",
    "སྐད་ཅིག་གཅིག་གིས་ཞིང་ཐ་དད་པར་ཐོགས་མེད་བགྲོད་ནུས་པས་ཀུན་ཏུ་མྱུར་བའི་རྫུ་འཕྲུལ་གྱི་སྟོབས་རྣམས་དང་།",
    "དེ་ནི་རང་གི་ལུས་བརྒྱ་སྟོན་བྱེད་ཅིང་།",
    "མཛེས་པའི་ལུས་རེ་ལ་ཡང་རང་གི་འཁོར།",
    "སྐད་ཅིག་མ་དེ་ཉིད་ལ་སྔོན་འདས་པའི་བསྐལ་པ་བརྒྱ་དང་ཕྱི་མའི་བསྐལ་པ་བརྒྱའི་མཐར་ཡང་ཡེ་ཤེས་ཀྱིས་གཟིགས་པ་ཡང་དག་པར་འཇུག་ཅིང་།",
    "བྱང་སེམས་དེ་ཡིས་ནི་རང་གི་སྤྲུལ་གཞིའི་ལུས་གཅིག་ལ་སྤྲུལ་པའི་ལུས་བརྒྱ་རེ་དག་སྐད་ཅིག་གཅིག་ལ་སྟོན་པར་བྱེད་ཅིང་།",
    "དེ་ཡང་རང་རང་གི་འཁོར་དང་བཅས་པས་མཛེས་ཤིང་འབྱོར་བས་བརྒྱན་པའི་གཙོ་བོའི་ལུས་རེ་རེ་ལ་ཡང་རང་གི་འཁོར་རྒྱལ་བའི་སྲས་པོ་བརྒྱ་ཕྲག་རེ་རེ་དང་ལྡན་པར་སྐད་ཅིག་རེ་ལ་སྟོན་པར་བྱེད་དོ།",
    "ས་གཉིས་པ་ནས་བདུན་པའི་བར་མ་དག་ས་དྲུག་ལ་གོང་གི་གྲངས་འགྱུར་གྱིས་བསྒྲེ་བ་དང་།",
    "དང་པོའི་ས་ལ་གནས་པས་ཡོན་ཏན་གྱི་རིགས་བཅུ་གཉིས་པོ་བརྒྱ་ཕྲག་རེ་ཐོབ་པ་དེ་བཞིན་ས་གཉིས་པ་དྲི་མ་མེད་པ་ཐོབ་པར་གྱུར་པའི་ཡོན་ཏན་གྱི་རིགས་ཀྱང་བཅུ་གཉིས་པོ་དེ་དག་སྟོང་ཕྲག་ནི་ཡང་དག་པར་འཐོབ་པར་འགྱུར་ཏེ།",
    "སེམས་བསྐྱེད་པ་བརྒྱད་པ་མི་གཡོ་བའི་སར་གནས་པ་འདུ་ཤེས་གཉིས་ཀྱི་རྣམ་རྟོག་མེད་པ་དེས་ནི་གོང་གི་ཡོན་ཏན་དེ་དག་ནི།",
    "རེ་ཞིག་བཅུ་པ་འདིར་དེའི་ཡོན་ཏན་དག།",
    "ངག་གི་སྤྱོད་ཡུལ་ལས་ཆེས་འདས་གྱུར་ཞིང་།",
    "ངག་གི་སྤྱོད་ཡུལ་མ་ཡིན་བསྡོམས་རྣམས་ལ།",
    "དེའི་ཕྱིར་ངག་གི་སྤྱོད་ཡུལ་མ་ཡིན་པའི་སྟོང་གསུམ་གྱི་ཞིང་བརྗོད་དུ་མེད་པའི་ཡང་བརྗོད་དུ་མེད་པ་བསྡོམས་པ་རྣམས་ལ།",
    "རེ་ཞིག་ཞེས་པའི་སྒྲ་དེས་ཡོན་ཏན་དེ་ཙམ་ཁོ་ནར་མ་ཟད་གཞན་ཡང་ཡོད་པར་བརྗོད་པའི་གོ་རིམ་སྟོན་པའོ།",
    "ཀྱང་གི་སྒྲས་བསྡུས་པ་བརྒྱ་བྱིན་དང་ཚངས་པ་སོགས་སོ།",
    "སྐྱིལ་ཀྲུང་གཅིག་གིས་ཞིང་ཁམས་ཐམས་ཅད་ཁྱབ་པར་བྱེད་པ་སོགས་ལུས་ཀྱི་ལས་དང་།",
    "ཏིང་ངེ་འཛིན་གཅིག་གིས་ཏིང་ངེ་འཛིན་དཔག་ཏུ་མེད་པ་བསྒྲུབ་པ་ལ་སོགས་ཡིད་ཀྱི་ལས་སོགས་ཞེས་པའི་དོན་སྡུད་པའོ།",
    "སྔོན་ཚེ་སྟོབས་བཅུ་བསྐྱེད་པའི་ས་ལ་ཁྱོད་ཀྱིས་སླར་ཡང་འབད་གྱུར་ཅིང་།",
    "འོག་མིན་དུ་ནི་གང་གི་དོན་དུ་འབད་གྱུར་གོ་འཕང་མཆོག་ཞི་བ།",
    "ཡོན་ཏན་ཀུན་གྱི་མཐར་ཐུག་མཚུངས་པ་མེད་དེ་ཁྱོད་ཀྱིས་བརྙེས།",
    "དེ་ཡང་གང་གི་དོན་དུ་འབད་པར་གྱུར་པའི་རྣམ་མཁྱེན་ཉིད་ནི་གནས་གང་དུ་མངོན་དུ་བྱས་པ་ནི།",
    "འོག་མིན་དུ་ནི་ཐོབ་བྱ་རྣམ་མཁྱེན་གྱི་ཡེ་ཤེས་རྒྱ་མཚོ་ལྟ་བུ་གང་གི་དོན་དུ་འབད་པར་གྱུར་པའི་གོ་འཕང་མཆོག་སྤྲོས་པ་ཐམས་ཅད་ཉེ་བར་ཞི་བ་སྟོབས་སོགས་ཡོན་ཏན་ཀུན་གྱི་མཐར་ཐུག་པ་སྟེ་རྩལ་ཡོངས་སུ་རྫོགས་པ།",
    "གང་དང་ཡང་མཚུངས་པ་མེད་པ་དེ་བཅོམ་ལྡན་འདས་ཁྱོད་ཀྱིས་བརྙེས་པར་གྱུར་ཏོ།",
    "མཁྱེན་བཟང་ཁྱོད་ཀྱིས་སྐད་ཅིག་གིས་ནི་ཤེས་བྱ་མ་ལུས་ཐུགས་སུ་ཆུད།",
    "མི་སྒྲིབ་པར་མཚུངས་པས་དེར་གཏོགས་པའི་ནམ་མཁའ་ལ་དབྱེ་བ་ཐ་དད་པ་མེད་པ་དེ་ལྟར་གཟུགས་དང་ཚོར་བ་ལ་སོགས་པའི་དངོས་པོ་ཐ་དད་ཀྱང་སྐྱེ་མེད་དུ་མཚུངས་པས།",
    "ཤེས་བྱ་ཐམས་ཅད་སྟོང་པ་ཉིད་དུ་རོ་མཉམ་པའམ་རོ་གཅིག་པ་ཉིད་དུ་ཡང་དག་པར་ཐུགས་སུ་ཆུད་པར་མཛད་པར་གྱུར་ནས་མཁྱེན་བཟང་ཁྱོད་ཀྱིས་མཁྱེན་པའི་སྐད་ཅིག་གཅིག་གིས་ནི་ཤེས་བྱ་མ་ལུས་པའི་དེ་ཁོ་ན་ཉིད་ཐུགས་སུ་ཆུད་ནས་ཐམས་ཅད་མཁྱེན་པའི་གོ་འཕང་བརྙེས་སོ།",
    "མཁྱེན་པ་མེད་པར་ཁྱོད་ཀྱིས་གཞན་ལ་འདི་ལྟའོ་ཞེས་སུ་ཞིག་སྟོན།",
    "ཇི་ལྟར་སེམས་ནི་གང་གི་རྣམ་པ་ཅན་དུ་གྱུར་པ་དེ་ཡིས་ཡུལ།",
    "དཔེ་ཇི་ལྟར་ན་རྣམ་པར་ཤེས་པའམ་སེམས་ནི་ཡུལ་ཨུཏྤལ་སྔོན་པོ་ལྟ་བུ་གང་གི་རྣམ་པ་ཅན་དུ་སྐྱེ་བར་གྱུར་པ་ན་སེམས་དེ་ཡིས་ཡུལ་སྔོན་པོ་དེ་ཡོངས་སུ་ཤེས་སོ་ཞེས་བརྗོད་པ་འཇིག་རྟེན་ན་རབ་ཏུ་གྲགས་པ་དེ་བཞིན་དུ།",
    "དེ་བསྐོར་བའི་རྩོལ་བ་ད་ལྟ་སྐྱེས་པ་མེད་བཞིན་དུའང་སྔོན་གྱི་རྩོལ་བ་ལེགས་པའི་ཤུགས་ཀྱིས་འཁོར་ལོ་ངང་གིས་འཁོར་ཞིང་།",
    "ཤེས་བྱའི་བུད་ཤིང་སྐམ་པོ་མ་ལུས་པ།",
    "སྤངས་པའི་ཁྱད་པར་མཐར་འཛིན་གྱི་རྟོག་པས་བཏགས་པའི་ཤེས་བྱའི་བུད་ཤིང་སྐམ་པོ་མ་ལུས་པ་རྣམ་པར་དཔྱོད་པ་ལས་བྱུང་བའི་ཡེ་ཤེས་ཀྱི་མེས་བསྲེགས་པས་རྟོག་པ་མཐའ་དག་ཞི་བ་དང་།",
    "བསམ་མི་ཁྱབ་འགྱུར་གྱི་འཆི་འཕོ་དང་སྐྱེ་བ་ལས་འདས་ཏེ་མཐར་ཐུག་གི་འདུས་མ་བྱས་ཆེན་པོ་ཞི་བའི་དབྱིངས་མངོན་དུ་གྱུར་པས་སོ།",
    "སྐུའི་བ་སྤུའི་ཁུང་བུར་རང་གི་སྤྱོད་པ་ཀུན་སྟོན་ཚུལ།",
    "གཟུགས་སྐུ་གཅིག་ལ་རང་གི་སྐྱེ་གནས་སྐབས།",
    "དེ་དག་གི་སྐུ་དང་སྤྱོད་པ་དག་གི་མཐུ་སྟོབས་ཕུལ་དུ་བྱུང་བ་ཇི་འདྲ་དང་།",
    "དེ་ལྟར་སྐུ་གཅིག་ལ་དུས་ཅིག་ཆར་དུ་གནས་སྐབས་ཐམས་ཅད་སྟོན་པར་མ་ཟད་སྔོན་རང་ཉིད་ཀྱི་སྤྱོད་པ་མ་ལུས་པ་ཀུན་སྐུ་ཡི་བ་སྤུའི་ཁུང་བུ་རེ་རེར་ཡང་ཤིན་ཏུ་གསལ་བར་སྟོན་པར་མཛད་པའོ།",
    "དེ་དག་སོ་སོའི་སྐྱེ་བོའི་གནས་སྐབས་ཀྱི་སྤྱོད་པ་ནི་ཐམས་ཅད་ཀྱང་བ་སྤུའི་ཁུང་བུར་དུས་སྐད་ཅིག་མ་གཅིག་གི་ཚེ་སྟོན་པར་བྱེད་དོ།",
    "འཇིག་རྟེན་མཐའ་ཡས་ཕྱོགས་ཁྱབ་རྡུལ་སྟོན་མོད།",
    "རྣམ་རྟོག་མི་མངའ་ཁྱོད་ཀྱིས་སྲིད་མཐའི་བར།",
    "སྐད་ཅིག་རེ་ལ་སྟོན་མཛད་སྤྱོད་པ་ཡི།",
    "རྣམ་པ་སྣ་ཚོགས་དེ་སྙེད་འཛམ་གླིང་གི།",
    "མོས་པ་སྣ་ཚོགས་ཐུགས་ཆུད་དང་།",
    "དེ་ལས་གཞན་རྣམས་ཀྱིས་བསྒྲིབས་མོས་པའང་མཁྱེན་པ་ནི།",
