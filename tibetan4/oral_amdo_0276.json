    "བདག་གི་ཚུལ་མིན་དེ་ལ་བརྗོད་ན་ལྡོག་ཏེ་བརྗོད་པ་དེ་ལ་སྨད་སྒྲ་མི་འཇུག་སྟེ།",
    "བུད་མེད་རྣམས་ལ་རྒྱན་དང་ཁ་དོག་མཛེས་པའི་གཏམ་དང་།",
    "ཞིང་པ་རྣམས་ལ་ཞིང་དང་སྟོན་ཐོག་གི་གཏམ་དང་།",
    "ཚོང་པ་རྣམས་ལ་ཚོང་གི་གཏམ་དང་།",
    "བུད་མེད་རྣམས་ལ་རྒྱན་དང་ཁ་དོག་ལ་སོགས་གཏམ་བརྗོད་དོ།",
    "དཔའ་ལ་གཡུལ་ངོ་བུད་མེད་རྒྱན།",
    "རང་ཉིད་དམ་རང་གི་ངོ་བོ་ལུས་དང་།",
    "ཡིད་བཟང་བ་ཙམ་གྱིས་བསྟོད་པ་ནི་རང་གི་ངོ་བོས་སྒོ་ནས་བསྟོད་པ་ཡིན་ལ།",
    "རང་གི་ངོ་བོ་ལུས་ངག་དང་།",
    "དེ་འདྲ་ཁྱོད་ཉིད་ཡིན་ནོ་ཞེས།",
    "ཡང་ན་ཐམས་ཅད་ཀྱང་རེ་རེ་སོ་སོར་སྦྱར་བར་བྱ་ཞིང་།",
    "དེར་རྗེས་བསྟོད་ཚིག་སྨད་ཚིག་སོགས་སུ་སོང་མ་སོང་ལེགས་པར་བརྟགས་ལ་བྱ་དགོས་ཏེ།",
    "རྐང་པ་གཉིས་ནས་དྲུག་གི་བར།",
    "གཞན་ཀུན་གྱི་གོ་ཞིང་རང་གི་བརྗོད་པ་བདེ་ལ་ཕ་རོལ་གྱི་དོན་མཐུན་ལ་དཔེ་དང་དོན་འགྲིག་པ།",
    "སྐྱེ་བོ་བློ་གྲོས་དང་ལྡན་པ་དག་གིས་ཁོ་བོས་བྱས་པའི་བསྟན་བཅོས་སུ་གུས་པས་བསྟེན་ཏེ།",
    "ཕྱིས་ནས་རང་གི་ཚིགས་བཅད་དང་།",
    "ཚིག་གི་ངོ་བོ་དང་།",
    "ཕྱི་ནས་རང་གིས་ལེགས་སྦྱངས་ན།",
    "རོལ་མོའི་བསྟན་བཅོས་ལས་ཚིག་སྦྱོར་ལེའུ་སྟེ་གཉིས་པའོ།",
    "ངག་གི་བྱེ་བྲག་དབྱེ་བཅས་བཤད།",
    "ཞར་བྱུང་རྐྱེན་གཞན་རོལ་མོ་བཤད།",
    "དབྱངས་དང་ཚིག་གི་དོན་ཤེས་པས།",
    "པུས་བཙུགས་ཐལ་མོ་སྦྱར་ཏེ་འདུད།",
    "སྒོམ་ནས་རྟོགས་པ་བརྗོད་པ་ལ་རང་གི་ལེགས་པར་གོ་བའི་ཚུལ་དང་།",
    "གཞན་ལ་རྗེས་སུ་གདམས་པ་ལ་མན་ངག་གི་ཚུལ་དང་།",
    "སྐྱེས་པ་དང་བུད་མེད་ལ་སོགས་པའི་ཁྱད་པར་དང་།",
    "སྐྱེས་དང་བུད་མེད་ལ་སོགས་པའི།",
    "ཕོ་མོའི་སྒོ་ནས་རྒྱས་པར་བཤད།",
    "མཐར་མ་ངེས་ཀྱང་ཕལ་ཆེ་བ་བུད་མེད་རྣམས་ཀྱི་སྐད་ཕྲ་ཞིང་།",
    "ཕལ་ཆེར་བུད་མེད་རྣམས་ཀྱི་ཕྲ།",
    "གཞན་ཡང་ཚོགས་སུ་ལེན་པའི་དབྱངས་ལ་སེང་གེའི་ང་རོ་ཞེས་བྱ་སྟེ།",
    "ཆགས་ཤིང་མཛེས་པ་ལྷ་མོའི་དབྱངས།",
    "ཚིག་གི་བདེ་འཇམ་མང་ན་ཐ་མལ་སྐྱོ་བས་དོན་གོ་མེད་ལ།",
    "ཚིག་དོན་གང་ལའང་ཧ་ཅང་ཐལ་ན་མཁས་པ་ཁྲེལ།",
    "ཧ་ཅང་ཐལ་ན་མཁས་པས་ཁྲེལ།",
    "འགྱུར་དང་ཁུགས་འབྱོངས་པས་རང་གི་ངག་ལ་བྱམས།",
    "ཚིག་གི་སྦྱོར་ལེགས་པས་ཕ་རོལ་གཞན་ལ་སྙན།",
    "བློ་སྐྱོན་དེ་དག་ཏུ་མ་ཟད་ཚིག་གི་ཟུར་མ་ཕྱིན་པ་དང་།",
    "ཚིག་གི་གཅོད་མཚམས་ནོར་བ་རྣམས་ཚིག་སྐྱོན་ཡིན་པས་དེ་དག་དང་བྲལ་བ་དགོས་སོ།",
    "གཅོད་མཚམས་ནོར་པ་ཚིག་གི་སྐྱོན།",
    "གཞན་ཡང་དབྱངས་ལ་རེས་ཆེས་རེས་ཆུང་བ་ཅན་གྱི་འཕེལ་འགྲིབ་བྱེད་པ་དང་།",
    "དབྱངས་དཔོན་གདོང་ལ་ཁྱོད་མ་འགྲོ།",
    "ངལ་བསོ་གཞུག་ལ་ཁྱོད་མ་འདྲེན།",
    "དེ་དག་གི་དོན་གཞུང་འདིར་སྟོན་པ་ལ།",
    "ཡིད་མ་རེངས་པ་དང་།",
    "ཆེད་ཆེར་མི་འཛིན་མ་རེངས་དང་།",
    "དུས་དང་ཚོད་མེད་པའམ་མི་ཤེས་ན་ཐ་མལ་པ་སྐྱོ་བ་སྐྱེ་བའི་རྒྱུ།",
    "དེ་ལྟར་ལྷན་སྐྱེས་ཀྱི་རོལ་མོ་དབྱངས་ཀྱི་རྣམ་གཞག་ལེགས་པར་ཤེས་ནས་ཕ་རོལ་གྱི་རྐྱེན་གཞན་ལས་བྱུང་བའི་རོལ་མོ་རྔ་དང་གླིང་བུ་ལ་སོགས་པའི་རྣམ་གཞག་རྣམས་ལ་ཡང་མཁས་པར་བྱ་བའི་ཕྱིར་འབད་པར་གྱིས་ཤིག་ཅེས་གདམས་པ་དེ་སྟོན་པ་ལ།",
    "འོ་ན་འབད་པར་བྱ་བའི་ཕ་རོལ་གྱི་རོལ་མོ་དེ་ཇི་ལྟར་ཡིན་ཞེ་ན།",
    "དེ་དག་ལ་མཁས་པར་བྱ་བའི་ཕྱིར་ཕྱི་ནས་རོལ་མོ་དེ་དག་ཀུན་འདུས་པའམ།",
    "ཕྱི་ནས་རོལ་མོ་ཀུན་འདུས་པའམ།",
    "འདི་ལྟ་བུའི་རོལ་མོའི་རྣམ་གཞག་རྒྱ་གར་དབུས་འགྱུར་ཚལ་ན་གཏམ་བརྒྱུད་ཀྱི་ཟློས་གར་བྱེད་པའི་གར་མཁན་རྣམས་ཀྱིས་ཐམས་ཅད་སྦྱོར་བ་བྱེད་ཅིང་།",
    "གཞན་གྱི་དོན་ལ་ཆེད་དུ་བསམ་པས་ཟིན་པ་ལ་ནི་ཉེས་པ་མེད་མོད།"
  ]
}