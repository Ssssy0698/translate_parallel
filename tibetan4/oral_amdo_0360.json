    "ཚན་ཏ་སཱ་༧ ༤ཀ་ཆེན་རིལ་ནག་ཆེན་མོ་དང་།",
    "ལི་ཤི་བུམ་པ་ཅན་ལ་སོགས་པ་སྟོབས་འབྱོར་ཆེ་བར་རློམ་པ་དག་གི་མཛོད་དུ་ཡང་སྔར་ཕན་མ་འབྱོར་ཞིང་།",
    "དཀའ་བའི་གནས་ལ་འདྲི་མོལ་ཞིབ་པར་ཞུས་ལ་ཟིན་བྲིས་ཏི་ཐུག་པའི་ལུགས་སུ་ཐོབ་ཤིག་ཞེས་བསྒོས་པ་ལྟར་ཟིན་རིས་ཉུང་ངུ་རྣམ་གསལ་ཡང་དག་རྫོགས་ཀྱི་མཚན་ཉིད་ཅན་འདི་བཞིན་གྲུབ་འདུག་པ་ལ་ཁོང་པར་ཞིབ་དྲིས་ཀྱིས་གཏན་ལ་ཕབ་ཏེ།",
    "སྒ་པི་ཕོ་གསུམ་མ་འདྲེས་པར་སོ་སོར་བརྡུངས་པའི་ཕྱེ་མ་གསུམ་པོ་ཐང་ཁུག་ནང་དུ་སོ་སོར་ཆུ་གཙང་གིས་ནེམ་ཙམ་སྦྱངས་ལ་ཡུད་ཙམ་མཉེ།",
    "དེ་ནས་དངུལ་ཆུ་སྲང་ལ་འདེགས་ཏེ་ད་ལེན་འདི་སྐབས་སྲང་བརྒྱ་ཐམ་པ་ཡིན་ཡང་སྲང་གང་གི་ཚད་དུ་བྱ་ཞིང་དེས་འགྲེ་དགོས་པ་སྟེ།",
    "ལར་འདི་སྐབས་དང་འོག་གི་ཀླུ་ར་རྣམ་ལྔ་ཚྭ་བུལ་སོགས་ཐམས་ཅད་དང་དངུལ་ཆུ་ཕྱེ་སྐབས་དཀའ་ཚེགས་ལ་མི་ལྟ་བར་རྟོག་པ་ཤིན་ཏུ་ཞིབ་དགོས་པ་དང་།",
    "དངུལ་ཆུའི་དུག་གིས་མི་གནོད་པའི་ཕྱིར་ཆང་སོགས་བཏུང་།",
    "དེ་ནས་རྫས་དེ་དང་ཕྱེ་སྐབས་དངུལ་ཆུ་དང་ཚ་བུལ་སོགས་འདྲེས་པར་ཡོད་པས་ཆུ་སྐོལ་ཚ་མོ་བླུགས་ལ་སྣོད་གཅིག་ཏུ་ཆུ་རྣམས་ཁ་ནས་རིམ་བཞིན་བླང་ལ་ཆུ་སྐོལ་ཡང་ཡང་བླུགས་ཆུ་དེ་ཡང་གོང་བཞིན་ཡང་ཡང་བཙགས་དགོས་དེ་ནས་ཚྭ་བུལ་རྣམས་ཞུ་ནས་ཆུར་སོང་བ་དང་ཞུ་མ་ཐུབ་པའི་སྙིགས་མ་ནང་དུ་དངུལ་ཆུ་སྲོ་མ་ལྟ་བུ་དང་།",
    "དངུལ་ཆུ་སྲང་རེར་ན་རཀྵ་ར་སྟེ་ཕྲུ་གུ་ལོ་བརྒྱད་པའི་དྲི་ཆུ་ཁྱོར་བ་གང་རེ་དང་བཅས་རྡོ་གཞོང་དུ་བླུགས།",
    "སྟར་བུའི་ཁཎྜ་ཉུང་ཙམ་རེ་བཅས་བཏབ་ལ་འདུལ།",
    "དྲི་ཆུ་དང་བུལ་ཏོག་སྟར་ཁཎ་རྣམས་ལན་གསུམ་བརྗེ་དགོས་ཤིང་བརྗེ་སྐབས་དངུལ་ཆུ་དང་དྲི་ཆུའི་ནང་དུ་ཆུ་སྐོལ་མང་བར་བླུགས་ཤིང་དག་པར་བཀྲུས་བ་མ་ས་ལ་ས་པས་ཡས་མས་ནས་བཟའ་བ་ཀ་ལ་ལ་ཡང་གོང་གི་དྲི་ཆུ་སྟར་ཁཎ་གསུམ་པོ་ཚད་སྔར་བཞིན་བཏབ་ལ་འདུལ།",
    "དེ་ནས་སྟར་བུལ་གྱི་རོ་མ་དག་པར་བྱས་ལ་དངུལ་ཆུ་དེ་ལྕགས་རྫིའམ་ཁྲོ་ཆུང་གི་ནང་དུ་བླུགས།",
    "དེ་ནང་དུ་སྟར་ཆུ་ཚ་མོ་དངུལ་ཆུ་ནུབ་ངེས་ཙམ་བླུགས་ལ་ཞབས་སུ་གདན་འབོལ་པོ་བཏིང་།",
    "ཁ་ཆོད་ལེགས་པར་བསྒྲིགས་སྟེང་ནས་གོས་ཀྱིས་བཀབ་ན་ནུབ་མོ་བསྙལ།",
    "འདི་སྐབས་ནས་བཟུང་བཙོ་མ་རན་གྱི་བར་དུ་ནུབ་མོ་སྟར་ཁུའི་ནང་དུ་བསྙལ་བ་ལས་རྐྱང་པར་བཞག་མི་ཆོག་གོ།",
    "ཉིན་བཅུ་གསུམ་པ་དང་བཅུ་བཞི་པར་སྒོག་པ་གཏུན་དུ་བརྡུངས་པ་ཆུ་ནང་དུ་བཏབ་ལ་བསྐོལ་བའི་ཁུ་བ་སྙིགས་མ་མ་སོང་བར་རས་ཚགས་སོགས་ལ་དྲངས་ནས་དེ་ནང་དུ་འདུལ་ལན་གཉིས་བརྗེ།",
    "དང་པོ་བཙོ་སྣོད་རྡོ་ཁོག་པར་བུའི་དབྱིབས་ཅན་ཁ་དོག་ཅིང་ལྟོ་བ་ལྡིར་བ་ནང་འཇམ་པོ་ཞིག་གི་ནང་དུ།",
    "ནོར་ལུག་གི་རྐང་མར།",
    "ཁ་རས་རྐང་བཟང་གིས་བཀབ་ལ་ཐག་པས་བསྡམ།",
    "ཉིན་བཞི་མཚན་བཞི་བཙོ་ཞིང་ནང་རེ་བཞིན་ཚིལ་ལྔའི་ཞུན་མར་རྡོག་པོ་རེ་བཏབ་ཆུ་སབ་པ་སོགས་བྱེད་ནས།",
    "སླར་ཅོང་ཞི་དང་ཕྱེ་སྐབས་རྡོ་ཁོག་ཐང་དུ་ཕོག་གྲང་བར་བྱས་ནས་སྐྱོག་ཆུང་གིས་རྡོ་ཁོག་པ་ནས་སྣུམ་ཚུར་བླང་།",
    "སླར་ཡང་ཆུ་ཁོལ་ཤིན་ཏུ་ཚ་མོས་ཡང་ཡང་བཀྲུ་བཤལ་བྱས་ལ་སྣུམ་དང་བཀྲུ་བཤལ་བྱས་པའི་ཆུ་རྣམས་ཀྱི་ནང་དངུལ་ཆུ་མི་འགྲོ་བའི་ཐབས་སྔར་གཡའ་ཁུ་འདོན་པ་སོགས་ཀྱི་སྐབས་དང་འདྲ་ཞིང་དེ་ནས་ཅོང་ཞི་དངུལ་ཆུ་གཉིས་པོ་རས་སམ་ལ་ད་སོགས་ཀྱི་ཚགས་ལ་བརྒྱབ་པས་ཅོང་ཞི་ལུས་ནས་དངུལ་ཆུ་དོན་ཡོང་བ་དང་།",
    "ཅོང་ཞི་དང་རྡོ་ཁོག་ངོས་ལ་དངུལ་ཆུ་ཅུང་ཟད་རེ་འབྱར་བ་བྱུང་ན་ཤིང་ཐལ་བཏབ་ལ་གོང་བཞིན་འཕུར་དགོས་པ་དེ་ནི་བཙོ་ཆེན་གྱི་སྐབས་སོ།",
    "སྐམ་པོ་རྡོ་གཞོང་དུ་ལེགས་པར་བཏུལ་བའི་ཕྱེ་མ་ཐུར་ཁམས་པ་ལ་ཨ་མ་མ་ཁབ་ཟླ་པ་པ་༤ མ་ན་པ་ས་མགོ་གསུམ་དང་།",
    "དེ་ནང་དུ་དན་རོག་གི་སྙམ་རྙེད་ན་ལེགས་ཤིང་མ་རྙེད་ཚེ་སྣུམ་ནག་དངུལ་ཆུ་ནུབ་ངེས་དངུལ་ཆུའི་ཁར་ཚོན་གང་ཙམ་ལས་མཐོ་བ་བླུགས་ལ་སྣུམ་འཐག་པ་དང་ཁ་སབ་ལུགས་གོང་བཞིན་ཚད་ཐུར་ལ་བརྟགས་ནས་སབ་ཉིན་གཅིག་ཞག་གཅིག་བཙོ།",
    "འདི་སྐབས་ཁོལ་ཆེན་ན་དངུལ་ཆུ་ཐག་སྒྲ་དང་བཅས་སྲོ་མ་ལྟ་བུ་དེ་ཡར་དོགས་ཡོད་པས་མེ་ཤེད་ཆེ་མི་ཉན་པས་དེ་ནི་བཙོ་ཆུང་གི་སྐབས་སོ།",
    "དེ་ནས་སྔར་བཞིན་རྡོ་ཁོག་གྲང་སར་བཞག་གྲང་ནས་ཀ་ཊོ་རའི་ནང་དུ་ཚུར་བླུགས་ལ་ཁ་ནས་རིམ་བཞིན་སྐྱོགས་ཆུང་གིས་སྣུམ་བླང་།",
    "སླར་ཡང་ཁམས་བརྒྱད་ཀྱི་སྙིགས་མ་དང་སྣུམ་རོལ་སོགས་དག་པར་བྱ་བའི་ཕྱིར་ཆུ་གྲང་གིས་ཡང་ཡང་བཀུ།",
    "དཔེར་ན་དངུལ་ཆུ་སྲང་དགུ་བཅུ་ལ་ལྕགས་བརྒྱད་ཐལ་བ་སོ་སོ་ནས་ཞོ་གསུམ་རེ་བསྡོམས་པས་ཞོ་ཉེར་བདུན་དང་།",
    "ཁམས་བརྒྱད་ཐལ་བ་ཞོ་ཉེར་བཞི་དང་།",
    "ནུབ་མོའི་རིགས་སུ་ཐལ་རྡུལ་མི་འགྲོ་བའི་ཐབས་ཤོག་བུ་སོགས་ཀྱིས་ཁ་བཀབ།",
    "ཞག་ཚར་བའི་རྟགས་ཆུ་ཁར་སྤྲིན་བཞིན་ཆགས་པ་དང་ཞབས་སུ་སྙིགས་མ་མེད་པ་དེ་བཞིན་བྱུང་ཚེ་ཁ་ཤའམ་གླ་ལྤགས་ཀྱི་ཁུད་དུ་བཏུམ་ནས་ཁ་དམ་པར་བཅིངས་ཏེ་གནམ་མི་མཐོང་ཞིང་ཁྱི་དང་བུད་མེད་ཀྱིས་མི་རེག་པར་བཅང་པར་བྱའོ།",
    "ནང་པར་ཆུ་གསུམ་པོའི་ནང་དུ་ལྷོག་གཅིག་བསྐོལ་ནས་གསེར་བཏོན་ལ་ཆུ་གྲང་གིས་ལན་གཉིས་གསུམ་བཀྲུ།",
    "ཡང་གོང་གི་ཆུ་གསུམ་པོའི་ནང་དུ་རྒྱུན་རིང་ཙམ་ལན་གསུམ་བཙོ་ཆུ་བརྗེ་སྐབས་གོང་བཞིན་ཆུ་གྲང་གིས་བཀྲུས་ནས།",
    "གཉིས་འགྱུར་གྱི་ཞན་ཐལ་སྲང་དོ་སུམ་འགྱུར་མུ་ཟི་ཟེར་ཡང་བཞི་འགྱུར་སྲང་བཞི།",
    "དེ་ནས་མེ་ཐུབ་ངེས་ཀྱི་རྫའི་གའུའི་ཞབས་སུ་སོལ་ཕྱི་ཞིབ་མོ་བཏིང་དེ་ཐོག་ཏུ་གསེར་ཤོག་རྣམས་བཞག་ཟུར་དང་ཐོག་ཏུའང་སོལ་ཕྱེ་བརྫང་།",
    "ཆུ་གྲང་གིས་ལན་གསུམ་རེ་ཙམ་བཀྲུ་བ་སོགས་གསེར་གྱི་སྐབས་ལྟར་དང་།",
    "ཚིག་ཚར་ནས་ཐལ་བ་ལེན་ལུགས་སྔར་ལྟར་རོ།",
    "ཆུ་གྲང་གིས་ཡང་ཡང་བཀྲུས་ནས་སླར་མཚུར་ཆུ་དོར་བའི་ཆུ་གཉིས་པོའི་ནང་དུ་ལན་གསུམ་བཙོ།",
    "སྲེག་རྫས་ནི་ཟངས་དང་རང་མཉམ་གྱི་ཚལ་སྲང་གང་རེ།",
    "དེའང་རྒྱུ་རག་ཞེས་པ་བརྡུང་མི་ཉན་པ་ཆག་འགྲོ་བ་དེར་ངོས་བཟུང་ཞིང་དེ་གཉིས་ཀྱི་ཕྱེ་མ་དེ་མཚུར་ཆུ་དང་སྟར་ཁུ་དྲི་ཆུ་བསྣན་པ་གསུམ་པོའི་ནང་དུ་ལན་གསུམ་བཙོ་བ་དང་ཆུ་གྲང་གིས་བཀྲུ་བ་སོགས་གོང་དང་འདྲ།",
    "གཤའ་ཤོག་དེ་ཨ་བར་སྐྱུར་གསུམ་ཆ་མཉམ་ཐང་ཙམ་བརྡུངས་པ་ཁྱོར་བ་གང་ཆུ་གཙང་དུ་བཏབ་ནས་ཆུ་མ་འཐག་བར་དུ་བཙོ།",
    "ཤྲཱི་ཁཎ་བརྡུངས་པ་སོ་སོ་ནས་ཁྱོར་བ་གང་རེ་ཆུ་གཙང་ནང་དུ་བཏབ་པའི་ཆུས་ལན་བཞིར་བཙོ་བ་དང་བཀྲུ་བ་སོགས་བྱ།",
    "ཡང་འབྲས་གསུམ་སྲང་ལ་བཏེགས་པ་ཆ་མཉམ་རྩིང་ཞིབ་ཐང་ཙམ་བརྡུངས་པ་ཕྱེ་མ་བསྡམས་པ་ཁྱོར་བ་གང་རེ།",
    "ཆང་སྐྱུར་དང་སྟར་ཁུ་མཚུར་ཆུ་གསུམ་གྱི་ནང་དུ་ལན་གཉིས་བཙོ་ཆུ་འཐག་པ་དང་འབྲས་གསུམ་ཕྱེ་མ་དང་ཆུ་ཁ་སབ་པ་ལས་བརྗེ་མི་དགོས་ཤིང་མཐར་ཆུ་གྲང་གིས་དག་པར་བཀྲུས་ནས།",
    "རང་མཉམ་ལྡོང་རོས་སྲང་གང་རེ་དང་།",
    "གསེར་འབྱུང་པའི་རྡོ་ཡུག་རྡོ་ཞེས་པ་མོ་སྦལ་ལྟ་བུ་དེ་གཉིས་གང་བྱུང་དང་གཉིས་ཀའང་རུང་གསུངས།",
    "ད་ལན་སོ་སོ་ནས་སྲང་གང་ཞོ་བདུན་རེ་ཡིན།",
    "མཚུར་དཀར་ནག་གཉིས་ཞག་གཅིག་སྦངས་པའི་གྲུངས་ཆུའི་ནང་དུ་བཏབ་ལ་ལྷོག་གཅིག་བསྐོལ་ནས་གོས་ཀྱིས་བཏུམ་ལ་མཚན་མོ་ལེགས་པར་བསྙལ།",
    "ཆུ་གྲང་གིས་ལན་གཉིས་ཙམ་བཀྲུས་ལ་དག་པར་བྱས་རྗེས།",
    "དེ་ནས་བ་བླ་ལྡོང་རོས་གཉིས་འདུལ་ལུགས་གོང་གི་རྡོ་ལྔ་པོ་ལྟར་ལ།",
    "སྣོད་གཉིས་སམ་གཅིག་གི་ནང་དུ་རའི་འོ་མར་ར་མཆིན་ནམ་ར་ཤ་ཐེབ་ཚིགས་ཙམ་རེ་དང་བ་བླ་ལྡོང་རོས་གཉིས་པོ་རས་ཐུམ་བྱས་ལ་ལྷོག་གཉིས་གསུམ་ཙམ་བསྐོལ་ནས་རའོ་ཕྱེད་འཐག་པ་དང་།",
    "རྡོ་གཉིས་ཆུ་གྲང་གིས་བཀྲུས་ནས་སྔར་ལྟར་སྐམ་པར་བྱས་མ་དེ་སོ་སོ་ནས་སྲང་གང་ཞོ་བདུན།",
    "མུ་ཟི་གཏང་རྒྱུ་བྱས་ཚེ་ཚད་ནི་གོང་གི་རྡོ་གཅིག་སྲང་གང་ཞོ་བདུན་གྱི་ཚད་གཏང་བ་ཡིན།",
    "བཞི་ཆ་གཅིག་གི་བོང་དཀར་དགོས་ཤིང་བོང་དཀར་ནི་རྒྱ་གར་བོང་དཀར་དགོས།",
    "བསྲེགས་ཚར་ནས་ཐལ་བ་ཚག་བྱ།",
    "དེ་མཚམས་ལྡོག་གཅིག་བསྐོལ་ནས་ཆུ་ཕྱིར་དོར་ལ་ཆུ་གྲང་གིས་གསོ་རས་ལྟ་བུའི་ཁུག་མར་བླུགས་ནས་རྒྱུན་འབབ་ཆུ་བོང་ལྡིང་ཐག་གིས་ཞག་གསུམ་ཙམ་བརྟོད་ནས་བཀྲུས་པས་ཟ་དུས་མུ་ཟིའི་དྲི་མེད་པ་དགོས།",
    "དར་བ་དངར་ཐུག་གི་གཅིན་ཆ་མཉམ་བྱས་པའི་ནང་དུ་བཏབ་ལ་ཞག་བདུན་བསྙལ་ཆུ་དང་དར་བ་སྲོ་མི་དགོས་ཞག་བདུན་སོང་བ་དང་།",
    "འབྲི་ལུགས་ལ་ལྷོང་ཚེར་བསྲེགས་ཐལ་སྲང་གང་བཅས་དགུ་པོ་མཉམ་དུ་འདུལ་དར་ཚགས་ལ་དྲངས་ནས་རྡོ་གཞོང་དུ་ཆུ་གཙང་དང་བཅས་འདམ་འཐག་རྒྱུན་རིང་བྱས་ལ་རིམ་བཞིན་གྲུངས་ཆུ་བླངས་ནས་ཆུ་ཡང་ཡང་སབ་པས་སྙིགས་མ་མེད་པར་སོང་བ་དེ་ལ་ཁམས་བརྒྱད་གྲུངས་ཆུ་ཞེས་པ་སྟེ་དེ་ནང་བོང་དམར་ཐེབ་ཚིགས་ཙམ་བརྡུངས་པའི་ཕྱེ་མ་བཏབ།",
    "དེ་ལྟར་དངུལ་ཆུ་བཙོ་བཀྲུ་ཆེན་མོའི་ལག་ལེན་བལྟས་ཆོག་འདི་ཡང་།",
    "ཁ་རེ་གྷ་ཨོ། རིཙ་ཀ་རེ་ཤྲཱི་གྷོ་ར་ཥ་ནཱ་ཐ།",
    "ཐལ་བ་དང་ཁབ་ལྷན་ཅིག་ལ་ཕུ་གསུམ་གདབ།",
    "ཐལ་བས་ཁབ་ཕུར།",
    "ཐལ་བ་ལ་སྔགས་ཕྱི་མ་མང་དུ་བཏབ་ནས་རྨ་ལ་བླུགས།",
    "ཁྲག་གཅོད་ལ་སྔགས་ཚང་མ་བཟླས་ནས་ཐལ་བར།",
    "སྔགས་ཕྱི་མས་ཐལ་བ་གདབ།",
    "རྨ་རང་ལ་སྔགས་ཕྱི་མས་ཐལ་བ་གདབ་གསུམ། ཞྭ་རི་སེ་ནོ་ཨུ་པ་ཛི་ལཱ་ཀཱི་ལཱ།",
    "ལངྐ་ཚོ་རེ་པ་ལངྐ་ཡཱ་ཡེ།",
    "ཝཱ་ར་ཀྱི་ཚོ་རེ་ཀཱ་ཊ་ཀྱི་ཁཱ་ཨི།",
    "དེ་ནས་སོ་ན་སར་གཙུག་ལག་གིས་བཟུངས་ནས་སྔགས་ཉི་ཤུ།",
    "བུད་མེད་ཐོག་མར་བུ་བཙས་པའི་འོ་མ་ལ་ཕྱོགས་གཅིག་བརྡར་ནས་མིག་ལ་བླུགས།",
    "ཁོ་རྩིག་རི་མོ་ཅན་བརྡར་བའི་ཆུ་དཔྲལ་བ་དང་རྣ་བ་གཉིས་ཀྱི་རྒྱབ་འོག་ཏུ་བྱུག་ཉི་མ་ལ་སྐམས་པས་མགོ་ཕྱེད་ན་བའི་ཡ་མ་སེལ།",
