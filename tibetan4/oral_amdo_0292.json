    "དེའི་ཚེ་ཁོ་མོ་འདི་སྙམ་དུ་བསམས་སོ།",
    "རིགས་ཀྱི་བུ་དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཕྱག་རབ་ཏུ་བརྐྱང་བ་དེས་ཁོ་མོའི་བསམ་པ་ཐུགས་སུ་ཆུད་ནས་དེས་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "བུ་མོ་ཁྱོད་ཀྱིས་ཉོན་མོངས་པ་ཐམས་ཅད་གཞོམ་པའི་ཕྱིར་ཐུབ་པ་མེད་པའི་སེམས་སྐྱེད་ཅིག།",
    "རྡོ་རྗེ་ལྟར་རི་དང་མཚོན་ཅ་ཐམས་ཅད་ཀྱི་མཐུས་ཐུབ་པར་དཀའ་བའི་སེམས་ཉོན་མོངས་པ་ཐམས་ཅད་དང་ཉན་ཐོས་དང་།",
    "རིགས་ཀྱི་བུ་དེ་ནས་ཉེ་བར་བཟུང་བ་ཚུན་ཆད་དུ་སེམས་བསྐྱེད་པ་དེའི་མཐུས་བསྐལ་པ་འཛམ་བུའི་གླིང་གི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་ཅིག་ཏུ་ཡིད་ཀྱི་དགུ་ལས་ཀྱང་འདོད་པ་ལ་སྤྱད་པར་ཡང་མི་དྲན་ན།",
    "རིགས་ཀྱི་བུ་དེ་ནས་ཉེ་བར་བཟུང་བ་ཚུན་ཆད་དུ་རང་གི་གཉེན་བཤེས་ལའང་ཁོང་ཁྲོ་བའི་སེམས་ཅིག་མ་བསྐྱེད་ན།",
    "དེ་མ་ཡིན་པའི་ཡོ་བྱད་གཞན་ལ་བདག་གིར་བྱས་ཏེ།",
    "རིགས་ཀྱི་བུ་དེ་ནས་ཉེ་བར་བཟུང་བ་ཚུན་ཆད་དུ་བསྐལ་པ་འཛམ་བུའི་གླིང་གི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་ཅིག་ལོན་ཡང་ཚིག་དང་།",
    "སྡུག་མི་སྡུག་གི་འདུ་ཤེས་བསྐྱེད་དུ་མ་དྲན་ནོ།",
    "ཆོ་འཕྲུལ་བསམ་གྱིས་མི་ཁྱབ་པ་ཡོད་ན་རིགས་ཀྱི་བུ་ཁྱོད་མངོན་སུམ་དུ་བལྟ་བར་འདོད་དམ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རེ་རེའི་གླིང་བཞི་པ་བྱེ་བ་ཕྲག་བརྒྱ་བརྒྱན།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་མཐོང་ངམ།",
    "ཉོན་མོངས་པའི་འདམ་ཤིན་ཏུ་བསྐམ་པའི་ཕྱིར།",
    "འཇིག་རྟེན་ན་རྣམ་པར་སྤྱོད་པ་དེ་དག་གི་སྤྱོད་པ་ཤེས་པའམ།",
    "ཡོན་ཏན་བརྗོད་པར་ནུས་རེ་སྐན།",
    "དེ་ན་ཀུན་ཏུ་རྒྱུ་ཐམས་ཅད་དུ་འགྲོ་བ་ཞེས་བྱ་བ་འདུག་གིས།",
    "རི་ཤིན་ཏུ་མོད་པ་ཞེས་བྱ་བ་ཞིག་ཡོད་པ་དེའི་རྩེ་མོ་རྩྭ་དང་གེལ་པ་དང་།",
    "རི་ཤིན་དུ་མོད་པ་གང་ན་བ་དེར་ཕྱིན་པ་དང་།",
    "རི་ཤིན་ཏུ་མོད་པ་དེ་ལ་འཛེགས་ནས།",
    "རིའི་རྩེ་མོ་སྣང་བ་ཆེན་པོ་ཅན་གང་ན་བ་དེར་ཕྱིན་པ་དང་།",
    "མདུན་དུ་འདུག་ནས་ཐལ་མོ་སྦྱར་ཏེ།",
    "སྨྲས་པ་རིགས་ཀྱི་བུ་དེ་ལྟར་ཁྱོད།",
    "མོས་པ་སྣ་ཚོགས་ཅན་འདི་ལྟ་སྟེ་ལྷའི་ལམ་གྱི་རྒྱུད་དུ་གཏོགས་པ་དང་།",
    "ནམ་མཁའ་ལྡིང་གི་ལམ་གྱི་རྒྱུད་དུ་གཏོགས་པ་དང་།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་ཀྱི་ལམ་གྱི་རྒྱུད་དུ་གཏོགས་པ་དང་།",
    "གྲོང་གི་རྒྱུད་ཐམས་ཅད་དུ་རྣམ་པ་ཇི་ལྟར་ཚོགས་ཤིང་འདུས་པའི་བུད་མེད་དང་།",
    "སྐྱེས་པ་དང་ཁྱེའུ་དང་བུ་མོ་རྣམས་ཀྱི་བསམ་པ་ཇི་ལྟ་བ་དང་།",
    "གཟུགས་དང་ཁ་དོག་སྣ་ཚོགས་ཡོངས་སུ་བསྟན་ཅིང་མོས་པར་བྱ་བ་དང་།",
    "འཇིག་རྟེན་གྱི་སྐྱེ་བ་ཐམས་ཅད་རང་གི་ལུས་ལ་རྗེས་སུ་སྤྱོད་པ།",
    "དེ་དག་གི་སྤྱོད་པ་ཤེས་པའམ།",
    "ཡོན་ཏན་བརྗོད་པར་ནུས་རེ་སྐན།",
    "སོང་རིགས་ཀྱི་བུ་ལྷོ་ཕྱོགས་ཀྱི་རྒྱུད་འདི་ཉིད་ན་ཡུལ་ཁམས་ཆེན་པོ་ཞེས་བྱ་བ་ཡོད་དེ།",
    "དེ་ན་སྤོས་འཚོང་གི་ཚོང་དཔོན་ལོངས་སྤྱོད་ཨུཏ་པ་ལ་ཞེས་བྱ་བ་འདུག་གིས།",
    "ཀུན་ཏུ་རྒྱུ་ཐམས་ཅད་དུ་འགྲོ་བའི་དྲུང་ནས་སོང་ངོ།",
    "རེག་བྱ་ཐམས་ཅད་ལ་ནི་མི་ལྟ།",
    "སྤོས་འཚོང་གི་ཚོང་དཔོན་ལོངས་སྤྱོད་ཨུད་པ་ལ་ཡོངས་སུ་རྨེད་ཅིང་ཚོལ་ཚོལ་བ་ལས་མཐོང་ནས།",
    "སྤོས་འཚོང་གི་ཚོང་དཔོན་ལོངས་སྤྱོད་ཨུད་པ་ལ་གང་ན་བ་དེར་ཕྱིན་ཏེ།",
    "དྲུང་དུ་སོང་ནས།",
    "སྤོས་འཚོང་གི་ཚོང་དཔོན་ལོངས་སྤྱོད་ཨུད་པ་ལ་ལ་ལན་བརྒྱ་སྟོང་དུ་མར་གཡས་ཕྱོགས་སུ་བསྐོར་བ་བྱས་ནས།",
    "སྤོས་འཚོང་གི་ཚོང་དཔོན་ལོངས་སྤྱོད་ཨུད་པ་ལའི་མདུན་དུ་འདུག་ཏེ།",
    "ཐལ་མོ་སྦྱར་ནས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཞིང་གི་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་རྣམ་པར་རྒྱུ་བར་ཡང་འཚལ་ནས།",
    "ཉོན་མོངས་པ་འབར་བར་བྱ་བའི་སྤོས་དང་།",
    "ཉོན་མོངས་པ་ཞི་བར་བ་བའི་སྤོས་དང་།",
    "མོས་པ་ཆེན་པོས་ཡོངས་སུ་རྒྱས་པར་འགྱུར་ཏེ།",
    "དེ་དག་གི་ལས་ལ་ཡང་ཁམས་འཁྲུག་པ་ལ་ས་གྱུར་པའམ།",
    "དེའི་རི་ལུ་ཏིལ་གྱི་འབྲུ་ཙམ་གཅིག་གི་དྲིས་ཀྱང་འཛམ་བུའི་གླིང་ཐམས་ཅད་རྒྱས་པར་གང་བར་འགྱུར་ཏེ།",
    "དེས་བདུགས་མ་ཐག་ཏུ་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོའི་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་པ་ཡང་ནམ་མཁའི་དབྱིངས་ལ་གནས་སོ།",
    "ཉོན་མོངས་པའི་བདུད་ཀྱི་ཞགས་པ་དང་བྲལ་བ།",
    "གནོད་པར་སྤྱོད་པ་མེད་པའི་ལུས་དང་ངག་དང་ཡིད་ཀྱི་རྒྱུད་བསྟན་པར་ནུས་རེ་སྐན།",
    "སོང་རིགས་ཀྱི་བུ་ལྷོ་ཕྱོགས་ཀྱི་རྒྱུད་འདི་ཉིད་ན།",
    "སྤོས་འཚོང་གི་ཚོང་དཔོན་ལོངས་སྤྱོད་ཨུཏ་པ་ལ་ལ་ལན་བརྒྱ་སྟོང་དུ་མར་གཡས་ཕྱོགས་སུ་བསྐོར་བ་བྱས་ནས།",
    "སྤོས་འཚོང་གི་ཚོང་དཔོན་ལོངས་སྤྱོད་ཨུཏ་པ་ལའི་དྲུང་ནས་སོང་ངོ།",
    "གྱོ་མོ་དང་གསེག་མ་བསྩལ་བ་དང་།",
    "སྲོག་ཆགས་བརྒྱ་སྟོང་དུ་མ་གཏམ་སྣ་ཚོགས་མཉན་པར་འདོད་པ་ཤ་སྟག་གིས་ཀུན་ནས་བསྐོར་ཅིང་།",
    "མཐོང་ནས་ཀྱང་མཉན་པ་དཔའ་བོ་གང་ན་བ་དེར་སོང་སྟེ།",
    "ཐལ་མོ་སྦྱར་ནས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
