    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་སྒྲིབ་པ་མེད་པས་ཤེས་བྱའི་དངོས་པོ་གང་ལ་ཡང་ཐོགས་པ་མེད་དེ་མཁྱེན་པ་འདི་བཅུའི་མཐུ་ཉན་ཐོས་ལ་སོགས་པ་གཞན་ལས་འཕགས་པས་ན་དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་ཞེས་བྱ།",
    "སྠཱ་ནཱ་སྠཱ་ན་ཛྙཱན་བ་ལན་ཞེས་བྱ་བ་གནས་དང་གནས་མ་ཡིན་པ་མཁྱེན་པའི་སྟོབས་ཡིན་ཏེ།",
    "གནས་ནི་ལེགས་པར་སྤྱད་པས་འབྲས་བུ་ཡིད་དུ་འོང་བ་འགྲུབ་པ་དང་།",
    "ཉེས་པར་སྤྱད་པས་འབྲས་བུ་ཡིད་དུ་མི་འོང་བ་སྨིན་པར་འགྱུར་བ་ལ་སོགས་པ་ལ་བྱ།",
    "གནས་མ་ཡིན་པ་ནི་ལེགས་པར་སྤྱད་པའི་འབྲས་བུ་ཡིད་དུ་མི་འོང་བར་གྱུར་བ་དང་།",
    "ཉེས་པར་སྤྱད་པའི་འབྲས་བུ་ཡིད་དུ་འོང་བར་འགྱུར་བ་ལ་བྱ་སྟེ།",
    "སྲིད་པ་དང་མི་སྲིད་པ་མ་ནོར་བར་མཁྱེན་པའི་སྟོབས་དང་ལྡན་པའི་ཕྱིར་གནས་དང་གནས་མ་ཡིན་པ་མཁྱེན་པའི་སྟོབས་ཞེས་བྱ།",
    "ཀརྨྨ་བི་པཱ་ཀ་ཛྙཱ་ན་བ་ལན་ཞེས་བྱ་བ་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་མཁྱེན་པའི་སྟོབས་ཡིན་ཏེ།",
    "གནས་གང་དུ་འབྲས་བུ་སྨིན་པ་མཁྱེན་པའི་སྟོབས་ཞེས་བྱ།",
    "ནཱ་ནཱ་དྷཱ་ཏུ་ཛྙཱ་ན་བ་ལན་ཞེས་བྱ་བ་ཁམས་སྣ་ཚོགས་མཁྱེན་པའི་སྟོབས་ཡིན་ཏེ།",
    "རྣམ་པར་བྱང་བའི་ཁམས་ལ་སོགས་པ་ལ་བྱ་སྟེ།",
    "ཁམས་ཐ་དད་པ་མང་པོའི་རང་དང་སྤྱིའི་མཚན་ཉིད་མ་ནོར་བར་ཐུགས་སུ་ཆུད་པས་ན་ཁམས་སྣ་ཚོགས་མཁྱེན་པའི་སྟོབས་ཞེས་བྱ།",
    "སརྦ་ཏྲ་གཱ་མི་ནཱི་བྲ་ཏི་བནྠ་བ་ལན་ཞེས་བྱ་བ་ཐམས་ཅད་དུ་འགྲོ་བའི་ལམ་མཁྱེན་པའི་སྟོབས་ཡིན་ཏེ།",
    "རྣམ་བར་བྱང་བ་དང་ལྡང་པ་ཐམས་ཅད་མཁྱེན་པའི་སྟོབས་ཡིན་ཏེ།",
    "རྣམ་པར་ཐར་བ་བརྒྱད་དང་།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ལ་སོགས་པ་ལ་བྱ།",
    "ལྡན་པ་ནི་ལུགས་དང་མཐུན་པའམ་མི་མཐུན་པ་དང་ཐོད་རྒལ་ལ་སོགས་པའི་ཚུལ་གྱིས་ལྡན་པ་མཁྱེན་པ་ལ་བྱ།",
    "པཱུརྦ་ནི་བཱ་སཱ་ནུ་སྨྲྀ་ཏི་ཛྙཱ་ན་བ་ལན་ཞེས་བྱ་བ་སྔོན་གྱི་གནས་རྗེས་སུ་དྲན་པ་མཁྱེན་པའི་སྟོབས་ཡིན་ཏེ།",
    "མཚན་མ་དང་རྟགས་ཅི་ཡོད་པ་དང་ལས་ཀྱི་རྒྱུ་ཅིས་སྐྱེས་པ་མཁྱེན་པས་ན་སྔོན་གྱི་གནས་རྗེས་སུ་དྲན་པ་མཁྱེན་པའི་སྟོབས་ཞེས་བྱ།",
    "ཙྱུ་ཏྱུ་པ་པཏྟཱི་ཛྙཱན་བ་ལན་ཞེས་བྱ་བ་ཤི་འཕོ་དང་སྐྱེ་བ་མཁྱེན་པའི་སྟོབས་ཡིན་ཏེ།",
    "ཨཱ་ཤྲ་བཀྵ་ཡ་ཛྙཱ་ན་བ་ལན་ཞེས་བྱ་བ་ཟག་པ་ཟད་པ་མཁྱེན་པའི་སྟོབས་ཡིན་ཏེ།",
    "ཚངས་པའི་འཁོར་ལོ་བསྐོར་ཞིང་ཡང་དག་པར་སེང་གེའི་སྒྲ་སྒྲོགས་པས་ན་མི་འཇིགས་བ་ཞེས་བྱ།",
    "བདག་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པར་བསྟན་པའང་ཡིན་ནོ།",
    "སརྦཱ་ཤྲ་པཀྵ་ཡ་ཛྙཱ་ན་བེ་ཤཱ་ར་དྱན་ཞེས་བྱ་བ་ཟག་པ་ཐམས་ཅད་པ་མཁྱེན་པ་ལ་མི་འཇིགས་བ་ཡིན་ཏེ།",
    "མི་དོགས་པས་ན་ཟག་པ་ཐམས་ཟད་པར་མཁྱེན་པ་ལ་མི་འཇིགས་པ་ཞེས་བྱ།",
    "ནཱ་སྟི་ས་མཱ་ཧི་ཏ་ཙིཏྟཾ་ཞེས་བྱ་བ་སེམས་མཉམ་པར་མ་བཞག་པ་མེད་པ་ཡིན་ཏེ།",
    "ཏིང་ངེ་འཛིན་དེ་ལ་མཉམ་པར་གཞག་པ་ལྟ་བུ་མ་ཡིན་གྱི།",
    "མཉམ་པར་མ་བཞག་པ་མེད་པས་ན་སེམས་མཉམ་པར་མ་བཞག་པ་མེད་པ་ཞེས་བྱ།",
    "སོ་སོར་ཡང་དག་པར་རིག་པ་མི་ཟད་པ་མངའ་བས་ན་ཤེས་རབ་ཉམས་པ་མེད་པ་ཞེས་བྱ།",
    "ནཱསྟི་བི་མུཀྟེརྷ་ནི་ཞེས་བྱ་བ་རྣམ་པར་གྲོལ་བ་ཉམས་པ་མེད་པ་ཡིན་ཏེ།",
    "ཤེས་བྱའི་སྒྲིབ་པ་ཐམས་ཅད་ལས་གྲོལ་བས་ན་རྣམ་པར་གྲོལ་བ་ཉམས་བ་མེད་པ་ཞེས་བྱ།",
    "དགྲ་བཅོམ་པ་ལྟར་འདས་པའི་དུས་ཀྱི་དངོས་པོ་ཅི་ལ་བརྟགས་པ་སྣ་གཅིག་མཁྱེན་གྱི་གཞན་ལ་ཐོགས་ཤིང་མི་མཁྱེན་པ་ལྟ་བུ་མ་ཡིན་གྱིས།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ལ།",
    "ས་གོང་མའི་ཡོན་ཏན་ཐོབ་པར་བྱ་བའི་རྟེན་དུ་འགྱུར་ཞིང་།",
    "ས་བརྒྱད་པ་ཨ་ཙལ་ཞེས་བྱ་བ་ནི་མཚན་མའི་འདུ་ཤེས་དང་མཚན་མ་མེད་པར་རྩོལ་བའི་འདུ་ཤེས་གཉི་གས་བསྐྱོད་པར་མི་ནུས་པས་མི་གཡོ་བ་ཞེས་བྱ།",
    "ས་དགུ་པ་ལ་སོ་སོ་ཡང་དག་པར་རིག་པ་བརྙེས་པས་ན་བློ་གྲོས་གཞན་ལས་འཕགས་པ་ཡིན་ཏེ་ལེགས་པའི་བློ་གྲོས་ཞེས་བྱ།",
    "རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ལ་གནས་པས་དེ་ཁོན་ཉིད་རྟག་པར་མཐོང་བས་ན་མཐོང་པའི་ས་ཞེས་བྱ།",
    "ཀྲྀ་ཏ་ནི་བྱས་པ།",
    "སྔར་བྱས་ཏེ་གྲུབ་པའི་དོན་མི་ཉམས་པར་བསྲུང་བའི་ཕྱིར་བྱས་པ་སྲུང་བའི་ས་ཞེས་བྱ་སྟེ།",
    "ཨ་ནནྟཪྻ་ས་མཱ་དྷི་ཞེས་བྱ་བ་དད་པ་རབ་ཀྱིས་ས་འདི་ལ་འཛིན་པའི་གཡེང་བ་སྤངས་ནས་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་རྣམ་པར་མི་རྟོག་པ་དེ་མ་ཐག་ཏུ་ཐོབ་པར་འགྱུར་བས་ན་བར་ཆད་མེད་པའི་ཏིང་ངེ་འཛིན་ཞེས་བྱ།",
    "དེ་ལས་ཉམས་པར་མི་འགྱུར་ཞིང་།",
    "ཡང་དག་པའི་ཤེས་པས་རྒྱུན་དུ་ཞུགས་པ་ལ་སོགས་པའི་འབྲས་བུ་ཐོབ་པ་གཞན་ལ་སྒྲོགས་ཤིང་ཐོས་པར་བྱེད་པས་ན་ཉན་ཐོས་ཞེས་བྱ།",
    "དགྲ་བཅོམ་པ་འགོག་པའི་སྙོམས་པར་འཇུག་པ་མ་བསྒྲུབས་པར་ཤེས་རབ་ཀྱིས་ཟག་པ་ཉི་ཚེ་ལས་གྲོལ་བར་བྱས་པས་ན་ཤེས་རབ་ཀྱིས་རྣམ་པར་གྲོལ་བ་ཞེས་བྱ།",
    "སྙོམས་པར་འཇུག་པའི་སྒྲིབ་པ་གཉིས་ཀ་ལས་གྲོལ་བས་ན།",
    "གཉིས་ཀའི་ཆ་ལས་རྣམ་པར་གྲོལ་བ་ཞེས་བྱ།",
    "རིགས་པར་ཞུགས་པ་ཞེས་བྱ།",
    "སྤྱོད་པ་ལ་བྱ་བས་ན་མྱ་ངན་ལས་འདས་པར་བྱ་བའི་ཕྱིར་སྤྱོད་པས་ན་ཚངས་པར་སྤྱོད་པ་ཞེས་བྱ།",
    "ཨཱ་དོ་ཀ་ལྱཱ་ཎ་ཞེས་བྱ་བ་ཨཱ་དོ་ནི་དང་པོ་ཡིན་ཏེ་ཚངས་པར་སྤྱོད་པའི་དང་པོ་ལ་བྱ།",
    "མ་དྷྱེ་ཀལྱཱ་ཎ་ཞེས་བྱ་བ་ཚངས་པར་སྤྱོད་པའི་བར་མ་ནི་བསམ་གཏན་བཞི་ལ་སོགས་པ་སེམས་མཉམ་པར་གཞག་པའི་མིང་སྟེ།",
    "ཨརྠ་ནི་དོན་ཏེ་དོན་མ་ལོག་པར་བསྟན་པས་ན་དོན་བཟང་པོ་ཞེས་བྱ།",
    "འཕགས་པའི་ལམ་ཟག་པ་མེད་པའི་རང་བཞིན་གྱིས་རྣམ་པར་གྲོལ་ཏེ་གཙང་བས་ན་ཡོངས་སུ་དག་པ་ཞེས་བྱ།",
    "གང་ཟག་སོ་སོའི་སེམས་ཀྱི་རྒྱུད་རྣམ་པར་གྲོལ་ཞིང་བྱང་བས་ན་ཡོངས་སུ་བྱང་བ་ཞེས་བྱ།",
    "ཡང་དག་པའི་ཤེས་རབ་ཀྱིས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་མ་ནོར་བར་མཐོང་བས་ན་ཡང་དག་པར་མཐོང་བ་ཞེས་བྱ།",
    "ཤེས་རབ་ཅན་རྣམས་ཀྱིས་རྟོགས་པར་བྱ་བ་ཡིན་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པས་གསུངས་པ་ཡིན་པས་ན་རྟེན་པ་ཡོད་པ་ཞེས་བྱ།",
    "ཚེ་དང་བྱད་གཟུགས་དང་གནས་དང་ལོངས་སྤྱོད་ལ་སོགས་པ་འོག་མ་བས་འཕེལ་ཞིང་ཁྱད་པར་དུ་གྱུར་པས་འཕེལ་བའམ་རྒྱས་པ་ཞེས་དྲང་དུ་ཡང་རུང་།",
    "སྔར་གྲགས་པ་ཡང་བཙན་པར་བྱས་ནས་ཚངས་པ་ཞེས་བཏགས་བིཥྞུ་ཞེས་བྱ་བ་རྣམ་པ་གཅིག་ཏུ་ན་བི་ཤློ་བྱཔྟོ་ཞེས་བྱ་སྟེ་ཁྱབ་པར་ཡང་འདྲེན།",
    "མཆོད་སྦྱིན་རྣམ་པ་བརྒྱ་བྱས་པས་ལྷའི་རྒྱལ་པོའི་གོ་འཕང་ཐོབ་པས་ན་བརྒྱ་བྱིན་ཞེས་ཀྱང་བྱ།",
    "སྔར་མིང་དུ་བཏགས་པ་བཙན་པར་བྱས་ཏེ་བརྒྱ་བྱིན་ཞེས་བཏགས།",
    "བསམ་གཏན་དང་སྙོམས་པར་འཇུག་པ་ལ་སོགས་པའི་མིང་ལ་དྷྱཱ་ན་ཞེས་བྱ་བ་དྷྱེ་ཙིཏྟ་ཡན་ཞེས་བྱ་སྟེ།",
    "ཨནྟ་རི་བྱེ་བྲག་གམ་ཁྱད་པར་ཏེ།",
    "བསམ་གཏན་ཁྱད་པར་ཅན་ནི་རྟོག་པ་ནི་མེད་དཔྱོད་པ་ཙམ་དུ་ཟད་དེ་བྱེ་བྲག་ཏུ་འཕགས་པས་ཚངས་པ་ཆེན་པོའི་གོ་འཕང་ཐོབ་པའི་ཕྱིར་བསམ་གཏན་ཁྱད་པར་ཅན་ཞེས་བྱ།",
    "སྤྱིར་ན་བསམ་གཏན་དང་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ལ་མཉམ་པར་གཞག་པའི་ཕྱིར་སྔར་ནས་ཤོམ་པའི་སེམས་ཀྱི་མིང་སྟེ་ཉེར་བསྡོགས་ཞེས་བྱའོ།",
    "བསམ་གཏན་དང་སྙོམས་པར་འཇུག་པ་དངོས་ལ་བྱ་བས་དངོས་གཞི་ཞེས་བྱ།",
    "ས་མཱ་པཏྟི་ཞེས་བྱ་བ་སེམས་དང་སེམས་ལས་བྱུང་བའི་ཚོགས་དམིགས་པ་གཅིག་ལ་འདུ་ཞིང་གཉིས་མཉམ་པར་བྱེད་པའི་མིང་སྟེ་སྙོམས་པར་འཇུག་པ་ཞེས་བྱ།",
    "ཞི་བ་ལ་གནས་པར་འཇུག་པའི་སེམས་ཀྱིས་ཚོར་བ་དང་འདུ་ཤེས་འགོག་པ་སྙོམས་པར་འཇུག་པ་ལ་ཡང་བྱ་བས་ན་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ཞེས་བྱ།",
    "ཨ་སཾ་ཛྙཱ་ས་མཱ་པཏྟི་ཞེས་བྱ་བ་འདུ་ཤེས་མེད་པའི་སེམས་ཀྱིས་སྙོམས་པར་འཇུག་པ་ཡིན་པས་ན་འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ཞེས་ཀྱང་བྱ།",
    "ཡང་གཅིག་ཏུ་ན་སྙོམས་པར་འཇུག་པ་དེ་འདུ་ཤེས་མེད་པས་ན་འདུ་ཤེས་མེད་པའི་སྙོམས་པའི་འཇུག་པ་ཞེས་བྱ།",
    "ངན་པ་ལ་སོགས་པ་མཐོང་ནས་གཟུགས་དེ་དག་ཟིལ་གྱིས་མནན་ཏེ་ཤེས་པར་བྱེད་པས་ན་ཟིལ་གྱིས་གནོན་པའི་སྐྱེ་མཆེད་བརྒྱད་ཅེས་བྱ།",
    "ཟད་པར་གྱི་སྐྱེ་མཆེད་བཅུ་ཞེས་བྱ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་དང་འགོག་པའི་སྙོམས་པར་འཇུག་པ་དང་དགུ་ལ་མཐར་གྱིས་གནས་ཤིང་འཇུག་པའི་མིང་སྟེ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཞེས་བྱ།",
    "འཇིག་པར་འགྱུར་བའང་མ་ཡིན་པའི་ཕྱིར་དོན་དམ་པར་ན་མིག་ལ་སོགས་པ་ལ་དངོས་པོ་མེད་པས་ན་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ།",
    "འཇིག་པར་འགྱུར་བ་ཡང་མ་ཡིན་པའི་ཕྱིར་དོན་དམ་པར་ན་གཟུགས་ལ་སོགས་པ་ལ་དངོས་པོ་མེད་པས་ན་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ།",
    "གཞན་གྱིས་སྟོང་པར་བྱར་མེད་པས་ན་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ།",
    "སཾ་སྐྲྀ་ཏ་ཤཱུ་ནྱ་ཏཱ་ཞེས་བྱ་བ་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་ཡིན་ཏེ།",
    "འདུས་བྱས་ནི་ཁམས་གསུམ་དུ་གཏོགས་སོ་ཅོག་ལ་བྱ།",
    "སྐྱེ་བ་དང་གནས་པ་དང་འགག་པ་དང་བྲལ་ཞིང་སྟོང་པས་ན་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ།",
    "ཨ་སཾ་སྐྲྀ་ཏ་ཤཱུ་ནྱ་ཏཱ་ཞེས་བྱ་བ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཡིན་ཏེ།",
    "འདུས་མ་བྱས་ནི་ནམ་མཁའ་དང་དེ་བཞིན་ཉིད་དང་འགོག་པ་རྣམ་པ་གཉིས་རྒྱུ་དང་རྐྱེན་གྱིས་གྲུབ་པ་མ་ཡིན་པ་འདུས་མ་བྱས་ནི་གཞི་རང་བཞིན་གྱིས་སྟོང་བས་ན་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ།",
    "ཆུ་ཕོ་ནས་སྟོང་པར་གྱུར་པ་ལྟ་བུ་མ་ཡིན་གྱིས།",
    "རང་བཞིན་གྱིས་འདུས་བྱས་ཀྱང་མ་ཡིན།",
    "འདུས་མ་བྱས་ཀྱང་མ་ཡིན་པས་ན་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཅེས་བྱ།",
    "དངོས་པོ་མེད་པར་རྟོགས་པའི་མཐོང་བ་དང་ཤེས་པ་ནི་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་ཅེས་བྱ།",
    "མཐོང་བ་དང་ཤེས་པ་འདི་གཉིས་ཀ་ཡང་མཐོང་བས་ཀྱང་མ་བྱས་ཤེས་པས་ཀྱང་མ་བྱས་ཏེ་རང་བཞིན་གྱིས་སྟོང་པའི་ཕྱིར་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ།",
    "ཁྱད་པར་རམ་ལྷག་པ།",
    "སྤྱིར་ན་ཤེས་རབ་ཀྱིས་དངོས་པོའི་རང་བཞིན་ལྷག་པར་རྟོགས་པའི་རང་བཞིན་ཏེ་ལྷག་མཐོང་ཞེས་བྱ།",
    "ལམ་དེས་འགོག་པ་ཚོལ་བའམ་མཚོན་པའམ་དམིགས་པའམ་འཐོབ་པར་འགྱུར་བ་ལ་བྱ་སྟེ་ལམ་ཞེས་བྱ།",
    "ཕུང་པོ་འཇིག་ཅིང་མེད་པར་འགྱུར་བས་ན་འགོག་པ་ཞེས་བྱ།",
    "འཕགས་པའི་ལམ་དུ་ཞུགས་ནས་མྱ་ངན་ལས་འདས་པར་འགྲོ་བའི་དོན་གྱིས་ལམ་ཞེས་བྱ།",
    "ཡང་དག་པར་ཐོབ་པར་བྱེད་དོན་གྱིས་སྒྲུབ་པ་ཞེས་བྱ།",
    "བི་མུཀྟ་མཱརྒྒ་ཞེས་བྱ་བ་བི་མུཀྟ་ནི་རྣམ་པར་གྲོལ་བ།",
    "རྣམ་པར་གྲོལ་བའི་ལམ་ཞེས་བྱ།",
    "མི་སློབ་པའི་ལམ་ལ་དགྲ་བཅོམ་པའི་འབྲས་བུ་ཐོབ་ནས་ཤེས་པར་བྱ་བ་ཐམས་ཅད་ཤེས་ཏེ།",
    "དུ་ཁ་པྲ་ཏི་པདྡྷྱ་ན་དྷྱཱ་བྷི་ཛྙཱ་ཞེས་བྱ་བ་བསམ་གཏན་བཞིའི་ས་ལ་མ་གཏོགས་པ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ལྟ་བུ་ལྷག་མཐོང་མེད་ལ་ཞི་གནས་ཀྱི་ཤས་ཆེ་བ་དང་།",
    "དུ་ཁ་པྲ་ཏི་པ་ཏཀྵི་པྲཱ་བྷི་ཛྙཱ་ཞེས་བྱ་བ་བསམ་གཏན་བཞི་ལས་མ་གཏོགས་པ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ལྟ་བུ་ལྷག་མཐོང་མེད་ལ་ཞི་གནས་ཀྱི་ཤས་ཆེ་བ་དང་།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་ཤེས་པས་དངོས་པོའི་དེ་ཁོ་ན་ཉིད་མཐོང་བར་བྱ་བ་ལ་སྒྲིབ་པས་ན་ཡང་དག་སྒྲིབ་ཅེས་བྱ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པར་བཏགས།",
    "པ་ར་མཱརྠ་ཞེས་བྱ་བ་པར་མ་ནི་མཆོག་གམ་དམ་པ།",
    "གཅིག་ཏུ་ཆད་པར་ཐམས་ཅད་འཆིའོ་ཞེས་བྱ་བ་ཡིན་ཏེ།",
    "ཨ་བྷི་པྲཱ་ཡ་དང་མ་འདོམ་ན་ཨ་བྷི་སནྡྷི་ཡང་དགོངས་པར་གདགས།",
    "ལག་པ་དང་དབྱིག་པ་ལ་སོགས་པས་གཟུགས་ཤིང་གནོད་པར་བྱར་རུང་བས་ན་གཟུགས་ཞེས་བྱ།",
    "བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་པའི་ཚོར་བ་རྣམ་པ་གསུམ་མྱོང་བར་མ་ལུས་པར་གཅིག་ཏུ་བསྡུས་པའི་མིང་སྟེ་ཚོར་བའི་ཕུང་པོ་ཞེས་བྱ།",
    "ཡུལ་ཐ་དད་པ་རྣམ་པ་སྣ་ཚོགས་ཤེས་པ་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་བརྒྱད་བསྡུས་པའི་མིང་ཡིན་པས་ན་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་ཞེས་བྱ།",
    "འདི་རྣམས་རྣམ་པར་རིག་བྱེད་བཞིན་དུ་གཞན་གྱིས་ཤེས་ཤིང་རྟོགས་པར་མི་རུང་བས་ན་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་ཞེས་བྱ།",
    "སེམས་དང་སེམས་ལས་བྱུང་བའི་དངོས་པོ་མང་ཉུང་མཉམ་པར་འབྱུང་སྟེ་རྫས་མཚུངས་པ་དང་།",
    "མཚུངས་པ་འདི་ལྔས་སེམས་དང་མཉམ་པར་ལྡན་པའི་ཕྱིར་མིང་སྟེ་སེམས་དང་མཚུངས་པར་ལྡན་པ་ཞེས་བྱ།",
    "མིག་དང་གཟུགས་ལ་སོགས་པའི་སྐྱེ་མཆེད་ཀྱི་སྒོ་ནས་རྣམ་པར་ཤེས་པ་སྐྱེ་ཞིང་འཕེལ་བས་ན་སྐྱེ་མཆེད་ཅེས་བྱ།",
    "དངོས་སུ་ན་སྟོབས་དང་མི་འཇིགས་པ་ལ་སོགས་པ་ཡོན་ཏན་གྱི་མིང་སྟེ་དོན་བཙན་པར་བྱས་ནས་ཡོན་ཏན་དུ་བཏགས།",
    "རིག་སྔགས་འཆང་ནས་ནམ་མཁའ་ལ་འགྲོ་ཞིང་ཚེ་བསྐལ་པར་ཐུབ་པ་ལ་སོགས་པ་ཅི་སྒྲུབ་པ་ཉིད་གྲུབ་པའི་མིང་སྟེ་དངོས་གྲུབ་ཅེས་བྱ།",
    "ཛམྦྷ་ན་ཞེས་བྱ་བ་སྔགས་ཀྱིས་སེམས་རྨོངས་པར་བྱེད་པའི་མིང་སྟེ་རྨུགས་བྱེད་ཅེས་བྱ།",
    "རྒྱུག་པའམ་དག་པར་བྱེད་པ་ལྟ་བུ་ལ་བྱ།",
    "ཨུ་པ་ནཱ་ཡི་ཀཱ་ནི་ཕྲད་པར་བྱེད་པ་སྟེ།",
    "སྦྱོར་བས་ན་སྦྱོར་ཞིང་གནས་པར་དམ་འཆའ་བའི་མིང་སྟེ།",
    "གཙུག་ལག་ཁང་ངམ་གནས་དེ་ནས་གུད་དུ་མི་འཕགས་པར་གནས་པར་དམ་འཆའ་ཞིང་ཆོ་ག་བྱ་བའི་མིང་སྟེ།",
    "དབྱར་གནས་པར་དམ་བཅས་པ་ཞེས་བྱ།",
    "དབྱར་གནས་པར་དམ་བཅས་པའི་ཚེ་ཐོས་པ་དང་མཐོང་བ་དང་དོགས་པས་རྒོལ་ཞིང་རྩོད་དུ་མི་གནང་བ་ལས་སྐབས་ཕྱེ་བས་ན་དགག་དབྱེ་ཞེས་བྱ།",
    "ཀྵིནྣནཱ་ཏཱི་ནི་གནོད་པར་བྱེད་པ་ལ་བྱ་སྟེ།",
    "བི་བྷི་ཥ་ན་ལ་སོགས་པ་མི་ལ་གནོད་པར་བྱེད་པའི་སྲིན་པོ་ལ་བྱ་བས་ན་སྲིན་པོ་ཞེས་བྱ།",
    "ཡི་དགས་སྨད་རིགས་མི་ཤ་ལ་སོགས་པ་རྗེ་ན་པར་ཟ་བས་ན་ཤ་ཟ་ཞེས་བྱ།",
    "ཨུནྨཱ་ད་ཞེས་བྱ་བ་སེམས་མི་དྲན་ཞིང་མྱོས་པར་བྱེད་པའི་གདོན་ཡིན་པས་སྨྱོ་བྱེད་ཅེས་བྱ།",
    "གདོན་གྱིས་མིའི་གྲིབ་མ་གནོན་ཞིང་གནོད་པར་བྱེད་པས་ན་གྲིབ་གནོན་ཞེས་བྱའོ།",
    "བེ་ཏཱ་ཌ་ཞེས་བྱ་བ་མི་ཤི་བའི་རོའི་ནང་དུ་གདོན་ཞུགས་ཏེ་གནོད་པར་བྱེད་པས་ན་རོ་ལངས་ཞེས་བྱ།",
    "སྐྱེས་བུ་རྩལ་དང་ལྡན་པ་ཞིག་ཁོད་ན་ཡོད་པར་འདོད་པ་ལ་བྱ་བས་ན་སྐྱེས་བུ་ཞེས་བྱ།",
    "ཀཱ་ར་ཀ་ནི་མུ་སྟེགས་ཀྱི་གཞུང་ལས་སྐྱེ་བ་དང་འཇིག་པ་ལ་སོགས་པ་ཐམས་ཅད་བདག་རྟག་པས་བྱས་པར་འདོད་པས་ན་བྱེད་པ་པོ་ཞེས་བྱ།",
    "སུ་པརྞ་འདབ་བཟང་།",
    "ལུས་འཕགས་པར་བཟང་བ་ལ་མིང་དུ་བཏགས་པས་ན་ཤར་གྱི་ལུས་འཕགས་ཞེས་བྱ།",
    "དེ་ལ་བ་ལང་ལྷག་པར་མང་ཞིང་སྤྱོད་པ་ལས་མིང་དུ་བཏགས་ཏེ་ནུབ་ཀྱི་བ་ལང་སྤྱོད་ཅེས་བྱ།",
    "པཱ་རི་ཡཱ་ཏྲ་ཀོ་བི་དཱ་ར་ཞེས་བྱ་བའི་སྒྲ་ལས་དྲངས་ན་པཱ་རི་ཡཱ་ཏྲ་ནི་པརཱི་ཏི་ས་མནྟ་ཡཱ་ཏྲ་སྟེ།",
