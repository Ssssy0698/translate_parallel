    "མཐོང་བའི་ཟེར་ཐག་སོགས་དེ་དག་མངོན་སུམ་ལྟ་བ་ན་སེམས་འཛིན་གྱི་རྟེན་དུ་བྱས་ཏེ་མཉམ་བཞག་གི་ལྟ་བ་སྐྱོང་རྒྱུ་ཡིན་ན་སྐྱོན་ཆེར་མེད་དོ།",
    "ཟེར་དེ་མཐོང་བ་དང་ངན་སྐུག་གི་ཕུང་པོ་མཐོང་བ་གཉིས་མཉམ་བཞག་གི་ལྟ་བ་སྐྱོང་ཀླུཚུལ་ཤེས་ན་གྲོལ་བ་དང་།",
    "དེས་ན་ལམ་གྱི་མཐོང་སྣང་ཡིན་གྱི་ཞིང་ཁམས་མ་ཡིན་པས་ཞིང་ཁམས་རང་གི་ངོ་མ་དག་པས།",
    "དུ་སོགས་མཉམ་བཞག་གི་ཕྱི་ཞེ་དྲུག་ལེནབརྟན་པའི་ཉམས་སྣང་ལ་མིག་མདངས་བཙུམས་མེད་པ།",
    "རང་ལུས་འོད་ལ་ཕར་ཞུགས་ན་ལྷག་མེད་གཡུང་དྲུང་གི་སྐུ་ཐོབ་ལ།",
    "འོད་རང་ལུས་ལ་ཚུར་ཞུགས་ནས་ལྷག་བཅས་གཡུང་དྲུང་དྲུག་གི་སྐུ་ཐོབ་པར་བཞེད་པའི་ལུང་པགས་ཀརྨ་པའི་ཆབ་ཤོག་སོག་ཟློག་པ་ལས་སྣང་བ་ལ་ཁྱད་ཅུང་ཟད་ཀྱང་མ་མཆིས་སོ།",
    "ཞེས་གླེང་ན་རྣམ་དག་གི་ཁྱད་པར་བྱེ་བ་སྨྲ་རྒྱུ་ཅི་ཡོད།",
    "རྒྱུཟབ་མོ་དམིགས་མེད་དེ་རྣམས་ཀྱི།",
    "མ་བསླད་སྔ་འགྱུར་བཀའ་མ་ཞེ་བརྒྱད་པའི་ཡིད་ཀྱི་ཤེས་པའི་སྣང་བ་ནི་ཡིན་ཏེ།",
    "ཞེས་པ་ལ་སོགས་པས་བསྟན་པ་ནི་ནང་གི་དེ་ཁོ་ན་ཉིད་ཀྱི་མཐོང་བའི་མངོན་སུམ་ཞེས་ཆ་དོ་། བྱ་སྟེ་ཞིང་།",
    "དེ་ལྟ་བུ་ཐབས་གང་གིས་མཐོང་ན།",
    "བདེ་མཆོག་རི་གི་ཨ་ར་ལིའི་རྒྱུད་ལས།",
    "དོན་དམ་པའི་བདེན་པའི་རང་གི་མཚན་ཉིད་ཡེ་ཤེས་ཀྱི་མིག་གི་མཐོང་ངོ།",
    "རེ་ལྡེ་ལྟ་བུར་སྣང་བ་ཚུན་ཆད་ཡིན་ནོ།",
    "འབར་བ་དང་ནི་ཟླ་བ་ཉི་མ་རྡོ་རྗེ་དང་མཆོག་གི་ཆ་དང་ཐིག་ལེ་མཐོང་བར་འགྱུར།",
    "ནམ་མཁའ་ཆུ་འཛིན་ཡས་ཡས་ཏ་ཀ་ཁབདོ་། བྲལ་བའི་དབུས་སུ་རྣལ་འབྱོར་གྱི་བགྲོད་པའི་མིག་གི་ལྟ་བྱ་སྟེ།",
    "རེ་འགའ་ནག་པོ་དྲི་མེད་འོད་ཟེར་འཕྲོ་བ་དུས་ཀྱི་རྩ་ལ་མཐོང་བར་གྱུར་གྱི་བར་དུའོ།",
    "རེ་ཁ་ནཱག་པོའི་རི་མོ་འབྱུང་།",
    "ཤེས་རབ་ཟ་མོ་ཚུལ་བཞིན་རྣམ་དག་པས།",
    "ཞེས་མིག་གི་མཐོང་བར་གསུངས་ལ།",
    "མིག་གི་མཐོང་བྱ་མཐོང་བྱེད་ཀྱི་ཡུལ་ལས་འདས་པའི་བ་བ་བ་བ་། ཕྱིར་དང་།",
    "མུན་ཁང་དུ་རང་གི་ལག་པ་བརྐྱངས་པ་མི་མཐོང་པའི་ཚེ་ནའང་མཐོང་བའི་ཕྱིར་དང་།",
    "རང་གི་མིག་གི་མི་མཐོང་ཞིང་།",
    "གཞན་གྱི་མིག་གིས་ཀྱང་མིན་པ།",
    "གང་གི་ཕྱིར་བཀབ་པ་དང་མ་བཀབ་པའི་མིག་གི་རྟོགས་པ་དེའི་ཕྱིར་གཟུགས་མ་ཡིན་ཞིང་།",
    "མར་མེ་རང་གི་ངོ་བོ་ཅན།",
    "ཆུ་ཤིང་གི་ནི་མེ་ཏོག་ལྟར།",
    "རྣམ་པར་ཤེས་པ་ཚོགས་བརྒྱད་ཀྱི་དོན་སྤྱི་ཙམ་ཡང་བློ་ཡུལ་དུ་མ་ཤར་བའི་བླུན་པོ་དག་གི་ཚིག་དང་མཚུངས་པར་བསལ།",
    "འོད་སྣང་དེ་དག་གི་སྟེང་དུ་མཉམ་བཞག་གི་ལྟ་བ་མི་སྐྱོང་བར་བྱིས་པ་ལྷ་ཁང་ལྟ་བ་ལྟ་བུ་ནི་མ་ཡིན་ཏེ།",
    "ངན་སྐྱུག་གི་ཕུང་པོ་མཐོང་བ་མཉམ་བཞག་གི་སྐྱོང་ཚུལ་ཤེས་ན་མཉམ་པར་གསུང་པ་ཡང་མི་འཐད་དེ།",
    "མཁས་པ་རྣམས་ཀྱི་སོ་སོ་རང་གི་རིག་པར་བྱ་བ།",
    "སོ་སོར་སྡུད་པ་རྟགས་བཅུ་མཐོང་བས་བདེན་པའི་ཚིག་འགྲུབ་པ་ལ་སོགས་གསུངས་ཤིང་ངན་སྐྱུག་གི་ཕུང་པོ་ནི་ལྟ་བ་ཅན་ལ་དོན་དུ་མ་གྲུབ་པ་ཡིན།",
    "རྒྱ་གར་གྱི་གྲུབ་ཆེན་རྣམས་ཀྱང་ལམ་འདིའི་སྒོ་ནས་བགྲོད་པ་གཅིག་པ་ཤ་སྟག་ཡིན་ཏེ་རང་རང་གི་མགུར་རྣམས་ན་གསལ་མོད་ཀྱི།",
    "ལམ་ནག་གི་ནི་དུ་བ་བཞིན།",
    "མིག་དག་རེངས་པར་བྱེད་པ་དང་།",
    "གང་ཚེ་ནམ་མཁའི་རྩེ་མོར་མེ་ཏོག་རྒྱས།",
    "རིག་པ་ཚད་ལ་མ་ཕེབས་པའི་གོང་གི་སྣང་བ་རྣམས་ལ་ཆས་ཟ་མ་ཁ་བས་ས་ཁ་ཁ་ཁ་བའཁ་བ་།",
    "རིག་པ་ཚད་ལ་ཕེབས་པའི་རྣལ་འབྱོར་པ་དེ་རང་གི་བློ་ངོ་ན་རང་གནས་པའི་ཡུལ་ལོངས་སྐུའི་ཞིང་ཁམས་དང་འཁོར་རྣམས་ཀྱང་དེ་ལྟར་ཡིན་མོད།",
    "དེས་ན་དེ་དག་གི་ཚིག་རྣ་བར་ཐོས་པ་ཙམ་གྱི་དོན་རྒྱུད་ལ་མ་སྐྱེས་ཀྱང་གྲོལ་བའམ།",
    "རྟོགས་པ་ལ་དེ་དག་གི་ཚིག་དོན་ལ་གོ་བ་རྐང་ཚུགས་པ་ཞིག་སྐྱེས་པ།",
    "འདིར་གདམས་ངག་གི་དོན་བསྒྲགས་པ་དེ་ཐོས་པ་ཙམ་གྱི་རྒྱུད་ལ་ངོ་འཕྲོད་ནས་ས་བདེ་བླག་ཏུ་རྟོགས་པ་ཡིན་ཞིང་།",
    "དོན་གཅིག་མིང་གི་རྣམ་གྲངས་ཡིན།",
    "སྐད་ཅིག་གཅིག་གི་བྱེ་བྲག་ཕྱེད།",
    "ཤར་བ་དེ་ཉིད་རང་གི་ཐོག་ཏུ་གྲོལ།",
    "སྲིན་བུ་དང་གྲོག་མ་ལྟ་བུ་ལ་ལྷ་དེ་དག་གི་བག་ཆགས་གཏན་མེད་པའི་ཕྱིར།",
    "ན་གྲོག་མ་ལ་སོགས་ཀྱི་སྲོག་ཆགས་ཕྲ་མོ་དག་རོ་ལ་ས་གཞིའི་འདུ་ཤེས་ཡོད་དེ།",
    "དེས་ན་འགྲོ་བ་ཀླུདག་གི་མིག་ངོར་སྣང་བ་གཅིག་ལ་མཛེས་པ་དང་འཇིགས་པར་སྣང་བ་དེ་དག་ཐམས་ཅད་ལ་དེ་ལྟར་མི་ལྟ་སྟེ།",
    "རྩ་ཡིག་མཐོང་སྣང་གི་ལྷ་ཡིན་ན་ཡིད་ལུས་ལ་རྩ་ཡིག་མ་མཆིས།",
    "སྲིན་བུ་དང་གྲོག་མ་ལྟ་བུ་ལ་ལྷ་དེ་དག་གི་བག་ཆགས་མེད་ཀྱང་།",
    "འདིར་ནི་དེ་བཞིན་གཤེགས་པ་ཤའི་སྤྱན་གྱིས་དང་པོར་རང་གི་སེམས་ཀྱི་སྣང་བ་མཐོང་ཞིང་།",
    "དེ་དག་རང་རང་གི་ལུས་ལ་གནས་པའི་ཡེ་ཤེས་ཀྱི་རང་རྩལ་ཕྱིར་ཤར་བ་ཡིན་པས་བག་༧ ཆགས་ལ་རག་མ་ལུས་ཤིང་།",
    "སྒྲ་དྲག་པོ་འབྲུག་སྟོང་ལྡིར་བ་ལ་སོགས་པ་ལ་ནི་སྐྲག་པར་འགྱུར་མོད།",
    "དེ་ལྟར་དུ་རང་དྲིསརང་གི་ཕུང་ཁམས་སྐྱེ་མཆེད་ལ་ཡེ་གདོད་མ་ནས་གནས་པའི་ཞི་ཁྲོ་འཆར་བར་གསུངས་པ་ཡིན་ནོ།",
    "བཅོམ་ལྡན་སྲོག་གི་ལྷག་པའི་བདག་པོ།",
    "ཡི་དྭགས་རང་གི་ལུས་ཀྱི་ཆ།",
    "གྲོག་སྤུར་ལ་སོགས་པ་དག་ལ་དེ་དག་གི་བག་ཆགས་མེད་པས་ལས་སྣང་དེ་ལྟར་དྲིསའཆར་བ་མི་སྲིད་པར་འགྱུར་བའི་ཕྱིར་རོ། ། ཡང་ཡེ་ཤེས་ཀྱི་ལྷ་སྒྲུབ་པ་ལ་ཡང་སྔོན་བསག་གི་ལས་འཕྲོ་ཡོད་པ།",
    "སྒྲུབ་ཐབས་ཟབ་མོ་གཅིག་ལ་བརྟེན་ནས་འབད་རྩོལ་གྱིས་སྒྲུབ་པས།",
    "ཞི་ཁྲོའི་ལྷ་དེ་དག་མཐོང་བ་ལ་མཐོང་ཐོས་དྲན་རེག་གི་ཡོན་ཏན་མེད་པར།",
    "བཟླས་པ་ལ་རྟེན་ནས་ངག་གི་བག་ཆགས་སྦྱོང་།",
    "རྫོགས་རིམ་ལ་རྟེན་ནས་ཡིད་ཀྱི་བག་ཆགས་སྦྱངས་པས་ལྷག་པའི་ལྷའི་ཞལ་མཐོང་སྟེ་བསྐྱེད་རིམ་གྱི་སྒོ་ནས་ལྷ་གྲུབ་པ་ཨ་མ་ཀརྨ་པའི་ཆབ་ཤོག་སོག་ཟློག་པ་ཀ་ཡིན་ལ་དེ་དང་འདི་མི་མཚུངས་ཏེ་འདི་ནི་གོང་དུ་སྨོས་པ་བཞིན་དུ་ཡེ་ནས་གནས་པའི་ལྷ་རང་གི་ལུས་ལས་ཐོན་པའི་སྣང་བ་ཡིན་ནོ།",
    "སྐྱེ་བོ་དག་གི་ང་མི་མཐོང་།",
    "དེས་ན་ལས་སྣང་གི་འཁྲུལ་ངོར་ཡེ་ཤེས་ཀྱི་ལྷ་འཆར་སྔ་འགྱུར་བཀའ་མ་རེ་ལྔ་བར་གསུངས་པ་ཡང་སྔགས་བཙུན་སྐྱེ་བོ་དག་གི་བློ་བཟོ་ཡིན་ནོ།",
    "བདེ་མཆོག་ལེཔ་དག་གི་གྲོལ་ལུགས་རབ་འབྲིང་གི་རྣམ་དབྱེ་གསུང་པ་ནི་ཇི་སྐད་བཀའ་སྩལ་པ་ལྟར་ལགས་མོད་ཀྱང་།",
    "དེའི་ཚེ་འོད་ཁུག་པ་ལྔ་འཆར་མོད་ཀྱི།",
    "ཞི་ཁྲོ་སྒྲ་འོད་ཟེར་དང་བཅས་པའི་སྣང་བ་དེ་དག་གི་གོ་ཆོད་ནས་ལས་སྣང་གཞན་གཏན་ནས་མི་འཆར་བར་གསུངས་པ་མ་ཡིན།",
    "རིམ་ལྔ་པ་དག་གི་འཆི་ཁའི་འོད་གསལ་འཛིན་པ་དོན་གཅིག།",
    "སྐྱེ་བདུན་རང་གི་ངོ་བོ་མ་དག་པར་བསྟན་པའོ།",
    "ཟ་ཧོར་རྒྱལ་པོ་གཙུག་ལག་འཛིན་ཞེས་བྱ་བ་འཁོར་ལོས་བསྒྱུར་བའི་རྒྱལ་པོ་ལྟ་བུ་ཞིག་གི་བུ་མོ་མནྡ་ར་བ་བྱ་བ་ཞིག་ཡོད་པ་ལ།",
    "རྒྱ་དཀར་ནག་ལ་སོགས་པ་ཕྱོགས་ཀྱི་རྒྱལ་པོས་བཙུན་མོར་བསློང་བའི་སྙེ་བོ་མང་སྟེ།",
    "འདི་ཡང་སྔགས་བཙུན་སྐྱེ་བོ་དག་གི་བློ་བཟོར་རིག་པར་བྱའོ།",
    "ཡང་དེ་དག་གི་གདམས་པ་ལ་སྐྱེ་བདུན་གྱི་སྒྲུབ་ཐབས་ཟབ་མོ་འདི་མེད་དེ་ངེད་ཅག་གི་ཁྱད་པར་བའོ་སྙམ་ན།",
    "དེ་དག་གི་དབུས་ན་གྲོལ་བ་ཐོབ་པ་ལྟ་ཞོག་གི།",
    "མཐོང་སྣང་གི་ཡོན་ཏན་སྐྱེས་པ་ཙམ་ཡང་མི་སྣང་ལ།",
    "དེས་ན་སྐྱེ་བདུན་གྱི་ཤ་ཟོས་པས་གྲོལ་བར་རློམ་པ་ཡང་སྔགས་བཙུན་སྐྱེ་བོ་དག་གི་བློ་བཟོ་ཡིན་ནོ།",
    "ཟ་ཧོར་རྒྱལ་པོ་འཁོར་དང་ལོངས་སྤྱོད་རབ་ཏུ་རྒྱས་པ་ཡིན་མོད་ཀྱི།",
    "རྒྱ་གར་གྱི་རྒྱལ་པོ་རྣམས་ནང་ནུབ་ཀྱི་གསོལ་ཟས་བཙུན་མོ་རྣམས་ཀྱི་གན་དུ་རིམ་གྱི་གསོལ་བ་ཡིན་པས་ན།",
    "རྒྱལ་པོ་རྐང་ཁྲ་བཙུན་མོ་ཆུང་བ་ངན་ཤོས་ཀྱི་བསྙན་བཀུར་རེས་ལ་བབ་པ་ན།",
    "དེའི་རླངས་པ་བྱད་བཞིན་ལ་ཕོག་པས་མོ་རྐང་པ་ས་ལ་མི་རེག་པར་འགྲོའོ།",
    "མོ་ལ་སྡིགས་པས་སྐྲག་སྟེ།",
    "སྐྱེས་བུ་གང་གི་རྡུལ་དྲི་ཞིམ་པར་གྱུར་པ་དང་།",
    "གང་གི་ཁ་ཡི་དྲི་ཞིམ་ཤིང་ མིག་གི་འཛུམ་པར་རྣམ་པར་ལྟ།",
    "རང་གི་སྐྱེ་བ་ཤེས་པ་དང་།",
    "བསྣམས་པའམ་རེག་པ་ཙམ་གྱིས་ནི།",
    "མོད་ལ་གྲུབ་པར་འགྱུར་བ་སྟེ།",
    "རྒྱས་པར་བདེ་མཆོག་གི་རྒྱུད་ལེའུ་ལྔ་བཅུ་རྩ་གཅིག་པའི་ལེའུ་བཅུ་གཅིག་པ་དང་།",
    "ཧེ་རུ་ཀ་མངོན་འབྱུང་གི་ལེའུ་བཞི་བཅུ་ཞེ་གཉིས་པ་དང་།",
    "སྒྱུ་འཕྲུལ་ཆེན་མོའི་རྒྱུད་ཀྱི་ལེའུ་དང་པོ་དང་།",
    "ཆུ་བོ་ནེ་རཉྫནའི་འགྲམ་ན་གྲུབ་ཐོབ་ཅིག་ཏིང་ངེ་འཛིན་ལ་བཞུགས་པ་ལ་ཉ་བོ་ཆེ་ཅིག་གི་ཁྱུར་མིད་བྱས་སོང་བས་ལོ་བཅུ་གཉིས་ཀྱི་བར་དུ་ཉའི་ལྟོ་བར་མ་ཞུ་བར་ཏིང་ངེ་འཛིན་ལ་བཞུགས་པ་མཐོང་།",
    "བྲམ་ཟེའི་ཤ་ཁམ་གཅིག་ཟོས་པས་དེ་དྲིས་བདུན་ཅུ་མཁའ་སྤྱོད་དུ་སོང་བ་མཐོང་།",
    "ཅེས་འཁོར་རྣམས་ཀྱི་ཡ་མཚན་པ་ཅི་འདྲ་གཟིགས་ཞེས་ཞུས་པའི་ལན་དུ་གསུངས་ཤིང་།",
    "བོད་ཀྱི་ཕུང་ཐལ་ཆེན་པོ་བྱས་ཞེས་མྱ་ངན་དུ་གྱུར་པ་ན།",
    "གསུམ་པ་ནི་ལེན་བྲམ་ཟེ་གཙང་མ་སྐྱེ་བ་བདུན་བརྒྱུད་པའི་ཤ་ཁྲག་སུའི་ལྟོར་སོང་ཡང་སངས་རྒྱ་བ་ཡིན།",
    "དམ་པ་དེ་ཡང་སྐྱེ་བ་བདུན་པ་ཡིན་པ་ལ་ད་ནི་གདུང་ཐལ་ཙམ་ཡང་མི་སྣང་ངོ་ཟེར་རོ།",
    "བཅངས་ཐབས་རེ་གསུངས་ཀྱང་དེ་ནི་མི་འབྲལ་བའི་དམ་ཚིག་གི་རྟེན་དུ་བཅངས་བ་ཡིན་གྱི་གྲོལ་བར་གསུངས་པ་མེད་དོ།",
    "གདུལ་བྱ་ལམ་པའི་ངོར་དཀའ་བ་སྤྱོད་པ་མཛད་པ་དེ་ཀ་རྗེས་འཇུག་གིས་ལམ་ལ་དཀའ་བ་སྤྱད་པས་གྲོལ་བར་བསྟན་པ་ཡིན་གྱི།",
    "གྲོལ་བ་ལྟ་ཞོག་གི་འཁྲུལ་སྣང་ཅུང་ཟད་ཁ་བྲི་བ་ཙམ་དང་།",
    "དེས་ན་བཏགས་པས་གྲོལ་བར་འདོད་པ་ཡང་སྔགས་བཙུན་སྐྱེ་བོ་དག་གི་བློ་བཟོར་རིག་པར་བྱའོ།",
