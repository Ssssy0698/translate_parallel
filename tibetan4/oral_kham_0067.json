    "བསླབ་གསུམ་རང་རང་རྒྱུད་ལ་དར་བར་མཛོད།",
    "རང་རང་སྲོག་སྔགས་ལ་སོགས་རྗེ་ལ་ཕུལ།",
    "ཁ་བ་ཅན་ན་བྱི་དོར་བྱེད་ཅིང་གདའ།",
    "ཐོག་ཆེན་པོ་དྲུག་ནམ་མཁའ་ལ་ཆགས་ནས་འདུག་པ་མཐོང་།",
    "དེ་མཐོང་ཙ་ན་ཁྲོ་བོ་གཞན་གྱིས་ཀྱང་ལག་ཆ་འབྲུལ་བ་གཅིག་ཏུ་བྱས་ཏེ།",
    "རྡོ་རྗེ་བེ་ཅོན་འཁར་བ་བཙུགས་ནས་འདུག་པ་ལ།",
    "དེ་ནས་རྫིངས་ཆེན་པོ་ཕྲག་ཕྲིག་ཙམ་ཡང་མེད་པར་གནས་གཞི་ཆེན་པོ་བཞིན་དུ་འདུག་ཅི་ཡིན་སྙམ་ནས་བལྟས་པ་དང་།",
    "ཁྱེད་རང་མེ་ཏོག་འདི་ཀུན་སྭ་བ་ན་ཐར་རྒྱོབ་ལ་ཐོང་།",
    "ཡོན་ཏན་གང་ལའང་རང་བཟོ་ཆུང་བར་མཛོད།",
    "ཁྱེད་རང་མ་སྐྱོ་ལྷག་པར་གོ་ཆ་གྱོན།",
    "འདི་རུ་མ་འདུག་གདུལ་བྱ་བོད་ན་ཡོད།",
    "ཡོངས་འཛིན་བསྟེན་ཅིང་རང་བཟོ་ནུབ་པར་འགྱུར།",
    "ཆགས་སྡང་མེད་ཅིང་རང་ཚུགས་ཟིན་པ་དང་།",
    "གང་ལ་བསམས་ཀྱང་ཐོགས་པ་མི་གདའ་བས།",
    "མ་གཅིག་གསུང་ལ་ལྷག་ཆད་མི་གདའ་ན།",
    "བོད་ལ་ལོག་ལྟ་ཆེན་པོ་སྐྱེ་ཉེན་གདའ།",
    "ཁོང་རང་ཙམ་གྱི་གསེར་གྱིས་བསླུ་ཟེར་བ།",
    "ཁྱེད་རང་མཇལ་ཡང་འདི་ལྟར་བསྟན་པའི་བྱ་བ་ཆེས་པས་གདན་མ་འདྲོངས།",
    "ང་རང་ལ་ཡང་བར་ཆོད་བྱུང་ནས་ཇོ་བོ་ཆེན་པོ་སྤྱན་མི་འདྲོངས་པར་གདའ་བས།",
    "པཎྜི་ཏ་གདན་མ་དྲངས་པར་ཁྱེད་རང་ངེད་ཀྱི་འོག་ཏུ་ཞུགས་ཟེར་བ་ནི།",
    "གསེར་ང་རང་ཙམ་པ་རྙེད་པ་ཤིན་ཏུ་རྔམས་ཆེ་ན།"
  ]
}