    "ད་གཟོད་རྒྱ་དང་ང་ཨ་ཏི་ཤ་གཉིས་འཐུན་ཡོད་པར་འདུག་ཁ་ཕྱོགས་ཡིན་ཟེར་འོང་བ་ཡིན་པས།",
    "གནས་བརྟན་གྱིས་ཁྲིད་ནས་བསླབ་པའི་གྲལ་དཀྱིལ་ཞིག་ཏུ་བཞག་དེའི་དུས་ཇོ་བོ་ནི་གསེར་གླིང་ལ་སོགས་པའི་གནས་ཆེན་རྣམས་སུ་བྱོན་ནས་ཕྱག་མ་ཕེབས་པར་གདའ་ནའང་།",
    "དཔལ་འབར་བ་རི་རྒྱལ་ལྷུན་པོ་ལྟར་བཞུགས་གདའ་བས།",
    "སྐུ་འགྱིང་མི་བྱེད་པར་གཤེགས་པ་གཅིག་ཕྱི་ནས་ནང་དུ་རྒྱངས་ཀྱིས་བྱོན་ཙ་ན།",
    "ནངས་པར་གཟུགས་ཨ་ཚོར་བ་ཨ་བྱས་ཙ་ན།",
    "སྤྲང་པོ་མང་པོ་ལ་བཤོས་དང་གཏོར་ཟན་མང་པོ་སྟེར་ཀྱིན་གདའ།",
    "ནངས་པར་དེ་སྒུགས་ཙ་ན་རྣལ་འབྱོར་མ་ཁྲི་སྙན་ས་ལེ་རྐེད་ལ་དཀྲིས་པ་ཌ་མ་རུ་ལག་ན་ཐོགས་པ།",
    "དེ་དག་མེད་ན་ནི་དོས་དྲུག་རྩ་གཉིས་ཙམ་པ་མི་འདྲོངས་པར་གདའ་བས།",
    "ནུབ་གཅིག་མནལ་ཚབ་ཚུབ་ཅིག་ཙ་ན་གཡག་སུམ་ཅུ་རྩ་གཅིག་དེད་པའི་འབྲོག་པ་སྐ་རགས་བསྡམས་པ།",
    "ཁྱེད་རང་དཔོན་གཡོག་ལ་སྙུང་གཞི་ལ་སོགས་པ་མེད་པར་བྲི་ཀ་མ་ལར་སླེབ་པ་གྱིས་བྱོན།",
    "མུ་སྟེགས་ཀྱི་གནས་གཅིག་འདུག་དེ་ན་མུ་སྟེགས་ཀྱི་སྟོན་པ་བཅོ་ལྔ་འདུག་སྟེ།",
    "ཡང་མེ་ཏྲིའི་གཙུག་ལག་ཁང་བསྒྲལ་ནས་མཐའ་འཁོབ་ནས་ཕར་སླེབ་ཙ་ན།",
    "ཇོ་བོ་ལ་ཙན་དན་ལས་བྱས་པའི་ཁྱིའུ་ཤིན་ཏུ་ལེགས་པ་ཞིག་ཡོད་འདུག་པས་དེ་བླངས་ཟེར།",
    "ཇོ་བོའི་ཞལ་ནསརི་བྲག་པ་དེ་ནངས་པར་འདི་འཕྲོག་ཏུ་འོང་བ་འདུག་གསུངས་ནསདེར་ནངས་པར་ཆོམ་རྐུན་དང་ཕྲད་པའི་ཚེ།",
    "ཆོམ་རྐུན་རྣམས་ལམ་བཞུད་བཀག་སྟེ་འདུག་པ་ལ་འགོངས་ཤིང་ཕྱིན་པས།",
    "ཞེས་པའི་འཕྲིན་ཡིག་གདའ་བ་དང་།",
    "དོས་དང་གཡག་རྣམས་ཀྱང་དེ་ན་གདའ།",
    "སུ་ལའང་མི་བསྐུར་ང་རང་འཁུར།",
    "ད་ཨེན་ཙམ་ཕྱིས་འདུག་ད་ཐམས་ཅད་ཀྱིས་བྲམ་ཟེའི་རོ་མ་ཉམས་པ་གཅིག་ཚོལ་ལས་ཤོག་དེ་རྙེད་ན་རིག་སྔགས་འདི་བཟློག་ཏུ་བཏུབ་ཙམ་ཡིན་གསུངས།",
    "གུང་ཐང་པས་རྒྱ་མ་བཞུགས་ཀྱང་རང་ཉིད་ཀྱིས་ལོ་ཙཱ་ཡོང་ཚུལ་ཐུགས་གསོ་མཛད་པས།",
    "ཕྱོགས་དེར་བཞུགས་ཉམས་དགའ་ཞིང་ཡིད་འཕྲོག་པ་གཅིག་གདའ་བས་ཞག་བདུན་ཙམ་ཅིག་བཞུགས།",
    "སྐར་ཚོགས་ཐམས་ཅད་ནམ་གུང་བཞིན་དུ་གྲ་མ་ཉམས་པར་ཉི་ཟླ་གཉིས་ལ་འདུད་ཀྱིནའདུག་པ་རྨིས།",
    "བལ་པོར་ཨ་ཏི་ཤའི་ཐུགས་དམ་གཙུག་ལག་ཁང་ཞིག་བཞེངས་པར་གདའ་བས།",
    "ཁྱེད་རང་གང་འདོད་གསུངས་ཏེ།",
    "འབྲས་ཆན་ལ་རབ་རིབ་དག་པ་ལྟ་བུ་ཡིན་ཁྱེད་རང་སྤྱོད་དང་གསུངས།",
    "ཇོ་བོའི་སྙན་པ་དང་རང་ཕྱོགས་སུ་བྱོན་ཚུལ་རྣམས་གསན་ནས་ཐུགས་དགོངས་ལ།",
    "པཎྜི་ཏ་དང་ཁོང་རང་བསྟན་མཉམ་པོ་ཙམ་བྱས།",
    "བོད་ལ་ཁོ་བོ་དགོས་པར་འདུག་གསུངས་ནས་ལན་གཞན་མི་སྨྲ་བར་བཞུགས།",
    "ཡོད་སྨྲ་ཁྱེད་རང་ཡིན།",
    "གཏན་ལ་ཕབ་ནས་འདུག་པས།",
    "དེར་ཇོ་བོའི་སྐུ་འདྲ་ཞིག་ཀྱང་བཞེངས་པ་དཀར་ལ་མདངས་ཆེ་བ་ཅིག་གདའ་སྐད།",
    "ཕྱག་མཛད་ཅིང་ཟངས་དཀར་མཛོད་ཕུར་བཞུགས་པར་གདའ།",
    "ཕྱག་རྡོར་གྱི་སྤྲུལ་པ་གཅིག་སྟེ་བརྒྱད་འདིར་འཕྲིན་ལས་མཛད་པའི་རྟགས་སུ་འདུག་གསུངས།",
    "དྷི་དང་ཁྱད་པར་མི་འདུག་གསུངས།",
    "དེར་སྤྱན་སྔར་དགེ་ཚུལ་གཉིས་ཤིག་ལས་མེད་ཙ་ན།",
    "དགེ་སློང་དེ་གཉིས་མི་འདུག་པ་དང་།",
    "ཁོ་བོ་དེ་ལས་དམན་ལྟར་གདའ།",
    "དེ་རྣམས་ན་ཡང་འདི་ཀུན་མི་འདུག་གསང་སྔགས་འདི་མམཐའ་མངོན་རྒྱུ་ཡོད་ཡོད་མི་འདྲ།",
    "གཞན་ཡང་དེའི་དུས་ཀྱི་བསྟན་པ་ལྟ་བུ་རྒྱ་གར་དུ་ཡང་མ་བྱུང་བ་འདུག་རཱ་ཛཱ་བོ་དྷི་ས་ཏཱ་གསུངས་ཤིང་རྗེས་སུ་ཡི་རང་མཛད་ཅིང་།",
    "བྱིས་པ་ཚན་གཅིག་ལ་རྒྱལ་པོ་སའི་སང་ག་ལ་མཉེས་པའི་དུས་ཀྱང་མི་གདའ་ན།",
    "ལྷ་བཙུན་བོ་དྷི་རཱ་ཛཱ་ལ་འབབ་པའི་དུས་ཀྱང་མི་གདའ་ན།",
    "ཇོ་བོ་ལྷ་གཅིག་མཚན་ཅན་ལ་གཤེགས་པའི་དུས་ཀྱང་མི་གདའ་ན།",
    "འགྱུར་ལེགས་པར་གདའ་འམ་གསུངས།",
    "ཡང་ཡང་ལོ་ཙཱ་བ་དང་གཉིས་འགྱུར་ཆུང་འགྱུར་ལེགས་པར་གདའ་འམ་གསུངས།",
    "ལ་རྒྱབ་ན་རྟ་རྒན་གཅིག་ལག་པ་རྫ་བར་དུ་ཚུད་ནས་འདུག་སྐད།",
    "དེར་འདོན་པར་བརྩམས་པས་གཏེར་བདག་གཉེན་པོ་ཞིག་འདུག་པས།",
    "འདི་སུ་ལ་ཡང་མ་བསྟན་ཅིག་ལྷ་བསྲུང་བཟང་པོ་ཞིག་འདུག་གོ་གསུངས་ནས་རྣལ་འབྱོར་པ་ལ་གཏད།",
    "གྲིབ་ཀྱི་རི་དང་ལྷ་ས་གཉིས་ལ་ཕར་བཞུད་ཚུར་བཞུད་བྱེད་པའི་རྣལ་འབྱོར་མ་གཅིག་ཀྱང་འདུག་གསུངས།",
    "ཇི་ལྟར་ལགས་ཞུས་པས་བཞི་གདའ་པ་གསུངས།",
    "ཅང་ཤིའམ་ཁ་སང་རང་བསྙེན་བཀུར་བྱས་པ་ཞུས་པས།",
    "བང་སྟོན་དེ་ནི་ཐུགས་བསམ་བཟང་པོ་ཞིག་ཡོད་པ་འདུག་སྟེ།",
    "ཁོ་བོ་འོང་མི་དགོས་པ་འདུག་པ་ལ་གསུངས་ནས་གདམས་ངག་ཤས་ཅིག་གནང་།",
    "བསྲུང་སྡོམ་དག་པ་གཅིག་སུས་གར་ཡང་མི་ཕྱིན་པར་འདུག་གསུངས།",
    "ད་ལྟ་རྒྱ་གར་ན་ངོ་མཚར་བའི་གཏམ་ཇི་ལྟར་འདུག་དྲི་བ་གནང་བས།",
    "ཁོང་ཐེ་ཚོམ་དུ་གྱུར་ཙ་ན་འབྲོམ་སྤོས་གཅིག་དང་རྔ་ཡབ་གཅིག་ཁྱེར་ནས་བྱུང་སྟེ།",
