    "བསྐལ་སྲིད་ཆགས་འཇིག་གི་མི་རྟག་པར་བློ་སྦྱོང་།",
    "ཞེ་སྡང་ལས་གྱུར་པའི་ཉོན་མོངས་པ་ཉིས་ཁྲི་ཆིག་སྟོང་གི་གཉེན་པོར་རྒྱས་པ་འབུམ་གྱི་བོན་ཉིས་ཁྲི་ཆིག་སྟོང་།",
    "དུག་གསུམ་ཆ་མཉམ་ལས་གྱུར་བའི་ཉིས་ཁྲི་ཆིག་སྟོང་གི་གཉེན་པོར་སྔགས་སེམས་རྒྱུད་ཀྱི་བོན་སྒོ་ཉིས་ཁྲི་ཆིག་སྟོང་།",
    "བྱང་གཏེར་བཅས་ཟེར་དོན་ནི་གཙོ་བོར་གཏེར་བཏོན་སའི་མིང་གིས་ཁྱད་པར་བྱས་ཏེ་གཏེར་སྟོན་གཤེན་ཆེན་ཀླུ་དགས་ལྷོ་འབྲིག་མཚམས་མཐའ་དཀར་སོགས་ནས་བཏོན་པའི་བོན་སྒོ་སྐོར་ལ་ལྷོ་གཏེར་དང་།",
    "དང་བོ་མིའི་རིགས་བྱུང་ཁུངས་ཀྱི་ཐད་ལ་འཛམ་གླིང་དུ་ལྷ་སྒྲུང་གི་གཏམ་རྒྱུད་སྣ་ཚོགས་བྱུང་ཡོད་པ་དཔེར་ན།",
    "དེའི་རྗེས་ནས་ཁོང་གིས་ལོར་པར་དུ་བསྐྲུན་པའི་མིའི་རིགས་ཀྱི་བྱུང་ཁུངས་ཞེས་པའི་ནང་མིའི་རིགས་ནི་འཕེལ་འགྱུར་བྱས་ནས་བྱུང་བའི་ལྟ་བ་དངོས་སུ་བཏོན་པར་མ་ཟད།",
    "ད་ལྟ་འཛམ་གླིང་གི་ཚན་རིག་པ་རྣམས་གཅིག་མཐུན་དུ་སྤྲ་ཡིན་པར་འདོད།",
    "ཡིན་ནའང་མིའི་རིགས་ནི་སྤྲ་ནས་འཕེལ་འགྱུར་བྱུང་བའི་རིགས་ལམ་འདིར་གནའ་དེང་རྒྱལ་ཁབ་ཕྱི་ནང་གི་མཁས་པ་མང་བོས་དོགས་སློང་མཛད་མྱོང་བ་རེད།",
    "འདི་འདྲ་དམིགས་བསལ་ཞིག་ཡིན་པ་ནི་རང་བྱུང་ལས་བརྒལ་བ་ཞིག་གིས་ཐེ་གཏོགས་མ་བྱས་པ་མི་སྲིད་པར་སྙམ།",
    "རྒྱལ་ཁབ་སོ་སོའི་བྱུང་བའི་སྤྲའི་འགྱུར་རྡོ་འཚོལ་སྡུད་དང་བརྟག་དཔྱད་གནང་བའི་ལས་ནི་ད་ལྟའི་བར་རྒྱུན་ཆད་མྱོང་ཡོད་པ་མ་རེད།",
    "དང་ཐོག་ཚན་རིག་པ་ལ་ལས་ལཱ་མ་ཞེས་པའི་གནའ་བོའི་སྤྲ་ཞིག་གི་འགྱུར་རྡོ་རྙེད་སོན་བྱུང་བར་བརྟེན་ཏེ།",
    "མིའི་རིགས་རིག་པ་སྨྲ་བ་དག་གིས་སྐྱེ་དངོས་རྫས་འགྱུར་རིག་པའི་སྟེང་ནས་སྨྲའི་འགྱུར་རྡོ་དེ་རིགས་ལ་བརྟག་དཔྱད་བཏང་བས་དེའི་འདུས་རྡུལ་ལྟར་ན་མིའི་དངོས་རིགས་ཆེས་ཐོག་མར་བྱུང་བའི་དུས་ནི་ད་ལ་ཐུག་གི་བར་དུ་ལོ་ས་ཡ་ལྔ་ནས་ས་ཡ་བདུན་གྱི་སྔོན་ཡིན་པར་འདོད།",
    "རྐང་གཉིས་ལ་བརྟེན་ནས་འགྲོ་ཐུབ་པ་བྱུང་བ་དེ་ནི་སྐྱེས་དངོས་རིག་པའི་སྟེང་གི་འགྱུར་ལྡོག་ཆེན་པོ་ཞིག་ཡིན་པར་མ་ཟད།",
    "འཚོ་གནས་ལ་འཚམས་པའི་འགྱུར་ལྡོག་གལ་ཆེན་ཞིག་ཀྱང་རེད།",
    "གླིང་ཆེན་ཨ་ཧྥེ་རི་ཁའི་སྐམ་སའི་ཤར་ཕྱོགས་ཀྱི་ས་ཤུན་དེ་ཤར་མཚོ་ནས་དེང་གི་ཨེ་སེ་ཨོ་ཕི་ཡ་དང་ཁེ་ཉི་ཡ།་",
    "གནམ་གཤིས་ཀྱང་བསྒྱུར་བ་རེད།",
    "མེས་པོ་གཅིག་ཡིན་པའི་ནུབ་རྒྱུད་ན་ཡོད་པའི་བུ་རྒྱུད་རྣམས་ཀྱིས་བརླན་གཤེར་དང་ཚང་ཚིང་དུ་འཁྲུགས་པའི་ནགས་གསེང་གི་འཚོ་བར་བསྟུན་ཅི་ཐུབ་བྱས་པ་ལས་སྤྲ་རིགས་སུ་གྱུར་པ་དང་།",
    "དེ་བཞིན་དུ་མིའི་རིགས་རིག་པ་བ་རྣམས་ཀྱིས་ཨ་ཧྥེ་རི་ཁ་ཤར་ལྷོ་ནས་རྙེད་པའི་ཆེས་སྔ་བའི་མིའི་རིགས་ཀྱི་འགྱུར་རྡོའང་ཕལ་ཆེར་ལོ་ས་ཡ་བཞི་ནས་ལོ་ས་ཡ་གཅིག་གི་སྔོན་ཡིན་པ་དང་།",
    "ད་ལ་ཐུག་གི་བར་དུ་ལོ་ས་ཡ་གཉིས་དང་འབུམ་ཕྲག་ལྔའི་སྔོན་དུ་མིའི་རིགས་ཀྱིས་རྡོ་ཆས་དེ་འདྲ་མི་ལེགས་པའི་ལག་ཆ་སྣ་ཚོགས་བཟོ་ཐུབ་པ་རེད།",
    "དེ་ལྟར་ན་རྐང་གཉིས་ལ་བརྟེན་ནས་འགྲོ་ཐུབ་པ་ནས་རྡོ་ཆས་ལག་ཆ་བཟོ་ཐུབ་པའི་བར་དུ་ལོ་ས་ཡ་ལྔ་ཡོད་པ་རེད།",
    "དུས་སྔ་མོའི་སྤྲ་མི་འཚོ་གནས་ཀྱི་ལོ་རབས་ནི་ད་ལ་ཐུག་གི་བར་དུ་ལོ་ས་ཡ་གསུམ་དང་འབུམ་ཕྲག་བརྒྱད་ནས་ལོ་ས་ཡ་གཅིག་ནས་འབུམ་ཕྲག་བརྒྱད་ཀྱི་སྔོན་ཡིན་ལ།",
    "དུས་སྔ་མོའི་རིག་པའི་མི་འཚོ་གནས་ཀྱི་ལོ་རབས་ནི་ད་ལ་ཐུག་གི་བར་དུ་ལོ་འབུམ་ཕྲག་གསུམ་ནས་ལོ་འབུམ་ཕྲག་གཉིས་སྔོན་ནས་ད་ལ་ཐུག་གི་བར་དུ་ལོ་ཁྲི་ཚོ་ལྔ་ནས་ལོ་ཁྲི་ཚོ་བཞིའི་ཡར་སྔོན་ཡིན།",
    "མི་ལ་ལས་མི་ནག་རྣམས་ནི་ལོ་ས་ཡ་གསུམ་སྔོན་གྱི་གླིང་ཆེན་ཨ་ཧྥེ་རི་ཁའི་དམར་ལམ་ས་རྒྱུད་དུ་འཚོ་བའི་གདོད་མའི་མི་དེ་དག་གི་རྒྱུད་པ་ཡིན་པ་དང་།",
    "ཁོ་ཚོ་ད་ལ་ཐུག་གི་བར་དུ་ལོ་འབུམ་ཕྲག་གཅིག་ཡོད་པར་འདོད།",
    "ལོ་ཁྲི་ཚོ་ལྔའི་སྔོན་དུ་མིའི་རིགས་གླིང་ཆེན་ཨེ་ཤེ་ཡའི་པེ་ལིན་མཚོ་འགག་བརྒྱུད་ནས་གླིང་ཆེན་ཨ་མེ་རི་ཁར་སླེབས་པ་དང་།",
    "ལོ་ཁྲི་ཚོ་བཞིའི་སྔོན་ནས་གླིང་ཆེན་ཨ་ཤེ་ཡའི་མི་གླིང་ཆེན་ཨ་ཤེ་ཡའི་ཤར་ལྷོ་བརྒྱུད་ནས་ཨོ་གླིང་ཨོ་སི་ཀྲི་ལི་ཡ་དུ་ཐོན་པ་རེད།",
    "ཕལ་ཆེར་ལོ་ས་ཡ་གཉིས་དང་འབུམ་ཕྲག་ལྔའི་སྔོན་ནས་ཀླད་ཚད་ཇེ་ཆེར་སོང་སྟེ་མི་གཏོགས་བྱུང་ཞིང་དེང་རབས་མིའི་འབྱུང་ཁུངས་ཀྱང་དུས་དེར་ངོས་འཛིན་པ་ཡིན།",
    "ཕལ་ཆེར་ལོ་ཁྲི་གཅིག་གི་སྔོན་ནས་བཟུང་སྟེ་འཛམ་གླིང་ཡོངས་ཀྱི་མི་རྣམས་གཏན་སྡོད་མེད་པར་གང་སར་འཁྱམས་ནས་འཚོ་བ་རོལ་ཅིང་ལས་སུ་རི་དྭགས་བདའ་བ་དང་འཚོ་རྟེན་སྣ་ཚོགས་འཚོལ་སྡུད་བྱེད་པ།",
    "ང་ཚོ་ཞང་བོད་ཀྱི་མི་རིགས་འདི་དུས་ནམ་ཞིག་བྱུང་བ་དང་དེའི་འཕེལ་ཚུལ་ག་འདྲ་ཞིག་ཡིན་ནམ་ཞེ་ན།",
    "མཚོ་བོད་མཐོ་སྒང་ནི་ཉེ་བའི་ལོ་ས་ཡ་གཅིག་གི་རིང་ལ་ས་ཤུན་ཇེ་མཐོར་སོང་བ་ལས་གྲུབ་ཅིང་།",
    "ཤར་ཕྱོགས་ནས་ནུབ་ཕྱོགས་སུ་གཉོན་ཆེན་གདང་ལ་རི་བོ་དང་ཧི་མ་ལ་ཡ་རི་བོ་སོགས་གངས་རི་ཆེན་པོ་དེ་དག་གི་རི་རྒྱུད་མུ་ཁྱུད་དུ་ཡོད།",
    "རྗེས་སུ་ས་ཤུན་འགུལ་སྐྱོད་བྱས་པ་དང་བསྟུན་ནས་མཚོ་ངོས་རིམ་བཞིན་ཇེ་ཆུང་དུ་སོང་བ་དང་།",
    "འགུལ་སྐྱོད་དེའི་ཁྲོད་དུ་རི་བོ་ཧི་མ་ལ་ཡ་རིམ་བཞིན་ཇེ་མཐོར་སོང་སྟེ་འཛམ་གླིང་སྟེང་ཆེས་མཐོ་བའི་རི་བོར་གྱུར།",
    "དུས་མཚུངས་སུ་མཚོ་བོད་མཐོ་སྒང་འདི་ཡང་ཇེ་མཐོར་སོང་སྟེ་འཛམ་གླིང་གི་ས་མཐོ་ཤོས་སུ་གྱུར་པར་མ་ཟད།",
    "ཕལ་ཆེར་ལོ་རེར་ཧོ་སྨི་རེ་ཇེ་མཐོར་འགྲོ་བཞིན་ཡོད་ཅེས་གསུངས་སོ།",
    "དེར་མི་ལ་ལས་བོད་ཀྱི་ཡུལ་འདི་ས་མཐོ་ལ་ནམ་ཟླ་འཁྱག་ཅིང་དབྱང་དབུགས་ཉུང་བ་སོགས་འཛམ་གླིང་གི་ཡང་རྩེ་ཡིན་པའི་ཆ་ནས་ཚེ་སྲོག་འཕེལ་ཐབས་མེད་པར་འདོད་ཀྱང་།",
    "དེ་ནས་ལོ་བྱེ་བ་གཅིག་ལྷག་གི་གཡུང་དྲུང་བོན་དང་འབྲེལ་བའི་ལོ་དེབ་མུ་ཁྲི་བཙན་པོའི་དཔྱད་རྩོམ་བདམས་བསྒྲིགས།་",
    "ཆ་སྙོམས་ལོ་རེའི་དྲོད་ཚད་ནི་ཡས་མས་ཤིག་ཡིན།",
    "ལོ་རེའི་ཆར་ཆུ་འབབ་ཚུལ་ནི་ཧོ་ཧྲིན་ནས་ཧོ་ཧྲིན་ཡིན།",
    "དེ་ནས་ལོ་བྱེ་བ་གཅིག་གི་སྟོད་གསར་དུས་རབས་ཀྱི་མཇུག་ནས་ལོ་ས་ཡ་གཉིས་ཀྱི་སྔོན་ཆེས་གསར་དུས་རབས་བཞི་པའི་མགོར་ཧུམ་རྡུ་བྲོག་ལེབ་དང་ཨེ་ཤ་ཡ་ཤར་མའི་བྲག་ལེབ་གཉིས་ཕན་ཚུན་གདོང་གཏུག་དང་བཙིར་གནོན་ཐེབས་རྗེས་མཚོ་བོད་མཐོ་སྒང་འདི་ད་གཟོད་ཁྱོན་ཆེ་ཞིང་གཞི་རྒྱ་ཆེན་པོར་འབུར་དུ་ཐོན་པ་རེད་ཅེས་གསུངས་པ་དང་།",
    "དེས་ན་མཚོ་བོད་མཐོ་སྒང་འདིར་གནའ་བསྐལ་བ་ནས་མིའི་རིགས་འཚོ་གནས་ཐུབ་པའི་ཆ་རྐྱེན་ལྡན་པ་ཚན་རིག་གིས་བདེན་དཔང་བྱས་པར་མ་ཟད།",
    "དེ་ད་ལ་ཐུག་གི་བར་དུ་མི་ལོ་ས་ཡ་གཅིག་དང་འབུམ་ཕྲག་བདུན་ཡོད་པར་ཐད་ཡཐམཐཱཐཐིནམཐཱཐམ་མཐ་༧་ལོ།"
  ]
}