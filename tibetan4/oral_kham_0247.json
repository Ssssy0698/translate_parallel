    "ལོ་དེའི་ཟླ་བརྒྱད་པའི་ནང་རང་ཉིད་ཀྱིས་སྣེ་ཁྲིད་ནས་མི་དམངས་༦ ཙམ་བོད་བསྐྱོད་བྱེད་པའི་གསང་བའི་ལས་འགུལ་ཕྱིར་རང་ཡུལ་དུ་ལོག་པ་ཞེས་པའི་སྣེ་ཁྲིད་བྱས།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "རྗེ་འཇིག་རྟེན་གསུམ་གྱི་མགོན་པོའི་བཀའ་འབུམ་དུ་མི་འཁྲུགས་པའི་སྒྲུབ་ཐབས་གཉིས་གཟུངས་ཆོག་དང་བཅས་གསུངས་འདུག་པ་བཅོས་ལྷད་མེད་པར་ངག་འདོན་དཀྱུས་སུ་ཕབ་པ་འདིའང་།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་ཅིང་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་སེམས་དང་ཡང་མ་བྲལ་བར་བྱེད་ཅིང་དེ་དག་ནི་ཁྱིམ་སྟོང་པ་ན་འདུག་ཀྱང་རུང་།",
    "བླ་གབ་མེད་པ་ན་འདུག་ཀྱང་རུང་།",
    "ལམ་གོལ་བ་ན་འདུག་ཀྱང་རུང་སྟེ།",
    "མིར་གྱུར་པ་གང་སུ་འདུག་ཀྱང་རུང་སྟེ།",
    "གྱེཐང་དུ་འདུག་པ་མ་ཡིན།",
    "གཤོང་དུ་འདུག་པ་མ་ཡིན།",
    "གང་ལ་ཡོངས་སུ་བསྔོ་བའི་སེམས་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའོ་ཞེས།",
    "གང་རང་བཞིན་མ་ཡིན་པ་དེ་ནི་མ་བྱས་པའོ།",
    "འཕེལ་བར་དུཡང་མི་གདའོ་ཞེས་ནས་འདོད་པ་ན་སྤྱོད་པ་དང་།",
    "འདུག་གམ།",
    "བྱ་དེ་འཛམ་བུའི་གླིང་དུ་མ་སྨས་མ་སྣད་པར་འདུག་པར་འགྱུར་རམ།",
    "དྲན་བཞིན་དུ་འདུག།",
    "ནོར་པའི་སེམས་ཀྱིས་མི་འདུག།",
    "དྲན་བཞིན་དུ་འདུག་གོ།",
    "༧༥ལི་འདུག་༧༥༡ཁུ་དེ།",
    "ག་དུས་ཡིན་རུང་ཁུ་སིམ་པོ་ཞིག་ཡོད་དུས་དེའི་ནང་ལ་སོར་གནས་རང་བྱས་ནས་བསྡད་རྒྱུའི་བསམ་བློ་མ་གཏོགས།",
    "ཨིན་སྐད་དུའང་ཇི་བཞིན་ལུང་དྲངས་ནས་བཞག་འདུག།",
    "ད་ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ།",
    "སྔགས་དང་ཕྱག་རྒྱས་བྱིན་གྱིས་རླབས་པའི་དོན་དུ་སློབ་དཔོན་གྱིས་རིགས་གསུམ་སྤྱིའི་སྔགས་རྒྱས་ཁྱེད་རང་རྣམས་ཀྱི་གནས་གསུམ་དུ་གཏུགས་པ་ལ་བརྟེན་ནས།",
    "དེ་བས་ན་ཁྱེད་རང་རྣམས་ཀྱིས་རྙེད་པའི་མཆོག་ལེགས་པར་རྙེད་ཅིང་།",
    "འཇིག་རྟེན་གསུམ་རྒྱལ་གྱི་སྔགས་རྒྱ་ཁྱེད་རང་རྣམས་ཀྱི་གནས་གསུམ་དུ་གཏུགས་ཤིང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་དང་།",
    "ཁྱེད་རང་རྣམས་སྔོན་ཆད་བཅོམ་ལྡན་འདས་ཀུན་རིག་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་དུ་མ་ཞུགས་པའམ།",
    "ཞེས་ཐམས་ཅད་ཀྱི་སྤྱི་བོར་རྡོ་རྗེ་རྒྱ་གྲམ་དུ་བཞག་དེ་ནས་ཁྱེད་རང་རྣམས་གྲལ་རིམ་བཞིན་བཞེངས་ཏེ།",
    "དེ་ལྟར་མཐའ་བརྟེན་རྣམས་གྲུབ་ནས་བཀའ་བསྒོ་བ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "གསུང་འདི་དག་ལ་དཔགས་ན་དུས་སྐབས་བཟང་པོ་དེ་དག་ཏུ་ཡང་བླུན་པོས་ཤེས་ལྡན་ལ་གཤེ་བ་འདི་ཡོད་ཚོད་དུ་འདུག་གོ།",
    "རྒྱལ་པོ་འདི་ལྷ་དང་མིས་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་མངའ་བ་ཞིག་འདུག་ནའང་།",
    "ཁོང་རང་ཐབས་ཀྱིས་འོང་བ་སོགས་ཀྱི་ལོག་སྐད་ཀོང་ཇོ་དཔོན་གཡོག་ལ་སྤྲིངས་སོ།",
    "བ་ཞིག་ལ་འདྲེན་གྱི་འདུག་པ་མཐོང་བས།",
    "སྤྲུལ་པ་ཁོ་ནར་འདུག་ཅེས་བགད་པས།",
    "བྲག་དམར་མགྲིན་བཟང་བཤིག་འདུག་༣༣ན་པས།",
    "རྒྱལ་པོའི་འཁྲུངས་ལོ་གསལ་བར་མ་མཛད་འདུག་ཅིང་།",
    "ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ན།",
    "སོ་འདུག་པ་མཐོང་སྟེ།",
    "མདང་སྐྱེས་ཀྱི་བུ་ཆུང་ལ་སོ་ནི་གདའ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་གསང་བ་གསུམ་གྱི་བདུད་རྩིའི་ཆུ་རྒྱུན་གྱིས་ཐུགས་ཀྱི་བུམ་བཟང་ཡོངས་སུ་གང་བས།",
    "རྡོ་རྗེ་དང་དྲིལ་བུ་ནམ་མཁར་འཇོག་ནུས་ཤིང་རང་སྒྲ་འཁྲོལ་བ།",
    "རྫུ་འཕྲུལ་དང་རྟོགས་པ་རྟོགས་ལྡན་རྒྱལ་པོ་འདི་མཐོ་བར་འདུག་གསུངས་པས།",
    "དྭགས་པོ་སོགས་སུ་དཔུང་ཁྱེར་བྱས་པའི་ས་མཚམས་ཀྱི་བྲག་ལ་ཨང་ལེན་གྱི་མིང་བྲིས་འདུག་ཟེར་བ་སོགས་དཔོན་ཆེན་ཞིག་ལ་དྲག་ཤུལ་འདི་ཉིད་ཆེ་ཞིང་།",
    "རྒྱལ་པོའི་ན་བཟའ་འདུག་པ་མཐོང་སྟེ་ཟམ་ཁ་འཇིགས།",
    "འཇིག་རྟེན་གྱི་སྟོབས་དང་གོང་མའི་ལག་རྟགས་སོགས་མེད་འདུག་པས།",
    "ཉིད་ཀྱི་གསུང་འདི་ལྟར་ན་ངེད་ཀྱིས་སྔར་བརྩམས་པ་རྣམས་ལ་ཡང་བཅོས་བྱེད་དགོས་པར་འདུག་གསུངས་སྐད།",
    "མ་བྱུང་ན་བཞི་ཐོག་པའི་དྲུང་འཁོར་ལས་ཚན་ཞིག་ཞུས་འདུག་པ་ལྟར་དམ་གཉེར་ལ་བསྐོས་ནས།",
    "བདག་ཆེན་པ་ཐུགས་གཏུམ་པས་གསོལ་གཟིམས་དམ་གཉེར་སོགས་ལ་བཀའ་བཀྱོན་འཕྲལ་འཕྲལ་ཡོང་བ་ཞིག་འདུག་པས།",
    "སི་ཏུ་རྟ་རར་ཁྲིད་ནས་རྟ་བྲེས་ཀྱི་ཁ་ཤིང་གོག་ལ་ཁད་ཅིག་འདུག་པ་དེ་བསྟན་ནས།",
    "མ་ངེས་པའི་དཔོན་ཆེན་གྱི་ངེད་བཟུང་བ་བཞིན་བྱུང་ན་ངེད་ཀྱི་ལྤགས་པ་དམར་བཤུས་བྱེད་ཀྱི་འདུག་ཟེར་འབྱུང་ཀྱང་།",
    "དུས་གསུམ་མཁྱེན་པ་མཚོ་སྐྱེས་རྡོ་རྗེའི་རིང་ལུགས་པ་སློབ་དཔོན་བེ་རོ་ཙ་ནའི་ཐུགས་སྤྲུལ་གཏེར་སྟོན་ཤེས་རབ་འོད་ཟེར་ཏི་ཤྲིར་བསྟེན་ནས།",
    "དེང་སང་ཡང་རྒྱལ་རྩེའི་ལི་མ་ལྷ་ཁང་དུ་བཞུགས་ཡོད་འདུག་ཅིང་།",
    "དེ་སྐབས་བོད་དང་བོད་ཆེན་པོ་མཐའ་དག་མངའ་འོག་ཏུ་ཆུག་པའི་མཚན་ལྟས་ལེགས་པའང་འགའ་ཞིག་བྱུང་འདུག།",
    "ནངས་པར་སྔར་གྱི་རྒྱུ་རྣམས་ལ་ཐུགས་རྗེ་ཆེན་པོ་བཅུ་གཅིག་ཞལ་དུ་གྲུབ་འདུག་པས།",
    "རྟེན་འདི་ཡ་མཚན་ཞིང་ཤིན་ཏུ་མགྱོགས་པ་ཞིག་བྱུང་འདུག་ནའང་།",
    "རང་བྱོན་དུ་གདའོ།",
    "སྐུ་རྣམས་རང་རང་དང་མཐུན་པའི་ན་བཟའ།",
    "དེ་མགོན་པོ་གྲི་གུག་ཡིན་པར་ངོས་འཛིན་གནང་འདུག་པས།",
    "རྒྱ་བལ་གྱི་ས་མཚམས་ཀྱི་ནགས་ཁྲོད་ཆེན་པོ་ཞིག་ན་ཙན་དན་གྱི་སྡོང་པོ་འོད་ཟེར་ཕྱོགས་བཅུར་འཕྲོ་བ་ཞིག་འདུག་པ་དེ་དུམ་བུ་བཞིར་བཅད་པ་ལས།",
    "ཕྱིས་ཁོ་རང་ས་སྐྱར་བཅོམ་དུ་བཅུག་པ་ལྟ་བུ།",
    "དངོས་གྲུབ་ཐོབ་པའི་ཐབས་མཆོག་དུས་འཁོར།",
    "ཉམས་མྱོང་རང་རིག་ལྷན་སྐྱེས་ངོ་འཕྲོད་པས།",
    "འཕན་འདུགས་ཕྱེ་ཕུར་ལ་སོགས་མཆོད་སྦྱིན་དབུལ།",
    "རང་རང་མངའ་རིས་རྣམས་ཀྱི་ཆོག་ཤེས་ཤིང་།",
    "སྣང་ཡང་རང་བཞིན་མེད་པ་ཆུ་ཟླ་ལྟར།",
    "ལོངས་སྐུ་གླང་ཆེན་ཉལ་༣༢ན་བའི་འདུག་སྟངས་ཀྱིས།",
    "མ་བྱུང་བར་དུ་རྡོ་རྗེའི་འདུག་སྟངས་སོགས།",
    "སྣང་བཞིའི་ལམ་བཟང་རང་སེམས་གདོད་མའི་ཞལ།",
    "རང་རང་སྤྱོད་ཚུལ་རྗེས་སུ་འཇུག་པའི་རྫས།",
    "སྙན་ཚིག་དུས་ལས་ཡོལ་བ་མེད་པའི་བརླབས།",
    "མང་ཐོས་འོད་ཟེར་འབུམ་ཕྲག་དུས་གཅིག་ཏུ།",
    "འོན་ཀྱང་རང་བློས་ཇི་ཙམ་གཞལ་ནུས་པ།",
    "འདུག་ན་མུ་སྟེགས་གྲུབ་པའི་མཐའ་ལས་ཀྱང་།",
    "གསེར་སྒོང་རང་བློའི་དྲོད་ཀྱིས་ཡོངས་སྨིན་པའི།",
    "བེ་རོ་ཙ་ན་གཟུགས་གཞན་གཉིས་པ་བཟུང་།",
    "ཕྱི་ནང་སྟེང་འོག་ཕྱོགས་མཚམས་གར་འདུག་ཀྱང་།",
    "ཡབ་གཅིག་དུས་ཀྱི་བདག་པོར་གནམ་གྱི་བུ།",
