    "མ་གྲུབ་པ་བསྟན་པར་བྱ་བ་བསྒྲུབ་བྱའི་མཚན་ཉིད་དུ་འདོད་པས་དེ་ལ་ཕྱོགས་ཚིག་སྒྲུབ་ངག་གི་ཡན་ལག་ཏུ་བསྟན་པར་བྱ་བ་མ་ཡིན་མོད།",
    "མངོན་སུམ་དང་དངོས་སྟོབས་རྗེས་དཔག་གིས་བསལ་བ།",
    "ཡིད་ཆེས་རྗེས་དཔག་གིས་བསལ་བ།",
    "གྲགས་པའི་རྗེས་དཔག་གིས་བསལ་བའོ།",
    "མངོན་སུམ་དང་དངོས་སྟོབས་རྗེས་དཔག་གི་བསལ་བ།",
    "དངོས་སྟོབས་རྗེས་དཔག་གིས་བསལ་བ་དང་།",
    "ཡིད་ཆེས་རྗེས་དཔག་གིས་བསལ་བ།",
    "གྲགས་པའི་རྗེས་དཔག་གིས་བསལ་བ་དང་བཞི་སྟེ།",
    "མངོན་སུམ་ལ་བཞི་ཡོད་ཀྱང་གཞལ་བྱ་མངོན་གྱུར་དང་ལོག་ཕྱོགས་ལ་གནོད་ཚུལ་ཡང་མཚུངས་པས་འདིར་མངོན་སུམ་རྗེས་དཔག་གི་གཞལ་བྱ་ལྐོག་གྱུར་དུ་མཚུངས་ལ་བཞིར་མ་ཕྱེ་ལ།",
    "འོ་ན་སྒྲོན་མེས་མུན་པ་མི་སེལ་བར་ཐལ།",
    "དངོས་སྟོབས་རྗེས་དཔག་གིས་བསལ་བ་ནི།",
    "དངོས་སྟོབས་རྗེས་དཔག་གིས་གྲུབ་པའི་དོན་གྱི་ལོག་ཕྱོགས་དངོས།",
    "སྒྲ་མི་རྟག་པར་རྟོགས་པའི་རྗེས་དཔག་གིས་སྒྲ་མི་རྟག་པར་གཞལ་སྟོབས་ཀྱིས་སྒྲ་རྟག་པ་ལ་གནོད་པ་ཡིན་ནོ།",
    "ཡིད་ཆེས་རྗེས་དཔག་གི་བསལ་བ།",
    "གཉིས་པ་ཡིད་ཆེས་རྗེས་དཔག་གིས་བསལ་བ་ལ་གཉིས།",
    "ཐུན་མོང་གི་འདོད་པ་དང་།",
    "རང་གི་བརྗོད་བྱའི་སྒྲུབ་བྱེད་དུ་ཁས་མ་བླངས་པའི་ཕྱིར་རོ།",
    "སློབ་དཔོན་ཕྱོགས་གླང་གིས།",
    "རེ་ཞིག་གཞན་ངོར་བརྗོད་བྱ་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཡིན་པའི་རྣམ་གཞག་མཛད་པ་ལ་འཁྲུལ་ནས།",
    "ལུང་རྣམ་དག་དེ་རང་གི་བརྗོད་བྱ་སྒྲུབ་པའི་རྟགས་ཡང་དག་དང་ལོག་ཕྱོགས་ལ་གནོད་བྱེད་ཡིན་ཏེ།",
    "ཡང་ལུང་གནོད་བྱེད་དུ་འདོད་པ་དག་གིས་ལུང་གང་ཡང་རུང་བ་གནོད་སྒྲུབ་ཏུ་ཁས་ལེན་པ་ཡང་མ་ཡིན།",
    "ཤིན་ཏུ་ལྐོག་གྱུར་སྟོན་པའི་ལུང་རྣམ་དག་རང་གི་བརྗོད་བྱ་བསྒྲུབ་པའི་རྟགས་ཡང་དག་ཏུ་ཁས་ལེན་པ་ཡིན་ནོ།",
    "ལུང་གེགས་བྱེད་དུ་འདོད་པ་རྣམས་ན་རེ།",
    "ལུང་རྣམ་དག་དེ་རང་གི་བརྗོད་བྱའི་ལོག་ཕྱོགས་ལ་གེགས་བྱེད་དང་།",
    "རང་གི་བརྗོད་བྱ་ལ་ཐེ་ཚོམ་བསྐྱེད་པ་ཡིན་གྱི།",
    "བརྗོད་བྱ་སྒྲུབ་པའི་རྟགས་ཡང་དག་དང་ལོག་ཕྱོགས་ལ་གནོད་བྱེད་མ་ཡིན་པར་ཐལ།",
    "རང་གི་བརྗོད་བྱ་དང་འབྲེལ་པ་མ་གྲུབ་ན་དེ་སྒྲུབ་མི་ནུས་ཞིང་།",
    "འབྲེལ་བ་གྲུབ་ན་རང་གི་བརྗོད་བྱ་གྲུབ་ཟིན་པའི་ཕྱིར།",
    "ལུང་རྣམ་དག་དེ་ཁས་བླངས་པ་ཙམ་གྱིས་རང་གི་བརྗོད་བྱ་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཡིན་པར་ཐལ།",
    "རང་གི་བརྗོད་བྱ་སྒྲུབ་པའི་རྟགས་ཡང་དག་གང་ཞིག།",
    "སྒྲ་མི་རྟག་པར་ཁས་བླངས་པ་ཙམ་གྱིས་སྒྲ་མི་རྟག་པར་གྲུབ་པར་ཐལ་ལོ།",
    "ལུང་དང་རང་ཚིག་གཉིས་ལ་གནོད་བྱེད་དང་གེགས་བྱེད་ཀྱི་ཁྱད་པར་མེད་པར་ཐལ་ལོ།",
    "རང་གི་བརྗོད་བྱ་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཡིན་ན།",
    "གཞན་ངོར་རང་གི་བརྗོད་བྱ་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཏུ་བསྟན་པ་ལ་དགོས་པ་ཅི་ཡོད་ཅེ་ན།",
    "དེས་ན་ལུང་གེགས་བྱེད་དུ་འདོད་པའི་དོན་ལུང་རང་གི་བརྗོད་བྱའི་ལོག་ཕྱོགས་ལ་གེགས་བྱེད་ཙམ་དུ་བཞེད་པ་ཡིན་གྱི།",
    "སེལ་བྱེད་གང་གིས་བསལ་བྱ་སེལ་བའི་ཚུལ་ལོ་། དང་པོ་ནི།",
    "ཚིག་རང་ཉིད་ཀྱིས་རང་གི་ནུས་པ་ཉམས་པར་བྱས་པ་ནི།",
    "སེལ་བྱེད་ཡིད་ཆེས་པའི་ཚིག་དེ་ལ་ལུང་གི་ཚིག་དང་རང་ཚིག་གཉིས་ཡོད་ལ།",
    "རང་གི་བསྟན་བྱའི་དོན་ལ་མི་བསླུ་བར་ཁས་རང་ལུགས་ལ།",
    "བླངས་པའི་ཚིག་གི་དོན་གི་འགལ་ཟླ་དངོས་ནི་ཡིད་ཆེས་པའི་བསལ་བ་ཡིན་ལ།",
    "རང་གི་བསྟན་བྱའི་དོན་ལ་མི་བསླུ་བར་ཁས་བླངས་པའི་ཚིག་དེ་ཡིད་ཆེས་སེལ་བ་ཡིན་ནོ།",
    "རང་ཚིག་གིས་བསལ་བ་དང་།",
    "ལུང་ཚིག་གིས་བསལ་བ་གཉིས་སོ།",
    "གཞན་གྱིས་བརྩམས་པ་ལ་མ་ལྟོས་པར་རང་གི་བསྟན་བྱའི་དོན་ལ་མི་བསླུ་བར་རང་ཉིད་ཀྱིས་ཁས་བླངས་པའི་ཚིག་ནི་རང་ཚིག་ཡིན་ནོ།",
    "གྲགས་པའི་རྗེས་དཔག་གི་བསལ་བ།",
    "གང་ལ་ཐུན་མོང་གསུམ་པ་གྲགས་པའི་རྗེས་དཔག་གིས་བསལ་བ་ལ་གསུམ་ལས།",
    "རི་བོང་ཅན་ཟླ་བའི་སྒྲས་བརྗོད་རུང་ལ་གནོད་བྱེད་མེད་མོད།",
    "རི་བོང་ཅན་ཟླ་བའི་སྒྲས་བརྗོད་རུང་ལ་སྒྲུབ་བྱེད་ཙམ་ཡོད་མོད།",
    "འོ་ན་ཡོད་པ་དེ་དེ་སྒྲུབ་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་གཏན་ཚིགས་མ་ཡིན་པར་ཐལ།",
    "འདི་ལ་ཁ་ཅིག་ན་རེ་ཡོད་པ་དེ་སྒྲུབ་ཀྱི་མཐུན་ཕྱོགས་ལ་གཏན་ནས་མེད།",
    "གྲགས་པ་མཐའ་དག་ལ་ལོག་པར་ཞུགས་པའི་གང་ཟག་གི་ངོར་མི་མཐུནཕྱོགས་ལ་ཡང་མ་མཐོང་བའི་ཕྱིར།",
    "ཡོད་པ་དེ་དེ་སྒྲུབ་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་མ་ངེས་པའི་གཏན་ཚིགས་ཡིན་ནོ་ཞེ་ན།",
    "སྒྲ་རྟག་པར་སྒྲུབ་པའི་ཐུན་མོང་མ་ཡིན་པའི་མ་ངེས་པའི་གཏནཚིགས་ཡིན་པར་ཐལ།",
    "རྒོལ་བ་འགའ་ཞིག་གི་ངོར་མི་མཐུན་ཕྱོགས་ལ་མ་མཐོང་བའི་ཕྱིར།",
    "དེས་ན་མཐུན་པའི་ཕྱོགས་ལ་འཇུག་པ་མེད་པའི་ཕྱིར་ཐུན་མོང་མ་ཡིན་པ་ཡིན་གྱི་ངེས་པ་ཉིད་ནི་མ་ཡིན་ཏེ།",
