    "གང་བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་རྣམས་ལ་ཐ་མའི་ཚེ་དང་མཐུན་པའི་ཀུན་དུ་སྦྱོར་བ་ལྔ་བསྟེན་པའི་དུས་ནི་བཅོམ་ལྡན་འདས་འདི་ལགས་ཏེ།",
    "བདེ་བར་གཤེགས་པ་འདི་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་ལས་ཐོས་ནས་དགེ་སློང་རྣམས་ཀྱིས་འཛིན་པར་འགྱུར་ལགས་སོ།",
    "ཀུན་དགའ་བོ་ལམ་གང་ཞིག་རྟོགས་པས་ཐ་མའི་ཆ་དང་མཐུན་པའི་ཀུན་དུ་སྦྱོར་བ་ལྔ་སྤོང་བར་འགྱུར་བའི་ལམ་དེ་དེས་མ་རྟོགས་པར་ཐ་མའི་ཆ་དང་མཐུན་པའི་ཀུན་དུ་སྦྱོར་བ་ལྔ་སྤོང་བར་འགྱུར་བ་གང་ཡིན་པ་འདི་ནི་གནས་མ་ཡིན་ཞིང་གོ་སྐབས་མེད་དོ།",
    "དེ་སྐད་དུ་མ་སྨྲ་ཅིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "ཀུན་དགའ་བོ་དེ་བཞིན་དུ་ལམ་གང་ཞིག་རྟོགས་པས་ཐ་མའི་ཆ་དང་མཐུན་པའི་ཀུན་དུ་སྦྱོར་བ་ལྔ་སྤོང་བར་འགྱུར་བའི་ལམ་དེ་དེས་མ་རྟོགས་པར་ཐ་མའི་ཆ་དང་མཐུན་པའི་ཀུན་དུ་སྦྱོར་བ་ལྔ་སྤོང་བར་འགྱུར་བ་འདི་ནི་གནས་མ་ཡིན་ཞིང་གོ་སྐབས་མེད་དོ།",
    "དེ་བཞིན་ནོ་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "ཀུན་དགའ་བོ་དེ་བཞིན་དུ་འདིས་ལམ་ཐོབ་པར་རྟོགས་པས་ཐ་མའི་ཆ་དང་མཐུན་པའི་ཀུན་དུ་སྦྱོར་བ་རྣམས་སྤང་བར་འགྱུར་བའི་ལམ་དེ་དེས་རྟོགས་ནས་ཐ་མའི་ཆ་དང་མཐུན་པའི་ཀུན་དུ་སྦྱོར་བ་རྣམས་སྤོང་བར་འགྱུར་བ་འདི་ནི་གནས་ཡིན་ཞིང་གོ་སྐབས་ཡོད་དོ།",
    "དེས་འདོད་པའི་འདོད་ཆགས་ཀྱི་ཕྲ་རྒྱས་དེ་དག་སྟོབས་ཀྱིས་སོ་སོར་ལེགས་པར་བཏུལ་ཏེ་ཕྲ་རྒྱས་དང་བཅས་པ་སྤོང་བར་བྱེད་དོ།",
    "འདིའི་བདེ་བའི་ཚོར་བ་ལ་འདོད་ཆགས་རྒྱས་པར་འགྱུར་རོ།",
    "འདིའི་བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་ལ་མ་རིག་པ་རྒྱས་པར་འགྱུར་རོ།",
    "སྲིད་དང་ཕྲ་རྒྱས་བདུན་གཅིག་བྱས།",
    "ཐོས་ནས་རིག་པར་བྱའོ།",
    "དྲན་པ་ད་ལྟར་འདི་ན་གནས་བརྟན་རྒྱལ་པོས་གནང་བ་རབ་ཏུ་བྱུང་ནས་རིང་དུ་ལོན་པ།",
    "དང་པོ་ཉིད་ནས་ཚངས་པར་སྤྱོད་པ་སྤྱད་པ་བསྟན་བཅོས་སྨྲ་ཞིང་རྣམ་པར་འབྱེད་ཤེས་པ།",
    "ཚངས་པར་སྤྱོད་པ་དགེ་སློང་རྣམས་ཀྱིས་ཅི་ཞིག་བྱེད་པར་འགྱུར།",
    "པོ་ཏ་ལའི་བུ་ལས་བསམས་བཞིན་བྱས་ཤིང་བསགས་ལ་ཉེ་བར་བསགས་པས་སྡུག་བསྔལ་མྱོང་བར་འགྱུར་རོ།",
    "ཀུན་དུ་རྒྱུ་པོ་ཏ་ལའི་བུ་ལྷན་ཅིག་གཏམ་གཞན་རྒྱས་པར་བརྗོད་པ་རྣམས་ཐོས་སོ།",
    "ཚེ་དང་ལྡན་པ་སྐུལ་བྱེད་ཆེན་པོ་ཚེ་དང་ལྡན་པ་དྲན་པ་ཀུན་དུ་རྒྱུ་པོ་ཏ་ལའི་བུ་དང་ལྷན་ཅིག་གཏམ་གཞན་བརྗོད་པ་འདི་ལྟར་གྱུར་པ་ཐམས་ཅད་བཟུང་སྟེ་ཡིད་ལ་བྱས་ནས།",
    "དགེ་སློང་ཀུན་དགའ་བོ་དང་སྐུལ་བྱེད་ཀྱི་བརྗོད་པར་འདོད་པ་དག་ནི་བཅོམ་ལྡན་འདས་ལས་ཐོས་པར་འགྱུར་རོ།",
    "ད་ལྟར་བདེ་བར་གཤེགས་པ་ལས་ཐོས་པར་འགྱུར་རོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་སྐུལ་བྱེད་ཆེན་པོས་ཚེ་དང་ལྡན་པ་དྲན་པ་ཀུན་དུ་རྒྱུ་པོ་ཏ་ལའི་བུ་དང་གཏམ་གཞན་བརྗོད་པ་དེ་ཐམས་ཅད་བཅོམ་ལྡན་འདས་ལ་རྒྱས་པར་གསོལ་བ་དང་།",
    "ཀུན་དགའ་བོ་དགེ་སློང་དྲན་པ་ལས་རྣམ་པར་འབྱེད་པ་ལུང་སྟོན་པ་ལ་ལྟོས།",
    "ཀུན་དུ་རྒྱུ་པོ་ཏ་ལའི་བུ་ངས་མཐོང་བ་ཡང་དག་པར་རྗེས་སུ་མི་དྲན་ན་དེ་དང་ལྷན་ཅིག་བར་སྐབས་ཀྱི་གཏམ་བརྗོད་པ་འདི་ལྟ་བུ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "ཡང་དག་པར་ལུང་བསྟན་པར་བྱས་པར་འགྱུར་ལགས།",
    "ཀུན་དགའ་བོ་དགེ་སློང་དྲན་པས་ཀུན་དུ་རྒྱུ་པོ་ཏ་ལའི་བུའི་དྲི་བ་དྲིས་པ་ལ་འདི་ལྟར་ལུང་བསྟན་ན་ཡང་དག་པར་ལུང་བསྟན་པར་འགྱུར་ཏེ།",
    "པོ་ཏ་ལའི་བུ་བསམས་བཞིན་དུ་ལས་བྱས་ཤིང་ཉེ་བར་བསགས་ན་བདེ་བ་མྱོང་བར་འགྱུར་རོ།",
    "བསམས་བཞིན་དུ་སྡུག་བསྔལ་མྱོང་བར་འགྱུར་བའི་ལས་བྱས་ཤིང་ཉེ་བར་བསགས་ན་སྡུག་བསྔལ་མྱོང་བར་འགྱུར་རོ།",
    "བསམས་བཞིན་དུ་སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་པའི་ལས་བྱས་ཤིང་ཉེ་བར་བསགས་ན་བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པ་མྱོང་བར་འགྱུར་རོ།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་ཀྱིས་ཚེ་དང་ལྡན་པ་དྲན་པའི་སེམས་ལ་ཁྱབ་སྟེ་མཁྱེན་པ་ནི་ངོ་མཚར་ལགས་སོ།",
    "ཀུན་དགའ་བོ་དེ་བཞིན་གཤེགས་པ་དེ་མཁྱེན་པ་ལ་ངོ་མཚར་ཅི་ཞིག་ཡོད།",
    "ཀུན་ཀུན་དགའ་བོ་འདི་ནི་ཁ་ཅིག་སྲོག་གཅོད་པ་དང་མ་བྲལ་བར་གྱུར་ཅིང་མ་བྱིན་པར་ལེན་པ་དང་།",
    "འདོད་པས་ལོག་པར་གཡེམ་པ་དང་།",
    "ལོག་པར་ལྟ་བས་འབགས་ཤིང་མ་བྲལ་བར་གྱུར་པ་དག་ལུས་ཞིག་སྟེ་ཤི་བའི་འོག་ཏུ་བདེ་འགྲོ་མཐོ་རིས་སུ་སྐྱེ་བར་འགྱུར་བ་ཡང་ཡོད་ལ།",
    "མ་བྱིན་པར་ལེན་པ་དང་།",
    "ཀུན་དགའ་བོ་གཞན་ཡང་འདི་ན་ཁ་ཅིག་སྲོག་གཅོད་པ་དང་བྲལ་བར་གྱུར་པ་ནས་ལོག་པར་ལྟ་བས་མ་འབགས་ཤིང་བྲལ་བའི་བར་དུ་གྱུར་ལ་ལུས་ཞིག་སྟེ་ཤི་བའི་འོག་ཏུ་བདེ་འགྲོ་མཐོ་རིས་ཀྱི་འཇིག་རྟེན་དུ་སྐྱེ་བར་འགྱུར་བ་ཡང་ཡོད་དེ།",
    "ལོག་པར་ལྟ་བས་བསགས་ཤིང་མ་བྲལ་བའི་བར་དག་བདེ་འགྲོ་མཐོ་རིས་ཀྱི་འཇིག་རྟེན་དུ་སྐྱེ་བ་དག་ཕྱི་རོལ་མུ་སྟེགས་བྱེད་ཀྱི་དགེ་སྦྱོང་ངམ།",
    "དེ་འདི་སྙམ་དུ་ལུས་ཀྱི་ཉེས་པར་སྤྱད་པ་མེད་དོ།",
    "ལུས་ཀྱི་ཉེས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་མེད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ཉེས་པར་སྤྱད་པ་མེད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ཉེས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་མེད་དོ།",
    "འདི་ལུས་ཀྱིས་སྲོག་གཅོད་པ་དང་མ་བྲལ་བ་ནས་ལོག་པར་ལྟ་བས་བསགས་ཤིང་མ་བྲལ་ལ་ལུས་ཞིག་སྟེ་ཤི་བའི་འོག་ཏུ་བདེ་འགྲོ་མཐོ་རིས་ཀྱི་འཇིག་རྟེན་དུ་སྐྱེས་པ་ངས་མཐོང་ལ།",
    "གཞན་ནི་ལོག་པའོ་ཞེས་དགེ་སྦྱོང་ངམ་བྲམ་ཟེ་དེ་དག་ཇི་ལྟར་མཐོང་བ་དང་ཇི་ལྟར་རིག་པ་སྟོབས་ཀྱིས་རྣམ་པར་དཔྱད་དེ་འདི་ཉིད་བདེན་གྱི།",
    "གཞན་ནི་གཏི་མུག་པའོ་ཞེས་རྗེས་སུ་ཐ་སྙད་འདོགས་པར་བྱེད་དོ།",
    "དེ་འདི་སྙམ་དུ་ལུས་ཀྱིས་ལེགས་པར་སྤྱད་པ་མེད་དོ།",
    "ལུས་ཀྱིས་ལེགས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་མེད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ལེགས་པར་སྤྱད་པ་མེད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ལེགས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་མེད་དོ།",
    "གཞན་ནི་ལོག་པའོ་ཞེས་དགེ་སྦྱོང་ངམ་བྲམ་ཟེ་དེ་དག་ཇི་ལྟར་མཐོང་བ་དང་ཇི་ལྟར་རིག་པ་སྟོབས་ཀྱིས་རྣམ་པར་དཔྱད་དེ་འདི་ཉིད་བདེན་གྱི་གཞན་ནི་གཏི་མུག་པའོ་ཞེས་རྗེས་སུ་ཐ་སྙད་འདོགས་པར་བྱེད་དོ།",
    "ལུས་ཀྱིས་ཉེས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་ཡོད་དོ།",
    "ངག་དང་ཡིད་ཀྱི་ཉེས་པར་སྤྱད་པ་ཡོད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ཉེས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་ཡོད་དོ།",
    "གཞན་ནི་ལོག་པའོ་ཞེས་དགེ་སྦྱོང་ངམ་བྲམ་ཟེ་དེ་དག་ཇི་ལྟར་མཐོང་བ་དང་ཇི་ལྟར་རིག་པའི་སྟོབས་ཀྱིས་རྣམ་པར་དཔྱད་དེ།",
    "འདི་ཉིད་བདེན་གྱི་གཞན་ནི་གཏི་མུག་པའོ་ཞེས་རྗེས་སུ་ཐ་སྙད་འདོགས་པར་བྱེད་དོ།",
    "ཀུན་དགའ་བོ་དེ་ལ་སྲོག་གཅོད་པ་དང་བྲལ་བར་གྱུར་པ་ནས་ལོག་པར་ལྟ་བས་མ་འབགས་ཤིང་བྲལ་བར་གྱུར་པ་དག་ལུས་ཞིག་སྟེ་ཤི་བའི་འོག་ཏུ་བདེ་འགྲོ་མཐོ་རིས་ཀྱི་འཇིག་རྟེན་དུ་སྐྱེས་པར་གྱུར་པ་དག་ཕྱི་རོལ་མུ་སྟེགས་བྱེད་ཀྱི་དགེ་སྦྱོང་ངམ་བྲམ་ཟེ་ལྷའི་མིག་དང་གཞན་གྱི་སེམས་རིག་པས་མཐོང་ནས།",
    "དེ་འདི་སྙམ་དུ་ལུས་ཀྱིས་ལེགས་པར་སྤྱད་པ་ཡོད་དོ།",
    "ལུས་ཀྱིས་ལེགས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་ཡོད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ལེགས་པར་སྤྱད་པ་ཡོད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ལེགས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་ཡོད་དོ།",
    "ཇི་ལྟར་རིག་པའི་སྟོབས་ཀྱིས་རྣམ་པར་དཔྱད་དེ་འདི་ཉིད་བདེན་གྱི་གཞན་ནི་གཏི་མུག་པའོ་ཞེས་རྗེས་སུ་ཐ་སྙད་འདོགས་པར་བྱེད་དོ།",
    "ཀུན་དགའ་བོ་དེ་ལ་དགེ་སྦྱོང་ངམ་བྲམ་ཟེ་གང་ཞིག་ལུས་ཀྱི་ཉེས་པར་སྤྱད་པ་མེད་དོ།",
    "ལུས་ཀྱིས་ཉེས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་མེད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ཉེས་པར་སྤྱད་པ་མེད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ཉེས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་མེད་དོ་ཞེས་འདི་ལྟར་ལྟ་ཞིང་འདི་སྐད་དུ་སྨྲ་བ་དེ་དག་ངས་རྗེས་སུ་མ་གནང་ངོ།",
    "ལོག་པར་ལྟ་བས་འབགས་ཤིང་མ་བྲལ་བར་གྱུར་ཀྱང་བདེ་འགྲོ་མཐོ་རིས་ཀྱི་འཇིག་རྟེན་དུ་སྐྱེ་བར་འགྱུར་ཞེས་ཟེར་བ་འདི་ཡང་ངས་རྗེས་སུ་མ་གནང་ངོ།",
    "གཞན་ནི་ལོག་པའི་ཤེས་པའོ་ཞེས་ཟེར་བ་དེ་ཡང་ངས་རྗེས་སུ་མ་གནང་ངོ།",
    "བྲམ་ཟེ་དེ་དག་ཇི་ལྟར་མཐོང་བ་དང་ཇི་ལྟར་རིག་པའི་སྟོབས་ཀྱིས་རྣམ་པར་དཔྱད་ནས་འདི་ཉིད་བདེན་གྱི།",
    "གཞན་ནི་གཏི་མུག་པའོ་ཞེས་རྗེས་སུ་ཐ་སྙད་འདོགས་པར་བྱེད་པ་འདི་ཡང་ངས་རྗེས་སུ་མ་གནང་ངོ།",
    "བྲམ་ཟེ་གཞན་ཞིག་ལུས་ཀྱིས་ལེགས་པར་སྤྱད་པ་མེད་དོ།",
    "ལུས་ཀྱིས་ལེགས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་མེད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ལེགས་པར་སྤྱད་པ་མེད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ལེགས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་མེད་དོ་ཞེས་འདི་ལྟར་ལྟ་ཞིང་འདི་སྐད་དུ་སྨྲ་བ་འདི་ཡང་ངས་རྗེས་སུ་མ་གནང་ངོ།",
    "གང་ཡང་འདི་སྐད་དུ་གང་འདི་ལྟར་མཐོང་བ་ནི་ཡང་དག་པར་མཐོང་བ་སྟེ།",
    "གཞན་ནི་ལོག་པའི་ཤེས་པའོ་ཞེས་ཟེར་བ་འདི་ཡང་ངས་རྗེས་སུ་མ་གནང་ངོ།",
    "གང་ཡང་དགེ་སྦྱོང་ངམ་བྲམ་ཟེ་དེ་དག་ཇི་ལྟར་མཐོང་བ་དང་ཇི་ལྟར་རིག་པ་དང་སྟོབས་ཀྱིས་རྣམ་པར་དཔྱད་ན་འདི་ཉིད་བདེན་གྱི།",
    "གཞན་ནི་གཏི་མུག་པའོ་ཞེས་རྗེས་སུ་ཐ་སྙད་འདོགས་པར་བྱེད་པ་འདི་ཡང་ངས་རྗེས་སུ་མ་གནང་སྟེ།",
    "ཀུན་དགའ་བོ་དེ་ལ་དགེ་སྦྱོང་ངམ་བྲམ་ཟེ་དེ་དག་གོ་ལུས་ཀྱིས་ཉེས་པར་སྤྱད་པ་མེད་དོ།",
    "ལུས་ཀྱིས་ཉེས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་མེད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ཉེས་པར་སྤྱད་པ་མེད་དོ།",
    "ངག་དང་ཡིད་ཀྱིས་ཉེས་པར་སྤྱད་པའི་རྣམ་པར་སྨིན་པ་མེད་དོ་ཞེས་འདི་ལྟར་ལྟ་ཞིང་འདི་སྐད་སྨྲ་བ་དེ་ཡང་ངས་རྗེས་སུ་མ་གནང་ངོ།",
    "གང་ཡང་འདི་སྐད་དུ་འདི་ལྟར་མཐོང་བ་དེ་ནི་ཡང་དག་པར་མཐོང་བ་སྟེ།",
    "གཞན་ནི་ལོག་པའི་ཤེས་པའོ་ཞེས་ཟེར་བ་འདི་ཡང་ངས་རྗེས་སུ་མ་གནང་ངོ།",
    "གང་ཡང་དགེ་སྦྱོང་ངམ་བྲམ་ཟེ་དེ་དག་ཇི་ལྟར་མཐོང་བ་དང་ཇི་ལྟར་རིག་པའི་སྟོབས་ཀྱིས་རྣམ་པར་དཔྱད་དེ།",
