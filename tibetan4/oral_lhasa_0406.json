    "ལྡན་པའི་སྒོ་ནས་ཡོད་པར་སྦྱར་གྱི་ང་ཡིར་འཛིན་པ་མེད་པའི་ཕྱིར་དང་།",
    "ཇི་ལྟར་འདི་དག་མི་ཚངས་པར་སྤྱོད་པ་ཡིན་ཞེ་ན།",
    "ཅི་སྟེ་བགྲོད་པར་བྱ་བ་མ་ཡིན་པ་ཞིག་ཡིན་ན་ནི་སྒྲིབ་པར་མི་བྱེད་པས་ནི་དེ་དག་དེ་ལ་ཉལ་པོ་མི་བྱེད་དོ།",
    "གལ་ཏེ་ཡང་ལྷས་ལྷ་མི་གསོད་ཀྱང་འགྲོ་བ་གཞན་ན་གནས་ན་ནི་གསོད་པར་བྱེད་དོ།",
    "གཟུགས་མེད་པར་སྐྱེས་པའི་འཕགས་པ་རྣམས་ལ་ཟག་པ་མེད་པའི་སྡོམ་པ་འདས་པ་དང་མ་འོངས་པ་དག་དང་ལྡན་པའི་ཕྱིར་དང་།",
    "ལྷག་པར་བྱས་ན་མངོན་དུ་གྱུར་པའི་སྒོ་ནས་ཀྱང་།",
    "ལྷག་མར་བྱས་པས་ན་ལྷག་བྱས་ཏེ་ལྷག་མར་བྱས་པས་ནི་ཁམས་སམ་འགྲོ་བ་གཞན་གང་ཡིན་པའོ།",
    "རྣམ་སྨིན་འབྲས་བུ་འབྱིན་པར་འདོད།",
    "བརྒྱ་ལ་འདི་ལྟ་བུར་མི་རྣམས་དང་སྐལ་བ་མཉམ་པར་འོངས་ན་ཡང་སྲོག་གཅོད་པས་ནི་ཚེ་ཐུང་བར་འགྱུར་རོ།",
    "མ་བྱིན་པར་ལེན་པས་ནི་ལོངས་སྤྱོད་ཀྱིས་ཕོངས་པར་འགྱུར་རོ།",
    "འདོད་པས་ལོག་པར་གཡེམ་པས་ནི་དགྲ་དང་བཅས་པའི་ཆུང་མ་ཅན་དུ་འགྱུར་རོ།",
    "ཕྲ་མས་ནི་དེ་མཛའ་བོ་དང་འབྱེད་པར་འགྱུར་རོ།",
    "ཚིག་རྩུབ་པོས་ནི་ཡིད་དུ་མི་འོང་བའི་སྒྲ་ཐོས་པར་འགྱུར་རོ།",
    "ཚིག་ཀྱལ་པས་ནི་ཚིག་གཟུང་བར་མི་འོས་པར་འགྱུར་རོ།",
    "ལོག་པར་ལྟ་བས་ནི་གཏི་མུག་ཤས་ཆེ་བར་འགྱུར་ཏེ།",
    "དེས་ཚེ་ཐུང་ངུར་འགྱུར་བས་དེའི་ཕྱིར་སྲོག་གཅོད་པ་ནི་ཚེ་དེའི་བར་ཆད་བྱེད་པའི་ཕྱིར་རྒྱུ་ཡིན་པར་རིག་པར་བྱའོ།",
    "མ་བྱིན་པར་ལེན་པས་ནི་སེར་བ་དང་ཆར་བ་མང་བར་འགྱུར་རོ།",
    "འདོད་པས་ལོག་པར་གཡེམ་པས་ནི་རྡུལ་གྱིས་འཁྲིག་པར་འགྱུར་རོ།",
    "ལོག་པར་ལྟ་བས་ནི་འབྲས་བུ་ཆུང་ངུའམ་འབྲས་བུ་མེད་པར་འགྱུར་ཏེ།",
    "འཁོར་དང་བཅས་པ་སྨོས་པའི་ཕྱིར་སྲོག་གཅོད་པས་ཞེས་གསུངས་པར་ཟད་དོ་ཞེས་ཟེར་རོ།",
    "གསད་པ་དང་གཟི་བྱིན་མེད་པར་བྱ་བས་ཡིན་ཏེ།",
    "གོམས་པར་བྱས་པ་དང་།",
    "བརྒྱ་ལ་འདི་ལྟ་བུར་མི་རྣམས་དང་སྐལ་བ་མཉམ་པར་འོངས་ན་ཡང་ཚེ་རིང་པོར་འགྱུར་ཏེ།",
    "ལོག་པའི་འཚོ་བ་ཞེས་གང་གསུངས་པ་དེ་གཉིས་ལས་གཞན་པའི་ལོག་པའི་འཚོ་བ་གང་ཞིག་ཡིན་ཞེ་ན།",
    "དེའི་ཕྱིར་ཇི་སྲིད་འཚོའི་བར་དུ་སྦྱང་དཀའ་བས་བསྒྲིམ་པར་བྱ་བའི་ཕྱིར་དེ་ནི་དེར་ལོགས་ཤིག་ཏུ་བསྟན་ཏོ།",
    "བདག་དགའ་བར་བྱ་བའི་ཆེད་དུ་གར་དང་གླུ་ལེན་པ་ལ་སོགས་པ་ནི་ལོག་པའི་འཚོ་བ་ཡིན་པར་མི་རིགས་སོ་སྙམ་དུ་སེམས་པ་དེ་ནི།",
    "རྣམ་པར་སྨིན་པའི་འབྲས་བུ་མ་གཏོགས་སོ།",
    "རྣམ་པར་སྨིན་པ་དང་བྲལ་བའི་འབྲས་བུ་དག་མ་གཏོགས་སོ།",
    "རྣམ་པར་སྨིན་པའི་འབྲས་བུ་མ་གཏོགས་སོ།",
    "རྣམ་པར་སྨིན་པ་དང་བྲལ་བའི་འབྲས་བུ་མ་གཏོགས་སོ།",
    "བྲལ་བ་དང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་མ་གཏོགས་སོ།",
    "རྣམ་པར་སྨིན་པ་དང་བྲལ་བའི་འབྲས་བུ་དག་མ་གཏོགས་སོ།",
    "རྣམ་པར་སྨིན་པ་དང་བྲལ་བའི་འབྲས་བུ་དག་མ་གཏོགས་སོ།",
    "རྣམ་པར་སྨིན་པ་དང་བྲལ་བའི་འབྲས་བུ་དག་མ་གཏོགས་སོ།",
    "རྣམ་པར་སྨིན་པ་དང་བྲལ་བའི་འབྲས་བུ་དག་མ་གཏོགས་སོ།",
    "སྤང་པར་བྱ་བ་མ་ཡིན་པ་ནི་གཅིག་སྟེ།",
    "རྣམ་པར་སྨིན་པའི་འབྲས་བུ་མ་གཏོགས་སོ།",
    "ཡང་གོ་རིམ་བཞིན་ཞེས་སྨོས་པ་ནི་དབུས་སུ་ཡང་ཐོག་མ་དང་ཐ་མ་བཞིན་ཤེས་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "རིགས་པས་བསྐྱེད་པ་ཡང་མ་ཡིན་རིགས་པ་མ་ཡིན་པས་བསྐྱེད་པ་ཡང་མ་ཡིན་པའི་ལས་ཞེས་གསུངས་པ་དེའི་མཚན་ཉིད་ཅི་ཞེ་ན།",
    "གནས་པར་བྱ་བ་དང་།",
    "འོ་ན་གནས་བརྟན་མ་འགགས་པས་བདག་ནི་བསོད་སྙོམས་གཅིག་པོ་དེའི་རྣམ་པར་སྨིན་པས་ལན་བདུན་གྱི་བར་དུ་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་ནང་དུ་སྐྱེས་པ་ནས་ད་ལྟར་ཤཱཀྱ་ཕྱུག་པོའི་རིགས་སུ་སྐྱེས་པའི་བར་དུ་ཡིན་ནོ་ཞེས་གང་སྨྲས་པ་དེ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "ལས་འབའ་ཞིག་ཚེ་འཕེན་པར་བྱེད་པ་ཡང་མ་ཡིན་ཏེ།",
    "འོ་ན་ཇི་ལྟ་བུ་ཞེ་ན་རྣམ་པར་སྨིན་པ་དང་བཅས་པ་གཞན་ཡང་ཡིན་ནོ།",
    "སེམས་མེད་སྙོམས་པར་འཇུག་པ་དང་།",
    "རྣམ་པར་སྨིན་པའི་སྒྲིབ་པ་དང་།",
    "སྲིད་པ་བརྒྱད་པར་ངེས་པར་འགྱུར་བའི་ལས་གཞན་དང་གཞན་དག་ཀྱང་བརྗོད་པར་བྱ་བར་འགྱུར་རོ་ཞེ་ན།",
    "ཡང་སྒྲིབ་པ་འདི་དག་ལས་གང་ཞིག་ཁམས་གང་ན་ཡོད་པར་རིག་པར་བྱ་ཞེ་ན།",
    "མིའི་ཡང་ཕ་མ་མི་མ་ཡིན་པ་བསད་ན་མཚམས་མེད་པར་མི་འགྱུར་རོ།",
    "མ་བསྒྲིབས་ལ་ལུང་དུ་མ་བསྟན་པ་ཡིན་ན་དེ་ཇི་ལྟར་མཚམས་མེད་པར་འགྱུར།",
    "རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་དག་ཡིན་ནོ།",
    "བསྐལ་པར་མནར་མེད་པར་སྨིན་འགྱུར།",
    "གཞན་གྱིས་ནི་མནར་མེད་པར་མ་ངེས་སོ།",
    "ལྷག་པས་གནོད་པ་ལྷག་པར་འགྱུར།",
    "གནོད་པ་ཡང་རབ་ཏུ་མང་བ་དང་ཤིན་ཏུ་མི་བཟད་པར་འགྱུར་རོ།",
    "གང་ན་བཅོམ་ལྡན་འདས་མངོན་སུམ་དུ་བཞུགས་པ་དེ་ལས།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ནི་བཟོད་པར་དཀའ་བའི་ཕྱིར་དང་།",
    "བཀའ་སྩལ་བའི་ཕྱིར་སྟོན་པ་མངོན་སུམ་དུ་བཞུགས་པ་ཉིད་དུ་དབྱེ་བར་མི་ནུས་སོ།",
    "བར་དུ་ཡང་སྐྱོན་མ་བྱུང་བའི་སྔོན་རོལ་དུ་འབྱེད་པར་མི་འགྱུར་ཏེ།",
    "དེས་ཕྱིར་སྡུམ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཇི་སྲིད་དུ་མཚམས་མ་བཅད་པར་མི་འབྱུང་སྟེ།",
    "སྤངས་དང་མེད་པར་བྱས་ཕྱིར་རོ།",
    "དེ་ནི་ནུ་ཞོ་ལྡུད་པར་བྱེད་པ་དང་།",
    "སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་མ་ལ་སྦྱོར་བ་བྱས་ནས་གཞན་བསད་ན་ཡང་མཚམས་མེད་པར་མི་འགྱུར་ལ་མ་མ་ཡིན་པ་ལ་སྦྱོར་བ་བྱས་ནས་མ་བསད་ན་ཡང་མཚམས་མེད་པར་འགྱུར་ཏེ།",
    "ཁྲུས་པའི་བུས་སྦྲང་བུ་ལ་སྦྱོར་བ་བྱས་པས་ཕ་བསད་པ་དཔེར་བྱའོ།",
    "རྣམ་པར་རིག་བྱེད་ནི་མཚམས་མེད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "དགྲ་བཅོམ་པ་མ་ཡིན་པའི་འདུ་ཤེས་ཀྱིས་དགྲ་བཅོམ་པ་བསད་ན་ཡང་མཚམས་མེད་པར་འགྱུར་ཏེ།",
    "འདི་གསད་དོ་སྙམ་དུ་རྟེན་ངེས་པར་བཟུང་བའི་ཕྱིར་རོ།",
    "རྒྱུ་གཉིས་ཀྱིས་ཞེས་བརྗོད་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་ངན་སེམས་ཀྱིས་ཁྲག་ཕྱུང་བས་གདོན་མི་ཟ་བར་མཚམས་མེད་པར་འགྱུར་རམ་ཞེ་ན།",
    "བགྲོད་པར་སེམས་པ་ལ་ནི་འགྱུར་གྱི།",
    "གལ་ཏེ་དགྲ་མ་ཆོམས་པའི་ཚེ་བསྣུན་ལ་བསྣུན་པའི་འོག་ཏུ་དགྲ་བཅོམ་པར་གྱུར་ན།",
    "མཚམས་མེད་པར་འགྱུར་བ་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "དེས་ནི་དེ་ལ་སྦྱོར་བ་མ་བྱས་སོ།",
    "ཅི་མཚམས་མེད་པའི་སྦྱོར་བ་བྱས་ཏེ།",
    "དེ་ཡང་མ་བཟློག་པར་འདོད་ཆགས་དང་བྲལ་བའི་འབྲས་བུ་འཐོབ་པར་འགྱུར་ཞེ་ན།",
    "མཚམས་མེད་སྦྱོར་བ་བྱས་པ་ལ།",
    "ལས་ཀྱི་ལམ་གཞན་གྱི་སྦྱོར་བ་བྱས་ནས་འཕགས་པའི་ལམ་སྐྱེས་པ་ལ་ནི་ཡང་ལས་ཀྱི་ལམ་མི་སྐྱེ་སྟེ།",
    "འཇིག་རྟེན་རྣམས་ཀྱི་མཐོ་རིས་དང་བྱང་གྲོལ་གྱི་ལམ་གྱི་བར་དུ་གཅོད་པར་བྱེད་པའི་ཕྱིར་ཏེ།",
    "ཟག་པ་ཟད་པར་བྱ་བ་རྣམས་ལ་བགེགས་སུ་གྱུར་པ་ཡིན་ཞིང་།",
    "དྲན་པ་ཉམས་པར་འགྱུར་ལ།",
    "འདི་ལྟར་འདིའི་རྣམ་པར་སྨིན་པ་ཡང་བསྐལ་པ་གཅིག་ཏུ་མནར་མེད་པར་སྐྱེ་བ་ཡིན་ནོ།",
    "འོ་ན་བཅོམ་ལྡན་འདས་ཀྱིས་ཉེས་པ་གསུམ་གྱི་ནང་ན་ཡིད་ཀྱི་ཉེས་པ་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པ་ཆེན་པོར་གསུངས་པ་དང་།",
    "ཡང་ལོག་པར་ལྟ་བ་ནི་ཁ་ན་མ་ཐོ་བ་དམ་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "ལས་གསུམ་ངེས་པར་མཛད་ནས་ནི་ཡིད་ཀྱི་ཉེས་པ་གསུངས།",
    "ལྟ་བ་རྣམས་ངེས་པར་མཛད་ནས་ནི་ལོག་པར་ལྟ་བ་གསུངས་པའམ།",
    "ཡང་ན་རྣམ་པར་སྨིན་པ་རྒྱ་ཆེ་བ་དང་།",
    "ལེགས་པར་སྤྱད་པ་རྣམས་ལས་འབྲས་བུ་རབ་ཏུ་ཆེ་བ་གང་ཡིན་ཞེ་ན།",
    "དེའི་རྣམ་པར་སྨིན་པ་ནི་བསྐལ་པ་བརྒྱད་ཁྲིར་རབ་ཏུ་ཞི་བ་ཡིན་ནོ།",
    "མ་དགྲ་བཅོམ་མ་སུན་བྱས་དང་།",
    "གལ་ཏེ་མི་ཚངས་པར་སྤྱོད་པས་མ་དགྲ་བཅོམ་པ་སུན་པར་བྱེད་པ་དང་།",
    "མཆོད་རྟེན་འཇིག་པར་བྱེད་པའོ།",
    "རྣམ་པར་སྨིན་པ་དང་བཅས་པའི་ལས་གཞན་ཡང་དུས་གསུམ་པོ་དག་ཏུ་ཤིན་ཏུ་བགེགས་བྱེད་དེ།",
    "སྐྱེ་བ་ཐམས་ཅད་དུ་ཡང་ཚེ་རབས་དྲན་པར་འགྱུར་རོ།",
    "ལོག་པར་སྒྲུབ་པ་ཐམས་ཅད་ཀྱིས་སྐྱོ་བ་མེད་པའི་ཕྱིར་རོ།",
    "ལུས་པ་དག་ཏུ་འཕེན་པར་བྱེད།",
    "གཉིས་པ་ལ་ནི་བདུན་ཁྲི་དྲུག་སྟོང་ལ་བསྙེན་བཀུར་བྱས་སོ།",
    "གསུམ་པ་ལ་ནི་བདུན་ཁྲི་བདུན་སྟོང་ལ་བསྙེན་བཀུར་བྱས་སོ།",
    "སྦྱིན་པར་བྱེད་པས་སྦྱིན་པ་རྫོགས།",
    "རི་དང་ནགས་སུ་བཅས་པའི་ས་སྟེང་རྒྱས་པར་ཀུན་ཏུ་ཡུལ་གཅིག་ག་ལ་ཡོད།",
    "དེ་ནི་འདིར་མི་འདོད་པས་དེའི་ཕྱིར་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར།",
    "སོ་སོའི་སྐྱེ་བོ་འདོད་ཆགས་དང་མ་བྲལ་བས་མཆོད་རྟེན་ལ་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་གང་ཡིན་པ་དེས་ཕ་རོལ་པོ་དག་ལ་ཕན་འདོགས་པ་མེད་པའི་ཕྱིར་དེའི་བདག་ཉིད་ཁོ་ནའི་དོན་གྱི་ཕྱིར་སྦྱིན་པ་ཡིན་ནོ།",
    "དེའི་རྣམ་པར་སྨིན་པའི་ས་ལས་ཤིན་ཏུ་ཡང་དག་པར་འདས་པའི་ཕྱིར་རོ།",
    "དེའི་ཁྱད་པར་སྦྱིན་བདག་དང་།",
    "གུས་པ་ལ་སོགས་པས་སྦྱིན་པར་བྱེད།",
    "གཞན་ལ་མི་གནོད་པར་སྦྱིན་པར་བྱེད་དེ།",
    "དུས་དང་བར་ཆད་མེད་པར་རྙེད།"
  ]
}