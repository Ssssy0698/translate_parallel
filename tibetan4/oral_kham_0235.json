    "གཉིས་ན་ཁོ་རང་སྒང་འབུར་དེར་དགའ་བ་དེ་ཙམ་ཞིག་ཡོད་པ་ཅི་ཡིན་སྙམ་ནས་སྔར་བས་ཀྱང་ངོ་མཚར་བར་གྱུར།",
    "ཁོས་ཚེ་རིང་སྒྲོན་གྱི་འབོད་སྒྲ་ཐོས་ཀྱིན་པའི་བརྡ་ལ་ཚུར་ལག་པས་གཡུག་གཡུག་བྱེད་ཀྱིན་འདུག་ཚེ་རིང་སྒྲོན་ལ་འུར་ལངས།",
    "རི་སྒང་ནས་ཨོང་བ་སྒུམ་ནས་རང་ཉིད་ལ་རོགས་བྱེད་བསམ་པ་ནི་མིན་འགྲོ།",
    "མགྲོན་པོ་དེ་ནི་ངའི་སྲུང་མ་གོ་ཚོད་ཅིག་ལྟ་བུར་བརྩི་འདུག་སྙམ།",
    "གདོང་དཀར་པོའི་ངོས་སུ་སྔོན་ཆད་མེད་པའི་སྐྱོ་ཉམས་ཤིག་ཤར་འདུག་པ་ཚེ་རིང་སྒྲོན་ལ་ལྷག་ཏུ་གསལ།",
    "མགྲོན་པོ་གདོང་དཀར་པོ་ཅན་གྱིས་ཞོགས་ཟས་ཟ་སྐབས་ཆེད་དུ་གྲ་སྒྲིག་བྱས་ཡོད་པའི་ཟན་ཆང་དེ་ཁྱི་དོམ་ནག་འཕངས་ནས་བཀའ་དྲིན་ཞུ་བཞིན་འདུགའདི་ནི་མི་ལ་ལག་འབྲེལ་དང་བྲང་གླན་པའི་ཚབ་ཡིན་ངེས།",
    "བདེ་ཆེན་གྲོང་རྡལ་གྱི་མཐའ་སྐོར་ནས་སྲང་ལམ་གྱི་བར་དུ་ཁྱི་ཡིས་གང་འདུག་པས།",
    "སེང་ཆེན་དང་སྟག་དམར་གཉིས་ཀྱིས་ད་དུང་རྐུན་མ་བྲོས་པའི་ཕྱོགས་སུ་མིག་ཟུང་གློག་འོད་འཁྱུག་པ་བཞིན་བལྟས་ནས་ངེད་གཉིས་ཀྱི་སྐེའི་ལྕགས་ཐག་དཀྲོལ་དང་རྐུན་མ་གཉིས་གཙབ་ཤ་བྱས་ནས་དྲུད་འོངས་ཞེས་ཁས་ལེན་ཁག་ཐེག་བྱེད་པ་ལྟ་བུའི་དཔའ་གདེངས་ལྡན་པའི་ཚུལ་དུ་གདའ།",
    "དོ་ནུབ་ཁོ་རང་ཁང་གོག་དེའི་ནང་དུ་གཅིག་པུར་ཉལ་ནས་ཡོད།",
    "གནམ་སྟོང་ནམ་ཡིན་ན་དགོན་མཐའི་ལོ་ལོན་མང་པོ་ཞིག་སྨྱུང་གནས་ལ་འདུག་ངེས།",
    "འཁང་ཙི་སོགས་སྒྲོག་བཞིན་ཁོམ་ལོངས་མེད་པར་གདའ།",
    "གདའ་ལུ།",
    "ཝ་མཆུ་དང་དང་ཁ་ཁྱེར་དག་ནས་ཆུ་ཡི་ཐིག་པ་ཤར་ཤར་དུ་འཛགས་ཀྱིན་འདུག་སྲང་བར་གྱི་འཁོར་རིགས་དག་བགྲོད་པའི་འཁོར་ལོའི་འོག་ནས་ཆུ་ཡི་ཆལ་སྒྲ་ཆབ་ཆབ་ངང་གྲགས་པ་སོགས་ཀྱིས་ད་ལྟ་གྲོང་རྡལ་འདི་རློན་ཆབ་ཆབ་ཏུ་བཏང་།",
    "ཁོས་ང་ལ་ང་མྱི་རང་འདུག་རང་ལ་འདུག་ཏུ་ཆུགས།",
    "མིག་ཟུང་བཙུམ་པའི་སྐད་ཅིག་མ་དེར་ང་རང་ཤིན་ཏུ་རབ་ཏུ་སྐྱིད།",
    "ཁོ་བོའི་གདོང་ནི་དྲག་ཆར་འབབ་ཁ་མའི་དབྱར་ཁའི་སྤྲིན་ནག་ལྟར་འཁྲིགས་ནས་འདུག་ལ།",
    "དྲིན་ཆེན་ཕ་མ་གཉིས་ཀྱིས་ང་རང་ཕྱུག་པོ་ཚང་ཞིག་ལ་གནས་སུ་ཕྱིན་ཐུབ་རྒྱུའི་ཆེད་དུ་སེམས་ཁུར་ཅི་འདྲའི་མང་པོ་ཞིག་བྱས་ནས་དོན་དག་དེ་འགྲུབ་པ་ཡིན་པ་སུས་ཤེས།",
    "ཐག་རིང་ཞིག་ནས་འོང་བ་ལོས་ཡིན་འདོད་པའི་སྐྱེས་པ་ཆ་མེད་གཉིས་ལྷས་འདབས་སུ་ཐོན།",
    "ང་རང་མ་ཁྱིམ་གྱི་སྨད་ཕྱོགས་སུ་ཉལ།",
    "ང་རང་གནས་ཡུལ་མ་ཟིན་པར་ཕྱིར་ལོག་པའི་སྟེང་དུ་འདྲེ་གནས་མ།",
    "ཁོ་རང་ས་གནས་འདི་ནས་མིན་ནའང་བོད་པ་དངོས་ཤིག་ཡིན་ལ།",
    "ད་ལྟ་ང་ལ་འཇིག་རྟེན་འདིར་ལྷག་པའི་གཉེན་གྱི་གཙོ་བོར་གྱུར་བའི་ཨ་ཞང་གཅིག་པུས་རང་ལ་འདི་འདྲའི་སེམས་ཁུར་བྱས་པས་ན་ཁ་གཅོག་མ་ཐུབ་པ་དང་།",
    "ཉིན་སྔོན་མ་གཉིས་ཀར་ཁོས་ང་རང་ས་དེར་བསྐྱལ་ནས་ཨོང་བ་སྒུམ་དུ་བཅུག་ཅིང་།",
    "དེ་རིང་ངའི་བཟའ་ཟླ་ཤིན་ཏུ་ལྟོགས་འདུག་སྟེ།",
    "ངས་ཁོ་རང་དེ་ལྟར་བཀྲེས་ལྟོགས་དང་གཉིད་བཅག་ཆེན་པོ་ཞིག་ཅིའི་ཕྱིར་བྱས་པ་ཡིན་པར་དོགས་པའི་རྒྱ་རུ་ཚུད།",
    "འདི་ནི་འབྲོག་ས་དང་ཡེ་ནས་འདྲ་མི་འདུགཐ་ན་ཁྱིམ་མཚེས་ཀྱི་གད་སྙིགས་སྤུངས་མཁན་ཚང་དང་།",
    "མྱི་དྭངས་ཤོག་དང་ཇ་ཁང་དུ་འདུག་འཇིག་རྟེན་གཏམ་དཔེར།",
    "རིག་འཛིན་གྱིས་མགྲོན་བརྒྱབ་པའི་གསར་བུ་ཚོས་ཤ་ཆང་དུད་གསུམ་ལ་བག་མེད་དུ་རོལ་གྱིན་གདོང་ལ་འཛུམ་མདངས་ཀྱི་མེ་ཏོག་རང་བཞིན་གྱིས་གྲོལ་འདུག་པ་མིན་ནམ།",
    "མིག་ཟུང་དལ་གྱིས་འབྱེད་བཙུམ་གྱི་སྒོ་ནས་རྩམ་ཁུ་ཡུན་གྱིས་ལྡག་ཚུལ་ལ་བལྟས་ན་འདུལ་འཛིན་པའི་གྲྭ་བ་ཞིག་ལྟར་ཧ་ཅང་ལྷོད་པོར་འདུག་པས་ན།",
    "ཁོ་གཉིས་ཀ་ལྷ་ས་རུ་ཐོན་འདུག་པར་ཐོས་ལ།",
    "ཡིན་ནའང་ད་ནི་ཁོ་ལ་ལུས་སེམས་གཉིས་ཆ་ན་སྟོབས་ཤུགས་ཆེན་པོ་མི་འདུག་སྟེ།",
    "བྱི་ལ་དམར་ཆུང་དང་མཉམ་དུ་རྒ་བའི་ཁུར་གྱིས་ནོན་ནས་འཇིག་རྟེན་ཕྱི་མའི་ལམ་བུ་ལ་བར་ཐག་རིང་བོ་མི་འདུག་པའི་ཚད་དུ་གདའ།",
    "རྫི་གཡག་རོག་ར་གང་ཞིག་ཏུ་འདྲོགས་ཚར་ནས་ཤུལ་རྗེས་ཙམ་ཡང་མི་འདུག་ལ།",
    "ཟེར་བ་ལོས་ཡིན་སྙམ་པ་ལྟ་བུ་བྱུང་སྟེ་ཞག་གང་བོར་སྣང་བ་རྣམ་རྟོག་ཡར་འཆར་མར་འཆར་དགུ་དྲན་དགུ་སྐོར་བྱས་ནས་གཉིད་མ་ཁུག་དེ་བས།",
    "ཡིན་ནའང་ཁོ་རང་བྱིས་དུས་དང་གསར་བུའི་སྐབས་ཀྱི་ལོ་ཁ་ཤས་ཕུད་མི་ཚེའི་དུས་ཚོད་མང་ཕྱོགས་སུ་ལབ་ལོབ་ཅི་ཡང་མཐོང་མ་མྱོང་བར་མི་ལོ་ཉི་ཤུ་འགོར་བས།",
    "ད་ལྟ་ངེད་གཉིས་འདིར་ལྷོད་ལྷོད་ཀྱིས་བསྡད་ཡོད་པ་ལས་ཕྱིའི་འཇིག་རྟེན་ནི་དངོས་གནས་ཁོམ་ལོང་ཞིག་ཡོད་ཀྱི་མི་འདུག་ཅེས་མདུན་ཐད་དུ་བསྡད་དེ་སྒེའུ་ཁུང་ལས་ཁོ་ལྟར་ཕྱི་ལ་བལྟ་བཞིན་པའི་རྡོ་རྗེའི་རྣ་བར་འཕངས།",
    "རྡོ་རྗེས་གོང་ནས་ཚེ་རིག་ལ་ཡང་གང་ཞིག་ལ་མ་ཁོམ་པར་འདུར་གྱིན་ཡོད་ཟེར་བར་ཁག་མི་འདུག་སྟེ།",
    "དཔེ་ཀློག་དང་དྲ་འཇུག་ཁོ་ནས་ཀྱང་མི་འོང་བར་འགྲོ་ས་འདུག་ས་ཚང་མ་ནས་བློ་རིག་སྒྲིམ་ཏེ་མཉམ་འཇོག་དགོས་པའི་བསམ་བློ་དང་སྤྱོད་པ་ཞིག་ཆགས་དགོས་པར་འདོད་ཀྱིན་ཡོད་ལ།",
    "རྩྭ་སྔོན་གྱིས་ཡོངས་སུ་ཁེབས་པའི་རི་ལུང་དུ་ཀྱག་ཀྱོག་ཏུ་བསྐྲུན་པའི་སྣུམ་ལམ་དེར་ཞུགས་ནས་ལུང་དཀར་ཡུལ་ཚོའི་ཕྱོགས་སུ་བསྐྱོད་ཀྱིན་གདའ།",
    "བཏགས་ཡོད་པའང་ཞིབ་བལྟ་ཙམ་མ་བྱས་ན་མི་ཤེས་ཏེ་ཕར་བལྟས་ན་ཁྱི་ཞིག་ཉལ་འདུག་པ་དང་ཟུར་དུ་ཤིང་ཕུར་ཞིག་བརྡབས་ཡོད་པ་ཙམ་ལས།",
    "ཕྱི་ན་སྒོ་ཁྱིས་འགོག་རྒོལ་མེད་པ་བཞིན་དུ་ནང་ནའང་དེ་འདྲའི་འགྲུལ་རྩིས་ཡག་པོ་མི་འདུག་དེ་ནི་མི་ཁྱི་གཉིས་ཀ་མི་ལ་སུན་པ་ཡིན་ནམ།",
    "ཁོ་རང་ཁྱིམ་དུ་འཛུལ་བ་ན་གདོང་ལ་འཛུམ་མདངས་ཤིག་རྒྱས་བཞིན་ཡ་ཁྱེད་རང་དཀའ་ཨེ་བྱུང་།",
    "ཞེས་ངོ་ཤེས་རྙིང་བ་ཞིག་ལོས་ཡིན་སྙམ་པའི་ཁམས་བདེའི་སྐད་ཆ་དྲིས།",
    "༩༦༩ང་རང་ནི་ཆུང་དུས་དམངས་ཁྲོད་ནས་ལག་ཆགས་པ་ཡིན་པས།",
    "ལོས་ཡིན་ལོས་ཡིན།",
    "ཡིན་ནའང་ཉེ་བའི་ལོ་ངོ་འགའི་སྔོན་ནས་འབྲོག་པའི་བུ་ཕྲུག་འགས་རྒྱལ་ཁབ་ཀྱི་ལས་བྱེད་ལོན་པ་ན་རང་ས་རང་ཡུལ་ལ་དགའ་བ་ཡོད་པ་ཕར་ཞོག་ད་དུང་འབྲོག་པ་གླེན་པ་ཚོ་ཞེས་མིག་ལམ་དུ་མི་འཇོག་པའི་སྣང་ཚུལ་ཡང་ཡོད་འདུག་དེ་ནི་དངོས་གནས་དྲིན་ཆེན་ལ་དྲིན་ལོག་གཡང་ལར་རྡོ་ལོག་ཅེས་པའི་དཔེ་ལས་མ་འདས་སྙམ།",
    "ངས་རང་ས་གནས་ཀྱི་མི་མང་པོར་འདིའི་སྐོར་གྱི་ཤེས་རྟོགས་ཡོད་པ་སུ་ཞིག་འདུག་པའི་གནས་ཚུལ་མང་པོ་དྲིས་ནའང་ཁྱེད་ཀྱི་དགའ་ཞིག་ཡོད་རབས་མ་ཐོས་པས།",
    "ད་ཐེངས་ཁྱེད་རང་ཆེད་དུ་བཙལ་ནས་འོང་བ་ཡིན།",
    "བསོད་རྡོར་འདུག་ལྡབ་ཅིག་བྱས་ནས།",
    "ང་རང་ཁ་མཁས་པོ་དེ་འདྲ་མིན་ནའང་ཤོ་སོགས་རྩེད་རིགས་གང་ལའང་ཤིན་ཏུ་དགའ་བའི་མི་ཞིག་ཡིན།",
    "ཞེས་ཤོ་མིག་དག་བྱང་གདན་གྱི་སྟེང་དུ་ཐར་སེར་འཕངས་པ་ན་དངོས་གནས་བཅུ་ཞིག་བབས་འདུག་པས་དེར་ཡོད་ཚང་མ་ཀི་དིར་འུར་དིར་གྱིས་གང་།",
    "ཁབ་ཆེན་གྱི་འགྱིག་ཁུག་ཁ་གང་བ་ཞིག་ཐུར་དུ་གནར་ནས་ལག་གཡས་པའི་རྩ་གསེང་བརྒྱུད་ནས་ལུས་ལ་བབས་ཀྱིན་འདུག་ཅིང་།",
    "འདི་ནི་རྒྱུད་དང་མཐུན་པར་གདའ།",
    "ཁྱེད་རང་ངམ་ཁྱེད་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཨ་དཀར་པོ་སོགས་ནས་འོད་ཟེར་དཔག་ཏུ་མེད་པ་འཕྲོ་བའི་སྐུར་གྱུར།",
    "ཧ་ཧ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཨོཾ་བཛྲ་བེ་རོ་ཙ་ན་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་སྭཱ་ཧཱ།",
    "དཀར་གསུམ་མངར་གསུམ་གོ་རོ་ཙ་ན་དང་།",
    "དཔའ་བོ་ཆེན་པོའི་འདུག་སྟངས་མཛད་པ་ནི།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ན་ལ་ཨི་དཾ་བཏགས་པ་ལན་གསུམ་གྱིས་ཕུལ་ནས།",
    "ཧ་ཧ་ཧྥ་ཞེས་བཞད་གང་ཞིག་དུས་ཀུན་ཏུ་ནི་ཤིན་ཏུ་རབ་ཏུ་འཇིགས་མཛད་པ།",
    "ཤན་པ་ཉེར་དྲུག་དུས་རྣམ་རྒྱལ།",
    "ཕྱི་བསེའི་ཁང་པ་དམར་ལྷག་གེ་འདུག་པ།",
    "མ་ཧཱ་གོ་རོ་ཙ་ན་ཁཱ་ཧི།",
    "ཟས་ཀྱི་རྒྱུགས་དང་རང་རྒྱུད་དང་།",
    "མེ་སྟག་སྟངས་ཀ་སྟེགས་ལ་འདུག།",
    "འདས་དུས་གུས་འདུད་འདི་ན་འདུག།",
    "གདིང་བ་གདུགས་དཀར་གདུགས་ཚོད་གདའ།",
    "མདའ་གཞུ་མེ་མདག་དུས་ཀྱི་མདང་དེ་རིང་།",
    "ཙོག་ཙོག་པོར་འདུག།་",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "། དེའི་ནང་རང་ལུས་སྟོད་ཆ་འཕར་ཞིང་ལྷུང་།",
    "དེའི་ནང་རང་ལུས་སྨད་ཆ་འཕར་ཞིང་ལྷུང་།",
    "དེའི་ནང་རང་ལུས་སྨད་ཆ་འཕར་ཞིང་ལྷུང་།",
    "དེའི་ནང་རང་ལུས་སྨད་ཆ་འཕར་ཞིང་ལྟུང་།",
    "ལག་རིང་རི་རབ་ལ་འཁྱུད་ནས་འདུག་པས་རི་རབ་འགྱེལ་གྱིས་དོགས་ནས་མི་འོང་།",
    "རྟག་མྱོས་ཤིན་ཏུ་མྱོས་བཞིན་པས་འདུག་པས་མི་འོང་བ་སྟེ་བཞིའོ།",
    "པར་འཚོག་པར་འདུག་ཅེས་གསུང་ངོ།",
    "གནོད་བྱེད་གདོན་བགེགས་ལན་ཆགས་འདེད་མཁན་ལ་རང་རང་སོ་སོའི་ཡིད་དང་མཐུན་པའི་མཁོ་བའི་ཡོ་བྱད་དུ་གཏོར་མ་དམིགས་པའི་རྟེན་དུ་གྱུར་པ་དེ་བྱིན་གྱིས་བརླབས་ནས་སྦྱིན།",
    "དཔལ་རྒོད་ཚང་པ་ཆེན་པོ་སོགས་སྔོན་དང་ད་ལྟའི་སྐྱེས་ཆེན་དམ་པ་མང་པོའི་ཕྱག་ལེན་དུ་གནང་བའི་རྒྱུན་ལམ་དུ་འདུག་པ་ལྟར།",
    "དཔག་ཏུ་མེད་པར་གྱུར་པས་བདག་དང་རང་བཞིན་གྱི་ལྷ་དང་།",
    "སྟན་བདེ་བ་ལ་ཅི་བདེ་བར་ཁ་ལྷོ་ཕྱོགས་སུ་བལྟས་ཏེ་འདུག་ལ་སྐྱབས་སུ་འགྲོ་བ་དང་།",
    "ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན་དེ་ཉིད་སྙིགས་མའི་དུས་འདིར་བསྟན་པ་སྤྱི་དང་།",
    "ཕ་རོལ་གནོད་དང་རང་སྲིད་སྐྱོང་བ་དང་།",
    "ཐུགས་རྒྱུད་བསྐུལ་ནས་རང་རང་ཕྱོགས་ཀྱི་ནི།",
    "རང་རང་ཕྱོགས་ཀྱི་བདེན་པ་བསྲུང་མཛད་པའི།",
    "རང་རང་དྲུང་ན་བརྒྱ་བྱིན་ཇི་བཞིན་དུ།",
    "གཞན་གྱི་སྡུག་བསྔལ་གྱིས་བདག་དུས་རྟག་ཏུ་སྡུག་བསྔལ་གྱིས་གདུངས་པ་སྟེ།",
    "བསྒྲུབས་ན་འགྲུབ་པའི་སྐལ་བ་ཅན་ཡིན་ཡང་ཉེས་པ་རྣམ་པ་བཞིས་བཀབ་ནས་འདུག་པ་ཡིན་ཏེ།",
    "འདུག་གམ།",
    "བདག་སྔོན་སོ་མ་པུ་རིའི་ནགས་གསེབ་ན་འདུག་པ་ན།",
    "ཡང་རྡོ་རྗེའི་གདན་ལ་བསྐོར་བ་བྱེད་ཙ་ན།",
    "སྣོད་མིན་འགྲོ་ལ་མི་སྣང་བས།",
