    "ཞེས་དྲིས་པར་ཝིམ་མིཀ་ཀྱིས་རེད།",
    "ཁོས་ག་རེ་བྱེད་དགོས་མིན་གྱི་སྐོར་ལ་མགོ་འཐོམས་ནས་ཡོད་འགྲོ།",
    "ཞུས་པར་ཝིམ་མིཀ་གིས་ཁོ་མགོ་འཐོམས་སོང་།",
    "གཞོན་ནུ་མ་དེ་ཁྱེད་རང་གིས་ངོ་ཤེས་ཀྱི་ཡོད་འགྲོ།",
    "ང་རང་གིས་གང་ཤེས་པའི་གནས་ཚུལ་ལྟར་ན།",
    "ཁོ་མོས་ང་ནི་འགྲོ་སོང་ཆེན་པོ་དང་།",
    "དེ་རྗེས་ཝིམ་མིཀ་གིས་མུ་མཐུད་དེ།",
    "སྐུ་ཞབས་ཧཱར་བྷཊ་ཀྱིས་ཁོ་པ་བཙོན་པ་དེ་དེར་བསྐྱལ་ན་ལེགས་ཚུལ་གྱི་བསམ་ཚུལ་བཏོན་པ་ལ་ངས་ཀྱང་མོས་མཐུན་བྱས་ཤིང་།",
    "གལ་ཏེ་ཁྱེད་ཀྱིས་མི་དེ་ཕྱི་རྒྱལ་གྱི་གྲུ་ཞིག་གི་ནང་ནས་གསང་བྲོས་ཀྱིས་གཏོང་འདོད་ཡོད་ན།",
    "སྟབས་བདེ་པོ་ཡོད་པ་བཅས་གསུམ་རེད།",
    "ལུང་པ་འདི་ནས་འགྲོ་རྒྱུའི་ཁས་ལེན་བྱས་སོང་།",
    "ངས་ཀྱང་དེར་མོས་མཐུན་གཙང་མ་བྱས།",
    "དེ་ཡག་པོ་བྱུང་འདུག་བསམས་ཏེ་ངས་ཝིམ་མིཀ་གིས་གང་གནང་པ་དེར་ཐུགས་རྗེ་ཆེ་ཞུས།",
    "ངས་ཁྱོད་ལ་ཞུ་རྒྱུ་ཞིག་ནི་གནས་ཚུལ་ཞི་འཇམ་མ་བྱུང་བར་དུ་ཁྱེད་རང་གི་གྲོགས་པོ་དེ་གནས་སྐབས་རིང་ད་ལྟ་གང་དུ་ཡོད་ས་དེར་ཞོག་ཁྱེད་རང་གྲུ་གཏོང་མཁས་པོ་ཡོད་ཙང་།"
  ]
}