    "བདག་གཞན་ཟེར་བ་ནི་སྤྱིར་རང་དང་གཞན་ལ་བདག་དང་གཞན་ཟེར་བའི་དོན་མིན་པར་བྱ་བྱེད་ཐ་དད་དུ་ཡོད་པའི་བྱ་བ་ཞིག་གི་བྱེད་ཚིག་གིས་མཚོན་པ་དེ་ལ་བདག་དང་།",
    "བྱ་ཚིག་གིས་མཚོན་པ་དེ་ལ་གཞན་ཟེར་བ་ཡིན།",
    "དེའང་བྱེད་ཚིག་གིས་མཚོན་དགོས་པ་ནི།",
    "རེ་རེ་ནས་བདག་གཞན་གཉིས་སུ་ཕྱེ་བའི་བདག་ཡིན་པར་གོ་ཐུབ།",
    "བྱ་ཚིག་གིས་མཚོན་དགོས་པ་ནི།",
    "རེ་རེ་ནས་བདག་གཞན་གཉིས་སུ་ཕྱེ་བའི་གཞན་ཡིན་པར་གོ་ཐུབ་པའི་དགོས་པ་ཡོད་པའོ།",
    "དཀྲིའོ་ལྟ་བུ་ད་ལྟ་བའི་སྒྲ་ཡིན་མོད་ཀྱི་གཟུང་བར་བྱ།",
    "དེ་དང་དེ་མཚོན་ནུས་པ་ཞིག་ཡིན་ན་དེ་དག་གི་ཁོངས་སུ་གཏོགས་པར་བཞག་ཆོག་པ་དང་།",
    "བལྟས་ན་ཚིག་ཉུང་མོད།",
    "དེས་ན་རེ་ཞིག་ཚིག་ཚོགས་སྐྱུངས་ཕྱིར་དེ་ཙམ་གྱིས་འཐུས་པར་བྱས་སོ།",
    "རྗེས་འཇུག་གི་རྟགས་ཀྱི་ཀྱི་ར་བ།",
    "ཐོབ་ཡོན་ཕོ་མོ་མ་ནིང་གསུམ་དུ་དབྱེ།",
    "ང་མ་འ་གསུམ་མོ་ཡིག་དང་།",
    "འདིར་ཕོ་མོ་མ་ནིང་གི་དབྱེ་ཚུལ་ཡང་རྗེས་འཇུག་དེ་ཉིད་མིང་གཞིའི་ཡི་གེ་གང་ལ་ཞུགས་པ་ལས་བརྗོད་པའི་སྒྲ་གདངས་དྲག་ཞན་བར་མར་འགྱུར་བའི་ཆ་ནས་བཞག་པ་སྟེ།",
    "དེ་ཡང་མིང་གཞི་གང་གི་མཐར་ཡང་རུང་ག་ད་བ་ས་རྣམས་ཞུགས་པ་སྒྲ་དྲག་པ་དང་།",
    "མོ་ལ་མོ་དང་ཤིན་ཏུ་མོ།",
    "དེའང་རྗེས་འཇུག་ག་བ་གཉིས་རྗེས་འཇུག་གི་ཕོ་ཡིག་ཡིན་པ་འདྲ་ཞིང་ཡང་འཇུག་ས་ཡིག་ཞུགས་པའང་འདྲ་ན་རབ་འབྲིང་གི་ཁྱད་པར་གང་གིས་འཇོག་སྙམ་ན།",
    "དཔེར་ན་ད་བ་ས་གསུམ་ཕོར་འདོད་པའི་ལུགས་ཀྱི་རབ་འབྲིང་གི་ཁྱད་བཞིན་ནོ།",
    "ས་དའི་མཐའ་རྣམས་ནི་སྒྲ་དྲག་པའི་ཞན་པར་འགྱུར་བས་སྐྱེས་བུ་ཐ་མ་སྟེ་གསུམ་མོ།",
    "དེ་བཞིན་དུ་རྗེས་འཇུག་གི་མོ་ལའང་དབྱེ་ན།",
    "ང་མ་གཉིས་ལ་ཡང་འཇུག་ཞུགས་པ་ནི་རྗེས་འཇུག་ནང་ཕྲད་ཀྱི་སྟོབས་ལས་སྒྲ་ཞན་པའི་དྲག་པར་འགྱུར་བས་མོ་ཙམ་དང་།",
    "དེ་གཉིས་ལ་ཡང་འཇུག་མི་ཞུགས་པ་དང་འ་ཡིག་གི་མཐའ་རྣམས་ནི་སྒྲ་ཤིན་ཏུ་ཞན་པར་འགྱུར་བས་ཤིན་ཏུ་མོ་སྟེ་གཉིས་སུ་དབྱེ་བ་དང་།",
    "མ་ནིང་ན་ར་ལ་གསུམ་པོ་མིང་གཞིའི་ཕོ་ཡིག་གི་མཐར་ཡང་འཇུག་ཡོད་མེད་གང་རུང་དང་མོ་ཡིག་གི་རྗེས་སུ་ཡང་འཇུག་མེད་པར་ཞུགས་པའི་ཚེ་ནི་སྒྲ་བར་མའི་དྲག།",
    "པའམ་ཞན་པར་འགྱུར་བས་འགྱུར་བ་མ་ནིང་དང་མིང་གཞིའི་མོ་ཡིག་གི་མཐར་ཞུགས་ཤིང་ཡང་འཇུག་དང་བཅས་པར་གྱུར་པའི་ཚེ་ནི་སྒྲ་བར་མ་ལས་དྲག་ཞན་གཉིས་ཀའི་ཆ་དང་ལྡན་པར་འགྱུར་བས་མ་ནིང་མཚན་གཉིས་པ་དང་།",
    "མིང་གཞིའི་མ་ནིང་གི་མཐར་ཞུགས་པའི་ཚེ་ཡང་འཇུག་ཡོད་མེད་ཇི་ལྟར་རུང་མིང་རྗེས་གཉིས་ཀ་མ་ནིང་ཡིན་པའི་སྟོབས་ཀྱིས་སྒྲ་བར་མ་ཙམ་ལས་དྲག་ཞན་གང་དུའང་མི་འགྱུར་བའི་ཕྱིར་འདི་རྣམས་ནི་མཚན་མེད་མ་ནིང་དག་སྟེ།",
    "ཕོ་མོ་གཉིས་ཀྱི་རྟགས་མིང་གཞི་ལ་ལྟོས་མི་དགོས་པ་དང་།",
    "ན་ནིང་གི་རྟགས་མིང་གཞི་ལ་ལྟོས་དགོས་དོན་གང་ཞེ་ན།",
    "དེ་ནི་ཕོ་མོ་གཉིས་རང་རང་གིས་འབྱེད་དུ་ཡོད་ལ།",
    "ཕོ་གསུམ་མོ་གཉིས་ཀྱི་རྟགས་ཀྱི་དབྱེ་བ་འབྱེད་བྱེད་གང་།",
    "ཕོ་མོ་གཉིས་ཀྱི་རྟགས་ཀྱི་དབྱེ་བ་མིང་གཞི་ལ་ལྟོས་མི་དགོས་དོན་གང་།",
    "མ་ནིང་གི་རྟགས་མིང་གཞི་ལ་ལྟོས་དགོས་དོན་གང་།",
    "ཁྱོ་གཅིག་ཀྱཀྱལ་།",
    "གང་ལ་འཇུག་བྱེད་གང་གིས་བྱེད།",
    "དེ་ཡང་རྗེས་འཇུག་ཕོ་མོ་མ་ནིང་གསུམ་རེ་རེ་ལའང་བྱེད་པ་བཞི་བཞིའི་སྒོ་ནས་འཇུག་ཚུལ་ཤེས་པར་བྱེད་དགོས་པ་ཉིད་དེ།",
    "འཇུག་པ་པོ་གང་གིས་འཇུག་པར་བྱེད་པ་དང་།",
    "དེ་ཡང་རྗེས་འཇུག་གི་ཡི་གེ་བཅུ་པོ་དེ་དག་འཇུག་ཡུལ་ཡི་གེ་གང་དང་གང་ལ་འཇུག་པ་ནི་མིང་གཞིའི་ཡི་གེ་ཐམས་ཅད་ལ་བྱེ་བྲག་མེད་པར་འཇུག་པ་ཡིན་ནོ།",
    "བ་ཡིག་གང་གིས་འཇུག་པ་ནི།",
    "ཡོངས་ག་ཕོ་གསུམ་མོ་གཉིས་མ་ནིང་གསུམ།",
    "དེའང་རྗེས་འཇུག་གི་ཡི་གེ་བཅུ་ལས་ཕོ་སྐྱེས་བུ་རབ་འབྲིང་ཐ་གསུམ་དང་།",
    "མོ་མོ་ཙམ་དང་ཤིན་ཏུ་མོ་གཉིས།",
    "དེ་བཞིན་དུ་མོ་གཉིས་ཞན་པར་འཇུག་པ་དང་།",
    "སྤྱིར་བཏང་རྗེས་འཇུག་ལ་ཕོ་མོ་མ་ནིང་གསུམ་དུ་རྣམ་པར་བཞག་པའང་ཡིན་ནོ་ཞེས་ཞར་ལས་བསྟན་པར་གྲུབ་བོ།",
    "ངའི་ཁ་ལ་ཀོང་དེ་ལའང་ནང་གི་ཆ་ཤས་ཀྱིས།",
    "དྲག་པ་གསུམ་སྟེ་ཕོ་ཡིག་སྐྱེས་བུ་རབ་འབྲིང་ཐ་གསུམ་ནི་རྗེས་འཇུག་ཉིད་ནང་ཕྲད་དུ་གྱུར་པ་ལ་ལྟོས་ནས་དབྱེ་སྟེ་མིང་གཞི་གང་གི་མཐར་ཡང་རུང་རྗེས་འཇུག་གི་ཕོ་ཡིག་རྣམས་ཡང་འཇུག་དང་བཅས་ཞུགས་པས་སྒྲ་དྲག་པ་གཞིར་བཞག་པའི་ནང་གསེས་དྲག་འབྲིང་གང་རུང་དུ་གྱུར་པའི་ཆ་ནས་སྐྱེས་བུ་རབ་འབྲིང་གཉིས་སུ་འབྱེད་ཅིང་།",
    "དེ་བཞིན་དུ་གལ་ཏེ་ཞན་པ་སྟེ་མོ་ཡིག་རྣམས་རྗེས་འཇུག་ནང་ཕྱད་ཀྱིས་མིང་གཞིར་ཞུགས་པ་ཡོད་ན་དེར་ལྟོས་པས།",
    "དེ་དག་ལའང་ནང་གི་ཆ་ཤས་སྒྲ་འཇུག་དྲག་ཞན་སོགས་ཀྱིས།",
    "ཡང་འཇུག་དང་བཅས་པའི་མོ་ཡིག་ཞུགས་པ་མོ་ཙམ་དང་།",
    "ཡང་འཇུག་མེད་ན་ཤིན་ཏུ་མོར་འབྱེད་པའི་ཕྱིར་རོ།"
  ]
