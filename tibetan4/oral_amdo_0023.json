    "དེ་གཉིས་ལ་འབྲེལ་བ་ཡང་ཞེ་དྲག་ཡོད་པ་རེད།",
    "གཏུམ་མོ་བསྒོམས་ནས་གནམ་གཤིས་ཞེ་དྲག་གི་གྲང་མོ་ཡོད་པའི་སྐབས་ལ་ལུས་ལ་རས་གོས་གྱོན་ནས་སྡོད་པའི་སྐབས།",
    "གཏུམ་མོ་སྒོམ་ནས་བཞུགས་མཁན་དེ་ཚོ་ཡེ་ནས་འཁྱག་རྒྱུ་ཡོད་པ་མ་རེད།",
    "ཁོ་རང་སྡོད་སའི་ཕྱི་ལོག་གི་འདོམ་པ་གང་ཚུན་ཆད་ཀྱི་གངས་ཚང་མ་ཞུར་བསྡད་ཀྱི་ཡོད་པ་རེད།",
    "གཏུམ་མོ་དེས་ཁྲིས་ལ་ཡོད་པའི་མི་རྣམས་ཀྱང་དྲོད་བསྡད་ཀྱི་ཡོད་པ་རེད།",
    "དཀྱིལ་དེར་ལྕགས་ཐབ་བཏང་བ་ཡིན་ན་གཡས་གཡོན་གྱི་མི་ཚང་མ་དྲོད་བསྡད་ཀྱི་མ་རེད་དམ།",
    "དགུན་དུས་གྲང་ངར་གྱི་སྐབས་སུ་ལྕགས་ཐབ་ཅིག་གི་འཁྲིས་ལ་བསྡད་པ་ནང་བཞིན་ཡོད་པ་རེད།",
    "གཏུམ་མོ་སྣོན་ཁ་རྒྱག་པ་དེ་ནི།",
    "སྤྱི་བོའི་རྩ་འཁོར་གྱི་འོག་ཏུ་ནཱ་དའི་ཟླ་གདན་སྲན་མ་ཕྱེད་ཀ་ཙམ་ཞིག་གི་སྟེང་།",
    "སྤྱི་བོའི་འདིའི་ཁ་ཐུག་དེར་ཡི་གེ་ཧཾ་ཡིག་ཞིག་མགོ་ཐུར་ལ་གཏད་ནས་ཡོད་པ་རེད།",
    "དེ་ནས་མ་གིའི་གསང་གནས་ཀྱི་རྩ་འཁོར་ཅིག་ཡོད་པ་རེད།",
    "དཀྱིལ་འདི་ལྟེ་བའི་རྩ་འཁོར་རེད།",
    "གྲུ་གསུམ་ཆེན་པོ་འདི་ལྟེ་བའི་རྩ་འཁོར་རེད།",
    "ལྟེ་འོག་འདི་གསང་གནས་ཀྱི་རྩ་འཁོར་རེད།",
    "གཏུམ་མོ་དེ་འདི་ནས་ཡར་བྱས།",
    "འདི་ལྟེ་བའི་རྩ་འཁོར་རེད།",
    "དེ་ནས་འདི་གཉིས་པོ་དེ་གཅིག་གི་ཁ་མར་གཏད།",
    "གཅིག་གི་ཁ་ཡར་སློག་ནས་བསམ་བློ་གཏོང་དགོས་ཀྱི་ཡོད་པ་རེད།",
    "ཡུམ་རེག་བྱ་རྡོ་རྗེ་མ་ཞིག་བསམས་ཡོད་པ།",
    "ཉི་མའི་གདན་དེ་དང་པོར་སོལ་བར་མེ་ཡོད་པ་ནང་བཞིན་དམར་སེང་སེང་ཞིག་མ་གཏོགས་ཡོད་པ་མ་རེད།",
    "མ་གཞི་སོལ་བ་ལ་མེ་དམར་སེང་སེང་ཞིག་ཡོད་པ་རེད།",
    "དེར་ཐུག་པ་དང་ཡང་དམར་སེང་ཙམ་བྱས་པ་རེད།",
    "ཉི་གདན་དམར་ཧང་ཧང་བྱས་པ་རེད།",
    "མེ་རང་ཞིག་ཡར་རྡོག་ཙམ་ཞིག་དོན་ཡོང་པ་རེད།",
    "འདི་འདྲ་རེད།",
    "དང་པོ་ནས་རང་བཞིན་གྱི་མེ་འབར་འོངས་པ་བསམ་བློ་གཏོང་རྒྱུ་ཡོད་པ་མ་རེད།",
    "དེ་ལྟར་བྱེད་མི་རུང་བ་རེད་གསུངས།",
    "དེ་ནས་གང་འཚམས་ནས་སོལ་བ་དེ་ཕལ་ཆེར་འཚིག་དུས་མེ་སྦར་ཡོང་གི་མ་རེད་དམ།",
    "ཕུ་བཏབ་པ་ཡིན་ན་གང་འཚམས་ནས་མེ་ཏོག་ཙམ་ཞིག་སྦར་ཡོང་གི་རེད།",
    "ཤུགས་ཆེན་པོ་རང་མིན་པ་ཞིག་དོན་ཡོང་གི་རེད།",
    "དེ་ནས་རིམ་བཞིན་ཡར་སྦར་ཡོང་གི་རེད།",
    "མེ་དེ་ཅུང་ཙམ་ཆུང་དུ་འགྲོ་གི་རེད།",
    "ང་ཚོའི་སྦི་ཇི་ལིའི་ནང་གྱི་ཤེལ་ཏོག་གི་མེ་ནང་བཞིན་ཅིག་སྟེ།",
    "རེག་བྱ་ཤིན་ཏུ་ཚ་བ་ཞིག་དང་པོ་སོར་གང་ཙམ།",
    "དེ་ནས་སོར་གསུམ་སོགས་རིམ་པས་བསམ་བློ་གཏོང་དགོས་ཀྱི་རེད་གསུངས་པ་རེད།",
    "དེ་ནས་གང་འཚམས་ནས་གསང་གནས་ཀྱི་གཏུམ་མོ།",
    "ཁྲག་གི་ཐིག་ལེ་དྲོད་ཀྱི་རང་བཞིན་ཅན་དེ་ཡར་འབར་ཡོང་ནས་ལྟེ་བ་ལ་ཐུག་ལྟེ་བའི་གཏུམ་མོ་དེ་ཡར་འབར།",
    "དེ་ནས་སོར་དོ་ལ་སོགས་པ་དོན་པ་དེར་མེ་འབར་བ་ཟེར་གྱི་ཡོད་པ་རེད།",
    "དེ་ལྟར་བྱས་ནས་ལྟེ་བ་དང་གསང་གནས་ཀྱི་གཏུམ་མོ་དེ་རེག་བྱ་ཤིན་ཏུ་ཚ་བ་སྟེ།",
    "ཡི་གེ་ཧཱུྃ་ཡིག་གི་རྣམ་པ་དེ་ལ་ཕོག་དེ་ལ་ཕོག་ནས་དེ་ཉིད་སྣུབ་ཚོར་ཚོར་ལྟ་བུ་ཆགས།",
    "དེ་ནས་མར་དེ་རྡོབ་སྒྲ་དང་བཅས་མར་ཟག་གི་རེད།",
    "མར་ཕྱིན་ནས་མགྲིན་པར་སླེབས་སོང་བ་ན།",
    "བྱང་སེམས་འབར་བ་དེ་མེ་ལ་ཐིམ་པ་རེད།",
    "དེ་ནས་ཐིག་པ་རྒྱབ་ནས་དེ་རང་ཧྲིལ་ཧྲིལ་མར་ཟག་ཡོང་གི་རེད།",
    "ཟིན་ཐུབ་པའི་མོས་པ་གྱིས་གསུངས་པ་རེད།",
    "ལྷན་སྐྱེས་ཀྱི་དགའ་བ་དེ་སྐྱེས་ནས་མ་གིར་ཅུང་ཙམ་བསྡད།",
    "རང་སར་ལོག་འགྲོ་བ་རེད།",
    "འདི་ལ་ཡང་དགའ་བ་བཞི་ཡོད་པ་རེད།",
    "དེ་འདྲ་གྱིས་གསུངས་པ་རེད།",
    "འོད་གསལ་འདིའི་མཉམ་བཞག་དེ་ནས་སེམས་ལ་ཅུང་ཙམ་གཡོ་འགུལ་ཐིབ་ཀྱི་མ་རེད་དམ།",
    "དཀར་ཡོལ་ཞིག་གི་ནང་དུ་ཆུ་བླུགས་ནས།",
    "ཆུ་དེ་ལ་ལྷག་པ་མ་ཕོག་པའི་རིང་ལ་ཆུ་དེ་ལ་གཡོ་འགུལ་ཡོང་གི་མ་རེད།",
    "ང་རང་ཚོའི་སེམས་དེ་བསམ་བློ་གཅིག་ལ་བཏང་ནས་བསྡད་པ་ཡིན་ན།",
    "གང་འཚམས་ཤིག་ནས་སེམས་དེར་ཕྲན་བུའི་གཡོ་འགུལ་གཏོང་གི་རེད།",
    "གཡོ་འགུལ་ཐེབ་པ་དང་དུས་མཉམ་དུ་རང་གི་འོད་གསལ་གྱིས་སེམས་དེ་ཡི་བཞོན་པར་གྱུར་པའི་རྒྱུ་བྱས།",
    "སོ་སོས་བསམ་བློ་ག་རེ་གཏོང་བདེ་བ་ཞིག་ལ་བསམ་བློ་གཏང་།",
    "ཡི་དམ་ཞལ་གཅིག་ཕྱག་གཉིས་པ་གཅིག་པུའི་སྐུ་ལ་ལངས་སོང་བསམ་པ་བྱས།",
    "སྲུང་མ་འཁོར་དང་བཅས་པའི་ཆ་ཚང་ཞིག་གི་སྐུ་ལ་ལངས་སོངས་བསམ་པ་བྱ་དགོས་ཀྱི་རེད།",
    "དེ་བསམ་བློ་བཏང་བ་དེ་ག་རེ་རེད་དམ་ཟེར་ན།",
    "སད་དུས་ཀྱི་ལོངས་སྐུའི་བསྲེ་བ་ཞེས་པ་དེ་རེད།",
    "ང་རང་ཚོའི་གཉིད་མ་ཁུག་པའི་སྐབས་ཀྱི་ལོངས་སྐུའི་བསྲེ་བ་ཟེར་བ་དེ་རེད།",
    "ཡང་ཐུགས་ཁའི་ཧཱུཾ་ཡིག་གི་ཞབས་ཀྱུ་ནས་བཅས་པ་ཡར་ཐིམ།",
