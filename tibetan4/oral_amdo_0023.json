    "གྱེན་རྒྱུ་དེ་ཡི་ཁ་དོག་དམར་པོ་རེད།",
    "དེའི་དམར་གདངས་དེ་གང་ནས་བྱུང་བ་རེད་དམ་ཟེར་ན།",
    "མཉམ་གནས་ལྗང་གུ་དེ་ཡང་ལྗང་གུ་ཡིན་ལ་དམར་བའི་གདངས་ཡོད་པ་དེ་འདྲ་ཞིག་ཆགས་འགྲོ་ཡི་ཡོད་པ་རེད།",
    "དེའི་གདངས་དེ་ཟུར་ལ་འགྲོ་མཁན་ལ་ཕོག་གི་ཡོད་པ་རེད།",
    "དེ་འདྲ་རེད།",
    "ལྷ་མོར་བགོས་པའི་ཚེ།",
    "ཆ་སྙོམས་བྱས་ནས་བགོས་པ་ཡིན་ན་ཉིས་བརྒྱ་ཉེར་ལྔ་ཐོབ་ཀྱི་ཡོད་པ་རེད།",
    "ཞེས་པ་དེ་ག་རེ་རེད་དམ་ཟེར་ན།",
    "འདི་ནས་ཟུར་ཅིག་བསྐྱངས་འགྲོ་གི་རེད།",
    "རྩ་འདབ་ཀྱི་མིང་དེ་འདྲ་ཡིན་པ་རེད།",
    "དེ་ནི་སུམ་སྐོར་མ་ནས་བདུད་དྲལ་མའི་བར་གྱི་རྩ་འདབ་ལྔ་དང་དོན་གཅིག་པ་རེད་ཟེར།",
    "དང་པོ་ཨ་མའི་ཁོག་པར་ཡོད་དུས་རེད།",
    "ཕྱི་ལོག་ཏུ་མ་སྐྱེས་བར་དུ་སྣ་ཁུག་ནས་འགྲོ་གི་མ་རེད།",
    "ཕྱི་ལོག་ཏུ་སྐྱེས་མ་ཐག་སྣ་ཁུག་ནས་དབུགས་དེ་འགྲོ་ཡི་ཡོད་པ་རེད།",
    "ཨ་ཐུང་གི་གཞིར་གྱུར་ནས་ངག་སྨྲ་བརྗོད་ཀྱི་རྒྱུ་བྱེད་པ་དང་།",
    "ཚེས་པ་བཅོ་ལྔ་བར་དུ་ཉི་མ་གསུམ་གསུམ་བྱས་ནས་འགྱུར་འགྲོ་ཡི་ཡོད་པ་རེད།",
    "མ་གི་ནས་གཉིས་འགྲོ་དུས་འདིའི་གཅིག་བྱས།",
    "ཆུ་ཚོད་ཀྱི་མདའ་དེ་ལ་མགྱོགས་པོ་འགྲོ་མཁན་གཅིག་མགྱོགས་ལོས་འབྲིང་བྱས་པ་གཅིག་ཞེ་དྲག་གི་དལ་པོ་བྱས་ནས་འགྲོ་མཁན་གཅིག་སྟེ།",
    "ཆུ་ཚོད་ཨ་མ་གཅིག་བྱས་ཡོད་པ་རེད།",
    "མདའ་རིང་ཤོས་དེ་སྐོར་ར་བཅུ་གཉིས་འཁོར་སོང་ན་མདའ་ཐུང་བ་དེ་ཆུ་ཚོད་གཅིག་རེད།",
    "ལྟེ་བ་བཅས་དཀྱིལ་འཁོར་ཆེན་པོ་བཞི་ཡོད་པ་རེད།",
    "སྣ་བུག་གཉིས་ཀ་ནས་མཉམ་དུ་འགྲོ་ཡི་ཡོད་པ་རེད།",
    "དེ་མཉམ་དུ་འགྲོ་ཡི་ཡོད་པ་རེད།",
    "ཉི་ཤུ་རྩ་བཞི་ཡོད་པ་རེད།",
    "འདིའི་གཤམ་དེ་སྡོམ་འབྱུང་དང་བརྟག་གཉིས་ལས་གསུངས་པ་རེད།",
    "ཕྱི་ལ་འགྲོ་རྒྱུའི་དབྱུ་གུ་དྲུག་ཅུ་རྩ་བཞི་ཡོད་པ་རེད།",
    "ཉི་མ་གཅིག་ལ་ཆུ་ཚོད་དྲུག་ཅུ་རེ་བཞི་རེད།",
    "ང་རང་ཚོ་ཉི་མ་གཅིག་ལ་ཆུ་ཚོད་ཉི་ཤུ་རྩ་བཞི་མ་རེད་དམ།"
