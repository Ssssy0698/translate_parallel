    "མི་སྲུན་སྐྱེ་བོ་ཉོན་མོངས་རྣམ་པས་ཀྱང་།",
    "གཞན་གདོང་ལྟ་བའི་རེ་བ་མེད་པར་བྱ།",
    "དེ་བས་ངན་སོང་འཇིགས་དང་རྒྱལ་སྲིད་དང་།",
    "གནོད་སེམས་འབྲོག་གི་མེ་ལ་ཆུ་ཡི་རྒྱུན།",
    "སྐྱེ་བོ་མཆོག་གི་བཟོད་པའི་གོ་ཆ་ལ།",
    "མི་སྲུན་སྐྱེ་བོའི་ཚིག་གི་མདས་རྡུགས་པས།",
    "སྐྱེ་བོ་གདུག་པའི་ངག་གི་མཚོན་གྱི་རྨ།",
    "རང་གི་ལས་དགེ་འཇིག་རྟེན་ཕན་བྱེད་པས།",
    "ཡེ་ཤེས་མཆོག་གིས་སྦྱངས་པའི་བཟོད་ལྡན་ན།",
    "རེ་རེ་བརྗོད་ཅིང་དེ་བཞིན་འཇིག་པས་ན།",
    "རང་གི་ལས་བཞིན་འགྱུར་བ་རྟོགས་བྱ་ཞིང་།",
    "སྐྱེ་བོ་མ་རབས་ཐོག་མར་བརྩམས་མི་མོས།",
    "དེ་འདྲའི་རྣམ་པས་ཚོགས་གཞན་དེ་རེ་ཞིང་།",
    "འཁོར་ཚེ་རང་གི་སྡུག་བསྔལ་སེམས་གཏང་ཞིང་།",
    "འཇིག་རྟེན་མེས་བཀང་རྐང་གིས་འབོག་བྱ་ཞིང་།",
    "ས་ཆེན་མཚོན་གྱིས་དཀྲིགས་པས་གཟིགས་བྱས་ཏེ།",
    "བདེ་གཤེགས་ལྟ་བར་མོས་དང་གང་ལྡན་ཞིང་།",
    "ཉི་མ་གཅིག་གིས་ལ་ལ་སྒྲོལ་བྱེད་ལ།",
    "སྤུ་རྣམས་གཅིག་ནས་རེ་རེར་མངོན་འགྲུབ་ཅིང་།",
    "མཚན་ནི་སྣ་ཚོགས་རེ་རེ་འགྲུབ་འགྱུར་ལ།",
    "བརྩོན་འགྲུས་འདོར་བ་དེ་ལ་གང་གི་སྒོར།",
    "ཡེ་ཤེས་མཆོག་གི་ལས་ལ་གནས་འཆའ་ཡང་།",
    "ཟབ་མོར་གནས་པའི་གནས་དག་གམ།",
    "འདུ་འཛི་ཉོན་མོངས་དབེན་གྱུར་པའི།",
    "སྐྱིལ་མོ་ཀྲུང་དུ་བདེར་འདུག་སྟེ།",
    "མྱ་ངན་འདའ་བར་མོས་མེད་ཅེས།",
    "འདི་ནི་ཉོན་མོངས་འཁྲུག་པར་འགྱུར།",
    "བདག་གི་བདེ་ཙམ་ཐོབ་དོན་དུ།",
    "རང་གི་མགོ་བོ་ཚིག་གྱུར་ཀྱང་།",
    "སྒྲིབ་པ་རྣམས་ལས་རང་གི་ཡིད།",
    "བཙལ་ཚེ་རོ་མེད་ཉོན་མོངས་ལ།",
    "གང་གི་རོ་ལ་མྱོས་གྱུར་ན།"
  ]
