    "རྒྱུན་ཆད་པས་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་པ་ནི་སྔ་མ་བཞིན་ནོ།",
    "འདི་དག་བདེ་བ་དང་ཡིད་བདེ་བ་དང་མཚུངས་པར་ལྡན་པ་ནི་མ་ཡིན་ཏེ་དམན་པའི་རྣམ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ང་རྒྱལ་ནི་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་དང་མཚུངས་པར་ལྡན་པ་མེད་པས་འདོད་པའི་ཁམས་ན་ཡིད་བདེ་བ་དང་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "གསུམ་པ་ལ་ནི་བདེ་བ་དང་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "བཏང་སྙོམས་ཁོ་ན་དང་མཚུངས་པར་ལྡན་ནོ།",
    "མཐར་འཛིན་པར་ལྟ་བ་དང་།",
    "ལྟ་བ་མཆོག་ཏུ་འཛིན་པར་ལྟ་བ་དང་།",
    "ལོག་པར་ལྟ་བ་ནི་འདོད་པའི་ཁམས་ན་ཉེས་པར་སྤྱད་པའི་འབྲས་བུ་མེད་པར་རྟོགས་ཏེ་ཡིད་བདེ་བ་དང་།",
    "ལེགས་པར་སྤྱད་པའི་འབྲས་བུ་མེད་པར་རྟོགས་ཏེ་ཡིད་མི་བདེ་བ་དང་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "དེ་བཞིན་དུ་གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་ན་ནི་ཚོར་བ་གང་ཡོད་པ་དེ་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ཐེ་ཚོམ་ནི་འདོད་པའི་ཁམས་ན་ངེས་པ་མ་ཐོབ་པས་ཡིད་མི་བདེ་བ་དང་མཚུངས་པར་ལྡན་པ་དང་།",
    "བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "དེ་ཡན་ཆད་དུ་ནི་ཚོར་བ་གང་ཡོད་པ་དེ་དང་མཚུངས་པར་ལྡན་ནོ།",
    "འདོད་ཆགས་ནི་འདོད་པའི་ཁམས་ན་རྣམ་པར་ཤེས་པའི་ཚོགས་དྲུག་དང་མཚུངས་པར་ལྡན་ནོ།",
    "གཟུགས་ཀྱི་ཁམས་ན་ནི་སྣ་ལྕེའི་ཤེས་པ་མེད་པས་རྣམ་པར་ཤེས་པའི་ཚོགས་བཞི་དང་མཚུངས་པར་ལྡན་ནོ།",
    "གཟུགས་མེད་པའི་ཁམས་ན་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཚོགས་གཅིག་པུ་དང་མཚུངས་པར་ལྡན་ནོ།",
    "བའོ་། འདོད་པའི་ཁམས་ན་སྡུག་བསྔལ་མཐོང་བས་སྤང་བར་བྱ་བ་དེའི་རྒྱུ་དང་གཞིའི་གནས་ཀྱིས་ལོག་པར་རྟོག་པ་དག་ནི་བཅུའོ།",
    "མཐར་འཛིན་པར་ལྟ་བ་ལྷན་ཅིག་སྐྱེས་པ་དང་།",
    "གཟུགས་ཀྱི་ཁམས་ན་ཁོང་ཁྲོ་བ་མ་གཏོགས་པར་ལྔའོ།",
    "གང་སྡུག་བསྔལ་བ་དེ་ནི་བདག་མེད་པའོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "དེ་བས་ན་བདག་མེད་པ་ཉིད་ཀྱི་རྣམ་པ་ནི་བླ་ན་མེད་པ་ཉིད་དུ་རྣམ་པར་བཞག་གོ།",
    "རྣམ་པར་གྲོལ་བ་བླ་ན་མེད་པའོ།",
    "དེ་ལ་ཤེས་པ་བླ་ན་མེད་པ་ནི་བདག་མེད་པར་ཤེས་པ་སྟེ།",
    "རྣམ་པར་གྲོལ་བ་བླ་ན་མེད་པ་ནི་མི་སློབ་པ་མི་འཁྲུགས་པའི་རྣམ་པར་གྲོལ་བ་སྟེ་རྣམ་པར་གྲོལ་བ་ཐམས་ཅད་ལས་ཁྱད་པར་དུ་འཕགས་པའི་ཕྱིར་རོ།",
    "བསམ་པ་སྔོན་དུ་བཏང་བའི་ལུས་ལ་སོགས་པའི་རྩོལ་བའི་ལས་དང་གསེར་མགར་སོགས་ཀྱིས་རྒྱན་ལ་སོགས་པར་བསྒྱུར་བའི་དེབ་ལྔ་པ།",
    "མ་བྱིན་པར་ལེན་པ་དང་།",
    "འདོད་པ་ལ་ལོག་པར་གཡེམ་པ་དང་།",
    "ཡང་དག་པར་ལྟ་བའོ།",
    "མཐར་ཟིན་པར་བྱས་པས་ཀྱང་རིག་པར་བྱའོ།",
    "སྔ་མ་གསུམ་ནི་བྱས་ཀྱང་སེམས་པ་ལས་གྱུར་པའི་ལས་བསགས་པ་མི་འགྱུར་ཏེ་དེའི་ཕྱིར་རྣམ་པར་སྨིན་པ་གདོན་མི་ཟབར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "ཕྱི་མ་དག་ནི་བྱས་ན་བསགས་པ་ཡིན་ཏེ།",
    "དེའི་རྣམ་པར་སྨིན་པ་གདོན་མི་ཟ་བར་མྱོང་བར་འགྱུར་རོ།",
    "དེ་རྣམས་སུ་རྣམ་པར་སྨིན་པ་མྱོང་བར་བྱས་ནས་མི་དང་སྐལ་བ་མཉམ་པར་འོངས་པ་ན།",
    "ཚིག་རྩུབ་ཀྱིས་ནི་ཡིད་དུ་མི་འོང་བའི་སྒྲ་ཐོས་པར་འགྱུར་རོ།",
    "སླར་ཡང་དེ་ལ་རྨོངས་པར་འགྱུར་རོ།",
    "མ་བྱིན་པར་བླངས་པས་ནི་མི་བརྟན་ཞིང་ཉམས་པར་བྱེད་པ་མང་བར་འགྱུར་རོ།",
    "འདོད་ལོག་སྤྱད་པས་ནི་རྡུལ་གྱིས་ཁེབས་པར་འགྱུར་རོ།",
    "རྫུན་དུ་སྨྲས་པས་ནི་དྲི་མི་ཞིམ་པར་འགྱུར་རོ།",
    "ལོག་ལྟས་ནི་ལོ་ཐོག་རྣམས་ལ་འབྲས་བུ་མེད་པར་འགྱུར་རོ།",
    "ལས་དུ་མས་ལུས་གཅིག་འཕེན་པར་བྱེད་པའི་ལས་ཀྱང་ཡོད་དེ།",
    "རྣམ་པར་སྨིན་པ་མྱོང་བར་འགྱུར་ཞེ་ན།",
    "དེ་ལ་གང་ཤིན་ཏུ་ལྕི་བར་གྱུར་པ་དེ་ཐོག་མར་རྣམ་པར་སྨིན་པར་འགྱུར་རོ།",
    "ཡང་ན་གང་ཡུན་རིང་དུ་གོམས་པར་གྱུར་པའོ།",
    "ཡང་ན་གང་ཐོག་མར་སྤྱད་པ་དེ་ཐོག་མ་ཉིད་དུ་རྣམ་པར་སྨིན་པར་འགྱུར་རོ།",
    "མི་གཡོ་བའི་འདུ་བྱེད་རྣམས་སོ་ཞེས་གང་གསུངས་པ་དེ་ལ།",
    "འབྲས་བུ་རྣམ་པར་སྨིན་པ་ལ་རྨོངས་པ་དང་།",
    "མ་བྱིན་པར་ལེན་པ་ལ་ཇི་ལྟ་བར་འདོད་པ་ལ་ལོག་པར་གཡེམ་པ་དང་།",
    "གང་ཚད་དུ་བྱས་པའི་ལས་དེས་འཕགས་པ་དེ་གནས་ངན་པར་ཁྲིད་པར་མི་བྱེད་དོ།",
    "ལས་དེ་ལ་འཕགས་པ་དེ་དག་གནས་པར་མི་བྱའོ།",
    "ལས་དེས་འཕགས་པ་དེ་བྱེད་པོ་དང་སྤྱོད་བྱེད་བགྲང་བར་མི་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "ཡང་རྣམ་པ་དགུས་སྟོབས་དང་ལྡན་པའི་ལས་སུ་རིག་པར་བྱ་སྟེ།",
    "མྱ་ངན་ལས་འདས་པར་འདོད་པ་ལྟ་བུ་བསམ་པ་དང་།",
    "བསམ་སྦྱོར་ཐམས་ཅད་བསྟུན་ཏེ་སྐྱེ་བོ་མང་པོས་བྱས་པས་ཀྱང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གང་གསུངས་པ་དེ་ལ་དགོངས་པ་གང་ཞེ་ན།",
    "འདིར་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་ལུས་སེམས་བདེ་བ་དང་ལྡན་བཞིན་དུ་བསགས་པའི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་བདེ་བ་དང་ལྡན་པ་བཀག་གོ།",
    "དེ་བཞིན་དུ་རྒྱུ་དུས་སུ་དཀའ་ཐུབ་དྲག་པོ་ལྟ་བུའི་སྡུག་བསྔལ་དང་ལྡན་ལ་བདེ་བ་མྱོང་བར་འགྱུར་བའི་རྣམ་པར་སྨིན་པ་བདེ་བ་ནི་གནང་ངོ།",
    "བ་ནི་གནང་ངོ།",
    "ཇི་སྲིད་འཚོའི་བར་དུ་སྲོག་གཅོད་པ་ལ་སོགས་པ་ཉེས་པར་སྤྱོད་པ་ལས་དབེན་པར་སྤྱོད་པ་དང་།",
    "མི་ཚངས་སྤྱོད་སོགས་འདོད་པ་ལས་དབེན་པར་སྤྱོད་པའོ།",
    "འདོད་པ་ལས་དབེན་པར་སྤྱོད་པ་ཡང་མ་ཡིན་པའོ།",
    "བའི་ངེས་ཚིག་ཉིད་ནི་བཀག་སྟེ་དགེ་སློང་དང་དགེ་སློང་མའི་ཕྱོགས་གཉིས་ཀ་ལ་འདིས་བསྙེན་བཀུར་བྱེད་ཅིང་ཉེ་བར་གནས་པར་བྱ་བའི་འོས་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལ་གནོད་པར་བྱེད་པ་ལས་བྱུང་བ་དང་།",
    "གང་སྐྱེ་བ་ཕྱི་མ་དེ་ཕན་ཆད་དུ་རྣམ་པར་སྨིན་པ་ཡིད་དུ་འོང་བ་དང་མི་འོང་བ་རྣམ་པར་སྨིན་པར་འགྱུར་བའོ།",
    "གནག་ལ་རྣམ་པར་སྨིན་པ་གནག་པའི་ལས་གང་ཞེ་ན།",
    "རྣམ་པར་སྨིན་པ་མི་འདོད་པ་འབྱིན་པའོ།",
    "དཀར་ལ་རྣམ་པར་སྨིན་པ་དཀར་བའི་ལས་གང་ཞེ་ན།",
    "དཀར་གནག་དུ་གྱུར་ལ་རྣམ་པར་སྨིན་པ་དཀར་གནག་ཏུ་འགྱུར་བ་གང་ཞེ་ན།",
    "འགྱུར་ཞིང་ཟག་པ་དང་བཅས་པའི་ལས་ཐམས་ཅད་ཟད་པར་འགྱུར་བའི་ལས་གང་ཞེ་ན།",
    "ངོ་བོ་ཉིད་ཀྱིས་ཀྱང་རིག་པར་བྱ་སྟེ།",
