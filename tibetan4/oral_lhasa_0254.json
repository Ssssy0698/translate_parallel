    "རྣམ་པར་འཇིག་པའི་མཚན་ཉིད་གང་ཞེ་ན།",
    "གང་འདུ་བྱེད་སྐྱེས་པ་རྣམས་ཀྱི་རང་བཞིན་ཡང་དེ་མ་ཐག་ཏུ་རྣམ་པར་འཇིག་པའོ།",
    "སྲོག་རྣམ་པར་འགྱུར་ནས་ཤི་བའོ།",
    "བསམ་གཏན་ལ་མཉམ་པར་བཞག་པ་དང་།",
    "འཇིག་པར་བྱེད་པ་གསུམ་སྟེ།",
    "དུས་མ་ཡིན་པར་འཆི་བ་སྟེ།",
    "ཅིའི་ཕྱིར་གང་མི་རྟག་པ་དེ་སྡུག་བསྔལ་ཞེས་གསུངས་ཤེ་ན།",
    "གང་ཅི་ཚོར་ཡང་རུང་འདི་ནི་འདིར་སྡུག་བསྔལ་དུ་གསུངས་སོ་ཞེས་བཀའ་སྩལ་ཏོ།",
    "དགག་གཞི་གང་ལ་དགག་བྱ་གང་མེད་པ་དེ་ནི་དེས་སྟོང་པར་ཡང་དག་པར་རྗེས་སུ་མཐོང་བ་སྟེ།",
    "དེ་ལྟར་བདག་ནི་མེད་ཀྱི་བདག་མེད་པ་ནི་ཡོད་པར་སྟོང་པ་ཉིད་ཁོང་དུ་ཆུད་པར་བྱའོ་། འདི་ལ་དགོངས་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཡོད་པ་ཡོད་པར་ཇི་ལྟ་བར་རབ་ཏུ་ཤེས།",
    "མེད་པ་ཡང་མེད་པར་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ་ཞེས་གསུངས་སོ།",
    "དེ་ནི་འདི་བཞིན་ནོ་ཞེས་ཡང་དག་པའི་ཤེས་རབ་ཀྱིས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་བལྟ་བར་བྱའོ་ཞེས་གསུངས་པ་འདིའི་དོན་ཅི་ཞེ་ན།",
    "ཞེས་གང་གསུངས་པ་དེ་ཅི་ལས་དགོངས་ཏེ་གསུངས་ཤེ་ན།",
    "བཞི་ག་རྒྱུར་བྱས་པ་སྲིད་པ་ལ་དགོངས་ནས་གསུངས་སོ།",
    "ཕྱོགས་གཅིག་ལ་བརྟེན་པའི་དངོས་པོའི་དོན་ནི་རྒྱུར་བྱས་པའི་དོན་ཏེ།",
    "དེ་ལ་ཅིག་ཤོས་ནི་མེད་དོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "རྒྱུར་བྱས་པའི་འབྲས་བུའི་གཟུགས་ལ་ཡང་རྒྱུར་བྱས་པའི་གཟུགས་གང་འདུས་པ་གང་ལ་དྲི་ལ་སོགས་པའི་དངོས་པོ་གང་ཡོད་པར་དམིགས་པ་དེ་ནི་དོན་ཡོད་གྱིས་གཞན་མེད་པའོ་ཞེས་རིག་པར་བྱའོ།",
    "རྡུལ་ཕྲ་རབ་བསགས་པ་ནི་གཟུགས་འདུས་པའོ་ཞེས་གང་བརྗོད་པ་དེ་ལ་རྡུལ་ཕྲ་རབ་དེ་ནི་རྣམ་པར་བཞག་པ་ཙམ་ལས་ལུས་མེད་པར་རིག་པར་བྱའོ།",
    "གོང་བུ་ལ་བློས་མཐར་ཐུག་པར་རབ་ཏུ་ཕྱེ་ནས་རྡུལ་ཕྲ་རབ་ཏུ་རྣམ་པར་བཞག་སྟེ།",
    "སྡུག་བསྔལ་བ་བར་པ་གཟུགས་ཀྱི་ཁམས་སུ་སྐྱེས་པ་ཐར་བའི་ཆ་དང་མཐུན་པའི་དགེ་རྩ་རྣམ་པར་སྤངས་པ་རྣམས་ཀྱིའོ།",
    "བསམས་བཞིན་དུ་སྲིད་པར་གཞན་གྱི་དོན་དུ་སྐྱེ་བའི་ཕྱིར་རོ།",
    "འཆི་བ་སྡུག་བསྔལ་ལོ་ཞེས་གང་གསུངས་པ་དེ་ལ་འཆི་བ་རྣམ་པ་གསུམ་སྟེ།",
    "འདོད་ཆགས་དང་བཅས་པར་བར་མ་དོའི་སྲིད་པ་འགགས་ཅིང་མངལ་གྱི་ནུར་ནུར་པོ་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་དང་བཅས་པ་འབྱུང་སྟེ།",
    "ཡང་ན་ཀུན་ཏུ་ལེན་པའི་རྣམ་པར་ཤེས་པ་ནི་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་ཉིད་ཀྱི་གནས་སྐབས་ཏེ།",
    "ད་ལྟར་བྱུང་བ་ལ་ནི་ལྷག་པར་ཆགས་པས་རྗེས་སུ་འགྲོ་བས་དུས་ཐམས་ཅད་དུ་རྗེས་སུ་འགྲོ་བ་དང་།",
    "དམིགས་པ་དང་མཚུངས་པར་ལྡན་པ་དང་།",
    "ལོག་པར་ཞུགས་པ་དང་།",
    "ལོག་པར་ལྟ་བ་དང་།",
    "ཡུལ་དེ་ལ་ཡང་ཚུལ་བཞིན་མ་ཡིན་པ་གཙང་བ་དེ་སོགས་སུ་ཡིད་ལ་བྱེད་པ་ཉེ་བར་གནས་པ་ཡིན་ཏེ།",
    "ལྟ་བ་དང་མཚུངས་པར་ལྡན་པའི་མ་རིག་པ་དང་།",
    "པའོ་། མཚུངས་པར་ལྡན་པ་གང་ཞེ་ན།",
    "འདོད་ཆགས་ནི་ཤིན་ཏུ་མི་མཐུན་པས་ཁོང་ཁྲོ་བ་དང་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ནོ་། ཁོང་ཁྲོ་བ་དང་ཇི་ལྟ་བར་ཐེ་ཚོམ་དང་ཡང་དེ་བཞིན་ནོ་། ཐེ་ཚོམ་དུ་གྱུར་ན་བློ་གནས་པ་མེད་པས་ཆགས་པར་གྱུར་པ་མེད་པའི་ཕྱིར་ཞེས་པའི་དོན་ཏོ།",
    "ལྷག་མ་ང་རྒྱལ་དང་མ་རིག་པ་དང་ལྟ་བ་རྣམས་ནི་འདོད་ཆགས་དེ་དང་མི་མཐུན་པ་མེད་པའི་ཕྱིར་མཚུངས་པར་ལྡན་ནོ།",
    "འདོད་ཆགས་དང་ཁོང་ཁྲོ་བ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ཁོང་ཁྲོ་བ་ཡང་དམིགས་རྣམ་འགལ་བས་འདོད་ཆགས་དང་དངོས་པོ་གང་ལ་ཞེ་འགྲས་པ་དེའི་ཁེངས་པ་མེད་པས་ང་རྒྱལ་དང་གང་ལ་ཞེ་འགྲས་པ་དེ་ལ་ངར་འཛིན་པ་སོགས་མེད་པས་ལྟ་བ་དང་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ནོ།",
    "ང་རྒྱལ་ནི་གང་ལ་ཞེ་འགྲས་པ་དེའི་ཁེངས་པ་མི་རིགས་པས་ཁོང་ཁྲོ་བ་དང་གཏན་ལ་མ་ཕེབས་བཞིན་དེས་ཁེངས་པ་མེད་པས་ཐེ་ཚོམ་དང་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ནོ།",
    "ངེས་པའི་ཡུལ་ལ་མ་ཡིན་པས་ཐེ་ཚོམ་དང་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ནོ།",
    "ཐེ་ཚོམ་ནི་ཡིད་གཉིས་སུ་གྱུར་བཞིན་དུ་དེ་ལ་གཅིག་ཏུ་ཞེན་པ་མིན་པས་འདོད་ཆགས་དང་དེ་ལྟར་གྱུར་བཞིན་སེམས་ཁེངས་པ་མེད་པས་ང་རྒྱལ་དང་དེ་ནི་ངར་འཛིན་པ་སོགས་དང་མི་མཐུན་པས་ལྟ་བ་དང་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ནོ།",
    "མི་མཐུན་པ་དག་མི་མཐུན་པ་དག་དང་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ཏེ།",
    "མཐར་འཛིན་པར་ལྟ་བ་དང་ལོག་པར་ལྟ་བའོ།",
    "བདག་གྲོལ་ནས་ཀྱང་རྟག་པར་འགྱུར་རོ་སྙམ་པའམ་ཆད་པར་འགྱུར་རོ་སྙམ་པ་དང་།",
    "མངོན་གྱུར་ཉིད་ཀྱི་ཕྱོགས་དང་མཐུན་པ་ས་བོན་དུ་གྱུར་པའི་གནང་ངན་ལེན་ཏོ།",
    "ཁོང་ཁྲོ་བའི་བག་ལ་ཉལ་ཏེ་ཕྲ་རྒྱས་དེ་གཉིས་རྒྱས་པར་འགྱུར་རོ།",
    "ཁམས་གོང་མའི་སྲིད་པ་ཚོལ་བ་མ་སྤངས་པས་ནི་སྲིད་པའི་འདོད་ཆགས་ཀྱི་བག་ལ་ཉལ་རྒྱས་པར་འགྱུར་རོ།",
    "ལམ་མ་ཡིན་པ་ལ་ལམ་དུ་ཞེན་པའི་ལོག་པས་ཚངས་པར་སྤྱོད་པ་ཚོལ་བ་མ་སྤངས་པས་ནི་ང་རྒྱལ་གྱི་བག་ལ་ཉལ་དང་།",
    "ཐེ་ཚོམ་གྱི་བག་ལ་ཉལ་རྣམས་རྒྱས་པར་འགྱུར་ཏེ།",
    "འདི་ལྟར་དེ་དག་ནི་གཉེན་པོ་ཆུང་ངུ་ཙམ་གྱིས་ཀྱང་ཁེངས་པར་འགྱུར་རོ།",
    "བདེན་པ་རྣམས་ལའང་རྨོངས་པར་འགྱུར་རོ།",
    "རྟོག་པར་བྱེད་དོ།",
