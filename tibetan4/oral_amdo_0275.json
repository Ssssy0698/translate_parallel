    "དངོས་པོ་རྣམས་ལ་བདག་གི་ཞེས་བཟུང་བས།",
    "ཚིག་དང་པོས་ནི་གང་ཟག་གི་བདག་འཛིན་བསྟན་ཅིང་།",
    "བདག་དང་བདག་གིར་ཞེན་པའི་འཇིག་རྟེན་པ་འདི་ནི་ལས་དང་ཉོན་མོངས་པའི་ཐག་པས་ཆེས་བསྡོམས་ཤིང་།",
    "ཟོ་ཆུན་རྒྱུད་མོའི་ཐོག་ཐ་བར་གསུམ་གྱི་རིམ་པ་མི་ཟིན་པ་ལྟར་མ་རིག་སྲེད་ལེན་གསུམ་སྟེ་ཉོན་མོངས་པའི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "འདུ་བྱེད་དང་སྲིད་པ་གཉིས་ལས་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "རེག་པ།",
    "རྒ་ཤི་སྟེ་སྐྱེ་བའི་ཀུན་ནས་ཉོན་མོངས་པ་སྟེ་ཉོན་མོངས་པ་གསུམ་གྱིས་སྔ་ཕྱི་བར་གྱི་རིམ་པ་མི་ཟིན་པ།",
    "ཆུའི་གཉེར་མ་ལྟར་ཉི་མ་རེ་རེ་ཞིང་སྡུག་བསྔལ་གྱི་སྡུག་བསྔལ་དང་།",
    "འགྱུར་བའི་སྡུག་བསྔལ་དག་གིས་གཅོག་པའི་ཕྱིར་ཟོ་ཆུན་གྱི་ཆུན་མོ་དང་མཚུངས་པ་ཡིན་ནོ།",
    "རང་གི་ལས་ཀྱི་གཟུགས་བརྙན་ལྟ་བུར་སྐད་ཅིག་རེ་རེ་ལ་མི་རྟག་པའི་ཁྱབ་པ་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་གྱིས་རབ་ཏུ་གཡོ་བར་མཐོང་བ་དང་།",
    "གསུམ་པའི་ཡུལ་ནི་དེ་དག་གི་སྟེང་དུ་ས་བཅུའི་མཉམ་བཞག་ལ་གནས་པའི་བྱང་སེམས་རྣམས་ཀྱང་ཡིན་པར་ཤེས་པ་བྱའོ་ཞེས་དམིགས་པ་དང་ཡུལ་གཉིས་ཀའི་སྒོ་ནས་ཁྱད་པར་ཡོད་པར་གསུངས་སོ།",
    "གང་གི་སེམས་ནི་རབ་དགའ་ལ་གནས་པ།",
    "ཡེ་ཤེས་རང་གི་ངོ་བོར་སར་བཞག་ཏུ་མེད་དེ།",
    "འོན་ཀྱང་གང་ཟག་གཞན་གྱི་བློ་དང་རང་གི་རྗེས་ཐོབ་ཀྱི་བློས་ལྡོག་པའི་ཆར་རྣམ་པར་ཕྱེ་བ་ན་ས་ཞེས་བྱ་བའི་མིང་འཐོབ་སྟེ།",
    "ས་དང་པོ་ཐོབ་པའི་བྱང་སེམས་གང་གི་རྗེས་ཐོབ་ཀྱི་སེམས་ནི་རབ་ཏུ་དགའ་བ་ལ་གནས་པ་སྟེ་ཟག་པ་མེད་པའི་དགའ་བདེ་སྔར་མེད་གསར་དུ་ཐོབ་པས་རབ་ཏུ་དགའ་བ་ཞེས་མིང་གི་ཁྱད་པར་ཐོབ་སྟེ།",
    "ཅིའི་ཕྱིར་གཞུང་འདི་ལས་ས་བཅུ་རྣམ་པར་བཞག་ཅིང་མོས་པས་སྤྱོད་པ་གང་གི་ནང་དུ་འདུ་ཞེ་ན།",
    "མོས་པས་སྤྱོད་པའི་སྐད་ཅིག་དེ་ལ་གནས་པ་ཡང་།",
    "རང་གི་རྒྱུད་མཛེས་པར་བྱས་པའི་ཡོན་ཏན།",
    "ངན་སོང་སོགས་སྦྱང་བྱ་འགགས་པའི་ཡོན་ཏན་དང་གསུམ་ལས།",
    "སོ་སྐྱེ་དང་ཉན་རང་གི་ས་ཐམས་ཅད་ལས་འདས་པའི་ཕྱིར་དང་།",
    "འང་གི་སྒྲ་ནི་དོན་ལྡན་གྱི་མཚན་ཐོབ་པ་མ་ཟད་ཅེས་སྔ་མ་སྡུད་པའོ།",
    "གང་ཟག་གི་བདག་མེད་པ་མངོན་སུམ་དུ་མཐོང་བས་དེ་དག་སླར་མི་སྐྱེ་བའི་ཕྱིར་རོ།",
    "བཟོད་ཐོབ་ངན་སོང་ཡོང་མི་འགྲོ།",
    "རིང་དུ་སོང་བར་བློ་ཡང་ལྷག་པར་འགྱུར།",
    "དུས་གང་གི་ཚེ་བློ་གྲོས་ཀྱི་མཐུས་ཟིལ་གྱིས་གནོན་ཞེ་ན།",
    "བྱང་སེམས་དེ་ནི་མཚན་འཛིན་གྱི་རྟོག་པ་ལས་རིང་དུ་སོང་བ་ས་བདུན་པ་ཐོབ་པར་གྱུར་པའི་ཚེ།",
    "ས་དེར་ཐབས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐོབ་པས་སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ཞིང་འགོག་པ་ལ་སྙོམས་པར་འཇུག་ཅིང་ལྡང་བའི་ཕྱིར་དང་།",
    "ས་དྲུག་པ་མན་ཆད་དང་ཉན་རང་དག་གིས་དེ་ལྟར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཉན་རང་གི་ཡུལ་འགོག་པ་ནི་ཚོར་འདུ་བཀག་པའི་འགོག་པ་ཙམ་ཡིན་ལ།",
    "བྱང་སེམས་ཀྱི་ཡུལ་འགོག་པ་ནི་རང་གི་ཐུན་མོང་མ་ཡིན་པའི་ཡུལ་སྤྲོས་པ་མཐའ་དག་བཀག་པའི་འགོག་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ས་བདུན་པ་ནས་བློ་གྲོས་ཕུལ་དུ་བྱུང་བར་འགྲོ་བའི་ལུང་གི་ཁུངས་ནི།",
    "དཔེར་ན་རྒྱལ་པོའི་རིགས་སུ་སྐྱེས་པ་རྒྱལ་པོའི་བུ་རྒྱལ་པོའི་མཚན་དང་ལྡན་པ་ནི་སྐྱེས་པ་ཙམ་གྱིས་རྒྱལ་པོའི་བྱིན་གྱིས་བློན་པོའི་ཚོགས་ཐམས་ཅད་ཟིལ་གྱིས་གནོན་གྱི་རང་གི་བློའི་སྟོབས་ཀྱིས་རྣམ་པར་དཔྱད་པས་ནི་མ་ཡིན་ནོ།",
    "ནམ་དེ་ནར་སོན་པར་གྱུར་པ་དེའི་ཚེ་རང་གི་བློའི་སྟོབས་བསྐྱེད་པས་བློན་པོའི་བྱ་བ་ཐམས་ཅད་ལས་ཤིན་དུ་འདས་པ་ཡིན་ནོ།",
    "སེམས་དང་པོ་བསྐྱེད་པའི་བྱང་སེམས་ཀྱིས་བློའི་སྟོབས་ཀྱིས་ཟིལ་གྱིས་གནོན་པར་ཐལ།",
    "ཕུང་པོ་རགས་པ་བདེན་མེད་དུ་མ་རྟོགས་ན་གང་ཟག་གི་བདག་མེད་མི་རྟོགས།",
    "ཁམས་གསུམ་ན་སྤྱོད་པའི་ཕྲ་རྒྱས་ཀྱང་མ་སྤངས་པར་ཐལ།",
    "གཟུགས་ལ་སོགས་པ་བདག་ཏུ་གདགས་པའི་གཞི་ཕུང་པོ་རགས་པ་བདེན་མེད་དུ་མ་རྟོགས་ན་དེ་དག་གི་ངོ་བོ་ལ་དམིགས་པས་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་ཕྱིར།",
    "གང་ཟག་གི་བདག་མེད་རྟོགས་པར་ཡང་མི་འགྱུར་བར་ཐལ།",
    "བུད་ཤིང་མེད་པའི་མེར་ཐལ་འགྱུར།",
    "གང་གིས་མཐོང་བར་འགྱུར་ཞེ་ན།",
    "རང་གི་ལུས་ལས་ཤ་བཅད་དེ་གཞན་དུ་གཏོང་བ་ལའང་གུས་པར་བྱས་པའི་གང་ཟག་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་དག་གི་ཡང་འདོད་པའི་ལོངས་སྤྱོད་རྣམས།",
    "གཏོང་བ་པོ་ཚུལ་དང་མི་མཐུན་པ་གཞན་ལ་ཕན་པའི་བསམ་པ་སྤངས་ནས་རང་གི་དོན་འབའ་ཞིག་གི་ཆེད་དུ་ནོར་ཆུང་ངུ་བཏང་ནས་དེའི་རྣམ་པར་སྨིན་པ་རྒྱ་ཆེན་པོ་འདོད་པ་དག་གི་སྦྱིན་པ་ལ་ལོངས་སྤྱོད་ཅི་ལྟར་འབྱུང་ཞེ་ན།",
    "ཁྱད་པར་གསུམ་པ་ནི་རང་འབའ་ཞིག་གི་དོན་དུ་ནོར་ཅུང་ཟད་བཏང་བས་འབྲས་བུ་ནོར་གྱི་ཕུང་པོ་རྒྱ་ཆེན་པོ་ལྷུར་ལེན་པ་ཉིད་དུ་འདོད་ནས་སྦྱིན་པ་ལ་གུས་པར་གྱུར་པ་གང་ཡིན་པའོ།",
    "འཕགས་པ་དང་ཕྲད་པ་དེ་ནས་དམ་པ་དེ་དག་གིས་གདམས་ངག་ཉེ་བར་བསྟན་པའི་མཐུ་ལས།",
    "ལམ་དེ་ཡི་རྒྱུ་ཅན་ཏེ་འབྲས་བུ་ཉན་རང་གི་ཞི་བ་མྱ་ངན་ལས་འདས་པར་འགྲོ་བར་འགྱུར་རོ།",
    "འགྲོ་བ་མཐའ་དག་ལ་འཕྲལ་དང་ཡུན་དུ་ཕན་པར་དམ་བཅས་ཤིང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་སེམས་བསྐྱེད་པའི་ཡིད་ཅན་བྱང་སེམས་རྣམས་ནི་སྦྱིན་པས་དུས་རིང་པོར་མི་ཐོགས་པར་སློང་བ་པོའི་ཡིད་ཚིམ་པ་ལས་བྱང་སེམས་རང་གི་ཐུགས་ལ་སྦྱིན་འབྲས་དགའ་བ་ཁྱད་པར་ཅན་འཐོབ་པའི་ཕྱིར་ཐམས་ཅད་ཀྱི་ཚེ་སྦྱིན་པ་ལ་དགའ་བར་འགྱུར་རོ།",
    "སྦྱིན་འབྲས་དགའ་བ་ཐོབ་པའི་ཚུལ་ཇི་ལྟར་ན་སློང་མོ་བས་ཁོ་བོ་ཅག་ལ་ནོར་སོགས་བྱིན་ཅིག་ཅེས་པའི་སྒྲ་དེ་བྱང་སེམས་རྣམས་ཀྱིས་ཐོས་པ་ན་བདག་ལ་ཡིན་ནམ་གཞན་ལ་ཡིན་ཞེས་སེམས་པ་ལས་བདག་ལ་སློང་བ་ཞིག་ཏུ་རྟོགས་པའི་ཚེ་ན།",
    "ལུས་བཅད་སྟེར་ཞིང་བདག་གི་སྡུག་བསྔལ་གྱིས།",
    "ཆགས་པ་མེད་པའི་གནས་སྐབས་མ་ཐོབ་པ་ཚོགས་སྦྱོར་ན་གནས་པའི་རྒྱལ་སྲས་རྣམས་ལ་སྡུག་བསྔལ་འབྱུང་མོད།",
    "ཕྱོགས་གླང་གིས།",
    "དཔེར་ན་སྒྱུ་མ་མཁན་གྱིས་རང་གི་སྒྱུ་མས་སྤྲུལ་པའི་བུད་མེད་ལ་དབྱིབས་སོགས་སུ་མཚན་མར་འཛིན་པ་ལྟར་མ་དག་ས་བདུན་སྐབས་མཚན་མར་འཛིན་པ་ཡོད་པ་དང་།",
    "དག་པ་ས་གསུམ་དུ་ཡོད་པ་དང་མེད་པའི་མཚན་མར་འཛིན་པའི་འདུ་ཤེས་མེད་ཀྱང་གཉིས་སྣང་གིས་བསླད་པའི་འཛིན་པ་ཕྲ་མོའི་ཆ་རྗེས་ཐོབ་ན་ཡོད།",
    "དཔེར་ན་ཟླ་བ་ས་གཞི་དམའ་མོ་ལ་མི་གནས་པར་ནམ་མཁའ་མཐོན་པོ་ལ་གནས་པ་ལྟར།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ནི་ས་དམའ་མོ་ལྟ་བུ་སོ་སྐྱེའི་ཡིད་ལ་མི་གནས་པར།",
    "འཆལ་ཚུལ་སློང་བྱེད་ཀྱི་ཉོན་མོངས་པ་དང་དུ་མི་ལེན་པའི་ཕྱིར་དང་།",
    "བསྙེན་པར་མ་རྫོགས་པ་ཁྱིམ་པ་ལ་སྤོང་བཞི་འཇོག་མོད་ཀྱི།",
    "ངག་གི་རྒྱུ་བ་རྫུན་ཕྲ་མ་ཚིག་རྩུབ་ངག་འཁྱལ་ཏེ་བཞི་དང་།",
    "ངང་གིས་སོག་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ཞི་འོད་ཆགས་པར་དེ་དག་གིས་རྣམ་མཛེས།",
    "གསོག་མོད་ཀྱི་འོན་ཀྱང་།",
    "གང་གིས་སྤོང་བར་བྱེད་པ་གསུམ་ཆར་ལའང་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ལ་སོགས་གཉིས་འཛིན་གྱི་བློའི་རྒྱུ་བ་ཡང་དག་པར་བྲལ་བར་ཡང་འགྱུར་རོ།",
    "ངན་སོང་ལས་ཐར་དཀའ་བའི་སྐྱོན་དང་།",
    "ངན་སོང་དུ་སྐྱེས་པ་རྣམས་ནི་ལས་འབྲས་ཀྱི་འབྲེལ་བ་ལ་རྨོངས་པའི་ཕྱིར་སྔོན་གྱི་སྦྱིན་པའི་འབྲས་བུ་སྐྱེད་དང་བཅས་པ་ལོངས་སྤྱོད་པ་ཙམ་དུ་ཟད་ཀྱི།",
    "དེ་ཚེ་དེ་ནས་གང་གིས་འབྱིན་པར་འགྱུར།",
    "དེ་ཉིད་ངེས་འབྱུང་གི་བསམ་པ་དང་བདེན་བཞི་མི་རྟག་བཅུ་དྲུག་དང་།",
    "གང་གིས་གང་ཞིག་གང་ལ་སྤོང་བྱེད་པ།",
    "ས་གཉིས་པ་དྲི་མ་མེད་པའི་མིང་ཅན་འདི་ཡང་ཞེས་ཡང་སྒྲས་རབ་ཏུ་དགའ་བའི་མིང་ཅན་གྱི་ས་ལ་མཐོང་སྤང་གི་དྲི་མ་སེལ་བ་ལ་སོགས་པའི་ཡོན་ཏན་ཡོད་པར་མ་ཟད་ཅེས་སྡུད་པའོ།",
    "འགྲོ་བའི་ཡིད་ཀྱི་འཆལ་ཚུལ་དང་ཉོན་མོངས་པའི་གདུང་བ་མ་ལུས་པ་སེལ་བར་བྱེད་པ་ཡིན་ནོ།",
    "ཤེས་བྱའི་བུད་ཤིང་མ་ལུས་སྲེག་པའི་མེ།",
    "དུས་གང་གི་ཚེ་ན།",
    "གལ་ཏེ་གནས་མིན་འཁྲུགས་པ་འགའ་ཞིག་གིས།",
    "སྲང་རེ་ཡུན་རིང་དུས་སུ་གཅོད་བྱེད་ཀྱང་།",
    "གལ་ཏེ་གནས་མིན་འཁྲུགས་པ་སྟེ་བྱང་འཕགས་རྣམས་ཁོང་ཁྲོ་བའི་གནས་མིན་པས་ན་དེ་ལ་ཁོང་འཁྲུགས་པའི་སྐྱེ་བོ་འགའ་ཞིག་གིས་བྱང་སེམས་ས་གསུམ་པ་དེ་ཡི་སྐུ་ལུས་ལས་ཤ་གཅོད་ཚུལ་ནི་རུས་པ་དང་བཅས་པའི་ཤ་གཅོད་པ་དང་།",
    "གང་གིས་གང་ལ་གང་ཚེ་ཅི་བཅད་ཅེས།",
    "དུས་གང་གི་ཚེ།",
    "ཐུན་མོང་དུ་མཇུག་བསྡུ་བ་དང་གསུམ།",
    "ཀུན་སློང་ཁོང་ཁྲོ་བའི་སྒོ་ནས་སླར་སྡུག་བསྔལ་བར་འགྱུར་བའི་ཕྱིར་སྡུག་བསྔལ་དེའི་ས་བོན་སྒྲུབ་སྟེ་ངན་སོང་གི་གནས་ཉིད་དུ་རང་གིས་རང་ཇི་ལྟར་ན་ཁྲིད་པར་བྱེད་དེ་བྱེད་མི་རིགས་པའོ།",
    "གང་གི་ཕྱིར་ན་གལ་ཏེ་རྟེན་གྱི་གང་ཟག་རྒྱལ་སྲས་བདག་ཉིད་ཆེན་པོ་དེས།",
    "གང་གིས་བཟོད་པ།",
    "རྣམ་པར་འཇིག་པ་མེད་པ་ཉིད་དུ་རྟོགས་པས་ས་གསུམ་པ་རང་གི་ངོ་སྐལ་གྱི་སྤང་བྱས་བསྡུས་པའི་འདོད་ཆགས་དང་ཞེ་སྡང་།",
    "དེ་དག་གི་རོ་མི་མྱོང་པའི་ཕྱིར་དང་།",
    "དེ་ལྟར་ཡོན་ཏན་ཐམས་ཅད་ཀྱི་རྒྱུར་གྱུར་པའི་བརྩོན་འགྲུས་རང་གི་ཡོན་ཏན་ཡོངས་སུ་དག་པའི་སྒོ་ནས་ས་གང་དུ་འབར་ཞིང་ལྷག་པར་གྱུར་པ་ཡི་ས་དེ་ནི་ས་བཞི་པ་འོད་འཕྲོ་བ་ཞེས་བྱའོ།",
    "ཡང་ན་ནང་གི་ཉོན་མོངས་པ་ཕར་སྦྱང་དཀའ་བ་དེ་ལས་རྒྱལ་བས་ན་ས་ལྔ་པ་ལ་སྦྱང་དཀའ་བ་ཞེས་བྱའོ།",
    "ཞིབ་མོ་རྟོགས་ལའང་ཤིན་ཏུ་མཁས་པ་ཐོབ།",
    "དེ་ཡང་བདེན་བཞི་རང་རང་གི་མཚན་ཉིད་ཇི་ལྟར་གནས་པ་དེ་འཕགས་པ་རྣམས་ཁོ་ནས་མཁྱེན་པས་ན་འཕགས་པའི་བདེན་པར་བཞག་ལ།",
    "སོ་སྐྱེས་རྣམས་ལ་སྡུག་བསྔལ་ཀུན་འབྱུང་སོགས་རང་ལ་ཡོད་ཀྱང་དེ་དག་གི་མཚན་ཉིད་ཇི་ལྟ་བར་མི་ཤེས་པས་ཕྱིན་ཅི་ལོག་ཏུ་འཛིན་པས་ན་དེ་དག་གི་བདེན་པར་མ་བཞག་གོ།",
    "དེ་ལྟར་ཡིན་མོད་ཀྱང་བླང་བར་བྱ་བ་དང་།",
    "མིག་ལྡན་སྐྱེས་བུ་གཅིག་གིས་འདོད་པ་ཡི།",
    "དེ་ཀུན་ཀྱང་གཡང་ས་ལ་སོགས་པ་སྤངས་ཏེ་བདེ་བླག་ཏུ་མིག་དང་ལྡན་པའི་སྐྱེས་བུ་གཅིག་གིས་འདོད་པ་ཡི་ཡུལ་དུ་ཁྲིད་པར་བྱེད་པ་དེ་བཞིན་དུ།",
    "གོང་དུ་རྟེན་འབྱུང་གི་དེ་ཉིད་མཐོང་བའི་བྱང་སེམས་དེ།",
    "དེའི་རང་གི་ངོ་བོ་ནི་མ་རིག་པའི་ལིང་ཐོག་གིས་བློ་མིག་གཡོག་པ་བདག་ཅག་གི་ཡུལ་དུ་མི་འགྲོ་ཡི།",
    "ཁོང་གིས་ཁེངས་པ་བསྐྱུང་བ་ཉིད་དུ་རིག་སྟེ།",
    "རྟེན་ཅིང་འབྲེལ་འབྱུང་གི་དེ་ཉིད་མཐོང་ཚུལ་མ་གསུང་ངམ།",
    "སྒྲོ་འདོགས་དང་བྲལ་བར་དཔལ་ལྡན་ཟླ་བ་བདག་གིས་བརྗོད་པར་བྱའོ།",
    "འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱིས་ལུང་གི་དགོངས་པ་ངེས་པ་ཇི་ལྟར་ཤེས་ཤེ་ན།",
    "ཐལ་འགྱུར་གྱི་རིགས་པས་ལོག་རྟོག་བཅོམ་པའི་སྒོ་ནས་བསྟན་པར་བྱ་བ་དང་།",
    "དེ་ལྟ་མོད་ཀྱི་འོན་ཀྱང་ནང་གི་ཁྱད་པར་དེ་ངེས་དཀའོ་ཞེ་ན།",
    "མི་སྟོང་པའི་སྣང་བ་ཤུལ་དུ་ལུས་པ་དེས་རྟེན་འབྱུང་གི་གོ་ཆོད་པར་བྱས་ཏེ་ཡོད་མེད་གཉིས་ཚོགས་ཙམ་ལ་མཐར་ཐུག་གི་དེ་ཁོ་ན་ཉིད་དུ་རེ་བ་ལྟ་བུ་མ་ཡིན་པར།",
    "གང་ཟག་གི་བདག་མེད་རིགས་པས་གཏན་ལ་ཕབ་པ་གཉིས།",
    "ཞེས་མཐའ་བཞི་སྐྱེ་འགོག་གི་དམ་བཅའ་ཉེ་བར་བཀོད་པ་ཡིན་ནོ།",
    "དེ་དག་གི་སྐྱེ་བ་དོན་མེད་པ་ཉིད་དུ་འགྱུར་བའི་ཕྱིར་དང་།",
    "གཉིས་ཀའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྟག་ཏུ་ཐམས་ཅད་ལས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་དང་།",
    "དེ་ལྟར་གང་གི་ཕྱིར་དངོས་པོ་སྐྱེ་བ་རྣམ་པ་ཐམས་ཅད་དུ་མི་འཐད་པས་དེའི་ཕྱིར་སྐྱེ་བ་མེད་པས་སྐྱེ་བར་བརྗོད་པ་ནི་ཐ་སྙད་ཙམ་ཡིན་ནོ།",
    "འདི་ལྟར་གཏན་ཚིགས་གིས་བསྒྲུབ་བྱ་སྒྲུབ་པ་ལ་གཏན་ཚིགས་དེ་དང་བསྒྲུབ་བྱ་ལ་མེད་ན་མི་འབྱུང་གི་འབྲེལ་བ་ཡོད་དགོས་པ་ལས་འདིར་དེ་མི་འདུག་པའི་ཕྱིར་ཏེ།",
    "དེའི་འོག་ཏུ་ཐམས་ཅད་ལས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་སྨྲས་པས།",
    "དེ་ལྟར་གྱུར་ན་རང་གིས་སྔར་སྐྱེ་བ་མེད་པར་སྨྲས་པ་དང་།",
    "དོན་དམ་པར་ནང་གི་སྐྱེ་མཆེད་རྣམས་བདག་ལས་སྐྱེ་བ་མེད་པར་ངེས་ཏེ།",
    "ཐལ་འགྱུར་གྱི་གཏན་ཚིགས་དང་དཔེ་མ་བརྗོད་པ་དང་དེ་ལ་གཞན་གྱིས་སྨྲས་པའི་ཉེས་པ་མ་བསལ་བའི་སྐྱོན་མི་འཇུག་པར་བསྟན་པ་གཉིས་ལས།",
    "སླར་སྐྱེ་བ་ལ་དོན་མེད་དང་ཐུག་མེད་དུ་ཐལ།",
    "རང་གི་ངོ་བོ་ཡོད་པའི་ཕྱིར།",
    "བདག་ལས་སྐྱེ་བ་མེད་པར་ཐལ།",
    "སྐྱེ་བ་དོན་ཡོད་དང་ཐུག་པ་དང་བཅས་པ་གང་ཞིག་རང་གི་བདག་ཉིད་དུ་ཡོད་པ་སྐྱེས་ན་ཐུག་མེད་དང་དོན་མེད་ཐལ་བའི་ཕྱིར།",
    "ཐལ་འགྱུར་ཡིན་ལ།",
    "མྱུ་གུ་རང་གི་བདག་ཉིད་དུ་ཡོད་པ་སླར་སྐྱེ་བར་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "དེ་ལ་གཞན་གྱིས་སྨྲས་པའི་སྐྱོན་ནི་གཞན་གྲངས་ཅན་པས་ཅི་རང་གི་བདག་ཉིད་དུ་ཡོད་པའི་ཕྱིར།",
    "ཡོད་ན་མི་སྐྱེ་བའི་ཁྱབ་པ་དཔེ་མངོན་གསལ་གྱི་བུམ་པའི་སྟེང་དུ་གྲངས་ཅན་པ་རང་གི་ཁས་བླངས་པས་འགལ་རྟགས་སུ་ག་ལ་འགྱུར།",
    "ཐལ་རང་གཉིས་ཀྱི་ཁྱད་པར་གཙོ་བོ་མཚན་ཉིད་ཀྱི་སྒོ་ནས་འཇོག་སྟེ།",
    "ཡན་ལག་གི་ཁྱད་པར་ལ།",
    "རང་བཞིན་མེད་སྒྲུབ་ཀྱི་གཏན་ཚིགས་ཐལ་རང་དུ་འགོད་ཚུལ།",
    "རང་གི་ཐུན་མིན་ཁས་ལེན་ཀུན་བྲལ་གྱི་ལྟ་བ་གཏན་ལ་འབེབས་པའི་སྐབས་ཡིན་པའི་ཕྱིར།",
    "ཐ་སྙད་དེ་ཡང་འཇིག་རྟེན་གྲགས་པ་ལྟར་དུ་ཁས་ལེན་པ་ཙམ་མོ།",
    "ཐལ་འགྱུར་ཙམ་གྱིས་ཕྱིར་རྒོལ་གྱི་རྒྱུད་ལ་བསྒྲུབ་བྱ་རྟོགས་པའི་རྗེས་དཔག་སྐྱེ་བར་འདོད་པ་ཐལ་འགྱུར་བའོ།",
    "དགག་བྱ་ལ་ཁྱད་པར་མ་མཛད་པར་བདག་ལས་མ་ཡིན་གཞན་ལས་མིན་ཞེས་སྤྱིར་བདེན་པ་གཉིས་ཆར་དུ་སྐྱེ་བ་བཀག་པ་ཐལ་འགྱུར་བའོ།",
    "དང་པོ་ལ་སྐྱེ་བ་དོན་མེད་དུ་ཐལ་བས་དགག་པ།",
    "འབྲས་བུ་སྐྱེ་བ་སྐབས་མི་ཐོབ་པར་ཐལ་བས་དགག་པ།",
    "ས་བོན་ཐུག་མེད་དུ་སྐྱེ་བར་ཐལ་བས་དགག་པ་བཞི་ལས།",
    "འབྲས་བུ་རྣམས་རྒྱུའི་རང་བཞིན་འགའ་ཞིག་གི་རྗེས་སུ་བྱེད་པའི་ཕྱིར་དང་།",
    "ནུས་པ་འགའ་ཞིག་གི་རྗེས་སུ་བྱེད་པའི་ཕྱིར་དང་།",
    "ས་བོན་གྱི་དུས་ན་རང་གི་ངོ་བོ་རྫོགས་པར་གྲུབ་ཟིན་པའི་ཕྱིར།",
    "འང་གི་སྒྲ་ནི་སྔ་མ་སྐྱེ་བ་དོན་མེད་དུ་འགྱུར་བ་མ་ཟད་ཅེས་པའི་དོན་ནོ།",
    "ཞེས་ཞིང་གི་སྒྲས་སྐྱོན་དེ་ཉིད་དང་ད་དུང་དེ་མ་ཐག་ཏུ་འཆད་འགྱུར་གྱི་སྐྱོན་ཡོད་པར་སྟོན་པའོ།",
    "གཞན་ཡང་ཁྱོད་ཀྱི་ལུགས་ལ་ས་བོན་འདི་ནི་སྲིད་པའི་མཐར་ཐུག་པའི་བར་དུ་ཐུག་མེད་དུ་རབ་ཏུ་སྐྱེ་བར་ཐལ་བའི་སྐྱོན་ཉིད་དུ་འགྱུར་ཏེ།",
    "རྒྱུ་འབྲས་ངོ་བོ་གཅིག་ན་གནས་སྐབས་ཐ་དད་མི་དམིགས་པར་ཐལ་བས་དགག་པ་དང་།",
    "གནས་སྐབས་ཐ་དད་པར་དམིགས་ན་རྒྱུ་འབྲས་ངོ་བོ་མི་གཅིག་པར་ཐལ་བས་དགག་པ་གཉིས་ལས།",
    "དེས་ན་དབྱིབས་སོགས་ཐ་དད་མེད་པར་ཐལ་བས་དགག་པ་གཉིས།",
    "ཇི་ལྟར་ས་བོན་དང་མྱུ་གུ་དག་གཞན་མ་ཡིན་པར་རྣམ་པ་ཐམས་ཅད་པར་རང་བཞིན་གཅིག་ཡིན་ན་འབྲས་བུ་མྱུ་གུ་དེ་ཉིད་ཀྱིས་ས་བོན་དེ་ཚུལ་ཇི་ལྟར་ན་རྣམ་པར་འཇིག་པར་བྱེད་པར་འགྱུར་ཏེ་མི་འགྱུར་བར་ཐལ།",
    "དེ་ལྟར་འཐད་ན་གནས་སྐབས་གཉིས་སུ་གཉིས་ཀ་འཛིན་མི་འཛིན་མི་མཚུངས་པར་ཐལ་བས་དགག་པ་གཉིས།",
    "གི་སྔར་གྱི་ངོ་བོ་ཡོངས་བཏང་ནས།",
    "གལ་ཏེ་ཟློས་གར་མཁན་གྱི་སྐྱེས་བུ་གཅིག་ཉིད་སེར་པོའི་ཆ་བྱད་བཏང་ནས་སྔོན་པོའི་ཆ་བྱད་ལེན་པ་ལ་འཇུག་པ་བཞིན་ས་བོན་རང་གི་སྔར་གྱི་གནས་སྐབས་ཀྱི་ངོ་བོ་ཡོངས་སུ་བཏང་ནས་གཞན་མྱུ་གུའི་གནས་སྐབས་ཀྱི་ངོ་བོར་འགྱུར་བར་འདོད་ན།",
    "དབྱིབས་དང་ཁ་དོག་སོགས་མ་བཟུང་ན་ས་མྱུག་དེ་དག་གི་རྫས་མ་བཟུང་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་ལུགས་ལ་ས་བོན་དང་ནི་མྱུ་གུ་གཉིས་ལ་དཔྱད་དེ་རྣམ་བཞག་བྱེད་པའི་སྐབས་འདིར་དེ་གཉིས་རང་བཞིན་གྱི་ངོ་བོ་གཞན་མ་ཡིན་པར་གཅིག་ཏུ་གྲུབ་པར་སྨྲ་ན།",
    "དོན་དམ་པར་མ་ཟད་འཇིག་རྟེན་ཐ་སྙད་དུ་ཡང་བདག་ལས་སྐྱེ་བ་མི་འཐད་པ་དེའི་ཕྱིར་ཕྱི་ནང་གི་དངོས་པོ་རྣམས་བདག་རང་ལས་བདག་ཉིད་འབྱུང་ངོ་ཞེས་གྲངས་ཅན་པ་ཁྱོད་ཀྱིས་རབ་ཏུ་བཏགས་པ་འདི་ནི།",
    "ཕྱི་ནང་གི་དངོས་པོ་རྣམས་བདག་ལས་སྐྱེས་པར་འདོད་ན་བསྐྱེད་པར་བྱ་བའི་འབྲས་བུ་དང་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་གཉིས་གཅིག་ཏུ་འགྱུར་བ་དང་།",
    "མིག་དང་མིག་གི་རྣམ་པར་ཤེས་པ་དག་ཀྱང་གཅིག་ཉིད་དུ་ཐལ་བའི་སྐྱོན་ཡོད་པས་སོ།",
    "ཧ་ཅང་ཐལ་བས་དགག་པ།",
    "སྐྱོན་སྤོང་གི་ལན་དགག་པ་གཉིས།",
    "ཀུན་ལས་ཐམས་ཅད་སྐྱེ་བར་འགྱུར་ཏེ་གང་གི་ཕྱིར།",
    "དེ་ལ་བྱེ་སྨྲ་ན་རེ།",
    "དེ་ནི་གཞན་ལ་གྲགས་པའི་རྗེས་དཔག་གི་རིགས་པ་སྟེ།",
    "དེར་མ་ཟད་རྒྱུ་ཡིན་མིན་ཀུན་ལས་ཀྱང་འབྲས་བུ་ཡིན་མིན་ཐམས་ཅད་སྐྱེ་བར་འགྱུར་བར་ཐལ་ཏེ།",
    "དེ་ལྟར་ན་གྲུབ་ཟིན་གཞན་ལས་གྲུབ་ཟིན་གཞན་འབྱུང་ན་དེ་གཉིས་ལ་འབྲེལ་བ་མི་དགོས་པས་གཞན་ཡིན་ཚད་ལས་གཞན་ཡིན་ཚད་སྐྱེ་བར་ཐལ་བས་ལུགས་འདིར་ནི་གཞན་སྐྱེ་ཐ་སྙད་དུའང་མི་བཞེད་དེ།",
    "གཉིས་པ་སྐྱོན་སྤོང་གི་ལན་དང་།",
    "གཞན་ཡིན་པར་མཚུངས་ཀྱང་འབྲས་བུ་གང་ཞིག་རྒྱུ་གང་གིས་རབ་ཏུ་བྱ་བར་ནུས་པའམ་བསྐྱེད་པར་བྱ་ནུས་པ་དེའི་ཕྱིར་དེ་ལ་ནི་འབྲས་བུར་ངེས་པར་བརྗོད་ཅིང་།",
    "རྒྱུ་གང་ཞིག་གིས་འབྲས་བུ་དེ་སྐྱེད་པར་བྱེད་པའི་ནུས་པ་ཡོད་པ་དེ་ནི་འབྲས་བུ་ལས་གཞན་ཡིན་ནའང་དེའི་རྒྱུ་ཡིན་ལ།",
    "ཁྱོད་ཀྱིས་སཱ་ལུའི་མྱུ་གུ་སྐྱེད་བྱེད་དུ་འདོད་པའི་གཞན་ཁྱད་པར་ཅན་སཱ་ལུའི་ས་བོན་ཉིད་ཀྱང་།",
    "སྐྱོན་སྤང་གི་ལན་དགག་པ་གཉིས།",
    "འདི་ལྟར་བྱམས་པ་དང་ཉེ་སྦས་གཉིས་ལྟ་བུ་དུས་གཅིག་ཏུ་ཡོད་བཞིན་པ་དག་ཕན་ཚུན་ལྟོས་ནས་གཞན་ཉིད་དུ་མཐོང་གི།",
    "ཐལ་འགྱུར་པས་ས་བོན་གྱི་ཚེ་མྱུ་གུ་དང་མྱུ་གུའི་ཚེ་ས་བོན་མ་གྲུབ་པས་ས་མྱུག་གཞན་དུ་འདོད་པ་འགལ་བས།",
    "ཇི་ལྟར་སྲང་གི་མདའ་གཉིས་མཐོ་དང་དམའ་བ་དག།",
    "བསྐྱེད་བྱ་སྐྱེད་བྱེད་དག་གི་སྐྱེ་འགག་འགྱུར་ཞེ་ན།",
    "དཔེ་ཇི་ལྟར་ན་སྲང་གི་མགོ་མཇུག་གི་མདའ་གཉིས་མཐོ་བ་དང་ནི་དམའ་བ་དག་དུས་མཉམ་མ་ཡིན་པ་ནི་མིན་པར་ཏེ་དུས་གཅིག་ཏུ་མཐོ་དམའ་བྱེད་པར་མངོན་སུམ་གྱིས་མཐོང་བ་དེ་བཞིན་དུ།",
    "གལ་ཏེ་སྲང་གི་མདའི་མཐོ་དམའ་ནི་དུས་གཅིག་གི་ཚེ་གྲུབ་ཐུབ་པ་ཡིན་ན།",
    "དོན་གྱི་སྐབས་འདིར་ནི་རྒྱུ་འབྲས་སྐྱེ་འགག་གི་བྱ་བ་དུས་མཉམ་དུ་ཡིན་ཆུག་ཀྱང་རྒྱུ་འབྲས་གཉིས་དུས་གཅིག་ཏུ་གྲུབ་པ་ནི་མེད་དེ།",
    "སྲང་མདའི་མཐོ་དམན་གྱི་ཚུལ་གྱིས་སྐད་ཅིག་གཅིག་ཁོ་ན་ལ་ས་བོན་འགག་པ་དེ་ཉིད་ལ་མྱུ་གུ་སྐྱེའོ་ཞེས་སྲང་གི་དཔེ་ཉེ་བར་བཀོད་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "ཉེ་བར་བཀོད་པ་ནི་བདེན་མོད་ཀྱི།",
    "ཁྱོད་ཀྱིས་སྐྱེ་བ་ཐམས་ཅད་ནི།",
    "མིག་གི་བློ་ལ་རང་གི་སྐྱེད་བྱེད་དུས་གཅིག་པ།",
    "དེ་ལ་རེ་ཞིག་བསྐྱེད་བྱ་སྐྱེས་ཟིན་ནས་ཡོད་པ་ཡིན་ན་དེ་ལ་སྐྱེད་བྱེད་ཅི་དགོས་ཏེ་སྔར་བདག་སྐྱེ་དགག་པའི་སྐབས་སྐྱེས་ཟིན་སླར་ཡང་སྐྱེ་བར་རིགས་མ་ཡིན།",
    "རི་བོང་གི་རྭ་ལྟར་མེད་པའི་ཕྱིར་རོ།",
    "ཡོད་མེད་གཉིས་ཀ་ནི་དུས་གཅིག་ཏུ་རྒྱུ་གཅིག་གི་འབྲས་བུར་འདུ་བ་མེད་པའི་ཕྱིར་རོ།",
    "གཞན་སྐྱེ་བསྒྲུབ་པའི་དོན་དུ་རིགས་པ་གང་དང་གང་སྨྲས་པ་ཐམས་ཅད་བུད་ཤིང་སྐམ་པོ་མར་གྱིས་བྲན་པ་མེས་བསྲེགས་པ་ལྟར།",
    "ཁྱོད་ཀྱི་གཞན་སྐྱེ་འགོག་པའི་བློ་གྲོས་ཀྱི་མེས་སྲེག་པར་བྱེད་པས་ཁྱོད་ཀྱི་ཤེས་རབ་ཀྱི་མེ་སྤོར་བར་བྱེད་པ་ལྷུར་ལེན་པའི་རིགས་པའི་བུད་ཤིང་བསྐུལ་བར་འགྱུར་བས་དེ་ཙམ་གྱིས་ཆོག་གོ།",
    "སུ་མི་འབྲང་བར་རང་གི་ལྟ་བ་ཁོ་ན་ལ་གནས་ནས་བླང་དོར་ལ་འཇུག་ལྡོག་བྱེད་ཅིང་།",
    "དེ་དག་གི་ཕྱིར་ན་ཡུལ་གང་ལ་འཇིག་རྟེན་གྱིས་གནོད་པ་དང་མི་གནོད་པའི་ཁྱད་པར་བསྟན་པས་མཇུག་བསྡུ་བ་དང་གསུམ་ལས།",
    "ཁྱོད་ཐོ་བས་བཅོམ་ན་རང་འཛིན་གྱི་བློ་འདོར་དུ་རུང་བ་ཡིན་པའི་ཕྱིར།",
    "མཚན་གཞི་ནི་ཆ་མེད་གཉིས་དང་གཟུགས་དང་ཚོར་བ་སེམས་སེམས་བྱུང་རང་སྐྱ་བ་རྣམས་སོ།",
    "དེ་དག་གི་རྣམ་གཞག་འཇོག་ཚུལ་ནི་ཆེས་མི་འདྲ་སྟེ།",
    "རིགས་པའི་རྗེས་འབྲང་གི་འདོད་ཚུལ་ནི།",
    "རང་གི་སྣང་ཡུལ་ལ་མ་འཁྲུལ་པའི་ཤེས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཁྱོད་དོན་ཡང་ཡིན།",
    "དེས་ན་ཐལ་རང་གཉིས་ཀས་ཁྱད་མེད་པ་ཀུན་རྫོབ་ལའང་ཡང་ལོག་གཉིས་སུ་ཁྱད་པར་མཛད་དོ།",
    "ཡུལ་ཡང་ལོག་གི་ཁྱད་པར་སྤྱིར་བསྟན་པ་དང་།",
    "བདེན་པ་གཉིས་ཀྱི་དོན་ལ་རྨོངས་པའི་མི་ཤེས་པའི་གཉིད་མཐུག་པོས་རབ་ཏུ་བསྐྱོད་པའི་མུ་སྟེགས་ཅན་རྣམས་ཀྱིས་རང་གི་གཞུང་ལུགས་དག་ཏུ་ཡོན་ཏན་གསུམ་གྱི་བདག་ཉིད་གཙོ་བོ་ལ་སོགས་པ་ཇི་བཞིན་བརྟགས་པ་སྟེ།",
    "འཇིག་རྟེན་པ་དག་དེ་དག་གི་སྒོ་ནས་ཐ་སྙད་བྱེད་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ནི་དཔེར་ན་ཤིང་ལ་འཛེག་པར་འདོད་པ་གང་དག་ཡལ་ག་སྔ་མར་རྐང་ལག་གིས་མ་བརྟེན་པར་བཏང་ནས་ཕྱི་མར་བཟུང་ཐབས་མེད་པར་གཡང་ས་ལ་ལྷུང་བ་ལྟར།",
    "བ་འཕགས་པ་རྣམས་ཀྱི་གཟིགས་པ་ཁས་བླངས་ནས་ཡིན་ནོ།",
    "གཟིགས་པ་དྲི་མ་མེད་པའི་བློའམ་ཡེ་ཤེས་ཀྱི་ཡུལ་སྐྱེ་མེད་སོགས་ལ་གནོད་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ན་གཞན་སྐྱེ་དགག་པ་ལ་འཇིག་རྟེན་གྱིས་གནོད་པ་སྟོན་པ་ནི་དམ་པ་དག་གིས་བཞད་གད་དུ་བྱ་བའི་གནས་འོས་སོ།",
    "དེ་ནི་དངོས་པོ་རང་གི་ངོ་བོར་ཡོད་པ་མ་ཡིན་པ་སྤྲོས་མཐའ་གང་རུང་དུ་སྒྲོ་འདོགས་པར་བྱེད་པ་དངོས་པོའི་རང་བཞིན་མཐོང་བ་ལ་འགེབས་པའམ་སྒྲིབ་པའི་བདག་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་ན་རྐྱེན་དེས་བཅོས་མ་ལ་ནི་ཀུན་རྫོབ་བམ་ཀུན་འགེབ་ཅེས་བྱ་སྟེ།",
    "ཉན་རང་དགྲ་བཅོམ་དང་དག་ས་ལ་གནས་པའི་བྱང་སེམས་ཀྱི་རྗེས་ཐོབ་ལ་ལྟོས་ནས་ཀུན་རྫོབ་ཙམ་དུ་བཞག་གི་འཇིག་རྟེན་ཀུན་རྫོབ་བདེན་པར་མི་བཞག་སྟེ།",
    "འཇིག་རྟེན་རང་གི་དོན་ལ་འཇིག་རྟེན་གྱིས་གནོད་ཚུལ་དང་གཉིས་ལས།",
    "དེ་ཁོ་ན་ཉིད་འཕགས་པའི་གཟིགས་པ་ཇི་ལྟ་བ་གཏན་ལ་འབེབས་པའི་སྐབས་སུ་གཞན་སྐྱེ་བཀག་པས་འཇིག་རྟེན་པའི་བླ་རྡོལ་གྱི་སྨྲ་བ་སྣ་ཚོགས་ཇི་ལྟར་བརྗོད་ཀྱང་གནོད་པ་མེད་པ་ནི་ནམ་མཁའ་ལ་མཚོན་གྱིས་གཅོད་དུ་མེད་པ་ལྟ་བུའོ།",
    "རིགས་པའི་དཔྱད་པ་ཞིབ་མོར་ཁས་མི་ལེན་པའི་ཕྱིར་རོ།",
    "བདག་གིས་བུ་འདི་བསྐྱེད་ཅེས་སྨྲ་བྱེད་ཅིང་།",
    "དེས་ན་འདིས་རྒྱུ་འབྲས་གཉིས་ཀ་མཐའ་གཅིག་ཏུ་གྲུབ་པའི་གཞན་ཡིན་པ་བཀག་གི།",
    "གང་གི་ཕྱིར་ན་གལ་ཏེ་མྱུ་གུ་ས་བོན་ལས་གཞན་ཡིན་ན་ནི།",
    "མྱུ་གུ་སྐྱེས་པའི་ཚེ་ས་བོན་རང་གི་ངོ་བོ་གྲུབ་པ་ཞིག་ནི་ཡོད་པ་མིན་ཏེ།",
    "དེས་ན་ཐལ་འགྱུར་ཐུན་མིན་གྱི་གཞུང་འདིར་ཐ་སྙད་དུའང་འབྲས་བུ་རང་གིས་དུས་ན་རང་གི་རྒྱུ་དེ་ཡོད་མེད་གཉིས་དང་ཞིག་མ་ཞིག་གཉིས་སོགས་གང་དུ་ཡང་ཁས་མི་ལེན་ཏེ།",
    "འཕགས་པའི་མཉམ་གཞག་དངོས་པོའི་འཇིག་རྒྱུར་ཐལ་བས་དགག་པ།",
    "དོན་དམ་པས་སྐྱེ་བ་མི་ཁེགས་པར་ཐལ་བས་དགག་པ་གསུམ་ལས།",
    "གལ་ཏེ་རང་གི་མཚན་ཉིད་བརྟེན་འབྱུང་ན།",
    "རིགས་པའི་རྒྱལ་པོ་རྣམ་པ་གསུམ་འདི་ནི་ཐལ་འགྱུར་བའི་ཐུན་མོང་མ་ཡིན་པའི་ཆེ་བ་སྟོན་བྱེད་དེ།",
    "འཕགས་པའི་མཉམ་གཞག་ཡེ་ཤེས་ཉིད་ཀྱིས་མ་མཐོང་བའི་མཐོང་བ་ཆེན་པོའི་ཚུལ་དུ་ཇི་ལྟར་གཟིགས་པ་རྣམ་གྲངས་མིན་པའི་དོན་དམ་པའི་བདེན་པ་སྣང་སྟོང་ཟུང་འཇུག་མཉམ་པ་ཆེན་པོ་སྤྲོས་མཐའ་ཀུན་བྲལ་གྱི་དབྱིངས་དེ་ཉིད་རིགས་པ་འདི་གསུམ་གྱིས་ཇི་བཞིན་དུ་གཏན་ལ་འབེབས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་དང་པོར་བདེན་གཉིས་སོ་སོར་ཞེན་པའི་ཆ་དེ་ཙམ་ཡང་ཐལ་འགྱུར་བ་ལ་མེད་པའི་ཕྱིར་ན།",
    "རང་རྒྱུད་པའི་ཀུན་རྫོབ་རང་མཚན་གྱིས་གྲུབ་པའི་གཞུང་འཆད་ལུགས་དང་དེ་འདྲའི་བདེན་གཉིས་ལ་སྟོང་མི་སྟོང་གི་ཁྱད་པར་གྱི་ཞེན་ཆ་ཕྲ་མོ་དེ་ཉིད།",
    "ཐལ་འགྱུར་བའི་ལུགས་ཞལ་གྱིས་བཞེས་པའི་ཐུན་མོང་མ་ཡིན་པའི་རིགས་པའི་དགག་བྱར་གྲུབ་ལ།",
    "ཆེན་པོའི་རྟོགས་རིགས་དེ་ཉིད་ཐུགས་ལ་འཁྲུངས་དགོས་པས་ཁྱབ་པའི་ཕྱིར་ན་ཐལ་འགྱུར་བའི་ཐུན་མིན་གྱི་རིགས་པའི་དགག་བྱར་གྲུབ་བོ།",
    "གཞུང་གོང་འོག་གི་རིགས་པ་སྤྱི་དང་།",
    "དེ་ལྟར་ཐལ་འགྱུར་ཆེན་པོའི་ཐུན་མིན་གྱི་རིགས་པ་འདི་དག་གིས་ནི།",
    "གལ་ཏེ་གཟུགས་དང་ཚོར་བ་ལ་སོགས་རྣམས་བློས་བཏགས་པ་ཙམ་མ་ཡིན་པར་རང་གི་མཚན་ཉིད་ཀྱིས་རྒྱུ་དང་རྐྱེན་ལ་བརྟེན་ནས་འབྱུང་ན།",
    "དེའི་ཕྱིར་དངོས་པོ་རྣམས་རང་གི་མཚན་ཉིད་ཀྱིས་སྐྱེ་བ་ཡོད་པ་མིན་ནོ།",
    "དེ་ལ་གལ་ཏེ་དོན་དམ་པར་སྐྱེ་བ་མེད་པས་བདག་དང་གཞན་ལས་སྐྱེ་བ་དགག་ལ་རག་མོད།",
    "འདི་ནི་ཤིན་ཏུ་བདེན་མོད་ཀྱི་དོན་དམ་པར་ན་བདེན་པ་གཉིས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་ཕྱི་ནང་གི་དངོས་པོ་འདི་དག་ཅི་བདག་ལས་སྐྱེ་བ་ཞིག་གམ།",
    "དེ་ཉིད་སྐབས་སུ་རིགས་པ་གང་ཞིག་གིས།",
    "ཁྱོད་ཀྱི་སྐྱེ་བ་གང་གིས་ཡིན་པར་འགྱུར།",
    "དེས་ན་རང་རྒྱུད་པ་ཁྱོད་བདེན་པ་གཉིས་ཆར་དུ་སྐྱེ་བ་མེད་པའི་ཡེ་ནས་སྐྱེ་མེད་ཀྱི་དོན་འདི་མི་འདོད་བཞིན་དུ་ཡང་གདོན་མི་ཟ་བར་ཁས་བླང་བར་བྱའོ།",
    "ཐ་སྙད་ཀུན་རྫོབ་ཙམ་དུ་རང་རང་གི་རྒྱུ་རྐྱེན་ལས་སྐྱེ་བའི་སྐྱེ་སོགས་རང་མཚན་གྱིས་གྲུབ་ཅིང་།",
    "ཐ་སྙད་དུ་ཆུ་རླན་གཤེར་མེ་ཚ་བསྲེག་ཙམ་གྱི་རང་མཚན་གྱི་ཆ་དེ་ཐ་སྙད་རང་ངོས་ནས་སྟོང་པ་མིན་ན་འཕགས་པའི་མཉམ་གཞག་དངོས་པོའི་འཇིག་རྒྱུར་ཐལ་བ་དང་།",
    "དོན་དམ་དཔྱོད་པས་དཔྱད་ཀྱང་ཐ་སྙད་ཀྱི་རང་མཚན་མི་སྟོང་ན་ཐ་སྙད་བདེན་པ་རིགས་པའི་དཔྱད་བཟོད་དུ་ཐལ་ལ།",
    "དོན་དམ་པར་སྐྱེ་བ་མེད་ཀྱང་ཐ་སྙད་ཀྱི་སྐྱེ་བའི་རང་མཚན་ཡོད་ན་དོན་དམ་པས་སྐྱེ་བ་མི་ཁེགས་པའི་ཐལ་བ་སྟེ།",
    "འཇིག་རྟེན་རང་གི་མཐོང་བ་ལ་ཡང་དངོས་པོ་རང་མཚན་གྱིས་གྲུབ་པ་ལྟར་དུ་སྣང་བ་ཡོད་ཀྱང་དོན་ལ་མ་གྲུབ་པར་སྟོང་པ་ནི་གཟུགས་བརྙན་དང་སྒྲ་བརྙན་སྒྱུ་མའི་རྟ་གླང་ལ་སོགས་པ་རང་རང་སྣང་བའི་རྒྱུ་རྐྱེན་གྱི་ཚོགས་པ་ཙམ་ལ་ལྟོས་ཏེ་རྫུན་པའི་སྣང་བ་སྣ་ཚོགས་པ་རྣམས་རྫུན་ཞིང་དོན་གྱིས་སྟོང་པ་ཡིན་པར་མ་གྲགས་པ་ཡང་མིན་པར་འཇིག་རྟེན་སྤྱི་ལ་གྲགས་པ་ཡིན་ལ།",
    "དཔེ་དེ་བཞིན་དུ་གཟུགས་དང་ཚོར་བ་སོགས་ཕྱི་ནང་གི་དངོས་པོ་ཐམས་ཅད་རང་བཞིན་མ་གྲུབ་པའི་སྟོང་པ་ཡིན་ན་ཡང་།",
    "གང་སྟོང་ན་སྣང་མི་ཤེས་པ་ལྟ་བུ་མ་ཡིན་པ་ངོ་བོ་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཀྱི་རྒྱུ་རྐྱེན་དག་ལས་དེར་སྣང་གི་ཤེས་པ་ཐམས་ཅད་ཀྱང་རབ་ཏུ་སྐྱེ་བར་འགྱུར་རོ།",
    "གང་ལྟར་སྣང་ཡང་སྣང་དུས་ཉིད་ནས་རང་གི་ངོ་བོས་མ་གྲུབ་པ་སྟོང་པའི་ཕྱིར་དང་དེ་དག་ཆད་པ་ཡང་མིན་ཏེ་རང་གི་ངོ་བོ་སྟོང་བཞིན་དུ་སྣང་བའི་འཆར་སྒོ་མ་འགག་པའི་ཕྱིར་རོ།",
    "ཟུར་ན་གནས་པ་འགའ་ཞིག་གིས་ལས་བྱས་མ་ཐག་ཏུ་འགག་གམ་མི་འགགས།",
    "མཐོང་གི་དངོས་གཞན་རྣམ་པར་མ་ཡིན་ལྟར།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སོ་སོའི་སྐྱེ་བོ་རྟོག་གེའི་དཔྱད་པ་ཞིབ་མོ་བྱས་ནས་ལས་འབྲས་ཀྱི་འཐད་པ་ཚོལ་བ་རྣམས་ཀྱིས་འཐད་པ་མ་རྙེད་ནས་ལས་འབྲས་ལ་སྐུར་བ་བཏབ་པས་ཀུན་རྫོབ་འཇིག་པར་བྱེད་པར་དགོངས་ནས།",
    "དེ་དག་གི་དཔེ་བསྟན་པ་གཉིས་ལས།",
    "དེ་ལྟར་ཀུན་གཞི་སོགས་ཡོད་ཅེས་གསུངས་པ་དེ་ནི་ཐོག་མ་མེད་པ་ནས་མུ་སྟེགས་ཀྱི་ལྟ་བ་ལ་གོམས་པས་གོང་དུ་བསྟན་པ་དེ་ལྟར་ཆེས་ཟབ་མོ་སྟོང་པ་ཉིད་ཀྱི་དོན་རིག་ཅིང་རྟོགས་པར་མི་འགྱུར་བའི་གདུལ་བྱ་གང་ཡིན་པ་དེ་ལ་བསྟན་པའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་བྱང་ཀུན་གྱི་ས་བོན་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་རང་གི་ངོ་བོ་གཟུང་འཛིན་གཉིས་དང་བྲལ་བ་རྒྱ་མཚོ་ལྟ་བུ་ལ།",
    "ཕྱི་རོལ་མེད་པའི་ཤེས་པ་རང་གི་ངོ་བོ་དགག་པ་དང་།",
    "ཡོད་མིན་དེ་ཚེ་ཁྱོད་ཀྱི་དཔེ་ཡོད་མིན།",
    "ཇི་ལྟར་ཁྱོད་ཀྱིས་ངས་མཐོང་སྙམ་དྲན་པ།",
    "ཁྱོད་ཀྱི་ཞེ་འདོད་དེ་ལ་དྲང་པོའི་བློས་ཚུལ་བཞིན་དུ་འཐད་དམ་མི་འཐད་བསམ་པར་བྱ་སྟེ།",
    "དེའི་ཚེ་ན་རྣམ་རིག་པ་ཁྱོད་ཀྱིས་བཀོད་པའི་རྨི་ལམ་ནི་ཤེས་པ་བདེན་པ་བསྒྲུབ་པའི་དཔེ་ཉིད་དུ་འུ་བུ་གཉིས་ལ་མཐུན་པར་གྲུབ་པ་ཡོད་པ་མིན་ནོ།",
    "ཇི་ལྟར་ཁྱོད་ཀྱི་ཕྱི་ཡུལ་རྨི་ལམ་དུ།",
    "མིག་དང་མིག་གི་ཡུལ་དང་དེས་བསྐྱེད་སེམས།",
    "ཇི་ལྟར་རྨི་ལམ་གྱི་གནས་སྐབས་དེར་མིག་དང་མིག་གི་ཡུལ་གཟུགས་དང་གཉིས་རང་བཞིན་གྱིས་མེད་པ་དེ་བཞིན་དུ་དེས་བསྐྱེད་པའི་སེམས་མིག་གི་རྣམ་པར་ཤེས་པའང་མེད་པས་གསུམ་པོ་ཐམས་ཅད་ཀྱང་ནི་རྫུན་པ་འབའ་ཞིག་ཡིན་ཏེ།",
    "ཐལ་འགྱུར་ཆེན་པོའི་ལུགས་འདིར་རྨི་ལམ་གྱི་ཁམས་བཅོ་བརྒྱད་པོ་ཐམས་ཅད་འཇིག་རྟེན་ཉིད་ལ་ལྟོས་པའི་ལོག་པའི་ཀུན་རྫོབ་ཡིན་པས་འཇིག་རྟེན་གྱི་ཐ་སྙད་ལའང་མེད་ཞེས་པའི་བརྡ་འདོགས་ན་དོན་དམ་པར་སྨོས་མ་དགོས་པར་ཤེས་སོ།",
    "སྐྲ་ཤད་དེའི་ཡུལ་འཁར་གཞོང་ལྟ་བུ་དང་གང་གི་མིག་ནི་རྗེས་སུ་འབྲེལ་བའི་ཚེ་ན།",
    "རབ་རིབ་ཀྱི་སྐྱོན་མེད་པ་དག་པའི་མིག་ལའང་སྐྲ་ཤད་དུ་སྣང་བའི་བློར་འགྱུར་བར་ཐལ་ཏེ།",
    "རང་གི་བག་ཆགས་ཡོངས་སུ་སྨིན་པ་དང་མི་སྨིན་པ་ལས་ཡིན་ནོ།",
    "སྐྱོན་སྤང་གི་ལན་དགག་པ་གཉིས།",
    "མོ་གཤམ་བུ་ལའང་དེ་ནི་ཡོད་པར་ཐལ།",
    "དེ་ནི་རྣམ་པར་ཤེས་པའམ་རྣམ་པར་ཤེས་པ་མིན་ཞེས་དགག་སྒྲུབ་གང་གིའང་ངོ་བོས་བསྟན་བྱའི་གཞི་མ་གྲུབ་པས་བསྟན་མི་ནུས་སོ།",
    "གལ་ཏེ་མ་སྐྱེས་པ་ལའང་ནུས་པ་ཡོད་པར་འདོད་ན་མོ་གཤམ་གྱི་བུ་ལའང་ནུས་པ་དེ་ནི་ཡོད་པར་ཐལ་ཏེ།",
    "རྒྱུ་ཉིད་དུ་ནི་ཐལ་བར་འགྱུར།",
    "དེའི་ཉེས་སྤོང་གི་ལན་དགག་པ་གཉིས།",
    "གང་གི་ཕྱིར་ན་ཆུ་ཀླུང་གི་རྒྱུན་ལྟར་སྐད་ཅིག་སྔ་ཕྱིའི་རིམ་པར་མ་ཆད་པར་འཇུག་པའི་རྒྱུན་དང་ལྡན་པ་ཅན་སྐད་ཅིག་སྔ་ཕྱི་རྣམས་སྐབས་དེར་ཕན་ཚུན་རྫས་ཐ་དད་དུ་ཡོད་པར་རྒོལ་བ་རང་གིས་ཁས་བླངས་པས།",
    "དེ་ལྟར་ན་ཡང་རྒྱུན་འདི་ནི་གཅིག་པ་ཁོ་ན་ཡིན་པས་དེ་དག་ལ་རྒྱུན་ཐ་དད་པ་མེད་པ་དེའི་ཕྱིར་ན་ཐམས་ཅད་ལས་ཐམས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བར་མི་འགྱུར་བས་ཉེས་པ་མེད་དོ་ཅེ་ན།",
    "མེད་པར་རང་གི་ས་བོན་ལས།",
    "ཞིང་གི་སྒྲ་ནི་དེ་མ་ཟད་བདག་རྐྱེན་དང་དམིགས་རྐྱེན་ཡང་ཤེས་པ་ལས་གཞན་མེད་ཅེས་སྡུད་པའོ།",
    "ཕྱི་རོལ་མེད་པར་ཤེས་པ་ཁོ་ན་དོན་སྣང་གི་རྣམ་པར་སྐྱེ་ན་སད་དུས་སུ་ལོང་བ་ལ་གཟུགས་སྣང་བར་ཐལ་བས་དགག་པ།",
    "སད་དུས་སུ་ནུས་པ་མ་སྨིན་པར་འདོད་ན་རྨི་ལམ་གྱི་ཚེ་ཡང་གཟུགས་སྣང་མི་སྐྱེ་བར་ཐལ་བས་དགག་པ།",
    "གལ་ཏེ་ཁྱོད་ལྟར་རྨི་ལམ་དྲུག་པ་ཡི།",
    "གལ་ཏེ་ཁྱོད་ལྟར་ན་རིགས་པ་མེད་པར་ཚིག་གི་ཚུལ་ཙམ་ཁོ་ནས་རྨི་ལམ་གྱི་ཚེ་གཉིད་ཀྱི་རྐྱེན་གྱིས་དྲུག་པ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡི་ནུས་པ་སྨིན་པ་ཡོད་པར་འདོད་ལ།",
    "གང་གི་ཕྱིར་ན་ཕྱི་རོལ་མེད་པར་ཤེས་པ་ཁོ་ནར་དོན་སྣང་གི་རྣམ་པར་སྐྱེ་ན་སད་དུས་ལོང་བ་ལ་གཟུགས་སྣང་བར་ཐལ་བ་དང་།",
    "ལུང་གི་སྒྲུབ་བྱེད་མེད་པ།",
    "དེ་བཞིན་དུ་རབ་རིབ་ཀྱི་དཔེ་དག་གིས་ཀྱང་བརྗོད་པར་བྱའོ།",
    "དེ་བཞིན་དུ་སེམས་ཙམ་པའི་ལུགས་བཀག་པ་ལ་ལུང་གི་གནོད་པ་ཡང་མེད་དེ།",
    "ཟློས་གར་གྱི་ལྟད་མོ་མཐོང་བ་དེ་བཞིན་དུ་ཀེང་རུས་མཐོང་བའི་ཡུལ་དེར་བློ་གཏད་ན་རྣལ་འབྱོར་པ་མིན་པ་ཅིག་ཤོས་ཀྱིས་ཀྱང་རྣལ་འབྱོར་པས་མཐོང་བ་ལྟར་རྟོགས་པར་འགྱུར་རོ།",
    "ཁྱོད་ལྟར་ན་ཏིང་ངེ་འཛིན་དེ་ནི་བརྫུན་པར་ཡང་མི་འགྱུར་བར་ཡང་དག་པ་ཡིད་ལ་བྱེད་པ་ཉིད་དུ་འགྱུར་རོ།",
    "ཆུ་འབབ་ཀླུང་ལ་ཡི་དྭགས་འགའ་ཞིག་གིས།",
    "ཤེས་བྱའི་རྣམ་པ་ཅན་གྱི་བློའམ་རྣམ་པར་ཤེས་པ་ཡང་རང་གི་བདག་ཉིད་ཀྱིས་མ་སྐྱེས་པས་ཡེ་ནས་མེད་ཅེས་གཞི་མེད་སྟོང་པ་ཉིད་ཀྱི་དོན་འདི་ཤེས་པར་གྱིས་ཤིག་ཅེས་སོ།",
    "དེ་ཕྱིར་ཤེས་དང་ཤེས་བྱ་དགརང་བཞིན་མེད་པར་ཁྱོད་ཀྱིས་གསུངས།",
    "འདི་ཡི་ཡོད་ཉིད་གང་གིས་ཤེས་པར་འགྱུར།",
    "འདི་ལྟ་བུའི་དངོས་པོ་དེ་ནི་ཡོད་པ་ཉིད་ཁྱོད་ཀྱི་ཤེས་པ་གང་གིས་ཤེས་པ་ཡིན་ཅེས་དྲི་བར་བྱའོ།",
    "རང་གིས་རང་ལ་བྱ་བ་འགལ་ཏེ།",
    "རལ་གྲིས་རང་མི་གཅོད་པ་དང་སོར་མོ་རང་གིས་རང་ལ་མི་རེག་ཅིང་མིག་རང་གིས་རང་ལ་མི་བལྟའ་བ་སོགས་ལྟར་ཡིན་པའི་ཕྱིར་རོ།",
    "དེས་ན་ཤེས་པ་གང་གིས་ཀྱང་མ་བཟུང་བར་འགྱུར་བས་ན་ཤིན་ཏུ་མི་འཐད་དེ།",
    "ཡུལ་ཅན་གང་གིས་ཀྱང་མ་བཟུང་བར་ཡང་ཡོད་ཅེས་བྱར་མི་རུང་སྟེ་གལ་ཏེ་རུང་ན་རི་རྭ་སོགས་ཀྱང་ཡོད་པར་འགྱུར་རོ།",
    "དེའང་གལ་ཏེ་གཞན་རིག་གིས་ཤེས་པ་མ་ཡིན་མོད།",
    "རང་རིག་རྗེས་དཔག་གི་སྒོ་ནས་མི་འགྲུབ་པའི་ཚུལ།",
    "གལ་ཏེ་དུས་ཕྱིས་ཀྱི་དྲན་པ་ལས་སྔར་གྱི་ཡུལ་མྱོང་བ་རྗེས་དཔག་གིས་གྲུབ་པར་འདོད་ན་དྲན་པ་དོན་དམ་པའམ་ཀུན་རྫོབ་ཏུ་རང་རིག་སྒྲུབ་བྱེད་དུ་སྨྲ།",
    "གཉིས་པ་ལྟར་ན་ཡང་སྤྱིར་དྲན་པ་ཡོད་པའི་ཕྱིར་རང་རིག་པ་ཡོད་ཅེས་པའམ་རང་རིག་གིས་སྐྱེད་པའི་དྲན་པ་ཡོད་པའི་ཕྱིར།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པ་ལ་མིག་གི་གཟུང་བྱ་བཀོད་པ་བཞིན་ནོ།",
    "རང་རིག་པ་ནི་གྲུབ་ལ་རག་མོད་ཀྱི།",
    "གལ་ཏེ་སྔར་ཤེས་པས་ཡུལ་རིག་པ་དང་རང་གི་བདག་ཉིད་མྱོང་བས་རང་རིག་པ་ནི་གྲུབ་ལ་རག་ལས་མོད་ཀྱི།",
    "གང་ཕྱིར་གང་གིས་ཡུལ་མྱོང་གྱུར་དེ་ལས།",
    "དེ་ཕྱིར་བདག་གིས་མཐོང་སྙམ་དྲན་འགྱུར་ཏེ།",
    "ཁྱོད་ཀྱི་ཕྱོགས་ལའང་དྲན་པས་སྔར་གྱི་ཡུལ་ཡོངས་སུ་གཅོད་པ་མི་འཐད་དོ་ཞེ་ན།",
    "རང་རིག་པ་ཉིད་ནི་དེ་ལྟར་རྗེས་དཔག་གིས་མི་འགྲུབ་པ་མ་ཟད་མངོན་སུམ་གྱིས་ཀྱང་མི་འགྲུབ་སྟེ།",
    "རང་གིས་རང་ཉིད་རིག་ན་རིག་པར་བྱེད་པ་པོ་དང་།",
    "ཇི་ལྟར་རལ་གྲིས་རང་གི་སོ།",
    "གཅོད་པར་མི་བྱེད་སོར་མོ་ནི།",
    "རང་ལ་རེག་པར་མི་བྱེད་ལྟར།",
    "གང་གིས་ན་འདི་ཡོད་པར་མི་འདོད་པ།",
    "ཁྱོད་ལ་མོ་གཤམ་བུས་གནོད་ཅི་ཞིག་བསྐྱལ།",
    "གཉིས་ཀ་ཡོད་མེད་མཚུངས་བཞིན་དུ་མོ་གཤམ་གྱི་བུ་མི་འདོད་པ།",
    "རྣམ་རིག་ཁྱོད་ལ་མོ་གཤམ་གྱི་བུས་གནོད་པ་ཅི་ཞིག་བསྐྱལ།",
    "དེས་ན་བདེན་གཉིས་དེ་ལས་ཉམས་པས་ཕྱིན་ཅི་ལོག་གི་ལྟ་བ་དེ་ཕྲ་བ་ནས་མ་སྤང་གི་བར་དེ་སྲིད་དུ་རྒྱུད་ལྡན་གྱི་གང་ཟག་དེ་ལ་ཐར་བ་ཆེན་པོ་ཉིད་འགྲུབ་པ་ཡོད་པ་མིན་ནོ།",
    "ཀུན་རྫོབ་ཀྱང་ནི་བདག་གིས་ཁས་མ་བླངས།",
    "གལ་ཏེ་ཁྱོད་ལ་འཇིག་རྟེན་མི་གནོད་ན།",
    "ཁྱོད་དང་འཇིག་རྟེན་འདིར་རྩོད་གྱིས་ཤིག་དང་།",
    "ཕྱི་ནས་སྟོབས་ལྡན་བདག་གིས་བརྟེན་པར་བྱ།",
    "རིགས་པ་དེ་ཉིད་ཀྱིས་ཁྱོད་ལ་གྲགས་པའི་ཀུན་རྫོབ་སེལ་བར་བྱེད་དོ་ཞེ་ན།",
    "དེ་དག་གི་རྗེས་སུ་བརྗོད་པ་ནི་དེ་དག་གི་ཞེན་འཛིན་ལྡོག་པའི་ཐབས་ཡིན་ཏེ།",
    "མི་མཚུངས་ཏེ་དེ་ནི་རང་གིས་འདོད་པས་སོ་ཞེ་ན།",
    "གལ་ཏེ་སེམས་ཙམ་པ་ཁྱོད་ཀྱིས་ཀུན་རྫོབ་བཀག་པ་ལ་འཇིག་རྟེན་གྱིས་མི་གནོད་ན་འཇིག་རྟེན་པ་ཉིད་ཀྱི་བློ་ལ་ལྟོས་ནས་ཀུན་རྫོབ་འདི་ནི་དགག་པར་གྱིས་ཤིག།",
    "ཁོ་བོ་ཅག་ནི་ཀུན་རྫོབ་འཁྲུལ་པའི་སྣང་བ་བཟློག་པ་ལ་ཤིན་ཏུ་ཚེགས་ཆེན་པོ་ལ་གནས་པས་ཁྱོད་ལ་འཇིག་རྟེན་གྱིས་གནོད་པ་མི་འགྱུར་ན་ཁྱོད་ཀྱིས་ཀུན་རྫོབ་བཀག་པ་ལ་སྟོང་གདབ་པར་བྱའོ།",
    "ཁྱོད་དང་འཇིག་རྟེན་པ་གཉིས་ཀུན་རྫོབ་འདིར་རྩོད་པ་གྱིས་ཤིག་དང་ཕྱི་ནས་རྩོད་པའི་འོག་ཏུ་ཁྱོད་རྒྱལ་ན་ནི་ཁྱོད་ཀྱི་ཕྱོགས་ལ་བརྟེན་པར་བྱེད་ཅིང་།",
    "གལ་ཏེ་འཇིག་རྟེན་པ་རྒྱལ་ན་ནི་ཤིན་ཏུ་སྟོབས་དང་ལྡན་པའི་འཇིག་རྟེན་པ་ཉིད་ལ་བདག་གིས་བརྟེན་པར་བྱའོ།",
    "འོན་ཀྱང་ཁྱོད་ཀྱིས་འཇིག་རྟེན་པ་འགོག་མི་ནུས་ཏེ།",
    "འདིར་རྣམ་རིག་པ་དག་གིས་སྨྲས་པ།",
    "གལ་ཏེ་འཐད་པ་དང་བྲལ་ཡང་འཇིག་རྟེན་གྱི་གནོད་པས་འཇིགས་ནས་ཁྱོད་ཀྱིས་ཀུན་རྫོབ་ཁས་བླངས་པ་ཡིན་ན་ནི།",
    "ལུང་གིས་གནོད་པས་འཇིགས་ནས་སེམས་ཙམ་ཉིད་དུ་ཡང་ཁས་བླངས་བར་བྱ་དགོས་ཏེ།",
    "ལུང་གིས་བསྒྲུབ་པ་དང་།",
    "ཇི་ལྟར་རང་གི་བསྟན་བཅོས་དེ་དེ་ལས།",
    "སྨྲས་པ་དེ་དག་བྱེད་པོར་མ་གཟིགས་ནས།",
    "ཕྱི་རོལ་པ་དང་ནང་པའི་མུ་སྟེགས་པ་རྣམས་ཀྱིས་བདེན་པ་གཉིས་ཀྱི་གནས་ལ་དཔྱོད་ཀྱང་ཇི་ལྟ་བར་མ་ངེས་པས་རང་རང་གི་གྲུབ་མཐས་སྟོན་པའི་བསྟན་བཅོས་ལྟར་སྣང་བ་དེ་དང་དེ་ལས།",
    "ཞེས་བདག་ཉིད་ཆེན་པོ་བཅོམ་ལྡན་འདས་ཀྱིས་སེམས་དེ་ཉིད་མ་རིག་པ་དང་འདུ་བྱེད་ལས་ཀྱི་རྒྱུ་རྐྱེན་ལས་སྐྱེས་པར་ཅིའི་ཕྱིར་གསུངས་ཏེ་གསུངས་མི་རིགས་པར་ཐལ།",
    "རྣམ་པར་ཤེས་པ་རང་གི་བདག་ཉིད་ཀྱིས་གྲུབ་པ་ཡིན་ན་རྐྱེན་ལ་ལྟོས་པ་མི་སྲིད་ལ།",
    "རྐྱེན་ལ་ལྟོས་པ་ཡིན་ན་རང་གི་ངོ་བོས་གྲུབ་པ་མི་སྲིད་པ་དང་།",
    "འགྲོ་བ་རང་གི་སེམས་རྣམ་པར་ཤེས་པ་ངོ་བོས་མ་གྲུབ་པ་ཅིར་ཡང་མ་ཡིན་པ་ལས་ཅིར་ཡང་སྣང་དུ་རུང་བའི་ངང་ཚུལ་ཅན་འདི་ཉིད་ཀྱིས་ནི།",
    "སེམས་དང་བཅས་པ་ཁོ་ནས་ལས་གསོག་གི།",
    "འགྲོ་བ་རང་གི་སེམས་ཉིད་རང་བཞིན་མེད་པ་སྟོང་པ་ཉིད་དུ་ཤེས་པས་མ་རིག་པ་ས་བོན་དང་བཅས་པ་སྤངས་བར་བྱས་ནས་ནི་ལས་ཐ་དད་དུ་སྤང་མི་དགོས་ཏེ།",
    "འདི་ལྟར་གཟུགས་ཡོད་མོད་ཀྱི་དེ་ལ་ནི།",
    "བཟློག་གི་གཟུགས་ནི་བཀག་པ་མ་ཡིན་ནོ།",
    "གཉིས་ཀ་ལ་ཉེ་བར་མཁོ་བའི་གཟུགས་མི་འགོག་གི་འགྲན་ཟླ་ལྟ་བུའི་བདག་བཀག་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་ཡིན་མོད་ཀྱི་འོན་ཀྱང་གཟུགས་དེ་ལ་ནི་སེམས་བཞིན་གསལ་ཞིང་རིག་པའི་མཚན་ཉིད་མེད་པས་ལས་ཀྱི་བྱེད་པ་པོ་ཉིད་ཀྱང་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་ཙམ་གྱི་སྒྲས་ནི་སེམས་ལས་གཞན་པའི་གཙོ་བོ་སོགས་བྱེད་པ་པོ་བཟློག་གི་གཟུགས་ནི་བཀག་པ་མ་ཡིན་ནོ།",
    "གཞན་ཡང་ཁས་བླངས་པས་ཀྱང་གྲུབ་ཏེ་ཁམས་གསུམ་པོ་ནི་སེམས་ཙམ་མོ་ཞེས་པའི་ཙམ་སྒྲས་ཕྱི་རོལ་འགོག་པར་འདོད་པ་སྐབས་ཀྱི་སྔ་རྒོལ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཁྱོད་ཀྱི་རྫས་ནི་བཀག་པས་འགྲུབ་མི་འགྱུར།",
    "གནས་ལུགས་དེ་ཁོ་ན་ཉིད་རྟོགས་པའི་ཡེ་ཤེས་མངོན་དུ་འཆར་བ་རྣམས་ཀྱི་གཟིགས་པ་ལྟར་འདོད་པ་ན།",
    "གནས་ལུགས་དོན་དམ་བདེན་པ་གཏན་ལ་འབེབས་པ་ན་འཕགས་པའི་མཉམ་གཞག་ཡེ་ཤེས་ཀྱི་ངོར་གཟུགས་སོགས་ཕྱི་དོན་གྱི་སྣང་བ་མེད་པར་རྣམ་རིག་སྨྲ་བ་ཁྱོད་འདོད་ན་ནི།",
    "དེ་ལས་གཞན་ཐ་སྙད་ཀུན་རྫོབ་པའི་རྣམ་བཞག་ཀུན་གྱིས་མཐུན་སྣང་བ་འདི་ལ་གནས་ཏེ་ཁྱོད་སྨྲ་ན་ནི།",
    "སེམས་གསལ་རིག་གི་མཚན་ཉིད་ཅན་འདི་ཡོད་པ་ཉིད་དུ་འདོད་པ་ནའང་གཟུགས་སུ་སྣང་བ་ཉིད་གཏན་ནས་མེད་ཅེས་སུ་མ་འཛིན་ཅིག།",
    "དེ་ལ་སེམས་ཙམ་པ་རྣམས་ན་རེ།",
    "ནང་རང་གི་སེམས་ཉིད་ནི་སྣ་ཚོགས་སུ་སྣང་ངོ་ཞེས་གསུངས་པ་དེའི་དོན་ནི་དགོངས་པ་ཅན་ཏེ།",
    "དེ་ཡང་དྲང་བའི་དོན་ཉིད་ལས་མཐར་ཐུག་གི་ངེས་དོན་ཉིད་མིན་པར་ཤེས་པར་བྱའོ།",
    "གོང་གི་རིགས་པ་རྣམས་ཀྱིས་ཁེག་པར་སྟོན་པ་དང་།",
    "གཉིས་ལས་སྐྱེ་བའང་རིགས་པ་མ་ཡིན་གང་གི་ཕྱིར།",
    "དེ་ལ་གཅེར་བུ་པས་ཤེས་བྱ་ནི་ཚིག་གི་དོན་དགུ་འདོད་དེ།",
    "ཟག་པ་ནི་ཉོན་མོངས་པ་རྣམས་སོ།",
    "སྲིད་པའི་རྩེ་མོ་ན་ཁ་དོག་དཀར་ལ་འཚེར་ཞིང་དབྱིབས་ཟླུམ་པའི་གཟུགས་ཅན་པ་ལ་འདོད་དོ།",
    "ཞེས་དང་ནང་གི་དངོས་པོ་རྣམས་ཀྱང་གཉིས་ཀ་ལས་སྐྱེ་སྟེ།",
    "བྱམས་པ་ཚེ་རབས་གཞན་དུའང་སྲོག་གི་བདག་ཉིད་དུ་ཡོད་པ་ཁོ་ནས་སྐྱེ་བ་འདི་ལེན་པ་ཁོ་ནའི་ཕྱིར་བདག་སྐྱེ་ཡིན་ཏེ་བྱམས་པ་དང་སྲོག་གཉིས་གཞན་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "དེས་ན་བདག་གཞན་རེ་རེ་ནས་སྐྱེས་པའི་སྐྱོན་ཁོ་བོ་ལ་མེད་དེ།",
    "རེ་རེ་ཁོ་ན་ལས་སྐྱེ་བར་ཁས་མ་བླངས་བའི་ཕྱིར་ཞེས་སྨྲའོ།",
    "དེ་ནི་ཤིན་ཏུའང་མི་རིགས་སྔར་རེ་རེ་ནས་སྐྱེ་བར་མི་འཐད་པ་ལྟར་དུ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "གང་ཕྱིར་རེ་རེ་ལས་སྐྱེས་འགྲུབ་པ་མེད་ཕྱིར་རོ།",
    "དཔེར་ན་བྱེ་མ་གཅིག་རེ་ལ་འབྲུ་མར་འབྱིན་པའི་ནུས་པ་མེད་པས་གཉིས་སོགས་མང་པོས་ཀྱང་མི་ཕན་པ་བཞིན་ནོ།",
    "རང་བཞིན་རྒྱུར་སྨྲ་བ་རྒྱང་འཕེན་པ་ན་རེ།",
    "འཇིག་རྟེན་གྱི་དངོས་པོ་ཐམས་ཅད་ནམ་མཁའི་མེ་ཏོག་ལྟར་རྟག་ཏུ་མེད་པར་ཐལ་བས་དགག་པ་གཉིས་ལས།",
    "ས་བོན་འདེབས་པ་དང་ཀློག་སློབ་པ་ལ་སོགས་པའི་རྒྱུ་ལ་དཀའ་བ་བརྒྱ་ཕྲག་གི་སྒོ་ནས་སྡུད་ཅིང་འབད་པ་བྱེད་པར་ཡང་མི་འགྱུར་བར་ཐལ་ཏེ།",
    "རང་གི་བློ་བཞིན་འཇིག་རྟེན་རྒྱུ་ལས་བྱུང་ཤེས་གྱིས།",
    "རང་གི་བློས་འཛིན་པའང་ཡིན་པ་དེའི་ཕྱིར་ན།",
    "ནང་རང་གི་བློ་སྔོན་པོའི་རྣམ་པ་ཅན་ཡིན་ན་རྒྱུ་ཡུལ་ཁ་དོག་སྔོན་པོ་ལས་སྐྱེ་བ་ཡིན་དགོས་པར་ཁྱོད་རང་གིས་འདོད་པ་བཞིན་དུ་འཇིག་རྟེན་འདི་ཡང་རྒྱུ་ལས་བྱུང་བ་ཡིན་པར་ཤེས་པར་གྱིས་ཤིག།",
    "ཕྱིན་ཅི་ལོག་གི་བློ་ཡིན་པར་སྟོན་པ་གཉིས་ལས།",
    "དེའི་འབྲས་བུ་དབུགས་འབྱིན་རྔུབ་སོགས་དམིགས་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་ན་གོང་དུ་རང་གཞན་གཉིས་ག་དང་།",
    "ཐལ་བ་འདི་ཁྱོད་ལའང་མཚུངས་སོ་ཞེ་ན།",
    "བདག་གི་ལྟ་བའི་རྣམ་པའི་རྟེན་མཚུངས་ལུས་དང་ལྡན་ཉིད་ཕྱིར།"
  ]
}