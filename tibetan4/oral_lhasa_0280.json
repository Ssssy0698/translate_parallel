    "དེ་ཉིད་ལ་བརྟེན་ནས་སློབ་པ་གོང་མའི་འབྲས་བུ་རྟོགས་པས་ན་མ་རྟོགས་པ་རྟོགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "མངོན་སུམ་དུ་མ་བྱས་པ་མངོན་སུམ་དུ་བྱེད་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཚེ་འདི་ལ་བདེ་བར་གནས་པར་བྱ་བའི་ཕྱིར་བརྩོན་པར་ཟད་དོ།",
    "དེ་ལ་གསུམ་པོ་འདི་དག་ནི་ཁྱད་པར་དུ་འགྲོ་བའི་འདུ་ཤེས་ཡིན་ཏེ།",
    "འདུ་བྱེད་རྣམས་ལ་མི་མཐུན་པར་འདུ་ཤེས་པ་དང་།",
    "བསྔལ་ལ་མི་མཐུན་པར་འདུ་ཤེས་པར་འགྱུར་བ་དེ་བཞིན་དུ་རྣལ་འབྱོར་པ་ཡང་འདུ་བྱེད་རྣམས་ལ་མི་མཐུན་པར་འདུ་ཤེས་པར་འགྱུར་རོ།",
    "འདུ་བྱེད་རྣམས་ལ་སྟོང་པའམ་བདག་མེད་པར་ཡིད་ལ་བྱེད་པའོ།",
    "ཡང་དག་པའི་དོན་དུ་འདུ་ཤེས་པ་ལ་ལེགས་པར་འདྲིས་པར་བྱས་པས་ན།",
    "ཕྱིས་མི་མཐུན་པའི་འདུ་ཤེས་ཡང་དག་པར་གནས་པར་འགྱུར་ཏེ།",
    "རྣམ་པར་བརྟགས་པ་ནི་འདི་ལས་ཕྱི་རོལ་པའི་མུ་སྟེགས་ཅན་རྣམས་ཀྱི་གང་ཡིན་པའོ།",
    "རྐྱེན་གྱིས་སྐྱེད་ན་ནི་དེ་ལ་ནི་དཔེའི་ཁྱད་པར་དུ་རིག་པར་བྱ་སྟེ།",
    "ལྷག་མ་རྣམས་ནི་སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་མཁས་པ་རྣམས་ཀྱི་ཕན་པའི་ལན་ནི་ཉན་ཐོས་སམ་ཚངས་པ་མཚུངས་པར་སྤྱོད་པས་སྟོན་པའམ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ལ་ཡང་རྣམ་པ་གཅིག་པུས་ལན་ལོན་པར་འགྱུར་གྱི་གཞན་གྱིས་ནི་མ་ཡིན་ནོ།",
    "མཚན་ཉིད་གང་ཡང་རུང་བ་མ་ཚང་ན་ནི་འགོག་པར་གདགས་སུ་མི་རུང་ངོ།",
    "མྱ་ངན་ལས་འདས་པ་ནི་ཞི་བའོ་ཞེས་བྱ་བ་ནི་མཚན་མ་མེད་པའི་སྒོ་ནས་བཞི་པོ་རྣམ་པར་གཞག་པའོ།",
    "རྣམ་པ་བཞིས་དེ་ལས་ཡིད་ལྡོག་པར་འགྱུར་ཏེ།",
    "དེ་ཐོབ་པར་ཡིད་མི་ཆེས་པས་མ་དད་པའི་ཕྱིར་དང་།",
    "དེ་ལས་བཟློག་པ་ནི་བསམ་པའི་སྒོ་ནས་འདོད་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདོད་པ་དེ་ཡང་ལེགས་པར་བྱང་བ་མ་ཡིན་ལ་ཚར་ཕྱིན་པར་ཡང་མ་གྱུར་བ་དང་།",
    "དེ་ཡིད་ལ་བྱེད་པའི་ཚེ་ཡང་རྒྱུ་དེ་ཉིད་ཀྱིས་བརྗེད་ངས་པར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "བཟོད་པ་དེ་ལ་ཡོངས་སུ་མ་བྱང་བའི་ཕྱིར་ནི་དེའི་ཚེ་འདུ་བྱེད་རྣམས་ལ་འདུ་བྱེད་ཙམ་དུ་ཤེས་པ་ལ་སེམས་རྨོངས་པར་འགྱུར་ཏེ།",
    "དེས་ན་དེ་འདི་སྙམ་དུ་བདག་ནི་མེད་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་ཀྱི།",
    "འདི་སྙམ་དུ་འདུ་བྱེད་ཙམ་པོ་འདི་ནི་མེད་པར་འགྱུར་རོ་སྙམ་དུ་ནི་མི་སེམས་སོ།",
    "དེ་དེ་ལྟར་རྗེས་སུ་འབྲེལ་བའི་འཇིག་ཚོགས་ལ་ལྟ་བ་ལ་བརྟེན་ནས་རྣམ་པར་འགྱུར་བ་དང་།",
    "འབྲེལ་བའི་རྣམ་པར་ཤེས་པ་བསྐྱེད་དེ།",
    "ཡོངས་སུ་ཡི་འཆད་པའི་ཕྱིར་འགོག་པ་ལས་ཡིད་ཕྱིར་ལྡོག་པར་འགྱུར་རོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་མཁས་པ་དག་ལ་བདག་ཉིད་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་རབ་ཏུ་སྟོན་པ་དང་།",
    "མཐུ་ཡོད་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "དེས་ཡོངས་སུ་ཤེས་པར་བྱ་བ་གང་ཡིན་པ་དང་།",
    "བག་ལ་ཉལ་ནི་སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "འདུ་ཤེས་རྣམ་པར་གཞག་པ་དང་།",
    "མཐོང་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྐྱོ་བ་མེད་ན་ཡོངས་སུ་ཡི་འཆད་པར་མི་འགྱུར་བའོ།",
    "ཡོངས་སུ་ཡི་འཆད་པ་མེད་ན་ཟག་པ་ཟད་པར་བྱ་བའི་སྦྱོར་བ་མི་གཏོང་ངོ།",
    "དེ་ལ་ཤེས་པ་དང་མཐོང་བ་གཉིས་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "སྤོང་བ་དང་རྣམ་པར་གྲོལ་བའི་ཤེས་རབ་གང་ཡིན་པ་དེ་ནི་མཐོང་བའོ།",
    "གཞན་ཡང་རྣམ་པར་མི་རྟོག་པའི་གཟུགས་བརྙན་ལ་དམིགས་པ་ནི་ཤེས་པའོ།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་གཟུགས་བརྙན་ལ་དམིགས་པ་ནི་མཐོང་བའོ།",
    "ཕྱིན་ཅི་ལོག་བཞིའི་གཉེན་པོའི་སྒོ་ནས་ཤེས་བྱ་ཐམས་ཅད་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "གཏོང་བ་དང་ལེན་པའི་གཞི་ནི་ཡང་དག་པར་སྤོང་བ་བཞི་སྟེ།",
    "སྡུག་བསྔལ་བ་ལས་ཡང་དག་པར་འདས་པའི་བར་གྱི་ཕྱིར་རོ།",
    "གྱི་ཡན་ལག་རྣམས་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "བརྟེན་པའི་དོན་བཞི་ཡོད་པར་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་རྟེན་གྱི་དོན་ནི་རྣལ་འབྱོར་པ་ཡང་དག་པར་ཞུགས་པ་གང་ཡིན་པ་དེ་ཡིན་ནོ།",
    "དེ་ལ་རྣམ་པར་དག་པའི་ལམ་ཡང་རྣམ་པ་བཞིར་རིག་པར་བྱ་སྟེ།",
    "ལྐོག་དབེན་པ་ན་གནས་ཤིང་ཞི་གནས་དང་ལྷག་མཐོང་གཉིས་ཀྱིས་ནི་ཡང་དག་པར་བདེ་བླག་ཏུ་བསྲུང་བར་བྱའོ།",
    "ཡོངས་སུ་མཐུར་ཐུག་པའི་རྣམ་པར་གྲོལ་བ་དེ་འཐོབ་པ་ལ་ཡང་རིམ་པ་ལྔ་ཡོད་པར་རིག་པར་བྱ་སྟེ།",
    "སྔོན་ཚོགས་ཡང་དག་པར་བསྒྲུབས་པའི་རྟེན་དང་།",
    "དེ་ལ་བརྟེན་ནས་ཀྱང་རྟོགས་པ་ཕལ་བ་ཙམ་གྱིས་ཆོག་པར་མི་འཛིན་ཅིང་གནས་པར་མི་བྱེད་དེ།",
    "ལུས་ཐམས་ཅད་ལ་ནི་རྒྱུ་རྣམ་པ་བཞིས་འདུ་བྱེད་ཐམས་ཅད་མི་རྟག་པར་རིག་པར་བྱ་སྟེ།",
    "གཞན་ཡང་ལུས་ཐམས་ཅད་ནི་རྒྱུ་ལས་བྱུང་བ་ཡིན་ལ་རྒྱུ་ཡང་བྱས་པ་ཡིན་པའི་ཕྱིར་མི་རྟོག་གོ།",
    "དེ་དག་ནི་འདོད་པ་དང་ལྡན་པ་རྣམས་ཀྱིས་རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་འདོད་པ་སྟེ།",
    "ཕུན་སུམ་ཚོགས་པ་གསུམ་པོ་འདི་དག་འཐོབ་པའི་རྒྱུ་ནི་རྣམ་པ་གསུམ་ཡོད་པར་རིག་པར་བྱ་སྟེ།",
    "ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "ཇི་ལྟར་འདོད་པ་བཞིན་དུ་སྤྱད་པར་མི་ནུས་པའི་ཕྱིར་དབུ་བའི་གོང་བུ་ལྟ་བུར་རྟོགས་པ་དང་།",
