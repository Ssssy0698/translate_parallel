    "འདི་ནི་དེ་གཉིས་ཀྱི་ཁྱད་པར་དང་པོའོ།",
    "གཞན་ཡང་འཇིག་ཚོགས་ལ་ལྟ་བ་མ་སྤངས་པ་ནི་བག་ཡོད་པ་ཡིན་དུ་ཟིན་ཀྱང་ཆགས་པར་འགྱུར་བའི་དངོས་པོ་བདེ་བ་དང་ཡིད་བདེ་བའི་གནས་རྒྱ་ཆེན་པོའམ་ཡང་ན་ཤས་ཆེར་སྡུག་བསྔལ་བ་དང་ཡིད་མི་བདེ་བའི་གནས་ཀྱི་ཡུལ་མངོན་དུ་བྱུང་བ་ལ་དྲན་པ་ཉེ་བར་འཇོག་མི་ནུས་ན་བག་མེད་པ་ལྟ་ཅི་སྨོས།",
    "དེས་ན་སེམས་ཀྱི་ངོ་ཟིན་པར་མི་ནུས་སོ།",
    "དེ་ལས་བཟློག་པ་ནི་འཇིག་ཚོགས་ལ་ལྟ་བ་སྤངས་པ་ཡིན་བར་རིག་པར་བྱ་སྟེ།",
    "འདི་ནི་ཁྱད་པར་གཉིས་པའི།",
    "འདི་ནི་དུས་གཉིས་ཀྱི་ཁྱད་པར་གསུམ་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་སྤངས་པ་དེ་ལ་ནི་ཁྱད་པར་གསུམ་པོ་ལས་མ་གཏོགས་པར་ཕན་ཡོན་གསུམ་ཡང་ཡོད་དེ།",
    "དེའི་གཉེན་པོའི་ལམ་ཡང་དག་པར་འགྲུབ་པོ།",
    "དེ་ལ་འབྲས་བུའི་སྒོ་ནས་ནི་འདོད་པའི་འདོད་ཆགས་ཐམས་ཅད་ཡང་དག་པར་སྤོང་བ་དང་།",
    "གཞིར་བྱས་པ་དང་ནན་ཏན་དུ་བསྒྲུབས་ཏེ་གོ་རིམས་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཡུན་རིང་པོར་གོམས་པར་བྱས་པས་ནི་བྱང་བར་བྱས་སོ།",
    "ཕྱིན་ཅི་མ་ལོག་པའི་ཚུལ་གྱིས་ནི་ལེགས་པར་བླངས་པ་དང་།",
    "ལེགས་པར་བརྩམས་ཏེ་འདི་ནི་རང་བཞིན་གྱི་བྱེ་བྲག་གོ།",
    "དེ་ལ་རྣམ་པའི་བྱེ་བྲག་ནི་མི་རྟག་པའི་འདུ་ཤེས་དེ་དེ་ལྟར་གོམས་པར་བྱེད་པ་ནི་བག་ལ་ཉལ་ཐམས་ཅད་ཡང་དག་པར་འཇོམས་སོ།",
    "དེ་མ་ཡིན་པ་མི་སྡུག་པ་ལ་སོགས་པའི་འདུ་ཤེས་ཐམས་ཅད་ཀྱི་ནང་ན་མཆོག་དང་རྒྱ་ཆེ་བའི་ཚུལ་གྱིས་གནས་པར་འགྱུར་རོ།",
    "ཟག་པ་མེད་པའི་མི་རྟག་པའི་འདུ་ཤེས་ཀྱང་འཐོབ་པར་འགྱུར་རོ།",
    "ཟག་པ་མེད་པའི་འདུ་ཤེས་གང་ཡིན་པ་དེ་དག་ཐམས་ཅད་ཀྱང་མྱ་ངན་ལས་འདས་པར་གཞོལ་ཞིང་དེར་འབབ་ལ་དེར་བབ་སྟེ།",
    "སློབ་པ་ཟག་པ་མེད་པ་ཐམས་ཅད་ཀྱི་བདག་པོ་ཡང་ཐོབ་པར་འགྱུར་རོ།",
    "རྒྱུན་མི་འཆད་པར་ཡིད་ལ་བྱེད་པས་མི་རྟག་པར་ཉེ་བར་རྟོག་གོ།",
    "འདུ་འཛིའི་ནང་ན་གནས་ཤིང་ཡང་དག་པར་སྤྱོད་པའི་སྦྱོར་བ་བཏང་བའོ།",
    "ཟས་ཀྱི་ཚོད་མ་རིག་པ་དང་སྲོད་དང་ཐོ་རངས་མི་ཉལ་བར་བརྩོན་པས་བརྩོན་པར་མི་བྱེད་པ་དང་།",
    "གཞན་གྱིས་གནོད་པ་བྱས་པའི་རྒྱུ་དང་།",
    "ལོག་པར་ལྟ་བ་ནི་སྤོང་བ་དང་།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་ཤེས་པ་རྣམས་ཀྱི་གནས་དང་གནས་མ་ཡིན་པ་ལས་གླིངས་ན་མི་ཁྲོ་བ་དང་།",
    "གྲང་བ་ལ་སོགས་པའི་གནོད་པ་རྣམས་ཀྱིས་སེམས་འཁྲུག་པར་མི་འགྱུར་བ་འདི་ནི་གཅིག་གོ།",
    "ཆུད་མི་ཟ་བར་རིང་པོར་མི་ཐོགས་པར་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་འགྱུར་རོ།",
    "ཡང་དག་པར་ཚར་གཅད་པ་དང་།",
    "ཡང་དག་པར་བསྡུ་བ་དང་།",
    "ཡང་དག་པར་གླེང་བ་དང་།",
    "རྟོག་པ་ཡང་དག་པར་བསྟན་པ་དང་།",
    "རྣམ་པར་བྱང་བ་ཡང་དག་པར་བསྟན་པའོ།",
    "རྒྱུ་གཉིས་ཀྱིས་ནི་ཉན་ཐོས་རྩོད་པའི་འགལ་བ་བྱས་པ་རྣམས་ལ་རྩོད་པ་དེ་བསལ་བར་མ་བསྟན་པ་ཡིན་ཏེ།",
    "མ་འོངས་པའི་སྐྱེ་བའི་སྣང་བ་བྱས་པར་འགྱུར་བ་དང་།",
    "དེ་དག་ཀྱང་ཐ་ན་འདོད་པ་ཙམ་ཡང་སྐྱེད་པར་འགྱུར་བ་དང་།",
    "གཏམ་ཐོས་པ་ཙམ་གྱིས་ཞེ་འགྲས་པ་རྣམས་སྤྱོད་ལམ་ཞི་བ་དང་གཟུགས་མཛེས་པ་ལེགས་པར་མཐོང་བས་སེམས་གཡོ་བར་བྱ་བའི་ཕྱིར་དང་།",
    "སྐྱེ་བོ་ཐ་མལ་པར་གནས་པ།",
    "སེམས་འཁྲུགས་པ་ལ་སོགས་པའི་གནོད་པ་རྣམ་པ་སྣ་ཚོགས་ཡང་དག་པར་ཞི་བར་བྱ་བའི་ཕྱིར་དང་།",
    "ལྟོ་འཕྱེ་ཆེན་པོ་མཐའ་ཡས་པ་རགས་པ་རྣམས་སྤྲོ་བར་འགྱུར་ལ་འཚེ་བར་ནི་མི་བྱེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དབེན་པར་གྱུར་པ་རྣམས་དོན་མཐུན་པས་བསྡུ་བའི་ཕྱིར་དང་།",
    "ཉིད་སྐུ་ཚེ་འདི་ལ་བདེ་བར་བཞུགས་པར་མཛད་པའི་ཕྱིར་དང་།",
    "ལྷ་ཆེ་བར་གྲགས་པ་རྣམས་དང་ཐབས་ཅིག་ཏུ་ཚོགས་པར་བཞེད་པ་དང་།",
    "རྣམ་པར་སྨྲ་བ་ལ་བརྩོན་ཞིང་རྣམ་པར་སྨྲ་བ་ལ་དགའ་བ་རྣམས་བསྐུལ་བའི་ཕྱིར་རོ།",
    "ཉན་ཐོས་ནི་རྣམ་པ་ལྔས་སྟོན་པས་ཕན་གདགས་པར་བྱ་བ་ཡིན་ཏེ།",
    "གསར་བུ་རྣམས་ཀྱི་གསར་བུའི་རང་བཞིན་ནི་རྣམ་པ་ཐམས་ཅད་དུ་རྣམ་པ་ལྔར་རིག་པར་བྱ་སྟེ།",
    "བསྙེན་པར་རྫོགས་པར་རབ་ཏུ་བྱུང་བའོ།",
    "གདན་ཆེས་དམའ་བ་ལས་བཞེངས་ནས་གདན་ཆེས་མཐོ་བ་ལ་བཞུགས་པ་དང་།",
    "སྤྱོད་ལམ་དུལ་བས་སྟོན་པ་མཉེས་པར་མ་བྱས་པ་ན་ཐང་དུ་འགྲོ་བའི་ཚུལ་གྱིས་ངོ་ཚ་བའོ།",
    "སྟོན་པ་ནི་ཉན་ཐོས་འགལ་བར་བྱེད་བྱེད་པ་ལ་རྣམ་པ་གསུམ་གྱི་སྒོ་ནས་ཡང་དག་པར་གླེང་བར་མཛད་དེ།",
    "ངོ་ཚ་བ་མེད་པས་དང་དུ་ལེན་པར་བྱེད་པ་ནི་བསམ་པའི་ཉེས་པ་ཡིན་ཏེ།",
    "དེ་ལ་ཤེས་པའི་ཉེས་པ་ནི་ཐོས་པ་དང་བསམས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ལ་བརྗེད་བས་ཤིང་ཡིད་མི་གཞུངས་པར་གནས་ལ།",
    "བསྒོམས་པ་ལས་བྱུང་བ་ལ་ནི་མཉམ་པར་མ་བཞག་པའོ།",
    "དེ་ལ་རྟེན་གྱི་ཉེས་པ་ནི་དེའི་རྟེན་སྔོན་གྱི་རྒྱུས་ཡང་དག་པར་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "བསྟན་པ་ལ་འཇུག་པ་ནི་རྣམ་པ་བཞིས་ལོག་པར་བསྒྲུབ་པར་འགྱུར་ཏེ།",
    "རྒྱལ་པོ་དང་ཆོམ་རྐུན་གྱིས་ངེས་པར་བྱས་པ་དང་།",
    "ལོག་པར་བསྒྲུབ་པ་དེ་ལ་ཡང་རྒྱུ་རྣམ་པ་གཉིས་ཡོད་དེ།",
    "དངོས་པོ་གསུམ་ནི་སྔ་མ་བཞིན་དུ་རིག་པར་བྱ་སྟེ།"
  ]
}