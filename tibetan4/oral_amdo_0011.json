    "༢༩གི་ཝང་དགུ་བ་ལ།",
    "གི་ཝང་༣ གུར་ཀུམ་༥ ཨུཏྤལ་༡ བ་ལེ་ཀ་༥ ཏིག་ཏ་༥ བྲག་ཞུན་༣ ཪུ་རྟ་༡ བ་ཤ་ཀ་༡ གསེར་གྱི་མེ་ཏོག་༡ ཀ་ར་བཅས་པའོ།",
    "གུར་ཀུམ་༥ ལི་ཤི་༢ གི་ཝང་༢ བསེ་རུ་༢ མཚལ་༢ ཙན་དན་༤ གླ་རྩི་༥ འཇམ་འབྲས་༢ བོང་ང་དཀར་༢།",
    "རུ་རྟ་༢ འབྲས་བུ་གསུམ་༢རེ་བཅས་སྦྱར་བའོ་།",
    "སླེ་ཏྲེས་༣ སྒོག་ཐལ་༣ ཛཱ་མེ་༢བསྣན་དགོས་བཅས་སོ།",
    "སྤང་རྩི་༣ བ་ལེ་ཀ་༨ ཨ་རུ་༡༢ བ་རུ་༡༣ སྐྱུ་རུ་༡༦ མ་ནུ་༡༣༣ ཅུ་གང་༡༤ སྲོ་ལོ་དཀར་༡ ག་དུར་༢༡ ཚོས་༥ བཙོད་༤ འབྲི་མོག་༧ བཅས་སོ།",
    "འབྲས་སྣ་གསུམ་༢ རེ་དང་གསེར་བྱེ་ཀ་ཀ་རུ་༢།",
    "ཆབ་འདྲེན་གཞོན་ནུ་དུས་བཏུས་སྲང་༡ འུ་སུ་ལོ་འབྲས་༥ རྒྱ་ཚྭ་༥ རྒྱམ་ཚྭ་༥ ཁ་ཆེ་གུར་ཀུམ་༥ ཁ་ཚར་ལ་ཀླུ་བདུད་རྡོ་རྗེ་༥ ཆུ་རུག་སྦལ་ལག་༥ སྟག་ཤ་༥ མྱང་སྤྲས་མཆོག་དམན་གཉིས་ཕྲན་ཙམ་རེ་དང་།",
    "གུལ་ནག་གཉིས་ཕྲན་ཙམ་རེ་བསྣན་ན་ཟབ་པ་འདུག་ལགས།",
    "༤༩ འབྱར་ཆེན་རེག་པ་བདེ་བྱེད་ལ།",
    "ཤིང་ཚ་༣ སྒ་པི་ཕོ་༣རེ་དང་གུ་གུལ་གཉིས་༣རེ།",
    "སེ་འབྲུ་༥ སྒོག་ཐལ་༣ སུག་སྨེལ་༣ ཨ་རུའི་མཇུག་༣།",
    "དྲང་སྲོང་ཨ་གར་བརྒྱད་སྟེང་ཨ་ག་ཪུ་སྲང་ ༣ གཞན་རྣམས་༡རེ་ཙན་དན་གི་ཝང་དང་།",
    "ས་འཛིན་སྐྱུ་རུ་རྣམས་༡རེ་སྦྱར་བའི་ཉི་ཤུའོ།",
    "གསེར་མེ་སྐྱེར་ཤུན་དུག་མོ་ཉུང་།",
    "ཤུག་ཚེར་རྣམས་༡རེ་ཀ་ར་དཀར་བོ་སྦྱར།",
    "ཙན་དན་༣ གི་ཝང་༡ བཟང་བོ་དྲུག་༥རེ།",
    "ཧོང་ལེན་རེ་སྐོན་བ་ཤ་ཀ།",
    "བཙོད་དང་འབྲི་མོག་རྣམས་༡རེ་ཀ་ར་སྦྱར།",
    "གི་ཝང་༤ ཙན་དན་དཀར་༡༡ དམར་༨ ཨར་ནག་༧ སུམ་ཏིག་༥ བ་ལེ་ཀ་༥ རེ་སྐོན་༢ སྐྱུ་རུ་༡༧ ཨུཏྤལ་༡ བ་ཤ་ཀ་༡༦ གསེར་མེ་༡ མ་ནུ་༡ འུ་སུ་༡༨ པྲི་ཡང་ཀུ་༡ བྲག་ཞུན་༣༧ ཪུ་རྟ་༢ ཅུ་གང་༢༩ གུར་ཀུམ་༥བཅས་སོ།",
    "རུ་རྟ་༧ སྐྱུ་རུ་༢ སེ་འབྲུ་༢ བ་ཤ་ཀ་༢ པྲི་ཡང་ཀུ་༢ ཨུཏྤལ་༢ རེ་སྐོན་༢ གོ་ཐལ་༢ བྱི་ཏང་ག་༢ སུག་སྨེལ་༣༤ པི་ལིང་༡༤ བཅའ་སྒ་༡༤ འུ་སུ་ ༡༤རྣམས་སོ།",
    "སྦྲུལ་གྱི་ཤ་རྣམས་ཐུན་བཟང་༢༨རེ།",
    "༦༥དཀར་བོ་དྲུག་གི་སྦྱོར་བ་ལ།",
    "བྱང་གི་བུལ་ཏོག་རྙིང་བ་ནི།",
    "བྱ་རྒོད་ཐལ་བ་ཅོང་ཞིའི་ཕྱེད་༥།",
    "གོ་ཐལ་ཕྱེད་ཕྱེད་༢༥རེ་བཏང་བས།",
    "ཆུ་སྐོལ་ཚ་མོས་འཕུལ་བ་ཡིས།",
    "ཅོང་ཞི་ལྷད་མེད་ཁྱོར་གང་དང་།",
    "བྲག་སྐྱེས་དབྱི་མོང་སྤར་བ་གང་།",
    "ཙན་དན་༡ གི་ཝང་༡ ཚ་བ་གབ་རྙིང་སེལ།",
    "ཙན་དན་དཀར་བོ་༢༡ གི་ཝང་༣༢ ཅུ་གང་༣༢ ཁ་ཆེ་གུར་ཀུམ་༡༢ བྲག་ཞུན་༣༨ བོང་དཀར་༢༢ གླ་རྩི་༩ གུ་གུལ་ ༡༦ སྟག་ཤ་ ༡ ༩ འཛིན་པ་༡༡འཛིན་པའི་མེ་ལོ།",
    "འབྲས་སྣ་གསུམ་དང་གོ་ཡུ་བྲེ་ག་༣ རེ་དང་།",
    "ལྕུམ་རྩ་གོ་ཐལ་དང་བོངས་མཉམ་པའི་མན་ངག་ཞི་བྱེད་དྲུག་དང་སྦྱར་ན།",
    "ལི་ཤི་༣ གུར་ཀུམ་༡ གི་ཝང་༡ ཀ་ཀོ་ལ་༤།",
    "སེང་ལྡེང་སྲང་༥ ཨ་རུ་༧ བ་རུ་༧ སྐྱུ་རུ་༡ སྐྱེར་ཤུན་༡ གུ་གུལ་༥རེ།",
    "ཀུམ་༧ ཅུ་གང་༧ ཟི་ར་དཀར་༥ ཟི་ར་ནག་༥ སྤོས་དཀར་༡ ཐལ་རྡོཪ་༡ སོ་ཪ་༡ བྲག་སྤོས་༢རྣམས་སོ།",
    "ཙན་དན་དཀར་༡༢ དམར་༢ གི་ཝང་༡༤ ཅུ་གང་༤ ཁ་ཆེ་༡༤ ལི་ཤི་༡༦ ཛཱ་ཏི་༢༤ སུག་སྨེལ་༡༤ ཀ་ཀོ་ལ་༡༤ སྤོས་དཀར་༢ ཐལ་རྡོར་༣ སོ་ར་༣ གེ་སར་གཉིས་༡༦ རེ།",
    "བཟང་དྲུག་༥ རེ་ཙན་དན་དཀར་༢ དམར་༣ ཨ་གར་ནག་༤།",
    "འབྲས་བུ་གསུམ་༣རེ་དང་ཚོས་གསུམ་༤རེ་ཀ་ར་༣ སྦྱར།",
    "ཨ་བར་སྐྱུར་གསུམ་༥རེ་སླེ་ཏྲེས་༥ སེང་ལྡེང་༥ དང་།",
    "ལི་ཤི་༡ སེར་སྔོན་༣ ཪུ་རྟ་༥ མཛོ་མོ་ཤིང་༡།",
    "གུ་གུལ་དཀར་ནག་༤ རེ་སྐབས་སྦྱར་ཚོས་དང་བཙོད་༥ རེ།",
    "གཟེ་ལྕམ་གསེར་བྱེ་སྡིག་སྲིན་༥རེ་ཙམ་རིགས་མདས་སྦྱར།",
    "གི་ཝང་ཤིང་ཀུན་བཟང་དྲུག་དང་།",
    "རྒྱལ་༤ རེ་བློན་༢ རེ་ཞིབ་བཏགས་ཕྱེ་མ་ནི།",
    "དགོང་དང་ཐོ་རེངས་ནན་ཏན་བྱ།",
    "སྤང་རྩི་གུར་ཀུམ་གི་ཝང་ཙན་དན་དམར།",
    "བཙོད་ཚོས་སྤུ་ཤེལ་འབྲི་མོག་ལི་ག་དུར།",
    "རེ་སྐོན་༡ ཁམས་ཪུས་༡ བྲག་གི་ཞུན་༤།",
    "གི་ཝང་ཅུ་གང་གུར་ཀུམ་གསུམ།",
    "ཕྱེ་མ་འུ་སྐྱུར་ལྷ་མོ་ཡིས།",
    "ཐང་གིས་ཕུལ་བཏང་ཚ་གྲང་སྙོམས།",
    "བསིལ་གྱི་གཙོ་བོ་གི་ཝང་ཙན་དན་དཀར།",
    "ཐང་གི་གཙོ་བོ་ཏིག་ཏ་བ་ཤ་ཀ།",
    "ཙན་དན་དཀར་༡༨ དམར་༡༣ ཨུཏྤལ་༡༡ གེ་སར་གཉིས་༢༢ རེ།",
    "ཙན་དན་དཀར་བོ་༢ བསིལ་གསུམ་༡ རེ་ལི་ག་དུར་༡།",
    "སེང་ཁྲོམ་བཙོད་དང་རྒྱ་སྐྱེགས་ཤུག་ཚེར་ཅན་རྣམས་༢རེ།",
    "གླ་རྩི་སྡིག་སྲིན་ལྕམ་པ་འབྲས་སྣ་གསུམ་༡ རེ།",
    "མ་ནུ་བཞི་བའི་ཐང་གིས་ཕུལ་གྱུར་ན།",
    "ཨ་མྲི་ཏ་ནི་ཆ་ལྔ་སྟེ།",
    "བོང་དཀར་མོན་ཆ་བྱ་རྐང་གསུམ།",
    "རེག་དུག་ཚ་ཤས་ཆེ་བ་ལ།",
    "ར་ཁྲག་གིས་དབུལ་བདུད་རྩི་ཡིན།",
    "བསྐོལ་གྲང་གིས་ཕུལ་བྱིས་པ་ཡི།",
    "རྒྱ་ཚྭ་མཚལ་དང་ཕང་འབྲས་མ་གི་ཏ།",
    "ན་མོ་གུ་རུ་བྷྱ",
    "ཁྱད་པར་རེག་དུག་ཚ་ཤས་ཀྱི།",
    "རེག་དུག་ར་ཁྲག་སྦྱར་བས་འཇོམས།",
    "རེག་པ་བདེ་བྱེད་ཅེས་ཀྱང་བྱའོ།",
    "ཁུར་མོང་ཡུ་གུ་ཤིང་དང་བྲག་སྤོས་པ།",
    "འདི་རྣམས་ཐུན་ཚད་རེ་རེའི་ཚད་ཡིན་ནོ།",
    "ཁུར་མོང་ཆུ་རྩ་ཡུང་བ་རྣམ་པ་བཞི།",
    "ཐུན་རེ་ཕྱེ་མ་རྩི་བཞིན་བཏགས་བྱས་ལ།",
