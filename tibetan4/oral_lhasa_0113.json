    "རྒྱལ་བསྟན་སྤྱི་དང་ཁྱད་པར་ས་སྐྱ་པའི།",
    "རྒྱལ་བ་སྲས་བཅས་ཀྱི་མཁྱེན་བརྩེ་ནུས་པའི་བྱིན་བརླབ་ཐམས་ཅད་བསྡུས་ནས་ཐུགས་ཀའི་སྔགས་ཕྲེང་ལ་ཐིམ།",
    "བཞི་ཀའང་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་གར་གྱིས་བཞུགས་པ།",
    "དེ་ལྟར་མ་ཆག་པར་ཉམས་སུ་བླངས་པས་གནས་སྐབས་སུ་ལོངས་སྤྱོད་འབད་མེད་དུ་འདུ་བ་དང་མཐར་ཐུག་བདེ་བ་ཅན་གྱི་ཞིང་ཁམས་སུ་སྐྱེས་ནས་ས་ལམ་བདེ་བླག་ཏུ་བསྒྲོད་པ་ནི་འཕགས་མཆོག་ཉིད་ཀྱི་ཞལ་གྱིས་བཞེས་པ་ཡིན་པས་ངེས་འཚལ་ལོ།",
    "དགེའོ། ཛམ་དམར་གྱི་ཆུ་སྦྱིན་ལོངས་སྤྱོད་ཆར་འབེབས་ཅེས་བྱ་བ་བཞུགས་སོ།",
    "ཞེས་གསུངས་པའི་དོན་ཡོན་ཏན་དུ་མའི་སྒོ་ནས་ཁྱད་པར་དུ་འཕགས་པ་ཛཾ་བྷ་ལ་དམར་པོའི་རྗེས་སུ་གནང་བ་ནོད་པས་ཆུ་སྦྱིན་གཏོང་བར་འདོད་པསཟངས་གཞོང་དང་ཟན་རིལ་ཆུ་བུམ་སོགས་འདུ་བྱས་ལ་འདི་ཉིད་སྒེར་དུ་བྱེད་ན།",
    "མགྲིན་པར་ཨཱ་དམར་པོ།",
    "འབད་མེད་ལྷུན་གྱིསགྲུབ་པར་མཛད་དུ་གསོལ།",
    "དེ་ནས་གཏོར་མ་གཞན་འདོན་དགོས་ན་དེ་ལ་འཇུག་པར་བྱ་ཞིང་།",
    "རྩོད་ལྡན་དུས་ཀྱི་ཐམས་ཅད་མཁྱེན་པ།",
    "དེར་འཛིན་ཀྱི་སྐྱེས་བུ་དམ་པར་བཅས་པའི་སྐུ་ཚེ་འགྲོ་དོན་དང་བཅས་པ་ལ་གནོད་ཅིང་འཚེ་བར་བྱེད་པའི་ཀ་། དགྲ་བགེགས་རྣམས་དང་།",
    "ལྕགས་ཁང་ནག་པོ་གཏོར་མའི་རྣམ་པར་ཅན་གྱི་ནང་དུ་མ་ཤོར་མྱུར་དུ་ཁུག་ཅིག།",
    "འོ་གཟུ་དང་དཔང་དུ་བཞུགས་པ་ཁྱེད་རྣམས་བསྟན་པ་ཡོངས་བློ་གྲོས་བཀའ་ཀྱི་སྲུང་མ།",
    "གཏོར་མ་འདི་དང་མཉམ་དུ་ལྷག་མ་མེད་པར་བཞེས་ཤིག།",
    "རྒྱུག་ལོག་མ་བྱེད་པར།",
    "ཞེས་གཡོན་པའི་མཐེ་བོང་དང་མིང་མེད་ཀྱིས་བླངས་ནས་དཀུ་གཡོན་པར་བཟུང་།",
    "ཁྱད་པར་རིག་འཛིན་རྡོ་རྗེ་དྲག་རྩལ་གྱི།",
    "བསམ་དོན་ཡིད་བཞིན་འགྲུབ་པར་བྱིན་གྱིས་བརློབས།",
    "ཞེས་པའང་ཆུ་འབྲུག་ཆོ་འཕྲུལ་ཟླ་ཚེས་ལ་པདྨ་ཡེ་ཤེས་རྡོ་རྗེས་སྤེལ་བ་དགེའོ། ། བཟང་སྤྱོད་འདོན་ཐབས་ཉུང་ངུ་བཞུགས་སོ།",
    "མཐུན་འགྱུར་བདེན་ཚིག་གནང་བས་སྨོན་པའི་གནས།",
    "ཁྱད་པར་མ་ཧཱ་ཀཱ་ལ་ནག་པོ་ཆེ།",
    "མཆོད་དོ་འབུལ་ལོ་དགྱེས་པར་བཞེས་སུ་གསོལ་། དམ་ཚིག་ཉམས་ཆགས་ཐམས་ཅད་བཤགས་ཤིང་བསྐངས།",
    "ཡྀ་ཕེ་ཨུཙྪིཥྚ་བ་ལིཾ་ཏ་ཁཱ་ཧིལན་གསུམ་གྱིས་བསྔོས་ལ་གཙང་སར་དོར།",
    "དམ་ཚིག་ཉམས་ཆག་མཐོལ་ཞིང་བཤགས། བར་ཆད་དགྲ་བགེགས་དབྱིངས་སུ་སྒྲོལ།",
    "དམ་ཚིག་ཉམས་ཆག་མཐོལ་ཞིང་བཤགས།",
    "། དུས་འཁོར་ལྷན་སྐྱེས་རྒྱུན་ཁྱེར་དང་འབྲེལ་བའི་ཚོགས་མཆོད་འབུལ་ཚུལ་ཉུང་ངུ་བཞུགས་སོ།",
    "དེ་ལ་ཐབས་ཤེས་ཀྱིརྫས་ཅི་རིགས་ཚོགས་པར་བྱས་ལ།",
    "ཚོགས་འཁོར་རྒྱ་ཆེན་རང་བཞིན་རྣམ་པར་དག།",
    "རང་ཉིད་ཀྱིས་ཚིམ་པར་ལོངས་སྤྱོད་མཐར།",
    "བསྔོ་སྨོན་ཤིས་བརྗོད་བྱས་མཐར།",
    "འབུམ་། སེང་གདོང་མའི་ཚོགས་མཆོད་བཞུགས།",
    "འདིའི་བཟླས་ལུང་འབོག་པར་སྤྲོ་ན།",
    "ཤཱ་ནྱ་ཏཱས་སྟོང་པར་སྦྱང་།",
    "མགྲིན་པར་ཨཱ་ཐུགས་ཀར་ཧཱུཾ།",
    "འཇུག་ཏུ་སྐུ་སྟོང་པར་སྦྱང་།",
    "འདིར་འཕགས་ཡུལ་ལྷོ་ཕྱོགས་ར་ཁང་ཙག་མར་སྐུ་འཁྲུངས་པ་མཁས་ཤིང་གྲུབ་པ་བརྙེས་པའི་སློབ་དཔོནཤཱཀྱ་རཀྵི་ཏ་ལ་རྡོ་རྗེ་རྣལ་འབྱོར་མས་དངོས་སུ་གནང་བའི་སྒྲུབ་ཐབས་བརྒྱ་དང་བརྒྱད་ཡོད་པ་ལས།",
    "དེ་ལྟ་བུའི་སྒོམ་ལུང་སྒྲུབ་པར་བགྱི་ལྀ་ལ།",
    "ཁྱད་པར་དུ་གསོལ་བ་འདེབས་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཨཱུ་ནྱ་ཏས་སྟོང་པར་སྦྱོང་།",
    "བསྔོ་སྨོན་ཇི་ལྟར་འོས་པ་བྱས་པས་འགྲུབ་བདག་བསྐྱེད་བསྡུ་ལྡང་བྱས་ཟིན་ཅིང་མདུན་བསྐྱེད་བསྒྲུབ་མི་དགོས་པས་རྗེས་ཆོག་བྱར་མེད་དོ།",
    "ཁྱད་པར་དུ་རྡོ་རྗེའི་རིག་པ་འཛིན་པ་དང་།",
    "འགྲོགས་པར་ལྡང་བ།",
    "རྟག་ཏུ་མཉམ་པརམ་གཞག་པ།",
    "སོསོ་ཡང་དག་པར་རིག་པ་བན་དྲང་།",
    "རྣམཔར་གྲོལ་བ་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་དང་།",
    "རྣམ་པར་གྲོལ་བ་དང་།",
    "ཡེན་ན་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་མཛད་དུ་གསོལ།",
    "མར་མེའི་སྡོང་བུ་གཙང་བ་ནོར་བུ་དང་།",
    "གོང་དུ་སྨོས་པའི་ཡོན་ཏན་རྣམས་ཀྱང་ཐོབ་པར་འགྱུར་རོ།",
    "རིག་སྔགས་རྣམས་ཀྱང་ཡང་དག་པར་འགྲུབ་པར་འགྱུར་གེ།",
    "འདས་འ་ཚལ་བྱ་ཀ་ལན་ཏ་ཀ་གནས་པ་ན་བཞུགས་དེ།",
    "ཅང་སྨྲ་བར་རབ་ཏུ་འཁོད་པརགྱུར་ཏོ།",
    "རྟོགས་པ་ཐམས་ཅད་བསྐྱེད་པར་མཛད་པའོ།",
    "དབུགས་རྔུབས་པ་དང་འབདབདྲན་པ་མཁྱེན།",
    "རྟོགས་པ་ཐམས་ཅད་བསྐྱེད་པར་མཛད་པའོ།",
    "བྱང་གྲོལ་གྱི་བདེ་བ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་དང་།",
    "ཕྱག་བྱ་བའི་འོས་སུ་གྱུར་པར་བྱ་བའི་ཕྱིར་བདག་ཅག་ནང་དུ་ཡང་དག་འཇོག་པར་བཞེད་པས།",
    "ཟླ་བ་དང་ཉི་མ་བརྒྱསྟེ་ཤགན་ལྷམ་མེ་ལྷན་ནེ་ལྷང་ངེ་བ་བཞིན་ཏེ།",
    "ཡང་དེར་གླེགས་བམ་དུ་བྲི་བར་བྱས་ནས།",
    "དེརནཔརྣམ་པ་སྣ་ཚོགས་དག་ཀྱང་འབུལ་བར་འགྱུར་ཏེ།",
    "རྣམ་པར་གཏན་ལ་དབབ་པའི་གཏམ་བྱེད་པ་དག་ཏུ་འགྱུར་བའམ།",
    "ད་དུ་གནས་པར་བྱ་བའི་ཕྱིར་དང་།",
