    "དེ་ལ་ངོ་བོ་ཉིད་ནི་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་དང་བྲལ་བ་སྟེ།",
    "ཉོན་མོངས་པ་དང་བྲལ་བས་ཆགས་པ་མེད་པའོ།",
    "འོ་ན་རྣལ་འབྱོར་གྱི་མངོན་སུམ་ཉིད་ཐབས་གང་གིས་སྒྲུབ་ཅེ་ན།",
    "དེ་ལྟ་བུའི་ཟབ་མོའི་ཡེ་ཤེས་དེ་ཐབས་ཀྱིས་བསྒྲུབ་པར་བྱ་བའི་རྣམ་པ་གང་གིས་སྒྲུབ་ཅེ་ན།",
    "རྒྱུ་ཚོགས་པ་ལ་འབྲས་བུ་སྐྱེ་བས་ཏིང་ངེ་འཛིན་འགྲུབ་པའི་རྒྱུ་ཏིང་ངེ་འཛིན་གྱི་ཚོགས་ལ་གནས་པ་བསྟན་པ་ནི་གཙུབ་ཤིང་གི་དཔེས་བསྟན་ཏེ།",
    "བར་མ་ཆད་པར་གཙུབས་པ་ལས་མེ་འབྱུང་གི།",
    "ལུས་དང་ལོངས་སྤྱོད་ལ་ཆགས་པ་ནི་ཤིང་རླན་དང་བཅས་པ་ལྟ་བུ་ནི་ཡིན་པས་ལུས་ལ་ཆགས་པ་སྤང་ངོ་ཞེས་བསྟན་པ་ནི་སྡོམ་པའི་གཏམ་ཞེས་གསུངས་ཏེ།",
    "རྩེ་གཅིག་པ་ནི་ཐོབ་པའི་རྣམ་པ་སྟེ་ཞི་གནས་ཀྱི་ལམ་མོ།",
    "ཞི་གནས་དང་ལྷག་མཐོང་གིས་བསྡུས་པའི་དྲན་པ་ཉེ་བར་གཞག་པ་ལ་སོགས་པ་ནི་ཚུལ་བཞིན་ཡིན་པས་སོ།",
    "སྤང་བ་དང་བླང་བའི་མཚན་ཉིད་དང་བྲལ་བས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "བསྐྱེད་བྱ་མ་བསྟན་ན་ཅིའི་ཕྱིར་འབྲས་བུའི་མིང་གིས་གདགས་ཤེ་ན།",
    "ཀུན་ནས་ཉོན་མོངས་པ་ནི་འཁྲུལ་པ་ཡིན་པས་ངོ་བོ་ཉིད་ཀྱིས་ཏེ་རིགས་པས་མ་གྲུབ་པའོ།",
    "གཟུང་བ་དང་འཛིན་པའི་མཚན་ཉིད་ཀྱིས་ཉོན་མོངས་པ་དང་།",
    "རིག་པ་གང་གིས་ཤེ་ན།",
    "བརྟེན་ནས་སྐྱེས་པ་རང་གི་དངོས་མ་སྐྱེས།",
    "དེ་ལྟ་བུའི་ལམ་དེ་གང་གིས་རྟོགས་ཤེ་ན་སྤྱོད་པའི་བདག་ཉིད་ཀྱིས་སོ་ཞེས་ཤེས་རབ་ཀྱི་རང་བཞིན་བསྟན་པ་ནི།",
    "དེའི་ཕྱིར་དྲི་བ་སྔོན་དུ་སོང་བའི་ལམ་ནི།",
    "ཅི་ལྟར་འཛིན་པ་དེ་ལྟར་ཀུན་ནས་ཉོན་མོངས་བསྟན།",
    "བདག་དང་བདག་གིར་མི་དམིགས་རྣམ་པར་བྱང་བས་གསུངས།",
    "དེ་ལ་གང་ཡང་ཉོན་མོངས་རྣམ་དག་འགྱུར་མེད་པར།",
    "འོ་ན་ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བར་གཞག་པ་དང་འགལ་ཞེས་དེ་ཅིའི་ཕྱིར་ཞེ་ན་ཞེས་རྟོག་པ་ལ།",
    "ཡང་ན་ཀུན་ནས་ཉོན་མོངས་པའི་གཟུགས་ནི་རྟག་པ་མ་ཡིན་ལ་མྱ་ངན་ལས་འདས་པ་ནི་མི་རྟག་པར་མ་ཡིན་པའོ།",
    "ནང་གི་མུ་སྟེགས་པ་འགའ་ཞིག་མེད་པའི་དངོས་པོ་རྡུལ་ཕྲ་རབ་འབྱར་བ་ལ་སོགས་པ་འདོད་ཅིང་།",
    "ད་ནི་ཟབ་མོའི་དོན་དེ་ཉིད་ལ་འགའ་ཞིག་རྩོད་པར་རྩོམ་པ་ནི།",
    "ཀུན་ནས་ཉོན་མོངས་པ་མི་དམིགས་ན་ནི་འབད་པ་མེད་པར་གྲོལ་བའི་ཕྱིར་ལ།",
    "གལ་ཏེ་སྤངས་པའི་ཕྱིར་ཉོན་མོངས་པ་མི་དམིགས་སོ་ཞེ་ན་ནི།",
    "གཉེན་པོ་མེད་པར་ཐལ་བ་ནི་ཅི་ཞེས་རྒོལ་བའོ།",
    "འབངས་མོའི་ལྟོ་ན་རྒྱལ་པོའི་སྲས་བཞིན་དང་།",
    "བདག་གི་རང་བཞིན་ཡང་དེ་ལྟ་བུར་སྨྲ་སྟེ།",
    "ཅི་ལྟར་ཚིག་གིས་བསྟན་ཞེ་ན།",
    "ས་ཉིད་བརྗོད་དུ་མེད་པ་ཉིད་མ་ཡིན་ནམ་ཅི་ལྟར་ཚིག་གིས་བསྟན་ཞེ་ན།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "དེ་ཕྱིར་ཐེག་ཆེན་མྱ་ངན་འདས་མི་རེག།",
    "དེ་ལྟ་བས་ན་དེ་དག་དེ་ལ་རེག་པར་བྱ་བའི་ཕྱིར་ཐབས་བསྟན་པ་ནི་དེའི་དོན་དུ་ཞེས་བྱ་བའོ།",
    "དཀོན་པ་མ་ཡིན་པ་ནི་མི་དཀོན་པ་སྟེ་མོད་པའོ།",
    "དེ་ལྟར་ཟབ་མོ་ལ་མོས་པའི་དགོས་པ་བསྟན་ནས།",
    "དེ་ཉིད་ཁྱད་པར་ཟབ་མོ་ལ་མོས་པའི་ཕན་ཡོན་བསྟན་པ་ནི།",
    "ཁྱད་པར་གྱི་མཚན་ཉིད་ནི་གང་གིས་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "ཁྱད་པར་གྱི་གཞི་རྟེན་ནི་དེ་སྙེད་ཀྱི་སྐྱེས་པའམ་བུད་མེད་ཅེས་སྨོས་ཏེ་རྟེན་མཆོག་ཡིན་པས་སོ།",
    "གཞན་དག་ནི་ཡུལ་འགྲོལ་བས་ལས་དང་པོ་པ་མོས་པ་དང་ལྡན་པ་རྣམས་ནི་ངེས་པ་སྟེ་མི་ལྡོག་པར་འགྱུར་བའོ།",
    "ལས་ཀྱི་སྒྲིབ་པ་ནི་ལས་ཀྱི་སྒྲིབ་པའི་ངོ་བོ་ཉིད་དེ་ལས་ཀྱི་སྒྲིབ་པ་གང་གིས་ལས་ལ་སྒྲིབ་པའོ།",
    "ལ་ལ་ནི་རྒྱུ་ནི་ནང་གི་ཉེ་བར་ལེན་པ་དང་།",
    "སྟོང་པ་ལ་སྟོང་པས་གླགས་མི་རྙེད་པས་ན་ཉོན་མོངས་པ་མེད་པའོ།",
    "སེམས་ཅི་ལྟ་བར་ཉོན་མོངས་པ་ཡང་དེ་བཞིན་པས་གང་ཞེས་གསུངས་སོ།",
    "ཉོན་མོངས་པ་ཟད་ཀྱང་ལས་ཀྱི་འབྲས་བུ་འབྱིན་ནོ་ཞེ་ན།",
    "གང་སྒྲིབ་པ་མེད་པ་དེ་ལ་ཞེས་གསུངས་ཏེ་ཉོན་མོངས་པ་ཟད་ན་གྲོལ་བར་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "འོ་ན་ཉོན་མོངས་པ་ཟད་ན་ལས་སོགས་པར་མི་བྱེད་ལ་ལས་ཀྱི་སྒྲིབ་པ་ནི་ཉོན་མོངས་པ་ལས་གྲོལ་བར་རིགས་པ་མ་ཡིན་པས་ཅི་ལྟར་འཐད་ཅེ་ན།",
    "དེ་ལ་ཆོ་ག་ནི་བཅས་པའི་ཉེས་པ་ཕྲ་མོ་ལ་བྱའོ།",
    "གཉེན་པོའི་ངོ་བོ་གང་གིས་རང་བཞིན་མེད་པར་རྟོགས་ན་ཞེས་བྱ་བ་སྟེ་ཉོན་མོངས་པ་ཤེས་ན་དེ་སྤོང་བ་སྟེ་དཔེར་ན་ཀླུའི་རིགས་འདོན་ཤེས་ན་གནོད་པ་མི་བྱེད་པ་ལྟ་བུའོ།",
    "རྣམ་པར་ཤེས་པ་གྱུར་པ་ཡིན་པས་ནང་གི་སེམས་དེར་སྣང་བས་ཆུ་ཟླ་ལྟ་བུ་སྟེ།"
  ]
}