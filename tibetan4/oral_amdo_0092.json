    "འདོད་པ་ནི་བདག་གི་ཡོན་ཏན་ནི།",
    "གྲོང་རྡལ་ནི་ཚོང་འདུས་ཀྱི་ཁྱིམ་མོ།",
    "ཡོན་ཏན་ལ་སོགས་པ་ཐོབ་པར་འདོད་པའི་རེ་བའི་ཡིད་ཀྱིས་ཚུལ་གཞན་དུ་སྒྱུར་བ་ནི་སླུ་བས་ན་གཡོའོ།",
    "འདིར་ལས་དང་པོ་པ་དག་དཀར་པོ་ཡོངས་སུ་འཛིན་པ་ལ་མ་བརྟེན་པ་ན་ཐབས་གང་གིས་འཇུག་པར་འགྱུར།",
    "རང་གི་སྤྱོད་པས་སོ་ཞེ་ན།",
    "འཕྱོན་མའི་བུད་མེད་སྦྲུམ་མ་བཞིན།",
    "སྲོག་གི་ཕྱིར་ཡང་གཏང་བར་མི་བྱ་ཞེས་གསུངས་པ་ནི།",
    "སྒྲུབ་པ་དང་ལྡན་པ་རེ་རེས་ཀྱང་གཉིས་ཀ་འགྲུབ་བོ།",
    "གཉིས་ཀྱིས་ནི་རེ་རེས་འགྲུབ་པ་མ་ཡིན་ནོ།",
    "མདའ་གཉིས་རེ་རེ་དྲང་སྲོང་དང་།",
    "བསྡུས་ཏེ་རྣམ་པ་རེ་རེ་གཉིས།",
    "ཞི་གནས་དང་ལྷག་མཐོང་གི་ཁྱད་པར་རོ།",
    "ཡོངས་སུ་བསྲུང་བ་ནི་རང་གི་ཤེས་རབ་སྐྱེད་པར་བྱེད་པས་སོ།",
    "གསུང་གི་མཛོད་ཀྱི་གཅེས་པ་ཟབ་མོས་ཏེ།",
    "གནས་པར་བྱེད་པ་ན་སྔ་མ་ལྟར་རང་གི་ཤེས་རབ་བསྐྱེད་པས་སོ།",
    "ལ་ལ་ནི་ཡོན་ཏན་མཐའ་དག་གི་དཔེ་ཡིན་པར་འདོད་དོ།",
    "ལ་ལ་ན་རེ་ཕྱོགས་མཚོན་པ་ཡིན་ནོ་ཞེས་ཟེར་ན།",
    "མི་ཕྱེད་པ་ནི་བདུད་དང་བདུད་ཀྱི་རིས་ཀྱིས་བྱིན་གྱིས་བརླབས་པའི་གང་ཟག་གི་རྗེས་སུ་མི་འཇུག་པའོ།",
    "མོས་པས་སྤྱོད་པའི་ལས་སོ།",
    "ཡིད་ལ་མེད་པར་འདུ་ཤེས་གང་གིས་ན།",
    "གང་གིས་དེ་བཞིན་གཤེགས་པ་མཐོང་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རང་གི་ངོ་བོ་ཉིད་རྣམས་ལ།",
    "སྦྱིན་པ་ལ་སོགས་རེ་རེ་ནི།",
    "དྲུག་ཚན་དྲུག་གིས་ཇི་བཞིན་བཤད།",
    "དེའི་གང་ཟག་གི་མཚན་ཉིད་ནི།",
    "དམན་པ་ལ་མོས་པ་འགའ་ཞིག་དེ་བཞིན་གཤེགས་པའི་མྱ་ངན་ལས་འདས་པའི་རང་བཞིན་མི་ཤེས་པས་འདུས་བྱས་ཀྱིས་ཐོབ་པ་དང་བྲལ་བ་འདུས་མ་བྱས་པའི་རྗེས་ཡིན་ནོ་ཞེས་ཟེར་ལ།",
    "ལ་ལ་ན་རེ་ནམ་མཁའི་སྤྲིན་དེངས་པ་ལྟ་བུར་གྱུར་ཏོ་ཞེས་དངོས་པོར་ལྟ་བས་བཅིངས་པར་ཇི་ལྟ་བར་མི་ཤེས་པས་རྒོལ་བ་ནི།",
    "དེ་དག་གིས་མྱ་ངན་ལས་འདས་པའི་རང་བཞིན་བསྟན་པའི་ཕྱིར།",
    "དེ་ལ་ཡོད་པར་ལྟ་བ་ནི་ཕྱི་དང་ནང་གིས་མུ་སྟེགས་པ་འགའ་ཞིག་རྟག་པ་དང་།",
    "གང་ཟག་ཏུ་ལྟ་བ་རྣམས་ནི་མེད་པའི་དོན་གྱིས་བདག་གི་རང་བཞིན་གྱི་མཐའོ།",
    "ཅི་ལྟ་བ་བཞིན་ཞེས་པ་ནི་དེ་དག་ཐམས་ཅད་རང་བཞིན་གྱིས་སྟོང་གི་ཡོད་པས་བཤིགས་པ་ལྟ་བུ་མ་ཡིན་པས་སོ།",
    "འདི་ལས་ལྷག་པ་གང་གིས་དངོས་པོ་མི་བརྫུན་ལ།",
    "གང་གི་སྐྱེ་བ་རྣམས་བརྟགས་ལ།",
    "དངོས་པོ་གཅིག་པུའི་ངོ་བོ་ཉིད་རྣམ་པ་སྣ་ཚོགས་མང་བར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་དང་པོ་སྔར་བྱུང་བ་ཕྱིས་དགའ་མགུར་འདོགས་པའི་ཚིག་ཉེ་བར་འདོགས་ན་ནི་འདོགས་པའི་ཚིག་གིས་ཉེ་བར་འདོགས་པའི་སྔ་རོལ་དེས་ཉེ་བར་མ་བཏགས་པའི་ཚེ།",
    "ངོ་བོ་ཉིད་མེད་ན་ཡང་དངོས་པོ་མེད་པ་ལ་ནི་འདོགས་པའི་ཚིག་གིས་ཉེ་བར་ཇི་ལྟར་གདགས།",
    "འདོགས་པའི་ཚིག་གིས་ཉེ་བར་འདོགས་པ་དེ་མེད་ན་ཡང་།",
    "གལ་ཏེ་འདོགས་པའི་ཚིག་གིས་ཉེ་བར་འདོགས་པའི་སྔ་རོལ་ནས་གཟུགས་དེ་གཟུགས་ཀྱི་བདག་ཉིད་ཡིན་ཏེ།",
    "ཕྱིས་ཀྱང་དེ་ལ་གདགས་པའི་ཚིག་གིས་བསྡུས་པའི་དུས་སུ་གཟུགས་སུ་ཉེ་བར་འདོགས་པར་བྱེད་ན་ཡང་།",
    "ལ་ལ་ན་རེ་མ་སྐྱེས་པ་དང་མ་བྱུང་བ་ནི་ངོ་བོ་གཅིག་ལ་ཐ་སྙད་གཉིས་སུ་བཏགས་པའོ་ཞེས་ཟེར་རོ།",
    "ལ་ལ་ན་རེ་མ་སྐྱེས་པ་ནི་ད་ལྟར་རོ།",
    "གཞན་དག་ནི་སྤང་བྱའི་ཉོན་མོངས་པ་ལ་སོགས་པ་ནི་སྐྱེ་བ་མེད་ལ།",
    "ད་ལྟར་སྤང་བྱ་དང་སྤོང་བྱེད་མེད་ན་གང་གིས་གང་ཞིག་ཅི་ལྟར་སྤོང་སྟེ།",
    "དཔེར་ན་གཟུགས་ལ་སོགས་པའི་ཕུང་པོ་རྣམས་ཡོད་ན་གང་ཟག་ཏུ་གདགས་སུ་རུང་གི།",
    "ཟབ་མོ་སྟོང་པ་ཉིད་དང་ལྡན་པ།",
    "དེ་དག་གི་ལྟར་ན་འདོགས་པའི་གཞིའི་དངོས་པོ་ཙམ་ཡང་མེད་པས་འདོགས་པ་ཉིད་ཀྱང་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་མེད་པར་འགྱུར་ན།",
    "དེ་བས་ན་དེ་དག་གིས་ནི་དེ་ཁོ་ན་ཉིད་དང་།",
    "གང་ཟག་ཏུ་ལྟ་བ་ནི་ཤེས་བྱ་ལ་རྨོངས་སུ་ཟིན་ཀྱང་ཤེས་བྱ་ལ་སྐུར་པ་མི་འདེབས་པས་ན་ངན་སོང་དུ་ཡང་སྐྱེ་བར་མི་འགྱུར་ལ།",
    "གང་ལ་གང་གིས་སྟོང་པ་དེ་ལ་ཡང་མི་འདོད་ལ།",
    "གང་གིས་གང་སྟོང་པ་དེ་ཡང་མི་འདོད་པ་འདི་ལྟ་བུ་ནི་ལོག་པར་ཟིན་པ་ཞེས་བྱ་སྟེ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་གང་གིས་སྟོང་པ་མེད་པ་དང་།",
    "ཐམས་ཅད་མེད་ན་ནི་གང་དུ་ཅི་ཞིག་གང་གིས་སྟོང་པར་འགྱུར་ཏེ།",
    "ཁོ་བོ་ཅག་ཤེས་བྱ་ནང་གི་ཡིན་པར་འདོད་པ་ལ་སུན་འབྱིན་པའི་གང་ཟག་ཞེ་སྡང་བས་སྨྲ་བ་རྣམས་ཀྱིས་ལོག་པར་ཟིན་པའི་རྣམ་གྲངས་མང་དུ་ཡོད་མོད་ཀྱི།",
    "ཕྱོགས་འགའ་ཞིག་ཅེས་བྱ་བ་ནི་མོས་པས་སྤྱོད་པའི་ས་ལ་མོས་པས་ཡུལ་དུ་བྱེད་པ་ན་ཁོང་དུ་ཆུད་པར་འདོད་པ་སྟེ་འདུན་པའོ།",
    "མོས་པས་སྤྱོད་པའི་ས་ཆེན་པོ་ལ་བདེན་པ་རྟོགས་པ་དང་།",
    "དེ་དག་ཀྱང་དངོས་པོར་མ་ཞེན་པར་ཀུན་རྫོབ་ཀྱི་སྒོ་ནས་ཡེ་ཤེས་ཀྱི་སྐད་ཅིག་གིས་རྗེས་སུ་འབྲང་བར་བྱ་ཞེས་བྱ་བ་སྟེ།",
    "མྱ་ངན་ལས་འདའ་བར་སྣང་བ་ཡང་ཐུགས་རྗེ་ཉི་ཚེ་བ་མ་ཡིན་མོད་ཀྱི།",
    "སྟོང་པ་ལྟ་བུ་ནི་ལས་དང་ཉོན་མོངས་པའི་སྒྲིབ་པས་ཁེབས་པ་སྟེ།",
    "འོ་ན་དེ་བཞིན་གཤེགས་པ་གཅིག་གིས་ཕྲིན་ལས་མཛད་པ་ཟིན་ན།",
    "ཞེས་བྱ་བའི་ཚུལ་གྱིས་རེ་ཞིག་གཞག་གོ།",
    "རིག་པ་ནི་ལྷ་མོ་དང་འབྲེལ་བ་སྟེ།",
    "ལ་ལ་ན་རེ་བསྐལ་པ་གྲངས་མེད་པ་སུམ་ཅུ་རྩ་གསུམ་གྱིས་ངེས་པར་འབྱུང་ངོ་ཞེས་ཟེར་རོ།",
    "དེ་དག་གི་དོན་བསྡུ་བ་ནི་ཀྱེ་རྒྱལ་བའི་སྲས་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལས་དང་ཉོན་མོངས་པ་ནི་རྒྱུ་ཡིན་ལ།",
    "རབ་ཏུ་རྨོངས་པས་གོང་འོག་གི།",
    "ལམ་གྱི་བདེན་པས་འདུས་བྱས་པའི་སྒོ་ནས་ཉོན་མོངས་པ་སྤངས་པའི་ཕྱིར་རོ།",
    "མོད་གལ་གྱི་བུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དུས་ཐམས་ཅད་པ་ནི་ཡིན་པས་དེའི་ཚེ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་དག་གིས་འཕགས་པ་བྱམས་པ་ལ་སོགས་པའི་དགོངས་པ་མ་རྟོགས་ཤིང་མི་ཤེས་པར་རིག་པར་བྱའོ།",
    "ཟབ་མོའི་དོན་ལ་རིགས་པ་མ་ཡིན་ཏེ་ལུང་ཡོད་དོ་ཞེ་ན།",
    "རིགས་དེ་ཉོན་མོངས་པ་ལ་སོགས་པས་སྣང་བར་མ་གྱུར་པས།",
    "རེ་ཞིག་རིགས་ལྔར་གསུངས་པ་ཡིན་ཏེ།",
    "ཉོན་མོངས་ཐིབས་པོས་བཀག་པ་ཡིས།",
    "རིགས་པ་ཅི་ལྟ་བ་བཞིན་དུ་ལུང་གིས་གཏན་ཚིགས་བཀོད་པ་ནི།",
    "ཕན་ཡོན་རྣམ་པ་བཞི་མཚོན་པའི་དོན་དུ་ལེགས་པ་དང་པོ་རང་གི་ལམ་ལ་ཐེ་ཚོམ་མི་ཟ་བ་བསྟན་པ་ནི།",
    "རོ་གཅིག་པ་ནི་གཟུགས་ཀྱི་དེ་བཞིན་ཉིད་ཀྱིས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་རྗེས་སུ་སོང་བ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཉིད་ཀྱིས་གཟིགས་པའི་ལམ་སྟོན་པས་ན་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་རོ།",
    "ཕྱིར་མི་ལྡོག་པའི་འཁོར་ལོ་ནི་དེ་ལྟ་མོད་ཀྱི།",
    "རེ་ཞིག་དཔེས་གོ་བར་བྱ་བའི་ཕྱིར།",
    "བག་ལ་ཉལ་ནི་ཕྲ་བར་གཟིགས།",
    "ངོ་བོ་རྒྱུ་དང་འབྲས་བུས་སྟོང་པའི་རང་བཞིན་བསྒོམས་ན་ཉོན་མོངས་པ་སྤོང་བར་འགྱུར་བས།",
    "ཤིང་དང་སྣམ་བུའི་བྱི་དོར་ནི་སྔར་གྱི་སྦྲུམ་མའི་རེག་བྱ་འདོར་བར་བྱེད་པ་སྟེ་དེ་བས་འཇམ་པའི་རེག་པའི་བྱི་དོར་བྱེད་པ་ལྟར།",
    "རས་སྲབ་མོ་དཔེར་བྱ་བ་ནི།",
    "ས་རྣམ་པ་དགུ་ལ་ཤེས་བྱའི་སྒྲིབ་པ་སྲབ་མོ་སྦྱང་དགོས་པའི་ཕྱིར་རོ།",
    "བ་རུ་རའི་ཕུང་པོ་ལས་རེ་རེ་ནས་དོར་ཡང་།",
    "ཐམས་ཅད་ཀྱང་མཐར་རིམ་གྱིས་སོང་བ་ནས་འཚང་རྒྱ་བར་འགྱུར་ཏེ།",
    "བཙུན་མོ་སྔོ་བསངས་མ་ཤི་བ་བརྡ་སྤྲོད་པ་ལྟར།",
    "དེ་ལྟར་མི་འཇུག་ཅིང་བསམ་པ་དམན་པ་ཡང་གང་གིས་ཉེས་ཤེ་ན།",
    "དམན་པར་མོས་ཤིང་ཁམས་ཀྱང་ཤིན་ཏུ་དམན།",
    "གྲོགས་པོ་དམན་པ་དག་གིས་ཡོངས་བསྐོར་བ།",
    "མོས་པ་སྟེ་སྤོང་བ་དག་གོ་ཞེས་བྱ་བའོ།",
    "བག་ཆགས་ནི་ཉོན་མོངས་པ་དང་རྗེས་སུ་མཐུན་པའི་སྤྱོད་པ་སྟེ།",
    "དྲོད་དང་རྩེ་མོའི་གནས་སྐབས་སུ་རྟོགས་པ་ནི་སྤོབས་པའོ།",
    "བདུད་ནི་ཉོན་མོངས་པ་ལ་སོགས་པའོ།",
    "རང་གི་དོན་ལ་མི་ཕྱོགས་པ་ནི།",
    "གཞིར་གྱུར་པས་ན་མ་མོ་ལྟ་བུའོ།",
    "སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོ་མེ་མུར་གྱིས་གང་བའི་འོབས་སུ་བསྐལ་པ་གཅིག་གིས་ཀྱང་ཚིགས་སུ་བཅད་པ་གཅིག་ཀྱང་ཡོངས་སུ་ཚོལ་ལོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "དངོས་གཞི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གིས་ཟིན་པ་དང་།",
    "ཅུང་ཟད་ཙམ་གྱིས་ཆོག་པར་འཛིན་པའི་ཕྱིར་ཡེ་ཤེས་ཀྱི་ཚོགས་ལ་དགོད་པ་ནི་ཤིང་གི་བར་དུ་ཞེས་གསུངས་སོ།",
    "སེམས་བསྐྱེད་པ་ན་ཞེས་བྱ་བ་ནི་ཟང་ཟིང་གི་སྦྱིན་པ་དང་ལྡན་པའི་དངོས་པོ་ནི་ཡེ་ཤེས་ཀྱི་ཚོགས་བསྐྱེད་པའི་བསམ་པས་ཟིལ་གྱིས་གནོན་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་ཕྱིར་ཐུན་མོང་བ་ཉིད་དོ་ཞེས་རྒོལ་བ་ནི།",
    "རང་གི་ཉིད་ལ་འཇུག་ཕྱིར་དང་།",
    "རང་གི་འདུལ་ལ་སྣང་ཕྱིར་དང་།",
    "ཟབ་མོ་ནི་སྟོང་པ་ཉིད་ལ་སོགས་པ་སྟེ།",
    "ཟབ་མོ་སྟོང་པ་ཉིད་སྒྲོ་འདོགས།",
    "ལ་ལ་ཟང་ཟིང་གིའོ་ཞེས་ཟེར་ཏེ།",
    "ལ་ལ་ན་རེ་ལུང་སྟོན་པ་ལུང་བསྟན་པ་ལ་བྱ་སྟེ།",
    "ལ་ལ་ན་རེ་མངོན་དུ་ལུང་བསྟན་པ་ལ་བྱའོ་ཞེས་ཟེར་ཏེ།",
    "མར་མེ་མཛད་ནི་ལ་ལ་ན་རེ།",
    "ལ་ལ་ན་རེ་དེ་ལྟ་ན་ས་བརྒྱད་པའི་གནས་སྐབས་སུ་མི་འགྱུར་ཏེ།",
    "རྣམ་གཟིགས་མར་མེ་རིན་ཆེན་གཙུག།",
    "ལ་ལ་ན་རེ་ཉན་ཐོས་བསམ་པ་དམན་པ་ལ་ལྟོས་ནས་དེ་སྐད་བཤད།",
    "ཁ་ཅིག་ཏུ་ནི་བདུན་ཁྲི་ལྔ་སྟོང་གི་ཐ་མ་ནི་ཡུལ་འཁོར་སྐྱོང་ཡིན་པ་ནས།",
    "ལ་ལ་ན་རེ་བསྐལ་པ་གྲངས་མེད་པ་སུམ་ཅུ་རྩ་གཉིས་སངས་ཀྱི་ས་ཐོབ་པ་ལས་ཚོགས་ཀྱི་ལམ་ནི་བསྐལ་པ་གཅིག་གིས་སོ།",
    "པདྨ་ཅན་གྱི་ཚོང་འདུས་ཀྱི་དབུས་སུ་སྤོས་འཚོང་གི་ཁྱེའུར་གྱུར་པས་ཨུཏྤ་ལ་ལྔ་གཏོར་བའི་ཚེ།",
    "ལ་ལ་ན་རེ་ལུང་བསྟན་མ་ཐག་ཏུ་ཞེས་ཕན་ཡོན་དུ་འདྲེན་ནོ།",
    "ལ་ལ་ན་རེ་གང་ཟག་བདག་མེད་པ་དང་གཟུང་བ་མེད་པར་རྟོགས་པ་དང་།",
    "མཆོག་ཅེས་བྱ་བ་ནི་དམ་པར་གྱུར་པ་སྟེ་ཉོན་མོངས་པ་སྤངས་པའི་ཕྱིར་ཚོགས་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
