    "ཏེང་ཞའོ་ཕིང་གི་རིགས་པའི་གཞུང་ལུགས་དང་།",
    "སྐྱེད་མོས་ཚལ་ལ་སྐྱིད་མོས་ཚལ།",
    "གི་གུ་ཕྱིར་ལོག་པ་དཔེར་ན་ཡྀན།",
    "རྗེས་འཇུག་གམ་ཡང་འཇུག་གོང་གི་ཡི་གེའི་འོག་ཏུ་བྲིས་པ་དཔེར་ན་རྟགྶ།",
    "གཞན་ཡང་མ་ཡིག་གི་དཀྱིལ་དུ་ཤོག་གྲངས་ཆད་སྐྱོན་ཡོད་པ་སོགས་ཀྱི་གནས་ཚུལ་འདུག་པས།",
    "གི་གུ་ཕྱིར་ལོག་པ་སོགས་ཀྱི་འབྲི་ཚུལ་ཚང་མ་མ་ཡིག་ལ་བརྩི་སྲུང་ཞུས་ནས་ཇི་མ་ཇི་བཞིན་དུ་རང་སོར་བཞག་ཡོད་པ་ལས།",
    "པོ་ཞིག་ཡིག་ཚགས་ཁང་གི་འབྲེལ་ཡོད་ལས་གྲོགས་ལྷན་རྒྱས་ཀྱི་ངལ་བ་ལས་བསྐྱངས་ཡོད་པས།",
    "ཐུབ་བསྟན་རྒྱལ་མཚན་རྩེ་མོར་རབ་མཆོད་མཆོག་དང་ཐུན་མོངས་གཟི་འོད་དཔལ་འབར་སྲིད་དང་ཞི་བའི་རྒུད་པ་བསལ་ནས་ཡུན་རིང་སྒྲོད་དཀའི་ལམ་ལ་ལྟོས་མེད་རྣམ་མཁྱེན་འབྲས་བུ་ལུས་འདིས་ཚེ་གཅིག་ཉིད་ཐོབ་འཕགས་ཡུལ་ཞིང་དེ་དགོས་འདོད་ཆར་གྱིས་གང་།",
    "སྐྱེ་འགྲོ་མུན་སེལ་བསྟན་པའི་གསལ་བྱེད་སྤྲུལ་པའི་སྐྱེས་མཆོག་ཉིན་མཚན་མགོན་ནི་རང་གི་སྤྲུལ་པའི་གཟའ་སྐར་འཁོར་ལྡན་ཇི་སྙེད་འོད་ཀྱིས་རྨོངས་པའི་མུན་གསལ་གངས་ཅན་ལྗོངས་འདིར་ལུང་རྟོགས་སྣང་བས་ཁྱབ་ཅིང་མཆོག་དང་ཐུན་མོངས་འབྲས་བུའི་དངོས་ཀུན་གསལ།",
    "ཡུལ་ཉི་ཤུ་རྩ་བཞི་གནས་གསུམ་བཅུ་རྩ་གཉིས་དུར་ཁྲོད་ཆེན་པོ་བརྒྱད་ལ་སོགས་ཏེ་ཕྱི་ནང་གསང་བའི་ཞིང་གི་དཔའོ་མཁའ་འགྲོ་ཀུན་གྱི་ཚོགས་ཀྱི་བདག་པོ།",
    "ཐུན་མོང་གི་གདུལ་བྱ་མཐའ་དག་ལ་རྣམ་དཀར་གྱི་ལས་འབྲེལ་འཇོག་ཅིང་།",
    "རྒྱུད་པ་མི་རབས་བཅུ་གསུམ་དུ་ང་རང་གི་བྱིན་གྱིས་རླབས་པས་ངན་སོང་མེད་ཅེས་གསུངས་པའི་རྒྱུད་པ་མི་རབས་དགུ་པ།",
    "རྗེ་ཉིད་ཐ་ཆུང་གི་གོང་མ་ཡིན་ལ།",
    "ངོ་མཚར་རྨད་དུ་བྱུང་བའི་མཛད་པས་ཚེ་གཅིག་གིས་བཅུ་གསུམ་རྡོ་རྗེ་འཛིན་པའི་ས་སྒྲོད་ཀྱང་།",
    "བྱང་ཕྱོགས་གི་ཞིང་འདིར་འོག་མིན་ལྷུན་གྱི་གྲུབ་པའི་ཞིང་ཁམས་ནས།",
    "ཡུམ་གྱི་རྣམ་ལམ་དུ་ཉི་མ་བདུན་ཤར་ནས་དེ་དག་གི་འོད་ཡུམ་གྱི་སྐུ་ལུས་ཕོག་པས།",
    "བདེ་སྟོང་གཉིམས་སྐྱེས་ཤིང་རྟོག་མེད་དུ་རེ་ཞིག་ལུས་པ་ལས་མནལ་སད་ཏེ།",
    "མོ་དེ་ཁྱོད་ཀྱི་སྲིད་འདི་ལ་ཁྱོད་ཀྱིས་སེམས་ལས་བྱེད་མི་དགོས།",
    "ཁོང་གིས་ཁྱོད་ཀྱི་སེམས་ལས་མཛད་པ་གཅིག་ཡིན་ཟེར་བ་དང་མནལ་སད་དོ།",
    "རྒྱལ་པོ་ཟས་གཙང་གི་སྲས་རྒྱལ་བུ་དོན་གྲུབ་དུ་སྐུ་བསྟམས་པ་དང་ཚུལ་མཚུངས་པར་དཔལ་ལྡན་གཞད་པ་རྡོ་རྗེ་རྒྱུ་འཕྲུལ་བཀོད་པའི་བདག་ཉིད།",
    "སྐྱེ་བོ་ཕལ་པ་ལས་མཆོག་དུ་རིང་བས་དཔུས་འཁྱུད་ཀྱི་ཚུལ་དུ་མཛད་ཅིང་ཕྱག་ཐལ་མོ་སྦྱར་བ་དང་བཅས།",
    "རོལ་མོའི་སྒྲ་དང་དྲི་བཟངས་ཉེ་འཁོར་ཀུན་གྱིས་ཚོར་བ་བྱུང་ངོ།",
    "ཁྱད་པར་རང་གི་ཞིང་གཅིག་གི་ཐོག་ཀྱང་སྔར་བས་བཅུ་འགྱུར་གྱི་མང་བ་སོགས་ཕྱི་ནང་གི་མི་རྣམས་ཕུན་ཚོགས་ལ་སྤྱོད་པར་གྱུར་ཏོ།",
    "ཡུམ་གྱི་མནལ་ལམ་དུ་ཡུམ་རང་གིས་ཀ་བ་ཆེན་པོ་བཞི་ས་ལ་རྩུགས་པ་ལས།",
    "ཀ་བ་དེའི་སྟེང་ན་བྱ་རོག་འདུག་པ་མཉམ་གཟིགས་པས།",
    "ལྷུང་གི་དོགས་ནས་ས་ལ་མི་ཆགས་པ་ཙམ་བྱུང་ཚེ།",
    "གཞོན་ནུའི་གསུང་གིས་ཨ་མ་སྡུག་བསྔལ་བྱེད་མི་དགོས།",
    "ང་སེང་གེ་དཀར་མོ་ལ་ཞོན་ནས་བར་སྣང་ན་གདང་ཡོད།",
    "རང་རེ་མ་བུ་ཁྲད་ཡོང་གིས་གསུང་བ་དང་མནལ་སད།",
    "ཚེས་བཅོ་ལྔའི་ནུབ་མོ་ཡུམ་གྱི་མནལ་ལམ་དུ་བུད་མེད་དཀར་མོ་ཅིག་ན་རེ།",
    "སློབ་དཔོན་ཆེན་པོ་པདྨ་འབྱུང་གནས་མཁའགྲོ་དུ་མའི་འཁོར་དང་བཅས་པ་གཟིགས་ཤིང་།",
    "སྟག་ཚལ་ནང་གི་ཕྱི་རོལ་ནས།",
    "རྗེ་དེ་ཉིད་ཀྱི་བཅུང་པོ་ལས་ཀྱི་མགོན་པོ་བྱ་རོག་གདོང་གི་རྣམ་འཕྲུལ།",
    "དེ་ནས་དགུང་ལོ་དྲུག་གི་དུས་སུ་མཁར་ཁའི་སྐྱིད་དེ་ཕུག་སོགས་གནས་སོ་སོར་བྱིས་པའི་འཁོར་ཚོགས་བསྡུས་ནས།",
    "སྐུའི་རྩེད་མོ་ཐམས་ཅད་དཀྱིལ་འཁོར་འབྲི་བ་དང་།",
    "གཞོན་ནུ་རང་གི་མནལ་ལམ་དུ་མཁའགྲོ་རིགས་ལྔས་གསང་བའི་ཚོགས་མཆོད་འབུལ་པ་དང་།",
    "དགུང་ལོ་དགུ་པ་ལ་རྒྱལ་སྲས་རང་གི་རྣལ་ལམ་དུ་མི་ནག་པོ་ཆེན་པོ་ཅིག་གི་གྲི་གུ་གཅིག་བྱིན་ནས་ཁྱོད་ཀྱིས་དྲག་པོའི་འཕྲིན་ལས་གྲུབ་པས།",
    "ང་ལ་བླང་ཁྱོད་ཀྱིས་ཕེར་ནི་མི་ཕེར་གསུངས་ཚེ་ངས་ཕེར་གསུངས་ནས་བུས་པས།",
    "བཅུ་གཅིག་པར་སོན་པའི་ལོ་གསར་ཀྱི་ཚེས་བཅུའི་ནུབ་མོ་གཞོནུ་རང་གི་རྣལ་ལམ་དུ།",
    "ཐོད་མཁར་མེ་དཔུང་འབར་བའི་ནང་དུ་མི་ལྤགས་ཀྱི་བླ་རེས་དང་ཡོལ་བ་སོགས་དྲག་པོའི་གཞལ་ཡས་ཁང་གི་དབུས་སུ།",
    "པད་ཉི་རོ་གདན་ལ་སྐུ་དུར་ཁྲོད་ཆས་ཀྱིས་བརྒྱན་ཏེ་བཞུགས་པ་རྨིས་རྣལ་སད་པ་དང་ནམ་ཐོ་རངས་སུ་སོང་འདུག་ཅིང་།",
    "འདོད་སྲེད་ཀྱི་ཐུགས་འདུན་བྱུང་ཚེ་མགུལ་གྱི་ཐུམ་བུ་དེ་ལ་རེག་པ་རེ་མཛད་པས་ངན་རྟོག་རང་ཞི་ལ་སོང་གསུང་།",
    "བཀའ་བརྒྱུད་གོང་མ་རྣམས་ལ་ལྷག་པར་མོས་པས་ཡིད་དུ་འོང་བའི་དངོས་པོ་ཅི་གཟིགས་ཀྱང་།",
    "བརྒྱད་སྟོང་པ་གཉིས་ལན་རེ་གཟིགས་པས་ཐུགསུ་ཆུད་ཅིང་།",
    "ཁྱོད་རང་གནོན་ཅིག་གསུངས་དབུའ་སྟུམས་ནས་ཁོས་མི་ནོན་པ་ཙམ་དུ་སྟོན་པས།",
