    "མི་རྣམས་ན་རེ་སྐྱབསུ་མཆི་ཐང་སྟོང་རྒྱལ་པོ་ཡིན་པ་སྲིད་ཟེར།",
    "དེ་རྗེས་རྟ་གཞན་རྣམས་ཀྱང་འཁྱོགས་ནས་སོང་དེ་ནས་སླར་རྟ་པ་ཅིག་གློག་གཏང་བྱུང་ཏེ།",
    "དེ་ནས་ལྷ་སར་ཕེབས་ཚེ་སྲིན་པོ་བྱུང་ཟེར་ཁྲོམ་ཀུན་འུར་ཞིང་རྒྱ་ཀྲམ་པ་རྣམས་ཀྱང་སྡོགས་ཏེ་མི་ཐད་ནང་དུ་གྲོས་སོང་།",
    "དེ་ནུབ་ལྕང་སྡོང་གཅིག་གི་སྟེང་དུ་གཟིམས་སང་མི་རེ་རེ་གཉིས་གཉིས་ཙམ་ཐོན་བྱུང་བ་ལ།",
    "ཅང་ཏིའུ་རྡུང་ཞིང་རྐང་གླིང་བུས་པས་ཡང་མི་རྣམས་གྲོསོང་།",
    "སྲོག་ཆགས་གྲོག་མོས་རི་མི་མཐོང་།",
    "ཐ་ན་རི་མོར་བྲིས་པ་འདྲ་ཡང་མ་མཐོང་ངམ།",
    "གང་གི་སྤྱོད་པ་བྱ་བའི་གང་ཟག་གང་དུ་སྤྱོད་པའི་གནས།",
    "རྒྱུད་མཐའ་དག་གི་རྒྱབ་སྐྱོར་ལུང་རིགས་དང་བཅས་པ་སྣང་ནས་ངེད་ཀྱི་ཡིན་ལུགས་དེ་ལྟར་ཡིན།",
    "བསྒྲུབས་དང་གསུངས་པས་ཅི་ཡང་སྨྲ་མ་སྤོབས་པར་བསྐྱངས་ཏེ་གྲལ་ལས་ལངས་སོང་།",
    "དཔོན་པོ་ན་རེ་མདངས་ས་ར་ཧ་དང་འཇལ་བ་རྨིས།",
    "ཆུ་བར་ལ་ཕེབས་པར་ཆས་པ་ན་ཡུམ་གྱིས་གསུང་གིས།",
    "དཔལ་ཆེན་རི་བོ་ཆེའི་རྩར་ཕེབས་པ་དང་དཔོན་པོ་བ་མངོན་ལ་བཏང་རྗེ་ཡིས་རྗེས་ནས་ཕེབས་ཚེ་གྲུབ་ཆེན་ཐང་སྟོང་རྒྱལ་པོ་རི་བོ་ཆེའི་རྩེ་མོ་ན་ཚེས་བཅུའི་ཚོགས་འཁོར་མཛད་པ་དང་ཐུག་དེར་ཡང་ཟང་ཐལ་ལ་ཕེབས་ཏེ་གྲུབ་ཆེན་གྱི་སྐུ་འཁྲིས་ན་ཤིང་ཕོར་ཤིན་དུ་ཆེ་བ་ཕྱི་ནང་གཉིས་ཀ་སྐྱོམས་གོས་པ་ཅིག་ཆང་གིས་གང་འདུག་པ།",
    "གྲུབ་ཆེན་གྱི་གསུང་ནས་རྣལྱོར་པ་བརྟུལ་ཞུགས་ཅན་ཞིག་འདུག་ང་ལ་ཡང་ཁྱོད་མི་དགོས་ལ་ཁྱོད་ལ་ཡང་ང་མི་དགོས་པར་འདུག་པས་ང་བྱོན་གསུང་།",
    "དཔོན་པོ་ན་རེ་གསོལ་རས་དགོས་ན་ཕྱག་ཚོལ་ཟེར།",
    "རྗེ་ཡི་གསུང་གིས་དེ་ལེགས་ད་རེས་ཆུ་བར་ལ་འགྲོ་ཕྱིས་སླེབ་པ་བྱེད་གསུང་།",
    "དེར་ཕྱིན་པའི་གང་ཟག་རྣམས་ལ་ངན་སོང་མེད་པར་ལུང་བསྟན་པ་ཞིང་སྐྱོང་གི་མཁའགྲོ་མ་ཀུན་ཌ་ལི་མཆེད་ལྔ་གཞུགས་ཤིང་།",
    "དེར་ཞག་ཤས་བཞུགས་ཤིང་རོ་གདན་གྱི་སྟེང་དུ་གཟིམས་པས་ནུབ་ཅིག་མངོན་གསུམ་དུ་རོ་ལངས་ཕོ་མོ་མགོ་མེད་པ་དང་།",
    "རོ་ལངས་མོ་འགའ་རེ་མཚན་མ་ལག་པས་ཕན་ཚུན་དུ་བསྒྲོད་པ་རྣམས་བྲོ་བརྡུང་ཞིང་གར་བྱེད་པ་ལས།",
    "རོ་ལངས་ཕོ་རྣམས་དང་འཛིངས་ཞིང་མོ་རྣམས་ལ་རོལ་བས་ཆོ་འཕྲུལ་ཀུན་རང་ཞིར་གྱུར་ཏོ།",
    "གཏོར་མ་རྣམས་ཞལ་དུ་གསོལ་བ་དང་ཁྲོམ་རྣམས་ཀྱི་སེབ་དུ་འཕྱོང་བ་དང་རེས་བྲོ་བརྡུང་ཞིང་གླུ་གར་དང་།",
    "རེས་ངུ་ཞིང་བྲང་བརྡུང་བ་དང་།",
    "རེས་རྫོ་སྦུབསུ་དྲངས་ནས་བུག་པ་ཧུ་རེ་བའི་མཐའ་མ་ལ་སྤུ་སུད་ཙམ་ལས་མེད་པར་མཛད་ནས།",
    "གང་ཟག་ཐེག་དམན་གྱི་རིཊ་མང་བས་མོས་པ་ཙམ་ཡང་མ་བྱུང་།",
    "དེ་ནས་ཆུ་བར་དུ་ཕེབས་དབྱར་སྨད་ལ་ཕྱི་སྐོར་ཅིགཟིགས།",
    "རྗེ་ཡིས་བོན་རི་བ་ལ་ཕྱག་མཛད་པ་དང་སྐུ་སྤྱོད་གྱ་མ་ཐོ་མཛད་པའི་སྟོབས་ཀྱིས་དྲིན་པའི་གཞོན་སྐྱེས་ཕོ་མོ་རྣམས་མ་དགའ་བར་མང་ཤིང་སེ་བ་ཡིན་ཟེར་དན་རོག་ཕུ་ལུ་གང་ཙམ་ཞུས་ཅིང་བཞེས་ཀྱང་ཅུང་ཟད་སྙུང་བ་ཙམ་ལས་ཉེས་པར་མ་གྱུར་ཏོ།",
    "རྗེ་ཡི་གཟིགསྣང་ལ་མགོན་པོའི་སྐུ་དེ་རི་རབ་ཙམ་དུ་གྱུར་ནས་བྲོ་བརྡུང་དྲག་པོ་མཛད་པ་གཟིགས་པས།",
    "རི་དྭགས་ཕྲ་མོའི་ནང་ན་ཅན་ཟན་གྱི་རྒྱལ་པོ་ལྟར་བརྟུལ་ཞུགས་ཀྱིས་སྤྱོད་པས་ཕྱོགས་ཐཾད་ལས་རྣམ་པར་རྒྱལ་བའི་བསྐོར་ཚོ་དེ་ལེའུ་བརྒྱད་པའོ། ། དགུ་པ་ནི།",
    "ཞག་དྲུག་གི་ནུབ་མོ་ས་ཆེན་པོ་འདི་རབ་ཏུ་གཡོས་ནས་རབ་ཏུ་འཇིགས་པའི་འུར་སྒྲ་དང་བཅས་ཏེ།",
    "ཐོ་རངས་ཁ་དྲི་བཟང་པོ་འཐུལ་ཞིང་ནམཁའ་ལ་རོལ་མོའི་སྒྲ་དང་བཅས་ཚེ་གཟིགས་པས།",
    "བལ་པོ་ལུང་པ་ད་འཇའ་འོད་ཀྱི་གང་བས་ཉིན་མོ་བས་ཀྱང་ལྷག་པར་གསལ་ཞིང་།",
    "མདུན་གྱི་ནམཁར་བཤྀས་དཔལ་དུས་ཀྱི་འཁོར་ལོའི་དཀྱིར་རྟེན་དང་རྟེན་པར་བཅས་པ་སྣང་ལ་རང་བཞིན་མེད་པ་འཇའ་ཚོན་ལྟར་གསལ་བའི་ཤར་སྒོའི་ཐད་ཙམ་ནས་གཟུཊ་མེད་པའི་སྐད་གྱི་ད་ནི་རྣལྱོར་པ་ཁྱོད་ཀྱིས་འཆད་པ་དང་རྩོམ་པ་སོགས་འགྲོ་བའི་དོན་གྲུབ་པ་ཡིན་པས་གྱིས་ཅིག་བྱ་བ་བྱུང་།",
    "དེ་ནས་ཤིང་ཀུན་གྱི་མི་རྣམས་ཀྱིས་རྣལྱོར་པ་གཙང་སྨྱོན་ཟེར་བ་དེ་ཡེ་མ་བྱུང་གར་སོང་ཟེར།",
    "དེ་ནས་སླར་བོད་ལ་བྱོན་ཏེ་འདུ་འཛི་གྲོང་གི་ཕ་རོལ་གཡའ་དང་གངས་གི་ནང་རོལ།",
    "ཁོ་ན་རེ་ངའི་མིང་ཡི་གེ་རྩི་ལྟ་བ་ཡིན།",
    "ཕྱག་མཚན་མཚོན་ཆ་སྣ་ཚོགས་དང་བཅས་པ་ཞལ་གཟིགས་ཤིང་།",
    "དེ་དུས་ཡོན་བདག་གཅིག་གིས་ཚོགས་འཁོར་ཡང་ཞུས་ཞགཅིག་སྐུ་དྲུང་དུ་འདུག་ཚེ།",
    "ལ་ཕྱིར་གཞན་ཕན་གྱི་བསྒྲུབ་པ་ལ་ཐོག་མར་གཞུགས་པའི་སྐོར་ཚོ་དེ་དང་པོའོ། ། དེ་ནས་མཉའ་ནང་རྩར་མར་ཕེབས་ཚེ་བུད་མེད་ཅིག་ལ་མི་གཉིས་མིགསེར་བྱས་ནས་འཛིངས་པའི་ཚེ།",
    "བུད་མེད་ཀྱིས་བར་འབྱེད་བྱས་པས་བུད་མེད་དེ་ལ་གྲི་འཕོག་ནས་ཤི་བའི་རོ་བཀྲིསྒང་གི་ཕྱོགས་ཀྱི་དུར་ཁྲོད་ནི་བསྲེག་གིན་འདུག་པ་ལས།",
    "དེར་ཕེབས་མི་འགའ་རེ་འདུག་ཀྱང་མ་འཛེམས་པར་མེ་ཁྲོད་ནས་ཐོད་པ་ཕོག་ཀླད་པ་གསོལ་བ་ལས།",
    "རྗེ་ཡི་ཞལ་རས་ལྷ་ཁང་གི་ལྷ་འབྲི་སར་ཕེབས་ལྷ་འབྲི་བའི་སྟེགས་ཅིག་གིས་ཁར་བཞུགས་ནས།",
    "དེ་ཉིད་ཞལ་རས་ལྷ་ཁང་དུ་བྱོན་པས་རྗེ་དང་མཇལ་སྔོན་རྨི་ལམ་དུ་རྨིས་པ་དེ་ཁོ་ནར་འདུག་པས་ཤིན་ཏུ་མོས་པར་བྱུང་།",
    "དེ་དུས་རྗེ་ཡི་ན་བཟའ་རྣམས་ཧྲུལ་ཞིང་ཁྱད་པར་སྒོམ་ཐག་ཧྲུལ་པས་དཔོན་མོ་ལ་རྗེ་ཡི་གསུངས་གི།",
    "ནང་སོ་ཡང་ཤིན་དུ་དད་ཅིང་རབ་ཏུ་མོས་པས།",
    "ནང་སོ་རང་གིས་སྤྱིར་དྲི་བ་དང་གླེང་མོ་མང་དུ་མཛད་ཅིང་།",
    "ནང་སོ་དེ་མན་མི་ཕྱེད་པའི་དད་པ་ཐོབ་ཅིང་ཤིན་ཏུ་མོས་པར་གྱུར།",
    "ཐེ་གུའི་སྣ་རེ་རེ་ཁོང་གཉིས་ཀྱི་སོ་སོར་བཟུང་ནས་ཤེད་སྐྱེད་འཐེན་ཚེ།",
    "ཉིན་ཅིག་ཁོ་རང་གི་འཚེར་དུ་གསོལ་ཇ་ལ་གདན་དྲངས།",
    "སྐྱ་བོ་ཅིག་གིས་རྡོ་རྗེའི་མགོ་སོར་མོའི་བར་དུ་བཏབ་ནས།",
    "ཁོ་ན་རེ་ཐུབ་པ་མ་མཆིས་ཟེར་རྗེ་ཡི་གསུང་གིསྙ་ནང་ལུང་པའི་ཕ་དམག་བུ་དམག་ལྷགས་ཀྱང་མི་ཐུབ་གསུང་།",
    "ཡུན་གྱི་བདག་པོ་ཁྱོད་ཀྱི་ཀྱང་མི་བྱེད་གསུང་།",
    "མི་ཕྱེད་དད་ལྡན་གྱི་བླ་ཆེན་དྲུག་གི་ནང་ནས་ཐོག་མར་ཆེ་བ།",
    "སྲོད་ལ་བབ་པ་ན་ནང་སོ་ན་རེ།",
    "རེ་ཞིག་ནས་མེ་ནང་དུ་ཞབས་རྗེན་པར་འཕྲབས་པས།",
    "ནང་སོ་ན་རེ་ང་ཡི་ཀུ་རེ་དེས་ཁོང་ཞལ་སྐྱངས་པ་ཡིན།",
    "རིན་ཆེན་དཔལ་བཟངས་སོགས་བུ་སློབ་འགའ་རེ་དང་བཅས།",
    "ལ་ཕྱི་སྟག་གདོང་ཕྲ་མོའི་གཅོང་རོང་ཕུག་ཏུ་བཞུགས།",
    "གཏུམ་མོའི་གདམ་ངག་གནང་ནས་ད་ཚང་རག་རྒྱུག་པས་ཁྱོད་ཀྱི་སེམས་འབེན་དུ་ཚུགས་ཅིག་གསུང་།",
    "ན་མོ་འགུ་རུ།",
    "ཡང་དག་ལྟ་བའི་ལམ་རབ་ཟབ་མོ་རྣམས།",
    "གང་གི་ཁྱོད་ལ་གསོལ་བཏབ་དུས་དེར་སྩོལ།",
    "མོས་གུས་འགྱུར་མེད་རྟ་ལ་ཞོན།",
    "སྐལ་ལྡན་ཁྱོད་ཀྱི་འབེན་དུ་ཚུགས།",
    "ཨེ་བཾ་དེ་ནས་ཡང་མཉམ་བཞག་གི་སྒོ་ནས།",
    "སེམས་རྩལ་བས་འདི་འདྲ་དང་འདི་བཞིན་འདུག་པ་འདི་ཀ་སེམས་ཡིན་པར་ཐག་ཆོད་བརྡའ་ཅེས་ཉམས་ཀྱི་འཆར་སྒོ་རྣམས་ཕུལ་བས་དེ་དག་གི་སེམས་རྙེད་གོ་མི་ཆོད་ད་དུང་མཉམ་པར་བཞོག་ལ་སེམས་ཚོལ་ཅིག་གསུང་འགུར་འདི་གསུངསོ། ། ན་མོ་འགུ་རུ་སེམས་ཉིད་མཐོང་འདོད་སྐྱེས་བུ་ཚུར་ཉོན་དང་།",
    "རང་གི་རང་ཉིད་གཅོད་ཅིང་མཐོང་བ་མེད།",
    "དེ་ནས་བྲག་གི་ངོས་ལ་ཆགས་པའི་འཁྱགས་པ་ལ་ཕྱག་འཛུབ་གཏད་ནས་ཕ་གི་ནང་པར་ཞིག་ནས་འཇུ་བར་འགྱུར་བ་དེ་རྐྱེན་ཅིས་འཇུ་གསུང་བ་ལ།",
    "ད་དོན་ངོ་སྤྲོད་པ་ཡིན་པས་ཕྱག་ཚོལ་གསུང་པ་ལྟར་ཕྱག་བརྩལ་ཏེ་སྤུས་རྩུགས་ཐལ་མོ་སྦྱར་ནས་འདུག་པ་ལ་ངོ་སྤྲོད་ཀྱི་འགུར་འདི་གསུངསོ།",
    "ཟབ་མོའི་གདམས་པ་དེང་འདིར་ཁྱོད་ལ་བཤད།",
    "རྣལ་འབྱོར་ཁྱོད་ཀྱི་དེ་ལྟར་ཤེས་པར་བྱ།",
    "ནང་སོའི་སྲས་ཆེ་བ་གྲོངས་པའི་སྟོབས་ཀྱིས་རེ་ཞིག་མར་ལེབ་དུ་གཞུགས་ཚེ།",
    "ནང་སོ་གཡུང་མའི་གསོལ་ནས་སྤྱི་རུ་གསོལ་བས་རྒྱལ་པོ་རྩ་ན་ན་རེ།",
    "ཁྱོད་ཀྱི་མ་བྱིན་པར་ཡང་ལོང་།",
    "ཕ་རོལ་བུད་མེད་རྟེན་པར་གྱིས་ཟེར་བ་ཡོད་གསུངས་པས་ཅི་ཡང་མི་ཟེར་བར་འདུག་དེ་དུས་ལྷོ་བྱང་གཉིས་ཀ་བྱང་པས་སྐྱོང་བ་ལས།",
    "དཔོན་པོ་ནམཁའ་བདེ་ལེགས་ཁོ་ཡང་ཚ་མདའ་མངའ་ཞབས་སེམས་ལ་འཕྲེང་ཞིང་བོར་སོང་།",
    "མུག་ཏེ་ཅི་བྱ་ཚང་བླག་རུང་དེར་བྱ་ཐབས་མ་བྱུང་བར་ཁོང་རྣམས་ན་རེ་ཞབས་རྟོག་རྗེསུ་བྱེད།",
    "གསོད་མ་ནུས་ན་ཁྱོད་ལས་སྐྱག་པ་མེདོ་གསུངས་པས་ཁོ་ན་རེ་ཁྱོད་རང་རིངས་མི་དགོས་འདོད་པ་མཐུན་བྱུང་ཟེར།",
    "དེ་ནས་ཁོང་ཚོ་མཚེར་དུ་སླེབ་པ་ཅྀམ་ལ་རྗེས་ཡང་ཕེབས་ཏེ་ང་སླེབ་ཡོད་དོ་གསུངས་པས་ཁོང་རྣམས་འདུས་ཞིང་དགའ་ཏེ།",
    "དེར་གཞུགས་པས་མི་གཞན་རྣམས་ཕྱིར་བསེངས་ཏེ་ཁོང་རང་དཔོན་གཡོག་བཅོ་ལྔ་ཙམ་གྱིས་སྟེང་གི་སྐས་ཕབ་འོག་གི་སྒོ་གནན་ཏེ།",
    "གྲི་རིང་ཐུང་རྣམས་ཀྱིས་སྐུ་ལ་སྣུན་ཞིང་བྱང་པ་ལྔ་དར་བ་ཅིག་རང་གིས་ཀྱང་རྐང་གྲི་བཞི་བཅུ་ཞེ་ལྔ་སྣུན་ཅིང་།",
    "དེ་ནས་ཉི་མ་དགོངས་ཇ་ཙམ་དུ་སོང་སོང་སྟོབས་སྐྱེད་ནས་གང་སོང་བྱས་རུང་།",
    "སྐྲ་ཀུན་བྱི་ནས་མེད་ཅིང་རལ་རྫུས་གྱོན་པའི་མི་ཅིག་གིས་རྗེའི་ཞལ་རས་ཀྱི་ཁར་རྐང་བྲོ་རྒྱབ་པས།",
    "ཁོ་རྐང་པ་འགྲེད་ནས་ཁ་བུབ་དུ་འགྱེལ་རལ་རྫུས་བུད་ནས་མགོ་དམར་རིལ་རྩེ་བྱུང་བ་ལ།",
    "ཚེམས་དང་རུས་པ་སྐྱ་ལྷག་ལྷག་ལྟག་ཁུང་དུ་ཐལ་ཐལ་འགྲོ།",
    "དེ་འདྲ་ལན་དགུ་སོང་ཚེ་རྗེ་ཡི་གཟིགས་སྣང་ལ་མདུན་གྱི་ནམཁར་འཇའ་འོད་ཀྱི་དབུསུ།",
    "རྗེ་བཙུན་ཤ་ར་བ་སྐུ་ཁྲུ་གང་ཙམ་སེང་གེ་ལ་ཕྱིབས་པའི་ཕྱིབས་སྣ་བུད་མེད་རུས་པའི་རྒྱན་གྱིས་བརྒྱན་པ་གཉིས་ཀྱི་ཁྲིད་པ།",
    "གསུངས་ནས་འོད་དུ་ཡལ་བ་ཅིག་གཟིགས།",
    "དེ་ལ་ཐུགས་ཅུང་ཟད་ཡངས་པས་ཞལ་ཀྱི་ཕྱི་ལ་རྨེན་པ་གྲ་མག་གི་དྲད་པའི་རི་མོ་ལྟ་བུ་ཅུང་ཟད་ཅིག་བྱུང་།",
    "རྗེ་ཡི་གསུང་གིས་ང་མ་དགའ་བ་ཅི་ལ་བྱེད་ཁྱོད་རང་བཤགས་པ་འབུལ་བ་དེ་ལེགས།",
