    "དེ་ཉིད་མན་ངག་ལུགས་ཀྱི་འཕར་མ་གཉིས་པའི་ལུགས་དང་མཐུན་པར་འདོད་པ་ནི་མི་འཐད་དེ།",
    "ཕྱི་རོལ་འདབ་མ་བརྒྱད་ཀྱིས་བསྐོར་བ་མ་གསུངས་པའི་ཕྱིར་དང་།",
    "ཀྱེ་རྡོར་དོན་བསྡུས་ཀྱི་དགོངས་པར་སྣང་ཡང་དེ་ཉིད་མན་ངག་ལུགས་ཀྱི་འཕར་མ་གཉིས་པའི་ལུགས་གཅིག་དང་མཐུན་པར་འདོད་པ་ནི་མི་འཐད་དེ།",
    "རྗེ་བཙུན་གྱི་དགོངས་པར་མི་འཐད་དེ།",
    "༞། གོང་དུ་འཕར་མ་གཉིས་པའི་སྐབས་སུ་བཏེག་སྟེ་ཁྱེད་ཀྱི་སྤྱི་བོར་བཞག་པར་བྱའོ་ཞེས་ཁས་བླངས་པ་དེ་འདིར་དྲན་པར་གྱིས་ཤིག།",
    "མི་ཐུབ་ཟླ་བའི་ཡན་ལག་དྲུག་པར།",
    "མི་ཐུབ་ཟླ་བའི་དགོངས་པ་པདྨའི་འདབ་མ་བརྒྱད་ལ་འགོད་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི་རྣམ་པར་མ་བརྟགས་པ་ཁོ་ནའོ་ཞེས་བཟློག་ན་མི་སྨྲ་བའི་བརྟུལ་ཞུགས་དགོས་པར་འགྱུར་རོ།",
    "འོན་ཀྱང་ས་ཆེན་ཡབ་སྲས་ཀྱི་བཞེད་པར་ཤུགས་ལས་འགྲུབ་པར་འདོད་པ་ནི་མི་འཐད་དེ།",
    "ཁྱེད་ཀྱི་རྟོག་བརྟགས་དེ་ཤུགས་ལ་ཡང་མི་འགྲུབ་ཅེས་པ་ནི་རྣམ་པར་མ་བརྟགས་པ་སྟེ།",
    "དེ་ནས་ལྷ་སྣམ་ཤར་ཕྱོགས་ཀྱི་སྒོ་དཀར་པོ་བྱ།",
    "བྱང་ལྗང་གུ་ཞེས་དངོས་སུ་གསུངས་པས་ཤུགས་ལ་འགྲུབ་མི་དགོས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་དེ་གཉིས་ཀྱི་ལུགས་ལ་འཕར་མ་གཉིས་པར་འགྱུར་བ་ལས་ཡབ་ཀྱི་སྐབས་སུ་འཕར་མ་གཅིག་པར་རྒྱུད་ལས་གསུངས་པའི་ཕྱིར།",
    "ཕྱོགས་སྔའི་ནམ་ལངས་པར་གྱིས་ཤིག།",
    "ནག་པོ་དམ་ཚིག་རྡོ་རྗེས་ཡབ་ཀྱི་སྐབས་སུ་ཡང་དེ་ལྟར་གསུངས་ཤིང་།",
    "ཁ་ཅིག་ཡུམ་ལ་འཕར་མ་གཉིས་པ་གསུངས་ཤིང་།",
    "ཡབ་ལ་འཕར་མ་གཅིག་པ་གསུངས་པས་དེ་ལས་བཟློག་སྟེ་སྨྲར་མི་རུང་ན།",
    "ཞེས་པ་ཡབ་ཁོ་ན་ལ་གསུངས་པའི་ཕྱིར་ཞེས་སྨྲ་བ་ནི་ཁོ་ན་ཞེས་པའི་ཚིག་སྒོ་བཞི་པ་ཞེས་པ་ལ་སྦྱར་རྒྱུ་ཡིན་ན།",
    "ཞེས་དངོས་སུ་རྒྱུད་ལས་གསུངས་བཞིན་དུ།",
    "རྗེ་བཙུན་ཆེན་པོས་ཉི་མའི་ཁ་དོག་ལྗང་སེར་ཞེས་གསུངས་པ་དང་འགལ་ལོ་ཞེས་བྲིས་པ་ནི་རྣམ་པར་མ་བརྟགས་པ་སྟེ།",
    "ཉི་མའི་ཁ་དོག་དམར་པོར་གསུངས་པ་ནི་རང་ངོས་ཀྱི་ཁ་དོག་ལ་དགོངས་ལ།",
    "ཀ་བ་བརྒྱད་ཀྱིས་མཛེས་བྱས་ལ།",
    "ཀ་བ་རྣམས་རྩིག་པའི་ནང་ལ་བརྟེན་པའོ་ཞེས་གསུངས་པ་ལ།",
    "དེ་ལྟར་ན་ཀ་བའི་སྟེང་དུ་གདུང་ཟླུམ་ཡོང་མི་ཡོང་ལེགས་པར་སོམས་ཤིག།",
    "དང་འདབ་མ་བརྒྱད་ལ་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཚངས་སོགས་ཀྱི་གདན་འགོད་པར་བཞེད་ལ།",
    "སྒྲུབ་ཐབས་འདི་དང་མངོན་རྟོགས་དོན་གསལ་གྱི་དགོངས་པའང་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ། ། ཤཱནྟི་པ།",
    "བདག་མེད་མ་ལ་ཟླ་གདན་བྱས་པ་ལ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་དབུས་གནས་པར།",
    "འོན་ཀྱང་མངོན་རྟོགས་རྒྱས་པར་ཟླ་གདན་བྲིས་པའི་དཔེ་ཤིན་ཏུ་མང་བས།",
    "ཟླ་གདན་གུར་དང་འགལ་བས་བཀག་གོ་ཞེས་གསུངས་པ་ལེགས་ཏེ།",
    "དགུར་། ལས་ཉི་གདན་གསུངས་པས་འདིར་ཉི་གདན་བྱེད་དགོས་པར་མི་འགྲུབ་སྟེ།",
    "མན་ངག་ལུགས་ལ་ཉི་གདན་ཁོ་ན་ཡིན་པར་འདོད་པ་ནི་མི་འཐད་དེ།",
    "དེ་ལྟར་ན་མཉམ་སྦྱོར་གྱི་མངོན་བྱང་རྒྱས་པའི་སྐབས་སུ་འཁོར་རྣམས་ཀྱང་མངོན་བྱང་ལས་བསྐྱེད་པའི་ཕྱིར་རྒྱུ་རྡོ་རྗེ་འཛིན་པ་ཡང་ནག་པོར་བྱེད་དགོས་པར་འགྱུར་ཏེ།",
    "སྐད་ཅིག་ཙམ་གྱིས་རྒྱུ་རྡོ་རྗེ་འཛིན་པ་ནག་པོའི་རྣམ་པར་བསྐྱེད་པ་གསལ་གདབ་པར་བྱ་སྟེ་ཞེས་དང་།",
    "བསལ་དངོས་སུ་མ་གསུངས་པར་ཆོ་ག་ལྷག་མ་རྣམས་ནི་སྔ་མ་དང་འདྲའོ་ཞེས་དང་།",
    "བཞི་གསུངས་པའི་རྗེས་ལ།",
    "ཏིང་ངེ་འཛིན་གསུམ་དང་ཡན་ལག་དྲུག་ནི་མེད་ལ་བསྙེན་སྒྲུབ་བཞིས་བསྐྱེད་ནས་མཆོད་བསྟོད་ལ་སོགས་པ་མི་བྱ་བར་བཟླས་པ་ལ་འཇུག་པ་ཡིན་ནོ་ཞེས་གསུངས་པས་ས་བོན་ལས་བསྐྱེད་པའི་སྐབས་སུ་ཡན་ལག་བཞིས་འཆིང་བ་དང་།",
    "རྒྱུ་རྡོ་རྗེ་འཆང་ནག་པོ་ཡིན་པར་གྲུབ་བོ།",
    "དེ་དག་ལ་ས་བོན་ལས་བསྐྱེད་པའི་སྐབས་སུ་རྒྱུ་རྡོ་རྗེ་འཆང་ནག་པོར་བྱས་ནས་ཡན་ལག་བཞིས་འཆིང་བ།",
    "ཨཱ་ལི་ཀཱ་ལི་ལ་མ་ལྟོས་པའི་མི་མཉམ་སྦྱོར་གྱི་མངོན་རྟོགས་ཏེ་ཚུལ་བཞི་པོ་པདྨ་བཛྲ་དང་ཚུལ་མཚུངས་པར་འདོད་པ་ཡང་རྩིངས་ཏེ།",
    "ལྗོན་ཤིང་ནས་གསུངས་པའི་དངོས་གཞིའི་ཆིངས་རྒྱས་འབྲིང་བསྡུས་པ་གསུམ་ཆར་སྦྱར་དུ་རུང་བར་མཚུངས་ལ།",
    "བསྙེན་སྒྲུབ་བཞིས་བསྐྱེད་ནས་མཆོད་བསྟོད་ལ་སོགས་པ་མི་བྱ་བར་བཟླས་པ་ལ་འཇུག་པ་ཡིན་ནོ་ཞེས་གསུངས་ཞེས་པ་ནི།",
    "མངོན་རྟོགས་ལྗོན་ཤིང་ལས་གསུངས་པའི་རྒྱས་འབྲིང་གཉིས་ཀྱི་ཁྱད་པར་མ་ཕྱེད་པའི་གཏམ་སྟེ།",
    "གལ་ཏེ་ལྗོན་ཤིང་ནས་གསུངས་པའི་འབྲིང་པོའི་འབྲིང་པོ་དེ།",
    "དེ་ཡང་ཁས་ལེན་ན་ལྗོན་ཤིང་ནས་གསུངས་པའི་རྒྱས་འབྲིང་བསྡུས་པ་གསུམ་པོ་དེ་རྒྱུད་གསུམ་ནས་གསུངས་པའི་མཆོག་སྒྲུབ་པ་དང་།",
    "ཡན་ལག་དྲུག་ནི་མེད་ལ་བསྙེན་སྒྲུབ་བཞིས་བསྐྱེད་ཅེས་གསུངས་པ་ལ་བརྟེན་ནས་འབྲིང་པོ་ས་བོན་ལས་བསྐྱེད་པའི་སྐབས་སུ་ཡན་ལག་བཞིས་འཆིང་བ་དང་།",
    "རྒྱུ་རྡོ་རྗེ་འཆང་ནག་པོ་ཡིན་པར་ཁས་ལེན་དགོས་པར་འགྱུར་ཏེ།",
    "ཨཱ་ལི་ཀཱ་ལི་ལ་ལྟོས་པའི་མི་མཉམ་སྦྱོར་གྱི་སྐབས་སུ་ཉི་ཟླ་གཉིས་ལ་ཨཱ་ལི་ཀཱ་ལིས་མཚན་པར་བཞེད་པ་ནི་མི་འཐད་དེ།",
    "རང་བཞིན་བརྒྱད་ཅུའི་རྟོག་པ་དང་བྲལ་བས་ན་དཀར་བའོ་ཞེས་མཉམ་སྦྱོར་གྱི་མངོན་བྱང་ལྔ་པ་དེ་དཀར་པོ་ཁོ་ནར་གསུངས་པ་དང་འགལ་བའི་ཕྱིར་རོ།",
    "ལེའུ་བརྒྱད་པར།",
    "སློབ་དཔོན་མི་ཐུབ་ཟླ་བའི་ལུགས་ལྟར་མངོན་རྟོགས་གཅིག་ཏུ་བྱས་པ་དང་།",
    "ཁྱད་པར་དུ་བིར་ཝ་པའི་ལུགས་ཀྱི་མངོན་རྟོགས་ཚུལ་བཅོ་ལྔ་པ་ལ་མི་ཐུབ་ཟླ་བའི་འཁྲུགས་ཅན་བགྲངས་པ་དང་ཁས་བླངས་ཱ་། ནང་འགལ་བའི་སྐྱོན་ཡང་ཡོད་ལ།",
    "རྗེ་བཙུན་གྱིས་གུར་རྒྱན་གྱི་ལེའུ་བཞི་པར་རིགས་རྐྱང་བསྡུས་ཀྱི་དབྱེ་བས།",
    "ཡན་ལག་བདུན་པ་ནས་རྒྱུ་རྡོ་རྗེ་འཛིན་པའི་མངོན་བྱང་ལྔ་ཡན་ཆད་ལེའུ་བཅུ་གཉིས་པ་ན་ཤིན་ཏུ་གསལ་བར་བཞུགས་སོ།",
    "དེ་ནས་མཁའ་གསང་བྱིན་གྱིས་བརླབ་པ་ནས་སྙོམས་པར་ཞུགས་ཏེ།",
    "དྲི་ཟ་མཉམ་པར་ཞུགས་ནས་ནི།",
    "ཁུ་བར་རྗེས་སུ་དྲན་པར་བྱ།",
    "བཞེངས་པའི་སྔགས་ནི་ལེའུ་བཅུ་གཉིས་པ་ནས་འབྱུང་ངོ་ཞེས་ཧེ་རུ་ཀ་གསུམ་ལ་ཡང་ཡན་ལག་དྲུག་པའི་ཚུལ་དུ་སྤྱིར་གསུངས་ནས་དེ་ཉིད་གསལ་བར་བྱ་བའི་ཕྱིར།",
    "ཡན་ལག་ཐམས་ཅད་གོང་དུ་བསྟན་པ་བཞིན་ཤེས་པར་བྱའོ།",
    "ཡུམ་བདག་མེད་མས་བྱས་ལ་མཁའ་གསང་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པ་ཐམས་ཅད་ཕྱག་བཅུ་དྲུག་པ་བཞིན་དུ་བྱས་པས་འགྲུབ་པ་ཡིན་ནོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "སྦྱང་དཀའ་ཟླ་བའི་དགོངས་པ་ཡིན་ནོ་ཞེས་གསུངས་པའི་ཕྱིར་དང་།",
    "རྗེས་ས་སྐྱ་པ་ཆེན་པོས་ཐབས་དང་ཤེས་རབ་སྙོམས་པར་ཞུགས་པ་ལས།",
    "གསང་གནས་ནས་རྫུས་སྐྱེས་ཀྱི་ཚུལ་དུ་འཁོར་གྱི་ལྷ་རྣམས་ཕྱུང་སྟེ་ཞེས་གསུངས་པ་རྣམས་ལ་རྟོགས་ཤིག།",
    "ཁྱད་པར་དུ་རྡོ་རྗེ་ཆོ་ག་ཡན་ལག་གསུམ་ལས་བསྐྱེད་པའི་ཀྱེ་རྡོ་རྗེའི་སྒྲུབ་ཐབས་དེ་སྐབས་འདིའི་མངོན་རྟོགས་ཚུལ་བཅོ་ལྔ་པར་འགྱུར་ཏེ།",
    "དེས་ན་མི་ཐུབ་ཟླ་བའི་འཁྲུགས་ཅན་སྐབས་འདིའི་མངོན་རྟོགས་བཅོ་ལྔ་པར་བགྲང་བ་མི་རིགས་ཏེ།",
    "དེའི་ཕྱིར་རྡོ་རྗེ་ཆོ་ག་གསུམ་ལས་བསྐྱེད་པ་བཅོ་ལྔ་པར་བགྲང་བར་རིགས་ཏེ།",
    "ཚུལ་བཅོ་ལྔ་པ་རྡོ་རྗེ་ཆོ་ག་ལས་བསྐྱེད་པར་མཛད་པ་དང་།",
    "འབྲས་བུ་རྡོ་རྗེ་འཛིན་པ་བཞེངས་པ་ཡོད་པར་གསུངས་པ་རྣམས་ནི།",
    "རྗེ་བཙུན་གོང་མ་རྣམས་ཀྱི་དགོངས་པ་ཕྱིན་ཅི་མ་ལོག་པ་ཡིན་པར་ཤེས་དགོས་ཤིང་འདི་ལྟ་བུའི་རྗེས་སུ་འཇུག་པ་ཡང་སྐལ་བ་བཟང་བར་རྟོགས་པར་བྱའོ་ཞེས་བྲིས་སོ།",
    "མངོན་བྱང་ལས་བསྐྱེད་པ་གཉིས་ཀྱིས་ཀྱང་ཁ་བསྐང་དགོས་པར་འགྱུར་རོ་ཞེས་པའི་སྐྱོན་སྤོང་བའི་བརྩོན་པ་ད་དུང་བྱེད་དགོས་པའི་ཕྱིར་རོ།",
    "གུར་གྱི་ཧེ་རུ་ཀ་གསུམ་ལ་བསྐྱེད་ཆོག་དེ་དག་མེད་པར་གཞན་གྱིས་ཀྱང་མ་སྨྲས་པའི་ཕྱིར་དང་།",
    "ཕྱག་བཅུ་དྲུག་པའི་འཁོར་དུ་རྗེ་བཙུན་གྱི་བཞེད་པར་འཆད་པ་བཀག་པ་ཡིན་ཏེ།",
    "མི་ཐུབ་ཟླ་བའི་འཁྲུགས་ཅན་གཉིས་ཀྱི་ནང་ནས་ཕྱི་མ་ཡིན་པར་རིགས་ཏེ།",
    "འཁྲས་བུ་རྡོ་རྗེ་འཆང་བཞེངས་ཚུལ་གསུམ་གསུམ་དུ་ཕྱེ་བས་ཁྱད་པར་བདུན་གསུམ་ཉི་ཤུ་རྩ་གཅིག་ཏུ་འགྱུར་ཏེ།",
    "ཅེས་གསུངས་ལ།",
    "བཞི་གསུམ་བཅུ་གཉིས་སུ་འགྱུར་བའི་ཚུལ་ཡང་གསུངས་པ།",
    "དང་པོའི་བརྒྱད་པར་གསུངས་པའི་ཨཱ་ལི་ཀཱ་ལི་ལ་ལྟོས་མ་ལྟོས་ཀྱི་མི་མཉམ་སྦྱོར་གཉིས་ལ་ཡན་ལག་བཞི་པ་སྦྱར་བ་ཁོ་ན་བཞེད་ཀྱི།",
    "འཁོར་སྤྲོ་ཚུལ་གཉིས་གཉིས་སུ་ཕྱེ་བའི་ཕྱོགས་རྣམས་ཞལ་གྱིས་མི་བཞེས་པའི་ཕྱིར་རོ།",
    "དཔལ་བརྩེ་བ་ཆེན་པོ་ཡབ་སྲས་ཀྱི་འགྲེལ་པ་གཉིས་ལ་ཞིབ་པར་ལྟོས་ཤིག།",
    "མི་ཐུབ་ཟླ་བའི་འཁྲུགས་ཅན་མངོན་རྟོགས་བཅོ་ལྔ་པར་མི་རིགས་ཏེ།",
    "གཞན་ཡང་དཔའ་བོ་རྡོ་རྗེས་འབྲོག་མི་ལོཙྪ་བ་ལ་ལམ་འབྲས་རྩ་བ་མེད་པ་གནང་བའི་བསྐྱེད་རིམ་དེ་འགྲེལ་པ་ལུགས་དང་།",
    "རྡོ་རྗེ་ཆོ་ག་གསུམ་ལས་བསྐྱེད་པ་བཅོ་ལྔ་པར་རིགས་ཞེས་པའི་དོན།",
    "ཞེས་པའི་དོན་ཡིན་པར་འགྲེལ་པ་ལུགས་དང་མན་ངག་ལུགས་གཉིས་མཐུན་པའི་ཕྱིར་རོ།",
    "ཚུལ་བཅོ་ལྔ་པར་བགྲང་བ་ཉིད་ཀྱིས་ཀྱང་དེ་ལྟ་བུ་མེད་པར་གསལ་ཏེ།",
    "སྔར་སྐུ་རྡོ་རྗེ་ལ་ཕྱག་བཅུ་དྲུག་པའི་འཁོར་ཡོད་པར་སྒྲུབ་པའི་སྐབས་སུ།",
    "རྩ་རྒྱུད་ལ་ཡོད་མེད་སོགས་ཕྱེ་ནས་གསུངས་པ་ནི།",
    "རྗེ་བཙུན་གོང་མ་རྣམས་ཀྱི་དགོངས་པ་ཕྱིན་ཅི་མ་ལོག་པར་ཡིན་པར་ཤེས་དགོས་ཤིང་འདི་ལྟ་བུའི་རྗེས་སུ་འཇུག་པ་ཡང་སྐལ་བ་བཟང་བོར་ཤེས་པར་བྱའོ།",
    "གསུམ་པ་དེ་བཅུ་བཞིར་དབྱེ་བ་ནི་དག་ལྡན་ལས་གསུངས་པའི་བཅུ་བཞིའི་གྲངས་བགྲངས་ནས།",
    "ལྟོས་པའི་མངོན་བྱང་སྟེ་བཞི་གསུངས་ཀྱི།",
    "བཞི་པ་ནི་རབ་འོག་དང་ཐ་ལྟག་ཅེས་པ་རྟོགས་པར་རབ་འོག་དང་།",
    "དྲུག་པ་ནི་ཁྱེད་རྗེ་བཙུན་གྱིས་གསུངས་པའི་གང་ཟག་ཕྱི་མ་བཞི་ཆར་ལ་གང་ཟག་འབྲིང་དུ་འདོད་པར་སྣང་བས་རྟོགས་པ་ཡས་རིམ་གྱི་ཐ་མ་དང་།",
    "གོང་དུ་གཞན་ལ་སྐྱོན་བརྗོད་པ་རྣམས་ནི་མི་ཐུབ་ཟླ་བའི་འཁྲུགས་ཅན་སྒྲུབ་པའི་སྐབས་ཡིན་པས་འདི་དང་འགལ་བར་སེམས་པར་མི་བྱའོ།",
    "དེ་གཉིས་ལས་གཞན་པའི་དོན་དུ་ཤེས་པར་བྱའོ་ཞེས་གསུངས་པ་ལ།",
    "དེའི་དགོངས་པ་ཞལ་ནག་པོ་བཞི་རྒྱབ་ཏུ་བལྟ་བར་བཞེད་པར་གཟུང་ནས་དགག་པ་བྱེད་པ་ནི་ཕྱོགས་སྔ་སྨྲ་བ་པོའི་བཞེད་པ་མ་རྟོགས་པར་ཚིག་ཙམ་ལ་བརྟེན་པའི་དགག་པ་ཡིན་ནོ།",
    "བདུད་བཞི་མནན་པའི་དོན་དུའོ་ཞེས་གསུངས་པ་གཉིས་པོ་འདིས་ཀྱང་ཞལ་ནག་པོ་བཞི་ལྟག་པར་བལྟ་བ་དང་།",
    "ནུབ་ཏུ་བལྟ་བར་བསྟན་པར་འགྱུར་ཏེ།",
    "རྒྱབ་ཞལ་བཞི་ནག་པ་ཞེས་གསུངས་པས།",
    "བརྟག་གཉིས་ཀྱི་མཆན་བུར་ལྟག་པའི་ཞལ་བཞི་ཞེས་གསུངས་པ་ཡང་གཡས་གཡོན་གྱི་ཞལ་གཉིས་ཀྱི་རྒྱབ་དང་ལྟག་ན་ཡོད་པ་ལ་དགོངས་ནས་དེ་ལྟར་གསུངས་པ་ཡིན་པས་སྐྱོན་མེད་དོ་ཞེས་རྣམ་པ་ཐམས་ཅད་དུ་མཚུངས་སོ།",
    "གོ་རཱི་ནི་རྩ་བའི་ཞལ་ལའོ་ཞེས་སོགས་གསུངས་པ་ལྟར་དུ།",
    "ཞབས་བཞི་གཡས་གཉིས་བརྐྱང་པའི་བརླ་ལ་གཡོན་གཉིས་བསྐུམ་པའི་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་གར་སྟབས་ཀྱིས་བཞུགས་པ་ཡིན་པར་ལུང་རིགས་ཀྱི་སྒྲུབ་བྱེད་དོགས་སྤོང་དང་བཅས་ཏེ་རྒྱས་པར་གསུངས་པ་ལ།",
    "འདི་ཡང་རྣམ་པར་བརྟག་པ་བྱ་སྟེ་ནག་པོ་པ་ལ་སོགས་པའི་རྒྱ་གཞུང་དུ་མའི་དགོངས་པ་ཡིན་ཀྱང་རྒྱུད་འགྲེལ་གྱི་དགོངས་པ་དེ་ཁོ་ན་མ་ཡིན་ཏེ།",
    "གཙོ་བོ་ལ་གར་སྟབས་ཀྱི་ཚུལ་གྱིས་བཞུགས་པ་ཞེས་གསུངས་ཤིང་།",
    "འཁོར་ལ་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་གར་སྟབས་ཀྱིས་བཞུགས་པ་ཞེས་གསུངས་པ་དང་།",
    "བདུད་བཞི་རིམ་པར་ཞབས་ཀྱིས་མནན་ཞེས་དང་།",
    "ཁྱད་པར་དུ་ཡང་རྗེ་བཙུན་ས་སྐྱ་པ་ཡབ་སྲས་ཀྱི་ལུགས་ལ་མཚོ་སྐྱེས་ལུགས་དང་།",
    "རྒྱབ་མ་གཉིས་གར་སྟབས་ཀྱིས་བཞུགས་པ་ཡིན་ཏེ།",
    "བསྟོད་པ་ཉི་ཤུ་པར།",
    "མཉམ་པར་མནན་ཅིང་གཅེར་བུ་ཉིད།",
    "ཅེས་གསུངས་པ་དང་།",
    "ཞེས་གསུངས་པ་དང་།",
    "ཞེས་གསུངས་པ་རྣམས་དང་མཐུན་པར་ས་ཆེན་གྱིས།",
    "དབུས་ཀྱི་པད་མ་དང་ཉི་མའི་སྟེང་དུ་བདུད་བཞི་བརྩེགས་པའི་གདན་ཞེས་གསུངས་པས།",
    "མན་ངག་ལུགས་ཕལ་ཆེ་བ་ལ་བདུད་བཞི་རིམ་པར་སྟེང་འོག་ཏུ་བརྩེགས་པའི་གདན་དུ་བཞེད་ལ།",
    "དེའི་སྟེང་དུ་བཞུགས་ཚུལ་ཡང་བསྟོད་པ་ཉི་ཤུ་པ་ལས།",
    "ཞེས་གསུངས་པའི་ཚིག་རྐང་དང་པོས་ཞབས་མདུན་མ་གཡས་བརྐྱང་ཞིང་གཡོན་བསྐུམ་པར་བསྟན་ལ།",
    "གཉིས་པས་རྒྱབ་མ་གར་སྟབས་སུ་བཞུགས་པར་བསྟན་པས།",
    "ཟླ་ཟེར་ཉིད་ལས་གཞན་ལུགས་འགོག་པའི་སྐབས་སུ་བསྟོད་པ་ཉི་ཤུ་པར།",
    "གཡས་བརྐྱང་གཡོན་བསྐུམ་གར་སྟབས་ཀྱི་དག་པ་གསུམ་སོ་སོར་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་ཤིན་ཏུ་གསལ་བར་གསུངས་པའི་ཕྱིར་རོ།",
    "ལྷག་མ་རྒྱབ་མ་གཉིས་མདུན་མ་ལྟ་བུའི་གར་སྟབས་ཀྱི་ཚུལ་གྱིས་བཞེངས་པ་ལྟར་འབྲུ་བརྣན་དུ་རུང་ན་སློབ་དཔོན་ཐམས་ཅད་དགོངས་པ་གཅིག་པར་འགྱུར་བས་ཤིན་ཏུ་ལེགས་ཀྱི་གཞན་དུ་ན་སློབ་དཔོན་འདི་གཉིས་ཀྱང་མི་མཁས་པར་འགྱུར་བའི་སྐྱོན་ཡོད་དེ།",
    "ན་ཞབས་བཞི་གཡས་བརྐྱང་བཞུགས།",
    "ཞེས་གསུངས་པ་སོགས་གཡས་བརྐྱང་བའི་གར་སྟབས་ཀྱིས་བཞུགས་པར་བསྟན་པའི་ལུང་ཐམས་ཅད་ཀྱང་།",
    "མཐོ་ལྔ་རྣམ་པར་བརྒྱངས་པའི་གར་གྱིས་བཞུགས་སྟབས་དང་།",
    "གར་སྟབས་གསུམ་དག་པ་སོ་སོར་གསུངས་ལ་དེ་ཉིད་གསལ་པོར་བྱ་བའི་ཕྱིར།",
    "འཕགས་པས་ཞབས་མདུན་མ་གཉིས་གཡས་བརྐྱང་ཞིང་གཡོན་བསྐམ་པ་རྒྱབ་མ་གཉིས་གར་སྟབས་ཀྱིས་བཞུགས་པ་ཞེས་དང་།",
    "མི་གནས་པའི་མྱ་ངན་ལས་འདས་པའི་ས་ལ་བཞུགས་པས་རྒྱབ་མ་གཉིས་ཀྱིས་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་གར་སྟབས་ཀྱིས་བཞུགས་པའོ་ཞེས་གསུངས་པས་སོ།",
    "འོ་ན་གོང་དུ་དྲངས་པའི་ཉི་མར་བཞུགས་ཤིང་གར་སྟབས་ལྡན་ཞེས་རྩ་རྒྱུད་ལས་གསུངས་པ་ཇི་ལྟར་དྲང་སྙམ་ན།",
    "འཇམ་དཔལ་ཡེ་ཤེས་ཞབས་ཀྱིས་འཁོར་ལ་སྐྱིལ་ཀྲུང་ཕྱེད་པར་གསུངས་ཤིང་།",
    "ལུགས་གསུམ་པོ་དེ་ལ་འཁོར་ལ་སྐྱིལ་ཀྲུང་ཕྱེད་པ་དངོས་སུ་མ་གསུངས་པའི་ཕྱིར་རོ།",
    "རྒྱབ་མ་གཉིས་གར་སྟབས་ཀྱིས་བཞུགས་པར་འཆད་པ་ནི་ཅི་རུང་རུང་དུ་སྨྲས་པ་སྟེ།",
    "བདུད་བཞི་རིམ་པར་ཞབས་ཀྱིས་མནན།",
    "ཞེས་གསུངས་པ་བདུད་བཞི་རིམ་པ་བཞིན་དུ་ཞབས་བཞིས་རིམ་པ་བཞིན་དུ་མནན་པ་ལ་འཆད་ན།",
    "བདུད་བཞི་མཉམ་པར་མནན་ཅེས་པའི་དོན་བདུད་བཞི་བརྩེགས་པ་ལ་འཆད་ན།",
    "བདུད་བཞི་རིམ་པར་ཞེས་པའི་དོན་ཡང་བདུད་བཞི་རིམ་པར་བརྩེགས་པ་ལ་འཆད་དགོས་པའི་ཕྱིར་རོ།",
    "མན་ངག་ལུགས་གསུམ་ཅར་གྱི་དགོངས་པ་ཞབས་མདུན་མ་གཉིས་གཡས་བརྐྱང་ཞིང་གཡོན་བསྐུམ་རྒྱབ་མ་གཉིས་གར་སྟབས་ཀྱིས་བཞུགས་པ་ཡིན་པའི་ཤེས་བྱེད་དུ།",
    "བདུད་བཞི་བརྩེགས་གདན་ནི་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་གར་སྟབས་སུ་བཞུགས་པའི་ཤེས་བྱེད་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "བསྟོད་པ་ཉི་ཤུ་པར།",
    "ཞེས་པའི་ཞབས་མདུན་མ་གཉིས་གཡས་བརྐྱང་གཡོན་བསྐུམ་བསྟན་པར་འདོད་པ་ནི་གཞུང་དེ་ཉིད་དང་འགལ་ཏེ།",
    "གཞུང་དེ་ལྟར་དུ་ཡོད་ན་ཡང་༜ ཞབས་གཡས་པ་ལ་བརྐྱང་པ་དང་བསྐུམ་པ་གཉིས་ཡོད་ཅེས་པར་འཆད་དགོས་ཀྱི།",
    "ཞེས་པའི་འགྱུར་དུ་ཡོད་པར་གསུངས་ལ།",
    "མཚོ་སྐྱེས་ཀྱི་འགྲེལ་པར་ཞབས་གཡས་པ་གཉིས་ཀྱིས་མནན་པ་ཞེས་པ་དཔེ་མ་དག་པར་བྱས་ནས་ཞབས་གཡས་པ་ཉིད་ཀྱིས་མནན་པ་ཞེས་པར་ཡོད་པས།",
    "རང་ལུགས་སྒྲུབ་པར་འདོད་པ་ནི་རང་ལུགས་འགོག་པར་བྱེད་པ་སྟེ།",
    "མཚོ་སྐྱེས་ཀྱི་འགྲེལ་པར་གཡས་བརྐྱང་གཡོན་བསྐུམ་དང་།",
    "སྐྱིལ་ཀྲུང་ཕྱེད་པ་གསུམ་ལ་དག་པ་སོ་སོར་གསུངས་པས་དེ་གསུམ་སོ་སོར་ཡོད་པར་མི་འགྲུབ་སྟེ་འགྲེལ་པར་རོལ་པའི་ཚུལ་ནི་སྐྱིལ་ཀྲུང་ཕྱེད་པའོ།",
    "སྐྱིལ་ཀྲུང་ཕྱེད་པ་གསུམ་གྱིས་དག་པ་གསུངས་པས།",
    "གཡས་བརྐྱང་གཡོན་བསྐུམ་ལས་ལོགས་སུ་གྱུར་པའི་སྐྱིལ་ཀྲུང་ཕྱེད་པ་ཡོད་པར་འགྲུབ་པར་འདོད་པ་ཡང་ཤིན་ཏུ་མི་འཐད་དེ།",
    "ཉིམ་བཞུགས་ཤིང་གར་སྟབས་ལྡན།",
    "དྲན་པའི་འབྱུང་གནས་ལས་རྣམ་པ་སྣ་ཚོགས་སུ་སྤྲོ་ནས་། བས་ན་གར་དང་ལྡན་ནོ་ཞེས་པའི་དོན་ནི་གར་གྱི་རྣམ་དག་འཆད་པ་ཡིན་གྱི་གར་གྱི་བཞུགས་སྟབས་འཆད་པ་མ་ཡིན་ནོ།",
    "དེའི་སྐྱོན་སྤོང་ནས་མན་ངག་ལུགས་ལ་སེམས་དཔའ་སུམ་བརྩེགས་ཡོད་པར་སྒྲུབ་བོ།",
    "དེའི་ཕྱིར་བདུད་རྩི་འོད་ཀྱི་རྗེས་སུ་འབྲང་ནས་སེམས་དཔའ་སུམ་བརྩེགས་ཀྱི་ཐ་སྙད་གསུངས་པ་ཡིན་ལ།",
    "རྗེ་བཙུན་ཆེན་པོས་མཛད་པའི་བདག་མེད་མའི་སྒྲུབ་ཐབས་མན་ངག་ལུགས་མ་ཡིན་པར་འགྲེལ་པ་ལུགས་སུ་འདོད་པ་ནི་སྔར་བཀག་ཟིན་ལ།",
    "མེད་ན་ས་བོན་ཐིག་ལེས་བརྒྱན་པ་ཡོད་པ་རྣམས་ལ་སེམས་དཔའ་སུམ་བརྩེགས་ཀྱི་དོན་ཚང་བ་ལེགས་པར་གྲུབ་ཅེས་ཁས་བླངས་པ་དང་འགལ་ལོ།",
    "ཡབ་ཀྱི་རྡོ་རྗེར་ཞུགས་ཐུགས་ཁར་ཐིམ་པར་བསྒོམས་ལ་བཟླས་ཤིང་།",
    "རྗེ་བཙུན་དང་མི་མཐུན་པར་མངོན་ནོ་ཞེས་གསུངས་པ་ལ།",
    "འདི་ཉིད་རྗེ་བཙུན་ཆེན་པོའི་དགོངས་པར་ཤིན་ཏུ་གསལ་ཏེ།",
    "བཟླས་ཐབས་ཀྱི་བྱེ་བྲག་གོ་ཞེས་ཤིན་ཏུ་གསལ་བར་གསུངས་པའི་ཕྱིར་རོ།",
    "ཐུགས་བརྒྱུད་བསྐུལ་བར་བསམ་ཞེས་གསུངས་པ་ནི།",
    "གལ་ཏེ་རྗེ་བཙུན་གྱིས་ཡུམ་མེད་པ་ལ་ཞེས་གསུངས་པ་ནི།",
    "ལྟེ་བར་ཞུགས་ནས་ཨཾ་ལ་མས་ཡར་ཐིམ་པའི་ཚུལ་གྱིས་ཕར་འཁོར་གྱི་རྣམ་པར་བཟླས་པ་གང་རུང་ངོ་ཞེས་གསལ་བར་གསུངས་པའི་ཕྱིར་རོ།",
    "འདི་ལ་དཔྱད་པར་བྱ་སྟེ།",
    "དེ་ལྟར་གསུངས་པ་ནི།",
    "གོང་མའི་གདམས་ངག་སྙན་བརྒྱུད་དུ་ཤེས་པར་བྱའོ་ཞེས་བྱ་བ་བྲིས་སོ།",
    "དེ་ནི་འཕགས་པའི་བཞེད་པ་སྒྲུབ་པར་རློམ་ཡང་།",
    "གཞུང་དེ་ཡང་སྒྲུབ་བྱེད་མ་ཡིན་པར་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "གོང་མའི་མན་༞། ། ངག་སྙན་བརྒྱུད་དུ་ཤེས་པར་བྱ་ཅེས་པ་ཡང་དམ་བཅའ་ཙམ་སྟེ།",
    "ཞེས་གསུངས་པ་དང་འགལ་བའི་ཕྱིར་རོ།",
    "ཞེས་གསུངས་པ་ཡབ་དང་མཚུངས་པར་བྱའོ་ཞེས་གསུངས་པ་ལ།",
    "ཚིག་དེ་ཉིད་གསུངས་པའི་ཕྱིར་རོ།",
    "ཕྱག་མཚན་ལོགས་སུ་མ་གསུངས་པའི་ཕྱིར་དང་།",
    "འོན་ཀྱང་གྲི་གུག་དང་ཐོད་པའོ་ཞེས་ཕྱག་མཚན་གྱི་དམིགས་བསལ་རྒྱུད་ལས་དངོས་སུ་གསུངས་ཤིང་།",
    "ཅེ་ས་གསུངས་པའི་མཇུག་ཏུ།",
    "དེས་ན་ལེགས་པར་སོམས་ལ་སྨྲོས་ཤིག།",
    "ཐམས་ཅད་ཀྱི་རིགས་བདག་མི་བསྐྱོད་པ་མ་ཡིན་པས་ཕྱི་མ་ལེགས་པར་མཐོང་ངོ་ཞེས་གསུངས་པ་ལ།",
    "བཞི་བཅུ་ཞེ་དགུ་ཕྱོགས་ཀྱ་ཝ་། སྐྱོང་བརྒྱད་ཀྱིས་བསྐོར་བ་ནག་པོ་མི་བསྐྱོད་པའི་དབུ་རྒྱན་ཅན་དང་ཞེས་གསུངས་པས་གཙོ་བོ་ལ་རྒྱས་བཏབ་དངོས་སུ་ངག་འདོན་ལ་གསུངས་ནས་འཁོར་རྣམས་ལ་རིགས་བདག་དྲན་པ་ཙམ་གྱིས་ཆོག་པ་རྗེ་བཙུན་གྱི་དགོངས་པ་ཡིན་པར་སེམས་ལ་དེ་ལྟར་བྱས་པས་ཡན་ལག་བཞི་མ་ཚང་བའི་སྐྱོན་ལས་ཀྱང་གྲོལ་ལོ།",
    "གཙོ་བོ་ལ་རྒྱས་གདབ་དངོས་སུ་ངག་འདོན་ལ་གསུངས་པ་ཡིན་ན།",
    "ཕྱོགས་སྐྱོང་བརྒྱད་ལ་ཡང་མཚུངས་པ་ལས་ཕྱོགས་སྐྱོང་བརྒྱད་ལ་རྒྱས་འདེབས་དངོས་སུ་གསུངས་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་རྗེ་བཙུན་བིརླ་པའི་བཀའ་སྲོལ་མན་ངག་ལུགས་དང་།",
    "མཁས་པར་རློམ་པ་འགའ་ཡིས་འགོག་ཟེར།",
    "སྒྲིབ་པར་བྱེད་པའི་ལོག་རྟོག་དྲི་མ།",
    "རྣམ་པ་ཀུན་ཏུ་རྒྱས་པར་གྱུར་ཅིག།",
    "ས་མཆོག་མྱུར་དུ་ཐོབ་པར་ཤོག་ཤིག།",
    "ཐམས་ཅད་མཁྱེན་པ་ཀུན་དགའ་བཟང་པོའི་ཞལ་སྔ་ནས་དང་།",
    "ཁྱད་པར་རྒྱུད་གསུམ་མན་ངག་དང་བཅས་པའི་དོན་ལ་གཞན་གྱི་དྲིང་མི་འཇོག་པའི་སྤོབས་པ་ཐོབ་པ།",
    "སླར་ཡང་ཞུས་ཅིང་བཅོས་ཏེ་དག་པར་བགྱིས་པའི་ཡི་གེ་པ་ནི་གཞོན་ནུ་བཟང་པོས་བགྱིས་སོ།",
    "བདེ་གཤེགས་ཤེས་རབ་ཐོབ་པར་ཤོག།",
    "བདག་བློའི་པདྨོ་རྣམ་པར་རྒྱས་བྱེད་ཅིང་།",
    "འདིར་དམ་ཚིག་དང་སྡོམ་པའི་རྣམ་པར་བཞག་པ་ལ་གསུམ་སྟེ།",
    "དོན་འགྱུར་ལ་སྡོམ་པར་འགྱུར་རོ།",
