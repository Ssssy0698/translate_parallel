    "ཁྱད་པར་གྱི་ཕྱོགས་ལ་ནི་རྫས་ལ་སོགས་པའི་ངོ་བོར་རོ།",
    "དེ་ལྟར་ན་དེ་རྣམས་ཁྱད་པར་གྱི་ངོ་བོར་བརྗོད་པར་བྱས་པར་འགྱུར་རོ་ཞེས་པ་བྱེ་བྲག་གོ།",
    "ཁྱད་པར་རྣམས་ལ་ཉེ་བར་བཏགས་པའོ་ཞེས་སྔ་མ་ཁོ་ན་ལྟར་སྐྱོན་བརྗོད་པར་བྱ་བ་སྟེ།",
    "སྲིད་པ་ལས་ཞེས་པ་རིགས་རྗོད་པར་བྱེད་པ་ན།",
    "བློ་མེད་པར་ཞེས་པ་འདི་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "འབྲེལ་པ་རྗོད་པར་བྱེད་པ་ན་ཡང་སྟེ།",
    "དེ་ཅི་ལྟར་ད་ལྟར་ཡོད་པའི་ངོ་བོ་རྗོད་པར་བྱེད་པ་ལ་བརྟེན་པ་ཡིན།",
    "ཡང་ཅི་ལྟར་འདིར་ཐ་དད་མེད་པར་ཉེ་བར་གདགས་པ་འབྲེལ་པའི་ཡན་ལག་ཏུ་བྱ་བ་ཡིན།",
    "འབྲེལ་པར་ཡང་ཡོད་པ་ཉིད་དུ་གྱུར་པ་མ་ཡིན་པ་ཁོ་ན་ཡིན་ན།",
    "དེ་ཅི་ལྟར་དེའི་ཡོད་པ་ཉིད་དམ་ཡོད་པའི་སྒྲ་དང་ཐ་དད་མེད་པར་གཏགས་པ་ཡིན།",
    "འབྲེལ་པ་རྗོད་པར་བྱེད་པར་ཁས་བླངས་ནས་སྐྱོན་འདི་བརྗོད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཡང་འབྲེལ་པ་བརྗོད་པར་བྱ་བ་ཡིན་པ་དེ་ལྟ་ན་ཡང་དེ་དང་ལྡན་པའི་ཕྱོགས་ཀྱི་སྐྱོན་འདའ་བ་མེད་དེ།",
    "འདིར་ཐ་དད་པ་དང་ཐ་མི་དད་པའི་ངོ་བོས་བརྗོད་པར་བྱ་བ་མ་ཡིན་གྱི།",
    "དེ་ལྟ་ན་ཡང་ཁྱད་པར་གྱི་ཕྱོགས་ལས་ཕྱོགས་གཞན་ཁོ་ན་འདིའོ་ཞེས་སེམས་སོ།",
    "ཡང་ཅི་ལྟར་དེ་ལྡན་ཙམ་ཡོད་པ་ཉིད་དམ་འབྲེལ་པར་འགྱུར་ཞེ་ན་གསུངས་པ།",
    "ཙམ་གྱི་སྒྲས་ཁྱད་པར་སེལ་བ་ནི།",
    "ཡོད་པ་ཉིད་དམ་འབྲེལ་པ་མ་གཏོགས་པར་གཞན་ཉེ་བར་དམིགས་པ་མ་ཡིན་ཏེ།",
    "དངོས་པོའི་རྐྱེན་ནི་དེ་ཁོ་ན་ལ་བྱས་པའི་ཕྱིར་རོ།",
    "འབྲེལ་པ་བརྗོད་པར་བྱ་བ་ཉིད་ལ་ལུང་སྟེ།",
    "ཚིག་སྡུད་ལ་སོགས་པ་འདི་རྣམས་ལ་རང་དང་བདག་པོའི་དང་བྱ་བ་དང་བྱེད་པ་ཅན་གྱི་དང་བུ་རྒྱུད་དང་བུ་རྒྱུད་དང་ལྡན་པའི་འབྲེལ་པ་བརྗོད་པར་བྱ་སྟེ་རིམ་པ་ཇི་ལྟ་བར་རོ།",
    "དེས་ན་འདིར་ཡང་ཡོད་པའི་སྒྲ་ནི་བྱེད་ལྡན་གྱི་མཐའ་ཅན་ཉིད་ཀྱི་ཕྱིར་འབྲེལ་པ་རྗོད་པར་བྱེད་པར་འགྱུར་རོ།",
    "འདིར་ཡོད་པ་ཉིད་དེ་ཁོ་ན་བརྗོད་པར་བྱ་བའི་འབྲེལ་པ་ནི་མ་ཡིན་ནོ།",
    "ཞེས་པ་ལ་སོགས་པས་ནི་དུ་མ་ལ་མི་འཇུག་པ་ཉིད་ཀྱི་གཏན་ཚིགས་གསལ་བར་བྱས་སོ།",
    "ཁྱབ་པར་བྱེད་པ་མེད་པའོ།",
    "དེ་ཡང་ཞེས་པ་ལ་སོགས་པས་གཏན་ཚིགས་ཉིད་ཀྱི་དོན་རྣམ་པར་འབྱེད་དོ།",
    "དེ་མི་འདོད་པ་ཉིད་སྤྱིའི་ངོ་བོ་སྒྲོ་བཏགས་པར་གསལ་བར་བྱེད་པ་གསུངས་པ།",
    "མི་འཁྲུལ་བར་སྨྲ་བས་ཡོད་པའི་སྒྲས་སྤྱི་རྗོད་པར་བྱེད་པ་ཉིད་ལ་བརྟེན་ཏེ།",
    "ཁྱད་པར་གྱི་སྒྲ་རྣམས་དང་གཞི་མཐུན་པ་ཉིད་ཁས་བླངས་པའི་ཕྱིར་ཡང་ངོ།",
    "སྤྱི་དང་ཁྱད་པར་གྱི་དངོས་པོ་མེད་ན་གཞི་མཐུན་པ་ཉིད་འཐད་པ་མ་ཡིན་པས་སོ།",
    "དེ་ལྟར་ནི་སྤྱིའི་སྒྲ་ལས་ཁྱད་པར་མེད་པར་འཇུག་བཞིན་པའི་བློ་ནི་ཁྱད་པར་གྱི་སྒྲ་རྣམས་ཀྱིས་ཁྱད་པར་གཞན་རྣམས་ལ་རྣམ་པར་བཅད་ནས།",
    "ཁྱད་པར་དུ་བྱས་པའི་ཡུལ་ལ་རྣམ་པར་འཇོག་སྟེ།",
    "རྣམ་པར་རྟོག་པ་རྣམ་པ་གཉིས་ཏེ།",
    "དེ་ལ་སྔ་མ་མི་སྲིད་དོ་ཞེས་སྟོན་པ་གསུངས་པ།",
    "དེས་ན་གདོན་མི་ཟ་བར་རྣམ་པར་རྟོག་པ་གཉིས་པ་ཁས་བླང་བར་བྱའོ་ཞེས་སྟོན་པ་གསུངས་པ།",
    "འདི་ལ་གསུངས་པ།",
    "འབའ་ཞིག་གོ་སྨོས་པས་ནི་བརྗོད་པར་བྱ་བ་མཚུངས་པ་སེལ་བར་བྱེད་དེ།",
    "སྒྲ་ཁོ་ན་རྗོད་པར་བྱེད་པ་སྟེ།",
    "འདི་རྣམས་མཚུངས་ཀྱི་བརྗོད་པར་བྱ་བ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཡོད་པ་ཉིད་དམ་འབྲེལ་པའི་བརྗོད་པར་བྱ་བས་དེ་ལྡན་དང་མཚུངས་པར་འགྱུར་རོ་ཞེ་ན་གསུངས་པ།",
    "ཁྱད་པར་རིགས་དང་དེ་སྦྱོར་ལ།",
    "རིགས་དང་སྦྱོར་བ་དག་དེ་ལྡན་ཉིད་དུ་རྗོད་པར་བྱེད་པའོ།",
    "དེའི་ཚེ་སྒྲ་དེ་ཁོ་ན་སྒྲ་ཉིད་ཀྱིས་དེ་ལྡན་ནི་དེ་རྣམས་ཀྱི་སྤྱི་ཉིད་དུ་འགྱུར་ཏེ་ཞེ་ན་གསུངས་པ།",
    "གལ་ཏེ་ཡོད་པའི་སྒྲས་སྤྱི་བརྗོད་པར་བྱ་བ་ན།",
    "དེ་ལས་དེ་ཁྱད་པར་དུ་བྱ་བའི་དོན་དུ་བུམ་པ་ཞེས་བརྗོད་པར་བྱའོ་ཞེས་གཞི་མཐུན་པ་ཉིད་དུ་འགྱུར་རོ།",
    "སྤྱི་རྗོད་པར་བྱེད་པ་མེད་ན་ནི་ཅི་ཞིག་ཅིའི་ཁྱད་པར་དུ་བྱ།",
    "སྤྱི་དང་ཁྱད་པར་གྱི་དངོས་པོ་མེད་ན་ཡང་རྣམ་པ་གཞན་དུ་ཁྱད་པར་དུ་བྱེད་པ་དང་ཁྱད་པར་དུ་བྱ་བ་ཉིད་གཞུང་འཛུགས་པར་བྱེད་དོ།",
    "འདིའི་ཡོད་པ་ཉིད་ཡོན་ཏན་ཡིན་པ་ཞེས་བྱས་ནས་སོ།",
    "ཁྱད་པར་བྱེད་དང་ཁྱད་པར་དུ་བྱ་བའི་དངོས་པོར་འགྱུར་རོ།",
    "ཅི་སྟེ་མང་པོའི་ནང་ན་ཤིན་ཏུ་སྔོ་བ་ཡིན་ཞེས་ཁྱད་པར་ལ་དོགས་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་གཉིས་ཀྱི་ནང་ནས་ཆེས་སྔོན་པོའམ་མང་པོའི་ནང་ནས་ཆེས་སྔོན་པོ་ཞེས་ཁྱད་པར་གྱི་སྒྲ་རྣམས་ཀྱི་ཁྱད་པར་དུ་བྱ་བ་དེ་བཞིན་དུ་ཡོད་པ་ཞེས་བརྗོད་པ་ན་ཡོད་པ་ཉིད་ནི་དོན་དུ་མ་ལ་འཇུག་པ་ཉིད་ཀྱི་ཕྱིར་ན་གང་ཡོད་པ་འདི་ནི་ཅི་བུམ་པའམ།",
    "འོན་ཏེ་སྣམ་བུ་ཡིན་ཞེས་བུམ་པ་ལ་སོགས་པ་ལ་དོགས་པར་འགྱུར་ཏེ།",
    "དེས་ན་དེའི་སྒྲ་རྣམས་ཀྱི་ཁྱད་པར་དུ་བྱ་སྟེ།",
    "དེ་ལ་ཡོད་པ་ཞེས་བརྗོད་པ་ན་བུམ་པ་ལ་སོགས་པ་ལ་དོགས་པར་འགྱུར་ཏེ།",
    "དེས་ན་ཁྱད་པར་དང་ཁྱད་པར་ཅན་གྱི་དངོས་པོ་འདོད་པར་བྱའོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་གསུངས་པ་སྔོན་པོའི་སྒྲ་ནི་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "སྔོན་པོའི་སྒྲ་ནི་སྔོན་པོའི་ཡོན་ཏན་ཅན་གྱི་རྫས་རྗོད་པར་བྱེད་དེ།",
    "གལ་ཏེ་ཡང་དཔེ་གྲུབ་པར་གྱུར་ན།",
    "དེ་ཉེ་བར་མ་བླངས་ན་ཡང་དེའི་དངོས་པོ་ལ་ཡང་དག་པར་ཕྱོགས་པའི་ངོ་བོ་ནི་བུམ་པ་མ་ཡིན།",
    "དེའི་ཕྱིར་ཡོད་པའི་སྒྲ་ལས་བུམ་པ་ལ་སོགས་པའི་བྱེ་བྲག་ལ་དོགས་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "དེ་རྗོད་པར་བྱེད་པའི་སྔོན་པོའི་སྒྲ་ལས་གཉིས་ནས་ཆེས་སྔོ་བ་ལ་སོགས་པ་ལ་དོགས་པར་རིགས་སོ་ཞེས་སྟོན་ཏོ།",
    "འོ་ན་དེ་ལྟར་ཞེས་པས་རྣམ་པ་གཞན་གྱི་བྱེ་བྲག་ལ་དོགས་པ་སྲིད་པར་གསུངས་སོ།",
    "ཁྱད་པར་འཕེན་པར་ནུས་པའོ།",
    "དེས་ན་རིགས་ལྡན་གྱི་དོན་ནི་ཁྱད་པར་ཐམས་ཅད་འཕངས་ནས་འཇུག་སྟེ།",
    "དེ་ལས་ཀྱང་གལ་ཏེ་ཡང་བུམ་པ་ཉིད་ལ་སོགས་པ་རྣམས་ཡོད་པའི་སྒྲའི་བརྗོད་པར་བྱ་བར་མི་འགྱུར་བ་དེ་ལྟ་ན་ཡང་།",
    "ཡོད་པ་ཉིད་དང་ལྡན་པའི་དོན་གྱིས་བུམ་པ་ལ་སོགས་པ་རྣམས་འཕངས་པ་ན་ཁྱད་པར་ལ་དོགས་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཁྱད་པར་དང་ཁྱད་པར་དུ་བྱ་བ་ཉིད་མ་ཡིན་པ་མེད་དོ།",
    "ཡང་ཅི་ལྟར་དོན་གྱིས་ཁྱད་པར་མཐའ་དག་འཕེན་ཅེ་ན་སྨྲས་པ།",
    "དེ་ཡང་ངེས་པར་སྦྱོར་བ་ཁོ་ན་ལས་བུམ་པ་ཉིད་ལ་སོགས་པའི་སྤྱི་འགའ་ཞིག་དང་རྗེས་སུ་འབྲེལ་ཏེ།",
    "རྟོགས་པ་འདི་ཡང་སེལ་བར་བྱེད་པ་གསུངས་པ།",
    "ཐེ་ཚོམ་འདོད་ཕྱིར་ཁྱད་པར་ནི།",
    "ཁྱད་པར་དང་ཁྱད་པར་དུ་བྱ་བའི་དངོས་པོ་མི་འཐད་དེ།",
    "ཇི་ལྟར་ཁྱད་པར་སྨྲ་བའི་ལུགས་ཀྱིས་རིགས་ཀྱི་སྒྲ་ཁོ་ནས་ངེས་ཟིན་པའི་ཁྱད་པར་ཐམས་ཅད་ལ་ཡང་ངེས་པའི་དོན་དུ་ཁྱད་པར་གྱི་མཉན་པ་མ་སྦྱར་བ་ན།",
    "གཞི་མཐུན་པ་ཉིད་དང་ཁྱད་པར་དང་ཁྱད་པར་དུ་བྱ་བའི་དངོས་པོར་འགྱུར་བ་མ་ཡིན་པ་ཁོ་ན་བ་དེ་ལྟར་དེ་ལྡན་གྱི་ཕྱོགས་སྨྲ་བའི་ལུགས་ཀྱིས་ཀྱང་འགྱུར་རོ་ཞེས་པ་འདི་བསམས་ཟིན་ཏོ།",
    "འོ་ན་ཅི་ཞེ་ན་བྱེ་བྲག་ངེས་པར་ར་བ་སྟེ།",
    "ཡང་ན་མཁས་པས་རྩོད་པ་འདི་ཐམས་ཅད་ཀྱི་ལན་འཆད་པར་འགྱུར་རོ་ཞེས་པས་འདི་གཞག་གོ།",
    "བྱས་སོགས་བཞིན་དུ་རང་དོན་ལ།",
    "གཞན་སེལ་བས་ནི་རྗོད་པར་བྱེད།",
    "དེ་བཀག་པ་ན་དོན་དེ་ཁོ་ན་རྣམ་པར་གནས་པ་འབའ་ཞིག་གོ།",
    "འོ་ན་ཏེ་དེའི་ཁྱད་པར་དུ་བྱས་པ་ཡིན།",
    "གཞན་སེལ་བ་ཡིས་རྗོད་པར་བྱེད།",
    "དེ་ལྟར་དངོས་པོ་དེའི་ཆ་འགའ་ཞིག་དོན་གཞན་ལས་ལྡོག་པས་རྟོགས་པར་བྱ་སྟེ།",
    "སྒྲ་ནི་དོན་གཞན་ལས་ལྡོག་པས་ཁྱད་པར་དུ་བྱ་བའི་དངོས་པོ་རྣམས་སྨྲའོ་ཞེས་པ་ལ་སོགས་པ་བསྟན་པ་དེ་ལྡན་གྱི་ཕྱོགས་གསལ་བར་བྱེད་པ་རྣམས་འགལ་ལོ།",
    "ཅི་སྟེ་དེས་ཀྱང་ཁྱད་པར་དུ་བྱས་པ་ཡིན་ན།",
    "གཞན་སེལ་བས་ནི་རྗོད་པར་བྱེད།",
    "གཞན་ཡང་ཁྱད་པར་གཅིག་བསྐུལ་ན་ཡང་གཞན་ལས་ལྡོག་པ་རྟོགས་པ་ལ།",
    "རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པས་བསྐུལ་བའི་ཐ་སྙད་རྟོགས་པར་སྒྲ་རྣམས་སྟོན་ཅིང་གཞན་སེལ་བས་རྗོད་པར་བྱེད་དེ།",
    "དངོས་པོ་དེའི་ཆ་འགའ་ཞིག་དོན་གཞན་ལས་ལྡོག་པས་རྟོགས་པར་བྱའོ།",
    "སྒྲ་ནི་དོན་གཞན་ལས་ལྡོག་པའི་ཁྱད་པར་ཅན་ཁོ་ནའི་དངོས་པོ་རྣམས་རྗོད་པར་བྱེད་དོ་ཞེས་པ་ལ་སོགས་པ་གསུངས་པའོ།"
  ]
}