    "གྲོགས་པོ་དགེ་སྦྱོང་ངམ་བྲམ་ཟེ་ཚེ་རིང་ཞིང་ཡུན་རིང་དུ་གནས་པ་གང་དེ་དག་གིས་ནང་དུ་ཡང་དག་འཇོག་ཀྱང་ཁྱེད་ཅག་གི་ཚེ་དང་མཉམ་པ་དག་བྱུང་སྟེ།",
    "དངོས་པོ་བདུན་པོ་དེ་དག་གང་ཡང་རུང་བ་ཞིག་བདག་གི་གྲངས་སུ་འགྲོ་བའམ།",
    "ཚངས་པ་ངས་ནི་བརྒྱད་པོ་དེ་དག་དང་ཁྱོད་འཁོར་དང་བཅས་པ་ཡོངས་སུ་ཤེས་སོ།",
    "ཁྱོད་འདི་ལྟ་བུ་རྫུ་འཕྲུལ་དང་ལྡན་པའོ་ཞེས་རིག་གོ།",
    "ཇི་ལྟར་གྲོགས་པོ་ཁྱོད་ཀྱིས་བརྒྱད་པོ་དེ་དག་དང་བདག་འཁོར་དང་བཅས་པ་ཡོངས་སུ་ཤེས་སམ།",
    "དེ་སྲིད་སྟོང་གི་འཇིག་རྟེན་དུ།",
    "ཚངས་པ་ཁྱོད་ཀྱིས་ཉམས་སུ་མྱོང་།",
    "དེ་སྲིད་སྟོང་གི་འཇིག་རྟེན་ལ།",
    "བསིལ་ཁང་ནས་བབས་ཏེ་བསིལ་ཁང་གི་གྲིབ་མ་ཞིག་ལ་འཆག་ཅིང་བཞུགས་སོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་གནས་འཇོག་གིས་བཅོམ་ལྡན་འདས་དགོངས་ཀ་བསིལ་ཁང་ནས་བབས་ཏེ།",
    "བསིལ་ཁང་གི་གྲིབ་མ་ལ་གཅིག་པུ་འཆག་ཅིང་བཞུགས་པ་མཐོང་ངོ།",
    "ཚེ་དང་ལྡན་པ་བཅོམ་ལྡན་འདས་དགོངས་ཀྱི་དུས་ན་བསིལ་ཁང་ནས་བབས་ཏེ་བསིལ་ཁང་གི་གྲིབ་མ་ལ་གཅིག་པུ་འཆག་ཅིང་བཞུགས་པ་ཤེས་སམ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་གནས་འཇོག་དང་ཚེ་དང་ལྡན་པ་བ་ར་དྭ་ཛ་གཉིས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་ཉེ་བར་སོང་སྟེ།",
    "ཉེ་བར་སོང་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་སྤྱི་བོས་ཕྱག་བྱས་ཏེ།",
    "ངག་གིས་ཉེས་པར་སྤྱོད་པ་དང་།",
    "ངག་གིས་ཉེས་པར་སྤྱོད་པ་དང་།",
    "ངག་གིས་ལེགས་པར་སྤྱད་པ་དང་།",
    "བཙུན་པ་བྲམ་ཟེ་རྣམས་ལུས་ཀྱིས་ལེགས་པར་སྤྱད་པ་སྤྱོད་ཅིང་ངག་གིས་ལེགས་པར་སྤྱད་པ་དང་ཡིད་ཀྱིས་ལེགས་པར་སྤྱད་པ་སྤྱོད་ལ་རྗེའུ་རིགས་དང་དམངས་རིགས་རྣམས་ཀྱང་ངོ།",
    "ངག་གིས་ཉེས་པར་སྤྱད་པ་དང་།",
    "གནས་འཇོག་གང་ལས་བག་མ་ལེན་པ་དང་གཏོང་བར་གདགས་པ་ཤེས་ཤིང་རིགས་སུ་སྨྲ་བ་དང་རུས་སུ་སྨྲ་བ་དང་ལང་ཚོར་སྨྲ་བ་ཡང་ཤེས་སམ།",
    "གནས་འཇོག་རིགས་སུ་སྨྲ་བ་དང་ལང་ཚོར་སྨྲ་བ་བཏང་སྟེ།",
    "རང་གི་འོད་ཅན།",
    "མཛེས་ཤིང་ཁ་དོག་དང་ལྡན་པ་རང་གི་འོད་ཅན་ནམ་མཁའ་ལ་འགྲོ་བ།",
    "ལོ་དག་འཇིག་རྟེན་དུ་མ་བྱུང་ཞིང་སྐྱེས་པ་དང་བུད་མེད་དུ་གདགས་པ་ཡང་མེད་དེ།",
    "མཐོང་ནས་སའི་རོ་ལ་སོར་མོའི་རྩེ་མོས་རོ་མྱོང་བར་བྱེད་དོ།",
    "འདི་ལྟ་སྟེ་ད་ལྟར་མི་རྣམས་ལ་གང་ཅུང་ཟད་ཙམ་རྩ་རྣོ་བ་དེ་དག་གིས་སྐྲོད་ཅིང་སྐྲོད་པར་བྱེད་ནས་སྔོན་གྱི་མི་རྣམས་ཀྱི་ཡི་གེ་དང་ཚིག་འབྲུའི་རྗེས་སུ་ཐ་སྙད་འདོགས་པར་བྱེད་པ་ལྟ་བུ་སྟེ།",
    "མདུན་དུ་སོང་མདུན་དུ་སོང་ཞེས་སྨྲེ་སྔགས་འདོན་པར་བྱེད་དོ།",
    "ཇི་ལྟ་ཇི་ལྟར་མིག་གིས་མིག་ལ་བཙུགས་ཏེ་ལྟ་བ་དེ་ལྟ་དེ་ལྟར་ཀུན་ཏུ་ཆགས་སོ།",
    "གསེག་མ་དང་གྱོ་མོ་དག་འཐོར་ཞིང་འདི་སྐད་དུ།",
    "གོས་དག་ཀྱང་འཐོར་ཞིང་བུ་མོ་བདེ་བར་གྱུར་ཅིག་བུ་མོ་བདེ་བར་གྱུར་ཅིག་ཅེས་སྨྲ་བ་ལྟ་བུ་སྟེ།",
    "དེ་དག་ནུབ་མོ་བཟའ་བར་བྱ་བའི་སཱ་ལུ་ནུབ་མོ་ལེན་ཅིང་ནང་པར་བཟའ་བར་བྱ་བ་ནང་པར་ལེན་དུ་འགྲོ་བ་ལས།",
    "བདག་གིས་ནི་དགོངས་ཀ་དང་ནང་པར་དུས་གཅིག་ཏུ་བླངས་སོ།",
    "བདག་ཅག་ལ་སའི་ཞག་ཁ་དོག་ཕུན་སུམ་ཚོགས་པ་རོ་ཕུན་སུམ་ཚོགས་པ་དག་བྱུང་ལ་བདག་ཅག་གིས་རོ་དེ་ཁམ་གྱི་ཟས་སུ་རིམ་གྱིས་ཡོངས་སུ་ལོངས་སྤྱད་པ་ལས་ལྕི་བ་དང་མཁྲང་བ་ལུས་ལ་ཞུགས་པས་མཛེས་པ་དང་འོད་ནུབ་ཅིང་མུན་པ་འཇིག་རྟེན་དུ་བྱུང་བར་གྱུར་ཏོ།",
    "ཁ་དོག་རྣམ་པ་གཉིས་ལས་དེ་དག་ཁྱོད་ནི་ཁ་དོག་ངན་ཞིང་ང་ནི་ཁ་དོག་བཟང་བ་ཡིན་ནོ་ཞེས་ཕན་ཚུན་བརྙས་པ་བྱེད་པར་གྱུར་ཏེ།",
    "ད་ནི་བདག་ཅག་འདུས་ཤིང་ཚོགས་ཏེ་ཞིང་དག་བགོ་བར་བྱ།",
    "དེ་འདུས་ཤིང་ཚོགས་ནས་ཞིང་དག་འགོད་པར་བྱེད།",
    "ཀྱེ་ཁྱོད་རང་ལ་སཱ་ལུ་ཡོད་བཞིན་དུ་གཞན་གྱི་ལ་ཅིའི་ཕྱིར་མ་བྱིན་པར་ལེན་པ་སོང་ཤིག་ཅེས་སྨྲས་སོ།",
    "དེ་དག་གིས་ཕར་འདྲེན་ཚུར་འདྲེན་བྱེད་ཅིང་ཚོགས་ཀྱི་ནང་དུ་སྨོད་ཅིང་བཤུང་བའི་བར་དུ་བྱེད་དོ།",
    "ཁྱོད་སཱ་ལུའི་རྒྱུ་ལས་འདྲེན་པ་དང་ཚོགས་ཀྱི་ནང་དུ་སྨོད་པའི་བར་དུ་བྱུང་གིས་ཕར་སོང་ཤིག།",
    "བདག་ཅག་རྣམས་འདུས་ཤིང་ཚོགས་ཏེ་བདག་ཅག་ལས་གཟུགས་བཟང་བ་མཛེས་པ་བལྟ་ན་སྡུག་པ།",
    "ནུས་པ་ཆེ་བ་ཞིག་བཏུས་ཏེ་ཞིང་གི་དཔོན་པོར་བསྐོས་ཏེ་གང་བདག་ཅག་ལས་ཆད་པས་གཅད་པར་བྱ་བ་དེ་དག་ཆད་པས་གཅོད་ཅིང་།",
    "ནང་ཟ་བ་ནང་པར་གྲོང་དུ་བསོད་སྙོམས་ཀྱི་ཕྱིར་འཇུག་ཅིང་ནུབ་ཟ་བ་ནུབ་མོ་གྲོང་དུ་བསོད་སྙོམས་ཀྱི་ཕྱིར་འཇུག་པ་ན།",
    "ཕྱོགས་གཅིག་ཏུ་སོང་ནས་སའི་ཁང་པ་བྱས་ཏེ་བདག་ཅག་འདིར་གསང་སྔགས་དག་བཅིང་བར་བྱ།",
    "གནས་འཇོག་ཚངས་པ་སྟོང་གི་བདག་པོས་ཚིགས་སུ་བཅད་པ་སྨྲས་པ།",
    "ཅེས་ཚངས་པ་སྟོང་གི་བདག་པོས་ཚིགས་སུ་བཅད་པ་སྨྲས་པ།",
    "འཇིག་པའི་རྩེ་མོ་ནི་རྣམ་པ་གསུམ་སྟེ།",
    "གང་གི་ཚེ་འཇིག་རྟེན་མེས་འཇིག་པ་དེའི་ཚེ་འོད་གསལ་གྱི་ལྷ་དག་འཇིག་པའི་རྩེ་མོར་འགྱུར་རོ།",
    "གང་གི་ཚེ་འཇིག་རྟེན་ཆུས་འཇིག་པ་དེའི་ཚེ་དགེ་རྒྱས་ཀྱི་ལྷ་དག་འཇིག་པའི་རྩེ་མོར་འགྱུར་རོ།",
    "དཀར་གནག་ལ་རྣམ་པར་སྨིན་པ་དཀར་གནག་གི་ལས་ཀྱང་ཡོད།",
