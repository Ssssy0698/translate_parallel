    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་རི་ནག་པོའི་བྲམ་ཟེ་དང་ཁྱིམ་བདག་རྣམས་ཀྱི་འདུན་ཁང་ག་ལ་ིབ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "དེ་གང་གི་ཚེ་ཆེན་པོར་གྱུར་པ་དེའི་ཚེ་ཡི་གེ་དང་།",
    "བུད་མེད་བརྟག་པ་དང་།",
    "ཇི་ཙམ་ན་དེའི་ཕཤི་ནས་ཆུ་སྟོད་ཁྱིམ་གྱི་དཔོན་པོར་གྱུར་ནས་དེས་ཚོང་ཁང་དུ་ཉོ་ཚོང་གི་ཟོང་བཀྲམ་ིསྟེ།",
    "ཉོ་ཚོང་གིས་འཚོ་བར་བྱེད་དོ།",
    "དེ་དུས་གཞན་ཞིག་ན་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་སོང་བ་དང་།",
    "ཁྱོད་ནི་ཁོ་མོའི་བུ་གཅིག་པ་ཡིན་པས་ཇི་ཙམ་ཁོ་མོ་གསོན་གྱི་བར་དུ་རབ་ཏུ་མ་འབྱུང་ཤིག།",
    "ཁོ་མོ་ཤི་ནས་ཅི་དགའ་བ་གྱིས་ཤིག།",
    "ཁོ་མོས་དེང་དགེ་སློང་འདི་སྙེད་ཅིག་ལ་ནི་གདུགས་ཚོད་གསོལ་ཏོ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་ཚེ་དང་ལྡན་པ་ཆུ་སྟོད་རི་འོར་གཞན་ཞིག་ཏུ་བྱ་བ་ཅུང་ཟད་ཅིག་བྱུང་སྟེ་དེ་དེར་སོང་ངོ།",
    "དེ་ནས་ཁྱིམ་བདག་ནག་པས་དེ་ཉིད་ཀྱི་ནུབ་མོ་ནས་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བ་དག་སྟ་གོན་བྱས་ནས་ནང་པར་སྔར་ལངས་ཏེ་སྟན་བཤམས་སོ།",
    "ཅི་ཁོ་བོ་ལས་བརྟེན་ཏེའམ་ཁྱོད་ལས་བརྟེན་ཏེ་ནི་མ་ཡིན་ཏེ།",
    "བཙུན་པ་ཆུ་སྟོད་སྔོན་བྱུང་བ་འཛམ་བུའི་གླིང་གི་ཚོང་པ་རབ་ཏུ་མང་པོ་དག་ཅིག་རྒྱ་མཚོའི་གྲུ་བོ་ཆེ་བསྒྲུབས་ནས་ནོར་བསྒྲུབ་པའི་ཕྱིར་ལྭ་ཞིག་དང་བྱ་གག་མོ་ཞིག་ཐོགས་ཏེ་རྒྱ་མཚོ་ཆེན་པོར་ཞུགས་པ་ལས།",
    "ཅི་ཙམ་ན་བྱ་གག་མོ་དེ་དེ་ཕོ་མ་རྙེད་ནས་བྱ་ཁྭ་དང་ལྷན་ཅིག་གཅུགས་པར་གྱུར་ཏོ།",
    "གང་ཁྱོད་སླར་བྱོན་ནས་བདག་ཁོ་ན་ལ་བཟོད་པ་གསོལ་བར་གྱུར་པའི་གནས་འདི་མཆིས་སོ།",
    "རིམ་གྱིས་རྒྱུ་ཞིང་སོང་བ་ན་མཉན་ཡོད་དུ་ཕྱིན་པ་དང་དེ་ིདགེ་སློང་རྣམས་ཀྱིས་མཐོང་ནས་སྨྲས་པ།",
    "ཁྱོད་མཐོང་བ་ནི་བདག་ཅག་དགའ་ན་བྱོན་པ་ནི་མ་ཡིན་ནོ།",
    "གནས་མལ་༣བཤམས་ལ་གཎྜི་བརྡུངས་ཏེ་དྲིས་པའི་ཚིག་གིས་དགེ་སློང་རྣམས་ལ་ཡང་དག་པར་བསྒོ་ལ།",
    "ཕྱིར་འགྱེད་ིཔའི་ལས་བྱས་པའི་དགེ་སློང་གིས་རབ་ཏུ་དབྱུང་བར་མི་བྱ་ཞེས་བྱ་བའི་བར་གོང་མ་བཞིན་དུའོ།",
    "གནས་མལ་བཤམས་ལ་གཎྜི་བརྡུངས་ཏེ་དྲིས་པའི་ཚིག་གིས་དགེ་སློང་རྣམས་ལ་ཡང་དག་པར་བསྒོ་ལ།",
    "དགེ་སློང་གཅིག་གིས་ག་སོལ་བ་བྱས་ཏེ་ལས་བྱའོ།",
    "དེ་ནས་ཁྱིམ་བདག་དེའི་དྲུང་དུ་སོང་ལ་བཟོད་པ་གསོལ་ཅིག་དང་བསླང་བར་འགྱུར་རོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "དགེ་སློང་རྣམས་ཀྱིས་དེ་ལ་དེ་སྐད་སྨྲས་པ་དང་དེ་མྲག་ིཤའི་ཚལ་གང་ན་བ་དེར་རྒྱུ་ཞིང་སོང་སྟེ།",
    "རིམ་གྱིས་རྒྱུ་ཞིང་སོང་བ་དང་ཁྲག་ཤའི་ཚལ་དུ་ཕྱིན་ཏོ།",
    "དེ་ནས་ལམ་གྱིས་དུབ་པ་ངལ་སོས་ནས་ཁྱིམ་བདག་ནག་པ་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "རེ་ཞིག་གང་གིས་བདག་ལ་ཉེས་པ་བྱུང་བ་དེ་ཚར་གཅོད་དུ་འགྲོའོ།",
    "གང་གིས་བདག་ལ་ཉེས་པ་བྱུང་བ་ཞེས་བྱ་བ་ཅི་བདག་ལ་མི་ཟེར་རམ་སྙམ་མོ།",
    "དེ་དག་གིས་དེར་འོ་མའམ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་རྫིའུ་མོ་ིམ་སྨད་གཉིས་དོང་ིབ་དང་བུ་མོས་མ་ལ་སྨྲས་པ།",
    "གདོན་མི་ཟ་བར་འདིས་འགའ་ཞིག་ལ་ཚིག་གིས་ཉེས་པ་བྱས་པ་དེ་ཉིད་ཚར་གཅོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "བུ་ིསང་ངས་ཁྱོད་ཀྱི་མངོན་སུམ་དུ་བྱའོ།",
    "ཇི་ཙམ་ཕྱི་དེ་ཉིན་པར་དེ་ཞོའི་བུམ་པ་ཐོགས་ཏེ་བུ་མོ་དང་མ་སྨད་གཉིས་ཕྱོགས་དེར་ཕྱིན་པ་དང་ཚེ་དང་ལྡན་པ་ཆུ་སྟོད་ཀྱིས་ལྷུང་བཟེད་བཟེད་པས་དེས་དེའི་ལྷུང་བཟེད་དུ་ཞོས་དགང་ིབར་བརྩམས་སོ།",
    "ཁོ་བོ་ལྟ་བུའི་ལེན་པ་པོ་གཞན་ཡང་ཡོད་མོད།",
    "བུ་མོ་ཁྱོད་ལ་ངས་སྔར་ིའདི་ལྐུགས་པ་མ་ཡིན་གྱི།",
    "གདོན་མི་ཟ་བར་འདིས་འགའ་ཞིག་ལ་ཚིག་གིས་ཉེས་པ་བྱས་པ་དེ་ཁོ་ན་ཚར་གཅོད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་མ་སྨྲས་སམ།",
    "མ་ཁྱོད་ཀྱིས་སྨྲས་སོ།",
    "བདག་གིས་ཏ་ལའི་ཤིང་གསུམ་ལས།",
    "ལོ་གཉིས་ཀྱི་ནི་ནང་ལོགས་སུ་། བདག་གིས་ཚིག་གཅིག་སྨྲས་ནས་ནི།",
    "དགེ་སློང་གཅིག་གིས་གསོལ་བ་བྱས་ཏེ་ལས་།",
    "དགེ་སློང་གཅིག་གིས་གསོལ་བ་བྱས་ཏེ་ལས་བྱའོ།",
    "དགེ་སློང་གཅིག་གིས་གསོལ་བ་བྱས་ཏེ་ལས་བྱའོ།",
    "དགེ་སློང་གཅིག་གིས་གསོལ་བ་བྱས་ཏེ་ལས་བྱའོ།",
    "དགེ་སློང་འཆར་ཀས་གནས་མལ་བཤམས་ལ་གཎྜི་བརྡུངས་ཏེ་དྲིས་པའི་ཚིག་གིས་དགེ་སློང་རྣམས་ལ་ཡང་དག་པར་བསྒོ་ལ།",
    "དེའི་འོག་ཏུ་དགེ་སློང་གཅིག་གིས་གསོལ་བ་བྱས་ཏེ་ལས་བྱའོ།",
    "དྲིས་པའི་ཚིག་གིས་དགེ་སློང་རྣམས་ལ་ཡང་དག་པར་བསྒོ་ལ།",
    "༣དགེ་སློང་འཆར་ཀས་རྒན་པའི་མཐའ་ནས་ཙོག་ཙོག་པོར་འདུག་ལ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ་ཚིག་འདི་སྐད་ཅེས།",
    "དེའི་འོག་ཏུ་དགེ་སློང་གཅིག་གིས་གསོལ་བ་བྱས་ཏེ་ལས་བྱའོ།",
    "གནས་མལ་བཤམས་ལ་གཎྜི་བརྡུངས་ཏེ་དྲིས་པའི་ཚིག་གིས་དགེ་སློང་རྣམས་ལ་ཡང་དག་པར་བསྒོ་ལ།",
    "དགེ་སློང་འཆར་ཀས་རྒན་པའི་མཐའ་ནས་ཙོག་ཙོག་པོར་འདུག་སྟེ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་ཚིག་འདི་སྐད་ཅེས།",
    "དེའི་འོག་ཏུ་དགེ་སློང་གཅིག་གིས་གསོལ་བ་བྱས་ཏེ་ལས་བྱའོ།",
    "བདག་གིས་ཅི་དག་བགྱི་ཞེས་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "གཞན་ཡང་དེ་ལྟ་བུ་དང་མཐུན་པ་སུ་ཡང་རུང་བ་ལ་ཞག་དྲུག་གི་མགུ་བར་བྱ་བ་བྱིན་ཅིག།",
    "གནས་མལ་བཤམས་ལ་གཎྜི་བརྡུངས་ཏེ་དྲིས་པའི་ཚིག་གིས་དགེ་སློང་རྣམས་ལ་ཡང་དག་པར་བསྒོ་བ།",
    "དགེ་སློང་འཆར་ཀས་རྒན་པའི་མཐའ་ནས་ཙོག་ཙོག་པོར་འདུག་སྟེ་ཐལ་མོ་སྦྱར་བ་བཏུད་ལ་འདི་སྐད་ཅེས།",
