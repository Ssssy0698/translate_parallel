    "དེ་དག་ལ་ངན་སོང་གསུམ་གྱི་སྡུག་བསྔལ་མེད་པར་ཤེས་པར་བྱའོ།",
    "བུད་མེད་གང་ལ་ལ་བུ་བཙའ་བའི་དུས་ན་སྡུག་བསྔལ་མ་རུངས་པ་དྲག་པོ་མི་བཟད་པ་མྱོང་བ་དེས།",
    "ཀུན་དགའ་བོ་དེ་བཞིན་གཤེགས་པ་དེའི་མཚན་སུའི་རྣ་ལམ་དུ་གྲག་པར་གྱུར་པ་དེ་ངན་འགྲོ་ངན་སོང་དུ་འགྲོ་བར་འགྱུར་བ་ནི་གནས་མེད་དེ་གོ་སྐབས་མ་ཡིན་ནོ།",
    "ཀུན་དགའ་བོ་ཁྱོད་དད་ཅིང་ཡིད་ཆེས་པ་གང་ཡིན་པ་དེ་ནི་དེ་བཞིན་གཤེགས་པའི་མཐུ་ཡིན་པར་བལྟའོ།",
    "བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ནས་པུས་མོ་གཡས་པའི་ལྷ་ངས་ལ་བཙུགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས།",
    "སྣག་གི་གཉེན་མཚམས་དུ་བ་རྣམས་ཀྱིས་ན་བསྐོར།",
    "ཉིན་བདུན་མཚན་བདུན་དུ་ཡན་ལག་བརྒྱད་དང་ལྡན་པའི་གསོ་སྦྱོང་གི་སྡོམ་པ་བླང་བར་བྱའོ།",
    "ཞག་བཞི་བཅུ་རྩ་དགུར་མར་མེ་བུད་པར་བྱའོ།",
    "སྐུ་གཟུགས་རེ་རེའི་སྤྱན་སྔར་ཡང་མར་མེ་བདུན་བདུན་གཞག་གོ།",
    "མར་མེ་རེ་རེའི་ཚད་ཀྱང་ཤིང་རྟའི་འཕང་ལོ་ཙམ་དུ་བྱས་ཏེ།",
    "རང་གི་དམག་ཚོགས་སམ།",
    "ཁྱོད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ལས་མ་ཐོས་སམ།",
    "གང་དག་ཧ་ཅང་བག་མེད་དེ་བག་མེད་པར་གནས་པ་དེ་དག་ལ་མི་མ་ཡིན་པ་དག་གིས་མདངས་འཕྲོག་པའོ།",
    "དེ་དག་གིས་ཚིག་གཅིག་ཏུ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ངས་ལ་བཙུགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུང་ནས།",
    "རེ་བ་ཐམས་ཅད་ཡོངས་སུ་སྐོང་བ་ཞེས་བྱ་བར་ཡང་ཟུང་ཤིག།",
    "དེས་རེ་ཤག་ན་རབ་ཏུ་བྱུང་བ་ཐམས་ཅད་ལ་མཆོད་སྦྱིན་བྱས་ནས།",
    "མཆོད་སྦྱིན་གྱི་མདུན་ས་གཟིགས་སུ་གསོལ་ཞེས་བྱས་སོ།",
    "ལྷ་རྣམས་ཀྱི་ལྷའི་མཐུས་མེཏོག་དེ་དག་བཅོམ་ལྡན་འདས་ཀྱིགཉིས་པཱད་དུ་མེ་ཏོག་གི་ཁང་པར་གྱུར་ཏེ་འདུག་གོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་ཐལ་མོ་སྦྱར་ནས།",
    "འདི་སྙམ་དུ་དགོངས་ཏེ་དས་བྲམ་ཟེ་གང་པོ་རྫུ་འཕྲུལ་གྱི་ཆོའཕྲུལ་གྱྀས་དད་པར་བྱའོ་སྙམ་མོ།",
    "འོད་འདོམ་གང་གིས་བརྒྱན་པ།",
    "མཐོང་ནས་ཀྱང་ཤིན་ཏུ་རིངསཔར་བཅོམ་ལྡན་འདས་ཀྱི་ཐད་དུ་སོང་སྟེ་བཙེམ་ལྡན་འདས་ལ་གསོལ་པ།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་ཡོངས་སུ་བཏང་ན་ལྷུང་བཟེད་འདིའི་ནང་ངུ་བྱི་ནཅིག།",
    "བཅོམ་ལྡནའདས་དང་དགེ་སློང་སྟེ་ད་གི་ལྷུར་བཟེད་རྣམས་གང་བར་གྱུར་ཏེཞེས་བྱ་བའི་སྒྲ་བརྗོད་དོ།",
    "ཀྱེ་ཅི་བདགཅག་འདི་ནས་ཤི་འབོས་སམ་འོན་ཏེ་གཞན་དུ་སྐྱེས་སམ་སྙམ་མོ།",
    "དེ་དག་གིས་སྤྲུལ་པ་མཐོང་།",
    "ཀྱེ་བདག་ཅག་ནོ་འདི་ནས་ཀྱང་ཤི་འཕོས་བར་མ་གྱུར་ལ་གཞན་དུ་ན་ཡང་མ་སྐྱེས་མོད་ཀྱི།",
    "རྒྱལ་ཆེན་བཞིའི་རེསི་རྣམས་དང་སུམ་བཅུ་རྩ་གསུམ་པ་རྣམས་དང་འཐབ་བྲལ་རྣམས་དང་དགའ་ལྡན་རྣམས་དང་།",
    "དེ་ནས་འོད་ཟེར་དེ་དག་གིས་སྟོང་གསུམ་གྱི་སྟོད་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་བསྐོར་ནས།",
    "སྤུས་མོ་གཉིས་སུ་མ་སྣང་བར་འགྱུར་རོ།",
    "དེ་ནས་འོད་ཟེར་དེ་དག་གིས་བཙ་མ་ལྡན་འངས་ལ་ལན་གསུམ་དུ་བསྐོར་བ་བྱས་ཏེ།",
    "བཟང་པོ་དག་གིས་ཐེ་ཚོམ་སྐྱེས་པ་བ།",
    "དེ་ནས་དམག་དཔོན་སེང་གེ་འདི་སྙམ་དུ་སེམས་ཏེ་ཀྱེ་མ་བུ་མོ་ཁདི་ན་ཆེ་ཆེ་ན་པོ་ལམོས་བ་ཞིག་སྟེ་གལ་ཏེ་འདིན་རྐྱེན་དང་ཕྲང་ན་ནི།",
    "བཙུན་པ་གདུགས་ཚོད་ལ་བབ་སྟེ་བཤོས་གསོལ་ལགས་བཅོམ་ལྡན་འདས་ཀྱིས་ང་དེའི་དུས་ལ་བའ་བར་དགོངས་ཏེ་གཤེགས་སུ་གསོལ་ཞེས་བསྐུལ་ཏོ་དེ་ནས་བཚོམ་ལྡན་འདས་དགེ་སློང་གི་ཚོགས་ཀྱིས་ཞམ་རིང་བྱས་ཏེ།",
    "ཆེསབཙོམ་ལྡན་འདས་ལ་མེ་ཏོག་དག་གིས་གཏོར་ཏོ་དེ་ནས་མེ་ཏོག་དེདག་འདི་ལྟ་སྟེ།",
    "དོནས་བཅོམ་ལྡན་འདས་ཀྱིས་བུ་མོ་གྲགས་ལྡན་མའི་རྒྱུ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པ་དང་།",
    "དེ་དག་གིས་སྤྲུལ་པ་མཐོང་ནས་འདི་སྙམ་དུ་སཁ་མ་ཏེ་ཀྱེ་བདག་ཅགན་པ་ནས་ཀྱང་གི་འབོས་པར་མ་གྱུར་ལ་གཞན་དུ་ཡང་མ་སྐྱེས་མོད་ཀྱི།",
    "ཅན་སྣང་བ་འདིའི་མཐུས་བདག་ཅག་གི་གནོད་པའི་ཁྱད་པར་རྣམས་རྩ་ཞལ་བར་གྱུར་ཏོ་སྙམ་མོ།",
    "རེ་སྐྱ་བར་ལུང་སྟོན་པར་བཞེད་ན་ནི་སྐུས་མོ་གཉིས་སུ་མི་སྣང་བར་འགྱུར་རོ།",
    "དེ་ནས་ཚདང་ལྡན་པ་ཀུན་དགའ་བོས་ཐལ་མོ་སྦྱར་ཏེ་བཙོམ་ལྡན་འདས་ལ་ཞུས་པ།",
    "གང་གི་དོན་དུ་དཔའ་བོ་འཛུམ་པ་སྟོནམཛད་པ།",
    "འཇིགརྟན་ན་ཡངགསོལ་བ་བཏབ་པའི་རྒྱས་བུ་དང་བུ་མོ་སྐྱེ་བརའགྱུར་རོ་ཞེས་བྱ་བའི་གཏམ་དེ་ཡོད་མོད་ཀྱི།",
    "བདག་གི་བྱ་བ་དག་བྱེད་པར་ཤོག་ཤག།",
    "ཁེའུ་གཟུགས་བཟང་ཞིངབལྟ་ན་སྡུག་ལ་མཛེས་པ་ཞིག་ཙས་ནས་དེ་བཙས་པའི་ཚེ་ཁྱིམ་གང་གི་མི་ཐམསཅད་དགའ་བར་ཁུརོཏ་དེ་བཙས་པའི་བཙས་སྟོན་བྱས་ནས།",
    "ཁྱུ་མཆོག་གི་ཡད་དག་པའི་སང་གེའི་སྒྲ་ཆེན་པོ་སྒྲོགས་པ།",
    "འོད་འདོམ་གང་གིས་བརྒྱན་པ།",
    "ཀྱེ་མ་བརྩོན་འགྲུས་རྩོམ་པ་ལ་ནི་ཁྱད་པར་ཆེན་པོ་དེ་ལྟ་བུ་ཡོད་ཀྱིསབདག་གིས་ཕྱིར་ཞང་བརྩོན་འགྲུས་བཙམ་བར་བྱ་གོརམ་ཆག་སྙམ་ནས་དེས་མཉན་དུ་ཡོད་པར་དྲིལ་གྱི་སྒྲ་སྒྲགས་ཏེ།",
    "དེ་ནས་བཙེམ་ལྡན་འདས་ཀྱིས་ཁྱེའུ་ལེ་ལོ་ཅན་གྱི་རྒྱུག་ཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པ་དང་ལས་གཅྀགི་ནས་གཅིག་དུ་བརྒྱུད་པ་མཁྱེན་ནས་འཛུམ་པ་འཛད་དོ།",
    "ཀྱ་ཙ་བིདག་ཅ་ག་འདི་ནས་ཤི་གོད་༣འཕོས་སམ་འོན་ཏེ་གཞན་དུ་སྐྱེས་སམ་སྙམ་མོ།",
    "དེ་དག་གིས་སྤྲུལ་པ་མཐོང་ནས་འདི་སྙམ་རུ་སེམས་ཏེ་ཀྱེ་བདག་ཆག་འདི་ནཀྱད་ཤྭ་འཕོས་པར་མ་གྱུར་ལ་གཞན་དུ་ཡང་མ་སྐྱས་མོད་ཀྱི།",
    "དེ་ནས་འོ་་ཟེར་དེ་དག་གིས་བཅོམ་ལྡན་འདས་ལ་ལན་གསུམ་བསྐོར་བབྱས་ཏེ།",
    "པ་ཀུན་དགའ་བོས་ཐལ་མོ་སྦྱར་ཏེ་བཅོམ་ལྡན་འདས་ལཞུས་པ།",
    "གང་གི་དོན་དུ་དཔའ་བོ་འཛུམཔསྟོན་མཛད་པ།",
    "དེ་ནས་དེ་མི་དགའ་བཆེན་པོ་སྐྱེས་ནས་དེ་འདི་སྙམ་དུ་སེམས་ཏེ་བདག་གིས་ཐབས་གར་གིས་ནོར་བསྡུ་བར་བྱ་བའི་ཐབས་ཅི་ཡོད་སྙམ་མོ།",
    "བཅོམ་ལྡན་འདས་ལ་སྔོས་དབུལ་བད་བྱ་གོར་མཆག་སྙམ་མོ།",
    "བདག་གི་སེམས་ལ་བརྒྱད་བཀག་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྐུ་བསླུ་བ་འདི་ནི་བདག་གི་ཆ་མ་ཡིན་ནོ་ཞེས་བྱས་སོ།",
    "འོན་ཏེ་གཞན་དུ་སྐྱེསསམ་སྙམམོ།",
    "བཅོམ་ལྡན་འདས་སྦྲུལ་པ་འགྱེད་པར་མཛད་དེ་དེ་ངག་གིས་སྦྲུལ་བ་མཐོང་ནས་འདི་སྙམ་དུསམས་ཏེ།",
    "ཀྱེ་བདག་ཅག་ནི་འདི་ནས་ཀྱང་ཤི་འཕོས་པརམ་གྱུར་ལ་གཞན་དུ་ཡང་མ་སྐྱེས་མོདཀྱི།",
    "མིར་སྐྱེ་བར་ལུང་སྟོན་པར་བཞེད་ན་ན་བུས་མོ་གཉིས་སུ་མི་སྣར་བར་འགྱུར་རོ།",
    "སྟོབས་ཀྱི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་བཅུ་དྲུག་པོར་ལུང་སྟོན་པར་བཞེད་ན་ནི་ཕྱག་གཡོན་བའི་མཐལ་དུ་མི་སྣད་པར་འགྱུར་རོ།",
    "འཁོར་ལོས་སྐྱར་བའི་རྒྱལ་བོར་ལུང་སྟོན་པར་བཞེད་ན་ནི་ཕྱག་གཨས་པའི་འཐལ་རུ་མ་སྣད་བར་འགྱུར་རོ།",
    "དེ་ནས་འོད་ཟེར་དེ་དག་གིས་བཅོམ་ལྡན་འདས་ལ་ལན་གསུམབསྐོར་བ་བྱས་ཏེ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའབོས་ཐལ་མོ་སྦྱར་ཏེ།",
    "ཐུབ་པ་ཁྱུ་མཆོག་གི་ནི་གསུང་མཆོག་བརྟན་པ་དང་།",
    "གང་གི་དོན་དུ་དཔའ་བོ་འཛུམ་པ་སྟོན་མཛད་པ།",
    "དེ་ནི་ཁྱོད་ལས་སྐྱེ་བོ་ཕལ་ཆེན་ཉན་པ་འཚལ།",
    "བདག་གི་སེམས་ནི་རབ་ཡངས་དཔག་ཡས་ཏེ།",
    "ཀྱེཅིབདག་ཅག་འདིནས་ཤི་འཕོས་སམ་འོན་ཏེ་གཞན་དུ་སྐྱས་སམ་སྙམ་མོ།",
    "དེ་དག་གིས་སྤྲུལ་པ་མཐོང་ནས་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "ཀྱེ་བདག་ཅ་ག་ན་འདི་ནསཀྱང་ཤི་འཕོས་པརམ་གྱུར་ལ་གཞན་དུ་ཡང་མ་སྐྱེས་མོད་ཀྱི།",
    "འོན་ཀྱང་སྡོནམ་བྱུང་བའི་སམས་ཅན་སྣང་བའདིའི་མཐུསདག་གི་གནོད་པའི་ཁྱད་པར་རྣམས་རྩེ་ཞིལ་བར་གྱུར་ཏོ་སྙམ་མོ།",
    "སྟོབས་ཀྱི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་བོར་ལུ་སྟོན་པར་བཞེད་ན་ནི་ཕྱག་གཡོན་པའི་མཐལ་དུ་མི་སྣད་བར་འགྱུར་རོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་བུད་ཆུབ་ཏུ་ལུང་སྟོན་པར་བཞེད་ན་ནི་དབུའི་གཙུག་ཏོར་དུ་མི་སྣད་བར་འགྱུརརོ།",
    "དེ་ནས་འོད་ཟེར་དེ་དག་གིས་བཙེམ་ལྡན་འདས་ལ་ལན་གསུམ་བསྐོར་བ་བྱས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་དབུའི་གཙུག་ཏོར་དུ་མི་སྣར་བར་གྱུར་ཏོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་ཐལ་མོ་སྦྱར་ཏེ་བཅོམ་ལྡན་འདས་ལ་ཞུས་པ་ཚོན་སྣ་ཨུབཅུདགུགོང་ཉྩི་སོགས་ོསྟོང་གིས་སྤེལ་བ་སྣ་ཚོགས་ཅན་མངཔོ་ཞལ་གྱི་སྒོ་ནས་བྱུང་བར་གྱུར།",
    "ཐུབ་པ་ཁྱུ་མཆོག་གི་ནི་གསུད་མཆོག་བརྟན་པ་དང་ བཟང་པོ་དག་གིས་ཐེཚོམ་སྐྱེས་པ་བསལ་བར་གསོལ།",
    "དེ་ནི་ཁྱོད་ལས་སྐྱེ་བོ་ཕལ་ཆེ་ན་ཉན་པར་འཚལ།",
    "ཁྱུ་མཆོག་གི་ཡང་དག་པའི་སེརགེའི་སྒྲ་ཆེན་པོ་སྒྲོགས་པ།",
    "སུ་ནི་ཡོངས་སུ་སྨིན་ཟིན་པ་ལས་རྣམ་པར་གྲོལ་བར་བྱ་སྙམ་དུ་ཨེ་ཤེས་གཟིགས་པ་འཇུག་གོ།",
    "དོ་ནས་བཅོམ་ལྡན་འདས་ཀྱས་ཚོང་དཔོན་གྱི་བུ་ར་བའི་གནས་སྐབས་དེ་གཟིགས་ནས།",
    "དེ་དག་གིས་དེའི་ལུས་ལ་ཕོག་མ་ཐག་ཏུ་རབ་ཏུ་སིམ་པར་གྱུར་ཏོ།",
    "འདིནཁྱོདཀྱིསེམས་ཀྱི་སྡུག་བསྔལ་གྱི་གཉེན་པོ་ཡིན་ནོ་ཞེས་བཀའ་སྩལ་ཏོ།",
    "འདི་ནི་ཁྱོད་ཀྱི་ལུས་ཀྱི་སྡུག་བསྔལ་ཚ་བ་ཞི་བར་བྱེདཔ་ཡིན་ནོ་ཞེས་བཀའ་སྩལ་ཏོ།",
    "སེམས་དགའ་བར་གྱུར་ནས་རྒྱལ་པོ་གསལ་རྒྱལ་ལ་བརེད་དེ།",
    "བདགཅག་གིགནོད་པའིཁྱད་པརརྣམསརྩེ་ཞིལ་བར་གྱུར་ཏོསྙམ་མོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་ཐལ་མོ་སྦྱར་ཏེ།",
    "ཐུབ་པ་ཁྱུ་མཆོག་གི་ནི་གསུམ་མཆོག་བརྟན་པ་དང་།",
    "གང་གི་དོན་དུ་དཔའ་བོ་འཇུམ་པ་སྟོན་མཛད་པ།",
    "དེ་ནི་ཁྱོད་ལས་སྐྱེ་བོ་ཕལ་ཆེན་ཉན་པར་འཚལ།",
    "བཙོམ་ལྡན་འདས་ཀྱིས་བསྟན་པ་ལ་དང་བ་རེད་དེ།",
    "དེ་ནས་རེ་ཤིག་ན།",
    "བཙོམ་ལྟན་འདས་ག་ལ་བ་དེར་སོང་ནས།",
    "མིའི་སྐྱབར་ལུ་སྟོན་པར་བཞེད་ན་ནིབུས་མོ་གཉིས་སུ་མི་སྣང་བར་འགྱུར་རོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་ཐལམ་སྦྱར་ཏེ།",
    "ད་ནས་ཀོ་ས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་བཅོམ་ལྡན་འདས་ཀྱིས་ཅ་ངམི་གསུང་བས་གནང་བར་རེག་སྟེ།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་གི་ཡུལ་ཏུ་གཤོགས་པར་རིག་གོ།",
    "དེས་བརྩོན་པ་དང་བསྒྲུབ་པ་དང་འབད་པས་ཉོན་མོངས་པ་ཐམས་ཅང་སྔངས་ཏ་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་ངུ་བྱསསོ།",
    "ཀྱེ་བདག་ཅག་ནི་འདི་ནས་ཀྱངཀི་འཕོས་པར་མ་གྱུར་ལ་གཞན་དུ་ཡང་མ་སྐྱམམོདཀྱི།",
    "འབྲས་བུཆེ་རྣམས་དང་མི་ཆེ་རྣམས་དད་མ་གདུང་རྣམས་དང་གྱ་རྣམ་སྣང་རྣམས་དང་ཤིན་ཏུ་མཐོད་རྣམས་དང་འོག་མིན་གྱི་ལྷ་རྣམས་ཀྱི་བར་དུ་སོང་ནས།",
    "དེ་ནས་འོད་ཟེར་དེ་དག་གིས་སྟོད་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེནགྱི་ཁམསབསྐོར་ནས།",
    "དེ་ནས་འོད་ཟེར་དེ་དག་གིས་བཅོམ་ལྡན་འདས་ལལན་གསུམ་བསྐོར་བབྱས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་དབུའི་གཙུག་ཏོར་དུ་མི་སྐད་བར་གྱུར་ཏོ།",
    "ངོ་ནསརེ་ཤིག་ན་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་ཐོས་ནས་བློན་པོ་རྣམས་ལ་དེ་གཉིས་ཀྱི་བློངས་ཤིགཅེས་བསྒོའོ།",
    "དེ་སྐད་ཅེས་བརྗོད་པའི་མོད་ལ་མེ་ཏོག་དེ་དག་ནི་ས་ལ་ལྷགས་སོ།",
    "བདེན་པ་དང་བདེན་པའི་ཚིག་གང་གིས་བཅོམ་ལྡན་འདས་སམས་ཅན་ཐམསཅད་ཀྱིས་མཆོག་ཡིན་པའི་བདེན་པ་དང་བདེན་པའི་ཚིག་དེསན།",
    "རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་ལོགས་སུ་ཁ་ལྟས་ཏེ་སོང་ངོ།",
    "གཅིག་གིས་ནི་སྐྱབས་སུ་འགྲོ་བ་དང་བསླབ་པའིགཞིབླངས་སོ།",
    "ངེ་ནས་དེ་དག་དང་བསྐྱད་པའི་ཕྱིར་བཅོམ་ལྡན་འདས་སྤྲུལ་པ་འགྱེད་པར་མཛདདེ་དག་གིས་སྦྲུལ་པ་མཐོདནས་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "ཀྱེ་བདག་ཅག་ནི་འདི་ནས་ཀྱང་ཤ་འཕོས་པར་མགྱུར་ལ་གཞན་དུ་ཡང་མ་སྐྱས་མོད་ཀྱི།",
    "སྟོབས་ཀྱིའཁོར་ལོས་སྐྱརབའི་རྒྱལ་བོར་ལུང་སྟོན་པར་བཞེད་ན་ནི་ཕྱག་གཡོན་པའི་མཐལ་ངུམ་སྣང་བར་འགྱུར་རོ།",
    "དེ་ནས་ཚེ་དང་ལྡནཔ་ཀུན་དགའ་བོས་ཐལ་བོ་སྦྱར་བཅོམ་ལྡན་འདས་ལ་ཞུས་པ།",
    "གང་གི་དོན་ཏུ་དབའ་བོ་འཛུམ་པསྟོན་མཛད་པ།",
    "དགྲ་ཟླ་མ་ལགས་པར་དགྲ་བགྱིདབ་ལགས་མོད་ཀྱི།",
    "འདི་ན་བདགགི་གྲོགས་པོའྀ་བུ་ལགསཟླ་༡ རྒྱལ་པོ་གསལ་རྒྱལ་གྱིསའདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཙུན་པ་རྒྱལ་པོ་མ་སྐྱེས་དགྲ་འདིན་ཡུན་རིང་པོནས་བདག་གི་ཁེན་ཟླུམ་ལགས་པར་ཁོན་དུ་འཛིན་པ་དང་པའྀ་སླད་ངུ།",
    "དེ་ན་རེ་བང་ག་ཅི་དགའ་བའི་བྱ་དགའ་འཚལ་གྱིས་བདག་ཞག་བདུན་གྱི་བརུ་དུ་རྩི་དགའ་མགུར་བགྱིད་པའི་རྒྱལ་སྲིད་སྩོལ་ཚིགཅེས་བྱས་སོ།",
    "དེ་དག་གིས་སྤྲུལ་པ་མཐོང་ནས་འདི་སྙམ་དུསམས་ཏེ།",
    "དེ་ནས་འོད་ཟེར་དེ་དག་གིས་བཅོམ་ལྡན་འདས་ལ་ལནག་སུམ་བསྐོར་༡༡།",
    "ཐུབ་པ་ཁྱུ་མཆོག་གི་ནི་གསུང་མཆོག་བསྟན་པ་དང་།",
    "བཟང་པོ་དག་གིས་ཐེ་ཚོ་མསྐྱེས་པ་བསལབར་གསོལ།",
    "གང་གི་དོན་དུ་དཔའ་བོ་འཛུམ་པ་སྟོན་མཛད་པ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བདེལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུང་ནས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ།",
    "ཆུ་ཀླུང་ཁང་ལྡན་གྱི་འགྲམ་དུ་བདགཅག་གི་དེར་སོང་གདུགས་ཚོང་གསོལ་བརརྩེ་གནངགྲུ་ཟམ་ལས་ཀྱང་བསྒྲལ་བར་འཚལ་ལོཞེས་གསོལ་ནས།",
    "དེནས་ཐ་ཉན་པ་དེ་དག་གིས་ཆུ་ཀླུང་ཁང་ལྡན་གྱི་འགྲམ་རྡོ་དོང་གསོག་མ་དང་།",
    "སྦོས་ཀྱི་སྣོད་དག་གིས་ནང་ནས་ནི་བདུག་པ་གསོལ།",
    "དེ་ནས་བཅོམ་ལྡནའདས་དགེ་སློང་གི་ཚོགས་ཀྱིས་༩ཁམཟིད་བྱས་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་གཉན་པ་དེ་དག་གིསསམ་པ་དང་བག་ལ་ཉལ་བ་དང་ཁམས་དང་རང་བཞིན་ཐུགས་སུ་ཆུད་ནས།",
    "ཁ་ཅིག་གིས་ནལ་ནཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཐེབ་པོ།",
    "བདག་གིས་ཐོག་མ་ཁོ་ནར་བཅོར་ལྡན་འས་བསྒྲལ་བར་འཚལ་ལོ།",
    "ཁཅིག་གིས་ནི་བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་བྱངཆུ་བ་དུ་སེམས་བསྐྱད་དོ།",
    "བདག་གི་ཡུལ་དུ་བྱོན་ཏེ་ཞེམ་ཐོས་སོ།",
    "བཙེམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བ་ཅུང་ཏེ།",
    "པོག་ཕོར་དག་གིས་ནི་བདུགས་ཏེ།",
    "ཁྱུ་མཆོག་གི་ཡང་དག་པའི་སེངགེའི་སྒྲ་ཆ་ན་པོ་སྒྲོགས་པ།",
    "སུ་ནི་ངན་སོང་དུ་བབ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགོངས་པ་བསྐྱེད་པའི་མོདོལ།",
    "བཅོམ་ལྡན་འདས་ཀྱིཐང་དུ་སོང་སྟེ།",
    "ཁཅིགགིས་ནི་ལན་ཅིག་ཕྱིར་འོང་བའིའབྲས་བུ་ཐེབཔོ།",
    "ཁཅིག་གིས་ནི་ཕྱིར་མི་འདོབའི་འབྲས་བུ་ཐོབ་པ།",
    "ཁཅིག་གིས་ནི་ཉན་ཐོས་ཀྱི།",
    "ལུས་ཅ་ན་དག་གི་ལས་རྣམས་ནི།",
    "བུས་མོ་གཡས་པའི་དྷུ་ལྷངས་ལ་བཙུགས་ཏེ།",
    "བཅོམ་ལྡན་འདསཡང་དག་པར་བརྒྱ་བྱིན་གྱིས་གང་གིས་ལོ་ཏོག་ཐམསཅང་རྒྱལ་བར་འགྱུར་པ་དེ་ལྟ་བུའི་དབ་དཆེན་གྱི་ཆར་ཕབ་པོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞིའི་ཞབས་ཀྱི་མཐལ་ཤིན་ངུ་བརྟན་པ།",
    "སུ་ནི་ངན་སོང་དུག་ཞོལ།",
    "སུ་ནི་ང་ནསོང་དུ་འབབ་སུ་ནི་ངན་སོང་དུ་བབ།",
    "དགེ་སློང་གི་ཚོགས་ཀྱིས་ཞམ་རིང་བྱས་ཏེ།",
    "ཁ་ཅིག་གིས་ནི་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཐེབ་པོ།",
