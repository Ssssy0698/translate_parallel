    "ཐམས་ཅད་མཁྱེན་པའི་གནས་ལ་གནས་པ་དང་།",
    "ལེགས་པར་སྤྱོད་པའི་རྟེན་ལ་སྤྱོད་པ་དང་།",
    "ཤིན་ཏུ་དག་པར་འགྱུར་བ་དང་།",
    "ཡེ་ཤེས་རྣམ་པར་དག་པར་འགྱུར་བ་དང་།",
    "ལམ་རྣམ་པར་དག་པར་འགྱུར་བ་དང་།",
    "བསམ་པ་རྣམ་པར་དག་པར་འགྱུར་བ་དང་།",
    "ཡེ་ཤེས་རྣམ་པར་དག་པར་འགྱུར་བར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཁ་དོག་མཐའ་ཡས་པར་སྣང་བའི་མར་མེ་འམ།",
    "ཐོགས་པ་མྱེད་པའི་སྣང་བ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ཡོངས་སུ་བསྔོ་བ་ཐོགས་པ་མྱེད་པར་འགྲོ་བས་དེ་ལྟར་ལྟར་ཡོངས་སུ་བསྔོའོ།",
    "འཕགས་པའི་བསྟན་པ་ལ་གནས་པར་བརྩོན་པས་སློབ་དཔོན་དང་།",
    "སྣོད་བཟང་པོ་རྣམ་པར་དག་པར་གྱུར་ཅིག།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་ཁོངས་སུ་ཆུད་པར་གྱུར་ཅིག།",
    "ནོར་བུའི་ཤིང་རྟ་ལ་རྒྱན་གྱིས་ཤིན་ཏུ་མཛེས་པར་བྱས་པ་སྦྱིན་པ་འམ།",
    "འཁྲུལ་བ་མྱེད་པར་དྲང་བ་སྦྱིན་པ་འམ།",
    "སྤོས་ཞིམ་པོ་ཡིད་དུ་འོང་བ་རྣམ་པར་དག་པ།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ཡོངས་སུ་དག་པ་དང་མཐུན་ཞིང་གཅིག་པར་གྱུར་ཅིག།",
    "ཡོན་ཏན་གྱིས་རྣམ་པར་དག་པའི་ཡིད་དང་ལྡན་པ།",
    "མཐུན་པར་ཡོངས་སུ་གཏོང་བའི་བསམ་པ་ཅན།",
    "མཆོད་སྦྱིན་ཆེན་པོའི་མཆོད་སྦྱིན་ཤིན་ཏུ་བྱས་པ།",
    "རྫུ་འཕྲུལ་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "རྫུ་འཕྲུལ་གྱི་འཁོར་མཐའ་ཡས་པ་ལ་མཁས་པར་གྱུར་ཅིག།",
    "དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་ལ་རྣམ་པར་སེམས་པ།",
    "ཕན་འདོགས་པ་རྣམ་པར་དག་པས་ཆོ་འཕྲུལ་མཐའ་ཡས་པས་རྣམ་པར་རོལ་པ་ཡང་དག་པར་སྟོན་པར་གྱུར་ཅིག།",
    "མྱི་ཟད་པས་ཐམས་ཅད་མཁྱེན་པའི་མཐར་ཐུག་པར་གྱུར་ཏེ།",
    "སྦྱིན་པའི་གནས་དོན་ཡོད་པའི་འབྲས་བུ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ཐོས་པ་དོན་ཡོད་པར་གྱུར་ཅིག།",
    "ཞེས་སྤྱི་བོས་བཏུད་དེ་བཟོད་པ་གསོལ་བས་སློང་བ་ཐམས་ཅད་བཟོད་པར་བྱས་རིམ་གྲོར་བྱས།",
    "ཐོག་པ་ཆེན་པོའི་ཤིང་རྟ་ལ་ཞོན་པར་གྱུར་ཅིག།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡེ་ཤེས་ཀྱི་ཤིང་རྟ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ནམ་ཙོང་དང་རྨིག་པར་ལྡན་པ།",
    "སེམས་ལ་ཆགས་པ་མེད་པར་གཏོང་བ་དང་།",
    "སྟན་གྱི་སྦྱིན་པ་བྱེད་ཅིང་རྒྱལ་པོ་བཞུགས་པའི་ཁྲི་སྟན་བཟང་པོ་བེ་ཌཱུརྱའི་རྐང་པ་ཅན་སེང་གེའི་ཁྲི་ལ་གནས་པ།",
    "ཆིས་བྱ་བ་ལ་རྒྱལ་པོའི་བཀའ་ཐམས་ཅད་ཉམས་པ་མེད་པར་ཉན་པ།",
    "དཔལ་རྣམ་པར་སྣང་བ་དང་།",
    "དགའ་བ་འཁྱིལ་པའི་རྒྱན་སྣ་ཚོགས་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "ཁམས་གསུམ་པས་ཟིལ་གྱིས་མྱི་ནོན་པའི་སྟན་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "རྒྱན་གྱི་རྣམ་པ་བསམ་གྱིས་མི་ཁྱབ་པ་སྣ་ཚོགས་དང་ལྡན་པའི་སྟན་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "རྣམ་པར་འཕྲུལ་པ་ཐམས་ཅད་དང་།",
    "རྡོ་རྗེའི་གདན་ཐམས་ཅད་ལ་འཁོད་པར་གྱུར་ཅིག་ཅེས།",
    "ཉེན་ཀོར་དྲི་ཞིམ་པར་བསྒོས་ཤིང་བདུགས་པ།",
    "ནམ་མཁའི་མཐས་གཏུགས་པ་ཐམས་ཅད་ན་བཞུགས་པ་ཐམས་ཅད་ལ་གདུགས་ཀྱིས་དགབ་པའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "རྒྱན་མཛེས་ཤིང་རྣམ་པར་དག་པའི་གདུགས་དང་།",
    "བློ་ཡངས་པ་དང་སེམས་རྒྱ་ཆེ་བ་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཡེ་ཤེས་ཆེན་པོས་མཉམ་པར་དགབ་པ་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "སེམས་དང་བསམ་པ་རྣམ་པར་དག་པར་འགྱུར་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "རྒྱལ་མཚན་ཤིན་ཏུ་འཕགས་པར་གྱུར་ཅིག།",
    "ཡེ་ཤེས་མཐུ་བོ་ཆེའི་རྒྱལ་མཚན་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ཡེ་ཤེས་ཀྱི་ཉི་མའི་དཀྱིལ་འཁོར་འོད་ཟེར་རབ་ཏུ་འགྱེད་པའི་རྒྱལ་མཚན་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ལུས་བལྟ་ན་སྡུག་པ་ལུས་རྣམ་པར་དག་ཅིང་མྱི་མཐུན་པ་མྱེད་པའི་རྒྱན་ཀྱིས་ལུས་ཤིན་ཏུ་བརྒྱན་པ།",
    "རྒྱན་གྱིས་བརྒྱན་པར་བརྩོན་པ།",
    "མཚན་གྱིས་ལུས་ཤིན་ཏུ་བརྒྱན་པར་གྱུར་ཅིག།",
    "ལུས་མཚན་གྱིས་ཤིན་ཏུ་བརྒྱན་པར་གྱུར་ཅིག།",
    "རྣམ་པར་དག་པ་དང་ལྡན་ཞིང་ཡོན་ཏན་གྱིས་བརྒྱན་པའི་དབྱངས་དང་ལྡན་པར་གྱུར་ཅིག།",
    "སེམས་ཀྱི་རྒྱན་གྱིས་བརྒྱན་པར་གྱུར་ཅིག།",
    "གཟུངས་ཐམས་ཅད་ཀྱི་རྒྱན་གྱིས་རབ་ཏུ་བརྒྱན་པར་གྱུར་ཅིག།",
    "སེམས་ཡེ་ཤེས་ཀྱིས་ཡང་དག་པར་བརྒྱན་པ་དང་ལྡན་པར་གྱུར་ཅིག་ཅེས།",
    "དྲེགས་པ་མེད་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ལྟོས་པ་མྱེད་པར་ཡོངས་སུ་གཏོང་བའི་སེམས་རྣམ་པར་འཕེལ་བར་བྱེད་པ་དང་།",
    "སྤྱི་བོ་གཙུག་ཏོར་ཅན་གྱི་མགོ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ཡེ་ཤེས་ཀྱི་ཅོད་པན་ཤིན་ཏུ་བཅིངས་པར་གྱུར་ཅིག།",
    "སྤྱི་བོ་ཤིན་ཏུ་བཙུན་པ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "སའི་དམ་པ་ལ་གནས་པར་གྱུར་ཅིག།",
    "རྒྱལ་པོའི་མཆོག་དམ་པར་གྱུར་ཅིག་ཅེས།",
    "རྒྱལ་པོ་མྱིག་བཟངས་ཀྱིས་ཇི་ལྟར་བྱས་པ་བཞིན་དུ་བདག་དང་།",
    "འཁོར་དུ་བཅས་ནོར་ཐམས་ཅད་དང་བཅས་པར་ཡོངས་སུ་བཏང་སྟེ།",
    "རྣམ་པར་བྲལ་བས་མ་རིག་པའི་མུན་པ་དང་རབ་རིབ་དང་།",
    "ལིང་ཏོག་རྣམ་པར་བསྩལ་ཅིང་།",
    "རབ་རིབ་མྱེད་པའི་ཡེ་ཤེས་ཡང་དག་པར་མཐོང་བར་གྱུར་ཅིག།",
