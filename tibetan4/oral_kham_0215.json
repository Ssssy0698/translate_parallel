    "༡ ཨ་ར་པ་ཙ་ན་ལྷ་ལྔའི་སྒྲུབ་ཐབས།",
    "༣༧ ༡ ཨ་ར་པ་ཙ་ན་ལྷ་ལྔའི་དཀྱིལ་ཆོག་༢༦ རྗེ་བཙུན་གྲགས་པ་རྒྱལ་མཚན།",
    "འདི་དྲང་སྲོང་ཨཱགསྟྱཱའི་སྔོན་བྱུང་དང་སྦྱར་བར་འདུག་ཀྱང་།",
    "གཉིས་འཐུང་རང་བཞིན་མཛེས་པའི་གོམ་སྟབས་ལ།",
    "ཁྲེལ་རྒོད་བྱེད་པ་དང་སྦྱོར་བའི་དམིགས་རྣམ་དུ་འདུག་ཀྱང་སྦྱོར་ཁྱེར་འཛོལ་བ་ཡིན་ཏེ།",
    "མི་སྲིད་པ་འབའ་ཞིག་སྲིད་པར་ལུང་བསྟན་འདུག་པས་སོ།",
    "དེ་ཁོ་ན་ཉིད་དམིགས་པ་གར་གཏད་ཀྱི་སྟེང་དུ་སྤང་ལ་བེ་ཕུར་བཏབ་པ་ལྟར་སྒྲུབ་པའི་རྒྱལ་མཚན་འཛུགས་ཀྱིན་གདའ།",
    "སྒྱུ་རྩལ་ལ་མ་བྱང་བས་གཞན་ལུགས་ཤར་ལ་འཕངས་ཀྱང་རང་ལུགས་ནུབ་ལ་ལོག་ཐེངས་མངས་པས་བསུན།",
    "བདག་ནི་ཞེས་པས་འཁྲུལ་གཞི་བྱས་ནས་གོ་ལོག་རྒྱབ་པར་འདུག་ཀྱང་རྫོབ་རྟགས་དུམ་ཙམ་འབྲོག་པས་ལོས་སྟོན།",
    "འཇམ་དབྱངས་དགེས་པའི་བཤེས་གཉེན་གྱིས་མཁས་གྲུབ་ཡོངས་ཀྱི་འཁོར་ལོ་བསྒྱུར་བ་ཆེན་པོ་འགྱུར་མེད་བདེ་ཆེན་ཞབས་ལ་དྲིས་ལན་ཕུལ་འདུག་པར་ཡང་།",
    "དགག་སྒྲུབ་འདི་ལ་ཕན་གནོད་མི་འདུག་ཀྱང་།",
    "མི་ལས་སྐལ་ལྡན་དུ་རློམས་ནས་མ་སྒོམས་པར་ཉལ་བསྡད་པས་ལན་པར་གདའ་བ།",
    "དེ་གཉིས་ལ་གྲངས་ངེས་མེད་པར་བསྐུར་བའི་ཕྱག་ལེན་བསྙོན་མེད་མཛད་འདུག་པས།",
    "ཡང་ཕག་གྲུས་ལམ་འབྲས་ཏེ་གཞན་གྱི་གདམས་ངག་སྒོམ་བཞིན་པར་འདུག་པའི་ཕྱིར་རོ་ཞེས་པའོ།",
    "ཅེས་པ་འདི་འཇམ་དབྱངས་ཀྱི་གསུང་དུ་སྣང་ཡང་ཀླན་ཀ་དེའི་འགྲོ་དམིགས་འདི་ན་མི་གདའ།",
    "ཞེས་སོགས་གསུངས་བཞིན་དུ་འཆད་རྩོམ་གྱི་ཚེ་སྒྲ་ཇི་བཞིན་པ་ཁོ་ནར་བཀྲལ་ཙ་ན་སྐབས་འགའ་ཞིག་ཏུ་ལུང་དང་འགལ།",
    "ཞེས་པའི་ཚིག་འདིས་དེ་གཉིས་དང་རང་ལུགས་མཐུན་པར་སྨྲས་པའི་ཕྱིར་རང་ལུགས་ཇི་སྐད་སྨྲས་པ་དེར་ཟད་དོ།",
    "དེ་མན་ཆད་ལོ་མར་འདུག་པས་ལན་མི་དགོས་སོ། ཡང་རྩོད་སྤོང་དུ།",
    "གང་དུ་འགྲོ་བ་མི་ཤེས་སོ་ཞེས་པ་དེར་གདའ།",
    "རིམ་གཉིས་ཀྱི་ཏིང་ངེ་འཛིན་ལས་བྱུང་བའི་ཡེ་ཤེས་དེ་ཡང་རང་བྱུང་མ་ཡིན་ཏེ།",
    "གྲོལ་བ་མཐོང་ལམ་སྐྱེ་བ་ལ་ཁོ་རང་སྐྱེ་བའི་རྒྱུ་རྐྱེན་ནུས་པ་ཀུན་ཚང་དགོས་པའི་ཕྱིར།",
    "མཐོང་ལམ་སྐྱེ་བ་ལ་ཁོ་རང་སྐྱེ་བའི་རྒྱུ་རྐྱེན་ནུས་པ་ཀུན་ཚང་དགོས་པ་མད་ཀྱང་།",
    "ངེད་བླུན་པོའི་ཁས་ལེན་བྱེད་དོན་མི་འདུག་ཀྱང་།",
    "དམ་རྒྱ་བཞི་པར་བྱས་འདུག་པ་མངོན་སུམ་ལ་བསྙོན་པ་ནི།",
    "ཁས་བླངས་འགལ་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་མ་ཐག་འཐོལ་ལོ་བཤགས་སོ་གསུང་བར་འདུག་པ།",
    "བཀའ་མཆན་གྱི་ནུས་པ་ལ་མི་དཔྱོད་པར་ཚིགས་བོངས་ཆུང་བ་ཙམ་ལ་བརྙས་པར་འདུག་སྟེ།",
    "གདུལ་བྱའི་ངོ་བཟུང་ནས་མཆན་བུ་ཙམ་འདེབས་པ་གནང་འདུག་པ་དེ་ཀས་ཆོག་པར་ཤེས་ནས་སླར་མ་ཟློས་ལ།",
    "དངོས་བཏགས་ཀྱི་རྣམ་དབྱེ་གཅིག་ཀྱང་མ་ཕྱེད་འདུག་པའི་ཕྱིར་རོ།",
    "འོག་ཏུ་རང་ལུགས་ཀྱི་ཕྱག་ཆེན་ངོས་འཛིན་པའི་ཚེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ངོས་བཟུང་འདུག་པའི་ཕྱིར་རོ།",
    "ཞེས་གསུངས་པ་དེ་ཚིག་ཙམ་དུ་འཇོག་པ་ལ་གཉིས་ཀ་གུང་འགྲིག་གདའ།",
    "ཞེས་སོགས་སྨོས་པ་ཡང་སྔར་འཁྱུད་ལ་དར་འཁྱུད་ཆགས་ནས་བོགས་མ་ཐོན་འདུག་པས།",
    "དེ་མ་བྱུང་ཙ་ན་ཕར་མི་འཇོག་ཀ་མེད་དུ་གྱུར་པ་ལགས་སོ།",
    "ཟེར་བ་དེར་གདའོ། ཡང་རྩོད་སྤོང་དུ།",
    "ཞེས་པ་དེར་གདའོ།",
    "དེ་ལྟར་བྱས་ཙ་ན།",
    "དེ་སྐད་བྱས་ཙ་ན།",
    "དེ་ལ་ང་ལ་ནི་ཁྱད་པར་མེད་ཟེར་གྱིན་གདའོ།",
    "འོན་ཀྱང་རང་གཞན་གྱི་གཞུང་གང་ལ་ཡང་མ་འདྲིས་ཀྱང་།",
    "ཐ་དད་དེར་འཛིན་གྱི་བློ་རོ་ལྡང་བ་ཞིག་འདུག་ཀྱང་།",
    "གལ་པོ་ཆེ་ལ་ལན་གསུམ་གྱི་དཔེར་འདུག་པ་དང་།",
    "དགའ་བར་བྱེད་པའི་རོ་ནི་ནང་ན་འདུག།",
    "འདོད་ཆགས་སོགས་ཟད་ཅེས་པའང་རང་བཞིན་མེད་པར་ཤེས་པ་ལ་ཟད་པར་མིང་འདོགས་ན་ནི་འགལ་བ་མེད་ལ།",
    "སེར་པོར་བཏགས་པའི་དུང་དེ་སེར་པོར་སྣང་ཡང་ཁོ་རང་དཀར་པོ་ཡིན་པ་བཞིན།",
    "དེ་ལྟར་མ་ཡིན་པའི་ཕྱིར་དེའི་ཚེ་ཡང་རྣམ་རྟོག་ཁོ་རང་འཁྲུལ་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "མིག་མ་བསླད་པས་དུང་སེར་པོར་མ་མཐོང་དཀར་པོ་ཁོ་རང་མཐོང་བ་བཞིན།",
    "རྣམ་རྟོག་འཁྲུལ་པར་མ་མཐོང་རྣམ་རྟོག་ཁོ་རང་མཐོང་ཞེས་སྦྱར་དགོས་པ་ལས།",
    "དོན་གཉིས་སྣང་མ་སྤངས་པས་ལན་ཞེས་ལུང་བསྟན་པ་དེ་རང་དུ་འདུག་པས།",
    "དེ་མན་གྱི་བརྡའ་དང་མིང་དང་ཐ་སྙད་ཐམས་ཅད་བཏགས་པ་བར་མཛད་ཀྱི་འདུག་པ།",
    "འདི་ལྟ་བུའི་དངོས་བཏགས་འབྱེད་ཁྱེར་ལ་འགྲེས་རྐང་དེད་ན་བཞད་གད་ཆང་གྲལ་ལས་ཀྱང་ཆེ་བ་འོང་བ་གདའོ། ཡང་གན་མཛོད་ལས།",
    "བུ་གླེན་པ་ཅིག་ཡོད་ཅེས་ཟེར་མཁན་འདུག་ན་ཟེར་མཁན་དེ་རང་གླེན་པ་སྟེ།",
    "དཀར་པོ་ཆིག་ཐུབ་ཅེས་བྱ་བ་དེ་ཅི་མེད་ཅང་མེད་ཀྱི་སྟོང་རྐྱང་ཅིག་ལ་ཟེར་འོང་དགོངས་ནས་རིགས་པའི་ང་རོ་སྒྲོག་པར་འདུག་ཀྱང་།",
    "ཞེས་ལྷན་ཆུང་ཟུར་གསུམ་གཅིག་བཏབ་འདུག་པ་དེ་ཡང་འཕྲད་ལྷན་དུ་སྣང་བས་མི་མཛེས་ཏེ།",
    "རབ་དབྱེའི་བསྟན་དོན་ཐམས་ཅད་སྒྲ་ཇི་བཞིན་པར་འཆད་པས་དབུ་འཐོམས་འདུག་པའི་ཕྱིར་རོ།",
    "ཁྱེད་ཀྱི་ཚིག་ལས་སེམས་ཞེས་པ་ཙམ་དང་སེམས་ཉིད་ཅེས་པ་སྐྱིད་སྡུག་གཅིག་ཏུ་བཏང་འདུག་པ།",
    "ཞེས་སོགས་ཀྱང་རང་ལ་ཁས་བླངས་ནང་འགལ་བ་བསྟན་པར་སྣང་སྟེ།",
    "ཅེས་སོགས་དུས་འཁོར་གྱི་ལུང་འདི་ཡང་བརྗོད་དོན་གོང་བཞིན་ཡིན་ཀྱང་སྤྱན་རྣམ་ཅུང་ཞིག་མ་བཀྲབ་པ་ཡིན་ནམ་བརྗོད་མེད་དུ་བཞག་འདུག་གོ། གན་མཛོད་ལས།",
    "གལ་ཏེ་ཁོ་རང་གཅིག་པུ་ལས་འབྲས་བུ་དུ་མ་བསྐྱེད་པའི་དོན་དུ་འཆད་དོ་སྙམ་ན།",
    "སྟོང་རྐྱང་ལ་ཆིག་ཐུབ་ཟེར་མཁན་འདུག་ན།",
    "གཏམ་ཙམ་གྱིས་ཀྱང་བསྟན་པ་ལ་གནོད་པའི་དགག་བྱ་འདུག་ཕྱིར་ཚར་གཅོད་དགོས་ལ།",
    "ཞེས་ཤིན་ཏུ་འཇིགས་པའི་མཚོན་ཆར་སྣང་བས་འཛེམ་པར་འདུག་སྔར་སྨྲས་པ་བཞིན།",
    "ཞེས་པ་ལྟར་ཁྱེད་རང་ལ་ངན་ནོ།",
    "ཁོ་རང་བསྔོ་བའི་གོ་ཆོད་པའི་ཆིག་ཐུབ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཁོ་རང་བཏུང་བ་གོ་ཆོད་ཡིན་པའི་ཕྱིར་རོ།",
    "གསུང་བ་ནི་གདའོ། ཡང་རྩོད་སྤོང་དུ།",
