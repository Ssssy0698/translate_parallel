    "ལྷག་པར་དུ་རང་ཉིད་འཚོ་གནས་བྱ་ཡུལ་ལེགས་པར་ཤེས།",
    "རྩིས་འཁོར་གྱིས་དགག་བྱ་མེད་པར་སྲི་ཞུ་བསྒྲུབ།",
    "སྐབས་གཞན་དུ་ཁ་བརྡ་ལེགས་པར་བྱེད་པའི་གྲོགས་སུ་འགྱུར།",
    "རྩིས་འཁོར་གྱིས་བཟོ་གྲྭའི་ལྷུ་སྒྲིག་ཁང་དུ་མི་ལས་ལྷག་པར་བསྐྱར་ཟློས་ཡང་ཟློས་ཀྱིས་བསྒྲུབ་དགོས་པའི་ལས་ཀ་རྣམས་བསྒྲུབ་ཐུབ།",
    "ཁོ་ཚོའི་འཕྲུལ་ཆས་ཁག་ལ་དྲན་འཛིན་ཧ་ཅང་ཆེན་པོ་དང་ཤེས་ཚོར་རྫུན་མའི་ཡོ་བྱད་མཆིས་སོ་ཅོག་མཉམ་དུ་འགྲུབ་པར་འགྱུར།",
    "ཁོ་ཚོས་གང་ཐུབ་ཀྱིས་རྩིས་འཁོར་ལ་ཐམས་ཅད་བསླབས་ནས་དྲི་བ་ཁག་ལ་ལན་རྣམས་དྲང་པོ་དང་བདེན་པར་སྨྲོས།",
    "དུས་རབས་ཉི་ཤུ་པའི་མགོ་སྟོད་དུ་རྡུལ་ཕྲན་འགྲེལ་ཐུབ་པར་གྱུར།",
    "དེང་སྐབས་གཅིག་བྱས་ན་དངོས་ཁམས་རིག་པ་བ་ཚོས་ཀྱང་རྣམ་གཞག་གཅིག་གྱུར་གྱི་གཞུང་ལུགས་ཤིག་འཚོལ་པར་བེམ་རྫས་ཀྱི་དོན་དངོས་ལ་ལོག་འགྲེལ་བྱེད་ཀྱི་ཡོད་སྲིད།",
    "ཡང་ན་སེལ་པར་འགྱུར་སྲིད།",
    "གཅིག་བྱས་ན་ཚན་རིག་པ་ཚོས་བྱིས་པའི་བདེན་རློམ་གྱི་འཇིག་རྟེན་རྒྱབ་ཏུ་བསྐྱུར་ཟིན་པའི་རྟགས་སུ་མངོན་ནོ།",
    "བསམ་བློ་དེ་དག་ལ་ལེགས་བཅོས་བྱས་ནས་དུས་འདའ།",
    "ཕྱོགས་གཅིག་ནས་བལྟས་ན་བསམ་བློ་རིག་པས་ཤེས་བྱ་གསར་པ་མི་སྤེལ་པར་ཤེས་བྱ་ཡོད་པ་རྣམས་གསར་དུ་སྟོན།",
    "ཤེས་བྱ་དེ་དག་མིའི་བསམ་བློ་དང་ལྟ་བའི་སྦུགས་སུ་ཐིམ་ནས་རྙིང་པར་གྱུར་ནས་གོ་གཅོད་མེད།",
    "གུན་ཁལ་གྱིས་བསམ་བློ་རིག་པ་མེད་ན་ཤེས་བྱ་དེ་དག་ནམ་ཡང་མི་རྙེད་པར་བཞེད།",
    "ཡིན་ནའང་ཁོ་ཚོས་གཟབ་ནན་གྱི་སྒོ་ནས་ལེ་དབར་གྲུ་བཞི་མ་འགའ་ཞིག་ལ་མ་གཏོགས་སྐོར་ཞིབ་བྱས་མེད།",
    "འགྲུལ་ཆས་དང་པོ་ནི་༡༩༧༧་ལོའི་སྤྱི་ཟླ་དགུ་པར་མཁའ་དབྱིངས་སུ་བཏང་སྟེ་༡༩༧༩་ལོའི་སྤྱི་ཟླ་བདུན་པར་གཟའ་སྐར་ཕུར་བུའི་ཉེ་འཁྲིས་སུ་འཕུར།",
    "༡༩༨༡་ལོའི་སྤྱི་ཟླ་བརྒྱད་པར་གཟའ་སྐར་སྤེན་པ་བརྒལ་ནས་བསྐྱོད།",
    "འགྲུལ་ཆས་གཉིས་པ་༡༩༧༩་ལོའི་སྤྱི་ཟླ་བདུན་པར་གཟའ་སྐར་ཕུར་བུའི་འཁྲིས་དང་།",
    "༡༩༨༡་ལོའི་ཕྱི་ཟླ་བརྒྱད་པར་གཟའ་སྐར་སྤེན་པའི་འཁྲིས་སུ་འཕུར།",
    "གཅིག་བྱས་ན་ལས་དོན་ཨང་དང་པོ་ནི་ཟླ་བའི་སྟེང་ངམ།",
    "གཅིག་བྱས་ན་གཟའ་སྐར་མིག་དམར་སྟེང་དུ་གཞིས་ཆགས་སྲིད།",
    "ལྷག་པར་དུ་ཉི་མའི་ཁྱིམ་རྒྱུད་ཀྱི་གཟའ་སྐར་ཁག་ལ་ཡོད།",
    "དེ་དུས་མི་ཚོས་ནམ་ཡང་ཕྱིར་ལྟས་མི་བྱེད་པར་མིག་ཟུང་མདུན་དུ་གཏད།",
    "རབ་བྱུང་ན་དེ་ལ་གཅེས་པར་འཚལ་ལོ།",
    "གཅིག་བྱས་ན་དེ་ཚོ་ཡ་མཚན་དགོས་པ་ཞིག་མིན།",
    "སའི་གོ་ལ་ཚུད་པའི་གཟའ་སྐར་ཐམས་ཅད་ལ་བརྟག་ཞིབ་བྱས་པ་དང་།",
    "གཅིག་བྱས་ན་བརྡ་འཕྲིན་དེ་གཟའ་སྐར་མིག་དམར་གྱི་སྟེང་དུ་བཞག་ཡོད་སྲིད།",
    "གཅིག་བྱས་ན་མ་འོངས་པའི་ལོ་ལྔ་བཅུའམ།",
    "བསམ་བློ་དེ་ཉེན་ཚབས་ཅན་ཞིག་ཡིན་པར་སེམས།",
    "གྲངས་འབོར་དེ་རྣམས་མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ཀྱི་འབྲུ་རིགས་དང་ཞིང་ལས་སྒྲིག་འཛུགས་ཀྱིས་དཔར་དུ་བསྐྲུན་པའི་བསྡོམས་འབོར་ལ་གཞི་རྩ་བཅོལ།",
    "དེས་ན་འགྲོ་བ་མིའི་གྲངས་འབོར་ཅི་ཙམ་འཕེལ་ཡང་ཁྱད་པར་ཆེན་པོ་ཞིག་མི་གཏོད་པར་སྣང་།",
    "གཅིག་བྱས་ན་ཐེར་འབུམ་ཆེན་པོ་གཅིག་གམ།",
    "ཁོ་བོའི་སེམས་པར་འགྲོ་བ་མིས་རང་ལ་སྒྱུར་བཅོས་གཏོང་རྒྱུའི་ཡིད་ཆེས་ཡོད།",
    "ཁོ་ཚོའི་དགོས་འདུན་བསྐང་བར་ངེས་པར་དུ་གྲལ་ཐོབ་ཅིག་སྟེར་དགོས།",
    "མ་མཐའ་ཡང་ཁོ་ཚོའི་སྲེད་ཞེན་ལ་ཅི་ནས་ཀྱང་ངོས་འཛིན་བྱས་ནས་གང་ཐུབ་ཀྱིས་བསྐང་དགོས།",
    "དུས་རབས་མང་པོའི་ཡར་སྔོན་དུ་ཕེ་ལེ་ཊོས་སའི་གོ་ལ་ནི་སྲོག་ལྡན་སྐྱེ་དངོས་ཤིག་ཡིན་པར་བཞེད།",
    "ད་ལྟ་འཛམ་གླིང་ཡོངས་སུ་ཚོད་དཔག་དེ་བདེན་པར་སྒྲུབ་པ་དང་བདེན་པ་མིན་པར་སྒྲུབ་པའི་རྩོལ་སྒྲུབ་ལ་ཞུགས།",
    "གཅིག་བྱས་ན་སྟབས་ལེགས་སམ།",
    "འདི་ནི་འགྲོ་བ་མིས་ཁྱིའི་རིགས་རྫས་འདུ་ཕུང་ལ་ཐེ་ཇུས་བྱས་པའི་མཇུག་འབྲས་ཡིན།",
    "འབྲུ་རིགས་འདི་དག་གཟབ་ནན་གྱིས་འདེབས་ལས་མ་བྱས་པར་མི་སྐྱེ།",
    "དེས་ན་སྐབས་འགར་ཐོན་སྐྱེད་འདོན་སྤེལ་པར་ཁེ་ཕན་ཡོད་པ་ལས་ཐོན་སྐྱེད་ལོངས་སུ་སྤྱོད་མཁན་ཚོར་ཁེ་ཕན་མེད།",
    "གཡོ་ཐབས་ལ་བརྟེན་ནས་རང་ཉིད་ཐག་གཅོད་པར་གདམས་རྒྱུ་ཡིན་ནམ།",
    "ཁོ་བོས་ལས་གཞི་དེ་༢༢༥་ཡས་མས་སུ་འགྲུབ་པར་སེམས།",
    "ཁོ་བོས་མི་དེ་ཚོར་གྲུབ་འབྲས་འཐོན་རྒྱུ་ཡིན་པར་སེམས།",
    "ཐག་གཅོད་བྱས་པ་རྣམས་ནུས་ལྡན་ཞིག་ཏུ་བསྒྱུར་པའི་སྟོབས་ཤུགས་ཡོད་དམ།",
    "ཁོ་བོས་བལྟས་ན་འདས་པའི་དུས་རབས་ཕྱེད་ཀའི་རིང་དུ་གཅིག་སྡུད་རིང་ལུགས་ནི་མཐའ་གཅིག་དང་གཏན་ནས་ཡིད་རྟོན་མི་རུང་བ་ཞིག་ལ་བསྒྱུར་ཟིན་པར་སེམས།",
    "གཅིག་བྱས་ན་འབྱུང་།",
    "གཅིག་བྱས་ན་མི་འབྱུང་།",
    "དེ་ནས་ལེ་དབར་བཅུ་གཉིས་ལ་ཕྱིར་ལོག་བྱས་པ་བྱུང་མེད་པ་ཞིག་མིན།",
    "དེ་ནས་ཚུར་ལམ་རང་ཁྱིམ་དུ་ལོག་པར་ལེ་དབར་དྲུག་ཅུར་བསྐྱོད་རྒྱུ་ཅང་ལའང་མི་བརྩི།",
    "མེ་འཁོར་གྱིས་མི་ལ་ཁྱད་པར་མི་འབྱེད།",
    "ཡིན་ནའང་ཐམས་ཅད་གོ་སྒྲིག་ཚུལ་བཞིན་བྱེད་ན་ཞོགས་པར་བདེ་བླག་ཏུ་ལེ་དབར་སུམ་བརྒྱ་ལྷག་ཕར་འཕུར།",
    "འོན་ཀྱང་ས་ཆོད་ཀྱི་རྒྱང་ཁད་ད་ལྟའི་ཚོད་དཔག་ལས་ཀྱང་རིང་བ་ཆོད་སྲིད་པར་གོར་མ་ཆག་སྒྲ་སྐད་ལས་ཀྱང་ལྡབ་གསུམ་ནས་ལྡབ་བཞི་ཙམ་མགྱོགས་པའི་གནམ་གྲུའི་ནང་དུ་འཕུར་ན་ཆུ་ཚོད་བཅུ་ནས་བཅུ་གཉིས་ཀྱི་ནང་དུ་སའི་གོ་ལར་སྐོར་བ་ཞིག་རྒྱག་ཐུབ།",
    "འགྲོ་བ་མིའི་རང་གཤིས་ལ་མྱུར་ཚད་ཀྱི་ངལ་ཚེགས་འཐོལ་པ་བཙན་འགེལ་བྱ་ངེས་ཡིན་པར་བཟོད་གླགས་ཐུབ་བམ།",
    "ཁོ་བོས་བཟོད་གླགས་མི་ཐུབ་པར་སེམས།",
    "ལོབ་བྱ་དེ་ཉིད་རྫས་སྦྱོར་ལ་གཞི་རྩའི་འབྲེལ་བ་ཡོད་མེད་ལ་མ་ལྟོས་པར་གོམས་གཤིས་སུ་གྱུར་པའི་རིགས་རྣམས་གཅོད་དཀའ།",
    "གཅིག་བྱས་ན་ས་ཡ་དུ་མ་ཡོད།",
    "གནའ་རབས་སྐྱེ་དངོས་རིག་པ་བ་ཚོས་སྤྱི་ལོའི་སྔོན་གྱི་ལོ་༣༥་ཡས་མས་ཀྱི་ཡར་སྔོན་དུ་མི་ཚོས་ད་ལྟའི་ཡར་ཐོན་མི་རྒོད་ལྟར་ཕན་ཚུན་རྒོལ་འཛིང་བྱས་ཡོད་སྲིད་ཅིང་།",
    "འདི་ལ་གཞིགས་ན་འགྲོ་བ་མི་རྣམས་ཇི་ལྟར་བྱས་ཀྱང་ལོ་སྟོང་ཕྲག་བདུན་གྱི་རིང་དུ་དམག་འཁྲུག་ལ་ངན་ལང་ཤོར་པར་འགྱུར་བ་མེད་དོ།",
    "གཅིག་བྱས་ན་དམག་འཁྲུག་རྣམས་དབྱེ་ཚན་གཙོ་བོ་གསུམ་དུ་འདུ།",
    "མ་མཐའ་ཡང་ད་ལྟ་བར་དུ་གཏམ་འདི་བདེན་པར་གྲུབ།",
    "ཁོ་པར་ཅི་ཞིག་འཐོབ་འདོད་ཡོད་པ་རྣམས་དམག་འཁྲུག་བསླངས་ནས་འཐོབ་ཐུབ་པ་བློ་ཡུལ་དུ་ཤོང་དཀའ།",
    "གོང་མ་རང་ཉིད་དང་འཇར་མན་ཎི་གཉིས་ཀས་དམག་འཁྲུག་མ་བརྒྱབ་པར་སྟོབས་དང་འབྱོར་པ།",
    "དམག་འཁྲུག་དེར་རྩིས་འཁོར་ཡང་བཀོལ་པར་འགྱུར།",
    "རྩིས་འཁོར་གྱིས་རང་སྟོབས་སུ་བསམ་བློ་གཏོང་བ་དང་ལས་འགན་ཁུར་ཐུབ་པའི་བྱ་བ་མང་དག་ཅིག་བསྒྲུབ་པར་འགྱུར།",
    "ཡུན་རིང་མི་འགོར་པར་རྩིས་འཁོར་གྱིས་རང་ལ་བཀའ་ཕབ་ཡོད་པ་ཇི་ལྟར་བསྒྲུབ་དགོས་པའི་ཐབས་ཤིག་རྙེད་སྲིད།",
    "དེ་ལས་ལྡོག་སྟེ་མཐུན་ཚོགས་དེས་འགྲོ་བ་མིས་ཕན་ཚུན་ཉེན་ཚབས་ཆེ་བའི་དགྲ་ཟླར་བཟུང་སྟེ་རང་ཉིད་ཕུང་ལ་སྦྱོར་རྒྱུ་ཡིན་པ་འགོག་མཐུན་ཚོགས་དེས་རང་དང་མིའི་བདེ་རྩ་ཁོ་ནའི་ཆེད་དུ་རྩིས་འཁོར་གྱིས་མི་ལ་བདག་སྐྱོང་བྱ་དགོས་པ་ངོས་ཟིན་པར་འགྱུར།",
    "མིའི་རྣམ་པར་རོལ་པའི་འཕྲུལ་འཁོར་ཡང་བཟོ་སྲིད།",
    "དེར་བརྟེན་འགྲོ་བ་མི་ཇི་སྙེད་ཅིག་ལ་འཕྲུལ་འཁོར་མིའི་རྣམ་པར་རོལ་པ་འགལ་རྐྱེན་ཞིག་ཏུ་སྣང་རྒྱུ་ཡིན་པས།",
    "འགྲོ་བ་མིས་རྟག་ཏུ་མཉམ་འབྲེལ་གང་ལེགས་བྱས་ཡོད་པའང་ཤེས།",
    "དེ་ལ་གྲུབ་འབྲས་ཀྱང་འཐོན་པར་ངེས་སོ།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་དབུ་བཞུགས་དང་འབྲེལ།",
    "ནང་བསྟན་ཁྱབ་གསལ་རྒྱ་ཆེར་སྤེལ་བའི་ཐབས་ཚུལ་གནང་ཕྱོགས་གང་དགེའི་སྐོར།",
    "པར་གཞི་སྔར་བཞིན་རྒྱ་བསྐྱེད་གང་ཐུབ་བྱ་རྒྱུ།",
    "དཔེ་རྒྱུན་ཤིན་ཏུ་དཀོན་པའི་རིགས་རྩོམ་བསྒྱུར་ཁང་ནས་བླུ་བཞེས་གནང་རྒྱུ།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་དབུ་བཞུགས་དང་འབྲེལ།",
    "༡༥་དིལ་འགོ་མཁྱེན་སྤྲུལ།",
    "དགེ་སློང་སྡོམ་གཙང་ཞལ་གྲངས་ཉི་ཤུ་ཡན་བཞུགས་ཤིང་།",
    "དགེ་སློང་སྡོམ་གཙང་བརྒྱད་གྲྭ་བཞུགས་ཤིང་།",
    "དགེ་སློང་སྡོམ་གཙང་ལྔ་ཚང་ཞིང་།",
    "སྨྱུང་གནས་ཆ་བརྒྱད་སོགས་ཀྱི་ཕྱག་བཞེས་ཚད་ལྡན་ཡོད་པ་རྣམས་ཡིན།",
    "རང་གཞུང་ནས་ད་ཕན་ཐབས་ཤེས་ཡོད་རྒུ་རྩལ་སྒྲུབ་སྔ་ཕྱིར་གནང་ཡོད་ནའང་གྲུབ་འབྲས་ངོ་སོ་འཐོན་པ་ཞིག་བྱུང་མེད་སྟབས།",
    "ཀ་བཀའ་བརྒྱུད་ཁོངས་ནས་ཕེབས་མཁན།",
    "ག་བོན་པོ་ཁོངས་ནས་ཕེབས་མཁན།",
    "ང་རྙིང་མའི་ཁོངས་ནས་ཕེབས་མཁན།",
    "ཅ་ས་སྐྱའི་ཁོངས་ནས་ཕེབས་མཁན།",
    "དེ་ཡང་སྔོན་གྱི་སྐྱེས་ཆེན་དམ་པ་མཁྱེན་ཀོང་མཆོག་གསུམ་སོགས་དང་།",
    "སློབ་འཁྲིད་གནང་མཁན་རྣམས་ནས་ཀྱང་དེ་ལྟར་ཉམས་བཞེས་དང་འབྲེལ།",
    "བཀའ་སློབ་གནང་ན་དགེ་མཚན་ཆེ་བ་ཡོང་རྒྱུ།",
    "མི་མང་ནས་ཀྱང་དོ་སྣང་སྤྲོད་དགོས་རྒྱུའི་འབད་བརྩོན་གནང་དགོས།",
    "ཞེས་ཕེབས་ཡོད་པས་དེ་སྐོར་འབྲེལ་ཡོད་རྣམ་པས་ཐུགས་སྣང་ཇི་བྱུང་དང་།",
    "མ་འོངས་བཅས་པར་མགོ་ལུས་ལྟར་བྲལ་དུ་མེད་པ་ཞིག་ཡིན།",
    "ཡུལ་པ་དང་ནང་པ་གསར་པ་སོགས་ལ་འབྲེལ་བ་གནང་རྒྱུ་དེ་ལ་ཐུགས་གཟབ་མ་གནང་ན་འགན་མ་བཟོད་པ་ལྟ་བུའི་གནས་ཚུལ་མང་པོ་འབྱུང་ཉེན་ཡོད་པ་དེ་ཡང་མཁྱེན་རྟོགས་གལ།",
    "འཛམ་གླིང་ནང་ཞི་བདེ་འབྱུང་ཐབས་ཀྱི་ཞབས་འདེགས་ཀྱང་རླབས་ཆེན་ཞིག་ཡོང་རྒྱུ་ཡིན་ན་དེ་ལ་གནང་ཕྱོགས་ཇི་དགེའི་སྐོར།",
    "སེམས་ཀྱི་སྐོར་བཅས་པའི་ཐོག་བགྲོ་གླེང་གནང་ཐབས་གནང་ན་དགེ་མཚན་ཆེ་བར་མངོན།",
    "གཞི་ཐམས་ཅད་ཡོད་པར་སྨྲ་བའི་ལུགས་ཀྱི་དགེ་སློང་མའི་སྡོམ་རྒྱུན་ནི་ཆད་དེ་སླར་གསོ་ཐུབ་ཐབས་མེད་པ་དང་།",
    "བཙུན་མ་ཚོས་དེ་ལྟའི་དགེ་གཤེས་ལྷ་རམས་པའི་མཚན་བཞེས་ཐུབ་པ་ཞིག་ཁག་པོ་ཡིན།",
    "བོད་ནས་གྲྭ་རྒྱུན་གསར་ཞུགས་ཡོང་མཁན་རྣམས་ལ་དཀའ་ངལ་མི་འཕྲད་ཆེད་རང་གཞུང་ནས་སྐྱབས་བཅོལ་ལག་ཁྱེར་ཐོབ་ཐབས་རོགས་མགོན་གནང་གལ་ཆེ་བ་དང་།",
    "དཔལ་༧རྒྱལ་བ་ཀརྨ་ཨོ་རྒྱན་འགྲོ་འདུལ་འཕྲིན་ལས་རྡོ་རྗེ་མཆོག་རྒྱ་དམར་གྱི་བཙན་འོག་ནས་བྲོས་བྱོལ་གྱིས་ཕྱི་ལོ་༢ ཟླ་༡ ཚེས་༥ ཉིན་འཕགས་ཡུལ་བཞུགས་སྒར་དྷ་རམ་ས་ལར་སྐུ་བདེའི་ངང་ཞབས་སོར་འཁོད་ཐུབ་པ་བྱུང་ཞིང་།",
    "སྔགས་སོགས་ལ་ཞུགས་འདོད་པ་རྣམས་ལ་རྒྱུད་དོན་བཞིན་འཆད་གནང་རྒྱུ།",
    "གཞན་ཡང་གྲོས་གཞིར་མ་འཁོད་པ་སྐབས་མཚམས་དགོངས་འཆར་བྱུང་ཁག་ཚོགས་གཙོའི་བཀའ་འཁྲོལ་དང་བསྟུན་བཀའ་བསྡུར་ཐག་གཅོད་གནང་འོས་གནང་རྒྱུ།",
    "ས་གནས་འགོ་འཛིན་ཁག་ནས་མཇུག་སྣོན་རྒྱུན་བསྲིང་གནང་རྒྱུ།",
    "བཙན་བྱོལ་བོད་གཞུང་བཀའ་ཤག་ལ་འབོད་བསྐུལ་ཞུ་རྒྱུ།",
    "ཕྱག་བསྟར་གནང་ཕྱོགས་དམ་དོན་ཡོང་ཐབས་སྐོར་བཀའ་བསྡུར་གནང་རྒྱུ།",
    "མཚན་གནས་འབུལ་ཕྱོགས་ཀྱི་བརྒྱུད་རིམ་དང་ལམ་ལུགས་ཞིབ་ཕྲ་གསར་གཏོད་དགོས་པར་བརྟེན།",
