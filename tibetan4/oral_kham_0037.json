    "ནམ་རྒྱུན་སྲད་རྒྱུད་ཀྱི་ཚོགས་འདོན་དུ་གསང་འདུས་ལེའུ་བཅུ་བདུན་པོ་ཆ་ཚང་བློ་འཛིན་བྱེད་ཀྱི་ཡོད་པས་རྒྱུད་ཀྱི་འཆད་ཉན་ཆ་ཚང་འདུག་དབུས་ཀྱི་རྒྱུད་པར་ལེའུ་བཅུ་གཉིས་ཡན་ཆད་མ་གཏོགས་བློ་འཛིན་བྱེད་ཀྱི་མེད།",
    "ཕལ་ཆེར་ས་སྐྱའི་ཕྱོགས་ལ་ཡང་དཀོན་པོ་འདུག་ལ།",
    "བཀའ་བརྒྱུད་ཀྱི་ཕྱོགས་ལ་ཡང་དཀོན་པོ་འདུག་དེ་ལྟར་སྲད་དབེན་གཞུང་གསུམ་དང་།",
    "རྡོ་རྗེ་མཆེད་གསུམ་ཞེས་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་བྱུང་འདུག་གྲུབ་མཆོག་དྷརྨ་བཛྲ་ནི་རི་དྭགས་རྨས་མ་བཞིན་བྱ་བྲལ་བྱས་ནས་བཞུགས་ཡོད།",
    "རྒྱལ་བ་དབེན་ས་པའི་གསུང་ངམ་དབེན་ས་བཀའ་འབུམ་གྱི་ནང་ལ་ཚིགས་བཅད་གཅིག་འདུག་པ་ངས་བཤས་ཡོད།",
    "དེ་ལྟ་བུའི་རང་བཞིན་བརྗོད་པ་ཞིག་གསུངས་འདུག་པ་ལྟར་བསམ་གྱིས་མི་ཁྱབ་ཅིང་།",
    "རྒྱུད་པ་ཁག་གཉིས་འདུག་སྟེ།",
    "ཞེས་གསུངས་འདུག་པ་ལྟར།",
    "སྐྱེས་ཙམ་ཉིད་ནས་དང་རང་སྟོབས་ཀྱིས་མི་ཡོང་བས་བསླབས་ནས་ཤེས་དགོས།",
    "བཟོ་ལྟ་ཅང་མི་འདུག་ཅེས་སོགས་ལབ་ཀྱང་ཁྱད་མེད།",
    "འཕྲལ་དུ་དགོས་པ་ཅི་ཞིག་འདུག་ཕུགས་ལ་ཕན་ཐོགས་ཅི་ཞིག་འདུག་སོགས་བསམ་བློ་བཏང་བ་ན།",
    "བློ་ཕྱོགས་སུ་ལྷུང་ན་རང་དང་རང་ཕྱོགས་ཀྱི་སྐྱོན་ཡང་ཡོན་ཏན་དུ་མཐོང་ཞིང་།",
    "འགལ་འདུ་ཡོད་པ་ཅི་ཞིག་འདུག་སོགས་ཀྱི་དོན་ལ་བསམ་བློ་བཏང་བ་ན།",
    "དེ་སྒྲ་ཇི་བཞིན་པར་ཁས་བླང་ན་རིགས་པས་གནོད་པ་ཅི་ཞིག་འདུག་འགལ་བ་ཅི་ཞིག་འདུག་སོགས་ཤེས་ཐུབ་པ་དང་།",
    "དོན་མ་གྲུབ་ལག་ནས་འཆོར་ཉེན་གདའ།",
    "འདིའི་རིགས་མགོ་རྙོག་ཅུང་ཆེ་བར་འདུག་པས་བསམ་བློ་ཧ་ཅང་ཞིབ་ཚགས་གཏོང་དགོས།",
    "རྒྱུད་འདུལ་དགོས་ཀྱི་འདུག་སྙམ་པའི་བསམ་བློ་གཏོང་དགོས།",
    "ཡི་དམ་ངོ་བོ་དབྱེར་མེད་དང་རང་བཞིན་གཅིག་ཆགས་ཡོད།",
    "མི་འདུག་ལབ་ཀྱང་ཅུང་ཁ་ཐབས་དྲག་གྲས་ཡིན་ཏེ།",
    "སྟན་བདེ་བ་ལ་ལུས་འདུག་ལུགས་བརྒྱད་དང་སྤྱོད་ལམ་གང་བདེར་འཁོད་ནས།",
    "ཚོགས་ཞིང་རང་གནས་སུ་གཤེགས་པའི་དམིགས་པ་བྱེད་པ་སོགས་ཡོད་པ་ལས།",
    "གཞི་ནས་གཉུག་མའི་ཉམས་མྱོང་འགོ་ཚུགས་པ་ལྟ་བུ་ཡོང་འདུག་པས།",
    "དེ་ལས་གཤིན་རྗེ་དེ་སྐྱབས་སུ་མཆི་བསམ་པ་བྱས་ན་ཡག་ཡག་འདུག་མར་གཤིན་རྗེའི་ཁ་ལ་ཞུ་རྒྱུ་ཅང་མེད།",
    "སོ་སྐྱེ་ལས་དང་པོ་བ་ཞིག་ཆགས་འདུག་ཀྱང་།",
    "ནམ་རྒྱུན་རྫོགས་པ་ཆེན་པོའི་ཀུན་ཏུ་བཟང་པོ་ཞེས་པ་སྐུ་རྒྱན་ཆ་མེད་པ་ཞིག་འདུག་རྒྱན་གོས་མེད་པས་རྗེན་པར་རིག་པའམ་མཐོང་བའི་གནས་ཚུལ་མཚོན་པར་བརྟེན།",
    "གང་ཟག་དེ་ཅི་འདྲ་ཞིག་འདུག་ཕུང་པོ་ལྔ་དང་ངོ་བོ་ཉིད་ཀྱིས་གཅིག་ཏུ་གྲུབ་བམ།",
    "ཞེས་བཏོན་ན་ཡང་ཡག་པོ་འདུགརབ་དཀར་དགེ་སེམས་ཆེན་པོའི་ངང་ཉིད་ནས།",
    "མཉམ་པར་བཞག་པའི་བཞག་དུས་ལ་ང་རྒྱལ་ཡོད་གསུངས་པ་བཞིན་དབྱེ་འབྱེད་གཏོང་རྒྱུ་ཡོད།",
    "འདི་ལྟར་བྱས་ན་ཡང་འདུམ་བདེ་བོ་འདུག་ཡང་དེ་ནས་ཉམས་བསྡུས་ཙམ་བྱེད་ན།",
    "དགའ་མཁན་དང་སྐྱོ་མཁན་གྱི་བདག་ཅེས་པ་ཅི་འདྲར་འདུག་པ་དང་།",
    "མཐར་གཏུགས་ནས་ཡོང་ན་ང་ཡིད་ཆེས་ཀྱི་མི་འདུག་ཟེར་བ་ཙམ་ལས་མེད་པས།",
    "ཞེས་པའི་སྡོམ་ཞིག་ཀྱང་འདུག་པའི་ནང་གསལ་ལྟར་མཚན་ལམ་ཧ་ཅང་མང་པོ་ཞིག་ཡོད་པ་ལས་མཚན་ལམ་གཅིག་འདི་ཡིན།",
    "ཨ་ར་པ་ཙ་ན།",
    "དགའ་ལྷང་ལྷང་ཡོད་པའི་བདེ་ཉམས་ཤིག་བཏོན་པའི་ཐོག་ནས་བདག་ཅེས་པ་གང་དུ་འདུག་བསམ་བློ་གཏོང་དགོས་པར་མ་ཟད།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཡོན་ཏན་བརྗོད་སྐབས་གཙོ་བོ་བརྩེ་བའི་ཡོན་ཏན་དང་མཁྱེན་པའི་ཡོན་ཏན་གཉིས་ཀྱི་ཐོག་ནས་བསྟོད་བསྔགས་མཛད་འདུག་ཅིང་།",
    "འདོན་པ་མང་ཆེ་བ་ཡང་བོད་སྐད་ནང་འདོན་གྱི་འདུག་པས།",
    "ང་རང་ཡང་ཧ་ཅང་དགའ་བོ་བྱུང་།",
    "དེ་ནས་སྟན་བདེ་བ་ལ་ལུས་འདུག་ལུགས་བརྒྱད་དམ་སྤྱོད་ལམ་གང་བདེར་འཁོད་ནས་ཞེས་པའི་ལུས་འདུག་ལུགས་བརྒྱད།",
    "དེ་འདྲའི་ལུས་འདུག་ལུགས་བརྒྱད་དམ་སྤྱོད་ལམ་གང་བདེར་འཁོད་ནས།",
    "ད་ལྟ་ཤི་བ་ཡིན་ན་མི་ཚེ་འདིར་ཕྱི་མ་ལ་ཕན་ཐོགས་ངེས་ཤིང་གདེང་ཁེལ་བ་ཅི་ཞིག་བྱས་འདུག་བལྟས་ན།",
    "སྡོམ་པ་བླངས་པ་སོགས་བྱས་ཡོད་ཀྱང་རང་བློ་རང་ལ་ལྐོག་ཏུ་མ་གྱུར་པ་ཡིན་པས།",
    "ད་ལྟ་ཤི་ན་གདེང་འཁེལ་བ་ཅི་ཞིག་བྱས་འདུག་བསམ་བློ་བཏང་ན།",
    "ད་ལྟ་ཤི་ན་ཇི་ལྟར་བྱེད་བསམ་བློ་བཏང་ན་གདེང་འཁེལ་རྒྱུ་ཧ་ཅང་ཁག་པོ་འདུག་དེར་བརྟེན་སྤྱིར་འཆི་བར་ངེས་ཤིང་ནམ་འཆི་ངེས་པ་མེད་པས།",
    "སྐྱབས་ཡུལ་རྣམས་ཀྱང་རང་ལ་ཐུགས་ཤིན་ཏུ་དགྱེས་པའི་ངང་ནས་སམ།",
    "དེ་བཞིན་གཤེགས་པ་རང་ངོས་ནས་མི་སྣང་ཞེས་གསུངས་འདུག་པར་གོ་རྒྱུ་ཞིག་མི་འདུག་གམ།",
    "བསམ་བློ་གཏང་ས་ཡོད་པའི་བཟོ་ཞིག་འདུག་དེར་བརྟེན་རང་བཞིན་རྣམ་དག་ཡིན་པའི་ཆ་ནས་དག་པ་རབ་འབྱམས་ཀྱི་བསམ་བློ་གཏང་ས་ཞིག་ཡོད་པར་མ་ཟད།",
    "སྟན་བདེ་བ་ལ་ལུས་འདུག་ལུགས་བརྒྱད་དང་སྤྱོད་ལམ་གང་བདེར་འཁོད་ནས་དགེ་སེམས་ཁྱད་པར་ཅན་གྱི་ངང་ནས།",
    "དུད་འགྲོ་ཚོར་བལྟས་ཀྱང་ཅུང་ཙམ་དུད་འགྲོ་སེམས་བཟང་བ་དེ་རོགས་པ་ཚོའི་མཉམ་དུ་སྐྱིད་པོ་བྱས་ནས་འདུག་ཀྱང་།",
    "འཇིག་རྟེན་བཀོད་པ་པོས་སེམས་བཟང་པོ་བྱེད་དགོས་པར་གསུངས་འདུག་ཅེས་སེམས་བཟང་པོ་བྱས་ན་ཕན་ཐོགས་ཡོད་ཀྱང་།",
    "དགའ་ཚོར་མྱོང་མཁན་དེ་ཅི་འདྲ་ཞིག་འདུག་བསམ་བློ་བཏང་ན།",
    "གང་ལྟར་གཉིས་ཆར་གོ་རྒྱུ་འདུག་ཀྱང་།",
    "གསུམ་ལ་རིང་ཐུང་ཡོད་པར་བསམ་ན་ཡང་ཡག་པོ་འདུག་པས།",
    "རྒྱབ་ལོགས་སུ་སྒྲོ་ཏོག་ཙམ་ཡོད་པ་ཞིག་འདུག་སྔར་དེ་ལྟར་ཡིན་ནམ།",
    "དེ་ལྟ་བུའི་ང་དེ་གང་དུ་འདུག་པ་དང་།",
    "ང་རང་བཞིན་མེད་པར་བསམ་བློ་བཏང་སྟེ།",
    "དེའི་ངོ་བོ་ལ་བལྟ་བ་དང་རང་བཞིན་ལ་བལྟ་བར་གསུངས་པ་མ་གཏོགས་དེ་མཚུངས་ཡིན།",
    "ཁྲིད་ཡིག་ཚོའི་ནང་ལ་ཡང་གསལ་ཁ་དམིགས་བསལ་མི་འདུག་པས།",
    "ཡང་ན་ཁྲོ་བོ་དེ་རྒྱབ་ལ་སྒོམ་སྟངས་གཅིག་བཅས་གསུངས་འདུགརྩ་རྒྱུས་།",
    "འགྲེལ་བ་སྒྲོན་གསལ་དུ་ཡང་ལུང་དེ་དྲངས་འདུག་པས།",
    "བྱང་སྒྲ་མི་སྙན་ཡང་ཁོ་རང་ལ་བལྟོས་ཏེ་གཡས་གཡོན་གཉིས་ལ་བཀོད་པ་ཡིན།",
    "ཉི་ཟླའི་མཐོ་དམན་དང་ཉི་ཟླའི་ཆེ་ཆུང་ལ་ཧ་ཅང་ཧེ་བག་ཆེན་པོ་ཞིག་འདུག་པ་དེ།",
    "ཟླ་བ་ཐག་ཉེ་རུ་ཉེ་རུ་ཡོང་བའི་སྐད་ཆ་མི་འདུག་པས་ཏོག་ཙམ་རྙོག་དྲྭ་ཡིན་པར་མ་ཟད།",
    "རང་བྱུང་རང་བྱུང་སྟོན་པ་འཇིག་རྟེན་ན།",
    "ཞེས་གསུངས་པ་ལྟར་ཧ་ཅང་སེམས་སྐྱོ་བོ་འདུག་དེ་ལྟར་སྟོན་པ་འཇིག་རྟེན་གྱི་མིག་ནི་ཟུམ།",
    "སྟོན་པའི་བསྟན་པ་ནི་ལྐོག་མར་སྲོག་ཕྱིན་པ་ལྟར་གྱི་དུས་སུ་སླེབས་འདུག་པས།",
    "དེ་ལས་ཤར་བ་རྣམས་ལ་གཞི་སྣང་ཞེས་ཤ་གས་ཆེན་པོ་གསུངས་འདུག་པ་ལྟར་དང་།",
    "ཐམས་ཅད་རྣལ་འབྱོར་དུ་སེམས་བསྐྱེད་པ་གསུངས་མི་འདུག་པས།",
    "དེ་སྟབས་བདེ་བོ་ཞིག་འདུག་དེ་ནས་ལམ་ཡོངས་རྫོགས་ལ་བཤར་སྒོམ་བྱས་ནས།",
    "ཕ་རོལ་པོའི་ཀུན་སློང་ཅི་འདྲ་ཡིན་ཡང་རང་ངོས་ལ་དངོས་གནས་དྲིན་ཆེན་པོ་ཡིན་སྙམ་ནས་དྲིན་དྲན་པ་ཡིན་ན།",
    "རང་དོན་དུ་བསམ་བློ་བཏང་ཡང་རང་ཡལ་བར་འདོར་བ་དང་གཞན་གཅེས་པར་བཟུང་ན་རང་དོན་མཐར་ཐུག་ཐོབ་ཐུབ།",
    "བསླབ་བཏུས་སུ་ཕར་རི་དང་ཚུར་རི་བཞིན་ཞེས་པའི་ཚིག་ཅིག་ཡོད་པ་དེ་ཕལ་ཆེར་དོན་དམ་པ་ཡིན་ཚོད་འདུག་ལ།",
    "ལེ་ལན་ཐམས་ཅད་དམ་ཁག་གཡོག་ས་ཆ་ཚང་རང་གཅེས་འཛིན་གྱི་མགོ་ལ་འགེལ་དགོས།",
    "གཞན་ཞེས་པ་གལ་ཆེན་པོར་འདུག་སྙམ་པའི་ཚེ།",
    "ཞེས་ཐུགས་རྗེ་སྐུལ་བའི་ཚིག་འདི་ལྟ་བུ་ཞིག་ཡོད་ན་ཡག་པོ་འདུག་ཅེས་གསོལ་བ་བཏབ་པ་ལ་བརྟེན་ནས།",
    "ཐབས་གཞན་ནི་མི་འདུག་པས།",
    "སྔོན་ལ་སོ་སོའི་གྲོད་ཁོག་གལ་ཆེ་བར་འདུག་པས།",
    "ཁྱེད་རང་མགོ་སེར་ཚོར་ཡེ་ཤ་འི་འཁྲུངས་སྐར་ལ་འཚམས་འདྲི་ཡོད།",
    "སེམས་ཀྱི་སོ་ཤི་སྟེ་ཅི་ཡང་འཇོན་གྱི་མི་འདུག་སྙམ་པ།",
    "གྲོགས་མཆེད་ཁྱེད་རང་མ་ལགས་པར།",
    "ཡག་པོ་མི་འདུག་དེ་མིན་བདུན་ཚིགས་དང་།",
    "བདག་འཇུག་རྒྱས་པ་མི་ནུས་ན་འདི་ཧ་ཅང་ཡག་པོ་འདུགདེ་ལྟར་ལན་གསུམ་གསོལ་བ་བཏབ་པའི་མཐུས།",
    "དམིགས་བསལ་བློ་འཛིན་བྱེད་ཀྱིན་བསྡད་ན་དགོས་པ་ལྷག་པོ་མི་འདུག་དེར་བརྟེན་མགོན་པོ་ཀླུ་སྒྲུབ་ཀྱིས་རྩ་བ་ཤེས་རབ་ཀྱི་མཇུག་དེར་བཅོམ་ལྡན་འདས་ཀྱི་བཀའ་དྲིན་དྲན་པའི་སྒོ་ནས་བསྟོད་ཕྱག་མཛད་པའི་ཚིགས་བཅད་དེ་འཆར་ཅན་འདོན་གྱི་ཡོད།",
    "དེ་རིང་འདིར་སེར་སྐྱ་མང་པོ་ཞིག་འཛོམས་འདུག་ལ།",
    "ཕལ་ཆེར་ད་ལྟའི་བར་རྒྱ་ཡིག་ལ་བསྒྱུར་མེད་ཚོད་འདུག་པས།",
    "ཉམས་བཞེས་གནང་མཁན་ཅི་རིགས་འདུག་ཡིན་ན་ཡང་མང་ཆེ་བ་བྱ་རྒྱུད།",
    "ཚན་རིག་པར་ཧ་ཅང་ཕན་ཐོགས་འདུག་ཅེས་དགའ་བོ་བྱེད།",
    "ཞིག་འཇོན་པོ་དང་རྒོད་པོ་ཇི་ཙམ་ཡོད་ཀྱང་རང་ཉིད་འཚོ་གནས་ཐུབ་པར་ལྟོ་ཆས་སམ།",
    "ངའི་ངོ་ཤེས་ཕྱུག་པོ་དངུལ་ལ་ཐོགས་པ་མེད་པ་དེ་འདྲ་ཡང་སེམས་མི་སྐྱིད་པར་ཧ་ཅང་དངངས་སྐྲག་ངང་སྡོད་ཀྱི་འདུག་ཁོ་ལ་དངུལ་བརྒྱ་ཕྲག་དང་འབུམ་ཕྲག་ས་ཡ་དང་དུང་ཕྱུར་ཡོད་ཀྱང་།",
    "སེམས་སུ་དེས་ན་ཁོ་ལ་ཡང་ཁག་མི་འདུག་སྙམ་པ་ཡོང་།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བྱང་སེམས་བཅས་ལས་སྔོན་ལ་ཉན་ཐོས་ཀྱི་བདེན་བཞིའི་རྣམ་གཞག་དང་།",
    "སྐབས་དེར་གནམ་ཐང་དེར་ལས་ཀ་བྱེད་མཁན་རྒྱ་གར་བ་ཞིག་འདུག་རྒྱ་གར་བ་དེ་ངའི་མདུན་དུ་ཡོང་ནས་ཁོ་རང་ནང་པ་ཡིན་ཞེས་ཟེར།",
    "འདོན་པའི་དོན་བང་བསྒྲིགས་ནས་བསམ་བློ་བཏང་བ་ཡིན་ན་ཧ་ཅང་ཡག་པོ་འདུག་ཀྱང་།",
    "ཉམས་ལེན་ཡག་པོ་ཡོད་མཁན་ཞིག་ཡིན་ན་ཡང་མཐོང་མེད་པའི་བཟོ་ལྟ་བུ་ཞིག་འདུག་པ་ནི།",
    "དེའི་ཚད་དང་འགྲོ་སྟངས་རྣམས་དེ་འདྲ་ཡིན་འདུག་སྙམ་ཐུབ་པ་ཞིག་མཐོང་རྒྱུ་ཡོད་དགོས།",
    "ང་རང་སྤྱིར་བོད་པ་དང་།",
    "མི་དམིགས་པ་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་རྣམ་པ་ཉིད་ཡིན་པས་དངོས་པོའི་ཡུལ་ཅན་ལས་འདས་པ་མ་ཡིན་ནོ།",
    "དེ་ཡང་རང་རིག་པས་གྲུབ་པའི་ཕྱིར།",
    "དམིགས་པར་བྱ་བ་ཡང་རང་རང་ལ་ངེས་པ་ཡིན་པའི་ཕྱིར་ན།",
    "གལ་ཏེ་བྱ་བའམ་རྣམ་པར་རྟོག་པའི་༧ཕྱི་རོལ་རྟོགས་པར་བྱེད་པ་ཡང་རང་རྒྱུད་ཁོ་ན་ཡིན་ཏེ།",
    "འོན་ཏེ་དེ་དང་འབྲེལ་པ་ཅན་བརྗོད་ན་དེར་མི་འཇུག་པ་ཇི་ལྟར་ཞེ་འབྲེལ་པ་དང་མ་འབྲེལ་པ་བརྗོད་ན་ཉེས་པ་སོ་ན་འདུག་གོ་ཞེས་བརྗོད་པ་ན་ནི་འཆད་པ་པོ་དང་ཉན་པ་པོ།",
    "འོ་ན་ཕྱི་རོལ་ན་འདུག་པ་མཐོང་བ་ཡིན་ནོ་སྙམ་ན།",
    "ཅི་སྟེ་ཡང་རང་བཞིན་གང་ཞིག་རྣམ་པར་རྟོག་པ་ལ་སྣང་བའི་རང་བཞིན་དེ་ནི་ཐ་དད་པའམ་ཐ་མི་དད་པ་ཡིན་ཡང་སླ་སྟེ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཅི་ལྟར་ཐ་དད་ཅེ་ན།",
    "ཐུག་པ་མེད་པ་མ་ཡིན་ན་དེ་ལྟ་ན་དོན་མེད་པ་ཡང་རང་ལས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ཤེས་པ་མེད་པ་ཡང་རང་ལས་འགྲུབ་པ་མ་ཡིན་པས་ན་ཐུག་པ་མེད་པ་ཁོ་ནའོ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་དང་འབྲེལ་པའི་ཕྱིར་གོ་བར་བྱེད་པ་ཉིད་ཡིན་ནོ་། མི་དམིགས་པ་གོ་ཅི་ལྟར་དེ།",
    "སྐད་ཅིག་སོ་སོར་མི་འཇིག་ན་མཐའི་སྐད་ཅིག་ལ་ཡང་རང་བཞིན་དེ་ཉིད་ཡིན་ཏེ།",
    "འོན་ཀྱང་འདུག་བཞིན་དུའོ།",
    "འདིར་ཡང་རང་བཞིན་དུ་འགྱུར་རོ་སྙམ་ན་སྣ་ཚོགས་པ་ནི་འདིར་ཞེས་བྱ་བའོ།",
    "གཞན་ཡང་རང་རིག་པ་ཡིན་ན་ནི་ཤེས་པ་གཞན་རིག་པ་ལ་དགོས་པ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་བདག་དེ་ཡང་རང་རིག་པའམ་གཞན་རིག་པར་འགྱུར་ཞེས་པའི་བརྒལ་ཞིང་བརྟག་པ་འདི་ཉིད་ལས་འཕར་བ་མ་ཡིན་ནོ།",
    "གཞན་ལ་ཕྱོགས་པས་ཀྱང་རང་བཞིན་གཞན་ཁོ་ན་རིག་པ་དེས་ནའོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་རྣམས་འབྲེལ་པ་སྟེ།",
    "འདིས་ནི་ཡིད་ཀྱི་མངོན་སུམ་དང་རང་རིག་པ་ཡང་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་ཡོད་པ་དང་རང་རིག་པ་ལ་སོགས་པའོ།",
    "རང་བྱུང་རང་ཉིད་ཁོ་ན་སྤྲུལ།",
    "འོན་ཏེ་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་དུས་མཚུངས་པ་ཁོ་ན་ཡིན་ཏེ།",
    "ོབློས་ཅི་བྱ་དེས་ན་ཉེས་པ་སོ་ན་འདུག་གོ་ཞེས་དགོངས་པའོ།",
    "དེའི་ཚེ་ངེས་པ་ཡང་རང་ཉིད་ནུས་པ་མེད་པར་ཇི་ལྟར་བྱེད།",
    "གཞན་ལ་ཡང་རང་བཞིན་དུ་གྱུར་པའི་ཉམས་སུ་མྱོང་བའི་ངོ་བོ་ཡོད་ན་དེའི་གཞན་ཉིད་དུ་མི་འགྱུར་རོ།",
    "དེས་ན་རྗེས་སུ་དཔག་པ་མཐའ་ཡས་དག་འཆད་པ་ནི་སོ་ན་འདུག་གོ་ཞེ་ན།",
    "གསལ་བ་ཡང་རང་ལས་འགྱུར་བ་ཉིད་དེ་ལྟར་ན་མཐོང་བ་ནི་རང་ཉིད་ཁོ་ན་གསལ་བར་ཁས་ལེན་པ་དེ་བཞིན་དུ་གསལ་བར་བྱེད་པ་ཐ་དད་པས་ཅི་ཞིག་བྱ་ཞེས་དགོངས་པའོ།",
    "སྔོན་པོ་ལ་སོགས་པ་ཡང་རང་རིག་པར་བྱ་བའི་དོན་ཏོ།",
    "གཉིས་ཀའི་རང་བཞིན་ཞེས་བྱ་བ་ནི་རྫས་དང་རང་རིག་པའི་རང་བཞིན་ནོ།",
    "ཡུལ་ཐ་དད་པར་ཞེས་བྱ་བའོ་། གལ་ཏེ་ཡུལ་ཐ་དད་པས་གཅིག་མ་ཡིན་ན་དེའི་ཚེ་བདག་ཀྱང་རིག་པར་བྱེད་པ་དག་ཀྱང་རང་བཞིན་ཐ་དད་པས་ན་ཇི་ལྟར་གཅིག་ཡིན།",
    "དེ་ལས་ཞེས་བྱ་བ་དང་རང་བཞིན་ལས་ཐ་དད་པར་མི་མཐོང་བའི་ཕྱིར་ཐ་དད་པར་མ་གྲུབ་པོ་ཞེ་ན།",
    "རྣམ་པར་ཤེས་པར་སྨྲ་བས་ནིའོ་། གལ་ཏེ་ཇི་ལྟར་བློ་རང་རིག་པས་གྲུབ་པར་ཁས་བླངས་ནས་༤དོན་ཡོངས་སུ་འདོར་བ་དེ་བཞིན་དུ་དོན་ཡང་རང་རིག་པར་ཁས་བླངས་ནས་བློ་དོར་བར་བྱའོ་སྙམ་ན།",
    "དེའི་ཞེས་བྱ་བ་རྣམ་པར་ཤེས་པའི་བདག་ཉིད་ལ་ནི་ཇི་ལྟར་ཐ་དད་པར་མཐོང་རང་བཞིན་དེ་ཉིད་ནི་གཞན་དུ་འགྱུར་བ་མ་ཡིན།",
    "འོན་ཀྱང་གང་ལ་ཡང་རང་རིག་པ་ཡོད་པ་དེ་ལ་ནི།",
    "འོན་ཀྱང་རང་རིག་པ་ལའོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ཉིད་དེ་རིང་ན་འདུག་པའི་དངོས་པོ་ཉིད་གསལ་བའི་ཕྱིར་ཐག་རིང་པོ་མ་ཡིན་ནོ་ཞེས་རྗོད་པར་བྱེད་དེ།",
    "རྣམ་པ་དང་བཅས་པ་ན་ཡང་རང་རིག་པ་༦ཁོ་ནའོ།",
    "པེ་སྣར་ཙ་ནི་པེ་སྣར་མཐའ།",
    "པེ་སྣར་དོན་ཡོངས་སུ་འདོར་བ་དེ་བཞིན་དུ་དོན་ཡང་རང་རིག་པས་ཁས་བླངས་ནས།",
    "འབྲས་བུའི་གནས་སྐབས་ཀྱང་རང་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པའི་དབྱེ་བས་རྣམ་པ་གཉིས་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་རྣམས་ཀྱི་ཞེས་བྱ་བ་ནི་ཚིག་རྣམས་ཀྱིའོ་ཞེས་དེ་ལྟར་དྲན་པའི་སྐྱེས་བུ་ནི་ངེས་པར་སྦྱར་བར་བྱ་བ་ནི་མངོན་དུ་ཕྱོགས་པ་ལ་འདུག་པ་ཞེས་སྦྱར་རོ།",
    "སྔར་དམིགས་པའི་དུ་བ་དང་རང་བཞིན་མཚུངས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ངེས་པར་བརྗོད་པར་འདོད་པ་གང་ཡང་རང་ཁོ་ནས་ཞེས་ངེས་པར་བཟུང་བ་མ་ཡིན་གྱིས་འོན་ཀྱང་མཐོང་བ་ཁོ་ནའོ་ཞེས་སོ།",
    "གཞན་གང་རང་བཞིན་གཞན་གྱིས་སྟོང་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་མ་ངེས་པ་ཉིད་དུ་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "ཐ་དད་པ་ཞེས་བྱ་བ་ནི་མདུན་ན་འདུག་པའི་རྣམ་པ་ཅན་ལས་རྣམ་པ་ཅན་གཞན་པའོ།",
    "གལ་ཏེ་མདུན་ན་འདུག་པ་རྣམ་པ་དང་ལྡན་པ་རྣམ་པ་བཟུང་བ་ན་རྣམ་པ་དང་ལྡན་པགཞན་གྱིས་༦འཛིན་ན་དེའི་ཚེ་རྣམ་པ་དང་ལྡན་པ་གཞན་ལ་གནས་པའི་རྣམ་པ་ཡང་མ་༧བཟུང་བར་འགྱུར་རོ།",
    "གང་ལ་ལྟོས་༤ ཏེ་སྣང་བཞིན་པ་མདུན་ན་འདུག་པའི་རྣམ་པ་ཐ་དད་པར་འགྱུར་སྙམ་ན་རྣམ་པ་དང་ལྡན་པ་གཞན་དང་།",
    "གཞན་གྱི་རྟོགས་པ་ཡང་རང་ལ་གྲུབ་པའི་རྟགས་ཀྱིས་རྗེས་སུ་འབྲང་བ་ཁོ་ནའོ་ཞེས་བྱ་བའི་དོན་ཏོ་།",
    "གཞན་གྱི་ཐག་རིང་ན་འདུག་པ་ཞེས་སྨྲས་༤སོ།",
    "གལ་ཏེ་བསྟན་བཅོས་བྱེད་པའི་འདོད་པ་ཡང་རང་ཉིད་སྨོས་པས་སྟོན་པ་ཡིན་ན།",
    "དེས་ན་རྟོག་པ་སྔོན་དུ་བྱེད་པ་མ་ཡིན་པར་འཇུག་པའི་དོན་དུ་ཡང་རང་ཉིད་སྨོས་པ་དོན་མེད་དོ།",
    "དེའི་ཕྱིར་རྟོག་པ་གཉི་ག་ལ་ལྟོས་ནས་ཀྱང་རང་ཉིད་སྨོས་པ་དོན་མེད་པ་ཁོ་ནའོ།",
    "འོན་ཀྱང་རང་བཞིན་དང་འབྲས་བུ་དང་དེ་དག་བརྙན་མའི་དབྱེ་བས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་དུ་འདི་ཡང་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འདོད་པའི་སྒྲས་བརྗོད་པར་བྱ་བ་འདི་ཡང་རང་རིག་པ་ཁོ་ན་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པར་བྱ་བའི་རུང་བ་ཉིད་དེ་ལས་ཐ་སྙད་དུ་བྱ་བ་མ་ཡིན་པ་དེ་བས་ན།",
    "གལ་ཏེ་ཐམས་ཅད་ཀྱི་ཚེ་སྤྱི་ཁྱད་པར་ཉིད་ཡིན་ན་དེའི་ཚེ་གོང་བུ་རྒྱང་རིང་པོ་ན་འདུག་ཀྱང་།",
    "དེ་ལྟ་ཡིན་དང་སྲང་དམའ་བའི་ཁྱད་པར་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་ཉེས་པ་སོ་ན་འདུག་གོ།",
    "འདིས་ནི་འདུག་པར་ཡང་མི་བྱ་འགྲོ་བར་ཡང་མི་བྱ་ཞེས་བྱ་བའི་ཚུལ་བསྟན་པ་ཡིན་ནོ།",
    "༢༡༡༣༡རྟོགས་པའི་རྒྱུ་ཡིན་པ་དེ་བཞིན་དུ་སྒྲའི་སྒྲ་ཉིད་ཀྱང་རང་མི་རྟག་པ་ཉིད་དུ་གོ་བར་བྱེད་པ་ཡིན་ནོ་སྙམ་ན།",
    "བླ་འོག་ཏུ་ཞེས་བྱ་བ་སྟེ་དངོས་པོ་མེད་པ་འོག་ཏུ་གནས་པའི་སྟེང་ན་དངོས་པོ་འདུག་པར་རྟོགས་པ་ནི་མེད་དོ།",
    "གསལ་བའི་རང་བཞིན་ལས་ཐ་དད་པ་དང་ཐ་མི་དད་པ་དག་ཏུ་སྣང་བའི་ཕྱིར་སྤྱི་དང་རང་བཞིན་གཉི་ག་ཡིན་ནོ་ཞེས་དོགས་པ་ནི།",
    "དེའི་འོག་ཏུ་ཡང་རང་བཞིན་གཉིས་པའི་སྤྱི་གཞན་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་འོ་ན་སྤྱི་དེ་ཡང་རང་བཞིན་གཉིས་པ་ཡིན་པའི་ཕྱིར་དེ་ལ་ཡང་སྤྱི་གཞན་འཕྱོ་བར་འགྱུར་རོ།",
    "འོན་ཀྱང་རང་བཞིན་ཁོ་ནས་ཁྱབ་པ་ཡིན་ནོ།",
    "དེ་ཡང་རང་བཞིན་གཞན་ཡིན་པ་ནི་སྒྲའི་རང་བཞིན་གཞན་ཡིན་པའོ།",
    "འབྱུང་ཁུངས་མ་ཡིན་ནོ་ཞེས་ཟུར་ན་འདུག་པའི་རྩོད་པ་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "དེས་ན་རིགས་པ་ཅན་ལ་སོགས་པ་སྒྲའི་དོན་རང་བཞིན་མེད་པ་ཅི་ལྟར་ཡིན་ཞེས་སྤོང་བར་འགྱུར་རོ་། གལ་ཏེ་སྒྲོ་བཏགས་པ་མི་བདེན་ཡང་རང་བཞིན་མེད་པར་སྒྲའི་དོན་ཅི་ལྟར་ཡིན་ཏེ།",
    "དེས་ན་དུ་བ་༤མེ་ལས་འཁྲུལ་པར་དོགས་པ་གང་ལ་ཡོད་མེ་ལ་སོགས་པའི་ཚོགས་པ་དུ་བ་སྐྱེད་པར་བྱེད་པ་གང་ཡིན་པ་དེའི་དུ་བ་སྐྱེད་པའི་རང་བཞིན་དེ་ཉིད་གལ་ཏེ་འཁྲུལ་པའི་ཡུལ་དུ་འདོད་པ་གཞན་གྱིས་༧ ཡང་རང་བཞིན་ཡིན་ན།",
    "རྟགས་དུ་བ་ལས་རྟོགས་པ་ཡང་རང་བཞིན་དེ་ཉིད་ཀྱིས་ཡིན་ཏེ།",
    "གྲུབ་པའི་མི་དམིགས་པ་དེས་ཀྱང་རང་ཉིད་ཙམ་གྱི་འཇུག་པ་གང་ལ་ཡོད་པ་སྟེ་དེ་དག་ིདགག་པར་བྱ་བ་མེད་པའི་རྣམ་པར་གཞག་པ་དེའི་གོ་བྱེད་དེ་འཇུག་པ་ཡིན་ནོ།",
    "ཤེས་པ་ནི་རང་ཉིད་ཀྱིས་འགྲུབ་པས་ན་དེ་མེད་པ་ཡང་རང་ལས་འགྲུབ་པའི་ཕྱིར་ཐུག་པ་མེད་པ་མ་ཡིན་ནོ།",
    "རིག་པ་མི་དམིགས་པ་ནི་གསལ་བར་ཡང་རང་བཞིན་མི་དམིགས་པར་འཆད་དེ་དང་ངོ།",
    "འབྲས་བུ་དང་རང་བཞིན་འབའ་ཞིག་ཏུ་ནི་མ་ཟད་ཀྱི་རྒྱུ་དང་༤ཁྱབ་བྱེད་མི་དམིགས་པར་ཡང་ངོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་རང་བཞིན་མི་དམིགས་པ་ལས་རང་བཞིན་འགལ་བ་དམིགས་པ་ཅི་ལྟར་གཞན་མ་ཡིན་ཞེ་ན།",
    "འགལ་བའི་འབྲས་བུ་དམིགས་པ་ཡང་རང་བཞིན་མི་དམིགས་པ་ལས་གཞན་མ་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི་འགལ་བའི་ཞེས་བྱ་བའོ།",
    "ཁྱབ་བྱ་གང་ཡིན་པ་དེ་སྦྱར་བ་གང་ཡིན་པ་དེར་ནི་སྟེ་འགལ་བའི་འབྲས་བུ་དང་ཁྱབ་བྱ་དམིགས་པར་ནི་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་དག་ཀྱང་འདུ་བའི་ཕྱིར་རོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་འབྲས་བུ་དང་རང་བཞིན་དག་མི་དམིགས་པར་འདུ་བ་ནིའོ།",
    "གལ་ཏེ་འབྲས་བུ་དང་རང་བཞིན་དག་གཞན་གྱིས་མི་དམིགས་པའི་ནང་དུ་འདུ་བར་བརྗོད་པ་མ་ཡིན་ནམ།",
    "འགལ་བའི་འབྲས་བུ་དམིགས་པ་ཞེས་བརྗོད་པ་ཙམ་གྱིས་ནི་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་མི་དམིགས་པའི་མཚན་ཉིད་དུ་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "༡༥༣༢༧པེ་སྣར་དང་རང་བཞིན།",
    "ཞེས་པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་པེ་ལ་གོང་འོག་འཆོལ་འདུག་པས་ཀ་ཁའི་རྟགས་བརྒྱབ་ནས་བསྒྲིགས་ཡོད།",
    "རང་ཉིད་བདེ་བའི་སྟན་འདུག་སྟེ།",
    "རང་རང་དགྱེས་པའི་གདན་ལ་བརྟན་པར་བཞུགས།",
    "རང་རང་འདོད་པའི་དངོས་པོར་གྱུར་པས་བསང་།",
    "རྣམ་པར་རང་རང་སོ་སོའི་གནས་སུ་གཤེགས།",
    "རང་རང་སོ་སོའི་གནས་མཆོག་ནས།",
    "གཏང་རག་དུས་གཏོར་ཆག་པ་སོགས།",
    "དགྲ་ལྷ་གཉན་པོ་མཆོད་ཙ་ན།",
    "བདག་ཅག་གར་འགྲོ་གར་འདུག་ཀྱང་།",
    "ལྷ་སྲིན་མ་འདུག་མ་ཕྱེ་བའི",
    "རང་རང་བདེ་བར་གཤེགས་ནས་ཀྱང་",
