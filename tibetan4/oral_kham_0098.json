    "ལུས་དཀྱིལ་སྒོམ་ཚུལ་སོགས་བྲིས་འདུག་ཀྱང་།",
    "སྣང་བ་དང་སྟོང་པ་འདི་ལ་མ་ཆགས་པ་ཞིག་དགོསཞེས་གསུངས་པའི་ཕྱིར་ཤུ་རྩ་རོ་ སྣང་བ་དང་སྟོང་པ་དབྱེར་མེད་དུ་འདུག་སྙམ་ན།",
    "ཡང་། ལྟེ་བའི་འོག་ནས་མེ་བྱུང་རང་ལུས་བསྲེགས་མེ་དཔུང་ཕྱིར་འཕེལ་ཕྱི་ཡི་ཡུལ་མཁར་དང་དགྲ་གཉེན་མཛེས་སྡུག་འཛིན་པའི་ཡུལ་སྣང་བསྲེགས",
    "གཉིད་ཀྱི་དགྲ་འདྲེ་སད་དུས་གང་ན་འདུག་དེ་བཞིན་ད་ལྟའི་འཛིན་སྣང་འདིས་འཕུང་ཝུ།",
    "བྱུང་ས་འདུག་ན་དེ་ཡི་རྩ་བ་བརྟག",
    "མ་གྲུབ་འདུག་ན་འཕྲོ་འདུ་ཅི་ལས་བྱུང་",
    "འགྲོ་ས་འདུག་ན་དེ་ཡི་རྩ་བ་བཅད",
    "ཁ་དོག་དཀར་དམར་སོགས་ཇི་འདྲར་སྣང་གཅིག་དང་དུ་མ་ཇི་ལྟ་བུ་ཞིག་གཅིག་ཏུ་འདུག་ན་དེ་ཡང་ཇི་ལྟ་བུམང་པོར་འདུག་ན་ནའབུམ།",
    "ཕྱོགས་ཞེན་དང་བྲལ་བར་འདུག་པ་སྟོང་པ་དེ་ཡང་ངོ་བོ་ཉིད་མེད་པ་མ་ཡིན་ཏེ་གསལ་ལ་དྭངས་པ་མན་ཤེལ་ལྟ་བུ་འདི་མཐོང་ངམ།",
    "རང་སྣང་རིས་མེད་ཀྱི་སྣང་བ་གཏན་ལ་དབབཕྱི་རོལ་གྱི་ཡུལ་སྣང་སྣ་ཚོགས་སུ་འདུག་ཀྱང་རང་སྣང་ཡིན།",
    "ཞེས་གསུངས་པ་དོན་འདུས་ཤིང་གོ་སླ་བར་འདུག་པས་བྲིས་པ་ཡིན།",
    "སྟོད་ཕྱོགས་ཀྱི་ལག་ལེན་འགར་རྒྱལ་ཆེན་གྱི་སྔོན་དུ་བགེགས་གཏོར་གཏོང་སྲོལ་འདུག་ཀྱང་གོང་མའི་ཕྱག་བཞེས་སུ་འདི་ལྟར་མཛད་དོ།",
    "ཅེས་སོགས་ཀྱང་མཛད་པ་ཕྱག་བཞེས་སུ་འདུག་གོ།",
    "རང་བྱུང་རང་ཤར་ཞི་ཁྲོ་རྩ་བའི་ལྷ",
    "འདི་ཉིད་ཡིན་ནོ་ནམ་ཞིག་དུས་ཀྱི་ཚེ",
    "འདུག་ཚུལ་ནིརྩ་བར་སྟན་བདེ་བ་ལ་ལུས་ཙོག་པུར་འདུག་ཏེཞེས་དང་།",
    "རང་བྱུང་རང་གསལ་སྟོང་པ་འཛིན་པ་མེད",
    "རང་བྱུང་རང་ཤར་རྒྱུད་ལྟར་བྱ",
    "དེ་ཡང་རང་གཞུང་ཚུགས་ཕྱིན་གཞན་གྱི་རྒྱས་འགེབས་སོགས་ངལ་བ་སྤངས་ཏེ་སྔོན་འགྲོའི་ཆོ་གར་དཔོན་སློབ་དང་གནས་ཀྱི་མཚན་ཉིད་བརྟག་པ་སོགས་གསུངས་པ་བཏང་སྙོམས་བཞག་ནསཆོ་ག་དངོས་ལ་བླང་གཟུང་སྦྱང་གསུམ་གྱི་དང་པོ་བླང་བ་ནི",
    "སློབ་དཔོན་དཀྱིལ་འཁོར་དབུས་སུ་འདུག",
    "དེ་ལྟ་བུའི་དམིགས་པ་རྣམས་དང་བཅས་རྡོར་དྲིལ་འཛིན་པས་དབུས་སུ་འདུག་སྟེ་ཧཱུྃ།",
    "གང་དག་མི་འགྲོ་འདུག་གྱུར་ན",
    "རང་རང་རྩ་བའི་སྔགས་ཀྱིས་བསྐྱེད",
    "དེ་ལ་ཉེ་བར་བོས་ནས་ཀྱང་སྤྲོ་བ་བསྐྱེད་པའི་ཚིག་འདི་བརྗོདཅེས་གསུངས་པ་འདི་ལ་གསན་པས་ཁྱད་པར་གདའ།",
    "ཅེས་གསུངས་པ་ལྟར་ཁྱེད་རང་རྣམས་སྔགས་ཀྱི་ཆོ་གའི་སྒོ་ནས་བུར་བྱས་ཟིན་པས།",
    "སྔོན་དུ་འགྲོ་བའི་ཆོ་ག་རྣམསརང་བྱུང་རང་ཤར་རྒྱུད་ལྟར་བྱ",
    "ཉི་ཟླའི་སྟེང་འདུག་ཕྱག་མཚན་ཐོགས",
    "ཞེས་གསུངས་པས་རྨི་ལམ་དངོས་སུ་དྲི་བར་མི་གསུང་མཛད་ཀྱང་རང་རང་ལ་རྨི་ལམ་བཟང་ངན་དེ་དག་གང་རྨིས་ཀྱང་འཛིན་ཞེན་མི་བྱ་བར།",
    "སྟོང་ཞིང་རང་སེམས་བརྟན་པོར་བཟུང་",
    "ཅེས་གསུངས་པས་ཁྱེད་རང་རྣམས་ལས་ཀྱི་རྡོ་རྗེ་སློབ་དཔོན་གྱིས་སྣ་དྲངས་ཏེ་དཀྱིལ་འཁོར་ལ་འདོད་སྣམ་གྱི་སྟེང་ནས་སྐོར་བ་ལན་གསུམ་བྱས།",
    "རང་བྱུང་རང་ཤར་རྒྱུད་ཆེན་ལྟར",
    "རྡོ་རྗེ་ཡེ་ཤེས་ཡེ་ཤེས་ཆེརང་བྱུང་རང་ཤར་དོན་མཐོང་ཕྱིར",
    "རང་རང་རིགས་དང་རིགས་ཆུང་དང་",
    "བྱེ་བྲག་རང་རང་ཆོ་ག་ཡི",
    "ཞེསསྒྲུབ་གསུངས་པས་ཁྱེད་རང་རྣམས་ཀྱི་ཐུགས་ཀར་རྡོ་རྗེ་སེམས་དཔའ་དཀར་པོ་ཞིག་གསལ་བཏབ།",
    "རང་བྱུང་རང་ཤར་རྒྱུད་ལྟར་བྱ",
    "རང་རང་རྩ་བའི་སྔགས་ཀྱིས་བསྐྱེད",
    "གསོལ་བཏབ་འདིའི་ཤོ་ལོ་ཀ་མ་ཚང་ཡང་དཔེ་ཕལ་ཆེར་ན་འདི་ལྟར་འདུགདེ་ནས་སློབ་བུའི་ལུས་རི་རྒྱལ་ལྷུན་པོ་ལྟར་བསྲང་",
    "དང་པོ་རང་ཉིད་དབེན་པའི་གནས་སུ་འདུག་ཞེས་ཤོ་ལོ་ཀ་དང་པོ་གནས་ལུགས་ཀྱི་ངང་དུ་བཞག་རཾ་ཡཾ་ཁཾ",
    "སྭཱ་བྷཱ་ཝ་སོགས་བབརྗོད་པས་ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་ཁམས་སྐྱེ་མཆེད་མིམི་དམིགས་ཏེ་སྟོང་པའི་ངང་ལས།",
    "གཏོར་མ་ལྷའི་རང་བཞིན་དུ་གསལ་བའི་གནས་གསུམ་ལས་འོད་ཟེར་སྒྲུབ་འཕྲོས་ཁྱེད་རང་རྣམས་ཀྱི་གནས་གསུམ་དུ་ཐིམ་པས།",
    "ཞེས་གསུངས་པས་གནང་བ་སྦྱིན་པ་གསན་པས་ཁྱབ་། པར་གདའ།",
    "སྐབས་འདིར་རྒྱུད་དག་པར་བྱ་བའི་ཕྱིར་སྐྱབས་སེམས་བྱ་ལབའི་སླད་དུ་དམིགས་པ་འདི་བཞིན་མཛོདཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར",
    "རང་བྱུང་རང་ཤར་རྒྱུད་ནས་བཏུསམ་འོངས་ཕྱི་མའི་དོན་ཕྱིར་དུ",
    "འདི་རུ་འདུག་པས་ཆོག་ཁྲིགས་ཤིག་བགྱིད་སྙམ་ཡང་བཏང་སྙོམས་སུ་ལུས་པ།",
    "ལུགས་འདི་གཉིས་ཀ་མི་འགལ་ཞིང་འདི་ཡང་གང་བདེ་བྱེད་ཡོད་པས་བཞེད་པ་དང་བསྟུན་ཆོག་པར་གདའོ།",
    "ཡིད་མཐུན་གྱི་གནས་སུ་གཙང་སྦྲར་བཅས་ཏེ་འདུག་ལ་སྐྱབས་ཡུལ་གསལ་བཏབ་སྟེཧཱུྃ",
    "བདེ་བའི་སྟན་ལ་འདུག་ནས་ཀྱང་",
    "ལྟར་ནརང་བྱུང་རང་ཤར་གྱི་རྒྱུད་ལས།",
    "རང་རང་ཡུལ་གྱི་ལྷ་འདྲེ་དང་",
    "རྡོ་ཆར་མ་ཕོག་ཙམ་གྱིས་རྒྱབ་ནས་བསྐུངསསྐྱེས་པ་གོ་མཚོན་ཅན་བརྒྱའི་བློ་ཡིས་གདའ།",
