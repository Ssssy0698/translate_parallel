    "འདིའི་འཆར་སྒོའི་རིམ་པ་ལྷུག་པར་འབྱེད།",
    "ལར་རྒྱལ་བས་གསུངས་པའི་ལས་འབྲས་བདེན།",
    "དོན་དམ་པའི་བྱ་བས་ཕྱག་ཏུ་བཞེས།",
    "ཐབས་མཁས་ཀྱིས་འདུམ་པར་མཛད་ན་ལེགས།",
    "ལུགས་སོ་མས་ལྷག་པར་རྩིས་མཐོང་བྱེད།",
    "ངེས་པར་ལེགས།",
    "རྡོ་དང་དབྱུག་པའི་སྤུན་ཟླ་མི་མཛད་པར།",
    "རྡོ་བཅལ་འགྲིམ་པ་དོན་དང་ལྡན་པར་མཛོད།",
    "བདག་སྟོན་པའི་དགོངས་པར་དཔྱོད་ཅིང་མཆིས།",
    "ཨ་ལགས་འདྲ་ཉེ་བར་ཉར་དགོས་ན།",
    "ཐག་རིང་ཐུང་ངུར་བྱས་པ་ཅུང་མི་མཛེས།",
    "ད་ལྟ་སྨྲ་བའི་སེངྒེའི་གླིང་ལ་ཕེབས།",
    "སྟག་དང་ཞུམ་བུའི་ཁྱད་པར་འདོམས་པ་གལ།",
    "ཕྱུར་ཁུག་ལྟ་བུའི་ལུང་པ་ཁ་དོག་པར།",
    "གོ་མ་ཆོད་ཀྱི་རྐང་ཐང་མ་བྱེད་པར།",
    "མེད་པར་ལྟ་བའི་གླང་པོའི་ཀླད་འགེམས་པ།",
    "ཀུན་མཁྱེན་ཧ་ས་བཛྲ་དགྱེས་པའི་ཕུལ།",
    "སྟོང་པ་ཞི་བ་སྐྱེ་བ་མེད་པར་མཉམ།",
    "ལུ་གུ་རྒྱུད་དུ་སྟོབས་ལྔ་སྨིན་པར་མཛོད།",
    "དྷུ་ཏིར་རོ་རྐྱང་གཉིས་དང་ཁྱད་པར་ཅི།",
    "རྟག་པར་ལ་ལུང་གཉེར་མ་མང་འགྲིམས་པས།",
    "ཨེ་མ་ཀུན་མཁྱེན་དྲུག་པའི་མནྡྷ་ར།",
    "ཐབས་ཤེས་དབྱིངས་རིག་རི་བོའི་ཕྲག་པར་ལོངས།",
    "རྟག་པར་ཤེས་པའི་རབ་ཀྱི་ཀློང་དུ་བསྲེལ།",
    "དཔྱི་ས་བློ་གྲོས་ནས་སྐྱབས་ཞུ་ཕུལ་ལན་དུ་གནང་བའོ། ། མ་ཏིས་མ་ཎི་བཟླ་བ་ཡི་རང་ཡུལ།",
    "འདི་ཡང་དཔྱི་ས་བློ་གྲོས་ཀྱིས་ཞུ་ཡིག་ཕུལ་ལན་དུ་གནང་བའོ།",
    "རང་དོན་རྐྱང་རྐྱང་བསམ་ག་ལ་ཆོག་ཅེས་འཇམ་ཞིང་འཇེབས་པར་སྨྲོས།",
    "དེས་ཕན་ཚུན་མཐུན་འགྲིག་ཕུན་སུམ་ཚོགས་པར་འགྱུར།",
    "མིའི་ནང་ན་ཡི་དྭགས་དང་མཚུངས་པའི་སྐྱོན་ཅན་ཚང་མའི་འཕྱ་སྨོད་ཀྱི་ཡུལ་དུ་གྱུར་པ་ལགས་ཏེ།",
    "ཕྱི་མར་བདེ་འགྲོའི་སྒྲ་ཙམ་ཡང་ཐོས་པར་དཀའ་ལ།",
    "ཕ་མ་ཡང་དགའ་ནི་ཞིག་བཅའ་སྙམ་དུ་སེམས་ལ་དྲན་ན་དེས་ཆོག་ངེས་པར་དེ་བཞིན་འོང་།",
    "སེར་སྣ་གསུམ་གྱི་མཚང་འབྱིན་བྱས་པ་ནི།",
    "གྲྭ་ཚང་གཞུང་ལ་གནང་བའོ།",
    "། བླ་བྲང་དགོན་གཞུང་ལ་གནང་བའི་འཕྲིན་ཡིག་སོགས།",
    "ཀུན་མཁྱེན་ཆེན་པོ་འཇམ་དབྱངས་བཞད་པ་ཞེས།",
    "ཅེས་གསུངས་པ་ལྟ་བུའི་གསང་ཐབས་ཤིག་ངེས་པར་ཟབ།",
    "བླ་བྲང་དགོན་གཞུང་ལ་གནང་བའོ།",
    "དད་དང་དམ་ཚིག་གཙང་མའི་རྟེན་གྱི་གཞིར།",
    "ཅེས་ཡང་དག་པའི་ལྷ་སྲུང་ཁྱད་པར་ཅན་ལ་ཆེད་དུ་སྦྲོན་པ་མི་བཟད་རྡོ་རྗེའི་སྒྲ་དབྱངས་ཞེས་བྱ་བ་འདི་ནི།",
    "ཨུར་རྡི་སི་པཎྜི་ཏ་ཞབས་དྲུང་ལ་གནང་བ། ། བསྔགས་འོས་དབེན་པའི་རི་ཁྲོད་ན་མཛེས་པ་སྦྱོར་བ་དང་སྐྱེས་པས་ཐོབ་པའི་མ་ཏི་ས་རར།",
    "ངེས་པར་དལ་བ་དང་འབྱོར་བའི་རྒྱན།",
    "ཞེས་པ་ལྟར་གོ་ཆའི་བརྩོན་འགྲུས་ཀྱིས་ཀུན་ནས་བརྗིད་པར་འཚལ།",
    "ཕ་རོལ་ཕྱིན་དྲུག་རྫོགས་པར་བྱིན་གྱིས་རློབས།",
    "བསྟན་པས་ས་སྟེང་ཁྱབ་པར་བྱིན་གྱིས་རློབས།",
    "འཐབ་རྩོད་འཁྲུག་ལོང་མེད་པར་བྱིན་གྱིས་རློབས།",
    "ཟླ་བའི་རྗེས་ལ་རྒྱུག་པར་འཚལ།",
    "རང་བྱུང་སྐུ་ཡིས་ཁྱད་པར་དུ།",
    "ཀུན་ལ་བྱས་པའི་སྐྱེས་བུ་དེར།",
    "སྒྲ་དོན་གྱིས་བྱས་ཨ་ལ་ལ།",
    "རྣམ་པར་བཀྲ་ཞིང་ཡངས་པོར་ཕྱེ་བ་ཉོན།",
    "ད་ལོ་དོན་བརྒྱད་ཀྱི་སྟེང་དུ་སླེབས་པ་འདི་ལགས་སོ་ཞེས་པའི་མཐའ་ཅན་སྨད་ནས་ལུས་པའི་གདུང་བ་མི་བཟད་གཟེར།",
    "ཕལ་ཆེར་སྐལ་བ་མེད་པར་སེམས།",
    "ལོངས་སྐུའི་ལོངས་སྤྱོད་ཐོབ་པར་ཅིས་མི་འགྱུར།",
    "དེའི་རྐང་པ་གསུམ་པར་བུང་བའི་མགྲིན་སྒྲ་ཞེས་ཡོད་པ་པཎྜི་ཏས་ཐུགས་མཉམ་མ་བཞག་པ་ཡིན་གྱི།",
    "དེ་བཞིན་དུ་ཇོ་ནང་སྒྲ་ཊཱིཀ་དབུས་དཔར་ན་ཅེས་ཀྱི་ཚིག་ཕྲད་ཙམ་པོ་པའི་སྐྱོན་ལུ་གུ་རྒྱུད་དུ་ཡོད་པ་དེ་ཡི་གེའི་ཉེས་པ་རང་ལགས་ཏེ།",
    "དཀྱུས་ལ་འཇུག་པར་བྱ་༡ཤནྱབྱིན་གྱིས་ལོངས།",
    "སྙན་པར་མངོན་རློམ་དཔེར་བརྗོད་ཕྲེང་ངོམ་པ།",
    "བདེ་ལེགས་ཤིས་པར་བརྗོད།",
    "བགསལ་བྱས་དབེན།",
    "ཡི་གེ་ཧ་ཅང་ཕྲ་ལ་ཞིབ་པར་མ་ཟད།",
    "ཞེས་བླངས་པ་ཐུགས་ཀྱི་ཟེའུ་འབྲུར་ཅི་ཡང་མཛེས་པར་འཚལ།",
    "རྒྱལ་མཁན་སྤྲུལ་བླ་བྲང་དུ་བསླབ་སྐྱོར་ཞུ་བར་ཕེབས་པ་ལ་གནང་བའོ།",
    "གདུལ་བྱའི་ཁམས་དང་འཚམ་པར་འཇུག་པ་ཡི།",
    "སྒེའུ་སྟེང་བློ་བཟང་སོགས་ལ་གནང་བའི་ཕྱག་རིས་འགའ། ། ཀྱེ་མང་ཐོས་སྒྲུབ་བརྩོན་བློ་གྲོས་བཟང་པོའི་དཔལ་ལྡན་ལགས།",
    "དེང་ནའང་དེའི་སྟོན་འཁོར་དུ་འདུས་པ་རྣམས་རྫོགས་པར་དགེའམ།",
    "སྐབས་ཀྱི་གཏམ་དུ་བྱ་བ་འདི་ལ་ཡུད་ཙམ་གསན་པར་ཞུ།",
    "འགལ་ཟླའི་ཁས་ལེན་ལ་ཕྱོགས་སོ་སོ་ནས་གནོད་སྒྲུབ་ལུང་རིགས་ཀྱི་དཔུང་ཡང་དག་པར་སྤྲོས་ན་གཞི་ལམ་འབྲས་བུའི་མཛེས་རྒྱན་དམ་པར་མི་འགྱུར་རམ།",
    "ཤཱཀྱའི་རིང་ལུགས་འཛིན་པ་ལ་ལེགས་པར་སྨྲ་བ་དང་ཉེས་པར་སྨྲ་བའི་རུ་ཤན་འབྱེད་པ་དེ་ལས་བརླིང་བ་གང་ཡང་མ་མཆིས་གཤིས་བསམ་སྦྱོར་རྣམ་པར་དག་པའི་སྒོ་ནས་ཕན་ཚུན་འཁྲུལ་སེལ་གྱི་བརྒལ་ལན་བྱ་བ་མི་འཐད་པ་མེད་ཀྱི་སྟེང་དུ་ཆེད་བསྔགས་ལྷའི་མེ་ཏོག་མནྡྲ་ར་བ་འཐོར་བའི་ཡུལ་དམ་པར་གྱུར་ལགས་ཏེ།",
    "ལེགས་པར་བརྟགས་ལ་ང་ཡི་གཞུང་།",
    "སྒེའུ་བློར་དགག་ལན་བསྐལ་མེ་དང་ཆབས་ཅིག་ཏུ་གནང་བའི་ཕྱག་རིས་དང་པོའོ། ། ལྷག་པའི་ལྷས་བྱིན་ཤེས་རབ་ནི།",
    "ཐམས་ཅད་ཀྱིས་རྒད་པོ་དེ་འགྲིག་ཀ་ཞེས་དོན་མཐུན་གྱི་མིང་སྒྲོག་པར་འགྱུར་བས་མི་ལེགས་སམ།",
    "སྒེའུ་བློར་གནང་བའི་ཕྱག་རིས་རྗེས་མའོ། ། བདེན་གསུང་བདེན་སྨྲ་མི་བསླུ་བསླུ་བ་མེད།",
    "དགོངས་པར་མཛོད་ཅིག་མཐའ་ཡི་མཐའ་ཞིག་ན།",
    "ཆུང་བ་མ་ལགས་ཆེ་བའི་ཆེ་བ་སྟེ།",
    "དེ་དོན་ཡང་ནས་ཡང་དུ་དཔྱད་པར་རིགས།",
    "བརྟན་བརྗིད་སྐྱེས་བུའི་ཟིལ་ཀུན་བྲོས་པར་དོགས།"
  ]
}