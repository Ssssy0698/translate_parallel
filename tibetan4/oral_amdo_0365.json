    "སེམས་པ་ལྷ་སྒྲུང་གི་མཚེའུ་ངོགས་དེར་ཕྱོགས་འགྲོ་སྟོན་མཇུག་གི་ཟླ་འོད་འོག་ལྗོན་གྲིབ་མྱུལ་བའི་རྡོག་སྒྲ་དེ་དྲན་ལ།",
    "ཡོད་ཚད་བྲག་ཅ་བཞིན་ཡལ་ཟིན་པ་བདེན་མོད།",
    "བདག་གིས་བརྗེད་ཀྱང་མི་ཐུབ་པའི་སེང་ལྡེང་ནགས་ཀྱི་སྒྲོལ་དཀར་མ་ཡ།",
    "གསོམ་སྡོང་གི་ལག་ངར་རེ་རེ་སྔར་བཞིན་ནམ་མཁར་སྒྲེང་།",
    "རྒུན་ཆང་གི་དྲི་ངད་སྔར་བཞིན་འཐུལ་ལ།",
    "བོར་སོང་བའི་ཁ་སང་གི་མནའ་ཚིག་དང་དམ་བཅའ་ཁྱེར་སོང་བའང་ངོ་མ་རེད།",
    "རེད་དེ།",
    "ཉིན་གྱི་དགོང་མོར་ལན་གྲུ་ནས།",
    "ཕ་ཡུལ་གྱི་རི་ཆུང་དེ་མཐོང་ཐེངས་རེ་ལ།",
    "ངེད་ཚང་གི་མཚེར་ས་བྱེད་པར་ཆེད་དུ་བསྐྲུན་པ་ལྟ་བུའི་ཕ་ཡུལ་གྱི་རི་ཆུང་དེའི་ལོགས་སུ་གནས་ཤིང་།",
    "ཨ་མ་ཕལ་ཆེར་ཉིན་ལྟར་རི་ཆུང་གི་སྟེང་དུ་འཛེགས་ནས་རྒྱང་ལྟ་བྱེད།",
    "སྐབས་འགར་ང་ཡང་ཨ་མའི་རྗེས་སུ་འབྲངས་ཏེ་རྩེད་མོར་གཡེང་བ་ལས་དམིགས་ཡུལ་ཅི་ཡང་མེད་པར་རི་ཆུང་གི་སྟེང་དུ་བུད།",
    "ནེའུ་གསིང་གི་ངོས་སུ་ལྷུང་བའི་རྟ་ཁྱུ་དང་།",
    "ཨ་མ་རི་ཆུང་གི་སྟེང་དུ་འགྲེང་ནས་ང་ལ་མིག་གིས་བལྟས་ཡོད་པ་མཐོང་ཚེ།",
    "ཁྱིམ་ཚང་སོ་སོའི་གནས་ཚུལ་ཁྱེར་ནས་ཨ་མེས་དང་ཨ་ཕ་ལ་ལབ་པ་ཡིན་ལ།",
    "ངེད་ཚང་གི་བྱ་བར་སྐུལ་འདེད་གཏོང་མཁན་ཡང་ཨ་མའི་སྐད་ཆ་ཁོ་ན་ལགས།",
    "ངས་འདྲི་རྟགས་མང་བོ་ཞིག་བྲང་ཁར་དཔྱངས་ནས་ཞི་བར་གྱུར་བའི་བྱིས་དུས་ཀྱི་དགོད་སྒྲུང་སྐྱར་ཀློག་བྱས་མོད།",
    "མེ་འཁོར་གྱི་གད་རྒྱངས་གཅིག་གིས་ང་ལ་དྲན་སྐུལ་ཞིག་བྱས་པ་ལྟར།",
    "ད་གཟོད་ངས་བསེར་བུ་ཞིག་དང་ལྷན་དུ་དྲན་པ་ཕྱིར་བསྐུམས་ཏེ་དཔྲལ་བའི་གཉེར་མ་མགོ་སྐྲས་བཀབ་པ་ལག་པས་གཉའ་ལྟག་ཏུ་བྱིལ་བྱིལ་བྱེད་བཞིན་རི་ཆུང་གི་སྟེང་དུ་འགྲེང་ནས་བསྡད།",
    "ལུག་ཁྱུ་དང་ལུག་ཁྱུས་འཚང་ཁ་བརྒྱབ་པས་ཡིད་འོང་གི་ནེའུ་གསིང་ཧ་ཅང་དོག་པའི་ཡུལ་ལྗོངས་ཤིག་ཏུ་གྱུར་བ་དང་།",
    "ཤར་བྱངགི་མཚམས་ན་ཐག་ཉེ་ནས་རྒྱང་རིང་དུ་འཐེན་པའི་ལམ་ཕྲན་དེ་ཡང་ཡལ་ནས་རླངས་འཁོར་དང་སྦག་སྦག་འཁོར་ལོས་སྣུམ་ནག་གི་གཞུང་ལམ་ཞིག་རྗེས་སུ་སྐྱུར་བཞིན་ཡོད།",
    "ངེད་ཚང་གི་མཚེར་ས་ན་མེ་འཁོར་ས་ཚུགས་ཤིག་བསྐྲུན་ཡོད་པས།",
    "ཁྱོད་ཀྱིས་སྤྲིན་དཀར་གྱི་དབུགས་རྒྱུན་འཁྲིལ་བའི་གངས་རི་དང་ནམ་མཁར་བལྟས་ཏེ་གནའ་བོའི་རྐང་གླིང་དེ་འབུད་དུས།",
    "མེ་ཏོག་གི་འགྲམ་པར་འཚེར་བའི་སྨེ་བ་དྭངས་མོ།",
    "ཁྱོད་ཀྱི་ཕྱིར་དུ་གྲང་ངར་ཕྱོགས་བཞི་ནས་འོང་།",
    "ཐོག་མའི་བརྩེ་དུང་དོན་མེད་དུ་གྱུར་བའི་མཚན་མོ་དེར་ཡང་ཁོ་མོས་ཁྱོད་ཉིད་སེམས་ཁོང་དུ་བཅུག་ནས་གྲོང་བརྡལ་ཆུང་ཆུང་གི་བར་སྣང་དུ་སྐྱོ་བའི་སྐར་ཚོམ་སྒྲུག་ཞོར་ཕྱིར་རང་ཁྱིམ་དུ་ལོག་མྱོང་།",
    "ང་ཚོའི་མེ་དཔུང་གི་མཚན་མོ་རེ་རེ།",
    "ད་ཅི་ངར་སྐད་སྒྲོག་མཁན་གྲོགས་པོ་ཚོ་རང་རང་གི་དམིགས་སར་ཆས་དུས།",
    "གྲིབ་མ་སྣ་ཚོགས་ཀྱི་གཡོ་འགུལ་ལས་ཁྱོད་ཀྱིས་གནས་ལུགས་ཟབ་མོ་ཁ་ཤས་རྙེད་བྱུང་ངམ།",
    "ཕག་མོ་དོན་གྲུབ།",
    "འདི་ནི་སྤྱན་རས་གཟིགས་ཕྱག་ན་པདྨོའི་གདུལ་བྱའི་ཞིང་ཁམས།",
    "འཆད་རྩོད་རྩོམ་པའི་རླབས་ཕྲེང་གི་ཟེགས་མ་མཁའ་རུ་ཙེན་མྱོང་ཕྱིན།",
    "ཁ་སང་གི་མེས་པོ་རྣམས་ཀྱིས་བཞག་པའི་བགྲོད་ལམ་ནི།",
    "ལྟ་གདོད་མའི་སྐྱི་གཡའ་བའི་འཕག་འཚག་གི་ཁྲོད་དུ།",
    "རེ་ཞིག་ཕོག་ཐུག་ཚབས་ཆེན་ཤོར་བའི་བོད་འབངས་རྣམས་མག་མོག་གི་ལོ་ཟླ་དང་།",
    "ཇ་ཆང་འབའ་ཞིག་ཁོ་ན་གཉེར་བ་ཉ་མོ་དོལ་དུ་ཚུད་པའི་དཔེ།",
    "ར་མ་ལུག་གི་སྤྱོད་ལུགས་ངན་པ་ལ་ལུང་ཀུན་དུ་ཁྱབ་ན་ཡང་།",
    "ལྷག་བསམ་པད་མོ་ཅིག་ཅར་བཞད་དེ་གྲོགས་ཀྱི་དྭངས་མར་སྐྱེས་སུ་ཕུལ།",
    "ཁྱོད་ཀྱིས་མགོ་བོ་ཚུར་གི་འབྲས་བུ་ནི་རྔུལ་ཆུ་ཐིགས་པ་ཙམ་ལས་མ་།",
    "དུས་དེ་ནས་བཟུང་ཁྱོད་རང་འཇིག་བུ་ཕྲུག་ཆུང་ཆུང་ཞིག་ཀྱང་འདུགརྟེན་སྟེང་གི་བྱ་དངོས་ཡོད་ཚད་ལ་ཡིད་རྟོན་བྲལ།",
    "ཚང་མས་ཤེས་གསལ་ལྟར་ཞང་ཞུང་པས་བརྩམས་པའི་རཱ་མ་ཎའི་རྟོགས་བརྗོད་ནི་བརྗོད་བྱའི་དོན་གྱིས་ཕྱུག་ཅིང་རྗོད་བྱེད་ཚིག་གིས་མཛེས་པར་སྤྱད་པའི་བོད་ཀྱི་གནའ་རྩོམ་གྲགས་ཅན་ཞིག་ཡིན་ནའང་བརྡ་རྙིང་མང་བ་དང་།"
  ]
}