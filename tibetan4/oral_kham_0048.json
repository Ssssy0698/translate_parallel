    "ཨོཾ་རོ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི།",
    "རྣམ་རྟོག་ཐིམ་ཞིང་རང་རིག་པ།",
    "མཚམས་འདིར་དེའི་ཚེ་ལྷས་བྱིན་དང་ཤཱཀྱ་མིང་ཆེན་གཉིས་ཀ་དེ་ན་འདུག་པས་ཚེ་འཕོས་པ་ཅིར་འགྱུར་བཀའ་སྩལ་པ་ལ་ཡིད་མ་ཆེས་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེ་ལྟར་གསུངས་པ་བདེན་རྫུན་ཉམས་སད་པའི་ཕྱིར་ལྷས་བྱིན་གྱིས་ཤིང་ཐ་དད་པ་བརྒྱ་སྟོང་བྱེ་བ་དག་བཅད་དེ།",
    "དེའང་རང་བསྟོད་གཞན་སྨོད་མ་ཡིན་ཏེ།",
    "འདོད་ཚུལ་དེ་དག་དངོས་གནས་ཕྱི་རོལ་པ་ཁོང་རང་ཉིད་ཀྱི་ལྟ་ཚུལ་ཡིན་ནམ་ཡང་ན་དོགས་པ་ཁོང་ནས་བསླངས་པ་ཞིག་ཨེ་ཡིན་སྙམ་སྟེ།",
    "འདིའི་ཁྲོད་ཀྱི་མི་སྣ་དང་ས་མིང་ཐམས་ཅད་པ་ལིའི་ཡི་གེར་བྲིས་འདུག་པས།",
    "དེའི་དུས་སུ་ཤིང་སཱ་ལའི་སྡོང་པོ་དག་ནི་ཞིམ་མངར་གྱི་དྲི་མས་ཁེངས་ཤིང་མཛེས་སྡུག་ཡིད་དུ་འོང་བའི་མེ་ཏོག་སྣ་ཚོགས་ཀྱིས་བརྒྱན་འདུག།",
    "དེ་ཙ་ན་ཆེས་ཡ་མཚར་བའི་གནས་ཚུལ་ཞིག་བྱུང་བ་ནི།",
    "རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་དུས་ནམ་ཡིན་ཡང་ཐུགས་བསམ་བཞེས་ནས་བཞུགས་ཀྱིན་འདུག་པས།",
    "བཙོ་བརླག་མཁན་རྣམས་ཀྱིས་ནི་རྒྱུ་སྤོས་ལེགས་པའི་ཚོན་རྩི་དག་བེད་སྤྱད་དེ་གྱོན་ཆས་ལ་ཁ་སྒྱུར་བཞིན་ཐག་རྡང་དུ་དཔྱངས་ནས་སྐམ་སྲད་བྱེད་ཀྱིན་གདའ།",
    "དེ་ཙ་ན་རྒྱལ་སྲས་ཀྱིས་ཁ་ལོ་སྒྱུར་བ་ལ་སྨྲས་པ།",
    "གལ་སྲིད་སྐྱེ་བོ་ཚང་མས་གཏན་གྱི་བདེ་བ་དང་རང་དོན་ཉི་ཚེ་བའི་བདེ་བ་སོགས་སོ་སོར་ཤེས་ཤིང་ཁོང་དུ་ཆུད་པར་གྱུར་ན།",
    "འོན་ཀྱང་ཁོ་རང་འདི་ནས་འདུག་འདོད་ཡོད་ན་ཁོའི་ཆེད་དུ་གདན་གཅིག་བཏིང་ན་འཐུས།",
    "གལ་ཏེ་འདུག་འདོད་མེད་ན་ཡར་ལངས་ནས་བསྡད་ཀྱང་མི་ཆོག་པ་མེད།",
    "སྦྲུམ་རྒྱལ་དེས་སྐུ་ཉིད་ལ་གནོད་ཅིང་འཚེ་བར་བྱེད་མི་ཡོང་ངམ་སྙམ་ན་ང་ལ་ཏོག་ཙམ་ཞེད་སྣང་འདུག།",
    "ད་ལྟ་ཁྱེད་ཀྱིས་ཟས་སློང་ནས་བྱོན་ན་ཁྱེད་ལ་འཚམ་པོ་དང་རན་པོ་འདུག་གམ།",
    "ཁྱེད་ཀྱི་ཡིད་དུ་ཕངས་ཤིང་རྩ་ཆེ་བའི་མནའ་མ་དེ་དང་མཁའ་འགྲོ་མ་འདི་ཚོ་ལས་སུ་མཛེས་ཤིང་ཡིད་དུ་འོང་བ་འདུག།",
    "དེར་བརྟེན་ཁྱེད་རང་ཡབ་ཆེན་གྱི་མདུན་དུ་ཕྱིན་ནས་འདི་ལྟར་ཞུས།",
    "ཐ་ན་ཁྱེད་ཀྱིས་གྲིབ་ནག་ཙམ་གྱིས་ཀྱང་ང་ལ་ཅི་འདྲའི་བདེ་བ་ཞིག་སྟེར་གྱིན་འདུག་ཅེས་ཞུས།",
    "འོན་ཀྱང་ཁོང་ཡང་ཁྱེད་ཀྱིས་འདིར་ཁྲིད་ནས་རབ་ཏུ་བྱུང་བར་མཛད་འདུག་ན།",
    "བདག་ལ་དེ་དག་ཤེས་འདོད་འདུགཅེས་དང་བ་དང་དོ་སྣང་ཆེན་པོས་དེ་ལྟར་དྲིས་པ་ལ།",
    "ངས་ཁོང་ལ་ཅི་ཡང་བྱེད་ཐུབ་ཀྱི་མི་འདུག།",
    "གང་ལྟར་དུར་ཁྲོད་དེར་མི་གཅིག་ཀྱང་མེད་པས་ཁོ་རང་སྐྲག་ཐག་ཆོད་དེ་ལུས་ཀྱི་སྤུ་གཟེངས་ཤིང་།",
    "དེའི་དཀྱིལ་དུ་ཆེས་ལྟ་ན་སྡུག་ཅིང་བཞིན་རས་ལེགས་པའི་སྐྱེས་བུ་ཞིག་འོད་ཆེམས་ཆེམས་ངང་རང་ཉིད་ཀྱི་ཕྱོགས་སུ་བྱོན་ཏེ།",
    "ཁོ་རང་རང་ཉིད་ཀྱི་མིག་རྣ་སོགས་ལ་ཡང་ཡིད་མི་ཆེས་པ་ཞིག་བྱས།",
    "ང་ནི་མདང་དགོང་མཚན་གང་པོར་གཉིད་མ་ཁུག་ཅིང་ཟས་ཀྱང་མ་རག་པར་བརྟེན་ངའི་ལུས་ཟུངས་ནི་ཧ་ཅང་ཉམ་ཐག་པར་གྱུར་འདུག།",
    "ཡ་མས་ང་ལ་ཚུར་ཤོག་ཟེར་གྱིན་འདུག་སྙམ་ནས་མྱུར་སྟབས་ཀྱིས་གཙང་པོར་བརྒལ་བར།",
    "ངའི་ཆུང་མ་ལ་བུ་ཞིག་བཙས་འདུག།",
    "རྒྱལ་པོ་ཚེན་པོས་དམག་མི་འབོར་ཆེན་ཕབ་སྟེ་ངེད་གཉིས་ཀྱི་བུ་གསོད་རྒྱུའི་གྲ་སྒྲིག་བྱེད་ཀྱི་འདུག།",
    "དེང་སྐབས་ངེད་གཉིས་ཀྱི་བུ་ཡི་བྱ་སྤྱོད་ཡོད་ཚད་རྩ་འགྱུར་དུ་ཕྱིན་ཏེ་ཆེས་འཇིགས་སུ་རུང་བ་ཞིག་ཏུ་གྱུར་འདུག་པས།",
    "དགེ་སྦྱོང་འདི་གཏན་ནས་འཛིན་ཐུབ་པ་མི་འདུག་སྙམ་སྟེ་སྐད་ཤུགས་ཆེན་པོའི་སྒོ་ནས་སྨྲས་པ་ཝེ།",
    "མ་ཟད་ང་ལའང་ནམ་རྒྱུན་ལས་ལུས་སྟོབས་ཞན་པའི་ཚོར་སྣང་ནི་མི་འདུག།",
    "འོན་ཀྱང་ངའི་རྒྱལ་ཕྲན་གྱི་མངའ་ཁོངས་འདི་ན་མིང་ལ་སོར་འཕྲེང་ཅན་ཟེར་བ་ཆེས་འཇིགས་སུ་རུང་བའི་ཇག་པ་ཞིག་འདུག་པས་ངེད་ཅག་དེ་འཇུ་བཟུང་བྱེད་དུ་འགྲོ་བ་ཡིན།",
    "ང་རང་འདི་ལྟར་ཁྱིམ་དུ་བསྡད་ན་སངས་རྒྱུས་བཅོམ་ལྡན་འདས་ལ་རྒྱུན་པར་མཇལ་མི་ཐུབ་པས།",
    "གཞོན་ནུ་ཐ་ཀ་ལི་ལ་ཧ་ལས་དགོས་པའི་བློ་ཕམ་ཞིག་སྐྱེ་རུ་མ་བཅུག་ན་ཁོས་དོན་དེ་རྟོགས་ཐུབ་པ་མི་འདུག་གོ་སྙམ་དུ་དགོངས་སོ།",
    "ད་ལན་ངེས་པར་དུ་ང་རང་གཅིག་པུར་འགྲོ་དགོས།",
    "དེ་ཙ་ན་གཞོན་ནུ་ཙ་ཀ་ལིའི་སེམས་སུ།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་མིག་རྣ་ལ་ཡང་ཡིད་མ་ཆེས་པར་ཡུད་ཙམ་རིང་ངག་ནས་ཚིག་གཅིག་ཀྱང་མ་ཐོན་པར་ཧད་དེ་ལུས་སོ།",
    "ཞི་བདེ་བག་ཕེབས་དང་འོད་སྟོང་གསལ་བའི་ངང་བདེན་པའི་གནས་ལུགས་དང་ཤེས་རབ་ཀྱི་གཟི་དཔལ་ལ་ལོངས་སུ་སྤྱོད་ནས་བཞུགས་འདུག་གོ།",
    "ཁོང་རྣམ་གཉིས་ལས་གུས་བཀུར་ཞུ་སའི་གཙོ་བོ་དེ་སུ་ཡིན་ནམ་སྙམ་ཙ་ན།",
    "རང་ཉིད་ཀྱི་སྲས་མ་སྐྱེས་དགྲ་ཡིས་ཁོང་ཡ་ང་བའི་མནར་གཅོད་འོག་དུས་མིན་གྱི་འཆི་ལམ་ལ་བརྫངས་སོ།",
    "རང་ཉིད་ས་ལ་འདུག་སྐབས་བག་ཡོད་ཚུལ་མཐུན་གྱི་སྒོ་ནས་འདུག་དགོས་ཤིང་།",
    "ཚེ་རབས་སྔོན་མར་བསགས་པའི་ལས་ཀྱི་རྣམ་སྨིན་རྣམས་ལོངས་སུ་སྤྱོད་རྐྱང་བྱེད་ཀྱིན་འདུག་དེས་ན་འདི་ཁ་ཟས་རྙིང་པ་ཐོས་པ་དང་གཅིག་མཚུངས་མ་ཡིན་ནམ།",
