    "དེ་ནས་རང་གི་ལྷའི་སྔགས་བྱིན་ལ།",
    "དེ་ནས་ཁྱོད་ཀྱིས་གཞན་ཕྱག་རྒྱལ་མི་མཁས་པ་གང་ལ་ཡང་ཕྱག་རྒྱ་གཅིག་ཀྱང་སྟོན་པར་མ་བྱེད་ཅིག།",
    "རྒྱུ་དེས་ཁྱོད་ཀྱང་ངན་འགྲོར་འགྲོ་བར་འགྱུར་རོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "སྒེག་མོ་ལ་སོགས་པས་ཡང་དག་པར་མཆོད་ལ་ཕྱག་བྱ་སྟེ།",
    "དང་པོར་རེ་ཞིག་བདག་མེད་པ་ལ་ལྷག་པར་མོས་པས་ནང་གི་ཁྲུས་བྱས་ནས།",
    "ལག་པའི་སོར་མོ་དག་རྩེ་མོར་བསམས་ནས།",
    "དེ་ནས་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་ཕྱེད་དུ་འདུག་ལ།",
    "མགོ་བོའི་སྟེང་དུ་མཛུབ་མོ་ལྕགས་ཀྱུའི་ཚུལ་དུ་བཞག་པ་ནི།",
    "རྡོ་རྗེ་ཐལ་མོའི་མཐེ་བོང་གཉིས་བརྐྱང་ལ་མཛུབ་མོ་གཉིས་མཆེ་བ་ལྟ་བུར་བྱས་པ་ནི་རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་གཉིས་ཀྱི་རྩེ་མོ་སྦྱར་ཏེ་བཟློག་ནས་སྤྱི་བོར་བཞག་སྟེ་རྡོ་རྗེ་གཙུག་ཏོར་གྱི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་མཐེ་བོང་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་དུ་བྱས་ཏེ།",
