    "འདི་གུས་པ་ཆེ་བ་གཅིག་འདུག་པས།",
    "ཡིད་ཆེས་མང་པོ་འདུག་པས།",
    "ཁ་གཅིག་བླུན་དད་ཀྱིས་ཆོག་ཟེར་བ་འདུག་སྟེ།",
    "སྔོན་པ་གོར་བེ་རོ་ཙ་ན་དང་།",
    "ཤེས་བྱ་དངོས་པོའི་འདུག་ཚུལ་གཏན་ལ་འབེབས་ཤིང་།",
    "བེ་རོ་ཙ་ན་ལ་སོགས་ཀྱིས།",
    "བེ་རོ་ཙ་ན་ཀ་ཅོག་སོགས།",
    "གཟུགས་ཀྱི་ཡོངས་སུབཟུང་བ་མ་མཆིས་པ་གང་ལགས་བ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་གཟུགས་མ་ལགས།",
    "ཚོར་བང་ཡོད་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཚོར་བ་མ་ལགས།",
    "འདུཤེསཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོད་པའི་སླད་དུ་འདུ་ཤེས་མ་ལགས།",
    "ཡེངས་སུ་བཟུང་བར་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིིན་གྱིས་སྟེང་བའི་སླད་ད་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "རྣ་ང་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞན་གྱིས་སྡོང་པའི་སླད་དུ་རྣ་བ་མ་ལགས།",
    "སྣའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སླད་དུ་སྷ་བརྦོབམ་ལགས།",
    "ལྕི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སྨད་དུ་ལྕེ་མ་ལགས།",
    "ལུས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ལུས་པ་ལགས།",
    "ཡིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཡིད་མ་ལགས།",
    "གཟུགས་ཀྱི་ཡོངས་སུ་བཟུད་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་གཟུགས་ར་ལགས།",
    "དྲའི་ཡེངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པའི་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དྲི་ར་ལགས།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྣ་བའི་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "སྣའི་རྣམ་པར་ཤེས་པའི་ཡོངས་སུབཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྰའི་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "ལྕེའི་རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ལྕེའི་རྣམ་པར་ཤེས་པ་ལགས།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞན་གྱིས་སྟོང་པའི་སླད་དུ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "སའི་ཁམས་ཀྱ་ཡེངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའིསླད་དུ་སའི་ཁམས་མ་ལགས།",
    "ཆུའི་ཁམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལག་པ་དེ་ཡང་རང་བཞིིན་གྱིས་སྟོང་པའི་སླད་དུ་ཆུའི་ཁམས་མ་ལགས།",
    "མིའི་ཁམས་ཀྱི་ཡོངས་སུ་། བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་མེའི་ཁམས་མལགས།",
    "ནམ་མཁའི་ཁམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སླད་དུ་ནམ་མཁའི་ཁམས་མ་ལགས།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིིན་གྱིས་སྟོང་པའི་སླད་དུ་རྣམ་པར་ཤེས་པའི་ཁམས་མ་ལགས།",
    "མ་རིག་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྡོང་པའི་སླད་དུ་མ་རིག་པ་མ་ལགའདུ་བྱེད་ནི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་སྟེ།",
    "རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་བའི་སླད་དུ་རྣམ་པར་ཤེས་པ་མ་ལགས།",
    "མིང་དང་གཟུགས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟེང་པའི་སླད་དུ་མང་དང་གཟུགས་མ་ལས།",
    "སྐྱ་མཆེ་དྲུག་སྐྱེ་མཆེད་དྲུག་ག་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྐྱེ་མཆེད་དྲུག་མ་ལགས།",
    "ཆོར་བའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་ད་ཚོར་བ་མ་ལགས།",
    "སྲེད་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྲེད་པ་མ་ལགས།",
    "ལེན་པའི་ཡེངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ལེན་པ་མ་ལགསཾ།",
    "སྲིད་པ་ནི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་སྟེཁ་། སྲིད་པའི་ཡོངས་སུ་བཟུད་བ་མ་མཆིས་པ་གང་ལ་གས་པའི་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་སྲིད་པ་མ་ལགས།",
    "སྐྱེ་བའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་བཟུང་པའི་སླད་དུ་སྐྱེ་བ་མ་ལག།",
    "རྒ་ཤིའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྒ་ཤི་མཾ་ལགས་སྦྱིན་པའྀ་ཕྱི་རོལ་ཏུ་ཕྱིན་པ་ནི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་སྟེ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་བཟོད་པའི་པ་རོལ་ཏུ་ཕྱིན་པ་མ་ལགས།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གྲང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟེང་པའི་སླད་དུ།",
    "བསཾ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱན་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ།",
    "ནང་སྟོང་པ་ཉིད་ནི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟེང་པའི་སླད་དུ་ནང་སྟོང་པ་ཉིད་མ་ལགས།",
    "ཕྱི་སྟོང་པ་ཉིད་ནི་ཡོངས་སུ་བཟུང་བ་མ་མཆྀས་པ་སྟེ་། ཕྱི་སྟོང་པ་ཉད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཕྱི་སྟོང་པ་ཉིད་མ་ལགས།",
    "ཕྱི་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དཁ་མ་མཆིས་པ་སྟེ།",
    "ནང་སྟོང་པ་ཉིད་ཀྱ་ཡངས་སུ་བབྲུད་སུ་སྟེ་རང་བཞིན་གྱིས་དེ་ཡང་དུ་ཕྱི་སླདད་ལགས་རང་བཞིན་གྱིས་སྟོང་པ་མཆིས་རང་བཞིན་གྱིས་མཆིས་པ་སྟེང་པ་སྟོང་པ་སྟོང་པ་ཡོངས་སུ་འདས་པ་རང་བཞིན་གྱིས་ཉིད་མ་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་སུ་མ་བཟུང་ཉིད་ཀྱི་ནི་མཆིས་མཐའ་ལས་འདས་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་མ་ལགས་ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པཉིད་ནི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་སྟེ།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལུགས་པ་དེ་ཡང་རང་བཞྲིན་གྱིས་སྟོད་པའི་སླད་དུ།",
    "དམིགས་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུས་དམགས་པ་སྟེང་པ་ཉིད་མ་ལག།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་མ་ལགས།",
    "དངོས་པོ་མེད་པའི་ངེ་བཉད་སེང་པ་ཉིད་ཀྱི་ཡོངས་སུ་བཟུང་བ་མམཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོད་པའི་སླད་དུ་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མ་ལགས་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ནི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་སྟེ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་མ་ལགས།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞན་གྱིས་སྟོང་པའི་སླད་དུ་ཡང་དག་པར་སྤོང་བ་རྣམས་མ་ལགས།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་མ་ལགས།",
    "འཕགས་པའིལམ་ཡན་ལག་བརྒྱད་པ་དྲི་ཡོངས་སུ་བཟུང་བ་མ་མཆིསཔ་སྟེ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱི་སྟོང་པའི་སླད་དུ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་རྣམས་མ་ལགས།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོད་པའི་སླད་དུ་འཕགས་པའྀ་བདེན་པ་རྣམས་མ་ལགས།",
    "བསམ་གཏན་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་བསམ་གཏན་རྣམས་མ་ལགས།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་མ་ལགས།",
    "མཐར་གྱིས་གནས་པའི་སྙེམས་པར་འཇུག་པ་དགུའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དག་མལགས།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟེང་པའི་སླད་དུ་ཏིང་ངེ་འཛིན་རྣམས་མ་ལགས།",
    "གཟུངས་ཀྱིསྒོ་རྣམས་ཀྱི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟེང་པའི་སླད་དུ་གཟུངས་ཀྱི་སྒོ་རྣམས་མ་ལགས།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུའ་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་མ་ལགས།",
