    "གཞལ་བྱའི་གནས་དང་པོ་གཉིས་ལ་དཔྱོད་པའི་སྐབས་སུ་ཁས་བླངས་དང་རང་ཚིག་འགལ་བ་ཙམ་གྱིས་འགལ་བའི་གོ་མི་ཆོད་པ་དང་།",
    "གཞན་ཡང་རང་ལུགས་ཀྱི་འཇོག་མཚམས་ནི་མ་དཔྱད་པ་འཇིག་རྟེན་གྲགས་པ་དང་མཐུན་ལ།",
    "གཟུང་ཡུལ་དུ་མ་ཟད་འཇུག་ཡུལ་ཀྱང་རང་མཚན་ཁོ་ནར་ངེས་པ་དང་།",
    "དངོས་པོ་ལ་རྫས་དང་རང་མཚན་གྱིས་ཁྱབ་ན་གཞུང་ལས་དངོས་པོ་ལ་ཀུན་རྫོབ་དང་དོན་དམ་གཉིས་སུ་ཕྱེ་བས་མི་འཐད།",
    "གཅིག་དུས་སུ་ཅིག་ཤོས་ཞིག་པའམ་མ་སྐྱེས་པའི་ཕྱིར།",
    "འདི་ཡང་རང་མཚན་དང་དོན་དམ་པའི་བདེན་པར་ཁས་ལེན་ཞིང་རང་རྒྱལ་གྱི་ལྟ་བ་ལས་ལྷག་པའི་ལྟ་བ་ལུགས་འདི་ལ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་ཟེར།",
    "དེ་འདྲ་དེ་མངོན་སུམ་གཞན་ངེས་རྣམས་ལ་མེད་ཀྱང་རང་ངེས་ལ་ཡོད་པས་དེས་གོ་ཆོད་པ་ཡིན་ནོ།",
    "ཤེས་པ་དེ་ཡང་རང་གཞན་གྱི་རྒྱུད་གཉིས་སུ་ངེས་སོ།",
    "དེ་ཉམས་སུ་མྱོང་བའི་འཛིན་རྣམ་དང་རང་རིག་ཚད་འབྲས་སུ་བཞག་པ་ནི།",
    "རང་རྒྱུད་པ་ལྟར་ན་ཉན་ཐོས་དང་རང་རྒྱལ་ལ་ཡང་ཡོད་ལ།",
    "སེལ་ངོའི་ཤེས་བྱ་མཐའ་དག་ནི་སྐབས་འདིར་ཡང་ལྟོས་གྲུབ་དང་རང་སྟོང་དུ་ཁས་བླངས་པའི་ཕྱིར།",
    "གཉིས་པོ་གང་གཞལ་བྱར་བྱས་ཀྱང་རང་རིག་པ་འབྲས་བུར་འཇོག་པ་ནི་གོ་རིམ་བཞིན་དུ་རྣམ་བདེན་རྫུན་གྱི་ལུགས་དང་།",
    "བདག་ནི་འདི་ལྟ་བུ་ཞིག་ན་འདུག་འདུག་ག་གོ།",
    "མྱེ་ཏོག་ཨུད་པ་ལ་དམར་པོའི་འདབ་མའི་ཁ་དོག་ལྟ་བུར་འདུག་ཅིང་ཤིན་ཏུ་ཡངས་པས་ལྗགས་ཤིན་ཏུ་ཡངས་ཤིང་སྲབ་པའོ།",
    "ཕྱལ་ཕྱམ་མེར་འདུག་པ་ཡིན།",
    "སྤྱན་དཀར་ནག་འབྱེས་ཤིང་པད་རྨོའི་འདབ་མ་ལྟར་འདུག་པ་ཡིན།",
    "འདི་ལྟ་སྟེ་དཔེར་ན་ཆུའི་ཆུ་བུར་གསོག་ཏུ་འདུག་པ་སྐྱེ་ཞིང་།",
    "དེ་ནི་རྟག་པར་ཡང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "གཞན་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ལ་ཡང་དག་པར་སྐྲུལ་བ་ཡིན།",
    "རང་བཞིན་སྟོང་པ་ཉིད་དེ་ཡང་སྔ་ནས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཕྱིན་ཆད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་བར་དུ་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་དེ།",
    "དེ་ནམ་ཡང་རང་བཞིན་གྱིས་མྱི་སྟོང་པ་མ་ཡིན་ནོ།",
    "ཞེས་བགྱི་བར་རང་བཞིན་སྟོང་པ་ཉིད་རྣམ་པར་འཁྲུག་པར་མྱི་བགྱིད་ཀྱི་གཟུགས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ད་དོ།",
    "ཚོར་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འདུ་ཤེས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འདུ་བྱེད་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ད་དོ།",
    "མྱིག་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ད་དོ།",
    "རྣ་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྣ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལུས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཡིད་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "གཟུགས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ད་དོ།",
    "སྒྲ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དྲི་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རོ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ད་དོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཆུའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མྱེའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ནམ་མཁའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མ་རིག་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འདུ་བྱེད་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ད་དོ།",
    "མྱིང་དང་གཟུགས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྐྱེ་མཆེད་དྲུག་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཚོར་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྲེད་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལེན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉད་དོ།",
    "སྲིད་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྐྱེ་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྒ་ཤི་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉད་དོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
