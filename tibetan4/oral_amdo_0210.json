    "རང་གི་མཛད་པ་ཐམས་ཅད་ཀྱང་བསྟན་པའི་ཞབས་ཏོག་ཏུ་བསྡུར།",
    "གཅོད་ཡུལ་གྱི་མ་ཁྲིད་ཆེན་མོ།",
    "འཕྲལ་ཡོན་བདག་ཕོ་མོ་རྣམས་ཀྱིས་ཉིན་རེ་བཞིན་བསྙེན་བཀུར་ཞུ་མཁན་གྲངས་མེད་འོང་།",
    "དེ་ལོས་ཡོད་དེ་མེད་ན་ངས་འདི་ཙམ་ག་ན་འཇུག་གསུང་གི་འདུག་གསུང་བ་ལ་སོགས་པའི་ཆེ་བརྗོད་མང་དུ་མཛད་ཅིང་ཤིན་དུ་གུས་པར་ཡང་གནང་།",
    "ཕེབས་པར་བརྩམས་པའི་ཚེ་རྐྱེན་འགའ་ཞིག་གིས་བཤོལ་དགོས་བྱུང་།",
    "སྔར་ལས་སུ་མི་རུང་བ་དག་ཀྱང་ཁོང་གི་ཕྱག་ཕྱིར་བཏུད་ནས་ཉོན་མོངས་པ་ཡིད་ལ་འགྱུ་མ་མྱོང་བ་སྙམ་བྱེད་པའི་བརྟུལ་ཞུགས་བཟུང་ནས་བྱུང་བས་ཁོང་གིས་འདི་ཡང་འདི་ཙམ་དུ་ཐུལ་འདུག་བསམ་ནས་ཁོང་ལ་དད་པ་ཆེན་པོ་སྐྱེས་གསུང་།",
    "ལ་སྟོད་བྱང་ནས་ལྷོར་ཕེབས་པའི་ལམ་དུ་རྗེ་བཙུན་མ་སྒྲོལ་མའི་བྱིན་བརླབས་ཀྱི་མཚན་མ་བཟང་པོའང་གཟིགས།",
    "དེ་ནས་ལ་སྟོད་སྒང་དཀར་དུ་ཕེབས་ནས་ཞག་ཁ་ཅིག་གི་བར་དུ་བདག་པོ་ལྷ་བཙན་སྐྱབས་པ་ཡབ་སྲས་དང་མ་མཇལ།",
    "དེ་ནས་བདག་པོ་ལྷ་བཙན་སྐྱབས་པ་བ་རང་གིས་ལྡུམ་ར་ཞིག་འདུག་པར་སྦྲ་ཆ་ཐེར་དཀར་ནག་ཕུབ་ནས་ཕེབས་བྱོན་པར་མཇལ།",
    "ཁོང་གི་དྲུག་སྐོར་དང་སྐྱེ་བོ་རྣམས་ལྟད་མོ་བལྟས་ནས་རྩེ་ཐང་པ་དེ་པ་ཞུད་པོ་གཅིག་དང་གདའ་སྟེ།",
    "ཡོན་མཆོད་ཤིན་དུ་འཕྲོད་པར་བྱུང་ནས་ཐུགས་བདེ་འབོལ་གྱིས་སོང་གསུང་།",
    "བདག་སློབ་འབངས་རྣམས་ཀྱང་ན་ནིང་ནས་ཕེབས་པར་རེ་བ་ལ།",
    "གུ་ཧྱ་ཨར་ཐ་བྷ་རེ་ཎ་ཞབས་དྲུང་དུ་སྤྱན་འདྲེན་པ་ལ་བཏང་བ་ལགས།",
    "ལྷོ་བྱང་གི་རྒྱལ་པོ་གཉིས་དང་བཅས་པ་ཐམས་ཅད་ཀྱིས་ཐུགས་རྩེ་གཅིག་ཏུ་ཞལ་ཏའང་གནང་།",
    "གལ་ཏེ་ད་ལན་མ་ཕེབས་ན་དབུས་གཙང་གི་རྒྱལ་པོ་མི་ཆེ་བ་བདག་ཅག་སློབ་འབངས་ཐམས་ཅད་ཡི་འཆད།",
    "པཎ་ཆེན་བོད་དུ་ཕེབས་པའི་མཚན་ལྟས་བཟང་པོའང་གཟིགས།",
    "ཡོན་མཆོད་འགྱེས་ཁར་ཁོང་གིས་ཐུགས་ལ་ལེགས་པར་བཏགས་པའི་སྟོབས་ཀྱིས་སྤྱན་ཆབ་མང་དུ་བྱོན།",
    "དེ་ནས་ལ་སྟོད་བྱང་གི་ངམ་རིང་དུ་ཡུན་རིང་པོར་བཞུགས།",
    "ས་དགའ་བ་མ་ལུ་ཀན་འདུག་གསུང་པ་ལ་སོགས་པའི་གསུང་གི་བསྟོད་པ་ཆེན་པོའང་མཛད།",
    "ཁྱོད་གཟིགས་རྒྱ་ཆེ་ཡང་བཙུན་ཆེན་ཟེར་བའི་ཐ་སྙད་དེ་རང་གང་ན་ཡོད་ན་གསུང་བས།",
    "ཟེར་བ་འདུག་པ་ཞུས་པས་ཅི་ཟེར་ཡང་དེ་འདྲས་ཐོན་བྱུང་དེ་ཡི་གེར་བྲིས་གསུང་པ་དང་།",
    "ཁྱད་པར་རྗེ་བཙུན་རེད་མདའ་པའི་རྩོད་ལན་ལ་དྲི་བ་མང་དུ་མཛད་པས་དེའི་ལན་རྣམས་ཀྱང་ལྷུག་པར་གསོལ།",
    "ཁོང་གི་གསུང་ནས་སྒོམ་ཆེན་པ་རྣམས་སེམས་ཁ་དོག་ཏུ་གྲུབ་བམ་དབྱིབས་སུ་གྲུབ་རྩད་གཅོད་པ་འདི་ནོར་བ་ཡིན་ཟེར།",
    "རེད་ཕུ་བ་དཔལ་ལེགས་པ་ཞེས་བྱ་བས་གསོལ་བ་བཏབ་ནས།",
    "བདེ་མཆོག་བཅུ་གསུམ་མའི་མཆོད་ཆོག་དང་སྤྱན་རས་གཟིགས་ཀྱི་བསྟོད་པ་ཙརཔ་ཊིས་མཛད་པ་གཉིས་ཀྱི་འགྱུར་ཡང་མཛད།",
    "དེ་ནས་ཟླ་བ་གཅིག་ཙམ་སོང་བའི་ཚེ་གོང་མ་ཆེན་པོ་ཐུགས་རང་བཞིན་དུ་མི་གནས་པའི་རྣམ་པར་འགྱུར་བ་ལ་རྟེན།",
    "དེ་ནས་ཟླ་བ་གཅིག་ཙམ་སོང་བ་དང་།",
    "ཁ་ཅིག་ལ་ཕག་མོའི་རྫོགས་རིམ་དེ་གསུང་གི་འདུག་པ་གསན་པས།",
    "ཀུ་མཱ་ར་ཤྲཱི་ལ་འདི་མིན་པ་ཞིག་དགོས་གསུང་ཟུར་དུ་གསན་ན་བདེ་མཆོག་རིམ་ལྔ་ལྟ་བུ་ཅིག་འོང་བ་མ་ལགས་སམ་ཞུས་པས་དེའི་ཚོད་དུ་འདུག་སྟེ་དེ་རེས་བུད་མེད་དང་སྣ་ཚོགས་ཡོད་བ་ཅིག་ལ་ཞུས།",
    "ཕེབས་ཁའི་ཞལ་ཏར་སོང་བས་བཟློག་པར་མ་ཕོད་དེ།",
    "ཀ་དལ་དམ་ཁ་ཀ་ཤིག་གི་གནང་བྱིན་བྱུང་བས་ཐུགས་ལྷག་པར་བདེ་བས་སྣེའུ་གདོང་ནས་ཇི་ཙམ་བཀའ་ལུང་གནང་ཡང་དུས་འཁོར་སོགས་མ་ཕུལ་ལོ།",
    "གསང་སྒྲུབ་ཁྲོས་མ་ནག་མོ།",
    "མགོན་པོ་གྲི་གུག་གི་རྗེས་གནང་གསན་ཞིང་།",
    "ལག་ཁྲིད་བཅུ་དྲུག་གི་ཁྲིད་དང་གདམས་པ་ཤིན་དུ་མང་བ་དང་།",
    "སྣུམ་བཅོས་ཞུས་པ་ཙམ་གྱིས་གསེར་མ་ཇེ་མཐོར་སོང་།",
    "དགོངས་པའི་ཕྱི་ནུབ་མདང་གི་ཤུལ་དེ་ཁ་ན་སྐྱོ་བ་ཅིག་ནང་ན་བཞུགས་འདུག་པ་འཐེན་མཁན་མེད་པར་མདང་གི་ལམ་དེ་ཉིད་ནས་ཚེགས་མེད་དུ་དོང་ཁར་ཐོན་པ་ཅིག་རྨིས།",
    "འོལ་བ་ཇོ་སྲས་ཀྱི་ཁྲིད་ཡིག་གི་སྟེང་ནས་ཁྲིད།",
    "འབུལ་བ་དང་ཞབས་ཏོག་གིས་མཉེས་པར་མཛད།",
    "ཕྱིས་ཀྱང་མ་གཤེགས་བར་དུ་ལོ་རེ་བཞིན་འབུལ་བ་ཅི་འབྱོར་རེ་མ་ཆག་པར་འཁྱོལ་བས་ཐུགས་ཀྱང་ཤིན་དུ་དགྱེས་པར་བྱུང་བ་ཡིན།",
    "སྐུ་མདུན་དུ་བདག་གིས་སླེབ་པ་ལ་བཀུར་སྟི་རྒྱ་ཆེན་པོ་དང་།",
    "བདག་གིས་ཞིང་འདི་ཞུས་ན།",
    "ཕྱི་དུས་ཤིག་གི་ཚེ་རྐྱང་ཆེན་ནས་ངེད་ཐང་སྐུ་ཁ་ཡར་ཅིག་བཞེངས་ཤིང་ཡོད་པས་ཁྱེད་ཀྱིས་གསེར་ཤོག་ཁ་ཡར་ཅིག་བསྒྲུབས་ལ་བསྐུར་གསུང་བ་བྱུང་བས་ཐུགས་བག་ཕེབས་པར་གནང་བ་ཡིན་གསུང་།",
    "ཞེ་བས་སློབ་དཔོན་གྱི་ཕྱོགས་སུ་གནོད་པ་སྐྱེལ་བར་སོང་འདུག་གསུང་ནས་ཐུགས་འགྱོད་ཆེན་པོའང་མཛད།",
    "དེ་མི་ལེགས་པ་ཞིག་བྱས་འདུག་པས་ཉེ་གནས་འབབས་པ་ཡིན་གསུང་ནས་མི་གཏང་བའི་ནུབ་མོ།",
    "སློབ་དཔོན་དང་ཉེ་གནས་གཉིས་ཀྱིས་མཁན་སློབ་བྱས་ནས་བསྙེན་རྫོགས་གནང་གི་ཡོད་པ་ལ།",
    "ཆོ་གའི་འཕྲོས་ལུས་པ་ཞིག་རྨིས་པས་དེ་ལེགས་པ་ལ་བྱ་བ་དེ་མི་འགྲུབ་པ་ཡིན་ནམ་དགོངས་པའི་ཚེ་བར་པ་དེ་ན་རེ།",
    "ཕྱིས་ལྗང་གི་ཕུར་བཞུགས་པའི་ཚེ་བན་མོ་རྒན་མོ་ལོངས་སྤྱོད་ཀྱིས་འབྱོར་པས་དབེན་པ་ཞིག་འདུག་པ་དེ་ནང་དུ་བོས་ནས་བསྙེན་བཀུར་བཟང་པོ་བཤམས།",
    "བྱ་བ་ཐམས་ཅད་ཀྱང་བྱིན་བརླབས་ཁོ་ན་ལ་རེ་བ་ཡིན་ཞེས་གསུང་སྟེ།",
    "རྩིས་ལ་འཁྲུལ་སེལ་ལྟ་བུ་ཅིག་གིས་མཚོན་པ་ཡིན།",
    "ཐང་སག་ཏུ་མ་ཕེབས་གོང་གི་ཡོན་ཏན་ཐམས་ཅད་ཐོས་པ་གཙོ་བོར་གྱུར་པ་ཡིན།",
    "དེ་ནས་བསམ་བྱང་གི་ཤེས་རབ་ཆེན་པོ་འཁྲུངས་ནས་ལེགས་པར་དཔྱོད་པ་ལ་ཞུགས་ནས་གཞན་ཟེར་གྱིས་རྗེས་ཟློས་མི་མཛད་པ་དེ་བྱུང་།",
    "ང་ལ་ཤེ་མོ་ཡོད་ན་ཁོའི་ཕྱོགས་སུ་འདོན་དགོས་ཡོད།",
    "མ་ཐ་ནའང་སེམས་ཁྲལ་བྱེད་དགོས་གསུང་ནས་མི་བཟང་གི་ཡུག་རིང་དཀར་པོ་མཐའ་འཁྱོང་བ་སྐྱོང་བར་མཛད་དོ།",
    "མཚན་མོ་ཅིག་གཟིམས་ལ་བཞུགས་འདོད་བྱུང་བས་ཚོས་པོ་ལ་ཚ་ཙེག་པ་ཞིག་བྱུང་ནས་ཕྱག་གིས་ཉུལ་བས་གྲི་གཅིག་གྱེན་དུ་བསླང་འདུག་པ་དེ་སུས་བྱས་དགོངས་ནའང་འཁོན་དུ་འཛིན་པ་མི་མངའ་བས་འགྲོགས་ཐུབ་པ་སོགས་ཀྱིས་དཔེས་མཚོན་པར།",
    "ཆེས་ཆེ་བ་དག་གིས་ཕྲག་དོག་ལ་བསྟེན་པའི་ལོག་སྒྲུབ་སྣ་ཚོགས་བྱུང་བ་ལ།",
    "ཁོང་རང་ལ་གང་འདུག་གི་ཡོན་ཏན་ནས་བཟུང་ནས་བསྟོད་པ་བརྗོད་ཅིང་།",
    "མ་ནུས་པ་གཟིགས་པའི་ཚེ།",
    "བཞུགས་ཚུལ་ན་བཟའ་བཞེས་ལུགས་ཚུན་སྐུ་གྲིབ་དང་བསྙེལ་ན་མ་གཏོགས་ཉིན་རེ་བཞིན་དུ་འགྱུར་བ་ཅན་མ་ཡིན་པར་ངེས་བཟུང་རྟག་ཐུབ་པ་བསྟར་ཆག་དང་།",
    "རེས་སྐྱོ་བ་སྐྱེས་པ་སྐད་དུ་བྱས་ཏེ་རིའི་རྩེ་མོ་རྣམས་སུ་འབྲོས་པ་དང་།",
    "རེས་འདོད་ཡོན་གྱི་ཉེས་དམིགས་མཐོང་བ་སྐད་དུ་སྨྲས་ནས་དཀའ་ཐུབ་ཆུ་འཐུང་དང་།",
    "རེས་རྣལ་འབྱོར་གྱི་གྲོགས་ལྟ་བུར་ལྟས་ནས་འཇོལ་མྱོག་ཏུ་སྤྱོད་པར་མི་མཛད་ཀྱི།",
    "ལུས་ནི་དགྲ་ལྟར་མཐོང་མོད་ཀྱི།",
    "རེས་དགོས་པ་མེད་པ་སྐད་དུ་སྨྲས་ནས་ལྷམ་དང་སྐ་རགས་ཚུན་གཞན་ལ་གཏོང་།",
    "རེས་གཞན་གྱི་ནོར་ལ་ཇི་མི་སྙམ་པར་སྤྱོད་པའི་ཧམ་པ་ཡང་མི་མཛད་པར་འཕྲལ་གྱི་འཚོ་ཆས་ཙམ་ལ་ཉར་ཆག་མཛད་པ་ཡིན།",
    "རེས་སྨྲ་བ་ལ་དགའ་བའི་ཉེས་དམིགས་རིག་ཟེར་ཞིང་དྲིས་ཀྱང་ལན་མི་འདེབས།",
    "གང་ཟག་གི་རྒྱུད་དང་བསྟུན་པའི་སྤྱོད་ལམ་ལ་མཁས་ཏེ།",
    "གླིང་པ་ཞེས་བྱ་བའི་སྐྱེས་བུ་ཆེན་པོ་ཕན་པར་བཞེད་པའི་ཐུགས་ཅན་དེའི་གསུང་གིས།",
    "རང་གི་མདུན་མ་གཞག་ནས་གཞན་གྱི་འཇིག་རྟེན་གྱི་ཤོམ་ར་མང་པོ་མི་མཛད་པའོ།",
    "ཁ་ཅིག་གིས་ལུང་སྟོན་དྲི་བ་ཞུས་དུས།",
    "སྐུའི་སྙན་གྲགས་ཇེ་ཆེར་སོང་ནས།",
    "དབུས་གཙང་གི་མཁས་གྲུབ་ཅི་རིགས་པ་དང་།",
    "དད་པ་དང་ལྡན་པའི་སྐྱེ་བོ་དུ་མ་དག་གིས་ཀྱང་གསུང་གི་བདུད་རྩི་ཆ་ཤས་གསོལ་བར་མཛད་པའང་མང་དུ་ཡོད་པ་ལས།",
    "དབུ་སྔས་ཕྱོགས་སུ་གཅིག་ཡོད་པ་སྙམ་བྱེད་ནས་གཟིགས་པས།",
    "ཞྭ་ཐེབ་རྒྱབ་ལ་བསྐྱུར་ནས་རིངས་པར་བྲོས་སོང་།",
    "རྩེས་ཐང་གི་ཟུར་ཁང་ཤར་ཡིན་པ་སྙམ་བྱེད་པའི་ཁང་པ་ཅིག་ན་བཞུགས་འདུག་པ་ལ།",
    "ཁྱོད་འདིར་མི་བཞུགས་པར་གཤེགས་པར་ཞུ་ཟེར་བས།",
    "དེ་ཁ་དོག་ཐལ་སྐྱར་སྣང་བས་བར་ཆད་ཀྱི་མཚན་མར་དགོངས་ཏེ།",
    "ང་མི་འགྲོ་ཁྱོད་རང་སོང་ཞེས་ལྕགས་རི་སྣང་བའི་ཁ་ནས་དེའི་ལག་པ་ལ་བཟུང་སྟེ་བསྐུར་བས་རྩ་བར་ལྷུང་སོང་ཡང་།",
    "དེ་ན་རེ།",
    "དུས་ཚིགས་དགོས་ན་ཁྱོད་སོང་ནས་ལོ་བརྒྱ་ན་ང་འོང་གཞན་མི་འགྲོ་ཞེས་ནང་དུ་བཞུད་པའི་ཕྱི་བཞིན་དུ་དེ་འབྲངས་ཤིང་།",
    "དེའི་མོད་ལ་བྲོས་སོང་བ་ཞིག་བྱུང་བའི་ཞག་ཤས་ན་སྐུ་ཁམས་ཅུང་ཟད་མ་བདེ་བ་ཡུད་ཀྱིས་དྭངས་སོ།",
    "ཞག་གསུམ་སོང་བའི་རྗེས་ལ།",
    "ལྟ་བ་ལེགས་པར་བསྐྱངས་ཤིང་བསྒོམས་པས་དེ་ཐམས་ཅད་ན་བུན་བཞིན་དུ་ཡལ་འགྲོ་བ་བྱུང་བའི་མོད་ལ་བཞེངས་པ་དང་བཞུད་ཐུབ་པར་གྱུར་ཀྱང་།",
    "སྤྱན་འགྲིབ་པའི་རྣམ་པ་ཇེ་ཆེར་སོང་མོད་ཀྱི།",
    "སྟོང་གཟུགས་ཀྱི་ཡུལ་སྣང་རྒྱ་ཆེན་པོ་སྤྱན་འབྱེད་འཛུམ་གང་གིས་ཀྱང་མི་གནོད་མ་བྱུང་བས།",
    "མི་གཟིགས་པའི་ནག་ཐམ་གྱི་གུ་དོགས་པ་མེད་པ་ལ་སོགས་པ་མི་མཐུན་ཕྱོགས་ཞི་བར་མཛད་ལུགས་མང་དུ་མཆིས་པ་ལས།",
    "སྐུ་ན་ཕྲ་མོ་ལ་རབ་ཏུ་བྱུང་ཞིང་བསྙེན་པར་རྫོགས་པ་ནས་བཟུང་སྟེ།",
    "ནས་ཁལ་བརྒྱ་དང་ཤ་ཁང་གི་གཟིགས་སྤྱིལ་འབུལ་བས་ཆ་རྐྱེན་ལ་གཏོང་བ་མཛོད།",
    "བསྟན་པའི་གཏད་རབས་རྣམས་ལ་སྔར་འགྱུར་པའང་ཡོད་མོད་ཀྱི།",
    "ཆུ་མོ་ཕག་གི་ལོའི་དབྱར་སྐྱམ་མཆད་པ་སྟེངས་སུ་སྐུ་མཚམས་བསྡམས་ནས།",
    "ལོ་ཆེན་འགོས་པ་ཚབ་ཆག་གི་འགྱུར་བཞི་ལ་ནམ་ལངས་ས་སྲོས་ཀྱི་བར་གཟིགས་ཤིང་ཚིག་དོན་ལ་དཔྱད་པ་དཔྱིས་ཕྱིན་པའི་ཞུ་ཆེན་མཛད་པས།",
    "སྔ་གཟིགས་དང་འགོལ་བ་ལ་མ་ལྟོས་བྱུང་བས།",
    "སྤྱན་ཕྱེ་ནས་ཀྱང་ཡི་གེ་ཕྲ་བ་མི་གཟིགས་པས།",
    "བདག་གིས་འགྱུར་གྱི་དོ་དམ་བྱེད་པའི་ཁས་ལེན་ཞུས་ནས།",
    "སྦྲུལ་ལོ་ལ་ཡར་ལུང་གི་བན་དེ་ཆུང་མ་ཡོད་པ་ཐམས་ཅད་དམག་ལ་འདེད་པར་བརྩམས་པ་ལ།",
    "ཞིབ་མོར་བཀའ་འབུམ་གྱི་དཀར་ཆག་ལས་ཤེས་པར་བྱ་སྟེ།",
    "ཟབ་པ་དང་རྒྱ་ཆེ་བའི་གསུང་གི་རྒྱུན་ཐམས་ཅད་སྐྱེས་བུ་ཆེན་པོ་རྣམས་ཀྱིས་རྗེས་སུ་ཟློས་པའི་འཕྲིན་ལས་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པ་ཞེས་པ་ནི།",
    "ནུབ་ཅིག་ཁང་པ་གཅིག་གི་ནང་ན་བཙུན་པ་མང་དུ་འདུས་ནས་འདུག་པ་རྣམས་ཀྱི་ཁྲོད་ནས་གཅིག་ན་རེ།",
    "ཕ་ཟད་དེ་ན་ཆུ་ཅིག་འདུག་པ་དེ་བསྟན་ནས་འདི་ལ་མཆོངས་ནས་འཆི་བ་ཡིན་མོད་ཟེར།",
    "དེ་ནས་ཆུ་ལའང་མ་མཆོངས་པར་བཞུགས་པས་གཞན་ཅིག་ན་རེ།",
    "བརྒྱད་བཅུ་རྩ་ལྔ་པ་མེ་ཕོ་སྤྲེའུ་ལོ་གསར་རྗེས་ནུབ་ཅིག་རྨི་ལམ་དུ་གླང་པོ་ཆེ་ཆེན་པོ་ཁ་དོག་དཀར་པོ་ཤིན་དུ་མཛེས་ཤིང་ཤུགས་དང་ལྡན་པ་ཞིག་གི་སྒལ་པའི་སྟེང་དུ་སྐྱིལ་དཀྲུང་མཛད་ནས་བཞུགས་རེ།",
    "རྩིག་ཟུར་མང་དུ་ཡོད་པའི་སྲང་ཞིག་ན་ཕར་ཕེབས་པས་ལམ་དེའི་འཁྱོག་འཚམས་དང་རྩིག་ཟུར་སོགས་མང་དུ་འདུག་ནའང་གླང་པོ་ཆེ་འདིས་འཕྲལ་དུ་སྣས་བཤིག་ཅིང་ཕྱིན་པས་བདེ་བར་འདུག་དགོངས་ཏེ།",
    "དེའི་སྔོནལ་ཁྱོད་འདུག་ཁྱོད་ཀྱིས་ལམ་སྣ་བྱས་ནས་ངེད་རང་གཉིད་མཁའ་སྤྱོད་དུ་འགྲོ་བ་ཡིན་ཟེར་ཞིང་།",
    "དེ་ནས་སྲངས་དེ་ཐོན་པ་དང་ཁྱོད་ཀྱང་མེད།",
    "ང་མཁའ་སྤྱོད་དུ་འགྲོར་མི་སྟེར་བ་འདྲ་སྙམ་དུ་དོགས་པའི་མོད་ལ་གཉིད་སད་པ་ཅིག་བྱུང་།",
    "བདག་གིས་ལོ་བརྒྱའི་བར་དུ་བཞུགས་པར་གསོལ་བ་བཏབ་པའི་དུས་སུ།",
    "དགྱེས་པའི་འཛུམ་མདངས་དང་ལྡན་པ་ཞིག་གྲུམ་ཟེ་སྔོན་པོ་ཁ་དོག་མ་ཉམས་པ་ཞིག་གི་སྟེང་ན་བཞུགས་འདུག་པས།",
    "ཡང་རེ་ཞིག་དགེ་མོར་བཞུགས་དུས་མནལ་ལམ་དུ།",
    "ན་བཟའ་ངུར་སྨྲིག་མནབས་ཤིང་ཕྱི་ན་སྲབ་མོའི་སྐུ་ཕྱམ་བཞེས་པ།",
    "ཡང་ལན་ཅིག་ཡབ་ཡུལ་གྲོང་ནག་མོ་ན་གཞུགས་པ་སྙམ་བྱེད་པ་ཅིག་ལ་དེའི་གཡུལ་ཁ་ན་ཚུར་དཔལ་རྒོད་ཚང་པ་ཆེན་པོ་ན་བཟའ་ཕྱི་གོས་སྐྱེར་ཁ་ཅིག་བཞེས་ནས་བྱོན་པ་དང་མཇལ་བས།",
    "མདའ་ལྷོར་བསྟན་པ་གཅིག་གིས་ཕུ་ན་མར་ལ་ཞལ་ཡང་ལྷོར་ཕྱོགས་ཤིང་ཐུགས་ཀྱང་སྐྱོ་བ་དང་བཅས་ཏེ་ཕེབས་པ་ན།",
    "མ་གི་རྣམས་བདུད་གནམ་ལ་སྤྱི་རིངས་བྱ་བ་ཡིན་ཟེར་བས་བར་དུ་གཅོད་པར་མཁྱེན་ནས།",
    "བཅོམ་ལྡན་འདས་འཇིགས་མཛད་རྡོ་རྗེ་ཐུགས་ལ་དྲན་པ་ཙམ་གྱིས་ཕྱག་གི་མཐིལ་གཉིས་སུ་ཞབས་དག་བཀོད་པའི་རྡོ་རྗེ་འཇིགས་བྱེད་རབ་ཏུ་གསལ་ཞིང་།",
    "སྐུ་བོང་ཤིན་དུ་ཆེ་བ་ཞིག་བྱོན་ནས་དེས་ཕྱག་གཉིས་ཀྱིས་མདུན་དེ་ནས་ཕ་ཝང་ཆེན་པོ་ཞིག་བླངས་ཏེ་བདུད་དེ་རྣམས་ལ་རྒྱབ་པས་བདུད་རྣམས་ཐལ་བའི་རྡུལ་བཞིན་དུ་བརླག་པར་མཛད་གསུང་།",
    "སྐབས་ཅིག་མི་གཡོ་བ་བརྟུལ་ཕོད་པའི་རྒྱུད་ལ་གཟིགས་པས།",
    "དེའི་ནུབ་མོ་གཡོ་བའི་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་ཤཀྱ་ཐུབ་པས་བྱས་པ།",
    "རབ་ཏུ་བཀྲ་བའི་ཁ་དོག་དང་ལྡན་པ་ཞིག་གསལ་པར་གཟིགས་ཤིང་།",
    "སང་དེ་སློབ་དཔོན་ཨ་བྷ་ཡཱའི་མན་ངག་སྙེ་མ་གཟིགས་པས་དེ་ན་དེའི་ལུང་ལེགས་པར་དྲངས་འདུག་པས་ཐུགས་ཀྱི་ཐེ་ཚོམ་སོལ་བར་གྱུར་བ་ཡིན་ནོ།",
    "རྒྱ་རབ་ཀྱི་ཕུ་ན་ཡར་ཕེབས་པས་དེ་ན་ཁང་པ་གཅིག་འདུག་དེའི་ཤར་ངོས་ཀྱི་གྲོག་པོ་ཞིག་གིས་ཁ་ན་རབ་ཏུ་བྱུང་བ་མང་པོ་འདུག་པ་ལ།",
    "ཁོང་ཚོའི་ནང་ན་ཡར་ཕེབས་པར་བརྩམས་པའི་ཚེ་ཁྱི་མེད་དམ་དགོངས་ནས་རྟོག་ཅིང་རྟོག་ཅིང་གཤེགས་པའི་ཚེ་ལྕགས་ཐག་གི་སིལ་ཆོམ་ཆེན་པོ་གྲག་དེ་ཅི་ཡིན་དགོངས་ནས་གཟིག་སཔ་ན།",
    "ས་སེན་ཊ་ན་ཆ་དང་ལ་ལྕགས་ཐག་བཏགས་པ་དེ་རྣམས་ཀྱང་ཁྱི་བཞིན་དུ་འཐེན་ཞིང་འདུག་འདི་མཐུ་པ་ཞིག་གི་ཁྱིམ་དུ་འདུག་དགོངས་ནས་ནང་དེར་བྱོན་པ་ན།",
    "དེ་ན་དཀྱིལ་འཁོར་རྡུལ་གྱིས་ཁེབས་པ་ཅིག་གི་མཐའ་སྐོར་རྣམས་ཚོན་སྐུད་ཀྱིས་བྲེས།",
    "དཀྱིལ་འཁོར་དེའི་གཡོན་ན་གཏོར་མ་ཅིག་ལ་མདའ་དར་བཙུགས་པ་ཅིག་གཟིགས།",
    "ཅིག་གིས་ཟན་ཧྲིལ་ཅིག་དང་མར་དྲངས་བྱུང་བས།",
    "ཁྱོད་ལ་ཕྱག་བཙལ་ནས་ཟ་མ་ཟ་བ་ཡིན་གསུངས་ཤིང་།",
    "གསུམ་པའི་སྐབས་སུ་ན་མོ་བུདྡྷ་ཡ་གསུང་བ་དང་ཕྱག་གཉིས་ཞབས་གཉིས་ཀྱི་བརླ་ལ་བརྡེགས་པ་དང་ལྷན་དུ་ནམ་མཁའ་ལ་འཕུར་ཏེ་རབ་བྱུང་དེ་རྣམས་ཀྱི་ཁྲོད་དུ་ཕེབས་ནས།",
    "དེ་རེས་ཀྱི་བྱད་ཁ་དེས་བཟློག་པ་ཡིན་པར་འདུག་གསུང་།",
    "རེ་ཞིག་གི་རྨི་ལམ་དུ་སྤྱན་གཡས་ཀྱི་ལྕགས་རིའི་བྱང་སྒོ་དེ་ལ་ཕྱིར་འཐེན་ནས་གཤེགས་པ་ན།",
    "སྒོ་དེའི་ཕྱི་རོལ་གྱི་རྡོ་ཁྲོད་རྣམས་ལ་ཡུངས་ཀར་དང་སྲན་མ་བསྲེས་པ་མང་དུ་གཏོར་འདུག་པས་འདི་ལ་འགྲོ་བར་མི་བཟོད་པས་འགྱེལ་འོང་ངམ་དགོངས་པའི་མོད་ཁོ་ན་ལ།",
    "སྐུ་ལུས་འགྱེལ་བ་དང་དུས་མཉམ་དུ་ཕྱོགས་བཞི་ནས་བུད་མེད་སྐྲ་སྦོད་དེ་བ།",
    "མོན་པའི་གོས་གྱོན་ནས་རབ་དུ་བརྗེས་པ།",
    "འདོམས་དཀྲིས་ཅུང་ཟད་རེ་ཡོད་པ་བཞི་ཧབ་བརྒྱུགས་སུ་བྱུང་ནས་ཧབ་ཤ་ཟེར།",
    "འདི་སུས་བྱས་པ་ཡིན་གསུངས་པས་གཅིག་ན་རེ།",
    "སྐབས་ཅིག་རྩེ་ཐང་གི་བསམ་གཏན་གླིང་དུ་བཞུགས་དུས།",
    "སྤྱན་གཡས་ཀྱི་གཟིམས་སྤྱིལ་དེའི་ནང་ན་བཞུགས་འདུག་པ་ལ་ཐོག་སྟེང་རྩེ་མོ་དེར་གཤིགས་པ་ན་ཚོན་སྐུད་ལྔས་བྲེས་འདུག་པས་འདི་སུས་བྱས་པ་ཡིན་གསུངས་པས།",
    "ཆེ་སས་བྱས་པ་ཡིན་ཟེར་བས་ཕྱག་གིས་ཚོན་སྐུད་རྣམས་བསལ་ནས་བྱང་རི་དིའི་ངོས་སུ་འཕུར་ནས་བྱོན་ཞིང་།"
  ]
