    "ཟབ་པ་དང་རྒྱ་ཆེ་བའི་གསུང་གི་རྒྱུན་ཐམས་ཅད་སྐྱེས་བུ་ཆེན་པོ་རྣམས་ཀྱིས་རྗེས་སུ་བཟློས་པའི་ཕྲིན་ལས་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པ།",
    "སྣང་ཐང་ནས་ཇོ་མོ་ནང་མཇལ་དུ་ཕེབས་པའི་ཕྱིར་ལམ།",
    "དུས་ཕྱིས་སུ་སོང་ནས་ཀྱང་ཞིབ་ཆ་ཁ་ཡར་ལ་བློ་བསྐྱེད་ནི་བྱུང་།",
    "ཡབ་མེས་སྔ་མོའི་དུས་སུ་དབུས་སུ་ལྷགས་ནས།",
    "ཡབ་མེས་སྔ་མོའི་མི་ཅིག་འཇུ་ཕུའི་ཅོ་བཙན་གྱི་འཁོར་དུ་སྐྱེས་ནས་དེ་རྣམས་ཀྱིས་མཐོང་བར་ནང་དུ་འོང་།",
    "རེས་ལྟོ་ཟ་འཕྲོ་ལ་ཆུ་བྱང་ཁ་དེར་ཅོ་བཙན་དཔོན་གཡོག་བྱོན་ཟེར་འགྲོ་བ་ཡང་ཡོད།",
    "དུས་ཕྱི་ཞིག་ན་ཨ་མི་ཀུན་རྒྱལ་ཞེས་བྱ་བ་བྱུང་།",
    "གྲགས་བཟང་གི་རྒྱུད་ད་ལྟའི་ཁྱུ་མ་བ་འདི་རྣམས་ཡིན།",
    "དཀར་ནག་གི་རྩིས་དང་གཤིན་པོ་རྗེས་སུ་འཛིན་པའི་ཆོ་ག་ལ་སོགས་པ་ཡོན་ཏན་དུ་མ་དང་ལྡན་པ་བྱོན་ཏེ།",
    "འབྱུང་གནས་རྡོ་རྗེ་དང་སྲི་ཐར་སྐྱིད་གཉིས་ལ་སྲས་ལྔ་དང་སྲས་མོ་གསུམ་བྱུང་བའི་སྲས་ཆེ་བས་ཁྱིམ་གཟུང་སྟེ་རིང་པོ་མ་ལོན་པར་འདས།",
    "དེ་འོག་ཀྱང་སྔ་མོར་འདས།",
    "བུ་མོ་ཆེ་བ་རྡོ་རྗེ་སྐྱིད།",
    "ཡབ་སྔ་མོ་ནས་མི་ལག་ཏུ་སོང་བས་ཡུམ་གྱིས་ལེགས་པར་བསྐྱངས།",
    "དེ་རེས་ཀྱང་བར་སྣང་ནས་མ་ཟིན་ན་འཆི་བར་འདུགདྲིན་ཆེ་ཞེས་ཡང་དང་ཡང་དུ་གསུང་བར་མཛད།",
    "དགུང་ལོ་བཅུ་དགུ་བཞེས་པ་ལྕགས་ཕོ་སྟག་གི་ལོ་ལ།",
    "ལུས་ལ་ཤེ་མོང་པས་དཔོན་ཅིག་ལ་རྟེན་པའི་མི་གཡོག་ཀྱང་མི་ཕེར་བས།",
    "དེ་ནས་རེས་བརྩོན་འགྲུས་ཆེན་པོ་མ་བརྩམས་པར་སོས་དལ་དུ་ལུས།",
    "རེས་དུམ་རེ་ལྟ་རྟོག་བྱས་ཏེ་སེམས་དེ་གཅིག་པུའི་དྲིན་གྱིས་ཡོན་ཏན་ཐམས་ཅད་བྱུང་བ་ཡིན་པས་ཁྱེད་རང་རྣམས་ཀྱང་ཅི་འོང་ལེགས་པར་སེམ་དགོས་པ་ཡིན་ཞེས་གསུང་ངོ།",
    "རབ་ཏུ་བྱུང་ནས་ལོ་གསུམ་གྱི་བར་དུ་དབྱར་ཡུམ་གྱི་ལས་གྲོགས་རེ་ཙམ་མཛད་པ་མ་གཏོགས་སྤྱན་གཡས་སུ་ཁུ་བོ་སློབ་དཔོན་སང་གྲགས་པའི་སར་བཞུགས་ཏེ།",
    "མི་བདེན་བྱས་པས་འོ་ན་ཁྱེད་རང་ཚོ་ངའི་མིག་ལ་ལག་པ་ཁོབ་ལ་ལྟོས་ཤིག་གསུང་ནས་བཏོན་པས་ཚང་མར་ཐོན་བྱུང་པ་ཡིན་ཟེར་ནས་དད་པར་བྱེད་འདུག་གོ།",
    "སྐུ་ན་གཞོན་པ་དང་གྲ་པ་གཞན་སུ་ཡང་མི་འདུག་པས་ཐུགས་ཤིན་ཏུ་སྐྱོ་བར་བྱུང་ནས་ང་ལྷགས་བ་འུར་བ་ཅིག་གིས་ཁྱེར་ནས་སྤྱན་གཡས་སུ་སླེབ་བྱུང་ན་དགའ་བ་ལ་སྙམ་པ་བྱུང་།",
    "ང་རང་གི་དོན་ལ་ཕྱག་བཅུག་པ་ཡིན་དགོངས་པ་མ་གཏོགས་དད་པ་ལོག་པ་ཅིག་ཀྱང་མ་སྐྱེས།",
    "སྐུ་ལུས་ཐམས་ཅད་ཤུ་བར་སོང་བ།",
    "ཁོ་ན་རེ་བཙུན་ཆུང་འདིའི་གྲོང་དེ་ལུང་པ་མདའ་བྱང་དུ་བསྟན་པའི་མདའི་གྲོག་ཁ་ཅིག་ན་འདུག་འདི་གཉིད་ལ་སོང་ནས་ཀླུ་ཅིག་མནན་པས་ལན་པར་འདུགད་ལོ་མཉམ་ཅིག་ལ་གོས་ཅིག་བྱིན།",
    "བླུད་ཅིག་བསྐུར་ནས་རྒྱལ་བཟང་གི་མཆོད་རྟེན་དེའི་རྩར་ཟ་བཅུག་པས་དེ་མ་ཐག་དངས།",
    "དེ་ནས་ཞག་ཁ་ཡར་ཅིག་སོང་བ་དང་ཇོ་སྟོན་ཅིག་བཏང་བྱུང་ནས་ཁྲིད་ལ་འབྱོན་ན་ད་ལྟ་རང་བྱོན།",
    "རེས་འགའ་སྤྱན་གཡས་སུ་བཞུགས་ནས་སྤྱོད་འཇུག་ཀྱང་གསན།",
    "དེའི་དགུན་དེ་སློབ་དཔོན་བསམ་བཟང་པས་བཀའ་བཀྱོན་མང་དུ་བྱོན་ནས་སྤྱན་གཡས་སུ་ཕེབས་པས་སློབ་དཔོན་པ་ན་རེ་བྱོན་པ་དེ་ལེགས།",
    "དེ་ནས་ལྷ་སར་ཕེབས་ཏེ་ལམ་གྲོགས་འཚོལ་ཞིང་ཕེབས་ནས་མི་གྲོང་ཡོད་མེད་ཀྱི་མཚམས་སུ་གཅིག་གི་སོག་རར་བཞུགས་པས་ཐོ་རངས་ཁར་སོང་རྩ་ན་ནང་མིས་སྦྲན་ན་ཟླ་བོ་འགུག་གོ་ཟེར།",
    "ཁྱད་པར་བཞི་བརྒྱ་པ་རྗེ་བཙུན་རེད་མདའ་བའི་ཊིཀའི་སྟེང་ནས་གསན་ཏེ།",
    "གདན་ས་བ་དེ་རྗེ་བཙུན་རེད་མདའ་བའི།",
    "གདན་ས་བ་དེ་རྗེ་བཙུན་རེད་མདའ་བའི་དངོས་སློབ་ཡིན་གསུང་།",
    "དེ་ཕྱིན་ཆད་ནས་གང་བདེ་བ་ཡིན་པས་རེས་རྩེ་ཐང་དུ་བཞུགས་ནས་རྒྱུད་བླ་ཐུགས་ལ་བཟུང་།",
    "ངས་སྐྱེ་བ་སྔ་མ་དང་འདིར་བཟླས་པ་མང་དུ་བྱས་པས་ད་ལྟ་ཆབ་རེ་ཙམ་སྐ་རགས་སྣ་ཆར་རེ་ཙམ་བྱིན་པས་ཕན་གྱི་འདུག་བསླབ་རྒྱུ་རང་ཆེ་བ་ཅིག་མེད་གསུང་པས་ནན་གྱིས་མ་ཞུས་གསུང་།",
    "ཡོན་ཏན་ཟེར་ན་སློབ་དཔོན་གཞོན་ནུ་དཔལ་གྱི་ཡོན་ཏན་ལ་ཟེར་བ་ཡིན་མོད།",
    "རེ་ཤིག་ཡར་འབྲོག་སྒ་འདྲར་ཆབ་ཚན་ལ་ཕེབས་པས།",
    "སྙན་གཡས་གཡོན་གཉིས་ལ་ལུག་གི་སོགས་པའི་སྙན་ཆ་རེ་བཏགས་ནས་བུག་སྒོ་འགག་དེ་ན་བཞུགས་ནས།",
    "ཁོང་རང་གི་གསོལ་ལྷག་དང་ཟག་པ་རྣམས་བསྲེས་ཏེ་མི་རྣམས་ལ་འགྱེད་པ་ཅིག་འདུག་གསུང་།",
    "ཚེས་བཅུ་བཞི་དང་བཅོ་ལྔ་བྱུང་རེས་ཀྱི་སྨྱུང་གནས་མཛད་པའི་ཟླ་ལ་སྨྱུང་གནས་མཛད་ཅིང་།",
    "ཇ་གྲལ་དུ་བཞག་བྱུང་ནའང་ཇ་དྲིལ་སོང་།",
    "སླར་སྐྱོར་མོ་ལུང་དུ་ཕེབས་པའི་ལམ་དུ།",
    "བུ་མོ་ཁ་ཡར་གྱིས་བཟུང་ནས་ཆང་འདྲེན་ཞིང་སློང་མོ་བྱེད་རྩིས་བྱས་པས།",
    "ངའི་ཨ་མ་ཤི་ནས།",
    "ཞོར་ལ་ར་ཚག་གི་ཇོ་མོ་མཇལ་ནས་གསོལ་བ་བཏབ་པས་བྱིན་བརླབས་ཀྱང་ཆེ་བར་བྱུང་།",
    "སྦྲུལ་ལོའི་སྟོན་དེ་སྐྱོར་མོ་ལུང་གི་བྲང་ཁང་ཅིག་ན་བཞུགས་པའི་དུས་སུ།",
    "ཁོང་རྣམ་པའི་མེ་འབུད་ལ་སོགས་པའི་ཞབས་ཏོག་རྣམས་ཐུགས་གཞུངས་ནས་མཛད་པས།",
    "གཟིམས་ཁང་གི་ལོངས་སྤྱོད་སྐྱོང་ལུགས་སོགས་ལེགས་པར་གསུང་།",
    "གླང་ཐང་གི་འོག་གི་ངན་ཆུའི་འགྲམ་དུ་རབ་གར་ཡོད་མ་དགོངས་པར་དུམ་གཅིག་བཞུགས་པ་མནལ་དུ་སོང་རྩ་ན་ཆུ་ཤོ་ཤོ་ཟེར་ནས་ཐད་དེ་ཉིད་ན་ཚུར་རྟ་པ་ཅིག་བྱུང་བའི་རབ་བརྒལ་ཏེ་ཐང་སག་ཏུ་བྱོན་ནས་མཇལ་རྗེས།",
    "བཙུན་རྒན་མ་གོས་ཧྲལ་མོ་མཁའ་འགྲོ་མ་ཡིན་ཟེར་བ་ལ།",
    "དག་འགྲོ་མ་ཡིན་ནམ་མ་ཡིན་རྟོག་པའི་བརྡར་སྤྱན་གྱིས་དེ་ལ་མ་གཟིགས་པར་སེ་གོལ་མཛད་པས།",
    "མོས་ཀྱང་ལན་གྱི་སེ་གོལ་བྱས་བྱུང་གསུང་།",
    "ཐུགས་རྗེ་ཆེན་པོའི་བསྒོམ་བཟླས་གནང་གི་འདུག་པ་གསན།",
    "བསྔོ་ཡིག་གཡས་གཡོན་གཉིས་ཀ་ནས་འབུལ་བ་ལ་ཆེད་དུ་མི་གཟིགས་པར་སྤྱན་འབྲས་མི་འགུལ་བ་ཉིད་ཀྱི་ངང་ནས་ཐོགས་མེད་དུ་ཀློག་པའི་ཡ་མཚན་ཆེན་པོ་དང་།",
    "ཁུ་བོ་སློབ་དཔོན་པས་རྩིས་དཀར་ནག་གཉིས་ཀ་མཁྱེན་པས་ས་རིས་དེ་ཇི་ཙུག་བྱེད་པ་ཡིན་ཞུས་པས་འདི་བཞིན་བྱེད་པ་ཡིན་གསུང་ནས་ཞལ་བཅོས་གཅིག་མཛད་བྱུང་བས་ཐབ་འགྲམ་གྱི་ཐལ་བ་བདལ་ནས་ཅུང་ཟད་ཅིག་སྦྱངས་དེ་ནས་ཕྱག་ངར་ལ་རི་མོ་མཛད་ཅིང་སྦྱངས་པས་བསྒྱུར་བགོད་བྱང་བར་མཁྱེན་བྱུང་བས།",
    "ལྷན་ཐབས་སྦྱིན་སྲེག་གི་ཆོ་ག་རྣམས་གསན།",
    "བདག་གིས་རྗེ་རང་ལ་ཞུས་པ་ཡིན་གསུང་ནས་རྒྱས་པར་མི་གསུང་།",
    "རྗེ་བཙུན་བྱམས་པ་སྐུ་རི་རྒྱུད་ཙམ་གཟིགས་པའི་ཞལ་ནས།",
    "ངེད་རང་གི་ཁ་མཁོས་ལ་དཔེས་པའི་བློ་བསྐྱེད་ཤིན་ཏུ་ཆེ་བར་བྱུང་།",
    "དེ་ལ་སྦྱོར་དྲུག་གི་ཁྲིད་ཐོབ་དགོས་གསུང་།",
    "སྦྱོར་དྲུག་གི་སོར་བསམ་ཡན་ཉམས་ཁྲིད་དུ་གནང་།",
    "ལུང་ལྟ་བུར་སོང་ནའང་བྱིན་བརླབས་ཀྱིས་ཐུགས་བསྐྱེད་ཆེ་བར་བྱུང་གསུང་།",
    "དེ་རེས་ཞབས་ཏོག་ཆེ་བར་མ་གྲུབ།",
    "ངས་ཨའུ་རྩི་བྱས་ནས་ཐམས་ཅད་རི་མོ་བ་རྣམས་ལ་བཀྱེ་བས།",
    "ངེད་རྒྱལ་སྟེངས་སུ་འགྲོ་གསུངས་པས་འོ་ན་ཕ་ཇོ་ཕ་གིའི་ཟླ་ལ་བྱོན།",
    "ཁོང་རྒྱལ་སྟེངས་པའི་སྐུ་ཉེ་ཡིན་ཟེར་བས་ཕ་ཇོ་རྟ་མགྲིན་ཞེས་བྱ་བའི་ཕྱིར་བྱོན་ནས་དེ་ནུབ་ཁོང་གི་སར་བཞུགས་པས་ཆར་ཆེ་ཞིང་ཁང་པ་ངན་པས་འོ་རྒྱལ་བར་བྱུང་།",
    "སང་ནམ་མ་ལངས་པ་ནས་ཕེབས་པས་ཁོང་ན་རེ།",
    "སྤྱན་རས་གཟིགས་ཞལ་གཅིག་ཕྱག་བཞི་དང་།",
    "ཕྱག་རྡོར་གཏུམ་ཆུང་གི་སྒྲུབ་ཐབས།",
    "སྒྲོལ་མའི་བསྟོད་པ་རྣམ་དག་གཙུག་གི་ནོར་བུ།",
    "སྤྲེའུ་ལོའི་སྟོན་འཇུག་ཏུ་སོང་བ་ན་ལྷ་ཁང་སྟེངས་སུ་ཕེབས་ནས།",
    "བདག་རེ་ཤིག་ཡོན་ཏན་གཅོད་ཅིང་གཙང་ཕྱོགས་སུ་ཕྱིན་ན་བསམ་པས།",
    "ཁམས་པ་མི་ཉག་རྟ་པ་ཆང་གིས་མྱོས་པ་ཞིག་རྟིང་ལ་བྱུང་།",
    "གྲི་ཆུང་ཡོད་པ་བསྣུན་རྩིས་ཀྱི་མོད་ལ་གཉེན་པོས་ཟིན།",
    "མཆོད་གཡོག་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་གྱི་ཐིག་འདེབས་པ་རྣམས་ལ་འཕྲལ་དུ་གཟིགས་པས་ཐིག་རྣམས་ཀྱང་ཚེགས་མེད་དུ་མཁྱེན།",
    "འཇམ་དབྱངས་སྨྲ་སེང་གི་རྗེས་གནང་།",
    "སྤྱན་རས་གཟིགས་ཕྱག་སྟོང་སྤྱན་སྟོང་གི་རིག་གཏད།",
    "དེར་བཞུགས་རིང་གི་འཕྲལ་གྱི་གསོལ་ཆས་རྣམས་ནི་འབྲོང་པོ་སྒང་ནས་དབོན་པོ་ཀུན་རྡོར་གྱིས་ཕུལ།",
    "དེ་ནས་འུག་པ་ལུང་དུ་བྱོན་ནས་ཡང་དབེན་པའི་དྲུང་བཤེས་གཉེན་པ་ལ་གསང་རྙིང་གི་རྒྱུད་འགྲེལ་པ་དང་བཅས་པ་དང་།",
    "དེའི་རིང་ལ་མཁན་ཆེན་གྲུབ་པ་ཤེས་རབ་པ་ལ་ལམ་མཆོག་མཆིམས་ཀྱི་གནས་བརྟན་ཆེན་མོ།",
    "ཕྱིས་སུ་སོང་དུས་གྲུབ་ཆེན་མན་ལུང་པའི་གདམས་པར་འདུག་གསུང་།",
    "གཟིགས་རྟོག་མང་དུ་མཛད་པས།",
    "ཁོང་གི་གཟིམས་ཁང་ན་རྐེད་བྲིས་ལ་ལན་ཚ་འདུག་པ་རྣམས་ལ་འདི་རྣམས་ཅི་ཟེར་བ་ཡིན་གསུང་བས།",
    "བདག་གིས་མཇལ་དུས་མཚམས་མཛད་ནས་གཟིམས་མལ་ཅིག་ཏུ་ལོ་བཞི་བཅུ་ཙམ་སོང་འདུག་དེའི་རྗེས་སུའང་ཡུན་རིང་དུ་བཞུགས་པར་འདུག་དང་པོར་ཁྲིད་ཀྱིས་གཞན་རྗེས་སུ་བཟུང་།",
    "ནུབ་ཅིག་ཁོང་གི་རྨི་ལམ་དུ་གཙང་པོ་བཅད་ནས་ཕྱིན་པས་ཆུས་ཁྱེར་བས་བཙུན་པ་གོས་ཕུ་ཐུང་ཅན་གྱོན་པ།",
    "ལག་ན་བེར་ཀ་བཟུང་བ་ཅིག་གིས་བཟུང་ནས་སྐམ་སར་བཏོན།",
    "ཁྱོད་རི་མགོར་སེམས་མི་འཇུག་པར་འདིར་ཅི་ལ་འཁྱམ་ཟེར་ནས་འབར་དུ་བྱུང་པ་ཅིག་རྨིས།",
    "ཆང་ཕོར་པ་གང་ཐོབ་པར་འདུག་གསུང་བས་མགྱོགས་པར་ཁོང་རང་གི་ནང་དུ་བྱོན་པས་ཆང་རྗེ་མ་ཅིག་ཡོད་པ་ཐེམ་ཁ་ཤོར་ནས་ཕོར་བ་གང་ལོན་གསུང་།",
    "གཟིགས་པ་ཙམ་གྱིས་ཚིག་རྣམས་ཀྱང་ཚེགས་མེད་དུ་བྱོན།",
    "ཨ་རོ་སྙན་རྒྱུད་ཀྱི་སྐོར།",
    "དང་པོ་ལམ་རྣམ་བཀོད་ལ་ཐུགས་འགྲོ་བར་བྱུང་ནས་ལེགས་པར་གཟིགས་ཤིང་ཐུགས་ཀྱིས་དཔྱད་ཀྱང་དཀའ་བར་བྱུང་།",
    "ཕུར་པའི་དཀྱིལ་ཆོག་གི་ཐིག་རྩ་འདི་སུས་ཀྱང་འབྲུ་མ་ནོན་གསུང་བས་གཟིགས་པས་ཡུད་ཀྱི་དགོངས་ནས་འདི་བཞིན་འདེབས་པར་འདུག་ཞུས་པས་ཤིན་དུ་མཉེས།",
    "མཚམས་ཁོངས་ནས་ཁྲིད་རེ་ཙམ་ནི་བཏབ་འདུག་གསུང་།",
    "དེར་བཞུགས་རིང་ལ་མནལ་ལམ་དུ་ཇོ་མོ་ནང་གསལ་བར་གཟིགས།",
    "མཚན་མོ་འདུ་ཁང་ཅིག་འདུག་པས་དེར་བཞུགས།",
    "དེ་མ་ཐག་ཏུ་ཇོ་མོ་ནང་སྐོར་དུ་ཕེབས།",
