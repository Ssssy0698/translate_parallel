    "དང་པོ་མཁྱེན་པའི་ཡེ་ཤེས་སྐྱེད་ལུགས་ཟུར་ཙམ་མོ།",
    "ཇོ་མོ་ཤེས་རབ་གསལ་གྱིས་བསྐྱངས།",
    "དེ་དུས་རེས་ཤིག་ནམ་ལངས་ཁར་བུད་མེད་གསུམ་འོངས་ནས།",
    "ཟངས་གླིང་ཡང་བཀོད་པ་ལེགས་པར་གཟིགས་ཤིང་།",
    "གསུང་གླེང་མང་དུ་མཛད་ནས་ད་ཡང་མྱུར་དུ་མཇལ་འོང་གི་གསུངས།",
    "ལྟ་དགོངས་ཀློང་དུ་གྲོལ་ནས་འཁྲུལ་བ་བོན་ཉིད་དུ་འདྲེས་སོང་།",
    "ཤ་འབལ་ཕུར་མོ་ཆེའི་ལུང་བླངས།",
    "ཁྱོད་ཀྱི་འདུལ་ཞིང་སྟོད་ན་ཡོད་པས་ཡར་བྱོན་ཅིག་ཁྱོད་རང་དང་བྱེ་བྲག་དང་མཐར་གྱི་ཡོན་ཏན་དག་ཉམས་རྟོགས་མཉམ་པ་བདུན་ཡོད་ཅིང་རྟོགས་པའི་སྣ་ཁ་གྲོལ་བ་བརྒྱད་ཅུ་ཡོད།",
    "ས་གཙང་ཞིང་ཡུལ་མཐོ་བའི་ས་ནས་མང་དུ་བྱུང་ལས་འབྲེལ་སྣ་རེས་ཐུལ་བ་དང་།",
    "ད་ཁྱོད་ཀྱིས་ཕྱི་ནང་གསང་བའི་དགོངས་རིམ་དང་།",
    "མཁའ་འགྲོ་རིན་ཆེན་དོན་གྲུབ་མ་ན་རེ།",
    "དེ་དུས་བདག་ལ་ཕྱི་ནང་བྱ་བའི་གཉེར་བྱེད་ལས་སུ་རུང་བ་ཞིག་ཁྱོད་ཀྱིས་གཟིགས་འཚལ་ཞུས་པས།",
    "བསྟན་པའི་དོན་ཁེབ་ཏུ་འགྱུར་བའི་མི་ཞིག་བྱུང་གི་ངོས་ཟུངས་ལ་བསེན་དུ་ཟུངས་ཤིག་གསུང་།",
    "ཞག་ཉི་ཤུ་རྩ་གཅིག་གིས་གྲོལ་ཏེ།",
    "རེ་ཝང་གི་མཚོ་ལ་སྦལ་ལྕོང་ཉ་སྦྲུལ་གྱིས་ཁེངས་པའི་གསེབ་ནས།",
    "ཁར་ཚད་ནས་ཁྱེད་གྲེ་མོ་བགྱིས་པ་ཡིན།",
    "ཁྱོད་ཀྱང་གཤེགས་ལ་ཁྱོད་ཀྱང་ཕྱིས་ནས་མེད་གསུངས།",
    "དེ་རྣམས་ནི་འགྲོ་དོན་ཀུན་ཏུ་ཞབས་ཀྱིས་བཅགས་ཤིང་ལྷ་ཞལ་གཟིགས་ཤིང་ཉམས་རྟོགས་ཤར་ཚུལ་ལོ།",
    "མོས་གུས་དྲག་པོས་གསོལ་བ་བཏབ་ནས།",
    "ཕྱིས་འབྱུང་གི་ལུང་སྟོན་འགའ་དང་ཉམས་ལེན་གྱི་གསལ་འདེབས་འགའ་གསུངས་ནས།",
    "མི་སྣང་བའི་རྗེས་ལ་ཉམས་རྟོགས་རང་གྲོལ་གྱི་མགུར་མ་དྲང་སྲོང་གིས་བླངས་ནས།",
    "ཁམས་ཉོག་ཅིང་ན་བ་བས་བདག་གི་མོས་པར་འཛམ་སྒྲུབ་པས།",
    "ཁོང་གི་ཐུགས་རྗེས་ཡུད་ཙམ་མི་གཟིགས་པ་བསམ་ཞིང་ཡི་ཆད་བག་ཙམ་སྐྱེས་དུས་སུ།",
    "ཉམས་སྣང་ལ་བུད་མེད་ཅིག་ཡོད་ས་ནས།",
    "ཁྱོད་ལ་ན་བ་དངོས་གྲུབ་ལེན་དུས་ལ་མ་ལོངས་པས་ལན་པ་ཡིན་གསུངས།",
    "གཡོན་དུ་བཞུགས་ཤིང་གདའ་མོས་ཀྱང་གཞན་གྱི་དྲང་མེད།",
    "ཞིམ་པའི་ཕུད་ཆས་བུ་གཉིས་པོ་གསོལ་བྱས་པའི་ཉམས་ལ་ཡབ་ཡུམ་གྱིས་དངོས་སུ་གསོལ་ནས་གཤེགས་རྗེས་བུད་མེད་སྔ་མ་ལ།",
    "ཁྱོད་ཀྱིས་མ་ཤེས་སམ།",
    "ཕྱག་ན་རིན་ཆེན་བུམ་པ་གཉིས་བཅུད་ཀྱིས་བཀང་ནས་ཁྱོད་འདི་འདོད་དམ་གསུངས་པ་ལ།",
    "སྣང་བ་ཧད་དེ་ལ་འདི་འདོད་ཀྱི་འདམ་ཁ་མ་བྱས་པ་ལ་ཁོང་རང་གཤེགས་ཐལ་སྐད།",
    "ཡང་ད་ཝང་བ་རྒྱལ་མཚན་ཡེ་ཤེས་ཀྱིས་མོས་པས་གསོལ་བ་མང་དུ་བཏབ་པས།",
    "རེས་ཤིག་རོག་ཟོམ་དུ་བཞུགས་དུས་སུ་ཐུགས་སྐྱོ་བ་ཞིག་ལ།",
    "རྒྱ་གར་གྱི་དུར་ཁྲོད་ཆེན་པོ་བརྒྱད་གཟིགས་པར་དགོངས་ནས།",
    "ངལ་ཕུད་བཤམས་ཤིག་གཟིགས་ནས་འདོན་ཞིང་ཕྱིས་ཞལ་བརྡུར་བས་དུས་དང་དོན་མཐུན་པར་བྱུང་གདའ་འོ།",
    "སྲོད་ཅིག་དད་མོས་ཀྱིས་གསོལ་བ་དྲག་ཏུ་བཏབ་པས།",
    "བདུད་རྩི་སྐྱེམས་ཞལ་གང་གནང་ནས་གཤེགས་ཐལ་སྐད།",
    "ཉམས་སྣང་འཕེལ་ཞིང་མོས་པ་ཆུད་པ་ཞིག་བྱུང་གསུངས།",
    "ཁྱོད་ཅི་བྱེད་ངས་བོད་དར་བགྱིས་ནས་འོངས་པ་ཁྱོད་ཀྱིས་ད་ཤེས་སམ།",
    "ལར་ཁྱོད་ལ་ཁྱེར་སོ་བཏུབ་པ་འདུག་གསུངས་ནས།",
    "ད་བདག་གིས་ས་འདིར་དུ་མ་བསྡད་ཀྱང་གཞན་རྒྱུད་ཀུན་ནས་སྨིན་པ་མི་འདྲ་ཞིང་བདག་ཀྱང་གཞན་དོན་ལ་རྒྱ་གར་དུ་རིང་བར་ཡོད་དེ།",
    "ལས་སྤྱི་དང་བྱེ་བྲག་ཏུ་ཀུན་ལ་འཕྲུལ་སྣང་དང་ཕྱིས་འབྱུང་གི་ལུང་བསྟན་དང་།",
    "གདུལ་བྱ་རང་ཐད་ཀྱི་རེ་བ་སོ་སོ་རུ་སྐོང་བ།",
    "སླུ་བྲིད་གཞན་སྣང་གི་ཕྱིར་མི་འབྲང་བ།",
    "ཡི་དམ་ལྷའི་ཞལ་དངོས་སུ་གཟིགས་པ།",
    "ཉོན་མོངས་རང་སར་གྲོལ་བས།",
    "བདག་ཅག་དུས་འཛོམ་པ་དང་གསང་སྤྱོད་ཆེན་མོ་དང་།",
    "ཁྱོད་ཞུ་བ་འདི་རྣམས་སྤྱིར་གཞན་ཁྱེབས་སུ་འགྱུར་ཞིང་།",
    "བྱེ་བྲག་ཁྱོད་ཀྱི་དོན་དུ་བཀོད་པར་བྱ་གསུངས་ནས་ཁྲིགས་སུ་བཀོད་ཅིང་བ་དམར་ཁྲིད་དུ་བཏབ་ནས།",
    "རྒྱུན་ཁྱེར་རྣམས་ཁྱོད་རང་གིས་བཀོད་པའི་དོན་དུ་འགྱུར་བར་འདུག་གིས་གསུངས།",
    "ཁྱོད་བྱ་སྤྱོད་རྣལ་འབྱོར་སྒོམ་ཆེན་གྱི་ཆ་ཟུང་ལ།",
    "གཉན་ཁྲོད་བརྒྱ་རྩ་འགྲིམས་ལ་གཞན་ལ་ཕོག་པས་རང་གཞན་གྱི་དོན་དུ་འགྱུར་བར་འོང་གི་གསུངས།",
    "ཁྱོད་ཀྱིའང་ཕ་དེ་ད་ལོའམ་ཉེ་བར་ཤི་དགོས་ཡོད།",
    "ད་སྟེ་ལོ་གསུམ་ན་ཁྱོད་ཀྱང་འདི་ངོས་སུ་ཤོག་ལོ་གསུམ་པོ་དེ་ཉམས་ལེན་འདི་ལྟར་གྱིས་དང་།",
    "དེ་ལ་དག་གིས་ཁྱེད་ཀྱི་གསུང་ཕྱོགས་མི་བཟང་བས།",
    "རྗེའི་ཞལ་ནས་ཁྱོད་མ་དངངས་མ་སྐྲག་ང་ཤི་ཡང་བསྟན་པ་ནུབ་དོགས་མེད།",
    "བསྟན་པ་ནུབ་དོགས་ཀྱི་སྡུག་བསྔལ་ཁྱོད་ལ་མི་དགོས་ཀྱི་ངས་སྨྲས་པའི་རང་དོན་ཚགས་སུ་ཆུགས།",
    "ཚོགས་ཀྱི་འཁོར་ལོ་བསྐོར་ཞིང་ཟབ་མོའི་མཛད་སྤྱོད་དུ་མ་དང་ལྡན་པར་གདའ་གསུང་ངོ།",
    "དེ་རྣམས་ནི་གཤིས་འབྱུང་ལས་གསུངས་པའི་རིམ་པ་ཟུར་ཙམ་མོ།",
    "བདེར་གཤེགས་ཀྱི་ཞལ་གནམ་གྱི་སྐར་མ་ཙམ་མ་འགྲིབས་པར་གསལ་བར་གཟིགས་པར་གདའ་འོ།",
    "འབྲས་བུ་རེ་དོགས་སྒྲུབ་པ་སད་པས།",
    "དེ་ནས་ཤིང་ཕོ་སྟག་གི་ལོ་ལ་གཞན་དོན་ལ་གཤེགས་པར་དགོངས་ནས།",
