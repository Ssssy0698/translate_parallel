    "གལ་ཏེ་ཁྱོད་འགྲེད་བ་ལ་བབན་ཡང་མ་འདུག་པར་མྱུར་དུ་ཤོག་ཤིག།",
    "གླང་པོ་ཆེས་སྲུང་གི་བུ་ལྟ་བུ་དག་དང་།",
    "རྒྱལ་པེ་ཀ་ནལ་ང་ན་རེཕྲིན་ཡིག་མཐོང་བ་ཁོ་ནའི་ཚེ་གལ་ཏེ་ཁྱོད་འགྲེང་བ་ལ་བབ་ན་ཡང་མ་འདུག་པར་མྱུར་དུ་ཤོག་ཤིག།",
    "དེ་ནས་རྒྱལ་པོ་ཀབི་ན་ཆེན་པོ་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་དུ་སོང་ནས་མཐོང་མ་ཐག་ཏུ་དེའི་གཟུགས་ལ་གཟུགས་ཀྱི་རྒྱུགས་པ་དང་།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ནས་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བྱས་ཏེ།",
    "ལུས་ཅན་དག་གི་ལས་རྣམས་ནི།",
    "རི་མོ་བྱས།",
    "དེ་ནས་རྐྱལ་པོ་ཟས་གཙང་གིས་ཤཱཀྱ་ཐམས་ཅད་བསྡུ་བའི་ཕྱིར་གྲོད་ཁྱེད་དུ་དྲལ་བ་སྒྲགས་སོ།",
    "འདི་དག་བཏང་ལ་བདག་ཀྱང་འདི་དག་གི་རྗེས་སུ་རབ་ཏུ་འ་བྱུད་གོར་མ་ཆག་སྙམ་མོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅང་སྤངས་ནས་དགྲ་བཙེམ་པ་ཉིད་མངོན་སུམ་དུ་བྱས་ཏེ།",
    "ཕྱྀ་ཞིག་ན་སྡ་དྲེ་ཤ་མ་ཐབས་དང་ཚོས་གོས་བགོས་ཏེ་ལྷུང་བཟེད་ཐོགས་ནས་མཉན་དུ་ཡོད་པར་སྤྱོད་ཡུལ་ལ་ཆས་སོ།",
    "དེ་ནས་རྒྱལ་པོ་གསལ་རྒྱལ་བཙེམ་ལྡན་འདས་ཀྱི་ཐད་དུ་སོང་སྟེ།",
    "དགེ་སློང་དག་བཟང་ལྡན་ཉིད་ཀྱིས་སྔོན་ཚོ་རབས་གཞན་དག་ཏུ་ཚོག་ས་རེད་ཅིང་རྐྱན་གྲུབ་པ་དང་ལྡན་ཏེ་དབའ་རྒལ་བཞིན་དུ་འབྱུང་ལ།",
    "ལུས་ཅན་དག་གིས་ལས་རྣམས་ནིབསྐལ་པ་བརྒྱར་ཡང་ཆུ་དམི་ཟ།",
    "དགེ་སློང་དག་དེ་བས་ན་ལས་གཅིག་ཏུ་ངེས་པར་གནག་པ་རྣམས་དང་ལས་འདྲེན་མ་རྣམས་སྤངས་༨ ལལས་གཅིག་ཏུ་རེས་པར་དཀར་བ་རྣམས་འབའ་ཞིག་ལ་གཏད་པར་བྱ་སྟེ།",
    "འོད་འདོམ་གང་གིས་བརྒྱན་པ།",
    "དེནས་ཡུལ་འཁོར་སྐྱེང་ག་བི་མ་གཉིས་བུ་ཡུལ་འཁོར་སྐྱོད་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བུ་ཡུལ་འཁོར་སྐྱོད་ལ་འདི་སྐད་ཅེས་སྨྲས་སེ།",
    "ཁྱོད་ན་སྡུག་མ་མྱོང་བ་ཡིན་ལ་ཚངས་པར་སྤྱོད་པ་ནི་སྤྱད་པར་དཀའོ།",
    "དེནས་ཁྱིམ་ༀ བ་དག་གི་བུ་ཡུལ་འཁོར་སྐྱོད་གི་གྲོགས་པོ་རྣམས་ཡུལ་འཁེར་སྐྱོང་ག་ལ་བདེར་དོང་སྟེ་ལྷགས་ནས་ཁྱིམ་བདག་གི་བུ་ཡུལ་འཁེར་སྐྱེད་ལ་འདི་སྐདཅེས་སྨྲས་སོ།",
    "དེ་ནས་ཁྱིམ་བདག་གི་བུ་ཡུལ་འཁེ་ར་སྐྱེད་གི་གྲོགས་པ་རྣམས་ཡུལ་འཁོར་སྐྱོང་གི་ཕ་མ་གཉིས་ག་ལ་བ་དེར་དོང་སྟེ་ལྷགས་ནས་ཁྱིམ་བ་དག་གི་བུ་ཡུལ་འཁོར་སྐྱེད་ག་ཕ་མ་གཉིས་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "དེ་ནས་ཁྱིམ་བདག་གི་བུ་ཡུལ་འཁེར་སྐྱོང་གི་གྲོགས་པོ་རྣམས་ཁྱིམ་བདག་གི་བུ་ཡུལ་འཁེར་སྐྱོང་ཉིས་བརྒྱདབརྒྱད་འོག་༣ ག་ལ་བ་དེར་དེང་སྟེ་ལྷགས་ནས་ཡུལ་འཁོར་སྐྱོང་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "དེ་ནས་ཁྱིམ་བདག་གི་བུ་ཡུལ་འཁོར་སྐོང་ཁང་ཀྱིས་ལུས་ཀྱི་མཐུ་དང་སྟོབས་བསྐྱེད་ནས།",
    "བསྙེན་བར་རྫོགས་ཤིང་དགེ་སློང་གི་དངོས་པོ་ཐོབ་པར་གྱུར་ཏོ།",
    "ཡུལ་འཁོར་སྐྱོད་ཉིད་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་དེ་དག་གཞནས་ཞིག་གིས་ཉམས་སུ་མྱོང་བར་འགྱུར་ཏེ་དགེ་སློང་དག་ལས་བྱས་ཤིངབསགས་པ་རྣམསན་ཕྱིརལོ་གྱི་སའི་ཁམས་ལ་རྣམ་པར་སྨིན་པར་མི་འགྱུར།",
    "ལུསཝཱཅན་དག་གི་ལས་རྣམས་ནི།",
    "མྱ་ངནལས་འདས་པའི་འོག་ཏུ་ཡང་དེའི་སྐུ་གདུང་གི་མཆོད་རྟེན་བརྩིགས་ནས་སྨོན་ལ་མ་བཏབ་པ།",
    "དེ་ནས་དེའི་བུ་ཐ་ཆུངས་དྲད་སྲོང་སྣ་བར་སོང་པ་དང་།",
    "འོད་འདོམ་གང་གིས་བརྒྱན་པ།",
    "ཡུལ་འཁོར་སྐྱོང་གིས་ནི་ལས་གཞན་དག་ཀྱང་བྱས་འདི་བསགས་ཏེ།",
    "བདག་གིས་ཀྱང་ཡོན་ཏན་འདི་ལྟ་བུ་དག་ཐོབ་པར་གྱུར་ཅིག།",
    "དེས་དེལ་སྟེ་ང་རྗེ་བསྐྱེད་ནས་རིགས་ཀྱི་བུ་། འདི་ནི་ཁྲོ་བ་དང་ཞེ་གནག་པའི་ཤས་ཆེ་བས་ཁྱད་པར་ཐོབ་པར་མིའགྱུར་གྱིས་བདག་གིས་འདི་བཙེམ་ལྡན་འདས་ལ་ལྟར་བཞུག་གོ་སྙམ་མོ།",
    "ད་ཐོས་ནས་རིགས་ཀྱི་བུ་རབ་འབྱོར་གྱིས་འཇིག་ཚོགས་ལ་ལྟ་བའི་རིའི་རྩི་མོ་མཐོན་པོ་ཉི་ཤུ་ཡེ་ཤེས་གཉིས་རྡོརྗེས་བཅོམ་ནས་རྒྱུ་ན་ཏུ་ཞུགས་པའི་འབྲས་བུ་མངོན་སུམ་དུ་བྱས་ཏེ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ནས་དགྲ་བཙེམ་པ་ཉིད་མ་དོན་སུམ་དུ་བྱས་ཏེ།",
    "ལས་གང་གིས་སྐྱེས་པ་བསམས་པ་དང་ངེས་ཚེ་རབས་ལྔ་བརྒྱའི་བར་དུ་ཀླུ་ལས་ཤི་འཕོས་ཏེ་ཀླུ་འབའཞིག་ཏུ་སྐྱེས་པར་མཐོངངོ།",
    "མལ་བདག་གིས་དེ་ནི་སྐྱེ་བོ་མང་པོ་ལ་བན་༣།",
    "ངེས་དེ་རྗེལྟར་ཀླུདང་ནམ་མཁའ་ལྡིང་གི་རིགས་ལྔ་བརྒྱ་ལྔ་བརྒྱ་བརྟུལ་ཏོ།",
    "དགེ་སློང་དག་ངའི་ཉན་ཐོས་ཀྱི་དགེ་སློང་ཉོན་མོངས་པ་མེད་པར་གནས་པ་རྣམས་ཀྱི་མཆོག་ནི་འདི་ལྟ་སྟེ།",
    "བཙུན་པ་ཚོདང་ལྡན་པ་རབ་འབྱོར་གྱིས་ལས་གང་དག་བགྱིས་ན་དེསཉོནམོངས་པ་མ་མཆི་ས་པར་གནས་པའི་མཆོག་ཏུ་བསྟནལ་གས།",
    "རབ་འབྱོར་ཉིད་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་དེ་དག་གཞན་སུ་ཞིག་གིས་ཉམས་སུ་མྱོང་བར་འགྱུར་ཏེ།",
    "ལུས་ཅན་དག་གི་ལས་རྣམས་ནི།",
