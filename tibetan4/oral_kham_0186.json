    "འགྲོ་དོན་འདུག་གམ་མི་འདུག་ལྟོས།",
    "སྤྲོས་པའི་མཐའ་བརྒྱད་དང་བྲལ་བ་དེ་གཤིས་སམ་བབས་ཀྱི་འདུག་ཚུལ་ཡིན་གསུང་།",
    "ལ་ལ་གཙོ་བོའི་ཕྱག་མཚན་རྡོ་རྗེ་མི་འབྲི་བར་ཁ་ཊྭྃ་མི་འབྲི་བ་འདུག་ཀྱང་།",
    "བོད་ཀྱི་ལུགས་གཉིས་ཀྱི་བདེ་རྩ་སླར་གསོ་ཐུབ་པའི་སྡོང་པོའི་རྩ་བ་ཚུགས་པ་ལྟ་བུ་ཞིག་ལོས་ཡིན།",
    "དེའི་ཚིག་འགྲེལ་རྒྱག་དུས།",
    "བྱུང་རོགས་བྱས་ན་གྲྭ་སྐོར་དེ་ལོ་གཅིག་གཉིས་ཤིག་འགྱངས་ཐབས་མི་འདུག་གམ་ཟེར་བ་དང་།",
    "དེ་སྐབས་འཐུས་ཤོར་ཕྲན་བུ་ཕྱིན་འདུགབྱབྱཅེས་ཐུགས་ཕམ་དང་བཅས་བཀའ་གནང་ཞིང་།",
    "དེ་ནི་ཧ་ཅང་སུན་པོ་ཡོད་གསུངས་ཀྱི་འདུག་ཕྱོགས་གཅིག་ནས་སུན་པོ་བྱུང་གནང་ཡོད་ན་ཡང་།",
    "དེ་གཉིས་གང་ཞིག་གསན་ནའང་ཁྱད་པར་མི་འདུག་གསུང་བྱུང་།",
    "དཔེ་མི་སྲིད་པའི་དྲིན་ཆེན་པོ་ཡིན།",
    "དེ་འདུམ་བདེ་པོ་ཞེ་དྲག་འདུག་དེར་གང་འཚམས་བལྟས་པ་ཡིན།",
    "བྱབྱཞེས་ཚིག་དེ་འདུག་པ་མཐོང་མ་ཐག་དགའ་ལྷང་ལྷང་ངང་ངོས་རང་གསང་བ་འདུས་པར་འཆད་ཉན་ཏོག་ཙམ་བྱེད་ཐུབ་ཀྱི་ཡོད་དམ་བསམ་པ་བྱུང་།",
    "རང་རང་གོ་བབ་ཀྱི་གདན་གྲལ་དུ་འཁོད་མཚམས་ཞབས་རས་དང་།",
    "དེ་ནས་ཕར་ཙམ་ན་བྲག་རྡོ་དང་།",
    "དེ་ནས་མི་གྲངས་བཅུ་ཙམ་འདུག་པས་ཐག་ཉེར་སླེབས་སྐབས་བྱབྱཁྱེད་ཚོ་གང་དུ་འགྲོ་མཁན་ཡིན་བྱབྱགསུངས་པར།",
    "རང་རང་གདན་ཐོབ་ཐོག་འཁོད།",
    "དེ་འདྲ་ཡིན་དུས་འགལ་བ་གང་ཡང་མི་འདུག་བསམ་ནས།",
    "ཙོན་ཟེར་ས་དེར་མཚར་སྣང་ཆེ་བའི་འོད་གཏང་ཡ་ཞིག་འདུག་པ་དེར།",
    "དེ་ཚོ་མི་བདེ་བ་ཞིག་མི་འདུག་གམ།",
    "བྱམི་ཟླ་བའི་སྒང་ལ་བསྐྱོད་དེ་ཟླ་བའི་གནས་ཚུལ་འདི་འདྲ་འདུག་བྱཅེས་ལབ་པར།",
    "ཞིབ་འཇུག་བྱེད་དགོས་ཀྱི་འདུག་ཅེས་ཤོད་ཀྱི་ཡོད།",
    "ཟེར་གྱི་འདུག་རྩ་བ་དུས་ཚོད་དེའི་ཚེ་དེའི་དུས་རྒྱ་གར་ནང་ཡོངས་བསྒྲགས་གྲགས་ཚོད་ཅིག་མིན་ནམ་བསམ་གྱི་འདུག་དེ་དུས་བཅོམ་ལྡན་འདས་ཀྱིས།",
    "སྣེ་ཁ་གཅིག་པོ་ཁོ་རང་ངོས་ནས་བལྟས་པ་ཡིན་ན།",
    "ལྷན་ཅིག་དུས་སྟོན་རོལ་བའི་ཡོ་ལང་སོགས།",
    "བཀའ་བློན་རྣམ་པས་མཚོན་གཞུང་ཞབས་སེར་སྐྱ་ཡོངས་རྫོགས་མཛད་ཞབས་སུ་རང་རང་གདན་ཐོབ་སོ་སོར་འཁོད།",
    "དེ་ཡང་རང་ཅག་ལྟར་ཉིན་མཚན་ལོ་ཟླ་སྦྲེལ་པའི་དུས་སྐབས་མེད་པར་ཆབ་སྲིད་མཛད་བྲེལ་གྱི་ཞོར་ལས་ལྟ་བུ་གྱུར་པ་ཞིག་ལ།",
    "འགག་ཏུ་རང་རང་གདན་ཐོབ་ཐོག་གདོང་ཁྱམས་རར་ཕྱོགས་ཏེ་འཁོད།",
    "འཁོར་གསུམ་འཕྱར་རྒྱག་མེ་མདའ་དགུ་ཤོག་དུས་གཅིག་ཏུ་བརྒྱབ་སྟེ་རྔམས་ཟིལ་ཆེན་པོས་ནག་ཕྱོགས་དཔའ་སྐོང་བའི་ཚུལ་དུ་བྱས།",
    "ཡ་སོར་ངོ་ལས་བཅས་ནས་རང་རང་སྐབས་བབས་ཞུ་སྒོ་ཟིན་པའི་སྙན་སེང་མཇལ་ཁ་དང་།",
    "ཉི་འོད་འགག་རྡོ་གཅལ་དང་བཅས་པར་རང་རང་གདན་ཐོབ་ཐོག་དྲུང་ཇ་དང་པོ་དང་།",
    "ད་ཡག་པོ་མི་འདུག་རྒྱ་མི་ལ་ཡིད་ཆེས་གནང་ཡག་མི་འདུག་ཅེས་གསུངས་བྱུང་།",
    "དེང་སང་ཟིང་འཁྲུག་ཆེན་པོ་ལངས་བསྡད་ཡོད་འདུག་ཅེས་གསུངས་བྱུང་།",
    "ཁྱེད་རང་རྒྱ་གར་ལ་ཕེབས་འདོད་འདུག་གམ་མི་འདུག་ཅེས་དྲིས་བྱུང་།",
    "དེར་ངས་སྣང་མེད་ངང་ནས་དམིགས་བསལ་འགྲོ་འདོད་གང་ཡང་མི་འདུག་ལབ་པ་ཡིན།",
    "ཁྱེད་རང་ནས་ཞལ་བཞེས་གནང་བ་བཞིན་ཡིད་ཆེས་བློ་འཁེལ་ཡོང་བ་དང་།",
    "བྱབྱཞེས་སོགས་རྒྱ་དཔོན་གྱི་བློ་ལ་བབས་པའི་གནས་ལུགས་གསུངས་འདུག་མཐར་ཕེན་ཏེ་ཧོས་ཀྱིས་བྱབྱཡག་པོ་འདུག་ངས་ཁྱེད་རང་ལ་ཡིད་ཆེས་བྱེད་ཀྱི་ཡིན།",
    "ལམ་སང་ངོ་གདོང་དམར་པོ་སྟོན་གྱི་འདུག་ལ།",
    "ཐན་ཀོན་སན་ལྷ་སར་ཡོད་མུས་ཁོང་རང་ཡང་ངོ་བཅར་མ་ཞུས་པར།",
    "ངེས་པར་ཕེབས་རོགས་གནང་བྱབྱཞེས་ཞུས་འདུག་པར།",
    "རུ་དཔོན་བསོད་བཀྲས་ཀྱིས་རྒྱ་དམག་ཁོ་འཇུས་ནས་ས་ལ་བརྡབས་པས་ཉེན་ག་ལས་གཡོལ་ཐུབ་པ་བྱུང་འདུག་རུ་དཔོན་བསོད་བཀྲས་ནི།",
    "རྒྱལ་བའི་སྐུ་ཕྱྭར་བདོ་བའི་དམིགས་དོན་ཀྱང་སྒྲུབ་ཐབས་བྱེད་རྒྱུ་ཡིན་འདུག་དངོས་དོན་ཐོག་རྒྱ་དམག་ཁོ་ཉི་འོད་འགག་ཏུ་ཡར་ཡོང་ཐུབ་པ་ཡིན་ནའང་།",
    "ཁོང་རང་ངོ་མར་གོང་སྐོར་གནས་ཚུལ་དྲིས་པར།",
    "མདའ་དཔོན་རྒྱ་སྐད་མཁྱེན་པས་འདྲི་རྩད་གནང་འདུག་ཀྱང་།",
    "ཕྱི་ཉིན་དེར་སྐུ་ངོ་མདའ་དཔོན་གྱིས་ཆིའི་གཡིད་ནུང་ཁྲང་ཟེར་བའི་རྒྱ་མིའི་དམག་སྒར་དུ་འདི་སྐོར་གསུངས་འདུག་དེ་ནས་དུས་ཐུང་ནང་རྒྱ་མིའི་དམག་དཔོན་ཞིག་དང་།",
    "དེ་དོན་སྤྱི་མཁན་གྱིས་ལི་ཙོའོ་མིང་ལ་བཀའ་གསལ་གནང་འདུག་དེའི་གནངས་ཉིན་༥༩།",
    "དམག་དཔོན་ཕུའུ་ཡིས་མདའ་དཔོན་ཁྱེད་རང་ཕེབས་རོགས་ཞེས་འབོད་པར་བཏང་བྱུང་བརྗོད་འདུག་དེར་སྐུ་མདས་ད་ལྟ་ངས་ཞོགས་ཇ་འཐུང་བཞིན་ཡོད།",
    "ཆུ་ཚོད་བཅུ་པའི་གོང་ལ་འབྱོར་ཐུབ་པ་བྱེད་རྒྱུ་ཡིན་གསུངས་ནས་ཁོང་གཉིས་ཕྱིར་སློག་གནང་འདུག་དེ་ནས་ཆུ་ཚོད་གཅིག་ཙམ་རྗེས།",
    "སྐུ་སྲུང་མདའ་དཔོན་གྱིས་ཚེས་གྲངས་གཏན་འཁེལ་ཨེ་ཡོད་ཅེས་དྲིས་གནང་འདུག་དེར་དམག་དཔོན་དེས་མིག་ནག་འབུར་ཚུགས་སུ་ལྟ་བཞིན།",
    "དེའི་ཆེད་དུ་ཡིན་བྱབྱཞེས་བརྗོད་འདུག་དེ་ལ་སྐུ་མདས་བྱབྱསྐུ་མདུན་འདི་གར་ཕེབས་ཀྱི་ཡོད་པའི་སྐོར་འདི།",
    "བྱབྱཞེས་འཇམ་མཁས་ཀྱིས་དྲིས་གནང་འདུག་པར།",
    "ཆིབས་ཞབས་སུ་རྩེ་མགྲོན་གཉིས་མ་གཏོགས་དགོས་ཀྱི་མི་འདུག་དེ་དོན་བཀོད་སྒྲིག་གནང་དགོས་བྱབྱགསུངས་འདུག་དྲུང་ཇ་གྲོལ་རྗེས།",
    "དེ་ནས་ལམ་སང་མགྲོན་ཆེ་ལས་ཤག་ཏུ་ཕེབས་འདུག་དེར་རྩེ་མགྲོན་བདུན་བརྒྱད་ཅིག་ཡོད་པ་རྣམས་སྐད་ཆ་བྱས།",
    "བྱབྱཞེས་ཞུས་འདུག་རྩེ་མཁན་མགྲོན་ཆེ་བས།",
    "བྱབྱཅེས་སོགས་གསུང་ལན་ནན་ཙམ་བྱུང་འདུག་དེ་གར་མཁན་ཆུང་རྟ་ར་བས་བྱབྱཞུ་ཕྱོགས་ལོག་ཀྱང་།",
    "རང་རང་ས་ཁུངས་སོ་སོར་བརྒྱུད་བསྒྲགས་བྱས་པས།",
    "ཚང་མར་རྒྱུན་ལྟར་ཉལ་ཐབས་བྲལ་བའི་སེམས་ཁྲལ་བློ་འཚབ་སྣོན་མ་ཤུགས་ཆེ་ཞིག་བྱུང་འདུག་དེ་མིན་བོད་མི་ཚོ་དོགས་འདྲོག་སྐྱེ་གཞིའི་གནས་ཚུལ་གཞན་དག་ཀྱང་བྱུང་བ་དཔེར་ན།",
    "བོད་མི་དམངས་རང་རང་འཚོ་གོས་འགྲིགས་ཙམ་ལ་ཆོག་ཤེས་བྱེད་ཅིང་།",
    "ང་རང་ཡང་སྔར་འགྲོ་མ་མྱོང་བ།",
    "བྱབྱཞེས་འཁོད་འདུག་པ་བཅས་ལས།",
    "མི་སུ་ཡིན་ཡང་རང་དགར་ནང་དུ་བཏང་མི་ཆོག་ཅེས་བཀའ་བཀོད་གནང་ཐོག་སྐུ་མདའ་ཁོང་ཉིད་ལམ་སང་དམག་སྒར་ནས་གཞུང་སྒོའི་ཕྱོགས་སུ་ཕེབས་དུས།",
    "ཚིག་སྒྲ་གསལ་མིན་གྱི་སྐད་སྒྲ་སྒྲོག་བཞིན་ཡོད་པ་དེ་གསན་ཐོས་བྱུང་འདུག་དེའི་གོང་ཙམ་ནས་གོང་ས་མཆོག་རྒྱུན་གྱི་ཐུགས་དམ་ཉམས་བཞེས་གྲུབ་སྟེ།",
    "དངོས་དོན་ཇི་ཡིན་རྟོག་ཞིབ་ཀྱིས་སྙན་སེང་ཞུ་དགོས་བཀའ་མངགས་བསྐྱངས་འདུག་འདི་སྐོར་གོང་ས་ཆེན་པོའི་རང་རྣམ་ངོས་ཀྱི་ཡུལ་དང་།",
    "སྤོས་བཟང་པོའི་དྲི་ངད་མངར་སིང་ངེར་འཐུལ་བཞིན་པར་བསམ་གཏན་བདེ་བའི་གནས་བཀོད་ཞི་འཇམ་བག་ཕེབས་རྣམ་ཀུན་བཞིན་དུ་འདུག་དེར་རྒྱུན་གྱི་དགེ་སྦྱོར་རིགས་བྱས་ཏེ་སྔ་དྲོ་ལྡུམ་རའི་ནང་རྐང་འཆམ་བྱེད་རྒྱུར་རྒྱུན་གོམས་ཡོད་པ་ལྟར།",
    "ངོས་རྒྱ་མིའི་དམག་སྒར་དུ་འགྲོ་རྒྱུར་བཀག་འགོག་ཆེད་ཡོང་ཚུལ་བརྗོད་ལུགས་ཟེར་གྱི་འདུགབྱབྱཅེས་འཁོད་པ་དང་།",
    "སྐུ་སྲུང་བ་གཅིག་མགྱོགས་པོ་ཡར་ཡོང་ནས་གཞུང་སྒོ་བརྒྱབས་ཤག་ཟེར་གྱི་འདུག་ཁོ་པས་མི་མང་པོའི་སྐད་འུར་ཆེན་པོ་ཞིག་ཐོས་པ་ཙམ་ལས།",
    "ཕེབས་འཁོར་མདུན་མི་མང་འཁྲེད་ཉལ་གྱིས་རང་སྲོག་འདོར་ངེས་ཡིན་ལུགས་ཞུ་འདུག་པ་མ་ཟད།",
    "དེ་ཡང་ཁོ་རང་རྣམ་ཀུན་རྒྱ་མི་དང་འབྲེལ་བ་ཆེན་པོ་ཡོད་པ་དང་།",
    "ལྷག་པར་དེ་ཉིན་སྔ་དྲོར་ནོར་གླིང་དུ་དྲུང་ཇར་ཁོ་རང་གྲྭ་ཆས་གྱོན།",
    "གང་བྱུང་ཟང་ཟིང་དུ་བསྡད་ན་མི་འགྲིག་པས་དེ་ཚོར་བཀོད་སྒྲིག་སློབ་སྟོན་བྱེད་མཁན་ཞིག་ངེས་པར་དགོས་ཀྱི་འདུག་མཁན་ཆུང་རྟ་ར་བ་དང་།",
    "མི་མང་ངོ་ལོག་པ་ཚོས་ལྷ་སའི་བྱང་རྒྱུད་གཞུང་ལམ་ཉེ་འགྲམ་དུ་འཛིང་རགས་བཟོས་འདུག་པ་དེ་དག་མེད་པ་བཟོ་དགོས་བཀའ་ཤག་ནས་བཀོད་འདོམས་མ་བྱས་ན།",
    "ད་ལྟ་འདི་གར་ཕྱི་ནང་གང་ཐད་ནས་བྱ་དཀའ་བྱེད་གཏད་ཆེན་པོ་འདུག་རུང་།",
    "བྱབྱདམག་དཔོན་དེའི་ཡི་གེ་དེ་དག་མཛའ་གྲོགས་ཀྱི་རྣམ་འགྱུར་ཆེན་པོའི་ཚུལ་དུ་བྲིས་འདུག་ཅིང་།",
    "དེའི་ནང་ལྷ་སའི་ཕྱི་ལོགས་སུ་ཡོད་པའི་རྒྱ་ནག་ཏུ་འགྲོ་སའི་ལམ་ཆེན་ཁར་མི་དམངས་ནས་འཛིང་རགས་བཟོས་འདུག་པ་དེ་དག་མེད་པ་བཟོ་དགོས་བཀའ་ཤག་ནས་བཀོད་ཁྱབ་དགོས་ཚུལ་དང་།",
    "སྣེའུ་ཤག་མགྲོན་ཆེ་བཅས་ནས་འཁུར་དགོས་ལུགས་བརྗོད་འདུག་བཀའ་ཤག་ནས་མི་མང་འགོ་ཁྲིད་འགུགས་འབོད་ཀྱིས་ལམ་ཁའི་འཛིང་རགས་ཕྱིར་འཐེན་བྱས་ན་ལེགས་པ་དང་།",
    "དེ་སྔོན་ཀ་བློན་སྦུག་ཏུ་༡༩༥༦ལོརཀླུ་ཁང་པས་བྱམི་འུ་ཐུག་དུས་ལྷ་ལ་ཞུས།",
    "གནང་ཡུལ་ར་མ་སྒང་ནས་འོས་ངེས་བྱབྱཞུས་འདུག་རུང་།",
    "མཆོད་རྫས་རྒྱན་འགྲེམས་བྱས་པ་རྣམས་བསྡུ་ལོང་མ་བྱུང་བར་རང་འཇགས་བསྡད་འདུག་ཅིང་།",
    "ཡག་པོ་ཞིག་ཡོད་འདུག་ཆིབས་པ་དེའི་སྐོར་གོང་ས་ཆེན་པོས་གསུངས་གསལ།",
    "གསོལ་ཚ་ལྟ་བུ་གོ་སྒྲིག་ཞུས་འདུག་པར་བརྟེན་གོང་ས་ཆེན་པོ་དེར་གདན་ཞུས་ཐོག་གསོལ་ཇ་བཞེས།",
    "ལུམ་པ་ལར་དུས་ཡུན་ཆུ་ཚོད་བཞི་ཙམ་ཕེབས་འགོར་བྱུང་འདུག་ལ་གཤམ་ནས་ཆུ་ཚོད་གཅིག་ཙམ་ཕེབས་ན་བན་རྩ་གྲུ་ཁར་འབྱོར།",
    "རྒྱ་ཚོས་གྱོན་པ་དཔུང་རྟགས་སེར་པོ་བརྒྱབ་པ་མང་པོ་ཡོད་པ་དེ་ཚོ་ནི་རང་འགུལ་དྭང་བླངས་དམག་ཁོངས་ཞུགས་པའི་གྲས་ཡིན་འདུག་གྲུ་ནང་ནས་ས་ཐོག་ཏུ་ཞབས་སོར་འཁོད་སྐབས་མི་མང་དེ་ཚོས་ཧ་ཅང་བློ་སེམས་སྐྱོ་བའི་རྣམ་འགྱུར་སྟོན་ཅིང་།",
    "སྐུ་སྲུང་རུ་དཔོན་བསོད་བཀྲས་དང་རང་འོག་དམག་སུམ་ཅུ་སྐོར་རྒྱལ་རྩེ་དང་།",
    "ཡར་ལུང་རྟེན་གསུམ་གནས་གསུམ་གྱི་གྲལ་དུ་འང་ཤོད་སྲོལ་འདུག་བཞུགས་ཞག་བཞི་པ་སྤྱན་གཡས་དགོན་དུ་མཛད།",
    "ཉེ་སྐོར་དགོན་ཁག་བཅས་པར་མེ་སྒྱོགས་གྲངས་མེད་དྲག་ཆར་བཞིན་འཕངས་འདུག་ལྷ་སའི་མི་མང་ཇི་ཙམ་བསད་རྨས་བྱུང་བ་སུས་ཀྱང་བརྗོད་པར་དཀའ་ཡང་།",
    "ནོར་གླིང་ཕྱི་ནང་དུ་མི་རོ་སྟོང་ཕྲག་འགའ་ཤས་མཐོང་རྒྱུ་ཡོད་འདུག་ནོར་གླིང་ནང་ཁང་པ་གཙོ་བོ་འགའ་ཤས་གཏོར་ཞིང་།",
    "ལྷག་པར་བན་དེའི་མགོ་ཅན་ཚོར་རྟོགས་ཞིབ་བྱས་པ་མཐོང་འདུག་ཅིང་།",
    "གངས་ཕྲན་བུའི་ཉུང་བས་སྐུ་ངལ་ཆུང་བ་བྱུང་འདུག་དེ་ནུབ་སྐུ་འཁོར་ཚང་མར་སྐྱོན་མེད་ལྷན་འཛོམས་བྱུང་བས་ཐུགས་བློ་བདེ་པོ་བྱུང་།",
    "གནམ་གྲུ་དེས་ལྡིང་སྐོར་ཙམ་མ་བརྒྱབ་པར་ཤར་རྒྱག་བྱང་ཤར་ཕྱོགས་སུ་བསྐྱོད་བབས་ལ་གཞིགས་ན་འགྲུལ་པ་ཚོ་མ་མཐོང་བ་ལྟ་བུ་བྱུང་འདུག་གནམ་གྲུ་དེར་རྟགས་ཇི་ཡོད་སུས་ཀྱང་མཐོང་མི་འདུག་པས།",
    "ཕར་ཙམ་ཞིག་ལ་ཉི་ཁུག་ཡག་པོ་ཞིག་ཡོད་པ་དང་།",
    "དར་ཅིག་གནམ་དྭངས་ནས་ཉི་མ་ཡང་དྲོ་པོ་ཞིག་འདུག་པར།",
    "བཀའ་བློན་རྣམ་པ་སོགས་རིམ་ཕེབས་གནང་བར་ཞལ་སྐྱེམས་ལྟ་བུར་འོ་ཇ་ཕུལ་བས་ཚང་མས་མཉེས་བཞེས་ཀྱིས་དེ་ནི་ངལ་གསོ་དང་བདེ་ཉམས་བྱུང་གསུངས་འདུག་ཆུ་ཚོད་གཅིག་ཙམ་ནས་གོང་ས་ཆེན་པོ་མནལ་ལས་བཞེངས་ཏེ་བསྙུན་བབས་ཕྲན་བུའི་དྭངས་སྐྱེས་བྱུང་ལུགས་ཕེབས་པས།",
    "དེ་ནས་མུ་མཐུད་ཕེབས་པས་རྒྱུགས་ཆུ་དེར་ཟམ་པ་ཞིག་འདུག་པ་དེ་ནི་བོད་དང་།",
    "འོས་པོ་ཞིག་མི་འདུག་པས་དེ་གར་ཙོག་བུར་སྡོད་དགོས་པ་བྱུང་ཞིང་།",
    "ས་མཚམས་དེར་བགྲོད་སྐབས་དམིགས་བསལ་གྱི་གནས་ཚུལ་གཞན་དག་གང་ཡང་མི་འདུག་ཅིང་།",
    "སྐབས་དེར་སྐུ་ཞབས་མེ་ནོན་ནས་ཀྱང་གོང་མཚུངས་སྲིད་བློན་ནེ་ཧ་རུའི་གསུང་འཕྲིན་ལྕགས་ཏར་ཞིག་ཕུལ་འདུག་དེ་སྐོར་རང་རྣམ་དབྱིན་དེབ་བོད་སྒྱུརལས།",
    "ནེ་རུས་བྱཞེས་འཁོད་འདུགབྱབྱཅེས་གསལ།",
    "བྱབྱཅེས་བཀའ་གནང་འདུག་པ་དང་།",
    "སྐྱིད་སྣང་གང་འདྲ་འདུགབྱབྱཅེས་གསུངས་མཇུག་ཡུད་ཙམ་དགོངས་པ་བཞེས་ཏེ།",
    "སེམས་འཚབ་ལྷག་པར་ཆེ་བ་ཞིག་མི་འདུག་གམ།",
    "དེ་མིན་ཐབས་གཞན་མི་འདུག་པས།",
    "བྱབྱཞེས་གསུང་འཕྲོས་གནང་འདུག་ཧར་མན་དར་སིང་ནས་གསུངས་དོན།",
    "ཁོང་གཏན་ཞལ་སྒེར་ཐོག་ནས་ཀྱང་དད་གུས་དང་བ་ཆེན་པོས་ཞབས་ཞུ་ཧ་ཅང་གཟབ་ལེགས་ཞུས་འདུག་པ་འདི་ནི།",
    "བྱབྱཞེས་སྐད་ཆེན་པོ་རྒྱག་མཁན་ཞིག་བྱུང་འདུག་དེ་ནི།",
    "སྐུ་ཞབས་ཧན་རི་ཆི་ཧར་རར་ཟེར་བ་དེ་ཡིན་འདུག་ཕུཊུ་ཧིལ་རི་མཚམས་དེ་ནས་ཕེབས་ཐོན་བསྐྱངས་སྐབས་ཕེབས་འཁོར་གསར་པ་ཞེ་གཅིག་གོ་སྒྲིག་ཞུས་འདུག་པ་དང་།",
    "བྱབྱཞེས་བཀའ་གནང་འདུག་༤",
    "ཚང་མར་ཐུགས་ཤུགས་ཆེན་པོ་སྐྱེད་དུ་བཅུག་པ་ལྟ་བུ་ཞིག་བྱུང་འདུག་༥",
    "སྐུ་འཁོར་ཆིབས་ཞབས་རྣམས་སྣེ་ཤན་ལས་བྱེད་ནས་སྣེ་ལེན་ཞུས་ཏེ་རང་རང་ཕེབས་སྒྲིག་ཁང་ཁུངས་སོ་སོར་འཁོད།",
    "དེའི་ཕྱི་ཉིན་གྱི་ལྡི་ལིའི་གསར་ཤོག་ཁག་སོགས་སུ་བཀོད་ཐོན་བྱུང་འདུག་པ་དང་།",
    "དེ་རྗེས་ཕྱི་རྒྱལ་གྱི་གསར་ཤོག་ཏུ་རིམ་བཀོད་བྱས་འདུག་ཆེན་པོ་ལ་འོས་བསྟི་སྟངས་རྒྱ་ཆེ་བཅས།",
    "བྱབྱསྲིད་བློན་མཆོག་ཉིད་ཕྱི་ཟླ་༤ ཚེས་༢༤ ཉིན་མ་སུ་རིར་གོང་ས་ཆེན་པོ་མཇལ་འཕྲད་དུ་ཕེབས་གཏན་ཡིན་བྱབྱཞེས་འཁོད་འདུག་པ་ལྟར།",
    "ད་ལྟའི་བོད་ཀྱི་དཀའ་ངལ་འདི་ལམ་སང་སེལ་ཐབས་དཀའ་བ་ཞིག་ཆགས་འདུག་བྱབྱཅེས་གསུངས།",
    "དགེ་སློང་གཞན་དག་བཞི་པོ་བཅས་རང་རང་ཞབས་སྟེགས་སུ་བཞུགས།",
    "སུ་ཡིན་ཡང་རང་གཞན་ཚང་མར་ཞི་བདེ་ཡོང་བའི་ཆེད་དུ་སྟོན་པ་བཅོམ་ལྡན་འདས་ཀྱིས་གསུང་བའི་བྱམས་དང་།",
    "སྐུ་མགྲོན་རྣམས་ནས་དགའ་ཞིང་གུས་པའི་རྣམ་འགྱུར་བཅོས་མ་མིན་པ་བསྟན་འདུག་༡",
    "ད་དུང་གྲངས་འབོར་འཕར་བཞིན་འདུག་སྐབས་དེར་ངོས་རང་ནས།",
    "སྐུ་མཆོག་ནས་ལས་དོན་ཆེ་ཆུང་ག་འདྲ་ཞིག་གནང་ཡང་རང་དོན་སྤུ་ཙམ་མེད་པར་གཞུང་དང་།",
    "ང་རང་བྱིས་པའི་སྐབས་སུ་ཁོམ་ལོང་ཡོད་དུས་གཟིམ་ཆུང་ཁ་ཤས་ནང་དུ་དངོས་ཆས་འདྲ་མིན་འཚོལ་བ་དེས་ང་ལ་སྤྲོ་སྣང་སྟེར་མྱོང་།",
    "ང་རང་ཆུ་ཚོད་གཏོར་བསྒྲིགས་འདི་ལ་བྱང་ཆ་ཐོན་ཏེ་ལྷ་སར་ཆུ་ཚོད་ཡོད་པའི་མི་ངོ་ཤེས་པ་ཚོའི་ཆུ་ཚོད་བཟོ་མཁན་གཙོ་བོ་ཆགས་ནའང་།",
    "བློ་ཕམ་པ་ཞིག་ལ་བགྲོ་གླེང་གྲོལ་རྗེས་ངའི་སེམས་ན་མང་པོ་བསྡད་མི་འདུག་ལོ་ངོ་བཅུ་ཕྲག་གཉིས་ཀྱི་རིང་ལ་སྦོད་མི་དང་མཉམ་དུ་གྲོས་བསྡུར་རིང་པོ་བྱས་པའི་ཁྲོད།",
    "ཁལ་མ་གཏོང་བ་སོགས་གཞུང་ཁྲལ་བསྒྲུབ་དགོས་པའི་དུད་ཚང་དེ་རྣམས་ལ་ནང་གསེས་ཁང་ཡོད་ཁང་ཆུང་ཟེར་བའི་ཐ་སྙད་ཅིག་ཐོགས་འདུགཁད་ཆུད།",
    "དེ་བཞིན་ཚིག་འབྲུ་སྔོན་མའི་སྒྲ་མཐོ་བའི་ཤུགས་ཀྱིས་ཚིག་འབྲུ་ཕྱི་མའི་སྒྲ་དམའ་པོ་ཡང་རང་བཞིན་གྱིས་མཐོ་བར་འགྱུར་འགྲོ་བ་ཡིན།",
    "འདི་ནི་རྒྱ་གར་ནས་བོད་དུ་དར་བ་ཞིག་ཡིན་འདུག་འདི་ལ་བྱསྒྲེང་ཁྲི་བྱདང་།",
    "བྱའཕྲུལ་བྱད་བྱཅེས་བྲིས་པའང་འདུག་པ་དེ་དག་ནི།",
    "བྱེད་པ་པོ་དང་དངོས་སུ་འབྲེལ་བའི་བྱ་ཚིག་དུས་འདས་པ་དང་།",
    "སློབ་དཔོན་གྱི་མདུན་དུ་གདན་དམའ་བར་འདུག་ཅིང་།",
    "དམའ་བར་འདུག་སྨྲས་བཟླས་པ་ཡིས།",
    "འདི་འདྲའི་རིགས་ཅན་མང་པོ་འདུག་པ་ལ་དགོངས་ནས།",
