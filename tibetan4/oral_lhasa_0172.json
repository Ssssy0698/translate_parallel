    "དགས་པོ་ལ་བར་ཀྱི་ཕུ་རྒྱུད་དེ་རྩ་རིར་ཕེབས་པས་ཐ་མལ་གྱི་སྣང་བ་འགགས་ནས་བན་བུན་ཉམས་ཀྱི་སྣང་བ་ལ།",
    "དེ་ནས་རྩ་རའི་གནས་ཀྱི་ཐུགས་ཡིད་འཕྲོགས་བཞིན་པའི་ངང་ནས་མྱང་སྟོད་མཁར་ཁར་ཕྱག་ཕེབས་ཡུམ་དང་མཇལོ།",
    "རྡོ་རྗེ་ནག་པོ་ཆེན་པོ་གུར་གྱི་རྗེས་གནང་བསྒྲུབ་ཐབས་རྣམས་གསན་ཅིང་།",
    "འཇིགས་པ་མེད་པར་སེངྒེ་ལྟ་བུའི་ཚུལ་གྱིས་སླར་ཅོ་ལོ་དང་བཞད་རྒདུ་མཛད་པས།",
    "ཧོར་ཤག་པས་རྣལ་འབྱོར་པ་བཟང་པོར་མཁྱེན་ནས་འདི་ཕྱོགསུ་ངེད་ཀྱི་མཆོད་གནསུ་གཞུགས་གསུང་བ་ལ།",
    "མ་བཞུཊ་པར་བྱོན་པ་ལས་ལམ་ཆས་མཛོད་ཟེར།",
    "ཐེ་ཚོམ་དང་ཡ་ང་མེད་པར་ཁྲོམ་ཀྱི་དཀྱིལ་གཤེཊ་ནས་འདོས་ཆེན་རྣམས་དགྱེལ་ཞིང་དུམ་བུར་གཏོར།",
    "ཐམས་ཅད་ཀྱི་བྱ་ཐབས་མ་རྙེད་པར་ཡ་མཚན་ཞིང་ཐེ་ཚོམ་དུ་གྱུར།",
    "ཞིང་སྐྱོང་ནག་པོ་སེང་གེ་སྡོང་ཅན་གྱི་རྗེས་གནང་བསྒྲུབ་ཐབས་སོཊ་མ་ལུས་པར་གསན།",
    "དེ་ནས་རྩ་རིར་བཞུགས་པའི་འཚོ་ཆས་དང་བཅས་ཏེ་རྩ་རི་བོད་ལུངསུ་ཕེབས།",
    "རྗེ་ཉིད་རྗེས་ནས་ཨུ་རྒྱན་གྱི་པད་ཞྭ་སྒྲོ་དར་དང་བཅས་པ་ཅིག་ཡོད་པ་དེ་དབུལ་བཞེས།",
    "དེར་རྗེ་ཉིད་ཀྱིས་ཁོང་རྣམས་ཡོང་པའི་ལམ་རང་དུ་འཕྲེད་ལ་གཟིམས་ནས་ལྟ་སྟངས་ལ་བཞུགས་ཚེ།",
    "ངས་དཔལ་དགེས་པ་རྡོ་རྗེ་ཤེས་གསུངས་པས།",
    "ཕྱི་ནང་སྟག་འཕྲོད་པའི་རྣལ་འབྱོར་པ་ཁོང་ཙམ་ལས་མ་མཐོང་གསུངས་བས།",
    "དེ་ནས་གནས་ནང་ལ་ཕེབས་པ་ལས་དེ་ནུབ་གཙང་པ་རྒྱ་འོ་ལ་ཡང་རྨི་ལམ་བཟང་པོ་སྔར་རྨི་མ་མྱོང་བ་བྱུང་ངོ།",
    "བྱ་པ་དཔོན་གཡོག་སྔོན་ལ་བྱོན་རྗེ་ཉིད་རྗེས་ཙམ་ལ་ཕེབས་ཚེ།",
    "གྲི་རིང་ཐུང་དབྱུག་པ་སོགྶ་ཀྱི་བསོད་ཅི་ཐུབ་བྱས་ཀྱང་མ་སྐྱོན་པ་དང་།",
    "དེ་ནས་དེའི་དགུན་དེ་ནས་བཟུང་ཏེ་གཙང་པ་སྤང་ཆུང་དུ་གཞུགས་ནས་ལོ་གསུཾ་གྱི་བར་གནས་ནང་ནས་ལ་ཕྱིར་མི་ཐོན་ཅིང་།",
    "ཉིན་གཅིག་དབོན་པོ་བ་མེད་པར་གཙང་པ་རྒྱའོ་ལ་སྙུང་གཡོག་བཅོལ་བས།",
    "དེར་ཁོས་སྤྱོད་ལམ་ལ་གདན་འདྲེན་ཚེ་བློས་མ་ལོངས་པར་དྲག་ཤུལ་གྱིས་ཀྱུར་བས།",
    "དེ་ནས་ཡང་སྔར་ལྟར་ཉིན་མཚན་གཅིག་ཀྱང་མ་ཡེངས་པར་བསྒྲུབ་པ་འབའ་ཞིག་མཛད་དོ།",
    "མྱུར་བར་འགྲོ་གསུང་རོ་དེའི་རྩར་ཕེབས།",
    "མཉམ་རྗེས་ཀྱི་བར་ལག་འགེལ་ཤེས་བྱ་ཇི་ལྟར་བ་དང་ཇི་རྙེད་པའི་མཁྱེན་པ་མ་ལུས་པ་རྒྱས།",
    "དུས་གསུམ་སྒྲིབ་པ་མེད་པར་གསལ་བ་མཁྱེན་པ་ཆེན་པོ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་གཞུགས་ནས།",
    "རང་དོན་དུ་ཕྱོགས་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་ཡང་།",
    "ཁྱད་པར་ཁྲོམ་གསེབ་དུ་གྱ་མཐོ་སྣ་ཚོགས་མཛད་པས།",
    "རྩ་རི་རོང་སྐོར་ལ་ཕེབས་ཕྱག་བཞི་ཕུག་དུ་ཞགཅིག་གནས་འབྲེལ་ལ་བཞུགས་ཚེ།",
    "དེ་ནས་དབྱར་གཉལ་དུ་ཕེབས།",
    "རྗེ་ཡི་ཁྱེད་ཚོ་ཅི་བྱེད་པ་ཡིན་གསུངས་པས།",
    "དེ་ལྷག་ནང་སོ་བཀྲིས་དར་རྒྱས་ལ་སྣང་ཞིང་ལྷག་མ་ལུས་པར་གསོལ་བས།",
    "ཏིངེ་འཛིན་ལ་བཞུགས།",
    "བརྟུལ་ཞུགས་ཀྱིས་སྤྱོད་པས་ཉུལ་ཞིང་ཕེབས་པ་ལས།",
    "ལྗོངས་མ་ལུས་པར་ཕེབས་ཞིང་མི་མ་ཡིན་མང་པོའི་དོན་མཛད།",
    "དེ་ནས་ལྷོ་བྲག་མཁར་ཆུར་ཕེབས།",
    "བསྒྲུབ་ཐབས་ཞང་འགྲོ་བའི་མགོན་པོ་ནས་གཙང་པ་ནས་གཙང་པ་རྒྱ་རས་ལ་རྒྱུད་པ་དང་།",
    "ཡར་ལུངས་ཚ་བ་གྲུར་ཕེབས།",
    "བྱིས་པ་རྣམས་ཆུ་རྩེད་བྱས་པས་ཆུས་སུབས་ཏེ་ཤིའོ།",
    "མཐོ་རིགས་ཀྱི་བདེ་བ་ཙམ་ཡང་མི་སྒྲུབ་པར།",
    "དེ་ནས་ལམ་གཙང་པོ་བྱང་ལ་རྒྱུད་ནས་ཤེལ་གྲོང་དུ་ཕེབས།",
    "གསུངས་ནས་ཚེམས་ཀྲིགས་ཅིང་ལྟ་སྟེངས་མཛད་པས།",
    "ང་ལ་བཀའ་སྐྱོན་ཡོང་ཁྱེད་མཁྱེན་གསུང་རོགས་མཛོད་ཞུས་པས།",
    "དེ་ནས་སྒོ་དྲུང་དུ་ཕེབས་ཚེ་འགྲོན་གཉེར་བས་གང་ནས་བྱོན་ཟེར་བ་ལ།",
    "རྗེ་བརྟུལ་ཞུགས་སྤྱོད་པས་ཆང་ལག་ནས་ཕྲོགས་དེ་བཞེས་ཚེ་དམག་རྣམས་ཀྱི་རལ་གྲི་དང་མདུང་རྣམས་ཀྱི་སྡིགས་དེ།",
    "གཙང་པ་སྨྱོན་པའི་ཕྱག་མཚན་ཡིན།",
    "དེ་ནས་རོང་ཆུང་རྒྱུད་ནས་ཡུམ་གྱི་དྲུང་དུ་ཕེབས།",
    "དེ་ནས་སྨོན་ལ་རྒྱུད་ནས་ཚ་འདར་ཕེབས།",
    "དེ་ནས་ཆུ་བར་ལ་ཕེབས་དགོངས་ནས་ལཾ་ཞོར་ལ་བླང་འཁོར་རྫ་རི་ཞེས་བྱ་བ།",
    "འབྱུང་པོ་དུ་མས་གང་བ་འཇིཊ་ཤིང་སྐྱི་གཡའ་བའི་གནས་དེར་ཕེབས།",
    "བསྟན་གཉེས་པའི་འཕྲིན་ལས་གནས་ཆེན་འཕགས་པ་ཤིང་ཀུན་ལ་ཕེབས།",
    "དེ་ནས་བལ་ཡུལ་དུ་ཕེབས་བོད་ཐང་མགོན་པོར་སྐངས་བཤག་སྐུལ་དང་བཅས་པ་མཛད་པས།",
    "དེ་ནས་འཕགས་པ་ཤིང་ཀུན་གྱི་བཅུ་གསུམ་འཁོར་ལོའི་འཁོར་གསུམ་པར་ཧུ་ལའི་སྟེང་དུ་ཞག་བདུན་རྡོ་རྗེའི་དཀྱིལ་དཀྲུངས་མ་བཤིག་པར་འོད་གསལ་ཕྱག་རྒྱ་ཆེན་པོའི་ངང་ལ་གཞུགས་པ་ལས།",
    "མཆོད་རྟེན་རྩ་བ་ནས་ཞིག་པའི་ཉམས་བྱུང་ཡང་རྡོ་རྗེ་ལྟ་བུའི་ཏིངེ་འཛིན་ལས་གཡོ་མེདུ་བཞུགས་པས།",
    "དྲང་སྲོང་འཕགས་པ་བཞུགས་པའི་ཏིགནས།",
    "སྲེགས་ནས་ཅི་བྱེད་པ་ཡིན་གསུངས་པས།",
    "འདི་གཙང་སྨྱོན་གྱི་མགོ་བསྲེག་ཟེར།",
    "འོ་ན་ང་ལ་ཡང་ཤ་སྦྱིན་ཅིག་གསུངས་པས།",
