    "བཞེས་ནས་ཁྱེད་རང་དཀའ་ཐུབ་ཐོགས་མེད་འདུག།",
    "བསེ་རག་ཡི་དྭགས་ཁ་རུ་མངོན་འབེབས་འདུག།",
    "མི་ཚད་ཙམ་ཡང་མང་དུ་མཇལ་དུ་འདུག།",
    "དེ་བཞིན་ཙོག་པུར་ལྔ་ལྡན་འདུག་སྟངས་མང་།",
    "དེ་ལྟར་སྨྲས་འདུག་མགོ་པ་ཐུགས་དཔྱད་མཛོད།",
    "ཁོ་རང་ངོ་ཚ་སྐྱེས་ནས་འདི་ལྟར་སྨྲས།",
    "དེ་ནི་ང་ཡི་གནས་མགྲོན་གཅིག་པ་འདུག།",
    "ཤིན་ཏུ་འཕྲོད་ཅིང་རབ་ཏུ་ཕན་པར་འདུག།",
    "བཙོན་གཡོག་ལྐུགས་པར་འདུག་པས་མིང་གང་འབོད།",
    "བློ་གཏད་གཅིག་ལ་འདུག་པ་སུ་ལ་གཏོད།",
    "མི་གཅིག་བཙོན་དུ་འདུག་པ་དཀའ་ཐུབ་དང་།",
    "བཙོན་གཡོག་ལྐུགས་པར་འདུག་པ་དཀའ་ཐུབ་རང་།",
    "སྙན་བརྒྱུད་ངོ་བོར་ཤོར་བས་མ་ཟབ་འདུག།",
    "ལྟ་དགོངས་ངོ་བོར་ཤར་བས་མ་མཐོ་འདུག།",
    "ལུས་ཀྱང་མི་ཤིགས་གཡུང་དྲུང་རང་ལུགས་གྱུར།",
    "ཡིད་ཀྱང་མི་འཁྲུལ་ཀུན་བཟང་རང་སར་གྲོལ།",
    "མ་བརྩལ་རང་འབྱུང་རང་ཤར་འདོད་དགུའི་དབྱིག།",
    "བསོད་སྙོམས་སློང་ནས་བསྔོ་བ་བྱེད་པར་འདུག།",
    "དགེ་སློང་ཚུལ་ལྡན་ལོ་ཆུང་ཞིག་འདུག་པ།",
    "བོན་ཆུང་ཞེས་བྱ་བོན་པོ་ཡོད་འདུག་ཚེ།",
    "དེ་ཡི་སྐྱེས་མཐའ་ད་ལྟ་ཁྱེད་རང་མངོན།",
    "སྔར་མིའི་གཏམ་གྱི་ཁ་དཔེ་ལ་འདུག་ཅེས།",
    "ཡང་ཡང་བལྟས་པས་དེ་རུ་ཁྲིག་གེར་འདུག།",
    "དེ་ལ་མཁར་སིལ་བཙུག་པས་རྡོ་རིལ་འདུག།",
    "ཡང་ཡང་བལྟས་པས་རྡོ་རིལ་དངོས་སུ་འདུག།",
    "བུག་པ་མཐོ་ཚད་འཛམ་ནག་སྐུ་སོགས་འདུག།",
    "འགྲོ་རྩིས་ཡིན་པས་ས་ཐག་གང་འདྲ་འདུག།",
    "ཅེས་སོགས་དྲིས་པའི་ཟླ་ལམ་གཅིག་འདུག་ཅེས།",
    "ཡང་སྟོན་ཀླུ་བྲག་ཅེས་པར་བོན་བསྟན་འདུག།",
    "ལ་སོགས་བཀའ་རྟགས་མཇལ་ཆོག་མང་དུ་འདུག།",
    "ཞེས་ཟེར་བདག་ལ་འདྲི་བ་བྱེད་པར་འདུག།",
    "འགྲོ་བ་སོ་སོ་རང་རང་སྒྲ་སྐད་དུ།",
    "ཁོ་རང་སྡོམ་པ་སྲུང་ཚུལ་འདི་རྣམས་ནི།",
    "རྒྱུད་ལ་འདི་མི་འདུག།",
    "གང་འདྲ་ཡིན་ན་ཆ་མི་རྟོགས་པར་འདུག།",
    "ཁྱེད་རང་བོན་པོ་རྣམས་ཀྱི་མ་བྱུང་འདུག།",
    "ཀླུ་བྲག་ཕྱོགས་ལ་མཁས་པ་བོན་བླ་འདུག།",
    "དེ་ནས་ཡོན་ཏན་མཁས་པ་ཐག་ཆོད་འདུག།",
    "ཁྱད་པར་ཁྱེད་རང་ཀླུ་བྲག་གྲྭ་བཙུན་རྣམས།",
    "དེ་ཡུལ་མི་རྣམས་ཆ་ལུགས་འདི་ལྟར་འདུག།",
    "བོད་སྐད་ལ་སོགས་སྣ་ཚོགས་ཤེས་པར་འདུག།",
    "རང་ལུགས་ཁྱད་འཕགས་ཡ་མཚན་ཆེ་བར་འདུག།",
    "དྲག་རྩལ་ཆེས་ཆེར་འདུག།",
    "ང་རང་ཕ་ཡུལ་གཅིག་པའི་གྲྭ་རྒན་ཞིག།",
    "ང་རང་སློང་མཁན་ལས་སྤྱོད་དེ་ཀ་ཡིན།",
    "འཇའ་དང་འོད་ཤར་ང་རང་མདངས་སྤྲོ་འདུག།",
    "ཅེས་ཟེར་ཚོད་ཡོད་ཆེས་ཆེར་བྱེད་པར་འདུག།",
    "དགེ་སློང་གསུམ་ཡང་གངས་བསྐོར་འགྲོ་འདུག་ཚེ།",
    "མཉམ་མེད་དྭགས་པོ་ཆེན་པོའི་ལུང་བཞིན་འདུག།",
    "བྱ་དུར་ལ་ཕུག་སོགས་ལ་འགྲོ་འདུག་འཛེམས།",
    "སྒྲིབ་སྦྱང་རྒྱུད་གཞུང་ཆ་ལག་ཚང་མར་འདུག།",
    "ཅེས་སྨྲས་ཀུན་ཀྱང་རང་རང་གདོང་ལ་ལྟ།",
    "ཁྱེད་རང་བོན་པོའི་སྟོན་པ་གཤེན་རབ་ལ།",
    "མི་ལ་བོང་བུའི་མཇེ་རྒན་ཡོད་པར་འདུག།",
    "འབྲུ་བརྒྱད་གང་ཡིན་ཆ་མི་གཏོགས་པར་འདུག།",
    "དྲུང་རམས་པ་རྣམས་ཕྱིར་ལ་འགྲོ་བ་འདུག།",
    "དེ་རྣམས་གང་ཡིན་ཆ་མི་རྟོགས་པར་འདུག།",
    "ཉན་པ་ཞེས་བྱ་ལྷས་ར་སྐྱིད་པར་འདུག།",
    "བྱས་ནས་མི་འགའ་ལམ་རྗེས་འདུག་གམ་བལྟས།",
    "དེ་ཚེ་ཀུན་གྱིས་བལྟས་ཚེ་མི་འདུག་སྐད།",
    "རང་རང་སྒོ་གསུམ་དགེ་སྦྱོར་སྒྲུབ་ཕྱིར་བསྡད།",
    "བྱད་ཁ་རྦོད་གཏོང་འདུག་ཅེས་ས་སྐྱ་དང་།",
    "མཆོད་ཡོན་དམ་ཚིག་དཀྲུགས་ཤིང་རྒྱུར་འདུག་ཚེ།",
    "རང་རང་དག་དང་མ་དག་མཇལ་སྣང་ཡིན།",
    "ལྷ་འདྲེ་རྣམས་ནི་རང་རང་གནས་སུ་གཤེགས།",
    "ཁོ་རང་གཉིས་ཀྱི་དག་སྣང་ཡིན་ཚུལ་གྱིས།",
    "མི་འདུག་དེ་རྣམས་གང་འདྲ་ཡིན་ཞེས་པས།",
    "ག་འདྲ་ཡིན་ནམ་མི་འདུག་ཅེས་ཟེར་ནས།",
    "སྐུ་ཞབས་དགོངས་པ་འདི་ལྟར་མཁྱེན་འདུག་པས།",
    "ང་རང་གཉིས་ལ་མགོ་བསྐོར་ཡང་ཡང་བྱས།",
    "མངའ་རིས་ཡུལ་དུ་ངེད་གཉིས་ལྷག་པར་འདུག།",
    "དེ་ཕྱིར་ཁྱེད་རང་ནམ་གྲོངས་ཡུལ་འདི་ན།",
    "འདི་རུ་འདུག་བྱེད་ཁྱེད་ཡུལ་ཁས་ལེན་བྱེད།",
    "ཁྱེད་རང་འདི་རུ་བསྡད་པ་ཙམ་གྱིས་ཆོག།",
    "དེ་ནས་ང་རང་དཔོན་སློབ་ཀླུ་བྲག་འོང་།",
    "བསྟན་འགྲོ་སྤྱི་དང་རང་རྒྱུད་སྨིན་བྱེད་ཅིང་།",
    "བདག་ལ་གུས་གུས་ཆེས་ཆེར་བྱེད་པར་འདུག།",
    "དེར་ཁོ་རང་ཨ་ཅ་ཧོ་ཨ་ཅ་ཧོ་ཞེས་པ།",
    "ཞེས་པའི་དྲི་བ་དེ་ལྟར་བྱེད་པར་འདུག།",
    "གང་ལྟར་བྱུང་འདུག་ཚེ་རབས་ལས་རྩིས་བལྟ།",
    "དེ་ལྟར་ཁོ་རང་མཉེས་མཉེས་བྱས་ནས་སུ།",
    "དེ་རྗེས་ཨང་ཡིག་གཅིག་བཞི་བདུན་ལྔ་འདུག།",
    "སྦྱིན་པའི་མཐའ་ཆེན་བོད་ལ་རྫོགས་དགོས་འདུག།",
    "ཤི་བའི་རོ་དུར་བོད་ཀྱི་ཕྱོགས་སུ་འདུག།",
    "ངན་པར་བཟང་འགྱུར་ལྟས་ངན་གཡང་དུ་འདུག།",
    "དེ་ལ་ཚོང་འདུས་ཧ་ཅང་རྒྱ་ཆེར་འདུག།",
    "སྐད་བརྡ་མི་གཅིག་མང་དུ་འདུག་པ་ཡི།",
    "མཛད་པ་གང་འདུག་དེ་ཡི་ལུང་འབྲེལ་ཞུས།",
    "དེ་མཚམས་ཁོ་རང་སྦྱིན་བདག་འགྲོ་དོན་བྱོན།",
    "གོ་ཊམ་བརྒྱ་སོགས་བཅའ་ལག་ཕྲན་ཙམ་འདུག།",
    "ཁྱེད་རང་ཞབས་འཁོར་གང་ཡོད་ཚང་མ་རྣམས།",
    "དེ་མཚམས་ཞིག་ནས་ཁོ་རང་གཡོག་འཁོར་གྱི།",
    "དེ་ནས་ཀུན་ཀྱང་རང་གནས་སོ་སོར་ལོག།",
    "ས་བཅུད་ཡུལ་བཅུད་ཉམས་པའི་རྟགས་སུ་འདུག།",
    "ལྷག་ལུས་ཡིན་ཞེས་མཁས་པའི་ལུང་དུ་འདུག།",
    "དེ་ནི་ཤིན་ཏུ་བདེན་པ་མངོན་འདུག་པའོ།",
    "དེ་ལྟར་ཡིན་ན་ཁྱེད་རང་བོན་ལུགས་ཀྱི།",
    "སོ་སོ་རང་རང་སྒྲ་དང་སྐད་བརྡ་སྦྱར།",
    "ཞེས་ཟེར་བདག་ལ་ཐེ་ཚོམ་ཆེས་ཆེར་འདུག།",
    "ཞེས་བྱ་དེ་ལ་ཁོ་རང་ཧ་ཧ་བགད།",
    "འདི་ལྟར་ཕུལ་བས་ཁོ་རང་ཤིན་ཏུ་མཉེས།",
    "རང་རང་ལོངས་སྤྱོད་གཡང་པ་དང་།",
    "གཞན་ཡང་རང་རང་སྒེར་རིམ་གཡང་སྒྲུབ་དང་།",
    "ཁྱི་ར་ཕག་སོགས་བྱ་དང་རྟ་སོགས་འདུག།",
    "ཕྱི་རིམ་ནང་རིམ་བར་རིམ་གསུམ་དུ་འདུག།",
    "སོ་སོ་རང་རང་སྒྲ་སྐད་ཅི་བཞིན་དུ།",
    "སྐད་ཅིག་ཡུད་ཙམ་ཟད་པ་མ་ཚོར་འདུག།",
    "ལུས་བརྒྱན་ལག་མཚོན་རང་རང་ཡུལ་ལུགས་དང་།",
    "འགྲོ་འདུག་ཉལ་གསུམ་མ་གཡེངས་ང་ཉིད་བསྒོམ།",
    "རྒས་གཞོན་ལོ་མཉམ་འདྲ་འདྲ་འདུག་པའོ།",
    "ལུགས་རྙིང་མ་བཀའ་བརྒྱུད་ལུགས་སྲོལ་འདུག།",
    "ཁྱེད་རང་བོན་པོའི་དྲི་མས་ཡེ་མ་གོས།",
    "སྒོ་ཟོག་འབྲི་གཡག་མཛོ་དང་བ་གླང་འདུག།",
    "གྲུབ་ཆེན་ཀུན་བཟང་རང་གྲོལ་ཞེས་བྱ་བའི།",
    "དེ་རུ་བོད་ཀྱི་ལམ་སྲུང་ཁྲལ་ས་འདུག།",
    "ཊམ་དར་སྦྱོར་ནས་གུས་ཚུལ་བྱེད་པར་འདུག།",
    "དེ་ཚེ་བོན་ནི་དེ་རུ་ཡོད་འདུག་ཚེ།",
    "ང་རང་ལོ་ཤས་གནས་བསྐོར་འོང་བའི་སྐབས།",
    "ཞེས་བྱ་ཁོ་རང་ངོ་ཚ་ཆེར་ལངས་ནས།",
    "གུས་ཚུལ་བྱས་ནས་འདི་ལྟར་སྨྲས་པར་འདུག།",
    "དུས་ཀྱིས་བསླད་པའི་རང་རང་སྦྱོང་ལུགས་ཡིན།",
    "ཁྱེད་རང་བཟའ་བཏུང་དགོས་པའི་ཆེད་མ་གཏོགས།",
    "འོན་ཀྱང་རང་རྒྱུད་ཐུལ་ངེས་དགེ་སྦྱོར་གང་།",
    "ཕྱི་བཅོས་འདུག་ཟབ་ནང་དུ་ལྡུམ་པ་མེད།",
    "གསང་བ་མཐའ་བྲལ་ཀུན་བཟང་རང་ས་ཟིན།",
    "སྒོ་ང་རང་བརྡོལ་འོད་ཀྱི་མིའུ་ཐུང་བརྒྱད།",
    "དེ་ཙམ་དེ་ཡི་བསྐལ་པ་དུས་ཤིག་དུས།",
    "དེ་ལྟར་འདུག་ཚེ་ཤིན་ཏུ་རྩད་གཅོད་དགོས།",
    "བསྟན་པ་ས་གཞིའི་རྩི་ཐོག་རྒྱས་ལྟར་འདུག།",
    "བསྟན་འགྲོ་སྤྱི་དང་རང་རྒྱུད་སྨིན་པར་ཤོག།",
    "རང་རང་གནས་གཤེགས་ཐེག་ཆེན་དོན་ལ་འབད།",
    "ཞེས་པའི་ལུང་དང་ངེད་རང་འགལ་ཞེས་འདུག།",
    "འདི་ཞེས་བོན་པོ་ལུང་ལ་མི་འདུག་གམ།",
    "བསྟན་ལ་ཕན་ཞིང་འགྲོ་དོན་ནུས་བྱེད་འདུག།",
    "འོན་ཀྱང་ཁྱེད་རང་བོན་གྱི་བསྟན་པ་ནི།",
    "རྒྱ་ཆུང་ཡིན་ཡང་ཁུངས་བཙུན་ཡོད་ཚོད་འདུག།",
    "རྒྱ་ཕེབས་གསེར་འཕྲུ་ལ་སོགས་དགོས་ཆེད་འདུག།",
    "རང་རང་གང་ལྕོགས་འབྲི་གཡག་ར་ལུག་དང་།",
    "མ་ཆག་དངོས་སུ་འདུག་པའི་ཡ་མཚན་ལ།",
    "སྤྲིན་མཇུག་བྱས་ནུབ་བྱས་འདུག།",
    "སྤྲིན་འགོ་ཤར་ལ་བྱས་འདུག།",
    "བསིལ་གཡབ་ཁང་ཆེན་ཆེར་འདུག་དེ་རུ་འཚོགས།",
    "ཤིན་ཏུ་མི་བཟོད་འཇིག་པའི་མར་འདུག་ཚེ།",
    "ཁྱད་པར་བོན་འདི་ཤིན་ཏུ་བཟང་འདུག་ཅེས།",
    "དེ་ནས་སྐྱེལ་མ་རྣམས་ཀྱང་རང་གནས་ལོག།",
    "སྐྱུག་བྲོ་བསམ་ནས་དད་པ་མ་ཤར་འདུག།",
    "དེ་ལྟར་འདུག་ཅེས་ཀུན་ལ་སྨྲ་བར་འདུག།",
    "དེ་ཡི་ཡུལ་དབུས་སྤྱི་ཁང་ཆེར་འདུག་དེར།",
    "ཁོང་རྣམས་དགོངས་ཞུས་རང་རང་ཡུལ་དུ་ལོག།",
    "ཁོ་རང་གཉིས་ལ་གང་དགོས་ཆས་རྣམས་སྦྱར།",
    "ཡུལ་ཁག་དགུ་ཙམ་འདུག།",
    "ཀུན་བཟང་རང་སེམས་དབྱེར་མེད་མངོན་ཤར་ནས།",
    "མཁན་མིང་རང་ཡང་རྒྱ་རོང་རྒྱལ་ཁབ་ནས།",
    "ཀུན་ལ་རང་རང་གང་འདོད་དགོས་ཆས་རྣམས།",
    "ཁོ་རང་དཔོན་གཡོག་བོད་ཀྱི་ཡུལ་དུ་ཕེབས།",
    "བོན་གྱི་ཞབས་འདྲེན་འགྱུར་བའི་རྒྱུར་འདུག་ཚེ།",
    "གཡུང་དྲུང་འགྱུར་མེད་ཨ་ཞང་ལས་སོགས་སླེབས།",
    "སེང་རང་རྩལ་རྫོགས་པ་གངས་ལ་བདེ།",
    "གནོད་པ་ཆེར་འདུག་དེ་ལ་མངགས་པ་ཡིས།",
    "གདན་ཁྲི་གསོལ་ལྕོགས་མཁན་དང་དབྱེར་མེད་འདུག།",
    "ཁོང་རང་དཔོན་སློབ་བདུན་ཁར་བསྟན་ལྷུན་དང་།",
    "སེམས་རྟོགས་པའི་ཉམས་མྱོང་མི་གདའ་སྟེ།",
    "ཕལ་ཆེ་བ་འཁྲུལ་སྣང་རང་ཁ་མ།",
    "སྤྲང་པོའི་ཚེ་ལོ་ཉེར་གཅིག་དུས་སྐབས་སུ།",
    "བསྒོམ་ཡེང་མེད་ཀྱི་ངོ་བོ་ཡང་རང་ཆས་སུ་འཆར་རོ།",
    "ཁྱེད་སྒོམ་ཆེན་པ་རྣམས་ལ་ཉམས་འདི་འདྲ་གཅིག་འདུག་གམ།",
    "སྤྲང་རྒན་ང་ཡི་སྡུག་སེམས་འདི་འདྲ་ཞིག་འདུག་ལགས།",
    "ཚེ་གཡང་དཔལ་གསུམ་ཉམས་པའི་སྐྱོན་འདུག་ཚེ།",
    "རྒྱལ་འགོང་ཡོད་ཅེས་ཟེར་བའི་ལུགས་སྲོལ་འདུག།",
    "འགའ་ཡང་སྨྲས་འདུག་གང་འདྲ་ཡིན།",
    "ཡུལ་དུ་འདུག་པའི་རྒྱབ་རྟེན།",
    "འདུག་ཚེ་ཕན་ཐོགས་འོང་མིན་ལུང་རྟགས་དགོས།",
    "གསུངས་པའི་དོན་དེ་རང་རྒྱུད་ལ་མ་འབྱོར་བ་ཡིན་ནམ་མིན་སྙམ་པ་ཐེ་ཚོམ་སྣ་ཚོགས་ཤིག་ཤར་འདུག་པ་དང་།",
    "བདག་ལྟ་བུའི་དོན་སྟོན་པ་འོས་མི་འདུག་ཀྱང་།",
    "ཀུན་ལ་སྲིད་འདུག་པས།",
    "འོ་ན་ཁྲོ་བོའི་རྒྱུད་དུ་མ་བཅོས་པའི་ངང་ལ་མ་གཡེང་པར་ལྟོས་ཟེར་བ་འདུག་ཅེས་གསུངས་སོ།",
    "ལམ་ལྷུན་གྲུབ་རང་འབྱུང་རང་རྩལ་རྫོགས།",
    "ངོ་གསར་སྤྱོད་རང་མ་དགོས་ཤེས་འདུག་ཀྱང་།",
    "རབ་མཁའ་ལ་ཉི་ཤར་འདུག།",
    "གཙང་དུ་ཁག་གཉིས་ཡོད་འདུག་པ།",
    "ད་ཆ་དམག་འཐབ་མི་དགོས་པ་འཆིང་སྒྲིགས་སུ་ཟླ་བ་གསུམ་པ་ནས་ལྔ་པ་ཕན་ཚུན་འདོད་མཐུན་གྱི་འགྲིག་ངོ་ཡོད་མེད་བཟང་ངན་འདི་འོང་འདི་མི་འདུག་ཅེས།",
    "ཅི་དྲགས་གང་དྲགས་བསམ་པའི་བློ་འདུག་ན།",
    "རྩ་ཆུ་དམ་དུ་བསྡམས་ཀྱང་རང་རྡོལ་འགྲོ།",
    "སྔོན་འགྲོའི་ཞབས་བརྟན་བཏང་ནས་ལེགས་འདུག་ཞུས།",
    "དེ་དང་རང་འཁོར་ཞབས་བརྟན་གནས་འདྲེན་མཐུས།",
    "འོན་ཀྱང་རང་རྫས་དགེ་སྦྱོར་བྱེད་པ་དཀར།",
    "ཤིན་ཏུ་བོན་ཞེས་ངོ་མཚར་ཆེ་འདུག་ཅེས།",
    "ལི་མ་ལས་གྲུབ་ཞལ་གསེར་ལྡན་པ་འདུག།",
    "ཆེ་ཆུང་ཐོག་བརྩེགས་གཉིས་ལྡན་ཀུན་ཀྱང་འདུག།",
    "གོང་མ་བདག་པོ་ཆེན་པོའི་གསེར་སྙན་དུའང་སྒྲོན་གནང་མཛད་འདུག་པ་བཞིན།",
    "ཞབས་ཞུའི་ཁོངས་སུ་སྐུ་ཉིད་ཕེབས་སྐྱོད་མ་མཛད་ཐུ་མེད་འདུག་པར་དཔོན་གཡོག་གཉིས་ཀྱིས་ཕེབས་གྲབས་ཞུ་དགོས་ཀྱང་།",
    "དེ་ལྟར་རྒྱལ་ཡབ་རྒྱལ་ཡུམ་ཤར་འདུག་མཛོད།",
    "འདུག་ཚེ་ལྷ་སྲུང་བསྐང་འཕྲིན་གང་རྒྱས་དང་།",
    "ལྷ་སྲུང་རང་རང་བསྟེན་ལ་བསྟིམ་དགོས་འདུག།",
    "དོན་དུ་དངོས་མཚན་གྱི་བདེན་པར་གྲུབ་པ་རྡུལ་ཙམ་ཡང་མི་འདུག་སྟེ།",
    "རྒྱུད་ལ་ཁེལ་ཐག་ཆོད་པ་ནི་མི་ཡོང་བར་འདུག་ཅི་ལྟར་བྱས་ཀྱང་ཐུན་སྒོམ་དགའ་སྡུག་ཅན་ཞིག་ལས་མི་འཕགས་པར་འདུག་པའི།",
    "སེམས་ཉིད་སྟོང་པར་འདུག་ཅེས་ལུང་དུ་བསྟན།",
    "ཐུགས་འགྱུར་བའི་རང་བཞིན་མི་འདུག་ཕྱིར།",
    "དུས་དེང་སང་རང་ངོ་ཤེས་ཙམ་བདོག།",
    "སེམས་ངོ་བོ་འདི་ལྟར་འདུག་ཅེས་མེད།",
    "རང་རང་ལས་ཕུར་གྱི་ཚུལ་དུ་འཆིང་ནས།",
