    "རང་བཞིན་གྱི་མཚན་ཉིད་ཀྱང་རང་བཞིན་དང་བྲལ་བ་ཡིན་ནོ།",
    "སྐྱེ་མཆེད་ལ་སོགས་པ་རྣམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་སྐྱེ་བ་དང་འགག་པ་མི་དམིགས་ཏེ།",
    "འདུག་པ་ལ་སོགས་པའི་སྤྱོད་ལམ་རྣམས་དང་།",
    "ཡང་རང་བཞིན་གང་ཡིན་པ་སྡུག་བསྔལ་གྱི་བདེན་པའི་རྟེན་ཅན་རྣམ་པར་གྱུར་པ་ནི་ལྔ་ཡིན་ནོ།",
    "དེ་དག་དེ་ལྟར་བྱས་ན་སྣེཇི་ལྟར་སྟོབས་ལ་སོགས་པའི་རྣམ་པ་རྣམས་ཀྱི་རབ་ཏུ་དབྱེ་བ་དང་རང་བཞིན་གང་ཡིན་པ་དེ་རྣམས་ནི་དེ་བཞིན་ཉིད་དང་།",
    "དེ་དང་ཉེ་བར་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "སོ་སོར་སྣང་བའི་མཚན་མ་ནི་ལེགས་པར་འདུག་པ་ལྟར་མི་གཡོ་བར་འགྱུར་རོ།",
    "པདྨའི་འདབ་མ་རྒྱས་པ་ལྟར་འདུག་པའི་སྤྱན་གྱིས་ལྷ་དང་།",
    "ཐོབ་ཀྱང་རང་ལ་གཟུགས་ཀྱི་འདུ་ཤེས་བཞག་པས་ཀྱང་རུང་།",
    "མ་ཐོབ་ཀྱང་རང་ལ་མིང་གཞིའི་འདུ་ཤེས་བཞག་སྟེ།",
    "ཐ་མ་བརྒྱད་ཀྱང་རང་བཞིན་གྱི་ཉེས་པ་དང་།",
    "བར་ན་མི་འདུག་པ་ཤེས་པ་དང་༏",
    "ཁ་བ་རི་བོས་ཡོངས་སུ་བསྐོར་བའི་མགོ་ནག་བོད་ཀྱི་ལྗོངས་འདི་ནི་མིའི་རིགས་ཀྱི་འབྱུང་གནས་ཤིག་ཡིན་པར་ཀུན་གྱིས་གླེང་བ་བཞིན་དུ་འདུག་པས།",
    "མགར་ཞེས་པའི་རུས་ནི་རྒྱལ་ཕྲན་སིལ་མ་བཅུ་གཉིས་ཀྱི་དུས་ནས་རུས་སུ་གྲུབ་འདུག་པ་ཏུན་ཧོང་ཡིག་ཚགས་སུ་སྣང་བ་སྔར་དྲངས་ཟིན་པ་དེ་བཞིན་ཡིན་པས།",
    "འཚོ་བའི་ཡོ་བྱད་དང་རྒྱུ་ཆ་སོགས་ཀུན་ནས་འཕེལ་ཏེ་སྲིད་འབྱོར་རིག་གསུམ་གྱི་མ་ལག་ཅུང་ཆ་ཚང་ལ་ཆབ་སྲིད་ཀྱི་མངའ་ཐང་རང་གར་འཛིན་པའི་རྒྱལ་ཕྲན་མང་པོ་གྲུབ་པར་མ་ཟད།",
    "འདིར་དྲལ་གྱི་སྙན་དུ་གདའ་སྟེ།",
    "གནའ་དེང་གང་དུའང་རང་བཞིན་གཅིག་ཏུ་མཐོང་།",
    "ཅུང་ཟད་ཙ་ན་རྣམ་པར་རྒྱལ་ཏེ་ཕྱིར་ཕེབས།",
    "རྒྱ་གར་གྱི་ཧཎཝརྙན་དགའ་འཕེལ་དང་པོད་ཀྱི་སྲོང་བཙན་སྒམ་པོས་མངའ་ཐང་རྒྱུ་བསྐྱེད་བཞིན་འདུག་ཅེས་གསུངས་པས་ཕྱིར།",
    "ཐང་ཡིག་གསར་མར་མགར་སྟོང་བཙན་ནི་ཡི་གེ་མི་ཤེས་ཀྱང་རང་བཞིན་གྱིས་རིག་པ་རྣོ་ཞིང་ངང་ཚུལ་བརྟན་ལ།",
    "བཙན་པོའི་འགབ་མ་བློན་གྱི་གོང་མ་མགར་བཙན་སྙ་ལྡོམ་བུའི་ཆབ་སྲིད་འཇོན་ཐང་ལ་འབྲེལ་བས་ལོས་ཡིན།",
    "སྤྱི་ལོ་༦༦༣ལོར་བོད་བཙན་པོས་འ་ཞ་འབངས་རྣལ་མར་འགུག་དུས།",
    "རྗེ་འབངས་ཀྱི་འབྲེལ་བ་ལས་བློན་འབངས་ཀྱི་མཛའ་བཤེས་དམ་པ་འདིའང་རང་རྒྱུད་ཚར་གཅོད་ཀྱི་རྒྱུ་བྱེ་བྲག་ཅིག་ལོས་ཡིན།",
    "མགར་བུ་སྤུན་མཆེད་རྣམས་ཀྱིས་ཀྱང་རང་ཉིད་ཀྱི་མཛད་རྗེས་ཀྱིས་རང་ཉིད་བརླག་རྒྱུ་ཡིན་པ་ཡིད་ལ་ག་ལ་ཤར།",
    "ཏག་ཏག་དུས་དེ་ནི་མགར་ཁྲི་འབྲིང་བཙན་བྲོད་འ་ཞའི་ཡུལ་དུ་ཡོད་པའི་སྐབས་ཡིན་པས།",
    "མགར་ཁྲི་འབྲིང་སྤུན་མཆེད་ཤར་མཐའ་ན་ཡོད་པའི་གོ་སྐབས་ལ་བསྟུན་ནས་དབུས་སུ་གདུང་རྒྱུད་མེད་པར་ཚར་བཅད་པ་ལོས་ཡིན།",
    "དེ་ནི་སྔ་ལོར་རྡོ་ཧྥང་ནས་གྲུ་གུ་ཕམ་པར་བརྒྱབ་པའི་རྒྱལ་ཁ་ལ་བརྟེན་ནས་གནང་བའི་ཐོབ་དང་གོ་གནས་ལོས་ཡིན།",
    "མཁས་པ་སྔ་མའི་དཔྱད་འབྲས་ཀྱི་རྨང་གཞིའི་སྟེང་རང་བློས་དཔོག་ཚོད་ཀྱིས་ཁུངས་ཐུབ་ཡིག་ཚང་ལ་རྒྱབ་བརྟེན་ཅིང་ཚུལ་གསུམ་རིགས་པས་དབྱེ་ཞིབ་དང་སྤྱི་སྡོམ་བྱས་པ་ཡིན་ཏེ།",
    "གནའ་དེང་གང་དུའང་རང་བཞིན་གཅིག་ཏུ་མཐོང་།",
    "མགོན་ཁང་དེའི་ཕྱི་ནང་ཐམས་ཅད་དུ་ཕྱག་མཚན་གྱི་བྱེ་བྲག་བྱ་གཅན་གཟན་སྟག་དོམ་དྲེད་དང་འཕན་གདུགས་ཀྱི་རིགས་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་འདུག་ཀྱང་།",
    "ཕུག་པ་སོགས་མང་བ་ཞིག་འདུག་ཀྱང་།",
    "ཁ་ཡི་ནང་དུ་བཅུག་ནས་འདུག་ན་ནི།",
    "སྡུག་བསྔལ་མི་འདོད་ཅིང་རང་བཞིན་གྱིས་སྡུག་བསྔལ་བར་གྱུར་པའི་སྐྱེ་བོ་ལ་སྡུག་བསྔལ་གྱིས་རྣམ་པ་འགེད་པས་ཅི་ཞིག་བྱ་སྟེ།",
    "གལ་ཏེ་འཇིག་རྟེན་ན་ལྷ་སྦྱིན་བདེ་བར་ཉལ་འདུག་གོ་ཞེས་སོགས་ཀྱི་ཐ་སྙད་མཐོང་བས་བདེ་བ་ཡོད་དོ་ཞེ་ན།",
    "ཕན་པ་དང་མི་ཕན་པ་རྗེས་སུ་སྟོན་པ་པོ་མེད་ཅིང་རང་ཡན་དུ་གྱུར་པས་སོ།",
    "ངེས་པར་ཏེ་མཐའ་གཅིག་ཏུ་མི་དགེ་ཞིང་རང་གཞན་གྱི་རྒྱུད་སྲེག་པ་དང་གཞན་ལ་གནོད་པ་སོགས་དོན་མ་ཡིན་པ་སྐྱེད་ཅིང་།",
    "གཞན་ལ་གཏོང་བ་པོ་དང་རང་ཟ་བ་པོ་དང་།",
    "དངོས་པོ་དང་རང་བཞིན་དང་བདག་དང་རྟག་པ་རྣམས་ནི་རྣམ་གྲངས་ཡིན་ལ།",
    "སྣ་ཚོགས་རྟག་པར་མི་རིགས་ཞེས་པ་སོ་ན་འདུག་གོ།",
    "འགྲོ་བ་དང་འོང་བ་དང་འདུག་པ་ལ་སོགས་པ་བྱ་བ་ཅི་ཡང་མེད་དོ།",
    "ས་བོན་ལ་སོགས་པ་ཡོད་ཀྱང་འབྲས་བུ་མྱུ་གུ་དང་མེ་ཏོག་ལ་སོགས་པའི་སྐྱེ་བ་དང་འཇིག་པ་དག་དུས་རྟག་ཏུ་མེད་པའི་ཕྱིར་དང་།",
    "གཉིས་ཀའང་རང་བཞིན་མེད་པར་མཚུངས་པའི་ཕྱིར་གཅིག་མཐོང་ལ་གཅིག་མི་མཐོང་ཞེས་བྱ་བར་མི་རིགས་སོ།",
    "རྣམ་པར་ཤེས་པའང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དངོས་པོ་འགའ་ལའང་རང་བཞིན་བརྟག་པར་མི་ནུས་ཏེ།",
    "གསུམ་པོ་འདི་དག་དུས་ཐ་དད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "ཚིག་གསུམ་ལའང་རང་བཞིན་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡང་རང་ལུགས་སྒྲུབ་བྱེད་ཀྱི་གཏན་ཚིགས་རྙེད་པར་དཀའ་ལ།",
    "དེ་ཁོ་ན་ཉིད་ཀྱང་རང་བཞིན་དང་ངོ་བོ་ཉིད་ཡིན་ནོ།",
    "གཞན་ཡང་འབྲས་བུ་བྱེད་པའི་དུས་ན་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་དང་འདུག་པའི་དངོས་པོ་གང་ཡིན་པ་དེ་ཉིད་ལྷན་ཅིག་བྱེད་པའི་རྒྱུ་དང་བྲལ་བའི་དུས་ན་ཡང་འདོད་ན་ནི་དེའི་རྗེས་སུ་འཇུག་པ་ཉིད་ཀྱི་ཕྱིར་དེའི་ཚེ་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་རྣམས་ཀྱང་མགུལ་ནས་བཏགས་པ་བཞིན་དུ་སྟོབས་ཀྱིས་དྲངས་ནས་གནས་ཏེ།",
    "དེ་ཡང་རང་བཞིན་དེས་བརྩམས་དང་།",
    "གཟུགས་ཀྱི་ཕུང་པོ་དཔྱད་པའི་ཞར་ལ་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་འགྲེལ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པ་ཡང་རང་བཞིན་མེད་པར་བསྟན་ཏོ།",
    "དྲན་པ་ནི་མདུན་ན་འདུག་པའི་དངོས་པོ་ལ་ཡང་ཤིན་ཏུ་གསལ་བར་རྟོགས་པ་མ་ཡིན་ནོ།",
    "དེ་གཉིས་ཀྱང་འདུག་པའི་ཕྱིར་རོ།",
    "འདས་པའི་དུས་ན་ཡང་རང་བཞིན་གྱི་ངོ་བོ་ཉིད་ཀྱིས་མྱ་ངན་ལས་འདས་པ་སྟེ།",
    "བེ་རོ་ཙ་ན་རྡོ་རྗེ་བཞད་པའི་འདུས་འགྲེལ་འགྲེལ་དུ།",
    "ཞེས་བྱ་བ་སུན་འབྱིན་པའང་རང་ཉིད་དེ་གཉིས་མི་ཤེས་པར་སྟོན་པ་ཡིན་ནོ།",
    "ཞེས་སྒྲིབ་པ་ཟད་ཙ་ན་ཡེ་ཤེས་རྒྱུན་ཆད་པས་ཡེ་ཤེས་སྒྲིབ་པར་ཁས་བླངས་སོ།",
    "དེ་ཉིད་ཀྱང་རང་རིག་ཡིན་ཏེ་གཞན་གྱིས་རིག་ན་ཐུག་མེད་དུ་འགྱུར་བས་རང་མི་རྟོགས་པར་འགྱུར་རོ།",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་བ་ཡི།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པའི།",
    "གང་ཚེ་དེ་སྐད་སྨྲ་ཞིང་རང་ཕྱོགས་ཁོ་ན་རྣམ་འཇོམས་པ།",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་བ་ཡིས།",
    "ཕུང་རང་པོ་ལྷག་མ་མེད་པར་མྱ་ངན་ལས་འདས་པར་འཇུག་པའི་སེམས་ལས་གཞན་པའི་སེམས་དང་སེམས་ལས་བྱུང་བ་རྣམས་ནི་དེ་མ་ཐག་པའི་རྐྱེན་ནོ།",
    "ཇི་ལྟར་སྲང་མདའི་མཐོ་དམན་དག་དུས་གཅིག་ཉིད་དུ་མཐོང་བ་དེ་བཞིན་དུ་ས་བོན་འགག་བཞིན་པ་ན་མྱུ་གུ་སྐྱེ་བར་འགྱུར།",
    "སྲང་མདའ་གཉིས་ལ་ནི་ད་ལྟར་བ་ཡིན་པའི་རང་ཕྱིར་མཐོ་དམན་གྱི་བྱ་བ་དག་དུས་གཅིག་པ་ཉིད་ཡོད་ཀྱི་ས་བོན་དང་མྱུ་གུ་ད་ལྟར་བ་དང་མ་འོངས་པ་དག་ལ་ནི་དུས་གཅིག་མེད་པས་འདི་ནི་སྲང་དང་མཚུངས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་བྱ་བ་དག་དུས་གཅིག་པ་ཉིད་དུ་མི་རིགས་པ་ཁོ་ནའོ།",
    "ཀུན་རྫོབ་དེས་གང་ཞིག་བདེན་པར་སྣང་ཞིང་རང་བཞིན་མེད་བཞིན་དུ་རང་བཞིན་དུ་སོ་སོར་སྣང་བ་དེ་ནི་འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་ཀུན་རྫོབ་ཏུ་བདེན་པས་འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་སྟེ།",
    "དེའི་ཕྱིར་ཡོད་པར་དམིགས་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་དོ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་དེ་ལྟར་བདེན་པ་གཉིས་ཀར་ཡང་རང་བཞིན་མེད་པས་རྟག་པ་དང་ཆད་པ་ལྟ་བ་རྒྱང་རིང་དུ་སྤངས་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་ཀྐཱམིན་པའི།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་འབྱུང་གཉིས།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པ་ནི་ཡོད་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པའི་རྒྱུ་ཅན་གྱི་དྲན་པ་མི་སྲིད་པ་ཉིད་དོ།",
    "འདི་ལས་ཀྱང་རང་རིག་པ་ཡོད་པ་མ་ཡིན་པས་དེ་ཉིད་ཀྱིས་དེ་འཛིན་པ་མ་ཡིན་ནོ།",
    "གང་སྤྱོད་དེ་ཡང་རང་བཞིན་སྟོང་པ་སྟེ།",
    "གང་དག་དུད་འགྲོར་བསྐལ་མང་རང་སྐྱེས་གྱུར་པ།",
    "གང་ཚེ་དེ་སྐད་སྨྲ་ཞིང་རང་ཕྱོགས་ཁོ་ན་རྣམ་འཇོམས་པ།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་དང་རང་བཞིན་སྟོང་པ་ཉིད་དང་།",
    "ཇི་ལྟར་ཉིད་ཀྱི་སྤྱོད་པ་དང་དེ་བཞིན་གཤེགས་པ་གཞན་གྱི་སྤྱོད་པ་དག་དུས་གཅིག་ཏུ་རང་ཉིད་ཀྱི་བ་སྤུའི་ཁུང་བུར་སྟོན་པར་མཛད་པ།",
    "ལྷག་མཐོང་རང་ལ་མཁས་པའོ་ཞེས་རྒྱས་པར་འབྱུང་ཞིང་།",
    "ཁྱེད་རང་ཚེ་སྨད་དུ་ཡེར་པ་ཟླ་བ་ཕུག་ཏུ་སྒྲུབ་པ་ཞིག་གྱིས།",
    "ཕྲན་ནི་ནུས་པ་མེད་ཅིང་ལྟ་དགོངས་དམན་པ་དེ་རིགས་བསམ་ངན་དུ་འདུག།",
    "བླ་བྲང་སོགས་དང་རྒྱ་མིས་ཁ་འཕྲལ་བ་ལ་སེམས་ཕམ་ཅི་ཡང་མི་འདུག།",
    "བན་རྒན་བསྡད་མ་བསྡད་ཅི་ཡང་མི་འདུག་གསུངས།",
    "མི་མ་ཡིན་ཚེ་རིང་མས་འཛིན་པར་འདུག་གསུངས་པ་ལྟར།",
    "སྐབས་ཤིག་ཁོ་བོ་ལོ་འདིར་མི་འཆི་བ་འདུག།",
    "སང་ཉིན་གཟའ་སྐར་གང་འདུག་གསུངས་སྐབས།",
    "གཟའ་པ་སངས་སྐར་མ་འཕྲོད་སྦྱོར་སོགས་ལེགས་པོ་འདུག་ཞུས་འབྲེལ།",
    "བདག་ནི་འདི་ལྟ་བུ་ཞིག་ན་འདུག་འདུག་གོ།",
    "མེ་ཏོག་ཨུད་པ་ལ་དམར་པོའི་མདའ་མའི་ཁ་དོག་ལྟར་འདུག་ཅིང་ཤན་ཏུ་ཡདྭངས་ལུགས་ཤིན་ཏུ་ཡངས་ཤིང་སྲབ་པའོ།",
    "ཆུའི་ཆུ་བུར་གསོག་ཏུ་འདུག་པ་སེ་ཞིང་འགག་པ་ལྟར་ཤེས་པ་སྟོ།",
    "དེ་ནི་རྟག་པར་ཡང་རང་བཞིན་གྱྀས་སྟོང་ངེ།",
    "ཕྱིན་ཆད་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད།",
    "བར་དུ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་དེ།",
    "དེ་ནམ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཡིནནཾ།",
    "གཟུགས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འདུཤེས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འདུ་བྱེད་ཉིད་ཀྱང་རང་བཞིན་སྣང་པཉིད་དོ།",
    "རྣམ་བར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མིགཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣ་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལྕེ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལུསཉིད་ཀྱང་རང་བཞནི་སྣང་པ་ཉིད་དོ་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་ལུས་སོ།",
    "ཡད་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྒྲ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རོཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྡང་པཉིད་དོ།",
    "ཡིད་ཀྱི་རྣམ་པརཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྣང་པ་ཉིད་དོ།",
    "ཆུའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་ཆུའི་ཁམས་ས།",
    "མེའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ནམར་ཁའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྣངཔ་ཉིད་དོ།",
    "འདུ་བྱེད་ཉིད་ཀྱང་རང་བཞིནསྡང་པཉིད་དོ།",
    "སྐྱེ་མཆེད་དྲུག་ཉིད་ཀྱང་རང་བཞིན་སྡང་པ་ཉིད་དོ།",
    "ཚེར་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྲེད་པཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལེན་པཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྲིད་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྐྱེ་བཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པཨ་། ཉིད་དོ་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་བཟད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཤེས་རབ་ཀྱི་ཕརོལ་ཏུ་ཕྱིན་པ་འདི་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ནང་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིནསྟོང་པ་ཉིད་དོ།",
    "ཕྱི་སྟོང་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཕྱི་ནང་སྟང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྟེང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དོན་དམ་པ་སྟོང་པཉིད་ཀྱང་རང་བཞིན་སྟོང་བ་ཉིད་དོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འདུསམ་བྱས་སྟོང་པརཾཉིད་ཀྱང་རང་བཞིན་སྟོང་བ་ཉིད་དོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པཉིད་ཀྱང་རང་བཞིན་སྟེང་པ་ཉིད་དོ།",
    "ཐོག་མ་དང་ཐམམེད་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དོར་བམེད་པ་སྟོང་པཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དེ།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པཉིད་ཀྱང་རང་བཞིན་སྣང་པ་ཉིད་དོ།",
    "ཡང་དག་པར་སྤོང་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་བ་ཉིད་དོ།",
    "སྟབས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འཕགས་པའི་བདེན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་བ་ཉིད་ད་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་འཕགས་པའི་བདེན་པ་རྣམས་སོ།",
    "བསམ་གཏན་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པར་ཐརཔའི་སྒོ་སྟེང་པ་ཉིད་དང་མཚན་མ་མེད་པ་དང་སྨོན་པ་མེད་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཏིང་ངེ་འཛིན་ཉིང་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མི་འཇིགས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ས་ས་ཡང་དག་པར་རིག་པཉིད་ཀྱང་རང་བཞིན་སྟོང་བ་ཉིད་དོ།",
    "བྱམས་པ་ཆེན་པ་ཉདི་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་བྱམས་པ་ཆེན་པའོ།",
    "སཱང་རྗེ་ཆེན་པཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཨ་། རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུཉིད་ཀྱང་རང་བཞིན་སྟེང་པ་ཉིད་དོ།",
    "ལན་ཅིག་ཕྱིར་འང་བའི་འབྲས་བུ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཕྱིར་མི་འོང་བའི་འབྲས་བུ་ཉིད་ཀྱང་རང་བཞིན་སྟོར་པ་ཉིད་དོ།",
    "དགྲ་བཅོམ་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལམ་གྱི་རྣམཔ་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "གཟུགས་མཆིས་པའི་ཁམསན་ཡང་མི་གདའ།",
    "གཟུགསམ་མཆིས་པའི་ཁམསན་ཡང་མི་གདའ།",
    "འདུས་བྱས་ཀྱི་ཁམསན་ཡང་མི་གདའ་ལ།",
    "འདུས་མ་བྱས་ཀྱི་ཁམསན་ཡང་མི་གདའ་ལ།",
    "བདག་ཀྱང་བསམ་གཏན་ལ་སྙོམས་པར་འདུག་གོ།",
    "དེ་དག་ལ་བདད་རངས་པ་དེ་དང་ལྡན་པས་དལ་བདུན་ཙམ་དུ་ནམ་མཁའ་ལ་འཕགས་ནསཏ་ལ་བདུན་ཙམ་ན་འདུག་སྟེ།",
    "འཁོར་འབུམ་ཕྲག་དུསས་ཡོངས་སུ་བསྐོར་ཅིང་མདུན་གྱིས་བལྟས་ནས།",
    "སྟོན་རལ་བྲ་ཉེ་ལ་གནམ་ནས་སྒྲ་ཆེན་པོ་བྱུང་ན་བཙུན་པ་དང་དཀའ་ཐུབ་པ་རྣམས་ལ་གདའ་སུ་དཔལ་ག་འ་དང་བྱཱ།",
    "ཐོག་མར་རང་རང་ལོ་ཡིས་བསྒྱུར།",
    "རང་རང་ལོས་བགོས་གསལ་བར་འགྱུར།",
