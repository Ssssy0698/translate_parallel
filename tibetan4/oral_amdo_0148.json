    "གསུང་གིས་བསྐུལ་བར།",
    "ཟབ་མོ་གཏེར་གྱི་སྲུང་མ་རྣམས་ཀྱིས་སྲུངས་ཤིག་རཀྵ",
    "༡༨བསྡུར་འབྲས་རེའུ་མིག་༡༩༡༧༤༩ རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་གཟུངས་ཀྱི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ།",
    "༣༨བསྡུར་འབྲས་རེའུ་མིག་༤༡༧༥༡ རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ་༤༡སློབ་དཔོན་ཆེན་པོ་མཁས་པ་རརཏྣ་ཀཱིརྟིས་མཛད།",
    "༤༣བསྡུར་འབྲས་རེའུ་མིག་༤༤༡༧༥༢ རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ཁྲུས་ཀྱི་ཆོ་ག་ཞེས་བྱ་བ།",
    "༤༩བསྡུར་འབྲས་རེའུ་མིག་༤༩༡༧༥༣ རྣམ་འཇོམས་ཀྱི་སྒྲུབ་ཐབས་བརྒྱ་རྩ་བརྒྱད་གྲགས་པ།",
    "མི་ཤིགས་པ་ཞེས་བྱ་བའི་རྒྱུད་ཀྱི་ཚིག་ལག་ཏུ་བླང་བ་མན་ངག་གིས་བསྒྲུབ་པའི་རྣལ་འབྱོར་པའི་ཚེ་དང་སྟོབས་བསྒྲུབ་པ་ཞེས་བྱ་བ།",
    "ཐེ་ཚོམ་མེད་པར་འགྲུབ་པ་ལས་བསྒྲུབ་བྱ་ཐོག་གིས་བསད་པའི་ཆོ་ག་དྲག་༡༢༦ཤུལ་ཞེས་བྱ་བ་དཔལ་མར་མེ་མཛད་བཟང་པོས་མཛད་བསྒྲུབ་བྱ་སྐྲག་པའི་ལས་ཆུ་ཐིགས་ཞེས་བྱ་བ།",
    "༡༥༩སློབ་དཔོན་ཡེ་ཤེས་རྡོ་རྗེས་མཛདཞི་བའི་སྦྱིན་སྲེག་གི་ཆོ་ག་རྒྱུད་ཀྱི་ཞི་བའི་མཚན་དོན།",
    "༡༨༢སློབ་དཔོན་ཡེ་ཤེས་རྡོ་རྗེས་མཛདདལ་འབྱོར་ཆེན་མོའི་སྒྲུབ་པ་བཅུད་ཀྱིས་ལེན་པ་ཞེས་བྱ་བ།",
    "༡༨༧དཔལ་མར་མེ་མཛད་བཟང་པོས་མཛདསྐྱེ་བོ་སྡང་བའི་ལས་མྱུར་བྱེད་ཆེན་མོ་ཞེས་བྱ་བ།",
    "བྲན་དང་བཟའ་མི་གདོན་གྱིས་གཙེས་པ་བསྲུང་བའི་ཆོ་ག་ཆེན་མོ་ཞེས་བྱ་བ།",
    "མི་མཐུན་པ་ཞི་བར་བྱེད་པའི་རྩི་སྦྱོར་དབྱིག་གི་ནོར་བུ་ཞེས་བྱ་བ།",
    "ཚོགས་བདག་གི་སྒྲུབ་པ་དབུལ་བའི་གཏེར་སྦྱིན་ཞེས་བྱ་བ།",
    "ཚེ་འཕེལ་བའི་སྒྲུབ་ཐབས་རྒྱལ་མཚན་གྱི་རྩེ་མོ་ཞེས་བྱ་བ།",
    "༢༧༧བསྡུར་འབྲས་རེའུ་མིག་༢༧༨༡༧༥༥ ཁྲོ་བོ་རྒྱལ་པོ་རྡོ་རྗེ་གནམ་ལྕགས་འབར་བ་ཞེས་བྱ་བའི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་༢༧༩སྔོན་དུ་བསྙེན་པ།",
    "༢༩༦བསྡུར་འབྲས་རེའུ་མིག་༢༩༧༡༧༥༦ གཤིན་རྗེ་གཤེད་པོ་སྒྲུབ་པའི་ཐབས།",
    "༣བསྡུར་འབྲས་རེའུ་མིག་༣༡༡༧༥༧ རྟ་མགྲིན་གྱི་སྒྲུབ་ཐབས།",
    "༣༧བསྡུར་འབྲས་རེའུ་མིག་༣༧༡༧༥༨ རྟ་མགྲིན་གྱི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ།",
    "༣༡བསྡུར་འབྲས་རེའུ་མིག་༣༡༡༧༥༩ རྟ་མགྲིན་གྱི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ།",
    "༣༡༢བསྡུར་འབྲས་རེའུ་མིག་༣༡༢༡༧༦ རྟ་མགྲིན་གྱི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ།",
    "༣༡༧བསྡུར་འབྲས་རེའུ་མིག་༣༡༧དེབ་སོ་བརྒྱད་པའི་དཀར་ཆག་༡༥༡༧༦༡ འཕགས་པ་རྟ་མགྲིན་གྱི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ།",
    "༣༢༥བསྡུར་འབྲས་རེའུ་མིག་༣༢༦༡༧༦༢ དཔལ་རྟ་མགྲིན་གྱི་སྒྲུབ་ཐབས།",
    "༣༢༩བསྡུར་འབྲས་རེའུ་མིག་༣༣༡༧༦༣ འཕགས་པ་མི་གཡོ་བའི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ།",
    "༣༣༩བསྡུར་འབྲས་རེའུ་མིག་༣༤༡༧༦༤ ཁྲོ་བོའི་རྒྱལ་པོ་འཕགས་པ་མི་གཡོ་བ་ལ་བསྟོད་པ།",
    "༣༤༣བསྡུར་འབྲས་རེའུ་མིག་༣༤༣༡༧༦༥ ཁྲོ་བོའི་རྒྱལ་པོ་འཕགས་པ་མི་གཡོ་བ་ལ་བསྟོད་པ།",
    "༣༤༧བསྡུར་འབྲས་རེའུ་མིག་༣༤༧༡༧༦༦ ཁྲོ་ཆེན་གཏུམ་པོའི་སྒྲུབ་ཐབས།",
    "༣༥༢བསྡུར་འབྲས་རེའུ་མིག་༣༥༢༡༧༦༧ ཁྲོ་བོ་གཏུམ་པོ་ཆེན་པོའི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ།",
    "༣༥༥བསྡུར་འབྲས་རེའུ་མིག་༣༥༥༡༧༦༨ གཏུམ་པོ་དཀར་པོ་ཆེན་པོའི་སྒྲུབ་ཐབས།",
    "༣༥༨བསྡུར་འབྲས་རེའུ་མིག་༣༥༨༡༧༦༩ འཕགས་པ་མི་གཡོ་བའི་སྒྲུབ་ཐབས།",
    "༣༦བསྡུར་འབྲས་རེའུ་མིག་༣༦༡༡༧༧ ལེགས་པར་གྲུབ་པར་བྱེད་པའི་སྒྲུབ་པའི་ཐབས་བསྡུས་པ།",
    "༤༥༡སློབ་དཔོན་ཆེན་པོ་བོ་དྷི་སཏྭས་མཛདབསྡུར་མཆན་༤༨༨བསྡུར་འབྲས་རེའུ་མིག་༤༩༡༡༧༧༤ ཚ་ཚ་གདབ་པ་ལ་སོགས་པའི་ཆོ་ག་བཞུགས་སོ།",
    "༥༡བསྡུརའབྲས་རེའུ་མིག་༥༡༢༡༧༧༥ དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་བསྲུང་བའི་སྒྲུབ་ཐབས།",
    "༥༡༥བསྡུར་འབྲས་རེའུ་མིག་༥༡༥༡༧༧༦ སཱཙྪ་ལྔ་གདབ་པའི་ཆོ་ག་བཞུགས།",
    "༥༡༨ བསྡུར་འབྲས་རེའུ་མིག་༥༡༨དེང་སོ་བརྒྱད་པའི་དཀར་ཆག་༡༩༡༧༧༧ གཙུག་ཏོར་དྲི་མེད་ཀྱི་གཟུངས་ཆོག་བཞུགས།",
    "༥༡༩བསྡུར་མཆན་༥༢༡བསྡུར་འབྲས་རེའུ་མིག་༥༢༡༡༧༧༨ གཙུག་ཏོར་དྲི་མེད་ཀྱི་གཟུངས་ཆོག་བཞུགས།",
    "༥༢༤བསྡུར་འབྲས་རེའུ་མིག་༥༢༤༡༧༧༩ མཆོད་རྟེན་གྱི་ཆ་རྣམ་པར་དབྱེ་བ་བཞུགས་སོ།",
    "༥༢༥བསྡུར་མཆན་༥༣༤བསྡུར་འབྲས་རེའུ་མིག་༥༣༤༡༧༨ འཕགས་མ་གདུགས་དཀར་མོ་ཅན་གཞན་གྱིས་མི་ཐུབ་མ་ཞེས་བྱ་བའི་སྒྲུབ་ཐབས།",
    "༥༣༧བསྡུར་འབྲས་རེའུ་མིག་༥༣༧༡༧༨༡ འཕགས་པ་གཞན་གྱིས་མི་ཐུབ་པ་གདུགས་དཀར་མོ་ཅན་གྱི་གཏོར་མའི་ཆོ་ག་ཞེས་བྱ་བ།",
    "༥༥༩བསྡུར་འབྲས་རེའུ་མིག་༥༦༡༧༨༣ བསྲུང་བའི་འཁོར་ལོ།",
    "༥༦༢བསྡུར་འབྲས་རེའུ་མིག་༥༦༣༡༧༨༤ འཁྲུལ་འཁོར།",
    "༥༦༥བསྡུར་འབྲས་རེའུ་མིག་༥༦༥༡༧༨༥ བཟློག་པའི་ཐབས།",
    "༥༦༦བསྡུར་མཆན་༥༦༧བསྡུར་འབྲས་རེའུ་མིག་༥༦༧༡༧༨༦ བགེགས་བཟློག་ཅིང་གཟིར་བའི་ཐབས།",
    "༥༦༩བསྡུར་འབྲས་རེའུ་མིག་༥༧༡༧༨༧ དམག་དཔུང་གཞོམ་པའི་ཐབས།",
    "༥༧༡བསྡུར་མཆན་༥༧༢བསྡུར་འབྲས་རེའུ་མིག་༥༧༣༡༧༨༨ དངོས་གྲུབ་སྒྲུབ་པའི་ཐབས།",
    "༥༧༤བསྡུར་མཆན་༥༧༥བསྡུར་འབྲས་རེའུ་མིག་༥༧༥དེབ་སོ་བརྒྱད་པའི་དཀར་ཆག་༢༡༡༧༨༩ འཇིགས་པ་ལས་སྐྱོབ་པའི་ཐབས།",
    "༥༧༧བསྡུར་འབྲས་རེའུ་མིག་༥༧༧༡༧༩ སེར་བ་སྲུང་བའི་ཐབས།",
    "༥༨༡བསྡུར་འབྲས་རེའུ་མིག་༥༨ ༡༡༧༩༢ གཏོར་མའི་ཆོ་ག་༥༨༢པཎྜི་ཏ་མ་ཧཱ་ཛ་ན་ཉིད་ཀྱི་རང་འགྱུརབསྡུར་མཆན།",
    "༥༨༣ བསྡུར་འབྲས་རེའུ་མིག་༥༨༣༡༧༩༣ འཕགས་པ་དེ་བཞིན་གཤེགས་པའི་གཙུག་ཏོར་ནས་བྱུང་བའི་གདུགས་དཀར་མོ་ཅན་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་ཆོ་ག་ཞེས་བྱ་བ།",
    "༥༨༦བསྡུར་འབྲས་རེའུ་མིག་༥༨༦༡༧༩༤ རིམས་བསྲུང་བའི་ཆོ་ག་༥༨༧བསྡུར་མཆན།",
    "༥༩བསྡུར་འབྲས་རེའུ་མིག་༥༩༡༧༩༦ སྦྱིན་སྲེག་༥༩༡ཞི་བའི་སྦྱིན་སྲེག་༥༩༡སློབ་དཔོན་ཙནྡྲ་གོ་མིའི་གླིང་པས་མཛདམངོན་སྤྱོད་ཀྱི་ལས།",
    "༥༩༦བསྡུར་འབྲས་རེའུ་མིག་༥༩༦༡༧༩༨ བཟློག་པའི་ཟོར་བྱ་བའི་ཆོ་ག་༥༩༧སློབ་དཔོན་ཙནྡྲ་གོ་མིས་མཛད།",
    "༥༩༨བསྡུར་འབྲས་རེའུ་མིག་༥༩༩༡༧༩༩ མཆོད་རྟེན་སྒྲུབ་པའི་ཆོ་གའི་རིམ་པ་ཞེས་བྱ་བ།",
    "༦༢བསྡུར་འབྲས་རེའུ་མིག་༦༢དེབ་སོ་བརྒྱད་པའི་དཀར་ཆག་༢༣༡༨ གཙུག་ཏོར་ནས་བྱུང་བའི་གདུགས་དཀར་མོ་ཅན་གྱི་སྦྱིན་སྲེག་གི་ཆོ་ག་༦༣སློབ་དཔོན་རྡོ་རྗེ་རྣོན་པོས་མཛདབསྡུར་མཆན།",
    "༦༨བསྡུར་འབྲས་རེའུ་མིག་༦༩༡༨༡ འཕགས་མ་དེ་བཞིན་གཤེགས་པའི་གཙུག་ཏོར་ནས་བྱུང་བའི་གདུགས་དཀར་མོ་ཅན་གཞན་གྱིས་མི་ཐུབ་མ་ཞེས་བྱ་བའི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་ཞེས་བྱ་བ།",
    "༦༢༥བསྡུར་འབྲས་རེའུ་མིག་༦༢༦༡༨༢ འཕགས་མ་གདུགས་དཀར་མོ་ཅན་གྱི་སཱཙྪའི་ཆོ་ག་ཞེས་བྱ་བ།",
    "༦༣༦བསྡུར་འབྲས་རེའུ་མིག་༦༣༧༡༨༣ གཙུག་ཏོར་ནས་བྱུང་བའི་གདུགས་དཀར་མོ་ཅན་གྱི་ཆོ་ག་ཞེས་བྱ་བ་༦༣༨སློབ་དཔོན་ཤཱུ་རཾ་ག་བརྨ་བཛྲས་མཛད།",
    "༦༤༦བསྡུར་འབྲས་རེའུ་མིག་༦༤༦༡༨༦ གཞན་གྱིས་མི་ཐུབ་པ་གདུགས་དཀར་མོ་ཅན་ཞེས་བྱ་བའི་དཀྱིལ་འཁོར་གྱི་སྒྲུབ་པའི་ཐབས།",
    "༦༥༡བསྡུར་འབྲས་རེའུ་མིག་༦༥༡༡༨༧ འཕགས་པ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གཙུག་ཏོར་ནས་བྱུང་བའི་གདུགས་དཀར་མོའི་གཟུངས་ཀྱི་སྒྲུབ་ཐབས།",
    "བསྡུར་འབྲས་རེའུ་མིག་༦༦༥༡༨༨ རབ་ཏུ་གནས་པའི་ཆོ་ག་ཞེས་བྱ་བ།",
    "༦༧༡བསྡུར་འབྲས་རེའུ་མིག་༦༧༢༡༨༩ འཕགས་མ་གདུགས་དཀར་མོ་ཅན་གཞན་གྱིས་མི་ཐུབ་པ་སྒྲུབ་པའི་ཐབས།",
    "༦༧༥བསྡུར་འབྲས་རེའུ་མིག་༦༧༥༡༨༡ བཅོམ་ལྡན་འདས་མ་གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མ་ལ་བསྟོད་པ།",
    "༦༧༨བསྡུར་འབྲས་རེའུ་མིག་༦༧༨༡༨༡༡ འཕགས་མ་གཙུག་ཏོར་གདུགས་དཀར་མོ་ལ་བསྟོད་པ།",
    "༦༧༩སློབ་དཔོན་གི་རི་ཝ་ཏས་མཛད།",
    "༦༨༡བསྡུར་འབྲས་རེའུ་མིག་༦༨༡༡༨༡༢ འཕགས་མ་རིག་པ་ཆེན་མོ་སོ་སོར་འབྲང་མའི་འཁོར་ལོ།",
    "༦༨༧བསྡུར་འབྲས་རེའུ་མིག་༦༨༨༡༨༡༣ སོ་སོར་འབྲང་མའི་འཁོར་ལོ་བྲི་བའི་ཐབས་བཞུགས།",
    "༦༧༦བསྡུར་འབྲས་རེའུ་མིག་༦༩༧༡༨༡༥ རྨ་བྱ་ཆེན་མོའི་སྒྲུབ་ཐབས་བཞུགས།",
    "༦༩༩བསྡུར་འབྲས་རེའུ་མིག་༦༩༩༡༨༡༦ སྟོང་ཆེན་མོ་རབ་ཏུ་འཇོམས་མའི་སྒྲུབ་ཐབས་བཞུགས།",
    "༧༡བསྡུར་འབྲས་རེའུ་མིག་༧༡༡༨༡༧ གསང་སྔགས་རྗེས་སུ་འཛིན་མའི་སྒྲུབ་ཐབས་བཞུགས།",
    "༧༣བསྡུར་འབྲས་རེའུ་མིག་༧༣༡༨༡༨ བསིལ་བའི་ཚལ་ཆེན་མོའི་སྒྲུབ་ཐབས་བཞུགས།",
    "༧༥བསྡུར་འབྲས་རེའུ་མིག་༧༥༡༨༡༩ སོ་སོར་འབྲང་མ་ཆེན་མོའི་སྲུང་བ་བཞུགས།",
    "༧༡༧བསྡུར་འབྲས་རེའུ་མིག་༧༡༨༡༨༢ འཕགས་མ་སོ་སོར་འབྲང་མ་ཆེན་མོའི་རིག་པའི་ཆོ་ག་ཞེས་བྱ་བ།",
    "༧༢༣བསྡུར་འབྲས་རེའུ་མིག་༧༢༤༡༨༢༡ བསྲུང་བ་ལྔའི་ཆོ་ག་བཞུགས།",
    "༩༣༣བསྡུར་འབྲས་རེའུ་མིག་༩༣༤༡༨༣ གཟུངས་ཐམས་ཅད་ཀྱི་སྒྲུབ་ཐབས་རིམ་པ་གཉིས་པ་བྱ་བ།",
    "༩༤༩བསྡུར་འབྲས་རེའུ་མིག་༩༥༡༨༣༡ གཟུངས་ཐམས་ཅད་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་ཞེས་བྱ་བ་༩༥༡སློབ་དཔོན་མཁས་པ་ཆེན་པོ་རིན་ཆེན་གྲགས་པས་མཛད།",
    "མི་མཐུན་ཕྱོགས་འཇོམས་བསིལ་བའི་ཚལ། ། གང་གི་ཐུགས་རྗེས་ལུས་ཅན་གྱི། ། འཇིག་རྟེན་ཁམས་སུ་བདེ་ལེགས་གྲོགསམི་མཐུན་ཕྱོགས་འཇོམས་བསིལ་བའི་ཚལ།",
    "ན་མོ་རཏྣ་ཏྲ་ཡཱ་ཡ།",
    "ཁྲུས་དང་འཐོར་འཐུང་དང་ཉེ་རེག་བྱས་ཏེ།",
    "ན་མོ་རཏྣ་ཏྲ་ཡཱ་ཡ།",
    "ཡང་ཁྲུས་དང་འཐོར་འཐུང་ཉེ་རེག་བྱས་ལ།",
    "བདག་གིས་གསོལ་བ་རྒྱལ་བ་ཀུན།",
    "བདག་གིས་གསོལ་བ་རྒྱལ་བ་ཀུན།",
    "ཇི་སྙེད་བདག་གིས་བགྱིས་པ་རྣམས།",
    "དེ་ནས་རང་གིས་རང་མ་རྟོགས་པ་སྟོང་པར་བསྒོམ།",
    "དེ་རྣམས་ལ་གོ་རིམས་བཞིན་དུ་རྡོ་རྗེ་གཏུམ་མོ་དང་།",
    "གཡས་ན་བེ་ཅོན་གྱི་རྩེ་མོ་རྡོ་རྗེས་མཚན་པ།",
    "དད་པ་དང་ནི་དམ་ཚིག་གིས།",
    "གོང་མའི་སྔགས་ལྔ་བརྗོད་ཅིང་ལག་པ་གཉིས་ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་ལ་སྲིན་ལག་གཉིས་ནང་དུ་བཀུག་ལ་ཕན་ཚུན་བསྣོལ་བའི་རྩེ་མོ་མཛུབ་མོའི་དྲུང་དུ་ཅུང་ཟད་བྱུང་བར་བྱས་ལ།",
    "གུང་མོ་གཤིབས་པའི་ཕྱི་རོལ་ནས་མཛུབ་མོ་གཉིས་བཀུག་སྟེ།",
