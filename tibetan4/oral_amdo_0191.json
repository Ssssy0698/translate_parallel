    "རིགས་ཀྱི་བུ་རྣམ་གྲངས་དེས་ན་ིཁྱོད་ཀྱིས་འདི་ལྟར་གལ་ཏེ་དགེ་སློང་ཤཱ་རིའི་བུ་དང་།",
    "འདི་དག་གིས་ཕྱིས་ཡོངས་སུ་ཉམས་པར་བྱེད་མི་ནུས་པར་ཤེས་ན་ནི་དེའི་འོག་ཏུ་འདོད་པའི་དགའ་བ་དང་རྩེད་མོ་ཐམས་ཅད་ལ་མི་ལྟ་བར་སྤངས་ཏེ་འགྲོ་ཞིང་དེ་དེ་དང་འབྲེལ་པའི་སེམས་ལ་གནས་པར་མི་བྱེད་དོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་བསྒོམས་པའི་སེམས་ིཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་བརྟན་པར་གཏད་པས་འདོད་པའི་འདམ་ཆེན་པོར་འཇུག་པར་བྱེད་ཀྱང་དེ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སེམས་ལེགས་པར་བསྲུངས་པ་དེས་གང་གི་ཚེ་འདོད་པ་དེའི་ཚེ་ན་འདོད་པའི་ཁམས་སྤངས་ཏེ་ཚངས་པའི་འཇིག་རྟེན་དུ་སྐྱེ་བར་བྱེད་དོ།",
    "གསང་སྔགས་འཆང་བ་ནི་རྒྱལ་པོའི་མི་རྣམས་ཀྱིས་བཟུང་སྟེ་ཞགས་པ་ལྔའི་ཆིངས་མས་བཅིངས་པར་གྱུར་ཀྱང་དེ་ནི་གང་གི་ཚེ་འགྲོ་བར་འདོད་པ་དེའི་ཚེ་རིག་སྔགས་དང་།",
    "ཐབས་ལ་ེམཁས་པས་འདོད་པའི་ཡོན་ཏན་ལྔ་པོ་དག་གིས་དགའ་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་སོང་ངོ།",
    "༡༩དཔའ་ཆེན་པོ་དགའ་བྱེད་སྟེང་གི་བར་སྣང་ལས་ངང་པའི་རྒྱལ་པོ་ལྟར་ཆགས་པ་མེད་པར་འོང་བ་གཟིགས་སོ།",
    "གཟིགས་ནས་ཀྱང་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་བཀའ་སྩལ་པ།",
    "དེ་ནས་བུ་མོ་དཔལ་ཡོན་ཅན་གྱི་མཆོག་འཆི་བའི་དུས་བྱས་ནས་བུད་མེད་ཀྱི་ལུས་སྤངས་ཏེ།",
    "དེའི་རིམ་གྲོ་བྱེད་པའི་བསྙེན་བཀུར་མ་ལྷའི་བུ་མོ་ཁྲི་བཞི་སྟོང་ཡང་ཉེ་བར་གནས་པར་གྱུར་ཏོ།",
    "དེའི་མོད་ལ་དེས་བདག་གི་ལས་ཅི་ཞིག་བྱས་ཤིང་བསགས་པས་འདིར་སྐྱེས་པར་གྱུར་སྙམ་དུ་བསམས་པ་དང་།",
    "བདག་འདོད་པའི་འདོད་ཆགས་ཀྱིས་ཀུན་ནས་དཀྲིས་པའི་སེམས་ཀྱིས་འཆི་བའི་དུས་བྱས་ནས་བུད་མེད་ཀྱི་ལུས་རྗེས་ཏེ།",
    "དགའ་མགུར་སྤྱོད་ཅིང་བག་མེད་པའི་གནས་པས་གནས་པ་ནི་བདག་གི་ཚུལ་དང་འཐུན་པ་མ་ཡིན་ཞིང་མི་རིགས་ཀྱི།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་ཐལ་མོ་པུག་པུག་པོར་སྦྱར་ནས་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་གསོལ་ཏོ།",
    "མཉན་ཡོད་དུ་ནི་བདག་སྔོན་བུ་མོར་གྱུར།",
    "ཚོང་དཔོན་བུ་མོ་དཔལ་ཡོན་མཆོག་ཅེས་བགྱི།",
    "དེ་ནི་བདག་གི་ཕ་ཡི་ཁྱིམ་དུ་མཆིས།",
    "བསོད་སྙོམས་སྩོལ་བའི་རྔོ་ཡང་མ་ཐོགིནས།",
    "སྐད་ཅིག་དེ་ལ་བུད་མེད་ལུས་སྤངས་ཏེ།",
    "བདག་གི་འོད་གསལ་སྐྱེས་པ་ཉིད་འདི་ཐོབ།",
    "བདག་གི་གཡོག་ིའཁོར་ལྷ་ཡི་བུ་མོ་ནི།",
    "ཆགས་བཅས་སེམས་ཀྱིས་བདག་གིས་བལྟས་གྱུར་པས།",
    "ཆགས་བཅས་སེམས་ཀྱི་རྣམ་སྨིན་འདི་འདྲ་ན་། གང་གིས་དེ་ལ་མཆོད་བགྱིས་ཅི་སྨོས་ཏེ།",
    "བདག་གི་དམ་བཅས་འདི་ནི་སྤང་མི་བགྱི།",
    "བུད་མེད་གང་དག་འདོད་ཆགས་སེམས་ཀྱིས་ནི།",
    "བདག་ལ་རྟོག་པ་བུད་མེད་ལུས་བསྒྱུར་ནས།",
    "བུ་མོའི་ཕ་མ་ཆོ་ངེས་འདེབས་བྱེད་ཅིང་།",
    "སོང་ནས་ཕ་མ་དག་ལ་ཚིག་སྨྲས་པ།",
    "བུ་མོ་དཔལ་ཡོན་ཤི་འཕོས་གང་ཡིན་དེ།",
    "དེས་ནི་བུད་མེད་ལུས་ཀྱང་སྤངས་ིབྱས་ཏེ།",
    "བུ་མོའི་ཕ་དང་མ་དང་ཉེ་དུ་ནི།",
    "བུད་མེད་གང་དག་ཆགས་པའི་སེམས་ཀྱིས་ནི།",
    "བདག་ལ་རྟོག་པ་བུད་མེད་ལུས་སྤངས་ནས།",
    "བུད་མེད་གཅིག་མིན་གཉིས་དང་གསུམ་མིན་ཏེ།",
    "ཀུན་དགའ་འདོད་ཆགས་བསྐྱེད་པ་གང་གིས་ནི།",
    "ལྷའི་བུ་གང་གིས་ང་ལ་མཆོད་བྱས་ཏེ།",
    "གང་དག་ཉོན་མོངས་རྣམས་ཀྱང་བདེ་སྦྱིན་ིན།",
    "རེག་བྱའི་ཆགས་པ་དག་ལ་སྤྱོད་པར་བགྱིད་ཀྱང་དེ་དག་ལ་ཆགས་པར་ཡང་མི་འགྱུར་བ་དེ་དག་ནི་ཐབས་ལ་མཁས་པ་བསམ་གྱིས་མི་ཁྱབ་པ་ལ་གནས་པ་ལགས་ཏེ།",
    "འོད་སྲུང་ཁྱོད་སྤོབས་པར་གྱིས་ཤིག།",
    "སྲིད་པའི་རྩེ་མོ་དང་མཉམ་པའི་ར་བ་ཞེས་བགྱི་བ་དེ་ནི་མ་རིག་པ་དང་སྲིད་པའི་སྲེད་པའི་ཚིག་བླ་དགས་ལགས་སོ།",
    "ཀུན་དུ་རྒྱུ་དག་གི་ཚིག་བླ་དགས་ལགས་སོ།",
    "འོད་སྲུང་ཁྱོད་ཀྱིས་དཔེ་བརྗོད་པ་དེས་ལྷ་དང་མི་རྣམས་ཀྱི་སྐྱེ་དགུ།",
    "ཚིག་གང་གིས་བདག་དང་གཞན་ལ་གདུང་བར་འགྱུར་བ་དེ་ལྟ་བུའི་ཚིག་ཀྱང་མི་སྨྲའོ།",
    "རིགས་ཀྱི་བུ་དེ་ལྟ་མོད་ཀྱི་འོན་ཀྱང་ལེགས་པར་རབ་ཏུ་ཉོན་ལ་ཚུལ་བཞིན་དུ་ཡིད་ལ་ཟུང་ཤིག་དང་།",
    "དཔའ་ཡང་ཞི་བའི་ཏིང་ངེ་འཛིན་དག་ལ་སྙོམས་པར་འཇུག་ཅིང་ལྡང་བར་བྱེད་མོད་ཀྱི་དེའི་ལུས་གཡོ་བར་ཡང་མི་འགྱུར།",
    "སྙམ་ན་ཁྱོད་ཀྱིས་དེ་ལྟར་མི་བལྟའོ།",
    "བྱུང་མ་ཐག་ཏུ་ཡུམ་ལྷ་མོ་སྒྱུ་འཕྲུལ་གྱི་ལུས་ལ་ཡང་རྨ་མེད་ཅིང་སྒྲོས་མེད་ལ།",
    "ཚིག་གི་སྒྲ་དེས་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་འདི་གོ་བར་གྱུར་ནས་ལྷའི་བུ་གང་དག་དེར་མ་ལྷགས་པ་དེ་དག་ཀྱང་སྒྲ་དེ་ཐོས་ནས་ལྷགས་པར་གྱུར་ཅིང་།",
    "ཚངས་པ་དག་ཡིད་བྱུང་བ་སྐྱེས་ཤིང་ངོ་མཚར་དུ་འཛིན་པར་གྱུར་ནས་གུས་པ་དང་བཅས་པས་ཐལ་མོ་པུག་པུག་པོར་སྦྱར་ཏེ།",
    "གཏི་མུག་དང་ལྷན་ཅིག་སྐྱེས་པ་རྒོད་པའི་གད་མོ་ཡང་མེད།",
    "རྟ་གད་དུ་དགོད་༧ པ་ཡང་མེད་མོད་ཀྱི།",
    "ཚངས་པ་དག་གིས་འཁྲུ་བར་བྱེད་ཅེ་ན།",
    "ཚངས་པ་དག་གིས་འཁྲུ་བར་བྱེད་དེ།",
    "བཙུན་མོའི་འཁོར་གྱི་བྱ་བ་ཀུན་དུ་བསྟན་པ་དང་།",
    "རྩེད་མོ་དང་།",
