    "གཅིག་ཏུ་བསྡུས་པའི་སྒྲས་བསྟན་པས་དེ་རབ་ཏུ་སྨད་པར་རིག་པར་བྱའོ།",
    "རབ་ཏུ་བྱུང་བའི་རྟགས་ཡང་དག་པར་ལེན་ཏོ།",
    "ཆོ་ག་མཁས་པས་ཤེས་པར་བྱ།",
    "ཞེས་གསུངས་པས་སོ།",
    "དེ་ལྟར་ན་དེ་ནི་རང་ལ་ལྷའི་རྣལ་འབྱོར་ཆེན་པོར་ལྷག་པར་གནས་པས་རང་ལྷག་པར་གནས་པའི་རྣལ་འབྱོར་ཆེན་པོ་ཞེས་བྱའོ།",
    "ཞེས་བསྟན་པས་རང་ལ་ཞེན་པའམ་རང་རྒྱས་པར་བྱ་བའི་ཆོ་ག་ལ་རང་ལྷག་པར་གནས་པའོ་ཞེས་བྱ་བ་ནི་གཞན་གྱི་ལུགས་ཏེ་དེ་ལ་ཡང་སྐྱོན་བརྗོད་པར་མི་བྱའོ།",
    "ད་ནི་འདིར་རང་ལྷག་པར་གནས་པར་བྱ་བ་འདི་ཉིད་ལེགས་པར་རྫོགས་ཤིང་ཡན་ལག་ཚང་བ་དང་།",
    "ཆེས་མཐུ་དང་ལྡན་པར་བྱ་བའི་ཕྱིར།",
    "བདག་ཉིད་རྫོགས་པར་བྱ་བ་བསྟན་པས།",
    "དེའི་གོ་རིམས་བསྡུས་པ་དྲན་པར་བྱ་སྟེ།",
    "དེ་ལ་དེ་ལྟར་རང་ལྷག་པར་གནས་པ་ལ་སོགས་པ་བྱས་ནས་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི་གོ་རིམས་མཚམས་སྦྱར་བའོ།",
    "བྱས་པ་ནི་ལེགས་པར་རྫོགས་པར་བྱས་ཏེ་ཞེས་པའི་དོན་ཏོ།",
    "བསྒྲུབ་པར་བྱའོ་ཞེས་པ་ནི་ཁ་ཅིག་ཕྱག་རྒྱ་བཞི་དང་ཕྱག་རྒྱ་གཅིག་པའི་རྣལ་འབྱོར་ལ་ཡང་རྫོགས་པར་བྱ་བ་དང་།",
    "རང་ལྷག་པར་གནས་པ་ཡན་ལག་དང་བཅས་པ་བྱས་ལ་བསྒྲུབ་པ་སྟེ་བཟླས་བརྗོད་ལ་སོགས་པ་བྱའོ་ཞེས་པ་སྟེ།",
    "འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་སྔགས་ཐམས་ཅད་ནི་རྣལ་འབྱོར་ཆེན་པོས་བསྒྲུབ་པར་བྱ་བ་ཡིན་པས།",
    "དང་པོར་ནི་བདག་ཉིད་རྫོགས་པར་བྱ་བའི་དང་པོར་རོ།",
    "དང་པོ་འདི་བྱས་ལ་དེ་ལས་གཞན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ལྟར་རྣམ་པ་ཉི་ཤུ་རྩ་གསུམ་པོ་འདི་ཙམ་ཁོ་ན་བདག་ཉིད་རྫོགས་པར་བྱ་བའི་ཆོ་ག་སྐྱོན་མེད་པའི་གོ་རིམས་རྣལ་མའོ།",
    "གཞན་དག་ནི་འདིར་ཆོ་གའི་ཡན་ལག་ཕལ་ཆེར་རྫོགས་ནས་དེ་བཞིན་གཤེགས་པའི་ཟློས་པ་པོ་དམ་ཚིག་སེམས་དཔར་བསྐྱེད་པར་བསྟན་པ་དང་།",
    "བདག་ཉིད་རྫོགས་པར་བྱ་བའི་ལུས་ལ་དགོད་པའི་ལྷ་དེ་བཞིན་གཤེགས་པའི་རིགས་ཉི་ཚེ་ལས་དེ་བཞིན་གཤེགས་པ་རྣམས་མ་བསྟན་ཏེ།",
    "དེ་བཞིན་གཤེགས་པའི་ཟློས་པ་པོས་རང་ལྷག་པར་གནས་པ་དང་བདག་ཉིད་རྫོགས་པར་བྱ་བ་གཉིས་ཀ་སྤངས་ཏེ།",
    "རྡོ་རྗེ་དེ་ཡང་འོད་ཟེར་མང་པོ་འཕྲོས་པས་འགྲོ་བ་སྦྱངས་ཏེ་སླར་འདུས་པ་ལས་གཟུགས་འགྲུབ་པར་བྱའོ།",
    "དེ་ཉིད་ནི་སེམས་དཔའ་རྡོ་རྗེ་རྒྱལ་པོར་ཤེས་པར་འགྱུར་བའི་ཕྱིར་དེའི་སྤྱི་བོར་རོ།",
    "ཡན་ལག་ཐམས་ཅད་དང་བཅས་པར་བསྲུང་བས་ན་དེ་ཡན་ལག་དག་ལས་དེ་རྐང་ལག་ལའོ་གཉིས་ཀྱི་ཚིག་ཅན་ནི་སྔོན་བཞིན་ནོ།",
    "སྒེག་པའི་ཁུ་ཚུར་འཆང་བས་འགྱིང་བ་ནི་ཁུ་ཚུར་སྟོན་པས་དཀུ་གཡས་པར་རོ།",
    "ལུས་ཅན་རྣམས་ལ་མཛེས་པར་བྱ་བའི་ཕྱིར་མེ་ཏོག་ཕྲེང་རྒྱན་དང་།",
    "གོ་རིམས་མི་ཉམས་པར་བྱ་བའི་ཕྱིར་ནི་གཡས་ནས་དང་སྟེང་ནས་སོ།",
    "འོན་ཀྱང་འཚམ་པར་བསྟན་པ་འཇུག་པའི་རྒྱུ་ཡིན་ཏེ།",
    "འཚམ་པ་དེ་ཉིད་དངོས་གྲུབ་ཀྱི་རྒྱུར་བསྔགས་ཏེ་བསྐྱེད་པར་རུང་བས་ནའོ།",
    "སེམས་མ་རྡོ་རྗེ་མ་ལ་སོགས་པ་ཡང་གནས་བཞིར་བྱིན་གྱིས་བརླབས་ནས་བཞུགས་པས་འདི་དག་ལ་དགོད་པ་ཕྱེ་སྟེ་མ་བསྟན་ཏོ།",
    "རང་ལྷག་པར་གནས་པ་ནི་མ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "དེ་ནི་ཡང་དག་མ་ཡིན་ཏེ་གལ་ཏེ་རང་ལྷག་པར་གནས་པ་མ་བྱས་ན་ལྷའི་ལུས་སུ་མ་གྱུར་པས་ལུས་ལ་ལྷ་དེ་དག་དགོད་པའི་གནས་རང་དུ་ཡང་མི་འགྱུར་བ་དང་།",
    "འདི་རང་ལྷག་པར་གནས་པའི་ཡན་ལག་ཙམ་དུ་རབ་ཏུ་གསལ་བའི་ཕྱིར་དང་།",
    "དེ་ལྟར་ཕྱག་རྒྱ་བཞིས་རྒྱས་བཏབ་ནས་དངོས་གྲུབ་ཐམས་ཅད་རབ་ཏུ་སྦྱིན་པར་བྱེད་དོ་ཞེས་བྱ་བ་ལ།",
    "སྐུ་ལ་སོགས་པ་གཞན་གྱི་དོན་ཏེ་བདག་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པའི་རང་བཞིན་ལ་གཞག་པ་ནི་ཇི་ལྟ་བའི་གནས་སྐབས་ཐོབ་པས་དངོས་གྲུབ་སྦྱིན་པར་འགྱུར་ཏེ།",
    "དེས་ན་རྣལ་འབྱོར་པའི་རྒྱུད་མ་ལུས་པར་ཕྱག་རྒྱ་བཞི་བསྡུས་པ་དང་རྒྱས་པར་བསྟན་པའོ།",
    "མྱ་ངན་འདས་པར་རློམ་སེམས་བྱེད།",
    "མྱ་ངན་འདས་པར་རློམ་སེམས་མེད།",
    "མི་གནས་པའི་མྱ་ངན་ལས་འདས་པར་ད་ལྟ་ཉིད་དུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མཐུས་གནས་པ་ནི།",
    "བྱ་བྱས་པ་ཡང་དེ་ཉིད་དོ།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "སྟོང་པ་ཉིད་ལས་ཡིག་འབྲུ་དང་དེ་ལས་དེ་དག་སྟེ་ཡེ་ཤེས་ཀྱི་རང་བཞིན་དུ་གྲུབ་པར་བྱ་བའོ།",
    "དམ་ཚིག་དེའི་ཕྱག་རྒྱ་ཆེན་པོ་འདོད་ཆགས་ཆེན་པོ་ལ་གནས་པའི་རང་བཞིན་འཁོར་ལོས་སྒྱུར་བ་ཆས་པ་ལྟ་བུ་ལྷག་པར་གནས་པར་བྱའི།",
    "ཉན་ཐོས་ལྟར་ལུས་སུན་འབྱིན་ཅིང་མྱུར་དུ་ཞི་བའི་དབྱིངས་སུ་འཇུག་པར་མི་བྱའོ།",
    "སྲིད་པ་ལ་ནི་ཆགས་པར་རུང་བའི་བདེ་བ་མེད་དེ་ཡུན་ཐུང་བ་དང་གནོད་པ་དང་འབྲེལ་བ་དང་།",
    "སྲིད་པར་སྐྲག་ནས་མྱུར་དུ་མྱ་ངན་ལས་འདའ་བར་མི་རིགས་ཏེ།",
    "བསམ་གྱིས་མི་ཁྱབ་པ་འཇིག་རྟེན་ལས་འདས་པའི་འབྱོར་པ་ལས་ཉམས་པར་འགྱུར་བས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱས་པར་སྨོས་པ་ཏེ།",
    "ཧཱུྃ་ཕཊ་ཅེས་པ་ནི་དེ་བྱིན་གྱིས་བརླབ་ཅིང་དེ་ལ་བརྟན་པར་བྱ་བའི་སྔགས་སོ།",
    "བདེན་པ་གཉིས་རྣམ་པར་ངེས་པའི་ལམ་སྦྱིན་པ་ལ་སོགས་པས་བརྒྱན་པ།",
    "ཤིན་ཏུ་ངེས་ཤིང་སླུ་བ་མེད་པ་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ལམ་དེ་ཡང་དུས་ཀྱིས་གནོད་པ་བྱས་པའི་སྐྱེ་བོ་འདི་དག་ཤིན་ཏུ་འཕྲོད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལས་འདོད་པ་ལྔ་བསྟེན་པ་ལ་སོགས་པ་ནི་ལན་འགའ་སྣང་ཞིང་དེ་དགག་པ་དང་བརྟུལ་ཞུགས་དང་སྡོམ་པ་དག་ནི་ཡང་དང་ཡང་སྨོས་པས་ཅུང་ཟད་ཡིད་སྐྲག་པར་འགྱུར་བས་འཇུག་པར་དཀའོ།",
    "དེ་ལྟ་ན་གསུམ་ཞེས་བྱ་བ་མ་བརྗེད་པར་འགྱུར་རོ།",
    "འོན་ཀྱང་གནས་ཀྱི་གཞི་རི་རབ་དེ་གསར་དུ་རྣམ་པར་སྤྲུལ་བར་བྱས་པ་དང་།",
    "བསམ་གཏན་དང་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་མངོན་དུ་བྱ་བ་ནི་ཁམས་གསུམ་ཆར་ལ་འདོད་ཆགས་དང་བྲལ་བ་བྱས་ལ།",
    "འདིར་ཐོད་རྒལ་གྱི་སྙོམས་པར་འཇུག་པ་དང་།",
    "དེའི་འོག་ཏུ་ཡང་བསམ་གཏན་བཞི་པའི་ཆུང་ངུའི་ཆུང་ངུ་ལ་སྙོམས་པར་འཇུག་ཅིང་།",
    "དང་པོ་གནས་ངེས་པར་བྱ་སྟེ།",
    "ཏིང་ངེ་འཛིན་མཁའ་ཁྱབ་ལ་སྙོམས་པར་ཞུགས་ལ།",
    "རིགས་ལྔའི་དམ་ཚིག་ལ་འཇུག་པ་འདི་ལ་དགོས་པ་མེད་དེ་སྔར་དམ་ཚིག་བཟུང་ཟིན་པས་འདིར་དེ་དྲན་པ་ལ་དགོས་པ་ཁྱད་པར་ཅན་མེད་དོ་ཞེས་ཟེར་ལ།",
    "སློབ་དཔོན་གྱིས་རྣམ་པར་དབྱེ་བ་མེད་པ་ཁོ་ནར་སྨོས་པས་འདིར་གཟུང་བར་བྱ་བ་མེད་པས་སྐབས་འདིར་ལེགས་པར་མ་བསྟན་ཏོ་ཞེས་ཟེར་རོ།",
    "མི་ཕྱེད་པར་དམ་པ་བཅའ་སྟེ།",
    "དགོས་པ་སྒྲུབ་པ་ལ་མཁས་རྣམས་སྲན་ཐུབ་པས་དཀའ་བ་རྣམས་ཀྱང་དཀའ་བ་མེད་པར་རྒྱལ།",
    "འགྲོ་བ་མ་ལུས་བཀང་ཞིང་སྟོན་པར་མཛད།",
    "ཅེས་གསུངས་པ་ལྟ་བུའོ།",
    "ལ་ལ་མ་བསླབས་ཞེས་བརྗོད་པར་ཡང་མི་ནུས་པས་སོ།",
    "མཁའ་ཁྱབ་ཀྱི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ་ཞེས་བྱ་བ་ལ་ཏིང་ངེ་འཛིན་འདིའི་ངོ་བོ་ཅི་ཞིག་ཡིན།",
    "ཅིའི་ཕྱིར་འདི་ལ་སྙོམས་པར་འཇུག།",
    "དེ་དག་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་དག་ནི་རྣམ་པ་མི་འདོད་ཀྱིས་ཀྱང་འཕགས་པ་སོ་སོ་རང་རིག་པ་རང་བཞིན་གྱིས་འོད་གསལ་བ་མཐའ་ཡས་པར་ཁྱབ་པ་མཁས་པས་ནི་འདི་དང་མཐུན་པ་མ་ཡིན་ནོ།",
    "འདི་ལ་ཅིའི་ཕྱིར་སྙོམས་པར་འཇུག་ཅེ་ན།",
    "དེ་དག་ཀྱང་དེ་ཁོ་ན་ལྟར་སྒྲ་ཇི་བཞིན་དུ་སྤྱད་པར་བྱ་བ་མ་ཡིན་པས་ན་དང་པོ་འདི་ལ་གཞུག་ཅིང་ཞུགས་ནས་སྒྲ་ཇི་བཞིན་པའི་ལམ་གྱིས་ཡོངས་སུ་ཉམས་པ་དགག་པའི་ཕྱིར།",
    "ཏིང་ངེ་འཛིན་འདིའི་འབྲས་བུ་ནི་དམ་པར་གྱུར་པ་ཅི་ཡང་མེད་དོ།",
    "རྣམ་པ་ཐམས་ཅད་ཀྱི་མཆོག་དང་ལྡན་པའི་སྟོང་པ་ཉིད་དུ་རྣམ་པར་གནས་ལ།",
    "ལྷའི་ཚོགས་དེ་དག་ཀྱང་ཕན་ཚུན་ཕྱག་རྒྱ་དང་ཕྱག་རྒྱའི་ལན་གྱིས་དགྱེས་ཤིང་འཛུམ་པ་ཟག་པ་མེད་པའི་བདེ་བ་དཔེ་མེད་པ་ཉམས་སུ་མྱོང་བས་བཞུགས་པ་སྟེ།",
    "དེ་ལ་འདིར་གོ་རིམས་ཀྱི་དོན་ནི་དང་པོའི་རྣལ་འབྱོར་བྱས་མ་ཐག་ཏུ་ལྷ་རྣམས་ཀྱི་གནས་སུ་གདན་ཟླ་བ་བསམས་ལ།",
    "འདིར་བསྟན་པ་ནི་དང་པོ་རྣལ་འབྱོར་བྱས་མ་ཐག་ཏུ་དཀྱིལ་འཁོར་སྤྲོ་བ་ཡང་འཇུག་པར་བྱའོ་ཞེས་བར་མ་ཆད་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནི་རྣམ་པར་སྣང་མཛད་ཉིད་དོ།",
    "གཟུགས་ཀྱི་ལུས་ནི་ནམ་མཁའི་གཏོས་ཐམས་ཅད་ཁྱབ་པར་དམིགས་པར་མི་ནུས་པས་སོ།",
    "རྣམ་པར་གྲོལ་བའི་ཕུང་པོ་དང་།",
    "གཞན་དག་ནི་འདི་ལ་ལུང་བསྟན་པ་མི་འདོད་དེ་རྗེས་སུ་གནང་བ་ཙམ་ཞེས་ཟེར་རོ།",
    "འདིར་དཀྱིལ་འཁོར་དང་ལྷའི་དེ་ཁོ་ན་ཉིད་ལེགས་པར་ཁོང་དུ་ཆུད་པས་དཀྱིལ་འཁོར་འདི་ལྟ་བུ་བསྒོམས་ན་འབྲས་བུ་རབ་ཏུ་མཐུ་ཅན་དུ་འགྱུར་བར་རིག་པར་བྱ་སྟེ།",
    "དེ་དག་ཀྱང་རྒྱུད་ཀྱི་འགྲེལ་བར་རྒྱ་ཆེར་བསྟན་པས་དེ་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེ་ནས་རྣམ་པར་སྣང་མཛད་དང་བདག་ཉིད་ལྷན་ཅིག་དབྱེར་མེད་པར་རྣམ་པར་བསམས་ལ་བསྡུ་བར་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དཀྱིལ་འཁོར་སྦྲུལ་ནས་སླར་དེའི་རྣལ་འབྱོར་གྱིས་ཐ་དད་པར་གནས་པ་སྲིད་ཅིང་དེ་བཞིན་གཤེགས་པའི་རྣལ་འབྱོར་ཅན་ཡང་ཐ་དད་པར་གནས་པས་ན་འདིར་ལྷན་ཅིག་ཐ་མི་དད་པ་སྨོས་ཏེ།",
    "དེ་ལྟར་ན་རྒྱ་ཆེ་བས་ནི་ཐམས་ཅད་དུ་ཁྱབ་པར་ནུས་ལ།",
    "དཔལ་རྡོ་རྗེ་སེམས་དཔའ་དང་ཐ་མི་དད་པར་བྱ་བའི་ཕྱིར་རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀ་ནས་འཐོན་ལ་དེའི་གནས་སུ་བསྡད་ཅེས་པའོ།",
    "དེ་དག་ལ་རྒྱས་གདབ་པ་ནི་སེམས་མ་རྡོ་རྗེ་མ་ལ་སོགས་པས་དཔྲལ་བའི་སྟེང་ལ་སོགས་པར་རྒྱས་བཏབ་པས་སྔར་བསྟན་པ་ལྟར་རིགས་ལྔའི་དབུ་རྒྱན་གྲུབ་པར་བྱ་བ་སྟེ།",
    "ཞེས་གསུངས་པས་འདིར་རྒྱུ་སྟེ།",
    "འདི་ལྟ་བུ་ནི་ངེས་པར་བསྒྲུབ་པ་ཡང་མི་བྱ་ལ།",
    "དེ་ལྟར་ལུས་དང་ངག་དང་ཡིད་གསུམ་རྣམ་པར་དག་པས་བསྲུང་བ་བྱས་ཏེ་ཚོགས་རྣམ་པ་གཉིས་བསགས་ཤིང་གཞན་གྱི་དོན་བྱས་ནས་བདག་ལྷག་པར་གནས་པ་དང་བདག་ཉིད་རྫོགས་པར་བྱ་སྟེ།",
    "ཡང་དཀྱིལ་འཁོར་པ་ཐམས་ཅད་ཕྱོགས་བཅུའི་འཇིག་རྟེན་དུ་ཕྲིན་ལས་ལ་བཀོད་པར་གྱུར་ཅེས་འདས་པ་ཐམས་ཅད་ཀྱི་ཆོ་གའི་གོ་རིམས་ཀྱིས་དང་པོའི་རྣལ་འབྱོར་དང་།",
    "ལས་ཀྱི་རྒྱལ་པོ་མཆོག་རྣམས་རྫོགས་པར་གྱུར་པའོ།",
    "བཟླས་བརྗོད་བྱས་པས་མཚན་མ་ཐོབ་པར་བྱ་བ་དེ་སྟོན་ཏེ།",
    "བགེགས་བསྐྲད་ཅིང་བསྲུང་བ་བྱས་ལ་སྒོ་བཅད་པ་དང་།",
    "གང་ཡང་རུང་སྟེ་བྱ་བ་གཞན་སྤངས་པས་སྔ་དྲོ་དང་ཉི་མ་གུང་དང་ཕྱི་འཕྲེད་དང་ནམ་ཕྱེད་དང་དུས་མཚམས་བཞིར་བྱའོ་ཞེས་ངེས་པར་བྱས་པའོ།",
    "རྣམ་པར་སྤྲོས་པ་རྒྱས་པ་འདི་ལྟ་བུ་ལྷ་ལ་དམིགས་པ་དེ་སྙེད་དུ་བྱས་ནས་ཤིན་ཏུ་གཡེང་བར་འགྱུར་བ་དང་།",
    "བྱས་ལ་འདིར་ནི་མཐར་ཐུག་པ་དངོས་གཞིའི་རྣལ་འབྱོར་ཡིན་པས་ཆོ་ག་ཐམས་ཅད་རྫོགས་པར་བྱའོ།",
    "དེ་ནས་རྡོ་རྗེ་གནོད་སྦྱིན་ཡོངས་སུ་བཟླས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྒྱས་པར་བསྟན་པའོ་ཞེས་ཟེར་བ་དེ་དག་ནི་རྣལ་འབྱོར་གྱི་རྒྱུད་ཀྱི་ལུགས་ལ་ཁ་ཕྱིར་བསྟན་པ་སྟེ་ཐམས་ཅད་དུ་ཡང་སྔར་བྱ་བ་གསུམ་བྱས་ནས་བསྙེན་པའི་དངོས་གཞི་སྤྱད་པ་ཁོ་ནར་འདོད་པས་སོ།",
    "ལྟ་བ་ལ་སོགས་པས་ནི་གཉིས་སུ་མེད་པར་བྱ་བ་སྟེ།",
    "འབྲས་བུ་རྫོགས་པར་ཐོབ་འགྱུར་གྱིས།",
