    "ཡང་ན་ཁྲུ་དོའི་ཚད་གྲུ་བཞིར་དོང་བརྐོས་ཏེ་དེའི་དབུས་སུ་མཎྜལ་བྱས་ནས་ཤར་གྱི་ཕྱོགས་སུ་མེ་ཏོག་དཀར་པོ་གཞག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ནུབ་དང་བྱང་དང་གཤིན་རྗེའི་ཕྱོགས་སུ་དམར་པོ་དང་སྔོན་པོ་དང་སེར་པོའི་མེ་ཏོག་རྣམས་གཞག་པར་བྱ་སྟེ།",
    "དེ་ལ་དེ་བཞིན་དུ་དོང་དེའི་ཤར་ལ་སོགས་པའི་ཕྱོགས་སུ་བུམ་པ་སོ་མ་བཏང་བའི་སྟེང་དུ་སོ་བཏང་བའི་ཁམ་ཕོར་རྣམས་སུ་དཀར་པོ་ལ་སོགས་པའི་རིམ་པས་བའི་མར་གྱིས་མར་མེ་རབ་ཏུ་སྤར་ནས་ཡོངས་སུ་བརྟག་པར་བྱའོ།",
    "གང་དུ་གཙུག་ལག་ཁང་ལ་སོགས་པ་བཞེངས་པར་འདོད་པའི་ས་ལ།",
    "ཕྱོགས་བཅུ་ན་བཞུགས་པའི་འཇིག་རྟེན་སྐྱོང་བ་ལ་སོགས་པ་རྣམས་ལ་དཔུང་པ་བཟང་པོའི་ཚིགས་སུ་བཅད་པས་མཉེས་པར་བྱས་ཏེ།",
    "ཁྱེད་རྣམས་བདག་ལ་གནང་བར་མཛོད།",
    "སྙན་པའི་གྲགས་པ་བསྐྱེད་པར་བྱ།",
    "ཞེས་པ་འདི་ལན་གསུམ་བརྗོད་པར་བྱའོ།",
    "མདུན་དུ་སའི་རང་བཞིན་གྱི་སྣོད་དུ་ཟླ་བ་ཕྱེད་པའི་རྣམ་པའི་ཐབ་ཁུང་ཡོངས་སུ་བརྟག་པར་བྱའོ།",
    "དུར་ཁྲོད་ཀྱི་སོལ་བའི་ཕྱེ་མའི་རྡུལ་ཚོན་གདབ་སྟེ་མེ་ཏོག་སྔོན་པོ་གཅལ་དུ་དགྲམ་པར་བྱའོ།",
    "དེ་ལ་ཡང་མེ་འབར་བའི་དབུས་སུ་ཧཱུྃ་སྔོན་པོ་ལས་ཡང་དག་པར་བྱུང་བ་ཁ་དོག་སྔོན་པོ་གོས་སྔོན་པོ་ཅན་རྒྱན་གྱིས་བརྒྱན་པ་ཁྲོ་ཞིང་འཇིགས་སུ་རུང་བའི་གཟུགས་ཅན་ཞལ་མཆེ་བ་གཙིགས་པ་སྐྲ་དམར་སེར་གྱེན་དུ་འཁྱིལ་བ་མིག་གཅིག་འཛུམ་ཞིང་ལྟ་བའི་སྤྱན་གསུམ་དང་བཞིན་ཁྲོ་གཉེར་དང་ལྡན་པའོ།",
    "འདིས་བགེགས་ཐམས་ཅད་ལ་ཕུར་བུས་གདབ་པར་བྱའོ།",
    "འདིས་བགེགས་ཐམས་ཅད་གསད་པར་བྱའོ།",
    "སྔགས་འདིས་སྲེག་རྫས་ཐམས་ཅད་སྦྱིན་པར་བྱའོ།",
    "སྔགས་འདིས་སྔོན་བཞིན་དུ་སྲེག་རྫས་སྦྱིན་པར་བྱའོ།",
    "ལྷག་མ་རྣམས་ནི་སྔོན་མ་བཞིན་དུ་སྦྱིན་པར་བྱའོ།",
    "བཟོད་པར་གསོལ་ཞིང་གཤེགས་སུ་གསོལ་ལོ།",
    "དེ་ནས་ལངས་ནས་ས་ཕྱོགས་གཙང་སར་མགོ་ལྷོར་ཕྱོགས་ཏེ་ཉལ་བར་བྱའོ།",
    "རྨི་ལམ་བཟང་ངན་གྱི་མཚན་མ་བརྟག་པར་བྱའོ།",
    "དེ་ནས་ས་གཞི་ལས་བགེགས་དང་ལོག་འདྲེན་ཐམས་ཅད་ཤིན་ཏུ་རིང་དུ་འབྲོས་པར་འགྱུར་ཏེ་སླར་བཟློག་པར་ལྟ་ག་ལ་འགྱུར།",
    "ས་ཕྱོགས་འདི་ནི་ངེས་པར་གཙུག་ལག་ཁང་ལ་སོགས་པར་དངོས་གྲུབ་ཏུ་འགྱུར་རོ་ཞེས་སོ།",
    "ཞི་བའི་མེ་ལྷ་དཀར་པོ་རྣམ་པར་བསྒོམས་ལ།",
    "ལྷ་ནི་སྟེང་དུ་བཏེག་བྱས་ནས།",
    "རྒྱལ་པོས་འཚིར་བ་སྟེར་བར་བྱེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་མ་བཏོན་ན་ཁྱིམ་མེས་ཚིག་པར་འགྱུར་རོ།",
    "དེ་མ་བཏོན་པར་གྱུར་ན་རིགས་དང་ནོར་ཉམས་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཐམས་ཅད་དུ་ཉེས་པ་དཔག་ཏུ་མེད་པ་བྱེད་པར་འགྱུར་བའི་ཕྱིར་རུས་པ་རྣམས་གདོན་པར་བྱའོ།",
    "ཏིལ་ནག་པོའི་མར་མེ་རབ་ཏུ་སྦྱར་ཏེ་རུས་པ་ཡོངས་སུ་བརྟག་པར་བྱའོ།",
    "ཡང་གང་དུ་རུས་པ་ཡོད་པ་དེར་མར་མེ་རྡུལ་གྱིས་ཉེ་བར་འཐིབས་པར་འགྱུར་རོ།",
    "སྤྱོད་པའི་ཚུལ་དང་ཁྱད་པར་གྱི།",
    "ཞེས་པ་ལན་གསུམ་བརྗོད་པར་བྱའོ།",
    "མིའི་རྐེད་པའི་རུས་པས་ནི་རིགས་ཉམས་པར་བྱེད་དོ།",
    "ཉེ་བར་སྐྲོད་པར་ཡང་འགྱུར་རོ།",
    "ཕུབ་མས་ནི་འབྲུ་རྣམས་ཉམས་པར་བྱེད་དོ།",
    "རྡུལ་གྱིས་ནི་གཞན་དུ་འཁྱམས་པར་བྱེད་དོ།",
    "ར་གན་གྱིས་ནོར་ཉམས་པར་བྱེད་དོ།",
    "བྱི་བའི་ཐོད་པས་ནོར་དང་འབྲུ་རྣམ་པར་ཉམས་པར་བྱེད་དོ།",
    "སྦྲུལ་གྱི་རུས་པས་སྟོབས་དང་ཕུན་སུམ་ཚོགས་པ་ཉམས་པར་འགྱུར་རོ།",
    "སོའི་རུས་པས་བཞོན་པ་ཉམས་པར་བྱེད་དོ།",
    "སོག་པས་ནོར་ཉམས་པར་བྱེད་དོ།",
    "དཔུང་པས་ཕ་རོལ་གྱིས་བརྙས་པར་བྱེད་དོ།",
    "ལྕགས་གསུམ་གྱི་སེལ་གྱིས་དགའ་བ་ཉམས་པར་བྱེད་དོ།",
    "འཁར་བས་ནི་ནོར་ཉམས་པར་བྱེད་དོ།",
    "རྩ་བའི་རུས་པས་ནོར་ཉམས་པར་བྱེད་དོ།",
    "ཏ་ལུ་ཀའི་རུས་པས་སེམས་རྨོངས་པར་བྱེད་དོ།",
    "འབྲུ་ཡིས་བདེ་བ་འབབ་པར་བྱེད་དོ།",
    "རུས་སྦལ་གྱི་རུས་པས་ནི་རིག་པ་ཐོབ་པ་དང་རྒྱས་པར་བྱེད་དོ།",
    "བྱང་ཕྱོགས་ན་གནས་པའི་ཁྲོན་པས་ནི་རྒྱས་པར་བྱེད་དོ།",
    "གཙུག་ལག་ཁང་ནི་བཞེངས་པར་བྱ།",
    "དེ་བཞིན་དུ་ཤར་དུ་ཕྱོགས་ནས་བཞུགས་པའོ།",
    "གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མ་དང་།",
    "ཨོཾ་པརྞ་ཤ་བ་རྱེ་ན་མ་སྭཱ་ཧཱ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་དང་།",
    "སྐྱེ་བོ་དཔག་ཏུ་མེད་པའི་བདེ་བ་ཉེ་བར་འབེབས་པར་བྱེད་པ་ཧྲཱི་ཡིག་ལས་ཡང་དག་པར་རབ་ཏུ་བྱུང་བ་ནི་འདོད་པའི་ཞེས་སོ།",
    "དེ་ནས་ཁང་པ་ཐམས་ཅད་ཀྱི་ལྷ་རྣམས་ཡིད་ཀྱིས་ནམ་མཁའ་ལ་བཞུགས་སུ་གསོལ་ལོ།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་སྔགས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "དེ་ནས་དེའི་དབུས་སུ་རྨ་ལྔ་གདོད་པར་བྱས་ཏེ་ས་དེ་ཁྱབ་པར་གཏོར་རོ།",
    "དེ་ནས་རྨ་དྲུག་གདོད་པར་བྱའོ།",
    "ཁང་ས་ལ་ཐིག་ལེགས་པར་བཏབ་ནས་འབད་པས་ལྟོ་འཕྱེ་བརྟག་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་ཀརྨ་ཀཾ་ཞེས་པ་འདིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་ཡཀྵ་ཧཱུྃ་ཞེས་པ་འདིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་རཀྵ་ཧཱུྃ་ཞེས་པས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་སནྡྷི་བཾ་ཞེས་བྱ་བའི་སྔགས་འདིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཞལ་བསིལ་བ་ལ་སོགས་པ་ཕུལ་ནས་ཡང་དག་པར་མཆོད་ཅིང་བསྟོད་པར་བྱའོ།",
    "ཞག་གསུམ་དང་ལྔ་དང་བདུན་གྱིས་ནས་རྣམས་སྐྱེས་ན་མཆོག་དང་འབྲིང་དང་དམན་པའི་ས་གཞིར་ཤེས་པར་བྱའོ།",
    "དེ་ལ་དོང་གྲུ་བཞི་པར་ལོ་མ་ཅན་གྱི་ཤིང་ལ་བཅུག་ནས་བུམ་པའི་ཆུས་དགང་བར་བྱའོ།",
    "དེ་ནས་དེའི་ཉེ་བ་རུ་འོ་མ་དང་ཆུས་ཡོངས་སུ་གང་བའི་ཆུ་སྣོད་རྟགས་ཀྱིས་མཚན་པ་གཞག་པར་བྱའོ།",
    "ཡུར་བ་བྱས་ཏེ་དེས་དོང་ཟླུམ་པོ་དགང་བར་བྱའོ།",
    "ཆུ་སྣོད་ཀྱང་ཛཱཾ་གུ་ལིའི་གནས་སུ་གཞག་པར་བྱའོ།",
    "བགེགས་དང་བདུད་ཐམས་ཅད་ཉེ་བར་བསྐྲད་པར་བྱ་སྟེ།",
    "འཆད་པར་འགྱུར་བའི་གོ་རིམས་ཀྱི་རིམ་པས་སོ།",
    "དེ་ནས་དཀར་པོས་ཁ་བསྒྱུར་ནས་དཀར་པོར་བྱས་ལ་སྣ་ཚོགས་ཆུ་སྐྱེས་དང་ཟླ་བ་ལ་མཚན་མ་རྣམས་བྲི་བར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ཆེན་པོའི་རྡོ་རྗེ་རྩེ་ལྔ་པ་དཀར་པོའོ།",
    "རྡོ་རྗེ་ཆགས་པའི་རྡོ་རྗེ་དང་བཅས་པའི་ཕྱག་གཉིས་ཀྱིས་ལེགས་པར་རབ་ཏུ་སྦྱིན་པར་བྱེད་པའོ།",
    "རྡོ་རྗེ་སྲུང་བའི་རྡོ་རྗེ་ལས་བྱས་པའི་གོ་ཆའོ།",
    "དར་དང་གསེར་ལས་བྱས་པའི་ཐིག་ལེ་དང་།",
    "མཆོད་ཕྱིར་ཐོགས་ཀྱིས་ཉེ་བར་བརྒྱན་པར་བྱས་ལ།",
    "ཡང་རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་སྔགས་ཀྱིས་དེ་བཞིན་དུ་བསྔགས་ཏེ་མེ་ཏོག་གསུམ་གཞུག་པར་བྱའོ།",
    "སོ་སོའི་སྔགས་ནི་བརྒྱ་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "དེ་ནས་བུམ་པ་དེ་རྣམས་ནས་ཆུ་ཅུང་ཟད་བླངས་ཏེ་ལས་ཐམས་ཅད་པའི་བུམ་པར་བླུགས་སོ།",
    "ད་ནི་བུམ་པ་གཞག་པའི་རིམ་པ་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལ་དཀྱིལ་འཁོར་གྱི་ཤར་གྱི་སྒོ་ནས་བརྩམས་ནས་གཡས་སྐོར་གྱིས་རྣམ་པར་རྒྱལ་བའི་བུམ་པ་ལ་སོགས་པ་རྣམས་ནས་མི་བསྐྱོད་པའི་བུམ་པའི་མཐར་ཐུག་པར་དགོད་པར་བྱའོ།",
    "དེ་ལ་གནས་པའི་ལྷ་རྣམས་ཡིད་ཀྱིས་ནམ་མཁའ་ལ་བཞུགས་སུ་གསོལ་ལོ།",
    "འདིར་གཙུག་ལག་ཁང་ལ་སོགས་པའི་ས་གཞི་ལ་བགེགས་རྣམས་མེད་པར་བསམ་པར་བྱའོ།",
    "དེ་ལ་སྔགས་པ་གནས་པར་བྱ།",
    "དཔའ་བོ་རྣམ་པར་གནོན་པ་དང་།",
    "རྣམ་པར་རྒྱལ་བ་དང་།",
    "རྣམ་པར་རྒྱལ་བ་ཆེན་པོ་དང་།",
    "གཞན་དུ་ཡང་བསྒྱུར་ཏེ་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བ་དང་།",
    "གཡས་དང་གཡོན་པའི་ཞལ་གསུམ་གསལ་བར་བྱས་པ།",
    "རྣམ་པར་རྒྱལ་བ་ཆེན་པོ་དང་།",
    "དཀར་པོ་རྣམས་དོན་གྲུབ་དང་ཙནྡན་དམར་པོས་རྣམ་པར་བྱུགས་ཏེ།",
    "འཇིག་རྟེན་གསུམ་རབ་ཏུ་སྒྲུབ་པར་བྱེད་པ་དང་།",
    "དཔའ་བོ་རྣམ་པར་གནོན་པ་དང་།",
    "ཕུར་བུ་མི་གཡོ་བའི་རྣམ་པར་བསམ་པར་བྱའོ།",
    "ཅེས་པའི་སྔགས་འདི་ཕུར་བུ་སོ་སོ་ལ་བརྗོད་པར་བྱའོ།",
    "ཡིད་ཀྱི་ངན་དུ་སྤྱོད་པ་རྣམས་བཅོམ་ནས་བདེ་བ་ཆེན་པོ་དང་དེ་བཞིན་རོ་གཅིག་པར་ཡང་དག་པར་གནས་ཤིང་བགེགས་ལྷག་མ་རྣམས་རིང་དུ་འབྲོས་པར་བསམ་ཞིང་རྣམ་པ་ཐམས་ཅད་དུ་བགེགས་མེད་པའི་སའི་ཆ་ལྷག་པར་གྲོལ་ལོ་ཞེས་པ་ནི་རིམ་པ་གཅིག་གོ།"
  ]
