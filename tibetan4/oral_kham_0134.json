    "ཞེ་སྡང་བསྐྱེད་ནས་སོ་སྔར་བཤགས་པར་མི་བྱེད་ཕྱིས་སྡོམ་མམི་འཛིན་ཁོན་དུ་འཛིན་ཅིང་ཁོན་དུ་བཟུང་ནས་འདུག་ན།",
    "བཅོམ་ལྡན་འདས་ཡད་སྤྱོད་ཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་གདའ་བསླབས་ན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་སློབ་པ་ལགས།",
    "ས་འདུག་ནས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟེན་ཏེ།",
    "བར་འདུག་པར་གྱུར་ཏོ།",
    "ནཀྱི་སྟན་ལ་འདུག་པ་ལ་གཏོར་བར་བྱ་བའི་མེ་ཏོག་དེ་དག་གང་ནས་རྙེད་པར་འགྱུར་སྙམ།",
    "དེ་ལྟར་བདག་ཉིད་ཆེན་པོ་དེ་འདུས་བཙོང་བའི་ཕྱིར་གྲོང་བར་དུ་འདུག་ནས།",
    "ཞི་སྐལ་བ་དམན་པ་ཞིག་གོ་སྙམ་། སེམས་ཤིང་མ་རིམ་བླགས་ནས་འདུག་གོ།",
    "མེ་ཏོག་དང་བདུག་པ་དང་ལ་དང་ག་དུས་དང་།",
    "སྤྱི་ཕྱིར་དུ་གནས་འདུག་པ་དང་ལ་བཞི་ཚུལ་མ་ཡིན་ནོ་སྙམ་ནམ་ལོ་བདུན་གྱི་བར་དུ་འདོད་པ་དང་གནོད་སེམས་དང་རྣམ་པར་འཚེ་བའི་རྟོགས་པ་ཅུད་ཟད་ཙམ་ཡང་མེད་ཅིང་རོལ་བརྐམ་པ་མ་སྐྱེས་ཏེ།",
    "སྐྱེ་བ་ཐམས་ཅདང་རང་དང་གཞན་སྤྱི་དོན་ལ་འཇུག་པ་བདུད་དང་མུ་སྟེགས་དང་ཕས་ཀྱི་རྒོལ་བ་ཐམས་ཅད་འཇོམས་པར་བྱེད་པ་ལ་ཐབས་སྤྱད།",
    "བརྟན་པའི་སྦ་སྟེགས་སྟན་ལ་འདུག།",
    "རྟག་དང་རང་བཞིན་མི་འགྱུར་ཕྱིར།",
    "དེ་ཡང་རང་ལུས་བདག་ཉིད་དུ།",
    "སྤྲོས་པ་མེད་ཅིང་རང་རིག་ལ།",
    "བརྟན་པའི་སྦ་སྟེགས་སྟན་ལ་འདུག།",
    "བརྟན་པའི་སྦ་སྟེགས་སྟན་ལ་འདུག་ཅེས་བྱ་བ་ནི་བདུད་ལ་སོགས་པས་མི་ཕྱེད་པ་བརྟན་པའི་སྦ་སྟེགས་ཀྱི་སྟན་ལ་འདུག་པའོ།",
    "ཁྱེད་རང་ཉིད་ལྔ་རིག་དཔེ་ཚོགས་ལས།",
    "གང་རང་བཞིན་གཞན་དུ་བསྒྱུར་བར་ནུས་པ་དེའི་ཤེས་པ་ཉིད་ཀྱི་ངོ་བོ་ཉིད་ཀྱང་མ་ཡིན་ལ་རྟག་པ་ཉིད་ཀྱང་མ་ཡིན་ཏེ།",
    "ཇི་ལྟར་རྣ་བས་ཀྱང་སྒྲ་ཐག་རིང་པོ་ན་འདུག་པ་ཐོས་ལ།",
    "དངོས་པོ་ཞེས་བྱ་བ་ནི་དེ་དངོས་སུ་འདུག་པའི་ཕྱིར་དངོས་པོའམ།",
    "འགྲོ་བ་པོའི་མི་མཐུན་པའི་ཕྱོགས་འདུག་པ་པོ་ཡོད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "འདུག་པ་པོ་དཔྱད་པ་ཡང་དེ་ཉིད་ཡིན་ཏེ།",
    "འགྲོ་བ་པོ་མ་ཡིན་པ་ཡང་མི་འདུག་སྟེ།",
    "འགྲོ་བ་དང་བྲལ་བ་ལ་ནི་ཐ་སྙད་དུ་ཡང་འགྲོ་བ་ལས་ལྡོག་པའི་འདུག་པ་མི་འཐད་པའི་ཕྱིར་རོ།",
    "དེ་གཉིས་ལས་གཞན་པའི་གསུམ་པ་ནི་མེད་པས་དེའི་ཕྱིར་འགྲོ་བའི་མི་མཐུན་པའི་ཕྱོགས་འདུག་པ་པོ་ཡོད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་གཏན་ཚིགས་ཀྱི་དོན་མ་གྲུབ་པ་ཉིད་དོ།",
    "རྟག་དང་རང་བཞིན་མི་འགྱུར་ཕྱིར།",
    "ཅི་ནམ་མཁའི་མེ་ཏོག་ཅེས་བྱ་བ་དེའི་དོན་གལ་ཏེ་ནམ་མཁའ་ལ་འདུག་པའི་མེ་ཏོག་ཡིན་པས།",
    "དེ་དག་ཀྱང་ནམ་མཁའ་ལ་འདུག་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་ས་བོན་མ་འགགས་པར་ཡང་མྱུ་གུ་སྐྱེ་བར་གྱུར་ན་ནི་སྦྱང་ལ་སོགས་པ་ལ་འདུག་པ་ཡང་སྐྱེ་བར་ཐར་བར་འགྱུར་རོ།",
    "དེ་ཡང་རྟོག་པའི་སྒོ་ནས་གྲུབ་པའི་ཕྱིར་དཔེར་ན་མུན་ཁྲོད་དམ་ཐག་རིང་པོ་ན་འདུག་པའི་ཤིང་རྡོ་ལ་སོགས་པ་ལ་མིར་ཤེས་པའི་བློ་བཞིན་ནོ།",
    "དེ་ཡང་རང་ལུས་བདག་ཉིད་དུ།",
    "འདུག་སྟེགས་ལ་སོགས་པས་མཛེས་པར་བརྒྱན་པའོ།",
    "དགེ་སློང་དག་ངའི་མདུན་དུ་མ་འདུག་ཅིག།",
    "སྤྲོས་པ་མེད་ཅིང་རང་རིག་པ།",
    "ཕྱི་སའི་ནང་དུ་འདུག་ཀྱང་མདངས་ཆེན་འབར་བའི་ཡིད་བཞིན་ནོར་བུ་མཆོག་འགྱུར་གྱི།",
    "གསེར་གྱི་སྣོད་ན་འདུག་པའི་ནོར་བུ་མཆིང་བུ་དམན་པའི་འོད་ཅན་དེ་ལྟ་མིན།",
    "དེ་བཞིན་དུ་སེམས་རང་རང་དུ་སྣང་བའི་ཡུལ་གྱི་རྣམ་པར་ཡོངས་སུ་གྱུར་པ་ལས་ཡུལ་དུ་སྣང་བ་ཉིད་དུ་འགྱུར་རོ་ཞེ་ན།",
    "བདག་ཀྱང་གཞན་ཞིང་རང་བཞིན་གཞན།",
    "དཔེ་ཉིད་བསྒྲུབ་བྱ་དང་མཚུངས་པའི་ཕྱིར་དངོས་པོའི་དོན་གང་རང་ཉིད་ཀྱང་བསྒྲུབ་པར་བྱ་དགོས་པ་དེས་གཞན་ཇི་ལྟར་སྒྲུབ་པར་བྱེད་ནུས་ཞེས་བྱའོ།",
    "གང་འདིར་ཉི་མའི་དཀར་པོའི་ངོ་བོར་འདུག་པ་ནི་ཟླ་བའི་བདག་ཉིད་ཡིན་ནོ།",
    "བཅིངས་ནས་འདུག་པ་དང་།",
    "གང་དང་གང་དུ་ཞུགས་ཤིང་འདུག་པ་དེར་རྙེད་པ་དེ་དང་དེ་ལ་སྤྱད་ཅིང་བ་ལང་བཞིན་དུ་སྤྱད་ན་འཇིག་རྟེན་ཐམས་ཅད་ལས་རྒྱལ་པར་འགྱུར་རོ་ཞེས་བྱ་བ་དང་།",
    "གང་ཡང་རང་སེམས་གདུག་པ་ཡིས།",
    "བོང་བུ་ལ་སོགས་པ་རྩྭ་ཟ་བ་དེ་དག་དུས་ཐམས་ཅད་དུ་འདོད་ཆགས་ཀྱི་སེམས་ཀྱིས་གནོད་པར་གྱུར་པ་གང་ཡིན་པ་དེ་དག་ཅི་ཤ་ཟ་བ་ཡིན་ནམ།",
    "དབྱར་གྱི་དུས་སུ་ནི་ཆུ་ཤིན་ཏུ་མང་བར་གྱུར་པས་སྐམ་པར་མི་འགྱུར་ཞིང་རང་དང་གཞན་གྱིས་འཕེལ་བ་ཉིད་ཀྱིས་སྨྱོས་པ་ཡིན་ནོ།",
    "དེ་དག་དུས་རིང་པོར་གཅིག་ལ་གཅིག་ཕན་ཚུན་ལྟ་ཞིང་ཡིད་ཀྱི་སྣང་བས་སྡང་བར་བྱེད་དོ།",
    "མི་འབུམ་ཚོ་གཉིས་ཙམ་གྱི་ཚེ་སྲོག་དུས་གཅིག་ལ་བརླགས།",
    "དེ་ལྟ་བུའི་ཀླད་ཆེན་མེད་པའི་མི་ད་སྔོན་དངོས་སུ་མཐོང་ཟིན་པ་ཡང་བཅུ་ཕྲག་འགའ་ཞིག་བྱུང་ཡོད་འདུག་གོ།",
    "དམུས་ལོང་རྣམས་ཀྱིས་གླང་ཆེན་གྱི་གཟུགས་སྨྲས་ཚུལ་གསུངས་པ་ཇི་བཞིན་དུ་བྱུང་འདུག་སྟེ།",
    "སྔོན་གནས་རྗེས་དྲན་གྱིས་བྱུང་བ་རྣམས་གྲངས་དང་སྤུས་ཚད་གཉིས་ཀ་ཇེ་མང་ཇེ་བཟང་དུ་འགྲོ་བར་འདུག་པས་མི་རྣམས་ལ་སྐྱེ་བ་སྔ་ཕྱི་འདི་ཡོད་ལས་ཆེ་སྙམ་བྱེད་དུ་འཇུག་པ་ཙམ་ཡིན་ནོ་ ཞེས་དང་།",
    "རྒྱུན་མི་འཆད་པའི་ཚེ་སྲོག་དེ་ཡོད་པ་ད་དུང་འགོག་ཐབས་མི་འདུག་གོ།",
    "མིང་འདི་ཡི་གེ་སོ་སོ་ལས་སྒྲ་གདངས་བསྒྱུར་ཚུལ་མི་འདྲ་པ་མང་པོ་བྱས་འདུག་ཀྱང་ཕྱི་ཡིག་ཏུ་འདི་ལྟར་བྲིས་སྣང་།",
    "ཨ་པེས་ཀྱི་དུར་ས་དེ་ལ་ཐུན་མིན་གྱི་མཚོན་རྟགས་ཅི་ཡང་མི་འདུག་ཀྱང་ཁོས་མ་ནོར་མ་འཆུག་པར་དེར་ཕྱིན་ཏེ།",
    "ཡུལ་དེ་གའི་མི་རྣམས་ལ་དེ་འདྲའི་སྲོལ་མི་འདུག་ཀྱང་།",
    "ཐེན་སན་ཉོས་སྒོ་དྲུང་དུ་འདམ་མང་པོ་བསགས་འདུག་པ་ཕྱིར་དབོ་བའི་ཆེད་དུ་ཕྱིན་ཚེ་ཆར་གྱིས་རླན་པའི་ཕུག་པ་རྡིབ་སྟེ་རྡིབ་འོག་ཏུ་ཤི་དེ་ལྟ་ནའང་ཁོས་རང་ཉིད་ཤི་བ་མ་ཤེས་ཏེ།",
    "དེ་འཕྲལ་ཡང་ཨ་ཙི་ངའི་ལག་པ་ཅིའི་ཕྱིར་འདི་འདྲའི་ཆུང་ངུར་གྱུར་ཅེས་ཟེར་བས་དེར་ཡོད་ཐམས་ཅད་ཤིན་ཏུ་སྐྲག་ཅིང་ཧ་ལས་ཏེ།",
    "ས་བྲུ་བའི་སྐབས་གད་པ་རྡིབས་ཏེ་གད་འོག་ཏུ་ཤི་འདུག་པས།",
    "ཁང་བའི་སྒོ་ནི་ཕྱེ་སྟེ་བཞག་འདུག་ནང་དུུ་ཕྱིན་པས་མི་གཅིག་ཀྱང་མི་འདུག་ཁང་བའི་གྱང་ལོགས་སུ་གོས་ནག་པོ་འགའ་ཞིག་བཀལ་བ་མཐོང་ནས་རྐུ་སེམས་སྐྱེས་ཏེ།",
    "མི་ཁྱིམ་ཞིག་ཏུ་སྐྱེས་ཏེ་ལུས་ཀྱང་བྱིས་པ་ཆུང་ངུ་ཞིག་ཏུ་གྱུར་ཏེ་གཏམ་སྨྲ་བར་འདོད་ཀྱང་སྨྲ་མི་ནུས་པ་ཞིག་ཏུ་འདུག་འོན་ཀྱང་ལག་མགོ་གཡོན་པ་འདི་ནི་འདི་ལྟར་ཕག་སུག་ཏུ་གྱུར་འདུག་ཟེར་རོ།",
    "ཕྱི་ཉིན་བལྟས་པས་ཇི་ལྟ་བ་བཞིན་འདུག་པ་ཧྲང་ཧེའི་ཏ་ཁྲང་པའོ་ཧྭ་དགོན་གྱི་ཚེ་ཐར་ར་བར་བཏང་སྟེ་ཚེ་ཐར་བྱས།",
    "བརྙན་པར་དེ་ད་དུང་དུའང་འདུག་གོ།",
    "ཚེ་འདིའི་བག་ཆགས་མཐུ་བརྟས་པས་མི་གསལ་བའམ་བརྗེད་འགྲོ་བར་འདུག་གོ།",
    "དེའི་ཚེ་ཇི་འདྲ་འདུག་པ་དྲིས་ན་ཐམས་ཅད་ཇི་བཞིན་དུ་ལན་འདེབས་སོ།",
    "དེ་ལ་གཉིད་འབེབས་བྱས་པས་འཛམ་གླིང་གཡུལ་ཆེན་གཉིས་པའི་སྐབས་སུ་ཁོང་རང་འཇར་མན་གྱི་གནམ་དམག་འཕུར་བསྐྱོད་པ་ཡིན།",
    "ཀྲན་ཧྲིན་ལ་དེང་རབས་སུའེ་ཏེན་གྱི་དངོས་རྫས་ལ་ཆ་རྒྱུས་ཡེ་མི་འདུག་འོན་ཀྱང་།",
    "ཞེས་ཡང་ཡང་གསུངས་པ་ཇི་ལྟ་བ་བཞིན་དུ་བྱུང་འདུག་གོ།",
    "ང་རང་དང་གསུམ་ཀ་འདུས་པ་ལ་འབོད་ནས།",
    "ཁྱེད་རང་གསུམ་ཀ་ཆབ་ནག་འདི་རུ་མ་བསྡད་པར་ཆབ་དཀར་དུ་ཕྱིན་པ་དྲག་ད་ང་མགྱོགས་པར་རྩི་དཀར་དུ་འགྲོ་དགོས་པ་ཡོད།",
    "རྗོ་རྗེ་རྒྱལ་མཚན་སྡུག་གེ་ཡང་གནས་ཁང་བཟང་པོ་དཀོན་དྲགས་ནས་ད་རུང་མ་རྙེད་པར་འདུག་སྡིག་ཅན་གྱི་ཁྱིམ་དུ་ནི་ངས་མ་བཏང་།",
    "ད་ང་རང་སྡིག་ཅན་ཡིན་ཡང་ཡིན།",
    "ཡང་ཤིང་ཁུར་དེ་ཁུར་ནས་ཡུད་དེ་ཡུད་དེ་འཕྲང་ལ་འགྲོ་ཞིང་འདུག་གོ།",
    "ཁ་འཆམས་ཤིང་མཉམ་པོར་འགྲོགས་རྒྱུ་འདུག་པས་ཁྱེད་རྣམས་ལ་སྨོན་པ་ཡིན།",
    "ཡུད་དེ་ཡུད་དེ་འགྲོ་འདུག་པ་ལ།",
    "ཡང་ཁོས་མི་ཡུལ་དུ་འདུག་ཡུན་ཐུང་བས་ཞེ་མ་ཚིམས་ང་མི་ཡུལ་དུ་དེ་བས་རིང་བ་གཅིག་འདུག་རྒྱུ་ཡིན་པ་ལ།",
    "ང་རང་མི་ལུས་ཐོབ།",
    "བཏགས་གྲོལ་སྦྲགས་མ་དེས་ང་རང་ལ་ཤིན་ཏུ་ཕན་པ་བྱུང་།",
    "ཆུ་དེ་ལ་བསྒྲལ་བ་ཙམ་དུ་འདུག་དེ་ནས་རྡོ་རྗེ་སྲི་ཐར་དང་།",
    "ཁོ་ཞེད་ནས་འདར་ཡེད་ཡེད་བྱེད་འདུག་པ་དང་།",
    "རི་བོ་ཁར་བཅུག་པའི་མི་གཅིག་འདུག་ཟེར།",
    "ངས་བུ་ཚ་ལ་ང་རང་རྣམས་ཆབ་དཀར་དུ་འགྲོ་བྱས་པས།",
    "ལག་པ་ནས་བཟུང་བས་གཟུང་རྒྱུ་འདུག་ངེས་པ་མི་འདེན་ནམ་བསམ་ངེས་པར་ཨེ་བདེན་ནམ་བསམས་ནས།",
    "འོ་ན་ཁྱིམ་འདིའི་ནང་ན་འདུག་ཉན་ཨེ་སྣང་ལྟོས།",
    "ཁོ་མར་བབས་མི་འོང་བར་སྟེང་ནས་མར་མིག་གཅིག་བལྟས་མ་ངོམས་པ་འདྲ་གཅིག་བྱས་ནས་འགྱེད་དེ་ལོང་འདུག་ང་མར་བབས་ནས་བར་ཁང་དེར་ཕྱིན་པས།",
    "མི་འདུག་པའི་རྗེས་མེད་པ་ཧང་ལ་རྒོག་པ་གདུང་མ་ཆད་ལ་ཁད་པ།",
    "ཀ་བའང་གས་ནས་ཞིག་ལ་ཁད་པ་གཅིག་འདུག་འོག་ཁང་དེར་ཕྱིན་པ་དང་།",
    "ཕྱིར་སྒོ་ཆུང་གཅིག་འདུག་པ་ལ་འགྲོ་བར་བརྩམས་པ་ནས་ཁོ་སྡུག་པ།",
    "ལབ་ལབ་ཡིད་ཆེས་པ་གཅིག་བྱེད་རྒྱུ་ཡིན་པར་འདུག་པ་ལ།",
    "དྲན་ཡང་ཐམས་ཅད་འདས་ཟིན་པས་སླར་གླེང་བ་ལ་དགོས་པ་མི་འདུག་གོ།",
    "འོན་ཀྱང་བྱིས་པ་ནི་མི་གཞན་ཞིག་ཏུ་གྱུར་འདུག་སྟེ་སྔར་ནི་རིག་པ་བརྟུལ་ཞིང་རྒྱུད་འཇམ་པ་ཞིག་ཡིན་ན་གྲུང་ཞིང་སེམས་སྐྱིད་པོ་ཅན་ཞིག་ཏུ་གྱུར།",
    "སྐྱེས་མཆོག་མར་བ་ལོ་ཙཱ་ལ་ཚེ་གཅིག་ལུས་གཅིག་ལ་སངས་རྒྱ་བའི་གདམས་ངག་ཡོད་ཟེར་ཏེ་མི་བདེན་པ་འདུག་གོ།",
    "སྲས་མཁར་ལ་བསྐོར་བ་གསུམ་བྱས་ནས་ཡབ་ཀྱི་སྐུ་དཔུང་གཡས་པའི་སྟེང་དུ་བབས་ནས་བཞུགས་པར་གདའ།",
    "བྲམ་ཟེའི་ཁྱེའུ་ལོ་བཅུ་གསུམ་ཙམ་ལོན་པའི་རོ་སྐྱེལ་བ་དང་ཕྲད་འོང་བར་འདུག་པས།",
    "སྔར་ཡབ་ཀྱི་ཐུགས་རྗེས་རྒྱ་སྐད་བརྡ་འཕྲོད་ཙམ་མཁྱེན་པས་ང་རོ་ལངས་མིན་ང་རང་སོས་པ་ཡིན།",
    "ཁོ་མ་ཤི་བར་འདུག་ཟེར་མདུན་དུ་བྱུང་།",
    "རིམ་གྲོ་ལ་དུར་ཁྲོད་དུ་ཕྱིན་པར་འདུག་ཟེར།",
    "མཁས་གྲུབ་ཀྱི་སྐྱེས་ཆེན་ཏེ་ཕུ་གསང་སྔགས་ཀྱི་སྡོང་བོ་ཞེས་བྱ་བ་དེ་བྱུང་བར་གདའ།",
    "ངའི་ལུས་ནི་མལ་ཁྲིའི་སྟེང་དུ་ཉལ་ནས་འདུག་སྟེ།",
    "ཨ་ཙི།",
    "ང་རང་འདིར་བདེ་བར་གནས་པ་མ་ཡིན་ནམ་སྙམ་དུ་བསམ།",
    "མི་ཚོགས་ཀྱིས་རླངས་འཁོར་གྱི་མཐའ་ནས་བསྐོར་ཏེ་བལྟས་འདུག་ངའི་གྲོགས་པོ་དངངས་སྐྲག་ཆེན་པོའི་ངང་ནས་རླངས་འཁོར་ལས་ཕྱིར་ཐོན་བྱུང་།",
    "ལུས་དང་བྲལ་བའི་ཚེ་ང་ལ་ནམ་མཁར་འཕུར་བར་བྱ་སྙམ་པའི་རྟོག་པ་ཞིག་སྐྱེས་ཀྱིན་འདུག་ཕྱི་མིག་བལྟས་པས་ངའི་ལུས་ནི་འཇམ་ཐང་ངེ་མལ་ཁྲིའི་སྟེང་ཉལ་འདུག་པ་མཐོང་སྟེ།",
    "ང་རང་མྱུར་དུ་འཆི་བ་ཡིན་ཡང་ཐང་།",
    "འོད་དེ་ཐོག་མར་བཀྲག་མདངས་ཆེར་མེད་པ་ཞིག་ཏུ་འདུག་པ་ལ།",
    "འཕྲལ་དུ་ཧ་ཅང་གསལ་ཞིང་བཀྲག་མདངས་ཆེ་བ་འཇིག་རྟེན་ཁམས་ན་དེ་ལས་གསལ་བའི་འོད་མཐོང་མ་མྱོང་བ་ལྟ་བུ་ཞིག་ཏུ་འགྱུར་འགྲོ་བར་འདུག་ཅེས་ཟེར་རོ།",
    "ཞེས་གསུངས་འདུག་པ་དེ་ཉིད་ཇི་ལྟར་བྱུང་ཚུལ་ནི།",
    "འཆད་སྟེགས་ལྟ་བུ་ཞིག་འདུག་ཁོ་ཚོ་དང་མཐོ་དམན་ཆེར་མེད།",
    "ཁྲག་རྩར་ཁྲག་རྒྱུ་བར་བྱས་ཏེ་གསོན་དུ་འཇུག་སྙམ་གྱིན་འདུག་ངས་ཁོང་རྣམས་ལ།",
    "ལག་པ་དེ་ཚོ་ཕར་བསལ་ཟིན་སྙམ་པའི་རྗེས་སུ་ད་དུང་དེ་ག་རང་ན་འདུག་སྟེ།",
    "ང་རང་ཁང་བར་གྱི་ལམ་དོག་པོ་ཞིག་ཏུ་ལང་ནས་བསྡད།",
    "དངོས་པོ་གང་ལའང་ཐོགས་པ་མི་འདུག་ཅེས་ཟེར་རོ།",
    "ང་རང་འགྲོ་བར་འདོད་པ་ཙམ་གྱིས་དེ་མ་ཐག་ཏུ་དེ་གར་འབྱོར་བར་འདུག་ཅེས་ཟེར།",
    "ང་རང་བསུ་མར་འོང་བ་ལྟ་བུའི་སྣང་བ་ཞིག་བྱུང་ཞེས་ཟེར།",
    "ལུས་ཤིག་ནི་འདུག་སྟེ།",
    "ང་ཤི་བ་ཡིན་ནམ་ཞེས་ཡང་ཡང་དྲིས་ཀྱང་ཁོས་གཏམ་ལན་ཚིག་གཅིག་ཀྱང་མི་སྨྲ་བར་ཀྲོང་ངེར་འདུག་གོ།",
    "རྣ་ཤེས་དང་ཡིད་ཤེས་བཅས་ཤིན་ཏུ་གསལ་ཏེ་ཡ་མཚན་པ་ཞིག་ཏུ་འགྱུར་འགྲོ་བར་འདུག་ཟེར་རོ།",
    "ད་ལྟ་མི་སྲིད་པ་ཐམས་ཅད་ཀྱང་དེར་སྲིད་པར་འདུག་ཁྱད་པར་དུ་ཡིད་ཀྱི་ཤེས་པ་ཧ་ཅང་གསལ་ཏེ།",
    "ཐམས་ཅད་འཕྲལ་དུ་ཇི་བཞིན་དྲན་ཐུབ་པ་འདུག་སྟེ།",
    "ངེད་ལ་ད་དུང་ལུས་གཞན་ཞིག་འདུག་སྟེ།",
    "ཡང་པ་བྱ་སྒྲོ་ལྟ་བུ་ཞིག་ཏུ་འདུག་ཟེར།",
    "དེ་ཚེ་ང་ལ་ལུས་གཞན་ཞིག་འདུག་འོན་ཀྱང་།",
    "ལུས་དེ་ལ་དབྱིབས་ནི་ཆ་ཚང་འདུག་ལ།",
    "ཁ་དོག་ནི་མི་འདུག་ཅེས་ཟེར།",
    "ད་ནི་ང་ཤི་ནས་འདུག་པས་ཅི་དྲག་སྙམ་སྟེ",
    "འཇིགས་སྐྲག་དང་ཉམས་མི་དགའ་བའང་བྱུང་སྟེ་གཅིག་ཏུ་མ་ངེས་པར་འདུག་གོ།",
    "མི་རྣམས་ཧ་ལས་དགོས་པ་ཙམ་དུ་གྱུར་འདུག་ཞེས་དང་།",
    "འགྲོ་འདུག་ཅི་བྱས་རང་ལ་འཁོར།",
    "ལྷ་ཁང་གཉིས་ཙམ་འདུག་པ་མཇལ་བ་ཡི།",
    "མི་གོ་འདུག་པས་འབར་ཤ་འགའ་ཡང་བྱས།",
    "སྔ་བས་འཆར་འདུག་རི་དེ་ཤིན་ཏུ་མཐོ།",
    "ཅེས་གསུངས་སོ་ རྨི་ལམ་འདིའི་ངང་ནས་རི་གླིང་རྒྱ་མཚོ་དང་བཅས་པ་བརྒལ་ནས་ཤིན་ཏུ་རྒྱང་རིང་པོར་འགྲོ་ཐུབ་པར་འདུག་འདི་རྣམས་སྒོམ་སྟོབས་ཀྱིས་བྱུང་བ་ཡིན་ལ།",
    "ཉ་ཤའི་བྱན་དང་བཅས་པའི་ཁ་ཟས་བཟའ་ཞིང་མདུན་ན་ཁྱི་ནག་པོ་ཞིག་འདུག་པ་དེ་ལ་ཉའི་རུས་པ་འདོར་རོ།",
    "ཁྱིམ་དེའི་སྒོ་ན་ཡུལ་གཞན་ནས་འོངས་པའི་སྐྱེས་བུ་མཁས་པ་ཞིག་སྔ་ན་འདུག་པ་དེས།",
    "མི་དེའི་པང་ན་འདུག་པའི་བུ་དེ་ཡང་དེའི་ཆུང་མའི་བྱི་བོ་ཡིན་ཏེ།",
    "དེ་ནི་སྟོང་བསམ་རང་དུ་འདུག་སྟེ།",
    "བུའི་རྐང་ལག་བཞི་ཆར་རུས་སྦལ་གྱི་རྐང་ལག་ཇི་ལྟ་བ་བཞིན་འདུག་མགོ་ན་མིའི་ཁ་མིག་རྣ་བ་རྣམས་ཡོད་ཀྱང་མགོའི་དབྱིབས་རུས་སྦལ་ཁོ་ན་ལྟར་དུ་བྱུང་ངོ།",
    "བདེན་པར་འདུག་ཕྱིན་ཅི་ཡང་ཁོང་དུ་ཤོང་ལ།",
    "ཡང་ནུབ་ཕྱོགས་པ་འགའི་དཔྱད་རྩོམ་གྱི་མཇུག་ཏུ་འདི་ལྟར་བྲིས་འདུག་སྟེ།",
    "དེ་ཉིན་ཆར་ཞིག་འབབ་ཀྱིན་འདུག་བྱིས་པས་སྒེའུ་ཁུང་ནས་ཕྱིར་བལྟས་ཏེ།",
    "ད་ལྟ་མི་འདུག་པས་འགྲོ་མི་ཤེས་ཟེར།",
    "སྔར་གྱི་ཁང་པ་དེ་དེ་སྐབས་གནས་གཞན་དུ་སྤོས་ཟིན་པ་ཡིན་འདུག་དེ་རྗེས་གསེར་ལྷ་རྩེ་དགོན་དུ་སྐོར་བར་ཕྱིན་ནས་ལམ་བར་དུ་ཆར་བབས་ཏེ།",
    "དེར་འཁོར་ལོ་ཀོ་ཤུབས་ཅན་ཞིག་འདུག་སྟེ།",
    "འོན་ཏེ་རྨི་ལམ་དུ་དེ་འདྲ་ཞིག་རྨིས་པ་ད་ལྟ་དྲན་པ་གང་ཡིན་དབྱེ་བ་འབྱེད་མི་ཐུབ་པར་འདུག་ང་ལོ་ཤིན་ཏུ་ཆུང་ངུའི་སྐབས་ཤིག་ན་འབྲུག་དཀར་པོ་ཞིག་ཞོན་ནས་འོང་པ་རྨིས་པ་དྲན་ཏེ།",
    "ཁྱིམ་མི་རྣམས་ཀྱིས་བྱིས་པ་ལོ་གསུམ་བཞིའི་སྐབས་སུ་ཤིན་ཏུ་གསལ་པོར་དྲན་གྱིན་འདུག་སྟེ།",
    "སྔ་མའི་ཕ་མ་གཉིས་ལའང་ཕ་མ་དངོས་ཀྱི་འདུ་ཤེས་དང་བརྩེ་གདུང་བཅོས་མིན་ཡོད་པ་སོགས་ཀྱིས་སྔ་མའི་ཡང་སྲིད་དུ་གསལ་པོར་ངོ་འཕྲོད་པ་ཞིག་ཡིན་པར་འདུག་གོ།",
    "དེ་ཚང་ལ་པད་མ་ནས་ཡིན་ཚུལ་སྨྲས་པ་ན་བྱིས་པ་ཞིག་ཉལ་ནས་འདུག་པ་བསླངས་ཏེ་ཁྲིད་བྱུང་།",
    "ངའི་བུའི་ཡང་སྲིད་དེ་དགའ་བདེ་ན་འདུག་ཅེས་པའི་གཏམ་ཞིག་ཨ་སྐྱོང་ནས་ཡར་གྲགས་ནས་བྱུང་ལ།",
    "གོས་རྙིང་ཤིན་ཏུ་ཧྲུལ་པོ་ཞིག་གྱོན་ནས་ཆེས་ཉམ་ཐག་པ་ཞིག་ཏུ་འདུག་སྟེ།",
    "ད་ནི་འདི་ལྟར་དུ་གྱུར་འདུག་ཟེར།",
    "སྤྱིར་བྱིས་པ་ཆུང་ངུའི་དུས་སུ་སྔ་ཕྱིའི་སྐྱེ་བ་དྲུག་རྗེས་སུ་དྲན་པར་འདུག་སྟེ།",
    "སྐྱེས་མ་ཐག་པ་ནས་རྣ་སྣེ་ལ་བུ་ག་ཤིན་ཏུ་ཆུང་ངུ་ཞིག་དང་རྣ་བའི་སྟེང་ཕྱོགས་ན་རྨ་ཤུལ་ཞིག་འདུག་ཅེས་ཟེར་ཏེ།",
    "འོན་ཀྱང་དེ་རྣམས་ལས་མང་ཆེ་བ་ཞིག་བརྗེད་པར་གྱུར་ཟིན་འདུག་ཟེར།",
    "འགའ་ཞིག་ནི་བརྗེད་ནས་འདུག་གོ།",
    "མི་རྣམས་དང་འཕྲད་པ་ན་སྔོན་ངོ་ཤེས་མི་ཤེས་དང་ཉེ་ས་ཡིན་མིན་སོགས་སེམས་ལ་གོ་འོང་རྒྱུ་ཞིག་འདུག་སྟེ།",
    "ཕ་ནི་ཚེ་འདིའི་ཐོག་ནས་ཀྱང་འགྲོགས་ཡུན་ཅུང་ཟད་རིང་བས་ད་ལྟའང་ཕ་དངོས་དང་ཁྱད་པར་མི་འདུག་ཅེས་ཟེར་རོ།",
    "ཁྱིམ་ཚང་གཉིས་ལ་ནི་སྔར་འབྲེལ་བ་ཅི་ཡང་མི་འདུག་པར་མ་ཟད་ཕན་ཚུན་ངོ་ཡང་མི་ཤེས།",
    "མཆོག་ལྡན་ངེད་གཉིས་ལོ་པས་སླེབས་འདུག་ཟེར་བ་ཐོས།",
    "ང་ལ་ཕའི་འདུ་ཤེས་ཅུང་ཟད་ཀྱང་མི་འདུག་དེ་ཡན་ཆད་དུ་བྱིས་པ་གཉིས་ཡོད་ཀྱང་དེ་གཉིས་དེ་འདྲ་ཞིག་རྩ་བ་ནས་མིན།",
    "སྐབས་དེར་བྱིས་པ་ཆུང་ངུ་ཐག་པས་ཕུར་བ་ལ་བཏགས་ནས་འདུག་དེར་ཁོ་ལ་དྲིས་ཏེ།",
    "དེ་ཉིན་ངེད་གཉིས་ལ་སྐོར་བ་བྱེད་ཅིང་འདུག་པ་ལས་ཅང་མི་སྨྲ།",
