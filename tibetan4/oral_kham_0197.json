    "རྣམ་རྟོག་དེ་ཉིད་སེམས་སུ་འདུག།",
    "རིག་པ་དང་ལ་བཞག་ཙ་ན།",
    "ཡང་རྔུའཛིན་པ་འདུག་ན་རྣམ་རྟོག་ཡིན།",
    "སྟོང་ཉམས་སུ་ལུས་བར་སྣང་དུ་འདུག་པ་ལྟ་བུ།",
    "བདེ་ཉམས་ལུཁྲིག་དུས་ལྟ་བུའི་བདེ་བས་མྱོས་པ།",
    "རྩེལ་བ་གློད་ལ་བཏང་སྙོམས་སུ་བྱ་ཞིངཀྱོ་བར་དུ་འདུག་པར་བྱའོ།",
    "དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ།",
    "འགྲོ་འཆག་ཉལ་འདུག་ལ་སོགས་པ།",
    "ཁྱེད་རང་ལུགས་ཀྱི་གཞུང་ལུགས་ལ།",
    "རྒྱལ་བ་རྣམས་ཀྱིས་རྫོགས་ལྡན་གྱི་དུས་མཁོ་བའི་མང་པོ་རྣམས་རྩོད་དུསད་ཤིན་ཏུ་བསྡུས་ཏེ་བརྟལ་དགོངས་པར་འདུག་གོ།",
    "བདེ་གསལ་ང་རྩ་ཡིན་ཟེར་བ་ཞིག་ཀྱང་འདུག་པ།",
    "དེ་ནི་གསན་རྒྱ་ཆེ་ཡང་གཞན་གྱི་ཐུགས་སུ་ཆུད་མི་འགྱུར་ཞེས་གསུངས་པ་དེ་ཀར་འདུག་པས།",
    "དེ་ལྟར་སྔར་གྱི་གཉེན་པ་ཐམཐམས་ཅད་རྣམ་རྟོག་སྐྱེས་འདུག་པས་མ་ཡེངས་པ་བྱེད་དགོས་སྙམ་པ་ཁོན་སྟེ།",
    "མི་རྟོག་པ་ལུས་སེམས་ཡོད་དུ་མི་ཚོར་བ་བར་སྣང་སྟོང་པ་ལ་འདུག་བལྟ་བུལ་སོགསཔའི་ཉམས་ཀྱི་སྣང་བ་ཅི་ཤར་ཡང་དགའ་བ་དང་སྐྱོན་དུ་བལྟས་ནས།",
    "དང་པོ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲད་པ་ནི།",
    "སྣང་ཐོག་ཏུ་སེམས་ཀྱི་འདུག་ཚུལ་རིག།",
    "དེང་སང་མ་གོ་བ་མད་པོས་ངན་པ་སྡུག་སྡུག་ཞིག་ལ་བྲོ་གཏོད་ཀྱི་འདུག་སྟེ།",
    "གཞན་ཡང་འདི་ལ་རིག་པ་སྐད་ཅིག་མ་ཞེས་ཀྱང་ཟེར་གྱི་འདུག་པ་དེའི་གོ་དོན།",
    "ཕྱི་མའི་གནས་སྐབས་སུ་ཡང་དེ་ཉིད་ལས་གཞན་དུ་འགྱུར་བ་མི་སྲིད་པས་དེ་སྐད་དུ་བཏགས་པར་འདུག་གོ།",
    "ཞེས་གསུང་། སྣང་ཐོག་ཏུ་སེམས་ཀྱི་འདུག་ཚུལ་རིབ།",
    "སྣང་ཐོག་ཏུ་སེམས་ཀྱི་འདུག་ཚུལ་རིག་པཞེས་བྱ།",
    "ཇི་ལྟར་སྣང་བ་འདི་ཡང་རང་ག་སེམས་ལས་ལོགས་ན་མེད།",
    "རྟོག་པ་ཟེར་མཁན་སུ་ཡང་མི་འདུག་ཅིང་།",
    "འགྱུ་ཐོག་དེར་གནས་པའི་དད་སོ་ཚུགས་པ་ཞིག་འདུག་ན།",
    "སྒོམ་ཐུན་མཚམས་སུ་གཟུད་རྒྱུ་ཡངམི་གདའོ།",
    "ཞེ་སྡང་ལྟབུ་ལ་ཞེ་སྡང་གདུས་ཞེ་སྡང་རང་ངོ་ཤེས་པས་གསལ་ཆ་ཆེ།",
    "སྟོང་པའི་ངང་ལས་ཁྱེད་རང་རྣམས་གང་དུ་གནས་པའི་གོ་སར་པྃ་ཡས་པདྨའི་སྡོང་པོ་རབ་ཏུ་རྒྱས་པའི་ལྟེ་བར་ཨ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་ཉ་གང་བའི་སྟེང་དུ།",
    "ཨོ་བེ་རོ་ཙ་ན་ཨ་པ་རི་མི་ཏ་ཨ་བྷི་ཥིཉྩ་ཨོཾ།",
    "གཡོན་ལྕགས་ཀྱུ་ཞགས་པ་ལྕགས་སྒྲོལ་དྲིལ་བུ་ཐོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས་ཏེ་ཁྱེད་རང་རྣམས་ཀྱི་ཚེ་ཡར་བ་དང་། ། འཁྱམས་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ལྷའི་སྐུར་གསལ་བ་སྟོད་སྨད་ནས་རིམ་གྱིས་འོད་དུ་ཞུ་བ་ཐུགས་ཀའི་ལྷར་ཐིམ།",
    "ཁྱེད་རང་རྣམས་པདྨ་ཚེ་དཔག་མེད་ལུས་དཀྱིལ་གྱི་ལྷ་དང་བཅས་པ་གསལ་བཞིན་པའི་གནས་གསུམ་ཡིག་འབྲུ་གསུམ་གྱིས་མཚན་པ་དང་།",
    "རང་ཉིད་ཁྲུས་བྱས་ཏེ་ཆས་གོས་དཀར་པོ་གྱོན་ནས་པདྨའི་འདུག་སྟངས་ཀྱིས་ཁ་ཤར་དུ་ཕྱོགས་པར་འཁོད།",
    "རང་ཉིད་ཁ་བྱང་དུ་ཕྱོགས་པས་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་འདུག།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "ཡིན་ན་མ་འདུག་ཕྱིར་དེངས་ཤིག།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལའང་དཀྱིལ་འཁོར་དུ་འཇུག་པ་དང་།",
    "མ་འདུག་གཏོར་མ་འདི་ཁྱེར་གཞན་དུ་དེངས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ་ཐོག་མར་མཎྜལ་ཕུལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཐིམ་པས་རྒྱལ་བ་ཚེ་དཔག་ཏུ་མེད་པའི་སྐུ་གསུང་ཐུགས་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་རོ་གཅིག་ཏུ་གྱུར།",
    "ཐུགས་ཀ་ནས་འཕྲོས་པའི་འོད་ཟེར་གྱིས་སྣོད་བཅུད་ཐམས་ཅད་འོད་དུ་ཞུ་ནས་རང་རང་ལ་ཐིམ།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "དེའང་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་གྱི་ཁང་པའི་ཕྱི་རོལ་ནས་འཇུག་པ་ཡིན་ཀྱང་།",
    "དེ་ལྟར་གསོལ་བ་བཏབ་པ་ལ་དཀྱིལ་འཁོར་ཆེན་པོ་འདིར་སྐལ་མེད་རྣམས་བལྟ་བར་མི་རུང་བས་རིགས་དང་སྐལ་བ་འདྲི་བ་འདི་ལ་གསན་པས་ཁྱབ་བར་གདའ།",
    "ཡིན་ན་མ་འདུག་ཕྱིར་དེངས་ཤིག།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་གྱི་སྒོ་དྲུང་ན་གནས་པས་ཕྱོགས་ཀྱི་སྒོ་སྲུང་རྣམས་ལ་དཀྱིལ་འཁོར་དུ་འཇུག་པར་གསོལ་བ་གདབ་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་མི་བསྐྱོད་ཐུགས་རྗེ་ཆེན་པོ་དང་།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "སློབ་དཔོན་གྱི་བྱ་བ་གྲུབ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ཐོག་མར་མཎྜལ་ཕུལ།",
    "སློབ་དཔོན་གྱི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་ཧྲཱི་ཡིག་དཀར་པོ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "བདེ་བའི་སྟན་ལ་བསམ་གཏན་གྱི་འདུག་སྟངས་ཀྱིས་འདུག་སྟེ།",
