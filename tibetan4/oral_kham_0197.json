    "ནམ་ཟླའི་དུས་བཞིའི་རྩིས་ཐོབ་ལུགས་རྒྱ་ནག་པོ་ལ་གཏུགས་དགོས་པར་འདུག་པས་མཁས་པར་སློབ་ལ་ཤོག་ཅིག་བྱ་དགའ་ཆེན་པོ་བྱེད་ཅེས་བཀའ་སྒོས་ནས་རྫངས་བཏང་བས་ཁོང་བཞི་པོས་ཕྱིན་ཏེ་རྒྱ་ནག་ཏུ་སྔོན་ལ་མཁས་པ་མི་བཞི་ལ་རང་སར་གཏུགས།",
    "པ་གོར་ཧེ་འདོད་ཀྱི་བུ་བི་རོ་ཙ་ན།",
    "བེ་རོ་ཙ་ནར་གབ་རྩེ་ཉིས་བརྩེགས་བཏིང་།",
    "སྔགས་ཀྱི་རྒྱུད་ཀྱི་ནང་ནས་ཐུ་ཞིང་བོད་སྐད་དུ་བསྒྱུར་བ་དག་ཀྱང་བྱུང་ཞེས་གདའས་ཀྱི།",
    "སྔོན་གྱི་ལོ་ཙཱ་བ་སྒྲ་བསྒྱུར་བི་རོ་ཙ་ན་དང་།",
    "ནང་རང་ལྗོངས་ཀྱི་གཞུང་ཡིག་སྣ་ཚོགས་དང་།",
    "མིང་ནི་ཁྲི་སྟེང་རྨང་རི་ཟེར་རོ་སྐད་ཞེས་འཁོད་འདུག་གོ།",
    "གཞན་ཡང་ད་དུང་ལྐོག་མདའ་བརྒྱབ་སྟེ་བཀྲོངས་ཞེས་ཀྱང་གསུངས་སྲོལ་འདུག་པས་དཔྱད་པར་ཚལ་བང་སོ་མུ་ར་རི་ལ་བརྩིགས་ཤིང་མདུན་དུ་རྡོ་རིང་ཡི་གེ་ཅན་ཞིག་བཙུགས་སོ།",
    "རྔོག་བློ་ལྡན་ཤེས་རབ་ཀྱིས་བིརོ་ཙ་ན་ནམ་མཁའི་མཐའ་དང་མཉམ།",
    "གཙོ་བོ་རྟེའུ་རར་བཞུགས་ནས་སྔར་གྱི་གདན་ས་སྟོང་པ་སྐྱར་གསོ་མཛད་ཅིང་ཤུདྡྷ་ཤྲཱི་སྤྱན་དྲངས་ཏེ་རྒྱལ་བའི་ལམ་འདུག་ལ་སོགས་པ་བསྒྱུར།",
    "པ་གོར་བི་རོ་ཙ་ན།",
    "རྒྱ་གར་དུ་ལོ་བདུན་བཞུགས་པར་བཞེད་འདུག་སྐུ་མཁར་མ་རུར་དཔེ་མཚམས་བཞུགས་ནས་རྒྱ་ཡིག་ལྔ་བཅུ་ཐམ་པ་ལས་བོད་ཡིག་སུམ་ཅུ་གཏན་དུ་ཕབ་སྟེ་གངས་ཅན་བོད་ཀྱི་ཡི་གེ་གསར་བཅོས་ལེགས་པར་མཛད།",
    "ལོ་པཎ་བཀའ་ཐང་ནང་འདི་ཉིད་ལ་པཎྜིཏ་དྷརྨ་ཀོ་ག་ཞེས་འཁོད་འདུག།",
    "པ་གོར་བི་རོ་ཙ་ན་རཀྴི་ཏ།",
    "བེ་རོ་ཙ་ན།",
    "ཐོག་མར་རྒྱལ་པོ་ཁྲི་ལྡེ་སྲོང་བཙན་དུས་སུ་ལོ་ཙཱ་བ་སརྦ་ཛྙཱ་དེ་བ་དང་བོད་ཀྱི་ལོ་ཙཱ་བ་སྐ་བ་དཔལ་བརྩེགས་ཀྱིས་བོད་སྐད་དུ་བསྒྱུར་བ་ལས་སྔ་ཕྱིར་འགྱུར་བཅོས་ཐེངས་གཉིས་བྱས་པ་ཞེས་འགྲེལ་བརྗོད་མཛད་འདུག་པས་རྒྱལ་པོ་ཁྲི་ལྡེ་སྲོང་བཙན་སྐབས་ཀྱི་ལོ་ཙཱ་བ་ཞིག་ཡིན་པ་ནི་ཐེ་ཚོམ་མི་དགོས་སོ།",
    "འདིའི་མིང་ངོ་མ་ལ་བཤེས་གཉེན་རྣམ་རྒྱལ་ཟེར་ཞེས་འཁོད་འདུག།",
    "ཚོགས་མིས་ལོ་གཉིས་རིང་རང་དགར་སྒོའི་ནང་མི་ཞུགས་པའམ་ཡང་ན་ཚོགས་མིའི་ཚོགས་དངུལ་མ་ཕུལ་ཚེ་མཐུན་ཚོགས་ནས་རང་འཐེན་བྱས་པར་བརྩི་རྒྱུ།",
    "དེ་ཁོ་ན་ཉིད་གཅིག་གཏན་ལ་འབེབས་པའི་དོན་དུ་སྦྱོར་བ་གཅིག་པར་འདུག་ལ།",
    "གནས་ལུགས་ཀྱི་སྟེང་དུ་སོ་མ་ཤོར་བར་སྡོད་ཚུགས་དགོས་པ་དེར་གདའོ་།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་སྒོམ་དེ་རྐྱེན་ཐོག་ཏུ་འདུག་གམ་མི་འདུག་ལྟ་བ་གལ་ཆེའོ།",
    "རྐྱེན་ཐམས་ཅད་ཕྲ་ཚོད་སྦོམ་ཚོད་དུ་བཏང་དགོས་པ་དེར་གདའོ།",
    "ད་གཉེན་པོའི་དགོས་པ་མི་གདའོ་གསུངས་པ་ལྟར།",
    "ཅིས་ཀྱང་དགོས་པ་མེད་གསུང་པ་དེར་གདའོ་།",
    "རྟོགས་ལྡན་གྱི་རྣལ་འབྱོར་པ་ཁ་ཡན་དུ་འཕྱོ་ཆོག་པར་གདའོ།",
    "བློ་གྲོས་ཀྱི་གཉིས་ཕུང་རྩོམ་ཉེན་འདུག།",
    "སྨར་ཁམས་སྒང་སྐོར་འདིར་མི་ཆེན་མང་པོའི་འདུན་ས་བྱེད་པ་འདིའི་བག་ཆགས་སྔོན་བསུའི་ལྟས་སུ་འདུག་གསུངས།",
    "ཞིབ་འཇུག་བཅས་ཀྱི་བྱ་བ་བསྒྲུབས་དང་སྒྲུབ་བཞིན་པར་འབྲས་བུ་གཡུར་དུ་ཟ་བ་ཐོན་དང་འཐོན་བཞིན་འདུག་པས།",
    "མཉམ་འགྲོ་མཉམ་འདུག་མཉམ་སྒྲིག་བྱས།",
    "སྤྲང་པོར་སྦྱིན་པ་མ་ཆད་གདའ།",
    "ཚེ་གང་གཏན་གྲོགས་བསྒྲིགས་ནས་གདའ།",
    "འདུག་ས་རྫི་བོའི་ཕུག་པ་དང་།",
    "སྒྲུང་སྣ་འདི་སྒྲུང་མཁན་བསམ་གྲུབ་ཀྱིས་དུས་རབས་གོང་མའི་ལོ་རབས་བརྒྱད་ཅུ་པའི་ནང་སྒྲ་ཕབ་གནང་བར་འཁོཪ་གྲངས་༤ཡོད་སོ་འདུག་ཀྱང་དཔེ་ཚོགས་ལེགས་སྒྲིག་བྱེད་སྐབས་ཐོག་མའི་སྒྲ་ཕབ་སྤྱིན་ཤོག་དང་མ་ཡིག་མ་རྙེད་པས་སླར་ཡང་སྒྲ་ཕབ་བྱས་པ་དང་།",
    "ལྷོ་རྒྱལ་སྟོབས་ལྡན་གྲགས་པ་དེ་ཉིད་ང་རྒྱལ་དང་རང་ཤེད་ཆེ་བས།",
    "དུས་དེ་ཙ་ན་སྒྲུང་མཁན་གང་ཉིད་དགུང་ལོ་བརྒྱད་ཅུར་ཕེབས་པས་སྐབས་དེར་དཔར་དུ་བསྐྲུན་པའི་སྒྲུང་པོད་དེ་སྒྲ་ཕབ་གནང་བར་དུས་ཡུན་རིང་ཙམ་འགོར་ཡོད།",
    "མ་ཧེ་ནོར་གྱི་ཕྱྭ་གཡང་དབུ་ནག་འཚོ་བའི་གསོས་སུ་འདྲེན་ནས་འགྲོ་རྣམས་སྨིན་ཅིང་གྲོལ་བའི་གནས་སུ་བཀོད་པར་གདའོ།",
    "དེ་དག་ལས་མང་དག་ཅིག་དུས་རབས་གོང་མའི་ལོ་རབས་བརྒྱད་ཅུ་ནས་སྒྲ་འཇུག་ལས་ཀའི་འགོ་བརྩམས་རུང་ད་ལྟ་ཐོབ་པའི་གྲུབ་འབྲས་ནི་ཡིད་སྐྱོ་བ་ཞིག་ཡིན།"
  ]
