    "མའི་ལྟོ་ན་འདུག་པའི་ཚེའང་དྲན་པ་ཉམས་༢པ་མེད་དོ་༤།",
    "ཐམས་ཅད་མཁྱེན་གྱི་༡༢སེམས་མཆོག་ཤིང་ལ་རབ་འདུག་རྫུ་འཕྲུལ་རྐང་པའི་༐",
    "བདག་ཉིད་ཀྱང་དེ་ན་འདུག་པ་སྙམ་བྱེད་ལ།",
    "ཆོ་ག་༡༨དང་སྤྱོད་ལམ་རྣམ་པ་སྣ་ཚོགས་དང་ལྡན་ཞིང་མུན་པའི་རབ་རིབ་ཀྱིས་མྱིག་ཡོངས་སུ་འཁྲུགས་༡༢པར་གྱུར་པམྱིའི་ཁྲོད་ན་འདུག་ཅིང་ཏྲ་༦༣༦ བཀའའགྱུར།",
    "དེས་ནི་འགྲོའམ་འདུག་གམ།",
    "ལ་ལ་ན་ནི་གནོད་སྦྱིན་གྱི་༧གནས་ན་འདུག།",
    "ལ་ལ་ན་ནི་ལྷ་མ་ཡིན་གྱི་གན་ས་ན་འདུག།",
    "ལ་ལ་ན་ནི་མིའམ་ཅིའི་གནས་ན་འདུག།",
    "ལ་ལ་ན་ནི་ལྟོ་འཕྱེ་ཆེན་པོའི་གནས་ན་འདུག།",
    "རྒྱལ་པོའི་གནས་དག་དུ་ཕྱིན་པར་སྣང་ངོ་། དེ་ནས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་གནས་པ་མྱེད་པའི་ཁང་པ་བརྩེགས་པ་ན་འདུག་འདུག་པ་ལས་༐",
    "དགེ་སློང་རྒྱ་མཚོའི་སྤྲིན་གྱི་མདུན་དུ་འདུག་༐",
    "སྲིད་པའི་ལམ་གྱི་རྒྱུད་ཐམས་ཅད་དུ་གནས་པར་འདུག་༢༢པ་དང་།",
    "བཟངས་ཀྱིས་༧དགེ་སློང་ཤིན་ཏུ་བརྟན་པ་༨དེ་ལྟར་ནམ་མཁའི་དབྱིངས་ལ་འཆག་༩ཅིང་འདུག་པ་མཐོང་ནས་ད་གའ་རངས་ཏེ་མགུ་ཞིང་ཉམས་བདེ་ལ་ཚིམ་ཞིང་ཡིད་བདེ་བ་སྐྱེས་ནས།",
    "ཕྱག་བྱ་བ་ཞིག་འདུག་སྟེ།",
    "ཁྲི་བཟང་པོ་ལ་འདུག་པ་མཐོང་ནས།",
    "ཡོགས་ཅན་རྩའི་༡༢སྟན་ལ་འདུག་པ་མཐོང་ངོ།",
    "དྲང་སྲོང་འཇིགས་མཆོག་དབྱངས་ལ་ལན་བརྒྱ་སྟོང་དུ་མར་བསྐོར་༨བ་བྱས་ནས་མདུན་དུ་འདུག་སྟེ།",
    "དེས་ཡང་བདག་དྲང་སྲོང་འཇིགས་མཆོག་དབྱངས་ཀྱི་མདུན་དུ་༦འདུག་པར་ཤེས་པར་གྱུར་ཏོ།",
    "འཇིག་རྟེན་ཐམས་ཅད་ཀྱི་གཙོ་བོར་རང་རང་རློམ་ཞིང་སེམས་པ།",
    "གཞི་ཤེལ་དུ་འདུག་པའི་ས་ལས་བླངས་ཏེ། ༐",
    "མགོ་གདུགས་ལྟར་འདུག་པ།",
    "རྫི་མ་བའི་རྫི་མ་ལྟར་༨འདུག་པ།",
    "འགྲམ་པའི་ལྷ་ང་སེང་གེ་ལྟར་འདུག་པ།",
    "སྨྱིན་ཚུགས་གཞུ་ལྟར་འདུག་ཅིང་རིང་ལ།",
    "མཛོད་སྤུ་༢༢ཟླཱ་བའི་ཁ་དོག་ལྟར་འདུག་པའི་ཐིག་ལེ་ཅན།",
    "རོ་སྟོད་སེང་གེའི་རོ་༡༢སྟོད་ལྟར་འདུག་པ།",
    "རྐེད་པ་རྡོ་རྗེ་ལྟར་འདུག་པ།",
    "ཕོ་མཚན་གསང་བའི་སྦུབས་ན་༢༡འདུག་པ།",
    "བྱིན་པ་རི་དགས་༢༤ཨེ་ནེ་ཡའི་བྱིན་པ་༢༤ལྟར་འདུག་པ།",
    "མྱི་དང་མྱི་མ་ཡིན་པས་བསྐོར་ཅིང་འདུག་པ་མཐོང་ངོ།",
    "༡གཡུང་ཕི་པེ་ཅོ་འདུག་པ་ལ།",
    "༢༢སྣར་སྤྲོག་༢གཡུང་པེ་འདུག་པ།",
    "༢༤གཡུང་ཕ་པེ་ཅོ་ཁྲི་བཟང་པོ་ལ་འདུག་པ་མཐོང་ནས།",
    "ལོ་ཚིགས་མང་པོར་མཚམས་ཀྱི་བཅད་རྒྱ་ལ་འཇུག་པ་ཡང་མང་དུ་བྱུང་བས་ཞི་བའི་སྒོ་འཕར་བརྒྱ་ཕྲག་དུས་གཅིག་ཏུ་དབྱེ་བར་མཛད་པ་ཡིན་ནོ།",
    "ཞེས་གསུངས་པའི་ལུང་དོན་དུ་སླེབ་པ་ཡིན་འདུག་ཅིང་།",
    "ཞུ་དོན་འདི་དགའ་རབ་ཡོང་འདུག་ཅིང་།",
    "རང་རང་འབྱོར་དང་བསྟུན་པའི་མཆོད་སྤྲིན་གྱིས།",
    "བཀའ་ལས་ཀྱང་ད་ལམ་གྱི་གཏོར་མ་འདིས་གཟུགས་མེད་འདི་རྣམས་ཀྱི་འཕྲིན་ལས་ཡང་དག་བྱེད་པའི་རྟགས་ཡང་ཡང་སྟོན་པ་ཞིག་འདུག་གསུངས།",
    "ཁྱད་པར་ཡུལ་ཕྱོགས་དེར་ཤིན་ཏུ་དར་བ་འདུག་པས་བསྒོམ་ལུང་ཞིག་དང་།",
    "བུམ་ཐང་བཞི་ལ་ལྟ་བ་འདུག་གསུང་བ་སོགས་དངོས་སུ་ཐོས་ལ།",
    "ཁྱད་པར་པཎ་ཆེན་ནས་བརྒྱུད་པ་འདི་དེང་སང་གཞན་སུ་ལ་ཡང་བཞུགས་པ་ཞིག་མི་འདུག་པ་བཅས་བཀའ་དྲིན་བསྐྱང་དགོས་ཚུལ་གྱི་གསོལ་བ་བཏབ་པའི་ངོར།",
    "བག་ཆགས་སམ་ལུང་བསྟན་ཅི་ཡིན་ཡང་རྨི་ལམ་ཡ་མཚན་ཆེ་དགོངས་པ་འཁྲུངས་ཤིང་འདུག་པ།",
    "དེ་བཞིན་ཐུགས་འདུན་མ་དོར་བའི་སྙེལ་ཐོ་ཞིག་ཀྱང་གནང་དགོས་ཞུ་བ་མཛད་འདུག་པ་ལ།",
    "འདུན་པ་བྱས་པའི་སྟེངདུ་འགྲོ་བ་ལྐོག་འདུག་ནའང་།",
    "ད་ཚེ་འདིར་དཔེ་འདི་རྣམས་ལ་བེད་སྤྱོད་པ་ཞིག་ཡོང་བ་མི་འདུག་ནའང་།",
    "ན་ཚོད་དང་ལུས་ཟུངས་འདི་ཡང་གཞན་དུ་ཀ་འགྲོ་བ་ཞིག་འདུག་པས།",
    "ད་རང་བསྟན་པའི་བྱ་བ་དེ་ཙམ་ཡིན་འདུག་ཅིང་།",
    "ཡང་སྐབས་འགར་ན་རྒྱུ་ཆེ་བ་མི་འདུག་ནའང་བསྟན་པའི་བྱ་བ་མི་ཐུབ་པའི་ལུས་རྟེན་འདི་རྗེས་པ་ལེགས་པ་འདུག་གསུང་བ་སོགས་དག་ཞིང་གཞན་དུ་ཕེབས་སྤྲོ་བའི་བཀའ་སྩལ་ཁོ་ན་གནང་བ་བྱུང་།",
    "དེ་རྣམས་ཀྱི་བཞུགས་གདན་ཡིན་འདུག་ལབ།",
    "ཁྱེད་རང་རྣམས་ཀྱང་འདི་ཁར་འདུག་ལ་ལྷོད་ཙམ་གྱིས་གསུངས་པའི་མུ་ནས།",
    "བདག་སོགས་སྐྱེ་བ་དང་ཚེ་རབས་ཐམས་ཅད་དུ་རྗེས་སུ་འཛིན་པ་ཅིས་ཀྱང་བཀའ་དྲིན་ཆེ་དགོས་ཞུ་བར་མཛད་འདུག་པ་ལ་ཁྱེད་རྣམས་ནམ་ཡང་བརྗེད་མི་ཡོང་གསུང་བ་སོགས་རྗེས་སུ་འཛིན་པའི་བཀའ་སྩལ་ལྷུག་པར་ཕེབས།",
    "དགོངས་གཏད་ཀྱང་ཞིང་ཁམས་གཞན་དུ་སྣང་བ་རང་ཞིག་འདུག་པས།",
    "མཆོད་དཔོན་ལགས་སོགས་བདགསྐུ་འཁོར་ན་ཡོད་པ་རྣམས་ཀྱིས་ཀྱང་དེང་སང་སྐུ་ཡང་ཟོར་ཡང་ཆེ་བ་འདུག་ལགས་ཅིང་།",
    "ད་ལུས་རྟེན་འདིས་བསྟན་པའི་བྱ་བ་ཐུབ་པ་ཞིག་མི་ཡོང་བ་འདུག་པས།",
    "བསྟན་པའི་བྱ་བ་མི་ཐུབ་པའི་ལུས་རྟེན་འཕོས་པ་རང་ལེགས་པ་འདུག་གསུང་བ་དང་།",
    "ཀ་བ་འདིའི་མདུན་དུ་བཙུན་མ་གཅིག་སྔ་གོང་ནས་ད་ལྟའི་བར་དུ་ཡང་ཡང་ཡོང་བ་ཞིག་འདུག་མཁའ་སྤྱོད་མ་ཡིན་པ་འདྲ།",
    "སྐྱེས་ཆེན་རྣམས་ཀྱི་བཀའ་སྩལ་སྤྱི་བོར་ནོད་དེ་རྗེ་བཙུན་ཉིད་ཀྱི་བཀའ་འབངས་ཀྱི་མཐའ་ཆུང་ཁོ་ནར་གྱུར་ཀྱང་རང་ལོ་ཉི་ཤུ་ནས་སུམ་ཅུའི་བར་དུ་སྐུའི་སྲིད་ཞུ་དང་ཞབས་འབྲིང་བགྱིས་པའི་སྐལ་བ་བཟང་པོ་ཐོབ་ཅིང་།",
    "རང་རང་ལུགས་ནི་ཇི་ལྟར་བསྒྲུབ།",
    "རང་རང་ལས་རྣམས་གང་ལ་དགའ།",
    "བརྒྱལ་བ་སངས་པ་ན་སུ་ཡང་མི་འདུག་པས།",
    "སྐྱེས་བུ་དམ་པ་གཉིས་པོ་འགྲོ་བའི་ལམ་དུ་འདུག་ནས།",
    "བེ་རོ་ཙ་ན་སོགས་པཎྜི་ཏ་དང་།",
    "འདུག་གམ་གསུངས།",
    "ཡང་པཎ་ཆེན་དེ་ལ་རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀྱི་སྤྲུལ་པ་ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ནས་རྫོགས་པ་ཆེན་པོའི་། གདམས་པ་ཡོངས་སུ་ཚང་བར་གསན་ནས་བོད་ཡུལ་འདིར་དར་རྒྱས་སུ་མཛད་པ་ཡིན་ཏེ།",
    "པཱ་ཀོར་ཧེ་འདོད་ཀྱི་བུ་བེ་རོ་ཙ་ན་བྱ་བ་མཁྱེན་པ་ཡངས་ཤིང་རྫུ་འཕྲུལ་ཆེ་བ་དེ་དང་།",
    "འདི་རང་ན་། ཡང་རང་དགར་སྤྱད་དུ་མེད།",
    "བེ་རོ་ཙ་ནས་སླར་ཡང་ནན་གྱིས་ཞུས་པས།",
    "དེ་ནས་ཤྲཱི་སིདྷས་བེ་རོ་ཙ་ན་ལ།",
    "དེའི་རྗེས་ཁྲི་སྲོང་ལྡེའུ་བཙན་གྱི་སྐབས་བེ་རོ་ཙ་ནས།",
    "དེ་བཞིན་དུ་བེ་རོ་ཙ་ན་དང་ཤྲཱི་སིངྷ་དུས་མི་མཚུངས་སྙམ་པའི་དོགས་པ་ཡང་མི་བྱ་སྟེ།",
    "གཞན་དུ་དེ་ཙམ་མི་ཡོང་འདུག་པ་དགོད་བྲོ།",
    "སོ་དྲུག་པ་ལ་གོང་མ་རྒྱལ་པོས་ཁྱེད་འཕགས་པ་ཏྲི་ཤྲཱི་དབོན་པོ་ཡིན་ངེས་སུ་འདུག་པས་གདུང་རྒྱུད་སྤེལ་ལ་ས་སྐྱར་གདན་ས་གྱིས་གསུངས་པའི་འཇའ་ས་སྩལ།",
    "བར་སྐབས་ཤིག་ཏུ་རྩེ་གདོང་དུ་བསྟི་གནས་ཀྱི་མཐིལ་མཛད་པས་རྩེ་གདོང་བླ་བྲང་པར་གྲགས་པ་ཡང་བྱུང་འདུག་ཀྱང་།",
    "དཔལ་ཊྛཾམགོན་ཞལ་གྱི་ཆོ་འཕྲུལ་ཞིག་ཡིན་འདུག་པས་བསྐང་གསོ་གྱིས་གསུངས་བྱུང་འདུག་ཀྱང་།",
    "རྒྱལ་ཡུམ་དམ་པ་དེ་ཉིད་འཕྲལ་དུ་ཐུགས་བཀྲ་ཉམས་ཡོད་པ་ཞིག་ཡིན་འདུག་པས།",
    "ཡབ་རྗེ་ཉིད་ལ་སོགས་པ་སྐལ་ལྡན་གྱི་སློབ་ཚོགས་མང་པོ་འདུས་ནས་འདུག་པ་ལ།",
    "ཉེ་སྐོར་ན་སྐས་ཤིག་འདུག་པ་དེ་ལ་འཛེགས་ནས་ཕེབས་བཞེད་པ་ན།",
    "ཡ་མཚན་ཆེ་བར་དགོངས་པས་རྗེ་འདི་ལ་བསྟོད་བསྔགས་མཛད་པ་ཡང་བྱུང་འདུག་ཅིང་།",
    "ཁྱེད་རང་ངེད་ཀྱི་ཕྱི་ལ་ཕྱིན།",
    "ད་ལམ་ཁྱེད་རང་ཡབ་སྲས་ལྷན་ཅིག་ཏུ་གདན་སར་བྱོན།",
    "ཞེས་གསུངས་པ་སོགས་མ་འོངས་པ་མཁྱེན་པའི་ལུང་བསྟན་སྒྲིབ་མེད་དུ་སྩལ་བར་འདུག་ཀྱང་དེ་དུས་ནི་ཀུན་གྱི་སྲོལ་དུ་སྣང་བ་བཞིན།",
    "གདན་སར་ཕེབས་དགོས་ཤར་ཀྱང་ཐག་རིང་མི་འདུག་པས་ཕར་བྱོན་ཚུར་བྱོན་མཛད་པས་འཐུས་པ་འདུག་པ།",
    "བདག་ཚེ་ཧ་ཅང་མི་རིང་བ་ཞིག་བྱུང་ན་ཐོས་བསམ་རྒྱ་ཆེར་བྱས་པ་ལ་དོན་མི་འདུག་པས།",
    "སེམས་ལ་ཕན་པའི་བསླབ་སྟོན་ཞིག་གནང་དགོས་ཞུ་བ་མཛད་འདུག་པར།",
    "སྐུ་ཆ་བཏབ་པས་སྐུ་ཚེ་རིང་པོ་ཡོང་བ་གདའ།",
    "ཐུགས་སྦྱོང་གནང་གོང་མི་གཡོ་བ་དཀར་པོའི་བསྙེན་པ་ཞིག་མཛད་ན་ལེགས་པ་གདའ་ལགས།",
    "ཅེས་གསུངས་པ་། སོགས་མང་དག་གདའ་ནའང་ཡི་གེ་མང་དོགས་མ་བྲིས་ལགས།",
    "མི་གཡོ་བ་དཀར་པོའི་རྗེས་གནང་སོགས་གནང་འདུག་པ་དང་མཚུངས་པར།",
    "ལྷག་པར་བཀའ་དྲིན་ཅན་གྱི་ཡུམ་དེ་གང་དུ་འཁྲུངས་ཡོད་རྣམས་ལ་ལུང་བསྟན་གསལ་བ་ཞིག་དགོས་ཚུལ་ཞུ་བ་གནང་འདུག་པའི་ལན་དུ།"
  ]
}