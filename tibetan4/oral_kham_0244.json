    "སྐར་མ་ཕུར་བུས་ཕྱི་ཕྱོགས་སུ་ཁྱབ་འགྱེད་བྱེད་ཀྱིན་འདུག་ཟེར།",
    "ཐིག་དམར་གྱི་མཚམས་ད་དུང་ཕྱི་རུ་འབུར་ཡོད་པ་དང་སྣེ་གཉིས་ནང་དུ་བརྡིབས་འདུག་འདི་ནི་སྐར་མ་ཕུར་བུའི་རང་འཁོར་གྱི་ཚད་ཧ་ཅང་མགྱོགས་པ་ལས་གྲུབ་པ་ཡིན་པས་དེ་ལ་ངོ་མཚར་མ་སྐྱེས།",
    "ཉི་མ་དང་བར་ཐག་སྤྱི་ལེ་དུང་ཕྱུར་བཅུ་བཞི་དང་ཉིས་སྟོང་ལྔ་བརྒྱ་ཡོད་པའི་འཁོར་ལམ་སྟེང་དུ་ཉི་མར་སྐོར་བརྒྱབ་ནས་འཕུར་གྱིན་འདུག་སྟོབས་ལྡན་གྱིས་རྟོག་ཞིབ་བྱེད་ཞོར་དུ་ཨ་ལ་ལ།",
    "སྐར་མ་སྤེན་པའི་ཕྱི་ངོས་བརྒྱུད་ནས་འཕུར་གྱིན་འདུག་སྐར་མ་སྤེན་པ་ནི་གྲང་ངར་ཤིན་ཏུ་ཆེ་བའི་འཇིག་རྟེན་ཞིག་ཡིན་ཏེ།",
    "རྣམ་པར་བཀྲ་བའི་སྤྲིན་རིམ་ལ་འགྱུར་ལྡོག་ཆེན་པོ་བྱུང་འདུགངས་མདུན་ཕྱོགས་ཀྱི་སྐར་མ་སྤེན་པར་བལྟས་ནས་བསམ་བློ་མང་བོ་བཏང་།",
    "གྲང་ངར་ཆེ་བའི་སྐར་མ་འདི་སྐྱེ་སྟོབས་མེད་པའི་འཇིག་རྟེན་ཞིག་ཡིན་པར་སེམས་ཙ་ན་ཧ་ཅང་ཡིད་སྐྱོ་ནས།",
    "བལྟས་མ་ཐག་སྐར་མ་འདི་བརྟན་སྐར་ཞིག་ཡིན་པ་འདྲ་ཡང་འོད་འཕྲོ་བཞིན་མི་འདུག་པས།",
    "རྒྱུ་སྐར་ཆེན་པོ་འདི་ལའང་དུས་ཚིགས་བཞིའི་འགྱུར་ལྡོག་འདུག་ཅེས་བཤད།",
    "དེ་གཏན་ནས་འགུལ་གྱིན་མི་འདུག་ཅེས་བཤད།",
    "སྐར་མ་གཅིག་ལ་སྤྱི་ལེ་ཉེར་དྲུག་འཕུར་གྱིན་འདུག་གསེར་གླང་སྐར་ཚོམ་གྱི་པེ་སའོ་སྐར་ལྔ་ནི་དེ་ལས་ཀྱང་མགྱོགས།",
    "ང་རང་ཉི་མའི་ཁྱིམ་རྒྱུད་ཀྱི་ཕོ་ཉ་ཞིག་བྱེད་འདོད་ལ།",
    "དེ་དེའི་རིགས་ཡིན་པར་འདུག་སྟེ།",
    "དེ་དང་འདྲ་པོ་རང་ཞིག་འདུག་པས་ཟེར་བས།",
    "སྣང་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དང་རང་བཞིན་གྱི་སྣང་བ་དང་ལས་ཀྱི་ལམ་རྣམ་པར་གཞག་པ་གཉིས་ནི་རྗེས་སུ་མྱོང་བའི་མཚན་ཉིད་དམ།",
    "ཞེས་སྨྲ་བའང་རང་ཉིད་ཀྱི་ནང་སྟོན་པར་ཟད་ལ།",
    "དབུགས་དབྱུང་རང་དགའ་ལྕེ་དང་ནི།",
    "དེ་ལྟ་བུའི་ཡུད་ཙམ་གཉིས་ལས་ཐུན་ཕྱེད་པ་བཅུ་དྲུག་དུས་སྦྱོར་བཅུ་གཉིས་ཐུན་བརྒྱད་ཐུན་བཞི།",
    "དྭངས་མ་ལུས་ཟུངས་རང་རང་མེ་དྲོད་ཀྱི།",
    "དང་པོའི་ཉིན་ཞག་དུས་བརྩིས་ནས།",
    "རྟག་ཏུ་འབྱུང་ཞིང་རང་ལ་གནས།",
    "སླར་ཡང་རང་གནས་གདན་ས་ཆེན་པོར་ཞབས་པད་བཀོད་དེ་བསྟན་འགྲོའི་དོན་ཇི་ལྟར་མཛད་པ།",
    "བཀད་ས་འདུག་སའམ་གཡོས་ཁང་དང་།",
    "ལྷས་མ་གྲུ་བཞིར་འདུག་པ་ཡང་།",
    "ང་རང་བཞིན་བཟང་བ་རྣམས་ལ་འཇུག།",
    "ཐེ་ཚོམ་མེད་དེ་བས་འཕུལ་དའོ། ། མདུན་ཁང་འདུག་ས་མདུང་དོར་ནི།",
    "ཕྲག་དབྱུང་རང་འགག་ཕྱད་ཀྱིས་འགྲོ།",
    "བློ་ནི་ཁམས་དང་རང་བཞིན་ཏེ།",
    "བཅུ་ཐམ་པ་སྨད་ཀྱང་རང་ལ་མི་གནོད་པས་ཞེ་སྡང་མི་དགོས་ལ།",
    "གུས་ཤིང་བསྟོད་པར་བྱས་པས་དགའ་བ་འདུག་གམ་བལྟ།",
    "སྤྲིན་མཁའ་དབྱིངས་ནས་སྐྱེ་ཞིང་དེའི་ངང་དུ་རང་ཐིམ་སོགས་སྣ་ཚོགས་པར་འདུག་ཀྱང་།",
    "གནས་གྲོགས་ཟས་གོས་སོགས་མི་གཙང་བ་སྤངས་ཤིང་རང་དང་ཡོ་བྱད་རྣམས་ལ་གྲིབ་སེལ་གཙང་སྦྲ་བྱས་ནས་བྱང་སེམས་མ་བསྟན་པའི་བང་མཛོདཉམས་པར་བསྲུང་།",
    "དེ་ནས་ཨལ་སོགས་དང་རང་ལུས་ནང་བཅུད་ཕྱི་སྣོད་རྣམས་སྙན་བརྒྱུད་གསལ་བ་ཐུན་མཚམས་ཀྱི་རྣལ་འབྱོར་རོ།",
    "ཡང་རང་ལྷར་གསལ་བ་དང་བཅས།",
    "བཟང་ངན་སྒྱུ་མ་ཅིར་སྣང་རང་གྲོལ་འགྱུར།",
    "རྨི་ལམ་བཟང་ངན་ཇི་ལྟར་རྨིས་རུང་སྒྱུ་མའི་དཔེ་བཅུ་གཉིས་ལྟར་བཅིང་གྲོལ་སོགས་ཀྱིས་མ་གོས་པར་སྣང་བ་ཅི་དང་ཅི་ཤར་ཡང་རང་སེམས་ཀྱི་རྣམ་འཕྲུལ་གདོད་མ་ནས་སྐྱེ་འགྲེལ་བའགག་གནས་གསུམ་དང་བྲལ་བ་ཕྱག་རྒྱ་ཆེན་པོ་རང་ཤར་རང་གྲོལ་གྱི་ལྟ་བའི་ཐོག་ནས།",
    "གཉིད་འགྲོ་དུས་ས་ཆུ་ལ་ཐིམ་པས་ལུས་ལྕི་ཞི་པ་ཡོར་ཡོང་ཞིང་རང་ཚུགས་མི་ཐུབ།",
    "སྐྱིལ་ཀྲུང་དུ་འདུག་ཚེ་རྩ་སྣ་རིང་བས་བྷ་གའི་ཕྱིར་མངོན་ལ་རྩའི་མར་སྣ་འབྱེད་འཛུམ་བྱེད་པའི་བྱང་སེམས་དཀར་པོའང་།",
    "ཐབས་ཤེས་སོ་སོར་འདུག་ལ།",
    "བདེ་བའི་སྟན་ལ་འདུག་སྟེ་ཡབ་ཡུམ་ལྷའི་ང་རྒྱལ་དང་ལྡན་པས་མཁའ་གསང་བྱིན་གྱིས། རླབས་ནས།",
    "དབྱིབས་དང་ཁ་དོག་ཇི་ལྟ་བུར་འདུག་པ།",
    "དེ་ནས་སེམས་ཀྱི་ངོ་བོ་མ་མཐོང་མཚང་མ་རིག་པས་སྟོང་པར་འདུག་སྙམ་པ་བྱུང་ན།",
    "མཉམ་པར་བཞག་ཚེ་འགྱུ་མཁན་དེ་གང་ན་འདུག་པ་བལྟ་ཞིང་།",
    "ལས་ཉོན་གྱི་ཚེ་ཉེར་དྲུག་གཉེན་པོ་གར་འདུག་སོགས་བལྟ།",
    "གཙོ་བོ་སེམས་ཀྱི་ཚེ་འཁོར་སེམས་བྱུང་གང་དུ་འདུག་དང་།",
    "གོང་ལྟར་སྐྱེ་འགག་གནས་གསུམ་དབྱིབས་ཁ་དོག་སོགས་ཇི་ལྟར་འདུག་སྒོ་གསུམ་སྙན་བརྒྱུད་ཡེངས་མེད་ཀྱིས་བལྟ་ཞིང་བཙལ་བར་བྱ།",
    "ཅིར་སྣང་གཞི་མེད་རང་བྱུང་རང་དག་ལྟོས།",
    "བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "ཡིན་མིན་སྒྲོ་འདོགས་ཆོད་ཙ་ན།",
    "ཉེ་འབྲེལ་སོགས་དང་ལྷན་ཅིག་འདུག་ནས་གཏམ་བརྗོད་ཀྱང་ཚུར་ལན་མི་འོངས།",
    "དེ་ཡང་རང་སེམས་ཀྱི་གསལ་སྣང་དང་འཆར་སྒོ་ཙམ་དུ་ཤེས་པར་བྱ་ཞིང་།",
    "འདི་ཚོ་བས་ང་རང་ལྷག་སྙམ་སྙན་བརྒྱུད་པ་དང་།",
    "མེའི་དབུས་ན་ཡབ་ཡུམ་གཉིས་གར་སྟབས་མཛད་ཅིང་ཟིལ་པ་ཁྲོམ་མེར་འདུག་པས་རྒྱལ་པོ་འགྱོད་དེ་སླར་བཟོད་པར་གསོལ་བས་རྗེས་སུ་བཟུང་སྟེ་ཐེག་ཆེན་དུ་གྲོལ་བར་གྱུར།",
