    "བྱ་རོག་གཅིག་ཀྱང་ཤིང་ཨེ་རན་དའི་ཁ་ན་ཚང་བཅས་ཏེ་འདུག་གོ།",
    "ངོ་ཚ་མེད་པ་འདུག་ནས་སུ།",
    "བློན་པོའི་མཆོག་ནི་ཕྱུགས་འདུག་ཅེས་བྱ་སྟེ།",
    "དེ་སེར་སྐྱའི་འབྲོག་ན་ཕན་ཚུན་འཁྱམ་པར་བརྩམས་པ་ན་གནོད་སྦྱིན་སེར་སྐྱ་ཡང་ཕྱོགས་ཤིག་ན་ཁྱི་རྣམས་ཀྱིས་ཡོངས་སུ་བསྐོར་ཏེ་འདུག་གོ།",
    "ཇི་སྲིད་འཚོ་བ་དེ་སྲིད་དུ་འདུག་གོ།",
    "གནོད་སྦྱིན་སེར་སྐྱ་པུས་སྐྱུད་ཀྱིས་བཅིངས་ཏེ་སྒྲིམ་པས་འདུག་ནས་དེ་ཡུར་བ་ན་དེས་དེའི་སྟེང་དུ་གོས་ཤིག་བོར་རོ།",
    "བྱ་སྣ་ཚོགས་སྐད་འབྱིན་པ་ཞིག་ཡོད་དེ་དེ་རིམ་གྱིས་ཐོས་པ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་དེ་དེའི་དྲུང་དུ་འོངས་ནས་གཉེན་དུ་འབྲེལ་བས་སྨྲས་ཏེ་འདུག་གོ།",
    "དེ་ནས་རང་ཉིད་ཀྱིས་ཅོད་པན་བཅིངས་ཏེ་བློན་པོ་ཕྱུགས་འདུག་ལ་གོ་བར་བྱས་ནས་རྒྱལ་སྲིད་ལ་འདུག་གོ།",
    "དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "གཅིག་པུ་ཞིག་རྙིས་ཟིན་པ་དེ་ཉིད་ལ་མྱ་ངན་བྱེད་ཅིང་འདུག་པ་དེ་བྱ་པ་རྣམས་ཀྱིས་མཐོང་ནས་མཆོག་ཏུ་ངོ་མཚར་སྐྱེས་ཞིང་རྒྱལ་པོས་སྐྲག་ནས་མ་བཟུང་མ་བསད་དེ།",
    "རི་འོར་དེ་ན་ཤིང་ཀིམ་པ་ཀ་ཞེས་བྱ་བ་འབྲས་བུས་ཡལ་ག་གཡུར་ཟ་བར་འདུག་ནས་སྤྲེའུ་རྣམས་ཀྱིས་ཚོགས་ཀྱི་དཔོན་པོ་ལ་སྨྲས་པ།",
    "བར་མ་དག་ཡོད་པས་གཞན་ཞིག་ལྷ་སྦྱིན་ལ་སྦྲན་ནས་དེ་སྐྲག་ནས་ཤིང་དྲུང་ཞིག་ཏུ་བརྟེན་ཏེ་སྤྱོད་ལམ་ཞི་བས་འདུག་གོ།",
    "དེ་རྣམས་ཀྱིས་རྒྱང་རིང་བོར་འདུག་ནས་སྨྲས་པ།",
    "གལ་ཏེ་ཁྱེད་ཅག་འདོད་ན་འདི་ཉིད་དུ་འཐེན་ཏེ་འདུག་པར་བྱའོ།",
    "ཇི་ཙམ་ན་ཚོང་པ་རྣམས་ཀྱིས་གླང་རྣམས་གཏད་པར་བརྩམས་པ་ན་གླང་དེ་རྣམས་ཕྱི་ལང་བྱེད་ཅིང་འདུག་པ་དང་།",
    "ཚེ་དང་ལྡན་པ་སྒྲ་ཅན་ཟིན་སྒོ་ན་འདུག་པ་དེས་དེ་དག་ལྷ་སྦྱིན་གྱི་རྗེས་བཞིན་རྗེས་བཞིན་དུ་འབྲང་བ་མཐོང་ནས་དེས་སྨྲས་པ།",
    "དེའི་ཚེ་ཚེ་དང་ལྡན་པ་སྒྲ་ཅན་ཟིན་སྒོ་ན་འདུག་གོ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་ནི་གཡས་ཕྱོགས་སུ་འདུག་གོ།",
    "སྣམ་སྦྱར་བལྟབ་སྟེ་སྔས་སུ་བཅུག་ནས་གློ་གཡས་པ་ཕབ་སྟེ་གཉིད་ལོག་པ་ལས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་ཇི་ལྟར་ལུས་གན་རྐྱལ་གྱིས་སྡུར་བའི་སྒྲ་འབྱིན་ཅིང་འདུག་པ་དེ་ལྟ་བུར་བྱིན་གྱིས་བརླབས་སོ།",
    "འདུག་པ་དང་།",
    "འོན་ཀྱང་དེ་འབྱེད་བཞིན་ཏེ་འདུག་ཏུ་མ་བཏུབ་ནས་དྲང་སྲོང་དེ་ཡིད་མི་བདེ་ཞིང་ཐབས་ཅིག་སེམས་ཤིང་གནས་སོ།",
    "བདག་ཅག་ལས་སུ་ཡུན་རིང་དུ་ནུབ་པར་འདུག་པར་བལྟའོ་བླུན་པོའི་ཕུང་པོ་ཅན་དེ་དེ་དང་ལྷན་ཅིག་ཆུ་ནང་དུ་ནུབ་པར་འདུག་པ་ན་དེ་ལངས་ཏེ་གླང་པོ་ཆེའི་ཕྲུ་གུ་དང་ལྷན་ཅིག་བྲོས་སོ།",
    "གླང་པོ་ཆེ་རིང་ཞིག་འདུག་ནས་ལངས་ན་མི་སྣང་ནས་དེས་བསམས་པ།",
    "དེ་སླར་ཡང་ནུབ་པར་བྱས་ནས་མཆེ་བ་ས་ལ་བཙུགས་ཏེ་འདུག་གོ།",
    "རྐུན་པོ་རྣམས་ཤིང་ལྗོན་པ་ཞིག་ལ་འཛེགས་ནས་ཕྱོགས་སུ་ལྟ་བར་བྱེད་ཅིང་འདུག་པ་དང་།",
    "དེའི་ཚེ་འཚོ་བྱེད་གཞོན་ནུས་བསྐྱེད་འཁོར་དེ་ཉིད་ཀྱི་ནང་ན་འདུས་ཤིང་འདུག་པར་གྱུར་ཏོ།",
    "འདི་ལྟར་འཁོར་གྱི་ཁྱིམ་ན་འབྲུ་མར་གྱི་ཞུགས་མར་གྱི་འོད་གདའོ།",
    "དེ་ནས་ལུས་འཕགས་མའི་བུ་མ་ག་དྷཱའི་རྒྱལ་པོ་མ་སྐྱེས་དགྲས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ལུས་འཕགས་མའི་བུ་མ་ག་དྷཱའི་རྒྱལ་པོ་མ་སྐྱེས་དགྲས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ལམ་འགོག་ཅིང་འདུག་པ་དང་།",
    "འདུག་པ་དང་།",
    "འདུག་པ་དང་།",
    "རྣམ་པར་དང་བ་ཞིག་ཡོད་པ་དེར་སྐྱེས་བུ་མིག་དང་ལྡན་པ་ཞིག་འགྲམ་དུ་འདུག་ནས་གསེག་མའམ།",
    "ལག་པ་འགྲམ་པ་ལ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "ལྷ་སྦྱིན་ཅིའི་ཕྱིར་ལག་པ་ལ་འགྲམ་པ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག།",
    "བདག་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་མི་འདུག།",
    "འདམ་གྱི་ནང་དུ་བྱིང་ནས་འདུག་གོ།",
    "ང་རང་ལ་ཆ་བཞག་ན་ཁུངས་དགེ་ལུགས་པ་ཡིན་ཀྱང་།",
    "དེའི་སྲོག་གཏད་ཞུས་པ་ཡིན་ཞེས་བརྗོད་ཀྱི་འདུག་སྲོག་གཏད་ཚད་ལྡན་ཞིག་ཡིན་ན་དྲེགས་པ་དེའི་སྲོག་རྣལ་འབྱོར་པ་ལ་ཚུར་གཏད་ནས་རྣལ་འབྱོར་པས་དེ་དག་བྲན་དུ་བཀོལ་གྱི་ཡོད།",
    "སྲོག་ཕར་གཏད་པ་ལས་སྲོག་ཚུར་བསྡུ་ཐུབ་ཀྱི་མི་འདུག་དེ་ནི་ག་ཕྱི་ལོག་པ་དང་བསྟན་པའི་ཞབས་འདྲེན་ཡིན།",
    "འདི་སྐོར་གནས་ཚུལ་འགའ་ཤས་ཞུ་རྒྱུ་ཡོད་ཀྱང་དེ་རིང་ཞུ་དགོས་པ་མི་འདུགཅེས་བཀའ་སྩལ།",
    "དེ་ལྟར་བྱེད་དགོས་དོན་ཡང་མི་འདུག་རྩ་བ་གཞི་ལུས་རྒྱ་ཆེའི་མི་མང་དང་།",
    "དེ་བཞིན་བོད་ནང་དུའང་མང་ཆེ་བས་སྤང་བླང་འཕྱུག་མེད་གནང་སྟེ་ཧ་ཅང་ཡག་པོ་འདུག་དེས་ན་ངོས་ནས་རྟག་ཏུ་བརྗོད་དགོས་དོན་མེད་སྟབས་ངོས་ནས་བརྗོད་ཀྱི་མེད།",
    "དེའི་ནང་དུ་དྲེགས་པའི་མིང་ལའང་དོལ་རྒྱལ་ཞེས་བཀོད་འདུག་ལྷ་ས་ཞོལ་པར་མའི་ནང་དོལ་རྒྱལ་ཞེས་འཁོད་པ་དང་།",
    "བོད་པའི་གྲྭ་རིགས་དེ་ཕྱོགས་སུ་ཡོང་ནས་གྲྭ་རྒྱུན་འགྲོ་ས་ཡག་པོ་ཡོད་ཅེས་བརྗོད་ཀྱི་འདུག་ན།",
    "སྐད་ཆ་འདི་བསྐྱར་ཟློས་ཆགས་ཀྱི་འདུག་ཀྱང་།",
    "ཁོང་རང་སྐད་ཡག་པོ་ཡོད་ཀྱང་རྗེས་སུ་གཤིས་ཀ་སློག་མཁན་ཆགས་ཏེ་ལྡི་ལིར་ཡོད་པའི་དགེ་ལུགས་ཚོགས་པ་ནས་ཡིན་ཞེས་འཁོད་པའི་ང་ལ་ཡི་གེ་ཞིག་ཏུ།",
    "པར་དཀར་རྐྱང་ཞིག་འདུག་པས་ཐེ་ཚོམ་ཏོག་ཙམ་བྱུང་།",
    "འོན་ཀྱང་ལྡི་ལིར་ཡོད་པའི་དགེ་ལུགས་པའི་ཚོགས་ཁག་པ་ནས་ཡིན་ཞེས་ངོས་ལ་སློབ་དཔོན་གྱི་སྐུ་བཞེངས་ན་འགྲིགས་ཀྱི་མི་འདུག་ཅེས་བརྗོད་སྐབས།",
    "ང་རང་ཏོག་ཙམ་བློ་ཕམ་བྱུང་།",
    "ཆུང་ལ་ཁྱེད་རང་ལ་ངོས་ནས་ཁ་ཁར་སྡོད་ཅེས་བརྗོད་པ་ཡིན།",
