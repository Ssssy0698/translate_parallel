    "ལ་ལར་སྟོང་དང་ཁྲི་ཡི་ཁྱད་པར་ཡོད་པས་ཁྱོད་ཀྱིས་དངོས་རྫས་དེ་རྣམས་མཉམ་དུ་བཞག་སྟེ་འདྲ་མཉམ་གྱིས་བལྟས་ན་གནམ་འོག་ཟིང་ཟིང་བཟོས་པ་ཁོ་ནའོ།",
    "ལར་བདག་གིས་ཐུག་འཕྲད་བྱེད་འདོད་ཡོད་མོད།",
    "ཁོས་དེ་ཁོ་ན་བཟུང་བ་རེད་དོ།",
    "ཕུང་པོ་དུར་སྦས་བྱེད་འདུག་པ་ནི་འགྲིག་སྟེ་སྲི་ཞུ་མཁན་དང་བྱམས་ལྡན་གྱིས་ཁོ་ཚོའི་འདས་པའི་ཕ་མ་ལ་དེ་ལྟར་བྱེད་འདུག་པས་ངེས་པར་དུ་དེ་ལ་གནས་ལུགས་ཡོད་ངེས་རེད་ཅེས་སོ།",
    "བདག་གིས་བཀའ་སློབ་ཞུས་སོང་ཞེས་སོ།",
    "དཔའ་བོ་ཡིས་མགོ་བོ་ཚད་པར་མི་འཛེམས་སོ་ཞེས་བསྟོད་བསྔགས་བྱེད་པ་དེ་གང་ལ་བསྔགས་བརྗོད་བྱས་པ་རེད་ཅེ་ན།",
    "གལ་ཏེ་བདག་གིས་རྒྱལ་ཕྲན་གྱིས་མ་དྲངས་ཀྱང་རང་འདོད་ཀྱིས་མཇལ་བར་འགྲོ་ན་དེ་ཅི་ཞིག་རེད་དམ།",
    "ཀ་ཚ་ཎྞཾ་ཙྩཾ་༧ སྔ་དུས་སུ་ཀྲའོ་ཅན་ཙིཞེས་པའི་ཝང་ལིའང་ཞེས་པ་མངགས་ཏེ་རང་གི་གཅེས་བློན་ཞི་ལ་ཤིང་རྟའི་ཁ་ལོ་བ་བྱས་ཏེ་རི་དྭགས་རྔོན་དུ་སོང་།",
    "དེ་ནི་གནམ་འོག་གི་ཆེས་ངན་པའི་ཁ་ལོ་བ་ཞིག་རེད་ཅེས་སོ།",
    "འོ་ན་ཁྱོད་ཁོ་ན་ལ་ཤིང་རྟ་བསྐོར་བར་བསྐོས་སོ།",
    "རྗེས་སུ་གཏམ་དེ་ཝང་ལིའང་གིས་ཐོས་རྗེས་ཝང་ལིའང་ཡིད་འཐད་མ་བྱུང་བར་སྨྲས་པ།",
    "དེ་བས་ཁྱོད་ལ་ནོར་འཆུགས་བྱུང་བ་ནི།",
    "ཀུང་སུན་ཡན་དང་ཀྲང་དབྱི་ནི་ངོ་མའི་སྐྱེས་ཆེན་ཞིག་མ་རེད་དམ།",
    "ཁྱོ་གའི་ཁྱིམ་དུ་སླེབས་ཚེ་ངེས་པར་དུ་གུས་བཀུར་དང་ངེས་པར་དུ་གཟབ་གཟབ་བྱེད་དགོས་ལ་ཁྱོ་ག་ལ་རྒྱབ་འགལ་མི་རུང་བ་བཅས་གདམས་སོ།",
    "སྡོད་ས་ནི་གནམ་འོག་གི་ཆེས་རྒྱ་ཆེ་བའི་སྡོད་གནས་དང་ལངས་ས་ནི་གནམ་འོག་གི་ཆེས་ཡང་དག་པའི་གནས་ཡུལ།",
    "འགྲོ་ས་ནི་གནམ་འོག་གི་ཆེས་ཡངས་པའི་བགྲོད་ལམ་མོ།",
    "ཙྪཱཙྪཱ་མེང་ཙིན་རེ།",
    "ཟླ་བ་གསུམ་ལ་བསྐོ་སྤྱོད་མ་བྱས་ཚེ་དེ་ལ་འཚམས་འདྲི་བྱེད་པ་ནི་བྲེལ་ཟིང་ཧ་ཅང་ཆེ་སོང་བ་མ་རེད་དམ།",
    "བུ་མོ་ཞིག་བཙས་པ་ན་དེ་ལ་ཁྱིམ་གཞི་ཞིག་འཚོལ་རོགས་དགོས་སོ།",
    "ཕ་མའི་སེམས་དེ་མི་རེ་རེ་ལ་ཡོད་མོད།",
    "གནའ་དུས་ཀྱི་མི་དཔོན་པོར་འདུག་མི་འདོད་པ་མིན་མོད།",
    "ལམ་དྲང་མོ་ཞིག་མེད་པ་ལ་སུན་སྣང་སྐྱེས་པ་རེད།",
    "ལམ་དྲང་མོ་ཞིག་མེད་པར་དཔོན་གནས་འཚོལ་བ་ནི་དོང་བྲུས་ཏེ་གྱང་སྲུབས་ནས་བལྟ་བའི་སྐོར་དང་མཚུངས་པ་རེད་དོ།",
    "ཤིང་རྟ་བཅུ་ཕྲག་དང་མི་བརྒྱ་ཕྲག་རྗེས་སུ་འབྲང་ནས་རྒྱལ་ཁབ་འདི་ནས་སྣེ་ལེན་བྱས་ཏེ་བཟའ་བཟའ་འཐུང་འཐུང་བྱས་ཞིང་རྒྱལ་ཁབ་གཞན་ཞིག་ཏུ་སླེབས་པ་ནི་ཆེས་ཐལ་ཆེ་བ་མ་རེད་དམ།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་ལས་རིགས་སོ་སོའི་ཐོན་རྫས་རྒྱུན་མང་ཆེ་བས་ཉུང་བར་ཁ་གསབ་བྱས་ཚེ་ཞིང་འཁོར་གྱི་བརྗེ་རེས་མེད་ཚེ།",
    "བུད་མེད་ལ་རས་ལྷག་མ་ཡོད་དོ།",
    "གལ་ཏེ་འདི་ནས་མི་ཞིག་གིས།",
    "ཞིང་བཟོ་བ་དང་དཀྲུག་རྒྱབ་བཟོ་བའི་ཀུན་སློང་ནི་བཟའ་མ་བཟའ་བའི་ཆེད་དུ་རེད་ལ་སྐྱེས་བུ་དམ་པས་ཕུགས་བསམ་འཚོལ་བཞིན་པས་དེའི་ཀུན་སློང་ནི་ཟས་འཚོལ་ནས་བཟའ་བ་ཙམ་རེད་དམ།",
    "གལ་ཏེ་མི་ཞིག་གིས་འདི་ནས་ཁང་སྟེང་གི་རྫ་བཅགས་ཞིང་གྱང་ངོས་སུ་རི་མོ་ནག་ནོག་བྲིས་ན་དེ་ཡི་ཀུན་སློང་ཟས་འཚོལ་བ་ཡིན་པས་ཁྱོད་ཀྱིས་དེ་ལ་ཟས་སྟེར་རམ།",
    "ཧྲང་ཐང་གིས་མི་མངགས་ཏེ་སྒོ་ཕྱུགས་སྐྱེལ་ལོ།",
    "བྱིས་པ་ཞིག་གིས་བཟའ་མ་དང་ཤ་སྐྱེལ་བའང་འཕྲོག་ནས་བསད་དོ།",
    "གནམ་འོག་གི་རྒྱུ་ནོར་གྱི་ཆེད་དུ་མ་ལགས་ཏེ།",
    "དེ་སླེབས་པ་ན་ང་ཚོས་སླར་ཡང་སྡུག་བསྔལ་མྱོང་མི་དགོས་སོ།",
    "མི་དམངས་ཀྱིས་སླེ་བོའི་ནང་དུ་དར་གོས་ནག་པོ་དང་སེར་པོ་བཅུག་ནས་བསུ་བ་བྱས་ལ་ཀྲོའུ་རྒྱལ་ལ་ལས་དོན་བསྒྲུབ་པས་དེས་བཀའ་དྲིན་སྐྱོང་བའི་རེ་བ་དང་རླབས་ཆེ་བའི་ཀྲོའུ་རྒྱལ་ལ་མགོ་སྒུར་ནས་མངའ་འོག་ཏུ་འདུ་བར་བྱེད་དོ་ཅེས་སོ།",
    "ས་ཆ་གང་ཞིག་གིས་དཔོན་པོ་ཚོས་ཁ་དོག་སེར་པོ་དང་ནག་པོའི་དར་གོས་སླེ་བོར་བཅུག་ནས་ཀྲོའུ་རྒྱལ་གྱི་དཔོན་པོ་ཚོར་དགའ་བསུ་ཞུ།",
    "ཁྱོད་ནི་རྒྱལ་བོ་བྱམས་ལྡན་གྱི་ལམ་དུ་འགྲོ་བའི་རེ་བ་ཡོད་དམ།",
    "ཐ་ཏའེ་པུའུ་ཧྲེང་གིས་སྨྲས་པ།",
    "མང་པོས་དེ་ལ་ཐེ་གཏོགས་དང་ཉིན་རེ་རེར་ལྕག་གིས་གཞུས་ཏེ་ཆི་རྒྱལ་གྱི་སྐད་བསླབ་ཏུ་བཅུག་ནའང་མི་ཐུབ་པར་འགྱུར་རོ།",
    "དེར་སོང་ནས་བཀའ་དྲིན་ཆེ་ཞུས་སོ།",
    "སྐྱེས་བུ་དམ་པའི་རྒྱུན་དུ་རང་གིས་བློ་སྦྱོང་ཇི་ལྟར་བྱེད་པ་རྟོགས་ཐུབ་བོ་ཅེས་སོ།",
    "དཔེར་ན་མི་རེ་རེས་ཉི་མ་རེ་ལ་ཁྱིམ་མཚེ་ཡི་བྱ་རེ་བརྐུས་སོ།",
    "ཐོག་མར་བྱ་རྐུ་བ་ཇེ་ཉུང་དུ་བཏང་ནས་སྟ་གོན་བྱས་ཏེ་ཟླ་བ་རེ་ལ་བྱ་རེ་དང་།",
    "གལ་ཏེ་དེ་དག་གནས་ལུགས་དང་མི་མཐུན་པ་ཤེས་ན་མྱུར་མོར་མཚམས་འཇོག་དགོས་པས་ཅིའི་ཕྱིར་སང་ལོ་སྒུག་པ་ཡིན།",
    "ཆུ་ཆེན་པོས་ང་ཚོར་དོགས་པ་བཟོས་ཞེས་སོ།",
    "ཆུ་ཆེན་ནི་ཆུ་ལོག་རེད་དོ།",
    "ཧྲན་ཧྲུའེ་བཅས་སོ་རེད་དོ།",
    "ཁུངས་ལུང་མེད་པའི་རིག་གཞུང་དར་ལ་གཏུམ་སྤྱོད་ཀྱི་བྱ་སྤྱོད་གང་ས་གང་ནས་བུད་པ་དང་།",
    "ཧྲང་ཀྲོའུ་རྒྱལ་བོའི་སྐབས་སུ་གནམ་འོག་ཏུ་ཟིང་ཆ་ཆེན་པོ་ལངས་པས་ཀྲོའུ་ཀུང་གིས་ཀྲོའུ་ཝང་ལ་རོགས་རམ་བྱས་ཏེ་ཧྲང་ཀྲོའུ་བསད་པ་དང་།",
    "སྟག་དང་གཟིག་དང་བསེ་རུ།",
    "གླང་ཆེན་ཐག་རིང་དུ་བསྐྲད་པས་གནམ་འོག་གི་མི་སེར་རྣམས་ལ་སྤྲོ་བ་འཕེལ་ལོ།",
    "བདག་གི་གནས་ཚུལ་རྟོགས་མཁན་ནི་ཧ་ལམ་ཁྲུའུ་ཆིའུ་དེབ་ཐེར་འདི་ཁོ་ནའོ།",
    "བདག་ལ་སྐྱོན་འཛུགས་བྱེད་མཁན་ཡང་ཁྲུའུ་ཆིའུ་དེབ་ཐེར་འདི་རེད་དོ།",
    "ཕ་མ་དང་རྗེ་བོ་ལ་སྣང་མེད་དུ་བལྟ་བ་ནི་བྱོལ་སོང་དུ་གྱུར་བ་རེད་དོ།",
    "བདག་ནི་དེ་ལ་སྔངས་སྐྲག་སྐྱེས་ནས་གནའ་བོའི་འཕགས་པའི་དགོངས་པ་ལ་སྲུང་སྐྱོབ་དང་དབྱང་ཀྲུའུ་དང་མོ་ཏི་ཡི་གཏམ་གླེང་ལ་དགག་པ་དང་ཕྱིར་བུད་བྱས་ཏེ་ཁུངས་མེད་གླེང་བརྗོད་དྲིལ་བསྒྲགས་བྱེད་མཁན་ལ་ཤུགས་མེད་པར་བཟོ་བའོ།",
    "ཀྲོའུ་ཀུང་གིས་མཐའ་འཁོབ་པ་བསྐྲད་པ་དང་།",
    "ཁུང་ཙིས་ཁྲུའུ་ཆིའུ་དེབ་ཐེར་བསྒྲིགས་པས་ལུགས་དཀྲུག་བློན་ངན་བུ་རྒྱུད་ངན་པ་ཚོར་འཇིགས་སྣང་སྐྱེས་སུ་བཅུག་པ་རེད།",
    "ཕ་མ་དང་རྗེ་བོ་སྣང་མེད་བྱེད་པ་ཀྲོའུ་ཀུང་གིས་རྡུང་རྡེག་བྱས་སོ།",
    "བདག་གིས་ནི་མི་སེམས་དྲང་བཅོས་དང་ལོག་སྨྲ་ཚར་གཅོད།",
    "བདག་ལ་བྱ་ཐབས་ཟད་དེ་ཁག་མེད་པ་རེད་དོ།",
    "མེང་ཙིས་རང་གིས་རྩོད་པ་བྱེད་པའི་དམིགས་ཡུལ་བརྗོད་པ་དང་།",
    "དེ་ཝུའུ་ལིའང་ཞེས་པའི་ས་ཆར་བསྡད་ནས་ཉིན་གསུམ་དུ་ཟས་མ་ཟོས་པས་ལྟོགས་ཏེ་རྣ་བས་སྒྲ་མི་ཐོས་པ་དང་མིག་གིས་གཟུགས་མི་མཐོང་པར་གྱུར་ཏོ།",
    "དོང་ཆུའི་འགྲམ་དུ་ཤིང་ཏོག་པ་ལུམ་ཞིག་ལྷུང་འདུག་པ་བསེ་སྤུར་ལྗང་ནག་གིས་ཟོས་ཏེ་ཚལ་བ་ལྷག་འདུག་པ་དེ་ནུད་དེ་ཁམ་གསུམ་ཟོས་པ་ན་རྣ་བས་སྒྲ་ཐོས་པ་དང་མིག་གིས་གཟུགས་མཐོང་བར་གྱུར་ཏོ།",
    "ས་འབུ་ནག་རིང་གིས་ས་སྟེང་ནས་ས་སྐམ་བཟའ་ལ་ས་འོག་ནས་ཆུ་མིག་གི་ཆུ་འཐུང་ངོ།",
    "ཉིན་ཞིག་ལ་དེ་ཨ་མར་བལྟ་བར་འགྲོ་སྐབས་མི་གཞན་ཞིག་གིས་བྱ་གག་ཅིག་སྟེར་བ་དང་ཕྲད་པ་ལ་དེས་སྨིན་པ་བསྡུས་ཏེ་སྨྲས་པ།",
    "དེ་མྱུར་དུ་སྒོར་བུད་ནས་བཟས་པ་རྣམས་ཕྱིར་སྐྱུགས་སོ།",
    "སྔར་གྱི་རྒྱལ་བོ་གསུམ་གྱི་སྐབས་སུ་མིག་གི་མཐོང་ཤུགས་ལ་འགྲན་ཟླ་དང་བྲལ་བ་ཞིག་གོ།",
    "རྒྱལ་ཁབ་སྐྱོང་བར་སྔར་གྱི་རྒྱལ་བོའི་ལམ་ལུགས་ལ་མ་བརྟེན་ན་ཐབས་མཁས་པ་རེད་ཅེས་སྨྲ་ཆོག་གམ།",
    "མི་སེར་ཉེས་པ་བཟོ་མཁན་ཇེ་མང་དུ་སོང་བ་ནི་རྒྱལ་ཁབ་རྩ་མེད་འགྲོ་བའང་མི་འགྱངས་སོ།",
    "འཕགས་པ་ནི་མིའི་རིགས་ཀྱི་ཆེས་མཐོ་བའི་དཔེ་ལྟོས་རེད་དོ།",
    "དོན་དག་འདི་གཉིས་པོའང་ཡའོ་ཧྲུན་གྱི་ལད་མོ་བྱས་ཚེ་འགྲུབ་ཐུབ་བོ།",
    "མི་གཞན་པར་གུས་ཞབས་སྣེ་ལེན་བྱས་ཀྱང་གཞན་གྱིས་དང་ལེན་མ་བྱས་ན་རང་གིས་གུས་བཀུར་གྱི་འདང་མིན་ལ་ལྡོག་འདྲི་གྱིས་ཤིག་སྤྱོད་པ་ལ་དཔག་ཚོད་བྱས་པ་ལྟ་བུའི་འབྲས་བུ་མེད་ཚེ་རང་གིས་རང་ལ་རེ་བ་མཐོན་པོ་དང་རང་ལུས་དྲང་བར་བྱས་ན་གནམ་འོག་གི་མི་རང་གི་འོག་ཏུ་འདུ་ངེས་སོ།",
    "གནམ་འོག་གི་གཞི་རྩ་ནི་རྒྱལ་ཁབ་རེད།",
    "རྒྱལ་ཁབ་ཅིག་གིས་མིས་རེ་བ་འཆའ་བ་ལ་གནམ་འོག་གི་རེ་བ་འཆའ་འོ།",
    "གནས་ཚུལ་འདི་གཉིས་ཀྱང་གནམ་གྱི་ལས་ཀྱིས་ཐག་བཅད་པ་རེད་དོ།",
    "གནམ་བདག་གིས་བཀའ་ལྟར་དུ་ཐམས་ཅད་ཀྲོའུ་རྒྱལ་རབས་ཀྱི་མངའ་འོག་ཏུ་འདུའོ།",
    "རྗེ་བོ་རང་གིས་ཧུར་བརྩོན་ལྷོད་མེད་བྱས་ཚེ་བྱས་རྗེས་འཇོག་ཐུབ་པའོ།",
    "སྔོན་ཆད་བྱིས་པ་ཞིག་གིས་གླུ་བླངས་པའི་ནང་དོན་ནི་འདི་ལྟ་སྟེ།",
    "རྙོག་པར་གྱུར་ཚེ་བདག་གི་རྐང་བ་འཁྲུད་དོ།",
    "ཆུ་བོ་ཞིག་གི་མིང་ངོ།",
    "། མེང་ཙི་རྒྱལ་ཁབ་གྱི་དར་རྒུད་གནས་འཇིག་ཚང་མ་རང་གིས་ཧུར་བརྩོན་དང་འཕེན་པ།",
    "ཧྲང་ཐང་དང་ཀྲོའུ་ཝུན་ཝང་གི་མདུན་དུ་མི་སེར་དེད་མཁན་ནི་ཞ་ཅེ་དང་ཧྲང་ཀྲོའུ་རེད་དོ།",
    "འགྲོ་ལམ་ནི་མདུན་ན་ཡོད་ཀྱང་རྒྱང་རིང་དུ་འཚོལ་ལ་དོན་དག་སླ་མོ་ཡིན་ཡང་དཀའ་མོར་བསྒྲུབ་པའོ།",
    "མི་རེ་རེས་རང་གི་ཕ་མ་ལ་དགའ་བ་དང་།",
    "ཅང་ཐའེ་ཀུང་གིས་ཧྲང་ཀྲོའུ་གཡོལ་ནས་ཤར་ཕྱོགས་ཀྱི་མཚོ་འགྲམ་དུ་བསྡད་དོ།",
    "མི་འདི་གཉིས་ནི་གནམ་འོག་གི་ཆེས་སྙན་གྲགས་ཆེ་བའི་རྒན་པ་གཉིས་རེད་ཨང་།",
    "དེ་དག་ཀྲོའུ་ཝུན་ཝང་གི་མངའ་འོག་ཏུ་འདུ་བ་ནི་གནམ་འོག་གི་ཕ་རྒན་རྣམས་ཐམས་ཅད་དེ་ལ་འདུ་བ་དང་མཚུངས་སོ།",
    "མཁར་གྱི་རྫིང་བུ་གཅིག་འཕྲོག་རྩོད་བྱེད་པའི་ཆེད་དུ་འཐབ་ནས་བསད་པའི་མི་རོ་མཁར་ནང་ཀུན་དུ་ཁྱབ་པར་འདུག་པ་ལ་ས་ཆ་ཁྲིད་དེ་མི་ཤ་བཟའ་བ་ཟེར་བས་ནག་ཉེས་ཧ་ཅང་ཆེ་བས་སྲོག་ཆད་བཅད་ནའང་ཆུང་བར་སོང་།",
    "རྗེ་བོ་ཁ་ཤས་ཀྱིས་གཞན་ལ་བརྙས་བཅོས་དང་འཕྲོག་བཅོམ་བྱེད་པས་དེ་དག་གིས་རྗེ་བོ་དེའི་ཁ་ལ་མི་ཉན་ནོ།",
    "ཇི་ལྟར་བྱས་ཚེ་ཁེངས་སྐྱུངས་གུས་ཞབས་དང་གྲོན་ཆུང་རེད་ཅེ་ན།",
    "རེད་དོ།",
    "གཅེན་པོའི་སྐུ་ཟླ་ཆུར་ལྷུང་བ་ལག་པས་འཐེན་པ་ནི་བབ་བསྟུན་བསྒྱུར་བཅོས་ཀྱི་ཐབས་ཤེས་རེད་དོ།",
    "ད་ལྟ་གནམ་འོག་གི་མི་ཚང་མ་ཆུར་ལྷུང་ཟིན་པས་སྐུ་ཞབས་ཉིད་ཀྱིས་ལག་པ་མི་བརྐྱང་བ་ཅི་ཡི་ཕྱིར།",
    "གནས་བབ་ལ་བལྟས་ཚེ་བྱེད་མི་ཐུབ་པ་ཞིག་རེད་དོ།",
    "ཕ་དང་བུའི་བར་གྱི་བརྩེ་དུང་ལ་གནོད་པ་བྱུང་ན་ཆེས་མི་ལེགས་པ་ཞིག་རེད་དོ།",
    "རང་གི་ཚུལ་ལྡན་གྱི་སྤྱོད་པ་མ་ཉམས་པར་ཕ་མ་ལ་བཀུར་བསྟི་བྱེད་པ་ནི་ཐོས་མྱོང་ལ།",
    "རང་གི་ཚུལ་ལྡན་གྱི་སྤྱོད་པ་ཉམས་ནས་ཕ་མ་ལ་བཀུར་བསྟི་བྱེད་པ་ནི་ཐོས་པ་མེད་དོ།",
    "སུ་ཞིག་གིས་གཞན་པར་བཀུར་བསྟི་མི་ཐུབ་བམ།",
    "ཕ་མར་བཀུར་བསྟི་བྱེད་པ་ནི་བཀུར་བསྟི་ཐམས་ཅད་ཀྱི་རྩ་བ་རེད་ལ།",
    "སུ་ཞིག་གིས་གཞན་པར་ལྟ་སྲུང་མི་ཐུབ་བམ།",
    "ཟ་མ་ཐེངས་རེ་རེ་ལ་ངེས་པར་དུ་ཤ་དང་ཆང་ཡོད་དོ།",
    "ཟ་མ་ཐེངས་རེ་རེ་ལ་ངེས་པར་དུ་ཤ་དང་ཆང་ཡོད་དོ།",
    "སྲིད་སྐྱོང་བ་ལའང་སྡིགས་མོ་བྱེད་རིན་མེད་པའོ།",
    "ཁྱོད་ཀྱང་བདག་ལ་བལྟ་བར་འོང་བ་ཡིན་ནམ།",
    "ཁྱོད་འདིར་སླེབས་ནས་ཉིན་ཤས་འགོར་སོང་ངམ།",
    "ཁ་སང་སླེབས་ན་བདག་གིས་འདི་ལྟར་སྨྲ་བ་ཇི་ལྟར་མི་འོས་སམ།",
    "སྡོད་གནས་བཙལ་ཏེ་ལོན་རྗེས་ད་གཟོད་རྒན་རབས་མཇལ་བར་འགྲོ་བ་ཁྱོད་ཀྱིས་ཐོས་མྱོང་ངམ།",
    "བདག་འཆུག་སོང་བ་རེད་ལགས།",
    "ཁྱོད་རྒྱལ་སྲས་ཨའོ་དང་མཉམ་དུ་ཆི་རྒྱལ་དུ་འོང་པ་ནི་བཟའ་བཏུང་ཁོ་ནའི་ཆེད་དུའོ།",
    "བྱམས་བརྩེ་དང་སྤྱོད་བཟང་གི་ངོ་བོ་ནི་ཕ་མ་ལ་བསྙེན་བཀུར་བྱེད་རྒྱུ་དང་།",
    "མིའི་འཚོ་བའི་ཁྲོད་ཀྱི་སྤྲོ་བའི་རྩ་བ་རེད་དོ།",
    "སྲི་ཞུ་ཆེན་པོ་ལ་སྤྲོ་བ་འཕེལ་བ་ནི་དེས་མི་མང་པོ་ལ་སེམས་འགུལ་ཐེབས་པས་རེད་ཅེས་དགོངས་འདུག་ཡྻོཙྪཱ་ལི་ལོའུ་ཡི་ལེའུ།",
    "ཁོ་ཚོའི་བསམ་དོན་ཀྲུང་ཡོན་ནས་འགྲུབ་པ་ནི་ཧ་ལམ་གཅིག་པ་རེད།",
    "དེས་ན་ཆབ་སྲིད་ལ་འགན་ཁུར་བྱེད་མཁན་གྱིས་མི་རེ་རེར་ངོ་དགའ་དགོས་ན་དུས་ཚོད་ཀྱིས་ཇི་ལྟར་འདང་ཨང་།",
    "ལས་གནས་ལས་བུད་པའི་བློན་པོས་ཀྱང་སྔར་གྱི་རྗེ་བོར་མྱ་ངན་གྱི་གོས་གྱོན་དགོས་པ་དང་།",
    "ཀུན་སྤྱོད་དང་གཤིས་རྒྱུད་ཚད་ལྡན་གྱི་མི་ཞིག་གིས་ཁ་ཐོག་ལག་བཞག་མི་ཐུབ་པ་དང་།",
    "དམ་པས་ཡང་དག་པའི་བྱེད་ཐབས་སྤྱད་དེ་གཏིང་ཟབ་མོར་ཞིབ་འཇུག་བྱེད་པ་ནི་རང་ཉིད་ཀྱིས་གནས་ལུགས་རྟོགས་པའི་ཆེད་དུའོ།",
    "རང་གིས་རྟོགས་པའི་གནས་ལུགས་དེ་སེམས་སུ་བརྟན་པོར་གནས་ཐུབ་པ་དང་དེ་བརྟན་ན་བློ་སྐྱེད་ཟབ་མོ་སྐྱེས་པ་དང་།",
    "སྐྱེས་བུ་དམ་པས་རང་གིས་གནས་ལུགས་རྟོགས་པར་རེ་བ་འཆའ་འདུག་གོ་བསྡུས་དོན།",
    "གནམ་འོག་གི་མིས་སེམས་སུ་མི་བབ་ཀྱང་རྒྱལ་བོར་གྱུར་བ་ནི་སྔོན་ཆད་བྱུང་མ་མྱོང་ངོ།",
    "ཁོང་གིས་ཆུ་ཡི་གང་ཐད་ལ་གདེང་འཇོག་བྱས་པ་རེད་དམ།",
    "དྲང་ལམ་ལ་དམིགས་ནས་མདུན་དུ་སྐྱོད་ལ་དེ་མཐོང་མ་ཐུབ་ཀྱང་གང་ལྟར་ཡང་ཡར་ཐོན་ཡོང་བཞིན་པ་རེད།",
    "ཀྲོའུ་ཝུའུ་ཝང་གིས་ཉེ་འགྲམ་གྱི་བློན་པོ་རྣམས་ལ་མཐོང་ཆུང་མི་བྱེད་པ་དང་རྒྱང་རིང་གི་བློན་པོ་རྣམས་ཀྱང་མི་བརྗེད་དོ།",
    "ཀྲོའུ་རྒྱལ་རབས་ཤར་དུ་སྤོས་རྗེས་རྒྱལ་བོས་དམངས་གླུ་འདམ་པའི་བྱེད་ཐབས་དོར་བས་སྙན་ངག་གི་མཇུག་རྫོགས་སོ།",
    "མེང་ཅིས་ཁུང་ཙིཡི་གཞུང་ལུགས་རྒྱུད་འཛིན་གྱི་འགན་ཁུར་རང་གིས་བཞེས་པ་བསྟན།",
    "ཡུས་ཀུང་ཀྲི་ཟེར་བ་དེ་རེད་དོ།"
  ]
}