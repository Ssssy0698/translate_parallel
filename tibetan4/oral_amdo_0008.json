    "མིག་གི་མངོན་སུམ་དུ་བཀྲམ་པ་མིན་ན་རྣ་བར་མི་འགྲོ་བའི་རླབས་ཆེན་བྱས་རྗེས་ཞིག་རེད།",
    "དེ་ནི་གཟིགས་རྒྱངས་རིང་བའི་ཇུས་བཀོད་ཅིག་རེད།",
    "རྣམ་རྒྱལ་ལགས་ནས་ཡིག་བསྒྱུར་བྱས་པའི་རྒྱ་ནག་གི་གནའ་དཔེ།",
    "ཐལ་ཆེ་བ་མ་ཡིན་པ་སོགས་ཀྱི་དོན་ཡིན་ལ།",
    "ཡིན་ན་ཡང་ཁུང་མེང་གི་ལྟ་བ་དེ་འཇིག་རྟེན་ཡ་རབས་ཀྱི་ལུགས་སྲོལ་ཞིག་ཡིན་པས།",
    "འཇིག་རྟེན་གྱི་ལྟ་སྤྱོད་གོམས་སྲོལ་ཐམས་ཅད་ཉིན་རེ་བཞིན་འགྱུར་གྱིན་ཡོད་པ་འདུས་བྱས་ཐམས་ཅད་མི་རྟག་པ་ཞེས་པའི་ལྟ་བའི་ཕྱག་རྒྱ་ལས་མ་འདས་ཤིང་།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་འཇིག་རྟེན་ན་གང་ཡོད་པར་འདོད་པ་དེ་བདག་གིས་ཀྱང་ཡོད་པར་འདོད་ལ།",
    "འཇིག་རྟེན་ན་གང་མེད་པར་འདོད་པ་དེ་བདག་གིས་ཀྱང་མེད་པར་འདོད་དོ།",
    "ཤ་རྭ་གླ་རྩི་གི་ཝང་བ་སོ་སོགས་དུད་འགྲོའི་ལུས་ལས་བྱུང་བ་ཤ་སྟག་ཡིན་ལ།",
    "སྟོད་ཆ་ལིའང་ཧུའེ་ཝང་གི་ལེའུ།",
    "༧ ཉྙོ་བློགློ་ལིའང་ཧུའེ་ཝང་གི་ལེའུ།",
    "རྒྱུ་ཀླུཀྵ་༡༡ མེང་ཚིས་ལིའང་ཧུའེ་ཝང་མཇལ་བ་ན་ལིའང་ཧུའེ་ཝང་ན་རེ།",
    "དམག་གི་ཤིང་རྟ།",
    "འགྲམ་དུ་ལངས་ཏེ་ཁྲུང་ཁྲུང་ཆེ་ཆུང་དང་ཤྭ་ཆེ་ཆུང་ལ་གཟིགས་མོར་བྱེད་མུས་སུ་སྨྲས་པ།",
    "མེང་ཚོས་ལན་སྨྲས་པ།",
    "ཉིན་ཅུང་མ་འགོར་བར་ཐོག་མར་ཚད་འཇལ་སྐབས་མྱུར་དུ་འགྲུབ་པར་མ་སེམས་ཀྱང་མི་སེར་རྣམས་ཀྱིས་རང་གི་ཕ་མ་ལྟར་རོགས་རམ་བྱས་པར་མྱུར་མོ་གྲུབ།",
    "རྒྱལ་བོ་མཛེས་སྡུག་རྫིང་བུར་གཟིགས་མོར་སླེབས་པ་ན་ཉ་རྫིང་བུ་གང་པོ་ཡར་འཕག་མཆོང་བྱེད་འདུག་ཀྲོའུ་ཝུན་ཝང་༧ གིས་མི་སེར་གྱི་སྟོབས་ཤུགས་ལ་བརྟེན་ནས་སྟེགས་བུ་མཐོན་པོ་དང་རྫིང་བུ་ཟབ་མོ་གསར་བཟོ་བྱས་ཀྱང་མི་སེར་ལ་སྤྲོ་བ་རབ་ཏུ་རྒྱས་ཏེ་དེའི་སྟེགས་བུ་ལ་སྒྱུ་རྩལ་ཕུལ་བྱུང་གི་སྟེགས་བུ་དང་རྫིང་བུ་ལ་ངོ་མཚར་སྨད་དུ་བྱུང་བའི་རྫིང་བུ་ཞེས་མིང་བཏགས་པར་མ་ཟད་དེ་ལ་ཤྭ་ཆེ་ཆུང་དང་ཉ་སྣ་ཚོགས་ཡོད་པར་དགའ་སྤྲོ་འཕེལ།",
    "འཐབ་རྔ་ལྡིར་ལྡིར་རྡུང་བ་དང་གྲི་ཡི་དབལ་དང་རལ་གྲིའི་རྩེ་གཏུགས་པའི་ཚེ་དམག་མི་རེ་ཞིག་གིས་ཁྲབ་རྨོག་དོར་ཤིང་ལག་ཆ་དྲུད་ནས་བྲོས་པ་ན་ཁ་ཤས་ཤིག་གོམ་པ་བརྒྱ་ཙམ་ལ་བྲོས་ནས་བསྡད།",
    "ལིའང་ཧའེ་ཝང་ན་རེ།",
    "རྒྱལ་བོས་གལ་ཏེ་གནས་ལུགས་དེ་རྟོགས་ན་མི་སེར་ཁྱིམ་མཚེས་རྒྱལ་ཁབ་ལས་མང་བར་རེ་བ་འཆའ་མི་དགོས་སོ།",
    "རྒྱལ་བོས་ཉེས་པ་དེ་དག་ལ་ལོ་བབ་ངན་པའི་སྟེང་དུ་མ་བཞག་ན་གནམ་འོག་གི་མི་སེར་རྣམས་རང་བཞིན་གྱི་མངའ་འོག་ཏུ་འདུའོ།",
    "རྒྱུ་༡༡༤ ལིའང་ཧུའེ་ཝང་གིས་སྨྲས་པ།",
    "ཐ་ལིའང་ཧུའེ་ཝང་གིས་སྨྲས་པ།",
    "ལིའང་ཧུའེ་ཝང་གིས་སྨྲས་པ།",
    "མེང་ཙིས་དཔེ་འཇོག་གི་ཐབས་ཤེས་སྤྱད་དེ་ལིའང་ཧུའེ་ཝང་ལ་གཏུམ་སྤྱོད་སྲིད་དོན་གྱི་ཆབ་སྲིད་དོར་ནས་མི་དམངས་ལ་དགའ་ཞེན་ཆེ་དགོས་པར་གདམས་པའོ།",
    "འོན་ཀྱང་ཁོ་བོའི་ལག་ཏུ་ཐོན་པ་ན་ཤར་ཕྱོགས་ནས་ཆི་གོ་ལ་ཕམ་ཁ་ཉོས་ནས་བདག་གི་བུས་ཀྱང་ཚེ་སྲོག་ཤོར།",
    "དེ་དག་གི་ལག་ཏུ་དབྱུག་ཏོ་བཟུང་ནས་སྲ་མཁྲེགས་ཀྱི་ཁྲབ་རྨོག་དང་རྣོ་དབལ་ལྡན་པའི་རལ་གྲི་བཟུང་བའི་ཆི་རྒྱལ་དང་ཁྲུའུ་རྒྱལ་གྱི་དམག་དཔུང་ལ་འཐབ་ཏུ་བཅུག་ནའང་རྒྱལ་ཐུབ་བོ།",
    "ཕ་མར་འཁྱགས་ལྟོགས་དང་སྤུན་ཟླ་བུད་མེད་བུ་རྒྱུད་བཅས་ཕྱོགས་སོ་སོར་འཐོར་འགྲོ།",
    "ཁོ་ཚོས་མི་སེར་རྣམས་སྡུག་བསྔལ་ནང་སྒྲུབ་པས་རྒྱལ་བོས་དེ་དག་ཁྲིད་དེ་ཕར་རྒོལ་བྱས་ཚེ་སུ་ཞིག་གིས་རྒྱལ་བོ་། མེང་ཙི་ཁྱོད་ལ་འགྲན་ཟླ་བྱེད་ཐུབ་བམ།",
    "ཀྵ་བདག་གིས་ལན་སྨྲས་པ།",
    "གནམ་འོག་གི་མི་དེ་ཡི་རྗེས་སུ་མི་འབྲངས་བ་སུ་ཞིག་ཡོད།",
    "སུ་ཞིག་གིས་འགོག་ཐུབ།",
    "ད་ལྟ་གནམ་འོག་གི་རྒྱལ་པོ་མི་གསོད་པར་མི་དགའ་གཅིག་ཀྱང་མེད་དོ།",
    "གནམ་འོག་གི་མི་སེར་རྣམས་ཀྱི་སྐྱེ་སྲིང་ནས་རེ་སྒུག་བྱེད་འདུག་གལ་ཏེ་དེ་ལྟར་ལགས་ན་མི་སེར་གྱིས་དེ་ལ་མགོ་འདོགས་པ་ནི་ཆུ་ཐུར་དུ་བཞུར་བ་ལྟར་སྟོབས་ཤུགས་ལྡན་པས་སུ་ཞིག་གིས་བཀག་འགོག་ཐུབ་སྟེ་མི་ཐུབ་བོ།",
    "ཀུན་སྤྱོད་དང་གཤིས་རྒྱུད་ཅི་ལྟ་བུ་ཞིག་ཡོད་ཚེ་ད་གཟོད་གནམ་འོག་གི་རྒྱལ་བོ་བྱེད་ཐུབ།",
    "མི་སེར་སྲུང་སྐྱོབ་བྱས་ན་གནམ་འོག་གི་རྒྱལ་བོ་བྱེད་པ་ལ་མི་སུ་ཞིག་གིས་བཀག་འགོག་བྱེད་ཐུབ་ཐ་སྐྱོ་། མེང་ཙི་ཆི་ཞོན་ཝང་གིས་སྨྲས་པ།",
    "བདག་ལྟ་བུ་ཞིག་གིས་མི་སེར་སྲུང་སྐྱོབ་བྱེད་ཐུབ་བམ།",
    "༡༧༢ ཆི་ཞོན་ཝང་གིས་སྨྲས་པ།",
    "དེ་ལྟ་བུའི་བསམ་བློ་ལྡན་ཚེ་གནམ་འོག་སྐྱོང་བའི་རྒྱལ་བོ་རྦད་དེ་བྱེད་ཆོག་ཆོག་རེད།",
    "བདག་གིས་ནི་སྔར་ནས་རྒྱལ་བོས་མི་བཟོད་པའི་བསམ་པ་རྟོགས་སོ།",
    "མི་སེར་ཁྲོད་དུ་དེ་ལྟ་བུའི་གླེང་མོལ་དངོས་གནས་ཡོད་དོ།",
    "དེ་བས་ལུག་གིས་ཚབ་བྱས་པ་ཡིན་ནོ།",
    "དེ་ནི་བྱམས་སྤྱོད་ཀྱི་གཞི་རྩའི་མཚོན་ཚུལ་ཙམ་ཞིག་རེད་ལ།",
    "དེ་དག་གི་སྐད་ཅོར་འདོན་པ་ཐོས་པ་ན་དེའི་ཤ་ཟ་བར་མི་བཟོད་པའོ།",
    "སྐུ་ཞབས་ཀྱིས་འདི་ལྟར་སྨྲས་ཚེ་བདག་གི་སེམས་གཏིང་ལ་བབ་བྱུང་།",
    "རྒྱལ་བོ་ཁྱོད་ཀྱིས་གཏམ་དེ་ལ་ཡིད་མཐུན་བྱེད་དམ།",
    "དེ་བས་རྒྱལ་བོ་གནམ་འོག་གི་རྒྱལ་བོ་གྱུར་མ་ཐུབ་པ་ནི་རི་བོ་ཐའེ་ཧྲན་མཆན་དུ་བཅུག་ནས་མཚོ་པའེ་ཧྲའེ་ལྡང་བའི་གྲས་མིན་ལ།",
    "རང་གི་བུ་རྒྱུད་ལ་གཅེས་སྐྱོང་བྱེད་པ་བཞིན་གཞན་གྱི་བུ་རྒྱུད་ལའང་གཅེས་སྐྱོང་བྱེད་པའོ།",
    "ཁོ་རང་གི་སྤྱོད་པ་ཁྱབ་སྤེལ་བྱེད་མཁས་པ་ཁོ་ནའོ།",
    "དངོས་པོ་ཡོད་དོ་ཅོག་དེ་ལྟར་རེད་ལ་མི་སེམས་ལྷག་པར་དེ་ལྟར་ལགས་སོ།",
    "འདི་དག་ཚང་མ་བཀའ་བློན་རྣམས་ཀྱིས་རྒྱལ་བོ་ལ་མཁོ་སྤྲོད་བྱེད་པས་རྒྱལ་བོ་དེ་ལ་རེ་བ་ཅི་ལ་འཆའ།",
    "བདག་གིས་དེ་དག་གི་ཆེད་དུ་ག་ལ་ཡིན་ཞེས་སོ།",
    "ཧ་ལམ་དེ་བས་ཀྱང་ཚབས་ཆེན་རེད།",
    "རྒྱལ་བོ་ན་རེ།",
    "ད་ལྟ་མཚོ་བཞིའི་ནང་གི་རྒྱ་ཁྱོན་ལ་ཧ་ལམ་ལི་གྲུ་བཞི་སྟོང་ཕྲག་དགུ་བརྒྱ་ཡོད་པ་ལ།",
    "བྱམས་སྤྱོད་ལྡན་པའི་རྒྱལ་བོ་སུ་ཞིག་གིས་མི་སེར་ལ་མ་ཉེས་ཁ་གཡོག་བྱེད་པའི་བྱ་བ་བྱེད་། མེང་ཙི་དམ།",
    "ལོ་ལེགས་དུས་སུ་ཉི་མ་རེ་རེ་བཞིན་སྡུག་མྱོང་བ་དང་།",
    "༧ ཙྩུརྒྱུ་ལིའང་ཧུའེ་ཝང་གི་ལེའུ།",
    "མེང་ཚོལ་རྒྱལ་བོས་མཇལ་ཕྲད་གནང་བྱུང་།",
    "ད་ལྟའི་གླུ་དབྱངས་དང་གནའ་བོའི་གླུ་དབྱངས་ནི་འདྲ་འདྲ་རེད་དོ།",
    "བདག་གིས་རྒྱལ་བོ་ལ་གླུ་དབྱངས་ཀྱི་སྐོར་གླེང་བའི་གནང་བ་སྩོལ་དང་།",
    "རྒྱལ་བོས་ས་འདི་རུ་རོལ་མོ་དཀྲོལ་བར་དཔེར་མཚོན་ན།",
    "མི་སེར་གྱིས་ཅོང་སྒྲ་དང་རྔ་ཡི་སྒྲ་དང་སྨྱུག་གླིང་དང་འཕྲེད་གླིང་གི་སྒྲ་ཐོས་པ་ན་ཐམས་ཅད་ཀྱི་མགོ་བོ་ན་ཞིང་སྨིན་མ་བསྡུས་ཏེ་ཕན་ཚུན་ལ་གཏམ་དུ་སྨྲ་བ།",
    "སྨྱུག་གླིང་དང་འཕྲེད་གླིང་གི་སྒྲ་ཐོས་པ་ན་ཐམས་ཅད་ལ་འཛུམ་དམུལ་སྒོས་ཕན་ཚུན་ལ་གཏམ་དུ་སྨྲ་བ།",
    "རོལ་མོ་དཀྲོལ་བ་ལ་བལྟས་ན་ཤེས་སོ།",
    "ཝུན་ཝང་གི་སྐྱེད་མོས་ཚལ་ལ་འཕྲེད་གཞུང་ལ་སྤྱི་ལོ་བདུན་ཅུ་ཡོད་ཅེས་པ་དངོས་གནས་དེ་འདྲ་ལགས་སམ།",
    "དེ་ནི་ཅི་འདྲའི་ཆེན་པོ་ཞིག་རེད་ཨང་།",
    "མི་སེར་རྣམས་ཀྱིས་དེ་ད་དུང་ཆུང་བར་སེམས་པ་ནི་འོས་པ་ཞིག་མ་རེད་དམ།",
    "བདག་གི་ཐོས་པ་ལྟར་ན་རྒྱལ་སའི་ཉེ་འདབས་སུ་སྐྱེད་མོས་ཚལ་འཕྲེད་གཞུང་ལ་སྤྱི་ལེ་བཞི་བཅུ་ཡོད་པ་དེའི་ནང་དུ་ཤྭ་བོ་ཞིག་བསད་ན་མི་ཞིག་བསད་པའི་ཉེས་པ་ཡོད་ཅེས་སོ།",
    "ཀྲོའུ་ཝུན་ཝང་གིས་ཁུན་དབྱི་༧ཟེར་བའི་རྒྱལ་ཁབ་ཀྱི་ལས་དོན་བསྒྲུབ་པ་དང་མཚུངས་སོ།",
    "རྒྱལ་ཁབ་ཆུང་བ་ཞིག་གི་རྒྱལ་བོའི་མིང་། ཀྲུའུ་ཝུན་ཝང་།",
    "རྒྱལ་ཁབ་ཆུང་བ་ཞིག་གི་མིང་།",
    "སྐད་ཆ་དེ་ཅི་འདྲའི་རླབས་ཆེ་བ་ཞིག་རེད་ཨང་།",
    "ཀྲོའུ་ཝུན་ཝང་གི་ཨ་མྱེའོ།",
    "ཀྲོའུ་རྒྱལ་གྱི་བདེ་སྐྱིད་སྲུང་བར་ཤུགས་སྣོན་བྱེད་ཐུབ་པས་དེས་གནམ་འོག་གི་མི་སེར་གྱི་རེ་བ་བསྐོང་ཐུབ་བོ།",
    "འདི་ནི་ཝུན་ཝང་གི་དཔའ་ངར་ཆེན་པོ་ལགས་སོ།",
    "ཕྱོགས་བཞིའི་མི་སེར་ལ་ནག་ཉེས་ཡོད་པ་དང་མེད་པ་ཐམས་ཅད་བདག་གི་འགན་ཁུར་ལགས།",
    "གནམ་འོག་གི་མི་སུ་ཞིག་གིས་དེའི་འགན་ལས་བརྒལ་ཐུབ་བམ།",
    "མི་སུ་ཞིག་གིས་གནམ་འོག་ཏུ་ཧམ་བཟུང་བྱས་ན་ཝུའུ་ཝང་གིས་ངོ་ཚའི་གནས་སུ་འདོད་དོ།",
    "འདི་ནི་ཝུའུ་ཝང་གི་དཔའ་ངར་རེད་ལགས།",
    "མི་སེར་གྱི་སེམས་སྡུག་དེ་རང་གི་སེམས་སྡུག་དང་།",
    "བདག་ནི་ཀྲོན་ཧྥུ་དང་ཁྲའོ་ཝུའུ་རི་བོ་ལ་ལྗོངས་རྒྱུ་བ་དང་དེ་ནས་མཚོ་འགྲམ་རྒྱུད་དེ་ལྷོ་ཕྱོགས་ནས་ལང་ཡ་རི་བོའི་བར་སོང་ནས་བདག་གིས་བློ་སྦྱོང་ཇི་ལྟར་བྱས་ཚེ་ད་གཟོད་གོང་མའི་རྒྱལ་བོའི་ལྗོངས་རྒྱུ་བ་དང་འདྲ་འམ་སྙམ་མོ།",
    "དེའང་རང་གི་བྱ་བ་དང་ཟུང་འབྲེལ་མེད་པ་གཅིག་ཀྱང་མེད་དོ།",
    "དཔྱིད་དུས་སུ་སོ་ནམ་པའི་གནས་ཚུལ་ལ་གཟིགས་ཞིབ་བྱེད་ལ།",
    "གནམ་གྱི་འདོད་བློ་ལས་ལོག་སྟེ་མི་སེར་ལ་མནར་གཅོད་དང་བཟའ་བཏུང་གི་རྒྱས་སྤྲོས་ནི་བཞུར་ཆུ་དང་མཚུངས་སོ།",
    "ཞེན་ཆགས་ལོག་བརྗེད་དང་སྟོང་བརླག་སྤྱོད་སྡུག་གིས་རྒྱལ་ཕྲན་རྣམས་ལ་ཡིད་ཤིན་ཏུ་སྐྱོ་བའི་གནས་སུ་གྱར་བར་བཅུག་གོ།",
    "ཁྱོད་ཀྱིས་བདག་ལ་རྒྱལ་བོ་དང་འབངས་མི་སྤྲོ་མཐུན་གྱི་གླུ་དབྱངས་ཤིག་རྩོམ་དང་ཅེས་སོ།",
    "དེས་བརྩམས་པ་ནི་ཀྲི་ཀྲའོ་དང་ཅའོ་ཀྲའོ་ཟེར་བའི་གླུ་དབྱངས་རེད་ལ།",
    "རྒྱལ་བོར་སེམས་ཁུར་བྱེད་པ་ནི་རྒྱལ་བོར་གཅེས་སྐྱོང་བྱས་པའི་དོན་རེད་ཅེས་སོ།",
    "དྭངས་གསལ་ཚོམས་ར་ནི་སྔ་དུས་གོང་མས་རྒྱལ་ཕྲན་རྣམས་ལ་མཇལ་ཕྲད་གནང་ས་རེད།",
    "འགག་སྒོ་དང་ཚོང་རར་ཞིབ་བཤེར་བྱེད་པ་ལས་དཔྱ་ཁྲལ་མི་ལེན་པ།",
    "རྒན་མོ་ལ་སྐྱེས་པ་མེད་ན་མོ་ཡུག་བགྲེས་པོ་ལ་བུ་ཕྲུག་མེད་ཚེ་ཁེར་རྐྱང་།",
    "འདི་བཞི་ནི་གནམ་འོག་གི་ཆེས་དཀའ་ངལ་ཅན་དང་སྐྱབས་མེད་མགོན་མེད་ཀྱི་མི་རེད་དོ།",
    "ཀྲོའུ་ཝུན་ཝང་གིས་སྲིད་བཀའ་བསྒྲུགས་ཏེ་ཆབ་སྲིད་སྤེལ་སྐབས་ཐོག་མར་ངེས་པར་དུ་མི་འདི་རྣམས་ལ་བསམ་གཞིག་བཏང་ངོ།",
    "ཕྲན་ལ་སྐྱོན་ཞིག་ཡོད་པ་ནི་རྒྱུ་ནོར་ལ་དགའ་བ་དེ་རེད།",
    "མདའ་མོ་གཞུ་རྒྱུན་སྟེང་དུ་བཞག་པ་དང་།",
    "གྲི་དང་སྟ་རེ།",
    "བདག་ལ་སྐྱོན་ཞིག་ཡོད་པ་ནི་མཛེས་མར་དགའ་བ་དེ་རེད།",
    "དེའི་བཙུན་མོ་ལ་ལྷག་པར་དགའ་བ་ནི་སྙན་ངག་ཏུ།",
    "ཀྲོའུ་རྒྱལ་གྱི་ཐའེ་ཝང་ཞོགས་པར་རྟ་མཆོག་ཆིབས་ཏེ་ནུབ་ཀྱི་ཆུ་འགྲམ་རྒྱུད་དེ་ཆི་ཧྲན་རི་བོའི་འདབས་སུ་རྒྱུག་ནས་ཅང་སང་གི་བུ་མོ་དང་མཉམ་དུ་འོང་ནས་ལྷན་དུ་བསྡད་དོ།",
    "རྒྱལ་བོའི་མངའ་འོག་གི་དཔོན་པོ་ཞིག་གིས་གལ་སྲིད་རང་གི་ཆུང་མ་དང་བུ་ཕྲུག་གྲོགས་པོ་ལ་བཅོས་། མེང་ཙི་ཏེ་རང་ཉིད་ཁྲུའུ་རྒྱལ་དུ་ལྗོངས་རྒྱུ་བར་སོང་།",
    "ཕྱིར་སླེབས་སྐབས་སུ་རང་གི་ཆུང་མ་དང་བུ་རྒྱུད་ཀྱིས་འཁྱགས་ལྟོགས་མྱོང་ཡོད་ན་ཅི་བྱར་ཡོད།",
    "སྔར་བསྐོ་སྤྱོད་བྱས་པའི་མི་རྣམས་ད་ལྟ་གང་དུ་སོང་བ་མི་ཤེས་སོ།",
    "རྒྱལ་བོའི་གཡས་གཡོན་གྱི་བློན་པོ་རྣམས་ཀྱིས་མི་དེ་ཕུལ་བྱུང་རེད་ཅེས་སྨྲས་ཀྱང་མི་ཆོག་ལ་དཔོན་ཆེན་གཞན་རྣམས་ཀྱིས་མི་དེ་ཕུལ་བྱུང་རེད་ཅེས་སྨྲས་ཀྱང་མི་ཆོག་རྒྱལ་འབངས་ཡོངས་ཀྱིས་མི་དེ་ཕུལ་བྱུང་རེད་ཅེས་སྨྲས་ན་ད་གཟོད་མི་དེ་ལ་ཞིབ་བཤེར་བྱས་ཏེ་དངོས་གནས་སུ་ཕུལ་བྱུང་བ་ཞིག་ཡིན་ཚེ་ད་གཟོད་བསྐོ་སྤྱོད་བྱེད་དོ།",
    "འདི་ནི་རྒྱལ་འབངས་ཡོངས་ཀྱིས་བསད་པ་རེད་ཅེས་སྨྲའོ།",
    "རྗེ་བོ་ངན་པ་ཞིག་གི་མིང་ངོ། ཧྲང་ཀྲོའུ།",
    "རྗེ་བོ་ངན་པ་ཞིག་གི་མིང་ངོ།",
    "བདག་གིས་རྗེ་བོ་ངན་པ་ཧྲང་ཀྲོའུ་བསད་པ་ཐོས་ལ།",
    "མིང་སྟོང་གི་རྒྱ་ལས་གྲོལ་དགོས་པར་སེམས་སོ།",
    "རྒྱལ་བོས་དེ་ལ་ཁྱོད་ཀྱིསབསླབས་པ་རྣམས་རེ་ཞིག་ཞོག་ལ་བདག་གིས་སྨྲ་བ་ལྟར་གྱིས་ཤིག་ཅེས་སྨྲས་ན་དེ་ནི་ཅིའི་ཕྱིར་རུང་།",
    "གླེང་བ་ན་ཁྱོད་ཀྱིས་སྔར་བསླབས་པ་རྣམས་རེ་ཞིག་ཞོག་ལ་བདག་གིས་སྨྲས་པ་ལྟར་གྱིས་ཤིག་ཅེས་སོ།",
    "དེ་འཕྲོག་ལེན་མ་བྱས་ཚེ་གནམ་རྒན་མས་ངེས་པར་ཆག་སྒོ་ལྷུང་ངེས་རེད་ཅེས་འཕྲོག་ལེན་བྱེད་ན་ཇི་ལྟར་ལགས།",
    "གལ་ཏེ་ཆུ་ནང་དུ་བྱིང་ན་ཇེ་ཟབ་དང་མེ་ནང་དུ་ལྷུང་ཚེ་ཇེ་ཚ་ཡིན་ན་ད་གཟོད་ཁ་ཕྱིར་འཁོར་ནས་སྐྱོབ་མཁན་ཞིག་ལ་རེ་བ་མི་བཅའ་ཐབས་མེད་རེད་དོ་། མེང་ཙི་བསྡུས་དོན།",
    "གནམ་འོག་གི་མི་ཚང་མས་དེ་ལ་ཡིད་ཆེས་བརྟན་པོ་ཡོད་པས་དེས་སོ།",
    "ཎྞཾ་ཙི་ཉི་། མེང་ཙི་ཙྪཱ་ཚེ་ཎྞཾ་ཟླ་ ༡ ༢ ༣ གྱི་ ཉི་ཙྪཱ་ཏི་ཎྞཾརྒྱུ་བྱ་༢༡༡༢ ཧྲང་ཧྲུའུ་ཞེས་པའི་དེབ་ནང་དུ་ང་ཚོས་རྗེ་བོ་སྒུག་ནས་སླེབས་པ་ན་ད་གཟོད་སླར་ཡང་གསོན་པའི་རེ་བ་ཡོད་དོ་ཞེས་སོ།",
    "ད་ལྟ་ཡན་རྒྱལ་གྱིས་རང་གི་མི་སེར་ལ་མནར་གཅོད་བྱེད་མུས་ཡིན་པས།",
    "རྒྱལ་བོས་མྱུར་མོར་བཀའ་སྒྲོག་སྟེ།",
    "དེ་དག་གི་རྒྱུ་ནོར་རྩ་ཆེན་འཕྲོག་པའི་མཚམས་འཇོག་པ།",
    "དོགས་ཟོན་གྱིས་དང་དོགས་ཟོན་གྱིས་ཤིག་ཁྱོད་ཀྱིས་ལས་པའི་བྱ་བ་དེ་མཇུག་འབྲས་རང་གི་ལུས་སྟེང་དུ་སྨིན་ངེས་རེད་ཅེས་སོ།",
    "མེང་ཙིས་དམངས་སེམས་ནི་དམག་འཁྲུག་གི་རྩ་བ་ཡིན་པར་བཞེད་དོ།",
    "མི་སེར་གྱི་སྲོག་ལ་ཐུག་ཀྱང་དེ་ལས་མ་བྲལ་ན་བྱེད་ནུས་ཅུང་རེ་ཐོན་ངེས་རེད།",
    "བདག་གིས་འདི་ལྟར་ཐོས་མྱོང་བ་ནི།",
    "ས་ཆ་ནི་མི་རབས་ནས་མི་རབས་བར་སྲུང་དགོས་བ་ཡིན་པས་རང་གིས་རང་དགར་སྒྱུར་མི་ཐུབ་པས་སྲོག་ཤོར་ཡང་ས་ཆ་འདི་ལས་མི་བྲལ་ལོ་ཞེས་སོ།",
    "ཐ་༡ ཆུ་ ཙང་ཚང་གིས་སྨྲས་པ།",
    "མི་དེ་སྤྱོད་ཡོན་གཉིས་ལྡན་ཞིག་རེད་བསམ་འདུག་པ་ལགས་སམ།",
    "ཁྱོད་ཀྱིས་རྒལ་ཞེས་ཅི་ལ་ཟེར།",
    "ཐ་ཉྙོཙྪི་ལོའུ་ཕེང་ཀུང་གིས་སྨྲས་པ།",
    "མ་ཡིན་ཏེ་བདག་གིས་བསྟན་པ་ནི་ཕྱི་ནང་གི་རོ་སྒམ་དང་བཀྲག་མདངས་ཅན་གྱི་གྱོན་པ་ལའོ།",
    "བདག་གིས་རྒྱལ་བོར་ཞུས་ཏེ་ཉིད་ལ་ཐུག་ཕྲད་བྱེད་པར་འགྲོ་གྲབས་བྱས།",
    "མེང་ཙིས་གནམ་འོག་གི་དར་རྒུད་དང་ཆགས་འཇིག་ནི་གནམ་རྒན་མའི་འདུན་མ་ཡིན་པར་དགོངས་སོ།",
    "ཀོན་ཀྲུང་གིས་ཆི་ཧོན་ཀུང་ལ་རམ་འདེགས་བྱས་ཏེ་དེས་གནམ་འོག་ཧམ་འཛིན་བྱས་ལ།",
    "དེས་ན་ཀྲོའུ་ཝུན་ཝང་ལའང་རྒྱལ་བོ་བྱེད་རྒྱུ་སླ་མོ་ཞིག་གསུང་འདུག་ལལད་མོ་བྱེད་རིན་མེད་དམ།",
    "ཆི་ཙིཅའོ་ཀོ་སོགས་སྤྱོད་ཡོན་གཉིས་ལྡན་གྱིས་རམ་འདེགས་བྱས་པས་དུས་རིང་བོ་ཞིག་འགོར་རྗེས་ད་གཟོད་གནམ་འོག་ཤོར་བ་རེད།",
    "ཡིན་ནའང་ཀྲོའུ་ཝུན་ཝང་གིས་འཕྲེད་གཞུང་སྤྱི་ལེ་བརྒྱ་ལས་མེད་པས་དར་རྒྱས་སུ་གཏོང་བ་ནི་ཤིན་ཏུ་དཀའ་མོ་རེད་དོ།",
    "མངའ་ཁོངས་དེ་བས་རྒྱ་སྐྱེད་མི་དགོས་ལ་མི་སེར་ཡང་དེ་ལས་མང་མི་དགོས་པས་བྱམས་སྐྱོང་གི་ཆབ་སྲིད་སྤེལ་ན་སུས་ཀྱང་བཀག་འགོག་མི་ཐུབ་བོ།",
    "བྱམས་སྐྱོང་གི་ཆབ་སྲིད་ཁྱབ་གདལ་དུ་སོང་ན་འཕྲིན་གཏོང་ས་ཚུགས་ནས་སྲིད་འཛིན་བཀའ་ཡིག་བསྒྲགས་པ་ལས་མགྱོགས་སོ།",
    "རྒྱལ་ཕྲན་རྒྱལ་བོ་ལ་འཇིགས་སྐྲག་སྤུ་ཙམ་ཡང་མི་སྐྱེས་ལ་ཚུར་གཤེ་བ་ཐོས་ཚེ་ཕར་རྒོལ་ལན་སྤྲོད་ངེས་རེད་དོ།",
    "བདག་གིས་དེ་ལྟར་ག་ལ་ཐུབ།",
    "མི་དེ་གཉིས་ཀྱི་དཔའ་ངར་དེ་གང་ཕུལ་དུ་བྱུང་བ་མི་ཤེས་མོད།",
    "ཁྱོད་རང་དཔའ་ངར་ལ་དགའ་འམ།",
    "སུང་རྒྱལ་གྱི་མི་ཞིག་གིས་མྱུ་གུ་མི་སྐྱེ་བར་སེམས་ཁྲལ་བྱས་ཏེ་མྱུ་གུ་ཡར་དབལ་ནས་ངལ་དུབ་ཆེན་པོར་ཕྱིར་ལོག་ནས་ཡུལ་མི་ལ་སྨྲས་པ།",
    "དེའི་བུ་མྱུར་དུ་སོང་ནས་བལྟས་ཚེ་མྱུ་གུ་ཚང་མ་རྙིད་སོང་ངོ།",
    "རང་འགུལ་གྱིས་རམ་འདེགས་བྱེད་པ་ནི་མྱུ་གུ་བལ་བའི་མི་བཞིན་བཟང་ས་མེད་པར་མ་ཟད་གནོད་པ་ཅན་ཏུ་འགྱུར་ངེས་རེད།",
    "ཐལ་བའི་ཚིག་ལ་བདག་གིས་དེ་ལ་ཨུ་ཚུགས་ཡོད་པ་ཤེས།",
    "གལ་ཏེ་སྐྱེས་བུ་དམ་པ་ཞིག་སླར་བྱོན་ན་བདག་གི་གཏམ་འདི་ལ་ཡིད་འཐད་འབྱུང་ངེས་སོ།",
    "བདག་ནི་ངག་གི་སྨྲ་བ་ལ་དེ་འདྲའི་མཁས་པ་མིན་ཞེས་སོ།",
    "དེས་ན་སྐུ་ཞབས་ཁྱེད་ནི་སྔར་ནས་སྐྱེས་བུ་དམ་པ་རེད་ཨང་།",
    "རེ་ཞིག་བརྗོད་པར་མི་བྱའོ།",
    "རང་གི་འདུན་པ་དང་མི་མཐུན་པའི་མི་སེར་བཀོལ་སྤྱོད་མི་བྱེད་དོ།",
    "ཡུན་རིང་དུ་བསྡད་འོས་ན་ཡུན་རིང་དུ་འདུག་པ་དང་མྱུར་དུ་འགྲོ་འོས་ན་མྱུར་དུ་འགྲོ་བ་ནི་ཁུང་ཙིའི་སྤྱོད་པ་རེད་ཨང་འདི་རྣམས་ནི་གནའ་བོའི་འཕགས་པ་རེད་ལ་བདག་གིས་དེ་ལྟར་བྱེད་མི་ཐུབ་བོ།",
    "ཙིཀུང་གིས་སྨྲས་པ།",
    "ཧ་རི་ཧ་རི་ཕོ་མོ་དང་རི་དྭགས་ཁྱུང་ཆེན་དང་བྱ་རིགས།",
    "སུ་ཞིག་གིས་ནི་བདག་ལ་བརྙས་བཅོས་བྱེད།",
    "སྙན་ངག་འདི་འབྲི་མཁན་གྱི་གནས་ལུགས་རྟོགས་སོང་བ་ལ།",
    "སྒྱིད་ལུག་དང་རྩེད་འཇོ་རོལ་ན་ཆག་སྒོ་རང་གིས་ཉོས་བ་རེད།",
    "བདེ་སྐྱིད་དང་ཆག་སྒོ་རང་གིས་མ་བཙལ་བ་གཅིག་ཀྱང་མེད་དོ།",
    "དེ་ནི་ཧྲང་ཧྲུའུ་ཞེས་པའི་དེབ་ནང་དུ་གནམ་ལས་བྱུང་བའི་ཆག་སྒོ་ལ་གཡོལ་རྒྱུ་ཡོད་ལ་རང་གིས་རྐྱེན་ལས་བྱུང་བའི་ཆག་སྒོ་ལ་གཡོལ་ཐབས་མེད་དོ་ཅེས་པ་དེའི་དོན་རེད་དོ།",
    "བུ་རྒྱུད་ཀྱིས་དམག་ཕུད་ནས་རང་གི་ཕ་མ་ལ་དཔུང་འཇུག་བྱེད་པ་ནི་མིའི་རིགས་ཆགས་ནས་བཟུང་ད་ལྟའི་བར་འགྲུབ་མ་མྱོང་ངོ།",
    "དེ་བཞིན་གྱི་མི་གནམ་འོག་གི་རྒྱལ་བོར་གྱུར་མི་ཐུབ་པ་ནི་སྔ་མོ་ནས་ཡོད་མ་མྱོང་ངོ།",
    "མི་རེ་རེ་ལ་གཞན་གྱིས་སྡུག་བསྔལ་མྱང་བར་མི་བཟོད་པའི་སེམས་ཡོད་དོ།",
    "མེང་ཙིས་གདུང་སེམས་སྐྱེ་བ་ནི་བྱམས་སྐྱོང་གི་གཞི་རྩ་ཡིན་པས་དེ་ཁྱབ་གདལ་དང་འཐུས་ཚང་དུ་གཏོང་དགོས་པར་བཞེད་དོ།་",
    "བྱམས་བརྩེ་ནི་གནམ་གྱིས་གནང་བའི་ཆེས་བླ་ན་མེད་པའི་གོ་གནས་དང་མི་ལ་མངའ་བའི་གཏན་འཇགས་ཀྱི་སྡོད་གནས་ཞིག་ཀྱང་རེད་དོ།",
    "མདའ་མོ་གཞོག་མཁན་གྱིས་མདའ་གཞོག་ན་ངོ་ཚ་བ་བཞིན་ནོ།",
    "བྱམས་སྤྱོད་སྤེལ་མཁན་ནི་མདའ་རྩལ་འགྲན་མཁན་དང་མཚུངས་བར་མདའ་བས་རང་གིས་འཕེན་སྟངས་ལེགས་པོར་བཅོས་རྗེས་ད་གཟོད་མདའ་འཕེན་པ་དང་།",
    "གལ་ཏེ་འབེན་ལ་། མེང་ཅི་ཕོགས་མེད་ཚེ་རང་ལས་རྒྱལ་བའི་མི་ལ་འཁང་ར་མི་བྱེད་པར་རང་གི་ལུས་སྟེང་ནས་རྒྱུ་རྐྱེན་འཚོལ་བའོ།",
    "ཙིལོའུ་ཡིས་མི་གཞན་གྱིས་རང་གི་སྐྱོན་བརྗོད་པ་ཐོས་ཚེ་ཡིད་ལ་སྤྲོ་བ་འཕེལ་ལོ།",
    "གཞན་གྱི་ལེགས་ཆ་བླངས་ཏེ་རང་གིས་བྱམས་པ་སྤྱོད་པར་དགའ་བའོ།",
    "པའོ་དབྱི་ནི་རང་གི་བློ་ལ་བབས་པའི་རྒྱལ་བོ་མིན་ན་དེའི་དོན་མི་སྒྲུབ་ལ།",
    "རང་གི་བློ་བབས་པའི་གྲོགས་པོ་མེད་ན་འགྲོགས་འདྲིས་མི་བྱེད་དོ།",
    "པའོ་དབྱི་དང་ལོའུ་ཞི་ཧུའེ་གཉིས་ཀྱི་སྤྱོད་པ་ཕྱོགས་རེ་བ་གླེང་ནས་སྐྱེས་བུ་དམ་པས་དབུས་འཛིན་པ་བྱེད་དགོས་པར་བཞེད་དོ།",
    "ཁྲབ་རྨོག་མཚོན་ཆ་མི་རྣོ་བ་དང་མི་མཁྲེགས་པ་མ་ཡིན་ལ་བཟའ་འབྲུ་མི་ལྡང་བའང་མིན་མོད།",
    "ལམ་དྲང་མོ་ལས་ལོག་པའི་རྗེ་བོ་ལ་རམ་འདེགས་ཞུ་མཁན་ཉུང་ངོ།",
    "སྡོང་གྲོགས་བྱེད་མཁན་ཉུང་མཐར་རང་གི་གཉེན་ཉེའང་རྒྱབ་འགལ་དུ་འགྲོ་ལ་སྡོང་གྲོགས་བྱེད་མཁན་མང་མཐར་གནམ་འོག་ཀྱང་དེའི་མངའ་འོག་ཏུ་འདུ་བའོ།",
    "གནམ་འོག་མངའ་འོག་ཏུ་འདུ་བ་ཞིག་གིས་། མེང་ཙི་གཉེན་ཉེའང་རྒྱབ་འགལ་དུ་འགྲོ་བ་ཞིག་ལ་རྒོལ་རྡུང་བྱས་ཚེ།",
    "བདག་གིས་སྔར་ཁྱེད་མཇལ་བར་འོང་བསམ་མོད།",
    "མྱ་ངན་ཞུ་བར་སོང་ན་སྟབས་བདེ་མོ་ཡོད་དམ།",
    "དེ་རིང་སྙུན་གཞི་ཅུང་དྲག་པས་མྱུར་དུ་རྒྱལ་པོའི་ཚོམས་ཆེན་དུ་བཅར་བར་སོང་བས་ད་ལྟ་ཐོན་ཡོད་མེད་བདག་གིས་མ་རྟོགས་སོ།",
    "ནི་མི་དང་མིའི་བར་གྱི་ཆེས་གལ་ཆེ་བའི་འབྲེལ་བ་རེད།",
    "བདག་གིས་རྒྱལ་བོས་ཁྱེད་ལ་བརྩི་བཀུར་བྱེད་པ་མཐོང་ཡང་ཁྱེད་ཀྱིས་རྒྱལ་བོར་བསྙེན་བཀུར་བྱེད་པ་མ་མཐོང་ངོ།",
    "སྐད་ཆ་དེ་ཅི་འདྲ་ཞིག་རེད་ཨང་།",
    "གནམ་འོག་ཏུ་ཐམས་དེ་ལའང་གནས་ལུགས་གཞན་ཞིག་ཡོད་རྒྱུ་རེད་ལ།",
    "གཤིས་སྤྱོད་བཅས་རེད།",
    "རྗེ་བོ་རང་ལ་མཛད་རྗེས་ཆེན་པོ་ཡོད་པར་འདོད་ན་དེས་འབོད་ན་མི་འོང་བའི་བློན་པོ་ངེས་པར་ཡོད་པ་དང་དོན་ཆེན་རེ་གྲོས་མོལ་བྱེད་རྒྱུ་ཡོད་ཚེ་དེའི་མདུན་དུ་བཅར་ནས་བཀའ་འདྲི་ཞུ་བའོ།",
    "ཆི་ཧོན་ཀུང་གིས་ཀོན་ཀྲུང་ལའང་ཐོག་མར་དེ་ལ་སློབ་སྦྱོང་དང་རྗེས་སུ་བློན་པོར་བསྐོས་པས་གནམ་འོག་བཙན་ཤེད་ཀྱིས་བཟུང་བ་ལའང་ནུས་ཤུགས་འདོན་མ་དགོས་སོ།",
    "སྐུ་ཞབས་ཁྱེད་ཉིད་དེ་གཉིས་ལས་ཅིག་ཤོས་ངེས་པར་ཡིན་རྒྱུ་རེད་ཅེས་སོ།",
    "ཚང་མ་འགྲིག་སོང་བ་རེད་དོ།",
    "དེ་བདག་གིས་ཅི་ཕྱིར་མི་ལེན།",
    "༤ ༤ མེང་ཙི་ཕིང་ལུའུ་ཟེར་བའི་ས་ཆར་སླེབས་ནས་ཏ་སྤུ་ཁུང་ཅུས་གལ་ཏེ་ཁྱོད་ཀྱི་དམག་མིས་ཉིན་གཅིག་ལ་ཐེངས་གསུམ་ཞིན་ལ་འདྲི་རྒྱུར།",
    "དཔེར་ན་མི་ཞིག་གིས་གཞན་གྱི་ཚབ་བྱས་ཏེ་ནོར་ལུག་འཚོ་བ་ན་མི་དེས་ངེས་པར་དུ་ནོར་ལུག་ལ་རྩྭ་ས་དང་གཟན་རྩྭ་འཚོལ་དགོས་པ་རེད།",
    "གལ་ཏེ་རྩྭ་ར་དང་གཟན་རྩྭ་མ་ལོན་ཚེ་ནོར་ལུག་དེ་བདག་པོ་ལ་སྤྲོད་རྒྱུ་རེད་དམ་ཡང་ན་དེ་ནས་ཡར་ལངས་ཏེ་ནོར་ལུག་ལྟོག་གྲིར་ཤི་བར་བལྟས་ནས་འདུག་གམ།",
    "འདི་ནི་བདག་གི་ཉེས་པ་རེད་དོ།",
    "རང་གི་ཉེས་པ་ཡིན་པ་ཤེས་མཁན་ནི་ཁུང་ཅུས་ཞིན་གཅིག་པུ་རེད་ཅེས་སྔར་གྱི་དྲི་བ་དྲིས་ལན་སླར་ཡང་ཚར་གཅིག་ཞུས་སོ།",
    "འདི་ནི་བདག་གི་ཉེས་པ་རེད་ལགས།",
    "དེས་རྒྱལ་པོ་ལ་དྲན་འཆར་ད་ལྟ་ཟླ་ཤས་འགོར་སོང་ཡང་ད་དུང་དྲན་འཆར་གླེང་གླེང་ཆོག་པས་སོ།",
    "མེང་ཕྱིས་ཁྲི་ཝ་ལ་བསམ་བློ་ལེགས་པོ་བཏང་ཡོད་ནའང་ཁོང་རང་ཉིད་ལ་བསམ་བློ་ཇི་ལྟར་བཏང་བ་བདག་གིས་མི་ཤེས་སོ།",
    "ཁོས་དོན་དག་ཚང་མ་བསྒྲུབ་ཟིན་པས་བདག་གིས་ཅི་ཞིག་གླེང་།",
    "མེང་ས་ཝང་ཧོན་གྱི་སྒེར་གཅོད་བྱེད་སྟངས་ལ་མཐོང་ཆུང་གི་ལྟ་ཚུལ་བཟུང་བའོ།",
    "ཉིན་ཤས་ཀྱི་སྔོན་དུ་ཁྱེད་ཀྱིས་ཕྲན་ལ་འཇོན་ཐང་མེད་པ་མ་རྟོགས་ཏེ་མ་ཡུམ་གྱི་པུར་སྒམ་བཟོ་བའི་ལྟ་ཞིབ་དོ་དམ་བྱེད་པར་མངགས་མོད།",
    "བདག་གིས་འདི་ལྟར་ཐོས་ཏེ།",
    "སྐྱེས་བུ་དམ་པས་ཕ་མའི་འདས་མཆོད་ལ་གནམ་འོག་གི་རྒྱུ་ནོར་ལ་གྲོན་ཆུང་བྱེད་མི་དགོས་ཞེས་སོ།",
    "༤ ༨ ཧྲེན་ཐུང་གིས་མི་སྒེར་གྱི་མིང་གིས་འདྲི་རྒྱུར།",
    "སོང་ནས་འདུལ་ན་ཆོག་གོ་ཞེས་ལན་སྨྲའོ།",
    "དཔེར་ན་མི་གསོད་པའི་ཉེས་ཅན་འདི་བསད་ན་ཆོག་གམ་ཞེས་གཞན་ཞིག་གིས་དྲིས་ན།",
    "གལ་ཏེ་མི་ཞིག་གིས་སླར་ཡང་འདྲི་རྒྱུར།",
    "ཀྲོའུ་ཀུང་ནི་མི་ག་འདྲ་ཞིག་རེད་དམ།",
    "གནའ་བོའི་འཕགས་པ་ཞིག་རེད་དོ།",
    "ཀྲོའུ་ཀུང་གིས་དེས་ཟིང་འཁྲུག་བསླང་རྒྱུ་ཡིན་པ་ཤེས་ནས་མངགས་པ་རེད་དམ།",
    "མ་རེད་དོ།",
    "ཀྲོའུ་ཀུང་ལ་ནོར་འཆུགས་ཡོད་ནའང་འོས་པ་ཞིག་མ་རེད་དམ།",
    "གནའ་མིའི་ནོར་འཆུགས་ད་ལྟའི་མི་ཡིས་རང་གི་ཉེས་པ་འགེབས་པའི་ཁ་གཡར་ས་བྱས་ན་ཅི་ལ་རུང་།",
    "བདག་གིས་རེ་བ་འདོན་ག་ལ་ཕོད།",
    "འདི་ནི་སྔར་ནས་བདག་གི་རེ་སྨོན་འཆའ་བ་བཞིན་ནོ།",
    "རེད་དོ།",
    "དེ་ནི་ཕྱུག་པོར་གྱུར་འདོད་པ་རེད་དམ།",
    "ཚོང་བ་ལ་ཁྲལ་བསྡུ་བ་ནི་སྐྱེས་བུ་ཐ་ཤལ་བ་དེ་ནས་འགོ་བཟུང་བ་རེད་དོ།",
    "ཁྱོད་ཙོག་པུར་སྡོད་དང་བདག་གིས་ཁྱོད་ལ་གསལ་བོ་སྨྲའོ།",
    "ལེ་དབར་སྟོང་ཕྲག་མང་པོ་བརྒལ་ནས་ཆི་རྒྱལ་མཇལ་བར་འོང་བ་དང་བསམ་འཆར་མི་མཐུན་ཚེ་དེ་ལས་གྱེས་ཏེ་ཀྲོའུ་ཞན་དུ་ཞག་གསུམ་ལ་བསྡད་དེ་ད་གཟོད་དལ་མོར་བྱས་ཏེ་བྲལ་འགྲོ་བ་ནི་ཅི་ཡི་ཕྱིར།",
    "བདག་གིས་དོན་དེ་ནི་སེམས་ལ་ཧ་ཅང་བབ་མ་བྱུང་ངོ།",
    "དབྱིན་ཧྲི་ཟེར་བ་དེས་བདག་གིས་བསམ་པ་ཇི་ལྟར་རྟོགས་སམ།",
    "ལེ་དབར་སྟོང་ཕྲག་བརྒལ་ནས་ཆི་རྒྱལ་མཇལ་བར་འོང་བ་ནི་བདག་གི་རེ་སྨོན་རེད་ལ།",
    "གནམ་འོག་གི་མི་སེར་རྣམས་ལྷིང་འཇགས་སུ་འགྲོའོ།",
    "མ་རེ་རེ་བཞིན་རེ་སྒུག་བྱས་པའོ།",
    "བདག་ནི་ཅི་འདྲའི་མི་ཐ་ཤལ་བ་ཞིག་རེད་ཨང་།",
    "མེང་ཅིས་རང་ཉིད་གནམ་འོག་གི་རྒྱལ་ཁབ་སྐྱོང་བའི་བྱ་བར་ཞུགས་འདོད་པའི་བསམ་པ་མཚོན་པའོ།",
    "སྐུ་ཞབས་ཁྱོད་ལ་མི་དགྱེས་པའི་རྣམ་པ་ཞིག་ཡོད་པ་མ་ཡིན་ནམ།",
    "བདག་གིས་སྔར་ཁྱེད་ཀྱིས་གསུང་བའི་གཏམ་འདི་འདྲ་ཐོས་བྱུང་།",
    "དེ་ལ་རམ་འདེགས་བྱེད་པའི་མཛངས་བློན་ཞིག་ཀྱང་འབྱོན་ངེས་རེད།",
    "ཀྲོའུ་རྒྱལ་རབས་ནས་བཟུང་ད་ལྟའི་བར་དུ་ལོ་བདུན་བརྒྱ་འགོར་སོང་བས་ལོ་ལྟར་རྩིས་ན་བརྒལ་སོང་བ་རེད་ལ་དུས་བབ་ལ་གཞིག་ནའང་འཕགས་རྒྱལ་དང་མཛངས་བློན་འབྱོན་པའི་སྐབས་ལ་སླེབས་སོ།",
    "གལ་ཏེ་གནམ་འོག་བདེ་བར་འཇུག་འདོད་ན་དེ་རིང་གི་དུས་སྐབས་འདིར་བདག་ལས་གཞན་པ་སུ་ཡོད་དམ།",
    "དཔོན་པོར་བསྡད་དེ་ཕོགས་ཐོབ་མི་ལེན་པ་ནི་གནའ་དུས་ཀྱི་ལས་ཚུལ་རེད་དམ།",
