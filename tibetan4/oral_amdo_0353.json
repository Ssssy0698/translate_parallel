    "དེ་དག་གི་རྟགས་སྦྱོར་འགོད་ཚུལ་ནི།",
    "རང་གི་བདག་རྐྱེན་དང་དེ་མ་ཐག་རྐྱེན་ལས་གཞན་པའི་རང་གི་རྐྱེན་ཡོད་དེ།",
    "རང་གི་བདག་རྐྱེན་དང་དེ་མ་ཐག་རྐྱེན་ཚང་བ་ཙམ་གྱིས་མི་སྐྱེ་ཞིང་རེས་འགའ་སྐྱེ་བའི་ཕྱིར་ཞེས་པ་ལྟ་བུ་གསུམ་པ་དང་།",
    "རེས་འགའ་སྐྱེ་བའི་རྟགས་ལས་ཉེར་ལེན་གྱི་ཕུང་པོ་རང་རྒྱུ་དང་བཅས་པ་སྒྲུབ་པ་ལྟ་བུ་བཞི་པ་དང་།",
    "ཞེས་སོགས་ཀྱིས་ཚེ་འདིའི་རིག་པ་རིག་པ་སྔ་མ་སྔོན་དུ་སོང་བར་སྒྲུབ་པ་དང་།",
    "ཅེས་སོགས་ཀྱིས་ལུགས་ལྡོག་གི་སྐབས་སུ་སྐྱོབ་པའི་རྟགས་ལས་བདེ་གཤེགས་སྔོན་སོང་དེ་ལས་སྟོན་པ་དང་དེ་ལས་ཐུགས་རྗེ་ཆེན་པོ་སྔོན་སོང་དུ་སྒྲུབ་པའི་ཚུལ་བསྟན་པས་རྒྱུ་སྔོན་སོང་ཉིད་འབྲས་རྟགས་བསྟན།",
    "རེས་འགའ་བ་ཉིད་ཡིན་པས་ན།",
    "དུ་བས་བུད་ཤིང་འགྱུར་བ་བཞིན།",
    "ཞེས་སོགས་སྦྱོར་མཐོང་སྒོམ་གསུམ་གྱི་ཕྱིར་མི་ལྡོག་པའི་རྟཊ་འཆད་པ་ན་ལུས་ངག་གི་ཐ་སྙད་ལས་སེམས་དཔའི་རྒྱུད་ཀྱི་ཐབས་ཤེས་ཁྱད་པར་ཅན་དཔོག་པར་གསུངས་པ་སོགས་མཐའ་ཡས་སོ།",
    "རྒྱུ་ལ་རང་བཞིན་ཞེས་སོགས་ཀྱི་རྩ་བའི་གཞུང་གཉིས་ཀས་ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བའི་འབྲས་རྟགས་མཐའ་ཡས་པ་བསྟན་པ་རྣམས་རྟགས་སམ་མཚན་མའི་སྒོ་ནས་བརྟགས་ཚུལ་ཤིན་ཏུ་མང་བའི་ཕྱིར་ཏེ།",
    "སེར་སྣ་དང་བྲལ་བ་སོགས་དེ་འདྲའི་ལུས་ངག་གི་ཐ་སྙད་ཁྱད་པར་བས་སྐྱེས་བུ་ཕ་རོལ་པོ་དད་ཅན་དུ་སྒྲུབ་པ་ལྟ་བུ་ཡིན་པའི་ཕྱིར།",
    "ཁྱད་པར་ཀུན་ཉོན་གྱི་སྐྱེ་རིམ་དང་དེ་ཟློག་བྱེད་རྣམ་བྱང་གི་རྒྱུ་རྐྱེན་ལ་མཁས་པ་དང་།",
    "བྱས་པ་རང་གི་རང་བཞིན་ཡོད་ཙམ་དང་རང་ཆས་སུ་རྗེས་སུ་འབྲེལ་བ་ཅན་གྱི་རང་དང་ངོ་བོ་གཅིག་པའི་མི་རྟག་པ་སྒྲའི་སྟེང་དུ་གོ་བར་བྱེད་པའི་རང་བཞིན་གྱི་གཏན་ཚིགས་ཞེས་པའོ།",
    "བྱས་རྟགས་ཀྱིས་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་རང་བཞིན་གྱི་རྟགས་ཡང་དག་གི་མཚན་ཉིད་དུ་གསུངས་པ་ལྟར་གཞན་ལའང་རིཊ་འགྲེའོ།",
    "ཞེས་འབྲས་རང་གི་རྟགས་གཉིས་པོ་སྒྲུབ་རྟགས་ཡང་དག་དང་།",
    "གྲང་རེག་གིས་སྟོང་པའི་མེ་ཡོད་དེ།",
    "ཕྱིར་རྒོལ་གྱི་ཤེས་འདོད་རྒོལ་བས་དཔག་འདོད་གྲང་རེག་གིས་སྟོང་པ་ལ་གཙོ་བོར་ཞུགས་ན་མེ་ཡོད་སྦྱོར་ཚུལ་ཙམ་ཡིན་གྱི་དོན་དགག་རྟགས་སུ་འགྱུར་བས་སོ།",
    "གྲང་རེག་གིས་སྟོང་པ་སྦྱོར་བ་སྦྱོར་ཚུལ་ཙམ་དུ་ཟད་དོ།"
  ]
}