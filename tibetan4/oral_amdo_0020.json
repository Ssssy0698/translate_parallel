    "ལྷ་མོ་རྣམས་ཀྱི་མཚན་མ་བཏབ་པ།",
    "དེ་ལ་ཧཱུཾ་ཡིག་ལན་བདུན་བརྗོད་ཅིང་བཅིང་བའི་སྐུད་པ་དཀར་པོ་བདུན་གྱིས་དཀྲི་བར་བྱ་བ་ནི་ཨོ་བཛྲཤེ་ཁ་རེ་རུཊ་མཊ་དིཤཱཾ་བནྡྷ་བནྡྷ་ཧཱུ་ཞེས་པའི་སྔགསཀྱིསསོ།",
    "བུམ་པའི་ནང་རྣམས་སུ་ཨོ་མ་ཏ་ཀྵེ་མ་ཧཱ་ཏསྟེ་སྭཱ་ཧཱ་ཞེས་པས་སྤྱན་དྲངས་པས་ཆུའི་རང་བཞིན་ལསག་དན་དང་བཅས་པའི་ལྷ་མོའི་འཁོར་ལོ་རྣམས་སྐད་ཅིག་གིས་རྣམ་པར་བསྒོམས་ལ།",
    "མཚན་མོ་ལ་ཡང་དམ་ཚིག་གི་ལྷ་མོ་རྣམས་ཡེ་ཤེས་ཀྱི་ལྷ་མོ་རྣམས་དང་རོག་ཅིག་ཏུ་གྱུར་པར་བསམ་མོ།",
    "དེནས་ཧཱུཾ་ཞེས་བརྗོད་ཅིང་རྡོ་རྗེ་མེ་ཏོག་དང་བཅས་པ་གཡས་པས་གཟུང་ལ་འཁོར་ལོའི་གཙོ་མོའི་སྙིད་པོའི་སྔགས་བརྒྱ་རྩ་བརྒྱད་བཟླས་པའམ་ཨོ་བཛྲ་ཨུདཀ་ཧཱུྃ་ཞེས་པ་བཟླས་པའོ།",
    "དེ་རྣམས་ཡང་དག་པར་མཆོད་ནས་ལས་ཐམས་ཅད་པའི་བུམ་པའི་ཆུ་ཡིས་ཤིང་ལོས་བསྲུང་བའི་དོན་དུ་བསང་གཏོར་བྱས་པ་དང་ཇི་སྲིད་དཀྱིལ་འཁོར་གྱི་བྱ་བ་མ་རྫོགས་ཀྱ་བར་དུབེགགས་རྣམས་བསྲུང་བ་གྱིས་ཤིག་ཅེས་བརྗོད་ནས་གཏོར་མ་བྱིན་ལ་རེག་ལ།",
    "དེ་ནས་གསུངས་པའི་རྒྱན་རྣམས་ཀྱིས་བརྒྱན་པ་དེས་དྲི་དང་མེ་ཏོག་གིས་ལྷ་འགྲེལ་གནས་བཀོད་ལ།",
    "བཅོམ་ལྡན་རྡོརྗེ་ཕག་མོ་ཉིད།",
    "ལྷ་མོ་རྣམསཀྱི་ཐུགས་རྗེ་ཡིས།",
    "རྡོ་རྗེ་ཕག་མོའི་དཀྱིལ་འཁོར་ནི།",
    "བཅོམ་ལྡན་འདས་བདེ་མཆོག་དང་རྡོ་རྗེ་རྣལ་འབྱོར་མ་མཉེས་པརབྱེད་པསམཎྜལསྔོན་དུ་སོང་བ་དང་།",
    "དཔའ་བོ་དཔའ་མོའི་དབར་ཕྱུག་མ།",
    "བྱེ་བྲག་གི་སྡོམ་པ་འཛིན་དུགཞུག་པ་ནི།",
    "བདག་གིས་བརྟན་པར་བཟུང་བར་བགྱི།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "དེ་ནས་མཎྜལ་གྲུ་བཞིཔ་ཕྱོགས་རེ་ལ་ཁུ་རེ་དང་ལྡནཔ་ལ།",
    "ཨོཾ་བཛྲ་ཧ་ས་ཧཾ་ཞེས་བརྗོད་དེ་རྩེ་མོ་བླང་ནས་སྟེང་དུ་བལྟོས་པ་མེད་པར་དོར་ལ།",
    "ཀ་༥ མཎྜལ་གྱི་ཕྱི་རོལ་དུ་སོང་ན་དངོས་གྲུབ་མེད་དོ་ཞེས་བརྗོད་ལ།",
    "ཨོཾ་ཧྲཱི་བེཤུདྡྷ་དྷརྨ་སརྦ་པཱ་པན་ཅྀསྱ་ཤོ་དྷ་ཡ་སརྦ་བིཀཝཱནཨ་པ་ནཡཧཱུྃ་ཞེས་པ་ལན་གསུམ་དུ་བརྗོད་ཅིང་ཁྱོར་བར་བྱིན་ཏེ་འཐུད་དུ་གཞུག་གོ།",
    "ཨོབུདྡྷ་མེ་ཏྲིརཏྣ་སདྡཱན་སྭཱཧཱ་ཞེས་པ་བརྗོད་ཅིད་བཅིདས་པས་སོ།",
    "བཅོམ་ལྡན་འདས་མའི་སྔགས་ལན་བདུན་བཟླས་ཏེ་མེ་ཏོག་གི་ཐོད་བྱའོ།",
    "ངན་སོང་སྐྱེ་བ་འཇོམས་པར་འགྱུར།",
    "དེ་ནས་ཕྱག་རྒྱ་དྲུག་གིས་རྒྱས་བཏབ་ལ་བཅོམ་ལྡན་འདས་མའི་རྣལ་འབྱོད་དང་ལྡན་པས་ལྷག་པར་གནས་པར་བྱ་བའི་དཀྱིལ་འཁོར་གྱི་ལྷ་མོ་རྣམས་ཡེཤེགས་ཀྱི་ཐིག་གི་དོན་དུ་ནམ་མཁའ་ལ་བཏེག་ལ་ཤར་དུ་ཁ་ཕྱོགས་པས་མཚན་མ་དེ་ད་པ་དང་།",
    "མེཏོག་གིས་བརླན་པའི་ཤི་བའི་སྐུད་པ་འམ།",
    "དཔའ་བོལ་ཉོས་པ་གཞོན་ནུ་མས་བཀལ་བ་ཇི་ལྟ་བ་བཞིན་ཚགིས་མཁའ་འགྲོ་མལ་སོགས་པ་མེས་པ་བྱས་ནས།",
    "ཡུངས་ཀར་གྱི་བྱེ་མདང་བདུད་རྩི་ལྔའི་སྦགསཔ་དང་ལག་པགཡོན་པའི་མཐིལ་ནས་སོར་མོའི་རྩེ་མོའི་བར་དུབཀྲམ་ལ།",
    "ཨོཾ་དཱ་པཱ་དྲྀཡིཨཾ་ཀུ་ཤཛ་ཞེས་པ་བརྗོད་པ་དེ་རབ་ཏུ་གཡོ་བའི་མིག་གི་སྡིམ་ལའོད་ཟེར་ལྕགས་ཀྱུའི་རྣམ་པ་སྤྲོས་པས་མཁའ་འགྲོམ་ལ་སོགས་པ་བསྐུལ་ནས་སྤྱན་དྲངས་འགྲལཏེ་ལག་པ་ལ་གནས་པའི་རང་རང་གི་ཁ་དོག་དང་ལྡན་པའི་སྐུད་པ་ལབསྐྱིམ་མོ།",
    "བྱད་ཕྱོགས་སུ་ལྟེ་བར་མཚུངས་པ་ནམ་མཁའི་ཐིག་གདབ་པ་ནི་བྱར་དང་ཤར་དུ་བསྡད་པ་ལག་པ་གཡས་པ་རྡོ་རྗེ་དང་བཅས་པ་མཐེབོངདད་གུང་མོས་སེ་གོལ་གཏོག་ཅིད་པས་སོ།",
    "ཨོ་བཛྲས་མཡ་སཱུཏྲཾ་མ་ཏི་ཀྲ་མ་ཧཱུྃ་ཧཱུྃ་ཨོཾ་ཏྲ་ཨཱ་ཞེས་བརྗོད་ཅིང་བཏབ་པས་དེའི་སྒྲ་ཡིས་ད་པའ་བོ་མདང་དཔའ་མོ་རྣམས་ཀྱིས་ནམ་མཁའི་ཁམསགང་ནས་སྐད་པ་ལ་ཐིམ་པར་བསམ་མོ།",
    "ཚངས་པའི་ཐིག་གི་ཕྱི་རོལགྱི་གཡས་དང་གཡོན་དུ་ཆ་གཉིས་ད་ང་གཅིག་དང་གཉིས་གཅིག་དང་གཅིག་སྤངས་པ་ངེས་པར་སྒོ་ཁྱུད་ཀྱི་ནང་དང་ཕྱི་རོལ་རྒྱུད་།",
    "དེ་ནས་དབུས་སུ་སྐུད་པ་བཏགས་ལ་རྩ་བའི་ཐིག་ནས་ཚངས་པའིཐག་གི་བར་དུ།",
    "རྩ་བའི་ཐིག་གི་རྒྱབ་ནས་ཆག་ཅིག་དང་གཉིས་དང་གཅིག་དང་གཉིས་དང་གཅིག་པ་གཅིག་དང་དྲག་རྒྱ་རྣམས་ཀྱིས་བསྐོར་བ་ལ།",
    "ལྟ་བབསཀྱི་ཀ་བའི་སྟེང་གི་ཆུ་སྲིན་གྱི་ཁ་ནས་དར་དཔྱངསལ་སོགས་པ་ཇི་ལྟར་མཛེས་པར་བྱའོ།",
    "སྣུམབུཐམས་ཅད་ཀྱི་ཕྱི་དང་ནང་རྣམས་ཕྱིར་བྱུང་བ་དང་ནང་དུ་སོང་བའི་དབྱེ་བས་ཐིག་རེ་རེའོ།",
    "རེ་ཁཱ་གཞན་ཡང་རང་གིས་བརྟགས་ལ་དབྱེ་བར་བྱའོ།",
    "སྐད་ཅིག་གིས་མཁའ་འགྲོ་མལ་སོགས་པའི་རང་བཞིན་དུ་དམིགས་ལ།",
    "ལྷ་མོ་རྣམས་ཤིན་ཏུ་སྒྲུབ་པའི་སྟོབས་ཀྱིས་སྦར་བའོ།",
    "དབུསཀྱི་སགཞི་དཀར་པོལ་པདྨ་ཕྱོགས་ཀྱི་ཁ་དོག་གིས་སོ།",
    "རྟ་བབས་རྩེག་གི་ཀ་བགླང་པོ་ཆེའི་སྟེད་དུ་སེང་གེསམནན་པའོ། འདོད་ཡོན་ལ་སོགས་པ་ཇི་ལྟར་མཛེས་པའོ།",
    "བུ་མོ་དོད་བུདང་གླང་པོ་དང་རྟ་ལ་སོགས་པ་དབུལ་བར་བྱའོ།",
    "ཨོཾ་པྲ་བི་ཤ་བྷ་ག་བཱ་ན་མ་ཧཱ་སུཁཾ་མོཀྵ་བུ་རཾ་སརྦ་སིདྡྷ་སུ་ཁ་པྲ་དཔར་མགུ་ཨུཏྟ་མ་སིདྡྷྰཛ་ཧཱུྃ་བཾ་ཧོ་པྲ་སིདྷྱ་ཨཱུ་ཞེས་བས་གཟེངས་བསྟོད་ལ།",
    "དེ་ནས་རྩེ་མོའི་ཆ་བཟུང་ལ་དེར་འཇུག་པ་ནི་གཡོན་སྐོར་བྱ་ཞིང་ནུབ་སྒོལ་སོགས་པར་བསྡད་ལ་དཀྱིལ་འཁོར་ཀྱི་ཤར་ཕྱོགས་ལ་སོགས་པའི་སྒོ་དབྱེ་བ་ནི།",
    "འདེད་པའི་གཙོ་མོ་དམ་ཆིག་མཆོག།",
    "ཀྱེ་ཧོ་བུ་སྡུག་ཁྱོད་སུ་ཡིན་ཞེས་པས་སློབ་དཔོན་གྱིས་དྲིབར་བྱའོ།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དཔའ་མོ་རྣམས་ཀྱས་བྱིན་གྱིས་བརླབ་ཀྱིས།",
    "བདག་གིས་དྲངས་སོ་བུ་ཉིད་ཀྱི་ཞེས་བརྗོད་ལ་མི།",
    "ནཱ་མོ་ནོམ་ཧཱུཾ་སྭཱཧཱ་ཞེས་པས་ས་སྟེང་ལ་སོགས་པའི་དབྱེ་བས་ཕྱག་ག་སུམ་བྱའོ།",
    "ཨོཾ་སརྦ་བཱི་རཱ་ཡོ་གི་ནི་བྷྱོ་པཱུ་ཛ་ཨུ་པ་སྠཱ་ནཾ་ཡ།",
    "བྱིང་སྒོརུ་ཨོ་སརྦ་བཱི་ར་ཡོ་གི་ནཱི་ན་པཱུ་ཛ་ཨ་བྷིཥེཀ་ཨཱ་ཛྙཱ་ནཾ་ནཱི་ར་ཏ་ཡ་མི་སརྦ་ཏ་ཐཱག་ཏ་བཱི་ར་ཡོ་གི་ནཱི་ལཱ་མཱ་རྱ་ཨ་བྷོ་འནྟ་མཱ་ཞེས་བརྗོད་དོ།",
    "ནུབ་སྒོ་རུ་ཨོཾ་སརྦ་བཱི་ར་ཡོ་གིནི་བྷྱོ་པཱུ་ཛ་པྲ་ཝརྟེ་ནཡ་ཨཱཏྨནཾ་ནཱི་རུཏ་ཡམི་སརྦ་ཏཐཱ་ག་ཏ་བཱི་ར་ཡོ་གི་ནྱཁ་ཎྜ་རོ་ཤཱ་རྱ་དྷརྨ་ཙཀྲ་པྲ་ཝརྟ་ཡ་མཱཞེས་བརྗོད་དེ།",
    "ལྷོ་སྒོརུ་ཨེ་སརྦ་བཱིར་ཡོགི་ནི་བྷྱོ་པཱུ་ཛཀརྨ་ཎེ་ཨཱཏྠཱནནཱིདྱུཏཡཱསརྦ་ཏ་ཐཱ་ག་ཏི་བཱི་ར་ཡོ་གི་ནྱི་རུ་པི་ཎྱ་རྱ་ཀརྨ་ཀུ་རུ་མཱཞེས་པརྣམས་བརྗོད་ཅིང་གནས་གསུམ་དུ་ཐལ་མོ་སྦྱར་ཏེ་ཕྱག་བྱེད་དུ་གཞུགགོ།",
    "དེང་ནས་བཙམས་ཏེ་ཁྱོད་ཀྱི་རྡོ་རྗེ་རྣལ་འབྱོར་མང་ཡིན་པས།",
    "སརྦ་བཱི་ར་ཡོ་གི་ནྱ་ཤུ་ཨ་ངྷི་ཏི་ལྔ་ཏཾ།",
    "དེ་ནས་བརྗོད་པའི་དཀར་པོལ་སོགས་པའི་ཁ་དོག་གིས་ཞིབ་ལ་སོགས་པའི་རིམ་པར་གོ་བར་བྱའོ།",
    "རེ་ཁཱ་ལྔའི་ནང་དུ་བབས་ན་འདི་ཉིད་ཀྱིརིགས་བརྗོད་པར་བྱ་ཞིང་ལྷ་དེ་དང་དེའི་རྣལ་འབྱོར་སྦྱིན་པར་བྱ་བརང་དངོས་གྲུབ་ཀྱང་བརྟག་པར་བྱའོ།",
    "རེ་ཁཱལྔའི་ཕྱི་རུ་བབས་ན་ལན་གསུམ་གྱི་བར་དུ་སླར་དེར་པར་བྱའོ།",
    "དེ་ལྟར་ན་ཡང་དངོས་གྲུབ་ཕྲ་མོ་ཙམ་མོ།",
    "ཨོ་ཀརྨ་བཛྲ་ཨ་བྷིའིསཞེསཔའི་སྔགས་ལྔས་བྱིན་གྱིས་བརླབ་ཨ་ལ་མགོ་བོར་བཟུང་སྟེ་གེ་དགི་ཚིགས་བཅད་བརྗོད་ལ།",
    "ཐོབ་པ་དེ་བཞིན་ཁྱོད་ཉིད་ཀྱིས།",
    "ཁཾ་དང་རལ་གྲི་ད་ག་ལས་བྱུར་བའི་དོན་ཡོད་གྲུབ་པ་འམ་ལཱ་མའི་གཟུགས་སུ་ཡེ་ཤེས་སེམས་དཔའ་དང་ཐ་མི་དན་པར་སྐད་ཅིག་གིས་བསྐྱེད་དེ།",
    "གོང་གི་ཚིགས་སུ་བཅད་པ་བརྗོད་པ་དང་།",
    "ཨོ་དང་འཁོར་ལོ་ལས་བྱུང་བའི་རྣམ་པར་སྣང་མཛད་དམ་གཙོ་མོའི་གཟུགས་སུ་སྐད་ཅིག་གིས་བསྐྱེད་པའི་ཡེ་ཤེས་སེམས་དཔའ་དང་ཐ་མི་དད་པར་བྱ་སྟེ།",
    "འདི་ནི་རྡོ་རྗེའི་དམ་ཚིག་གི་ཆོ་གའི་རིམ་པའོ།",
    "སྲིད་པ་དམ་པ་བྱེད་པར་འགྱུར་ཞེསཔ་འདི་ནི་དྲིལ་བུའི་དམ་ཚིག་གི་ཆོགའི་རིམ་པའོ།",
    "ོའདི་ནི་ཕྱག་རྒྱའི་དམ་ཚིག་གི་ཆོ་ག་སྟེ་དམ་ཚིག་གསུམ་སྦྱིན་པའི་ཆོ་གའིརམ་པའོ།",
    "དེ་ནས་འཁོར་ལོའི་ལྷ་མོ་རྣམས་དེ་ཉིད་ལས་ཡེ་ཤེས་སེམས་དཔའི་གཟུགས་ཀྱིས་གཞུག་པར་བྱས་ནས།",
    "ཁྱོད་ནི་འདྲེན་པའི་སྤྱན་དར་ལྡན།",
    "འདི་ནི་དཔའ་མོ་ཐམས་ཅད་དང་།",
    "རྡོ་རྗེ་ཕག་མོའི་ཕྱག་མཚན་འདི།",
    "ཨོཾསརྦ་བུདྡྷ་ཌཱ་ཀི་ནཱིཡེཝ་ཎྞནཱིཡེ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "མེ་ཏོག་ལྟང་བའི་སྒོ་ནས་རང་གི་རིགས་ཀྱི་མིང་དང་བཅས་ཏེ་བརྗོད་པ།",
    "ཁྱོད་ཉིད་ཀྱིས་ནི་བཀའ་དྲིན་གྱིས།",
    "ཅེས་པས་གསོལ་བ་གདབ་པར་བྱའོ་ དེ་ནས་སློབ་དཔོན་གྱིས་ལྷ་མོའི་ང་རྒྱལ་སྤངས་ཏེ་བ་དེ་མཆོག་གི་ཆ་ཁྱད་དམ་ཐབ་ས་ཀྱི་ཆ་བྱ་ད་དུ་གནས།",
    "སྙིད་ཀའི་ས་བོན་གྱིས་སྤྱན་དྲངས་པའི་ལྷ་མོ་སོ་སོ་རྣམས་དང་སྙོམས་ཙ་།",
    "ཕྱག་རྒྱ་མ་ལངས་ཏེ་གོས་དང་བྲལ་བར་བྱས་ལ་རང་གི་བརྙན་གནས་པའི་ཊིག་ལེ་ཁར་དབབ་པར་བྱའོ།",
    "ཀྱེ་མབདག་གི་པདྨ་ངོ་མཚར་ཆེ།",
    "བྷཉྫ་མོཀྟ་ཧོ་ཞེས་བརྗོད་པ་དང་།",
    "ཤེས་རབལྷ་མོའི་གཟུགས་སུ་བསྐྱེད།",
    "བྱ་དང་དྱ་ཡི་བུམ་པ་དང་ཟེ་འབྲུ་བྱས་པ་ལ་དེ་དག་གིས་བྱིན་གྱིས་བརླབས་པ་དང་།",
    "གཡོན་གྱིས་གཡོན་ན་གནས་པའི་ཐུ་མཛུབ་མོའི་རྩ་ལ་ཧྲཱི",
    "དེ་ལྟར་ཐུན་མོང་གི་རྗེས་སུ་གནང་བ་བྱིན་ལ།",
    "མཆོག་བཞིན་དཀྱིལ་འཁོར་ཁྱོད་ཉིད་ཀྱིས།",
    "རྗེ་བོར་ཁྱོད་ཉིད་དེས་པའོ།",
    "ཁྱོད་ལ་སྡིག་མེད་འཇིགས་མིདགོས།",
    "མཉམ་པར་མིའགྱུར་བརུ་ཁྱོད་རྣམས་འགྱུར་བའོ་ཞེས་པ་ནི་དབུགས་དབྱུང་པའི་ཆོ་གའི་རིམ་པའོ།",
    "ཕྱིའི་རྣལ་འབྱོར་མ་རྣམས་ལ་ཡང་དེ་ལྟར་ལྷ་མོའི་ཚོགས་བཅུག་ལ་བདག་ཉིད་དཀྱིལ་འཁོར་ཀྱོགཅོ་མོར་བསྒོམས་པ་དང་།",
    "དམཚིག་གི་རྫས་རྣམས་སྔ་མལྟར་དག་པར་བྱས་པའམ།",
    "དེ་ནས་མཚན་མོའི་དུས་སུ་ལུགས་མལ་སོགས་པ་མདུན་དུ་བྱས་ཏེ།",
    "སྟོད་པའི་ངང་ལས་སྐད་ཅིག་གིས་ལུགས་མལ་སོགས་པའི་དམ་ཚིག་སེམསདཔའ་བསྐྱེད་དོ།",
    "དེ་ནས་སྐྲན་སྲེག་གིས་མཉེས་པར་བྱའོ།",
