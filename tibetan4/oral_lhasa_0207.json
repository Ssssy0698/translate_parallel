    "འོད་འདོམ་གང་པ་འོད་ཟེར་ཉི་མ་སྟོང་བས་ལྷག་པར་མཐོང་ནས།",
    "སྲིད་པ་རྒྱ་མཚོའི་ཕ་རོལ་བྱོན་པ་ལགས།",
    "བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པའི་མཛད་བ་ཕྱོགས་ཙམ་སྨོས་པ་སྙན་གྲགས་ལྷའི་རྔ་ཆེན་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ཚད་ནི་ལྷག་པར་རིང་བ་མ་ཡིན་ནོ་བསམ་ནས།",
    "ཙན་དན་ས་མཆོག་ལས་བྱས་པའི་མཆོད་སྡོང་ཡོད་ཀྱིས་དེ་ཕྱུང་ལ་གཞོལ་བ་དང་།",
    "བུ་དང་བཅས་པ་དུ་མ་བུ་མེད་པར་འགྱུར་རོ།",
    "བདག་ཅག་རྣམ་པ་ཐམས་ཅད་དུ་མ་རུངས་པར་འགྱུར་རོ།",
    "མེ་བསད་པར་བརྩམས་ཀྱང་མ་ནུས་པའི་ཚེ་བཅོམ་ལྡན་འདས་གཤེགས་ཏེ་བཀའ་སྩལ་པ།",
    "བཅོམ་ལྡན་འདས་རི་བྲག་རྣམས་ཞུགས་ཀྱིས་ཚིག་ན་དགུམ་པར་རྔོ་མ་ཐོག་ལགས་སོ།",
    "རྗེས་སུ་བཟུང་བའི་ཆེད་དུ་ཡིན་པར་བཀའ་སྩལ་ཞིང་།",
    "བཅོམ་ལྡན་འདས་བྱོན་པར་ཐོས་པ་དང་།",
    "རིངས་པར་འོངས་ཏེ་ཞབས་ལ་ཕྱག་བྱས་ནས་དོ་ནུབ་བཞུགས་པར་གསོལ་བ་བཏབ་པ་ལ།",
    "ཅང་མི་གསུང་བས་གནང་བར་རིག་ནས།",
    "ང་གནོད་སྦྱིན་ལག་ན་རྡོ་རྗེ་དང་ལྷན་ཅིག་གཤེགས་པར་བྱའོ་སྙམ་ནས།",
    "བཀའ་བཞིན་འཚལ་བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པའི་མཛད་པ་ཕྱོགས་ཙམ་སྨོས་པ་སྙན་གྲགས་ལྷའི་རྔ་ཆེན་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ང་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པའི་ཚེ་ཅི་ནས་ཀྱང་སྤྱན་ལྡིངས་ཏེ་གནས་འདིར་འབབ་པར་འགྱུར་བ་དེ་ལྟར་བྱིན་གྱིས་བརླབ་པར་བྱའོ་ཞེས་ཞལ་གྱིས་བཞེས་སོ།",
    "གནས་མལ་སིནྡྲར་མཉན་པ་གཅིག་རྫུ་འཕྲུལ་གྱིས་དད་པར་མཛད་ནས་བདེན་པ་མཐོང་བ་ལ་བཀོད་དོ།",
    "སེར་བ་དང་རྡུལ་གྱི་ཆར་ཕབ་པས་བཅོམ་ལྡན་འདས་བྱམས་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་དང་།",
    "དེ་དག་ཨ་ག་རུ་དང་ཏ་དེ་མཐོང་ནས་ལྷག་པར་ཁྲོས་ཏེ་མཚོན་ཆའི་ཚོགས་ཕབ་པ་རྣམས་ཀྱང་ལྷའི་མེ་ཏོག་མ་ལའི་ཕྱེ་མར་གྱུར་ཏོ།",
    "ལག་ན་རྡོ་རྗེ་ཀླུའི་རྒྱལ་པོ་སོག་མ་མེད་འཇིགས་པར་གྱིས་ཤིག་གནོད་སྦྱིན་ལག་ན་རྡོ་རྗེས་རྡོ་རྗེ་འཕངས་པས་རིའི་རྩེ་ཞིག་སྟེ།",
    "ཀླུའི་གནས་ནོན་པར་གྱུར་པ་དང་།",
    "དེ་འཁོར་དང་བཅས་པ་སྐྲག་སྔངས་ཏེ་འབྲོས་པར་བརྩམས་པ་ལ།",
    "བཅོམ་ལྡན་འདས་མེའི་ཁམས་ལ་སྙོམས་པར་ཞུགས་ནས་ཕྱོགས་ཐམས་ཅད་འབར་རབ་ཏུ་འབར།",
    "ཞབས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་གསོལ་པ།",
    "བཅོམ་ལྡན་འདས་ཅི་བདག་ལ་ཐོ་བཙམས་ལགས་སམ།",
    "འཇིགས་པ་རྣམས་དབུགས་འབྱིན་པར་མཛད་པས།",
    "སྲོག་ལ་གནོད་པར་བྱེད་པས་འཚོ་ན།",
    "བུ་རི་བོས་དེ་བཞིན་དུ་བྱེད་པར་བརྩམས་པས།",
    "རི་བོ་ལ་སྐྱབས་སུ་མཆི་བ་སྩལ་ཞིང་བསླབ་པའི་གཞི་རྣམས་མི་དབོག་པར་གསོལ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་དེ་ལྟར་གནང་བ་དང་།",
    "ལག་ན་རྡོ་རྗེས་ཀླུའི་རྒྱལ་པོ་འཁོར་དང་བཅས་པ་དུལ་བ་དེ་ལ་མངོན་བར་དགའ་བས་གར་བྱས་ཏེ་སྨྲས་པ།"
  ]
}