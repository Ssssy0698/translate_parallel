    "མིའི་རྐང་པ་ལྟར་གསལ་པོ་ཞིག་ཀྱང་མ་རེད།",
    "ངས་དེ་མ་ཐག་དེ་ནི་མིའི་རྐང་རྗེས་ཤིག་མ་རེད་ཅེས་བརྡར་ཤ་བཅད་ནའང་།",
    "སྲོག་ཆགས་གཞན་དག་གི་རྐང་རྗེས་དང་དེ་བས་ཀྱང་མི་མཐུན།",
    "འདི་ནི་རྐང་རྗེས་ཡ་མཚན་ཅན་ཞིག་རེད།",
    "རྟོག་དཔྱོད་རུ་ཁག་གི་རུ་མི་གཞན་རྣམས་ཀྱང་དེར་ཡོང་བ་དང་།",
    "ཚང་མས་རྐང་རྗེས་ཡ་མཚན་ཅན་དེ་མཐོང་ནས་ཕན་ཚུན་ལ་མིག་ཅེ་རེར་བལྟ་བ་ལས།",
    "ང་ཚོས་རྐང་རྗེས་དེ་དེད་ནས་ལ་ངོས་སུ་སོང་བ་ཡིན།",
    "རྐང་རྗེས་དེ་ང་ཚོའི་གུར་འགྲམ་དུ་ཚང་ཚིང་རྒྱས་པའི་ཐང་ཤིང་གི་གསེབ་ཏུ་བརྒྱུད་པ་དང་།",
    "དེ་ནས་རྫུབས་གསེབ་ཅིག་ཏུ་འཛུལ་བ་རེད།",
    "དེ་དང་འདྲེ་འབོད་རྐང་གླིང་གི་བར་དུ་འབྲེལ་བ་ཅི་ཞིག་ཡོད་པ་ནི་ངས་མི་ཤེས་མོད།",
    "འདི་ནི་གསར་དུ་རྙེད་པའི་ཚན་རིག་གི་བྱུང་བ་འགངས་ཆེན་ཞིག་ཡིན་པ་ཤེས་སོང་།",
    "དེའི་འོད་ཀྱིས་གངས་རིའི་རྩེ་མོ་ཡང་དམར་མདངས་དང་ལྡན་པར་བསྒྱུར་ལ།",
    "དེའི་རི་མོ་བྲིས་ཤིང་པར་བླངས་རྗེས།",
    "རྐང་རྗེས་དེ་ལ་བྱེ་རྩི་དཀར་པོའི་ཕྱི་མོའང་བཟོས་པ་ཡིན།",
    "རྟོག་དཔྱོད་རུ་ཁག་གི་བློ་མཐུན་རྣམས་ལྷན་དུ་འཛོམས་ཏེ།",
    "མཇུག་མཐར་ཁོས་དགོད་ཁ་སློང་བའི་ཚུལ་གྱིས་མི་དང་འདྲེ་ཅི་ཡིན་ནའང་ཡིན་གི་ཤིག་ཟེར་ནས་ཚིག་གཅིག་ཁ་གསབ་བྱས།",
    "དེའང་ཤ་ཁྲག་གི་ལུས་རྟེན་ཅན་དང་།",
    "ད་ལྟ་ང་ཚོས་ད་དུང་གཏིང་མ་ལོན་པའི་སྲོག་ཆགས་ཤིག་ཡིན་ཤས་ཆེ།",
    "འཛམ་གླིང་ཐོག་ཏུ་དོ་ཟླས་དབེན་པའི་ཚན་རིག་གི་སྣང་ཚུལ་འདི་ལྟ་བུ་ལ་ང་ཚོས་ཅིས་ཀྱང་གཟབ་ནན་གྱི་སྤྱོད་ཚུལ་འཛིན་དགོས།",
    "ཞིབ་འཇུག་ཟབ་མོ་ཞིག་མ་བྱས་པ་དང་།",
    "དབུ་འདྲེན་པ་རྣམས་ཀྱང་ང་ཚོའི་འདོད་ཚུལ་དེར་ཐུགས་མོས་པ་བྱུང་།",
    "རྐང་རྗེས་ཀྱི་འདྲ་པར་དང་ཕྱི་མོ།",
    "དེ་ཚོ་ལོ་ངོ་ས་ཡ་གཅིག་གི་སྔོན་དུ་བྱུང་བར་ངེས།",
    "ཅོག་ཙེའི་ཐོག་གི་སྐད་གཟུགས་གཉིས་འཛིན་གྱི་འཕྲུལ་འཁོར་གྱི་ཅོང་བརྡ་བྲེལ་འཚུབ་དང་བཅས་ཏེ་སིལ་ལེར་འཁྲོལ་བའི་མོད་ལ།",
    "ངས་གློག་སྒྲོག་ལ་མཛུབ་མོས་གནོན་ཙམ་བྱས་མ་ཐག་གཟུགས་འཆར་ཡོལ་བའི་ངོར་སྐྲ་མཚམས་དཀར་པོར་གྱུར་པའི་སྐྱེས་པ་དར་མ་ཞིག་གི་བཞིན་རས་ཤར་བྱུང་།",
    "ས་གང་ནས་ངོ་འཕྲད་པ་ནི་རེ་ཞིག་དྲན་མ་བྱུང་།",
    "ཁྱོད་བློ་མཐུན་ཝང་ཞིན་ཡིན་ནམ།",
    "ངས་ཁྱོད་ཀྱི་བྱ་བ་ལ་དལ་འགོར་བྱས་སོང་།",
    "ཁྱོད་བདེ་མོ།",
    "ཟླ་གསུམ་གྱི་སྔོན་ལ་ཁྱོད་ཚོས་རྣམ་རྒྱལ་གླིང་གི་དགོན་ཤུལ་ནས་རྙེད་པའི་འདྲེ་འབོད་རྐང་གླིང་དང་རྐང་རྗེས་དེ་གཉིས་ཡིད་ན་ཨེ་ཡོད་ཅེས་དྲིས།",
    "ཁྱོད་ཀྱིས་དེ་ཚོར་ཞིབ་འཇུག་བྱེད་པའི་འགན་ཁུར་ཡོད་པ་ཡིན་ནམ།",
    "ང་ཚོའི་གནའ་རྫས་ལ་རྟོག་དཔྱོད་བྱེད་པའི་བྱ་བ་དེ་རེ་ཞིག་མཚམས་བཞག་རྗེས།",
    "ཉེ་ལམ་ཉིན་འགའི་རིང་ལ་ནང་གི་དག་སྒྲིག་བྱེད་པའི་བྱ་བའང་བྲེལ་འཚུབ་ཤིན་ཏུ་ཆེ་མོད།",
    "འོན་ཀྱང་ཁོམ་པ་རེ་བྱུང་ཚེ།",
    "ཟླ་དཀར་གྱི་འོད་ཟེར་འཕྲོས་པའི་མཚན་མོ་དབེན་པ།",
    "འདྲེ་འབོད་རྐང་གླིང་གི་ལྡིར་སྒྲ།",
    "རློམ་པར་དཀའ་བའི་ཁ་བའི་ཐོག་གི་རྐང་རྗེས་དེ་རྣམས་ལ་ཕྱིར་འདང་རེ་བརྒྱབ་པར་མ་ཟད།",
    "ཉིན་རེ་ནས་ཉིན་རེ་བཞིན་ངའི་སེམས་ལ་ཡང་ཡང་འཆར་ཏེ་ཤིན་ཏུ་ངོ་མཚར་བའི་སྣང་བ་སྐྱེས་སུ་བཅུག་ལ།",
    "འདྲེ་འབོད་རྐང་གླིང་དེ་ཅི་རེད།",
    "རྐང་རྗེས་དེ་སྲོག་ཆགས་རིགས་གང་གིས་བཞག་པ་རེད།",
    "ང་ཚོར་བསམ་ཚུལ་རགས་ཙམ་ཞིག་ཡོད་མོད།",
    "ངས་དེ་རིང་ཁྱོད་ཚོ་དང་འབྲེལ་བ་བྱེད་པའི་དམིགས་ཡུལ་ནི།",
    "ཁྱོད་ཚོ་གདན་དྲངས་ཏེ་མྱུར་མོར་པེ་ཅིན་ལ་ཡོང་ནས།",
    "ཡིན་ན་ཡང་ཁྱོད་ཚོར་བསམ་འཆར་ཅི་ཡོད་པ་མི་ཤེས་ཟེར།",
    "ངས་རྣམ་རྒྱལ་གླིང་གི་གཏེར་མ་དག་སྒྲིག་བྱེད་པའི་བྱ་བ་དེ་རེ་ཞིག་མཚམས་འཇོག་དགོས་པས།",
    "ང་ཚོར་བསམ་འཆར་མེད་ཅེས་ལན་བཏབ།་",
    "ཅའོ་ཧྲིག་ཀྲུའུ་ཝེ་ལ་ཡང་ཁོ་གཉིས་ཀྱིས་དགོད་ཁ་འཆོར་དུ་བཅུག་སྟེ་དེས་ན་ཧ་ཅང་བཟང་གི་ངས་ཁྱོད་ཚོར་བསྒུགས་ནས་འདུག་ཅེས་ཟེར།",
    "སླར་ཐུག་སླར་ཐུག་ཀྲུའུ་ཝེ་ཡི་གཟུགས་བརྙན་དེ་ཡོལ་བའི་ངོས་ནས་ཡལ་སོང་།",
    "འགོ་ཁྲིད་པ་རྣམས་ཀྱིས་ང་ཚོའི་འཆར་གཞི་ལ་ཆོག་མཆན་མགྱོགས་པོར་གནང་བྱུང་།",
    "ང་ཚོ་མི་བཞི་པོ་གནམ་གྲུར་བསྡད་ནས་པེ་ཅིན་ལ་སླེབས།",
    "ང་ཚོ་ཚན་རིག་ཁང་གི་སྣེ་ལེན་ཁང་དུ་བསྡད་པ་དང་།",
    "ཁྱོད་ཚོ་བདེ་མོ།",
    "དེ་ནས་སང་ཉིན་སྔ་དྲོ་དུས་ཚོད་དགུ་པའི་ཐོག་ཏུ་ང་ཚོའི་ཞིབ་འཇུག་ཁང་གི་ཚོགས་ཁང་དུ་སྣ་འཛོམས་ཚན་རིག་གྲོས་ཚོགས་ཤིག་འཚོག་རྒྱུ་ཡིན་པས།",
    "ཁྱོད་ཚོ་ཡང་དུས་ཚོད་ལྟར་ཕེབས་རོགས་གནང་།",
    "དུས་ཚོད་བརྒྱད་དང་ཕྱེད་ཀའི་ཐོག་རླངས་འཁོར་ཞིག་ཁྱོད་ཚོ་བསུ་བར་འོངས་ངེས་ཟེར།",
    "ཕྱི་ཉིན་སྔ་དྲོ་དུས་ཚོད་དགུ་པའི་ཐོག་ང་ཚོ་མི་བཞི་པོ་ཞིབ་འཇུག་ཁང་ཞིག་གི་ཚོགས་ཁང་ནང་དུ་སླེབས།",
    "ངས་འཐུས་ཚབ་དེ་དག་གི་བྱེད་སྒོའི་བྱ་བ་གསལ་པོར་ཤེས་རྗེས།",
    "ཁོང་ཚོའི་ཁྲོད་དུ་མིའི་རིགས་ལ་ཞིབ་འཇུག་བྱེད་པའི་མཁས་པ་དང་།",
    "ཁོང་རྣམ་པ་ཚོ་གངས་རིའི་འདྲེ་འབོད་རྐང་གླིང་གི་གསང་བ་དེ་བརྟོལ་བར་འབྲེལ་བ་ཡོད་པ་མ་ཡིན་ནམ།",
    "ཅའོ་ཧྲིག་ཀྲུའུ་ཝེ་ནས་མི་ཚོགས་ཀྱི་ཁྲོད་ནས་ང་ཚོ་ངོ་ཤེས་པ་དང་།",
    "ཁོ་ཚུར་འོངས་ཏེ་ང་ཚོར་བྱམས་བརྩེའི་ངང་ལག་འཇུས་བྱས།",
    "རྣམ་འགྱུར་ནི་དེ་བས་ཀྱང་གཟབ་ཅིང་བརླིང་པ་ཞིག་རེད།",
    "ཁྱོད་ཚོས་བསྐྱལ་ཡོང་བའི་དཔྱད་གཞིའི་རྒྱུ་ཆ་དེ་དག་ནི་ང་ཚོས་སྔོན་དཔོག་བྱས་པ་ལས་ཀྱང་སྣ་མང་བར་འདུག་གོང་རིམ་ཏང་ཨུའི་འགོ་ཁྲིད་འོག་ཏུ།",
    "ང་ཚོས་བྱེད་སྒོ་སྣ་མང་འདུས་པའི་ལྷན་འབྲེལ་ཞིབ་འཇུག་ཚན་ཆུང་ཞིག་རྩ་འཛུགས་བྱས་ཡོད།",
    "ད་ལྟ་གྲུབ་འབྲས་རགས་ཙམ་ཐོབ་ཡོད་མོད།",
    "དེ་ཡང་ང་ཚོས་དེ་རིང་གི་གྲོས་ཚོགས་འདིའི་ཐོག་ཏུ་ཞིབ་འཇུག་བྱེད་པའི་དམིགས་ཡུལ་ཡིན།",
    "ཁྱོད་ལ་ཐོག་མར་གཏམ་འཆད་དུ་འཇུག་རྒྱུའི་ཐག་བཅད་ཡོད་པས་གྲ་སྒྲིག་ཅིག་བྱོས་ཟེར།",
    "ཀྲུའུ་ཝེ་ཚོགས་སྟེགས་ཀྱི་ལོགས་སུ་སོང་ནས་ཚོགས་འགོ་བརྩམས་པ་ཡོངས་བསྒྲགས་བྱས།",
    "ང་ཚོས་དགའ་བསུ་བྱེད་ཟེར།",
    "གནས་ཚུལ་ཕལ་ཆེ་བ་ཤེས་ངེས་རེད་སྙམ་ནས།",
    "སྐྱེས་པའི་ལྗོན་ཤིང་རྣམས་ཀྱང་རེ་རེ་བཞིན་ངོ་སྤྲོད་བྱས་པ་དང་།",
    "ཧྲིན་ཡོན་གྱིས་གོམ་སྒྲ་ཐོས་རྗེས་དངངས་སྐྲག་གི་རྣམ་འགྱུར་བསྟན་པའི་ངང་ཚུལ་དེ་བརྗོད་སྐབས་སུ།",
    "ཧྲིན་ཡོན་གྱིས་ཁོ་མོ་ལ་དགོད་པ་ཤེས་ནས་གདོང་དམར་པོར་གྱུར་པ་དང་།",
    "ངའི་སེམས་ཀྱི་ཨ་ལོང་དེ་ཁོའི་གསུང་གི་ལྕགས་ཀྱུ་ཡིས་བཀུག་སོང་།",
    "ལབ་སྒྲོན་རྒྱ་མཚོའི་འདྲེ་འབོད་རྐང་གླིང་གི་ངག་རྒྱུན་དང་འདྲེ་འབོད་རྐང་གླིང་འདི་རྙེད་པའི་བརྒྱུད་རིམ།",
    "ཅའོ་ཧྲིག་ཀྲུའུ་ཝེ་ན་རེ།",
    "ང་ཚོ་ནི་ཚན་རིག་གི་བྱ་བ་བྱེད་མཁན་དང་ལྷ་མེད་སྨྲ་བ་པོ་ཡིན་པས།",
    "བློར་ཤོང་དཀའ་བའི་སྣང་ཚུལ་ངོ་མཚར་ཅན་དེ་དག་གི་ནང་དུ།",
    "ང་ཚོས་ད་དུང་མ་ཤེས་པའི་རང་བྱུང་ཁམས་ཀྱི་གསང་བ་ཞིག་འདུས་ཡོད་པར་གདོན་མི་ཟ་ན།",
    "ང་ཚོས་ཀྱང་འདུ་ཤེས་དེ་ལྟ་བུ་ཞིག་བཟུང་སྟེ་བྱ་བ་སྒྲུབ་དགོས།",
    "རྐང་རྗེས་དེ་དག་སྲོག་ཆགས་ཇི་ལྟ་བུ་ཞིག་གིས་བཞག་པ་དེ་རེད།",
    "ང་ཚོས་བློ་མཐུན་ཝང་ཞིན་གྱིས་ཕུལ་བའི་རྐང་རྗེས་དེའི་འདྲ་པར་དང་།",
    "བྱེ་རྩི་དཀར་པོས་བཟོས་པའི་ཕྱི་མོ་དེ་རྣམས་གཞིར་བཞག་སྟེ།",
    "རྐང་པའི་སྔ་རྟིང་གི་ཆགས་དབྱིབས་དང་།",
    "ཉིང་ལག་གི་གྲུབ་ཚུལ།་",
    "ཕྱི་རྟིང་གི་ཆེ་ཆུང་ལ་སོགས་པའི་ཆ་ཞིབ་ཕྲ་རྣམས་ལ་བརྟག་དཔྱད་ཞིབ་མོ་ཞིག་བཏང་བ་ཡིན།",
    "ཕྱོགས་གང་ཅིའི་ཐད་ནས་ཚད་འཇལ་བའི་བདེན་རྟགས་ལྟར་ན་སྲོག་ཆགས་དེ་མི་དང་སྤྲ་མིའི་བར་རོལ་དུ་གནས་པ་ཞིག་རེད།",
    "དེ་ཚོ་ཧ་ལམ་ལོ་ངོ་ས་ཡ་གཅིག་གི་ཡར་སྔོན་དུ་བྱུང་བའི་སྤྲ་མི་ཀེག་ལངས་པའི་རིགས་སུ་ཉེ།",
    "སྟབས་ལེགས་ནས་བློ་མཐུན་ཝང་ཞིན་གྱིས་ང་ཚོ་ལ་ད་དུང་ཁྲག་གི་རྒྱུ་གཞི་ཞིག་ཀྱང་ཕུལ།",
    "ཁྲག་གི་དྭངས་མ་ཡོན་བྱ་བ་སོགས་ལ་དབྱེ་ཞིབ་བྱས་པའི་འབྲས་བུ་ཡང་རྐང་རྗེས་ཀྱི་ཚད་བླངས་པ་དང་གཅིག་ཏུ་མཐུན།",
    "ལོ་ངོ་ས་ཡ་གཅིག་གི་ཡར་སྔོན་དུ་བྱུང་བ་དང་།",
    "ཚང་མས་དེའི་རྒྱུད་པ་སྔ་མོ་ནས་ཆད་པར་སྙམ་པའི་སྤྲ་མིའི་རིགས་ཤིག་ད་དུང་རེ་གཉིས་ཡང་འདུག་ཟེར་ན་རྣ་ལ་ཨེ་འགྲོ།",
    "ཁམས་བོད་མཐོ་སྒང་གི་མི་རྒོད་ཀྱི་བྱུང་བ་བཀོད་པ་ནི་ཤིན་ཏུ་མང་།"
  ]
}