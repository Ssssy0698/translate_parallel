    "ལོ་འདབ་ཚང་ཚིང་རྒྱས་པའི་ལྗོན་ཤིང་གི་ཡལ་གས་གནས་དེར་འཁོད་པའི་སྐྱེ་བོ་དག་ལ་གྲིབ་བསིལ་གྱི་སྦྱིན་པ་བར་མེད་དུ་བཏང་སྟེ་དགའ་བདེའི་དཔལ་ཡོན་འཛད་མེད་དུ་སྩོལ་ཞིང་མཆིས།",
    "ཀ་མ་རུ་ལས་བྱས་པའི་བརྗིད་ཆགས་ཀྱི་བཀོད་པ་དུ་མས་མཛེས་པའི་ཁང་བརྩེགས་རྣམས་མཐོན་མཐིང་དབྱིངས་སུ་ཟུག་པའི་དགེ་མཚན་དེ་དག་གིས།",
    "མཁར་གྱི་གྲོང་མོ་ཆེ་ཨ་ཡུག་ཐ་ལ་མཚར་སྡུག་གི་གཟི་མདངས་དང་མཛེས་སྡུག་གི་སྒེག་ཉམས་བསྣན་འདུག་རྒྱལ་པོའི་ཕྱག་མཛོད་དུ་རིན་ཐང་གཞལ་དུ་མེད་པའི་རྡོ་རྗེ་ཕ་ལམ་དང་གསེར་འོད་ཡུག་ཡུག་འཁྱུག་པའི་ས་ལེ་སྦྲམ་གྱིས་ཁེངས་པ་དང་།",
    "གླང་མོ་ཆེ་སོགས་ནི་རྩིས་ཀྱིས་མི་ལང་བརྗོད་དུ་མི་བཏུབ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་ཡོད།",
    "ཁོང་གི་འབངས་མི་རྣམས་ཀྱིས་ཁོང་ལ་ཡབ་ལྟར་བསྙེན་ཞིང་བཀུར་བར་བྱེད།",
    "ཁོང་དང་ཁོང་གི་བཙུན་མོ་གསུམ་པོ་སེམས་རབ་ཏུ་སྐྱོ་ཞིང་མཆིས།",
    "ཁག་མི་འདུག་ཁོང་ཚོ་སེམས་སྐྱོ་དོན་ནི་སྲས་དང་སྲས་མོ་མེད་པའི་རྐྱེན་རེད།",
    "ཁོང་གིས་བཀའ་ལ་གཏོགས་པའི་བློན་ཆེན་རྣམས་གདན་འཛོམས་སར།",
    "རྟ་མཆོག་གི་ཕྱི་རྗེས་སུ་རྒྱུད་ཀྱི་དམག་དཔུང་འབྲངས་པ་དང་།",
    "རྟ་མཆོག་གི་རྨིག་པས་བཅགས་པའི་གྲོང་བརྡལ་དང་ས་ཆ་ཐམས་ཅད་རྗེ་བོའི་མངའ་རིས་སུ་གཏོགས་པའི་བཀའ་བསྒྲགས།",
    "རྒྱལ་པོ་ཤིང་རྟ་བཅུ་པས་རྟ་མཆོག་གི་མཆོད་སྦྱིན་རྒྱས་པར་བཤམས་རྒྱུའི་གནས་ཚུལ་རྣམས་གྱད་མི་རྣམས་ཀྱིས་ཀུན་ལ་ཁྱབ་པར་བསྒྲགས་པ་དང་།",
    "ལོ་ཡི་འཁོར་མོ་ཧྲིལ་པོ་ཞིག་འདས་པའི་རྗེས་སུ།",
    "ཁྱིམ་མཚེས་རྒྱལ་ཁབ་ཀྱི་རྗེ་བོ་རྣམས་དང་ཚོ་བ་མང་པོའི་ཚོ་དཔོན་དག་མཆོད་སྦྱིན་གྱི་དགའ་སྟོན་ལ་གདན་འདྲེན་དགོས་པའི་ཕྱིར་རོ།",
    "ཨན་ཀའི་རྗེ་བོ་ལོ་མོ་བྷ་ཏཱ།",
    "མོ་རྩེ་ཏཱའི་མ་ག་དྷ་རྗེ་བོ་དང་བྱང་ཕྱོགས་ཀྱི་རྒྱལ་པོ།",
    "སྐབས་འདིར་ཁོ་ཡང་རྒྱལ་པོ་ཤིང་རྟ་བཅུ་པའི་མདུན་དུ་ཡོང་ནས་ན་རེལྗརྗེ་བོ་ལགས།",
    "རྟ་མཆོག་གི་མཆོད་སྦྱིན་ཁོ་ནས་སྲས་ཐོབ་པར་འགྱུར་མིན་ལགས་ན།",
    "རང་རེས།",
    "ཌདེ་གའི་རྗེ་བོ་ལོ་མོ་བྷ་ཀུས་དྲང་སྲོང་ཆེན་པོ་གདན་དྲངས་པ་དང་།",
    "བསྟུད་མར་ཉིན་འགའི་རིང་ལ་ས་འཛིན་སྒེག་མོའི་ལྟོ་བར་སྒྲུབ་ཆེན་ཟིལ་མོའི་རྒྱུན་མ་ཆོད་པོར་འཇོ་བ་དང་།",
    "དེས་ན་ནི་ཁྱེད་རང་གིས་ཁོང་གདན་འདྲེན་རྒྱུ་ནི་ལས་ཙ་ཙོང་ཁག་པོ་ཞིག་མི་རེ་ང་ཁཀོང་ཁརྒྱལ་པོ་ཤིང་རྟ་བཅུ་པས་སོ་མཎི་བྷི་ལའི་གཏོམི་ལ་གསན་ནས།",
    "ཁྱོ་ཌོ།",
    "འཁྱོག་ལ་མི་འཕྱན་དྲང་པོའི་ལམ་བསྟེན་ཐ་ཤལ་སྤྱོད་པའི་གཉའ་བ་གནོན།",
    "སྒོ་ཕྱུགས་བཟའ་འབྲུ་གསེར་དངུལ་མོད་པ་བདེ་ལྡན་ཞིང་གི་རྗེས་འགྲོ་ཞིང་།",
    "ཁྱིམ་མཚེས་རྣམས་ནི་མཛའ་ཞིང་མཐུན་ལ་རེས་རོགས་འཚོ་བ་ཕྱུག་པོར་རོལ།",
    "མཛའ་བས་བཅིངས་པའི་ཁྱོ་ཤུག་དག་ཀྱང་རང་གི་དམ་བཅའ་མི་ཉམས་པར།",
    "གནམ་གྱི་ལྷ་དང་རང་གི་མེས་པོ་ཕྱོགས་ཀྱི་སྐུ་མགྲོན་ལ་སོགས་པར།",
    "མི་ཕམ་གཡུལ་ལས་རྣམ་པར་རྒྱལ་བའི་ཡན་ལག་བཞི་ལྡན་དམག་གི་དཔུང་།",
    "ཁ་འབབ་ནམཁན་རྩེ་མོ་མཐོ་བའི་ཝུན་ཐ་རི་དང་ལྷུན་བརྗིད་གངས་ཅན་རྡུལ་བརྩེགས་ཀྱི།་",
    "ང་ཚོ་ཚེ་ཏ།",
    "ལག་ག་ག་ལ་ཁྱོ་གའི་ངོ་སྐུ་ཁག།",
    "དེ་ཡི་རྗེ་བོ་ཏཱ་ས་རཱ་ཐའི་སྙན་གྲགས་གདུགས་དཀར་འཛིན་མོར་ཁྱབ།",
    "ཁ་ལ་བདག་ཀོ་སཱ་ལ་ཡི་བཙུན་མོ་དེ་ལ་གཞུང་རྒྱུད་དྲུང་བའི་རཱ་མ་འཁྲུངས།་།",
    "དེའི་ཀེ་ཀོས་ཡེ་ཡི་བཙུན་མོ་ལ་ནི་སྤྱང་གྲུང་འཛོམས་པའི་བྷ་ར་ཏ།",
    "གཞན་ཡང་བཙུན་མོ་སེ་རྨི་ཏི་ལར་ལ་གླུ་ཧྲི་མན་ནཱ་དང་ནི།",
    "གང་ཞིག་བདག་གི་གཞུ་རྒྱལ་འགུག་ནུས་དེ་ལ་སཱི་ཏཱ་སྟེར་རོ་ཞེས།",
    "དེ་ཞེས་དྲང་སྲོང་ཆེན་པོ་གང་གིས་ཀྲ་ཎ་ཙཱ་ལ་དེ་སྐད་སྨྲས།",
    "ཁེངས་རློམ་ཅན་གྱི་བློན་པོའི་ཚིག་མདས་གང་གི་སྒྲ་འཛིན་ཅི་ཡང་དཀྲུགས།",
    "རཱ་མ་ལ་གླུ་སྤུན་མཆེད་ཟུང་དང་དྲང་སྲོང་ཆེན་པོར་གཟིགས་བཞིན་དུ།",
    "ཁོ་བོའི་དམ་བཅའ་རྡོ་རྗེའི་ཚིག་འདི་རྒྱལ་སྲས་དག་གི་ས་གོ་བར་གྱིས།",
    "ཌཎྜིཏ་ཏུ་བ་མོ་རཀོབ་བློཊ་ཏི་ག་ཌ་ཎ་༡ངགོང་ཟཀ་ཎདེའི་ཚེ་རྭ་མས་ཤིན་ཏུ་ལྕི་བའི་ལྕགས་ཀྱི་སྒྲོམ་བུའི་ཁ་ལེབ་ཕྱེས།",
    "ཁོ་སྤྲོད་ང་ཏུ་དང་ཚེརྒན་པོ་བདག་གི་འདྲེན་བྱེད་ལམ་དུ་སྔོན་མེད་ངོ་མཚར་རི་མོ་འཆེར། ལ་རཱ་མས་བྱིས་པའི་རྫུ་འཕྲུལ་འདི་ཀོ་རྒན་པོ་བདག་གི་བློ་ལས་ཡར།",
    "ཁ་ཎོ་ཌ་ཌོ་ཎཚོ་ཌཎྜ་ཁོ་ཎཚོཊ་ཌ་ཚོཌ་ཌ་ཌ་ཀ་ཟོཌ་ཎཁཊཾ་ཚཁོསྲིད་ན་འགྲན་མེད་བདག་གི་བུ་མོ་སི་ཏཱའི་ཡིད་ཀྱི་རྒྱལ་མཚན་རྩེར།",
    "སཱི་ཏཱའི་པད་མོ་མཛེས་སྡུག་ཅན་འདི་རཱ་མའིོག་ཏན་གྱི་གྲོགས་སུ་འབུལ་ཀ་བར་ང་ལོ་ཀྭ་ཡེ་དྲང་རློམ་ཁེ་སྦྱིན་བུ་ཁྱོད་བཀྲ་ཤིས་བ་སྔོ་སྨོན་ཚུར་ག་སོ་འམ་དང་།",
    "ཀློ་མི་ཁོ་བོའི་ཤིང་རྟར་ཁ་ལོ་སྒྱུར་ཅིག་ཁྱོད་དག་ཨཱ་ཡུག་ཐ་ལ་སོང་། ། ཌ།",
    "ཎཥཌ་ཎཎ་ཌཚུ་ཁ་ཁ་ཅུ་ཌཊཾ་དྷཱརྱཎཁ་ཎརྒྱུ་ཎྜཌ་ཆོ་ལྟ་ཀྱི་ཧཱུཾརཱ་མའི་རྩལ་ལས་སི་ཏཱ་ཐོབ་ཅིང་གང་གི་གཟི་བརྗིད་ཡོན་ཏན་སོགས།",
    "ས་སྐྱོང་ཏཱ་ས་རཱ་ཐ་ཁྱོད་ཀྱང་ཕྱོགས་འདིར་ཆིབས་བསྒྱུར་གནང་ཞེས་གསོལ།",
    "རྒྱལ་པོའི་ཞབས་རྡུལ་སྤྱི་བོར་བླངས་ཏེ་ཕོ་ཉའི་འཕྲིན་ལས་གསོལ་བའི་མོད།",
    "ཁོ་བོའི་གཞུ་རྒྱལ་འགུག་པར་ནུས་དེར་བུ་མོ་སཱི་ཏཱ་སྟེར་རོ་ཞེས།",
    "བདག་གི་མི་འགྱུར་རྡོ་རྗེའི་དམ་བཅའ་ལྷ་མི་འགྲོ་བ་ཀུན་ལ་བསྒྲགས།",
    "གཞན་ཡང་ཁྱོད་སྲས་བུང་བ་རྣམས་ཀྱང་གཉེན་གྱི་སྦྲང་རྩི་འཛིན་སླད་ཕེབས།",
    "ང་ཚོ་དང་།",
    "པ་སྔགས་མཁན་མི་ཆེན་ཁྱོད་རྣམས་ཕོ་ཉའི་ཞུ་ཚིག་ཐོས་སམ་ཅི།་",
    "ཆུ་རྒྱུབ་འབརྒྱུ་གལ་སྲིད་ཁྱོད་དག་བློ་ཡིད་འཐད་ཚེ་བདག་ཅག་མི་ཐི་ལ་ལ་ཆས།",
    "དཀོན་གཉེར་རྣམས་ཀྱིས་ཤིང་རྟ་ཕྲོངས་ལ་མདུན་གྱི་དཔུང་གི།",
    "ཟླ་བའི་མཐའ་ཡི་རྒྱུ་སྐར་ཇི་ལྟར་ཡན་ལག་བཞི་ལྡན་དཔུང་ཚོགས་བརྗིད།",
    "ལྟོགས་པས་ཟས་ལྟར་ཁྱེད་ཀྱི་བུ་ཀུན་ཕ་ཡི་བཟའ་བཏུང་ཞིམ་པོར་རེ།",
    "ད་དཀོར་གཉེར་དག་གིས་ཁ་ལོ་བསྒྱུར་ལ་མདུན་སྐྱོད་ལམ་གྱི་སྣ་འདྲེན་བྱོས།",
    "གྱུད་ཀྱི་དཔའ་བོའི་དཔུང་གི་ཚོགས་རྣམས་ལམ་དུ་ཞུགས་པའི་གྲབས་གཤོམ་མཛོད།",
    "ཤིང་རྟ་ཐམས་ཅད་ཁ་ལོ་བསྒྱུར་ལ་ས་སྐྱོང་བདག་གི་བཀའ་ལ་སྒུག།",
    "ཡན་ལག་བཞི་ལྡན་དཔུང་གིས་བསྐོར་ཏེ་གོམ་པའི་འདེགས་འཇོག་གོར་གྱིས་བྲེལ་ལ་ཉིན་ཞག་འཁོར་མོ་བཞི་ཙམ་བགྲོད་མཐར་ཝེ་ཏེ་ཧ་ཡི་ཁབ་ཏུ་འབྱོར།",
    "ལང་ཚོ་ཡོལ་བའི་ཏཱས་རྭ་ཟར་ཁམས་བདེའི་ཞུ་ཚིག་འདི་ལྟར་ཕུལ་ཀཚོང་རྟ་ཆཆོ་ཀྐཎ།",
    "ཎཎཎཱ་ཏཥཚེ་ཊི་ཌ་ཌ་ཊ་ཌཌ་ཀྱི་སྤུན་གང་ཁྱེད་དགེ་ལེགས་ཞབས་ཀྱི་པདྨོ་བདག་གི་ཁབ་ཏུ་བཀོད་པ་ནི།",
    "བདག་གི་ལས་ངན་སྡིག་སྒྲིབ་དག་ཅིང་རིགས་རུས་བཙུན་པའི་ཁེངས་པ་བད་ག་ག་ལ་བརྗེ་སྒྱུཊ་ཏེ་ག་ཎ་ས་༧ཊྚག་ཟ་འང་༡༡།",
    "ཀཌ་ཌཎི་ཥཥཱ་དུཌཌོཀ་ཁར་ད་དདབ་མོ་ལྕོག་སི་རི་རྩེར་རྟ་བདུ་ན་ཚེས་དུས་གཉེན་བསྒྲིགས་ཚོ་ག་བཤིམས་སོ་ཀྱེ།",
    "ཚོ་ནཌ་ཁ་ཏཱ་ས་རཱ་ཐ་རྐང་བ་དྲུག་པས་མཛའི་མཐུན་རྒྱུར་མོངས་འདི་ལྟར་སྦྲེངས།",
    "ཎཎ་ཌཊོ་ཁཚོ་ཎཎོ་ཚོ་ཆཏྭཱ་ཎ་ཀཁང་ཊིཀྐ་ཎ་ཀྱི་མཉན་པར་འོས་པའི་གཏམ་དག་གླེང་བཞིན་མཚན་མོའི་ཐུན་ཕྱེད་འདོའབར་བྱས།",
    "བློ་ཎ་ཚོ་ཌཎི་ཏི་ཥཌཁ་ཚོ་སྤུ་ཎཁོ་ཊི་ཌོ་ཎ་ཌ་ཌཤིན་ཏུ་སྐྱིདཙོའི་མིཚན་མོདིཙྪརྒྱལ་པོ་ལྡེ་ཡིདི་ནི་དགའ་རབསཊྛཱཚོས།",
    "རྒྱལ་པོའི་ཞལ་མཇལ་ཤིས་པའི་ཚིག་གིས་གང་གི་རྣ་བ་སྙན་པར་བྱས།",
    "ཀྭ་ཡེ་གསོན་ཅིག་རྐང་གཉིས་གཙོ་བོ་བདག་གིས་ཡབ་ཀྱི་བཀའ་བཞིན་དུ།",
    "ཉིད་ཀྱི་བཙུན་མོ་ཀེ་ཀོས་ཡུ་ནི་བདག་གི་སྲིང་མོ་ཡིན་པའི་ཕྱིར།",
    "བདག་ནི་ཡབ་ཀྱི་བཀའ་ནན་མ་ཁྱོག་རྒྱལ་སྲས་དཔའ་བོར་མཇལ་དུ་འོངས།",
    "ཡིད་རྟེན་འཕེར་བའི་ངག་གི་སྒྲོས་ནི་ཉིད་ཀྱི་མངའ་འབངས་ལྗགས་ལས་ཐོས།",
    "ཀ་ལ་ཀ་ཀྐཎི་ཀྱང་ཀ་ཁའི་དེ་ཞེས་དྲང་སྲོང་ཝ་ཞི་ཧྲི་ཐས་ཀྲ་ཎ་ཙཱ་ལ་རེ་བ་བཏོན།",
    "དེའི་ཕྱིར་རེ་སྒུག་བྱ་དགོས་མེད་ཀྱི་རྒྱལ་པོའི་ཐུགས་དགོངས་གང་མོས་མཛོད།",
    "ལུས་ལ་ག་ཡུ་བྱུར་རྒྱུན་གྱིས་མཛེས་པའི་ཡིད་འོང་བུ་མོའི་ཚོགས་ཀྱིས་ནི།",
    "ལྷ་ཡི་བཟོ་བོས་ལེགས་པར་བྱས་པའི་གསེར་སྐྱོགས་བུམ་པ་རི་མོས་བརྒྱན།",
    "འདྲེ་འབོད་རྐང་གླིང་གི་གཏམ་རྒྱུད་དང་།",
    "ངས་བལྟས་ན་ཁྱོད་ཚོས་ཀྱང་ཤེས་ཡོད་ལས་ཆེ།",
    "དེས་ང་ཚོ་ལག་བརྒྱུད་པ་དག་ལ་འཚུབ་ཤ་ལངས་སུ་བཅུག་པ་དང་དྲན་སྣང་བཞག་པ།",
    "དེ་ལྟ་ན་འདིར་བདག་གིས་ང་རང་གི་བྱ་བའི་ཉིན་ཐོ་གཞིར་བཞག་སྟེ།",
    "རྣམ་རྒྱལ་གླིང་གི་དགོན་ཤུལ་དུ།",
    "ང་ཚོ་གནའ་རྫས་རྟོག་དཔྱོད་རུ་ཆུང་འདིས་རྣམ་རྒྱལ་གླིང་གི་དགོན་ཤུལ་དུ་གཏེར་མ་བཙལ་ནས་ཟླ་ངོ་ཧྲིལ་པོ་གསུམ་འགོར་སོང་།",
    "དེའི་མདུན་ཕྱོགས་ནི་གནམ་མཚོ་ཕྱུག་མོ་རེད།",
    "འདི་གའི་ཡུལ་ལྗོངས་ནི་བྲིས་པའི་རི་མོ་བཞིན་དུ་མཛེས་ཤིང་ལྟ་ན་སྡུག་གངས་དཀར་ལྷུན་པོའི་ནུབ་བྱང་གཉིས་གནམ་འདེགས་ཀྱི་ཀ་བ་ཇི་བཞིན་མཐོན་མཐིང་དབྱིངས་སུ་ཟུག་པ་དང་།",
    "རི་སྐེད་དུ་སྤྲིན་དང་སྨུགས་པའི་དོ་ཤལ་ཚར་དུ་དངར་ཏེ་རྫུ་འཕྲུལ་ཅི་ཡང་སྟོན་པར་བྱེད། ཤར་ལྷོ་ནི་འདོམ་བརྒྱའི་གཅོང་རོང་གཟར་མོ་ཡིན་པ་དང་།",
    "བྲག་རི་སྨུག་པོ་ཟ་རེ་ཟོར་རེར་འགྱིང་ཞིང་།",
    "བྱང་དོམ་དང་ཤ་བཌ་སྤྲེའུ་ཝ་མོ།",
    "མཚོ་མོའི་འགྲམ་དུ་ནོའུ་གསིང་མིག་ལ་མཛེས་ཤིང་ཎཎཆུ་ཕྲནོ་འབག་སྒྲའི་ཀླུ་ལ་ཀ་དབྱིངས་ཐོས་འཛིན་ལམ་དུ་འཇོབས་ལ།",
    "རྣམ་རྒྱལ་གླིང་ནི་རྙིང་མ་བའི་གནས་མཆོག་ཅིག་རེད།",
    "ཎ་དགེ་ལུགས་པོ་དང་རྙིངམ་བགཉིས་མ་མོ་ཝུན་ལཎཐོབང་རྩོད་ཀྱི་འཁྲུག་ལོང་ག་ཐོ་ཞིག་བྱུང་བའྀང་སྐབས་དེར།",
    "ཀྱིས་མེ་ལ་བསྲེགས་པ་རེད།་",
    "སྟབས་ལེགས་ནས་མོ་འཇིག་པའི་གསེར་ཚོས་བྱུགས་པའི་མཆོད་རྟེན་ཞིག་ནུབ་ཁའི་ཉི་འོད་ཀྱི་འོག་ཏུ་གྲགས་འགུལ་ཅི་ཡང་མེད་པར་འགྱིང་འདུག།",
    "ཟ་རྣམ་རྒྱལ་གླིང་ནི་ངོ་མཚར་གྱི་སེང་རས་ཤིག་གིས་གཡོགས་པ་ལྟར་གསང་བ་ལྐོག་གྱུར་གྱི་གནས་སུ་གྱུར་འདུག།་",
    "ཁོས་གདོན་འདྲེ་བདུད་མོ་རྣམས་འདུལ་ཐུབ།",
    "རྣམ་རྒྱལ་གླིང་དུ་མཇལ་སྐོར་ལ་སོང་མྱོང་བའི་མཇལ་བ་མང་པོས་དངོས་སུ་མཐོང་མྱོང་བ་དང་།",
    "ཁོ་ཚོའི་གྲས་སུ་དཔོན་རིགས་དང་ཚོང་པ།",
    "ཉིན་རེའི་བྱ་བ་མཇུག་རྫོགས་པའི་དུས་སུ་ང་རང་གུར་གྱི་ཐབ་མདུན་དུ་ཙོག་སྟེ་ནུབ་ཁའི་ཉི་འོད་གངས་རིའི་རྩེ་མོར་ཕོག་པ་དང་།",
    "ནག་རོག་གེར་འགྱིང་བའི་རྣམ་རྒྱལ་གླིང་གི་དགོན་ཤུལ་བཅས་ལ་བལྟ་ཐེངས་རེར།",
    "བདག་གི་སེམས་ལ་དེ་མ་ཐག་ཏུ་ངོ་མཚར་གྱི་འཕྲུལ་སྣང་འབའ་ཞིག་ཤར།",
    "གལ་ཏེ་འདི་གའི་རི་དང་མཚོ་མོ་དག་གིས་ཀྱང་མི་སྐད་སྨྲ་ཤེས་པ་ཡིན་ན།",
    "གདོད་མའི་སྔགས་འཆང་གི་གྲུབ་ཆ་མང་པོ་ཞིག་འདྲེས་ཡོད་པས།",
    "ཟུར་ལྟའི་རིན་ཐང་གལ་ཆེན་ཡོད་པ་ནི་གདོན་མི་ཟ་བ་ཞིག་རེད།",
    "ཚོ་ཡང་རི་བོ་གངས་ཀྱིས་མ་བཟུང་བའི་སྔོན་ནས་ལྷ་ས་ལ་ཕྱིར་ལོག་དགོས་པ་ཡིན་མོད།",
    "ང་ཚོས་ཉིན་རེ་བཞིན་སྐུད་མེད་གློག་འཕྲིན་བརྒྱུད་ནས་ལྷ་སའི་མ་སྒར་ལ་འབྲེལ་གཏུགས་བྱས་ཆོག་པ་དང་།",
    "དུ་བ་སྐྱུག་པའི་གྱེན་འཕུར་གནམ་གྲུ་ཡང་ནམ་དགོས་ན་འཕུར་འོངས་ཏེ་ང་ཚོ་ལ་རྒྱབ་རོགས་བྱས་ཆོག་པས།",
    "དུས་བཞི་ནམ་ཟླའི་འགྱུར་ལྡོག་ལ་ང་ཚོས་སེམས་ཁྲལ་ཆེན་པོ་རང་བྱེད་དགོས་པ་མི་འདུག་རྣམ་རྒྱལ་གླིང་ན་ཁ་ཚང་དུ་ལུས་ཡོད་པ་ནི་མཆོད་རྟེན་དེ་ལས་གཞན།",
    "རྩ་བ་ནས་ཉིལ་ཡང་མི་འདུག་ལྷ་ཁང་ནང་གི་ལྷ་སྐུ་དང་།",
    "ལྷ་ཁང་གི་དཀྱིལ་དབུས་སུ།",
    "ནང་གི་འཇིམ་པ་རྗེན་པར་ཐོན་ནའང་།",
    "རྣམ་པ་ནི་འཇིགས་སུ་རུང་བ་ཞིག་རེད།",
    "ང་ཚོས་ཀྱང་དེའི་ཚད་འཇལ་བ་དང་པར་བླངས་པ་ཡིན།",
    "རང་བཞིན་གྱིས་ཀུ་རེ་རྩེད་མོ་ལ་དགའ་བས།",
    "ཧྲིན་ཡོན་ནི་རིག་པ་གྲུང་ཞིང་ཁ་མྱུར་ལག་མྱུར་ཅན་གྱི་གཞོན་ནུ་མ་ཞིག་རེད།",
    "ཚང་མའང་ཁོ་མོ་ལ་ཤིན་ཏུ་དགའ།",
    "འདིས་རྟོག་དཔྱོད་རུ་ཁག་གི་འཚོ་བ་ལ་སྤྲོ་སྣང་མི་ཟད་པ་ཞིག་བསྣན།",
    "ཀ་འདུ་ཁྱོད་ཀྱི་ས་འདི་ནས་རྒྱུ་འཚོལ་འདོད་པ་ཨེ་ཡིན།",
    "ཆོ་ག་ཆུ་ཚོ་ངས་ཀུ་རེ་བརྩེས་པ་མིན།",
    "ཁྱོད་ཀྱིས་འདི་ལ་ལྟོས་དང་།",
    "ཁྱོད་རེམ་མ་ཤོག་ལ་ལྟོས་ཤིག་ཟེར།་",
    "དེ་མ་ཐག་རང་འཁྲིས་བྱ་བ་ལོགས་སུ་བསྐྱུར་ནས་ཕར་བལྟ་རུ་སོང་བ་ན།",
    "ད་ནི་ཚོས་སྣ་ལྷུང་བས་སྲུབས་ཀ་ཡང་ཕྱིར་བུད་པར་སྣང་།",
    "ཎ་ཚོ་ལ་བོད་ཀཆོག་ང་ཚོའི་ཁོ་ངས་གྲི་ལྟག་གིས་འབག་རྫས་རྣམས་སེམས་ཆུང་བྱས་ནས་བསལ་བ་ན།",
    "ངོ་མ་ཀུན་དགའ་ར་བ་གྲུ་བཞི་ནར་མོ་བ་ཞིག་ཡོད་པ་དང་།",
    "ང་ཚོས་སྒམ་ཆུང་དེ་སེམས་ཆུང་གིས་ཕྱིར་བླངས་པ་དང་།",
    "དེའི་ཐོག་གི་ས་རྡུལ་རྣམས་གཙང་མིར་ཕྱིས་རྗེས།",
    "ོ་སྒོམ་ཆུང་ཐོག་ཏུ་པད་མི་ཡར་འཁྱིལ་གྱི་རི་མོ་ཞིག་ལེགས་པར་བརྐོས་ཡོད་པ་མཐོང་།",
    "གཞན་རྣམས་ལྟ་ཅི་རི་མོ་འདི་ཁོ་ནར་མཚོན་ནའང་།",
    "༩ རིན་ཐང་བྲལ་བའི་སྒྱུ་རྩལ་གྱི་གཏེར་མ་ཞིག་ཏུ་བརྩིས་ཆོག་སྒམ་ཆུང་གི་ཐོག་ཏུ་གཏེར་ལ་མནན་པའི་གོས་བྱང་ཞིག་སྦྱར་ཡོད་ལ།",
    "ད་དུང་ཕྱག་རྒྱ་ཞིག་ཀྱང་མནན་ཏེ་འདུག་ཁངབྱ་ཀ་ཚེ་ང་ང་ཚོས་ངོ་མཚར་བློ་འཕྲུལ་གྱི་བསམ་ཚུལ་སྣ་ཚོགས་བཅིངས་ནས་སྒོམ་ཆུང་དེའི་ཁ་ཕྱེས་པ་ན།",
    "ཁ་བའི་ཐོག་གི་རྐང་རྗེས།",
    "ཁྱོད་ཀྱིས་བོད་ལྗོངས་མཐོ་སྒང་གི་གངས་རི་དང་འཁྱགས་པས་བསྡམས་པའི་མཚོ་མོའི་སྟེང་ལ་ཉ་ཟླའི་འོད་ཟེར་འཕྲོ་བའི་མཚན་མོའི་ཡུལ་ལྗོངས་དེ་མཐོང་ཨེ་མྱོང་།",
    "ཁྱོད་ཀྱིས་བྱིན་ཆགས་ཤིང་བརྗོད་ཀྱིས་མི་ལང་བའི་མཚན་མ་ལྐོག་གྱུར་པ་དེ་དག་གི་གཏིང་དཔོག་པར་ནུས་སམ།",
    "ཕྱི་ནང་གསལ་བའི་སྒྲུགས་ལོང་གི་ན་བཟས་བརྒྱན་པ་ལྟ་བུ་རེད།",
    "ངོ་མ་བལྟ་ཁག་པོ་ཞིག་རེད།",
    "ཁོས་མགོ་བོ་ཡར་བཀྱགས་ཏེ་ལོབས་ཕྱོགས་ཀྱིས་གདོང་གི་ཤེལ་མིག་ཡར་འདེད་པའི་མོད་ལ་ངལ་གྱིས་དུབ་པའི་རྣམ་འགྱུར་ཞིག་གདོང་ལ་ཤར་འོངས།",
    "ཅི་ཟེར།",
    "མི་འགའ་ཞིག་གིས་ལྷན་ཅིག་ཏུ་ཧ་ལས་པའི་ངག་ཤོར་སོང་།",
    "འདི་ནི་ངག་རྒྱུན་དུ་གྲགས་པའི་འདྲེ་འབོད་རྐང་གླིང་དེ་རེད།",
    "ཕྱིས་སུ་འདྲེ་འབོད་རྐང་གླིང་འདི་ཐོབ་པའི་མི་ལ་རྐང་གླིང་འདི་འབུད་མི་ཉན་པ་དང་།",
    "ཁྱད་པར་དུ་མཚན་མོའི་དུས་སུ་འབུད་མི་རུང་བའི་ཐ་ཚིག་བསྒྲགས་པ་རེད།",
    "གུར་ནང་དུ་ཙོག་པའི་སྐྲུན་ཡོན་ཡང་གད་མོ་ཤོར་སོང་།",
    "ས་འཛིན་སྒེག་མོ་གངས་དཀར་རྒྱན་གྱིས་སྤུད།",
    "ལབ་སྒྲོན་རྒྱ་མཚོ་རྡོ་རྗེ་དཀྱིལ་དཀྲུང་གིས།",
