    "ཟི་ཁྲོན་བིས་ཐེ་ཐེ་ལ་གནང་བའོ། ། རྟག་ཏུ་ཀུན་ལ་ཀུན་ནས་བརྩེ་བས།",
    "འདང་རྒྱག་མེད་པར་འཁྱེར་བའི་རྐུན་མ།",
    "བླ་བྲང་བརྩོན་འགྲུས་ལ་གནང་བའོ། ། སྨྲ་བའི་ཁྱུ་མཆོག་བློ་བཟང་རྒྱལ་བ་དང་།",
    "དབྱེར་མེད་ཀུན་མཁྱེན་བཞད་པའི་རྡོ་རྗེ་ཡི།",
    "སྣང་མཐའི་སྒྱུ་འཕྲུལ་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན།",
    "དུས་ནམ་ཡང་འབྲལ་བ་མེད་པར་བཞུགས།",
    "ལྷ་རིགས་གསུམ་མགོན་གྱིས་རྟག་པར་སྲུངས།",
    "རང་བྱུང་ཆུ་བྲག་ལྗོན་ཤིང་སྣ་ཚོགས་ཀྱི་བཀོད་པའི་ཡ་མཚན་ལ་གཞིགས་ཚེ་མེས་པོ་ཚངས་པའང་སྔངས་པར་འགྱུར་སྙམ་འཆར་བ།",
    "རྟག་ཏུ་ཤིས་པའི་གྲུ་ཆར་འབེབས་པར་སྨོན།",
    "རྩི་ཤིང་ལོ་ཏོག་འདོད་རྒུར་སྨིན་པར་མཛོད།",
    "ལྷ་སར་ཕེབས་ལམ་ཆར་ཞོད་ཆེ་སྐབས་གནང་བའོ། ། སྤྱི་ལས་ཁྱད་པར་ཁ་བ་ཅན་གྱི་འགྲོར།",
    "མེན་ཡིན་ཤན་སིན་ལ་གནང་བའོ།",
    "། འཇམ་དཔལ་དབྱངས་ཀྱི་མཁྱེན་པའི་རླབས།",
    "ཁེ་ཤིའོ་ཤན་སིན་ལ་གནང་བའོ། ། ཁ་ལ་གཏམ་དང་ལག་ལ་བྲིས།",
    "དེ་ཡིས་བྱ་བ་ཅི་བྱས་ཀྱང་།",
    "ལྷ་མིའི་ཀུན་དགའ་རྒྱས་པར་སྨོན།",
    "བདེན་རྫུན་དྲང་པོའི་བྱ་བ་སུས་བྱས་ཀྱང་།",
    "རིམ་གྱིས་དགྲ་ལས་རྣམ་པར་རྒྱལ་བར་འགྱུར།",
    "ཕན་འདོགས་ལྷུར་ལེན་ཁྱད་པར་ལེགས་རྟོགས་ནས།",
    "གཙང་སར་ཆོད་པའང་དེང་སང་དཀོན།",
    "ཡིད་བརྟན་ཏིལ་ཙམ་མ་མཆིས་པར།",
    "བུང་བ་རྒན་པོས་ཞིམ་པར་འཇིབས།",
    "བསམ་གཏན་སྐྱིད་པར་ཤེས་རབ་ཀྱི།",
    "ཅེས་པ་འདི་གཉིས་པཎ་ཆེན་ཤིན་ཡོན་ནས་ཞུས་པ་ལྟར་གནང་བའོ། ། སྙན་པ་ལྷ་ཡིས་བསྒྲགས་པའི་འཇམ་དཔལ་དབྱངས།",
    "མད་པར་དགོངས་ན་ཐུགས་ཀྱི་རྒྱན་དུ་བཞེས།",
    "བསྟན་པའི་ཉི་མའི་གསང་ཚིག་གསན་ལགས་སམ།",
    "གུང་ཐང་ཚང་ནས་ཞུ་ཡིག་ཕུལ་ལན་དུ་གནང་བའོ། ། འབར་ཆུང་འབར་བ་རྩྭ་མེ་ཕར་སྦར་བས།",
    "དབལ་མང་ཉེར་ལྔར་གསུངས་ཏེ་ཉེར་བདུན་སྣང་།",
    "དེ་ལན་མི་དགོས་གསུངས་པ་དེ་ག་རང་།",
    "དྲིས་ལན་དྲུག་པར་གླ་རྩིའི་ཆུན་པོའང་རྩིང་།",
    "བརྟགས་ཚེ་ཐོས་པས་འཕོངས་པ་འདི་འདྲས་ཀྱང་།",
    "བྱ་ཁྱུང་ཤར་གདོང་ཞབས་དྲུང་ལ་རྫོགས་ཆེན་འབར་ཆུང་བཀྲ་ཤིས་རྒྱ་མཚོའི་དྲིས་ལན་གཡར་སྐབས་གནང་བའོ། ། གངས་ཀྱི་སྟོད་གཡོགས་འཆང་བའི་ས་འཛིན་སྤོར།",
    "དཀར་གཙང་ལས་ཀྱིས་བྲེལ་བའི་དྲང་སྲོང་ཞིག།",
    "ཁོ་བོའི་གནས་ཚུལ་མ་སྦས་ལྷུག་པ་ལགས།",
    "སྐུ་ཚེ་རིང་རྒྱུའི་ཐུགས་ལ་འཇགས་པར་ཞུ།",
    "ངེས་ལེགས་ལམ་གྱི་ཟླ་བོར་དགེ་ལགས་སམ།",
    "། དགུང་ལོ་བཅོ་ལྔའི་སྟེང་གནང་བའི་གསུང་རྩོམ་སོགས་རྩོམ་ཐུང་འགའ།",
    "མཐོང་གྲོལ་རྒྱལ་བའི་སྣང་བརྙན་འབུམ་བཞུགས་པས།",
    "ཕྱོགས་ཀྱི་ཐ་གྲུ་དོག་པར་གྱུར་པ་དང་།",
    "དགུང་ལོ་བཅོ་ལྔའི་སྟེང་གནང་བའོ། ། ཡེ་ཤེས་ཉི་མ་འབར་བའི་འོད་ཟེར་ནི།",
    "དེ་བས་བདེ་ཞིང་སྐྱིད་པར་འདོད་པས།",
    "མེད་པར་ལྟ་བས་རྩ་བ་གཅོད།",
    "ཉ་དང་ཉུང་མའི་དབྱེ་བ་འབྱེད་པར་འཚལ།",
    "མཛོ་དགེ་དཔོན་པོ་མགོན་ལོ་ལ་གནང་བའོ།",
    "ཁ་སྔོན་གནམ་གཤིས་ཕེབས་ལམ་ཤིན་ཏུ་བདེ་བས་ཁྲུང་ཁྲིན་རིམ་པར་དགྱེས་སོན་ལས།",
    "ལྷ་སར་དཔར་གྱི་འཕྲུལ་དུ་བསྐྲུན་པ་ཡང་།",
    "དཔྱད་པར་བྱ་བའི་གཞི་ནི་ཆེས་མང་ཞིག།",
    "སྲིད་པ་གསུམ་ན་འགྲན་ཟླ་མ་མཆིས་པར།",
    "སྣང་བ་དགག་བྱར་བྱས་པའི་ལྕེ་རྐན་གྱིས།",
    "བླང་དོར་གནས་ལ་མཁྱེན་པ་རྒྱས་པའི་སྲས།",
    "རང་ཉིད་ལེ་ལོའི་འདམ་ལས་མ་འཕགས་པར།",
    "ཚུལ་མ་ལགས་པས་ཅུང་ཟད་གླེང་བར་བྱ།",
    "ལེགས་བྱས་སྣང་བ་དཀར་པོའི་ལམ་ཡངས་ནས།",
    "ཉིན་མཚན་མེད་པར་དཔྱད་པ་ལྷུར་བླངས་ནས།",
    "འཕྲལ་དུ་གནོད་འགྱུར་རྟོགས་པར་སླ་བས་རགས།",
    "མི་སྨྲ་རྡོ་རྗེའི་རྣལ་འབྱོར་གོམས་པར་མཛོད།",
    "དེ་རྒྱུན་སྟོབས་དང་འཚམ་པར་བསྲིངས་པ་ཡིས།",
    "ཡུངས་འབྲུ་ལྟ་བུའི་ཐིག་ལེར་བཟླུམས་པར་སྤོབས།",
    "ཆེར་རློམ་མང་པོའི་སྐྱོན་མཚང་རྗེན་པར་རིག།",
    "ཡང་དག་མཆོག་སྦྱིན་ལས་ལ་རྟག་པར་འབུངས།",
    "རང་ཉིད་འཆིང་བའི་གཤིས་ངན་མི་སྟོན་པར།",
    "ཆུང་ངུའི་དུས་ནས་དབུས་གཙང་ལྗོངས་སུ་བརྟོལ།",
    "མངོན་སུམ་གསལ་བའི་གཟི་བྱིན་བསྐྱེད་པར་སྨོན།",
    "གཙང་མ་བཅུ་དྲུག་རང་སར་སྲོང་བའི་གཉེན།",
    "པེ་ཅིན་ནས་མེ་འཁོར་ཉིན་ཞག་གཉིས་ཀྱིས་བགྲོད་པར་བྱ་བའི་ཡུལ།",
    "ནང་དོན་བདུད་རྩིས་ཚིམ་པར་བྲན་པའི་དྲིན།",
    "བསྟན་པའི་གྲལ་དུ་ཚུད་པར་མི་འགྱུར་བས།",
    "དང་པོའི་རྨང་ནས་གོམ་ཁ་ཚུགས་པར་མཛོད།",
    "མགྱོགས་པར་རྒྱུག་པའི་གདུང་བ་མི་བཟད་པ།",
    "དེ་རིང་མཚར་ལ་ནངས་པར་འཇིག་པའི་ནོར།",
    "ཇེ་ཧྥང་མཐུན་སྣེ་བརྐྱངས་པ་འདི་ལགས་ཏེ།",
    "རྣམ་པར་དཀར་བའི་ཕྱོགས་སུ་ལག་པ་ཁྲོལ།",
    "ཁྱིམ་པར་བབས་ཀྱང་བཤགས་པའི་མཐུ་རྩལ་སྤུངས།",
    "མགོན་མེད་རིགས་ལ་ལྷག་པར་བྱམས་བརྩེ་གལ།",
    "རྗེན་པར་མཐོང་ནས་དུག་ལྟར་སྤོང་བ་ནི།",
    "སྲིད་ན་རྣམ་པར་རྒྱལ་བའི་ཤིས་བརྗོད་དང་འགྲོགས་ཏེ།",
    "དགེ་སྡིག་བླང་དོར་གཙང་མའི་ནོར་འཛིན་གྱི་འགྲམ་པར།",
    "རྩ་བ་དམ་ཚིག་གལ་བའི་སྒྲོས་ཙམ་ཡང་མེད་པར།",
    "ཡིད་གཉིས་ཚམ་ཚོམ་མེད་པར་རྩེ་གཅིག་ཏུ་བསྒྱུར་བའི།",
    "སྐད་ཅིག་ཉིད་ལ་ལྷག་མེད་དུ་གཞོམ་པར།",
    "སེམས་གཙང་མའི་དབྱིངས་སུ་ཧ་ཧ་ཧོ་ཧོ་ཟབ།",
