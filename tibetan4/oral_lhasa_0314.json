    "ཟབ་བསྡུས་བྱས་པ་འདི་ཙམ་ཡིན།",
    "བརྟེན་ནས་མཛད་པ་ཡིན་ཞེས་གསུངས།",
    "འཕྲིན་ལས་རྒྱུན་མི་ཆད་པར་ཤོག།",
    "རྒྱལ་ཁམས་པ་ཏཱ་ར་ནཱ་ཐས་སྨྲས་པའོ། ། ཟབ་ལམ་རྡོ་རྗེ་རྣལ་འབྱོར་གྱི་ལུས་སྦྱོང་འཁྲུལ་འཁོར་གྱི་མན་ངག་གསལ་བྱེད་བཞུགས།",
    "སེམས་སྐྱིལ་དེ་ནས་ལག་པ་ཁུ་ཚུར་བརླ་བཞག་བྱས།",
    "རྐང་པ་བསྐུམ་པ་མཉམ་པོར་ཡོང་བ་བྱས་ཏེ་འཕོང་བརྡེབ།",
    "བཅུ་ཚན་དང་པོ་ས་ལ་བསྡད་པའི་འཁྲུལ་འཁོར་རོ།",
    "ལག་མཐིལ་གྱི་སྟེང་དུ་གདོང་ཕྱོགས་པར་བྱས་ནས།",
    "དེའི་ཚེ་ཕྲག་པ་གཅུད་ཅིང་དཔུང་པ་ནས་འཁྲུལ་འདོན་པར་བྱའོ།",
    "ལག་པ་སྐེད་གཟེར་བྱས།",
    "ལག་པ་གཉིས་གཡས་སྟེང་གཡོན་འོག་ཁ་བུབ་ཏུ་བྱས་བརྩེགས་པས་ལྟག་པ་སྟེང་འོག་༦གཡས་གཡོན་དུ་ལན་དྲུག་མཉེ་བ་ནི་བརྒྱད་པའོ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་བསྡམས་པས་མུར་གོང་གཡས་གཡོན་གྱི་མཐར་ཐུག་པར་དཔྲལ་བའི་སྟེང་འོག་ཕན་ཚུན་དུ་འཕུར་ཞིང་བཙུར་བ་ནི་༦དགུ་པའོ།",
    "ཡང་ལག་པ་རྒྱབ་ཏུ་བཙུགས་ཏེ་སྐྱེད་ཀྱིས་བྱས་ནས་གཡས་གཡོན་དུ་གཅུད།",
    "འཕོང་སྟན་ལ་ཕེབས་པ་བརྡེབ་ཅིང་རྐང་བ་བརྐྱངས།",
    "རྐང་པའི་མཐེ་བོང་གཉིས་མ་རུའི་གནས་སྦྱང་བ་ཚང་བར་འགྱུར་བས་ལེགས་སམ་སྙམ་པ་ནི་ཁོ་བོའི་རྣམ་པར་རྟོག་པའོ།",
    "ཉེར་མཁོ་ཐུན་ཚགས་བསྡུས་པ་ཡིན་པ་ཤེས་པར་བྱའོ།",
    "བི་བྷུ་ཏི་ཙནྡྲའི་མན་ངག་ཡིན་གསུངས་པའི།",
    "ལངས་ཏེ་རྟིང་འཁྲབ་༡བྱས།",
    "རྐང་པ་གཉིས་དཔུང་པའི་རྒྱབ་ངོས་ནས་ལྟག་པར་བསྣོལ།",
    "རྡོ་རྗེ་སྐྱིལ་ཀྲུང་རྐང་མགོ་གཡས་གཡོན་བརླའི་ཕྱི་རོལ་ཏུ་ཐོན་པར་བྱ།",
    "ཕྱི་མ་འདི་ལ་འཕོང་སྟེགས་བུའི་སྟེང་དུ་བཞག་རྐང་མཐིལ་གཉིས་རྟེན་མེད་ཀྱི་ངང་ནས་གོང་བཞིན་བྱས་ནས་འཆུན་ཆེ་བར་འོང་།",
    "ཐམས་ཅད་ཀྱང་སྲོག་རྩོལ་དང་འཛིན་པའི་སྐབས་སུ་ཉེ་བར་མཁོ་བ་ལུས་དག་པར་བྱེད་པ་དང་།",
    "འདི་རྣམས་ཆ་ཚང་བར་ཉིན་དང་ཉིན་ལ་མ་འཆག་པར་བྱེད་ཅིང་།",
    "གསར་པ་མི་སྐྱེད་པར་ཐེ་ཚོམ་མེད་ཅིང་མྱོང་བས་གྲུབ་ལ།",
    "སྲོག་རྩོལ་དང་འཛིན་པའི་འཁྲིད་ཐོབ་པ་རྣམས་ལ་བསྟན་པར་བྱའོ།",
    "༥ཧུཾ་དང་ཧལ་༦ཞེས་བརྗོད་དེ་སྦྱོར་བ་དྲུག་དང་ལྡན་པར་བྱ།",
    "ཕྱི་མ་གསུམ་ཁྱབ་པར་བྱེད་པའོ།",
    "ལུས་ཐམས་ཅད་འཕུར་མཉེ་བྱས་ནས་འཕོང་ས་ལ་འབེབས།",
    "བུམ་ཅན་བཟུང་བཞིན་པའི་ལྟོ་བ་ཕྱིར་བསྐྱེད་བཞིན་བྱེད་པ་ནི་མ་ནིང་དང་བུམ་ཅན་གཉིས་སྦྲགས་མ་ཡིན་གསུངས་བུམ་ཅན་གཉིས་སྦྲགས་བྱེད་དེ་གཅུད་འཐེན་ཞེས་བྱའོ།",
    "ལུས་འདར་ཐོན་པར་བྱེད།",
    "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་བྱས།",
    "ཀུན་མཁྱེན་ཀློང་ཆེན་རབ་འབྱམས།",
    "ཞེས་གསུངས་པའི་ནང་ཚན་ཆེ་མཆོག་པདྨ་དྲག་པོ་རྡོ་རྗེ་གྲོ་བོ་ལོད་ཀྱི་སྐོར་ཏེ།",
    "ཁྱད་པར་སྟག་ཚང་སེང་གེ་བསམ་འགྲུབ་ཏུ",
    "བོད་ཡུལ་མཐའ་དག་གཏེར་གྱི་གཏམས་བྱས་ནས",
    "ཁྱད་པར་རྒྱལ་བསེན་དམ་སྲི་ཐམས་ཅད་དང་",
    "བཀའ་ཉན་གསུང་སྡོད་བྱེད་པར་འགྱུར",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་ཕུང་པོ་ཅན",
    "བཤགས་ཡུལ་མཁའ་ཁྱབ་ཏུ་སད་པའི་སྤྱན་སྔར་གཉན་པོ་སྟོབས་བཞི་ཚང་བས།",
    "རང་གནོང་འགྱོད་པའི་སེམས་ཀྱིས་མཐོལ་ལོ་བཤགས",
    "ཞེས་བཤགས་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་དག་པར་བསམ།",
    "སོ་བྱང་སྔགས་ཀྱི་དམ་ཚིག་སྤྱི་དང་ཁྱད་པར་ལྷག་པས་བསྡུས་བ་ཐམས་ཅད་བསྲུང་བར་དམ་བཅའ་པ་ནི།",
    "སྐུ་གསུང་ཐུགས་སུ་བསྒྲུབ་པར་དམ་བཅའ་འོ",
    "ཐམས་ཅད་ཀྱི་དཔྲལ་བར་ཨོཾ་མགྲིན་པར་ཨཱ་ཐུགས་ཀར་ཧཱུྃ་སློབ་དཔོན་མདུན་བསྐྱེད་དང་བཅས་པའི་ཐུགས་ཀའི་ས་བོན་ལས་འཕྲོས་པའི་འོད་ཟེར་གྱིས་ཕྱོགས་བཅུ་དུས་བཞིའི་དེ་བཞིན་གཤེགས་པ་སྲས་དང་བཅས་པའི་ཐུགས་རྒྱུད་བསྐུལ།",
    "མདུན་བསྐྱེད་དཀྱིལ་འཁོར་པའི་སྐུ་གསུང་ཐུགས་ཀྱི་འོད་ཟེར་རིམ་པར་གྱུར་ཏེ་གནས་གསུམ་དུ་ཐིམ་པ་དང་",
    "ཁྱད་པར་གཏོར་མ་སྤྱི་བོར་བཞག་པས་སྣོད་བཅུད་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་ཡེ་ནས་གཞིར་བཞུགས་སུ་གྱུར་པ་གཞིར་བཞེངས་སུ་གསལ་འདེབས་པས་ཧཱུྃ་ཧྲཱི",
    "ཞེས་གསུངས་པ་ལྟར་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཁྲིད་སྲོལ་འདི་ཉིད་བྱུང་བར་མངོན།",
    "སྤར་སྐྲུན་སོགས་ཀྱི་ངལ་བ་ལྷུར་བཞེས་ནས་ད་ཆ་རྒྱ་ཆེའི་དོན་གཉེར་བ་རྣམས་ཀྱི་སྤྱན་ལམ་དུ་བསྟར་ཐུབ་པ་འདིར་ཐུགས་རྗེ་བཀའ་དྲིན་ཆེ་ཆེ་ཞུ་རྒྱུ་དང་།",
    "༢༡༥ལོའི་ཟླ་བ་༡༡པའི་ཚེས་༡༣ཉིན་ལྷ་ལྡན་རང་ཤག་ནས་སྐ་བ་ཤེས་རབ་བཟང་པོས་ཕུལ། བསྡུ་སྒྲིག་པའི་གླེང་བརྗོད།",
    "ལྷག་པར་ལུགས་འདིའི་བརྗོད་བྱ་གཙོ་བོ་ནང་སེམས་ཀྱི་ཁྱེར་སོ་དང་།",
    "ཅུང་ཞིབ་ཆས་དབྱེ་ན་གྲགས་ཆེན་བཅོ་བརྒྱད་ཅེས་པའི་སོ་སོའི་འབྲེལ་ཡོད་ཀྱི་འགྲེལ་སྐོར་རྣམས་ཕྱོགས་བསྡུས་ཇི་ལྟར་བྱས་པའི་ཚུལ་ཅུང་ཟད་གླེང་བར་སྤྲོའོ།",
