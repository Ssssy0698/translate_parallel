    "དེ་ཡང་རྣམ་པར་དཔྱོད་པའི་ཐུགས་མངའ་སྤྲུལ་པའི་སྐུའི་ཞལ་ནས།",
    "གཟུགས་སོགས་དེ་ཉིད་རྟོགས་པར་མི་འགྱུར་ཞིང་།",
    "ཟོ་ཆུན་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "ཇི་སྲིད་ཕུང་པོར་ཞེས་སོགས་ཤེས་བྱེད་ཀྱི་ལུང་དང་བཅས་ཏེ་གསལ་བར་གསུངས་པའི་ཕྱིར།",
    "ཞེས་གསུངས་སོ།",
    "འདི་ལ་ལན་གྱི་རིམ་པ་བརྗོད་པར་བྱ་སྟེ།",
    "གཟུགས་སོགས་དེ་ཉིད་རྟོགས་པར་མི་འགྱུར་ཞིང་།",
    "དེས་ན་གཟུགས་སོགས་ཀྱི་དེ་ཁོ་ན་ཉིད་རྟོགས་པར་མི་འགྱུར་ཞིང་།",
    "གཟུགས་བཟང་པོར་བཟུང་ཞིང་དེ་ལ་དམིགས་ནས་ང་འདི་དང་འཕྲད་པར་བྱའོ་སྙམ་པའི་འདོད་ཆགས་སོགས་སྐྱེ་བར་འགྱུར་ཏེ་ཡུལ་དེ་ཡི་ངོ་བོ་རྟོགས་པ་མེད་པའི་ཕྱིར་ཞེས་ཡུལ་གཟུགས་སོགས་ཀྱི་དེ་ཉིད་ཤེས་པ་མེད་པར་ཡུལ་དུ་གནས་པ་དང་ངར་འཛིན་མ་སྤངས་པས་ཕྲ་རྒྱས་ཀྱང་ཡོད་པར་བསྟན་པ་ཡིན་ཏེ་རང་འགྲེལ་གྱི་བབ་རྣམས་དང་བསྟན་པས་ཤེས་སོ།",
    "ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "དེ་ལྟར་རིགས་པས་རྟོགས་ནས་གོམས་པར་བྱས་ན་དེ་ལ་གསལ་སྣང་རབ་ཀྱི་མཐར་ཐུག་པ་ཡང་འབྱུང་རིགས་ཏེ་རྟོགས་བྱ་ཡང་དག་པའི་དོན་ཡིན་པའི་ཕྱིར་མི་རྟག་སོགས་བདེན་པའི་རྣམ་པ་མངོན་སུམ་མཐོང་བ་བཞིན་ནོ།",
    "ངར་འཛིན་ལྷན་སྐྱེས་ཀྱི་ཞེན་ཡུལ་ང་ཙམ་མིན་པར་ཕུང་པོ་ཡིན་དགོས་ནའང་དེ་མིན་པར་འཇུག་པ་ལས་གསལ་པོར་གསུངས་པའི་ཕྱིར་དང་ཐ་སྙད་དུ་བདག་རྫས་སུ་མེད་ལ་ཕུང་པོ་རྫས་སུ་ཡོད་པ་སོགས་ཀྱི་ཁྱད་པར་འཐད་པ་དང་།",
    "ཡུལ་བདག་གཉིས་པོ་སྟོང་པར་ཤེས་པས་དེ་འཛིན་གཉིས་པོ་ལྡོག་པ་རིགས་པ་སྨྲ་བའི་ཚུལ་ཡིན་གྱི།",
    "དུ་མ་ཚོགས་པའི་རང་བཞིན་ཅན་གྱི་ཕུང་པོ་རྣམས་ལ་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "དེ་ཙམ་ལ་བདག་ཏུ་བློས་ཕར་བཏགས་པ་ཙམ་ལས་བདག་དོན་དུ་མེད་པར་རྟོགས་པ་ན།",
    "གཅིག་པུའི་ང་ཞེས་འཛིན་པའི་གཞི་ཞིག་ནི་གདགས་གཞི་ཕུང་པོ་འདི་ལ་མེད་ངེས་སུ་མཐོང་བའི་ཚེ་ཇི་ལྟར་ན་རང་རྒྱུད་ཀྱི་ཕུང་པོ་ལ་བདག་ཏུ་འཛིན་ཏེ་ཐག་པ་ཡོད་པར་བཟུང་ཡང་སྦྲུལ་དུ་མི་འཛིན་པ་དང་འདྲའོ།",
    "ཆ་མེད་དང་སྐད་ཅིག་མ་དུ་མ་ཡོད་དུ་ཆུག་ཀྱང་དེ་ང་མིན་པར་རིགས་པས་ངེས་ཤིང་མངོན་སུམ་རྟོགས་པར་བྱར་ཡོད་པས་དེ་ཙམ་གྱིས་བདག་ཏུ་འཛིན་པའི་ཉེས་པ་ཅི་ཡང་མི་སྐྱེད་དོ།",
    "དེ་ལྟར་ན་རང་རྒྱུད་ཀྱི་ཕུང་པོའི་ཚོགས་པ་བློས་མ་གཞིགས་མ་བརྟགས་པར་ངའོ་སྙམ་དུ་བཏགས་པ་ཡིན་ན་ཡང་།",
    "ཞེན་ཡུལ་གྱི་ང་དེ་ཐག་པ་ལ་སྦྲུལ་ལྟར་ཕུང་པོ་དང་གཅིག་ཐ་དད་གང་དུའང་མེད་པར་བློས་ཕར་བཏགས་ཙམ་དུ་ཤེས་ཤིང་གོམས་པ་ན་ཕུང་པོ་ཕྲ་བ་ནས་བདེན་མེད་དུ་མ་རྟོགས་ཀྱང་ངར་འཛིན་ལྡོག་སྟེ།",
    "ཞེས་རྣམ་འགྲེལ་ལས་གསུངས་པ་ལྟར།",
    "རང་རྒྱུད་ཀྱི་ཕུང་པོ་ལ་བདེན་པར་འཛིན་ན་ཕུང་པོ་ལ་བརྟེན་པའི་བདེ་སྡུག་ཉམས་སུ་མྱོང་བའི་ཚེ་ངའོ་སྙམ་དུ་བསམ་པའི་བློ་ལྷན་སྐེས་ཇི་ལྟར་མི་སྐེ་སྙམ་ན།",
    "བདག་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "རྣལ་འབྱོར་པ་དེ་རྣམ་པར་གྲོལ་བར་འགྱུར།",
    "དེ་ལྟར་མིན་ན་ཐ་སྙད་དུ་ཕུང་པོ་ལ་བརྟེན་པའི་བདེ་སྡུག་མྱོང་བ་ཙམ་དགྲ་བཅོམ་པ་ཆེན་པོ་རྣམས་ལའང་ཡོད་པས་ཕུང་པོ་བདེན་མེད་ཙམ་རྟོགས་ཀྱང་རུང་ཕུང་པོ་ཡོད་པའི་རིང་ལ་བདེ་སྡུག་མྱོང་བ་ལ་བརྟེན་ནས་ངར་འཛིན་ལྷན་སྐྱེས་ལྡོག་པར་མི་འགྱུར་ན་ཡང་།",
    "ཉན་ཐོས་པ་རྣམས་ཀྱིས་ནི་རགས་པ་བཅོམ་ཞིང་བློས་གཞན་བསལ་དུ་རུང་བ་རྣམས་ཀུན་རྫོབ་ཏུ་ཡོད་པ་ཙམ་དུ་འདོད་ཀྱང་དེ་སྟོང་པར་མི་འདོད་པ་ལ།",
    "ཞེས་རིགས་པའི་ལམ་ནས་གསལ་པོར་བསྟན་པའི་ཚེ་དངོས་སྨྲ་བས་དེ་ལྟར་མ་ཡིན་ནོ་ཞེས་རིགས་པའི་ལམ་ནས་བརྒལ་མི་ནུས་ལ་དེ་ལྟར་གྲུབ་ན་སྟོང་པ་ཉིད་ལ་བྱ་བྱེད་རྒྱུ་འབྲས་ཤིན་ཏུ་འཐད་ཅིང་དངོས་པོར་གྲུབ་པ་ལ་མི་འཐད་པའི་ཚུལ་ཤེས་པར་འགྱུར་རོ།",
    "ཐེག་ཆེན་ན་བདག་མེད་གཉིས་ཀ་རྒྱས་པར་སྟོན་པ་སོགས་ལམ་གྱི་ཡན་ལག་ཚང་བས་སྤང་རྟོགས་ཁྱད་པར་ཅན་གྱི་འབྲས་བུ་འགྲུབ་པ་ཡིན་ནོ།",
    "སྤྲོས་དང་བཅས་པར་སྟོང་པ་ཉིད།",
    "དེ་ལྟར་ལེགས་པར་ངེས་པ་ན་བྱམས་འཇམ་དབྱངས་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "དེ་ཡང་སྤང་བྱ་གང་ཡིན་ཡང་དེའི་ཀུན་བཏགས་སྔོན་དུ་མ་སྤངས་པར་ལྷན་སྐྱེས་སྤང་བ་མི་རིགས་ལ།",
    "ཏིང་ངེ་འཛིན་གྱིས་མྱོས་པ་མེད་པར་གྱུར་ནས་ཟག་པ་མེད་པའི་དབྱིངས་ནས་སླར་ཟད་དེ།",
    "ཕུང་པོ་གང་ཟག་བདག་མེད་པར།",
    "ཞེས་གསུངས་སོ།",
    "ཞེས་གསུངས་པ་ལྟར་རྟོགས་བྱ་བརྒལ་ལན་ཉིན་བྱེད་སྣང་བ།",
    "དེའི་ཕྱིར་བདེན་དོན་མངོན་སུམ་མཐོང་བ་ལ་དེ་རྟོགས་བྱེད་ཀྱི་ཐབས་རིགས་པའི་རྣམ་གྲངས་རྒྱས་མི་རྒྱས་ཀྱིས་རྟོགས་པ་ལ་རྫོགས་མ་རྫོགས་སམ་བཟང་ངན་ཡོད་པར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "ཤཱ་རིའི་བུས་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "བརྩོན་པ་ཞན་པས་ཀྱང་མ་ཡིན་ཏེ་མཆོག་ཏུ་བརྩོན་ཀྱང་གྲངས་མེད་གཅིག་ཏུ་འགོར་བར་གསུངས་སོ།",
    "བློ་ནི་ཀུན་རྫོབ་ཡིན་པར་འདོད།",
