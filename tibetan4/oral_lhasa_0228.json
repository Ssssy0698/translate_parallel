    "གཙང་ལ་དྲི་རབ་བསྒོས་པས་སྐུ་ཕྱིའོ།",
    "མཐར་སྐུ་ཕྱི་བ་རྣམས་ཐམས་ཅད་ལ་ཤེས་པར་བྱའོ།",
    "སྐུ་གཟུགས་རྣམས་ཀྱི་དབུའི་རྒྱབ་ཕྱོགས་སུ་བུག་པ་ཡོད་ན།",
    "མཆོད་རྟེན་དང་སྐུ་གཟུགས་སྔར་གཞུག་ཟིན་པ་ཡིན་ན་རིང་བསྲེལ་མི་དགོས་ལ།",
    "འཇིག་རྟེན་མཁྱེན་པ།",
    "སྐྱེས་བུ་ཆེན་པོའི་མཚན་སུམ་ཅུ་སོ་གཉིས་ཀྱིས་ཡང་དག་པར་བརྒྱན་པ་དང་།",
    "དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུས་ཡང་དག་པར་མཛེས་པ་དང་།",
    "རབ་ཏུ་གནས་པར་བགྱིའོ་ཞེས་པའི་སྐབས་སུ་ཐམས་ཅད་ཀྱིས་ཚིག་མཐུན་པར་བརྗོད་ལ།",
    "སེམས་བསྐྱེད་ཀྱི་ཚིག་ཡིན་པས་ལན་གསུམ་བརྗོད་པར་གསུང་ངོ།",
    "ཕས་ཀྱི་རྒོལ་བ་བདུད་དང་ལོག་འདྲེན་ཐམས་ཅད་ཕམ་པར་བགྱིའོ།",
    "ལྟ་བ་ཕྱིན་ཅི་ལོག་པ་དག་ཡང་དག་པའི་ལྟ་བ་ལ་གཟུད་ཅིང་དད་པར་བསྒྱུར་རོ།",
