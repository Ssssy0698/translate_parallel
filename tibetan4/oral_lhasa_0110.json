    "བདུན་ཕྲག་གཉིས་ཀྱི་རིང་སྔར་འཆར་གཞི་བཀོད་པ་ལྟར་བོད་ལ་གནས་སྐོར་གང་འཚམས་ལེགས་གྲུབ་བྱུང་ནས་༡༩༩༢ ཟླ་བ་༨ ཚེས་༡༦ ཉིན་ང་དང་ང་ཡི་དྲུང་ཡིག་གཉིས་བོད་ཀྱི་རྒྱལ་ས་ལྷ་ས་ནས་རྒྱ་ནག་རྒྱལ་ཁབ་ཆེན་པོའི་རྒྱལ་ས་བེ་ཇིང་དུ་འབྱོར།",
    "ཞེས་ཞིབ་ཏུ་གསུངས་སོ།",
    "ཁོང་ད་ལྟ་ཨ་རིར་སྐྱབས་བཅོལ་དུ་ཕེབས་ནས་བཞུགས་ཡོད།",
    "ཤུན་པ་ལ་སྐུ་གཟུགས་དང་ཡིག་འབྲུ་དང་ཕྱག་མཚན་རྣམས་རང་བྱོན་དུ་བྱུང་ཞེས་གསུངས་ལ།",
    "ཡལ་ག་རྣམས་ཆུ་ཞེང་གབ་པ་ཡིན་ཡང་གྱེན་དུ་ཕྱོགས་པར་སྐྱེས་པ།",
    "ཞེས་གསུངས།",
    "འདིར་ཙན་དན་སྤྲུལ་བའི་ལྗོན་པ་དེ་དང་འབྲེལ་བའི་གནས་ཚུལ་ཡ་མཚན་ཞིག་སླར་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "ཞེས་པའི་ལྗོངས་རྒྱུ་ཟིན་ཐོར་བཀོད་ཅིང་འགྲེམ་སྤེལ་བྱས་པ་གཤམ་གསལ།",
    "དེ་ལ་གཡོ་ཐབས་ཤིག་འདྲེས་མེད་དམ་སྙམ་སྟེ་གཟབ་ནན་ཆེན་པོས་བརྟག་དཔྱད་བྱས་ཀྱང་གཡོ་ཐབས་ཀྱི་རྣམ་པ་གང་ཡང་མ་རྙེད།",
    "དེ་ནས་དགུང་ལོ་བཅུ་དྲུག་ཏུ་སོན་པའི་ཚེ་བོད་དབུས་ཕྱོགས་སུ་ཕེབས།",
    "དེ་ཡང་རྗེ་བཙུན་ཆེན་པོ་འདི་དང་ཨ་ལགས་ཤར་གདོང་ཚང་གཉིས་ནི་ཐུགས་ཡིད་གཅིག་ཏུ་འདྲེས་པ་ལྟ་བུའི་འབྲེལ་བ་ཤིན་ཏུ་ཟབ་ཅིང་།",
    "གྲྭ་གཞོན་ཞིག་ལ་སྡོམ་པ་ཡང་སྦྱིན་ཞེས་གསུངས་པ་ལྟར།",
    "རྗེའི་འཇམ་དབྱངས་སྒྲུབ་ཁང་དངོས་གང་ཡིན་ཞེས་བཀའ་འདྲི་གནང་བར།",
    "སྔོན་ནས་འདི་ལྟར་ཡིན་ནམ་གསུངས་པར།",
    "ཁོང་སྔར་རྒྱ་གར་དུ་བཙན་བྱོལ་ལ་ཕེབས་ནས་དེའི་རྗེས་ཕྱིར་ཕ་ཡུལ་དུ་ཕེབས་ཤིང་བཞུགས་ཡོད།",
    "རྒྱ་གཞུང་ལ་ལས་ཀ་བྱེད་མྱོང་བའི་ལས་བྱེད་ཟུར་པ་སོགས་ལ་ཡང་མཇལ་འཕྲད་གནང་ཚུལ་གསལ།",
    "ས་གནས་ཤིག་ཏུ་འབྲོག་པ་སྐོར་ཞིག་ལ་མཇལ་འཕྲད་གནང་བར།",
    "དེ་ནས་ཕེབས་ཏེ་བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་གྱི་ཕྱོགས་སུ་ཆིབས་ཞལ་བསྒྱུར།",
    "དེ་ནས་རྒྱལ་བ་པཎ་ཆེན་རྣམ་གཉིས་ཀྱི་འཁྲུངས་ཡུལ་ལ་མཇལ་སྐོར་བྱས་ཏེ་ཟི་ལིང་དུ་བསྐྱོད།",
    "ཞེས་གསུངས་པ་ལྟར་ཤེས་དགོས་སོ།",
    "། ཕྱི་ལོ་༡༩༨༩ ལོའི་ནང་རྒྱ་གར་སྲིད་བློན་ར་ཇིབ་གྷན་རྡི་མཆོག་ནས་ངོས་སོག་ཡུལ་དུ་རྒྱ་གར་གཞུང་ཚབ་ཏུ་འགྲོ་དགོས་ཚུལ་བཀའ་གནང་ལྟར་རྒྱ་གར་སོག་པོའི་བར་གྱི་མཐུན་འབྲེལ་ཐོག་སྲིད་ཐོག་ནས་ཞབས་ཞུ་གང་ཤེས་དང་།",
    "དེ་རྗེས་ཆུ་ཚོད་༡ ལྷོད་མཇལ་དང་རྒྱ་གར་གྱི་གནས་ཚུལ་སོགས་ཞིབ་པར་ཞུས།",
    "སྒོ་ཉལ་བྱས་ནས་བརྗོད་པ་སོགས་ཐབས་སྣ་ཚོགས་བྱས་པར་བརྟེན།",
    "ཞལ་ཐང་རྙིང་པ་ཚེམ་དྲུབས་གོས་དྲུབས་བྱིན་ཅན་དཔག་ཏུ་མེད་པ་བཞུགས་ལུགས།",
    "ཁྱིམ་པར་ཕབ་པ།",
    "འདི་ལོ་དུས་འཁོར་སྒྲུབ་མཆོད་རྡུལ་ཚོན་བླུགས་ན་ཇི་དགེའི་སྐོར་བཀའ་འདྲི་གནང་བྱུང་བས།",
    "ངོས་ནས་གནས་སྐབས་ད་ལྟ་བཞིན་གནང་འཐུས།",
    "ལོ་གཞོན་འགའ་ཤས་ཀྱིས་རྡ་ས་བཞུགས་སྒར་དུ་ལོ་ཤས་སློབ་སྦྱོང་གནང་ཐུབ་ན་ལེགས་པ་ཡོད་ཚུལ་དང་།",
    "སྒྲོལ་མའི་རྗེས་གནང་བྱས་ཤིང་།",
    "གཞན་ཡང་མཁས་གྲུབ་སྐྱེས་ཆེན་དམ་པ་རིམ་པར་བྱོན་པ་དང་འབྱོན་འགྱུར་གོར་མ་ཆག་པས་བསྟན་པ་ཉམས་པ་སོར་ཆུད་ཟོལ་མེད་ལྷག་བསམ་དག་པའི་གསལ་འདེབས་སྩལ་བ་རྣམས་ཐུགས་ལ་འཇོག་དགོས་ཚུལ་དང་།",
    "གང་ལགས་ཞུས་ན།",
    "མིག་ལྟོས་ཡར་བལྟ་བྱ་ཡུལ་ཞིག་ཀྱང་ངེས་པར་དགོས་གལ་ཆེ་སྟབས།",
    "གྲྭ་མང་དང་ཡུལ་མི་བཅས་ནས་བསུ་བ་གཟབ་རྒྱས་གནང་།",
    "རྟེན་འབྱུང་དང་སྟོང་པའི་རྣམ་གཞག་ཇི་བཞིན་ཤེས་ནས་ཉམས་སུ་ལེན་དགོས་ཚུལ་རྒྱས་པར་བཤད།",
    "མ་ཎི་བརྒྱ་ཚར་མཉམ་འདོན་བྱས་ནས་མ་ཎི་དུང་སྒྲུབ་ཅིག་འདི་ལོར་གསོག་དགོས་ཚུལ་དང་།",
    "བལ་ཡུལ་མཆོད་རྟེན་བྱ་རུང་ཁ་ཤོར་ལྟ་བུའི་ཕྱིའི་བཀོད་དབྱིབས་དང་མཚན་ཡང་བྱ་རུང་ཁ་ཤོར་ཞེས་མཆོད་རྟེན་ཆེན་པོའི་ནང་དུ་འདུ་ཁང་རྟེན་སྣ་ཚོགས་བཞེངས་རྒྱུའི་འཆར་གཞི་ཡོད་པའི་ཕྱོགས་དེར་ས་ཆོག་བྱས།",
    "ལྷག་པར་རྒྱ་གར་དང་སོག་པོ་མཐུན་འབྲེལ་ཚོགས་པ་ནས་དང་བའི་འཁུར་ལེན་ཐོག་ལོ་གཞོན་རྩེད་ཐང་དུ་མི་དམངས་སེར་སྐྱ་ལྔ་ཁྲི་ཙམ་འདུས་ཤིང་།",
    "འདི་ཕྱིན་ཆང་ངེས་པར་འགོག་དགོས་གལ་ཆེ།",
    "ལྷག་པར་དེ་རིང་ས་ཟླའི་དུས་ཆེན་འདིར་ཆང་འཐུང་བ་དང་།",
    "སྡིག་ལས་བྱུང་བའི་ཟས་ཤ་སོགས་སྤང་དགོས་པ་གལ་ཆེ་ཚུལ་ལེགས་པར་བཤད།",
    "མི་དམངས་དང་མཉམ་མ་ཎི་འཕྲེང་འཁོར་གཅིག་མཉམ་དུ་འུར་འདོན་བྱས་ཐོག་འཕགས་བོད་ཧོར་གསུམ་སོགས་འཛམ་གླིང་ཡོངས་ལ་དམག་འཁྲུག་མུ་གེ་སོགས་ཞི་ཞིང་།",
    "སློབ་སྦྱོང་ལེགས་པར་སྦྱང་གལ་ཆེ་ཚུལ་དང་།",
    "ཕྱི་ཚེས་༡༢ ཉིན་དྲུང་ཆེ་མཆོག་ལྡི་ལིར་ཕྱིར་ཕེབས་བསྐྱངས།",
    "ཕྲན་ཡང་འདི་ཉིན་ཨུ་ལན་ཨུ་བདེར་ཕྱོགས་ཐོན་བྱས།",
    "སྐུ་གསུང་ཐུགས་རྟེན་རྣམས་ལ་རབ་གནས་བྱས།",
    "དེ་ནས་ཨུ་ལན་སྦ་ཏོར་དུ་ཕྱིར་ལོག་བྱས།",
    "མཁྱེན་ཡོན་ལྡན་པའི་མཁས་པ་མང་དུ་འཛོམས།",
    "བགྲེས་ཤོས་ནི་དགུང་ལོ་༩༣ ལ་ཕེབས་པ་དང་།",
