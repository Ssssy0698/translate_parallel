    "སྤྱི་ལོ་ཟླ་ཚེས་ཉིན་གནང་བའི་ཕྱག་ཡིག་ལག་སོན་བྱུང་བས་དངོས་མཇལ་ལྟ་བུའི་དགའ་སྤྲོ་ཆེན་པོ་ཐོབ་བྱུང་།",
    "ཕེབས་ཚེས་ངེས་གཏན་འཁེལ་མཚམས་ལམ་སངས་གློག་འཕྲིན་ནམ་ཁ་པར་ཞིག་གཏོང་གནང་ཡོད་པ་དང་།",
    "གང་ཉིད་སྐུ་གཟུགས་ལ་བདག་གཅེས་གང་གཟབ་གནང་སྐྱོང་དགོངས་འཇགས་འཚལ།",
    "ཆེས་ཡིད་མི་སྤྲོ་བའི་དོན་རྐྱེན་ཆེན་པོ་ཞིག་ཡིན་པར་མ་ཟད།",
    "ཕུན་ཚོགས་རྣམ་རྒྱལ་གྱི་གཅུང་པོ་ཐུབ་བསྟན་མཆོག་ནོར་ཡང་དེའི་སྔོན་ཙམ་ནས་བ་ཀུ་ལ་སྐུ་གོང་མའི་ཡང་སྤྲུལ་དུ་ངོས་འཛིན་གནང་ཟིན་པས་མང་སྤྲོའི་རྒྱལ་པོའི་གདུང་རྒྱུད་འཛིན་མཁན་གཞན་མེད།",
    "རིང་པོར་མ་ཐོགས་པར་ཡུམ་ཕྱི་མའི་ལྔ་ལམ་དུ་གྱུར།",
    "༡༩༤༥ ལོར་མཐོ་རིམ་སློབ་སྦྱོང་མཛད་ཆེད་བོད་དུ་ཕེབས།་",
    "ཅེས་གསུངས།",
    "ཐུགས་མི་བདེ་བ་ལྟ་བུ་ཞིག་མཛད་ནས་ཕ་ཡུལ་སྤངས་ཏེ་རྒྱ་གར་དུ་ཕེབས།",
    "དེ་ནས་ལོ་མང་རིང་ངེད་གཉིས་མ་ཕྲད་ཅེས་སོགས་གསུངས།",
    "རྗེ་བཙུན་ཆེན་པོ་འདི་བོད་དུ་བཞུགས་པའི་སྐབས་དེ་ཉིད་དུ་གནས་ཚུལ་གཞན་ཞིག་བྱུང་བ་ནི།",
    "མི་ལོ་བཅུ་བཞིའི་རིང་བྲེལ་བྲེལ་འཚུབ་འཚུབ་དང་དཀའ་བ་བརྒྱ་ཕྲག་བསྟུད་མར་སྤྱད་དེ་བསྒྲུབས་པའི་གྲུབ་འབྲས་རླབས་པོ་ཆེ་བསྣམས་ནས་ཕྱིར་ལ་དྭགས་སུ་ཕེབས།",
    "གལ་ཏེ་གཅེན་པོ་ཕུན་ཚོགས་རྣམ་རྒྱལ་སྐུ་གཤེགས་ཟིན་པའམ་དགུང་ལོ་གཞོན་དུས་སུ་ཕྱིར་མ་ཕེབས་ན།",
    "འདི་ནས་མང་སྤྲོའི་མཁར་དུ་རྒྱལ་རྒྱུད་ཆད་ཅེས་སོགས་གསུངས།",
    "རྒྱལ་པོ་ཕུན་ཚོགས་རྣམ་རྒྱལ་འཚོལ་ཞིབ་གནང་བའི་མཛད་པ།",
    "གར་ཡོད་གར་བཞུགས་ཀྱི་གནས་ཚུལ་ཤེས་མཁན་ནི་གཅིག་ཀྱང་མ་བྱུང་།",
    "དེ་བཞིན་དུ་ལ་དྭགས་སྤྱི་ཡོངས་ཀྱི་ཕྱག་ལས།",
    "ལག་རིས་ལ་བརྟག་པ་སོགས་ཐབས་ལམ་ཡོད་རྒུ་འདོན་པར་མཛད།",
    "ས་གནས་གཙོ་བོ་ཁག་ཏུ་མི་གཞན་ཆེད་གཏོང་དང་གཞན་ལ་མངགས་བཅོལ་གནང་བ་སོགས་ཀྱང་མཛད།",
    "གང་དུ་བཞུགས་པ་ནི་གཏན་ནས་མ་མཁྱེན།",
    "ཕྱག་མཛོད་ལགས་ཕྱིར་འབྱོར་ནས་མ་ན་ལིར་བཞུགས་པ་དེ་རྒྱལ་པོ་ཕུན་ཚོགས་རྣམ་རྒྱལ་ཡིན་པར་འདྲ་ཡང་།",
    "སུ་ཡིན་གསང་བ་གནང་སྟེ་ཅི་ཡང་མ་གསུངས་པས་ཁོང་ཡིན་མིན་ཐག་བཅད་དེ་ཞུ་ཚོད་ཐིག་དཀའ་བ་དང་།",
    "ལ་དྭགས་ལྡུམ་རར་ཁྱིམ་ཚང་དེ་ལྟ་བུ་ཞིག་ཡོད་མེད་རྩད་གཅོད་བྱས་ཀྱང་དེ་ལྟ་བུ་ཞིག་གཏན་ནས་མ་རྙེད།",
    "ལྷག་པར་དུ་ཞ་འཐེང་ལྟ་བུའི་ཕེབས་སྟངས་ལ་བརྟགས་ན་ཕུན་ཚོགས་རྣམ་རྒྱལ་ཡིན་པའི་ངེས་ཤེས་བརྟན་པོ་རྙེད།",
    "ཡང་བསྐྱར་གསུང་དང་ཞེས་གསུངས་ཏེ་ཧ་ལས་པའི་ཚུལ་རྣམ་འགྱུར་བསྟན།",
    "ཕུན་ཚོགས་རྣམ་རྒྱལ་གྱིས་ཐབས་སྣ་ཚོགས་བསྟེན་ནས་ལོ་མང་རིང་ཡིབ་སྟེ་བཞུགས་ན་ཡང་།",
    "དྲུང་ཡིག་ལགས་ཀྱིས་གསུངས་པ་ལྟར་ན།",
    "ཕུན་ཚོགས་རྣམ་རྒྱལ་ལགས་ཧིནྡུ་དང་ནང་པའི་ལྟ་གྲུབ་གཉིས་ཀར་མཁས་ལ།",
    "ལཀྵྨན་ཕེབས་ན་དེ་དང་ལྷན་དུ་ང་ཡང་ཡོང་ཆོག་ཅེས་བཀའ་ལན་ཕུལ།",
    "དེ་ནས་བཟུང་གཅེན་གཅུང་གཉིས་ལན་དུ་མར་མཇལ་འཕྲད་གནང་ཞིང་གཞན་དང་གཞན་ལ་ཡང་མཇལ་འཕྲད་ཐེངས་འགར་གནང་།",
    "ལ་དྭགས་སུ་ཡུན་རིང་མ་བཞུགས་པའི་སྟབས་ཀྱིས་ནམ་ཟླ་སོགས་ལ་མ་གོམས་ཤིང་།",
    "གཅིག་པུར་བཞུགས་ཏེ་བྱ་བྲལ་གྱི་སྤྱོད་པ་ལྷུར་བླངས་པར་བརྟེན་འདུ་འཛི་ལ་མ་གོམས་པར་ཕྱིར་མ་ན་ལིར་ཕེབས་ཏེ་བཞུགས།",
    "ད་ལྟའང་བཞུགས་ཡོད་ཅིང་སྒྲུབ་པའི་རྒྱལ་མཚན་འཛིན་བཞིན་ཡོད་པར་བཤད།",
    "སྤྱི་ལོ་ལོ་ཞེས་པར་ཡང་བརྟག་དགོས་ཏེ།",
    "དེ་ནི་མ་མཇལ་བར་མི་ལོ་༦ འདས་ནས་སླར་ཡང་མཇལ་ཞེས་པའི་དོན་ཡིན་པར་སྣང་སྟེ།",
    "ཆེན་པོ་ཧོར་གྱི་ཡུལ་དུ་བསྟན་འགྲོའི་དོན་རྒྱ་ཆེར་མཛད་པའི་རིམ་པར་ཕྱེ་བ།",
    "སོག་ཡུལ་དུ་ཕེབས་པའི་ལུང་བསྟན་སོགས་འདས་དོན་དུ་མ།",
    "རྒྱ་གར་འཕགས་པའི་ཡུལ་ནས་གནས་བརྟན་ཆེན་པོ་བ་ཀུ་ལ་ཕེབས་ཏེ་བསྟན་པ་སླར་གསོ་ཞིང་འགྲོ་བའི་དོན་རྒྱ་ཆེར་མཛད་པ་དང་།",
    "གནས་བརྟན་ཀུན་གྱི་ཕྱག་ཏུ་ཡང་སྐུ་ཐང་གཞན་དང་མི་མཚུངས་པར་གནས་བརྟན་བ་ཀུ་ལའི་ཕྱག་མཚན་ནེའུ་ལེ་དེ་ཉིད་ཕུལ་ཏེ་བཞེངས།",
    "སྐུ་ཐང་དེ་ཉིད་སྤྱི་ལོ་ལོར་བཞེངས་པ་འདྲ་སྟེ་དཔྱད་པར་བྱའོ།",
    "ལྷག་པར་དེང་སྐབས་སྙིགས་ལྔའི་རང་མདངས་ཀུན་ནས་དར་ཞིང་།",
    "ལྷག་པར་རྒྱ་སོག་ཡུལ་གྲུ་ཆེ་རྣམས་སུ།",
    "དེ་ལྟར་སྤྱི་ལོ་ལོའི་བར་དུ་སོག་ཡུལ་དུ་བཞུགས་ཏེ་གཞུང་ཚབ་ཀྱི་མཛད་འགན་མུ་མཐུད་ནས་བཞེས།",
    "རྒྱ་གར་དང་ཨུ་རུ་སུ་གཉིས་འབྲེལ་ལམ་བཟང་པོ་ཡོད་སྟབས་རྒྱ་གར་དང་སོག་ཡུལ་གཉིས་ཀྱི་འབྲེལ་ལམ་ཐོག་དཀའ་རྙོག་གང་ཡང་མེད་པར་མ་ཟད།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་སོག་ཡུལ་གྱི་རྒྱལ་སར་ཆིབས་བསྒྱུར་ནམ་འཁེལ་ལ་ངོས་ནས་རྒྱ་གར་གཞུང་ཚབ་ཁང་དུ་སྣེ་ལེན་ཕེབས་བསུ་ཞུ་རྒྱུའི་གོ་སྐབས་མ་ཆད་པར་ཞུ་རྒྱུ་བྱུང་།",
    "དེ་ནས་ཕེབས་ཐོན་གྱིས་མེ་འཁོར་དུ་བཞུགས་ཏེ་སོག་ཡུལ་དུ་ཕེབས།",
    "མེ་འཁོར་གྱི་ཕེབས་ལམ་གཡས་གཡོན་དུ་སོག་རིགས་མི་དམངས་ཀྱིས་ཕེབས་བསུ་རྒྱ་ཆེར་ཞུས་ཤིང་།",
    "ཚེས་ཉིན་སྲིད་འཛིན་བཱར་མུང་མཇལ་འཕྲད་དུ་ཕེབས།",
