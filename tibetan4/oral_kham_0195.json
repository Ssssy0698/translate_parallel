    "སྡུག་བསྔལ་གཞན་ལྟ་ཡར་འདུག་ཤིག།",
    "སྐྱེས་བུ་འགའ་ཞིག་དུས་བྱས་པ་དང་།",
    "འགྲེང་བའི་སྡུག་བསྔལ་ཡང་འདུག་པས་ཡིན་ལ།",
    "འདུག་པའི་སྡུག་བསྔལ་ཡང་འགྲེང་བས་སོ།",
    "གལ་ཏེ་ཡང་འདུག་པའི་སྡུག་བསྔལ་གྱིས་ཡོངས་སུ་དུབ་སྟེ་དེ་བཏང་ནས་སྤྱོད་ལམ་གཞན་མི་རྩོམ་ན་ནི་དེའི་ཚེ་འདི་ལ་སྤྱོད་ལམ་ལས་བྱུང་བའི་སྡུག་བསྔལ་གཏན་ལྡོག་པ་སྲིད་པ་ཞིག་གོ།",
    "སྐྱེས་བུ་འགའ་ཞིག་ལ་ཆུང་མ་གཉིས་ཡོད་ཅིང་དེ་ལས་གཅིག་ནི་བུ་དང་ལྷན་ཅིག་འདུག་ལ།",
    "ཙ་ན་ཀས་གསེར་ཡོངས་སུ་དོར་བ་བཞིན་ནོ།",
    "དངོས་པོ་དང་རང་བཞིན་དང་བདག་དང་རྟག་པ་དང་བརྟན་པ་ཞེས་བྱ་བ་རྣམ་གྲངས་དག་གོ།",
    "དེའི་ཕྱིར་འབྲས་བུ་གང་ཞིག་དུས་ལས་སྐྱེས་པ་དེ་ནི་མ་བྱུང་བ་ལས་བྱུང་བ་ཞིག་སྟེ།",
    "རྒྱུ་དང་རྐྱེན་ལ་ལྟོས་པ་མེད་པར་འགྱུར་ཞིང་རང་ཉིད་འབྱུང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནི་ཤེས་པ་ཡོད་པ་ཉིད་ཀྱང་རང་བཞིན་ཡིན་པའི་ཕྱིར་དང་།",
    "ལྷ་སྦྱིན་འདུག་གོ་ཞེས་བྱ་བ་ལ་སོགས་པ་བྱེད་པ་པོ་ལ་གནས་པ་མི་འགུལ་བའི་མཚན་ཉིད་ཅན་གྱི་བྱ་བ་དངོས་པོའི་བདག་ཉིད་ཅན་གང་ཡིན་པ་དེ་ཡང་སྔར་གྱི་བྱ་བ་བཅོམ་ནས་རྩོམ་པ་ན་སྔར་བདག་ཉིད་དེས་ལུས་བཀོད་པ་མི་སྲིད་པའི་ཕྱིར།",
    "རང་ཉིད་ཀྱིས་རྣམ་པར་གནས་པ་མ་ཡིན་པ་རང་བཞིན་མེད་ཅིང་རང་བཞིན་གྱིས་སྟོང་པ་སྟེ་དེ་བཞིན་དུ་མཁས་པས་དཔེ་འདི་དངོས་པོ་གཞན་རྒྱུ་དང་འབྲས་བུའི་གནས་སྐབས་མི་སྣང་བ་ཆོད་པ་དང་ཕྲ་བ་རྣམས་དང་།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་གང་ཞིག་དུས་ཐམས་ཅད་ཡོད་པ་ཉིད་དུ་སྨྲ་བའི་ཕྱིར་ཐམས་ཅད་ཡོད་པའི་སྨྲ་བ་ཉིད་བསྔགས་པར་བྱེད་པ་དེ་ལ་སླར་ཡང་བརྒལ་ཞིང་བརྟག་པར་བྱ་སྟེ།",
    "གཉིས་ཀ་ཡང་རང་བཞིན་མེད་པ་ཉིད་དུ་མཚུངས་བཞིན་དུ་དེས་གཅིག་མཐོང་ལ་ཅིག་ཤོས་མ་ཡིན་ནོ་ཞེས་བྱ་བར་མི་རིགས་སོ།",
    "དེའི་ཕྱིར་དེ་ལས་གཞན་པའི་བཅོམ་ལྡན་འདས་ཀྱི་གསུང་མངོན་སུམ་མ་ཡིན་པའི་དོན་སྟོན་པར་བྱེད་པ་ཡང་རང་ཉིད་ཀྱི་ཚུལ་གྱིས་དོན་ཇི་ལྟ་བ་བཞིན་ནོ་ཞེས་བྱ་བར་རྟོགས་པར་བྱ་སྟེ།",
    "དངོས་པོ་འགའ་ལ་ཡང་རང་བཞིན་བརྟག་པར་མི་ནུས་ཏེ།",
    "དངོས་པོ་གང་དག་སྐྱེ་བ་དང་ལྡན་པ་དེ་དག་ཀྱང་རྟག་པའི་ངོ་བོར་མེད་པས་རང་བཞིན་གྱི་མཚན་ཉིད་དང་མཚན་ཉིད་མི་མཐུན་པ་ཡོད་པ་ཡིན་དང་རང་བཞིན་ཡོད་པ་མ་ཡིན་པས་ཡོད་པ་དང་མེད་པའི་རྟོག་པ་དག་རྣམ་པར་གཞག་པར་མི་ནུས་སོ།",
    "དེ་ཁོ་ན་ཉིད་ཀྱང་རང་བཞིན་དང་ངོ་བོ་ཡིན་ནོ།",
    "མི་མཐུན་ཙ་ན་དེ་མེད་པ་ལག་རྗེས་ལུག་པ་རྗེས་དེས་ཅི་བྱ།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ་ དེ་ཡི་ཕྱིར་ན་མཁས་རྣམས་ཀྱིས།",
    "སྨད་བྱའི་སྐྱོན་དེ་དོན་ལ་ཡོད་ན་དེ་ཤེས་ནས་བདེན་པ་སྨྲ་བ་པོ་ལ་བྱ་བ་དང་མི་བདེན་པ་སྨྲ་བ་པོ་ལ་ཅི་སྨོས་ནི་མི་བདེན་པ་སྨྲས་པས་ཁོ་རང་སྐྱོན་ཅན་དུ་བསྟན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་རྩོམ་ཙ་ན་ཉེས་པ་དེར་འགྱུར་ཡང་མི་རྩོམ་པའི་ཚེ་ཆ་མེད་པས་སྐྱོན་དེ་མེད་དོ་སྙམ་ན།",
    "འབྲས་བུས་སྐྱེས་ཙ་ན་རྒྱུ་འཇིག་པས་འབྲས་བུ་རགས་པས་རྡུལ་བཤིག་པས་རྒྱུ་རྡུལ་དེ་རྟག་པ་མ་ཡིན་ནོ།",
    "འདི་བློས་ཞེན་པའི་དོན་ལ་སྐྱེས་བུས་ཤེས་པར་བྱེད་དོ་ཞེས་འདོད་ཅིང་རང་བཞིན་གྱིས་ནི་སྐྱེས་བུའི་འདོད་པ་རིག་ནས་དེ་ལོངས་སྤྱད་པའི་དོན་དུ་རྣམ་འགྱུར་རྣམས་སྤྲུལ་བར་བྱེད་དོ།",
    "སྡང་ཞིང་རང་ཡིད་ཕྱོགས་ལྷུང་མུན་པ་ནི།",
    "སོ་བཏང་ཙ་ན་ཁ་དོག་ཞིག་པས་བུམ་པའང་ཞིག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེས་ན་ཁྱེད་ལའང་རང་བཞིན་མེད་པའི་གཉིས་མེད་དེ་དེ་ལྟར་བསྟན་ན་རིགས་ཤིང་འཐད་ན་ངེད་ལ་ཚུར་ཆད་ལྟ་ཡིན་ནོ་ཞེས་བརྒལ་བ་གཞན་མང་པོ་ཅི་སྟེ་བྱེད།",
    "གཞན་ཡང་འབྲས་བུ་བྱེད་པའི་དུས་ན་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་དང་འདུག་པའི་དངོས་པོ་གང་ཡིན་པ་དེ་ཉིད་ལྷན་ཅིག་བྱེད་པའི་རྒྱུ་དང་བྲལ་བའི་དུས་ན་ཡང་འདོད་ན་ནི་དེའི་རྗེས་སུ་འཇུག་པ་ཉིད་ཀྱི་ཕྱིར་དེའི་ཚེ་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་རྣམས་ཀྱང་མགུལ་ནས་བཏགས་པ་བཞིན་དུ་སྟོབས་ཀྱིས་དྲངས་ནས་གནས་ཏེ།",
    "དེ་ཡང་རང་བཞིན་དེས་བརྩམས་དང་།",
    "དེ་བས་ན་འབྲེལ་པ་ཅན་མེད་པའི་ཕྱིར་འདུ་བ་ཡང་རང་བཞིན་མེད་པ་ཁོ་ནའོ།",
    "གཟུགས་ཀྱི་ཕུང་པོ་དཔྱད་པའི་ཞར་ལ་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པ་ཡང་རང་བཞིན་མེད་པར་བསྟན་ཏོ།",
    "དྲན་པ་ནི་མདུན་ན་འདུག་པའི་དངོས་པོ་ལ་ཡང་ཤིན་ཏུ་གསལ་བར་རྟོགས་པ་མ་ཡིན་ནོ།",
    "དེ་གཉིས་ཀྱང་འདུག་པའི་ཕྱིར་རོ།",
    "འདས་པའི་དུས་ན་ཡང་རང་བཞིན་གྱི་ངོ་བོ་ཉིད་ཀྱིས་མྱ་ངན་ལས་འདས་པ་སྟེ།",
    "བེ་རོ་ཙ་ན་རྡོ་རྗེ་བཞད་པའི་འདུས་འགྲེལ་དུ།",
    "ཞེས་བྱ་བ་སུན་འབྱིན་པའང་རང་ཉིད་དེ་གཉིས་མི་ཤེས་པར་སྟོན་པ་ཡིན་ནོ།",
    "ཞེས་སྒྲིབ་པ་ཟད་ཙ་ན་ཡེ་ཤེས་རྒྱུན་ཆད་པས་ཡེ་ཤེས་སྒྲིབ་པར་ཁས་བླངས་སོ།",
    "དེ་ཉིད་ཀྱང་རང་རིག་ཡིན་ཏེ་གཞན་གྱིས་རིག་ན་ཐུག་མེད་དུ་འགྱུར་བས་རང་མི་རྟོགས་པར་འགྱུར་རོ།",
    "བྱད་བཞིན་དུ་སྣང་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་བཞིན་ནོ་ཞེས་འགོད་པར་བྱེད་པས་སྐྱོན་མེད་དོ།",
