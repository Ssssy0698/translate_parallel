    "གང་དག་བདག་ཅག་གི་༡་གསང་སྔགས་འཆང་བ་དེ་དག་ལ་ལོག་འདྲེན་ནམ་༡༨།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་གིས་མི་སྙན་པ་བརྗོད་པར་བགྱིའོ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་མོན་སྲན་གྲེའུ་ལས་བགྱིས་པའི་སྣུམ་ཁུར་༤ཕུ་པ་ལ་ཀ་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བགྱིས་ལ་འདི་སྐད་དུ་ཆེ་གེ་མོ་ཞེས་བྱ་བའི་བགེགས་གྱིས་ཤིག་ཅེས་བརྗོད་ན་དེའི་ཚེ་ལོག་འདྲེན་དེ་དག་དགའ་ཞིང་མགུ་བར་གྱུར་པའི་ཡིད་ཀྱིས་བགེགས་བགྱིད་དོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་གིས་རིག་པ་མཆོག་དྲན་པར་བགྱིས་ན་དེ་དག་མི་འགུལ་ཏེ་འདི་སྐད་དུ་ཁྱེད་སེམས་དང་བར་གྱིས་ཤིག་ཅེས་བརྗོད་པར་བགྱིའོ།",
    "བསྒྲུབ་པའི་དུས་ན་རིག་སྔགས་འཆང་གིས་གྲོག་མཁར་གྱི་དོག་ས་ལས་གཙུག་ཕུད་འཕྱང་དགི་སྐུ་གཟུགས་བགྱིས་ལ།",
    "ལས་བྱང་བར་བགྱི་བར་འཚལ་ན་བ་ལང་གི་ལྷས་སུ་མཆིས་ལ་མར་གྱི་ངོ་ཞག་བརྒྱད་ནས་བརྩམས་ཏེ་ཟས་སུ་འོ་སྐྱོ་འཚལ་ཞིང་འབུམ་བཟླས་བརྗོད་བགྱིས་ན་རིག་པའི་རྒྱལ་པོ་ཚངས་པའི་གདུགས་ཀྱི་གུང་ལ་ཅེ་༧སྤྱང་མོ་སྒྲ་འབྱིན་ཏེ།",
    "རིག་སྔགས་འཆང་གིས་འདི་སྐད་དུ་བཅོམ་ལྡན་འདས་བདག་ཡོངས་སུ་བསྐྱབ་ཏུ་གསོལ།",
    "གལ་ཏེ་ལོག་འདྲེན་གྱི་གནས་སྒྲུབ་པར་འཚལ་ན་རིག་སྔགས་འཆང་གིས་ཡར་གྱི་ངོའི་ཉ་ནས་བརྩམས་ཏེ།",
    "མེ་ཏོག་དཀར་པོ་སྟོང་གིས་མཚན་མ་བསྣུན་ན་མཚན་བརྒྱར་འགས་༤ཏེ།",
    "ལོག་འདྲེན་རྣམས་གསད་༧དོ་སྙམ་དུ་ཁྲོས་པའི་ཡིད་ཀྱིས་བཟླས་བརྗོད་བགྱིས་ན་ལོག་འདྲེན་རྣམས་འགུམ་མོ།",
    "ཕྱེ་༡༡མ་རེད་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་བརྗོད་བགྱིས་ཏེ་དེ་ལྟར་དགུང་༡༢བདུན་དུ་བགྱིས་ན་བདུན་པའི་གདུགས་ལ་ཏི་ན་ར་སྦྱིན་པར་བགྱིད་དོ།",
    "ཤིང་བིལ་བའི་ནཤིང་གིས་༩༥ཞུགས་བུས་ཏེ་སྣ་ཚོལམའི་མེ་ཏོག་ཞོ་དང་སྦྲང་རྩི་དང་མར་ལ་སྨྱུགས་༡༡པ་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བགྱིད་༡༢ན་ཏི་ན་ར་སྩོལ་བར་བགྱིད་དོ།",
    "ཕོ་ཉ་མོ་རྣམས་ཀྱིས་ཐམས་ཅད་བགྱིའོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་གིས་རས་ཡུག་མ་གོད་པས་ཤིང་ནྱ་གྲོ་དྷ་དཀྲིས་ལ་རྩྭ་ལཀུ་ཤ་སྦམས་པའི་སྟེང་དུ་མཆིས་ཤིང་།",
    "དེ་ནས་རིག་སྔགས་འཆང་གིས་རས་ལ་བཏགས་ཏེ།",
    "གང་གི་ཚེ་ནམ་མཁའ་ལ་གནས་པ་དེའི་ཚེ་རིག་སྔགས་འཆང་རྣམས་ཀྱི་སྤྱོད་ཡུལ་དུ་༥མི་འགྱུར་རོ།",
    "འདི་སྒྲུབ་པའི་རིག་སྔགས་འཆང་གི་མཚམས་མ་མཆིས་པ་ལྔ་འབྱང་༩བར་འགྱུར་རོ།",
    "གང་གི་ཚེ་འགུམ་པ་དེའི་ཚེ་ལག་ན་རྡོ་རྗེའི་གནས་སུ་མཆིའོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་གིས་གཏོར་མའི་ཆོ་ག་རྒྱ་ཆེར་བགྱིས་ལ་མཚན་གྱི་སྟེང་དུ་ཞབས་གཡོན་པ་བཞག་སྟེ།",
    "འདི་དང་ཕོ་ཉ་མོ་རྣམས་ཀྱིས་༧ལས་ཀྱི་ཁྱད་པར་བརྗོད་པར་བྱའོ།",
    "རི་མོའི་སྐུ་གཟུགས་ཀྱི་མདུན་དུ་ལུང་ཐང་གི་ཤིང་གིས་༧ཞུགས་བུས་ལ་སྣ་༡༥མའི་མེ་༡༧ཏོག་མར་ལ་སྨྱུགས་༡་པ་ལན་བརྒྱད་༡༨སྟོང་སྦྱིན་སྲེག་བགྱིས་ན།",
    "ལན་བདུན་བཟླས་བརྗོད་བགྱིས་པའི་ཐལ་བའམ།",
    "བགེགས་དང་ལོག་འདྲེན་ཕུང་བར་བགྱི་བར་འཚལ་བས་སྒྲུབ་པའི་དུས་ན་ཨརྐའི་༥ཤིང་གིས་༦ཞུགས་བུས་ལ་སྐེ་༧ཚེའི་འབྲུ་ལས་ལན་བརྒྱ་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་ལོག་འདྲེན་རྣམས་ཕུང་བར་འགྱུར་རོ།",
    "ཟངས་ཀྱི་སྣོད་དུ་ཞོ་དང་འབྲས་ཆན་ནསྩལ་ཏེ་གདོང་གཏུགས་༢༢ལ་བསྟན་ཅིང་ཕྱུགས་ཆུང་གི་མིང་ནས་ཕྱུང་སྟེ་ལན་བརྒྱ་སྟོང་བཟླས་བརྗོད་བགྱིས་ན་ཕྱུགས་ཆུང་མཆིའོ།",
    "གལ་ཏེ་མི་མཆི་ན་ཕྱུགས་ཆུང་དེ་འགུམ་མོ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་གི་ནཝང་ལ་ལན་བརྒྱ་སྟོང་བཟླས་བརྗོད་བགྱིས་ལ་དེས་ཐིག་ལེ་བགྱིས་ན་༩དཔལ་ཆེ་བར་འགྱུར་རོ།",
    "རིག་པ་མཆོག་གིས་དྲི་དང་མེ་ཏོག་དང་བདུག་པ་ཐམས་ཅད་ལ་ཕུལ་ལ།",
    "རིག་པ་མཆོག་གི་ན་དྲི་དང་མེ་ཏོག་དང་བདུག་༩པས་བརྒྱན་པ་བགྱིས་ལ་མགོ་བོ་ཤར་ཕྱོགས་སུ་བསྟན་ཏེ།",
    "བདག་གིས་གང་བསམས་པ་དེ་དག་ཐམས་ཅད་འགྲུབ་པོ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་རིག་པ་མཆོག་གིས་ལག་ན་རྡོ་རྗེ་ལ་དྲི་དང་མེ་ཏོག་དང་བདུག་པ་རྣམས་དབུལ་༡ལོ།",
    "གྲོང་གི་ཕུག་རོན་གྱི་ཁར་ལྡོང་རོས་སྩལ་ལ་དྲོ་བར་གྱུར་པ་དང་།",
    "ཡིད་ཀྱིས་ལན་བདུན་བཟླས་བརྗོད་བགྱིས་པའི་མེ་ཏོག་གིས་སྨྲར་སྩལ་ཏོ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་པ་ལ་ཤའི་ཤིང་གིས་ནེཞུགས་བུས་ལ་ཀུ་མུ་དའི་༧མེ་ཏོག་ཞོ་དང་སྦྲང་རྩི་དང་མར་ལ་སྨྱུགས་༨པ་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་ཡིད་ཀྱིས་བསམས་པ་དེ་དག་ཐམས་ཅད་འགྲུབ་སྟེ།",
    "རིག་སྔགས་འཆང་གི་རྒྱལ་པོ་ཉིད་ནི་མ་གཏོགས་སོ།",
    "ཟས་སུ་འོ་སྐྱོ་འཚལ་ཞིང་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་བིལ་བའི་ཤིང་གིས་༡་ཞུགས་བུས་ལ་བིལ་བའི་ཡམ་སྲེག་ཤིང་འབུམ་སྦྱིན་སྲེག་བགྱིས་ན་རྒྱལ་པོ་ཉིད་དུ་༡༤༦༥་ཏོ།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་བགྱིས་ཏེ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་སེང་ལྡེང་གི་ཤིང་གིས་དགཞུགས་བུས་ལ་སྐེ་ཚེའི་མེ་ཏོག་ལ་ལན་བརྒྱ་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་ལས་གྲུབ་པའི་མཆོག་ཏུ་འགྱུར་རོ།",
    "ཤིང་གིས་༥ཞུགས་བུས་ལ་ཨརྐའི་༦མེ་ཏོག་ལས་༧ལན་འབུམ་སྦྱིན་སྲེག་བགྱིས་ན་ཏི་ན་ར་སྟོང་སྩོལ་ཏོཉན།",
    "ཀུ་མུ་དའི་༡་མེ་ཏོག་རྒྱས་པ་འབུམ་༡༥ཕུལ་ན་དེ་ནས་རིག་སྔགས་འཆང་ལ་ཆུའི་ནང་དུ་ཀླུས་རེག་༧པར་བགྱིད་དེ་དེ་ལ་འཇིགས་པར་མི་བགྱིའོ།",
    "ན་མོ་རཏྣ་ཏྲ་ཡ་༦༥སུ།",
    "དེའི་སྟེང་དུ་ཤིང་ཀུན་གྱི་ཤིང་གིས་༦ཞུགས་བུས་ལ་པྲི་ཡང་ཀུའི་ཡམ་སྲེག་ཤིང་ཡུངས་ཀུར་གྱི་འབྲུ་མར་ལ་སྨྱུགས་པ་༨བརྒྱ་སྟོང་སྦྱིན་སྲེག་བགྱིའོ།",
    "གྲོགས་པོ་དག་མ་འཇིགས་ཤིག་ཅེས་ལྷ་རྣམས་དབུགས་ཕྱུང་ནས་རིག་སྔགས་འཆང་གི་གན་དུ་མཆི་སྟེ་ཕྱིན་པ་དང་།",
    "ཚིག་འདི་སྐད་དུ་ཀྱེ་མའོ་རིག་སྔགས་འཆང་ལ་དགེ་སྦྱོང་གི་ཚུལ་མེད་དོ་ཞེས་སྨྲས་པ་དང་།",
    "དེའི་འོག་ཏུ་རིག་སྔགས་འཆང་གི་རིག་པ་མཆོག་གིས་སླར་བཏང་ནབར་བགྱིའོ།",
    "རིག་སྔགས་འཆང་བདུན་སྟོང་གིས་༩༥རིབདག་པོ་༦བསྐལ་པར་གནས་པར་འགྱུར་རོ།",
    "གནོད་སྦྱིན་མོ་གནས་པ་དེར་མར་གྱི་ངོ་ཞག་བརྒྱད་༤༩ལ་མཆིས་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་བགྱིས་ཏེ།",
    "དྲི་ཟ་རྣམས་ལྟུང་༡༨བར་བགྱིད་པར་འཚལ་བས་རྒྱ་མཚོར་འབབ་པའི་ཆུ་༡༩ཀླུང་གི་ངོས་སུ་ཡར་གྱི་ངོ་ཚེས་བརྒྱད་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་བགྱིས་ཏེ།",
    "ཁམ་པོ་ཛའི་༢་ཤིང་གིས་༢༡ཞུགས་བུས་ལ་ཡུངས་ཀུར་མར་དང་བསྲེས་པས་ལན་ཁྲིར་སྦྱིན་སྲེག་བགྱིའོ།",
    "རྐང་གིས་འགྲོ་བར་འགྱུར་རོ།",
    "སྤྲུལ་སྐོགས་བརྗེས་༡པ་དང་རྫས་དེ་དག་གིས་གནོད་སྦྱིན་གྱི་གཟུགས་ལ་བདུག་པར་བགྱིའོ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ལྕེ་འབབ་པས་བཅག་པའི་ཤིང་གིས་༧ཞུགས་བུས་ལ་ཁམ་པོ་ཛའི་༨ཡམ་སྲེག་ཤིང་བརྒྱ་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་རྡོ་རྗེའི་རིགས་ཐམས་ཅད་སྐྲག་པར་འགྱུར་རོ།",
    "མཚན་ལ་ཁྲག་གིས་བསྐུས་ལ་ཁྲོས་པ་དང་བཅས་པས་ལག་པ་གཉིས་གས་འཁྱུད་དེ་རིག་པ་ལན་བརྒྱ་སྟོང་བཟླས་བརྗོད་བགྱིས་ན་དེ་ནས་མཚན་འགུལ་ལོ་༡༡།་།",
    "སྐྲག་པར་འགྱུར་ཞིང་རང་གི་ཆོ་ག་རྒྱས་པ་རྣམས་ཀྱིས་༡་དངོས་གྲུབ་སྩོལ་ཏོ།་།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་སེང་ལྡེང་གི་ཤིང་གིས་༡་ཞུགས་བུས་ལ་ཁམ་པོ་ཛའི་བོཡམ་སྲེག་ཤིང་བརྒྱ་སྟོང་སྦྱིན་སྲེག་༡རིབགྱིས་ན་སྲེག་བླུགས་གེགསུམ་པའི་ཚེ་འདར་རོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་གིས་མྱུར་བར་ལག་ན་རྡོ་རྗེའི་གཟུགས་འོ་མས་བཀྲུ་བར་བགྱིའོ།",
    "བཅོམ་ལྡན་འདས་རིག་པའི་རྒྱལ་པོ་བསྒྲུབ་པའི་རིག་སྔགས་འཆང་ལ་གལ་ཏེ་དངོས་གྲུབ་ཏུ་མ་གྱུར་ན་རིག་སྔགས་འཆང་དེས་ལས་བདག་གིར་བྱ་བ་ཡིན་པར་དམིགས་པར་བགྱིའོ།",
    "མ་གྲུབ་ན་ཡང་ལས་བདག་གིར་བྱ་བ་ཡིན་པར་དམིགས་པར་བགྱིའོ།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་ནབགྱིས་ལ་དུར་ཁྲོད་ཀྱི་ཤིང་གིས་༥",
    "སེང་ལྡེང་གི་ཡམ་སྲེག་གི་ཤིང་ལ་༤བདག་གི་ཁྲག་༥བྱུགས་ལ་ལན་བརྒྱད་ནེ་སྟོང་སྦྱིན་སྲེག་བགྱིའོ།",
    "གལ་ཏེ་མ་མཆིས་ན་རང་གི་ཤས་ལན་བརྒྱད་༥༧སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་མཆི་༨བར་བགྱི་སྟེ།",
    "གལ་ཏེ་རིག་སྔགས་འཆང་གིས་ལས་ཐོག་མར་བརྩམས་ཏེ་༡༢།",
    "བཅོམ་ལྡན་འདས་གཞན་ཡང་གང་གིས་རིག་སྔགས་འཆང་རྣམས་ཀྱི་དངོས་གྲུབ་ཏུ་འགྱུར་བའི་རྫས་རྣམས་མི་འཕྲོགས་༢་པར་བརྗོད་པར་བགྱིའོ།",
    "བཅོམ་ལྡན་འདས་རིག་སྔགས་འཆང་གིས་ལིག་བུ་མིག་༢༢དང་ལྡོང་རོས་ལ་སོགས་པ་སྒྲུབ་ན་ཐོག་མར་འོ་མས་བཀྲུ་བར་བགྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་༥མིང་ཐོས་ནས་ཡིད་ཀྱིས་ཀྱང་འཁུ་བས་སེམས་པ་ནི་ལྷ་དང་བཅས་པ་དང་།་",
    "སྟོབས་དང་ཕ་རོལ་གནོན་པ་དཔག་ཏུ་མེད་པ་ཁྱོད་༡་སེང་གེའི་སྒྲ་འདི་ལྟ་བུ་འབྱིན་པ་ལེགས་སོ་ཞེས་ཏེ།",
    "དེ་ནས་རིག་སྔགས་འཆང་གིས་རིག་སྔགས་བསྒྲུབ་པར་བགྱིའོ།",
    "དེ་ཉིད་དུ་མཆིས་ལ་རིག་སྔགས་འཆང་གིས་ཡང་རིག་པ་བསྒྲུབས་ན་མྱུར་དུ་འགྲུབ་པོ།",
    "དཔག་ཏུ་མ་མཆིས་པར་བཟླས་བརྗོད་བགྱིས་ན་གནོད་སྦྱིན་མོ་མཆི་བར་འགྱུར་ཏེ།",
    "གང་གི་ཚེ་ངས་ཆེ་གེ་མོ་ཞེས་བྱ་བ་ལ་རྒྱོབ་ཤིག་རྒྱོབ་ཤིགཅི་རི།",
    "ནག་མོ་དྲག་མོའི་ལས་རྣམས་ལགས་ཏེ།",
    "གསང་སྔགས་ཐམས་ཅད་དུ་གསང་སྔགས་གང་ལས་མི་བགྱིད་པ་དེ་ནག་མོ་དྲག་མོ་འདིས་བཀུག་ན་དེས་༡་ལས་བགྱིད་དོ།་།",
    "བཀུག་ཀྱང་གལ་ཏེ་མ་གྲུབ་ན་ཕྱེ་མ་རེད་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་རིག་སྔགས་དེ་ལན་བདུན་བརྗོད་ལ།",
    "དེའི་འོག་ཏུ་ནག་མོ་དྲག་མོའི་སྔགས་ལན་བརྒྱ་རྩ་བརྒྱད་བརྗོད་པར་བགྱིའོ།",
    "གལ་ཏེ་ཡི་གེ་མ་ཚང་བར་གྱུར་ན་རིག་པ་མཆོག་གིས་ཚང་བར་བགྱིད་དོ།",
    "རང་གི་ཁྲག་གིས་ཤིང་ཏ་ལའི་ལོ་མ་ལ་བྲིས་ཏེ།",
    "གདོན་དགུག་༧ན་མེ་ཏོག་གིས་བགྱིའོ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་བ་ལང་གི་ཤས་བདུག་ཪྴཔར་བགྱིའོ།",
    "གལ་ཏེ་ནག་མོ་དྲག་མོ་བསྒྲུབ་པར་འཚལ་ན་ཐོག་མ་ཉིད་དུ་ཟས་སུ་འོ་སྐྱོ་འཚལ་ཞིང་ལན་འབུམ་བཟླས་བརྗོད་བགྱིའོ།་།",
    "དེའི་གཡོན་རོལ་ཏུ་ནག་མོ་དྲག་མོ་བྲི་བར་བགྱིའོ།",
    "མཆིས་པ་དང་རིག་པ་མཆོག་གིས་མཆོད་ཡོན་དབུལ་ལོ།",
    "ནག་མོ་དྲག་མོའི་ཆོ་ག་རྫོགས་སོ།",
    "དུར་ཁྲོད་ཀྱི་ཐལ་བ་ལ་གཟུགས་བགྱིས་ལ་༩ལན་༧གསུམ་བཟླས་བརྗོད་བྱས་པས་གདོན་གྱིས་གཏོང་༡༡བར་བགྱིད་དོ།",
    "རི་མོའི་སྐུ་གཟུགས་ཀྱི་མདུན་དུ་ཞུགས་བུས་ལ་ཀ་ར་བཱི་༡༢རའི་མེ་ཏོག་དང་༡་ཞོ་དང་སྦྲང་རྩི་སམར་ལ་སྨྱུགས་དཔ་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བགྱིའོ།",
    "དགྲ་བསྐྲད་པར་འཚལ་ན་ཡར་གྱི་ངོ་ཚེས་གཅིག་ལ་དུར་ཁྲོད་ཀྱི་གནས་སུ་ཞུགས་བུས་ལ་དུར་ཁྲོད་ཀྱི་ཐལ་བས་༤རིསྦྱིན་སྲེག་བགྱིས་ན་བསྐྲད་པར་འགྱུར་རོ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་པྲི་ཡང་ཀུའི་ཤིང་གིས་༦ཞུགས་བུས་ལ་བེ་གངྐ་༧ཏའི་ཡམ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་མོན་སྲན་གྲེའུ་ལས་ལན་བརྒྱ་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་དབྱེ་བ་༡༢བགྱིས་པར་འགྱུར་རོ།",
    "ཐལ་བས་ནི་རྡོ་རྗེ་རི་ར་བར་འགྱུར་རོ།"
  ]
}