    "གང་ལ་གང་གིས་གཏད་པས་འགྲོ་འདི་ནི།",
    "ཤཱ་ནའི་གོས་ཅན་རང་གི་རྒྱལ་ཚབ་ཏུ།",
    "འགྱུར་བར་གཟིགས་ནས་ལོ་ལྔའི་དུས་སྟོན་རྗེས།",
    "མཛེས་དགའ་དུག་གིས་བརྒྱལ་ལས་སོས་པར་མཛད།",
    "རབ་གཏུམ་སྲོག་གི་ཆད་པ་ལས་བཏོན་ནས།",
    "དེ་ལྟའི་ཆོ་འཕྲུལ་གསལ་པའི་ལང་ཚོ་ཡིས།",
    "གང་གི་རྣམ་ཐུར་ཐུར་བའི་དགའ་སྟོན་ནི།",
    "ཐུབ་པའི་མཛད་མཆོག་མཆོག་གི་རྗེས་འགྲོ་བ།",
    "སྐྱིལ་ཀྲུང་གཅིག་གིས་ནོན་པའི་རྫུ་འཕྲུལ་གྱིས།",
    "བཟུང་ནས་ཐུབ་བསྟན་ཉིན་མོ་བཞིན་མཛད་པའི།",
    "ཤཱ་ནའི་གོས་ཅན་གསུང་གི་བདུད་རྩི་ཡིས།",
    "རོ་རུལ་གཙུག་རྒྱན་བཅིངས་པ་འཕགས་མཆོག་གི།",
    "མཐུ་ལས་གང་གིས་འདོར་བར་མ་ནུས་པས།",
    "ཐུན་མོང་ཐུན་མོང་མིན་པའི་བསྡུ་བ་ཡིས།",
    "རྒྱལ་བའི་ལུང་བསྟན་གསེར་གྱི་མེ་ཏོག་གི།",
    "རྒྱལ་བའི་རྗེས་སུ་མཐུན་པའི་མཚན་བཟང་གིས།",
    "ཡངས་ཤིང་བདེ་བ་གང་གིས་སྲོལ་ཕྱེ་བ།",
    "ཇི་བཞིན་ཁྱོད་ལས་གཞན་གྱིས་ཇི་ལྟར་བཀྲལ།",
    "ཁྱོད་གསུང་ཉིན་མོར་འབྱེད་འདིས་མ་བསྐྱངས་ན།",
    "ལྟ་བའི་མཐར་ཐུག་དཔལ་ལྡན་ཐལ་འགྱུར་སྲོལ།",
    "ཁྱོད་དྲིན་ཁོ་ནས་འགྲོ་འདིར་ད་དུང་སྤྱོད།",
    "ཁྱོད་ཀྱི་ཐུགས་སུ་མ་ཆུད་ཆ་ཤས་ཅི།",
    "བརྒྱ་ཕྲག་དྲུག་གི་བགྲང་བྱར་ངོ་མཚར་གྱི།",
    "རྒྱལ་བའི་དགོངས་ཟབ་ཟབ་མོའི་ང་རོ་ཡིས།",
    "གང་སྐུ་པདྨའི་ལང་ཚོ་ལས་བསྐྲུན་ཏེ།",
    "ས་སྟེང་འདི་ན་འཕགས་མཆོག་ཁྱོད་ཁོ་ན།",
    "སྐུ་ལུས་སྟག་མོར་བརྩེ་བས་དངོས་སུ་བྱིན།",
    "མཁས་དང་གྲུབ་པའི་གོ་འཕང་རྩེ་མོར་གཤེགས།",
    "རི་མོའི་བ་ལས་བཞོས་པའི་འོ་མ་ཡིས།",
    "དཔུང་ཚོགས་མཚོན་ཆའི་འཕྲུལ་འཁོར་གཡོ་བ་ཅན།",
    "རི་མོའི་བ་ལས་འོ་མ་འཇོ་བ་དང་།",
    "ཞེན་པ་བཟློག་པའི་ཆོ་འཕྲུལ་འདི་རེ་མཚར།",
    "དབྱིག་ལྡན་བཞིན་རས་འཛུམ་དཀར་ལང་ཚོས་དཀྲིས།",
    "ཚུར་མཐོང་མོས་ངོར་ཚུར་མཐོང་ཚུལ་མཛད་ཀྱང་།",
    "མཆོག་གི་ས་ལ་བཞུགས་པའི་རང་རྟགས་ནི།",
    "རྒྱལ་བའི་དགོངས་ཟབ་ཟབ་དོན་ཇི་བཞིན་གཟིགས།",
    "དཔལ་ལྡན་ཐལ་འགྱུར་འགྱུར་མེད་གྲུབ་པའི་མཐའ།",
    "འགོག་པ་མེད་པའི་འཕགས་མཆོག་འདི་རེ་བསྔགས།",
    "དེ་ཡི་གཅུང་པོ་འཕགས་མཆོག་དབྱིག་གི་གཉེན།",
    "ཡི་དམ་ཞལ་གཟིགས་ཏིང་འཛིན་དུ་མ་བརྙེས།",
    "མཁས་མཆོག་དབྱིག་གི་གཉེན་འདིའི་གསུང་སྐྱེས་ཚོགས།",
    "ལང་ཚོར་སྤུད་པའི་ངོ་མཚར་ཇི་ལྟར་འདྲེན།",
    "བསིལ་ལྡན་བསིལ་བའི་དཔལ་དུ་བདག་གིར་མཛད།",
    "སྲོང་བཙན་ཨ་མི་དྷེ་ཝའི་གཙུག་ཏོར་བཅས།",
    "རི་བོ་ཏ་ལ་གང་སྙམ་འཕྱང་མོ་ཉུག།",
    "འཚེ་བ་མེད་པར་སྤྲུལ་བའི་དམག་དཔུང་གིས།",
    "རྒྱལ་བསྟན་སྣང་བྱེད་སྒྲིབ་ཏུ་རེ་བ་ཡང་།",
    "མི་ལས་མཚན་མོ་ལྷ་འདྲེས་ལྷག་པ་བཞེངས།",
    "བཀའ་དྲིན་འདི་འདྲ་གང་གིས་གཞལ་བར་ནུས།",
    "ས་སྐྱོང་ཚོགས་ཀྱི་ཟུར་ཕུད་ཞབས་སེན་གྱི།",
    "དེ་ནས་སྐལ་ངན་མུན་སྟག་མཚན་མོ་ནི།",
    "སྟེང་ཟིལ་ཁྲོ་གཉེར་གླལ་བའི་སྲིན་མོའི་ཁས།",
    "དུམ་བུར་བཀས་པའི་ཚ་དབལ་ངན་སོང་གི།",
    "ཡང་ཡང་ནམ་མཁའ་མ་འ་གླང་གིས་སྒྲིབ་བཞིན།",
    "ཡང་ཡང་སྐྱེས་མཆོག་མཆོག་གི་འཕྲིན་ལས་ཀྱིས།",
    "སྐལ་ངན་མཚན་མོ་སྲིན་མོའི་ཁར་བཟུང་ཡང་།",
    "རྒྱལ་བསྟན་འོད་སྟོང་ལང་ཚོ་གསར་པའི་བཞིན།",
    "བོད་ཡུལ་མུན་པའི་གླིང་གི་མགོན་དུ་དྲངས།",
    "གངས་ཅན་འོ་མཚོ་མཛེས་པའི་ལང་ཚོར་བཀབ།",
    "གཞུང་ལུགས་ཡལ་གའི་ཁྱོན་ཡོངས་གསང་ཆེན་གྱི།",
    "ཁྲེགས་ཆོད་ཐོད་རྒལ་གོམ་པའི་སྟབས་གཅིག་གིས།",
    "བསིལ་ལྡན་ས་འཛིན་ཚང་ཚིང་དཀྲིགས་པར་ཟའགའ་རེ་རེ་ཟིག་ཙམ་དུ་བཀོད།",
    "ལི་ཁྲིའི་ལང་ཚོ་ངུར་སྨྲིག་གོས་ཀྱིས་བཀབ།",
    "མཁྱེན་པའི་གྲྭ་ཟུར་གཅིག་ཏུ་ཤེས་བྱའི་ཁྱོན།",
    "འཇམ་དབྱུངས་དབྱུངས་ཅན་གང་གི་མཁྱེན་རབ་ཚུལ།",
    "ཐུགས་རྗེ་རྗེ་བཙུན་སྤྱན་རས་གཟིགས་ཉིད་དེ།",
    "མཁའ་དབྱིངས་འོད་སྟོང་ལང་ཚོས་བཅིངས་པ་ན།",
    "མཁྱེན་པའི་ཟེར་རྣོན་ཆ་ཤས་གཅིག་གིས་ཀྱང་།",
    "ཁྱོད་ནི་སྔོན་མེད་དྲང་སྲོང་ཛཉྩ།",
    "མཁས་གྲུབ་ཉི་ཟླའི་ཟེར་རྣོན་སྟོང་གིས་ཀྱང་།",
    "ཁྱོད་ཀྱི་མཁྱེན་རབ་འགྲམ་ཆང་གིས་ཕྱེ་ཚེ།",
    "བ་གམ་གང་བ་རྫོགས་པའི་འོད་སྣང་གིས།",
    "ཁྱོད་ཐུགས་རིན་ཆེན་འབྱུང་གནས་ལ་བསྐྱིལ་ནས།",
    "འཇམ་དབྱངས་ཞལ་ལུང་སྲུབ་ཤིང་གིས་བླངས་པའི།",
    "བདུད་རྩིའི་དགའ་སྟོན་སྦྱིན་མཁས་ཁྱོད་ལས་སུ།",
    "གཟིགས་ནས་འགྲོ་ལཱ་ལུ་འུར་སྟོན་འདི་བསྔགས། རྗེ་བཙུན་གྱི་བཀའ་བཞིན་སྒྲུབ་པ་ལ་གཤེགས་ཏེ་བསག་སྦྱང་རླབས་ཆེ་མཛད་པས་དག་པའི་གཟིགས་པ་འབྱམས་ཀླས་པ་དང་།",
    "སྲས་བཅས་རྒྱལ་ཀུན་འཛུམ་ཞལ་ཁྱོད་ལ་ངོམ།",
    "པཎ་གྲུབ་ཀུན་ཀྱང་ཟབ་དོན་ཁྱོད་ལ་གྱེར།",
    "ཉམས་རྟོགས་བདུད་རྩིའི་བཅུད་ཀུན་ཁྱོད་ཀྱི་གསོལ།",
    "དཀྱིལ་འཁོར་རྒྱ་མཚོའི་གཙོ་བོར་ཁྱོད་ཉིད་བཞེངས།",
    "ས་དེ་འོག་མིན་དངོས་སམ་འཕྱང་མོ་ཉུག།",
    "ཕྱི་རུ་གཟིགས་སྣང་སྣང་སྟོང་རོལ་པས་འབྱམས།",
    "དེ་ལ་གང་གི་ཕྱིར་ན་བདག་གི་དོན་གཉིས་དང་གཞན་གྱི་དོན་གསུམ་གྱི་ཆེད་དུའོ།",
    "གང་གིས་ཤེ་ན་དཔལ་ཆེན་པོ་དུར་ཁྲོད་ཀྱི་དཀྱིལ་འཁོར་དུ་དངོས་གྲུབ་ཐོབ་པའི་བལསློབ་དཔོན་ཧཱུྃ་མཛད་ཉིད་ཀྱིས་འདུད་པའོ།",
    "གང་གི་ཚེ་ཞེ་ན་རྩོམ་པའི་དུས་འདི་ཉིད་དུའོ།",
