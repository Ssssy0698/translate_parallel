    "དེ་ལྟ་བུར་གྱུར་པའི་ཡན་ལག་ཐམས་ཅད་མ་ཚང་བ་རྣམས་ཀྱིས་ཀྱང་ཇི་ཞིག་ལྟར་དེ་དག་གིས་བདག་བྲན་བཞིན་བྱས་སོ་སྙམ་དུ་རང་ཉིད་ལ་རྣམ་པར་དཔྱོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "བདག་གི་སེམས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་གི་སེམས་ཉིད་ལ་བརྟེན་བཅས་ནས་བདག་ཉིད་ལ་གནོད་པ་བྱེད་པ་སྟེ།",
    "ཅིའི་ཕྱིར་དེ་ལྟར་དེ་དག་ཁྱོད་མི་བཟོད་ཅེ་ན།",
    "རི་རབ་ཀྱང་ཞེས་བྱ་བ་ནི་གཞན་ངན་ངོན་ལྟར་རེ་ཞིག་ཞོག།",
    "འོ་ན་ཁྱོད་དེ་དག་ལ་ལ་ནི་དེ་ལྟར་འཁོན་དུ་འཛིན་པ་དམ་པོར་བྱེད་ལ་དགྲ་གཞན་དག་ལ་ནི་མ་ཡིན་པ་ཇི་ལྟ་བུ་ཡིན་ཞེ་ན།",
    "བདག་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་བས་ན་ངེས་པར་འདི་དག་ཉིད་བདག་གིས་བྱ་བར་འོས་པ་ཡིན་ནོ་ཞེས་གསུངས་པ།",
    "ཡང་ཉོན་མོངས་པའི་དགྲ་བོ་རྣམས་སྤངས་པའི་ཕྱིར།",
    "དེ་བས་ན་འདིར་བདག་གི་འདི་ཉིད་ནི་རིགས་པ་ཡིན་ནོ་སྙམ་དུ་བསྟན་པར་བྱ་བ།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་གང་གི་ཕྱིར་དེ་ལྟར་དེ་དག་ཉེས་པ་ཐམས་ཅད་ཀྱི་རྒྱུ་ཡིན་པ་དེའི་ཕྱིར་རོ།",
    "ཁུར་ཞེས་བྱ་བ་ནི་གླང་གི་རྒྱབ་ཏུ་བཀལ་བའི་ཁལ་ཞེས་བྱའོ།",
    "འདི་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པའི་རང་བཞིན་ཏེ།",
    "མངོན་སུམ་དུ་ཞེས་བྱ་བ་ནི་བདག་གིས་མཐོང་བ་བཞིན་དུའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཉོན་མོངས་པ་དག་ཡིན་ཏེ།",
    "མདའ་མདུང་གི་མཚོན་གྱིས་ཕོག་པའི་སྡུག་བསྔལ་ཁྱད་བསད་ནས་ཏེ།",
    "བརྟན་པ་རྣམ་པས་ཉོན་མོངས་པ་ལྷག་པར་གསུངས་པ།",
    "སྡུག་བསྔལ་བརྒྱ་ཕྲག་གིའོ།",
    "རྒྱུར་གྱུར་པ་གང་གིས་ཀྱང་ཞེས་པ་ནི་རང་གི་སེམས་ཀྱི་རྟོག་པ་སྟེ།",
    "གལ་ཏེ་དེ་ལྟར་བརྩོན་པར་བྱེད་པ་དེ་ལྟ་ཡིན་ན་ཡང་རང་གི་བདེ་བ་དང་མི་འགལ་བ་ཉིད་དུ་བརྩོན་པར་བྱ་བར་རིགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "དགུན་གྱི་དུས་ཀྱི་མཚན་མོ་ཁ་བའི་ཚོགས་སྡུག་པར་འཇུག་པར་ད་བྱེད་པ་དང་།",
    "མུན་པ་དང་ལྡན་པའི་མཚན་མོ་སྡིག་སྦྲུལ་ལ་སོགས་པའི་འཇིགས་པའི་སྡུག་བསྔལ་རྩིས་མེད་པར་འགྲོ་བ་ན་སྲོག་ལ་ཐེ་ཚོམ་ཟ་བ་བྱ་དཀའ་བའི་ལས་ལ་འཇུག་པར་བྱེད་དོ།",
    "དེ་བཞིན་དུ་གཞན་གྱི་བུད་མེད་ལ་སྤྱོད་པ་ལ་སོགས་པ་དང་།",
    "དེ་ལྟར་ཞིང་པ་སྟེ་རྨོད་པར་བྱེད་པ་པོ་ཞིང་གི་ལས་ཀྱིས་ཉེ་བར་འཚོ་བ་ཞིང་རྨོད་པ་ལ་སོགས་པའི་བྱེད་པ་བྱས་པ་རྣམས་ཀྱང་ཉིན་མཚན་དུ་གྲང་བ་དང་།",
    "དེ་བཞིན་དུ་བདག་གི་གདོང་དུ་ལྟ་ཞིང་འཚོ་བ་ཞབས་འབྲིང་བ་ལ་སོགས་པ་དང་།",
    "བདག་གིས་སླར་ཤིན་ཏུ་ཡང་བསྟེན་པར་བྱ་བར་རིགས་པ་ཡིན་ནོ་སྙམ་དུ་དགོངས་པའོ།",
    "གང་གི་ཚེ་བདག་ཉིད་ཀྱང་སྲེད་པ་ལ་སོགས་པའི་ཉོན་མོངས་པ་རྣམས་མ་གྲོལ་བ་དེའི་ཚེ་རང་གི་ནུས་པ་ལ་མ་བལྟས་པ་ཁོ་ནར་ཚིག་ཏུ་རྗོད་པར་བྱེད་པ་ནི་སེམས་རྣམ་པར་འཁྲུགས་པར་གྱུར་པ་ཡིན་ནོ་སྙམ་དུ་བསམས་ནས་ཕྱིར་མི་ལོག་པར་དམ་བཅས་པ་ལས་བརྟན་པར་འགྱུར་བར་བྱའོ།",
    "བདག་གི་ཉོན་མོངས་པ་མ་སྤངས་པར་གཞན་གྱི་ཉོན་མོངས་པ་སྤང་བ་ཞེས་བྱ་བ་ནི་མི་ནུས་ཏེ།",
    "འདིར་ཞེན་བྱ་ཞིང་སྟེ་འདིར་ཉོན་མོངས་པ་གཞོམ་པའི་དོན་དུ་བརྩོན་འགྲུས་བརྟེན་པ་ལ་ནན་ཏན་དུ་བྱའོ།",
    "གཡུལ་སྤྲད་ནི་རྩོད་པས་ཡིད་བྱུང་བ་སྤངས་པ་རྣམ་པ་ཐམས་ཅད་དུ་འཐབ་མོ་བརྩམ་པའོ།"
  ]
}