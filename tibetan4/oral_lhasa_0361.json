    "མཁའ་སྤྱོད་མ་དང་ཨོཾ་ཧཱུྃ་སྭཱ་ཧཱའ་ཞེས་པ་འགུགས་པར་བྱེད་པའོ།",
    "ས་སྤྱོད་མ་དང་ཨོཾ་གྷུ་སྭཱ་ཧཱའ་ཞེས་པ་གསོད་པར་བྱེད་པའོ།",
    "སོ་སོའི་ཁྱད་པར་ནི།",
    "ཅེས་བཟླས་ན་ཉི་མ་བདུན་གྱིས་སྐྲོད་པར་འགྱུར་རོ།",
    "བསྒྲུབ་བྱ་དང་མ་ཧེ་ལ་ཞོན་པ་དག་དྲག་ཏུ་འཐབ་པར་བསྒོམས་ལ།",
    "རྣམ་པར་རྟོག་པ་བསྐྲོད་པ་དང་།",
    "འཇིགས་པའང་འཇིགས་པར་མཛད་པ་བྲིའོ།",
    "དུར་ཁྲོད་ཀྱི་རྒྱུས་པའམ་རོ་རས་སོགས་ལས་བྱས་པའི་སྲད་བུས་ཐིག་གདབ་ཅིང་།",
    "འཇིགས་པ་མཐའ་ཡས་ལ་སོགས་པའང་འཇིགས་པར་མཛད་པ་བྲི་ཞིང་།",
    "དེས་ཀླུ་རྣམས་བསྐུལ་ཞིང་སྤྲིན་ཆེན་པོ་བརྒྱད་གཡོས་ཏེ་ཆར་གྱི་རྒྱུན་འབེབས་པར་བསམས་ལ།",
    "སྔགས་ཀྱི་སྒྲ་སྐྱེ་བོས་མི་ཐོས་ཤིང་དབེན་པར་བྱས་པའི་གནས་སུ་སྔགས་བཟླ་སྟེ།",
    "སྔགས་ནི་ཨོཾ་ནས་གྷོ་ཊའི་བར་གཟུངས་ཀྱི་ཚིག་བསྒྱུར་དུ་མེད་པར་བཞེད་པའམ།",
    "གྷ་ཊ་གྷ་ཊ་ནི་བརླག་བརླག་གྷོ་ཊ་ཡ་གྷོ་ཊ་ཡ་ནི་བརླག་པར་གྱིས་བརླག་པར་གྱིས།",
    "ཀྵོ་བྷ་ཀཱ་རཱ་ཡ་ནི་བསྐྱོད་པར་གྱིས།",
    "གལ་ཏེ་དེ་ལྟར་བྱས་ཀྱང་ཆར་མི་འབབ་ན་དེའི་ཚེ་ཀླུ་རྣམས་ཀྱི་མགོ་ཨརྫ་ཀའི་དོག་པ་སྟེ།",
    "དེ་ཉིད་བདེ་བ་ལྔའམ་རིགས་བརྒྱ་ལ་སོགས་པར་དབྱེ་ཞིང་དྲལ་བ་ངེས་དོན་ནོ།",
    "དངོས་གྲུབ་ཀྱི་དོན་དུ་བྱེ་བ་བཟླས་ཤིང་སྔོན་དུ་བསྙེན་པ་འབུམ་བྱས་ཏེ།",
    "དེ་བསྒྲུབས་ལ་རིལ་བ་སྤྱི་བླུགས་ཀྱི་མགྲིན་པ་བསྐོར་ཞིང་བསྐོར་ནས་བཅག་ན་དགྲ་ཐམས་ཅད་ཀྱི་མགོ་མེད་པར་འགྱུར་རོ།",
    "དེའི་སྔོན་དུ་བསྙེན་པ་འབུམ་བྱས་ཏེ་རི་ལུ་དེ་བསྒྲུབས་ལ།",
    "འདི་སློབ་དཔོན་མཚོ་སྐྱེས་རྡོ་རྗེས་མཛད་པར་གྲགས་སོ།",
    "ལྷ་རྣམས་དགས་པར་འདོད་པས།",
    "ཀུ་ཋཱ་ར་ཙྪིནྣ་དང་བསྲེས་ལ་ཉི་མ་གཟས་ཟིན་པ་ལ་མི་བསྐྱོད་པ་དང་བཏག་ཅིང་བཏགས་ནས་དགྲ་སྟ་བྱས་ཏེ།",
    "བྱེ་བ་བཟླས་ནས་ཐིག་ལེ་བྱས་ཏེ་གང་ལ་ཕྱག་བྱས་པ་དེ་འགས་སོ།",
    "འཇིག་རྟེན་པའི་ལྷའི་གཟུགས་རྣམས་དགས་པར་བྱེད་འདོད་པས་ཐིག་ལེ་བསྒྲུབ་སྟེ།",
    "མི་བསྐྱོད་པ་སྟེ་དྲི་ཆུ་དང་ལྷན་ཅིག་བཏག་ཅིང་བཏགས་ནས་དེའི་འདེ་གུ་ལ་དགྲ་སྟའི་གཟུགས་བྱས་ཏེ།",
    "གང་ལ་ཕྱག་བྱས་པ་དེ་འགས་སོ།",
    "འདི་བིརྺ་པས་མཛད་པར་གྲགས་སོ།",
    "ཆང་བསྐྱུག་པར་བྱ་བར་འདོད་པས།",
    "མྃ་གྱི་རྣམ་པ་གྱུར་པ་ལས་ཆང་ལྟོ་བར་བསྒོམས་ཏེ་སྐྱུག་པར་བྱེད་པར་བལྟས་ན་ཆང་སྐྱུག་གོ།",
    "བསྒྲུབ་བྱ་ཆང་བསྐྱུག་པར་བྱ་བར་འདོད་པས།",
    "ཀ་ཀཱ་མ་ཙི་ཀའི་ཁུ་བས་ཐིག་ལེ་བྱས་ནས་སྔགས་བཟླ་སྟེ།",
    "འདི་སློབ་དཔོན་པདྨ་འབྱུང་ནས་མཛད་པར་གྲགས་སོ།",
    "ས་ལུ་བཏགས་པའི་འགྱུར་བ་ལ་ཟླ་བ་དང་ཉི་མ་བྱས་ལ་རྡོ་རྗེའི་ཆུ་ལ་གཞུག་ཅིང་སྔགས་བཟླ་སྟེ།",
    "ཉི་མ་དང་ཟླ་བ་དག་ཡང་དག་པར་གནས་ཤིང་ཉིན་མཚན་བྱེ་བྲག་མེད་པར་འགྱུར་རོ།",
    "ཟླ་བ་དང་ཉི་མ་རྣམ་པར་འཛིན་པ་ཞེས་བྱ་བའི་ཆོ་གའོ།",
    "འབྲས་ས་ལུ་བཏགས་པའི་འགྱུར་བ་དེའི་ཟན་ལ་ཟླ་བ་དང་ཉི་མ་གང་འདོད་པའི་གཟུགས་བྱས་ཏེ་རླངས་པ་ལ་བཙོས་ལ།",
    "ལས་སྦྱོར་གྱི་ཚེ་ཁྲི་བཟླས་པས་ཉི་མ་དང་ཟླ་བ་དག་མི་གཡོ་བར་ཡང་དག་པར་གནས་ཤིང་།",
    "ཉིན་མཚན་གྱི་བྱེ་བྲག་མེད་པར་འགྱུར་རོ།",
    "ཟླ་བ་དང་ཉི་མ་རྣམ་པར་འཛིན་པ་ཞེས་བྱ་བའི་ཆོ་གའོ།",
    "འདི་བིརྺ་པས་མཛད་པར་གྲག་གོ།",
    "ཞེས་བྱ་བ་གཞོན་ནུ་མ་འདི་ལྷའི་སྤྱན་དང་ལྡན་པར་གྱིས་ཤིག་པའི་སྔགས་འདིས་སྔོན་དུ་བསྙེན་པ་འབུམ་བྱས་ཏེ།",
    "ཁ་ཟས་ཀྱིས་བསྙེན་བཀུར་བྱས་ནས་ནང་པར་ངའི་དོན་སྒྲུབས་ཤིག་ཅེས་སྙན་གསན་དབབ་བོ།",
    "ཞེས་གསལ་བར་སྨྲ་སྟེ་འདིས་དོན་གཞན་སྒྲུབ་པའི་ཚུལ་ཡང་ཤེས་པར་བྱའོ།",
    "བེ་ཌུ་ཡཱ་བེ་ཌུ་ཡཱ་ཞེས་བརྗོད་ན་གླང་པོ་ཆེ་འབྲོས་པར་འགྱུར་རོ།",
    "མཱམྨཱ་མཱམྨཱ་ཞེས་བརྗོད་ན་སྟག་འབྲོས་པར་འགྱུར་རོ།",
    "ཏིལླི་ཡ་ཏིལླི་ཡ་ཞེས་བརྗོད་ན་བསེ་འབྲོས་པར་འགྱུར་རོ།",
    "ཨི་ལི་མི་ལི་ཕུ་ཕུ་ཞེས་བརྗོད་ན་སྦྲུལ་འབྲོས་པར་འགྱུར་རོ།",
    "སྔགས་འདི་དག་ལ་སྔོན་དུ་བསྙེན་པ་འབུམ་བྱས་ནས་ལས་སྦྱོར་གྱི་ཚེ།",
    "ཞེས་ཀླད་པ་འགེམས་པའི་སྔགས་བརྗོད་ན་གླང་པོ་ཆེ་འབྲོས་པར་འགྱུར་རོ།",
    "ཞེས་བསྙེམས་པའི་སྔགས་བརྗོད་ན་སྟག་འབྲོས་པར་འགྱུར་རོ།",
    "ཞེས་ལུས་སྤྲིང་པའི་སྔགས་བརྗོད་ན་བསེ་འབྲོས་པར་འགྱུར་རོ།",
    "ཨོཾ་ཨི་ལི་མི་ལི་ཕུ་ཕུ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ་ཞེས་སྐྱི་ཟིང་བའི་སྔགས་བརྗོད་ན་སྦྲུལ་འབྲོས་པར་འགྱུར་རོ།",
    "ཨོཾ་ཤྭ་ན་ཤྭ་ན་ཏིཥྛ་ཏིཥྛ་ཧེ་བཛྲ་ཡ་སྭཱ་ཧཱ་ཞེས་འཇིགས་པའི་སྔགས་བརྗོད་ན་ཁྱི་འབྲོས་པར་འགྱུར་རོ།",
    "ཞེས་དེ་ཉིད་གསུངས་ཟིན་པའི་དོན་ཏོ།",
    "ཅེས་ཏིང་ངེ་འཛིན་གསུམ་གསུངས་ཏེ།",
    "ཞེས་བསྙེན་སྒྲུབ་ཡན་ལག་བཞི་གསུངས་ཏེ།",
    "ཞེས་རྣལ་འབྱོར་བཞི་གསུངས་ཏེ།",
    "རྣམ་པ་ལྔ་པོ་བསྒོམས་བྱས་ཏེ།",
    "མཆོད་བསྟོད་བདུད་རྩི་ལ་སོགས་པར།",
