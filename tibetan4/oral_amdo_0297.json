    "བསྲུང་བ་ནི་ཐུན་མོང་བ་ཉི་ཤུ་རྩ་གཉིས།",
    "དེ་ཡང་དང་པོར་མཐེབ་སྲིན་གཉིས་རྩེ་མོ་སྦྱར་ཞིང་གཏོར་བའོ།",
    "གཞན་ཡང་བདུད་རྩི་ལྔས་དངོས་གྲུབ་ཐམས་ཅད་ཅེས་པ་མཆོག་ཐུན་མོང་གཉིས་ཀའི་གྲོགས་སུ་འགྱུར་བའོ།",
    "བདེ་ཆེན་གྱི་བུམ་པའི་སྟེང་གི་ཐོད་པ་བཞི་དང་།",
    "ལྷ་དང་མིའི་བདེ་བས་བཅུ་དྲུག་གི་ཆར་ཡང་མི་ཕོད།",
    "ཅེས་ཉེ་བར་མཚོན་པ་ཙམ་མོ།",
    "གངྒཱ་ལ་སོགས་པའི་ཆུ་འགྲམ་མོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་རྫས་གཉིས་ཀྱིས་བྱུགས་ལ།",
    "འདུ་བའི་འབྲེལ་པའམ་རྩ་རྐྱང་གི་ལུགས་ལྟར་བཀོད་ལ།",
    "དོན་གཉིས་པ་ཐིག་གི་བྱ་བ་བསྟན་ཏོ།",
    "ཐལ་ཆེན་དང་རྡོ་རྒྱུས་ཀྱིས་དཀར་པོ་དང་།",
    "ཐལ་ཆེན་དང་བ་བླས་སེར་པོའོ།",
    "ཐལ་ཆེན་དང་སོ་ཕག་གིས་དམར་པོའོ།",
    "ཐལ་ཆེན་དང་དུར་ཁྲོད་ཀྱི་ཤིང་ལས་ལྗང་གུ་བྱའོ།",
    "ཁྱོད་ཅི་ལ་དགའ་ལ་སོགས་པ་ནག་པོ་ཆོ་ག་ལྟར་བྱ་སྟེ།",
    "འདི་དག་ནི་མཇུག་གི་ཆོ་ག་དངོས་སུ་བསྟན་ལ།",
    "རྣལ་འབྱོར་འདི་ནི་ཞེས་བྱ་བས་ནི་མ་བླ་ན་མེད་པའི་བདེ་བ་མཆོག་གི་རྒྱུད་ཀྱི་ཆེ་བ་བསྟན་ཏོ།",
    "བརྩོན་འགྲུས་ཆེན་མོ་ནས་མས་དགོད་པ་ནི་ཀུན་སྤྱོད་ལྟར་རིམ་པ་བཟློག་པ་སྟེ།",
    "འབྲས་བུ་ནི་མཆོག་གི་སིདྡྷི་དང་ཐུན་མོང་གི་སིདྡྷི་ལས་ཀྱི་ཚོགས་གསོག་པ་རྣམས་སོ།",
    "དེ་རང་གིས་མི་འགྲུབ་པས་གྲོགས་ཡིན་པས་རིན་ཆེན་དུ་མ་གྲགས་གསུང་།",
    "དེ་ཡང་ཐུན་མོང་སྒྲུབ་པ་ལ་འཇུག་པའོ།",
    "ཡང་ན་ཀཾ་པ་ལ་ལྟར་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་ལ་སོགས་པ་གང་གིས་གཙོ་བྱས་པ་ནི་གཙོ་བོ་ཡིན་ལ།",
    "སྔགས་ཀྱི་སྒོ་ནས་ཐུན་མོང་སྒྲུབ་པ་བསྟན་ཏོ།",
    "ལེའུ་བཅུ་གཅིག་པས་ནི་ཐུན་མོང་གི་སིདྡྷི་སྒྲུབ་པའི་ཐབས་སྐྱེ་བ་བདུན་པ་བརྟག་པ་བསྟན་ཏེ།",
    "ལེའུ་བཅུ་གསུམ་པས་ནི་དཔའ་མོའི་གོ་ཆ་གཉིས་ཀྱིས་ལས་བསྒྲུབ་པ་བསྟན་ཏོ།",
    "དེ་ཡང་ཡི་གེ་རེ་རེའི་བརྡས་ནི་སྤྱིར་རིགས་ལྡན་མའི་རྣལ་འབྱོར་པ་ཙམ་དུ་ངོ་ཤེས་པར་བྱེད་དོ།",
    "དེ་རེ་རེའང་ཁ་དོག་ལ་སོགས་པ་ལྔ་ལྔར་ཤེས་པར་བྱའོ།",
    "རིགས་བདུན་གྱི་ཡང་ཕག་མོ་རྡོ་རྗེ་སེམས་དཔའི་རིགས་དང་།",
    "ལྷག་མ་ལྔ་ནི་སོ་སོ་རང་རང་གི་ཁ་དོག་དང་།",
    "ལེའུ་བཅུ་བདུན་པས་ནི་རིགས་ལྡན་མ་རྣམས་ཀྱི་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པ་རྣམས་ཀྱི་མིང་གི་རྣམ་གྲངས་ཀྱི་སྒོ་ནས་མཚན་ཉིད་བསྟན་ཏོ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་མིང་གི་རྣམ་གྲངས་ནི་བརྒྱད་དེ།",
    "འཇིག་རྟེན་པའི་མིང་གི་རྣམ་གྲངས་ནི་བདུན་ནོ།",
    "ཡོངས་གྱུར་མས་གསུང་གི་ཆས་བཞི་བསྡུས།",
    "ཨེ་ཧི་ཀཱ་ལ་མོས་མཚམས་ཀྱི་བཞི་བསྡུས་སོ།",
    "ལྷག་མ་ཧེ་རུ་ཀའི་རྣལ་འབྱོར་མ་མོ་ཞེས་བསྟན་པ་དང་།",
    "འོ་ན་འདས་པའི་མིང་གི་རྣམ་གྲངས་ན།",
    "སྡུད་པ་མོ་ཡོད་པས་སྡུད་པ་མོས་སྡུད་པ་མེད་དམ།",
    "སྡུད་པ་མོ་དང་ཕག་མོ་དང་ཧེ་རུ་ཀ་ནི་དོན་གཅིག་སྟེ་རྣམ་གྲངས་ཡིན་ནོ་གསུང་ངོ།",
    "ལེའུ་ཉི་ཤུ་པས་ནི་དེ་ལྟར་རིགས་ལྡན་གྱི་མཚན་མ་ཁ་དོག་གི་མཚན་མ་རྣམས་ཀྱིས་རིགས་ངོ་ཤེས་པ་དང་།",
    "ཆགས་པའི་རྒྱུ་སོ་དང་སེན་མོ་བརྡབ་པ་ལ་སོགས་པ་དང་།",
    "དེ་ཡང་དང་པོ་པའི་ཡེ་ཤེས་རེག་བྱ་བདེ་བ་དང་བཅས་པ་སྐྱེ།",
    "འདིའི་མཚན་མ་ཞེས་པས་མཚོན་པར་བྱེད་པ་དེ་ཕྱིས་ཕྲ་མོ་དང་ཐིག་ལེས་མཚོན་པ་སྟེ།",
    "དེའི་བར་དུ་རྡོ་རྗེ་ཕྲ་མོ་ལ་སོགས་པ་བསྒོམས་ལ།",
    "དེ་ལ་དམིགས་པས་དང་པོ་རེག་བྱ་བདེ་བ།",
    "ལེའུ་ཉེར་བཞི་པ་ལས་ནི་ལེའུ་དག་པའི་ཡི་གེ་རེ་རེའི་བརྡ་བསྟན་པའི་འཕྲོ་ཡི་གེ་འདུས་པའི་བརྡ་བསྟན་ཏེ།",
    "ལམ་གྱི་གྲོགས་ཐུན་མོང་མ་ཡིན་པའི་ཚིག་བརྒྱད་བསྟན་ཏོ།",
    "དེ་ཡང་ཕོ་ཉ་མོ་དེ་གྲུབ་སྟེར་ཡན་ཆད་ཀྱིས་ཕོ་ཉ་མོ་གསུམ་པོ་རང་བསྟན་ཏོ།",
    "མཐོང་ཞེས་བྱ་བ་ལ་སོགས་པས་སྔགས་སྐྱེས་ཀྱི་ཕོ་ཉ་མོ་བསྟེན་པའི་ཚུལ་བསྟན་ཏེ།",
    "དེ་ནས་ལུས་ལ་རེག་ཅིང་ཞག་གསུམ་སྦྱང་ངོ།",
    "མ་དང་སྲིང་མོ་ཞེས་པའི་དོན་ནི་སེམས་བརྟན་པ་ཐོབ་པས་ཐ་མལ་པའི་མ་ལ་སོགས་པའི་བར་རྟོག་པ་མེད་པར་བསླབ་པའམ།",
    "ཡང་ན་ལས་དང་པོ་པས་རང་གི་རིགས་གང་ཡིན་པའི་བཙུན་མོ།",
    "ལྷ་གནས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཚིག་རྐང་རེ་རེ་ཐུན་མོང་མ་ཡིན་པའི་དམ་ཚིག་བརྒྱད་བསྟན་ཏོ།",
    "བློ་ཆུང་ཞེས་བྱ་བ་ལ་སོགས་པས་སྔགས་སྐྱེས་ཀྱི་ཕོ་ཉ་མོའི་གསང་རྩ་རྒྱས་པར་བྱ་བའི་ཐབས་བསྟན་ཏོ།",
    "དག་དང་ཞེས་བྱ་བས་ཕོ་ཉ་མོ་བསྟན་པ་དང་།",
    "སྤྱོད་པ་དང་ལྡན་པ་གཅིག་གིས་དམ་ཚིག་བསྟེན་པ་ཡིན་པས་སྤྱོད་པ་བསྟན་ལ།",
    "དམ་ཚིག་གི་ཁྱད་པར་དང་།",
    "ཡང་བྱ་བ་མ་ཡིན་པའི་བྱེ་བྲག་འཇིག་རྟེན་པའི་འབྲེལ་པ་རྣམས་དང་བདེ་སྡུག་ཐུན་མོང་དུ་སྤྱད་པར་བྱ་བ་ཡིན་གྱི།",
    "དག་བྱེད་ཅེས་བྱ་བ་ལ་སོགས་པས་ནི་དོན་གཉིས་པ་དམ་ཚིག་གི་བྱེ་བྲག་བཟའ་བའི་དམ་ཚིག་བདུད་རྩི་ལྔ་བསྟན་ཏེ།",
    "དམ་ཚིག་གི་རིགས་གཙོ་བོ་ཡིན་པས་རིགས་ལྔ་ཞེས་བྱ་བ།",
    "གདོལ་པ་མོ་དང་དམངས་རིགས་གཅིག་ཏུ་བྱའོ།",
    "བ་ལང་ཤ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དོན་ལྔ་པ་སྦྱིན་སྲེག་གི་བྱེ་བྲག་བསྟན་ཏེ།",
    "དེ་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ནང་གི་སྦྱིན་སྲེག་ཁ་ཟས་སམ་ཚོགས་ལ་ལོངས་སྤྱོད་པའི་ཚུལ་བསྟན་ཏོ།",
    "ལེའུ་ཉེར་དགུ་པ་འདིས་ནི་ལམ་གྱི་གསང་བ་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ཀྱི་གྲོགས་སམ་ཡན་ལག་ཕོ་ཉ་མོའི་མཚན་ཉིད་དང་།",
    "བཟའ་བའི་དམ་ཚིག་གི་རྫས་བསྟེན་པའི་ཕན་ཡོན་དང་བཅས་པ་བསྟན་ཏོ།",
    "ཁྱི་མོ་ནག་མོའི་ཐུགས་ལ་སོགས་པའི་བསྲེག་རྫས་བྱ་སྟེ།",
    "རྩ་བའི་སྔགས་ལ་བསྙེན་པ་སྔོན་དུ་སོང་ནས་རོ་གཙང་མ་བླངས་ཏེ་རོ་ལངས་བསྒྲུབ་པ་བསྟན་ཏོ།",
    "ངེས་དོན་བདེ་བ་སྔོན་དུ་སོང་བའི་སྟོང་པ།",
    "ཐིམ་པའི་བྱེ་བྲག་གིས་ལོ་ཀ་ལས་འདས་པའི་མེ་ལྷ་བསྐྱེད་པ་བསྟན་ཏོ།",
    "ཆོ་གའི་ཞེས་པས་ནི་སྦྱིན་སྲེག་གི་དུས་ལས་བཞིའི་བྱེ་བྲག་གི་ཁཎྜ་རོ་ཧཱ་བཞིས་བསྒྲུབ་བྱ་དགུག་ཅིང་།",
    "དེ་ལྟ་བུའི་ལུས་ཀྱི་སྦྱིན་སྲེག་གི་ཆོ་ག་གསུངས་པར་ཤེས་པར་བྱའོ།",
    "ཡང་དཀྱིལ་འཁོར་ལ་ཤེས་པ་ཆེར་སྤྲོས་ཏེ་སོང་ཡང་།",
    "བདེ་བ་མི་རྟོག་པ་བསྒོམ་མོ།",
    "ལས་བཞི་པོའི་བྱེ་བྲག་གིས་ཁ་དོག་དང་དབྱིབས་རྣམས་ཤེས་པར་བྱའོ།",
    "གཏུམ་མོའི་མེ་བདག་གི་འཁོར་ལོ་རྣམས་ལས་བརྒྱུད་དེ་སྣ་གཡས་ནས་སྤྲོས་པ་དང་།",
    "ལེའུ་སོ་དྲུག་པས་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "ཞེས་བྱ་བའི་བར་གྱིས་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ལྟར་ན་འོད་ཀྱི་རིག་མ་དང་།",
    "ཐུན་མོང་གི་དངོས་གྲུབ་མཆོག་གི་སིདྡྷི་སྐུ་གསུམ་འགྲུབ་པར་བསྟན་ཏོ།",
    "དེ་ནས་དོན་ཀྱི་ཡེ་ཤེས་རྟོགས་པ་བདེ་བ་མཐའ་གསུམ་གྱིས་མ་རེག་པ་ཉམས་སུ་མྱོང་བར་བྱ་བ་བསྟན་ཏོ།",
    "ནང་གི་རྟགས་གཉིས་སུ་བསྡུས་ལ་རྒྱས་པར་བྱས་ན་རེ་རེ་ལའང་ལྔ་ལྔ་སྟེ་བཅུའོ།",
    "དེ་ཡང་ཐུན་མོང་དུ་འགྲོ་བ་བཞད་པ་བརྒྱད་སོ་སོར་བགྲངས་ནའོ།",
    "དེ་ཡང་དང་པོར་ཤློ་ཀ་གཅིག་གིས་སྔོན་དུ་ཡི་གེ་བདུན་པ་ལ་བསྙེན་པ་སྔོན་དུ་སོང་བའི་རྣལ་འབྱོར་པ་ལ།",
    "མཁའ་འགྲོ་མ་ཐམས་ཅད་ཀྱི་སྤྱན་གྱིས་གཟིགས་ཤིང་བྱིན་གྱིས་རློབ་ལ།",
    "བདག་གི་ལུས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི།",
    "ཡི་གེ་བདུན་པའི་བསྙེན་པ་སྔོན་དུ་སོང་པས་རྨི་ལམ་བརྟག་པ་བསྟན་ཏོ།",
    "དེ་ནས་ཁྱེའུ་དང་བུ་མོ་གཙང་མ་ལ་ཁྲུས་བྱས་ཏེ།",
    "མཐེ་བོང་གི་དཔུང་།",
    "མཚན་མོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་སྦྱིན་སྲེག་གི་སྒོ་ནས་རྒྱས་པ་ལ་སོགས་པའི་ལས་བསྒྲུབ་པ་བསྟན་ཏོ།",
    "ལེའུ་ཞེ་བཞི་པས་ཀྱང་འབྲས་བུའི་གསང་བ་ལ་འཇུག་པ་དཔའ་བོ་དྲུག་གི་གོ་ཆའི་ལས་བསྟན་ཏེ།",
    "ཙནྡན་དམར་པོའི་སྦྱིན་སྲེག་གིས་སའི་བདག་པོ་ནོར་དང་བཅས་པ་དགུག་པའི་ལས་དང་།",
    "འདི་ཡང་རྣལ་འབྱོར་མ་དྲུག་གི་སྔགས་འབའ་ཞིག་གི་ལས་བསྟན་ཏོ།",
    "དེ་ཡང་དང་པོར་གོ་ཆའི་སྔགས་ཀྱི་བསྙེན་པ་སྔོན་དུ་སོང་བས།",
    "རང་གིས་མེ་ཏོག་རེ་ལ་སྔགས་རེ་བརྗོད་ཅིང་ཆུ་ལ་བསྐུར་བས།",
    "ཆུ་དང་བཅས་པས་སོ་ལ་མ་རེག་པར་འཐུངས་ན།",
    "དེ་ནས་སྐྱེ་གནས་ཞེས་བྱ་བ་ལ་སོགས་པས་རྣལ་འབྱོར་མ་དྲུག་གི་ཙཀྲ་བྲིས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བའི་རྐང་རྗེས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པས་སྦྱིན་སྲེག་གི་ལས་ཐམས་ཅད་འགྲུབ་པར་བསྟན་ཏོ།",
    "ཧ་ལྔ་ལ་སྔོན་དུ་བསྙེན་པ་འབུམ་ཕྲག་ལ་སོགས་པ་སོང་བས་ལྷ་རྣམས་བསྒྲུབ་པར་བྱའོ།",
    "མིང་རུས་ཞེས་བྱ་བ་ལ་སོགས་པས་སྔོན་དུ་བསྙེན་པ་སོང་བས་ལས་ཀྱི་སྦྱོར་བ་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ཏེ།",
    "དེ་ཡང་དང་པོར་ཚིགས་བཅད་གཅིག་གིས་མཚམས་སྦྱར་བ་བསྟན།",
    "བོང་བུའི་གཟུགས་ཀྱི་ནང་ནས་བལྟས་ན་གང་གི་སྐྱེ་བ་བདུན་པ་ཡིན་པ་དེའི་གཟུགས་བརྙན་བདུན་འབྱུང་ངོ།",
    "བསྙེན་བཀུར་བྱས་པས་རང་གི་ལུས་འདོར་གསུང་།",
    "ཧིའི་གི་གུ་ཀ་ལ་སྤོས་ལ།",
    "དེ་ནས་སྔགས་ཀྱི་འོད་ཀྱིས་བསྒྲུབ་བྱ་སྐྱེ་བ་བདུན་པ་དེའི་ཤེས་པ་ཧཱུྃ་གི་རྣམ་པས་བཀུག་ལ།",
    "རྒྱས་པ་ལ་གི་ཝང་ལ་སོགས་པ་དང་།",
    "སེན་མོ་དང་ལྔའི་ཕྱེ་མ་དང་།",
    "དུད་འགྲོ་གང་གིས་ཟོས་པ་དེ་ཡང་མཁའ་སྤྱོད་ལ་སོགས་པར་འགྱུར་བའི་ཕན་ཡོན་བསྟན་ཏོ།",
    "རྗེས་སྤྱོད་དང་སྦྱར་ན་སྟག་གི་པགས་པའི་ཤམ་ཐབས་ལ་སོགས་པའོ།",
    "རྗེས་སྤྱོད་ལ་ཡང་ཚོམ་སྔགས་ཀྱིས་བསྲུང་བ་བྱའོ།",
    "ཕྱག་རྒྱ་ལྔས་མཉམ་གཞག་གི་ལྷའི་རྒྱན་ནོ།",
    "དེ་དག་གིས་ནི་དོན་བསྡུས་མཉམ་གཞག་ཁོ་ན་བསྟན་ཏོ།",
    "གཟིགས་པ་པོ་རྣམས་ཀྱིས་གཟིགས་བདེ་བའི་ཆེད་དུ་དཀར་ཆག་ཀྱང་བཀོད་ཅིང་།",
    "རྒྱ་ཆེའི་གཟིགས་པ་པོ་རྣམས་ཀྱི་རིན་ཐང་བྲལ་བའི་དགོངས་ཆར་ཐད་ཀའམ་ཡང་ན་ཡིག་ཐོག་གང་རུང་ནས་ལྷུག་པོར་གནང་སྐྱོང་ཡོད་པ་ཞུ་རྒྱུ།",
    "འཇིག་རྟེན་ཐོག་གི་བྱ་དངོས་ཚང་མའི་འགྱུར་ལྡོག་དེ་ཡང་ཐོག་མར་ཆ་ཤས་དང་གྲངས་འབོར་ཐོག་གི་འགྱུར་ལྡོག་བྱུང་བ་བརྒྱུད་ནས་མཐར་ངོ་བོའི་འགྱུར་ལྡོག་ཡོང་གི་ཡོད་པ་ལྟར།",
    "འགྱུར་ལྡོག་གི་གནས་ཚུལ་ལ་ཐོག་མར་ལྟ་ཙམ་ཞིག་བྱེད་དོ།",
    "རྒྱལ་རབས་བརྒྱད་པ་རྒྱལ་པོ་གྲི་གུམ་བཙན་པོའི་དུས་སུ་མངའ་རིས་ཞང་ཞུང་གི་ཡུལ་དུ་གཤེན་རབས་མི་བོ་ཆེ་ཡོངས་གྲགས་སུ་བོན་སྟོན་པ་གཤེན་རབས་ཟེར་ཟེར་བ་དེ་བྱུང་ཞིང་།",
    "འདྲེ་ནི་མི་དེ་གསོན་པོར་སྡོད་སྐབས་སྲོག་གི་བདག་པོ་བྱེད་པ་མ་ཟད།",
    "གནོད་པའི་འདྲེ་དེ་མེད་པ་བཟོ་དགོས་ཞེས་ཟེར་གྱི་ཡོད་པ་རེད།",
    "དགུན་ཀའི་དུས་སུ་བོན་ལྷ་དམར་མཆོད་ཅེས་གཡག་ལུག་ར་སོགས་ཕོ་ཕྱུགས་སྟོང་ཕྲག་གསུམ་རེ་ལོངས་པའི་སྐེ་དུས་གཅིག་ཏུ་བཅད་ནས་བསད་པ་དང་།",
    "འབྲི་ལུག་ར་སོགས་མོ་ཕྱུགས་སྟོང་ཕྲག་གཅིག་རེ་ལོངས་པའི་ཡན་ལག་རྣམས་གསོན་པོར་ལྷུ་ལག་ཕྲལ་ནས་བསད་པའི་ཤ་ཁྲག་གི་དམར་མཆོད།",
    "དཔྱིད་ཀའི་དུས་སུ་ཡུ་མོའི་བྱིན་འབྲེག་ཟེར་བ་ཤྭ་བ་ཡུ་མོ་བཞིའི་རྐང་ལག་ལྷུ་ལག་ཕྲལ་ནས་བསད་པའི་ཤ་ཁྲག་གི་དམར་མཆོད།",
    "མོ་ཕྱུགས་སྟོང་ཕྲག་གསུམ་ནས་མ་ཐ་རེ་རེ་ལས་མ་བྱུང་ཡང་བསད་ནས་དམར་མཆོད་འབུལ་གྱི་ཡོད་པ་དང་།",
    "མོ་རྒྱབ་པ།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡ ༡༦༢་ས་སྟག་སྤྱི་ལོ་༦༡༨ ལོར།",
    "དེ་རྗེས་ཁོ་པའི་བུ་ཐ་ཐའི་ཙུང་ལི་ཧྲི་མིང་གི་སྐབས་སུ་སླེབས་དུས་ཐང་རྒྱལ་རབས་དེ།",
    "དེ་ནི་བོད་ཀྱི་རུས་རྒྱུད་ཚོ་པ་ཁག་གཅིག་གྱུར་བྱུང་ནས་མི་རིགས་སུ་འགྱུར་བའི་ཐོག་མའི་སྣང་ཚུལ་ཞིག་ཀྱང་རེད།",
    "འཕེལ་རྒྱས་བཅས་ཡོང་ཐུབ་ཀྱི་མ་རེད།",
    "རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོས་ཐོག་མར་ལོ་ཙཱ་བ་ཐོན་མི་སམ་བྷོ་ཊ་ལ་དེང་སྐབས་ང་ཚོས་བེད་སྤྱོད་བྱས་པའི་བོད་ཡིག་འདི་གསར་གཏོད་བྱེད་དུ་བཅུག་རྗེས།",
    "རིམ་པ་དམའ་བ་བློ་མི་ཕམ་པའི་ཐག་གཅོད་བྱེད་དགོས་པ་སོགས་གྲལ་རིམ་གྱི་དབྱེ་བ་ཧ་ཅང་གསལ་པོ་ཡོད་པ་རེད།",
    "འབངས་རྣམས་ཀྱིས་རྒྱལ་པོའི་སྐུ་སྲུང་ཞིང་བསམ་པ་རྣམ་དག་གིས་སྟོབས་ཤུགས་ཡོད་ཚད་འབུལ་དགོས་པ་དང་།",
    "མོ་བཙུན་བཀའ་ལ་མི་གདགས་ཟེར་བ།",
    "བུད་མེད་རྣམས་གྲོས་ཚོགས་ཀྱི་ཚོགས་མིའི་གྲས་སུ་ཞུགས་མི་ཆོག་པ་བཅས་གསལ་པོར་འཁོད་ཡོད་པ་དང་།",
    "མྱང་མང་པོ་རྗེས་ཞང་སྣང་གིས་སུམ་ཁམས་ཐམས་ཅད་མཛངས་ཀྱི་སྒོ་ནས་མི་རྟ་གཉིས་ལ་ཚེགས་མ་བྱུང་བར་འབངས་རྣལ་མར་བཀུག་ཏེ་དཔྱ་ཕབ།",
    "ཞེས་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོའི་དུས་སུ་བློན་པོ་མྱང་མང་པོ་རྗེ་ཞང་སྣང་གིས་མི་རྟ་གཉིས་ལ་ཟད་གྲོན་མ་བྱུང་བའི་ཐོག་ནས།",
    "ཡང་ཤོག་དྲིལ་གཞན་ཞིག་གི་ནང་འཁོད་དོན་བཙན་པོ་སྲོང་བཙན་སྒམ་པོའི་རིང་ལ་དེའི་འོག་ཏུ་བཙན་པོ་ཞབས་ཀྱིས་བཙུགས་ཏེ་བྱང་ལམ་དུ་བྱོན་པར།",
    "ཞེས་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོས་སུམ་པའི་ཡུལ་མངའ་འོག་ཏུ་བཅུག་པའི་རྗེས་སུ་བཙན་པོ་ངོ་མ་བྱང་ཕྱོགས་བརྒྱུད་དུ་སོང་ནས།",
    "རྒྱལ་པོས་རང་གི་མངའ་འོག་མི་སེར་གྱི་ས་ནས་དཔྱ་ཁྲལ་བསྡུས་པ་དེ་ནི།",
    "དེ་སྐབས་ཀྱི་ཚན་རིག་མཁས་པ་མང་པོ་ཞིག་དགོངས་པ་གཅིག་མཐུན་བྱུང་ཡོད་པ་རེད།",
    "དེ་ཉིད་དར་སྤེལ་གཏོང་བའི་ཆ་རྐྱེན་ཡང་འཛོམས་ཡོད་པ་རེད།",
    "མ་ས་གོང་གི་ལྷ་ཁང་བཅས་ལྔ་བཞེངས།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱ་ཀྱའི་འདས་ལོ་༡༢༩༨ ཤིང་རྟ་ཐང་ཞོན་ཙུང་ལི་ལོང་ཅིས་ཀྱི་ཐིའན་པའི་ཁྲི་ལོ་བཅུ་གསུམ་པ་སྤྱི་ལོ་༧༥ལོ་ལ།",
    "རྒྱལ་པོ་ཁྲི་ལྡེ་གཙུག་བརྟན་ནི་བློན་པོ་འབལ་ལྡོང་ཚབ་དང་ལང་མེས་གཟིགས་གཉིས་ཀྱིས་བཀྲོངས་ཞེས་གསལ།",
    "ལྷ་ས་མཁར་བྲག་གི་ལྷ་ཁང་དང་བྲག་དམར་མགྲིན་བཟང་གི་ལྷ་ཁང་གཉིས་བཤིག་རྭ་མོ་ཆེའི་ཇོ་བོ་མི་བསྐྱོད་རྡོ་རྗེ་མི་སུམ་བརྒྱས་དྲུད་ནས་སྒུལ་མ་ཐུབ་པར་བྱེ་མའི་འོག་ཏུ་སྦས།",
    "སླར་ཡང་གཙུག་ལག་ཁང་དང་རྭ་མོ་ཆེའི་ཇོ་བོ་གཉིས་མངའ་རིས་སྐྱིད་གྲོང་བར་དུ་བསྐུལ།",
    "རྭ་མོ་ཆེ་དང་གཙུག་ལག་ཁང་གཉིས་སུ་བཟོ་གྲྭ་དང་བཤས་ར་བྱས་ཏེ།",
    "གོང་གསལ་བློན་པོ་གཉིས་ཀྱིས་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་ཕ་ཁྲི་ལྡེ་གཙུག་བཙན་བཀྲོངས་པ་དང་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་ཡང་བཀྲོངས་རྒྱུའི་གྲ་སྒྲིགས་བྱས་པའི་གནས་ཚུལ་བློན་པོ་སྟག་སྒྲ་ཀླུ་གོང་གིས་ཤེས་ནས་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་ལ་ཞུས་ཏེ།",
    "དེ་ནས་རྒྱལ་པོས་བློན་པོ་སང་ཤི་བློན་པོ་གསལ་སྣང་གི་གྲོགས་བྱེད་པར་མངའ་རིས་མང་ཡུལ་དུ་བཏང་།",
    "མོ་རྒྱག་མཁན།",
    "བློན་པོ་མ་ཞང་ཕྲག་དོག་གིས་ངར་ལངས་ནས་རྒྱལ་པོའི་བློན་པོའི་ནང་གཙོ་ཆེ་བ་ང་རང་ཡིན་པས་ང་ཡང་དུར་ནང་དུ་གསོན་པོར་འགྲོ་གི་ཡིན་ཟེར་ནས་ཁས་ལེན་བྱེད་དགོས་བྱུང་བ་རེད།",
    "དེ་ནས་ཉིན་གཅིག་བློན་པོ་མ་ཞང་དང་འགོས་ཁྲི་བཟང་སྟོད་ལུང་ནང་དུ་དུར་དོང་ཡོད་སར་སོང་ནས་དོང་ནང་དུ་གསོན་པོར་འཛུལ་ཏེ་དོང་གི་ཁ་བཀག་རན་པ་དང་།",
    "བློན་པོ་འགོས་ཁྲི་བཟང་གིས་བརྫུས་ཆས་སྤྲས་ནས་གཡོ་སྒྱུར་བྱས་ཏེ་དོང་ནང་ནས་བྲོས།",
    "རྒྱ་བྱིའུ་རི་མོ་ཡོད་པའི་གསེར་ཤོག་སྲང་བརྒྱ་ཐམ་པ།",
    "དེ་མཚུངས་མི་གཞན་དག་ལ་ཡང་བྱ་དགའི་དངོས་པོ་ན་སུམ་ཚོགས་པ་སྤྲད་དེ་བོད་དུ་འབྱོར་ནས་གོང་མས་བསྐུར་བའི་བཀའ་ཤོག་གི་སྒྲོམ་བུ་དང་།",
    "ལྷག་པར་དུ་སློབ་དཔོན་པདྨས་ཕ་མ་གཉིས་འཛོམས་ཀྱི་བུ་དང་བུ་མོ་ཁག་གཅིག་ལ་པྲ་འབེབས་པ་ཟེར་བ་མི་ལ་ལྷ་འདྲེ་ཁོག་ཞུགས་བྱས་པའི་ལུགས་སྲོལ་ཐོག་མར་བཙུགས་ཤིང་།",
    "དེང་སང་ལྷ་ཕེབས་ཟེར་བ་དེ་སྐབས་ཐོག་མར་བྱུང་བ་རེད།",
    "དེ་ནས་བསམ་ཡས་ཀྱི་གཙུག་ལག་ཁང་རྩིགས་རྒྱུའི་གྲ་སྒྲིགས་བྱས་སྐབས་བློན་པོ་སྟག་སྒྲ་ཀླུ་གོང་སོགས་བོན་ལ་དགའ་བའི་བློན་པོ་ཁག་གཅིག་གིས་ངོ་རྒོལ་བྱས་པར་མ་ཟད།",
    "རྒྱལ་པོའི་བཙུན་མོ་ཅོག་རོ་བཟའ་སོགས་དང་།",
    "དེ་ནས་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༣༣ ས་ཕག་ཐང་སུད་ཙུང་ལི་ཤིའང་གི་ཆེན་ཡོན་ཁྲི་ལོ་གཉིས་པ་སྤྱི་ལོ་༧༥༩ལོར།",
    "རྒྱལ་པོ་བོན་པོ་རྣམས་སྟོད་མངའ་རིས་ཞང་ཞུང་གི་ཡུལ་དུ་མཐར་སྐྲོད་བཏང་ཞིང་།",
    "བཀའ་གཙིགས་དང་པོ་དང་གཉིས་པ་ཚང་མ་བསམ་ཡས་གཙུག་ལག་ཁང་བཞེངས་ཚར་བའི་རྗེས་ཀྱི་ལུག་གི་ལོ་བོད་ཟླ་བཞི་པའི་ཚེས་བཅུ་བདུན་གྱི་ཉིན་བཀོད་པ་དང་།",
    "འཐབ་རྩོད་ཀྱི་དགོས་མཁོ་དང་བསྟུན་ནས་རྗེས་སུ་གཉིས་ཀས་ཁ་གཏད་ཕྱོགས་ནས་དགོས་མཁོ་ཡོད་པ་རྣམས་བླངས་ཏེ་ནང་དོན་བསྒྱུར་ནས་རྣམ་པ་རང་སོར་བཞག་པ་ཞིག་རེད།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༣༦ཆུ་སྟག་ཐང་ཏའི་ཙུང་ལི་ཡུའུ་གི་པའོ་དབྱིང་ཁྲི་ལོ་དང་པོ་སྤྱི་ལོ་༧༦༢ལོར་བསམ་ཡས་གཙུག་ལག་ཁང་བཞེངས་འགོ་ཚུགས་ཏེ་ལོ་བཞི་ལ་གྲུབ།",
    "དེའི་ཕྱི་ལོ་མེ་ལུག་ཐང་ཏའི་ཙུང་ལི་ཡུའུ་གི་ཏ་ཀྱིས་ཁྲི་ལོ་གཉིས་པ་སྤྱི་ལོ་༧༦༧ལོར།",
    "རྒྱལ་པོས་བློན་པོའི་གྲོས་མོལ་ལ་བསྟུན་ནས་བཀའ་གཏོང་བ་མ་གཏོགས་རྒྱལ་པོས་རང་ཤེད་བྱེད་མི་ཆོག་པའི་ལམ་ལུགས་དམ་པོ་ཡོད་པ་བཅས་ཀྱི་གནས་ཚུལ་སྐོར་རྦ་བཞེད་ཀྱི་ནང་།",
    "སློབ་དཔོན་པདྨ་ཕྱིར་འབུད་བྱས་པ།",
    "བསམ་ཡས་གཙུག་ལག་ཁང་རྩིགས་རྒྱུའི་གྲོས་མོལ་བྱས་པའི་སྐོར་བཅས་ཀྱི་ཐད་ལ་གསལ་པོར་འཁོད་ཡོད་པ་རེད།",
    "གཏན་ཁེལ་བྱས་པའི་འཚོ་བའི་རྟེན་གང་ཡང་མེད་པའི་ཕོགས་གཟན་པ་ཤ་སྟག་རེད།",
    "ད་ལྟ་ང་རང་འཚོ་སྡོད་སྐབས་བསམ་ཡས་སོགས་ལྷ་ཁང་ཁག་གི་མཆོད་རྒྱུན་དང་།",
    "གཙུག་ལག་ཁང་གི་མཆོད་རྒྱུན་ལ་འབངས་མི་ཁྱིམ་ཉིས་བརྒྱ་དང་།",
    "རྒྱལ་པོས་ལྷ་ཁང་དང་གཙུག་ལག་ཁང་གི་མཆོད་རྒྱུན་ལ་འབངས་མི་ཁྱིམ་བརྒྱ་དང་ལྔ་བཅུ།",
    "གྲྭ་གྲངས་སུམ་བརྒྱ་དང་ལྔའི་བྲན་གཡོག་བཅས་བསྡོམས་པའི་ལྷ་འབངས་བྲན་གཡོག་ཐེམ་དུད་ཆིག་སྟོང་བརྒྱ་མེད་དྲུག་ཅུ་རེ་ལྔ་དང་།",
    "དེར་ཆ་སྙོམས་ཀྱི་མི་གྲངས་བཞི་རེ་བརྩིས་ཁྱོན་བསྡོམས་མི་གྲངས་བཞི་སྟོང་ཉིས་བརྒྱ་དྲུག་ཅུ་ཡོད་པ་དེ་ཚོ་ཚང་མས་རྒྱལ་པོ་ལ་དཔྱ་ཁྲལ་དང་དམག་ཁྲལ་འཇལ་མི་དགོས་པ་རེད།",
    "ལོ་གཅིག་ལ་ཁལ་དགུ་བརྒྱ་རེད།",
    "ལོ་རེ་ལ་མར་སྲང་ཆིག་སྟོང་བརྒྱ་ཐམ་པ།",
    "ཟླ་བ་རེ་ལ་མར་ཁལ་གཅིག་དང་ཉག་ཕྱེད་དང་གསུམ།",
    "ལོ་རེ་གོས་ཆ་ཚང་རེ།",
    "བསམ་ཡས་མཆིམས་ཕུར་ཡོད་པའི་སྒོམ་ཆེན་ཉི་ཤུ་རྩ་ལྔ་ལ་ལོ་རེར་ནས་ཁལ་ལྔ་བཅུ་ང་ལྔ།",
    "ལོ་རེར་མར་སྲང་བརྒྱད་བརྒྱ།",
    "རྟ་རེ།",
    "གོས་སྣེ་ཁ་དྲུག་རེ།",
    "གོས་སྣེ་ཁ་གསུམ་རེ།",
    "ཟླ་བ་རེ་ལ་བྲེ་བཅུ་གསུམ་དང་།",
    "ཁོ་ཚོར་རང་བདག་གི་ས་ཞིང་དང་།",
    "ཞིང་པ་མི་གྲངས་ལྔ་བརྒྱ་བཞི་བཅུ་ཞེ་གཉིས་ཀྱིས་ལོ་གཅིག་ལྡང་བའི་ཟ་འབྲུའི་འབོར་གྲངས་དང་མཉམ་གྱི་ཡོད་པ་རེད།",
    "ཚང་མ་བྲན་གཡོག་གི་བདག་པོ་ཤ་སྟག་ཡིན་པ་དང་།",
    "རྒྱལ་པོའི་བློན་པོ་ཞང་ཚེ་སྤོང་སྟོ་རེ་ཟེར་བས་སྟོད་ལུང་ལྕང་ཕུར་དགེ་སློང་བཞི་ཡོད་པའི་གཙུག་ལག་ཁང་ཞིག་བཞེངས་པ་དེའི་མདུན་གྱི་རྡོ་རིང་ཡི་གེའི་ནང་འཁོད་དོན།",
    "མཛུབ་བརྡ་བྱས་ན་མཛུབ་མོ་གཅོད་པ།",
    "དེ་ནས་རྒྱལ་པོའི་བཙུན་མོ་ངང་ཚུལ་མ་དང་།",
    "དེ་ནས་བློན་པོ་སྦས་སྟག་སྣ་ཅན་གྱིས་མངའ་འོག་ཏུ་ཡོད་པའི་མོ་རྒྱག་མཁན་དང་།",
    "དེ་རྗེས་རྒྱལ་པོའི་བཙུན་མོ་ངང་ཚུལ་མ་དང་།",
    "བློན་པོ་བྲན་ཀ་དཔལ་ཡོན་གཉིས་ལྐོག་ཏུ་ལུས་འབྲེལ་བྱས་སོང་ཟེར་བའི་ཕྲ་མ་རྒྱལ་པོར་ཞུས་པ་ལྟར་རྒྱལ་པོས་ཁོ་གཉིས་གསོད་དགོས་པར་བཀའ་ཕབས་ཏེ།",
    "བཙུན་མོ་ངང་ཚུལ་མ་རང་སྲོག་བཅད་དེ་ཤི།",
    "སྦས་སྟག་སྣས་བློན་པོ་བྱས་པ་རེད།",
    "སྐབས་དེར་བེད་སྤྱོད་བྱ་རྒྱུའི་མང་ཚོགས་ཀྱི་བསམ་བློའི་རྨང་གཞི་མེད་ན།",
    "བོད་ཀྱི་ཆབ་སྲིད་རྒྱ་ནག་གིས་འཕྲོག་འདོད་པ་རེད།",
    "༧བོད་ས་གནས་སུ་བྲན་གཡོག་གི་གྱེན་ལངས་བྱུང་སྟེ་སིལ་བུར་འཐོར་བ་དང་།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༢༩༩ ཤིང་ལུག་ཐང་ཞུན་ཙུང་གི་ཐིའན་པའོ་ཁྲི་ལོ་བཅུ་བཞི་པ་སྤྱི་ལོ་༧༥༥ལོར།",
    "ཐང་གི་དམག་དཔོན་ཨན་ལུའུ་ཧྲན་དང་།",
    "དེ་ནས་བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱ་འདས་ལོ་༡༤༣ ས་ཡོས་ཐང་ཞུན་ཙུང་ལི་ཁྲེན་གྱི་ཏ་ཀྲུང་ཁྲི་ལོ་བཅུ་གསུམ་པ་སྤྱི་ལོ་༨༥༩ལོར།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༤༥ ༡མེ་ཡོས་ཐང་ཨེ་ཇིས་ལི་ཀྲུའུ་གི་ཐིའན་ཡོའུ་ཁྲི་ལོ་བཞི་པ་སྤྱི་ལོ་༩༧ལོར།",
    "ཐང་རྒྱལ་རབས་རྩ་འཐོར་དུ་སོང་ཞིང་།",
    "དེ་ཚོ་ཚང་མ་ཀྲུང་གོའི་རྒྱལ་ཁབ་ཆེན་པོ་གཅིག་གི་ནང་རྒྱལ་ཁབ་ཆུང་ཆུང་མང་པོ་གཅིག་འོག་ཏུ་གཅིག་མ་འདུས་པར་ཁ་འཐོར་ནས་བསྡད་པའི་གནས་ཚུལ་ཞིག་ཡིན་པ་ལས།",
    "ཡུམ་བརྟན་ཕྱོགས་ཁག་གིས་དབུས་རུ་བཟུང་སྟེ་དེ་ལ་ཆེ་སྲིད་དང་ཆུང་སྲིད།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༤༡༣ས་གླང་ཐང་དབྱི་ཙུང་གི་ཞན་ཐུང་ཁྲི་ལོ་བཅུ་བ་སྤྱི་ལོ་༨༦༩ལོར།",
    "དེ་རྗེས་དབུ་རུར་འབྲོ་དང་སྤུས་གཉིས་འཁྲུགས་པ་བྱས་པར་བརྟེན་ནས་དབས་ལོ་ཕོ་ལོ་ཆུང་གིས་འགོ་ཁྲིད་དེ་གྱེན་ལོག་བྱས།",
    "འབྲོ་དང་ཅོག་རོའི་རུས་རྒྱུད་ཀྱིས་དཔོན་བྱས་པའི་རྗེ་དཔོན་ཚན་པ་གཅིག་༢གཞུ་སྙེ་མོར་འབྲང་མཁར་བྱེ་བཙན་ལ་བཙན་མཁར་བྱས་ཤིང་།",
    "མྱང་དང་སྣང་གི་རུས་རྒྱུད་ཀྱིས་དཔོན་བྱས་པའི་རྗེ་དཔོན་ཚན་པ་གཅིག་༣འཕན་པོ་ཟ་དམ་དུ་བཙན་མཁར་བྱས་ཤིང་།",
    "སྒྲོ་དང་རྨ་ཡི་རུས་རྒྱུད་ཀྱིས་དཔོན་བྱས་པའི་རྗེ་དཔོན་ཚན་པ་གཅིག་༤ཡར་ལུང་སྟོད་དུ་སྣ་མོ་ཡར་རྩེ་དང་མར་རྩེ་གཉིས་ལ་བཙན་མཁར་བྱས་ཤིང་།",
    "ལྷ་ས་བཅས་སུ་རྗེ་དཔོན་ཚན་པ་རེ་ཆགས་ནས་བོད་ས་གནས་ཡོངས་རྫོགས་སིལ་བུར་འཐོར་ཏེ།",
    "གྱེན་ལངས་བྱུང་ནས་ལོ་དགུ་པ་བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༤༢༡ མེ་བྱ་སྤྱི་ལོ་༨༧༧ལོ་ལ་བློན་པོ་ཤུད་པུ་སྟག་རྩེ་གཉགས་སོགས་གྲོས་བྱས་ཏེ་རྒྱལ་པོའི་བང་སོ་རྣམས་གཉགས་དང་།",
    "ཅོག་རོ་བཅས་རུས་རྒྱུད་ཚོ་པ་དྲུག་གིས་བགོ་བཤའ་བྱས་ཏེ།",
    "ཆེ་བ་སྐྱིད་ལྡེ་ཉི་མ་མགོན་སྟོད་མངའ་རིས་སུ་སོང་ནས་བུ་གསུམ་བྱུང་བའི་ཆེ་བ་དཔལ་ལྡེ་རིག་པ་མགོན་གྱིས་མར་ཡུལ་བཟུང་སྟེ།",
    "བུ་གསུམ་པ་ཁྲི་ཆུང་གིས་ཡར་ཀླུངས་སུ་བསྡད་པ་ལས་ཡར་ལུང་ཇོ་བོ་ཟེར་བའི་དཔོན་རྒྱུད་བྱུང་།",
    "བོད་སིལ་བུའི་དུས་འགོར་དབུས་གཙང་གཉིས་ཀྱི་རྒྱ་ཆེའི་མི་དམངས་རྣམས་དམག་འཁྲུག་དང་མུ་གེའི་སྡུག་བསྔལ་རྒྱུན་མི་ཆད་པའི་མེ་མཚོའི་ནང་ལྷུང་བ་རེད།",
    "རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༥༤ས་ལུག་སྤྱི་ལོ་༩༦ལོར།",
    "དེ་རྗེས་འདིའི་རྒྱལ་རབས་བཞི་པ་སུང་རེན་ཙུང་གི་པའོ་ཡོའུ་ཁྲི་ལོ་དང་པོ་ས་སྟག་སྤྱི་ལོ་༡༣༨ལོར།",
    "བློན་ཆེན་ལི་ཡོན་ཧའུ་ཟེར་བས་ངོ་ལོག་བྱས་ཏེ་ཉིང་ཞྭ་གི་ཡིང་ཀྲོའུ་ལ་རྒྱལ་ས་བྱས་པའི་ཤིས་ཞྭ་རྒྱལ་རབས་དེ་ལ་སྔ་རྗེས་བསྡོམས་པའི་རྒྱལ་པོ་བཅུ་བྱུང་།",
    "དེ་རྗེས་བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༩༥༦ཤིང་ལུག་སུང་ཧུའི་ཙུང་གི་ཀྲེང་ཧའོ་ཁྲི་ལོ་ལྔ་པ་སྤྱི་ལོ་༡༡ ༡༥ལོར།",
    "ཙུང་གི་ཞོན་ཧའོ་ཁྲི་ལོ་བདུན་པ་སྤྱི་ལོ་༡ ༡༢༥ལོར།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༥༢ ༢ ས་སྟག་སུང་བྱ་མའི་སུང་ཐའི་ཙུང་ཀྲའོ་ཀུས།",
    "རག་ཤི་སྤུན་མཆེད་གཉིས་ཀྱིས་དགེ་རྒྱས་བྱེ་མ་གླིང་གི་བདག་པོ་བྱས།",
    "ཀླུ་མེས་ཀྱིས་དབུས་སྟོད་ལ་མོར་ཆག་དེའུ་ཟེར་བའི་ལྷ་ཁང་བཏབ་ནས་གནས་གཞི་བཟུང་།",
    "དེ་ནས་གྱེས་པ་ལ་འབྲིང་ཚོ་ཟེར།",
    "རྔ་རོག་ཚོགས་པ་བར་ནང་འཁྲུག་བྱུང་སྟེ་བསམ་ཡས་གཙུག་ལག་ཁང་གི་འཁོར་སའི་ལྷ་ཁང་མང་ཆེ་བ་མེར་བསྲེགས།",
    "བྱུང་གསུམ་པའི་ལྕགས་འབྲུག་སུང་ལྷོ་མའི་སུང་ཀའོ་ཙུང་ཀྲའོ་ཀའོ་གི་ཧྲའོ་ཤིན་ཁྲི་ལོ་སུམ་ཅུ་པ་སྤྱི་ལོ་༡༡༦ལོར།",
    "དམག་འཁྲུག་གི་ནང་གནའ་རབས་བོད་ཀྱི་རྒྱུ་ཆེའི་མི་དམངས་ཀྱི་བློ་གྲོས་དང་ལག་རྩལ་ལ་བརྟེན་ནས་གསར་སྐྲུན་བྱས་པའི་ལྷ་སའི་གཙུག་ལག་ཁང་གཉིས་དང་།",
    "ཨ་ཏི་ཤ་སྐུ་འདས་རྗེས་ལོ་གསུམ་སོང་བ་བོད་ཀྱི་རབ་བྱུང་དང་པོའི་མེ་བྱ་སུང་བྱང་མའི་སུང་རེན་ཙུང་ཀྲའོ་ཀྲེན་གྱི་ཏྭཱ་ཡོའུ་ཁྲི་ལོ་གཉིས་པ་སྤྱི་ལོ་༡༥༧ལོར།",
    "དེ་ནས་ལོ་བཅུ་དྲུག་སོང་བ།",
    "བོད་ཀྱི་རབ་བྱུང་དང་པོའི་ཆུ་གླང་སུང་བྱང་མའི་སུང་ཧྲིན་ཙུང་ཀྲའོ་ཧུའི་གི་ཤིས་ཉིང་ཁྲི་ལོ་དྲུག་པ་སྤྱི་ལོ་༡༧༣ལོར།",
    "དེ་ནས་ལོ་ཞེ་དགུ་སོང་བ་རབ་བྱུང་གཉིས་པའི་ལྕགས་གླང་སུང་བྱང་མའི་སུང་ཧུའི་ཙུང་ཀྲའོ་ཧུའི་ཅིས་ཀྱི་ཞོན་ཧའོ་ཁྲི་ལོ་གཉིས་པ་སྤྱི་ལོ་༡༡༢ ༡ལོར།",
    "དེ་ནས་ལོ་བཅུ་དགུ་སོང་བ།",
    "དེ་ནས་ལོ་གཉིས་སོང་བ།",
    "དེ་ནས་ལོ་ངོ་བདུན་སོང་བ།",
