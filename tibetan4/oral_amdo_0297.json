    "དེའི་བཙུན་མོ་གཉིས་པ་མ་གཅིག་ངང་མོའི་བུ་ཏི་ཤྲི་ཀུན་དགའ་བློ་གྲོས་ཀྱིས་རང་གི་སྤུན་མཆེད་གཅུང་པོ་ཚོར་བླ་བྲང་བཞི་སོ་སོར་བགོས་ཏེ་སྤྲད།",
    "དཔོན་ཆེན་རྒྱལ་བ་བཟང་པོས་འགོ་གཙོ་བྱས་པའི་བླ་བྲང་གཞན་གསུམ་གྱི་ཕྱོགས་ཁག་བཅས་ཁག་གཉིས་སུ་གྱེས་ནས་དཔོན་ཆེན་རྒྱལ་བ་བཟང་པོས་འགོ་གཙོ་བྱས་པའི་ཕྱོགས་ཁག་ཕམ་ནས་ས་སྐྱའི་གདུང་བརྒྱུད་སྤུན་མཆེད་ཕན་ཚུན་གསོད་རེས་དང་བཙོན་འཇུག་བྱས་སོགས་བྱུང་རྐྱེན།",
    "མིང་རྒྱལ་རབས་ཀྱི་གོང་མ་ཐའི་ཙུའུ་ཀྲུའུ་ཡོན་ཀྲང་གིས་ཞིང་པའི་གྱེན་ལངས་ཀྱི་རྒྱལ་ཁའི་འབྲས་བུ་ཕྲོགས་ཏེ་མིང་རྒྱལ་རབས་བཙུགས་རྗེས།",
    "རབ་བྱུང་དྲུག་པའི་ཆུ་བྱི་མིང་ཐའི་ཙུའུ་ཀྲུའུ་ཡོན་ཀྲང་གི་ཧུང་ཝུ་ཁྲི་ལོ་ལྔ་པ་སྤྱི་ལོ་༡༣༧༢ལོར་བོད་ས་གནས་སུ་དབུས་གཙང་ཀྲི་ཧོའི་སི་ཟེར་བའི་བཀོད་འདོམས་པུའུ་བཙུགས་ཤིང་།",
    "ཏཱ་དཔལ་བོ་སྟག་གི་ཞལ་ལྕེ།",
    "༣སྣེ་མོ་ལས་འཛིན་གྱི་ཞལ་ལྕེ།",
    "ཧོར་འདྲ་ཟ་རྐང་གི་ཞལ་ལྕེ།",
    "བསད་པ་སྟོང་གི་ཞལ་ལྕེ།",
    "༡ རྨོས་པ་ཁྲག་གི་ཞལ་ལྕེ།",
    "༡༡ བསྙོན་ཧམ་མནའ་དག་གི་ཞལ་ལྕེ།",
    "༡༥ ནམ་ཕར་ཚུར་གྱི་ཞལ་ལྕེ་བཅས་རེད།",
    "དེ་དག་གི་ནང་ནས་དར་རྒྱས་ཆེ་ཤོས་ནི་གདན་ས་གསུམ་སྟེ་སེ་ར།",
    "ཕག་མོ་གྲུ་པ་ནང་ཞིག་གི་ལོ་ཞེས་ཀྱང་ཟེར།",
    "ཏཱ་མིང་གོང་མ་དབྱིང་ཙུང་ཀྲེང་ཐུང་གིས་ཧྲན་ཧྥ་ཝང་གི་གོ་གནས་སྤྲད།",
    "འབྲི་གུང་གི་དཔོན་ཆེན་གྱི་སྤྱི་མིང་།",
    "ཚོགས་རིག་འཛིན་གྱི་མནའ་མ་ཡང་ཡར་རྒྱབ་པའི་བུ་མོ་རེད།",
    "སེ་འབྲས་གཉིས་དམག་གིས་གཏོར་ཞིང་།",
    "ནགས་ཤོད་ལ་ལམ་བྱས་ནས་མཚོ་སྔོན་དུ་སོང་ཞིང་།",
    "དེ་མཚམས་སོག་པོའི་རྟ་དམག་གཙང་དམག་གི་སྟེང་དུ་རྒྱུགས་ནས་མི་སྟོང་ཕྲག་མང་པོ་བསད།",
    "རང་ཉིད་ལ་ཆབ་སྲིད་ཐོག་སྟོབས་ཤུགས་ཆེ་བའི་རྒྱབ་རྟེན་ཞིག་བཙལ་ཏེ་དགེ་ལུགས་པར་རྒོལ་ལན་སློག་རྒྱུའི་རེ་བ་བྱེད་བཞིན་ཡོད་པ་རེད།",
    "ཚོགས་ཀྱིས་ཁོ་པ་ཧལ་ཧ་ཡུལ་ནས་ཕྱིར་འབུད་བྱས་པ་དེ་མཚོ་སྔོན་དུ་འོངས།",
    "ཧལ་ཧ་ཆོག་ཐུས་རང་གི་བུ་ཨར་ས་ལང་ཟེར་བ་དམག་དཔུང་སྟོང་ཕྲག་ཁ་ཤས་དང་བཅས་གཙང་པ་རྒྱལ་པོའི་དཔུང་རོགས་བྱེད་པར་བཏང་བ་འབྲི་ཆུའི་སྟོད་རྒྱུད་དུ་སླེབས་སྐབས།",
    "གུ་ཤི་ཧན་གྱིས་བ་ཐུར་ཧོང་ཐའི་ཇི་སོགས་དཔོན་གཡོག་ཉུང་བསྡུས་ཚོང་པའི་ཆས་སྤྲས་ནས་དབུས་གཙང་གི་གནས་ཚུལ་རྟོག་ཞིབ་བྱེད་པར་འོང་བ་དང་ཐུག་འཕྲད་བྱུང་སྟེ་ལྷ་ས་བར་མཉམ་དུ་འོངས།",
    "ད་དུང་ཡར་འབྲོག་རྒྱུད་དུ་སོང་ནས་གཙང་པ་རྒྱལ་པོའི་དམག་དཔུང་ལ་ཕར་རྒོལ་བྱས་ཤིང་།",
    "ཀརྨ་ཞྭ་དམར་བས་མཚོ་སྔོན་དུ་ཨར་ས་ལང་གི་ཕ་ལ་ཡི་གེ་བཏང་ནས་ཕས་བུ་ལ་བཀོད་པ་བཏང་བ་ལྟར་བྱས་མ་སོང་ཟེར་བའི་ལན་དུ།",
    "ཨར་ས་ལང་གི་བློན་པོ་ཐའི་ཆིང་གིས་ལྐོག་གསོད་བྱས་ཏེ་ཨར་ས་ལང་གིས་གཙང་པ་རྒྱལ་པོར་དཔུང་རོགས་བྱེད་རྒྱུ་དོན་ཐོག་ཏུ་མ་འཁྱོལ།",
    "དེའི་ཕྱི་ལོ་གུ་ཤི་ཧན་གྱིས་བཱ་ཐུར་ཧོང་ཐའི་ཇི་དཔུང་རོགས་སུ་ཁྲིད་དེ་ཁྲི་དམག་གཅིག་གིས་ཆོག་ཐུ་རྒྱལ་པོའི་དམག་དཔུང་ཁྲི་གསུམ་དང་འཐབ་ནས་ཆོག་ཐུ་རྩ་མེད་བཏང་རྗེས།",
    "དཔུང་རོགས་བཱ་ཐུར་ཧོང་ཐའི་ཇི་ལ་རང་གི་བུ་མོ་ཨ་མིན་ཏ་ར་མནའ་མར་སྟེར",
    "དེ་ནས་མུ་མཐུད་དེ་སྔོན་གཙང་པ་རྒྱལ་པོས་བཀྲ་ཤིས་ལྷུན་པོའི་འཁྲིས་སུ་རྒྱབ་པའི་དགོན་གསར་བཀྲ་ཤིས་ཟིལ་གནོན་ཟེར་བ་བཤིག་ནས་དེའི་ཤིང་ཆ་ཡོངས་རྫོགས་ལྷ་སར་དྲངས་ཏེ་ལྷ་ས་གཙུག་ལག་ཁང་གི་ཁྱམས་རའི་ཤིང་ཆ་རྙིང་པ་རྣམས་བརྗེས་ཤིང་།",
    "གསེར་གྱི་བྱང་བུ་བོད་ཤོག་འཐུག་གྲོས་དང་སྙོམས་པ་ཞེང་སོར་བཞི་དཀྱུས་མཐོ་གང་ཙམ་ཡོད་པ་བཅོ་ལྔ་འཕྲུལ་མིག་ཏུ་སྦྲེལ་ནས་ལྟེབས་ཆོག་པ་ཞིག་གི་ངོས་སུ།",
    "གནམ་འོག་གི་སྐྱེ་འགྲོ་ཐམས་ཅད་བསྟན་པ་གཅིག་ཏུ་གྱུར་པ།",
    "བཅུ་བཞི་པ་བཅས་ཀྱི་སྐབས་རིམ་བཞིན་གསར་འཛུགས་བྱས་པ་རེད།",
    "མོ་དགོན་༩༤ མོ་དགོན་༡༦ ཐོ་དགོན་༣༤ མོ་དགོན་ཕོ་དགོན་༨ མོ་དགོན་༧ ཕོ་དགོན་༢༨དགེ་ལུགས་འོལ་ཁ་དང་དྭགས་པོ།",
    "འཛམ་མི་སེར་ཐེམ་གྲངས་ལོ་རེའི་འབྲུ།",
    "ལོ་རེའི་འབྲུ་འབབ་ཁལ་མིང་།",
    "ལོ་རེའི་འབྲུ་འབབ་ཀྱི་བརྣམས་གུངས།",
    "སྟོད་ལུང་ནང་ནས་རྒྱལ་མོ་ཚེ་རིང་བཀྲ་ཤིས་བཅས་ཀྱིས་སྣེ་ཁྲིད་ནས་དམག་ཁག་གསུམ་འོངས་པ།",
    "མཐར་གོང་དཀར་ནས་སྟོད་ལུང་ཕུར་རྒྱལ་མོ་ཚེ་རིང་བཀྲ་ཤིས་ལ་མགོ་བཏགས་ཞུ་བར་ཡོང་དགོས་བྱུང་སྐབས།",
    "ད་རེས་རང་གི་བུ་མོ་ལྷ་བཟང་ཧན་གྱི་བུ་ཆེ་བའི་མནའ་མར་གཏོང་བའི་གོ་སྐབས་དང་བསྟུན་ནས་བུ་མོ་བོད་དུ་ནས་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "ཕྱོགས་གཅིག་ནས་རང་གི་བུ་མོ་བོད་དུ་སྲུང་སྐྱེལ་བྱེད་པར་ཁ་གཡར་ཏེ་དམག་དཔུང་ཕོན་ཆེ་མཉམ་དུ་བཏང་ཞིང་།",
    "གཉིས་ནས་སྟོད་མངའ་རིས་བརྒྱུད་ནས་དམག་དཔུང་ཕོན་ཆེ་ཙམ་ཞིག་ཉིན་མོ་ཡིབ་ཅིང་མཚན་མོ་ཤར་བསྐྱོད་ཀྱིས་འདམ་གཞུང་དང་ཐག་ཉེ་སར་དམག་དཔུང་ཁག་གཉིས་དུས་གཅིག་ཏུ་འཛོམ་ཐུབ་པ་བྱས་རྐྱེན།",
    "གཉིས་ནས་ང་ཚོས་བོད་དུ་དཔུང་བསྐྱོད་བྱས་པ་འདི་སྒེར་དོན་གྱི་ཆེད་དུ་མིན་པར།",
    "ཁྱོན་རྟ་དམག་དྲུག་སྟོང་ཙམ་ཡོད་པ།",
    "བོད་ཀྱི་རྒྱ་ཆེའི་མང་ཚོགས་ལ་དངོས་པོས་མགོ་བསྐོར་བཏང་ནས་བསླུ་བྲིད་དང་།",
    "ལྷག་པར་དུ་ང་ལུམ་སྦྱར་གསུམ་མི་དགའ་བར་གྱུར་ཏེ་དའི་ཆིང་བ་དུར་དང་ཕོ་ལྷ་ཐའི་ཇི་གཉིས་གཏོར་ཕམ་གཏོང་རྒྱུའི་ལྐོག་གྲོས་བྱས་པ་རེད།",
    "ཕོ་ལྷ་ཐའི་ཇིས་སྟོད་མངའ་རིས་སུ་སོང་ནས་དའི་ཆིང་བ་དུར་གྱི་གཅེན་པོ་ནོ་མོན་གུང་དང་མཉམ་འབྲེལ་བྱས་ཏེ་གཙང་དམག་ཁྲིད་ནས་ང་ལུམ་སྦྱར་གསུམ་ཕམ་པར་བྱས་པ་སོགས།",
    "དེ་རྗེས་འགྱུར་མེད་རྣམ་རྒྱལ་གྱི་ཤོག་ཁ་མགྲོན་གཉེར་བློ་བཟང་བཀྲ་ཤིས་སོགས་མི་ངན་ཁག་གཅིག་གིས་ཨམ་བན་གཉིས་དང་།",
    "གཤམ་འོག་གི་དཔོན་རིགས་དང་།",
    "དང་ཟ་ཁང་གི་ལས་ཀ་བྱེད་མཁན་སོགས་ཧ་ལམ་ལྷ་སར་ཡོད་པའི་རྒྱ་རིགས་ཚང་མ་བསད་པ་སོགས་ཀྱི་ཟིང་ཆ་བསླངས་པ་རེད།",
    "བོད་མི་དམངས་རྣམས་གོང་མ་ཆེན་པོ་ཁྱེད་ལ་མི་དགའ་བ་ཆེན་པོ་བྱེད་ཀྱི་རེད།",
    "ལྕང་སྐྱ་ཧོ་ཐོག་ཐུས་ཞུས་པའི་སྐད་ཆ་དེ་ནི་དངོས་འབྲེལ་གོང་མ་ཆེན་པོའི་ཆབ་སྲིད་ལ་བསམས་པའི་སྐད་ཆ་རང་རེད།",
    "ཆིང་གོང་མས་བོད་ས་གནས་སུ་བཙུགས་པའི་བཀའ་ཤག་གི་ནང་།",
    "དེ་མོ་ཧོ་ཐོག་ཐུ་འཕྲིན་ལས་རབ་རྒྱས་ཀྱིས་ལོ་བཅུ།",
    "བོད་ས་གནས་ཀྱི་མཐོ་རིམ་ལོག་སྤྱོད་པ་ཁག་གཅིག་གིས་མེས་རྒྱལ་ལ་རྒྱབ་གཏོད་བྱས་པའི་སྐོར།",
    "ཕྱི་ནས་ཡོང་བའི་བཙན་འཛུལ་ལ་རང་སྲུང་གི་རྒོལ་ལན་སྤྲོད་ཕོད་ཀྱི་མེད་པར་བརྟེན།",
    "དུས་མཚུངས་བོད་ས་གནས་ལ་ཡང་བཙན་འཛུལ་གྱི་བྱ་སྤྱོད་སྤེལ་བདེ་རུ་ཕྱིན་པ་རེད།",
    "དབྱིན་ཇི་བཙན་འཛུལ་དམག་གིས་གམ་འབྲས་མཐའ་མཚམས་སུ་བཙན་འཛུལ་བྱས་ཤིང་།",
    "ལོ་དེར་དབྱིན་ཇི་བཙན་འཛུལ་དམག་གིས་བོད་ས་གནས་སུ་བཙན་འཛུལ་བྱེད་ཤུགས་ཆེ་རུ་བཏང་རྐྱེན་བོད་ས་གནས་ཀྱི་རྒྱ་ཆེའི་མང་ཚོགས་ཀྱིས་དཔའ་ངར་ཞུམ་པ་མེད་པའི་འགོག་རྒོལ་བྱས་པ་དང་།",
    "རྒྱལ་གཅེས་མཐོ་རིམ་མི་སྣ་ཁག་གཅིག་མང་ཚོགས་དང་མཉམ་དུ་བཙན་འཛུལ་བཀག་འགོག་བྱས་ཀྱང་།",
    "ཁ་བྲལ་ནས་ཧྲ་ཧོང་གོང་མའི་སྲུང་སྐྱོབ་འོག་བོད་རང་བཙན་རྒྱལ་ཁབ་ཟེར་བ་ཞིག་ཡོང་རྒྱུའི་རེ་བ་གནང་བ་རེད།",
    "རྗེས་སུ་སླར་ཡང་དབྱིན་ཇི་བཙན་རྒྱལ་རིང་ལུགས་པའི་མགོ་བསྐོར་བསླུ་བྲིད་འོག་དེ་སྔ་བོད་ཀྱི་རྒྱ་ཆེའི་མི་དམངས་ཀྱི་བསྟན་དགྲ་དབྱིན་ཇི་ཟེར་ནས་སེམས་ཀྱི་གཏིང་ནས་ཁོང་ཁྲོ་བྱེད་དགོས་སའི་དབྱིན་ཇི་བཙན་རྒྱལ་རིང་ལུགས་པའི་རོགས་རམ་ལ་བརྟེན་ནས་བོད་འདི་མེས་རྒྱལ་དང་ཁ་བྲལ་ཏེ་བོད་རང་བཙན་རྒྱལ་ཁབ་ཅིག་འཛུགས་རྒྱུའི་རེ་བ་གནང་ནས་སླར་ཡང་དབུ་འཁོར་ཆེན་པོ་ཐེབས་པ་རེད།",
    "རྒྱལ་ཁབ་དེའི་སྐེ་ལ་ཞགས་ཐག་བསྐོན་ཏེ་མི་རབས་མང་པོའི་བར་ཐར་མི་ཐུབ་པ་བཟོ་གི་ཡོད་པ་རེད།",
    "ད་དུང་ཡང་མི་ཁག་གཅིག་གིས་བཙན་རྒྱལ་རིང་ལུགས་པས་བསྐོན་པའི་ཞགས་ཐག་དེའི་ནང་དུ་མ་བསྐུལ་རང་མོས་ཀྱིས་འཛུལ་རྩིས་བྱས་པ་དེ་ཚོའི་གཉིད་ལམ་སྐྱིད་པོ་དེ་ལས་གཉིད་ག་དུས་སད་ཐུབ་ཀྱི་རེད་དམ།",
    "སྤྱི་ལོ་༡༩༤༩ལོར་ཀྲུང་གོ་གུང་ཁྲན་ཏང་གི་ཡང་དག་པའི་འགོ་ཁྲིད་འོག་བོད་ས་གནས་དང་ཐའེ་ཝན་གཉིས་ཙམ་མ་གཏོགས་རྒྱལ་ཡོངས་བཅིངས་འགྲོལ་བཏང་ཞིང་།",
    "བོད་དུ་བསྐྱོད་ནས་བོད་ཀྱི་མི་རིགས་ཁག་གི་མི་དམངས་རྣམས་ཕྱི་རྒྱལ་བཙན་འཛུལ་པའི་སྟོབས་ཤུགས་དང་།",
    "ཟླ་༡ཚེས་༢༦ཉིན་ཀྲུང་གོ་མི་དམངས་བཅིངས་འགྲོལ་དམག་དཔུང་ལྷ་སར་འབྱོར་སྐབས་བོད་ཀྱི་རྒྱ་ཆེའི་སེར་སྐྱ་མི་དམངས་རྣམས་ཀྱིས་སྤྲོ་སེམས་འཁོལ་བའི་དགའ་བསུ་ཞུས་པ་རེད།",
    "དེ་ལས་གཞན་པའི་འགྲོ་ལམ་མེད་པ་གསལ་པོར་ཤེས་པ་རེད།",
    "ད་དུང་མི་དམངས་མང་ཚོགས་ཀྱི་བསམ་བློའི་འདུ་ཤེས་འཛིན་སྟངས་ཐད་ཀྱི་འཐབ་རྩོད་བྱེད་དགོས་པ་མཐོང་ནས།",
    "མེས་རྒྱལ་ལ་རྒྱབ་གཏོད་བྱེད་པའི་ངོ་ལོག་ཟིང་འཁྲུག་སློང་རྒྱུའི་ཆབ་སྲིད་བསམ་བློའི་གྲ་སྒྲིགས་རང་རེད།",
    "དེ་ནི་རླབས་ཆེན་གྱི་ཀྲུང་གོ་གུང་ཁྲན་ཏང་དང་མའོ་ཀྲུའུ་ཞིའི་དབུ་ཁྲིད་འོག་གི་བོད་ཀྱི་རྒྱ་ཆེའི་ཞིང་འབྲོག་ངལ་རྩོལ་མི་དམངས་དང་བོད་ཀྱི་མཐོ་རིམ་ལོག་སྤྱོད་པ་ཉུང་ཤས་ཤིག་བར་རྒྱལ་ཕམ་ཐག་ཆོད་བྱེད་པའི་མཐའ་མའི་དམག་འཐབ་ཅིག་ཡིན་ཞིང་།",
    "མགོ་སྐོར་གྱི་རང་བཞིན་བཅས་གསལ་པོ་མཐོང་ཐུབ་པ་ཞིག་རེད།",
    "མི་འབོར་བཅས་གང་ཅིའི་ཐད་ནས་ལོ་རེ་ལས་ལོ་རེ་ཡག་ཏུ་ཕྱིན་ནས་ཧ་ཅང་རྗེས་ལུས་ཡིན་པའི་བོད་རྙིང་པ་དེ་དར་རྒྱས་ཕུན་སུམ་ཚོགས་པའི་བོད་ལྗོངས་གསར་པ་ཞིག་ཏུ་འགྱུར་བའི་འགོ་ཚུགས་པ་རེད།",
    "མཐོ་རིམ་མི་སྣས་བོད་ས་གནས་ཁག་གི་ས་ཞིང་དང་།",
