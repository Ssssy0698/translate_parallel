    "བཞུགས་ནས་བདག་ལ་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "བཞུགས་ནས་བདག་ལ་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "བཞེས་ནས་བདག་ལ་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "གནང་ནས་བདག་ལ་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "སྙན་པའི་དབྱངས་དང་བཅས་ཏེ་གསོལ་བ་འདི་ལྟར་གདབ་པར་བྱས་སོ།",
    "ཡེ་ཤེས་ལྔ་དང་ལྡན་པར་བྱིན་གྱིས་རློབས།",
    "ཉེ་ལམ་གཅིག་ཆོད་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "མཐུ་རྩལ་སྟོབས་དང་ལྡན་པར་བྱིན་གྱིས་རློབས།",
    "བཀའ་རྒྱུད་མན་ངག་བཞུགས་པའི་གསང་ཕུག་ཏུ།",
    "འགྲོ་དོན་མཐའ་རུ་ཕྱིན་པར་བྱིན་གྱིས་རློབས།",
    "གནས་ལུགས་དོན་དམ་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "རྟོགས་ཚད་གདེང་དང་ལྡན་པར་བྱིན་གྱིས་རློབས།",
    "མྱོང་རྟོགས་གྲོལ་བ་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "མཐར་ཐུག་རང་ས་ཟིན་པར་བྱིན་གྱིས་རློབས།",
    "ཅི་བྱེད་དོན་དང་ལྡན་པར་བྱིན་གྱིས་རློབས།",
    "བོན་སེམས་མ་བུ་འཕྲོད་པར་བྱིན་གྱིས་རློབས།",
    "མ་བཅོས་མཐའ་བྲལ་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཉམས་རྟོགས་ལྷུག་པར་འཆར་བར་བྱིན་གྱིས་རློབས།",
    "བདག་འཛིན་རྩད་ནས་ཆོད་པར་བྱིན་གྱིས་རློབས།",
    "འགྲོ་དོན་དཔག་མེད་ནུས་པར་བྱིན་གྱིས་རློབས།",
    "བསླབ་གསུམ་རྣམ་པར་དག་པར་བྱིན་གྱིས་རློབས།",
    "འགྲོ་བ་ཐར་བར་འདྲེན་པར་བྱིན་གྱིས་རློབས།",
    "འགྲོ་རྣམས་སྨིན་གྲོལ་འཁོད་པར་བྱིན་གྱིས་རློབས།",
    "ཟབ་དོན་མངོན་དུ་སྟོན་པར་བྱིན་གྱིས་རློབས།",
    "རང་རིག་མངོན་དུ་གྱུར་པར་བྱིན་གྱིས་རློབས།",
    "སྨིན་གྲོལ་རྒྱུན་ཆད་མེད་པར་བྱིན་གྱིས་རློབས།",
    "འགྲོ་དོན་དཔག་མེད་ནུས་པར་བྱིན་གྱིས་རློབས།",
    "ཟབ་དོན་མངོན་དུ་སྟོན་པར་བྱིན་གྱིས་རློབས།",
    "ཐིག་ལེ་ཉག་གཅིག་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "མཐའ་བྲལ་རྒྱ་ཡན་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "གནས་ལུགས་དོན་དམ་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཉམས་རྟོགས་གདེང་དང་ལྡན་པར་བྱིན་གྱིས་རློབས།",
    "དོན་གཉིས་མཐའ་རུ་ཕྱིན་པར་བྱིན་གྱིས་རློབས།",
    "ས་ལམ་ཡོན་ཏན་རྫོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཀློང་སྒོམ་མངོན་དུ་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཀུན་མཁྱེན་ཟླ་བ་རྒྱལ་མཚན་ལ་གསོལ་བ་འདེབས།",
    "བདག་མེད་དོན་དམ་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "འཁོར་འདས་རོ་གཅིག་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "མཐའ་བྲལ་མཁའ་ལྟར་དག་པར་བྱིན་གྱིས་རློབས།",
    "ཉེ་ལམ་གཅིག་ཆོད་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "བུ་ལྟར་སྐྱོབ་པར་བྱིན་གྱིས་རློབས།",
    "ཉམས་ལེན་ནུས་པར་བྱིན་གྱིས་རློབས།",
    "ཞེན་པ་ལོག་པར་བྱིན་གྱིས་རློབས།",
    "འཁྲི་བ་ཆོད་པར་བྱིན་གྱིས་རློབས།",
    "ཞེན་ཆགས་མེད་པར་བྱིན་གྱིས་རློབས།",
    "རྟག་ཏུ་སུན་པར་བྱིན་གྱིས་རློབས།",
    "བདག་ཕྱོགས་མེད་པར་བྱིན་གྱིས་རློབས།",
    "མཐོང་ཞིང་གོམས་པར་བྱིན་གྱིས་རློབས།",
    "ཉམ་ང་མེད་པར་བྱིན་གྱིས་རློབས།",
    "རང་སྣང་ཆོད་པར་བྱིན་གྱིས་རློབས།",
    "རོ་སྙོམས་ནུས་པར་བྱིན་གྱིས་རློབས།",
    "རང་ངོ་ཤེས་པར་བྱིན་གྱིས་རློབས།",
    "འདུ་འབྲལ་མེད་པར་བྱིན་གྱིས་རློབས།",
    "ཨ་ཨཱ་ཧཱུཾ་ཅི་པར་རཏ་ཐ་ཚན་སིདྡྷི་འགྲོ།",
    "འཆི་བ་རྗེས་སུ་དྲན་པར་བྱིན་གྱིས་རློབས།",
    "ཞེན་པ་གཏིང་ནས་ལོག་པར་བྱིན་གྱིས་རློབས།",
    "ཐམས་ཅད་སྒྱུ་མར་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཕྲ་དང་རགས་དང་ཉེས་བྱས་ཕྱོགས་མཐུན་དང་།",
    "དེ་བཞིན་བྱས་དང་བྱེད་པར་གྱུར་པ་ཀུན།",
    "ཅུང་ཟད་ཙམ་ཡང་མི་བརྗེད་དྲན་བྱས་ཏེ།",
    "ཀུན་གྱི་སྡིག་སྒྲིབ་བློ་ཡིས་བསྡུས་བྱས་ནས།",
    "གནོང་འགྱོད་ཞུམ་པའི་སེམས་ཀྱིས་རབ་ཏུ་བཤགས།",
    "ན་མ་ཨ་དཀར་གཤའ་ཡ་ནི་ཤག་སལེ་སང་ངེ་སཱཧཱ།",
    "ཨ་ཡཾ་རཾ་མཾ་ཁཾ་ཧཱུྃ་ཤག་སལེ་སང་ངེ་སྭཱཧཱ།",
    "བདག་སོགས་འགྲོ་བའི་དོན་དུ་བཞེས་ནས་ཀྱང་།",
    "ཡུན་གནས་རྒྱུན་དུ་བཞུགས་པར་གསོལ་བ་འདེབས།",
    "མཁྱེན་དང་བརྩེ་དང་ཐབས་དང་ཐུགས་རྗེ་ཡིས།",
    "སྐྱོ་ངལ་མེད་པར་འགྲོ་བའི་དོན་བྱེད་ཤོག།",
    "ཨ་དཀར་སེམས་ཉིད་རྣམ་པར་དག།",
    "ཀྱེ་ཧོ་བདག་ལུས་ཚོགས་སུ་འབུལ་ལོ་བཞེས་སུ་གསོལ།",
    "ཁྱེད་ཀྱི་ལྟ་དགོངས་ཉམས་རྟོགས་ཁྱད་པར་ཅན།",
    "མཁྱེན་དང་བརྩེ་བས་འགྲོ་ལ་བུ་བཞིན་སྐྱོབ།",
    "མུ་ཡེ་ལྷ་རྒྱུང་རྩ་བྲལ་ངང་ལ་བཞུགས།",
    "ཏ་པི་ཧྲི་ཙ་རྣམ་མཁྱེན་སྤྲུལ་བའི་སྐུ།",
    "གཤེན་རྒྱལ་ལྷ་རྩེ་རྫོགས་ཆེན་ངང་ལ་བཞུགས།",
    "ལྷ་སྒོམ་དཀར་པོ་གསང་སྤྱོད་མངོན་དུ་གྱུར།",
    "ཡང་སྟོན་ཆེན་པོ་རྣམ་མཁྱེན་སྤྲུལ་བའི་སྐུ།"
  ]
}