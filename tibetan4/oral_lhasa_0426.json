    "ཟག་པ་མེད་པ་ནི་སྤྱོད་པ་རྣམ་པར་དག་པའོ།",
    "སྤྱོད་པ་རྣམ་པར་དག་པ་ནི་སྦྱིན་པ་ལ་སོགས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་ཏེ།",
    "ལུས་རྣམ་པར་དག་པ་ལ་སོགས་པ་ནི་སྤྱོད་པ་རྣམ་པར་དག་པའི་སྔོན་དུ་འགྲོ་བའི་ཕྱིར་ཕྱིས་བསྟན་ཏོ།",
    "གཟུངས་ཀྱིས་འཐོབ་པར་མི་འགྱུར་གང་།",
    "དེ་གཟུངས་འདིས་འཐོབ་པར་འགྱུར་བས་ན།",
    "དེའི་ཕྱིར་དོན་དམ་པ་སྒྲུབ་པས་ཞེས་གསུངས་སོ།",
    "དེ་བས་ན་གཅིག་ཏུ་ངེས་པ་འཐོབ་པའི་ཕྱིར་བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "འདིས་ནི་ས་བརྒྱད་པ་ལ་སོགས་པ་འཐོབ་པར་བསྟན་ཏེ།",
    "རྟོགས་པར་བྱེད་པས་ན་གཟུངས་འདི་ཉིད་ཡིན་ནོ།",
    "དེ་ཕྱིར་དམ་པ་ཞེས་གསུངས་ཏེ།",
    "བདུད་ཀྱི་ལས་ཐམས་ཅད་ཡང་དག་པར་འདའ་བ་ཞེས་བྱ་བའི་གཟུངས་ཏེ།",
    "དོན་དང་མཐུན་པར་གསུངས་པ་ཡིན།",
    "ཇི་སྐད་གསུངས་པ་ཐམས་ཅད་འགྲུབ་པོ།",
    "སྟོང་པ་ཉིད་ལ་གོམས་པས་བདུད་ཀྱི་ལས་ཐམས་ཅད་ལས་ཡང་དག་པར་འདའ་བར་འགྱུར་རོ།",
    "ཐུགས་རྗེས་ཕན་ཡོན་ཡང་དག་གསུངས།",
    "རྒྱལ་བས་གསུངས་ཏེ་སྔ་མ་སྔ།",
    "སྒྲུབ་པར་བྱེད་པ་གང་ཡིན་པ།",
    "སྟོབས་ནི་གནས་དང་གནས་མ་ཡིན་པ་མཁྱེན་པའི་སྟོབས་ལ་སོགས་པ་བཅུའོ།་།",
    "སྒོ་མཐའ་ཡས་པས་བསྒྲུབ་པའི་གཟུངས་འདིའི་དོན་གང་རྗོད་པར་བྱེད་པའི་ངོ་བོར་གནས་པ་ལ་བྱ་བ་སྟེ།",
    "ཡང་ན་སེམས་དཔའི་སྒྲ་ནི་དངོས་པོར་བསྟན་པར་བལྟ་བར་བྱ་སྟེ།",
    "འདི་དག་ཐམས་ཅད་ནི་ཕྱིར་མི་ལྡོག་པར་མཚུངས་སོ།",
    "མྱུར་བའི་ཚིག་གསུངས་པ་གང་ཡིན་པ་དེ་ནི།",
    "འདིར་ནི་དམིགས་པ་མེད་པར་བསྒྲགས།",
    "དམིགས་པར་བྱ་བ་མེད་པའི་ཕྱིར།",
    "ཡང་དག་པར་ན་མི་དམིགས་པ་ཁོ་ན་སྟེ།",
    "དགག་པར་བྱ་བ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བུའི་གཟུངས་དེ་ལས་ཅི་ཞིག་འགྲུབ་པར་མི་འགྱུར་ཏེ།",
    "ཐམས་ཅད་ཀྱང་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ཕྱིར་ཅི་བདེར་སྒོམས་པར་གྱིས།",
    "གནས་དང་གནས་མ་ཡིན་པ་མཁྱེན་པའི་སྟོབས་ལ་སོགས་པ་ནི་ཡོན་ཏན་རྣམས་ཏེ།",
    "གོམས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སོ།",
    "འདི་ལྟར་འཁོར་གསུམ་རྣམ་པར་དག་པའི་ཕྱིར།",
    "ཁྱད་པར་འདི་ལས་འཐོབ་པར་འགྱུར།",
    "སྦྱིན་པར་བྱ་བ་དང་།་",
    "སྦྱིན་པ་ལ་སོགས་པ་རྣམ་པར་དག་པ་ནི་དེ་ཡིན་ཏེ།",
    "ཕན་ཡོན་གཞན་ཡང་གསུངས་ཏེ།",
    "ཅི་རིགས་པར་ནི་སྦྱར་བར་ཟད།",
    "སྐྱེས་བུ་ཤེས་པ་དང་ལྡན་པས་ཅི་རིགས་པར་སྦྱར་བར་བྱ་བ་འབའ་ཞིག་ཏུ་ཟད་དོ།",
    "ཡང་ན་ཕན་ཡོན་ཐམས་ཅད་ཀྱང་གཟུངས་ཐམས་ཅད་ཀྱི་ཡིན་པར་གསུངས་སོ།",
    "ཅི་རིགས་པར་ནི་རྟོགས་པར་བྱ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་དགོངས་པ་ནི་རྣམ་པ་བཞིར་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ་མཉམ་པ་༧ ཉིད་ལ་དགོངས་པ་ཞེས་བྱ་བ་ནི།",
    "འགྱུར་རོ་ཞེས་གསུངས་པ་ལ་སོགས་པ་ལྟ་བུའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པས།",
    "སྦྱིན་པ་ལ་སོགས་པའི་བསྔགས་པ་བརྗོད་པར་མཛད་ནས།",
    "གཞན་དང་གཞན་ལ་གུས་པར་མི་འགྱུར་བས།",
    "ཅེས་བྱ་བ་ལ་སོགས་པས་སྦྱིན་པ་ལ་སོགས་པ་དེ་དག་ཉིད་སྨོད་པ་པར་མཛད་པ་ལྟ་བུའོ།",
    "ཆེན་པོའང་ཡིན་པར་བཀའ་སྩལ་ཏོ།",
    "༧༣ ལ་ཡོན་གྱི་ཚིགས་སུ་བཅད་པ་སོ་སོར་བརྟག་པར་བྱ་སྟེ།",
    "དེ་ཕྱིར་གཟུངས་ནི་འཐོབ་པར་འགྱུར།",
    "ཅེས་བརྗོད་པར་བྱ་ཞེས་བྱ་བ་ལྷག་མ་ཡིན་པ་དེའི་ཚེ་ན་གཟུངས་སྨོས་པ་མངོན་སུམ་གྱི་ཕན་ཡོན་ཡིན་འཕགས་པ་སྒོ་མཐའ་ཡས་པ་སྒྲུབ་པའི་གཟུངས་ཀྱི་རྒྱ་ཆེར་འགྲེལ་པ།",
    "འདིས་ནི་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམ་པ་བཞི་ཐོབ་པར་བསྟན་ཏེ།",
    "དོན་ཐམས་ཅད་ཅེས་སྨོས་པས་ནི་དོན་སོ་སོ་ཡང་དག་པར་རིག་པ་བསྟན་ཏོ།",
    "ཚིག་འབྲུ་ཐམས་ཅད་ཅེས་སྨོས་པས་ནི་ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པ་བསྟན་ཏོ།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པ་བསྟན་ཏེ།",
    "འཇུག་པར་བྱེད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདིས་ཀྱང་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་འཐོབ་པར་བསྟན་ཏོ།",
    "དུས་གཞན་ལ་དགོངས་པའི་སྒོ་ནས་དེ་སྐད་ཅེས་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཕན་ཡོན་འདི་དངོས་དང་བརྒྱུད་པའི་སྒོ་ནས་གཟུངས་རྣམ་པ་གསུམ་ཆར་གྱི་ཡང་ཡིན་པར་གསུངས་སོ།",
    "ཞེས་བྱ་བ་འདིས་ཀྱང་གཟུངས་རྣམ་པ་གསུམ་ཆར་གྱི་ཕན་ཡོན་བསྟན་པར་རིག་པར་བྱའོ།",
    "ཤུགས་ཀྱིས་ན་ཕན་ཡོན་འདི་དོན་གྱི་གཟུངས་ཀྱི་ཡང་ཡིན་པར་ངེས་པར་གཟུང་བར་བྱའོ།",
    "༧༣ རབ་གསུམ་ཆར་གྱི་ཡང་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཕན་ཡོན་འདི་དོན་གྱི་གཟུངས་ཀྱི་ཡིན་པར་བསྟན་ཏོ།",
    "འདི་ལྟར་ཟླ་བ་གཅིག་སྨོས་པས་ན་ཕན་ཡོན་འདི་དུས་གཞན་ལ་དགོངས་པའི་སྒོ་ནས་ཀྱང་དེ་ཡིན་པར་མི་སྲིད་དོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཕན་ཡོན་འདི་ཡི་གེའི་གཟུངས་ཀྱི་ཡིན་པར་དུས་གཞན་ལ་དགོངས་པར་བསྟན་ཏོ།",
    "ཕན་ཡོན་འདི་དོན་གྱི་གཟུངས་ཀྱི་ཡིན་པར་ནི་དོན་གྱིས་བསྟན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པར་སྦྱར་བར་བྱ་སྟེ།",
    "འདི་ཡང་ཡི་གེ་དང་དོན་གྱི་གཟུངས་གཉི་གའི་ཕན་ཡོན་དུ་ཤེས་པར་བྱའོ།་",
    "བློ་གྲོས་ནི་མཉམ་པར་བཞག་པ་མ་ཡིན་པའི་ཤེས་རབ་པོ།",
    "རྟོགས་པ་ནི་མཉམ་པར་གཞག་ས་པའི་ཤེས་རབ་པོ།",
    "ཡང་ན་རྟོགས་པ་ནི་ཐམས་ཅད་དུ་ཐོགས་པ་མེད་པར་འཇུག་པ་ཉིད་དོ།",
    "དུས་གཞན་ལ་དགོངས་པའི་སྒོ་ནས་ཡི་གེའི་གཟུངས་ཀྱི་ཡིན་པར་རིག་པར་བྱའོ།",
    "དོན་གྱི་གཟུངས་ཀྱི་ནི་སྔ་མ་བཞིན་དུ་ཤུགས་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་ཤེས་བྱའི་སྒྲིབ་པ་སྤངས་པ་ལས་འགྱུར་རོ།",
    "ཡང་ན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སོ།",
    "ཡང་ན་རྒྱུ་དང་རྒྱུ་ཅན་གྱི་ཚུལ་དུ་གཉི་ག་རྟོགས་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ལ་༧ སོགས་པ་གསུངས་ཏེ།",
    "ཅིའི་ཕྱིར་དེ་སྐད་གསུངས།",
    "ཐོས་མ་ཐག་ཏུ་ཞེས་གསུངས་པའི་ཕྱིར་དང་།",
    "སྐད་ཅིག་དེ་ལ་ཞེས་གསུངས་པའི་ཕྱིར།་",
    "ཇི་ལྟ་བ་བཞིན་དུ་ངེས་པ་ཁོ་ནར་ཚེ་འདི་ལ་ཁྱད་པར་འདི་སྒྲུབ་པར་བྱེད་དོ་ཞེས་བྱ་བ་སྟེ་སྟོན་པར་མཛད་པ་ཡིན་ཏེ།",
    "གཞན་ཚེ་རབས་གཞན་ན་གོམས་པ་གང་ཡིན་པ་དེ་ཡང་གཟུངས་ཐོས་མ་ཐག་ཏུ་ངེས་པར་ལུང་བསྟན་པར་འགྱུར་ཞིང་།",
    "འདི་ལ་འཁྲུལ་པ་བསྐྱེད་པར་མི་བྱའོ།",
    "འདིས་ནི་ཕན་ཡོན་འདི་ཡི་གེ་དང་དོན་གྱི་གཟུངས་ཀྱི་ཡིན་པར་བསྟན་ཏོ།",
    "ཕན་ཡོན་འདི་ནི་ཡི་གེའི་གཟུངས་ཀྱི་ཡིན་པར་དུས་གཞན་ལ་དགོངས་པའི་སྒོ་ནས་བསྟན་པའོ།",
    "དོན་གྱི་གཟུངས་ཀྱི་ནི་དོན་གྱིས་བསྟན་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དོན་གྱི་གཟུངས་ཀྱི་ནི་དོན་གྱི་དངོས་དང་བརྒྱུད་པར་ཅི་རིགས་པར་རིག་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསྲུང་བའི་ཆོ་ག་འདི་བྱས་ལ།",
    "གཙང་མས་འདུ་དང་འབྲེལ་སྤང་ཞིང་།",
    "ལོག་པར་རྣམ་པར་བརྟགས་པ་ལས་བྱུང་བའོ།",
    "དེ་དག་མེད་པས་བག་ཡོད་པར་གྱུར་ནས།",
    "ལས་ངན་པ་མ་ལུས་པར་ཡོངས་སུ་སྤངས་ཏེ།",
    "རབ་ཏུ་བསྒོམས་པ་གུས་བྱས་ལ།",
    "སེམས་ནི་རྩེ་གཅིག་བྱས་ནས་སུ།",
    "རྒྱུད།་ནུ་༧༣༡ ནང་ཀྱིས་དེ་ལ་གཟུངས་སྦྱིན་པར་མཛད་ཅེ་ན།",
    "བཟླས་བསྲུང་ལ་སོགས་ཕུན་ཚོགས་བྱས།",
    "གཟུངས་དེ་རྣམ་པ་ཇི་ལྟ་བུར་བསམས་ན་ཐོབ་པར་འགྱུར་ཞེ་ན།",
    "ཕྱིར་བསམ་པར་བྱ་བའི་འོས་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡང་ན་སྤྲུལ་པའི་སྐུ་ལ་བསམ་པ་གང་ཡིན་པ་དེ་ནི་བསམ་པར་བྱ་བ་ཡིན་ཏེ།",
    "ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ལ་བསམ་པ་གང་ཡིན་པ་དེ་ནི་བསམ་པར་བྱ་བ་མ་ཡིན་པ་སྟེ།",
    "རྣམ་པ་གཞན་ཡང་བསམ་པར་བྱ་བ་བསམ་པར་ནུས་པའི་དངོས་པོ་ལ་བསམ་པ་གང་ཡིན་པ་དེ་ནི་བསམ་པར་བྱ་བ་ཡིན་ནོ།",
    "བསམ་པ་དེ་དག་ནི་བསམ་པར་མི་བྱའོ།",
    "དེ་ལ་ཡང་ལོག་པར་བསམ་པར་མི་བྱའོ།",
    "དོན་དམ་པར་ན་དགག་པར་བྱ་བ་མེད་པ་ལ་དགག་པ་མི་འཇུག་པའི་ཕྱིར་མེད་པ་ཁོ་ན་སྟེ།",
    "ལོག་པར་བསམ་པར་མི་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ནུ་༧༣གཅིག་པ་མ་ཡིན་པའི་མཚན་ཉིད་ལ་སོགས་པ་རྣམ་པར་སེམས་པ་སྟེ།",
    "གང་སྟོང་པ་ཉིད་དུ་ལྟ་བ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལྟ་བུའོ།",
    "དཔེར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་༦ དང་།",
    "མ་འབད་པར་མཁྱེན་པ་དང་།",
    "མ་བསྟན་པར་མཁྱེན་པའོ།",
    "བག་ཆགས་དང་བཅས་པར་སྤངས་པ་དང་།",
    "ཏིང་ངེ་འཛིན་དང་སྙོམས་པར་འཇུག་པའི་སྒྲིབ་པ་ཐམས་ཅད་སྤངས་པ་སྟེ།",
    "འདིས་ནི་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་བསྟན་པར་རིག་པར་བྱའོ།",
    "གང་བྱས་པས་ནི་འཐོབ་འགྱུར་བ།",
    "རྣལ་འབྱོར་པ་ཇི་ལྟ་བུས་གཟུངས་འདི་ཐོབ་པར་འགྱུར་བ་དེ་ནི་བཞི་ཚན་དང་པོས་བསྟན་ཏོ།",
    "རྣལ་འབྱོར་པ་ཇི་ལྟ་བུས་གཟུངས་འདི་ཐོབ་པར་འགྱུར་ཞེ་ན།",
    "བསྟན་པས་དེ་ལ་འཛུད་པར་བྱེད།",
    "འདོད་པ་ལྔའི་ཡོན་ཏན་རྣམས་ལྷག་པར་ཆགས་པ་མེད་ན་སྲོག་གཅོད་པ་ལ་སོགས་པ་མི་བྱེད་དོ།",
    "འདི་ལྟར་འདོད་པ་རྣམས་ལ་ལྷག་པར་ཆགས་ན་ཕྲག་དོག་བྱེད་པ་དང་།",
    "སེར་སྣ་བྱེད་པར་འགྱུར་རོ།",
    "འགྱོད་པ་མེད་པར་སྦྱིན་པའི་ཚུལ་ཅན་ནི་ཡིད་ལ་གཅགས་པ་མེད་པར་སྦྱིན་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཡང་ན་གཉིས་སུ་ངེས་པར་གཟུང་བའི་ཕྱིར་གསུངས་ཏེ།",
    "འདོད་པ་རྣམས་ཀྱི་ཉེས་པ་བསྟན་པའི་ཕྱིར་གསུངས་པ་ལ།",
    "ཡང་ན་འདོད་པའི་རྩ་བ་ལུས་ཀྱི་མི་གཙང་བའི་དྲི་དང་ལྡན་པའི་ཕྱིར་རོ་།",
    "འདོད་ཕྱིར་འཇིག་རྟེན་བཅིང་དང་བསད་པར་འགྱུར།",
    "འདི་ཡང་ཡོངས་སུ་འཛིན་པ་འདི་ནི་རྣམ་པ་ཐམས་ཅད་དུ་གནོད་པའི་རྒྱུ་ཡིན་པར་བསྟན་པས་གདུལ་བ་རྣམས་དེ་ལས་འདུན་པ་བཟློག་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ལྷག་པར་ཆགས་པ་སྤང་བའི་ཕྱིར་རོ།",
    "ཡང་དུས་གཞན་ལ་དགོངས་ཏེ་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྒྱུན་མི་ཆད་པར་ཚོལ་བ་ནི་ལས་ངན་པ་ཡོངས་སུ་སྤང་བའི་ཕྱིར་རོ།",
    "གཞན་མི་སེམས་པར་ཚོལ་བ་ནི་ལོག་པར་རྣམ་པར་རྟོག་པ་ཡོངས་སུ་སྤང་བ་དང་།",
