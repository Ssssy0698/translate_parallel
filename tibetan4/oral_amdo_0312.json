    "དེ་ཡང་བྱེ་བྲག་པས་ས་སོགས་ཐམས་ཅད་ལ་རེག་བྱ་བཏང་སྙོམས་པ་འགོག་པར་འདོད་པས།",
    "མཐོང་བ་དང་མ་མཐོང་བའི་ས་སོགས་གསུམ་པོ་ཐམས་ཅད་ལ་རེག་བྱ་བཏང་སྙོམས་པ་འགོག་དགོས་པས།",
    "ལུང་དངོས་སྟོབས་ཀྱི་ཡུལ་གནོད་སྒྲུབ་དུ་འཇུག་པས་ལུང་གིས་བཀག་པ་མ་ཡིན་གྱི།",
    "སློབ་དཔོན་ཕྱ་པ་ན་རེ་རྟགས་ཡང་དག་གི་མཚན་ཉིད་ཀྱི་ཟུར་གྱི་ལྡོག་པས་སེལ་མ་ནུས་པའི་ལོག་རྟོག་དང་རིགས་མི་མཐུན་གང་ཡང་རྗེས་འགྲོས་སེལ་མི་ནུས་པས།",
    "རྟགས་ཡང་དག་གི་མཚན་ཉིད་ཀྱི་ཟུར་གྱི་རྗེས་འགྲོས་སེལ་མི་ནུས་པའི་ལོག་རྟོག་དང་རིགས་མི་མཐུན་གང་ཡང་ལྡོག་པས་སེལ་མི་ནུས་པའི་ཕྱིར།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཡིན་པར་ཐལ།",
    "ཚུལ་གསུམ་པ་ཅན་གྱི་རྟགས་དེ་རྟགས་ཡང་དག་གི་༧༥བ་མཚན་ཉིད་ཡིན་ཞེས་ཟེར།",
    "འོ་ན་ནོག་སོགས་འདུས་པའི་བ་ལང་དེ་བ་ལང་གི་མཚན་ཉིད་དུ་ཐལ་ལོ།",
    "ཚུལ་གསུམ་ཚང་བ་རྟགས་ཡང་གི་མཚན་ཉིད་ཡིན་གྱི།",
    "ཚུལ་གསུམ་ནི་རྟགས་ཡང་དག་གི་མཚན་ཉིད་མ་ཡིན་ཏེ།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ཚུལ་གསུམ་ཡིན་པར་ཐལ།",
    "ལྡོག་པ་ཐ་དད་པ་གསུམ་ཡིན་པར་ཐལ་ལོ།",
    "ལྡོག་པ་ཐ་དད་པ་གསུམ་ཡིན་པར་ཐལ།",
    "ལྡོག་པ་ཐ་དད་པ་ལྔ་ཡིན་པར་ཐལ།",
    "མུ་སྟེགས་ཀྱི་སྟོན་པ་གནོད་ཀྱི་རྗེ་ན་རེ།",
    "རྟགས་ཡང་དག་གི་མཚན་ཉིད།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཡིན་པར་ཐལ།",
    "དུ་ལྡན་གྱི་ལ་ལ་མེ་ཡོད་པར་སྒྲུབ་པའི་རྟགས་ཡང་དག་མ་ཡིན་པར་ཐལ།",
    "དེ་སྒྲུབ་ཀྱི་༧༥བ་རྟགས་ཡང་དག་གི་མཚན་ཉིད།",
    "རྗེས་སུ་འགྲོ་ལྡོག་གི་ཁྱབ་པར་དཔྱད་པའོ།",
    "ཡ་གྱལ་གྱི་མིང་གི་ཚོགས་པ་བཏགས་པ་གཉིས་ལས།",
    "འདིར་ནི་ཚོགས་པའི་མིང་གིས་ཡ་གྱལ་ལ་བཏགས་པ་མིན་པས།",
    "དཔེར་ན་རས་ཡུག་གི་ཕྱོགས་གཅིག་ཚིག་པ་ལ་རས་ཡུག་ཚིག་ཅེས་བརྗོད་པ་བཞིན་ནོ།",
    "རྩོད་གཞི་ལ་ཕྱོགས་ཀྱི་མིང་གིས་བཏགས་པ་ལ་དགོས་པ་ཡོད་དེ།",
    "དེས་ན་ཚུལ་དང་པོ་འཆད་པའི་སྐབས་སུ་རྩོད་གཞི་ལ་ཕྱོགས་ཀྱི་མིང་གིས་གདགས་པ་རིགས་སོ།",
    "ཕྱོགས་ནི་རྩོད་གཞི་དང་ཆ་ནི་དེའི་ཕྱོགས་གཅིག་ཡིན་པས་རྩོད་གཞིའི་ཕྱོགས་གཅིག་གིས་རྟགས་ལ་ཁྱབ་པ་མ་ཡིན་པའི་ཕྱིར་ཞེ་ན།",
    "རྗེས་སུ་འགྲོ་ལྡོག་གི་ཁྱབ་པ་ལ་དཔྱད་པ།",
    "གཉིས་པ་རྗེས་སུ་འགྲོ་ལྡོག་གི་ཁྱབ་པ་དཔྱད་པ་ལ་གཉིས།",
    "དང་པོ་ལ་དགག་བཞག་སྤང་གསུམ་མོ།",
    "བུམ་པ་ཤེས་བྱར་སྒྲུབ་པའི་ལྡོག་ཁྱབ་མ་གྲུབ་པར་ཐལ།",
    "ཁྱོད་དེ་སྒྲུབ་ཀྱི་རྟགས་ཡང་དག་མ་ཡིན་པར་ཐལ་ལོ།",
    "བྱས་པའི་སྟེང་དུ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ལྡོག་ཁྱབ་མ་གྲུབ་པར་ཐལ།",
    "བྱས་པ་དེ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་རྟགས་ཡང་དག་མ་ཡིན་པར་ཐལ།",
    "དེ་གཉིས་ལས་གཞན་པའི་དེ་སྒྲུབ་ཀྱི་རྗེས་སུ་འགྲོ་ལྡོག་གི་ཁྱབ་པ་མེད་དོ།",
    "ཁྱོད་ཀྱིས་ནམ་མཁའི་སྟེང་དུ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་རྗེས་ཁྱབ་དངོས་ཤུགས་གང་རུང་ལ་ངེས་པར་ཐལ།",
    "ཁྱོད་ཀྱིས་ནམ་མཁའི་སྟེང་དུ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ལྡོག་ཁྱབ་དངོས་སུ་ངེས་པའི་ཕྱིར།",
    "མཉན་བྱའི་དངོས་པོ་ཡིན་ན་མི་རྟག་པས་ཁྱབ་པ་ངེས་པའི་བློ་ཡིན་པར་ཐལ།",
    "དངོས་པོའི་རྟགས་ཀྱིས་མཉན་བྱའི་དངོས་པོ་མི་རྟག་པར་སྒྲུབ་པའི་ཁྱབ་པ་ངེས་པའི་ཚེ་ན་བསྒྲུབ་བྱ་ངེས་པར་ཐལ་ལོ།",
    "བུམ་པ་མཚོན་བྱར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པར་ངེས་པ་ཡིན་པར་ཐལ།",
    "མཚོན་བྱ་མ་ཡིན་པ་དེ་ཁྱོད་ཡིན་པའི་ཕྱིར་ཞེ་ན།",
    "བུམ་པ་མཚོན་བྱར་སྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ལ་ཡོད་མི་དགོས་པར་ཐལ།",
    "བུམ་པ་མཚོན་བྱར་བསྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ལ་ཡོད་མི་དགོས་པར་ཐལ།",
    "བུམ་པ་མཚོན་བྱར་སྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ལ་མེད་དེ་ཁྱོད་ཡིན་པ་ཡང་ཡོད།",
    "བུམ་པ་མཚོན་བྱར་སྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ཡིན་པ་ཡང་ཡོད་པ་གང་ཞིག་ཁྱོད་ཀྱང་ཡིན་བུམ་པ་མཚོན་བྱར་སྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ཀྱང་ཡིན་པའི་གཞི་མཐུན་མེད་པའི་ཕྱིར་ཏེ།",
    "ཁྱོད་ཡིན་ན་མཚོན་བྱ་ཡིན་དགོས།",
    "སྒྲ་ཡང་བྱས་སོ་ཞེས་པའི་སྒྲུབ་ངག་གིས་བྱས་པའི་རྟགས་༧༨ བ་ཀྱིས་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་རྗེས་ཁྱབ་དངོས་སུ་བསྟན་ནས།",
    "ལྡོག་ཁྱབ་ཤུགས་ལ་བསྟན་པ་མ་ཡིན་པར་ཐལ།",
    "འདུས་མ་བྱས་ཀྱི་ནམ་མཁའ་བཞིན་སྒྲ་ནི་བྱས་སོ་ཞེས་པའི་སྒྲུབ་ངག་དེས་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ལྡོག་ཁྱབ་དངོས་སུ་བསྟན་ནས་རྗེས་ཁྱབ་ཤུགས་ལ་བསྟན་པ་མ་ཡིན་པར་ཐལ།",
    "གཞལ་བྱའི་རྟགས་ཀྱིས་སྒྲ་རྟག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་མ་གྲུབ་པར་༧༩ ན་ཐལ།",
    "གཞལ་བྱ་དེ་སྒྲ་རྟག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ལ་ཁྱབ་བྱེད་དུ་འཇུག་པ་མ་ཡིན་པར་ཐལ་ལོ།",
    "བྱས་པ་དེ་ཁྱོད་ཀྱི་ངོར་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཡིན་པའི་ཕྱིར་རོ།",
    "ཁྱོད་ཀྱིས་སྒྲ་མི་རྟག་པར་ངེས་པར་ཐལ་ལོ།",
    "ཁྱོད་ཀྱི་ངོར་སྒྲ་མི་རྟག་པར་སྒྲུབ་མི་དགོས་པར་ཐལ་ལོ།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ལ་མཐོང་བར་ཐལ།",
