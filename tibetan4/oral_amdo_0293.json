    "དེའི་ཚེའི་དེའི་དུས་ན་རྒྱལ་བོའི་བུ་མོ་ཡེ་ཤེས་ཀྱི་འོད་ཀུན་ཏུ་འཕྲོ་བ།",
    "པདྨོ་བཟང་མོ་མིག་ཡིད་དུ་འོང་པའི་དཔལ་གྱི་ཟླ་བ་ཞེས་བྱ་བ་བྱུང་བ་དེ་གཞན་ཞིག་ཡིན་སྙམ་དུ་སེམས་ན་ནི་དེ་ལྟར་མི་བལྟ་སྟེ།",
    "ཁོ་མོ་ནི་དེའི་ཚེ་དུས་ན་རྒྱལ་པོའི་བུ་མོ་ཡེ་ཤེས་ཀྱི་འོད་ཀུན་ཏུ་འཕྲོ་བ།",
    "པདྨོ་བཟང་མོ་མིག་ཡིད་དུ་འོང་བའི་དཔལ་གྱི་ཟླ་བ་ཞེས་བྱ་བར་གྱུར་ཏོ།",
    "ཁོ་མོ་བུ་མོ་གཞོན་ནུར་གྱུར་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་དག་གི་གདམས་ངག་དང་རྗེས་སུ་བསྟན་པ་ལའང་ཞུགས་པར་གྱུར་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་དག་ལ་ཁོ་མོས་རིམ་གྲོ་ཆེར་བྱས་ཏེ།",
    "དེ་དག་ཐམས་ཅད་ཀྱང་ཁོ་མོས་བསྙེན་བཀུར་ཏེ།",
    "དེ་ཡང་ཁོ་མོས་ཐོས་ནས་ཡོངས་སུ་བཟུང་ངོ།",
    "དེ་ཡང་ཁོ་མོས་ཐོས་ནས་ཡོངས་སུ་བཟུང་ངོ།",
    "དེ་ཡང་ཁོ་མོས་ཐོས་ནས་ཡོངས་སུ་བཟུང་ངོ།",
    "དེ་ཡང་ཁོ་མོས་ཐོས་ནས་ཡོངས་སུ་བཟུང་ངོ།",
    "དེ་ལ་ཁོ་མོ་རྒྱ་མཚོའི་ལྷ་མོར་གྱུར་པས།",
    "དེའང་ཁོ་མོས་ཐོས་ནས་ཡོངས་སུ་བླངས་སོ།",
    "དེ་ཡང་ཁོ་མོས་ཐོས་ནས་ཡོངས་སུ་བཟུང་ངོ།",
    "དེ་ཡང་ཁོ་མོས་ཐོས་ནས་བཟུང་སྟེ་ཆུད་ཟོས་པར་མ་བྱས་སོ།",
    "གར་མཁན་གྱི་ཚོགས་ཀྱིས་རོལ་མོ་བྱས་པའི་ཚེ།",
    "ཁོ་མོའི་ལུས་ཐམས་ཅད་ཀྱང་སྣང་བར་མཛད་དོ།",
    "རིགས་ཀྱི་བུ་ཁོ་མོ་ལ་ནི་དེ་ལྟར་ཡངས་མ་ཀྱི་སྐད་ཅིག་རེ་རེ་ལ་དེ་བཞིན་གཤེགས་པ་མཐའ་དང་དབུས་མེད་པ་ཡོངས་སུ་སྣང་སྟེ།",
    "སྔོན་ཆད་མ་ཐོབ་པ་སྔན་ཆད་མ་མཐོང་བདག་ཀྱང་ཁོ་མོའི་སེམས་ཀྱི་རྒྱུད་ལ་གནས་པར་གྱུར་ཏེ།",
    "ཟབ་མོ་བལྟ་དཀའ་ཁོང་དུ་ཆུད་དཀའ་སྟེ།",
    "ཁོ་མོའི་ཚིག་འདི་ནོར་བཟངས་མཉམ་པར་གྱིས།",
    "ཁོ་མོས་ཐོག་མ་ཇི་ལྟར་སེམས་བསྐྱེད་དང་།",
    "བརྟུལ་ཞུགས་དཀྱིལ་འཁོར་རང་གི་ལུས་ཀྱི་འོད།",
    "ཤིང་གི་རི་བོ་རྒྱལ་བ་དེ་དག་བཅུ།",
    "བདག་གིས་རྒྱལ་བ་རྒྱ་མཚོ་དེ་དག་མཆོད།",
    "བདེ་གཤེགས་དེ་དག་ཐམས་ཅད་བདག་གིས་མཆོད།",
    "བསྐལ་པ་མཐའ་ཡས་བདག་གི་སྔོན་སྤྱད་ཀྱིས།",
    "ཁྱོད་ཀྱིས་ཐོས་ནས་ནན་ཏན་མྱུར་གྱིས་ཤིག།",
    "ཡོན་ཏན་བརྗོད་པར་ནུས་རེ་སྐན།",
    "མཚན་མོའི་ལྷ་མོ་སྒྲ་རྒྱ་མཚོ་རབ་ཏུ་ཞི་བ་དང་།",
    "མཚན་མོའི་ལྷ་མོ་སྒྲ་རྒྱ་མཚོ་རབ་ཏུ་ཞི་བ་དང་ལྡན་པ་ལ་ལན་བརྒྱ་སྟོང་དུ་མར་གཡས་ཕྱོགས་སུ་བསྐོར་བ་བྱས་ནས།",
    "མཚན་མོའི་ལྷ་མོ་སྒྲ་རྒྱ་མཚོ་རབ་ཏུ་ཞི་བ་དང་ལྡན་པའི་མདུན་དུ་འདུག་སྟེ།",
    "ཐལ་མོ་སྦྱར་ནས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "དེ་ནས་མཚན་མོའི་ལྷ་མོ་སྒྲ་རྒྱ་མཚོ་རབ་ཏུ་ཞི་བ་དང་ལྡན་པས།",
    "འཕགས་མ་ཁྱོད་ནི་འཕྲིན་ལས་ཅི་མཛད་ཡུལ་གང་དང་ལྡན་སྦྱོར་བ་གང་དང་ལྡན།",
    "རིགས་ཀྱི་བུ་ཁོ་མོ་ནི་སེམས་དང་བསམ་པ་རྒྱ་མཚོ་ཡོངས་སུ་དག་པའི་མཉམ་པ་ཉིད་ལ་ཞུགས་པ་སྟེ།",
    "སྒྲ་དང་དྲི་དང་རེག་ཡོངས་སུ་རྒྱུ་བ་རྣམ་པར་བཟློག་པ་ལ་ཞུགས་པའོ།",
    "གཞན་ཡང་རིགས་ཀྱི་བུ་ཁོ་མོ་ནི་ཕྱོགས་དང་།",
    "རིགས་ཀྱི་བུ་གཞན་ཡང་ཁོ་མོ་ནི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་གཟུགས་ཀྱི་སྐུ་ཡོངས་སུ་དག་པ་མཚན་གྱིས་རབ་ཏུ་བརྒྱན་པ།",
    "བསམ་གྱིས་མི་ཁྱབ་པ་མཐོང་ནས་དགའ་བ་ཆེན་པོ་དང་མོས་ཤིང་ཉམས་བདེ་བ་རབ་ཏུ་ཐོབ་སྟེ།",
    "ཁ་དོག་རྒྱ་མཚོ་མཐའ་དང་དབུས་མེད་པར་སྣང་བ་ལ་ལྟ་ཞིང་སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ལ་དགའ་བ་ཆེན་པོའི་ཤུགས་རྒྱ་མཚོ་རབ་ཏུ་ཐོབ་བོ།",
    "རིགས་ཀྱི་བུ་གཞན་ཡང་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུའི་བ་སྤུའི་སྒོ་རེ་རེ་ནས་སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ལ་ཁ་དོག་དྲི་ཞིམ་པོ་དང་།",
    "སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ལ་མཚན་རེ་རེ་ནས།",
    "རིགས་ཀྱི་བུ་གཞན་ཡང་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུ་ལ་རྣམ་པར་བལྟས་ན་སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ལ་བ་སྤུའི་སྒོ་ཐམས་ཅད་ནས།",
    "རིགས་ཀྱི་བུ་གཞན་ཡང་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐུ་ལ་རྣམ་པར་བལྟས་ན་སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ལ་བ་སྤུའི་སྒོ་རེ་རེ་ནས་ལྟོ་འཕྱེ་ཆེན་པོའི་ལུས་ཀྱི་སྤྲིན་ལྟོ་འཕྱེ་ཆེན་པོའི་རྣམ་པར་འཕྲུལ་པ་དང་བཅས་པ།",
    "དེ་ནས་ཚོང་དཔོན་གྱི་བུ་ནོར་བཟངས་ཀྱིས་མཚན་མོའི་ལྷ་མོ་སྒྲ་རྒྱ་མཚོ་རབ་ཏུ་ཞི་བ་དང་ལྡན་པ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "འཕགས་མ་ལྷ་མོ་ཇི་ལྟར་ནན་ཏན་དུ་བགྱིས་ན།",
    "ཁང་པ་བརྩེགས་པའི་རྒྱའི་དབྱིབས་སུ་འདུག་པ་རྣམ་པར་དག་ཅིང་ཀུན་ནས་ཉོན་མོངས་པ་ལྷ་རྫས་ཀྱི་གཞལ་མེད་ཁང་དང་གནས་ཀྱི་སྤྲིན་གྱིས་ཀུན་ཏུ་གང་བ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་མཐོང་ནས་ཀྱང་ཁོ་མོས་དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་རྒྱ་མཚོའི་འོད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཐོབ་བོ།",
    "དེའི་འོག་ཏུ་ཁོ་མོ་ལྷའི་བུ་མོ་ཞིག་ཏུ་གྱུར་ཏེ།",
    "ལ་ལ་ནི་བུད་མེད་དུ་གྱུར་པས།",
    "ལ་ལ་ནི་བུ་མོར་གྱུར་པས་བསྙེན་བཀུར་ཏེ།",
    "ཁོ་མོས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ལོག་པར་དད་སེལ་བསྙེན་བཀུར་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་མཐོང་མ་ཐག་ཏུ་ཁོ་མོས་མུན་པའི་རྡུལ་ཐམས་ཅད་དང་བྲལ་བས་རབ་ཏུ་སྣང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཐོབ་བོ།",
    "དེའི་འོག་ཏུ་ཁོ་མོས་དེ་བཞིན་གཤེགས་པ་གསེར་ཐུབ་བསྙེན་བཀུར་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་མཐོང་མ་ཐག་ཏུ་ཁོ་མོས་ཞིང་རྒྱ་མཚོ་ཐམས་ཅད་སྣང་བ་རྗེས་སུ་འཕྲོ་བར་བྱ་བས་རྒྱས་པར་འགེངས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཐོབ་བོ།",
    "དེའི་འོག་ཏུ་ཁོ་མོས་དེ་བཞིན་གཤེགས་པ་བསོད་སྐྱབས་བསྙེན་བཀུར་ཏེ།",
    "ཁོ་མོས་བཅོམ་ལྡན་འདས།",
    "དེ་བཞིན་གཤེགས་པ་དེ་དག་ཐམས་ཅད་ལས་དེ་བཞིན་གཤེགས་པ་རེ་རེའི་ཞབས་ཀྱི་དྲུང་ན་ཡང་བདག་མངོན་དུ་འདུག་པར་ཤེས་པར་གྱུར་ཏོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡུལ་ཤིན་ཏུ་ཡངས་པའི་ཡེ་ཤེས་སྣང་བ་རབ་ཏུ་ཐོབ་པར་བྱ་བའི་ཚུལ་གྱིས་དེ་བཞིན་གཤེགས་པ་དེ་དག་གིས་ཐོག་མ་ཐུགས་བསྐྱེད་པ་ནས།",
    "དེ་ནས་མཚན་མོའི་ལྷ་མོ་སྒྲ་རྒྱ་མཚོ་རབ་ཏུ་ཞི་བ་དང་ལྡན་པས།",
    "ཁོ་མོའི་ཚིག་འདི་ནོར་བཟངས་ཁྱོད་ཉོན་ཅིག།",
    "བདག་གི་སེམས་དང་བསམ་པ་ཡོངས་སྦྱོང་ཞིང་།",
    "མོས་པའི་ཤུགས་ཡངས་ཡོངས་སུ་སྐྱེད་བྱས་ཏེ།",
    "དེ་དག་ཀུན་ལ་མོས་བ་ཡངས་བསྐྱེད་དོ།",
    "དེ་དག་འཁོར་དང་བཅས་པར་ཁོ་མོས་བཀུར།",
    "སྔོན་གྱི་བདེ་གཤེགས་ཁོ་མོས་མཐོང་གྱུར་ནས།",
    "དེ་ཚེ་བདག་གིས་ཕན་བདེས་བསྟི་སྟང་བྱས།",
    "མང་པོ་བདག་གིས་བྱམས་སེམས་བདེ་བཀོད་ནས།",
    "སྔོན་ཚེ་སྤྱོད་པའི་དུས་ན་བདག་གིས་བསྐྱབས།",
    "རྟག་ཏུ་སྲིད་གསུམ་ཉོན་མོངས་གདུངས་གྱུར་ཏེ།",
    "སྐྱེ་བོ་འགྲོ་བའི་རྒྱུད་དུ་བདག་གིས་བསྐྱབས།",
    "སྡུག་བསྔལ་ངན་སོང་གཡང་སས་འཇིགས་པ་དག།",
    "བདག་གིས་འཇིག་རྟེན་སྤྱོད་ཚེ་ཞི་བར་བྱས།",
    "འཇིག་པའི་རྒྱུས་ལ་མཁས་པ་དེ་དག་གི་སྤྱོད་པ་ཤེས་པའམ་ཡོན་ཏན་བརྗོད་པ་ནུས་རེ་སྐན།",
    "ལྷ་མོ་ཁྱོད་ཀྱི་དྲུང་དུ་ཉེ་བར་མཆིས།",
    "ཁྱོད་ནི་གདན་ལ་བཞུགས་པར་བདག་གིས་མཐོང་།",
    "ཁྱོད་ཀྱི་སྤྱོད་ཡུལ་འཚལ་བར་མི་ནུས་སོ།",
    "ཁྱོད་ཀྱི་སྐུ་གཟུགས་བལྟ་ན་མཐའ་ཡས་པས།",
    "ལྷ་མོ་ཁྱོད་ནི་ཕུང་པོའི་གནས་ལས་འཕགས།",
    "ཁྱོད་ཀྱིས་ཡེ་ཤེས་སྤྱན་ནི་རྣམ་སྦྱངས་པས།",
    "ཁྱོད་ཀྱི་ཐུགས་ཀྱང་ཡེ་ཤེས་ཆགས་པ་མེད།",
    "ཁྱོད་ནི་ཀུན་ཏུ་འོད་ཀྱིས་སྣང་མཛད་པས།",
    "རང་གི་སྐུ་ཡང་འགྲོ་བ་སྙེད་དུ་བསྟན།",
    "སྐད་ཅིག་རེ་རེ་རང་གི་སྐུ་སྟོན་ཀྱང་།",
    "ཁྱོད་ཀྱི་ཐུགས་ལ་གཉིས་སུ་མི་རྒྱུ་སྟེ།",
    "དེ་ནས་ཚོང་དཔོན་གྱི་བུ་ནོར་བཟངས་ཀྱིས་མཚན་མོའི་ལྷ་མོ་སྒྲ་རྒྱ་མཚོ་རབ་ཏུ་ཞི་བ་དང་ལྡན་པ་ལ།",
    "མཚན་མོའི་ལྷ་མོ་སྒྲ་རྒྱ་མཚོ་རབ་ཏུ་ཞི་བ་དང་ལྡན་པའི་དྲུང་ནས་སོང་ངོ།",
    "མཚན་མོའི་ལྷ་མོའི་སྒྲ་རྒྱ་མཚོ་རབ་ཏུ་ཞི་བ་དང་ལྡན་པའི་གདམས་ངག་དང་།",
    "ལུས་ཀྱིས་རེག་པར་བྱས་ཏེ།",
    "མཚན་མོའི་ལྷ་མོ་བརྗོད་དུ་མེད་པའི་འཁོར་གྱིས་བསྐོར་ཏེ།",
    "ཐལ་མོ་སྦྱར་ནས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་དེ་ལྟར་འགྲོ་བ་ཐམས་ཅད་ཡོངས་སུ་སྨིན་པར་བྱ་བ་དང་།",
    "རྣམ་པར་འཕྲུལ་པ་ཟབ་མོ་ལ་འཇུག་པ་ཐོབ་པ་སྟེ།",
    "ཁོ་མོ་ནི་ཉོན་མོངས་པ་དང་ལས་ཀྱི་སྒྲིབ་པ་ཐམས་ཅད་ཀྱི་རི་རྣམ་པར་གཏོར་བའི་སེམས་དང་ལྡན་པའོ།",
    "རིགས་ཀྱི་བུ་གཞན་ཡང་ཁོ་མོ་དེ་ལྟར་དེ་བཞིན་གཤེགས་པའི་བདག་ཉིད་ཆེ་བ་ཉིད་ཀྱི་རྗེས་སུ་འབྲང་བའི་ཡིད་ལ་བྱ་བ་དང་ལྡན་པས།",
    "རྣམ་པར་དག་ཅིང་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པ།",
    "གླིང་བཞི་པ་རེ་རེ་ཞིང་ཡང་གྲོང་རྡལ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་བརྗོད་དུ་མེད་པའི་ཡང་བརྗོད་དུ་མེད་པ་དང་ལྡན་པ་བྱུང་ངོ།",
    "ཐབ་མོ་དང་རྩོད་པ་དང་དཀྲུགས་མ་ལ་ཞུགས་པར་གྱུར་པ་དང་།",
    "བུད་མེད་དང་ཡུལ་དང་རྒྱ་མཚོའི་གཏམ་ལ་མོས་པ།",
    "འོད་ཁ་དོག་དུ་མ་དང་ལྡན་པས་འཇིག་རྟེན་གྱི་ཉོན་མོངས་པའི་གདུང་བ་ཞི་བར་བྱས་ཏེ།",
    "རྣམ་པར་འཕྲུལ་པ་ཟབ་མོ་ལ་འཇུག་པ་འདི་ཡང་ཤིན་ཏུ་ཕྲ་ཞིང་འཇམ་པའི་ཚུལ་དུ་རབ་ཏུ་ཐོབ་པར་གྱུར་ཏེ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་དེ་ལྟར་མི་བལྟ་སྟེ།",
    "དེའི་འོག་ཏུ་དེ་བཞིན་གཤེགས་པ་འོད་ཟབ་མོ་ཞི་བ་བརྩེགས་པ་ཞེས་བྱ་བ་བསྙེན་བཀུར་ཏོ།",
    "དེའི་འོག་ཏུ་དེ་བཞིན་གཤེགས་པ་ཤིང་གི་རི་བོ་གཟི་བརྗིད་ཅེས་བྱ་བ་བསྙེན་བཀུར་ཏོ།",
    "དེའི་འོག་ཏུ་དེ་བཞིན་གཤེགས་པ་རིན་ཆེན་དཔལ་གྱི་རྩེ་མོའི་སྤྲིན་རབ་ཏུ་སྣང་བ་ཞེས་བྱ་བ་བསྙེན་བཀུར་ཏོ།",
    "དེའི་འོག་ཏུ་དེ་བཞིན་གཤེགས་པ་མཚན་ཡིད་དུ་འོང་བའི་མེ་ཏོག་གི་ཡན་ལག་ཤིན་ཏུ་རྒྱས་པ་ཞེས་བྱ་བ་བསྙེན་བཀུར་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་དག་ཐམས་ཅད་ལ་ཁོ་མོས་རིམ་གྲོར་བྱས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་དག་ཐམས་ཅད་ཀྱི་བསྟན་པ་ལའང་ཁོ་མོ་རབ་ཏུ་བྱུང་ངོ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་དག་ཐམས་ཅད་ཀྱི་བསྟན་པ་ཡང་ཁོ་མོས་ཡོངས་སུ་བཟུང་ངོ།",
    "རྣམ་པར་འཕྲུལ་པ་ཟབ་མོ་ལ་འཇུག་པ་འདི་ཡང་དེ་བཞིན་གཤེགས་པ་དེ་དག་ཐམས་ཅད་ལས་ཐོབ་པའི་ཚུལ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་རབ་ཏུ་ཐོབ་བོ།",
    "རྣམ་པར་འཕྲུལ་པ་ཟབ་མོ་ལ་འཇུག་པ་འཇིག་རྟེན་གྱི་ཚིག་ཀྱལ་པར་རྣམ་པར་བཟློག་པ།",
    "མཛོད་རྣམ་པར་འབྱེད་པའི་ཁྱུ་མཆོག་གི་མཐུའམ།",
    "སོང་རིགས་ཀྱི་བུ་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཞབས་ཀྱི་དྲུང་འདི་ཉིད་དུ་མཚན་མོའི་ལྷ་མོ་ཤིང་ཐམས་ཅད་ཀྱི་མེ་ཏོག་རྒྱས་པར་བདེ་བར་གནས་པ་ཞེས་བྱ་བ་འདུག་སྟེ།",
    "ཁོ་མོ་དང་རྒྱང་མི་རིང་བ་ཞིག་ན་འདུག་གིས།",
    "རྣམ་པར་འཕྲུལ་པ་ཟབ་མོ་ལ་འཇུག་པ་འདི་ཉིད་བརྣན་ཏེ།",
    "དེ་དག་ཀུན་གྱི་སྤྱན་སྔར་ཕྱིན་ཏེ་ཁོ་མོས་མཆོད།",
    "དེ་བཞིན་གཤེགས་པ་དེ་ནི་ཁོ་མོས་མཐོང་མོད་ལ།",
    "འགྲོ་བ་སྨིན་བྱའི་དོན་དུ་བདག་གིས་སེམས་ཀྱང་བསྐྱེད།",
    "རྒྱལ་བ་གཉིས་པའི་སྤྱན་སྔར་ཁོ་མོ་ཕྱིན་ནས་ཀྱང་།",
    "རྒྱལ་བ་ཐ་མ་མཐོང་ནས་ཞིང་གི་རྒྱ་མཚོ་རྣམས།",
    "རྒྱ་མཚོའི་ཞིང་གི་རྡུལ་ཕྲན་རབ་སྙེད་བཞུགས་པ་མཐོང་།",
    "དེ་དག་ཐམས་ཅད་སྤྱན་སྔར་ཁོ་མོ་ཕྱིན་གྱུར་ཏེ།",
    "རྣམ་པར་འཕྲུལ་པ་ཟབ་མོ་ལ་འཇུག་པ་ཐོབ་པ་ཏིང་ངེ་འཛིན་གྱི་སྒོ་རྒྱ་མཚོ་མཐའ་དང་དབུས་མེད་པ་ལ་ཞུགས་པ།",
    "སྲིད་པའི་རྒྱ་མཚོ་མཐའ་དབུས་མེད་པར་ཁྱོད་ཀྱིས་སྤྱད།",
    "ལྷ་མོ་ཁྱོད་ནི་འཁོར་འདིར་བྱོན་ཅིང་རྣམ་པར་མཛེས།",
    "ཞིང་རྣམས་ཀུན་གྱི་རྒྱལ་བ་རྣམ་པར་འཕྲུལ་བ་གཟིགས།",
    "ཁྱོད་ཀྱི་ཐུགས་ནི་མཁའ་འདྲ་ཐུབ་པར་དཀའ་བ་སྟེ།",
    "ཉོན་མོངས་ཀུན་གྱི་དྲི་མས་མ་གོས་སྔ་ནས་དག།",
    "སྐད་ཅིག་གཅིག་གིས་ཉིན་མཚན་ཡུད་དུ་ཟླ་བ་དང་།",
    "རྣམ་པར་འཕྲུལ་པ་ཟབ་མོ་ལ་འཇུག་པ་དེ།",
    "མཚན་མོའི་ལྷ་མོ་ཤིང་ཐམས་ཅད་ཀྱི་མེ་ཏོག་རྒྱས་པས་བདེ་བར་གནས་པ་གང་ན་བ་དེར་ཕྱིན་ནས།",
    "མཚན་མོའི་ལྷ་མོ་སྟོང་ཕྲག་བཅུས་ཀུན་ནས་བསྐོར་ཅིང་འདུག་པ་མཐོང་ངོ།",
    "དེ་ནས་ཚོང་དཔོན་གྱི་བུ་ནོར་བཟངས་ཀྱིས་མཚན་མོའི་ལྷ་མོ་ཤིང་ཐམས་ཅད་ཀྱི་མེ་ཏོག་རྒྱས་པས་བདེ་བར་གནས་པའི།",
