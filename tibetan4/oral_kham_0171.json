    "ཁོང་དུ་༡༧ཆུད་ཅིང་མི་འདུག་ཏུ་རུང་།",
    "ཁྱིམ་བདག་གདངས་ཅན་གྱི་ཁྱིམ་རྒྱལ་པོ་དང་འདབ་༢ཆགས་སུ་འདུག་པས་དེས་ར་བའི་བར་དུ་སྒོ་གཏོད་༤ནས་སའི་བྱི་དོར་བྱེད་དུ་བཅུག་ག་གོ།",
    "དེ་གདུལ་བ་ལ་ལྟོས་༢པས་དེ་ཉིད་དུ་འདུག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་སྐབས་དེ་བཅོམ་ལྡན་འདས་ལ་རྒྱས་པར་གསོལ་པ་དང་།",
    "ལྟ་ཅི་སྨོས་ན་ཞེས་བྱ་བ་ནི་ལན་མང་དུ་འདུག་པར་ཤེས་པ་༡ལྟ་ཅི་སྨོས་ནའོ།",
    "དེས་གདེངས་ཀ་༡༧བྱས་ཏེ་འདུག་གོ།",
    "ཇི་ཙམ་ན་ཁྲི་འོག་ན་སྦྲུལ་དུག་མྱུར་དུ་ཁྱབ་པར་བྱེད་པ་འདུག་པ་མཐོང་ན་ས་༐",
    "དེ་ན་ས་༢༡དགེ་སློང་ཞིག་འདུག་པ་དེས་སྨྲས་པ།",
    "ཡུད་ཙམ་ཞིག་གཏམ་འདྲེ་༨བས་འདུག་ནས་སྨྲས་པ།",
    "རྣམ་ཐོས་ཀྱི་བུ་ལ་ནོར་གྱིས་འགྲན་པ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "རྡོ་འཇོག་ན་ཁྱིམ་བདག་གཞན་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "ཡུད་༡༧ཙམ་གྱི་སྦྱོར་བས་བག་མར་བཏང་ནས་ཁྱེའུ་དེས་ཀྱང་ཁྱིམ་དེར་འདུག་པར་༢༢བརྩམས་སོ།",
    "དེ་དུས་ཅུང་ཟད་ཅིག་འདུག་ནས་སྨྲས་པ།",
    "དེས་སྡོད་ཅིག་ཅེས་བྱས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "དགེ་སློང་དག་སྔོན་བྱུང་བ་རི་བྲགས་༤ཤིག་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ན་ས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད་། དགའ་བར་བྱེད།",
    "ཡང་དགེ་སློང་གང་དགེ་སློང་མ་ཉེ་དུ་མ་ཡིན་པ་ལམ་པོ་ཆེ་ན་འདུག་པ་བསོད་སྙོམས་ཀྱི་ཕྱིར་གྲོང་དུ་འགྲོ་བ་ལས་བཅའ་བ་དང་།",
    "ཤིང་རྟ་དག་ཀྱང་ཤིང་རྟའི་མདའ་དང་བྲལ་ཏེ་འདུག་ག་གོ།",
    "བཟའ་བས་གང་བ་ཤིང་རྟའི་མདའ་དང་བྲལ་བ་དག་འདུག་པ་དང་།",
    "འཕྱ་དང་ལྷུང་བཟེད་འདུག་པ་ད་ང་། མགོ་གཡོགས་༥དོ་ཀེར་༦གླང་ཆེན་ཞོན།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་གཙང་སྦྲ་འདོད་པ་ཞིག་འདུག་པ་དེས་སྒོ་ཁང་དུ་མལ་བཤམས་ནས།",
    "མལ་དེའི་སྟེང་དུ་འདུག་གོ།",
    "བྲམ་ཟེ་དེ་ཕྱིར་བྱུང་བ་དང་ཉེ་དགའ་རྐང་པ་དང་བཅས་པའི་༤མལ་གྱི་སྟེང་དུ་འཛེགས་ཏེ་འདུག་པ་༥མཐོང་ང་ངོ།",
    "མ་བསྒོ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་མི་འདུག་པར་བསླབ་པར་བྱའོ།",
    "དེ་སྟན་དེ་ཉིད་ལ་གྱ་ཚོམ་༦དུ་འདུག་པ་དང་།",
    "སྟན་ལ་མ་བརྟགས་༢༤པར་ཁྱིམ་གཞན་དུ་སྟན་༢༡ལ་འདུག་པར་མི་བྱ་བར་བསླབ་པར་བྱའོ།",
    "དེ་༡༨ཁྲིའུ་དེ་ཉིད་ལ་ལུས་ཐམས་ཅད་ཀྱི་༡༧ལྗིད་ཀྱིས་ཕབ་སྟེ་འདུག་པ་དང་།",
    "ལུས་ཐམས་ཅད་ཀྱི་༡ལྗིད་ཀྱིས་མི་དབབ་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "རྐང་པ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "བརླ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "ལོང་བུའི་སྟེང་དུ་ལོང་༧བུ་མི་གཞག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "རྐང་པ་མི་དགུག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "དེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དགའ་བོ་ཉེ་དགའ་ཚོད་མ་དག་ཏེ་པོར་སྐྱུར་རོ་། ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་༢སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ།",
    "དྲུང་ན་འདུག་༡༧པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་༡༡མི་གཏོར་བར་༐",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ།"
  ]
}