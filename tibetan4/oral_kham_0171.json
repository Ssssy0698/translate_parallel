    "ཟླ་བ་འགའ་ཤས་རྗེས་སུ་དེ་ཉིད་མཆོད་ཁང་ནང་མི་འདུག་ཅེས་ཟེར།",
    "ཉིན་ཤས་རྗེས་ཁོ་ཚོས་སཝཱཊ་ཕྱོགས་སུ་སྐྱོད་བཞིན་པའི་དམག་མིའི་ཁྱུ་སྟར་ཞིག་ལ་བཙན་རྒོལ་བྱས་ཏེ་དམག་མི་བཅུ་གསུམ་བཀྲོངས་འདུག་མཆོད་ཁང་ལ་བཙན་རྒོལ་བྱས་པར་མ་དགའ་བའི་རྣམ་འགྱུར་སྟོན་མཁན་སཝཱཊ་ཙམ་མ་ཡིན་པར།",
    "སླེབས་ཀྱང་ཡུལ་མི་ཚོས་ཕྱིར་སྤྲོད་གཏང་རྒྱུའི་ཐག་གཅོད་བྱས་འདུག་ཅེས་གསུངས་བྱུང་།",
    "ཡང་ན་སྦྲུལ་ཡག་པ་འདུག་ཟེར་རྒྱུ་ཡིན་ནམ་ཞེས་དྲིས་པ་མ་ལཱ་ལཱ་ང་ཡིན།",
    "ད་ཁྱེད་རང་འཇིགས་ཀྱི་འདུག་གམ།",
    "ཆུ་ཚོད་བཅུ་གཅིག་བར་དུ་ཕུང་པོ་འདིར་སུས་ཀྱང་ལག་པ་འཆང་མི་ཆོག་འཆང་ན་རྗེས་མ་དེ་ཁྱེད་རང་ཡིན་པར་ངེས།",
    "ཅེས་གསུངས་འདུག།",
    "དམག་མི་ཚོས་སཝཱཊ་ནང་ཏཱ་ལི་བྷན་ཡོད་ན་བཟང་བར་བརྩི་ཡི་ཡོད་ཅེས་ཤོད་ཀྱི་འདུག་གང་ལགས་ཤེ་ན།",
    "འོན་ཀྱང་མེ་མདའི་སྐད་ཉེ་འགྲམ་ནས་སྒྲག་དུས་སྒྲ་ཆེ་བས་དེ་ལྟར་བྱེད་ནའང་ཕན་མི་ཐོགས།",
    "འོན་ཀྱང་དེ་ག་དུས་མྱོང་དགོས།",
    "ང་འཇིགས་ཀྱི་འདུག་ཅེས་པ་ཞིག་བྲིས་ནས་སྤེལ་ཏེ།",
    "དེ་དུས་སྟབས་ལེགས་ནས་ཏཱ་ལི་བྷན་རྣམས་རྒྱ་ལམ་ནས་ཕྱིན་ཚར་འདུག་པ་དང་།",
    "ངས་ད་ལྟ་ངའི་སེམས་ལ་ཞེད་སྣང་འདུག་ཅེས་ལབ་ཀྱི་ཡོད།",
    "ཁྱེད་གཉིས་ནམ་ཡང་ཛ་དྲག་ཆེ་བའི་དུས་ལ་འཁྲུག་པ་ཤོར་གྱི་འདུག་ཅེས་བཤད།",
    "ཅེས་བྲིས་གནང་འདུག་པའུ་ལོ་ཀོཧི་ལོ་ལགས་ཀྱིས་ཏཱ་ལི་བྷན་དང་།",
    "འོན་ཀྱང་དམག་དུས་སུ་དེ་ཉིད་མཚམས་ཆད་པས།",
    "མགྲིན་པའང་ཕྲན་བུ་བཏུབ་འདུག་ཟེར།",
    "དམག་དང་རང་ལུས་གས་གཏོར་ལ་ཡིད་ཐང་ཆད་པའི་མི་རྣམས་ཁོང་ཐུག་འཕྲད་ཆེད་ཕེབས་ནས་ཁོང་ལ་གུས་འདུད་ཞུ་བཞིན་ཕྱག་ལ་འོ་སྦྱོར་གྱི་ཡོད།",
    "ཅེས་པཤ་ཏུའི་སྐད་ཐོག་ངུ་འབོད་བྱེད་ཀྱི་འདུགདེར་ཏཱ་ལི་བྷན་ཚོས་མར་སྙལ་ཤིག་མར་སྙལ་ཤིག་ཅེས་པའི་སྐད་ཅོར་བྱེད་བཞིན་པ་ཐོས་ཤིང་།",
    "ད་ཆ་མི་མང་ཚང་མ་ཡིད་ཐང་ཆད་ཟིན་འདུག་ཅེས་གསུངས།",
    "ཅེས་གསུངས་འདུག།",
    "མཚན་དགུང་ཙམ་ལ་ཞི་མི་སླེབས་ནས་རི་བོང་བསད་འདུག་པས།",
    "པ་ཤུ་ཏུན་སུའང་རང་འདོད་ཀྱིས་རང་ཡུལ་བསྐྱུར་ནས་མི་འགྲོ་ཞིང་།",
    "ཉིན་ཞིག་ཕ་མའི་གྲོགས་པོ་ངོ་ཤེས་པ་འགའ་ཤས་ཀྱི་སྤུན་མཆེད་མེ་མདའི་འཁྲུག་རྩོད་འོག་འདས་གྲོངས་སུ་གྱུར་འདུག་ཅིང་།",
    "དེར་ལམ་ཁ་མང་པོ་ཞིག་བཀག་འདུག་པས་བྷི་ཤམ་དུ་ས་རུབ་ནས་འབྱོར།",
    "གཤིས་ཀ་གྱོང་ཞིང་ཞལ་རས་དམར་པོ་ཞིག་འདུག་འོན་ཀྱང་མི་ཚོས་ཟེར་ན།",
    "འོན་ཀྱང་ད་དུང་ཁྱེད་ཚོའི་རྒྱལ་ཁབ་ལ་དཀའ་ངལ་མང་པོ་འཕྲད་ཀྱི་འདུག་ཅེས་གསུངས་བྱུང་།",
    "དེ་ནས་ཕར་ཕྱོགས་སུ་སླེབས་ཏེ་གཤོང་ཕྱོགས་སུ་མར་བབ་པའི་ཚེ་ཞིབ་བཤེར་ས་ཚིགས་གང་སར་མཐོང་རྒྱུ་འདུག་ལ།",
    "ད་ཆ་ས་ཆ་སྟོང་པ་ཞིག་ཏུ་གྱུར་འདུག་པ་མ་ཟད།",
    "མཐར་ལུང་པའི་མི་འབོར་ས་ཡ་གཅིག་དང་འབུམ་བརྒྱད་ལས་ཕྱེད་ཀ་ཡུལ་གཤོང་བསྐྱུར་ནས་བྲོས་བྱོལ་ལ་ཕེབས་འདུག་ཅིང་།",
    "འོན་ཀྱང་ང་རང་ལའང་རང་ཉིད་ཀྱི་ཅ་དངོས་ཡོད་མེད་ལྟ་དགོས་ཡོད།",
    "དེའི་འོག་ན་རའི་མགོ་རུལ་པ་ཞིག་འདུག་ཅིང་།",
    "གཞན་ཡང་ཁ་ཟས་འདྲ་མིན་ཟ་རྒྱུ་འདུག་སྟེ།",
    "ང་རཱི་དྷ་མཉམ་དུ་སྦྱར་འདུག་ཅེས་ལབ་བྱུང་།",
    "རྗེས་སུ་ཉེན་རྟོག་པ་ལ་ཁོའི་རྐང་པ་དང་ལུས་ཀྱི་ཆ་ཤས་འགའ་ཤས་རྙེད་སོན་བྱུང་འདུག།",
    "དེ་བཞིན་གློག་ཁང་རྣམས་ཀྱང་མེད་པར་བཟོས་འདུག།",
    "མ་གྲོངས་བར་དུ་འཁྱག་སྒམ་ནང་དུ་བཞག་འདུག་ཁོང་ནི་ཏཱ་ལི་བྷན་དང་འབྲེལ་བ་མེད་པའི་ཚོང་ཁང་བདག་གཉེར་བ་དཀྱུས་མ་ཞིག་ཡིན།",
    "ཅེས་བྲིས་འདུགཡི་གེ་དེ་འབྱོར་ནས་གཟའ་འཁོར་འགའ་ཤས་རིང་ཁོང་ལ་ཐུགས་ཁྲལ་ཕྲན་བུ་ཡོད་པའི་ཚོར་སྣང་བྱུང་ཡང་།",
    "གཞན་ཚོས་ཀྱང་དེ་ལྟར་འདྲི་བཞིན་འདུག།",
    "དེ་དུས་༩༡༡ ལོའི་བཙན་རྒོལ་གྱི་ཇུས་ངན་གཏིང་མཁན་ཁཱ་ལིཊ་ཤཱིག་མཱོ་ཧཱ་མཊ་དང་ཐུག་འཕྲད་བྱས་འདུག།",
    "ཞེས་བྲིས་འདུག།",
    "ཁྱེད་རང་ལ་བྱ་དགའ་ཆེན་པོ་ཞིག་ཐོབ་པ་དང་མཉམ་དུ་སྒོར་ས་ཡ་ཕྱེད་ཀ་ཐོབ་འདུག་ཅེས་ལན་སྤྲད།",
    "དམག་མི་རྣམས་ཀྱིས་གཡུལ་དམག་རྒྱལ་ཁ་ཐོབ་པའི་རྗེས་སུ་རྒྱས་སྤྲོ་ཆེན་པོས་དགའ་བདེར་རོལ་གྱི་ཡོད་འདུག་དེ་དུས་ངས་གཟེངས་རྟགས་དང་ཆེ་བསྟོད་རྣམས་ཀྱང་དེ་བཞིན་དུ་མཐོང་འགོ་ཚུགས།",
    "པཤ་ཏུན་བ་སྡོད་སའི་ས་གནས་རྣམས་བཙོག་ལ་གཟིང་ཆ་འདོད་པོ་འདུག་མཱོ་ཧཱ་ཇིར་ཕལ་ཆེ་བས་ཨཱལ་ཏབ་ཧུ་སིན་ལགས་ཀྱིས་དབུ་ཁྲིད་པའི་ཆབ་སྲིད་ཚོགས་པ་ཨེམ་ཁིའུ་ཨེམ་ཞེས་པ་དེར་རྒྱབ་སྐྱོར་བྱེད།",
    "ངས་གོས་སློག་རློན་པ་བཟོ་འདོད་མི་འདུག་ཅེས་ཞུ་བ་འཐེན་སྟེ།",
    "ད་ལྟ་མཚན་གུང་ལ་ཁྱེད་རང་འདི་ན་བསྡད་འདུག་གླེན་རྟགས་མ་སྟོན།",
    "ཁྱེད་རང་ཡང་ཁོང་ནང་བཞིན་ཉེན་ཁའི་ནང་ཡོད།",
