    "དེ་ནས་ཀླུ་གཞོན་ནུ་དེ་༡༧རྫིང་དེ་ནས་བྱུང་སྟེ་དྲང་སྲོང་དེའི་མདུན་དུ་འདུག་པ་དང་དྲང་སྲོང་དེས་དེ་ལ་སྨྲས་པ།",
    "ཅེས་སྨྲས་ཏེ་མི་སྣང་བའི་ལམ་ན་འདུག་གོ།",
    "བཟངས་ཀྱི་༡གཞིར་གཏོགས་པ་ན་འདུག་པས་དེ་དག་བསོད་སྙོམས་ལ་རྒྱུ་བ་མཐོང་ནས་དེས་བློན་པོ་རྣམས་ལ་སྨྲས་༡༧པ།",
    "དེ་ལྟ་བས་ན་འཕགས་པ་དག་དུས་ཀྱིས་མགྲོན་དུ་བོད་༡དོ་ཞེས་ཟེར་བའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "བཟངས་ཀྱི་༡༧གཞིར་༢༢གཏོགས་པ་ན་འདུག་པས་དེ་དག་བསོད་སྙོམས་ལ་རྒྱུ་བ་མཐོང་ནས།",
    "ཉེ་དགའ་བར་ཁང་དུ་འདུག་སྟེ་ཉན་ཅིང་དེས་དེར་ཡང་དེ་བཞིན་དུ་བསྡིགས་སོ།",
    "ཉེ་དགའ་ཁྱམས་སུ་འདུག་སྟེ་ཉན་ཅིང་དེས་དེར་ཡང་དེ་བཞིན་དུ་བསྡིགས་སོ།",
    "ཉེ་༤དགའ་གནས་ཁང་དུ་འདུག་སྟེ་ཉན་ཅིང་དེས་དེར་ཡང་དེ་བཞིན་དུ་བསྡིགས་སོ།",
    "ཉེ་དགའ་བང་རིམ་དུ་འདུག་སྟེ་ཉན་ཅིང་དེས་དེར་ཡང་དེ་བཞིན་དུ་བསྡིགས་སོ།",
    "ཉེ་དགའ་སྒོ་ཁང་དུ་འདུག་སྟེ་ཉན་ཅིང་དེས་དེར་ཡང་དེ་བཞིན་དུ་བསྡིགས་སོ།",
    "ཉེ་དགའ་འཆག་སར་འདུག་སྟེ་ཉན་ཅིང་དེས་དེར་ཡང་དེ་བཞིན་དུ་བསྡིགས་སོ།",
    "ཉེ་དགའ་ད་གོན་པར་འདུག་སྟེ་ཉན་ཅིང་དེས་དེར་ཡང་དེ་བཞིན་དུ་བསྡིགས་སོ།",
    "དེ་ལྟ་དེ་ལྟར་རྗེས་སུ་ཐ་སྙད་གདགས་པར་བྱའོ་སྙམ་པ་དེ་ཉིད་རྐྱེན་དུ་བྱས་ཏེ་ཅང་མི་སྨྲ་བར་ཉན་རྣས་འདུག་པར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "ཅང་མི་སྨྲ་བར་ཉན་རྣས་འདུག་ན་ཞེས་བྱ་བ་ནི་ཅང་མི་སྨྲ་བར་རྣ་གཏོད་པས་འདུག་ནའོ་༡༡།",
    "གླེང་བ་པོ་རྒན་པའི་མཐའ་ལོགས་སུ་འདུག་སྟེ་སྨྲས་པ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་འདུག་པ་ལ་སྨྲས་ཏེ་འགྲོ་བར་བྱའོ།",
    "དགེ་སློང་འདུག་པ་ལ་མི་སྨྲ་ན་ཞེས་བྱ་བ་ནི་དེ་ན་༦དགེ་སློང་གང་འདུག་པ་ལའོ།",
    "ཉ་༨བར་སྟན་ལས་ལངས་ཏེ་འགྲོ་ཞིང་དགེ་སློང་འདུག་པ་ལ་མི་སྨྲ་ན་ཇི་སྲིད་ཐོས་པའི་ཉེན་ཀོར་ལས་མ་འདས་ཀྱི་བར་དུ་ཉེས་བྱས་སུ་འགྱུར་ལ།",
    "རྩོད་པ་བཟུང་སྟེ་རྩོད་༢༢ཅིང་འདུག་ལ་གཏམ་གྱི་མཇུག་སྡོད་པར་མི་བྱེད།",
    "མ་འདུག་ཤིག་ཅེས་བསྒོ་བ་ན་འདུག་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ལ་ནོར་གྱིས་༩འགྲན་པ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "རྣམ་ཐོས་ཀྱི་བུ་ལ་ནོར་གྱིས་འགྲན་༢པ་ཞིག་འདུག་པ་དེ་བདག་དང་རིགས་དང་།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་རྟོགས་ལྡན་གྱི་ཆུང་པོ་གྲོགས་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེ་ཟོང་ཐོགས་ཏེ་ཆུ་སྲིན་བྱིས་པ་གསོད་༡༨ཀྱི་རིར་ཕྱིན་ནས་ཁྱིམ་བདག་དེས་ལེགས་འོངས་ལག་ན་སྤྲ་ང་ཕོར་ཐོགས་ཏེ།",
    "ཁྱིམ་བདག་དེས་དེ་ཐོས་༦ནས་མཆི་མས་བརྣངས་༧ཏེ་འདུག་ནས་དེས་སྨྲས་པ།",
    "མཉན་ཡོད་ཀྱི་ཕྱི་རོལ་ཁྲོན་པའི་ཁ་ན་ངལ་སོ་༢ཞིང་འདུག་གོ།",
    "ཇི་ཙམ་ན་ལེགས་འོངས་སད་༡༧པ་དང་བདག་ཉིད་བཅོམ་པར་མཐོང་ནས་དེས་རལ་རུལ་དེ་དག་ཉིད་གྱོན་ཏེ་འདུག་གོ།",
    "ལེགས་འོངས་ཀྱི་༦སྔོན་ཟད་པར་སྔོན་པོའི་སྐྱེ་མཆེད་བསྐྱེད་པས་དེ་རྒན་པའི་མཐའ་ལོགས་ན་འདུག་པས་དགེ་སློང་རྣམས་ཀྱི་ལག་ན་ཨུཏྤལ་སྔོན་པོ་དག་ཐོགས་པ་དེ་དག་མཐོང་ངོ།",
    "སྣམ་སྦྱར་སྤྲུགས་ནས་རྐང་པ་གཉིས་བཀྲུས་ཤིང་ལག་པ་གཉིས་བསྙལ་ཏེ་ཆུ་༢བཙགས་ནས་ལོ་༢མ་ལྷགས་པ་དག་བླངས་ཏེ་འདུག་ནས་ཟས་ཀྱི་བྱ་བ་བྱ་བར་བརྩམས་སོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་ལེགས་འོངས་ཀྱིས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་ཚེ་དང་ལྡན་པ་ལེགས་འོངས་ལ་བྲམ་ཟེ་དེས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས།",
    "དེ་ནས་བྲམ་ཟེ་དེས་ཚེ་དང་ལྡན་པ་ལེགས་འོངས་བདེ་བར་འདུག་པར་རིག་༡ནས།",
    "རྒྱལ་བྱེད་ཀྱི་ཚལ་གྱི་སྒོ་ན་འཆག་ཅིང་འདུག་གོ།",
    "བཟངས་ཀྱི་གཞིར་གཏོགས་༥པ་ན་གཉིད་ལོག་ཅིང་འདུག་པ་སེ་གོལ་གྱི་སྒྲས་སད་པར་མཛད་ནས་བཀའ་སྩལ་པ།",
    "བཟངས་ཀྱི་༨གཞིར་གཏོགས་པ་ན་གཉིད་ལོག་ཅིང་འདུག་པ་ལན་གཉིས་ལན་གསུམ་དུ་སེ་གོལ་གྱི་སྒྲས་སད་པར་མཛད་ནས་བཀའ་སྩལ་པ།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀ་གསུམ་འདུག་པ་ན།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞི་བ་ལ་དད་པ་ཞི་བ་ལ་བསྙེན་བཀུར་བྱེད་པ་ཞིག་འདུག་ནས།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀ་དེ་ཉིད་དུ་༡༢འདུག་སྟེ།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀ་དེར་འདུག་སྟེ་༧ཟས་ཀྱི་བྱ་བ་བྱས་པ་དང་།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་སེར་སྣ་ཅན་ཞིག་འདུག་པ་དེའི་ཆུང་མ་ནོར་བུ་ལ་དགའ་ནས།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀས་དེར་འདུག་སྟེ་ཟས་ཀྱི་བྱ་བ་བྱས་པ་དང་།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀ་དེར་འདུག་སྟེ་ཟས་ཀྱི་བྱ་བ་བྱས་པ་དང་།",
    "ཡོ་བྱད་ཀུན་དུ་འཛིན་པ་ཞིག་འདུག་པ་དེ་སྒོ་དྲུང་ན་བྲམ་ཟེའི་ཁྱེའུ་ལྔ་བརྒྱ་ཙམ་བྲམ་ཟེའི་གསང་ཚིག་དག་ཀློག་ཏུ་འཇུད་༩ནས།",
    "རྒན་པའི་མཐའ་ལོགས་སུ་འདུག་སྟེ།",
    "དེ་འདུག་པ་དང་།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེའི་ཆུང་མ་གཟུགས་བཟང་བ།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀ་༤དེར་འདུག་སྟེ་ཟས་ཀྱི་བྱ་བ་བྱས་པ་དང་།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེའི་ཆུང་མ་གཟུགས་བཟང་བ།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀས་དེར་འདུག་སྟེ་ཟས་ཀྱི་བྱ་བ་བྱས་པ་དང་།",
