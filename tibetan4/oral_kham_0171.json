    "མིང་རྟགས་བཀོད་པ་དེར་གཞུང་འབྲེལ་མ་ཡིན་པའི་རྣམ་པ་ཤུགས་ཆེར་མངོན་ཐབས་བྱས་འདུག་པ་ནི།",
    "ཞེས་ཞུས་ལུགས་བཀོད་འདུག་པའི་ནང་ཚན་རྒྱལ་ཁབ་ཀྱི་གསང་བ་དང་འབྲེལ་བ་ཡིན་གནས་ལ་གཞིགས་ན།",
    "ངོས་རང་རང་ཉིད་ཀྱི་རྣ་བས་གང་ཐོས་པ་ལ་ཡིད་མ་ཆེས་པར་ཕྱིར་བྲེལ་འཚབ་ངང་ཐོན་ཏེ་མི་ཚང་མ་བོས་འདོད་བྱུང་རུང་།",
    "ཚེས་༢༨ ཉིན་བོད་ཀྱི་སྐུ་ཚབ་ཚོར་ཏར་འཕྲིན་བཏང་བར་བྱས་ཚེ་དུས་ཚོད་ཏག་ཏག་མཐུན་ངེས་སུ་འདུག་ཅིང་།",
    "སྐད་བསྒྱུར་དེ་བརྒྱུད་ནས་ཀྱང་དེ་དག་ཡང་བསྐྱར་ཟེར་འདུག།",
    "ཞེས་གསུངས་འདུག་ཅིང་།",
    "ང་རང་ནི་སྨ་ར་དཀར་པོ་ཆགས་ཤིང་འཆི་ལ་ཁད་ཀྱི་མི་ཞིག་ཡིན།",
    "ང་རང་ལ་མའོ་ཀྲུའུ་ཞིའི་སྐུ་དཔར་ཞིག་དང་།",
    "བཅུ་གཉིས་པ་བཅས་ཡག་པོ་བྱུང་འདུག་ཀྱང་།",
    "དྲི་བ་གསུམ་གྱི་ལན་འདེབས་རྣམས་ཡིག་ཐོག་ནས་བྱས་ཡོད་མེད་གསལ་ཁ་གང་ཡང་མི་འདུག་ལ།",
    "ཀྲང་ཅིང་ཨུ་ཡིས་ད་དུང་སྒུག་ནས་བསྡད་རྒྱུ་དེ་འགྲིགས་མི་འདུག་སྙམ་ནས།",
    "དེ་བཞིན་ཡང་བསྐྱར་ང་ཕོད་ལ་ཟིན་བྲིས་བཀོད་མི་འཇུག་ཐོག་དུས་འགྱངས་ཁོ་ན་བྱེད་བཞིན་གནས།",
    "སྟག་ལྷ་ཕུན་ཚོགས་བཀྲ་ཤིས་ཀྱི་དེབ་གཉིས་ཀར་གསལ་འདུག་ཀྱང་།",
    "ང་ཕོད་ཀྱི་བསམ་འཆར་དེར་མཇུག་གནོན་བྱས་པ་ཞིག་ཡིན་ལུགས་སྟག་ལྷ་ཕུན་ཚོགས་བཀྲ་ཤིས་ཀྱིས་གསུངས་འདུག།",
    "༡༩༥༢ ལོའི་ཟླ་བ་༣ ཚེས་༣༡ ཉིན་རྒྱ་ནག་ལ་དངོས་སུ་ངོ་རྒོལ་གྱི་རྣམ་འགྱུར་བསྟན་འདུག་ཚོགས་པ་དེའི་ཚོགས་འཐུས་ནི།",
    "འདི་ལོ་བལ་ཚོང་བཀག་འགོག་གནང་འདུག་པས་ཚོང་དོན་སྔར་ལམ་རང་འཇགས་དགོས་པ།",
    "བཅས་ཡིན་ལུགས་འདུག་ཀྱང་།",
    "འཚོ་བ་ཅུང་ཡར་རྒྱས་འགྲོ་ཐབས་བྱེད་དགོས་ལུགས་ཀྱི་རྩ་བའི་ཐབས་ལམ་གཉིས་བསྟན་འདུག་ཅིང་།",
    "གོང་གསལ་ཁོངས་ནས་ཨང་དང་པོ་དང་གཉིས་པ་གཉིས་བྱུང་ན་ལེགས་ཤོས་ཡིན་པའི་རྩིས་རྒྱབ་འདུག་པ་སྟེ།",
    "ཟིང་ཆ་སློང་བའི་ཉེས་སྤྱོད་སྤེལ་གྱི་འདུག་ཅེས་དང་།",
    "རྒྱ་ནག་གུང་ཁྲན་ཏང་རང་ཉིད་ཀྱིས་ཀྱང་ཐོག་མར་གྲངས་ཉུང་མི་རིགས་ཁག་ལ་རང་ཐག་རང་གཅོད་དང་།",
    "ཕབ་བསྒྱུར་གྱི་ལས་གཞི་གང་ལེགས་འདུག་པར་བསྔགས་བརྗོད་ཡོད།",
    "ད་ལངས་རན་འདུག་ཇ་ནེ་མུན།",
    "ང་ཁྱེད་རང་སྒེར་ལ་འཁོན་འཛིན་གང་ཡང་མེད།",
    "དེ་ལས་ལྷག་པ་ཞིག་ངའི་དྲན་ཤེས་ཀྱི་ཡུལ་ན་མི་འདུགདེ་སྔ་ངའི་རྨི་ལམ་ནང་དུ་ང་ལ་མེ་མདའ་བརྒྱབ་པ་རྨིས་ཤིང་།",
    "མདེའུ་གཅིག་ཤཱ་ཛིཨ་ཡི་ལག་པ་གཡོན་མ་ལ་བརྒྱབ་འདུག་པ་དང་།",
    "ཁོས་སྐྱེས་དམན་ལ་འདྲི་ཡི་འདུག་ཅེས་འཕྱ་སྨོད་བྱེད།",
    "མཐར་ལུང་པའི་ནང་འཐབ་རྒོལ་གྱི་ཟིང་འཁྲུག་རྣམས་ཐག་གཅོད་བྱེད་ཐུབ་མཁན་གྱི་བློ་གཟུ་བོར་གནས་པའི་སྐྱེས་བུ་ཞིག་འགོ་ཁྲིད་དུ་གདམ་རྒྱུའི་ཐག་གཅོད་བྱུང་འདུག།",
    "བཅོས་ཐབས་དེས་རྐྱེན་པས་ལྕེ་སྒྲོག་ཇེ་སྡུག་ཏུ་ཕྱིན་འདུག་ཟེར།",
    "དེར་ངའི་སྤོ་བོ་ལགས་ཀྱང་ཕེབས་མྱོང་འདུག།",
    "ལར་ནས་ཨཕ་གྷན་རྣམས་དམག་རྩལ་ཕུལ་དུ་བྱུང་བ་ཤ་སྟག་ཡིན་དུས་དམག་སྦྱོང་ལས་འགུལ་སྟངས་འཛིན་གནང་མཁན་རུ་དཔོན་ཨི་མཱམ་ལགས་ཀྱིས་ཨཕ་གྷན་ཚོར་དམག་སྦྱོང་སྤྲད་རྒྱུ་དེ་ལས་སླ་པོ་ཞིག་མིན་ཚུལ་གསུངས་འདུག།",
    "ཁོང་ལ་ཁྱེད་ཀྱིས་ང་ལས་ལོ་བཅུ་གཞོན་པ་ཡིན་པའི་ལག་འཁྱེར་གནང་འདུག་ཅེས་ཞུ་དུས་བཀའ་བློན་གྱིས།",
    "ཐུགས་ཁྲོས་ནས་ཁོང་ལ་རྡུང་རྡེག་བཏང་འདུག།",
    "ད་དུང་ཁང་པར་ཚོན་གཏོང་བའི་ཆེད་དུ་གཞན་ལས་སྒོར་ཁྲི་སུམ་ཅུ་གཡར་འདུག་ཁོང་གཉིས་བཞུགས་ས་ཤིང་ཁང་ཞིག་སྲང་ལམ་བར་དུ་གཡར་ཏེ།",
    "མགྲོན་པོ་རྣམས་ག་དུས་ཕེབས་ཀྱང་ཆོག་ལ།",
    "ད་ནི་ངས་ལས་ཀ་འདི་བྱེད་ཐུབ་པ་མི་འདུག་ཅེས་གསུངས།",
    "ངས་ནག་ཉེས་ཀྱི་བྱ་བ་གང་ཞིག་བྱས་འདུག་གམ།",
    "ཅེས་ཀྱལ་ཀ་དང་སྦྲགས་ནས་ཞུས་འདུག།",
    "ཁོ་ཚོས་འགྱིག་ཤོག་ཐུམ་བརྒྱབ་སྟེ་དེ་ལ་འགྱིག་ཐག་བསྡམས་ནས་སྤོ་ལོ་བཟོ་ཡི་འདུག་དེ་ནི་ཡུལ་མཐའ་འཁོབ་ཡིན་པས།",
    "རྨོ་བོས་པ་ཤུ་ཏུན་བ་སུའང་རང་འདོད་ཀྱིས་རང་ཡུལ་བསྐྱུར་ནས་མི་འགྲོ་ཞིང་།",
    "ལྷམ་དཀར་པོ་གྱོན་པ་སོགས་ཀྱང་བཀག་འགོག་བྱས་འདུག་ཅེས་གསུངས།",
    "མལ་ཀཱ་ཨི་ནཱུར་ཨང་རིམ་དང་པོར་སོན་འདུག་དེར་ང་ཧོན་ཐོར་ཏེ།",
    "རྐུན་མ་ཐོག་མར་རྒྱག་དུས་སེམས་ནང་འཇིགས་སྣང་ཕྲན་བུ་སྐྱེ་ཡི་འདུག་ཀྱང་།",
    "བྷ་བྷིང་ལྟོགས་ཀྱི་འདུག་ཅེས་ཞུས།",
    "ཚོས་མཁྱེན་འདུག་ཅེས་ཟེར།",
    "ཤོག་བུ་ལ་སོགས་འཚོལ་བཞིན་འདུག་ལ།",
    "འོན་ཀྱང་ཁྱེད་རང་ཐུགས་གཟབ་གནང་རོགས།",
    "པ་ཀིས་ཐན་ནང་ལ་ཁྱེད་རང་ཧིནྡུའི་ལྷ་ཁང་དང་ཁ་ཆེའི་ལྷ་ཁང་ལ་སོགས་མཆོད་གནས་གང་དུ་འགྲོ་འདོད་ཡོད་ཀྱང་དེ་ལ་བཀག་འགོག་མེད་ལ།",
    "ངས་ཁོང་མཆོད་དཔོན་ལམ་དུ་ཐུག་དུས་འཚམས་འདྲི་ཞུ་ཡི་ཡོད།",
    "འོན་ཀྱང་ཁྱེད་ཀྱི་ནང་དུ་ཁཱོ་རན་འདུག་ཅེས་སྐད་ཅོར་དང་སྦྲགས་ནས་གསུངས་པ་ན།",
    "ངས་ཕྱག་རོགས་ཞུ་ཐུབ་པ་མི་འདུག་ཅེས་གསུང་ལན་ཕུལ།",
    "ཁྱེད་རང་ལ་འདིར་ལས་ཀ་ཅིའང་མེད།",
    "ཁྱེད་ཚོས་ཞབས་འདྲེན་ཞུ་ཡི་འདུག་ཁྱེད་ཚོས་ངེས་པར་དུ་གདོང་རས་གྱོན་དགོས།",
    "ཞེས་བསྔགས་བརྗོད་གནང་འདུག།",
