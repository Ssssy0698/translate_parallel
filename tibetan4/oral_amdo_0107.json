    "རང་གི་སེམས་ནི་ཡོངས་སུ་འདུལ།",
    "ཞེས་གསུངས་པ་ལྟར་དོན་འདི་ཉིད་འཇིག་རྟེན་ཡོངས་ཀྱི་ཡུལ་གྲུ་སོ་སོ་དང་མི་རེ་རེ་ལའང་གོ་དགོས་པ་གལ་ཆེན་པོ་རེད།",
    "ནང་ཡུལ་གར་ཡོད་ནས་རེ་གཉིས་འདེམ་སྒྲུབ་ཐོག་དེ་རྣམས་ལ་སློབ་སྦྱོང་གི་མཐུན་རྐྱེན་ལེགས་པར་གྲ་སྒྲིག་གནང་རྒྱུ་དང་།",
    "རང་རེ་རྣམས་ནས་བློ་རྩེ་གཅིག་སྒྲིམ་གྱིས་ཐབས་ཤེས་ལེགས་པར་མཛད་དགོས་ཤིང་།",
    "ཁོང་དགུང་ལོ་བརྒྱ་བཅུ་བརྒྱད་ཅུ་ལས་ལྷག་ནའང་ད་དུང་འཇིག་རྟེན་ཨེ་ཤ་ཡའི་ནང་ཚོགས་ཀྱི་ཕྱག་ལས་ཐུགས་འཁུར་ཆེ་བཞེས་ཀྱིས་དཀའ་ངལ་ལ་མ་འཛེམས་པར་ཚོགས་གཙོ་མགོན་པོ་སྐྱབས་ཀྱི་ཕྱག་རོགས་གནང་བར་རྗེས་སུ་ཡི་རང་ཞུ་གི་ཡོད།",
    "དེང་དུས་འཛམ་གླིང་གི་ནང་གོ་མཚོན་དང་རྡུལ་ཕྲན་གྱི་མཚོན་ཆ་གསོག་འཇོག་བྱེད་བཞིན་པའི་སྟབས་ཀྱིས་འཛམ་གླིང་གི་རྒྱལ་རབས་ཉམ་ཐག་པའི་སྐབས་ཤིག་ཡིན་པ་དང་།",
    "གོ་མཚོན་དེ་ཚོའི་རྐྱེན་གྱིས་ང་ཚོ་དུས་དང་རྣམ་པ་ཀུན་ཏུ་འཇིགས་སྣང་དང་དངངས་སྐྲག་གི་ངང་དུ་སྡོད་དགོས་པ་དང་།",
    "སྐབས་འགར་གཞན་བརྒྱུད་དེ་འགྲོ་བ་མིའི་བསམ་བརྗོད་ལས་འདས་པའི་མནར་གཅོད་གཏོང་བ་དེ་ནི་མིས་མི་ལ་ངོ་ཚ་འོས་པའི་བྱ་སྤྱོད་ཅིག་ཡིན་པ་རེད།",
    "སྐྱེ་འགྲོ་ཡོངས་ཀྱི་བདེ་དོན་དུ་དམག་འཁྲུག་གི་འཇིགས་པ་དེ་དག་ངེས་པར་འགོག་དགོས།",
    "ང་རང་ཚོས་སོ་སོའི་གཞུང་ལ་བསླབ་པ་ལྔ་ལ་ཆ་འཛིན་ཞུ་རྒྱུའི་ལས་འགུལ་ཞིག་བརྩམ་རྒྱུ།",
    "ང་ཚོ་ཚོགས་པའི་ལས་སྒོའི་ཐོག་བཀའ་སློབ་ཟབ་མོ་དང་མཐུན་འགྱུར་རོགས་རམ་ཅི་འོས་གནང་བའི་རེ་བ་ཡང་ཞུ་གི་ཡོད།",
    "འཛམ་གླིང་དུ་ཞི་བདེ་ཡོང་བའི་དམིགས་ཡུལ་བཟང་པོ་འདི་ནི་རྒྱ་གར་གཞུང་གི་དགོངས་པ་དང་མཐུན་པ་ཞིག་རེད།",
    "དེ་བཞིན་དྲག་མཚོན་བཀག་སྡོམ་སོགས་ཀྱི་ལས་འགུལ་མང་པོ་ཞིག་གི་ཐོག་ནུས་ཤུགས་ཅི་ཡོད་ཀྱིས་དཀའ་ལས་བརྒྱབས་ཡོད།",
    "ང་ཚོའི་དམིགས་ཡུལ་ལ་རྒྱབ་སྐྱོར་དང་ཚོགས་ཞུགས་གནང་མཁན་ཚང་མར་དགའ་པོའི་ངང་ནས་དགའ་བསུ་ཞུ་རྒྱུ་ཡིན།",
    "ཨེ་ཤ་ཡའི་ནང་རྒྱལ་ཁབ་མང་པོ་ཞིག་ལོ་རྒྱུན་རིང་པོར་དཀའ་ངལ་ནང་གནས་ཡོད་པ་རེད།",
    "འདི་དག་གི་རང་བཙན།",
    "ལོག་གཡེམ་སྤོང་བ་སོགས་གཞིར་བྱས་པ་ཞིག་རེད།",
    "དྲག་མཚོན་འགྲན་བསྡུར་འདི་དག་ནི་འཛམ་གླིང་ཞི་བདེར་གནོད་པའི་ལས་འགུལ་ཆེ་ཤོས་ཤིག་རེད།",
    "དེ་ལྟར་ནའང་འཛམ་གླིང་ནང་ཞི་བདེ་ལྷིང་འཇགས་ཡོང་ཐབས་སུ་དམིགས་བསལ་གྱི་ནུས་པ་ཐོན་པའི་ལས་འགུལ་ཞིག་མེད་པ་གསལ་པོར་མཐོང་གི་འདུག།",
    "སྟོན་པ་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་ཇི་བཞིན་དུ་ལག་ལེན་དུ་བསྟར་ན་འཛམ་གླིང་ཞི་བདེ་ལྷིང་འཇགས་ཡོང་གི་རེད།",
    "དེང་སང་གི་འཛམ་གླིང་གནས་སྟངས་ཧ་ཅང་གི་ཛ་དྲག་ཅིག་ཆགས་ཡོད་པ་རེད།",
    "འཛམ་གླིང་འདི་གནས་ཚུལ་དེ་རིགས་སུ་མི་འགྲོ་བའི་ཐབས་ཤེས་གནང་རྒྱུ་ང་ཚོ་ཚང་མའི་ལས་འགན་རེད།",
    "འཛམ་གླིང་ནང་གི་འཕོ་འགྱུར་ཅན་གྱི་གནས་ཚུལ་འདི་དག་མི་དམངས་ཚང་མས་ཤེས་དགོས་པའི་གནས་ཚུལ་ཞིག་ཆགས་ཡོད་པ་རེད།",
    "དེ་གཞིར་བཞག་གིས་ང་ཚོའི་ཉིན་ཞག་གི་བྱ་བ་ཇི་འདྲ་ཞིག་ཡིན་རུང་།",
    "གཞན་ཕན་གྱི་ཀུན་སློང་གི་སྒོ་ནས་བསླངས་པ་ཞིག་གི་ཐོག་ནས་ཡིན་ན།",
    "འཛམ་གླིང་ཞི་བདེ་ཡོང་བའི་རྒྱུ་རུ་འགྲོ་གི་རེད།",
    "ད་རེས་གཟི་བརྗིད་ལྡན་པའི་མཛད་སྒོ་འདིའི་སྐབས་ཕྲན་རང་བཅར་ཐུབ་པར་ཧ་ཅང་གི་དགའ་ཚོར་ཆེན་པོ་བྱུང་།",
    "དེ་རིང་གི་མཛད་སྒོ་འདི་ནི་འཛམ་གླིང་ཞི་བདེར་དགའ་བའི་ནང་པ་ཡོངས་ཀྱིས་འཛམ་གླིང་ཞི་བདེ་ལྷིང་འཇགས་ཡོང་ཐབས་སུ་འབད་བརྩོན་བྱས་པའི་རྟེན་བྱེད་ལྟ་བུ་ཞིག་རེད།",
    "ལྷག་པར་དུ་ཡང་དེ་རིང་གླིང་ཆེན་ཨེ་ཤ་ཡང་ད་ཡུ་རོབ་ནང་པ་གཉིས་ཐབས་ལམ་དེའི་ཐོག་གོམ་པ་མཉམ་སྤོས་བྱེད་རྒྱུའི་དུས་སྐབས་བཟང་པོ་ཞིག་ཐོབ་པ་རེད།",
    "འཛམ་གླིང་དམག་ཆེན་ཁག་གཉིས་ཀྱི་ཉེར་ལེན་ལ་བརྟེན་ནས་འཛམ་གླིང་ནང་ཟང་ཟིང་དང་སྡུག་བསྔལ་མང་པོ་ཞིག་བྱུང་བ་ཡིན་པ་ཚང་མས་དགོངས་པར་མངའ་གསལ་ལྟར་རེད།",
    "དེ་བཞིན་འགྲོ་བ་མིའི་རིགས་མཐའ་དག་རྩ་མེད་དུ་གཏོང་ཉེ་ཆགས་ཀྱི་ཡོད་པ་རེད།",
    "ད་ལྟའང་ང་ཚོའི་སེམས་ནང་འཇིགས་སྐྲག་ཡོང་གི་ཡོད་པ་རེད།",
    "དེ་ལྟ་བུའི་རྡུལ་ཕྲན་མཚོན་ཆའི་འཐབ་རྩོད་ཀྱིས་གཅེས་པར་འཛིན་པའི་ལུས་སྲོག་ལོངས་སྤྱོད་ཚང་མ་རྩ་མེད་དུ་འགྲོ་རྒྱུ་ཡིན་པ་སྣང་ཡུལ་དུ་འཆར་བ་ཙམ་གྱིས་ཚང་མའི་སེམས་ནང་འཇིགས་སྐྲག་ཆེན་པོ་ཞིག་སྐྱེ་གི་ཡོད་པ་རེད།",
    "འཛམ་གླིང་དམག་ཆེན་གཉིས་པའི་རྗེས་སྐྱབས་རྗེ་མཆོག་ནས་ཉི་ཧོང་དུ་ཞི་བའི་མཆོད་རྟེན་མང་པོ་ཞིག་གསར་བཞེངས་གནང་བ་རེད།",
    "ད་རེས་དབྱིན་ཡུལ་རུ་ཞི་བདེ་མཆོད་རྟེན་གསར་བཞེངས་ཀྱི་མཛད་སྒོ་གནང་བར་དམིགས་བསལ་དགོས་པ་ཆེ་ཞིང་།",
    "ལ་དྭགས་སུ་ཡང་ཞི་བའི་མཆོད་རྟེན་ཞིག་བཞེང་རྒྱུའི་འཆར་གཞི་ཡོད་པ་རེད།",
    "སྐྱབས་རྗེ་མཆོག་ནས་འཛམ་གླིང་ཞི་བདེར་རླབས་ཆེན་གྱི་ཕྱག་ལས་ཤིག་གནང་གི་ཡོད་པ་དངོས་མཐོང་རེད།",
    "དེ་འདྲའི་རླབས་ཆེན་མཛད་འཕྲིན་ངོས་འཛིན་གནང་ཐོག་འཕགས་ཡུལ་རྒྱ་གར་གཞུང་ནས་ཁོང་ལ་པཎྜིཏ་ནེཧ་རུའི་འཛམ་གླིང་བསམ་ཤེས་ཞེས་པའི་གཟེངས་བསྟོད་ཕུལ་བ་རེད།",
    "ཞི་བའི་མཆོད་རྟེན་འདི་དག་མ་འོངས་པར་ཞི་བདེ་ལྡན་པའི་འཛམ་གླིང་ཞིག་ཡོང་བའི་མཚོད་བྱེད་དུ་སོང་བའི་རེ་བ་ཡོད།",
    "ནུབ་ཕྱོགས་རྒྱལ་ཁབ་རྣམས་ནས་འཛམ་གླིང་ཞི་བདེར་རླབས་ཆེན་ཕན་ཤུགས་ཡོད་པས་ད་རེས་ཞི་བདེའི་མཆོད་རྟེན་ཞིག་འདི་ཕྱོགས་སུ་གསར་བཞེངས་མཛད་སྒོ་ཐུབ་པར་དམིགས་བསལ་གནས་གལ་ཡོད།",
    "འདིར་མང་དུ་བརྗོད་དེ་ཤུགས་ཀྱིས་བསྒྲུབ་དགོས་པ་གང་ཡང་མེད་སྙམ་མོ།",
    "དེ་དག་གི་སྲོལ་དང་ཉམས་བཞེས་གཙོ་བོ་ཅི་མཛད་སོགས་ཞིབ་ཕྲའི་གནས་ཚུལ་ཕར་ཟད།",
    "སྟོན་པ་གཅིག་གི་རྗེས་འཇུག་དང་དགེ་སློང་ཡིན་པར་འདྲ་ན་ཡང་།",
    "བྱང་ཨ་མེ་རི་ཀ་སོགས་སུ་ཕེབས་སྐབས་ཀྱང་།",
    "དེར་འཛམ་གླིང་གི་ཡུལ་གྲུ་གང་ས་ནས་གལ་ཆེའི་མི་སྣ་མང་དུ་འཛོམས།",
    "ཨ་རིའི་གདོད་མའི་མི་རིགས་ཀྱི་དབུ་ཁྲིད་སོགས་མི་སྣ་ཧ་ཅང་མང་པོ་འཛོམས་ཏེ་ནེའུ་ཡོཀ་སྤྱི་གླིང་ཆེན་མོ་ཞེས་གྲགས་པའི་གླིང་ཁ་དེ་ཉིད་ཀྱི་བར་དུ་ཞི་བའི་གོམ་བགྲོད་གནང་།",
    "རྔ་སྦུག་སོགས་དཀྲོལ་བ་དང་སྣོད་རིན་ཐང་ཆེ་བ་ཞིག་གི་ནང་དུ་བཀྲ་ཤིས་པའི་རྫས་སུ་ཞོ་བཀང་སྟེ་ཕྱག་ཏུ་བསྣམས་ཏེ་འདུག།",
    "ཐུན་མོང་ལམ་སྦྱང་སྔོན་དུ་མ་སོང་བའི་གང་ཟག་ལ་གསང་སྔགས་འཆད་ན།",
    "དེ་ལྟ་བུའི་ཡུལ་དག་ཏུ་སོང་སྟེ།",
    "དེ་ནས་བཟུང་ཕྱི་རྒྱལ་ཁག་ཏུ་ཡོད་པའི་ནང་པའི་རྒྱལ་ཁབ་ཀུན་དང་སོག་ཡུལ་ནང་པའི་འབྲེལ་བ་ཟབ་ཏུ་སོང་།",
    "དེར་བརྟེན་རྒྱ་གར་ནང་ཡོད་པའི་བོད་ཀྱི་གཞུང་དང་སོག་ཡུལ་གྱི་འབྲེལ་བ་ཟབ་ཏུ་སོང་།",
    "༡༩༧༨ ལོར་སླར་ཡང་སོག་ཡུལ་དུ་འོང་དགོས་པའི་བཀའ་ཕེབས་པ་ལྟར་ང་སོང་བ་ཡིན།",
    "གནས་ཁང་ཁག་གི་ལྟ་སྐོར་ཡང་བྱས།",
    "ལུང་སོགས་ཞུ་དགོས་ཚེ་ཧ་ཅང་གི་འཇིགས་པ་དང་།",
    "དགེ་སློང་གི་སྡོམ་པ་ལེན་མཁན་ཡང་མང་པོ་བྱུང་།",
    "ལྷ་མོའི་སྐུ་ཐང་བྲིས་མ་རྙིང་པ་ཞིག་ལ་ཡེ་ཤེས་པ་བསྟིམས།",
    "སྒྲོལ་མ་ཉེར་གཅིག་གི་རྗེས་གནང་དང་།",
    "སྒྲོལ་ལྗང་གི་རྗེས་གནང་སོགས་གང་ལ་གང་འཚམས་བྱས།",
    "རིང་མིན་འཇིགས་བྱེད་ལས་རུང་སོགས་འབུམ་བཞི་རེ་གཏོང་དགོས་པའི་ཁས་ལེན་བྱེད་བཅུག་པ་ཡིན།",
    "ལྗོངས་འདིར་རྒྱལ་བསྟན་ཆེས་ཆེར་སྤེལ་བའི་རེ་སྨོན་ཆེན་པོ་བྱུང་།",
    "རྒྱ་གར་དུ་ཡོད་པའི་བཙན་བྱོལ་བོད་གཞུང་དང་ལྷག་པར་དུ་གོང་ས་མཆོག་གི་སྐུ་སྒེར་ཡིག་ཚང་ལ་འབྲེལ་ལམ་རེ་སྐུལ་ཞུས་ཏེ།",
    "ཁོང་གིས་ཐུགས་བརྩེ་བ་ཆེན་པོས་བདག་ལ་ཡང་ཡང་ཇཱ་པཱན་དུ་ཡོང་དགོས་པའི་བཀའ་ཕེབས་པ་ལྟར་དེར་མཇལ་ཐུབ།",
    "ང་དང་མཉམ་དུ་རྒྱ་གར་ནང་གི་ནང་པའི་མཁས་པ་ཆེན་པོ་ཨཱ་ནཱནྡ་ཀོ་ཤལ།",
    "དེར་བརྟེན་རྒྱ་གར་དང་ཇཱ་པཱན་གྱི་འབྲེལ་བ་ཟབ་ཏུ་འགྲོ་བར་མ་ཟད་ལ་དྭགས་དང་ཇཱ་པཱན་གྱི་འབྲེལ་བ་ཡང་ལེགས་སུ་སོང་།",
    "ངས་ཀྱང་ལ་དྭགས་ལྗོངས་སུ་ཞི་བའི་མཆོད་རྟེན་ཞིག་བཞེང་དགོས་པར་ཇི་ལྟར་གསོལ་བ་བཏབ་པ་ལྟར་ཁོང་གིས་ཞལ་བཞེས་མཛད།",
    "དེ་ལྟར་བདག་གིས་བརྒྱུད་བསྐུལ་བྱས་པ་ལ་བརྟེན་ནས་དེ་ལྟ་བུའི་མཆོད་རྟེན་ཁྱད་པར་དུ་འཕགས་པ་ཞིག་རང་ཡུལ་དུ་སྒྲུབ་ཐུབ་པས་དགའ་སྤྲོ་ཆེ་ཞིང་རྗེས་སུ་ཡི་རང་དཔག་མེད་འཕེལ་བ་ལགས།",
    "དེ་ཡང་ལ་དྭགས་ནང་ཚོགས་དང་དགོན་ཚོགས་གཉིས་ཀྱི་དབུ་སྐྱོང་སོགས་མི་སྣ་གཙོ་གྲས་དག་ལྷན་འཛོམས་ཀྱིས་བཀའ་བསྡུར་གནང་སྟེ།",
    "སྟོད་སྨད་བར་གསུམ་གྱི་འགོ་བྱེད་ལྷན་རྒྱས་བཀའ་མོལ་མཛད་དོན་གོང་ས་ཡིད་བཞིན་ནོར་བུ་དང་།",
    "རྗེ་བཙུན་དམ་པ་འདིས་མཚོན་པའི་འབྲེལ་ཡོད་ལ་དྭགས་པ་རྒན་གྲས་རྣམས་རང་གི་ཡུལ་མི་རྣམས་ལ་བཀའ་དྲིན་ཅི་ཙམ་ཆེ་བ་ཤེས་སླ་སྙམ་མོ།",
    "འདི་ཀུན་རྗེ་བཙུན་ཆེན་པོ་འདི་དང་ལ་དྭགས་ཀྱི་གལ་ཆེའི་མི་སྣ་དག་གི་ལྷག་བསམ་དང་འབད་པ་ཉག་གཅིག་ལ་བརྟེན་ནས་བྱུང་བ་སུས་བལྟས་ཀྱང་མི་ཤེས་པ་མེད།",
    "སྤྱི་ཟླ་ཚེས་བོད་ཟླ་༧ ཚེས་༨ ཉིན་ཞི་བའི་ཚལ་དུ་ས་ཆོག་གི་རིམ་པ་དབུ་འཛུགས་བསྐྱངས་ཤིང་།",
    "དེ་ཡང་གསུང་འཕྲིན་འདི་ཉིད་ད་ལྟ་མཐོང་ཡུལ་དུ་དཀོན་ནས་དཀོན་པར་འགྱུར་བཞིན་ཡོད་པས་བོར་བརླག་ཏུ་སོང་ན་ཕངས་ཆེ་བར་མཐོང་བར་མ་ཟད།",
    "འདི་ལས་ཀྱང་དམ་པ་གང་གི་དགོངས་གཞི་དང་མཛད་པ་ཇི་སྙེད་ཅིག་དཔོག་ཐུབ་པས་འདི་ལྟར།",
    "རྒྱལ་བློན་སེར་སྐྱ་ཕོ་མོ་སུམ་ཁྲི་ལྷག་ཙམ་འདུས་པའི་འཁོར་ལ།",
    "འདི་ཕྱིའི་ལེགས་ཚོགས་འགྲུབ་པའི་ཐབས་ཟབ་མོར་འགྱུར་ངེས་ལགས་ན།",
    "གོང་ཞུས་རྣམས་སེར་སྐྱ་ཕོ་མོ་མཆོག་དམན་བར་གསུམ་ནས་དགོངས་པར་མངའ་བར་འཚལ།"
  ]
}