    "ཉན་ཐོས་དང་རང་རྒྱལ་བ་དང་བླ་ན་མེད་པ་ཡང་དག་པ་དང་བཞིའོ།",
    "༡༡ ཙ་ཙ་ཀ་ཙ་ན་བབཔསི་ཁྲོན་ཏང་དེབ་ཚོགས་པ།",
    "ཞར་བྱུང་ཀུན་རྫོབ་ཀྱི་འདུག་ཚུལ།",
    "ཞར་བྱུང་ཀུན་རྫོབ་ཀྱི་འདུག་ཚུལ།",
    "ཞར་འབྱུང་ཀུན་རྫོབ་ཀྱི་འདུག་ཚུལ།",
    "ཡང་རང་ལས་རང་དུ་གྲུབ་ཟིན་པའི་ཕྱིར་རོ།",
    "འོ་ན་དེ་ལྟར་དངོས་པོ་ཡོད་མེད་དུ་སྣང་བས་མི་མཉམ་པར་འདུག་པ་ཟེར་ན།",
    "མེ་དེ་ཉིད་ཀྱང་རང་ཤི་བཞིན།",
    "གསུམ་པ་ཞོར་འབྱུང་ཀུན་རྫོབ་ཀྱི་འདུག་ཚུལ་ལ་གཉིས་ལས།",
    "ཞར་བྱུང་ཀུན་རྫོབ་ཀྱི་འདུག་ཚུལ་ལོ།",
    "གཟུགས་སོགས་རང་རང་ལས་སྐྱེའོ་ཞེ་ན།",
    "དེ་དག་ནི་བོན་ཅན་རང་རང་ལ་ལྟོས་པའི་འདས་པ་ལ་སོགས་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "མེ་དེ་ཉིད་ཀྱང་རང་ཤི་བཞིན།",
    "གསུམ་པ་ཞོར་བྱུང་ཀུན་རྫོབ་ཀྱི་འདུག་ཚུལ་ལ་གཉིས་ཏེ།",
    "ཞོར་བྱུང་ཀུན་རྫོབ་འདུག་ཚུལ་ལོ།",
    "རྒྱུའི་དུས་ན་རྒྱུ་དང་རང་བཞིན་གཅིག་པའི་ཚུལ་དུ་གྲུབ་ཟིན་པའི་ཕྱིར།",
    "ཕྱོགས་གཅིག་དུས་ཀྱིས་བར་མ་ར་ན་བདེན་པར་གྲུབ་པ་འགའ་ཡང་མེད་པའི་ཕྱིར།",
    "མེ་དེ་ཉིད་ཀྱང་རང་ཤི་བཞིན།",
    "ཞར་འབྱུང་ཀུན་རྫོབ་འདུག་ཚུལ་ལ།",
    "དེ་ཡང་རང་རྒྱུད་པས་རྩོད་གཞིའི་བོན་ཅན་རང་ལུགས་སུ་ཁས་བླང་ནས།",
    "དོན་གཅིག་ལ་མིང་ལྡོག་དུ་མ་ཅན་རྣམས་དོན་དུ་མ་འགྱུར་བ་སོགས་ཀྱི་སྐྱོན་དུ་འགྱུར་ཚུལ་བསྒྲུབས་འདུག་ཀྱང་།",
    "སྒྲོས་བཏགས་པའི་ངོ་བོ་འམ་དང་རང་བཞིན་དེ་རྟེན་ཅིང་འབྲེལ་བའི་རང་བཞིན་ལས་འདས་པ།",
    "ད་དུང་དེ་བཞིན་དུ་རང་ལ་ཚུལ་ཁ་ཕྱོགས་ནས་ང་འཛིན་པའི་ཞེན་འཛིན་དེ་ལ་ཕྱི་བལྟས་བྱས་པའི་ང་རང་ངོས་ནས་གྲུབ་པའི་འཆར་ཚུལ་ཡང་དེ་དང་འདྲའོ།",
    "དོན་དམ་པ་རང་མཚན་དང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཁྱད་པར་བྱེད་དོ།",
    "ལྟ་བ་པོ་རང་ལ་ངོ་བོ་དང་རང་བཞིན་དང་གནས་ཚུལ་ལ་ཡོད་པ་ལྟར་སྣང་བ་ཤར།",
    "འདུག་ཚུལ་ལ་མེད་པར་དཔེ་ཡི་སྒོ་ནས་ཤེས་པར་བྱ་བ་དང་།",
    "འདུག་ཚུལ་ལ་མེད་པར་དཔེ་ཡི་སྒོ་ནས་ཤེས་པར་བྱ་བ་དང་།",
    "ཁྱེད་རང་འཁྲུལ་པའི་རྣམ་རྟོག་སྟེ།",
    "བརྡ་དང་ཐ་སྙད་བཏགས་པ་ཙམ་དེ་ཡང་རང་མཚན་དང་རང་ངོས་ནས་མ་གྲུབ་པ་ཁས་ལེན་ནོ།",
    "འོན་ཀྱང་ནང་རང་སྐལ་བ་དང་འཚམས་པའི།",
    "ལོ་དང་ཟླ་བམ་འགྱངས་རང་རང་སོ་སོའི་ཡུལ་ཕྱོགས་ཀྱི་སྐྱེ་འགྲོ་ཐམས་ཅདབཀའི་འབངས་སུ་བསྡུ་བའི་བཀའ་ཤོག་སྩལ་བ་ལྟརབརྣམས་ལ།",
    "ཟེར་བ་བདེན་པར་འདུག་པས་ངས་མ་ཤེས་པར་བྱས་པ་བཟོད་པར་གསོལ་ལེ་ཞེས་ཞུས་ནས་བསྙེན་བཀུར་ལེགས་པར་ཞུས་སོ།",
    "ད་ལྟ་སྒྲིགས་མི་འདུག་ཞེས་སྔོན་གྱི་གནས་དྲན་པའི་རྡོ་རྗེའི་གསུང་དུ་མ་བཀའ་སྩལ་ཏོ།",
    "རྐང་རྟེན་བཅས་པའི་ཁྲི་ལ་རབ་འདུག་ཅིང་།",
    "ད་ནི་ཉིས་བརྒྱའི་རྦ་རླབས་གཡོ་ཞིང་མྱ་ངན་གདུག་ཅན་གྱིས་བལྟམས་པའི་རྒྱལ་ཁབ་ཀྱི་རྒྱ་མཚོ་ཆེན་པོ་འདིར་འདུག་པའི་ཡུལ་མ་ཡིན་པས་དེར་ཕྱིན་ཆད་གོམས་པ་འདོར་བ་ལྟ་ཞོག་ཕྱི་མིག་ཙམ་ཡང་བལྟ་བར་མིཅུ་ཚཞིང་།",
    "དུ་གདའ་བས།",
    "ནང་སེམས་ཀྱི་དག་ཞེས་གསུངས་པ་བཞིན་སེམས་ཉིད་བཏུལ་བའི་དུས་ལ་བབ་གདའ་བས་འཐབ་དཀྲོལ་གྱི་བྱ་རོམ་དུལ་ན།",
    "སྒོ་འགགན་ཆབ་ཁ་བ་དེ་མ་གཏོགས་མི་སུ་ཡང་མི་འདུག་པར།",
    "རང་རང་ཡིད་ཀྱི་སྨོན་པ་ལས་བརྒལ་བའི།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "དེ་བས་གཙུག་ལག་ཁང་འདིའི་ཕྱིའི་ལྕགས་རི་དེ་ཅུང་དམའ་བ་དང་ཧ་ཅང་དོག་དྲག་པས་མགྲོན་པོའི་སྡོད་ས་ཡང་མི་འདུག་པས་དེ་རྩ་བ་ནས་བཤིགས་ནས་གས་ཉིས་བརྒྱ་རྒྱག་བྱེད་བརྩིས་ཡིནཚོ།་",
    "ཤར་སྒོ་སེང་གེའི་ཁྲི་ལ་འདུག་པར་གྱུར་པ་ལ།",
    "དཀྱིལ་འཁོར་གྱི་ལྷོ་ཕྱོགས་སུ་འདུག་པར་བསམས་ནས་མཎྜལ་ཕུལ་ཏེ།",
    "གསལ་པོར་གྲགས་ཀྱང་རང་བཞིན་སྟོང་།",
    "རྒྱུར་འདོམ་ཕྱེད་བརྒྱད་ཡོད་པ་ཞིག་འདུག་པ་ལ་གྱད་རྣམས་འདི་སྙམ་དུ།",
    "སྐྱོན་བྲལ་ཡོན་ཏན་ལྡན་པ་འདི་ནི་སྟོང་གསུམ་གྱི་འབྱོར་པས་མཆོད་ཀྱང་རང་ཉིད་ལ་སྒྲིབ་པར་མི་འགྱུར་བས།",
    "ཞེས་མཆན་འགྲེལ་ཉུང་ངུ་རྒྱ་གཞུང་རང་འགྲེལ་གྱི་དགོངས་པ་ཁོ་ནར་མ་ནོར་བ།",
    "བརྟུལ་ཞུགས་ལ་མཆོག་ཏུ་འཛིན་པ་དང་རང་ལུས་ཕུང་པོ་ལྔ་ལ།",
    "དེ་ཡང་རང་ཡུལ་ནས་རྐུ་དུས་སོགས་ཀྱིས་དུས་དེ་ཉིད་ལ་ལྟོས་ཏེ་རིན་ཐང་ཚང་བ་དགོས་སོ།",
    "དེ་བཞིན་དུ་གང་ན་བདག་འདུག་པ།",
    "དེས་བརྒྱན་པའི་ཁྲི་ཆེ་བ་ཡིན་ན་དམའ་ཡང་ཉལ་ཁྲི་བཟང་པོ་ལ་ཉལ་བ་དང་འདུག་པ་ལ་སོགས་པ་མི་བྱའོ།",
    "དེ་ལ་འདུག་པའི་ཚེ་ཆགས་སེམས་མེད་པར་མི་རྟག་པའི་འདུན་པས་འདུག་མལ་གོས་དང་སྟན་གཉིས་ཀ་ཀོ་ས་ཀ་ཀོ་ལྤགས་ཡུལ་མཐའ་འཁོབ་དང་ལྷག་པ་ཆེ་སར་གནང་ངོ།",
    "མུ་གེས་ཉམ་ཐག་དུས་ནམ་རྙེད་བཟའ་བར་གནང་ངོ།",
    "ཞི་བའི་དྲན་པ་མེད་པར་འདུག་པ་ལ་སོགས་པ་མི་བྱ་སྟེ་བྱས་ན་ཤིན་ཏུ་ཉེས་པ་ཆེ་བས་སོ།",
    "དེ་ལྟར་དུན་པ་དང་ལྡན་པས་འདུག་པ་སོགས་བྱས་ན་ཉེས་པ་མེད་དོ།",
