    "ཞིང་བྲན་ཁྲི་སྟོང་མང་བོ་སྐུལ་སློང་རྔ་བརྡུང་དར་འཕྱར་གྱི་སྒོ་ནས་འཐབ་རྩོད་ཐེར་འདོན་བྱས།",
    "ངོ་ལོག་པའི་ནག་ཉེས་བཙུགས་ཏེ་བཙོན་འཇུག་བྱས་པ་འདི་ལ་བསམ་གཞིགས་བྱས་ན།",
    "ལོ་ངོ་གསུམ་གྱི་དུས་ཡུན་ཐུང་ངུའི་ནང་ལོ་ངོ་སྟོང་ཕྲག་དུ་མའི་རིང་བྱུང་མ་མྱོང་བའི་འགལ་རྐྱེན་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བའི་རྒྱལ་ཁ་དང་།",
    "རང་ཟོན་ཡོངས་སུ་དོར་ཏེ་བོད་མི་རིགས་ཀྱི་བདེ་སྡུག་ཐུགས་ཀྱིས་མ་བོར་བར་བོད་འབངས་སྡུག་བསྔལ་ལས་སྐྱོབ་པའི་ཞུ་འབོད་འདི་ལྟ་བུ་གནང་བ་ལ་རང་ཅག་བོད་མི་དམངས་ཚང་མས་བཀའ་དྲིན་དྲན་ཤེས་དགོས་ངེས་ལགས།",
    "ནོངས་ནོར་གྱི་ཆ་ཅི་མཆིས་ཕ་མས་བུ་ལ་འདོམས་པ་བཞིན་ལམ་སྟོན་བཀའ་སློབ་གནང་སྩོལ་མཁྱེན་ཞུ།",
    "ཞིང་འབྲོག་སོགས་ཀྱི་ཐོན་སྐྱེད་འཕེལ་ཐབས་སུ་སྐྱེད་ཀ་མེད་པར་སོན་འབྲུ་དང་དངུལ་བུན་བཏང་བ།",
    "བདག་རྒྱལ་ཡོངས་སྲིད་གྲོས་ཀྱི་ཀྲུའུ་ཞི་གཞོན་པར་བཀོད་སྒྲིག་བྱས་པ་དང་།",
    "༡༩༥༦ ལོར་ཙུང་ལི་གཞོན་པ་ཁྲིན་དབྱི་དང་ཀྲུང་དབྱང་བོད་སྡོད་སྐུ་ཚབ་ཀྲང་ཅིང་ཝུ་ཡི་འགོ་ཁྲིད་ལམ་སྟོན་འོག་ལྷ་སར་དངོས་སུ་བཙུགས་པ་དང་།",
    "ལྷག་པར་དུ་བོད་ཀྱི་བཀས་བཀོད་རྒྱུད་འཛིན་ཞིང་བྲན་ལམ་ལུགས་དང་བཤུ་གཞོག་གྲལ་རིམ་རྩ་མེད་དང་།",
    "དེའི་ལེགས་ཆའི་ཤུགས་རྐྱེན་རྣམས་རི་བོ་ཧི་མ་ལ་ཡས་ཀྱང་འགོག་མི་ཐུབ་པར།",
    "ཁོ་ཚོས་གང་ཐུབ་ཅི་ཐུབ་ཀྱིས་བོད་ཀྱི་ལོག་སྤྱོད་ཤོག་ཁག་དང་ངན་འབྲེལ་བྱས་ཏེ་བོད་འདི་མེས་རྒྱལ་ལས་ཁ་བྲལ་གཏོང་རྒྱུ་དང་།",
    "ལྷ་སའི་མི་དམངས་ལ་ལོ་༡༨ ནས་༦ བར་གྱི་དམག་སྐུལ་དང་།",
    "ཁོ་ཚོ་ངོ་ལོག་ཟིང་འཁྲུག་ཞོད་འཇགས་ཀྱི་ལས་འགུལ་ནང་ཞུགས་རྒྱུའི་འབོད་སྐུལ་བྱས།",
    "ཁོ་བ་ཚོ་སྐེ་འཁྱེར་ཞགས་གཟེད་ཀྱི་ལམ་ལ་སྔ་ཙམ་འཇུག་རྒྱུར་སྐུལ་འདེད་བྱས་པ་དང་།",
    "ཕྱི་རྒྱལ་ལོག་སྤྱོད་ཤོག་ཁག་ལ་ངན་འབྲེལ་བྱས་པ་མ་ཟད།",
    "གྲྭ་གྲངས་གང་འཚམས་ཉུང་དུ་བཏང་ནས་གྲྭ་བ་བྱེད་འདོད་མེད་པར་སྐྱ་སར་ཕབ་འདོད་ཡོད་རིགས་ཁྱིམ་ཐབ་འཛིན་དུ་བཅུག་སྟེ།",
    "ཆབ་སྲིད་ཀྱི་མདུན་ལམ་སྤྲད་དེ་ངེས་པར་དུ་ལྟ་སྐྱོང་བྱེད་དགོས་པ་དང་།",
    "བར་གནས་པ་དང་གཡས་ཕྱོགས་པ་ཚོ་ཚུར་འགུག་བྱེད་དགོས་པ་སོགས་ཀྱི་ལམ་སྟོན་གནང་བ་དང་།",
    "མངའ་བདག་གྲལ་རིམ་གྱི་ནག་ཉེས་ཐེར་འདོན་བྱས་པ་དང་།",
    "ལག་རྩལ་ལེགས་བཅོས་དང་གསར་གཏོད་སོགས་འོས་འཚམས་ཀྱི་བྱེད་ཐབས་རིམ་པར་སྤྱད་དེ་བོད་ལྗོངས་སུ་བསྟུད་མར་ལོ་གསུམ་ལ་ལོ་ལེགས་ཀྱི་གྲུབ་འབྲས་གཡུར་དུ་ཟ་བ་བྱུང་བ་དང་།",
    "བསམ་བློའི་ཐོག་ནས་ཀྱང་རྒྱབ་སྐྱོར་ཤུགས་ཆེན་གནང་བ་དང་།",
    "རྣམ་པ་གསར་ཞིང་སྲ་བརྟན་གྱི་གཞལ་ཡས་ཁང་ཞིག་བཞེངས་བསྐྲུན་ཐུབ་པར་བརྟེན།",
    "མགོ་འདོགས་ཞུ་མཁན་ཚོར་འགོ་དམངས་དབྱེ་བ་མེད་པར།",
    "གཞུང་བཞེས་མི་གཏོང་བ།",
    "མི་སྒེར་སོ་སོའི་གནས་ཚུལ་ལ་རྟོག་ཞིབ་མཐིལ་ཕྱིན་བྱས་ཏེ་དབྱེ་བ་ཡོད་པ་དང་གང་ཐུབ་གུ་ཡངས་ཀྱིས་ཐག་གཅོད་བྱས་ནས་མདུན་ལམ་སྤྲོད་རྒྱུ་དང་གཉིས།",
    "བཙོན་འཇུག་སོགས་བྱས་ཏེ་རྡུང་རྡེག་ཆེན་པོ་ཕོག་ཡོད།",
    "འོས་འཚམས་ཀྱིས་དབྱེ་འབྱེད་བྱེད་ཐབས་མེད་པར་གྱུར་ཡོད།",
    "ཟིང་འཁྲུག་པ་དང་ཟིང་འཁྲུག་པར་ངན་འབྲེལ་ཡོད་མེད་ལ་ཞིབ་བཤེར་བྱེད་པའི་ཐད།",
    "ཇག་ཚོགས་ཀྱིས་འཕྲོག་བཅོམ་བྱས་མྱོང་མཁན།",
    "མི་ཁ་ཤས་ཤིག་ལ་རྒྱུ་རྐྱེན་གང་ཡང་མེད་པར་ལས་བྱེད་དང་།",
    "ཧུར་བརྩོན་ཅན་ཚོས་གང་བྱུང་དུ་ནག་ཉེས་རྫུན་བཟོ་བྱས་ཏེ་ཟིང་འཁྲུག་པ་དང་གསར་བརྗེ་ངོ་ལོག་པའི་ཉེས་མིང་བཏགས་ཡོད།",
    "ཟིང་འཁྲུག་ལ་རོགས་སྐྱོར་ངན་འབྲེལ་བྱས་ཡོད་མེད་བརྟག་དཔྱད་སྐབས།",
    "རྡུང་རྡེག་གཏོང་ཡུལ་རྒྱ་ཆེ་དྲགས་པ་སོགས་བྱུང་བའི་ཉེར་ལེན་ལས་གཞུང་བཞེས་གཏོང་མི་འོས་པའི་ཁྱིམ་དུད་མི་ཉུང་བ་ཞིག་ལ་གཞུང་བཞེས་བཏང་སྟབས།",
    "འབྲོག་བདག་དང་འབྲོག་པ་ཕྱུག་པོ་མང་བོ་ཞིག་རང་ཉིད་ཀྱི་སྲོག་འགོ་གང་ཐོན་ལ་བསམ་བློ་གཏོང་བ་ལས་སྒོ་ཟོག་འཚོ་སྐྱོང་དར་སྤེལ་བྱེད་ལོང་མེད་པར་ཆགས་པ་དང་།"
  ]
}