    "དེ་སྙམ་དུ་སེམས་བསྐྱེད་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་སུ་བདག་བསྲུང་བར་འདོད་པ་དེས་གཞན་སུའི་སྤྱོད་པ་ལ་ཡང་བརྟག་པར་མི་བྱའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཡང་མྱུར་དུ་འཐོབ་པར་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "ལུས་ཡོངས་སུ་སྦྱང་བའི་ཕྱིར་བརྩོན་པར་གྱུར་ཏོ།",
    "ལོག་པར་ལྟ་བའི་ཁྱིམ་རྣམས་སུ་སྐྱེས་སོ།",
    "ལྕེ་མེད་པར་གྱུར་ཏོ།",
    "དེ་ནི་ནམ་དུ་ཡང་ཚངས་པར་སྤྱོད་པ་ལ་གནས་པར་བརྗོད་པར་མི་བྱ།",
    "དེ་ནི་གཟུགས་མེད་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཀྱང་གཟུགས་མེད་པར་ཉེ་བར་འགྲོ་བར་བརྗོད་པར་མི་བྱའོ།",
    "ནམ་མཁའི་ཁམས་ཀྱི་གཟུགས་བསྟན་པར་འདོད་དུ་ཟད་དོ།",
    "ཀླུའི་ཉེས་པ་གསུམ་གྱིས་ཀྱང་གོས་པར་མི་འགྱུར་རོ།",
    "སྡུག་བསྔལ་རྣམས་ཀྱིས་ཟིལ་གྱིས་མི་ནོན་པར་བརྗོད་པར་བྱའོ།",
    "དེར་འཆི་བའི་དུས་བྱེད་པར་མི་འགྱུར་རོ།",
    "སྐྱེ་བོ་མང་པོ་ལ་ཡང་དག་པར་བསྟན་པ།",
    "སྐྱེ་བོ་མང་པོ་ལ་ཡང་དག་པར་འཛིན་དུ་འཇུག་པ།",
    "སྐྱེ་བོ་མང་པོ་ལ་ཡང་དག་པར་གཟེངས་བསྟོད་པ།",
    "སྐྱེ་བོ་མང་པོ་ལ་ཡང་དག་པར་དགའ་བར་བྱེད་པ་བྱུང་ནས།",
    "བསམ་གཏན་བཞི་ཡང་ཐོབ་པར་གྱུར་ཏོ།",
    "སྐྱེ་བོ་མང་པོ་རབ་ཏུ་དགའ་བར་བྱས་ཀྱང་།",
    "ང་ནི་ཚངས་པར་སྤྱད་ནས་ཡུན་རིང་བ་ཡིན་གྱི་དེ་ནི་གསར་བུ་སྟེ།",
    "བསྙེན་པར་རྫོགས་ནས་རིང་པོར་མ་ལོན་པ་ཡིན་གྱིས།",
    "དེ་ལྟར་ཡིད་ཆེས་པར་མ་བྱེད་ཅིག་ཅེས་ཟེར་རོ།",
    "དགེ་སློང་འཚོ་བ་ཡོངས་སུ་དག་པ་དེ་ལ་སྐྱེ་བོ་དེ་དག་རབ་ཏུ་དད་པས་དེ་ལྟར་དེས་སྐྱེ་བོ་དེ་དག་ལ་དབྱེན་བྱས་ཀྱང་དབྱེ་བར་མ་ནུས་སོ།",
    "འཆི་བའི་དུས་བྱས་ནས།",
    "ཐམས་ཅད་དུ་ཡང་ལྕེ་མེད་པར་གྱུར་ཏོ།",
    "ལས་དེའི་རྣམ་པར་སྨིན་པས་ང་སྙིགས་མ་ལྔའི་དུས་ན།",
    "ལས་དེའི་རྣམ་པར་སྨིན་པས་དུས་ཀྱི་སྙིགས་མའི་ཚེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་མཁྱེན་བཞིན་དུ།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་ནི་ལས་ཀྱི་སྒྲིབ་པ་དེ་དང་ལྡན་པར་བདག་ཅག་ཉིད་ཀྱིས་མཐོང་ལགས་སོ།",
    "སེམས་ཀྱིས་གཞན་བསམ་པར་མི་བྱ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་འདུ་ཤེས་བསྐྱེད་པ་མ་གཏོགས་པར་འདུ་ཤེས་གཞན་བསྐྱེད་པར་མི་བྱའོ།",
    "དེ་ལ་དགོངས་ཏེ་དེ་བཞིན་གཤེགས་པ་མི་འཁྲུགས་པས་ཐུགས་དམ་བཞེས་པ།",
    "ཏིང་ངེ་འཛིན་ཐོབ་པར་འགྱུར་བ་དེ་དག་ཐམས་ཅད་ནི་དེ་བཞིན་གཤེགས་པའི་མཐུས་ཐོབ་པར་གྱུར་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་སྤངས་པར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་མཐུར་ཤེས་པར་བྱ་བ་ཡིན་ན།",
    "དེ་ནི་ལུང་མནོད་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་ཟེར་ཏེ།",
    "རྣམ་པར་འཐག་པ་ལ་སྐྱོན་འདོགས་པ་ལྟ་ཅི་སྨོས་ཏེ།",
    "ཇི་ཙམ་དུ་མི་སྙན་པར་བརྗོད་པ་དེ་སྲིད་དུ་ལྕེའི་སྐྱེ་མཆེད་མེད་པ་ཐོབ་པར་འགྱུར་རོ།",
    "ཀ་ཤི་ཀའི་རྒྱལ་པོ་གང་ཡིན་པས་མགོ་བྱིན་པར་གྱུར་པ་དེ་འཆལ་བའི་ཤེས་རབ་ཡིན་ནམ།",
    "གསོལ་པ་བཅོམ་ལྡན་འདས་དེ་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "ཚེ་རབས་བརྒྱ་སྟོང་ཕྲག་བདུན་ཅུ་རྩ་བཞིར་མི་སྙན་པར་བརྗོད་པ་ཐོབ་པར་གྱུར་ཏོ།"
  ]
}