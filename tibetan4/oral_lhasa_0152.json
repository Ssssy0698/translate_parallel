    "རྒྱུ་དང་རྐྱེན་དེས་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པར་མི་འགྱུར་བའོ།",
    "ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་འབད་དེ་བསྒོམས་པས་དེ་ཡང་འཐོབ་བོ།",
    "རྒྱུན་ཆད་པ་མེད་པར་མཚན་མ་མེད་པའི་ཡིད་ལ་བྱེད་པ་མངོན་དུ་གྱུར་པས་ན།",
    "རྒྱུ་དང་རྐྱེན་དེས་ཡན་ལག་དེ་ཡོངས་སུ་སྒོགས་པར་འགྱུར་བའོ།",
    "རྒྱུན་ཆད་པ་མེད་པར་མཚན་མ་མེད་པའི་ཡིད་ལ་བྱེད་པ་ལ་གནས་པར་མི་ནུས་སོ།",
    "སྒྲིབ་པ་གསུམ་དག་ཡང་སྤོང་བའི་ཕྱིར་ཡང་དག་པར་རྩོལ་བའི་རྒྱུ་སྒྲུབ་པར་བྱེད་དེ།",
    "ཡང་དག་པར་རྩོལ་བས་སྒྲིབ་པ་གསུམ་སྤངས་ནས།",
    "ས་བདུན་པ་ལ་འཇུག་ཅིང་རྣམ་པར་དག་པ་ཁྱད་པར་དུ་འཕགས་པ་རྣམ་པ་བརྒྱད་ཀྱང་འཐོབ་པར་འགྱུར་ལ།",
    "མཚན་མ་མེད་པར་གནས་པ་ལ་རྩོལ་བ་ལྷག་པར་བཏང་སྙོམས་སུ་བཞག་པ་དང་།",
    "ཡན་ལག་དེ་སྔ་མ་ལ་ཕྱི་མའི་སྤྱོད་པ་ཡོངས་སུ་མ་རྫོགས་པར་བསྟན་པ་དང་།",
    "རྒྱུ་དང་རྐྱེན་དེས་ཡན་ལག་བརྒྱད་པ་དེ་ཁྱེམ་རྫོགས་པར་གྱུར་པའོ།",
    "རྒྱུ་དང་རྐྱེན་དེས་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བའོ།",
    "སྒྲིབ་པ་གསུམ་པོ་དག་སྤང་བའི་ཕྱིར་ཡང་དག་པར་རྩོལ་བའི་རྒྱུ་སྒྲུབ་པར་བྱེད་དེ།",
    "ཡང་དག་པར་རྩོལ་བས་སྒྲིབ་པ་གསུམ་པོ་སྤངས་ནས་ས་བརྒྱད་པ་ལ་འཇུག་ཅིང་།",
    "རྣམ་པར་དག་པ་ཁྱད་པར་དུ་འཕགས་པ་རྣམ་པ་བརྒྱད་ཀྱང་འཐོབ་པར་འགྱུར།",
    "རྩོལ་བ་དང་བྲལ་བའི་སེམས་ཀྱིས་མཚན་མ་མེད་པ་ལ་གནས་པ་ལ་སོགས་པ་ཡང་ཐོབ་པར་འགྱུར།་",
    "ཡན་ལག་སྔ་མ་ལ་ཕྱི་མའི་སྤྱོད་པ་ཡོངས་སུ་མ་རྫོགས་པར་བསྟན་པ་དང་།",
    "མཚན་ཉིད་མང་པོ་ཞེས་བྱ་བ་ནི་དོན་སོ་སོ་ཡང་དག་པར་རིག་པའི་ཡུལ་ལོ།་",
    "ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པའི་ཡུལ་ལོ།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པའི་ཡུལ་ཏེ།",
    "རྒྱུ་དང་རྐྱེན་དེས་ཡན་ལག་དགུ་པ་ཡོངས་སུ་མ་རྫོགས་པར་གྱུར་པའོ།",
    "ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་འབད་དེ་བསྒོམས་པས་དེ་ཡང་འཐོབ་བོ།",
    "འདི་ལྟར་ས་དགུ་པས་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ཐོབ་པའི་ཕྱིར།",
    "རྒྱུ་དང་རྐྱེན་དེས་ཡན་ལག་དེ་ཡང་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བའོ།",
    "སྒྲིབ་པ་གསུམ་པོ་དག་སྤང་བའི་ཕྱིར་ཡང་དག་པར་རྩོལ་བའི་རྒྱུ་སྒྲུབ་པར་བྱེད་དོ།",
    "ཡང་དག་པར་རྩོལ་བས་སྒྲིབ་པ་གསུམ་པོ་དག་སྤངས་ནས་ས་དགུ་པ་ལ་འཇུག་ཅིང་རྣམ་པར་དག་པ་ཁྱད་པར་དུ་འཕགས་པ་རྣམ་པ་བརྒྱད་ཀྱང་འཐོབ་བོ།",
    "མ་རིག་པ་དང་པོས་ནི་སོ་སོ་ཡང་དག་པར་རིག་པ་དང་པོ་གསུམ་ལ་སྒྲིབ་པར་བྱེད་དོ།",
    "རབ་ཏུ་མྱོང་བ་འཐོབ་པར་མི་ནུས་པས་རྒྱུ་དང་རྐྱེན་དེས་ཡན་ལག་དེ་ཡོངས་སུ་མ་རྫོགས་པ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི།",
    "ཡན་ལག་སྔ་མ་ལ་ས་སྔ་མའི་སྤྱོད་པ་ཡོངས་སུ་མ་རྫོགས་པར་བསྟན་པ་དང་།",
    "ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་འབད་དེ་བསྒོམས་པས་དེ་ཡང་འཐོབ་བོ།",
    "རྒྱུ་དང་རྐྱེན་དེས་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བའོ།",
    "སྒྲིབ་པ་གསུམ་པོ་དེ་དག་སྤང་བའི་ཕྱིར་ཡང་དག་པར་རྩོལ་བའི་རྒྱུ་སྒྲུབ་པར་བྱེད་དོ།",
    "ཡང་དག་པར་རྩོལ་བས་སྒྲིབ་པ་གསུམ་པོ་པྱ་སྤངས་ནས་ས་བཅུ་པ་ལ་འཇུག་ཅིང་ཁྱད་པར་དུ་འཕགས་པའི་རྣམ་པར་དག་པ་ཐུབརྒྱད་ཀྱང་འཐོབ་པར་འགྱུར་ལ།",
    "ཡན་ལག་སྔ་མ་ལ་ཕྱི་མའི་སྤྱོད་པ་ཡོངས་སུ་མ་རྫོགས་པར་བསྟན་པ་དང་།",
    "མཐོང་བ་དམ་པ་ཐོབ་པར་མི་ནུས་པས་རྒྱུ་དང་རྐྱེན་དེས་ཡན་ལག་དེ་ཡོངས་སུ་མ་རྫོགས་པར་གྱུར་པའོ།",
    "ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་འབད་དེ་བསྒོམས་པས་དེ་ཡང་འཐོབ་སྟེ།",
    "ཡན་ལག་བཅུ་གཅིག་པ་ཐམས་ཅད་ཀྱང་ཡོངས་སུ་རྫོགས་པར་གྱུར་པའོ།",
    "ཤེས་པ་ཐོབ་པར་མི་ནུས་ཏེ།",
    "གནས་ངན་ལེན་རྣམ་པར་སྨིན་པ་ཞེས་བྱའོ།",
    "སྒྲིབ་པ་གསུམ་པོ་དེ་དག་སྤང་བའི་ཕྱིར་ཡང་དག་པར་རྩོལ་བའི་རྒྱུ་སྒྲུབ་པར་བྱེད་དོ།",
    "ཡང་དག་པའི་རྩོལ་བས་སྒྲིབ་པ་གསུམ་པོ་དེ་དག་སྤངས་ནས་བཅུ་གཅིག་པ་དེ་བཞིན་གཤེགས་པའི་ས་ལ་འཇུག་ཅིང་ཁྱད་པར་དུ་འཕགས་པའི་རྣམ་པར་དག་པ་བདུན་དང་།",
    "སྐྱེ་བ་དང་བྲལ་བའི་རྣམ་པར་དག་པ་དང་།",
    "ཤེས་པ་ཡང་འཐོབ་པར་འགྱུར་ཏེ།",
    "གནས་སྐབས་སྔ་མ་ལ་སྤྱོད་པ་ཡོངས་སུ་མ་རྫོགས་པར་བསྟན་པ་དང་།",
    "སྔ་མའི་གནས་སྐབས་ཀྱི་ཡན་ལག་ཡོངས་སུ་རྫོགས་པར་བསྟན་པ་དང་།",
    "གནས་སྐབས་ཞུ་ཕྱི་མ་ཡོངས་སུ་མ་རྫོགས་པར་བསྟན་པ་དང་།",
    "ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་མན་ཆད་ཡོངས་སུ་རྫོགས་པར་བྱ་བར་བསྒྲུབ་པར་བསྟན་པའོ།་།",
    "གནས་སྐབས་སྔ་མ་ཡོངས་སུ་སྡོགས་པར་བསྟན་པ་དང་།",
    "ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་ཡོངས་སུ་རྫོགས་པར་བྱ་བ་སྣིབསྒྲུབ་པར་བསྟན་པ་དང་།",
    "ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཀྱེ་ཕྱིར་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་ཡོངས་སུ་རྫོགས་པར་གྱུར་པ་དྔྷ་བཟླས་ཏེ་བསྟན་པའོ་ཞེས་ཟེར་ཏེ།",
    "འདི་ཡང་ཞུ་བ་གསོལ་བ་དང་ལན་དུ་གསུངས་པས་བསྟན་ཏེ།",
    "གཉིས་པ་དེ་བཞིན་གཤེགས་པས་ཡང་དག་པར་ལན་དུ་གསུངས་པ་སྟོན་ཏོ།",
    "ལྷའི་རྒྱལ་པོ་ཆེན་པོ་བཞིས་བདེན་པ་གཉིས་ཀྱི་མཉམ་པ་ཉིད་ཀྱི་དོན་ཅིག་ཅར་གསལ་བར་མཐོང་བ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "བྱ་བ་དང་ནུས་པ་ཆེན་པོ་ཐོབ་པས་ཇི་ལྟར་སྨོས་པ་བཞིན་དུ་གྲུབ་པའི་ཕྱིར་རབ་ཏུ་དགའ་བ་ཞེས་བྱའོ་ཞེས་གསུངས་པ་ལྟ་བུ་སྟེ།",
    "བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་ཀྱང་།",
    "འཇིག་རྟེན་གྱི་སྤྱོད་ཡུལ་ཡང་དག་པར་འདས་པ་རྣམ་པ་བཅུ་ལ་སོགས་པ་དང་།",
    "དགའ་བ་རྣམ་པ་བཅུ་རྒྱ་ཆེར་རྣམ་པར་འབྱེད་པ་ནི།",
    "འཕགས་པ་ས་བཅུའི་འགྲེལ་པ་ལས་ཇི་སྐད་དུ་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དེའི་ཕྱིར་ཚིགས་སུ་བཅད་པར།",
