    "ཡང་དག་པར་དཔྱད་ན་རྟག་ཆད་དང་འགྲོ་འོང་སོགས་ཀྱི་མཐའ་དང་བྲལ་བ་ཡིན་པས་བྱེད་པོ་རྒྱུ་དང་བྱ་བ་འབྲས་བུ་ལ་རང་བཞིན་གྱིས་གྲུབ་པ་གང་ཡང་མེད་དེ།",
    "འབྲས་བུ་གཏན་མེད་མིན་ཡང་རྒྱུའི་རང་དུས་ན་མེད་པ་དེ་རྒྱུས་བསྐྱེད་པས་མེད་པ་བསྐྱེད་པར་རིགས་སོ་སྙམ་ན།",
    "རྒྱུ་ཡོད་བཞིན་དུ་བསྐྱེད་པར་རིགས་པ་མིན་པ་དེ་བཞིན་རྒྱུ་འགག་ནས་མེད་པའི་དུས་སུ་རྒྱུས་བསྐྱེད་པར་དེ་བས་མི་རིགས་སོ།",
    "འབྲས་བུ་ཡོད་མེད་གཉིས་ཀ་ཡིན་པ་སྟེ་མུ་གསུམ་པོ་གང་ཡང་སྐྱེད་པར་མི་རིགས་པས་རྒྱུ་འབྲས་གཉིས་ཀ་ངོ་བོས་གྲུབ་པ་མེད་དོ།",
    "དེ་ལྟར་རྒྱུ་འབྲས་ལ་བདེན་དངོས་མེད་པར་བརྗོད་པ་ལ།",
    "འབྲས་བུ་ལ་ལྟོས་ནས་རྒྱུར་འཇོག་པས་བཏག་པ་ཙམ་གྱི་གཞན་ལ་ལྟོས་པའི་ཕྱིར་ལྟོས་གྲུབ་ཀྱི་རྒྱུ་འབྲས་གཉིས་ཀ་ཀུན་རྫོབ་ཏུ་ཡོད་རུང་བས་རྒྱུ་འབྲས་གཉིས་ཀ་མེད་པར་སྨྲ་བར་མི་འགྱུར་རོ།",
    "དེས་ན་རྒྱུ་འབྲས་ལ་བདེན་པར་གྲུབ་པའམ་ངོ་བོའམ་རང་བཞིན་གྱིས་གྲུབ་པ་ཅུང་ཟད་མེད་ཀྱང་ལྟོས་ནས་བཏགས་པའི་རྒྱུ་འབྲས་ཀྱི་སྣང་བ་བསླུ་མེད་ནི་ནམ་ཡང་མེད་པར་མི་འགྱུར་ལ།",
    "དེ་ལྟ་ན་ཐམས་ཅད་དུ་སོ་སོའི་འདོད་པ་ཙམ་གྱིས་གྲུབ་པར་འགྱུར་ཏེ་རིགས་པ་མི་དགོས་པའམ་རྣམ་པར་སྤངས་པས་འགྲུབ་དགོས་ན་དེ་ནི་ཤིན་ཏུ་མི་རིགས་སོ།",
    "བསྟན་བཅོས་རིགས་པ་རྣམས་ཀྱིས་གསུངས།",
    "དེས་ན་མེ་ནི་ལག་ཏུ་འཛིན་པ་པོ་རང་གཞན་གཉིས་ཀ་བསྲེག་པར་བྱེད་གྱི་གཅིག་ལ་མ་ཡིན་པ་ལྟར།",
    "ངོ་བོ་ཉིད་ཀྱི་ཁྱད་པར་སྦྱར་ནས།",
    "འདིར་དཔེར་ན་སྒྲ་རྟག་པར་སྨྲ་བ་རྣམས་ཀྱི་དམ་བཅའ་སོགས་གསུངས་ཏེ།",
    "སྒྲ་རྟག་པ་ཡིན་པར་དམ་བཅའ་གཏན་ཚིགས་ལུས་ཅན་མ་ཡིན་པའི་ཕྱིར་ཞེས་དང་།",
    "མཇུག་སྡུད་དེའི་ཕྱིར་སྒྲ་ཡང་རྟག་པར་གྲུབ་བོ་ཞེས་སྒྲུབ་ངག་ཡན་ལག་ལྔ་ལྡན་དུ་བཀོད་པ་འདི་ལྟ་བུ་ནི་གཏན་ཚིགས་ལྟར་སྣང་ཡིན་ལ།",
    "དེ་ལ་སྒྲ་མི་རྟག་པར་འདོད་པས་སྨྲས་པ།",
    "བྱས་པའི་ཕྱིར་བུམ་པ་བཞིན།",
    "སྐྱེས་བུས་རྩོལ་བས་བྱས་པ་དེ་བཞིན་དུ་སྒྲ་ཡང་མགྲིན་རྐན་ལ་སོགས་པའི་རྩོལ་བའི་བསྐྱེད་པའམ་བྱས་པ་ཡིན་ལ།",
    "དེའི་ཕྱིར་སྒྲ་མི་རྟག་པར་གྲུབ་བོ་ཞེས་གཞན་དག་སྨྲ་བར་འགྱུར་ཏེ།",
    "གཞན་ཡང་རྒྱུ་འབྲས་སོགས་ལྟོས་བཏགས་ཙམ་དུ་མི་འདོད་པར་ངོ་བོ་ཉིད་ཀྱིས་གྲུབ་པར་ཁས་ལེན་པའི་ལུགས་ལ།",
    "དེའི་ཚུལ་གསུངས་པ།",
    "དེ་བཞིན་དུ་བརྗོད་པའི་ཡི་གེ་རིམ་པར་སྐྱེ་འགག་བྱེད་པ་ཡིན་ལ།",
    "སྒྲུབ་པར་བྱེད་པ་སོགས་ཡིན་དགོས་ཀྱང་དེ་མི་སྲིད་དོ།",
    "དེའི་ཕྱིར་དོན་དམ་པར་དཔྱད་ན་འབྲས་བུ་ནི་རང་ལས་སྐྱེ་བ་མ་ཡིན།",
    "རྒྱུ་དང་འབྲས་བུ་སོགས་ངོ་བོས་གྲུབ་པར་ཁས་ལེན་པའི་ལུགས་ལ་སུན་འབྱིན་དུ་འགྱུར་ཞིང་།",
    "ད་ནི་བདག་སུན་དབྱུང་བ་གསུངས་པ།",
    "གལ་ཏེ་བདག་འདི་ནི་རྟག་པ་ཡིན་པར་གྱུར་ན།",
    "གལ་ཏེ་བདག་ངོ་བོས་ཡོད་ཅིང་དེ་ཡུལ་རིག་པར་བྱེད་པ་སོགས་ཀྱི་བྱ་བ་དང་བཅས་པར་གྱུར་ན།",
    "ངོ་བོས་གྲུབ་ཅིང་རྟག་པའི་བདག་དེ་ལ་སད་པའི་དུས་སུ་བྱ་བ་དང་བཅས་པ་དེ་བཞིན་དུས་རྟག་ཏུ་བྱ་བ་དང་བཅས་པར་ཅིས་མ་ཡིན་ཞེས་སོ།",
    "སྔོན་གྱི་འདུ་བྱེད་པའི་ཤུགས་སམ་བྱ་བ་དག་དང་བཅས་པ་མིན་པར་རྟོགས་པར་བྱའོ།",
    "ཇི་ལྟར་འབྲས་བུ་འབྱིན་པར་འགྱུར།",
    "འགོག་པ་སྟེ་ངོ་བོ་མེད་པའམ་དོན་དམ་པར་མ་གྲུབ་པ་ཡིན་ལ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་དུ་གསུངས།",
    "དེ་ལྟར་གོ་བར་བྱས་ནས་འགྲེལ་བར།",
    "བྱེད་པ་པོ་ངོ་བོས་གྲུབ་པ་ཡིས་རྣམ་པར་དམན་པའམ་དབེན་པ་ཡིན་པ་འགལ་མེད་ཡིན་ཏེ།",
    "ཞིང་ལ་ས་བོན་དེ་འདེབས་པའི་བྱེད་པོ་སྐྱེས་བུ་དེ་ཡིན་པར་གྲགས་ཀྱང་།",
    "ཞེས་གསུངས་པ་འདི་སྐབས།",
    "གཞན་ནི་དེའི་རང་བཞིན་ཞེས་པ་ལ་སོགས་པར་གསུངས་པའི་ཕྱིར་རོ་ཞེས་དང་།",
    "གཞན་རྣམས་ལ་སྟེ་གཟུགས་དེ་ཡང་གཞན་ཞེས་པ་ལ་སོགས་པར་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་པ་འདིའི་དོན་འཆད་ཚུལ་སྣ་ཚོགས་བྱས་པ་སྣང་ཡང་དོན་འདི་ཡིན་ཏེ།",
    "གཞན་གཟུགས་སོགས་ཕུང་པོ་ལྔའི་རྒྱུན་རྣམས་ལ་སྟེ་གཞན་གཟུགས་སོགས་ནི་གང་ཟག་དེའི་རང་བཞིན་དང་གདགས་གཞི་སོགས་སུ་གསུངས་པའི་ཕྱིར་རོ།",
    "འགོག་པའམ་དོན་དམ་པར་བཅིངས་པ་མེད་དོ།",
    "དོན་དམ་པར་བཅིངས་པ་ཡོད་ན་ནམ་ཡང་གྲོལ་བར་མི་ནུས་པས།",
    "ཅེས་གསུངས་པ་འདིའི་དོན་འགྲེལ་བར།",
    "འདིར་དངོས་པོ་དང་དངོས་པོ་མེད་པ་གཅིག་ཏུ་འདྲེས་པར་གྱུར་པ་རང་བཞིན་མེད་ཅིང་རྫས་ཀྱི་རྣམ་པར་རྟག་པ་དང་བྲལ་བ་པྲ་ཕབ་པ་དང་མཚུངས་པ།",
    "མ་འདས་པར་དངོས་དངོས་མེད་གཉིས་ལྡན་ནམ་གང་རུང་ཞིག་ཡིན་ཞེས་བསམ་ན་གཉིས་ལྡན་དང་དངོས་པོ་ཡིན་པར་ཁས་ལེན་པ་མེད་ཀྱང་དངོས་དངོས་མེད་ལས་འདས་པའི་སྤྲོས་བྲལ་དུ་ཁས་ལེན་མ་ནུས་ན།",
