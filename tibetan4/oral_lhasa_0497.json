    "འཇིག་རྟེན་ཆགས་ཚུལ་གསུངས་པ་ལྟར།",
    "སྔགས་པ་ཡིན་ན་ཅི་བྱས་པ་བཀག་པ་མེད་པ་ལྟ་བུར་བསམ་པ་ནི།",
    "རྣ་བ་དག་དང་མིག་ཏུ་གཅིན་ནི་རིམ་པར་དྲོ་བ་དང་།",
    "ད་ནི་ཚེ་འཕེལ་བའི་དོན་དུ་བདུད་རྩི་ལྔའི་སྦྱོར་བ་གསུངས་པ།",
    "ཇི་ལྟར་ཕྱི་རོལ་དེ་བཞིན་ལུས་ཞེས་གསུངས་པ་ལྟར།",
    "བྷྲིཾ་ག་ར་ཛ་ནི་རཱ་ཛཱ་རིང་པོར་བྱས་ནས་རྒྱལ་པོར་བསྒྱུར་བ་ཡོད་ཀྱང་།",
    "དངུལ་ཆུ་ནི་འཆད་འགྱུར་ལྟར་དག་པར་བྱས་ལ་ཁུ་བ་དང་དངུལ་ཆུ་ཡང་ཆ་མཉམ་དུ་བྱས་པའོ།",
    "ལག་པ་གཉིས་པོ་དག་ནི་བརླའི་མཐར་ཐུག་པར་རབ་ཏུ་འཕྱང་བར་བྱ་ཞིང་ལངས་ཏེ།",
    "ཡང་སྔར་ལྟར་བྱས་ཏེ་དེ་ལྟར་ཡང་ཡང་ལུས་ལ་ཚ་བ་དག་ནི་གྲོལ་བའི་བར་དུ་ཡང་བྱ་སྟེ་ཚ་བ་གྲོལ་ནས་མི་བྱའོ།",
    "ཡང་དང་ཡང་དུ་འཆད་འགྱུར་གྱི་ཏིང་ངེ་འཛིན་ལ་གནས་པར་བྱའོ།",
    "དེས་འཆི་བའི་འཇིགས་པ་བྱེད་པའི་ཚེར་མ་ཅན་ནི་ངེས་པར་འཇོམས་ཏེ།",
    "ཐོག་སེར་སོགས་ཉེ་བར་འཚེ་བ་ཐམས་ཅད་ལ་དེ་དེའི་མིང་སྤེལ་སྦྱར་ནས་བདག་དང་གཞན་བསྲུང་བ་ལ་དྲན་པར་བྱའོ་ཞེས་བཅོམ་ལྡན་འདས་ཀྱི་ངེས་པའོ།",
    "འགྱུར་འགར་སྐྱུ་རུ་རའི་འབྲས་བུའི་ཕྱེ་མ་ཞེས་གསུངས།",
    "དྷཱ་ནྱ་པ་ཞེས་པ་ཀུ་སྟུཾ་པུ་རུ་ཞེས་འབོད་པ་འགྱུར་མངས་སུ་འུ་སུ་ཞེས་བྱས་པ་དེ་དང་ནི།",
    "གཞན་ཡང་དེ་བཞིན་ཏིནྟི་རཱི་ཡི་འདབ་མའི་ཕྱེ་མ་ཞེས་པ་འགྲེལ་པར་བན་དྷཱུ་ལིའི་འདབ་མ་ཞེས་གསུངས་པ།",
    "འགྱུར་མངས་སུ་བ་ལུ་ཞེས་པར་བྱས།",
    "རྣམ་པར་དག་པའི་གསེར་སྦྱང་བ་ལ།",
    "འདི་རྣམས་ཆ་མཉམ་པར་བྱའོ།",
    "ཁབ་ལེན་སོགས་ལས་སྐྱེས་པའི་ལྕགས་དེ་དག་རྣོ་ལྕགས་ཁྱད་པར་ཅན་ཡིན་ནོ།",
    "དེ་ཡང་དང་པོར་གསེར་བཟང་པོ་སྦྲང་གཤོག་ཙམ་དུ་བརྡུང་བར་བྱས་ནས་བསྲེག་པ་དང་།",
    "དེ་ལྟར་ལྕགས་ཁམས་གསུམ་པོ་ཆ་མཉམ་པར་བྱས་ལ།",
    "དེ་དག་ཀོང་བུར་བླུགས་ནས་དེར་མཱ་ཀྵི་ཀ་ཞེས་པ་འབེམ་ར་སེར་པོར་གྲངས་པ་རྡོ་གསེར་ཟིལ་གྱི་ཕྱེ་མ་ཡིས་གདབ་པར་བྱ་ཞིང་།",
    "ཞི་གའི་ཀོང་བུ་ཁ་བྱེ་བ་དེའི་ནང་དུ་བཅུག་པ་དེ་དག་སོལ་བའི་མེར་ང་དྲག་པོས་སྦུད་པར་བྱས་ནས་ཡང་ཡང་བཞུས་པས་ཇི་སྲིད་རྫས་གཞན་ཚིག་ནས་གསེར་འབའ་ཞིག་གནས་པའི་བར་དུའོ།",
    "དེ་ཡང་ལན་བདུན་གྱི་བར་དུ་སྦྱང་བར་བྱས་པས།",
    "རྡོ་ཡི་སྣོད་དམ་གླ་ཧེ་ལ་ནང་དུ་དངུལ་ཆུ་མཉེ་བསྲུབ་བྱས་པས་ཡང་ནས་ཡང་དུ་སྦྱང་ནས་ཟླ་བ་ལྟར་དྲི་མ་མེད་ཅིང་བེར་རྒ་འཛིན་པའི་ཚད་དུ་གྱུར་བར་བྱ་སྟེ།",
    "ཁབ་ལེན་གྱི་སྣོད་དུ་སླར་ཡང་བསྐོལ་བ་དག་ཀྱང་ཇི་སྲིད་ཁུ་བ་ཕྱེད་ལུས་པ་ཉིད་ཀྱི་ཚད་དུ་མ་གྱུར་པར་བསྐོལ་བར་བྱའོ།",
    "འོན་ཀྱང་གསེར་གྱི་གོང་བུས་རྣམ་པར་དམན་པ་སྟེ་ཟད་པར་གྱུར་གྱི་བར་དུའོ།",
    "དེ་ནས་ཟན་སོགས་ལོངས་སྤྱོད་བསྒྲུབ་པའི་རྒྱུར་གསེར་ཕྱེད་ལྡན་གྱི་སྦྱོར་བ་གསུངས་པ།",
    "སྔར་རམ་གོང་དུ་བརྗོད་པ་ས་བོན་གསེར་དང་རྒྱལ་པོ་དངུལ་ཆུ་མཉམ་པ་དག་སྟེ་འདྲེས་པར་བཏགས་པ་དང་།",
    "ཤི་ལཱ་སྡོང་རོས་དམར་པོ་དག་ཀྱང་དངུལ་ཆུ་དང་མཚུངས་པར་མཉེ་སྟེ།",
    "གཞན་རྫས་རྣམས་འགྲེལ་པར་གསུངས་པ་སྔ་མ་རྣམས་ཀྱི་ངོས་འཛིན་མཛད་པ་ནི་འདི་ལྟ་སྟེ།",
    "ཉིན་ཞག་གསུམ་དུ་ཐབ་ཀྱི་མེས་རན་པར་གདུང་པས་སྨིན་པར་བྱས་པ་དག་ཀྱང་ཕྱེད་དང་ལྡན་པས་སོ་ཞེས་དངུལ་གྱི་ཕྱེད་གསེར་གྱི་ཆ་དེས་དངུལ་ཆ་གཅིག་གསེར་དུ་འགྱུར་བས་སོ།",
    "དེ་ནས་མེ་ཏོག་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ནི་རྣོན་པོ་ཡི་ལྕགས་ཞེས་པ་དངུལ་ནག་ཏུ་གྲགས་པ་ལྕགས་དཀར་གྱི་ནང་དུ་དངུལ་ལྷད་བསྲེས་པ་བཞུ་ཞིང་འདྲེས་པར་བརྡུང་པ་ཁྲོ་དང་འཁར་བའི་ཆ་འདྲ་ཞིག་ཏུ་འོང་ངོ།",
    "དེའི་འདབ་མ་སྦྲང་གཤོག་བྱས་པ་དེ་དག་པར་བྱེད་པའི་སླད་དུ།",
    "དེ་རྣམས་བསྡོམ་ནས་ཉི་མ་ཞེས་པ་ཟངས་ཉིས་འགྱུར་བྱས་པ་རོ་མཉམ་བྱེད་པས་ཞེས་གཅིག་ཏུ་འདྲེས་པར་བྱེད་པའི་སླད་དུ་ཀོང་བུ་ཁ་བསྡམ་པར་བསྲེག་ཅིང་།",
    "སླར་ཡང་ལན་ཚྭས་ཞེས་ཊཾ་ག་ནའི་ལན་ཚྭ་ཞེས་པ་འཇུ་རྩི་ཚྭ་ལས་དག་པར་འགྱུར་བ་དང་ནི་དེ་བཞིན་དུ་བ་ལས་བྱུང་བ་པ་ཡི་དར་བའོ།",
    "ཀྵཱི་ར་ཀཉྩུ་ཀཱའི་རྩ་བ་སྟེ་ཐར་ནུའི་རྩ་བ་རྣམས་བརྡུངས་ནས་ཟངས་ལྷག་ཚྭ་ལས་དག་པར་བྱས་པ་དང་ལྷན་ཅིག་བཏགས་ནས་ཞག་བདུན་བར་དུ་མནན་པར་བྱའོ།",
    "དེས་མཉེན་ཞིང་འཇམ་པར་འགྱུར་རོ།",
    "དེ་ནས་དེ་བཞུ་ཞིང་རྫས་དེ་དངུལ་ལ་དངུལ་གྱི་སུམ་ཆ་ཞིག་བྱིན་ཞིང་ཁ་བཀང་སྟེ་བཞུས་པ་ལ་བསྣུན་པ་སྟེ་བརྡུང་བར་བྱས་པ་དག་ཀྱང་དག་པ་ཡི་ནི་དངུལ་གྱི་མེ་ཏོག་ཉིད་དུ་འགྱུར་ཏེ་དངུལ་གྱི་སུམ་ཆ་དངུལ་མིན་ཡང་།",
    "ཨུཏྤལ་ནི་སྐབས་འདིར་རྟ་ཡིན་པར་འགྲེལ་བར་གསུངས།",
    "དེ་ཏྱ་ཞེས་པ་མུ་རཱ་འོ་ཞེས་གསུངས་པ་འདི་ལ་ཐར་ལོ་སོགས་ཤུ་དག་དཀར་པོ་ཞེས་འདོད་ལ།",
    "ཛ་ལ་སྟེ་ཆུ་ཞེས་པ་པཱ་ལ་ཀ་ཡིན་པར་གསུངས་པ་དྲི་ཞིམ་པོ་རྩ་བ་རིང་པོ་ཅན་ཞིག་ཡོད་ཅེས་ཟེར་ལ།",
    "དེ་ལྟར་སྦྱར་ནས་དྲི་དེ་དག་ཁྱད་པར་དུ་འགྱུར་བའི་ཕྱིར།",
    "དེ་ནས་ལི་ཚེ་ལ་བགོད་པའི་རྫས་རྣམས་ཀྱི་ཆ་གསུངས་པ།",
    "ཛཱ་ཏི་ལ་སོགས་པ་ལྔ་དབྱུང་བར་བྱས་ནས་དེའི་ཚབ་ཏུ་གཞན་ལྔ་གཞུག་པར་བྱ་བ་ནི།",
    "ཀ་ལ་ཤར་གྲགས་པ་ཀ་ཀོ་ལ་ལྔ་ཕྱུངས་ནས་དེ་ཡི་གྲོང་དུ་རིམ་པས་དགོད་པར་བྱ་བ་ནི།",
    "དེའི་ཐང་ཆུ་སྤོས་དཀར་གྱི་མིང་ཡིན་ཡང་སྐབས་དེར་ཤིང་ཡིན་ནམ་ཁྱད་པར་ཡོད་པ་གང་ཡིན་བརྟག་གོ།",
    "བཞི་པ་མཁའ་བྷེ་རུཎྚ་བིཥྚའི་རྫས་ཕྱུངས་ནས་དེ་ཡི་གྲོང་དུ་ཁྲུས་ཀྱི་སྦྱོར་བ་ལ་དགོད་པར་བྱ་བ།",
    "གཉིས་པར་སྟག་ཅེས་པ་སྟག་སེན་ཏེ་ཀཎྚ་ཀ་རི་དང།",
    "དེ་ནས་དྲིལ་ཕྱིས་ཀྱི་ལེ་ཚེ་སྦྱར་བ་གསུངས་པ།",
    "ཁྲུས་ཀྱི་ལེ་ཚེ་སྦྱར་བར་གསུངས་པའི་ནང་ནས་ཤུན་པ་ཤིང་ཚ་བཞིན་དུ་རྫས་ལྔ་པོ་འདི་རྣམས་ཆ་གསུམ་སྦྱིན་པར་བྱ་སྟེ།",
    "སྔར་དྲི་ཡི་ལེ་ཚེ་སྦྱར་བར་བརྗོད་པ་མ་བཟློག་པ་སྟེ་མ་ཕྱུངས་པར་སོར་བཞག་ལ།",
    "གྲནྠི་བརྞ་མདུད་པའི་ལོ་མ་དག་ཀྱང་ཆ་གསུམ་བྱིན་ནས་དྲིའི་ལེ་ཚེའི་རྫས་ལྔ་དང་འདི་གཉིས་བཅས་རྫས་བདུན་པོ་ཆ་བཅོ་བརྒྱད་པ་འདི་ཉིད་འཆད་འགྱུར་ལྟར་ཏིལ་མར་སྨིན་པར་བྱས་པ་ནི་དྲི་སྣ་ཚོགས་ཀྱི་ཏིལ་མར་བྱ་བ་ལའོ།",
    "དྲི་སྦྱོར་གྱི་རྫས་ནི་མ་ཉམས་པ་དང་སྦྱར་ཚད་དང་ལྡན་པས་རྣམ་པར་དག་ཅིང་འབྲས་བུ་སོགས་དང་སྦྱོར་བས་དྲི་སྨིན་པ་དང།",
    "དེ་ཡང་དྲིའི་སྦྱོར་བ་ལ་བདུག་པར་བྱ་བའི་འཕྲོད་ཀྱི་རྫས་ནི་འདབ་མ་ཐ་མ་འབྲིང་དང་མཆོག་གསུམ་ལས།",
    "འདི་གོ་བ་ད་དེར་བརྗོད་ན་ཨ་རུ་ར་བུ་རམ་སྦྱར་བ་ལྔ་ཚོན་གྱི་འདབ་མའི་སྤོས་སྦྱོར་དེའི་བརྒྱད་ཆ་ཙམ་གྱིས་ཉིན་ཞག་དང་པོ་ལ་བདུག་པར་བྱ་སྟེ་དྲིའི་རྫས་རྣམས་ཀྱི་ལྡེ་གུ་ཁམ་ཕོར་ནང་དུ་སྦྱར་བ་ལ་འོག་ནས་ཁམས་ཕོར་གྱི་ནང་ནས་བདུག་བྱེད་ཨ་རུ་དང་བུ་རམ་གྱི་དུ་བས་བདུག་ཏེ་དུ་བ་མི་འཆོལ་བར་ཞག་གཅིག་འགོག་པར་བྱའོ།",
    "དེ་ནས་ཉིན་ཞག་གཉིས་པ་ལ་མེ་ཏོག་དྲི་ཞིམ་པོས་བགོ་བ་བྱས་ནས།",
    "འདབ་མ་དེ་ཡི་བདུག་པ་བསྐ་བ་དག་ཉིས་འགྱུར་དག་ནི་དྲག་པོའི་སྤོས་ལ་བདུག་པར་བྱ།",
    "དེའི་ཕྱི་ནས་དྲག་པོའི་སྤོས་ཀྱི་རྫས་ཀྱི་ཚད་ཀྱི་སྟེ་ཚད་དང་མཉམ་པའི་བུ་རམ་དག་ཀྱང་བསྲེག་པས་བདུག་པར་བྱར་སྟེ།",
    "འགྲེལ་པར་དེ་ནས་བུ་རམ་ཚིག་པར་གྱུར་པ་ན་ཞེས་པ་བསྲེག་ནས་ཞེས་པའི་དོན་ཏེ།",
    "དེ་ནས་སྦྲང་རྩི་དང་དཀར་པོ་ཞེས་པ་ཤ་ཁ་ར་དག་ཀྱང་སྤོས་ཀྱི་རྫས་དང་མཉམ་པ་གོང་བུའི་བདུག་པ་འཆད་འགྱུར་ལྟར་ངེས་པར་བསྲེག་པས་བདུག་པར་བྱའོ།",
    "གོང་བུ་ཞེས་པ་ནི་གོང་བུའི་བདུག་པ་སྟེ་ག་བུར་དང་བཅས་ཤིང་དྲག་པོའི་སྤོས་ཀྱི་རྫས་ལྔ་སྦངས་ནས་ལེ་ཚེ་སྦྱར་བའི་རྫས་ལྔ་བུ་རམ་གྱི་ས་སྦྲུས་པའི་གོང་བུ་བསྲེག་ནས་བདུག་པར་བྱ་སྟེ།",
    "ཉིན་ཞག་སོ་སོར་དྲི་ཡི་རྫས་ཀྱི་བརྒྱད་ཆའི་སྤོས་ངེས་པར་བསྲེག་པས་བདུག་པར་བྱའོ།",
    "དེ་ནས་ཡོངས་སུ་སྨིན་པའི་དྲི་ཤེས་པར་བྱས་ནས།",
    "མ་སྨིན་ན་ཇི་སྲིད་སྨིན་པར་འགྱུར་གྱི་བར་དུ་དཀར་པོའམ་བསིལ་བའི་ཙན་དན་དང་ཀ་ར་སོགས་ཀྱི་བདུག་པ་བསྲེག་པར་མི་བྱའོ།",
    "ཟླ་བ་ག་བུར་དང་མ་ད་ཞེས་གླ་རྩི་སྟེ་འདི་ལྔ་ཆ་མཉམ་པར་བྱས་ནས་བརྒྱད་འགྱུར་གྱི་ཆང་འཆད་པར་འགྱུར་བ་དང་བཅས་པས་འབུགས་པར་བྱའོ།",
    "ད་ནི་དྲི་རྣམས་བསླང་བའི་དོན་དུ་ཆང་གསུངས་པ།",
    "འབྲུ་སོ་བའི་ཕུང་པོའི་དབུས་སུ་བཞག་པས་སྨིན་པར་འགྱུར་ཏེ།",
    "དེ་ཡང་མེས་བསྐོལ་བའི་རྗེས་སུ་སྦྲང་རྩི་དེ་ལ་རི་དྭགས་ཏེ་གླ་རྩི་སོགས་འབུགས་པ་ལྔ་དང་མཉམ་པར་སྦྱར་བ་ཡི་ཆང་དང་ལྟེ་བ་གླ་རྩི་སོགས་འབུགས་རྫས་དང་ལྡན་པ་འདི་ནི་དྲི་འབིགས་པར་བྱེད་པ་སྟེ་དྲི་ཡི་རྫས་ཀྱི་ཕྱི་ནང་ཀུན་དུ་འབིགས་ཤིང་ཁྱབ་པར་བྱེད་པའོ།",
    "རྫས་ཆུང་བ་ལ་ནཱ་རི་ཀེ་ལ་ལ་བགོས་ནས་དུ་བ་ལ་བཟེད་པར་བྱས་ཀྱང་རུང་ངོ།",
    "སྤངས་ལེབ་ཀྱི་སྟེང་དུ་ཁ་སྦུབ་ཏེ་བཞག་ལ་གོས་ཀྱིས་ཕྱི་ནས་བྱིབས་པར་བྱའོ།",
    "སྨིན་པར་བྱ་བའི་དུས་སུའང་རྫས་ཀྱི་སྣོད་ཐོད་པ་དང་འཁྲུལ་འཁོར་གྱི་བར་དུ་རླན་དང་བཅས་པའི་གོས་ཀྱིས་དཀྲིས་ཏེ་དུ་བ་མི་འཆོར་བ་དང་མེས་ཚ་བ་མེད་པར་བྱའོ།",
    "དེ་ནས་ཕྱུངས་ཏེ་བསིལ་བར་གྱུར་པའི་དྲི་ལྟེ་བ་ལ་སོགས་སྔར་བརྗོད་པ་རྣམས་ཀྱིས་དབུག་པར་བྱའོ།",
    "ཆུ་ནང་བཅུག་ན་ཆུ་དངས་བྱེད་ཤིང་ཀེ་ཏ་ཀའི་འདབ་མ་རྣམས་ལ་སྣོད་བྱས་ནས་དྲིའི་རྫས་གཞུག་སྟེ་བྱ་བ་གཞན་འབྲས་བུའི་སྨིན་པ་བཞིན་ནོ།",
    "རྐྱལ་བར་བྱེད་པ་བྱས་པས་སྨིན་ནས་དབུག་པ་སྔར་བཞིན་ནོ།",
    "འདིར་མ་གསུངས་པ་གཞན་དྲིའི་བསྟན་བཅོས་ལས་ཤེས་པར་བྱའོ་ཞེས་གསུངས་སོ།",
    "ཙ་ལ་གཡོ་བ་སིཧླ་རྣམས་བུ་རམ་གྱི་ཁུ་བ་དྭངས་མས་སྦྱང་ནས་སྤོས་ཀྱི་སྦྱོར་བ་རྣམས་ལ་བསྣན་པར་བྱས་ཏེ་ཉིན་ཞག་གཅིག་གམ་གཉིས་སོགས་སུ་འདམ་བཏགས་བྱ་བ་དེ་ནི་སྐྱུར་བ་སོགས་ཀྱི་དྲི་རྣམ་པར་སྦྱང་བའམ་བསང་བའམ་བསང་བའི་དོན་དུ་ཡིན་པ་སྟེ།",
    "གྲནྠི་བརྞ་ཆ་གསུམ་དྲིལ་ཕྱིས་ཀྱི་སྤོས་སྦྱོར་དག་ལ་ཡང་སྦྱིན་པར་བྱའོ།",
    "མཱཾ་སི་དང་པཱ་ལ་ཀའམ་མེད་ན་བ་ལུ་དང་ཙནྡན་རྣམས་ཞོ་གཉིས་ཧྲོ་བ་བརྡུང་རས་གཙང་ལ་ཐུམ་པོ་བྱས་ཏེ།",
    "ཆུ་བྲེ་བརྒྱད་ཀྱི་ནང་དུ་གཞུག་པར་བྱ་ཞིང་བསྐོལ་ནས་བཞི་ཆ་ལུས་པ་ན་དྲིའི་ཆུ་ཡིན་ཏེ།",
    "དེའི་ནང་དུ་ན་ཁི་བཏགས་པར་བྱའོ།",
    "དེ་ནས་ཉིན་ཞག་འགའ་ཞིག་སྟེ་བཅུའི་བར་དུ་སྤོས་ཀྱིས་བདུག་པའི་ཆ་ལས་བྱུང་བའི་དྲིའི་སྐྱོན་ཞི་ཕྱིར་མེ་ཏོག་བཟང་པོ་རྣམས་ཀྱིས་བསྒོ་བ་དག་བྱས་ནས་སྔར་གྱི་དྲི་ཡི་ཆུ་ཡིས་ཡང་ཡང་མི་སྐམ་པར་བསྲེགས་ནས་འདམ་འཐག་བྱས་པ་དག་བྱ་སྟེ།",
    "སྤྲ་ཚིལ་དང་ནི་གོས་ཀྱིས་བར་མཚམས་བཅད་ཅིང་བཅིངས་པར་བྱས་ཏེ་བརྟན་པར་ཁ་བཅད་ལ།",
    "བིལ་བ་ལྔའི་འདབ་མ་བསྐོལ་བའི་ཆུ་ཡིས་ཏིལ་རྣམས་མཉེས་ནས་སྤུན་པ་བསལ་ཏེ་དག་པར་བྱས་པ་དག་པ་དང་པོ་དང་ནི།",
    "དེའི་སྟེང་དུ་སྣོད་གཞན་གྱིས་བྱིབས་ནས་སྤོས་དྲི་བཟང་པོ་རྣམས་ཀྱིས་ཆུའི་རླངས་པས་བདུག་པར་བྱས་པ་དག་པ་གཉིས་པ་དང།",
    "དེ་ནས་ཏིལ་འཚིར་བའི་འཁྲུལ་འཁོར་དག་ལས་ཏིལ་མར་བླངས་ནས་ཀྱེ་མི་ཡི་བདག་པོ་མཁས་པས་འཆིང་བུའི་སྣོད་དམ་ཁ་དོག་བསྒྱུར་བའི་ཤེལ་སྣོད་དུ་བཞག་པར་བྱའོ།",
    "དེ་འདྲའི་ཏིལ་མར་དེ་ནི་ཁྲུས་ཀྱི་དུས་སམ་ཡན་ལག་ལ་བྱུགས་པ་དག་ལས་དགའ་བར་བྱེད་པའི་དྲིས་མྱོས་པར་བྱེད་ལ།",
    "དེ་ནས་གླ་རྩི་ག་བུར་ཛཱ་ཏི་སོགས་དྲི་འབུགས་པའི་རྫས་བྱིན་ནས་མཆིང་བུའི་སྣོད་དུ་བཞག་པར་བྱའོ།",
    "ཏིལ་མར་དེ་ལ་གླ་རྩིའི་ཆང་རྫས་ཀྱི་རྐང་པའི་ཆ་ཤས་བསྲེས་ནས་རྒྱ་སྐྱེགས་ཀྱི་སྣོད་དུ་ཉི་མའི་འོད་ཀྱིས་ཞག་བདུན་གདུང་བར་བྱས་ན་གླ་རྩིའི་ཏིལ་མར་དུ་འགྱུར་རོ།",
    "གཉིས་པར་ཉི་མ་སྟེ་བཅུ་གཉིས།",
    "དེ་བཞིན་དུ་རིམ་པར་ལྔ་པར་མིག་སྟེ་གཉིས་དང་དྲུག་པར་འདོད་པ་བཅུ་གསུམ།",
    "བརྒྱད་པར་དྲག་པོ་བཅུ་གཅིག་དགུ་པར་རྒྱལ་པོ་བཅུ་དྲུག་བཅུ་པར་མེ་སྟེ་གསུམ་དག་དང།",
    "བཅུ་གཅིག་པར་ཕྱོགས་བཅུ་དང་།",
    "བཅུ་གསུམ་པར་བུག་པ་དགུ་དང་།",
    "བུ་རབ་ཏུ་བཙའ་བར་འགྱུར་བའི་དུས་སུ་སྦྲུམ་མ་རྣམས་ལ་མིག་སྔ་དང་བྷ་གར་བསྟན་པར་བྱ་སྟེ་མངལ་འགྲོལ་བའི་ངེས་པའོ།",
    "འདོམ་གྱི་ཕྱོགས་སུ་ཡིག་མགོ་ཐུར་བསྟན་དུ་འཇོག་པ་ངེས་པར་བཤད།",
    "དེ་ཙམ་རྒྱས་སྤྲོས་མ་བྱས་ཀྱང་ཆོག་པར་སྣང་ངོ།",
    "དེ་ནས་བྱིས་པའི་རྒྱུད་གསུངས་པ།",
    "རྡོ་རྗེ་ཡིས་ནི་བསྔགས་པ་དག་ཀྱང་མངལ་གྱི་ཟུག་རྔུ་ཅན་ལ་རབ་ཏུ་སྦྱིན་པར་བྱ་སྟེ།",
    "འདི་རུ་རྟ་ལ་སོགས་པའི་སྟེང་དུ་བསྣན་ཡང་གསུངས།",
    "འོ་མ་དང་མར་དང་ཐུག་པ་དང་ཟན་དང་ནི་ཞོ་དང་བུ་རམ་བཅས་པ་ཡི་གཏོར་མ་ཉིན་ཞག་མ་རྣམས་དག་ལ་ཞག་གསུམ་གྱི་བར་དུ་སྦྱིན་པར་བྱའོ།",
    "ཁྲུས་བྱས་པའི་མཇུག་ཏུ་ཕྱིས་པ་ལ་བདུག་པ་སྦྱིན་པར་བྱ་སྟེ།",
    "དེ་ནས་ལོ་ཅན་མ་རྣམས་ཀྱི་གཏོར་མའི་ཆོ་ག་གསུངས་པ།",
    "བཟའ་བ་ལྔ་ཞེས་པ་ཡུང་བ་སོགས་ཀྱིས་ཟན་ཁ་དོག་སེར་པོ་དཀར་པོ་དམར་པོ་ནག་པོ་ལྗང་ཀུར་བྱས་པ་ལྔ་དང།",
    "དེ་ལྟར་མ་བྱས་ན་བྱིས་པ་རྣམས་ཞི་བ་དང་རྒྱས་པར་མི་འགྱུར་རོ།",
    "རྒྱས་པར་སྒྲུབ་ཐབས་ལེའུ་སོགས་དང་འཕྲུལ་ཏེ་ཤེས་པར་བྱའོ།",
    "རིགས་ལྡན་མས་ཟིན་པའི་རྟགས་ཚང་བའི་བྱིས་པ་དེ་ནི་འཆི་བར་འགྱུར་ཏེ་ངེས་པར་ལྷ་དང་མི་དང་ལག་འགྲོ་ཀླུ་རྣམས་ཀྱིས་བསྲུང་བར་ནུས་པ་མིན་པའི་སླད་དུའོ།",
    "འདི་ཉིད་དུ་སྒྲུབ་ཐབས་ལེའུར་འཆད་འགྱུར་གྱི་འབྱུང་པོའི་ཕྱག་རྒྱ་བཅིངས་པ་ཇི་སྙེད་ཅིག་ལས་ཕྱག་རྒྱ་གང་དག་གང་བཅིངས་པ་ལས་གདོན་ནམ་འབྱུང་པོ་དེ་དང་དེས་གཟིར་བ་ཡིན་པའི་མཚན་མ་ཤེས་པར་བྱའོ།",
    "དེ་ནས་ཞི་བའི་ཐབས་གསུངས་པ།",
    "མེར་ནི་ང་ཁམས་དག་པའི་གྲི་གུག་ནག་པོ་ངེས་པར་པདྨའི་འདབ་མ་ལ་གནས་ཤིང་ལྷ་མིན་ཟུར་དུ་མེ་ཁམས་དག་པ་ལྕགས་ཀྱུ་དམར་པོ་དག་ཏུ་འགྱུར་རོ།",
    "ཆུ་རུ་སྟེ་ནུབ་ཏུ་དཔལ་ལྡན་བེ་ཅོན་སེར་པོ་གཏི་མུག་རྡོ་རྗེ་དག་ཏུ་རབ་ཏུ་འགྱུར་ཏེ་ངེས་པར་བྱང་དུ་ཐོ་བ་དཀར་པོ་ང་རྒྱལ་རྡོ་རྗེ་དག་ཀྱང་ངོ།",
    "དེ་ནས་གདོན་གྱིས་ཟིན་པ་རྣམས་ཀྱི་ཁྲུས་ཀྱི་ཆོ་ག་གསུངས་པ།",
    "སོ་མ་བཏང་བའི་ཁམ་ཕོར་གཙང་མ་ནི་བདུན་གྱིས་ཆུ་གཙང་མ་དང།",
    "དེ་ནས་སླར་ཡང་ཉུངས་ཀར་སོགས་ཀྱིས་ངེས་པར་བྲབ་ཅེས་པ།",
    "མཆོད་ཡོན་དག་དང་མེ་ལྷ་སྤྱན་དྲང་བ་དང་།",
    "འདིར་རང་དང་གཞན་གྱི་ལྟ་བའི་ཁྱད་པར་གྱི་འདོད་པ་རྣམ་པར་གཞག་པ་གསུངས་པ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "མི་རྣམས་ཀྱི་ཡིད་ལ་ཡང་དག་པར་སྦྱར་བ་དེས།",
