    "མངར་ལ་སོགས་པས་བརྒྱན་པར་བྱའོ།",
    "བསྐྱེད་པར་བྱའོ།",
    "རི་རབ་ལ་རྣམ་པར་བཞུགས་པ་སྟེ།",
    "ཛཧཱུྃ་བཾ་ཧོས་གཉིས་སུ་མེད་པར་བསྟིམས་ལ།",
    "ཕྲིན་ལས་རྣམ་པ་བཞིའི་སྒོ་ནས་བཞུགས་ཏེ།",
    "དེ་ནས་སྔགས་བཟླས་པར་བྱ་སྟེ།",
    "སླར་བདག་ཉིད་ཀྱི་ཐུགས་ཀར་ཐིམ་པར་བསམ།",
    "གདུལ་བྱའི་སྟེང་དུ་དབབ་པར་བྱ།",
    "ཞེས་གསུངས་པས་བསྲེགས་བསྐྲད་བཅོམ་བཏགས་པར་བསམ།",
    "པེ་སྣར་། ཕྱག་ན་རྡོ་རྗེ་གོས་སྔོན་པོ་ཅན་གྱི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "༡ པེ་སྣར་པར།",
    "རྣལ་འབྱོར་སྔོན་དུ་བསྙེན་བྱས་པས།",
    "འཁོར་ལོའི་ལས་ལ་འཇུག་པར་བྱ།",
    "བརླག་པར་འགྱུར་ཏེ་ཐེ་ཚོམ་མེད།",
    "ཀུན་གྱིས་འགྲུབ་པར་མི་ནུས་སོ།",
    "དམིགས་ན་ལྷ་འང་བརླག་པར་འགྱུར།",
    "འབར་བའི་འཁོར་ལོ་བསྐྱེད་པར་བྱ།",
    "མེ་འབར་དཔལ་དང་བཅས་པར་བསམ།",
    "ལོག་འདྲེན་ཚོགས་རྣམས་འཇོམས་པར་བྱེད།",
    "མཆོད་བསྟོད་སྡིག་བཤགས་ལ་སོགས་བྱ།",
    "རྗེས་སུ་གནང་བ་གསུམ་ལྡན་གྱིས།",
