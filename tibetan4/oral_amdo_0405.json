    "གཞན་ཡང་ཉོན་མོངས་དྲི་མ་དྲུག།",
    "གང་གིས་རིག་པར་གཏམས་པ་མི་འཛིན་པའོ།",
    "གང་གིས་མཚོན་ཆ་དང་ཚིག་རྩུབ་པོ་དག་གིས་ཕ་རོལ་པོ་རྣམ་པར་ཐོ་འཚམས་པར་བྱེད་པའི་ཉོན་མོངས་པའི་དྲི་མ་དྲུག་པོ་དེ་དག་ལས།",
    "འདི་དག་ཅི་ཞིག་གིས་སྤང་བར་བྱ་བ་ཡིན་ཞེ་ན།",
    "དེ་དག་ལས་གཞན་པའི་ཉེ་བའི་ཉོན་མོངས་པ་ཀུན་ནས་དཀྲིས་པས་བསྡུས་པ་ཕྲག་དོག་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པ་ལྔ་པོ་དེ་དག་ནི།",
    "ཉོན་མོངས་པའི་དྲི་མ་དྲུག་ཀྱང་དེ་དང་འདྲའོ།",
    "འདོད་པའི་ཁམས་ཡན་ཆད་ཀྱི་ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་ནི་ཅི་རིགས་པར་ལུང་དུ་མ་བསྟན་པ་དག་ཡིན་ནོ།",
    "ཉེ་བའི་ཉོན་མོངས་པ་བཅུ་གཅིག་ནི་འདོད་པ་ན་སྤྱོད་པ་ཁོ་ན་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་དྲུག་གི་ས་པ་ནི་དུ་ཞིག་ཡིན་ཞེ་ན།",
    "ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་གཞན་དག་ནི་རྣམ་པར་ཤེས་པ་དྲུག་གི་ས་པ་དག་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་དག་དང་མཚུངས་པར་ལྡན་པ་ཉེ་བའི་ཉོན་མོངས་པ་ངོ་ཚ་མེད་པ་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པ་གང་དང་མཚུངས་པར་ལྡན་ཞེ་ན།",
    "རྣམ་པར་ཤེས་པ་དྲུག་གི་ས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡིད་མི་བདེ་བ་དང་ཐེ་ཚོམ་མོ།",
    "ཉོན་མོངས་པ་རྣམས་ཀྱི་རྒྱུན་འཆད་པའི་དུས་ན་གདོན་མི་ཟ་བར་བཏང་སྙོམས་ཀུན་དུ་གནས་སོ་ཞེས་གྲག་གོ།",
    "ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་ལས།",
    "སེར་སྣ་དག་གི་བཟློག་པ་ཡིན།",
    "རེས་འགའ་ནི་ཡིད་བདེ་བ་དག་གིས་ཕ་རོལ་པོ་འདྲིད་པར་བྱེད་ལ།",
    "རེས་འགའ་ནི་ཡིད་མི་བདེ་བ་དག་གིས་ཏེ།",
    "ཉོན་མོངས་པའི་ས་མང་པོ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཉིད་དག་གི་ཟས་ཀྱང་གཅིག་ཟས་མ་ཡིན་པ་ཡང་གཅིག་ཏུ་གསུངས་ཏེ།",
    "རྒོད་པ་དང་འགྱོད་པ་དག་གིས་ཀྱང་ཟས་ཀྱང་གཅིག་ཟས་མ་ཡིན་པ་ཡང་གཅིག་ཏུ་གསུངས་ཏེ།",
    "གཞན་དག་ན་རེ་རྟོག་པ་འདི་ལ་ནི་ཏིང་ངེ་འཛིན་གྱི་ཕུང་པོ་དང་འགལ་བ་རྒོད་པ་དང་འགྱོད་པའི་སྒྲིབ་པ་སྔར་སྨོས་པར་འགྱུར་ཏེ།",
    "འགོག་པ་དང་ལམ་མཐོང་བས་སྤང་བར་བྱ་བ་ཟག་པ་དང་བཅས་པ་ལ་དམིགས་པ་རྣམས་གང་གི་ཚེ་དམིགས་པ་ཡོངས་སུ་ཤེས་པ་དེའི་ཚེ་ནི་སྤོང་བར་མི་འགྱུར་ལ།",
    "གང་གི་ཚེ་སྤོང་བར་འགྱུར་ལ་དེའི་ཚེ་ནི་དམིགས་པ་ཡོངས་སུ་མི་ཤེས་ན་ཇི་ལྟར་དེ་དག་སྤོང་ཞེ་ན།",
    "ཉོན་མོངས་པ་རྣམས་ནི་དམིགས་པ་ཡོངས་སུ་ཤེས་པས་ཟད་པར་ངེས་པ་མ་ཡིན་ནོ།",
    "རྣམ་པ་བཞི་པོ་གང་དག་གིས་ཤེ་ན།",
    "རེ་ཞིག་མཐོང་བས་སྤང་བར་བྱ་བ་རྣམས་ནི།",
    "ཟག་པ་མེད་པ་ལ་དམིགས་པ་རྣམས་ནི་དེ་དག་གི་དམིགས་པ་ཡིན་པས་དེ་དག་སྤངས་ན་དེ་དག་ཀྱང་སྤང་བ་ཡིན་ནོ།",
    "ཉོན་མོངས་པའི་རྣམ་པ་གང་དག་གི་གཉེན་པོ་ལམ་གང་ཡིན་པ་སྐྱེས་པ་དེ་སྤོང་བར་བྱེད་དོ།",
    "གང་གི་གཉེན་པོ་གང་ཞིག་ཡིན་ཞེ་ན།",
    "སུན་འབྱིན་ཞེས་བྱ་སྤོང་བ་གཉེན་པོ་ནི་བར་ཆད་མེད་པའི་ལམ་མོ།",
    "གང་གིས་དེས་ཐོབ་པའི་སྤོང་བ་ཀུན་དུ་འཛིན་པར་བྱེད་པའོ།",
    "གཞན་དག་ན་རེ་རྣམ་པར་གྲོལ་བའི་ལམ་ཡང་ཡིན་ཏེ།",
    "རྣམ་པར་སུན་འབྱིན་པའི་གཉེན་པོ་ནི་ལམ་གང་གིས་ཁམས་དེ་ལ་སྐྱོན་དུ་མཐོང་ནས་རྣམ་པར་སུན་འབྱིན་པར་བྱེད་དོ།",
    "གཞི་གཉེན་པོ་ནི་རྣམ་པར་གྲོལ་བའི་ལམ་མོ།",
    "ཐང་བསྲིང་བའི་ངོ་བོའི་གཉེན་པོ་ནི་ཁྱད་པར་གྱི་ལམ་མོ་ཞེས་བྱ་བ་འདི་ནི་ཆེས་ལེགས་པར་འགྱུར་རོ།",
    "ཉོན་མོངས་པ་སྤོང་བ་ན་གང་ལས་སྤང་བར་བྱ་ཞེ་ན།",
    "དམིགས་པ་ལས་ཉོན་མོངས་པ་ནི་སྤང་བར་བྱར་འདོད།",
    "མཚུངས་པར་ལྡན་པ་ལས་ནི་ཉོན་མོངས་པ་རྣམ་པར་དབྱེ་བར་མི་ནུས་སོ།",
    "རེ་ཞིག་མ་འོངས་པ་ནི་དམིགས་པ་ལས་རྣམ་པར་དབྱེ་བར་ཡང་ནུས་གྲང་ན་འདས་པ་གོ་ཇི་ལྟར་ནུས།",
    "ཇི་ཙམ་གྱིས་ན་ཉོན་མོངས་པ་སྤངས་པ་ཞེས་བརྗོད་ཅེ་ན་རང་གི་རྒྱུད་ལ་ཡོད་པ་ནི་ཐོབ་པ་ཆད་པས་སོ།",
    "གཞན་གྱི་རྒྱུ་ལ་ཡོད་པ་ནི་ཉོན་མོངས་པ་དང་།",
    "དེ་ནི་དུས་ཐ་དད་པ་ཉིད་ཀྱིས་རིང་བ་ཡིན་གྱི་ཡུན་རིང་མོ་ཞིག་ན་བྱུང་བ་དང་།",
    "འདས་པ་དང་མ་འོངས་པ་དག་ལ་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "ཅི་ལམ་ཁྱད་པར་དུ་འགྲོ་བའི་ཕྱིར་ཉོན་མོངས་པ་རྣམས་ཀྱི་སྤངས་པ་ཡང་དང་ཡང་དུ་ཁྱད་པར་དུ་འགྱུར་རམ་ཞེ་ན།",
    "དེ་ནི་མེད་དེ་ཉོན་མོངས་པ་ཐམས་ཅད་ནི་ལན་ཅིག་ཏུ་ཟད།",
    "གང་གི་སྤོང་བའི་ལམ་གང་ཡིན་པ་དེ་ཁོ་ནས་དེ་ཟད་པ་ཡིན་ནོ།",
    "དེ་དག་གི་བྲལ་བའི་ཐོབ་པ་ཡང་དང་ཡང་།",
    "འབྲས་བུ་དག་ནི་དགེ་སྦྱོང་གི་ཚུལ་གྱི་འབྲས་བུ་བཞིའོ།",
    "དུས་དེ་དག་ཏུ་ཉོན་མོངས་པའི་བྲལ་བ་འཐོབ་བོ།",
    "དེ་ཡང་ཅི་རིགས་པར་ཁ་ཅིག་གིས་དུས་དྲུག་ཏུ་འཐོབ་པ་ནས་ཁ་ཅིག་གིས་ནི་དུས་གཉིས་ཀྱི་བར་དུ་འཐོབ་པར་བལྟ་བར་བྱའོ།",
    "དེ་ལ་རེ་ཞིག་འདོད་པ་ན།",
    "གཟུགས་མེད་པ་ལ་སྤྱོད་པའི་ཉོན་མོངས་པ་སྤོངས་པའི་རང་བཞིན་གང་དག་ཡིན་པའོ།",
    "འདོད་པ་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་སྤངས་པ་རྣམས་ནི་མི་ལྕོགས་པ་མེད་པའི་འབྲས་བུ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་སྤངས་པ་རེ་རེ་ཡོངས་སུ་ཤེས་པར་རྣམ་པར་མི་གཞག་ཅེ་ན།",
    "འདི་ལྟར་རེ་ཞིག་བཟོད་པའི་འབྲས་བུ་བྲལ་བ་ནི།",
    "རེ་ཞིག་སོ་སོའི་སྐྱེ་བོ་ལ་ནི་བྲལ་བའི་ཐོབ་པ་ཟག་པ་མེད་པ་དང་།",
    "སྲིད་པའི་རྩེ་མོ་ཉམས་པར་བྱེད་པ་མེད་པས་འདིའི་སྤངས་པ་ཡོངས་སུ་ཤེས་པ་ཞེས་བྱ་བའི་མིང་མི་ཐོབ་བོ།",
    "དེ་སྲིད་དུ་བྲལ་བའི་ཐོབ་པ་ཟག་པ་མེད་པ་ཡོད་མོད་ཀྱི།",
    "སྲིད་པའི་རྩེ་མོ་མཉམ་པར་བྱས་པ་ནི་མ་ཡིན་ནོ།",
    "སྡུག་བསྔལ་ལ་རྗེས་སུ་ཤེས་པ་ལ་ནི་གཉིས་ཡོད་མོད་ཀྱི།",
    "གང་གི་ཚེ་ཁམས་ལས་ཡང་དག་པར་འདའ་བ་ནའོ།",
    "རྣམ་པ་གང་ཞིག་སྤངས་ལ་གལ་ཏེ་དེ་ལ་དམིགས་པའི་ཉོན་མོངས་པ་གཞན་དང་བྲལ་བར་གྱུར་ནའོ་ཞེས་བྱ་བ་ནི།",
    "རེ་ཞིག་སོ་སོའི་སྐྱེ་བོ་མི་ལྡན་པ་ཁོ་ནའོ།",
    "དགྲ་བཅོམ་པ་དག་གི་ཡོངས་སུ་ཤེས་པ་གཅིག་ཁོ་ནར་རྣམ་པར་གཞག་གི་མང་དུ་ནི་མ་ཡིན་ཞེ་ན།",
    "ཡང་གང་ཞིག་གིས་ཡོངས་སུ་ཤེས་པ་དུ་ཞིག་ཡོངས་སུ་གཏོང་ངམ།",
    "གང་ལ་ལ་ཞིག་གིས་སྔོན་མེད་པ་འཐོབ་བོ།",
    "ཁ་ཅིག་གིས་ནི་དྲུག་སྟེ།",
    "ཉོན་མོངས་པ་རྣམས་མཐོང་བས་སྤང་བར་བྱ་བ་དང་།",
    "ཟག་པ་མེད་པ་བསྟན་པར་ཟག་མེད་ལམ་གྱི་བདེན་པ་དང་ཞེས་ལམ་གྱི་བདེན་པ་རང་གི་མིང་གིས་བསྟན་ཏོ།",
    "ཞེས་བྱ་བ་དེར་སྡུག་བསྔལ་དང་ཀུན་འབྱུང་གི་བདེན་པ་དག་བསྟན་ཏོ།",
    "ཅི་འདི་དག་གི་རིམ་པ་འདི་ཁོ་ན་ཡིན་ནམ་ཞེ་ན།",
    "དེ་དག་གི་རིམ་པ་ནི་འདི་ཡིན་ནོ།",
    "གང་གིས་གནོད་པ་བྱེད་པ་དང་།",
    "ཕྱིས་འདིའི་རྒྱུ་ནི་གང་ཞིག་ཡིན་ཞེས་ཀུན་འབྱུང་གི་བདེན་པ་ལ་ཡོངས་སུ་རྟོག་གོ།",
    "རྒྱུར་གྱུར་པ་རྣམས་ནི་ཀུན་འབྱུང་གི་བདེན་པ་ཡིན་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འདི་གཉིས་ནི་རྒྱུ་དང་འབྲས་བུར་གྱུར་པས་མིང་གི་སྒོ་ནས་བྱེ་བྲག་ཡོད་ཀྱི་རྫས་སུ་ནི་མ་ཡིན་ནོ།",
    "འདི་དག་ནི་ཕྱིན་ཅི་མ་ལོག་པའི་ཕྱིར་ཐམས་ཅད་ལ་བདེན་ན་འཕགས་པ་རྣམས་ཀྱིས་ནི་འདི་དག་ཇི་ལྟ་བ་དེ་ཁོ་ན་བཞིན་དུ་གཟིགས་ཀྱི་གཞན་དག་གིས་ནི་མ་ཡིན་པས་དེའི་ཕྱིར་འདི་དག་ནི་འཕགས་པ་རྣམས་ཀྱི་བདེན་པ་ཞེས་བྱ་བའི་ཕྱིན་ཅི་མ་ལོག་ཏུ་མཐོང་བའི་ཕྱིར་འཕགས་པ་མ་ཡིན་པ་རྣམས་ཀྱི་ནི་མ་ཡིན་ཏེ།",
    "གཞན་དག་ན་རེ་གཉིས་ནི་འཕགས་པ་རྣམས་ཀྱི་བདེན་པ་ཡིན་ལ།",
    "གང་གི་ཚེ་ཚོར་བའི་ཕྱོགས་གཅིག་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཡིན་པ་དེའི་ཚེ་ཇི་ལྟར་ན་འདུ་བྱེད་ཟག་པ་དང་བཅས་པ་ཐམས་ཅད་སྡུག་བསྔལ་ཞེས་བརྗོད་ཅེ་ན།",
    "དེ་དག་གིས་ཅི་རིགས་པར་འདུ་བྱེད་ཟག་པ་དང་བཅས་པ་ཐམས་ཅད་མ་ལུས་པར་སྡུག་བསྔལ་བ་ཡིན་ཏེ།",
    "སྡུག་བསྔལ་ནི་སྡུག་བསྔལ་གྱི་རང་གི་ངོ་བོ་ཁོ་ནས་སྡུག་བསྔལ་བ་ཉིད་དེ།",
    "གཞན་དག་ན་རེ་སྡུག་བསྔལ་ཉིད་སྡུག་བསྔལ་ཉིད་ཡིན་པས་སྡུག་བསྔལ་གྱི་སྡུག་བསྔལ་ཉིད་ཡིན་ལ།",
    "འདུ་བྱེད་ཐམས་ཅད་ནི་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་ཉིད་ཀྱིས་སྡུག་བསྔལ་བ་ཉིད་ལ་དེ་དག་ཀྱང་འཕགས་པ་རྣམས་ཁོ་ནས་གཟིགས་སོ།",
    "དེ་ཉིད་མིག་ཏུ་སོང་ན་ནི།",
    "ཇི་ལྟར་འཕགས་པ་རྣམས་སྲིད་པའི་རྩེ་མོ་བ་དག་ལ་ཡང་སྡུག་བསྔལ་གྱི་བློ་འཇུག་པ་ལྟར་བྱིས་པ་རྣམས་ནི་མནར་མེད་པའི་ཕུང་པོ་རྣམས་ལ་ཡང་དེ་ལྟར་སྡུག་བསྔལ་གྱི་བློ་མི་འཇུག་གོ།",
    "དེ་ལྟ་ན་འོ་ན་ནི་ལམ་ཡང་འདུས་བྱས་ཡིན་པའི་ཕྱིར་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "གང་གི་ཚེ་དེ་དག་མྱ་ངན་ལས་འདས་པ་ལ་ཞི་བར་ལྟ་བ་དེའི་ཚེ་ཡང་།",
    "གང་གི་ཚེ་འདི་དག་ལ་བདེ་བ་ཡང་ཡོད་པ་དེའི་ཚེ་ཅིའི་ཕྱིར་སྡུག་བསྔལ་ཁོ་ན་འཕགས་པའི་བདེན་པ་ཞེས་བྱ་ཞེ་ན།",
    "ཁ་ཅིག་ན་རེ་བདེ་བ་མྱོང་བའི་ཕྱིར་ཏེ།",
    "སྲིད་པ་ཐམས་ཅད་ནི་བདེ་བ་དང་བཅས་ཏེ་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་དུ་རོ་གཅིག་པའི་འཕགས་པ་རྣམས་ཀྱིས་སྡུག་བསྔལ་དུ་གཟིགས་ཏེ།",
    "དེའི་ཕྱིར་སྡུག་བསྔལ་ཁོ་ན་འཕགས་པའི་བདེན་པར་རྣམ་པར་གཞག་གི་བདེན་པ་ནི་མ་ཡིན་ནོ།",
    "དཔེར་ན་གཟུགས་དང་འདུ་ཤེས་ལ་སོགས་པ་ལ་ཡང་སྡུག་བསྔལ་དུ་ལྟ་མོད་ཀྱི།",
    "གང་ཞིག་སྡུག་བསྔལ་གྱི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ་སྙམ་དུ་སེམས་པ་དེའི་དེ་ནི་ཀུན་འབྱུང་གི་རྣམ་པ་ཡིན་གྱི་སྡུག་བསྔལ་གྱི་རྣམ་པ་ནི་མ་ཡིན་ནོ།",
    "གཟུགས་དང་གཟུགས་མེད་པར་སྐྱེས་པ་དག་གིས་འཕགས་པ་རྣམས་ལ་ཡང་ཇི་ལྟར་སྡུག་བསྔལ་གྱི་འདུ་ཤེས་འཇུག་པར་འགྱུར་ཏེ།",
    "ཁ་ཅིག་ན་རེ་བདེ་བའི་ཚོར་བ་ཞེས་བྱ་བ་ནི་མེད་པ་ཉིད་དེ།",
    "དེ་ལྟ་བས་ན་མི་མཁས་པ་རྣམས་ནི་གཉེན་པོ་ཁོ་ན་ལ་བདེ་བའི་བློ་འཇུག་གི་བདེ་བ་ལ་ནི་མ་ཡིན་ནོ།",
    "རེ་ཞིག་བདེ་བ་ལ་སྐུར་བ་འདེབས་པ་དེ་ལ་འདི་དྲི་བར་བྱ་སྟེ།",
    "ཚོར་བ་གང་ཞིག་རང་གི་མཚན་ཉིད་ཀྱིས་འདོད་པ་དེ་ནི་ནམ་ཡང་དེ་ཁོ་ནས་མི་འདོད་པར་མི་འགྱུར་ཏེ།",
    "འདི་ལྟར་འཕགས་པ་རྣམས་ནི་འདི་གང་གིས་ན་མི་བཞེད་པར་འགྱུར་བ་རྣམ་པ་གཞན་གྱིས་རྣམ་པར་སུན་འབྱིན་པར་བྱེད་ཅིང་།",
    "མི་རྟག་པར་ལྟའི་རང་གི་མཚན་ཉིད་ཀྱི་རྣམ་པས་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་འདི་རང་གི་མཚན་ཉིད་ཀྱིས་མི་འདོད་པ་ཞིག་ཡིན་པར་གྱུར་ན་ནི་དེ་ལ་སུ་ཡང་འདོད་ཆགས་སྐྱེ་བར་མི་འགྱུར་བ་ཞིག་ན།",
    "གང་གི་ཕྱིར་འདོད་ཆགས་དང་བྲལ་བའི་ཆེད་དུ་རྣམ་པ་གཞན་གྱིས་ཀྱང་སྐྱོན་ཅན་དུ་ལྟ་བར་འགྱུར་ཏེ།",
    "དེ་ལྟ་བས་ན་བདེ་བའི་ཚོར་བ་ནི་རང་གི་མཚན་ཉིད་ཀྱིས་ཡོད་པ་ཁོ་ནའོ།",
    "བདེ་བ་ཡང་མ་ལགས་སྡུག་བསྔལ་བ་ཡང་མ་ལགས་བ་དང་ཚོར་བ་འདི་གསུམ་ཡང་གསུངས་ལ།",
    "དེ་ལྟ་བས་ན་ཚོར་བ་གསུམ་ནི་རང་གི་ངོ་བོས་ཡོད་ལ།",
    "དེ་རང་གི་ངོ་བོས་བདེ་ཞེས་བྱ་བ་འདི་ཇི་ལྟར་ཁོང་དུ་ཆུད་ཅེ་ན།",
    "གལ་ཏེ་ཚོར་བ་ཐམས་ཅད་རང་གི་ངོ་བོ་ཁོ་ནས་སྡུག་བསྔལ་བ་ཡིན་པར་འགྱུར་ན་ཚོར་བ་གསུམ་ཞེས་གསུངས་པ་ལ་ཡོན་ཏན་ཅི་ཞིག་ཡོད་པར་འགྱུར།",
    "གང་གི་ཚེ་དྲི་དང་རོ་དང་རེག་བྱའི་ཁྱད་པར་ལས་སྐྱེས་པའི་བདེ་བ་སང་བ་དེའི་ཚེ་གང་ལ་འདི་བདེ་བའི་བློར་འགྱུར་བ་སྡུག་བསྔལ་ཆུང་ངུར་གྱུར་པ་ཡང་གང་ཞིག་ཡིན།",
    "གང་ཡང་གཉེན་པོ་ལ་བདེ་བའི་བློ་སྐྱེ་ཞེས་སྨྲས་པ་དེ་ལ་ཡང་གང་གི་ཚེ་དྲི་ལ་སོགས་པའི་ཁྱད་པར་ལས་སྐྱེས་པའི་བདེ་བ་མྱོང་བ་དེའི་ཚེ་གང་གིས་གཉེན་པོ་ལ་བདེ་བའི་བློར་འགྱུར།",
    "ས་བོན་དང་ཞིང་གི་དངོས་པོར་སྟོན་པར་མཛད་པས་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་ལ་ཡང་གསུངས་སོ།",
    "ཁམས་དང་འགྲོ་བ་དང་སྐྱེ་གནས་ལ་སོགས་པའི་བྱེ་བྲག་གིས་ལུས་སྐྱེ་བ་ནི་སྐྱེ་བ་ཡིན་ལ།",
    "དཔེར་ན་ས་བོན་སཱ་ལུ་དང་ནས་ལ་སོགས་པའི་རིགས་ཀྱི་བྱེ་བྲག་གིས་མྱུ་གུ་སྐྱེ་བའི་རྒྱུ་ཡིན་ལ།",
    "ཇི་ལྟར་སྲིད་པས་འདག་པའི་ཆ་ལ་སྲན་ཆུང་གི་ཕྱེ་མའི་ལྡེ་གུ་བསྐམས་པས་ལུས་བཟུང་བ་བཞིན་དུ་ལུས།",
    "ཀུན་དུ་བཟུང་བ་དེ་ལྟར་ནི་གང་གིས་ཀྱང་ལུས་ཀུན་དུ་མ་བཟུང་སྟེ།",
    "དེ་ལ་ནི་གྱོ་མོར་བཅོམ་ན་བུམ་པའི་བློ་མི་འཇུག་གོ།",
    "སྔོན་གྱི་སློབ་དཔོན་རྣམས་ན་རེ།",
    "ཤེས་རབ་འདི་དག་གི་མཚན་ཉིད་ཅི་ཞེ་ན།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ན་རེ་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ནི་མིང་ལ་དམིགས་པ་ཡིན་ལ།",
    "རེས་འགའ་ནི་ཡི་གེས་དོན་འདྲེན་པར་བྱེད་དོ།",
    "ཅུང་ཟད་ལོབས་པ་ནི་རེས་འགའ་ནི་གཏོང་རེས་འགའ་ནི་འཇུ་བར་བྱེད་དོ།",
    "གཞན་དག་ན་རེ་རྟོག་པ་འདི་ལ་ནི་མིང་ལ་དམིགས་པ་གང་ཡིན་པ་དེ་ནི་ཐོས་པ་ལས་བྱུང་བ་ཡིན་པར་འགྱུར་ལ།",
    "འདོད་ཆེན་ཅན་ལས་བཟློག་པ་ནི་དེ་དག་གི་གཉེན་པོ་ཆོག་ཤེས་པ་དང་།",
    "དེ་དག་གི་གཉེན་པོར་འཕགས་པའི་རིགས་བཞི་བསྟན་ཏོ།",
    "བདག་གི་བདག་འཛིན་དངོས་འདོད་པ།",
    "དེ་ལ་འཕགས་པའི་རིགས་གསུམ་ནི་བདག་གིར་འཛིན་པའི་དངོས་པོ་འདོད་པ་དེའི་དུས་སུ་ཞི་བར་བྱེད་པ་ཡིན་ནོ།",
    "ཁ་ཅིག་ན་རེ་འདི་ནི་སྣ་ཚོགས་ལ་མི་དམིགས་པའི་ཕྱིར་རྣམ་པར་རྟོག་པ་གཅོད་པར་བྱེད་པ་ཡིན་གྱི།",
    "གཞན་དག་ན་རེ་ཁ་ཕྱིར་མ་བལྟས་པའི་ཕྱིར་ཏེ།",
    "མི་སྡུག་པ་ནི་མིག་གི་རྣམ་པར་ཤེས་པ་བཞིན་དུ་ཁ་ཕྱིར་བལྟས་པ་ཡིན་ཏེ།",
    "ཁ་དོག་གི་འདོད་ཆགས་དང་།",
    "རེག་པའི་འདོད་ཆགས་དང་།",
    "མོས་པ་དང་ཉི་ཚེ་བ་ཡིད་ལ་བྱེད་པ་ཡིན་པའི་ཕྱིར་མི་སྡུག་པས་ཉོན་མོངས་པ་སྤོང་བ་ནི་མ་ཡིན་གྱི་རྣམ་པར་གནོན་པ་ནི་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་མོས་པ་བསྐྱེད་པའི་ཕྱིར་གཉིས་པ་ལ་མོས་པར་བྱེད་པ་ནས་གཙུག་ལག་ཁང་དང་།",
    "ཞིང་དང་རིམ་གྱིས་རྒྱ་མཚོའི་མཐས་ཀླས་པའི་བར་གྱིས་གཞི་རུས་པའི་ཀེང་རུས་ཀྱིས་གང་བར་མོས་པར་བྱེད་དོ།",
    "ཡང་སྡུད་པ་ན་སེམས་བསྡུ་བའི་ཕྱིར་བདག་གཅིག་པུ་ཁོ་ན་ལ་རུས་པའི་ཀེང་རུས་སུ་མོས་པའི་བར་དུ་སྡུད་དེ།",
    "སྦྱང་བ་བྱས་པ་དག་རང་གི་ལུས་དང་རྒྱ་མཚོའི་མཐའ་ཀླས་པ་ལ་དམིགས་པའི་ཕྱིར་རོ།",
    "དེར་ཡང་བྱང་གི་སྒྲ་མི་སྙན་དུ་ནི་མ་ཡིན་ནོ།",
    "མོས་པ་ཡིད་ལ་བྱེད་པ་ཡིན་པའི་ཕྱིར་ཟག་པ་དང་བཅས་པ་ཡིན་ནོ།",
    "ལྷ་དང་མི་དག་གི་ནང་ནས་སྐྱེད་དོ།",
    "འཇོག་པ་ཞེས་བྱ་བ་ནི་ནོར་བུའི་ཐག་པ་བཞིན་དུ་སྣའི་རྩེ་མོ་ནས་རྐང་པའི་མཐེ་བོང་གི་བར་དུ་གནས་པར་ལྟ་ཞིང་།",
    "གཞན་དག་ན་རེ་བསྒྱུར་བ་ནི་དྲན་པ་ཉེ་བར་གཞག་པ་ནས་རྡོ་རྗེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་གྱི་བར་ཡིན་ལ།",
    "དེ་གཉིས་ནི་རང་གི་ས་པ་དང་ས་གོང་མ་པའི་སེམས་ཀྱིས་རྟོགས་ཀྱི།",
    "དེ་དག་གི་རང་གི་མཚན་ཉིད་ནི་རང་གི་ངོ་བོའོ།",
    "ལུས་ཀྱི་རང་གི་ངོ་བོ་ཅི་ཞེ་ན།",
    "དེ་དག་གི་དམིགས་པ་ནི་དམིགས་པའི་དྲན་པ་ཉེ་བར་གཞག་པའོ།",
    "འདི་ལྟར་ནང་གི་ལུས་ལ་ལུས་ཀྱི་རྗེས་སུ་ལྟ་ཞིང་གནས་སོ་ཞེས་ཀྱང་གསུངས་ཏེ།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ན་རེ་དྲན་པ་ཤས་ཆེ་བའི་ཕྱིར་ཏེ།",
    "ཤིང་གཤེགས་པའི་ཁྱེའུ་དག་གིས་འཛིན་པ་ལྟར་དྲན་པའི་སྟོབས་བསྐྱེད་པས་འཇུག་པ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ་ཞེས་ཟེར་རོ།",
