    "བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ན་རེ་དེ་ནི་དེ་ལས་གཞན་པ་སྐྱེ་བའི་སྲིད་པ་བདུན་དང་སྲིད་པ་བར་མ་བདུན་དུ་མི་རྣམས་ཀྱི་ནང་དུ་ཉིང་མཚམས་སྦྱོར་བར་བྱེད་ལ་དེ་བཞིན་དུ་ལྷ་དག་གི་ནང་དུ་ཡང་ཉིང་མཚམས་སྦྱོར་བར་བྱེད་དོ།",
    "ལྷ་དང་མི་དག་གི་ནང་ནས་སོར་ལན་བདུན་སྐྱེའི་གཉི་གའི་ནང་དུ་ལན་བདུན་མ་ཡིན་པ་ཉིད་དོ་ཞེས་བྱ་བ་འདི་ལ་ཡང་ཤེས་པར་བྱེད་པ་ཅི་ཞིག་ཡོད་དེ།",
    "གང་ཞིག་མི་དག་གི་ནང་དུ་རྒྱུན་དུ་ཞུགས་པར་གྱུར་པ་དེ་ནི་དེ་ཁོ་ནར་འོངས་ནས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ལ།",
    "གང་ཞིག་ལྷ་དག་གི་ནང་དུ་རྒྱུན་དུ་ཞུགས་པར་གྱུར་པ་དེ་ནི་དེ་ཁོ་ནར་འོངས་ནས་ཡོངས་སུ་མྱ་ངན་ལས་འདའོ།",
    "གཞན་དག་ན་རེ།",
    "ངན་སོང་དུ་ངེས་པའི་ལས་ཡོད་ན་ནི་དེས་བཟོད་པ་ཡང་བསྐྱེད་པར་མི་འགྱུར་རོ།",
    "མཆོག་ཏུ་ཐོགས་ན་ལན་བདུན་པ་གཞན་ཡང་ཡོད་མོད་ཀྱི་མ་ངེས་པས་མི་བརྗོད་དོ།",
    "རེ་ཞིག་འབྲས་བུ་ལ་གནས་པ་བསྒོས་པས་སྤང་བར་བྱ་བ་མ་ཟད་པ་མཆོག་ཏུ་ཐོགས་ན་ལན་བདུན་པ་ནི་དེ་ལྟ་བུ་ཡིན་ནོ།",
    "ཉོན་མོངས་པ་སྤང་བ་ལས་ནི་ཉོན་མོངས་པའི་རྣམ་པ་གསུམ་མམ་བཞི་སྤང་བའི་ཕྱིར་རོ།",
    "དེའི་རྣམ་པ་གཅིག་གིས་ནི་བར་ཆད་གཅིག་པའི་བཞིན་དུ་འབྲས་བུ་ལ་བགེགས་བྱ་བར་མི་ནུས་ཏེ།",
    "ལྷའི་རིགས་ནས་རིགས་སུ་སྐྱེ་བ་ནི་ལྷ་དག་གི་ནང་དུ་རིགས་གཉིས་སམ་གསུམ་དུ་འཁོར་ནས་ལྷའི་རིགས་དེའམ་གཞན་དུ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བ་གང་ཡིན་པའོ།",
    "མིའི་རིགས་ནས་རིགས་སུ་སྐྱེ་བ་ནི་མི་དག་གི་ནང་དུ་རིགས་གཉིས་སམ་གསུམ་དུ་འཁོར་ནས་གླིང་དེའམ་གཞན་དུ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བ་གང་ཡིན་པའོ།",
    "འབྲས་བུ་ལ་གནས་པ་གང་གིས་རྣམ་པ་གཅིག་ནས་ལྔའི་བར་དུ་སྤངས་པ་ཡིན་ན་དེའི་འབྲས་བུ་གཉིས་པ་ལ་ཞུགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ལྷ་དག་གི་ནང་དུ་སོང་ནས་མིའི་འཇིག་རྟེན་དུ་ལན་ཅིག་ཕྱིར་འོང་བའི་ཕྱིར་འོང་བ་སྟེ།",
    "ཉོན་མོངས་པའི་རྣམ་པ་བདུན་ནམ་བརྒྱད་སྤངས་པའི་ཕྱིར་དང་།",
    "ཇི་ལྟར་ན་འདིའི་རྣམ་པ་གཅིག་གིས་འབྲས་བུ་ལ་བགེགས་བྱེད་པར་ནུས་ཤེ་ན།",
    "དེའི་མྱ་ངན་ལས་འདའ་བ་ལ་ཚེ་གཅིག་གིས་ཆོད་པའི་ཕྱིར་རམ།",
    "ཕྱིར་མི་འོང་བའི་འབྲས་བུ་ལ་ཉོན་མོངས་པའི་རྣམ་པ་གཅིག་གིས་ཆོད་པའི་ཕྱིར་འདི་ལ་བར་ཆད་གཅིག་ཡོད་པས་ན་བར་ཆད་གཅིག་པ་ཡིན་ནོ།",
    "གཞན་དག་ན་རེ་དེ་ཡང་ཕུང་པོའི་ལྷག་མ་མེད་པས་སོ་ཞེས་ཟེར་རོ།",
    "གཞན་དག་ན་རེ་འདུས་བྱས་དང་འདུས་མ་བྱས་པ་ལ་དམིགས་པའི་ལམ་གྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བའི་ཕྱིར་རོ་ཞེས་ཟེར་རོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འབྲས་བུའི་སྒོ་ནས་ནི་འོག་མིན་དང་སྲིད་པའི་རྩེ་མོ་ལ་ཐུག་པའི་ཕྱིར་རོ།",
    "དེ་ལ་གང་གིས་བསམ་གཏན་སྤེལ་བ་དེ་ནི་འོག་མིན་དུ་སོང་ནས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པའོ།",
    "དེ་ནས་ཤི་འཕོས་ནས་འོག་མིན་པ་དག་གི་ནང་དུ་སྐྱེ་བ་གང་ཡིན་པ་སྟེ།",
    "འཕགས་པ་ནི་ཚངས་ཆེན་པ་དག་གི་ནང་དུ་མི་སྐྱེ་སྟེ།",
    "རེ་ཞིག་བསམ་གཏན་སྤེལ་ནས་འོག་མིན་དུ་འགྲོ་བ་ནི་དེ་ལྟ་བུ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ལས་གཞན་སྲིད་རྩེ་མོར་འགྲོ།",
    "དེ་ནི་སྙོམས་པར་འཇུག་པ་གཞན་རྣམས་རེ་མྱོང་བར་བྱེད་ཅིང་གནས་གཞན་ཐམས་ཅད་དུ་སྐྱེ་ལ།",
    "གནས་གཙང་མ་རྣམས་སུ་མི་འཇུག་པ་ཁོ་ནར་གཟུགས་མེད་པར་སྐྱེ་བའི་རིམ་གྱིས་སྲིད་པའི་རྩེ་མོར་སོང་སྟེ།",
    "འོག་མིན་དང་སྲིད་པའི་རྩེ་མོའི་མཐར་ཐུག་པ་ཉིད་ནི་ཕན་ཆད་དུ་འགྲོ་བ་མེད་པའི་ཕྱིར་ཏེ།",
    "རེ་ཞིག་དེ་དག་ནི་གཟུགས་སུ་ཉེ་བར་འགྲོ་བའི་ཕྱིར་མི་འོང་བ་ལྔ་ཡིན་ནོ།",
    "གཟུགས་ཀྱི་འདོད་ཆགས་དང་བྲལ་བ་འདི་ནས་ཤི་འཕོས་ནས་གཟུགས་མེད་པ་དག་གི་ནང་དུ་སྐྱེ་བ་གང་ཡིན་པའོ།",
    "དེ་ཡང་སྐྱེས་ནས་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་རྣམ་པ་བཞི་སྟེ།",
    "རེ་ཞིག་བར་མ་དོར་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བ་ནི་དཔེ་གསུམ་གྱིས་མྱུར་བ་དང་།",
    "ཡུན་རིང་མོ་ཞིག་ནས་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བའི་ཕྱིར་རོ།",
    "ཡུན་རིང་མོ་ཞིག་ནས་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བའི་ཕྱིར་རོ།",
    "དེ་དག་གི་ནི་ཁྱད་པར་རྣམས།",
    "ཕྱིར་མི་འོང་བ་གསུམ་དང་དགུ་པོ་དེ་དག་གི་ཁྱད་པར་ནི་ལས་དང་།",
    "ཉོན་མོངས་པ་ཀུན་ཏུ་སྤྱོད་པ་ཆུང་བ་དང་།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དེ་དག་སོ་སོའི་ཁྱད་པར་ཡང་ཅི་རིགས་པར་གསུམ་ཚན་དང་པོ་གཉིས་ནི་གོང་མ་བཞིན་དུ་ཉོན་མོངས་པ་དང་།",
    "འདིར་ནི་གང་དག་ལ་རྣམ་གྲངས་མེད་པར་ཡོད་པ་དེ་དག་གི་སྐབས་ཡིན་ནོ།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ན་རེ་འདོད་པའི་ཁམས་ལས་འདའ་བར་དཀའ་བའི་ཕྱིར་ཏེ།",
    "དགེ་སྦྱོང་གི་ཚུལ་གྱི་འབྲས་བུ་གཉིས་སམ་གསུམ་ཐོབ་པ་དང་།",
    "གང་གི་ཚེ་སྐད་ཅིག་མ་གཉིས་ཟག་པ་མེད་པ་ལ་སྙོམས་པར་འཇུག་ཅིང་སྐད་ཅིག་མ་གཉིས་ཟག་པ་དང་བཅས་པ་ལ་སྙོམས་པར་འཇུག་ལ་ཡང་ཟག་པ་མེད་པ་ལ་སྙོམས་པར་འཇུག་གོ་ཞེས་གྲག་སྟེ།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ན་རེ་གང་གི་ཚེ་ཟག་པ་མེད་པའི་སྐད་ཅིག་མའི་མཇུག་ཐོགས་སུ་ཟག་པ་དང་བཅས་པ་མངོན་སུམ་དུ་བྱེད་ཅིང་།",
    "ཉོན་མོངས་པས་ནི་འཇིག་ཕྱིར་ཡང་།",
    "ཤིན་ཏུ་ཆེས་ཆེ་བའི་བྱེ་བྲག་གིས་རྣམ་པ་ལྔ་ཡིན་ཏེ།",
    "ཐོབ་པ་དང་ཤེས་པས་མངོན་སུམ་དུ་བྱེད་པ་དག་གིས་མངོན་སུམ་དུ་གྱུར་པ་ནི་མངོན་དུ་བྱེད་པ་ཡིན་ནོ།",
    "འདི་ནི་རེ་ཞིག་ཕྱིར་མི་འོང་བ་རྣམས་ཀྱི་དབྱེ་བ་ཆེ་ལོང་ཡིན་ནོ།",
    "དེ་དག་ཉིད་སའི་བྱེ་བྲག་གིས་བཞིའོ།",
    "གནས་གཞན་གྱི་བྱེ་བྲག་གིས་བཅུ་དྲུག་གོ།",
    "ས་དང་འདོད་ཆགས་དང་བྲལ་བའི་བྱེ་བྲག་གིས་སུམ་ཅུ་རྩ་དྲུག་སྟེ།",
    "རིགས་རེ་རེ་ལ་འཆིང་བ་མཐའ་དག་དང་ལྡན་པ་ནས་རང་གི་གནས་ཀྱི་རྣམ་པ་བརྒྱད་ལས་འདོད་ཆགས་དང་བྲལ་བའི་བར་གང་ཟག་དགུ་དགུ་སྟེ།",
    "སྲིད་པའི་རྩེ་མོའི་རྣམ་པ་བརྒྱད་ཀྱི་བར་སྤངས་པས་དགྲ་བཅོམ་པ་ཉིད་ལ་ཞུགས་པ་ཡིན་ནོ།",
    "དེ་སྲིད་པའི་རྩེ་མོའི་རྣམ་པ་དགུ་པ་སྤོང་བར་བྱེད་པའི་བར་ཆད་མེད་པའི་ལམ་ལ་གནས་པ་ན།",
    "མི་ལྕོགས་པ་མེད་པས་བསྡུས་པ་སྲིད་པའི་རྩེ་མོའི་སྡུག་བསྔལ་དང་ཀུན་འབྱུང་ལ་དམིགས་པས་སྡུག་བསྔལ་དང་ཀུན་འབྱུང་ལ་རྗེས་སུ་ཤེས་པའི་རྣམ་པ་དག་དང་མཚུངས་པར་ལྡན་པ་བརྒྱད་དང་།",
    "འགོག་པ་ལ་རྗེས་སུ་ཤེས་པའི་རྣམ་པ་དག་དང་མཚུངས་པར་ལྡན་པ་བསམ་གཏན་དང་པོའི་འགོག་པ་ལ་དམིགས་པ་བཞི་ནས་དེ་བཞིན་དུ་སྲིད་པའི་རྩེ་མོའི་འགོག་པ་ལ་དམིགས་པའི་བར་དུ་བཞི་དང་།",
    "དེ་དག་ནི་ཤེས་པའི་དམིགས་པ་དང་རྣམ་པའི་བྱེ་བྲག་གིས་ཐ་དད་པའི་ཕྱིར་རྡོ་རྗེ་ལྟ་བུ་ལྔ་བཅུ་རྩ་གཉིས་ཡིན་ནོ།",
    "གང་དག་ལམ་ལ་རྗེས་སུ་ཤེས་པ་ཡང་ས་རེ་རེའི་གཉེན་པོ་ལ་དམིགས་པ་ཡིན་པར་འདོད་པ་དེ་དག་གི་ལྟར་ན་ཉི་ཤུ་རྩ་བརྒྱད་ལྷག་པར་བསྣན་ནས་མི་ལྕོགས་པ་མེད་པས་བསྡུས་པ་རྡོ་རྗེ་ལྟ་བུ་ནི་བརྒྱད་ཅུ་ཡིན་ཏེ།",
    "མིང་གི་སྒོ་ནས་ནི་བརྒྱད་ཡིན་ནོ།",
    "སློབ་པ་འདི་གང་གིས་གང་ལས་འདོད་ཆགས་དང་བྲལ་བ་འཐོབ་ཅེ་ན།",
    "རང་གི་ས་པའི་གཉེན་པོ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་ཉོན་མོངས་པ་རྒྱས་པར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "ཉོན་མོངས་པ་གང་ཞིག་དངོས་པོ་གང་ལ་རྒྱས་པར་འགྱུར་བ་དེ་ནི་དངོས་པོ་དེས་སྤོང་བར་བྱེད་པ་མ་ཡིན་ལ།",
    "གང་གི་གཉེན་པོ་གང་ཡིན་པ་དེ་ལ་ནི་ཉོན་མོངས་པ་དེ་རྒྱས་པར་ཡང་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྲིད་པའི་རྩེ་མོ་ལས་གཞན་པའི་ས་ཐམས་ཅད་ལས་ནི་འཇིག་རྟེན་པའི་ལམ་གྱིས་ཀྱང་འདོད་ཆགས་དང་བྲལ་ལ།",
    "གཞན་དག་ན་རེ་འཇིག་རྟེན་ལས་འདས་པས་ཀྱང་དེ་དང་འདྲའོ་ཞེས་ཟེར་རོ།",
    "བཏང་ལ་ཉོན་མོངས་མི་ལྡན་ཕྱིར།",
    "འབྲས་བུའི་ལམ་འབའ་ཞིག་ཐོབ་པའི་ཕྱིར་ས་གོང་མ་པའི་ཉོན་མོངས་པའི་བྲལ་བ་དང་མི་ལྡན་པར་ཡང་འགྱུར་ལ།",
    "དེ་བཏང་ན་ཡང་ཉོན་མོངས་པ་དེ་དག་དང་ལྡན་པར་ཡང་འགྱུར་རོ།",
    "དཔེར་ན་སྲིད་པའི་རྩེ་མོའི་རྣམ་པ་ཕྱེད་ལ་རྣམ་པར་གྲོལ་བ་ལ་དེའི་བྲལ་བའི་འཐོབ་པ་འཇིག་རྟེན་པ་ཡང་མེད་ལ།"
  ]
}