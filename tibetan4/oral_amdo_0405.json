    "ཐམས་ཅད་དུ་ནི་འགྲོ་བ་མ་ཡིན་པ་རྣམས་ནི་དམིགས་པའི་སྒོ་ནས་རང་གི་སར་རང་གི་རིས་ཁོ་ན་ལ་རྒྱས་པར་འགྱུར་གྱི་གཞན་དུ་ནི་མ་ཡིན་ཏེ།",
    "དེ་དག་གི་དམིགས་པའི་དངོས་པོ་ནི།",
    "བདག་གིར་མ་བྱས་གཉེན་པོའི་ཕྱིར།",
    "དངོས་པོ་གང་ཞིག་བདག་ཏུ་ལྟ་བ་དང་སྲེད་པ་དག་གིས་བདག་གིར་བྱས་པ་དེ་ལ་ཕྲ་རྒྱས་གཞན་དག་ཀྱང་རྒྱས་པར་འགྱུར་བར་ནུས་ཏེ།",
    "མྱ་ངན་ལས་འདས་པ་དང་ལམ་ནི་དེ་དག་ལ་དམིགས་པའི་ཉོན་མོངས་པ་རྣམས་ཀྱི་གཉེན་པོར་གྱུར་པ་ཡིན་ལ།",
    "རྡོ་བསྲེག་པ་ལ་རྐང་མཐིལ་དག་གི་གནས་མི་མཐོང་བ་བཞིན་ནོ།",
    "གཞན་དག་ན་རེ་ཕྲ་རྒྱས་ཀྱི་དོན་ནི་རྗེས་སུ་མཐུན་པའི་དོན་ཡིན་ན་དེ་དག་ནི་དེ་རྣམས་ཀྱི་རྗེས་སུ་མཐུན་པ་མ་ཡིན་ཏེ།",
    "རེ་ཞིག་གཟུགས་དང་གཟུགས་མེད་པ་ན་སྤྱོད་པ་ཐམས་ཅད་ནི་ལུང་དུ་མ་བསྟན་པ་ཁོ་ན་ཡིན་ནོ།",
    "གཞན་ཡང་ལྟ་བ་འདི་གཉིས་ནི་རང་གི་རྫས་ལ་ཀུན་དུ་རྨོངས་པའི་ཕྱིར་དང་།",
    "ངའོ་སྙམ་པའི་ང་རྒྱལ་དག་ཀྱང་དེ་ལྟར་ཐལ་བར་འགྱུར་རོ།",
    "སྔོན་གྱི་སློབ་དཔོན་རྣམས་ན་རེ།",
    "ཁ་ཆེ་བ་རྣམས་ན་རེ་སྲེད་པ་དང་མ་རིག་པ་དང་ཤེས་རབ་ཐ་ན་རྣམ་པ་སྨིན་པ་ལས་སྐྱེས་པ་ཡང་རུང་སྟེ།",
    "ཉོན་མོངས་པ་དང་བཅས་པ་རྣམས་ནི་སྐྱེ་བར་འགྱུར་གྱི་ཉོན་མོངས་པ་མེད་པ་རྣམས་ནི་མ་ཡིན་ནོ་ཞེས་རྣམ་པར་ཕྱེ་སྟེ་ལུང་བསྟན་པར་བྱའོ།",
    "འོན་ཏེ་ངན་སོང་རྣམས་ལས་ལྟོས་ཏེའོ་ཞེས་ཟེར་ན་ནི་ཁྱད་པར་དུ་འཕགས་སོ་ཞེས་ལུང་བསྟན་པར་བྱའོ།",
    "མོ་གཤམ་གྱི་བུ་སྔོ་བསངས་སམ་དཀར་ཤམ་ཞེས་བྱ་བ་བཞིན་ནོ།",
    "གཞན་དག་ན་རེ་ཐམས་ཅད་སྐྱེ་བར་མི་འགྱུར་རོ་ཞེས་བྱ་བ་འདི་ཡང་མགོ་གཅིག་ཏུ་ལུང་བསྟན་པར་བྱ་བ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་བྱེ་བྲག་གིས་རྣམ་པ་གཉིས་ཡོད་ན་ཞེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པ་རྣམ་པར་ཕྱེ་སྟེ་བརྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "གལ་ཏེ་འདི་སྐད་དུ་ཚེ་དང་ལྡན་པ་བདག་གིས་ནི་རིག་པ་བདག་ཡིན་པར་ཤེས་སོ་ཞེས་ཟེར་ན།",
    "གང་ཟག་གང་གི་ཕྲ་རྒྱས་གང་ཞིག་དམིགས་པ་གང་ལ་རྒྱས་པར་འགྱུར་བ་འདི་ནི་དེས་དེ་དང་ལྡན་པ་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་པའི་ཉོན་མོངས་པ་ནི་འདོད་ཆགས་དང་།",
    "ཉོན་མོངས་པ་སྤྱི་པ་ནི་ལྟ་བ་དང་།",
    "དེ་ལ་རེ་ཞིག་འདས་དང་ཉེར་གནས་འདོད་ཆགས་དང་།",
    "ཁོང་ཁྲོ་ང་རྒྱལ་དག་གིས་ནི།",
    "ང་རྒྱལ་རྣམས་སྐྱེས་ལ་མ་སྤངས་པ་དེ་དག་གི་དངོས་པོ་དེ་དང་ལྡན་ཏེ།",
    "ཡིད་དག་གི་ཡུལ་ནི་དུས་གསུམ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདོད་ཆགས་དང་ཁོང་ཁྲོ་བ་གཞན་དག་གིས་ནི་མ་འོངས་པའི་དངོས་པོ་ཁོ་ན་དང་ལྡན་ནོ།",
    "གང་གི་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་པོའི་འདོད་ཆགས་དང་།",
    "ཉོན་མོངས་པ་སྤྱི་དང་ལྡན་པ་ཡིན་པའི་ཕྱིར་དུས་གསུམ་པའི་དངོས་པོ་མེད་པའི་དངོས་པོ་ཐམས་ཅད་ལྡན་ནོ།",
    "གང་གི་ཕྱིར་འདས་པའི་གཟུགས་ཡོད་པ་དེའི་ཕྱིར་འཕགས་པ་ཉན་ཐོས་ཐོས་པ་དང་ལྡན་པ་འདས་པའི་གཟུགས་ལ་མི་ལྟ་བ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་མ་འོངས་པའི་གཟུགས་ཡོད་པ་ཞེས་རྒྱས་པར་གསུངས་སོ།",
    "རེ་ཞིག་ལུང་ལས་འདས་པ་དང་མ་འོངས་པ་ཡོད་པ་ནི་དེ་ལྟ་བུ་ཡིན་ནོ།",
    "གང་དག་འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་བྱུང་བ་ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་དེ་དག་གི་ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་ཡིན་གྱི།",
    "དཔེར་ན་སྐྱེས་བུ་བུད་མེད་དག་ཅིག་ལ་ཆགས་པ་ལྷག་མ་རྣམས་ལ་འདོད་ཆགས་དང་བྲལ་བ་མ་ཡིན་པ་བཞིན་ནོ་ཞེས་ཟེར་རོ་ཞེས་གྲག་གོ།",
    "དཔེར་ན་རི་ལུ་གཅིག་གཅིག་གི་ཤོད་མིག་ཏུ་གཞག་ན་གཅིག་ཅེས་བྱ།",
    "སྟོང་གི་ཤོད་མིག་ཏུ་གཞག་ན་སྟོང་ཞེས་བྱ་བ་བཞིན་ནོ་ཞེས་ཟེར་རོ་ཞེས་གྲག་གོ།",
    "དཔེར་ན་བུད་མེད་གཅིག་ལ་མ་ཞེས་ཀྱང་བྱ།",
    "བུ་མོ་ཞེས་ཀྱང་བྱ་བ་བཞིན་ནོ་ཞེས་ཟེར་རོ་ཞེས་གྲག་སྟེ།",
    "སྐྱེས་བུ་ཞིག་བུད་མེད་ལ་ལ་ནི་འདོད་ཆགས་ཀུན་དུ་འབྱུང་ལ།",
    "གང་གི་ཚེ་བྱེད་པ་དེའི་ཚེ་ནི་ད་ལྟར་བྱུང་བ་ཡིན།",
    "གང་གི་ཚེ་བྱས་ནས་འགགས་པ་དེའི་ཚེ་ནི་འདས་པ་ཡིན་ནོ་ཞེས་གྲག་གོ།",
    "འོ་ན་ནི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ལ་སོགས་པ་འདས་པ་རྣམས་ཀྱང་འབྲས་བུ་འབྱིན་པའི་ཕྱིར་བྱ་བའམ་བྱ་བ་བྱེད་དུ་ཐལ་བར་འགྱུར་བས་མཚན་ཉིད་འཆོལ་བར་འགྱུར་རོ།",
    "གང་གིས་ན་རེས་འགའ་ནི་བྱ་བ་བྱེད་ལ་རེས་འགའ་ནི་མ་ཡིན་ཞེས་བྱ།",
    "རེས་འགའ་ནི་མ་འོངས་པ་ཞེས་བྱ་སྟེ།",
    "གང་ཡང་འདུ་བྱེད་ཀྱི་མཚན་ཉིད་དང་ལྡན་པའི་ཕྱིར་རྟག་པ་ཉིད་དུ་ཐལ་བར་མི་འགྱུར་རོ་ཞེས་སྨྲས་པ་དེ་ཡང་སྐྱེ་བ་དང་།",
    "འདས་པ་དང་མ་འོངས་པའི་བདག་ཉིད་དུ་ཡོད་མོད།",
    "ཡོད་ཅེས་བྱ་བའི་སྒྲ་ནི་ཚིག་གི་སྒྲ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཡང་དཔེར་ན་མར་མེ་དེ་ཤི་བ་ནི་ཡོད་མོད་ཀྱི་ཁོ་བོས་ནི་མ་བསད་དོ་ཞེས་འཛེར་པ་དེ་བཞིན་དུ་འདས་པ་དང་།",
    "རང་གི་ངོ་བོ་ཁོ་ནར་ཡོད་ན་འདས་པ་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "འོན་ཏེ་རང་གི་མཚན་ཉིད་དུ་མ་བྱུང་བ་ལས་འབྱུང་ངོ་ཞེ་ན་ནི་མ་འོངས་པའི་མིག་མེད་དོ་ཞེས་བྱ་བ་འདི་གྲུབ་པ་ཡིན་ནོ།",
    "གང་གི་འདས་པ་དང་མ་འོངས་པ་རྫས་སུ་ཡོད་པ་དེའི་འབྲས་བུ་རྟག་ཏུ་ཡོད་པ་ཁོ་ན་བས་དེ་ལ་ལས་ཀྱི་ནུས་པ་ཅི་ཞིག་ཡོད།",
    "གལ་ཏེ་ཡུལ་གཞན་དུ་འདྲེན་པ་ཡིན་ནོ་ཞེ་ན་ནི་རྟག་པར་ཐལ་བར་འགྱུར་རོ།",
