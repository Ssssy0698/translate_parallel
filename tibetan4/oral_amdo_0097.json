    "གསོང་པོར་སྨྲ་བ་ཞེས་བྱ་བ་དང་།",
    "བཞི་པོ་དེ་དག་གིས་ཟིལ་གྱིས་མནན་པར་གྱུར་ཅིང་ལྡང་བར་མ་ནུས་སོ།",
    "ལྷག་པར་མོས་པ་བྱེ་བ་ཁྲག་ཁྲིག་དྲུག་ཅུ་རྩ་བརྒྱད་པོ་དེ་དག་ནི།",
    "ཤ་ར་དྭ་ཏིའི་བུ་དེ་ལྟར་དམ་པ་མ་ཡིན་པ་དེ་དག་གིས།",
    "དེ་དག་གི་ལོག་པར་ལྟ་བ་ཡོངས་སུ་འཛིན་པར་གྱུར་ཏོ།",
    "སྐྱེས་བུ་དམ་པ་མ་ཡིན་པ་བཞི་པོ་དེ་དག་གི་རྗེས་སུ་འབྲང་བ།",
    "དེ་དག་གི་སྨྲ་བ་ལ་གུས་པར་ཉན་པར་གྱུར་པ་དེ་རྣམས་ཀྱིས།",
    "སྦྱོར་ཞིང་འབད་ལ་རྣལ་འབྱོར་དུ་བྱེད་པ་དེ་དག་གིས་ནི་ནམ་ཡང་ཟས་ཡོངས་སུ་སྦྱོར་བའི་ལས་བྱས་པ་མ་ཡིན་ནོ།",
    "དེ་དག་གིས་ནམ་དུ་ཡང་རྗེས་སུ་མཐུན་པའི་བཟོད་པ་ཡང་མ་སྐྱེད་ན།",
    "སློང་མོ་སྟེར་བའི་ཚོགས་སུ་གྱུར་པ་དེ་དག་ཀྱང་།",
    "ཤ་ར་དྭ་ཏིའི་བུ་གང་དག་གིས་ཡིན་པར་གྱུར་པ་གྲོགས་པོའི་ཚོགས་དང་།",
    "སློང་མོ་སྟེར་བའི་ཚོགས་དང་།",
    "ཤ་ར་དྭ་ཏིའི་བུ་རྣམ་གྲངས་འདིས་སྲོག་ཆགས་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་དྲུག་ཅུ་རྩ་བཞི་པོ་དེ་རྣམས་བསྐལ་པ་ཚང་བར་ངན་སོང་དུ་སྐྱེས་པར་གྱུར་ཏོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་བསྟན་པའི་ཚེ་འཁོར་དེ་ནས་གུད་དུ་འདོང་བར་འགྱུར་ཏེ།",
    "དེ་དག་གིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་སྤངས་པས་འདས་པ་དང་།",
    "དེ་དག་དེ་ནས་ཤི་འཕོས་ནས་ཤར་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་དག་ཏུ་བྱོལ་སོང་གི་སྐྱེ་གནས་རྣམས་དང་སྐལ་བ་མཉམ་པར་སྐྱེ་བར་འགྱུར་རོ།",
    "སྟེང་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་དག་ཏུ་བྱོལ་སོང་གི་སྐྱེ་གནས་པ་རྣམས་དང་སྐལ་བ་མཉམ་པར་སྐྱེ་བར་འགྱུར་རོ།",
    "རྫོགས་པའི་རྣམ་པར་སྨིན་པ་དེས་དེ་དག་ལ་གང་དང་གང་དུ་སྐྱེ་བ་དེ་དང་དེར་དམུས་ལོང་གི་རིགས་སུ་སྐྱེ་བར་འགྱུར།",
    "སྐྱེས་བུ་གླེན་པ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་སྤོང་བ་དེ་དག་ནི་བདུད་ཀྱིས་བྱིན་གྱིས་བརླབས་པ་ཡིན་ཏེ།",
