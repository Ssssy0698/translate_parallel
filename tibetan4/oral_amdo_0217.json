    "ཕྱི་རོལ་ཏུ་འཁོར་འདས་ཁམས་གསུམ་སྣོད་བཅུད་ཀྱི་དངོས་པོ་ཐམས་ཅད་གཅིག་ལ་གཅིག་བརྟེན་གྱི་ཚུལ་དུ་སྣང་བ་འདི་དག་ཀྱང་དོན་ལ་མེད་བཞིན་ཀུན་རྫོབ་ཏུ་སྣང་བའི་ཆོ་འཕྲུལ་རྨི་ལམ་གྱི་ཡུལ་སྣང་ལྟ་བུ་འདི་ལ་རྟག་འཛིན་ཨ་འཐས་བདེན་ཞེན་ལ་ཆེས་ཆེར་གོམས་པས་ཁམས་གསུམ་རིགས་དྲུག་གི་བདེ་སྡུག་བཏང་སྙོམས་སྣ་ཚོགས་ལ་སྤྱོད་ཅིང་།",
    "དེ་ཉིད་ཉོན་མོངས་བྲལ་གྱུར་ན།",
    "ལམ་ཕྱག་རྒྱ་ཆེན་པོས་འཁྲུལ་རྟོག་གི་དྲི་མ་སྦྱང་།",
    "རང་རང་གི་ངོ་བོར་ནི་དེ་དང་དེ་དག་བདེན་པར་གཞི་གྲུབ་ཅིང་།",
    "སེམས་ཉིད་ཡེ་གདོད་མ་ནས་ཡོངས་དག་ཆེན་པོར་ལྷུན་གྱི་གྲུབ་ཅིང་འདས་མ་འོངས་ད་ལྟར་དུས་གསུམ་དུ་སྐྱེ་འགག་གནས་དང་འགྲོ་འོང་གི་སྤྲོས་པ་དང་བྲལ་བ།",
    "རང་གི་སེམས་ཉིད་ཀྱང་སྐུ་གསུམ་གྱི་རང་བཞིན་ཉིད་དང་།",
    "དེ་དག་ལ་ངེསཔ་རྙེད་ནས་སླར་མཚན་མེད་མཆོག་གི་ཞི་གནས་ལ་འཇུག་པར་བྱ་སྟེ།",
    "དེ་ཡང་ཕྱི་ནང་གི་ཡུལ་རྐྱེན་གྱི་རྗེས་སུ་སེམས་ཡེངས་པ་མ་ཡིན་པར་ཡེངས་མེད་སོ་མར་བཞག་པ་དང་།",
    "རྣམ་རྟོག་གི་ངོ་བོ་དང་དྲན་རིག་གཉིས་ཡ་བྲལ་ཐ་དད་གཉེན་པོ་བསྟེན་པ་ལྟ་བུ་མ་ཡིན་པར་རང་རིག་རང་གསལ་རང་དངས་སུ་བཞག་པ་སྟེ།",
    "འདི་གསུམ་ལ་མིང་གི་རྣམ་གྲངས་གཞན་དུ།",
    "གང་ཤར་བ་དེ་ལ་རྗེས་འཐུད་དུ་མ་སོང་བར་རང་ངོ་ཧྲིག་གིས་ཤེས་པར་བྱ་བ་ཁོ་ནས་ཆོག་གི་ཆེད་དུ་བཀག་པའམ།",
    "ལམ་གྱི་བྱེ་བྲག་གཞན་ལས་སྣ་ཚོགས་འབྱུང་མོད་ཀྱང་།",
    "དེ་ལྟར་བསྐྱངས་པས་རྣམ་རྟོག་ཕལ་ཆེར་མགོ་ནོན་ཏེ་འཇམ་ཉལ་གྱི་འགྲོ་ཞིང་ལུས་སེམས་བདེ་འབོལ་གྱི་སོང་བས་བྱ་བྱེད་གཞན་ལ་ཞེན་པ་མི་འཇུག་པར་མཉམ་བཞག་ལ་སྤྲོ་ཞིང་།",
    "ཐེང་རེ་ཙམ་ལས་གཞན་རྟོག་པའི་འགྱུ་འཕྲོ་མེད་པའི་གནས་པ་ཤས་ཆེར་གྱུར་པ་ནི།",
    "སེམས་གསལ་དངས་རྙོག་པ་མེད་པར་ཉོན་མོངས་འདས་པ་མི་ཚོར་ཞིང་ཇི་ཙམ་མཉམ་པར་བཞག་གི་བར་དུ་གཡོ་བ་མེད་ཅིང་རྐྱེན་གྱིས་མི་གནོད་ལ།",
    "སྐྱེ་བོ་དག་གིས་ཀྱང་གྲུབ་ཐོབ་ཏུ་མཐོང་བ་ལ་བརྟེན་ནས་རང་གཞན་མང་པོ་ཕུང་ཉེན་ཡོད་པས་གཟབས་འཚལ་ལོ།",
    "མངོན་སུམ་རྟོག་བྲལ་གྱི་ཡེ་ཤེས་ཡོད་མེད་ཡིན་མིན་རྟག་ཆད་གང་གི་ཡང་མཐར་མ་ལྷུངས་ཤིང་།",
    "གསལ་རིག་སྟོང་གསུམ་དབྱེར་མེད་དུ་མྱོང་ཞིང་ཤེས་ཀྱང་དཔེས་མཚོན་དུ་མེད་ལ་ཚིག་གིས་བརྗོད་ཐབས་ཟད་པ།",
    "རང་བྱུང་རང་གསལ་དུ་ཧྲིག་གེ་བ་འདི་ལ་ལྷག་མཐོང་ཞེས་མིང་དུ་བཏགས་མོད་ཀྱི།",
    "གནས་མི་གནས་བལྟ་མཁན་སོགས་ཐམས་ཅད་ཁོ་རང་ཡིན་ཀྱང་རང་གིས་རང་མ་མཐོང་བ་ལྟ་བུར་གྱུར་པ་སྟེ།",
    "ཞི་གནས་ཀྱི་ཉམས་དང་བདེ་གསལ་མི་རྟོག་དེ་ཐམས་ཅད་ལྷག་མཐོང་གི་རིག་པ་ཁོ་རང་དག་ཏུ་ཤར་བ་ལས་གཞན་མིན་ཀྱང་།",
    "རྣམ་རྟོག་རང་སར་ཞི་ནས་སེམས་བདེ་གསལ་མི་རྟོག་གི་ངང་དུ་གནས་པ་ནི་ཞི་གནས།",
    "དེ་གཉིས་གང་གི་ཚེ་ཡང་རང་ངོ་ཤེས་ན་ལྷག་མཐོང་གི་རང་བཞིན་ཉིད་དང་།",
    "ཕྱི་རོལ་ཚོགས་དྲུག་གི་སྣང་བ་གང་ལ་ཡང་ཨ་འཐས་ཀྱི་ཞེན་པ་མ་ཞུགས་པ་ནི་ཞི་གནས།",
    "རྣམ་རྟོག་ལྷངས་ཀྱི་ཤར་ཚེ་རང་ངོ་ཧྲིག་གིས་ཤེས་པར་བྱེད་པ་ཞི་གནས།",
    "ཉོན་མོངས་ཤིན་ཏུ་དྲག་པོ་ཞིག་སྐྱེས་པའི་ཚེ་ནའང་དེའི་རྗེས་སུ་ཨ་འཐས་མ་སོང་བ་རང་ངོ་ལ་བལྟ་བ་ནི་ཞི་གནས།",
    "བལྟ་མཁན་གྱི་རིག་པ་དང་བལྟ་བའི་ཉོན་མོངས་སོ་སོར་མ་གྲུབ་པའི་གསལ་སྟོང་རྗེན་པ་ནི་ལྷག་མཐོང་སྟེ།",
    "ཉོན་མོངས་ཀྱི་ཐོག་ཏུ་ཡང་ཞི་ལྷག་ཟུང་འཇུག་ཚང་སྟེ།",
    "རྣམ་པ་ལྟར་གང་ཟག་གིས་འཇུག་པ་བདེ་བའི་སླད་དུ་མིང་དང་དབྱེ་བ་སོ་སོར་བསྟན་ལ།",
    "ཕྱི་རོལ་མུ་སྟེགས་པ་དང་ནང་པའི་ཡང་ཉན་རང་གི་བསམ་གཏན་དག་དང་།",
    "ལྷ་གནས་རྣམས་ཀྱི་ཏིང་འཛིན་དང་ཐུན་མོང་བ་ཡིན་ཕྱིར།",
    "ཚོགས་དྲུག་གི་སྣང་བ་ཕྲ་རགས་ཐམས་ཅད་འགགས་པའི་ཤེས་པ་རྟོགས་མེད་ཁོ་ན་ལ་སྒོམ་དུ་འཛིན་པར་གདའ་སྟེ།",
    "འགའ་ཞིག་ནི་དྲན་རིག་གིས་མ་ཟིན་པའི་གཏི་མུག་ལུང་མ་བསྟན་ལ་སྒོམ་བརྟན་པོ་རུ་རློམ་མོ།",
    "རྣམ་རྟོག་དང་ཉོན་མོངས་སུ་ཀར་རེ་འདུག་གམ།",
    "བྱེ་བྲག་གི་གོལ་ས་དང་ཤོར་སའི་དབྱེ་བསལ་ནི།",
    "སྒྲུབ་རྒྱུད་གོང་མ་རྣམས་ཀྱི་གསུང་ལས་ཞིབ་རྒྱས་འབྱུང་མོད་ཀྱི།",
    "དེ་ཡང་མཉམ་བཞག་གི་སྐབས་སུ་བདེ་གསལ་མི་རྟོག་གསུམ་གང་རུང་གི་ཉམས་ལ་ཞེན་ན།",
    "བྱེ་བྲག་ཏུ་སྙོམས་འཇུག་གི་བསམ་གཏན་དགུ་ཡོད་དེ།",
    "དེ་ལྟར་འདི་དག་ནི་འཇིག་རྟེན་པའི་ཏིང་ངེ་འཛིན་རྣམས་ཀྱི་ནང་ནས་ནི་མཆོག་ཏུ་གྲགས་ཤིང་ལྷག་མཐོང་གི་གཞི་རྟེན་ཡིན་ཀྱང་།",
    "དེ་ལྟར་སྙོམས་འཇུག་གི་བསམ་གཏན་དགུ་པོ་དག་སོ་སོས་གནས་སྐབས་སུ་མངོན་ཤེས་རྫུ་འཕྲུལ་སོགས་འགྲུབ་པའི་ཡོན་ཏན་ཙམ་ཡོད་ཀྱང་།",
    "འདིར་ནི་མཐར་ཐུག་གི་འབྲས་བུ་རྫོགས་བྱང་ཉིད་བསྒྲུབ་པ་ལས།",
    "ཀུན་རྫོབ་ལྟར་སྣང་གི་ཡོན་ཏན་མི་བསྒྲུབས་ཅིང་།",
    "གཞན་ལ་ཚིག་འཆད་ཤེས་ཀྱང་དོན་རང་གི་རྒྱུད་ལ་མེད་པ་དེ་ལ་གཤིས་ཀྱི་ཕྲལ་ཤོར་ཞེས་བྱའོ།",
    "ཉོན་མོངས་ལྟ་བུ་སྐྱེས་པའི་ཚེ་དེའི་རང་ངོ་ལམ་ཁྱེར་མི་ཤེས་པར།",
    "༨ སྔོན་མ་རྣམ་རྟོག་གི་རྗེས་སུ་འབྲེངས་ནས་ཡོངས་སོ།",
    "ད་སླར་ལེགས་པོར་བསྒོམ་མོ་སྙམ་པའི་རྟོག་པ་ཁོ་རང་འཕྲོ་འཐུད་པའི་ངང་ལ་སོང་བའམ་དྲན་རིག་མེད་ཀྱང་ཡོད་དོ་སྙམ་པ་ལ་སོགས་རྒྱས་འདེབས་ཕྲལ་ཤོར་ཏེ།",
    "འགའ་ཞིག་གིས་ནི་ཞི་གནས་འགོག་པ་བསྒོམས་པས་ཀླུར་སྐྱེ་བ་སོགས་གནས་ངན་ལེན་གྱི་རྒྱུ་རྐྱེན་བྱེད་པས།",
    "འགའ་ཞིག་གིས་སེམས་རྟོག་མེད་བྱིང་རྨུགས་ལ་ཞི་གནས་སུ་འཛིན་པ་དང་།",
    "ཟག་བཅས་ཀྱི་བདེ་བ་ཙམ་ལ་ཟུག་རྔུ་མེད་པ་རང་བཞིན་མཆོག་གི་བདེ་བར་འདོད་པ་དང་།",
    "རྗེས་ཤེས་ཀྱང་བློས་བཏང་ཐ་མལ་འཁྲུལ་འབྱམས་ལ་མི་བསྡད་པར་དྲན་རིག་གིས་ཟིན་པར་བྱས་ན།",
    "འགའ་ཞིག་གིས་ཉམས་ཀྱི་མཉམ་རྗེས་དང་རྟོགས་པའི་མཉམ་རྗེས་སོ་སོར་དབྱེ་བ་དང་།",
    "ལ་ལས་རྣལ་འབྱོར་བཞི་སོ་སོ་ལ་རགས་པའི་མཉམ་རྗེས་རེ་ཐ་དད་དུ་གསུངས་པ་སོགས་མཐའ་ཡས་མོད་ཅིང་དེ་བཞིན་དུ་ཉམས་དང་རྟོགས་པའི་ཁྱད་པར་ཀྱང་སྣ་ཚོགས་པའི་ཚུལ་དང་།",
    "གང་ཟག་གི་མོས་ཁམས་བསམ་ཡས་ཇི་སྙེད་ཀྱི་གདུལ་ཐབས་ལ་དགོངས་པའི་ཐུགས་རྗེའི་རྣམ་རོལ་ཡིན་ཕྱིར་བདེན་པ་ཁོ་ནར་གོར་མ་ཆགས་ཕྱིར་སྐྱབས་སུ་མཆི་ཞིང་།",
    "བསྐྱེད་རིམ་སོགས་ལམ་གྱི་ཉམས་ལེན་ཕལ་མོ་ཆེ་ལ་འགྲོ་སྟེ།",
    "རྡོ་རྗེ་གདན་ལྟ་བུ་གཅིག་གི་དབྱིབས་དང་བཀོད་པའི་གནས་ཚུལ་རྣམས་གཞན་གྱི་ངག་ལས་ཐོབ་པའི་དོན་འོལ་སྤྱི་ཙམ་རང་གི་ཡིད་ལ་ཤར་ཞིང་གཞན་དག་ལ་འཆད་ནུས་པ་དེ་ལ་གོ་བ་ཟེར།",
    "ཐག་རིང་མོ་ནས་རྡོ་རྗེ་གདན་མཐོང་བའམ།",
    "བཀོད་པ་རི་མོར་བྲིས་པ་བལྟ་མྱོང་བས་དོན་ཕལ་ཆེར་ཙམ་བློ་ངོར་ཆུད་པ་དེ་ལ་མྱོང་བའི་ཉམས་ཞེས་བྱ།",
    "གཞན་གང་ཟག་ཐུན་མོང་བ་སྤྱི་ལ་ཉམས་ལེན་བརྩོན་འགྲུས་ཆེ་ཆུང་ལྟར་གྱི་གོ་རིམ་ངེས་ཅན་དུ་ན་འཕར་བའི་རིགས་ལ་རིམ་གྱིས་པ་ཅེས་བྱ་སྟེ་ཕལ་པ་རྣམས་སོ།",
    "དེ་རེ་རེ་ལ་ཆེ་ཆུང་འབྲིང་དུ་ཕྱེ་བའི་བཅུ་གཉིས་པོ་འདི་ནི་རྒྱུད་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པའི་ལུང་གི་དགོངས་པ་རྗེ་ཟླ་འོད་གཞོན་ནུས་གསལ་བར་མཛད་པ་སྟེ།",
    "བཟོད་པ་བརྟན་པོས་ངན་སོང་སྡུག་བསྔལ་སྤོང་།",
    "རྩེ་མོ་ཐོབ་ནས་འཕེལ་བ་རྒྱུན་མི་འཆད།",
    "སྤྱན་སྔ་ཐམས་ཅད་མཁྱེན་པ་སོགས་ཀྱིས་ཞིབ་མོར་ཕྱེས་ཤིང་།",
    "མི་དགེའི་ལས་རྣམས་ངང་གིས་སྤོང་།",
    "རྣལ་འབྱོར་བཞི་པོ་དེ་དག་གི་དངོས་དོན་ཇི་ལྟར་འཆར་ཚུལ་རིམ་པ་དང་།",
    "རོ་གཅིག་བསྒོམ་མེད་དང་བཞི་ལས་དང་པོ་རྩེ་གཅིག་གི་རྣལ་འབྱོར་ནི།",
    "རང་ཉིད་ཀྱི་གོ་ཚོད་ལ་ནི་གང་ཟག་གི་རིམ་པ་ཐ་དད་ཀྱི་ཁྱད་ནི་ལོས་ཀྱང་མཆིས་ལ།",
    "འདིར་ཡང་ལྷག་མཐོང་གིས་ཟིན་པར་གོའོ།"
  ]
}