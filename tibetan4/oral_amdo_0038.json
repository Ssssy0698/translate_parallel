    "ཞེན་པ་མེད་པའི་ཚུལ་གྱིས་རེ་དོགས་མེད་པར་འབུལ་ན",
    "མཆེད་ལྕམ་དྲལ་རྣམས་ཀྱི་ཚོགས་རྣམ་པ་གཉིས་རྫོགས་ནས་རྩ་བ་དང་ཡན་ལག་གི་དམ་ཚིག་ཉེས་ལྟུང་ཐམས་ཅད་ལས་གྲོལ་ཏེ",
    "རེ་བ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་མཛད་དུ་གསོལ",
    "གསུང་གིས་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ",
    "ངག་གི་སྒྲིབ་པ་སྦྱང་དུ་གསོལ་ངག་ལ་ནུས་པ་དབྱུང་དུ་གསོལ",
    "གོང་གི་སྐུ་གསུང་ཐུགས་ཀྱི་སིདྡྷིའི་རྟགས་སུ་ལན་གསུམ་བར་དུ་དངོས་གྲུབ་སྦྱིན",
    "ཨོཾ་བཛྲ་བུདྡྷ་རཏྣ་པདྨ་ཀརྨ་ཌཱ་ཀི་ནཱི་པྲ་ཏཱི་ཛ་མ་ཧཱ་བ་ལིནྟ་ཧཱུྃ་ཨོཾ་ཏྲཱྃ་ཧྲཱི་ཨཱ་ཕཊ་ཁཱ་ཧི་ཞེས་སོ།",
    "མཁའ་འགྲོ་གིང་དང་ལང་ཀའི་ཚོགས",
    "སློབ་དཔོན་པདྨའི་བཀའ་ཉན་ལྷག་མ་ལ་གཏོགས་པ་རྣམས་ཀྱི་ཞལ་དུ་སརྦ་པཉྩ་ཨ་མྲྀ་ཏ་ཁཱ་ཧི",
    "ཞིང་བཅུ་ཐལ་བའི་རྡུལ་བཞིན་རློག",
    "བདག་ཅག་གི་བསམ་པ་ཡིད་བཞིན་དུ་འགྲུབ་པར་མཛད་དུ་གསོལ",
    "ཨོཾ་ཨཱ་ཧཱུྃ་བཛྲ་ཨ་མྲྀ་ཏ་ཨོཾ་ཨཱ་ཧཱུྃ",
    "ལས་ཀྱི་མཐའ་རྣམས་ཁྱོད་ལ་འཚལ",
    "ཕོ་རྒྱུད་མོ་རྒྱུད་ལས་མཁན་ཚོགས",
    "ཉོན་མོངས་དགྲ་བགེགས་རྡུལ་དུ་རློག",
    "བག་མེད་ཉོན་མོངས་བཟོད་པར་གསོལ",
    "གིང་ཆེན་རྣམ་བཞི་ལ་སོགས་པའི",
    "གཅིག་ལ་སྟོད་དཔལ་མོར་རྒྱ་མཚོ་ཆེན་པོའི་ནུབ་ཏུ",
    "ལ་སྟོད་དཔལ་མོའི་མཚོ་འགྲམ་དུ་གཏེར་དུ་སྦས་པའོ",
    "རྒྱུད་དང་བླ་སྒྲུབ་ལས་བྱང་རང་གི་དགོངས་པ་མིན་པ་རང་བཟོའི་ཚིག་མེད་པས་འགལ་འཁྲུལ་ཆེར་མེད་སྙམ་མོ།",
    "པོད་༤༧རྗེ་བཙུན་མཁའ་སྤྱོད་རྡོ་རྗེ་བཙུན་མོའི་བསྐྱེད་རྫོགས་ཀྱི་དམིགས་རིམ་ཁྱེར་བདེ་ཀུན་ཚང་། ཧཱུྃ་ ། རྗེ་བཙུན་མཁའ་སྤྱོད་རྡོ་རྗེ་བཙུན་མོའི་བསྐྱེད་རྫོགས་ཀྱི་དམིགས་རིམ་ཁྱེར་བདེ་ཀུན་ཚང་ཞེས་བྱ་བ་བཞུགས་སོ། ། ན་མོ་གུ་རུ་བཛྲ་ཝཱ་ར་ཧི།",
    "དངོས་པོས་འཁྱུད་པའི་དཔལ་མོ་མཆོག་སྦྱིན་མཁན།",
    "གདོད་མའི་སྐྱབས་གྱུར་རང་རིག་ཕག་མོའི་ཞལ།",
    "གང་གིས་ཉམས་སུ་ལེན་པའི་གང་ཟག་རབ་བདེ་མཆོག་ལཱུ་ནག་གང་རུང་གི་སྨིན་བྱེད་ཐོབ་པའམ།",
    "འབྲིང་གིས་འཆི་ཁ།",
    "དེ་དག་གི་ཉམས་ལེན་གྱི་གཙོ་བོ་ནི་བསྐྱེད་རིམ་རྣལ་འབྱོར་བཅུ་གཅིག་པོ་འདིར་མ་འདུས་པ་མེད་པས།",
    "དཔའ་བོ་དཔའ་མོས་བྱིན་གྱིས་བརླབས།",
    "རེག་ན་བདེ་བ་བསྐྱེད་པའི་ས་གཞི་ལག་མཐིལ་ལྟར་མཉམ་པ་སྟོང་གསུམ་གྱི་ཁྱོན་དང་མཉམ་པ།",
    "གང་གིས་སྐྱབས་སུ་འགྲོ་བའི་གང་ཟག་ནི་གཞལ་ཡས་ཁང་དེའི་དབུས་སུ་རང་ཉིད།",
    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "ཁྱེད་རྣམས་ཀྱིས་བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "མིའི་ཐོད་པ་ལེབ་མོར་རང་སོར་ལྔ་པ་ཁ་མིག་གི་རྣམ་པ་གཏོད་པའི་རྩེ་མོར་གསེར་གྱི་རྩེ་ཕྲན་དང་བཅས་པ་ལྔའི་དབུ་རྒྱན།",
    "གཞན་ཡང་རུས་པའི་ཨ་ལོང་གི་སྙན་རྒྱན།",
    "རུས་ཕྲེང་གི་མགུལ་རྒྱན་སྨད་རྒྱན་སེ་རལ་ཁ་ཕྱག་གདུབ་ཞབས་གདུབ་སོགས་རུས་པའི་རྒྱན་དྲུག་གིས་བརྒྱན་པ།",
    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "དབུ་སྐྲ་རལ་པའི་ཐོར་ཅོག་གི་མདུན་དུ་རིགས་བདག་མཚོན་བྱེད་རྡོ་རྗེ་དཀར་པོ་རྩེ་ལྔ་པས་བརྒྱན་པ།",
    "པདྨའི་སྐྱིལ་ཀྲུང་གིས་ཞབས་ཀྱི་བྱིན་པས་ཡབ་ལ་འཁྲིལ་བ།",
    "ཡབ་ཀྱི་ཐུགས་ཀར་ཟླ་དཀྱིལ་ཆུང་ངུ་ཞིག་གི་སྟེང་དུ་ཧཱུྃ་དཀར་པོ་སྤུས་བྲིས་པ་ལྟ་བུ་ཟླ་བ་ལ་ནས་ཙམ་མ་རེག་པ་གསལ་བཏབ།",
    "དེ་ཡན་ཆད་གངས་རིར་ཉི་མ་ཤར་བ་ལྟར་དཀར་སངས་ཀྱིས་སོང་།",
    "དེ་མན་ཆད་ཅུང་མོག་པའི་རྣམ་པ་དང་།",
    "ལུས་ཀྱི་དྲི་མ་དག་སོང་སྙམ་པ་དང་།",
    "ཐུགས་ཀའི་ཐད་དུ་འོད་དཀར་བ་འཚེར་བ་འདྲིལ་བ་ཞིག་ཏུ་ཞུ་ནས་སྤྱི་བོ་ནས་ཐིམ་པས་རང་གི་ལུས་ངག་ཡིད་གསུམ་དང་རྡོར་སེམས་ཡབ་ཡུམ་གྱི་སྐུ་གསུང་ཐུགས་དབྱེར་མེད་དུ་འདྲེས་པར་བརྟེན།",
    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "གཞོན་ནུ་ལང་ཚོ་བཅུ་དྲུག་ལོན་པའི་ན་ཚོད་ཅན།",
    "གཡོན་པས་ཐོད་པ་བདུད་རྩིས་གང་བ་ཐུགས་ཀར་འཛིན་པ་གྲུ་མོ་གཡོན་ན་ཁ་ཊྭཱཾ་ག་བསྣམས་པ།",
    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "རུས་པའི་རྒྱན་དྲུག་གིས་བརྒྱན་ཅིང་གཞོན་ནུ་ལང་ཚོ་དར་ལ་བབ་པ་སྐྱབས་གནས་ཀུན་འདུས་ཀྱི་ངོ་བོར་གྱུར་པར་བསམས་ལ།",
    "དེ་ནས་རང་གི་མདུན་དུ་རང་ལ་གཅེས་ཤིང་འཕང་པའི་དངོས་པོ་ཐམས་ཅད་ཕུང་པོ་ཆེན་པོར་སྤུངས་ཏེ་ཡོད་པར་བསམ།",
    "རང་གི་གཡས་སུ་ཕ་མ་སོགས་གཉེན་འབྲེལ།",
    "དེས་ཐུར་དུ་གཟིགས་པས་རང་གི་ལུས་ཚོ་ཞིང་བསྣུམ་པ་ཆེ་ཞིང་བརྗིད་པ་ཁྲང་ངེར་ཡོད་པ་དེའི་སྨིན་མཚམས་ལ་ཕྱག་གཡས་པའི་གྲི་གུག་གིས་རེག་པ་ཙམ་གྱིས་ཐོད་པ་ལིང་གིས་བཀོག་མདུན་དུ་ཐོད་པའི་སྒྱེད་པུ་རི་ཙམ་གསུམ་གྲུབ་པའི་སྟེང་དུ་བཀལ་བ་དེ་ཉིད་ཇེ་ཆེར་སོང་སྟེ་མཐར་སྟོང་གསུམ་གྱི་ཁྱོན་དང་མཉམ་པར་གྱུར།",
    "ཡང་གྲི་གུག་གིས་ལུས་ཀྱི་རྐང་པ་གཡོན་གཡས་དུམ་བུ་གསུམ་དུ་བཅད་ནས་ཐོད་པའི་ནང་དུ་བསྐྱུར།",
