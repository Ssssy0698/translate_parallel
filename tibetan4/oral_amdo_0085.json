    "དེའི་ཕྱིར་དེ་ནི་བྱ་རོག་གི་སོ་བརྟག་པ་བཞིན་དུ་གནས་པ་མ་ཡིན་པར་ཁྱོད་ཡོངས་སུ་ངལ་བར་འགྱུར་རོ་ཞེས་འདྲི་བར་འགྱུར་བ་དེའི་ཕྱིར་སྐྱེས་བུའི་དོན་ཐམས་ཅད་འགྲུབ་པ་ནི་ཡང་དག་པར་༢ིས་པ་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་ཞེས་པ་༢ིའདི་སྨོས་ཏེ་དེས་ནི་དགོས་པའི་ཡང་དགོས་པ་བསྟན་ཏོ།",
    "དེ་བས་ན་ཚིག་གི་དོན་ནི་འདི་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་ཡང་དག་པའི་ཤེས་པ་སྐྱེས་བུའི་དོན་ཐམས་ཅད་འགྲུབ་པ་ལས་༤མཁོ་བར་གྱུར་པ་ལས་༥དེའི་ཕྱིར་བསྒྲིམས་ཏེ་དེ་ཡོངས་སུ་ཤེས་པར་བྱའོ།",
    "དེ་ནི་རེ་ཞིག་བསྡུ་བའི་དོན་ཡིན་ན་ནོ།",
    "ཡན་ལག་གི་དོན་ནི་ཡང་དག་པའི་ཤེས་པ་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་པས་ན་ཞེས་བྱ་བ་ལ་འདིར་མི་སླུ་བའི་ཤེས་པ་ནི་ཡང་དག་པར་ཤེས་པ་སྟེ།",
    "སྔོན་གྱི་སྒྲས་༩ནི་འདི་རྒྱུ་ཡིན་པར་བརྗོད་དེ་གང་གི་ཕྱིར་འབྲས་བུ་བས་རྒྱུ་སྔ་བ་",
    "དེས་ན་༢ི་འདི་སྐད་དུ་གང་གི་ཕྱིར་ཡང་དག་པའི་ཤེས་པ་ནི་སྐྱེས་བུའི་དོན་ཐམས་ཅད་འགྲུབ་པའི་སྔོན་༤དུ་བཏང་བ་ཅན་ཡིན་པ་དེའི་ཕྱིར་དེ་བསྟན་ཏོ་ཞེས་བྱ་བར་བསྟན་པར་འགྱུར་རོ།",
    "མ་ནིང་གི་རྟགས་ཀྱིས་བསྟན་པ་དང་གཙོ་བོ་ཡིན་པའི་ཕྱིར་ར་རོ།",
    "རང་གི་ངོ་བོ་ལ་ལོག་པར་རྟོག་པ་དང་།",
    "དེ་ལ་གྲངས་ལ་ལོག་པར་རྟོག་པ་ནི་ཁ་ཅིག་གི་ནི་གཅིག་སྟེ།",
    "ཁ་ཅིག་གི་ནི་གསུམ་སྟེ།",
    "རང་གི་ངོ་བོ་ལ་ལོག་པར་རྟོག་པ་ནི་འདི་ལྟ་སྟེ་ཁ་ཅིག་༦ནི་མངོན་སུམ་རྣམ་པར་རྟོག་པ་དང་བཅས་པ་༧།",
    "ཁ་ཅིག་གིས་༨ནི་མངོན་སུམ་གྱི་ཡུལ་ནི་རང་གི་མཚན་ཉིད་ཁོ་ནའོ།",
    "གཞན་དག་གིས་གཞན་དུ་བྱ་བརྗོད་པ་ལྟ་བུའོ།",
    "དེ་ལྟ་བས་ན་དེ་ལྟ་བུའི་ལོག་པར་རྟོག་པ་རྣམ་པ་བཞི་༡བསལ་བས་རྣམ་པ་ཐམས་ཅད་དུ་མ་ནོར་བར་ཡང་དག་པའི་ཤེས་པའི་རང་གི་ངོ་བོ་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ལ་རེ་ཞིག་དང་པོ་ཁོ་ནར་གྲངས་ལ་ལོག་༢པར་རྟོག་པ་བསལ་བའི་ཕྱིཕྱིར།",
    "དེ་བས་ན་བ་ལང་ཉིད་དང་ལྡན་པའི་རིལ་པོ་ལ་བ་ལང་གི་༐",
    "རང་གི་ངོ་བོ་ལ་ལོག་པར་རྟོག་པ་བསལ་བར་བྱ་བའི་ཕྱིཕྱིར།",
    "དེ་ནི་རེ་ཞིག་བསྡུས་པའི་དོན་ཡིན་ན་ནོ།",
    "ཡན་ལག་གི་དོན་ནི་རྟོག་པ་རྣམས་དང་བྲལ་བ་ནི་རྟོག་པ་དང་བྲལ་བ་སྟེ།",
    "སྨྲས་པ་མ་འཁྲུལ་བ་སྨོས་པ་ནི་རེ་ཞིག་རབ་རིབ་ཅན་གྱི་ཤེས་པ་འཁྲུལ་པ་རྣམ་པར་གཅད་༢པར་བྱ་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་ན་གོ་རྗེས་སུ་དཔག་པ་ཡང་མངོན་སུམ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "དོན་གྱི་བྱེ་བྲག་རང་གི་ངོ་བོའི་མཚན་ཉིད་ཀྱི་ངོ་བོ་ནི་བརྗོད་པར་མི་ནུས་༢ཏེ་དེ་ཁྱབ་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་ར་རོ།",
    "སྒྲའི་བྱེ་བྲག་གིས་ནི་མི་ནུས་ཏེ་དེ་ཐུན་མོང་མ་ཡིན་པའི་ཕྱིར་ར་རོ།",
    "འཁྲུལ་༢༢པ་ལ་སོགས་པས་འཁྲུལ་པ་མ་བསྐྱེད་པ་ཞེས་བྱ་བ་ལ་རབ་རིབ་ཅེས་བྱ་བ་ནི་མིག་གི་གནོད་པའོ།",
    "རྟ་རྒོད་མ་ཁྲིད་དེ་མི་འོང་གི་བ་དྲུས་མ་ཁྲིད་དེ་འོང་བས་འདི་ལྟར་དེ་ཉིད་བེའུ་དང་འབྲེལ་བར་མཐོང་བ་དེ་བཞིན་དུ།",
    "འདིར་ཡང་རྟོག་པ་དང་འཁྲུལ་པ་ནི་ཤེས་པ་ཁོ་ན་དང་འབྲེལ་པར་མཐོང་གི་གཞན་ད་ག་༡ནི་མ་ཡིན་པས་ཤེས་པ་ཁོ་ན་མངོན་སུམ་དུ་འདོད་དོ།",
    "རྣམ་པར་ཤེས་པའོ་ཞེས་བྱ་བ་ནི་དེར་རང་གི་ཡང་ཡིན་ལ་ཡུལ་ཡང་ཡིན་པས་རང་གི་ཡུལ་ཏེ།",
    "བདག་གི་དམིགས་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་ག་གོ།",
    "ཡུལ་གྱི་༩དེ་མ་ཐག་པ་ནི་རང་གི་ཡུལ་གྱི་དེ་མ་ཐག་པ་སྟེ།",
    "དེ་ནི་རང་གི་ཡུལ་གྱི་དེ་མ་ཐག་པ་ཡང་ཡིན་ལ་ཡུལ་ཡང་ཡིན་པས་རང་གི་ཡུལ་གྱི་དེ་མ་ཐག་པ་ཡུལ་ལ་ལོ།",
    "འདིར་རང་གི་ཡུལ་གྱི་དེ་མ་ཐག་པ་ཡུལ་ཞེས་བྱ་བའི་སྒྲས་ནི་༐",
    "གཟུང་བ་དང་འཛིན་པ་མེད་པར་ཐལ་བའི་ཉེས་པ་ཡང་ཡོངས་སུ་༦ལྟ་ག་ལ་འགྱུར་རོ་༧།",
    "གང་གི་ཚེ་དེ་མ་ཐག་པའི་སྒྲ་རིགས་མཐུན་པ་ལ་ཡང་བྱ་བ་དེའི་ཚེ་རིགས་མི་མཐུན་པའི་ཡུལ་ལ་འཛིན་པར་ཡང་ཐལ་བར་ག་ལ་འགྱུར།",
    "དེ་བས་ན་གང་ལ་ལ་དག་ན་རེ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་ཕྱི་རོལ་གྱི་ཡུལ་མངོན་སུམ་དུ་བྱེད་པར་ཁས་ལེན་ན།",
    "འདི་ལྟར་ལོང་བ་དང་འོན་པ་ལ་སོགས་པ་མེད་པར་ཐལ་བར་འགྱུར་རོ་ཞེས་༐",
    "དེ་དག་གིས་༢རང་གི་ངོ་བོ་རབ་ཏུ་གསལ་བ་གང་ཡིན་པ་དི་ནི་རང་གི་རིག་པ་ཡིན་ནོ།",
    "རྟོགས་པར་བྱ་བའི་༢ིརང་བཞིན་ཅན་ཡིན་པའི་ཕྱིར་རང་གི་ངོ་བོ་རིག་པར་བྱེད་བཞིན་དུ་སྐྱེ་སྐྱེ་སྟེ།",
    "རང་གི་ངོ་བོ་རབ་ཏུ་གསལ་བར་བྱ་བ་ལ་མར་མེ་གཞན་ལ་མི་ལྟོས་ས་སོ།",
    "དེ་བཞིན་དུ་སེམས་དང་སེམས་ལས་བྱུང་བ་རྣམས་ཀྱང་རང་གི་ངོ་བོ་རྟོགས་༢པར་བྱ་བ་ལ་ཤེས་པ་གཞན་ལ་མི་ལྟོས་པ་ཡིན་ཏེ་༦།",
    "རྩེ་མོ་དང་།",
    "དེ་དག་གི་ཤེས་པ་ནི་རྣལ་འབྱོར་པའི་ཤེས་པ་སྟེ།",
    "ཕྲ་མོའི་དངོས་པོ་ཡུལ་གསལ་བར་སྣང་ཞིང་མ་ནོར་བའི་རྣམ་པ་དང་ལྡན་པ་འབྱུང་སྟེ།",
