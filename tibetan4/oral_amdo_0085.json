    "གང་གི་སྔོན་དུ་ཤེས་པ་འགྲོ་བ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "རྒྱུའི་སྒྲ་སྨོས་ན་ནི་སྐྱེས་བུའི་དོན་འགྲུབ་པའི་དངོས་ཀྱི་རྒྱུ་ཡིན་པར་ཤེས་པར་འགྱུར་རོ་། སྔོན་དུ་སོང་བའི་སྒྲ་ནི་སྔ་བ་ཙམ་ལ་བྱའོ།",
    "དེ་ཡང་སྔོན་དུ་སོང་བ་ཙམ་ཡིན་གྱི།",
    "དོན་བྱེད་པར་སྣང་བ་ནི་མངོན་སུམ་དུ་ཕྲད་པའི་རྒྱུ་ཡིན་མོད།",
    "འདི་ནི་ཐམས་ཅད་ཀྱང་ཡིན་ལ་སྐྱེས་བུ་༡༧དོན་འགྲུབ་པ་ཡང་ཡིན་ན་ནོ་། ཐམས་ཅད་ཀྱི་སྒྲ་ནི་འདིར་རྫས་མ་ལུས་པ་ལ་འཇུག་ག་གི།",
    "གང་གི་ཕྱིར་དེ་ཉིད་སྐྱེས་བུའི་དོན་འགྲུབ་པའི་རྒྱུ་ཡིན་པ་དེ་བས་ན། ༐",
    "གང་གི་ཕྱིར་ཡང་དག་པའི་ཤེས་པ་ནི་སྐྱེས་བུའི་དོན་ཐམས་ཅད་འགྲུབ་པར་༩སྔོན་དུ་འགྲོ་བ་ཡིན་པ་དེ་བས་ན་དེ་བསྟན་༡༧ནོ།",
    "ཅི་སྟེ་སྒྲའི་སྦྱོར་བ་ལ་ཡང་དག་པའི་ཤེས་པ་གཙོ་བོར་མ་གྱུར་མོད།",
    "དེ་བས་ན་ཚིག་༢༡གི་དོན་འདི་ཡིན་ཏེ།",
    "དོན་བྱེད་པར་ནུས་པའི་དངོས་པོའི་ངོ་བོ་ནི་དབྱིབས་སུ་བཀོད་པའི་ཁྱད་པར་ཅན་གྱི་ཁ་དོག་གི་བདག་ཉིད་དེ།",
    "འདི་ལྟར་རྟོག་པ་དང་བྲལ་བ་སྨོས་པ་ཉིད་ཀྱིས་རྗེས་སུ་དཔག་པ་བསལ་བ་ཡིན་མོད།",
    "དེ་བས་ན་ལྗོན་ཤིང་གི་ཡུལ་འགྲོ་བར་སྣང་བ་གང་ཡིན་པ་ཡུལ་དེ་དང་ནི་མ་ཕྲད་པ་ཡིན་ལ།",
    "དེ་བཞིན་དུ་མ་འཁྲུལ་པ་སྨོས་པས་ཀྱང་རྗེས་སུ་དཔག་པ་གསལ་༢བ་ཡིན་མོད།",
    "དེ་ལྟར་ན་ངག་གི་དོན་ནི་མི་སླུ་བའི་ཤེས་པ་མངོན་སུམ་ཞེས་བྱ་བ་གང་ཡིན་པ་དེ་ནི་རྟོག་པ་དང་བྲལ་ཞིང་མི་སླུ་བ་ཡིན་ནོ་ཞེས་བྱ་བར་འགྱུར་ཏེ།",
    "དེ་བས་ན་གང་གི་ཚེ་ཤེས་པ་གཅིག་ལ་བརྗོད་པར་བྱ་བ་དང་རྗོད་པར་བྱེད་པའི་རྣམ་པ་གཉིས་ཚོགས་པར་ཡོད་པ་དེའི་ཚེ་བརྗོད་པར་བྱ་བ་དང་རྗོད་པར་བྱེད་པ་གཉིས་འདྲེས་པ་ཞེས་བྱའོ།",
    "དཔེར་ན་གཟུགས་ཀྱིས་༡མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེད་པ་ན་སྣང་བ་ངེས་པ་སྐྱེད་པ་བཞིན་ན་ནོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རང་གི་མཚན་ཉིད་སྨྲ་བར་བྱ་བ་དང་སྨྲ་བར་བྱེད་པའི་དངོས་པོར་ཁས་བླངས་ཀྱང་དེ་རྣམ་པར་མི་རྟོག་པར་བརྗོད་དོ།",
    "སྒྲའི་༢རང་གི་མཚན་ཉིད་ཀྱང་ཁ་ཅིག་ནི་སྨྲ་བར་བྱ་བ་ཡིན་ལ།",
    "དེ་ལྟ་བུའི་སྐྱོན་མེད་དེ་རང་གི་མཚན་ཉིད་སྨྲ་བར་བྱ་བ་དང་སྨྲ་བར་བྱེད་པར་༤དངོས་པོ་ཡོད་དུ་ཟིན་ཀྱང་།",
    "རང་གི་མཚན་ཉིད་བརྡའི་དུས་ན་མཐོང་བ་ཉིད་དུ་བཟུང་ན་སྨྲ་བར་བྱ་བ་དང་སྨྲ་བར་བྱེད་པ་ཡང་བཟུང་བར་འགྱུར་རོ་༥།",
    "ཚུལ་འདིས་རྣལ་འབྱོར་པའི་ཤེས་པ་ཡང་སྒྲ་ད་ང་དོན་མཐའ་དག་སྣང་བ་ཡིན་མོད།",
    "རྣམ་པར་རྟོག་པའི་རང་གི་ངོ་བོ་དང་བྲལ་བ་སྟེ།",
    "དེ་དག་གིས་འཁྲུལ་པ་གང་དུ་ཡང་མ་སྐྱེས་༡༧པའི་རྣམ་པ་དེ་ལྟ་བུའི་ཤེས་པ་དེ་ནི་མངོན་སུམ་ཡིན་ནོ།",
    "རྣལ་འབྱོར་པའི་ཤེས་པ་ཁས་མི་ལེན་པ་དེ་དག་གི་ལོག་པར་རྟོག་པ་བསལ་བའི་ཕྱིར་མངོན་སུམ་གྱི་རྣམ་པར་དབྱེ་བ་སྟོན་པས།",
    "འདིར་ནི་སྐད་ཅིག་གི་དངོས་པོ་ལ་ཁྱད་པར་སྒྲུབ་པ་མི་འཐད་པའི་ཕྱིར་བྱ་བ་གཅིག་ལ་༢བྱེད་པ་ཉིད་ལྷན་ཅིག་བྱེད་པར་བཟུང་སྟེ།",
    "གཟུང་བ་༦མ་ཡིན་པའི་ཡུལ་གཞན་མི་འཛིན་པའི་ཕྱིར་ལོང་བ་དང་འོན་པ་ལ་སོགས་པ་མེད་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བ་བསལ་བ་ཡིན་ནོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དེ་ཡང་མིག་གི་བྱ་བ་འདས་པའི་ཚེ་མངོན་སུམ་དུ་འདོད་ད་དོ།",
    "སེམས་ལས་བྱུང་བ་བདེ་བ་ལ་སོགས་པ་ནི་བྱེ་བྲག་གི་གནས་སྐབས་འཛིན་པའོ།",
    "ངོ་བོ་གང་གིས་བདག་ཉིད་རིག་པའི་ངོ་བོ་དེ་ནི་བདག་ཉིད་རིག་པའི་མངོན་སུམ་མ་མོ།",
    "འདིར་གཟུགས་ལ་སོགས་པ་སྣང་བ་ན་དུས་གཅིག་ཏུ་ནང་གི་བདེ་བ་ལ་སོགས་པའི་རྣམ་པ་ནི་མྱོང་བ་ཡིན་ནོ།",
    "འདི་ལྟར་ཇི་སྲིད་དུ་གསལ་བར་སྣང་བ་ཉིད་མ་རྫོགས་པར་དི་སྲིད་དུ་༧དེ་ཁྱད་པར་དུ་འགྲོ་བ་ཡིན་ལ་གང་གི་ཚེ་རྫོགས་པ་དེའི་ཚེ་ནི་ཁྱད་པར་དུ་འགྲོ་བ་མེད་དོ།",
    "མངོན་སུམ་རྣམ་པ་བཞི་པོ་དེའི་ཡུལ་དེ་རྟོགས་པར་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་ཡིན་ཏེ།",
    "རང་ཐུན་མོང་མ་ཡིན་པ་དེ་ཁོ་ན་ཉིད་ནི་རང་གི་མཚན་ཉིད་ད་དོ།",
    "དངོས་པོ་ལ་ནི་ཐུན་མོང་མ་ཡིན་པ་དེ་ཉིད་དང་སྤྱི་ཡང་ཡོད་ལ།",
    "ཐུན་མོང་མ་ཡིན་པ་གང་ཡིན་པ་དེ་ནི་མངོན་སུམ་གྱིས་༧གཟུང་བར་བྱ་བ་ཡིན་ན་ནོ།",
    "དེ་བཞིན་དུ་རྗེས་སུ་དཔག་པ་ཡང་རང་གི་སྣང་བ་དོན་མེད་པ་ལ་༐",
    "ཡང་རང་གི་སྣང་བ་༡༧དོན་དུ་ཞེན་པས་འཇུག་པའི་ཕྱིར་དོན་མེད་པ་འཛིན་པ་བྱ་ཡིན་ནོ།",
    "༡ཡང་སྒྲོ་བཏགས་པའི་དོན་འཛིན་པ་ན་རང་གི་མཚན་ཉིད་དུ་འཛིན་ཏེ་དེ་བས་ན་རྗེས་སུ་དཔག་པ་འདི་འཇུག་པའི་ཡུལ་ནི་ཞེས་༢བྱ་བ་རང་གི་མཚན་ཉིད་ཡིན་ལ།",
    "ཤེས་པའི་ཡུལ་གང་ཞིག་རང་གི་མཚན་ཉིད་དུ་རྟོགས་པར་བྱ་བ་དེ་ཡང་གང་ཡིན་ཞེ་ན།",
    "ཉེ་བ་མ་ཡིན་པ་ན་རིང་བའི་ཡུལ་ན་གནས་པ་ཉིད་ཀྱི་༧ནི་མི་གསལ་བར་བྱེད་དེ་༨དེ་ནི་རང་གི་མཚན་ཉིད་ཡིན་ན་ནོ།",
    "ཉེ་བ་ལས་ནི་གསལ་ཏེ་དེ་ཉིད་རང་གི་མཚན་ཉིད་ཡིན་ན་ནོ།",
    "ཅིའི་ཕྱིར་མངོན་སུམ་གྱི་ཡུལ་ཁོ་ན་རང་གི་མཚན་ཉིད་ཡིན།",
    "གང་གི་ཕྱིར་དོན་གང་ཉེ་བ་དང་མི་ཉེ་བ་དག་ལས་སྣང་བ་གསལ་༡༧བར་བྱེད་པ་དེ་ཉིད་དོན་དམ་པར་ཡོད་པ་ཡིན་ལ།",
    "མངོན་སུམ་གྱི་ཡུལ་ཡང་དེ་ཉིད་ཡིན་པ་དེའི་ཕྱིར་དེ་ཁོ་ན་རང་གི་མཚན་ཉིད་ཡིན་ན་ནོ་། ཡང་ཅིའི་ཕྱིར་དེ་ཉིད་ནི་༡༧དོན་དམ་པར་ཡོད་པ་ཡིན་ཞེ་ན།",
    "གང་གི་ཕྱིར་དོན་བྱེད་ནུས་པ་ལ་ནི་དོན་༦དམ་པར་ཡོད་པ་ཞེས་བརྗོད་ལ།",
    "དེ་བས་ན་དེ་ཉིད་རང་གི་མཚན་ཉིད་ཡིན་གྱི།",
    "དུ་ངེས་པ་དེ་ལྟ་ན་ཡང་དེ་མཐོང་བ་ཉིད་ནི་མ་ཡིན་གང་ཞིག་༡རང་གི་མཚན་ཉིད་མ་ཡིན་པ་དེ་ནི་སྤྱིའི་མཚན་ཉིད་ཡིན་ནོ།",
    "ཐུན་མོང་གི་ངོ་བོ་༢ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྒྲོ་བཏགས་པའི་ངོ་བོ་ནི་མེ་མཐའ་དག་གི་༢སྤྱིའི་མཚན་ཉིད་ཡིན་ལ་དེ་ཡང་རྗེས་སུ་དཔག་པའི་གཟུང་བར་བྱ་བ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "གང་གི་ཕྱིར་རྣམ་པར་ཤེས་པ་སྔོན་པོར་༡༧སྣང་བ་དེའི་ཕྱིར་སྔོན་པོར་རྟོགས་པར་ངེས་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་མངོན་སུམ་གྱི་སྟོབས་ཀྱིས་བྱུང་བའི་ཞེན་པས་ནི་དོན་མཐོང་བ་ཉིད་དུ་ཞེན་པར་བྱེད་ཀྱི།",
    "རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ནི་ཤེས་པའི་བདག་ཉིད་ཡིན་ན་ནོ།",
    "རང་གི་དོན་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "རང་གི་ཡིན་ཏེ་གང་གིས་རང་ཁོང་དུ་ཆུད་པར་བྱེད་པ་དེ་ནི་རང་གི་དོན་ཏོ།",
    "གང་གིས་གཞན་ཁོང་དུ་ཆུད་པར་བྱེད་པ་དེ་ནི་གཞན་གྱི་དོན་ཏོ།",
    "རང་གི་དོན་དང་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པ་དེ་གཉིས་ཀྱི་ནང་ནས་རང་གི་དོན་ཤེས་པའི་ཁྱད་པར་ཇི་ལྟ་བུ་ཡིན་ཞེ་ན།",
    "ཚུལ་གསུམ་པའི་རྟགས་ལས་སྐྱེས་ཤིང་རྗེས་སུ་ད་པག་པར་བྱ་བ་ལ་དམིགས་པ་ཤེས་པ་དེ་ནི་རང་གི་དོན་ཀྱི་རྗེས་སུ་དཔག་པ་ཡིན་ནོ།",
    "དེ་བརྗོད་པ་ནི་འདི་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཚིག་གི་ལྷག་མའོ།",
    "འདིར་ངེས་པའི་སྒྲ་སྨོས་པ་མ་བྱས་མོད་ཀྱི།",
    "འོན་ཀྱང་ཐ་མར་བྱས་པ་ལ་གོང་དུ་ཐལ་བའི་ཚུལ་དེ་གཉིས་ཀྱང་ལྟོས་པར་འགྱུར་བ་ཡིན་ན་ནོ།",
    "བུམ་པ་ལ་སོགས་པ་ལ་སྒྲོན་མ་བཞིན་དུ་རང་གི་ཡུལ་ཅན་གྱི་༡ཤེས་པ་སྐྱེད་པ་ལ་ལྟོས་༢ནས་ལྐོག་ཏུ་གྱུར་པ་གསལ་བར་བྱེད་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་ལ་ཡོད་པའི་ཚིག་གིས་ནི་མིག་གིས་གཟུང་བར་བྱ་བ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་མ་གྲུབ་༥པ་བསལ་བ་ཡིན་ནོ།",
    "ཉིད་ཀྱི་ཚིག་གིས་ནི་ཕྱོགས་གཅིག་ལ་མ་གྲུབ་པ་བསལ་བ་ཡིན་ཏེ།",
    "འདི་ལྟར་ཤིང་ཐམས་ཅད་ནི་མཚན་མོ་ལོ་མ་འཁུམ་པ་ལ་བརྟེན་༦པ་མ་ཡིན་ཏེ།",
    "བྱ་ཉིད་སྨོས་པས་ཐུན་མོང་གི་མ་ངེས་པ་ཉིད་བསལ་ཏེ།",
    "ངེས་པའི་ཚིག་གིས་ནི་རྗེས་སུ་འགྲོ་བ་ལ་ཐེ་ཚོམ་ཟ་བའི་མ་ངེས་པ་ཉིད་བསལ་བ་ཡིན་ཏེ།",
    "འགལ་བ་ནི་མི་མཐུན་པའི་ཕྱོགས་ལ་ཡོད་པ་ཡིན་ན་ནོ་། ཉིད་སྨོས་པའི་༨མི་མཐུན་པའི་ཕྱོགས་གཅིག་ལ་ཐུན་མོང་དུ་ཡོད་པ་བསལ་བ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་གང་གིས་སྒྲུབ་པར་བྱེད་པ་དང་བསྒྲུབ་པར་བྱ་བ་དང་འབྲེལ་བར་རྟོགས་པར་འགྱུར་བ་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ངེས་པ་དང་ལྡན་པ་དག་ཁོ་ནར་སྦྱར་༧བར་བྱ་བ་ཡིན་ནོ།",
    "མི་མཐུན་པའི་ཕྱོགས་བསྟན་པས་དེ་དག་གི་མཚན་ཉིད་བརྗོད་དགོས་ས་སོ།",
    "གང་གིས་ཕྱོགས་དང་མཐུན་པའི་ཕྱོགས་མཐུན་པ་༐",
    "དེ་དང་འགལ་བ་ནི་ཇི་སྲིད་དུ་ཕྱོགས་ཀྱི་རང་གི་ངོ་བོ་མེད་པའི་༡ནི་མི་ཤེས་པ་དེ་སྲིད་དུ་ཁོང་དུ་ཆུད་པར་མི་ནུས་སོ།",
    "ཡང་གི་སྒྲས་ནི་བརྗོད་པར་བྱ་བ་གཞན་བསྡུས་པའི་ཕྱིར་རོ།",
    "བྱ་འོན་ཏེ་གང་གི་ཕྱིར་དེང་༡དམིགས་པ་མཚོན་པར་བྱེད་པའོ།",
    "གང་གི་༢རང་ལ་དམིགས་པ་མཐོང་བའི་རྒྱུ་ཚོགས་པར་གྱུར་པའོ།",
    "གང་གི་ཚེ་དེ་ཚོགས་པར་རིག་པར་བྱ་ཞེ་ན།",
    "གང་གི་ཚེ་ཤེས་པ་གཅིག་ལ་འདྲེ་བའི་ད་ངོས་པོ་གཞན་དམིགས་པ་སྟེ།",
    "བ་ནི་༡བུམ་པས་ད་བེན་པའི་ས་ཕྱོགས་དང་དེའི་ཤེས་པ་ཚིག་༢གི་ཤུགས་ཉིད་ཀྱིས་སྣང་བ་མི་དམིགས་པའི་ངོ་བོ་ཡིན་པར་སྨྲ་བར་ལྟའོ།",
    "བདག་ཉིད་ཡོད་པ་དེ་འབའ་ཞིག་ནི་རང་ཡོད་པ་ཙམ་མ་མོ།",
    "དེའི་དོན་ནི་འདི་ཤིང་གི་ཐ་སྙད་དུ་བྱར་རུང་བ་ཡིན་ཏེ།",
    "དེ་ལ་ཤིང་ཤ་པ་མང་དུ་ཡོད་པའི་ཡུལ་ན་གང་གི་ཚེ་ཤིང་ཤ་པའི་ཐ་སྙད་མི་ཤེས་པའི་གླེན་པ་ཞིག་ལ་ཁ་ཅིག་གིས་ཤིང་ཤ་པ་རིང་པོ་ཞིག་༡བསྟན་ཏེ།",
    "རང་གི་ངོ་བོ་ལས་ནི་མ་ཡིན་ན་ནོ།",
    "ཐ་དད་པ་དང་ཐ་དད་པ་མ་ཡིན་པ་ཡང་གཅིག་གིས་སྤངས་ཏེ་གནས་པས་གཏན་༤ཐ་དད་པ་ཡིན་ན་ནོ།",
    "ཐ་དད་པ་ད་ང་ཐ་དད་པ་མ་ཡིན་པ་༥ཡང་གཅིག་གིས་གཅིག་སྤངས་ཏེ་གནས་པས་གཏན་ཚིགས་ཐ་དད་པ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོས་ནི་མ་ཡིན་ནོ།",
    "རང་བཞིན་འབྲེལ་པ་ཉད་ནི་འབྲེལ་པའི་རང་བཞིན་ཉིད་ཅེས་བྱ་བའི་དོན་ཏེ་རྒྱུ་དང་རང་གི་ངོ་བོ་བསྒྲུབ་པར་བྱ་བ་༐",
    "ན་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "གང་གི་ཕྱིར་རང་བཞིན་འབྲེལ་པ་ཡོད་ན་སྒྲུབ་པར་བྱེད་པའི་དོན་གྱིས་བསྒྲུབ་པར་བྱ་བའི་དོན་གོ་བར་བྱེད་པ་ཡིན་པ་དེ་བས་ན་གསུམ་ཆར་ཡང་གོ་བར་བྱེད་པ་ཉིད་ཡིན་ལ། ༐",
    "གང་གི་ཕྱིར་སྒྲུབ་པར་བྱེད་པ་ནི་བསྒྲུབ་པར་བྱ་བའི་རང་བཞིན་ཡིན་པ་དེ་བས་ན་དེར་རང་བཞིན་འབྲེལ་༡ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་ཞིག་གང་གི་རང་བཞིན་དང་གང་ལས་བྱུང་བ་ཡང་མ་ཡིན་པ་དེ་ནི་དེའི་རང་བཞིན་མ་ཡིན་༐",
    "དེའི་བདག་ཉིད་དང་དེ་ལས་བྱུང་བ་ཁོ་ནས་རང་བྱ་བཞིན་འབྲེལ་པ་ཡིན་དུ་ཟད་མོད།",
    "གང་གི་ཕྱིར་རང་བཞིན་དང་འབྲས་བུ་ཁོ་ན་ལ་དེའི་བདག་ཉིད་ད་དང་།",
    "དགག་པའི་ཐ་སྙད་བསྒྲུབ་༢ིཔ་ནི་གང་གི་ཕྱིར་སྣང་བ་མི་དམིགས་པ་ཅི་སྐད་སྨོས་པ་ཁོ་ན་ལས་འགྱུར་ཏེ།",
    "དེར་དགག་པར་བྱ་བའི་དངོས་པོ་ཡོད་ན་ནི་གང་གི་ཕྱིར་སྣང་བ་མི་དམིགས་པ་མི་སྲིད་ད་དོ།"
  ]
}