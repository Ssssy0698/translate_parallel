    "རང་བཞིན་གྱི་དངོས་པོ་རང་གི་ངོ་བོ་མི་དམིགས་པའོ།",
    "དཔེ་ནི་ད་པེར་ན་འདི་ན་དུ་བའི་རྒྱུ་ནུས་པ་ཐོགས་པ་མེད་པ་དག་མེད་དེ་ཞེས་བྱ་བ་སྨོས་ཏེ་ནུས་པ་ཐོགས་པ་མེད་པ་མེ་དང་བུད་ཤིང་ལ་སོགས་པ་དུ་བའི་རྒྱུ་གང་དག་ལ་ཡོད་པ་དེ་དག་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "ད་པེ་ནི་དཔེར་ན་འདི་ན་མེ་ཡོད་པའི་ཕྱིར་གྲང་བའི་རེག་པ་མེད་དོ་ཞེས་བྱ་བ་ལྟ་བུའོ་ཞེས་བྱ་བ་སྨོས་པའོ།",
    "འདི་ལྟར་མེ་ནི་གྲང་བའི་རེག་པ་དང་ལྷན་ཅིག་པར་འགལ་བས་དེ་ཡོད་ན་གྲང་བའི་རེག་༢ིཔ་ཟློག་པར་བྱེད་དོ།",
    "དཔེར་ན་འདི་ན་དུ་བ་ཡོད་པའི་ཕྱིར་གྲང་བའི་རེག་པ་མེད་དོ་ཞེས་བྱ་བ་ལྟ་བུའོ་ཞེས་བྱ་བས་ནི་༐",
    "གྲང་བའི་རེག་པ་དང་འགལ་བ་ནི་མེ་ཡིན་ལ།",
    "གང་ལ་༥མེ་ཡོད་པ་དེ་ན་གྲང་བའི་རེག་པ་ག་ལ་ཡོད།",
    "གང་ན་མེ་ཡོད་པ་དེ་ན་གྲང་བའི་རེག་༡༧པ་ག་ལ་ཡོད།",
    "གང་ན་གྲང་བའི་རེག་པ་མེད་པ་༐",
    "དེར་ནི་༡༧གྲང་བའི་རྒྱུའི་ནུས་པ་ཐོགས་པ་མེད་པ་གང་༡༧དག་ཀྱང་ཡོད་རེ་སྐན་གལ་ཏེ་དེ་ལྟ་བུའི་རྣམ་པ་དག་ཡོད་ན་ནི་གདོན་མི་ཟ་བར་གྲང་བར་ཡང་འགྱུར་ར་རོ།",
    "གང་༡དཔེར་ན་འདི་ན་མེ་ཡོད་པའི་ཕྱིར་བ་མོའི་རེག་པ་མེད་དོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "བ་མོའི་རེག་པ་མེད་དོ་ཞེས་བྱ་བས་ནི་བསྒྲུབ་པར་བྱ་བའི་ཚིག་༢ི་བསྟན་ཏོ།",
    "བ་མོའི་རེག་པ་ནི་ཁ་བའི་རེག་པའོ།",
    "དེ་ལ་ཁྱབ་པར་བྱེད་པ་ནི་གྲང་བའི་རེག་པའོ།",
    "དེ་བས་ན་གང་ལ་མེ་ཡོད་པ་དེ་ནི་༤གྲང་བའི་རེག་པ་ག་ལ་ཡོད།",
    "གང་ན་གྲང་བའི་རེག་པ་མེད་པ་༐",
    "དེར་ནི་༥བ་མོའི་རེག་པ་ཡང་ཡོད་རེ་སྐན།",
    "གང་ན་མེ་མེད་པ་དེ་ན་དུ་བ་ཡོད་རེ་སྐན།",
    "དེ་བས་ན་འདིར་སྤུ་ལོང་ཞེས་བྱེད་པ་ལ་སོགས་པའི་བྱེ་བྲག་གི་རྒྱུ་ནི་གྲང་བའི་རེག་པ་ཡིན་ན་ནོ།",
    "མེ་ཉེ་ན་གྲང་བའི་རེག་པ་ཟློག་པར་བྱེད་ད་དོ།",
    "བྱ་བ་༦ལ་སོགས་པའི་བྱེ་བྲག་ལྟ་ཡོད་རེ་སྐན།",
    "འདིར་སྤུ་ལོང་ཞེས་བྱེད་པ་ལ་སོགས་པའི་བྱེ་བྲག་གི་རྒྱུ་ནི་གྲང་བའི་རེག་པ་ཡིན་ནོ།",
    "གང་ན་མེ་ཡོད་པ་དེ་ན་གྲང་བའི་རེག་པ་མེད་ད་དོ།",
    "གང་ན་གྲང་བའི་རེག་པ་མེད་པ་དེ་ན་གྲང་བའི་འབྲས་བུ་སྤུ་ལོང་ཞེས་བྱེད་པ་ལ་སོགས་པ་དག་ལྟ་ཡོད་པར་ག་ལ་འགྱུར།",
    "རང་བཞིན་འགལ་བ་དམིགས་པ་ལ་སོགས་པ་དག་གིས་ད་གག་པར་བྱེད་ཅེ་ན།",
    "དགག་པ་དག་གི་ཞསྦྱོར་བ་ཐ་དད་ཀྱང་བརྒྱུད་པའི་སྒོ་ནས་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དགག་པ་དག་གིས་སྦྱོར་བ་ཐ་དད་དུ་གྱུར་ཀྱང་།",
    "འདི་ལྟར་རེ་ཞིག་འབྲས་བུ་མི་དམིགས་པ་དག་ལ་ནི་དུ་བ་མེད་པས་ན།",
    "གང་ན་དུ་བ་མེད་པ་དེ་ན་དེའི་རྒྱུ་དམིགས་པའི་རེག་༦བྱར་གྱུར་པ་ཁོ་ན་དག་མི་ད་མིགས་པས།",
    "གང་ན་མེ་ཡོད་པ་དེ་ན་དམིགས་པའི་རེག་༨བྱར་གྱུར་པ་གྲང་བའི་རེག་པ་མི་དམིགས་པས་རང་བཞིན་མི་དམིགས་པའི་ནང་དུ་འདུའོ།",
    "བྱ་བ་༢དང་ཐ་མི་དད་པ་དག་གིས་བྱེ་བྲག་མེད་པར་ཉེ་བར་བཏགས་ནས།",
    "རང་བཞིན་མི་དམིགས་པའི་ནང་དུ་འདུའོ་ཞེས་བརྗོད་པ་དེ་དག་གི་དེ་ནི་བཏགས་པས་འདུ་བ་ཡིན་གྱི་དོན་དམ་པར་ནི་མ་ཡིན་ན་ནོ།",
    "རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ནི་སྦྱོར་བ་མི་སྲིད་པ་༨ཡིན་ན་ནམ།",
    "བདག་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ཡང་བྱེ་བྲག་བསྟན་ཏོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "བདག་ཉིད་ཀྱང་གང་གི་ཚེ་འགའ་ཞིག་རྣམ་པར་༐",
    "དེ་༡བས་ན་བདག་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ཡང་མི་དམིགས་པའི་སྦྱོར་བའི་བྱེ་བྲག་བསྟན་ཏོ།",
    "ཡང་དག་པའི་ཤེས་པ་བསྟན་པའི་ཞར་ལ་རང་གི་དོན་དང་།",
    "སྦྱོར་བའི་བྱེ་བྲག་གིས་ཞེས་བྱ་བ་སྨོས་ས་སོ།",
    "དེའི་ཕྱིར་༡༧བྱེ་བྲག་གིས་རྣམ་པ་གཉིས་ཉིད་ད་དོ།",
    "དེ་ཅིའི་ཕྱིར་སྦྱོར་བའི་བྱེ་བྲག་གིས་རྣམ་པ་གཉིས་ཏེ་ཞེས་བརྗོད་ཅེ་ན།",
    "དོན་ལ་ནི་བྱེ་བྲག་ཕྲ་མོ་ཡང་མེད་དོ།",
    "དཔེར་ན་རི་བོང་གི་རྭ་ལ་སོགས་པ་གཞན་འགའ་ཞིག་མཐོང་བ་བཞིན་བྱ་ཏྲ་དུ་ཞེས་བྱ་བ་ལ།",
    "མེད་པའི་ཐ་སྙད་ཀྱི་ཡུལ་དུ་མཐོང་བ་འདི་༡ནི་དཔེར་ན་རི་བོང་གི་རྭ་ལ་སོགས་པ་ལྟ་བུའོ།",
    "འདི་ལྟར་སྐྱེ་བ་ནི་དངོས་སུ་སྐྱེ་བ་དང་ལྡན་པ་དང་ཐ་མི་དད་མོད།",
    "ཁྱད་པར་གྱི་བྱེ་བྲག་གིས་ཏེ་ཞེས་བྱ་བ་ལ་ཁྱད་པར་ནི་བྱེ་བྲག་སྟེ།",
    "རང་གི་ངོ་བོ་གྲུབ་པར་བྱ་བའི་ཕྱིར་ར་རོ།",
    "དངོས་པོ་གང་ཞིག་གིས་རང་གི་ངོ་བོ་སྒྲུབ་པའི་ཕྱིར་རྒྱུ་རྣམས་ཀྱི་བྱེད་པ་ལ་༐",
    "རྐྱེན་གྱི་བྱེ་བྲག་གིས་ཐ་དད་པ་ཅན་ཉིད་ལ་སོགས་པ་ཡང་དེ་བཞིན་དུ་བལྟ་༦བར་བྱའོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་དེ་དག་ཀྱང་ཁྱད་པར་གྱི་བྱེ་བྲག་ལ་ལྟོས་༧པ་ཁོ་ནས་ཡིན་པར་བལྟ་བར་བྱ་སྟེ།",
    "འདི་རྐྱེན་གྱི་བྱེ་བྲག་ལས་ཐ་དད་པའི་ངང་ཚུལ་ཅན་ཡིན་པས་འདི་ནི་རྐྱེན་གྱི་བྱེ་བྲག་གིས་༩ཐ་དད་པ་ཅན་ནོ།",
    "དེའི་དངོས་པོ་ནི་རྐྱེན་གྱི་བྱེ་བྲག་གིས་ཐ་དད་པ་ཅན་ཉིད་དེ་༡།",
    "རྒྱུའི་བྱེ་བྲག་གིས་རྗེས་སུ་མཐུན་པ་ཅན་ཉིད་ཅེས་བྱ་བའི་ཐ་ཚིག་ག་གོ།",
    "རང་གི་བསྒྲུབ་པ་ཇི་ལྟ་བུ་དག་གིས་ཞེས་བྱ་བ་སྟེ།",
    "འདི་ལྟར་རང་གི་ངོ་བོའི་༢རྟགས་སུ་ངེས་ན་གོ་བར་བྱེད་པ་ཡིན་གྱི་མ་ངེས་པ་ནི་མ་ཡིན་ནོ།",
    "ཇི་སྐད་དུ་སྨྲས་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་བ་མེད་ད་དོ།",
    "དེའི་བདག་གི་དངོས་པོ་ནི་དེའི་བདག་ཉིད་དོ།",
    "དེས་ནི་ལྡོག་པ་བརྗོད་པས་འབྲེལ་པར་བསྟན་པར་བྱའོ་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་འབྲེལ་པ་ཡོད་ན་༢ི་གཅིག་ལོག་པས་གཞན་ལྡོག་པར་འགྱུར་གྱི།",
    "དེ་ལྟ་བས་ན་ལྡོག་པའི་ཚིག་གིས་ནི་འབྲེལ་པ་༧བསྡུས་པ་ཁོ་ན་ཡིན་ལ་ཞེས་བྱ་བ་ནི་ལྡོག་པའི་ཚིག་ཁོ་ནས་འབྲེལ་པ་སྡུད་པར་བྱེད་དོ།",
    "དེ་ལྟ་བུ་མེད་དོ་ཞེས་བྱ་བར་རྟོགས་པའི་ཕྱིར་རྗེས་སུ་འགྲོ་བ་གྲུབ་བོ་ཞེས་བྱ་བ་ནི་གང་གི་ཚེ་དམིགས་པའི་རིག་བྱར་གྱུར་པ་ཡོད་ན་གདོན་མི་ཟ་བར་དམིགས་པར་འགྱུར་རོ་ཞེས་ལྡོག་པ་བརྗོད་པ་དེའི་ཚེ།",
    "རང་གི་ངོ་བོ་ཁོ་ན་དང་།",
    "དེ་ནི་རེ་ཞིག་བསྡུས་པའི་དོན་ཡིན་ན་ནོ།",
    "ཡན་ལག་གི་དོན་ནི།",
    "རང་གི་ངོ་བོས་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་ཁོ་ནར་འདོད་པར་༢ཞེས་བྱ་བ་ནི་ཕྱོགས་ནི་བསྒྲུབ་པར་བྱ་བའི་ངོ་བོ་མ་གཏོགས་པ་ངོ་བོ་གཞན་དུ་འོས་པ་མ་ཡིན་པས།",
    "རང་གི་ངོ་བོ་ཁོ་ནས་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་ཁོ་ནར་འདོད་པ་ཡིན་གྱི།",
    "དཔེར་ན་སྒྲ་མི་རྟག་པ་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བ་ལ་གཏན་ཚིགས་མིག་གིས་གཟུང་བ་ཉིད་ནི་སྒྲ་ལ་མ་གྲུབ་པའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "མིག་གིས་གཟུང་༡བ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་སྨྲ་བར་བྱེད་པ་དེའི་མིག་གིས་གཟུང་བ་དེ་ནི་སྒྲ་ལ་མ་གྲུབ་པས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན་ནོ།",
    "དེའི་ཕྱིར་བསྣན་པ་མེད་པ་༢མིག་གིས་གཟུང་བ་བསྟན་པ་ཡང་ཕྱོགས་ཉིད་དུ་ཐལ་བར་འགྱུར་ར་རོ།",
    "མིག་གིས་གཟུང་བ་ཉིད་ལ་བསྒྲུབ་པར་བྱ་བའི་ངོ་བོ་ཉིད་ཡོད་མོད་ཀྱི།",
    "འོན་ཀྱང་གཏན་ཚིགས་ཉིད་དུ་སྟོན་པ་ན་བསྒྲུབ་པར་བྱ་བའི་རང་གི་ངོ་བོ་ཁོ་ན་འབའ་ཞིག་ནི་མ་ཡིན་ཏེ།",
    "དེ་བས་ན་བསྒྲུབ་པར་བྱ་བ་ཡིན་ཡང་སྒྲུབ་པའི་ངོ་བོ་ལྷག་པར་ཡོད་པའི་ཕྱིར་བསྣན་པའི་ཚིག་གིས་༤ཕྱོགས་ཉིད་ཡིན་པ་ཟློག་༥ག་གོ།",
    "གལ་ཏེ་བསྟན་བཅོས་འགའ་ཞིག་ལ་བརྟེན་ཏེ་སྒྲུབ་པ་སྨྲ་ན་ཡང་ཞེས་བྱ་བ་ནི་རེ་ཞིག་༩བསྟན་བཅོས་འགའ་ཞིག་ལ་བརྟེན་ཏེ།",
    "ཕྱོགས་སུ་བྱ་བའི་ངེས་པ་༡༧ཡིན་པ་དེ་ནི་ངེས་པ་མེད་མོད་ཀྱི་འོན་ཀྱང་གལ་ཏེ་བསྟན་བཅོས་ཁས་བླང་ས་ཏེ།",
    "འདི་སྐད་དུ་གང་གི་ཚེ་རྒོལ་བས་བསྟན་༐",
    "གལ་ཏེ་ལོག་པར་རྟོག་༩པའི་ཡུལ་དོན་དེ་ཚིག་གིས་མ་བརྗོད་ཀྱང་།",
    "དེའི་ཕྱིར་དེ་༡ཁོ་ནར་རྩོད་པ་གང་གི་ཕྱིར་རྩོད་པ་དེ་ཇི་ལྟར་ན།",
    "འདིར་བད་ག་གི་དོན་ཞེས་མ་བརྗོད་ཀྱང་བདག་གི་དོན་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་སྦྱོར་བ་འདིར་གལ་ཏེ་དམིགས་༢ལ་སོགས་པ་ནི་བད་ག་གི་དོན་ཏོ་ཞེས་མ་བརྗོད་ཀྱང་བདག་གི་དོན་ཁོ་ནར་སྒྲུབ་པར་བྱེད་དོ།",
    "དེས་ན་སྨྲས་པ་ཙམ་ཁོ་ན་ཉིད་༦བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིཕྱིར།",
    "རང་གི་ཚིག་རྣམས་ཀྱིས་སེལ་བ་གང་ཡིན་པ་དེ་ནི་ཕྱོགས་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི།",
    "རང་གི་ཚིག་གིས་སེལ་བར་བྱེད་ན།",
    "འདི་ལྟར་རྣ་བའི་རྣམ་པར་ཤེས་པ་སྒྲའི་རྣམ་པར་སྣང་བ་ནི་༤སྲོག་ཆ་གས་སོ་ཅོག་གིས་རང་༐",
    "དེས་ན་མཉན་པར་བྱ་བ་ཉིད་དུ་རང་གིས་༦རིག་པའི་གྲགས་པས་མཉན་དུ་མི་རུང་བ་ཉིད་སེལ་བར་བྱེད་ད་དོ།",
    "དེ་ནི་རི་བོང་ཅན་ཟླ་བའི་སྒྲར་བརྗོད་པ་ཉིད་དུ་གནག་རྫི་མོ་ཡན་ཆད་༨ལ་གྲགས་པས་སེལ་བར་བྱེད་ད་དོ།",
    "དེ་ནི་རང་གི་ཚིག་དང་འགལ་ཏོ་༡།",
    "ཕྱོགས་ལྟར་སྣང་བ་བཞིན་༢བསལ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་ལུང་དང་འགལ་བ་ནི་རང་གི་ཚིག་དང་འགལ་བའི་ཁོངས་སུ་འདུས་པར་མཁྱེན་ནས།",
    "འདིར་བཟློག་པ་ཞེས་བྱ་བ་ནི་རེ་རེ་ལ་ཡང་སྦྱར་བར་བྱ་སྟེ།",
    "དེ་ལྟར་རེ་ཞིག་དེ་ནི་བཟློག་པའི་སྒོ་ནས་ཕྱོགས་ཀྱི་མཚན་ཉིད་བསྟན་པ་ཡིན་ན་ནོ།",
    "དེ་ལྟར་རེ་ཞིག་བསྒྲུབ་༡༧པ་ལྟར་སྣང་བ་སྤྱིར་བསྟན་ཏོ།",
    "དཔེ་བསྟན་པའི་ཕྱིར་དཔེར་ན་སྒྲ་མི་རྟག་པར་བ་སྒྲུབ་པ་ལ་མིག་གིས་གཟུང་བ་ཉིད་ནི་གཉི་ག་ལ་མ་གྲུབ་པ་ལྟ་བུའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "སྒྲ་མིག་གིས་གཟུང་བར་བྱ་བ་མ་༡ཡིན་པར་ནི་རྒོལ་བ་དང་ཕྱིར་རྒོལ་བ་གཉིས་ག་༢ཡང་ཁས་མི་ལེན་ཏོ།",
    "ཤིང་རྣམས་ལ་སེམས་པ་ཡོད་པར་བསྒྲུབ་༢ིཔ་ལ་ཤུན་པ་ཐམས་ཅད་བཤུས་ནས་༤འཆི་བ་ནི་ཕྱིར་རྒོལ་བ་ལས་༥མ་གྲུབ་ཅེས་བྱ་བ་ནི་གང་གི་ཚེ་ཕྱོགས་ཀྱི་གོས་ཅན་ན་རེ་ཤིང་རྣམས་ལ་སེམས་པ་ཡོད་དེ་༦།",
    "བདེ་བ་ལ་སོགས་པ་སེམས་པ་མེད་པར་སྒྲུབ་པ་ལ་སྐྱེ་༡༧བ་ཅན་ནམ་མི་རྟག་པ་ཉིད་ནི་གྲངས་ཅན་རྒོལ་བ་བདག་ཉིད་ལ་མ་གྲུབ་པའོ་ཞེས་བྱ་བ་༡༧གང་གི་ཚེ།",
    "གྲངས་ཅན་ན་རེ་བདེ་བ་ཅན་༡༧ལ་སོགས་པ་ནི་སེམས་པ་མེད་པ་སྟེ།",
    "དེའི་གཞི་ལ་ཐོ་ཚོམ་ཟ་ན་མ་གྲུབ་ཅེས་བྱ་བ་ནི་གང་གི་ཚེ།",
    "དེ་དག་གི་དངོས་པོ་ནི་རླངས་པ་ལ་སོགས་པའི་དངོས་པོ་སྟེ།",
    "མེ་གྲུབ་པར་བྱ་བ་ལ་དེ་གཏན་ཚིགས་སུ་བྱེད་ན་གང་གི་ཚེ་འདི་ཅི་རླངས་པའམ།",
    "བདེ་བ་ལ་སོགས་པ་ནི་བདག་གི་ཡོན་ཏན་རྣམས་ཡིན་ཞེས་གྲགས་༢ལ་དེ་དག་ཀྱང་ཡུལ་ཐམས་ཅད་ན་གནས་པའི་༐",
    "གང་གི་ཕྱིར་དེའི་ཡོན་ཏན་ཐམས་ཅད་ནི་༤དམིགས་པ་དེའི་ཕྱིཕྱིར།",
    "རེག་པ་མ་ཡིན་པའི་ཕྱིར་སྒྲ་ནི་རྟག་གོ་ཞེས་སྒྲུབ་༢ིཔ་ལ་རེག་པ་མ་ཡིན་པ་ཉིད་ནི་མཐུན་པའི་ཕྱོགས་དང་མི་མཐུན་པའི་ཕྱོགས་༐",
    "དེས་ནི་ཐུན་མོང་གི་མ་ངེས་པ་རྣམ་༥པ་བཞི་བསྟན་ཏོ།",
    "གང་གི་ཚེ་ཐོ་ཚོམ་དུ་གྱུར་པ་དེའི་༦ཚེ་ཡང་མ་ངེས་པ་ཁོ་ན་ཡིན་ནོ།",
    "གྲང་བ་དང་ཚ་བའི་རེག་པ་ལྟ་བུའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "གང་གི་ཚེ་ད་ངོས་པོའི་རྒྱུའི་ཚིག་༤མ་ཉམས་པར་རྒྱུ་ཆགས་སུ་འཇུག་པ་ན།",
    "གང་གི་ཚེ་ཚ་བ་ཉེ་བར་གྱུར་པ་དེའི་ཚེ་གྲང་བ་ལྡོག་པར་འགྱུར་བ་དེ་༦ལྟ་བུ་སྟེ།",
    "ཡོད་པ་དང་མེད་པ་ལྟ་བུའོ་ཞེས་བྱ་བ་ནི་གང་ཞིག་༢ིགཅིག་གིས་གཅིག་སྤངས་ཏེ་གནས་པའི་མཚན་ཉིད་དེ་དག་ནི་གཅིག་གིས་གཅིག་སྤངས་ཏེ་གནས་པའི་མཚན་ཉིད་དག་གོ།",
    "དེའི་དངོས་པོ་ནི་གཅིག་གིས་གཅིག་སྤངས་ཏེ་གནས་པའི་མཚན་ཉིད་ཁོ་ན་སྟེ་དེས་འགལ་བའོ།",
    "སྨྲ་བ་ཉིད་ཀྱིས་༥ལྡོག་པ་ལ་ཐེ་ཚོམ་ཟ་བ་ནི་རེ་ཞིག་དེ་ལྟ་བུ་ཡིན་ན་ནོ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ནི་༧ཚིག་གི་རྒྱུ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ནི་མ་གྲུབ་བ་བོ།",
    "དེ་ལྟར་ན་ཚིག་ལ་སོགས་པ་ལྡོག་པ་ལ་ཐེ་ཚོམ་ཟ་བ་དང་ལྡན་པའི་མ་ངེས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་དེ་ལྟར་སྨྲ་བ་ཉིད་ད་དང་།",
    "༡ཚུལ་གཉིས་ཀྱི་ཕྱིན་ཅི་ལོག་ཏུ་རྟོགས་༢པ་ནི་འགལ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གང་གི་ཚེ་ཚུལ་གཉིས་ཀྱི་ཕྱིན་ཅི་ལོག་ཏུ་གྲུབ་པ་དེའི་ཚེ་འགལ་བའི་གཏན་ཚིགས་ལྟར་སྣང་བ་ཡིན་ན་ནོ།",
    "གཉིས་པོ་གང་དག་གི་ཞེ་ན་ཞེས་བྱ་བ་ནི་ཚུལ་གཉིས་པོ་གང་དག་ཕྱིན་ཅི་ལོག་ཏུ་རྟོགས་པ་ནི་༢ིགཏན་ཚིགས་འགལ་བ་སྟོན་པར་བྱེད་པའོ།",
    "དེ་ནི་རེ་ཞིག་འགལ་བའི་མཚན་ཉིད་སྤྱིར་བསྟན་པ་ཡིན་ན་ནོ།",
    "དེ་ལྟར་ན་དེ་གཉིས་ཀྱིས་༡༧ཕྱིན་ཅི་ལོག་ཏུ་གྲུབ་པ་ཡིན་ན་ནོ་། དེ་གཉིས་ནི་བསྒྲུབ་པར་བྱ་བའི་༡༧ཕྱིན་ཅི་ལོག་ཏུ་གྲུབ་༡༧པའི་ཕྱིར་འགལ་བ་དག་ཡིན་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ཚུལ་དེ་གཉིས་ཀྱིས་༡༧ཕྱིན་ཅི་ལོག་ཏུ་གྲུབ་པ་བྱ་ིདེའི་ཕྱིར།",
    "གཞན་དག་གི་དོན་བྱེད་པ་ནི་གཞན་གྱི་དོན་བྱེད་པའོ།",
    "བྱ་ཐམས་ཅད་མཁྱེན་པ་དང་འདོད་ཆགས་དང་བྲལ་བ་དག་ནི་བསྐལ་པ་ཡིན་པའི་ཕྱིར་དེ་ལ་ཚིག་ལ་སོགས་པ་ཡོད་དམ་མེད་པར་ཐེ་ཚོམ་ཟ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་སྨོས་ཏེ་གང་གི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ད་དང་།",
    "ཚུལ་དེ་གཉིས་ཉིད་ལ་ཐེ་ཚོམ་ཟ་ན་མ་ངེས་པ་ཡིན་༡ཞེས་བྱ་བ་ནི་གང་གི་ཚེ་རྗེས་སུ་འགྲོ་བའགྲོ་བའམ།",
    "འདི་རེ་རེ་ཤིང་༦ལྡོག་པ་ལ་ཐོ་ཚོམ་ཟ་བ་བསྟན་པའི་ཕྱིར།",
    "རྣམ་པར་གཅོད་པ་དག་གིས་ཐམས་ཅད་༐",
    "བདག་གི་གནས་པ་དང་རྣམ་པར་གཅོད་པ་ནི་བདག་གནས་པ་དང་རྣམ་པར་གཅོད་པ་དག་གོ།",
    "དེ་ལྟར་རེ་ཞིག་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་གཉིས་ཡོད་པར་མ་གྲུབ་པ་ཡིན་ན་ནོ།",
    "གང་གི་ཚེ་དེ་གཉིས་གཅིག་ལ་གཅིག་མེད་པའི་ངོ་བོར་གནས་པ་དེའི་ཚེ་རྗེས་སུ་འགྲོ་བ་མེད་པར་ངེས་པ་གང་ཡིན་པ་དེས།",
    "གང་གི་ཕྱིར་དེ་ལྟར་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་གཉིས་ལ་གཅིག་མེད་པར་ངེས་ན།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་གཉིས་ལ་ཐེ་ཚོམ་ཟ་བའི་མ་ངེས་པ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་ལ་ཐོ་ཚོམ་ཟ་བ་ཉིད་ཀྱི་ཕྱིར་དེ་ཉིད་༤མ་ངེས་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་དང་། ༐",
    "ཚུལ་རེ་རེའམ།",
    "དེ་འདིར་ནི་མ་སྨོས་སོ་ཞེས་བྱ་བ་ནི་བདག་གིས་མ་བསྟན་པའོ།",
    "དེའི་དོན་དཔྱད་པ་དག་ལ་ཞེས་བྱ་བ་ནི་ལུང་གི་དོན་དཔྱད་པ་དག་ལའོ།",
    "འབྲེལ་པ་ཅན་དེ་དག་གི་ཡུལ་ནི་དེའི་ཡུལ་ལ་ལོ།",
    "ཐམས་ཅད་དུ་སོང་བ་ཁོ་ནས་འབྲེལ་པ་ཅན་རྣམས་ཁྱབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ག་ལས་ཤེ་ན།",
    "དེའི་ཡུལ་ཞེས་བྱ་བ་ནི་ཡུལ་དེ་གང་གི་ཡིན་པ་དེ་ནི་དེའི་ཡུལ་ལ་ལོ།",
    "ད་རེ་ཞིག་དེ་ལྟར་གཟེགས་ཟན་པ་ཁ་ཅིག་གིས་སྤྱི་ནི་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་༦ན་གནས་པ་མ་༧ཡིན་པར་བསྟན་ཏོ།",
