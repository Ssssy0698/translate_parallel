    "ལྕགས་ལམ་བཏིངས་རྗེས་རང་གི་སྒེར་དོན་ཆེད་འགྲིམ་འགྲུལ་ཡོ་བྱད་ལ་གང་བྱུང་དུ་གཏོར་བརླག་གཏོང་བ་ལྟ་བུ་དང་།",
    "བུད་མེད་དང་བྱིས་པ་གཡོ་ཚོང་བྱེད་པའི་བྱས་ཉེས་སོགས་རྒྱུ་ནོར་ལ་འདོད་རྔམ་ཆེ་བའི་བྱས་ཉེས་ཕར་ཞོག་འདོད་རྔམ་རང་བཞིན་ལ་འབྲེལ་བ་མེད་པའི་བྱས་ཉེས་ཏེ།",
    "ཁྱིམ་ཚང་ཁྲོད་ཕོ་མཆོག་མོ་དམན་གྱི་བསམ་བློས་རྒྱུད་བརླམས་པའི་རྐྱེན་གྱིས།",
    "བུད་མེད་ལ་བརྙས་བཅོས་དང་།",
    "རང་རྒྱལ་གྱི་ཞིང་པ་མང་པོ་ཞིག་གིས་ད་དུང་གནམ་བརྟེན་ནས་འཚོ་བ་རོལ་དགོས་པས་དབུལ་ཞིང་ཕོངས་པའི་ཁར།",
    "བཅོས་བསྒྱུར་སྒོ་འབྱེད་འོག་ཕྱུག་པོ་དང་དབུལ་པོའི་བར་ཐག་ཇེ་རིང་དུ་སོང་བ་དང་བསྟུན།",
    "གཉེན་སྒྲིག་དང་བཟའ་ཚང་གི་འབྲེལ་བར་མཚོན་ན།",
    "གཞོན་ནུ་ལོ་ཆུང་མང་ཤོས་ཀྱིས་བརྩེ་དུང་མེད་པའི་བཟའ་ཚང་འཐོར་ན་བཟང་ཞེས་འཚོ་བ་གསར་པར་རེ་སྙེག་བྱས་ཚེ།",
    "རྡུང་རེས་དང་།",
    "ཡོད་ཚད་སྒོར་མོ་ཡིན་པའི་བསམ་བློ་དེས་རྒྱལ་ཁབ་དང་སྤྱི།",
    "མི་གཞན་གྱི་ཁེ་ཕན་ལ་མི་བལྟ་བར་རང་གི་འདོད་པ་སྐོང་ཆེད།",
    "བདག་གིར་འཛིན་པ་སོགས་ཀྱི་བྱས་ཉེས་གསོག་པ་མ་ཟད།",
    "བུ་མོ་ཆུང་ཆུང་དང་མཉམ་བསྡད་འཁྲིག་སྤྱོད་སྤེལ་བ།",
    "ས་ཞིང་ཇེ་ཉུང་དུ་སོང་བ་དང་བསྟུན།",
    "སྔོན་འགོག་གི་ནུས་པ་སྨོས་ཅི་དགོས།",
    "གྲོང་ཚོའི་བདེ་སྲུང་མི་སྣའི་འགན་འཁྲི་གསལ་བོ་མིན་པའམ་ཡང་ན་ནུས་པ་ཆེན་པོ་ཐོན་ཀྱིན་མེད་དེ།",
    "སྤོ་ཐུང་ཐུང་གིས་མི་གཞན་པ་གླས་ཡོང་ནས་ཕག་གསོ་ར་བ་སོགས་མེར་གཏོང་བའི་བྱ་སྤྱོད་ཡོད་པ་མ་ཟད།",
    "ཡུལ་ན་བསྡད་ཡོད་པའི་ཕོ་རྐྱང་མོ་རྐྱང་འགའ་བུད་མེད་དམ་ཕོ་གསར་གཞན་དང་དགའ་གྲོགས་སྒྲིག་པའི་གནས་ཚུལ་རང་གི་བཟའ་ཚང་གི་ཤེས་པའི་རྐྱེན་གྱིས་ཤི་རྨས་ཀྱི་གྱོད་དོན་བྱུང་བའོ།",
    "༤ཕྱུག་པོ་ད་ང་དབུལ་པོ་གཉིས་ཀྱི་བར་ཐག་ཇེ་རིང་དུ་སོང་བ་སྟེ།",
    "མི་འཇོན་ཐང་ཅན་རྣམས་ཕྱུག་པོར་གྱུར་པ་དང་བསྟུན་དེ་དག་གི་ཡོང་སྒོ་དང་།",
    "ཞིང་པ་ལ་ལ་ཞིག་གིས་རང་གི་རྒྱུ་ནོར་ལ་བདག་སྐྱོང་བྱེད་མི་ཤེས་པ་ད་པེར་ན།",
    "གཤམ་གྱི་ཕྱོགས་འདི་དག་གིས་སྔོན་འགོག་བྱ་དགོས་པར་སྙམ།",
    "མང་ཚོགས་ཀྱི་སྐྱིད་སྡུག་ཤེས་པ་དང་།",
    "ཡོངས་ཁྱབ་ཀྱིས་ཏེང་ཞའོ་ཕིང་གི་གཞུང་ལུགས་དང་ཏང་གི་གཞི་རྩའི་ལམ་ཕྱོགས།",
    "ཤི་རུ་འཇུག་པའི་སྒྱིད་ལུག་གི་བྱ་སྤྱོད་དུ་མི་འཛིན་པའི་བྱ་སྤྱོད་གང་རུང་ཡང་ཡིན་ལ།",
    "ཤི་སོང་བའི་མཇུག་འབྲས་བྱུང་མེད་ཚེ།",
    "ཤི་མ་སོང་བའི་མི་དེར་ཤེས་བཞིན་དུ་མི་བསད་པའི་བྱས་ཉེས་སུ་ངོས་འཛིན་བྱེད་མི་ཆོག་གལ་ཏེ་བྱ་སྤྱོད་མཁན་དེར་མངག་བཅོལ་གྱིས་ཕ་རོལ་བ་དེ་བསད་རྗེས།",
    "རང་གིས་རང་སྲོག་ལེན་མ་ཐུབ་པ་ཡིན་ཚེ།",
    "རང་གི་ལག་མི་འགུལ་བར།",
    "འོན་ཀྱང་བྱ་སྤྱོད་མཁན་གྱིས་མི་དེ་ཤི་བར་རེ་བ་བྱས་ཡོད་མེད་དང་།",
    "མི་གཞན་པའི་རང་སྲོག་གཅོད་པར་ངན་སྐུལ་དང་རོགས་བྱེད་པའི་རིགས་དེ་ཤེས་བཞིན་དུ་མི་བསད་པའི་བྱས་ཉེས་ལྟར་ཐག་བཅད་ན་འགྲིག་མོད།",
    "རང་ལོ་སོ་བརྒྱད་ལ་སོན་པའི་བུད་མེད་བཟང་མོ་ནི་ལས་ལ་བརྩོན་ཞིང་གཤིས་རྒྱུད་བཟང་བའི་མནའ་མ་ཡ་རབས་ཤིག་ཡིན་པས།",
    "མི་སུས་ཀྱང་བསྟོད་བསྔགས་བྱེད་ཡུལ་ཞིག་ཡིན་མོད།",
    "རང་གི་ཁྱོ་བོ་གསོད་པའི་དོགས་ཡོད་ཉེས་ཅན་དུ་འགྲོ་པ་སུས་ཀྱང་རྣར་མི་འགྲོ།",
    "ཁྱོ་བོ་སྒོར་འགྲོ་རྒྱུར་དགའ་ལ།",
    "༢༦་ལོའི་ཟླ་༥པའི་ཚེས་༡༢ཀྱི་དགོང་མོ་དེ།",
    "དུག་བཏབ་ཡོད་པའི་ཆང་རྫའི་ནང་གི་ཆང་དཀར་ཡོལ་གང་ཙམ་བླུགས་པ་རེད།",
    "ཁོར་སྦྲིད་པའི་ཚོར་བ་ཙམ་ལས་མ་བྱུང་མོད།",
    "གློག་གིས་བརྒྱབ་སྟེ་སར་འགྱེལ་སོང་།",
    "བྱ་སྤྱོད་འདི་རིགས་ཀྱིས་ལས་འཛོལ་ཤོར་ནས་མི་སྲོག་བཅད་པའི་བྱས་ཉེས་གྲུབ་འདུག་མོད།",
    "འོན་ཀྱང་གསར་བུ་བཞི་བོས་དོན་འདི་ཆུང་ཆུང་ཞིག་རེད་སྙམ་ནས་ཁ་རྩོད་བྱུང་བ་མ་ཟད་ལག་པ་ཡང་འའགུལ་མཐར་བདག་པོ་ལོ་ལོན་དེའི་ལུས་ཁམས་ལ་རྨས་སྐྱོན་བཟོས་སྟབས།",
    "ད་གཟོད་ཉེས་འགན་འཁུར་དགོས་པ་རེད།",
    "ཆང་འཐུང་ཡོད་པའི་དགོང་མོ་ཞིག་ལ།",
    "ཁོ་ཅུང་བཟི་ཡོད་པའི་རྐྱེན་གྱིས་འཛིང་རེས་བྱས་ཀྱང་མ་ཐུབ་སྟབས།",
    "ལམ་ཕྲང་དོག་མོ་དཀྱོགས་མཚམས་ཞིག་ནས་ཁྱིམ་མཚེས་བཀྲ་ཤིས་དང་ཐོགས་པས་སྟབས་མ་ལེགས་པར་བཀྲ་ཤིས་ཀྱི་ལག་པར་རྨས་སྐྱོན་བཟོས་བྱུང་ལ།",
    "བཙན་ཤེད་དམ་ཡང་ན་དེ་མིན་གྱི་བྱེད་ཐབས་གཞན་པ་སྤྱད་དེ་བུད་མེད་དེའི་འདོད་བློ་དང་རྒྱབ་འགལ་གྱིས་བཙན་གཡེམ་བྱས་པའི་བྱ་སྤྱོད་ལ་བསྟན།",
    "བྱས་ཉེས་འདིའི་ཕྱི་ཡུལ་ཕྱོགས་དེ་བུད་མེད་དེའི་འདོད་བློ་དང་འགལ་ཞིང་བཙན་ཤེད་དམ་ཡང་ན་དེ་མིན་གྱི་བྱེད་ཐབས་གཞན་པ་སྤྱད་དེ་བུད་མེད་དེས་ངོ་རྒོལ་བྱེད་མི་ཐུབ་པའམ་བྱེད་མི་ཕོད་པའི་གནས་ཚུལ་འོག་བཙན་གྱིས་དེ་དང་འཁྲིག་སྦྱོར་བྱེད་པའི་བྱ་སྤྱོད་ཀྱིས་མངོན།",
    "མི་མང་མཉམ་རུབ་ཀྱིས་འཁྲིག་སྦྱོར་བྱེད་པའི་བྱས་ཉེས་དག་གི་ཁྱད་པར་འབྱེད་བྱེད་ཡིན།",
    "དྲག་ཤུགས་ཞེས་པ་ནི་བྱ་སྤྱོད་མཁན་གྱིས་བུད་མེད་དེའི་ལུས་ཁམས་ལ་ཐད་ཀར་གཅར་རྡུང་བཏང་སྟེ་ངོ་རྒོལ་བྱེད་མི་ཐུབ་པའམ་བྱེད་མི་ཕོད་པར་བཟོ་བའི་བྱེད་ཐབས་སྣ་ཚོགས་ཏེ།",
    "བྱེད་ཐབས་གཞན་པ་ཞེས་པ་ནི་དྲག་ཤུགས་དང་བཙན་ཤེད་སོགས་ཀྱི་བྱེད་ཐབས་ལས་འདས་པའི་བྱེད་ཐབས་གཞན་དག་གིས་བུད་མེད་དེས་ངོ་རྒོལ་བྱེད་མི་ཕོད་པའམ་ཡང་ན་མི་ཐུབ་པའི་གནས་སུ་བསྐྱལ་བ་སྟེ།",
    "ཆང་གིས་བཟི་རུ་འཇུག་པ།",
    "འགབ་མཐུན་ཞེས་པ་ནི་ཕོ་མོ་ཕྱོགས་གཉིས་ཀའམ་ཡང་ན་ཕྱོགས་གཅིག་ལ་བཟའ་ཟླ་ཡོད་བཞིན།",
    "རང་རྒྱལ་དུ་གནའ་ནས་བཟུང་ཚུལ་མཐུན་མིན་པའི་བྱ་སྤྱོད་ཅིག་ལ་ངོས་འཛིན་གྱིས་བྱས་ཉེས་ལྟར་ཐག་གཅོད་པའི་དུས་ཀྱང་བྱུང་མྱོང་མོད།",
    "འདི་གཉིས་ཀྱི་རྩ་བའི་ཁྱད་པར་དེ་བུད་མེད་དེའི་འདོད་བློ་དང་འགལ་མིན་གྱིས་འབྱེད་པ་ཡིན།",
    "༡ཕོ་མོ་ཕན་ཚུན་རང་འཐད་ཀྱིས་འགབ་མཐུན་བྱུང་བ་ཡིན་མོད།",
    "བུད་མེད་དེས་རང་གི་མཚན་སྙན་སྲུང་བའམ་ཡང་ན་ཁོ་མོའི་ཁྱིམ་ཚང་འཐོར་འགྲོ་བར་སྐྲག་ནས་བཙན་གཡེམ་བྱས་པ་ཡིན་ཟེར་བ་དང་།",
    "ཉེས་ཅན་ལ་ལས་རང་གི་ཉེས་འགན་ཇེ་ཡང་དུ་གཏོང་ཆེད།",
    "བུད་མེད་དེས་འདོད་བློ་དང་དངོས་སུ་འགལ་མིན་དེར་ཞིབ་བཤེར་ནན་མོ་བྱ་དགོས།",
    "༢ འཁྲིག་སྦྱོར་ཐེངས་དང་པོ་དེ་དངོས་ནས་འདོད་བློ་དང་འགལ་བ་ཡིན་མོད།",
    "རྗེས་སུ་བུད་མེད་དེ་འགབ་མཐུན་བྱེད་རྒྱུར་འཐད་པ་མ་བྱུང་དུས།",
    "སྐྱོན་ཆ་ཞིག་མི་གཏོང་བ་སོགས་ཀྱིས་བཙན་གྱིས་བུད་མེད་དེའི་མགོ་སྒུར་དུ་བཅུག་པ་ཡིན་ཚེ།",
    "གཅིག་བུད་མེད་ལ་བཙན་གཡེམ་དང་བུ་མོ་ཆུང་ངུར་ལོག་གཡེམ་བྱས་ཏེ་ཉེས་ཚབས་ཆེན་པོ་ཡོད་རིགས་དང་།",
    "བུད་མེད་ལ་བཙན་གཡེམ་དང་བུ་མོ་ཆུང་ངུར་ལོག་གཡེམ་བྱས་གྲངས་མང་རིགས།",
    "མི་མང་འདུ་འཛོམས་བྱེད་སར་བུད་མེད་ལ་བཙན་གཡེམ་བྱས་རིགས།",
    "མི་གཉིས་ཡན་གྱིས་རེས་མོས་ཀྱིས་བཙན་གཡེམ་བྱས་རིགས།",
    "ལྷ་མོ་གཅིག་པུས་ནོར་འཚོ་བཞིན་པ་རིག་ནས་ཉེ་སར་བཅར་ཏེ།",
    "འོན་ཀྱང་ལྷ་མོས་ངོ་རྒོལ་བྱས་པས།",
    "ལྷ་མོས་ཞུ་བ་ཡང་ཡང་བྱས་པས་མ་བསད་པར་བུད་སོང་།",
    "ཁོ་ཚོས་ཚེ་སྐྱིད་བཙན་གྱིས་རླངས་འཁོར་ནང་བརྫངས་ནས་རླངས་འཁོར་ནང་རེས་མོས་ཀྱིས་ལོག་གཡེམ་བྱས།",
    "ག་འདྲ་ཞིག་ལ་བུད་མེད་ལ་བཙན་ཤེད་ཀྱིས་འཆལ་སྤྱོད་དང་བརྙས་བཅོས་བྱེད་པའི་བྱས་ཉེས་ཟེར།",
    "བུད་མེད་ལ་བཙན་ཤེད་ཀྱིས་འཆལ་སྤྱོད་དང་བརྙས་བཅོས་བྱེད་པའི་བྱས་ཉེས་ཟེར་བ་ནི་དྲག་ཤུགས་དང་།",
    "བཙན་ཤེད་དམ་ཡང་ན་དེ་མིན་གྱི་བྱེད་ཐབས་གཞན་དག་གིས་བུད་མེད་དེའི་འདོད་བློ་དང་འགལ་བའི་འོག་བཙན་ཤུགས་ཀྱིས་འཆལ་སྤྱོད་དང་བརྙས་བཅོས་བྱེད་པའི་བྱ་སྤྱོད་ལ་བསྟན།",
    "བུད་མེད་ལ་འཆལ་སྤྱོད་དང་བུད་མེད་ལ་བརྙས་བཅོས་བྱེད་པ་གཉིས་ལ་འདྲ་ས་ཡོད་མོད།",
    "བུད་མེད་ལ་འཆལ་སྤྱོད་བྱེད་པ་དེ་ནི་ཆགས་པའི་ཟུག་གཟེར་སློང་བའམ་ཡང་ན་འདོད་ཆགས་སྐོང་བའི་དམིགས་ཡུལ་བཟུང་ཡོད་པ་དང་།",
    "བུད་མེད་ལ་བརྙས་བཅོས་བྱེད་པ་ཟེར་བ་དེ་སྤྱིར་བཏང་དུ་སེམས་ཁམས་ཀྱི་ཟུག་གཟེར་སློང་བའི་ཆེད་དུ་ཡིན།",
    "བུད་མེད་ལ་འཆལ་སྤྱོད་བྱེད་པ་དེ་ངེས་པར་དུ་དྲག་ཤུགས་ལ་བརྟེན་པ་ཞིག་ཡིན།",
    "དྲག་ཤུགས་ལ་མ་བརྟེན་པར་བུད་མེད་ལ་འཆལ་སྤྱོད་དང་བརྙས་བཅོས་བྱེད་པའི་བྱ་སྤྱོད་དེ་རིགས་བྱས་ཉེས་སུ་བརྩི་མི་རུང་།",
    "བུ་མོ་ལྷ་སྐྱིད་ཚུར་ཡོང་བ་དང་ཐུག་པས།",
    "ལྷ་སྐྱིད་ཀྱི་རྗེས་དེད་ནས་བཙན་གྱིས་ལྷ་སྐྱིད་ཀྱི་ངོ་རྒོལ་བྱེད་པར་ཁ་ཡ་མི་བྱེད་པར་བྲང་ཁར་རེག་པ་མ་ཟད།",
    "ཁོག་སྟོད་ཀྱི་ཚི་ལེན་གཤགས་པ་སོགས་ཀྱིས་དུས་ཚོད་གཅིག་ཙམ་ལ་འཆལ་སྤྱོད་དང་བརྙས་བཅོས་བྱས་པ་རེད།",
    "བློ་གྲོས་སོགས་མི་དྲུག་པོས་རང་གི་འདོད་ཆགས་སྐོང་ཆེད།",
    "དུས་ལྟར་ཡོང་བའི་ནམ་མཁའ་བཙན་གྱིས་རླངས་འཁོར་ནང་བཞག་ནས་རང་གི་ཁྱིམ་དུ་བཅུག་པ་མ་ཟད།",
    "ཁོ་ཚང་གི་འཐེན་སྒམ་དང་ཁྱིམ་ནང་གང་སར་བསློགས་ཀྱང་ཅི་ཡང་མ་རྙེད་པས།",
    "ལྕགས་བྱམས་ཀྱི་ཨ་ཕའི་ཁ་པར་ཨང་གྲངས་བླངས་རྗེས།",
    "སྤྱི་སྤྱོད་ཁ་པར་ཞིག་བརྒྱུད་ནས་ལྕགས་བྱམས་ཀྱི་ཕ་རྒན་ལ་སྐྲག་སྐུར་མོད།",
    "ལྕགས་བྱམས་འཕག་འཚག་མང་པོ་བརྒྱབ་ནས་ཐར་སོང་བ་མ་ཟད།",
    "ལྕགས་བྱམས་ཀྱི་ཁྱིམ་བདག་ལ་སྒོར་མོ་འབོར་ཆེན་ཁྱེར་ཡོང་དགོས་པར་འཇིགས་སྣང་སྐུལ་བ་སྟེ།",
    "ག་འདྲ་ཞིག་ལ་བུད་མེད་དང་བྱིས་པ་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱེད་པའི་བྱས་ཉེས་ཟེར།",
    "བྱས་ཉེས་འདིའི་ཕྱི་ཡུལ་ཕྱོགས་དེ་བུད་མེད་དང་བྱིས་པ་མགོ་སྐོར་བསླུ་བྲིད་དང་།",
    "འདི་རིགས་གྲུབ་པཪ་ཤུགས་རྐྱེན་མི་ཐེབས་པར་ལོ་ན་བཅུ་བཞིར་སོན་པའི་བུ་མོ་དང་།",
    "བུད་མེད།",
    "བུད་མེད་དང་བྱིས་པ་དེ་དག་ཁྱིམ་མམ་ཡང་ན་དེར་ལྟ་རྟོག་བྱེད་མཁན་དང་ཁ་བྲལ་དུ་བཅུག་པའི་བྱ་སྤྱོད་ལ་བསྟན་ལ།",
    "བསླུ་ཉོ་བྱེད་པ་ཞེས་པ་ནི་བཙོང་རྒྱུ་དམིགས་ཡུལ་དུ་བཅངས་ནས་དངུལ་སྒོར་སོགས་ཀྱིས་མི་གཞན་དེའི་ལག་ནས་བུད་མེད་དང་བྱིས་པ་ཉོ་བའི་བྱ་སྤྱོད་ལ་བསྟན།",
    "བར་འཚོང་བྱེད་པ་ཞེས་པ་ནི་བྱིས་པ་དང་བུད་མེད་དེ་དག་ཕུང་གསུམ་པར་རྒྱུ་ནོར་དང་དངུལ་སྒོར་ལ་བརྗེ་བའི་བྱ་སྤྱོད་ལ་བསྟན།",
    "གོང་གི་བྱ་སྤྱོད་ཁྲོད་ནང་གསེས་བྱེ་བྲག་གཅིག་ཙམ་སྤེལ་བ་ཡིན་ཚེ།",
    "བུད་མེད་དང་བྱིས་པ་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་གྲངས་མི་གསུམ་ཡན་ཟིན་རིགས།",
    "བུད་མེད་དང་བྱིས་པ་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་ལ་ལོག་གཡེམ་བྱས་རིགས།",
    "བུད་མེད་དང་བྱིས་པ་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་ལ་མགོ་སྐོཪ་བསླུ་བྲིད་དང་བཙན་ཤེད་ཀྱི་སྒོ་ནས་སྨད་འཚོང་དུ་བཅུག་པའམ་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་གཞན་ལ་བཙོངས་ནས་དེར་བཙན་ཤེད་ཀྱིས་སྨད་བཙོང་དུ་བཅུག་རིགས།",
    "བཙོང་བྱ་དམིགས་ཡུལ་དུ་བཟུང་སྟེ་དྲག་ཤུགས་དང་བཙན་ཤེད་བྱེད་ཐབས་སྤྱད་པའམ་སྦྲིད་པར་བྱེད་པའི་ཐབས་ཤེས་ལ་བརྟེན་ནས་བུད་མེད་དང་བྱིས་པ་བཙན་ཁྲིད་བྱས་རིགས།",
    "བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་དང་བྱིས་པའམ་དེ་དག་གི་གཉེན་ཉེར་རྨས་སྐྱོན་ཆེན་པོ་བཏང་དང་ཤི་སྐྱོན་ནམ་དེ་མིན་གྱི་ངན་འབྲས་ཚབས་ཆེན་བཟོས་རིགས།",
    "གྱོད་དཔེ་འདིའི་ནང་དར་རྒྱས་ལ་ཡོན་ཏན་མེད་པས་སྔོན་ཞོར་ལས་སུ་སོང་ཡང་གླ་ཕོགས་ཧ་ཅང་མཐོ་བའི་ལས་ཀ་གཉེར་མ་ཐུབ་སྟབས།",
    "ཐོག་མར་ཁོ་ཚོའི་ལག་ཁྱེར་དང་སྒོར་མོ་ཚང་མ་བླངས་ཤིང་།",
    "ག་འདྲ་ཞིག་ལ་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་དང་བྱིས་པ་ཉོས་པའི་བྱས་ཉེས་ཟེར།",
    "བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་དང་བྱིས་པ་ཉོས་པའི་བྱས་ཉེས་ཟེར་བ་ནི་བཙོང་རྒྱུ་དམིགས་ཡུལ་དུ་བཟུང་ནས་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་དང་བྱིས་པ་སྒོར་མོ་དང་དངོས་པོས་ཉོ་བའི་བྱ་སྤྱོད་ལ་བསྟན།",
    "བྱས་ཉེས་འདིའི་ཉེས་གསོག་ཁ་གཏད་ཡུལ་ནི་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་དང་བྱིས་པ་ཡིན།",
    "༡ བྱ་སྤྱོད་མཁན་གྱིས་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་དང་བྱིས་པ་ཉོས་རྗེས་ཡང་དུ་བཙོང་བའི་རིགས་ཏེ།",
    "གཡོ་འཚོང་བྱས་པའི་བུད་མེད་དང་བྱིས་པ་བཙོང་འདོད་མེད་མོད།",
    "བུད་མེད་དང་བྱིས་པ་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱེད་པའི་བྱས་ཉེས་ལྟར་ཐག་གཅོད་བྱེད་པ་ཡིན།",
    "བྱ་སྤྱོད་མཁན་གྱིས་བུད་མེད་དང་བྱིས་པ་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱེད་པར་ངན་སྐུལ་བྱས་རྗེས་ཡང་དུ་ཉོས་བའི་རིགས།",
    "བུད་མེད་དང་བྱིས་པ་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱེད་པའི་བྱས་ཉེས་མཉམ་བསགས་མཁན་དུ་གྲུབ་ཡོད་པས།",
    "བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་དང་བྱིས་པ་ཉོས་པའི་བྱས་ཉེས་སུ་ངེས་གཏན་བྱ་མི་ཆོག་ཡང་ན་མི་བཙོང་མཁན་དང་ཁ་ཆད་བྱས་ཡོད་པ་མ་ཟད།",
    "སྔར་བཞིན་བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་དང་བྱིས་པ་ཉོས་པའི་བྱས་ཉེས་ལྟར་ངེས་གཏན་བྱེད་པ་ཡིན།",
    "༡བསླུ་བྲིད་དང་གཡོ་འཚོང་བྱས་པའི་བུད་མེད་ཉོས་ཀྱང་།",
    "རང་དང་མཉམ་དུ་འཚོ་བ་རོལ་བར་བཙན་ཤེད་མ་བཀོལ་བའམ་ཡང་ན་བུད་མེད་དེས་འདོད་བློ་ལྟར།",
    "རང་གི་ཡུལ་ལ་ལོག་པར་བཀག་འགོག་མི་བྱེད་པའི་རིགས་དང་།",
    "༣ཉོས་པའི་བུད་མེད་དང་ཉོ་མཁན་གཉིས་གཉེན་སྒྲིག་བྱས་ཟིན་ལ།",
    "གནས་ཚུལ་འདི་རིགས་ཀྱང་རང་གི་ཡུལ་ལ་ལོག་པར་བཀག་འགོག་མི་བྱེད་པའི་རིགས་ལ་རྩིས་ནས་ཉེས་འགན་བདའ་འདེད་མ་བྱས་པས་ཆོག།",
    "བུད་མེད་ཚེ་སྐྱིད་བསླུ་བྲིད་དང་གཡོ་འཚོང་གིས་ཁྲིད་ཡོང་བ་ཤེས་བཞིན་སྒོར་སུམ་སྟོང་དྲུག་བརྒྱ་བྱིན་ནས་ཉོས་པ་རེད།",
    "ཟླ་གཅིག་ཙམ་འགོར་རྗེས་ཚེ་སྐྱིད་ཀྱིས་རྡོ་རྗེ་གཉིད་ཡོད་པའི་གོ་སྐབས་དང་བཟུང་ནས་བྲོས་སོང་།",
    "ངེས་པར་དུ་མི་གཞན་ཞིག་གི་ཉེས་གསོག་དོན་དངོས་རྫུན་བཟོ་བྱེད་དགོས་པ་སྟེ།",
    "སྒོར་ཉིས་བརྒྱ་བཙན་འཕྲོག་བྱས་སོང་ཞེས་གྱོད་དོན་སྙན་སེང་ཞུས་པས།",
    "ཞུ་སྦྱོར་ཕྱི་མ་བ་དཔལ་ལོས་རང་གི་ཤ་འཁོན་རྩོད་ཆེད།",
    "ཟླ་༡༢པའི་ཚེས་༦ཉིན་གྱི་དགོང་མོ་དུས་ཚོད་བདུན་སྟེང་།",
    "རྟ་མགྲིན་མཚོ་བཟའ་བ་གཉིས་ལ་སྡིགས་དམོད་བྱས་པ་མ་ཟད།",
    "དབྱུག་པ་ཞིག་བཟུང་ནས་ཁོ་ཚང་གི་རྒྱ་སྒོའི་ཤེལ་སྒོ་གསུམ་བཅགས་པ་རེད།",
    "ཆེན་མཚོ་མ་བུ་གཉིས་ཀྱིས་རྟ་མགྲིན་མཚོ་ཚང་གི་སྒོ་ཁ་ནས་སྐད་ཆེན་པོས་སྡིགས་དམོད་བྱས་པ་ན།",
    "ག་འདྲ་ཞིག་ལ་དྲག་ཤུགས་ལ་བརྟེན་ནས་གཞན་གྱི་གཉེན་སྒྲིག་རང་མོས་ལ་ཐེ་གཏོགས་བྱེད་པའི་བྱས་ཉེས་ཟེར།",
    "དྲག་ཤུགས་ལ་བརྟེན་ནས་གཞན་གྱི་གཉེན་སྒྲིག་རང་མོས་ལ་ཐེ་གཏོགས་བྱེད་པའི་བྱས་ཉེས་ཟེར་བ་ནི་དྲག་ཤུགས་ལ་བརྟེན་ནས་གཞན་གྱི་གཉེན་སྒྲིག་རང་མོས་ལ་ཐེ་གཏོགས་བྱེད་པའི་བྱ་སྤྱོད་ལ་བསྟན་ཏེ།",
    "གཉེན་སྒྲིག་གི་འབྲེལ་བ་མེད་པར་བཟོ་མི་ཐུབ་པའི་རིགས་ཀྱང་བཟའ་ཟླ་གཉིས་བརྟེན་བྱེད་པའི་བྱས་ཉེས་ལྟར་ཐག་གཅོད་པ་རེད།",
    "དངོས་སུ་ཐོ་འགོད་བྱས་ཏེ་གཉེན་སྒྲིག་པ་དང་གཉེན་སྒྲིག་ཐོ་འགོད་མ་བྱས་རུང་ཁྱོ་ཤུག་གི་འབྲེལ་བ་ལྟར་འཚོ་བ་མཉམ་དུ་རོལ་བཞིན་པའི་དོན་དངོས་སྟེང་གི་གཉེན་སྒྲིག་གཉིས་ཀ་འདུས།",
    "གསར་མོ་མཚོ་སྐྱིད་ལོ་ཉེར་བདུན་དང་རིག་ལོ་ལོ་ལྔ་བཅུ་གཉིས་༡༩༩༧ལོ་ནས་བཟུང་མཉམ་དུ་འཚོ་བ་རོལ་བཞིན་བསྡད།",
    "བསྟུད་མར་ལོ་གཉིས་རིང་མཚོ་སྐྱིད་ཀྱིས་བྱིས་པ་ཕོ་མོ་གཉིས་བཙས་བྱུང་།",
    "སྡུག་གཅོད་གཏོང་བའི་བྱས་ཉེས་གཏོང་བའི་བྱས་ཉེས་ཞེས་པ་ནི་རྒྱུན་པར་གཅར་རྡུང་ངམ་སྡིགས་དམོད་གཏོང་བ་དང་།",
    "བཙན་ཤེད་ཀྱིས་ངལ་རྩོལ་ལྕི་མོ་ལས་སུ་འཇུག་པ།",
    "དཔེར་ན་གཅར་རྡུང་ངམ་སྡིགས་དམོད་གཏོང་བ།",
    "བཙན་ཤེད་ཀྱིས་ངལ་རྩོལ་ལྕི་མོ་ལས་སུ་འཇུག་པ་སོགས་ལྟ་བུ་དང་།",
    "དཔེར་ན་འཕྱ་དམོད་དང་།",
    "བྱ་སྤྱོད་མཁན་དེས་རང་གི་དམིགས་བསལ་གྱི་འགན་འཁྲི་དང་ལེན་མི་བྱེད་པ་སྟེ།",
    "དགོས་ངེས་ཀྱི་འཚོ་བའི་གྲོན་དངུལ་མི་སྤྲོད་པ་དང་རང་ཚུགས་ཀྱིས་འཚོ་བ་སྐྱེལ་མི་ནུས་པའི་མིར་རོགས་མི་བྱེད་པ་ཚང་མ་འདུས་པ་རེད།",
    "ཁྱིམ་བདག་གིས་མངག་བཅོལ་ལྟར་བྱིས་པར་ལྟ་སྐྱོང་བྱེད་བཞིན་པའི་མི་སོགས་ཀྱང་འདུས།",
    "རང་གི་ཁྱིམ་མི་དང་གཉེན་ཉེའི་རྒྱུ་ནོར་བཙན་འཕྲོག་བྱས་པ་ན།",
    "རང་གིས་བཀོལ་བའི་ཆེད་དུ།",
    "ཉིན་ཞིག་གི་དགོང་མོར་སིལ་ཏོག་ཟ་བྱེད་ཀྱི་གྲི་ཆུང་བཟུང་ནས་བུད་མེད་གཡང་སྐྱིད་ཚང་ལ་འཛུལ་ལ།",
    "ལྷ་ལུང་གིས་མོའི་སྐེ་ལ་གྲི་དྲུད་ནས་རྨ་ཆུང་ཆུང་ཞིག་བཟོས་ཏེ་བྲོས་སོང་ལ།",
    "ཁྱིམ་ཚང་དང་སྤྱི་བའི་འགྲིམ་འགྲུལ་ཡོ་བྱད་ཀྱི་ཕྱི་ནས་གོང་གི་བྱ་སྤྱོད་དེ་དག་སྤེལ་བའི་རིགས།",
    "དེ་དུས་དོན་གྲུབ་ཀྱིས་རང་གི་ཁུག་མར་བཅུག་ཡོད་པའི་གྲི་ཆུང་བླངས་ཏེ་ཀླུ་འབུམ་གྱི་བརླ་ཐོག་ཏུ་གྲི་གཅིག་གཙགས་ནས་བྲོས་སོང་།",
    "དོན་གྲུབ་ཀྱིས་མི་གཞན་གྱི་མཉམ་བཞག་མེད་པའི་སྐབས་དང་བསྟུན་ནས་རྣ་ཏོག་འཕྲོག་པའི་བྱ་སྤྱོད་འདི་རིགས་བཙན་འཕྲོག་བྱེད་པའི་བྱས་ཉེས་ཡིན་མོད།",
    "རང་བྱུང་གི་སོལ་རླངས་ཚང་མ་འདུས།",
    "སྤྱིར་བཏང་དུ་བྱས་ཉེས་བསགས་པ་ལྟར་ཐག་མི་གཅོད་པ་རེད།",
    "བཟང་རེག་ཐབས་བྱ་རྒྱུ་དམིགས་ཡུལ་དུ་བཅངས་པ་ཞེས་པ་དེ།",
    "རང་གིས་སྤྱོད་པ།",
    "འཕྲུལ་སྒུལ་འཁོར་ལོ་དེ་བོར་སོང་བ་ཡིན་ཚེ།",
    "གཞུང་སྒེར་གྱི་རྒྱུ་ནོར་རྐུ་ཁྱེར་བྱས་པ་དེས་རྐུ་ཁྱེར་གྱི་བྱས་ཉེས་བསགས་མེད་མོད།",
    "སྤྱིར་བཏང་གི་རྐུ་ཁྱེར་བྱེད་པའི་ནག་ཉེས་སུ་མི་གྲུབ།",
    "རྐུས་པའི་གྲངས་ཀ་ཉུང་བའམ་ཡང་ན་དངོས་བོ་རྐུ་མ་ཐུབ་མོད།",
    "རྐུས་ཡོང་བའི་ཁུག་མའི་ནང་གི་མེ་མདའ་དང་རྫས་མདེལ་ཡོད་པ་རིག་རྗེས།",
    "རང་གིས་བདག་ཉར་བྱས་པ་ཡིན་ཚེ།",
    "མི་གཞན་གྱིས་ཉོས་པའི་དངུལ་ཁང་གི་དངུལ་འཛིན་རྐུས་རྗེས།",
    "༡༢ ཁེ་བཟང་རེག་རྒྱུ་དམིགས་ཡུལ་དུ་བཅངས་ནས།",
    "གཅིག་རྐུས་དངོས་ཀྱི་རིན་གོང་དེ་དངོས་བོ་དེའི་ནུས་ཡོད་བདེན་དཔང་གིས་གཏན་འཁེལ་བྱེད་དགོས་མོད།",
    "ཚོང་རའི་སིལ་ཚོང་གི་རིན་གོང་ཁྲོད་ཀྱི་རིན་གོང་འབྲིང་ཙམ་གྱིས་རྩིས་རྒྱག་དགོས་ལ།",
    "༥ཕྱིར་གཏོང་ནང་འདྲེན་གྱི་ཚོང་ཟོག་དང་དངོས་རྫས་དེ་དག་གི་རིན་གོང་གོང་དུ་ཡོད་པའི་ཚན་ཆུང་དང་པོ་ལྟར་རྩིས་རྒྱག་རྒྱུ།",
    "མུ་ཏིག་དང་ནོར་བུ་སོགས་ཀྱིས་བཟོས་པའི་བཟོ་རྩལ་གྱི་ཐོན་རྫས་དེ་དག་གི་རིན་གོང་དེ།",
    "༡༡མི་གཞན་གྱི་འཕྲིན་སྐྱེལ་སྐུད་ལམ་མཐུད་སྦྱོར་བྱས་རྗེས་རང་གིས་བཀོལ་སྤྱོད་བྱས་པ་ཡིན་ཚེ།",
    "ད་དུང་བདེན་དཔང་གི་འགྲོ་ལུགས་བརྒྱུད་མི་དགོས་པར་ཚོང་ཟོག་བླངས་ཆོག་པའི་ཚོང་ཟོག་ལེན་འཛིན་སོགས་ཡིན་དུས།",
    "གལ་ཏེ་འཛིན་ཤོག་སྟེང་གི་དངུལ་གྲངས་གཏན་འཁེལ་བྱས་མེད་རུང་།",
    "ཡང་ན་ཐེངས་སྔོན་མའི་རྐུ་ཁྱེར་བྱ་སྤྱོད་དེ་ལོ་གཅིག་གི་ནང་ཚུན་བཅས་ཡིན་པའི་ཚེ།",
    "གཞུང་སྒེར་གྱི་རྒྱུ་ནོར་རྐུ་ཁྱེར་བྱས་པའི་གྲངས་འབོར་དེ་གྲངས་འབོར་ཅུང་ཆེར་ཟིན་པའི་རིགས་ལ་སླེབས་ཡོད་མོད།",
    "ཆུ་ལོག་སྔོན་འགོག་གཟིགས་སྐྱོང་།",
    "ཡང་ན་བྱ་སྤྱོད་མཁན་གྱིས་རྒྱུ་དངོས་བརྗེ་རེས་བྱེད་མི་དགོས་པར་བཟོས་པའོ།",
    "རང་གིས་ལས་འདོད་པའི་བྱ་བ་ཅི་ཡང་ལས་མི་ཐུབ་སྙམ་ནས་སེམས་སྐྱིད་པོ་ཡོང་གིན་མེད།",
    "རང་གི་འདོད་པའི་གྲོགས་པོའི་རིགས་མིན་པར་སྙམ་ནས་དགའ་གྲོགས་སྒྲིག་རྒྱུར་འཐད་པ་མ་བྱུང་ལ།",
    "བཙལ་ནས་མཚོ་མོ་ལ་དངོས་པོ་མང་པོ་ཉོ་ཅི་ཐུབ་བྱས།",
    "མཚོ་མོས་སྒོར་དེ་བཟུང་ནས་གྲོགས་པོ་ཞིག་དང་མཉམ་དུ་ས་ཆ་གཞན་ཞིག་ལ་བྲོས་སོང་།",
    "ཉིན་གསུམ་གྱི་ནང་མཚོ་མོ་བཙལ་ནས་རྙེད་བྱུང་།",
    "བྱས་ཉེས་གསོག་དུས་མོ་ལོ་བཅོ་བརྒྱད་ལ་སོན་མེད་པ་གཞིར་བཟུང་ནས།",
    "རང་ལོ་འཁོར་མོ་བཅུ་བཞིར་མ་སོན་པའི་བྱིས་པའི་རྒྱུ་དངོས་བཙན་འཕྲོག་བྱས་རིགས་དང་།",
    "ཆུ་ལོག་སྔོན་འགོག་གཟིགས་སྐྱོང་།",
    "གཞུང་སྒེར་གྱི་རྒྱུ་ནོར་བཙན་འཕྲོག་བྱས་པར་སྲིད་འཛིན་ཐད་ཀྱི་ཆད་པས་ཐག་བཅད་མ་མྱོང་མོད།",
    "གྲངས་འབོར་ཅུང་ཆེ་བའི་རིགས་སུ་ཚུད་མོད།",
    "ཚང་མས་མངོན་གསལ་དུ་རྒྱུ་ནོར་འཕྲོག་པ་ཞིག་ཡིན་མོད།",
    "ཡང་ན་བཙན་ཤེད་ཀྱི་བྱེད་ཐབས་གཞན་དག་གིས་རྒྱུ་ནོར་འཕྲོག་པ་དང་ཆབས་གཅིག་ལུས་ཁམས་ཀྱི་བདེ་ཐང་ལའང་གནོད་སྐྱོན་བཟོ་བ་རེད།",
    "འཇིགས་མེད་ཀྱིས་སྒོར་མོ་མང་པོ་མདུན་ཅོག་སྟེང་བཞག་ནས་རེའུ་མིག་ལ་ཁ་སྐོང་བཞིན་ཡོད་པ་རིག་པས།",
    "ཐད་ཀར་ནང་དུ་འཛུལ་ནས་མྱུར་མོའི་ངང་སྒོར་མོ་ཡོངས་ཉིས་ཁྲི་བདུན་སྟོང་དྲུག་བརྒྱ་འཕྲོག་ནས་འགྲོ་རྩིས་བཅངས་མོད།",
    "ག་འདྲ་ཞིག་ལ་བདག་གིར་བཟུང་བའི་བྱས་ཉེས་ཟེར།",
    "༡༩༩༩ལོའི་ཟླ་༦པའི་ཚེས་༢༤ཉིན་གྱི་ཕྱི་དྲོ་དུས་ཚོད་གཅིག་གི་སྟེང་།",
    "ཚེ་རིང་གིས་ཅོག་ཙེར་གཙང་སྤྲ་བྱེད་དུས་མཐོང་བས།",
    "ཁུག་མ་དེ་སྦས་སྐུང་བྱས་པ་རེད།",
    "ཕྱིར་ཟ་ཁང་དུ་ཡོང་ནས་ཚེ་རིང་ལ་ཁུག་མ་ཕྱིར་སྤྲད་ན་དགའ་རྟགས་དངོས་ནས་སྟེར་རྒྱུ་ཞེས་ཞུ་བ་ཡང་ཡང་བྱས་མོད།",
    "ཚེ་རིང་གིས་མ་རིག་ཅེས་གཏན་ནས་ཁས་མ་བླངས།",
    "སྒོར་མོ་དང་དངོས་བོ་ཡོངས་ཕྱིར་སྤྲད་པ་རེད།",
    "དོན་གྲུབ་ཀྱིས་ལག་ཏུ་སྒོར་མོ་དེ་འདྲ་མང་པོ་ཞིག་མེད་ཅེས་ཡོད་པའི་སྐོར་ཆིག་སྟོང་ལྔ་བོ་བྱིན་ཡང་།",
    "རྒྱུན་ལྡན་གྱི་ཐོན་སྐྱེད་གཉེར་སྐྱོང་གི་བྱ་བ་སྒྲུབ་མི་ཐུབ་པར་བཟོས་པའམ་ཡང་ན་གནོད་སྐྱོན་ཚབས་ཆེན་ཐེབས་ཚེ།",
    "ཚང་མ་ཐོན་སྐྱེད་གཉེཪ་སྐྱོང་བྱ་བར་གཏོར་བཤིག་གཏོང་བའི་བྱས་ཉེས་སུ་གྲུབ་ཆོག་བྱས་ཉེས་འདིའི་རང་སྣང་གི་ཕྱོགས་དེ་ཤེས་བཞིན་ཐད་ཀར་བ་ཡིན་པ་མ་ཟད།",
    "འཕྲུལ་འཁོར་གལ་ཆེན་ལ་གཏོར་བཤིག་བཏང་བའམ་ཡང་ན་རྨོ་ཕྱུགས་མང་པོ་གདུག་གསོད་བྱས་པས་ཐོན་སྐྱེད་གཉེར་སྐྱོང་གི་བྱེད་སྒོར་ཤཱན་ཤུགས་ཚབས་ཆེན་ཐེབས་པ།",
    "མི་མང་ཚོགས་ཡུལ་དུ་དུག་གཏོང་བ་ལྟ་བུའོ།",
    "མེ་ལྕེ་ཇེ་ཆེནས་ཇེ་ཆེར་གྱུར་སོང་།",
    "སྐབས་དེར་ཚང་མ་སྐྲག་ནས་མེ་གསོད་རྩིས་བཅངས་མོད།",
    "ཟ་ཁང་གི་ཇ་མ་རྡོ་རྒྱལ་དང་རིན་ཆེན་གཉིས་མ་འགྲིག་པར་འཛིང་རེས་བྱས།",
    "གྱོད་གཞི་འདིའི་ཁྲོད་རིན་ཆེན་གྱི་བྱ་སྤྱོད་དེས་ངན་འབྲས་ཚབས་ཆེན་མ་བཟོས་རུང་ཉེན་ཁ་ཡོད་པའི་དངོས་རྫས་གཏོང་བའི་བྱས་ཉེས་སུ་གྲུབ་འདུག་པ་རེད།",
    "འགྲིམ་འགྲུལ་ཡོ་བྱད་ལ་གཏོར་བརླག་གཏོང་བའི་བྱས་ཉེས་དང་སྐྱེལ་འདྲེན་སྒྲིག་ཆས་ལ་གཏོར་བརླག་གཏོང་བའི་བྱས་ཉེས་ཟེར་བ་ག་འདྲ་རེད།",
    "མཚོན་རྟགས་སོགས་ལ་གཏོར་བཤིག་བཏང་བའམ་གཏོར་བཤིག་གི་བྱེད་ཐབས་གཞན་དག་སྤེལ་ནས་མེ་འཁོར་དང་།",
    "དགོང་མོ་ཞིག་ལ་ལྐོག་ཏུ་ཁེ་ལས་དེའི་སྐྱེལ་འདྲེན་རླངས་འཁོར་ཞིག་གི་ཁ་བསྒག་བྱེད་ཀྱི་ལྷུ་ལག་གལ་ཚེན་ཞིག་ལ་གཏོར་བརླག་བཟོས་ཀྱང་།",
    "ཕྱི་ཉིན་སྔ་མོ་རླངས་འཁོར་དེའི་ཁ་ལོ་བ་ནོར་བུས་རླངས་འཁོར་མ་བསྐོར་སྔོན་ཤེས་བྱུང་བས།",
    "དངོས་ནས་རྡོ་ཆེན་པོ་འགའ་ཞིག་ལྕགས་ལམ་སྟེང་འཕྲེད་ཀྱིས་བཞག་སྟེ་རྒྱང་རིང་ནས་ལྟད་མོ་བལྟས།",
    "སྔ་མོ་ནས་ཁ་གཅུན་པས་མེ་འཁོར་གྱི་མགོ་རྟིང་ལོག་པ་སོགས་ཀྱི་ངན་འབྲས་མ་བྱུང་།",
    "གྱོད་གཞི་འདིའི་ཁྲོད་མིཀ་བ་དང་ཁ་བ་གཉིས་ཀྱི་བྱ་སྤྱོད་དེ་རིགས་སྐྱེལ་འདྲེན་སྒྲིག་ཆས་ལ་གཏོར་བརླག་གཏོང་བའི་བྱས་ཉེས་སུ་གྲུབ་ཡོད་པ་ལྟ་བུ་རེད།",
    "གློག་ཤུགས་སྒྲིག་ཆས་ལ་གཏོར་བཤིག་བཏང་བའི་བྱས་ཉེས་ཟེར་བ་ག་རེ་ཡིན།",
    "གྱོད་དོན་འདིའི་ཁྲོད་དཔལ་ལྡན་གྱི་བྱ་སྤྱོད་དེ་རིགས་གློག་ཤུགས་སྒྲིག་ཆས་ལ་གཏོར་བཤིག་བཏང་བའི་བྱས་ཉེས་སུ་གྲུབ་ཡོད་པ་ལྟ་བུ་རེད།",
    "ཀུན་བཟང་གིས་རྒྱུ་ནོར་བསམ་ནས་བསམ་བཞིན་དུ་གློག་ཤུགས་སྒྲིག་ཆས་ལ་གཏོར་བཤིག་བཏང་སྟེ།",
    "འགྲིམ་འགྲུལ་ཐད་ལས་འཛོལ་བྱུར་ཉེས་ཆེན་པོ་བཟོས་པའི་བྱས་ཉེས་ཟེར་བ་ག་འདྲ་རེད།",
    "འགྲིམ་འགྲུལ་གྱི་འགལ་འཛོལ་ཆག་སྒོ་བཟོས་རྗེས་བྲོས་བྱོལ་སོང་བའམ་ཡང་ན་གདུག་རྩུབ་ཆེ་བ་གཞན་དག་བསགས་རིགས་ཀྱི་གནས་ཚུལ་ཐད།",
    "ཁ་ལོ་བ་ཚེ་རྒྱལ་གྱིས་རང་གི་རླངས་འཁོར་སྔོན་ན་བསྐྱོད་བཞིན་པའི་ཁ་བའི་རླངས་འཁོར་དེ་ལས་བརྒལ་ཆེད་ཇེ་མགྱོགས་སུ་བཏང་སྟེ་སྔོན་བླངས་མོད།",
    "རང་གི་གམ་དུ་ཡོད་པའི་མི་ལ་ཤི་སྐྱོན་བྱུང་བ་མ་ཟད།",
    "རང་ལའང་རྨས་སྐྱོན་ལྕི་མོ་ཕོག་ཚེ་རྒྱལ་གྱིས་གནས་ཚུལ་དེ་རིག་དུས་མགྱོགས་མྱུར་སྒོས་བྲོས་སོང་།",
    "དེའི་ཕྱི་ཉིན་རྒན་པོ་དེ་ཤི་སོང་བ་ཤེས་ལ་འགྱོད་བཤགས་བྱ་ཆེད་དེའི་ཁྱིམ་ཚང་ལ་དངུལ་སྒོར་ཁྲི་གསུམ་ཙམ་བྱིན།",
    "དེ་དུས་ཁོའི་གདོང་ཡོངས་ཁྲག་གིས་བརྫིས་ཡོད་པ་རིག་རྗེས་འཇིགས་སྐྲག་སྐྱེ་ཞིང་།",
    "དོ་དམ་བྱེད་མཁན་གྱིས་རང་གིས་ཐག་གཅོད་བྱས་པའི་བྱ་སྤྱོད་དེ་སྒྲིག་སྲོལ་ལམ་ལམ་ལུགས་དང་འགལ་ཡོད་པ་ཤེས་ཀྱང་སྟབས་ལེགས་ཡོང་བའི་བསམ་ཚུལ་བཟུང་ནས་ལས་བཟོ་བར་བཙན་གྱིས་སྒྲིག་སྲོལ་ལམ་ལུགས་ཀྱི་གཏན་འཁེལ་དང་འགལ་བའི་ཉེན་ཁའི་པས་ཀ་ལས་སུ་བཅུག་པར་བསྟན།",
    "ཞུ་སྦྱོར་ཕྱི་མ་བ་རྡོ་རྗེ་ནི་ཨར་འདམ་བཟོ་གྲྭ་ཞིག་གི་རང་འཐག་འཕྲུལ་ཆས་ཀྱི་རུ་ཁག་དང་པོའི་རུ་གཙོ་ཡིན་ཏེ།",
    "དོན་དངོས་སུ་རང་འཐག་གི་སྒོ་ཕྱེ་བ་དང་ནོར་འཁྲུལ་བྱུང་བ་ཡིན་པས།",
    "ཁོ་བོའི་བྱ་སྤྱོད་འདི་རིགས་འགན་འཛོལ་ཆེན་པོས་བྱུར་ཉེས་ཚབས་ཆེན་བྱུང་བའི་བྱས་ཉེས་སུ་གྲུབ་ཡོད་པ་རེད།",
    "མི་དགུའི་སྲོག་ཤོར་བ་རེད།",
    "སྒེར་གྱི་བཟོ་གྲྭ་ཞིག་གིས་སྔོན་བཟོ་སྐྲུན་བྱས་པའི་བོད་སྤོས་ཀྱི་དྲི་མ་ཧ་ཅང་ཞིམ་པས་ཚང་མས་ཉོ་བ་ཡིན།",
    "མི་གསུམ་ཡན་ལ་རྨས་སྐྱོན་ཚབས་ཆེན་བཟོས་པའམ་མི་བཅུ་ཡན་ལ་རྨས་སྐྱོན་ཡང་མོ་ཕོག་པ།",
    "མི་གསུམ་ཡན་ལ་རྨས་སྐྱོན་ཚབས་ཆེན་བཟོས་པའམ་མི་བཅུ་ཡན་ལ་རྨས་སྐྱོན་ཡང་མོ་ཕོག་པ།",
    "དུག་དང་གནོད་ཆ་ལྡན་པའི་བཟའ་བཅའ་ཐོན་སྐྱེད་དང་ཕྱིར་འཚོང་བའི་བྱ་སྤྱོད་དེ་རིགས་དུག་དང་གནོད་ཆ་ལྡན་པའི་བཟའ་བཅའ་ཐོན་སྐྱེད་དང་ཕྱིར་འཚོང་བའི་བྱས་ཉེས་སུ་མི་གྲུབ་མོད།",
    "རེ་རེ་བཞིན་ཚང་མ་གོང་སླ་མོའི་ངང་བདག་པོའི་ལག་ནས་ཉོས་ཏེ།",
    "དམིགས་བཙུགས་མ་ཡིན་པའི་མི་མང་པོ་ཞིག་གི་ལུས་ཁམས་བདེ་ཐང་ལ་གནོད་པ་བསྐྱསྐུལ་ཡོད་དེ།",
    "གོང་གི་བྱ་སྤྱོད་སྤེལ་ཏེ་ངན་འབྲས་ཚབས་ཆེན་བཟོས་པའི་རིགས་ལ།",
    "ཞིང་ལས་ཐོན་སྐྱེད་ཅི་ཡང་མེད་པའམ་ཡང་ན་གཞི་ཁྱོན་ཆེན་པོའི་ངང་ཐོན་སྐྱེད་ཉུང་དུ་སོང་བ།",
    "༡ དངུལ་ལོར་རྫུན་བཟོ་བྱེད་མཁན་ཚོགས་ཁག་གི་གཏེ་པོ་དང་།",
    "༢ལོའི་ཟླ་༦པ་དང་༧པའི་ནང་ཞུ་སྦྱོར་ཕྱི་མ་བ་བློ་རྒྱམ་བཙལ་ནས་ལས་སྣོན་བྱེད་པར་རེ་བ་ཞུས།",
    "གསང་བདག་གིས་རང་གི་སྒོར་མོ་དེ་རྫུན་མ་གྲངས་འབོར་འབུམ་གསུམ་ཡིན་པ་ཤེས་བཞིན་དུ་མི་གཞན་པར་མགོ་སྐོར་བཏང་ནས་ཁང་པ་ཉོས་པ་ལྟ་བུར་མཚོན་ན།",
    "གསང་བདག་གི་བྱ་སྤྱོད་འདི་རྫུན་བཟོ་བྱས་པའི་དངུལ་ལོ་བེད་སྤྱོད་བྱེད་པའི་བྱས་ཉེས་སུ་གྲུབ་ཡོད་པ་ལྟ་བུ་རེད།",
    "སྐྱེད་ཀ་མཐོན་པོ་སྟེར་རྒྱུ་ཞེས་མི་མང་བོའི་སྒོར་མོ་དུང་ཕྱུར་གཅིག་བྱེ་བ་གཉིས་དང་ས་ཡ་དྲུག་ལོ་ལྷག་བསྡུས་ལ།",
    "དངུལ་སྒོར་ཇེ་མང་དུ་སོང་བ་དང་བསྟུན་འདོད་པ་ཇེ་ཆེར་གྱུར་ནས་རང་སྒེར་གྱིས་ལོངས་སྤྱོད་བྱས་མཐར།",
    "མོ་རང་ཧྲང་ཧེ་ནས་རང་གི་ཕ་ཡུལ་དུ་ལོག་རྗེས།",
    "དངུལ་སྒོར་ས་ཡ་གཉིས་བཀོལ་ནས་བྱིས་པའི་རྩེད་ཆས་ཀྱི་བཟོ་གྲྭ་ཞིག་འཛུགས་རྒྱུ་ཡིན་མོད།",
    "མ་གཞི་ལྷ་མོར་སྒོར་བརྒྱ་ཕྲག་འགའ་ལས་མེད་པ་མ་ཟད།",
    "ཞུ་སྦྱོར་ཕྱི་མ་བ་ལྷ་མོས་བདག་གིར་འཛིན་རྒྱུ་དམིགས་ཡུལ་དུ་བཟུང་ནས་ཁ་བསླུས་རྒྱག་ཐབས་ལ་བརྟེན་ཏེ།",
    "འགྲོ་རྩིས་བཅངས་བའི་བྱ་སྤྱོད་འདི་རིགས་མ་དངུལ་བསྡུ་རུབ་ཀྱིས་ཁ་བསླུས་རྒྱག་པའི་བྱས་ཉེས་སུ་གྲུབ་ཡོད་པ་ལྟ་བུ་རེད།",
    "བཟའ་སྒྲིག་བྱས་ཟིན་པའི་ཞུ་སྦྱོར་ཕྱི་མ་བ་འབྲུག་ཐར་དང་ཉེན་འགོག་འགན་ལེན་ཀུང་སིའི་ལས་གཉེར་བ་ལྷ་མོ་གཉིས་དགའ་རོགས་ཡིན།",
    "བཀྲ་ཤིས་ལ་སྔ་རྗེས་ཐེངས་གསུམ་ཙམ་གྱིས་ཚེ་སྲོག་གི་ཉེན་འགོག་འགན་ལེན་དངུལ་སྒོར་ས་ཡ་གཅིག་ལྷག་གིས་ཉོ་རུ་བཅུག་ཕན་ཆ་ཐོབ་མཁན་གྱི་ཁྲོད་དུ་ལྷ་མོ་ཡང་ཡོད།",
    "༢ལོའི་ཟླ་༢པའི་ཚེས་༡༩ཉིན་གྱི་དགོང་མོ་དུས་ཚོད་བཅུའི་སྟེང་།",
    "འབྲུག་ཐར་གྱིས་ཀྱང་རང་གིས་བསད་པ་ཡིན་ཞེས་སྔ་གཞུག་ཚང་མ་ཁས་བླངས།",
    "ལོ་གཅིག་གི་དཔྱ་ཁྲལ་ཁྲོད་ཀྱི་དཔྱ་ཁྲལ་རིགས་སོ་སོའི་ཁྲལ་དངུལ་མ་འཇལ་བའི་གྲངས་འབོར་དང་ལོ་གཅིག་དེར་དཔྱ་ཁྲལ་འཇལ་དགོས་པའི་གྲངས་འབོར་གྱི་བསྡུར་ཚད་ལ་བསྟན།",
    "ལོ་གཅིག་གི་ཁྲོད་དཔྱ་ཁྲལ་མ་འཇལ་པའི་གྲངས་འབོར་རྣམས་བསྡོམས་ནས་བརྩི་དགོས་ལ།",
    "ལོ་གཅིག་གི་ཡུན་རིང་སྲིད་འཛིན་ཐོག་གི་ཆད་པ་ཐེངས་གཉིས་ཁུར་མྱོང་བ་མ་ཟད།",
    "དུ་བ་དེ་དག་གི་སྤུས་ཀ་ཚད་ལྡན་ཡིན་མིན་གསལ་པོར་བདེན་དཔང་བྱ་མ་ཐུབ་མོད།",
