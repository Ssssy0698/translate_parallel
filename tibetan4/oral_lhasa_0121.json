    "དེ་དག་ལས་ཀྱང་བདུད་རྩིའི་རྒྱུན་འཛག་པར་བསམ།",
    "སྣ་ཚོགས་རྡོ་རྗེའི་ལྟེ་བའི་ཧ་ཱུྃ་ལས་འོད་ཟེར་སྟེང་དུ་འཕྲོས་པས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ཁ་ནས་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ཐོད་པ་བདུད་རྩིས་གང་བ་དཔག་དུ་མེད་པ་སྤྱན་དྲངས་ལ་མདུན་གྱི་ཐོད་པ་ལ་ཐོད་པ་ཐིམ་བདུད་རྩི་ལ་བདུད་རྩི་ཐིམ་སྟེ་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་དང་གཉིས་སུ་མེད་པར་གྱུར་པར་བསམ།",
    "སྣ་ཚོགས་རྡོ་རྗེ་ཟླ་བ་ཨོཾ་དང་བཅས་པ་ལྷུང་བས་གཉིས་སུ་མེད་པར་གྱུར་ནས་ཁ་དོག་དང་དྲི་རོ་དང་ནུས་པ་ཕུན་སུམ་ཚོགས་པར་གྱུར་པར་བསམ་ཞིང་ཨོཾ་ཨཱ་ཧ་ཱུྃ་ཧ་ཧོ་ཧྲཱི་ཞེས་ལན་གསུམ་བཟླས་ཏེ་རྫས་སྦྱང་བའོ།",
    "ཨོཾ་ཡོ་ག་ཞེས་སོགས་བརྗོད་ཅིང་རྣམ་ལྔ་འདོད་སྐོར་བྱ་སྟེ་བརྟན་པར་བྱའོ།",
    "ཞེས་ལན་ལྔ་བརྗོད་པས་འཁོར་ལོ་དགུ་ཚན་ལྔ་རིམ་པ་བཞིན་ཚིམ་པར་བསམ་སྟེ།",
    "ཨོཾ་ཀ་ར་ཀ་ར་ལ་སོགས་ཕྲིང་སྔགས་བཟླས་པས་ཀྱང་མཉེས་པར་བྱའོ།",
    "རྐང་པ་བརྒྱད་པ་གཉིས་ཀྱིས་བསྟོད་ནས་འདོད་པའི་དོན་ལ་གསོལ་བ་གདབ་པར་བྱའོ།",
    "ཕེཾ་གྱི་སྒྲ་དང་འབར་བའི་ཕྱག་རྒྱ་སྔར་བཞིན་བྱས་ལ།",
    "ཞེས་ལན་གསུམ་བརྗོད་པས་དུར་ཁྲོད་ཀྱི་བདག་པོ་རྣམས་མཉེས་པར་བསམ་པར་བྱའོ།",
    "བྱ་བྱེད་ངན་པ་མེད་པར་མཛོད།",
    "ཅེས་བརྗོད་པར་བྱའོ།",
    "དེ་ནས་ཡི་གེ་བརྒྱ་པས་བཟོད་པར་གསོལ་ཏེ།",
    "ཆོ་ག་ནི་གཞན་དུ་ཤེས་པར་བྱ་སྟེ།",
    "ཁ་ཟས་ཀྱི་རྗེས་ལ་ལྷག་མའི་གཏོར་མས་འབྱུང་པོ་ཚིམ་པར་བྱ་བ་དང་།",
    "དེ་ནས་མཉམ་པར་བཞག་པའི་རྣལ་འབྱོར་ལ་བསྐྱེད་རྫོགས་གཉིས་ལས།",
    "དེ་ལས་ཞབས་ཀྱུ་སྟེ་ཧ་ཱུྃ་དུ་གྱུར་པར་བསམ།",
    "སྟེང་འོག་ཕྱོགས་མཚམས་རྣམས་སུ་འཁོད་པར་བསམ།",
    "ཡང་རྡོ་རྗེའི་ལྟེ་བའི་ཧ་ཱུྃ་ལས་རྡོ་རྗེ་ཕུར་བུ་བཅུ་སྤྲོས་ཏེ་ཕོ་ཉ་རྣམས་ཀྱི་ལག་པ་གཡོན་པར་གཏད།",
    "རྡོ་རྗེ་ཐོ་བ་བཅུ་སྤྲོས་ཏེ་ལག་པ་གཡས་པར་གཏད་པས།",
    "ཕྱོགས་སྐྱོང་བཅུའི་སྤྱི་བོར་ཕུར་བུས་བཏབ་པར་བསམ་ལ།",
    "ཨོཾ་བཛྲ་མུངྐ་ར་སོགས་བརྗོད་ཅིང་ཕུར་བུ་བརྡུང་བའི་ཚུལ་བྱས་ནས།",
    "ཕྱག་གཡས་གཡོན་དུ་གཏད་ལ་གྷ་གྷ་ལ་སོགས་པ་བརྗོད་ཅིང་ཕུར་བུ་གདབ་ཞེས་གསུངས་པས་སོ།",
    "ཡབ་ཡུམ་གཉིས་ཀའང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པའོ།",
    "ཀྱེ་རྡོར་སོགས་ཕལ་ཆེར་ལ་ཆད་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་སྟོང་པར་རྣམ་བསྒོམས་ཏེ།",
    "ཞེས་གསུངས་ཤིང་།",
    "འོ་ན་ཡུམ་ཡང་ཕྱག་བཅུ་གཉིས་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཞེས་དེའི་ཕྱག་མཚན་དམིགས་བསལ་དུ་གསུངས་པའི་ཕྱིར་རོ།",
    "མགྲིན་པར་ཨོཾ་ཧྲི་ཧ་ཧ་ཧ་ཱུྃ་ཧ་ཱུྃ་ཕཊ་དམར་པོ་གསུང་རྡོ་རྗེ།",
    "མགྲིན་པར་ཨོཾ་ཙོ་རཱི་ཧ་ཱུྃ་ཧ་ཱུྃ་ཕཊ་དམར་པོ་གསུང་རྡོ་རྗེ།",
    "ཡབ་ཡུམ་གཉིས་ཀའི་སྤྱི་བོར་ཨོཾ་དཀར་པོ་རྣམ་པར་སྣང་མཛད།",
    "མགྲིན་པར་ཨཱ་དམར་པོ་འོད་དཔག་མེད།",
    "ཕེཾ་གྱི་སྒྲས་ཡབ་ཡུམ་སྤྱན་དྲངས་ལ་ཕྱི་མཆོད་ཀྱིས་མཆོད་ནས་ཛ་ཧ་ཱུྃ་བཾ་ཧོ་གཉིས་སུ་མེད་པར་བསྟིམས་པ་ལ།",
    "རྒྱུ་རྡོ་རྗེ་འཛིན་པའི་སྐབས་ལྟར་མཁའ་གསང་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "གཉིས་པ་དཀྱིལ་འཁོར་རྒྱལ་མཆོག་ནི་ཡབ་ཡུམ་གཉིས་སྙོམས་པར་ཞུགས་པས་ཟག་པ་མེད་པའི་བདེ་བས་རྒྱུད་གང་བར་བསམས་ལ།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཨ་ནུ་རཱ་ག་ན་བཛྲ་སྭཱ་བྷཱ་ཝ་ཨཱཏྨ་ཀོཧཾ་སྙོམས་པར་ཞུགས་པའི་སྒྲ་དང་།",
    "ཞབས་གཡས་བརྐྱང་བའི་སྟབས་ཀྱིས་རོའི་གདན་ལ་བཞུགས་པའོ།",
    "ལྟག་པ་དང་ལྷོ་རྩིབས་ཨརྦུ་དར་མཆེ་བ་རྣམ་པར་གཙིགས་པ་དང་སྣ་ཆེན་མ།",
    "ཕྲག་པ་གཉིས་དང་བྱང་ཤར་མཱ་ལ་ཝར་རྡོ་རྗེའི་སྐུ་དང་ཤིང་གྲིབ་མ་སྟེ་ཐུགས་ཀྱི་འཁོར་ལོའི་ལྷ་རྣམས་ཁ་དོག་སྔོན་པོ་ནམ་མཁའ་ལ་སྤྱོད་པའི་ཚུལ་གྱིས་བཞུགས་པའོ།",
    "མཐེ་བོང་བཞི་དང་ནུབ་བྱང་མ་རུར་རྣམ་པར་སྣང་མཛད་དང་འཁོར་ལོས་བསྒྱུར་མ།",
    "ཐམས་ཅད་ཀྱང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པའོ།",
    "ཞབས་གཡས་བརྐྱང་བའི་སྟབས་ཀྱིས་རོའི་གདན་ལ་བཞུགས་པའོ།",
    "དེའི་ཚེ་ཕྱག་བཅུ་གཉིས་ལ་འགོད་པ་མེད་པས་རྒྱུད་ཀྱི་དགོངས་པ་ཕྱོགས་གཅིག་སྟེ་མ་འདྲེས་པར་སོ་སོར་ཤེས་པར་བྱའོ།",
    "རྗེ་ས་ཆེན་གྱི་བསྡུས་དོན་དང་ཐོ་ཡིག་རྣམས་སུ་མ་གསུངས་ཡང་ཕྱག་ལེན་ལ་མཛད་པར་སྣང་སྟེ།",
    "དང་པོ་སྦྱོར་བའི་སྐབས་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "སྒོ་མཚམས་མ་བརྒྱད་དང་ཡབ་ཀྱི་རྐང་བརྒྱད་སྤེལ་བ་དང་མ་སྤེལ་བར་རྐྱང་པ་བཟླ་བ་གང་རུང་བྱ་བར་གསུངས་སོ།",
    "གཉིས་པ་མཉམ་པར་མ་བཞག་པའི་རྣལ་འབྱོར་ལ་གསུམ་སྟེ།",
    "ལ་ཱུཧི་པ་ལྟར་གཉིས་སུ་མེད་པར་བཟླས་པ་ཡང་རུང་གསུངས་ཏེ།",
    "སྭ་བྷཱ་ཝས་སྟོང་པར་སྦྱངས།",
    "བདུད་རྩི་ལ་བདུད་རྩི་ཐིམ་ཁ་ཊྭཱཾ་ག་ཨོཾ་དང་བཅས་པ་ལྷུང་བས་གཉིས་སུ་མེད་པར་གྱུར་ནས་ཁ་དོག་དྲི་རོ་ནུས་པ་ཕུན་སུམ་ཚོགས་པ་བདུད་རྩིའི་རྒྱ་མཚོ་ཆེན་པོར་གྱུར།",
