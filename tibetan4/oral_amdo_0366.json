    "མཁྱེན་པའི་སྐད་ཅིག་གཅིག་གིས་ནི།",
    "མོངྒལ་གྱི་བུས་གསུང་གི་མཐའ་དཔོག་པར་འདོད་ནས་ཤར་ཕྱོགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་དགུ་བཅུ་རྩ་དགུའི་བྱེ་མ་སྙེད་འདས་པར་ཕྱིན་པས་གསུང་གི་མཐའ་མ་དཔོགས་པ་ལྟ་བུ་རྣམས་ཡིན་ནོ།",
    "འོན་ཀྱང་གཞུང་ཚིག་གིས་འབྲས་རྒྱུད་དངོས་སུ་ཐོན་པས་སྐབས་འདིར་འབྲས་རྒྱུད་ཀྱི་རྣམ་གཞག་འཆད་པ་འབྲེལ་ཆགས་ལ།",
    "དེང་སང་གི་གཞུང་ཚིག་ཏུ་ཞུ་བ་གསལ་བར་མ་ཐོན་པ་ནི་ཞུ་བའི་དོན་སྨོས་པས་གཞན་རྣམས་ཤུགས་ཀྱིས་གོ་བ་ལ་དགོངས་སམ་སྙམ་སྟེ་དཔྱད་པའི་གནས་སོ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ཏེ་ཐལ་མོ་སྦྱར་བ་བྱས་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་ལ་གཟིགས་ཏེ་དེའི་སྤོབས་པ་བསྐྱེད་པའི་ཕྱིར་ཞལ་འཛུམ་པ་མཛད་དོ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་ཐལ་མོ་སྦྱར་བ་བྱས་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "གསང་བ་ནི་འཇིག་རྟེན་པ་དང་ཉན་རང་གི་སྤྱོད་ཡུལ་མ་ཡིན་པ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་གཏུམ་མོའི་མེའམ་བྱང་སེམས་སོ།",
    "སྐུ་གསུང་ཐུགས་ནི་ལུས་ངག་ཡིད་གསུམ་མམ་དགའ་བ་སྔ་མ་གསུམ་མོ།",
    "ལེགས་སོ་ལེགས་སོ་ནི་གསང་ཆེན་ཞུས་པ་ལ་དགྱེས་པའི་ཚིག་གིས་སྐབས་འབྱེད་པ་སྟེ།",
    "དེ་དག་གི་དོན་ལ་དཔྱད་པ་གསུམ་གྱི།",
    "གནས་སྐབས་སྙོམས་འཇུག་གི་དུས།",
    "འཇིག་རྟེན་གྱི་ལྷ་ཁྱབ་འཇུག་གི་ཚུལ།",
    "དེ་ལ་གསུང་གི་རྡོ་རྗེར་གསུངས།",
    "གསུམ་པ་དེ་དག་གི་དོན་ལ་དཔྱད་པ་",
    "འགའ་ཞིག་གིས།",
    "འགའ་ཞིག་གིས་གླེང་གཞི་དང་རྒྱུད་ཞུས་པའི་སྐུ་གསུང་ཐུགས་རིམ་པས་སེམས་དཔའ་གསུམ་ལ་སྦྱར་ནས།",
    "དེ་དག་གིས་ལམ་འབྲས་ཀྱི་སྐུ་གསུམ་དང་གཞི་འབྲས་ཀྱི་ཀྱེའི་རྡོ་རྗེ་ཡང་དངོས་སུ་བསྟན་པའི་ཕྱིར་རོ།",
    "ཐ་སྙད་དུ་སྒྲུབ་བྱེད་དེ་དག་གིས་གཉིས་མེད་ཀྱི་རྒྱུད་དུ་བསྒྲུབས་ནས།",
    "གང་གིས་དམ་ཚིག་སེམས་དཔའ་ལགས།",
    "རིགས་པ་གང་གི་ཕྱིར་སྐུ་ལ་རྡོ་རྗེ་སེམས་དཔའ་ཞེས་བགྱི་བ་ལགས།",
    "དེ་དག་གི་ངེས་ཚིག་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་ལ་གསུངས་ཤིག་ཅེས་ཞུས་པའི་ལན་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "དམ་ཚིག་གི་སྒྲ་ས་མ་ཡ་ཞེས་པ་མི་འདའ་བའི་དོན་ཏེ།",
    "ཡང་ན་རྡོ་རྗེ་ནི་སྐྱེ་འཇིག་གིས་མི་ཕྱེད་པའི་དབྱིངས།",
    "ཡང་ན་རྡོ་རྗེ་ནི་ཕུང་ཁམས་བསྲེག་པའི་གཏུམ་མོའམ་ཉམས་པ་མེད་པའི་བྱང་སེམས།",
    "རྟག་ཏུ་དམ་ཚིག་སྟེ་གཞན་དོན་ལས་མི་འདའ་བར་སྤྲུལ་པས་འཇིག་རྟེན་ཀུན་ཏུ་སྤྱོད་པ་སྟེ་མཐར་ཐུག་གི་དོན་ནོ།"
  ]
}