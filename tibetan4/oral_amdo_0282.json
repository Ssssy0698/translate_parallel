    "ཉེས་པར་བྱས་པ་གང་ཡིན་པ་དེ་ནི་ཞིང་གི་སྒོ་ནས་ལྕི་བ་ཡིན་ནོ།",
    "དེ་ལ་མྱོང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ལན་གྲངས་གཞན་ལ་མྱོང་བར་འགྱུར་བ་ཞིག་ཡིན་ན་ནི་དགྲ་བཅོམ་པ་ཉིད་འཐོབ་པའི་བར་ཆད་བྱེད་མི་ནུས་མོད་ཀྱི་འོན་ཀྱང་དེ་ཡང་མྱོང་བར་འགྱུར་བ་མ་ཡིན་པ་ནི་མ་ཡིན་ནོ།",
    "ཉོན་མོངས་པའི་གྲོགས་དེ་ཡང་ཡོད་ལ་འདུ་བྱེད་དེ་ཡང་ཡོད་ན་དེ་ལྟར་དེ་ལ་མྱོང་བར་འགྱུར་བ་ངེས་པ་ཞེས་འདོགས་པའི་ཕྱིར་རོ།",
    "སྡུག་བསྔལ་མྱོང་བར་འགྱུར་བ་ནི་ངན་སོང་དུ་སྐྱེ་བར་འགྱུར་བ་གང་ཡིན་པའོ།",
    "སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་པ་མྱོང་བར་འགྱུར་བ་ནི་བསམ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ལུས་དང་ངག་གི་སྦྱོར་བས་ཞིང་དེ་ལྟ་བུ་ལ་བྱས་པས་ཚེ་འདི་ལ་གང་གི་རྣམ་པར་སྨིན་པར་འགྱུར་བ་གང་ཡིན་པའོ།",
    "མཐོང་བས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པ་དང་ལྡན་པ་གང་ཡིན་པ་དང་།",
    "ངན་སོང་དུ་འགྲོ་བར་འགྱུར་བའི་ལས་ཐམས་ཅད་ནི་མཐོང་བས་སྤང་བར་བྱ་བའོ།",
    "དེ་ལ་ཚེ་འདི་ལ་སྤོང་བ་ནི་ཇི་ལྟར་འདི་ན་ཁ་ཅིག་ཚེ་འདི་ལ་ཆེད་དུ་བསམས་ཏེ་ལས་བྱས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གཞན་ཡང་འདི་ནས་སོ་སོའི་སྐྱེ་བོ་འདོད་པའི་འདོད་ཆགས་དང་བྲལ་བ་ཁ་ཅིག་གིས་སྤོང་བ་ཡང་དག་པར་བླངས་ནས་འཆི་བའི་དུས་བྱེད་པར་གྱུར་ན་དེའི་ཚེ་འདི་ལ་བྱེད་ཀྱང་མི་བྱེད།",
    "སྐྱེས་ནས་དེར་སྐྱེས་པའི་ཚེ་ལྟ་བྱེད་པར་ག་ལ་འགྱུར་དེ་ལྟ་མོད་ཀྱི་ལན་གྲངས་གཞན་ལ་ལས་དེ་བྱེད་པ་དང་།",
    "བདག་གིས་དེ་འདི་ལྟ་སྟེ།",
    "ལུས་དང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཕྱིར་མི་ནི་སེམས་ཀྱི་རྒྱུ་ལས་བྱུང་ངོ་ཞེས་འབྱུང་སྟེ།",
    "གཏི་མུག་དྲག་ཅིང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ཉིད་ནི་དེ་དག་གི་ནང་ན་གཅིག་ཏུ་ངེས་པར་དཀར་བ་ཡིན་ནོ།",
    "གྲང་བའི་སེམས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རེག་པའི་སྐྱེ་མཆེད་དྲུག་གི་སྒོ་ནས་ཉམས་སུ་མྱོང་བས་ན་རེག་པའི་སྐྱེ་མཆེད་ཅན་ཞེས་ཀྱང་བྱ་སྟེ།",
    "དེ་ལ་འདིར་ཀུན་ནས་ཉོན་མོངས་པ་གཅིག་ནི་བདེན་པའི་དངོས་པོ་ལ་སྐུར་པ་འདེབས་པའོ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པ་རྣམ་པ་གཉིས་ལ་བརྟེན་པས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འདི་ལས་ཕྱི་རོལ་པ་ནི་སེམས་མཉམ་པར་བཞག་པ་ཡིན་དུ་ཟིན་ཀྱང་དེ་ནི་རེག་པའི་སྐྱེ་མཆེད་རྣམས་ཀྱི་ཡོངས་སུ་བསྒྱུར་བ་ལྔའི་ཚུལ་གྱིས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པ་དང་ཡང་དག་པའི་སེམས་འདོད་ཆགས་དང་བྲལ་བ་དང་།",
    "ཉོན་མོངས་པའི་རྒྱགས་པ་མི་བཟོད་དོ།",
    "དད་པ་དང་ཐོས་པ་ཙམ་གྱིས་བདག་མེད་པ་ལ་མོས་པར་ཟད་དུ་ཟིན་པ་དེ་ནི་སེམས་ཀྱི་ཏིང་ངེ་འཛིན་འཐོབ་པའི་སྐལ་པ་ཅན་ཡིན་ལ་དེ་ནི་རེག་པའི་སྐྱེ་མཆེད་རྣམས་སྤོང་བ་དང་།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་པའི་ཕྱིར་ཤིན་ཏུ་ཡང་དག་པར་བསྡམས་པ་དང་།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་དག་གི་མི་རྟག་པ་ཉིད་ཀྱང་མཁྱེན།",
    "ལྷག་པར་ཆགས་པར་བྱ་བ་ནི་ཕྱི་རོལ་གྱི་ཡུལ་འདོད་པ་དང་ནང་གི་འདོད་པའི་ཚོར་བ་འདི་དུས་གསུམ་དུ་གཏོགས་པ་འདི་དག་ནི་རྣམ་པ་བཞིར་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་འདས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་དག་ཀྱང་མིག་གིས་རྣམ་པར་ཤེས་པར་བྱ་བའི་གཟུགས་ལ་སོགས་པ་ལ་དམིགས་པའི་བྱེ་བྲག་གིས་དྲུག་ཏུ་འགྱུར་རོ།",
    "མྱུར་དུ་དགེ་སྦྱོང་གི་ཚུལ་འདོད་པའི་ལུས་དང་སྲོག་ལ་མི་ལྟ་བ་དང་།",
    "འདོད་པ་རྣམས་ཀྱི་རང་གི་མཚན་ཉིད་ཡོངས་སུ་ཤེས་པས་དྲན་པ་ཉེ་བར་གནས་པ་དང་།",
    "ཉེས་དམིགས་ཡོངས་སུ་ཤེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རོ་མྱོང་བ་མེད་པས་ནི་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་མ་ཡིན་ནོ།",
    "རྨུགས་པ་དང་གཉིད་ཀྱིས་ཉེ་བའི་ཉོན་མོངས་པར་མ་གྱུར་པས་ནི་ཉེས་རྩོམ་མེད་དོ།",
    "གཅིག་ཏུ་ངེས་པར་དྲན་པ་ཉེ་བར་གཞག་པ་ལ་བརྟེན་པས་ནི་ལྷག་མཐོང་ལ་བརྩོན་པའི་དྲན་པ་གནས་པར་འགྱུར་ལ་རྒོད་པའི་ཉེ་བའི་ཉོན་མོངས་པ་དང་བྲལ་བས་ནི་ཀུན་ནས་ཉོན་མོངས་པ་མེད་དོ།",
    "དགྲ་བཅོམ་པ་ནི་སློབ་པའི་སེམས་རྣམ་པར་གྲོལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཚེ་འདིའི་བདེ་བར་གནས་པ་ལས་ཡོངས་སུ་ཉམས་པར་འགྱུར་མོད་ཀྱི་འོན་ཀྱང་དེ་ནི་ཚེ་འདིའི་བདེ་བར་གནས་པ་ལས་ཡོངས་སུ་ཉམས་ཀྱང་རུང་ཡོངས་སུ་ཉམས་ཀྱང་རུང་སྟེ།",
    "གང་གི་དོན་དུ་བག་ཡོད་པར་བྱེད་དེ།",
    "བག་ཡོད་པར་གནས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཚེ་འདི་ལ་ཉོན་མོངས་པ་ཡོད་པ་དང་མེད་པ་ཡོངས་སུ་གཅོད་པའི་ཕྱིར་ཚེ་འདི་ལ་མྱོང་བ་དང་།",
    "འདི་ལས་ཕྱི་རོལ་པ་རྣམས་དང་ཐུན་མོང་མ་ཡིན་པའི་ཕྱིར་འདི་པས་མཐོང་བ་དང་།",
    "ལྟ་བ་དཔྱོད་པའི་བཟོད་པ་མ་ཡིན་པར་རང་གིས་རྟོགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་སོ་སོ་རང་རིག་པའོ།",
    "དེ་ལ་རང་བཞིན་མི་མཚུངས་པ་ནི་ཆུའི་རྒྱ་མཚོ་ནི་གཟུགས་ཀྱི་ཕྱོགས་གཅིག་གི་རང་བཞིན་དུ་ཟད་པའི་ཕྱིར་ཚད་ངེས་པ་ཡིན་ལ།",
    "གང་གིས་འབྱིང་བ་དང་།",
    "དེ་དག་ཀྱང་ལུས་ཙམ་ཞིག་གིས་འབྱིང་བར་ཟད་ཀྱི།",
    "ངག་གིས་མ་ཡིན།",
    "ཞེ་སྡང་གིས་མ་ཡིན།",
    "གཏི་མུག་གིས་མ་ཡིན་སྐྱེ་བ་ལ་སོགས་པའི་སྡུག་བསྔལ་གྱིས་མ་ཡིན་ནོ།",
    "དེ་ཡང་ལས་དང་ཉོན་མོངས་པ་དང་།",
    "ཁྱིམ་པ་རྣམས་ནི་རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་ཡང་སྡུག་བསྔལ་རྣམས་ཀྱིས་ཀུན་ནས་བཅོམ་ཞིང་ཉོན་མོངས་པ་རྣམས་ཀྱིས་སྲེག་བཞིན་དུ་སྐྱོ་བར་མི་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་མ་ཡིན་པའི་སྐྱེ་གནས་སུ་སྐྱེས་པ་རྣམས་ནི་འགྲོ་བ་དང་འོང་བ་ལ་ལས་དང་ཉོན་མོངས་པ་ལ་བརྟེན་པའི་ཕྱིར་རོ།",
    "དུད་འགྲོའི་སྐྱེ་གནས་སུ་གྱུར་པ་དེར་སྐྱེས་པ་རྣམས་ཀྱང་ལས་དང་ཉོན་མོངས་པའི་ཕྱོགས་གཅིག་ཙམ་གྱིས་འབྱིང་བར་ཟད་དེ།",
    "སློབ་པའི་ནང་གི་སྐྱེ་མཆེད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དྲུག་གི་བྱེ་བྲག་གོ།",
    "འདོད་ཆགས་དང་བྲལ་བའི་སོ་སོའི་སྐྱེ་བོ་ནི་ནང་གི་སྐྱེ་མཆེད་དྲུག་གི་རྒྱ་མཚོ་ལས་རྒལ་མི་ནུས་ཏེ།",
    "དེས་ནི་སྐྱེ་མཆེད་དྲུག་གི་རྒྱ་མཚོ་ཡང་རྒལ་ཏེ།",
    "དེ་ལས་རྒལ་བས་ཡུལ་རྣམ་པ་གཉིས་པས་རྒྱ་མཚོ་བསླབ་པ་འབུལ་བ་ཀུན་ནས་སློང་བའི་ཉོན་མོངས་པ་དང་བཅས།",
    "རྟོག་པ་དང་སེམས་ཀུན་དུ་འཁྲུག་པ་ཀུན་ནས་སློང་བའི་ཉོན་མོངས་པ་དང་བཅས།",
    "རྙེད་པ་དང་བཀུར་སྟི་ལ་ལྷག་པར་ཞེན་པ་ཀུན་ནས་སློང་བའི་ཉོན་མོངས་པ་དང་བཅས།",
    "ངན་པར་སྤྱོད་པ་ཀུན་ནས་སློང་བའི་ཉོན་མོངས་པ་དང་བཅས་པ་ལས་གཏན་རྒལ་བ་ཡིན་ནོ།",
    "གཅིག་ནི་ཀུན་ནས་ཉོན་མོངས་པར་འགྱུར་པའོ།",
    "སྡུག་བསྔལ་འགོག་པར་འགྱུར་བའི་ལམ་དེ་ཉིད་ལ་ཡང་འདུས་བྱས་ཀྱི་སྤྱིའི་མཚན་ཉིད་ལ་འཇུག་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཚོར་བ་རྣམ་པར་གཞག་པ་རྣམ་པ་ལྔ་ལ་རྣམ་པ་རེ་རེ་ཞིང་ཡང་འཇིག་ཚོགས་ལ་ལྟ་བ་རྣམ་པ་བཞི་བཞི་ལ་བརྟེན་ནས།",
    "ང་རྒྱལ་མེད་པའི་རྒྱུ་ལས་བྱུང་བའི་ཕན་ཡོན་གསུམ་མོ།",
    "ཆགས་པར་འགྱུར་བ་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་གྱི་དངོས་པོ་ལ་གཞོལ་བ་འདི་ནི་ཉེས་དམིགས་གཉིས་པའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་ཅན་ཆགས་པར་འགྱུར་བའི་ཡུལ་ལ་ཡང་དེ་དང་འདྲའོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྐད་ཅིག་པ་དང་སོ་སོ་རང་གི་ལུས་འཇིག་གོ།",
    "བདག་དང་བདག་གིས་སྟོང་ངོ།",
    "འདུས་མ་བྱས་ནི་བདག་དང་བདག་གི་སྟོང་ངོ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་འཇིག་རྟེན་གྱི་མཐར་ཐུག་པ་དགག་པར་མི་མཛད་མོད་ཀྱི་འོན་ཀྱང་ལུས་དང་འབྲེལ་བའི་འགྲོ་བའི་སྒོ་ནས་ནི་འཇིག་རྟེན་གྱི་མཐར་ཐུག་པ་དགག་པར་མཛད་དོ།",
    "འཇིག་རྟེན་གྱི་འདུ་ཤེས་ནི་འདུ་ཤེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རེག་པའི་སྐྱེ་མཆེད་དྲུག་པོ་རྣམས་རྣམ་པ་ལྔར་ཡོངས་སུ་བསྒྱུར་བ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པ་ནི་འཇིག་རྟེན་གྱི་མཐར་ཐུག་པའི་ཐབས་སོ།",
    "རྣམ་པ་འདི་དག་གིས་ནི་འཇིག་རྟེན་གྱི་མཐར་ཐུག་པར་རིག་པར་བྱའོ།",
    "ཉོན་མོངས་པ་སྐད་ཅིག་པས་ནི་ཚངས་པར་སྤྱོད་པའི་གནས་ལས་ཉམས་པར་བྱེད་མི་ནུས་ལ་རྒྱུན་གྱིས་ནི་ནུས་པའི་ཕྱིར་རོ།",
    "ཞིང་འགྲོ་བ་དང་གནས་པ་ལ་ཉོན་མོངས་པ་ཡོད་པ་དང་མེད་པ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཡོངས་སུ་ཤེས་ནས་ཡོད་ན་ནི་སྤོང་བའི་ཕྱིར།",
    "དེ་ལ་གང་དེས་ངག་ན་ཉོན་མོངས་པ་ཡོད་ན་ཡོད་པ་དང་མེད་ན་མེད་པར་ཡན་དག་པར་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་པ་འདི་ནི་འདིར་སྟོང་པ་ཉིད་ཡིན་ནོ།",
    "གང་ན་གང་མེད་པ་དེ་ནི་དེས་སྟོང་པར་ཡང་དག་པར་མཐོང་བ་ལ་གང་ན་ཡོད་པ་དེ་ནི་ཡོད་དེ་འདི་ན་ཡོད་དོ་བར་ཡང་དག་པར་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་ཏེ་དཔེར་ན་སྔོན་བུ་སའི་ཁང་པ་ནི་རེས་འགའ་སྐྱེ་བོའི་ཚོགས་ཁ་ཅིག་གིས་སྟོང་ལ་རེས་འགའ་ནི་མི་སྟོང་པ་དང་།",
    "ཡན་ལག་གང་ཡང་རུང་བ་ཁ་ཅིག་གིས་སྟོང་དུ་ཟིན་ཀྱང་ཁང་པ་ཉིད་ཁང་པས་སྟོང་པ་ནི་མ་ཡིན་ནོ།",
    "ལུས་དང་གནས་དེ་ཡང་རེས་འགའ་ཚོར་བ་དང་།",
    "སེམས་པའི་ཉོན་མོངས་པ་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པ་ཁ་ཅིག་གིས་ནི་སྟོང་ལ།",
    "ཁ་ཅིག་གིས་ནི་མི་སྟོང་བ་དང་།",
    "ལུས་དང་གནས་དེ་ཉིད་ནས་རེས་འགའ་མིག་གམ།",
    "ཁ་ཅིག་གིས་སྟོང་དུ་ཟིན་ཀྱང་ལུས་དང་གནས་ཐམས་ཅད་ཐམས་ཅད་ཀྱིས་སྟོང་པ་ནི་མ་ཡིན་ནོ།",
    "རྣམས་ཀྱི་རང་བཞིན་རང་བཞིན་གྱིས་སྟོང་པར་མཐོང་ན་ནི་ཕྱིན་ཅི་ལོག་གི་སྟོང་པ་ཉིད་ལ་ཞུགས་པ་ཡིན་པར་བསྟན་ཏེ།",
    "གལ་ཏེ་ཁ་ཅིག་ནི་རང་གི་མཚན་ཉིད་ཀྱིས་ཡོད་པར་མཐོང་ལ་ཁ་ཅིག་ནི་མེད་པར་མཐོང་བ་དང་།",
    "ཡོད་པར་ཡང་རེས་འགའ་ཁ་ཅིག་དང་བྲལ་ལ་རེས་འགའ་ནི་ཁ་ཅིག་དང་མ་བྲལ་བར་མཐོང་བ་འདི་ནི་ཡང་དག་པ་ཇི་ལྟ་བ་དང་།",
    "མཚུངས་པར་ལྡན་པའི་ཚོར་བ་དང་སེམས་པས་མི་སྟོང་ངོ་སྙམ་མོ།",
    "གྱོ་མོ་མང་པོ་འཛིན་པའི་རྣམ་པ་ཡིད་ལ་མ་བྱས་ནས།",
    "ཐམས་ཅད་དུ་ཡང་སྔ་མ་བཞིན་དུ་སྟོང་པ་ཉིད་དུ་འཕར་ཞིང་འོག་མ་ལ་ནི་རགས་པར་འདུ་ཤེས་ལ་གོང་མ་ལ་ནི་ཆེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ནི་རང་གི་ལུས་ལ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "གནས་འདི་ཉིད་ཀྱི་རྐྱེན་གྱིས་སྐྱེ་མཆེད་དྲུག་གཅིག་ལ་གཅིག་གིས་མི་སྟོང་ངོ་སྙམ་སྟེ།",
    "རྣམ་པར་གྲོལ་བ་རྣམ་པ་གཉིས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཚེ་འདི་ལ་བདེ་བ་ལ་རེག་པར་གནས་པས་ན་སྡུག་པ་ཞེས་བྱའོ།",
    "དེ་ལ་ནང་སྟོང་པ་ཉིད་ནི་ནང་གི་འདུ་བྱེད་རྣམས་ལ་ངའོ་སྙམ་པའི་ང་རྒྱལ་སྤང་བ་མངོན་སུམ་དུ་བྱ་བ་གང་ཡིན་པའོ།",
    "དེ་ལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྟོང་པ་ཉིད་རྣམ་པ་བཞི་པོ་འདི་དག་གི་རྟེན་ཡང་རྣམ་པ་བཞི་ཡོད་པར་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་ཕྱི་སྟོང་པ་ཉིད་ཀྱི་རྟེན་ནི་ནང་གི་སེམས་གནས་པའི་ཏིང་ངེ་འཛིན་གྱི་སྒོ་ནས་དབེན་པ་ལས་སྐྱེས་པའི་དགའ་བ་དང་བདེ་བས་ལུས་བརླན་པ་དང་ངའོ་སྙམ་པའི་ང་རྒྱལ་ཡོངས་སུ་ཤེས་པའོ།",
    "དེས་གནས་དེ་དག་ལ་སེམས་མ་མོས་པར་ཡང་དག་པའི་ཤེས་རབ་ཀྱིས་རྟོགས་ནས་སེམས་དེ་མི་སྡུག་པ་ལ་དམིགས་པའམ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཚེ་མི་འཇུག་པ་དེའི་བར་དུ་ནི་སོ་སོའི་སྐྱེ་བོའི་གནས་སྐབས་སོ།",
    "གང་གི་ཚེ་འཇུག་པ་དེ་ནི་སློབ་པའི་གནས་སྐབས་སོ།",
    "དེ་ལ་ཡང་ཚོད་ཤེས་ཤིང་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་གཏམ་བྱེད་དོ།",
    "ཡང་དག་པར་སྟན་ལ་འདུག་ལ་ཐམས་ཅད་དུ་འང་ཚོད་ཤེས་ཏེ་དེ་ལྟར་ན་འདི་ནི་འདིའི་རྒྱུ་ཞིང་འགྲོ་བ་དག་པ་ཡིན་ནོ།",
    "བར་སྐབས་དག་ཏུ་ཡང་སྤྱོད་པ་ཡིད་ལ་བྱེད་པས་ཉོན་མོངས་པ་ཀུན་དུ་སྤྱོད་པ་ལ་སོ་སོར་བརྟག་ཅིང་སེམས་རྣམ་པར་སྤྱོང་སྟེ།",
    "ཡང་སྲིད་པར་སྐྱེ་བའི་རང་བཞིན་གྱིས་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་རྣམས་དང་།",
    "ངན་སོང་གི་རྒྱུའི་རང་བཞིན་དང་།",
    "སྒྲ་ཙམ་ལ་མོས་པའི་རྗེས་སུ་འབྲང་བ་དང་།",
    "ཅིག་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སེམས་རྣམ་པར་གྲོལ་བའི་མན་ངག་གིས་ཕྱེ་བ་སྟེ།",
    "གང་གིས་བསྟན་པ་ལ་རབ་ཏུ་བྱུང་བ་དེ་ལྟ་བུར་མ་ཞུགས་ཏེ།",
    "སྒྲ་ཙམ་ལ་མོས་པའི་རྗེས་སུ་འབྲང་བའི་གཏམ་གྱིས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཕྱིར་ལོག་པར་སྒྲུབ་པའི་ཉན་ཐོས་རྣམས་ལ་ཡིད་བསྲུང་བ་མེད་པར་ངོ་བཟློག་ཕོད་པར་མཛད་དེ།",
    "དེའི་རྩ་བ་བག་ལ་ཉལ་གྱིས་ཀུན་ནས་ཉོན་མོངས་པར་གྱུར་ན་ཚེ་འདི་ལ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་འགྱུར་བའི་སྐལ་བ་མེད་དོ།",
    "དེ་ལས་བཟློག་པ་ནི་ཀུན་ནས་ཉོན་མོངས་པར་མ་གྱུར་ན་ཚེ་འདི་ལ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་འགྱུར་པའི་སྐལ་པ་ཅན་ཡིན་ནོ།",
    "ཁྱིམ་བདག་གི་བུ་དད་པ་ཅན་དང་།",
    "དགེ་སློང་ཐོས་པས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྐྱེ་མཆེད་དྲུག་ནི་དེ་དག་གི་ས་བོན་གྱི་གནས་ཡིན་པ་དང་།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ནི་སྤྱིར་ན་རྒྱུ་རྣམ་པ་གཉིས་ཀྱིས་རིག་པར་བྱ་སྟེ།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་རང་བཞིན་གང་ཡིན་པ་དང་།",
    "དེ་ལ་རང་བཞིན་ནི་འདུན་པའི་འདོད་ཆགས་ཏེ་ཀུན་ནས་ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་རྩ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་རྣམ་པ་གཉིས་ལས་སེམས་རྣམ་པར་གྲོལ་བར་བྱའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་རྣམ་པ་གཉིས་པོ་གང་ལས་ནི་སེམས་རྣམ་པར་གྲོལ་བར་བྱ་ཞེ་ན།",
    "བདག་རང་གི་སྐྱེ་མཆེད་རྣམས་མཚོན་ཆ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་བཏབ་ཅིང་མ་རུང་བར་བྱས་ཀྱང་སླའི།",
    "རྟགས་འཛིན་པའི་ཀུན་ནས་ཉོན་མོངས་པ་ལས་རྣམ་པར་འབྱེད་དོ།",
    "དེ་ལ་ཀུན་ནས་ཉོན་མོངས་པ་དང་པོ་ནི་རྒྱུ་ལྟ་བུ་ཡིན་ལ་གཉིས་པ་ནི་འབྲས་བུ་ལྟ་བུ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་བས་ན་སྐད་ཅིག་གཅིག་གིས་ཀུན་ནས་ཉོན་མོངས་པ་རྣམ་པ་གཉིས་ལ་ཡང་ཉེས་པར་ལྟ་བ་དང་།",
    "འདི་དག་ནི་བདུད་འཇུག་པར་འགྱུར་བའི་ཀུན་དུ་ཆགས་པའི་གནས་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པ་མང་པོས་ཏེ་དེ་དག་ནི་མཁས་པས་ཡོངས་སུ་ཤེས་ནས་ཡོངས་སུ་སྤང་བར་བྱ་བ་ཡིན་ཏེ།",
    "ཡིད་དུ་འོང་བ་རྣམས་ཀྱི་དབྱེ་བ་ནི་སྔ་མ་བཞིན་དུ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཀུན་ནས་ཉོན་མོངས་པ་ནི་གཉིས་ཏེ།",
    "ཕྱི་རོལ་གྱི་ཡུལ་གྱི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ནང་གི་ཚོར་བའི་ཀུན་ནས་ཉོན་མོངས་པའོ།",
    "དེ་ལ་མིག་ལ་སོགས་པ་ལ་བརྟེན་ནས་གཟུགས་ལ་སོགས་པའི་ཡུལ་རྣམས་ལ་ལྷག་པར་ཞེན་པ་ནི་ཡུལ་གྱི་ཀུན་ནས་ཉོན་མོངས་པའོ།",
    "རེག་པ་ལ་བརྟེན་ནས་ནང་གི་ཚོར་བ་ལ་ལྷག་པར་ཞེན་པ་ནི་ཚོར་བའི་ཀུན་ནས་ཉོན་མོངས་པའོ།",
    "སྲེད་པ་དང་ལྟ་བ་ནི་རྣམ་པ་ཐམས་ཅད་ནི་རྣམ་པ་བཅོ་ལྔས་ཀུན་ནས་ཉོན་མོངས་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "མོས་པ་དང་ནི་སྒོ་བསྡམས་དང་།",
    "རྒྱུ་འདྲ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྣམ་པར་ཤེས་པ་དེ་ཡང་རྟེན་དང་དམིགས་པའི་བྱེ་བྲག་གིས་རྣམ་པ་དུ་མར་འཇུག་པར་ཡང་དག་པའི་ཤེས་རབ་ཀྱིས་མཐོང་ངོ།",
    "གཞན་དག་གི་བློའི་ཁྱད་པར་ཡོངས་སུ་བརྟག་པའི་བསམ་པས་བྱ་བ་ཙམ་དུ་ཟད་དོ།",
    "སྐྱེ་མཆེད་དྲུག་པོ་གང་གི་སྐྱེ་བ་ཡང་ཡོད་ལ་འཇིག་པ་ཡང་ཡོད་པ་དེ་ལ་ནི་ཕན་ཚུན་མཚན་ཉིད་ཐ་དད་པ་ཡང་ཡོད་དོ།",
    "གང་ལ་ཕན་ཚུན་མཚན་ཉིད་ཐ་དད་པར་ཡོད་པ་དེ་ལ་ནི་རིགས་གཞན་ལ་ལྟོས་ནས་ཐ་དད་པ་དམིགས་ལ་རང་གི་རིགས་ཀྱི་སྔ་ཕྱི་ལ་ལྟོས་ནས་ཐ་དད་པ་མ་ཡིན་པར་དམིགས་སོ།",
    "སྐྱེ་མཆེད་དྲུག་འགག་པ་ནི་རྟག་པ་དང་ཞི་བའི་མཚན་ཉིད་ཡིན་ཏེ་དེ་བས་ན་སྤྲོས་པ་བཞི་པོ་འདི་དག་གིས་དཔྱད་ཅིང་བརྟག་ཏུ་མི་རུང་ངོ།",
    "དེ་ལ་དོན་དང་ལྡན་པ་མ་ཡིན་པ་སེམས་ཤིང་རྟོག་ལ་སྨྲ་བ་གང་ཡིན་པ་དེ་ནི་སྤྲོས་པ་ཞེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ལ་སྔོན་གྱི་མཐའ་ལས་བརྩམས་ཏེ་སྔོན་བྱས་པའི་རྒྱུ་ལས་བྱུང་བའི་ཕྱིར་གཅིག་ཏུ་ངེས་པར་རང་གིས་བྱ་བ་དང་།",
    "ཡང་ན་ཚེ་འདི་ཉིད་ལ་རང་དགའ་ནས་རང་གིས་བརྩལ་བས་བསྐྱེད་པའི་གང་ཡིན་པ་དེ་ནི་རང་གིས་བྱས་པ་ཁོ་ནར་འདོགས་སོ།",
    "དེས་ཀྱང་འདོད་དེ་ཚོར་བ་བཞིན་དུ་གཞན་གྱིས་བྱས་པ་གང་ཡིན་པ་དེ་ནི་རང་གིས་ཀྱང་བྱས་ལ།",
    "ཚེ་འདི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་བས་ན་འདིར་རེག་པ་འབའ་ཞིག་བདེ་བ་དང་སྡུག་བསྔལ་གྱི་རྒྱུར་ཀུན་དུ་འགྲོ་བར་རིག་པར་བྱའོ།",
    "ཡང་དག་པར་བརྩོན་འགྲུས་བརྩམས་པའི་འབྲས་བུ་འཇིག་རྟེན་པའི་རེག་པ་ཁྱད་པར་རྟོགས་ནས་རོ་མྱང་བ་མེད་པ་དང་ལྡན་པའི་བག་ཡོད་པ་འདི་ནི་རྣམ་པ་གསུམ་པའོ།",
    "དེ་ལྟར་ཡང་དག་པའི་བརྩོན་འགྲུས་བརྩོན་པ་ལ་བརྟེན་ནས་མཐར་གྱིས་དགྲ་བཅོམ་པ་ཟག་པ་ཟད་པས་སྟོན་པའམ་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་མཁས་པའི་དྲུང་དུ་བདག་ཉིད་ཀྱིས་རྣམ་པར་གྲོལ་བ་བརྗོད་པར་འདོད་པས་ནི་གནས་དྲུག་ལ་མོས་པས་འདི་ལྟ་སྟེ།",
    "གནས་དྲུག་ལ་མོས་པ་གང་ཞེ་ན།",
    "གནོད་པ་མེད་པ་ལ་མོས་པ་དང་།",
    "དབེན་པ་ལ་མོས་པ་དང་།",
    "བརྗེད་ངས་པ་མེད་པའི་སེམས་ལ་མོས་པའོ།",
    "གཉིས་པ་ལ་མོས་པ་གཉིས་ནི་བསླབ་པ་དང་པོ་ལ་བརྟེན་པར་རིག་པར་བྱའོ།",
    "གནས་གསུམ་པ་ལ་མོས་པ་ནི་བསླབ་པ་གཉིས་པ་ལ་བརྟེན་པའོ།",
    "གཞན་ཕྱི་མ་གནས་གསུམ་པ་ལ་མོས་པ་རྣམས་ནི་བསླབ་པ་གསུམ་པ་ལ་བརྟེན་པར་རིག་པར་བྱའོ།",
    "དེ་ལ་ཤེས་པ་གང་གིས་ཉོན་མོངས་པ་རྣམས་སྤོང་བར་བྱེད་པ་དང་།",
    "ཉོན་མོངས་པ་སྤོང་པ་གང་ཡིན་པ་དེ་ནི་བརྗེད་ངས་པ་མེད་པའི་སེམས་སོ།",
    "ཚེ་འདི་ལ་ཡུལ་གྱི་ཉོན་མོངས་པ་སྤངས་པའི་ཕྱིར་ནི་ཉེ་བར་ལེན་པ་ཟད་པའོ།",
    "གཉིས་པ་སྟེ་གནོད་པ་མེད་པ་ལ་མོས་པ་ཡང་དེ་དང་འདྲའོ།",
    "གསུམ་པ་སྟེ་དབེན་པ་ལ་མོས་པ་ཡང་དེ་དང་འདྲའོ།",
    "སློབ་པའི་གནས་དྲུག་ལ་མོས་པ་ནི་ཕྱི་མ་ལ་འབྲལ་བར་འགྱུར་བ་དང་།",
    "གཞན་དུ་འགྱུར་བའི་སྐལ་པ་མེད་མོད་ཀྱི་འཕགས་པའི་གནས་སུ་སྐྱེས་པ་དེའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཤེས་རབ་རྣམ་པར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གྲོལ་བ་ཟིལ་དུ་བརླགས་ནས་ཉོན་མོངས་བསྐྱེད་པར་བྱེད་དོ།",
    "ཉེ་བར་ལེན་པ་ཟད་པ་ལ་མོས་པ་ཡང་ཡོངས་སུ་རྫོགས་ལ།",
    "དེའི་ཤེས་པ་ཡང་རྟག་ཏུ་གནས་པར་བྱ་བ་དྲུག་གིས་ཡོངས་སུ་ཟིན་པའི་ཕྱིར་བརྒྱ་ལ་ལན་འགའ་ཡང་སློབ་པ་བཞིན་དུ་བརྗེད་ངས་པ་ཙམ་ཡང་མེད་དེ་དེ་བས་ན་དགྲ་བཅོམ་པ་ནི་གནས་དྲུག་ལ་མོས་པ་དོན་དམ་པ་ཡོངས་སུ་རྫོགས་པ་ཤིན་ཏུ་རྣམ་པར་དག་པ་དང་ལྡན་གྱི་གཞན་ནི་མ་ཡིན་ནོ།",
    "དེ་ལ་ཏིང་ངེ་འཛིན་གྱི་སྤྱོད་ཡུལ་གྱི་དམིགས་པ་ལ་མི་གཡེང་བའི་ཚུལ་གྱིས་ནི་ནང་གི་སེམས་གནས་པ་ཞེས་བྱའོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་དང་བྲལ་བའི་ཕྱིར་ནི་ཤིན་ཏུ་རྣམ་པར་དག་པའོ།",
    "ཀུན་ནས་དཀྲིས་པ་སྐྱེས་ཟིན་པ་ཡང་ཟིལ་གྱིས་མནན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ལྟར་དེའི་བསྒོམས་པའི་སྟོབས་ལ་མ་བརྟེན་པས་ཉོན་མོངས་པའི་ཕྱོགས་ཀྱི་གནས་ངན་ལེན་ཡང་དག་པར་མ་བཅོམ་པ་དང་།",
    "གསུམ་པོ་འདི་དག་ནི་འཁྲིག་པའི་འདོད་ཆགས་ཀྱི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འཇུག་པར་བྱ་བ་མ་ཡིན་པའི་འདུ་ཤེས་ཀྱང་ཡིད་ལ་བྱེད་པ་དེ་ནི་སེམས་རྒོད་བཞིན་དུ་ཡང་ཉོན་མོངས་པས་ཟིལ་གྱིས་མི་ནོན་ཏོ།",
    "མི་སྡུག་པའི་འདུ་ཤེས་ཀྱང་ཡིད་ལ་བྱེད་པས་ན་སེམས་མྱུར་དུ་འགྱུར་བཞིན་དུ་ཡང་ཉོན་མོངས་པས་ཟིལ་གྱིས་མི་ནོན་ཏོ།",
    "རེག་པའི་སྐྱེ་མཆེད་དྲུག་པོ་རྣམས་ནི་སྔོན་གྱི་ལས་དང་ཉོན་མོངས་པ་རྣམས་དང་རང་གི་ས་བོན་གྱི་རྒྱུད་ལ་འཕངས་པའི་ཚོར་བ་སྐྱེ་བའི་རྐྱེན་ཙམ་དུ་འགྱུར་ཏེ་དཔེར་ན་ལག་གིས་ལེན་པ་ནི་སེམས་ཀྱི་ཀུན་ནས་བསླང་བའི་འབད་པས་འཕངས་པའི་ལས་ལེན་པའི་རྐྱེན་ཙམ་གྱི་བྱ་བ་བྱེད་པ་དེ་བཞིན་དུ་འདིར་ཡང་རིག་པར་བྱའོ།",
    "དེ་ལ་ནི་དགེ་སློང་གིས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སེམས་གནས་པ་རྣམ་པ་དགུས་ཡུལ་ཐམས་ཅད་དང་མཚུངས་པར་ལྡན་པའི་རྟོག་པ་ལས་སེམས་བསྡུས་ནས་གང་ལ་བརྟེན་ན་ཡུལ་དེ་དག་གིས་བཟའ་བར་འགྱུར་བའི་རྟོག་པ་གཅིག་ཀྱང་སྐྱེ་བའི་སྐབས་མི་འབྱེད་དོ།",
    "དེས་ན་ཡུལ་དེ་དག་གིས་གནས་མི་ཐོད་པས་ཕྱིར་ལྡོག་པར་འགྱུར་རོ།",
    "དགེ་སློང་སྔོན་གྱི་ཡང་སྲིད་པར་སྐྱེ་བར་འགྱུར་བའི་སྡུག་བསྔལ་གྱི་རྒྱུའི་འབྲས་བུ་ཚེ་འདིའི་རེག་པའི་སྐྱེ་མཆེད་དྲུག་ལ་གནས་པ་ནི་ཡུལ་དྲུག་གིས་བཅོམ་པ་བཞིན་དུ་གལ་ཏེ་ཡང་སྲིད་པར་སྐྱེ་བར་བྱ་བ་ཁོ་ནའི་ཕྱིར་སྨོན་ནས་ཚངས་པར་སྤྱོད་པར་བྱེད་ན།",
    "དེ་དག་གི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སེམས་བསྐྱེད་མ་ཐག་ཏུ་བཅིངས་པ་དེ་ནི་དུས་ཆ་ཕྲ་བའི་སྒོ་ནས་ཆ་ཕྲ་བ་ཡིན་གྱི་རྟོགས་པར་དཀའ་བའི་ཆ་ཕྲ་བའི་སྒོ་ནས་ནི་མ་ཡིན་ཏེ་གང་གི་ཕྱིར་བཅིངས་པར་གྱུར་ན་བདག་ཉིད་བཅིངས་པར་ཁོང་དུ་ཆུད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་འདི་ན་ཁ་ཅིག་ཆགས་པར་འགྱུར་བའི་ཡུལ་རྣམས་ལ་སེམས་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་དུ་གྱུར་ན་དང་དུ་མི་ལེན་པ་དང་།",
    "ཇི་ལྟར་འདི་ནི་དགེ་སློང་ཞིང་པ་ལྟ་བུ་ཁ་ཅིག་གིས་སྐྱེས་བུ་དམ་པ་ལ་བརྟེན་པ་དང་།",
    "དེས་སྙོམས་པར་འཇུག་པ་ལས་བྱུང་ཚོར་བ་རགས་པ་དང་པོ་ཐོབ་པ་དེ་བག་མེད་པའི་གཞི་དང་།",
    "འདོད་ཆགས་དང་བྲལ་ནས་སྙོམས་པར་འཇུག་པ་ལ་བརྟེན་པའི་བྱེ་བྲག་གིས་ནི་ཐ་དད་པ་རྣམ་པ་བཅུར་མཐོང་ལ།",
    "དུས་ཀྱི་བྱེ་བྲག་གིས་ནི་རྣམ་པ་བརྒྱད་མཐོང་ངོ།",
    "ངེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྣམ་པ་འདི་དག་གིས་ཚོར་བ་སྐྱེ་བ་དང་གནས་པ་དང་འགག་པའི་ཚུལ་གྱིས་དུས་ལས་གྱུར་བའི་བྱེ་བྲག་རྣམ་པ་བརྒྱ་ཕྲག་དུ་མ་མཐོང་ངོ།",
    "འདུ་ཤེས་དང་ཚོར་བ་འགོག་པའི་བར་གང་ཡིན་པ་དེ་ནི་འདུ་ཤེས་དང་ཚོར་བ་རྣམས་ཀྱི་ཀུན་དུ་སྤྱོད་པའོ།",
    "སྲིད་པའི་རྩེ་མོ་མན་ཆད་ཀྱི་སེམས་པ་དང་།",
    "བདག་གིར་འཛིན་པ་མངོན་དུ་འགྲོ་བ་མཐོང་བས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ནས་སློབ་པའི་སྡོམ་པ་ཐོབ་པར་འགྱུར་རོ།",
    "དེས་སློབ་པའི་སྡོམ་པ་དེ་ཉིད་བསྒོམས་པས་ངའོ་སྙམ་པའི་ང་རྒྱལ་སྔོན་དུ་འགྲོ་བའི་བསྒོམས་པས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པ་རྣམས་སྤངས་ནས་མི་སློབ་པའི་སྡོམ་པ་ཐོབ་པར་འགྱུར་ཏེ།",
    "དགེ་སྦྱོང་གི་ཚུལ་འདོད་པ་མ་ཡིན་པར་རིག་ནས་ལྷན་ཅིག་འགྲོགས་པ་ལས་ཡོངས་སུ་སྤོང་བར་བྱེད་དོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་ཅན་དུ་གནས་པའོ།",
    "གནས་ཤིང་འདུག་པ་ལོག་པའི་འདུ་ཤེས་སྔོན་དུ་འགྲོ་བ་དེ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཉེས་དམིགས་མཐོང་དུ་ཟིན་ཀྱང་ལན་མང་དུ་མ་བྱས་པའི་རྒྱུས་རྒྱུད་ལ་གནས་པའི་ཉོན་མོངས་པའི་ཕྱོགས་སུ་གཏོགས་པའི་གནས་ངན་ལེན་འདི་ལྟ་སྟེ།",
    "ངན་སོང་གི་འདུ་བྱེད་རྒྱུན་ཆགས་པར་བྱེད་པ་པ་དང་།",
    "ངན་སོང་གི་སྡུག་བསྔལ་དང་།",
    "དེ་དེའི་ཚེ་ཡུལ་ལ་བརྟེན་ནས་བརྗེད་ངས་པ་ལས་བྱུང་བའི་ཉོན་མོངས་པའི་ཀུན་ནས་དཀྲིས་པས་ཕོངས་པར་གྱུར་བར་ཤེས་རབ་ཀྱིས་རྟོགས་ལ་ལྷག་མ་ཉོན་མོངས་པའི་བག་ལ་ཉལ་དང་སྲེད་པའི་བག་ལ་ཉལ་ལས་བདག་ཉིད་ཉོན་མོངས་པ་དང་བཅས་པ་དང་།",
    "ཕོངས་པ་དང་བཅས་པ་ཡིན་པར་ཁོང་དུ་ཆུད་ལ་ཕུང་པོའི་ལྷག་མ་དང་བཅས་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་ནི་ཉོན་མོངས་པ་དང་སྲིད་པ་མ་ལུས་པ་ལས་འདས་པ་དང་གཅིག་ཏུ་ངེས་པར་ཞི་བ་ཡིན་ནོ་སྙམ་དུ་ཁོང་དུ་ཆུད་དོ།",
    "གཏི་མུག་པར་འགྱུར་བའི་ཡུལ་ལ་ཉོན་མོངས་པའི་ཀུན་ནས་དཀྲིས་པ་དྲག་པོ་སྐྱེད་པར་བྱེད་པ་དང་།",
    "སེམས་ཀྱི་རྒྱུད་དེ་ལ་རྗེས་སུ་འབྲེལ་བ་དང་དམའ་བ་ལ་མོས་པ་ཡིན་ཏེ།",
    "དེ་ཡང་དམའ་བ་ལ་མོས་པས་སེམས་ཡུལ་ལ་གཞོལ་བར་འགྱུར་རོ།",
    "དེའི་འབྲས་བུ་ཉོན་མོངས་པ་སྤོང་བ་ལ་མོས་པས་མྱ་ངན་ལས་འདས་པ་ལ་གཞོལ་བར་མི་བྱེད་དོ།",
    "དགེ་སློང་གིས་དེ་དག་ལ་བརྟེན་ན་ལོག་པར་བསྒྲུབ་པ་རྣམ་པ་བཞིར་འགྱུར་བར་རིག་པར་བྱ་སྟེ།",
    "གཞན་ཡང་འདི་ན་ཁ་ཅིག་ཚེ་འདི་ལ་རྙེད་པ་དང་བཀུར་སྟིས་དགའ་ཞིང་རྙེད་པ་དང་བཀུར་སྟི་ལ་ལྷག་པར་ཞེན་པ་འདི་ནི་ཀུན་དུ་ཆགས་པའི་གནས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དགེ་སློང་དོན་ལ་མི་མཁས་པ་ནི་དོན་གཅིག་ལ་ཚིག་གི་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པའི་གཏམ་གཞན་དག་ལས་ཐོས་ན་འདི་ལ་གང་བདེན་ཞིག་གུ་སྙམ་དུ་ཡིད་གཉིས་ཟ་ཞིང་མ་རངས་པར་འགྱུར་ར།",
    "བཞི་པོ་འདི་དག་ནི་ཡེ་ཤེས་གཟིགས་པ་རྣམ་པར་དག་པས་བརྟག་པའི་སྒོ་ཡིན་ཏེ།",
    "གཞི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གཉེན་པོ་མེད་པ་ཉོན་མོངས་པ་བྱུང་བ་དང་དུ་ལེན་པའི་ངང་ཚུལ་ཅན་ལ་ནི་བདུད་ཀྱིས་འདི་ནི་དང་དུ་ལེན་པའི་ངང་ཚུལ་ཅན་ཡིན་ནོ་སྙམ་དུ་རིག་ནས་ཡུལ་རྙེད་པའི་ཚུལ་གྱིས་འོང་བར་འགྱུར་ཏེ།",
    "དེས་དེ་ལྟར་ཉོན་མོངས་པ་དང་དུ་ལེན་པའི་ངང་ཚུལ་ཅན་གྱི་གང་ཟག་ལ་འཇུག་པའི་གླགས་དང་དེའི་རྒྱུད་ལ་གནས་པར་འགྱུར་བའི་དམིགས་པ་རྙེད་པར་འགྱུར་རོ།",
    "བདག་ཉིད་ཀྱིས་བདེན་པ་སྤྱོད་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེས་སྲིད་པའི་ཆུ་ཀླུང་རྟོག་པ་ངན་པའི་མི་སྡུག་པའི་ཆུས་འདུས་ཏེ་རེག་པ་དང་ལྡན་པ་དེ་མཐོང་སྟེ།",
    "གཏི་མུག་གི་མེའི་མེ་མ་མུར་གྱི་འགྲམ་གཉིས་དང་ལྡན་ལ་ཞུགས་སུ་ནི་འདོད་པའི་ཁམས་ཀྱི་སྡུག་བསྔལ་མང་པོ་དང་།",
    "དེ་ཡང་ཁྱིམ་ནས་མ་བྱུང་བཞིན་དུ་གཅིག་པུ་ལྐོག་དབེན་པར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སོང་སྟེ་ཤིང་འཛམ་བུའི་གྲིབ་མ་ལ་འདུག་ནས་བསམ་གཏན་དང་པོ་ལ་སྙོམས་པར་འཇུག་སྟེ།",
    "དེ་མོས་པར་མ་གྱུར་ནས་འཇིག་རྟེན་པའི་ལམ་དེ་བོར་ཏེ།",
    "བསམས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ལ་བརྟེན་ཅིང་དེའི་རྗེས་སུ་སོང་ན་སྟན་གཅིག་ལ་འདུག་བཞིན་པས་ཟག་པ་ཟད་པ་མན་ཆད་འཐོབ་པར་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་པའི་ལམ་གྱིས་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་མན་ཆད་དང་ལྡན་པའི་ཉོན་མོངས་པ་དང་བྲལ་བ་དང་།",
    "མཐོང་བས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པ་དང་བྲལ་བས་ན་ཡོངས་སུ་གདུང་བ་མེད་པའོ།",
    "སྲིད་པའི་རྩེ་མོ་དང་ལྡན་པའི་ཉོན་མོངས་པ་མ་ལུས་པར་སྤངས་པའི་ཕྱིར་ཡང་གཅིག་ཏུ་ངེས་པར་ཟག་པ་མེད་པའི་ལམ་འདི་ལྟ་སྟེ།",
    "ཉོན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "མོངས་པའི་བག་ཆགས་དང་བཅས་པ་མ་ལུས་པ་དང་བྲལ་བ་འཐོབ་པ་དང་།",
    "ཚིག་གི་ཚོགས་དང་།",
    "ཉོན་མོངས་པ་སྤངས་པའི་སྒོ་ནས་ནི་རེག་ན་བདེ་བའི་མལ་སྟན་ཕུན་སུམ་ཚོགས་པ་བརྙེས་སོ།",
    "སྨྲ་བ་དེ་དག་གིས་འཇིག་ཚོགས་ལ་ལྟ་བ་མ་སྤངས་པ་རྣམས་བདག་ཡོངས་སུ་ཚོལ་བའི་རྟོག་པ་ཀུན་དུ་སྤྱོད་དེ།",
    "བདག་གི་བདག་གིས་རང་བཞིན་གང་ཡིན་ཞེས་བྱ་བ་དང་།",
    "ཅི་བདག་གི་བདག་རྟག་གམ་མི་རྟག་གམ་ཞེས་བྱ་བ་དང་།",
    "བདག་གི་བདག་གང་ན་གནས་ཞེས་བྱ་བའོ།",
    "རྣམ་པ་གཅིག་གིས་ནི་གདགས་སུ་ཡེ་མི་རུང་ངོ།",
    "དེ་ལ་བདག་གི་རང་བཞིན་གདགས་པ་ནི་སྐྱེ་མཆེད་བཅུ་གཉིས་ལས་བྱུང་བའི་རྣམ་པར་ཤེས་པ་རྣམ་པ་དྲུག་ཚོར་བ་དང་།",
    "སྐད་ཅིག་པ་ཡིན་པས་ན་རེ་ཞིག་པའོ།",
    "དེ་ལྟར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ན་རྣམ་པ་གསུམ་པོ་འདི་དག་གིས་ནི་བདག་གིས་རང་བཞིན་དང་།",
    "འདུ་བྱེད་རྣམས་ལ་བདག་གིས་གནས་གདགས་སུ་ནི་མི་རུང་སྟེ།",
    "དེས་ན་བདག་གི་དོན་གཞན་དུ་གྱུར་པ་མེད་པའི་ཕྱིར་རོ།",
    "འདོད་ཆགས་ཆུང་ངུ་དང་འབྲིང་ངམ་ཉོན་མོངས་པའི་ཤས་ཆུང་བ་ལྟ་ཅི་སྨོས།",
    "རྟོག་པ་རྣམས་ལ་བདག་གམ་བདག་གིར་རྟོག་པ་མེད་དོ།",
    "དེ་ནི་འདི་ལྟར་བདག་གིས་ཚོར་རོ་སྙམ་དུ་འཛིན་པར་ཟད་དེ་རྒྱས་པར་སྦྱར་རོ།",
    "དེ་བས་ན་དེའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བསྙེལ་བ་བརྗོད་པའི་སྒོ་ནས་ལང་ཚོའི་རྒྱ་གས་པས་མྱོས་ཤིང་བག་མེད་པར་གནས་པ་རྣམས་སྐྱོ་བ་བསྐྱེད་པ་དང་།",
    "བསྟན་པའི་གཏམ་མོ།",
    "སྐྱེ་མཆེད་ཀྱི་བྱེ་བྲག་གིས་འདུ་བྱེད་རྣམས་ལ་བདག་མེད་པར་ཤེས་པའི་ལྟ་བ་རྣམ་པར་དག་པ་དང་།",
    "རེག་པ་དང་།",
    "སྲེད་པའི་ཚོགས་ཀྱི་བྱེ་བྲག་གིས་བདག་མེད་པར་ཡང་དག་པར་མཐོང་བས་ནི་རྟེན་ཅིང་འབྲེལ་པར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཚེ་འདི་ལ་ཤེས་རབ་ཀྱི་མཚོན་གྱིས་ཉོན་མོངས་པ་ཐམས་ཅད་སྤོང་བར་ཡང་དག་པ་མཐོང་བས་ནི་ཚེ་ཕྱི་མའི་སྡུག་བསྔལ་མ་ལུས་པ་ལས་ཡང་དག་པར་འདའ་བར་བྱ་བའི་ལྟ་བ་རྣམ་པར་དག་པ་སྐྱེད་པར་བྱེད་དོ།",
    "ཚེ་འདི་ལ་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་དང་།",
    "ཤིན་ཏུ་སྦྱངས་པ་མེད་ན་ནི་གང་གིས་ཡང་དག་པ་ཇི་ལྟ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བ་བཞིན་དུ་ཤེས་པར་འགྱུར་བའི་ཏིང་ངེ་འཛིན་ལ་ཡང་རེག་པར་མི་འགྱུར་རོ།",
    "ཡང་དག་པའི་སྦྱོར་བའི་ལམ་གྱིས་ཉོན་མོངས་པ་བཀག་པ་ནི་ཅི་བདག་འདོད་པ་རྣམས་ལ་འདོད་པའི་འདུན་པ་ཡོད་བཞིན་དུ་མ་ཚོར་རམ།",
    "སྡུག་པའི་མཚན་མ་ཡིད་ལ་བྱེད་པས་ངེས་པར་བྱེད་ཅིང་དཔྱོད་པ་ཡིད་ལ་བྱེད་པ་ལ་བརྟེན་ནས་རྟོགས་པར་འདོད་པ་ལས་ཉོན་མོངས་པ་མ་སྤངས་པའི་ཕྱིར་འདོད་པའི་ཀུན་དུ་རྟོག་པ་ཉོན་མོངས་པའི་གཞི་དང་གནས་སུ་གྱུར་པ་རྣམས་སྐྱེ་བར་འགྱུར་ཏེ།",
    "དེ་དག་གིས་འཕྲོག་པ་ལྟར་ན་འདི་དག་ནི་ཉམས་པར་འགྱུར་བར་བྱེད་པ་ཡིན་ནོ་སྙམ་དུ་རིག་ནས་གཏོད་པར་མི་བྱེད་དོ།",
    "གང་གི་ཕྱིར་བརྟག་པ་བྱས་ན་ངེས་པར་རྟོགས་པར་ཡང་འགྱུར་ལ་སེམས་འཕྲོག་ཅིང་འདུས་པ་ཡང་།",
    "གལ་ཏེ་ལྟ་བ་དྲག་པོས་ཇི་ལྟར་བརྟགས་ཀྱང་འདོད་པ་ཀུན་དུ་རྟོག་པ་རྣམས་མི་སྐྱེ་ན་ནི་དེས་གང་ལ་དམིགས་ན་ཉོན་མོངས་པ་སྐྱེ་བར་འགྱུར་བའི་སྐྱེ་མཆེད་དེ་ཟིལ་གྱིས་ནོན་ཏོ་སྙམ་དུ་ངེས་པར་ཐོབ་པར་འགྱུར་རོ།",
    "དེས་སྐྱེ་མཆེད་དེ་ཟིལ་གྱིས་ནོན་པས་ན་སློབ་པའི་ས་ལས་ཡང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ཡང་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་ཡིན་པའི་ཕྱིར་སྡུག་བསྔལ་ཡིན་ནོ།",
    "ཁྱིམ་དང་བུ་སྨད་ཀྱི་ཚོགས་ཡོངས་སུ་འཛིན་པའི་འདུ་འཛི་ཡོངས་སུ་ཉོན་མོངས་པ་ཅན་དུ་འགྱུར་བས་བདག་ཉིད་འཚོ་བར་བྱེད་པ་གང་ཡིན་པ་སྟེ།",
    "མྱ་ངན་ལས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ལ་དུས་གསུམ་དུ་མཆོག་ཏུ་ཀུན་ཏུ་རྨོངས་པ་མེད་པར་གནས་པའི་དོན་གྱིས་དམིགས་པ་རྣམ་པ་གསུམ་གྱི་བྱེ་བྲག་གིས་ན་རིག་པ་གསུམ་ལ་རིག་པ་ཞེས་བྱའོ།",
    "མ་རིག་པའི་རྩ་བ་ཅན་གྱི་ཀུན་ནས་ཉོན་མོངས་པའི་གཉེན་པོ་ཡིན་པའི་ཕྱིར་རྣམ་པར་གྲོལ་བ་ཞེས་བྱའོ།",
    "བདེན་པ་རྟོགས་པ་དེའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་གི་ཚེ་དེའི་སེམས་དེ་གནས་པ་ཁོ་ནར་འགྱུར་ཏེ།",
    "དེ་ལ་ཡུལ་གྱི་བྱེ་བྲག་གིས་ནི་ཡུལ་གཅིག་ཏུ་ངེས་པར་ཡིད་དུ་འོང་བ་ཡང་ཡོད།",
    "ཁ་ཅིག་ནི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འགྱོད་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བདག་ཉིད་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པའི་ཆ་ཕྲ་བ་དེ་ཡང་ཤེས་རབ་ཀྱིས་མི་རྟོགས་ཏེ།"
  ]
}