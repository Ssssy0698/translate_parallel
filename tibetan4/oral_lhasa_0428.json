    "༢ ༧ ༣ཟིན་པར་འགྱུར་རོ།",
    "ཉི་མ་གཉིས་བསྒྲུབས་ན་བསྟན་བཅོས་ཐམས་ཅད་ལ་མཁས་པར་འགྱུར་རོ།་",
    "ཉི་མ་གསུམ་བསྒྲུབས་ན་སྐྱེ་བ་དྲན་པར་འགྱུར་རོ།",
    "བདུན་གྱིས་གཞན་གྱི་སེམས་ཤེས་པར་འགྱུར་རོ།",
    "འཇམ་པའི་དབྱངས་དང་ཤེས་རབ་མཉམ་པར་འགྱུར་རོ།",
    "བང་ནི་རྟ་དང་མཉམ་པར་འགྱུར།",
    "ལུས་ནི་དཀར་ལ་སྦོམ་པར་འགྱུར་་པ།",
    "པེ་། འཇམ་དཔལ་རྡོ་རྗེ་བློ་གྲོས་འཕེལ་བཞུགས་སྩོ།",
    "སྣར་འཇམ་དཔལ་རྡོ་རྗེ་ཤེས་རབ་བློ་འཕེལ་གྱི་སྒྲུབ་ཐབས་འཕགས་པ་ཀླུ་སྒྲུབ་ཞབས་ཀྱིས་མཛད་པ་བཞུགས།",
    "༣པེ་ཉི་མ་གསུམ་བསྒྲུབས་ན་སྐྱེ་བ་དྲན་པར་འགྱུར་རོ།",
    "གནས་འཁ་། བཅོམ་ལྡན་འདས་འཇམ་པའི་དབྱངས་ཀྱི་ཀྱི་དཔྱད་བཞུགས་སོ།",
    "སྭཱ་ཧཱ་རྟག་ཏུ་ཐ་མར་ངེས་པར་རོ།",
    "མཚོན་ཆ་ཡིན་པར་སྔགས་རིག་པ་ལ་བཤད།",
    "གནས་ནས་དེ་རུ་གཙང་མའི་གནས་བྱས་ཏེ།",
    "ཆ་གསུམ་དག་ཏུ་རྣམ་པར་དབྱེ་བར་བྱ།",
    "ཚིག་སྦྱིན་གྱི་ནི་འབྲུ་དྲུག་གང་གསུངས་པ།",
    "དེ་བརྗོད་ནས་སུ་ཆུ་དེར་འཇུག་པར་བྱ།",
    "དེ་ལྟར་སྔགས་པས་ཚུལ་བཞིན་བྱས་པས་ན།",
    "སྔགས་རྣམས་ཀྱིས་ནི་རྣམ་པར་དགོད་བྱ་བ།",
    "དེ་ལྟར་ལུས་ནི་རུང་བར་བྱས་ནས་༢ ༧ ༧བཅོམ་ལྡན་འདས་འཇམ་པའི་དབྱངས་ཀྱི་དཔྱད་བཞུགས་ལྷོ།",
    "མགོན་པོ་ཡིན་པར་དེ་ལྟར་བྱས་ནས་ནི།",
    "སྔོན་དུ་བསྙེན་པ་ཟླ་གསུམ་བྱས་པ་ཡིས།",
    "ཆོ་ག་བཞིན་དུ་དེ་ལྟར་ལུས་ིབྱས་ནས།",
    "ཕྱོགས་མཚམས་དག་ནི་རྣམ་པ་བསལ་བྱས་ནས།",
    "མཆོད་རྟེན་དག་ལ་སོགས་པའི་ལས་གསུངས་པ།",
    "འབུམ་གྲངས་བཟླས་བྱས་དེ་ཡིས་དེ་ནས་སུ།",
    "སྔོན་དུ་བསྙེན་པ་ཆིག་འབུམ་སྔར་བྱས་པས།",
    "ནང་པར་ཆུ་ལ་བདུན་གསུམ་བཟླས་བཏུངས་ན།",
    "རང་བཟོ་སྣ་ཚོགས་དག་ཀྱང་ལེགས་པར་བྱེད།",
    "འབར་བ་དེ་ནི་མི་ཤེས་མེད་པར་བྱེད།",
    "ས་བོན་དེ་དག་ཉིད་ཀྱིས་གསལ་བར་བྱས་། དཀྱིལ་དུ་ཨོ་དང་རབ་ཏུ་འབར་བའི་མུ།",
    "ནམ་མཁའ་དེ་བཞིན་རྩིབས་ནི་མེད་པར་བཤད།",
    "དེ་ནས་སྔགས་པ་དེས་བཅོམ་ལྡན་འདས་འཇམ་པའི་དབྱངས་ཀྱི་དཔྱད་བཞུགས་སོ།",
    "༢༧༩ནི་རིག་པར་འགྱུར།་",
    "ཐམས་ཅད་ཤེས་པར་འགྱུར་བར་གདོན་མི་ཟ།",
    "མཚོན་ཆས་རྩིབས་རྣམས་རབ་ཏུ་གསལ་བར་བྱས།",
    "ཐུབ་པས་བསྒོམས་ན་ངེས་པར་མ་ལུས་ཤེས།",
    "དེ་བཞིན་དཔྱད་ལ་འབྲས་བུ་ཁྱད་པར་ཅན།",
    "ལུས་ཀྱི་ཡན་ལག་ངོ་མཚར་མཛེས་པར་བྱས།",
    "བྱིས་པའི་རྒྱན་གྱིས་ཤིན་ཏུ་མཛེས་པར་བརྒྱན།",
    "ཐོག་མར་བསྲུང་བ་ཚུལ་བཞིན་བྱས་ནས་སུ།་།",
    "བཟོ་བོ་མཁས་པས་ལེགས་པར་བྲི་བ་ནི།",
    "རས་ཀྱང་ཁྲུ་གང་ཚད་དུ་བྱས་པ་སྟེ།",
    "དཀར་ཤམ་པོ་ལ་ཤ་ཚུགས་ལེགས་བྱས་ནས་། པདྨའི་གདན་ལ་བདེ་བར་བཞུགས་པར་བྱ།",
    "དེ་ཡིས་ཕྱག་གཡས་མཆོག་ནི་སྦྱིན་པར་མཛད།",
    "སྐུ་གཟུགས་དེ་ཡང་རི་ཡི་ཕུག་ན་གནས།",
    "ཆོ་ག་བཞིན་དུ་ལེགས་པར་བྲིས་ནས་སུ།",
    "སྤྱན་དྲངས་པ་དང་གདན་ལ་བཞུགས་པ་དང་།",
    "དེ་ལྟར་བརྟུལ་ཞུགས་སྤྱད་ཅིང་བཅོམ་ལྡན་འདས་འཇམ་པའི་དབྱངས་ཀྱི་དཔྱད་བཞུགས་སོ།",
    "དེ་ནས་སྔོན་དུ་བསྙེན་སོགས་བྱས།",
    "བརྟུལ་ཞུགས་ཆོ་ག་ཇི་སྐད་གསུངས་པའི་རྣམས།",
    "ཀུན་ཏུ་གཞོན་ནུའི་གཟུགས་དང་ལྡན་པར་འགྱུར།",
    "ལྷ་ཡི་ལོ་སྟོང་བར་དུ་ཐུབ་པར་འགྱུར།",
    "ཐོག་མར་བསྲུངས་ནས་བསྒྲུབ་པར་བྱ་བ་ནི།",
    "ལག་པ་གཡས་པས་ལེགས་པར་བཟུང་ནས་སུ།",
    "དངུལ་གྱི་སྣོད་དུ་བཞག་སྟེ་བསྒྲུབ་པར་བྱ།",
    "ཚ་བར་གྱུར་པ་ཉིད་ཀྱིས་རྐང་མགྱོགས་པར།",
    "བར་ཆད་མེད་པར་མི་སྣང་འགྲུབ་པར་འགྱུར།",
    "འབར་བ་བྱུང་ན་དེ་ནས་ཡང་དག་པར།",
    "བལྟས་ནས་དེ་བཞིན་འདིར་ནི་བསྒྲུབ་པར་བྱ།",
    "ཤག་ཏི་ཏྲི་ཤུལ་ལྕགས་ཀྱུ་འཁོར་ལོ་དང་།",
    "སྔགས་རིག་པས་ནི་དེ་བཞིན་བསྒྲུབ་པར་བྱ།",
    "སྔགས་མཁན་གཙང་སྦྲ་ཆེ་བ་རྟག་འབད་པས།",
    "ཆུ་འཐུངས་ན་ནི་བསྙེན་པ་མ་བྱས་ཀྱང་།",
    "གཙུག་ལག་དོན་རྣམས་མ་ལུས་ཤེས་པར་འགྱུར།",
    "འདུས་བྱས་རང་བཞིན་ཟུང་དུ་མ་འདྲེས་པ་། ལན་གཅིག་ཐོས་ནས་འདི་ནི་ཆུད་མི་ཟ།",
    "དཔྱད་འདི་ཚིག་བཅད་བརྒྱ་ཡི་གྲངས་བྱས་པ།",
    "གྲུབ་པ་འཕགས་པའི་ལྷས་ནི་འདི་བྱས་སོ།",
    "༢སྣར་པར།",
    "༨སྣར་པར།",
    "འབའ་འབུ་བསད་པ་བདེ་བ་མ་བཅོམ་ལྡན་འདས་འཇམ་པའི་དབྱངས་ཀྱི་དཔྱད་བཞུགས་སོ།",
    "དེ་ལ་དང་པོར་སྔགས་པས་གདོང་བཀྲུ་བ་ལ་སོགས་པ་བྱ་སྟེ་ཡིད་དང་མཐུན་པའི་བསམ་གཏན་གྱི་གནས་གཙང་ཞིང་།",
    "མེ་ཏོག་དྲི་ཞིམ་པོས་གཅལ་དུ་བཀྲམ་པར།",
    "ཨོཾ་ཨཱ་བིགྷཱནྟ་ཀྲྀཏ་ཧཱུྃ་ཕཊ་ཅེས་བྱ་བའི་སྔགས་ལན་བཅུའི་བར་དུ་བརྗོད་དེ་ཕྱོགས་བཅུ་ན་གནས་པའི་བགེགས་ཐམས་ཅད་བསྐྲད་པར་བྱའོ།",
    "གསུམ་ལ་སྐྱབས་སུ་འགྲོ་བ་བྱས་ལ།",
    "རྨི་ལམ་དང་སྨིག་རྒྱུ་ལྟ་བུར་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་དུ་དམིགས་པར་བྱའོ།",
    "དེ་ནས་བདག་ཉིད་འཇམ་དཔལ་ཡེ་ཤེས་ཀྱི་སྐུའི་བདག་ཉིད་ཅན་ཡི་གེ་དྷཱིཙམ་དུ་གནས་པར་བྱའོ།",
    "རྒྱན་ཀུན་རྣམ་པར་འཛིན་འགྱུར་དང་།་",
    "༢ ༨ ༩རོལ་ཏུ་ཕྱིན་པའི་གླེགས་བམ་ཡང་དག་པར་འཛིན་པའོ།",
    "སྤྱན་དྲངས་པ་མདུན་གྱི་ནམ་མཁའ་ལ་རྣམ་པར་བསམས་ལ།",
    "སྔ་མ་བཞིན་ཡང་དག་པར་མཆོད་དེ།",
    "དགྱེས་པ་བྱས་ལ།",
