    "རང་རང་ཕྱོགས་སུ་ལེགས་པར་བཞུགས་ནས་ཀྱང་།",
    "ལམ་འཇུག་དུས་དང་ནོར་དང་འབྲུ་རྣམས་སྡུད་པ་དང་།",
    "གོས་གསར་པ་གྱོན་ནས་ཁ་བྱང་དུ་བལྟས་ཏེ་འདུག་པ་ལ།",
    "རང་རང་འཁོར་དང་བཅས་པ་དང་།",
    "སྲུང་སྐུད་དམར་པོ་ལ་མདུད་པ་གསུམ་བོར་བའི་དབུས་སུ་བོ་དྷི་ཙི་རྡོག་གཅིག་བརྒྱུས་པ་ལཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦ་ཨརྦ་ས་དྷ་ནི་སྭཱ་ཧཱབཟླས་སྔ་ཏེ་ལག་གཡས་པའི་མཁྲིག་མར་གདགསཛི་ན་ཛིཀྲ།",
    "ཧོ་ཧ་ན་ཧཱུྃཞེས་བཟླས་ཏེ་སྔར་ལྟར་བསང་གཏོར་བྱདེ་ནས་རང་ཉིད་སའི་དབུས་སུ་འདུག་སྟེ།",
    "འགྲོ་དོན་སྣ་ཚོགས་ཅི་འདོད་པ། ། རང་རང་སྐལ་བ་ཅི་བཞིན་དུ།",
    "རང་ཉིད་ཀུ་ཤའི་སྟན་ལ་ཁ་ཤར་དུ་ཕྱོགས་པས་འདུག་ལ།",
    "གཉིས་གདབ་སློབ་དཔོན་འདུག་ཕྱོགས་ཏེ།",
    "ཞེས་ཕྱག་དངོས་སུ་བྱདེ་ནས་སྟན་ལ་འདུག།",
    "འགྲོ་བའི་དོན་དུ་གཟུགས་སྐུ་ཅིར་ཡང་གདའ།",
    "འགྲོ་བའི་དོན་དུ་གཟུགས་སྐུ་ཅིར་ཡང་གདའ།",
    "འགྲོ་བའི་དོན་དུ་གཟུགས་སྐུ་ཅིར་ཡང་གདའ།",
    "བསྡུས་པ་རྒྱམ་འགའ་ཡང་རང་བཟོར་སྦྱར་བར་མཐོང་།",
    "ནང་དུ་འོང་སྟེ་ཕྱག་བྱས་ནས་འདུག་སྟེ་དམ་ཚིག་ལ་འཇུག་པ་ནས།",
    "གོས་ཟུང་སྣ་ལྔ་བཅས་གསལ་བཀོད་སློབ་དཔོན་མདུན་གོས་ཟུང་རང་ཉིད་མཆོད་རྟེན་གྱི་ཉེ་ལོགས་སུ་ཀུ་ཤའི་གདན་ལ་ཤར་དུ་ཕྱོགས་པས་འདུག་ལ་ནས་བསྟོད་པའི་མཐའི་བརའདེགས་རྒྱ་བཅས་ཏེཛི་ན་ཛིཀ་མ་སོགས་ནས།",
    "ང་ལ་ལྷའི་ཡུལ་གྱི་སྣང་བ་ཞིག་མ་གཏོགས་མིའི་ཡུལ་གྱི་སྣང་བ་ཡེ་མི་འཆར་བར་འདུག་སྟེ།",
    "དེ་ནས་རྗེ་འདིའི་ཐུགས་ལ་ངས་རབ་ཏུ་བྱུང་ནས་རང་གཞན་གྱི་དོན་རྒྱ་ཆེན་པོ་བསྒྲུབ་པ་ལ་ཐོས་བསམ་སྒོམ་གསུམ་གལ་ཆེ་བར་འདུག་དེ་ལ་ཡང་ཐོག་མར་ཐོས་པ་ཉིད་གལ་ཆེ་བར་འདུག་སྟེ།",
    "སྐུ་ན་ཕྲ་རུང་བློ་གྲོས་ཀྱི་ལུས་སྟོབས་རྒྱས་པ་ཞིག་ཡིན་འདུག་པས།",
    "མི་རྟག་པའི་བརྡའ་སྟོན་ལྟ་བུཪ་འདུག་སྙམ་པ་ཐུགས་ལ་ཤར་བ་ནི།",
    "ཡུད་ཙམ་ཞིག་ཏུ་གདའ་བ།",
    "ཡུད་ཙམ་ཞིག་དུ་གདའ་བས།",
    "ཁམས་ཆེན་པོ་འདུག་གསུངས།",
    "བྱང་སེམས་སྦྱོར་ལམ་པ་ལྟ་བུས་ཀྱང་རང་ས་ལམ་གྱི་ཚོད་གང་དུ་ཡོད་མི་ཤེས་པ་འདྲ་གསུང་།",
    "ད་ཤི་ན་བཟང་འདུག་བྱ་བ་དང་།",
    "སོགས་ཀྱིས་རྙེད་པ་ཚོ་ཡང་རློན་པ་ཡིན་འདུག་པས།",
    "གཅིག་བུར་ལམ་ག་ཞིག་ན་འབྱོན་གྱིན་འདུག་པ་ལ།",
    "རྟ་གཅིག་ཕུལ་པ་མ་བཞེས་པར་ཅོག་རྩེ་ཆུང་ངུ་ཞིག་འདུག་པ་དེ་བཞེས།",
    "སྐུའི་སྐྱེ་བ་སྔ་མ་ཚོ་ལ་གང་འདྲ་ཞིག་ཡིན་བསམ་ཞིང་དད་པ་བྱེད་ཅིང་ཡོད་ཙ་ན།",
    "གྲོ་མ་སྒྱེ་ཆུང་གསུམ་ཙམ་བཙོས་པ་ལ་ཐུད་བརྫིས་ནས་ཐམས་ཅད་ལ་བྱིན་པའི་འཕྲོ་ན་ད་དུང་ཡང་ལྷག་འདུག་པ་དང་།",
    "ང་ལ་ཚེ་དཔག་མེད་ཀྱི་སྐུ་འདི་ཚོ་ལ་ཚེ་དཔག་མེད་དངོས་ཀྱི་སྣང་བ་འཆར་བར་འདུག་གསུངས།",
    "ལ་ལ་སྦྱིན་བདག་རང་རང་ལ་བཅོལ་ནས་ཕྱིས་ལེན་གསུང་རུང་ལེན་པ་མ་གནང་།",
    "ཡི་གེ་འདིས་ཀྱང་རང་གཞན་ལ་ཕན་ཞིང་།",
    "རྗེ་ཉིད་ཀྱི་འདི་ཙམ་གྱི་མང་བོ་ཞིག་གསུང་འདུག་དེ་ཙམ་གསུང་མི་དགོས་དང་གསུངས་ཟེར།",
    "ཇོ་བོ་རྗེའི་ཕྱག་ཕྱི་ཡུན་རིང་མཛད་ཅེས་གསུངས་པ་དེ་སེམས་ཙམ་བན་ཆུང་ཟེར་བ་ཞིག་བྱུང་བ་དེ་ཡིན་ཟེར་མཁན་བྱུང་འདུག་ཀྱང་།",
    "དམའ་ས་ནས་རྡོ་སྒོ་ཆུང་ཙམ་ཞིག་ཆད་དེ་འོག་ན་འདུག་དེའི་ཤུལ་ན་བྲག་ཁུང་ཞིག་འདུག་པའི་ནང་ཐམས་ཅད་ཤེལ་གྱི་རང་བཞིན་དུ་འདུག་པའང་བདག་ལ་བསྟན་བྱུང་།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "ད་ངས་ཕུང་བོས་མི་ལྕོགས་པར་འདུག་ཅེས་ཞུས་པས།",
    "སྤྱོད་པ་ལ་ཀུ་ཡངས་ཀྱི་ཞད་ཅིག་འདུག།",
    "དེ་ནས་དགུང་ཇ་ལ་ཕྱིཪ་ཕེབས་ཏེ་ཞལ་ནས་བདག་ལ་མི་ཕལ་ཆེ་བ་ཤི་ནས་རང་ཡུལ་དུ་སྐྱེ་བ་འདུག་དང་དེ་ཆགས་ཞེན་གྱི་སྟབས་ཡིན་པ་འདྲ་གསུངས།",
    "སྙིགས་མའི་མི་ཀུན་མཐོང་ཙ་ན།",
    "སྤྲང་བོའི་མདུན་མ་ལེགས་ནས་གདའ།",
    "འཕྲལ་མཐུན་རྐྱེན་ཕྱོགས་ལ་ང་རང་ཤེས།",
    "མཆོད་ཁང་རང་དུ་ཞུགས་ལ་ཕུལ་ནས་སྒོ་ལྕགས་བསྡམས་ཏེ་ལྡེ་མིག་ནང་སོས་བཟུང་ནས་ཕྱིས་གདུང་སྒོ་འབྱེད་པ་ན་ཡང་གསང་སྟེ་ཕྱེ་བས་ངེད་ཚོ་ལ་ཆ་མེད།",
    "སླར་ཡང་རང་གནས་དགོན་རོང་དབེན་པར་ཕེབས།",
    "ད་ཤི་ན་བཟང་འདུག་བྱ་བ་དང་།",
    "ཕྱག་རྩ་བལྟས་པས་ད་རྩ་ཡང་སྡུད་པར་འདུག་ཞུས།",
    "བསྲེལ་གསུམ་ཡང་བྱོན་འདུག་ཟེར།",
    "སྐུའི་རྟགས་གཞན་རྣམས་སྔར་ལུགས་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་དེ་ནས་བདག་རོང་བོར་ཕྱིན།",
    "བཟང་བོའི་འདུག་སྟངས་དང་སྐྱིལ་ཀྲུང་སོགས་སྐུའི་བཞུགས་སྟངས་ཀྱང་མི་རྣམས་ཀྱིས་གང་བཅས་པ་དེ་བཞིན་དུ་བཞུགས་པར་འདུག་ཚུལ་འཆལ་རྣམས་ཀྱིས་མཇལ་བའི་ཚེ་སྐུ་ཡོ་ནས་འགྲོ་ཞིང་།",
    "གདུང་མ་ཉམས་པར་སྔར་ལས་ལྷག་པར་ཆོ་འཕྲུལ་སྟོན་པ་ལྟ་བུར་འདུག་པས།",
    "སྐྱེ་བ་སྔ་མ་རྣམས་སུ་ཡང་དཔོན་སློབ་ཀྱི་འབྲེལ་བ་ཡོད་ངེས་སུ་འདུག་གསུངས།",
    "ཁྱེད་ལ་བསྙེན་རྫོགས་ཀྱི་སྡོམ་པ་ངེས་པར་སྐྱེས་འདུག་གསུངས།",
    "བསྙེན་རྫོགས་ཀྱི་སྡོམ་པ་སྐྱེས་ཀྱང་ད་དུང་ལས་གྲལ་ཅིག་ཏུ་འདུག་བསམ་པས་བསྒྲུབ་སྐྱོར་ཅིག་ཐུགས་རྗེས་འཛིན་དགོས་ཞུས་པས།",
    "འབྲས་སྤུངས་སུ་འདུག་པའི་ཚེ་ན་ཡང་སྲིད་པའི་ཕུན་ཚོགས་མཐའ་དག་ལ་ཞེན་པ་གཏིང་ནས་ལོག་པས་མཆི་མ་བཅས་པས་མི་ཆོད་པ་ལན་མང་དུ་བྱུང་གསུང་།",
    "སླར་ཡང་རང་ཡུལ་དུ་ཕེབས་ནས་སྐར་མ་ཐང་དུ་བཞུགས།",
    "བདེ་མཆོག་དུས་འཁོར།",
    "མེ་ཏོག་ཆེ་ཤོས་རྣམས་ནི་དཀར་ཡོལ་ཙམ་དུ་འདུག་ལ་གཞན་ནི་ཚད་ལ་ངེས་པ་མེད་དོ།",
    "ཁྱད་པར་རྟ་མགྲིན་གྱི་གྲུབ་པ་བརྙེས་པ་ཞིག་ཡིན་པར་འདུག་གོ།",
    "བསྟན་ལ་དད་ཀྱང་གཞན་དུ་འགྲོ་བར་འདུག།",
    "བློ་གདེང་ཞིག་ཨེ་འདུག་མནོ་བསམ་ཐོངས།",
    "དལ་འབྱོར་འདི་དོན་མེད་བྱེད་ཉེན་གདའ།",
    "འདི་རུ་བསྡད་ན་རིང་བོར་མི་ཐོགས་པར་ཡུལ་ཐག་རིང་ཞིག་ཏུ་འགྲོ་ཉེན་འདུག་བྱ་བ་གསལ་པར་ཐོས།",
    "དོན་གཞན་པའི་ཐར་བ་ཅང་མི་འདུག།",
    "རྗེས་ཐོབ་ཏུ་ལྷག་མ་ཅི་འདུག་བལྟས་པ་ན།",
    "འདི་ཡང་རང་ཉིད་བསླུས་པ་མ་ལགས་སམ།",
    "ཡང་རང་བཞིན་དག་པའི་དབྱིངས་ཤིག་ནས།",
    "ཡང་རང་བཞིན་སྟོང་ཕྱིར་ལྟོས་གྲུབ་ཙམ།",
    "ལམ་སྲུང་འཁོར་སྒོམ་རྒྱུ་ཅང་མི་འདུག།",
    "བདུད་མདའ་ལྔ་བ་ཡང་གྲོགས་སུ་གདའ།",
    "དོན་དེ་ལྟར་ཡིན་འདུག་བསྟན་འཛིན་པ།",
    "དྲིན་འཁོར་ཐབས་མི་འདུག་དཔེན་ས་པ།",
    "དུས་ད་དུང་དགྲ་ངོས་མ་ཟིན་འདུག།",
    "ཚུར་ཡོད་ཡོད་ལྟ་བུར་བཟུང་འདུག་པ།",
    "ཁོ་རང་ཚུགས་ཐུབ་པ་དངོས་སུ་འགལ།",
    "ཡུམ་བྱང་སེམས་དགོས་དགོས་ལ་སོགས་པའི་གཞི་རུ་འདུག་མཁན་རྣམས་ཀྱི་ཐག་རིང་བོའི་བར་དུ་སྐྱེལ་མ་ཞུས།",
    "ཁང་བ་འདི་ཤིན་ཏུ་སྐྱིད་པོ་རང་འདུག་གསུངས་ནས་ཐུགས་མཉེས་མཉེས་མཛད།",
    "རིམ་གྲོ་བྱས་པས་ཁྱེད་རང་རྣམས་ལ་ཕན།",
    "དབེན་པར་འདུག་པའི་འབའ་ཞིག་པ་ཡོད་དེ།",
    "ཡང་ཡང་དང་ནི་འདུག་གནས་གཅིག།",
    "འདུག་གནས་གཅིག་པའི་འབའ་ཞིག་པ་ཡོད་དེ།",
    "སྲོག་ཆགས་བཅས་དང་ཉལ་བར་འདུག།",
    "ཉལ་བར་འདུག་པའི་འབའ་ཞིག་པ་ཡོད་དེ།",
    "འདུག་པར་བྱ་བ་དགུ་དག་དང་།",
    "མ་བསྐོས་པར་གཞན་གྱི་སྟན་ལ་འདུག་པ་དང་།",
    "བརྟགས་པར་འདུག་པ་དང་།",
    "མདུན་དུ་འདུག་སྟེ་བཤག་པར་བྱ།",
    "སྤྱད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་དུ་འདོད་བསྐྱེད་ན།",
    "གཙུག་ཏོར་ཐོད་བཅིངས་དང་བཅས་ཏེ་མི་འདུག་པ་དང་།",
    "ས་དགེའི་དམ་པ་རྣམས་ཀྱི་ཕྱག་ལེན་ལ་འདུག་པ་ལྟར་རྡོ་རྗེ་སློབ་དཔོན་ཡིན་ན་སློབ་དཔོན་ཞེས་དང་།",
    "མཆོད་རྟེན་ལ་འཇའ་ཟུག་པ་སོགས་ཡ་མཚན་པའི་ལྟས་མང་དུ་བྱུང་འདུག་ལོ་དང་པོར་ལྷ་ལུང་དཔལ་གྱི་རྡོ་རྗེ་བཞུགས་གནས་ཡིན་ཞིང་།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྟོང་བར་བསྟན་པ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པོ་ཞེས་སྨྲ་ན།",
    "འགྲོ་བ་པོ་མིན་འགྲོ་བ་མིན།",
    "བའི་ལམ་གང་ལ་ཡང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ལམ་གསུམ་གང་ལ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་པའི་ཕྱིརལྔ་བ་གནས་པའི་སྒྲུབ་བྱེད་དགག་པ་ལ།",
    "དེ་གཉིས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པར་འགྱུར་ནའང་ཡོད་པ་ནི་མིན་ཏེ།",
    "བལྟ་བྱ་དང་ལྟ་བ་གཉིས་ཀྱང་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར་ན།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་ཡོད་པ་དགགརིགས་པ་དེ་གཞན་ལ་སྦྱར་བ།",
    "ཕུང་བོ་ལྔ་བོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་བར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "ནམ་མཁའི་ཁམས་དང་རང་བཞིན་གྱིས་གྲུབ་པ་དགགརིགས་པ་དེ་ཁམས་ལྷག་མ་ལ་ཡང་སྦྱོར་བའོ།",
    "གཉིས་ལྷན་ཅིག་དེ་ཡང་རང་བཞིན་གཅིག་ལ་མ་གྲུབ་པའི་ཕྱིར།",
    "སྐྱེ་བའང་རང་དང་གཞན་གྱི་དངོས།",
    "དེ་འདུག་པ་ན་མུན་པ་མེད།",
    "མར་མེ་འདུག་པའི་དུས་དེ་ན་མུན་པ་མེད་པའི་ཕྱིར།",
    "འཇིག་རྟེན་ཀུན་ན་གནས་པའི་མུན་པ་ཡུལ་འདི་ན་འདུག་པའི་མར་མེ་དེས་སེལ་ནུས་པར་འགྱུར་ཏེ།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "སྐྱེས་ཟིན་པ་དང་མ་སྐྱེས་པ་དང་སྐྱེ་བཞིན་པ་གསུམ་ཇི་ལྟ་བུར་ཡང་རང་བཞིན་གྱིས་མི་སྐྱེད་པ་དེ་ནི།",
    "ཕྱིས་གང་དུ་ཡང་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར།",
    "དུས་སྔ་ཕྱི་ལ་ལྟོས་པ་དགག་དུས་མཉམ་པ་ལ་ལྟོས་པ་དག་པའོ།",
    "མེ་གྲུབ་མ་གྲུབ་གང་ཡང་རང་བཞིན་གྱིས་ལྟོས་པར་མི་རིགས་པའི་ཕྱིར།",
    "ཤིང་གྲུབ་མ་གྲུབ་གང་ཡང་རང་བཞིན་གྱིས་ལྟོས་པར་མི་འཐད་པའི་ཕྱིར།",
    "ཤིང་ཉིད་མེ་དང་རང་བཞིན་གཅིག་ནི་མ་ཡིན་ཏེ།",
    "ཤིང་དེར་མེ་དེ་བརྟེན་པ་ཡང་རང་བཞིན་གྱིས་མེད་དེ།",
    "སྔ་ཕྱི་བ་དགག་དུས་མཉམ་པ་དགག་པའོ།",
    "དེ་གཉིས་བརྟེན་པ་དང་ལྟོས་པ་ཡིན་ཡང་རང་བཞིན་གྱིས་གཞན་ཡིན་ན་སྐྱོན་ཅི་ཡོད་ཅེ་ན།",
    "དེ་ནས་འཇམ་པའི་སྟན་ལ་ཡང་དག་པར་ཉེ་བར་འདུག་ནས།་",
    "ཨོཾ་བཛྲ་ཨ་ཙ་ན་ཤྲ་ཧེ་ཧཱུྃ་ཕཊ།",
    "དེ་ནས་སློབ་དཔོན་ཞལ་བསིལ་གྱི་བུམ་པས་ཁ་བཤལ་ནས་གདོང་བཀྲུས་ཏེ་ཉེ་བར་འདུག་ལ།",
    "སྔ་མ་བཞིན་དུ་རང་ངམ་གཞན་གྱི་གཏོར་མའི་ལས་ལག་པ་གཉིས་ཀྱིས་བྱས་ནས་མི་སྨྲ་བར་འདུག་པར་བྱའོ།",
    "རྡོ་རྗེ་རྒྱལ་པོ་དབུས་སུ་འདུག།",
    "མཚན་ལྡན་གཟུངས་མ་ཁྲུས་བྱས་འདུག།",
    "ཁྱེད་རང་རྣམས་ཕྱག་རྒྱ་ཆེན་པོ་ཟིལ་གྱིས་གནོན་པའི་འཇམ་དཔལ་ཧེ་རུ་ཀ་སོགས་ནས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པ་ནས་ཞུགས།",
    "ཨོཾ་དེ་འོད་དུ་ཞུ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཞུགས་པས།",
    "སྟོང་པའི་ངང་ལས་རྒྱུ་དང་རྐྱེན་མེད་པར་ཁྱེད་རང་རྣམས་ཕྱག་རྒྱ་ཆེན་པོ་ཟིལ་གྱིས་གནོན་པའི་འཇམ་དཔལ་ཧེ་རུ་ཀ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ཀྱི་སྤྱི།",
    "ཨེ་ཐུང་རང་བགྲངས་ཀྱང་ཆོག་པ་ཡིན་ནོ།",
    "སྟོང་པའི་ངང་ལས་ཁྱེད་རང་རྣམས་ཟིལ་གནོན་རཏྣ་ཧེ་རུ་ཀ་སེར་ནག།",
    "ཁྱེད་རང་རྣམས་ཟིལ་གནོན་པདྨ་ཧེ་རུ་ཀ་དམར་ནག།",
    "ཁྱེད་རང་རྣམས་ཟིལ་གནོན་ཀརྨ་ཧེ་རུ་ཀ་ལྗང་ནག་གཡས་རལ་གྲི་གཡོན་ཐོད་ཁྲག་བསྣམས་པ།",
    "ཁྱེད་རང་རྣམས་ཟིལ་གནོན་བཛྲ་ཧེ་རུ་ཀ་མཐིང་ནག་གཡས་རྡོ་རྗེ་གཡོན་ཐོད་ཁྲག་བསྣམས་པ།",
    "གྲུབ་པ་རྣམས་ལ་རྩལ་གྱི་མཐའ་ཅན་དུ་བྱེད་པ་སོགས་ཀྱང་འདུག་ཅིང་།",
    "ཕྱོགས་སྐྱོང་མ་ཧེ་བརྫིས་པའི་གནམ་ལྕགས་འབར་བའི་འཁོར་ལོ་རྩིབས་སྟོང་དང་ལྡན་པའི་ལྟེ་བར་ཁྱེད་རང་རྣམས།",
    "ཁྱེད་རང་རྣམས་ལ་གཉིས་སུ་མེད་པར་ཐིམ་པས།",
    "ཡ་ད་ཡོ་ནི་ར་ཡ་ཀྵེ་ཡ་ཡཀྵེ་རཱ་ཙ་ནི་ར་མ་ཡ་ཨ་བྷི་ཥིཉྩ་མཾཡང་སྤྲུལ་རྣམ་པར་ཤེས་པ་བརྒྱད་ཀྱི་དགྲར།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་གྱི་བུ་ག་ཐམས་ཅད་ནས་ཞུགས།",
    "སྤྲིན་ལས་ཆར་ལྟར་དུ་ཐོན་པ་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་དང་རོ་གཅིག་ཏུ་གྱུར་པས།",
    "གང་ལ་བསྐུར་བ་ཁྱེད་རང་རྣམས་ཀྱི་ངག།",
    "ཁྱེད་རང་རྣམས་འོད་དཔག་མེད་མདུན་གྱི་ནམ་མཁར་ཉི་མའི་དཀྱིལ་འཁོར་དང་བཅས་པར་གསལ་བ་ལས།",
    "གང་ལ་བསྐུར་ན་ཁྱེད་རང་རྣམས་ཀྱི་ཡིད་ལ།",
    "ཡཀྵེ་ཡ་ཙ་ནི་ར་མ་ཡ།",
    "དེ་ཡང་ཡབ་ཀྱི་ཐུགས་ཀར་ས་བོན་ཨཱ་ཧཱུྃ་ཏྲཱྃ་ཧྲཱི་རྣམས་ཁ་དོག་དམར་མཐིང་སེར་ལྗང་རང་འོད་འཕྲོ་བ་སྔགས།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོ་གཅིག།",
    "ས་ར་ཧནི་རིགས་སྤྱོད་བརྟུལ་ཞུགས་དང་ཕྱོགས་ལས་རྣམ་རྒྱལ་སོགས་ཉེ་རྒྱུའི་སྤྱོད་པ་མང་དུ་མཛད་འདུག་པ་བཞིན་བདག་ཀྱང་བགྱི་བར་འོས་བསམ་སེམས་ནབྲམ་ཟེ་ལས་འཁྲུངས།",
    "བདག་དུས་དེང་ནས་བཟུང་ནས་ཇི་སྲིད་མཚོའི་བར།",
    "དབེན་པར་སྐྱབས་ཡོད་འདུག་པའོ།",
    "ཡང་ཡང་དང་ནི་འདུག་གནས་དང་།",
    "སྲོག་ཆགས་བཅས་དང་ཉལ་སར་འདུག།",
    "དེའི་འོག་ཏུ་ཕྱོགས་ཆེས་མཐོན་པོར་འདུག་སྟེ་ཕྱོགས་བཞིར་ལྟ་བར་བྱའོ།",
    "དེ་དག་དང་ལྷན་ཅིག་ཏུ་འདུག་སྟེ་གསོ་སྦྱོར་བྱའོ་ ཞེས་སོ།",
    "རྐང་པ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "མ་དག་པ་ཡང་གང་འཚམ་འདུག་པས།",
    "དེའི་དུས་སུ་ཤིང་སཱ་ལའི་སྡོང་པོ་དག་ནི་ཞིམ་མངར་གྱི་དྲི་མས་ཁེངས་ཤིང་མཛེས་སྡུག་ཡིད་དུ་འོང་བའི་མེ་ཏོག་སྣ་ཚོགས་ཀྱིས་བརྒྱན་འདུག་མ་ཟད་བྱ་དང་བྱེའུ་སོགས་མཁའ་ལ་རྒྱུ་བ་དག་དང་།",
    "དེ་ཙ་ན་ཆེས་ཡ་མཚར་བའི་གནས་ཚུལ་ཞིག་བྱུང་བ་ནི།",
    "རྒྱལ་སྲས་གཞོན་ནུ་དོན་གྲུབ་ཀྱིས་ནམ་ཡིན་ཡང་ཐུགས་བསམ་བཞེས་ནས་བཞུགས་ཀྱིན་འདུག་པས།",
    "ད་ངས་ཁོ་རང་ལ་དགའ་སྣང་དང་སྤྲོ་བ་འཕེལ་བའི་བྱ་བ་ཅི་ཞིག་བྱས་ན་བཟང་།",
    "བཙོ་བརླག་མཁན་རྣམས་ཀྱིས་ནི་རྒྱུ་སྤོས་ལེགས་པའི་ཚོན་རྩི་དག་བེད་སྤྱད་དེ་གྱོན་གོས་ལ་ཁ་སྒྱུར་བཞིན་ཐག་རྡང་དུ་དཔྱངས་ནས་སྐམ་སྲད་བྱེད་ཀྱིན་གདའ།",
    "དེཙ་ན་རྒྱལ་རྒྱས་ཀྱིས་ཁ་ལོ་སྒྱུར་བ་ལ་སྨྲས་པ།",
    "གལ་སྲིད་སྐྱེ་བོ་ཚང་མས་གཏན་གྱི་བདེ་བ་དང་རང་དོན་ཉི་ཚེ་བའི་བདེ་བ་སོགས་སོ་སོར་ཤེས་ཤིང་ཁོང་དུ་ཆུད་པར་གྱུར་ན།",
    "འོན་ཀྱང་ཁོ་རང་འདི་ནས་འདུག་འདོད་ཡོད་ན་ཁོའི་ཆེད་དུ་གདན་གཅིག་བཏིང་ན་མཐུས།",
    "གལ་ཏེ་འདུག་འདོད་མེད་ན་ཡར་ལངས་ནས་བསྡད་ཀྱང་མི་ཆོག་པ་མེད།",
    "སྦྲུལ་རྒྱལ་དེས་སྐུ་ཉིད་ལ་གནོད་ཅིང་འཚེ་བ་བྱེད་མི་ཡོང་ངམ་སྙམ་ན་ང་ལ་ཏོག་ཙམ་ཞེད་སྣང་འདུག་ཅེས་ཞུས་པར།",
    "ད་ལྟ་ཁྱེད་ཀྱིས་ཟས་སློང་ནས་བྱོན་ན་ཁྱེད་ལ་འཚམ་པོ་དང་རན་པོ་འདུག་གམ།",
    "དེར་བརྟེན་ཁྱེད་རང་ཡབ་ཆེན་གྱི་མདུན་དུ་ཕྱིན་ནས་འདི་ལྟར་ཞུས།",
    "ཐ་ན་ཁྱེད་ཀྱི་གྲིབ་ནག་ཙམ་གྱིས་ཀྱང་ང་ལ་ཇི་འདྲའི་བདེ་བ་ཞིག་སྟེར་གྱིན་འདུག་ཅེས་ཞུས།",
    "འོན་ཀྱང་ཁོང་ཡང་ཁྱེད་ཀྱིས་འདིར་ཁྲིད་ནས་རབ་ཏུ་བྱུང་བར་མཛད་འདུག་ན།",
    "བདག་ལ་དེ་དག་ཤེས་འདོད་འདུག་ཅེས་དང་བ་དང་དོ་སྣང་ཆེན་པོས་དེ་ལྟར་དྲིས་པ་ན།",
    "ངས་ཁོང་ལ་ཅི་ཡང་བྱེད་ཐུབ་ཀྱི་མི་འདུག་དེས་ན་ངས་ཁོང་ལ་བྱ་ངན་ཅི་ཞིག་བྱས་ན་དགའ་སྙམ་བཞིན་ཡོད།",
    "གང་ལྟར་དུར་ཁྲོད་དེར་མི་གཅིག་ཀྱང་མེད་པས་ཁོ་རང་སྐྲག་ཐག་ཆོད་དེ་ལུས་ཀྱི་སྤུ་གཟེངས་ཤིང་།",
    "དེའི་དཀྱིལ་དུ་ཆེས་ལྟ་ན་སྡུག་ཅིང་བཞིན་རས་ལེགས་པའི་སྐྱེས་བུ་ཞིག་འོད་ཆེམས་ཆེམས་ངང་རང་ཉིད་ཀྱི་ཕྱོགས་སུ་བྱོན་ཏེ།",
    "ཁོ་རང་རང་ཉིད་ཀྱི་མིག་རྣ་སོགས་ལ་ཡང་ཡིད་མི་ཆེས་པ་ཞིག་བྱས།",
    "ངའི་ཆུང་མ་ལ་བུ་ཞིག་བཙས་འདུག་ཅེས་བཀའ་ལན་ཕུལ།",
    "ཆེས་འཇིགས་སུ་རུང་བ་ཞིག་ཏུ་གྱུར་འདུག་པས།",
    "དེས་ན་དེ་རིང་ཅི་འདྲའི་ཡ་མཚར་ཞིག་དགེ་སྦྱོང་འདི་གཏད་ནས་འཛིན་ཐུབ་པར་མི་འདུག་སྙམ་སྟེ་སྐད་ཤུགས་ཆེན་པོའི་སྒོ་ནས་སྨྲས་པ།",
    "འོན་ཀྱང་ངའི་རྒྱལ་ཕྲན་གྱི་མངའ་ཁོངས་འདི་ན་མིང་ལ་སོར་འཕྲེང་ཅན་ཟེར་བ་ཆེས་འཇིགས་སུ་རུང་བའི་ཇག་པ་ཞིག་འདུག་པས་ངེད་ཅག་དེ་འཇུ་བཟུང་བྱེད་དུ་འགྲོ་བ་ཡིན།",
    "གཞོན་ནུ་ཝ་ཀ་ལི་ལ་ཧ་ལས་དགོས་པའི་བློ་ཕམ་ཞིག་སྐྱེ་རུ་མ་བཅུག་ན་ཁོས་དོན་དེ་རྟོགས་ཐུབ་པ་མི་འདུག་གོ་སྙམ་དུ་དགོངས་སོ།",
    "དེ་ཙ་ན་གཞོན་ནུ་ཝ་ཀ་ལིའི་སེམས་སུ།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་མིག་རྣ་ལ་ཡང་ཡིད་མ་ཆེས་པར་ཡུད་ཙམ་རིང་ངག་ནས་ཚིག་གཅིག་ཀྱང་མ་ཐོན་པར་ཧད་དེ་ལུས་སོ།",
    "རང་ཉིད་ཀྱི་སྲས་མ་སྐྱེས་དགྲ་ཡིས་ཁོང་ཡ་ང་བའི་མནར་གཅོད་འོག་དུས་མིན་གྱི་འཆི་ལམ་ལ་བརྫངས་སོ།",
    "༦ རང་ཉིད་ས་ལ་འདུག་སྐབས་བག་ཡོད་ཚུལ་མཐུན་གྱི་སྒོ་ནས་འདུག་དགོས།",
    "ཚེ་རབས་སྔོན་མར་བསགས་པའི་ལས་ཀྱི་རྣམ་སྨིན་རྣམས་ལོངས་སུ་སྤྱོད་རྐྱང་བྱེད་ཀྱིན་འདུག་དེས་ན་འདི་ཁ་ཟས་རྙིང་པ་ཟོས་པ་དང་གཅིག་མཚུངས་མ་ཡིན་ནམ།",
    "དེས་ན་ངས་ས་བོན་འདེབས་ལས་བྱས་མི་འདུག་གམ།",
    "སྲིན་པོ་ཨ་ལ་ཝ་ཀ་ད་ངས་ཁྱེད་ཀྱི་བཀའ་ལ་ཉན་མི་ཐུབ་པས་འདི་ནས་འདུག་རྒྱུ་ཡིན།",
    "སྐྱེས་བུ་དམ་ལའང་མཐོང་དང་གུས་ཞབས་གཏད་ནས་བྱེད་ཀྱི་མི་འདུག་ཅེས་ཞུས།",
    "གནས་བརྟན་དག་ད་ནི་ང་བགྲེས་འདུག་མ་ཟད་ངས་རང་ཉིད་ཀྱི་ཞབས་ཕྱི་གནས་བརྟན་ཁ་ཤས་ལ།",
    "ངའི་སྐྲ་དང་ཨ་ར་སོགས་བཞར་ཕྱིར་སྐྲ་བཞར་བ་ཞིག་ངའི་རྩར་བཏང་འདུག་དགོངས་ནའང་།",
    "ངས་གོ་ཐོས་ལ་ཁྱེད་ཀྱིས་དྲན་ཤེས་བསྟེན་ཏེ་ཉམས་ལེན་ཇི་ལྟར་བྱས་ཀྱང་འབྲས་བུ་བཟང་པོ་ཞིག་མ་ཐོབ་པར་བརྟེན་སླར་ཡང་ཁྱིམ་པའི་སར་ལོག་འདོད་འདུག་ཟེར།",
    "ང་ནི་ལོ་ན་ཤིན་ཏུ་རྒས་ཏེ་མི་ཚེའི་མཐའ་ལ་སླེབས་འདུག་ནའང་།",
    "དེ་ཡང་རང་རྒྱུད་ཀྱི་བཀའ་ལས་གཞན་ན་སྐྱབས་གཞན་གཉིས་པ་མེད་པས།",
    "ད་དུང་ཚེ་རིང་པོར་འཚོ་ཞིང་འདུག་འདོད་ཡོད་ན་དེ་ལྟར་འདུག་ཐུབ་པ་ཡིན།",
    "དེང་སྐབས་ཁོང་རྣམས་ཀྱིས་ཀྱང་སྐྱེ་བོ་གཞན་ལ་གདམས་པ་འཆད་ཁྲིད་བྱེད་ཐུབ་ཀྱི་འདུག་དགོངས་ཏེ།",
    "ད་ནི་ང་ཐང་ཆད་པར་འདུག་པས།",
    "ངུ་འབོད་སོགས་བྱེད་ཀྱིན་འདུག་གོ།",
    "ཁོ་བོ་ནི་ད་དུང་སློབ་པ་ལམ་གྱི་གནས་སྐབས་ཡིན་པས་དགྲ་བཅོམ་པའི་ལྷན་ཚོགས་དེར་ཞུགས་ན་ཤིན་ཏུ་ནས་མི་འོས་པར་འདུག་ནའང་།",
    "འདུག་སྟངས་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ལུས་ཀྱི་འདུག་སྟངས་འཁྲུལ་འཁོར་གསུངས་སོ།",
    "རྒན་རིམས་སུ་ཇི་ལྟར་འོས་པར་ཕྱག་བྱས་ནས་མི་རྟག་པ་ཡིད་ལ་བྱས་ཏེ་སེངྒེའི་ཁྲི་ཟིལ་གྱིས་མནན་ནས་འདུག་སྟེ།",
    "དེ་སེངྒེའི་ཁྲི་ལ་འཛེགས་ནས་འདུག་གོ།",
    "གང་གཞུའི་དབྱིབས་ལྟར་འདུག་པའམ།",
    "རྒྱུ་དང་རྐྱེན་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ།",
    "ལན་དུ་མ་བསྐོར་བ་བྱས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་གནང་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་སྟེ།",
    "གཡོག་དང་བཅས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་ནས།",
    "འཇིག་རྟེན་སྐྱོང་བ་རྣམས་ཀྱིས་སྔོན་མ་མཐོང་མ་ཐོས་པ་འདུག་པར་གྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ལུས་བཏུད་ནས་འདུག་སྟེ།",
    "ཡང་དེའི་ཚེ་ལྷའི་བུ་བཟང་སེམས་ཞེས་བྱ་བ་འཁོར་དེ་ཉིད་དུ་འདུས་པར་གྱུར་ནས་འདུག་པ་དེས།",
    "སྤྲིན་དང་ཆར་རྣམས་གདའ་བར་གྱུར།",
    "སོ་སོའི་ལུས་ལ་བརྒྱན་པ་གདའ།",
    "དྲི་ཟ་ལ་སོགས་པ་འཁོར་གྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་འདུག་པ་ལས་ལངས་ནས་ཅི་ནུས་སུ་སོ་སོ་ནས་གསེར་དང་།",
    "བཟོ་ཤིན་ཏུ་མཁས་པས་ལས་སུ་བྱས་པའི་གཞལ་མེད་ཁང་ཆེན་པོར་སྔོན་རྒྱལ་པོ་སྔ་མ་འདུག་འདུག་པའི་ཁྲི་ལ་བཞག་ནས་རྒྱལ་པོར་བཅུག་གོ།",
    "རིགས་ཀྱི་བུ་དེ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པ་ཡང་རང་བཞིན་ལ་ཤིན་ཏུ་ཐབས་མཁས་པས་མཁྱེན་པའི་ཡེ་ཤེས་དང་ལྡན་པས་བདུད་སྡིག་ཅན་མ་རུངས་པ་དང་།",
    "འདི་སྙེད་ཀྱི་བར་དུ་འདུག་འདུག་གོ།",
    "ཆུང་ངུ་ན་དུག་བྱིན་པས་མངལ་ན་འདུག་པ་བསད་པ་སྟེ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཨུ་པ་ལིས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་འདི་དག་ཐོས་ནས་འདུག་པ་ལས་ལངས་ཏེ།",
    "ཡོན་ཏན་ལྔ་ཕྲུགས་དང་ལྡན་པ་གཅིག་འདུག་པ་ལས་ལངས་ཏེ།",
    "ཇི་སྟེ་འདུག་པ་ཞིག་ཡོད་ན་ཡང་མི་འདོད་ཅིང་གཏོང་བའི་བསམ་པ་སྐྱེས་པས་བསྐྱབ་ཅིང་བསྲུང་བའི་སེམས་མེད་དོ།",
    "ཕས་རྒོལ་བའི་དགྲ་ཐམས་ཅད་ཞི་ཞིང་རང་ལྡོག་པར་འགྱུར་བ་དང་།",
    "དགེ་སྦྱོང་དེ་ནི་དེར་འདུག་མ་གནང་།",
