    "སྣོད་སྤྱད་སྦེད་པ་ཞེས་བྱ་བ་དང་པོར་བྱས་ཏེ་འདུག་པར་བྱའོ་ཞེས་བྱ་བའི་མཐར་ཐུག་པ་དང་།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་མ་དྲས་པ་དེས་གྲོང་དང་ཁྱིམ་གཞན་དག་ཏུ་འདུག་པ་དང་འཇུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "འཁོད་ན་འདུག་པ་དང་འཇུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་རྐྱེན་དེ་ལྟ་བུ་དག་ཡོད་ཀྱང་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེར་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདིར་གཞུང་ནི་བཙུན་པ་ཀུན་དུ་རྒྱུའི་འདུག་གནས་སུ་སྣམ་སྦྱར་མ་མཆིས་པར་མཆིར་རུང་ངམཉེ་བ་འཁོར་མི་རུང་ངོ།",
    "ལ་བ་སྤུ་ཕྱིར་བསྟན་ཏེ་གྱོན་ལ་འདུག་པར་བྱ་ཞིང་ཉལ་བར་ཡང་བྱའོ།",
    "རྐང་པ་དང་བཅས་པའི་སྟན་ལ་འདུག་པ་ལ་གནས་མལ་རྐྱང་པ་མི་འགྲུབ་པའོ།",
    "ཁྱིམ་གཞན་དུ་གཞན་མེད་ན་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "ལྷན་ཅིག་ཏུ་འདུག་པ་དང་ཉལ་བར་ཡང་བྱ་བ་སྨོས་སོ།",
    "དུས་སུ་རུང་བའི་ནང་ན་འདུག་པའི་འཚོ་བའི་བར་༡༡༥༦དུ་བཅང་བ་ལ་དུས་སུ་རུང་བ་ཉིད་དང་།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དང་།",
    "གླེང་གཞི་རྣམས་ལས་དེ་སྤང་བ་འདུག་པ་ཞེས་བྱ་བ་དང་པོར་བྱས་ནས་དགེ་སློང་མའི་ཞེས་བྱ་བའི་མཐར་ཐུག་པར་གསུངས་པ་ཡིན་ནོ།",
    "རྩྭ་བམ་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་སྟན་གཞན་མེད་པའོ།",
    "དེ་བཞིན་དུ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་དང་།",
    "སྤྱོད་ལམ་མཛེས་པས་ཟན་གྱི་ཆེད་དུ་འདུག་པར་བྱའོ།",
    "གཞན་གྱིས་མགྲོན་དུ་བོས་ནས་འདུག་པ་ལ་དེས་གནང་ན།",
    "གཞན་གྱིས་བྱིན་པ་ན་དེའི་ཁོངས་སུ་གཏོགས་པ་དང་འདྲའོ་ཞེས་བྱ་བ་ནི་གང་ཞིག་གཞན་གྱིས་༧མགྲོན་དུ་བོས་ན་ནི་འདུག་པ་ལ་སྦྱིན་བདག་དེས་གནང་ན་སྦྱིན་བདག་གཞན་གྱིས་སྦྱིན་པའོ།",
    "༡༡༩༡ལག་པ་བསྙལ་དུ་བཅུག་པ་འདིར་གཞུང་ནི་ཕྱོགས་དབེན་ཾཔར་འདུག་སྟེ།",
    "འོང་ན་དགག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་ཤུགས་འབྱུང་ན་དེ་ཕྱིར་དགག་པར་མི་བྱའོ་། དེ་དང་འབྲེལ་བའི་དོན་ལས་གཞན་པས་དེའི་དྲུང་དུ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "ལྟོ་འཛག་པས་ནི་མདུན་དག་ཏུ་ཕྱི་བ་ཙམ་བྱས་ཏེ་འདུག་པ་ལ་ཉེས་པ་མེད་དོ་ཞེས་བྱ་བ་ལ།",
    "དེ་ལས་གཞན་པས་ནི་ཆུ་ཡོད་ན་འཐོར་འཐུང་མ་བྱས་པར་ཡང་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "རང་བཞིན་དུ་གནས་ཏེ་སེམས་པ་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་འདི་ལ་གཞན་ཕམ་པ་བྱེད་པ་རྣམས་བསྟན་པའི་ཕྱིར་འཁྲུལ་པ་དང་བཅས་པ་ཞེས་བྱའོ།",
    "བདེ་འགྲོར་འགྲོ་བ་དང་རང་བཞིན་དུ་གནས་པའི་རྗེས་སུ་མཐུན་པ་ཉིད་ལས་སོ།",
    "གང་དུ་བྱེ་བྲག་གང་དང་ལྷན་ཅིག་པའི་འདུག་པ་ལ་རྗེས་སུ་མ་ཞུགས་པ་ཉིད་ཅེས་བྱ་བ་དེ་དང་པོར་བསྟན་པའི་ཕྱིར།",
    "དེ་བརྩམས་པ་འགྲོ་བའི་སེམས་ཀྱིས་བཏང་བ་ནི་སྤྱོད་ལམ་ལས་ཉམས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འདུག་པ་ཞེས་བྱ་བའི་སྤྱོད་ལམ་དེ་བརྩམས་ཤིང་སྔར་འདུག་པར་གྱུར་པ་གཞན་དུ་འགྲོ་བའི་སེམས་ཀྱིས་བཏང་བ་ནི་སྤྱོད་ལམ་ལས་ཉམས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ན་གང་ཟག་ལ་ལྷུང་བཟེད་ལ་སོགས་པ་བྱིན་གྱིས་བརླབ་པའི་ཚིག་དེ་ཡང་རང་བཞིན་དང་བྲལ་བ་ཉིད་ལ་ཉམས་པར་འགྱུར་རོ།",
    "ལྷག་པོར་ཡང་མདུན་དུ་ཙོག་པུར་འདུག་སྟེའོ་ཞེས་བྱ་བ་ནི་གང་ཟག་འདི་གང་ཟག་ལ་ཡང་ངོ་ཞེས་བྱ་བ་སྨོས་པས་སོ།",
    "བསྙེན་པར་རྫོགས་པར་བྱ་བའི་གང་ཟག་དེ་ཕ་གུའི་སྟེང་དུ་རྟིང་པ་ཉིད་ཀྱིས་འདུག་ཏུ་གཞུག་གོ།",
    "རྒན་པའི་མཐའ་ལོགས་སུ་ཙོག་པུར་འདུག་སྟེ་བརྗོད་པར་བྱའོ་། འདི་ལྟ་སྟེ།",
    "འགྲེངས་ཏེ་འདུག་པ་རྣམས་ཀྱིས་དུས་སུའོ།",
    "གསོ་སྦྱོང་དང་དགག་དབྱེ་དག་བྱིན་གྱིས་བརླབ་པའི་ཕྱིར་ཙོག་པུར་འདུག་སྟེ་བྱ་བར་གསུངས་པས་དེ་གཉིས་ཀ་ོཡང་འདུག་སྟེ་བྱའོ།",
    "གང་དུ་མི་འདུག་པ་རྣམས་ཀྱིས་གནས་པར་རིགས་པ་ཡིན་ཏེ་འདུག་པ་རྣམས་ཀྱིས་ནི་མ་ཡིན་ནོ།",
    "ྟའདུགཔའམ་མི་གནས་པ་རྣམས་ཀྱིས་དེར་ཡང་ནུས་པ་དེ་ལྟ་བུར་གྱུར་པ་ཉིད་ལ་བྱ་བ་བྱེད་པ་འགྲོ་བ་བཞིན་དུ་དོར་བར་༤མི་རིགས་པ་དེ་བས་ན།",
    "དེ་ལྟ་བུའི་ངོ་བོའི་རྐྱེན་རྣམས་ལ་གང་ལ་འགྲོ་བ་ཉིད་ལ་བྱ་བ་ཉིད་འདུག་པ་ལ་ཡང་དེའི་རྫས་བྱིན་གྱིས་བརླབ་པ་དང་།",
    "བཏང་བ་དག་ནི་འདུག་པ་ལ་ཡང་རིག་པར་བྱའོ།",
    "ལས་ནི་འདུག་པ་ཉིད་ཀྱིས་སོ་ཞེས་བྱ་བ་ནི་གསོལ་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་འདུག་པ་ཉིད་ཀྱིས་བྱའི་སྤྱོད་ལམ་གཞན་གྱིས་༧ནི་མི་བྱའོ་། དགག་དབྱེ་བྱེད་པ་པོ་ལ་མངོན་སུམ་དུ་ཆོ་ག་བརྗོད་པ་ཡིན་ནོ།",
    "འདུག་པའི་གནས་ཐམས་ཅད་ལ་རྒན་རིམས་སུ་བསྐོ་བ་རིགས་པ་ཉིད་ཡིན་ནོ།",
    "འདུན་པ་ལ་སོགས་པ་ལེན་པ་དེས་ནམ་མཁའ་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་བསླབ་པའི་གཞི་བཅའ་བར་མཛད་དེ།",
    "མཚམས་གཞན་སྨོས་པ་ཉིད་ཀྱི་ཕྱིར་ནམ་མཁའ་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་ཅིའི་ཕྱིར་སྨོས།",
    "དེའི་ཕྱིར་རང་བཞིན་དུ་གནས་པ་མཚམས་ཀྱི་ནང་ན་འདུག་པ་ལའོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "རང་བཞིན་དུ་གནས་པ་མཚམས་ཀྱི་ནང་ན་འདུག་པ་ལའོ་ཞེས་གསུངས་པ་དེ་འདིར་ལུང་ཡིན་ནོ་།",
    "ཁྱིམ་པ་ཡང་དག་པར་སྡོམ་པ་ཡང་རང་བཞིན་དུ་གནས་པ་ཉིད་ཡིན་ནམ་ཞེ་ན།",
    "གནས་སྐབས་ཇི་ལྟར་འདུག་པ་ལ་བྱ་ཞེ་ན།",
    "འདིར་གཞུང་ནི་མི་གནས་པར་འདུག་པར་མི་བྱའོ་ཞེས་གསུངས་པ་དེའི་དོན་ཅི་ལགས།",
    "ཡིད་དུ་འཐད་པའི་སེམས་ཉེ་བར་གནས་པ་ཡོད་པ་དེ་ལ་གནས་དེར་འདུག་པར་བྱའོ་ཞེས་གསུངས་པའི་གཞུང་གནང་བ་ཡིན་ནོ།",
    "སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "བརྗོད་པའི་ཡན་ལག་མེད་ན་དེའི་སེམས་མ་ཡིན་པ་ཉིད་འཆབ་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་བརྗོད་པའི་རང་བཞིན་དུ་གྱུར་པ་དང་རང་བཞིན་དུ་གནས་པ་དང་།",
    "སྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་ལ་འདུག་པར་ཡང་ངོ་ཞེས་བྱ་བ་ནི་ལྷན་ཅིག་པར་ཡང་མི་བྱ་ན་སྟན་གཅིག་ལ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་དུ་མི་འདུག་པ་དང་།",
    "དེ་གཉིས་འདུག་པ་ནི་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་སྟན་ཆེས་དམའ་བ་ལ་འདུག་པར་བྱའི་མཉམ་པའམ་ཤིན་ཏུ་མཐོ་བ་ལ་འདུག་པར་མི་བྱའོ།",
    "དེ་གཡོགས་མ་གཅིག་ཏུ་མལ་མི་བཤམ་པ་དང་ཡོངས་སུ་གནས་པ་དག་མགུ་བར་བྱ་བ་སྤྱོད་པ་དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "འདུག་པ་ལ་ཐ་མར་འོས་པའི་ཆོ་ག་འདི་ཡིན་ཏེ།",
    "ཕྱོགས་ཅིག་ཤོས་སུ་ཡང་རང་འགྲོ་བར་མི་བྱའོ་། མངག་པ་གཏང་ེབར་མི་བྱ་ཞིང་།",
    "ཕྱོགས་གཉིས་པར་ཡང་རང་འགྲོ་བར་མི་བྱ་ལ་མངག་པ་གཏང་བར་མི་བྱ་བར་ལུས་ཀྱིས་ཀྱང་བསྡམ་པར་བྱ།",
    "ལྷན་ཅིག་འགྲོ་བ་དང་འདུག་པ་དང་ལྷན་ཅིག་འཆག་སར་འཆག་ིཔ་དང་གཏམ་འདྲེ་བ་དང་ཕེབས་པར་སྨྲ་བ་ཡང་ངོ་ཞེས་བྱ་བ་ཡང་།",
    "སྤྱོད་ལམ་ཞེས་སྨོས་པ་ནི་འགྲོ་བ་དང་འགྲེང་ེབ་དང་འདུག་པ་དང་ཉལ་བས་བྱས་པས་གླེང་བ་བསྡུས་སོ།",
    "དགེ་སློང་ཤི་རི་ཀ་ཉིད་ཀྱིས་རྒན་པའི་མཐར་འདུག་སྟེ།",
    "༡༧༦ནང་ན་འདུག་པ་ཞེས་བྱ་བ་དང་སྦྱར་ཏེ་ཁྱིམ་པའི་ཁྱིམ་ན་འདུག་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྱིམ་གཞན་ན་འདུག་པ་ལ་ཡང་མ་གཏོགས་པར་མི་རིགས་ཏེ།",
    "ཁྱིམ་གཞན་ན་འདུག་པའོ།",
    "འདུག་པ་དང་ཉལ་བ་ན་འདུག་པའི་འོ་ཞེས་བྱ་བ་ནི་བསྟེན་པར་བྱའོ།",
    "གང་དུ་འདུག་པའི་སྤྱོད་ལམ་བསྟེན་པར་བྱ་ཞེ་ན།",
    "རྗེས་སུ་གནང་བ་ལ་མི་ལྟོས་པ་ཉིད་ཀྱིས་རང་འདུག་པར་བྱའོ།",
    "གསར་བུས་རྗེས་སུ་གནང་བ་ལ་ལྟོས་ཏེ་འདུག་པར་བྱ་བ་བསྟན་པའི་ཕྱིར་གསར་བུས་ནི་བསྒོ་ནའོ་ཞེས་བྱ་བ་སྨོས་ཏེ་ལུང་འབོགས་པར་བྱེད་པས་བསྒོ་ཞིང་རྗེས་སུ་གནང་ན་འདུག་པར་བྱའོ།",
    "འདུག་པ་བསྟེན་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "༡༣༨༥ཡིན་ན་འདུག་པའི་ཕྱིར་ལུང་འབོགས་ོཔར་བྱེད་པ་ལ་ཞུ་བར་བྱའོ།",
    "མང་དུ་ནོད་ན་སློབ་དཔོན་ལ་ཞུས་ཏེ་སྟན་ཆེས་དམའ་བ་ལ་འདུག་ནས་ལུང་མནོད་པར་བྱའོ།",
    "ཇི་སྟེ་ཉུང་དུ་ནོད་ན་ནི་ཙོག་པུས་འདུག་སྟེའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཐོས་པའི་ཉེན་ཀོར་མ་གཏོགས་པ་སྣང་བའི་ཉེན་ཀོར་དུ་འདུག་སྟེ་ཁ་ཏོན་བྱའོ་ཞེས་བྱ་བ་ནི་མཐོང་བའི་ཉེན་ཀོར་དུ་གནས་ནས་སོ།",
    "ཁྲིའུ་ལ་གཅིག་མ་ཡིན་པས་མི་བྱའོ་ཞེས་བྱ་བ་ནི་གཅིག་ཁོ་ན་དེ་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལོ་གསུམ་ལས་ལྷག་པས་བར་དུ་ཆོད་པ་དང་ལྷན་ཅིག་སྟན་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་ལོ་གསུམ་ལས་ལྷག་པའི་དུས་བསྙེན་པར་རྫོགས་པའི་བར་དུ་གྱུར་པས་བསྙེན་པར་རྫོགས་པའི་དུས་གཞན་གྱིས་བར་དུ་ཆོད་པ་ཉིད་དེ་དང་ལྷན་ཅིག་སྟན་ཐམས་ཅད་ལ་འཛེག་པ་ཉིད་བསྟེན་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "གང་ཡང་རུང་བར་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "བསྙེན་པཔར་མ་རྫོགས་པ་དང་ཡང་མི་བྱའོ་ཞེས་བྱ་བ་ནི་བསྙེན་པར་མ་རྫོགས་པ་དང་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "དེ་དག་གང་དང་གང་དུ་ཡང་རུང་སྟན་གཅིག་ལ་འདུག་པ་བསྟེན་པར་མི་བྱའོ།",
    "བསླབ་པ་བྱིན་པ་དང་མི་བྱའོ་ཞེས་བྱ་བ་ནི་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པ་བསྟེན་པར་མི་བྱའོ།",
    "དེ་ལ་རྒན་རིམས་སུ་མི་བྱའོ་ཞེས་བྱ་བ་ནི་འདུག་པ་དེ་ལ་རྒན་རིམས་སུ་མི་བྱའོ།",
    "འདུག་པ་ལ་ཉེ་བར་མཁོ་བའི་སྟན་ལ་སོགས་པ་རྣམས་ལ་ཇི་ལྟར་འོངས་པ་ཉིད་ཀྱིས་ལོངས་སྤྱད་པ་སྟེ།",
    "ཆད་ན་ཁྱིམ་དག་ཏུ་གཞག་གོ་ཞེས་བྱ་བ་ནི་ཆར་པ་ཆད་ན་དེའི་དྲུང་དུ་འདུག་པའི་ཁྱིམ་གང་ཡིན་པ་དེར་འདུགས་ཏེ་བཏགས་ཏེ་གཞག་གོ།",
    "དེས་དེའི་ཕྱིར་སྒོར་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "སྣང་གཡེལ་ཅན་དུ་མི་བྱའོ་ཞེས་བྱ་བ་ནི་འདུག་པར་ཏེ།",
    "གོས་མེད་པ་ཅན་གྱིས་མི་བྱའོ་ཞེས་བྱ་བ་ནི་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ་།",
    "པེ་སྣར་འདུག་༩༨པེ་སྣར་ན།",
    "༩༥༥པེ་སྣར་འདུག་༣པེ་སྣར་བཟུང་།",
    "པེ་སྣར་བས་འདུག་པེ་སྣར་བླུག་པེ་སྣར་ལྕགས།",
    "པེ་སྣར་གདའ་བར།",
    "པེ་སྣར་འདུག་༣སྣར་ཅེས།",
    "༧པེ་སྣར་འདུག་པེ་སྣར་ལ།",
    "༡༣༢༥པེ་སྣར་འདུག་པེ་སྣར་པ།",
    "མལ་ན་འདུག་ཀྱང་རུང་ལུས་ཀྱི་འགྲོ་བའི་བྱ་བས་མ་ཟིན་པའི་ཡུལ་དེར་འགྲོ་བར་བྱའོ་སྙམ་པའི་ཡུལ་དེར་འགྲོ་བར་འདོད་པའི་བློ་དང་།",
    "བདག་ནི་མལ་ན་འདུག་བཞིན་དུ།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "ཇི་ལྟར་བདག་ཡིད་བདེ་བར་འདུག།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "རྐང་པ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "ཁྲི་ལ་སོགས་པ་ལ་འདུག་པ་ན་རྐང་པ་གཉིས་ས་ལ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "སྔར་ལུས་ཇི་ཙམ་ཆུད་ཟོས་ཀྱང་རང་དོན་དང་གཞན་དོན་གང་ཡང་མ་གྲུབ་པས་འགྱོད་པ་དང་།",
    "དང་པོ་སྔར་ལུས་ཇི་ཙམ་ཆུད་ཟོས་ཀྱང་རང་དོན་དང་གཞན་དོན་གང་ཡང་མ་གྲུབ་པས་འགྱོད་པ་ནི།",
    "བདག་ཉིད་ཀྱང་ནི་ཇི་ལྟར་འདུགང་རྒྱལ་གྱིས་ནི་མི་བྱེད་དེ།",
    "གཞན་ཡང་བྱིས་པ་ནི་རང་ལས་མཐོ་བ་ལ་ཕྲག་དོག་དང་མཉམ་པ་ལ་འགྲན་ཅིང་རང་ལས་དམའ་བ་ལ་དམིགས་ནས་ང་རྒྱལ་དང་བསྟོད་ན་དྲེགས་པ་སྐྱེ་ལ་མི་སྙན་པ་བརྗོད་ན་ཁོང་ཁྲོ་སྐྱེ་བས་དུས་ནམ་ཞིག་བྱིས་པ་དང་འགྲོགས་པ་ལས་ཕན་པ་ཐོབ་མི་ཐོབ་པར་མ་ཟད་གཞན་ཡང་བྱིས་པ་དང་འགྲོགས་ན་གྲོགས་བྱིས་པ་གཞན་ལ་བདག་བསྟོད་ཅིང་གཞན་ལ་སྨོད་པ་དང་།",
    "ཅུང་ཟད་ལྷན་ཅིག་གནས་ཀྱང་དེ་ལ་ཞེན་པ་དགོས་པ་མེད་དེ་སྐྱེ་ནའང་རང་ཉིད་གཅིག་པུ་སྐྱེ་འགྱུར་ཞིང་འཆི་ནའང་དེ་ཉིད་གཅིག་པུ་འཆི་སྟེ།",
    "མི་གཙང་རང་བཞིན་གཞན་གྱིས་ལུས།",
    "དེ་ཁོ་ན་ཉིད་རྟོགས་དགོས་ཀྱང་རང་རྒྱུད་ཀྱི་སྡུག་བསྔལ་ཞི་བ་ལ་དེ་ཁོ་ན་ཉིད་རྟོགས་ཅི་དགོས་སྙམ་ན།",
    "ཤུགས་རྟོགས་ཀྱི་ཐ་སྙད་འདོགས་སམ་མི་འདོགས་ཀྱང་རུང་རང་ཉིད་ལ་རང་ཉིད་མི་སྣང་ཡང་རྟོགས་པའོ།",
    "ཤེས་པས་ཀྱང་རང་གཞན་གཉིས་ཀ་རིག་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "ངས་མཐོང་ངོ་ཞེས་ཡུལ་ཅན་དྲན་པའི་རྟགས་ལས་ཡུལ་ཅན་མྱོང་བ་ཡོད་པར་གྲུབ་ལ་ཡུལ་ཅན་མྱོང་བ་དེ་ནི་རང་རིག་ཡིན་ལ་སྔོ་འཛིན་མྱོང་བྱེད་གང་ཡིན་མཐའ་གཞན་འགོག་པའི་རིགས་པས་ཀྱང་རང་རིག་གྲུབ་བོ་ཞེ་ན།",
    "ལུང་གཞན་ལ་ཡང་རང་གཞན་དགརྩོད་བཅས་ཡིན་ཕྱིར་དོར་བྱར་འགྱུར།",
    "གལ་ཏེ་བདག་འགའ་རང་བཞིན་གྱིས་གྲུབ་པ་ཡོད་པ་ནི་དེར་ཞེན་པ་ལས་ཡུལ་ཅི་ཡང་རུང་བ་ལ་འཇིགས་པ་སྐྱེ་རིགས་པར་འགྱུར་ན་བདག་ཉིད་འགའ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་ཅུང་ཟད་ཀྱང་ཡོད་པ་མིན་པས་འཇིགས་པར་འགྱུར་བ་པོ་དེ་སུ་ཞིག་ཡིན་ཏེ།",
    "སྐྱེས་བུ་གཅིག་ལྟོས་ས་ཐ་དད་ལ་ལྟོས་ནས་ཕ་དང་བུར་འཇོག་པ་བཞིན་དུ་རྣམ་འགྱུར་དང་རང་བཞིན་ལ་ལྟོས་ནས་གཟུགས་འཛིན་པའི་ཚེ་སྒྲའི་རྣམ་པར་འགྱུར་བ་མེད་ཀྱང་སྒྲའི་རང་བཞིན་ཡོད་དེ་གཟུགས་སྒྲ་གཉིས་རང་བཞིན་གཅིག་པའི་ཕྱིར།",
    "གལ་ཏེ་སྒྲ་འཛིན་ལས་ཚུལ་གཞིན་གཟུགས་འཛིན་དེ་ཉིད་སྒྲ་འཛིན་དང་རང་བཞིན་གཅིག་ཡིན་པས་སྐྱོན་མེད་དོ་ཞེ་ན་དེའི་རང་བཞིན་གཅིག་ཉིད་དེ་ནི་སྔོན་མེད་ཞིག་སྟེ་སོ་སོ་ཐ་དད་པའི་ཁོ་ནར་གནས་པའི་ཕྱིར་རོ།",
    "དེས་གང་ཟག་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པའོ།",
    "ཕྱོགས་ཀྱི་ཆར་དབྱེ་བ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དེ་རང་བཞིན་གྱིས་གྲུབ་པའི་ཆ་ཤས་དང་བྲལ་བའི་ཕྱིར་དཔེར་ན་ནམ་མཁའ་བཞིན་ནོ།",
    "བཞི་པ་དེས་གང་ཟག་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པ་ནི།",
    "ལུས་བཞིན་དུ་ཚོར་བ་ཡང་རང་བཞིན་མེད་པར་བསྟན་པ་ནིསྡུག་བསྔལ་དེ་ཉིད་དུ་ཡོད་ན།",
    "དེ་ན་གཉིས་མི་འདུག་པའི་ཕྱིར།",
    "སེམས་དེ་ལུས་དང་འདྲེས་པ་མིན་ཞིང་ལུས་ལས་ལོགས་སུའང་ཡན་དགར་བ་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་པ་དེ་ནི་ཅུང་ཟད་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པ་ཡོད་མིན་པ་དེའི་སེམས་རང་བཞིན་གྱིས་སྟོང་པ་དེ་ཉིད་རང་བཞིན་མྱ་ངན་ལས་འདས་པའོ།",
    "གཞུང་རྐང་པ་བཞི་པོ་འདིས་མུ་གསུམ་ལས་སྐྱེ་བ་བཀག་པའི་མཇུག་སྡུད་ལ་སྦྱར་ཡང་རུང་ཞིང་རང་གཞན་གཉིས་ཀ་ལས་སྐྱེ་བ་འགོག་པའི་རིགས་པ་ལ་ཡང་སྦྱར་རོ།",
    "གནས་པ་མ་ཡིན་འགྲོ་མ་ཡིན།",
    "མྱུ་གུ་ལ་སོགས་པའི་འབྲས་བུ་རྣམ་ཆུ་ལུད་དྲོད་གཤེར་ལ་སོགས་པ་སོ་སོ་བ་རྣམས་ལ་གནས་པའམ་ཐམས་ཅད་འདུས་པའི་རྐྱེན་རྣམས་ལ་ཡང་རང་བཞིན་གྱིས་འཁར་གཞོང་ལ་རྒྱ་ཤུག་བརྟེན་པའི་ཚུལ་དུ་གནས་པ་མ་ཡིན་ཏེ་དེ་ཡོད་ན་དམིགས་སུ་རུང་བ་ལས་མ་དམིགས་པའི་ཕྱིར་དང་།",
    "འགྲོ་བ་འདི་དག་ཐམས་ཅད་ནི་རྟག་ཏུ་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་དང་མ་འགགས་པ་ཉིད་དང་བཟོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་འདས་པ་ཉིད་དོ།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "གར་ལ་ལྟ་བའི་ཁྲོད་ན་འདུག་པ་ཞིག།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག་ཤུན་པ་ཟོས་པས་མིས་ནི་བུ་རམ་རོ།",
    "སྤྱན་སྔ་བ་རུག་པ་ན་བཞུགས་ཙ་ན།",
    "ཇོ་བོའི་མདུན་ན་མཎྜལ་ཞིག་ཀྱང་གྲུབ་འདུག་པས།",
    "ཇི་ལྟ་ཇི་སྙེད་ཐམས་ཅད་མ་འདྲེས་པར་འབྱེད་པའི་ཤེས་རབ་ཏུ་འདུག་པའི་ཕྱིར་རོ།",
    "རྒྱས་པར་གཏན་ལ་དབབ་དགོས་པར་འདུག་ནའང་ཚིག་མངས་སུ་དོགས་པས་དེ་ཙམ་ལས་མ་སྨོས་སོ།",
    "དེ་རིང་སང་རང་འཆི་བར་ཐག་ཆོད་པ་ན།",
    "དོན་མེད་དུ་ཚེ་མང་བ་ཞིག་ནི་སྔར་འདས་འདུག་པ་དང་ལྷག་མ་ལའང་གཉིད་ཀྱིས་ཕྱེད་འདའ་ཞིང་།",
    "རང་ལ་གནོད་པ་དྲག་པོ་བྱེད་པའི་དགྲ་ཆེན་པོ་ས་ཞིག་དུས་འདི་ནས་འདིའི་བར་ལ་འོང་བར་ནི་ཐག་ཆོད་ལ།",
    "ཀ་མ་བ་ལ་དམིགས་པ་སྤོ་བར་ཞུས་ཙ་ན་སྔ་མ་སྐྱོར་སྐད།",
    "འཕྲོ་ནས་ཞུས་ཙ་ན་འཕྲོ་ཡེ་མ་ཐོད་པ་ཞེས་གསུང་ལོ།",
    "ལུས་སྦྲེབས་འདར་ཞིང་སྒུར་ནས་ཀུམ་ཀུམ་པོར་འདུག་པ།",
    "ཕྱི་མ་བྱ་སྙམ་འདུག་གམ་མི་འདུག་བརྟགས་ལ།",
    "སྔར་བྱས་སམ་ད་ལྟ་བྱེད་དམ་ཕྱི་མ་བྱ་སྙམ་འདུག་ན་དེར་འགྲོ་བ་ཡིན་པས།",
    "དེར་སྐྱེས་ན་དེ་ཙ་ན་ད་ཅི་ཙུག་བྱེད་ངས་ནུས་སམ་སྙམ་དུ་ཀླད་པ་ཚ་ཀམ་ཀམ་པའམ།",
    "ཐང་ལ་འདུག་པ་ཀོག་ཀོག་ལྡང་ཡིན་པ་ཚུགས་ཐབས་ཡེ་མེད་པ་བསམས་ལ་འཇིགས་ཤིང་སྐྲག་པའི་བློ་ཅི་སྐྱེ་བྱ་གསུང་ངོ།",
    "དེ་ནི་འཆག་འདུག་འགྲེང་ཞིང་གནས་པའི་ཚེ།",
    "ང་རང་ཤེས་ཟེར་ན།",
    "སྲོག་གཅོད་པ་བྱས་སམ་བྱེད་པའམ་བྱེད་པར་འགྱུར་བ་ལ་དགའ་ཞིང་རངས་པའི་སེམས་དང་ལྡན་པ་དང་རང་ཡང་བྱེད་ལ་གཞན་དེ་འཛིན་དུ་འཇུག་ཅིང་དེའི་བསྔགས་པ་བརྗོད་པ་དང་།",
    "དེ་བཞིན་དུ་ཐོབ་བྱ་མཆོག་དམན་ལ་དམིགས་པ་དང་རང་གཞན་གྱི་དོན་ལ་དམིགས་པ་ལ་སོགས་པའི་བསམ་པའི་ཁྱད་པར་དང་དེ་ཡང་ཤུགས་དྲག་ཞན་དང་རྒྱུན་རིང་ཐུང་སོགས་ཀྱི་སྒོ་ནས་ཤེས་པར་བྱའོ།",
    "རྨི་ལམ་དུ་བྱས་པ་དང་མ་ཤེས་པར་བྱས་པ་དང་བསམས་བཞིན་མིན་པར་བྱས་པ་དང་དྲག་པོ་མིན་ལ་རྒྱུན་ཆགས་མིན་པར་བྱས་པ་དང་ནོར་བར་བྱས་པ་དང་བརྗེད་པས་བྱས་པ་དང་མི་འདོད་བཞིན་དུ་བྱས་པ་དང་རང་བཞིན་གྱིས་ལུང་དུ་མ་བསྟན་པ་དང་འགྱོད་པས་བསལ་བ་དང་གཉེན་པོས་བསལ་བ་སྟེ།",
    "རབ་ཏུ་དོག་པ་མུན་གནག་ཐིབ་པོར་འདུག་པ་ཡི།",
    "ཧ་ཅང་རྒྱུག་པ་དང་མགྱོགས་པ་དང་མཆོང་བ་དང་རྐྱལ་བ་དང་མེའི་དྲུང་ན་འདུག་གམ་ཙོག་ཙོག་པུར་འདུག་ན་ཡང་མངལ་ན་གནས་པ་ལ་གནོད་པར་གསུངས་ཤིང་།",
    "རྒས་པ་ཁད་ཀྱིས་ཁད་ཀྱིས་འོང་བས་དྲག་དུས་གཅིག་ལ་འོང་ན་བསྲན་ཐབས་མེད་གསུང་ངོ།",
    "འགྲོ་འདུག་དང་ཉལ་བ་དང་བཟའ་བཏུང་དང་ཉི་མ་དང་གྲིབ་མ་བསྟེན་པ་སོགས་ཀྱང་ཇི་ཙམ་རིང་དུ་བསྟེན་པ་དེ་ཙམ་དུ་བདེ་བ་ཇེ་འཕེལ་དུ་འགྲོ་དགོས་པ་ལ།",
    "འཆག་པ་དང་འདུག་པ་དང་འགྲེང་བ་དང་ཉལ་བའི་སྤྱོད་ལམ་དག་ཀྱང་སོ་སོ་སོ་སོར་སྡུག་བསྔལ་བར་རིག་པར་བྱ་སྟེ།",
    "གལ་ཏེ་འཆག་པས་ཉི་མ་འདའ་བར་བྱེད་ཅིང་འགྲེང་བར་མི་བྱེད་འདུག་པར་མི་བྱེད་ཉལ་བར་མི་བྱེད་ན།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "ས་གསུམ་མི་རྟག་པ་ཉིད་ཀྱི་མེ་རབ་ཏུ་འབར་བ་ན་འདུག་པ་ནི་ཁྱིམ་རབ་ཏུ་འབར་བའི་ནང་དུ་ཆུད་པ་བཞིན་དུ་ངེས་པར་དེ་ལས་འདའ་བར་འདོད་ཅིང་།",
    "སིང་སྒྱུར་ལ་བཏབ་པའི་ཕྱེ་བཞིན་ཁ་ན་ཕར་ཡམ་མེ་བ་ཞིག་ལས་མི་འདུག་ན།",
    "པོ་ཏོ་བའི་ཞལ་ནས་ཀྱང་སྔར་དེ་ཙམ་ཞིག་འཁྱམས་པ་ལ་རང་ལོག་མ་བྱུང་ཙ་ན།",
    "ད་ཡང་རང་ལོག་མི་འོང་བས་བཟློག་དགོས།",
    "མུ་གེ་བྱུང་ཙ་ན་ཐམས་ཅད་ནས་ཀྱི་སྟེང་དུ་འོང་།",
    "དེ་ལྟར་མིན་པར་དང་བོར་བྱུང་ཙ་ན་དང་དུ་ལེན།",
    "འདུག་ས་སྤོས་པ་དང་སྐེ་ཅུ་ཅུ་བྱས་པ་ཙམ་གྱིས་ཀྱང་ཉལ་གྱིས་འགྲོ་གསུང་སྟེ།",
    "ཤིན་ཏུ་རྙེད་སླའི་ཚྭ་ཁམ་འགའ་ལྟ་ཕྱུགས་ཀྱང་རང་ཉིད་ཟ།",
    "རང་ལ་གཅེས་པར་འཛིན་པ་དང་གཞན་ཡལ་བར་འདོར་བའི་བློ་གཉིས་གོ་ས་བརྗེས་ཏེ་གཞན་ལ་རང་ལྟར་གཅེས་པར་འཛིན་ཅིང་རང་ལ་གཞན་ལྟར་ཡལ་བར་འདོར་བའི་བློ་སྐྱེད་པའོ།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "དེ་ནས་བསམ་ཡས་སུ་ཕེབས་པ་ན་དེ་ལ་ལོ་ཙྪ་བས་སྣོན་པ་ཞུས་ནས་རྒྱས་སུ་བཏང་ཟེར་བ་འདུག་པས་ཇོ་བོས་འགྲེལ་བ་བསྡུས་པ་ཞིག་མཛད་པ་ལ།",
    "སྐྱེ་བོ་རྣམས་བདེ་བས་ཕོངས་པ་དང་སྲེད་པའི་མེས་ཚིག་པ་དང་སྡུག་བསྔལ་སེལ་བའི་མཐུ་མེད་པ་དང་རང་བཞིན་གྱིས་སྡུག་བསྔལ་བར་མཐོང་བའི་ཕྱིར་རོ།",
    "སློང་བ་པོའི་ལོག་སྒྲུབ་སྣ་ཚོགས་ཀྱིས་སྐྱོ་བ་མེད་པ་དང་རང་སླུ་བ་ལ་སོགས་པའི་སློང་བ་པོའི་སྐྱོན་མཐོང་ཡང་གཞན་ལ་སྒྲོག་པའི་བསམ་པ་མེད་པ་དང་།",
    "གཞན་ལ་གནོད་པར་འགྱུར་བའི་ཐབས་ཀྱིས་སྦྱིན་པ་གཏོང་བ་དང་རང་ཉིད་སྙོམ་ལས་སུ་བསྡད་དེ་གཞན་ལ་བྱེད་དུ་འཇུག་པ་དང་སློང་བ་ལ་སྨོད་པས་འཕྱ་བ་དང་ཟུར་གྱིས་སྨོད་པའི་བསྟིང་བ་དང་ངག་རྩུབ་པོས་སྤ་བཀོང་བར་བྱས་ནས་སྟེར་བ་དང་།",
    "འོ་སྐོལ་ལ་འགབ་མ་མང་དྲགས་ཟེར་ནས་མིས་སྨྲ་ཡིན་འདུག་བྱས་པས།",
    "དགྲ་རྒྱུད་པ་ལ་དགའ་བ་དང་བརླག་ན་སྙམ་པའི་བསམ་པ་ངན་པ་རྣམས་ཀྱང་དེ་ཙམ་གྱིས་དགྲ་ལ་མི་གནོད་པས་རང་སྡུག་བསྔལ་བ་ཙམ་དུ་ཟད་ལ་གནོད་ནའང་རང་གཞན་ཕུང་བར་འགྱུར་བའི་ཉེས་དམིགས་བསམས་ནས་རྣམ་པ་ཐམས་ཅད་དུ་དགག་པར་བྱ་སྟེ།",
    "སྡུག་བསྔལ་བྱུང་བ་དེ་སླར་བཅོས་སུ་འདུག་ན་ནི་ཡིད་མི་དགའ་བ་བྱ་མི་དགོས་ལ།",
    "འཆག་པ་དང་འགྲེང་བ་དང་འདུག་པ་དང་ཉལ་བ་ནི་སྤྱོད་ལམ་བཞི་ཡིན་ལ།",
    "བདག་ཉིད་ཀྱང་ནི་ཇི་ལྟར་འདུག།",
    "དེ་དགོས་པར་འདུག་སྙམ་དུ་མི་འགྲུབ་པ་འདི་ནི་ཉམས་ལེན་གྱི་ཚེ་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱི་དཔྱད་སྒོམ་དགོས་པ་ལ་ངེས་པ་མ་རྙེད་ཅིང་།",
    "དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ།",
    "ལུས་ནི་ཧ་ཅང་ཡང་རྒྱབ་ཏུ་མི་དགྱེ་ཧ་ཅང་ཡང་མདུན་དུ་མི་དགུ་བར་དྲང་བོར་བསྲངས་ལ་དྲན་པ་ནང་དུ་བཞག་སྟེ་འདུག་པར་བྱའོ།",
    "འདུག་པས་དུས་ཡུན་རིང་པོ་འདའ་བར་བྱེད་ནུས་ཤིང་སྤྱོད་ལམ་དེས་དེའི་ལུས་ཤིན་ཏུ་ངལ་བར་མི་འགྱུར་བ་དང་།",
    "གཞན་གྱིས་སྤྱོད་ལམ་དེས་འདུག་པ་མཐོང་ན་ཤིན་ཏུ་དང་བ་སྐྱེ་བ་དང་།",
    "དམིགས་པ་གང་འདུག་ཚད་ལ་བྱ་བར་སྟོན་པ་མིན་ནོ།",
    "དེ་ཡང་གསར་དུ་བློས་བསྐྱེད་པ་དང་རང་བཞིན་གྱིས་བཞུགས་པ་གསལ་འདེབས་པ་གཉིས་ལས།",
    "གཏི་མུག་སྤྱོད་པ་དང་གཉིད་ཆེ་བ་དང་ཐབས་མི་ཤེས་པ་དང་ལེ་ལོ་དང་ལྡན་པའི་འདུན་པ་དང་བརྩོན་འགྲུས་དང་སེམས་དང་དཔྱོད་པ་དང་ཞི་གནས་ལ་གོམས་པ་དང་ཞི་གནས་ཡོངས་སུ་བྱང་བར་མ་བྱས་པའི་ཞི་གནས་ཀྱི་ཕྱོགས་གཅིག་ཡིད་ལ་བྱེད་པ་དང་སེམས་མུན་པ་ལྟ་བུར་འདུག་པ་དང་དམིགས་པ་ལ་གཏོད་པར་མི་དགའ་བའོ།",
    "དེ་ནང་དུ་ཡང་དག་འཇོག་ལ་འདུག་སྟེ།",
    "འདི་རྣམས་བསམ་གཏན་པ་ཁ་ཅིག་ལ་ནི་མིང་ཙམ་ཡང་མི་འདུག་ལ།",
    "བདག་ལ་རང་བཞིན་མེད་པར་རྟོགས་པ་ན་དེའི་ཡན་ལག་ཏུ་གྱུར་པའི་ཕུང་པོ་རྣམས་ལའང་རང་བཞིན་ཡོད་པར་འཛིན་པ་ལྡོག་པར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "ཕུང་པོའང་རང་བཞིན་མེད་པར་རྟོགས་པར་གསུངས་སོ།",
    "རྒྱུན་ཡང་རང་བཞིན་མེད་པར་འདོད་ན།",
    "གང་ཟག་འདི་མི་འདུག་སྙམ་དུ་ངེས་པ་ལ་མེད་རྒྱུའི་གང་ཟག་དེ་ཤེས་དགོས་པ་ལྟར།",
    "བདག་མེད་པ་དང་རང་བཞིན་མེད་པ་ཞེས་པའི་དོན་ངེས་པ་ལའང་མེད་རྒྱུའི་བདག་དང་རང་བཞིན་དེ་ལེགས་པར་ངོས་ཟིན་དགོས་ཏེ།",
    "ཞེས་ཚིག་ལ་རང་བཞིན་མེད་ན་རང་བཞིན་འགོག་པ་དང་རང་བཞིན་མེད་པ་སྒྲུབ་པར་མི་ནུས་སོ་ཞེས་རང་བཞིན་མེད་ན་བསྐྱེད་བྱ་སྐྱེད་བྱེད་དང་འགོག་པ་དང་སྒྲུབ་པའི་བྱ་བྱེད་མ་འཐད་དོ་སྙམ་ནས་རྩོད་པ་བྱེད་དོ།",
    "རབ་བྱེད་ཉེར་བཞི་པ་འཕགས་པའི་བདེན་པ་བརྟག་པས་རང་བཞིན་གྱིས་མི་སྟོང་པ་ལ་འབྱུང་འཇིག་སོགས་འཁོར་འདས་ཀྱི་རྣམ་གཞག་ཐམས་ཅད་མི་རུང་བའི་ཚུལ་དང་རང་བཞིན་གྱིས་སྟོང་པ་ལ་དེ་དག་ཐམས་ཅད་རུང་བའི་ཚུལ་རྒྱས་པར་གཏན་ལ་ཕབ་པས་ན།",
    "དེ་ནས་དཔྱོད་མཁན་ལའང་དེ་ལྟར་དཔྱད་པ་ན་དཔྱོད་མཁན་ཡང་མི་འདུག་གོ་སྙམ་དུ་ངེས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་རང་བཞིན་འགོག་པའི་རིགས་པས་ཐ་སྙད་དུའང་རང་བཞིན་དེ་དགག་དགོས་པའི་ཕྱིར་དང་།",
    "རྩ་བར་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་ཕྱོགས་ལ་དེ་དག་རུང་བ་དང་མི་སྟོང་པའི་ཕྱོགས་ལ་མི་རུང་བར་ལེགས་པར་ཕྱེ་ནས་གསུངས་པའི་ཕྱིར་དང་།",
    "ཅི་སྟེ་རང་བཞིན་མེད་པ་རྣམས་ལ་བྱ་བ་བྱེད་པ་མི་འཐད་པའི་ཕྱིར་ཉེས་པ་སོ་ན་འདུག་པ་ཉིད་དོ་སྙམ་ན།",
    "དེའི་ལན་དུ་རྒྱུས་འབྲས་བུ་སྐྱེད་པ་སོགས་ཀྱི་བྱ་བྱེད་རྣམས་རང་བཞིན་ཡོད་པ་ལ་མི་རུང་བ་དང་རང་བཞིན་མེད་པ་ཁོ་ན་ལ་དེ་དག་རུང་བར་གསུངས་སོ།",
    "དེ་ལྟར་ན་རང་བཞིན་ཡོད་མེད་དང་ཡོད་མེད་བཞི་བོ་དེ་ཕྱེད་ན་ལོག་རྟོག་དཔག་ཏུ་མེད་པ་ལྡོག་པར་འགྱུར་ཞིང་རང་བཞིན་ཡོད་པ་འགོག་པའི་རིགས་པ་རྣམས་ལ་ཡོད་པ་ཙམ་འགོག་པར་འཁྲུལ་བ་མི་སྐྱེ་བས།",
    "རིགས་པ་ནི་རང་བཞིན་ཡོད་མེད་འཚོལ་བ་ཡིན་པས་དེས་བཀག་པའང་རང་བཞིན་བཀག་ཅེས་པའི་དོན་ཡིན་པས་འདི་གཉིས་ཕྱེད་པར་བྱའོ།",
    "དེ་ཁོ་ན་ཉིད་ལའང་རང་བཞིན་ཡོད་མེད་ཚུལ་བཞིན་དུ་དཔྱོད་པའི་རིགས་པས་གནོད་པ་མི་འབབ་པ་ཞིག་ནི་ཐ་སྙད་དུ་ཡོད་པར་འདོད་ལ།",
    "རྒོལ་ཕྱི་རྒོལ་གྱི་རྒྱུད་ཀྱི་མ་དཔྱད་པའི་བློའི་འཇུག་ཚུལ་ལ་ཇི་ལྟར་འདུག་བལྟས་པས་ཆོག་པ་ཡིན་ནོ།",
    "རང་བཞིན་གྱིས་མ་སྐྱེས་ཞེས་བརྗོད་པའི་རང་བཞིན་ཞེས་པ་དེ་མ་ཐོས་པར་མ་སྐྱེས་པར་བཟུང་འདུག་པ་ལ་དགོངས་ནས་རྣ་བ་མེད་པ་དང་།",
    "ཞེས་པའི་སྟོང་པ་ཉིད་དུ་ལྟ་བ་ཞེས་པའང་རང་བཞིན་གྱིས་སྟོང་ངོ་སྙམ་དུ་ལྟ་བ་ལ་མི་ཟེར་གྱི།",
    "ཕུང་པོ་ལྔ་བོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "འོན་ཀྱང་རང་བཞིན་མེད་པ་ལ་དངོས་པོ་རྣམས་རང་བཞིན་མེད་པའོ་ཞེས་གོ་བར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལ་རང་བཞིན་ཡོད་པ་མ་ཡིན་ན་ཚིག་མེད་པའང་ཚིག་མ་གཏོགས་པར་ཡང་རང་བཞིན་ཡོད་པ་མ་ཡིན་པར་རབ་ཏུ་གྲུབ་པ་ཡིན་ན།",
    "ཞེས་བརྫུན་པ་སྒྱུ་མ་ལྟ་བུའི་སྐྱེ་བ་མི་འགོག་པ་དང་བདེན་པའི་སྐྱེ་བ་འགོག་པས་བརྟེན་ནས་སྐྱེས་པ་དང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་གཉིས་མི་འགལ་བར་གསུངས་ཏེ།",
    "ཞེས་སྨྲས་པ་དེའི་ཚེ་རྒོལ་བའི་གོ་སྐབས་ག་ལ་ཡོད་ཅེས་བརྟེན་ནས་སྐྱེས་པ་དང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་འགལ་བར་བརྩད་པའི་ལན་དུ་གསུངས་སོ་ འཇུག་པ་ལས་ཀྱང་།",
    "དེ་འོན་ཀྱང་རང་བཞིན་མེད་པའི་དམ་བཅའ་ཡོད་ན་རང་རྒྱུད་པར་འགྱུར་རོ་ཞེས་པའི་དོགས་པ་སྐྱེ་བ་ནི་ཤིན་ཏུ་བདེན་པ་ཞིག་སྟེ།",
    "ཚིག་གསལ་ལས་རང་ལ་དམ་བཅའ་བ་མེད་པའི་ཕྱིར་རོ་ཞེས་གསུངས་པའང་རང་ལུགས་མེད་པའི་ཁུངས་མ་ཡིན་ཏེ།",
    "ཚོར་བ་དེ་ཡང་རང་བཞིན་གྱིས།",
    "དེ་འདྲ་དེ་འདོད་ན་དེ་ལ་དངོས་པོ་སྟོབས་ཞུགས་ཀྱི་རྟགས་ཀྱི་ཐ་སྙད་མི་སྦྱོར་དུ་ཆུག་ཀྱང་རང་རྒྱུད་ཀྱི་རྟགས་ཡིན་པ་བཟློག་ཏུ་མེད་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་གྱིས་སྟོང་པར་སྨྲ་བ་དང་རང་བཞིན་གྱིས་མི་སྟོང་པར་སྨྲ་བ་གཉིས་ཀྱི་ལུགས་ལ་མ་འཁྲུལ་བའི་ཤེས་པས་གྲུབ་པའང་མ་ཡིན།",
    "ཆུ་ལ་སོགས་པ་གསུམ་པོ་དེ་ལ་རླན་ལ་སོགས་པ་གསུམ་པོ་དེ་དམིགས་པ་ལ་ལྟོས་དགོས་པར་མཐོང་ཞིང་ཁྱེད་རང་ཡང་འདོད་པ་དེ་བཞིན་དུ།",
    "མིག་ལ་ལྟ་བའི་རང་བཞིན་ཁས་ལེན་ནའང་རང་ལ་མི་ལྟ་ན་གཞན་ལ་ཡང་མི་ལྟ་བར་འདོད་དགོས་པས་སྐྱོན་སྔ་མ་མི་གཡོའོ།",
    "དེ་ཡང་རང་ཉིད་ལ་གྲུབ་པའི་གཏན་ཚིགས་ཉིད་ཀྱིས་ཡིན་གྱི།",
    "ཤིང་རྟ་ནི་ཡན་ལག་དེ་དག་དང་རང་བཞིན་གཅིག་མ་ཡིན་ཏེ།",
    "བདག་ཕུང་པོ་རྣམས་དང་རང་བཞིན་གཅིག་ཏུ་གྲུབ་ན་གང་ཟག་གཅིག་ལ་ཡང་ཕུང་པོ་དུ་མ་ཡོད་པ་བཞིན་དུ་བདག་ཀྱང་མང་པོ་ཡོད་པར་འགྱུར་ལ།་",
    "དེ་དག་ལ་གནོད་པ་མཐོང་བའི་ཚེ་གང་ཟག་ལ་སོགས་པ་ནི་ཡེ་མི་འདུག་གོ་སྙམ་པ་དང་།",
    "མྱུ་གུ་ལ་རང་བཞིན་མེད་པ་དེར་བདེན་སྙམ་པ་དང་རང་བཞིན་གྱིས་སྟོང་པའི་སྣང་བ་སྒྱུ་མ་ལྟ་བུར་བདེན་སྙམ་ན་རིགས་པས་དགག་དགོས་པའི་འཛིན་པ་སྐྱོན་ཅན་ཡིན་གྱི།",
    "གཞན་ཡང་ཡུལ་དཔྱད་དེ་རིགས་པས་གསིལ་བ་ན་མི་འདུག་སྙམ་པ་དང་བོར་འབྱུང་ཞིང་།",
    "དཔེ་དེ་དག་ཀྱང་རང་བཞིན་མེད་པར་རྟགས་ལ་བརྟེན་ནས་རྟོགས་དགོས་ན།",
    "དེ་ཡང་རང་རྒྱུད་ལ་ཡོད་པར་མྱོང་བས་འགྲུབ་བོ།",
    "དེ་ལྟ་ཡིན་ནའང་རང་བཞིན་མེད་པའི་དཔེར་རུང་ལུགས་ནི་གང་དུ་སྣང་བ་དེའི་ངོ་བོས་སྟོང་ཕས།",
    "ཇི་ལྟར་མི་དག་ནགས་རིའི་ཁྲོད་འདུག་ནས།",
    "དེ་ལྟར་ན་བདག་ལྟ་བུ་གཅིག་ལ་ཇི་ལྟར་དཔྱད་པས་རང་བཞིན་གྱིས་སྟོང་བ་དང་རང་བཞིན་མེད་པ་ལ་བྱ་བྱེད་འཐད་པའི་བདེན་གཉིས་ཀྱི་འཇོག་ཚུལ་ཤེས་ན།",
    "བདག་སྐྱེ་དང་རང་བཞིན་ཐ་དད་པའི་སྐྱེ་བ་ནི་གཞན་སྐྱེ་ཡིན་པས།",
    "ཁྱེད་རང་དེ་ངེས་དོན་གྱི་ལྟ་བར་འདོད་པའི་ཕྱིར་རོ།",
    "གཡུལ་འགྱེད་པའི་ཚེ་མིག་ཕྱེ་ནས་དགྲ་གང་ན་འདུག་ལེགས་པར་བལྟས་ཏེ།",
    "སྦྲུལ་མ་ཡིན་པར་འདུག་གོ་སྙམ་པའི་ངེས་པ་བསྐྱེད་ནམ་འཁྲུལ་བ་དང་སྐྲག་པའི་སྡུག་བསྔལ་དེ་ལྡོག་དགོས་པ་བཞིན་དུ།",
    "འདིར་ཡང་རང་བཞིན་མེད་པའི་ངེས་པ་ཇེ་འཕེལ་དུ་བརྟན་དགོས་ལ།",
    "ཕུང་པོ་ལྔ་བོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "དེ་ལྟར་བསྒོམས་པས་ཡུན་རིངས་མ་བསྒོམས་སྙམ་ནས་བལྟས་ཙ་ན་ནམ་དང་ཉི་མ་འུད་འུད་བཅད་ནས་སྣང་ན་སེམས་ཟིན་པ་ཡིན་ལ།",
    "ཇི་ལྟར་སྲང་མདའི་མཐོན་དམན་དག་དུས་གཅིག་ཉིད་དུ་མཐོང་བ་དེ་བཞིན་དུ་ས་བོན་འགག་བཞིན་པ་ན་མྱུ་གུ་སྐྱེ་བར་འགྱུར་ཞེས་པེ།",
    "མཐོན་དམན་གྱི་བྱ་བ་དག་དུས་གཅིག་པ་ཉིད་ཡོད་ཀྱི་ས་བོན་དང་མྱུ་གུ་ད་ལྟར་བ་དང་མ་འོངས་པ་དག་ལ་ནི་དུས་གཅིག་མེད་པས་འདི་ནི་སྲང་དང་མཚུངས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་བྱ་བ་དག་དུས་གཅིག་པ་ཉིད་དུ་མི་རིགས་པ་ཁོ་ནའོ།",
    "ཀུན་རྫོབ་དེས་གང་ཞིག་བདེན་པར་སྣང་ཞིང་རང་བཞིན་མེད་བཞིན་དུ་རང་བཞིན་དུ་སོ་སོར་སྣང་བ་དེ་ནི་འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་ཀུན་རྫོབ་ཏུ་བདེན་པས་འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་སྟེ།",
    "དེའི་ཕྱིར་ཡོད་པར་དམིགས་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་དོ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར་།",
    "དོན་དམ་པ་དང་ཀུན་རྫོབ་ཀྱི་བདེན་པ་གཉིས་ཆར་དུ་ཡང་རང་བཞིན་ཏེ་ངོ་བོ་ཉིད་མེད་པའི་ཕྱིར་རྟག་པ་དང་ཆད་པ་མེད་པ་ཉིད་དོ།",
    "དེ་ཕྱིར་དེ་ལྟར་བདེན་པ་གཉིས་ཀར་ཡང་རང་བཞིན་མེད་པས་རྟག་པ་དང་ཆད་པར་ལྟ་བ་རྒྱང་རིང་དུ་སྤངས་པ་འགའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པའི།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་འབྱུང་གཉིས།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པ་ནི་ཡོད་པ་ཡིན་ནོ།",
    "འདི་ལས་ཀྱང་རང་རིག་པ་ཡོད་པ་མ་ཡིན་པས་དེ་ཉིད་ཀྱིས་དེ་འཛིན་པ་མ་ཡིན་ནོ།",
    "གང་སྤྱོད་དེ་ཡང་རང་བཞིན་སྟོང་པ་སྟེ་།",
    "གང་ཚེ་དེ་སྐད་སྨྲ་ཞིང་རང་ཕྱོགས་ཁོ་ན་རྣམས་འཇོམས་པ་།",
    "རང་རང་བསམ་པ་མཚོན་པའི་སླད་དུ་འདེགས།",
    "རང་རང་བསམ་ཚུལ་ལྷུག་ལྷུག་གསོལ།",
    "རང་རང་མགྲིན་གླུ་བླངས་ཤིང་གར་སྟབས་མཛེས།",
