    "སྤྲ་བའམ་སྤྲུ་རྩའི་བྲལ་བྲུལ་ཞེས་རྨ་ནང་དུ་མར་ཁུ་ལ་བཙོས་ལ་བརྫང་ཁྲག་འཆོར་བའི་རྩ་སྣེ་ཏེལ་པས་བསྲེག་ཀླད་རྒྱའི་དར་ཐོག་ཏུ་རྣག་ཤོར་འདུག་ན་འགྱངས་པའི་ལོང་མེད་པས་དེ་ཡི་ཉིན་པར་ཐོད་པ་ལ་གསིང་བུག་ཅི་ཐོན་བྱ།",
    "རྒུ་དྲུས་ནི་རྒུན་འབྲུམ་ཟེར་བའང་འདུག་གང་གཟེར་གྱི་རྩ་སྟེང་མེས་མནན།",
    "རྨ་ཁང་གཉིས་ཀར་ཁད་པུ་གཞུག་ཅེས་རྩ་ནང་དང་རྩ་སྣེའི་ཁྲག་ཐམས་ཅད་གར་པོ་བྱེད་པ་ཁང་སུ་གཞུག་ལེབ་རྒན་རྩི་ནི་འདི་རྒྱ་གར་ན་ཡོད་པ་བོད་དུ་མི་འདུག་ཀྱང་བལ་པོ་གུར་གུམ་ཚབ་རུང་ལ་ལས་སྔོ་སྣེའུ་རྒྱབ་དམར་སོགས་ལ་བྱེད་པ་རྣམ་པར་འཁྱམས་སོ།",
    "ཁྲག་དུས་སྐེམས་དང་འདྲ་སྟེ་འོག་ཏུ་བཏོན་ནོ།",
    "ཉི་མ་ལྔ་ཞེས་བསྐལ་པ་འཇིག་དུས་ད་ལྟའི་ཉི་མ་འགྱུར་གྱིས་ཚ་བ་ཤར་བས་རྒྱ་མཚོ་སྐེམ་པའི་དཔེ་དང་།",
    "སྣོད་ཕུག་ན་འཚེབས་པ་མེད་ན་རྨ་དེ་ཉིད་ཁ་བསྲེག་འཚེབས་ན་མདེའུ་སླེབ་མཚམས་ཀྱི་ཕུག་ཐམས་ཅད་རྨ་ཡི་སྟེང་དུ་བསྲེག་སོ་ཆ་སྤྱང་ཚེར་དུས་གསུམ་ཞེས་ཁྲག་དུས་སུ་ཆང་།",
    "རྨ་གསར་པ་ལ་མདའ་ཕོག་དུས་ཀྱི་ལུགས་གང་ཡོད་ལྟར་བསྡད།",
    "སྡོང་པོ་དཀར་ཞིང་ཕྲ་བར་འདུག།",
    "གར་འདུག་དེའི་སྟེང་དུ་མེ་ཏོག་སྣ་ཚོགས་ཀྱི་ལུམ་བྱ།",
    "ཡང་ན་དྲི་ཆུ་དེ་སྔ་མ་བས་ཁ་དོག་དྭངས་ཤིང་ཀུ་ཡ་སངས་འདུག་ན་དུག་ཏུ་ངེས་པ་ཡིན།",
    "བསིལ་གྲིབ་སྙེག་ནི་དེ་རྣམས་སུ་ཡུན་རིང་འདུག་མི་ཚུགས།",
    "རྒྱ་སྣེའི་སྦྱོར་བ་ཞེས་རྒྱ་སྣེ་ལ་འདོད་ལུགས་འགའ་ཞིག་ཡོད་ཀྱང་རང་ལུགས་སྔོ་སྣེའུ་སྒོ་བཟང་ཞིང་ལོ་མ་ཆེ་བ་དང་རྒྱ་སྣེ་དང་སྒོ་ངན་ལ་ལོ་མ་ཆུང་བ་བོད་སྣེ་ཡིན།",
    "གལ་ཏེ་རིན་ཆེན་དང་ཤ་དང་དུག་དངོས་སོགས་འདྲེས་ནས་སྦྱར་བ་འདུག་ནའང་།",
    "ཤིང་མངར་ཐང་ལ་དོམ་མཁྲིས་བཏང་པར་གཞུང་ཚིག་འདི་གཉིས་ཆད་འདུག་པ་བྲིས་མ་རྙིང་པ་འགའ་ཞིག་ཏུ་འདུག་པས་བཅུག་པ་ཡིན་ནོ།",
    "འབྲུ་མར་ནི་འོ་མ་ཟེར་བའང་འདུག་ཕོ་གྲང་ནི་གྲང་རྟགས་སྟོན།",
    "བེ་རོ་ཙ་ན་ཞེས་རྣམ་པར་སྣང་མཛད།",
    "གདོས་ཐག་ཆོད་པ་ནི་ལོས་ཡིན།",
    "སླར་ཡང་རང་བཙན་དག་སྐྱེལ།",
    "བོད་ཀྱི་རིག་གཞུང་བཅས་ངོ་སྤྲོད་གནང་འདུག་",
    "མ་མཐར་ཡང་དུས་སྐབས་གཅིག་ལ་རྒྱལ་ཚབ་ཀྱི་ལེ་ཐོགས་ཡོད་པ་ར་འཕྲོད་བྱུང་འདུག།",
    "དེ་ཡང་གོང་མས་སྲོལ་གཏོད་བྱས་པའི་ལམ་སྲོལ་དེ་བརྩི་མེད་བཏང་སྟེ་སྔར་སྲོལ་ལྟར་བྱས་འདུག་༣།",
    "མན་ཇུས་བོད་ཀྱི་ལས་དོན་ཐོག་ཐེ་བྱུས་ཇི་འདྲ་ཞིག་བྱས་ཀྱང་བོད་པའི་བློན་ཆེན་ནམ་བཀའ་བློན་རྣམས་ནས་བཟོད་སྒོམ་བྱེད་ཀྱི་མི་འདུག་ཅེས་མཐའ་སྡོམ་གནང་འདུག།",
    "དམིགས་བསལ་ཡོང་ཐབས་ལ་རོགས་རམ་བྱེད་འདོད་ཀྱི་སེམས་འཁུར་བྱས་མི་འདུག་དེ་ལྟ་ནའང་བྱུས་ཉེས་ཆེ་བའི་ཉལ་ཐའི་དམག་འཁྲུད་དང་།",
    "དངོས་དོན་དུའང་དེ་ལྟར་བྱས་འདུག་དེ་ནས་ལོ་ཤས་རྗེས།",
    "དེའི་ཁར་ཆིངས་ཡིག་འདིས་བོད་དང་འབྲས་ལྗོངས་དབར་གྱི་ས་མཚམས་ཀྱང་དབྱེ་འབྱེད་བྱས་འདུག་དེ་རྗེས་ལོ་གསུམ་ཙམ་གྱི་རྗེས་སུ་བོད་དང་འབྲས་ལྗོངས་དབར་གྱི་ཆིངས་ཡིག་སྔར་ཡོད་ཐོག་ཚོང་དོན་དང་།",
    "ཕིའོ་ཌོ་རོབ་ན་ནས་ཀྱང་སྣེ་ལེན་གནང་འདུགདོན་གཅོད་པ་རྣམས་རུ་སུའི་ཕྱི་སྲིད་བློན་ཆེན་གྱི་སར་ངོ་ཕེབས་གནང་སྐོར་གྱི་གནས་ཚུལ་ཡང་ཐོན།",
    "རང་ཉིད་ནས་ཀྱང་བོད་མིའི་དཔོན་རིགས་ཚོ་དང་ཐད་ཀའི་འབྲེལ་པ་གང་ཡང་བྱེད་མ་ཐུབ་པ་བཅས་ལ་བློ་ཚབས་ཅི་ཆེ་བྱུང་འདུག་༤༨མན་ཇུའི་དཔོན་རིགས་ཁག་བརྒྱུད་བོད་དང་འབྲེལ་བ་བྱ་རྒྱུ་དེ་ཆེས་ཁ་སྐྱེངས་པོ་དང་ཡོངས་གྲགས་སུ་བཞད་གད་ཀྱི་གནས་ཤིག་ཡིན་པར་ཐག་བཅད་དེ་ཀར་ཛོན་གྱིས་རང་ཉིད་རྒྱ་གར་དུ་འབྱོར་པ་ནས་བཟུང་ལྷ་ས་དང་འབྲེལ་ལམ་གཏོད་རྒྱུའི་འབད་བརྩོན་བྱེད་འགོ་བརྩམས།",
    "ཏོང་གནང་མཛད་འདུག་ཀྱང་།",
    "ཆིངས་ཡིག་དེ་བཞག་ཟིན་པའི་རྗེས་སུ་དབྱིན་ཇིའི་དཔུང་དམག་རྣམས་ཕྱིར་འཐེན་བྱས་འདུག།",
    "ཅེས་མཛུབ་སྟོན་བྱས་འདུག་༦།",
    "ཁོ་ཚོ་ངོ་ཚ་ཁ་སྐྱེངས་བྱུང་སྟབས་དབྱིན་ཇིར་ཐོབ་པའི་ཁེ་ཕན་རྣམས་ཁ་ཕྱོགས་བསྒྱུར་རྒྱུར་སེམས་ཐག་བཅད་འདུག་།",
    "རུ་སུ་གཉིས་ནས་དངོས་སུ་ངོས་འཛིན་བྱས་འདུག་དབྱིན་རུ་གཉིས་ནས་བཞག་པའི་ཆིངས་ཡིག་དེའི་འཕྲལ་མར་བྱུང་བའི་འབྲས་བུ་ནི་དབྱིན་ཇིས་ཐོག་མར་བོད་མི་རྣམས་ཕམ་ཉེས་བཏང་བ་དང་།",
    "དེ་འཕྲལ་ཤར་ཕྱོགས་བོད་དམག་ཚོས་ཁོ་པ་འདི་ཕྱོགས་མདུན་སྐྱོད་བྱེད་རྒྱུར་སེམས་ཐག་གཙང་བཅད་ཀྱི་སྒོ་ནས་གདོང་ལེན་བྱེད་དགོས་པའི་བཀའ་ཁྱབ་བཏང་འདུག།",
    "དབྱིན་ཇི་དང་རྒྱ་གར་གཞུང་གཉིས་ལ་ཐག་གཅོད་ཆེད་འདྲི་བསྟུན་དགོས་པ་ཡིན་ ཞེས་གསལ་འདུག།",
    "དམག་སྐུལ་ཕྱིར་བསྡུ་བནང་རྒྱུ་བཅས་ལ་ཁས་ལེན་གནང་འདུག།",
    "སྔ་ས་ད་གནས་ཀྱི་གནས་སྟངས་ལ་བློ་བུར་དྲག་རྩུབ་ཀྱི་ལམ་ནས་འགྱུར་ལྡོག་བྱུང་བ་དེས་རྒྱ་གར་ནང་བློ་ཚབས་བྱེད་དགོས་པ་བྱུང་འདུག་དེ་ལྟ་ནའང་དབྱིན་ཇིའི་བྱེད་ཕྱོགས་དེ་ཧ་ལས་དགོས་པའི་སྣང་མེད་དང་ངེས་གསལ་མེད་པ་ལྟ་བུར་གནས།",
    "སླར་ཡང་རང་བཙན་དག་སྐྱེལ།",
    "ཨལ་ཐན་རྒྱལ་པོ་སོགས་སོག་དུས་དང་།",
    "བོད་ནང་མ་ཞེས་བོད་དེ་དུམ་བུ་གཉིས་སུ་དབྱེ་རྒྱུའི་གྲོས་འཆར་བཏོན་འདུགབོད་ཕྱི་མ་ཟེར་བ་རོབ་རྩིས་ཀྱིས་བོད་དབུས་དང་ནུབ་ཕྱོགས་དང་།",
    "རྒྱ་མི་གཉིས་ཀས་དབྱིན་ཇིའི་བྲོས་འཆར་དེར་དགག་པ་བརྒྱབ་འདུག།",
    "འོས་འཚམས་ཀྱི་དམག་མཁོའི་རོགས་རམ་ཡང་གནང་རྒྱུར་བློས་འགེལ་གནང་ཆོག་པ་ཡོད་༧༨ ཅེས་གཞུང་འབྲེལ་གྱི་ཁས་ལེན་གནང་འདུག།",
    "རྒྱ་ནག་ནང་ངོ་ལོག་ཚབས་ཆེན་བྱུང་རྐྱེན་འཆར་གཞི་འདི་དག་གནས་སྐབས་རིང་དོར་དགོས་བྱུང་འདུག་༣ ངོ་ལོག་ཟིང་འཁྲུག་ལྷིང་འཇགས་བྱུང་མཚམས་སྐྱར་དུ་བོད་ཐོག་དམིགས་བཀར་དོ་སྣང་བྱས་ཏེ།",
    "ཞེས་རྒྱ་ནག་བཞུང་ལ་བརྡ་ལན་སྤྲོད་རྒྱུར་ལོན་ཌོན་དུ་གྲོས་འཆར་བྱུང་འདུག་༣༣།",
    "ཚིག་ཅིབ་སྤྲད་འདུག་གནས་འབྲེལ་དེ་བཞིན་ལོན་ཌོན་དང་།",
    "དེ་བཞིན་དབྱིན་ཇིས་སྐབས་སྐབས་སུ་ལྷ་སར་དཔོན་རིགས་ཤིག་གཏོང་རྒྱུ་བཅས་ཀྱི་གྲོས་མཐུན་བྱུང་འདུག།",
    "རྒྱུའི་ཁས་ལེན་ཐོག་རྒྱ་མིར་སླར་ཡང་ལ་ཞེན་ཡོང་ཐབས་སུ་འབད་རྩོན་བྱ་རྒྱུར་ཐབ་བཅད་འདུག་༤༣ཅེས་གསལ།",
    "སྤྱོད་གཏོང་ཐབས་བྱས་འདུག་༤༧།",
    "ལས་དོན་གཞན་དག་ཡོད་པའི་ནང་ནས་མཁོ་རྫས་སྐྱེལ་ལམ་གསར་བཟོ་བྱ་རྒྱུར་ཤུགས་གནོན་བྱས་འདུག་ཀྱང་ཁོང་གསལ་འགོག་རྐྱེན་དེ་དག་ལ་བརྟེན་ནས་རྒྱ་ནག་དང་རྒྱ་གར་དབར་གྱི་ལམ་ཆེན་གྱི་འཆར་གཞི་དེ་གནས་སྐབས་རིང་ཅམ་འཇོག་བྱ་རྒྱུར་དབྱིན་རྒྱའི་འགོ་ཁྲིད་དབར་གྲོས་འཆམས་བྱུང་།",
    "དེར་བརྟེན་ཅང་རྩེ་ཧྲིས་རྒྱ་དམག་རྣམས་བོད་ཀྱི་ས་མཚམས་སུ་སྐྱོད་དགོས་པའི་བཀའ་བཏང་འདུག་མཁྲེགས་བཟུང་ཅན་གྱི་བོད་མིའི་ལངས་ཕྱོགས་དེ་ལ་ཁག་འདོགས་བྱས་ཏེ་རྒྱ་མིས་དྲག་པོའི་བཙན་འཛུལ་བྱེད་ཉེན་གྱི་འཇིགས་སྣང་དང་བཅས་དབྱིན་ཇིས་བཀའ་ཤག་ལ་བཀའ་ཁྱབ་དེ་དག་ཕྱིར་འཐེན་དགོས་པའི་སྐུལ་མ་བྱས་ཤིང་།",
    "གནས་སྐབས་རིང་དམག་དོན་ཡོ་བྱད་མིན་པའི་དངོས་རྫས་ཁག་རྒྱ་བར་ནས་རྒྱ་ནག་ཏུ་གནམ་ཐོག་འོར་འདྲེན་བྱས་འདུག་པ་དང་།",
    "དངོས་དོན་དུ་ཁོ་པས་བོད་གཞུང་དང་འབྲེལ་བ་ཞུ་སྐབས་ཁོ་པའི་སྐུ་ཚབ་དོན་གཅོད་ཁང་དུ་བཙུགས་པའི་གནས་རིམ་དམའ་བའི་བོད་མི་སྐད་སྒྱུར་ཞིག་བརྒྱུད་དེ་བྱེད་དགོས་བྱུང་འདུག་༤།",
    "སྐུ་ཚབ་དེས་ཀྱང་སོག་པོའི་གཞུང་དང་འབྲེལ་བ་རྒྱུན་བསྲིང་གནང་འདུག།",
    "ཕྱི་ལོ་༡༩༡༩ ལོར་རྒྱ་མིས་གཞུང་འབྲེལ་གྱི་ཐོག་ནས་བརྩི་མེད་བཏང་འདུག་བྷོལ་ཤེ་ཝིག་ཨུ་རུ་སུ་དམར་པོའི་གསར་བརྗེ་སྒེར་ལངས་ཀྱི་འཇིགས་སྣང་ལ་ཁག་བཏགས་ཏེ།",
    "ཚོང་འབྲེལ་འཕེལ་རྒྱས་གཏོང་རྒྱ་བཅས་ཀྱི་གྲོས་འཆར་བཏོན་འདུག་སོག་ཡུལ་དུ་གསར་བརྗེའི་ལས་འགུལ་དང་།"
  ]
}