    "རྒྱན་གཅིག་ལ་དཔེ་བརྗོད་གཉིས་མཛད་པ་ཡིན་པར་གཞུང་རང་ལས་ཀྱང་གསལ་ཞེས་སོགས་མང་དུ་གསུངས་སོ།",
    "དགྱེས་གླུ་ལས་འགྲེལ་བ་སྔ་མ་རྣམས་སུ་ལྡོག་པའི་ཕུལ་བྱུང་སོགས་མང་དུ་སྤྲོ་བའི་དཔེ་བརྗོད་མཛད་འདུག་ཀྱང་།",
    "ཅེས་གསལ་ཞིབ་ཏུ་གསུངས་འདུག་གོ།",
    "མངོན་ཤེས་དང་གྲུབ་རྟགས་སོགས་མི་འདུག་ཀྱང་།",
    "དཔེར་བརྗོད་སྔ་ཕྱི་འདི་གཉིས་ཀྱི་མིང་འདོགས་ཀྱང་བོད་འགྲེལ་རྣམས་སུ་སྔ་མ་ལ་དངོས་ཐོབ་ཀྱི་དགའ་བ་དང་ཕྱི་མ་ལ་གཟུགས་བརྙན་གྱི་དགའ་བ་ཞེས་འདོགས་པའང་འགྲེལ་ཚུལ་ཕྱིན་ཅི་ལོག་པའི་ཞེ་འདོད་དེ་ལ་བརྟེན་ནས་བཏགས་པར་འདུག་ཅེས་གསུངས་ཏེ།",
    "དཔེ་བརྗོད་གཅིག་ལ་ཤོ་ལོ་ཀ་གསུམ་དགོས་པས་ཧ་ཅང་ཡིག་ཚོགས་ཆེ་བའི་སྐྱོན་ཞིག་ཀྱང་རང་ཤུགས་ཀྱིས་འབབ་པོ།",
    "ཚེ་འདི་གང་སྐྱིད་ཕ་ཡུལ་བྱེད་པ་ཡི་འདུག་བདེ།",
    "ཞེས་མཁྱེན་རྩལ་རྫོགས་པའི་གསུང་ཞིག་གནང་འདུག་གོ།",
    "ཤར་ལྷོའི་བཞེད་པ་ངོས་འཛིན་དཀའ་བའི་སྐྱོན་ཞིག་ཀྱང་རང་ཤུགས་ཀྱིས་འབབ་བོ།",
    "ངས་སྒྲུང་གཏམ་ཀློག་དུས་འདི་ལྟར་བསམ་གྱིན་ཡོད།",
    "རང་ཉིད་ཀྱིས་རང་ཉིད་ལ་ཡིད་ཆེས་དང་རང་ཉིད་ཀྱིས་རང་ཉིད་ལ་བརྩི་བཀུར་ཤེས་རབ་ཀྱི་ཚོམས།",
    "ཁ་ག་ང་ཀློག་པའི་སྒྲ་དབྱངས་དེ་ད་དུང་ངའི་རྣ་ལམ་དུ་འཁོར་གྱིན་འདུག་ཟེར།",
    "ད་ཧོར་ཡུལ་འདི་རུ་འདུག་པ་ལས།",
    "ཞེས་བྲིས་འདུག་ངས་དེའི་ལན་དུ།",
    "ད་ལྟ་གཏམ་རྒྱུད་འདི་དགོད་བྲོ་བའི་གཏམ་ཞིག་ཏུ་གྱུར་འདུག་པ་སྨོས་མ་དགོས།",
    "ངས་སྒྲུང་གཏམ་ཀློག་དུས་འདི་ལྟར་བསམ་གྱིན་ཡོད།",
    "གལ་ཏེ་དེ་ལྟ་བུ་ལ་བསྙེག་ཐུབ་ན་སྒྱུ་རྩལ་ཅེས་པ་ཡང་རང་ཤུགས་ཀྱིས་ཐོན་འོང་ལ།",
    "ཞིབ་ཏུ་ལྟ་དུས་ངའི་བསམ་ཚུལ་དང་ཡོངས་སུ་འགལ་འདུགཁོས་བྲིས་པའི་སྒྲུང་གཏམ་ནི་ཆེད་དུ་སྦྱངས་པ་མ་ཡིན་ལ།",
    "ལ་ལས་ད་ལྟ་ལྷ་སའི་སྐད་དང་མཐུན་པའི་བརྡ་སྤྲོད་ཅིག་བཟོ་དགོས་ཞེས་སྐད་འབོད་ཀྱིན་འདུག་པ་ནི་བླུན་པོའི་རྟགས་ཤིག་ལས་མ་འདས།",
    "དེ་ནི་ང་རང་བོད་མི་རིགས་ལ་དགའ་བའི་རྐྱེན་གྱིས་ཡིན་པས་སོ།",
    "འཛུམ་གྱིས་ཁེངས་པའི་དེའི་བདག་པོ་ལ་ཞེ་འཁོན་གྱི་མེ་ལྕེ་མཆེད་ཀྱིན་འདུག་སྟེ།",
    "ང་རང་དྭ་ཕྲུག་ཅིག་ཡིན་ལ།",
    "དེ་བས་ང་རང་དཔྱིད་ཀ་ལ་དགའ་ལ་དཔྱིད་ཀའི་རོལ་དབྱངས་ལ་དགའ།",
    "ཕ་རོལ་ཟིལ་གནོན་པའི་སྤོབས་པས་ཁེངས་འདུག་ཅིང་།",
    "གཏམ་འདིས་ང་རང་ཧ་ལས་པར་གྱུར།",
    "ལྷག་པར་ང་རང་འཇིག་རྟེན་འདིར་ཆེས་མི་དགའ་བ་ནི་ཆང་འཐུང་ཡིན།",
    "ངའི་བསམ་ཚུལ་འདི་ཤེས་པས་ལོས་ཡིན།",
    "སྙན་ངག་པ་གངས་ཞུན་སྔར་བཞིན་ངའི་འདུག་གྲོགས་སུ་གྱུར།",
    "མིའི་རིན་ཆེན་སྣ་བདུན་གྱི་བང་མཛོད་ཅིག་ཏུ་གྱུར་འདུག་ཡིན་ན་ཡང་།",
    "ཁྱེད་ཀྱི་མིག་ཆུ་དེ་ངའི་སེམས་ཁོང་ནས་སྐྱོ་བས་བཞུར་གྱིན་འདུག་ངའི་གཉེན་ཉེ།",
    "ང་རང་ཉིད་ལ་ཡིད་ཆེས་ཡོད་ལ།",
    "དེ་བས་ཐབས་ལམ་གཞན་པ་ཞིག་འཚོལ་ཨེ་ཐུབ་སྙམ་ནས་ལྷ་སར་ཟླ་བཞིའི་རིང་འཕག་འཚག་བྱས་ཀྱང་འབྲས་བུ་མ་བྱུང་སྟབས་ཕྱིར་མཚོ་སྔོན་དུ་ལོག་སྐབས་དེར་ང་རང་ལ་ཡིད་ཆད་དང་སྐྱོ་སྣང་།",
    "བློ་ཕམ་ལས་ཅི་ཡང་མི་འདུག་ཡིན་ནའང་ང་རང་དཔའ་མ་ཞུམ་པར་ལ་འབྲེལ་གཏུག་བྱས་པས་ཁོ་ཚོས་ཁོ་ཚོ་ལ་མི་ཞིག་དགོས་ཟེར་བ་དང་ཁོ་ཚོ་ལ་དགོས་པའི་ཆ་རྐྱེན་དེ་བདག་ལ་ཡོངས་སུ་ཚང་བས་གནས་སྐབས་དང་ལེན་བྱས།",
    "ང་རང་ཧ་ལས་ནས་ཕྱིར་ལྟ་དུས།",
    "བརྩེ་བས་ཁེངས་འདུགསྐད་ཅིག་མ་དེར།",
    "པོ་ཏ་ལ་ཞེས་དགའ་འབོད་སྒྲོག་པའི་ངག་དེར་བརྩེ་སེམས་ཀྱིས་ཁྱབ་འདུག་པ་གང་ཡིན་ནམ།",
    "འཛམ་གླིང་དུ་སྐད་རིགས་ཉིས་སྟོང་ལྔ་བརྒྱ་འཇིག་རྟེན་དུ་རྩ་མེད་དུ་འགྲོ་བའི་ཉེན་ཁ་ལ་གནས་འདུག་སྐད།",
    "དེ་བས་དུས་རབས་ཉེར་གཅིག་པར་ཞི་བདེ་དང་བདེ་ཐང་རང་བྱུང་འབྱུང་ཁམས་སྲུང་སྐྱོབ་ཐད་ལ་གཞན་ལ་མེད་ཤེས་རབ་ཀྱི་ཚོམས།",
    "ང་རང་ནང་བསྟན་གྱི་མཚན་ཉིད་རིག་པའི་ཁྲོད་ནས་ནར་སོན་པས་ངའི་གླེང་གངས་སེང་འཚོལ་བ།",
    "བྱའང་རང་ཉིད་ཀྱི་ལྟ་བ་དང་འབྲེལ་བའི་བསམ་བློ་དང་རྩོམ་རིག་ཡིན་པ་སྨོས་མེད་ཡིན།",
    "དེ་ཡང་རང་ལ་ལྟོས་ན་རང་ཉིད་རང་ཡིན་ལ་གཞན་ལ་ལྟོས་ན་རང་ཉིད་གཞན་པ་ཡིན།",
    "སེམས་བཟང་བོ་དང་གཞན་ལ་འཚེ་བ་སྤོང་བའི་ཆེད་དུ་རང་གཅེས་འཛིན་ལ་འའཐུབ་རྩོད་བྱ་རྒྱུ་དང་རང་སེམས་ལ་ཞིབ་འཇུག་བྱ་རྒྱུ་ནི་རྨང་གཞིའི་བསམ་པ་ཡིན།",
    "ཁོའི་སྐད་ཅིག་མ་ཙམ་ལའང་རང་དོན་གཉེར་བ་མེད་ལ་གཞན་གྱི་བདེ་བའི་ཆེད་དུ་རང་ཉིད་མེ་ལ་བསྲེགས་ནའང་འདྲ།",
    "སྟོན་པ་རྡོ་རྗེ་འཆང་ལ་དངོས་སུ་ཐོས་པར་འདུག་སྙམ་ནས་འཇུག་ཅིང་ངེས་པ་བསྐྱེད་པའི་དགོས་པ་ཡོད་དོ།",
    "བླ་ཆེན་པའི་ཡི་གེ་གཅིག་ན་དོན་བྱེད་སྤྱོད་པའི་ལུས་སུ་བྱས་ནས་འདུག་གསུང་།",
    "གཞལ་ཡས་ཁང་རང་ཇི་ལྟར་བསྐྱེད་ན།",
    "དེ་ལའང་རང་བྱིན་བརླབ་དང་དཀྱིལ་འཁོར་འཁོར་ལོ་གཉིས་ལས།",
    "རོ་མ་ནས་མེ་སྦར་བས་རྐྱང་མ་ནས་བྱང་སེམས་ཕབ་པས་བདེ་བའམ་མི་རྟོག་པ་བསྐྱེད་པའི་ཐབས་སུ་འདུག་པས་ནའོ།",
    "ཕྱི་རོལ་ཏུ་ཉན་ཐོས་བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོབ་སྡོམ་པའམ།",
    "ལམ་དུ་མ་བྱས་ཙ་ན་ལུས་འགྲུབ་པའི་ཐོག་མར་རྟེན་ནམ་གནས་སུ་འགྲོ་བས་སོ།",
    "ཡི་གེ་ཐམས་ཅད་ཀྱི་ཐོག་མའམ་འབྱུང་ཁུངས་སུ་འདུག་པས་སོ།",
    "ངག་ཐམས་ཅད་ཀྱི་འབྱུང་ཁུངས་སུ་འདུག་པས་སོ།",
    "རང་བཞིན་གྱིས་སྟོང་པར་འདུག་པ་སྟེ།",
    "འབྱུང་ཁུངས་སུ་འདུག་པས་སོ།",
    "གྲ་ཧ་ཙ་ནི་འཛིན་པ་ཡིན་ལ།",
    "བར་དུ་ལམ་དུས་སུའང་རང་བྱིན་གྱིས་བརླབ་པའི་ལམ་ལ་བརྟེན་པས་ན།",
    "དངོས་པོ་ཀུན་བདེ་སྟོང་དུ་ཤེས་པའི་རྣལ་འབྱོར་གྱིས་དཔྱད་ན་སྐྱེ་མེད་དུ་འདུག་པའོ།",
    "འདི་ནི་བཟང་པོར་བརྗོད་བྱར་འདུག་པས་སྨྲའོ།",
    "ཡེ་ཤེས་དེ་ལ་ཡང་ཡེ་ཤེས་ལྷག་མ་བཞིའི་གཟུགས་བརྙན་འཆར་བའི་རྟེན་དུ་འདུག་པའམ།",
    "ཞེས་པ་སྟེ་དེ་གསུམ་ཀའང་རྟོག་བཅས་སུ་འདུག་པ་དེས་ནའོ།",
    "ཐམས་ཅད་ལྷན་སྐྱེས་ཀྱི་རྣམ་འཕྲུལ་དུ་འདུག་པས་སོ།",
    "དེ་ལ་དང་པོ་ནི་དེ་དེའི་ངོ་བོ་ཉིད་དུ་འདུག་པ་སྟེ།",
    "ཡང་རང་རིག་པའི་དག་པས་གྱ་ནོམ་ལྷར་ཞེན་པའི་དུག་མེད་པར་བྱས་ནས།",
    "དེ་ཡང་རྟོག་བཅས་སུ་འདུག་ལ།",
    "དེ་ཡང་རྟོག་བཅས་སུ་འདུག་ལ།",
    "རྟོག་བཅས་སུ་འདུག་པ་དེ་གསུམ་གྱི་དུས་ན་ལྷན་སྐྱེས་ཀྱི་རྟོགས་པ་མེད་པས་ན།",
    "རབ་ཏུ་གནས་པས་སྟོང་པར་འདུག་ཀྱང་།",
    "ཞེས་པ་སྣང་ཡང་རང་བཞིན་མེད་པའོ།",
    "མི་རྒྱུ་བ་སྣོད་དུ་ཡང་རང་བཞིན་ལྷན་སྐྱེས་དེ་ཉིད་སྣང་ཞེས་བྱའོ།",
    "བདེ་བ་དངོས་པོ་སྟེ་གཟུགས་སུ་ཡང་རང་བཞིན་ལྷན་སྐྱེས་དེ་ཉིད་སྣང་ལ།"
