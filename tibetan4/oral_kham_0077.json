    "ཡུལ་སྣང་ཐམས་ཅད་ལ་སྲེད་པ་དང་ཞེན་པའི་བློ་དེ་ངམ་ངམ་ཤུགས་ཀྱིས་ཆོད་པའི་ཐབས་ལ་མི་མེད་ལུང་སྟོང་དུ་བདག་མེད་གཅིག་པུར་འདུག་པ་ན།",
    "དྲན་རིག་སྐྱེ་མེད་ནམ་མཁའི་དབྱིངས་སུ་སྦས་པའི་འགག་མེད་ཤུགས་འབྱུང་རང་གྲོལ་སྟོང་པའི་ངང་ལ་གནས་པའི་ནང་ངར་འཛིན་ངམ་ངམ་ཤུགས་ཀྱིས་ཆོད་ནས་བྱར་མེད་རིག་པས་བཙན་ས་ཟིན་པ་དེ།",
    "མིན་ན་འཇིག་རྟེན་གྱི་བྱ་བ་ལ་བློ་འདི་ཙམ་ཞེན་ནས་ལོ་ཁྲིའི་བར་གྱི་འདུག་ཆས་བྱེད་པ་འདི་མི་རིགས།",
    "ནང་སྟོང་པ་ཆེན་པོའི་སྣང་བ་དེ་དང་རང་བཞིན་མ་གྲུབ་པའི་སྟོང་པ་དེ་དབྱེར་མེད་ཟུང་དུ་འཇུག་པ་ལ་ཟེར་ཏེ།",
    "བུ་གཟུགས་དེ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་པའི་ཕྱིར་དུ།",
    "དེས་ན་བདག་ཡོད་ཙ་ན་བདུད་ཀྱང་ཡོད།",
    "བདག་མེད་ཙ་ན་བདུད་ཀྱང་མེད་པས།",
    "དེ་ཡང་རང་དོན་དུ་ཞེ་སྡང་ཆེན་པོ་བསྐྱེད་ནས།",
    "སྟན་བདེ་བར་འདུག་སྟེ།",
    "བདག་གང་དུ་འདུག་པའི་གནས་པོ་དེ་ལ་གཉན་སའི་གདོན་ཟེར་ཏེ།",
    "དེས་ཐམས་ཅད་ཟིང་སྟེ་རང་རང་ཕྱོགས་ནས་བྱུང་བར་བསམ།",
    "སྔར་ང་འདུག་པའི་དུས་སུ་ཙན་དན་གྱི་ཚལ་ཆེན་པོའི་གསེབ་ཏུ།",
    "རྗེ་བཙུན་སྒྲོལ་མས་བྱིན་གྱིས་བརླབས་པའི་བྱ་ཡིན་པར་འདུག་ལ།",
    "ཉི་ཟླའི་གདན་ལ་འདུག་པ་དང་།",
    "མི་རོ་མང་པོ་བརྩེགས་པའི་སྟེང་དུ་ཉམ་ང་མེད་པར་འདུག་པ་དང་།",
    "ཐམས་ཅད་རང་སྣང་རང་གྲོལ་ཡིན་བཞིན་དུ།",
    "གཡུ་ཁྲིའི་སྟེང་དུ་བཟུར་འདུག་པ་དང་བཅས་པ་ནི།",
    "གཙུག་ལག་ཁང་དུ་འདུག་པ་དང་།",
    "བརྩེ་བའི་ནང་དུ་འདུག་པ་ལ་སྨིན་ཅིང་སྐྲ་མེད་པ་ཆུང་བ་ནས།",
    "རི་ཀླུང་ལ་མེ་མཆེད་ཅིང་རང་ཡང་ཚིག་ལ་ཁད་པ་དང་།",
    "སྤྱང་ཀི་མང་པོ་ངུ་འབོད་བྱེད་ཅིང་རང་ལ་རྒོལ་བ་དང་།",
    "བྱ་གཅན་གཟན་གྱིས་གང་བར་འདུག་པ་དང་།",
    "དམར་སིང་བའི་སར་འདུག་པ་དང་།",
    "འཇའ་འོད་ཀྱི་གུར་ནང་དུ་འདུག་པ་དང་།",
    "སྟག་ལྤགས་ཀྱི་གུར་ནང་དུ་འདུག་པ་དང་།",
    "ལྗོན་ཤིང་མང་པོ་འཁྲིག་པའི་ཚལ་དུ་འདུག་པ་དང་།",
    "མི་དམར་རྟ་དམར་སྐྱ་མི་དམར་པོ་མང་པོ་འཆམ་པ་དག་རང་བཞིན་འགྲོ་འདུག་བྱེད་པ་དང་།",
    "དེ་རྣམས་རང་རང་ལ་འོད་དང་འཇིགས་པའི་ཟིལ་ཆེན་པོ་ཡོད་པའི་རྩར་རང་ཕྱིན་པ་དང་།",
    "ཡང་བུ་ཆུང་ལོ་བརྒྱད་པའི་ན་ཚོད་ཙམ་གྱི་ནུ་མ་མན་ཆད་སྦྲུལ་དུ་འདུག་ཅིང་།",
    "ཡང་རང་བཞིན་གྱི་ན་བུན་སྤྲིན་དང་།",
    "འབྲུག་ཐོད་སྔོན་པོའི་གཉའ་བར་འཛེགས་ནས་འཇིགས་པའི་ཚུལ་དུ་འདུག་གམ།",
    "གང་དུ་ཡིན་ཀྱང་དྲོད་དང་ཚད་པ་ཆེན་པོ་འཕྱོ་ནས་རང་འདུག་མི་བཟོད་པ་དང་།",
    "ས་ལ་བཅལ་དུ་བཀྲམ་པ་དང་རང་བཞིན་གཤིབས་ནས་ཡོད་པ་ནི་གསང་བའི་ལྷོངས་ཚད་ཡིན་པ་དང་བཅས་པ་ནི་མ་ནོར་བར་གལ་ཆེའོ།",
    "འཇའ་ཚོན་དང་འོད་ཀྱི་གདན་ལ་འདུག་པ་དང་།",
    "ཁང་བརྩེགས་ཤིན་ཏུ་བཟང་བའི་ནང་དུ་འདུག་པ་དང་།",
    "སྤྲིན་གྱི་ནང་དུ་འདུག་པ་དང་།",
    "དེ་རྣམས་ཀྱང་རང་ལ་ཚུར་འདུད་པ་དང་།",
    "སྤེན་མ་ཤལ་ཤུལ་ཡོད་པ་དེ་རྣམས་སུ་འདུག་པ་དང་།",
    "མེ་ལྷེམ་ལྷེམ་ཅུང་ཟད་མི་གསལ་བ་བོང་བུའི་རྣ་བ་ཙམ་འབར་བའི་རྩར་འདུག་པ་དང་།",
    "འདུག་མལ་ནས་གཞན་དུ་འཁྱེར་བ་དང་།",
    "སྤྲང་ལོང་མང་པོས་སྒོ་འདུག་བྱེད་པ་རྣམས་རྨིས་ན།",
    "ལུས་ལྗིད་ཅིང་ལང་འདུག་ཉམས་ཤེད་ཆུང་བ་དང་།",
    "སང་ནམ་ཞིག་དུས་སུ་སྙིགས་མ་ལྔ་དང་རྩོད་པ་རྣམས་ཤིན་ཏུ་རྒྱས་པ་ཞིག་འོང་བའི་དུས་གཅིག་འབྱུང་ངོ།",
    "བདེན་སྤྱོད་ཅན་དང་ཉམ་ཆུང་ནི་རང་ཁྱིམ་དུ་འདུག་ཀྱང་གཉེན་གྱིས་ཀྱང་ཆོམ་པོ་བྱེད་པ་འོང་།",
    "འདི་ནས་ཕྱིས་འབྱུང་ཡུན་རིང་སྐབས་ཤིག་དུས།",
    "འདི་འདྲ་འབྱུང་ལ་གཉིས་སུ་གདའ་སྟེ་ཁྱད་པར་ཆེ།",
    "ཁྱད་པར་ཡང་སྙིགས་དུས་བསྟན་པ་ལ་བྱ་བ་བྱེད་པར་ནུས་པའི་དགེ་སློང་དེའི་དྲི་བ་ལ་ནན་ཏན་ཆེ་བར་གདའ་སྟེ།",
    "འདི་གཉིས་ཀྱི་ཡོན་ཏན་བརྗོད་ནས་མཐས་ཡས་པ་རྙེད་པ་ནི་དཀའ་སྟེ་འདུག་གོ།",
    "དེ་བས་ཀྱང་ནི་དཀོན་པར་གདའ།",
    "དེ་ཡང་ཆ་ལུགས་བཟང་ཤོལ་གདའ་བ་ཨང་།",
    "ལུས་ནི་མི་ཡི་གཟུགས་སུ་གདའ།",
    "ང་ཡི་རྗེས་སུ་ངེས་པར་འདུག་པའི་མི།",
    "སློབ་དཔོན་གྱིས་སྭ་བྷཱ་ཝ་སོགས་ནས་ཧཾ་ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་པོ་ཁམས་དང་ཞེས་སོགས་ཀྱིས།",
    "འགྲུལ་བ་འཕྲུལ་སྒུལ་འཁོར་ལོར་འདུག་པར་མཉམ་འཇོག་དགོས་ས་གང་དག་ཡོད།",
    "འགྲུལ་བ་འཕྲུལ་སྒུལ་འཁོར་ལོར་འདུག་པར་མཉམ་འཇོག་དགོས་ས་གང་དག་ཡོད།",
    "འཁོར་ལམ་ནང་ནས་འདུག་པ་སོགས་གཏན་ནས་བྱེད་མི་རུང་།",
    "ཉེན་འཚབ་ཆེ་བའི་གནས་ཚུལ་འོག་འདུག་དགོས་པ་བྱུང་ཚེ།",
    "ཀླུ་ཆེ་བ་ཞིག་འདུག་པ་བཏུལ་ནས་ཕ་བོང་ཐག་ཐུག་རྣམས་བཅག་ཅིང་སྦས་ཏེ་བྱ་ཡུལ་བཏབ།",
    "དེར་མི་རྣམས་དགྲ་མིག་ས་འདེབས་སྤྱན་གསུམ་པོ་འདི་འབར་ནས་འདུག་ཟེར་བས་གྲྭ་ཟི་འབར་པོ་བྱ་བར་ཐོག་སྲས་འབྲིང་བ་གྲྭ་ཟི་འབར་པོ་དེ་ཐུགས་གཞི་ནི་རྒོད།",
