    "དམུ་ཡད་ཕྱྭ་ཚེ་གཡང་གི་རྟེན།",
    "སྐྱང་སྤྲུལ་ནམ་མཁའ་རྒྱལ་གྱིས་མཛད་པའི་སྲིད་པ་ཡབ་བླ་བདལ་དྲུག་གི་ཕྱྭ་གཞུང་ཆེན་མོའི་ལག་ལེན་ལས།",
    "ཚེ་མདའ་ཉ་མིག་དེ་ནི་ཁྱོད་གའི་མདའ་དང་ཕོ་ཡི་མཚོན་བྱེད་ཅིག་གཡུང་དྲུང་བོན་དང་འབྲེལ་བའི་ལོ་དེབ་མུ་ཁྲི་བཙན་པོའི་དཔྱད་རྩོམ་བདམས་བསྒྲིགས།",
    "དེ་ནི་མནའ་མའི་ཡབ་ཀྱིས་རང་གི་བུ་མོ་མནའ་མར་འགྲོ་སྐབས་སུ་ཕུལ་བའི་རྟེན་ཡིན།",
    "ལ་ལས་ཚིགས་རྐང་བཞི་དགོས་ཟེར་མཁན་ཡོད་མོད་ཀྱང་།",
    "ཞེས་པ་སྦྱིན་སྲེག་གི་མེ་ཐབ་དུ་བཙུགས་པའི་མེ་མདའ་ཡིན་པས་མཚོན།",
    "སྨྱུག་རྒོད་ཚིགས་གསུམ་སྲོག་གི་རྟེན།",
    "འཕང་ནི་མོ་ཡི་མཚོན་བྱེད་ཡིན་ལ།",
    "སྔོན་མོ་ཨིནྡྲ་ནཱི་གཡུང་དྲུང་བོན་དང་འབྲེལ་བའི་ལོ་དེབ་མུ་ཁྲི་བཙན་པོའི་དཔྱད་རྩོམ་བདམས་བསྒྲིགས།",
    "གཡུ་ཉིད་བླ་སྲོག་གི་མཚོན་བྱེད་གལ་ཆེན་པོ་ཞིག་ཡིན་པ་ནི་གོང་གསལ་གནའ་བོའི་དཔྱད་ཡིག་དེ་ལས་གསལ་པོར་ཐོན་བཞིན་ཡོད་པ་རྟོགས་ནུས།",
    "མདའ་དར་གྱི་འགོ་ལ་གཡང་དཀར་ལུག་གི་བལ་སྐུད་ཀྱང་འདོགས་དགོས།",
    "སྟང་གི་དེ་ནི་སྤྱི་བོ་རུ།",
    "གཡང་ཐག་དེ་ནི་སྔོན་མོ་བཏགས།",
    "དེའི་མི་རྒྱུད་དྲུག་གི་རྗེས་སུ་བཙན་པོ་དྲི་གུམ་སྤྱི་ལོའི་སྔོན་གྱི་ལོར་འདས།",
    "དམིགས་བསལ་དུ་དར་རས་དཀར་པོ་ཞིག་ལ་བུམ་པ་དང་གཡུང་དྲུང་གི་རི་མོ་སོགས་འབྲི་དགོས་པ་ཡང་ངག་སྒྲོས་ཡིན།",
    "སྒྲོ་མོ་སྤུན་གསུམ་སྐུ་གསུང་ཐུགས།",
    "བུད་མེད་ཅིག་ལ་བུ་ཞིག་བཙས་ན་དེའི་སྔས་འགོར་ངེས་པར་དུ་མདའ་ཞིག་འཛུགས་པ་དང་།",
    "བུ་མོ་ཞིག་བཙས་ན་སྔས་འགོར་འཕང་ཞིག་འཇོག་སྲོལ་ལས་ཀྱང་དངོས་སུ་ར་འཕྲོད་ཐུབ།",
    "ཡང་བསྐྱར་ཚུར་འགུགས་པའི་དུས་སུ་ཚེ་མདའ་དེ་བེད་སྤྱོད་བྱས་ནས་ཚེ་འགུགས་ཀྱི་བསྙེན་པ་བཏོན་ཏེ་འགུགས་ཐབས་བྱེད་དགོས་རེད་ཟེར་བཞིན་ཡོད།",
    "རྒྱལ་པོས་བོན་གཤེན་ནུས་མཐུས་སླར་ཡང་ཚུར་འགུགས་ཐུབས་བྱེད་དགོས་ཞེས་པའི་བཀའ་ཕབ་མ་ཐག་ཏུ་བོན་གཤེན་རྣམས་ཀྱིས་ཆོ་ག་སྤེལ་ནས་ཤཱཀྱ་བྲ་བ་སླར་ཡང་སོས་སོང་།",
    "མདའ་ནི་གཉེན་སྒྲིག་གི་ཆོ་ག་སྤེལ་སྐབས་མེད་དུ་མི་རུང་བའི་ཡོ་བྱད་ཅིག་ཡིན་ལ།",
    "བོད་མིའི་ཁ་སྐད་དུ་ཤོད་སྲོལ་ལའང་གཉེན་ལམ་མདའ་ཡིས་ཕྱེ་བ་ཞེས་པས་གཞིས་ཁྱིམ་གཉིས་དབར་གཉེན་སྒྲིག་གི་འབྲེལ་ལམ་འཛུགས་རྒྱུའི་ཐད་ལ་མདའ་ཡིས་དམིགས་བསལ་དུ་འདོན་སྤེལ་བྱེད་དགོས་ཡོད་ལ།",
    "གཉེན་ལམ་སྐབས་སུ་ཁྱོ་གའི་སྤྱི་གཙུག་ཏུ་བལ་གྱིས་བཟོས་པའི་དམུ་ཐག་དང་མནའ་མའི་སྤྱི་གཙུག་ཏུ་གཡང་ཐག་འདོགས་པ་ཡིན་ལ།",
    "ཁྱོ་གའི་ལག་ཏུ་མདའ་མོ་བཟུང་ཞིང་མགོ་སྟེང་གི་ལྷ་ལྔར་ཆང་དང་གཏོར་མ་སོགས་ཀྱི་མཆོད་འབུལ་དང་གཡང་འབོད་དང་བཅས་ནས་སྤེལ་དགོས།",
    "དེ་བཞིན་གཏམ་རྒྱུད་དང་འབྲེལ་ན་སྔོན་བོད་ཀྱི་བཙན་པོ་སྲོང་བཙན་སྒམ་པོས་གཉེན་སྒྲིག་སྤེལ་སྐབས་ཁོང་གི་བློན་པོ་མགར་ཐང་རྒྱལ་རབས་སུ་མནའ་མ་སློང་བར་འགྲོ་དུས་མདའ་ཞིག་འཁྱེར་ནས།",
    "རྒྱ་ཡི་རྒྱལ་པོས་ན་ཆུང་མཛེས་མ་སུམ་བརྒྱ་བསྡུས་ནས་མགར་ལ་དེ་རྣམས་ལས་གཅིག་བདམ་དུ་འཇུག་སྐབས་མགར་གྱིས་རང་ཉིད་མོས་པའི་སྲས་མོ་དེ་ཡི་ཐོག་ཏུ་མདའ་མོ་བཙུགས་ཚུལ་བཀོད་ཡོད་པ་བཞིན་ནོ།",
    "གཡང་གི་མདའ་དར་གྱི་བེད་སྤྱོད་བྱེད་ཚུལ་ནི།",
    "གཡང་མདའ་ནི་བོན་གཤེན་རྣམས་ཀྱིས་གཡང་འགུག་གི་ཆོ་ག་སྤེལ་སྐབས་སུ་དགོས་གལ་ཧ་ཅང་ཆེན་པོ་ཞིག་ཡིན།",
    "གཡང་འགུག་གི་ཆོ་ག་སྤེལ་སྐབས་གཡང་རྟེན་གྱི་གཙོ་བོ་ཞིག་ཡིན།",
    "ཡབ་གཅིག་སངས་པོ་འབུམ་ཁྲི་དང་ཡུམ་གཅིག་ཆུ་ལྕམ་རྒྱལ་མོ་གཉིས་ལ་སྲས་གཡུང་དྲུང་འཕྲུལ་གྱི་མི་ཕོ་ཞེས་བྱ་བ་ཞིག་འཁྲུངས་པ་དེའི་སྐབས་སྤྱི་ལེ་ཕྱུ་མེད་ཉུང་གཅིག་མང་།",
    "ལྷ་བོན་ཐོད་དཀར་གྱི་ཞལ་ན་རེ།",
    "ཕྱག་གཡས་པས་ཉི་ཟེར་འཕྲུལ་གྱི་ཞགས་པ་དང་ཕྱག་གཡོན་པས་ཐབས་ཤེས་ཀྱི་གཡུའི་མདའ་གཞུ་བསྣམས་ནས་ཕྲུ་རྫས་སྣ་དགུ་ཚོལ་བ་རི་རྒྱལ་ལྷུན་པོའི་ཤར་དང་བྱང་དང་ནུབ་དང་ལྷོ་སོགས་ལ་ཕྱིན་ནས་དུང་ཤ་དཀར་མོ་དང་ཟངས་ཤ་དམར་པོ་དང་མཆོང་ཤ་སྨུག་པོ་དང་ལྕགས་ཤ་ནག་པོ་སོགས་དང་འཕྲད་ནས་ཉི་ཟེར་འཕྲུལ་ཞགས་འཕང་ནས་སྒྲིར་གྱིས་བཟུང་།",
    "དེ་ནི་ཕྱྭ་དང་གཡང་གི་རྟེན་ཞེས་བཀའ་སྩལ་ཏོ།",
    "ཆོ་ག་སྤེལ་སྟངས་ནི་སྲིད་པའི་ཡབ་བླ་བདལ་དྲུག་གི་ཕྱྭ་གཞུང་ཆེན་མོ་ལས་གསལ།",
    "མི་ཁ་མཁས་ལྕེ་བདེ་ཞིག་གིས་ལག་གཡོན་དུ་གཡང་མདའ་དང་སྤོས།",
    "ལག་གཡས་སུ་འབྲུ་རིགས་གང་མང་གིས་བཏོར་ནས་གཡང་འབོད་བྱེད་པའི་ལུགས་སྲོལ་དེ་གཡུང་དྲུང་བོན་དང་འབྲེལ་བའི་ལོ་དེབ་མུ་ཁྲི་བཙན་པོའི་དཔྱད་རྩོམ་བདམས་བསྒྲིགས།",
    "རྒྱས་པར་གཟིགས་འདོད་ན་ཕྱུ་འབོད་དང་གཡང་འབོད་ཅེས་པའི་གཞུང་ལ་གཟིགས་དང་གསལ་ཁ་ཡོད།",
    "མེ་མདའ་ལ་དར་རས་དཀར་པོ་ལ་བུམ་པ་དང་གཡུང་དྲུང་གི་རི་མོ་བྲིས་པ་དང་།",
    "ཞང་བོད་ཀྱི་རིག་གཞུང་མདའ་དར་གྱི་ངོ་བོ་རགས་ཙམ་སྲོལ་རྒྱུན་བགྲེས་པོའི་ངག་རྩི་དང་སྦྲེལ་ནས་སྤེལ་བ་རེ་ཞིག་རྫོགས་སོ།་",
    "སྲིད་པ་ཡབ་བླ་བདལ་དྲུག་གི་ཕྱྭ་གཞུང་གི་ལག་ལན།",
