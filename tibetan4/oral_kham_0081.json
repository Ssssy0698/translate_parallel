    "གང་ཤར་ཅི་འགྲུས་སེམས་སུ་ངོ་ཤེས་ན་དེས་ཆོག་ཅེས་སྐྱེ་འགགས་གྲངས་སུ་འདེབས་པ་རྣམས་ཀྱང་གནས་ལུགས་ཀྱི་དོན་དང་གནམ་ཞེས་གསུངས་པས་ཁྱེད་རང་ལ་ཚེས་སྐལ་མེད་པ་ཞིག་ས་བས་ཀྱང་རིང་བ་ཡིན་ནོ།",
    "གནས་འགྱུ་གང་ཡིན་ཡང་འདྲ་སྟེ་ངོ་ཤེས་མཁན་ཁོ་རང་ཡུལ་མེད་མཐའ་བྲལ་དུ་མ་སངས་ན།",
    "ད་ལྟ་ལམ་དུས་སུའང་དཔེར་མཚོན་ན་སྡུག་བསྔལ་དང་འཇིགས་སྐྲག་ལྟ་བུའི་རྣམ་རྟོག་ངོས་དྲག་པ་ཤར་བའི་ཚེ་རྣམ་རྟོག་ཁོ་རང་ངོ་ཤེས་པ་ཙམ་གྱིས་ཁྱེད་ཀྱི་སྡུག་བསྔལ་དང་འཇིགས་སྐྲག་མཐའ་གྲོལ་དུ་སངས་པ་དེ་དགོད་འཆོར།",
    "མགྲིན་པ་འདི་གདམས་པའི་བང་མཛོད་དུ་འདུག་གོ།",
    "རྫོགས་ཆེན་ཁོས་བསླུས་ཡོང་བསམ་པ་རང་མི་གདའ།",
    "ཕྱོགས་ལྷུང་ནི་མི་འདུག་རྫོགས་ཆེན་གྱི་ལྟ་བ།",
    "ཨ་ཧོ་ཡེ་སྤྲོས་བྲལ་ལ་སྒོམ་རྒྱུ་ནི་མི་གདའ།",
    "དད་ལོག་སྣང་བ་བསྒྱུར་ནུས་པ་ཞིག་འོང་བར་གདའ་སྟེ་བཀའ་དྲིན་ཆེ།",
    "ན་ར་སི་ཙ་ནཱ་རཱ་ཡ་ཎ་ཨོ་ན་རཉྫ་ནཱ་རཱ་ཡ་ཎ་ན་ར་ནཱ་རཱ་ཡ་ཁོ་སྟེ།",
    "བྱིས་པས་ཟ་འདོད་པའི་ཟས་རིགས་ནི་བྱིས་པའི་ལུས་ཁམས་ལ་ཕན་པ་ལོས་ཡིན་སྙམ།",
    "དེ་མིན་གཞན་མཚང་ཁོག་ནང་ལྗིད་ཏིག་གེར་འདུག་པ།",
    "ལུས་ཀྱི་འགྲོ་འདུག་བྱ་བྱེད།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་སྟེ་། མིག་ནི་སྣ་རྩེར་གཏད་བྱས་ནས།",
    "སྤྱོད་ལམ་དེས་འདུག་པ་མཐོང་ན་ཤིན་ཏུ་དང་བ་སྐྱེ་བ་དང་།",
    "སེམས་ཀྱི་རང་བཞིན་ནམ་འདུག་ཚུལ་ཇི་ལྟར་ཡོད་པ་དེ་ག་ལྟར་མ་བཅོས་པར་འཇོག་པ་སྟེ།",
    "མ་བཟུང་མ་བཏང་རང་ག་ཉིད་དུ་ཞོག།",
    "ལུས་འགྲེང་བ་དང་འདུག་པ་སོགས་ཀྱི་གནས་སྐབས་ཐམས་ཅད་ལ་རྣམ་པར་དཔྱོད་པ་ནི་ལུས་སུ་གཏོགས་པའི་དྲན་པ་སྟེ།",
    "དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ་ནང་དུ་ཡང་དག་བཞག་ནས།",
    "འགྲོ་དང་འཆག་དང་ཉལ་དང་འདུག་པ་ན།",
    "འཕྲལ་ཇི་ལྟར་འདུག་དང་འདི་ལྟར་སྣང་སོགས་ད་ལྟའི་རྟོག་དཔྱོད་ཀྱང་ཡིད་ལ་མི་བྱེད་པར་སེམས་རང་གར་ལྷོད་དེ་ཤིག་གེ་བར་འཇོག་པ་ཡིན་ལ།",
    "བཀག་པས་ཁེགས་པར་མི་འདུག་དིང་རི་བ།",
    "རྣམ་རྟོག་ཁོ་རང་གང་བྱེད་དུ་བཞག་ཅེས་སོགས་ཁྲིད་ཡིག་ཏུ་གསུངས་པའི་ཕྱིར་འདི་ནི་ཞི་གནས་རང་ལ་དཔགས་པའི་ཁ་ཡན་དུ་སྐྱོང་བ་སྟེ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "ལུས་སེམས་ཡོད་དུ་མི་ཚོར་བ་བར་སྣང་སྟོང་པ་ལ་འདུག་པ་ལྟ་བུ་ལ་སོགས་པའི་ཉམས་ཀྱི་སྣང་བ་འཆར་བའོ།",
    "གནས་འགྱུ་གཉིས་ཐ་དད་དུ་དབྱེ་མ་དགོས་པ་དེ་གནས་འགྱུ་གཉིས་ཀྱི་བར་ལག་འགྱེལ་བའོ་། དེ་དུས་ཀྱི་གནས་པ་དང་འགྱུ་བ་ངོ་ཤེས་མཁན་དེ་ལ་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའམ་སོ་སོར་རྟོག་པའི་ཤེས་རབ་དང་རང་རིག་པ་ཞེས་ཀྱང་བྱ།",
    "དེས་གནས་འགྱུ་རང་བཞིན་མེད་པར་སྦྱངས་མཐར་ཤེས་རབ་ཁོ་རང་ཡང་དམིགས་སུ་མེད་དེ་དཔེར་བཀོད་པའི་གཙུབ་ཤིང་དང་གཙུབ་གཏན་བསྲུབས་པ་ལས་སྐྱེས་པའི་མེས་ཤིང་གཉིས་བསྲེག་མཐར།",
    "ཕྱོགས་སྔ་མ་ལ་སུན་འབྱིན་ཅིང་ཡོད་པ་ཁྱེད་རང་ལ་བཟློག་པའི་ཕྱིར་དང་།",
    "གསལ་བའི་ངོས་བཟུང་དང་དེའི་རྣམ་པ་ཅན་དུ་འདུག་བརྟག་སྟོང་པར་འདུག་ན་ཅང་མེད་ཀྱི་སྟོང་པ་དང་བར་སྣང་ལྟ་བུའི་སྟོང་པ་ཇི་ལྟར་འདུག་བརྟག་གསལ་ན་ཉི་ཟླ་ལྟ་བུའམ་མར་མེ་ལས་འོད་འཕྲོ་བ་ལྟ་བུར་གསལ་བ་དང་འོད་དང་ཁ་དོག་མེད་པའི་རང་གསལ་དུ་འདུག་ལ་སོགས་པ་སྒོ་དུ་མ་ནས་བརྟག་ཅིང་དཔྱད།",
    "དང་པོ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲོད་པ་ནི།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཧྲྀ་ད་ཡ་སི་ར་ཤི་ཁཱ་ཀཱ་བ་ཙ་ནེ་ཏྲ་ཨསྟྭ་བཛྲ་ཁ་ཊཱཾ་ག་སྭ་བྷཱ་ཝ་ཨཱཏྨ་ཀོཧཾ།",
    "དམར་སེར་དུ་འདུག་པ།",
    "རཱུ་པ་ཞེས་པ་གཟུགས་དང་རང་བཞིན་གཉིས་ཀ་ལ་འཇུག་པས་སྐབས་འདིར་རང་བཞིན་དུ་ཞེས་བསྒྱུར་དགོས་པ་ལ།",
    "ཝ་དང་བཏུན་ཤིང་ལས་སྐྱེས་པའི་མི་གཡོ་བ་དཀར་པོ་ཞལ་གཅིག་དུས་ཀྱི་འཁོར་ལོའི་སྒྲུབ་ཐབས་པདྨ་དཀར་པོའི་ཞལ་ལུང་།",
    "ཀ་དང་སྒྱུ་གྲི་གུག་ལས་སྐྱེས་པའི་སྟག་དུས་ཀྱི་འཁོར་ལོའི་སྒྲུབ་ཐབས་པདྨ་དཀར་པོའི་ཞལ་ལུང་།",
    "ལྷ་རྣམས་རྡོ་རྗེའི་འདུག་སྟངས་དང་།",
    "གཞན་ཡང་རང་རང་མིང་ཡིག་ལས།",
    "ཨོཾ་བེ་རོ་ཙ་ནཱ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "རང་རང་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
    "དེ་ནས་༣ན་འདུག་སྟེ་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་བཅས།",
    "རལ་གྲི་འཛིན་པ་མདུན་དུ་འདུག་སྟེ་བཀའ་ནོད་པ་ལས།",
    "རང་ཉིད་ཆས་སུ་བཞུགས་པ་བྱས་ལ་དཀྱིལ་འཁོར་གྱི་ཤར་སྒོ་ལ་ཕྱོགས་པར་འདུག་སྟེ།",
    "རང་དང་རང་འདིའི་ཡེ་ཤེས་པའི་ཐུགས་ཀར་སྣ་ཚོགས་པདྨ་དང་ཟླ་བའི་གདན་ལ།",
    "ཛ་ཛ་ཛ་ཛ་ཛ་ཧཱུཾ་བཾ་ཧོ་ཡེ་ཤེས་པ་རྣམས་ཀྱང་རང་རང་སོ་སོའི་དམ་ཚིག་པ་རྣམས་དང་གཉིས་སུ་༡༨བ་མེད་པར་གྱུར།"
  ]
}