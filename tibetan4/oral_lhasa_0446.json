    "རཾ་ཡཾ་ཁཾ་ལས་དངོས་འཛིན་བག་ཆགས་ཐམས་ཅད་སྟོང་པར་གྱུར",
    "མཆོད་སྤྲིན་ནམ་མཁའ་མཛོད་ཀྱི་རོལ་པ་མི་ཟད་པ་རྒྱན་གྱི་འཁོར་ལོའི་རང་བཞིན་ནམ་མཁའི་མཐའ་དང་མཉམ་པར་གྱུར",
    "ཡེ་ཤེས་ཀྱི་མེ་དཔུང་འབར་བའི་དབུས་ན་བཞུགས་པ་དེ་ལ་རྩ་གསུམ་དཔའ་བོ་མཁའ་འགྲོའི་ཚོགས་མ་ལུས་ཤིང་ལུས་པ་མེད་པས་བསྐོར་ནས་རང་ཅག་ལ་ཞལ་གྱིས་ཕྱོགས",
    "དུར་ཁྲོད་ཀྱི་ཆས་ཐམས་ཅད་རྫོགས་ཤིང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པའི་སྐུར་གྱུར",
    "དེའི་ཕྱི་རོལ་ཏུ་རྡོ་རྗེའི་ཆུ་བོ་རྦ་རླབས་རབ་ཏུ་འཕྱོ་བའི་ར་བ་ལྷུན་གྱིས་གྲུབ་ཅིང་ཡོངས་སུ་རྫོགས་པར་གྱུར",
    "ཡེ་ཤེས་རང་སྣང་ལས་གྲུབ་པའི་གཞལ་ཡས་ཁང་ཡངས་ཤིང་རྒྱ་ཆེ་བའི་ནང་དུ་བདག་དང་བསྲུང་བྱ་ཐམས་ཅད་ཡི་དམ་ལྷའི་ང་རྒྱལ་གྱི་ངང་དུ་གནས་པར་བསྒོམ",
    "བསྲུང་བའི་གུར་ཁང་ལ་དུས་གསུམ་གྱི་རྒྱལ་བ་སྲས་དང་བཅས་པ་རྣམས་ཀྱི་མི་ཤིགས་མི་འགྱུར་བའི་རྒྱས་གདབ་པར་གྱུར",
    "ཡི་དམ་དཔའ་བོ་མཁའ་འགྲོ་བཀའ་སྲུང་དམ་ཅན་རྒྱ་མཚོའི་ཚོགས་དང་བཅས་པ་ཐམས་ཅད་རྟེན་དང་བརྟེན་པའི་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་བཞེངས་ཏེ་རྒྱ་མཚོ་ཆེན་པོ་ལ་ཁ་ཆར་བབས་པ་ལྟར་བདག་དང་སྒྲུབ་རྫས་དཀྱིལ་འཁོར་གཞལ་ཡས་ཁང་དང་བཅས་པ་ལ་ཐིམ་པས་སྣང་སྲིད་དག་པ་རབ་འབྱམས་ཀྱི་རོལ་པར་བྱིན་གྱིས་བརླབ་པར་བསམ",
    "ཁྲོ་ཆུང་མེ་སྟག་ལྟ་བུར་བར་མཚམས་མེད་པར་འཕྲོ་བར་བསྒོམ",
    "མགྲིན་པར་གསུང་མི་འགགས་པའི་རྡོ་རྗེ་ཨཱ་ཡིག་དམར་པོ",
    "སླར་ཡང་ཡི་གེ་ཨོཾ་ཧཱུྃ་ཏྲཱཾ་ཧྲཱི་ཨཱ་རྣམས་གསལ་བ་ལ་རིགས་ལྔ་རིམ་གྱིས་ཐིམ་སྟེ་མི་འཇིགས་མི་འགྱུར་བའི་རྒྱས་ཐེབས་པར་བསམ་ལ",
    "ཞེས་རྒྱས་གདབ་པས་རྒྱལ་བ་རྣམས་ཀྱི་སྐུ་གསུང་ཐུགས་ཡོན་ཏན་ཕྲིན་ལས་མི་ཟད་པ་རྒྱན་གྱི་འཁོར་ལོ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བསམ",
    "དེ་ལྟར་གསལ་བ་རྣམས་ཀྱི་སྐུའི་གར་མཛད་ཅིང་ཞལ་ནས་སྔགས་སྒྲ་དི་རི་རི་སྒྲོགས་པར་བསྒོམ",
    "ཨོཾ་སརྦ་དྷརྨ་ག་གཱ་ན་ཨཱ་སྟོང་པའི་ངང་ལས་བསྒྲང་ཕྲེང་རྣམས་ཡེ་ཤེས་ཀྱི་ལྷ་སྐུ་སྣང་ལ་རང་བཞིན་མ་གྲུབ་པ་འོད་ཟེར་གྱིས་ལུ་གུ་རྒྱུད་དུ་འབྲེལ་བའི་གནས་གསུམ་ལས་འོད་ཟེར་འཕྲོས་པས་ཞི་ཁྲོ་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་སྤྱན་དྲངས་ལ་གཉིས་སུ་མེད་པར་ཐིམ་སྟེ་ཐམས་ཅད་ཀྱི་སྔགས་སྒྲ་དི་རི་རི་སྒྲོགས་པར་བསམ་ལ",
    "གནོད་བྱེད་དུག་ལྔ་དུག་གསུམ་ལས་བྱུང་བའི་ལོག་པར་ལྟ་བ་ཐམས་ཅད་མཱ་ར་ཡ་ཕཊ",
    "ཕྲིན་ལས་རབ་འབྱམས་ཐམས་ཅད་ཐོགས་པ་མེད་པར་ལྷུན་གྱིས་གྲུབ་པར་གྱུར་ཅིག",
    "མཁྱེན་པའི་ཡེ་ཤེས",
    "དམ་ཚིག་ཉམས་ཆག་ཐམས་ཅད་བསྐང་བའི་ཆེད་དུ་ལོངས་སྤྱོད་ཚོགས་ཀྱི་འཁོར་ལོ་ལ་ཐུགས་གཏད་པར་ཞུ",
    "སྟོང་པའི་ངང་ལས་མཁའ་དབྱིངས་རྣམ་པར་དག་པའི་ཀློང་དུ་དབུས་སུ་ཨོཾ་ལས་བེ་ཌཱུཪྻ",
    "ཉམས་ཏིང་ངེ་འཛིན་ལ་བར་དུ་གཅོད་པར་བྱེད་པ",
    "ས་ལམ་གྱི་ཡོན་ཏན་ལ་བར་དུ་གཅོད་པར་བྱེད་པ",
    "སླར་ཡང་ལྷག་གཏོར་འདོད་རྒུའི་དཔལ་ཡོན་དུ་སྤེལ་ཞིང་འབུལ་བ་ལ་ཐུགས་གཏད་པར་ཞུ",
    "བདག་མདུན་གྱི་སྐུ་ལས་ཐུན་མཚོན་སྣ་ཚོགས་ཀྱི་ཆར་ཕབ་པས་དགྲ་བགེགས་ཀྱི་གཟུགས་ཕུང་ཁྲོལ་གྱིས་ཞིག་སྟེ་རྣམ་པར་ཤེས་པ་ཨ་ཡིག་དཀར་པོར་གྱུར་པ་མདུན་བསྐྱེད་ལྷའི་ཐུགས་ཀར་བསྟིམ",
    "ཚེ་བསོད་ནྲྀ་ཡིག་ལྗང་གུའི་རྣམ་པར་རང་ལ་ཐིམ་སྟེ་གཟུགས་ཕུང་དེ་ཉིད་ཤ་ཡི་རི་བོ",
    "གཏོར་གཞོང་ཁ་སྦུབས་པ་དང་དུས་མཚུངས་པར་མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་ནུབ་པར་གྱུར",
    "མཐར་རང་ལ་ཐིམ་པས་མཐུ་སྟོབས་ནུས་བྱིན་དཔག་ཏུ་མེད་པ་འཕེལ་ཞིང་རྒྱས་ཏེ་དུས་གསུམ་རྒྱལ་བའི་མཐུ་ནུས་དཔལ་ཡོན་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བསམ",
    "རྟག་ཏུ་དགེ་ལ་སྤྱོད་པར་གྱུར",
    "ཞེས་པ་འདི་རིགས་སྲས་མཁྱེན་བརྩེ་མྱུ་གུས་ནན་དུ་བསྐུལ་ངོར་བདུད་འཇོམས་རྡོ་རྗེས་སྙན་བརྒྱུད་ལས་བཀོད་པའི་ཡི་གེ་པ་ནི་སློབ་བུ་མངོན་དགས་བགྱིས་པའོ།",
    "སྒྲུབ་པའི་ལྷན་ཐབས་བསྡུས་པ་ཡིད་བཞིན་དཔལ་སྟེར་བཞུགས",
    "ཨོཾ་སྭ་བྷཱ་ཝས་སྟོང་པར་སྦྱངས",
    "གཞན་ཡང་ལྷ་ཀླུ་མི་ཡི་ལོངས་སྤྱོད་འདོད་རྒུའི་དཔལ་ཡོན་ཕུན་སུམ་ཚོགས་པ་མ་ཚང་བ་མེད་པ་ནམ་མཁའི་མཐའ་དང་མཉམ་པར་གྱུར",
