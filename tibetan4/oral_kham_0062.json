    "ནང་མ་ཞེས་བཏགས་ན་སྤམ་པར་འདུག་སྙམ་ལགས།",
    "གོང་གསལ་བར་འདུམ་ཤོག་ལྷེ་གནང་བར་རྒྱ་ཕྱོགས་སྐུ་ཚབ་ནས་མི་འགྲིག་པའི་རྒྱུ་རྐྱེན་ཇི་སྙེད་ཞུ་རྩིས་ཡོད་འདུག་གཤིས་དབྱིན་གཞུང་ནས་རྒྱ་ཕྱོགས་ལ་གསུང་བཀོད་གནང་བདེའི་ཆེད་ཤོག་ལྷེར་བསྐྱར་བཅོས་དགོས་ལུགས་འབེལ་ས་ཧེབ་ལ་ཡི་གེ་ཕུལ་བའི་ཚིག་གཞིར།",
    "རང་ཕྱོགས་ཀྱི་རྡོ་ཚིག་ལ་ལན་འདེབས་ཞིབ་རྒྱས་ཤིག་ཕུལ་འདུག་པའི་ཚིག་གཞིར།",
    "དེར་ཁས་ལེན་བྱས་ན་སླད་ཕྱིན་རྒྱ་ནག་ལ་སྐྱོན་གྱུར་ཆེན་པོ་ཡོང་བར་འདུག་གསུམ་པར།",
    "འདི་སྐོར་དེང་སྐབས་རྒྱ་ནག་ཡོངས་རྫོགས་ཀྱི་བློ་དང་མཐུན་པ་ཞིག་མ་གཏོགས་བྱེད་ཐབས་མི་འདུག་པ་དང་།",
    "ངེད་ཀྱི་གཞུང་ས་ནས་གཤམ་གསལ་མཐའ་ཚིག་འདི་བཞིན་དགོངས་པར་བབ་ཀྱི་ཨེ་འདུག་མི་འདུག་ཞུ་དགོས་གསུངས་པར་གཅིག་ལ།",
    "ཞེས་ཕུལ་འདུག་པར་ལན་ཡིག་ཐོག་ཕུལ་བའི་ཚིག་གཞིར།",
    "རྒྱ་ཕྱོགས་ལ་སྐྱོན་གནས་ཆེ་བ་མི་འདུག་སྙམ་པའི་བཟོ་དོད་དཀའ་ལུགས་དང་།",
    "ལྷ་སར་རྒྱ་ནག་དཔོན་པོ་ཆེ་བ་གཅིག་འཇོག་སྲོལ་འདུག་པར་སྐུ་སྲུང་བབ་མཚུངས་དང་བཅས་བཞག་འཇོག་ཆོག་པ་བྱས་ཡོད།",
    "བོད་གཞུང་རང་ལ་ཡོད་པ་ཆ་གནས་བྱས་ཡོད།",
    "རྒྱ་དམག་གཏོང་རིགས་ཤར་ཚེ་དམག་ཆས་བབ་མཚུངས་སྩལ་རྒྱུ་ཡིན་ལུགས་བཀའ་གསལ་ཕེབས་ལུགས་གསུངས་འདུག་པར་རྒྱ་ཕྱོགས་ནས་ལུགས་འགལ་སྔར་མི་གྲགས་བགྱིས་པ་ལས་དབྱིན་གཞུང་ནས་ཆིངས་དོན་འདི་སྐོར་འཕྲལ་ཕུགས་དགོངས་བཞེས་ཀྱིས་ཆིངས་ཟིན་དང་།",
    "ད་ཆ་དབྱིིན་བོད་གཉིས་དོན་གཅིག་གྱུར་ལ་བརྟེན་བཀའ་ལན་ཕར་འགྱངས་ཀྱིས་བོད་ཕྱོགས་སྐུ་དོན་ཕྱིར་བཤོལ་ཤར་ཚེ་དབྱིན་གཞུང་ལའང་གནོད་འགལ་ཡོང་གནས་སྟབས་ཕྱི་བློན་ལས་ཚབ་ནས་གང་བཅག་གནང་སྟེ་བཀའ་ལན་རྡོ་གླིང་ཙམ་དུ་གཏོང་རྒྱུ་ཡིན་ལུགས་གསུངས་འདུག་པར་རྒྱ་ཕྱོགས་ཀྱིིིས་ཆིངས་ཡིག་ལ་ས་ཡིག་ཟིན་རུང་།",
    "དབྱིན་གཞུང་སྤང་བླངས་ས་བརྡབས་ཀྱི་རྟགས་འཛུགས་མི་ཞུ་བ་འདི་ཐད་དབྱིན་གཞུང་ནས་བོད་དུ་རོགས་མགོན་དོན་འཁེལ་མི་གནང་བར་ཚོད་རྩིས་ཡིན་པ་མཁྱེན་ཆོད་སྟབས་ད་ཆ་ཞུ་གསལ་རྣམས་ལ་དོན་སྨིན་བཀའ་གསལ་འཕྲལ་མྱུར་ཐོན་པ་མ་བྱུང་ཚེ་དགེ་སྐྱོན་འདི་དང་འདི་འདུག་ཞིབ་གསལ་དང་འབྲེལ་བའི་ཕྱིར་ལོག་ཀྱང་ཞུ་ཐབས་དཀའ་ལུགས་སོགས་གང་ཡོང་ཞུས་ཤིང་།",
    "མི་སེར་གྱི་རྒྱུ་དངོས་འཕྲོག་འཁྱེར་ཚོད་མེད་བྱས་འདུག་ཚ་ལྷོའི་རྒྱ་དཔོན་དྲིན་རྡཱ་ལོ་ཡེར་ནས་ནོར་གླིང་ཡུལ་དགོན་ཚ་ལྷོར་ཁྲལ་རྒྱུགས་སུ་ཡོང་དགོས་དང་།",
    "མི་སེར་༥ ཙམ་རང་མཚམས་འགོ་བཏགས་རྩིས་ལེན་བྱས་འདུག་པ་དང་།",
    "རྒྱལ་ཁབ་ཆེ་བས་ཆུང་བཟོས་ཆོག་པ་རྒྱལ་ཁབ་སྤྱིའི་ལུགས་སྲོལ་ལ་མེད་དེ་སྔ་ལྕགས་སྟག་ལོ་ཀྲུང་དབྱིན་ཆིངས་ཡིག་བཞག་པ་བོད་མིས་མ་ཤེས་པས་དེ་ལ་རྩིས་འགྲོ་མ་བྱུང་རྐྱེན་ཤིང་འབྲུག་ལྷ་སར་ཆིངས་བཞག་ཉིན་ཀྲུང་གོའི་ལྷ་སྡོད་ཨམ་བན་ཡང་ཡོད་གཤིས་བོད་ཀྱི་བདག་པོ་ཀྲུང་གོལ་ཡིན་ཚེ་དེ་སྐབས་ཚིག་བརྗོད་འགོད་དགོས་ཀྱང་མི་འདུག་ཁར།",
    "མཆོད་གཞིས་འགོ་བྱེད་ཁག་ལ་མིང་དང་གོ་གནས་ཏོག་སྒྲོ་གནང་བ་སོགས་ཕུག་ཡུལ་རྒྱ་འོག་འཇུག་རྒྱུའི་དགོངས་བཞེད་གང་མིན་བྱུང་འདུག་ཀྱང་།",
    "བོད་ཀྱི་མི་དྲག་ཁང་ཆེན་པས་སྟོད་མངའ་རིས་སྐོར་གསུམ་གྱི་དཔུང་དམག་བསྐུལ་ཏེ་ཡོང་སྐབས་ནག་ཚང་བརྒྱུད་ཕྱིར་བྲོས་བགྱིས་འདུག་པ་དང་།",
    "རྒྱའི་མངའ་འོག་ཡིན་ཚེ་དམག་དུས་སོ་སོར་རྒྱ་དཔོན་དམག་ངེས་པར་དགོས་གནས་ཀྱང་དེ་སྔོན་ལ་སིང་དཔུང་འཇུག་ལྷོ་འབྲུག་པར་དཔུང་འཇུག་ཤིང་ཡོས་གོར་བོད་དམག་འཁྲུགས།",
    "ཕྱི་བོད་གཉིས་རང་ནས་རྟགས་འཇོག་འཁྲུན་གཅོད་བྱས་འདུག་དམག་རོགས་བྱས་པ་ཙམ་གྱིས་མངའ་ཞབས་སུ་ཚུད་ཀྱི་ཡོད་ཚེ་ཉག་རོང་ལྕགས་མདུད་མགོན་པོ་རྣམ་རྒྱལ་ནས་ཧོར་སེར་ཁག་ལྔ་དང་།",
    "ཀྲུང་གོའི་ནས་བོད་མངའ་ཁོངས་ཡིན་ལུགས་དབྱིན་གཞུང་ལ་དབུ་སྐོར་མཛད་འདུག་པ་དང་།",
    "དེ་རྗེས་རྒྱ་ཕྱོགས་ནས་སྐུ་སྐྱེ་ངོ་ནོར་མི་འབྱུང་ཆེད་གསེར་བུམ་དཀྲུག་འདོན་བྱས་ན་ལེགས་ལུགས་མཆོད་ཡོན་གྱི་བར་ལ་ཕན་སེམས་ལྟ་བུའི་བཀའ་སློབ་གནང་འདུག་པ་སྐུ་འཕྲེང་གསུམ་རིང་གསེར་བུམ་དཀྲུག་འདོན་བྱས་རུང་།",
    "རྒྱ་བོད་དབྱིན་གསུམ་གྱི་སྐུ་ཚབ་ཚོ་ཕྱི་ལོ་༡༩༡༣ ཟླ་༡ ཚེས་༡༣ སིམ་ལ་ལ་འཛོམས་འདུག་ཆིངས་ཡིག་དངོས་གཞི་དེ།",
    "བོད་ལུགས་ཤིང་སྟག་ཟླ་༥ ཚེས་༡ ལ་བཞག་འདུག་༣ སིམ་ལའི་ཆིངས་ཡིག་གྲོས་རིམ་ནང་དངོས་སུ་ཞུགས་མཁན་གྱི་མི་སྣ་ངོ་སྤྲོད།",
    "བྱུང་ན་རྒྱལ་རྩེ་ནས་ཡིག་འགྲུལ་ལ་སོགས་པས་ཐག་ཆོད་མིན་ཡོང་འདུག་པ་རྒྱལ་རྩེར་བཞུགས་པའི་དབྱིན་གཞུང་སྐུ་ཚབ་སྐུ་སྲུང་འཁྲིད་ནས་ལྷ་སར་འགྲོ་ཆོག་པ་བྱས་ཡོད།",
    "ཁོ་པས་བོད་ཀྱི་ཆབ་སྲིད་གནས་བབ་དབྱིན་གཞུང་ལ་སྙན་སེང་ཞུས་པ་མ་ཟད་ལྷ་སའི་ཆགས་དབྱིབས་ཀྱི་ས་ཁྲའང་བླངས་ཏེ་ཁྱེར་ཡོད་འདུག།",
    "ཅེས་གསལ་འདུག་པ་ལྟར་ཡིན།",
    "དབྱིན་ཇིའི་གོང་མ་ཆེན་པོར་སྙན་སེང་ཞུ་རོགས་ཞེས་བཀའ་མངགས་བསྩལ་འདུག་བོད་ཀྱི་སྲིད་དོན་རྒྱལ་རབས་སྨད་ཆ་ཤོག་ངོས་༡༥༦ལ་གསལ།",
