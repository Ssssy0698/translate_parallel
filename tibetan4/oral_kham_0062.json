    "ཾ་ཉམས་རྟོགས་ཀྱི་ཡོན་ཏན་བསམ་གྱིས་མི་ཁྱབ་པ་རྒྱུད་ལ་འཁྲུངས་ཤིང་རང་དོན་མཁྱེན་གཉིས་ཀྱི་ཡེ་ཤེས་མངོན་དུ་བསྐྲུན་པར་མཛད་དོ།",
    "བདེ་སྟོང་ཉམས་འུར་གྱི་བརྡ་གླུ་ཐོས་པ་ཙམ་གྱིས་དར་ཅིག་གུ་རུའི་ཐུགས་ཀློང་བསམ་གྱིས་མི་ཁྱབ་པའི་ཡེ་ཤེས་ཆེན་པོའི་དབྱིངས་དང་རང་རིག་འོད་གསལ་གྱི་ངོ་བོ་གཉིས་དབྱེར་མེད་ཀྱི་ངང་དུ་དུས་ཡུན་ཙི་ཙམ་འགོར་བར་མ་ཤེས་པར་ལུས།",
    "ཕྱིའི་ནངས་པར་ཇི་ལྟ་བཞིན་འདུག་པ་ཉེ་འཁོར་རྣམས་ཀྱིས་མཐོང་ཡང་གཞན་ལ་མི་སྨྲ་བའི་བཀའ་དམ་བསྒྲགས།",
    "དེ་དང་དུས་མཚུངས་སུ་གཡུང་དྲུང་བོན་གཏེར་ཞིག་ཀྱང་ལེན་སྐལ་འདུག་པས་དེ་ཉིད་བླངས་ནས་བདག་ལ་གནང་རོགས་ཞེས་བཀས་སྐུལ་གནང་།",
    "གནས་མུན་ཁུང་དྲོ་སར་འདུག་པའི་ལོ་མ།",
    "གནས་ཆུ་འགྲམ་བསིལ་སར་འདུག་པའི་ལོ་མ།",
    "སྤྱོད་ལམ་དལ་བར་འདུག་པའི་ལོ་མའོ།",
    "གནས་དྲོ་སར་འདུག་པའི་ལོ་མ།",
    "དེ་ཤེས་ཀྱང་རང་བཟོའི་ཟོལ་སྤངས་ནས་ལག་ལེན་ཆོ་ག་རྣམས་གཞུང་བཞིན་ཚད་ལྡན་དུ་སྦྱར་པའི་ལག་ལེན་ཐེབས་པའམ་ལས་འབྲས་གཙང་བའོ་༢།",
    "དྭངས་མ་སོགས་གནོད་བྱ་རྣམས་རང་རང་རྒྱུ་བའི་བུ་གར་སྐྱེལ་བ།",
    "དེ་བརྒྱ་ཉི་ཤུ་ལ་དེའི་སྐད་ཅིག་མ་གཅིག་དེ་དྲུག་ཅུ་ལ་ཐང་ཅིག་ཐང་སུམ་ཅུ་ཡུད་ཙམ་གཅིག་ཡུད་ཙམ་སུམ་ཅུ་ཉིན་ཞག་གཅིག་ཉིན་ཞག་སུམ་ཅུ་ཟླ་བ་གཅིག་ཟླ་བ་གཉིས་དུས་གཅིག་དུས་དྲུག་ལ་ལོ་གཅིག་གོ།",
    "ཙོག་པུར་འདུག་དང་ལངས་མི་ཐུབ།",
    "ཡིད་འོང་སྙན་ཚིག་བསིལ་གནས་དལ་བར་འདུག།",
    "འཇུག་དུས་སྟོན་ནམ་དཔྱིད་དུས་ཡིན།",
    "དང་པོ་འཇུག་དུས་ཆུ་ཚན་ཆུ་སྐྱུར་སྐྱུག།",
    "རྒྱ་ཤལ་སྐྱུག་དུས་ཙན་དན་གུར་ཀུམ་དང་།",
    "ཁྲག་རུལ་དུད་ཁུ་སྐྱུག་དུས་སེ་འབྲུ་དང་།",
    "དོན་ལྔ་རང་རང་རྩ་ལ་གཏར་བ་སྟེ།",
    "བསིལ་བའི་གནས་སུ་ལུས་སེམས་དལ་བར་འདུག།",
    "རང་རང་སྐབས་ཐོབ་བཅོས་པ་རིག་པས་དཔྱད།",
    "སྤྱོད་ལམ་དྲག་ཤུལ་སྤངས་ལ་སྙོམལས་པར་འདུག།",
    "སྤྱོད་ལམ་བསིལ་གནས་ལུས་ངག་དལ་བར་འདུག།",
    "དྲག་ཤུལ་ལས་སྤང་དྲོ་བའི་གནས་སུ་འདུག།",
    "འོན་ཀྱང་རྩ་རྒྱུད་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "དེ་ནས་རང་རང་རྩའམ་གང་རྒྱས་གཏར།",
    "རང་རང་སྔགས་ཀྱིས་བརླབས་ལ་འཆང་བས་ཐུབ།",
    "འོག་ཏུ་བྱེ་བྲག་རང་རང་ལེའུར་གསལ།",
    "གཤམ་དུ་རང་རང་སྐབས་སུ་སྟོན།",
    "མགོ་ན་ཁ་ཡོ་སོ་དྲེག་ཆགས་ཉལ་འདུག་དཀའ།",
    "རང་རང་འདུ་བའི་ཁ་འཛིན་དཔུང་དང་བཅས།",
