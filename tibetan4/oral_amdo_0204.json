    "འོད་སྲུངས་ཚུར་ཤོག་ཚངས་པར་སྤྱད་པ་སྤྱོད་ཅིག་ཅེས་དེ་འཁོར་ལྔ་བརྒྱ་དང་ཐབས་ཅིག་རབ་ཏུ་བྱུང་པ་དང་བསྙེན་པར་རྫོགས་པ་དགེ་སློང་གི་དངོས་པོར་གྱུར་ཏོ།",
    "ག་ཡ་འོད་ཆུ་ཀླུང་ནེ་རཉྫནའི་འཇུག་ངོགས་ཀྱི་འགྲམ་དུ་དཀའ་ཐུབ་སྲུངས་གཉིས་འཁོར་ཉིས་བརྒྱ་ལྔ་བཅུ་རེ་དང་།",
    "བདག་ཅག་གི་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་ལ་རྒྱལ་པོ་འམ་ཆོམ་རྐུན་ལ་སོགས་པའི་གནོད་པའི་ཉེས་དམིགས་བྱུང་པར་མ་གྱུར་གྲང་སྙམ་ཞིང་འོད་སྲུངས་སྤུན་གཉིས།",
    "བདག་ཅག་ཀྱང་ལན་གཉིས་སུ་དགེ་སྦྱོང་ཆེན་པོའི་དྲུང་དུ་རབ་ཏུ་བྱུང་གིསབཅོམ་པར་བཀུར་བ་ཡང་།",
    "བསྙེན་པར་རྫོགས་པ་དགེ་སློང་གི་དངོས་པོ་འཐོབ་པ་ལྟ་ན།",
    "རེ་ཤིག་འཁོར་ལ་བལྟོས་ཤིག་ཅེས་བཀའ་སྩལ་པ་ནས།",
    "ཚུར་ཤོག་གིས་བསྙེན་པར་རྫོགས་པར་གྱུར་ཞིང་།",
    "ཀྭ་ནང་རྗེ་ཚུར་ཁྱོད་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་ལ།",
    "ཁོ་བོའི་ཚིག་གིས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱོས་ལ།",
    "རེག་པར་སྤྱོད་དམ་ཞེས་ཞུས་ལ།",
    "རྒྱལ་པོས་ཐོས་རྣམས་ཀྱི་མཆོད་རྟེན་ལེགས་པར་རབ་གནས་ལྟང་བྲང་གི་ཚལ་དུ་གཤེགས་ཏེ་བཞུགས་པནས།",
    "བཅོམ་ལྡན་འདས་ལ་བལྟ་བ་དང་བསྙེན་བཀུར་བྱ་བའི་ཕྱིར་སོང་པ་ན།",
    "བདག་གི་ལས་སྐྱོན་ཅན་ཅུང་ཟད་མ་བྱས་སམ།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ཀྱིས་ལས་སྐྱོན་ཅན་མ་བྱས་མོད་ཀྱི།",
    "ཁྱོད་དང་ལས་མཚུངས་པར་སྤྱོད་པ་དེ་རྣམས་བཙོན་ར་ན་འདུག་གིསདེ་དག་ཐོན་ཅིག་ཅེས་སྨྲས་པ་ལྟར།",
    "དེའི་དབུ་ལྷ་རྣམས་ཀྱི་རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ཀྱིས་ལས་སྐྱོན་ཅན་མ་རྒྱན་སྒོ་ལ་ཐུག་ཅིང་སྔར་ལྟར་ཐེ་ཚོམ་སྐྱེས་བ་ན།",
    "ཁ་ཅིག་ཁྱོད་དང་ལྷན་ཅིག་ལས་མཚུངས་པར་སྤྱོད་པ་གང་ཡིན་པ་དེ་ལས་ཁ་ཅིག་ནི་འདུསབྱས་མོད་ཀྱི།",
    "ཡུལ་ཕྱོགས་ག་གེ་མོར་ལས་ཀྱི་མཐའ་བྱེད་ཅིང་འདུག་པ་སྦྲོན་ཅིག།",
    "ཅི་ཙམ་ཞོན་པ་ལས་བབས་ཤིང་རྐང་པ་ཁོ་ནས་ཀུན་དགའ་ར་བར་ཞུགས་པ་ལསདུ་བཞོན་པས་སོང་ནས།",
    "ཐལ་མོ་སྦྱར་བ་བཏུད་དེ་རང་གི་མིང་ནས་སྨོས་ཏེ་ལན་གསུམ།",
    "ཁྱོད་རང་གི་སྟན་ཅི་ལྟ་བ་ལ་འདུག་ཅིག།",
    "དེའི་དུས་སུ་བྲམ་ལས་ཐལ་མོ་སྦྱར་ནས་འཁོད་ཅིང་།",
    "ཁྱིམ་བདག་ཕལ་མོ་ཆེས།",
    "ལྟེང་རྒྱས་གནས་པ་ཁྱོད་འདིར་ཅི་མཐོང་ནས།",
    "ཁྱོད་ཀྱིས་ཇི་ལྟར་མེ་ཡི་མཆོད་སྤངས་པ།",
    "འདོད་པ་དག་དང་བུད་མེད་ཁོ་ན་སྨྲ།",
    "ཁྱོད་ནི་འདོད་དང་བཟའ་དང་བཏུང་བ་དང་།",
    "ལྷ་མིའི་འཇིག་རྟེན་ལ་ཅི་ཁྱོད་ཀྱི་ཡིད།",
    "ཐུབ་པ་གོ་ཏ་མ་རྣམ་པར་འདྲེན་ཁྱོད་ནི།",
    "ཁྱོད་ཀྱིས་རྟོགས་པ་ལེགས་རྟོགས་ཏེ།",
    "ཁྱོད་ཀྱིས་ཉེས་པར་བསམ་མ་ཡིན།",
    "རང་གི་སྟན་ལས་མི་སྣང་བར་གྱུར་ཞིང་།",
    "སྟོད་ནས་ཆུ་གྲང་མོའི་རྒྱུན་འབེབས་ཤིང་།",
    "བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ཞིང་པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ནས།",
    "བཅོམ་ལྡན་འདས་ནི་བདག་གི་སྟོན་པ་ལགས་སོ།",
    "ང་ནི་ཁྱོད་ཀྱི་སྟོན་པ་ཡིན་ནོ།",
    "ཁྱོད་ནི་ངའི་ཉན་ཐོས་ཡིན་ནོ།",
    "འོད་སྲུངས་ཁྱོད་རང་གི་སྟན་ཇི་ལྟ་བ་ལ་འདུག་ཅིག་ཅེས་གནང་བས།",
    "འདི་ལ་བདག་དང་བདག་གི་བ་མེད་ཀྱི།",
    "འདི་ནི་བདག་གི་བདག་གོ་ཞེས་བདག་ཏུ་ཁས་ལེན་པར་བྱེད་དམ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་སོང་ངོ།",
    "རྒྱལ་པོའི་ཁབ་ཏུ་སོང་ཞིང་།",
    "དེའི་མཚན་མོ་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའ་བ་དག་སྟ་གོན་བྱས་ཏེ།",
    "དགེ་སློང་གི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་ཞིང་།",
    "བོད་རྒྱལ་པོས་རང་གི་ལག་ནས་བསོད་སྙོམས་ཕུལ་ཞིང་ཚིམ་པར་བྱས་སོ།",
    "ཤིང་གི་ལྷ་ལ་བུ་སྟེར་ན་མཆོད་ཅིང་།",
    "ཚངས་པས་རང་གི་འཁོར་ཚེ་ཚད་རྫོགས་པ་ཅིག་ལ།",
    "བཟང་མོ་ཀུན་ཏུ་རྒྱུའི་ནང་དུ་གནས་པའང་དུས་རིང་ཞིག་ན་སྐྱེ་དགུའི་བདག་མོས་བསྙེན་པར་རྫོགས་ཏེ་དགྲ་བཅོམ་པར་གྱུར་ཏོ།",
    "འཇིགས་པའི་རྒྱུ་ལས་མ་ཡིན་པས་རྒྱུ་གཉིས་པ་སང་ཤེས་པར་བྱའོ་སྙམ་མོ།",
    "དེ་དག་གིས་ཀུན་དུ་སྤྱོད་པ་ནི།",
    "གང་གི་ཚེ་དཔྲལ་རིས་གསུམ་བྱས་ཏེ་སྤྱོད་ཡུལ་དུ་འདོང་བ་ན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་དག་གི་རྒྱུད་ཡོངས་སུ་སྨིན་པ།",
    "ཁྱོད་ཀྱིས་ཀུན་དུ་རྒྱུ་ཉེ་རྒྱལ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་སོང་ངོ།",
    "དེ་ཉིད་ཀྱི་མཚན་མོ་འདས་པ་སྔ་དྲོའི་དུས།",
    "ཀུན་དུ་རྒྱུ་ཉེ་རྒྱལ་ཀྱང་རྒྱལ་པོའི་ཁབ་ཏུ་བྱ་བ་འགའ་ཞིག་གི་ཕྱིར་འོངས་པས་མཐོང་ནས།",
    "དགེ་སྦྱོང་ཁྱོད་ཀྱི་སྟོན་པ་ནི་གང་ཡིན།",
    "གང་གི་ཕྱིར་རབ་ཏུ་བྱུང་།",
    "ཁྱོད་ཀྱིས་དོན་མང་ཡང་རུང་།",
    "པང་ན་སྐྱེས་གང་ན་བ་དེར་སོང་བ་དང་།",
    "ཁྱོད་ཀྱིས་བདུད་རྩི་རྙེད་དམ།",
    "ཀུན་དུ་རྒྱུ་པང་ན་སྐྱེས་བདེན་པ་མཐོང་ནས་ཐལ་མོ་སྦྱར་ཞིང་ཆེད་དུ་བརྗོད་པ་སོགས་སྔར་བཞིན་བྱས་ཏེ།",
