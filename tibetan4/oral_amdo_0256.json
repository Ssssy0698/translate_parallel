    "གཟུགས་མེད་པ་ན་སྤྱོད་པ་རང་གི་ས་པ་རྣམས་དང་།",
    "ཕྱི་རོལ་པའི་སོ་སོ་སྐྱེ་བོ་ནི་རང་གི་ས་པ་རྣམས་ཁོ་ན་རྣམ་པར་ཤེས་སོ།",
    "ཡང་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "སེམས་གང་གནས་ངན་ལེན་དང་བཅས་པ་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "དེ་ལ་ཐོག་མ་ཁོ་ནར་ཕན་ཚུན་དུ་བལྟ་བས་ན་མིག་གི་ཁམས་བསྟན་པའོ།",
    "བུད་མེད་ཀྱི་རེག་པ་ལ་ཡོངས་སུ་སྤྱོད་པས་ལུས་བསྙད་དོ།",
    "སྲེད་པ་རྣམ་པ་བཅུ་གཅིག་གི་སྐབས་ཀྱི་གཟུགས་ལ་སོགས་པ་འདས་པ་ལ་སོགས་པའི་རྣམ་པར་བཞག་པ་ཡིན་ནོ།",
    "བདག་ལ་ནང་གི་སྲེད་པའམ།",
    "ཉོན་མོངས་པ་ཅན་དང་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་བྱེ་བྲག་དང་སྦྱར་བར་བྱ་སྟེ།",
    "འཛིན་པ་ནི་ནང་གིའོ།",
    "ཡང་གཟུགས་ལ་སོགས་པ་ལ་བརྟེན་ནས་ཉོན་མོངས་པ་དང་ལས་དང་སྐྱེ་བའི་ཀུན་ནས་ཉོན་མོངས་པའི་ཁུར་ཁྱེར་བ་ཉིད་ཀྱི་ཕྱིར་ཏེ།",
    "ལུས་གྱི་ཕྱོགས་གང་གིས་ཁུར་ཁྱེར་བ་དེ་ལ་ཕྲག་ཁུར་ཁྱེར་བ་ཞེས་བརྗོད་པ་བཞིན་ནོ་། ཁམས་ཀྱི་དོན་གང་ཞེ་ན།",
    "ཡང་རང་གི་མཚན་ཉིད་མི་འདོར་བར་འཛིན་པའི་དོན་ཏོ།",
    "འདུ་བྱེད་རྣམས་ནི་ཆུ་ཤིང་གི་ཕུང་པོ་ལྟ་བུའོ།",
    "རང་གི་དངོས་པོ་དེ་ལས་གཞན་པའི་དོན་ལ་མི་ལྟོས་པ་དེའི་བློ་འབྱུང་ཞིང་རང་གི་མཚན་ཉིད་གྲུབ་པ་ནི་རྫས་སུ་ཡོད་པའོ།",
    "རང་གི་དངོས་པོ་དེ་ལས་གཞན་པའི་དོན་ལ་ལྟོས་པ་དང་བཅས་པ་ནི་བཏགས་པའི་ཡོད་པའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་འཕེལ་བར་འགྱུར་བའི་དམིགས་པ་ནི་ཀུན་རྫོབ་ཏུ་ཡོད་པའོ།",
    "ཉོན་མོངས་པའི་དམིགས་པར་འགྲོ་རུང་བ་ཐམས་ཅད་ཀྱང་ཀུན་རྫོབ་ཏུ་ཡོད་པའོ།",
    "པགཟུགས་ཅན་མ་ཡིན་པའི་ཁམས་གང་དུ་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "སེམས་གང་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "སེམས་བྱུང་འདོད་ཆགས་ལ་སོགས་པ་དང་དད་པ་ལ་སོགས་པ་གང་གིས་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "མོས་པའི་སྟེ་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པའི་སྤྱོད་ཡུལ་དང་།",
    "སོ་སོར་རང་གིས་དོན་དམ་པ་ཤེས་པའི་སྤྱོད་ཡུལ་དང་།",
    "དེ་དག་གི་གཉེན་པོ་དང་།",
    "ཕྱོགས་ཆེ་གེ་མོ་ཞིག་ན་འོ་ཞེས་ཡུལ་ཉེ་བར་བསྟན་དུ་རུང་བ་དང་།",
    "ཕུང་པོ་ལྔ་པོ་དག་ལག་པ་ལ་སོགས་པས་ཀུན་ཏུ་རེག་པ་དང་མྱ་ངན་ལ་སོགས་པས་གནོད་པར་བྱ་བ་ཡིན་པ་དང་།",
    "རྡུལ་ཕྲ་མོ་ལས་ཆ་ཤས་ཅན་གྱི་གཟུགས་བསགས་པ་རྣམ་པར་གཞག་པ་དང་།",
    "ཕྱི་རོལ་དུ་བལྟས་པ་ལ་སོགས་དྲུག་ནི་ཚོར་བ་ལ་སོགས་པ་དང་ཐུན་མོང་དུ་གྱུར་པས་སམ་ཡང་ན་ཅི་རིགས་སུ་ཕལ་ཆེར་གཟུགས་ཅན་ཡིན་པར་སྦྱར་རོ།",
    "མིག་གི་ཡུལ་དུ་གྱུར་པ་རྣམས་ནི་བསྟན་དུ་ཡོད་པའོ།",
    "ཡང་ན་མིག་གི་ཡུལ་མིན་པ་རྣམས་སོ་ཞེས་ཅི་རིགས་སུ་སྦྱར་རོ།",
    "གཏི་མུག་གི་ངོ་བོ་གང་ལ་བརྟེན་ནས་མཚོན་ཆ་ལེན་པ་དང་།",
    "ཀུན་གཞི་ལས་ས་གཞན་གྱི་ཉོན་མོངས་ཀྱི་གནས་ངན་ལེན་དང་ལྡན་པས་དེའི་རྗེས་སུ་འབྲེལ་བ་དང་།",
    "གཏི་མུག་གི་ངོ་བོ་གང་ལ་བརྟེན་ནས།",
    "དོན་གང་གིས་འདུས་བྱས་སུ་གྱུར་པའི་དོན་དེས་འདུས་མ་བྱས་མ་ཡིན་ནོ།",
    "དོན་གང་གིས་འདུས་མ་བྱས་སུ་གྱུར་པའི་དོན་དེ་ཉིད་ཀྱིས་འདུས་བྱས་མ་ཡིན་ཏེ།",
    "ནང་གི་སྐྱེ་མཆེད་དྲུག་དང་།",
    "ད་ལྟར་གྱི་རང་གི་མཚན་ཉིད་སོ་སོར་འཛིན་པ་སྒོ་ལྔའི་ཤེས་པ་དང་།",
    "ཇི་ལྟར་ན་ཉོན་མོངས་པ་ཅན་ཡིན།",
    "ཉོན་མོངས་པ་ཅན་རྣམས་ནི་དུ་ཞིག།",
    "ཅིའི་ཕྱིར་ཉོན་མོངས་པ་ཅན་དུ་བརྟག་ཅེ་ན།",
    "ཇི་ལྟར་ན་ཉོན་མོངས་པ་ཅན་མ་ཡིན།",
    "ཉོན་རོམོངས་པ་ཅན་མ་ཡིན་པ་རྣམས་ནི་དུ་ཞིག།",
    "ཅིའི་ཕྱིར་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པར་བརྟག་ཅེ་ན།",
    "ཁམས་དང་སྐྱེ་མཆེད་ལྷག་མ་རྣམས་ཀྱི་ཕྱོགས་གཅིག་ཉོན་མོངས་པ་ཅན་རྣམས་དོར་བའི་ལྷག་མ་དག་གོ།",
    "ལྟོས་པས་ཀུན་ནས་ཉོན་མོངས་པའི་མཚན་མ་སྟེ་དེ་སྐྱེ་བའི་དམིགས་ཡུལ་ཙམ་དུ་ཡོད་པ་དང་བཏང་སྙོམས་ཀྱིས་མ་ཆགས་པ་ལ་སོགས་པའི་རྣམ་པར།",
    "རང་གི་མཚན་ཉིད་མ་ཐོབ་པ་དང་།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་གཉིས་ཀའི་དངོས་པོ་ཉེ་བར་མི་གནས་པ་དང་།",
    "རྒྱུ་ས་བོན་གྱི་མཚན་ཉིད་དང་དངོས་པོ་རང་གི་མཚན་ཉིད་རིམ་པ་ལྟར་ཡོད་པ་དང་།",
    "ཆགས་སོགས་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱིས་སོ་སོ་རང་ཏེགིས་རིག་པར་བྱ་བ་དང་།",
    "དད་པ་ལ་སོགས་པ་དེས་ཀུན་ནས་བསླང་བའི་ལུས་དང་ངག་གི་ལས་སོ།",
    "འཕགས་པའི་མཉམ་གཞག་གི་ཡུལ་དུ་གྱུར་པ་དེ་བཞིན་ཉིད་དོ།",
    "སྐྱེས་ཐོབ་དེས་དེ་དག་ཉིད་ལ་རང་བཞིན་གྱིས་ཏེ་རང་གི་ངང་གིས་སོ་སོར་མ་བརྟགས་པར་སྐྱེ་བས་ཐོབ་པའི་འདོད་པ་དང་།",
    "དེ་དག་རི་མོར་བྲིས་པ་མདུན་དུ་བྱས་སམ།",
    "གང་ཟག་གི་བདག་མེད་རྟོག་པ་ཉོན་མོངས་པའི་སྒྲིབ་པའི་གཉེན་པོ་དང་།",
    "བྱའི་ཉོན་མོངས་པ་མཐའ་དག་སྤོང་བ་དང་།",
    "ཉོན་མོངས་པའི་གནས་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་དང་།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་དང་དེ་དང་མཚུངས་པར་ལྡན་པའི་ཉོན་མོངས་པ་བཞི་མ་གཏོགས་པ་རྣམས་དང་།",
    "གཟུགས་དང་གཟུགས་མེད་པ་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་དག་ཀྱང་མ་གཏོགས་པར་དེ་ལས་གཞན་འདོད་ཁམས་པའི་རྩ་བའི་ཉོན་མོངས་པ་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པ་དང་།"
  ]
}