    "གང་དག་མི་འགྲོ་བ་དེ་དག་དུས་གསུམ་གྱི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་གཉིས་སུམེད་པའི་ཡེ་ཤེས་ལས་བྱུང་བའི་ཁྲོ་བོའི་རྡོ་རྗེ་འབར་ཞིང་རབ་ཏུ་འབར་བ་འདིས་ཁྱེད་རྣམས་ཀྱི་མགོ་བོ་ཚལ་པ་བརྒྱར་འགས་པར་འགྱུར་རོ།",
    "ཁྱེད་རང་རྣམས་མི་དམིགས་ཏེ་སྟོང་པ་ཉིདདུ་གྱུར།",
    "ཁྱེད་རང་རྣམས་མི་དམིགས་ཏེ་སྟོདཔ་ཉིད་དུ་གྱུར།",
    "ཁྱེད་རང་རྣམས་བཙེམ་ལྡན་འདས་ཁྲོ་བོའི་རྒྱལ་པོ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བ་ནས་མེ་འབར་བའི་དབུས་ན་བཞུགས་པར་གྱུར།",
    "དེ་ནས་བཛྲ་མུ་ཡིས་ཚོགས་ཞིང་རང་གནས་སུ་གཤེགས།",
    "ཅེས་པ་འདིའང་རང་རྒྱུད་འཕགས་མཆོག་རྡོ་རྗེ་ནས་ལྷ་རྩེག་དང་རིག་གཉིས་འཁོར་ལོ་ཟུང་ལྡན་བཅས་ནན་བསྐུལ་ངོར་༧ ཀྑ།",
    "བདག་ཅག་དུས་གོས་ལ་བཙུགས་ནས་ནི།",
    "བ་ར་བ་ཙ་ན།",
    "ཁྱེད་ལ་མ་རྒྱུད་ཀྱི་གདམས་ངག་ཟབ་ལ་མང་བ་བརྡ་བ་གདའ་བས།",
    "དེ་དུས་ན་མཁས་པ་སྒོ་དྲུག་ནི་གྲོངས་ཚར་ནས་མི་འདུག་གསང་འདུས་སློབ་དགོངས།",
    "འཇད་ཀྱི་ལུང་པ་སྟོང་པར་ཡོད་པ་དེར་བསྡད་ཙ་ན་འགོས་དང་མཇལ།",
    "འདི་བྱ་སྤྱོད་ལ་ཤིན་ཏུ་མཁས་པ་གཅིག་ཡིན་པར་འདུག་ཅིང་།",
    "དེ་ཡང་རང་བཞིན་རྒྱུད་ཀྱི་ཁྱད་པར་དང་།",
    "སྐབས་མང་པོར་ནི་མཆན་ཆེན་གྱི་ཡིན་ཚོད་དུ་འདུག་སྟེ།",
    "རྗེས་ཀྱང་བུ་ཊཱིཀ་སྟེང་ནས་ཚར་གསུམ་གསན་པ་དེའི་འབྲེལ་དང་ཞེན་པར་གདའ།",
    "དེ་ཚོའི་གསུང་སྐྱོར་ཙ་ན།",
    "ཤོག་དྲིལ་གསུམ་དང་མ་མཇལ་ཚོད་དུ་འདུག་ཏེ།",
    "སེམས་ལ་སྣང་བ་དང་རང་བཞིན་བདེ་པའི་ཡེ་ཤེས་ལ་དམིགས་པ་ཙམ་ཞིག་ནི།",
    "སྤྲིན་གྱིས་ཀུན་ཏུ་རང་རང་གོ་སར་ཁྱབ།",
    "འཇིག་རྟེན་གསུམ་མཆོག་ཉན་ཐོས་དང་རང་རྒྱལ་ཏེ།",
    "རྣལ་འབྱོར་པ་བདག་ཉིད་དང་རང་ལས་གཞན་ལྷ་རྣམས་ལ་མཆོད་ཅིང་ཚིམ་པར་བྱ།",
    "ཐམས་ཅད་རང་བཞིན་ནི་ཀུན་རྫོབ་སྒྱུ་མ་ལྟ་བུ་འོད་ཟེར་ཡང་རང་བཞིན་དང་ཞེས་རང་དུ་བྱ་སྟེ་གསལ་བ།",
    "ཕྱག་རྒྱ་འདུ་ཞིང་རང་ཉིད་ལྷར་བསྒྲུབ་པ་ནི།",
    "གཞུང་རང་ན་རིན་ཆེན་སྣ་བཞི་སོགས་ཀྱི་དབུ་ན་བཞུགས་ཀྱང་།",
    "གསལ་ཞིང་རང་བཞིན་གྱི་དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་དྲི་མ་མེད་པ་དྲན་པ་ཉེ་བར་བཞག་པ་ལ་སོགས་པའི་རང་བཞིན་རིགས་དང་།",
    "ཅུ་བའི་ངག་ལ་མི་ཉན་པ་ལ་ཁོ་རང་ཡང་ཐུབ་ནས་འདུག་ཅེས་སྤྲིངས་པ་དང་འདྲའོ།",
    "མཚོན་ཆའི་མཆོག་བརྒྱ་བྱིན་ལ་སོགས་པའི་བགེགས་ཀྱིས་མི་ཚུགས་པའི་མིག་སྐྱོད་ཙ་ན་མཚོན་ཆ་དེ་གཉིས་ཀྱི་འོད་རྣོན་པོས་བགེགས་ཚར་བཅད་པ་དེ་བསྒོམ།",
    "དེ་མ་བརྟེན་ཏེ་རིམ་གྱིས་མཆོག་ཀྱང་འགྲུབ་ཅེས་པ་ནི་རྡོ་རྗེ་འོད་གསལ་བ་དམ་ཚིག་དུས་གཅིག་པར་གྱུར་པས་ནི་བསྒྲུབས་ཤིང་དེར་བདག་ཉིད་བསྐྱེད་ན་ནི།",
    "ཕུར་བུའི་རང་བཞིན་སྟོད་ཁྲོ་བོའི་རང་བཞིན་ལ་སྨད་མདུང་རྩེ་གཅིག་པའི་དབྱིབས་སུ་འདུག་པར་བསམས་ཏེ།",
    "སྣ་ཚོགས་རྡོ་རྗེའི་སྟེང་ནས་ཧ་ལྗང་ཁུ་མ་འདུག་པ་དེ་ལ།",
    "ཁ་དོག་དམར་པོ་ལྷང་ངེར་འདུག་པ་རྣམ་པར་ཏེ་གསལ་བར་བསམ་པ་ལ་རྒྱུ་ནི།",
    "ལོ་ཙ་ནེ་ནི་དེ་གསལ་བར་བྱེད་པའོ།",
    "ཡེ་ཤེས་ཀྱི་དཀྱིལ་རྒྱལ་ལ་གནས་ནས་བསྒྲུབ་བྱ་སྐུའི་དམ་ཚིག་པད་མའི་ནང་དུ་རྡོ་རྗེ་ཚམས་ངམ་གྱིས་བསྒུལ་བསྐྱོད་ཀྱིས་གནོན་ཅིང་སྒུལ་མི་ཤེས་པར་བྱེད་པ་སྟེ་ཚར་གཅོད་པ་ཞེས་བྱ་བ་སྟེ་ཕུར་བུས་སྔགས་འདི་རྡོ་རྗེ་འཆང་རང་ཉིད་ཀྱི་སྐུ་ཁོག་པ་དང་གསུང་མགྲིན་པ་དང་ཐུགས་ཡེ་ཤེས་ཀྱིས་བསྐྱོད་དེ་རྡོ་རྗེ་ལས་ཕྱུང་ངོ་མིང་མཐའ་མེད་ཅེས་བྱ་དོན་བོད་རྦད་སྤེལ་བ་མ་ར་ཡ་དང་སྤེལ་བཟླས་ཐབས་ངག་གསང་།",
    "ལུས་ཏིལ་མར་གྱིས་བྱུགས་པ་འདར་ཞིང་འདུག་པ་ཞིག་བསམས་ལ་དེ་གསད་པའི་ཕྱིར་ལྷ་ཚོགས་ལ་བཀའ་བསྒོ་སྟེ།",
    "ལྷའི་གཟུགས་ཀྱང་རང་བཞིན་དག་ཅིང་འོད་གསལ་པའི་དེ་ཁོ་ན་ཉིད་ལ།",
    "ཐུགས་ནི་དགེས་ཤིང་རངས་པར་གྱུར་ནས་ཀྱང་།",
    "ཟུང་འཇུག་སློབ་བཞིན་པ་མི་སློབ་པར་འགྲོ་བའི་རྨི་ལམ་རྨིས་ཀྱང་རྨིས་མ་ཐག་ཏུ་མི་སློབ་པ་མི་ཐོབ་པར་འདུག་པས་ན་གནས་སྐབས་ཐ་དད་དོ།",
    "སེམས་ཀྱི་འདུག་ལུགས་ལ་ཡང་དབྱིབས་དང་ཁ་དོག་མེད་ལ།",
    "དཔེ་དེ་བཞིན་དུ་སྟེ་རྣམ་པ་འདིས་བཅོམ་ལྡན་འདས་ཤེས་བྱ་ཇི་ལྟ་འདུག་པ་དང་ཇི་ལྟ་ཡོད་པ་དེ་བཞིན་རྟོག་ཅིང་དེ་བཞིན་དུ་གསུང་བས་ན་གཤེགས་པ་ཉམས་སྣང་ལ་སོགས་པ་ཐམས་ཅད།",
    "ཐུགས་རབ་ཏུ་དགེས་ཤིང་རངས་པར་གྱུར་ནས་ནི།",
    "འདི་བཞིའི་སྟེང་དུ་ཉན་ཐོས་དང་རང་སངས་རྒྱལ་པ་ལ་ཕྱག་མི་བཙལ་བ་དང་།",
    "བསམ་གཏན་གྱི་གནས་ཏེ་བདག་ཡབ་ཡུམ་གྱི་སྦྱོར་མཚམས་ལ་འདུག་ལ་ཟླ་བ་ཕྱེད་ཀྱི་བར་དུ་དབུལ།",
    "བཅོམ་ལྡན་འདས་གནས་སྐབས་དང་རང་བཞིན་གྱི་ངོ་བོ་ཉིད་དག་པ་གཉིས་དང་ལྡན་པའི་རྡོ་རྗེ་འཆང་ཆེན་གྱིས་དེ་སྐད་བཀའ་སྩལ་ཏོ།",
    "གཞི་དང་རང་བཞིན་རྒྱུ་ཡིན་ཏེ།",
    "རྐྱེན་ངན་བྱུང་ཚེ་ཕན་པར་མི་གདའ་བས།",
    "བློ་གྲོས་དམན་ཡང་རང་ཉིད་སྒྲུབ་པ་ལ།",
    "དེ་ཁྱད་པར་མེད་ཀྱང་རང་བཞིན་དང་གོམས་པའི་ཁྱད་པར་ལས་དེའི་བདག་ཉིད་ཁྱད་པར་དུ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་རང་བཞིན་གཅིག་ཉིད་དུ་མཐོང་བའི་ཕྱིར་བློ་གཞན་ལ་ཉམས་སུ་མྱོང་བ་ཡང་གཞན་པ་ནི་མ་ཡིན་ནོ།",
    "ཕྱི་རོལ་གྱི་དོན་ཡོད་ཀྱང་རང་རིག་པ་ཇི་ལྟ་བ་བཞིན་དོན་འགྲུབ་པའི་ཕྱིར་དེ་ཉིད་འབྲས་བུར་རིགས་སོ།",
    "དེའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་དེ་ལྟར་སྣང་བ་ན་ཡང་རང་དང་གཞན་གསལ་བར་བྱེད་པར་འགྱུར་ཏེ།",
    "དོན་གཞན་དང་རང་བཞིན་དག་རབ་ཏུ་སྐྱེ་བ་དང་དེ་ཙམ་དང་རྗེས་སུ་འབྲེལ་པ་གྲུབ་ན་བལྟར་རུང་བའི་ཡུལ་ཅན་རྒྱུ་དང་ཁྱབ་པར་བྱེད་པའི་ངོ་བོ་མི་དམིགས་པས་འགྲུབ་པར་འགྱུར་གྱི།",
    "མི་དམིགས་པ་དང་རང་བཞིན་དང་འབྲས་བུའོ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "འབྲས་བུ་ཡང་རང་བཞིན་འབྲེལ་པ་ཡིན་ཏེ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པས་ན་བསྐལ་པ་ནི་རྣམ་པ་གསུམ་སྟེ།",
    "ཕྱོགས་འདིས་གཞན་དུ་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་དབྱེ་བ་བལྟ་བར་བྱའོ།",
    "འོན་ཀྱང་རང་ཉིད་མ་དམིགས་པས་ཡིན་ནོ་ཞེ་ན།",
    "དེས་ན་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ཡང་རང་བཞིན་ངེས་པར་བྱེད་པ་ཡིན་ནོ་ དེའི་ཕྱིར་གཉི་གར་ཡང་རང་བཞིན་འབྲེལ་པ་ཁོ་ནས་ལྡོག་གོ།",
    "དེའི་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དང་།",
    "མངོན་སུམ་དང་འགལ་བ་ཡང་རང་བཞིན་སྣ་ཚོགས་ཅན་གྱིས་རང་བཞིན་གང་ཞིག་འདྲེས་པར་སྣང་བའི་བློ་མཐོང་བ་མེད་པའི་ཕྱིར་འབྲེལ་པ་ཅན་གཞན་མེད་པས་ཉན་པ་ལ་གཉིས་མེད་པར་སྣང་བ་དེ་ཉིད་སྤོང་ན་འགལ་བ་ཡིན་ཏེ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་གཏན་ཚིགས་ཀྱི་ཁོངས་སུ་འདུས་པའི་ཕྱིར་དཔེར་བརྗོད་པ་ཁོ་ན་སྟེ།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ནོ།",
    "མཐོང་བའི་དེ་མ་ཐག་པ་ཡང་རང་རྒྱུད་པར་མི་འགྱུར་རོ།",
    "ཕྱིས་ཀྱང་རང་ཉིད་ཁོ་ནས་དེ་ལྟར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དངོས་པོ་ཇི་ལྟར་གནས་པ་བཞིན་དུ་འདུག་པ་བདག་དང་འབྲས་བུ་དང་མི་དམིགས་པ་རྣམས་ལ་མི་སྲིད་དོ།",
    "དེ་བས་ན་མི་དམིགས་པ་འདི་དང་རང་བཞིན་ནི་ཕན་ཚུན་འགལ་བའི་དོན་བསྒྲུབས་པས་གཅིག་ལ་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་དོ།",
    "དེཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་ནི་མ་ཡིན་གྱི།",
    "དཔེ་མི་སྲིད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཟློས་པའི་ཉེས་པ་ཡང་སོ་ན་འདུག་སྟེ།",
    "དེ་ལ་ཡང་ཕ་རོལ་དང་ཚུ་རོལ་གྱི་ཆ་ཡུལ་དང་རང་བཞིན་ཐ་དད་པ་གཅིག་ཏུ་རྟོགས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་གོམས་པ་ལས་འདི་ཞེས་ཞེན་པའི་རྣམ་པར་མདུན་ན་འདུག་པའི་དངོས་པོ་བདེ་བ་ལ་སོགས་པ་ལ་འཛིན་པ་ཡང་ཡིད་ཀྱི་མངོན་སུམ་ཡིན་ནོ།",
    "ཡུལ་དང་དུས་གཞན་དང་རང་བཞིན་གཞན་དང་མ་འདྲེས་པའི་ཕྱིར་རོ།",
    "འོ་ན་འོད་སྐྱེ་བ་ན་དེ་དག་མ་ལོག་པས་མ་ཁྱབ་པ་སོ་ན་འདུག་གོ་ཞེས་རྟོག་ན།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་ངེས་པ་མི་རུང་བའི་ཕྱིར་ཏེ།",
    "རང་བཞིན་གཅིག་ཁོ་ནར་ངེས་ཤིང་རང་བཞིན་གཞན་སྤོང་བ་ནི་མི་འཐད་དེ།",
    "རྐྱེན་གཞན་ཡང་རང་ཉིད་ངེས་པའི་རྐྱེན་ཏེ།",
    "དེ་ལྟ་ན་ཡང་རང་ངེས་པའི་ནུས་པ་ཡོད་ཀྱང་དོན་ངེས་པའམ།",
    "དུས་གཅིག་དང་རང་བཞིན་མི་གཅིག་པ་ལ་འབྲེལ་པ་གཉི་ག་འགལ་བའི་ཕྱིར་དང་།",
    "དེ་ལྟ་ན་ཡང་ཤེས་པ་དང་བརྗོད་པ་གཉིས་ཡང་རང་དང་གཞན་གྱི་དོན་ཡིན་པས་དབྱེ་བ་ག་ལ་ཡོད།",
    "དབྱེ་བ་མ་བསྟན་ཀྱང་རང་དོན་གྱི་མཚན་ཉིད་རྟོགས་ལ།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ནོ།",
    "འདི་གཉི་ག་ལ་ཡང་རང་ཉིད་རྟོགས་སམ།",
    "འཆོལ་བ་སོ་ན་འདུག་གོ།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་ཁོ་ནའོ།",
    "ཡོད་བཞིན་པའི་བློ་དང་རང་བཞིན་ཁྱད་པར་མེད་པས།",
    "དེའི་དུས་ན་ཡང་ས་ཕྱོགས་དང་རང་བཞིན་ཁྱད་པར་མེད་པའི་བུམ་པ་ནི་ཡོད་མ་སྲིད་དེ།",
    "སྔོན་མཐོང་བ་ལ་ལྟོས་པའི་ངོ་ཤེས་ཀྱིས་སྔོན་མཐོང་བ་དང་རང་བཞིན་མཚུངས་པར་ངེས་པར་བྱ་བའི་སྣང་བ་མི་དམིགས་པ་ཡོད་པས།",
    "གང་ཡང་ཤེས་པར་བྱེད་པ་མེད་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་དོན་གྱི་ངོ་བོ་དང་རང་བཞིན་གྱི་ཁྱད་པར་ལ་སྐུར་པ་འདེབས་པའི་འཁྲུལ་པ་ཉིད་དཔེ་དང་བཅས་ཏེ་བརྗོད་པ་ནི།",
    "ཀ་བ་དང་བུམ་པ་གཉི་ཀ་ཡང་རང་མེད་པའི་དུས་སུ་ལྡོག་པའི་ཕྱིར།",
    "འོན་ཏེ་འདིར་རྒྱུ་འབྲས་ཡིན་པ་ལ་མི་སྙོན་ཡང་གཞན་དུ་དེའང་རང་བཞིན་ཅན་རྒྱུ་འབྲས་མ་ཡིན་པ་སྲིད་པའི་དོན་ཡིན།",
    "དེ་གཉིས་དང་རང་བཞིན་མི་དམིགས་པ་ཐ་དད་པར་གྲུབ་བོ།",
    "གཞན་ཡང་རང་ཉིད་ཀྱིས་རབ་གསལ་བྱེད་ཅེས་བྱ་བ་རྗོད་པ་ཙམ་ལ་བྱས་ན་མ་ཁྱབ་པར་འཆད་པ་ཡང་འགལ་ཏེ།",
    "དེས་ན་རྟག་པ་ཐམས་ཅད་ནི་མེད་ལ་ཡོད་པ་ཐམས་ཅད་ནི་མི་རྟག་ཅེས་བྱ་བ་འདིས་ནི་དངོས་པོ་སོ་སོར་ངེས་པ་གང་ལ་ཡང་རྗེས་སུ་འགྲོ་ལྡོག་དུས་གཅིག་གམ་རིམ་གྱིས་རྟོགས་པ་མ་ཡིན་གྱི།",
    "དེ་ཡང་འདོད་པའི་རྒྱུ་ཡིན་པས་དེ་འདོད་པ་དཔོག་པའི་འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་ནི་མ་ཡིན་ནོ།",
    "དེ་ལྟ་བུ་དེ་ལས་བྱུང་བ་དང་དེའི་བདག་ཉིད་དེ་གཉིས་ཉིད་རྒྱུ་དང་རང་བཞིན་ལ་མི་འཁྲུལ་བའི་རྒྱུ་ཡིན་ནོ་ཞེས་བསྟན་པའི་དོན་དུ་གཏན་ཚིགས་གཉིས་སུ་ཕྱེའོ།",
    "གྲགས་པ་ཡང་རང་བཞིན་དུ་འདུ་བར་བསྟན་ཟིན་པས་ལོགས་སུ་མ་བྱས་སོ་ཞེས་སྟོན་པ་ནི།",
    "དེ་ཡང་རང་རིག་པས་གྲུབ་པ་མི་དམིགས་པ་ནི་རང་རིག་པས་གྲུབ་བོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "ཕྱེད་འོག་མས་ཀྱང་རང་དགའི་ཉེས་པ་སྤངས་ཏེ་སློབ་དཔོན་གྱི་ལུགས་འཆད་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "རྣམ་པ་གཉིས་ཏེ་ཞེས་པ་ནི་ཕྱེ་བའི་གྲངས་ཏེ་འདིས་ནི་བློ་དེ་ལ་ཡུལ་ལ་གསལ་བ་དང་མི་གསལ་བར་འཇུག་པའི་རྣམ་པ་གཉིས་ཡོད་པར་བསྟན་གྱི་རྫས་ནི་མ་ཡིན་ཏེ་གཉིས་ཀའང་རང་རིག་ཏུ་གཅིག་པའི་ཕྱིར་རོ།",
    "འཁྲུགས་པ་དེས་ཤེས་པ་ལ་འཁྲུལ་པ་མ་བསྐྱེད་པ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་འགལ་བར་འཛིན་པར་མ་བསྐྱེད་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་རྗེས་དཔག་རྟོག་བྲལ་དང་རང་རིག་རྟོག་པ་ལས་ལོག་ན་རང་ཉིད་རང་ལས་ལོག་པར་འགྱུར་ལ་མ་ལོག་ན་ཡང་རྗེས་དཔག་རྟོག་བྲལ་དང་རང་རིག་རྟོག་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཕྱིས་ཀྱང་སྐྱེད་བྱེད་མ་ཡིན་པར་འགྱུར་ཏེ་ཉེ་བར་སྦྱོར་བའི་དོན་སྔ་མ་དང་རང་བཞིན་དང་ནུས་པ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་ཉམས་སུ་མྱོང་བའི་དུས་དེ་ཉིད་ཀྱི་ཚེ་དོན་དུ་སྒྲོ་འདོགས་ལ་སྒྲོ་བཏགས་པ་དེ་ཡང་དོན་དང་ཤེས་པ་གཉིས་ཀའི་རང་བཞིན་མ་ཡིན་ཏེ་བཙོ་བསྲེག་ལ་སོགས་པའི་དོན་བྱ་བ་སྒྲུབ་མི་ནུས་པའི་ཕྱིར་དང་།",
    "ངེས་པའི་བདག་ཉིད་མ་སྐྱེས་པ་ཡང་རང་རིག་པས་ཡུལ་དུ་བྱས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཡིན་ནོ།",
    "བདེ་བ་ལ་སོགས་པ་ཡང་རང་རིག་ལ་གཟུང་བའི་ཆར་མི་སྣང་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་བྱེད་མི་དམིགས་པ་ཡིན་ནོ།",
    "བདེ་སོགས་དང་རང་རིག་ཀྱང་དེ་ལ་སྒྲ་འགོད་པའི་དུས་ན་ཞིག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཡིན་ནོ།",
    "འདི་ལྟར་ནི་ཁྱེད་རང་ཡང་འདོད་པ་ཡིན་ནོ་ཞེས་སྨྲོས་ཏེ་མི་སྡུག་པའི་ཡུལ་ཅན་ནི་རུས་པའི་ཏིང་ངེ་འཛིན་ནོ།",
    "རྩོད་པའི་གནས་སུ་གྱུར་པའི་ཤེས་པ་ཐམས་ཅད་ཀྱང་རང་རིག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་འགལ་བ་དམིགས་པའོ།",
    "འདི་ལ་ཡུལ་རང་དང་རང་མ་ཡིན་པ་ཕན་ཚུན་སྤངས་ཏེ་གནས་པའི་འགལ་བ་ཡིན་པ་ན་དེ་རིག་པ་ཡང་དེ་ལྟར་དུ་འགྱུར་བ་ཡིན་ཏེ་ཡུལ་ཐ་དད་ཀྱང་ཡུལ་ཅན་གཅིག་ཡིན་ན་ནི་མིག་ལ་སོགས་པའི་ཤེས་པ་དུ་མ་དོན་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདིར་འཐད་པ་འདིས་ཕྱི་རོལ་གྱི་དོན་འགོག་པར་འདོད་པ་ནི་མ་ཡིན་གྱི་འོན་ཀྱང་དོན་ཡོད་ཀྱང་རང་རིག་པ་འབྲས་བུར་རིགས་ཀྱི་དོན་རིག་པ་ནི་མ་ཡིན་ཏེ་དོན་རྣམས་ནི་ཤེས་པ་རྟོག་མེད་མ་འཁྲུལ་བ་རྣམས་ཀྱིས་ཇི་ལྟར་བཀོད་པ་ལྟར་སྣང་བའི་ཕྱིར་རོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "གལ་ཏེ་གསལ་བའི་རང་བཞིན་དུ་རིག་ཀྱང་གཞན་ཡིན་པ་ཅི་འགལ་ཞེ་ན་ཤེས་པས་གཞན་གསལ་བའི་རང་བཞིན་དུ་རིག་ན་རང་མ་རིག་པར་འགྱུར་ཏེ་ཡུལ་རང་དང་རང་མ་ཡིན་པ་ཐ་དད་པས་ཡུལ་ཅན་ཡང་ཐ་དད་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྔོན་པོ་ལ་སོགས་པ་དེ་ཡང་གསལ་བ་དེའི་བདག་ཉིད་ཡིན་པ་དེའི་ཕྱིར་ཤེས་པ་དེ་ལྟར་སྣང་བ་ན་ཡང་རང་དང་གཞན་ལྟ་བུ་དེ་གསལ་བར་བྱེད་པར་འགྱུར་ཏེ་གསལ་བའི་སྒྲོན་མ་བཞིན་ནོ།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་དེ་གང་ལས་ལྡོག་པ་དེ་ལ་ནི་ཐེ་ཚོམ་སྐྱེད་པར་མི་འགྱུར་ཏེ་འོན་ཀྱང་རང་ཉིད་ཡོད་པས་དེ་མེད་པས་གོ་བར་འགྱུར་ལ་འགལ་ཟླ་མེད་པར་གོ་ན་ཡང་ཅིག་ཤོས་ཡོད་པར་གོ་བར་འགྱུར་བའི་ཕྱིར་དེས་ཐེ་ཚོམ་སྒྲུབ་པར་མི་འགྱུར་ན་འདི་ནི་ཐེ་ཚོམ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "མཉན་པར་བྱ་བ་ཡང་རང་ཡུལ་ལ་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་དོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་འགལ་བ་དམིགས་པ་ཡིན་ནོ།",
    "བསྒྲུབ་བྱ་ཡང་སྒྲུབ་པ་དང་དགག་པ་འགལ་བས་ཐ་དད་པ་ན་གཏན་ཚིགས་ཀྱང་གཉིས་ཡིན་ལ་སྒྲུབ་པ་ཡང་རང་ལས་ཐ་དད་པ་དང་ཐ་མི་དད་པའི་ཕྱིར་གཏན་ཚིགས་ཀྱང་གཉིས་ཏེ་དེའི་ཕྱིར་ཡུལ་གསུམ་དུ་གནས་པས་གཏན་ཚིགས་གསུམ་དུ་གནས་པ་ཡིན་ནོ།",
    "དགག་པའི་སྒོ་ནས་འཇུག་པ་རྒྱུ་དང་རང་བཞིན་མི་དམིགས་པ་གཉིས་ཏེ་བཞི་ཡིན་ནོ།",
    "རིག་བྱེད་རང་ཉིད་ཀྱང་རང་ཉིད་རིག་པར་བྱེད་པ་མིན་ཏེ་ཤེས་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་དང་རང་བཞིན་དེ་དག་ཁོ་ན་ཞེས་སྦྱར་རོ།",
    "གཉིས་པ་ལུང་རང་ཉིད་རང་དང་འགལ་བ་སྒྲུབ་པའི་གཏན་ཚིགས་སུ་མི་འཐད་པ་ནི།",
