    "དེ་ཡང་ཡི་གེ་གཉིས་སམ་མང་པོ་འདུས་པའང་རང་དོན་གྱི་ངོ་བོ་ཙམ་སྟོན་པའི་སྒྲ་ནི་མིང་ཡིན་ཞིང་།",
    "ཚང་མ་དག་པ་དཀོན་པོར་འདུག་པར་མ་ཟད།",
    "གང་ལྟར་མ་དཔེ་ཁོ་རང་ན་ཇི་ལྟར་གསལ་བ་ལྟར་རང་སོར་བཞག་ཡོད།",
    "རྟགས་མང་དུ་བཏབ་པ་སོགས་ནི་མི་མཛེས་པར་འདུག་པས།",
    "འབྲས་སྤུངས་གནས་བཅུ་ལྷ་ཁང་ནས་བྱུང་བའི་དཔེ་རྙིང་བྲིས་མ་དེར་དཔར་མ་དེ་གཉིས་སུ་མ་ཚང་བ་མང་པོ་ཞིག་འདུག་པས་དེ་ནས་བྱུང་བ་དག་ཁ་བསྐངས་ཏེ་ཞིབ་པར་བྱས་ཡོད་ལ།",
    "སྡོམ་གྱི་ཚིགས་བཅད་དེ་དག་ལས་གསལ་བའི་ས་བཅད་ཅིག་དགོས་དོན་མི་འདུག་སྙམ་ནས་མགོར་དཀར་ཆག་ཙམ་བཀོད་པ་ལས་གཞུང་དཀྱུས་སུ་ས་བཅད་བཀོད་མེད།",
    "ཁྱེད་འདིར་བཞུགས་ན་ངས་ཀྱང་ཕྲིན་ལས་བཞི་ཀ་བསྐྱང་དུ་བསྟུབ་བཏུབ་པར་འདུག།",
    "སྐུ་ཚེ་ལ་ཡང་ཕན་པར་འདུག།",
    "འཇིགས་སུ་རུང་བ་འདུག་གསུང་།",
    "སྦྲུལ་གྱི་ག་ཤ་བཅུག་ནས་མདའ་དང་གཞུ་འཛིན་པ་ཅིག་ཞིག་འདུག།",
    "དེ་ནི་རྒྱལ་པོ་ཨིཎྜ་བྷུ་ཏི་དེའི་ཁབ་ཀྱི་ཤུལ་ཡིན་པར་འདུག།",
    "ཀུན་ཀྱང་རང་གང་འདོད་པའི་གཟུགས་སུ་བསྒྱུར་ནུས་པ།",
    "སྤྱིར་ཨོ་རྒྱན་གྱི་ནང་དུ་ཚུད་མན་ཆད་སྔོན་གྱི་བག་ཆགས་ཤིན་ཏུ་འཐུག་པ་འདུག་ཅིང་།",
    "གདུག་པ་ཅན་གྱི་མཁའ་འགྲོ་མ་ཐམས་ཅད་གནོན་པར་འདུག།",
    "དྷོ་དྷུ་མ་ཐ་ལའི་ནུབ་ན་ཀ་མ་དྷ་ཀོ་ཟེར་བའི་གངས་ཅིག་ཤིག་འདུག།",
    "དེ་ལ་ཀོ་དྷི་བྷ་རི་ཟེར་བའི་ཆུ་གཅིག་འདུག།",
    "ཝ་ལ་སོགས་པ་གནས་ཤིང་མཁའ་འགྲོ་སྤྲིན་བཞིན་འདུག་གསུངས།",
    "དེ་ཉིད་ན་མང་གྷ་ལ་བྷིག་ཀླུ་ཞེས་པའི་ཤིང་ཏ་ལ་ཅིག་ཞིག་འདུག།",
    "དེའི་རྩ་ན་མང་གྷ་ལ་པ་ནེ་ཞེས་པའི་ཆུ་ཅིག་ཞིག་ལྷོར་འབབ་ཀྱིན་འདུག།",
    "ད་ལྟ་དེ་རྙོ་མ་ཐ་ལའི་མདུན་ན་ལྷ་ཁང་རྩེགས་བརྩིགས་ནས་དེ་ན་བཞུགས་ཀྱི་འདུག་གསུང་།",
    "དྷོ་དྷུ་མ་ཐ་ལའི་བྱང་ཤར་ན་མཆོད་རྟེན་ཅིག་ཞིག་འདུག་སྟེ།",
    "ཨུ་རྒྱན་གྱི་སྒོ་ན་རྒྱལ་པོ་ཨིཎྜ་བྷོ་ཏིས་བཞེངས་པའི་གཞལ་ཡས་ཁང་ཆེན་པོ་གཅིག་འདུག།",
    "དེ་ནས་དྲན་པ་བསྙེད་རྙེད་ཙམ་ན་ཉི་མ་ཤར་འདུག།",
    "ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མ་རིགས་བཞི་རུ་འདུག།",
    "འདིར་འདུག་པས་མི་ཚུགས་པས་བོད་དུ་གཤེགས་ཟེར།",
    "གཞན་ཡང་རྣལ་འབྱོར་པ་མང་ཞིག་ལ་ཕྱི་ན་བསྐལ་སྐལ་བ་སྐྱེལ་གྱི་འདུག་གསུང་།",
    "ཁོ་ལ་མཐོང་སྣང་ཅི་ཡང་མ་བྱུང་བར་འདུག་གསུང་།",
    "ཁོང་རང་ཉན་དུ་མི་འདོད་པར་འདུག།",
    "ར་ཙ་དྷུར་ནས་ཞག་བཞི་བཅུ་རྩ་གཉིས་ཀྱིས་ཁ་ཆེའི་ཡུལ་དུ་སླེབ་ཀྱི་འདུག།",
    "སྔར་གྱི་དབྱངས་རྟ་སྟེལ་བསྙེལ་བ་དེ་གྱེར་ཞིང་འདུག་པས་དབྱངས་རྟ་དེ་རྙེད་པ་ཡིན་གསུངས།",
    "བར་ཆད་སེལ་བའི་གྲོགས་རྣམ་པ་ཐམས་ཅད་དུ་སླེབ་ཀྱི་འདུག་གསུང་།",
    "གཞལ་ཡས་ཁང་མ་དག་པ་ཡིན་སྙམ་པ་ཞིག་བྱུང་ཙ་ན།",
    "ཕྱོགས་བཞི་ན་མཁའ་འགྲོ་མ་བཞི་འདུག་པས།",
    "དེ་ཀ་ལ་ང་ལ་ཏིང་ངེ་འཛིན་ཁྱད་པར་ཅན་ཡ་མཚན་ཆེ་བ་གཅིག་སྐྱེས་འདུག།",
    "དེ་དུས་རང་ནས་རྨི་ལམ་དང་འོད་གསལ་ལ་མངའ་བརྙེས་པར་བཞུགས་པར་གདའ་ཨང་ཞུས་པས།",
    "དེར་ཡི་དམ་གྱི་ལྷ་སྐལ་བཅོམ་ལྡན་འདས་མ་རང་ཡིན་ཡོང་བར་འདུག་སྙམ་པ་བྱུང་གསུང་།",
    "ཏིང་ངེ་འཛིན་གྱི་རྩལ་ཆེན་པོ་གདའ།",
    "དོན་དམ་པ་དང་ཀུན་རྫོབ་ཀྱི་རྣམ་བཞག་འདི་ལ་སྣོད་བཅུད་ཀྱི་སྣང་བ་མ་འགགས་པ་སྣ་ཚོགས་སུ་ཤར་བ་ལ་ལོངས་སྤྱོད་པ་འདི་ཀུན་རྫོབ་ཡིན་པ་ལ་མ་བདེ་བ་ཙམ་ཡང་མི་གདའ་སྟེ།",
    "སྣོད་བཅུད་ཐམས་ཅད་རང་བཞིན་མེད་པ་ཡིན་བསམ་བ་བྱས་ཀྱང་ནི་བློས་བྱས་ལས་མི་ཡོང་བར་འདུག།",
    "དྲན་པ་གསུམ་ངོ་བོ་གཅིག་ཏུ་འདྲིལ་ནས་གཤིས་ཇི་ལྟར་འདུག་པ་དེ་མངོན་དུ་གྱུར་པས།",
    "ནན་ཏར་གོ་མི་བདེ་བར་གདའ་ཅེས་ཞེས་ཞུ་བ་ལ།",
    "གཙང་འཕྲང་རྒྱལ་པོའི་བསུ་བར་འདུག།",
    "རུ་མཚམས་ན་མར་ཞབས་ཏོག་ཀྱང་ཁོས་བྱེད་ཟེར་གྱིན་འདུག་གསུངས་པས།",
    "ནས་ཁལ་བདུན་བཅུ་ཕུལ་བར་གདའ།",
    "ཁོང་རང་རྣམས་ཟས་གོས་ཀྱི་ཞེན་པ་སུ་བས་ཆེ་བ་གཅིག་བྱས",
    "དེ་ལ་ལུང་ཡང་འདི་ལྟ་བུ་འདྲེན་པར་གདའ།",
    "ཞེས་པ་ལུང་དུ་འགོད་པར་གདའ་ཞུས་པས།",
    "འོད་གསལ་ལ་ནུས་པ་ཐོབ་པ་མང་པོ་བྱུང་གདའ་བ་ལ།",
    "ཉན་ཐོས་དག་དང་རང་རྒྱལ་གྱིས།",
    "ངོ་བོ་དང་རང་བཞིན་མེད་པ།",
    "འཇམ་དབྱངས་ཀྱི་སྐུ་ལ་གཏོར་བས་དབུའི་སྟེང་ན་གདུགས་བཞིན་དུ་ཆགས་ནས་འདུག།",
    "ཡན་ལག་བདུན་པ་གཅིག་ཕུལ་ནས་གསོལ་བཏབ་སྙམ་ཙ་ན།",
    "དེ་ལྟ་མིན་ན་ཁྱེད་ལུང་པ་དཀར་ལ་སྡིག་ཤས་ཆུང་པར་འདུག་པ་ལ།",
    "ཟོན་གྱིས་ཤིག་གསུང་ཙ་ན།",
    "ནོར་མ་བསྐུར་བར་ཁོང་རང་གཉིས་ཐོང་གསུང་གསུངས་པས་བཏང་།",
    "སྒོམ་ཆེན་པ་མང་པོ་རྨི་ལམ་གྱི་ཉམས་མྱོང་མང་པོ་ཞུ་ཡིན་འདུག་པས།",
    "སུམ་བཅུ་རྩ་གསུམ་མཐོང་རྒྱུ་རང་མ་བྱུང་པར་འདུག།",
    "ད་ཡང་དང་ར་མའི་གནས་ཅི་འདྲ་གཅིག་འདུག་ལྟ་བ་ལ་འགྲན་པ་ཡིན་གསུངས་པས།",
    "རིགས་ལྡན་གྱི་དྲུང་དུ་འགྲོ་སྙམ་ཙ་ན།",
    "དེར་དེ་ཟུང་ལ་ཤོག་གསུང་འཛིན་དུ་ཕྱིན་པས་ང་བསོད་གསོད་པའི་ཁྲོ་བོ་དམར་པོ་དེ་འདུག་པས།",
    "ཁོང་རྐང་ལག་བསྒྲད་ནས་འགྲོར་མ་ཉན་དེ་ཚོས་ཁོ་བཏེགས་ནས་ཕྱིན་ཙ་ན།",
    "དྲུང་དུ་སླེབ་མ་ཐག་ཡང་འགྱུར་འདུག་ཟེར་ནས་ཁོ་བརྒྱལ་ནས་འགྲོ་བ་འདྲ་འདུག།",
    "ཁྲོ་བོ་སྔོན་པོར་འགྱུར་འདུག་ཟེར།",
    "ལྷ་ཁྲ་བོར་འགྱུར་ནས་གསོད་པར་འདུག་གོ་ཟེར།",
    "ད་ལྟར་ཐམས་ཅད་ཀྱིས་བཀུར་བའི་གཙུག་རྒྱན་དུ་གདའ་སྟེ།",
    "སང་དུས་ངེད་འགྲོ་དོན་བྱེད་པའི་དུས་ལ་བབ་ཙ་ན་ལྷ་བཙུན་བྱེད་པ་ལགས།",
    "ཉེ་གནས་དེས་ཀྱང་རྟེན་རྣམས་ཀྱི་དྲུང་དུ་མཆོད་ཡུལ་དུ་བཞག་གདའ།",
    "རྡོ་རྗེ་གདན་གྱི་བྱང་སྒོ་ལ་བོད་ཀྱི་སྒོ་ཞེས་གྲགས་པར་གདའོ།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་རྟོགས་པ་ང་རང་ལ་གཤའ་མ་ཡོད་སྙམ་པ་ཅིག་ཞིག་བྱུང་བས།",
    "རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ཀྱི་རྟེན་བྱེད་པ་ལ་སོགས་པ་ཡིད་ལ་བྱེད་ཅིང་ཡོད་ཙ་ན།",
    "འགྲོ་བ་ལ་ཕན་ཐོགས་པ་འོང་བར་འདུག་གསུངས་པས།",
    "ཨུ་རྒྱན་པ་འདི་བཏུབ་པར་མི་གདའ།",
    "གྲུབ་ཐོབ་ཏུ་འདུག་ཟེར་ནས་ཤིན་ཏུ་དད་པར་གྱུར་པ་དེ་ལྟ་བུ་དང་།",
    "གཤིན་པོ་དེ་ཟམ་ཆུང་འོག་ན་འཁོར་ཞིང་འདིར་མི་འོང་འདུག་གསུངས།",
    "ལོངས་སྤྱོད་མང་པོ་འབུལ་བའི་ངོ་སོ་བྱེད་འདོད་པས་ལོངས་སྤྱོད་ལ་ཞེན་ནས་བསྡད་པར་འདུག་པ་གསུངས།",
    "བྱང་བུ་གཅད་དགོས་པར་འདུག།",
    "གྲིས་བཅད་ནས་ཏིང་ངེ་འཛིན་མཛད་པས་མཐོ་རིས་སུ་སྐྱེ་བར་འདུག་གསུངས་པ་དང་།",
    "ཡང་དྲུང་ནས་མི་ཕན་པར་འདུག་གོ།",
    "དྲུང་དུ་ཁྱིམ་བྱ་ཅིག་ཞིག་འདུག་པ་ལ།",
    "ཁོ་ལ་ཡང་མི་རྟོག་པ་གཤའ་མ་སྐྱེ་ཡིན་འདུག་གསུང་།",
    "ངོ་འཕྲོད་པ་དཀའ་བར་འདུག་གསུང་།",
    "ཡང་གྲོད་ལུང་ན་བཞུགས་པའི་དུས་སུ་མི་མང་པོ་ཚོགས་པའི་དཀྱིལ་དུ་ཁྱིམ་བྱ་ཞིག་སྐྲག་ནས་ཕར་ཏེབ་ཚུར་ཏེ་བ་འདུག་པ་ལ།",
    "འཁྲུལ་བའི་བག་ཆགས་སྦྱོང་ཙ་ན།",
    "ལས་ཚོགས་ཀྱི་འཕྲིན་ལས་སྒྲུབ་ཙ་ན།",
    "གཞན་རྒྱུད་ཤེས་པའི་དམིག་མིག་གསལ་གདའ།",
    "ལུས་འདི་ནི་ཟག་མེད་རྡོ་རྗེའི་ལུས་སུ་གྱུར་འདུག་གསུང་།",
    "སྔར་དཔལ་རྒོད་ཚངས་པའི་ཞལ་ནས་ལོ་བཅུ་གཉིས་ནས་མཉམ་རྗེས་མེད་པའི་རྟོགས་པ་འཆར་གསུང་པ་དེ་འདི་ལ་དགོས་པར་འདུག་གསུང་།",
    "ལུང་པ་གྲུབ་ཐོབ་ཀྱིས་འགེངས་པར་འདུག་སྟེ།",
    "རྒྱལ་བའི་སྐུ་གདུངས་གདུང་ལ་སྐུ་ཁྲུས་གསོལ་ཞིང་འདུག་པའི་ཚེ་བསྟོད་པའི་ཚིགས་སུ་བཅད་པ་མཛད།",
    "ཁོ་བོའི་ཡི་དམ་གྱི་ལྷ་སྐལ་བཅོམ་ལྡན་མ་རང་ཡིན་པར་འདུག་སྙམ་པ་བྱུང་།",
    "རྒྱལ་པོས་གདན་འདྲེན་གྱི་གསེར་ཡིག་པ་འདུག་ཟེར་བའི་སྐད་བྱུང་ནས།",
    "དབུའི་སྟེང་ན་གདུགས་བཞིན་དུ་གྱུར་ཡན་ལག་བདུན་པ་དང་གསོལ་བ་འདེབས་སྙམ་ཙ་ན།",
    "ནུབ་གསུམ་གྱི་བར་འབད་པས་ཁོས་ཡང་སྔར་བཞིན་རང་སྣང་བལ་པ་ཝལ་བ་ཞིག་མཐོང་འདུག།",
    "འདི་སྤྲུལ་པར་འདུག་སྙམ་ནས།",
    "བདག་མཆིས་རྣལ་འབྱོར་འདུག་པ་འདི་། རྒྱ་བོད་གཉིས་ཀྱི་ཤན་དྷ་རི།",
    "ཁྱད་པར་དུའང་བར་སྒང་བར་སྒར་པ་དེ་རྣམས་སྨིན་ཅིང་གྲོལ་བར་བྱེད་པར་འདུག།",
    "ང་ནི་དེ་ཡི་བར་དུ་མི་སྡོད་པར་འདུག་ཟེར་སྐད།",
    "སློབ་དཔོན་སྐུ་མཆེད་པ་གྲུབ་རྟགས་ཡོད་ན་དུས་ལ་བབ་གདའོ་ཟེར་བས།",
    "དེ་མཁའ་འགྲོ་མ་པད་ཏུ་ཡིན་པར་འདུག་གསུང་།",
    "ཡོང་ནི་མི་ཐེ་པར་མ་ཐང་བར་འདུག།",
    "དེ་དུས་ན་ད་ལྟའི་སེམས་དང་ཁྱད་པར་ཅི་འདུག་ལྟ་དགོས་སྙམ་པ་བྱུང་སྟེ།",
    "དེ་བསྒོམ་གྱི་བག་ཆགས་སད་པར་འདུག།"
  ]
}