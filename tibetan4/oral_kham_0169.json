    "ཞེས་ཟེར་བ་ནི་འགྲེལ་པ་འདིར་དེ་མེད་པར་དངོས་སུ་གསུངས་ཤིང་རང་ཉིད་ཀྱང་སྐབས་དེར་དེ་བཞིན་དུ་ཁས་བླངས་པ་དང་དངོས་སུ་འགལ་ལོ།",
    "ཞེས་པ་ལ་སྦྱར་མ་ཤེས་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ལན་བཏབ་ཟིན་པ་སྐབས་འདིའི་ལན་ལ་ཡང་མཚུངས་ཞེས་པའི་དོན་སྦྱར་མ་ཤེས་པར་གཞི་སོ་སོར་བྱས་འདུག་པའི་ཕྱིར།",
    "ལས་གསུངས་ཤིང་རང་ཉིད་ཀྱང་དེ་ལྟར་དུ་བཞེད་ཅེས་པ་ནི།",
    "དཔེ་འདིས་ཀྱང་རང་རིག་ཐ་སྙད་དུ་ཁས་མི་ལེན་པ་མ་ལྟ་བ་ཡིན་ཏེ།",
    "ཆུ་ཤེལ་དང་མེ་ཤེལ་ལས་ཆུ་དང་མེ་སྐྱེ་བ་སྲིད་ངན་སེལ་༣ ཀྱང་ཆུ་དང་མེ་ཡིན་ན་དེ་གཉིས་ལས་སྐྱེ་བས་མ་ཁྱབ་པ་དཔེར་བཀོད་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ནི་ཏིང་ངེ་འཛིན་དེ་ཐོབ་མ་ཐག་ཏུ་པདྨ་དེ་ལ་འདུག་པར་ཀུན་ཏུ་ཀུན་མཁྱེན་སྣང་ངོ།",
    "དེ་དེ་ལ་འདུག་པ་དང་།",
    "གཙང་བདག་བདེ་དང་རྟག་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པར་གསུངས་པའི་ལྟ་བ་སྟེང་དུ་སླེབ་འདུག་པས་ད་འདོད་ཐོག་དུ་བྱའོ།",
    "གསུམ་པ་ནི་དེ་ཉིད་ཀྱི་སྐུ་གཅིག་གམ་བ་སྤུའི་ཁུང་བུ་གཅིག་ལའང་རང་གཞན་གྱི་དུས་གསུམ་གྱི་སྤྱོད་པ་དང་།",
    "ཚིག་རྐང་ཕྱི་མ་གཉིས་ཀྱིས་ཁྱེད་རང་དངོས་སྨྲ་བ་རྣམས་ཀྱང་སེམས་སྔོན་པོའི་རྣམ་ལྡན་དུ་གྱུར་པ་ལ་སྔོན་པོ་ཤེས་སོ་ཞེས་ཐ་སྙད་འདོགས་པ་བཞིན་ཞེས་དཔེ་སྟོན་ལ།",
    "མི་མཁས་སྲིན་བྱའི་ཅ་ཅོ་སྒྲོག་དུས་འདིར།",
    "ཡང་རང་བཞིན་མེད་པར་སྟོན་པའི་རིགས་པའི་ཚོགས་ཀྱི་བསྟན་བཅོས་ལྔ་ཡིན་ནོ་ཞེས་ཟེར་བ་ཐམས་ཅད་ཚུལ་འདིས་བསལ་བ་ཡིན་ནོ།",
    "དཔེར་ན་ནམ་མཁའ་ནི་ཁྱབ་ཅིང་རང་བཞིན་མེད་ལ་གོ་འབྱེད་པ་ལྟར།",
    "ཁྱེད་རང་ཡང་འདོད་པ་དང་འགལ་ལོ།",
    "ཞེས་པའང་རང་ལ་ལོག་པར་འགྱུར་རོ།",
    "སྐྱོན་གྱི་འབྱུང་གནས་སུ་འདུག་པས་ཁོ་བོས་བྱས་པའི་འཇུག་པའི་དཀའ་འགྲེལ་དུ་རྒྱས་པར་བཀག་ཟིན་པ་ལས་བལྟ་བར་བྱའོ།",
    "ཀུན་གཞན་དུ་ན་ཀུན་རྫོབ་བདེན་པའང་རང་ལུགས་ལ་ཁས་མི་ལེན་པར་འགྱུར་ཏེ།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་ཚིག་དབེན་པའི་བསྒྲུབ་བྱ་ཡོད་ཀྱང་ཁས་མི་ལེན་ནམ།",
    "དེ་ལྟ་བས་ན་ཐ་སྙད་དུ་རང་ལ་དམ་བཅའ་མེད་པ་མིན་ལ་དེ་སྒྲུབ་པའི་རྟགས་ཀྱང་རང་ལ་གྲུབ་པ་ཡོད་པ་ཉིད་དེ།",
    "ཞེས་སོགས་ཀྱི་གཞུང་རང་ལ་ཞེ་འདོད་ཀྱི་ཁས་ལེན་ཅུང་ཟད་ཀྱང་མེད་པའི་ལུང་དུ་ཡང་མི་རུང་སྟེ།",
    "ཞེས་ངེས་པར་བྱ་མི་ནུས་པས་རྟགས་དང་བསྒྲུབ་བྱ་འདོད་ཀྱང་རང་རྒྱུད་ཀྱི་རྟགས་དང་བསྒྲུབ་བྱ་མི་ཀུན་འདོད་པ་ཡིན་ནོ།",
    "མཚན་འཛིན་དུ་འདུག་གོ་སྙམ་ནས་ལྟ་བ་རྒྱུད་ལ་སྐྱེས་པར་རློམ་པའི་འོག་ཏུ་སྤྱོད་ཕྱོགས་ཐམས་ཅད་ལ་ཞེ་རྩིས་མེད་པའི་ལོག་ལྟ་རྣམས་ལེགས་པར་ཁེགས་པར་འགྱུར་རོ།",
    "ཁོ་རང་ཡང་ངེས་པར་འདོད་དགོས་པའམ་འདོད་པ་ཅིག་དགོས་ཏེ།",
    "གཞན་ཡང་རང་རྒྱུད་ཀྱི་རྟགས་དང་བསྒྲུབ་བྱ་ལ་གཞན་གྲངས་ཅན་གྱིས་སྨྲས་པའི་གཏན་ཚིགས་འགལ་བ་དང་གྲུབ་པ་ལ་བསྒྲུབ་པའི་ཉེས་པ་མ་བསལ་བའི་ཕྱིར་ཡང་མི་རིགས་སོ།",
    "རྩོད་པ་ཟློག་པའི་འགྲེལ་པ་རབ་གསལ་མཛད་པ་ན་སློབ་དཔོན་གྱིས་ཀྱང་རང་རྒྱུད་ཀྱི་སྦྱོར་བའི་ངག་མ་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་སྨྲ་ཞིང་རང་རྒྱུད་པ་དག་ཀྱང་ཐ་སྙད་དུ་གཞན་སྐྱེ་ཡོད་པར་སྨྲའོ།",
    "དོན་དམ་པར་ས་བོན་ལས་མྱུ་གུ་སྐྱེ་བ་མེད་པའི་དོན་ས་བོན་ལས་མྱུ་གུ་སྐྱེ་བ་ཉིད་མཐའ་བཞིར་དཔྱད་ན་མི་རྙེད་པ་ལ་བྱས་འདུག་པའི་ཕྱིར།",
    "འདིའང་བརྟགས་ན་མི་རུང་སྟེ་དོན་རྣམས་ལ་སྔ་ཕྱིའི་དབུས་ན་འདུག་པས་ཁྱབ་ཅིང་སྣང་བ་ལ་ད་ལྟར་བས་ཁྱབ་ལ།",
    "ཁྱབ་པའི་སྒོ་ནས་ནི་དངོས་པོ་ཙམ་ཡང་རང་བཞིན་མེད་པར་གྲུབ་སྟེ།",
    "ཕ་རོལ་མ་དད་ན་མི་ཉན་པས་དེའི་དོན་མི་འགྲུབ་ཅིང་རང་ལ་སྨོད་པས་ཕ་རོལ་ཉམས་པའི་དོན་མ་ཡིན་པ་ཐོབ་པའི་ཕྱིར་ཏེ།",
    "རང་ཉིད་ཀྱི་སྐུ་གཅིག་གམ་བ་སྤུའི་ཁུང་བུ་གཅིག་ལའང་རང་གཞན་གྱི་དུས་གསུམ་གྱི་སྤྱོད་པ་མཁྱེན་དང་འཁོར་འདས་ཀྱི་སྣང་བ་མ་ལུས་པ་སྟོན་པ་སྟེ།",
    "སྒོ་ངའི་ནང་ན་འདུག་པ་དང་།",
    "དང་པོ་ནི་ཚོགས་དྲུག་རང་རང་སྐྱེས་ཤིང་མ་འགགས་པའི་ད་ལྟར་གྱི་དུས་དེའོ།",
    "རང་རང་འགགས་མ་ཐག་པའི་དུས་དེའོ།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "དེའི་ཤེས་བྱེད་ཀྱང་ཇི་སྲིད་སྤྲོས་པའི་ཚོགས་མཐའ་དག་མ་བཀག་པ་དེ་སྲིད་དུ་བྱང་ཕྱོགས་དང་སྟོབས་ལ་སོགས་པའི་ཡོན་ཏན་རྣམས་དང་རང་བཞིན་དབྱེར་མེད་དུ་འཆད་མི་ནུས་ལ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམ་པར་སྣང་མཛད་ཀྱི་བཞུགས་སྟབས་ཀྱིས་འདུག་པར་བྱ་སྟེ།",
    "ཁྱེད་རང་འདོད་པའི་སྒྲུབ་བྱེད་ཞུགས་པའི་ཕྱིར།",
    "ཟླ་བའི་ཞབས་ཀྱིས་ཀྱང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་གཏན་མི་བཞེད་པ་ནི་མ་ཡིན་ཏེ།",
    "མིང་ཡང་རང་བཞིན་མེད་པ་ཡིན།",
