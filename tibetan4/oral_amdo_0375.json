    "གོང་གི་མ་ཡིག་གི་བེའ་བམ་ཅི་འི་གབ་ཚེ་ཏཾབ་བ་བཞིན་ཐམས་ཅད་ཕུང་ལ་སྦྱོར་བའི་དགག་བྱ་དང་དགོས་པ་ལ་དགོངས་པ་ཡིན་པས་བུ་ཡིག་གི་སྐོར་ལ།",
    "ཡིད་བཞིན་འཁོར་ལོ་ལོ་ཙཱའི་སྒྲོས་རྙིང་གི།",
    "མནན་པ་དུར་རྡོ་མནྟའི་རི་མོ་ཅན།",
    "དེ་སྲས་ཤར་པ་ཡེ་ཤེས་རྒྱལ་མཚན་དང་གྲུབ་ཆེན་བུདྡྷ་ཤྲཱི་གཉིས་ཀས་རྗེས་སུ་བཟུང་བ།",
    "ཡང་ན་ཞབས་དྲུང་ཨ་མི་ལགས།",
    "དཀར་ཆག་གི་ས་བཅད་དང་པོ་ཡོངས་རྫོགས།",
    "པའི་ནང་གི་ལྡོང་གི་རྟགས་ཅན།",
    "དཀར་ཆག་གིས་མ་ཟིན་པའི་ས་བཅད་དང་པོའི་ལྡོང་གཡུང་དྲུང་ཅན་དང་བཅས་པའི་ལུང་གི་བརྒྱུད་པ་ལུགས་གཅིག་ནི།",
    "ལུང་གི་བརྒྱུད་པ་རྣམས་ནི་དང་པོ་རྟགས་སོ་སོ་བ་ལྟར་བརྒྱུད་པ་ཁོ་ན་ཡིན་ཡང་།",
    "ཨེའི་རྟགས་ཅན་གྱི་ལུང་གི་བརྒྱུད་པ་ནི།",
    "རྡོ་རྗེ་གཡུང་དྲུང་གི་རྟགས་ཅན་གྱི་ལུང་བརྒྱད་ལུགས་གཅིག་ནི།",
    "གློའི་རྟགས་ཡོད་དོ་ཅོག་གི་ལུང་གི་བརྒྱུད་པ་ནི།",
    "ཀུའི་རྟགས་ཅན་གྱི་ལུང་གི་བརྒྱུད་པ་ནི།",
    "ངག་གི་རྟགས་ཅན་གྱི་ལུང་གི་བརྒྱུད་པ་ནི།",
    "སྒྲུབ་དུས་ཁེ་རྐྱང་གི་བརྒྱུད་པ་ནི།",
    "སྒྲུབ་དུས་ཀྱི་མགོན་པོའི་རྗེས་གནང་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པ་དང་།",
    "དཀར་ཆག་གིས་མ་ཟིན་པའི་ས་བཅད་དང་པོའི་ཏའི་རྟགས་ཅན་གྱི་ལུང་དང་བཅས་པའི་བརྒྱུད་པ་ནི།",
    "སྒྲུབ་དུས་ཀྱི་མགོན་པོའི་ཐུན་མོང་མ་ཡིན་པའི་རྗེས་གནང་གི་བརྒྱུད་ལུགས་གཅིག་ནི།",
    "ཡང་སྒྲུབ་དུས་ཀྱི་མགོན་པོའི་རྗེས་གནང་ཐུན་མོང་བའི་བརྒྱུད་ལུགས་གཅིག་ནི།",
    "སྒྲུབ་དུས་དམ་ཅན་རྒྱ་མཚོས་བསྐོར་བའི་རྗེས་གནང་གི་བརྒྱུད་པ་ནི།",
    "ཚར་ཆེན་གྱིས་མཛད་ཟ་བསམ་པའི་རྗེས་གནང་གི་ཡི་གེ་བཀའ་རྒྱ་མ་ལ་བརྟེན་ནས་མཐོང་བརྒྱུད་ཀྱི་ཕྱག་བཞེས་དབྲི་བསྣན་དང་བཅས་པའི་སྒོ་ནས་ལས་སྦྱོར་གྱི་མགོན་པོ་གདོང་བརྙན་ཅན་གྱི་རྗེས་གནང་གི་བརྒྱུད་པ་ནི།",
    "འདི་ཉེ་བརྒྱུད་ཡིན་པ་འདྲ་ཞིང་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་གི་ཚར་ལུགས་ནས་བརྒྱུད་པའི་སྐབས་རིང་བརྒྱུད་དང་གོང་དཀར་བ་ལུགས་ཀྱི་གསན་ཡིག་སྐབས་གསན་ཡིག་རྒྱ་མཚོ་སོར་བཞག་བགྲངས་འདུག་པ་རྒྱས་བསྡུས་སུ་མངོན།",
    "དངོས་གྲུབ་རྒྱ་མཚོ་དང་གསང་བ་ཐུན་མོང་མ་ཡིན་པའི་རྗེས་གནང་གི་ཡི་གེ་གསུང་རྒྱུན་ཕྱག་ལེན་ལྟར་ནང་ཞིང་སྐྱོང་ལྟར་སྒྲུབ་པའམ་གསང་སམ་ས་མ་བསམས་ས་བ་སྒྲུབ་ཀྱི་རྗེས་གནང་གི་བརྒྱུད་པ་ནི།",
    "འདིས་སྟན་ཐོག་གཅིག་ཏུ་ཞལ་གྱི་སྔགས་ཐུང་འབུམ་ཕྲག་བརྒྱ་སོང་ཞིང་ཞལ་དངོས་སུ་གཟིགས་པ་ཡིན་ནོ།",
    "ཕྱི་ནང་གི་སྲུང་འཁོར་འཆི་མེད་སྒྲུབ་པ་ཞར་བྱུང་བཟློག་པ་དང་བཅས་པའི་ཕྱིའི་ཉམས་ཁྲིད་དང་།",
    "གསང་ཁྲིད་ཀྱི་ཉམས་ཁྲིད་ཟབ་མོ་སྨིན་རྒྱས་སུ་ཐོབ་པ།",
    "དཀར་ཆག་གིས་མ་ཟིན་པའི་ས་བཅད་གཉིས་པའི་རྟགས་གང་ཡང་མེད་པ་རྣམས་ཀྱི་ལུང་རྣམས་དང་བསམས་པས་ས་པ་བ་། བཅས་པའི་བརྒྱུད་པ་ནི།",
    "ལྕགས་མོ་བཀྲ་ཤིས་སེངྒེ་ནས།",
    "གླང་གི་རྟགས་ཅན་ཡོད་དོ་ཅོག་གི་ལུང་གི་བརྒྱུད་པ་ནི།",
    "སའི་རྟགས་ཡོད་པའི་ལུང་གི་བརྒྱུད་པ་ནི།",
    "དཀར་པོ་ཚེ་འཕེལ་ཐུན་མོང་བ།",
    "སྔོན་པོ་བགེགས་འཇོམས་རྣམས་ཀྱི་རྗེས་གནང་གི་བརྒྱུད་པ་ནི།",
    "ཡང་དཀར་པོ་ཚེ་འཕེལ་ཐུན་མོང་བ་དང་སེར་པོ་རྒྱས་བྱེད་ལྷ་ལྔའི་རྗེས་གནང་གི་བརྒྱུད་ལུགས་གཅིག་ནི།",
    "ནོར་སྒྲུབ་སེར་པོ་ལྷ་དགུའི་རྗེས་གནང་གི་བརྒྱུད་པ་ནི།",
    "དཀར་ཆག་གིས་མ་ཟིན་པའི་ཤི་རྟགས་ཅན་གྱི་ལུང་དང་བཅས་པའི་བརྒྱུད་པ་ནི།",
    "རྗེ་བཙུན་རེད་མདའ་བ།",
    "རྗེ་རེ་ཏེ་ཟླ་བ་ཟེར་བའང་འདུག་གྲུབ་ཆེན་ཐང་སྟོང་རྒྱལ་པོ།",
    "དྲན་པས་ཡིད་སྲུབས་དཔུང་ཚོགས་མཐར་བྱེད་པའི།",
    "འགོར་ཧ་ཡ་གྷི་ཝ་ལ་ན་མོ།",
    "དུར་ཁྲོད་ཆུ་འགྲམ་བྲག་དམར་རམ་ཞེས་པ་ཨཱ་ཙཱརླ་ཉི་མ་གྲགས་པས་མཛད་པ་བྲི་དྷ་ར་ཀྲ་ཤུ་དང་མར་པས་བསྒྱུར་བ་དྲག་ལས་ཐམས་ཅད་ཕོ་མོའི་སྒྲུབ་པ་འདི་གཉིས་ལ་ཐུག་གོ།",
    "དམར་པོ་ཁྲག་གི་མདའ་འཕེན་མ་དང་བཤན་པ་དམར་མོའི་ངན་སྔགས་ཡབ་ཡུམ་སྦགས་ཏེ་སྒྲུབ་པ་གནས་གསར་གྱི་ཕྱག་དཔེར་ང་ཡི་ནོར་གྱི་རྟིང་ལ་རྒྱུག་མན་འདྲི་འཕྲོ་ལུས་འདུག་ཨཱ་ཙཱརླ་ཉི་མ་གྲགས་ཀྱིས་མཛད་པ་རྫོགས་བྱང་གི་མཐའ་ཅན་ཤི་དྷ་ར་ཀྲ་ཤུ་དང་མར་པས་གྲྭ་ཐང་དུ་བསྒྱུར་བ།",
    "ཕོ་རྐྱང་དུ་སྒྲུབ་པ་གནོད་སྦྱིན་ར་ཞོན་ཡམ་ཤུད་དམར་པོའི་སྒེར་སྒྲུབ་གཉན་ལོས་མཛད་པ་བདག་གི་བྲན་བཞིན་ཁོལ་བར་ཤོག་ཡམ་ཤུད་སྲོག་གི་སྒྲུབ་པ་རྫོགས་སོའི་མཐའ་ཅན།",
    "མུས་སྲད་པ་རྡོ་རྗེ་རྒྱལ་མཚན་གྱིས་མཛད་པའི་བསྐང་བ་ལྷ་མཆོག་སྒྲོལ་གིང་མ།",
    "ཨ་མོ་གྷས་མཛད་པའི་བསྐང་བ་དུས་གསུམ་རྒྱལ་བ་མ།",
    "བུདྡྷ་བྷ་དྲས་བསྟོད་པའི་གནོད་སྦྱིན་ཟངས་ཀྱི་བག་ཙེ་མ།",
    "ལྕང་སྤེ་བ་སེངྒེ་འབུམ་གྱིས་མཛད་པའི་བསྟོད་པ་རིག་པའི་ལྷ་མོ་མ།",
    "རྒྱུད་ལས་ཕྱུང་བའི་བསྐལ་གནོད་སྦྱིན་ཟངས་ཀྱི་བེག་ཙེ་མ་དང་རིག་པའི་ལྷ་མོ་མ།",
