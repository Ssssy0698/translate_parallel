    "བྲམ་ཟེ་རྣམས་ནི་དག་པར་བྱེད་པ།",
    "འོ་མ་བསྣུན་པ་དང་བྲམ་ཟེ་ལས་སྐྱེས་པ་མཐོང་ཞིང་འདི་ལྟར་མངལ་ནས་སྐྱེས་པར་མཐོང་བཞིན་དུ་བརྫུན་དུ་སྨྲ་བ་སྟེ།",
    "རྗེའུ་རིགས་དང་དམངས་རིགས་དག་ལུས་ཀྱིས་ཉེས་པར་སྤྱོད་པ་དང་།",
    "ཡིད་ཀྱིས་ཉེས་པར་སྤྱོད་པར་བྱེད་ལ་འོན་ཏེ་བྲམ་ཟེ་རྣམས་མ་ཡིན་ནམ།",
    "བཙུན་པ་བྲམ་ཟེ་དང་དམངས་རིགས་དང་རྗེའུ་རིགས་དག་ཀྱང་ལུས་ཀྱིས་ཉེས་པར་སྤྱོད་པ་དང་།",
    "ཡིད་ཀྱིས་ཉེས་པར་སྤྱོད་པ་དག་སྤྱོད་པར་བགྱིད་དོ།",
    "བྲམ་ཟེ་རྣམས་ལུས་ཀྱིས་ལེགས་པར་སྤྱད་པ་དང་།",
    "ཡིད་ཀྱིས་ལེགས་པར་སྤྱད་པ་སྤྱོད་ཅིང་འོན་ཏེ་རྗེའུ་རིགས་དང་།",
    "བཙུན་པ་བྲམ་ཟེ་དང་རྗེའུ་རིགས་དང་དམངས་རིགས་དག་ཀྱང་ལུས་ཀྱིས་ཉེས་པར་སྤྱད་པ་སྤྱད།",
    "གནས་འཇོག་དེ་ཇི་སྙམ་དུ་སེམས་བྲམ་ཟེ་རྣམས་ལུས་ཀྱིས་ལེགས་པར་སྤྱད་པ་སྤྱད་ཅིང་ངག་དང་ཡིད་ཀྱིས་ལེགས་པར་སྤྱད་པ་སྤྱད་ནས་དེའི་རྒྱུ་དང་དེའི་རྐྱེན་གྱིས་ལུས་ཞིག་སྟེ་ཤི་བའི་འོག་ཏུ་བདེ་འགྲོ་མཐོ་རིས་ཀྱི་འཇིག་རྟེན་དུ་སྐྱེ་བར་འགྱུར་ཞིང་རྗེའུ་རིགས་དང་དམངས་རིགས་དག་མ་ཡིན་ནམ།",
    "བཙུན་པ་བྲམ་ཟེ་དང་རྗེའུ་རིགས་དང་དམངས་རིགས་རྣམས་ཀྱང་ལུས་ཀྱིས་ལེགས་པར་སྤྱད་པ་སྤྱད་ཅིང་།",
    "ངག་དང་ཡིད་ཀྱིས་ལེགས་པར་སྤྱད་པ་སྤྱད་ནས་དེ་དེའི་རྒྱུ་དང་དེའི་རྐྱེན་གྱིས་ལུས་ཞིག་སྟེ་ཤི་བའི་འོག་ཏུ་བདེ་འགྲོ་མཐོ་རིས་ཀྱི་འཇིག་རྟེན་དུ་སྐྱེ་བར་འགྱུར་རོ།",
    "བྲམ་ཟེ་རྣམས་ནི་དག་པར་བྱེད་པ་ཚངས་པའི་བུ་སྟེ་ཁ་ལས་སྐྱེས་པ་སྐྱེ་བ་ལས་སྐྱེས་པ་ཚངས་པས་བྱིན་པའོ་ཞེས་བརྗོད་པ་ལེགས་པར་འགྱུར་ན།",
    "རྩོད་པར་སྨྲ་བས་བཅིངས་པ་དག་བླ་ན་མེད་པའི་རིག་པ་དང་རྐང་པར་ལྡན་པ་མངོན་དུ་བྱས་པ་དང་མངོན་དུ་བྱེད་པར་མི་རིགས་སོ།",
    "བླ་ན་མེད་པའི་རིག་པ་དང་རྐང་པར་ལྡན་པ་མངོན་དུ་བྱས་ཤིང་མངོན་དུ་བྱེད་པར་འགྱུར་རོ།",
    "ཀོ་ས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་བཅོམ་ལྡན་འདས་ལ་གུས་ཞིང་རབ་ཏུ་གུས་པར་བྱེད་དོ།",
    "གནས་འཇོག་ཀོ་ས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་དེ་བཞིན་གཤེགས་པ་ལ་གུས་པ་གུས་པར་འཇུག་པ་མ་ཡིན་གྱི།",
    "གནས་འཇོག་གང་འཇིག་རྟེན་འདི་འཇིག་པར་འགྱུར་བའི་དུས་ཡོད་དེ།",
    "ཇི་ལྟ་ཇི་ལྟར་རོ་མྱངས་པ་དེ་ལྟ་དེ་ལྟར་འདོད་པར་གྱུར་ཏོ།",
    "ཇི་ལྟ་ཇི་ལྟར་འདོད་པ་དེ་ལྟ་དེ་ལྟར་རིམ་གྱིས་ཁམ་གྱི་ཟས་ཡོངས་སུ་སྤྱོད་པར་གྱུར་ཏོ།",
    "ཇི་ལྟ་ཇི་ལྟར་མྱང་བ་དེ་ལྟ་དེ་ལྟར་འདོད་པར་གྱུར་ཇི་ལྟ་ཇི་ལྟར་འདོད་པ་དེ་ལྟ་དེ་ལྟར་རིམ་གྱིས་ཁམ་གྱི་ཟས་ཡོངས་སུ་སྤྱོད་པར་བྱེད་དོ།",
    "དེ་དག་ལས་ཉུང་ཞིང་ཆེས་ཉུང་བར་ཟ་བ་དེ་ནི་ཁ་དོག་དང་ལྡན་པར་གྱུར་ལ།",
    "གང་མང་ཞིང་ཆེས་མང་བར་ཟ་བ་དེ་དག་ནི་ཁ་དོག་ངན་པར་གྱུར་ཏེ།",
    "མིའི་ནང་ན་རྔན་པ་ཅུང་ཟད་ཙམ་ཐོབ་ནས་སྔོན་གྱི་མི་རྣམས་ཀྱི་ཡི་གེ་དང་ཚིག་འབྲུའི་རྗེས་སུ་ཐ་སྙད་འདོགས་པར་བྱེད་པ་ལྟ་བུ་སྟེ།",
    "དེ་དག་ལས་གང་ཉུང་ཞིང་ཆེས་ཉུང་བར་ཟ་བ་དེ་དག་ནི་ཁ་དོག་དང་ལྡན་པར་གྱུར་ལ།",
    "གང་མང་ཞིང་ཆེས་མང་བར་ཟ་བ་དེ་དག་ནི་ཁ་དོག་ངན་པར་གྱུར་ཏེ།",
    "དེ་ལྟར་མི་རྣམས་ཀྱི་ནང་ན་རྔན་པ་ཅུང་ཟད་ཙམ་ཐོབ་ནས་སྔོན་གྱི་མི་རྣམས་ཀྱི་ཡི་གེ་དང་ཚིག་འབྲུའི་རྗེས་སུ་ཐ་སྙད་འདོགས་པར་བྱེད་པ་ལྟ་བུ་སྟེ།",
    "ཀྱི་ཧུད་རཱ་ས་ཀྱི་ཧུད་རཱ་ས་ཞེས་སྨྲེ་སྔགས་འདོན་པར་བྱེད་དོ།",
    "དེ་དག་ལས་གང་ཉུང་ཞིང་ཆེས་ཉུང་བར་ཟ་བ་དེ་དག་ཁ་དོག་དང་ལྡན་པར་གྱུར་ལ།",
    "གང་མང་ཞིང་ཆེས་མང་བར་ཟ་བ་དེ་དག་ནི་ཁ་དོག་ངན་པར་གྱུར་ཏེ།",
    "ནང་པར་བརྔས་ན་དགོངས་ཀ་སྐྱེ་བ།",
    "ཇི་ལྟ་ཇི་ལྟར་སྲེད་པ་དེ་ལྟ་དེ་ལྟར་ལོག་པར་ཞུགས་སོ།",
    "ལན་གཅིག་དང་ལན་གཉིས་དང་གསུམ་དང་བདུན་གྱི་བར་དུ་སྟེན་པར་བྱེད་དོ།",
    "སཱ་ལུ་དེ་དག་རིས་སུ་ཆད་ཅིང་རིས་སུ་གནས་པར་གྱུར་ཏེ།",
    "ནམ་མཁའ་ལ་ཐོགས་པ་མེད་པར་འགྲོ་བ།",
    "བདག་ཅག་དེ་དག་ཉུང་བར་ཟ་བ་དེ་དག་ནི་ཁ་དོག་དང་ལྡན་པར་གྱུར་ལ།",
    "གང་ཆེས་མང་བར་ཟ་བ་དེ་དག་ནི་ཁ་དོག་ངན་པར་གྱུར་ཏེ།",
    "གང་ཆེས་མང་བར་ཟ་བ་དེ་དག་ནི་ཁ་དོག་དང་མི་ལྡན་པར་གྱུར་ཏེ།",
    "བདག་ཅག་དེ་ལས་གང་ཆེས་ཉུང་བར་ཟ་བ་དེ་དག་ནི་ཁ་དོག་དང་ལྡན་པར་གྱུར་ལ།",
    "གང་མང་བར་ཟ་བ་དེ་དག་ནི་ཁ་དོག་ངན་པར་གྱུར་ཏེ།",
    "གང་ཡང་བདག་ཅག་འབྲས་སཱ་ལུ་སོག་འཇོག་ཏུ་ལོངས་སྤྱོད་པར་བྱེད་པ་ན་སཱ་ལུ་དེ་དག་སྦུན་པ་དང་ཤུན་པ་དང་བཅས་པར་གྱུར་ཅིང་བརྔས་ཤིང་བརྔས་པ་དག་ཀྱང་མི་སྐྱེ་ལ།",
    "བརྔས་པ་དང་སྐྱེས་པར་ཡང་ཤེས་སོ།",
    "རིས་དང་རིས་སུ་གནས་པར་གྱུར་ཏོ།",
    "མུ་དང་མཚམས་དག་གཅད་པར་བྱའོ་ཞེས་སྨྲས་ཏེ།",
    "མུ་འདྲེན་ཅིང་མཚམས་དག་འཇོག་པར་བྱེད་དོ།",
    "དེས་ལན་གཉིས་ལན་གསུམ་དུ་རང་ལ་སཱ་ལུ་ཡོད་བཞིན་དུ་གཞན་གྱི་ལ་མ་བྱིན་པར་བླངས་པ་དང་།",
    "ཤེས་རབ་འཕེལ་ཞིང་རྒྱས་པར་སྤྱོད་པ་སྟེ།",
