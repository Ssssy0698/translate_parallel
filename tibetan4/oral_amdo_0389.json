    "ཁམས་གསུམ་ཀུན་ནས་ཉོན་མོངས་སྤོང་བྱེད་གསུང་།",
    "གང་དང་པོར་ཁྱོད་ལ་འདི་མ་གྲུབ་ཅེས་པ་དེ་ལ་གཞན་གྱིས་ཁྱད་པར་བརྗོད་དེ།",
    "གང་གི་ཚེ་ཁྱོད་དང་ཁོ་བོ་ཅག་གཉི་ག་ལ་གྲུབ་པ་ཞེས་མི་སྨྲའོ།",
    "ཁ་ཅིག་ནི་ཕྱིན་ཅི་ལོག་གི་སྒྲོ་བཏགས་པ་ཉིད་དུ་འདོད་དེ།",
    "དེའི་ཚེ་ལུང་དོར་བྱར་འགྱུར་ཏེ་རང་གི་ལུང་ཡང་དོར་བར་བྱ་སྟེ།",
    "དང་གི་སྒྲས་ནི་སྔ་མ་དང་ཕྱི་མའི་དོན་སྡུད་པ་ཡིན་ནོ།",
    "རྩོད་བཅས་ཡིན་ཕྱིར་ལུང་དོར་བར་བྱའོ་ཞེས་འབྲེལ་ཏེ་ཁྱོད་ཀྱིས་ཁས་བླངས་པའི་ལུང་ལས་གཞན་གྱི་ལུང་།",
    "ལུང་གི་ཁྱད་པར་དེ་ཡང་རྩོད་པ་དང་བཅས་པ་ཡིན་པའི་ཕྱིར་ཁས་བླངས་པར་འོས་པ་མ་ཡིན་ནོ།",
    "ཁྱོད་ཀྱིས་ལུང་ཡང་གཞན་ལ་ལྟོས་ནས་རྩོད་པ་དང་བཅས་པ་ཡིན་ཏེ།་",
    "བསྟན་པ་ནི་འདི་ནི་བྱ་བའོ་འདི་ནི་མི་བྱའོ་ཞེས་བཀའ་ལ་གཞོལ་བ་ལ་དགེ་སློང་ཉིད་རྩ་བ་ཡིན་ཏེ་དེ་ལ་དགེ་སློང་གི་དངོས་པོ་ཉིད་དགེ་སློང་ཡིན་ལ།",
    "གང་གི་རྩ་བ་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "དགེ་སློང་གི་འབྲས་བུ་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "རྫུ་འཕྲུལ་གྱི་ཆོ་འཕྲུལ་ལ་སོགས་པ་རྣམས་ཀྱིས་ཉོན་མོངས་པའི་གདུང་བ་ལ་སོགས་པ་སེལ་ནུས་པར་འགྱུར་རོ།",
    "དེ་ལ་མིང་གི་དགེ་སློང་དང་།",
    "ཉོན་མོངས་པ་བཅོམ་པས་དགེ་སློང་སྟེ།",
    "དེ་ལ་ཡང་ཉོན་མོངས་པ་བཅོམ་པའི་དགེ་སློང་ཉིད་གཙོ་བོ་ཡིན་ཏེ།",
    "དགེ་སློང་ཉིད་ནི་ཉོན་མོངས་པ་བཅོམ་པ་ཡིན་ཏེ་ཉོན་མོངས་པ་སྤངས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "སྟོང་པ་མཐོང་བ་ཉིད་མེད་པར་འཚམ་པ་མ་ཡིན་ལ་བདེན་པ་མཐོང་བ་འབའ་ཞིག་གིས་རིགས་པ་མ་ཡིན་ལ།",
    "གང་གི་ཕྱིར་སྡུག་བསྔལ་ལ་སོགས་པའི་བདེན་པ་དེ་རྣམས་ཀྱིས་ཉོན་མོངས་པ་དང་བྲལ་བ་ལ་ཡང་དངོས་པོ་ཉིད་དུ་དམིགས་པས་ཞེས་ཁྱེད་འདོད་པ་ཡིན་ལ།",
    "ཁོ་བོ་ཅག་གི་ཕྱོགས་གཙོ་བོ་ཡིན་པའི་ཕྱིར་ལ།",
    "འདི་ལྟར་ལུང་དང་རིགས་པ་དག་གིས་དེ་ཁོ་ན་ཉིད་དང་དེ་ཁོ་ན་མ་ཡིན་པ་རྣམ་པར་ཕྱེ་བའི་ཕྱིར།",
    "དོན་དམ་པའི་བདེན་པ་ཉིད་ཀྱིས་ཉོན་མོངས་པ་སྤོང་བའི་དོན་དུ་ངེས་པ་ཡིན་ཏེ།",
    "དེ་མེད་པར་ཉོན་མོངས་པ་ལྡོག་པར་འཐད་པ་མ་ཡིན་ནོ།",
    "ཉོན་མོངས་པའི་སེམས་ཀྱི་རྒྱུན་གནས་པ་ཡིན་ལ།",
    "ཇི་སྲིད་དུ་ཉོན་མོངས་པ་ཡོད་པ་དེ་སྲིད་དུ་ལས་ཀྱིས་སྤྲུལ་པའི་སྐྱེ་བ་བརྒྱུད་པས་རབ་ཏུ་གནས་པ་ཡིན་ཏེ།",
    "བདེན་པ་མཐོང་བ་འབའ་ཞིག་གིས་ནི་མ་ཡིན་ནོ།",
    "དགེ་སློང་འབའ་ཞིག་ནི་མ་ཡིན་ལ་འོན་ཀྱང་མྱ་ངན་ལས་འདས་པ་ཡང་ཡིན་ནོ་ཞེས་འང་གི་དོན་ཡིན་ཏེ།",
    "མྱ་ངན་ལས་འདས་པ་ཉོན་མོངས་པ་དང་བྲལ་བས་ཕུང་པོ་ལྷག་མ་མེད་པར་དཀའ་བར་གནས་པ་ཡིན་ཏེ།",
    "དེ་ལ་རེ་ཞིག་དགེ་སློང་ཉིད་མི་འཐད་པར་ཉོན་མོངས་པ་སྤངས་པས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་འཕགས་པའི་བདེན་པ་མཐོང་བས་ཉོན་མོངས་པ་སྤོང་བར་འགྱུར་ན།",
    "དེའི་ཚེ་དེ་མ་ཐག་ཏུ་ཉོན་མོངས་སྤངས་པའི་ཕྱིར།",
    "སུ་ཞིག་གིས་ཀྱང་གཞན་དུ་ཡིན་ནོ་ཞེས་སྨྲ་བ་འདི་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཉོན་མོངས་མེད་ཀྱང་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཐོང་ཞིང་རྟོགས་པའི་ལུང་ལས་ཏེ་གང་གི་ཕྱིར་ཉོན་མོངས་པ་དེ་རྣམས་སྤངས་ན་ཡང་འཕགས་པ་མོད་གལ་གྱི་བུ་དང་།",
    "གང་གིས་ནུས་པ་མཐོང་ཞེ་ན།",
    "སྔར་འཕགས་པ་མ་ཡིན་པའི་གནས་སྐབས་ན་ཉོན་མོངས་པ་དང་བཅས་པའོ།",
    "ཉོན་མོངས་པ་མེད་ཀྱང་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཉོན་མོངས་མེད་ཀྱང་ཞེས་གསུངས་ཏེ།",
    "ལྷན་ཅིག་བྱེད་པའི་ཉོན་མོངས་པ་དང་བྲལ་ན་ཡང་ལས་ཀྱི་ནུས་པ་མཐོང་བ་ཡིན་ནོ།",
    "རེ་ཞིག་ཉེར་ལེན་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གི་ཕྱིར་དམིགས་པ་དང་བཅས་པའི་ལྟ་བ་པ་རྣམས་ལ་མ་རིག་པ་ཞུསྤོང་བ་ཉིད་འཐད་པ་མ་ཡིན་ཏེ།",
    "ཉོན་མོངས་ཅན་མ་ཡིན་པ་ཡོད་ན་སྟེ།",
    "ཉོན་མོངས་པ་དང་མཚུངས་པར་མི་ལྡན་པའི་སྲེད་པ་འདི་ཁྱེད་ཀྱི་རྣལ་འབྱོར་པ་རྣམས་ལ་མེད་པ་ཇི་ལྟར་སྲིད་དེ་ཅི་སྟེ་མེད།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་ཤེས་པ་བཞིན་དུའོ།",
    "རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡིན་ལ་ཚོར་བའི་རྐྱེན་གྱིས་སྲེད་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་གལ་ཏེ་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་མི་ཤེས་པ་ཡོད་ཀྱང་སྲེད་པ་ཁས་མི་ལེན་པ་དེ་ལྟ་ན་ཡང་སྟོང་པ་ཉིད་མཐོང་བ་དང་བྲལ་བས་རིགས་པའི་སྟོབས་ཀྱིས་ཐོབ་པ་ཡིན་ནོ།",
    "གང་གི་ཚེ་རྒྱུད་གྲོལ་བ་ཡིན་ན་ཡང་ལས་འབྲས་བུས་སྟེར་བ་ལ་ནུས་པ་དང་ལྡན་པར་མཐོང་བ་ཡིན་ལ།",
    "སྲེད་པ་ཡང་ཚོར་བ་ཡོད་པ་ཡིན་པ་ན་དེའི་ཚེ་ཉོན་མོངས་པ་སྤངས་པ་ལ་ཡང་ཐེ་ཚོམ་ཟ་བས་ཇི་ལྟར་གྲོལ་བར་ངེས་པར་བྱ།",
    "དཔེར་ན་འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ལ་སྙོམས་པར་ཞུགས་པ་ན་དུས་རེ་ཞིག་སེམས་དང་སེམས་ལས་བྱུང་བ་ལོག་ན་ཡང་སླར་ཡང་སྐྱེ་བར་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་སྟོང་པ་ཉིད་མེད་པར་དགེ་སློང་ཉིད་དང་མྱ་ངན་ལས་འདས་པ་མི་འཐད་དེ།",
    "རྒྱུན་དུ་ཞུགས་པ་འདི་སྙམ་དུ་བདག་གིས་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ཐོབ་བོ་སྙམ་དུ་སེམས་སྙམ་མམ།",
    "རེག་བྱ་ལ་མ་ལགས།",
