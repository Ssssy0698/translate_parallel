    "གཉིས་ཀ་དག་གི་ཡང་རྐང་པ་དག་ཇི་ལྟར་རིགས་པར་གནས་གཅིག་པ་དང་།",
    "མོ་བཱ་རོ་བཱ་ཤཱ་ལི་ནཱི་བེ་ད་ལོ་ཀེ།",
    "མོ་བ་སྲོ་པཱ་ཡ་དི་བཱ་ཏོརྨི་མཱ་ལཱ།",
    "མོ་བཱ་ནོ་བཱ་བཧྲ་མ་ར་བི་ལ་སི་ཏཱ།",
    "རཱཏྤ་རེ་ནར་ལ་གཱ་ར་ཐོདྡྷ་ཏཱ།",
    "ན་ན་ར་ལ་གི་ཏི་ཙེ་ཝ་བྷ་དྲི་ཀཱ་ཛ་ས་ཏ་དང་ག་ག་རྣམས་ནི་ཉེར་གནས་འགྱུར།",
    "གང་གི་རྐང་པ་སོ་སོ་ལ་ཛ་དང་ཏ་དང་ཛ་དང་ར་ཡིན་པ་འདི་ནི་རིགས་གནས་སུ་འདོད་དོ།",
    "སུ་ཞེས་པ་ནི་ས་ཡིག་གི་ཚོགས་སུ་ཡིག་དང་ལྡན་པ་ཡིན་པའི་ཕྱིར་མཐར་ངལ་བས་དང་ལྡན་པ་སྟ།",
    "བཧུ་ཛདྒ་པྲ་ཡཱ་ཏཾ་ཙ་ཏུརྦྷརྱི་ཀཱ་རེ།",
    "མ་ག་ཝ་ར་ར་ཝ་མདའ་རྟས་སྣ་ཚོགས་ལྷ་མོའོ།",
    "གལ་ཏེ་རྐང་པ་སོ་སོ་ལ་མ་དང་ག་དང་བ་དང་ར་གཉིས་པ་དང་བཅས་པ་སྟེ་དེ་ལྟར་མདའ་དང་རྟས་ངལ་བསོ་བ་དེའི་ཚེ་སྣ་ཚོགས་ལྷ་མོའོ།",
    "མོ་བཱ་ནྱ་གའྭ་ཛ་ལ་དྙ་ར་མཱ་ལཱབྦྷྱངྒེ།",
    "མོ་བོ་བྷ་ཏྱཱ་སེ་བ་ཡ་ཏིརྨཏྟ་མ་ཡཱུ་ར།",
    "གལ་ཏེ་རྐང་པ་སོ་སོ་ལ་ན་ན་བ་དང་ཛ་ཛ་བ་སྟེ་རང་རང་གི་དབྱངས་ཀྱིས་སྡོད་དང་བཅས་པ་དེའི་ཚེ་གཞན་གྱིས་མི་ཐུབ་པའོ།",
    "ན་ན་པི་ཛ་ཛ་བི་ཙ་སྭ་རེ་ར་པ་རཱ་ཛི་ཏཱ།",
    "ལྡེབ་སྦྱོར་འདིར་གང་གི་རྐང་པ་སོ་སོ་ལ་ལྕི་བ་མཐར་ཡོད་པའི་ཡང་བ་མ་ནུ་རྣམས་ཡིན་པ་དེ་ནི་རི་བོང་ཅན་གྱི་ཆའོ།",
    "གང་གི་རྐང་པ་སོ་སོ་ལ་ན་དད་ཛ་དང་བྷ་དང་ཛ་དང་ར་རྣམས་ཀྱིས་རྣམ་པར་བསྒྲིགས་པ་འདི་ནི་རྒྱ་མཚོ་ཅན་ནོ།",
    "ན་ཛ་བྷ་ཛ་རེ་རྦི་རཱ་ཛི་ཏ་མི་དཾ་ས་མའུ་དྲ་ཀཾ་བྷ་ར་ཀ་ན་ན་ས་ཐུབ་ལས་མཁའ་ལ་ཁྱུ་མཆོག་གླང་ཆེན་རྩེན་པའོ།",
    "ཡ་མུ་ན་སུ་བྷ་ལ་བ་རྣམས་རོ་དང་འཕྲོག་བྱེད་ངལ་བསོ་གཙུག་བུད་ཅན།",
    "ན་སུམ་བ་ཛ་ཛ་བ་རྣམས་རོ་ཆུ་དབྱངས་ལ་རི་དགས་མོ་རུ་འདོད།",
    "གལ་ཏེ་རྐང་པ་སོ་སོ་ལ་ན་དང་སུ་དང་མ་དང་བ་དང་ཛ་དང་ཛ་དང་བ་རྣམས་ཡིན་པ་དེ་ལྟ་བུ་ལ་རོ་དང་ཆུ་དང་དབྱངས་རྣམས་ཀྱིས་ངལ་བསོ་བ་དེའི་ཚེ་རི་དགས་མོར་འདོད་དོ།",
    "ན་སུ་མ་བ་ཛཛཱ་བ་སཱ་དཱབྡྷི་སྭ་རེ་རྷ་རི་ཎཱི་མཏཱ།",
    "མྲོ་བོ་ནོ་བཤྩ་རོ་བསྟྲི་བཧི་རི་ཏི་བི་ར་ཏི་སྤཏཱ་ཀེ་སྲགྡྷ་གང་ལ་བྷ་ར་ན་ཝ་ཛ་ས་ཛ་སུ་ཕྱོགས་དང་ཉི་མར་ངལ་བསོ་འདི་ནི་ཟབ་མོའི་དབྱངས་སོ།",
    "གང་རྐང་པ་སོ་སོ་ལ་བྷ་དང་ར་དང་ན་དང་བ་དང་ཛ་དང་ས་དང་ཛ་དང་ས་རྣམས་ཡིན་ཞིང་བཅུ་དང་ཉི་མ་རྣམས་ཀྱིས་དལ་བསོ་བ་འདི་ནི་ཟབ་མོའི་དབྱངས་སོ།",
    "མོ་གྭོ་ནོལྐོ་སུ་རྫོ་བཱ་སྱཱདྦ་སུ་མ་ད་ན་ད་ཧ་ན་མུ་ནི་བྷིརྦྷུ་ཛཾ་ག་བི་ཛྲྀམྦྷི་ཏཾ་མ་ན་ནུ་དང་ན་ནུ་རྣམ་གཉིས་ས་ག་ཝ་ཞེས་བྱ་རྣམས་དགུ་དང་རོ་རོ་བྱེད་པར་ངལ་བསོ་བཟློག་ཕྱོགས་འབབ་ཏུ་འགྱུར།",
    "དེའི་བར་མ་ཆད་དུ་རེ་ཕ་བདུན་རྣམས་སུ་གྱུར་པ་ནའོ།",
    "པྲ་ཐ་མ་ཀ་ཨི་ཧ་དཎྜཀཤྩཎྜ་བྲྀཥྚི་པྲ་ཡཱ་ཏོ་བྷ་བེནྣ་དྭ་ཡེ་ནཱ་ཐ་རེ་སཔྟ་བཧི།",
    "འདིར་ནི་རྐང་པ་སོ་སོར་རེ་ཕ་འཕེལ་བར་གྱུར་རྣམས་ཆུ་རྒྱུན་རྒྱ་མཚོ་སྦྲུལ་དང་ཆར་སྤྲིན་རོལ་པའི་འབྱུང་གནས་ཤིན་ཏུ་བཀླུབས་པ་དུང་སོགས་སོ།",
    "འདིར་རྒྱུན་ཆགས་ལ་ཆུ་རྒྱུན་ལ་སོགས་པར་ཕྱེ་བ་རྣམས་ནི་རྐང་པ་སོ་སོ་ལ་ར་ཡིག་རེ་རེ་འཕེལ་བས་སྔ་མ་སྔ་མ་ལས་ཐ་དད་དུ་འགྱུར་རོ།",
    "འདི་ལྟ་སྟེ་ན་གཉིས་ལས་ཕ་རོལ་ཏུ་རེ་ཕ་བརྒྱད་རྣམས་ཀྱིས་ཆུ་རྒྱུན་ནོ།",
    "པྲ་ཏི་པ་ད་མི་ཧ་རེ་ཕ་པྲྀདྡྷཱ་སྱུ་ཏརྞྞཱརྞྞ་བ་བྱཱ་ལ་ཛཱི་མའུ་ཏ་ལཱི་ལཱ་ཀ་རོ་དྷཱ་མ་ཤདྑཱ་ད་ཡ།",
    "པྲ་ཙི་ཏ་ཨི་ཧ་ན་ཡུ་གཱ་དྱེསྟ་ཐཱ་ཙཎྜ་པྲྀཥྚི་པྲ་ཡཱ་ཏཱ་ད་ཡོ་ཡེརྱ་ཐཱ་དཎྜ་ཀོ་རེ།",
    "མཉམ་པའི་བྲྀཏྟ་ལ་རྐང་པ་བཞི་རྣམས་ཀྱི་མཚན་ཉིད་གཅིག་ཡིན་ཞིང་ཕྱེད་མཉམ་པ་ལ་ནི་རྐང་བ་ཟུང་དག་གི་གཞན་དང་།",
    "ཟུང་མིན་དག་གི་གཞན་ནོ།",
    "གང་ལ་ཟུང་མིན་ཏ་ཛ་རེ་ཕ་ལྕི་བ།",
    "ཡ་སྱཱཾ་ཏ་ཛ་རེ་ཕ་གཱ་ཨ་ཡུགྨཾ་ཡུགྨཾ་བྷ་དྲ་པི་རཱཎྨ་སོ་ཛ་གོ་ག།",
    "བི་ཥ་མཾ་ས་མཾ་ཡ་དི་ས་ཛོ་སྒོ་ཀ་ཏུ་བ་ཏཱི་བྷ་རེ་ཕ་ན་ག་གཱཤྩ།",
    "ཟུང་གི་རྐང་པ་ལ་ཛ་དང་ཏ་དང་ཛ་དང་ག་དང་ལྕི་བ་ཡིན་པ་དེའི་ཚེ་ཀུན་བསྒྲགས་སོ།",
    "ཟུང་གི་རྐང་པ་ནི་ཏ་དག་དང་ཛ་དང་ག་དང་ལྕི་བ་ཡིན་པ་དེ་ནི་བཟློག་པའི་ཀུན་བསྒྲགས་སོ།",
    "ཟུང་གི་རྐང་པ་ཡང་གལ་ཏེ་ན་དང་ཛ་དང་ཛ་དང་ར་ཡིན་པ་དེའི་ཚེ་གཞན་སྒོར་འདོད་དོ།",
    "ན་ཛ་ཛ་ར་ག་རྣམས་མེ་ཏོག་རྒྱས་པའི་རྩེ་མོར་བརྗོད།",
    "ཟུང་གི་རྐང་པ་ནི་ན་དང་ཛ་དང་ཛ་དང་ར་དང་ལྕི་བ་རྣམས་ཡིན་པ་དེའི་ཚེ་མེ་ཏོག་རྒྱས་པའི་རྩེ་མོར་བརྗོད་དོ།",
    "ཨ་ཡུ་གི་ཧ་ཡ་དི་ནོ་ར་ཡོཤྩ་ཡུགྨཾ་ན་ཛ་ཛར་གཱ་ཀ་ཐ་ཡནྟི་པུཥྤི་ཏཱ་གྲཱཾ།",
    "ཡ་བའི་སྒྲ་ལས་མ་ཏུས་ཡིན་ཏེ་བུད་མེད་མཚུངས་བར་བརྗོད།",
    "ཟུང་གི་རྐང་པ་ནི་ཛ་ར་ཛ་ར་ལྕི་བ་རྣམས་ཡིན་པ་དེའི་ཚེ་ནས་ལྡན་མའོ།",
    "ཡ་ཝའི་སྒྲ་ལས་མ་ཏུས་ཀྱི་རྐྱེན་གང་ཡིན་པ་དེ་བརྗོད་བྱ་ལས་བུད་མེད་ཉིད་མཚུངས་པར་བསྟན་པ་ནི་ནས་ལྡན་མ་ཞེས་པའི་དོན་ཏོ།",
    "རེ་ཕ་ཛོ་ར་ཛོ་ར་ཐའ་ཛ་རོ་ཛྲ་གཤྩ་ཡ་བ་དཧྭ་ནཱཏྨ་ཏུ་སྲི་ཡཱ་ས་མཱ་བཧི་དྷཱ་ནཱ།",
    "ཟུང་གི་རྐང་པ་གལ་ཏེ་ཡང་བ་གསུམ་བཅུ་ཡིན་པ་དང་།",
    "ད་ཤ་ད་ཤ་བ་སུ་ལ་གྷུ་ཙ་ཡ་དི་བི་ཥ་མ་མི་ཏ་ར་ད་པི་ཙ་ད་ཤ་ད་ཤ་ད་ཤ་ལ་གྷུ་ཀཾ་གུ་རུ་ནི་དྷ་ན་མུ་བྷ་ཡ་མ་པི་བི་ཧི་ཏ་ལ་ལི་ཏ་པ་ད་བི་སྲྀ་ཏི་ཡ་དི་བྷ་བ་ཏི་མཉམ་དང་མི་མཉམ་རྐང་པ་དག་གིས་ཡོངས་སུ་བརྗོད་པ་ངེས་པའི་གནས་ནི་ངེས་པ་དང་བྲལ་བྱས་པས་འདབ་མར་བཀོད་པའི་ངེས་པ་འདི་དག་ནི།",
    "སྐྱེས་བུ་རྐང་པ་འཁྱོག་པ་ནི་འཐེང་པོ་ཞེས་བརྗོད་དོ།",
    "དེས་ན་གང་གི་མིང་དེ་དང་འདྲ་ཞིང་མཚུངས་པར་བརྗོད་པ་དེ།",
    "ཨཥྚཱ་ཀྵ་རེ་ཥུ་པཱ་དེ་ཥུ།",
    "རྐང་པ་ཟུང་དག་ཛ་ཡིག་གིས་ནི།",
    "ཁ་སྒོ་ཕན་པ་ཞེས་བརྗོད་པ་དེ་ཉིད་ཁྱད་པར་གང་གིས་ཤེ་ན།",
    "རྐང་པ་ཟུང་དག་གི་མཚོ་ལས་ཕྱི་མ་ཛ་ཡིག་གིས་སོ།",
    "ཡུཀྤཱ་ད་ཡོ་རྫ་ཀཱ་རེཎ།",
    "ཁྱད་པར་གང་གིས་ཤེ་ན།",
    "རྐང་པ་མི་མཉམ་པ་དག་གི་རྒྱ་མཚོ་ལ་ས་ཕ་རོལ་ཏུ་ན་ཡིག་ཡིན་ནའོ།",
    "ན་ཀཱ་རེ་ཎཱ་ཡུ་ཛོ་ཛྙེ་ཡཱ།",
    "ཁ་སྒོ་འདི་ཉིད་དུ་གང་གི་ཟུང་གི་རྐང་པ་དག་བདུན་པ་ཡང་བ་ཡིན་པ་དེ་ཐུབ་པ་དམར་སེར་གྱིས་ཡངས་མར་འདོད་དོ།",
    "ན་ཡིག་གིས་ཀྱང་དེ་བཞིན་ཡང་ངོ།",
    "ཁ་སྒོ་ལ་ཐམས་ཅད་དུ་རྒྱ་མཚོ་ལས་ཕ་རོལ་ན་ཡིག་གིས་ཀྱང་དེའི་ཡངས་མ་སྟེ།",
    "ན་ཀཱ་རེ་ཎཱ་པི་ཙ་ཏ་ཐཱ།",
    "ཏ་ཡིག་གིས་ཀྱང་དེ་ལྟར་ཉིད་དོ།",
    "ཁ་སྒོ་ལ་ཐམས་ཅད་དུ་རྒྱ་མཚོ་ལས་ཕ་རོལ་ཏ་ཡིག་གིས་ཀྱང་དེའི་ཡངས་མ་སྟེ།",
    "ཨེ་བཾ་ཏ་ཀྵ་རེ་ཎཱ་པི་བ།",
    "དེ་ལས་གཞན་ནི་བླ་རེ་ཡིན་ནོ།",
    "ཟུང་མིན་དག་གི་ཇི་ལྟར་མཛེས་པས།",
    "གང་གི་ཁ་སྒོའི་བྱེ་བྲག་བརྗོད་ཟིན་པ་དེ་རྣམས་དང་།",
    "དེའི་བསྡུ་བས་སྙན་ངག་མཁན་རྣམས་ཀྱི་དེ་ལྟ་བུ་ཉིད་ཀྱི་སྦྱོར་བ་ཕལ་མོ་ཆེ་བལྟ་པར་བྱ་སྟེ།",
    "ཟུང་གི་རྐང་པ་དག་གི་རྒྱ་མཚོ་ལས་ཕྱི་མ་ཛ་ཡིག་ཡིན་ལ།",
    "ཟུང་མ་ཡིན་པའི་རྐང་པ་དག་གི་རྒྱ་མཚོ་ལས་ཕྱི་མར་བྷ་དང་ར་དང་ན་དང་ཏ་དང་མའམ།",
    "གང་གི་རྐང་པ་དང་པོ་ཡི་གེ་བརྒྱད་ཡིན་ཞིང་།",
    "པྲ་ཐ་མོཉཥྚཱཀྵ་ར་སཱ་དཤྩ་ཏུརྦྷི་ར་ཏི་ཝརྡྷི་ཏཱ་པར་ཉམུཥྨཱཏ།",
    "ཀྲ་མ་ཤོ་ཡ་སྱ་ཏ་དེ་ཏནྣཱ་ན་བི་ནྱཱ་ས་སཾ་ཤོ་བཧི་ས་ལ་ལི་ཏ་པ་ད་པ་ད་བའི་ཀཾ་པ་ད་ཙ་ཏུ་རུརྡྷཾ་བུདཱ་པྲཱ་ཧུ།",
    "འདིར་རྐང་བཞི་འཕེལ་གྱི་རིགས་ཉིད་ལ་གང་གི་རྐང་པ་མཐར་ལྕི་བ་གཉིས་དང་ཅིག་ཤོས་ཐམས་ཅད་། ཡང་བ་གང་ལ་ཉེ་བར་ཕན་ཞིང་རོལ་སྒེག་དང་བཅས་པའི་དལ་བ་སོའི་འགྲོ་བ་འདི་ལྟར་གྱུར་པས་གལ་ཏེ་འཇིག་རྟེན་གྱི་དགའ་བ་ཡང་འདྲེན་པར་བྱེད་པ་ཡིན་ན།",
    "འདིར་ནི་ཡང་དག་ཤིན་ཏུ་ལྷུང་བའི་རྐང་པ་དག་གི།",
    "འདིར་ནི་ཡང་དག་ཤིན་ཏུ་ལྷུང་བའི་རྐང་པ་དག་གི།",
    "རབ་ཏུ་སྤྲོས་པའི་ཚིག་གི་བཀོད་པས་རོལ་སྒེག་ལྡན་པ།",
    "གང་ལས་རབ་ཏུ་སྤྲོས་པའི་ཚིག་གི་བཀོད་པས་རོལ་པ་དེའོ།",
    "གལ་ཏེ་གཞན་གསུམ་རྣམས་ནི་དལ་འགྲོ་དག་དང་ཚོགས།",
    "གང་གི་ཚེ་རྐང་པ་གསུམ་པ་ལ་ཏ་དང་ཛ་དང་ར་ཡིན་ཞིང་།",
    "གལ་ཏེ་དེའི་རྐང་བ་གསུམ་པ་དལ་འགྲོ་དང་ཚོགས་མཚུངས་པར་གྱུར་པ་དེའི་ཚེ་དག་པ་སྣང་ལྡན་གྱི་ཁྱད་པར་རབ་མཆོག་ལྡན་དུ་བརྗོད་དེ་དག་པ་སྣང་ལྡན་རབ་མཆོག་གི་བྲྀཏྟ་ར་སྨྲའོ་དལ་འགྲོའི་བྱེ་བྲག་རྣམས་ཏེ།",
    "ཡང་བ་ཕྱི་མོ་གཅིག་སྟེ་ལྕི་བ་ནི།",
    "གཉིས་སུ་འགྱུར་རོ་གསལ་བྱེད་དག་གིས་མིན།",
    "རོ་ལངས་ཅན་དང་ཕྱི་མོ་མཉམ་པའོ།",
    "ཕྱི་མ་གསུམ་མ་གཏོགས་པའི་ཕྱི་མོ་མཉམ་པ་ནི་མཉམ་པའི་བྲྀཏྟ་དང་མཚུངས་སོ།",
    "གང་ཡང་ཛཱ་ཏི་རྣམས་ལ་ཕྱི་མོས་བགྲང་བར་བྱའི་དེ་གསལ་བྱེད་ཀྱིས་མ་ཡིན་ནོ།",
    "འོན་ཀྱང་ཡང་བ་གཅིག་གིས་ཕྱི་མོ་གཅིག་དང་།",
    "ལྕི་བ་གཅིག་གིས་ཕྱི་མོ་གཉིས་སུ་འགྱུར་རོ།",
    "ཕྱི་མོ་བཞི་པ་དེ་ལྔ་རྣམས་ནི་ཙ་ཡིན།",
    "ཕྱི་མོ་གཅིག་པ་ཀ་སྟེ་ཕྱི་གཉིས་ད།",
    "ཕྱི་མོ་བཞི་པའི་ཚོགས་རྣམས་བྷ་དང་ཛ་དང་ས་དང་ལྕི་བ་གཉིས་དང་ཡང་བ་བཞི་སྟེ་ལྔར་འགྱུར་རོ།",
    "ཕྱི་མོ་གཅིག་གི་ཚོགས་ནི་ཀའི་མིང་ཅན་ནོ།",
    "ཕྱི་མོ་གཉིས་ནི་དའི་མིང་ཅན་ནོ།",
    "གལ་ཏེ་ཕྱེད་པ་གཉིས་ཀ་དག་གི་ཚོགས་བརྒྱད་ཡིན་པ་དེའི་ཚེ་འཕགས་མར་འགྱུར་རོ།",
    "མི་མཉམ་པའི་གནས་དང་པོ་དང་གསུམ་། དང་ལྔ་པ་དང་བདུན་པ་རྣམས་ལ་ཛ་ཡིག་སྤངས་པ་དེར་ཕྱེད་ཕྱི་མ་དྲུག་པའི་ཚོགས་ཕྱི་མོ་གཅིག་ཏུ་བྱས་ཤིང་།",
    "ཕྱེད་པ་གཉིས་ཀ་དག་གི་འང་བརྒྱད་པའི་ཚོགས་ཕྱི་མོ་གཉིས་དང་ལྷག་མ་རྣམས་ཕྱི་མོ་བཞི་རྣམས་སོ།",
    "གང་གི་ཚེ་བྱེད་སྔ་མའི་དྲུག་པ་ཁ་ཡིག་ཏུ་གྱུར་པ་དེའི་ཚེ་ནི་དེའི་དང་པོ་ལ་ཡང་བའི་ངལ་བསོ་བྱའོ།",
    "གང་གི་ཕྱེད་སྔ་མ་ལའང་དྲུག་པའི་ཚོགས་ཁ་ཕ་རོལ་ཡིན་པ་འདི་ལས་ཕ་རོལ་ཁ་ཡིན་པ་ནི་ཁ་ཕ་རོལ་ལོ།",
    "འདབ་མ་ཕྱི་མ་སྟེ་ཕྱེད་ཕྱི་མ་དེ་ལ་བཞི་པའི་ཚོགས་གལ་ཏེ་ཁ་ཕ་རོལ་ཡིན་ཞིང་འང་གི་སྒྲ་ལས་དྲུག་པའང་ཡིན་པ་དེའི་ཚེ་དེའི་མཐར་ཡང་ངལ་བསོ་བྱའོ།",
    "དེ་ནས་ཕྱི་མོ་གཅིག་པའི་ཚོགས་ཀྱི་ཀ་མཐའོ།",
    "གང་གི་ཚེ་ཙ་ཡིག་གསུམ་རྣམས་ཀྱིས་ཟུང་མ་ཡིན་པའི་རྐང་པ་གཅིག་གིས་ཀྱང་མ་རྫོགས་པ་དེའི་ཚེ་ནི་ཡངས་མའོ།",
    "བཞི་པའང་དེ་ལྟ་བུ་དག་གི་བར་དུ་ལྕི་བ་གཉིས་ཞུགས་པ་ཕྱེད་པ་གཉིས་ཀ་དག་ལ་གྱུར་པ་དེའི་ཚེ་འཕགས་མ་ཀུན་ནས་གཡོ་བའོ།",
    "ཀུ་རུ་མ་དྷྱ་བརྟི་ནོ་ཙེདྡི་ཏཱི་ཡ་ཏུརྱོ་ག་ཎོ་ཛ་ཀཱ་རཱ་ཁྱོ།",
    "པཱུརྦཱརྡྷ་བཙྩ་ཤེ་ཥ་པྲ་ཏི་ནི་ཡ་མོ་བྷ་བ་ཏི་བྷ་བ་ཏི་སཱ་གའི་ཏི།",
    "གང་གི་འདབ་མ་གཉི་གའི་ཡང་།",
    "འཕགས་མ་གང་གི་ཕྱེད་གཉིས་ཀ་དག་གི་འང་དྲུག་པའི་ཚོགས་ཀ་རུ་གྱུར་ཅིང་།",
    "ཤེ་ཥ་པྲ་ཏི་ནི་ཡ་མོད་ལ་བི་སརྱ་ཡཱདྦྷ་བ་ཏི་བྷ་བ་ཏི་སོདྒཱི་ཏི།",
    "གྱུར་པ་དེ་ནི་འཕགས་མའི་དབྱངས་སུ་འགྱུར་། འཕགས་མ་གང་གི་ཕྱེད་ཕྱེད་ལ་ཙ་ཞེས་བྱ་བའི་ཚོགས་བརྒྱད་རྣམས་ཡིན་ཞིང་།",
    "ད་ཞེས་པ་ཕྱི་མོ་གཉིས་སུ་བརྗོད་ཟིན་ཏོ།",
    "ཟུང་མ་ཡིན་པའི་རྐང་པ་དག་གི་དང་པོར་ད་གསུམ་རྣམས་དང་།",
    "ཟུང་གི་རྐང་པ་དག་གི་དང་བོར་ད་བཞི་རྣམས་ཡིན་ཞིང་།",
    "ཟུང་གི་རྐང་པ་དག་ལ་ཡང་བ་དྲུག་པར་མ་ཆད་དུ་མ་གྱུར་བ་དེ་ནི་རོ་ལངས་ཅན་དུ་བརྗོད་བར་བྱའོ།",
    "གལ་ཏེ་ཟུང་གི་རྐང་པ་དང་པོ་དག་གི་དང་པོར་ད་ལས་ཕ་རོལ་དག་ཏུ་ཛ་དང་ད་དག་ཡིན་ལ།",
    "གལ་ཏེ་ཟུང་མིན་གྱི་རྐང་བ་དག་གི་དང་པོར་ཛ་དང་ད་ཡིན་ལ།",
    "ཀུན་འཕེལ་གྱི་ཟུང་གི་རྐང་པ་བཞི་རྣམས་ཀྱིས་གཞན་གྱི་མཐའ་ཅན་དུ་འགྱུར་རོ།",
    "ཕྱི་མོ་མཉམ་སོགས་རྐང་པ་དཀྲུགས་པ་ལ།",
    "གང་བར་མ་ཆད་དུ་བརྗོད་པའི་མཚན་ཉིད་བསྟན་པ་ཕྱི་མོ་མཉམ་པ་ལ་སོགས་པ་ལྔ་པོ་རྣམས་ཀྱི་རང་པ་དེ་རྣམས་ཇི་ལྟར་འདོད་པ་བཞིན་བཟུང་ནས་དཀྲུགས་པ་དེ།",
    "གང་གི་ཕྱེད་ལ་བརྒྱད་བརྒྱད་དག་ནི་ག་གཞན་ཡང་མཐའ་དག་ཆུ་གཏེར་ནོར་གྱིས་བསྒྱུར།",
    "གང་གི་རྐང་པ་རྣམས་ལ་ཙ་ཡིག་བཞི་ཡིན་པའི་ཕྱེད་པ་གཉིས་ཀ་ལའང་།",
    "ཛ་མེད་རང་གི་དང་པོ་ཡིན་པ་བྷ་བྲལ་གང་ཞིག་ཙ་ད་ཀ་ད་ཀ་དང་ཙ་གསུམ་ཛ་ག་ཞེས་དུ་མ་བུ་། རྐང་པ་སོ་སོ་ལ་གལ་ཏེ་ཙ་དང་ད་དང་ཀ་དང་ད་དང་ཀ་དང་ཙ་གསུམ་དང་ཛ་དང་གཉིད་ཡིན་པ་དུམ་བུར་འགྱུར་ཏེ།",
    "གང་ཡང་ཚོགས་དང་པོ་མ་གཏོགས་གཞན་དུ་བྷ་ཡི་གདོར་བ་ཡིན་ནའོ།",
    "ཙད་ཀ་ད་ཀཏྲིཾ་ཙཾ་ཛ་གི་ཏི་ཁཎྜ་མཛཾ་བྷ་ར་ཧི་ཏ་མ་ནཱ་དི་མེ།",
    "ཕྱི་མོ་མཉམ་པའི་ཛཱ་ཏི་རྣམས་སོ།",
    "རིམ་པར་རིམ་པར་རེ་རེ་སྦེལ་བར་བྱ།",
    "གང་གི་ཚེ་མི་མཉམ་པའི་བྲྀཏྟ་གཅིག་པུ་དེ་དྲི་བྲ་འདོད་པ་དེའི་ཚེ་ཆོ་ག་འདིའོ།",
    "གང་གི་ཚེ་བྲྀཏྟ་རྣམས་རང་གི་ངོ་བོས་ནི་དུ་པ་ཡིན་ཞེས་ཤེས་པར་བྱ་བ་ལ་འདི་ལྟ་བུ་མ་ཤེས་པ་དེ་ཤེས་པའི་དོན་དུ་ནི་ཨུདྡིཥྚའི་ཆོ་གའོ།",
    "རི་མོ་རྣམས་ཀྱི་སྟེང་དུ་གཅིག་ལ་སོགས་པ་རིམ་གྱིས་ཉིས་འགྱུར་དུ་སོང་བ་རྣམས་རིམ་པས་བྲི་སྟེ།",
    "དེ་ལ་ཡང་བ་རྣམས་ཀྱི་སྟེང་གི་ཨངྐ་གང་ཡིན་པ་དེ་རྣམས་ནི་ཡང་བའི་སྟེང་སྟེ།",
    "གཉིས་ཡང་བ་རྣམས་ནི་ཞེས་པ་ལ་སོགས་པ་གང་གི་ཚེ་ཤེས་པར་འདོད་པ་དེའི་ཚེ།",
    "རང་རང་གི་འོག་མ་མཉམ་པ་རྣམས་ཀྱི་སྟེང་མ་སྟེང་མར་ཡི་གེ་དང་མཉམ་པའི་གྲངས་ཀྱིས་གཞུག་གོ།",
    "དེ་ལྟ་བུས་རེ་རེ་བ་ལྔར་འགྱུར་རོ།་",
    "ཀྱང་གི་སྒྲས་བྱས་ཀྱང་ངོ།",
    "དེའི་འོག་ན་གནས་པ་གཉིས་ལ་རང་གི་འོག་གི་མཉམ་པ་གཅིག་པོས་བསྲེ་བར་བྱའོ།་",
    "རང་རང་གི་འོག་གི་མཉམ་པ་གསུམ་དང་གཅིག་པོས་ཀྱང་བསྲེ་བར་བྱའོ།་",
    "ཟུང་གི་ཡི་གེའི་གྲངས་སུ་སྒྱུར།",
    "དེ་རྗེས་ཕྱི་མོ་རྣམས་ཡིན་ནོ།",
    "དེ་ནས་ཕྱིས་དེའི་ཕྱེད་དང་དེ་ནས་ཀྱང་ཕྱིས་དེ་གཉིས་ཀ་བསྡམ་མོ།",
    "ཐ་མ་ནི་ཕྱི་མོ་རྣམས་ཏེ་དགུ་བཅུ་རྩ་དྲུག་གོ།",
    "ཡི་གེ་དང་ལྕི་ཡང་དང་ཕྱི་མོའི་གྲངས་སོ།",
    "དེའི་ཕྱིར་ནས་སམ་སོར་ལ་སོགས་པ་སུམ་ཅུ་སོ་གཅིག་འོག་གི་ཨ་དཧྭའོ།",
    "རི་མོ་རྣམས་ཀྱི་ཇི་སྙེད་པ་དེ་སྙེད་ཉིད་དུ་དེའི་བར་རྣམས་ཀྱིའོ།",
    "ཛཱ་ཏི་རེ་རེ་ལ།",
    "ཡི་གེ་དང་ཕྱི་མོ་རྣམས་ཀྱི་གྲངས་ཤེས་པ་བརྗོད་པར་བྱའོ།",
    "ཏཛྫ་ནི་ཏོ་ཡཤྩ་ཛ་ནོ་ཛ་ཡནྟི་ཏེ་བུདྡྷ་དྷརྨྨ་ག་ཎ།",
    "གཉིས་ལ་ལྷག་མོས་ས་བོན་ལས་བྱུང་བ།",
    "ལུས་ཅན་འཕགས་པའི་ཚོགས་རྣམས་རྒྱལ་གྱུར་ཅིག་ཛ་ཡ་ཏི་ཛི་ནོ་དྷརྨྨཱ་མོ་ཛ་ཡ་ཏི་ཕྲཛྙཱ་ཙ་ས་ཧ་ཙ་རཱི་ཏ་སྱ།",
    "འདིར་ཕྱི་མོ་རྣམས་ལྔ་བཅུ་རྩ་བདུན་ནོ།",
    "ཡང་བ་རྣམས་ཉི་ཤུ་རྩ་གསུམ་མོ།",
    "ཕྱི་མོ་ཡང་བ་དོར་འདབ་མའང་།",
    "ཡི་གེ་དོར་བའི་ཕྱི་མོ་ཡང་།",
    "ཡི་གེ་ཕི་མོ་ཕྱི་མོ་ལྕི་བ་ཇི་ཙམ་ཡོད་ཅེས་འདྲི་ན།",
    "ལྕི་བ་ཉིས་འགྱུར་གྱིས་ཕྱི་མོ།",
    "ཡི་གེ་ཉིས་འགྱུར་ཕྱི་མོས་སྤངས།",
    "ཕྱི་མོ་ཡི་གེ་ཡི་གེ་དང་པོ་ལ་ལྕི་བ་རྣམས་ཉིས་འགྱུར་དུ་བྱས་ཏེ་དབྲིའོ།",
    "དབུས་སུ་ཡི་གེ་རྣམས་ཉིས་འགྱུར་དུ་བྱས་ཏེ་ཕྱི་མོས་དབྲིའོ།",
    "ཕྱི་མོ་ལྕི་བྲལ་ཇི་སྙེད་དོ།",
    "ཇི་སྙེད་ཕྱི་མོ་ཡང་བསྡོམས་འདབ།",
    "ལྕི་བ་ཕྱི་མོ་ཕྱི་མོ་དང་པོ་ལ་བསྣན་ནོ།",
    "དེ་རྣམས་ཇི་སྙེད་འདིར་ཕྱི་མོ།",
    "དེ་ལྟ་བུས་ཕྱི་མོ་ལྔ་བཅུ་རྩ་བདུན་འགྱུར་རོ།",
    "ཕྱི་མོའི་གྲངས་སོ།",
    "ཚིག་རྣམས་དག་གི་རང་གི་རྒྱན་གཅིག་པུ།",
    "འདི་ཡིས་རྒྱལ་བར་གྱུར་ཅིག་བཅོམ་ལྡན་དང་པོར་མཛོད་ཅིག་ཁྱོད་ཉིད་གཅིག་པུ་ལ་སྐྱབས།",
    "ཅུང་ཟད་རྣམ་པར་གཟིགས་མཛོད།",
    "ཁྱོད་ཉིད་ཐོབ་ནས་རབ་ཏུ་འབར།",
    "འཛིན་ཡང་ཁྱོད་ཀྱི་སྐུ་དག་ནི།",
    "སྐྱེ་བོའི་ཚོགས་རྣམས་དག་གི་གཟུགས།",
    "གང་གི་ཡོན་། ཏན་བསྟོད་པ་རྒྱས་ལས།",
    "མཆོག་གི་གནས་སུ་རབ་འཁྲུངས་རྣམས་ཀྱིས།",
    "སྐྱེ་བོ་དག་གི་མཉམ་དུ་གསལ་བྱེད་། རིན་ཆེན་དབྱིག་པ་བཞིན་དུ་གྱུར་ཏོ།",
    "མི་བཟད་ཉོན་མོངས་གདུང་བ་འཇོམས་ནུས།",
    "ཁྱོད་ཀྱི་མཛེས་ལྡན་འདི་ཡི་རྒྱན་འཛིན།",
    "མཚན་མའི་དབྱུག་པ་འཛིན་མཛད་ཁྱོད་ཀྱི།",
    "འགྲོ་བ་གསུམ་ལ་རང་གི་ལུགས་ནི།",
    "ཁྱོད་ཀྱི་ཕྱག་མཐིལ་གཡོ་བ་དག་ནི།",
    "གང་ལ་ཁྱོད་ཀྱི་ཟུར་མིག་དག་ཀྱང་ནི།",
    "ཁྱོད་སྤྱན་ཉིད་དང་ཡོངས་སུ་འདྲིས་པ་ལ།",
    "དེ་ཉིད་སྐྱེད་བྱེད་འདི་ལ་གང་གི་ཕྱིར།",
    "ཁྱོད་ཀྱི་གསུང་གི་ས་བོན་བཏབ་པ་ན།",
    "ལག་འགྲོ་ཕྲུ་གུ་དག་གིས་བགྲོད་པ་བཞིན།",
    "སྐྱེས་པའི་ཀུན་དགའ་བརྟན་འཇོམས་དག་གིས་ནི།",
    "རང་གི་ནུས་པ་རྟོགས་པས་བཀོད་པ་ཡི།",
    "དཔལ་གྱི་གནས་གྱུར་ཁྱོད་སྐུ་རོལ་སྒེག་མཁས་པ།",
    "པདྨོ་ཅན་གྱི་ཉི་མ་ཁྱོད་ལ་འདུད་དོ།",
    "མགོན་པོ་ཁྱོད་ཀྱི་འབྱོར་བ་མཆོག་ཏུ་མཛེས་ཏེ།",
    "རི་ཡི་ཁྱད་པར་དག་གེ་རྩེ་མོའི་ས་ནི།",
    "མགོན་པོ་འཇིག་རྟེན་གསལ་བར་མཛོད་པ་ཁྱོད་ཀྱི།",
    "བློ་ལྡན་དཔལ་གྱི་གནས་གྱུར་ཁྱོད་གསུང་འཇིག་རྟེན།",
    "རིགས་ཀྱི་རྒྱན་གྱུར་ཁྱོད་ལ་གསལ་བ་ཉིད་དུ།",
    "རབ་གསལ་རང་གི་མཛེས་པ་ཕུན་སུམ་ཚོགས་པ།",
    "ཁྱོད་ཀྱིས་རྒྱན་ཕྲེང་ཟིལ་གྱིས་མནན་པར་གྱུར་ཏོ།",
    "ཁྱོད་ཀྱི་ལག་གཡོ་ཕན་ཚུན་ཕྲད་པ་དག་ལས།",
    "གཡོ་བ་དག་གིས་འགྲོ་རྣམས་བསྲུང་བར་གྱུར་ཅིག་ཁྱོད་ཀྱི་གཟུགས་དང་ཡོན་ཏན་ཚོགས་དང་གྲགས་པ་དག་ཕུལ་བྱུང་ལྡན་འདི་མ་ལུས་ཡང་དག་མཐོང་གྱུར་ནས།",
    "རང་གི་ཡུལ་ལ་དགའ་བྲལ་རྣམ་པར་འཛིན་བྱེད་ཅིང་།",
    "གཙོ་བོ་ཁྱོད་ཀྱི་སྐུ་ནི་ཀུན་ནས་བཟང་ལྡན་པ།",
    "མི་ཆུང་རྩེ་བ་དག་གི་ཁུ་བ་ལྟ་བུ་ཡི།",
    "ཡོན་ཏན་ཚོགས་པ་བཞིན་དུ་ཁྱོད་ལ་རྣམ་པར་མཛེས།",
    "གཞི་མཉམ་དག་གི་ཕྱེ་མ་འཛིན་པ་བཞིན་དུ་ནི།",
    "འདབ་མར་བདེར་ཉལ་བུད་པའི་རྩེ་དགའ་ཡོངས་མ་རྫོགས།",
    "ཁྱོད་ཀྱི་ཆུ་སྐྱེས་སྔོན་པོའི་དཔལ་འདི་རྣམ་པར་མཛེས།",
    "གང་གི་ཡུན་རིང་དག་ཏུ་མིག་འཛུམས་བྲལ་བར་ནི།",
    "འདི་འཐུང་བྱེད་པ་མིག་གི་ཚོགས་པ་ཐོབ་གྱུར་པ།",
    "ཁྱོད་ཀྱི་གཟུགས་ཀྱི་བཅུད་ལེན་གོམས་པར་གྱུར་པས་ན།",
    "ལག་པའི་ཐལ་མོ་སྦྱར་བས་སྐལ་ལྡན་རྣམས་ཀྱི་ནི།",
    "ཁྱོད་ཀྱི་ཞབས་གཉིས་འདི་ནི་ཉེ་བར་བསྟེན་གྱུར་ཏོ།",
    "དྲག་པོའི་ལས་དང་ཉོན་མོངས་དག་གིས་ངེས་པར་ནི།",
    "ཤིན་ཏུ་མཐའ་བྲལ་སྲིད་པ་དག་གི་བར་དུ་ནི།",
    "སྐྱོན་མེད་རིང་དུ་མཐོང་བའི་ཡིད་ཅན་རྣམ་དག་གི་ཁྱོད་ནི་ཡོངས་བསྟེན་ཡིད་ཀྱི་ཤིང་རྟ་འཕྱར་གྱུར་པ།",
    "གདུད་པ་གཅོད་བྱེད་བསྟོད་པའི་ཚོགས་རྣམས་དག་གི་གནས།",
    "ཤིན་ཏུ་དམ་པའི་ཡིད་འཕྲོག་ཁྱོད་ཀྱི་གྲགས་པ་ནི།",
    "རབ་མཐོ་སེང་གེའི་ཁྲི་ལ་ཡང་དག་བཞུགས་པ་ཁྱོད།",
    "ཁྱོད་ཀྱི་ཞབས་དག་མཉན་འོས་བགྲོད་པ་སྤྲོས་པ་ཡང་།",
    "གང་དག་རྣམས་ཀྱི་མིག་གི་སྤྱོད་ཡུལ་དུ་གྱུར་པ།",
    "གཞན་དག་ཡོད་པར་གྱུར་ཀྱང་ཐེ་ཚོམ་མེད་པར་ཁྱོད་ནི།",
    "གཞན་དང་ཐུན་མོང་མིན་པའི་བློ་གྲོས་དག་གི་བདག་པོ།",
    "ལྷག་པའི་མགོན་པོ་ཁྱོད་ཀྱི་ཡོན་ཏན་ཕ་རོལ་མ་ཕྱིན།",
    "བདག་གི་སྟོན་པ་རབ་ཏུ་ཉུང་བ་འདི་ཡང་།",
    "གསལ་ལྡན་མ་ལུས་རྒྱན་རྣམས་དག་གིས་བསྔགས་པར་འོད་ལྡན།",
    "ཁྱོད་ཉིད་ཀྱི་ནི་མཐུ་ལས་ཡོན་ཏན་སྣ་ཚོགས་ལེགས་ཐོབ།",
    "ཤིན་ཏུ་བརྟན་ལས་ཡོན་ཏན་ཚོགས་ཀྱི་རིན་ཆེན་བཀྲ་། བས་། ནང་གི་ཡོངས་སུ་གང་བས་ཆུ་ཡི་ཕུང་པོའི་ལུགས་དང་།",
    "ཁྱོད་ཀྱི་མདུན་དག་ཏུ་ནི་མཆོག་དང་དམ་པར་རབ་འདོད།",
    "གྲགས་པ་དག་ནི་ཡུན་རིང་གནས་པ་ཁྱོད་ལས་འབྱུང་སྟེ།",
    "བརྩེ་བ་དག་གི་རང་གནས་ཁྱོད་ཀྱི་གྲགས་པ་འདི་ཡིས།",
    "རྒྱས་པའི་མེ་ཏོག་ཚོགས་ནི་བསགས་པ་དག་གི་བཞིན་ནོ།",
    "མཁའ་ཡི་རླབས་ལྡན་དག་གི་གཡོ་བའི་རླབས་ཀྱི་འོད་ནི།",
    "འོད་ཟེར་ཚོགས་ལ་རྣམ་པར་རེག་པར་གྱུར་བ་བཞིན་དུ།",
    "ཁྱོད་ཀྱི་རལ་གྲི་སྐབས་གཞན་དག་ཏུ་རྣམ་རོལ།",
    "ཕྱི་དང་ནང་གི་གཞུང་ལུགས་རྒྱ་མཚོའི་ཕ་རོལ་དུ་སོན་པ།",
    "མགོན་པོ་རང་གི་གཟུགས་ཀྱི་བདག་པོ་ཁྱོད་ཀྱི་གཟུགས་ནི།",
    "མགོན་པོ་ཀྭ་ཡེ་གལ་ཏེ་ཁྱོད་ཀྱི་མཛེས་པ་བདུད་རྩིའི།",
    "མཆོག་སྦྱིན་སྲིད་ལས་འདས་པར་བདག་གི་ཡན་ལག་རྣམས་ནི།",
    "བསྟེན་པར་འབྱུང་མོད་ཁྱོད་ཀྱི་གསུང་གི་བདུད་རྩིའི་བཏུང་བའི།",
    "མཐུ་སྟོབས་མཉམ་པ་མེད་པ་གང་ཞིག་ཁྱོད་ལ་བསྟེན་ཡང་།",
    "མི་འབྱུང་འགྱུར་བའི་རབ་མཆོག་གཅིག་པོ་འདི་ནི་ཁྱོད་ལ་སློང་ངོ།",
    "ལུས་འཛིན་རྣམས་ཀྱི་མིག་གི་དགའ་སྟོན་སྒྲུབ་ལ་ཟླ་བ།",
    "ངག་གི་རྒྱལ་པོ་ཁྱོད་ཀྱི་ཞབས་ལ་བརྟེན་པའི་བློ་ཡིས།",
    "ཁྱོད་ཀྱི་ཞབས་དག་ཡོངས་སུ་བསྟེན་པར་འོས་པ་རྣམས་ཀྱི་ཡིད།",
    "རབ་ཏུ་རྒྱས་པའི་ཡོན་ཏན་དག་གིས་ཆེ་བའི་བློ་གྲོས་དག་ཕུན་ཚོགས་རང་བཞིན་བདེ་བ་ཅི་ཡང་འགྲོ་བར་སྐྱེད་པར་བྱེད།",
    "དག་པར་བྱས་པའི་གསེར་ལྡན་མཛེས་པའི་སྐུ་ཅན་མཆོག་ཏུ་སྒེག་གསལ་བའི་གསུང་གི་ངང་མོ་རྣམས་ཀྱིས་བསྟེན་བྱ་རྒྱལ་བ་ཡི།",
    "འཇམ་པའི་དབྱངས་ཞེས་གྲགས་པས་འདིར་ནི་ཁྱོད་ལ་བསྲུང་གྱུར་ཅིག་མགོན་པོ་བཟོད་པར་དཀའ་བའི་ཉོན་མོངས་འདི་གསུམ་རྣམས་ལ་ནི།"
  ]
}