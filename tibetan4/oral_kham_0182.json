    "ད་ལྟ་སྡུག་གོ་སྙམ་པ་འདུག་སྟེ།",
    "ཁ་དོག་དང་དབྱིབས་ཀྱི་ངོ་བོ་ཅིར་ཡང་མ་གྲུབ་འདུག་པས་སྡུག་རྒྱུ་ཅི་ཡང་མི་འདུག་པ་ལ་ད་ལྟ་སྡུག་གོ་སྙམ་པ་ནི།",
    "རྨི་ལམ་དུ་མེས་ཚིག་པ་དང་ཆུས་ཁྱེར་བའི་དུ་ཁ་བྱུང་བ་བཞིན་དུ་འཁྲུལ་པའི་སྣང་བ་ལ་བདེན་པར་བཟུང་བས་ལན་པར་འདུག་ད་ནི་སེམས་ཀྱི་ངོ་བོ་སྐྱེ་མེད་དུ་ཤེས་པར་བྱས་ནས་གཤིས་སྐྱེ་མེད་ཀྱི་ངང་ལ་སེམས་མཉམ་པར་བཞག་པར་བྱའོ།",
    "འདུག་པས་གོང་སྨོས་ཡིག་རྙིང་དེ་གལ་ཧ་ཅང་ཆེན་པོར་མཐོང་།",
    "ཏུན་ཧོང་ཡིག་རྙིང་དུ་བོད་ཀྱི་རྒྱལ་པོའི་གྲས་སུ་བཙན་པོ་ཨ་ཙཱ་ར་ཞེས་པ་ཞིག་བགྲངས་འདུག་པ་ཡང་རྒྱལ་པོ་འདི་ཡིན་པར་སེམས།",
    "གྲྭ་བཙུན་ཞིག་ཡོད་ཚུལ་བརྗོད་འདུག་འདིར་བརྗོད་པའི་གྲྭ་བཙུན་དེ་ནི་སྐྲ་བྲེག་མེད་ལ།",
    "པཎྜི་ཏ་མནྡྲ་ཀ་ལ་ཤ་བཅས་ཀྱི་མཛད་རྗེས་ལ་བསྟོད་པ་མཛད་པའི་སྐོར་འཁོད་འདུག་ལ།",
    "དེའི་ཐད་ཁོང་རང་ཉིད་ནས་ཀྱང་མུ་མཐུད་འཐབ་རྩོད་གནང་ཚུལ་མཚོན་ནོ།",
    "དཀར་ཆག་དེ་ནི་ཆུ་ཆེན་པར་མའི་པོ་ཏི་ཨ་ཡི་ནང་དུའང་བཀོད་འདུག་ནའང་།",
    "བསྡོམས་རྒྱལ་པོ་ཉི་ཤུ་རྩ་བཞི་བྱུང་མྱོང་འདུག་གོ་ལྡེབ་། ཁྲོ་ཆེན་རྒྱལ་པོའི་བཀའ་རྒྱུར་དཔྱད་པ།",
    "གཅུང་པོ་དེ་ནི་སྤྱིར་འདིར་འཁོད་པའི་ནང་དོན་ལས་རྒྱལ་པོའི་ཨ་བཏང་རབ་བྱུང་བ་ཞིག་ཡིན་སྲོལ་འདུག་དེ་བཞིན་སྐུ་བླ་བཅས་ལ་རྒྱལ་པོ་ལྟར་བཀའ་ཤོག་བཏང་ཆོག་པའི་ཁུ་དང་།",
    "བྲག་རྡོ་དེའི་ངོས་སུ་འབུར་དུ་དོད་པའི་གཟུགས་རིས་ཤིག་བརྐོས་འདུག་པ་དེ་ནི་ཐུབ་པ་གངས་ཆེན་མཚོ་རྒྱལ་ཡིན་པར་གྲགས།",
    "དེ་བཞིན་བྲག་ངོས་དེའི་ཐོག་ཡར་ལངས་ནས་བཞུགས་པའི་སྐུ་བརྙན་ཡང་བཞེངས་འདུག་ཏེ།",
    "བེ་རོ་ཙ་ན་ནི་སད་མི་བདུན་གྱི་གྲས་ཤིག་ཡིན་ལ་ཁོང་ནི་རྫོགས་ཆེན་གྱི་གཞུང་ཉིད་རྒྱ་གར་གྱི་ཡུལ་ནས་བོད་དུ་ངོ་སྤྲོད་མཛད་མཁན་གྱི་གྲས་ཤིག་ཀྱང་ཡིན་པར་གྲགས།",
    "དེ་བཞིན་རྫོགས་ཆེན་གྱི་བསྟན་བཅོས་གཙོ་གྲས་ཤིག་ཡིན་པར་འདོད་པའི་རིག་པའི་ཁུ་བྱུག་ནི་བི་རོ་ཙ་ནས་ཕབ་སྒྱུར་མཛད་པར་གྲགས་ལ།",
    "བསྡུ་བསྒྲིགས་མཛད་འདུག་པར་སྐབས་འདི་དང་བསྟུན་ནས་ཐུགས་རྗེ་ཆེ་ཞེས་ཞུ་རྒྱུ་ཡིན།",
    "རྣལ་འབྱོར་མ་དེ་འཚོ་བཞུགས་གནང་བའི་དུས་ནི་སྤྱི་ལོ་ནས་བར་ཡིན་འདུག་ལ།",
    "བི་རོ་འདྲ་འབག་ནང་དུ་བེ་རོ་ཙ་ནས་རྒྱ་གར་དུ་དཔལ་གྱི་སེང་གེ་མཇལ་བའི་སྒྲུང་དེ་ཨོ་རྒྱན་གླིང་པས་པདྨ་བཀའ་ཐང་ནང་དུ་ཡང་འདྲེན་མཛད་འདུག་ནའང་།",
    "གྲགས་ཅན་ལོ་ཙཱ་བ་བོ་རོ་ཙ་ན་ནི་དུས་རབས་བརྒྱད་པའི་སྐབས་སུ་ཐོག་མར་གསང་སྔགས་ཀྱི་གཞུང་ལ་ཉམས་ལེན་མཛད་མཁན་གྱི་བཙུན་པ་ཞིག་ཏུ་ངོས་འཛིན་བྱ་བ་ཡིན་ལ།",
    "བི་རོ་ཙ་ནའི་རྗེས་ཀྱི་དུས་རབས་ནང་བོད་དུ་ལོ་ཙཱ་བ་མང་པོ་ཞིག་བྱོན་ཞིང་།",
    "འདྲ་པོ་འདུག་ཅེས་སྟབས་བདེས་གསུངས་ཡོད།",
    "ཏཱ་ར་ན་ཐས་ཨོ་རྒྱན་གྱི་ཨིནྡྲ་བྷཱུ་ཏི་ཡི་སྐོར་གྱི་གནས་ཚུལ་རོབ་ཙམ་ཞིག་ལྡེབ་བཀོད་གནང་ནས་ཨིནྡྲ་བྷུ་ཏི་སྐུ་ཐོག་གཉིས་པ་དེའི་སྐོར་ཞིབ་ཕྲ་མ་ཤེས་སོ་ཞེས་གསུངས་འདུག་ལྡེབ་ཏུ་ཆི་ལྟར་ན་ཨོ་རྒྱུན་གྱི་ཨིནྡྲ་བྷུ་ཏི་ནི་དུས་རབས་བདུན་པའི་སྐྱབས་ཀྱི་མི་སྣ་ཞིག་ཡིན།",
    "ཅིག་ཤོས་ནི་དུས་རབས་བརྒྱད་པའི་སྐབས་སུ་བྱུང་བའི་བོད་ཀྱི་སད་མི་བདུན་གྱི་གྲས་བེ་རོ་ཙ་ནས་སྲོལ་གཏོད་དོ་ཞེས་པ་དེ་ཡིན།",
    "བོད་དུ་རྫོགས་ཆེན་གྱི་ཤིང་རྟའི་སྲོལ་འབྱེད་མཁན་ནི་བོ་རོ་ཙ་ན་ཡིན་པར་འདོད་པའི་སྲོལ་རྒྱུན་ཞིག་ཡོད།",
    "བོད་ཀྱི་བཙན་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱིས་བེ་རོ་ཙ་ན་རྒྱ་གར་གྱི་ཡུལ་དུ་མངགས་པ་དང་།",
    "པདྨ་འབྱུང་གནས་དང་བེ་རོ་ཙ་ན་གཉིས་ཀས་རྫོགས་ཆེན་གྱི་གཞུང་དེ་བོད་དུ་ཁྱབ་སྤེལ་གནང་ཐུབ་མེད་པ་དེ་ཡིན།",
    "གཏེར་མ་ཕོན་ཆེ་ཞིག་དུས་རབས་བཅུ་པ་ནས་འགོ་བཙུགས་ཏེ་གཅིག་རྗེས་གཉིས་མཐུད་དུ་ཐོན་ཡོད་པ་མ་ཟད།",
    "སྐྲུན་པ་དང་འཇིག་པ་སོགས་ཀྱི་གཉིས་འཛིན་གྱི་རྣམ་བཞག་ཡོད་ཚུལ་ནི་གཅིག་མཚུངས་ཡིན་འདུག་ལ།",
    "འབྲས་སྤུངས་བློ་གསལ་གླིང་དུ་ཤུགས་ལྡན་ལ་དམིགས་བསལ་གྱིས་དད་པ་བྱེད་མཁན་མང་པོ་འདུག་ཀྱང་།",
    "དེ་བྱིངས་ཀྱི་ཆོ་གའི་སྐོར་ཞིབ་འཇུག་བྱ་མཁན་བྱུང་མི་འདུག་འོན་ཀྱང་།",
    "རྒྱ་གར་གྱི་གཏམ་རྒྱུད་ནང་དུག་སེལ་གྱི་ནུས་པ་ལྡན་པའི་རྨ་བྱའི་སྒྲོའི་སྐོར་གླེང་ཚུལ་དེ་གཉིས་ཀྱང་འདྲ་མཚུངས་སུ་འདུག་ལ།",
    "མི་དང་ལྷ་རུ་ལྡེབ་ཙ་ན།",
    "ཟེར་ལོ་འདུག་ལོ་མ་ཟེར་ཅིག་བྱ་བ་སྤྱན་ལམ་གང་བྱེད་ཀྱང་།",
    "རང་རང་ཕྱག་ཏུ་འབུལ་གྱིས་བཞེས།",
    "རྫོགས་པ་ཆེན་པོའི་གཞུང་ནི་བེ་རོ་ཙ་ནས་དུས་རབས་བརྒྱད་པའི་སྐབས་སུ་རྒྱ་གར་ནས་གདན་དྲངས་པར་གྲགས།",
    "ཤྲཱི་སིཙནི་བི་རོ་ཙ་ནས་རྒྱ་གར་གྱི་ཡུལ་དུ་མཇལ་བའི་སློབ་དཔོན་གྱི་གྲས་ཤིག་ཡིན་ལ།",
    "རྫོགས་ཆེན་ཞེས་པའི་ཚིག་དེའི་འོག་བི་རོ་ཙ་ནས་བསྒྱུར་བར་གྲགས་པའི་བཀའ་རྣམས་ཚུད་པ་མ་ཟད།",
    "དེ་ལྟ་བུའི་རྩོད་རྙོག་ཅིག་དུས་རབས་འགའ་ཞིག་ནང་དུ་འཁྲུན་ཐག་མ་ཆོད་པར་ལུས་ཡོད།",
    "བོད་དུ་དར་བའི་བསམ་གཏན་གྱི་ལྟ་བ་ནི་རང་ཚུགས་ཅན་གྱི་གཞུང་ལུགས་ཤིག་ཏུ་ངོས་འཛིན་གྱིས་ཉམས་ལེན་བྱས་ཚུལ་ནི་བསམ་གཏན་མིག་སྒྲོན་ཞེས་པའི་དཔེ་རྙིང་ནང་དུ་གསལ་པོ་འཁོད་འདུག་གོ།",
    "སྟོན་གྱིས་རྗེས་འཇུག་མཆོད་འབུལ་གྱི་མཛད་སྒོ་གནང་དགོས་སོགས་ཀྱི་གནས་ཚུལ་འཁོད་འདུག་མེ་སྟོན་གྱིས་ཀློང་རྒྱས་དཀྱིལ་འཁོར་ནང་འཁོད་པ་ལྟར་མེ་ཉག་སྟག་ལ་མེ་འབར་བྱ་བ།",
    "ང་ཡི་ཀུན་ཀ་སྐྱོན་དུ་འདུག་ནས།",
    "ད་རུང་སེམས་ཀྱིས་བཟོད་པ་ཐང་མ་ཆོད་པར་འདུག་ཡི་ཆད་འཁྱམས་པས་ཚོགས་ཀྱིས་ང་དང་འཕྲད།",
    "རྒྱ་བོད་གཉིས་ཀྱི་ཡིག་ཐོག་ཏུ་འཁོད་པའི་སྒྲུང་དེ་ཏུན་ཧོང་བྲག་ཕུག་ནས་རྙེད་པའི་ཡིག་རྙིང་ཐོག་འཁོད་འདུག་བྲག་ཕུག་དེ་ནི་སྤྱི་ལོ་ལོར་སྒོ་རྒྱ་བཏབ་པ་དང་ཉེ་བའི་དུས་རབས་ཉི་ཤུ་བའི་ནང་གཞི་ནས་སྒོ་ཕྱེ་བའི་གོ་སྐབས་བྱུང་ཡོད།",
