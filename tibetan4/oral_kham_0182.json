    "འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པའི་གནས་ཐམས་ཅད་དུ་ཁྱབ་པར་འདུག་ཀྱང་ཅི་ལའང་མི་གནས་པར་ཤེས་པར་བྱའོ།",
    "སྒྲ་རྣམས་ཀུན་ལ་ཞུགས་ཀྱང་རང་བཞིན་ཞུགས་པ་མེད།",
    "སྟན་ལ་འདུག་པ་ནི་གང་།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "ཅེས་བཀའ་བསྒོས་ཤིང་དྲག་སྔགས་དང་བཅས་གུ་གུལ་འདུག།",
    "ཨོ་བེ་རོ་ཙ་ན་ཨ་པ་རི་མི་ཏ་ཨཱ་ཡུཛྙཱ་ན་སིདྡྷི་ཕ་ལ་ཧཱུྃ།",
    "དེ་བཞིན་དུ་ཨོཾ་བེ་རོ་ཙ་ནའི་མལ་དུ།",
    "སྟོང་པའི་ངང་ལས་ཁྱེད་རང་རྣམས་གང་དུ་གནས་པའི་གོ་སར་པཾ་ཡས་པདྨའི་སྡོང་པོ་རབ་ཏུ་རྒྱས་པའི་ལྟེ་བར་ཨ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་ཉ་གང་བའི་སྟེང་དུ།",
    "ཨོ་བེ་རོ་ཙ་ན་ཨ་པ་རི་མི་ཏ་ཨ་བྷི་ཥིཉྩ་ཨོཾ།",
    "གཡོན་ལྕགས་ཀྱུ་ཞགས་པ་ལྕགས་སྒྲོལ་དྲིལ་བུ་ཐོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས་ཏེ་ཁྱེད་རང་རྣམས་ཀྱི་ཚེ་ཡར་བ་དང་། ། འཁྱམས་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ལྷའི་སྐུར་གསལ་བ་སྟོད་སྨད་ནས་རིམ་གྱིས་འོད་དུ་ཞུ་བ་ཐུགས་ཀའི་ལྷར་ཐིམ།",
    "ཁྱེད་རང་རྣམས་པདྨ་ཚེ་དཔག་མེད་ལུས་འབུམདཀྱིལ་གྱི་ལྷ་དང་བཅས་པ་གསལ་བཞིན་པའི་གནས་གསུམ་ཡིག་འབྲུ་གསུམ་གྱིས་མཚན་པ་དང་།",
    "རང་ཉིད་ཁྲུས་བྱས་ཏེ་ཆས་གོས་དཀར་པོ་གྱོན་ནས་པདྨའི་འདུག་སྟངས་ཀྱིས་ཁ་ཤར་དུ་ཕྱོགས་པར་འཁོད།",
    "རང་ཉིད་ཁ་བྱང་དུ་ཕྱོགས་པས་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་འདུག།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "ཡིན་ན་མ་འདུག་ཕྱིར་དེངས་ཤིག།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལའང་དཀྱིལ་འཁོར་དུ་འཇུག་པ་དང་།",
    "མ་འདུག་གཏོར་མ་འདི་ཁྱེར་གཞན་དུ་དེངས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ་ཐོག་མར་མཎྜལ་ཕུལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཐིམ་པས་རྒྱལ་བ་ཚེ་དཔག་ཏུ་མེད་པའི་སྐུ་གསུང་ཐུགས་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་རོ་གཅིག་ཏུ་གྱུར།",
    "ཐུགས་ཀ་ནས་འཕྲོས་པའི་འོད་ཟེར་གྱིས་སྣོད་བཅུད་ཐམས་ཅད་འོད་དུ་ཞུ་ནས་རང་རང་ལ་ཐིམ།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "ཨོཾ་བཛྲ་ཨཀྟ་ཤྩ་མ་ཎི་པདྨེ་ཧཱུཾ་ཧཱིཨོ་བེ་རོ་ཙ་ན་མ་ཎི་པདྨེ་ཧཱུྃ་ཧཱུྃ",
    "དེའང་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་གྱི་ཁང་པའི་ཕྱི་རོལ་ནས་འཇུག་པ་ཡིན་ཀྱང་།",
    "དེ་ལྟར་གསོལ་བ་བཏབ་པ་ལ་དཀྱིལ་འཁོར་མཁྱེན་ཆེན་པོ་འདིར་སྐལ་མེད་རྣམས་བལྟ་བར་མི་རུང་བས་རིགས་དང་སྐལ་བ་འདྲི་བ་འདི་ལ་གསན་པས་ཁྱབ་བར་གདའ།",
    "ཡིན་ན་མ་འདུག་ཕྱིར་དེངས་ཤིག།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་གྱི་སྒོ་དྲུང་ན་གནས་པས་ཕྱོགས་ཀྱི་སྒོ་སྲུང་རྣམས་ལ་དཀྱིལ་འཁོར་དུ་འཇུག་པར་གསོལ་བ་གདབེ་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་མི་བསྐྱོད་ཐུགས་རྗེ་ཆེན་པོ་དང་།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "བཀའ་ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "སློབ་དཔོན་གྱི་བྱ་བ་གྲུབ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ཐོག་མར་མཎྜལ་ཕུལ།",
    "སློབ་དཔོན་གྱི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག།",
    "ཁྱེད་རང་བདུན་རྣམས་ཀྱི་སེམས་ཉིད་ཧྲཱི་ཡིག་དཀར་པོ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བར་ཐིམ་པས་སྐུའི་བྱིན་མཁྱེན་བརྩེའི་རླབས་ཞུགས།",
    "བདེ་བའི་སྟན་ལ་བསམ་གཏན་གྱི་འདུག་སྟངས་ཀྱིས་འདུག་སྟེ།",
    "སྐུ་ལུས་ཀྱི་འདུག་སྟངས་དྲང་པོར་གནས་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱང་དེ་ལྟ་བུའི་ཐུན་མཚམས་ཀྱི་ལྷག་པའི་ལྷ་གང་ཡང་རུང་བའི་ང་རྒྱལ་དང་ལྡན་པའི་༡༨སྒོ་ནས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ཐོག་མར་རྗེས་སུ་གནང་བ་ཞུ་བའི་ཡོན་དུ་དམིགས་ཏེ་མཎྜལ་ཞིག་འབུལ་བར་ཞུ།",
    "ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཀྱིས་མཚོན་པའི་མ་དག་པའི་སྣང་བ་ཐམས་ཅད་མི་དམིགས་པ་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "སྟོང་པའི་ངང་ལས་པཾ་ལས་པདྨ་དཀར་པོ་འདབ་མ་བརྒྱད་པའི་ལྟེ་བར་ཨ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཁྱེད་རང་བཅུ་གསུམ་རྣམས་ཀྱི་སེམས་ཉིད་རྣམ་པར་མི་རྟོག་པའི་ངོ་བོ་ཡི་གེ་ཧཱུྃ་དཀར་པོ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་བ་སྤུའི་བུ་ག་ཐམས་ཅད་ནས་ཐོགས་མེད་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་དང་མདུན་རྒྱབ་གཉིས།",
    "མ་ཧཱ་བ་སུ་ཏ་ཁཱ་མ་ཧཱ་ཀོ་རོ་ཙ་ན་ཁཱ་ཧི།",
    "ད་ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལའང་འཇུག་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་པོ་ཁམས་དང་སྐྱེད་མཆེད་ཀྱིས་མཚོན་པའི་མ་དག་པའི་སྣང་བ་ཐམས་ཅད་མི་མཁྱེན་བརྩེའི་དམིགས་ཏེ་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་དཔལ་རྟ་མགྲིན་དུ་གསལ་བའི་གསང་གནས་ཧཱུྃ་ལས་རྡོ་རྗེ་ཧཱུྃ་གྱིས་མཚན་པ།",
