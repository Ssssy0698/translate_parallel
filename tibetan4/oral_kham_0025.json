    "ལ་སྟེང་ཕ་བུ་རྒྱུན་གཏན་ནས་རྫུན་དང་ཕྲ་མའི་ཐོག་ངན་ལང་ཤོར་བ་ཡིན་ཚུལ་ཞུ་ཤོག་འདུ་ཐམ་འབྱར་མ་ཕུལ་འདུག་པ་ཀོང་སྤྱིས་བཀའ་ཤག་ཏུ་སྙན་སེང་གནང་དོན།",
    "ལྷ་དགའ་ཨ་ཅེ་ངོ་གནོང་མ་བཟོད་པར་རྩེ་སྒང་བརྒྱུད་ལྷ་སར་བྲོས་བྱོལ་ཕྱིན་འདུག་པ་དང་།",
    "ཤུ་པ་ཁྲལ་འཛིན་ཁྱི་སྐྱག་གཉིས་ནས་ངན་སྐུལ་གྱིས་ཐད་ཀར་བཀའ་ཤག་ཏུ་སྙན་འབུལ་ཞུས་འདུག་འོན་ཀྱང་བཀའ་ཤག་ནས་རྐང་ཧྲེང་པའི་ཞུ་གསལ་ཁྲལ་ཆག་སྩལ་འོས་མ་ཆེ་ཞིང་།",
    "དངོས་ཟོག་སོགས་མར་ཚབ་ཏུ་སྤྲོད་ལེན་བྱས་འདུག་རུང་།",
    "ཀྲུང་དབྱང་མི་སྣ་གསོད་མི་ལག་དམར་གཞུང་རྒྱུག་འུ་པ་བུ་སྤུན་ཡིན་འདུག་པས་ཐད་ཀར་ཉེས་འཛུགས་བྱེད་སྟབས་མ་བདེ་བས།",
    "སེར་ཞིབ་ཆབས་ཅིག་གུས་པས་ཞུ་རྒྱུའི་སྲིད་ཐམ་འགོ་མཆན་སྩལ་འདུག་ཀྱང་།",
    "ཁམས་པ་མི་གཉིས་རྨ་རྨས་ཙམ་མེད་པར་མེ་མདེལ་རྫོགས་ཏེ་རི་རྒྱུད་དུ་བྲོས་ཐར་ཐུབ་འདུག་གླིང་ཚང་པའི་ཁལ་མ་འབྲི་གཡག་༢ སྐོར་རྒྱ་དམར་ནས་འཕྲོག་བཅོམ་གྱིས་བསད་བཟོས་དང་།",
    "བཟའ་བཅའ་སོགས་ཀྱི་སྣེ་ལེན་འདུག་པར་བྱང་བཀྲས་ལགས་དང་།",
    "གུས་རང་རང་འཚོ་འཕེར་བའི་དམིགས་སྒོ་རྩ་བ་ནས་མེད་པས་ལྷོ་སྤྱི་དང་ལྷན་དུ་ཀ་སྦུག་ཏུ་བསྐྱོད་པའི་ལམ་གྲོན་དང་།",
    "ཀླུ་འབུམ་སྒྲིག་གྲྭ་ཁ་ཤས་ལ་སྤྲད་སོན་མི་འདུག་པ་སྐབས་དེར་འགྱེད་སྐལ་མ་བྱུང་བའི་དོ་བདག་དེང་སང་དྷ་སར་ཡོད་མུས་མ་ཟད།",
    "དམག་རྩེད་འགྲན་བསྡུར་བྱེད་ཀྱི་འདུག་དེ་ཉིན་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་སྐུ་འཁོར་དང་བཀའ་ཤག་ལྷན་རྒྱས་གཞུང་འབྲེལ་སྤྱན་ཞིབ་ཏུ་ཆིབས་སྒྱུར་གནང་སྲོལ།",
    "རྭ་སྒྲེང་རྒྱལ་ཐོག་རིང་དམག་མིའི་མེ་མདའ་ཚ་ཁ་བལྟ་རྒྱུ་སོགས་འར་འུར་གྱི་རིགས་ཀྱང་རྒྱུན་ཆད་འདུག་ལ།",
    "ཟེར་བ་སོགས་ཀྱི་གཞས་ཚིག་དར་ཁྱབ་བྱུང་འདུག།",
    "བཅིངས་འགྲོལ་གཏོང་དགོས་མི་འདུག།",
    "ཆིབས་སྒྱུར་མ་གནང་ཚེ་མི་འཐད་པའི་གནས་ཚུལ་ལྟ་བུས་ཆབ་སྲིད་ཀྱི་མཛད་གཙོ་རྣམ་པར་ཅུང་སྐུ་ངལ་བྱུང་ཡོད་བཟོ་འདུག་རྩ་བའི་ཆ་ནས་བོད་ལྗོངས་སེར་སྐྱ་ཡོངས་རྫོགས་བློས་འགན་མ་བཟོད་པར་ཡིད་བློང་བློང་པོར་གནས་ཡོད་ཀྱང་།",
    "ང་རང་ཕར་སླེབས་རྗེས་སྙུན་གཞི་སྡུག་ཏུ་ཕྱིན་པ་ལ་སོགས་པའི་དཀའ་ངལ་བྱུང་བ་ཡིན་ན་གནས་ཚུལ་ཕུལ་ཆོག་པ་དེ་དུས་ངེས་ཕེབས་ཡོང་བ་ཞུས།",
    "རྡེའུ་ཁ་ཤས་ཤིག་སྤོས་ནས་ཡང་བསྐྱར་ཐུགས་བསམ་བཞེས་ཏེ་བཞུགས་ཀྱི་འདུག་པ་བཞེངས་རོགས་ཞུས་ཏེ་འཆམ་འཆམ་ལ་གདན་འདྲེན་ཞུས།",
    "བྱེད་ཐབས་མི་འདུག་སྔ་འཕྲོས་ཇོ་ལགས་ཀྱི་སྙུན་ཁམས་དང་བསྟུན་ཏེ་ཁྱེད་ནས་དབུགས་རིང་ཡང་ཡང་གཏོང་རྒྱུ་བཞག་ནས་ཕྲན་བུའི་བག་ཕེབས་ཙམ་གནང་རོགས་ཞེས་འབོད་སྐུལ་ཞུས།",
    "དགོངས་པ་འཁྲོལ་མི་འདུག་གསུངས་བྱུང་།",
    "དེ་ནས་སྐར་མ་ལྔ་ཙམ་རྗེས་ཁོང་གཉིས་སར་ཕྱིན་ཏེ་ད་ནང་སྔ་དྲོ་བཟོ་གྲྭར་ལས་མི་སླེབས་མི་འདུག་པ་གང་ཡིན་ནམ་ལབ་པར།",
    "ངོས་རང་ཁུམ་སྟོད་དུ་ཐོན་ཏེ་ལ་གཅིག་བརྒྱབ་པའི་གཏིང་དུ་ཆུ་ཞིག་འདུག་པ་དེར་ཚ་ཕོག་བརྒྱབ་སྟེ་སྡོད་སྐབས།",
    "བཙུན་མ་༢ ཙམ་འདུག་པ་དེར་མཇལ་ཁར་བཅར་བ་ཡིན།",
    "ལམ་སང་ཕྱིར་སློག་བྱ་དགོས་ཞེས་འཁོད་འདུག་མི་མང་ལའང་ཡི་གེ་དེ་འདྲ་ཞིག་སྤྲད་པ་ཡིན་ཟེར་བྱུང་།",
    "མི་མང་ལའང་འདི་ནས་ཕྱག་བྲིས་གནང་བར་བཀའ་ལན་ཐད་ཀར་ཕུལ་འདུག་ཅེས་ཞུས་པར་གང་ཡང་གསུངས་མ་བྱུང་།",
    "བཟའ་བཅའི་རིན་གོང་མ་འཕར་ན་སྐྱོན་མི་འདུག་ཞུས་པར།",
    "ངོས་ནས་དེང་སྐབས་བོད་ནས་ཐུགས་རྗེ་ཆེན་པོ་རང་བྱུང་ལྔ་ལྡན་གྱི་སྐུའི་ཚལ་བུ་འཁྲུལ་མེད་གདན་ཞུ་གནང་ཐུབ་འདུག་པ་གཟུངས་འབུལ་དང་འབྲེལ།",
    "ངོས་ནས་དམ་ཉམས་བྱུང་དུས་རལ་གྲིའི་དཔེ་ལྟར་དེ་རིང་བཀའ་རྩད་ཕེབས་པ་དཔེ་མི་སྲིད་པའི་ཡག་པོ་བྱུང་།",
    "ངོས་རང་ལས་ཁུར་འཕོས་ཏེ་ཡོང་སྐབས་མི་མང་ནས་བལ་དོན་ལ་ཕུལ་བའི་གནས་ཚུལ་བཞུགས་སྒར་ལ་མ་འབྱོར་བའི་ངེས་པ་མི་འདུག་པས།",
    "མ་བྱན་གསུམ་འདུག་པར་ལས་ཁུར་བླངས་ཏེ་ཕྲུ་གུ་ཚོར་བོད་ཡིག་སློབ་འགོ་བཙུགས།",
    "ལམ་སྤྱི་བྱམས་པ་ཕུན་ཚོགས་ལགས་འདུག་གམ་གསུངས་བྱུང་།",
    "དེ་ནས་ཉིན་གཅིག་ཕྲན་དང་བརྒྱ་དཔོན་ཟླ་བ་ལགས་གཉིས་མ་ན་ལིར་ལམ་སྤྱིའི་སར་བཅར་དགོས་ཡོད་པ་པཏ་ལི་ཀུལ་ལ་འགྲོ་མཁན་གྱི་སྤྱི་སྤྱོད་རླངས་འཁོར་གྱི་དུས་ཚོད་ཕྲན་བུ་ཟིན་མི་འདུག་པས།",
    "སྐུ་ངོས་གསུངས་པ་ལྟར་ཕྲན་ནས་དངོས་གནས་འཁྲུགས་འདུག་ཅེས་ཞུས་པར།",
    "སྐུ་ཞབས་ཁྱེད་རང་སེམས་ཁྲལ་རྩ་བ་ནས་གནང་མི་དགོས།",
    "མི་ཚོགས་དེ་རྣམས་ཀྱི་དཀྱིལ་ནས་དམིགས་བསལ་བཀའ་དེ་འདྲ་གནང་དུས་ང་རང་འཆི་ཁར་སླེབས་མེད་དམ་སྙམ་སྟེ་སེམས་ལ་དངངས་འཚབ་ཆེ་ཙམ་བྱུང་།",
    "གཞིས་ཆགས་ཁག་ལ་ཆིབས་སྒྱུར་གནང་སྐབས་དེ་འདྲ་ཞུ་མཁན་འདུག་ཀྱང་རྩ་བ་ནས་བཞེས་ཀྱི་མི་འདུག་ཅེས་བཀའ་ཕེབས་བྱུང་།",
    "ཁྱེད་རང་ལ་ཤག་སྐྱིད་པོ་ཞིག་རག་འདུག་ཅེས་བཀའ་གནང་བྱུང་།",
    "དེང་སྐབས་བློ་གླིང་གྲྭ་ཚང་ལ་བོད་ནས་གྲྭ་རྒྱུན་གསར་པ་མང་པོ་འབྱོར་ཏེ་འགྲོ་གྲོན་ཐད་སྐུ་ངལ་ཡོད་འདུག་པས་ཁྱེད་ནས་ཞལ་འདེབས་ཏོག་ཙམ་ཕུལ་ཐུབ་ན་ཡག་པོ་ཡོང་ངེས་ཞེས་ཕེབས་པ་ལྟར་སུད་སི་ནས་དངུལ་ཁང་བརྒྱུད་ཧིན་སྒོར་༡ ཐམ་པ་འབུལ་རྒྱུ་བྱུང་།",
    "ད་ཆ་འབོའི་ནང་རང་འཇགས་མ་བཞག་རོགས་གནང་།",
    "ཁོང་བགྲེས་རྒུད་ཆེ་བས་ངོ་མི་ཤེས་པ་ལྟ་བུ་ཆགས་འདུག་དེ་ནུབ་ཤག་ཏུ་ལྷོད་སྡོད་བྱས།",
    "དེ་མིན་ཞུ་དགོས་གང་ཡང་མི་འདུག་ཅེས་ཟེར་བྱུང་།",
    "རྫ་རོང་ཡབ་ཡུམ་གཉིས་རྒྱ་གར་ལ་གནས་མཇལ་ཕེབས་ཏེ་རྡོ་རྗེ་གདན་དུ་གླིང་བླའི་ཕྱག་སྐུ་བློ་བཟང་ལུང་རིགས་མཇལ་ཏེ་བཀའ་རྩད་གནང་བར་གནས་ལུགས་རྣམས་ཞུས་འདུག་ཕྱག་སྐུ་མཆོག་ནས་ཕྱག་བྲིས་ཕེབས་དོན།",
    "རྫ་རོང་ཡབ་ཡུམ་གཉིས་ནས་གསུངས་གསལ་ལྟར་བྱས་ན་ཁྱེད་རང་མ་འོངས་པར་དྷ་སར་སྡོད་རྩིས་ཡོད་ཚོད།",
    "དངོས་ཟོག་མང་པོ་ཡོད་ཚེ་སྟབས་བདེ་ཡོང་རྒྱུར་དིལླིར་བཞག་སྟེ་རྡོར་གདན་དུ་ཡོང་དགོས་ཞེས་བཀོད་འདུག་དེ་ནས་ཕྱི་ཟླ་༡༢ ཚེས་༢༢ ཉིན་ཛུ་རིག་ནས་ཐོན་སྐབས་རྒྱ་གར་ལ་བོད་མི་མང་པོ་འགྲོ་མི་ཡོད་པའི་ཁྲོད་ཕལ་ཆེ་བ་ངོས་རང་དང་རྣམ་ཀུན་འཆམ་པོ་ཡོད་པ་ཤ་སྟག་འདུག་པས་ལམ་བར་དཀའ་ངལ་མེད་པར་དིལླིར་བདེ་འབྱོར་བྱུང་།",
    "དེ་ནས་བོད་ཟླ་༢ ཚེས་༡༩ ནས་དབུ་བཙུགས་ཏེ་འཇིགས་བྱེད་ལས་རུང་བསྡུས་པ་ཞིག་སྔ་དགོང་ཐུན་གཉིས་བྱས་ཏེ་བོད་ཟླ་༤ ཚེས་༡༩ བར་ཟླ་བ་གཅིག་རིང་འཇམ་དཔལ་དབྱངས་ཀྱི་གཟུངས་སྔགས་ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷི་དྷིའབུམ་དྲུག་དང་།",
    "ལགས་མི་འདུག་སྐྱིད་ཐག་ཆོད་འདུག་ཞུས་པར།",
    "ཆིབས་ཞབས་སྐུ་འཁོར་ཕེབས་ཊོ་ཉི་ཤུ་སྐོར་ལྷན་ཕེབས་གནང་འདུག་གཙུག་ལག་ཁང་དུ་མཛད་སྒོ་གཟབ་རྒྱས་ཐོག་བཀའ་བློན་ཁྲི་པ་དང་།",
    "བོད་ནས་གསང་བྲོས་ཀྱིས་ཕེབས་དགོས་ཐུག་པར་བརྟེན་དམིགས་ཡུལ་གང་ཡང་མི་འདུག་ཁྱེད་ནས་ཞལ་འདེབས་ཕྲན་བུ་འབུལ་རོགས་ཞེས་འབོད་སྐུལ་གནང་བར་སུད་སྒོར་༡ ཐམ་པ་འབུལ་ལམ་ཞུ་ཐུབ་པ་བྱུང་།",
    "དེང་སྐབས་མིག་དང་ཡན་ལག་གནས་བབས་གང་ཅིར་ཕྲན་བུ་སྐྱོ་རུ་ཕྱིན་འདུག་ཅེས་ཞུས་པར།",
    "དེ་ལུགས་སེམས་ལ་ཞོག་ཅིག་ཅེས་ཕ་མའི་ངོས་ནས་ཞལ་མངགས་ཅི་དྲག་གནང་བ་རྣམས་ནམ་ཡང་བརྗེད་ཀྱི་མི་འདུག་དེ་ནས་རྗེ་དྲུང་ལགས་སྐུ་འཁོར་དང་།",
    "མཆོད་རྟེན་གྱི་བུམ་པའི་མཚམས་ཀྱི་དམིགས་སེང་ནས་མཆོད་མེ་ཞིག་མཇལ་གྱི་ཡོད་འདུག་པ་དེ་སྤྱན་ཡིན་ལུགས་དང་།",
    "འདྲ་ཆགས་པོ་ཞིག་འདུག་ཀྱང་།",
    "ཛ་བླ་བློ་བཟང་རིན་ཆེན་ལགས་ནས་ཛ་བླའི་ལས་རྒྱུན་རིང་རང་འཇགས་བཞུགས་རོགས་གསུངས་དོན་བཞུགས་དགོས་བྱུང་སྟབས།",
    "ཉིན་གཅིག་ཕྲན་གཟིམ་ཆུང་དུ་འགྲོ་སྐབས་ཁོ་གཉིས་ཀྱིས་དོགས་པ་བྱེད་ཀྱི་འདུག་པར།",
    "རྒྱ་དཔོན་འདི་ཚོ་བདེ་ཆེན་བར་མ་འཁྲིད་ན་ཉན་གྱི་མི་འདུག་པས།",
    "འདི་མན་ཆད་ལྷ་རྒྱ་རིའི་ཡིན་ཚོད་མི་འདུག་སོགས་ཐུགས་ཚད་ཐིག་པོས་གསུང་སྐབས།",
    "བཞད་རླངས་ཆབ་དཀོན་གཉེར་རྒྱ་དམར་བ་སྟོན་ཀ་ཕྲན་དང་མཉམ་དུ་བུ་ལོན་བསྡུ་རོགས་སུ་ཡོད་པ་འཇོན་ཐང་གང་ལེགས་འདུག་དེར་བརྟེན་དཀོན་གཉེར་ལགས་སུ་དངོས་རིགས་འཛིན་ཆས་ཇི་ཡོད་དང་།"
  ]
}