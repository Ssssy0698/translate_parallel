    "རྡོ་རྗེའི་རྩེ་མོས་སྔ་མ་བཞིན་དུ་བསངས་ལ།",
    "ཡང་ན་ཐམས་ཅད་དུ་རང་གི་ལྷག་པའི་ལྷ་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་བསམ་པར་བྱའོ།",
    "མི་དང་ཉལ་སོགས་པའི་ཞག་གི་མར་མེ་དང་།",
    "རང་གི་སྔགས་ཀྱིས་དགང་བླུགས་སྔ་མ་བཞིན་དུ་ཕུལ་ཏེ།",
    "རྫས་ཐམས་ཅད་ལས་རེ་རེ་ཞིང་སྦྱིན་སྲེག་ལན་གསུམ་དབུལ་བར་བྱའོ།",
    "ཞི་བ་ལ་ནི་རང་གི་སྔགས་ཀྱི་མཐར་ཆེ་གེ་མོ་ཤཱནྟིཾ་ཀུ་རུ་སྭཱ་ཧཱ།",
    "འདི་ལྟར་ཐམས་ཅད་དུ་ཡང་རང་གི་བསྐུལ་བའི་ཚིག་ཇི་ལྟ་བ་དང་།",
    "ཉི་ཤུ་རྩ་གཅིག་གི་བར་དུ་མར་གྱི་སྦྱིན་སྲེག་གིས་གཟི་བྱིན་བསྐྱེད་པར་བྱའོ།",
    "རིགས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "གྱེན་དུ་བཀྲོལ་ཏེ་རང་གི་སྔགས་ཐ་མ་ཡི་གེ་མུ་དང་བཅས་པར་བརྗོད་པར་བྱའོ།",
    "སྦྱིན་སྲེག་གི་ཡོ་བྱད་ལྷག་མ་རྣམས་ཕུལ་ལ་ཐ་མར་དགང་བླུགས་དང་འཐོར་འཐུང་ཇི་ལྟ་བ་བཞིན་དུ་ཕུལ་ཏེ།",
    "དེ་ལྟར་ཉིན་རེ་ཞིང་རྟག་ཏུ་ཐུན་གསུམ་མམ།",
    "སྦྱིན་སྲེག་གི་ཆོ་ག་སློབ་དཔོན་རབ་འབྱོར་བསྐྱངས་ཀྱིས་མཛད་པ་རྫོགས་སོ།",
    "ཀུན་དུ་བཟང་པོའི་སྦྱིན་སྲེག་གི་ཆོ་གའི་ཚུལ་གྱིས་བགེགས་ཐམས་ཅད་གཞོམ་པར་བྱ་བ་དང་།",
    "གུང་མོ་མྱུ་གུ་བཞིན་དུ་གཤིབ།",
    "མཐེའུ་ཆུང་དང་མཛུབ་མོ་བསྒྲེངས།",
    "དམ་ཚིག་མཆོག་གི་དམ་ཚིག་གོ།",
    "རྡོ་རྗེ་ཕྲ་མོའི་སྦྱོར་བ་ཡིས།",
    "དཀྱིལ་འཁོར་རྡོ་རྗེ་ཕྲ་མོ་དང་།",
    "དེར་ས་གཞིའི་དབུས་སུ་ཡི་གེ་ཧཾ་གིས་ཞི་བའི་སྦྱིན་སྲེག་བྱའོ།",
    "ཕྱོགས་བཞི་ནས་རྟ་བབས་ཀྱི་ཕྱི་རོལ་དུ་ཤིང་གི་དྲལ་སྒོས་བསྐོར་ཅིང་ཤིང་དྲལ་སྒོ་བཞིས་ཉེ་བར་མཛེས་པར་བྱས་པས་དཀྱིལ་འཁོར་གྱིས་གཞི་ལྷག་པར་མཛེས་པར་བྱས་པར་གྱུར་ཏེ།",
    "དེར་སའི་དབུས་སུ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གི་གནས་པས་འདུག་ལ།",
    "དེ་ཉིད་ཀྱི་ཕྱག་རྒྱས་དཀྱིལ་འཁོར་དེའི་སྟེང་དུ་ནམ་མཁའ་ལ་བསྒོམ་མོ།",
    "སེམས་དཔའ་ཆེན་པོ་བཅུ་དྲུག་གི།",
    "ཐིག་གི་མཁས་པས་ཅི་ནུས་ཀྱིས།",
    "དེ་ནས་ཐིག་གི་ཕྱག་རྒྱ་དང་སྔགས་ནི་འདི་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་ནང་གི་དཀྱིལ་འཁོར་ལ་ནི་ཆ་བརྒྱད་དུ་བརྟག་གོ།",
    "བདེན་བྲལ་གྱི་ནི་ཕྱོགས་སོང་ནི།",
    "འཁོར་ལོ་དེའི་ནང་དུ་རྡོ་རྗེའི་ཐིག་གིས་ཡོངས་སུ་བསྐོར་བར་བྱའོ།",
    "རྡོ་རྗེ་གོམ་པས་སོང་ནས་སུ།",
    "རྡོ་རྗེ་ལྷ་མོ་རྣམས་ཀྱང་གཞག།",
    "རི་མོའམ་རྡོ་རྗེ་སྲད་བུ་དག།",
    "མཛུབ་མོ་གཉིས་ནི་ལེགས་སྦྱར་བ།",
    "ཀུན་དུ་བཟང་པོའི་སྦྱིན་སྲེག་གི་སྐབས་སུ་འཇུག་པའི་ཆོ་ག་དམ་ཚིག་མཆོག་གི་ཕྱག་རྒྱ་ནས་བརྩམས་ཏེ།",
    "ལས་ཆེན་མཆོག་གི་ཕྱག་རྒྱ་ཡིས།",
    "དམ་ཚིག་མཆོག་གི་ཕྱག་རྒྱས་དང་།",
    "རྣམ་པར་རྒྱལ་བའི་བུམ་པ་ནི་རྡོ་རྗེ་བྱིན་གྱིས་བརླབ་པའི་མེ་ཏོག་གི་ཡལ་གས་བཟླས་བརྗོད་སྟོང་བྱས་ལ།",
    "རྟ་དང་གླང་པོ་དང་བ་ལང་གི་ཚོགས་ཤིན་ཏུ་བརྟགས་པ་རྣམས་ཀྱང་འབུལ་བར་བྱའོ།",
    "རྡོ་རྗེ་རྩེ་མོའི་རྒྱུད་ཀྱི་སྔགས་ཀྱིས་ཕྱི་རོལ་ཏུ་གཏོར་མ་བྱིན་ལ།",
    "ཉེ་རེག་བྱས་ལ་ནང་དུ་ཞུགས་ཏེ་ཆོ་ག་ལྷག་པ་དང་མ་ཚང་བ་རྣམས་ཉེ་བར་ཞི་བར་བྱ་བའི་ཕྱིར་ཞི་བའི་སྦྱིན་སྲེག་བྱས་ནས།",
    "གང་གི་ཚེ་རྡོ་རྗེ་སེམས་དཔའ་སྟོན་པ་ན།",
    "གང་གིས་རྡོ་རྗེ་ཆགས་པ་སྟོན་པ་ན་རྡོ་རྗེ་བསྲུང་བ་ཉེ་བར་བསྟན་པར་བྱའོ།",
    "ཕྱག་རྒྱ་རང་གི་གནས་སུ་བཀྲོལ་ལ་ཐལ་མོ་མཉམ་པས་མཉེས་པར་བྱའོ།",
    "གང་གི་ཚེ་རྡོ་རྗེ་སྨྲ་བ་སྟོན་པ་ན་རྡོ་རྗེ་རིན་ཆེན་ཉེ་བར་བསྟན་པར་བྱའོ།",
    "གང་གི་ཚེ་རྡོ་རྗེ་འཁོར་ལོ་སྟོན་པ་ན་རྡོ་རྗེ་གཟི་བརྗིད་ཉེ་བར་བསྟན་པར་བྱའོ།",
    "གང་གི་ཚེ་རྡོ་རྗེ་རྣོན་པོ་སྟོན་པ་ན་རྡོ་རྗེ་རྒྱལ་མཚན་ཉེ་བར་བསྟན་པར་བྱའོ།",
    "ཕྱག་རྒྱ་བཀྲོལ་ཞིང་རང་བཞིན་གྱི་གནས་སུ་ཐལ་མོ་ངེས་པར་བཅིངས་ཏེ།",
    "ཚེས་གཅིག་ནས་བརྩམས་ནས་ཟླ་བ་ཉའི་བར་རམ་བཅུ་གཉིས་ནས་བརྩམས་ནས་ཉའི་བར་རམ་ཕྱག་རྒྱ་གཅིག་པའི་དཀྱིལ་འཁོར་ནི་ཉིན་མཚན་གཅིག་གིས་བྱའོ།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "ཉིན་རེ་བཞིན་དུ་དུས་དྲུག་ཏུ།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "བདག་གིས་སྡོམ་པ་མ་ལུས་གཟུང་།",
    "མ་གྲོལ་བ་ནི་བདག་གིས་དགྲོལ།",
    "བགེགས་ནི་རང་གི་སེམས་ལས་བྱུང་།",
    "ཐབ་ཁུང་གི་ཕྱི་རོལ་དུ་ཤར་ནས་བྱང་དུ་བལྟ་བ་དང་།",
    "སུ་ཞིག་གིས་ནི་བརྟག་པར་ནུས།",
    "རང་གི་ལྷ་ཡི་སྦྱོར་བ་ཡིས།",
    "རྡོ་རྗེ་སེམས་དཔའ་ལྷག་པར་མོས་པས་ཡོན་གྱི་མཆོག་རྣམས་དབུལ་བར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དུ་ལྷག་པར་མོས་པས་ནི།",
    "བུ་མོ་ཤིན་ཏུ་བརྒྱན་པའམ།",
    "དེ་ནས་དར་དཔྱངས་མགོ་ལ་བཅིངས་ནས་རང་གི་རྡོ་རྗེ་ལག་པར་བཞག་ལ།",
    "མཉེས་པར་བྱ་བ་ལ་སོགས་པ་བྱས་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་གྱེན་དུ་བཀྲོལ་ལ།",
    "རང་གི་རྟོག་པའི་ཆོ་གས་བྲི་བར་བྱའོ།",
