    "དེ་འདྲའི་བརྩེ་བར་ང་རང་སྔོན་ཆད་འཕྲད་མྱོང་མེད།",
    "ང་ཕྱིར་ལོག་དུས།",
    "བརྡ་བྱང་དེའི་ངོས་སུ་ཁའེ་པོལ་ཉག་གས་ཁྱེད་ལ་དགའ་བསུ་ཞུ་ཞེས་བྲིས་འདུག་ངའི་ཁ་ནང་དུ་སྐྱུར་ཆུ་བརྡོལ།",
    "འགག་སྒོ་ཡིན་རུང་སེམས་ཁྲལ་བྱ་དགོས་མི་འདུག་ཨ་ཧྥུ་ཧན་གྱི་འབངས་དམག་གཉིས་ཚུར་ཡོང་སྟེ།",
    "ལན་ཏི་ཁ་ན་རུ་ཐད་ཀར་བསླེབས་འདུག་མཐར་ངེད་གཉིས་ཐོར་ཁམ་ནས་ཨ་ཧྥུ་ཧན་རྒྱལ་ཁོངས་སུ་འཛུལ།",
    "ལམ་འགྲམ་གཡས་གཡོན་གྱི་ཤུག་སྡོང་དག་ངའི་བག་ཆགས་ཁྲོད་ཀྱི་རྣམ་པ་དང་བསྡུར་ན་ཉུང་དུ་ཕྱིན་འདུག་འོན་ཀྱང་ཁའེ་པོལ་ཉག་ཆེན་གྱི་སུན་སྣང་ཡོང་བའི་འགྲུལ་བཞུད་དེའི་འཕྲོར་ཡང་བསྐྱར་སྔོ་ཁེབས་མཐོང་བྱུང་བས་ངའི་རིག་པ་ཡང་ཧར་གྱིས་སངས།",
    "གཅལ་དུ་རྩྭ་གདན་བཏིང་འདུག་ངེད་གཉིས་ཀྱིས་ལྷམ་ཕུད་ནས་དེའི་སྟེང་རྐང་པ་སྤོས།",
    "ཁོ་ཚོ་ཚང་མ་སྐེམ་རིད་རང་དུ་འདུག་ཁ་ལག་ལ་བཙོག་དྲེག་ཆགས།",
    "ཁོས་མིག་ཟུང་ངའི་དུས་ཚོད་འཁོར་ལོའི་སྒང་ལ་ཐོགས་འདུགལོ་ན་ཆེ་ཤོས་ཀྱི་བྱིས་པ་དེས།",
    "དོན་ལ་ངས་དེ་བརྗེད་མི་འདུག་མ་ཟད།",
    "ཁོའི་བུ་གསུམ་པོ་སྒོ་ཁར་ལངས་འདུག་ཐ་ཆུང་དེས་དུས་ཚོད་འཁོར་ལོ་དེ་གྱོན་འདུག་དུས་ཚོད་འཁོར་ལོ་ཆེ་དྲགས་ཏེ་ཁོའི་མཁྲིག་མའི་སྒང་ན་ཕར་གཡུག་ཚུར་གཡུག་བྱེད།",
    "ཁྱི་གུ་ཞིག་གྱང་རྩ་དེར་འཁུམས་ཏེ་ཉལ་འདུག་སྔོན་ཆད་འདི་ན་ང་ལ་གྲོགས་པོ་ཞིག་ཡོད།",
    "འཁུམས་ཏེ་གྱང་རྩར་ཉལ་ཡོད་པའི་ཁྱི་གུ་དེར་འགུལ་འཕག་ཙམ་མི་འདུག་དེ་ལྟར་ཤི་ཡོད་པ་མིན་འགྲོ།",
    "འོན་ཀྱང་ད་ཆ་ང་གནས་འདིར་འབྱོར་ཏེ་ཁོ་ཚོ་དང་དབྱིན་ཁྲུ་ལྔ་བཅུའི་བར་ཐག་ལས་མི་འདུག་སེམས་ནང་དུ་གློ་རྡེག་འཕྱུར་ཡོང་བ་ནི་སྦ་གསང་བྱ་ཐབས་མེད་པའི་འཇིགས་སྐྲག་འབའ་ཞིག་མིན་ཞེས་ངས་རང་ལ་གསལ་འདེབས་བྱས།",
    "སྒེའུ་ཁུང་ཤིང་ལེབ་ཀྱིས་བཅད་འདུག་ཕྱོགས་དེར་འགྲོ་བའི་ལམ་སྐབས་ཧྥ་ལི་ཏེས་ང་ལ།",
    "བྱིས་པ་ཚོས་བལྟས་འདུག་ཧྥ་ལི་ཏེ།",
    "བྱིས་པ་ཚོས་བལྟས་འདུག་ངས་དེ་ལྟར་བཤད།",
    "མིག་རའི་ཤེལ་ཀོར་གཞན་དེའང་ཧྲུག་ཧྲུག་བཟོས་འདུག་པ་མཐོང་བས།",
    "བྱིས་པ་ཚོ་སྐྲག་ཐག་ཆོད་འདུག་ཟེར།",
    "ཅི་ཞིག་བྱེད་ཀྱིན་འདུག་ངས་ག་ལ་ཤེས།",
    "ཧྥ་ལི་ཏེས་རླངས་འཁོར་ནང་ན་ཐ་མག་འཐེན་གྱིན་འདུག་ང་ལ་ད་རུང་བལྟ་དགོས་ས་ཞིག་ཡོད།",
    "ཁོ་ཚོ་ཚང་མས་དོར་མ་རིང་པོ་གྱོན་འདུག་འགྲན་སྡུར་མགོ་བརྩམས་བྱུང་།",
    "ཧྥ་ལི་ཏེས་ད་དུང་ཚར་མི་འདུག་ཟེར།",
    "ཁོས་མགོ་ལྕོག་ལྡེམ་ལྡེམ་སྐད་འཁྱེར་མཁན་དེའི་རྣ་འགྲམ་དུ་ཅི་ཞིག་ལབ་ཀྱིན་འདུག་ན་གཞོན་དེའི་སྐད་ཁྱེར་ཏེ་ཕྱིར་བརྒྱུགས་ཡོང་།",
    "ཐ་ན་དེ་ལས་ཀྱང་ཚབས་ཆེ་བར་འདུག་པ་ནི།",
    "ངས་གཞི་ནས་འགན་མ་འཁུར་བའི་བྱ་བ་ཞིག་རྩོམ་གྱིན་འདུག་དེ་ཡང་འབྱུང་ཉེན་ཆེས་ཆེ་བ་ནི།",
    "ཁོས་ཚི་ལེན་དཀར་པོའི་སྟེང་སྟོད་འགག་ནག་པོ་ཞིག་གྱོན་འདུག་མཁྲིག་མའི་སྒང་ན་གསེར་གྱི་ཆུ་ཚོད་འཁོར་ལོ་ཞིག་ངས་ཁོའི་ཕུ་ཐུང་གཡོན་པའི་ཁ་ན་ཁྲག་རྗེས་ཆུང་ཆུང་ཞིག་ཡོད་པ་མཐོང་།",
    "འདྲ་ཆགས་ཏེ་མི་ལ་འཕྲུལ་སྣང་སྐྱེ་རུ་འཇུག་པའི་ཚོད་དུ་གདའ།",
    "འོན་ཀྱང་མི་ནུས་པར་འདུག་ངས་མིག་འབྱེད་འཛུམ་བྱ་བསམས།",
    "ཁོས་སྔར་ལྟར་ལྕགས་ཀྱི་སྣ་རྩེ་ཅན་གྱི་འཇུར་རྟ་དེ་གྱོན་འདུག་ང་ཡིད་ལ་དྲན་ནམ་ཞེས་ངས་ཁོར་དྲིས།",
    "ང་བརྡ་ཆད་འདི་ལ་ཞེ་དྲག་དགའ་པོ་འདུག་དེའི་སྒྲ་འབྱིན་སྟངས་ཁོ་ནའང་ཅི་འདྲའི་ཁྱད་དུ་མཚར་བ་ལ།",
    "ངའི་ཚོར་སྣང་ཞིག་ལ་གནམ་ས་གཉིས་ཀ་འཁོར་གྱིན་འདུག་སའོ་ལ་བྷོ་ལ་ཁེན་ཏེ་ངེད་གཉིས་སྐས་ཐོག་ནས་མར་བབས།",
    "སྒེའུ་ཁུང་ཕྱི་རོལ་གྱི་སྡོང་བོའི་གཟུགས་རིས་རབ་རིབ་དག་རྒྱབ་ཕྱོགས་སུ་རྒྱུག་སའོ་ལ་བྷོ་ངུ་བཞིན་འདུག་ཧྥ་ལི་ཏེས་ཚིག་རྐང་གཅིག་ཁོ་ན་ཟློ།",
    "འོན་ཀྱང་གནས་འདི་ལས་དགའ་ཙམ་དུ་གདའ།",
    "དེའི་འཕྲོར་ངེད་གཉིས་ཀྱིས་འབྲི་ཏ་ས་འཛིན་རྔམ་ཟ་བྱེད་ཀྱིན་འདུག་ཧཱ་སན་གྱི་དོར་མའི་རྐུབ་ནས་ཁྲག་འཛག་བྱུང་།",
    "ང་ཕྱིར་མགྲོན་ཁང་དུ་ལོག་སའོ་ལ་བྷོ་མལ་ཁྲིའི་སྒང་ན་འཁུམས་ཏེ་ཉལ་འདུགགཉིད་ཡོད་མེད་མི་ཤེས།",
    "ཕྱིར་སད་དུས་ཁང་པའི་ནང་མུན་ནག་འཐིབས་འདུག་དྲ་ཡོལ་གྱི་སྲུབས་ཀར་ནམ་མཁའ་རྟ་རྔ་འདྲ་ཞིག་མངོན།",
    "སྨྱོས་ཟིན་འདུག་ཧོལ་རྒྱུག་མཁན་ཚོ།",
    "རྟའི་མགྲིན་པར་དྲིལ་ཆུང་མང་པོ་བཏགས་འདུག་གོམ་ཁ་བསྒྱུར་བ་དང་བསྡོངས་ནས་སིལ་སྒྲ་གྲག་ཡོང་།",
    "དཔེ་མི་སྲིད།",
    "ངས་བསམས་ན་ད་ནི་ཏག་ཏག་དུས་ཚོད་དེར་བསླེབས་འདུག་གཞི་དང་གནས་མལ་འདི་རུ།",
    "ལོགས་ཀྱི་རྐུབ་སྟེགས་གཞན་པ་དག་ཏུ་ཁྱིམ་ཚང་འགའ་ཞིག་བསྡད་འདུག་ཁོ་ཚོས་དེ་གར་ཞོག་ཁོག་བག་ལེབ་དང་ཚལ་སྲེག་བག་ལེབ་སོགས་བཟའ་བཞིན་ཚ་ཕོག་གཏོང་།",
    "ཡུལ་ལ་ལོག་དུས་ང་གཅིག་པུ་མིན།",
