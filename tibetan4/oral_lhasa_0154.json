    "དེ་ནས་བྱིན་གྱིས་བརླབ་པ་ཡང་ཚུལ་བཞིན་དུ་བྱས་ལ་གཏོར་མ་དེ་དག་ལ་དར་སྣ་ཚོགས་དང་གདུགས་དང་བཅས་པས་སྣང་གསལ་སྤང་སྟེ་རི་མཐོན་པོའམ་ནགས་ཚལ་སྟུག་པོར་བསྐྱལ་ལོ།",
    "དེ་ནས་བུམ་པ་དགུ་ལ་སོ་སོའི་མཚན་མ་བཏབ་ལ་གནས་སུ་གཞག་པར་བྱའོ།",
    "དེ་ལྟར་བྱས་པ་སོ་སོའི་གནས་སུ་མཚན་མ་བྲིས་ཏེ།",
    "ལག་པ་གཉིས་འཁོར་ལོ་ལྟར་བྱས་ལ།",
    "དེ་དག་ལ་ཛ་ཧཱུྃ་བཾ་ཧོ་ཡེ་ཤེས་སེམས་དཔའ་དགུག་པ་དང་གཞུག་པ་དང་བཅིང་བ་དང་གཉིས་སུ་མེད་པར་བསྟིམ་པར་བྱས་ལ།",
    "རྒྱུདཔུ་༩༢དཀར་གསུམ་མངར་གསུམ་གྱིས་གཟའ་རྣམས་མཉེས་པར་བྱའོ།",
    "གོས་གསར་པ་གྱོན་ལ་བསྐྱེད་པ་ལ་སོགས་པ་སྔོན་དུ་བྱས།",
    "གསེར་གྱི་གདན་ལ་བཞུགས་པ།",
    "དེ་ནས་གཏོར་མའི་ཆོ་ག་རྒྱས་པར་བྱའོ།",
    "ཚོགས་ཇི་ལྟར་རིགས་པར་བསག་གོ།",
    "གནས་ཁང་ཡིད་དང་མཐུན་པར་སེམས་བསྐྱེད་པ་དང་།",
    "ཚོགས་བསགས་པ་ཅི་རིགས་པར་བྱས་ལ།",
    "སའི་ཆོ་ག་དང་སྟ་གོན་ཇི་ལྟར་གསུངས་པ་བཞིན་དུ་བྱས་ལ།",
    "རྒྱུད་པུ་༧༤ལ་ས་ཆགས་ལ་སོགས་པ་ལེགས་པར་བྱས་ལ་ཐིག་བཏབ་ལ་ཆོ་ག་རྫོགས་པར་བྱ་སྟེ།",
    "བྱང་ཤར་དུ་མདུང་ཐུང་བྲིའོ་། སྒོ་རྣམས་སུ་སྒོ་མའི་མཚན་མ་ལེགས་པར་བྲིས་ལ་བུམ་པ་མཚན་ཉིད་དང་ལྡན་པ་དགུ་ལ་ལྷ་སོ་སོའི་མཚན་མ་བཏབ་ལ།",
    "དེ་ནས་ཚོགས་བསག་པའི་རྟེན་ནམ་མཁའ་ལ་སྤྲུལ་ལ་སེམས་བསྐྱེད་པ་ལ་སོགས་པའི་དགེ་སྦྱོར་གྱི་ཡན་ལག་རྣམས་བྱས་ལ།",
    "གཙོ་བོ་ལ་སོགས་པ་ལྷ་སོ་སོའི་བུམ་པར་སྤྱན་དྲངས་ལ།",
    "ཛ་ཧཱུྃ་བཾ་ཧོ་ཞེས་བུམ་པའི་ངོ་བོར་གཉིས་སུ་མེད་པར་དམིགས་ལ་གཙོ་བོའི་སྔགས་དང་ཕྱག་རྒྱ་སྔ་མ་རྣམས་དང་འདྲའོ།",
    "གཡོན་པ་མགོ་༤ ཐོད་པ་ཐོགས་པ་ལྟར་བྱས་ལ།",
    "ཡང་ལག་པ་གཡོན་པ་ཁའི་ཐད་ཀར་པདྨ་ལྟར་བྱས་ལ།",
    "སྐྲ་བརྫེས་ཤིང་མཆེ་བ་གཙིགས་པ་འཇིགས་པའི་ང་རོ་ཅན་བསྐྱེད་དོ་། ལག་པ་གཡོན་པ་འཁོར་ལོ་ལྟར་བྱས་ཏེ།",
    "གཡས་པ་དབྱུག་ཏོ་འཕྱར་བ་ལྟར་བྱས་ནས།",
    "ལག་པ་གཉིས་མདུང་གསོར་བ་ལྟར་བྱས་ལ།",
    "ས་སྟེགས་གྲུ་གསུམ་ལེགས་པར་བྱས་ལ་ཆོ་ག་བཞིན་དུ་ཐིག་ལེགས་པར་བཏབ་ལ།",
    "འཁོར་གྱི་ཀླུ་རྣམས་ནི་ལག་པ་རྣམས་སྦྲུལ་མགོ་གདེངས་པ་ལྟར་བྱས་ལ།",
    "དཔལ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ཁྲུས་ཀྱི་ཆོ་ག་བུམ་པ་སྒྲུབ་པར་འདོད་པའི་སྒྲུབ་པ་པོ་དམ་ཚིག་དང་ལྡན་པས་གནས་ཁང་ཡིད་དང་མཐུན་པར་ས་གཞི་རྣམས་ལེགས་པར་མཉམ་སྟེ།",
    "དེ་ཡང་ཚད་དང་ལྡན་པར་བྱ་སྟེ།",
    "ཆུ་རབ་ཏུ་གཙང་མ་སྲོག་ཆགས་མེད་པས་བཀང་སྟེ།",
    "ཙནྡན་དམར་པོ་ལ་སོགས་པའི་དྲི་ཞིམ་ཞིང་བཀྲ་ཤིས་པའི་རྫས་གང་ཡང་རུང་བས་ལྷ་རྣམས་ཀྱི་མཚན་མ་ལེགས་པར་བྲིས་ལ་རས་དམར་པོ་དྲི་མ་མེད་པས་མགུལ་པ་བཅིང་ངོ།",
    "མདུད་པ་བྱས་ལ་དེའི་སྟེང་དུ་བ་དམར་པོའི་ལྕི་བས་རྒྱས་བཏབ་སྟེ།",
    "རྩྭ་དྲུར་༦བ་ཉག་མ་བདུན་དང་རྨ་བྱ་བདུན་བཞུགས་སོ།",
    "དེ་ནས་སྒྲུབ་པ་པོ་བདག་ཉིད་ཀྱིས་གོས་གསར་པ་གྱོན་ཏེལག་པ་གཡོན་པའི་མཐིལ་དུ་ཆུ་གཙང་མ་བླུགས་ལ་དེ་ཉིད་ཨ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "ས་གཞིར་དམིགས་པར་བྱས་ལ་ཕུར་བུ་དང་ཐོ་བ་ཐོགས་པས་ཀྱང་མཚམས་གཅད་པར་བྱའོ།",
    "ཕྱོགས་རྣམས་ཀུན་དུ་གཏོར་བྱས་ན།",
    "པདྨའི་གདན་ལ་བཞུགས་པར་དམིགས་ལ།",
    "ལངས་ཏེ་རྐང་པ་གཡས་པ་བརྐྱང་བའི་ཚུལ་གྱིས་ལག་པ་གཡོན་པ་རྡོ་རྗེའི་ཕྱག་རྒྱ་བསྟན་ཏེགཡས་པ་རྡོ་རྗེའི་ཕྱག་རྒྱ་སྟ་ཟུར་དུ་གཞག་པར་བྱ།",
    "བདེན་བྲལ་གྱི་ཕྱོགས་སུ་བལྟས་ཏེ་རྐང་པ་མཉམ་པར་རྣམ་འཇོམས་ཀྱི་སྒྲུབ་ཐབས་བརྒྱ་རྩར་གྲགས་པ་༡༥བཞག་ལ།",
    "ཆུ་ལྷའི་ཕྱོགས་སུ་བལྟས་ཏེ་རྐང་པ་མཉམ་པར་བཞག་ལ།",
    "གཉིས་སུ་མེད་པར་བསྟིམ།",
    "ཕྱི་རོལ་གྱི་སྣང་བ་རྣམས་ཀྱང་སྔགས་ཀྱི་རང་སྒྲར་བྱུང་བས་གདུག་པའི་ཚོགས་རྣམས་ཚར་གཅད་པར་བྱས་པའོ།",
    "དེ་ལྟར་དམིགས་པ་གསུམ་དང་མི་འབྲལ་བར་བྱས་པས་བདག་དང་སྒྲའི་དངོས་པོ་ཐམས་ཅད་སྒྲའི་བསམ་གཏན་དང་མི་འབྲལ་བ་ནི་དོན་གྱི་མན་ངག་གོ།",
    "ཡུངས་ཀར་ལ་སྔགས་བཟླས་ཏེ་བུམ་པར་བླུགས་པས།",
    "མ་བརྒལ་བ་རྣམས་བརྒལ་བྱས་ཏེ།",
    "དབུ་རྒྱན་གོན་ལ་གཟེངས་བསྟོད་ལ་དཀྱིལ་འཁོར་གྱི་ཤར་སྒོ་ནས་སྤང་ལེབ་ཀྱི་སྟེང་ནས་ལམ་སྟོན་ལ་དབུས་སུ་ཁྲུས་བྱས་ཏེ།",
    "མྱ་ངན་དང་སེམས་ལས་སུ་མི་རུང་བའི་མི་བདེ་བ་རྣམ་པར་དག་པར་དམིགས་པ་བྱས་ལ།",
    "ཚིགས་སུ་བཅད་པ་འདི་དག་ཀྱང་བརྗོད་པར་བྱའོ།",
    "སྡུག་བསྔལ་ཐམས་ཅད་མེད་པར་བྱེད།",
    "བདེ་བ་ཕུན་སུམ་ཚོགས་པར་གནས།",
    "མ་གྲུབ་པ་རྣམས་གྲུབ་པར་བྱེད།",
    "རྒོལ་བ་རྣམས་ཚར་གཅོད་པར་འགྱུར་བ་དེ་བཞིན་དུ་བློན་པོ་དང་།",
    "གདོན་བརླག་པར་འདོད་པ་དང་།",
    "འཕགས་པ་རྣམ་པར་འཇོམས་པའི་སྒོ་ནས་རབ་ཏུ་གནས་པར་བྱེད་པར་འདོད་པའི་སྒྲུབ་པ་པོ་དམ་ཚིག་དང་ལྡན་པས།",
    "དེ་ནས་རབ་ཏུ་གནས་པར་བྱེད་པའི་རྟེན་སྐུའི་རྟེན་རས་རིས་སུ་བྲིས་པ་དང་།",
    "ཞི་བའི་སྐུ་ཉན་ཐོས་ཀྱི་ཆ་ལུགས་ཡིན་ནཡང་སོ་སོའི་ས་བོན་གཞུག་པ་ལ་སོགས་པ་བྱས་ལ།",
    "ཞལ་བཀྲུ་བ་ལ་སོགས་པ་བྱས།",
    "རབ་ཏུ་དགྱེས་ཤིང་བརྟན་པར་བྱའོ།",
    "གཉིས་སུ་མེད་པར་བསྟིམ་པར་བྱ།",
    "དེ་ཉིད་དང་གཉིས་སུ་མེད་པར་བྱས་ལ་རང་གཞན་གྱི་དོན་རྫོགས་པར་བྱའོ།",
    "ལས་ཀྱི་རིགས་ལ་ཧཱ་ཅི་རིགས་པར་༤བཟླས་སོ།",
    "གྲུབ་ན་ཞི་བའི་སྦྱིན་སྲེག་ཅི་རིགས་པར་འགྲུབ་པར་བྱ།",
    "ཕྱོགས་སྐྱོང་བ་དང་འབྱུང་པོ་ལ་སོགས་པ་ལ་གཏོར་མ་གུས་པར་བཏང་།",
    "བདག་ཉིད་བཟླས་པ་ལ་ཞུགས་པའི་དུས་སུ་ཁྲུས་དང་གཙང་སྦྲ་ལ་སོགས་པ་བྱ་ཞིང་།",
    "སྨྱུང་བར་གནས་པར་བྱ་བ་ནི་བཟླས་པ་བུམ་པ་གཙོ་བོའི་དུས་ན་ངེས་པར་ཡིན་ནོ།",
    "དབེན་པའི་སར་བཞུགས་སུ་གསོལ།",
    "ཚེ་རྣམ་འཇོམས་ཀྱི་སྒྲུབ་ཐབས་བརྒྱ་རྩར་གྲགས་པ་༡༡༣འཕེལ་བའི་དོན་དུ་དཱུར་ཾབ་སྦྱིན་པར་བྱ།",
    "དེ་ནས་ཡེ་ཤེས་སེམས་དཔའ་གཞུག་པ་དང་གཉིས་སུ་མེད་པར་བརྟན་པར་བྱ་བ་དང་།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ལ་བསྟོད་པ།",
    "བདག་ཉིད་ཐ་མལ་པའི་ལུས་སུ་སླར་ལངས་འདོད་པའི་དོན་ཡིད་ལ་བྱས་ཏེ།",
    "དྲི་དང་འབྲུ་ལ་སོགས་པ་བུམ་པ་ལ་ཤིས་པའི་རྫས་རྣམས་ཀྱིས་ལེགས་པར་བལྟམས་ལ།",
    "ཁ་བཤལ་ཞིང་ཁྲུས་དང་གཙང་སྦྲ་ལ་གནས་པར་བྱས་ལ།",
    "སྒྲུབ་པ་པོའི་ལྕེའི་སྟེང་དུ་རྡོ་རྗེ་སྔོན་པོ་ནས་ཙམ་གྱི་སྦུབས་མ་ནས་སྔགས་ཀྱི་རང་སྒྲ་རྫོགས་པར་བྱས་ལ་སྣང་བ་རྣམས་ཀྱང་རྡོ་རྗེ་ལྟ་བུར་གསང་སྔགས་ཀྱི་རང་སྒྲ་དང་ལྡན་པར་དམིགས་ལ་བདག་དང་སྟོབས་པོ་ཆེ་གཉིས་སུ་མེད་པར་བྱས་ལ།",
    "བསྒྲུབ་བྱའི་མིང་རུས་ལ་གུ་གུལ་གྱི་ཆུས་བཀྲུ་ཞིང་ངེས་པར་བློས་བྱས་པས།",
    "ཇི་ལྟར་འདོད་པ་བཞིན་དུ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "གཞན་ཡང་བདག་ཉིད་ཀྱི་རིག་སྔགས་ཀྱི་ལས་མ་གྲུབ་པ་རྣམས་ཀྱང་འདི་ཉིད་ཀྱི་ཆོ་ག་ཞག་བདུན་འབད་ན་གཞན་གྱིས་སྤྱད་པར་དཀའ་བའི་ལས་འགྲུབ་པར་ངེས་སོ།",
    "སྒྲུབ་པ་པོའི་ལུས་དང་ངག་དང་སེམས་ཡོངས་སུ་དག་པར་བྱ་བ་ནི་རབ་ཏུ་གཙོ་བའོ།",
    "གཞན་གྱིས་བཤིག་པར་དཀའ་བའི་རིག་༧སྔགས་ཀྱི་ལས་འགྲུབ་པར་འདོད་ན།",
    "༡༡༧དམ་ཚིག་དང་ལྡན་པས་གནས་ཁང་ཡིད་དང་མཐུན་པར་མཎྜལ་སྔོན་པོ་ཁྲུ་དོའི་ཚད་དང་ལྡན་པར་བྱ་སྟེ་མེ་ཏོག་དམར་པོ་དང་སྔོན་པོ་རབ་ཏུ་ཡིད་དུ་འོང་བའི་ཚོམ་བུ་ལྔའམ།",
    "བདེན་པ་ཡང་དག་པའི་མཚན་རྟོགས་པར་བྱེད་པ།",
    "པྲ་སེ་ན་སྒྲུབ་པར་བྱེད་པའི་སྒྲུབ་པ་པོ་དམ་ཚིག་དང་ལྡན་པས་གནས་ཁང་ཡིད་དང་མཐུན་པར་མཎྜལ་ལ་སོགས་པ་སྔོན་དུ་བྱ་བའི་རིམ་པ་གོང་ལྟར་བྱས་ལ།",
    "ཁ་རྒྱན་ལ་སོགས་པ་མཛེས་པའི་ཆས་དང་ལྡན་པར་བྱ་ཞིང་།",
    "ཡེ་ཤེས་བསྟིམ་པ་ལ་སོགས་པ་བྱས་ལ།",
    "བདེན་པའི་མཚན་ཉིད་སྟོན་པར་འགྱུར་བ་ལ་ཐེ་ཚོམ་མེད་དོ།",
    "བདེན་པའི་ཚིག་ཉིད་འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པའི་མཚན་ཉིད་ཕྱིན་ཅི་མ་ལོག་པར་མཐོང་བར་འགྱུར་བ་ལ་ཐེ་ཚོམ་བྱར་མེད་དོ།",
    "ཆོ་ག་ལ་འབད་པར་བྱའོ།",
    "རྒྱུད་ཀྱི་བདེན་པའི་དོན་ངེས་པར་སྒྲུབ་པ།",
    "འདོད་པའི་དོན་ངེས་པར་བསྒྲུབ",
    "བརྒྱན་པར་བལྟའོ།",
    "དེ་ནས་བདག་ཉིད་རྡོ་རྗེ་གཏུམ་པོའི་ང་རྒྱལ་དང་ལྡན་པས་བདག་གམ་གཞན་བསྒྲུབ་བྱའི་ལུས་ཐམས་ཅད་རྡོ་རྗེ་རྩེ་གསུམ་པར་བྱིན་གྱིས་བརླབས་ཏེ།",
    "ཕ་རོལ་གྱི་ལུས་ལ་གནོད་པར་རུང་བ་གང་ཡིན་པ་རྣམས་བཅིང་བ་དང་བཀར་བ་དང་།་",
    "སྤ་བཀོང་བའི་ལས་ཉེ་བར་བསྒྲུབ་པར་བྱ་སྟེ།",
    "ཡུལ་འཇོམས་པའི་རྡོ་རྗེ་སྤྱི་བོར་རྣམ་པར་བལྟ་བར་བྱའོ།",
    "ཚོགས་ཇི་ལྟར་འབྱོར་པ་བསག་པར་བྱས་ལ་བདག་ཉིད་ཀྱིས་རྡོ་རྗེ་རབ་ཏུ་ཞི་བར་བྱེད་པའི་ལྟ་སྟངས་ཀྱིས་བལྟ་སྟེ།",
    "བསྒྲགས་པ་དང་ངེས་པར་སྤྱོད་པར་འགྲུབ་པ་དང་།",
    "དེ་ནས་དེའི་ལས་རྣམས་བསྒྲུབ་པ་ལ་བརྩོན་པའི་སྒྲུབ་པ་པོ་རྣམས་ཀྱིས་ངེས་པར་སྲ་བའི་དོན་བསྒྲུབ་པ་ནི་རྒྱུད་ཀྱི་ཚིག་ངེས་པར་བསྒྲུབ་པའོ།",
    "འདོད་པའི་དོན་དུས་ལ་ངེས་པར་བསྒྲུབ་པ།",
    "རྒྱུདབརྟན་པ་ཞེས་བྱ་བའི་ཚིག་ལེགས་པར་བསྒྲུབ་པ་ཞེས་བྱ་བ་སློབ་དཔོན་ཡེ་ཤེས་རྡོ་རྗེས་མཛད་པ་རྫོགས་སོ།",
    "སྔོན་དུ་བྱ་བའི་རིམ་པ་རྣམས་མ་ལུས་པར་བྱ་སྟེ།",
    "ཞགས་པ་བསྣམས་པ་རབ་ཏུ་འཇིགས་པ་ཆེན་པོའི་ང་རྒྱལ་དུ་བྱས་ཏེ།",
    "ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་ལེགས་པར་སྤྲུལ་ལ་འདོད་པའི་དོན་ལ་ལེགས་པར་གསོལ་བ་བྱས་ལ་ཉི་མ་དང་ཟླ་བ་གཟས་ཟིན་པའི་དུས་སུ།",
    "སིན་དྷུ་རའི་ཁུ་བ་ལ་སྔགས་འདི་སྟོང་ཕྲག་གསུམ་བཟླས་ཏེ་བུམ་པའི་ཆུ་དང་ལུས་ལ་བྱུགས་ན་ཇི་ལྟར་སྒྲུབ་པར་འདོད་པའི་དོན་ཐམས་ཅད་བརྟན་ཞིང་ཐོགས་པ་མེད་པར་འགྱུར་རོ།",
    "༡༢༣ཁྲུས་ལ་སོགས་པ་བྱ་བའི་རིམ་པ་རྣམས་བྱས་ལ།",
    "སྔགས་འདི་ཡིད་ཀྱིས་བརྒྱ་རྩ་བརྒྱད་བརྗོད་ན་འཇིག་རྟེན་པའི་མནའ་ལས་རྣམ་པར་རྒྱལ་བར་འགྱུར་རོ།",
    "ཨོཾ་སུ་བཛྙཱ་ཡ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཕཊ་སྭཱ་ཧཱ་ཞེས་པར་ངེས་པར་འགྲུབ་བོ།",
    "མནའ་ལས་རྣམ་པར་རྒྱལ་བའི་སྒྲུབ་ཐབས་རྫོགས་སོ།",
    "བར་འདོད་པའི་སྒྲུབ་པ་པོ་དམ་ཚིག་དང་ལྡན་པས་གནས་ཁང་ཡིད་དང་མཐུན་པར་བུམ་པ་ལ་སོགས་པ་རྫས་ཀྱི་རིམ་པ་བསོགས་ལ།",
    "སྔགས་འདི་ལ་ལན་བརྒྱ་རྩ་བརྒྱད་ཡིད་ཀྱིས་བརྗོད་ནས་ལྕགས་ཀྱུ་འཛིན་པའི་ལྟ་སྟངས་ཀྱིས་བལྟས་ན་ཚོང་ལས་རྒྱལ་བའི་དོན་ངེས་པར་འགྲུབ་སྟེ་སྔགས་ནི།",
    "ཨོཾ་ཧ་ར་ཧ་ར་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཕཊ་སྭཱ་ཧཱ་ཞེས་པས་ཁ་ཤར་ཕྱོགས་སུ་བལྟས་ཏེ་བརྗོད་ན་ཚོང་གང་བྱས་པ་ལས་རྒྱལ་བར་ངེས་སོ།",
    "ཚོང་ལས་རྣམ་པར་རྒྱལ་བ་སྒྲུབ་པའི་ཐབས་རྫོགས་སོ།",
    "ཨོཾ་པྲ་ཧ་ར་པྲ་ཧ་ར་བཛྲ་མྲྀ་བྷཉྫ་ནཱ་ཡ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཕཊ་སྭཱ་ཧཱ་ཞེས་བརྗོད་ཅིང་རབ་ཏུ་སྡང་བའི་ལྟ་སྟངས་ཀྱིས་རྣམ་པར་བལྟས་ཏེ།",
    "བུམ་རྐྱེན་རྣམས་རྫོགས་པར་བྱས་ནས།",
    "ཧཱུཾ་དང་ཕཊ་རྒྱུན་དུ་སྒྲོགས་པའི་གཟུགས་སུ་བྱས་ཏེ་ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་རབ་ཏུ་བསྐུལ་ལ་དོན་གཉིས་བྱས་ལ་དེ་ནས་བདག་དོན་དུ་འདོད་པའི་དོན་ལེགས་པ་གང་ཡིན་པ་བསྒྲུབས་ཏེ་མ་རུངས་པར་བྱས་པའོ།",
    "དེ་ནས་བུམ་པའི་ནང་དུ་བསྟིམས་ཏེ་ལེགས་པར་ངེས་པའི་འདོད་དོན་བྱས་ཏེ།་",
    "རྒྱུ་སྐར་ཟླ་བའི་ཉི་ཤུ་དགུའི་གཟའ་ངེས་པར་རྒྱུ་བའི་དུས་སུ་དྲག་ཤུལ་སྤྱོད་པའི་སྦྱིན་སྲེག་བྱ་སྟེ།",
    "བྲག་དང་ཆུ་འཐབ་ཏུ་མནན་ན་ཟླ་བ་དགུ་ནས་བསྒྲུབ་བྱ་གཟས་ཟིན་པར་འགྱུར་རོ།",
    "སྐྲག་པའི་ལས་ཐོག་བསྒྲུབ་སྟེ་བསྒྲུབ་བྱའི་ལུས་མ་རུངས་པར་འདོད་ན།",
    "སྒྲུབ་པ་པོ་དམ་ཚིག་དང་ལྡན་པས་གནས་ཁང་ཡིད་དང་མཐུན་པར་ཁྲུས་དང་གཙང་སྦྲ་དང་།",
    "དབུས་སུ་ལྕགས་སྣ་ལྔ་ལས་བྱས་པའི་ཕུར་བུ་གྲུ་གསུམ་གྱི་ནང་དུ།",
    "དེ་ནས་བདག་ཉིད་རྣམ་པར་འཇོམས་པའི་ང་རྒྱལ་དང་ལྡན་པས་བསྙེན་པ་ཅི་རིགས་པར་བྱས་ལ།",
    "དེར་ཐོག་རྒྱུན་མི་འཆད་ཾཔར་འབབ་པར་འགྱུར་རོ།",
    "པུའི་༡༢༨སྐྲག་པའི་ལས་འགལ་བའི་ལོ་ཐོག་མ་རུངས་པར་བྱ་བའི་ལས་ཀྱི་དྲག་ཤུལ་སྤྱོད་པར་འདོད་པའི་སྒྲུབ་པ་པོ་དམ་ཚིག་དང་ལྡན་པས།",
    "དེ་ནས་ཁྱབ་འཇུག་ལས་ལ་འཇུག་པའི་དུས་སུ་ཐབ་གསུམ་གྱི་ལས་སྦྱར་ན་བསྒྲུབ་བྱའི་ལོ་ཐོག་ངེས་པར་བརླག་པར་འགྱུར་རོ།",
    "ཆོ་འཕྲུལ་སྣ་ཚོགས་བསྒྲུབ་སྟེ་བསྒྲུབ་བྱ་སྣ་ཚོགས་སྐྲག་པར་འདོད་པའི་སྒྲུབ་པ་པོ་དམ་ཚིག་དང་ལྡན་པས་གནས་ཁང་ཡིད་དང་མཐུན་པར་འཕགས་པ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་རྣལ་འབྱོར་དུ་བྱ་སྟེ།",
    "རྫའི་གའུ་ལེགས་པར་སོ་བཏང་མ་ཐག་གཞན་དུ་ལོངས་མ་སྤྱད་པའི་ནང་དུ་རྟ་ཁྲ་བོའི་རྔ་མས་རྒྱུ་བྱས་ལ་བག་ཟན་གྱིས་དྲིལ་ཏེ་སྦྲུལ་རབ་ཏུ་འཇིགས་པའི་གཟུགས་ཚོན་སྣ་ཚོགས་པས་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་བསྒྱུཪ་ལ་འོ་མ་དང་ཁྲག་བསྲེས་པ་ལ་སྔགས་འདི་ཞག་བདུན་དུ་སྒྲུབ་པ་བྱས་ན།",
    "ཀླུ་སྣ་ཚོགས་ཀྱི་གཟུགས་གང་འདོད་པ་གོང་ལྟར་བྱས་པས་ངེས་པར་འགྲུབ་བོ།",
    "ངེས་པར་སྐྲག་ཅིང་མ་རུངས་པར་ངེས་སོ།",
    "རྒྱུདབྱ་སྐྲག་པར་འདོད་ན་གང་འདོད་པའི་ཤ་ཁྲག་དང་སྤུ་དང་གཤོག་པ་གཡས་པའི་སྤུ་རྩེ་རྣམས་ཕྱེ་མར་བྱས་ལ་བག་ཟན་དང་བསྲེས་ལ་གང་འདོད་པའི་གཟུགས་བྱས་ལ་དེ་ཉིད་སྤུས་ལུས་མགོ་མཇུག་བརྒྱན་པ་བསེའི་ག་འུའི་ནང་དུ་བཅུག་ལ་ཕག་ནག་པོའི་ཀོ་བས་གཏུམས་ལ་གཟའ་གང་དུ་འཇུག་པའི་ངོས་སུ་ཁ་བསྟན་ཏེ།",
    "མ་ཧཱ་ཡཀྵ་བཛྲ་ཀ་ཀ་ཡ་པ་དྱི་ཧཱུྃ་ཧཱུྃ་ཞེས་ལན་བདུན་བསྒྲུབས་ན་བསྒྲུབ་བྱ་དེ་སྐྲག་སྟེ་མ་རུངས་པར་ངེས་སོསོ།",
    "བསྒྲུབ་བྱའི་ཁྱིམ་དུ་བསྐྱལ་ན་སྔ་མ་ལྟར་འགྲུབ་པར་ངེས་སོ།",
    "འགལ་བ་སྐྲག་པར་བྱེད་པའི་ལས་སྣ་ཚོགས་པའི་ཆོ་ག་འགལ་བ་མེའི་འཁོར་ལོ་ཞེས་བྱ་བ།",
    "གཞན་གྱི་། རིག་སྔགས་ཀྱི་ལས་རྒྱུན་གཅོད་པར་འདོད་པས།",
    "རྡོ་རྗེའི་དཀྱིལ་འཁོར་ལག་མཐིལ་གཡོན་པར་བསྒོམ་སྟེ།",
    "དེ་ལྟར་བྱས་ན་གདོན་མི་ཟ་བར་གཞན་གྱི་རིག་༧སྔགས་ཀྱི་གནོད་པ་རྒྱུད་ཆོད་པར་ངེས་སོ།",
    "གཞན་གྱི་རིག་སྔགས་ཀྱིས་བྱས་པ་མནན་པར་འདོད་པའི་སྒྲུབ་པ་པོ་དམ་ཚིག་དང་ལྡན་པས།",
    "རྣམ་པར་སྨིན་པའི་ལུས་བསྲེགས་ཧཱུཾ་ལས་སླར་སོས་ཾ།",
    "རྒྱུད་འདི་ཡི་དམ་དུ་བྱས་ཏེ།",
    "གཞན་གྱི་རིག་སྔགས་བཤིག་པར་འདོད་པས།",
    "དུར་ཁྲོད་དུ་བསྐྱལ་ལ་ཤིང་ལ་བརྒྱངས་ནས་བཞག་པས་ངེས་པར་འགྲུབ་བོ།",
    "ཞི་བའི་སྦྱིན་སྲེག་བརྒྱ་རྩ་བརྒྱད་བྱས་ལ།",
    "སྔར་བྱས་པའི་ལས་སྡིག་རྣམས་རྣམ་པར་དག་པས་སེམས་རངས་པ་དང་།",
    "གཞན་གྱི་ལུས་འཇིག་པར་བྱེད་པ་རྡོ་རྗེ་རྣོན་པོ་ཞེས་བྱ་བ།",
    "གཞན་གྱི་རིག་སྔགས་ཀྱིས་བྱས་པའི་ལས་འཇོམས་པར་འདོད་པས།",
    "དེ་ནས་དེར་གཏོར་མ་བདུན་བཏང་ལ་ལས་ལས་རྣམ་པར་རྒྱལ་ལོ།",
    "ངག་བཤིག་པར་བྱས་སོ།",
    "གདོན་ཐམས་ཅད་རླག་༦པར་བྱེད་པའི་ལས་ཀྱི་བྱེ་བྲག་ནི་གདོན་སྟོང་ཕྲག་བརྒྱད་ཅུ་ཡོད་ཀྱང་ལྷའི་གདོན་དང་།"
  ]
}