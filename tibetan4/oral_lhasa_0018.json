    "རྟ་ཡི་མཆོད་སྦྱིན་བྱ་བའི་ཆོ་ག་དེ་བདེ་སྐྱིད་ཀྱི་སྣང་བའི་ཁྲོད་དུ་རྒྱས་པར་བཤམས།",
    "རྟ་མཆོག་འདིའི་བདག་པོ་ནི་རྒྱལ་པོ་ཤིང་རྟ་བཅུ་པ་ཡིན་པ་གོ་བར་བྱས།",
    "མཆོད་སྦྱིན་གྱི་དགའ་སྟོན་ལ་ཕེབས་པའི་རྗེ་བོའི་ཁྲོད་དུ་མི་ཐི་ལ་ཡི་རྒྱལ་པོ་ཀྲ་ཎ་ཅ་དང་།",
    "མཐུ་དང་བྱིན་ཆེན་པོ་མངའ་བའི་དྲང་སྲོང་ཆེན་པོ་གདན་འདྲེན་པར་ཞབས་ཀྱི་འཁོར་ལོ་རིང་བར་བསྒྱུར་རོ།",
    "རྫུན་དང་གཡོ་སྒྱུ་རྐུ་མ་མེད་པར་ཐམས་ཅད་ཆོག་ཤེས་སེམས་དང་ལྡན།",
    "དྲེགས་ལྡན་སྐྱེ་བོའི་རྣ་བའི་བུམ་པར་ཚིག་འཇམ་སྦྲང་རྩི་སྨྲ་མཁན་མེད།",
    "ཌ་རཚོ་ཌར་༡ ཁྲོ་ཁོ་བྱ་ན་ད་ལས་ཥ་ཎཱ་ཀུན་ཀྱང་ལྷ་ལ་གསོལ་བ་འདེབས་ཤིང་བཅོས་མའི་དད་པར་ཞེན་པ་ལོག།",
    "ཚོ་གདོལ་རིགས་དག་ཀྱང་ངལ་བ་མེད་པར་བཀུར་བསྟིའི་བྱ་བ་རྫོགས་པར་བགྱིད།",
    "ཁཚེ་ཌཁ་ཅཁ་ག་ཏཱ་ཁོ་ནི་ཎཱཀྱཁའིརིགས་དང་རུས་རྒྱུད་ཇི་སྙེད་དག་ཀྱང་ཕན་ཚུན་ཞབས་ཏོག་ལེགས་པར་བསྒྲུབ།",
    "ཁ་པར་ཨ་བ་ག་ཏོ་ཕྱོགས་ནས་བསྡུས་པའི་རྟ་མཆོག་རྣམས་ནི་བདེ་སོགས་བདག་པོའི་ཆིབས་པ་འདྲ།",
    "ཟླ་མ་མང་བྱས་པ་རྒོལ་དུ་མི་བཏུབ་བཙན་མཁར་ཞེས་བྱའི་ཨཱ་ཡུག་ཐ་ནི་མིང་དོན་མཚུངས།",
    "སཱ་ཏི་ལོ་ཁུ་ནཱ་ཞེས་བྱ་བའི་མཚེས་མ་དག་ཀྱང་འཁྲུངས་པར་གྱུར།",
    "སཱི་ཏཱའི་ནོར་བུ་ལེན་པར་ཕེབས་ཀྱང་གཞུ་རྒྱལ་མ་ཁུགས་གནོང་ཞིང་ལོག།",
    "མཚན་སྙན་འབར་བའི་མ་ཡུག་ཐ་ནས་མི་ཐི་ལ་ཡི་གྲོང་དུ་ཕེབས།",
    "སྐུ་ལུས་བརྗིད་པའི་ས་སྐྱོང་རྒྱལ་པོ་བློན་པོའི་ཚོགས་ཀྱི་དབུས་ན་བཞུགས།",
    "གཡུལ་གྱི་རུ་འདྲེན་སྤྱོད་མི་སུས་ཀྱང་འགུག་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "ཌ་ཌོ་ལག་གྲུང་པོའི་སྤྱན་ལས་གཟི་འོད་འཕྲོ་བཞིན་གཞུ་རྒྱལ་དེ་ལ་ཞིབ་པར་ལྟ།",
    "ཁོ་བོས་གཞུ་འདི་འཛིན་པར་བྱེད་ལ་མཐེབ་ལོང་སྦྱོར་བར་འདོད་པ་སྟེ།",
    "གྱད་ཀྱི་དཔའ་རྩལ་འདི་ལྟར་ངོམ་པར་རྒྱལ་སྲས་ཚོགས་ཀྱིས་ཧྲིག་ཧྲིག་བལྟ།",
    "དེ་སྐད་གསུངས་ལ་དྲང་སྲོང་དགའ་ཞིང་རྒྱལ་པོས་བཀའ་ཡི་ཕོ་ཉ་མངགས།",
    "ངོ་མཚར་གཏམ་གྱི་བྱུང་བ་དེ་རྣམས་སྒྲོ་འདོགས་མེད་པར་བསྙད་པ་ནི།",
    "ཕྱོགས་ཀྱི་རྒྱལ་སྲས་རྒྱུད་ཀྱི་མི་རྣམས་འཛུམ་ཞིང་འཛུམ་ཞིང་ཕེབས་ལགས་ཀྱང་།",
    "དེ་དག་ངལ་བ་འབྲས་བུ་མེད་པར་སྐྱེང་ཞིང་སྐྱེང་ཞིང་ཕྱི་ཕྱིར་ལོག།",
    "ཏའིཝ་ཞི་ཧྲི་ཐ་སྔགས་མཁན་བློན་ལ་གཏམ་གྱི་མཆིད་ཚིག་འདི་སྐད་གསུངས།",
    "བཀའ་ལ་ཉན་ནོ་རྗེ་བོ་ལགས་ཞེས་མི་ཆེན་སྔགས་མཁན་མགྲིན་ཅིག་སྨྲ།",
    "གཏི་སང་ཉིན་ཁྲི་གདུགས་ཉི་མ་ཤར་ཚེ་ལམ་ལ་ཆས་ཞེས་རྒྱལ་པོས་གསུངས།",
    "ཀ་གྱ་ནོམ་བདེ་བའི་གསོལ་སྟོན་བཤམས་ཏེ་བཀུར་བསྟི་ཞབས་ཏོག་རྒྱས་པར་མཛད།་",
    "རིན་ཆེན་གསེར་དངུལ་ཕྱུར་བུར་གཏམས་ལ་དཔུང་དང་བཅས་ཏེ་བགྲོད་པར་གླང་པོ་ཆེ་དང་རྟ་མཆོག་ཤིང་རྟ་རྐང་དམག་ཡན་ལག་བཞི་ལྡན་གྱི།",
    "ཟཀ་ཀ་ཁའི་འདྲེན་ཞེས་པའི་སྐུལ་ཚིག་མཁའ་ལྡིང་རྩལ་འཆང་རྟ་མཆོག་དེ་ལ་ཁོ་བོའི་ཤིང་རྟ་ལེགས་པར་ཕྲོངས།",
    "ཉི་མའི་འཆར་ནུབ་ལན་བཞིར་བྱས་རྗེས་ཝེ་ཏེ་ཧ་ཡི་ཁབ་ཏུ་འབྱོར།",
    "དེ་གའི་ས་སྐྱོང་ཀྲ་ཎ་ཙཱ་ཡིས་ཆིབས་བསུའི་དགའ་སྟོན་རྒྱས་པར་མཛད།",
    "འོད་མཛེས་རྒྱལ་རྒྱུད་རྐང་དྲུག་གཟི་བརྗིད་ཕེབས་བདེ་གཤོག་འགྱུར་སྐྱིད་ཅིག་གུསྐོམ་པས་ཆུ་བཞིན་མི་ཐི་ལ་ཡི་འབངས་རྣམས་སྐུ་མགྲོན་སྦྲང་ཆར་ཏེ།",
    "རིག་པའི་དཔའ་བོ་ཝ་ཞི་ཧྲི་ཐ་མི་འཇིགས་སེང་གེས་གཙོ་བྱས་པའི།",
    "རིག་འཛིན་སྔགས་མཁན་སློབ་དཔོན་རྣམས་ཀྱང་བདག་དང་ལྷན་དུ་ཕེབས་མཛོད།",
    "ཉིན་བྱེད་འདྲེན་པའི་རྟ་བདུན་ཇི་བཞིན་ཁོ་བོའི་ཤིང་རྟ་ལེགས་པར་ཕྲོངས།",
    "ཀྲ་ཎ་ཅ་ཡིསདགའ་བ་དང་བཅས་བསུ་བའི་ཆོ་ག་རྒྱས་པར་བཤམས།",
    "༡་ང་ར་བོད་ཀ་ཌཅ་ཋ་ཌ་ཌ་དགའ་བས་བསུའོ་འདི་གའི་འབངས་རྣམས་སྐུ་མགྲོན་ཁྱེད་ཅག་ཕེབས་པར་སྒུག།",
    "མུན་པའི་ཡོལ་བས་མ་བསྒྲིབས་སྔོན་ལ་དགའ་བའི་དགའ་སྟོན་རྫོགས་པར་བྱ།",
    "དགའ་བསུའི་ཆོ་ག་ཡོངས་སུ་རྫོགས་རྗེས་ཀྲ་ཎ་ཙཱ་ཡང་གཟིམས་སུ་ཕེབས།",
    "གྲ་སྒྲིག་རྒྱལ་སྲས་གཞོན་ནུ་དཔའ་བོ་བཞི་ཡིས་ཡབ་ཀྱི་ཞབས་ཏོག་སྒྲུབ་བཞིན་པར།",
    "ཡབ་ཀྱི་ཅི་གསུང་བཀའ་བཞིན་སྒྲུབ་མུར་མི་ཐི་ལ་ཡི་མཁར་དུ་བཞུགས།",
    "ཁྱེད་ཀྱི་ཉེ་དུ་གྲོགས་དང་བཅས་པ་བདེ་ཞིང་སྐྱིད་པར་གནས་ལགས་སམ།",
    "ཏཱ་ས་རཱ་ཐས་གུས་ལན་གནང་ཞིང་གྱ་ནོམ་སྐྱེས་ཀྱིས་ཚིམ་པར་བྱས།",
    "ཡིད་དུ་འོང་བའི་རྒྱལ་སྲས་དང་བཅས་བཀྲ་ཤིས་གནས་འདིར་ཕེབས་སུ་གསོལ།",
    "༡ དང་ལོ་པརཔ་༡༢ པའི།",
    "འབྲས་ཡོས་ལ་སོགས་སྣ་བརྒྱའི་བཟའ་བ་ལྷུན་པོའི་གཏོས་དང་མཉམ་པར་བྱས།",
    "རཱ་མ་ཎ་དང་རོལ་རྙེད་མ་གཉིས་གཅིག་གདོང་གཅིག་ལ་ཕྱོགས་བྱས་ཏེ།",
    "དེ་དག་ཐམས་ཅད་ནི་བོད་ལྗོངས་ཀྱི་གནའ་བོའི་ལྷ་སྒྲུང་དང་མི་རིགས།",
    "དགུན་ཟླ་བཅུ་པར་སླེབས་པའི་ཚེ།",
    "ལྷ་སྐུ་དེའི་མིག་ཅེར་ཞིང་མཆེ་བ་གཙིགས་པ།",
    "དེ་ནི་རིག་རྫས་གཏོར་བཤི་ག་བྱས་པ་ཡིན།",
    "ཧྲིན་ཡོན་ཁ་ཕྱིར་འཁོར་ནས་ཝང་ལགས།",
    "འདི་ནི་དང་ཐོག་ལྷ་སྐུ་བཞེངས་དུས་བསམ་བཞིན་དུ་ལས་པའི་ཀུན་དགའ་ར་བ་ཆུང་ཆུང་ཞིག་སྟེ།",
