    "ཚེ་གཅིག་ཕྱག་རྒྱ་ཆེན་པོ་འཐོབ་པར་འགྱུར།",
    "རྣལ་འབྱོར་རྣམས་ཀྱིས་གཞུང་འདི་རྟོགས་པར་ཤོག།",
    "དབྱིན་གྲངས་༡༡༧ ནས་༡༢༥ ནང་གསལ། ། ཐུགས་ཀྱི་མཛོད་སྐྱེ་མེད་རྡོ་རྗེའི་གླུ་བཞུགས་སོ། ། རྒྱ་གར་སྐད་དུ།",
    "ཁྱད་པར་ཅན་གྱི་ཡེ་ཤེས་ཁོ་ན་ཉིད།",
    "ཡེ་ཤེས་རང་བཞིན་སྐྱེ་འགག་མེད་པར་རྟོགས།",
    "དེ་ཉིད་སད་པས་བདེ་བ་སྟོང་པར་མཚོན།",
    "སྟོང་པར་སྨྲ་བས་དེ་ཉིད་རྟོགས་མི་འགྱུར།",
    "རྩེ་གཅིག་བྱས་ཀྱང་ཅུང་ཟད་བསྒོམ་དུ་མེད།",
    "ཤེས་རབ་རྣམ་གསུམ་ཡུལ་དང་ཐབས་སུ་གསུངས།",
    "ཀུན་མཁྱེན་གཉིས་མེད་སྣང་ཡུལ་ཞེན་དང་བྲལ།",
    "རྟོགས་པར་འདོད་པས་དེ་ཉིད་རྟག་ཏུ་བལྟ།",
    "དབྱིན་གྲངས་༡༢༥ ནས་༡༢༩ ནང་གསལ། ། སྐུ་གསུང་ཐུགས་ཡིད་ལ་མི་བྱེད་པ་ཞེས་བྱ་བ་བཞུགས་སོ། ། རྒྱ་གར་སྐད་དུ།",
    "གང་ཞིག་སྐུ་ཡི་ཁྱད་པར་བདུད་བཞི་རབ་ཏུ་འཇོམས་མཛད་ཅིང་།",
    "འདོད་པའི་དོན་ནི་ཡང་དག་སྤྱིན་པར་གང་གྱུར་པས།",
    "དགྱེས་ཤིང་ནམ་མཁའི་ཁམས་ཀུན་ཐམས་ཅད་འགེངས་པར་བྱེད།",
    "ཐུགས་ཀྱི་ཁྱད་པར་དགོངས་པ་དབྱིངས་ལས་མི་བསྐྱོད་ཀྱང་།",
    "ཐམས་ཅད་ཚིམ་ཞིང་མགུ་ནས་རབ་ཏུ་བསྟོད་པར་བྱེད།",
    "མ་ཧཱ་དེ་ཝ་ཨུ་མ་དེ་ཝཱི་རབ་ཏུ་འཇོམས་པར་བྱེད།",
    "རྣལ་འབྱོར་ཆེན་པོ་དེ་དང་ཐ་མི་དད་པར་ཤེས།",
    "གཟི་མདངས་གཉིས་ལ་བརྟེན་ཏེ་ལས་ཀུན་སྟོན་པར་བྱེད།",
    "བདག་མེད་རོ་གཅིག་ཁྱབ་པར་བྱེད་པའི་གཟུགས་ལྡན་ཞིང་།",
    "འདི་དག་ཀུན་གྱི་རྩ་བ་ཡིད་ལ་མི་བྱེད་པར།",
    "འདུས་མ་བྱས་ལ་ཡིད་ཀྱིས་དམིགས་སུ་མེད་དོ་ཀྱེ།",
    "ལོག་པར་ལྟ་བའི་ཚོགས་ཀྱིས་འདི་ལ་གཞོམ་དུ་མེད།",
    "འདོད་པའི་ཡོན་ཏན་འདི་ལ་འཕེལ་འགྲིབས་མེད་པར་འགྱུར།",
    "བློ་མཆོག་རྣམས་ཀྱིས་ཀྱང་ནི་ཕིགས་པར་ནུས་མ་ཡིན།",
    "འཇིགས་པར་བྱེད་པའི་དགྲ་ཡིས་མ་ཁྱེར་བར།",
    "དེ་ཉིད་གཉིས་བྲལ་རྟོགས་པར་འདོད་པ་གང་།",
    "འདི་ནི་མི་ཤེས་དེ་འདྲར་སྟོན་པར་བྱེད།",
    "ངེས་པར་གྲུབ་ཅིང་འདི་ལ་རང་བཞིན་མེད་འགྱུར་ཏེ།",
    "བྱིས་པ་རྣམས་ཀྱིས་ཤེས་པར་འགྱུར་མ་ཡིན།",
    "གང་ཞིག་འདོད་ཆགས་བྲལ་བས་རྟོགས་པར་འདོད་པ་དེ།",
    "ཐམས་ཅད་མཁྱེན་ལྡན་སུས་ཀྱང་མཐོང་བ་མེད་པ་དེ།",
    "སྡུག་བསྔལ་ཉིད་ཀྱི་རྩ་བ་འདི་རུ་བྱས།",
    "འདི་གོམས་གང་ཡང་ཤེས་པར་མི་འགྱུར་ཏེ།",
    "མ་གོམས་པས་ནི་ཐམས་ཅད་ཤེས་པར་འགྱུར།",
    "འདི་ལ་སྐད་ཅིག་ཙམ་དུ་རྟོགས་པར་མ་བྱེད་ཅིག།",
    "དེ་དང་གཅིག་ཏུ་འདྲེས་པར་གྱུར་ནས་ནི།",
    "སྐྱེ་བ་མེད་པའི་རྣམ་པར་ངེས་བརྗོད་པ།",
    "སྣ་ཚོགས་པར་སྣང་གང་ལ་ངོས་གཟུང་མེད་པ་སྟེ།",
    "ནོར་བུ་རིན་ཆེན་ལྟ་བུར་འཕེལ་འགྲིབ་མེད་པར་འབྱུང་།",
    "དེ་བཞིན་ཉིད་ལ་མི་གནས་གང་ལ་རང་བཞིན་མེད་པར་གྲོལ།",
    "འོད་གསལ་རྫོགས་དང་ཐིམ་དང་འགག་པར་འགྱུར་པ་གང་།",
    "ཇི་ལྟར་བསྒོམ་དང་ཆགས་པར་འགྱུར་པ་མཚན་མ་སྟེ།",
    "མཚན་མའི་དབྱིངས་ནས་ངོས་གཟུང་མེད་པར་མཐོང་།",
    "གསུམ་ལ་སོགས་པའི་སྒོ་ནས་འཇུག་པར་བྱེད་པ་ནི།",
    "མེད་ལ་མེད་པར་འཛིན་པའི་ཐ་སྙད་དེ།",
    "འདི་ནི་རྩ་བ་ཀུན་གྱི་རྗེས་སུ་རྟོག་པར་མ་བྱེད་ཅིག།",
    "འདི་ལ་གང་ཚེ་རྟོག་པར་བྱེད་པ་དེ།",
    "བསྐལ་པར་བགྲངས་ཀྱང་དེ་ཉིད་སྙེད་པ་མིན།",
    "འདི་ཀུན་མཆེད་ནས་ཐམས་ཅད་སྲེག་པར་བྱེད།",
    "ནོར་བུ་རིན་ཆེན་འབར་བ་དེ་ཡིས་རྙེད་པར་འགྱུར།",
    "ངན་འགྲོ་ལ་སོགས་ལོག་པར་ལྟ་བས་འཇིགས་པ་མེད་པ་དེ།",
    "སེམས་གཅིག་སྣང་བར་གྱུར་པས་འབྲས་བུ་གཅིག་ཏུ་ལོག་པར་འགྱུར།",
    "འོད་ཀྱིས་ཐམས་ཅད་ཟིལ་གྱིས་གནོན་པར་འགྱུར།",
    "སེམས་དེ་ཡན་ལག་བླངས་ནས་འཇུག་པར་འགྱུར།",
    "ཡན་ལག་ཐམས་ཅད་སྐད་ཅིག་འདི་ལ་རྟོགས་པར་འགྱུར།",
    "འཇིག་རྟེན་རྨི་ལམ་ལྟ་བུ་འདི་ལ་ཡང་དག་རྙེད་པར་འགྱུར།",
    "དོན་དམ་པར་ནི་གང་ཡང་ཡོད་པར་འགྱུར་བ་མ་ཡིན་ན།",
    "འདི་ལས་གཞན་དུ་འགྲོ་བའི་ཁྱད་པར་བསེ་དྲི་ཅན་བཞིན་ནོ།",
    "གཅིག་ཀྱང་ཕྱིན་པ་མེད་པར་འདིས་བརྟོལ་ལོ།",
    "དེ་ཉིད་ཡོད་པས་དེ་ལ་ཅི་ཞིག་ཕན་པར་མི་འགྱུར་རོ།",
    "དེ་ཉིད་ཤེས་ན་མི་བསམ་མི་རྟོག་པར།",
    "གཟུགས་མཐོང་ཅིར་ཡང་སྣང་བའི་ཡུལ་ནི་དེ་རུ་སྟོང་པར་འགྱུར།",
    "འདི་ལ་ཡེངས་ནས་དེ་ལ་གནས་པར་གྱུར་བ་མ་ཚོར་རོ།",
    "རང་བཞིན་རྣམ་པར་དག་པའི་ཡོན་ཏན་ཉིད།",
    "དེ་མེད་པ་དེ་གང་ཡིན་གང་ན་གནས་པར་མི་འགྱུར་རོ།",
    "རྒྱུན་མི་འཆད་པའི་བསམ་གཏན་གང་ཚེ་འཐོབ་པར་འགྱུར་བ་ལ།",
    "གསང་སྔགས་འདི་ཀུན་རྩ་བ་དེ་ལས་བསྐྱེད་པར་ནི།",
    "གཏང་གཞག་བྲལ་དང་འཐོབ་པར་མི་འགྱུར་རྒྱལ་སྲིད་བཞིན།",
    "གང་དུ་གཡོ་བ་མེད་པར་མ་ཚོར་རོ།",
    "རྣམ་པར་རྟོག་ཆེན་ལམ་དུ་ཞུགས་པའི་ཕྱིར།",
    "ཡང་དག་པ་ཡི་དེ་ཉིད་འཐོབ་པར་མི་འགྱུར་ཞིང་།",
    "བདག་མེད་པར་ནི་རང་བྱུང་གང་ཡང་རྣམ་པ་སྣ་ཚོགས་ཉིད།",
    "རྒྱུ་རྐྱེན་ལ་སོགས་འབྲེལ་བ་འདི་རུ་སྟོང་པར་བྱོས།",
    "དེ་ལ་གྲུ་མེད་རྒྱ་མཚོའི་ཞབས་སུ་ཟག་པར་འགྱུར།",
    "དེ་ལ་སེམས་རྒྱུན་ཆད་དོ་སྙམ་དུ་སེམས་ཤིང་སྟོང་པར་ཡིད་ལ་མ་བྱེད་ཅིག།",
    "གང་ལ་དོན་གྱི་བརྟུལ་ཞུགས་ཆེན་པོ་འདི་ཉིད་མ་ཐོབ་པར།",
    "འགྲོ་བ་ཀུན་གྱིས་དེ་ལྟར་ཤེས་པར་གྱུར་གང་ནི།",
    "གཞན་དུ་བལྟ་བ་མེད་པར་ཐག་ཆོད་བསམ་མེད་བློ་འདས་ཉིད།",
    "དེ་ལ་བསྒོམས་དང་མ་བསྒོམས་རྣམ་པར་རྟོག་པ་དང་།",
    "དེ་ལ་ཅི་བྱ་གང་ཡང་མ་བྱས་དེ་ཉིད་གསལ་བར་འགྱུར།",
    "ཅི་ལྟར་རྣམ་རྟོག་མ་བཀག་མ་སྤངས་པར།",
    "མ་བསྒོམས་ཆེད་དུ་མ་བྱས་འབྲལ་བ་མེད་པའི་རང་བཞིན་ཏེ།",
    "དུས་རྣམས་ཀུན་ཏུ་འདི་དོན་ཤེས་པའི་མཚན་མ་འདི་ལའང་རྟོག་པར་མ་བྱེད་ཅིག།",
    "ངོ་བོ་དེ་ལ་དྲི་མ་མ་སྤངས་དེ་ཉིད་མ་བསྒོམས་པར།",
    "ནགས་ཁྲོད་དག་ན་གནས་པའི་གླང་པོ་ཡན་པར་འཁྱམས།",
    "སྒྱུ་མའི་དཔེ་བརྒྱད་ལྟ་བུར་རང་བཞིན་མེད་པར་བྱོས།",
    "གཉིས་སུ་མཐོང་བ་མེད་པར་གྱུར་པ་དེ།",
    "སྤྱོད་པ་ཇི་ལྟར་བྱས་པ་ཀུན།",
    "དོན་དང་ལྡན་པར་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "བསྐུར་དུ་མེད་པའི་ཚུལ་གྱིས་འཐོབ་པར་བྱེད་པ་ནི།",
    "ཤེས་རབ་ཏིང་འཛིན་མི་དགོས་རྣམ་པར་གྲོལ་བར་འགྱུར།",
    "ཁྲོ་གཉེར་མེད་པས་ཟུག་རྔུ་ཐམས་ཅད་འཇོམས་པར་ནི།",
    "མ་སྐྱེས་པ་ཡི་ཚུལ་གྱིས་འཛིན་པར་མི་བྱེད་དོ།",
    "སུས་ཀྱང་ཤེས་པ་མེད་པར་ཀུན་ལ་གསལ་འགྱུར་བ།",
    "རིམ་པར་སྦྱངས་པ་གང་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་ཚེ་འདི་ལ་རྩ་བ་མེད་པར་རྟོགས་པ་ནི།",
    "ད་ལྟ་ཉིད་དུ་གཉིས་མེད་ངེས་པར་གྱུར་པ་ཡིན།",
    "དབྱིན་གྲངས་༡༢༩ ནས་༡༤༥ ནང་གསལ། ཕྱག་རྒྱ་ཆེན་པོ་འཆི་ཀ་མའི་མན་ངག་བཞུགས་སོ། ། ཕྱག་རྒྱ་ཆེན་པོ་འཆི་ཀ་མའི་མན་ངག་བཞུགས་སོ།",
    "ལུས་འདི་བོར་བས་ཆོག་པར་མ་དགོངས་ཏེ།",
    "དབྱིན་གྲངས་༡༤༥ ནས་༡༤༦ ནང་གསལ། ། དོ་ཧཱ་མཛོད་ཕྱག་རྒྱ་ཆེན་པོའི་མན་ངག་བཞུགས་སོ། ། རྒྱ་གར་སྐད་དུ།",
    "མིག་མེད་རྣམས་ལ་མུན་པར་རྟག་ཏུ་སྣང་།",
    "ཇི་ལྟར་བྱས་ཀྱང་བསླུས་པ་མ་ཚོར་རོ།",
    "དེ་ཚེ་རི་ཁྲོད་ང་ཡིས་རྟོགས་པར་འཇུག།",
    "སེང་གེའི་འོ་མ་སྣོད་ངན་ཕལ་པར་མིན།",
    "དང་པོ་ཕྱག་རྒྱ་ཆེན་པོ་བསྒོམ་དུ་མེད་པར་བསྟན་པ་ནི།",
    "གསུམ་པ་འཁོར་གསུམ་ལས་རྣམ་པར་གྲོལ་བའི་ཐ་མལ་གྱི་ཤེས་པ་ངོས་བཟུང་དང་བྲལ་བདེ་ཉིད་ལམ་ཕྱག་རྒྱ་ཆེན་པོ་ཡིན་པ་དཔེས་བསྟན་པ་ནི།",
    "རྣལ་འབྱོར་སྤྱོད་པར་དེ་དངོས་མེད་པ་སྟེ།",
    "གཉིས་པ་དེ་ལྟར་སྤྱད་ན་ཡུལ་གྱི་རྐྱེན་གྱིས་གོས་པ་མེད་པར་བསྟན་པ་ནི།",
    "དང་པོ་འབྲས་བུ་ཐོབ་ཏུ་ངེས་པར་བསྟན་པ་ནིགདོད་ནས་དག་པ་ནམ་མཁའི་རང་བཞིན་ལ།",
    "གཉིས་པ་ཐོབ་ཏུ་མེད་པ་ཐོབ་པར་འདོད་པ་འཁྲུལ་པར་བསྟན་པ་ནི།",
    "དེ་ལས་ཁྱད་པར་ཅུང་ཟད་ཡོད་མིན་ཏེ།",
    "གདོད་ནས་དག་པར་བརྟགས་པའི་ཡིད་སངས་པ།",
    "༡ནནས་༧ན་། ཀ་ཁའི་དོ་ཧ་ཞེས་བྱ་བ་བཞུགས་སོ། ། རྒྱ་གར་སྐད་དུ།",
    "ལུས་ནི་རྣམ་པར་བཅིངས་ཤིང་བཅིངས་ཤིང་བདུད་རྩི་འཛག།",
    "གངྒཱ་ཡ་མུན་གཉིས་ནི་ལེགས་པར་འཆིང་།",
    "སྲིད་ལ་བརྟེན་ཏེ་འགྲོ་འོང་འཆད་པར་འགྱུར།",
    "ཏ་ནི་སྐུ་གསུམ་གཞུང་གསུམ་གསུམ་ལ་བརྟེན་ནས་ཤེས་པར་གྱིས།",
    "ཐ་ནི་ནམ་མཁའི་ཟླ་བ་ཅན་ཡིན་བརྟན་པར་གྱིས།",
    "བརྟན་པོར་གནས་པར་གྱུར་ན་ཚེ་ནི་འཕེལ་བར་འགྱུར།",
    "ན་ནི་སྣ་ཚོགས་ཚུལ་གྱིས་ལེགས་པར་གཅིག་ཏུ་འཕོ།",
    "པ་ནི་བདུད་རྩི་ལྔ་ནི་སྣ་རུ་གླུག་པར་བྱ།",
    "བྷ་ནི་བྷ་ག་ཉིད་ནི་བྷ་གའི་རང་བཞིན་སྟོང་པར་གནས།",
    "དེ་ནི་དགེ་དང་མི་དགེ་མེད་པར་མདའ་བསྣུན་ང་ཡིས་སྨྲ།",
    "འཁྲུལ་པར་མ་བྱེད་སེམས་ཉིད་འདི་ནི་ནམ་མཁའ་ཡིན།",
    "སེམས་ནི་ཤི་ཞིང་འཆད་པར་འགྱུར་བས་རང་བཞིན་གཅིག་ཡིན་ནོ།",
    "རྣལ་འབྱོར་མ་ཡིས་སྒྲ་ཡིས་དེ་ཚེ་ལྷན་ཅིག་སྐྱེས་པར་རྟོགས།",
    "སྐྱེ་ཤི་གཉིས་ཀྱིས་འཇིག་པ་མེད་པ་འཐོབ་པར་འགྱུར།",
    "མཉམ་དང་མི་མཉམ་རྣལ་འབྱོར་མ་ནི་གྲུབ་པར་ཐེ་ཚོམ་མེད།",
    "ས་ནི་དངོས་པོ་འདི་ཀུན་དངོས་པོ་མེད་པར་མཉམ།",
    "ཀྱེ་ཧོ་གཅེར་བུས་ཐམས་ཅད་བསླུ་བར་ངེས་པར་ཐེ་ཚོམ་མེད།",
    "རྡོ་རྗེ་དང་པདྨ་མཉམ་པར་སྦྱོར་བའོ།",
    "འདིར་རྣལ་འབྱོར་པའི་རྒྱུད་ལ་དགའ་བ་བཞིའི་མཐར་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བ་སྐྱེས་པའི་དུས་སུ་དེ་ཁོ་ཉིད་ཀྱི་དོན་རྟོགས་པས་བདེ་བ་ཆེན་པོ་འོད་གསལ་བའི་དོན་མངོན་སུམ་དུ་བྱས་པའོ།",
    "ལྷན་ཅིག་སྐྱེས་པའི་སེམས་ལ་བྱའོ། དེ་ལྟ་བུའི་གཅེར་བུའི་དོན་དེ་རྟོགས་པར་གྱུར་ན།",
    "འདོད་པའི་ཡོན་ཏན་ལ་ལོངས་སྤྱོད་ཀྱང་དེ་ལ་གནོད་པར་མི་འགྱུར་ཏེ།",
    "མི་གནས་པའི་མྱ་ངན་ལས་འདས་པའི་དོན་མངོན་དུ་བྱས་པའོ།",
    "པེ་སྣར་གཉིས་ཀྱི་པར་མར་བཞུགས་པས་སོ།",
    "ཚིམ་པར་འགྱུར་གྱི།",
    "རྣལ་འབྱོར་པ་ངོམས་ཤིང་ཚིམ་པར་འགྱུར་རོ།",
    "མེད་པར་བྱས་ནས་ལུས་ལ་བསྟིམ་ནུས་ན་རྒས་པ་ལ་སོགས་པར་མི་འགྱུར་བའོ།",
    "དེ་ལྷར་ཕྱག་རྒྱ་ཆེན་པོའི་དོན་དེ་རྟོགས་ན་སྲིད་པའི་འདོད་ཡོན་ལྔ་ལ་བརྟེན་ནས་འགྲོ་འོང་འཆད་པར་འགྱུར་ཏེ།",
    "སྐྱེ་བ་དང་འཆི་བ་ལ་སོགས་པ་ཉམས་པར་བྱེད་པའོ།",
    "མཉེས་པ་ནི་དེ་སྟོང་པ་ཉིད་ཀྱིས་མཉེས་ཤིང་ཚིམ་པར་འགྱུར་གྱི།",
    "ཡང་ནས་ཡང་དུ་བསྒོམས་ན་ཕྱག་རྒྱ་ཆེན་པོ་འཐོབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ནོ།",
