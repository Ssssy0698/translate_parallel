    "དོན་ལ་བལྟས་ནས་བྱས་པ་དྲིན་དུ་གཟོ་བའི་ཕྱིར།",
    "མ་རིག་རིག་པར་བྱེད་པའི་སྐྱེས་བུ་མཆོག་དེ་ནི།",
    "དེ་ཡང་རྗེ་བཙུན་མཐུ་ལས་ངེས་པར་རྙེད་པར་འགྱུར།",
    "དུས་ཐབས་བསྟེན་པ་མཁས་པས་རྟག་ཏུ་བསྟེན་པར་བྱ།",
    "འོད་གསལ་ལས་ནི་ལྷན་ཅིག་སྐྱེས་པ་རྙེད་པར་འགྱུར།",
    "ལེགས་པར་སྦྱངས་པ་རྒྱུ་ཉིད་འབྲས་བུ་ཀུན་གྱི་ལུས།",
    "བདེ་བར་གཤེགས་པའི་བཀའ་དང་མཐུན་པར་བྱ་བའི་ཕྱིར།",
    "བསྐྱེད་པར་བྱ་དང་བྱེད་པའི་རང་བཞིན་མི་དམིགས་ཀྱང་།",
    "རྒྱུན་མི་འཆད་པའི་མཐུ་ལས་ངེས་པ་རྙེད་པར་འགྱུར།",
    "དེ་ཕྱིར་སེམས་ཀྱི་ནོར་བུ་འདི་ནི་དམ་པར་བྱོས།",
    "རྟོག་གེས་དགོས་པ་མེད་ཅིང་སྔ་མས་ཆོག་པར་ཟད།",
    "རྟོགས་པས་བཅུ་བཞིའི་ས་ལ་གནས་པར་འགྱུར།",
    "དོ་ཧ་མཛོད་ཀྱི་གླུ་བཞུགས་སོ། ། རྒྱ་གར་སྐད་དུ།",
    "ངེས་པར་སྐྱེ་བོ་དམ་པ་ལ།",
    "མཐོང་བ་ཙམ་གྱིས་འཇིགས་པར་བྱོས།",
    "དུ་བས་མིག་ལ་གནོད་པར་བས།",
    "མགོ་ལ་རལ་པའི་ཁུར་བུ་ཁུར་པར་བྱེད།",
    "ལ་ལ་ནམ་མཁའི་ཁམས་ལ་རྟོག་པར་སྣང་།",
    "ཅིག་ཤོས་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "ཀྱེ་ལགས།",
    "རྟོགས་པར་གྱུར་ན་ཐམས་ཅད་དེ་ཡིན་ཏེ།",
    "མདའ་བསྣུན་འོ་དོད་རྟག་ཏུ་འབོད་པར་བྱེད།",
    "དེ་ཀུན་རང་ཡིད་འཁྲུལ་པར་བྱེད་པའི་རྒྱུ།",
    "རིགས་ལ་བྱེ་བྲག་དག་ཏུ་མ་འབྱེད་པར།",
    "འདི་ལ་འཁྲུལ་པར་མ་འབྱེད་ཅིག།",
    "སྲིད་དང་མཉམ་ཉིད་ཐ་དད་མ་བྱེད་པར།",
    "ཆུ་ལ་ཆུ་བཞག་བཞིན་དུ་ཤེས་པར་བྱོས།",
    "བལྟས་ཤིང་བལྟས་ཤིང་མཐོང་བ་འགག་པར་འགྱུར།",
    "དེ་ལྟ་བུ་ཉིད་དུས་སུ་འགོག་པར་འགྱུར།",
    "སྐྱེ་བོ་མ་ལུས་ལྷག་པར་སུན་འབྱིན་ཞིང་།",
    "རྨོངས་པ་མདའ་བསྣུན་གྱིས་སྨྲས་ཙེ་ནེར་ཤེས་པར་བྱོས།",
    "འདི་ལ་ཉེས་པ་རྡུལ་ཙམ་ཡོད་མ་ལགས།",
    "རང་ཡིད་གྲོལ་ན་ངེས་པར་གཞན་མེད་དེ།",
    "མྱ་ངན་འདས་པའི་མཆོག་ཉིད་འཐོབ་པར་འགྱུར།",
    "སྐྱེས་བུ་དོན་རྣམས་ཕུན་སུམ་ཚོགས་པར་འདོད།",
    "ངེས་པར་རྟོགས་ན་མི་འཆིང་མི་གཏོང་ངོ།",
    "ཡི་གེ་མེད་པར་འཆད་པར་འདི་འཇུག་པར།",
    "མཁས་རྣམས་དེ་ཡིས་རྣམ་པར་གྲོལ།",
    "བཏང་བར་གྱུར་ན་མི་གཡོ་བརྟན་པར་གནས།",
    "དྲུང་དུ་སེམས་ཐག་གཅོད་པར་བྱོས།",
    "དེ་ཡིས་ཡིད་ནི་བརྟན་པར་འགྱུར་བ་ཡིན།",
    "དེ་ཚེ་ལུས་ཀྱི་འཆིང་བ་རྣམ་པར་འཆད།",
    "ཕྱིན་ཏེ་བལྟས་པས་རྟོགས་པར་གང་སྨྲ་བ།",
    "གདུང་བས་འབྲས་བུ་མེད་པར་མ་བྱེད་ཅིག།",
    "མཐའ་ཡི་ཚོགས་ནི་ཡང་དག་ཟད་པར་འགྱུར།",
    "དེ་ནི་ཤེས་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "རོ་འདི་བསྟན་པར་བཟོད་པ་མ་ཡིན་ཏེ།",
    "དབྱེ་བ་རྣམ་སྤངས་དེ་ལ་གནས་པར་བྱོས།",
    "གདུང་སེལ་བསིལ་བ་ངོམས་པར་མི་འཐུང་བ།",
    "གང་ཞིག་ཇི་ལྟར་བསྟེན་པར་བྱ།",
    "དབྱེ་བ་རྣམ་པར་སྤངས་ནས་དེ་ཉིད་གནས་པ་ལ།",
    "མྱ་ངན་འདས་པ་ལ་གནས་སྲིད་པར་མཛེས།",
    "དེར་ནི་འགྲོ་བ་མ་ལུས་རབ་ཏུ་ཐིམ་པར་འགྱུར།",
    "གང་ཚེ་ཡིད་ནི་མི་གཡོ་རབ་གནས་བརྟན་པར་བྱ།",
    "དེ་ལྟར་ང་ཡིས་བསྟན་པ་ཉིད་ལ་ངེས་པར་མ་འཁྲུལ་བར།",
    "མ་ལུས་དྲི་མེད་དོན་དམ་ཤེས་པར་བྱོས།",
    "མདའ་བསྣུན་གྱིས་སྨྲས་བདག་ཉིད་ཤེས་པར་བྱོས།",
    "ཡུལ་རྣམས་བགྲོད་ཅིང་གདུང་བས་ཉེན་བྱས་ཀྱང་།"
  ]
