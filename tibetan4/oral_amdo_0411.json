    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་ཉེ་བར་སོང་སྟེ།",
    "ཉེ་བར་སོང་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་སྤྱི་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "དེ་ཡང་དང་ཡང་དུ་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ལ་སྙོམས་པར་འཇུག་པ་དང་ལྡང་བའི་གནས་དེ་ཡོད་དོ་ཞེས་བྱ་བ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་རབ་ཏུ་ཤེས་སོ་ཞེས་བྱ་བ་ནས།",
    "དགེ་སློང་གནས་མ་ཡིན་ཞིང་གོ་སྐབས་མེད་དེ་ཡིད་ལས་བྱུང་བའི་ལྷའི་ལུས་གང་ཡང་རུང་བ་ཞིག་ཏུ་སྐྱེས་ནས་ཡང་དང་ཡང་དུ་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ལ་སྙོམས་པར་འཇུག་པ་དང་ལྡང་བ་འདི་ནི་གནས་མེད་ཅིང་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་ཤེས་པ་འདི་ནི་གནས་མེད་དོ་ཞེས་དེ་ལྟར་ལན་གཉིས་ལན་གསུམ་དུ་སྨྲས་སོ།",
    "འཆར་བྱེད་ཁྱོད་ཀྱིས་ཡིད་ལས་བྱུང་བའི་ལྷའི་ལུས་གང་ཡང་རུང་བ་གང་ཡིན་པར་ཤེས།",
    "ཀུན་དགའ་བོ་ཁྱོད་ཀྱང་དགེ་སློང་གནས་བརྟན་རྣམས་ལ་རྣམ་པར་གཙེས་པ་བཏང་སྙོམས་སུ་བྱེད་དམ།",
    "ཤེས་རབ་ཕུན་སུམ་ཚོགས་པ་ཡང་ཡིན་ལ་དེ་ཡང་དང་ཡང་དུ་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ལ་སྙོམས་པར་འཇུག་པ་དང་ལྡང་བའི་གནས་དེ་ཡོད་དོ་ཞེས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ།",
    "དེར་སྐྱེས་ནས་ཀྱང་ཡང་དང་ཡང་དུ་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ལ་སྙོམས་པར་འཇུག་པ་དང་ལྡང་བའི་གནས་དེ་ཡོད་དོ་ཞེས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་རབ་ཏུ་ཤེས་སོ།",
    "བཅོམ་ལྡན་འདས་ནང་དུ་ཡང་དག་འཇིག་གི་ཕྱིར་གདན་ལས་བཞེངས་ཏེ་གཙུག་ལག་ཁང་དུ་ཞུགས་སོ།",
    "འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ལུས་ཀྱིས་མངོན་སུམ་དུ་བྱས་ཤིང་ཉེ་བར་བསྒྲུབས་ཏེ་གནས་པ་འདི་ནི་དགུ་པ་སྟེ།",
    "གསུམ་འདུས་པའི་རེག་པ་དང་།",
    "རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "མ་རིག་པའི་འདུས་ཏེ་རེག་པ་ལ་བརྟེན་ཏེ།",
    "ནུབ་ཕྱོགས་སུ་ལྗོངས་རྒྱུ་ཞིང་ཨནྡའི་ཚལ་དུ་བྱོན་ཏེ་ཨ་མྲའི་ཚལ་དུ་བཞུགས་པ་མཐོང་ངོ།",
    "མཐོང་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་གང་ན་བ་དེར་ཉེ་བར་སོང་སྟེ།",
    "ཉེ་བར་སོང་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ནུབ་ཕྱོགས་སུ་ལྗོངས་རྒྱུ་ཞིང་ཨནྡའི་ཚལ་དུ་བྱོན་ཏེ་ཨ་མྲའི་ཚལ་དུ་བཞུགས་པ་མཐོང་ངོ།",
    "ཤིང་སཱ་ལ་བཟང་པོ་གཞན་ཞིག་གི་དྲུང་དུ་བརྟེན་ཏེ་བཞུགས་སོ།",
    "དེ་ནས་དགེ་སློང་རབ་ཏུ་མང་པོ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་གང་ན་བ་དེར་ཉེ་བར་སོང་སྟེ།",
    "ཉེ་བར་སོང་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "བདག་ཅག་ཡུན་རིང་པོར་བཅོམ་ལྡན་འདས་མཐོང་བར་འདོད་པས་སྐོམ་པས་གདུངས་ཏེ་བདག་ཅག་བཅོམ་ལྡན་འདས་མཐོང་ཞིང་བལྟ་བར་འདོད་པས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་གལ་ཏེ་ཁྱོད་ལ་མི་གནོན་ན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་ཉེ་བར་འགྲོ་བས་ཐུགས་བརྩེ་བར་མཛད་དུ་གསོལ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་དང་དགེ་སློང་རབ་ཏུ་མང་པོ་དེ་དག་དེ་ཉིད་ཀྱི་མཚན་མོ་འདས་པ་དང་།",
    "ལྗོངས་རྒྱུ་ཞིང་ཨནྡའི་ཚལ་གང་ན་བ་དེར་སོང་ངོ།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ།",
    "ཉེ་བར་སོང་ནས།",
    "ཇི་ལྟར་ཤེས་ཤིང་ཇི་ལྟར་མཐོང་བའི་རྗེས་ལ་ཟག་པ་ཐམས་ཅད་ཟད་པར་འགྱུར་སྙམ་མོ།",
    "དགེ་སློང་འདུ་བྱེད་གང་གི་རྒྱུ་ཅན་དང་གང་ལས་ཡང་དག་པར་བྱུང་བ་དང་།",
    "དགེ་སློང་དག་མ་རིག་པའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བ་དང་།",
    "དགེ་སློང་དག་སྲེད་པ་གང་གི་རྒྱུ་ཅན་དང་།",
    "དགེ་སློང་དག་ཚོར་བ་གང་གི་རྒྱུ་ཅན་དང་།",
    "དགེ་སློང་དག་ཚོར་བ་ནི་རེག་པའི་རྒྱུ་ཅན།",
    "རེག་པ་ལས་ཡང་དག་པར་བྱུང་བ།",
    "རེག་པ་ལས་སྐྱེས་པ་རེག་པ་ལས་བྱུང་བའོ།",
    "དགེ་སློང་དག་རེག་པ་གང་གི་རྒྱུ་ཅན་དང་།",
    "དགེ་སློང་དག་རེག་པ་ནི་སྐྱེ་མཆེད་དྲུག་གི་རྒྱུ་ཅན་དང་།",
    "རེག་པ་དང་།",
    "དེ་གཟུགས་བདག་ཡིན་ནོ་ཞེས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་མོད་ཀྱི།",
    "དེ་བདག་གཟུགས་དང་ལྡན་ནོ་ཞེས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་མོད་ཀྱི།",
    "དེ་བདག་ལ་གཟུགས་ཡོད་དོ་ཞེས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་མོད་ཀྱི།",
    "དེ་གཟུགས་ལ་བདག་ཡོད་དོ་ཞེས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་མོད་ཀྱི།",
    "དེ་ཚོར་བ་བདག་ཡིན་ནོ་ཞེས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་མོད་ཀྱི།",
    "དེ་བདག་ཚོར་བ་དང་ལྡན་ནོ་ཞེས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་མོད་ཀྱི།",
    "དེ་བདག་ལ་ཚོར་བ་ཡོད་དོ་ཞེས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་མོད་ཀྱི།",
