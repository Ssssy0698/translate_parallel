    "དེས་ན་བུ་གཞོན་ནུ་ཁྱོད་ལ་ང་འདི་སྐད་དུ་ཇི་ལྟར་ཁྱོད་འདི་ལྟ་བུའི་ངོ་བོ་སྐྱེས་བུ་བཟང་པོའི་ཟུང་ལ་འཇུག་ཅིང་།",
    "ཁྱོད་སྐྱེས་བུ་ཐ་ཆད་དང་སྐྱེས་བུ་ཐ་མར་མ་གྱུར་ཅིག་ཅེས་ང་སྨྲའོ།",
    "ཚ་བོའི་ཚ་བོར་རྒྱལ་པོ་ལྷ་ཆེན་པོ་སྟོང་ཕྲག་བརྒྱད་ཅུ་རྩ་བཞིས་མེ་ཏེ་ལེའི་གཞི་འདི་ཉིད་དུ་རྒྱལ་པོ་དྲང་སྲོང་གི་ཚངས་པར་སྤྱོད་པ་སྤྱོད་དོ།",
    "ཨ་མྲ་སྐྱོང་མའི་ནེ་ཙོ་བཞིན་ནོ།",
    "ཆུ་བོ་ཅན་ན་བཞུགས་སོ་ཞེས་ཨ་མྲ་སྐྱོང་མས་ཐོས་ནས།",
    "བཞིན་རྒྱས་ཁྱོད་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་ཉེ་བར་སོང་སྟེ།",
    "ཉེ་བར་སོང་ནས་ངའི་ཚིག་གིས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་སྤྱི་བོས་ཕྱག་གྱིས་ལ།",
    "བཙུན་པ་ཨ་མྲ་སྐྱོང་མ་བཙུན་པ་ལ་འདི་སྐད་དུ་གང་གི་ཚེ་བཅོམ་ལྡན་འདས་ཡངས་པ་ཅན་དུ་གཤེགས་པ་དེའི་ཚེ་ཐོག་མར་ཨ་མྲའི་ཚལ་དུ་ཐུགས་བརྩེ་བར་དགོངས་ནས་གཤེགས་སུ་གསོལ་ཞེས་སྨྲོས་ཤིག་དེ་ནས་ནེ་ཙོ་བཞིན་རྒྱས་ཨ་མྲ་སྐྱོང་མས་སྨྲས་པ་ཐོས་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་ཆས་སོ།",
    "ཇི་ལྟར་བདག་ཅག་གི་སྨད་འཚོང་མའི་ནེ་ཙོ་འགྲོ་ཡིན་འདུག་གི་ཞེས་མདའ་འཕངས་པར་བརྩམས་པ་དང་།",
    "དེ་དག་གི་སྤྱི་བོར་མདའ་དེ་དག་ལྷུང་བར་བརྩམས་པ་དང་།",
    "དེ་དག་གིས་ཚིགས་སུ་བཅད་དེ་སྨྲས་པ།",
    "ཁྱོད་ཀྱི་ཚིག་ལ་བདག་ཅག་གི།",
    "ཁྱོད་ནི་འཇིགས་པ་མེད་པར་སོང་།",
    "དེ་ནས་ནེ་ཙོ་བཞིན་རྒྱས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་ཉེ་བར་སོང་སྟེ།",
    "ཉེ་བར་སོང་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་སྤྱི་བོས་ཕྱག་བྱས་ཏེ།",
    "ཨ་མྲ་སྐྱོང་མ་བཙུན་པ་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་སྤྱི་བོས་ཕྱག་བྱེད་ཅིང་གནོད་པ་ཉུང་ངམ་ཞེས་བྱ་བ་ནས།",
    "སྔ་མ་བཞིན་དུ་བདེ་བ་ལ་རེག་པར་གནས་སམ་ཞེས་བྱ་བའི་བར་དུ་འདྲིའོ།",
    "བཞིན་རྒྱས་ཁྱོད་དང་ཨ་མྲ་སྐྱོང་མ་བདེ་བར་གྱུར་ཅིག།",
    "ཨ་མྲ་སྐྱོང་མ་བཙུན་པ་ལ་འདི་སྐད་དུ་གང་གི་ཚེ་བཅོམ་ལྡན་འདས་ཡངས་པ་ཅན་དུ་གཤེགས་པའི་ཚེ་ཐོག་མར་ཨ་མྲའི་ཚལ་དུ་ཐུགས་བརྩེ་བར་དགོངས་ནས་གཤེགས་སུ་གསོལ།",
    "དེ་ནས་ནེ་ཙོ་བཞིན་རྒྱས་བཅོམ་ལྡན་འདས་ཀྱིས་ཅང་མི་གསུང་བས་གནང་བར་རིག་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་སྤྱི་བོས་ཕྱག་བྱས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་དྲུང་ནས་སོང་ངོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་དྲུང་ནས་དོང་ཞིང་རིང་པོ་མ་ལོན་པར་ཁྲ་ཅིག་གིས་སྲོག་དང་བྲལ་བར་གྱུར་ཏོ།",
    "ལས་གང་གིས་སྐྱེས་ཞེས་སྐྱེ་བར་འགྱུར་རོ།",
    "མནྡ་ར་བ་དག་ཐོགས་ཏེ་འོང་ཞིང་ཉེ་བར་འོངས་ནས་མཚན་མོ་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་འོངས་ཏེ།",
    "ཉེ་བར་འོངས་ནས་བཅོམ་ལྡན་འདས་ལ་མེ་ཏོག་གིས་གཏོར་ཏེ།",
    "ངན་སོང་གི་སྒོ་བཀག་གོ།",
    "རེ་ཞིག་རིགས་པས་ངེས་པ་ནི་ཁྱིམ་བདག་གཟི་བརྗིད་ཀྱི་བུ་རབ་ཏུ་འབར་བའི་ནང་ན་གནས་པ་བཅོམ་ལྡན་འདས་ཀྱིས་འཚོ་བྱེད་ལ་བཀའ་ལུང་སྩལ་ཏེ།",
    "དེད་དཔོན་དེ་ཡང་ཟོང་ཐོགས་ཏེ་ཡུལ་གཞན་དུ་སོང་ངོ།",
    "དེ་ཡུལ་གཞན་དུ་སོང་བ་དང་དེའི་ཆུང་མ་ལ་ཁྱེའུ་ཞིག་བཙས་སོ།",
    "དེ་འཇིག་རྟེན་གྱི་གནོད་པ་སྤང་བའི་ཕྱིར་ཇི་ལྟར་འགའ་ཞིག་གིས་ཀྱང་ཤེས་པར་མི་འགྱུར་བ་དེ་ལྟ་བུའི་ལས་དང་སྦྱོར་བས་ཁྱོད་ཀྱིས་འདི་གསད་པར་བྱའོ་ཞེས་ཁོལ་མོའི་ལག་ཏུ་གཏད་དོ།",
    "དེ་བཞིན་དུ་དེས་ཁྱིའི་ཚང་གི་ནང་དུ་བསྐྱུར་རོ།",
    "ཁྱི་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་མཐོང་བ་དང་སོ་སོར་བྱེར་ནས་སོང་སྟེ་ཇི་ཙམ་ན་བཅོམ་ལྡན་འདས་ཀྱི་ཕྱག་གཡས་པ་བརྐྱང་སྟེ།",
    "གཞོན་ནུ་དེ་ལ་གཟིགས་ཏེ་བཀའ་སྩལ་པ།",
    "ངའི་བསྟན་པ་ལ་རབ་ཏུ་བྱུང་ནས་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ཏེ་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བྱེད་པར་འགྱུར་རོ།",
    "ཇི་ཙམ་ན་ཁྱིམ་བདག་ཕྱུག་པོའི་མཆོག་ཅེས་བྱ་བ་ཞིག་གིས་རྒྱལ་པོ་ལ་ཞུས་པ།",
    "བདག་གིས་འདི་གཟུང་བར་བྱའོ་ཞེས་རྒྱལ་བས་བསྟན་པ་ཞེས་བྱ་བའི་མིང་བཏགས་པར་གྱུར་ཞེས་བྱ་བ་ནས།",
    "རྒྱས་པར་གླེངས་ཏེ་ཆུང་མ་ལ་རེག་པར་བྱས་པའི་བར་དུ་སྟེ།",
    "དེ་ལ་བུ་གསུམ་དང་བུ་མོ་སྨད་མ་ཞེས་བྱ་བ་ཡོད་དེ།",
    "གསད་པར་བྱའོ་ཞེས་རྒྱས་པར་དུག་གི་སྦྱོར་བ་བརྩམས་ཀྱང་གསད་པར་མ་ནུས་ཤིང་མེར་བཅུག་ཀྱང་མ་ཚིག་གོ།",
    "དེ་ནས་ལྗོངས་གཞན་ཞིག་ན་འབྲས་ཀྱིས་ཕྱུག་པོ་ཞེས་པ་ཟོང་གིས་འཚོ་བ་རྟོག་ཅིང་གནས་པ།",
    "ཕྱུག་པོའི་མཆོག་གིས་ཁྱེའུ་མཐོང་བའི་བར་དུ་ནས་སྨྲས་པ།",
    "ཕྱུག་པོའི་མཆོག་གིས་སྨྲས་པ།",
    "དེ་དག་གིས་ཀྱང་བྱིན་ཏོ།",
    "གང་གི་ཚེ་ཆེར་སྐྱེས་པ་དེའི་ཚེ་ཁྱེའུ་ཡི་གེ་བཟུང་སྟེ་འོང་བ་འདི་ཁྱོད་ཀྱིས་ཟུང་ལ་རྫ་མཁན་གྱིས་སྲེག་པའི་ནང་དུ་བསྲེག་པར་བྱའོ་ཞེས་རྫ་མཁན་གྱི་དྲུང་དུ་བཏང་ངོ།",
    "ར་བར་ཕྱིན་པ་དང་ཕྱུག་པོའི་མཆོག་གི་བུ་གསུམ་པོ་དེ་ན་འདུས་ཏེ་འདུག་པས་འདི་སྐད་ཅེས་རྒྱལ་བས་བསྟན་པ་གང་དུ་འགྲོ།",
    "ཇི་སྲིད་དུ་རྒྱས་པར་ཕྱུག་པོའི་མཆོག་གི་བུས་དེ་ལས་ཡི་གེ་བླངས་ཏེ་རྫ་མཁན་གྱི་ཁང་པར་སོང་སྟེ།",
    "ཕྱུག་པོའི་མཆོག་གིས་ཡི་གེ་གར་སོང་ཞེས་སྨྲས་སོ།",
    "དེ་ཕུ་བོས་བླངས་ཏེ་སོང་ངོ་ཞེས་སྨྲས་པ་ནས།",
