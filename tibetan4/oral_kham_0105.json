    "འཕགས་སེང་གཉིས་ཀས་ཊིཀྐ་རྒྱག་དུས་ན་དེ་མཆོད་དང་རྩ་འགྲེལ་མ་སྦྱར།",
    "དཔེར་ན་རྟེན་བུམ་པ་གཅིག་ལ་བཅུད་སྦྲང་རྩི་བླུག་དུས་སུ་སྦྲང་རྩིའི་བུམ་པ་དང་།",
    "འོ་མ་བླུག་དུས་སུ་འོ་མའི་བུམ་པར་འཇོག་པ་བཞིན་འདིར་སེམས་གཅིག་བདེན་སྟོང་ཉན་ཐོས་ལམ་དུ་ཞུགས་དུས་སུ་ཉན་ཐོས་ཀྱི་རིགས་དང་།",
    "གལ་ཏེ་གནོད་པ་བསྐྱལ་ནས་རང་ཉིད་ཀྱིས་སྲོག་དོར་ཀྱང་ང་རང་ཉིད་ཀྱིས་བཟོད་ན་སྲོག་དོར་ཀྱང་རང་ཉིད་ལ་འགྱོད་པ་ཅི་ཡོད།",
    "སྔགས་ཨ་ར་པ་ཙ་ན་བཏོན་ན་ཤེས་རབ་འཕེལ་བ་འཇམ་དབྱངས་མཉེས་པར་བྱིན་གྱིས་བརླབས་པ་དང་།",
    "ཞེན་པའི་ང་རྒྱལ་བྲལ་བ་ལ་བྱང་སེམས་ཁོ་རང་འཇོག་སྤྱིར་ཡན་ལག་དང་ཉིང་ལག་སོགས་དུ་མ་ཡོད་ཀྱང་།",
    "ཚེ་འདི་ལ་ཡིད་ཆེས་མི་འདུག་པས་ཕྱི་མར་བདེ་ན་སྙམ་ནས་མངོན་མཐོ་དོན་དུ་གཉེར་བ་ནི་ཆུང་ངུ་དང་།",
    "དེ་ཁས་ལེན་ཡང་རང་རྐྱ་བའི་བདག་ཁས་མི་ལེན་ནོ།",
    "རྣལ་འབྱོར་སྤྱོད་པའི་རང་རྒྱུད་པའི་ལུགས་ལ་ཕྱི་རོལ་དོན་སྟོང་རང་རྒྱལ་གྱི་བར་ཆད་མེད་ལམ་གྱི་འཛིན་སྟངས་ཀྱི་ཡུལ་དུ་འཇོག་དགོས་པས་གཅིག་ཆར་བའི་རྒྱུན་ཞུགས་རང་རྒྱལ་ལམ་དུ་འཇུག་པ་མེད་དེ།",
    "བུམ་པ་དང་གཅིག་དུས་རྟག་ཏུ་མེད་པའི་ཕྱིར་རོ།",
    "རྫས་ཡོད་དང་རང་མཚན་གཉིས་དོན་གཅིག་པས་ན་དེ་མེད་ཟེར་མཁན་ཡང་ཡོད་ཀྱང་རང་སྤྱི་གཉིས་ཡོད་པར་འདོད་དགོས་སོ།",
    "རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་ཅེས་པའི་རང་རྐྱ་ཐུབ་པ་ཡང་རྫས་ཡོད་དང་རྫས་ཀྱང་རང་རྐྱ་ཐུབ་པའི་དོན་ཡིན་ནོ།",
    "བུམ་པ་རང་མཚན་གྱིས་གྲུབ་པ་དང་རང་བཞིན་གྱིས་མ་གྲུབ་པ་དེ་དེའི་ཞེན་ཡུལ་མིན་གསུངས།",
    "རྗེས་སུ་རྡུལ་ཕྲན་གཅིག་འདུག་ན་བདེན་བར་གྲུབ་བོ།",
    "འདི་སྐྱེས་པའི་ཕྱིར་འདི་སྐྱེས་ཞེས་པས་རང་རྒྱུ་ལས་སྐྱེས་ན་ཡང་རང་རྒྱུ་རྟག་པ་ལས་བྱུང་ངམ་སྙམ་པའི་ལོག་རྟོག་ཡོད་པས་དེ་བསལ་ནས་མི་རྟོག་པ་ལས་བྱུང་བར་ཤེས་པའི་ཆེད་དང་།",
    "འཇིག་ལྟ་མཐར་ལྟ་གཉིས་པོ་གང་ཡིན་ནའང་རང་དང་མཚུངས་ལྡན་ཐམས་ཅད་ལུང་མ་བསྟན་ཡིན་དགོས།",
    "འགྲོ་འདུག་འགྲོ་འདུག་ཁྲུས་ཁྲུས།",
    "སྟེང་རང་བྱུང་ཡེ་ཤེས་སུ་སྦར་ནས།",
    "ད་བར་སུས་ཀྱང་དཔེ་སྐྲུན་མ་ཐུབ་པར་རིམ་འགྱངས་སུ་ལུས་འདུག་པར་བརྟེན།",
    "འབྲུག་དུས་མིན་དུ་བསྒྲགས་པ་དང་།",
    "མར་ཕྱེད་གསུམ་སྐོར་འདུག་པ་གསུམ་སྐོར་ཤ་སྟག་ཏུ་བསྒྱུར།",
    "རྟེན་གསུམ་མཆོད་རྫས་ཆས་དངོས་སོགས་ཚན་མི་ཆུང་ཙམ་འདུག་ཀྱང་ཚང་མ་མིང་སྨོས་བྲིར་མ་ལྡང་བས་ཧ་ལམ་རྟེན་གསུམ་མཆོད་རྫས་དང་།",
    "ཁང་དཔོན་ལོགས་བཅད་བྱས་ཀྱང་ལྟོ་འབྱོར་ཡོང་རིགས་མི་འདུག་པ་མཆོད་གཞིས་བྱིངས་དང་ཕྱོགས་མཚུངས་གྲས་སུ་མི་སེར་དུད་འཛིན་༣༢ན་བརྒྱད།",
    "ཧུང་ཐའི་ཇི་མ་ནས་ཕེབས་བཞེད་འདུག་པ་དང་།",
    "ས་གནང་འདུག་པ་སྔར་འཇགས་མཆོད་རྒྱུན་དུ་བསམ་བགྱིས་པ་དགོས་ཆ་བསྡོམས་མཁར་རུའི་རྩ་ཁལ་ལྔ་བྲེ་བཅུ།",
    "དཔོན་ཆུང་མི་བཟང་རང་རང་གོ་བབས་ཀྱི།",
    "འདི་ཉིན་ཁང་སེར་མའི་ཐད་ནས་པོ་ཏ་ལར་འཇའ་གུར་ཁྱད་མཚར་བའང་བྱུང་༦༤ན་འདུག།",
    "དགོན་སར་ཨ་ཇོ་ཁུངས་ཀྱི་བོགས་མཁར་ཁལ་བཅོ་ལྔ་བྲེ་ལྔ་ཕུལ་གསུམ་སུམ་ཆ་གཅིག།",
    "ཨ་ཇོར་སེལ་༧༣ན་འདོན་སྐུ་རིམ་རྟེན་རྣམས་བསྡོམས་རུའི་ཁལ་བརྒྱ་དང་བརྒྱད་ཅུ་གྱ་གཅིག་བྲེ་ལྔ་ཕུལ་གསུམ་ལྷག་བཅས་རྣམས་མཆོད་རྒྱུན་དུ་བསམས་གནས་པ་བྱས།",
    "བྱམས་ཁང་རྒྱབ་པར་ཁོག་ཞུགས་འདུག་པས་འབུལ་ཡོན་སྦྱར་ཏེ་རྣམ་རྒྱལ་གྲ་ཚང་ནས་དྭངས་མ་བཅུད་འདྲེན་ལ་བརྟེན་པའི་ཞབས་བརྟན་དང་།",
    "དེ་ཚབ་སྤུན་བདུན་ལྷུན་གྲུབ་རྒྱ་མཚོ་མགྲོན་གཉེར་གྱི་ཞབས་ཕྱིར་འགྱུར་ཞིང་ཕྱོགས་འགྲོའི་རིགས་གང་ལ་ཡང་མཚེར་ངད་ཆུང་བ་དང་མངའ་རིས་སུ་གོ་ཆོད་བྱུང་འདུག་ཅིང་།",
    "ཕོགས་ལ་ཡང་འཕར་ཆག་བྱུང་འདུག་ཀྱང་།",
    "དམག་དུས་རྟ་དམག་རྐང་ཉིས་ཁྲི་བརྒྱད་སྟོང་བརྒྱད་ཅུ་གྱ་དྲུག།",
    "བབས་ནས་རྒྱལ་བ་གོང་མ་རྣམས་ཀྱི་ཚོད་ཀྱང་ཕེབས་པར་ཉེ་ཞིང་ད་ལྟའི་གསང་སྒོའི་བབས་ཀྱིས་གར་ཕེབས་ཀྱང་མི་ཤེས་འདུག་གཤིས་ཉེ་ལེན་བྱེད་རན་པ།",
    "ཨ་ར་པ་ཙ་ན་དམར་པོ།",
    "ཨ་ར་པ་ཙ་ན་དཀར་པོ།",
    "ལུང་པ་ཁྱི་ཉལ་བ་ལྟ་བུར་འདུག་པས་མིང་ཁྱི་ཉལ་དུ་བཏགས།",
    "དབོན་པོ་ཨོ་རྒྱན་བཟང་པོ་ཨོ་རྒྱན་གླིང་རང་དུ་སྐུའི་བཀོད་པ་བསྡུས།",
    "ཟླ་བ་བཅུ་གཅིག་པའི་ཚེས་བཅུ་བདུན་བར་མ་ཐོན་པའི་ཐོན་དུས་ས་འགུལ་དང་ཆར་ཟིམས་པའཇའ་སོགས་བྱུང་འདུག་ཅིང་།",
    "རིམ་གྱིས་ཤ་འུག་ཏུ་འབྱོར་བ་ཐམས་ཅད་འཇིགས་སྐྲག་ཆེ་བ་ཡོད་འདུག་ཀྱང་དགྱེས་ཉམས་འབའ་ཞིབ་མཛད་དོ།",
    "འཇམ་དབྱངས་ཀྱི་གཟུངས་ཨ་ར་པ་ཙ་ན་བྱེ་བ་དགུ་དང་།",
    "བེེ་རོ་ཙ་ནའི་མི་སྣ།",
    "གར་སྤོར་ཐམས་ཅད་སོམ་ཉིར་གྱུར་དུས་ཤ་ལུག་གསུང་བ་སོགས་སྐུ་སྐྱེ་དེ་དཀྱུས་མ་ཞིག་མིན་འདུག་ཅིང་།",
    "འཇམ་དབྱངས་ཀྱི་གཟུངས་ཨ་ར་པ་ཙ་ན་བྱེ་བ་དགུ།",
    "ངེད་རྣམས་ལ་དགའ་ཚོར་སོགས་ཡོད་མེད་ཀྱི་ཐ་སྙད་མེད་ཅིང་ཅི་དྲིས་ཀྱང་ཅང་མི་སྨྲ་བར་མས་འདི་ཤིན་ཏུ་ཁ་བདེ་ཡང་བབས་ནས་འདང་༡༥༥ན་ནང་དང་ཁྱད་པར་དེ་རིང་རང་ཉོག་གླེང་ཞིང་དེར་ངོས་འཛིན་སོགས་བཟང་ངན་མ་བྱུང་བས་ཕྱིར་ཡོངས།",
    "ཡང་རྐང་པ་སླར་ན་བའི་འགྲོ་མ་ཐུབ་པ་དང་ཁལ་མའི་བོག་བུ་ན་ནས་ཤི་བ་སོགས་དེ་སྐོར་འཚུབ་ཙམ་ལས་སྐུ་སྐྱེ་འདིར་ཡོད་ཀྱི་དོགས་པ་ཆེ་བ་རང་མ་བྱུང་འདུག།",
    "ཡེར་སྤེལ་ལྕོག་ཏུ་སྐུ་སྐྱེ་གཅིག་འདུག་པར་ཕ་མས་སྐྱེས་སྐར་བཟང་པོ་ཡིན་ཟེར་ཡང་དོན་ཕྱག་འཕྲོང་ངོ་འཛིན་མ་བྱུང་།",
    "ཀོང་ཟིམ་བུར་སྐུ་སྐྱེ་མང་ཙམ་ཞིག་འདུག་པར་དོགས་པ་མེད་ཅིང་སྔགས་པའི་བུ་དེ་མི་སྟོན་ཅིང་སྦ་བ་སོགས་དང་མཐར་བསྟན་ཀྱང་དོ་གོས་པ་ཟ་བ་དང་ངོས་འཛིན་མ་བྱུང་།",
    "སྐྱིད་ཤོངས་རྡོ་ཁར་སྐུ་སྐྱེ་ཞིག་འདུག་པ་བལྟ་བར་ཕྱིན་འདུག་པ་ཚུགས་ཁ་ཡང་བླ་ཚུགས་བྱེད་པ་ཞིག་འདུག་རུང་ལོ་ཡང་བྱ་ལོ་དང་དེར་མ་ཟད་ཕ་མས་བཟོས་པ་ལས་དོགས་པ་མི་འདུག།",
    "ཚར་འདུག།",
    "ཚོགས་པར་ཇ་བཅུ་གསུམ་གྱི་བར་འཇམ་དཔལ་གྱི་གཟུངས་ཨ་ར་པ་ཙ་ན་དང་།",
    "ཨ་ར་པ་ཙ་ན་སུམ་འབུམ།",
    "ཚེ་བདག་དུས་༤མ་གྱི་གཏོར་བདག་ཞེལ་བ་བརྟགས་རིལ་ཕུལ་བ་ངེད་ལ་ངན་པ་བབས་པ་བཟློག་ཐབས་སུ་སྨིན་གྲོལ་གླིང་པས་ཁྲ་འབྱུག་ཏུ་སྲི་གནོན།",
    "སེར་འབྲས་གཉིས་སུ་མང་ཇ་ལྔར་ཨ་ར་པ་ཙ་ན་གང་འགྲོ།",
    "ཁྱད་པར་མཐའ་དམག་བཟློག་ཐབས་སུ་རྒྱལ་ཆེན་དགོས་པ་སོགས་འདུག་པ་མཐུན་པར།",
    "སླད་ཆར་རྒྱུན་སྤེལ་སོགས་ལ་འདུན་པ་མི་དམན་པ་འདུག་པས་བདག་རྐྱེན་དང་།",
    "བེེ་རོ་ཙ་ནའི་བསྔོ་ཞུས་གོས་དར་རྟ་གོན་པ་སོགས་འབྱོར།",
    "ཉེར་གཉིས་ལ་རྣམ་དཀར་དགོངས་རྫོགས་སུ་དམིགས་འཕྱོང་རྒྱས་རི་བོ་བདེ་ཪྵ་པ་འདི་རང་ཅག་དགེ་དགོན་ཙམ་དུ་མ་ཟད་དེ་ནང་ནས་ཀྱང་རྙིང་ཁུངས་བསྙེན་བཀུར་གྱི་འོས་སུ་ཆེ་བ་བཅས་འདུ་ཁང་གཙང་ཁང་སོགས་ཞིག་རལ་ཆེ་ཙམ་འདུག་པར་མཐུན་རྐྱེན་ཚོན་དང་ཤིང་ཆའི་རིགས་དང་།",
    "ཐར་ལོ་གཅིག་མ་བཞུགས་པར་ཐབས་མེད་ཅེས་ནན་ཞུ་བྱས་ཀྱང་ཡུན་རིང་འདུག་མི་ཁོམ་ད་ལམ་རྒྱལ་པོ་ཁྱེད་དང་འཕྲད་པ་སེམས་དགའ།",
    "རྟེན་གསུམ་མང་པོ་བཤིགས་སྐད་འདུག་པས།",
    "སྒྲ་མི་སྙན་པའི་ཚེ་སྒྲུབ་འདི་ལ་བསྔགས་པ་ཆེན་པོ་འདུག་པས་འདིས་གོ་ཆོད་དམ་བསམ་པ་ཡིན་ཏེ།",
    "དོན་ལ་ཡང་དེ་ལྟར་བདེན་པས་དམག་བྱེད་ཐབས་མི་འདུག་ཅེས་དྲུང་སྐོར་དབུ་ཆེན་པ་རྣམས་ལ་གསུངས་པས།",
    "འོན་ཀྱང་ས་ཐམ་རྒྱལ་པོ་དེ་རྗེ་གོང་མའི་དུས་ནས་འདུལ་སྐལ་ལྟ་བུར་འདུག་པས།",
    "གསར་འདེབས་ཀྱི་དགོས་པ་མི་འདུག་ནའང་ཁོ་རང་བློ་ཁ་རྫོགས་པར་མི་འདུག་ན།",
    "རྟོག་པའང་རང་རིག་ལ་མི་འདོད།",
    "དེ་ཡང་རང་རིག་པས་རྟོགས་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་ཡང་རང་ཉིད་རྟོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ཉིད་ལན་ཡིན་ན་ནོ།",
    "ལྷ་སྦྱིན་༤ནི་གཅིག་ཉིད་༥རྣམ་པར་གཞག་༦པ་ཡིན་ལ་དེའི་འདུག་པ་དང་འགྲོ་བ་དག་ནི་ཆར་རྣམ་པར་གནས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་དང་རང་ཉིད་ཁོ་ན་གསལ་བ་ཡིན་གྱི་དེ་ལས་གཞན་ནི་མེད་དོ་ཞེས་གནས་ས་སོ།",
    "དེས་ན་འབྲས་བུ་བཞིན་དུ་དོན་རིག་པ་ཡང་རང་རིག་པ་ཙམ་ཉིད་ད་དོ།",
    "ཇི་ལྟར་ངས་འདི་རྟོགས་པ་དེ་བཞིན་དུ་རུང་བའི་ཡུལ་ན་འདུག་པ་གཞན་གྱིས་ཀྱང་རྟོགས་སོ་ཞེས་འཇིག་རྟེན་ན་གྲགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "རྨི་ལམ་གྱི་གནས་སྐབས་ན་ཡང་རང་བཞིན་དེ་ཉིད་ད་དོ།",
    "དངོས་སུ་བྱས་པ་ཤེས་པའི་རང་བཞིན་སྐད་ཅིག་མ་ཉིད་དེ་ཡང་རང་རིག་པ་ཉིད་ཀྱིས་མ་ཡིན་ཏེ།",
    "སྔོན་པོ་ཡང་རང་རྟོགས་པའི་རང་བཞིན་ཉིད་ནི་གཞན་ཡིན་ལ།",
    "འགའ་ཡང་མ་ཡིན་པའི་ཕྱིར་གཉི་ག་ཡང་རང་རིག་པ་ཉིད་དོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "སྐྲ་ལ་སོགས་པ་ལྟར་ཡུལ་ཐ་དད་ཀྱང་རང་བཞིན་གཅིག་ཏུ་འགྱུར་གྱི།",
    "མངོན་དུ་ཕྱོགས་པ་མཚུངས་ཀྱང་རང་བཞིན་འགའ་ཞིག་གསལ་བར་སྣང་བའི་ཕྱིར་གོམས་པ་ལ་སོགས་པ་ལས་ཀྱང་འགྱུར་རོ།",
    "གཞན་ཡང་ཕྱིའི་དོན་ཁས་བླངས་ཀྱང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་ན་ནོ།",
    "དེས་ན་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་ནོ་ཞེས་སྟོན་ཏོ།",
    "རྣམ་པར་ཤེས་པའི་སྨྲ་བ་ལ་ཡང་རང་རིག་པ་ཉིད་རྣམ་པ་གཞན་མེད་པའི་ཕྱིཕྱིར།",
    "དེ་ལ་གལ་ཏེ་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་པ་ཉིད་མཐོང་བས་དེ་ཉིད་ཡིན་རྨོད།",
    "དེའི་ཕྱིར་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་གྱི་དོན་རིག་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་ནི་འོ་ན་དོན་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་པས་ང་རང་༢རིག་པས་ཅི་བྱ་ཞེ་ན།",
    "དོན་དམ་པ་ལ་ལྟོས་༢ནས་འདིའི་དོན་རིག་པ་ཡིན་ཡང་རང་རིག་པ་ཉིད་ད་དོ།",
    "ཡུལ་གྱི་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་དོན་དང་རང་སྣང་བའི་ཡིན་ལ་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱའོ།",
    "འོན་ཏེ་དོན་ཡང་རང་རིག་པས་བསྒྲུབ་པ་ཡིན་ན།",
    "དེས་ན་དོན་དང་བཅས་པ་དྲན་པ་ཡིན་ན་ནོ་། བུམ་པ་ལ་སོགས་པ་འབའ་ཞིག་པ་ཡང་རང་བཞིན་ཉིད་ཡིན་ཏེ།",
    "སྔོན་པོ་ལ་སོགས་པའི་ཡུལ་ནི་བློ་ད་ང་ལྷན་ཅིག་དུས་གཅིག་ཉིད་དུ་མྱོང་བ་ཡིན་ཏེ།",
    "དེས་ན་རྣམ་པ་དུ་མའི་ཉེས་པ་དེ་ནི་སོ་ན་འདུག་པ་ཉིད་དོ་ཞེ་ན།",
    "ཤེཔ་གཅིག་དུས་ཉིད་དུ་ཡོངས་སུ་རྫོགས་པའི་ཕྱིར་རྟག་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "ཇི་ལྟར་ལུས་ལ་ལྟོས་༦ནས་རྩིག་པ་མདུན་ན་འདུག་པ་དེ་བཞིན་དུ་ལུས་ཀྱང་རྩིག་པ་ལ་ལྟོས་༧ནས་ཡིན་པར་འགྱུར་ན།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་མིན།",
    "ལུས་ཀྱི་རྣམ་པ་ཡིན་ཡང་རང་རིག་པར་ཁས་མི་ལེན་པའི་ཕྱིཕྱིར།",
    "དེ་ཡང་རང་རིག་པའི་རང་བཞིན་ཡིན་པས་རང་རིག་པ་གྲུབ་པོ།",
    "གལ་ཏེ་བློ་ཡང་རང་རིག་པ་མ་ཡིན་ན་ནི་ཁྱད་པར་དང་ཁྱད་པར་ཅན་མ་ཡིན་པའི་དོན་ཉིད་རྟོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བར་འགྱུར་རོ།",
    "དེས་ན་བརྗོད་པ་ལྡོག་༡པས་ཁ་རོག་འདུག་པར་བྱའོ།",
    "འོན་ཏེ་གཞན་གྱིས་ཀྱང་རང་བཞིན་དེ་ཉིད་རྟོགས་པ་ཡིན་ན་ནོ།",
    "འོན་ཏེ་དེ་༢ིཡང་རང་རིག་པ་ལ་སོགས་པ་དོན་གྱི་སྣང་བ་སྣང་བ་ཡིན་པས་ན།",
    "དེས་ན་དེ་ཡང་རང་ཉིད་རབ་ཏུ་གསལ་བ་ཉིད་ཀྱིས་གསལ་བ་ཡིན་གྱི།",
    "འོན་ཏེ་མི་གནས་ཀྱང་རང་ཉིད་གནས་སོ་ཞེ་ན།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "དེའི་ཕྱིར་འགྲོ་བ་འདི་ན་བདེ་བ་ལ་སོགས་པ་དང་སྔོན་པོ་ལ་སོགས་པ་ལས་གཞན་རིག་པ་མེད་པའི་ཕྱིར་ན་བདེ་བ་ལ་སོགས་པ་བཞིན་དུ་སྔོན་པོ་ལ་སོགས་པ་ཡང་རང་རིག་པ་ཡིན་ནོ་ཞེས་རིགས་༢པ་འདི་ནི་གདོན་མི་ཟའོ།",
    "རིག་པ་དེ་ཡང་རང་རིག་པ་མ་ཡིན་ན་ནི།",
    "གལ་ཏེ་བློ་༢དེ་དག་དུས་ཀྱི་རང་བཞིན་འཛིན་པ་ཡིན་ན་ནི་༤དེའི་ཚེ་ཐོག་མ་དང་ཐ་མ་མེད་པ་ཉིད་དང་།",
    "འདོད་པ་དང་རང་ཉིད་ཀྱི་ཚིག་བཞིས་༡མ་གྲུབ་པ་དང་།",
    "དེ་ནི་བདེན་ཏེ་དེ་ལྟ་ན་ཡང་རང་ཉིད་སྨོས་པ་ནི་ལོག་༐",
    "ཅི་སྟེ་ཁ་རོག་ཉིད་དུ་མི་འདུག་༢ིཅེ་ན་མ་ཡིན་ནོ་༤།",
    "གཏན་ཚིགས་ལྟར་སྣང་བ་ཡང་རང་ཉིད་དེ་ལྟར་འགྱུར་བ་ཡན་པའི་ཕྱིར་རྒོལ་བ་ལ་ཉེས་པ་ཅི་ཡོད།",
    "ཐག་རིང་ན་འདུག་པས་ཅི་ཕྱིར་ཐོས་ཤེ་ན་འོ་ན་དེའི་ཚེ་གཟུགས་ཀྱང་ནམ་མཁའི་ཡོན་ཏན་དུ་འགྱུར་ར་རོ།",
    "དེ་ལྟ་ན་ཤིང་ལ་སོགས་པའི་དོན་རྣམས་ཀྱང་རང་ཉིད་སྔ་མ་དང་ཕྱི་མ་ལ་སོགས་པ་ཡིན་གྱི་སྔ་མ་ཉིད་ལ་སོགས་པས་དུས་གཞན་ལ་ལྟོས་༥པ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་མི་གནོད་དོ་ཞེ་ན་ཡང་རང་ཉིད་འཇུག་པས་ན་རང་ཉིད་སྨོས་པས་༢ིཅི་བྱ་ཞེ་ན།",
    "འོན་ཏེ་གཞན་མ་གྲུབ་ཀྱང་རང་ཉིད་ནི་ལུང་ལས་གྲུབ་པ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་མེ་དང་དུ་བ་དག་ཀྱང་རང་ཡུལ་ཅན་གྱི་རྣམ་པར་ཤེས་པ་ལ་སྣང་བའི་ཕྱིར་ཅི་ལྟར་དེར་འགྱུར།",
    "འབྲས་བུའི་གཏན་ཚིགས་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱིས་རབ་ཏུ་འགྲུབ་པ་འགལ་བའི་དོན་གྱིས་གསལ་ཞབ་དེར་ཡང་ཕྱོགས་མ་ཡིན་ནོ་ཞེས་འདི་རྗེས་སུ་དཔག་པ་ཉིད་ལ་ཅི་སྟེ་མི་བརྗོད།",
    "འགའ་ཡང་འདུག་པར་ཡང་མི་བྱ་འགྲོ་བར་ཡང་མི་བྱ་བར་འགྱུར་ར་རོ།",
    "སྦྱོར་བ་ཡང་རང་བཞིན་དང་རྐྱེན་གྱི་༡དོན་ལས་སྐྱེས་པ་ཡིན་པའི་ཕྱིར།",
    "དེ་ལ་ཡང་རང་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པ་ནི་ཕྱོགས་ཡིན་ནོ་ཞེས་གསུངས་ས་སོ།",
    "འོན་ཀྱང་རང་བཞིན་འགས་ནི་ཐ་དད་པ་ཡིན་ལ།",
    "འོན་ཏེ་ཁྱད་པར་དང་སྤྱི་ཐ་དད་པ་དག་ཀྱང་རང་བཞིན་འགས་ནི་ཐ་དད་པ་ཡིན་ལ་རང་བཞིན་འགས་ནི་ཐ་དད་པ་མ་ཡིན་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "ཡུལ་ཐག་རིང་པོ་ན་འདུག་པའི་ཐོ་༡ཡོར་ལ་ཐ་དད་པ་ཡོད་ཀྱང་རྟོགས་པར་མི་ནུས་ཏེ།",
    "དེ་ཡང་རང་བཞིན་གཞན་ཡིན་པའི་ཕྱིར་ཐུག་པ་མེད་པས་སྒྲའི་བདེན་པའི་བདག་ཉིད་ནི་མི་རྟག་པ་ཉིད་ད་དོ།",
    "དེའི་ཕྱིར་འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་གཉིས་ཀ་ཡང་དཔེ་༨འདི་ཉིད་ཀྱིས་བསྟན་པ་ཡིན་ན་ནོ།",
    "གལ་ཏེ་འབྲས་བུ་དང་རང་བཞིན་གྱི་",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ས་སོ།",
    "རྒྱུ་དང་ངོ་བོ་ལྡོག་པ་ཉད་ཀྱི་འབྲས་བུ་དང་རང་བཞིན་གྱི་དོན་ལྡོག་པར་བརྗོད་༦པའི་ཕྱིར་རོ་། རང་བཞིན་ཉིད་དམ་རྒྱུ་དངོས་ནི།",
    "དེ་ཡང་རང་བཞིན་མི་དམིགས་པ་ཁོ་ནའོ།",
    "འབྲས་བུ་དང་རང་བཞིན་གཉིས་ནི་དེའི་དབྱེ་བའི་ཕྱིར་ར་རོ།",
    "དེའི་ཕྱིར་འགལ་བས་ཁྱབ་པ་དམིགས་པ་ནི་མི་དམིགས་པའི་དབྱེ་བ་ཉིད་ལ་དེ་ཡང་རང་བཞིན་གྱི་ཁོངས་སུ་འདུ་བར་འགྱུར་རོ།",
    "ཕྲད་པར་བྱ་བའི་འབྲས་བུ་རྟོགས་པར་༢ཡང་རང་ཉིད་ལ་ཁོ་ན་ལས་༢ངོ་བོ་བཞིན་དུ་ཐེ་ཚོམ་མེད་པ་ཡིན་ནོ།",
    "གང་ལ་ཐེ་ཚོམ་མམ་ཕྱིན་ཅི་ལོག་པ་ཡང་རང་ཉིད་སྐྱེས་པ་ཡིན་ན་དེ་འདི་ལྟ་བུ་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ནོ་མ་ཡིན་ཏེ།",
    "ཕྲད་པར་བྱ་བ་ཡང་རང་ཉིད་རིག་པར་བྱ་བའི་ཕྱིར་ར་རོ།",
    "དེ་ཡང་རང་ཉིད་ཁོ་ན་ལས་ཡིན་པའི་ཕྱིར་མི་མཐུན་པ་༢མེད་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ།",
    "དེ་ཡང་རང་བཞིན་ཁོ་ན་ཡིན་གྱི་ཁྱབ་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "རྨོང་ས་པ་མ་ཡིན་པའི་མངོན་སུམ་ནི་ཅིག་ཤོས་ཀྱིས་མི་དམིགས་པ་ཡིན་ན་ནོ་། འབའ་ཞིག་པ་ཉིད་ཀྱང་ས་ཕྱོགས་ལ་སོགས་པའི་མེད་པ་བཞིན་དུ་མེད་པ་གཞན་མེད་ཀྱང་རང་ཉིད་ཁོ་ན་ལས་གྲུབ་པར་བསྟན་པ་ནི།",
    "སྨྲ་བ་པོ་ཉིད་ནི་སྐྱེས་བུས་བྱས་པ་ཡིན་ལ་སྐྱེས་བུ་རྣམས་ཐ་སྙད་འདོགས་པ་ན་དྲུང་ན་འདུག་པ་༢དེ་རང་བཞིན་གྱིས་གོ་བ་འདི་ཡང་གཏམ་ཙམ་ཡིན་ཏེ།",
    "གཟུང་བའི་རྣམ་པ་ཡང་རང་རིག་པ་མ་ཡིན་ན་ནམ།",
    "ད་ནི་དེ་ཡང་རང་ལས་སམ་གཞན་ལས་ཡིན་ཞེས་རྣམ་པར་དཔྱད་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་གནོད་པ་མེད་པ་ཉིད་ཀྱི་མཚན་ཉིད་ཀྱང་རང་ལས་ཡིན་ནོ་སྙམ་པ་སྔོན་དུ་འགྲོ་བས་ཟེར་བ་ནི་འོན་ཏེ་གནོད་པ་མེད་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་ནས།",
    "བདེ་བ་བཞིན་དུ་སྔོན་པོ་ཡང་རང་རིག་པ་ཁོ་ན་ཡིན་ཏེ།",
    "ཅིག་ཤོས་ཀྱང་རང་ལས་རྟོགས་པ་མ་ཡིན་ན་ནོ།",
    "འབྲེལ་པ་ཅན་མ་ཡིན་པ་ཡང་རང་བཞིན་གྱིས་འབྲེལ་པ་ཅན་དུ་བྱེད་པ་ནི་སྐྱེས་བུ་ཡིན་ནོ་ཞེ་ན།",
    "དཔེར་ན་ཡི་གེ་ག་དང་ཨའུ་༢དང་ཚེག་དྲག་རྣམས་ཀྱང་རང་ཉིད་རྟག་པ་ད་ང་།",
    "ཤེས་བྱའི་དུས་སུ་ཡང་ཡལ་བར་འདུག་པ་ཉིད་ཀྱི་ཕྱིར་ཇི་ལྟར་དེ་ཡང་ད་ག་པར་༐",
    "དེ་བཞིན་དུ་སེམས་ཀྱི་རང་བཞིན་ཡང་མ་རིག་པའི་དྲི་མས་གཡོགས་པའི་སྐྱེས་བུ་ནི་ཤིན་ཏུ་གཉིད་ལོག་པ་ལྟ་བུར་༢ིའདུག་པ་ཡིན་ལ།",
    "རྟོགས་པར་བྱེད་པ་ཡིན་ལ་བྱ་བ་དེ་ཉེ་བར་ཟད་ནའང་༥དེ་ཁོ་ན་ལྟར་ཤིན་ཏུ་གཉིད་ལོག་པ་བཞིན་དུ་འདུག་པའི་ཕྱིཕྱིར།",
    "གལ་ཏེ་དམིགས་པ་མེད་པ་བཞིན་དུ་རུང་བའི་མེད་པ་༢ཡང་རང་ལས་རྟོགས་པར་ཅིས་མི་འདོད།",
    "སེམས་པ་ཅན་མ་ཡིན་པ་འདུག་༨པར་མཐོང་བ་ཡིན་ན་གཞན་འཇུག་པར་བྱེད་པ་ཉིད་ནི་མ་ཡིན་ཏེ།",
    "འདིའི་བཏང་སྙོམས་དེ་ཉིད་ནི་བསྒོམ་༢པ་མེད་ཀྱང་རང་བཞིན་ཉིད་ཀྱིས་ཡིན་ན་ནོ།",
    "ཕ་རོལ་པོས་ཁས་བླངས་པ་ཡིན་ཡང་རང་ཉིད་མ་མཐོང་ན།",
    "རྟག་པ་ཉིད་ཡིན་པས་འབྲས་བུ་ཡོད་པ་དང་མེད་པའི་དུས་སུ་བྱ་བ་མེད་པར་འདུག་པ་ཡིན་པར་བསྟན་ནས།",
    "སྡོད་པར་མི་བྱེད་པ་རྣམས་ཀྱི་ཡང་ཉེ་བར་འགྲོ་བའི་རྒྱུ་རྣམས་ཀྱིས་བྱ་བ་མེད་པར་འདུག་༩པ་ཉམས་པ་རྣམས་ཁོ་ནར་ཉེ་བར་འགྲོ་བར་༐",
    "དེ་ཡང་རང་དོན་མ་བོར་བས།",
    "དེ་ལ་ཡང་རང་ཉིད་ལས་རིག་པ་མེད་པ་ཡིན་ཏེ།",
    "མངལ་ན་འདུག་པ་ལ་སོགས་པའི་སྡུག་བསྔལ་མང་པོས་བརྗེད་པ་སྲིད་པའི་ཕྱིར་ར་རོ།",
    "དེ་བཞིན་དུ་རིམ་པ་ཇི་ལྟར་བྱ་བའི་དོར་བྱ་ལ་སོགས་པ་ལ་གོམས་པར་གྱུར་པ་ཡལ་བར་འདུག་པ་དང་པོ་ཉིད་ནས་མ་ལུས་པ་ལ་བཏང་སྙོམས་པའི་ཡང་སེམས་པ་༥ནི།",
    "༡དེ་ཡང་དེ་༡ཚེ་ཡོད་ན་རྟོག་པ་དང་བཅས་པའམ་ཅིག་ཤོས་ཀྱང་རང་རིག་པ་ཡིན་ན་རྨི་ལམ་གཞན་བཞིན་དུ་ཅིའི་ཕྱིར་དྲན་པར་མི་འགྱུར།",
    "ཡང་ན་ལུས་བཞིན་དུ་གཞན་གྱི་སེམས་ཀྱང་རྟེན་མ་ཡིན་ཏེ་དེ་ལ་ཁྱད་པར་མེད་ཀྱང་རང་གོམས་པའི་ཁྱད་པར་གྱིས་ཁྱད་པར་མ་ཡིན་པའི་ཕྱིར་ར་རོ།",
    "དེ་ཐ་དད་པ་ཡང་རང་བཞིན་ཐ་ད་ད་པའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་ར་རོ།",
    "འགའ་ཞིག་ནི་འདི་ན་འདུག་པ་ཉིད་ཅེས་བྱ་བ་སྟེ་རྒྱུན་གྱིས་ས་སོ།",
    "དེ་དེས་དབེན་པའི་ངོ་བོ་ཁོ་ན་ཡིན་པའི་ཕྱིར་ཤེས་པ་ཡིན་ཏེ་དེ་ལ་རུང་བའི་ཡུལ་ཅན་རྣམས་ཀྱིས་མི་ཤེས་ཀྱང་རང་ཉིད་ཤེས་པའི་ཕྱིར་རོ།",
    "ཁྲི་ལ་འདུག་པ་ལ་ཁྲིའི་སྒྲ་ལྟ་བུའོ་༨ཞེས་ཟེར་བ་ན།",
    "ཁྲི་དང་དེ་ལ་འདུག་པ་ཁོ་ན་བཞིན་དུ་རྡུལ་ཕྲ་རབ་དང་དེའི་ཕྲད་པ་དག་སོ་སོར་སྣང་བ་ཐ་དད་པར་འགྱུར་ལ་དེ་རྣམས་རྟག་ཏུ་མ་༦དམིགས་པ་ཡིན་ན་གཟུགས་བཞིན་དུ་དམིགས་བྱ་ཡིན་པར་ཉེ་བར་བཏགས་པ་མ་ཡིན་ནོ།",
    "ཡོན་ཏ་ན་ནི་ཡོན་ཏན་ཅན་གྱི་ཁྱད་པར་མཚོན་པར་བྱེད་པ་ཡང་རང་ཡོངས་སུ་གཅོད་པས་མཚོན་པར་བྱེད་པ་ཡིན་གྱི་གཞན་མཚོན་པར་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་དུ་མའང་གཅིག་དུས་ཅན།",
    "འདི་ཡང་རང་ཡིན་ལ་རིགས་ཀྱང་ཡིན་ལ་ཞེས་བྱ་བའི་ཤེས་པའི་ནུས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་ཚེ་ཡང་དེའི་རྒྱུ་དང་འབྲས་བུ་ད་ང་རང་བཞིན་དང་ད་བྱེ་བ་རྣམས་ཀྱི་འབྲེལ་པ་ནི་འབྲས་བུ་ད་ང་རྒྱུ་ཉིད་དེ་རིགས་༢༢པ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཁ་ཅིག་ཏུ་སྔ་ན་ཡང་རང་ཉིད་ཁོ་ན་མེད་པ་ཡིན་ཏེ།",
    "རྒྱུ་ནི་༥ཡལ་བར་འདུག་པའི་གན་ས་སྐབས་ན་ལྷན་ཅིག་བྱེད་པ་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ནི།",
    "ཡང་དག་དོན་དང་རང་བཞིན་ཞེས་བྱ་བའི་ཚིག་གཉིས་ནི་གསལ་བར་མི་ནུས་པ་ཉིད་ད་ང་འབད་པ་མེད་པ་ལ་རྒྱུ་བསྟན་པ་ཡིན་ནོ།",
    "པོར་རྟོགས་༢པར་བྱེད་དེ་ཉམས་སུ་༤མྱོང་ན་ཡང་རང་རིག་པ་ཡིན་ན་ཇི་ལྟར་ལོངས་སྤྱོད་པར་བྱེད་པར་རྟོགས་པའི་ཐུག་པ་མེད་པ་མ་ཡིན་ཏེ།",
    "བག་ཆགས་ནི་གཙོ་བོའི་རྣམ་པར་འགྱུར་བ་མ་ཡིན་གྱི་༢འོན་ཀྱང་རང་རིག་པ་བདག་ཁོ་ནའི་རང་བཞིན་ཡིན་ནོ་ཞེ་ན།",
    "༦པེ་སྣར་ཀླུ་༧སྣར་འདུགུ་༩༤༤ ༡པེ་སྣར་སོ་༢༢པེ་སྣར་ཀྱི།",
    "དུས་དེ་ཙ་ན་རྒྱ་གར་གྱི་རྒྱལ་པོ་དམག་བརྒྱ་བའི་སྲས་རྒྱལ་བུ་རུ་བ་རྐྱེས་ཞེས་བྱ་བ་སྲིད་པའི་ལྷ་དེས།",
    "ཧྥ་ཆང་རིགས་ནི་ཐུ་བྷོད་ཀྱི་འབྱུང་ཁུངས་དང་ཐད་ཀར་འབྲེལ་བ་ཡོད་པ་ཞིག་ཡིན་པ་བསྟན་འདུག་ཅིང་།",
    "ཅེས་གསུངས་འདུག་འཛམ་གླིང་ཡང་རྩེ་འབུར་དུ་ཐོན་པ།",
    "རིན་སྤུངས་ཀྱི་ས་ཆར་གཙང་རོང་ཞེས་ཟེར་སྲོལ་ཡོད་འདུག་གསུམ།",
    "ཞེས་གསུངས་པ་རྣམས་ནི་རྒྱལ་པོའི་བཀའ་ཆེམས་སོགས་ལས་དྲངས་པ་ཞིག་ཡིན་འདུག་པས།",
    "རྒྱལ་པོ་དེ་ག་དུས་བྱུང་བའི་སྐོར་ལ་ཤོད་སྟངས་སྣ་ཚོགས་ཡོད།",
    "ཡིན་ནའང་དེའི་ཁྲོད་རྒྱལ་ཕྲན་ལྔ་ཙམ་ནི་དོན་དུ་སིལ་མ་བཞི་བཅུ་ཞེས་པའི་ཁོངས་སུ་གཏོགས་དགོས་པ་ཡིན་འདུག་ཀྱང་འདིར་སིལ་མ་གང་དག་ཡིན་མིན་གསལ་པོར་གསུངས་མེད།",
    "སྒོ་ཕུག་བར་གསུམ་དུ་དབྱེ་སྲོལ་བྱུང་འདུག་ལ།",
    "གཞན་ཡང་འགའ་ཤས་ཀྱིས་ཟིང་པོ་ཞེས་པ་ཡུལ་མིང་ལ་ངོས་འཛིན་བྱས་འདུག་ནའང་།",
    "ཟིང་པ་ཞེས་པའི་ཁྱིམ་ཚང་དེའི་མི་རྒྱུད་རྣམས་ཟིང་པོ་རྗེའི་མི་རྒྱུད་ཡིན་སྐད་འདུག་ཤོད་རྒྱུན་ལྟར་ན།",
    "ཡུལ་གཅིག་ཏུ་བརྩི་བ་ཞིག་ཡིན་བཟོ་འདུག་ལ།",
    "གནའ་དུས་སུ་མྱང་དང་ཉང་གཉིས་གང་རུང་འབྲི་སྲོལ་ཡོད་འདུག་ལ།",
    "དེའི་སྐོར་དཔྱད་གཞིའི་ཡིག་རིགས་གཞན་མ་རྙེད་ལག་ཟིརད་ཅེས་པ་དེ་ཡང་ཏུན་ཧོང་གཏེར་ཡིག་ནང་མང་དུ་མཐོང་རྒྱུ་འདུག་ཀྱང་སེ་རིབ་དང་དོན་གཅིག་ཡིན་མིན་མ་ཤེས་སྟབས་ཕྱིས་སུ་མཁས་པ་རྣམས་ཀྱིས་བརྟག་པར་འཚལ།",
    "དེ་དང་ཐུ་བྷོད་དང་སུམ་པ་བཅས་ནི་ས་འབྲེལ་ཡིན་དགོས་པར་བཞེད་ཀྱི་འདུག་པ་དེ་ནི་ཅུང་འཐད་པ་ཡིན་སྙམ།",
    "བོན་གྱི་སྟོན་པ་གཤེན་རབ་ག་དུས་བྱུང་མིན་གྱི་སྐོར་དེང་སྐབས་བཞེད་པ་མི་མཐུན་པ་མང་དུ་བྱུང་བས།",
    "འོན་ཀྱང་ལྟ་བ་དེར་དོགས་པ་ཅུང་ཟད་འདུག་སྙམ་སྟེ།",
    "དེ་དག་ནི་དུས་རབས་ག་དུས་ཀྱི་ཤུལ་ཡིན་མིན་དང་།",
    "ཞེས་དམུ་ཡུལ་ནི་སྲིན་གྱི་ཡུལ་གྱི་ཤར་ལྷོའི་མཚམས་ན་ཡོད་པར་གསུངས་འདུག་ལ།",
    "ཡིན་ནའང་དེར་བདེན་པའི་ཆ་འདྲ་འདུག་སྟེ།",
    "ཞེས་དགག་པ་མཛད་འདུག་ལ།",
    "དེ་ནས་མུ་ནེ་བཙན་པོ་དགུང་ལོ་ཉི་ཤུ་རྩ་ལྔ་ལོན་ཙ་ན།",
    "ཞེས་གསུངས་འདུག་ཀྱང་།",
    "ཕོ་ཡོངས་བཟའ་སྐུ་གསར་བགྱིས་ནས་རྒྱུན་མ་ཐོགས་པར་གདའ་བ་དེ་ལ་སྙད་བྱས་ནས།",
    "ཞེས་དམུ་ཡུལ་ནི་སྲིན་ཡུལ་གྱི་ཤར་ལྷོའི་མཚམས་ན་ཡོད་པར་གསུངས་འདུག་ལ།",
    "ཡུལ་དེར་འཆིམས་ལྷ་འོད་དཀར་རམ་འཆིམས་ལྷ་ཐན་མཚོ་ཞེས་པའི་ཡུལ་ལྷ་ཞིག་ཡོད་པར་གསུངས་འདུག་པས།",
    "ས་གནས་སྟོབས་ཤུགས་སམ་ཚོ་སྟོབས་ཆེ་གྲས་ཤིག་དུས་ཡུན་རིང་པོར་བཞུགས་པ་ཡིན་ནམ་སྙམ།",
    "དེ་ཡང་གོང་ཞུས་ཞིབ་འཇུག་པ་གཉིས་པོས་བྲག་ཡིག་དེར་ལྷོ་བྲག་བྲག་བརྐོས་ཡི་གེ་ཞེས་ཟེར་གྱི་འདུག་ལ།",
    "འདྲ་པོ་ཞིག་འདུག་ལ།",
    "ཆར་ཆུའི་རྐྱེན་པས་དཀྱིལ་གྱི་ཡིག་ཕྲེང་གསུམ་པ་དང་བཞི་པ་གཉིས་ཀར་ཡི་གེ་མང་ཆེ་བ་མི་གསལ་བར་ཆགས་འདུག་འདིར་ཁོ་བོས་དེར་བྲག་ཡིག་ཁ་པ་ཞེས་བརྗོད་པ་ཡིན། ། བཙན་ཕོ་ལྷ་སྲས་གྱྀ་ཞ་སྔར།",
    "དུས་ཕྱིས་ངེས་པར་སྲུང་སྐྱོབ་གང་ལེགས་གནང་དགོས་པ་འདུག་དྲུག་པ།",
    "ཧོར་གྱི་ཡུལ་དུ་ཕྱིན་ཙ་ན།",
    "བོད་དུ་གྲུབ་ཐོབ་རྒྱུན་མི་ཆད་པར་བྱུང་འདུག།",
    "ཆུ་བོ་རི་རིན་ཆེན་སྤུངས་པ་འདྲ་འདུག།",
    "འདི་ནི་རིན་ཆེན་སྣ་ལྔའི་ཕུང་པོ་འདུག་པ་འཁོར་རྣམས་བརྣབ་སེམས་བསྐྱེད་ནས་ཡོལ་བས་བསྒྲིབས་ཤིག་གསུངས།",
    "དེའི་ཁྲིད་ན་ཤྭ་བའི་རྐང་རྗེས་ཀྱང་གསལ་པོར་རང་འདུག།",
    "ཕ་བོང་དེའི་སྟེང་དུ་གུ་རུའི་ཞབས་རྗེས་ཀྱི་རྡོ་རྗེ་རྒྱ་གྲམ་གྱི་མནན་ནས་འདུག།",
    "དེའི་ཤར་ན་བདེ་མཆོག་ཡབ་ཡུམ་གསལ་པོ་འདུག།",
    "ཡེ་ཤེས་མཚོ་རྒྱལ་གྱི་ཞབས་གཡོན་རྗེས་དམ་རྫིས་པ་ལྟར་གསལ་པོ་རང་འདུག།",
    "ཡང་དེའི་མདུན་བསེ་རུའི་རྐང་རྗེས་ཀྱང་འདུག།",
    "དྲ་ཕྱེད་མདའ་གཡབ་ཀྱི་མཚན་པ་འདུག།",
    "མཆོད་རྟེན་དེ་རྣམས་ཀྱི་ཁ་དོག་དང་མཐུན་པའི་དྲ་ཕྱེད་རིམ་པར་འབྲེལ་བ་བརྗོད་ཀྱིས་མི་ལངས་པ་འདུག་གོ།",
    "དུར་ཁྲོད་དེ་རྣམས་ལ་ཁྱི་སྤྱང་ཡིན་ཟེར་བའི་ཁྱི་དཀར་པོ་དང་ཁྲ་བོ་དང་བཅས་ཡིད་དུ་འོང་བ་མང་པོ་འདུག།",
    "དུར་ཁྲོད་དེ་རྣམས་ལ་རྒྱུ་རྡོ་ལས་གྲུབ་པའི་མཆོད་རྟེན་རང་བྱོན་ཡང་འདུག།",
    "ཆུ་ཕྲན་ལ་སོགས་པ་ཡང་འདུག།",
    "བྱ་རིགས་མི་གཅིག་པ་སྣ་ཚོགས་པ་འདུག་གོམ་བཏབ་པའི་ལོ་ཏོག་ཡིན་ཟེར་བའི་ལྗངས་པ་སེར་ཚོམ་མེ་བ་སྤུངས་འདུག།",
    "གྲུབ་ཟས་ཀྱི་ཤིང་ཏོག་མང་པོ་ཟ་རྒྱུ་ཡོང་བ་ཡོད་གསུངས་འདུག།",
    "གནས་རི་ནི་གཞལ་ཡས་ཁང་དེའི་བར་སྣང་ལ་འདུག།",
    "རོ་ཤིན་ཏུ་ནས་མངར་བ་འདུག།",
    "དེའི་སྐབས་སུ་ཡོང་ཟེར་བ་ཡིན་འདུག།",
    "འདི་ནི་དག་པའི་ཞིང་ཁམས་པདྨ་འོད་དངོས་ཡིན་འདུག།",
    "མཐོང་ཞིང་དཀར་ལ་ཞི་བའི་ཚུལ་དུ་འདུག།",
    "དེ་ཡི་གཡས་རི་འཇམ་དབྱངས་གནས་སུ་འདུག།",
    "གཡོན་རི་ཕྱག་ན་རྡོ་རྗེའི་གནས་སུ་འདུག།",
    "ཞང་ཞུང་རང་ནས་བྱུང་བ་ཞིག་དང་།",
    "ཞེས་དམུ་ཡུལ་ནི་སྲིན་ཡུལ་གྱི་ཤར་ལྷོའི་མཚམས་ན་ཡོད་པར་གསུངས་འདུག་ལ།",
    "ཡུལ་དེར་འཆིམས་ལྷ་འོད་དཀར་རམ་འཆིམས་ལྷ་ཐན་མཚོ་ཞེས་པའི་ཡུལ་ལྷ་ཞིག་ཡོད་པར་གསུངས་འདུག་པས།",
    "གཉའ་ཁྲི་བཙན་པོ་བོད་ཀྱི་སོ་མཚམས་སུ་སླེབས་ཙ་ན།",
    "ང་རང་ངོས་ནས་བརྗོད་ན།",
    "དམག་སྒར་ཡོད་ས་དེར་ངེས་པར་དུ་སྤ་སེ་ཞུ་དགོས་པ་དེ་འདྲ་ཞིག་ཡིན་བཟོ་འདུག་ལྷག་པར་དུ་ཀ་ལོན་སྦུག་ལ་སླེབས་དུས་ལམ་བར་དུ་ཞུས་པའི་སྤ་སེ་ཆ་ཚང་ཕར་ལ་ངོ་སྤྲོད་བྱེད་དགོས།",
    "སྐུ་ཞབས་མཆོག་ནས་གནའ་དུས་ཀོང་པོ་རོང་ནས་སྤོ་བོའི་བར་གྱི་ཁལ་འམ་སྐྱོ་ཤོས་ཡིན་གསུངས་ཀྱི་འདུག་པས།",
    "ཨ་ཇོ་ཕ་ཡུལ་མི་དྲནཞེས་ཟེར།",
    "ང་རང་དེར་ཕྱིན་ནས་ལས་ཀ་སྒྲུབ་པའི་གོ་སྐབས་བྱུང་།",
    "སྤྱི་ལོ་ལོར་ང་རང་ཐོག་མར་བོད་རིག་པར་ཞིབ་འཇུག་བྱེད་པའི་ལས་སུ་ཞུགས་མགོ་ཚུགས་པ་ཡིན།",
    "ང་རང་བྱ་བར་ཞུགས་མ་ཐག་པའི་སྐབས་སུ།",
    "ང་རང་ནམ་རྒྱུན་དེ་ལ་བལྟ་རུ་ཕྱིན་པ་ཡིན།",
    "གཉིས་པ་ནི་སྐྱ་རྩིག་དུས་ལྷག་མ་ཕྱིར་བསྡུའི་ལག་རྩལ་བཀོལ་ཡོད་པ་དེ་ཡིན།",
    "ཡིན་ཡང་ད་ལྟ་ཅུང་རང་སྣང་གང་ཤར་དུ་འགྱུར་བཞིན་ཡོད།",
    "ཡིན་ན་ཡང་རང་ཉིད་རང་སྣང་གང་ཤར་དུ་གྱུར་བ་ཡིན་མིན་ནི་མི་ཤེས།",
    "བོད་སྐད་དུ་རྒྱང་རིང་ནས་ཡོང་བའི་གནས་སྐོར་བ་ལ་ཨ་ཇོ་ཞེས་ཟེར་བ་དང་།",
    "དུས་རབས་གོང་མའི་ལོ་རབས་ལྔ་བཅུ་ནས་བཟུང་ཁྱེད་རང་གསར་བརྗེའི་ལས་འགུལ་ནང་ཞུགས་ཚུལ་གྱི་གནས་ཚུལ་གང་འདྲ་ཡིན་ནམ།",
    "ང་རང་ཆུང་དུས་ནས་བསམ་བློ་གཏོང་རྒྱུར་དགའ་པོ་ཡོད།",
    "དེ་ཚོ་ཀློག་དུས་ངའི་ཚིག་མཛོད་དེས་ཕན་པ་ཏོག་ཙམ་ཡོད་ཀྱང་ཚིག་མཛོད་དེར་ད་དུང་སྐྱོན་ཆེན་པོ་ཡོད།",
    "ཁྱེད་རང་སྔོན་མར་ཕྱི་རྒྱལ་གྱི་ཞིབ་འཇུག་པ་དང་མཉམ་དུ་བཙན་ལྷའི་ཡུལ་སྐད་མྱུར་སྐྱོབ་ཀྱི་ལས་ཀར་ཞུགས་མྱོང་ཡོད་འདུག་པས་ལས་ཀ་དེར་ཞུགས་པའི་བརྒྱུད་རིམ་དང་གྲུབ་འབྲས་སྐོར་ཞིག་རགས་ཙམ་ངོ་སྤྲོད་གནང་ན་འགྲིག་གམ།",
    "དེ་ལྟ་ན་༢བ་ཡང་རང་ཉིད་མཁས་པ་ཡི།",
    "འདི་ཡང་རང་འགྲེལ་ལས།",
    "དེའི་ཕྱིར་སློབ་དཔོན་ལེགས་ལྡན་འབྱེད་ནས་ཕྱི་རྒོལ་བ་བསྙེན་བྱེད་པ་ལ་ཡང་རང་རྒྱུད་ཀྱི་རྗེས་སུ་དཔག་པ་ནན་གྱིས་འཚང་བར་བྱེད་པ་ནི་སློབ་དཔོན་རང་ཉིད་རང་རྒྱུད་ཀྱི་རྗེས་དཔག་ལ་དགའ་བ་ཙམ་དུ་ཟད་དོ།",
    "རང་ངོས་ནས་གྲུབ་པའི་དོན་ཡང་རང་ཉིད་ཐ་སྙད་བཏགས་པའི་བཏགས་དོན་བཙལ་བའི་ཚེ་ན་རྙེད་པ་ཞིག་ལ་བྱ་དགོས་པ་ཡིན་ཏེ།",
    "དངོས་པོ་ཁོ་རང་རང་འགྲུབ་བྱེད་ཀྱི་རྒྱུ་རྐྱེན་གྱིས་བསྒྲུབས་པའི་སྒོ་ནས་དངོས་པོ་དེའི་སྡོད་ལུགས་སུ་སྐྱེ་བའི་དོན་དམ་པར་གྲུབ་པ་ཞིག་དགོས་ཏེ།",
    "འཐོབ་དཀའ་བ་འདི་ལྟ་བུ་མ་ཤེས་པར་འདུག་སྟེ།",
    "རང་རང་ལ་དེ་འདྲ་འཐོབ་པ་ལ་རྒྱུ་ཅི་འདྲ་དགོས་ངོ་མི་ཤེས་ཤིང་གདེངས་ནི་གང་ཡང་མེད།",
    "ཕྱིས་ནས་འདི་འདྲ་འཐོབ་པ་ཤིན་ཏུ་དཀའ་ཞེས་ལན་ཅིག་མ་ཡིན་པར་གསུངས་འདུག་པ་ནི།",
    "རང་ལའང་དེ་འདྲའི་སེམས་ལས་མི་འདུག་ན།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "བདག་ནི་མལ་ན་འདུག་བཞིན་དུ།",
    "ཕལ་ཆེར་ངན་འགྲོརསྐྱེ་བ་ལས་འོས་མེད་པ་ལྟ་བུར་འདུག།",
    "ལུས་སྦྲེབས་འདར་ཞིང་སྒུར་ནས་ཀུམ་ཀུམ་པོར་འདུག་པ།",
    "འདིར་ཡང་རང་སྲོག་མྱུར་དུ་མི་བརྟན་ཅིང་།",
    "བསྐལ་པར་འདུག་པའི་ཚེ་ཟད་ནས།"
  ]
