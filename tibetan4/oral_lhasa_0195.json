    "ཤིང་འཛམ་བུའི་གྲིབ་མས་མ་བཏང་བ་ཉིད་ཀྱང་ཀུན་ཏུ་བསྟན་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "ཤི་བ་ཀུན་ཏུ་བསྟན་པར་བྱ་བ་དང་།",
    "འཆི་བས་འཇིགས་པ་ཀུན་ཏུ་བསྟན་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "དཀར་པོའི་ཕྱོགས་ཡོངས་ིསུ་ཉམས་པར་མི་བྱ་བའི་ཕྱིར་ཏེ།",
    "སྐྱེ་བོ་རྣམས་ནི་ལྷ་རྣམས་ཀྱིས་གཉིད་ལོག་པར་བྱས་པས་ལྷ་རྣམས་ཀྱིས་ཉེས་པར་ཀུན་ཏུ་བསྟན་པའི་ཕྱིར་ཏེ།",
    "འདི་ལྟ་སྟེ་ཆོག་ཤེས་པ་ཀུན་ཏུ་བསྟན་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "སྐྲ་འདྲེག་པར་བཟོད་པའི་ལྷའམ།",
    "ལྡེམ་པོའི་ངག་ཡིན་པར་བལྟ་བར་བྱ་སྟེ།",
    "དེ་ནས་བྲམ་ཟེའི་རིགས་ཤིང་སཱ་ལ་ཆེན་པོ་ལྟ་བུའི་བུ་ལོག་པར་ལྟ་བའི་ཁྱིམ་དུ་སྐྱེས་པ་ལྔ་པོ་དེ་དག་ཆེར་འདུན་པར་གྱུར་ནས།",
    "བརྗོད་པར་གྱུར་ན་དེ་དག་ཡུན་རིང་པོར་དོན་མེད་པ་དང་།",
    "༡༤༧རྫོགས་པར་འཚང་རྒྱ་བར་ནུས་ན་ཟས་ངན་པ་ཟོས་པས་ལྟ་ཅི་སྨོས་ཏེ།",
    "དེ་ལས་རྒྱལ་བར་བྱས་ན་འདོད་པའི་ཁམས་ཐམས་ཅད་ལས་ཀྱང་རྒྱལ་བར་འགྱུར་ལ།",
    "རིགས་ཀྱི་བུ་དེ་ནས་འོད་དེས་བདུད་སྡིག་ཅན་ལ་ཡང་དག་པར་བསྐུལ་བ་ན་དེ་མྱ་ངན་གྱི་ཟུག་རྔུ་ཆེན་པོས་གཟིར་བར་གྱུར་ཏེ།",
    "ཚངས་པ་མ་གཏོགས་པར་འཇིག་རྟེན་གྱི་བྱེད་པ་པོ་གཞན་ཡང་མེད་ལ་སྟོན་པ་ཡང་གཞན་མེད་དོ་སྙམ་དུ་སེམས་པས་དེས་ན།",
    "དེ་བཞིན་གཤེགས་པས་ཧཐབས་ལ་མཁས་པ་ཡིན་པར་ཡང་བལྟ་བར་བྱ།",
    "ལྡེམ་པོའི་ངག་ཡིན་པར་ཡང་བལྟ་ིབར་བྱ་སྟེ།",
    "ཁྱེད་ཅག་ལ་ལྟ་ཅིའི་ཕྱིར་ལས་རྣམ་པར་སྨིན་པར་མི་འགྱུར་ཞེས་དེ་དག་ལ་ལས་ཀྱི་རྣམ་པར་སྨིན་པར་ཀུན་ཏུ་བསྟན་པར་བྱ་བའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་ལས་ཀྱི་རྒྱུད་སྟོན་པར་མཛད་ཀྱི།",
    "དེ་ལྟ་དེ་ལྟར་གསུང་ཞིང་དེ་ལྟ་དེ་ལྟར་ལས་ཉེ་བར་སྟོན་པར་ཡང་མཛད་དོ།",
    "རབ་ཏུ་བསྔགས་པ་རྗོད་ིཔར་ཡང་བྱེད་དེ།",
    "ཞེས་ལས་ཀུན་ཏུ་སྟོན་པར་མཛད་ཅིང་།",
    "ཡིད་ཀྱི་ལས་ཡོངས་སུ་དག་པར་འགྱུར་སྙམ་ནས་བསམས་བཞིན་དུ་ལས་ཀུན་ཏུ་སྟོན་པར་ཡང་མཛད་དོ།",
    "ཁྱེའུ་དེའི་འོ་མ་ཡོངས་སུ་དག་པར་བྱའོ།",
    "གྱི་རིག་པ་ལེགས་པར་བསླབས་པ།",
    "ཚོང་པའི་ཆ་ལུགས་ཀྱིས་གཞན་གྱི་ནོར་འཕྲོག་པ་ཞིག་ཀྱང་གྲུ་བོ་ཆེ་དེ་ཉིད་ཀྱི་ནང་དུ་ཞུགས་པར་གྱུར་ཏོ།",
    "རིགས་ཀྱི་བུ་དེ་ནས་ཚོང་པ་དེ་དག་དོན་གྲུབ་སྟེ་ཕ་རོལ་དུ་འགྲོ་འདོད་པར་གྱུར་པ་དང་།",
    "ཅི་ནས་ཀྱང་མི་འདིས་ཚོང་པ་ལྔ་བརྒྱ་ཙམ་པོ་འདི་དག་བསད་པར་མི་འགྱུར་བ་དང་།",
    "མི་འདིས་ཚོང་པ་ལྔ་བརྒྱ་ཙམ་ིཔོ་འདི་དག་ཀྱང་བསད་ིཔར་མི་འགྱུར་ལ།",
    "ཞག་བདུན་དུ་སུ་ལ་ཡང་མི་སྨྲ་བར་སེམས་པ་ལ་ཞུགས་པར་གྱུར་པ་ན་དེ་འདི་སྙམ་དུ་སེམས་ཏེ།"
  ]
}