    "ལོ་ལཱས་བར་བཅུག་གི་ཚུལ་གྱིས་དེ་ལྟར་བཤད།",
    "དཔེར་ན་རིན་ཐང་གི་ལྟ་བ་ལྟ་བུ།",
    "གལ་སྲིད་རང་ཉིད་ཆུར་བ་དང་བསྟུན་ནས་འགྱུར་ལྡོག་བྱུང་ཡོད་པ་ཡིན་ན་གནས་བབ་ད་སྐབས་ལས་ཡག་པོ་ཡོད་རྒྱུ་རེད།",
    "ཧྥེ་ལན་ཁིས་དེ་ལྟར་ལབ་སོང་།",
    "ཚང་མས་ད་དུང་ཤེས་མེད་པ་ཞིག་ནི་དེང་སྐབས་ཀྱི་ལེའུ་ཏིག་ནི་རང་གི་མི་ཚེའི་འགྱུར་ལྡོག་ཆེ་ཤོས་ཤིག་ལ་འཕྲད་འདུག་ཉེ་ལམ་ཁོ་ཆུང་མ་དང་གཉེན་ཚང་ཐོར་སོང་།",
    "ཁོས་དངོས་གནས་དཀའ་ལས་ཆེ་པོ་མྱོང་གིན་ཡོད།",
    "མེ་ཁེ་ཨེར་ན་རེ།",
    "དངོས་གནས་དེ་འདྲ་རེད།",
    "རྗེས་སུ་ངའི་ཆུར་བ་སུས་ཁྱེར་སོང་ཞེས་པའི་གཏམ་རྒྱུད་འདི་ཐོས་རྗེས།",
    "རང་ཉིད་ཀྱི་བྱ་བ་ནི་མི་ཚང་མས་ཧུར་བརྩོན་བྱེད་འདོད་པའི་ཆུར་གསར་པ་ཞིག་གི་མདུན་ལྗོངས་བཀོད་འབྲི་བྱེད་དགོས་པ་དེ་རེད།",
    "དེ་ལྟར་བྱས་ན་ང་ཚོས་ད་གཟོད་འགྱུར་ལྡོག་དང་རྒྱལ་ཁ་ལོངས་སུ་སྤྱོད་ཐུབ་མེ་ཁེ་ཨེར་གྱིས་དེ་ལྟར་བཤད།",
    "ཀུང་ཟིའི་ནང་གི་སྣམ་སྣོམ་ལྟ་བུ་དག་གིས་ཁྲོམ་རའི་འགྱུར་ལྡོག་ཕྲ་མོ་དག་སྣོམ་ཐུབ།",
    "ཁོ་ཚོས་ཀྱང་ང་ཚོར་ཁོ་ཚོ་ནི་འགྱུར་བ་དང་དུ་བླངས་ཤིང་བབ་བསྟུན་གྱིས་བསྒྱུར་བཅོས་བྱེད་པའི་ཀུང་ཟིའི་ནང་དུ་བྱ་བ་བསྒྲུབ་རྒྱུར་དགའ་པོ་ཡོད།",
    "ཀུང་ཟིའི་ཐབས་ཇུས་གསར་པ་རེ་འདོན་པའི་དུས་སུ་ཁོ་ཚོར་ལག་ལེན་ལ་ཞུགས་པའི་སྐུལ་འདེད་བྱས་པ་ཡིན།",
    "དེས་ན་ཀུང་ཟི་ནང་གི་ཧ་ཧོ་ལྟ་བུ་དག་གིས་ཅི་ཞིག་བྱེད་ཀྱིན་ཡོད་དམ།",
    "ཧ་ཅང་ཡིད་སྐྱོ་བ་ཞིག་ལ་ཧ་ཧོ་ནི་ནམ་ཡང་ང་ཚོའི་འཕེལ་རྒྱས་ཀྱི་ལམ་བུའི་ཁྲོད་ན་བཀག་རྡོ་བཞིན་གནས་ཡོད།",
    "ཡང་ན་འགྱུར་ལྡོག་དང་ལེན་བྱེད་པའི་སྤོབས་པ་མེད་མཁན་ཏག་ཏག་རེད།",
    "ང་ཚོས་བརྒྱུད་སྒྲོག་བྱེད་པའི་འགྱུར་ལྡོག་གིས་ཁོ་ཚོ་ལ་ཕན་ཅུང་ཙམ་ཐོགས་ཡོང་དུས་ཁོ་ཚོའི་ཁྲོད་ཀྱི་ཁ་ཤས་ཤིག་གིས་ད་གཟོད་བསྒྱུར་བཅོས་བྱེད་ངེས་ཡིན།",
    "ང་ཚོས་ལས་བྱེད་མི་སྣ་ཐམས་ཅད་བསྒྱུར་སྙམ་ན་ཡང་།",
    "དེ་མིན་ན་ང་ཚོ་ཚང་མ་ཉེན་ཁའི་ཀློང་དུ་ལྟུང་སྲིད།",
    "དེ་བས་ང་ཚོས་ཁོ་ཚོ་གནས་དབྱུང་མི་བྱེད་ཀ་མེད་རེད།",
    "དགའ་འོས་པ་ཞིག་ནི་ཁོ་ཚོའི་བློ་སྒོ་ཡངས་ལ་ཤེས་བྱ་གསར་པ་སློབ་པར་མོས་པས།",
    "ཁོ་ཚོ་ནི་འཛད་སྤྱོད་མཁན་དག་གི་འདོད་བློ་དང་མོས་ཕྱོགས་ཀྱི་སྐོར་གསལ་ཆ་ཡོད་པས།",
    "ང་ཚོར་རོགས་བྱས་ཏེ་མི་མང་པོ་ཞིག་གི་འདོད་བློ་དང་མཐུན་པའི་ཆུར་བ་གསར་པ་བཟོ་བཀོད་བྱ་ཐུབ།",
    "དེ་མིན་ཆུར་བ་གསར་པ་འཚོལ་བའི་གོ་རིམ་ཁྲོད་དུ་ལས་བཟོ་བ་དག་ལ་བག་ཕེབས་དང་དགའ་སྣང་གི་སེམས་ཁམས་ཤིག་ཀྱང་རང་ཤུགས་ཀྱིས་འཕེལ་གྱིན་ཡོད།",
    "ད་ལྟ་ཁོ་ཚོས་འགྱུར་ལྡོག་ལ་རེ་སྨོན་བྱེད་ཅིང་རང་འགུལ་ངང་འགྱུར་ལྡོག་འཚོལ་དུ་འགྲོ་བཞིན་གདའ།",
    "སྐབས་དེར་ལེའུ་ནཱ་ཏིག་གིས་དོགས་པ་དང་བཅས་འདི་ཐམས་ཅད་སྒྲུང་གཏམ་ཐུང་ངུ་འདི་ཁོ་ནར་རག་ལས་པ་རེད་དམ་ཞེས་དྲིས།",
    "ང་ངོ་མ་ཧ་ཧོ་དང་འདྲ་པོ་འདུག་ང་ལ་མཚོན་ན་སྒྲུང་གཏམ་ནང་ནས་ཆེས་སེམས་འགུལ་ཐེབས་ས་ནི་ཅ་ཅོས་རང་ཉིད་ཀྱི་སྐྲག་སྣང་ལ་ཁྲེལ་དགོད་བྱས་ཏེ་ཆུར་བ་གསར་པ་རྙེད་ནས་ལོངས་སུ་སྤྱོད་པའི་འཆར་སྣང་ཞིག་རྟོག་བཟོ་བྱས་ཚུལ་དེ་རེད།",
    "ཧྥེ་ལན་ཁིས་གད་མོ་དགོད་བཞིན་དེ་ལྟར་བཤད།",
    "རང་གི་ལས་གནས་མི་ཤོར་བའི་ཆེད་དུ་ཡིན་རྒྱུ་རེད།",
    "བསམ་ཚུལ་དུ་ཁོ་མོས་ང་ཚོར་སྣེ་ཁྲིད་དེ་འཚོལ་འདོད་པའི་ཆུར་བ་གསར་པ་ནི་ཅི་ཡིན་ཆ་མི་འཚལ་ཞིང་།",
    "ཁྱོད་ཀྱིས་ཆུར་བ་གསར་པའི་བཟང་ཆ་ཤེས་རྗེས་སྔར་ལས་ལྷག་པའི་སྤྲོ་སྣང་ཞིག་སྐྱེས་ཏེ་རང་ཉིད་བསྒྱུར་བཅོས་བྱེད་འདོད།",
    "གནས་ལུགས་འདི་ལྟ་བུ་ནི་རང་གི་འཚོ་བའི་ཁྲོད་དུ་སྤྱད་ནའང་ཆོག་གི་སྙམ།",
    "ངས་ཁོ་ཚོ་ལ་ཆུར་གསར་པའི་མདུན་ལྗོངས་ཤིག་འཆར་བཀོད་བྱེད་མ་ཐུབ་པར་ལན་རེད།",
    "ཆེས་ཐོག་མར་ལྷིང་འཇགས་དཀྲོག་མཁན་ཅེ་ཤེའུ་ཁཱ་རེད།",
    "ད་བར་དུ་ང་ཚོས་བགྲོ་གླེང་བྱས་པ་ཐམས་ཅད་ལས་གནས་སྐོར་གྱི་བསམ་ཚུལ་རྐྱང་རྐྱང་རེད།",
    "གཏམ་རྒྱུད་འདི་ཉན་པའི་རྗེས་སུ་ངས་རང་ཉིད་ཀྱི་རྡུགས་ཐུག་གི་འཚོ་བ་དེ་དྲན་འོངས།",
    "ངས་བསམ་ན་བདག་གི་ད་ལྟའི་ཁྱིམ་ཚང་འདི་ཆུར་བ་རྙིང་བ་ཞིག་རེད།",
    "ཁའོ་རེས་རང་གི་ལྟ་ཚུལ་དྲང་མོར་བཤད།",
    "ཟུར་གཞན་ཞིག་ནས་བསམ་བློ་བཏང་ན་ཆུར་རྙིང་ནི་ཁྱིམ་ཚང་མ་ཡིན་པར་རང་ཉིད་ཀྱི་བྱ་སྤྱོད་རྙིང་བ་དག་རེད།",
    "དེ་བས་དོན་དངོས་སུ་ང་ཚོས་བསྒྱུར་དགོས་པ་ནི་གཉེན་ཉེ་དབར་གྱི་འབྲེལ་བར་གནོད་སྐྱེལ་མཁན་ནི་བྱ་སྤྱོད་རྙིང་པ་དག་རེད།",
    "དེས་རྐྱེན་གྱིས་ང་ཚོས་ཕྱོགས་ཡོངས་ནས་ལྟ་ཚུལ་གསར་པ་དང་བྱ་སྤྱོད་གསར་པ་དག་ལ་བསྟར་བྱས་ནས་གཉེན་ཉེའི་འབྲེལ་བ་བསྒྱུར་རྒྱུར་དམིགས་དགོས་པ་རེད།",
    "ཁའོ་རེས་ཧ་ལས་པའི་ངོ་མདངས་དང་བཅས་ཏེ་གནམ་རྒན་མ།",
    "ཆུར་བ་གསར་པ་ནི་ངེད་བཟའ་ཟླ་གཉིས་ཀྱི་འབྲེལ་བ་གསར་པ་དེ་རེད་ཅེས་སྨྲས།",
    "གལ་སྲིད་རང་གི་བྱ་སྤྱོད་རྙིང་བ་དག་ལ་བསྒྱུར་བཅོས་མ་བྱས་ན།",
    "རང་ཉིད་ཀྱི་བྱ་བ་སྒྲུབ་སྟངས་རྙིང་བ་དག་ལེགས་བཅོས་བྱེད་དགོས་པ་ལས་ལས་གནས་སྤོར་དགོས་པ་དེ་མ་རེད།",
    "ངས་སྔ་མོ་ཞིག་ནས་རང་ཉིད་ལ་བསྒྱུར་བཅོས་བྱས་ཡོད་པ་ཡིན་ན་ངའི་གོ་གནས་འཕར་ཡོད་ཀྱང་སྲིད།",
    "ངས་རང་ཉིད་ལ་ཁྲེལ་དགོད་མི་བྱེད་ཀ་མེད་རེད།",
    "ངས་སེམས་ཁྲེལ་བྱེད་བཞིན་པ་ནི་རང་གི་ལྟ་སྟངས་འདིས་མངོན་ལྐོག་གང་རུང་གི་ཆ་ནས་བུ་ཕྲུག་ཚོར་ངན་ཤུགས་ཐེབས་ཡོད་སྲིད་སྙམ་པ་དེ་ཡིན།",
    "ཞིབ་འདང་རེ་བརྒྱབ་ན།",
    "ཐོག་མའི་དུས་སུ་ཁྱོད་འགྱུར་ལྡོག་ལ་འཇིགས་སྣང་སྐྱེས་མོད་ཀྱང་།",
    "ཡིན་ནའང་དེས་ཁྱོད་ལ་མཛེས་སྡུག་ལྡན་པའི་འཚོ་བ་ཞིག་སྐྱེལ་འོངས་པ་ནི་སྨོས་མེད་རེད།",
    "ཕྲུ་གུ་ནི་རང་ཉིད་གོམས་འདྲིས་སུ་སོང་ཡོད་པའི་གྲོགས་པོ་དག་དང་ཁ་བྲལ་མི་འདོད་ལ།",
    "འདི་ཐམས་ཅད་ཁོ་རང་གི་འདོད་བློ་དང་མི་མཐུན།"
  ]
