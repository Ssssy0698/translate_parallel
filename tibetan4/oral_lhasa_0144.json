    "ཁྱད་པར་དུ་གྱུར་པའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཉག་གཅིག་མངའ་བ་ཡིན་ནོ།",
    "དགྲ་བོ་རྣམས་ཀྱིས་གནོད་པར་བྱེད་པའང་མི་མངའ་སྟེ།",
    "རྣམ་པར་དག་པའི་ལྷ་ནི་འདི་ལྟ་སྟེ།",
    "རྣམ་པར་དག་པའི་ལྷ་ནི་འདི་ལྟ་སྟེ།",
    "ཞེས་གསུངས་པ་དང་།",
    "ཇི་ལྟར་མི་འགའ་ཞིག་ཉེས་པར་སྤྱོད་པ་ལ་མི་མ་ཡིན་པ་ཞེས་བྱ་བ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་ལྷ་མ་ཡིན་རྣམས་ཀྱང་ལྷའི་འགྲོ་བས་བསྙུས་པར་བལྟ་བར་བྱའོ།",
    "གསུམ་པ་ནི་སྒྲ་གཅན་གྱི་འོག་དཔག་ཚ་ཉི་ཁྲི་ཆིག་སྟོང་འདས་པ་ན་ལྷ་མ་ཡིན་གྱི་རྒྱལ་པོ་རབ་བརྟན་ཞེས་བྱ་བ་གནས་སོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་ཤིང་ལ་གནས་སོ།",
    "མྱ་ངན་ལས་འདས་པའི་འགྲམ་དུ་འཇོག་པར་བྱེད་པ།",
    "ཆར་ཆེན་པོའི་རྒྱུན་ཐིགས་པ་ཤིང་རྟའི་འཕང་ལོ་ཙམ་ཕབ་ནས་མེ་གསོད་པར་བྱེད་དོ།",
    "ལས་རྣམ་པ་གཉིས་ཀྱིས་ཏེ་འདི་ལྟར་ལས་ངན་པར་སྐྱེས་སོ།",
    "ལྷའི་བུ་ཀུན་ཏུ་འོད་དང་གཙང་མཆོག་ལ་སོགས་པ་ལྟ་བུའོ།",
    "གནོད་སྦྱིན་ནི་ཚེ་སྔ་མ་ལ་སྦྱིན་པ་ཆེན་པོ་ལེགས་པར་བཏང་བའམ།",
    "དྲི་ཟ་ནི་ཚེ་རབས་སྔ་མ་ལ་ཞེ་སྡང་ཅུང་ཟད་དང་བཅས་ལ་རྟག་པར་སྦྱིན་པའི་ལེགས་པར་བསྟབ་པ་དང་།",
    "དེ་རྗོསེམས་ཡང་དག་པ་ཉིད་དུ་མ་གྱུར་པར་ལོག་པར་སྟོན་པ་རྣམས་ཀྱི་རྗེས་སུ་འབྲང་བའི་ཕྱིར་ལུས་འདི་བླངས་པ་ཡིན་ནོ།",
    "ཁོང་ཁྲོ་བ་ལ་དགའ་བའི་ཕྱིར་ལུས་འདི་བླངས་པ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "ཡོངས་སུ་དག་པའི་རྣམ་པར་རིག་པས་བཟུང་ནས་ཞིང་ཡོངས་སུ་དག་པ་བརྒྱན་པའི་ཕྱིར་སྣང་བས་འགལ་བ་མེད་དོ།",
    "འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་འཁོར་སྟོང་དང་བྱས་པ་སྤྲུལ་ནས་བསྟན་པ་བཞིན་ནོ་ཞེས་འབྱུང་སྟེ།",
    "ཇི་ལྟར་ཟས་ཡོད་པར་འགྱུར།",
    "ཇི་ལྟར་ཁྱེད་ཀྱི་གཞུང་ལས་གཟུགས་མེད་པ་ལ་སོགས་པར་སྐྱེས་པ་རྣམས་ཟག་པ་མེད་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་ལ་ཡང་ཟས་ཞེས་བརྗོད་པ་དང་འདྲའོ།",
    "སྐུ་ཡོངས་སུ་འཛིན་ཅིང་འཇིག་པར་མི་འགྱུར་བ་དང་།",
    "བསམ་གཏན་གྱི་དགའ་བའི་ཟས་སོ་ཞེས་གསུངས་ཏེ།",
    "ཅེས་གསུངས་སོ།",
    "སློབ་དཔོན་ཉེ་བའི་འོད་ཀྱིས་བྱས་པའི་འགྲེལ་པ་ལས།",
    "ཚེ་ཕྱི་མ་ལ་ཕན་འདོགས་པར་འགྱུར་བ་ནི་ཕན་པའོ།",
    "གནོད་པ་ཞེས་བྱའི་ཚིག་ནི་མ་གསུངས་སོ།",
    "བདུད་བཞི་སྤངས་པའི་བྱེ་བྲག་ཀྱང་ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་དང་།",
    "དོན་གྱི་རྗེས་སུ་རྣམ་པར་དབྱེ་ན་དད་པ་བཅུ་ལ་གནས་པ་ཡན་ཆད་ཀྱང་ས་རྣམས་སུ་རིམ་གྱིས་ཡོངས་སུ་སྤོང་བར་བྱེད་དེ་ཅི་རིགས་སུ་སྦྱར་རོ།",
    "དྲན་པ་དང་བློ་གྲོས་དང་སྤྱོད་པ་ཆེན་པོ་རྣམ་པར་རྒྱུ་བའི་ལམ་དུ་གྱུར་པ་ཞེས་བྱ་བ་འདིས་ནི་བཅོ་ལྔ་པ་ལམ་ཕུན་སུམ་ཚོགས་པ་བསྟན་ཏོ།",
    "སློབ་དཔོན་ཉེ་བའི་འོད་ཀྱིས་འགྲེལ་པ་ལས་འདི་ལྟར་དེ་ནི་དྲན་པ་ཆེན་པོ་དང་བློ་གྲོས་ཆེན་པོ་དང་སྤྱོད་པ་ཆེན་པོ་རྣམས་རྣམ་པར་རྒྱུ་བའི་ལམ་དུ་གྱུར་པ་ཡིན་ཏེ།",
    "བགྲོད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རྣམ་པར་རྒྱུ་བའི་ལམ་ཞེས་བྱ་སྟེ།",
    "འདི་ལྟར་ཐོས་ནས་མི་བརྗེད་པར་འཛིན་པར་བྱེད་དོ།",
    "དོན་ཕྱིན་ཅི་མ་ལོག་པར་འཛིན་པའི་ཕྱིར་རོ།",
    "དོན་ཇི་ལྟ་བ་བཞིན་དུ་ལེགས་པར་བསམས་ནས་ངེས་པར་ཐོབ་པའི་ཕྱིར་རོ།",
    "ཤེས་རབ་གྱ་ནོམ་པ་རྣམ་པ་གསུམ་གྱིས་ཞིང་ཡོངས་སུ་དག་པར་ཕན་ཚུན་དུ་བགྲོད་པའི་ཕྱིར་རྣམ་པར་རྒྱུ་བའི་ལམ་ཞེས་བྱའོ།",
    "རྣམ་པར་རྒྱུ་བའི་ལམ་ཞེས་བྱའོ་ཞེས་བསྟན་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་དྲན་པ་ཆེན་པོ་ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཡིན་ཏེ།",
    "ཕྱི་རོལ་དུ་རྣམ་པར་འབྱེད་པའི་ཕྱིར་རོ།",
    "གོ་རིམས་བཞིན་དུ་དེ་བཞིན་གཤེགས་པའི་ཞིང་ཡོངས་སུ་དག་པ་རྣམ་པ་གཉིས་སུ་སྐྱེ་བར་འགྱུར་བའི་ཕྱིར་རྣམ་པར་རྒྱུ་བའི་ལམ་ཞེས་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "སློབ་དཔོན་ངོ་བོ་ཉིད་མེད་ཀྱིས་བྱས་པའི་འགྲེལ་པ་ལས་བསམས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ནི་དྲན་པ་ཆེན་པོ་ཞེས་བྱའོ།",
    "སློབ་དཔོན་ཉེ་བའི་འོད་ཀྱིས་བྱས་པའི་འགྲེལ་པ་ལས་ཞི་གནས་ནི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ཅི་རིགས་པར་མདུན་གྱི་ལམ་དུ་འགྲོ་བའོ།",
    "ངོ་བོ་ཉིད་མེད་ཀྱིས་བྱས་པའི་འགྲེལ་པ་ལས་ནི་ཞི་གནས་དང་ལྷག་མཐོང་ལ་ཞོན་ནས་ཤེས་རབ་རྣམ་གསུམ་གྱིས་ལམ་དུ་རྒྱུ་ཞིང་བགྲོད་པར་བྱ་བའི་ལམ་དུ་འགྲོ་བའོ།",
    "སློབ་དཔོན་ངོ་བོ་ཉིད་མེད་ཀྱིས་འགྲེལ་པ་ལས་ནི་པདྨ་ལེ་བརྒན་འདི་པདྨ་རྣམས་ཀྱི་ནང་ན་འདི་མཆོག་དང་ཁྱད་པར་ཅན་དུ་གྱུར་པའི་ཕྱིར།",
    "རྣམ་པར་གཞག་ཅེས་བྱ་བ་ནི་འདི་ལྟ་སྟེ།",
    "འདི་མན་ཆད་གཉིས་པ་ཡོན་ཏན་གྱི་སྤྱི་དང་ཁྱད་པར་རབ་ཏུ་བསྟན་པ་ཞེས་བྱ་བ་བསྟན་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་སྟོན་པ་གཞན་ལས་ཁྱད་པར་དུ་འཕགས་པར་བསྟན་པའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཡོན་ཏན་ཁྱད་པར་ཅན་གསུངས་པ་དང་།",
    "ང་ཟག་ཡོན་ཏན་ཅན་ཡིན་པར་བསྟན་ལ།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་ཐུགས་སུ་ཆུད་པར་བྱ་བ་ཇི་སྙེད་པ་ཡོད་པ་ཐམས་ཅད་ཡང་དག་པར་ཐུགས་སུ་ཆུད་པའི་བློ་མངའ་བའི་ཕྱིར་དང་།",
    "ཐུགས་སུ་ཆུད་པར་བྱ་བ་ཐམས་ཅད་ལེགས་པར་རྫོགས་པར་ཡང་དག་པར་ཐུགས་སུ་ཆུད་པའི་བློ་མངའ་བའི་ཕྱིར་དང་།",
    "ཇི་ལྟ་བ་བཞིན་དུ་ཡོད་པ་དང་ཇི་སྙེད་ཡོད་པ་ཐམས་ཅད་ཡང་དག་པར་ཐུགས་སུ་ཆུད་པའི་བློ་མངའ་བའི་ཕྱིར་རོ་ཞེས་འབྱུང་ངོ།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་ཀྱི་ཤེས་བྱ་མཐའ་དག་མ་ལུས་པར་བསྡུས་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་ཡོད་པ་ནི་དེ་བཞིན་ཉིད་བདུན་ལ་སོགས་པའོ་ཞེས་གསུངས་པ་ཡིན་ནོ་ཞེའོ།",
    "ཀུན་ཏུ་སྤྱོད་པ་གཉིས་མི་མངའ་བ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་ཡོན་ཏན་གྱི་ཁྱད་པར་བསྟན་ཏོ།",
    "ཡོད་པ་དང་མེད་པའི་དེ་བཞིན་ཉིད་མཆོག་ཏུ་རྣམ་པར་དག་པར་འཇུག་པར་མཛད་པའི་ཡོན་ཏན་དང་།",
    "ཐེ་ཚོམ་གཅོད་པའི་ཡོན་ཏན་དང་སྤྱོད་པ་སྣ་ཚོགས་ཀྱིས་འཇུག་པར་མཛད་པའི་ཡོན་ཏན་དང་།",
    "ཕྱིས་ནི་ཡོན་ཏན་དང་སྦྱར་བས་བསྟན་པར་རིག་པར་བྱའོ།",
    "འདི་ནི་ཤེས་བྱ་ལ་ཤིན་ཏུ་སྒྲིབ་པ་མེད་པར་འཇུག་པའི་ཡོན་ཏན་ཞེས་བྱ་བ་ཉིད་དོ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་ཐག་རིང་པོ་དང་ཉེ་བ་ཀུན་མཁྱེན་ཅིང་གཅིག་ཏུ་ཐོགས་པ་མི་མངའ་བའི་ཕྱིར་ཀུན་ཏུ་སྤྱོད་པ་གཉིས་མི་མངའོ།",
    "གཞན་ཡང་དེ་ཉིད་ལས་འདི་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་ཤིན་ཏུ་སྒྲིབ་པ་མི་མངའ་བས་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "གཉིས་པས་ནི་གནས་གཉིས་ལ་ཐོགས་པ་སྤྱོད་བུཔར་ཀུན་ཏུ་སྤྱོད་པ་གཉིས་བསྟན་ཏོ།",
    "འདི་ནི་ཡོད་པ་དང་མེད་པ་གཉིས་སུ་མེད་པའི་མཚན་ཉིད་དེ་བཞིན་ཉིད་མཆོག་ཏུ་རྣམ་པར་དག་པར་འཇུག་པར་མཛད་པའི་ཡོན་ཏན་ཞེས་བྱ་བ་ཉིད་དོ།",
    "གཞོལ་བ་ནི་འཇུག་པར་གཞོལ་བའོ།",
    "ཡང་དག་པར་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་ཉིད་དེ་ནི་མཆོག་ཏུ་གྱུར་རྗོཔར་དག་པ་ཞེས་བྱ་སྟེ།",
    "དེ་བཞིན་ཉིད་དེ་ལ་ཉིད་ཀྱི་འཇུག་པ་མཛད་པ་དེ་བཞིན་དུ་གཞན་དག་ཀྱང་འཇུག་པར་མཛད་པའི་ཕྱིར་དེ་བཞིན་ཉིད་མཆོག་ཏུ་རྣམ་པར་དག་པར་འཇུག་པར་མཛད་པའི་ཡོན་ཏན་ཞེས་གསུངས་སོ་ཞེས་འབྱུང་སྟེ།",
    "གཞན་ཡང་དེ་ཉིད་ལས་འདིས་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་གདུལ་བའི་ཐབས་ཀྱིས་ཡོན་ཏན་ཁྱད་པར་དུ་འཕགས་པ་བསྟན་ཏེ།",
    "འཕགས་པ་དང་ལྷ་དང་ཚངས་པའི་གནས་པ་རྣམས་ཀྱིས་རྒྱུན་མི་འཆད་པར་ཇི་ལྟར་མཐུན་མཐུན་དུ་གནས་པས་ཉན་ཐོས་ལྟར་བསྒྲིམས་ཏེ་གནས་པ་མ་ཡིན་པ་དང་།",
    "ཁྱད་པར་དུ་འཕགས་པ་མ་ཡིན་པ་ནི་མ་ཡིན་ནོ་ཞེས་འབྱུང་སྟེ།",
    "འདིས་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་གདུལ་བྱ་ལ་སོ་སོར་རྟོག་པ་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "སློབ་དཔོན་ངོ་བོ་ཉིད་མེད་ཀྱིས་འགྲེལ་པ་ལས་གནས་ཐ་དད་པ་མི་མངའ་བ་ནི་ཐམས་ཅད་ཀྱང་ཡེ་ཤེས་རྣམ་པར་དག་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "བརྙེས་པར་གྱུར་པའི་ཕྱིར་བརྙེས་པ་ཞེས་བྱའོ།",
    "གཞན་ཡང་དེ་ཉིད་ལས་འདི་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་མི་མཐུན་པའི་ཕྱོགས་ཡོངས་སུ་སྤངས་པ་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "ཤེས་བྱའི་སྒྲིབ་པ་ཐམས་ཅད་ལས་རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་མངོན་དུ་མཛད་པའི་ཕྱིར་དང་།",
    "སྒྲིབ་པ་ཐམས་ཅད་མ་ལུས་པར་སྤངས་པའི་ཕྱིར་རོ་ཞེས་འབྱུང་ངོ།",
    "སྒྲིབ་པ་ཐམས་ཅད་སྤངས་པས་མྱ་ངན་ལས་འདས་པ་སྒྲིབ་པ་མེད་པའི་གནས་སུ་བྱོན་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "གཞན་ཡང་སློབ་དཔོན་ཉེ་བའི་འོད་ཀྱིས་འགྲེལ་པ་ལས་འདིས་ནི་བཅོམ་ལྡན་འདས་མུ་སྟེགས་ཅན་ཟིལ་གྱིས་གནོན་པ་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་ཏེ།",
    "འཇིག་རྟེན་ན་རྣམ་པར་རྒྱུ་ཡང་འདིར་རྙེད་པ་དང་མ་རྙེད་པ་ལ་སོགས་པ་ལ་རྗེས་སུ་ཆགས་པ་དང་།",
    "བསྐྱོད་པར་མི་ནུས་འགྲོགས་པར་ནུས་མ་ཡིན།",
    "འདིས་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་བདུད་ཟིལ་གྱིས་གནོན་པ་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "སྤྱོད་ཡུལ་དེ་ཉིད་སེམས་འཁྲུལ་པར་བྱེད་པའི་ཕྱིར་དང་།",
    "ཡོན་ཏན་ཇི་སྙེད་པ་དེ་དག་ལེགས་པར་ཡོངས་སུ་རྫོགས་པས་སྤྱོད་ཡུལ་ངན་པ་ཐམས་ཅད་ཀྱིས་ཀྱང་འཕྲོག་པར་མི་ནུས་ཏེ།",
    "སྤྱོད་ཡུལ་ཐམས་ཅད་ཀྱིས་འཕྲོག་པར་མི་ནུས་པའི་ཕྱིར།",
    "རྣམ་པར་གཞག་པ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞེས་བྱ་བས་ནི་ཡོན་ཏན་བརྒྱད་པ་བསྟན་ཏེ།",
    "བྱིས་པ་རྣམས་ཀྱིས་ཤེས་པར་བྱ་བ་མ་ཡིན་པས་ན།",
    "དེ་བཞིན་དུ་བྱེས་པ་ཆུང་ངུ་ལ་སོགས་པས་ཀྱང་ཁོང་དུ་ཆུད་པར་འགྱུར་བའོ་ཞེས་འབྱུང་ངོ།",
    "དེ་ལྟར་རྣམ་པར་གཞག་པ་དེ་ཡང་བྱེས་པ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་བློའི་སྤྱོད་ཡུལ་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "གཞན་ཡང་སློབ་དཔོན་ཉེ་བའི་འོད་ཀྱིས་འགྲེལ་པ་ལས་འདིས་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་དུས་གསུམ་ལུང་སྟོན་པ་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "བྱེ་བྲག་མེད་པར་ཐུགས་སུ་ཆུད་པའི་ཕྱིར་མཉམ་པ་ཉིད་ཅེས་བྱའོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "སློབ་དཔོན་ངོ་བོ་ཉིད་མེད་ཀྱིས་འགྲེལ་པ་ལས་འདི་ལྟར་གདུལ་བྱ་ཇི་ལྟ་བ་བཞིན་དུ་འཇིག་རྟེན་གྱི་ཁམས་ཀུན་ཏུ་ཁྱབ་པར་སྐུ་གཉིས་སྟོན་པས་དེ་དག་ལ་ཕན་འདོགས་པའི་ཕྱིར་རོ་ཞེས་འབྱུང་ངོ།",
    "འདིས་ནི་བཅོམ་ལྡན་འདས་དགའ་ལྡན་གྱི་གནས་ནས་གཤེགས་པ་ཀུན་ཏུ་སྟོན་པ་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "སློབ་དཔོན་ངོ་བོ་ཉིད་མེད་ཀྱིས་འགྲེལ་པ་ལས་ཡུལ་ཐམས་ཅད་ལ་ངེས་པར་ལེགས་པར་བརྙེས་པའི་ཕྱིར་དང་།",
    "གཞན་ཡང་སློབ་དཔོན་ཉེ་བའི་འོད་ཀྱིས་འགྲེལ་པ་ལས་འདིས་ནི་བཅོམ་ལྡན་འདས་ཐེ་ཚོམ་གྱི་རྣམ་པ་ཐམས་ཅད་གཅོད་པ་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "གཞན་བྱི་ཐེ་ཚོམ་གཅོད་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "གཞན་ཡང་མི་འཇིགས་པ་བཞི་བརྙེས་པའི་ཕྱིར་བདག་ཉིད་ངེས་པར་ཐེ་ཚོམ་མི་མངའ་བ་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་བརྙེས་པའི་ཕྱིར།",
    "གཞན་གྱི་ཐེ་ཚོམ་གཅོད་པར་བྱེད་པས་དེའི་ཕྱིར་ཡོན་ཏན་ཞེས་བྱའོ།",
    "འདི་ནི་སྤྱོད་པ་སྣ་ཚོགས་ཀྱིས་འཇུག་པར་མཛད་པའི་ཡོན་ཏན་ཞེས་བྱ་བ་ཉིད་དོ།",
    "སྤྱོད་པ་ཐ་དད་པ་ཡོངས་སུ་མཁྱེན་པས་ཇི་ལྟ་བ་བཞིན་དུ་ཉིད་ཀྱི་སྐུ་ཡང་ཀུན་ཏུ་སྟོན་པའི་ཕྱིར་རོ་ཞེས་འབྱུང་སྟེ།",
    "རྣམ་པར་མ་བརྟགས་པའི་སྐུ་མངའ་བ་ཞེས་བྱ་བས་ནི་ཡོན་ཏན་བཅུ་བཞི་པ་བསྟན་ཏོ།",
    "རྣམ་པར་རྟོག་པ་མི་མངའ་ཡང་སྐུ་སྟོན་པར་མཛད་པའི་ཕྱིར་རྣམ་པར་མ་བརྟགས་པ་ཞེས་བྱའོ།",
    "རྣམ་པར་མ་བརྟགས་པའོ་ཞེས་འབྱུང་སྟེ།",
    "ཇི་ཙམ་དུ་སྐུ་སྟོན་པ་དེ་དག་ཡང་དག་པ་མ་ཡིན་པ་ཀུན་ཏུ་རྟོག་པ་ལས་མ་འཁྲུངས་པའི་ཕྱིར་རྣམ་པར་མ་བརྟགས་པའོ།",
    "དང་པོས་ནི་སྐུ་སྟོན་པར་མཛད་ཀྱང་རྣམ་པར་རྟོག་པ་མི་མངའ་བའི་ཕྱིར་རྣམ་པར་མ་བརྟགས་པ་ཉིད་དུ་སྟོན་ཏོ།",
    "ཚད་ལ་སོགས་པ་ཤེས་པར་མི་ནུས་པའི་ཕྱིར་རྣམ་པར་མ་བརྟགས་པ་ཉིད་དུ་བསྟན་ཏོ།",
    "བཞི་པས་ནི་ཇི་ཙམ་དུ་སྐུ་སྟོན་པ་དག་ཡང་དག་པ་མ་ཡིན་པ་རྣམ་པར་རྟོག་པ་ལས་འཁྲུངས་པ་མ་ཡིན་པའི་ཕྱིར་རྣམ་པར་མ་བརྟགས་པ་ཉིད་དུ་བསྟན་ཏོ།",
    "སྦྱོར་བ་ལ་བརྩོན་པར་བྱེད་ཀྱི་ཉན་ཐོས་ལ་སོགས་པ་ནི་མ་ཡིན་ཏེ།",
    "གཞན་ཡང་དེ་ཉིད་ལས་འདིས་ནི་བཅོམ་ལྡན་འདས་ཀྱི་རང་བཞིན་ཀྱི་སྐུའི་ཕྱོགས་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "མཚན་ཉིད་ཐ་དད་པ་མེད་པས་དེར་གཉིས་སུ་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་མངོན་དུ་མི་འབྱུང་སྟེ།",
    "དེ་ལ་དམིགས་པའི་ཏིང་ངེ་འཛིན་ཁྱད་པར་ཅན་རྟག་ཏུ་གནས་པའི་ཕྱིར་གནས་པ་ཞེས་བྱ་སྟེ།",
    "ཁ་ཅིག་ནི་དེ་ལྟར་གནས་པར་བྱ་བའི་ཡུལ་སྨོས་ཀྱང་།",
    "ཁ་ཅིག་ནི་གནས་པར་བྱ་བ་དང་གནས་པ་ལས་ཡོན་ཏན་གྱི་མིང་རྣམ་པར་གཞག་པ་ཡིན་ནོ་ཞེའོ།",
    "དོན་གཞན་ནི་བརྡ་རྔུཕྲད་པར་ཟད་དོ།",
    "འདིས་ནི་བཅོམ་ལྡན་འདས་ཀྱི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ཕྱོགས་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "ཕན་ཚུན་འདྲེས་པར་མི་འགྱུར་ལ།",
    "ཕན་ཚུན་འདྲེས་པར་མི་འགྱུར་ཏེ།",
    "དང་པོས་ནི་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་དམ་པ་མ་འདྲེས་པར་བསྟན་ཏོ།",
    "གསུམ་པས་ནི་ཉིད་ཀྱི་ལོངས་སྤྱོད་པའི་སྐུ་མ་འདྲེས་པར་བསྟན་ཏོ།",
    "བཞི་པས་ནི་གཞན་ལོངས་སྤྱོད་པའི་སྐུ་མ་འདྲེས་པར་བསྟན་ཏོ།",
    "སྤྲུལ་པའི་སྐུ་རྣམ་པ་གཉིས་ཀྱང་འཇིག་རྟེན་གྱི་ཁམས་འདི་ན་ནི་ཡོད་ལ་འདི་ན་ནི་མེད་དོ་ཞེས་བརྗོད་པར་ཡང་མི་ནུས་ཏེ།",
    "ཡང་ན་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ཕྱོགས་མཐའ་མེད་པས་དེ་བཞིན་གཤེགས་པའི་སྐུ་རྣམ་པ་གསུམ་དེར་འཇིག་རྟེན་གྱི་ཚད་དང་འཚམ་པ་ཞུམཉམ་པར་ཀུན་ཏུ་ཁྱབ་ཅིང་གང་བ་སྟེ།",
    "གཉིས་པ་ནི་ཡང་ན་འཇིག་རྟེན་བྱི་ཁམས་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་བརྟེན་པར་བྱ་བ་དང་།",
    "འདིས་ནི་བཅོམ་ལྡན་འདས་དེ་བཞིན་ཉིད་ཐུགས་སུ་ཆུད་པའི་མཚན་ཉིད་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་ཀྱི་དབུས་དང་མཐའི་མཚན་ཉིད་ཐམས་ཅད་ཡོངས་སུ་སྤངས་པའི་ཕྱིར་དང་།",
    "དེ་ལ་འདུས་བྱས་དང་འདུས་མ་བྱས་ཀྱི་དབུས་དང་མཐའི་མཚན་ཉིད་ཐམས་ཅད་ཡོངས་སུ་སྤངས་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི།",
    "གང་འདུས་བྱས་ལ་ངེས་པར་ཡོད་དོ་ཞེས་འཛིན་པ་ནི་རྟག་པའི་མཐའོ།",
    "འདུས་བྱས་ཇི་ལྟ་བ་བཞིན་དུ་འདུས་མ་བྱས་ལ་ཡང་དེ་བཞིན་ནོ།",
    "ཡང་ན་འདུས་བྱས་དང་འདུས་མ་བྱས་ནི་མཐའ་གཉིས་ཡིན་ལ།",
    "འདིས་ནི་བཅོམ་ལྡན་འདས་འབྲས་བུའི་མཚན་ཉིད་བརྙེས་པ་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "དེ་བཞིན་གཤེགས་པའི་མཁྱེན་པས་ཕྱི་མའི་མཐའ་མུ་མཐར་བྱོན་པ་ལ་རྒྱུན་ཆད་པ་མི་མངའ་བའོ་ཞེས་འབྱུང་ངོ།",
    "ཡོན་ཏན་འདི་དག་ཕྱི་མའི་མཐའི་བར་དུ་རྟག་པར་རྒྱུན་མི་འཆད་པའོ།",
    "ཕྱི་མའི་མཐའི་མུར་ཐུག་པ་ཞེས་པས་ནི་དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་མི་ཟད་པར་བསྟན་ཏེ།",
    "དེའི་ཕྱིར་འགྲེལ་པ་དེ་ཉིད་ལས་འདིས་ནི་བཅོམ་ལྡན་འདས་ཀྱི་ཟད་པ་མི་མངའ་བའི་ཕྱིར་བྱོན་པ་ཁྱད་པར་དུ་འཕགས་པའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "ཇི་ལྟར་ནམ་མཁའ་བསྐལ་པ་འཇིག་པ་དང་འཆགས་པ་དག་ནི་ངོ་བོ་ཉིད་རྟག་པར་མི་ཟད་པ་དེ་བཞིན་དུ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡང་དག་པའི་ཡོན་ཏན་ཐམས་ཅད་ཀྱང་དེ་བཞིན་དེ་རྟག་པར་ཟད་པ་མི་མངའ་བའོ།",
    "བདེ་བའི་དངོས་པོ་རྟག་པར་མཛད་པའི་ཕྱིར་རོ་ཞེས་འབྱུང་ངོ།",
    "འཆད་པར་འདོད་པ་རྣམས་ཀྱིས་ཨྱོའཕྲལ་ལ་བླང་བ་དང་དོར་བ་ཅི་དགར་བྱོས་ཤིག།",
    "འཁོར་རྣམ་པ་འདི་གཉིས་ཀྱང་སྔར་སྒོ་རྣམ་པ་བཞིས་རྣམ་པར་བྱེ་ནས།",
    "དེ་ལ་སྒོ་རྣམ་པ་བཞི་ནི་ཡོད་པ་དང་མེད་པ་རྣམ་པར་འབྱེད་པ་དང་།",
    "དེ་ལ་ཡོད་པ་དང་མེད་པ་རྣམ་པར་འབྱེད་པ་ནི་མུ་རྣམ་པ་བཞི་ཡོད་དེ།",
    "ཡང་དག་པར་ཡོད་པ་དང་།",
    "བསྟན་པར་བྱ་བའི་སྒོ་ནས་སྔར་ཉན་ཐོས་སྨོས་པ་ཡིན་ཏེ།",
    "གཞན་ཡང་ཉན་ཐོས་རྣམས་རྟག་པར་དེ་བཞིན་གཤེགས་པའི་ཞམ་རིང་བ་བྱེད་པའི་ཕྱིར་དང་།",
    "གལ་ཏེ་དགྲ་བཅོམ་པས་དེ་ལྟར་བྱས་ན་ལྷ་དང་མི་རྣམས་ཐེ་ཚོམ་སྐྱེ་ཞིང་ཡ་མཚན་དུ་འཛིན་པས།",
    "གལ་ཏེ་ཞིང་ཡོངས་སུ་དག་པར་བཞུགས་པ་ཡིན་ན་ནི།",
    "དང་པོ་ནི་གྲངས་སྨོས་ཤིང་རྣམ་པ་རྣམ་པར་འབྱེད་པའོ།",
    "འདི་ནི་གྲངས་སྨོས་ཤིང་རྣམ་པར་འབྱེད་པའོ།",
    "ཐབས་ཅིག་ཏུ་བཞུགས་པ་རྣམ་པར་འབྱེད་པ་དང་།",
    "རྣམ་པར་གྲོལ་བ་གཅིག་ཏུ་གྱུར་པ་ནི་ལྷན་ཅིག་པ་ཞེས་བྱའོ་ཞེས་འབྱུང་སྟེ།",
    "སློབ་དཔོན་ཡང་དག་བདེན་པས་བྱས་པའི་བརྗེད་བྱང་ལས།",
    "ཤིན་ཏུ་མཐོ་ཞིང་བླ་ན་མེད་པར་གྱུར་པ་ནི་མཆོག་ཏུ་ཆེ་བ་ཡིན་ནོ།",
    "མ་མེད་ན་འཛིན་པར་མི་ནུས་པས་ལུས་མི་འགྲུབ་པའི་ཕྱིར་གསུམ་པ་མ་བསྟན་ཏོདུ།",
    "སེམས་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བ་ཤེས་རབ་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བ་ཞེས་བྱ་བས་ནི་གསུམ་པ་སེམས་དང་ཤེས་རབ་རྣམ་པར་གྲོལ་བའི་ཡོན་ཏན་བསྟན་ཏེ།",
    "མ་རིག་པ་དང་བྲལ་བའི་ཕྱིར་ཤེས་རབ་རྣམ་པར་གྲོལ་བ་ཐོབ་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་དག་ནི་འདི་སྐད་དུ་སེམས་ནི་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་སྟེ།",
    "ཡང་དག་པའི་དོན་དུ་ན་སེམས་དང་ཤེས་རབ་རང་བཞིན་གྱིས་རྣམ་པར་གྲོལ་བ་ཡིན་ནོ་ཞེའོ།",
    "འདུས་མ་བྱས་དང་མྱ་ངན་ལས་འདས་པ་ལ་རྣམ་པར་གྲོལ་བ་ཞེས་བྱ་བ་ནི་མ་ཡིན་ནོ་ཞེའོ།",
    "ཤེས་རབ་རྣམ་པར་གྲོལ་བ་ཐོབ་པར་འགྱུར་རོ།",
    "སྲེད་པ་དང་བྲལ་བའི་ཕྱིར་སེམས་རྣམ་པར་གྲོལ་བ་ཐོབ་པར་འགྱུར་རོ་ཞེའོ།",
    "སེམས་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བ་ནི་ཁམས་གསུམ་པའི་འདོད་ཆགས་ལས་རྣམ་པར་རྗོགྲོལ་བའི་ཕྱིར་ཏེ།",
    "གཏི་མུག་དང་བྲལ་བ་འཐོབ་པར་འགྱུར་ལ།",
    "དེས་འཐོབ་པའི་འདུས་མ་བྱས་ནི་རྣམ་པར་གྲོལ་བའི་ངོ་བོ་ཉིད་བྱེད་པས་རིགས་པ་དང་འགལ་བ་མེད་དེ།",
    "བསྟན་བཅོས་ལས་རྣམ་པར་མ་ཕྱེ་བའི་ཕྱིར་རོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "སེམས་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ།",
    "བཟང་པོའི་རྣམ་པར་གྲོལ་བ་དེ་ཡང་རྣམ་པ་གསུམ་སྟེ།",
    "དང་པོ་ནི་མུ་སྟེགས་ཅན་གྱི་འདོད་ཆགས་དང་བྲལ་བའི་ཕྱིར་གང་ཟག་ལས་རྣམ་པར་དབྱེ་སྟེ།",
    "ལམ་གཅིག་པས་སེམས་རྣམ་པར་གྲོལ་བ་ཡིན་གྱི་ཐམས་ཅད་ལས་མ་ཡིན་པའི་ཕྱིར་བཟང་པོ་ཞེས་མི་བྱའོ།",
    "དེ་དག་བཟང་པོ་རྣམ་པར་གྲོལ་བ་མ་ཡིན་པས།",
    "ཁ་ན་མ་ཐོ་བ་ཤིན་ཏུ་ཕྲ་བ་དག་ལ་ཡང་འཇིགས་པར་ལྟ་བ་དང་།",
    "བསྦབ་པའི་གཞི་རྣམས་ཡང་དག་པར་བླངས་ཏེ་སློབ་པའོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པ་ཞེས་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "འདི་ལྟར་ཚིག་གསུམ་པོ་དེ་དག་ཀྱང་ཐོས་པའི་ཤེས་རབ་ཀྱིས་དང་པོ་དང་བར་མ་དང་གནས་སྐབས་ཁྱད་པར་ཅན་དང་།",
    "ཐམས་ཅད་ཡོད་པར་སྨྲ་བའི་གཞུང་དང་སྦྱར་ན་མང་དུ་ཐོས་པ་རྗེས་སུ་དྲན་པ་དང་།",
    "བར་དུ་སྤྱོར་བ་ན་ཚེག་ས་ཆུང་ངུས་མཐའ་གཉིས་རྣམ་པར་སྤངས་ནས།",
    "རང་བཞིན་གྱིས་རྣམ་པར་གྲོལ་བའི་ཕྱིར་རོ།",
    "རྣམ་པར་གྲོལ་བ་མཚམས་སྦྱོར་བའི་ཕྱིར་རོ།",
    "ཚངས་པར་སྤྱོད་པ་འདི་ལྟ་སྟེ།",
    "ཚིག་འབྲུ་དང་དོན་གོམས་པར་བྱ་སྟེ།",
    "ལེགས་པར་བསམ་པ་སེམས་པ་ལེགས་པར་སྨྲ་བ་བརྗོད་པ།",
    "འཇིག་རྟེན་པ་བྱེས་པ་དག་ནི་ཉེས་པར་བསམ་པ་སེམས་པ་ཉེས་པར་སྨྲ་བ་བརྗོད་པ།",
    "དེའི་ཕྱིར་ལེགས་པར་བསམ་པ་སེམས་པ།",
    "ལེགས་པར་སྨྲ་བ་བརྗོད་པ།",
    "ལས་རྣམ་པ་གསུམ་རྣམ་པར་དག་པ་ཡེ་ཤེས་ཀྱི་རྗེས་སུ་འབྲང་བ་ཞེས་གསུངས་སོ་ཞེས་འབྱུང་ངོ།",
    "འདི་ལྟ་སྟེ་ལས་ཀྱི་མཚན་ཉིད་ཀྱིས་བྱིས་པ་ཡིན་པར་ཤེས་ལ།",
    "ལས་ཀྱི་མཚན་ཉིད་ཀྱིས་མཁས་པ་ཡིན་པར་ཤེས་ཏེ།",
    "བྱིས་པ་རྣམས་ཉེས་པར་བསམ་པ་སེམས་པ་དང་།",
    "ཉེས་པར་སྨྲ་བ་བརྗོད་པ་དང་།",
    "མཁས་པ་ནི་ལེགས་པར་བསམ་པ་སེམས་པ་དང་།",
    "ལེགས་པར་སྨྲ་བ་བརྗོད་པ་དང་།",
    "དེ་ལ་ལེགས་པར་སེམས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཡིད་དང་ངག་དང་ལུས་ཀྱི་ལས་ཡོངས་སུ་དག་པ་རྣམ་པ་གསུམ་དང་གོ་རིམས་བཞིན་ནོ།",
    "དེའི་ཕྱིར་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་ཉེས་པར་བསམ་པ་སེམས་པ་དང་།",
    "ཉེས་པར་སྨྲ་བ་བརྗོད་པ་དང་།",
    "ངེས་པར་རྟོགས་པའི་ཤེས་རབ་ཅན།",
    "ལོགས་ཤིག་ཏུ་ཤེས་རབ་རྣམ་པར་གཞག་པ་མ་ཡིན་ནོ།",
    "མཆོག་ཏུ་གཏན་ལ་འབེབས་པའི་ཕྱིར་ངེས་པར་རྟོགས་པ་ཞེས་བྱ་སྟེ།",
    "དེ་ལ་བརྟེན་ནས་མིང་རྣམ་པར་གཞག་པ་ཡིན་ནོ།",
    "དྲིས་པ་རྣམས་རྣམ་པར་གཏན་ལ་འབེབས་པ་ལ་ཡོངས་སུ་གཏུགས་པ་མེད་པའི་ཕྱིར་ཤེས་རབ་ཆེ་བ་ཞེས་བྱའོ།",
    "ཤེས་རབ་འདིས་ནི་དོན་གྱི་མཆོག་ཐོབ་པར་བྱེད་པས།",
    "ཇི་ཙམ་པ་དང་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་པར་བྱ་བའི་ཕྱིར་ཤེས་རབ་རྣོ་བ་ཞེས་བྱའོ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་འདོད་ཆགས་དང་བྲལ་བ་རབ་ཏུ་ཤེས་པའི་ཕྱིར་ངེས་པར་རྟོགས་པའི་ཤེས་རབ་ཅན་ཞེས་བྱའོ།",
    "ཤེས་རབ་དེ་ཉིད་དུས་ཡུན་རིང་པོ་ནས་ཡོངས་སུ་གོམས་པར་བྱ་བའི་ཕྱིར་ཤེས་རབ་ཆེ་བ་ཞེས་བྱའོ།",
    "གཉིས་པ་ནི་གསུམ་རྣམ་པར་གཞག་པའི་དགོས་པ་བསྟན་པ་སྟེ་གོ་རིམས་བཞིན་དུ་སྔོན་དང་མ་འོངས་པ་དང་།",
    "བརྟགས་པ་རྣམ་པར་འབྱེད་པ་སྟེ།",
    "ཟག་པ་མེད་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "མི་སློབ་པ་རྣམ་པར་འབྱེད་པ་སྟེ།",
    "གཅིག་ཏུ་མི་སློབ་པར་གཏོགས་པ་ཡིན་ཏེ།",
    "ཁྱད་པར་ཅན་གྱི་ནུས་པ་མེད་པའི་ཕྱིར་རིག་པ་རྣམ་པར་མི་གཞག་གོ།",
    "དེ་ལ་ནུས་པ་ཁྱད་པར་ཅན་འདི་ལྟ་སྟེ།",
    "ཐམས་ཅད་ཀྱང་ཡོན་ཏན་ཁྱད་པར་ཅན་རབ་ཏུ་འདྲེན་པ་དང་།",
    "ཅིའི་ཕྱིར་ཕྱི་མ་གསུམ་པོ་དག་ནུས་པ་ཁྱད་པར་ཅན་དང་ལྡན་ཞེ་ན།",
    "བསྟན་བཅོས་ཡང་དག་པར་རིག་པ་དང་།",
    "རིག་པ་གསུམ་ཡོད་པར་གསུངས་སོ།",
    "མ་རིག་པ་བཟློག་པར་ནུས་པའི་ཕྱིར་རོ་ཞེས་འབྱུང་ངོ།",
    "བཅོམ་ལྡན་འདས་ཅིའི་ཕྱིར་བསམ་གཏན་བཞི་པ་བདེ་བར་གནས་པ་ཞེས་གསུངས།",
    "ལུས་ཐམས་ཅད་དུ་ཁྱད་པར་སྐྱེས་ནས།",
