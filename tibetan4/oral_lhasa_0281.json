    "གསུམ་འདུས་པའི་དོན་གྱིས་ནི་རྣམ་པ་གསུམ་དུ་དབྱེ་བར་རིག་པར་བྱའོ།",
    "འདུས་མ་བྱས་ནི་མ་ཡིན་ནོ།",
    "བདག་མེད་པ་ཞེས་བྱ་བ་ནི་འདིར་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་ལ་བྱ་བར་རིག་པར་བྱའོ།",
    "བརྗེད་ངས་པ་ནི་རྣམ་པ་གསུམ་དུ་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་བརྗེད་ངས་པའི་རྒྱུ་ནི་ཚོར་བ་རྣམ་པར་གཞག་པར་རྣམ་པ་ལྔ་ལ་མི་རྟག་པ་ལ་སོགས་པར་ཁོང་དུ་མ་ཆུད་པ་དང་།",
    "བརྗེད་ངས་པ་མེད་པ་ཡང་རྣམ་པ་གསུམ་དུ་རིག་པར་བྱ་སྟེ།",
    "དེ་དག་ཀྱང་ཆོ་འཕྲུལ་རྣམ་པ་གསུམ་དང་གོ་རིམས་བཞིན་དུ་སྦྱར་བར་རིག་པར་བྱའོ།",
    "རྣམ་པར་གྲོལ་བ་ཡོངས་སུ་སྨིན་པར་བྱ་བའི་ཤེས་རབ་ནི་རྣམ་པ་གཉིས་ཀྱིས་ཡང་དག་པར་བཙལ་བར་བྱ་སྟེ།",
    "ཚུལ་བཞིན་དུ་ཐོས་བ་དང་བསམ་པ་ཁྱད་པར་ཅན་གྱི་ཤེས་རབ་སློབ་པའི་རྣམ་པར་གྲོལ་བ་ཡོངས་སུ་སྨིན་པར་བྱེད་པ་གང་ཡིན་པ་དང་།",
    "སློབ་པའི་ཁྱད་པར་ཅན་གྱི་ཤེས་རབ་མི་སློབ་པའི་རྣམ་པར་གྲོལ་བ་ཡོངས་སུ་སྨིན་པར་བྱེད་པ་གང་ཡིན་པའོ།",
    "སེམས་རྣམ་པར་གྲོལ་བ་ཡོངས་སུ་སྨིན་པ་ནི་རྣམ་པ་གཉིས་ཏེ།",
    "མི་སློབ་པ་ནི་དེ་ཡན་ཆད་ཡིན་པར་རིག་པར་བྱའོ།",
    "རྟག་ཏུ་གུས་པར་བྱེད་པ་དང་།",
    "འགྱོད་པ་མེད་ན་མཆོག་ཏུ་དགའ་བ་ནས་རྒྱས་པར་བདེ་བ་དང་ལྡན་ན་སེམས་མཉམ་པར་འཇོག་ནུས་སོ་ཞེས་བྱ་བའི་བར་དུ་སྦྱར་རོ།",
    "སེམས་སྒྲིབ་པ་མེད་པ་ལ་ཕན་པར་འགྱུར་བའིའོ།",
    "རྣམ་པར་གྲོལ་བ་ནི་འདི་ལྟ་བུའོ།",
    "དེ་ལ་སེམས་སྒྲིབ་པ་མེད་པ་ལ་ཕན་པར་འགྱུར་བའི་གཏམ་གང་ཞེ་ན།",
    "སྒྲིབ་པ་ལྔའི་སྒྲིབ་པ་མེད་པ་ལ་ཕན་པར་འགྱུར་བ་དང་།",
    "མ་རིག་པའི་སྒྲིབ་པའི་སྒྲིབ་པ་མེད་པ་ལ་ཕན་པར་འགྱུར་བའོ།",
    "དེ་ཐོབ་པར་བྱ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྒྲིབ་པའི་གནས་ཀྱི་འདུ་བྱེད་རྣམས་ཀྱི་ཉེས་དམིགས་ཀྱི་གཏམ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཡང་དག་པར་ཡིད་ལ་བྱེད་པ་ལ་སྦྱོར་བར་བྱེད་པའོ།",
    "དེ་ལ་འཕགས་པའི་ནི་འདུན་པ་སྐྱེད་པར་བྱེད་པའོ།",
    "སེམས་སྒྲིབ་པ་མེད་པ་ལ་ཕན་པར་འགྱུར་བའི་ནི་ཡང་དག་པར་ཡིད་ལ་བྱེད་པ་ལ་སྦྱོར་བར་བྱེད་པའོ།",
    "རྟག་ཏུ་གུས་པར་བྱེད་པ་གང་ཞེ་ན།",
    "བརྩོན་འགྲུས་བརྩམས་པ་དེ་ཡང་རྣམ་པ་ལྔར་རིག་པར་བྱ་སྟེ།",
    "ངན་དོན་གྱིས་ཀྱང་ཆོག་པར་མི་འཛིན་ཏེ།",
    "འཕགས་པའི་འཇིག་རྟེན་ལས་འདས་པའི་ཤེས་རབ་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་སྐྱེས་བུ་དམ་པ་ལ་བརྟེན་པས་ཡང་དག་པའི་གདམས་ངག་སྔོན་དུ་བཏང་ནས་འདིའི་གོ་རིམས་ཀྱིས་རྡོ་རྗེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ཐོབ་པའི་ཕྱིར་སློབ་པའི་རྣམ་པར་གྲོལ་བ་ཡང་ཡོངས་སུ་རྫོགས་པར་བྱེད་ལ།",
    "དེ་ལ་རྣམ་པར་གྲོལ་བ་གང་ཞེ་ན།",
    "མུ་སྟེགས་ཅན་རྣམས་ནི་མ་གཏོགས་ཏེ་དེ་དག་ནི་ལོག་པའི་རྟོག་པས་རྨོངས་པར་བྱས་པའི་ལྟ་བ་ངན་བ་རྣམས་ཀྱིས་སེམས་ཟིལ་གྱིས་ནོན་པས་ལྟ་བ་དེ་ལ་བརྟེན་ནས་ཁ་ཅིག་ནི་འདོད་པ་ཡོངས་སུ་ཚོལ་བར་བྱེད་དོ།",
    "བསྡུས་པ་ནི་མ་རིག་པའི་ཟག་པ་རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "གཞི་རྣམ་པ་དགུ་ལ་ཀུན་དུ་སྦྱོར་བས་ན་ཀུན་དུ་སྦྱོར་བ་དགུར་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་འདོད་ཆགས་ཀྱི་འཆིང་བས་བཅིངས་པས་བདེ་བ་ཚོར་བར་འགྱུར་བའི་ཡུལ་ལས་སེམས་ལྷག་པར་བཏང་སྙོམས་སུ་བྱེད་མི་ནུས་སོ།",
    "ཆེས་ཁྱད་པར་དུ་འཕགས་པ་བས་བདག་ཅུང་ཟད་ཙམ་གྱིས་ཆུང་ངོ་སྙམ་པའི་འགྱིང་བ་ནི་ཆུང་བའི་ང་རྒྱལ་ལོ།",
    "གཞན་གྱི་རྙེད་པ་བསྟན་པས་རྙེད་པ་ལ་ལྷག་པར་སློང་བ་ནི་རྙེད་པས་རྙེད་པར་བྱེད་འདོད་པའོ།",
    "ཡོན་ཏན་ལ་ཡིད་ཆེས་པར་གྱུར་པ་དང་།",
    "དེ་བཞིན་དུ་བཟང་པོ་རྣམས་དང་ངན་པ་རྣམས་ལ་ཡང་མཐུན་མཐུན་དུ་སྦྱར་བར་རིག་པར་བྱའོ།",
    "ཡུལ་རྣམས་ལ་ལྷག་པར་ཞེན་པ་ནི་འདོད་ཆགས་སོ།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་ལ་བརྟེན་ནས་འདུ་བྱེད་རྣམས་རྟག་པར་ལྟ་བ་ནི་སྲིད་པའི་ལྟ་བའོ།",
    "ཆད་པར་ལྟ་བ་ནི་མེད་པར་ལྟ་བའོ།",
    "མི་འདོད་པ་བཞིན་དུ་དུས་མ་ཡིན་པར་གཉིད་ཀྱིས་ཀུན་ནས་དཀྲིས་པས་ནོན་པ་ནི་སྙོམ་པའོ།",
    "སེམས་དམིགས་པ་ལ་བཏགས་པའི་ཡུར་བའི་གཉིད་ཀྱིས་ནོན་པའི་ཕྱིར་མི་རིགས་པར་འཇུག་པ་དང་།",
    "འཚོ་བ་མི་མཐུན་པ་ནི་མི་མཐུན་པར་འཇོག་པའོ།",
    "ཆགས་པའི་སེམས་ཀྱིས་འདོད་པ་རྣམས་ལ་དམིགས་ནས་ཡིད་ཀྱིས་རྟོག་ཅིང་གོམས་པར་བྱེད་པ་དང་།",
    "གཞན་གྱིས་གནོད་པ་བྱས་པའི་རྒྱུ་ལ་དམིགས་ནས་སྡང་བའི་སེམས་ཀྱིས་རྟོག་ཅིང་གོམས་པར་བྱེད་པ་དང་།",
    "རྣམ་པར་འཚེ་བའི་སེམས་ཀྱིས་གཞན་ལ་གནོད་པ་བྱ་བ་ལ་དམིགས་ནས་ཡིད་ཀྱིས་སྔ་མ་བཞིན་དུ་བྱེད་པ་ནི་རྣམ་པར་འཚེ་བའི་རྟོག་པའོ།",
    "ཡང་དང་ཡང་དུ་བྱེད་པ་དེ་ནི་རིགས་ཀྱི་འབྱོར་བ་དང་མཚུངས་པར་ལྡན་པའི་རྟོག་པའོ།",
    "མྱ་ངན་ལ་སོགས་པ་ནི་སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དེ་བས་ན་དེ་རྣམས་ཉི་ཚེ་ཀུན་ནས་དཀྲིས་པར་རྣམ་པར་གཞག་གོ།",
    "སྲིད་པ་དང་ལྟ་བ་དང་མ་རིག་པའི་ཆུ་བོ་ཡང་དེ་བཞིན་དུ་མཐུན་མཐུན་དུ་རིག་པར་བྱའོ།",
    "མུ་སྟེགས་ཅན་རྣམས་ཀྱི་ནི་ཕལ་ཆེར་ཆུ་བོ་གཉིས་སུ་རིག་པར་བྱ་སྟེ།",
    "ཕྱོགས་གཉིས་ཀྱི་ནི་ཉེ་བར་ལེན་པ་རྣམ་པ་བཞིར་རྣམ་པར་གཞག་པར་རིག་པར་བྱ་སྟེ།",
    "འདོད་པ་རྣམས་ཐོབ་པར་བྱ་བའི་ཕྱིར་དང་ལོངས་སྤྱོད་པའི་ཕྱིར་ནི་དང་པོའོ།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ཀྱི་སྙོམས་པར་འཇུག་པའི་བར་གྱི་ཕྱིར་ནི་གསུམ་པའོ།",
    "འཇུག་པ་དང་ལྡོག་པའི་སྐྱེས་བུར་རྣམ་པར་བརྟགས་པའི་རྗེས་སུ་ཐ་སྙད་འདོགས་པའི་ཕྱིར་ནི་བདག་ཏུ་སྨྲ་བ་ཉེ་བར་ལེན་ཏོ།",
    "ལྟ་བ་དང་འདོད་པ་ཕན་ཚུན་མི་མཐུན་པར་སྨྲ་བ་རྣམས་དང་།"
  ]
}