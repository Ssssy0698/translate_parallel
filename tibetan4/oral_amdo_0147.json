    "དམག་དང་ཟོར་གྱི་ལས་དགྱེས་དཔལ་ལྷམོ།",
    "གུར་མགོན་ལྕམ་དྲལ་གནོད་སྦྱིན་གནོད་སྦྱིན་མོ།",
    "མཆོག་དང་ཐུན་མོང་འདོད་དགུའི་དངོས་གྲུབ་ཀུན།",
    "ཁྱོད་ཞབས་དྲན་པ་ཙམ་གྱིས་སྩོལ་བའི་ལྷ།",
    "སྟག་བྲག་བསམ་གཏན་གླིང་གི་དགོན་གནས་འདི།",
    "འབྲལ་མེད་བདག་གི་མགོན་དང་སྐྱབསམཛོད་ལ།",
    "ད་ལྟ་ཉིད་དུ་ཐལ་བར་རློག།",
    "བདག་གི་བཅོལ་བའི་ལས་འདི་བསྐང་གསོ་རྣམས།",
    "ཐོག་མར་སྤྱན་འདྲེན་གི།",
    "སྣ་ཚོགསཆོ་འཕྲུལ་སྟོང་གི་གཟི་བྱིན་དཔུང་།",
    "བོད་ཡུལ་གངས་ཅན་ལྗོངས་འདིར་བསྟན་འགྲོ་གི།",
    "ཁྱད་པར་རིག་འཛིན་སྔགས་འཆང་བདག་ཅག་གི།",
    "རྐང་གླིང་དུང་ཆེན་འབྲུག་གི་སྒྲ་ལྟར་ལྡིར།",
    "དར་ཚོན་སྣ་ལྔས་གཡབན་བསྟན་སྲུང་ཁྱོད།",
    "སྙན་འགྱུར་དབྱངས་དང་སྣཚོགས་རོལ་མོའི་སྒྲ།",
    "ཨེ་མཧཱརཱ་ཛ་ཉེར་གཅིག་ས་པ་རི་ཝཱ་རོམཧཱ་བཉྩ་ཨ་མྲྀ་ཏ་པཱུ་ཛ་ཁཱ་ཧིཨོམཧཱརཱཛེས་པཱརི་ཝཱ་ར་མ་རིཀ་ལཱུ་ཇི་ཁཱ་ཧི།",
    "སྲུང་མ་ཁྱོད་ཀྱིས་བདག་གི་འཕྲིན་ལས་རྣམས།",
    "སྙན་ཅིང་བརྗིད་པའི་གྲངས་མེད་རོལ་མོའི་ཚོགས།",
    "ཤ་རུས་ཞལཟས་རྐང་གླིང་རོལ་མོའི་སྒྲ།",
    "སྤྲསྤྲེལ་ཁྱིམ་བྱ་མོན་ནག་ཨ་ཙར།",
    "སྟག་སྤྲེ་བྱ་རྒོད་སྤྱང་ཀི་བ་འོག་གི།",
    "གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱ་ལ་སོགས་པ།",
    "བླ་རྡོ་སྲོག་གི་འཁོར་ལོ་བཅས་པ་སོགས།",
    "རིག་སྔགས་འཆང་བ་བདག་གིས་བཅོལ་བའི་ལས།",
    "ཞེས་བདུན་ནམ་ཉེར་གཅིག་གིས་འབུལ།",
    "ཨོཾ་ཨཱ་ཧཱུྃགིས་ནང་མཆོད་འབུལ།",
    "འཕྲིན་ལས་རྒྱལ་པོ་ཁྱོད་ལ་བདག་བསྟོད་དོ།",
    "སྲིད་ཞིའི་རྒྱལ་མཚན་རྩེ་མོར་འབར་གྱུར་བརྒྱ་ཅིག།",
    "སྲིད་བའི་རྩེ་མོའི་བར་དུ་སློང་བར་མཛོད།",
    "རྒྱལ་ཀུན་གསུང་གི་ངོ་བོ་སྣང་མཐའ་ཡས།",
    "སྙན་བརྗིད་རོལ་མོའི་བྱེ་བྲག་མཐའ་ཡས་བས།",
    "མིམགོའི་ཏོག་དང་ཞིང་གི་རྒྱལ་མཚན་ཕྱར།",
    "དམག་དཔོན་རིན་ཆེན་ཡིད་འོང་བཙུན་མོ་བློན་པོ་གླང་པོ་རྟགཡུལ་ལས་རྒྱལ་བྱེད་འཁོར་ལོ་ནོར་བུ་དང་འདིས།",
    "ན་མོ་རཏཱ་ཏཱཡ་ཡུན་བསྐང་གསོ་ག་ཇིབྷོདྷིསཏཱ་ཡ།",
    "རང་གི་ཐུགས་ཀ་ནས་འོད་ཟེར་དམར་བོ་བྱུང་ལ་སྲོག་སྔགས་ལ་ཕོག།",
    "རྣམ་རོལ་ལས་བྱུང་སྟོང་གསུམ་ཁྱོན།",
    "རབ་འཇིགས་དྲག་པོའི་གཞལ་ཡས་ཁང་གི་ནང་།",
    "བརྒྱ་ཕྱེད་རློན་པའི་དོ་ཤལ་འཕྱང་ལ་འདུད་ཡི་སྡུག་སྐུ་ཡིཆ་ཤས་རེ་རེ་ནས།",
    "ནུས་པའི་བྲག་རི་ཐལ་པར་གློག་ལ་བསྟོད།",
    "སྐད་ཅིག་ཉིད་ལ་ཐལ་བར་བརླག་བརམཛོད།",
    "ཁ་བ་ཅན་འདིར་གྲགས་པའི་གུར་ཀུམ་ཕྱོགས་ཀྱི་བུ་མོའི་འགྲམ་ལྷཔར་བཀོད།",
    "ཧ་ཧའི་གད་རྒྱངས་དྲག་ཏུ་བཞད་མོ་སྲིད་པ་གསུམ་འདི་ཆེར་སྐྲག་ནས།",
    "ཨ་དོན་སྐྱེ་མེད་དབྱིངས་སུ་བྲེས་སྙམ་བདག་ཡིད་ཐེ་ཚོམ་དབྱང་ཐག་འཛིན་ཧུ་ལའི་ངག་གི་མྱུར་དུ་ཁྱབ་བས་དགྲ་བགེགས་མ་ལུས་རླག་པ་དང་།",
    "ལུས་ལ་རེག་བྱབདེ་བ་ཁོ་ནས་འཚོ།",
    "ཁྲོ་རྒྱལ་མཐུ་སྟོབས་ཁྱོད་ལ་དེང་དབབ་ཅིང་།",
    "ལྕགས་ཀྱི་ཐོལུམནམ་མཁའ་ལ་འཕྱུར་བས་བསྟན་དགྲ་ཐམས་ཅད་སྐད་ཅིག་གིས་བརླག་པར་བྱེད་ཅིང་།",
    "བྱང་ཕྱོགས་ལྕང་ལོ་ཅནནུབ་ཕྱོགས་ཕ་ཝང་ལོང་བུའིསྐུ་མཁར་ནས་སྐྱེསམཆོག་རྡོ་རྗེ་ལེགས་པ་འཁོར་དང་བཅས་པ་སྐད་ཅིག་གིས་སྤྱན་དྲངས།",
    "འཛམ་བུ་གླིང་གི་སྐྱེས་གཅིག་པུ།",
    "རབ་དམར་ཁྲག་གི་མཆོད་ཡོན་མཚོ་། ལྟར་འཁྱིལ།",
    "མྱུར་མགྱོགས་དྲེགས་པའི་ཕོ་ཉ་ཁྱོད་ལ་བསྟོད།",
    "དགོས་འདོད་ཀུན་འབྱུང་སྲུང་མ་ཁྱོད་ལ་བསྟོད།",
    "འཁོར་དང་ས་ཅད་ཡར་ངོའི་ཟླ་ལྟར་རྒྱས་མཛད་པའིབསྟན་སྐྱོང་རྡོ་རྗེ་ལེགས་བ་ཁྱོད་ལ་བསྟོད།",
    "རྒྱལ་བའི་བསྟན་སྲུང་ཆེན་པོ་ཁྱོད་ལ་བསྟོད།",
    "ཁྱོདནི་དྲག་ཤུལ་བདུད་འདུལམཐུ་རྩལ་ཅན།",
    "སྒྲུབ་མཆོག་སྐྱོང་ཞིང་ཉམས་པའི་སྲོག་གི་གཤེད་སྟོབས་ལྡན་དཔའ་བོ་ཆེན་པ་ཁྱོད་ལ་བསྟོད།",
    "སྣང་སྲིད་དྲེགས་པའི་རྗེ་བོ་ཁྱོད་ལ་བསྟོད།",
    "མཛེས་སྡུག་ལང་ཚོའི་སྐོམས་པས་གཞན་ཡིད་འགུགས།",
    "ཁྱད་པར་སྟག་བྲག་བསམ་གཏན་གླིང་མཆོག་གི།",
    "བར་གཟིགས།",
    "སྒྲུབ་གནས་སྟག་ལུང་བྲག་གི་གཞི་བདག་གི་གསོལ་མཆོད་བྱ་བ་ནི།",
    "སྙན་བརྗིད་རོལམོའི་བྱེ་བྲག་མཐའ་ཡས་པས།",
    "ལུག་ནག་སྤྱི་དཀར་འཛིནམའི་ཁྱོན་བཀང་ངས་ཞིང་།",
    "ཁྱོད་སྐུ་རབ་དཀར་གངསཀྱི་རི་བོ་ལ།",
    "གཞམས་བར་སྣང་ཁྱོན་ཀུན་ཡོངས་འགེངས་བའི།",
    "ཁྱད་པོར་སྟག་ལུང་བྲག་གི་དགོན་གནས།",
    "ལྷ་ལམ་འཛིན་མའི་ཁྱོན་བཀང་འབུལ་བནི།",
    "ལྷ་རྫས་རོལ་མོའི་བྱེ་བྲག་མཐར་ཡས་པ།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་སྒོ་ནས་ཁྱོད་ལ་བསྟོད།",
    "ཁྱོད་ལ་མཆོད་བསྟོད་གསོལ་བ་བཏབ་པའི་མཐུས།",
    "བསྟན་བརྒྱས་བའི་ལས་འདི་ཁྱོད་ཀྱིས་སྒྲུབས།",
    "ན་མོ་གུ་རུ་ཧ་ཡ་གི་ཝ་ཡ།",
    "རྒྱལ་ཀུན་གསུང་གི་ངོ་བོ་གཅིག་བསྡུས་པ།",
    "གྲངས་མེད་གནམ་སའི་ཁྱོན་ཀུན་ཡོངས་གང་བའི།",
    "ཞེས་དབེན་གནས་སྟག་བྲག་བསམ་གཏན་གླིང་གི་སྲུང་མནོརསྐྱོང་རྒྱལ་པོའི་གསོལ་མཆོད་བྱ་བའི་རིམ་པ་འདི་ནི།",
    "དགེ་སློང་འགའ་ཞིག་གི་འདོད་མོས་ལྟར་སྔོན་གྱི་ངག་རྒྱུན་དང་ཉིང་འཁྲུལ་བའི་བྱས་རྒྱལ་གསོལ་གཞན་ནས་ཁ་བསྐང་སྟེ་སྟག་བྲག་སྐྱེ་ཕྲེང་གསུམ་པ་བྷི་ཝ་གིནུའི་མིང་ཅན་གྱིས་རང་བགཤག་འདོད་དགུ་འཁྱིལ་བར་སྦྱར་བའོ།",
    "ཕན་པའི་དོན་དུ་འགྱུར་བ་མམཆིསམོད།",
    "རང་ཉིད་སྐད་ཅིག་གིས་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གྲི་གུག་དང་ཐོད་པ་འཛིན་པ་ཡུམ་དང་བཅས་པའི་སྐུར་བཞེངས་པར་གྱུར།",
