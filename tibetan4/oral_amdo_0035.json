    "སྔོན་ལ་དུང་གི་སེང་ཆུང་བླངས་ཟས་འདི་ཁོ་རང་གང་འགྲོ་འགྲོར་ཐོང་ཞིག་ཟེར།",
    "ཆ་རྐྱེན་ཐམས་ཅད་ཁང་གིས་ཟད་པ་ལ།",
    "བསེ་ཁབས་བསེ་ཆུང་གི་གཟེར་བུ་ཅན་ན་གསེར་སྲང་བཅུ་དྲུག་དང་།",
    "ཕྱི་དུས་གླང་རིའི་ལྕགས་རི་ཁེངས་པའི་ཟས་ནོར་ལ་ལོངས་སྤྱོད་དུ་འོང་གིས་ཟེར།",
    "ང་ལ་ནི་ཁྱོད་གྲོས་དང་མི་འདྲི་བར་འདུག་སྟེ།",
    "འཛུམ་ཞལ་དཀར་ཡངས་པད་མོའི་སྤྱན་མངའ་བ།",
    "ནང་གི་དགེ་སྦྱོར་ལ་འདྲི་རྒྱུ་གཅིག་ཀྱང་ཡོད་པས་དེར་ཕྱིན་ཏེ་ཞུས་པ་དང་།",
    "ཁྱོད་ཀྱིས་འཕགས་པ་ལ་བསྟོད་པ་བྱས་པའི་གཤམ་ན།",
    "སྔོན་བལ་ཡུལ་ཀྱི་རྒྱལ་པོ་འོད་ཟེར་གོ་ཆ་བྱ་བས་ལྷ་མོ་འོད་ཟེར་ཅན་བསྒྲུབས་ནས་ཀླུའི་རྒྱལ་པོ་པི་ཀ་ར་སྔོན་པོ་བྱ་བའི་སྐེ་རལ་གྲིས་བཅད་དེ།",
    "འཕགས་པ་ཤིང་ཀུན་གྱི་ལྷོ་ཤར་གྱི་ཕྱོགས་རིའི་སྟེང་གི་ལྷ་ཁང་གི་སྒོ་ལ་འབྲུག་རིས་བྲིས་པ་གཅིག་ན་ཧི་དུ་དྲུག་གུ་ལ་གཅིག་ཡོད་པས་དེ་ལ་ཞུས་ཤིག་གསུངས།",
    "ཇོ་སྲས་སྦ་བིར་བྱ་བ་ཡབ་ལོ་ཙྪ་ཤེས་པ་དུས་འཁོར་ལ་མཁས་པ་ཞིག་གིས་རྒྱ་དཔེ་མང་དུ་གནང་།",
    "ཤིང་རྟ་ལ་བདུན་སྲིད་འཕགས་བྱ་བ་འདི་ཀ་འདྲ་ལ་ཟེར་སྙམ་མོ།",
    "ས་ལ་བལྟས་པས་མི་ཁྲོམ་དཔག་ཏུ་མེད་པས་ས་གཞི་གང་བས་བར་དུ་འགྲོ་ས་མེད་པར་སོང་།",
    "ཡང་ཡང་བུད་པར་བྱས་བྱས་ནས་ད་དུང་ཧ་ཅང་སྔས་པ་སྲིད་དུས་ལ་བབ་ན་འབུད་དོ་སྙམ་ནས་དགའ་ཞིང་ཕངས་པས་སྦས་སོ།",
    "བདག་གིས་རང་གཞན་གཉིས་ཀའི་དོན་ཡང་འགྲུབ་བར་འདུག་བོད་ཀྱི་རྒྱལ་ཁམས་ཡང་སྐལ་བ་དང་ལྡན་པར་འདུག་ཡིད་འཕྱོ་སངས་ཁྱེར་ནས་ཡུན་རིང་བར་གཉིད་མེད་པ་ལས།",
    "གོ་ལ་མང་རབ་བསྔགས་འོངས་པ་ལས་བྷརོ་ཆེན་པོ་གཅིག་གི་ལྷ་ཁང་གི་རབ་གནས་ལ་སྤྱན་དྲངས་པ་དང་ལམ་ཀ་རང་དུ་ཐུག་གིས་མཇལ།",
    "རྗེ་དེ་ཉིད་ཀྱིས་ཞག་འགའ་ཞིག་ཏུ་བལ་ཡུལ་གྱི་རྣམ་གཞག་ཚ་བསྟན་པས་ཤིན་ཏུ་ལྟད་མོ་ཆེ་བ་དང་ཡིད་དགའ་བར་བྱུང་།",
    "ལུང་རིགས་གཉིས་ལ་དྲི་བ་རེ་རེ་བྱས་པས།",
    "འོན་ཀྱང་བོད་བྱ་བ་མིང་སྐམ་ལ་དགའ་བ་ཡིན་པས་ད་ལོ་ཙམ་སོང་དང་ཕྱིས་རང་ཅག་དྲན་པར་འོང་གསུངས།",
    "ད་ནི་ང་འཆི་བར་འདུག་པས་སོང་ལོང་མེད།",
    "ཡང་འདྲ་མིན་གྱི་ཁ་བསྐངས་ནས་ཚིགས་སུ་བཅད་པ་རེ་རེ་ལ་འདྲ་མིན་རེ་རེ་འབུལ་ཟེར་ནས་བརྒྱད་ཅུ་ཐམ་པ་ཕུལ་ལོ།",
    "རྗེ་མེ་ཏྲ་ཡོ་གི་བྱ་བ་གདམས་དག་ངོ་མཚར་ཅན་གཅིག་ཉམས་སུ་ལེན་ཞིང་ཡོད་པས།",
    "བཙུན་མོའི་འཁོར་མང་ཡང་མ་དད་པ་ཡེ་མ་བྱེད།",
    "ཇོ་སྲས་ཉི་མ་དེ་འཕགས་པ་འཇའ་མ་ལི་ལ་གསོལ་བ་འདེབས་ཟེར་ནས་དེར་སོང་བས།",
    "འོ་ན་རུང་གིས་རྒྱགས་བལ་ཡུལ་དུ་སླེབས་པ་དང་རྒྱ་གར་ནས་ལོག་པ་དུས་འཛ་མ་བྱའོ་ཞེས་གླེང་།",
    "སྐ་རགས་བཅིངས་པ་མ་བཀྲོལ་བར་གཉིད་དུ་སོང་བའི་རྨི་ལམ་དུ།",
    "བུད་མེད་གཞོན་ནུ་གོས་དམར་གྱོན་པ།",
    "མིང་པོ་ཁྱོད་རྒྱ་གར་དུ་འགྲོ་ན་ཕྱིས་མི་བཟློག་པར་འདུག་པ་ཟེར་ཞིང་སྐང་འདར་འདར་སྨྲའོ།",
    "འགྱུར་བར་སྨྲས་པས་སྟོན་པ་དེ་ན་རེ་དེ་ཙུག་རང་ལེགས།",
    "ངེད་ཀྱིས་དེ་སྐད་བྱས་ན་འགྲོ་མི་ནུས་པར་སོང་གིས་དོགས་ནས་སྨྲ་མ་ནུས།",
    "པཎྜི་ཏ་འདི་འདྲའི་མཁས་པ་ཐུགས་ལ་འདོགས་པ་ཕ་གིར་མི་རྙེད་ཟེར།",
    "དེ་ནས་ཕམ་མཐིང་གི་ལམ་ནས།",
    "སྔོན་བོད་སོང་བ་རྣམས་ཀྱི་རྣ་ཐོས་ལ་གསེར་མིད་ན་མི་རྙེད་བྱ་བ་དང་།",
    "དེ་ནས་ཟླ་བ་གཉིས་ཙམ་ནས་ཙ་མི་བའི་འབུལ་སྐྱེལ་བ་གསེར་དང་དར་ཟབ་ཀྱི་ཁུར་མང་པོ་སོང་བས་ཀྱང་སཱ་ར་ཅུང་མ་རྒལ་བར་བསད།",
    "དེ་མཐོང་བས་སྣང་པ་གཞའ་བཀྲའི་རི་མོ་འདི་རང་སེམས་ཀྱི་རྣམ་འགྱུར་དུ་ལྷན་གྱིས་གོ་བའི་ངེས་ཤེས་སྐྱེས།",
    "ཤར་གྱི་ཆུ་མིག་ནས་ཆུ་འཐུངས་བས་སོས་པར་འགྱུར་བའི་ལྟད་མོ་གཅིག་ཡོང་།",
    "འཕགས་པ་ཤིང་ཀུན་གྱི་མཆོད་རྟེན་ལ་འཁྲུལ་འཁོར་གྱི་གདུགས་བཀལ་བས་རང་ཉིད་སྟེང་དུ་འགྲོ་མ་དགོས་པར་སྟེང་གི་མཐོན་པོར་སླེབ་འགྲོ་བར་འདུག་ག་དེ་མཐོང་བས་ཐབས་ལ་མཁས་པའི་ལམ་གྱི་བྱ་དཀའི་ཚ་གས་ཆེན་པོ་ཚ་གས་ཆུང་ངུས་འགྲུབ་པར་ངེས་ཤེས་སྐྱེས།",
    "གུ་ལང་གསེར་ཁང་གི་ཚ་གས་རྟེན་ལ།",
    "དེ་ནས་རིམ་གྱིས་འབྱར་དུ་སོང་སྟེ།",
    "རྗེ་མེ་ཏྲ་ཡོ་གི་བྱ་བ་ཁྱེའུ་གཞོན་ནུའི་ཆ་བྱད་ཅན་མི་རང་མ་ཡིན་པར་ལྷའི་རྣམ་པ་གཅིག་འདུག་པས་འཕགས་པ་རང་བྱུང་གི་མཆོད་རྟེན་བསྐོར་དུ་སོང་།",
    "བྱང་གི་ངོས་ན་ཀླུ་སྒྲུབ།",
    "ཕྱོགས་ཀྱི་སྒོ་བཞི་ན་ཁྲོ་ཆུའི་སེང་གེ་ཆེན་པོ་གཉིས་གཉིས་སྒོ་སྲུང་གི་ཚུལ་དུ་ཡོད་དོ།",
    "རེ་ཞིག་ན་གན་ཇི་རའི་རྩེ་མོར་རྗེ་མེ་ཏྲས་སྐྱིལ་ཀྲུང་མཛད་དེ།",
    "ཕྱག་ཐལ་མོ་བརྡབས་པས་སྒོ་ཕྱེ་སྟེ་འདུད་པར་བརྩམས་པས་ལྷ་རྟེན་འདར་བར་གྱུར།",
    "ཕྱུགས་བདག་རང་བྱུང་དེའི་སྒོ་བྱང་ཕྱོགས་ངོས་ནས་བྱུང་བའི་རི་ཤིན་ཏུ་ཉམས་དགའ་ཞིང་ཡངས་པ་ནགས་ཀྱི་དཀྱིལ་མཐོངས་ཨཾ་བཱ་ར་བཱ་རི་བྱ་བའི་ནགས་ཐོ་རེ་བ་གཅིག་ན་བསིལ་ཁང་ལྡིང་མ་ལྡིང་ཐོག་ཅིག་ཡོད།",
    "རྡོ་རྗེའི་གླུ་མགུར་ངང་གིས་ལྡིར་བ།",
    "རྗེའི་ལྷ་ཁང་ནས་རང་གི་བྲང་ཁང་དུ་འོང་བའི་ལམ་དུ་ཚིགས་བཅད་བྱས་ཏེ།",
    "བར་བལ་པོའི་མཐིལ་དུ་ཐུག་གིས་མཇལ།",
