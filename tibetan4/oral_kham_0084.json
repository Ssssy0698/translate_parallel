    "བླུན་པོ་རྣམས་ཀྱི་སྤྱོད་ཡུལ་མིན་པར་གདའ།",
    "བདེ་སྟོང་རང་བཞིན་རོ་མཆོག་མྱོང་བའི་ཕྱིར།",
    "ཅི་སྟེ་རང་བཞིནམེད་པ་རྣམས་ལ་བྱ་བ་བྱེད་པ་མི་འཐད་པའི་ཕྱིར་ཉེས་པ་སོ་ན་འདུག་པ་ཉིད་དོ་སྙམ་ན།",
    "ཡང་བརྩད་པ་ལ་རང་བཞིན་གྱིས་མེད་དོ་ཞེས་རང་བཞིན་གྱིས་ཁྱད་པར་སྦྱར་བའི་ཚིག་ཙམ་ཡང་མ་ཐོས་པར་འདུག་པས་ན།",
    "ཚོར་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "སྒྲུབ་བྱེད་ཚོར་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་དང་བསྒྲུབ་བྱ་གཟུགས་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་འགོག་བྱེད་ཀྱི་རིགས་པ་མཚུངས་པའི་ཕྱིར།",
    "ས་བོན་དང་རང་བཞིན་གྱིས་གཞན་དུ་གྲུབ་པའི་ཕྱིར།",
    "ས་བོན་དང་རང་བཞིན་གྱིས་གཞན་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་དེ་ལྟར་བདེན་པ་གཉིས་ཀར་ཡང་རང་བཞིན་མེད་པས་རྟག་པ་དང་།",
    "དེའི་ཕྱིར་བདག་སྐྱེ་འགོག་པ་ལ་ཡང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་ཀྱིས་འགོག་དགོས་མི་དགོས་ལ་རྩོད་པ་ཡིན་གྱི།",
    "དེ་ཡང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་ལ་ཐ་སྙད་བཏགས་པའི་བཏགས་དོན་བཙལ་ནས་རྒོལ་ཕྱིར་རྒོལ་མཐུན་སྣང་དུ་གྲུབ་པ་དགོས་པར་ཁས་བླངས་ལ།",
    "མྱོང་དྲན་གཉིས་དང་རང་བཞིན་གྱིས་གཞན་དུ་གྲུབ་ན་ཕན་ཚུན་ལྟོས་པ་མེད་པར་འགྱུར་བས།",
    "གཉིས་པ་ལྟར་ན་ཡང་རང་མྱོང་སྒྲུབ་བམ།",
    "འདི་ལས་ཀྱང་རང་རིག་ཡོད་པ་མ་ཡིན་པས་དེ་ཉིད་ཀྱིས་དེ་འཛིན་པ་མ་ཡིན་ནོ།",
    "ཅི་ཙམ་བརྟགས་ཀྱང་རང་རྒྱུད་ཀྱི་བློ་སྔོ་འཛིན་མིག་ཤེས་རང་ལ་སྣང་བའི་ཚུལ།",
    "རང་རིག་བདེན་པར་གྲུབ་པ་འགོག་ཅིང་རང་རིག་མི་འགོག་གོ་ཞེས་ཟེར་རོ།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "རང་བཞིན་མེད་པར་སྟོན་པའི་ལུང་རྣམས་ཀྱིས་ཀྱང་རང་བཞིན་མེད་དོ།",
    "རྟགས་ཀྱིས་ཀྱང་རང་བཞིན་བཀག་པ་ཉིད་རང་བཞིན་མེད་པར་སྒྲུབ་པ་ཡིན་ནོ།",
    "ཚོར་བ་འགའ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་པར་མཐོང་བ་གོམས་པ་ན།",
    "སློབ་དཔོན་སེང་གེ་བཟང་པོ་ལ་སོགས་པ་རང་རྒྱུད་པ་རྣམས་ཀྱིས་གཉིས་ཀའང་རང་རྒྱུད་དུ་བཀྲལ་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "པས་གྲུབ་པ་དང་བརྟན་པ་དང་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་བཞི་ལས།",
    "དེའང་རང་རྒྱུད་དུ་གྱུར་པ་ལ་བདག་དང་།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "སྐྱེ་བ་དང་རང་བཞིན་དང་བཟོའི་ལས་རིས་མཐུན་པ་གསུངས་སོ།",
    "དེ་བཞིན་རྒ་བས་ཀྱང་རང་མ་ཡིན་པ་བརྒྱུད་རྙིངས་པར་བྱེད་ཅིང་།",
    "ཆ་ལས་ཕྱི་རོལ་ལྟ་བུར་འདུག།",
    "ཤེས་པ་གང་ཞིག་དུས་རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་ངའོ་སྙམ་པའི་ང་རྒྱལ་གྱི་ཁེངས་པ་དང་ལྡན་པས་རློམ་སེམས་ཤིང་།",
    "སྒོ་ངའི་ནང་ན་འདུག་པ་མིག་འགྲུབ་རུང་དང་།",
    "ཕྱི་ནང་གཉིས་ཀ་སྤྲིས་མ་ལྟ་བུར་འདུག་པ་མེར་མེར་པོར་གྱུར་པ་དང་།",
    "སྒོ་ངའི་ནང་ན་འདུག་པ་ལ་སོགས་པ་ནི་གཉིས་ཡིན་དུ་འགྱུར་ལ།",
    "ཡུལ་དང་དུས་རིང་པོ་ན་གནས་པ་ལྐོག་ཏུ་གྱུར་པ་རྣམས་ཀྱང་ད་ལྟ་དྲུང་ན་མངོན་སུམ་དུ་འདུག་པ་ལྟར་རྟོགས་ཤིང་ཤེས་པས་ན་མངོན་ཤེས་ཞེས་པའམ།",
    "ཕྱོགས་འགའ་ཞིག་ན་འདུག་པ་འདིར་ཡང་དམིགས་པ་ཡུལ་སྤྱོད་ཡུལ་དུ་གྱུར་པ་དང་།",
    "སྒོམ་ལམ་གྱིས་ཀྱང་རང་ཉིད་མི་སློབ་ལམ་གྱི་སྐལ་མཉམ་དང་།",
    "སེམས་མེད་པའི་སྙོམས་པར་འཇུག་ཁ་ཅ་པ་ཟ་མ་མའི་སེམས་ནི་ལངས་མ་ཐག་པའི་སེམས་ཀྱི་དེ་མ་ཐག་རྐྱེན་དུ་འགྱུར་བའི་ཕྱིར་རོག་དུས་ངས།",
    "ཚངས་པའི་མདུན་དུ་འདུག་སྟེ་ཚིག་འདོན་ཅིང་སྨྲ་བས་ན།",
    "རྒྱལ་པོ་སྤྱི་བོ་སྐྱེས་དང་བརྒྱ་བྱིན་གཉིས་སྟན་གཅིག་ལ་འདུག་པ་ན་མིག་འབྱེད་འཛུམ་ཙམ་མ་གཏོགས་པར་ཁྱད་པར་མི་སྣང་བར་གསུངས་པའི་ཕྱིར་རོ།",
    "མཐར་ཐུག་དུས་ནི་སྐད་ཅིག་འདོད།",
    "ལོ་གཅིག་དུས་བཞིར་འཇོག་པ་ན།",
    "བསྐལ་པ་འཇིག་དུས་ཀྱི་མེ་བས་ཀྱང་ཡང་སོས་ཀྱི་མེས་ཚ་ཞིང་།",
    "དེ་ཚེས་བཅོ་ལྔ་ལ་ཁྲུས་བྱས་ནས་གསོ་སྦྱོང་ལ་གནས་ཤིང་བློན་པོའི་ཚོགས་ཀྱིས་བསྐོར་ཏེ་འདུག་པ་ན།",
    "ཡན་ལག་རྐང་ལག་མཇུག་མ་ཟེགས་པ་རླིག་པ་འདོམས་ཀྱི་གནས་ན་འདུག་པ་དང་།",
    "བར་མཚམས་ཐམས་ཅད་མུན་པར་འདུག།",
    "ད་ལྟ་ཉིད་དུའང་འཇིག་རྟེན་གྱི་ཁམས་གཞན་དག་ནི་འཇིག་བཞིན་པར་འདུག་གོ།",
    "གཞན་དག་ནི་ཞིག་ནས་སྟོངས་པར་འདུག་གོ།",
    "གཞན་དག་ནི་ཆགས་ནས་གནས་པར་འདུག་གོ།",
    "ཅིའི་ཕྱིར་སྐྱེ་བ་སྡུག་བསྔལ་ཞེ་ན་མངལ་དུ་འདུག་པ་ན་ཟས་ཞུ་མ་ཞུའི་བར་དང་།",
    "འཆི་བ་ན་ཡང་གཞལ་མེད་ཁང་རྣམས་དང་ལྷན་ཅིག་དུས་མཉམ་དུ་འགག་པས་འཇིག་ཅིང་འཆགས་སོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འཇིག་རྟེན་ཞིག་ནས་སྟོངས་པར་འདུག་གོ་ཞེས་པ་ནི་དེའི་བར་ལ་འཕེལ་འགྲིབ་མི་འཇུག་ཀྱང་ཡུལ་མཉམ་པའོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འཇིག་རྟེན་འཆགས་ནས་གནས་པར་འདུག་གོ་ཞེས་པ་ནི།",
