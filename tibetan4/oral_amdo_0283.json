    "གནས་དང་གནས་མ་ཡིན་པར་གླེང་བར་བྱེད་པའི་གང་ཟག་དེ་དག་ཀྱང་སྤངས་ནས་ལོག་པར་ཞུགས་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དམ་པ་རྣམས་ཀྱིས་ཀྱང་ལྷག་པར་བཏང་སྙོམས་སུ་བོར་བས་ནང་གི་སེམས་ཀྱང་མ་ཞི་ལ་ལུས་དང་ངང་དང་ཡིད་ཀྱི་སྒོ་ནས་ཀྱང་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་དུ་གནས་ཏེ།",
    "དེ་ལ་ཉེས་དམིགས་པ་ཡིན་པར་མི་ཤེས་པས་ཉོན་མོངས་པ་བྱུང་བ་དང་དུ་བླངས་པའི་ཕྱིར་ཤེས་བཞིན་དུ་མི་གནས་པ་དང་།",
    "གནས་ཤིང་འདུག་པ་ན་ཟླ་མེད་པར་རབ་ཏུ་དབེན་པའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་མ་ལུས་པར་སྤངས་པ་དང་།",
    "མྱ་ངན་ལས་འདས་པ་ཤེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཤེས་པ་འདི་གཉིས་ལ་བརྟེན་ནས་སྔ་མ་བཞིན་དུ་རྣམ་པ་བཞིས་ཕན་སུམ་ཚོགས་པར་གྱུར་པའི་རབ་ཏུ་དབེན་པར་གནས་པ་ཡང་དག་པར་བླངས་ཏེ་འདུག་ན་ཉོན་མོངས་པ་ཐམས་ཅད་ལས་སེམས་རྣམ་པར་གྲོལ་བའི་མོད་ལ་དགྲ་བཅོམ་པ་ཤེས་རབ་ཀྱིས་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ།",
    "ལམ་ལ་ལམ་དུ་ཤེས་རབ་ཀྱིས་འཇུག་ཅིང་མོས་པ་ན།",
    "མོས་པ་འདི་ནི་མྱ་ངན་ལས་འདས་པ་ཤེས་པ་ཞེས་བྱའོ།",
    "བསྟན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་དོན་ཐོབ་པ་བླ་ན་མེད་པ་དང་།",
    "དེ་ཡང་ཁྱུ་མཆོག་གི་གནས་རྒྱ་ཆེན་པོ་ལ་དམ་འཆའ་བ་དང་།",
    "བསྟན་པ་དེ་ཡང་རང་བཞིན་གྱིས་ཚིག་དང་ཡི་གེ་གསལ་ཞིང་དོན་ཟབ་ལ་བསྟན་པ་ཚིག་དང་ཡི་གེ་གསལ་ཞིང་དོན་ཟབ་པ་དེའི་དོན་ཟབ་མོ་འགྲེལ་པ་འདི་ནི་བདེ་བླག་ཏུ་འཇུག་པའོ།",
    "འདས་པའི་བསྟན་པའི་གནས་ཀྱི་ལ་ཆད་པ་འདི་ནི་རང་གི་དོན་ཐོབ་པ་བླ་ན་མེད་པའོ།",
    "དེ་ལ་རང་གི་དོན་ནི་རྣམ་པ་གཉིས་ཀྱི་སྒོ་ནས་རབ་ཏུ་བྱུང་བ་འབྲས་བུ་དང་བཅས་པ་སྟེ།",
    "གནས་གསུམ་པོ་དེ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ལ་ཤེས་པ་ཕུན་སུམ་ཚོགས་པ་ནི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྒྲིབ་པ་འབྲིང་གིས་རྨོངས་པ་མེད་པས་ལུག་ལྟར་ལྐུགས་པ་མ་ཡིན་པ་དང་།",
    "དེ་བས་ན་རང་གིས་ཡང་དག་པ་ལ་ཡང་དག་པར་དམིགས་པ་ན་ཤིན་ཏུ་ངེས་པ་དང་ཐེ་ཚོམ་མེད་པར་འགྱུར་རོ།",
    "གང་དུ་ཐོས་པ་དང་ལྡན་པའི་འཕགས་པ་ཉན་ཐོས་ཞེས་སྨོས་པ་དེར་ནི་སོ་སོའི་སྐྱེ་བོ་ཡིན་པར་རིག་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གང་ཟག་གསུམ་པོ་དེ་རྣམས་ལས་བཟློག་པའི་གང་ཟག་པ་བདེ་བ་ལ་རེག་པར་གནས་པ་ཡང་གཅིག་ཏུ་ངེས་པར་བདེ་བར་གནས་པའི་དགྲ་བཅོམ་པ་དང་གསུམ་ཡོད་དོ།",
    "ཉམས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སློབ་པ་བཞི་མཐོང་བས་ནི་གཞན་ལ་དད་པས་འགྲོ་བ་མ་ཡིན་པར་སྲིད་པ་འགགས་ན་ཞི་བ་མྱ་ངན་ལས་འདས་པར་འགྱུར་རོ་སྙམ་དུ་རང་གི་འཕགས་པའི་ཤེས་རབ་ཀྱི་མིག་གིས་མཐོང་མོད་ཀྱི་འོན་ཀྱང་དེས་ནི་ལུས་ཀྱིས་མངོན་སུམ་དུ་བྱེད་པར་མི་ནུས་ཏེ།",
    "དཔེར་ན་ལ་ལ་ཞིག་སྐོམ་ནས་ཁྲོན་པ་ཟབ་མོའི་དྲུང་དུ་སོང་ན།",
    "ཐག་པ་དང་བཅུ་བའི་སྣོད་མེད་པས་ཤའི་མིག་གིས་ཆུ་མངོན་སུམ་དུ་མཐོང་དུ་ཟིན་ཀྱང་དེ་ལུས་ཀྱི་རེག་པར་མི་འགྱུར་བ་དེ་བཞིན་དུ།",
    "སློབ་པས་ཀྱང་གོང་མའི་ཉོན་མོངས་པ་སྤོང་བ་དེ་འདོད་དེ།",
    "ཤེས་རབ་ཀྱི་མིག་གིས་ཞི་བར་མངོན་སུམ་དུ་མཐོང་དུ་ཟིན་ཀྱང་དེའི་ལུས་ཀྱིས་མངོན་སུམ་དུ་བྱེད་པར་མི་འགྱུར་རོ།",
    "དགེ་སྦྱོང་གི་དོན་དུ་བྱ་བ་དང་།",
    "བྲམ་ཟེར་འདུ་ཤེས་ཤིང་བྲམ་ཟེར་ཁས་འཆེ་བར་བྱེད་ལ་འཇིག་རྟེན་ཡང་དེ་ལྟར་འཛིན་མོད་ཀྱི་འོན་ཀྱང་དེ་དག་ནི་ཀུན་རྫོབ་ཀྱི་དགེ་སྦྱོང་དང་བྲམ་ཟེ་ཡིན་གྱི་དོན་དམ་པའི་མ་ཡིན་ཏེ།",
    "མ་རིག་པའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་དང་།",
    "མ་རིག་པའི་འདུས་ཏེ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རེག་པ་དེ་ཉིད་དང་།",
    "དམིགས་པ་ཉམས་སུ་མྱོང་བའི་བདག་ཉིད་ཀྱི་རིག་པའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་དང་།",
    "དམིགས་པ་རབ་ཏུ་རྣམ་པར་འབྱེད་པའི་བདག་ཉིད་ཀྱི་རིག་པའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་སོ།",
    "དེ་ལ་རིག་པའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བའི་སྒོ་ནས་ནི་དེ་ལྟར་དེ་དག་ལ་གཞི་བཞི་བཅུ་རྩ་བཞིར་ཚོར་བར་བྱ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "རིག་པའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱི་སྒོ་ནས་ནི་གཞི་ཞི་བཅུ་རྩ་བཞི་པོ་དེ་དག་ཉིད་ལ་ཤེས་པའི་གཞི་རྣམས་ཞེས་བྱའོ།",
    "གཟུགས་མེད་པའི་བྱེ་བྲག་གིས་ནི་གོ་རིམས་བཞིན་དུ་འཕེལ་བ་དང་།",
    "འདི་གཉིས་ནི་ཀུན་ནས་ཉོན་མོངས་པ་ཡིན་ཏེ།",
    "ལས་དང་སྲེད་པའི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ལྟ་བའི་ཀུན་ནས་ཉོན་མོངས་པའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་འདི་གཉིས་ནི་ཕྱོགས་གཉིས་ཏེ།",
    "དེ་ལྟ་བའི་ཀུན་ནས་ཉོན་མོངས་པ་ལོག་པའི་རྟོག་པས་བསླང་བ་གང་ཡིན་པ་དེ་ནི་རབ་ཏུ་བརྟགས་པ་ཞེས་བྱའོ།",
    "དེ་ལ་སོ་སོའི་སྐྱེ་བོ་ཁྱིམ་པའམ་རབ་ཏུ་བྱུང་བ་ནི་ཀུན་ནས་ཉོན་མོངས་པ་འདི་གཉིས་ཀྱིས་ཀུན་ནས་དཀྲིས་པ་དང་།",
    "བག་ལ་ཉལ་གྱི་སྒོ་ནས་རྣམ་པར་ཤེས་པའི་གནས་བཞི་ལ་སེམས་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པ་བསྐྱེད་ནས་དེ་ལ་དམིགས་ཏེ།",
    "སློབ་པ་བཞི་མཐོང་བ་ནི་ལྟ་བའི་ཀུན་ནས་ཉོན་མོངས་པ་སྤངས་ཏེ།",
