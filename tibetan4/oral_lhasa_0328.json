    "སྭ་རཱ་ནཾ་ཏ་རི་ཏཱ་ཧ་སཱ་སཾ་ཡོ་ག་དབྱངས་པར་ན་མེད་པའི་ཧ་ས་རྣམས་ནི་ཡང་དག་པར་སྦྱོར་བའོ།",
    "དབྱངས་པར་ན་མེད་པའི་ཧ་ས་གཉིས་དང་གསུམ་ལ་སོགས་པ་བརྩེགས་པ་དེ་ལ་ཡང་དག་པར་སྦྱོར་བ་ཞེས་བརྗོད་པར་བྱའོ།",
    "ཨ་སཾ་ཡོ་གཱ་དི་པ་རོ་ཧྲ་སྭ་ལ་གྷུ་ཕ་རོལ་ཏུ་ཡང་དག་པར་སྦྱོར་བ་སོགས་མེད་པའི་ཐུང་དུ་ནི་ཡང་བའོ།",
    "ཡང་དག་པར་སྦྱོར་བ་དང་།",
    "ཡང་དག་པར་སྦྱོར་བ་སོགས་ཕ་རོལ་ན་མེད་པའི་ཐུང་དུ་རྣམས་ནི་ཡང་བའོ།",
    "དབྱངས་ཀྱིས་དམན་པ་ཕ་རོལ་ཏུ་ཡང་དག་པར་སྦྱོར་རོ།",
    "ཚུ་རོལ་གྱི་ཧ་ས་དབྱངས་མེད་རྣམས་ཕ་རོལ་དབྱངས་སཾ་ཧ་ས་དབྱངས་ལྡན་གང་ཡོད་པ་དེ་ལ་ཡང་དག་པར་སྦྱོར་ཏེ།",
    "རིམ་པར་དྲངས་པས།",
    "ཨེ་ཨ་ཡའོ་དབྱངས་ཕ་རོལ་ལ་ཨེ་ཡིག་ནི་ཨ་ཡ་ཞེས་པར་འགྱུར་ཏེ།",
    "དབྱངས་ཕ་རོལ་ལ་ཨོ་ཡིག་ནི་ཨཝ་ཞེས་པར་འགྱུར་ཏེ།",
    "གོ་ལ་སོགས་པའི་ཕ་རོལ་ཏུ་ཨཀྵ་ལ་སོགས་པ་བྱུང་ན་བར་དུ་ཨ་ཡིག་ཨཱ་ག་མ་བརྗོད་པར་བྱ་སྟེ།",
    "བྱེ་བ་སུམ་ཅུ་རྩ་དྲུག་འཇུག་ཨཀྵོ་ཧི་ཎཱི་ཞེས་པར་བརྗོད།",
    "དབྱངས་ཕ་རོལ་ལ་ཨེ་ཡིག་ནི་ཨཱ་ཡ་ཞེས་པར་འགྱུར་ཏེ།",
    "བྱེ་བྲག་སྟོབས་དང་ལྡན་པར་འགྱུར།",
    "པརྱཾ་ཀ་ཧོ་ཏྲྀ་ལྀ་ཀཱ་ར་སྦྱིན་སྲེག་མཁན་གྱི་ལྀ་ཡིག།",
    "དེ་ནས་གསལ་བྱེད་ཀྱི་བྱ་བ་རྣམས་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་གཅོད་པར་བྱེད།",
    "ལེགས་པར་སྐྱེས།",
    "བི་སརྫ་ནཱི་ཡ་སྱ་ས་རྣམ་པར་བཅད་བྱའི་སྲའོ།",
    "གང་འཐས་པར་བྱེད།",
    "གང་སྤྱོད་པར་བྱེད།",
    "དེ་འགྲོ་འམ་དེ་སྤྱོད་པར་བྱེད་དམ་དེ་གཡོ་བར་བྱེད།",
    "འདི་དགོད་པར་བྱེད།",
    "བཅུ་དྲུག་སོགས་ནི་རྣམ་པར་འགྱུར་བ་ཡིན།",
    "ཞེས་པའི་ཁྱད་པར་གྱི་དོན་གྱི་འགྲོ་བའི་མིང་ཅན་ཡིན་པས་ཕྱིས་རིང་པོ།",
    "ཤ་ཡིག་ཤས་ལའོ་ཞེས་པའི་ཁྱད་པར་གྱི་དོན།",
    "ཊཱ་ཡིག་རྗེས་སུ་འབྲེལ་བ་ཊཱ་ཨི་ནའོ་ཞེས་ཁྱད་པར་གྱི་དོན།",
    "ཨ་ཡིག་མཐའ་ལས་ཕ་རོལ་གྱི་ཊཱ་ནི་ཨི་ན་ཞེས་པར་འགྱུར་ཏེ།",
    "ང་ཡིག་རྣམས་ང་འགྲོ་བའི་ཁྱད་པར་གྱི་དོན།",
    "མིང་མཐའ་མཚུངས་པའི་ཡི་གེ་ལས་ཕ་རོལ་གྱི་ཨཱ་མྲ་ལ་ནུཊ་ཨཱ་ག་མ་སྦྱིན་པར་བྱ་སྟེ།",
    "ཨུ་བཧའི་སྒྲ་ལ་ནི་ངེས་པར་གཉིས་ཚིག་ཁོ་ནའི་མཐའ་སྟེ། ་གཉིས་དག།",
    "ཧེ་མཱ་སཱ་ཐམས་ཅད་དུ་དབྱངས་ཀྱིས་དམན་པ་ཕ་རོལ་ཏུ་ཡང་དག་པར་སྦྱོར་བ་དང་།",
    "དེ་ལ་ཡང་ཨི་ཨེ་དང་ཨུ་ཨོ་རུ་འགྱུར་བའི་ཁྱད་པར་ཙམ་མ་གཏོགས།",
    "གཞུང་དང་སྒྲུབ་ཚུལ་སོགས་ཧ་རི་དང་ཁྱད་པར་མེད་དེ།",
    "མ་བྱིན་པར་སྤྱིར་བཏང་ལྟར་བསྒྲུབས་པས།",
    "རྀ་ཡིག་མཐའ་ལས་ཕ་རོལ་གྱི་སི་ནི་ཨཱ་ཞེས་པར་འགྱུར་ཏེ།",
    "རྀ་ཡིག་མཐའ་ལས་ཕ་རོལ་གྱི་དཧི་ནི་ཨར་ཞེས་པར་འགྱུར་ཏེ།",
    "རྀ་ཡིག་མཐའ་ཅན་སྟྲྀའི་རྐྱེན་ཅན་ཀརྟྲྀའི་སྒྲ་ལ་རྣམ་དབྱེ་ཐོག་མ་ལྔ་ལ་ཁྱད་པར་ཡོད་དེ།",
    "དྲ་འགྲོ་བ་རྣམས་ལ་ཁྱད་པར་ཡོད་དེ།",
    "བོད་པར་ཨུ་ཤ་ནས་ཀྱི་གཟུགས་གསུམ་སྟེ།",
    "ཤས་ལ་སོགས་པ་དབྱངས་ལ་མ་བ་ཡང་དག་པར་སྦྱོར་བ་མ་ཡིན་པའི་ཨཏ་དབྱིའོ།",
    "དེ་བཞིན་དུ་ཨོ་ཡིག་མཐའ་ཅན་ཨ་ཏི་ནོ་ཞེས་པ་ལ་ཐུང་དུར་བྱས་པས་ཨ་ཏི་ནུ་ཞེས་པར་བསྒྱུར་བ་ལ། ་གྲུ་ཤིན་ཏུ་ལྕི་བ།",
    "སཾ་ཡོ་གཱནྟ་སྱ་ལོ་པ་ཡང་དག་པར་སྦྱོར་བའི་མཐའ་དབྱིའོ།",
    "རས་སོ་སོར་བསྡུ་བའི་ཡི་གེ་ཕ་རོལ་དང་ཚིག་མཐའ་ལས་ཀྱང་ཡང་དག་པར་སྦྱོར་བའི་མཐའ་དབྱི་བར་བྱ་སྟེ།",
    "ཤས་སོགས་རྣམ་དབྱེ་དབྱངས་དང་པོ་ཅན་ཕ་རོལ་ལ་བཱ་ཧའི་བཱ་ཡིག་དབྱངས་བཅས་ཨོ་ཞེས་པར་འགྱུར་ཏེ།",
    "ཙ་ཏུར་གྱི་སྒྲ་ལས་ཤི་སྟེ་རྣམ་དབྱེ་དང་པོ་ལྔ་ཕ་རོལ་ལ་ཨཱམ་ཨཱ་ག་མ་སྦྱིན་པར་བྱ་སྟེ།",
    "སོགས་ཏ་དངོས་པོའི་དོན་བརྗོད་པའི་སྐབས་སུ་ཡང་དེས་རིགས་འགྲེ་སྟེ་ཤེས་པར་བྱའོ།",
    "ཛ་ཡིག་དང་ཉྲ་ཡིག་ཡང་དག་པར་འདུས་པ་ནི་ཛྙ་ཞེས་པར་འགྱུར་ཏེ།",
    "མ་གྷབ་བཧི་སོགས་སོ། ། ན་ཡིག་མཐའ་ཅན་པ་ཐིནྲ་ཞེས་པའི་སྒྲ་ལའང་ཁྱད་པར་ཡོད་དེ།",
    "སོགས་སོ། ། ན་ཡིག་མཐའ་ཅན་བྲཧྨ་ཧན་ཞེས་པའི་སྒྲ་ལ་ནི་རྣམ་དབྱེ་ཐོག་མ་ལྔ་དེ་དང་འདྲ་ཞིང་ཤས་སོགས་ལ་ཁྱད་པར་ཡོད་དེ། ་སི་ཚངས་འཇོམས།",
    "མི་དབྱི་བ་གསུམ་འདམ་ཁ་ཅན་དུ་བྱས་པས།",
    "ཨ་དབྱི་བ་དང་མི་དབྱི་བ་ཡང་ན་པར་བྱས་པས། སི་ཨརྱ་མ་ཎོ།་",
    "ངི་སོགས་སོ། ། ན་ཡིག་མཐའ་ཅན་པཉྩན་ལ་གྲངས་ཀྱི་དོན་བརྗོད་པ་ལ་མང་ཚིག་ཁོ་ན་ལས་མི་འཇུག་ཅིང་རྐྱེན་ལ་མི་ལྟོས་པར་རང་བཞིན་གྱི་རྟགས་གསུམ་པ་ཞེས་ཟེར་ཏེ།",
    "ཨཥྚན་ལས་ཕ་རོལ་གྱི་ཛསྲ་ཤསྲ་གཉིས་ནི་ཡང་ན་ཌོ་ཞེས་པར་འགྱུར་ཏེ་ཌི་ཏལ་ཊི་ཕྱིས། བརྒྱད་ཨྵྚོ།་",
    "ཨི་དམ་གྱི་སྒྲ་ནི་སྐྱེས་པའི་རྟགས་ཀྱི་སྐབས་སུ་སི་དང་ལྷན་ཅིག་པར་ཨ་ཡཾ་ཞེས་པར་འགྱུར་ཏེ། སི་ཨ་ཡཾ།་",
    "ཨི་དམ་གྱི་སྒྲ་ནི་རྣམ་དབྱེ་ཊཱ་དང་ཨོ་སྲ་དག་ཕ་རོལ་ལ་ཨ་ན་ཞེས་པར་འགྱུར་ཏེ།",
    "སམྲཱཊྶུ། བི་རཱ་ཛ་རྣམ་པར་གསལ་བ།",
    "ཡང་དག་པར་སྦྱོར་བའི་མཐའ་དབྱི་འོས།",
