    "ཀྲོ་ཤཾ་ཨམ་པརྦ་ཏ་རྒྱང་གྲགས་ལ་རི་བོ།",
    "ཀྲོ་ཤ་སྱེ་ཀ་དེ་ཤོ་པརྦ་ཏ།་",
    "བྱེད་པ་པོ་གཙོ་བོ་ཉིད་དང་དེས་བྱ་བ་བྱེད་པ་ལ་ལྷག་པར་ཕན་འདོགས་ནུས་པར་སྒྲུབ་སླ་བར་བྱེད་པའི་དོན་ལའང་རྣམ་དབྱེ་གསུམ་པ་འཇུག་སྟེ།",
    "སྦྱིན་པའི་སྣོད་ལ་ཡང་དག་པར་སྦྱིན་པ་བྱིན་པའི་བྱེད་པ་ཅན་ལ་རྣམ་དབྱེ་བཞི་པ་འཇུག་སྟེ།",
    "རིག་བྱེད་རིག་པ་ལ་བ་ལང་སྦྱིན་པར་བྱེད།",
    "ས་འཛིན་ལས་འབབ་པར་འགྱུར་གང་གཱ། འདི་ནི་འབྲེལ་པ་གཙོ་བོར་སྟོན་པས་བྱེད་ཅན་ལ་མི་གཏོགས་ལ།",
    "འབྲེལ་ཚིག་ལ་ཡང་གཙོ་ཕལ་གཉིས་ལས་འབྲེལ་ཡུལ་གཙོ་བོ་ལ་དྲུག་ལ་འཇུག་པ་ཤས་ཆེ་ལ་འབྲེལ་བོ་ཕལ་བ་ནི་འབྲེལ་ཡུལ་དེའི་ཁྱད་པར་འབྱེད་བྱེད་ནུས་པ་ཅན་ཡིན་ཀྱང་གཙོ་བོ་ཕལ་བ་ལ་ཆུར་མི་འབྲེལ་བས་དྲུག་པ་འཇུག་པ་ཤས་ཆུང་ངོ།",
    "གནས་པ་ལྷག་པར་གནས་པའི་དོན་ལའང་དབྱེ་བ་དྲུག་སྟེ།",
    "དཔའ་བོ་གཡུལ་དུ་གོ་ཆ་གྱོན་པར་བྱེད།",
    "ང་སི་ཁྱིམ་ལས་གཞན་དུ་གླས་སོ། མང་པོ་ནས་ངེས་པར་བཟུང་བ་སྟེ་དེ་ལ་ཡང་།",
    "བྱཱ་ས་སྱ་ངས་ཀྲྀ་ཏི་རྒྱལ་བས་བྱས་པའོ།",
    "ཊཱ་མི་རྟག་པའི་སྒྲ་ནི་བྱས་པ་ལས་སོ།",
    "ཨ་ནི་ཏྱ་ཤབྡ་ཀྲྀ་ཏ་ཀ་ཏཱ་ད་སི་མི་རྟག་པའི་སྒྲ་ནི་བྱས་པ་ལས་སོ།",
    "གང་ལ་སྐྱེ་རྒུ་རྣམས་སྐྱེད་པར་བྱེད་པ་དེ་ནི་ཚངས་པ་འདིའོ། ཨཱད་ལ་སོགས་པ་སྦྱོར་བ་ལ་ལྔ་པའོ།",
    "གང་ལ་སྐྱེ་རྒྱུ་རྣམས་སྐྱེད་པར་བྱེད་པ་དོན་ཚངས་པའི་དའོ།",
    "སྡོམ་བརྩོན་ཆེད་དུ་ཐོས་པ་འཛིན་པར་བྱེད།",
    "རྔ་མ་རྣམས་ལ་གཡག་ནི་གསོད་པར་བྱེད།",
    "ལེགས་པ་མང་པོ་རྣམས་ཀྱིས་འགོག་པར་བྱེད་ཀྱང་མི་ཤེས་པ་རང་ཉིད་ལམ་མི་བདེ་བ་ལ་འགྲོའོ།",
    "བྲམ་ཟེའི་བདག་པོ་རྣམས་གཙང་སྦྲ་བྱེད་དོ།",
    "དོན་འགལ་བ་མ་ཡིན་པའི་མིང་ཚིག་ཏུ་གྲུབ་པ་གཉིས་སམ་གསུམ་ལ་སོགས་པ་བསྒྲིགས་པའི་ཕྲད་དང་རྣམ་དབྱེ་སོགས་བསྡུས་པས་ཚིག་ཕན་ཚུན་མ་འབྲེལ་བ་རྣམས་གཅིག་ཏུ་འབྲེལ་ཞིང་ཚིག་སྦྱོར་གྱི་དོན་ཐམས་ཅད་མ་ཚང་བ་མེད་པར་རྫོགས་ཤིང་ཚིག་ཉུང་ལ་དོན་རྒྱས་པ་བརྗོད་པ་དེ་བ་དེ་ནི་ཚིག་སྡུད་ཀྱི་དགོས་པ་ཡིན་ནོ།",
    "མི་ཟད་པར་གྱུར་བ་དང་།",
    "དེ་ལྟར་ཚིག་སྡུད་དྲུག་ལས་དང་པོ་མི་ཟད་པར་གྱུར་པའི་བསྡུ་བ་ནི།",
    "མི་ཟད་པ་སྔ་མ་ནི་མི་ཟད་པར་གྱུར་པའོ།",
    "སི། མི་ཟད་པར་གྱུར་པ་ལས་སོ།",
    "མི་ཟད་པའི་བསྡུ་བ་བྱས་པའི་མི་ཟད་པར་གྱུར་པ་དེ་ལས་ཕ་རོལ་གྱི་རྣམ་དབྱེ་ཐམས་ཅད་འཇིག་ཅིང་རྣམ་འགྱུར་སོགས་བྱ་བ་གང་ཡང་མེད་པས་སི་འཇིག་དེའི་རྗེས་སུ་དོན་གསལ་བར་བྱེད་པའི་ཚིག་གྲྀ་ཧ་ཀཱརྱཾ་ཞེས་པ་བཞག་པས།",
    "ཚིག་སྦྱོར་དང་ཆོ་ག་རྣམས་དེ་བཞིན་དུ་བྱས་པས།",
    "དངོས་པོ་དུ་མ་བྱ་བ་མི་མཚུངས་ཀྱང་ཚིག་གཅིག་ཏུ་སྦྱོར་བ་མི་འགལ་བའི་དོན་སྟོན་པར་བྱེད་པ་ལ་མི་ཟད་པའི་ནང་ཚན་ཡ་ཐཱ་ཞེས་པའི་སྒྲ་འཇུག་སྟེ།",
    "ནུས་པ་དང་ཅི་འཚམ་པར་རིམ་པས་གྱིས་ཤིག་ཞེས་པའི་ཚིག་སྦྱོར་ལ་རྣམ་དབྱེ་རྗེས་འབྲེལ་དང་བཅས་པ་ཕྱིས་ཨ་ན་ཏི་དང་དོན་གཅིག་པའི་ཡ་ཐཱ་སྔོན་དུ་བཞག་པས།",
    "དོན་གསལ་བྱེད་རིམ་པར་སྦྱར་བས།",
    "ཉེ་བའི་བུམ་པ་ལ་ལྟོས། ། མི་ཟད་པར་གྱུར་པའི་ཨཏ་མཐའ་ལས་ཕ་རོལ་གྱི་རྣམ་དབྱེ་ཊཱ་ངི་དག་ནི་ཨམ་དུ་ཡང་ན་འགྱུར་ཏེ།",
    "ཉེ་བའི་བུམ་པར་བླུགས་ཤིག།",
    "ཨན་ཞེས་པར་འགྱུར་ཏེ།",
    "མཐར་གཅིག་ཚིག་དང་མང་ཚིག་ཡང་ན་བར་བྱས་པས།",
    "ཚིག་དངོས་སུ་བརྗོད་པ་དེའི་དོན་གཙོ་བོར་མི་སྟོན་པར་དེ་དང་འབྲེལ་པའི་དོན་གཞན་ཞིག་གཙོ་བོར་སྟོན་པ་ནི་འབྲུ་མང་པོའི་བསྡུ་བ་ཞེས་བྱ་ལ།",
    "ཀ་ཡིག་ཀུན་ལ་མཉམ་པར་འཇུག་པའོ།",
    "ཊི་དང་ཨུ་བདྷཱ་དབྱི་བ་ཡང་ན་བར་བྱས་པས།",
    "ཚིག་ལྔ་ཕྱིའི་དོན་དངོས་པོ་གཅིག་ལ་མཉམ་པར་འཇུག་པའི་དོན་ལ་ལས་འཛིན་གྱི་བསྡུ་བ་ཞེས་བྱ་སྟེ།",
    "ཡང་དག་པར་སྦྱོར་བའི་མཐའ་ཕྱིས།",
    "ཟླས་དབྱེའི་བསྡུ་བ་བྱས་པའི་མཐའ་ལ།",
    "ཛས་རིགས་རྣམས་དང་སྤྱོད་པར་གནས་པ་རྣམས་ལས་གཞན་རྣམས་ཀྱང་།",
    "ཞེས་པ་ལ་རྣམ་དབྱེ་སོགས་ཕྱིས་མཐར་སརྦ་རང་ལུགས་དང་སྤྱིར་བཏང་ཨ་ཐུང་མཐའ་ཅན་ལུགས་ཡང་ན་བར་བྱས་པས།",
    "ཛས་རིགས་སྦྱོད་པར་གནས་པ་ལས་གཞན་རྣམས།",
    "དེ་དང་སྦྱོར་རྒྱུའི་ཕ་རོལ་གྱི་ཚིག་ཀྱང་གཞི་མཐུན་པའི་དོན་ཅན་ལ་ཚིག་སྦྱོར་སོགས་མི་དགོས་པར་ཐོག་མ་ནས་ཚིག་སྡུད་ཁོ་ན་བྱས་ཆོག་ལ།",
    "ཕྱོགས་དང་གྲངས་ཡིན་ཀྱང་མཉམ་པར་འཇུག་པའི་དོན་ཅན་མ་ཡིན་པ་དག་ལ་ནི་ཐོག་མར་ཚིག་སྦྱོར་བྱས་ནས་དེ་། སླར་ཚིག་སྡུད་ཀྱི་ཆོ་གས་བསྡུ་དགོས་ཏེ།",
    "མཐའི་ཨུ་ཡིག་དང་ཨོ་ཡིག་དག་ནི་རྐྱེན་དབྱངས་དང་ཡ་ཕ་རོལ་ལ་ཨབ་ཅེས་པར་འགྱུར་ཏེ།",
    "ཚིག་སྦྱོར་དེ་བཞིན་དུ་བྱས་པས།",
    "ཚིག་སྦྱོར་དེ་བཞིན་དུ་བྱས་པས།",
    "ཚིག་སྦྱོར་སོགས་དེ་བཞིན་དུ་བྱས་པས།",
    "ཚིག་སྦྱོར་དེ་བཞིན་བྱས་པས།",
    "སོ་སོའི་ཚིག་གཉིས་ཀའི་དབྱངས་ཐོག་མ་འཕེལ་བ་བྱས་པས།",
    "ཨཎ་འཕེལ་བ་ཡང་ན་བར་བྱས་པས།",
