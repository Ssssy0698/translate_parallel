    "ལྷག་མ་རྣམས་ནི་གོ་སླ་བས་རྣམ་པར་མ་ཕྱེའོ།",
    "ང་དང་ང་ཡི་གསུངས་པ་ལྟར།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཐོས་པར་བྱེད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པའི་ཕྱིར་རོ་ཞེས་ཟེར་རོ།",
    "བཏགས་པ་ཙམ་གྱིས་ཀྱང་དེའི་ཡོན་ཏན་མ་བསྟན་ན་སུ་ཞིག་མཐོང་བའི་ལམ་ལ་ཡིད་ཆེས་ནས་ཐོབ་པར་བྱ་བའི་ཕྱིར་འཇུག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "འདུས་བྱས་ཐམས་ཅད་སྐད་ཅིག་མ།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "དཔེ་མ་གྲུབ་པ་ཞེས་བྱ་བ་ནི་རང་བཞིན་མེད་པ་ནི་དོན་དམ་པར་འདོད་པ་ཡིན་ལ་རྨི་ལམ་གྱི་གནས་སྐབས་ལ་སོགས་པ་ནི་ཀུན་རྫོབ་ཏུ་ཡང་རྨི་ལམ་ལ་སོགས་པ་འདྲ་ཞེས་འདོད་པས་དཔེ་མ་གྲུབ་ལ།",
    "དེས་ན་ནི་ཞེས་བྱ་བ་ནི་ངེས་པར་བཟུང་བའོ།",
    "དེ་ནས་བརྩམས་ཏེ་སྔར་ཇི་ལྟར་ཉམས་སུ་མྱོང་བའི་དྲོད་ལ་སོགས་པ་ཡང་འདྲིས་པར་བྱེད་པའི་ཚེ་རྟགས་རྣམ་པ་བཅུ་གཉིས་དང་ལྡན་པ་ལ་སོགས་པའི་རྟོགས་པ་འབྱུང་ངོ་ཞེས་སྐབས་ཐ་དད་པ་གཅིག་ཏུ་བསྟན་པ་ནི་བསླབ་པའི་ཚེ་ས་མཚམས་གང་དུ་འདི་དག་སྦྱར་བ་གོ་སླ་བར་བྱ་བའི་ཕྱིར་ཏེ།",
    "སེམས་ཀུན་ཏུ་གནས་པ་ནི་འགའ་ཞིག་ངེས་པར་གཏན་ལ་ཕེབས་པས་མཐོང་བའི་དོན་ལ་ཐེ་ཚོམ་མེད་པ་དེ་ནི་དེ་ཉིད་ལ་སེམས་རྩེ་གཅིག་པའི་ཚུལ་གྱིས་ཀུན་ནས་གནས་ཀྱི་དམིགས་པ་གཞན་མི་ཚོལ་བས་ན་སེམས་ཀུན་ཏུ་གནས་པའོ།",
    "དེ་ལ་རྣམ་པར་རྟོག་པ་ཡང་རྣམ་པ་བཞི་སྟེ།",
    "རང་བཞིན་གྱི་རྣམ་པར་རྟོག་པ་འདོད་ཆགས་ལ་སོགས་པ་དང་གཉེན་པོའི་རྣམ་པར་རྟོག་པ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སོགས་པ་ངན་འགྲོའི་གཉེན་པོར་གྱུར་པ་དང་།",
    "འཐོབ་པའི་རྣམ་པར་རྟོག་པ་སྐུ་གསུམ་གྱིས་བསྡུས་པ་རྣམས་ཏེ།",
    "འདི་དག་ནི་འཕགས་པ་རྣམ་པར་མི་རྟོག་པ་ལ་འཇུག་པ་ཞེས་བྱ་བའི་གཟུངས་ལས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེ་ཁོ་ནའི་རྣམ་པར་རྟོག་པ་དང་།",
    "འཐོབ་པའི་རྣམ་པར་རྟོག་པ་རྣམས་སུ་ཅི་རིགས་སུ་སྦྱར་རོ།",
    "རང་བཞིན་གྱི་རྣམ་པར་རྟོག་པ་འདོད་ཆགས་ལ་སོགས་པ་ནི་ལམ་དྲུག་ཏུ་བསྐལ་པ་དུ་མ་ཞིག་ཏུ་ཟིལ་གྱིས་མནན་ཏེ།",
    "དེའི་ཕྱིར་མཐོང་བའི་ལམ་ལ་སོགས་པར་དེ་དག་རབ་ཏུ་བསྲབ་པའི་ཕྱིར་གཅིག་ཏུ་འབད་པར་བྱ་བ་མ་ཡིན་པས་ན་དེ་དག་ལ་མ་སྨོས་སོ།",
    "དེ་ལ་གཟུང་བའི་རྣམ་པར་རྟོག་པ་རྣམས་ལམ་གཉི་གའི་སྦྱོར་བའི་གནས་སྐབས་ཉེར་བསྡོགས་ཀྱིས་སྤོང་བར་བྱེད་པ་ནི་དེ་དག་རགས་པས་ཤེས་པར་སླ་བའི་ཕྱིར་རོ།",
    "འཛིན་པའི་རྣམ་པར་རྟོག་པ་རྣམས་ལམ་གཉི་གས་འཇུག་པའི་གནས་སྐབས་ཀྱི་སེམས་དང་སེམས་ལས་བྱུང་བ་རྣམས་ཀྱིས་སྤོང་བ་ནི་དེ་དག་ཕྲ་བའི་ཕྱིར་ཉེར་བསྡོགས་ཀྱིས་སྤོང་བར་མི་ནུས་པའི་ཕྱིར་ཏེ།",
    "ཇི་སྐད་བསྟན་པའི་བདག་དང་ཕུང་པོ་ནས་བརྩམས་ཏེ་ཡང་དག་པའི་ཡེ་ཤེས་ཀྱི་བར་དུ་ཡང་དག་པར་མ་གྲུབ་པར་བསྒོམས་པས་རིམ་གྱིས་སྤོང་བ་དང་།",
    "ཇི་ལྟར་ཡིད་ལ་བྱས་པའི་རྣམ་པར་རྟོག་པ་རྣམས་ལྕུག་མ་བཀྲམ་པ་གཏུབས་པའི་དཔེས་དུས་གཅིག་ཏུ་བསྒོམས་པས་གཞོམ་པར་བྱའོ།",
    "འདི་ནི་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་རྣམས་ཀྱི་བསྡུས་པའི་དོན་ཅིག་ཅར་བསྟན་པའོ།",
    "གལ་ཏེ་སྐད་ཅིག་མ་གཉིས་པ་ལ་སོགས་པར་གྱུར་པ་ན་ནི།",
    "ངེས་པར་རྟོག་པ་དང་བཅས་པར་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "མཐོང་བའི་ལམ་དེ་ཡང་ཐོབ་པར་བྱེད་པ་དེས་བསྡུས་པའི་ཉེར་བསྡོགས་དང་དངོས་དང་དེའི་རྗེས་ལས་ཐོབ་པ་རྣམ་པར་རྟོག་པ་དང་བཅས་པས་ཅིག་ཅར་དུ་ཞིང་བརྒྱ་སྦྱོང་ཞིང་།",
    "བརྡ་སྤྲོད་པའི་རིགས་པ་རྣམས་ནི་དོན་གྱི་ཤུགས་ཀྱིས་ཁ་ཅིག་ཏུ་མ་ངེས་པར་འགྱུར་ཏེ།",
    "དྲུག་པ་འདི་ནི་བཞི་པར་སྦྱར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་བརྗོད་པ་ལྟ་བུའོ།",
    "དེ་བཞིན་དུ་སྤྱིའི་དུས་བསྐལ་པ་གྲངས་མེད་པ་གསུམ་ཞེས་བྱ་བ་ལ་སོགས་པའི་དུས་ཀྱང་ངེས་པར་ནི་ནམ་ཡང་མི་འགྱུར་རོ།",
    "གཟུང་བའི་རྣམ་པར་རྟོག་པ་ཞེས་བྱ་བའི་སྒྲ་ནི་ཡུལ་འདོགས་པར་སྲིད་པ་དགག་པར་གཟུང་བར་བྱའོ་ཞེས་གཟུང་བར་རྣམ་པར་རྟོག་པ་ཞེས་འཆད་དོ།",
    "དངོས་པོ་ནི་མིང་ཅན་ཏེ་ཇི་ལྟར་རྟོགས་པར་བྱེད་པའི་ཡུལ་ལོ།",
    "མ་འབྲེལ་པ་ནི་གལ་ཏེ་དངོས་པོ་དེ་དག་བརྟགས་པ་ལྟར་ཡོད་ན་དེའི་ཚེ་འབྲེལ་པར་ཡང་འགྱུར་བ་ལྟ་ཞིག་ན།",
    "དེ་དག་མེད་པའི་ཕྱིར་མ་འབྲེལ་ཏེ་དེས་ནི་མ་འབྲེལ་ཞེས་བྱ་བ་འདིས་ནི་རྣམ་པར་རྟོག་པ་བཞི་མེད་པ་ཙམ་ཞིག་ཏུ་ཟད་ཅེས་སྟོན་པའོ།",
    "འཇུག་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་སྐྱེས་བུ་འགའ་ཞིག་དྷ་དུ་ར་ཟོས་པའི་རྒྱུས་ནམ་མཁའ་ལ་གསེར་གྱི་ཁབ་ལེན་པའི་ཕྱིར་འཇུག་པ་ལྟ་བུར་གཞི་མེད་པར་འཇུག་པ་སྟེ།",
    "སོ་སོའི་སྐྱེ་བོ་ཡུལ་དུ་བྱས་ཏེ་དེ་སྐྱེས་བུ་རྫས་སུ་ཡོད་པར་འཛིན་པ་དང་།",
    "འཕགས་པའི་གང་ཟག་ཡུལ་དུ་བྱས་ཏེ་དེ་ལ་བཏགས་པར་ཡོད་པར་འཛིན་པ་ཞེས་གཟུང་བ་དང་འཛིན་པར་སྦྱར་རོ།",
    "དེ་ལྟར་འཛིན་པ་ནི་འདི་ནི་བདེན་ཏེ་འདི་ནི་མིང་ཙམ་དུ་ཡོད་པར་གྲགས་པས་གྲུབ་ཅིང་མིང་ཙམ་པོ་དེ་མེད་ན་སུ་ཞིག་ལམ་ལ་ནན་ཏན་བྱེད་ཅེས་མིང་ཙམ་གྱི་ཞེན་པས་འཕགས་པའི་གང་ཟག་རྣམས་ཡོད་པར་རྗེས་སུ་དཔོག་པར་ཡང་བྱེད་པའོ།",
