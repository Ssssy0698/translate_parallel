    "ལུས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏི།",
    "དེ་ལྟ་བསྟན་བྱ་བ་དེ་དག་ཐ་༥༥༦དནན་ཏན་གྱིས་རྫོགས་པར་བྱའོ།",
    "དང་པོ་རྣམ་པ་དང་བསྟུན་པར་བྱ་བའི་ཕྱིར།",
    "དེསནགས་སུ་གནས་པར་བྱ།",
    "མཉམ་པར་གཞག་པ་བརྩོན་བྱ་ཞིང་།",
    "ཤཱནིཏུ་ངལ་བ་ཆེར་བྱས་པས་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་ལེགས་སྤྱདད།",
    "ཞེ་སྡང་ཅན་དེ་ཡིས་སྐྲག་པར་འགྱུར་རོ།",
    "དེ་ལསཾ་བཟློག་པར་མི་འདོད་པའོ།",
    "དོན་དམ་པར་འདོད་པ་འམ་མ་འདོདཔ་སྲིད་པ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "ད་ལྟང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟང་ནི་སྡང་ཉེས་པ་དང་ལྡན་པ་རྣམ་པར་བསྒོམས་ལ་ཐབས་ཐམས་ཅད་ཀྱིས་དེའི་གཉེན་པོར་གྱུར་པ་བཟོད་པ་བསྐྱེད་པར་བྱའོ།",
    "ཅི་ལ་བབ་ཀྱང་ཞེས་བྱ་བ་ལ་རོགས་པ་གསུངས་ཏེ།",
    "གཞན་ཡང་ཡང་ཡ་བད་བཞི་ལ་སྦྱངས་པས་སྐྱེ་བ་ཡིན་ནོ་ཞེས་གསུངས་པ།",
    "བཤེས་རྣམས་ལས་ཞེས་གསུངས་ཏེ།",
    "འོན་དེལྟར་གྱུར་ན་གལ་ཏེ་སྡུག་བསྔལཤཱནྟི་རུང་པ་ནི་བསྟེན་པར་ནུས་ཀྱིས།",
    "སཞིའི་ཕྱི་དདཔད་ཞའགའ་ཡང་མེད་དོ་ཞེས་བརྗོད་པར་བྱེད་ཅེས་དོགས་པ་ལ།",
    "འདི་པ་གཞན་ཡང་སུན་དབྱུང་བ་གསུངས་པ།",
    "༡༤ ལ་ཤེས་བདེ་བ་ཉིད་དུ་དམིགས་པར་བྱའོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ཉིདི་སྡུག་བསྔལཔར་འདོད་པ་སུ་ཡང་མེད་དོ།",
    "ད་ནི་གཞན་གནོད་པ་བྱེད་པ་ལ་ཇི་མི་སྙམ་པའི་བཟོད་པ་བསྟན་པ་བག་ཡོད་པས་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས།",
    "རངལ་ནི་བདག་ཉིད་ཀྱི་ལུས་ལ་གཞན་གྱིས་གནོཔས་གནོད་བ་བྱེད་པ་ཡོད་དེ་གསོད་པར་བྱེད་པའོ།",
    "གཞན་ཡང་སྡུག་བསྔ་ལ་གྱི་རྒྱུ་གཙོ་བོ་གང་ཡིན་པ་དེ་ལ་བུ་པ་གས་པར་འགྱུར་གྱི་གཅོ་པ་ཡ་ན་པ་ལ་རུ་ལ་ཡིན་ནོ་ཞེས།",
    "ཞི་དུ་ཞེས་བྱ་བ་ལ་སོས་པ་གསུངས་ཏེ།",
    "ཡང་ཞེས་བྱ་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ན་དེ་ལས་བྱུང་བའི་སྡུག་བསྔལ་དོན་དམ་པར་མེད་དོ།",
    "འོན་ཏེ་གལ་ཏེ་བརྙས་པ་ལ་སོགས་པ་ལ་ལུལ་ལ་གནོད་པར་བྱེད་པ་མ་ཡཉེ་ཡོད་ཀྱི།",
    "རྨི་ལམ་ཞེས་བྱ་བ་སོགས་པ་གསུངས་ཏེ།",
    "བལ་དམར་ཞེས་བྱ་བ་ལ་སོགསཔ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་གསུངས་པའི།",
    "འཇིག་པར་བྱེདཔའི་རྣམ་པར་འཁྲུག་པར་བྱེད་པའོ།",
    "ལ་ལ་རྨོངས་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐམས་ཅད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་དར་གས་པའི་ཚུལ་འདི་ཡིན་ནོ་ཞེས་དེ་ལྟངམཐོང་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིར་ད་ལྟའི་སྡུག་བསྔལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཟོང་ལས་ནི་དེ་ལ་དོན་ཆེན་པོ་རྙེད་པར་འགྱུར་བ་ཡིནནོ།",
    "རྩི་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ཏེ།",
    "༡༤ ལ་ལ་སོགས་པ་གསུངས་ཏེ།"
  ]
}