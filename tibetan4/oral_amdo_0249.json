    "ས་སྐྱོང་གདུག་པ་རྩལ་ཆེ་བ་ཞིག་པས་ཡངས་པ་ཅན་གྱི་ལིཙྪ་བཱི་རྣམས་ཀྱི་སྐྱེད་མོས་ཚལ་རྣམས་མ་རུང་བར་བྱས་པ་དང་།",
    "སྐྱེད་མོས་ཚལ་སྲུང་བ་རྣམས་ཀྱིས་སྨྲས་པ།",
    "ཡངས་པ་ཅན་གྱི་ལིཙྪ་བཱི་རྣམས་ནི་གདུག་པ་རྩལ་པོ་ཆེ་ཡིན་གྱིས་དེ་དག་གི་སྐྱེད་མོས་ཚལ་རྣམས་མ་རུང་བར་མ་བྱ་ཤིག་ཅེས་དེས་སླར་བཟློག་ཀྱང་མ་བཏུབ་ནས་སྐྱེད་མོས་ཚལ་སྲུང་བ་རྣམས་ཀྱིས་དུམ་བུ་ལ་སྨྲས་པ།",
    "ཁྱོད་ཀྱི་བུས་ཡངས་པ་ཅན་གྱི་ལིཙྪ་བཱི་རྣམས་ཀྱི་སྐྱེད་མོས་ཚལ་རྣམས་མ་རུང་བར་བྱས་ཏེ་་ལིཙྪ་བཱི་འདི་དག་རྣམས་གདུག་པ་རྩལ་པོ་ཆེ་ཡིན་པས་འདི་ལ་གནོད་པ་བྱས་སུ་འོང་གིས་འདི་སླར་ཟློག་ཅིག།",
    "བུ་ཡངས་པ་ཅན་གྱི་ལིཙྪ་བཱི་རྣམས་ནི་གདུག་པ་རྩལ་པོ་ཆེ་ཡིན་གྱིས་འདི་དག་གི་སྐྱེད་མོས་ཚལ་མ་རུང་བར་མ་བྱ་ཞིག།",
    "དེ་དག་གིས་གནོད་པར་བྱས་ས་རེ།",
    "ཡབ་འདི་དག་ལ་ནི་སྐྱེད་མོས་ཚལ་མཆིས་ན་བདག་ཅག་ལ་ནི་མ་མཆིས་སོ།",
    "བུ་སྐྱེད་མོས་ཚལ་གྱི་དོན་དུ་ཚོགས་ལ་གསོལ་བ་གདབ་བོ།",
    "ཤེས་ལྡན་དག་བདག་གི་བུ་གཉིས་ལ་སྐྱེད་མོས་ཚལ་མ་མཆིས་ཀྱིས་ིབདག་ལ་སྐྱེད་མོས་ཚལ་ཞིག་ཐུགས་དཔག་མཛད་པའི་རིགས་སོ།",
    "དེ་རྣམས་ཀྱིས་དེ་དག་ལ་སྐྱེད་མོས་ཚལ་རྙིང་པ་ཞིག་བྱིན་པ་ལས།",
    "དེ་ལ་གཅིག་གིས་བཅོམ་ལྡན་འདས་ཀྱི་སྐུའི་གཟུགས་བརྙན་བྱེད་དུ་བཅུག་གོ།",
    "ས་སྐྱོང་གིས་བྱ་བ་མ་ཡིན་པ་སྟོང་ཕྲག་དག་བྱས་པས་ལིཙྪ་བཱི་རྣམས་སྨོད་པར་བྱེད།",
    "བུ་ཁྱོད་ཚོགས་འཁྲུག་པར་མ་བྱེད་པར་རི་འོར་ཆེ་གེ་མོ་ཞིག་ཏུ་སོང་ལ་དེར་རང་གི་ཞིང་ལས་ཀྱི་མཐའ་རྣམས་ལ་ཞལ་ཏ་བྱེད་ཅིང་འདུག་ིཤིག།",
    "དེ་དེར་སོང་ནས་རང་གི་ཞིང་ལས་ཀྱི་མཐའ་རྣམས་ལ་ཞལ་ཏ་བྱེད་པར་བརྩམས་སོ།",
    "དེ་ནས་ཁ་ཅིག་གིས་སྨྲས་པ།",
    "ཁ་ཅིག་གིས་སྨྲས་པ།",
    "ཐམས་ཅད་དགའ་བས་དེ་རྣམས་འདུས་ནས་སེང་གེའི་གན་དུ་སོང་སྟེ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་རི་འོར་ན་ས་སྐྱོང་རང་གི་ཞིང་བླས་ཀྱི་མཐའ་རྣམས་ལ་ཞལ་ཏ་བྱེད་པའི་རི",
    "ས་སྐྱོང་གིས་ཕྱེ་སྟེ་བཀླགས་ནས་དེས་སྨྲས་པ།",
    "དེ་རྣམས་ཀྱིས་སྨྲས་པ་ཤིའོ་། དེ་མི་བཟོད་པ་སྐྱེས་ནས་ཡངས་པ་ཅན་དུ་སོང་སྟེ་སྨྲས་པ།",
    "༣དེཆུད་ཅིང་འདུག་པ་དེ་ས་སྐྱོང་གིས་མཐོང་ནས་སྨྲས་པ།",
    "ངའི་བཙུན་མོ་དམ་པ་ཤི་ན་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་མི་འདུག།",
    "བདག་གི་ནུ་བོ་ལ་བུ་མོ་གཟུགས་དང་ལང་ཚོ་ཕུན་སུམ་ཚོགས་པ་ལྷ་ཁོ་ན་ལ་འོས་པ་གཉིས་མཆིས་ན།",
    "འོན་ཀྱང་ཁྱོད་ཉིད་འོངས་ཏེ་སྐྱེད་མོས་ཚལ་དུ་སྡོད་ཅིག་དང་།",
    "ཁོ་བོས་དེ་སྐྱེད་མོས་ཚལ་དུ་ཕྱུང་བ་དང་ཁྱོད་ཀྱིས་ཁྲིད་དེ་སོང་ཤིག།",
    "དེ་ནས་ས་སྐྱོང་གིས་རྒྱལ་པོ་ལ་མཆི་ཕྱག་བྱས་ནས་ཤིང་རྟར་ེཞུགས་ཏེ་ཡངས་པ་ཅན་དུ་སོང་བ་ལས་རིམ་གྱིས་ཕྱིན་ནས་སྐྱེད་མོས་ཚལ་དུ་བསྡད་དོ།",
    "༡༢ ༧བ་འགའ་ཞིག་འོངས་ན་བདག་གིས་ཇི་ཙམ་དུ་ཟིན་པའམ།",
    "རོལ་མོའི་སྒྲ་དང་།",
    "མེ་ཏོག་ཕྲེང་གི་ཡོ་བྱད་ཀྱིས་སྒོ་ཁང་དུ་བཞག་གོ།",
    "ས་སྐྱོང་གིས་སེང་གེ་ལ་སྤྲིང་བ།",
    "ཁོ་བོ་སྐྱེད་མོས་ཚལ་ན་སྡོད་ཀྱིས་བྱུང་ཤིག།",
    "དེས་ཡངས་པ་ཅན་གྱི་ཚོགས་ལ་བརྟགས་ནས་ཁྱིམ་དུ་སོང་སྟེ་ཉེ་གོས་ཅན་ལ་སྨྲས་པ།",
    "ཅི་ཞིག་གི་ཕྱིར་རྒྱན་ཐོགས།",
    "ཁོ་མོ་བག་མར་བཏང་ངོ།",
    "ཁོ་མོ་ཕུ་མོ་ཡིན་ན་ཁྱོད་ཅི་སྟེ་བག་མར་གཏང་ཨེ།",
    "གལ་ཏེ་དེ་ལྟ་ིན་ཁྱོད་རྒྱན་ཐོགས་ཤིག།",
    "བདག་ཅག་གི་མི་མཛའ་ིབ་ཞིག་ཡངས་པ་ཅན་དུ་ཞུགས་སོ།",
    "སྐྱོང་ཡང་སྔངས་པས་གོས་ཅན་ཤིང་རྟར་བཅུག་སྟེ་སོང་ངོ།",
    "ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་བདག་ལ་མ་སྨྲས་དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "དེ་ནས་དེ་སྡུག་བསྔལ་ཞིང་ཡིད་མི་བདེ་བས་རྒྱལ་པོའི་དྲུང་དུ་སོང་བ་རྒྱལ་པོས་མཐོང་ནས་སྨྲས་པ།",
    "དེ་ནང་དུ་ཁྲིད་པ་དང་རྒྱལ་པོས་ིལྷག་པར་གཟུགས་དང་ལང་ཚོ་ཕུན་སུམ་ཚོགས་པ་མཐོང་ནས་བུད་མེད་ཀྱི་ཡུལ་གྱིས་ཕྲོགས་པས་མཐོང་མ་ཐག་ཁོ་ནར་རྒྱལ་པོ་ཆགས་པར་གྱུར་ནས་སྨྲས་པ།",
    "འཐབ་ཀྲོལ་ཅན་གྱི་རྒྱལ་པོ་བདག་གི་བསྟི་གནས་གཅན་གཟན་གདུག་པས་ཀྱང་གཟེམ་པར་བྱ་བར་རི་དགས་སྐྱབས་སུ་འོངས་པ་ཁྱོད་ཀྱིས་གསོད་ིདམ་ཞེས་དྲང་སྲོང་དེ་རྒྱལ་པོ་ལ་དེ་སྐད་དུ་ཁ་ཟེར་བ་དང་།",
    "དཔུང་གི་ཚོགས་འོངས་ནས་སྨྲས་པ།",
    "རྣམ་པ་ཐམས་ཅད་དུ་བདག་འདིའི་བཙུན་མོ་དམ་པའི་མངལ་དུ་སྐྱེ་བར་གྱུར་ཅིག་ཅེས་བྱས་སོ།",
    "གང་གི་ཚེ་ཉི་མ་ཁོ་ན་ལ་ཉིང་མཚམས་སྦྱོར་བ་བླངས་པ་དེ་ཉིད་ཀྱི་ཉི་མ་ལ་ཁྲག་གི་ཆར་བབ་བོ།",
    "འདིའི་འདོད་པ་ཅི་ཞིག་གིས་སེལ་བར་འགྱུར་སྙམ་མོ།",
    "མཁས་པའི་རང་བཞིན་ཅན་གཞན་དག་གིས་སྨྲས་པ།",
    "ལྷ་རས་ཀྱི་བར་སྦྱང་ཤས་བལྟམས་པར་བགྱིས་ཏེ་གསོལ་ལ་ཉིད་བཙུན་མོ་ལ་སྟོབས་མཛོད་ཅིག།",
    "ཀྱེ་ིམའོ་བདག་གིས་ལྷའི་ཁྲག་ཁོ་ན་འཐུངས་ཀྱང་ཅི་མ་རུང་སྙམ་པ་དེ་ཡང་རྒྱལ་པོ་ལ་སྨྲས་པ་དང་།",
    "བཙས་ཏེ་གང་གི་ཉི་མ་ལ་བཙས་པ་དེ་ཉིད་ཀྱི་ཉི་མ་ལ་ཡང་ཁྲག་གི་ཆར་བབ་བོ།",
    "སྐྱེད་མོས་ཚལ་དེར་ཀུན་ནས་སྲུང་ིམའི་མི་རྣམས་བཀོད་ནས་ཉི་མ་བགྲང་བ་ལ་ཞུགས་སོ།",
    "ཇི་ཙམ་ན་ཞག་བདུན་ལོན་པ་དང་སྐྱེད་མོས་ཚལ་དེ་རྡོ་བ་དང་།",
    "གྱོ་མོ་རྣམས་བསལ་ནས་ཙན་དན་གྱི་ཆུས་ཆག་ཆག་བཏབ།",
    "གླུ་དང་རོལ་མོའི་སྒྲ་རྣམ་པ་དུ་མ་དག་དང་།",
    "གཉེན་བཤེས་ཀྱི་སྐྱེ་བོས་ཡོངས་སུ་བསྐོར་ནས་དཔལ་གྱི་འབྱོར་པ་ཆེན་པོས་ཆུང་མ་དང་ལྷན་ཅིག་བྱུང་ནས་སྐྱེད་མོས་ཚལ་དེ་ན་དེ་རྩེ་བར་བྱེད།",
    "དགའ་བར་བྱེད་དགའ་མགུར་སྤྱོད་པར་བྱེད་པ་ལས་ཆུ་ཤིང་གི་སྡོང་པོ་གས་ནས་བུ་མོ་གཟུགས་བཟང་བ།",
    "བུ་མོ་འདི་ནི་ཨ་མྲའི་ཚལ་ནས་རྙེད་པ་ཡིན་པས་འདིའི་མིང་ཨ་མྲ་སྐྱོང་མ་ཞེས་བྱའོ།",
    "ག་༣ཏེ་ཞེས་བྱ་བ་ནས་ཆེན་མོར་གྱུར་ཏོ།",
    "བདག་གིས་སྐྱེད་མོས་ཚལ་ནས་བུ་མོ་ཞིག་རྙེད་པ་དེ་བདག་གིས་བསྣུན་བསྙོད་དེ་བསྐྱེད་ནས།",
    "དེ་བདག་གིས་རང་གི་རིགས་རྒྱུད་དང་འཚམ་པར་འགའ་ཞིག་ལ་ཆུང་མར་བྱིན་ིན་ཚོགས་ཀྱིས་ལྟོས་ཤིག།",
    "གཟུགས་དང་ལང་ཚོ་ཕུན་སུམ་ཚོགས་པ་མཐོང་ནས་ཚོགས་ཐམས་ཅད་ངོ་མཚར་དུ་གྱུར་པའི་མིག་བགྲད་དེ་ཀུན་ཏུ་བརྟགས་པར་བརྩམས་ནས་སྨྲས་པ།",
    "དེ་ནས་ཁྱིམ་བདག་མིང་ཆེན་ཡིད་མི་བདེ་ཞིང་རང་གི་ཁྱིམ་དུ་སོང་ནས་དེ་འགྲམ་པ་པ་ལག་པ་གཏད་ནས་ིསེམས་ཁོང་དུ་ིཆུད་ཅིང་འདུག་པ་ཨ་མྲ་སྐྱོང་མས་མཐོང་ནས་དྲིས་པ།",
    "གང་གི་ཚེ་ཁྱིམ་ཉུལ་བ་དེའི་ཚེ་བདག་གི་ཁྱིམ་ཞག་བདུན་ན་བྱུལ་བ་དང་།",
    "མིང་ཆེན་གྱིས་ཨ་མྲ་སྐྱོང་མའི་སྤྲིང་བ་བཟླས་པ་དང་།",
    "བུད་མེད་ཀྱི་ཤ་ཁོན་ཐ་ཆད་ཡིན་པས་གལ་ཏེ་གཅིག་ནང་དུ་ཞུགས་པ་ན་ཅིག་ཤོས་ཀྱང་ནང་དུ་ཞུགས་ན་གདོན་མ་ཟོས་པར་ིགཅིག་ལ་གཅིག་གསོད་པར་འགྱུར་རོ།",
    "ཁ་ཅིག་གིས་ནི་རེག་པ་ཁོ་ནས་ཏེ།",
    "དེས་ཡུལ་སྣ་ཚོགས་ན་གནས་པའི་རི་མོ་མཁན་རྣམས་བཀུག་ནས་སྨྲས་པ།",
    "དེ་ནས་ཨ་མྲ་སྐྱོང་མ་རྒྱན་སྣ་ཚོགས་ཀྱིས་བརྒྱན་ནས་རི་མོའི་ལས་རྣམས་ལ་སོ་སོར་བརྟགས་ཏེ་དྲིས་པ།",
    "སྐྱེས་བུ་འདི་ལྟར་ཆུ་ཞེང་གབ་པས་ནི་བདག་དང་ལྷན་ཅིག་དགའ་མགུར་སྤྱད་པར་ནུས་སོ་སྙམ་མོེ།",
    "ས་སྐྱོང་གིས་སྨྲས་པ།",
    "ལྷ་རེ་ཞིག་གཞན་ལྟ་ཞོག།",
    "ཡངས་པ་ཅན་ན་སྨད་འཚོང་མ་ཨ་མ་སྐྱོང་མ་ཞེས་བགྱི་བ་ཤིན་ཏུ་གཟུགས་དང་ལང་ཚོ་ཕུན་སུམ་ཚོགས་པ་སྒྱུ་རྩལ་དྲུག་བཅུ་རྩ་བཞི་འཚལ་བ་ལྷ་ཁོ་ནས་སྤྱད་དུ་རུང་བ་ཞིག་མཆིས་སོ།",
    "ཡངས་པ་ཅན་གྱི་ལིཙྪ་བཱི་རྣམས་ནི་ཡུན་རིང་པོ་ནས་གནོད་པ་བགྱིད་པ་སླར་རྒོལ་བ་དགྲ་བོ་ལགས་པས་ཁྱོད་ལ་གནོད་པ་བགྱིད་དུ་མཆིའོ།",
    "རིམ་གྱིས་ཡངས་པ་ཅན་དུ་ཕྱིན་ནས་ས་སྐྱོང་ནི་སྐྱེད་མོས་ཚལ་ན་སྡོད་དོ།",
    "རྒྱལ་པོ་ནི་ཨ་མྲ་སྐྱོང་མའི་ཁྱིམ་དུ་ཞུགས་པ་དང་།",
    "ཡངས་པ་ཅན་གྱི་ལིཙྪ་བཱི་རྣམས་རོད་རོད་པོར་གྱུར་ནས་ཤེས་ལྡན་དག་བདག་ཅག་གི་མི་མཛའ་ིབ་ཞིག་ནང་དུ་ཞུགས་པས་དྲིལ་འཁྲོལ་ལོ་ཞེས་སྒྲ་གསལ་བ་དང་།",
    "བཟང་མོ་འདི་ཅི་ཞིག་ཡིན།",
    "ཅི་ཞིག་གི་ཕྱིར།",
    "གལ་ཏེ་བུ་མོ་ཞིག་ཡིན་ན་ཁྱོད་ཉིད་ཀྱི་ཡིན་ནོ།",
    "ལྷ་ཅི་འདི་དག་དང་ལྷན་ཅིག་འཐབ་མོ་བགྱིའམ།",
    "ང་ནི་དུབ་པས་ཤིང་རྟ་དེད་ཀྱིས་ཁྱོད་ཁོ་ནས་འདི་དག་དང་ལྷན་ཅིག་འཐབ་མོ་ཁྱེས་ཤིག།",
    "དེས་དེ་རྣམས་དང་ལྷན་ཅིག་འཐབ་མོ་འགྱེད་པར་བརྩམས་པ་ལས་ཡངས་པ་ཅན་རྣམས་ཀྱིས་ངོ་ཤེས་ནས་དེ་རྣམས་ཀྱིས་སྨྲས་པ།"
