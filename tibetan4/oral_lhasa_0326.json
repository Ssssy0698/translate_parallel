    "ཁྱེད་ལ་བདག་ནི་འབུལ་ལགས་གྱི།",
    "ཨོཾ་བཛྲ་མུཞེས་མཐེབ་སྲིན་གྱིས་སེ་གོལ་བྱས་ཏེ་ཚོམ་བུའི་ཡེ་ཤེས་པ་གཤེགས།",
    "དམ་ཚིག་པ་རང་ལ་ཐིམ་པར་གྱུར།",
    "བསྔོ་སྨོན་དང་ཤིས་བརྗོད་ཀྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "ཞེས་འཕགས་པ་འཇམ་དཔལ་ནག་པོའི་རྗེས་གནང་བྱ་ཚུལ་བཀླགས་པའི་དོན་གྲུབ་ཅེས་བྱ་བ་འདི་ནི།",
    "སྒྲུབ་ཐབས་རྒྱ་མཚོའི་ཆིངས་པར་བརྟེན་ནས་བྲིས་པའོ།",
    "ཁྱད་པར་གྱི་སེམས་བསྐྱེད་ནི།",
    "ཞེས་སོགས་རྒྱུན་བཤགས་ལན་གསུམ།",
    "གནས་གསུམ་ཡི་གེ་གསུམ་གྱི་མཚན་པར་གྱུར།",
    "བསྡུས་ནས་སྔགས་འཕྲེང་ས་བོན་བཅས་ལ་ཐིམབློ་གྲོས་སྣང་བ་ཐོགས་མེད་རྒྱས་པར་གྱུར།",
    "ཤེར་ཕྱིན་གླེགས་བམ་རང་སྒྲ་སྒྲོགས་བཞིན་བཞུགས།",
    "སྐྱིལ་ཀྲུང་ཚུལ་གྱིས་བཞུགས་པའི་ཐུགས་ཀ་རུ།",
    "མཁྱེན་རབ་འཇམ་དཔལ་དབྱངས་དངོས་ལྟ་བུར་གྱུར།",
    "ཅེས་སོགས་བསྔོ་སྨོན་གྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "དལ་འབྱོར་རྙེད་དཀའ་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "མི་རྟག་འཆི་བ་དྲན་པར་བྱིན་གྱིས་རློབས།",
    "རྒྱུ་འབྲས་འཆོལ་མེད་དྲན་པར་བྱིན་གྱིས་རློབས།",
    "འགྲོ་ཀུན་ཕ་མར་ཤེས་པར་བྱིན་གྱིས་རློབས།",
    "ཐོས་བསམ་སྒོམ་སྒྲུབ་བྱས་པ་ལ་བརྟེན་ནས།",
    "མ་རྣམས་ཐར་བའི་གླིང་དུ་འདྲེན་པར་ཤོག།",
    "ཞབས་གཡས་རོལ་བའི་སྟབས་ཀྱིས་བཞུགས་པདེའི་དཔྲལ་བར་ཨོཾ་དཀར་བོ།",
    "མགྲིན་པར་ཨཱ་དམར་བོ།",
    "ཛ་ཧཱུཾ་བཾ་ཧོ་གཉིས་སུ་མེད་པར་གྱུར།",
    "དྲི་མ་དག་ཆུའི་ལྷག་མ་ཡར་ལུད་པ་ལས་མི་བསྐྱོད་པས་དབུ་བརྒྱན་པར་གྱུར།",
    "དར་སྣ་ཚོགས་ཀྱི་ན་བཟས་མཛེས་པར་བྱས་པ།",
    "ཞབས་གཡས་བརྐྱངས་ཤིང་གཡོན་སྐྱིལ་ཀྲུང་ཕྱེད་པས་བཞུགས་པ།",
    "དེའི་སྤྱི་བོར་ཨོཾ་དཀར་བོ་མགྲིན་པར་ཨཱ་དམར་བོ།",
    "སྐུ་གང་དྲི་མ་དག་ཆུའི་ལྷག་མ་ཡར་ལུད་པ་ལས་མི་བསྐྱོད་པས་དབུ་བརྒྱན་པར་གྱུར།",
    "དེ་ཡི་ས་ལ་འགོད་པར་ཤོག།",
    "ཅེས་སོགས་བསྔོ་སྨོན་གྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "དེ་ལས་འོད་འཕྲོས་རང་གཞན་དོན་གཉིས་བྱས།",
    "ཡེ་ཤེས་མེ་དཔུང་འབར་བའི་དབུས་ན་བཞུགས།",
    "སྤྱི་བོ་ཨོཾ་དཀར་མགྲིན་པར་ཨཱ་དམར་བོ།",
    "མི་བསྐྱོད་པ་ཡིས་དབུ་ལ་བརྒྱན་པར་གྱུར།",
    "མཆོག་ཐུན་དངོས་གྲུབ་མ་ལུས་འགྲུབ་པར་མཛོད་།",
    "བསམ་ངན་སྦྱོར་རྩུབ་གྲིབ་དང་མི་གཙང་དང་སྡིག་སྒྲིབ་ཐམས་ཅད་བྱང་ཞིང་དག་པར་གྱུརཨོཾ་པྲ་སོདཆུ་སོད།",
    "འདི་ལ་སྔགས་གསུམ་ཡོད་ཀྱང་དམ་པ་གོང་མ་རྣམས་ཀྱིས་སྔགས་འདི་གཙོ་བོར་མཛད་པས་འདིས་ཆོག་གསུངས།",
    "མཇུག་ཏུ་བསྔོ་སྨོན་གྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "རལ་གྲི་ཤེར་ཕྱིན་གླེགས་བམ་བཞུགས།",
    "བཞུགས་པའི་མདུན་དུ་པད་ཟླའི་སྟེང་།",
    "འགྱིང་བག་དང་བཅས་བཞེངས་སྟབས་བཞུགསཡབ་ཡུམ་གཉིས་ཀྱི་སྤྱི་བོ་རུ།",
    "ཨོཾ་དཀར་མགྲིན་པར་ཨཱ་དམར་བོ།",
    "སོགས་བསྔོ་སྨོན་རྣམ་པར་དག་པར་བྱའོ།",
    "ངང་ངུར་ལ་སོགས་ཆུ་བྱས་སྐད་སྙན་སྒྲོགས།",
    "པད་འདབ་བརྒྱད་དུ་རྣམ་པར་ཕྱེ་བའི་དབུས།",
    "སྤྲིན་མེད་ཉི་མ་ཇི་བཞིན་དྭངས་པར་མཛོད།",
    "འཇམ་དབྱངས་ཤེས་རབ་ཐོབ་པར་ཤོག།",
    "རང་ཉིད་འཇམ་དཔལ་དུ་གསལ་བའི་སྤྱི་བོར་ཨོཾ་དཀར་བོ་མགྲིན་པར་ཨཱ་དམར་བོ།",
    "པར་གསུངསམདུན་ངོས་མི་ནོར་བའི་རྟགས་གདབདེའི་ནང་དུ་ནས་འབྲས་གྲོ་ཏིལ་དཀར་ལ་སོགས་པའི་འབྲུ་སྣ་རྙེད་ཚད།",
    "གལ་ཏེ་མ་འགྲིག་ན་ཐོག་མ་ནས་རྩོལ་སྒྲུབ་བྱས་ཏེ་གཡང་སྐར་བཟང་བའི་ཉིན་གའུ་ལ་བླུག་གོདེའི་ནང་དུ་ལྟོ་བའི་སྟོད་ཙམ་དུ་རྗེ་བཙུན་ནོར་རྒྱུན་མའི་སྐུ་བྲིས་འབུར་གང་རུང་རབ་གནས་ཅན།",
    "མགྲིན་པར་ཨཱ་ཐུགས་ཀར་ཧཱུཾ།",
    "ཐོག་མེད་ནས་བསགས་སྡིག་ལྟུང་ཐམས་ཅད་བཤགས།",
    "མཆོད་བསྟོད་གོང་བཞིན་བྱས་རྗེས།",
    "ཡན་ལག་དྲུག་ཅུའི་དབྱངས་ལྡན་འགག་མེད་གསུང་ཤེས་བྱ་ཀུན་མཁྱེན་གཡོ་མེད་ཐུགས་མངའ་བ།",
    "མ་འབྱོར་བ་དང་སོགས་ནོངས་པ་བཟོད་པར་གསོལ།",
    "དེ་ཡང་མི་དམིགས་པར་སྟོང་བ་ཉིད་དུ་གྱུར།",
    "སྟོང་བའི་ངང་ལས་སླར་ཡང་རྗེ་བཙུན་མའི་སྐུ་རུ་བཞེངས་པར་གྱུར།",
    "སསྒྱུ་ཊ་ལསསྦྱིན་སྲེག་ལྷ་རྣམས་ཚིམ་པར་བྱེད།",
    "དངོས་གྲུབ་སྒྲུབ་པའི་ཐབས་ཕུལ་དུ་ཕྱིན་པར་གསུངས་ལ།",
    "བྱ་རྒྱུད་སྤྱི་ལྟར་ཁྲུས་དང་གཙང་སྦྲ་སོགས་ཤིན་ཏུ་གལ་ཆེ་ཞིང་དེ་ནས་ཐོག་མར་བདག་བསྐྱེད་ནི།",
    "ཛ་ཧཱུྃ་བཾ་ཧོ་རང་ལ་ཐིམ་པས་གཉིས་སུ་མེད་པར་གྱུར།",
    "ལྷ་རྫས་བཟང་བོ་མཆོད་ཡོན་འདིབཅོམ་ལྡན་འཁོར་དང་བཅས་ལ་འབུལའགྲོ་བའི་དོན་དུ་བཞེས་སུ་གསོལ།",
    "ཨོཾ་བཛྲ་མ་ཧཱ་ཀྲོ་དྷ་རཱ་ཛ་ས་བ་རི་ཝཱ་ར་ཨཉྙཾ་པྲ་ཏཱི་ཙྪ་སྭཱ་ཧཱ་དེ་བཞིན་དུ་འོག་མ་རྣམས་ལའང་འགྲེ་བར་བྱས་ཏེ།",
    "དམ་ཚིག་པ་འོད་དུ་ཞུ་ནས་རང་ལ་ཐིམ་པར་གྱུར།",
    "དེ་ཡི་ས་ལ་འགོད་པར་ཤོག།",
    "འཐོར་ནས་སོགས་ཉེ་བར་མཁོ་བའི་ཡོ་བྱད་ཚོགས་པར་བྱས་ཏེ།",
    "ནམ་མཁའི་ཁམས་གང་བ་འདི་ཉིདབཅོམ་ལྡན་འདས་ཁྲོ་བོའི་རྒྱལ་བོ་སྨེ་བ་བརྩེགས་པའི་ལྷ་ཚོགས་འཁོར་དང་བཅས་པ་རྣམས་ཀྱི་སྤྱན་ལམ་དུ་འབྱུང་ཞིང་རྒྱས་པར་གྱུར་ཅིག་ཨོཾ་ཨཉྙཾ་ཨཱ་ཧཱུཾ་ནས།",
    "ཞེས་པས་བསྲེག་རྫས་རྣམས་སྤྱིར་བཀྲུས་པར་བསམ།",
    "ཨཱ་སྭ་ཧཱས་ཡམ་ཤིང་དང་ཨོཾ་ཤྲཱི་སྭཱ་ཧཱས་ཞུན་མར་དང་ཨོཾ་ཛྫིཾསྭཱ་ཧཱས་འབྲུ་དང་ཨོཾ་ཀུ་རུ་སྭཱཧཱས་གཞན་པའི་རྫས་རྣམས་སྦྱངས་པར་བསམ།",
    "ཨོཾ་བཛྲ་ས་ཏྭ་ཨཱ་ལན་གསུམ་གྱིས་བྱིན་གྱིས་བརླབས་ༀ ཀུ་ཤ་འདི་ནི་གཙང་ཞིང་དགེཚངས་པའི་ལྷ་རྣམས་དག་བྱེད་ཅིང་།",
    "བསྲེགས་བླུགས་ཞལ་ཟས་བཞེས་སླད་དུ།",
    "འདི་ནི་ཡང་དག་བསྙེན་པར་མཛོད།",
    "འདི་ཉིད་དུ་ནི་བཞུགས་སུ་གསོལ།",
    "ཨོྃབཛྲ་སྤོ་ཊ་བཾཨོཾ་བཛྲ་གཎྜེ་ཧོ་དམ་ཚིག་པ་དང་གཉིས་སུ་མེད་པར་གྱུར།",
    "འཛིན་བྱེད་མེ་ལྷ་ཉིད་ལ་རྣམ་པར་འདུད།",
    "ཉེས་པའི་སྐྱོན་བྲལ་ཚངས་པར་སྤྱོད།",
    "དགང་བླུགས་ཀྱི་ཁ་ལ་ཧཱུཾ་ཡིག་འོད་ཟེར་དང་བཅས་པས་མཚན་པར་གྱུར།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་དུ་གཟི་བརྗིད་ཕུན་སུམ་ཚོགས་པ་ལ་བར་དུ་གཅོད་པ་ཐམས་ཅད་ཤཱནྟིཾ་ཀུ་རུ་ཡེ་སྭཱཧཱམར་ཁུཨོཾ་ཨགྣ་ཡེ་ཞེས་པ་ནསབ་ཧ་ནཱ་ཡཨོཾ་ཨགྣ་ཡེབདག་ཅག་ནསཐམས་ཅད་དང་ཁྱད་པར་དུ་ཡང་འབྱོར་བ་ཕུན་སུམ་ཚོགས་པ་ལ་བར་དུ་གཅོད་པ་ཐམས་ཅད་ཤཱནྟིཾ་ཀུ་རུ་ཡེ་སྭཱ་ཧཱཏིལ་ལཨོཾ་ཨགྣ་ཡེ་ནས།",
    "ཁྱད་པར་དུ་སྡིག་སྒྲིབ་ཐམས་ཅད་ཤནྟིཾ་ཀུ་རུ་ཡེ་སྭཱ་ཧཱདུར་བ་ལཨོཾ་བཛྲ་ཨཱ་ཡུ་ཥེ།",
    "གྲིབ་དང་མི་གཙང་བ་ཐམས་ཅད་ཤནྟིཾ་ཀུ་རུ་ཡེ་སྭཱཧཱ།",
    "ལྷའི་སྐུ་ལས་འོད་ཟེར་དཀར་པོའི་ཚོགས་འཕྲོས་པར་གྱུར།",
    "མགྲིན་པར་ཨཱ་ཐུགས་ཀར་ཧཱུཾ།",
    "དངོས་རྣམས་མ་ལུས་ཡང་དག་མཁྱེན་གྱུར་པའི།",
    "ཁྱེད་བཞེད་འགྲོ་དོན་མཛད་དུས་འདི་ལགས་ན།",
    "འགྲོ་བའི་དོན་དུ་བཞུགས་ནས་ཀྱང་།",
    "མཆོག་རྣམས་ལེགས་པར་བསྩལ་དུ་གསོལ།",
    "འདི་ཉིད་དུ་ནི་བཞུགས་སུ་གསོལ།",
    "དེ་སྲིད་བཅོམ་ལྡན་བཞུགས་སུ་གསོལ།",
    "ཛ་ཧཱུྃ་བཾ་ཧོ་དམ་ཚིག་པ་དང་གཉིས་སུ་མེད་པར་གྱུར།",
    "དྲི་མ་དགཆུའི་ལྷག་མ་སྤྱི་གཙུག་ཏུ་གནས་པ་ཡོངས་སུ་གྱུར་པ་ལས་མི་བབསྐྱོད་པས་དབུ་བརྒྱན་པར་གྱུར།",
    "བཞེས་ནས་བདག་ལ་དངོས་གྲུབ་སྩོལ།",
    "བཞེས་ནས་བདག་ལ་དངོས་གྲུབ་སྩོལ།",
    "ཉེས་བྱས་ཅུང་ཟད་གང་བགྱིས་པ།",
    "མགོན་པོས་དེ་ཀུན་བཟོད་པར་གསོལཞེས་ནོངས་པ་བཟོད་པར་གསོལ།",
    "སླར་ཡང་འབྱོན་པར་མཛད་དུ་གསོལ།",
    "མར་ཁུ་དགང་བླུགས་གསུམ་ཕུལ་བསཐབ་ཀྱི་མེ་དེ་ཉིད་སླར་ཡང་མེ་ལྷའི་སྐུར་བཞེངས་པར་གྱུར།",
    "གདོན་དང་བགེགས་རྣམས་མེད་པར་མཛོད།",
    "བྱ་བྱེད་ངན་རྣམས་མེད་པར་མཛོད།",
    "ལེའུ་བཅུའི་ཐོག་མ་དགྲ་བཅོམ་པའི་ལེའུ་འང་འདི་ནས་འདྲེན་པར་གསུངས།",
    "ཕུག་ལུགས་པས་དྲག་པོ་ལྕགས་སྤྲེལ་ལ་སྐུ་བལྟམས་པར་འདོད་པས།",
    "རྨི་ལམ་ལེགས་པར་བརྟགས་ཏེ་གནང་བ་ཐོབ་པའི་མཚན་མ་བྱུང་བ་ན་བགྲོད་པར་བྱ་བ་ཡིན་གྱིས།",
    "ཡི་དམ་ལྷའི་གནང་བ་ཐོབ་པ་དགོས་པར་གསུངས་པ་དང་དེ་ཙམ་གྱིས་མི་ཆོག་སྟེ།",
    "ཨ་བྷི་ཏའི་ཁུ་བ་ལ་སོགས་པ་རྨད་དུ་བྱུང་བའི་གཏོར་མ་དང་སྦྱིན་སྲེག་སྟོང་ཕྲག་བཅུས་མཉེས་པར་བྱ་སྟེ།",
    "ཞེས་སོགས་གསུངས།",
    "མི་ཕལ་བ་རྣམས་ཀྱིས་ཀླ་ཀློས་གང་བའི་འཇིག་རྟེན་ཕལ་བ་ལྟ་བུར་མཐོང་བར་གསུངས་པ་ལྟ་བུ་ཆེས་མང་།",
    "དུས་འཁོར་གྱི་སྐོར་རྒྱས་པར་གསན་ནས་སླར་རྒྱ་གར་དུ་ཕེབས་ཏེ་སྤེལ་བ་དང་དུས་ཞབས་པ་ཆེན་པོའི་ཤམྦྷ་ལ་དང་ཉེ་བའི་ཐང་དུ་རིགས་ལྡན་གྱི་སྤྲུལ་བ་ལས།",
    "ཐུགས་ཀྱི་སྲས་གཅིག་མཁས་གྲུབ་དགེ་ལེགས་དཔལ་བཟང་བོ་ལ་གནང་།",
    "བརྡུང་འཇགས་ལེགས་པར་བྱས་པའི་སྟེང་མཎྜལ་མཆོད་གཏོར་སོགས་བཤམས་ནསས་བསླངས་ཆོ་ག་གཞུང་བཞིན་བྱདེ་ནས་ཕྱོགས་ལྟའི་ཙཀྲ་སོགས།",
    "བརྟེན་ནས་ཤར་ནུབ་ངེས་བྱས་ཏེ།",
    "ཚངས་ཟུར་བྱས་རྗེས་བཙལ་ཚུལ་སོགས།",
    "སྤྱི་ལྟར་བྱས་ཏེ་གྲུ་བཞིར་གདབ།",
    "ཆ་ཆེན་ཐིག་ནི་གདབ་པར་བྱ།",
    "ཆ་ཆུང་དགུ་བཅུ་བགྲོད་པར་བྱེད།",
    "ཕྱི་ནུར་བྱེད་དགོས་འདྲ་ཞེས་གསུངས།",
    "ཉལ་ལུགས་ཇི་བཞིན་ངེས་བྱས་ནས།",
    "བྱས་ཏེ་ཚངས་ཐིག་དང་བོ་འདེབསཐིག་ཆེན་གཞན་ཀྱང་སྤྱི་ལྟར་གདབ།",
    "དེ་ལྟར་བྱས་ནས་ཕྱོགས་གང་ནས།",
    "མགྲིན་པར་དམར་བོ་དཔུང་བར་སེར།",
    "མགོ་བོ་སྟོན་ཕྱོགས་ཤར་བྱས་པའི།",
    "མཆོད་གཏོར་ཐམས་ཅད་འདུ་བྱས་ནས།",
    "ཆོ་གའི་གཞུང་བཞིན་ཤེས་པར་བྱ།",
    "བྱས་ཏེ་བཟུང་ལ་ཁ་ཤར་ཕྱོགསདེ་ཉིད་ཁྲོ་བོ་བགེགས་མཐར་བྱེད།",
    "བསྐྱེད་ཆོག་ཆོ་ག་བཞིན་བྱས་ནསཤར་དུ་ཕྱོགས་དེ་བརྐོ་རུང་བའིས་ནས་འཇོར་ཁམ་བཞི་ཙམ་བརྐོ།",
    "སྔར་སྒྲུབ་སྟ་གོན་བྱས་པ་ཡི།",
    "ཤིས་པའི་ལས་སུ་རྒྱུད་ལས་གསུངས།",
    "རྣམ་པར་སྤྲོས་པའི་མན་ངག་ག་བུར་རྒྱུནབློ་གསར་བློ་ཡི་གཉེན་དུ་འབབ་པའི་ཆེད།",
    "བརྟག་ཚུལ་ཞིབ་པར་བི་བྷཱུ་ཏཱིའི་དཀྱིལ་ཆོག་ལསལྷ་ཁང་མཆོད་རྟེན་ཁང་བཟང་ཁང་བརྩེགས་དང་།",
    "ཤར་གྱི་ས་དེ་དགུ་བཅུར་རྣམ་པར་དབྱེ།",
    "བདེན་བྲལ་མཚམས་ལ་སོགས་པར་མཇུག་མའི་ཆ།",
