    "རང་གི་རྒྱུ་རྐྱེན་ལས་སྐྱེ་དགོས་ཀྱི་རང་གི་བདག་ཉིད་ལས་སྐྱེ་བ་མེད་པའི་ཕྱིར་རོ།",
    "རང་གི་མཚན་ཉིད་ཀྱིས་རྣམ་པར་གནས་པ་ནི་མ་ཡིན་པས།",
    "རྫས་སུ་མེད་བཞིན་དུ་ཕྱིན་ཅི་ལོག་གི་རྟོག་པས་ཀུན་བརྟགས་པ།",
    "དཔེར་བརྗོད་རིམ་པ་བཞིན་གང་ཟག་གི་བདག་ལྟ་བུ་དང་།",
    "བྱས་མི་རྟག་གི་ཐ་དད་ལྟ་བུའོ།",
    "དེས་ན་ཀུན་བརྟགས་མཚན་ཉིད་ངོ་བོ་ཉིད་མེད་པའི་དོན་རང་གི་མཚན་ཉིད་ཀྱིས་མེད་པ་ཡིན་གྱི་མཚན་ཉིད་གཏན་ནས་མེད་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལ་དམིགས་ནས་བསྒོམས་པས་སྒྲིབ་པ་དག་པར་འགྱུར་བའི་དམིགས་པ་མཐར་ཐུག་ཡིན་པར་ཐལ།",
    "དེ་རང་གི་མཚན་ཉིད་ཀྱིས་གྲུབ་པའི་ཕྱིར་ཏེ།",
    "རང་བཞིན་གྱིས་ཞེས་བྱ་བ་ནི་ཚིག་གི་ལྷག་མའོ་ཞེས་ཡང་དག་པ་མ་ཡིན་པའི་ཀུན་ཏུ་རྟོག་པ་རང་བཞིན་གྱིས་ཡོད་པར་གསུངས་ཤིང་།",
    "ཚིག་གི་ལྦུ་བས་ནམ་ཡང་མི་ངོམས་པར།",
    "རྗེ་བཙུན་སྤྱན་རས་གཟིགས་ཀྱིས་དངོས་སུ་བྱིན་གྱིས་བརླབས་པའི་གནས་མཆོག་རི་བོ་པོ་ཏ་ལ་དང་ཁྱད་པར་མ་མཆིས་ཤིང་།",
    "སྐྱེ་བོས་ནོར་འཛིན་ཁྱོན་རྣམས་ཡོངས་གང་ཞིང་། འགྲོ་བའི་རྨོངས་མུན་སེལ་ཏེ་ལུང་རྟོགས་ཀྱི།",
    "སྤྱི་ལོ་༢  ༡ ༡ ཟླ་བ་༦པའི་ཚེས་༡༥བོད་རབ་བྱུང་བཅུ་བདུན་པའི་ལྕགས་ཡོས་བོད་ཟླ་༤པའི་ཚེས་༡༥དུས་ཚེས་བཟང་པོར་པར་ཐེངས་དང་པོ་དཔར། ། སེར་གཙུག་ནང་བསྟན་དཔེ་རྙིང་འཚོལ་བསྡུ་ཕྱོགས་སྒྲིག་ཁང་གི་དཔེ་རྙིང་བསྡུ་སྒྲིག་དང་ལས་ཞུགས་མི་སྣའི་མཚན་ཐོ།",
    "ལྷག་པར་ལོ་མང་རིང་རེ་བསྒུག་གིས་ཐང་ཆད་ལ་ཉེ་བའི་གྲོགས་པོ་ལྷན་རྒྱས་ཀྱི་རྣ་བའི་བུ་གའི་ཕྱོགས་སུ།",
    "རང་གི་ལུས་སྟེང་དུ་བོད་གངས་ལྗོངས་ཀྱི་ཁྲག་རྒྱུན་ཡོད་པ་དེ་ལའང་ངོ་ཚ་དགོས་པར་མཐོང་།",
    "དོན་དངོས་ལྷག་བསམ་དཀར་པོའི་བ་དན་ལས་འཁྲུངས་པའི་རྒྱལ་གཅེས་དང་མི་རིགས་ལ་རྒྱ་གཙིགས་སུ་འཛིན་ནས་རྒྱུ་ནུས་ཀྱི་མཐུན་རྐྱེན་དང་འགྲོ་གྲོན་བཏང་ནས་ར་མ་ལུག་གི་མི་རབས་གསར་པའི་ཡོལ་བ་དེ་བཤུ་དགོས་པ་དང་།",
    "རྒྱ་ཆེའི་ཀློག་མཁན་ནང་སློབ་དཔོན་གང་གི་རྣམ་དཔྱོད་ཀྱི་རྩལ་ལས་འཁྲུངས་པའི་གསུང་གི་བདུད་རྩིར་སྤྱོད་འདོད་པ་མང་པོ་ཞིག་ཡོད་ངེས་པས།",
    "དེ་བཞིན་ད་ཡོད་གང་གི་གསུང་སྒྲ་འཛིན་འཁོར་ཐག་དང་།",
    "དེ་ནས་གཏིང་ཡལ་དུ་སོང་བས་བློ་འགྱོད་ཆེན་པོ་བྱུང་ཡང་ཅི་བྱ།",
    "ལྷག་པར་ཕྱོགས་སྒྲིག་སྐབས་ཞུ་དག་གི་བརྒྱུད་རིམ་ཆ་ཚང་ནང་དུས་ཚོད་ནར་གཏོང་གནང་བར་རྒྱ་ཆེའི་ཀློག་པ་པོ་རྣམས་ཀྱི་མགྲིན་ཚབ་ཞུས་ནས་ཐུགས་རྗེ་ཆེ་བླ་ལྷག་ཏུ་ཞུ་རྒྱུ།",
    "ཛམ་གཡུ་སྤེན་པ་ཚེ་རིང་གིས།",
    "དེ་དག་གིས་རྒྱུད་སླད་པས་སྤྱོད་ངན་གྱིས་སྣོད་བཅུད་ཀྱི་འབྱོར་བ་རྣམས་མར་ངོའི་ཟླ་བ་བཞིན་འགྲིབ་པའི་དུས་འདིར།",
    "འགའ་རེ་ཡོད་པ་རྣམས་ཀྱང་རྗེ་ས་པཎ་གྱིས།",
    "མི་རིགས་གཞན་གྱི་ལེགས་བྱང་གི་སྐོར་ལ་རང་རིགས་རྣམས་གློག་ཧྲུལ་དུ་སོང་བས་ལེགས་བྱས་ཀྱི་གསེར་སྦྲམ་མ་འབྱར་ཞིང་།",
    "འགའ་རེ་ལག་བྲིས་བྱས་པའང་ཡོད་མོད།",
    "བརྟག་པ་མཐའ་བཟུང་གིས་དགོས་ངེས་དང་མེད་དུ་མི་རུང་བ་ཞིག་མཐོང་ཞིང་བྲིས་ནའང་དེང་གི་དུས་བློ་གཟུ་བོར་རྒྱུ་བ་དཀོན་ཞིང་།",
    "ཁ་སོ་མེད་ལ་སོ་ཁྲལ་འཇལ་དགོས་པའི་དུས་སྐབས་འགའ་ཞིག་བྱུང་སྐབས་དེར་ཁ་ཁྲལ་འཇལ་བྱེད་དུ་རེག་ཟིག་ཏུ་བཏབ་པ་འགའ་རེ་ཡོད་པ་རྣམས་བྱི་ལའི་རང་རྟུག་གི་དཔེ་བཞིན་རང་སློབ་འགའ་རེས་གློག་ཀླད་དུ་བཅུག་རྒྱུ་དང་།",
    "འདི་དག་ཕྱོགས་སྒྲིག་པར་བསྐྲུན་བྱ་རྒྱུའི་རེ་འདུན་བྱུང་བར།",
    "དང་པོ་ནི་སྔར་གྱི་བསམ་ཚུལ་དེས་དྲངས་ནས་ཅི་མེད་ཅང་མེད་བདག་ལྟ་བུས་རྣམ་གཡེང་འདུ་འཛིའི་ཀློང་ནས་བརྡོལ་བའི་ཚིག་རྫོབས་རྣམས་དེབ་གཟུགས་སུ་བཀོད་པ་ནི་རང་གི་མཚང་རྡོལ་བ་དང་།",
    "འགའ་རེས་སློབ་ཟུར་རྣམས་ནས་ཅི་འབྱོར་གྱིས་འགྲོ་གྲོན་བསྡུ་རུབ་བྱས་ནས་པར་སྐྲུན་བྱ་རྒྱུ་གཏན་འཁེལ་ཟིན་པས་ཁྱོད་ཀྱིས་ཁས་ལེན་བྱེད་དགོས་ཨུ་ནན་བྱས་པ་དང་།",
    "དེང་གི་འཕྲུལ་ཐབས་རིག་པ་པས་སྒྲ་མི་རྟག་པའི་སྒྲུབ་ངག་དང་སུན་འབྱིན་གྱི་རིགས་པ་མར་ཁུ་རྣམས་ཆུར་བསྒྱུར་ཟིན་པས་རང་གིས་བསམ་པ་སྨྲས་པ་དག་གིས་ཕན་གནོད་གང་ཡིན་བྱ་བ་འདུ་བྱས་ཚར་བས་ཁྱད་པར་མེད་ཚུལ་གྱི་བསམ་འཆར་བྱུང་བར་བདེན་པར་གོ་ཞིང་།",
    "ད་དུང་ཁས་མ་བླངས་ན་པར་སྐྲུན་གྱི་འགྲོ་གྲོན་ལ་འཇུར་གེགས་བྱས་ནས་མི་གཏོང་བའི་མི་སྙན་པ་གཞན་ལ་བསྒྲོགས་པར་དོགས་ནས་ཁོང་རྣམས་ཀྱི་རེ་བ་བཞིན་ཁས་ལེན་མི་བྱེད་མཐུ་མེད་བྱུང་།",
    "བར་ཞུ་དག་ཐ་མར་ཕབ་བསྒྱུར་༡བྱེད་པ་སོགས་ལས་དོན་དུ་མ་ཞིག་ལྗིད་ཚད་ཆེ་བའི་རང་གི་སློབ་ཞོར་དུ་ལྟོ་ཆག་གཉིད་ཆག་དང་།",
    "ཐ་ན་འགྲོ་གྲོན་མང་པོ་བཏང་ནས་ལྷག་བསམ་རྣམ་དག་གི་བྱས་པ་མཐའ་དག་དང་།",
    "ཁྱེད་རྣམ་པས་རང་མི་རིགས་དང་རིག་གཞུང་ལ་བཅང་བའི་རྣམ་པར་དཀར་བའི་ལྷག་བསམ་གྱི་རེ་བ་ཡིད་བཞིན་དུ་འགྲུབ་ནས་བསྟན་དང་འགྲོ་བའི་བདེ་སྐྱིད་ཀྱི་དཔལ་དུ་གྱུར་བའི་རེ་སྨོན་གྱིས་མཚམས་སྦྱོར་རྒྱུ་ཡིན།",
    "སུ་རེ་ནྡར་བོ་དྷི་སོགས་ཀྱིས་བདེ་བར་བཤེགས་པའི་བཀའ་བསྟན་རྣམས་ལས་བྱུང་བའི་རྒྱ་གར་གྱི་སྐད་ལས་གངས་ཅན་པའི་སྐད་དུ་བསྒྱུར་ཞིང་མིང་དུ་བཏགས་པ་རྣམས་དཀར་ཆག་ཏུ་བྲིས་ཏེ་ནམ་ཡང་གཞུང་ལུགས་དེ་ལས་མི་བསྒྱུར་ཞིང་རག་རྡོ་བློ་བཟང་བསྟན་འཛིན་གྱི་དཔྱད་རྩོམ་ཐོར་བུ།",
    "ར་ས་འཕྲུལ་སྣང་སོགས་སུ་བཞུགས་པའི་ཕྱི་མོ་རྣམས་དང་།",
    "དུས་ཉེ་བར་ཐམས་ཅད་མཁྱེན་པའི་ཡོན་ཏན་རྒྱ་མཚོའི་འཇུག་ངོགས་སུ་གྱུར་པའི་རིག་པའི་གནས་ལྔ་ཡན་ལག་དང་བཅས་པ་ཚུལ་བཞིན་གཟིགས་ཞིང་།",
    "འགྲང་བྱ་བདུན་ནས་རང་གི་ཁུ་བོ་ལས་ཡོན་ཏན་ཀུན་གྱི་གཞི་མར་གྱུར་པ་ཡིག་གེ་འབྲི་ཀློག་ལ་སྦྱངས།",
    "དེ་ནས་ནིམི་རིང་པར་ངོར་ཁང་གསར་བླ་བྲང་གི་དྲུང་ཡིག་གི་ཁུར་བཞེས།",
    "རྗོད་བྱེད་སྙན་ངག་གི་རྒྱན་གྱི་ལམ་ནས་དྲངས་ཏེ་སྙན་ཞིང་འཇེབས་པས་མཁས་རྣམས་མགུ་བ་སྐྱེད་པའི་མཆོད་སྤྲིན་དུ་གྱུར་པ།",
    "ཧ་ཅང་གོ་དཀའ་བའི་མངོན་བརྗོད་སོགས་ཀྱིས་མ་བསྒྲིབས་ཤིང་ཤེས་བྱ་སྤྱིའི་ཁོག་དབུབ་སྟེ་རྒྱས་བསྡུས་འཚམ་པས་བློ་ཐ་མར་ལུས་པ་དག་ཀྱང་བདེ་བླག་ཏུ་འཇུག་ཐུབ་པ་བཅས་གང་གིས་མཐོང་ཡང་བསྔགས་པར་འོས་པའི་ཡོན་ཏན་གྱི་ཁྱད་པར་དུ་མ་དང་ལྡན།",
    "འདི་ཉིད་ལྕགས་པར་དུ་བཏབ་པའི་བྱ་རིམ་ནང་འཚོལ་སླ་ཕྱིར་གཞུང་གི་ས་བཅད་དང་མཐུན་པར་དཀར་ཆག་བསྒྲིགས་པ་དང་།",
    "ཐུན་མོང་མིན་པའི་རིག་ཅིང་ཤེས་པར་བྱ་བའི་གནས་ཆེ་བ་ལྔ་དང་ཆུང་བ་ལྔ་ཞེས་བཅུ་ཕྲག་ཏུ་གྲགས་པ་གང་དག་བསྡུ་ན་ཚར་གཅོད་རྗེས་འཛིན་ཀུན་མཁྱེན་ཐོབ་བྱའི་ཐབས་ཀྱི་བདག་ཉིད་གསུམ་དུ་འདུ་བ་ལས།",
    "བར་ནང་གི་སྤྲིན་དང་འདབ་ཆགས།",
    "འགྲོ་བ་ཉམས་ཐག་པའི་སྡུག་བསྔལ་སྤྱན་གྱིས་གཟིགས་པའམ་སྙན་དུ་སོང་བའི་མོད་ལ་སྤྱན་ཆབ་བསིལ།",
    "གཙང་གི་མཁས་པ་དཔལ་ལྡན་སེངྒེ།",
    "མཚན་མོར་མཚན་རག་རྡོ་བློ་བཟང་བསྟན་འཛིན་གྱི་དཔྱད་རྩོམ་ཐོར་བུ།",
    "བཅས་མཚན་མེད་ཀྱི་ཐུགས་དམ་ཟབ་མོ་གཡེལ་མེད་མཛད་པས་ཡི་དམ་གྱི་ལྷ་དུ་མས་ཞལ་བསྟན།",
    "དེ་ནས་རྐྱེན་ཅུང་ཟད་ཅིག་གིས་བསྐུལ་ནས་ལེགས་པར་སྦྱར་བའི་སྒྲ་དང་སྙན་དངགས་སོགས་ལ་སློབ་པ་དང་།",
    "བདག་ལ་ཚེ་གཅིག་ལུས་གཅིག་ལ་འཚང་རྒྱ་བའི་གདམས་པ་ཟབ་མོ་སྦྱོར་བ་ཡན་ལག་དྲུག་ཐུགས་ལ་གདགས་པ་ཞུ་ཞུས་པས།",
    "ལས་འཕྲོ་དང་མོས་གུས་ཐུན་མོང་མ་ཡིན་པ་མངའ་བས་སྣོད་ལྡན་དུ་གདའ།",
    "སྐྱེ་འགག་གནས་གསུམ་གྱིས་སྟོང་པའི་བློ་འདས་འོད་གསལ་དུ་གདོད་ནས་ཟངས་ཐལ་དུ་དགོངས།",
    "ལྷོ་མོན་གྱི་ཡུལ་ནས་ཤིང་ཆ་ཚན་ཆེན་དྲངས།",
    "ཤར་རྒྱ་ནག་གི་བཟོ་བོ་མཁས་པ་མང་པོ་བོས།",
    "གློ་འབུར་མིག་མང་རིས་སུ་བྲིས་པ་གཡུ་ཆུའི་བ་གམ་དང་ལན་ཀན་ཅན་གསེར་གྱི་མེ་ཏོག་གིས་བརྒྱན་པ།",
    "སྐུ་ཞང་མཆོག་གིས་ཉེ་གནས་དང་གསོལ་ཇ་བ་སོགས་ཆེད་དུ་བསྐོས་ཏེ་མཆོད་ཆ།",
    "གསོལ་ཇ་ནམ་རེས་སུ་གསོལ་ལྕོག་ཕུད་ཕོར།",
    "ཉིན་འཆད་ཉན་དང་མཚན་མོར་རྩོམ་ཞུས་སོགས་ཐུགས་བརྩོན་རྒྱུན་འཁྱོངས་མཛད།",
    "སྟག་ཚལ་འོར་མོ།",
    "སོག་ཐོ་གན་ཐི་མོར།",
    "འདི་དག་གི་སྐབས་སྔ་ཕྱི་རྣམས་སུ་གཞི་འགྱུར་མཛད་པ་ཀ་ལཱ་པའི་འགྲེལ་བ་དུརྒ་སེང་ཧའི་འཕྲོ་བསྒྱུར།",
    "དགུང་གྲངས་ང་དྲུག་པ་རབ་བྱུང་དྲུག་པའི་ཤིང་སྤྲེལ་སྤྱི་ལོ་༡༣༤༤ལོའི་ཟླ་བ་བཅུ་པར་ཧོར་རྒྱལ་པོས་གདན་འདྲེན་པའི་གསེར་ཡིག་པ་འབྱོར་ནས་རྒྱལ་པོའི་གསེར་ཡིག་ཕུལ་བས་རྒྱ་ནག་ཏུ་འགྲོ་བར་དགག་བྱ་ཆེ་ཞིང་དགོས་པ་ཆུང་བར་གཟིགས་ནས་དབེན་པ་བསྟེན་པའི་ཟོལ་གྱིས་གཞན་དུ་ཕེབས་ནས་རྒྱ་ནག་ཏུ་མ་ཕེབས།",
    "དགུང་གྲངས་རེ་གཉིས་པ་ལྕགས་ཡོས་སྤྱི་ལོ་༡༣༥༡ལོར་གཡའ་ཕག་གཉིས་ཀྱི་འཁྲུགས་ཟླུམ་དུ་དབུས་སུ་ཆིབས་ཞབས་བསྒྱུར།",
    "དུ་རི་ཕུག་ཏུ་སྐུ་འབུམ་མཐོང་གྲོལ་ཆེན་མོ་བཞེངས་པའི་རྨང་བཏིང་།",
    "འདིའི་དཔངས་སུ་ཁྲུ་རེ་དགུ།",
    "ཞེང་དུ་ཁྲུ་ཉེར་གསུམ་ཅན་རྩེ་མོར་རྡོ་བ་ཆེན་པོའི་གདུགས་ཅན།",
    "དེ་དག་ནི་སྐུ་འབུམ་ཆེན་མོའི་ལོ་རྒྱུ་ལས་འཕྲོས་པའོ།",
    "དགུང་གྲངས་རེ་བཞི་པ་ཆུ་སྦྲུལ་སྤྱི་ལོ་༡༣༥༣ལོར་ཁྲོ་ཕུའི་གདན་ས་མཛད།",
    "དགུང་གྲངས་རེ་ལྔ་པ་ཤིང་རྟར་སྤྱི་ལོ་༡༣༥༤སླར་ཡར་ཞྭ་ལུར་ཕེབས།",
    "རྩེ་མོ།",
    "གདན་ས་བཟུང་ནས་ལོ་སོ་བདུན་སོང་།",
    "ཟླ་བ་བཞི་པའི་ཚེས་གཅིག་ནས་སྐུ་མཚམས་གྲོལ་ནས་དུས་འཁོར་སྒྲུབ་མཆོད་ཆེན་མོའི་ཚོགས་དབུར་ཕེབས།",
    "དལ་དག་མྱུར་དག་དག་པའི་ལོངས་སྤྱོད་ཉིན་རེ་བཞིན་སྣོན་པ་དང་འབྲིད་པར་བྱེད་པ།",
    "དེ་ལ་བོད་ཆེན་པོའི་ལྗོངས་འདིར་ཡོངས་སུ་གྲགས་པའི་ཤེས་བྱ་རིག་པའི་གནས་བཅུ་ལས་སྙན་ངག་གི་རིག་པ་འདི་ནི་སྒྲ་རིག་པའི་ཁོངས་སུ་གཏོགས་པ་ཡིན་ཏེ།",
    "དེ་ལྟ་བུའི་བརྡ་སྤྲོད་པའམ་དེ་ཉིད་རྗོད་བྱེད་སྤྲང་པོའི་ཕྱེ་ལྟར་གྱུར་ན་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་ཟབ་རྒྱས་ཀྱི་བརྗོད་བྱ་ཐམས་ཅད་སྟོན་པར་མི་ནུས་པས་མིང་གི་རྣམ་གྲངས་དུ་མ་དང་ལྡན་པ་ལ་མངོན་བརྗོད་དང་།",
    "དེ་དག་ལས་ཀྱང་ཟློས་གར་ནི་སྙན་ངག་གི་ཉམས་དང་ལྡན་པ་ཡིན་ཞིང་།",
    "འབྱིན་མི་གཏུབ་པའི་ཕལ་སྐད་དང་གྲོང་ཚིག་གིས་མི་གོས་པ་དང་།",
    "རང་རིགས་ཀྱི་བདེ་རྩར་སོང་བའི་བྱ་བ་དང་བྱེད་པོའི་གང་ཟག་རྣམས་དང་།",
    "དེར་མ་ཟད་སྙན་དངགས་ཀྱི་གཞུང་འདིར་མ་སྦྱང་ན་རང་གིས་བསྟན་བཅོས་རྩོམ་ཞིང་གཞན་ལ་འཆད་པ་ལྟ་ཅི།",
    "རྒྱ་ལ་ཅུང་ཟད་གོ་ཡང་ལོག་རྟོག་གམ་ཕྱོགས་རེ་ཙམ་ལས་དེ་དག་གི་གྲངས་དང་གོ་རིམ།",
    "རྗོད་བྱེད་ཀྱི་སྒྲ་སོགས་ཆ་ཕྲ་མོ་རེར་ཡང་རབ་མངར་དོན་གྱི་སྦྲང་རྩི་འབུམ་དུ་འཛག་པ་རྣམས་རིག་གཞུང་རག་རྡོ་བློ་བཟང་བསྟན་འཛིན་གྱི་དཔྱད་རྩོམ་ཐོར་བུ།",
    "བློ་ཡི་རྩལ་ལས་སྙན་ངག་གི་ཚིག་སྦྱོར་སྣ་ཚོགས་རྩོམ་ནུས་པའི་ངག་སྒོ་ཡངས་པ་ནི་སྙན་ངག་ཕུན་སུམ་ཚོགས་པའི་རྒྱུའི་གཙོ་བོ་ཡིན་ནོ།",
    "རང་རེ་གངས་ཅན་ཡུལ་དུ་སྤྱི་ལོའི་དུས་རབས་བཅུ་གསུམ་པར་བོད་དུ་བསྒྱུར་བའི་སྙན་སྙན་འགྲེལ་མཚོ་དགྱེས་འཛུམ་ཟེར་གྱི་སྐྲུན་ཆེད་བརྗོད།",
    "དེས་ན་སྙན་དངགས་ཀྱི་གཞུང་འདི་ཉིད་ལ་གདུལ་བྱ་རྣམས་དཀྲི་བའི་སླད་དུ་ཤོང་དཔང་ཡབ་སྲས་སོགས་སྔོན་བྱོན་མཁས་པ་རྣམས་ཀྱིས་རང་གིས་གཟིགས་པའི་དོན་རྣམས་ཡི་གེར་བཏབ་སྟེ་འགྲེལ་ཊཱིཀ་མཐའ་ཡས་པ་ཡིག་འཇོག་མཛད་པ་རྣམས་ཀྱི་མན་ངག་ལ་བརྟེན་ནས་གཞུང་གི་དོན་རྟོགས་པར་བྱ་དགོས་པ་ཡིན་མོད།",
    "གཞན་དག་གིས་མ་བརྟག་མ་དཔྱད་པའི་རང་ཚིག་གི་སྲད་བུར་བསྟར་བའི་དོ་ཤལ་བསྐྲུན་ཀྱང་བློ་ལྡན་སྐྱེ་བོ་དག་གིས་མགྲིན་རྒྱན་དུ་མི་འོས་པ་སོགས་ལ་བརྟེན།",
    "དེང་འདིར་དབྱངས་ཅན་མགྲིན་པར་ཆགས་པ་སྙན་དངགས་སྨྲ་བ་ཧོར་གཙང་འཇིགས་མེད་མཆོག་གིས་མཛད་པའི་རྒྱན་གྱི་བསྟན་བཅོས་མཚོ་བྱུང་དགྱེས་པའི་འཛུམ་ཟེར།",
    "རིགས་པའི་འགྲོས་དང་མཐུན་ཞིང་བློ་བསྐྱེད་སྟེར་བའི་ལེགས་ཆ་ཕྲ་མོ་ཚུན་ཡང་བསྡུས་ཏེ་རང་ལུགས་དམིགས་བསལ་ཐག་གཅོད་གཙང་མ་མཛད་ཡོད།",
    "ཕྲ་མོའི་སྒོ་ནས་ཐག་གཅོད་མཐིལ་ཕྱིན་མཛད་དེ་དབྱེ་བ་གསལ་བར་ཕྱེས་པ་དཔེར་ན།",
    "བུང་བ་སོགས་བརྗོད་བྱ་ཕྱོགས་རེ་བར་སྦྱར་བའི་དཔེར་བརྗོད་མཛད་པ་དེས་བློ་སྐྱེད་ཐོན་ཉུང་བར་དམིགས་ནས།",
    "རྒྱན་སོ་སོའི་རྩ་བའི་དགོངས་པ་མཐུན་པར་རང་ལུགས་གཙང་མར་ཐོན་པའི་རང་རྩོམ་དཔེར་བརྗོད་རེ་རེའང་གསལ་བར་བཀོད་པས་སྙན་འགྲེལ་གཞན་ལས་བློ་བསྐྱེད་ཆེ་བ་དང་།",
    "དེང་སང་གི་ན་གཞོན་སྙན་ངག་ལ་བློ་ཕྱོགས་མ་ཕྱོགས་ཀུན་གྱིས་སྲོལ་རྒྱུན་སྙན་དངགས་ནི་ཉི་ཟླ་ཤར་ནུབ་དང་།",
    "རྒྱ་གར་ལ་བཙན་བྱོལ་དུ་ཕེབས་རྗེས་བློས་ཐུབ་གྲོགས་པོ་ཞིག་གི་རམ་འདེགས་ལ་བརྟེན་ནས་མ་དཔེ་འདི་གར་འབྱོར་ཐུབ་པ་བྱུང་ཞིང་།",
    "༡ཕུང་ཚན་བྱེ་བྲག་པའི་ཕལ་སྐད་གཙོར་འདོན་གྱི་ཡིག་སྲོལ་དར་འཕེལ་བྱུང་ཚེ་རྩ་བའི་བོད་ཡིག་ལ་དགེ་སྐྱོན་ཇི་འབྱུང་གི་བསམ་ཚུལ།",
    "རྗོད་བྱེད་ཀྱི་སྒྲ་རེ་རེ་ཡིག་འབྲུར་བཅོས་པ་ཞིག་གི་ཚུལ་དུ་ཡོད་པ་ནི་རྒྱུན་རིང་བར་དར་བའི་ནུབ་ཕྱོགས་ཨཱི་ཇིབཊའི་ཡི་གེ་དང་།",
    "དེར་མ་ཟད་དེང་སྐབས་ཀྱ་རང་རེའི་ཁབ་ཏུ་མཐོང་རྒྱུ་ཡོད་པའི་སྲིད་པ་ཧོའི་ཕྱག་རྒྱ་དང་།",
    "ད་དུང་དེ་ལས་ཀྱང་བསམ་བློའི་རིག་སྟོབས་ཡར་རྒྱས་སུ་ཕྱིན་ཏེ་མཁས་པ་འགའ་ཞིག་གིས་རང་རང་གི་ཡི་གེ་ཕྱི་མོ་སྐད་ཀྱི་གདངས་ལས་ཉེ་བར་མཁོ་བ་དག་བསྡུས་ཏེ།",
    "ཡི་གེའི་ཕྱི་མོ་སྐད་ཀྱི་གདངས་ལ་མཁོ་བ་རྣམས་ཟུར་དུ་བསྡུས་ནས་ཡི་གེ་བྱས་པ་ནི་མཁས་པ་རྣམ་དཔྱོད་ཅན་གྱིས་མཛད་པ་ཡིན་ཏེ།",
    "དེ་ཐམས་ཅད་ཀྱི་ཕལ་ཆེར་གྱི་དང་པོའི་ཕྱི་མོའམ་འབྱུང་ཁུངས་ནི་སྟོན་པའི་སྐུ་དུས་རྩ་ན་བྱུང་བའི་རྒྱ་གར་དབུས་ཀྱི་ཡི་གེ་འདི་ཡིན་པར་མཐོང་ལ།",
    "རང་རེ་བོད་ཀྱི་ཡི་གེ་འདིའང་འགའ་རེས་རྒྱ་གར་སོགས་ནས་ཕྱིས་སུ་དར་བར་སྨྲ་ན་ཧ་ཅང་མཚང་ཆེ་བར་གཟིས་ཤིང་ཆེས་སྔ་མོ་ཞིག་ནས་ཡོད་པར་སྨྲ་བ་དང་།",
    "འགའ་ཞིག་གིས་ཡི་གེ་ཐུ་མིས་གསར་དུ་བཟོས་ཤིང་དེ་ཡང་རྒྱ་གར་གྱི་ཡི་གེ་ལ་དཔེར་མཛད་པ་ཡིན་པ་དང་།",
    "དེའི་སྔོན་དུ་བོད་ལ་ཡི་གེ་ཡོད་ཚུལ་སྨྲ་ན་ཁྱོད་ཀྱི་ཕའི་སྔ་རོལ་ཏུ་ཁྱོད་སྐྱེས་པ་དང་།",
    "འོན་ཏེ་ཁོ་བོ་གོང་གསལ་བཞིན་གདོད་མའི་བོད་མི་རྣམས་རང་གི་བདེ་སྡུག་གི་ཚོར་སྣང་གཞན་ལ་གསལ་བར་བྱེད་པའི་ཐབས་ལ་འབད་སྲིད་པ་ཡིན་པ་ནི་མིའི་འགྲོ་བ་རིགས་ཀུན་མཐུན་པ་ཡིན་ཅིང་།",
    "རང་རེ་བོད་དང་།",
    "ཐོས་བསམ་གོམས་པ་མཐར་སོན་ཅིང་མྱོང་བའི་རྩེ་མོར་སླེབས་པའི་ངེས་པ་དོན་གྱི་མཁས་པར་གྱུར་ཏེ་སླར་བོད་ཡུལ་དུ་ལྡོག་སྔར་གྱི་ཡི་གེ་ལ་མགོ་འདོགས་འཕུལ་གཞག་དང་།",
    "གཞན་ཡང་རྒྱལ་པོ་ཉིད་བློ་གྲོས་ཀྱི་སྤྱན་རས་མཆོག་ཏུ་ཡངས་པས་ཐུ་མི་ཉིད་དོན་གྱི་མཁས་པར་གཟིགས་ཤིང་།",
    "ཡུལ་གྲུ་སོ་སོར་རང་རང་གི།",
    "གིས་རང་ལ་གདེང་ཚོད་ཕེར་བའི་སྒོ་ནས་བོད་འདིར་མཁས་པ་སླེབས་པའི་སྔོན་མ་དང་།",
    "གང་ལྟར་མིང་ཚིག་གི་རྩོམ་གཞིར་གྱུར་པའི་བོད་སྐད་ཀྱི་གདངས་ཉིད་མིང་ཚིགས་སུ་གདག་ཏུ་རུང་བའི་ཡི་གེའི་སྲོལ་གཏོད་པ་ནས་བཟུང་།",
    "ཡིད་གུས་པའི་ཚུལ་གྱིས་མོས་གུས་བྱས།",
    "འགའ་ཞིག་གིས་སྔར་ཡང་བཀས་བཅད་རིམ་པར་མཛད་དེ་བོད་ཡིག་ལ་བསྒྱུར་བཅོས་ཐེང་འགའ་གནང་བས་ད་ལྟའང་བསྒྱུར་བཅོས་བྱེད་དགོས་ཚུལ་སོགས་གསུངས་མོད།",
    "ང་ཚོའི་རིག་གཞུང་གི་ཕྱི་མོར་གྱུར་པའི་བརྡ་སྤྲོད་པ་འདི་ཉིད་ལ་ཡི་གེ་ཟོལ་ཡངས་པ་དང་།",
    "སྔར་བསྒྱུར་བའིགཞུང་འགར་བཀས་གསར་བཅད་དང་མཐུན་པར་གཏན་ལ་འབེབས་པ་སོགས་མཛད་མོད་ཀྱང་བརྡ་དང་གཟུགས་ལ་འགྱུར་བ་ཆེར་མ་ཕྱིན་པ་ནི།",
    "དེང་གི་སྐབས་སུའང་སྔར་ཁྲི་སྲོང་སོགས་ཀྱི་དུས་སྐབས་སུ་བྲིས་པའི་རྡོ་རིང་དང་།",
    "གང་གིས་ཤེས་ཤེ་ན།",
    "དུས་རབས་བཅུ་གསུམ་པའི་སྔ་ཕྱིར་ཕེབས་པའི་བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པ་སོགས་དབུས་གཙང་གི་མཁས་པ་རྣམས་དང་།",
    "མི་ལོ་བརྒྱ་ཕྲག་གིས་ཆོད་ཡོད་པ་སུས་ཀྱང་ཚོར་སྣང་ལ་འཆར་བར་དཀའ་བ་འདིས་ཤེས་པར་ནུས་པ་མ་ཟད།",
    "སྲ་བརྟན་སའི་དཀྱིལ་འཁོར་འདི་ཡང་སྐད་ཅིག་གིས་རྡུལ་ཕྲན་གྱི་ཕུང་པོར་བཟོ་བ་ཡང་མི་ཞིག་གིས་ལག་གི་འགུལ་བསྐྱོད་བྱེད་སྟངས་ཙམ་ཞིག་ལ་རགས་ལས་པ་སོགས་བློ་ཡུལ་ལས་འདས་པའི་ཚད་ལ་སླེབ་ཀྱང་།",
    "དེ་ཉིད་སྤྲེའུའི་ལག་གི་མར་མེ་བཞིན་མ་སོང་བར་མགོ་ལ་ཀླད་པ་དང་།",
    "དེང་སང་རང་རེའི་བློ་གསལ་འགའ་ཞིག་གིས་གླིངསྟོད་སྨད་ཀྱི་ཕྱིང་པ་དང་ར་ལྤགས་ཀྱི་དཔེ་ལྟར།",
    "འཛམ་གླིང་གི་ཡི་གེ་ཚང་མར་ཁ་ནས་གང་ཐོན་པ་དེ་ཡི་གེར་བྲི་རྒྱུ་ཡོད་པ་དང་།",
    "དེས་ན་ང་ཚོས་བོད་ཡིག་བསྒྱུར་བཅོས་བྱས་ཏེ་ཁ་ནས་གང་ཐོན་པའི་ལུང་ཚན་སོ་སོའི་ཕལ་སྐད་དེ་ཉིད་ཀྱི་ཐོག་ནས་ཡི་གེར་འབྲི་དགོས་པ་ཡིན།",
    "རང་གཞུང་གི་ལས་ཀྱི་སྣེ་མོར་གཏོགས་པ་རྣམས་རང་གི་རིག་གཞུང་ལ་རིན་ཐང་དུ་མི་གཟིགས་ཤིང་གདེང་འཇོག་ཆུང་བ་དང་བཞི་བཅས་ཡིན།",
    "བོད་ཡིག་གི་རྩོམ་གཞི་ནི་རྩ་བའི་རང་སྐད་ལ་གཞི་བཅོལ་བ་ཡིན་པས་ཤེས་ཤིང་།",
    "ཕལ་སྐད་ཡི་གེར་བཀོད་ན་ལུང་ཚན་གང་གི་ཕལ་སྐད་དུ་ཡི་གེར་འགོད་དགོས་སམ།",
    "ཐོར་ཞེད་སྣང་ཚ་པོ་འདུག་ཁྱོད་ཧོན་ཐོར་ཅོབ་སོང་།"
