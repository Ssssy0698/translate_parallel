    "ཡན་ལག་ལྔ་གང་ལ་གནས་ཀྱི་འདུག་བལྟ།",
    "གྲུ་བཞི་དང་ཟླུམ་པོ་ལ་སོགས་པ་གཟུགས་གང་དུ་འདུག་བལྟ།",
    "ཕྱི་དང་ནང་ལ་སོགས་པའི་ཡུལ་གང་ན་འདུག་བལྟ་སྟེ།",
    "འབུ་རྣམས་ཤིག་ཤིག་འདུག་པ་དང་།",
    "གཞན་མ་དད་པ་བཟློག་ནུས་ཤིང་རྣལ་འབྱོར་པ་རྣམས་ལ་གཤེ་རུ་མི་བཏུབ་པར་འདུག་པས།",
    "ཤ་ཆེན་པ་དང་འབྲུམ་པ་དམར་པོར་འདུག་པ་དང་།",
    "དེ་རྣམས་མི་ན་ཙ་ནའང་བྱ་དགོས་པས།",
    "དེའི་སྟེང་ན་རང་འདུག་པར་བསྒོམ།",
    "འདོན་ན་གྱེན་ལ་གདའ།",
    "ལས་ངན་བྱེད་པ་ལའང་བདེ་འབྲས་འདུག་གོ་སྙམ་ན་ལས་མཐར་ཟད་པ་ལ་སོགས་པ་ཡིན་ནོ།",
    "གནས་སྐབས་སུ་གཞན་བྱམས་ཤིང་རང་སེམས་བཀོལ་དུ་བཏུབ།",
    "ལམ་དུ་ཅི་ལོངས་དང་རང་གྲོལ་ལ་གཏང་བའོ།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "རང་ལུགས་ཀྱིས་བསྒྲུབ་བྱ་སྒྲུབ་པའི་རྟགས་ཡོད་པ་དང་རང་རྒྱུད་ཀྱི་རྟགས་མེད་ཚུལ་ལོ།",
    "གཉིས་པ་རང་ལུགས་ཀྱིས་བསྒྲུབ་བྱ་སྒྲུབ་པའི་རྟགས་ཡོད་པ་དང་རང་རྒྱུད་ཀྱི་རྟགས་མེད་ཚུལ་ལ་གཉིས།",
    "ཇི་བཞིན་མ་དགོངས་པའི་ཚུལ་གྱིས་མི་གོ་བར་འདུག་ལ་གས་ཞུས་པས།",
    "ཁོ་རང་ལ།",
    "འདིའི་ཆེད་དུ་བྱ་བའི་གདུལ་བྱས་ཐོབ་པའི་རྣམ་མཁྱེན་ཁོ་ཁོ་རང་ཡིན་མིན་སོགས་ལའང་སྤྲོ་བྱ་མང་ངོ།",
    "མ་མཐོང་བ་ཤིན་ལྐོག་བསྟན་པ་ལ་ཁས་བླངས་སྔ་ཕྱི་དང་རང་ཚིག་དངོས་ཤུགས་འགལ་བས་གནོད་པ་མེད་པ་གསུམ་གསུངས་ཤིང་།",
    "ད་ལྟའི་དགོངས་འགྲེལ་གྱི་དཔེ་ལ་དང་པོར་རབ་འབྱོར་གྱི་ལེའུ་ཞེས་པ་ཞིག་འདུག་ཅེས་གསུངས་པ་ད་ལྟའི་དགོངས་འགྲེལ་གྱི་དཔེ་དང་མི་མཐུན་ནོ།",
    "བཞི་པ་ཟས་བཞིའི་བར་ཡང་རང་མཚན་ནས་ཡོངས་སུ་ཤེས་པའི་བར་ལྔ་བཀའ་སྩལ་པ་སྟེ།",
    "བཞི་པ་ཟས་བཞིའི་བར་ཡང་རང་མཚན་ནས་ཡོངས་སུ་ཤེས་པའི་བར་ལྔ་བཀའ་སྩལ་པ་སྟེ།",
    "ཞེས་པས་ངོ་བོ་ཉིད་མེད་ཚུལ་དྲིས་པ་ལྟ་བུ་ཞིག་འདུག་པ་ནི་སྔ་མ་སྤྱིར་ངོ་བོ་ཉིད་མེད་ཚུལ་དང་།",
    "ཀུན་ཅིབཏགས་ཡུལ་སྟེང་ནས་གྲུབ་ཀྱང་རང་བཞིན་གྱིས་མ་གྲུབ་པར་ཁས་བླངས་ན་རྣམ་རིག་པའི་གཞུང་རྒྱ་མཚོ་ལྟ་བུ་གང་དང་ཡང་མི་འགལ་བའི་ཕྱིར།་",
    "དེ་ལས་གསུངས་པའི་ངོ་བོ་ཉིད་མེད་པ་གསུམ་གྱི་དོན་རྣམ་རིག་པ་ལྟར་ཡིན་པར་བཞེད་ཀྱང་རང་ལུགས་དགོངསའགྲེལ་དང་སྒོ་མི་བསྟུན་ལ།",
    "དེ་ལས་གསུངས་པའི་ངོ་བོ་ཉིད་མེད་པ་གསུམ་གྱི་དོན་རྣམ་རིག་པ་ལྟར་ཡིན་པར་བཞེད་ཀྱང་རང་ལུགས་དགོངསའགྲེལ་དང་སྒོ་མི་བསྟུན་ལ།",
    "གཟོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཡིན་ཏེ།",
    "འདིའི་དམིགས་རྐྱེན་ཞེས་པ་སྣང་བའི་དམིགས་རྐྱེན་ནམ་དམིགས་རྐྱེན་བཏགས་པ་བ་ལ་འཆད་དགོས་པས་རྣམ་པར་རྟོག་པ་ཡང་གཙོ་བོར་རང་རང་འཛིན་པའི་རྟོག་པ་ལ་བྱ་སྟེ།",
    "འི་སྒྲུབ་བྱེད་དུ་འདུག་པའི་ཕྱིར་རོ།་།",
    "དེ་ཡིན་ན་བདེན་གཞི་གང་རུང་རང་མཚན་གྱིས་གྲུབ་པར་དངོས་སུ་སྟོན་པས་ཁྱབ་པ་རྣམས་མེད་ཅིང་།",
    "དེ་ཡིན་ན་བདེན་གཞི་གང་རུང་རང་མཚན་གྱིས་གྲུབ་པར་དངོས་སུ་སྟོན་པས་ཁྱབ་པ་རྣམས་མེད་ཅིང་།",
    "གང་ཟག་ལ་རྟོན་པའི་དུས་སུ་འདུག་པས་སྨོས་ཀྱི།",
    "ཁོ་རང་གཞིར་བཞག་ནའང་།",
    "རྟོག་གེ་འབར་བར་འདིའི་ཀུན་བཟང་ཕྱག་རྡོར་ལས་ལོགས་སུ་བྱས་ཀྱང་རང་ལུགས་འདིའི་དེ་གཉིས་གཅིག་ཏུ་བྱེད་དགོས་པ་སྒྲོན་གསལ་གྱིས་ཤེས་པ་དང་།",
    "དངོས་པོ་ཙམ་ཞིག་ཀྱང་རང་མཚན་གྱིས་མེད་པར་གྱུར་ན་འདུས་བྱས་ཀྱི་གདགས་གཞི་གཟུགས་སོགས་གཏན་མེད་དུ་འགྱུར་ལ།",
    "སྐབས་འདིར་གཞུང་ལས་དོན་དམ་དུ་ཡོད་མེད་ཀྱི་བརྟག་པ་བྱ་དགོས་ཀྱང་དེ་དང་རང་མཚན་གྱིས་ཡོད་མེད་བརྟགས་པ་འདྲ་ཞིང་།",
    "བམ་ཚད་བཅད་པ་རྣམས་འདི་ལ་མི་འདུག་པའི་ཕྱིར་རོ།",
    "རང་རྐྱ་འཛིན་ཐུབ་པའི་རྫས་ཡོད་དང་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་དོན་མི་གཅིག་པའི་ཕྱིར་ཏེ།",
    "རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་དང་རང་རྐྱ་འཛིན་ཐུབ་པའི་རྫས་ཡོད་གཉིས་ལ་ཁྱད་ཕྱེ་ནས།",
    "རིགས་པ་དེས་དེ་ཕུང་པོ་ལས་དོན་གཞན་དང་རང་རྐྱ་བའི་རྫས་སུ་གྲུབ་པ་བཀག་ཟིན་པའི་ཕྱིར།་",
    "ཁ་ཅིག་རང་རྐྱ་འཛིན་ཐུབ་པའི་རྫས་ཡོད་དང་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་གཉིས་ཀྱི་ཞིབ་ཆ་འབྱེད་པ་ཡང་རྒྱ་གཞུང་ཚད་ཐུབ་རྣམས་དང་།",
    "འཐད་རྒྱུ་ཞིག་མི་འདུག་ཅེས་མང་དུ་གསུངས་པ་ཡང་མཁས་པ་སྔ་མའི་ཁས་ལེན་གྱི་རྒྱུན་བསྐྱངས་པ་ཙམ་ལས་དགོངས་པ་དངོས་མིན་འགྲོ།",
    "རང་རྐྱ་ཐུབ་པ་དང་རང་རྐྱ་འཛིན་ཐུབ་པ་གཉིས་མི་གཅིག་གོ།"
