    "དཔེར་ན་རྣམ་དབྱེ་སྦྱོར་ཁུངས་ལྷ་ལྟ་བུ་ཡིན་ན་དེ་དག་གི་མཐའ་སྦྱོར་འོག་མའི་མིང་དོན་ལ་གང་ཞེས་པ་ལྟ་བུ་སྤྱི་ཁྱབ་ཀྱི་སྒྲའམ་སྤྱིར་འཇུག་ཡོད་ན་ལྷ་གང་ཞེས་པ་ལྟ་བུ་རྣམ་དབྱེ་དང་པོ་ངོ་བོའི་སའི་དོན་ཡིན་ནའང་ཡོད་དམ་ཞེས།",
    "ཕོ་སྒྲ་དང་ནི་མོ་སྒྲ་དག།",
    "མིང་གི་མཐའ་ན་ཡོད་མེད་དང་།",
    "ཞེས་གོང་དུ་སྨོས་པ་དེའི་ཁོངས་སུ་མ་འདུས་པ་ནི་གཞན་ཡང་མིང་ཚིག་གི་བརྗོད་དོན་འོག་མ་ལས་གོང་མའི་ངག་དོན་གྱི་ལྷག་མ་བསྡུ་རྒྱུ་ཡོད་པ་ནི།",
    "གང་དང་གང་ལ་དེ་དང་དེ་དག་སོགས་རྣམ་གྲངས་དག་ནི་བཀོད་པ་ལས་ཚིག་སྦྱོར་གོང་འོག་གི་བརྗོད་དོན་མཚུངས་པར་རྟོགས་ནུས་པ་དང་ཡང་དོན་ལ་སྐྱར་བ་མེད་ཀྱང་ཚིག་ལ་སྐྱར་བསྐྱར་བ་ཡོད་པ།",
    "དཔེར་ན་རྟག་འཇུག་གི་གཞུང་ཚིག་འདིར།",
    "ཡང་ན་སྙན་ངག་ལེའུ་གཉིས་པ་དོན་རྒྱན་སོ་ལྔའི་ནང་གི་ལྔ་པ་སྐོར་རྒྱན་ལས་ཚིག་སྐོར་ལྟ་བུ་དང་།",
    "རྟགས་འཇུག་རང་གི་གཞུང་འདིར་ཡང་།",
    "ཡང་ན་སྙན་ངག་གི་དོན་སྐོར་ལྟ་བུ་དང་།",
    "སྙན་ངག་གི་གཉིས་ཀ་སྐོར་བའི་རྒྱན་ལྟ་བུ་ཡིན་ཞིང་།",
    "ཞིང་པ་ལ་སོགས་པ་ལྟ་བུའི་བདག་སྒྲ་མིང་གི་མཐར་ཡོད།",
    "ཡང་ན་མོ་སྒྲ་སྟི་ལིངྐ་ཚིག་སྦྱར་བ།",
    "དེ་མཚུངས་ཚིག་གི་རྒྱན་དུ་གྱུར་པ་རྣམས་ལ་ཡང་།",
    "མཛེས་མའི་ལང་ཚོའི་གྲོགས་སུ་ཟླ་བ་དང་པད་མ་བཅས་ཡོན་ཏན་གྱི་དཔེར་མཚུངས་པར་བརྗོད་པ་ལྟར་དང་།",
    "ཞེས་ཀྱི་གི་གྱི་འི་ཡི་རྣམས་ཀྱི་ཨ་ལི་དང་པོ་གི་གུ་འཕྱིས་ཕྱིས་ནས་རྗེས་འཇུག་གཉིས་པ་ང་ཡིག་སྦྱར་བས་ཀྱང་གང་གྱང་འང་ཡང་ཞེས་བྱུང་བ་ཁག་ལྔ་པོ་རེ་རེ་ནས་ཚིག་རྒྱན་གཉིས་དང་སྡུད་ཚིག་ཡོང་བ་ལྟ་བུ་ལས་སྐབས་དེར་དངོས་སུ་མ་གསུངས་ནའང་།",
    "རྟགས་འཇུག་གི་གཞུང་འདིར།",
    "ཡང་ཏིག་ཕན་ཐོགས་པའི་དགོས་དོན་འདུག་མིན་ཞིབ་བརྟགས་ཀྱི་བླང་དོར་མ་ནོར་བར་བྱེད་དགོས་ཚུལ་དང་དེ་བཞིན་དུ་བརྗོད་དོན་བསྟན་བྱའི་ཚིག་གིས་ལྷག་འཕྲོས་འཕྲོ་མ་རྫོགས་པར་ལུས་པ།",
    "དེའི་ཕྱོགས་མཐུན་ཏེ་དེ་བཅས་ལྷག་བཅས་ཀྱི་ཚིག་མིང་མཐར་ཡོད་ན་ད་དུང་ཚིག་དོན་བརྗོད་མ་ཚར་བ་དང་ཡང་ལྷག་བཅས་ཀྱི་ཚིག་མེད་པའི་མིང་མཐར་རྫོགས་སོ་ཞེས་པ་ལྟ་བུས་མཚོན་རྗེས་འཇུག་བཅུ་པོ་རེ་རེ་ལ་ཨོ་ཡིག་སྦྱར་བ་སླར་བསྡུ་རྫོགས་ཚིག་ཡོད་ན་གནས་སྐབས་དེ་གའི་ཚིག་དོན་ཚང་མ་བརྗོད་ཚར་ཡིན་གཤིས་ཚིག་དོན་རྫོགས་དང་མ་རྫོགས་ཀྱི་ཐ་སྙད་ཀྱང་མིང་མཐར་ལྷག་བཅས་ཀྱི་ཚིག་དང་།",
    "སླར་བསྡུ་རྫོགས་ཚིག་ཡོད་མིན་སོགས་གོང་དུ་བརྗོད་པ་དེ་དག་གི་ནང་གསེས་རྣམ་གྲངས་ཤིན་ཏུ་མང་བས་རྣམ་པར་དབྱེ་ཚུལ་གྱི་ཤེས་རབ་ཀྱང་།",
    "ཁ་གཅིག་ནི་སྐྱེ་དགུ་ཞེས་པ་མའི་མངལ་དུ་ཟླ་བ་དགུ་སྡད་བསྡད་ནས་སྐྱེས་བས་ན་སྐྱེ་དགུ་ཞེས་བྱའོ་ཟེར་བ་དང་ཡང་ལ་ལ་ཞིག་གིས།",
    "གཟུགས་མེད་ཁམས་བཅས་པ་ཁག་གསུམ་སོ་སོར་སྐྱེ་བ་གསུམ་རེ་ལེན་པས་ན་སྐྱེ་དགུ་ཞེས་བྱའོ།",
    "མིང་གི་ཁོངས་ནས་ཚིག་ཕྱུང་སྟེ།",
    "ཚིག་གིས་དོན་རྣམས་སྟོན་པར་བྱེད།",
    "ཞེས་སོགས་ངག་གི་དོན་གང་དང་གང་ཡིན་པ་དེ་དང་དེ་དག་རྣམས་རྒྱ་ཆེར་སྟོན་པར་བྱེད་པས་ན།",
    "མོ་ཡི་ཡི་གེ་མེད་ན་ནི།",
    "རྗེས་འཇུག་ཁོ་ནའི་མོ་ཡིག་ཡིན་པར་ངོས་འཛིན་སྲོལ་འདུག་པ་ནི་ཤིན་ཏུ་མི་འཐད་དེ།",
    "རྗེས་འཇུག་གི་མོ་ཡིག་ནི་གྲང་གྲངས་ཉུང་ཞིང་ཁྱབ་ཆུང་བས་ཕོ་ཡིག་གི་བརྗོད་པ་མེད་པར་བྱེད་མི་ནུས་ལ།",
    "མོ་ཡི་ཡི་གེ་ཞེས་པ་འདི་ཡང་རྗེས་འཇུག་ཁོ་ནའི་མོ་ཡིག་མིན་པ་ཚིག་ཤུགས་ལས་ཀྱང་རྟོགས་ནུས་པའི་ཕྱིར།",
    "སྙན་ངག་ལེའུ་གསུམ་པའི་ནང་གི་བྱ་དཀའ་བའི་ཁྱད་པར་ལས།",
    "སྙན་ཚིག་གི་ཡིག་འཕྲིན་ཆབ་ཤོག་ནང་དུ་ཟུར་དུ་གསལ་བ་ལྟར་བཅས་མིང་ཚིག་གི་བརྗོད་དོན་སྟོན་པར་དབྱངས་ཡིག་བཞི་ལ་དངོས་སུ་ལྟོས་མ་དགོས་པ་ནི་རིག་པས་ཀྱང་འགྲུབ་པ་ཡིན་ནོ།",
    "སྤྱིར་གྱི་མིང་ཚིག་གི་བརྗོད་པ་ཕལ་ཆེར་སྔོན་རྗེས་གཉིས་དང་ཁྱད་པར་རྗེས་འཇུག་གི་འཇུག་ཚུལ་གཙོ་ཆེ་གཤིས།",
    "རྗེས་འཇུག་གི་ཡི་གེ་བཅུ་པོ་དེ་དག་ཐམས་ཅད་མིང་གཞིའི་མོ་ཡིག་གི་ཁོངས་ནས་བྱུང་བ་ལས།",
    "ཕོ་ཡིག་དང་མ་ནིང་གི་ཡི་གེའི་ཁོངས་ནས་འབྲུ་གཅིག་ཀྱང་མེད་པ་ནི།",
    "མོ་ཡི་ཡི་གེའི་ནང་ནས་ནི།",
    "སྔོན་འཇུག་ལྔ་པོ་ཡང་མིང་གཞིའི་མོ་ཡིག་གི་གྲས་ཡིན་པས་ན་མིང་གཞིའི་མོ་ཡིག་རྣམས་མེད་ན་ནི་ཕོ་ཡིག་ཅེས་དངོས་སུ་གསུངས་ནས་མ་ནིང་ཀྱང་ཡང་ཤུགས་ལ་བསྟན་ཏེ་ཕོ་དང་།",
