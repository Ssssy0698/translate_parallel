    "མོ་ཡིག་ལ་མོ་ཙམ་དང་ཤིན་ཏུ་མོ་བཅས་ཁག་གཉིས།",
    "མ་ནིང་གི་ཡི་གེར་འགྱུར་བའི་མ་ནིང་།",
    "མཚན་མེད་མ་ནིང་བཅས་གནས་ལུགས་སོ་སོར་ངོས་འཛིན་ཚུལ་ནི་རྗེས་འཇུག་ལ་རྟགས་བརྒྱད་བྱེ་བྲག་གི་དབྱེ་བ་འབྱེད་ལུགས་ཡིན་ནོ།",
    "མིང་མཐའ་འདྲེན་ཚུལ་སོགས་ཚང་མ་བྱེད་དགོས་སྟབས་རྗེས་འཇུག་གི་ཡི་གེ་བཅུ་པོར་ཕོ་མོ་མ་ནིང་གི་རྟགས་དབྱེ་ངོས་འཛིན་དུས་སྔོན་གྱི་མཁས་པ་སུམ་རྟགས་ཀྱི་འགྲེལ་མཛད་ཕལ་ཆེར་དགོངས་བཞེད་མི་མཐུན་པ་སྣ་ཚོགས་མཆིས་གཤིས་དེ་དག་གི་དབྱེ་བ་ཐམས་ཅད་ནི་འདི་དང་འདི་འོ་ཞེས་བརྗོད་ཀྱང་འཛོགས་རྫོབ་ཆེའི་རྒྱུ་བཅས་འདིར་མ་བཀོད་རུང་གཞན་ལས་ཤེས་པར་བྱ་ཞིང་།",
    "ཞ་ལུ་ལོ་ཆེན་ནས་མཛད་པའི་སུམ་རྟགས་ཀྱི་འགྲེལ་པར་རྗེས་འཇུག་གི་ཕོ་མོ་ན་ནིང་ངོས་འཛིན་སྐབས་ཕོ་ཡིག་ད་བ་ས་གསུམ་གོ་རིམ་བཞིན་སྐྱེས་བུ་རབ་འབྲིང་ཐ་གསུམ་མོ་ཡིག་འ་ར་གཉིས་ཀྱང་རིམ་པ་བཞིན་མོ་ཙམ་དང་ཤིན་ཏུ་མོ་བཅས་ཁག་གཉིས།",
    "མ་ནིང་གི་དང་།",
    "དེ་འཕྲོས་བྱིངས་ཚང་མ་དགོངས་པ་མཐུན་མོད།",
    "དེས་ན་རྗེས་འཇུག་གི་ཕོ་ཡིག་ག་ད་བ་ས་བཞི་དང་།",
    "མོ་ཡིག་ནི་ང་མ་འ་གསུམ།",
    "མ་ནིང་གི་ཡི་གེ་ནི་ན་ར་ལ་གསུམ་ཡིན་ནོ།",
    "རྗེས་འཇུག་དེ་དག་ལ་ཕོ་མོ་མ་ནིང་གསུམ་དུ་དབྱེ་བ་ནི་རྗེས་འཇུག་གི་མིང་གཞིའི་ཡི་གེ་ཇི་འདྲ་ཞིག་ལ་ཞུགས་ཀྱང་སྒྲ་སྐད་དྲག་ཞན་བར་མ་གསུམ་དུ་འཇུག་ཚུལ་གྱི་སྒོ་ནས་འཇོག་དགོས་ཏེ།",
    "ཕོ་གསུམ་མོ་གཉིས་མ་ནིང་གསུམ།",
    "ཕོ་ཡིག་གི་རྗེས་འཇུག་ག་ལ་ཡང་འཇུག་ས་ཡོད་པ་དེ་ནི་རྗེས་འཇུག་ནང་འཕྲད་ཀྱི་མཐུ་ལས་སྒྲ་དྲག་པའི་དྲག་པ་ཡིན་པས་སྐྱེས་བུ་རབ་དང་།",
    "མོ་ཡིག་གི་རྗེས་འཇུག་ང་མ་གཉིས་ལ་ཡང་འཇུག་ས་ཡོད་པ་ནི་སྒྲ་ཞན་པའི་དྲག་པ་ཡིན་པས་མོ་ཙམ་དང་།",
    "འ་ཡིག་གི་རྗེས་འཇུག་བཅས་གསུམ་ནི་སྒྲ་ཞན་པའི་ཞན་པ་ཡིན་པས་ཤིན་ཏུ་མོའོ།",
    "དེ་བཞིན་དུ་མ་ནིང་གི་རྗེས་འཇུག་ན་ར་ལ་གསུམ་པོ་མིང་གཞིའི་ཕོ་ཡིག་གི་མཐར་ཡང་འཇུག་ད་ཡོད་མེད་གང་རུང་ནི་སྒྲ་བར་མའི་དྲག་པ་དང་།",
    "དེ་གསུམ་མིང་གཞིའི་མོ་ཡིག་གི་རྗེས་སུ་ཡང་འཇུག་མེད་པ་ནི་སྒྲ་བར་མའི་ཞན་པ་ཡིན་པས་འགྱུར་བའི་མ་ནིང་དང་།",
    "མིང་གཞིའི་མོ་ཡིག་གི་མཐར་ན་ར་ལ་གསུམ་པོར་ཡང་འཇུག་ད་ཡོད་པ་ནི་སྒྲ་བར་མའི་དྲག་ཞན་གཉིས་ཀའི་ཆ་མཉམ་དང་ལྡན་པས་མཚན་གཉིས་མ་ནིང་དང་།",
    "ཡང་མིང་གཞིའི་མ་ནིང་གི་ཡི་གེའི་མཐར་ན་ར་ལ་གསུམ་པོར་ཡང་འཇུག་ཡོད་མེད་གང་རུང་ནི་སྒྲ་བར་མའི་དྲག་ཞན་གང་དུའང་མི་འགྲོ་བར་སྒྲ་བར་མའི་ཡང་བར་མ་ཡིན་པས་མཚན་མེད་མ་ནིང་ངོ།",
    "གང་ལ་འཇུག་བྱེད་གང་གིས་འཇུག།",
    "དགོས་པ་ཅིའི་ཕྱིར་འཇུག་པར་བྱེད་བཅས་གོང་དུ་སྔོན་འཇུག་ལྔ་པོར་དྲི་བ་དྲི་ལན་མཛད་པ་དང་མཚུངས་པར་རྗེས་འཇུག་གི་སྐབས་འདིར་ཡང་གཞུང་མཛད་སློབ་དཔོན་རང་ཉིད་ཀྱིས།",
    "གང་གི་བཅུ་པོ་དེ་དག་གིས།",
    "ལ་སོགས་པ་ཀ་ནས་ཨའི་བར་གསལ་བྱེད་ཀྱི་ཡིག་འབྲུ་སུམ་ཅུ་པོ་ཚང་མར་རྗེས་འཇུག་བཅུ་པོའི་ཡིག་འབྲུ་རེ་རེ་ནས་མ་འཚེམས་འཚེངས་པར་འཇུག་ནུས་པའི་འགྲོ་ཁྱབ་ཆེ་ཐོག་ད་དུང་ད་དང་ས་གཉིས་ནི་རྗེས་འཇུག་གི་རྗེས་འཇུག་ཡང་ཡིན་ཏེ།",
    "ཕོ་གསུམ་མོ་གཉིས་མ་ནིང་གསུམ།",
    "དེ་ལའང་ནང་གི་ཆ་ཤས་ཀྱིས།",
    "ཞེས་པ་ནི་རྗེས་འཇུག་གི་ཡི་གེ་བཅུ་པོ་དེ་དས་ཕོ་སྐྱེས་བུ་རབ་འབྲིང་ཐ་གསུམ་དང་།",
    "མོ་ལ་མོ་ཙམ་དང་ཤིན་ཏུ་མོ་བཅས་ཁག་གཉིས།",
    "དེ་བཞིན་དུ་སྒྲ་སྐད་ཆུང་བའམ་ཞན་པ་ནི་མོ་གཉིས་དང་།",
    "སྐྱེས་བུ་རབ་འབྲིང་ཐ་གསུམ་ནི་རྗེས་འཇུག་རང་ལ་ལྟོས་པའི་དྲག་པ་གསུམ་ཡིན་པས་ན་དེ་དག་གི་ངོས་འཛིན་གཤམ་དུ་དཔེར་བརྗོད་ལ་རིམ་གསལ་གྱིས་ཤེས་པ་ལྟར་བཅས་སྒྲ་དྲག་པའི་དྲག་པ་དང་།",
    "སྐབས་འདིར་རྩ་གཞུང་གི་ཚིག་ལའང་།",
    "རྗེས་འཇུག་གི་ཕོ་ཡིག་ནང་ཕྲད་པའམ།",
    "ཡང་མོ་ཡིག་ནང་ཕྲད་ཇི་འདྲ་ཞིག་ཡིན་རུང་།",
    "དེ་དག་ལའང་ནང་གསེས་ཀྱི་ཆ་ཤས་སྒྲ་འཇུག་དྲག་ཞན་རེ་རེ་ལའང་རྣམ་པ་གཉིས་སུ་དབྱེ་དགོས་སོ་གསུངས་རྒྱུའི་བརྗོད་དོན་ཡིན་པ་ལ།",
    "ལྟ་བུ་སྔོན་རྗེས་མིང་གཞི་གསུམ་ག་མོ་ཡིག་ཡོད་པར་ཞན་པའི་ཞན་པར་ངོས་བཟུང་བས་མཚོན་གཞུང་ཚིག་ལ་རབ་འབྲིང་ཐ་གསུམ་སོ་སོར་དྲག་ཞན་ཁག་གཉིས་གཉིས་སུ་དབྱེ་ཞེས་གསུངས་པ་ལས་དེ་དག་རེ་རེ་ལའང་དྲག་ཞན་ཁག་གསུམ་བཞི་ལྔ་དྲུག་སོགས་རྣམ་པ་མང་པོ་དབྱེ་ཞེས་མ་གསུངས་བཞིན་དུ་དྲག་ཞན་བར་མ་རེ་རེ་ལའང་རབ་འབྲིང་ཐ་གསུམ་གྱི་དབྱེ་བ་ཁག་མང་པོ་འབྱེད་སྲོལ་འདུག་པ་ནི་རྩ་གཞུང་གི་དགོངས་པའི་རྒྱབ་འགལ་དང་།",
    "འོན་ཀྱང་དེ་དག་ནང་གསེས་ཀྱི་གནས་སྐབས་སོ་སོར་ལྟོས་ལུགས་གཙོ་ཆེ་ཆུང་གི་དབྱེ་འབྱེད་མ་བྱས་ན་ནི་སྔོན་རྗེས་མིང་གཞིའི་རྟགས་དབྱེ་འབྱེད་ཚུལ་དང་།",
    "འགྱུར་བ་སོགས་མ་ནིང་གི་རྗེས་འཇུག་ཁག་གསུམ་པོ་དེ་དག་ནི་མིང་གཞིར་འཇུག་ཚུལ་དང་རྗེས་འཇུག་ནང་ཕྲད་གཉིས་ཀ་ལ་ལྟོས་ནས་དབྱེ་བ་ཡིན་ཏེ།",
    "ཟླ་སྨད་བུད་མེད་བྱེད་པའི་མཚན་རྟགས་འགྱུར་འགྲོ་བ་དེ་རིགས་ལ་འགྱུར་བའི་མ་ནིང་ཞེས་གྲགས་པ་དང་འདི་ནི་དོན་གཅིག་གོ།",
    "བུད་མེད་གཉིས་ཀའི་མཚན་མ་གཞི་གཅིག་ལ་ཁག་གཉིས་ཡོད་པ་དེ་རིགས་ལ་མཚན་གཉིས་མ་ནིང་དུ་འཁོད་པ་དང་དོན་གཅིག་གོ།",
    "ཡང་དྲག་ཞན་གཉིས་ཀ་དང་མ་ཕྲད་པ་སྟེ་བར་མའི་མིང་གཞི་མ་ནིང་ལ་རྗེས་འཇུག་མ་ནིང་ཡང་འཇུག་ཡོད་མེད་གང་རུང་གི་སྒོ་ནས་ཞུགས་པས་སྒྲ་དྲག་ཞན་གང་དུའང་མི་འགྱུར་བ་དེ་ནི་འཇིག་རྟེན་ན་ལ་ལར་ཆབ་ཁུངས་ཙམ་ལས་ཕོ་མཚན་དང་མོ་མཚན་གཉིས་ཀ་མེད་པ་དེ་རིགས་ལ་མཚན་མེད་མ་ནིང་ཞེས་བརྗོད་པ་དང་དོན་གཅིག་གོ།",
    "གཞན་ལུགས་འགའ་རེར།",
    "ལ་སོགས་རྗེས་འཇུག་བ་ལ་ཡང་འཇུག་ས་ཡོད་པ་ནི་མིང་གཞི་རེ་གཉིས་ཙམ་ལ་མ་གཏོགས་བྱིངས་ཆེར་འཇུག་པ་ཤས་ཆེ་ཡང་འདིར་འཇུག་ཚུལ་གོ་བདེ་བ་ཅུང་ཟད་ཙམ་ལས་བརྩེགས་འདོགས་ཚང་མ་འགོད་མ་ལང་ཞིང་།",
    "ལ་སོགས་རྗེས་འཇུག་གི་ཕོ་ཡིག་ག་ད་བ་ས་འཇུག་མེད་པར་ཞུགས་པ་གཞན་རྣམས་ཀྱང་རིགས་འགྲེ་ཁག་མང་བས་ཤེས་པར་བྱ་ཞིང་།",
    "མོ་ཙམ་ནི།",
    "ཤིན་ཏུ་མོ་ནི།",
    "ལ་སོགས་པ་འདིར་ཉུང་བསྡུས་ལས་མ་བཀོད་ཀྱང་མིང་གཞིའི་འཇུག་ཡུལ་ཁག་ལ་མཐའ་རྟེན་ནམ་རྗེས་འཇུག་གི་མོ་ཡིག་ང་མ་འ་གསུམ་ཡོད་པ་ནི་ཤིན་ཏུ་མོ་མང་ཞིང་།",
    "ལ་སོགས་པ་མིང་གཞི་ཕོ་ཡིག་གི་འཇུག་མཇུག་ཏུ་རྗེས་འཇུག་མ་ནིང་གི་ཡི་གེ་ན་ར་ལ་གསུམ་ལ་ཡང་འཇུག་ད་དྲག་ཡོད་མེད་སྣ་ཚོགས་དང་།",
    "ཡང་མིང་གཞི་མོ་ཡིག་གི་འཇུག་མཇུག་ཏུ་རྗེས་འཇུག་གོང་གསལ་ལ་ཡང་འཇུག་མེད་པ་ཡང་འདིས་མཚོན་གྲངས་མང་བ་འབྱུང་ཞིང་།",
    "ནིང་གི་རྗེས་འཇུག་ན་ར་ལ་གསུམ་ལ་ཡང་འཇུག་ད་དྲག་ཡོད་པ་རྣམས་དང་།",
    "ལ་སོགས་པ་མིང་གཞིའི་མ་ནིང་གི་ཡི་གེའི་འཇུག་མཇུག་ཏུ་མ་ནིང་གི་རྗེས་འཇུག་ན་ར་ལ་གསུམ་ལ་ཡང་འཇུག་ད་དྲག་ཡོད་མེད་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་འཇུག་ཚུལ་ལ་སོགས་པ་ནི་རིག་པས་དཔྱད་དེ་ཤེས་པར་བྱའོ།",
    "དོན་སྔ་མ་ནི་སྔར་སྔོན་འཇུག་གི་དོན་གྱི་འཇུག་ཚུལ་ལྟར་བདག་གཞན་གཉིས་དང་།",
    "རྗེས་འཇུག་དེ་དག་ཕོ་མོ་མ་ནིང་གང་ཡིན་རུང་དེ་ཁའི་རྟགས་དང་མཐུན་པའི་མིང་མཐའ་དེ་ལྟར་དུ་མི་ནོར་བར་འདྲེན་བྱེད་དུ་འགྱུར་བ་ཞིག་བྱེད་དགོས་སོ་ཞེས་པའི་དོན་ཡིན་ནོ།",
    "རྗེས་འཇུག་བཅུ་པོས་དོན་ལ་འཇུག་ཚུལ་ཁག་གཉིས་ཡོད་པའི་ནང་གི་དོན་སྔ་མ་དེ་ནི་རྗེས་འཇུག་གི་འཇུག་པ་ལས།",
    "སྔོན་འཇུག་གི་འཇུག་པ་གཙོ་ཆེ་བས་སྔར་སྔོན་འཇུག་གི་དོན་གྱི་འཇུག་ཚུལ་དུས་སུ་སྦྱར་ཚར་བ་དེ་ཁས་འཐུས་གཤིས་འདིར་ལོགས་སུ་འགོད་མ་དགོས་སོ།",
    "བྱེ་བྲག་རྟགས་བརྒྱད་ལ་ཕྱེ་བ་དེ་དག་ཡིག་འབྲུ་རེ་རེ་ནས་སྔོན་འཇུག་མེད་པར་མིང་གཞིའི་ཡི་གེ་ལ་བཅུག་ནས་སྔོན་འཇུག་ལྔ་པོས་དོན་ལ་འཇུག་པ་ལྟར་བདག་གཞན་གཉིས་དང་།",
    "རྗེས་འཇུག་བཅུ་པོ་རྟགས་ཁུངས་སོ་སོར་དབྱེ་ནང་ལྟར་གྱི་ཡིག་འབྲུ་རེ་རེ་ནས་མ་འཚེམས་འཚེངས་པར་བདག་གཞན་གཉིས་དང་།",
    "གསུམ་གྱི་དབྱེ་བ་སོ་སོར་སྟོན་ཐུབ་པ་ནི་རེ་གཉིས་ཙམ་སྲིད་ན།",
    "ལ་སོགས་པ་སྔོན་འཇུག་མེད་པའི་དཔེར་བརྗོད་རེ་གཉིས་འགོད་སྲོལ་འདུག་རུང་།",
    "དེ་ནང་ནས་སྟབས་ལེགས་ཀྱི་ཡིག་འབྲུ་འགའ་རེས་འདས་དོན་ཙམ་ཞིག་སྟོན་ཐུབ་ན་ལས།",
    "བྱེ་བྲག་རྟགས་བརྒྱད་པོ་ཁག་སོ་སོ་ལ་ཡོད་པའི་ཡིག་འབྲུ་རེ་རེ་ནས་མ་འཚེམས་འཚེངས་པར་རིམ་པ་བཞིན་དུ་བདག་གཞན་རྣམ་གཉིས་དང་།",
    "དུས་གསུམ་གྱི་དབྱེ་བ་མཐའ་དག་སྟོན་ཐུབ་པའི་དཔེར་བརྗོད་ཞིག་འཆོར་འདོད་སྤྲང་མོའི་རྒྱན་ཆ་ལྟར་མི་འགྲིག་བཞིན་དུ་ཐབས་རྣམ་དུ་མའི་སྒོ་ནས་སྒྲིག་དགོས་ན།",
    "སྔོན་འཇུག་གི་དོན་འཇུག་ཚུལ་སྐབས་ཀྱང་རྗེས་འཇུག་གཉིས་དང་།",
    "དུས་གསུམ་སོ་སོའི་དབྱེ་བ་ཅིའི་ཕྱིར་མི་སྟོན་ཏེ་སྟོན་དགོས་པ་ལ་དེ་འདྲ་རྩ་བ་ནས་མི་ཡོང་མོད།",
    "དེ་མ་བྱུང་ཡང་སྔོན་འཇུག་ཡོད་མེད་ལ་མ་ལྟོས་པར་རྗེས་འཇུག་རྣམས་ལ་ནང་གསེས་རྟགས་བརྒྱད་དུ་ཕྱེ་བ་ནང་ལྟར་གྱི་ཡིག་འབྲུ་རེ་རེ་ནས་རིམ་བཞིན་དུ་བདག་གཞན་གཉིས་དང་།",
    "རང་ལུགས་ལ་དགོས་པ་འགོད་ཐལ་རྣམས་ལ་འགྱོད་སེམས་ཞུས་ཆོག་པ་ཞུ་མདུན་འདུན་ལགས་ཀྱང་།",
    "རྗེས་འཇུག་རྟགས་བརྒྱད་མི་དགོས་རྟགས་གསུམ་ནས་ཀྱང་སྔོན་འཇུག་ལྔ་པོའི་འཇུག་ཚུལ་ལྟར་ཡོང་བ་ནི་ཉིན་མོའི་སྐར་མའམ།",
    "འཇུག་གི་ཕོ་ཡིག་ཏུ་ངོས་འཛིན་མཛད་པ་སོགས་རང་ལུགས་ཀྱི་འཇོག་པའི་མཐར་ཐུག་དག་ཡིག་ཟ་མ་ཏོག་དང་མཐུན་ཤས་ཆེ་བ་འདུག་སྟབས།",
    "ཁོ་བོས་ཀྱང་རྗེས་འཇུག་གི་རྟགས་དབྱེ་དང་།",
