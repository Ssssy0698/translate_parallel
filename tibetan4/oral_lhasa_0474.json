    "རབ་མིག་ལྕགས་སྟག་ཁམས་པ་མི་གསུམ་གྱི་ཡ་གྱལ་རྗེ་དུས་གསུམ་མཁྱེན་པ་དང་།",
    "ཀརྨ་པ་སྐུ་ཕྲེང་དང་པོ་དུས་གསུམ་མཁྱེན་པ་ཁམས་ཀྱི་འབྲི་ཀླུང་སུ་ཕེབས་ཏེ་འབྲི་ཆུ་རྒྱུད་ཀྱི་སེར་སྐྱ་ཐམས་ཅད་སྨིན་གྲོལ་དུ་མཛད།",
    "དུས་གསུམ་མཁྱེན་པས་ཀརྨ་ལྷ་སྟེང་བཏབས།",
    "རབ་མེ་མེ་ཕོ་འབྲུག་ལོའི་ཟླ་བ་༡༡པར་འགྲོ་མགོན་ཏི་ཤྲཱི་རས་པ་དགུང་ལོ་༣༣ལ་སྦས་རོང་དུ་སླེབས།",
    "དེ་ནས་མི་ཉག་རྒྱལ་པོས་སྤྱང་ཁྲང་ཡོས་ཁྲི་ལོ་༧པ་གདན་འདྲེན་བྱེད་པར་ཀམ་ཆུར་བྱོན།",
    "སློབ་དཔོན་ཡར་ལུང་པས་༡༦༨ མཇལ་སྣ་བྱས།",
    "དེ་ནས་རྒྱལ་པོ་མགར་བཞུགས།",
    "ཀརྨ་འཕྲིན་ལས་ཀྱིས་འབའ་རོམ་པ་དགུང་ལོ་༧༧བཞེས་ནས་འདས་གསུངས།",
    "དགོན་འདིར་ཀོང་ཇོས་ཇོ་འཁོར་མཐོང་བ་རང་གྲོལ་ད་ལྟ་བར་དུ་བཞུགས།",
    "འདི་ལོ་ཟླ་བ་བདུནཔར་མི་ཉག་རྒྱལ་གྱི་མགའ་མཁར་ཧོར་གྱིས་བསྐོར།",
    "ཏི་ཤྲཱི་རས་པ་གཟེར་མགའ་དགོན་དུ་ཕེབས་ནས་བཞུགས།",
    "འགྲོ་མགོན་ཏི་༡༧༢ ཤྲཱི་རས་པ་ཐེངས་རྗེས་མ་མི་ཉག་རྒྱལ་ཁབ་ཏུ་ཕེབས། སོག་ཇིང་གེར་རྒྱལ་པོས་དགུང་ལོ་༦༦མི་ཉག་དུ་དམག་དྲངས་ཏེ།",
    "རྨའི་རྐང་བྱ་བ་ནས་ཡར་བོད་དུ་ཕེབས།",
    "དེ་ནས་རི་ཤོད་དུ་ལོ་ངོ་གཅིག་ལ་བཞུགས།",
    "འགྲོ་མགོན་ཏི་ཤྲཱི་རས་པ་༦༩ཁམས་སུ་ཕེབས་ནས།",
    "ཏི་ཤྲཱི་རས་པ་དགུང་ལོ་༧ལ་ཀུ་ས་དང་རྩིའི་གཞུང་དུ་བཞུགས།",
    "འབྲི་གུང་དང་བཙང་མགུར་བ།",
    "རྒྱ་གར་དུ་ཕེབས་ནས་ལེགས་སྦྱར་གྱི་བསྟན་བཅོས་མང་པོ་སྦྱངས།",
    "ཁྲི་འདུ་སོགས་རྒྱུད་དེ་རྒྱ་ནག་ཏུ་ཕེབས།",
    "ལམ་བར་ས་པཎ་གྱི་བཀའ་བཞིན་འཛིང་རྣམ་རྒྱལ་མགོན་ཁང་བཞེངས། ས་སྐྱ་པཎ་ཆེན་ལང་རྡུར་ཕེབས།",
    "དེ་ཆེན་གྱིས་སྡིག་སྦྱོང་དུ་ཕུལ་བའི་དངོས་པོ་སོགས་གནང་ནས་ཉིད་ཀྱི་བླ་ཚབ་ཏུ་བསྐོས།",
    "རབ་བདུད་ཆུ་ཁྱེར་ལྷ་སའི་ཇོ་བོ་ཡིད་བཞིན་ནོར་བུའི་སྐུ་ཚབ་རྒྱ་ནག་ཐང་རྒྱལ་རབས་ཀྱིས་བཞེངས་ཏེ།",
    "ཧོར་རྒྱལ་གྱིས་འཕགས་པར་ཕུལ།",
    "རབ་རྒྱལ་ལྕགས་བྱར་ཁམས་གསེར་རྟའི་རྒོད་རྒན་མཆོད་རྟེན་དུ་གདན་དྲངས། སྤྱན་སྔ་རས་པ་དཀར་པོ་དགུང་ལོ་༦༥བཞེས་ནས་གཤེགས།",
    "སེ་ཆེན་ཧན་གྱིས་འགྲོ་མགོན་འཕགས་པར་ཏི་ཤྲཱི་གོ་གནས་དང་།",
    "ལུགས་གཉིས་ཀྱི་གནང་སྦྱིན་༡༧༩ དཔག་མེད་མཛད།",
    "དེ་ནས་གསང་གཞུང་ཙོང་མདའ་རུ་ཕེབས།",
    "གསེར་འཕྲུ་དང་ཐོབ་སོགས་གནང་།",
    "མི་ཉག་བརྒྱུད་ལང་ཐོང་ལ་ཕེབས།",
    "སླར་ཧོར་གྱིས་གདན་དྲངས་པས་ཕེབས་ཏེ་ཧྲིན་ཨན་དགོན་དུ་བཞུགས།",
    "ཡང་སཾགྷས་ཕྲ་མ་བཅུག་སྟེ་ཧོར་རྒྱལ་གྱི་བཀས་ཁྲོ་ཀྲོས་ལ་སྤྲུགས་པ་ཟླ་བརྒྱད་པའི་ནང་བསླེབས་ཏེ་ཁེ་ཡོན་དགོན་དུ་བཞུགས།",
    "བཞེས་ནས་ཉ་ཟླའི་ཚེས་བརྒྱད་ཉིན་གཤེགས།",
    "རབ་མདའ་མེ་བྱ་ལ་སྒ་ཨ་གཉན་དོམ་པའི་དགུང་ལོ་༦༨ རྫུ་འཕྲུལ་གྱི་ལེགས་ལམ་ལ་བརྟེན་ནས་ཧོར་གོང་མའི་ཏི་ཤྲིར་དབུ་བླ་བསྐོས། སྐྱེད་ཚལ་བླ་རབས་བཞི་པ་སྐུ་ཕྲེང་གཉིས་པ་རྒྱ་རོང་མཁྱེན་རབ་༡༨༡ ཡེ་ཤེས་འཁྲུངས།",
    "སྒ་ཨ་གཉན་དམ་པ་ཏི་ཤྲཱི་ས་སྐྱའི་གདན་ས་ལ་ཕེབས་ཆོག་པའི་བཀའ་དྲིན་བསྐྱངས།",
    "ལོ་ལྟར་ཕེབས་པའི་བཞུགས་སྒར་དུ་གྱུར་པས་འཇའ་དམར་སྒར་དུ་གྲགས།",
    "ཀ་རབསལྔ་བའི་མདུན་དུ་རྨ་སེར་བསྙེན་པར་རྫོགས། ཟུར་མང་རྣམ་རྒྱལ་རྩེ་བཏབས།",
    "བདག་ཆེན་རྒྱ་༡༨༦ གར་བ་ཤེས་རབ་རྒྱལ་མཚན་དགུངལོ་༢༧ལ་ཁམས་སྟོད་དུ་ཕེབས་ནས་སྒ་ཀྱི་སྐུ་དོན་འགྲུབ་གླིང་པ་བཏབ།",
    "རབ་དབྱིག་ཆུ་ལུག་ཀ་རབས་བདུན་པ་ཁམས་སྟོད་འདམ་དཀར་ཕེབས།",
    "བེར་དམག་བསྟན་པ་གཤེགས་དུ་བྱུང་བར་ཡུན་རིང་འཐབ་ཀྱང་མ་རྟེན་པར་གདན་ས་སྐུ་འབུམ་ཤོར་ནས་རྒྱལ་ས་མཇུག་བསྡུས།",
    "རབ་དྲག་མེ་ཕག་ལོར་གོ་ཤྲཱི་ཀརྨ་རབ་བརྟན་དགུང་ལོ་༤༥བཞེས་ནས་གཤེགས།",
    "དེའི་བུ་བསྟན་འཛིན་རྡོ་རྗེ་ལ་གོང་མས་བསྟན་འཛིན་ད་ཡན་རྒྱལ་པོའི་ཆོ་ལོ་སྤྱད་ནས་བོད་ཀྱི་རྒྱལ་པོ་བྱས་སྐད།",
    "བར་ཁམས་དྲན་ཐང་དུ་གྲུབ་ཐོབ་སྤྲོཏི་ཛྙཱ་ན་སྐུ་ཚེའི་སྨད་དུ་ཕེབས་ནས་མྱ་ངན་ལས་འདས་པའི་སྐུ་གདུང་རིན་པོར་བཞུགས་པའི་མཆོད་རྟེན་གཙོ་བོར་གྱུར་པའི་སྐུ་གསུང་ཐུགས་རྟེན་མང་དུ་བཞུགས་པའི་ལྷ་ཁང་དུ་བརྒྱ་མཆོད་དང་སྤྱི་ཏིའི་སྐུ་བརྙན་ལ་ཁ་བཏགས།",
    "དེ་ནས་ལྡན་མ་བཀའ་བཅུས་བཏབ་པའི་འདམ་ཐོག་དགོན་དུ་བཞུགས།",
    "སྐྱེ་དགོན་སོགས་སུ་ཕེབས།",
    "ཟླ་གསུམ་པའི་ནང་ས་ཐར་ལམ་དགོན་དུ་ཕེབས།",
    "ཡོན་བདག་ཁུ་ཐོག་དང་ཤེས་པ་ཕ་བུ་བཅས་ཀྱིས་ཞབས་ཏོག་གཟབ་པར་ཞུས།",
    "ཐར་ལམ་དགོན་དུ་ཕེབས་ཏེ་སྦྱིན་སྟེར་སོགས་ཀྱི་བྲེལ་བ་རྣམས་བཅད།",
    "མགོན་ཁང་དུ་ཕྱག་ཕྲེང་ལུས་པ་རྣམས་རྒྱབ་སོར་སླར་འོངས་དགོས་པ་ཡིན་ནམ་སྙམ་གསུངས།",
    "ཆིབས་ཐོག་ནས་ཞུ་གནང་མཛད།",
    "སྟོད་སྨད་ནས་ཕེབས་པའི་རབ་བྱུང་དང་བསྙེན་རྫོགས་བསྒྲུབ་པ་ཉིས་བརྒྱ་བདུན་ཅུར་ལོངས་པ་སོ་སོའི་ཐུགས་བཞེད་བསྐངས་ནས་རྫོངས་བརྡ་ཞུས།",
    "སེར་སྐྱ་གཉིས་བཞག་ཀྱང་མ་ཕན་པར་ཟླ་གཉིས་ཙམ་ནས་འདས་གསུངས།",
    "དོན་གྲུབ་གླིང་དུ་ཕེབས་སྐབས་བསུ་བ་སེར་སྦྲེང་རྒྱ་ཆེན་པོ་དང་གནས་བརྟན་བགྲེས་པོ་ཚེ་དང་སྒྲུབ་པ་མཉམ་པ་རྣམས་ཀྱང་བསུ་བར་བྱུང་བས།",
    "ཕྱི་ཉིན་ལབ་མདའ་བརྒྱུད་ཁྲི་འདུར་ཕེབས་པ།",
    "སྔོན་རྒྱ་བཟའ་ཀོང་ཇོས་ཇོ་བོ་ཡིད་བཞིན་ནོར་བུ་གདན་དྲངས་པའི་སྐུ་ཚབ་ཏུ་བཞག་པའི་ཇོ་བོའི་སྐུ་ཚད་ངོ་མཚར་མཐོང་བ་དོན་ལྡན་དེ་འཕགས་པ་ཧོར་གོ་དན་ཡབ་སྲས་ཀྱིས་གདན་དྲངས་སྐབས་ཕུལ་བ་སྒ་ཨ་གཉན་དམ་པའི་མཆོད་གཞིར་བཞུགས་པའི་གཙུག་ལག་ཁང་དུ་ཕེབས་ཏེ་མཇལ་དར་མཎྜལ་ཞུས་༢༧ ནས་ཞག་ལྔ་བཞུགས།",
    "དེ་མཚམས་པད་ལུང་ནང་དུ་བླ་ཆེན་བློ་གྲོས་ཕུན་ཚོགས་ཀྱི་སྒར་དུ་ཕེབས་ནས་ཞག་གཉིས་བཞུགས།",
    "ངོར་པའི་ཁྲིར་བཞུགས་སྐབས་ཀྱི་ས་ཞུ་དེ་གནང་བས་དགོངས་པ་ཚིམ་ཙམ་བྱུང་།",
    "ཁྲི་འདུའི་སྒར་ཐོག་ཏུ་ཞག་གཉིས་བཞུགས།",
    "མགོན་ཁང་དུ་ལྷ་བརྒྱད་བཞེངས་དགོས་ཚུལ་གསུངས།",
    "སྲིབས་འོ་ཕོམ་མམ་སེབ་པ་དགོན་གྱི་གཙུག་ལག་ཁང་ནས་ཞག་གཅིག་ལ་རྗེས་གནང་དང་།",
    "སྤེ་རིང་གྲུ་སོ་ནས་ཕེབས་ཏེ་ཡོན་བདག་གཟུངས་འབུམ་དུ་ཞག་གཅིག་བཞུགས།",
    "སྤར་ཐང་སླ་འབྲང་སྒེས་སུ་སྒར་སྔ་ཕྱི་བསྡོམས་ཏེ་ཞག་གསུམ་བཞུགས།",
    "བན་ཆེན་མདའི་བླ་བྲང་དུ་གདན་དྲངས་པ་རྗེས་གནང་རབ་གནས་སོགས་མཛད།",
    "དམར་མགྲིན་གུར་ནང་བཅས་ནས་འདམ་ཐོག་དགོན་དུ་ཕེབས།",
    "གཙུག་ལག་ཁང་ནས་རྗེས་གནང་སོགས་མཛད།",
    "མདུན་ཆེན་ལ་ཁམས་སྒ་སྟོད་དུ་ཕེབས་དགོས་པའི་སྙན་སྒྲོན་བསྐྱར་དུ་ཕུལ་བས་ལམ་རྒྱུས་ཡོད་པའི་ཚོང་དཔོན་དགེ་ལུ་སོགས་བཏང་།",
    "བསྔོ་བ་བྱང་བུ་སོགས་མཛད་རྗེས་སྒར་བཏེག་སྟེ་ཁམས་སྟོད་ཉ་མཚོར་ཕེབས་པ་དཔོན་ག་ཐུར་སོགས་ཀྱིས་ཞབས་ཏོག་ཞུས།",
    "སྒྱོགས་ཆེན་སྒ་སྟོད་ཇོ་བོ་ཆུ་ཚན་ཁར་ཞག་ལྔ་བཞུགས་ནས་བུམ་གཏེར་བསང་མཆོད་མཛད།",
    "དེར་ས་པཎ་གྱི་གདུང་རུས་ངོ་མཚར་ཅན་བཞུགས་པ་ཐོག་མར་ཅུང་ཟད་ཞིབ་ཆ་མ་བྱུང་བས་རྟེན་མཇལ་མ་ཤེས།",
    "བླ་ཆེན་འཕགས་པའི་གདན་ས་གནམ་ལུང་རྣམ་རྒྱལ་གླིང་དུ་ཕེབས།",
    "དེ་ནས་སྤྲེ་ཁུ་ཀྲེ་གུ་གྲུ་ལས་སྔོན་བླ་ཆེན་འཕགས་པའི་གདན་ས་རྗེས་སོར་འབྲི་གུང་པའི་རྗེས་འཇུག་རྣམས་ཀྱིས་བསྐྱངས་པའི་དགོན་གནས་བཀྲ་ཤིས་སྒང་དུ་ཕེབས།",
    "དེང་སང་དགའ་ལྡན་པས་བདག་ཏུ་བྱས།",
    "ཁྲི་འདུར་ཕེབས་ལམ་དུ་བསེ་ཁོག་དང་།",
    "དཔོན་ཨེ་དྭན་གྱི་ཡུལ་དུ་གདན་དྲངས་པ་ཞག་ལྔ་བཞུགས།",
    "བླ་ཆེན་བློ་གྲོས་ཕུན་ཚོགས་ཁུ་དབོན་གྱིས་པད་ལུང་སྒར་དུ་གདན་དྲངས་པ་ཞག་གསུམ་བཞུགས།",
    "ཕར་ལའང་སོ་སོར་ངོས་སུ་བབ་པའི་གནང་༢༡༤ སྟེར་བྱས་གསུངས།",
    "སླར་སྐལ་བཟང་དགོན་དུ་ཕེབས་ནས་མཆོད་འབུལ་དང་གནང་སྟེར་གང་དགོས་མཛད།",
    "དྲི་སྒང་གྲུ་སྒང་ནས་དྲན་ཐང་ལྷ་ཁང་དུ་ཞག་གསུམ་བཞུགས་ཏེ་ཇོ་བོ་སྤྱི་ཏི་ཛྙཱ་ནའི་གདུང་འབུམ་ལ་རབ་༢༡༦ གནས།",
    "དམའ་རོང་ཟིལ་སྟོད་སོགས་བརྒྱུད་ནས་བར་ཁམས་ལྷུན་གྲུབ་སྟེང་དུ་བདེ་བར་ཕེབས།",
    "དཔོན་ཁག་སོ་སོར་བཀའ་ཤོག་དང་གནང་སྦྱིན་སོགས་བསྐུར་ནས་འཁྲུག་པ་བསྡུམས་པས་རག་ཤུལ་ཨེ་ཁེ་ཐེ་ཇིའི་སྐུ་ཚབ་བཏང་ཏེ་འབུལ་བ་བཟང་པོ་ཞུས།",
    "ལྷ་ལུང་ཁུག་བཅས་ནས་དགོན་ཆེན་དུ་ཕེབས།",
    "རབ་ཉི་ཤིང་གླང་ཟླ་བ་གསུམ་པར།",
    "ཧོར་ཟླ་གསུམ་པའི་ཚེས་དྲུག་ཉིན་དོན་གྲུབ་གླིང་དུ་ཕེབས་སིང་ཚེས་བདུན་ཉིན་གཙུག་ལག་ཁང་གསར་པར་སྐར་འཛིན་མཛད།",
    "སྒ་ཁྲ་འགུ་དགོན་གྱི་ལྷ་ཁང་གསར་བཞེངས་སུ་གདན་ཞུ་ལ་ཕེབས་ཤིང་།",
    "ཤིང་ཆ་བསྐྱར་བསྒྲིག་དང་ལྡེབས་ཀྱི་བཀོད་པ་ཟལ་འདེབས་བཅས་གནང་ནས་ཁྲི་མདར་བཞུགས།",
    "ཟླ་དགུ་པར་སྐྱེ་དགུའི་དོན་གྲུབ་དང་ཐར་ལམ་ལྷུན་གྲུབ་བདེ་ཆེན་གྱི་༢༢༡ གཙུག་ལག་ཁང་གསར་བསྐྲུན་བྱས་པའི་སྒོ་ཤན་སྒྲོས་ལྡན་རྣམས་བརྡུངས་གྲུབ་པ་སྐྱེལ་བར་མངགས།",
    "ཟླ་གསུམ་པའི་ཚེས་བཅུ་གཅིག་ལ་བཀྲ་ཤིས་ལྟེམ་དུ་ཕེབས།",
    "དྭའུ་བླ་དགོན་གྱིས་བསུ་བ་དང་བཅས་དོན་འགྲུབ་གླིང་དུ་ཕེབས།",
    "གནང་རྩེའི་རི་ཁྲོད།",
    "རྟ་པ་བརྒྱ་སྐོར་གྱིས་སྐྱེལ་མ་དང་བཅས་དོན་གྲུབ་གླིང་དུ་ཕེབས།",
    "བསྟན་འཛིན་ལྷུན་འགྲུབ་འཇམ་མགོན་བཀྲ་ཤིས་ལྷུན་གྲུབ་སོགས་ཀྱི་སློབ་བུར་གྱུར་པ་དེས་གདན་དྲངས་ནས་སྤྱིལ་བུར་བཞུགས་སུ་གསོལ།",
    "དེ་ཉིད་འདས་རྗེས་ཚ་བོ་དེས་ཁོང་གདན་དྲངས་པར་བསྔོ་སྨོན་དང་།",
    "ཁྲ་འགུ་སྐུ་སྐྱེ་བཅས་ཀྱིས་གདན་དྲངས་ཤིང་འདུ་ཁང་གསར་པར་རབ་གནས་མཛད་དྭའུ་དཔོན་པད་མ་མགོན་པོ་དང་།",
    "བུ་ཆེན་ཨེར་ཁེ་བཱ་ཇི་དབོན་ཡབ་སྲས་བཅས་ཀྱིས་གདན་དྲངས་ཤིང་དེ་ནས་ཀུ་ཆུང་མདར་བཞུགས།",
    "རིན་ཆེན་གླིང་ནས་བླ་ཆེན་འཕགས་པའི་སྐུ་སྲུང་པུ་ཏྲ་དམར་པོ་མཇལ་ཁ་གནང་བ་དང་སླར་རྒྱས་བཏབ།",
    "སྐུ་མཚམས་བཞུགས་པ་ཟླ་བ་གཉིས་པའི་ཚེས་ལྔ་ཉིན་གྲོལ་ཚེས་བཅོ་ལྔ་ཉིན་སི་ཏུ་སྐུ་ཞབས་དང་མཇལ།",
    "དབྱར་དང་པོ་ཤར་འཕྲལ་སྤར་ཐང་ཁྲ་བོ་ལ་ཐོག་ཏུ་བཞུགས་ཤིང་།",
    "ཡོན་བདག་རྣམས་ཀྱིས་གདན་དྲངས་པར་ཕེབས།",
    "འདོད་པ་ལྟར་གཙུག་ཕུད་བླངས་ཏེ་མ་བཙུན་སར་དང་བུ་བརྗེ་བྱོས་གསུངས།",
    "བན་ཆེན་བླ་བྲང་བཅས་སུ་གདན་དྲངས་ཤིང་རྟ་བསུ་ཇ་འདྲེན་བཅས་དོན་གྲུབ་གླིང་དུ་ཕེབས་ནས་ཞག་བཅུ་སྐོར་བཞུགས།",
    "གཙུག་ལག་ཁང་གསར་པར་རབ་གནས་དང་།",
    "སྤར་ཐང་ནས་དཀར་པོ་ལ་དང་རྡོ་ར་དམར་ཁོར་ཕེབས།",
    "ཕྱི་ཉིན་ལྷ་མཇལ་དང་རྗེས་གནང་སོགས་མཛད།",
    "རི་ཐུང་ཐུབ་བསྟན་དར་རྒྱས་གླིང་དུ་ཞག་གཉིས་བཞུགས་ཏེ།",
    "བླ་ཆེན་འཕགས་པའི་སྐུ་སྲུང་པུ་ཏྲ་རྟ་ཐོག་མའི་ཞལ་འབག་མཇལ་ཁ་གནང་སྟེ་སླར་རྒྱས་བཏབ།་",
    "ཡུལ་ཤུལ་སོགས་ལ་ཕེབས་དགོས་པར་ཞུས་ཀྱང་སྐབས་མ་འགྲིགས།",
    "དེ་ནས་མགྱོགས་པར་འདམ་ཐོག་དང་།",
    "དྲན་ཐང་ཇོ་བོའི་སྐུ་མདུན་དུ་བརྒྱ་མཆོད་འབུལ་སྣོད་ཀོང་བུ་བརྒྱ་རྩ་གསར་བླུགས་སྒྲོས་ལྡན་སྦྱོར་འཇགས་སུ་འབུལ་རྒྱུ་དང་།",
    "ཟིན་པའི་དུས་ཚོད་ནི་ཅུང་ཞིག་མིན་བསམས་པར།",
    "སྤེ་རིང་ཡོན་བདག་གཟུངས་འབུམ་སྤུན་གྱི་ཁྱིམ་དུ་སྒར་ཡོངས་རྫོགས་ཞག་གཅིག་བཞུགས་ཏེ་རྗེས་གནང་དང་བརྟག་ཞུས་སོགས་མཛད།",
    "ལམ་རྩུབ་ཅིང་གངས་དང་འཁྱག་རོམ་གྱིས་ཕེབས་དཀའ་བ་བྱུང་།",
    "འཛིན་མདར་ཕེབས་ཁར་ཡོན་བདག་རྣམས་ཀྱི་རྟ་བསུ་འབྱོར།",
    "ཡུལ་དེར་རི་ཁྲུས་དང་སེར་སྐྱ་སྟོང་དུ་ལོངས་པ་ལ་རྗེས་གནང་མཛད།",
    "ལམ་ཞོར་དུ་རག་ཉག་བཀའ་བཅུ་རི་ཁྲོད་པའི་ཁྱིམ་དུ་ཕེབས།",
    "ཐོག་མགྲོན་བར་དུ་ཟླ་གཅིག་ཙམ་བཞུགས་པའི་རིང་ཡོན་བདག་ཁག་དང་།",
    "གཟའ་ཚེས་བཟང་ཉིན་སྐལ་བཟང་དགོན་དུ་ཕེབས་ཏེ་ཁྲི་འདུ་བ་རང་དང་།",
    "རིན་ཆེན་གླིང་བཅས་ཀྱིས་གདན་དྲངས་པར་ཕེབས་རྗེས།",
    "ཟླ་གསུམ་པའི་ཚེས་བཅུ་བདུན་ཉིན་དབུས་སུ་ཕེབས་ནས་བསྒྲིགས།",
    "ཚེས་བཅུ་བདུན་གྱི་ཉི་མ་རྩེ་ཤར་ནས་ནམ་མཁར་འཇའ་འོད་གདུགས་དང་རྒྱལ་མཚན་གྱི་རྣམ་པ་ཅན་མང་དུ་བྱུང་བ་མདུན་བཞུགས་རྣམས་ཀྱིས་མཐོང་།",
    "རབ་འདོད་མེ་སྦྲུལ། ཀརྨ་པ་སྐུ་ཕྲེང་༡༣པ་བདུད་འདུལ་རྡོ་རྗེ་དགུང་ལོ་༦༥པར་ཁམས་སྟོད་བན་ཆེན་དགོན་དུ་སྐུ་གཤེགས།",
    "སྒ་སྟོན་དགུང་ལོ་༡༨ལ་གཙང་ངོར་རུ་དགོན་དུ་ཕེབས།",
    "སྒ་འཇམ་རྒྱལ་དགུང་ལོ་སོ་བདུན་ལ་སྒ་ཐར་ལམ་དུ་ཕེབས།",
    "རབ་ཚེས་ལྕགས་སྤྲེལ་སྒ་འཇམ་རྒྱལ་དགུང་ལོ་༥༡ནས་ལོ་ལྔར་བཅད་རྒྱ་བཞུགས།",
    "རབ་ཚེས་མེ་སྟག་སྒ་འཇམ་རྒྱལ་དགུང་ལོ་༥༧ལ་དྲྭ་མ་སྒང་དུ་ཕེབས།",
    "ད་ལྟའང་སྐུ་ཤ་ཐོར་བུ་ཡོད་པར་སྣང་།",
    "ཆུ་རྒྱུན་མང་ལ་ཁྱད་པར་དུ་མཚན་སྙན་གྲགས་པའི་འབྲི་ཆུ།",
    "དེ་ལས་ཁྱད་པར་དུ་གཞས།",
    "དེ་རྗེས་ངལ་རྩོལ་བསྒྱུར་བཀོད་ལོ་ལྔར་གནང་།",
    "རྗེ་ཉིད་ནས་ཀྱང་ས་རྡོ་སོགས་ཁུར་ནས་༢༦༢ སྐྱེ་འགྲོ་རྣམས་ལ་སྐུལ་སློང་མཛད་པས་གང་མགྱོགས་རྟེན་དང་བརྟེན་པར་བཅས་པ་ལེགས་པར་གྲུབ།",
    "མགོན་བླ་སྒྲུབ་པ་སོགས་སྔར་རྒྱུན་བཞིན་རྒྱུན་འཛུགས་གནང་།",
    "ཐར་རྩེ་ཞབས་དྲུང་རྣམ་གསུམ་ཀྱི་སྐུ་དོན་འགྲུབ་གླིང་དུ་ཕེབས་ནས་ཆིབས་བསུ་ཤིན་ཏུ་རྒྱས་པ་ཞུས་ཏེ།",
    "བཙན་ལ་ཡ་མེད་སོགས་དཔའ་རྟགས་བརྒྱད་ཀྱི་གྲགས་པ་རྣམ་པར་དཀར་བ།",
    "སྲིན་པོ་ཕྲག་མིག་གཙོས་ནག་པོའི་རྩ་ལག་ཁ་བཏགས་པར་བྱས།",
    "དཀར་པོའི་ཕྱོགས་རྣམ་པར་རྒྱལ་བའི་རུ་མཚོན་བསྒྲེངས།",
    "པདྨ་གུང་བཙན་སོགས་དཔའ་མཛངས་སྟོབས་ཀྱི་རལ་གྲིས་གནམ་ས་ཕྱེད་དུ་གཤག་མཁན་བགྲང་བར་མི་ནུས་པ་བྱུང་།",
    "འབྲུ་སྤྱི་ཕུད་འཁོར་ལོ་བཟང་པོས་འཇམ་དབྱངས་པའི་ཚངས་པ་ཆེན་པོའི་ནང་བློན་ཡོངས་ཀྱི་ཆེ་བ་གནང་སྟེ་ཆེན་པོ་ལ་འོས་པའི་ལས་ཚན་བཅུ་གསུམ་ཐོབ།",
