    "བཅོམ་ལྡན་འདས་ལ་ཆ་གུས་པ་སྐྱེ་བར་གྱུ་བས་བཅོམ་ལྡན་འདས་ནི་གནས་མ་ཡིན་པར་མི་འཇུག་པ་དགའདུན་གྱི་དབྱེན་ལ་སོགས་པོ་བཟློག་པ་ཡལ་བར་བཞག་པ་དང་འདྲབར་ཤེས་པར་བྱའོ།",
    "ངེས་པར་ཞེས་བྱབ་ནི་གདོན་མི་ཟ་བར་རམ་གོརམཆག་པར་རོ།",
    "རྗེས་སུ་འགྲོ་བར་གྱུར་ཅིག་ཅེས་བྱ་བནི་རྗེས་སུ་ཐོབ་པར་གྱུར་ཅིག་ཅེསསོ།",
    "ཆེད་དུ་བརྗོད་པ་ཆེད་དུ་རྗོད་པ་བྱེད་དེ་ཞེས་བྱ་བ་ནིམགུ་བའི་ཚིག་རྔོད་པར་བྱེད་པ་སྟེ།",
    "ཡིད་བདེ་བཚིག་ཏུ་རྗོད་པར་བྱེ་དཅེ་ས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྩེ་འགྲོགས་ལྷཀྱིམ་མཞེས་བྱ་བ་ནི་རྩེར་འཇུག་པར་བྱེད་པ་གང་ཡིན་པའོ།",
    "གཉིས་གཉིས་བསྐོ་བ་ནི་བྲེལ་པ་ཉིད་ཀྱིས་ཕོངས་པར་མིའགྱུར་བར་བྱ་བའི་ཕྱིར་རོ།",
    "ཡོ་བྱད་ཀྱི་བྱེ་བྲག་ཅེས་བྱ་བ་ནི་ཡོ་བྱད་ཁྱད་པར་ཅན་དག་གོ།",
    "སྐྱེད་པར་བྱེད་པནི་སྦོམས་སུའོ།",
    "མྱུར་དུ་ཞེས་བྱ་བ་ནི་སྐྱེན་པར་རོ།",
    "ཉེ་བར་ཞུགས་ནས་ཞེས་བྱ་བ་ནི་བསླབ་པའི་ཕྱིར་ངེས་པར་སྦྱར་ནས་སོ།",
    "མཁས་པར་གྱུར་ཏོ་ཞེས་བྱ་བ་ནི་བྱང་བར་གྱུར་པའོ།",
    "ཕལས་བྱུང་བཞེས་བྱ་བ་ནི་ཕ་ལས་ཐོབ་པའོ།",
    "ཚངས་པར་སྤྱོད་པའི་མཐའ་ཞེས་བྱ་བ་ནི་ལམ་གྱི་འགྲུས་བུ་མ་ངནལ་ས་འདས་པའོ།",
    "གོ་བར་བྱེད་ཅིང་ཞེས་བྱ་བ་ནི་ཤེས་པར་བྱེད་ཅིང་ངོ།",
    "ཅི་ཞིག་ཤེས་པར་བྱེད་ཅིང་ཞེན།",
    "མེད་པདང་འདོད་པའི་རྙེད་པ་དང་བཀུར་སྐུ་ལརྒྱབ་ཀྱིས་ཕྱོགས་པཞེས་བྱབ་ནི་དྲན་པ་དག་དང་འདོད་བའི་རྒྱུར་གྱུར་པའི་རྙེད་པ་དག་དང་བཀུར་སྟེ་དགལ་མི་ཕྱོགས་པར་གྱུར་པའོ།",
    "རྣམ་པར་གྲོལ་བའི་ཞེས་བྱ་བ་ཞི་རྣམ་པར་གྲོལ་བར་གྱུར་བ་ན་ཐོབ་པའོ།",
    "སེམས་རྣམ་པར་གྲོལ་བཞེས་བྱ་བ་ནི་སེམས་ཀྱི་སྒྲིབ་པ་འདོད་ཆགས་ལ་སོགས་པ་སྣང་བའོ།",
    "ཅུང་ཟད་འགྱོད་པར་གྱུར་རྣམ་པར་འགྱོད་པར་གྱུར་རབ་དུའགྱེད་པར་གྱུར་ཅིགཅེས་བྱ་བ་གསུམ་ནི་འགྱོད་པའི་གནས་སྐབས་ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོར་གྱུར་པའོ། འགྱོདཔ་དང་ལྡན་པ་ཞེས་བྱ་བ་ནི་ངན་པ་བྱས་པའི་ལས་ཡང་དང་ཡང་དུ་དྲན་པར་བྱེད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཕྲག་པ་གློད་ཅེས་བྱ་བ་ནི་བརྩོན་པ་མེད་པའི་ཕྱིར་བྲག་པ་ལྕག་པར་བཏང་བའོ།",
    "ཡང་དག་པར་དགའ་བར་གྱུར་པ་ཅེས་བྱ་བ་ནི་ཡང་དག་པར་ར་ངས་པར་འགྱུར་བ་སྟེ།",
    "དེའི་ཡོན་ཏན་ཡང་དག་པར་བརྗོད་པའི་ཕྱིར་རོ།",
    "བྱས་ཏེ་ཤེས་བྱ་བ་ནི་ཕན་ཚུན་བྱས་ཏེའོ།",
    "བཤེས་པ་དང་ལྷན་ཅིག་འཇུག་པ་ནིབཞེས་པ་དང་བཅས་པའོ།",
    "ཕྱིར་ཟློག་པར་ཡང་མི་བྱེད་ཅེས་བྱབ་ནི་ཕྱིར་འགོག་པར་ཡང་མི་བྱེད་པ་སྟེ་དེ་བྱ་བམ་ཡིན་པ་ངེས་པར་མེད་པའི།",
    "མི་ཚངས་པར་སྤྱོད་པའི་རྐྱེན་གྱིས་ཞེས་བྱ་བ་ནིམིཆ་ངས་པ་ར་སྤྱོད་པའི་རྒྱུར་བྱས་ཏེའོ།",
    "བྱས་པར་གྱུར་ཏོ་ཞེས་བྱ་བ་ནི་བྱས་པ་དང་ལྡན་པའོ།",
    "ཅིའི་ཕྱིང་རྨེད་པར་མཛད་ཅེ་ན།",
    "དུསམཁྱེན་པ་ཡིནཔས་ཞེས་བྱ་བ་ལ་གལ་ཏེ་དུསམཁྱེན་པ་ཞེད་ཀྱིས་ཅི་ཞིག་སྟོན་པར་བྱེད་ཅེ་ན།",
    "དེས་བཅོ་མ་ལྡན་འདས་ཐབས་ཅད་མཁྱེན་པ་ཡིན་པར་ཡིད་ཆེས་པའི་ཕྱིར་ཏེ།",
    "དེའི་ཕྱི་ར་དེ་ནིརབ་ཏུ་བྱུང་བས་བྱ་བ་མ་ཡིན་ན་ནོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འོན་ཀྱང་བྱ་བརྣམ་པར་ཟློག་པའི་ཕྱིར་སྐུད་པ་མཛད་དེ།",
    "ཚངས་བར་སྤྱད་པར་བྱ་བལས་བརྟེན་ཏེ་དཔེར་མཛད་པ་ནི་མ་ཡིན་གྱི་འདི་ལྟར་གནོད་པར་འགྱུར་བ་ལས་བརྟེན་ཏེ་དབེར་མཛད་པ་ཡིན་ཏེ།",
    "ཁྱིམ་བཏངབ་དང་ཆུང་མ་ལས་གྲོལ་བ་དང་བསླབ་པ་ཡང་དག་པར་བླངས་པ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་དང་།",
    "འདི་ལྟར་སྣོད་ཉམས་པའི་ལྦ་ཕྱིར་རོ་ཞེས་ཀྱང་གསུངས་སོ།",
    "ཞེས་བྱབལ་སོགསཔ་གསུངས་པས་ཞེས་པར་སྤྲད་པཐམས་ཅད་སྨད་པ་དང་ལེགས་པར་སྤྲད་པ་ཐམསཅད་བསྔགས་པར་མཛད་ཟིན་པས་དེའི་ཕྱིར་རྣམ་པར་སྨད་པ་མཛད་དོ།",
    "བསླབ་པ་ཡང་དག་པར་མ་བླངས་བརྣམས་ཕྱི་རོལ་ཏུབྱེད་པའི་ཕྱིར་རོ།",
    "ངོ་ཚ་ཤེས་པ་རྣམས་བདེ་བརག་ནས་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ཡོན་ཏན་དང་ལྡནཔ་རྣམས་བདེ་བར་བྱ་བའི་ཕྱིར་རོ།",
    "ཚངས་པར་སྤྱོད་པ་ཞེས་བྱབ་ནི་ལམ་གྱི་བརྟེནཔའོ།",
    "གདོ་ནཔར་བྱ་སྟེ་ཞེས་བྱ་བ་ནི་ཀླག་པར་བྱ་བ་འམ་གཞན་དག་ལ་ལུང་དབོག་པར་བྱ་བའོ།",
    "རྣམ་པརལྟ་བར་བྱེདཔ་ཞེས་བྱ་བ་ནི་རྟོག་པར་བྱེད་པའོ།",
    "མ་ད་མ་ནི་རྔམ་པར་གྱུར་ཅེས་བྱ་བ་ནི་འཁྲུག་བཆེན་པོས་དྲག་ཤུལ་ཉིད་དུ་གྱུར་པའོ།",
    "འོནཀྱང་ཞེས་བྱབ་ནི་ཁྱད་པར་ངུའོ།",
    "བཀག་ཅེས་བྱ་བནི་དགག་པར་མཛད་པའོ།",
    "སྐྱེ་བ་དང་རྒ་བ་དང་འཆི་བར་འགྱུརབཞེས་བྱབ་ལསྐྱེ་བ་ཞེས་བྱ་བ་ནི་སྐྱེ་བ་གཞན་ནོ།",
    "གསོལ་བ་དང་བཞིའི་ཞེས་བྱ་བ་ནི་ལས་བརྗོད་པར་གང་ལ་གསོལ་བ་ངང་ལས་བརྗོད་པ་གསུམ་དང་བཞི་བྱེད་པའོ།",
    "གྱུང་བཞེས་བྱབ་ནི་ཞུགས་པས་སོ།",
    "གཏོང་བར་འདོད་ན་ཆག་ས་པར་གྱུར་པ་ལ་སོགས་པ་བཞིན་དུ་བསླབ་པ་བཏང་བར་གྱུར་པའི་ཕྱིར་རོ།",
    "གལ་ཏེཁྲོས་པ་ནིགཏོང་བའི་སེམསམེདཔརལྭ་བཟིལ་གྱིས་ནོན་པས་བསླབ་པ་འབུལཞན་དེའི་ཚེ་བསླབ་པ་མ་ཕུལ་བར་བརྗོད་པར་བྱའོ།",
    "ཚེ་ཡང་བསླབ་པ་མཕུལ་བར་བརྗོད་པར་བྱ་ལོ་ཞེས་བྱ་བའི་ཐཚིག་གོ།",
    "སྤྱད་དཀའ་བཞེས་བྱ་བ་ནི་བསྒྲུབ་པ་དཀའ་བའོ།",
    "ཁོང་དུ་ཆུད་པརད་ཀའ་བ་ཞེས་བྱ་བ་ནི་ཤེས་པར་དཀའབའོ།",
    "རྣམ་པ་དེ་དག་མ་གཏོགས་པ་ཞེས་བྱ་བནིད་བུལ་བ་དང་ཉམས་པར་བྱ་བའི་རྣམ་པ་སྔར་བསྟན་པའི་དེར་ག་མ་ག་ཏོགས་པ་ལོ།",
    "དེཉིད་རྫོགས་པར་བསྙེན་པ་ཡིན་ཏེ།"
  ]
}