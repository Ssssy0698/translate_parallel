    "རྡོ་རྗེ་གསོར་ཞིང་སྔགས་དེ་དང་འདི་བརྗོད་པར་བྱའོ།་།",
    "བསྟོད་པ་འདིས་བསྟོད་པར་བྱའོ།",
    "དེ་ནས་ཁྲོ་བོའི་བདག་པོ་ཆེན་པོ་ཕྱག་ན་རྡོ་རྗེས་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "དཀྱིལ་འཁོར་ཆེན་པོ་འདི་མཐོང་བ་ཙམ་གྱིས་ཁམས་གསུམ་པའི་རྒྱལ་སྲིད་འཐོབ་ཅིང་འདིའི་རྡོ་རྗེ་འཆང་བཟླས་པ་ཙམ་གྱིས་རྡོ་རྗེ་འཆང་དང་མཚུངས་པར་འགྱུར་རོ།་།",
    "གལ་ཏེ་སྔགས་པ་ཁྲོས་ན་ཁྲོས་པ་ཙམ་གྱིས་འཇིག་རྟེན་པའི་ལྷ་ཐམས་ཅད་དུམ་བུ་བརྒྱར་ཞིག་པར་འགྱུར་རོ།",
    "བདག་ཉིད་བསྲུང་༧བའི་སྔགས་འབུམ་བཟླས་ན་མྱུར་དུ་འགྲུབ་པར་བྱེད་པའོ།",
    "ཕྱག་རྒྱ་འབར་བར་འགྱུར་ཏེ་འབར་བ་ཙམ་གྱིས་རྡོ་རྗེ་འཆང་དང་མཚུངས་པར་འགྱུར་ཞིང་རྒ་བ་དང་།",
    "རྐང་པ་གཡས་པས་མནན་ནས་ཁྲོ་བོའི་སྔགས་འདི་བཟླས་པར་༦སྐུབྱ་སྟེ།",
    "སྒྲུབ་པའི་ཐབས་ཀྱི་ཆོ་ག་རྒྱས་པའི་རིམ་པར་ཕྱེ་བ་དང་པོ་རྫོགས་བེདུ་༢་།་།",
    "དེ་ནས་འདིར་ནི་དུ་ཤིན་ཏུ་འདའ་བར་དཀའ་བ་མཆོག་ཏུ་དྲག་པོ་ཆེན་པོའི་སྒྲུབ་པའི་ཐབས་ཤིན་ཏུ་དྲག་པོ་ལས་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་པ་གསུངས་པ་ལིང་༡ཀ་གཅིག་པ་རྐང་པ་གཡོན་པས་མནན་ཏེ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་ཉི་མ་བདུན་ན་ལྷ་ཆེན་པོ་དེ་རིན་མྱུར་དུ་འོང་ངོ།",
    "སྲེད་མེད་ཀྱི་བུ་མནན་ཏེ་ཉི་མ་བདུན་༤སྟོང་ཕྲག་བདུན་བཟླས་ན་ཉི་མ་བདུན་པ་ལ་ངེས་པར་འོང་ངོ།",
    "གལ་ཏེ་མ་འོངས་ན་སྤྱི་བོ་འགས་པའམ་བསྐམས་༥༥པར་འགྱུར་རོ།",
    "ངེས་པར་སྲིད་མེད་ཀྱི་བུ་འཁོར་དང་བཅས་པ་མངག་གཞུག་པར་འགྱུར་རོ།",
    "མངག་གཞུག་པར་འགྱུར་རོ།",
    "ཉི་མ་བདུན་དུ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་ཉི་མ་བདུན་ན་ངེས་པར་འོང་སྟེ།",
    "གལ་ཏེ་མ་འོངས་ན་ངེས་པར་འཆི་བར་འགྱུར་རོ།",
    "འདིས་བརྒྱ་བྱིན་མངག་གཞུག་པར་འགྱུར་ཞིང་པང་ན་གནས་པ་བླངས་ཏེ་སྟེར་བར་བྱེད་དོ།",
    "གཞོན་ནུ་མངག་གཞུག་པར་འགྱུར་རོ།",
    "ཟླ་བ་མནན་ཏེ་བརྒྱད་སྟོང་བཟླས་ན་ཉི་མ་བདུན་ན་མྱུར་དུ་འོང་ཞིང་མངག་གཞུག་པར་འགྱུར་ལ་གསེར་སྲང་བརྒྱ་སྟེར་རོ།",
    "ནམ་ཕྱེད་ན་སྒྲ་ཆེན་པོ་བྱུང་སྟེ་དྲག་དུ་རྒོད་༡༡ཅིང་བསྡད་ནས་༡༢།",
    "དེས་སྐྲག་པར་མི་བྱའོ་སྟེ།",
    "གལ་ཏེ་སྐྲག་པར་གྱུར་ན་ཡི་གེ་ཧཱུྃ་བཟླས་ན་བདེ་བར་གནས་པར་འགྱུར་རོ།",
    "ལྷ་ནག་པོ་ཆེན་པོ་འཁོར་གྱི་ཚོགས་དང་བཅས་པ་མངག་གཞུག་པར་འགྱུར་རོ།",
    "གལ་ཏེ་མ་འོངས་ན་རིགས་དང་རྒྱུད་༡རིབརླག་པར་འགྱུར་རོ།",
    "ཚངས་པར་སྤྱོད་པ་ལ་རྟག་ཏུ་གནས་པ་དང་།",
    "དང་པོར་བསྒྲུབ་པར་བྱ་ཞིང་དེའི་འོག་ཏུ་དངོས་གྲུབ་ཀྱི་མཆོག་བཟང་པོ་རིག་འཛིན་དང་།",
    "བཅོམ་ལྡན་འདས་དཔལ་རྡོ་རྗེ་འཆང་ཁྲོ་བོའི་བདག་པོས་འདི་སྐད་ཅེས་གསུངས་སོ།་།",
    "དཔལ་རྡོ་རྗེ་འཆང་ཁྲོ་བོའི་བདག་པོ་བཟླས་པ་ཙམ་གྱིས་མྱུར་དུ་འགྲུབ་པར་བྱེད་པ།",
    "དོན་ཡོད་ཅིང་བགེགས་འཇོམས་ལ་གྲུབ་པར་བྱེད་པའི་སྔགས་ཀྱི་ཚིག་རྣམས་སོ།",
    "ལྷབརླག་པར་འགྱུར་རོ།",
    "དེ་༡ནས་ནམ་ཕྱེད་ཀྱི་དུས་སུ་རྒྱན་ཅན་མ་ངེས་པར་འོང་ངོ།",
    "ཙནྡན་གྱི་བདུག་པ་བྱིན་ནས་ཡང་བཟླས་ན་ནམ་ཕྱེད་ཀྱི་དུས་ན་ངེས་པར་འོང་ངོ།",
    "ལན་སྟོང་བཟླས་ན་ཉི་མ་བདུན་ན་ངེས་པར་འོང་ངོ།",
    "དེ་ནས་ཤིན་ཏུ་འདའ་བར་དཀའ་བའི་སྒྲུབ་པའི་ཐབས་ལྷ་ཆེན་པོ་ཐམས་ཅད་གསོད་པར་བྱེད་པའི་སྔགས་ཀྱི་ཚིག་རིནསྭཱགསུངས་པ།",
    "ནམ་མཁའ་ལྡིང་རྣམས་དུམ་བུ་བརྒྱར་བྱས་ཏེ་དགུག་༥༥པར་འགྱུར་རོ།",
    "ཅུང་ཟད་རྒོད་པས་ཆགས་པ་བྱས་ནས་མདུན་དུ་སྡོད་དོ།",
    "འཁྱུད་༤༧པ་དང་འོ་བྱས་ཤིང་དགའ་བས་ཆགས་པར་བྱས་ནས་༥།",
    "འདི་ལྟར་འགྲུབ་པར་འགྱུར་ཏེ།",
    "གུ་གུལ་གྱི་བདུག་པ་བྱིན་ནས་མཚན་ཐོག་ཐག་བཟླས་ན་དེའི་ཐོ་རངས་ངེས་པར་འོང་སྟེ།་",
    "འདོད་པ་ཐམས་ཅད་སྦྱིན་པར་བྱེད་དོ།",
    "སྨྱུང་བ་ཡང་མི་དགོས་པར་འགྲུབ་པར་བྱེད་པ་སྟེ།",
    "འོངས་པ་ན་༥ཆུང་མར་འགྱུར་ལ་དངུལ་ཆུ་དང་བཅུད་ཀྱིས་ལེན་སྟེར་ཞིང་ཅི་༦་ལྟར་འདོད་པས་ཆགས་པར་བྱེད་ལ་ལོ་ཁྲི་འཚོའོ།",
    "འོངས་པ་ལ་མྱུར་དུ་ཆགས་པར་བྱས་ན་དགའ་བར་འགྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "བའི་བདག་པོ་ཕྱག་ན་རྡོ་རྗེས་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "དངོས་གྲུབ་སྣ་ཚོགས་གྲུབ་པར་བྱེད་པ།",
    "ཉེ་བར་བྱེད་ཅིང་མངོན་དུ་ཕྱོགས་པར་བྱེད་ལ་ཐམས་ཅད་དུ་འདོད་པ་སྒྲུབ་པར་བྱེད་པའི་ཕྱག་རྒྱའོ།",
    "གལ་ཏེ་ཆུང་མར་གྱུར་ན་བསམ་པ་ཐམས་ཅད་རྫོགས་པར་བྱེད་ཅིང་ནོར་གྱི་བདག་པོ་ཆེན་པོ་བྱེད་དོ།",
    "ནམ་ཕྱེད་ཀྱི་བར་དུ་བཟླས་ན་དེ་ནི་ངེས་པར་འོང་ངོ།",
    "དེས་ཀྱང་མ་ལུས་པར་ཟད་པར་བྱའོ།",
    "འོངས་པ་ལ་ཆགས་པ་བྱས་ན་ཆུང་མར་འགྱུར་རོ།",
    "གཞན་གྱི་ཆུང་མ་ལ་མི་བགྲོད་པར་ཡང་བྱ་སྟེ།",
    "གལ་ཏེ་བགྲོད་ན་རྣམ་པར་འཇོམས་པར་བྱེད་དོ།",
    "འོངས་པ་ལ་དགའ་བས་ཆགས་པ་བྱས་ན་ཆུང་མར་འགྱུར་རོ།",
    "སྒྲུབ་པ་པོ་འཁོར་དང་བཅས་པ་ཡོངས་སུ་སྐྱོང་༡་བར་བྱེད་ཅིང་ལྷས་འདོད་པར་བྱ་བའི་ཟས་དང་།",
    "ཅི་༡་སྲིད་ནམ་ཕྱེད་ཀྱི་བར་དུ་བཟླས་ན་ནམ་ཕྱེད་ན་ངེས་པར་འོང་ངོ་ཌི།",
    "འོངས་པ་ལ་ཆགས་པ་བྱས་ན་ཆུང་མར་འགྱུར་ཏེ།་",
    "མར་གྱི་མར་མེ་རབ་ཏུ་སྦར་ནས་མཚན་ཐོག་ཐག་བཟླས་ན་དེའི་ཐོ་རངས་ངེས་པར་འོང་ངོ།",
    "དེ་ནས་གསང་བ་པའི་བདག་པོ་ཕྱག་ན་རྡོ་རྗེས་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "གལ་ཏེ་དམ་ཚིག་ལ་མི་གནས་ན་ཁྲོ་བོ་འདི་དང་བཅས་ཏེ་དགུག་པའི་ཕྱིར་བཟླས་པར་༧བྱའོ།",
    "ཕྱག་རྒྱ་འདི་ས་འཇིག་རྟེན་གསུམ་ཡང་འགུགས་པར་བྱེད་དོ།",
    "ཕྱག་རྒྱ་འདི་ཉིད་ལ་མཐེ་བོ་གཡས་༥པས་བོད་༦༧པར་བྱའོ།",
    "འབུམ་བཟླས་པས་སྔོན་དུ་བསྙེན་པ་བྱས་པར་འགྱུར་རོ།",
    "ཡར་ངོའི་ཚེས་བཅུ་ལ་ཀླུའི་ཁང་པར་ཆུ་འབོགས་ཏེ།",
    "འོངས་པ་ལ་ཆགས་པ་བྱས་ན་ཆུང་མར་འགྱུར་རོ།",
    "དེས་ཀྱང་མ་ལུས་པར་ཟད་པར་བྱའོ།",
    "འོངས་པ་ལ་སྤྱི་བོར་མེ་ཏོག་བྱིན་ཏེ་ལེགས་པར་འོངས་སོ་ཞེས་བརྗོད་ཅིང་ཆུང་མ་གྱིས་ཤིག་ཅེས་བསྒོ་༡་ན་དོང་ཙེ་༡༡བརྒྱད་དང་ལྷའི་ཟས་བཟང་པོ་སྟེར་བར་བྱེད་དོ།",
    "གྲུབ་པའི་རྫས་སྟེར་ཞིང་བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་ལ་རྒྱལ་སྲིད་སྟེར་བར་བྱེད་དོ།",
    "ཁྲོ་བོ་འདི་དང་བཅས་ནས་གསུངས་པ།",
    "ནམ་ཕྱེད་ན་ངེས་པར་འོང་སྟེ།",
    "དེ་ལ་འཇིགས་པར་མ་བྱས་ན།",
    "ཐོ་རངས་ངེས་པར་འོང་ངོ།",
    "ཉི་མ་གསུམ་པ་ལ་ཆགས་པ་སྤྱད་ན་ངེས་པར་འགྲུབ་ཅིང་།་",
    "འཁྱུད་༡༡ཅིང་འོ་བྱས་ཏེ་མི་སྨྲ་བས་ཆགས་པ་བྱས་ན་ཆུང་མར་འགྱུར་ཏེ།",
    "མངག་གཞུག་མ་ལུས་པ་སྒྲུབ་པར་བྱེད་པ།་",
    "མ་རུངས་པ་རྣམས་དང་ལྷ་རྣམས་ལ་བསྟན་པར་བྱའོ།",
    "ཁྲོ་བོའི་བདག་པོ་ཆེན་པོས་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "རྟ་བབས་བཞི་ཡིས་རྣམ་པར་བརྒྱན་༥།",
    "རྔ་ཡབ་ཐོགས་པར་སྨིན་དྲུག་བྲི།",
    "རྔ་ཡབ་ཐོགས་པར་ཁྱབ་འཇུག་བྲི།",
    "དེ་བཞིན་ཁྱུ་མཆོག་ལ་ཞོན་པར།",
