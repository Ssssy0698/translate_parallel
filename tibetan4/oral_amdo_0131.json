    "ས་བོན་ལས་ལྷ་མོར་གྱུར་ཏེ་སྤྲོ་བ་སྟེ་གཉིས་ཀྱིས་ཕྱེ་བས་བཅུ་གཉིས་དང་།",
    "ལྷ་མོ་རྣམས་ཀྱི་ཕྱག་མཚན་ནི།",
    "གཡུང་མོའི་གཡས་ན་མི་ཕྱེད་པའི་ཡེ་ཤེས་རབ་ཏུ་གསལ་བའི་རྡོ་རྗེ་ཉིད་དེ།",
    "འཇིག་རྟེན་གསུམ་རོ་གཅིག་ཏུ་གསལ་བའི་ཕྱིར་ཞབས་ཀྱི་སེན་མོ་གཅིག་གདན་ལ་བརྟེན་ཏེ་གནས་པའོ།",
    "དཀར་མོ་ལ་སོགས་པའི་ལྷ་མོ་ཐམས་ཅད་བདེན་གཉིས་དག་པས་ཕྱག་དང་ཞབས་གཉིས་སུ་བརྗོད།",
    "གདུག་པ་འདུལ་ཞིང་ཉོན་མོངས་སྲེག་པའི་དོན་དུ་དབུ་སྐྲ་དམར་སེར་ནི་གྱེན་དུ་བརྗེས་པ་སྟེ།",
    "དེ་རྣམས་ནི་གོ་རཱི་ལ་སོགས་པའི་ལྷ་མོ་བརྒྱད་ཀྱི་གདན་དུ་བརྟག་གོ།",
    "ལྷ་མོ་བདེ་བ་ཆེན་པོའི་ཡེ་ཤེས་སྦྱིན་པར་བྱེད་པ་ཁྱོད་ཉོན་ཅིག་པའོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་བདེ་བ་ཆེན་པོའི་རོས་གར་ཏེ་རོལ་པར་མཛད་པ་དེ་ནི་ལྷ་མོ་ཞེས་བོས་ནས།",
    "སྔོན་བྱུང་གི་རྣམ་འཕྲུལ་ནི།",
    "རྗེས་འཇུག་གིས་ཇི་ལྟར་བསྒྲུབ་པ་ནི།",
    "ཡིད་འཕྲོག་པས་བཟང་བ་ཡིས་ཐབས་ཤེས་དབྱེར་མེད་ཀྱི་ཀྱེའི་རྡོ་རྗེའི་རྣལ་འབྱོར་སྔར་བསྟན་པ་དང་ལྡན་པས་སྤྱན་མ་ལ་སོགས་པའི་རྡོ་རྗེ་བཙུན་མོ་ཐམས་ཅད་དགུག་པར་བྱ་ཞིང་།",
    "སྔོན་དུ་བཟླས་པ་འབུམ་གྱིས་རྣལ་འབྱོར་པ་བདག་ཉིད་ཀྱེའི་རྡོ་རྗེའི་རྣལ་འབྱོར་དང་ལྡན་པ་ཉིད་ཀྱིས་དོགས་པ་དང་ཐེ་ཚོམ་མེད་པར་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་སེམས་ཀྱིས་ནི་འཁོར་ལོ་གོང་དུ་དམ་ཚིག་རྡོ་རྗེའི་བཟླས་པ་གང་རུང་གི་ཕྲེང་སྔགས་འདི་བཟླས་པ་ཡིས་གདུག་པ་སྡིགས་པ་དང་ཞི་སོགས་ལས་རྣམས་ཐམས་ཅད་བྱེད་དོ།",
    "དང་པོ་ནི་ཡུམ་གྱི་ཞལ་ནས་རང་གི་ཞལ་དང་།",
    "དེ་རྣམས་ཀྱི་དང་པོ་ཨོ་སྦྱིན་ཞིང་སྟེང་དུ་ཟླ་བ་ཕྱེད་པ་དང་ཐིག་ལེས་རྣམ་པར་བརྒྱན་པ་ནི་ཨོ་མོ།",
    "ཉོན་མོངས་པ་ལྔས་སེམས་ཁོང་ནས་འཁྲུགས་ཤིང་གདུང་བའོ།",
    "ཉོན་མོངས་པའི་ཟས་ཟ་བའི་བདག་ཏུ་འཛིན་པའོ།",
    "གང་གི་ཆེད་དུ་ན་པིངྒཱནྟས་ཉི་མ་སྟེ་ཁྲག།",
    "ཉི་ཤུ་རྩ་བཞིའི་སྤྱན་ཅན་ནི་ཡེ་ཤེས་ལྔ་དང་སྐུ་གསུམ་གྱི་རང་བཞིན་གྱི་ལྷ་མོ་ཌཱ་ཀི་བརྒྱད་རྣམས་སྐུ་གསུང་ཐུགས་ཀྱི་ཡེ་ཤེས་གསུམ་གསུམ་གྱི་བདག་ཉིད་ཀྱིས་ཕྱེ་བས་ཉི་ཤུ་རྩ་བཞི་སྟེ།",
    "དེ་དག་གིས་ཚེམས་བཞི་བཅུར་གྱུར་པ་ཅན་ཞེས་པའོ།",
    "ཉོན་མོངས་མཐའ་དག་བསྲེགས་པ་དང་།",
    "ཉོན་མོངས་པ་ཞི་བར་བྱེད་པས་ཀླུ་བརྒྱད་ཆིངས་ཤིག་པའོ།",
    "དེ་ཇི་ལྟ་བར་བསམ་གཏན་གྱི་དཀྱིལ་འཁོར་ཡང་བྲི་བར་བྱའི་རི་མོ་མཁན་ལ་སོགས་པས་ནི་མིན་ནོ་ཞེས་རྡོ་རྗེ་པདྨ་མཉམ་པར་སྦྱར་ནས་དགྱེས་པའི་ཐུགས་ནི་མཉམ་པར་བཞག་སྟེ་བསྟན་ཏོ།",
    "སྟོབས་ལྔ་དག་པའི་རེ་ཁཱ་ལྔ་དང་ཡང་དག་པར་ལྡན་པ།",
    "དེ་ནས་ལྷ་མོ་བརྒྱད་ཀྱི་བུམ་པ་བརྒྱད་པོ་དང་།",
    "རེ་ལཱ་ཡེ་ཤེས་ལྔ།",
    "ཐལ་བ་ཐ་མ་དུར་ཁྲོད་ཀྱི་ནི་སོ་ཕག་གམ།",
    "ལྷ་མོ་བརྒྱད་ཀྱི་ཁ་དོག་གི་དབྱེ་བ་ཡིས་ཕྱག་མཚན་བརྒྱད་ཀྱང་ལྷ་མོའི་ཁ་དོག་བཞིན་བྲི་བར་རབ་ཏུ་གྲགས་སོ།",
    "ཐོད་པ་དེའི་དབུས་སུ་རྡོ་རྗེ་འཆང་གི་ཡེ་ཤེས།",
    "ཁ་རྒྱན་ཤིང་གི་ཡལ་ག་རྩེ་མོ་མ་ཉམས་པ་དང་།",
    "ལྷ་མོ་རྣམས་ཀྱི་བུམ་པ་སོ་སོའི་གནས་སུ་བཞག་སྟེ།",
    "ཤེས་རབ་ཡེ་ཤེས་ཀྱི་རྟེན་དུ་གྱུར་ན་སྲིང་མོ།",
    "དེས་ན་ཕའི་སྲིང་མོ་ནི་མ་ཉིད་ཡིན་པས་འདི་མི་དགོས་སོ་ཞེས་སོ།",
    "དཀྱིལ་འཁོར་སྒྲུབ་པའི་སྐབས་སུ་བདག་གི་ལྕེ་ལ་བདུད་རྩི་མྱོང་བ་དང་།",
    "ཀཀྐོ་ལ་གཉིས་སྦྱར་ནས་དེ་ལ་རྩེད་མོ་རྩེ་བ་སྟེ་རྩེ་ཞིང་རོལ་བར་བྱའོ།",
    "རྐང་པ་གཅིག་གིས་ཡེ་ཤེས་སུ་ཞེན་པ་གཞིག་པ་དང་།",
    "དུས་མཚན་མོ།",
    "ཚིག་གི་བཞི་པ་ནི།",
    "ཁ་སྦྱོར་ལྟར་ན་དགའ་བྲལ་གྱི་དགའ་བ་དེ་གང་གི་དང་པོ་ཡིན་པའི་མཆོག་ཕུལ་དུ་བྱུང་བ་ཁྱད་དགའི་མཐར་བྱུང་བ་ཅན་དགོད་པ་ལ་སོགས་པའི་རྒྱུད་ཐམས་ཅད་དུ་སྦས་ནས་གསལ་པོར་མ་བསྟན་པ་དེ་རྒྱུད་ཐམས་ཅད་ཀྱི་མཐའི་མཐའ་སྟེ་མཐར་ཐུག་པ་འདིར་ནི་གསལ་བར་ཕྱེ་ནས་གསུངས་གོང་མས་བཀག་པའོ།",
    "ཞེས་པ་ལྟར་ན་མཆོག་གི་མཐའ་ནི་ལྷན་སྐྱེས་ཏེ།",
    "ཐིག་ལེ་ཉམས་པས་དགའ་བ་དང་བྲལ་བའི་དང་པོ་དགའ་བ་ལས་མཆོག་གི་དགའ་བའི་མཐར་བྱུང་བར་དགའ་བྲལ་གྱི་དགའ་བས་གསལ་བར་བྱས་པ་ཅན་རྒྱུད་ཐམས་ཅད་དུ་སྦས་པ་རྒྱུད་ཐམས་ཅད་ཀྱི་མཐར་ཐུག་ཀྱེའི་རྡོ་རྗེས་གསལ་བར་བྱས་པ་དེ་ཉིད་དེ།",
    "ཉོན་མོངས་ཀྱི་བག་ཆགས་སྤངས་པའི་ཕྱིར་རོ།",
