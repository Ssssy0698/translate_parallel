    "ཆགས་པ་མེད་པ་དང་གྲོལ་ཞིང་བཅིངས་པ་མྱེད་པའི་སེམས་སུ་ཀུན་ཏུ་བཟང་པོའི་ངག་གི་ལས་ཕུན་སུམ་ཚོགས་པར་གྱུར་ཅིག།",
    "ཕྱོགས་ཐམས་ཅད་དུ་སོང་ཞིང་ཆགས་པ་མེད་པ་དང་གྲོལ་ཞིང་བཅིངས་པ་མྱེད་པའི་སེམས་སུ་ཀུན་ཏུ་བཟང་པོའི་དབྱངས་ཆགས་པ་མེད་པའི་གཟུངས་ཐོབ་པར་བྱ་བ་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "དམྱིགས་པ་རེ་རེ་ཞིང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཐམས་ཅད་ལ་ཞུགས་ཀྱང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་བརྗོད་དུ་མྱེད་པ་རེ་རེར་ལུས་ཀུན་ཏུ་དགྱེ་བའི་བྱིན་གྱི་རླབས་ཤིན་ཏུ་བསྟན་པས་ཞིང་གི་རྒྱུད་ལ་རབ་ཏུ་ཞུགས་པར་གྱུར་ཅིག།",
    "ཆགས་པ་མྱེད་པ་དང་གྲོལ་ཞིང་བཅིངས་པ་མྱེད་པའི་སེམས་སུ་སྐྲ་ཡི་སྦུབས་རེ་རེ་ཞིང་བརྗོད་དུ་མྱེད་པའི་ཡང་བརྗོད་དུ་མྱེད་པའི་ཞིང་རྣམས་ཡང་དག་པར་འཛུད་པ་རབ་ཏུ་ཤེས་པར་གྱུར་ཅིག།",
    "མོས་པར་འདུ་ཤེས་པའི་རྣམ་པ་དང་།",
    "ཉོན་མོངས་པར་འདུ་ཤེས་པའི་རྣམ་པ་དང་།",
    "གྲོལ་ཞིང་བཅིངས་པ་མེད་པའི་སེམས་སུ་སྐྱེ་མཆེད་རེ་རེ་ཞིང་།",
    "ཡོངས་སུ་བསྔོ་བའི་རྗེས་སུ་སོང་བའི་སེམས་ཀྱིས་གཟུགས་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དང་།",
    "ད་ལྟར་བྱུང་བའི་དུས་གསུམ་དུ་གཤེགས་པའི་དེ་བཞིན་གཤེགས་པ་གང་ཇི་སྙེད་པའི་དཀྱིལ་འཁོར་གྱི་ཁྱུ་མཆོག་གི་མཐུ་དབྱུང་བའི་ཡེ་ཤེས་ཤིན་ཏུ་ཕྲ་བ་གང་ཇི་སྙེད་པ་དེ་དག་ཐམས་ཅད་སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ཞིང་རྣམ་པར་འཕེལ་བའི་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་དང་།",
    "ཡེ་ཤེས་ཀྱིས་ཚིག་གི་ལམ་ཐམས་ཅད་ལས་གྱེན་དུ་འཕགས་པ་དང་།",
    "འགྲོ་བ་ཐམས་ཅད་རབ་ཏུ་དགའ་བའི་གནས་སུ་གྱུར་པའི་ལུས་བརྗོད་དུ་མྱེད་པའི་བྱིན་གྱི་རླབས་ཀྱི་ཁྱུ་མཆོག་གི་མཐུ་ཕྱུང་བ་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཀུན་ནས་ཉོན་མོངས་པ་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དང་།",
    "ཁྱུ་མཆོག་གི་མཐུ་ཕྱུང་བ་ཡང་དག་པར་བསྟན་པ་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་མ་ལུས་པར་དབྱངས་གཅིག་གིས་དབྱངས་ཐམས་ཅད་དུ་རྣམ་པར་བསྟན་ཅིང་རྒྱས་པར་དགང་བ་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དང་།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་ནམ་མཁའ་ལྟར་གོས་པ་མྱེད་པའི་ཚིག་གི་ལམ་རྣམ་པར་བརྗོད་པའི་སྤྱོད་པ་དང་ལྡན་པ་རྣམ་པར་བཀོད་པའི་དོན་གྱི་རང་བཞིན་ཤིན་ཏུ་རྟོགས་པ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རེ་རེ་ནས་ཕྱི་མའི་མཐའི་མུར་མྱི་གཡོ་བར་སྤྱོད་པ་རྒྱུན་མི་གཅོད་པའི་སེམས་དང་ལྡན་པ།",
    "བསྟན་པ་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དེ་དག་ཐམས་ཅད་ཆགས་པ་མྱེད་པར་ཤེས་པའི་སེམས་སྤྱོད་པ་གཅིག་གིས་ཁྱུ་མཆོག་གི་མཐུ་ཕྱུང་བས་ཡང་དག་པར་བསྐྱེད་པ་དང་།",
    "བདག་གིས་བྱས་པ་འམ་གཞན་གྱིས་བྱས་པ་ཡི།",
    "དེ་ལ་ཤིན་ཏུ་མོས་པ་རབ་བསྐྱེད་ཅིང་།",
    "བརྟན་པའི་མོས་དང་བསམ་ལས་བྱུང་བ་དག།",
    "རྒྱ་ཆེ་ཡངས་དང་ཕྲ་མོ་ཟབ་མོའི་རྣམས།",
    "དེ་དག་བདག་གི་ཡོངས་བསྩགས་ཤེས་པར་བྱ།",
    "གང་ཡང་འཇིག་རྟེན་ཞིང་གི་སྒོ་མངའ་བ།",
    "ཟབ་མོ་སྣ་ཚོགས་ཇི་སྙེད་བསྡུ་བྱས་ཤིང་།",
    "བདག་གིས་ལས་གཙང་ཡོངས་སུ་གང་བསྩགས་པས།",
    "དཔེ་ཟླ་མེད་པས་རྣམ་པར་གཟིགས་པ་དག།",
    "སྐྱེ་དགུ་འདི་དག་འདོད་བྱིངས་གཟིགས་གྱུར་ཅིང་།",
    "ངན་སོང་ཐམས་ཅད་ཞི་བར་གྱུར་པ་དང་།",
    "གང་ཡང་བཙུན་མོའི་འཁོར་གྱི་ཁྲོད་བཞུགས་ཤིང་།",
    "དེ་དག་དཔུང་གིས་སྟོང་གསུམ་ཁྱབ་གྱུར་ཅིང་།",
    "མཐའ་ཡས་ཕྱོགས་རྣམས་གང་གིས་ཁྱབ་གྱུར་པ།",
    "ཡེ་ཤེས་མཁྱེན་པ་རྣམས་ཀྱི་ཚུལ་གཅིག་གིས།",
    "གང་ཡང་བཙུན་མོའི་འཁོར་གྱིས་བསྐོར་བ་དང་།",
    "དེ་དག་སྐད་ཅིག་གཅིག་གིས་རྟོགས་གྱུར་ཀྱང་།",
    "གང་ཡང་རྒྱལ་བའི་སྤྱོད་ཡུལ་ཕྲ་མོ་རྣམས།",
    "དེ་དག་སྤྱོད་པ་མཆོག་གིས་ཤེས་གྱུར་ཏེ།",
    "ཀུན་ནས་ཉོན་མོངས་དེ་བཞིན་རྣམ་དག་རྣམས།",
    "གང་གིས་ཡོངས་སུ་བསྔོ་བ་འདི་ཤེས་པ།",
    "ཚངས་པར་སྤྱོད་པ་ཉོན་མོངས་པ་མེད་པ་དང་།",
    "ཡིད་ཀྱི་ལས་ཡོངས་སུ་དག་ཅིང་ཉོན་མོངས་པ་ཐམས་ཅད་བསྩལ་བ་ཡིན།",
    "མོས་པས་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་རབ་ཏུ་བཞག་པར་རྨོངས་པ་མེད་པ་དང་།",
    "རེག་བྱའི་ཕྱིར་ཡོངས་སུ་མི་བསྔོའོ།",
    "ཀུན་གཞི་ལ་མོས་པས་ཡོངས་སུ་མི་བསྔོའོ།",
    "ཉོན་མོངས་པ་མེད་པ་དང་མཉམ་པའི་སེམས་ཀྱིས་ཡོངས་སུ་བསྔོའོ།",
    "འགྲོ་བ་ཐམས་ཅད་ཀྱི་ཉོན་མོངས་པ་རྣམ་པར་གཏོར་བ་དང་།",
    "འདོད་ཆགས་མེད་པའི་ཚིག་གི་དབྱངས་དང་།",
    "ཁྱུ་མཆོག་གི་མཐུ་ལ་འཇུག་པ་དང་།",
    "དེ་བཞིན་དུ་མེ་ཏོག་སྣ་ཚོགས་ཐམས་ཅད་ཀྱི་མེ་ཏོག་གི་རྒྱན་བསམ་གྱིས་མི་ཁྱབ་པ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག།",
    "དམྱིགས་པ་རེ་རེ་ཞིང་ལན་བརྒྱར་བཟླས་པར་བྱའོ།",
    "ཀུན་ཏུ་ཆེམ་ཆེམ་མོ།",
    "ལྷ་རྫས་ཀྱི་རོལ་མོ་བརྡུང་བ་དང་དཀྲོལ་བའི་སྒྲ།",
    "དེ་བཞིན་གཤེགས་པའི་མཚན་རྡོ་རྗེའི་དཔལ་ཞེས་བྱ་བ་བཞུགས་པ་དག་གི་དྲུང་ནས་འདིར་ཕྱིན་ཏེ།",
    "རང་བྱུང་ཐམས་ཅད་གང་གིས་བསྐྱེད་གྱུར་པའི།",
    "ཞིང་གི་རྒྱན་མང་ཤིན་ཏུ་རྒྱ་ཆེ་ཞིང་།",
    "གང་གིས་འཇིག་རྟེན་མ་ལུས་རྒྱས་གང་བ།",
    "སེམས་ཀྱི་སྐད་ཅིག་གཅིག་གིས་རང་བྱུང་རྣམས།",
    "ཀུན་ཀྱང་ཀུན་ནས་བཟང་པོར་རེད་གྱུར་ཅིག།",
    "སྦྱིན་པས་ཡོངས་བསྔོ་ཇི་བཞིན་རེད་གྱུར་ཅིག།",
    "ཀུན་ཀྱང་ཀུན་ཏུ་བཟང་པོར་རེད་གྱུར་ཅིག།",
