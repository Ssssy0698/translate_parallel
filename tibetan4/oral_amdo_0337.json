    "ལྷ་གང་བསྒྲུབ་པར་འདོད་པའི་ལྷ་དེའི་མདུན་དུ་བདག་གི་ཕྱག་རྒྱ་དང་།",
    "མཱ་མ་ཁྲིའི་གཟུགས་དྲི་ཆབ་ཀྱི་རི་མོར་བྲིས་ཏེ་གཞག་གོ།",
    "རྒྱལ་བ་ལ་ནི་མོན་སྲན་གྲེའུ་དང་པེན་ཙེ་༦སྦྱིན་པར་བྱའོ།",
    "གཡུང་དྲུང་རིས་ལ་ནི་མོན་སྲན་གྲེའུའི་ཆན་༦དང་འབྲས་དྲུས་བརྡུངས་པ་༧ལ་སོགས་༨པ་སྦྱིན་ནོ།",
    "མཆེ་བ་ལ་ནི་མོན་སྲན་གྲེའུ་དང་ཟན་དྲོན་སྦྱིན་ནོ།",
    "ཞགས་པ་ལ་ནི་མོན་སྲན་གྲེའུའི་༡་ཆན་དང་།",
    "དེ་ནས་ཕྱག་རྒྱ་བསྒྲུབ་ན་ཟླ་བ་གཅིག་གི་བར་དུ་སློང་༧མོའི་ཟས་བཟའ་ཞིང་མཱ་མ་ཏཱི་ལ་ཡང་བསྙེན་བཀུར་༡་བྱས་ན་ཕྱག་རྒྱ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "ཆོ་ག་རྒྱས་པའི་ལྷ་ཐམས་ཅད་ཀྱང་རང་རང་གི་ཕྱག་རྒྱའི་གཟུགས་བཞག་ནས་བསྒྲུབ་པར་བྱའོ།",
    "ན་མོ་རཏྣ་༡་ཏྲ་ཡཱ་ཡ།",
    "ན་མ་༡༡ཏཱ་ལ་ཏྲི་ཏནྟ་༡༢རུ་ཏི་ནི་ཤཾ་༡་ཀ་རེ་ཤི་ཀ་རེ།",
    "རྩེད་མོ་ཅན་དང་།",
    "དེ་ནས་ཟླ་བ་ཕྱེད་ཀྱི་བར་དུ་སློང་ས་མོའི་ཟས་བཟའ་ཞིང་བྱེ་ཁང་པ་སྟོང་པར་དུས་གསུམ་དུ་རིག་སྔགས་ཀྱི་རྒྱལ་པོ་སྟོང་དང་ལྡན་པར་མིང་ཡང་དག་པར་བརྗོད་པར་བྱའོ།",
    "ཟླ་བ་གཅིག་གི་བར་དུ་སློང་༥མོའི་ཟས་ཟ་ཞིང་།",
    "ཕྱག་རྒྱའི་རྒྱལ་མོ་འདི་དག་ལ་བསྙེན་བཀུར་༨བྱས་ཏེ།",
    "དབེན་པའི་ཕྱོགས་སུ་དཀྱིལ་འཁོར་སྐྱོང་མནུལ་གྱིས་བྱུགས་ནས་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་རྫས་དེ་དག་གིས་མཱ་མ་ཁྲིའི་གཟུགས་བྱས་ཏེ་གཞག་གོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་གིས་གློ་ཕྱོགས་སུ་བུམ་པ་བཞག་ལ་དེའི་ནང་དུ་ལུས་ཀྱི་ཡན་ལག་གི་གཟུགས་གཞུག་པར་བྱའོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་༡་གི་རྒྱལ་པོ་བཟླས་བརྗོད་བྱེད་བཞིན་དུ་ཆུ་སྐྱོར་བ་རེ་རེ་ནས་ལན་བརྒྱད་༡་སྟོང་ཚང་བའི་བར་དུ་ཕྱག་རྒྱ་མཆོག་དེ་དག་ལ་བསྣུན་༡༩པར་བྱ།",
    "མཱ་མ་ཁྲིའི་ལས་ཙོལ་སོགས་པའི་ཕྱག་རྒྱའི་ཚོགས་རྣམས་ཆོ་ག་འདི་བཞིན་དུ་ཏ་ལའི་ལོ་མ་ལ་བྲིས་ཏེ་མཆོད་ཅིང་རི་མོར་བྱེད་པ་གང་ཡིན་པ་དེ་ལ་ངའི་༡༡བཀས་ཁྱོད་ཀྱིས་༡་དངོས་གྲུབ་སྦྱིན་པར་༡་གྱིས་ཤིག།",
    "གང་ཞག་བདུན་གྱི་བར་དུ་མཱ་མ་ཏཱི་དང་བཅས་པའི་ཕྱག་རྒྱའི་ཚོགས་ཀྱི་༡་ལས་ནང་པར་ཞིང་ཀློག་པར་བྱེད་པ་དེ་ལ་ནི་དེ་དག་གིས་དགའ་༡་བའི་སེམས་ཀྱིས་མྱུར་དུ་དངོས་གྲུབ་སྩོལ་༡༩བར་འགྱུར་རོ།",
    "ལག་ན་རྡོ་རྗེའི་བུ་ཡིན་ཏེ་དེ་དག་གིས་ནི་མཱ་མ་ཁྲི་དང་།",
    "མིང་བརྗོད་པ་དང་ལྷག་པར་ཡང་བསྒྲུབ་པར་འདོད་པ་གང་ཡིན་པ་ལ་རིག་སྔགས་ཀྱི་རྒྱལ་པོ་ཚོགས་དང་བཅས་པ་དེ་དག་གིས་དངོས་གྲུབ་སྦྱིན་པར་འགྱུར་རོ།",
    "གང་གི་ཉིན་པར་ཡང་རུང་སྟེ།",
    "དེ་ནས་ཕྱེ་མ་༡༦རེད་ལག་ན་པོག་ཕོར་ཐོགས་ལ་གཙོ་བོ་ལག་ན་རྡོ་རྗེ་དང་བཅོམ་ལྡན་འདས་མ་སྤྱན་དྲང་བར་བྱའོ།",
    "དེ་ནས་ནུབ་མོ་རྨི་ལམ་དུ་ལྷ་མོ་མཐོང་བར་འགྱུར་རོ།",
    "བདག་གི་རྐང་པ་ལ་ཡང་དབུལ་བར་བྱའོ།",
    "སྦྱར་ཐུག་གི་ཟས་སྦྱིན་པར་བྱའོ།",
    "བདག་གིས་ཀྱང་དེ་བཞིན་དུ་ཞོ་དང་།",
    "མགོ་མཉམ་འདུ་ཟས་བཟའ་ཞིང་ཟས་སློང་བ་ལ་གང་གིས་ཀྱང་ཟས་སྦྱིན་པར་མི་བྱའོ།་།",
    "བདག་གི་ནི་བཅོམ་ལྡན་འདས་མ་ནབཏབ་སྟེ་བཟའ་བར་བྱའོ།",
    "གང་གིས་མཱ་མ་ཁྲིའི་སྐུ་གཟུགས་བྱས་ལ་ཆོ་ག་སྔ་མ་བཞིན་དུ་བཞག་ནས་ཀུ་ཤའི་སྟན་ལ་འདུག་སྟེ།",
    "ཉི་མ་བཟང་བ་ལ་པདྨ་སྟོང་གིས་བསྣུན་ན་མཱ་མ་ཁྲིའི་ཁོང་ནས་འོད་ཟེར་གཅིག་འབྱུང་སྟེ།",
    "གང་གི་ཚེ་རིག་སྔགས་འཆང་གིས་༥རིག་སྔགས་འཆང་ལ་ཕྱག་རྒྱ་བསྟན་པ་དེའི་ཚེ་བཅོམ་ལྡན་འདས་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་འགྲོན་བུ་བརྒྱད་བརྒྱས་དརྡོ་རྗེ་བྱས་ལ་རྡོ་རྗེ་དེའི་མདུན་དུ་ཕྱག་རྒྱ་བསྟན་པར་བྱའོ།",
    "ཕྱག་རྒྱ་མཐོང་བ་གང་ཡིན་པ་དེ་དག་ལ་ནི་རིག་པ་མཆོག་གི་ཆོ་ག་རྒྱས་པ་གསང་བ་དང་བཅས།",
    "འི་ལག་ནས་རིག་པ་མཆོག་གི་ཆོ་ག་རྒྱས་པ་མནོད་པར་བྱ་སྟེ།",
    "སྐུ་གདུང་གི་གནས་སུ་ཕྱག་རྒྱའི་ཚོགས་བཀོད་ནས་ཕྱག་རྒྱ་ལ་ལྟ་༡བ་གང་ཡིན་པ་དེ་དག་ནི་ཕྱིར་མི་ལྡོག་པ་ཡིན་པར་བལྟ་༢བར་བྱ་སྟེ་དེ་ནི་ལྷ་ཐམས་ཅད་ཀྱིས་༥ཕྱག་བྱ་བ་ཅཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཕྱག་རྒྱ་ལྟ་སྒྲུབར་བྱེད་ན་ཕྱག་རྒྱའི་དབྱིབས་ལག་པའི་ཚུལ་གྱིས་བསྟན་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ལག་ན་རྡོ་རྗེ་ཁྱོད་ཀྱང་མཐོང་བར་འགྱུར་བ་དང་།",
    "དགེ་སྦྱོང་མ་ཡིན་པ་ཡང་དགེ་སྦྱོང་གི་འབྲས་བུ་དང་ལྡན་པར་འགྱུར་བ་དང་།",
    "བཅོམ་ལྡན་འདས་བདག་གི་མིང་བརྒྱད་པ་གསང་བ་༡རིགསང་སྔགས་ཀྱི་དཀྱིལ་འཁོར་དང་༡་ཚོབཅས་པ་རྣམས་གང་ལགས།",
    "འདི་ལྟ་སྟེ་ཁྱོད་ནི་གླང་པོའི་ཚན་བ་ཅན་ཡིན།",
    "ཁྱོད་ནི་རྒྱན་བཟང་པོ་༧དང་ལྡན་པ་ཡིན།",
    "ཁྱོད་ནི་རྣམ་པར་གནོན་པ་༡༨ཡིན།",
    "ཁྱོད་ནི་བདེན་པའི་སྤྲིན་ཡིན།",
    "ཁྱོད་ནི་གཟུགས་སྡུག་པའི་རྒྱན་དང་ལྡན་པ་ཡིན།",
    "ཁྱོད་ནི་འབར་བའི་མེ་ལྕེ་དང་ལྡན་པ་ཡིན།",
    "ཁྱོད་ནི་གཟུགས་མཛེས་པ་ཡིན།",
    "ན་མོ་བུདྡྷཱ་ཡས།",
    "ན་མོ་བཛྲ་པཱ་ཎི་ཡི་༧།",
    "དེ་དེ་ལེགས་༡་ཏེ་བཅོམ་ལྡན་འདས་རིག་པ་མཆོག་གི་བསྒྲུབ་པས་བཟླས་བརྗོད་བགྱིས་པ་དང་།",
    "དེའི་འོག་ཏུ་རིག་པ་མཆོག་གི་དཀྱིལ་འཁོར་རྣམས་བྲི་བར་བགྱིའོ།",
    "དེའི་འོག་ཏུ་རིག་པ་མཆོག་བསྒྲུབ་པ་ན་༡་རིག་སྔགས་འཆང་གིས་ཟན་ཟ་བའི་༢་ཚེ་སློང་༢༡མོའི་ཟས་ལ་ལན་གསུམ་བཟླས་བརྗོད་བྱས་ནས་མིང་བརྒྱད་པ་ལན་ཅིག་བཏོན་དེ་༢༢ཟོས་ན་ཁ་ཟས་ངན་པ་དག་པར་འགྱུར་ལ།",
    "སྦྱར་བའི་དུག་གིས་ཀྱང་མི་ཚུགས་པར་འགྱུར་རོ།་།",
    "ལས་རྣམས་ལ་རིག་པ་མཆོག་གིས་བྱས་ན་ཐམས་ཅད་བྱེད་པར་འགྱུར་རོ།",
    "གསང་སྔགས་བརྩོན་པ་གང་ཡིན་པ་དེ་དག་གི་ཆོ་ག་ཉམས་པ་ལ་ཡང་གདོན་རྣམས་དང་།",
    "བདེ་བླག་ཏུ་འགྲུབ་པར་འགྱུར་བའི་ཐབས་གང་གིས་ལོག་འདྲེན་རྣམས་བསལ་ནས་བདེ་བླག་ཏུ་གསང་སྔགས་འགྲུབ་པར་འགྱུར་བ་དང་།",
    "གཞོན་ནུ་གང་ཁྱོད་སྒྲུབ་༥པ་པོ་རྣམས་ལ་ཕན་པའི་ཕྱིར་བརྩོན་པ་དང་།",
    "ལྷ་རྣམས་ཀུན་ལ་བདག་གིས་ནི།",
    "ཕྱག་རྒྱ་དག་གིས་ལྷ་རྣམས་ཀུན།",
    "དེ་དག་གི་ནི་ཚུལ་དང་རྟགས།",
    "མདུན་དུ་ལག་ངར་ལྷན་ཅིག་ཏུ་སྦྱར་ལ་སོར་མོ་ཕན་ཚུན་བསྣོལ་ཏེ།",
    "ཁུ་ཚུར་བཅངས་ཏེ་གུང་མོ་བསྒྲེང་༧ལ་གཤིབས་༨ལ།",
    "དེའི་ཕྱི་རོལ་གྱི་ཙ་གློ་གཉིས་ནས་མཛུབ་མོ་གཉིས་རྡོ་རྗེའི་དབྱིབས་སུ་བྱས་ནས་༡་མཐེ་བོང་གཉིས་རྡོ་རྗེའི་དབྱིབས་ལྟར་རབ་ཏུ་བཞག་པ་ནི་བཅོམ་ལྡན་འདས་རིག་པ་མཆོག་གི་རྩ།",
    "སྤྱན་དྲང་བ་ནི་རིག་སྔགས་ལོཀྱི་རྒྱལ་པོའི་ཕྱག་རྒྱ་ལས་གུང་མོ་གཉིས་ཀྱི་དབུས་བཀུག་ལ་གུང་མོ་གཤིབས་སཔའི་ཕྱི་རོལ་གྱི་ཚིགས་སྣདྲང་པོར་བསྟན་པར་བྱ་སྟེ།",
    "སླར་བཏང་༡༨བ་ནི་དེ་ཉིད་ལས་མཛུབ་མོ་གཉིས་ཅུང་ཟད་བརྐྱང་༡༩བར་བྱས་ཏེ་ཤུགས་༢༧ལྡན་གྱི་ཡིན་ནོ།",
    "མཛུབ་མོའི་ཐོར་ཏོ་མཉམ་དུ་གཤིབས་༢༧པ་ནི་བློ་གྲོས་རྡོ་རྗེའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་རྒྱབ་ཏུ་བསྙམས་༡ཏེ་གཞར་བ་ནི་དགའ་བྱེད་གདོང་གི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་ཀྱི་སེན་མོ་ཕན་ཚུན་སྤྲད་དེ་བཞག་པས་མཐེ་བོང་གཉིས་མནན་པ་ནི་རལ་གྲིའི།",
    "རལ་གྲིའི་ནཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་ཚིགས་རེ་རེ་བཀུག་སྟེ།",
    "དེ་ཉིད་ལས་མཐེ་བོང་ཅུང་ཟད་བཀུག་པ་ནི་ལྷ་མོ་རྩེ་གསུམ་ཀ་གདེང་གི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་མཛུབ་མོ་གཉིས་བཏང་སྟེ་ཚིགས་རེ་རེ་བཀུག་ལ།",
    "མཛུབ་མོ་གཉིས་ཕྱི་རོལ་དུ་མ་ཕྲད་པར་བཟུང་༨བ་ནི་པདྨ་འཛིན་གྱི་ཕྱག་རྒྱའོ།",
    "ཚིགས་རེ་རེ་བཀུག་སྟེ་མཐེ་བོང་གཉིས་ཀྱི་ཕྱི་རོལ་དུ་གཞར་༡༢བ་ནི་རྟ་མགྲིན་༡་གྱི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་ལས་གུང་མོ་གཤིབས་༡༥པ་གླུཡིད་ཙམ་གྱིས་བཀུག་པ་ནི་གཞན་གྱིས་མི་ཐུབ་པའི་ཕྱག་རྒྱའོ།",
    "མེ་ཏོག་གི་ཕྱག་རྒྱ་ཡང་དེ་ཉིད་ཡིན་ནོ།",
    "མཛུབ་མོ་གཉིས་ཅུང་ཟད་ཕྱེ་༥བ་ནི་ཚངས་པའི་མིག་གི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་ཅུང་།",
    "མཛུབ་མོ་༡༥གཉིས་བཀུག་ལ་གུང་མོ་གཤིབས་པའི་ཕྱི་རོལ་ཚིགས་དྲང་པོར་བསྟན་༧པ་ནི་རྡོ་རྗེ་༡༥འོད་ཟེར་ཕྲེང་ས་གི་ཕྱག་རྒྱའོ།་",
    "དེ་ཉིད་ལས་མཛུབ་མོ་དང་སྦྱར་བ་ནི་ཉི་མའི་ནམ་མཁའི་ཕྱག་རྒྱའོ།",
    "རབ་ཏུ་འགྲུབ་པར་བྱེད་པའི་མཛུབ་མོའི་ཚིགས་གཉིས་བཀུག་པ་ནི་རིག་སྔགས་འཆང་ཐམས་ཅད་འགྲུབ་པའི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་བརྐྱང་༦༧བ་ནི་སྲིན་གེཔོའི་ཕྱག་རྒྱའོ།་།",
    "རྩེ་གསུམ་ཀ་གདེང་གི་ཕྱག་རྒྱ་ལས་མཐེ་བོ་༤",
    "སྦྱར་བ་ནི་མ་མོ་ཐམས་ཅད་ཀྱི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་མཛུབ་མོ་གཉིས་གུང་མོ་གཤིབས་༥པའི་ཕྱི་རོལ་ནས་གདུ་བུ་ལྟར་དཀྲིས་པ་ནི་རྡོ་རྗེ་སྒྲོགས་ཀྱི་ཛོ་ཕྱག་རྒྱའོ།",
    "གུང་མོ་གཤིབས་པའི་གློ་སྣ་གཉིས་ནས་མཛུབ་མོ་གཉིས་རྡོ་རྗེའི་ཚུལ་དུ་བྱས།",
    "དེ་ཉིད་ལས་གུང་མོ་གཤིབས་པ་ནས་གང་ཙམ་གྱིས་ཕྱེ་བ་ནི་རྡོ་རྗེ་འཇོམས་པའི་ཕྱག་རྒྱའོ།",
    "དེ་ལས་མཛུབ་མོ་བརྐྱང་སྤུབ་ནི་རྡོ་རྗེ་འབར་བའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་ཚིགས་དབུས་༡་མ་བཀུག་ལ་གུང་མོ་གཤིབས་༡༨པའི་ཚིགས་དང་པོར་གཞག་པ་ནི་བློན་མོ་བདུན་གྱི་སྤྱིའི་ཕྱག་རྒྱའོ།",
    "རིག་སྔགས་ཀྱི་རྒྱལ་པོའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་རལ་གྲི་ཕྱག་རྒྱ་ལྟར་བྱས་ལ་སྲིན་ལག་གཉིས་ཀྱང་ཚོ་༡མཐེ་བོང་ཚོནགཉིས་ཀྱི་རྩེ་མོའི་གློ་ཕྱོགས་སུ་བསྟོད་དེ་གཞར་བ་ནི་རྡོ་རྗེ་འཇིགས་བྱེད་ཆེན་པོའི་ཕྱག་རྒྱའོ།",
    "དེ་ལ་མཛུབ་མོའི་ཚིགས་གཅིག་༤བཀུག་པ་ནི་ཁྲོ་བོ་མེའི་ཕྱག་རྒྱའོ།",
    "སོར་མོ་རྣམས་ཀྱི་བར་ཕྱེ་བ་ནི་ནམ་མཁའི་རྩ་ན་བའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་སོར་མོ་རྣམས་གཞུམ་པ་ནི་འཕགས་པ་དོན་ཡོད་པའི་ཞགས་པའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་ལག་པ་གཡོན་པའི་མཛུབ་མོ་བརྐྱང་བ་ནི་རྟ་མགྲིན་༩གྱི་ཕྱག་རྒྱའོ།",
    "མཱ་མ་ཁྲིའི་༡༡ཕྱག་རྒྱ་དེ་ཉིད་ལས་མཛུབ་མོ་གཉིས་ཀྱི་ཚིགས་གཅིག་བཀུག་པ་ནི་མཱ་མ་ཏཱི་སྤྱན་དྲང་བའི་ཕྱག་རྒྱའོ།",
    "གུང་མོ་གཤིབས་པ་ལས་རྡོ་རྗེའི་ཚུལ་དུ་བྱ་བ་ནི་ཁྲོ་བོ་རྩེ་གཅིག་ལྡན་གྱི་ཕྱག་རྒྱའོ།",
    "གཡས་པའི་མཛུབ་མོ་བཀུག་པ་ནི་རྡོ་རྗེ་དགྲ་ལྟའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་མཛུབ་མོའི་ཐོར་ཏོ་སྤྲད་པ་ནི་རྡོ་རྗེ་ཞགས་པའི་ཕྱག་རྒྱའོ།",
    "དྲུང་དུ་བཞག་པ་ནི་གཙུག་༣ནས་འབྱུང་གི་ཕྱག་རྒྱའོ།",
    "དེ་གཉིས་གུང་མོ་གཤིབས་པའི་རྒྱབ་ཏུ་གདུ་བུ་ལྟར་སྦྱར་བ་ནི་ལོག་འདྲེན་ཐམས་ཅད་བཅིང་བའི་༥༥ཕྱག་རྒྱའོ།",
    "མཱ་མ་ཁྲིའི་ཕྱག་རྒྱ་དེ་ཉིད་ལས་མཛུབ་མོ་ཁ་རིནེ་ཕྱེ་སྟེ་གུང་མོ་གཤིབས་༧པའི་ནཕྱི་རོལ་ནས་རྡོ་རྗེའི་ཚུལ་དུ་བཟུང་།",
    "དེ་བཞིན་དུ་མཛུབ་མོའི་དབུས་བཀུག་སྟེ་ཚིགས་༡་དང་པོར་བཞག་པ་ནི་ཆུ་ཪྵསྲིན་མ་ཀ་རའི་ཕྱག་རྒྱ་༡༥ཡིན་ནོ།",
    "མཱ་མ་ཁྲིའི་ཕྱག་རྒྱ་ཉིད་ལས་མཐེའུ་ཆུང་གཤིབས་པ་མཐེ་བོང་སྒྲུགཤིབས་པ་དང་གུང་མོ་གཤིབས་པ་རྣམས་བཅུམ་༡་པ་ནི་རྡོ་རྗེ་ནག་མོའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་སོར་མོ་རྣམས་བཅུམ་པ་ནི་༢༥རྡོ་རྗེ་འབྱིན་མའི་ཕྱག་རྒྱའོ།",
    "གཡས་བརྐྱང་ཚུལ་གྱིས་གནས་པར་བྱས་ལ་ལག་པ་གཡོན་པ་ནི་༢་རྡོ་རྗེ་མཚན་མ་བལྟ་གི་བའི་དམིགས་སུ་གཏད་པར་བྱ།",
    "ལག་པ་གཡས་པའི་སོར་མོ་རྣམས་བཅངས་ཏེ་ཁུ་ཚུར་ཐ་མལ་པར་བྱས་ནས་མཛུབ་མོ་བརྐྱང་བའི་གློར་༡མཐེ་བོ་ནགཞར་བ་ནི་རྒྱལ་བའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་གུང་མོ་དང་བཅས་པར་བརྐྱང་བ་ནི་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱའོ།",
    "སོར་མོ་ཐམས་ཅད་ཀྱིས་མནན་ཅཔ་ནི་ལག་ན་རྡོ་རྗེའི་ཁུ་ཚུར་གྱི་ཕྱག་རྒྱའོ།",
    "སོར་མོ་ཕན་ཚུན་ཡིད་ཙམ་ལྷག་པར་བྱས་པ་ནི་བདུད་རྩི་ཐབ་༥སྦྱོར་གྱི་ཕྱག་རྒྱའོ།",
    "གུང་མོ་དང་སྲིན་ལག་གཉིས་ཀྱི་བར་དུ་མཐེ་བོའི་ཐོར་ཏོ་ཚིགས་གཅིག་ཙམ་རི་ཕྱི་རོལ་དུ་བྱུང་བར་བྱས་པ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་ཕྱག་རྒྱའོ།",
    "ལག་༨ན་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་བརྐྱང་བ་ནི་རྡོ་རྗེ་རྩེ་གཅིག་པའི་ཕྱག་རྒྱའོ།་།",
    "སྙིམ་པ་བཀན་ཏེ་གུང་མོ་གཉིས་ལུ་གུ་རྒྱུད་ཀྱི་ཚུལ་དུ་འཁྱུད་ནས་སོར་མོ་ལྷག་མ་རྣམས་བཀུག་པ་༡་ལ་མཐེ་བོས་མནན་པ་ནི་གདོང་དམར་གྱི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་སྙིམ་པ་ཕྱེ་སྟེ་སྲིན་ལག་གཉིས་འཁྱུད་ལ་མཛུབ་མོ་གུང་མོའི་༡༡༦་མོར་གཞར་བ་ནི་འོད་ཟེར་ཕྲེང་གི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་མཐེའུ་ཆུང་དང་སྲིན་ལག་འཁྱུད་དེ་ལག་པའི་ནང་དུ་བཙུག་༡་ལ་ཕྱི་རོལ་ནས་མཛུབ་མོ་གཉིས་ཀྱི་ཐོར་ཏོའི་སྟེང་ནས་གུང་མོ་བཀུག་པའི་རྩེ་མོ་མཐེ་བོང་གཉིས་ཀྱི་རྩེ་མོ་དང་སྤྲད་པ་ནི་རྣ་ཆ་གདོང་གི་ཕྱག་རྒྱའོས།",
    "དེ་ཉིད་ལས་༡༥གུང་མོ་མཐེ་བོའི་ཐོར་ཏོ་ལ་གཞར་བ་ནི་དགའ་བྱེད་གདོང་གི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་སྙིམ་པ་ཕྱེ་༡་སྟེ་གཉིས་ཀ་ཕན་ཚུན་འཁྱུད་ནས་མཐེའུ་ཆུང་གཉིས་སྲིན་ལག་དང་གུང་མོ་མནན་ལ་མཛུབ་མོ་གཉིས་ཀྱི་ཐོར་ཏོ་སྤྲད་དེ་མཐེ་བོང་གཉིས་ཀྱིས་སྲིན་ལག་དང་གུང་མོ་མནན་པ་ནི་ཁྲོ་བོ་ཐམས་ཅད་ཀྱི་ཕྱག་རྒྱའོ།",
    "དེ་ལས་སྙིམ་དཔ་ཕྱེ་ལ་མཐེའུ་ཆུང་དང་སྲིན་ལག་དང་གུང་མོ་རྣམས་འཁྱུད་ནས་མཛུབ་མོ་གཉིས་བཀུག་སྟེ་སྤྲད་ལ་སྲིན་ལག་གཉིས་ཀྱི་དྲུང་དུ་མཐེ་བོང་༥༤",
    "དེ་ཉིད་ལས་སྲིན་ལག་བསྣོལ་བའི་རྩེ་མོར་མཐེ་བོང་༥གཉིས་བཞག་ལ།",
    "མཐེའུ་ཆུང་དང་གུང་༥༦མོ་ཐ་མལ་པར་བཀུག་པ་ནི་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་ཕྱག་རྒྱའོ།",
    "པ་ཕྱེ་སྟེ་སོར་མོ་ཐམས་ཅད་ཀྱི་ཐོར་ཏོ་བསྣོལ་མར་ཕན་ཚུན་འཁྱུད་དེ་མཐེ་བོང་དང་མཛུབ་མོའི་ཐོར་ཏོ་སྤྲད་ལ་མཐེའུ་ཆུང་རང་རང་མཐེ་བོའི་དྲུང་དུ་གཞར་༨བ་ནི་རྡོ་རྗེ་ལུ་གུ་རྒྱུད་ཀྱི་ཕྱག་རྒྱའོ།",
    "དེ་གཉིས་ཀྱི་བློའི་༡་ཚིགས་དང་པོར་གུང་མོ་གཉིས་བཞག་ལ་མཛུབ་མོ་གཉིས་སོ་སོ་ནས་བཀུག་སྟེ།་",
    "མཐེ་བོང་སྔགཉིས་གཅིག་ཏུ་སྦྱར་ཏེ་ཀླུ་མགོ་༡་གདེངས་ཀ་ལྟར་བྱས་པ་ནི་ནམ་མཁའ་ལྡིང་གི་ཕྱག་རྒྱའོ།",
    "གུང་མོ་དང་མཛུབ་མོ་སྔོན་དུ་སྦྱར་བ་ནི་ལྷ་མ་ཡི་ན་ཐམས་ཅད་ཀྱི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་དེ་ཉིད་ལས་མཐེ་བོ་༡༩གཉིས་ནང་དུ་བཅུག་པ་དེའི་ངོས་སུ་གུང་མོ་གཉིས་ཀྱི་ཚིགས་གཅིག་༢༡བཀུག་སྟེ་བཞག་ནས་མཛུབ་མོ་གཉིས་ཕྱི་རོལ་དུ་རྡོ་རྗེ་ལྟར་བཟུང་བ་ནི་རྡོ་རྗེ་ཡངས་པ་ཆེན་པོའི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་ལས་མཛུབ་ཝ་མོ་དང་གུང་མོ་བཀུག་ལ་དེའི་ནང་དུ་མཐེ་བོང་གཞུག་༡པ་ནི་དེ་ཉིད་ཀྱི་སྤྱན་དྲང་བའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་བརྐྱང་བ་ནི་སླར་བཏང་༥༥",
    "རྩ་བའི་ཕྱག་རྒྱ་ལས་གུང་མོ་ཅུང་ཟད་ཙམ་ཕྱེ་༥ལ་མཛུབ་མོའི་ཚིགས་དང་པོའི་ངོས་ལ་བཞག་པ་འདི་ས་ཡང་ཀླུ་མགོ་ཅན་གྱི་ཕྱག་རྒྱ་ཡིན་ནོ།",
    "རྩ་བའི་༥ཕྱག་རྒྱ་ལས་མཛུབ་མོའི་དབུས་བཀུག་ལ་གུང་མོ་གཉིས་ཀྱི་ཚིགས་དང་པོའི་ངོས་སུ་བཟུང་བ་འདི་ནི་ཀླུ་མགོ་ཅན་གྱི་ཕྱག་རྒྱ་ཐ་དད་པ་ཡིན་ནོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་དེ་ཉིད་ལས་མཛུབ་མོ་གཉིས་ཀྱི་ཚིགས་དང་པོའི་ཕྱི་རོལ་དུ་སྦྱར་ཏེ་བཞག་པ་འདི་ནི་ཀླུ་མགོ་ཅན་གྱི་ཕྱག་རྒྱ་ཐ་དད་པ་ཡིན་ནོ།",
    "དེ་ཉིད་ལས་མཛུབ་མོའི་དབུས་བཀུག་སྟེ་ཕན་ཚུན་ཐོར་ཏོ་སྤྲད་པ་ནི་རྡོ་རྗེ་ཁང་པའི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་འིལས་མཛུབ་མོ་བཀུག་པ་ནི་འོད་ཟེར་༡༡ཕྲེང་གི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་མཛུབ་མོ་གཉིས་ཀྱི་དབུས་བཀུག་ལ་གུང་མོ་གཉིས་བསྣོལ་ལ་བཞག།",
    "མཛུབ་མོ་གཉིས་ཀྱི་ཚིགས་དབུས་མ་བཀུག་པ་ནི་སྤྱན་དྲང་བའི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་ཀྱི་ཚིགས་གཅིག་༡་བཀུག་ལ་མཐེ་བོའི་ངོས་ལ་གཞར་༡་བ་ནི་རིག་པ་མཆོག་གི་ཕྱག་རྒྱ་ཐ་དད་པ་ཡིན་ནོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་རྡོ་རྗེའི་ཚུལ་དུ་བཟུང་བ་ནི་འོད་ཟེར་ཕྲེང་གི་ཕྱག་རྒྱ་གཉིས་པ་ཡིན་ནོ།",
    "དེ་ཉིད་ལས་མཛུབ་མོ་གཉིས་དྲུང་ནས་བཀུག་སྟེ།",
    "གདུ་བུ་ལྟར་བསྣོལ་བ་འདི་ནི་འོད་ཟེར་ཕྲེང་གི་ཕྱག་རྒྱ་ཐ་དད་པ་ཡིན་ནོ།",
    "དེ་ཉིད་ལེགས་པར་བསྟབས་པ་ནི་དཔལ་མོའི་བློ་གྲོས་མའི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་དབུས་བཀུག་སྟེ་མཐེ་བོང་༩གཉིས་ཀྱི་སྟེང་དུ་རལ་གྲི་ལྟར་བྱས་པ་ནི་ཁྲོ་བོ་ཝ་ཏཱི་ལི་ཏཱི་༡ལིའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་གཉིས་རལ་གྲི་ལྟར་བྱས་ཏེ་སྲིན་ལག་གཉིས་ཡིད་ཙམ་གྱིས་བསྟོད་པ་ནི་ཉི་མའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་མཐེ་བོང་ཅགཉིས་ཀྱི་དྲུང་དུ་བཀུག་སྟེ་ཅུང་ཟད་སྦྱར་བ་ནི་མ་ཏང་མིག་གི་ཕྱག་རྒྱའོ།་།",
    "མཐེ་བོང་གཉིས་༥གཤིབས་༦པའི་ཕྱི་རོལ་གྱི་ངོས་ལ་མཛུབ་མོ་གཉིས་བཞག་པ་ནི་གྲུབ་པའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་ཐ་མལ་པར་སྦྱར་བ་ནི་རྣ་ཆ་གདོང་གི་ཕྱག་རྒྱ་གཉིས་པའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་ལས་གཤིབས་པའི་ཁ་ཕྱེ་བ་ནི་དགའ་བྱེད་གདོང་གི་ཕྱག་རྒྱའོ།",
    "གུང་མོ་གཉིས་ཀྱི་རྩེ་མོ་སྲིན་ལག་གཉིས་ཀྱིས་༡༡༦་མོར་སྦྱར་བ་ནི་རྡོ་རྗེ་རྩེ་མོའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་སྙིམ་པའི་ཚུལ་དུ་བྱས་ལ་མཐེ་བོང་གཉིས་ཀྱི་རྩེ་མོ་སྤྲད་དེ་ཁ་སྦྱར་བ་ནི་སྤྱན་དྲང་བའི་ཕྱག་རྒྱའོ།",
    "རྣ་ཆ་གདོང་གི་ཕྱག་རྒྱ་གཉིས་པའི་ལས་མཐེ་བོང་གཉིས་སྦས་པ་ནི་རྡོ་རྗེ་སེར་སྐྱའི་ཕྱག་རྒྱའོ།",
    "གཤིབས་དཔའི་རྩེ་མོར་གུང་མོ་གཉིས་ཀྱིས་བཀབ་སྟེ་བསྡམས་པ་ནི་གཙུག་ནས་འབྱུང་དགི་ཕྱག་རྒྱའོ།",
    "དེ་བཞིན་དུ་མཛུབ་མོ་ཕྱེ་སྟེ་དབུས་སུ་བཀུག་ནས་གུང་མོ་གཤིབས་༤པ་ལ་གཞར་བ་ནི་དེ་བཞིན་གཤེགས་༥༥༥པའི་སྤྱན་གྱི་ཕྱག་རྒྱའོ།",
    "གུང་མོ་སྦས་པ་མཛུབ་མོ་གཉིས་རྩེ་གཅིག་པའི་ཚུལ་དུ་བྱ་བ་ནི་སྒྲོལ་མའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་མཛུབ་མོ་བཀུག་པ་ནི་ཁྲོ་གཉེར་ཅན་གྱི་ཕྱག་རྒྱའོ།",
    "མཐེ་བོང་ནགཉིས་སྦས་པ་ནི་རྡོ་རྗེ་རྩེ་གཅིག་གི་ཕྱག་རྒྱའོ།",
    "ཅུང་ཟད་བརྐྱང་བ་ནི་རྡོ་རྗེ་སྒྲོག་གི་ཕྱག་རྒྱའོ།་།",
    "མཐེ་བོ་༡་ཡང་གཤིབས་༡༡ལ་མཐེའུ་ཆུང་ཡང་གཤིབས་པ་ནི་རྡོ་རྗེ་གདོང་གི་ཕྱག་རྒྱའོ།",
    "གུང་མོ་གཅིག་བསྒྲེང་༡༢བ་ནི་གཙུག་ཕུད་ཀྱི་ཕྱག་རྒྱའོ།",
    "སྙེབ་ནི་རྡོ་རྗེ་གདོང་གི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་ཐུར་ཪྴདུ་བསྟན་ཏེ་མཐེའུ་ཆུང་དང་ལྷན་ཅིག་སྤྲད་པ་འིནི་རྡོ་རྗེ་ནམ་མཁའ་ལྡིང་གི་ཕྱག་རྒྱའོ།་",
    "རྣ་ཆ་གདོང་གི་ཕྱག་རྒྱ་ཉིད་ལས་གུང་མོ་གཉིས་གཤིབས་ཏུ་པ་ལ་མཛུབ་མོ་གཉིས་ཀྱིས་དཀྲིས་པ་ནི་གདོང་དམར་གྱི་རྩ་བའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་གཉིས་རྡོ་རྗེ་ལྟར་བྱས་པ་ནི་སྤྱན་དྲང་བའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་གཉིས་བཀུག་པ་ལས་བཏང་བས་གུང་མོ་གཤིབས་༡པའི་སེན་མོ་གཉིས་ཀྱི་ཕྱི་རོལ་ནས་བསྟན་པ་ནི་རིགས་གསུམ་སྤྱིའི་ཕྱག་རྒྱ་ཆེན་པོ་ཡིན་ཏེ།",
    "རྐང་པ་གཡས་པ་བརྐྱང་བའི་ཚུལ་དུ་བཞག་ནས་མཛུབ་མོ་གཅིག་དྲང་པོར་བསྲང་སྟེ།",
    "དེ་ཉིད་ལས་གཡོན་བརྐྱང་གི་ཚུལ་དུ་བྱས་པ་ནི་རྡོ་རྗེ་དབྱུག་སྔོན་གྱི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་ལག་པ་གཡོན་པའི་མཛུབ་མོ་བཏང་༡སྟེ།",
    "དེ་བཞིན་དུ་མཛུབ་མོ་དང་གུང་མོ་བརྐྱང་བ་ནི་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་མཛུབ་མོ་ཅུང་ཟད་བཀུག་སྟེ་གཡོན་བརྐྱང་དབའི་ཚུལ་དུ་བྱས་པ་ནི་སྤྱན་ཚོལ་དྲང་བའི་ཕྱག་རྒྱའོ།",
    "གུང་མོའི་རྩེ་མོ་མཐེ་བོས་བཀབ་སྟེ་མཛུབ་མོ་བརྐྱང་བ་ནི་གདོན་འཇོམས་པའི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་དེ་ཉིད་ལས་མཛུབ་མོ་དང་སྲིན་ལག་གཉིས་ཀྱིས་ཕྱི་རོལ་ནས་དཀྲིས་ལ།",
    "རྐང་པ་གཡས་བརྐྱང་གི་ཚུལ་དུ་བྱས་ལ་ལག་པ་ནེགཡོན་པ་ལྟ་ཟུར་གྱི་ཕྱོགས་སུ་བཞག་ནས་གཡས་པའི་མཐེ་བོང་གི་ངོས་ཀྱིས་ནསམཐེའུ་ཆུང་དང་སྲིན་ལག་བསྣོལ་བ་མནན་ཏེ།",
    "གུང་མོ་བསྒྲེང་༩ལ་མཛུབ་མོ་ཅུང་ཟད་བཀུག་ནས་རྣ་བའི་ཕྱོགས་སུ་བཞག་པ་ནི་བཅོམ་ལྡན་འདས་མ་རྡོ་རྗེ་ལྕགས་ཀྱུ་མའི་རྩ་བའི་ཕྱག་རྒྱའོ།",
    "གཡོན་བརྐྱང་༡༡གི་ཚུལ་དུ་བྱས་ལ་ལག་པ་གཡོན་པས་དེ་བཞིན་དུ་བྱས་པ་ནི་ལྕགས་ཀྱུའི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་ཉིད་ལས་རྐང་༡༢པ་བསྙམས་༡་ཏེ་བསྒྲེངས་པ་ནི་སའི་ལྷ་མོའི་ཕྱག་རྒྱའོ།",
    "རྩ་བའི་ཕྱག་རྒྱ་ལས་རྐང་པ་གཉིས་བསྐུམས་ལ་མཛུབ་མོ་བརྐྱང་༧སྟེ་བསྟན་པ་ནི་རྡོ་རྗེ་ལྕགས་ཀྱུ་མའི་གདོན་ཞི་བར་བྱ་བའི་ཕྱག་རྒྱའོ།",
    "མདུན་ལོགས་སུ་མཛུབ་མོ་གཅིག་གི་དབུས་བཀུག་སྟེ་བཞག་ལ་གུང་མོ་བརྐྱང་སྟེ་བསྟན་པ་ནི་རྡོ་རྗེ་གདན་༧གྱི་ཕྱག་རྒྱའོ།",
    "གཡོན་པའི་སོར་མོ་གཉིས་ཀྱིས་དེ་བཞིན་དུ་བྱས་པ་ནི་ལྷའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་གཅིག་པུ་ནི་འཇམ་དཔལ་གྱི་ཕྱག་རྒྱའོ།",
    "གུང་མོ་ནི་རྡོ་རྗེ་མཛེས་མའི་ཕྱག་རྒྱའོ།",
    "གཡས་བརྐྱང་གི་ཚུལ་དུ་གནས་ལ་ལག་པ་གཡོན་པའི་སེན་མོ་རྣམས་སྦས་༡ཏེ།",
    "གུང་མོ་དང་མཐེ་བོ་གེགཉིས་སྦྱར་ལ་སོར་མོ་གཞན་༤རྒྱབ་ཏུ་བཞག་པ་ནི་རྡོ་རྗེ་འཇོམས་མའི་ཡིན་ཏེ།",
    "གཡས་བརྐྱང་གི་ཚུལ་གྱིས་ལག་པ་གཡོན་པའི་རྡོ་རྗེ་གཡས་པའི་དཔུང་མགོར་བཞག་ལ་ལག་པ་གཡས་པའི་རྡོ་རྗེ་བསྟོད་ནས་དཔུང་པ་གཡོན་པ་རྣ་བའི་ཕྱོགས་གསུ་བཞག་སྟེ་ལྟ་ཚོབའི་དམིགས་སུ་གཏད་༩༧་པ་ནི་རྡོ་རྗེ་ཕག་མོའི་ཕྱག་རྒྱའོ།",
    "གཡོན་བརྐྱང་གི་ཚུལ་གྱིས་ལག་པ་གཡོན་པ་བཀན་ལ་མཛུབ་མོ་དང་མཐེའུ་ཆུང་གཉིས་བཀུག་སྟེ།",
    "རྡོ་རྗེ་བྷྲིང་༨གི་རི་ཏིའི་ཕྱག་རྒྱ་ཡང་དེ་ཉིད་ཡིན་ནོ།",
    "གཡས་བརྐྱང་གི་ཚུལ་གྱི་༩ལག་པ་གཡོན་པ་བཀན་ཏེ་བརྐྱང་ལ་མཐེ་བོང་ཚདང་མཐེའུ་༡༧ཆུང་སོ་སོར་བསྐྱེད་༡་ནས་སོར་མོ་ལྷག་མ་རྣམས་ཀླུ་མགོའི་གདེངས་ཀ་ལྟར་བཞག།",
    "གཞུ་འགེངས་པ་ལྟར་གྲུ་མོ་རྣ་བའི་ཕྱོགས་སུ་བཟུང་བ་ནི་ཀླུ་ཆེན་པོའི་ཕྱག་རྒྱའོ།",
    "ཁྱབ་འཇུག་གི་འདུག་སྟངས་ཀྱིས་མཐེ་བོའི་སེན་མོ་རྐང་པ་གཡོན་པའི་འོག་ཏུ་སྦྱར་ཏེ།་",
    "ཕོ་ལོང་གི་ཐབས་སུ་གྱེན་དུ་སྤར་༧ཞིང་ལག་པ་བསྐོར་ཏེ་བཀན་པས་ནུ་མའི་བར་དུ་གདེག་ཅིང་བསྐོར་ལ།",
    "ལག་པ་གཉིས་ཀྱི་མཐིལ་ལོགས་ནཀྱི་སོར་མོ་ལ་བལྟས་ནས་མིག་གྱེན་ཁར་བསྒྱུར་ཏེ་བཏེག་ལ་གློག་སྒྱུར་བའི་ཕྱག་རྒྱ་ཡང་བཅིངས་ནས་གཡོན་པའི་སོར་མོའི་༥རྡོ་རྗེའི་ཆེན་པོ་བསྟོད་པ་བྱས་ན་དེས་ལྷ་དང་།",
    "ལག་པའི་སོར་མོ་རྣམས་ཀྱིས་གཡོན་པའི་མཐེའུ་ཆུང་ནས་བརྩམས་ཏེ་རེ་རེ་ནས་བཟུང་སྟེ་དཀྲིས་༡༧ལ་གྲུ་མོ་བསྙམས།",
    "ལག་པ་གཉིས་མའི་མཛུབ་མོ་དང་མཐེ་བོང་གདུ་བུ་ལྟར་ཕན་ཚུན་སྤྲད་པ་འདི་ནི་རྡོ་རྗེ་ལུ་གུ་རྒྱུད་ཐ་དད་པ་ཡིན་ནོ།",
    "སོར་མོ་རྣམས་གཅིག་ལ་གཅིག་བསྡམས་པ་འདི་ཡང་རྡོ་རྗེ་ལུ་གུ་རྒྱུད་ཀྱི་ཕྱག་རྒྱ་ཡིན་ནོ།",
    "དེ་ལས་ཁུ་ཚུར་བཅངས་ཏེ་༡མཐེ་བོང་གཉིས་བརྐྱང་བ་ནི་རྡོ་རྗེ་ཐོག་གི་ཕྱག་རྒྱའོ།",
    "སོར་མོ་རྣམས་ཕྱེ་སྟེ་ཁུ་ཚུར་བཅངས་ལ་མཛུབ་མོ་གཉིས་ཀྱིས་མནན་ཏེ་སྒྲ་དང་བཅས་པར་བརྡབ་པ་ནི་དགྲོལ་བའི་ཕྱག་རྒྱའོ།",
    "ཕན་ཚུན་བསྣོལ་ཏེ་སྙིམ་དཔ་བཟེད་ལ་མཛུབ་མོ་གཉིས་ཀྱི་སེན་མོ་གཅིག་གིས་གཅིག་བཀབ་པ་ནི་སྤྱན་དྲང་བ་ཡིན་ནོ།",
    "གཡས་པའི་མཐེ་རྦི་༡༡དང་མཐེའུ་ཆུང་གཉིས་ཀྱིས་གཡོན་པའི་ཁུ་ཚུར་བཟུང་ལ་མཛུབ་མོ་དང་གུང་མོ་དང་སྲིན་ལག་རྣམས་བརྐྱང་མསྟེ།",
    "མདུང་རྩེ་གསུམ་པའི་དབྱིབས་ལྟར་བྱས་པ་ནི་གཙུག་ནས་བྱུང་གི་ཕྱག་རྒྱའོ།",
    "གཡོན་པའི་སྲིན་ལག་དང་གུང་མོ་སྦས་པ་ནི་གཙུག་༡ལྷནས་བྱུང་གི་ཕྱག་རྒྱ་ཐ་དད་པ་ཡིན་ནོ།་།",
    "ལག་པ་གཡོན་པའི་སྲིན་ལག་དང་གུང་མོ་བཀུག་པ་ནི་ས་མཐེ་བོས་བཟུང་ལ་མཛུབ་མོ་དང་མཐེའུ་ཆུང་གཉིས་བརྐྱང་བ་ནི་རྡོ་རྗེ་འཇིགས་བྱེད་ཆེན་པོའི་ཕྱག་རྒྱའོ།་།",
    "དེ་ཉིད་མཛུབ་མོའི་ཐོར་ཏོ་མཐེ་བོའི་རྩེ་མོ་ལོགས་སུ་བཏུད་པ་འདི་ནི་རྡོ་རྗེ་འཇིགས་བྱེད་ཆེན་པོའི་ཕྱག་རྒྱ་ཐ་དད་པ་སྟེ།",
    "གཞན་ཡང་ནམ་མཁའ་ལྡིང་དང་དཔལ་གྱི་བེའུའི་ཚདབྱིབས་དེ་ལས་མཐེའུ་ཆུང་དང་སྲིན་ལག་གཉིས་ཀྱི་༩ཐོར་ཏོ་བཀུག་པ་ནི་མིག་གི་ཕྱག་རྒྱ་ཞེས་གྲགས་སོ།",
    "མཐེའུ་ཆུང་དང་སྲིན་ལག་དང་གུང་མོ་རྣམས་ཀྱི་ཐོར་ཏོ་ལེགས་པར་བཀུག་པ་ནི་ཁྲོ་གཉེར་ཅན་གྱི་ཕྱག་རྒྱའོ།",
    "གུང་མོ་དང་།",
    "སྲིན་ལག་དང་གུང་མོ་རྣམས་ཀྱི་ཐོར་ཏོ་ལེགས་པར་བཀུག་པ་ནི་ཁྲོ་གཉེར་ཅན་གྱི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་དང་།",
    "གུང་མོ་དང་སྲིན་ལག་དང་མཐེའུ་ཆུང་རྣམས་སྤྲད་ལ།",
    "མཐེ་བོང་༡གཉིས་ཀྱི་ཐོར་ཏོ་གུང་མོ་དང་སྲིན་ལག་གི་མཚམས་སུ་བཞག་པ་ནི་རྟ་མགྲིན་གྱི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་སྲིན་ལག་དང་གུང་མོ་གཉིས་ཀྱི་ཚིགས་ནང་དུ་བཀུག་སྟེ།་",
    "ལག་པ་གཉིས་བླ་འོག་ཏུ་བསྟན་ཏེ་བསྣོལ་ལ་སོར་མོ་རྣམས་གཅིག་ལ་གཅིག་དཀྲིས་ཉ་རིནས་མཐེ་བོང་དང་མཐེའུ་ཆུང་རྣམས་སྤྲད་པ་ནི་རུ་སསྦལ་དང་རྡོ་རྗེ་ས་འོག་གི་ཕྱག་རྒྱའོ།་།",
    "ལག་པ་གཉིས་ཀ་༥ཁུ་ཚུར་བཅངས་ལ་གུང་མོ་བརྐྱང་སྟེ་རྡོ་རྗེ་ལྟར་བྱས་ནས་གཡོན་པའི་མཛུབ་མོ་བརྐྱང་བ་ནི་རྡོ་རྗེ་དབྱུག་པའི་ཕྱག་རྒྱའོ།",
    "སྒྲོལ་ཕྱི་མའི་ཕྱག་རྒྱ་ཉིད་ལས་མཛུབ་མོ་གཉིས་ཀྱི་ཐོར་ཏོ་ནས་གང་ཙམ་གྱིས་ཕྱེ་བ་ནི་རྡོ་རྗེ་ཡངས་པའི་ཕྱག་རྒྱའོ།",
    "དེ་ནས་མཛུབ་མོ་གཉིས་བརྐྱང་༡༢སྟེ་སྤྲད་པ་ནི་པདྨ་ཡངས་པའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་གཉིས་བརྐྱང་མར་བརྗོད་པ་ནི་རྡོ་རྗེ་ས་འོག་གི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་གུང་མོ་གཉིས་ཀྱི་ཐོར་ཏོའི་ཚིགས་དང་པོ་གདུ་༡དབུ་ལྟར་བཀུག་ལ་མཛུབ་མོ་གཉིས་ཀྱི་༡་རིརྩེ་མོ་སྤྲད་པ་ནི་རྡོ་རྗེ་དགྲ་སྟའི་ཕྱག་རྒྱའོད།",
    "གཡོན་པའི་མཛུབ་མོ་བརྐྱང་བ་ནི་རལ་གྲི་དང་།",
    "གུང་མོ་དང་སྲིན་ལག་གཉིས་ཐོར་ཏོ་བསྣོལ་ཏེ་༡་སྦྱར་ལ།",
    "མཛུབ་མོ་དང་མཐེའུ་ཆུང་བརྐྱང་སྟེ་གུང་མོ་དང་མཐེ་བོང་༡༨གཉིས་ཀྱི་རྩེ་མོ་སྦྱར་བ་ནི་རྡོ་རྗེ་སེང་གེའི་ཁྲིའི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་དང་གུང་མོ་གཅིག་ལ་གཅིག་བསྟན་ལ།",
    "ལག་པ་གཉིས་བསྣོལ་ཏེ་སོར་མོ་ཐམས་ཅད་སྦྱར་བར་བྱ་བ་ནི་རྡོ་རྗེ་ར་བའི་ཕྱག་རྒྱའོ།",
    "ལག་པ་གཉིས་བཀན་ལ་མཐེའུ་ཆུང་ནང་དུ་སྦྱར་ཏེ་མཛུབ་མོ་དང་གུང་མོ་དང་།",
    "སྲིན་ལག་རྣམས་རྒྱབ་ཏུ་བསྒྲེངས་༥ནས་མཛུབ་མོ་དང་གུང་མོ་དང་སྲིན་ལག་རྣམས་ཀྱིས་༦མནན་ཏེ་མཐེ་བོང་༧གཉིས་རུ་༨སྦལ་གྱི་ཕྱག་རྒྱ་བཞིན་དུ་བྱས་པ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཕྱག་རྒྱའོ།",
    "སྲིན་ལག་ནང་དུ་བཀུག་ལ་མཐེ་བོང་༩གཉིས་ཀྱི་ཚིགས་དྲང་པོར་མནན་མཛུབ་མོ་གཉིས་ཀྱི་རྩེ་མོ་གུང་མོ་གཉིས་ཀྱི་ཚིགས་དང་པོར་སྦྱར་ནས་མཐེའུ་ཆུང་གཉིས་དྲང་པོར་སྦྱར་བ་ནི་མཚོན་ཆ་ཆེན་པོའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་མཛུབ་མོ་གུང་མོ་༡༡གཉིས་ཀྱི་སེན་མོ་ལ་བརྟེན་༡༢པ་ནི་མཚོན་ཆ་མཆོག་གི་ཕྱག་རྒྱའོ།",
    "མཚོན་ཆ་ཆེན་པོའི་ཕྱག་རྒྱ་དེ་ཉིད་ལས་མཛུབ་མོ་གཉིས་གུང་མོ་གཉིས་ཀྱི་ཚིགས་དང་པོའི་སྲུབས་༡རིཀྱི་གློར་གཞར་བ་ནི་མཚོན་ཆའི་ཤུགས་ཀྱི་ཕྱག་རྒྱའོ།",
    "ནམ་མཁའ་ལྡིང་གི་དཔལ་བེའུའི་༡་ཕྱག་རྒྱ་ལྟར་སྲིན་ལག་ཕྱེ་སྟེ་མཐེ་བོང་༡༩གཉིས་དྲང་པོར་གཤིབས་པ་ཡང་རྡོ་རྗེ་དབྱུག་སྔོན་གྱི་ཕྱག་རྒྱའོ།་།",
    "མདའ་བོ་ས་ཆེའི་དབྱིབས་ལྟར་གུང་མོ་གཉིས་ཀྱི་དྲུང་དུ་མཐེ་བོང་གཉིས་གཤིབས་ཉཔའི་རྩེ་མོ་བཀུག་པ་ནི་གཙུག་ཏོར་གྱི་ཕྱག་རྒྱའོ།",
    "གུང་མོ་གཉིས་གཤིབས་༦པ་མནན་ནས་གཤིབས་༥༧པའི་ཚིགས་དང་པོར་མཛུབ་མོ་གཉིས་སྦྱར་༨བ་ནི་འདོད་པའི་རྡོ་རྗེ་མའི་ཕྱག་རྒྱའོ་༥།",
    "དེ་ཉིད་ལས་མཐེ་བོང་གཉིས་སེན་མོ་སྤྲད་པ་དེ་ལ་སྲིན་ལག་གཉིས་སྦྱར་བ་ནི་ལུས་ལས་བྱུང་གི་ཕྱག་རྒྱའོ།",
    "ཐལ་བའི་ཁུ་ཚུར་ནི་འཇོམས་བྱེད་ལྔའི་ཕྱག་རྒྱའོ།",
    "ལག་པ་གཉིས་བཀན་ཏེ་སོར་མོའི་ཕྱི་རོལ་དུ་བསྣོལ་མར་བརྐྱང་ལ་མཛུབ་མོ་བསྲང་སྟེ་ཚིཐོར་ཏོ་སྦྱར་ནས་མཐེ་བོ་བརྐྱང་༡༢ནས་མདུང་རྩེ་གསུམ་པའི་དབྱིབས་ལྟར་བྱས་པ་ནི་ཏ་འམུའི་ཕྱག་རྒྱའོ།",
    "མཐེའུ་ཆུང་དང་སྲིན་ལག་གི་ཐོར་ཏོ་མཐེ་བོས་མནན་ལ་སོར་མོ་ལྷག་མ་རྣམས་བརྐྱང་སྟེ་མདུང་རྩེ་གསུམ་པའི་ཕྱག་རྒྱའོ།",
    "ལག་པ་གཉིས་བཀན་ཏེ་སོར་མོའི་དབྱིབས་ལྟར་བྱས་༧པ་ནི་ལུས་དཔག་མེད་ཀྱི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་གཉིས་སོ་སོའི་གུང་མོའི་དྲུང་དུ་བཀུག་པ་ནི་ལོག་འདྲེན་རྣམས་ཀྱི་ཕྱག་རྒྱའོ།",
    "ཅུང་ཟད་བསྟོད་པ་ཁྱབ་འཇུག་གི།",
    "གུང་མོ་གྱེན་དུ་བསྒྲེང་༡་བྱས་ལ།",
    "དེ་ཡི་སྟེང་དུ་མཛུབ་མོ་དང་།",
    "ཉི་མ་ཡི་ནི་ཡིན་པར་བཤད།",
    "གཡོན་པའི་སོར་མོ་བཞི་པོ་རྣམས།",
    "མཛུབ་མོ་ཡང་ནི་དེ་བཞིན་སྦྱར།",
    "སོར་མོ་གསུམ་པོ་རྣམས་ཀྱང་ནི།",
    "སོར་མོ་དག་ནི་བཞི་པོ་རྣམས།",
    "སོར་མོ་ཡི་ནི་མཛུབ་མོ་དང་།",
    "གུང་མོ་ཚིགས་ཀྱི་བར་དུ་ནི།",
    "འདི་དག་གིས་ནི་སྦྱར་བྱས་ཤིང་།",
    "གུང་མོ་གྱེན་དུ་བསྒྲེང་༡ནས་ནི།",
    "ལྷ་ཆེན་གྱི་ནི་ཡིན་པར་ཤེས།",
    "གཡོན་པའི་གུང་མོ་གང་ཡིན་པ།",
    "ལག་པ་གཉིས་ཀུའི་སོར་མོ་ཡི།",
    "ལྷ་མོའི་ཕྱག་རྒྱ་ཡིན་པར་བཤད།",
    "ལག་པ་གཉིས་མའི་མཐེ་བོང་སགཉིས་ཀྱིས་མཐེའུ་ཆུང་གི་སེན་མོ་མནན་ལ་སོར་མོ་ལྷག་མ་རྣམས་ཀྱི་བར་ནས་གང་ཙམ་གྱིས་ཕྱེ་སྟེ་རྡོ་རྗེའི་མཚན་ཉིད་དུ་བྱས་ལ་དེ་གཉིས་༧བསྣོལ་ཏེ་དཔུང་མགོར་བཞག་ནས་མཆེ་བ་མནན་ལ་དྲག་ཏུ་ལྟ་ཞིང་ཁུར་༧བ་བུས་ཏེ་རྐང་པ་ཕྲལ་ལ་འགྲེང་ཞིང་གཡས་བརྐྱང་གི་༡༨ཚུལ་གྱིས་ལུས་བཏུད་པ་ནི་འཕགས་པ་བདུད་རྩི་ཐབ་༡་སྦྱོར་གྱི་རྩ་བའི་ཕྱག་རྒྱའོ།",
    "གཡས་པ་ནི་དམ་ཚིག་གི་རྡོ་རྗེ་ཡིན་ནོ།",
    "སྙིམ་པ་བཀན་༡ལ་མཐེའུ་ཆུང་གཉིས་བསྣོལ་བའི་བར་དུ་ཚོན་སྲིན་ལག་གཉིས་བཞག་ནས་མཛུབ་མོ་གཉིས་དབུས་བཀུག་ལ་གུང་མོ་གཉིས་གཞིབས་ནཔ་དེའི་ཚིགས་དང་པོར་བསྟན་ཏེ་མཐེ་བོ་གཉིས་གློ་ལ་བཅར་༤རིནས་སྙིམ་པའི་ཐབས་སུ་བྱས་པ་ནི་ཁྲུས་ཀྱི་ཕྱག་རྒྱ་སྟེར།",
    "དེ་ཉིད་ལས་མཛུབ་མོ་གཉིས་བཀུག་མཐེ་བོང་གཉིས་ཚིགས་དང་པོ་ཡང་ནང་དུ་བཏུད་པ་ནི་ལྷ་ཐམས་ཅད་ཀྱི་སྤྱིའི་ཁྲུས་ཀྱི་ཕྱག་རྒྱའོ།",
    "བསྲུང་བའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་བཏང་སྟེ་རྡོ་རྗེའི་ཚུལ་དུ་བྱས་པ་ནི་བསྲུང་བ་ཆེན་པོ་ལོག་འདྲེན་ཐམས་ཅད་འཇོམས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "གཡོན་པའི་སོར་མོ་གཉིས་ཀྱི་༡༥མཐེ་བོང་སྦས་ཏེ་གདུ་བུ་ལྟར་འདུག་པའི་ནང་དུ་མཐེའུ་ཆུང་དང་རྨེཛུབ་མོ་གཉིས་དབུ་ས་བཀུག་སྣ་པའི་ཐོར་ཏོ་བཅུག་ལ་ལག་པ་གཡས་པ་སྟ་༡་ཟུར་ཕྱོགས་སུ་རྡོ་རྗེར་བྱས་ཏེ་ལས་ཐམས་ཅད་ལ་དྲི་དང་མེ་ཏོག་དང་བདུག་པ་ལ་སོགས་པ་ཐམས་ཅད་ལ་སྦྱར་ན་བགེགས་འོང་བར་མི་འགྱུར་རོ།",
    "རྡོ་རྗེ་དེ་ཉིད་གཡོན་པའི་གཏུམ་མོ་ཕྱོགས་སུ་བཟུང་༡རྟེན་གཟི་བྱིན་སྐྱེ་བར་འགྱུར་རོ།"
  ]
}