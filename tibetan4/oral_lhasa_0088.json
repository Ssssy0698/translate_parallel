    "བདག་ལ་སྦྱིན་པ་ཁོ་ན་ལེགས་པར་འགྱུར་གྱི།",
    "གཞན་ཡང་སློང་བ་པོ་ལེགས་པར་འོངས་པ་ན།",
    "དེ་སྤངས་ཏེ་སོ་སོར་བརྟགས་ནས་དངོས་པོ་དེ་སྦྱིན་པར་བྱེད་དོ།",
    "སྦྱིན་པ་ལ་གེགས་བྱེད་པའི་གཉེན་པོ་རྣམ་པ་བཞི་ཤེས་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "སོ་སོར་ཡང་དག་པར་རིག་པ་ལ་བརྟེན་པ་དང་།",
    "ལྷག་པའི་བསམ་པ་རྣམ་པར་དག་པའི་སྦྱིན་པ་ལ་བརྟེན་པ་དང་།",
    "འདི་མན་ཆད་དཀའ་བའི་སྦྱིན་པ་ལ་སོགས་པ་གཞན་ཐམས་ཅད་ནི་ཐམས་ཅད་ཀྱང་སྦྱིན་པ་འདི་ཉིད་ཀྱི་བར་ཏུ་དབྱེ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་མཆོག་དང་རབ་མཆོག་ཏུ་གྱུར་པ་ལ་ཞེན་པ་བསལ་ནས།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོའམ།",
    "དུས་ལ་བབ་པ་དང་གཞན་ལ་མི་གནོད་པར་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་གང་ཡིན་པ་འདི་ནི།",
    "མི་བརྟེན་པར་སྦྱིན་པ་དང་།",
    "རྒྱུན་མི་འཆད་པར་སྦྱིན་པ་དང་།",
    "སྣོད་སྤྱད་རྣམ་པ་སྣ་ཚོགས་འདོད་པ་རྣམས་ལ་ནི་སྣོད་སྤྱད་རྣམ་པ་སྣ་ཚོགས་སྦྱིན་པར་བྱེད་པ་དང་།",
    "སྣང་བས་ཕོངས་ཤིང་འདོད་པ་རྣམས་ལ་ནི་སྣང་བ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "གཙང་མ་དང་།",
    "རུང་བ་སྦྱིན་པར་བྱེད་པའོ།",
    "ཆུ་ལ་སོགས་པའི་འཇིགས་པ་ལས་ཡོངས་སུ་སྐྱོབ་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "རིགས་པར་སྟོན་པ་དང་བསླབ་པའི་གཞི་ཡང་དག་པར་འཛིན་དུ་འཇུག་པ་སྟེ།",
    "དེ་ནི་རྣམ་པ་བཅུར་རིག་པར་བྱ་སྟེ།",
    "རྣམ་པར་སྨིན་པ་ལ་མི་ལྟ་བའོ།",
    "མི་སྐྱོ་བར་ལ་གོར་དུ་སྐྱེན་པར་སྦྱིན་པར་བྱེད་དེ།",
    "སྐྱེན་དུ་བྱེད་པ་དེ་ལྟ་བུར་ནི་སློང་བ་པོ་རྙེད་པ་ལས་བརྩམས་ཏེ་དེ་ལྟར་སྐྱེན་པར་མི་བྱེད་དོ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་རྣམ་པར་དག་པར་འགྱུར་རོ་ཞེས་ལྟ་བས་མཆོག་ཏུ་འཛིན་པར་མི་བྱེད་དོ།",
    "ཕྱིས་ཅིག་ཅར་སྦྱིན་པ་སྦྱིན་པར་མི་བྱེད་དོ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཡང་མཚུངས་ལ་སློང་བ་པོ་སྔ་ཕྱི་དང་།",
    "ལོངས་སྤྱོད་ཇི་ལྟར་བྱུང་བ་བཞིན་དུ་སྦྱིན་པ་ནི་ཁ་ན་མ་ཐོ་བ་མེད་པར་མཐོང་ངོ།",
    "མི་བཟོད་པ་དང་ཡིད་མ་ཆེས་པ་བསྐྱེད་པའི་འོག་ཏུ་མ་བསླངས་པར་ཡང་ཁ་ཅིག་ལ་བསྩགས་པའི་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པའི་ཕྱིར་ཏེ།",
    "གཞན་ལ་འགྲན་པའི་ཕྱིར་ཡང་སྦྱིན་པར་མི་བྱེད་དོ།",
    "གྲགས་པ་ནི་རྣམ་པར་རྟོག་པའི་ཡི་གེ་ལས་བྱུང་བ་དང་།",
    "ལོ་མ་སྐམ་པོ་ལྟ་བུ་ཡིན་པར་འཛིན་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "རབ་མཆོག་གང་ཡིན་པ་དེ་དག་སྦྱིན་པར་བྱེད་དོ།",
    "རྣམ་པར་སྨིན་པ་ལ་མི་ལྟ་བའི་སྦྱིན་པ་གང་ཞེ་ན།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱས་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཐམས་ཅད་མཁྱེན་པ་དང་མཐུན་པའི་རྣམ་པར་སྨིན་པ་སྐྱེ་དགུ་རྣམ་ལ་ཕན་པ་དང་བདེ་བ་བགྱིད་པ་བསྟན་ལགས་སོ།",
    "སྦྱིན་པའི་རྣམ་པར་སྨིན་པ་འཆབ་མི་འཚལ་བ་ལགས།",
    "དྲང་སྲོང་ཆེན་པོ་གཞན་ཡང་སྦྱིན་པ་ལྔ་ཡོངས་སུ་རྫོགས་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་སྦྱིན་པ་ཡོངས་སུ་དག་པ་གང་ལགས།",
    "གཞན་ཡང་སྦྱིན་པ་བླ་ན་མེད་པར་ལྟ་བ་ལྔ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་དང་།",
    "རྣམ་པར་གྲོལ་བ་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་མཐོང་བ་ཕུན་སུམ་ཚོགས་པ་ལ་སྦྱིན་པ་བྱིན་ན་སྦྱིན་པ་ཆེན་པོ་ཡིན་ནོ།",
    "མི་བདོག་པ་དེའི་བསམ་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ནི་སྦྱིན་པ་ཆེན་པོ་ཡིན་ཏེ།",
    "བྱིན་པར་གྱུར་ཅིག་སྙམ་དུ་བསམས་ནས་སྦྱིན་བྱིན་ལ།",
    "སྦྱིན་པ་བྱིན་ནས་དངོས་ལ་གནས་པར་བྱེད་པ་མེད།",
    "ཆུང་ངུ་བཏང་ལ་མང་པོ་དཔག་ཏུ་མེད་པར་འགྱུར།",
    "སྤྱོད་ཚེ་ལོངས་སྤྱོད་མཐའ་ཡས་རྒྱས་པ་ཐོབ་པར་འགྱུར།",
    "ཅེས་གསུངས་སོ།",
    "མཁས་པ་དག་རྣམ་པ་སུམ་ཅུ་རྩ་བདུན་གྱིས་སྦྱིན་པ་སྦྱིན་པར་བྱེད་དོ།",
    "དེ་བཞིན་གཤེགས་པས་རྗེས་སུ་གནང་བའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "དངོས་པོ་གསུམ་ཡོངས་སུ་དག་པར་རུང་བའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་གཡེང་བ་ཐམས་ཅད་དང་བྲལ་བས་གུས་པས་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་གཏོང་བ་ལ་ལོངས་སྤྱོད་ཀྱི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པར་འགྱུར་བ་རྟག་ཏུ་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "གཟུགས་བཟང་བ་ཡང་དག་པར་འགྲུབ་པ་ཁ་དོག་ཕུན་སུམ་ཚོགས་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "གྲགས་པ་ཕུན་སུམ་ཚོགས་པ་ཡང་དག་པར་འགྲུབ་པ་དྲི་ཕུན་སུམ་ཚོགས་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་རོ་བྲོ་བའི་མཆོག་མཁྱེན་པའི་དཔེ་བྱད་ཀྱི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་རོ་ཕུན་སུམ་ཚོགས་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་ལ་ལོངས་སྤྱོད་རྒྱ་ཆེ་བའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་རྒྱ་ཆེ་བའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་གྱ་ནོམ་པའི་ལོངས་སྤྱོད་ཀྱི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་གྱ་ནོམ་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་བཀྲེས་པ་དང་སྐོམ་པ་སེལ་བའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་བཟའ་བའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་སྲིད་པ་ཐམས་ཅད་དུ་སྐོམ་པ་སེལ་བའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་སྐོམ་གྱི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་གྱ་ནོམ་པའི་གོས་ཀྱི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་གོས་ཀྱི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་བསིལ་ཁང་དང་།",
    "རྣམ་པར་སྨིན་པ་རིགས་མཐོན་པོའི་རིགས་དང་ལྡན་པའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་མལ་དང་སྟན་གྱི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞིའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་བཞོན་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་སྐྱེས་བུ་ཆེན་པོའི་མཚན་སུམ་ཅུ་རྩ་གཉིས་དང་།",
    "དཔེ་བྱད་བརྒྱད་ཅུའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་ཁྲུས་ཀྱི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "གནོད་སེམས་སྤངས་པའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་བྱམས་པ་ལ་བརྟེན་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "མི་དགའ་བ་སྤངས་པའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་དགའ་བ་ལ་བརྟེན་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་རྗེས་སུ་ཆགས་པ་དང་ཁོང་ཁྲོ་བ་སྤངས་པའི་རྙེད་པ་ཡང་དག་པར་འགྲུབ་པ་བཏང་སྙོམས་ལ་བརྟེན་པའི་སྦྱིན་པ་སྦྱིན་པ་དང་།",
