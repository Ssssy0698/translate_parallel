    "གཤེགས་དང་གཤགས་དང་བཤགས་རྣམས་ནི།",
    "འདི་དག་པར་དུ་བསྐྲུན་པའི་དགེ།",
    "རིག་བྱེད་འདི་ཀ་པར་དུ་སྐྲུན་སྐབས་སྤྲང་བོ་མ་ཏི་ས་རས་བྲིས་སོ།",
    "ཚེ་སྲོག་ལ་འཁྱིལ་བའི་ཟུངས་ཁྲག་དང་བརྡ་དག་ཕྱེ་མ་ལེབ་ཀྱི་མཆན་འགྲེལ་དང་སུམ་རྟགས་ཀྱི་དྲིས་ལན་ཞེས་པ་པར་སྐྲུན་བྱས།",
    "དགེ་ལུགས་ཞིབ་འཇུག་ཚོགས་པའི་དྲུང་ཡིག་པའི་ཕྱག་ལས་ཀྱང་གནང་མྱོང་།",
    "༦ དཔེ་རྙིང་དང་གསར་རྩོམ་པར་སྐྲུན་བྱེད་པ་བཅས་ཡིན།",
    "སྒྲ་རིག་གནམ་འཕང་གཅོད་བྱེད་བརྡ་དག་ཕྱེ་མ་ལེབ་ཀྱི་གཤོག་རླབས་ཀྱི་འགྲེལ་བ་བློ་གསལ་མྱོས་པའི་དགའ་སྟོན་ཅེས་བྱ་བ་བཞུགས་སོ།",
    "ཏིང་འཛིན་པིར་རྩེ་འཁྱུག་པའི་མཁྱེན་རྩལ་ཀྱིས་།",
