    "རྣམ་སྲས་ཁྱོད་གསོན་པཎ་ཆེན་གདན་དྲང་ཕྱིར།",
    "ངལ་བ་དོན་མེད་བདག་ལ་དེ་རིང་གཟིགས།",
    "གདུལ་བྱའི་རེ་སྐོང་ཡིད་བཞིན་ནོར་འདྲ་ཁྱོད།",
    "ད་ནི་རིན་ཆེན་གླིང་སོང་ལག་སྟོང་དང་།",
    "སྐབས་འདི་མངོན་སུམ་སྤྱན་གྱི་གཟིགས་བཞིན་ཡང་།",
    "ད་རུང་འདིར་མ་འདུག་པར་སོང་ཞིག་ཤིང་རྟའི་ངོ་ཆེན་ལ་དྲངས་པའི་རྟེན་གཉིས་ཀ་ཕྱིན་ཅི་ལོག་ཏུ་བསྒྱུར་ཡོད་དེ།",
    "ཇོ་བོ་ཐུགས་རྗེ་ཆེན་པོའི་འཁོར་ལོ་ནི་གཟེར་ཆག་པས་ཞབས་གོག་པོར་སོང་།",
    "འདིར་ཅི་བྱེད་ཅི་བྱེད་བྱང་ཕྱོགས་སུ་སོང་ཞིག་སོང་ཞིག་གསུང་སྐད།",
    "རྨི་ལམ་གྱི་དུས་ཐོག་དྲི་བཞིན་དུ་རྣལ་འབྱོར་སྐྱིད་ཀྱི་མིང་པོ་གཅིག་གིས།",
    "མོན་ཡུལ་བྲང་སར་སླེབས་སོ།",
    "སྣ་གཉིས་ལ་ནོར་འགའ་རེ་བྱིན།",
    "དེའི་ཚ་ཛ་ཡ་ཤྲཱི་ན་རེ།",
    "ཁྱོད་ཀྱི་ཕྱི་བོངས་ལ་པཎ་ཆེན་དང་པཎ་ཆུང་རྣམས་མ་མགུ་བར་འདུག་པས།",
    "ཏམ་པོ་ལ་བཟང་བ་རེ་དྲངས་ཏེ།",
    "འདི་ཡི་དྲུང་ན་ལོ་ཙཱ་བ་ཆེ་ཆེ་དང་ཆེ་གེ་མོ་རྣམས་ནི་དིག་པར་འདུག་གསུངས།",
    "རྒྱ་གར་དགེ་སློང་མ་དང་དགེ་ཚུལ་མ་གཉིས་སྔོན་གྱི་མ་རྒན་ཚབ་མར་བསྲལ་བས་འཆི་ཁར་ཞལ་ཆེམས་བཞག་པའི་རྩིས་ཅན་དུ་སོང་བས་དོ་ལི་འདོད།",
    "ཁུར་པོ་བ་ཡང་ཤིན་ཏུ་དཀའ་བར་སོང་ནས་མི་རྙེད་པར་གྱུར།",
    "ཡང་ཛ་ཡ་ཤྲཱི་ན་རེ།",
    "བསྙེན་གནས་སྲུང་བ་གཟིགས་པས་བོད་ཀྱི་མི་སྐྱ་ནི།",
    "ད་སྡོད་གོ་ལེ་གྲབས་སུ་བཅུག་པས་ཆོག་བར་སོང་ངོ།",
    "བྷེ་དྷུར་ནས་ཡོན་ཏན་ཡོད་པའི་རྒྱ་གར་བ་བཙན་བཙུན་ཐམས་ཅད་ལ་དོ་ལི་དགོས་པར་སོང་བས།",
    "ལ་དེ་ཐོན་པའི་ལུང་པ་ན་བདུད་རེག་པ་རྒྱ་གཅིག་བྱ་བ་ཤིན་ཏུ་གཉན་པ་གཅིག་ཡོད་པས་དངོས་སུ་བར་ཆོད་བྱེད་པ་ལ།",
    "མགྲོན་ཚན་མང་པོ་རེས་གཡག་གྲུས་པོ་རེ་བཙལ་ལ་མཆོད་དགོས་པས།",
    "ལོ་ཙཱ་བས་ཟན་ལ་གཡག་གི་གཟུགས་བཟོས་ནས་བདེན་པ་བདར།",
    "དེའི་སྤྲིངས་ཡིག་གི་ཚིག་ནི་འདི་སྐད་ཅེས་བྱའོ། ། ཨ་སྭ་སྟི་སིད་ྡྷཾ།",
    "ཁྱོད་ཉིད་སྔར་གསན་སླད་ཀྱིས་གཟིགས་པར་གྱུར།",
    "དེ་ལྟར་བདག་གིས་ཀྱང་ནི་ཚུལ་འདི་ལགས།",
    "གྲོ་མོའི་ཁྲོད་ནས་བཅུ་གསུམ་ཞག་གིས་བདག།",
    "མོན་ཡུལ་ཆུག་ཡུལ་ཤི་སྐྱིད་ཡུལ་བརྒལ་ཏེ།",
    "དེ་ཡུལ་མཐའ་ནས་ཟླ་ཕྱེད་ལམ་སོང་ན།",
    "བྱང་ཕྱོགས་སོང་ཞིག་དཔག་མེད་དོན་འགྱུར་ཞེས།",
    "པད་མོས་ཉི་ཟེར་ལྟ་བུར་ཐུགས་དབྱེ་མཛ་ད།",
    "དེ་ནས་རིམ་གྱིས་གྲོ་མོ་བའི་བསུ་བའི་ཁྲོམ་ཆེན་པོས་སླེབས།",
    "རྒྱ་གར་བ་རེ་རེ་ལ་ཡང་མི་བཅུ་བཅུས་ཁུར་བས་བདེ་བླག་ཏུ་གྲོང་ཡུལ་དུ་ཕེབས་སོ།",
    "གནས་དགོན་དང་བཙན་བཙུན་རྣལ་འབྱོར་ཕོ་མོ་ལ་སོགས་པ་གང་ཟག་རྣམས་ཀྱང་དགེ་སྤྱོད་ལ་རྩིས་ཆེ་བ་དང་།",
    "ཨཱརྻ་མེ་དྲིའི་དོན་གཅིག་བྱས་ལ་སང་ཕོད་འོང་གིས་གསུངས།",
    "ལེའུ་སྟོན་མོ་ལ་སོགས་པ་བཟང་པོ་ཤ་སྟག་མ་ཆད་པར་བྱས།",
    "ཐུགས་དམ་ཡང་འཕེལ་བས་སྔར་ཞལ་མ་གཟིགས་པའི་ལྷ་རྣམས་ཀྱང་འདིར་མཐོང་།",
    "སྒྲ་དེ་རྣམས་ཀྱང་སྔོན་དུ་རོལ་མོའི་སྒྲ་རང་དུ་ཐོས་པ་ལ།",
    "ཅུང་ཟད་རྒྱས་སུ་བྱེད་གསུངས་ནས་རྒྱས་ཤོས་དེ་གླས་མོ་ཆེར་མཛད་དོ།",
    "ཕྱིས་རྒྱས་ཤོས་དེ་ཡང་གླས་མོ་ཆེར་མཛད།",
    "དགེ་སློང་གི་ཚིག་ལེའུར་བྱས་པ་འཕགས་པ་སང་གྷའི་ལྷས་མཛད་པ་དེ་ཞར་ལ་གསུང་ཞིང་ཞར་ལ་བསྒྱུར་རོ།",
    "གཞུ་དང་སྙི་མོའི་ལམ་ནས་མཚུར་ཕུ་ནས་སྟོད་ལུངས་བརྒྱུད་དེ།",
    "གཉལ་གྱི་ཟངས་མོ་ཆེ་བ་ལ་སོགས་པས་རྒྱལ་སྲས་ལམ་རིམ་གྱི་ཁྲིད་རྒྱས་བསྡུས་རྣམས་བསྐྱངས་སོ།",
    "ལྷོའི་མོན་ཡུལ་ནས་འདྲེན་པ་ལ་སོགས་པའི་སྟ་གོན་བྱེད་ཅིང་ཡོད་དོ།",
    "དེའི་དུས་ན་དབུས་ཡར་ལུང་འཕྱོས་ཀྱི་འ་ཞ་ཇོ་སྲས་ཞེས་བྱ་བའི་བཙུན་པ་ཞིག་གིས་ཀྱང་ལྷ་ཁང་གི་གྲོགས་ལྡན་ལ་སོགས་བྱས་པ་ལས།",
    "བློན་རྒྱན་གྱི་གཡོག་པོ་བརྟག་དཔྱད་དང་མི་ལྡན་པ་ཁ་ཅིག་གིས་མིག་ཕྱུང་བར་གྱུར་ཏོ།",
    "ལོ་ཙཱ་བས་བདག་གི་བྱ་བའི་ལས་ཀྱི་མཐའ་འདི་ལྟ་བུ་ལ་བརྟེན་ནས།",
    "དགེ་སྦྱོང་གི་མིག་ཤོར་བ་ནི་འཇིག་རྟེན་ན་དཔེ་མེད་དོ་ཞེས་མྱ་ངན་དང་སེམས་ཁྲལ་དཔག་ཏུ་མེད་པ་ཡང་བྱས།",
    "འགྲོ་བ་ཀུན་གྱི་སྐྱབས་མཆོག་གྱུར་བ་ཕོངས་པ་བདག་གི་སྐྱབས་གཅིག་གསོན།",
    "སྔོན་བསགས་རང་གི་ཉོན་མོངས་ཉེས་སྤྱོད་ནག་པོ་གདུག་པའི་ཀླུས་འཕངས་པ།",
    "ལྟར་ཉོན་མོངས་དེ་ལྟར་ངས་སྐྱོབ་ཞེས།",
    "ད་ལྟར་འདི་ན་སྣ་ཚ་གས་འཇིགས་བཅས་ཉོན་མོངས་བདག་ཅག་མི་གཟིགས་སམ།",
    "སྙོམས་པའི་བུ་ལ་འཛངས་པའི་ཕ་བཞིན་གལ་ཏེ་ཁྱོད་མིན་བདག་སྐྱོན་ནའང་།",
    "དགེ་འདིས་མྱུར་དུ་ཞབས་པད་རྡུལ་རེག་ལྷ་མཆོག་ཁྱོད་ཀྱིས་རྗེས་འཛིན་ཤོག།",
    "དེ་རིང་ཕན་ཆད་ཇི་སྲིད་བདག་ནི་ལྷ་མིའི་སྟོན་མཆོག་ཁྱོད་ལྟ་བུར།",
    "གང་གྱུར་དེ་སྲིད་ནམ་མཁའི་མཐའ་ཀླས་སྲིད་གསུམ་འདི་ན་བདག་གི་སྐྱབས།",
    "ཁྱོད་ཅིག་ལགས་སོ་དེ་བས་བདག་གི་འདོད་དགུ་ཐམས་ཅད་ཁྱོད་མཁྱེན་ལ།",
    "ཡབ་ཅིག་ཁྱོད་ཀྱི་ཐུགས་རྗེ་བརྟན་པོས་བཏང་བར་ནམ་ཡང་མ་དགོངས་ཤིག།",
    "འཕྱོས་ཀྱི་ངོར་དགེ་ཞེས་བྱ་བར་མིག་སྟོང་གི་ཡོ་བྱད་བླངས་པ་རྣམས་ལ།",
