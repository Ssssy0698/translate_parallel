    "དེ་ནས་དེ་ལྟ་བུའི་བཟོ་བོ་ཆེར་མེད་པར་གྱུར་པའི་ཚེ་ལྷའི་བཟོ་བོ་མང་པོ་མིར་སྤྲུལ་ནས་བྱུང་སྟེ།",
    "བཟོ་རྒྱུན་དེ་བལ་ཡུལ་གྱི་རང་ལུགས་སུ་བཞེད་ལ་ཕྱིས་ནི་ངེས་པ་མེད་པར་གསུངས་པ་དང་།",
    "བོད་ཡུལ་དུའང་སྲོང་བཙན་གྱི་དུས་ནས་བཟུང་ཡུན་རིང་པོར་རྒྱ་གར་གྱི་བཟོ་རྒྱུན་བལ་པོའི་ཡུལ་དུ་གང་མཆིས་པ་ཐམས་ཅད་ཀྱིས་སྐུ་གཟུགས་བཞེངས་ཤིང་རྒྱུན་སྤེལ་བས།",
    "ཁྱད་པར་འབུར་སྐུ་ལ་ཤན་ཞུགས་ཤིན་ཏུ་ཆེའོ།",
    "སྒྲ་གཅན་འཛིན་བཟང་པོས་ནཱ་ལེནྡྲར་དྲི་གཙང་ཁང་བཅུ་བཞི།",
    "དྲིལ་བུ་དང་མདའ་ཡས་མཛེས་པར་སྤྲས་པ་སོགས་བཟོ་བཀོད་ལེགས་པ་གྲངས་མེད་བྱུང་།",
    "སུའེ་རྒྱལ་རབས་ཏེ་དུས་རབས་དྲུག་པའི་ནང་དུ་ཡང་ཅིན་གྱིས་རྒྱ་ནག་གཅིག་གྱུར་བྱས་པའི་རྨང་གཞིའི་སྟེང་རྒྱལ་པོ་སེང་གེ་བཙན་པོ་ཕ་བུས་ཡང་སྐྱར་གཅིག་གྱུར་སྲ་བརྟན་བཏང་སྟེ་ཐང་རྒྱལ་རབས་ཚུགས།",
    "དཔུང་སྟོབས་ལྷག་པར་དར།",
    "༡༦༡༦ལོར་མན་ཇུ་རིགས་ཨས་ཤིན་ཇོ་ལོ་ནུར་ཧ་ཁྲི་བྱ་བས་པེ་ཅིན་དུ་རྒྱལ་ས་བྱས་ཏེ་ཆིང་རྒྱལ་རབས་བཙུགས།",
    "ལྔ་པ་རྨུ་རྒྱལ་ཁོ་རྗེ་ཞེས་བྱས་བཟུང་།",
    "རྒྱལ་པོ་སེ་མིར་ཁྲིད་བཞུགས།",
    "གཉའ་ཁྲི་བཙན་པོ་ནི་སྤྱི་ལོ་སྔོན་གྱི་༢༤༧ལོར་བོད་ཀྱི་རྒྱལ་པོར་ཕེབས་པ་ཡིན་ལ།",
    "བལ་བཟོ་དེ་ཁུངས་བཙུན་པར་བརྩི་བ་དང་།",
    "རི་བོ་རྩེ་ལྔ་སོགས་སུ་གཙུག་ལག་དང་རྟེན་བཞེངས་ཏེ་དར་ཞིང་རྒྱས་པར་མཛད།",
    "དུས་རབས་བཅུ་པའི་མཇུག་ཏུ་ཀླུ་མེས་འབྲོམ་ཆུང་རི་བོ་དན་ཏིག་ནས་རྒྱ་ནག་ཏུ་གནས་མཇལ་ཕྱིན་པའི་ལམ་ཞོར་ཁྲང་ཨན་དུ་རྒྱུན་རིང་བཞུགས་ཤིང་།",
    "དུས་རབས་བཅུ་གཉིས་པར་འཇམ་དབྱངས་ས་པཎ་ཀུན་དགའ་རྒྱལ་མཚན་བྱོན།",
    "རང་ལུགས་ཀྱི་རྒྱུན་སྤེལ་ཏེ་བདེ་བར་གཤེགས་པའི་སྐུ་གཟུགས་ཀྱི་ཚད་ཀྱི་རབ་ཏུ་བྱེད་པ་ཡིད་བཞིན་ནོར་བུ་ཞེས་བྱ་བ་སོགས་བཟོའི་གཞུང་བརྩམས།",
    "རྗེ་རང་ཉིད་ཀྱིས་ཕྱག་བཟོ་མཛད་དེ་སྐུ་གཟུགས་བཞེངས།",
    "འཕགས་ཡུལ་མངོན་སུམ་མཐོང་བཞིན་བྱས།",
    "ཉམས་འགྱུར་འབུམ་གྱིས་ཁྱད་པར་བྱས།",
    "སྐུ་གཟུགས་ཐིག་རྩ་དང་།",
    "ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་དུས་སུ་དར་ཞིང་རྒྱས་པར་མཛད་དོ་ཞེས་གསལ་བ་ལྟར།",
    "དེའི་བཞུགས་ཁང་དང་མཆོད་གནས་སུ་ལྷ་ས་ན་མཁར་བྲག་དང་།",
    "དེ་ཡན་ལ་སྐྱིད་པའི་གདུང་རབས་ཕྱེད་དང་བཅུ་སྟེ་མི་ལོ་ཉིས་བརྒྱ་བཅུ་དྲུག་ཙམ་གྱི་རིང་ལ་གཙུག་ལག་ཁང་སྟོང་རྩ་བརྒྱད་བཞེངས་པར་གྲགས་སོ།",
    "བཟོ་བོ་རྣམས་ཀྱིས་རྟེན་གསུམ་བཞེངས་མི་ཕོད་ཀྱང་ཐབས་ཀྱི་སྒོ་ནས་རིག་དངོས་གཙོ་ཆེ་བ་རྣམས་བདག་སྲུང་བྱས་པ་ཡིན་ཏེ།",
    "ཁྱད་པར་བཟོ་དངོས་ལ་ཉམས་ཆག་ཆེན་པོ་བྱུང་བས་བོད་བཟོའི་རབས་ཆད་ཐོག་མ་ཞེས་བྱའོ།",
    "རྒྱ་དཀར་ནག་སོགས་ནས་རྟེན་ཁྱད་པར་ཅན་མང་པོ་དྲངས།",
    "སྤྱི་ལོར་༡༤༩ ལོར་རྗེ་བཙུན་ཙོང་ཁ་པ་ཆེན་པོས་དགའ་ལྡན་རྣམ་པར་རྒྱལ་བའི་གླིང་སྒྲུབ་མཆོད་ལྷ་ཁང་བློས་བསླངས་དང་བཅས་པ་བཞེངས།",
    "ཁྱད་པར་དུ་བྲག་ཕུག་ཨང་༣༦༥ པའི་ནང་དུ།",
    "སྐུ་གཟུགས་སྤྱན་ཕྱེས་ཏེ།",
    "གུང་གུ་རྨེ་རུ་ཞེས་པར་བོད་བཙན་པོའི་གཙུག་ལག་ཁང་ཞིག་དང་།",
    "གླང་ཡུལ་རིང་པོ་གསུམ་པར་སླེའུ་འཕྲུལ་ཀྲེའི་གྱི་དང་།",
    "དེ་ནས་རྗེ་བཙུན་ཙོང་ཁ་པ་ཆེན་པོ་ཞལ་བཞུགས་པའི་སྐབས་ཤིག་ཏུ།",
    "གོང་མ་ཆན་ལུང་ཁྲི་ལོ་བཅུ་གསུམ་པར་རྒྱ་ནག་ནས་དཔོན་པོ་གཉིས་དང་།",
    "དེ་བཞིན་དུ་གཙང་བཀྲ་ཤིས་ལྷུན་པོ་ལ་དཔེ་བླངས་ནས་བཀྲ་ཤིས་ལྷུན་པོ་དགོན་བཞེངས་པ་དང་།",
    "བསམ་ཡས་གཙུག་ལག་ཁང་ལ་དཔེ་བྱས་ནས་ཕུ་ཉིན་དགོན་སོགས་བཞེངས་པ་ཡིན་པས།",
    "ཁ་དོག་སོགས་ཀྱི་རྩལ་ལྷག་པར་ཐོན་པ་ཙམ་ལས།",
    "ཡུལ་དང་མི་ལ་སོགས་པ་གནས་པའི་བསྐལ་པ་ནས་བྱུང་བར་བྱས་ན་ཡང་ལུགས་དང་རིག་པའི་གནོད་པ་མེད་ཅིང་ཞེས་སྤྱི་ཁྱབ་ཏུ་གསུངས་ནས་དེབ་ཐེར་སྔོན་པོ་ལས་ལུང་འདྲེན་མཛད་པ་ལྟར།",
    "དུར་ཁྲོད་སློག་པ་སོགས་ཀྱི་གོམས་སྲོལ་མེད་པས་དེ་ལྟར་བྱས་ན་རྣམ་རྟོག་ཟ་ངེས་ཤིང་།",
    "ལྷ་བོ་ལྷ་སྲས།",
    "ཆེ་ཆུང་སྲབ་མཐུག་ལ་སོགས་ཁྱད་བྱས་པས།",
    "བདེ་འགྲོ་མཐོ་རིས་སུ་ཐོབ་པར་འདོད་དོ།",
    "དགེ་ལེགས་དང་དཔལ་བསྐྱེད་ནས་མི་ནོར་རྒྱས་པར་བྱེད།",
    "ཟག་བཅས་ཀྱི་མངོན་ཤེས་འཆད་པར་བྱེད་དོ།",
    "དེའི་གོང་ནས་ལག་རྩལ་མི་དམན་པ་ཞིག་ཡོད་པ་རང་བཞིན་གྱིས་ཤེས་པར་འགྱུར་རོ།",
    "ཐ་ན་པི་སྨྱུག་འཛིན་སྟངས་ཚུན་ཆད་ཀྱི་ཁྱད་པར་ཡོད་ཅིང་།",
    "དོན་གང་ཡིན་ནི་མ་མཁྱེན་ཏེ།",
    "མི་ལོ་བརྒྱ་དང་ཉི་ཤུའི་བར་དུ་བཞུགས་ཤིང་།",
    "རྒྱལ་པོས་ཡི་གེ་མི་ཤེས་ཤིང་དོན་མི་གོ་བས་པཎྜི་ཏ་དང་ལོ་ཙཱ་བ་ཕྱིར་ལོག་ཅེས་གསུངས་པར་འགོས་ལོ་གཞོན་ནུ་དཔལ་གྱིས།",
    "ཁྱེད་ཀྱང་ནར་མ་སོན་པས་ངས་འདི་ན་བོད་ཀྱི་རྒྱལ་རབས་དགུ་ཡི་བར་དུ་སྒུག་ཅིང་བསྡད་པ་ཡིན་གསུངས་པ་རྦ་བཞེད་གཙང་མ་ན་སྣང་བའི་ཕྱིར་ཏེ་བོདྡྷི་ས་ཏྭཱ་བློ་སེམས་སུ་ཐི་སེས་བསྒྱུར་འཚོ་ཞེས་པ་ཞི་བ་འཚོ་དང་འབྱོར་བས་སོ་ཞེས་དོན་དུ་མཁན་ཆེན་ཞི་བ་འཚོས་བོད་དུ་བསྣམས་ནས་ཕེབས་པ་ཡིན་པར་འདོད་པ་དང་།",
    "དེ་ནས་རིང་པོར་མ་ལོན་པར།",
    "རྒྱལ་པོས་བདག་ལྷ་ས་དམར་པོ་རི་ལ་འགྲོ་ན་འགྲོ་དོན་འབྱུང་ངོ་གསུངས་ནས་རྒྱལ་བློན་འཁོར་དང་བཅས་ཏེ་ཡུལ་ལྷ་ལྡན་གྱི་ཕྱོགས་སུ་ཆིབས་ཀྱི་ཁ་ལོ་བསྒྱུར།",
    "ལམ་བར་ཡང་ཕྲེང་ཡར་འཕྲང་ཞེས་བྲིས་པའང་སྣང་བྱ་བར་ཐམས་ཅད་བྲོ་བཏབ་སྟེ་རྒྱལ་པོས་ཆབ་ལ་སྐུ་ཁྲུས་གསོལ་པར།",
    "རྒྱལ་པོ་ལ་འདི་ཅི་ལགས་ཞུས་པས།",
    "ངོ་མཚར་ཅན་ཞིག་དེ་ན་བཞུགས།",
    "རྣམ་པར་རྒྱལ་བའི་ཁང་བཟང་ལྟར་ལེགས་ཤིང་ལྟར་མི་ངོམས་པ་ཉི་མའི་དཀྱིལ་འཁོར་ལྟར་བརྗིད་ཅིང་རྔམ་པ་ཞིག་བརྩིགས་སོ།",
    "མེས་ཨག་ཚོམ་གྱི་སྐུ་རིང་ལ་བཞེངས་པར་སྣང་བས།",
    "ཞེས་བྱུང་བ་དེ་ཁུངས་བཙན་པར་འདོད་པས།",
    "རྒྱལ་པོ་རང་ཉིད་ཀྱང་མཚོ་ཁར་ཕེབས་ཏེ་ཐུགས་ཀའི་འོད་ཟེར་མཚོ་ལ་ཕོག་པས་དབུས་སུ་འོད་ཀྱི་མཆོད་རྟེན་ཆགས་པ་ལྟར།",
    "ཁྲོ་ཆུའི་གཞི་ལ་སོ་ཕག་བཀྲམ་པས་གཡོགས་རྡོ་རྗེའི་ས་གཞི་ལྟ་བུར་གྲུབ་པའི་སྟེང་རྩིས་རྨང་འདིང་བར་མི་མ་ཡིན་གྱིས་བཤིག་པས་རྩིག་ཏུ་མ་ག་ཏུབ་པར་ཐོག་མར་རྒྱལ་པོ་རང་ཉིད་ཀྱི་སྐུ་འབག་ཅིག་བཞེངས་ཤིག་ཅེས་པའི་ནམ་ས་མཁའ་ནས་སྒྲ་བྱུང་བ་བཞིན།",
    "ཁྱད་པར་འཕགས་པའི་རྫས་མཆོག་དུ་མ་དང་།",
    "ཙནྡན་སྦྱར་བའི་ལྡེ་གུ་ཕུང་པོར་བྱས་པ་སོགས་སྐུ་གཟུགས་བཞེངས་པའི་རྒྱུ་ཆས་ཐམས་ཅད་རྒྱལ་པོའི་སྤྱན་སྔར་བསགས་པ་ལ།",
    "དེའང་བོད་ཁ་བ་ཅན་གྱི་ལྷ་སྐལ་ཐུགས་རྗེ་ཆེན་པོའི་རིགས་ལྔ་བཅུ་རྩ་གཅིག་ལས་གང་བཞེངས་ན་དྲག་དགོངས་པ་ལ།",
    "ཞེས་གསུངས་པ་བཞིན་ལ།",
    "བྱང་དང་ཤར་གྱི་བཟོའི་ཁྱད་པར་འབུར་སྐུ་བརྟག་ཐབས་ལས་ཤེས་པར་བྱའོ།",
    "ཁྱད་པར་གཙུག་ལག་དང་རྟེན་བཞེངས་ཀྱི་བྱ་བར་འཚེ་བ་བྱས་པར།",
    "དེ་གཉིས་ཀྱི་གཟུགས་གྱིས་ཤིག་གསུངས་པ་བཞིན་རྟ་མགྲིན་དང་བདུད་རྩི་འཁྱིལ་བ་གཉིས་ཀྱི་གཟུགས་བྱས།",
    "དེར་གནས་པའི་ཀླུ་རྩེ་ལྔ་པ་གདུག་པ་ཅན་གྱིས་གེགས་བྱས་པ་བཏུལ་ཏེ་གཙང་ཁང་ཁྲོ་ཆུའི་ཕ་གུས་ཕུབ།",
    "ཕྱོགས་བཞིར་གསང་ཁུང་བཞི་སྒྲོམ་དུ་བྱས་པའི་སྒྲོམ་ཁར་མཆོད་རྟེན་བརྩིགས།",
    "གཞན་བཞི་དང་རྒྱལ་པོའི་སྐུ་འབག་གཙང་ཁང་ན་བཞུགས་སུ་གསོལ།",
    "རྐང་མཐིལ་གཡས་ལ་ཧོར་གྱིས་ལག་དཔོན་བྱས་ཏེ་མཚལ་རིགས་སྒྲོལ་མ།",
    "དེ་ནས་རྒྱལ་པོས་ལྷ་ཁང་བརྩིག་པ་ལ་བགེགས་མེད་པར་དགོངས་ནས་རྗེ་བློན་ཀུན་མཚོ་བསུབས་པའི་སྟེང་དུ་བྱོན་ནས་ས་གཞི་བྱིན་གྱིས་བརླབས་ནས་ཐིག་གདབ་བོ།",
    "ཐམས་ཅད་སྤྲུལ་པ་ཡིན་པར་ཤེས་ཏེ།",
    "དེ་ལྟར་རྒྱལ་པོས་སྤྲུལ་པ་མཛད་པས་ཉིན་ཞག་བཅུ་གཉིས་ནས་ར་སའི་འོག་ཁང་ཡོངས་སུ་རྫོགས་པ་ཟིན་པར་བྱས་སོ།",
    "ཀ་བ་ཕུར་བའི་རིས་སུ་བྱས་པས་སྔགས་པ་དགའ།",
    "ཟུར་བཞི་གཡུང་དྲུང་རིས་སུ་བྱས་པས་བོན་པོ་དགའ།",
    "དེ་ལྟར་རྫུ་འཕྲུལ་གྱི་སྒོ་ནས་བཞེངས་ཤིང་ཀུན་དགའ་བར་བྱས་པ་སྟེ་དགའ་བཞི་འཕྲུལ་གྱི་གཙུག་ལག་ཁང་ཞེས་ཡོངས་སུ་གྲགས་པ་ཡིན་ལ།",
    "གསེར་གྱི་གཎྜིར་འོད་འབར་བས་སྤྲས་པ་བྱས་སོ།",
    "རྒྱའི་སོ་ཁར་ཕྱིར་འཕུལ་བ་དང་རྒྱུ་རྗེ་ལ་ཞལ་གྱིས་བཞེས་པ་ཆད་བཙན་པར་བྱ་བའི་ཕྱིར།",
    "བློན་པོ་གཡུལ་དུ་བཞུགས་རིང་འབྲལ་མེད་དུ་བྱས་ཤིང་།",
    "སྐྱུ་ར་ལྷ་ཆེན་གྱིས་བལ་བཟོ་གཞིར་བྱས།",
    "རྒྱན་གོས་སོགས་བོད་དང་མཐུན་པར་བྱས་པས།",
    "བོད་བཙན་པོ་གཙོ་བོར་གྱུར་པའི་གོང་སྨྲས་དམ་པ་རྣམས་ཀྱིས་བཀའ་དྲིན་ལ་བརྟེན་ནས་བསིལ་ལྡན་གྱི་ལྗོངས་འདིར་འཕགས་ཡུལ་གྱི་བཟོ་རྒྱུན་གཙོ་བོར་གྱུར་པའི་བཟོ་རྩལ་དར་ཞིང་རྒྱས་པར་གྱུར།",
    "རབ་རྣམས་ཀྱིས་མཁའ་འགྲོ་མ་རྣམས་ཀྱིས་སྤྱན་དྲངས་ཏེ་ཤར་ཕྱོགས་པད་མ་གླིང་དུ་བཤེགས་པར་མཐོང་།",
    "རྒྱལ་པོ་ཡང་འོད་དུ་ཞུ་ནས་རང་བྱུང་བཅུ་གཅིག་ཞལ་ལ་ཐིམ་པར་མཐོང་།",
    "དེ་ལྟར་འགྲན་མེད་རྒྱལ་བའི་སྐུ་གཟུགས་འདི།",
    "དེ་ནས་དར་གདུགས་གསེར་གྱི་ཏོག་ཅན་ལ་སོགས་ཀྱིས་མཛེས་པར་སྤྲས་པའི་ཤིང་རྟ་ལ་བཞུགས་སུ་གསོལ་ནས་གྱད་ལྷ་དགའ་དང་ཀླུ་དགའ་གཉིས་ཀྱིས་སྣ་དྲངས།",
    "གཙུག་ལག་གཉིས་གྲུབ་ནས་རྒྱལ་པོ་གདན་དྲངས་པར་རྒྱལ་པོ་རབ་ཏུ་དགྱེས་ཤིང་ཕྱག་ཏུ་མེ་ཏོག་བསྣམས་ནས་རབ་ཏུ་གནས་པའི་བདེན་ཚིག་དང་ཤིས་བརྗོད་མཛད།",
    "རྒྱ་དམག་དཔུང་དང་བཅས་པ་ལྷ་སར་ལྷགས་ནས།",
    "བློན་པོ་མགར་གྱི་བུ་ཆེ་བས་དམགོ་དཔོན་བྱས་ཏེ་རྒྱུ་དམག་ཕམ་པར་བྱས་པ་དང་།",
    "སྐུ་གཟུགས་དེ་ད་གཟོད་ཤཱཀྱ་མུ་ནི་མིན་པར་ཤེས་པ་སོགས་ཀྱིས་དེར་བོར་བས།",
    "རྒྱལ་པོའི་དགོངས་པར།",
