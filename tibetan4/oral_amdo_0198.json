    "པགས་པ་སླང་དྲེག་སྟེ་ནག་མོ་ཕ་བ་དགོ་དགོ་དུད་པ་བྱ་བལ་མར་གསར་བྱུགས།",
    "རྒྱམ་ཚྭ་ཚ་བ་གསུམ་ཞུན་མར་རྐང་མར་ལ་རེ་བལ་བཙོས་ལ་གླན།",
    "ལྡོང་རོས་རྒྱ་སྐྱེགས་བཙོད་བ་བླ་ཡུང་སྐྱེར་སྦྲང་སྦྱར་དྲུག་མགོའི་རྨེན་པ་སྐྲ་ལོ་སྐྱེ་བར་བྱེད་པ་ལ་བ་ལང་གི་རྨིག་པ་སྤུ་པགས་ཐལ་བ་ཏིལ་མར་སྦྱར་བ་བྱུག་གོ།",
    "དེ་བཞིན་རྐང་བཞིའི་སེན་མོ་སྤུ།",
    "རྨ་སྤྱིར་ཟས་སྤྱོད་ནས་རེད་འབྱོངས་ཟས་བཅུད་སྤྲུག་གི་བར་ཏེ།",
    "ཤིང་བྱང་གིས་བསྡམ།",
    "ཡན་ལག་ཤ་རྔམ་ཆེ་སར་ཐུར་དུ་ཕུག་ཕུག་ཆེས་ཚེས་ན་རྨ་ལ་ཤེལ་ཏའི་རེང་བུ་གཞུག་རྒྱབ་ནས་ཆུ་ལྕག་བྱ།",
    "འདི་དག་ནི་རྗེ་གཡུ་ཐོག་པ་རང་གི་མཆན་ལྟར་ཡིན་ལ།",
    "དང་པོ་ནི་དྲང་སྲོང་ནས་ཉོན་ཅིག་གི་བར་རོ།",
    "འདི་དག་ནི་ཀླད་པའི་མཁྲུང་སླ་དང་ཚོ་ཟིན་མི་ཟིན་ལས་བདུན་དུ་བཞག་སྟེ་ལུས་ཁམས་ཀྱང་དེ་མཐུན་དུ་ལྟའོ།",
    "ཕལ་ཆེར་གོང་དུ་བསྟན་པ་ལྟར་ཡིན་མོད།",
    "རུས་དམིགས་ཕོ་མོ་མ་ནིང་གསུམ་སྤྱིར་བསྟན་པ་དང་།",
    "གདུང་ནི་སྟེང་འོག་གི་མཁྲེགས་པ་གཉིས།",
    "དང་པོ་གཉན་གྱི་རེ་ཐག་རྣམ་བཞི་དང་།",
    "གཉན་གྱི་རེ་ཐག་བཞི།",
    "ཚངས་པའི་སྐུད་པ་གསུམ་མོ།",
    "རྣ་བ་ལ་སྙན་ཞེས་ཞེ་ས་སྦྱར་བ་དེའི་རེ་ཐག་ལྟ་བུའི་རྩེ་བཞི་ནི།",
    "རྒྱབ་ཏུ་སོར་བཞི་འཇལ་བ་ལྟག་པའི་འདུས་སོ་སྟེ་གསུམ་མོ།",
    "སྤྱི་གཙུག་ཏུ་ཚངས་བུག་སྐྲ་མཚམས་ནས་སོར་རེ་འཇལ་བར་མཚོགས་མའི་སྒོའམ་གནམ་འཐེན་གཉིས།",
    "ཞེས་རྣ་བའི་རྩེ་མོ་དྲང་ཐད་ཀྱི་རྒྱབ་ཀྱི་ལྟག་པའི་སྡུད་སྒོ།",
    "དེ་ནས་གཡས་གཡོན་ཚོན་རེ་འཇལ་བ་གཉིས་ཏེ་སྡུད་སྒོ་ཁ་གསུམ་སྨིན་མའི་དཀྱིལ་གཉིས་མཁུར་ཚོས་ཀྱི་རུས་པ་བྱ་སྒོང་གི་དབྱིབས་ཅན་ནི་མཁུར་ཚོས་སྒོ་ང་སྟེ་དེ་གཉིས་སུ་བྱུང་།",
    "ཁྱི་ཉལ་གཉིས་བཞིའི་མཐེབ་ཚོན་སྒོར་མོ་མཐེབ་ལོང་གང་ནི་སྡུད་སྒོ་བཞིའོ།",
    "རེག་བྱ་རྨ་ལ་བརྟག་པ།",
    "གཤོང་མོར་བརྐོས་པ་དང་གཏམ་ཟུག་མདེའུ་ལུས་པའམ་ཕུག་པ་གསུམ་བརྟག་གཉིས་པ་ནི་གྲི་ལ་གཞོག་དང་རྫོགས་པ་བཅད་པ་གསུམ།",
    "དེ་རྣམས་ནས་ལྗིད་མེད་བརྟག་གི་བར་རོ།",
    "དང་པོ་ནི་རེག་བྱ་རྨ་ལ་བརྟག་པ་ཡོད་མེད་གཉིས།",
    "དང་པོ་ནི་རྨ་མེད་པ་ལ་འགྲམས་དང་ཆག་པ་གཉིས་ཞེས་འགྲམས་ཆག་གཉིས་ལས་དང་པོ་ལ་གསུམ་སྟེང་གི་སྲུབས་བར་གྱི་ཀླད་རྒྱ་འོག་གི་མཚོ་འགྲམས་པའོ།",
    "ཞེས་པའི་ཨ་བྱག་ནི་སྤང་གི་གུར་ཀུམ།",
    "གཏིང་སྐྱོན་ནི་བྱེར་ལྷུང་གི་སྐྱོན་ཡོད་པའོ།",
    "ཤ་བྱེར་གྱི་རེ་ཐག་བཞི་ནི་གཙུག་གི་ཕྱོགས་བཞིའི་རེ་ཐག་བཞིའོ།",
    "གཞན་ཡང་ནས་དཀར་པོར་སོང་བར་བསྲེག་གི་བར་ཏེ།",
    "ཤ་རོ་དང་རུས་རོ་ལ་ནི་སྲེག་ནན་བསྐྱེད་དེ་དཀར་པོར་སོང་གི་བར་དུ་བསྲེག་གོགསུམ་པ་ནི།",
    "སྐྱོན་ཚབས་ཆེ་ན་རྟ་རེས་ཤིང་སྒབ་པ་ལྟ་བུར་སྐོར་ཞིང་དྲས་ནས་ཤ་གདན་དང་བཅས་པ་མཁྲེགས་ཤིང་སོ་ལེབ་ཀྱིས་བསལ་ལོ།",
    "ལྷ་ཁྲག་གཅོད་སྡོམ་བྱེད་པ་ནི་རེས་འབབ་རེས་མི་འབབ་པའོ།",
    "གསེང་ཕུག་གི་བྱེའུ་ནས་ཟན་ནི་བྱིའུ་རྒྱབ་དངུལ་ཁ་མདུན་དམར་པོ་ཀྲུགས་ལ་བྱི་བྱུང་ཟེར་བ་དེའི་མིག་ཙམ་དུ་ཕུག་དེ་བས་ཆེས་ན་ཀླད་པ་སྦོ།",
    "གི་རྐང་མགོ་བརྡུངས་པའོ།",
    "གཉིས་པ་ནི་རྨ་ཅན་གས་སྣ་རིང་ཐུང་ལྷ་ངོ་སྤྲད་ཅེས་པ་ནས་མདེའུར་བཅས་པ་ག་ལེ་དབྱུང་གི་བར་ཏེ།",
    "སྒོང་རྡོལ་ལ་སོང་ན་མཐའ་མའི་རུས་པ་ཆག་པ་ཁོད་སྙོམས་པར་བདར།",
    "སོག་པའི་མཐིལ་སྲབ་མོ་དེ་རྨ་བུག་ལས་དཀྱུས་རིང་ཙམ་ཞེང་ནང་དུ་ཤོང་ཙམ་བྱས་ལ།",
    "རུས་པ་དང་ཀླད་པ་གཉིས་ཀྱི་བར་དུ་སྒལ་གྱི་སྒོ་འཇུག་པ་བཞིན་དུ་གཞུག་ཤའུ་འཕགས་པ་དང་རུས་ཚབ་ཇེ་ཕྲ་ཇེ་ཕྲ་གཞོག་ལ་ཕྲ་མོར་སོང་བ་བ་དང་འདོན།",
    "ཕར་གནོན་ཕྱུངས་རྗེས་རྨ་ལ་སྟོང་གཟེར་འོང་བས་རེ་བལ་གྱི་གཟེབ་བཏང་ངོ།",
    "ཀླད་པའི་བཅོས་ཐབས་མཚོ་འཁྱོམས་སྤྲིས་བཙན་དང་།",
    "ཞེས་པས་ཀླད་པའི་བཅོས་ལ་མཚོ་འཁྱོམས་པ་སྤྲིས་བཙན་པ་དར་རལ་བ་ཕུག་པ་རྫོགས་ནས་ལུག་པ་ལྔའོ།",
    "ཀླད་ནི་རི་དྭགས་ར་ལུག་གིའོ།",
    "སྤྲིས་བཙན་ཞེས་པ་རྒྱུ་དར་གོང་འོག་གི་ཀླད་སྤྲིས་མཚོན་ནམ་རུས་མཛེར་གྱིས་བསྣད་པའོ།",
    "གུར་ཀུམ་གི་ཝང་འོ་མ་འཛིན་འོམ་བུའི་བར་ཤུན་བུ་རམ་ནུ་ཞོ་ཞོ་དར་དར་ལ་ལ་བྱུག་པ་གླན།",
    "བདུད་རྩི་དཀར་པོ་ནི་རི་བོང་གི་ཆུ།",
    "རེ་རལ་ནི་བཙུན་མོ་རེ་རལ་ཏེ་བྲག་སྤོས་གསེར་གྱི་ཐིག་ཁྲབ་ཅན་དེའོ།",
    "ཅོ་ག་སྲེ་མོང་གི་ཀླད་པ་རྣམས་ཆུ་ལ་སྦྱངས་པའི་དྭངས་མ་གྲིབ་སྐམ་བྱས་པ་དང་།",
    "མཐའ་མ་ནས་རེ་བཞག་ནས་བྲུས་པས་གསེང་བུག་ཏུ་ལྕགས་གཡའ་བྱུང་ན་དབྱུང་བའི་དུས་སོ།",
    "ཞེས་པ་རྩེ་མོ་དང་ཕྱོགས་བཞིར་བུག་པ་རྒྱ་ཁབ་མིག་ཙམ་ཅོལ་ལེ་བྱ་ཁ་ཁྱེར་པད་མ་ལྟར་ཕྱོགས་བཞིར་གས་པ་བྱ་དྲི་ཆུར་བཙོས་ལ་དུག་ཕྱུང་རྩི་བྱུག་གསོན་གཤིན་མཚམས་སུ་སླེབས་པར་བསྐྱལ་ཞེས་པ་གོང་གི་ཀླད་པ་སྡོམ་པའི་རྩི་བྱུགརིང་ན་ཀླད་པ་ཟ།",
    "ཐེམ་བུ་རུས་པའི་བར་དུ་གྲོ་གས་བསྡམ་ཞེས་པ་ཞ་ཉེའི་ཐེམ་བུ་དང་རུས་པའི་བར་དུ་གྲོ་གས་དཀྲི་ཞིང་བསྡམ་མོ།",
    "ཕག་མགོ་རྡོ་ཕག་མགོ་སྟེ་ཕག་མགོའི་དབྱིབས་ཅན་དམར་སེར་གྱི་སུལ་རིས་ཡོད་པ་དྲི་མནམ་མོ།",
    "ཨ་བྱག་ནི་སྤང་གི་གུར་ཀུམ།",
    "རེ་སྐོན་པ་རྩི་དམར་ཟིལ་ལ་བ་བ་ཅན།",
    "རྩ་རྒྱུད་གོང་འོག་བསྲེགས་པའི་རིང་སྒོ་ནི་རྩ་དེའི་མགོ་མཇུག་གི་རྩ་སྣ་ཉེ་སྒོ་ནི་རྨའི་སོར་བཞིའོ།",
    "འབྲི་རྐང་བདུན་གསུམ་ནི་བ་རུ་རའི་ཚིག་གུ་བདུན་ནམ་གསུམ་མོ།",
    "མོན་ཆ་ར་ནི་བེ་ནག་ཁྲག་གོ།",
    "ནང་དུ་ཤོར་ན་རྩ་བུག་ཀམ་ཧུ་རེ་འོང་།",
    "རྒྱ་ཚྭ་བྱང་བ་རེ་རལ་སྡིག་སྲིན་མཚལ་ཨ་རུ་ར་ཉི་དགའ་པི་པི་ལིང་དྲི་ཆུ་སྦྱར་བའི་སྣ་སྦྱོངས་བཏང་།",
    "ཡང་རྩི་གསུམ་ནི་གུར་ཀུམ་དོམ་མཁྲིས་སྤུ་འབྲུ་གསུམ་མོ།",
    "བཞི་པ་ཤ་རུས་རྩ་ཀླད་རང་རང་གི་རྟགས་བཅོས་བཅུ་གཉིས་ལས་དང་པོ་ནི།",
    "དང་པོ་ནི་བྱེར་ལ་སྐྱི་བྱེར་བ་དང་ཤ་བྱེར་གཉིས་ཞེས་སྐྱི་ཤ་གཉིས་ལས་དང་པོ་ནི་སྐྱི་བྱེར་ནས་བྱུག་གི་བར་ཏེ།",
    "སླང་དྲེག་གསུམ་མོ།",
    "སྤུ་དེབ་ནི་རི་བོང་གི་སྤུ་ལ་བྱའོ།",
    "ཁོང་དུ་རི་ཀླུང་གི་རྟ་པགས་གཉིས་བཏང་།",
    "ལྷ་ཞོ་སྟེ་གངས་ཐིགས་རྡོ་བེ་སྣབས་རྡོ་མཁྲིས་དོམ་མཁྲིས་རེ་རལ་ཁུར་ཞོ་ཅུ་གང་སྦྲང་གི་ལྡེ་གུ་བྱུགས།",
    "ཁྲག་གསུམ་ནི་བུ་མོ་ལོ་ཉི་ཤུ་ལོན་པ་ལུག་དང་གཡག་གསོན་ཁྲག་གོ།",
    "ཕྱི་ནས་དུགས་ནི་གོ་སྙོད་ལྕམ་འབྲུ་མར་ནག་གིའོ།",
    "རྩི་གསུམ་ནི་ཅུ་གང་གུར་ཀུམ་གི་ཝང་ངོ།",
    "སྔོ་ལྔ་ནི་རེ་རལ་བྲག་སྤོས་འབྲི་ཏ་ས་འཛིན་ལུག་མིག་ལྔའོ།",
    "ཕྱེ་མ་ནི་ཅུ་གང་གི་ཝང་ཨུཏྤལ་རྒུན་འབྲུམ་སྲོ་ལོ་དཀར་པོ་ཀ་ཀ་ར་ར་སྦྱར་བ་བཏང་།",
    "ཕྱེ་མ་གུར་ཀུམ་འབྲི་རྐང་ཀཎྜ་ཀ་རི་པ་ཏོ་ལ་བཞི་པ་སྦྱར་དགུ་པ་དང་གུང་མོ་བསྲེག་མཆེ་བར་བབས་ན་སྦོ་སྒྲེག་བྱེད་མཆུ་འཕྱང་ལུས་གྱོང་དེ་ལ་ལི་ཨུཏྤལ་མ་ནུའི་ཐང་བཏང་།",
    "གཞན་ཡང་ཁྲག་ཤས་ཆེ་ན་རང་རང་གི་རྩ་ལ་གཏར་བ་སོགས་སྤྱི་འགྲོ་ལྟར་བྱའོ།",
    "ཤིང་ཀུན་གསུམ་པ་ནི་ཤིང་ཀུན་ཁ་རུ་ཚྭ་སྒ་གསུམ་མོ།",
    "ཞ་ཉེ་སྲབ་མོས་མནན་ནོ།",
    "དེ་ལ་རྒྱ་ཚྭ་ཕུར་མོའི་ལོ་མ་རྟ་རུ་སྟར་བུ་རུ་རྟ་གདབ་ཞག་གཅིག་ལྟོ་བཀུག་ལ་ཀླད་ཉུལ་བཏང་།",
    "སྣ་ནས་ཁྲག་དབྱུང་ལྕེ་འོག་གི་རྩ་གཉིས་ལ་གཏར།",
    "རྒྱ་དཀར་གསང་གི་གནས་ལུགས་བསྟན་པའོ།",
    "གློ་སུལ་རེ་དང་རྩིབས་རེ་ཡོལ་གྱིས་བཅད་ནས་ཡོད།",
    "ཅེས་བྱང་ཁོག་སྟོད་དང་སྨད་ཀྱི་ཡུལ་སྐལ་ཐིག་གིས་བཙལ་བ་ནི།",
    "ཞེས་ཚིགས་པ་བཞི་ནས་ཚིགས་པ་གསུམ་པའི་ཐད་དྲང་དུ་གྱེན་དུ་གསེག་པ་མཛུབ་མོ་བཞི་ཁུ་ཚུར་བཅངས།",
    "དེ་སྟེང་མཐེ་བོའི་ནེའུ་ལེ་རེག་ཙམ་པ་དེ་ལ་ཆག་པའམ་ཕྱག་ཅེས་བྱ་བ་དེའི་སྲིད་གང་བཅལ་བའི་ས་དང་།",
    "ཞེས་དེ་ལྟར་ཐིག་གིས་བཙལ་བའི་ཚིགས་པའི་འི་གཞུང་ར་ཐིཐིག་དབུས་སུ་བཞག་པའི་སྟོད་ཀྱི་གཡས་གཡོན་གྱི་གྲ་གཉིས་སྟག་མགོའི་ཡུལ།",
    "དེ་ཡང་མོ་ལ་གཡས་ཕོ་ལ་གཡོན་དུ་བསྟན་ཟེར།",
    "ཡུལ་ཐིག་དེའི་མཐའ་མ་དཔུང་བ་ཕྱོགས་ནི་སྟོང་པར་གནས་པ་དེ་ལ་ནི་ཕུག་རོན་གྱི་གསང་དང་སྟོད་གསང་ཕྱལ་མོར་གྲགས་སོ།",
    "ཐིག་གིས་བཙལ་བ་དང་ངོ་བོའི་ཡུལ་ལོ།",
    "ཚོན་གང་གྲུ་མོས་གར་སླེབ་ཅེས་སྨོས་ཏེ་མདུན་གྱི་ལྷན་རུས་དབུས་དང་།",
    "རྒྱབ་ཀྱི་ཚིགས་པ་བརྒྱད་པ་ནས་གཡས་ངོས་སུ་ཚོན་གང་བཅལ་བ་ནས་ལག་གཡས་རྣ་ཤལ་དུ་མཐེབ་མཛུབ་རྩེས་བཟུང་བའི་གྲུ་མོས་རྒྱབ་དང་འོག་ཏུ་གང་སླེབ་པ་དེ་ཚུན་ནོ།",
    "ཞེས་རྩིབ་ཐུང་ནི་རྩིབ་མའི་འོག་ཐག་པ་གཡོན་པ་དེའི་སྣ་ནས་ཕོ་ཟུར་དུ་རང་གི་མཐེབ་མཛུབ་བསྐྱངས་པའི་མཛུབ་གང་བཅལ་བའོ།",
    "ལྟེ་བའི་གོང་འོག་ཚོན་རེ་དཀྱུས་ཚོན་བརྒྱད།",
    "ལོང་གི་ཡུལ་ཡིན་ཁྲག་ལོང་གཡས་ན་གནས།",
    "ཞེས་ལྟེ་བའི་གོང་འོག་ཏུ་ཚོན་རེ་བཅལ་བའི་བར་དཀྱུས་སུ་ཚོན་བརྒྱད་ནི་ལོང་གི་ཡུལ་ཡིན་ལ།",
    "བུད་མེད་ཚིགས་པ་བཅུ་གསུམ་པར།",
    "འདུས་པ་མོ་ཡི་མཚན་མར་འབྲེལ།",
    "ལོ་འདབ་ཕྲ་མོའི་གྱེས་ཚུལ་དཔེར་བརྗོད་པའོ།",
    "ལྟེ་འོག་དང་སྐེ་སྟོང་ཐད་ནི་རྩའི་ཕྲ་སྦོམ་མཚམས་ཡིན་པས་སྣེ་མོར་བཞག་ལ་ཕྲ་བའི་རྩ་སྣ་ནི་སྟོད་སྨད་ཀུན་ཏུ་གྱེས་སོ།",
    "འདུས་པ་ཕོ་མོའི་མཚན་མར་འབྲེལ།",
    "དྲང་པོར་གཅིག་གི་རྒྱུས་པ་ནི།",
    "ལག་པ་གཡས་གཡོན་དུ་ལྟ་རྩ་རེ་དང་བླ་རྩ་རེ་རྒྱུ་ཚུལ་ནི།",
    "དེ་ནས་ཕྱིར་ལ་ཕུན་རེ་བཅལ་བ་ན།",
    "རེ་ཐག་བཞི་ནི་རྣ་བའི་ཕྱི་ནང་ནས།",
    "ཚངས་པ་དུང་གི་འཁོར་ལོའོ།",
    "སྣེ་སར་ཐོན་ནས་པུས་མོར་འདུས་པ་ལ་སོ་མ་ར་ཛར།",
    "པུས་མོ་དག་ཏུ་ཕྲད་པ་ནི།",
    "ཞེས་སྲོག་ཀ་རྩ་རྩི་དཀར་དཀར་ནག་ནག་དེ་ལ་གྱེས་པའི་དོན་དང་སྣོད་ཀྱི་ནང་རྩ་རྣམས་ནི་འབྲེལ་འབྲེལ་མང་བས་སྡོམ་གྱིས་བུང་བ་འཛིན་པའི་རྒྱ་བྲེས་བ་ལ་བ་མོ་བ་ཐག་ཅེས་པ་དེ་འཛིངས་པ་དང་འདྲ་སྟེ་ག་ནས་ག་རུ་འབྲེལ་བའི་དོན་ནོ།",
    "ནུ་མའི་གཡས་གཡོན་ཚོན་རེར་ནུ་རྩ་ཡོད།",
    "ཚིགས་པའི་གཡས་གཡོན་ཚོན་རེ་ཕུན་རེ་ན།",
    "ཚིགས་པའི་གཡས་གཡོན་དུ་མཐེབ་ཚིགས་བཀུག་པའི་སེན་མོ་སྔོ་དམར་མཚམས་དང་ཚིགས་མགོ་བར་སོར་གཉིས་ཀྱི་ཡུལ་དེ་ཚོན་ཞེས་པ་དེ་རེ་དང་།",
    "དེའི་ཕྱེད་ལ་ཕུན་ཞེས་པ་དེ་རེ་རེའི་ས་ན་སྟོད་སྨད་ཀུན་ཏུ་རྒྱུ་སྟེ་བཞི་པའི་ཐད་ཀ་ནི་དོན་དམིགས་ཡིན་པས་དེར་གཉན།",
    "གཅིག་བརླ་ནང་དུ་བརྒྱུད་པ་ལ་བརླ་སྒང་སྟེང་གི་མཁལ་རྩ་རུས་ཞེན་ཞེས་བྱ་སྟེ་རྐང་པར་འབྲེལ།",
    "ཞེས་ནུ་མའི་མདུན་ངོས་ཚོན་རེ་ནས་སྒྲོག་ཆར་འགྲོ་བ་ན་སྐེ་སྟོང་ཕྱོགས་ཀྱི་སྒྲོག་རུས་འབྲེལ་མཚམས་སོ།",
    "ཕྱི་རྒྱུག་གི་དོན་ས་ནུ་མདུན་ཚོན་དོའི་ས་ནས་བྱུང་།",
    "ཚང་ཚིང་ལས་བྱུང་གློ་རྩ་དུང་འབུད་གཉིས།",
    "མཆིན་རྩ་ཤ་རུ་མོན་རུ་རྣམ་པ་གཉིས།",
    "སྦྲུལ་མིག་ལྷེན་སྣའི་གཡས་གཡོན་ཚོན་རེའི་སར།",
    "ལོང་རྩ་ལྟེ་ཟུར་གཡས་གཡོན་ཚོན་རེ་ན།",
    "ཞར་ལ་རྒྱུ་ལོང་ནང་རྩ་འཁྱོག་མཚམས་རྒྱུ་ཚིལ་འབྲེལ།",
    "ཞེས་མཚན་མ་སྟེ་རླིག་པ་དང་བུད་མེད་མོ་མཚན་དང་དབྲག་གམ་དཔྲག་དེའི་བར་གྱི་འོག་སྒོ་ངོས་སུ།",
    "ཅེས་རྒྱ་མཐོངས་སམ་རྒྱ་སྐར་ཕྱེས་པ་ལྟ་བུའི་གསང་གི་གནས་ལུགས་ལ།",
    "གསང་གི་ཚད་བསྟན་པ་དང་།",
    "མཆིན་དྲི་ཁུག་པ་ཁྲ་བོས་མཛུབ་རེ་ཐུབ།",
    "རྩེ་སོར་བཞི་བཞི་སོང་ཡང་དོན་མི་སླེབ།",
    "སྟོད་གསགསང་ཕྱལ་མོ་སྟེ་ཕུག་རོན་གྱི་གསང་ལ།",
    "མདུན་རྒྱབ་ཏུ་ཐལ་མོར་བཅུར་གྱིས་འབྱིན་ཐུབ།",
    "མཆིན་དྲི་ཁྲ་བོའམ་ཁུག་པའི་བར་དེར་མཛུབ་རེ་ཐུབ།",
    "ནུ་མ་གཉིས་ཀྱི་ཚོན་གང་གི་འོག་ཏུ་ནི།",
    "རྩེ་སོར་བཞི་སོང་ཡང་དོན་ལ་མི་སླེབ་བོ།",
    "སྨད་དུ་གར་ཡང་སོར་གཉིས་ཀྱིས་སྣོད་ལ་མི་སླེབ་སྟེ་བར་ཐག་དེ་ཙམ་རེ་ཡོད་པ་ཡིན་ལ།",
    "དེ་ནས་གཡས་གཡོན་གཉིས་སུ་ཚོན་རེ་དང་།",
    "ཕུན་རེ་བཅལ་བ་དཔལ་ཁབ་རང་གསང་ཡིན།",
    "དེའི་སྟེང་ཚོན་རེ་བཅལ་བ་བྱ་རོག་མིག།",
    "དེ་ནས་གཡས་གཡོན་གཉིས་སུ་ཚོན་རེ་དང་ཕུན་རེ་ཏེ་ཚོན་ཕྱེད་དང་དོ་བཅལ་བ་དཔལ་ཁབ་གསང་།",
    "དེ་ནས་གྱེན་དུ་ཚོན་རེ་ཐུགས་ཁབ་གསང་།",
    "དེ་སྟེང་ཚོན་རེ་བཅལ་བ་བྱ་རོག་མིག་སྟེ་དྲུག་གོ།",
    "རྒྱབ་གསང་རིང་མོ་གློ་སུལ་རྣག་འབབ་གསང་།",
    "ཚིགས་པ་བརྒྱད་པ་ནས་ཚིགས་པ་དགུ་པའི་ཐད་ཀ་རུ་མཛུབ་གང་ཐུར་གསེག་ཏུ་བཅལ་བ་དེ་ལས་ཐུར་དུ་སོར་གཉིས་བཅལ་བའི་འོག་ནི་རྒྱབ་གསང་རིང་མོའོ།",
    "རྒྱབ་གསང་རིང་མོ་ནི་གློ་སུལ་ལམ་སྨད་ཀྱི་རྣག་གི་བབ་སའོ།",
    "ཞེས་ཚིགས་པ་བཅུ་གཉིས་པ་དང་བཅུ་གསུམ་པའི་མཚམས་ནས་མདུན་ཟུར་དུ་ཆག་གང་མཁྱིད་གང་མཛུབ་གང་བཅལ་བའི་ཐུང་རིང་གི་ཁྱད་ཀྱི་ས་དང་།",
    "རྣག་གི་འབབ་ས་མ་ངེས་གར་བབས་དབྱེ།",
    "ཞེས་ཕལ་ཆེར་ནི་གོང་དུ་བསྟན་པ་ལྟར་འབྱུང་མོད་ཀྱི་མ་ངེས་པ་ཡང་ཡོད་པས་འོན་ཀྱང་སྟོད་སྨད་ཀྱི་དབྱེ་གསང་འདིར་བསྟན་པ་མ་ཡིན་པ་གཞན་དུ་ཡང་རྣག་གི་འབབ་ས་མ་ངེས་པ་འོང་བས་རྣག་གར་བབས་སུ་དབྱེ་དགོས་ཏེ།",
    "གཉིས་པ་མཚོན་གྱི་བགྲོད་ལམ་ནས་གསོ་དཀའ་སྦྱོང་གི་བར་ཏེ།",
    "འོག་གི་རྨ་ཐིགས་གསོག་པས་འཆིའོ།",
    "གློ་སྟོད་དུ་མཚོན་ལམ་རིང་ན་རང་རང་རྩ་ལ་སྙེག་ནས་རྩ་ཁ་ཤོར་ཉེན་ཆེ་བས་ཐབས་ཀྱིས་རྩ་ཁ་ཟིན་ནམ་ཁྲག་འབྱོར་བྱུང་ན་རྩ་ཁ་འབུད་པའི་ཟས་རྩ་སྒོ་འབྱེད་པ་དང་།",
    "འགྲོ་བའི་སྟངས་ཞན་ཏེ་འགྲོ་སྟངས་ཤོར་བ་ཁོང་ལྕི་བ་དབུགས་མི་བདེ་བ་གློ་སོར་ལངས་པ་པ་རྐང་པ་གང་རྒྱབ་ཕྱོགས་སུ་གོམ་པ་འཁྱོག་པ།",
    "མཆིན་དྲི་ནག་པོ་བཙན་རྡུང་གི་ཞེ་ས་མཁས་པ་ནི་མཉེན་སྙན་མིང་ནས་འབོད་པའོ།",
    "དེ་གསུམ་ནི་ཁྱོད་འཆིའོ་ཞེས་བྱ་གཏོང་བ་ཡིན་པས་དེ་གསུམ་དྲུང་དུ་བརྟོལ་བ་ནི་སླེབས་པའོ།",
    "གྲིའམ་མདུང་གི་ཞེས་པ་ནས་རྨ་རྩི་གསོ་ཞེས་པའི་བར་ཏེ་རྨ་སྤྱི་ལྟར་རོ།",
    "མཆིན་སྟེང་གི་པུས་བྲང་འཆའ་དང་གཅུ་མི་ཤེས་པ་ནི་པུས་མོ་དང་བྲང་གཉིས་རེག་པར་འཆའ་བ་དང་ལུས་བཅའ་གཅུ་མི་ཤེས་པའོ།",
    "བྱ་མོ་ནག་མོའི་སྒོང་ཁྲག་ནི་ཁྱིམ་བྱ་ནག་མོའི་སྒོ་ང་དང་ཁྲག་གོ།",
    "བཞི་སོང་དུས་ཁབ་ལེན་ར་ཐུག་ཆུ་སྦྱར་བྱུགས།",
    "བྱ་ནག་ཤ་གསར་ཏིལ་ལྟོ་ཕྱུངས་པའི་ནང་ནི་བྱ་མོ་ནག་མོའི་ཤ་གསར་དྲས་པའི་ནང་དུ་ཏིལ་གྱི་ལྟོ་ཕྱུངས་པ་ནི་ཏིལ་གྱི་ཕུག་མའོ།",
    "ཡང་ན་བྱ་ནག་རྒྱུ་ལྟོ་ཕྱུངས་པའི་ནང་དུ་ཏིལ་ཕུག་དང་སོ་བ་སོགས་བླུག་ལ་བཙེམ་བཙོས་སྐམ་པ་སྦུབས་བསྲེགས་བྱས་པའི་ཐལ་བའོ།",
    "ལྕགས་དང་བཙའ་འབྱེད་པ་ལ་རླན་གྱིས་སྦྲུས་ལ་བཞག་པས་བཙའ་རུ་སོང་བ་དེ་ཆང་ལ་གདུའོ།",
    "ཞུན་གྱི་ཀླད་པ་ཉེའུ་ནི་ལུག་གི་ཀླད་པ།",
    "ཆང་བླུམ་མམ་སྦང་གླུམ་མོ།",
