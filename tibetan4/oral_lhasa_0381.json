    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དཔེར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིར་རང་བཞིན་སྨྲ་བ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ལྟར་པད་མ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱི་རོལ་དག་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཏི་ཏི་རི་ཞེས་བྱ་བ་ནི་བྱའི་ཁྱད་པར་རོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཇིག་རྟེན་པ་རྣམས་ཀྱིས་ས་བོན་ལ་སོགས་པ་སྡུད་པར་ཡང་མི་འགྱུར་བས་སོལ།",
    "སོགས་པའི་སྒྲས་ནི་གོས་དང་རྒྱན་ལ་སོགས་པ་འདོད་པ་རྣམས་ཀྱིས་སྣལ་མ་དང་གསེར་ལ་སོགས་པ་སྡུད་པར་བྱེད་པར་ཡང་མི་འགྱུར་བ་བསྡུ་བར་བྱའོ།",
    "ཅི་ལྟར་ས་བོན་ལ་སོགས་པ་སྡུད་པར་བྱེད་ན་སྨྲས་པ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་གང་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྨིན་པ་ལས་སྐྱེས་པའི་སྐྱེ་བ་ཞེས་བྱ་བ་ནི་སྐྱེ་བ་སྟོབས་ཀྱིས་གང་དཀར་པོ་དང་དམར་པོ་ལ་སོགས་པའི་གནས་སྐབས་ཁྱད་པར་ཅན་སྐྱེའོ།",
    "རྟག་ཏུ་སྐྱེ་བར་འགྱུར་ན་ཞེས་བྱ་བ་ནི་དུས་ཀྱི་ཁྱད་པར་ལས་སྐྱེ་བར་མི་འགྱུར་བའོ།",
    "སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འགྲོ་བ་རྣམས་གཟུང་དུ་མེད་པ་ཉིད་ཀྱང་མ་ཡིན་པས་རྒྱུ་དང་ལྡན་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཤིན་ཏུ་ཆེས་བཀྲའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཐོང་བ་རྒྱུ་རུ་སྨྲ་བའི་ཕྱོགས་སྔ་མ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སེམས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་འདོད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྒྱུ་དམིགས་བཞིན་པ་ལ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཐོང་བའི་རྒྱུ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཉིད་བཞི་ཁོ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡོངས་སུ་སྨིན་པའི་ཁྱད་པར་ལས་ཞེས་བྱ་བ་ནི་གནས་སྐབས་ཁྱད་པར་ཅན་རྙེད་པ་ལས་སོ།",
    "དེ་ལ་ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དུས་ཀྱི་ཁྱད་པར་གྱི་སྒོ་ནས་གོང་ནས་གོང་དུ་གནས་སྐབས་ཁྱད་པར་ཅན་ཐོབ་པ་གང་ཡིན་པའོ།",
    "མྱོས་པར་འགྱུར་བའི་ནུས་པ་ཞེས་བྱ་བ་ལ།",
    "མྱོས་པ་ནི་རབ་ཏུ་དགའ་བ་སྟེ་སེམས་སྤྲོ་བའི་ཁྱད་པར་རོ།",
    "བྱས་པའི་ལས་ཞེས་བྱ་བ་ནི་སྐྱེ་བ་གཞན་དག་རྒྱལའོ།",
    "ལེགས་པར་སྤྱོད་ཅིང་ཞེས་བྱ་བ་ནི་བགྲོད་པར་བྱ་བ་དང་།",
    "བགྲོད་པར་བྱ་བ་མ་ཡིན་པ་སྤོངས་ལ་ལེགས་པར་ལོངས་སྤྱོད་ཅིག་ཅེས་པའོ།",
    "ལུས་མཆོག་ཅེས་བྱ་བ་ནི་ལུས་ཀྱི་ཁྱད་པར་ཅན་ནོ།",
    "ཅིའི་ཕྱིར་དེ་ལྟར་དཔྱད་པར་བྱ་ཞེ་ན།",
    "འདས་གང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལུས་འདི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལ་བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མངོན་སུམ་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེ་ན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འཇིག་རྟེན་ཕ་རོལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དངོས་པོ་མེད་ན་སྐྱོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་དངོས་པོ་མེད་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཟླ་བོ་མེད་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་དངོས་པོའི་ཟླ་བོ་ནི་དངོས་པོ་མེད་པ་ཡིན་ན་དེ་མེད་པའི་ཕྱིར་དངོས་པོ་ཡང་མེད་པར་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་ཕ་རོལ་མེད་པ་ཡང་ཉམས་པར་འགྱུར་ཏེ།",
    "མངོན་སུམ་གྱི་ཡུལ་ཉིད་མ་ཡིན་པར་ཡང་མི་འཐད་ཅེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཇིག་རྟེན་ཕ་རོལ་མེད་པར་རྗེས་སུ་དཔོག་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་ཕ་རོལ་མེད་པར་རྗེས་སུ་དཔོག་པར་མི་རིགས་ཏེ།",
    "འཇིག་རྟེན་ཕ་རོལ་མེད་པར་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྗེས་སུ་དཔག་པ་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁས་མ་བླངས་པ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ཙམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ད་ནི་འཇིག་རྟེན་ཕ་རོལ་ལ་སྐུར་པ་འདེབས་པ་གང་འཇིག་རྟེན་ཕ་རོལ་མེད་དོ་སྙམ་པའི་ཤེས་པ་ཡོད་པ་དེ་ལོག་པའི་ཤེས་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ནི་སྐྱོན་གཞན་ཡང་བརྗོད་པར་བྱའོ།",
    "དེས་ན་འཇིག་རྟེན་ཕ་རོལ་ཡང་དག་རྟོགས་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་ཕ་རོལ་ལ་སྐུར་པ་འདེབས་པ་དེས་འཇིག་རྟེན་ཕ་རོལ་ཡང་དག་པར་ཇི་ལྟར་རྟོགས་པར་འགྱུར་ཏེ་ཡིད་ཀྱི་མུན་པ་མཐུག་པོ་ཡོད་པས་ཁོང་དུ་ཆུད་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ད་ནི་འཇིག་རྟེན་ཕ་རོལ་མེད་པ་ཉིད་དུ་རྟོགས་པ་དེ་ལོག་པར་ལྟ་བ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཇིག་རྟེན་ཕ་རོལ་འགོག་པར་བྱེད་པའི་དུས་སུ་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་ཕ་རོལ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་འཇིག་རྟེན་ཕ་རོལ་མེད་པར་སྒྲུབ་པར་བྱེད་པའི་དུས་སུའོ།",
    "དེ་ལ་དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མཚུངས་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་དག་པའི་ལྟ་བ་དང་ཐེ་ཚོམ་གྱི་རྟེན་མ་ཡིན་ཞིང་ལོག་པར་ལྟ་བ་དང་ལྡན་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "བསྟན་པ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྟེན་དེ་ནི་ཞེས་བྱ་བལ་སོགས་པ་གསུངས་ཏེ།",
    "དཔེ་དང་དོན་གྱི་གནས་སྐབས་ཐ་དད་པ་ཉིད་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གནས་སྐབས་གཉིས་སྟོན་པ་ནི་གཅིག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལ་གཅིག་ནི་ཕྱོགས་སུ་བྱས་པ་ཉིད་ཀྱིས་ན་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་ཕ་རོལ་ལ་སྐུར་པ་འདེབས་པའི་གནས་སྐབས་ཕྱོགས་སུ་བྱས་པ་ཉིད་ཀྱིས་སོ།",
    "གནས་སྐབས་དེར་ཡང་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དཔེ་བསྒྲུབ་བྱས་སྟོང་པ་ཡིན་ནོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་ཕྱིན་ཅི་མ་ལོག་པར་མཐོང་བ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་ལ་ལན་སྟོན་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དངོས་པོ་རྣམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་གསུངས་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པ་ལ་སྐུར་པ་འདེབས་པ་དང་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་སྐུར་པ་འདེབས་པར་བྱེད་པའོ།",
    "དུས་དང་ཞེས་བྱ་བ་ནི་དུས་ཀྱི་ཁྱད་པར་ལས་དངོས་པོ་རྣམས་སྐྱེ་བ་ཡིན་ནོ་ཞེས་དུས་སུ་སྨྲ་བའོ།",
    "རྟོགས་པ་ཕྱིན་ཅི་ལོག་ཏུ་སྦྱོར་བ་ལ་ཕྱོགས་ཙམ་ཞིག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལོག་པའི་ཤེས་པ་དང་ལྡན་པའི་བདག་ཉིད་དུ་ཤེས་པར་གྱིས་ཞེས་པའོ།",
    "དེ་ལྟར་དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དངོས་པོ་སྒྲུབ་པར་བྱེད་པའི་དུས་སུ་བདག་ཉིད་ནི།",
    "ཕ་རོལ་བདག་ཉིད་འགོག་པར་བྱེད་པའི་དུས་སུ་བདག་ཉིད་ནི།",
    "རྣམ་པར་ཤེས་པའི་བདག་ཉིད་ཡོད་ཉིད་དེ་ཚེ་ཁས་ལེན་བཞིན།",
    "ཡོད་པ་དང་མེད་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཚིགས་སུ་བཅད་པ་འདིས་གཞན་གྱི་ཕྱོགས་ཐམས་ཅད་མ་ལུས་པར་གསལ་བར་ངེས་པར་བྱའོ་ཞེས་མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་མཁས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་གྱི་ཕྱོགས་བཀག་པའི་འབྲས་བུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གདོད་མ་ནས་སྐྱེ་བ་མེད་པར་སྒྲུབ་པར་བྱེད་ན་ནི་གང་དུ་སྐྱེ་བ་མེད་པར་གྲུབ་པའི་དཔེ་འགའ་ཞིག་ངེས་པར་བརྗོད་དགོས་ལ།",
    "ཅི་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁོ་བོ་ཅག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁོ་བོ་ཅག་ལ་སྐྱོན་དེ་མི་མཚུངས་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་ཡོན་ཏན་ཡང་ཡོད་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འཇིག་རྟེན་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་དམ་པའི་དོན་དུ་ལྟ་བ་ནི་ཕྱིན་ཅི་མ་ལོག་པར་ཁོང་དུ་ཆུད་པ་སྟེ།",
    "གཞན་གྱིས་དེ་ལྟར་ཤེས་པར་གྱིས་ཤིག་ཅེས་པའོ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་ལྟ་བ་ཉིད་ཀྱང་ཡོད་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་བཞིན་དུ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡོད་པ་ལ་ཡང་སྦྱར་བར་བྱ་བའི་ཕྱིར།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ན་ཐམས་ཅད་མཁྱེན་པ་ཡོད་ཅེས་རྟོགས་པའི་དུས་སུ་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡོད་པ་ཡིན་ནོ་ཞེས་ཁོང་དུ་ཆུད་པའི་དུས་སུའོ།",
    "ཞེས་བྱ་བ་ནི་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡོད་པ་ཉིད་དུ་ཕྱིན་ཅི་མ་ལོག་པར་མཐོང་བའོ།",
    "བདག་མེད་རྟོགས་པར་ཁས་ལེན་དེ་ཚེ་བཞིན།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡོད་པ་ཡིན་ནོ་སྙམ་པའི་ལྟ་བའི་རྣམ་པའི་རྟེན་མཚུངས་པའི་ལུས་དང་ལྡན་པའི་ཕྱིར་ཞེས་པའོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དམིགས་པར་འགྱུར་བ་ཞིག་གམ་ཞེས་བྱ་བ་ནི་དེ་ལ་སྐྱེ་བར་འགྱུར་བ་དམིགས་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་པའོ།",
    "སྐྱེ་བའི་རྣམ་པར་རྟོག་པ་གཞན་མི་སྲིད་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་བདག་དང་།",
    "གཉིས་ཀ་མ་ཡིན་པའི་རྣམ་པར་རྟོག་པ་དོར་བའི་སྐྱེ་བའི་རྣམ་པར་རྟོག་པ་གཞན་མི་སྲིད་པའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་རྟོག་པ་ལྔ་མེད་པས་སོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྔོན་པོ་ལ་སོགས་པ་རྣམས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གལ་ཏེ་དེ་ལྟར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མ་རིག་པ་དང་བཅས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ཉིད་དེར་ཞེས་བྱ་བ་ནི་རང་བཞིན་ཡོད་པར་རོ།",
    "སྤྲིན་ཚོགས་དང་མཚུངས་གཏི་མུག་སྟུག་པོ་ཞེས་བྱ་བ་ནི་དཔེར་ན་སྤྲིན་གྱི་ཚོགས་ཤིན་ཏུ་སྟུག་པོ་ཡོད་ན་ཅུང་ཟད་ཀྱང་མཐོང་བ་མ་ཡིན་པ་དེ་བཞིན་དུ་མ་རིག་པའི་མུན་པའི་ཚོགས་ཡོད་པར་གྱུར་ན་བྱིས་པ་རྣམས་ཀྱིས་དངོས་པོའི་རང་བཞིན་མཐོང་བ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྤྲིན་ཚོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིའི་དོན་ནི་མུན་ནག་ཡོད་པར་གྱུར་ན་དངོས་པོ་རྣམས་མི་མཐོང་བར་འགྱུར་ལ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟ་བུར་གྱུར་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལོག་པར་འཛིན་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་ཕྱིས་ཀྱི་དུས་ཀྱི་བློ་ལ་ལྟོས་ནས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་རབ་རིབ་ཅན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་མ་རིག་པ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མི་གཡོ་བ་ཞེས་བྱ་བ་ནི་གཟུགས་དང་གཟུགས་མེད་པར་ངེས་པའི་ལས་སོ།",
    "ལྡོག་པའི་རིམ་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བཞིན་དུ་མ་རིག་པ་འགགས་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་ན་མ་རིག་པའི་སྟོབས་ཀྱིས་ལས་དང་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་འཇུག་པས་དེ་འགགས་ནས་ལས་དང་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་འགག་པ་ཡིན་ནོ་ཞེས་གསུངས་པས།",
    "མཁས་པ་རྣམས་ལ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཚུལ་འདིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཏི་མུག་མེད་པར་དེ་མི་འབྱུང་།",
    "བློ་བཟང་ཉི་མས་མུན་པ་སྟུག་པོ་རྣམ་པར་བསལ་བའི་ཞེས་བྱ་བ་ནི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་དང་བྲལ་བའི་བློ་གྲོས་མཆོག་ཏུ་གྱུར་པ་དེ་ཉི་མ་སྟེ།",
    "དེས་མུན་པ་སྟུག་པོ་གང་ལ་རྣམ་པར་གསལ་བ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཤེས་རབ་ཅན་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདུ་བྱེད་རྣམས་རང་བཞིན་མེད་པར་ཞེས་བྱ་བ་ནི་གདོད་མ་ནས་སྐྱེ་བ་མེད་པར་ཡོངས་སུ་རྟོགས་པའོ།",
    "དེ་ཉེ་ཞུབར་ལེན་པའི་རྒྱུ་སྤངས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་དངོས་པོ་རྣམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་དོན་དམ་པར་དངོས་པོ་རྣམས་ཡོད་པར་མི་འགྱུར་ན་དེའི་ཚེ་དངོས་པོ་དེ་རྣམས་ཀུན་རྫོབ་ཏུ་ཡང་ཡོད་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལ་དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལ་བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཡང་རབ་རིབ་ཅན་གྱི་དཔེའི་སྒོ་ནས་འགེགས་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་གང་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དག་མ་སྐྱེས་པ་ཞེས་བྱ་བ་ནི་ངོ་བོ་ཉིད་ཀྱིས་མ་སྐྱེས་པར་ཁས་ལེན་པས་སོ།",
    "ཞེས་བྱ་བ་ནི་གང་དག་དོན་དམ་པར་རང་བཞིན་མེད་པ་དེ་ཀུན་རྫོབ་ཏུ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁོ་བོ་ཅག་ལ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣལ་འབྱོར་པ་ཡེ་ཤེས་ཀྱིས་ཐུགས་སུ་ཆུད་པའི་སྒོ་ནས་ཞེས་བྱ་བ་ནི་ངོ་བོ་ཉིད་མེད་པར་ཐུགས་སུ་ཆུད་པའི་སྒོ་ནས་རྣལ་འབྱོར་པ་རྣམས་ལ་ལྟོས་ནས་སོ།",
    "ཁོ་བོ་ཅག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དབེན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྣམ་པར་ཤེས་པའི་རང་བཞིན་གྱིས་ཀྱང་དབེན་པའོ།",
    "ཡེ་ཤེས་རང་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོན་དམ་པར་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་དོན་དམ་པ་ནི་མཐའ་བཞི་ལས་གྲོལ་བའི་ཕྱིར་རོ།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དཔེར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ཉིད་བརྒལ་ཞིང་བརྟག་པར་གྱིས་དང་ཞེས་བྱ་བ་ནི་ཅིའི་ཕྱིར་མ་སྐྱེས་པའི་རྨི་ལམ་ལ་སོགས་པ་མཐོང་ལ།",
    "ད་ནི་མ་ངེས་པ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་དེ་ཉིད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་རོ།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཅེས་བྱ་བ་ནི་དོན་དམ་པར་དེ་རྣམས་ལ་སྐྱེ་བ་ལ་སོགས་པའི་རྣམ་བཞག་བྱས་པ་མ་ཡིན་པའོ།",
    "ཁོ་བོ་ཅག་ལ་ནི་འདི་བརྩད་དུ་མེད་པ་ཉིད་དེ་ཞེས་བྱ་བ་ནི་གལ་ཏེ་དེ་ལྟར་གཟུགས་ལ་སོགས་པ་རྣམས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྩོད་པ་དེ་ཁོ་བོ་ཅག་ལ་ཡོད་པར་མི་འགྱུར་བ་ཉིད་དེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཞི་ཞིང་ཞེས་བྱ་བ་ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་ཡུལ་ཡིན་པས་སོ།",
    "ལུང་བརྗོད་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྣང་བའི་ཕྱིར་ན་ཀུན་རྫོབ་ཏུ་རང་བཞིན་སྐྱེ་བས་དོན་དམ་པ་ཡང་ཡོད་པར་འགྱུར་རོ་སྙམ་པའི་དོགས་པ་བསུ་ནས་ལན་འདེབས་པ་ནི།",
    "འཇིག་རྟེན་རབ་ཏུ་གྲགས་པར་ཡོད་ཇི་བཞིན།",
    "དེས་ན་དོན་དམ་པར་སྐྱེ་བ་མེད་དུ་ཟིན་ཀྱང་མ་བརྟགས་ན་ཉམས་དགའ་བའི་འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་ཏུ་སྐྱེ་བས་དངོས་པོར་སྣང་བ་ལ་སྐྱོན་ཅི་ཐུ་ཡོད།",
    "ཅི་སྟེ་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གདགས་པའི་རྟེན་ཞེས་བྱ་བ་ནི་བུམ་པ་དྭང་རྣམ་པར་ཤེས་པ་གདགས་པའི་རྟེན་དུ་གྱུར་པའོ།",
    "དེ་ལ་དུལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཡང་མི་རིགས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྫས་སུ་སྒྲུབ་པར་མི་ནུས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདིའི་དགོངས་པ་ནི་བུམ་པ་ལ་སོགས་པར་འདོགས་པའི་རྒྱུ་རྫས་སུ་ཡོད་པར་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནམ།",
    "གལ་ཏེ་རྫས་ཡོད་དུ་བསྒྲུབ་པར་འདོད་ན་ལན་ནི་རྫས་སུ་བསྒྲུབ་པར་མི་ནུས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "ཇི་ལྟར་རྫས་ཡོད་དུ་སྒྲུབ་པར་མི་ནུས་པ་དེ་ལྟར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཟུགས་ལ་སོགས་པ་མ་གཏོགས་པར།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གསུམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རང་བཞིན་མེད་པ་ལ་འདུས་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སོ་སོར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་གོ་སླའོ།",
    "རྣམ་པ་གཞན་གྱི་སྒོ་ནས་བཏགས་པའི་བུམ་པ་ལ་རྒྱུ་རྫས་ཡོད་དུ་མི་རིགས་སོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྟག་པ་ལས་མི་རྟག་པ་སྐྱེ་བར་མི་འདོད་པ་ཞེས་བྱ་བ་ནི་རྒྱུ་ལ་རྣམ་འགྱུར་མེད་པར་འབྲས་བུ་མེད་པས་སོ།",
    "བསྡུས་པའི་དོན་བསྟན་པའི་སྒོ་ནས་བཏགས་པར་ཡོད་པ་ནི་བཏགས་པར་ཡོད་པའི་རྒྱུ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཞིན་ལ་སོགས་པ་ལ་བཏགས་སུ་ཡོད་པ་ཉིད་བུམ་པ་ལ་སོགས་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཐམས་ཅད་དུ་བཏགས་པར་ཡོད་པ་ཉིད་སྔར་བཞིན་དུ་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བྱེད་པ་པོ་དང་དེས་བྱས་ལས།",
    "དེ་ལ་སྤྲུལ་པ་གཞན་སྤྲུལ་པར་བྱེད་པའི་སྤྲུལ་པ་གང་ཡིན་པ་དེ་སྟོང་པ་ཉིད་རང་བཞིན་མེད་པ་དེ་བཞིན་གཤེགས་པའི་རང་བཞིན་དང་བྲལ་བ་ཡིན་ནོ་ཞེས་པའོ།",
    "དཔེར་ན་སྤྲུལ་པ་པོས་སྤྲུལ་པ་གཞན་སྤྲུལ་པ་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "སྤྲུལ་པའི་དཔེས་རང་བཞིན་མེད་པར་ལྟ་བ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འབྲས་བུ་ནི་རྣམ་པར་སྨིན་པ་དང་།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཀུན་རྫོབ་ཏུ་སྐྱེ་བ་ཅི་ལྟར་ངེས་པར་བྱ་སྟེ་འགལ་བ་ཡིན་ནོ་ཞེས་པའོ།་།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་སྐྱེས་པས་འདི་སྐྱེ་སྟེ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ལ་དཔེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་འདི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
