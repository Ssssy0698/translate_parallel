    "རྣམ་པར་འགྱུར་བ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་རྟག་པ་ཡིན་པས་རྣམ་འགྱུར་ལ་བརྟེན་པ་མ་ཡིན་ནོ་ཞེས་བྱའོ།",
    "རང་བཞིན་ལ་ལྟོས་ནས་རྣམ་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་དེས་རྣམ་པར་བསྒྱུར་བར་བྱ་བ་ཡིན་པས་སོ།",
    "རྣམ་པར་འགྱུར་བ་ཁོ་ན་སྟེ།",
    "རྣམ་པར་འགྱུར་བའི་ཚོགས་ཞེས་བྱ་བ་ནི་ཆེན་པོ་ལ་སོགས་པའོ།",
    "འདོད་པ་སྐྱེས་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར་ན།",
    "རྣ་བ་ལ་སོགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་ན་གཟུགས་བརྙན་གཉིས་ཕྲད་པ་ནི་གནས་སྐབས་ན་ཡུལ་ཉམས་སུ་མྱོང་བའི་མཚན་ཉིད་ཅན་ལོངས་སྤྱོད་པར་འགྱུར་བའོ།",
    "རྣམ་པར་འགྱུར་བའི་ཚོགས་ཞེས་བྱ་བ་ནི་ཆེན་པོ་ལ་སོགས་པའོ།",
    "ཚོགས་བཅུ་དྲུག་པོ་རྣམས་ནི་ང་རྒྱལ་ལ་ཐིམ་པར་འགྱུར་ཞིང་།",
    "བློ་ནི་རང་བཞིན་ལ་ཐིམ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་རིམ་པ་འདིས་སོ།",
    "མི་གསལ་བའི་ངོ་བོར་འགྱུར་བ་ཞེས་བྱ་བ་ནི་རྣམ་པར་འགྱུར་བའི་ཚོགས་རྣམས་མི་སྣང་བར་འགྱུར་བ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེའི་ཚེ་སྐྱེས་བུ་ཉག་གཅིག་གནས་ཏེ་ཞེས་བྱ་བ་ནི་རང་བཞིན་དང་བྲལ་བས་སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་དང་བྲལ་བའི་སྐྱེས་བུ་གཅིག་པུ་གནས་པའོ།",
    "དེ་ཡང་རྟག་པ་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི་དེ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་འགྱུར་བ་ཞར་ཟིན་ཀྱང་།",
    "དེ་ལྟར་རྟག་པའི་ངོ་བོ་ཉིད་དུ་བསྟན་ནས་བྱེད་པ་པོ་མ་ཡིན་པ་ལ་སོགས་པའི་ཁྱད་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རང་བཞིན་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་འགྱུར་བ་རྣམས་ལས་ཀྱང་ཁ་ཅིག་ཅེས་བྱ་བ་ནི་བློ་དང་ང་རྒྱལ་དང་།",
    "ཁྱད་པར་བྱེད་པ་ཉིད་ཡོད་པའི་ཕྱིར་ན་བྱ་བ་མེད་པ་ཉིད་དེ་ཞེས་བྱ་བ་ནི་མ་ཁྱབ་པའི་ཡུལ་དུ་འགྲོ་བའི་ཕྱིར་བྱ་བ་དང་བཅས་པར་རིགས་ཀྱི།",
    "རྡུལ་གྱི་སྟོབས་ཀྱིས་བློ་ལ་སོགས་པ་རྣམས་བསྟན་པར་མི་འགྱུར་བའི་ཕྱིར་ན་གཡོ་བ་དང་།",
    "འདིར་ཡང་རྒྱུ་ལ་འབྲས་བུ་ཡོད་པར་ནི་སྔར་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "གནས་སྐབས་དེ་ལ་གཙོ་བོ་ཞེས་བརྗོད་པར་བྱ་བའི་རང་བཞིན་གྱི་སྒྲས་ནི་བརྗོད་པར་མི་བྱའོ།",
    "འདིར་ཡོན་ཏན་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དག་རྣམ་པར་འགྱུར་བའི་གནས་སྐབས་ནི་རང་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་གང་ཡང་རུང་བ་ཤས་ཆེ་བའི་གནས་སྐབས་ནི་རང་བཞིན་ཡིན་ནོ་ཞེས་པའོ།",
    "རྣམ་པར་འགྱུར་བ་ཅན་དང་ཞེས་བྱ་བ་ནི་སྡུག་བསྔལ་གྱི་ཆ་དང་ལྡན་པའོ།",
    "རྣམ་པར་འགྱུར་བ་ཉིད་ཁོ་ན་ཡིན་ལ་ཞེས་བྱ་བ་ནི་གཞན་གྱིས་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པས་སོ།",
    "དེའི་མཐར་ཐུག་པ་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་ལ་ནན་ཏན་བྱེད་པའོ།",
    "ཡང་དག་པར་རྟོགས་པའི་ཤེས་པས་ཞེས་བྱ་བ་ནི་རྣམ་པར་མི་རྟོག་པའི་ཤེས་པ་ཐོབ་པས་སོ།",
    "རྩ་བ་དང་བཅས་པར་གཅོད་པར་ཞེས་བྱ་བ་ནི་འདི་ཇི་ལྟར་ཡང་སྐྱེ་བར་མི་འགྱུར་བ་དེ་ལྟར་གཅོད་པའོ།",
    "དེ་ལྟར་ཁྱད་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བདག་དེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཁྱབ་པ་ནི་སྔར་བཞིན་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་ཕྱོགས་སྔ་མ་བཀོད་ནས་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མུ་སྟེགས་ཅན་རྣམས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡོད་མིན་ཞིང་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་དང་པོའོ།",
    "ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་གཉིས་པའོ།",
    "གལ་ཏེ་དོན་དམ་པར་དེ་ཡོད་པ་མ་ཡིན་ཞིང་ངར་འཛིན་གྱི་ཡུལ་དུ་གྱུར་པ་མ་ཡིན་ཀྱང་འོན་ཀྱང་ཀུན་རྫོབ་ཏུ་དེ་གཉིས་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "ངར་འཛིན་གྱི་རྟེན་དུ་མ་གྱུར་པར་བསྟན་པས་ཀུན་རྫོབ་ཏུ་ཡང་འདི་གཉིས་ཆར་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རང་ཉིད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ཡང་ཡོད་པ་ཉིད་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཁྱད་པར་ཞེས་བྱ་བ་ནི་རྟག་པ་ཉིད་ལ་སོགས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་གྲངས་ཅན་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཕུང་པོ་ལས་ཐ་དད་དུ་གྱུར་པའི་བདག་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་དེ་ལྟར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཉེ་བར་ལེན་པ་ལས་གཞན་དུ་སྟེ་ཐ་དད་པའི་བདག་ཉིད་ཡོད་པར་གྱུར་ན་དེ་ཉེ་བར་ལེན་པ་ལས་ཐ་དད་དུ་འཛིན་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་ཕུང་པོ་ལ་སོགས་པ་ནི་གལ་ཏེ་ཕུང་པོ་རྣམས་ལས་བདག་གཞན་དུ་འགྱུར་ན་ནི་ཕུང་པོའི་མཚན་ཉིད་མེད་པར་འགྱུར་རོ།",
    "དེ་ལ་ཕུང་པོ་ནི་འདུས་བྱས་ཡིན་པའི་ཕྱིར་སྐྱེ་བ་དང་གནས་པ་འཇིག་པའི་མཚན་ཉིད་ཅན་ཡིན་པས་ཕུང་པོ་མ་ཡིན་པའི་མཚན་ཉིད་ཅན་བདག་ཡོད་པར་གྱུར་ན་སྐྱེ་བ་དང་གནས་པ་དང་འཇིག་པའི་མཚན་ཉིད་དང་མི་ལྡན་པར་འགྱུར་རོ།",
    "གང་དེ་ལྟ་བུ་དེ་མེད་པའི་ཕྱིར་རམ་འདུས་བྱས་མ་ཡིན་པའི་ཕྱིར་ནམ་མཁའི་མེ་ཏོག་བཞིན་དུའམ་མྱ་ངན་ལས་འདས་པ་བཞིན་དུ་བདག་ཅེས་བྱ་བའི་མིང་མི་ཐོབ་པ་དང་།",
    "ཡང་ན་དོན་འདི་ཡིན་ཏེ་གལ་ཏེ་བདག་ཕུང་པོ་ལས་ཐ་དད་དུ་གྱུར་པ་ཡིན་ན་དེ་ཕུང་པོའི་མཚན་ཉིད་མེད་པར་འགྱུར་ཏེ།",
    "བདག་ནི་གཟུགས་ནས་རྣམ་པར་ཤེས་པའི་བར་ལས་ཐ་དད་དུ་འདོད་པར་འགྱུར་ན་མཚན་ཉིད་ཐ་དད་དུ་གྲུབ་པར་འགྱུར་བ་དང་།",
    "མཚན་ཉིད་ཐ་དད་དུ་གྲུབ་པར་འཛིན་པ་ཉིད་དུ་འགྱུར་ཏེ་གཟུགས་ལས་སེམས་བཞིན་ནོ།",
    "དེ་ལྟར་ཕུང་པོ་ལས་གཞན་པའི་བདག་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་ནས་འཇིག་རྟེན་པའི་ངར་འཛིན་གྱི་ཡུལ་དུ་ཡང་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཕུང་པོ་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གང་བདག་རྟག་པ་ལ་སོགས་པའི་ཁྱད་པར་ཅན་དུ་མི་ཤེས་པ་དེ་རྣམས་ལ་ཡང་བདག་ཏུ་ལྟ་བ་ཡོད་པའི་ཕྱིར་རོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་དག་བདག་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པ་དེ་ལྟ་བུའི་ཞེས་བྱ་བ་ནི་རྟག་པ་དང་མ་སྐྱེས་པ་ལ་སོགས་པའི་ཁྱད་པར་དང་ལྡན་པའོ།",
    "ཅི་སྟེ་གང་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁ་ཅིག་དག་ཁོ་ན་ལ་ཞེས་བྱ་བ་ནི་གང་སྐྱེ་བ་སྔ་མ་ལ་གྲངས་ཅན་པ་དང་བྱེ་བྲག་པ་ལ་སོགས་པར་འགྱུར་རོ།",
    "སྔར་གོམས་པ་མེད་དུ་ཟིན་ཀྱང་ངར་འཛིན་གྱི་བློ་འཇུག་པ་དེ་ཉིད་དཔེའི་སྒོ་ནས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་ཕུང་པོ་ལས་ཐ་དད་དུ་གྱུར་པའི་བདག་བཀག་ཞུནས་ཕུང་པོ་ལས་ཐ་མི་དད་པའི་བདག་དགག་པར་བྱ་བའི་ཕྱིར་ཕྱོགས་སྔ་མ་འགོད་པ་ནི།",
    "ཕུང་པོ་ལས་གཞན་བདག་གྲུབ་པ་མེད་པའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཁ་ཅིག་ཅེས་བྱ་བ་ལ་སོགས་པ་ནས་མང་པོས་བཀུར་བ་ཁ་ཅིག་ནི་བདག་ཏུ་ལྟ་བ་སྟེ་འཇིག་ཚོགས་ལ་ལྟ་བའི་དམིགས་པར་གཟུགས་ལ་སོགས་པའི་ཕུང་པོ་ལྔ་ཆར་ཡང་འདོད་པ་ཡིན་ཏེ།",
    "ཁ་ཅིག་ནི་འཇིག་ཚོགས་ལ་ལྟ་བའི་དམིགས་པས་སེམས་གཅིག་པུ་ཡིན་པར་འདོད་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།"
  ]
}