    "བདུད་ཉིད་བྱས་པ་གཉིས་འདུག་སྟེ།",
    "རིག་དུས་འཁོར་སྒྲུབ་ཐབས་ལེའུའི་འགྲེལ་པ།",
    "རིགས་ཀྱི་ལྷ་རྣམས་ཁ་དོག་དཀར་པོ་རང་དུས་ཀྱི་འཁོར་ལོ་དཀར་པོའི་དཔྲལ་བར་ཟླ་དཀྱིལ་ལ་པདྨའི་འདུག་སྟངས་ཀྱི་གནས་པ།",
    "སླར་ཡང་ཁྱབ་བདག་དུས་ཀྱི་འཁོར་ལོའི་དཀྱིལ་འཁོར་དུ་ནི་བསྒྲུབ་བྱ་ཡང་དག་པར་རབ་ཏུ་གཞུག་པར་བྱའོ།",
    "ལོ་ཙ་ན་སྤུན་མ་ཞེས་པ་ལྟ་བུའོ།",
    "ཨོ་ལོ་ཙ་ནི་སྤུན་མ་བ་སུ་དེ་ནོར་བྱིན་ཅིག་གམ་ནོར་སྦྱིན་མ་སྭཱ་ཧཱ།",
    "ཧྥ་ཧཱུཾ་ཧཱ་ནས་བདེན་བྲལ་གྱི་མཐར་རོ་ཞེས་འདུག་འཁྲུལ་འཁོར་གྱི་ངེས་པ་ལོགས་ཤིག་ཏུ་བཀོད་པ་དེ་ལས་རྒྱ་ཆེར་ཤེས་པར་བྱ་ཞེས་འདུག་ཀྱང་འདིའི་དཔེ་ལག་ཏུ་མ་སོན།",
    "ཟུར་དུ་འགོད་འོས་སུ་གདའོ།",
    "བྱང་དུ་ར་པ་ཙ་ནཱ་ཡ་ཏེ་ན་མ་ཞེས་པ་བརྒྱད་འགོད་པར་བྱའོ།",
    "རྣམ་པར་ཤེས་པ་ལས་འདས་པའི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ་ཞེས་སོགས་དང་གཟི་བརྗིད་ཆེན་པོ་འོད་གསལ་བ་ཞེས་གསུངས་པ་ལྟར།",
    "སླར་ཡང་རང་ལུས་ཀྱི་མགོ་དང་།",
    "དེ་ལྟར་སོ་སོ་གཞན་ལའང་རང་སྡུག་བས།",
    "གང་རང་ཉིད་སློབ་པ་དེ་ཡང་རྡོ་རྗེ་འཛིན་འདྲར་འགྱུར་ཏེ།",
    "འདུ་བ་འཐུལ་བའམ་རབ་ཏུ་འབར་བར་གྱུར་པ་དེ་སྲིད་དུ་བསྒོམས་ལ་དེ་བླངས་ནས་འདུག་པའི་རྣལ་འབྱོར་པ་གང་ཡིན་པ་དེ་ནི།",
    "ཡི་གེ་ཨོཾ་ཉིད་ཙ་ན་ཀའི་འབྲས་བུའི་ཚད་ཙམ་གྱི་རི་ལུ་བསམས་ལ།་",
    "དེ་རྣམས་རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར་རོ།",
    "ཕན་ཆ་ཤིན་ཏུ་ཆེ་བར་འདུག་ཅེས་ནན་ཏན་ཆེན་པོས་ཞུ་མཆིད་ཚིགས་བཅད་ཀྱི་ལམ་ནས་སྤེལ་བ་འདི་ལྟར།",
    "སྐབས་འདིར་ཡན་ལག་བདུན་པའི་ཚིགས་སུ་བཅས་པ་མང་ཙམ་འདུག་ཀྱང་ཡི་གེ་མང་བས་མ་བྲིས།",
    "གང་སྣང་ཐམས་ཅད་ཡིག་འབྲུ་ཤིན་ཏུ་ཆེ་བ་མང་པོས་གང་ནས་ཁྲ་ཆེམ་ཆེམ་འདུག་པ་ལ།",
    "ལྡེབ་ཕྲེང་མི་ཚང་བའང་འདུག་པས་དེ་རྣམས་སྟོང་པ་མི་བཞག་ཀ་མེད་བྱུང་བ་བཅས་ལ་བརྟེན་ནས་ད་དུང་ཞུ་བཅོས་མ་ཐུབ་པ་ཤིན་ཏུ་མང་བ་དང་།",
    "ཡིག་ནོར་ཡིན་ངེས་རྣམས་དག་བཅོས་གནང་འདུག།",
    "དོགས་གཞི་ཅན་ནམ་ཐག་མ་ཆོད་པའི་ཚིག་དོན་རྣམས་མ་དཔེ་སོར་བཞག་ལས་བཅོས་མི་འདུག།",
    "དེ་ལ་སོགས་པའི་མི་རྟག་དགོངས་ནས་གདའ།",
    "ཁ་ཅིག་ལྕགས་འབར་ཁང་པ་སྦྲུམ་མར་འདུག།",
    "དོན་དམ་གཞིག་ན་གང་ལའང་རང་བཞིན་མེད།",
    "སྟོང་པ་ཉིད་ནའང་གང་ལའང་རང་བཞིན་མེད།",
    "སྣང་ཡང་རང་བཞིན་མེད་པར་ཅི་མངོན་ན།",
    "མེད་ཀྱང་རང་ཉིད་དེ་ལ་སྤྱོད་བྱེད་དེ།",
    "རྨི་ལམ་ཡུལ་ལ་ཡོང་བཟུང་རང་སྤྱོད་བཞིན།",
    "རྣམ་རྟོག་སྤང་ཞིང་རང་རིག་ཐོབ་བྱའི་ཕྱིར།",
    "འཕྲལ་བྱུང་ཡུལ་རྟོག་རང་བྱུང་རང་ཞིར་བཞག།",
    "འོན་ཀྱང་ཚིག་མིན་བློ་རྟིང་རང་རིག་འབྱུང་།",
    "བཅོལ་ས་ན་ཡང་བུ་འབའ་ལེ་གཅིག་འདུག།",
    "གྲོང་མི་རྣམས་ཀྱིས་ཕྱིན་པ་ན་མི་དེའི་མགོ་ལ་མ་ཧེའི་རྭ་ཤིན་ཏུ་བཟང་བ་འདུག་གོ།",
    "དེ་ནས་དེ་བཞིན་དུ་བཞག་པ་དང་རོ་དེ་བརྟན་པར་འདུག་ནས།",
    "ལྟོས་ན་ནི་རྒྱུ་རྐྱེན་སྤྱི་དང་རང་བཞིན་བྱེ་བྲག་ཏུ་གྱུར་པ་ཅི་ཞིག་ཡོད།",
    "འབྲས་ཆན་གྱི་ནང་ན་སྦྲུལ་འདུག་པར་མཐོང་།",
    "བཀྲེས་པ་དང་སྐོམ་པས་ཉེན་པར་གྱུར་ནས་ངུ་ཞིང་ང་རོ་ཆེན་པོ་འདོན་ཞིང་འདུག་པ་ལས།",
    "འབྲས་ཆན་གྱི་ནང་ན་ནི་སྦྲུལ་འདུག།",
    "རྫོགས་པ་ཆེན་པོའི་ཚུལ་གྱིས་འཁྲུལ་སྣང་འདི་དག་དམིགས་པར་འདོད་དམ་མི་འདོད་ཙ་ན།",
    "དེ་ཙམ་ནའང་ཚངས་ཚེ་ཆེན་པོ་ནི་འཆི་བར་འདུག་པ་མཐོང་ངོ།",
    "བདག་དང་རང་བཞིན་ནི་གཏན་མེད་དོ།",
    "དེས་བསམས་པ་སྔོན་ཆད་བརྟན་པར་བསམས་པའི་རྩ་བའི་ཆ་ནི་འགྱིང་བའི་གཏིང་རྡོ་ཉིད་དུ་འདུག།",
    "པྲ་ཙ་ན་ཞེས་བྱ་བའི་སྒྲ།",
    "ཙ་ན་ནི་ཚིག་གམ་ངག།",
    "ཀུ་བ་ཙ་ན་ཞེས་བྱ་སྟེ།",
    "སྣང་བ་ནི་གཉིའ་ག་དུས་ཅིག་ཏུ་མི་ལྡན་ནོ།",
    "དེ་ལ་ཆེ་བ་དང་གོལ་སྒྲིབ་བསྟན་པས་ཀྱང་རང་བཞིན་བསྟན་པར་འགྱུར།",
    "དོན་ལའང་བླང་དོར་མེད་ཅིང་ཤེས་པའང་རང་བཞིན་གྱིས་འོད་གསལ་བ་ཡིན་ནོ།",
    "ལྷ་དང་རང་བཞིན་མཉམ་པར་ལྟ་བ་འདི་ལྟ་བུ་ནི།",
    "རྣམ་པར་མ་དག་པའི་ལས་ཀྱང་རང་ཞི་བར་འགྱུར་བ་ནི།",
    "རང་རང་གང་ན་གནས་པའི་ས་ཕྱོགས་དེ་ནས་བལྟས་པ་ན།",
    "རང་འོད་གསལ་ཞིང་རང་རིག་པ་ལས་མ་གཏོགས་པ།",
    "སེམས་རྣལ་དུ་འདུག་པ་ཐོབ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་དང་རྣམ་པ་མི་རྟོག་པ་གཉིའ་གའང་རང་བཞིན་གྱིས་མཉམ་པའི་ཕྱིར།",
    "མ་བཀག་རང་བྱུང་མ་འབྲང་རང་ཞི་སྟེ།",
    "དེ་ལྟར་དངོས་པོའི་མཐའ་རྣམས་བརྟགས་དང་རང་བཞིན་སྒྱུ་མའང་མེད་འགྱུར་ཕྱིར།",
    "གཞན་ཡང་རང་བཞིན་མེད་པ་དང་མ་སྐྱེས་པའི་སྒྲས་བསྟན་པའི་དོན།",
    "དེ་ལྟ་བུའི་དོན་ལ་འཁྲུལ་པའི་བློས་བསླད་ཀྱང་རང་བཞིན་འགྱུར་བ་མེད་དེ།",
    "དེ་བཞིན་དུ་སེམས་ཀྱང་རང་བཞིན་ཉིད་མེད་པའི་ཕྱིར་རྩོལ་བའི་གནས་མེད་དོ།",
    "དེ་ཡང་རང་བཞིན་དང་མངོན་དུ་གྱུར་པའི་མཐུའོ།",
    "ཡུད་ཙམ་ཞིག་ཀྱང་གནས་ཤིང་འདུག་མི་བྱ།",
    "དེ་མིན་འགྲོ་བར་ནུས་མ་ཡིན།",
    "དེ་ལ་ཚོར་བ་ཡང་ལང་ཆེ་ཞིང་རབ་ཏུ་དྲག་པོས་གདུང་བའི་ལུས་ཐོབ་ནས་ཡུན་རིང་དུ་འདུག་གོ།",
    "ཅིའི་ཕྱིར་དེ་སྐད་བཏགས་བདག་སུའི་ཁྱིམ་དུ་འདུག་ཀྱང་ནོར་སོགས་ཀུན་རྒུད་ཅིང་བརླག་པར་འགྱུར་བས་བཀྲ་མི་ཤིས་པའི་ཕྱིར་རོ་ཟེར།",
    "བདག་འདུག་ན་དེའང་རྟག་ཏུ་ཕྱི་བཞིན་འབྲང་བས་ལྷན་ཅིག་འདུག་དགོས།",
    "ལ་ལས་འདུག་སྟངས་ཉེས་པས་སྦྲིད་པ་སངས་པ་གོ།",
    "འཇིག་རྟེན་ན་དགྲ་དཔུང་གཞོམ་པ་དང་རང་ལ་མི་ཚུགས་པའི་ཐབས་བྱེད་པ་བཞིན་དུ།",
    "དོན་དམ་དཔྱོད་བྱེད་ཀྱི་རིག་པ་གཅིག་ཏུ་བྲལ་སོགས་ཀྱིས་དཔྱད་ཅིང་གཞིག་ན་སྣང་བ་དེ་དག་གང་ལའང་རང་བཞིན་རྡུལ་ཙམ་མེད་དོ།",
    "དཔྱད་མ་དཔྱད་གང་ལྟར་ཡང་རང་བཞིན་མེད་པའི་སྟོང་པ་ཉིད་དོ།",
    "མེད་ཅེས་པའང་རང་བཞིན་གྱིས་གྲུབ་ན་ཡོད་པར་ནམ་ཡང་མི་འགྱུར་རོ།",
    "ཡེ་ཤེས་ལའང་རང་བཞིན་མེད་པས་དེའི་གཟུགས་བརྙན་ཡིན་ཕྱིར་དངོས་པོ་མེད་པའམ།",
    "གང་སྤྱོད་དེ་ཡང་རང་བཞིན་སྟོང་པ་སྟེ།",
    "ཞེས་པ་འདི་སྤྱིར་བཏང་སྙོམས་ནི་སེམས་མཉམ་པར་འདུག་པ་སྟེ།",
    "དགག་སྒྲུབ་ཕྱོགས་ཀྱི་ཆ་གཉིས་བཏང་ནས་སེམས་རྣལ་དུ་འདུག་པ་ལ་བྱ།",
    "བཏང་སྙོམས་ཀྱིས་བྱིང་རྒོད་ཞི་ཚེ་སེམས་རྣལ་དུ་འདུག་པ་སྟེ།",
    "འདི་རྣམས་གལ་ཆེ་བར་འདུག་པས་བྲིས་སོ།",
    "བདག་ལ་མི་བསྟོད་ཅིང་རང་སྐྱོན་ལ་བལྟ་བར་བྱ་ཞིང་གཞན་ལ་མི་སྨོད་པར་ཡོན་ཏན་ཅན་དུ་བལྟ་ཞིང་བསྔགས་པར་བྱ།",
    "ཆུ་ཆེན་གྱི་འགྲམ་བྱེ་མའི་ནང་གནས་བཅས་ནས་འདུག་པས་སྦལ་ཆུང་མཇུག་མ་རིང་པོ་མྱུར་མགྱོགས་ཅན་ཞིག་ཡོད་པར་བཤད།",
    "མི་བཀྲེས་པས་ཉེན་པ་ཞིག་གཞན་གྱི་ཁ་ཟས་གཡོས་མཁན་དུ་གྱུར་ཀྱང་རང་ལ་མི་ཕན་པ་ལྟར།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "སྒྲ་ལ་འཆེལ་ཞིང་འདུག་པར་མ་བྱེད་པར།",
    "སེམས་དང་སེམས་ཉིད་གཉིས་ལས་འདི་ནི་སེམས་ཉིད་དེ་རྣམ་པར་མི་རྟོག་ཅིང་རང་ངོ་མི་རྨོངས་པ་དང་སེམས་ནི་ཡུལ་ལ་རྟོག་ཅིང་རྨོངས་པའོ།",
    "རང་རིག་ཡུལ་ལ་མི་འཕྲོ་ཞིང་དོན་གྱི་རྣམ་པ་མྱོང་བ་རང་རིག་ལ་ཐུག་ཀྱང་རང་རིག་དོན་གྱིས་བསླང་པ་མེད་དོ།",
    "གང་ལྟར་བྱས་ཀྱང་དུ་ཁ་འབའ་ཞིག་ལས་མི་འདུག་པས།",
    "དེས་བརྒྱུད་པ་འཛིན་ཅིང་རང་གཞན་བསྟན་འགྲོའི་དོན་འབྱུང་།",
    "དགྲ་གཉེན་ངོ་མཉམ་ཆགས་སྡང་རང་གྲོལ་ལ་ཐོངས།",
    "རང་འདོད་ཧ་ཅང་ཆེ་དྲག་པ་དང་རང་མཐོང་ང་རྒྱལ་གྱིས།",
    "རང་བབས་སུ་བཞག་པའི་གདམས་ངག་ནི། ། འདུག་པ་བཞི་ལ།",
    "རོལ་པ་འགག་མེད་དུ་འདུག་པས་སྣ་ཚོགས་སུ་ཤར།",
    "སྣང་བ་རྣམས་ཀྱང་རང་སར་གྲོལ།",
    "བདེ་བའི་སྟན་ལ་འདུག་ནས་ནི།",
    "རང་འབྱུང་རང་རིག་ཀ་དག་ལྷུན་གྱིས་གྲུབ།",
    "རྩམ་གཟན་ཙམ་མིན་འགྲོ་ལ་ཐར་ལམ་བསྟན།",
    "དེ་དག་རང་རང་ལ་ཅི་འདོད་ཐམས་ཅད་ལྷུན་གྱིས་གྲུབ།",
    "མཚན་ཇི་ལྟར་གསོལ་བ་དང་གསུམ་ནི་གཞུང་རང་རང་བསྟན་པའི་ཤུགས་ལས་ཤེས་པར་འགྱུར་རོ།",
    "ལུས་ཀྱི་འཕྱོ་རྒྱུག་འགྲོ་འདུག་རྣམ་འགྱུར་བྱ།",
    "འོག་མིན་དུ་ཀུན་ཏུ་བཟང་པོས་རིགས་ལྔའི་བདེ་བར་གཤེགས་པ་རྣམས་ལ་རྫོགས་པ་ཆེན་པོའི་རྒྱུད་འཆད་ཚུལ་རྣམས་མས་རིམ་བཞིན་སྤྱད་ཅིང་རང་རྒྱུད་ལ་བཀལ།",
    "མགྲིན་པ་ཨོལ་མདུད་ནོན་པར་བྱས་ཏེ་ལུས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་གསུམ་པ་མེ་འབར་བ་ཞིག་ཏུ་སྒོམ་ལ་ཅི་ནུས་སུ་འདུག།",
    "ཡུལ་སྣང་རང་བཞིན་མེད་པར་གྲོལ་བ་དང་།",
    "སྣང་བ་ལ་རྩལ་སྦྱངས་པས་སྣང་བ་ཁྲལ་མ་ཁྲོལ་དུ་འདུག་པའི་ཉམས་འཆར་ཞིང་།",
    "ཅིར་ཡང་མེད་པ་དེ་ད་དེ་ལས་ཕྱིས་མེད་པར་བྱེད་དུ་འདུག་གམ་མི་འདུག།",
    "རང་རང་ཡིན།",
    "རང་སྟོར་རྒྱུ་འདུག་གམ།",
    "མ་འོངས་མི་འགྲོ་ཡེ་ནས་དབྱིངས་ན་འདུག།",
    "འོ་ན་བྱུང་མཁན་གྱི་ཤེས་པ་ཁོ་རང་ཅར་གྱིས་ངོས་བཟུང་ཞིག་དང་།",
    "དེ་ལ་དངོས་པོ་འདུག་གམ།",
    "ཁ་དོག་འདུག་གམ།",
    "གཅིག་དང་དུ་མ་ལ་སོགས་གང་འདྲར་འདུག་རྟོགས་ཤིག།",
    "གནས་ས་མེད་ཀྱང་གནས་མཁན་གྱི་དྲན་པ་གསལ་གསལ་ཧྲིག་ཧྲིག་ཏུ་འདུག་ན་དེ་ཅར་གྱིས་ངོས་ཟུངས་ཤིག།",
    "གལ་ཏེ་རྙེད་ན་འགྲོ་མཁན་གྱི་བྱད་བཞིན་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱང་ཤེས་དགོས་པས་བརྟགས་པའི་ཚེ་དེ་ལྟར་མི་འདུག་པར་རང་ཡལ་དུ་ཡལ།",
    "ལྟ་མཁན་དང་ལྟ་ཡུལ་གཉིས་སུ་འདུག་གམ།",
    "སྔ་འཕྱི་ཐོག་མཐའ་མེད་པར་རྟོགས་རུང་མ་རྟོགས་རུང་འཁོར་འདས་ཐམས་ཅད་གྲོལ་ནས་འདུག་པས།",
    "སྲིན་པོ་འབར་བ་རང་མཐོང་ཡང་རང་སྣང་ལས་མི་གཞན་པར་ཐག་ཆོད་ནས།",
    "ཇི་ལྟར་བྱས་ཀྱང་རང་ཤར་རང་གྲོལ་གྱི་ཀློང་ལས་མ་འདས་པས་གོལ་ས་དང་ལྟུང་ས་མེད་དོ།",
    "ཐོད་རྒལ་དུ་གཟུགས་ཕུང་རང་སྣང་རང་འོད་དང་ཕུང་གཞན་རང་སར་དག་སྟེ།",
    "ཡུལ་སྣང་རང་སྣང་འོད་གསལ་དུ་མ་གྲོལ་ཏེ་གཞན་དུ་ལྟ་བ་མ་སྤངས་པས་འགྲོ་དོན་ཡང་གཞན་དུ་བྱེད་པ་ལ།",
    "རང་ལས་འབྱུང་ཞིང་རང་ལ་སྣང་།",
    "བོན་སྐུ་སེང་གེའི་འདུག་སྟངས་དང་།",
    "ལོངས་སྐུ་གླང་པོ་ཆེའི་འདུག་སྟངས།",
    "འདུག་སྟངས་རྣམས་གང་ཡང་ཧ་ཅང་གཅུམ་པའི་བསྡམ་པ་མ་ཡིན་པར་ཆ་ཆ་ནས་ལྷོད་ཆགས་པས་གཅུན་པས་གེགས་མི་འཇུག་ཅིང་ཡོན་ཏན་སྐྱེ་བོགས་ཆེའོ།",
