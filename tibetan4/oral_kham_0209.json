    "སྤྱི་འཐུས་མང་དུ་གཏོང་དགོས་ཀྱི་འདུག་ཅིང་།",
    "ལ་ལས་གཞིས་བྱེས་ངོ་འཛོམས་མ་བྱུང་བར་སྲིད་དོན་ཚོགས་པས་གཞུང་སྲིད་འཛིན་རྒྱུའི་འོས་བབས་མི་འདུག་ཅེས་དང་།",
    "སྤྱི་འཐུས་ཀྱི་གནས་སྟངས་འདི་བསྒྱུར་བཅོས་གཏོང་དགོས་ཀྱི་འདུག་དེར་བརྟེན་ད་ཕན་གཏན་འཁེལ་བའི་ལམ་ལུགས་དེབ་བཅུ་དྲུག་པ།",
    "བྱུང་ན་གསུམ་བཅུའི་དུས་དྲན་གོང་མཇུག་བསྒྲིལ་ཐུབ་པ་ཞིག་བྱེད་ཐུབ་ཀྱི་འདུག་དང་མི་འདུག་བལྟ་རྒྱུ་བྱས།",
    "གྲངས་ཀ་མི་ལོན་པའི་སྐབས་ལ་འོས་གྲངས་ཉུང་ཉུང་ཞིག་ཡིན་ཀྱང་མཇུག་ཏུ་འཐོབ་དུས་བརྟན་པོ་དང་སྤུས་དག་པོ་ཞིག་ཆགས་ཀྱི་མི་འདུག་བྱས་ཙང་དེ་འདྲ་ཞིག་བྱས་ན་བསམ་པ་བྱུང་།",
    "སྤྱི་འཐུས་གོང་འོག་གཉིས་དགོས་ཀྱི་འདུག་དང་།",
    "འོས་འཕེན་སྟངས་དང་འོས་ཀྱི་གྲངས་ཀ་དེ་ཏག་ཏག་ལོན་པ་ཞིག་ནན་པོ་མ་བཟོས་ན་ཡག་པོ་མི་འདུག་དེ་དང་པོ་ནས་ནན་པོ་བཟོ་རྒྱུ་བྱས།",
    "ཁྱེད་རང་ནས་དགོས་ཞུ་ལ་སོགས་བྱེད་མི་ཉེན་པའི་སྐོར་ཡང་བརྗོད་ཀྱི་འདུག་དེ་བཞིན་ཁམས་རིགས་མང་པོ་ཞིག་ཡོང་ནས་དེ་འདྲའི་བསམ་ཚུལ་གཅིག་མཚུངས་བརྗོད་པ་དང་།",
    "གཞོན་ནུ་ལྷན་ཚོགས་སོགས་ནས་ཁོ་རང་ལ་འོས་ཤོག་འཕེན་རྒྱུའི་གཏན་འཁེལ་བའི་གོ་དོན་ཞིག་ཚོར་བྱུང་།",
    "འགན་འཛིན་སྐུ་ངོ་ཁྱེད་རང་དང་།",
    "སྤྱིར་སྟངས་བགྲེས་ཡོལ་དུ་འགྲོ་མཁན་རྣམས་ཀྱི་ལས་དོན་བྱས་རིམ་བཀོད་སྲོལ་ཡོད་པ་ལྟར་ཆ་ཚང་བ་ཞིག་བྱུང་མི་འདུག་ཀྱང་བཀོད་ཁྱབ་གཉིས་པ་ཞིག་དགོས་གལ་ཞུ་རིན་མི་འདུག་སྙམ་པ་ལྟར།",
    "ཤེས་བཀའ་རྗེ་བཙུན་པད་མ་གཉིས་ལས་བཀའ་བློན་བསྟན་འཛིན་རྣམ་རྒྱལ་ལྷན་རྒྱས་སུ་མེད་སྐབས་འཁེལ་འདུག་ཅིང་།",
    "ཁ་ལུད་ཡང་ཡང་མིད་པའི་སྦུག་ནས་ཐོན་ཏེ་སེམས་སུ་རྣམ་རྟོག་ཀྱང་ཕྲན་བུ་ཡོང་འདུག་པར།",
    "འཚོ་གོས་ཆེད་ལས་ཀའི་ངོ་བོ་སྣ་ཚོགས་ཤིག་བྱེད་བཞིན་པ་ལས་གནས་སྟངས་སྐྱོན་མེད་ཙམ་འདུག་པ་དང་།",
    "ལངས་ཕྱོགས་ཡིན་པའི་རྣམ་འགྱུར་ཤུགས་ཆེའི་སྐད་ཆ་ཤོད་འདུག་པ་དང་།",
    "འོན་ཀྱང་བསམ་བློ་བཏང་སྟེ་མི་ཡིས་སྤྱོད་ངན་བྱས་ནའང་རང་ཉིད་དྲང་པོ་བྱས་ན་ལེགས་སྙམ་སྟེ།",
    "ངས་ཤེས་ཀྱི་ཡོད་ཅེས་བཀའ་ཕེབས་ཀྱི་འདུག་ཅེས་བརྗོད་ཀྱི་ཡོད་ལུགས་ཤོད་མཁན་བྱུང་།",
    "དེ་ནས་ལྷ་སར་ཕྱིར་ལོག་བྱེད་ཉེའི་མཚམས་སྐུ་སྒེར་ཡིག་ཚང་དུ་བཅར་སྐབས་སྐུ་སྒེར་དྲུང་ཆེ་རྟ་ར་ལགས་ནས་ད་དུང་ཁྱེད་རང་ཐོན་མཇལ་ཞུ་གལ་ཆེ་བར།",
    "ཕྲན་ནས་ག་དུས་ཡོང་ན་མི་འགྲིགས་པ་མེད་ཅེས་བརྗོད།",
    "ང་རང་པེ་ཅིང་ནས་ཨོ་སི་ཀྲོ་ལི་ཡ་བརྒྱུད་ནས་ཡོང་བ་ཡིན་ལུགས་བཤད།",
    "གནས་ལུགས་གསལ་པོ་ཞིག་མ་བྱུང་ཕྱིན་མཇལ་ཁ་ཐོབ་རྒྱུ་ཁག་པོ་ཡིན་འགྲོ།",
    "དེ་འདྲའི་བྱེད་སྟངས་ངན་པ་དེར་ཧ་ལས་པའི་བློ་ཕམ་པོ་བྱེད་འདུག་ཅེས་བརྗོད།",
    "ལན་དུ་ངོས་རང་ནས་ཁྱེད་རང་མི་རྒས།",
    "ཐང་དཀྱིལ་དེར་ཁང་ལས་ཆེད་བྱེ་ཕུང་ཤིག་འདུག་སོགས་བྱེད་ཀྱི་འདུག་ཅིང་།",
    "ཕྱིན་པས་ཀྱང་ཕལ་ཆེར་ཕན་ཐོགས་ཡོང་བཟོ་མི་འདུག་ངེད་གཉིས་ཀྱིས་གཡས་གཡོན་དུ་ཕྱི་རྒྱལ་གྱི་མི་སྣ་འདྲ་མིན་༡༢ ཙམ་གྱིས་བལྟས་ནས་ཡོད།",
    "ཁ་ནས་མང་པོ་ཤོད་ཀྱི་འདུག་ཅིང་།",
    "དེ་ལས་ལྡོག་སྟེ་ཉེས་དཀྲི་བྱས་ན་ཕན་ཚུན་དགྲ་ལན་དུས་ཚོད་གང་ཙམ་བར་བྱེད་དམ་ཞེས་པའི་སློབ་སྟོན་དེ་ཐོས་སྐབས་ང་རང་དེབ་བཅུ་དྲུག་པ།",
    "མི་དེ་འདྲ་མང་པོ་ཤི་བ་གང་ཡིན་ནམ་ཞེས་འདྲི་ཡི་འདུག་ངས་དེ་སྐོར་དམག་དཔོན་ཀྲང་ལགས་ལ་སྐད་ཆ་དྲིས་པ་ཡིན།",
    "ངས་ཁོང་ལ་ཚགས་ཤོག་ཐོག་མདེའུ་གཅིག་ལས་རྙེད་མི་འདུག་པས་མེ་མདའ་གང་དུ་ཡོད་དམ་ཞེས་དྲིས་པ་ཡིན་ལ།",
    "ཁོང་བོད་ལ་ཕེབས་རྗེས་ང་རང་ནས་ཀྱང་བོད་དགོན་ཉམས་གསོའི་ལས་ཀར་རོགས་རམ་ཞུ་འདོད་ཡོད་ལ།",
    "ཤེས་རབ་ཆེན་པོའི་གསུང་བཅས་དང་གཉིས་སུ་མི་འདུག་ལ།",
    "བོད་དེ་དུས་རབས་མང་པོའི་རིང་རང་བཙན་དང་ཞི་བདེར་གནས་ཤིང་།",
    "མཎྜལ་རྟེན་གསུམ་འབུལ་དངོས་བཅས་ཕུལ་བ་དང་རང་བྱུང་གང་ཤར་གྱི་ཞབས་བརྟན་ཚིགས་བཅད་མ་གསུངས།",
    "བལ་ཡུལ་དོན་གཅོད་ནས་ངོས་རང་ལ་བསྟན་ཏེ་ཧ་ལས་པའི་རྣམ་འགྱུར་བསྟན་གྱི་འདུག་ངོས་རང་ཡང་ཧོན་འཐོར་བ་ལྟ་བུ་བྱུང་བ་དང་།",
    "ཁྱིམ་ཚང་དང་ཕ་མའི་འདོད་པར་བསྟུན་ནས་ཞུགས་པའང་ཁ་ཤས་འདུག་དེབ་བཅུ་དྲུག་པ།",
    "ཁྱེད་ཚོས་བཟང་ངན་ལེགས་ཉེས་ཤེས་ཀྱི་མི་འདུག་གམ།",
    "དེ་སྔ་བོད་དུ་བསྐྱོད་མྱོང་བ་ཁོང་ཉིད་ལ་སོགས་པས་ཀྱང་དེ་ལྟར་གསུང་འདུག་ཅིང་།",
    "ང་རང་ཡང་མ་ཧཱ་ཏ་མ་གྷན་དྷིའི་རྗེས་འཇུག་ཡིན་སྙམ་གྱི་ཡོད།",
    "དེའི་རྐྱེན་གྱིས་རྒྱའི་ལས་བྱེད་ཚོས་བཙོན་པ་ཚོ་ཉེས་རྡུང་གཏོང་འགོ་ཚུགས་འདུག་ལྷག་པ་ཚེ་རིང་ནི་གཞོན་ནུ་ཉམ་ཆུང་རང་བཞིན་ཅན་ཤེས་ཡོད་ཡ་རབས་རྣམ་དཔྱོད་དང་ལྡན་པ་ཡིན་སྟབས་ཁོང་ལ་དམིགས་བསལ་གྱིས་ཉེས་རྡུང་ནན་པོ་བཏང་སྟེ།",
    "ནག་པོ་ཆགས་སྟངས་ལ་བལྟས་ན་དུག་སྟེར་བ་མིན་ནམ་སྙམ་པའི་དོགས་པས་རྒྱ་ལས་པ་ཚོར་དུག་སྟེར་ནས་བསད་འདུག་ཅེས་རྒོལ་གླེང་བྱས་ཀྱང་ཁོ་ཚོས་ཁས་ལེན་བྱས་མེད།",
    "དེ་འདྲའི་བརྒྱུད་ནས་རྒྱུད་སྨད་གྲྭ་ཚང་དུ་སྨར་ཁམས་པའི་བླ་རྒན་དྲུག་བདུན་ཙམ་ཞིག་ཡོད་འདུག་པ་དེ་ཁོངས་ནས་གྲྭ་རྒན་གཉིས་རྡ་སར་ཡོང་སྟེ་ངོས་སར་འབྲེལ་གཏུགས་གནང་བྱུང་།",
    "བཀའ་བློན་ཁྲི་ཟུར་དང་བཀའ་ཟུར་ཟེར་བའི་གདན་ཐོབ་ལྟ་བུ་མེད་པ་འདྲ་འདུག་འོན་ཀྱང་བཀའ་བློན་ཁྲི་པ་ཟེར་བ་དེ་ཡོད་པ་ཞིག་དང་།",
    "དེའང་ཕལ་ཆེར་ཞབས་ལོ་རྒན་རིམ་ནས་གྲས་བཤིག་བརྒྱབ་སྟེ་འགྲོ་ཡི་ཡོད་པ་ཡིན་འདུག་ཅིང་།",
    "དང་པོ་༡༩༨༨ ཕྱི་ཟླ་༦ ཚེས་༡༥ ཉིན་སི་ཊས་སི་སྦག་ཏུ་ཡོ་རོབ་གྲོས་ཚོགས་ཐོག་གནང་བའི་གྲོས་འཆར་དེ་ནི་ད་ཕྱིན་རྩ་འཛིན་མེད་ལུགས་ཡང་བསྐྱར་བཀའ་ཕེབས་འདུག་པར།",
    "རྐུབ་སྟེགས་སྟེང་བོད་མི་སྤྱི་བོ་གནམ་བསྟན་ཡོངས་ཀྱི་ཚབ་བྱེད་མཁན་གྱི་སྤྱི་མི་ཞིག་ཡིན་བསམ་པའི་འདུ་ཤེས་ག་དུས་ཡིན་ཀྱང་མ་བརླགས་པ་དང་།",
    "གཞན་ཡང་རང་ཉིད་ལོ་ནའི་བབ་དང་།",
    "བརྒྱ་ཆ་དམའ་རུ་བཏང་སྟེ་འོས་ཤོག་བསྐྱར་བསྡུ་བྱས་རུང་བཀའ་བློན་གཉིས་ལས་འོས་ཐོན་བྱུང་མི་འདུག་བཀའ་བློན་འོས་འདེམས་སྐབས་ངོས་རང་ཕྱོགས་བསྐྱོད་སྐབས་འཁེལ་གྱིས་ད་ལམ་ཕྱི་ལོ་༡༩༩༡ ཟླ་༨ ཚེས་༡ ལ་རྡ་སར་འབྱོར་དུས་མ་གཏོགས་འདིའི་བསམ་ཞིབ་གོ་བསྡུར་བྱ་སྐབས་མ་བྱུང་ཞིང་།",
    "ཁྱེད་རང་ནས་བཀའ་བློན་དང་བཀའ་བློན་ཁྲི་པའི་འགན་འཁུར་རྒྱུན་རིང་བྱས་པའི་ཉམས་མྱོང་ཡོད་པ་དང་།",
    "དེ་ནས་བཟུང་རང་ཉིད་ཀྱི་ཐོག་མའི་བསམ་ཚུལ་དེ་ནོར་འཁྲུལ་ཡིན་པ་ངོས་འཛིན་བྱས་པ་ཡིན།",
    "བཀའ་ཤག་ཆབ་སྲིད་ཀྱི་སློབ་སྟོན་འབུལ་མཁན་ཟེར་བ་ཡོད་སྲོལ་ཞིག་ཡོད་ནའང་སྔ་རྗེས་གཉིས་ལ་མི་གྲངས་༤༥ བྱེད་འདུག་པར་སྤྱི་འཐུས་གྲོས་ཚོགས་དང་འགྲན་བསྡུར་མཁན་ལྟ་བུ་ཡིན་ནམ།",
    "དེ་ནས་ཉིན་གསུམ་གྱི་རྗེས་ཕྱི་ཚེས་༡༧ ཉིན་སྔ་དྲོ་སྐུ་གཤེགས་སྐབས་དགུང་ལོ་༧༦ ཐོག་འདུག་པར།",
    "གཞུང་སེམས་རྣམ་པར་དག་པའི་སྐྱེ་བོ་ཞིག་མེད་པ་གྱུར་པའི་སྐབས་སུ་མི་ཤི་བར་སྡོད་ཐབས་མེད་ཀྱང་རང་ཡུལ་དང་བྲལ་ནས་མི་ཡུལ་དུ་འདི་འདྲའི་རང་བཞིན་དུ་འགྱུར་རྒྱུའི་ཡིད་དོགས་ཀྱི་སེམས་སྡུག་མྱ་ངན་གྱིས་ཀྱང་དོན།",
    "ཁོ་རང་སེན་ཧྥུ་རན་སེ་སི་ཀོ་ལ་འབྱོར་བ་དང་།་",
    "གསེར་རྐོན་ལ་མཁོ་བའི་རལ་སྐྱོན་ཤོར་དཀའ་བའི་རྐང་སྣམ་ཞིག་ད་སྔ་མི་འདུག་ཅེས་སྡུག་སྨེ་བཏོན།",
    "མི་འདྲ་ས་གཅིག་འདུག་པ་ནི།",
    "ཁོ་རང་ས་དེ་དང་ཁ་མ་བྲལ།",
    "ཆར་བ་བསྟུད་མར་བབས་ཙང་ཁོ་རང་ལམ་དུ་ཆས་པར་འགོར་འགྱངས་བཏང་།",
    "ཆར་མཚམས་བཞག་རྗེས་གསེར་རྐོན་གྱིས་བརྐོས་ནས་རང་རོང་དུ་བཏང་བའི་ས་རྣམས་ཆུས་ཁུར་ཏེ་ས་ངོས་སྙོམས་པོར་བཏང་འདུག་ཅིང་།",
    "ས་ཆ་ཞིག་ན་ཟོག་རོ་ཕྱིར་སྡུད་ལ་བརྟེན་ནས་འཚོ་བ་སྐྱེལ་གྱིན་པའི་མི་ཞིག་འདུག་ཡིན་ཡང་།",
    "ཁོ་རང་གཏན་འཁེལ་ས་གནས་དེར་ཡོང་སྟེ་ཕྱིར་བསྡུ་གནས་ཚུལ་ལ་ལྟ་ཞིབ་སྐབས།",
    "བཏུང་སྣོད་བརྩིགས་པའི་ཟོང་འཁོར་མང་པོ་འབྱོར་འདུག་པ་མཐོང་།",
    "པེལ་ཚང་ལ་ཕུ་ནུ་མིང་སྲིང་དྲུག་འདུག་ཁྱིམ་སེམས་ཀྱི་སྟོབས།",
    "ཁོ་རང་གམ་དུ་བོས་ཏེ།",
    "ཚོང་གང་ལ་ཞུགས་ཙ་ན།",
    "སྐད་ཆ་དེས་ཁོ་རང་རྦད་དེ་སད་བཅུག་ཁོས་དེ་མ་ཐག་ལས་དཔོན་ཀུན་པོ་བསྐོངས་ཏེ།",
    "དེ་མིན་ཁོ་ལ་ད་དུང་གཞན་ལས་འཕགས་པའི་སྒྲུབ་སྟངས་ཁྱད་པར་བ་ཞིག་འདུག་པ་ནི།",
    "ཏོབ་རྟགས་ཅན་གོང་ཆེ་བ་ལ་རྒྱུ་རྐྱེན་གཉིས་འདུག་གཅིག་ནི།",
    "ང་རང་ལ་ཆ་བཞག་ན་ཡང་རྟགས་འདིའི་རིགས་བཀོལ་སྤྱོད་བྱེད་ཀྱི་ཡོད།",
    "མི་ཚང་ཕལ་པ་ཞིག་ལ་མཚོན་ན་ཤིན་ཏུ་འཚམ་པོ་འདུག་ནང་མི་ག་ཚོད་ཡོད།",
    "ཁྱེད་རང་བློ་ཕམ་མི་སྐྱེ་ཁོ་ཐག་ཡིན།",
    "རང་ཉིད་གང་དུ་ནོར་བ་ལར་ནས་ཤེས་མི་འདུག།",
    "ཅིས་ཀྱང་ཐབས་བཀོད་འདྲ་འཐེན་རན་འདུག་ཅེས་བསམ་ཞིང་བསམ་བཞིན།",
    "ང་རང་ལ་དགའ་ཕྱོགས་མི་ལེགས་པ་དང་གོམས་གཤིས་ངན་རིགས་ཅི་ཡང་མེད།",
    "མི་དེར་འཁྱགས་ཤི་ཐེབས་པའི་རྟགས་མཚན་ཁ་ཚང་འཛོམས་འདུག་ཡིན་ཡང་།",
    "ཁོ་རང་འཁྱགས་ཤི་ཐེབས་པ་ཡིན་ལས་ཆེ།",
    "ཁང་པའི་སྒེའུ་ཁུང་ཆག་མེད་འཐུས་ཚང་དུ་འདུག་པ་མཐོང་།",
    "དེ་རུ་ཁོ་རང་གང་བྱུང་དུ་སློབ་ཁང་ཞིག་ནང་འཛུལ་ཏེ་སྐོར་བ་ཞིག་བརྒྱབ་རྗེས།",
    "ཚད་ལ་པམ་རྒྱ་འདུག་པའི་འཇེབ་འཁོར་ཨ་འཐས་ཀྱིས་བཀྱགས་ཏེ་ནུ་བོ་སྲོག་ཉེན་ལས་བསྐྱབས།",
    "ཅནའ་སློབ་གཙོའི་སྐད་ཆ་དེ་ནི་ཁོ་པའི་བསམ་ཡུལ་ལས་འགོངས་པ་ཞིག་ཡིན་འདུག་ན་ཡང་།",
    "ཁོ་རང་ཆུང་དུས་ནས་ཆམ་བསམ་གཞིགས་ཀྱི་སྟོབསརིག་པ་རྟུལ་པོ་ཞིག་ཡིན་པས་གློག་བརྙན་ལ་བལྟ་སྐབས།",
    "ག་དུས་ཡིན་རུང་།",
    "མཁའ་དབུགས་ཁྲོད་ཀུ་ཤུའི་དྲི་ཞིམ་ཁྱབ་འདུག་གམ།",
