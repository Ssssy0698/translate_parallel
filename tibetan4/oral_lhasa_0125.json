    "དེ་ལས་སོ་སོར་སྐལ་བ་མ་ཤ་ཀ་ལྔ་བྱུང་བ་བརྐུས་ན་ཕས་ཕམ་པར་འགྱུར་རོ།",
    "སྔར་བསྔོས་པ་ལས་ཕྱིས་བརྐུས་ན་ཕས་ཕམ་པར་འགྱུར་རོ།",
    "ཡོ་བྱད་ཆེན་པོ་བརྐུས་ཀྱང་ཕས་ཕམ་པར་མི་འགྱུར་བ་ཡོད་དོ།",
    "དངོས་པོ་གྲུབ་ན་ཕས་ཕམ་པར་འགྱུར་རོ།",
    "དགེ་སློང་ནོར་ཅན་གྱེས་བསམས་པ་ལས་དང་པོ་པ་ལ་ཉེས་པ་མེད་དོ་ཞེས་གསུངས་ན།",
    "ཤིང་མང་པོ་ཞིག་མ་བྱིན་པར་བླངས་ན།",
    "དགེ་སློང་དག་བབེེབ་པ་མ་བཅས་པ་ན་དགེ་སློང་ནོར་ཅན་བྱུས་མ་བྱིན་པ་བླངས་པ་ཐམས་ཅད་ཀྱང་མ་བྱིན་པར་བླངས་པ་མ་ཡིན་ཏེ།",
    "མ་བྱིན་པར་ལེན་པའི་གླེང་གཞི་ནི་རྒྱལ་པོའི་ཁབ་ནའོ།",
    "དངོས་པོ་ནི་མ་བྱིན་པར་ལེན་པའོ།",
    "མིའི་ནོར་ཡིན་པར་ཡང་འདུ་ཤེས་པ་དང་།",
    "ཕས་ཕམ་པར་འགྱུར་བ་གཉིས་པ་མི་བརྗེད་པའི་ཚིག་གོ།",
    "སྒྱིད་ལུག་སྟེ་རྣམ་པར་སྨོད་ནས།",
    "མ་ཁྲོལ་གྱིས་ཁྲོལ་ཅིག་ཅེས་བྱས་ནས་དེས་སྲོག་གཅོད་ཕྱུ་དོ།",
    "གང་གསོལ་བ་དང་ཞུ་བའི་ལས་ཀྱིས་བསྙེན་པར་རྫོགས་པ་ལ་བྱའོ།",
    "འཆི་བའི་བསྔགས་པ་བརྗོད་ཅེས་བྱ་བ་ནི་འཆི་བའི་མདུན་དུ་རྣམ་གྲངས་དུ་མར་འཆི་བའི་བསྔགས་པ་བརྗོད་ཅིང་ཡང་དང་ཡང་དུ་སྣོན་ཅིང་མི་ཟློགས་པར་བྱེད་པའི་དོན་ཏོ།",
    "དེ་ཡང་ཐབས་དེས་འཆི་བའི་དུས་བྱས་ཞེས་བྱ་བ་ནི་ཐབས་དེ་ཉིད་ཀྱིས་ཡིན་གྱི་གཞན་གྱིས་མ་ཡིན་ནོ།",
    "དེ་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་བསྟན་པའམ་ཉེ་བར་བསྟན་པའི་ཚིག་གོ།",
    "དངོས་པོ་གང་ཞེ་ན་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་བསྙེན་པར་རྫོགས་ཤིང་གང་ཟག་ཉིད་ཀྱིས་ཀྱང་མངོན་སུམ་དུ་ཁས་བླངས་ཤིང་མི་འདོར་མི་སྤོང་བའོ།",
    "གང་ཟག་བཅུ་གཉིས་ཀྱི་ལས་ལ་མི་ཆུད་པས་ན་གནས་པར་མི་བྱའོ་ཞེས་གསུངས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་དང་མི་འགལ་བས་ཉེས་ཉུགེ་མེད་དོ།",
    "ཐབས་དེ་རུང་ངོ་ཞེས་ཀུན་གྱིས་བྱས་པ་དང་།",
    "དགེ་སློང་མ་ཞིག་གནས་དེར་དབྱར་ཚུལ་དུ་བཞུགས་པ་དང་།",
    "ལྷུང་བཟེད་དང་སྦྱར་མ་ཁྱེར་ཏེ་ཤོག་ཅེས་བོས་ཤིག་དང་གཡོན་ཅན་རྣམས་འབྲོས་པར་འགྱུར་རོ་ཞེས་བཀའ་༦་",
    "གདོལ་པ་ལྟ་བུའི་སེམས་མ་བསྐྱེད་པར་ལྷུང་བཟེད་ནི་མིག་བཞིན་དུ་གླན་པ་དང་བསྲེག་པར་བྱའོ།་།",
    "ཐབས་དེས་འཆི་བར་གྱུར་ན་ཡང་ཕས་ཕམ་པར་འགྱུར་རོ།",
    "མི་མ་ལགས་པ་བསད་ན་སྦོམ་པོར་འགྱུར་རོ།",
    "འདི་ཡིན་ནམ་མ་ཡིན་སྙམ་དུ་ཐེ་ཚོམ་ཟ་བཞིན་དུ་བསད་ན་ཕས་ཕམ་པར་འགྱུར་རོ།",
    "སོ་སོའི་སྐྱེ་བོ་བསད་པར་བྱས་པ་ལས་དགྲ་བཅོམ་པ་ནི་གཉིས་ཀ་ཡང་འདྲ་སྟེ་ཉེས་པ་སྤོམ་པོར་འགྱུར་རོ།",
    "ཇི་ལྟར་དགེ་སློང་ལ་ཕས་ཕམ་པར་འགྱུར་བ་དེ་བཞིན་དུ་དགེ་སློང་མ་དང་བསླབ་པ་བྱིན་པ་ལ་ཡང་ཕས་ཕམ་པར་འགྱུར་རོ།",
    "དགེ་སློང་མ་ལ་ནི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "གང་ཟག་ནི་དགེ་སློང་མང་པོ་མི་གཙང་བ་བསྒོམ་ཐུ་",
    "དེ་ལྟར་མ་བྱས་ན་བསོད་སྙོམས་ཀྱིས་བྱེལ་བར་འགྱུར་རོ་ཞེས་བྱས་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་འདིར་འཁོད་ཙ་དང་བདེའོ་ཞེས་གསུངས་ན།",
    "གཉེན་རྣམས་ལྷགས་པ་དང་བདག་ཅག་ཕན་ཚུན་ཡོན་ཏན་བརྗོད་པར་བྱའོ་ཞེས་ནས་དེ་དག་ལྷགས་པ་དང་།",
    "ཅི་ཡང་དག་པར་རམ་འོན་ཏེ་བརྫུན་དུ་སྨྲས་པཧཱུཾ།",
    "མེད་བཞིན་དུ་ཅིའི་ཕྱིར་སྨྲ་ཞེས་སྨོད་ཅིང་མི་སྙན་པར་འཛེར་བ།",
    "ཚངས་པར་སྤྱོད་པ་ནི་སྤྱད་བྱས་པ་ཤཱརྟེནི་བྱས་ཀྱིས་གནས་འདི་སྤངས་ཏེ་གྲོང་འདབ་དུ་དོང་ངོ་ཞེས་ཏེ་དེར་གྲོང་དུ་ལྷགས་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ལ་ཞུ་བར་ཅི་གནང་ཞེས་གསོལ་ཏོ།",
    "དེ་ནི་གནང་བའོ།",
    "ཞེས་གསུངས་སོ།",
    "ཡང་དགེ་སློང་གང་ཞེས་བྱ་བ་ནི་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་བསྙེན་པར་རྫོགས་པ་ལ་བྱའོ།",
    "རྣམ་པར་ཤེས་པ་ལ་སོགས་ཏེ་ཡོད་པར་མི་ཤེས་ཤིང་བདག་ཏུ་ལྟ་བའོ།",
    "རྣམ་པར་ཤེས་པ་རྣམས་མི་རྟག་པ་དང་།",
    "སྟོམས་པར་འཇུག་པ་ལ་བྱའི་སྒྲུབ་པ་ལ་ནི་མ་ཡིན་ནོ།",
    "རྣམ་པར་བསྔོས་པའི་འདུ་ཤེས་དང་།",
    "སྟོང་པ་ཉིད་ལ་སོ་སོར་རྟོག་པའི་འདུ་ཤེས་མ་ཐོབ་པར་ངས་ཐོབ་པོ་ཞེས་ཟེར་བ་དང་།",
    "ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ལ་ཀྱེསྙོམས་པར་འཇུག་པ་བཞི་ཐོབ་པོ་ཞེས་བརྗོད་པ་དང་།",
    "ཟག་པ་ཟད་པ་མ་ཐོབ་པར་ཐོབ་པོ་ཞེས་ཟེར་བ་དང་།",
    "ཚངས་པར་འདོད་ཅེས་བྱ་བ་ནི་བྲལ་བར་འདོད་པའོ།",
    "མ་དྲིས་ཀྱང་རུང་ཞེས་བྱ་བ་ནི་བདག་ཉིད་ཀྱང་འགྱོད་པ་སྐྱེས་ནས་དོགས་ཤིང་རྣམ་པར་དོགས་ཏེ་ཡིད་ལ་གཅགས་པའོ།",
    "ཀུན་ཏུ་ཡང་དག་པར་བསྟན་པའི་ཚིག་གོ།",
    "བསྙེན་པར་རྫོགས་པ་སྐྱོན་མེད་ཅིང་བཤོལ་བར་མི་འོས་པ་ལ་བྱའོ།",
    "ཤཱཀྱའི་སྲས་པོ་༢་ཡིན་ཕས་ཕམ་པའོ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་ན་མི་ཚངས་པར་སྤྱོད་པའི་རྒྱུས་མ་བྱིན་པར་ལེན་ཏོ།",
    "མ་བྱིན་པར་ལེན་པ་དེའི་རྒྱུས་ན་ནོར་ཀྱི་བདག་བོ་གསོད་དོ།",
    "ཡུལ་ཡངས་པ་ཅན་གྱི་ལིཙྪ་བཱི་ཉུརྣམས་སུ་འཐབ་ཅིང་འཁྲུགས་པར་གྱུར་ཏོ།",
    "ཡུལ་བྲི་ཛི་སྟིགཞོམ་པར་བཤམས་པ་དང་།",
    "ཞག་བདུན་གྱི་ཚེ་ལུང་བསྟན་པ་བཞིན་དུ་འབབ་ལ་ཕྱིས་འབབ་པར་འགྱུར་རམ་མི་འགྱུར་མ་དྲིས་པས་ཉེས་པ་མེད་དོ།",
    "དེའི་ཚེ་གཅེར་བུ་པའི་ཆུང་མ་ཞིག་རུམ་ན་བུ་ཡོད་པར་གྱུར་ཏེ།",
