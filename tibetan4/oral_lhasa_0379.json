    "གལ་ཏེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཡོད་པར་མ་གྱུར་ན་གཉིད་སྟུག་པོ་ལོག་པའི་སད་པའི་རྣམ་པར་ཤེས་པ་གང་ལས་སྐྱེ་བར་འགྱུར།",
    "དེས་ན་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་ཡོད་པ་ཡིན་ཏེ།",
    "གང་ལས་སད་པའི་དུས་རྣམ་པར་ཤེས་པ་སྐྱེ་བའོ།",
    "བརྒྱལ་བ་ལས་ལངས་པའི་དུས་དང་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ལས་ལངས་པའི་ཚེ་གལ་ཏེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་མི་འདོད་ན་རྣམ་པར་ཤེས་པ་གང་ལས་སྐྱེ་བར་འགྱུར།",
    "ད་དེས་ན་གང་ལས་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་འགྱུར་བའི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཡོད་པ་ཉིད་དོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་ལྟར་རྒྱ་མཇོའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཉིད་ལོག་པ་ལྟ་བུའི་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཁྱད་པར་གཞན་ཅི་ལྟ་བུ་ཞེ་ན།",
    "འདིར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ནི་རྒྱ་མཚོ་ལྟ་བུ་ཡིན་ལ།",
    "འདིར་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིར་ཡང་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཤེས་པ་སྐྱེ་བའི་དུས་ན་ཡང་ངོ།",
    "རྣམ་པར་ཤེས་པ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པ་ཞེས་བྱ་བ་ནི་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པའི་ཤེས་པ་བརྒྱུད་པའོ།",
    "གཟུང་བ་དང་འཛིན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་བག་ཆགས་ནི་གཟུང་བ་དང་འཛིན་པར་རྣམ་པར་རྟོག་པ་དང་རྗེས་སུ་མཐུན་པའི་ཤེས་པ་སྐྱེ་བའི་ནུས་པའི་ཁྱད་པར་རོ།",
    "རྣམ་པ་དེ་ལྟ་བུའི་རྣམ་པར་ཤེས་པ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པས་གང་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་སྔོན་པོ་ལ་སོགས་པའི་ཤེས་པ་བསྐྱེད་པའི་ནུས་པ་གང་གཞག་པ་དེ་ལས་སོ།",
    "དེའི་རྒྱུར་གྱུར་པའི་ཁྱད་པར་རོ།",
    "དེ་ལས་ཞེས་བྱ་བ་ནི་བག་ཆགས་ཀྱིས་བསྒོས་པའི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལས་སོ།",
    "དཔེར་ན་སྒོའི་རྣམ་པར་ཤེས་པ་ཡོད་ན་ནང་རོལ་གྱི་ཤེས་པ་ཡོངས་སུ་སྨིན་པའི་རྐྱེན་ཡིན་པ་དང་།",
    "རྣམ་པར་ཤེས་པ་ལས་ཐ་དད་དུ་གྱུར་པའི་གཟུང་བ་ནི་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "དེ་བཞིན་དུ་སེམས་ཙམ་པ་རྣམས་ཀྱིས་ན་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་རྒྱུ་ཉིད་དུ་བརྗོད་པ་ཡིན་ནོ།",
    "བ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ད་ནི་སེམས་ཙམ་པའི་ལུགས་ཀྱི་རྣམ་གཞག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་ལན་ནི་དངོས་པོ་བརྟགས་པར་ཡོད་པའི་རྒྱུར་གྱུར་ཅིང་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཐ་སྙད་ཙམ་དུ་ཡོད་པ་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་པ་དེ་ལ་དངོས་པོ་བརྟགས་པར་ཡོད་པ་ཞེས་བྱ་ལ།",
    "སེམས་ཙམ་པ་རྣམས་ནི་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པའི་ཚོགས་ལ་དངོས་པོ་བརྟགས་པར་ཡོད་པ་ཞེས་བརྗོད་ལ།",
    "སྔོན་པོར་སྣང་བའི་མཚན་ཉིད་ཅན་མེད་ན་གཟུང་བ་དང་འཛིན་པར་རྣམ་པར་རྟོག་པའི་ཚོགས་གང་ལ་བརྟེན་པར་འགྱུར།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་མ་ལྟོས་པར་ཞེས་བྱ་བ་ནི་ཐག་པ་ལ་མི་ལྟོས་པར་རོཕྱི་རོལ་གྱི་དོན་མེད་ན་ཞེས་བྱ་བ་ནི་ཤེས་པ་ལས་ཐ་དད་དུ་གྱུར་པའི་སྔོན་པོ་ལ་སོགས་པའི་དོན་མེད་ནའོ།",
    "རྣམ་པར་རྟོག་པ་ལོག་པའི་རྟེན་ཡིན་པའི་ཕྱིར་རྣམ་པར་བྱང་བའི་རྒྱུ་ཡིན་ནོ།",
    "ཡང་དག་པར་རྗེས་སུ་མཐོང་ལ་ཞེས་བྱ་བ་ནི་རྣལ་འབྱོར་པས་སོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདིར་ཞེས་བྱ་བ་ནི་ཚིགས་སུ་བཅད་པར་རོ།",
    "གལ་ཏེ་དངོས་པོར་བརྟགས་པར་ཡོད་པའི་རྒྱུར་གྱུར་པ་ཉིད་ཀྱང་དོན་བཞི་པར་གསུངས་པས་གསུམ་ཞེས་ཇི་ལྟར་བརྗོད་ཅེ་ན།",
    "དེ་ལ་ལན་ནི་བཏགས་སུ་ཡོད་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་རྨི་ལམ་ན་དོན་མེད་ཀྱང་དོན་དུ་སྣང་བའི་སྒོ་ནས་དོན་འགྲུབ་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "ཅེས་བྱ་བ་ལ་སོགས་པས་ལན་འདེབས་པར་འགྱུར་བས་ལན་མི་བརྗོད་དོ།",
    "དེས་ན་ཉམས་སུ་མྱོང་བས་འགྲུབ་པར་འདོད་ན་གཉིས་ཀ་ཡང་ཉམས་སུ་མྱོང་བས་ཁས་ལེན་དགོས་སོ།",
    "འདི་ཉིད་ཅེས་བྱ་བ་ནི་ཕྱི་རོལ་གྱི་དོན་མེད་པས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་བསྒོས་པའི་བག་ཆགས་ཀྱི་ཁྱད་པར་ལས་དོན་དུ་སྣང་བའི་ཤེས་པ་སྐྱེ་བ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེའི་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཁང་མིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཅུང་ཟད་གཉིད་ཀྱིས་ལོག་པས་ཞེས་བྱ་བ་ནི་གཉིད་སྟུག་པོ་ལོག་པའི་གནས་སྐབས་ན་རྨི་ལམ་མཐོང་བ་མི་སྲིད་པས་ཅུང་ཟད་གཉིད་ཀྱིས་ལོག་པས་ཞེས་གསུངས་སོ།",
    "གླང་པོ་ཆེ་མྱོས་པའི་ཁྱུ་རྨིས་པ་ནི་ཅི་ཞིག་ལྟར་ཡང་ཡོད་པ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་ཤིན་ཏུ་མི་སྲིད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བསམ་བྱ་ཞེས་བྱ་བ་ནི་རྨི་ལམ་ན་དོན་མེད་པའི་ཤེས་པ་ཡོད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ཡང་བསམ་པར་བྱའོ།",
    "བསམ་པར་བྱ་བ་གང་ཞིག་ཡིན།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བ་གླང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཅི་སྟེ་རྨི་ལམ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དྲན་པ་དེ་ཡང་ཉམས་སུ་མྱོང་བ་མེད་ན་ཡོད་པར་མི་འགྱུར་བས་ཉམས་སུ་མྱོང་བ་དང་།",
    "ཤེས་པ་དག་རྣམ་གྲངས་ཡིན་པའི་ཕྱིར་རྨི་ལམ་ན་རྣམ་པར་ཤེས་པ་ཡོད་པ་ཉིད་ཡིན་ནོ་ཞེ་ནའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ཡང་མི་རུང་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཞུགསུངས་ཏེ།",
    "གཉིད་སད་པའི་གནས་སྐབས་ན་དྲན་པའི་སྒོ་ནས་གལ་ཏེ་རྨི་ལམ་གྱི་གནས་སྐབས་ན་རྣམ་པར་ཤེས་པ་ཡོད་པར་ཁས་ལེན་ན།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་ན་རྣམ་པར་ཤེས་པ་ཡང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གལ་ཏེ་ཡུལ་དྲན་དུ་ཟིན་ཀྱང་ཡུལ་ཁས་མི་ལེན་ན་རྣམ་པར་ཤེས་པ་དྲན་ཡང་རྣམ་པར་ཤེས་པ་མེད་པར་ཁས་བླང་བའི་ཕྱིར་ཁོ་བོའི་ཕྱོགས་གྲུབ་པ་ཡིན་ནོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཉིད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་ཕྱིར་འཇུག་པ་བཀག་པའི་ཕྱིར་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་མེད་པའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཁོ་ན་གླང་པོ་ཆེ་ལ་སོགས་པའི་རྣམ་པར་སྐྱེ་བ་ཡིན་ལ།",
    "དེ་མེད་ན་དེ་ལ་དོན་ཡོད་པ་མ་ཡིན་པས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་རྣམ་པ་ཁོ་ན་ལ་དོན་དུ་ཞེན་པ་དེ་བཞིན་དུ་སད་པའི་གནས་སྐབས་ན་ཡང་ཡིན་པས་དཔེ་གྲུབ་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྨི་ལམ་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་གོ་སླའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་རྨི་ལམ་ན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་རྣམ་པ་ཁོ་ན་ལ་དོན་དུ་ཞེན་པ་ནི་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་ན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་རྣམ་པ་ཁོ་ན་ལ་ཕྱི་རོལ་གྱི་དོན་དུ་ཇི་ལྟར་ཞེན་པ་ཡིན་ཞེས་པའོ།",
    "རྣ་སོགས་གསུམ་པོ་ལྷག་མ་ལ་སྐྱེ་བ་མེད་ཅེས་བྱ་བ་ནི་རྨི་ལམ་གྱི་རྣ་བ་དང་སྒྲ་དང་རྣ་བའི་རྣམ་པར་ཤེས་པ་རྣམས་ཀྱང་སྟོང་པ་ཉིད་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དེ་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་གཟུང་བར་བྱ་བའོ།",
    "ཕྱོགས་འདི་ནི་རིགས་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྨི་ལམ་ན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཚེ་ཞེས་བྱ་བ་ནི་གཞན་གྱི་གཞུང་ལུགས་དགག་པར་བྱ་བའི་ཕྱིར་རྨི་ལམ་ན་ཡུལ་ཡོད་པ་ཉིད་དུ་ཁས་ལེན་ནའོ།",
    "ལན་ནི་དེ་བརྫུན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རབ་ཏུ་གྲུབ་པའི་སྒོ་ནས་ཞེས་བྱ་བ་ནི་རྨི་ལམ་གྱི་དཔེ་རང་བཞིན་མེད་པར་གྲུབ་པའི་སྒོ་ནས་སོ།",
    "མ་གྲུབ་པ་ཞེས་བྱ་བ་ནི་སད་པའི་དུས་ན་གསུམ་པོ་འདི་རང་བཞིན་མེད་པར་མ་གྲུབ་པའོ།",
    "བསྒྲུབ་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་རང་བཞིན་མེད་པར་རོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྨི་ལམ་ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སེམས་དེ་ཡོད་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་རྨི་ལམ་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་སྲིད་པའི་འགྲོ་བ་རྣམས་ཀྱང་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གང་རྨི་ལམ་གྱི་དཔེ་ལས་གསུམ་མ་སྐྱེས་པར་བརྗོད་པ་དེ་སད་པ་ལ་ལྟོས་ནས་ཡིན་གྱི།",
    "རྨི་ལམ་གྱི་དུས་ལ་ལྟོས་པ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་སད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་འགྲེལ་བས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་མི་ཤེས་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ད་ནི་ཐ་མལ་པའི་མཚན་ཉིད་ཅན་གྱི་གཉིད་སད་པ་ན་ཅི་ལྟར་གཉིད་ཀྱི་གནས་སྐབས་ན་སྣང་བ་གསུམ་པོ་དེ་མེད་པ་དེ་བཞིན་དུ་མ་རིག་པའི་གཉིད་སད་པ་ན་ཡང་གསུམ་པོ་དེ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སད་པར་གྱུར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སད་པར་གྱུར་ན་ཞེས་བྱ་བ་ལ་སོགས་པས་དཔེ་བསྟན་པ་ཡིན་ལ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་སེམས་ཙམ་དུ་སྨྲ་བ་རྣམས་ཀྱིས་ཕྱི་རོལ་གྱི་དོན་མེད་ཀྱང་ཤེས་པ་ཡོད་པ་ཉིད་དུ་བསྒྲུབ་པ་ནི་འོ་ན་རབ་རིབ་ཅན་གྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཡང་མི་འཐད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རབ་རིབ་མེད་པར་གསལ་བར་མཐོང་བ་ལ་ལྟོས་ནས་ཤེས་པ་དང་།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར་རྨི་ལམ་ཁོ་ན་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཅི་ལྟར་རྨི་ལམ་ན་གཉིས་ཀ་བདེན་ཞིང་གཉིད་སད་པའི་གནས་སྐབས་ན་གཉིས་ཀ་ཡང་མ་སྐྱེས་པ་དེ་བཞིན་དུ་འདིར་ཡང་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེ་ཉིད་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རབ་རིབ་ཅན་གྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འདིའི་དོན་ནི་གདོན་མི་ཟ་བར་བྱ་དགོས་ཏེ་ཞེས་བྱ་བ་ནི་ཡུལ་མེད་པའི་ཤེས་པ་མེད་པར་ངེས་པར་འདོད་དགོས་ཞེས་པའོ།",
    "དེ་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤེས་བྱ་སྐྲ་ཤད་ལ་སོགས་པ་མེད་པར་གལ་ཏེ་སྐྲ་ཤད་ལ་སོགས་པའི་བློ་ཡོད་པར་འགྱུར་ན།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་རབ་རིབ་ཅན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཐུན་པར་མི་སྣང་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "ཡང་སེམས་ཙམ་པས་ཡུལ་མེད་པའི་རྣམ་པར་ཤེས་པ་ལ་ཡོད་པ་ཉིད་དུ་སྟོན་པ་ནི་འདིར་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་ཤེས་པའི་བག་ཆགས་སྔར་བཞག་པ་སྨིན་པ་དང་མ་སྨིན་པ་དག་ཅེས་བྱ་བ་ནི་སྔར་སྐྲ་ཤད་ལ་སོགས་པའི་ཤེས་པས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་བག་ཆགས་གཞག་པ་དེ་སྨིན་པ་ལས་སྐྲ་ཤད་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་དང་།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ཡང་མི་རུང་ངོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ཡང་ཞེས་བྱ་བ་ནི་བག་ཆགས་སྨིན་པ་དང་མ་སྨིན་པ་དག་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་དང་མི་སྐྱེ་བའི་རྒྱུར་འདོད་པའོ།",
    "མི་རིགས་པ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་ལན་ནི་ནུས་པ་མེད་པས་འདིའི་ནི་གྲུབ་པ་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ནུས་པ་མ་གྲུབ་པའི་ཕྱིར་བློའི་ནུས་པ་སྨིན་པ་དང་མ་སྨིན་པས།",
    "རྣམ་པར་ཤེས་པ་སྐྱེ་བ་དང་མི་སྐྱེ་བ་དག་འགྲུབ་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཤེས་བྱ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ནུས་པ་མེད་པ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྐྱེས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐྱེས་པ་སྟེ་ད་ལྟར་བའི་རྣམ་པར་ཤེས་པ་འབྲས་བུར་གྱུར་པ་ལ་ནུས་པ་སྲིད་པ་མ་ཡིན་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདིར་ནུས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།"
  ]
}