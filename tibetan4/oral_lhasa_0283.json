    "ཐོབ་པར་བྱ་བའི་ཐབས་ཀྱང་རིག་པར་བྱའོ།",
    "ཐོབ་པ་ཡང་རིག་པར་བྱའོ།",
    "དེ་ལ་ལྟོས་ནས་དེ་དག་ཏུ་བློ་འཇུག་པར་འགྱུར་པའི་ཕྱིར་རོ།",
    "འདུ་ཤེས་ཀྱི་སྙོམས་པར་འཇུག་པ་ནི་འདུ་བྱེད་ཅེས་བྱའོ།",
    "དེ་ལ་ཁམས་ལྔ་ནི་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་མན་ཆད་འདུ་ཤེས་ཀྱི་སྙོམས་པར་འཇུག་པའི་ཕྱིར།",
    "འདུ་བྱེད་ཀྱི་སྙོམས་པར་འཇུག་པས་ཐོབ་པར་བྱ་བ་ཡིན་ཏེ།",
    "མཚན་མ་མེད་པའི་ཁམས་ཡིད་ལ་བྱེད་པས་ན་འཇིག་ཚོགས་ལ་འགོག་པའི་སྙོམས་པར་འཇུག་པ་མཚན་མ་མེད་པས་ཐོབ་པར་བྱ་བ་ཡིན་གྱི་འདུ་བྱེད་ཀྱི་སྙོམས་པར་འཇུག་པས་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་འདི་དག་ནི་ཐོབ་པར་བྱ་བ་ཡིན་ནོ།",
    "སྙོམས་པར་འཇུག་པ་དེ་དག་ནི་གཟུགས་དང་གཟུགས་མེད་པའི་འདོད་ཆགས་ཡང་དག་པར་བཅོམ་པ་དང་།",
    "རྣམ་པར་གྲོལ་བས་གནས་པ་དང་།",
    "གནས་པས་རྣམ་པར་གྲོལ་བ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་དགའ་བ་བཞིན་ཐོབ་པ་དང་།",
    "གཟུགས་མེད་པའི་ཁམས་སུ་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ཀྱི་བར་དུ་སྐྱེ་བར་འགྱུར་བའི་ལམ་སྟོན་པར་བྱེད་དོ།",
    "ནན་ཏན་དུ་སྒྲུབ་པ་པོ་གང་ཡིན་པའི་གང་ཟག་དེ་གཉིས་ཀྱང་ངན་པ་དང་འབྲིང་དང་གྱ་ནོམ་པར་རིག་པར་བྱའོ།",
    "ནན་ཏན་དུ་སྒྲུབ་པ་པོ་དེ་དག་ཀྱང་གཞན་རྣམས་ལ་ངན་པ་དང་འབྲིང་དང་གྱ་ནོམ་པ་རྗོད་པར་བྱེད་དེ།",
    "དེའི་ངག་ནི་ཕྱིར་ཡང་ངན་པར་གྱུར་པ་ནས་རྒྱས་པར་སྔར་བ་བཞིན་དུ་ཐམས་ཅད་རིག་པར་བྱའོ།",
    "འཇིག་རྟེན་རྟག་གོ་ཞེས་བྱ་བ་ནས་རྒྱས་པར་དེ་བཞིན་འོངས་པ་ཤི་ཕན་ཆད་མེད་པར་འགྱུར་རོ།",
    "མེད་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་པར་རྣམས་སོ།",
    "གཅིག་ནི་ལོག་པར་ལྟ་བ་ལ་སྤྱོད་པ་ཡིན་ཏེ།",
    "ཤེས་པར་འདོད་པའི་བསམ་པ་ཅན་མ་ཡིན་ནོ།",
    "རང་བཞིན་གྱིས་ཀྱང་ཤེས་པར་འདོད་པའི་བསམ་པ་ཅན་ཡིན་ནོ།",
    "འཕགས་པ་ལ་སྐུར་པ་འདེབས་པར་བྱེད་དེ།",
    "མེད་པར་ལྟའོ།",
    "ཅད་མི་བཟོད་པ་གང་ཡིན་པ་དེ་དག་སུན་དབྱུང་བ་དང་གཞིག་པ་དང་མི་མཐུན་པར་བྱ་བའི་ཕྱིར་སུན་འབྱིན་པ་དང་ལྡན་པའི་ལྟ་བའི་རྣམ་པ་དག་བྱེད་ཅིང་སྟོན་ཏེ།",
    "དེ་བཞིན་གཤེགས་པའི་ཉན་ཐོས་ཀྱི་མདུན་དུ་བདག་ནི་ཐམས་ཅད་མི་བཟོད་དོ་ཞེས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་བདག་ཉིད་སྟོན་པར་བྱེད་དེ།",
    "དེའི་ཤེས་པར་འདོད་པའི་བསམ་པ་ཡོད་པ་དང་།",
    "ལྡན་པ་ཡིན་པར་དེ་བཞིན་གཤེགས་པའམ།",
    "སེམས་ཀྱིས་སེམས་ཁྱབ་པར་བྱས་ནས་གང་ཟག་སྔ་མ་ཤོས་ལས་བརྩམས་ཏེ།",
    "དེས་ཀྱང་ཡང་དག་པ་ཇི་ལྟ་བ་ཁོ་ན་བཞིན་དུ་ཕྱིར་ལན་འདེབས་པར་བྱེད་དོ།",
    "ཐམས་ཅད་མི་བཟོད་པའི་ལྟ་བ་དེ་ཀུན་ནས་དཀྲིས་པ་དང་བག་ལ་ཉལ་དང་བཅས་པར་སྤངས་ནས་གཏན་དུ་ལེན་པར་མི་བྱེད་པ་གང་ཡིན་པ་དེ་དག་ནི་ཉུང་དུ་དེ་དག་པས་ཀྱང་ཆེས་ཉུང་དུ་ཞེས་གཟེངས་བསྟོད་པར་མཛད་དོ།",
    "དེ་བཞིན་གཤེགས་པ་དང་དེ་བཞིན་གཤེགས་པའི་ཉན་ཐོས་དེ་དག་འདི་ལྟར་ཤེས་པ་དང་མཐོང་བ་དང་ལྡན་པ་བཞིན་དུ་བདག་ཀྱང་ཀུན་ནས་དཀྲིས་པ་དང་བག་ལ་ཉལ་དང་བཅས་པར་ཇི་ལྟར་སྤོངས་པར་འགྱུར་ཞིག་གུ་སྙམ་སྟེ།",
    "སེམས་ལ་ཡོད་པའི་འདོད་པ་དེ་ཡང་དག་པར་བསྐུལ་བར་མཛད་དོ།",
    "དེས་ཀྱང་ཁས་ལེན་པར་བྱེད་དོ།",
    "རྣམ་པར་འཚེ་བ་ནི་བདག་དང་གཞན་རྣམས་ལ་ཡང་གནོད་པ་དང་ལྡན་པ་ཡིན་པར་སོ་སོར་བརྟགས་ནས་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་ཁས་མི་ལེན་ཅིང་དྲིས་ན་ཡང་ལན་མི་འདེབས་སོ།",
    "གཟུགས་ཅན་གྱི་ལུས་མི་རྟག་པར་མཐོང་ལ།",
    "འགག་པར་མཐོང་སྟེ།",
    "དེ་ལ་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་རྣམས་ནི་ཕྱི་མ་ལ་སྐྱེ་བ་ལ་སོགས་པའི་སྡུག་བསྔལ་དང་ཕྲད་པར་འགྱུར་བ་དང་།",
    "འདས་པ་པོར་ཟིན་པ་ལེན་པར་འགྱུར་བ་དང་།",
    "ད་ལྟར་ལྷག་པར་ཞེན་པར་འགྱུར་བ་ཡིན་ནོ།",
    "རྣམ་པར་འཚེ་བ་ནི་གསུམ་གྱིས་གནོད་པར་བྱེད་པའོ།",
    "མི་རྟག་པ་ལ་སོགས་པར་རྗེས་སུ་མཐོང་བ་ནི་འདི་ལྟ་སྟེ།",
    "རྣམ་པར་འཚེ་བ་མ་སྤངས་པའི་ཕྱིར་གནས་ལ་ཡོད་པ་དེའི་ཕྱོགས་དང་མཐུན་པ་གནས་ངན་ལེན་ས་བོན་ལྟ་བུ་གང་ཡིན་པ་དེ་སྐྱེ་བར་འགྱུར་བའི་ཕྱིར་ནི་ཅི་རིགས་པར་འདོད་པ་དང་།",
    "རྣམ་པར་འཚེ་བའི་ཁམས་ཞེས་བྱ་སྟེ།",
    "རྣམ་པར་འཚེ་བ་དང་མཐུན་པའི་ཡུལ་ཡང་མངོན་སུམ་དུ་གྱུར་པ་དང་།",
    "ཡུལ་རྣམ་པ་གསུམ་པོ་དེ་དག་ལ་ཡང་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པར་གྱུར་ན་ཚུལ་བཞིན་མ་ཡིན་པའི་མཚན་མ་དང་རྟགས་འཛིན་པའི་འདུ་ཤེས་སྐྱེ་བར་འགྱུར་རོ།",
    "སྐྱེས་པ་དེ་དང་དུ་བླངས་པ་ལས་ནི་ཚེ་འདི་དང་ཚེ་ཕྱི་མའི་ཉེས་དམིགས་གཉིས་སུ་འགྱུར་བར་རིག་པར་བྱའོ།",
    "རྣམ་པར་འཚེ་བ་མེད་པའི་འདུ་ཤེས་ཡིན་ཏེ།",
    "ཅི་རིག་པར་རིག་པར་བྱའོ།"
  ]
}