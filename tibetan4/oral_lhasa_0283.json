    "འདི་ནི་ཟས་བཞི་པོ་རྣམས་རྣམ་པར་གཞག་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ལེན་པ་དང་བཅས་པར་བྱེད་དོ།",
    "སྐྱེ་མཆེད་དྲུག་པོ་དེ་ཉིད་གཅིག་ལ་གཅིག་བརྟེན་པར་ཟད་དེ།",
    "དེའི་སྐྱེ་མཆེད་དྲུག་འགགས་པས་རིམ་གྱིས་སྲེད་པའི་བར་དུ་འགག་པར་འགྱུར་རོ།",
    "སྲིད་པ་འགགས་པས་ཟས་འགག་པར་འགྱུར་རོ།",
    "རྗེས་སུ་ཐ་སྙད་གདགས་པའི་དོན་ཡིན་གྱི་དོན་དམ་པར་ནི་མ་ཡིན་ནོ།",
    "ཟ་བ་པོར་གྱུར་ན་ནི་རྣམ་པར་ཤེས་པ་ཟས་སུ་འགྱུར་དུ་མི་རུང་སྟེ།",
    "རྒྱུད་གཅིག་ལ་རྣམ་པར་ཤེས་པ་གཉིས་ཅིག་ཅར་གནས་པ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "གནས་ནས་རྣམ་པར་ཤེས་པ་ཟ་བ་པོར་འགྱུར་དུ་མི་རུང་ངོ།",
    "དེ་ལྟར་མི་རུང་བཞིན་དུ་གང་འདི་སྐད་དུ་སུ་ཞིག་རྣམ་པར་ཤེས་པའི་ཟས་ཟ་ཞེས་དྲི་བ་འདྲི་བར་བྱེད་ན་ནི་ཚུལ་བཞིན་མ་ཡིན་པར་འདྲི་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སྐྱེ་བའི་སྲིད་པས་བསྡུས་པ་སྐྱེ་བར་འགྱུར་བའི་ཕྱིར་འཆི་བའི་དུས་བྱས་ནས་སྔོན་གྱི་མཐའི་སྐྱེ་མཆེད་དྲུག་འགགས་པ་ལས་ཕྱི་མའི་མཐའི་སྐྱེ་མཆེད་དྲུག་སྐྱེས་པ་ལ་ནི་སྐྱེ་བའི་སྲིད་པ་ཞེས་བྱའོ།",
    "རྣམ་པར་ཤེས་པ་དེ་ནི་སྐྱེ་མཆེད་དྲུག་པོ་དེའི་སྔོན་དུ་འཕེན་པ་ཡིན་པའི་ཕྱིར་ཡང་རྐྱེན་ཡིན་ལ་ཉིང་མཚམས་སྦྱོར་བའི་ཚེ་ཡང་རྐྱེན་ཡིན་ཏེ།",
    "འདི་ལྟར་མའི་མངལ་དུ་རྣམ་པར་ཤེས་པ་ཞུགས་པ་ལས་ནི་མིང་དང་གཟུགས་འབྱུང་ངོ།",
    "དེ་བས་ན་རྒྱུ་དང་འབྲས་བུར་གཏོགས་པའི་འདུ་བྱེད་ཀྱི་རྒྱུད་རྒྱུན་མི་འཆད་པར་འཇུག་སྟེ།",
    "ཕྱི་མའི་མཐའི་ལས་ཀྱི་སྲིད་པ་ལས་ཡང་སྔ་མའི་སྐྱེ་བའི་སྲིད་པ་དེ་ཉིད་ཕྱིར་ལྡོག་པར་འགྱུར་ཏེ།",
    "དེས་དེ་ལྟར་རྣམ་པར་ཤེས་པའི་ཟས་ལ་ཡང་དག་པར་མཐོང་ནས་ལུས་དང་སྲོག་ལ་མི་ལྟ་བར་འགྱུར་རོ།",
    "སྤངས་ནས་ཀྱང་ཕྱི་མ་ལ་སྡུག་བསྔལ་མཐར་ཐུག་པ་ཐོབ་པར་འགྱུར་རོ།",
    "ཚེ་འདིའི་ཉེས་དམིགས་རྣམ་པ་གཉིས་སུ་འགྱུར་བར་ཤེས་པར་བྱའོ།",
    "རྣམ་པར་ཤེས་པའི་གནས་རྣམས་ལ་གནས་ནས་ཕྱི་མ་ལ་ཡང་སྲིད་པར་སྐྱེ་བའི་ས་བོན་གྱི་ཚུལ་གྱིས་སྐྱེ་བར་འགྱུར་རོ།",
    "དེ་དེ་ལྟར་རྡུལ་དང་བཅས་པར་གྱུར་པས་ཟས་དེ་རྣམ་པར་འགྱུར་ཞིང་གཞན་དུ་གྱུར་བས་མྱ་ངན་བྱེད་ཅིང་ངལ་ལ་ཡིད་མི་བདེ་བར་གནས་ཏེ།",
    "ཚེ་འདི་ལ་མྱ་ངན་དང་བཅས་པར་འགྱུར་བ་འདི་ནི་དགའ་བ་དང་འདོད་ཆགས་ལས་གྱུར་བའི་ཚེ་འདིའི་ཉེས་དམིགས་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེར་ས་འོག་མ་འམ་ས་གོང་མར་གནས་ཐོད་པར་འགྱུར་རོ།",
    "གནས་ཐོད་པར་ལྟག་ལ་འགྱུར།",
    "ཚོན་ལྟ་བུར་ཆགས་པར་འགྱུར་བའི་ཡུལ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་ཅི་ནས་གང་ཟག་འདི་ཚོན་ལྟ་བུའི་ཡུལ་རྣམ་པ་སྣ་ཚོགས་འདི་རྣམས་དང་།",
    "ཟས་རྣམས་ལ་དགའ་བ་དང་འདོད་ཆགས་སྤངས་པའི་ཕན་ཡོན་འདི་ཡང་གོ་རིམས་བཞིན་དུ་སྦྱར་བར་རིག་པར་བྱའོ།",
    "ཚུལ་བཞིན་མ་ཡིན་པ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་མི་ཤེས་པའི་ཟག་པ་ནི་ཟད་པར་མི་འགྱུར་རོ།",
    "དེ་ལས་བཟློག་པ་རབ་ཏུ་ཤེས་པའི་ཟག་པ་ནི་ཟད་པར་འགྱུར་རོ།",
    "དེ་འདས་པའི་དུས་ཀྱི་སྒོ་ནས་བག་ཡོད་པའམ་མེད་པར་རྟོག་གོ།",
    "ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པ་གང་ཡིན་པ་དེས་འདུ་བྱེད་རྣམས་སམ་འདུ་བྱེད་རྣམས་ལས་དོན་ཐ་དད་པའི་བདག་ཏུ་རྟོག་པར་བྱེད་དེ།",
    "ངེས་པར་འགྱུར་བའི་ཚེ་གཟུང་བའི་དངོས་པོ་ལ་བདག་ཏུ་རྟོག་པ་དེས་ཡང་ན་ནི་རྟག་པའི་ལྟ་བ་འཐོབ་པར་འགྱུར་ཏེ།",
    "ཡང་ན་ནི་ཆད་པར་ལྟ་བར་འགྱུར་ཏེ།",
    "བདག་ཡོད་པར་ལྟ་བ་ནི་འཛིན་པའི་དངོས་པོ་ལ་བདག་ཏུ་རྟོག་པར་བྱེད་དོ།",
    "པའི་དངོས་པོ་ཉིད་ལ་བདག་མེད་པར་རྟོག་པར་བྱེད་དེ།",
    "དེ་ནི་ཚུལ་བཞིན་མ་ཡིན་པའི་ཡིད་ལ་བྱེད་པའི་རྗེས་སུ་དཔག་པའི་ཡིད་ལ་བྱེད་པས་འདུ་བྱེད་རྣམས་ལས་དོན་ཐ་དད་པའི་བདག་ཡོད་པར་རྟོག་པར་བྱེད་དེ།",
    "ཡང་ན་ཡང་སྲིད་པར་སྐྱེ་བའི་ལས་བྱས་སམ།",
    "བྱེད་དུ་བཅུག་ནས་དེའི་འབྲས་བུ་རྣམ་པར་སྨིན་པ་སྐྱེད་པ་པོ་ཡིན་ནོ།",
    "སློང་དུ་བཅུག་ནས་སྐྱེས་བུའི་བྱེད་པའི་འབྲས་བུ་ཡང་དག་པར་བསྐྱེད་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཐ་སྙད་ལ་བརྟེན་ནས།",
    "ཚེ་འདི་ལ་སྐྱེས་བུའི་བྱེད་པའི་འབྲས་བུ་ཡང་དག་པར་སྐྱེས་པ་ནི་ཉམས་སུ་མྱོང་བ་པོའོ།",
    "དེས་ཚེའི་ཚད་ཇི་སྲིད་ཡོད་པ་ཟད་པར་བྱས་ནས་འཆི་བའི་དུས་བྱས་ཏེ།",
    "འདོད་པ་དང་སྲིད་པ་ཚོལ་བ་རྣམ་པར་སྤྱོད་པས་ན་ལྟ་བ་རྣམ་པར་སྤྱོད་པའོ།",
    "ཡང་སྲིད་པར་སྐྱེ་བའི་སྡུག་བསྔལ་ཀུན་དུ་སྦྱོར་བར་བྱེད་པས་ན་ལྟ་བའི་ཀུན་དུ་སྦྱོར་བའོ།",
    "དེ་ལྟར་ལོག་པར་ཞུགས་པ་དེའི་ནི་ཚེ་འདི་ལ་ཟག་པ་མངོན་སུམ་དུ་མ་གྱུར་པ་ནི་མངོན་སུམ་དུ་སྐྱེ་བར་འགྱུར་རོ།",
    "པར་བསྲུངས་པ་དང་།",
    "དྲན་པ་ལེགས་པར་གནས་པ་དང་།",
    "མེད་པར་འགྱུར་བའི་ཤེས་རབ་ཇི་ལྟར་ཐོབ་པ་ལན་མང་དུ་བྱེད་པའོ།",
    "དེ་ལ་ལུས་ལེགས་པར་བསྲུངས་ཏེ།",
    "ཟག་པ་ཟད་པར་བྱ་བ་ལ་བར་དུ་གཅོད་པར་མི་འགྱུར་རོ།",
    "གནས་པ་ནི་ཆགས་པར་འགྱུར་བའི་ཡུལ་མངོན་སུམ་དུ་གྱུར་པ་ལ་ཚུལ་བཞིན་མ་ཡིན་པའི་སྡུག་བའི་མཚན་མ་སྤངས་ནས་མི་སྡུག་པའི་མཚན་མ་ཡིད་ལ་བྱེད་དོ།",
    "དྲན་པ་ལེགས་པར་གནས་པ་དེ་ནི་གནས་བཞི་ལ་གནས་པར་འགྱུར་ཏེ།",
    "ཡོངས་སུ་འཛག་པར་བྱེད་པའི་སྡུག་བསྔལ་དང་།",
    "དྲན་པས་ལེགས་པར་གནས་པར་འགྱུར་རོ།",
    "དེ་དེ་ལྟར་ལུས་ལེགས་པར་བསྲུངས་པ་དང་།",
    "དྲན་པ་ལེགས་པར་གནས་པ་དང་།",
    "བྱས་པ་བསྲུང་བའི་ས་ལ་སྐྱེ་བར་འགྱུར་རོ།",
    "རྣམ་པར་ཤེས་པ་རྣམས་ལ་དམིགས་པ་དང་།",
    "བྱས་པ་བསྲུང་བའི་ས་ལ་རྒྱུ་ལས་བྱུང་བའི་གཟུགས་ལ་དམིགས་པའམ།",
    "རྣམ་པར་ཤེས་པ་རྣམས་ལ་དམིགས་པ་སྟེ།",
    "ཐོག་མ་ཁོ་ནར་རིལ་པོའི་འདུ་ཤེས་རྣམ་པར་དབྱེ་བ་གང་ཡིན་པ་དང་།",
    "དེ་མི་གཙང་བར་ཡང་དག་པར་མཐོང་ནས་མི་སྡུག་པར་འདུ་ཤེས་པ་དང་།",
    "སྲེད་པ་ལས་བྱུང་བར་ཡང་དག་པར་མཐོང་བ་དང་།",
    "མི་རྟག་པ་ལ་ཡང་སྡུག་བསྔལ་བར་འདུ་ཤེས་པར་འགྱུར་རོ།",
    "ཐོས་པ་དང་ལྡན་པའི་འཕགས་པ་ཉན་ཐོས་ནི་རབ་ཏུ་ཤེས་པས་དེ་ལྟར་མི་འཛིན་ལ་དེའི་འདུ་ཤེས་དེ་ནི་སྡུག་བསྔལ་ལ་བདག་མེད་པར་འདུ་ཤེས་པ་དང་།",
    "བདག་མ་ཡིན་པར་འདུ་ཤེས་པར་འགྱུར་ཏེ།",
    "ལུས་ལ་ཁམས་ཙམ་དུ་ཟད་པར་འདུ་ཤེས་པར་འགྱུར་རོ།",
    "ཁམས་ཙམ་དུ་ཟད་པར་དམིགས་ཤིང་དེའི་སེམས་དེ་ལུས་དེ་ལ་ཡང་དག་པར་གནས་སོ།",
    "དེ་ལྟར་ན་དེ་ནི་ཀུན་དུ་རྨོངས་པར་ཡང་མི་འགྱུར་ཏེ།",
    "མི་རྟག་པར་འདུ་ཤེས་པ་དང་།",
    "སྡུག་བསྔལ་བ་ལ་ཡང་བདག་མེད་པར་འདུ་ཤེས་པ་གང་ཡིན་པ་དང་།",
    "དེས་ལྷག་མཐོང་དེ་ཉིད་ལ་བརྟེན་ནས་ཞི་གནས་ལ་བརྩོན་པར་བྱེད་པ་སྟེ།",
    "བདག་ནི་སྟོན་པའི་བསྟན་པ་བཞིན་བྱེད་པ་ཡིན་ནོ་སྙམ་ནས་འགྱོད་པ་མེད་པར་འགྱུར་ཏེ།",
    "འགྱོད་པ་མེད་ན་མཆོག་ཏུ་དགའ་བ་ནས་རྒྱས་པར་ཏིང་ངེ་འཛིན་གྱི་བར་དུ་སྦྱར་བར་བྱའོ།",
    "དེ་དེའི་ཚེ་སེམས་མཉམ་པར་གཞག་པས་བསམ་གཏན་བཞི་པའི་བར་དུ་ཐོབ་པར་འགྱུར་ཏེ།",
    "བརྩོན་འགྲུས་བརྩམས་པ་ལ་ཞུམ་པ་མེད་ཅེས་བྱ་བ་ནས་རྒྱས་པར་སྦྱར་ཏེ།",
    "དེ་གལ་ཏེ་ཞི་བའི་སྙོམས་པར་འཇུག་པ་རོ་མྱང་བས་སེམས་འཕྲོག་པར་འགྱུར་ལ།",
    "དེས་དེའི་ཚེ་ཤེས་རབ་ཀྱིས་སྟོན་པའི་བསྟན་པ་ལ་རྒྱུ་རྣམ་པ་གཉིས་ཀྱི་སྒོ་ནས་བྱ་བ་མང་དུ་བྱས་པ་ཡིན་ཏེ།",
    "ཟག་པ་ཟད་པར་བྱ་བའི་ཕྱིར་བསམ་གཏན་བཞི་པ་ཡོངས་སུ་དག་པར་བྱེད་པ་དང་།",
    "དེ་དེ་ཙམ་གྱིས་ཀྱང་ཆོག་པར་མི་འཛིན་པས།",
    "དེའི་གོང་དུ་བྱས་པ་རྟོགས་པའི་ས་ལ་འཇགས་ཏེ།",
    "བདག་ནི་རྣམ་པར་གྲོལ་ལོ་སྙམ་དུ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ།",
    "རྣམ་པར་གྲོལ་བ་དང་།",
    "རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་མཐོང་བར་འགྱུར་ཏེ།",
    "དེ་ཙམ་གྱིས་ན་དེ་དག་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་སྟོན་པའི་བསྟན་པ་ལ་ཤེས་རབ་ཀྱིས་བྱ་བ་མང་དུ་བྱས་པ་མ་ཡིན་ནོ།",
    "བྱས་པ་འདི་ནི་དེ་མ་ཡིན་པའི་དུས་ན་ཡོངས་སུ་ཉམས་པར་འགྱུར་བས་ན་བྱས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའམ།",
    "བྱས་པ་རྟོགས་པའི་སའི་གང་ཡིན་པ་རྣམས་ནི་ཟག་པ་མེད་པ་སྟེ།",
    "ཕྱི་རོལ་གྱི་སྐྱེ་མཆེད་དྲུག་ལ་བརྟེན་ནས་རྟེན་དང་བཅས་པའི་སྲེད་པ་རྣམ་པར་སྤྱོད་པའོ།",
    "ནང་ལ་བརྟེན་ནས་ངའོ་སྙམ་པའི་ང་རྒྱལ་མ་སྤངས་པའི་ཕྱིར་འདི་ལྟར་སྐྱེ་མཆེད་དྲུག་ལ་ངའོ་སྙམ་དུ་ཀུན་དུ་སྤྱོད་པར་འགྱུར་ལ།",
    "དེ་ལས་བཟློག་པ་ལ་ནི་བདག་ནི་ངན་ནོ་སྙམ་དུ་སེམས་པར་འགྱུར་ལ།",
    "འཇིག་པ་ལ་ནི་སོ་སོར་བརྟགས་ནས་སྲེད་པར་བྱེད་ཀྱི་སེམས་ཐག་པ་ནས་ཡང་དག་པར་གནས་པ་མ་ཡིན་ཏེ།",
    "དེ་བས་ན་དེ་ལ་ནི་རྣམ་པ་གསུམ་དུ་རྣམ་པར་གཞག་པ་མེད་དོ།",
    "སྐྱེ་མཆེད་དྲུག་པོ་འདིར་བདག་གྱུར་ཅིག་སྙམ་པ་ནས་སྔ་མ་བཞིན་དུ་བདག་འདི་ལྟར་གྱུར་ཅིག་བདག་གཞན་དུ་གྱུར་ཅིག་སྙམ་པ་ཐམས་ཅད་ནི་སྲེད་པ་འབྲིང་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདོད་པ་དྲག་པོས་ཡོངས་སུ་ཟིན་པའི་སྲེད་པ་རྣམ་པ་བཞི་པོ་གང་ཡིན་པ་དེ་ནི་ཆེན་པོ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ལྷག་མ་ཡང་ཅི་རིགས་པར་སྔ་མ་བཞིན་དུ་རིག་པར་བྱ་སྟེ།",
    "སྔ་མ་རྣམ་པར་སྤྱོད་པ་རྣམས་བསྡམས་ན་སུམ་ཅུ་རྩ་དྲུག་ཏུ་འགྱུར་རོ།",
    "རྣམ་པར་སྤྱོད་པ་སུམ་ཅུ་རྩ་དྲུག་པོ་དེ་དག་ཉིད་ལས་འདས་པ་དང་།",
    "རབ་ཏུ་དབྱེ་བ་བཞི་ལས་རྣམ་པར་སྤྱོད་པ་བརྒྱ་རྩ་བརྒྱད་དུ་འགྱུར་རོ།",
    "གཞི་ལ་བར་དཀའ་བས་ན་རྣམ་པར་འབབ་བའོ།",
    "མི་ངོམས་པར་བྱེད་པས་ན་སྐོམ་པའོ།",
    "འདོད་པའི་སྲེད་པས་ཤེས་བྱ་བ་ལ་རྨོངས་པར་བྱས་པས་ན་བཀབ་པའོ།",
    "གཟུགས་མེད་པའི་སྲེད་པས་ཤེས་བྱ་ལ་རྨོངས་པར་བྱ་བས་ཀུན་ནས་བསྐོར་བ་སྟེ།",
    "དེས་ན་ལེགས་པར་མི་མཐོང་བ་དེ་བཞིན་དུ་གོ་རིམས་བཞིན་དུ་བཀབ་པ་དང་།",
    "བསྐོར་བ་དང་ཀུན་ནས་བསྐོར་བར་རིག་པར་བྱའོ།",
    "བརྙེས་པར་བྱ་བ་གང་ཡིན་པ་དེ་དང་།",
    "བརྙེས་པར་བྱ་བ་དེ་ཡང་གཞན་གྱི་རྒྱུད་ལ་ངེས་པར་བསྐྱེད་པ་དང་།",
    "མངོན་སུམ་དུ་བྱ་བ་མངོན་སུམ་དུ་མ་བྱས་པའི་འགོག་པའི་བདེན་པ་དང་།",
    "སྔ་མ་བཞིན་དུ་རྣམ་པ་བཞིར་རིག་པར་བྱའོ།",
    "སྔ་མ་བཞིན་དུ་རྣམ་པ་བཞིར་རིག་པར་བྱའོ།",
    "ཁྱད་པར་ནི་འདི་ཡོད་དེ།",
    "གཞན་གྱི་རྒྱུད་ལ་ངེས་པར་བསྐྱེད་པ་དང་།",
    "རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་ཀྱང་བསྐྱེད་པ་ལྟ་བུའོ།",
    "ཚངས་པའི་འཇིག་རྟེན་གྱི་བར་དུ་སྒྲ་གྲག་པར་གྱུར་ཏེ།",
    "དེ་ཡང་གཞན་དག་ལ་མཐུན་པར་བསྐོར་བར་འགྱུར་བ་དང་།",
    "དེ་དག་ཀྱང་གཞན་དག་ལ་མཐུན་པར་བསྐོར་བར་འགྱུར་ཏེ།",
    "དེ་བས་ན་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་དེ་མཐུན་པར་བསྐོར་བའི་དོན་གྱི་འཁོར་ལོ་ཞེས་བྱའོ།",
    "མ་ཐོབ་པ་ཐོབ་པར་བྱ་བའི་ཕྱིར་དད་པ་དང་།",
    "འདུན་པ་ནི་ཐོབ་པར་འདོད་པའོ།",
    "ཐབས་ནི་བག་ཡོད་པར་བྱ་བའི་ཕྱིར་བརྗེད་ངས་པ་མེད་པའི་མཚན་ཉིད་ཀྱི་དྲན་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་སྲེད་པའི་ཟུག་རྔུ་འབྱིན་པ་ཆེན་པོ་བླ་ན་མེད་པ་ཡང་དེ་ཙམ་ཞིག་སྟོན་པར་ཟད་དོ།",
    "བྲམ་ཟེ་རྣམས་ལ་ནི་རྟགས་དང་ཉེས་དམིགས་བཅུ་ཡོད་པར་རིག་པར་བྱ་སྟེ།",
    "ཡང་སྲིད་པར་སྐྱེ་བའི་སྐྱེ་བ་ལ་སོགས་པའི་སྡུག་བསྔལ་ལས་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་ཡོངས་སུ་མ་གྲོལ་བ་དང་།",
    "ཕྱིར་མི་འོང་བས་སྡུག་བསྔལ་བའི་ཡང་སྡུག་བསྔལ་བ་ལས་ཡང་དག་པར་འདའ་བ་དང་།",
    "འཐོབ་པའི་གནས་ཀྱང་རིག་པར་བྱ་སྟེ།",
    "མི་སྐྱེ་བའི་ཡེ་ཤེས་དང་རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་ཀྱིས་བསྡུས་པ་ནི་ཤེས་པའི་གནས་སྐབས་སོ།",
    "མི་སློབ་པ་དེ་ཉིད་ཀྱིས་རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་དང་ལྡན་པའི་ཡང་དག་པའི་ལྟ་བ་ནི་མཐོང་བའོ།",
    "བདེན་པ་ཤེས་པའི་ལས་དང་མཚན་ཉིད་ནི་རྣམ་པ་དྲུག་ཏུ་རིག་པར་བྱ་སྟེ།",
    "སྡུག་བསྔལ་གང་བདེན་པ་མཐོང་བས་སྤངས་པའི་སྡུག་བསྔལ་ཡང་དག་པར་ཟད་པར་འགྱུར་བའི་ཐོག་མར་འགྲོ་བ་དང་།",
    "འགག་ཏུ་ཆའོ་འགག་པར་འགྱུར་རོ།",
    "གཞན་ཡང་བདེན་པ་ཤེས་པ་འཐོབ་པ་ནི་རྡོའི་མཆོད་སྡོང་ལེགས་པར་བཙུགས་པ་བཞིན་དུ་ཕ་རོལ་སྨྲ་བ་རྣམས་ཀྱིས་བསྐྱོད་པར་མི་ནུས་ཏེ།",
    "ངོར་རྟོག་པར་ཡང་མི་འགྱུར་ཏེ།",
    "འཇལ་བ་དང་ཉེ་བར་རྟོག་པར་མི་བྱེད་དོ།",
    "གཞན་དག་ཅེས་བྱ་བ་ནི་འདི་ལས་ཕྱི་རོལ་བའི་དགེ་སྦྱོང་དང་བྲམ་ཟེ་རྣམས་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་མ་ཡིན་པ་རིམ་གྱིས་ཡང་དག་པར་བསྒྲུབས་པ་ཤེས་པ་བཞི་པོ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པ་ནི་ཤིང་སཱ་ལའི་འདབ་མ་ལྟ་བུ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཚེ་རབས་དུ་མའི་མི་བཟད་པ་ཡང་བདེན་པ་ཤེས་པ་མེད་པའི་ཕྱིར་ཐོབ་པར་འགྱུར་རོ།",
    "བདེན་པ་ཤེས་པས་ནི་ཡང་དག་པར་འདའ་བར་འགྱུར་རོ།",
    "ཙམ་གྱིས་ཐོབ་པར་འགྱུར་ཏེ།",
    "བདེན་པ་རྟོགས་པར་བྱ་བ་ལ་ནི་བར་དུ་གཅོད་པ་རྣམ་པ་བཞི་ཡོད་པར་རིག་པར་བྱ་སྟེ།",
    "ད་ནི་ཡང་སྲིད་པར་སྐྱེ་བ་མེད་དོ་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་དགེ་སྦྱོང་གོ་ཏ་མ་ཐམས་ཅད་མཁྱེན་པ་ཡིན་ན།",
    "ཁ་ཅིག་ནི་ལན་འདེབས་པར་བྱེད།",
