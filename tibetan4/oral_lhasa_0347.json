    "དང་པོ་ནི་སྦྱོར་ལམ་ན་གཞི་ལམ་རྣམ་པ་སྐྱེ་བ་མེད་པའི་དོན་གསལ་བ་ཡོད་ན་མཁྱེན་གསུམ་མེད་པ་ཉམས་ལ།",
    "གཉིས་པ་ནི་གཞི་དང་ལམ་དང་རྣམ་པ་སྐྱེ་བ་མེད་པར་ཡོངས་སུ་ཤེས་པ་ཚིགས་སུ་བཅད་པའི་དོན་གྱི་མཚན་ཉིད་ཀྱི་ཡུམ་ཞེས་པ་དང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་གྱིས་ནི་དོན་བརྒྱད་བསྡུས་ལ།",
    "ཡུལ་འདི་རྣམ་པ་གསུམ་པོ་རྒྱུ་ཞེས་སློབ་ལམ་ན་མཁྱེན་གསུམ་ཡོད་པར་གསུངས་པ་དང་འགལ་ལོ་ཞེ་ན།",
    "སྐྱོན་མེད་དེ་དང་པོ་གཉིས་དོན་མཐུན་ལ་དེ་དག་སྡུད་བྱེད་དུ་གསུངས་པས་དངོས་པོ་བརྒྱད་ཀྱི་ཡ་གྱལ་མཁྱེན་གསུམ་མིན་པར་བསྟན་ནོ།",
    "གསུམ་པ་ནི་སྦྱོར་ལམ་ཆ་མཐུན་ལམ་གཉིས་ཅིརིགས་པར་བརྗོད་ཟིན་ཏོ།",
    "ཡུལ་ཅན་མཁྱེན་གསུམ་མཚན་ཉིད་པ་སྟོན་བྱེད་རྒྱུ།",
    "ཡུལ་རྗེས་མཐུན་པ་གསུམ་མཁྱེན་གསུམ་རྗེས་མཐུན་པ་སྟོན་བྱེད་རྒྱུ་ཡིན་ཏེ་ཡུལ་གསུམ་དངོས་སུ་བསྟན་པས་ཡུལ་ཅན་མཁྱེན་གསུམ།",
    "དེས་འཕགས་བཞིའི་མངོན་རྟོགས་བསྡུས་པར་ཤུགས་ལས་བསྟན་པར་བཞེད་པའི་ཕྱིར་རོ།",
    "གཏན་ལ་དབབ་བྱར་གསུངས་པའི་ཕྱིར་དང་།",
    "མཚོན་བྱ་ལྟ་བུར་མཚོན་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "སྐད་ཅིག་མའི་སྦྱོར་བ་ཡོད་པར་གསུངས་པའི་ཕྱིར་རོ།",
    "ས་བདུན་མན་ཆད་ཀྱི་རྣམ་རྫོགས་སྦྱོར་བ་ཁྱད་པར་ཅན་མཡིན་ཏེ།",
    "གསུངས་པ་ནི་ཁྱབ་པ་མེད་དེ།",
    "བསྡུས་བསྒོམ་ཡོད་པར་བརྗོད་ཟིན།",
    "ས་བརྒྱད་པ་ན་རྒྱུ་རྣམ་རྫོགས་སྦྱོར་བ་ཁྱད་པར་ཅན་ཡོད་པའི་ཕྱིར།",
    "བརྒྱད་པ་ན་ཁྱེད་པར་ཅན་མ་ཡིན་པ་ཡོད་དེ།",
    "བདུན་པ་ན་རྒྱུ་རྣམ་རྫོགས་སྦྱོར་བ་ཁྱད་པར་ཅན་མ་ཡིན་པ་ཡོད་པའི་ཕྱིར།",
    "སབདུན་པ་ན་རྒྱུ་རྣམརྫོགས་སྦྱོར་བ་ཁྱད་པར་ཅན་མ་ཡིན་པ་ཡོད་པའི་ཕྱིར།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་དང་གཉིས་ཡོད་པར་བརྗོད་ཟིན་ཏོ།",
    "བསླབ་པ་སྨོས་པས་ནི་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ཞེས་པའི་དོན་དུའོ།",
    "དེས་བྱས་བྱས་པ་མིན་མཐོང་ནས།",
    "དེའི་འོག་དུ་འགྲེལ་པ་བྱས་པའི་ཕྱིར་སྐྱོན་མེད་དོ།",
    "རྣམ་པར་སྨིན་པ་གཞན་དུ་འདོད་ཅེས་པས་གཉིས་པ་ས་བརྒྱད་པན་ཡོད།",
    "རྣམ་པར་སྨིན་པ་ནི་འབད་མེད་དུ་སྨིན་པ་ཡིན་ཞིང་།",
    "ང་རྒྱལ་ཕྲ་དང་ང་རྒྱལ་མེད་པར་འདོད།",
    "སྨིན་བྱེད་སོགས་ཀྱིས་ཤེས་པར་བྱ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་ཁྱབ་པ་མེད་དེ་རྗེས་མཐུན་པ་སྦྱོར་ལམ་དུ་གསུངས་པའི་ཕྱིར་རོ།",
    "མཁྱེན་གསུམ་བསྡུས་སྒོམ་གྱི་འབྲས་བུ་སྐུ་ཕུན་སུམ་ཚོགས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡིན་ཏེ།",
    "བློ་མིག་དག་པའི་འཕགས་རྣམས་ཀྱིས་ཀྱང་ཐམས་ཅད་མཐོང་མ་ལགས།",
    "དང་པོ་ནི་ཐུབ་པའི་རྟོགས་པ་ཁོ་ན་རྣམ་མཁྱེན་དུ་རྟོགས་པའི་དོན་དུའོ།",
    "གཉིས་པ་ནི་ཐུབ་པའི་རྣམ་ཀུན་མཁྱེན་པ་ཉིད་དོ།",
    "ལྔ་པ་ནི་རྒྱུ་འབྲས་ངོ་བོའི་རྣམ་པ་མ་ལུས་པ་མངོན་སུམ་གྱིས་མཁྱེན་པ་རྣམ་མཁྱེན་ཡིན་ནོ་ཞེས་ཤུགས་ལ་བརྗོད་དོ།",
    "ཞེས་པའི་བར་སྤྱོད་པ་ཁྱད་པར་གྱི་ལེའུས་སོ།",
    "ཞེས་པ་ནས་བདུད་ཀྱི་རིགས་ཀྱི་ལྷ་རྣམས་ཀྱིས་ཚུགས་པར་དཀའ་བ་ཡིན་ནོ་ ཞེས་པའི་བར་རིམ་གྱིས་འཇུག་པས་བསླབ་པའི་ལེའུས་སོ།",
    "ངོ་བོ་གདམས་ངག་ཁྱད་པར་ལྔ་ལྡན་མཚན་ཉིད་དེ་བཅུའི་བདག་ཉིད་དག་ཏུ་ཤེས་པར་བྱ།",
    "གྲུབ་པ་ཕུན་སུམ་ཚོགས་པའི་དམིགས་པ་ནི་ངོ་བོ་སྒྲོ་འདོགས་བཅད་བྱ་ཁྱད་པར་སྒྲུབ་པ་པོས་རིམ་གྱིས་དམིགས་བྱར་གྱུར་པ་སྟེ།",
    "སྒྲུབ་པའི་ཆེད་དུ་བྱ་བ་མིང་ངོ་བོ་སྒྲུབ་པ་པོས་ཆེད་དུ་གཉེར་བྱ་ཁྱད་པར་མཐར་ཐུག་པ་སྟེ་ཆེན་པོ་གསུམ་གྱི་ཆེད་དུ་བྱ་བ་འདི་ཤེས་ཐེག་ཆེན་གོ་ཆའི་སྒྲུབ་པ་ནི་ངོ་བོ་གདམས་ངག་ཐོབ་པའི་བྱང་སེམས་ཀྱིས་རྫོགས་པའི་བྱང་སེམས་ཀྱི་རིགས་སུ་ངེས་པ་ལ་བརྟེན་ནས་དམིགས་ཡུལ་ནམ་མཁའ་སྒྱུ་མ་ལྟར་རྟོགས་ཏེ་ཆེན་པོ་གསུམ་གྱི་ཆེད་དུ་སྒྲུབ་པ་གང་ཞིག།",
    "ཁྱད་པར་སྦྱོར་བའི་བརྩོན་གྲུས་ཀྱིས་ཐེག་ཆེན་ལ་འཇུག་པ་སྟེ།",
    "སྒྲུབ་པ་ལས་སྲིད་ཞིའི་དགྲ་ལས་ངེས་པར་རྒྱལ་བ་ཐོབ་པ་ངེས་པར་འབྱུང་པའི་སྒྲུབ་པ་ནི་གང་ཞིག་ཁྱད་པར་གང་བསགས་པའི་བརྩོན་འགྲུས་ཀྱིས་ངེས་པར་སྒྲུབ་པ་སྟེ།",
    "རྣམ་པ་བརྒྱད་ཀྱི་བདག་ཉིད་འདི་ངེས་པར་འབྱུང་པའི་སྒྲུབ་པའོ།",
    "བྱང་སེམས་སྒོམ་ལམ་གྱི་བྱེད་པ་ནི་ངོ་བོ་བྱང་སེམས་སྒོམ་ལམ་གྱི་འབྲས་བུ་ཁྱད་པར་ཕུན་སུམ་ཚོགས་པ་སྟེ་ཀུན་ནས་གཞི་སོགས་དྲུག་གོ།",
    "ཐབས་ལ་མཁས་པ་མ་ཡིན་པས་རྣམ་མཁྱེན་འདོར་ཞིང་རིང་དུ་བྱེད་པའི་ངོ་བོ་གཞི་ཤེས་ཁྱད་པར་རྣམ་མཁྱེན་སྐྱེད་པའི་འགལ་རྐྱེན་དུ་གྱུར་པས་ཏེ་ཉན་རང་ལམ་གཉིས་སོ།",
    "ཐབས་ལ་མཁས་པ་ཉིད་ཀྱིས་རྣམ་མཁྱེན་ལ་རིང་བ་མ་ཡིན་པ་སྟེ་ཉེ་བ་ཉིད་ནི་ངོ་བོ་གཞི་ཤེས་ཁྱད་པར་རྣམ་མཁྱེན་སྐྱེད་པའི་མཐུན་རྐྱེན་དུ་གྱུར་པ་སྟེ་དངོས་དང་རྒྱུད་པས་བསྐྱེད་པ་གཉིས་སོ།",
    "གཉེན་པོའི་ཕྱོགས་ཀྱི་གཞི་ཤེས་ནི་ངོ་བོ་གཞི་ཤེས་ཁྱད་པར་ཆགས་པ་འགོག་བྱེད་དུ་གྱུར་པ་སྟེ།",
