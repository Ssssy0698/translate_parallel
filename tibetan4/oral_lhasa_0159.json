    "འོད་ཆེན་མ་བསྐུལ་པར་ཡང་མེལ་ཚེ་མཛོད།",
    "མི་མཐུན་རྒུད་པ་སེལ་བ་འདི་བཞེས་ལ།",
    "ཀོ་ལོང་རུ་ང་གང་ཡང་མི་མཛད་པར།",
    "ཁྱད་པར་སྙན་སྒྲོག་དུང་རིའི་རྩེ་ནས་བྱོན།",
    "མཛེས་པའི་ཁྲི་ལ་དགྱེས་པའི་གར་གྱིས་བཞུགས།",
    "ཡུལ་ཕྱོགས་མཐའ་དག་བདེ་ཞིང་སྐྱིད་པར་མཛོད།",
    "གྲོགས་དང་འགྲོགས་པའི་གནང་སྦྱིན་འཕེལ་བ་སྤྲོ།",
    "ཕྱོགས་ཀྱི་འཁོར་ལོར་རྫོགས་པར་གྱུར་ཅིག་གུ།",
    "རྗེས་ན་དཀྲིགས་པས་དགོངས་ཀློང་ཡངས་པར་ཞུ།",
    "དུས་མཐའི་མེ་ལ་རྒོལ་བའི་ཚུལ་ལགས་པས།",
    "ཞབས་ཀྱི་པདྨོས་བཀྲ་ཤིས་མཛད་པར་ཞུ།",
    "གང་ཅིར་ཏིང་འཛིན་ལྷོད་པ་མེད་པར་ཞུ།",
    "སངས་ཤིང་གསལ་བ་ཟླ་བའི་སྡོང་བུར་བཞུགས།",
    "ལེགས་ལྡན་ལ་སོགས་ལེགས་གསུངས་སྲུང་མ་རྣམས།",
    "ལེགས་པའི་གཡར་དམ་རྗེས་མཐུན་ལེགས་པར་སྒྲུབས།",
    "ན་ཚ་མི་རྟག་འགྱུར་བའི་ངང་ཅན་ཡིན་གཤིས་ཁ་སྔོན་ལས་ཅུང་ཟད་དྲག་ཏུ་ཕེབས་ཨེ་ཡོད་སོགས་ཀྱི་སྙུན་འདྲི་ཞིང་།",
    "ཧ་ཅང་མི་བདེ་བ་མེད་ཚེ་ཇི་ལྟར་གྱུར་གྱི་བཀའ་ལན་ཡང་གནང་འཚལ།",
    "ཁ་སྔོན་ཕྲན་ལ་གནང་བའི་འཕྲིན་བཞིན་དུ།",
    "ཁ་ཡིད་ཐོ་ཅོའི་ཕུང་པོ་སེར་ཀོང་པར།",
    "ཁ་སྦྱོར་བདེ་ཆེན་རྫོགས་ན་མཐོལ་ལོ་བཤགས།",
    "འཇམ་མགོན་སྨྲ་བའི་ཟླ་བར་ཕྱག་བྱས་ནས།",
    "བློ་བཟང་བློ་ཡི་བཞེད་པ་བསྐངས་ལགས་སམ།",
    "གང་དག་གང་འདིར་བདེ་ཞིང་དགེ་ལགས་གྲང་།",
    "ཞེས་བཞེས་སྤྲོ་ཅུང་ཟད་བཅས་ནོར་གླིང་ནས་ཕྲན་གྱིས་ཕུལ།",
    "ཆེད་དུ་སྨྲ་བ་རྒྱ་མཚོས་བསྔགས་པར་འོས།",
    "ལྔ་མངོན་ཤེས་པར་གྲགས་པའི་དྲང་སྲོང་གཙོས།",
    "ལྔ་རིག་མཁྱེན་པའི་ཁས་ལེན་ཤོར་ན་ནོངས།",
    "ཕལ་གྱིས་འགྲན་པར་མི་ནུས་དྲང་གཏམ་ལགས།",
    "ཤུགས་འབྱུང་རྡོ་རྗེ་གླུ་ཡི་འགྱུར་ཁུག་ལགས།",
    "ཏོག་ཏུ་ཐོབ་པ་ལྷ་སྲས་ཉིད་ལས་གང་།",
    "ས་ལ་གནས་པའི་ཀུན་མཁྱེན་སེངྒེ་རྩེན།",
    "ས་ལེ་སང་ངེ་འཚོ་གཞེས་དགེ་ལགས་སམ།",
    "ས་ན་ནོར་བུའི་འཁྲི་ཤིང་དཔར་གྱི་གཞིར།",
    "ལགས་དྲུང་ཉིད་དང་ཤཱི་ལའི་མཚན་ཅན་དེ།",
    "བས་པར་མཛའ་ཞིང་འདུན་པའི་སེམས་ཀྱིས་སོ།",
    "སྐུ་ཞབས་ཁྲི་བྱང་ཚང་ལ་ཆུ་བཟང་རི་ཁྲོད་ནས་སུམ་རྟགས་ཁྲིད་སྐབས་སུ་མཛད་པའོ། ། བློ་མཁྱེན་པ་བཀྲག་ཏུ་བཀྲ་བ་དག།",
    "ཤེས་ལགས་སམ་སྨྱུ་གུ་ཐོགས་པ་ཚོ།",
    "རྗེ་ཁྲི་ནས་གནང་ཞེས་སུག་པར་སྩལ།",
    "ལུས་ཉལ་རུང་ལངས་རུང་ཁྱད་པར་མེད།",
    "མཐུ་ལྡན་སྲུང་མ་སྤྱི་དང་ཁྱད་པར་དུ།",
    "བརྩེ་འཛིན་གྱི་གློག་ཞགས་འཁྱུག་པར་མཛོད།",
    "ལས་བྱས་པ་ཆུད་མི་ཟ་བ་དང་།",
    "ལས་མ་བྱས་པ་དང་མི་འཕྲད་པར།",
    "ལྷག་པར་ཡང་ཚེ་ལ་ཞིབ་ཏུ་བསམ།",
    "གནས་གར་འགྲོ་འདིར་འགྲོ་མེད་པར་འཁྱམས།",
    "ངན་ན་ཟློག་རིམ་ཇི་འདྲ་ཞུ་དགོས་ཞུས་པའི་ལན་དུ་གནང་བའོ།",
    "བཟོད་དཀའི་གདུང་བའི་རྡོ་ཆར་མི་འབེབས་པར།",
    "རྒྱལ་སྲས་དཔའ་བོའི་གཡུལ་ལས་མཆོག་ལགས་ཏེ།",
    "ཉམ་ཆུང་ལུས་ལ་འཇུག་པར་མ་སྤོབས་པ།",
    "ཤུགས་དང་མང་ཉུང་ཁྱད་པར་ག་ལ་ཡིན།",
    "ཡ་ང་མེད་པར་ཚོལ་བ་མཁས་པའི་ཕུལ།",
    "དམ་པར་འགྲོགས་ནས་དེ་ཡི་ཚིག་དང་སྟུན།",
    "ལྔ་རིག་ནོར་བུའི་གཞུང་མང་ཀློག་པར་མཛོད།",
    "དེང་སང་ཕན་པར་སྨྲ་བའི་དམ་པ་དཀོན།",
    "ཞི་བསིལ་བདུད་རྩིའི་ཁང་པར་འཛེག་པའི་སྐས།",
    "མཁྱེན་རབ་རལ་གྲིའི་རྣོ་རྒྱུན་འབར་བའི་འོད།",
    "མཁོ་རྒུའི་འབྱོར་བ་སྤྱད་པས་མི་ཟད་པར་འཛོམས་པའི་གྲོང་དང་གྲོལ་རྡལ་སྣ་ཚོགས།",
    "ཡང་སྒོས་ཁམས་ཚན་འདིར་སྔོན་ཆད་སྤྱི་ཁང་ཞིག་གསོས་བྱས་པའི་བུ་ལོན་ལྷག་ལུས་ཐོག་འབབ་ཡོང་གཞན་མེད་ཅིང་།",
    "ས་གནས་སོ་སོར་མཐུན་འགྱུར་རོགས་རམ་གང་དྲག་གནང་རྒྱུ་དང་།",
    "ཞབས་འདེགས་ཚུལ་བཞིན་ཞུས་པའི་སྐྱེ་འགྲོ་རྣམས་ལ་སྐྱབས་ཡུལ་གོང་མ་མཐུ་རྩལ་ཅན་རྣམས་ཀྱིས་སྡོངས་གྲོགས་མཛད་པར་བསྐུལ་བས་མཇུག་བསྡུ་བ་ནི།",
    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བས་དགེ་ལེགས་སྩོལ།",
    "ཆེད་བརྗོད་མེ་ཏོག་ཕྲེང་མཛེས་སྙིམ་པར་འགོད།",
    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བ་འཛམ་གླིང་རྒྱན།",
    "མཁྱེན་རབ་པིར་རྩེས་སྤེལ་བའི་ཆོ་ག་མཁན།",
    "སྙམ་འཇོག་སྙམ་སེམས་ཏིང་འཛིན་རློན་པར་མཆིས།",
    "སྐལ་བཟང་སྐལ་བར་བཞེས་ཐུག་འགྲན་མེད་དང་།",
    "རབ་གསལ་རབ་མཐའི་ཀུན་མཁྱེན་མི་ཚོལ་བར།",
    "ས་ཡོམ་ལས་འབྲས་མིན་པར་ཁས་བླངས་ནས།",
    "བདག་ཉིད་ཆེན་པོའི་མཛད་པར་སྨོན་ཅིང་མཆིས།",
    "ཁྲི་གའི་ལྷུན་འགྲུབ་ཀྱིས་འབྲས་ལྗོངས་ནས་ཞུ་ཡིག་ཕུལ་བའི་ལན་དུ་གནང་བའོ།",
    "ཞེས་གསུངས་པ་དང་འགལ་བ་ལྟག་སྤྲོད་དུ་སྣང་བས་སོ།",
    "ལྷུན་འགྲུབ་ལ་གནང་བའི་ཟུར་ཡིག་གོ།",
    "དེ་ན་གསེར་རི་བཞིན་དུ་ལྷུན་ཆགས་པར།",
    "མཛེས་པར་འགོད་པའི་མི་མཆོག་མི་ཡི་ལྷ།",
    "ཡིད་ཀྱི་ཚེར་མར་ཟུག་པ་རྩུབ་ལགས་ཏེ།",
    "ཉི་མའི་གཉེན་གྱི་མགུར་ནས་གསུངས་པ་དེས།",
    "དེ་སྲིད་མཚན་དཔེའི་འཕྲོད་བཞེས་མི་གཡེལ་འཚལ།",
    "ལྷ་སྡིངས་མདའ་དཔོན་སྐུ་ཞབས་གཞིས་ཀ་རྩེར་བཞུགས་པའི་དུས་སུ་ཕུལ་བའོ།",
    "ཁྱད་པར་དུ་ཀུན་མཁྱེན་ནམ་མཁའི་ནོར།",
    "ཨོ་ཟོབ་ཀྱི་ཁ་ཆུས་མ་སྦགས་པར།",
    "གཙང་སིང་ངེར་སྤེལ་ན་སྐྱིད་པ་ལ།",
