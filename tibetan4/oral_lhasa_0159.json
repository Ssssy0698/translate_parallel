    "པེ་སྣར་པར།",
    "༦་པེ་སྣར་བདུག་༩༢༦ ༡པེ་སྣར་རྗེད་པེ་སྣར་དག་པར།",
    "བྲིས་སྐུ་ལ་སོགས་པ་རབ་ཏུ་གནས་པ་བྱེད་པས་གང་རབ་ཏུ་གནས་པར་བྱ་བ་མཚན་ཉིད་དང་ལྡན་པ་དེའི་ཉེ་འཁོར་ཅིག་སྐྱང་ནུལ་བྱས་ཏེ།",
    "མདུན་དུ་མཎྜལ་གྲུ་བཞི་པ་ཁྲུ་གང་ཡན་ཆོད་ནས་ཇི་ཙམ་ནུས་པར་བྱུགས་ནས།",
    "དེའི་སྟེང་དུ་མཚན་ཉིད་དང་ལྡན་པའི་བུམ་པ་གསེར་ལ་སོགས་པའི་རྒྱུ་ལས་བྱས་པ་ཁ་རྒྱན་དང་།",
    "གྲངས་ཀྱང་གཅིག་ནས་བརྩམས་ཏེ་ཇི་སྙེད་འབྱོར་པ་གཞག་པར་བྱའོ།",
    "མེ་ཏོག་ལ་སོགས་པའི་ཡོ་བྱད་ཅི་འབྱོར་པ་རྣམས་ཀྱང་མདུན་དུ་སྟ་གོན་དུ་བྱས་ལ།",
    "བུམ་པའི་ཆུས་བཀྲུས་ལ་བུམ་པ་དེ་ཉིད་དུ་བཞུགས་པར་བྱའོ།",
    "དེའི་འོད་ཀྱིས་འཇིག་རྟེན་ཁྱབ་པར་བལྟས་ཏེ།",
    "གང་ཞིག་རབ་ཏུ་གནས་པར་བྱ་བ་མཆོད་རྟེན་ལ་སོགས་པ་དེའི་གཟུགས་ཀྱིས་བྱོན་ནས་དེ་དང་དེ་ལ་ཐིམ་པ་དང་།",
    "སྔགས་ལ་སོགས་པ་ཐམས་ཅད་རོ་གཅིག་ཏུ་གྱུར་པར་བསམས་ནས།",
    "དེ་ནས་དྲི་ཞིམ་པོས་བསྒོས་པའི་གོས་ཀྱིས་སྐུ་ཕྱི་བ་བྱས་པའི་རྗེས་ལ་ཅི་འབྱོར་པའི་ན་བཟའ་དང་རྒྱན་རྣམས་དབུལ་བར་བྱའོ།",
    "བདེན་འདི་གསུངས་པ་འདི་ལ་སྡིག་མེད་ཅིང་།",
    "ཞལ་ནས་གསུངས་པ་བསིལ་བའི་རོ་འདི་ཡི།",
    "ཁྲོན་པ་རྙིང་པར་དོར་ནས་ས་གཞི་ལྕི་བ་སར་པས་བྱུགས་ཏེ།",
    "སྤྱི་ལོ་༡༩༩༨ལོའི་ཟླ་༡༡པར་པར་གཞི་དང་པོ་བསྒྲིགསསྤྱི་ལོ་༡༩༩༨ལོའི་ཟླ་༡༡པར་པར་ཐེངས་དང་པོ་བཏབདཔར་གྲངས།",
    "ཤེས་རབ་རྒྱ་མཚོ་། རྗེ་བཙུན་ཤེས་རབ་རྒྱ་མཚོ་འཇམ་དཔལ་དབྱེ་ཀྱི་གསུང་རྩོམ་པོད་གཉིས་པ་བཞུགས་སོ།",
    "མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་། ། རྗེ་བཙུན་ཤེས་རབ་རྒྱ་མཚོ་འཇམ་དཔལ་དགྱེས་པའི་བློ་གྲོས་ཀྱི་གསུང་རྩོམ་པོད་གཉིས་པ་བཞུགས་སོ།",
    "གསོལ་བ་འདེབས་པའི་ཚིག་ལེའུར་བྱས་པ་པདྨ་དཀར་པོའི་འཁྲི་ཤིང་།",
    "དྲིས་ལན་དུ་བྱས་པ་ཕལ་གཏམ་སྨྱོན་པའི་བླ་རྡོལ།",
    "བླ་བྲང་དགོན་གཞུང་ལ་གནང་བའི་འཕྲིན་ཡིག་སོགས།",
    "སྒེའུ་སྟེང་བློ་བཟང་སོགས་ལ་གནང་བའི་ཕྱག་རིས་འགའ།",
    "གསེར་སྐྱེམས་འབུལ་ཚུལ་ལྷ་སྲུང་དགྱེས་པའི་སྒྲ་དབྱངས།",
    "དགུང་ལོ་བཅོ་ལྔའི་སྟེང་གནང་བའི་གསུང་རྩོམ་སོགས་རྩོམ་ཐུང་འགའ།",
    "བླ་བྲང་དགོན་གཞུང་སོགས་ལ་གནང་བའི་འཕྲིན་ཡིག་འགའ།",
    "རྗེས་བཟུང་བཀའ་དྲིན་གྱི་ངང་ཚུལ་དཔག་པར་དཀའ་བ།",
    "དམིགས་རྣམ་ཅུང་ཟད་ལྷན་ཐབས་སུ་སྤེལ་བ་དད་པའི་ཆུ་གཏེར་འཕྱུར་བའི་རྦ་རླབས་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "དམིགས་མེད་ཐུགས་རྗེའི་རྣམ་པར་རོལ་བའི་རླབས།",
    "བསྟན་པ་རྒྱས་ཕྱིར་བསྐལ་བརྒྱར་བཞུགས་སུ་གསོལ།",
    "མཁྱེན་བརྩེ་དྲན་སྒྲིབ་གཉིས་འཇིགས་པ་འཇོམས།",
    "སྲོག་གཅོད་མ་བྱིན་ལེན་དང་ལོག་པར་གཡེམ།",
    "བརྣབ་སེམས་གནོད་སེམས་ལོག་པར་ལྟ་བ་སྟེ།",
    "ཁྱད་པར་སྡོམ་པ་གསུམ་གྱི་མི་མཐུན་ཕྱོགས།",
    "བར་དུ་གཞུང་ལུགས་ཐམས་ཅད་གདམས་པར་ཤར།",
    "ཐ་མར་ཉིན་མཚན་ཀུན་ཏུ་ཉམས་བཞེས་ཏེ།",
    "གཉེན་པོ་བཞི་ཡིས་རིམ་པར་སྦྱངས་པའི་ཁམས།",
    "ཁྱད་པར་རྗེ་བཙུན་བློ་བཟང་གྲགས་པ་ཡི།",
    "དག་གཙང་ཙམ་གྱིས་ཉིན་མཚན་ཁ་སྦྱོར་ཞིང་།",
    "མཐོང་ཚད་བདེན་པར་འཛིན་པའི་ལྕགས་ཀྱུ་མིན།",
    "ཀུན་མཁྱེན་དག་གསལ་གསེར་མིག་ལྡོངས་པ་མིན།",
    "འཇམ་དབྱངས་མཁྱེན་རབ་རལ་གྲི་ཆག་པ་མིན།",
    "འཇམ་དབྱངས་མཁྱེན་རབ་ཉི་མ་ཞུ་བའི་ངོགས།",
    "ཟབ་གསང་དོག་པ་མངར་བོས་སྙེམས་པར་མཛོད།",
    "མཁྱེན་བརྩེ་མི་ཟད་གསང་བའི་འཕྲུལ་འཁོར་གྱིས།",
    "ཇི་ལྟར་བྱས་ཀྱང་དོན་དུ་འགྱུར་དཀའ་བ།",
    "མཁྱེན་རབ་གྲི་སོ་རྣོན་པོས་དུམ་བརྒྱར་གྲོལ།",
    "རྩེ་དགའ་བགྱིད་པས་མཁའ་དབྱིངས་དོག་བྱས་སྙམ།",
    "འབྲས་དཀར་སྤུངས་པར་སྙན་པའི་ཡིད་བཞིན་མཚོར།",
    "བག་ཕེབས་སྒྲ་བརྒྱ་ཉལ་བའི་རི་བོར་བསུས།",
    "འགྲོ་ཀུན་དམ་པའི་མགོན་གྱིས་མཛེས་པར་ཤོག།",
    "ཀུན་མཁྱེན་རྒྱལ་བ་རྣམས་དང་རྒྱལ་བའི་སྲས།",
    "སྤྱི་དང་ཁྱད་པར་མ་འདྲེས་ཕྲ་ཞིབ་ཏུ།",
    "འཇམ་དབྱངས་མཁྱེན་རབ་རལ་གྲིའི་རྗེས་འགྲོར་ཤོག།",
    "ཡངས་པའི་རྒྱལ་ཁམས་སྤྱི་དང་ཁྱད་པར་དུ།",
    "རྣམ་པར་དཀར་བ་དེ་དང་གཞན་རྣམས་ཀྱང་།",
    "སྨོན་པའི་དོན་རྣམས་ཡིད་བཞིན་འགྲུབ་པར་ཤོག།",
    "མཁྱེན་རབ་འོད་སྣང་འབུམ་དུ་གྲོལ་བའི་ཐུགས།",
    "སྡོམ་གསུམ་གཙང་མའི་མེ་ཏོག་མཆོག་ཏུ་འཛུམ།",
    "མཁྱེན་བརྩེ་ཡོན་ཏན་ནོར་བུའི་གཏེར་དུ་རྫོགས།",
    "རྣམ་འབྱེད་སྐྲ་རྩེའི་ཆ་ཡང་མི་སྤོབས་པར།",
    "བློ་བཟང་རྒྱལ་བའི་དགོངས་པར་འཁྲིལ་བ་ཡི།",
    "རབ་འབྱམས་ཕྱོགས་ཀྱི་འཁོར་ལོ་མཛེས་པར་མཛོད།",
    "མཚན་དཔེའི་མེ་ཏོག་བསྡུ་བ་མེད་པར་གསོལ།",
    "ད་དུང་དད་པས་གསོག་པར་འགྱུར་བ་གང་།",
    "བདག་ཅག་གཏོལ་མེད་མུན་པར་འཐོམ་པ་དང་།",
    "ལྷག་པར་མི་འཇིགས་གོ་ཆ་ལྷུར་བཞེས་ཤིག།",
    "སྨོན་པའི་དོན་རྣམས་ཡིད་བཞིན་འགྲུབ་པར་ཤོག།",
    "ཞལ་བཞེས་བདེན་པའི་ཁུར་དེ་མི་འདོར་བར།",
    "བསམ་པའི་དོན་རྣམས་ཡིད་བཞིན་འགྲུབ་པར་ཤོག།",
    "གཞལ་དུ་མི་བཟོད་སིམ་པར་བརྡལ་བའི་ཚུལ།",
    "མཉམ་པ་གསུམ་གྱིས་མཉམ་པར་གྱུར་པའི་སྐུ།",
    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་ལ་གསོལ་བ་འདེབས།",
