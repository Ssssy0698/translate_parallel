    "ཤར་ཕྱོགསཁ་བལྟས་འདུག་པར་བྱ།",
    "འབར་བའི་ནང་ན་འདུག་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་གྱི་ཕྱི་། རོལ་ཐོག་ཐག་ཏུ་འཇིགས་པ་མེད་པས་ཕྱག་མཚན་རྣམས་ཐམས་ཅད་པད་མ་ལ་འདུག་པ་བྲོ་བར་བྱའོ།",
    "རྒྱད་རིང་པོ་ན་འདུག་གོ།",
    "ལངས་འདུག་ཐུབ་མཚམས་ནས་གསེར་མཚོའི་བུལ་ཏོག་ཞུ་མཁན་རྒྱ།",
    "གྲིབ་ཕོག་དུས་ཐོག་མར་སྤོས་དཀར་གྱི་ཐང་བཏང་ན་བཅོས་སླ།",
    "མགོ་མ་གཏོགས་སྣོད་བཅས་རས་ཀྱིས་དཀྲིས་ལ་རླངས་པ་མ་ཤོར་བར་བྱས་ནས་དུས་ཆུང་གཅིག་རིང་འདུག་དེ་ནས་རས་ཕུད་ཆུ་ཕྱར།",
    "འབྲུ་ཆང་ལ་ཆུ་བརྒྱབ་ནས་བཙགས་པའི་ཆང་རང་ནུབ་ཙམ་བླུགས་ནས་བསྐོལ་ལ་ཕོག་བཅད་ནས་ཅུང་ཟད་བཞག་དེ་ནས་ཟངས་སྣོད་ཆེ་བར་བླུགས་ལ་སོ་ཁུ་དང་ཆུ་ཡིས་བོངས་བསྐྱེད་ལ་བསྐོལ།",
    "སྨྲ་བརྗོད་སེམས་ལས་འགྲོ་འདུག་སྤངས་ཏེ་བརྟག།",
    "མ་དང་རང་རྩ་དར་ན་རབ་ཏུ་བཟང་།",
    "འགྲོ་འདུག་སེམས་ལས་ཆུ་འཁྲུགས་སྤང་བར་བྱ།",
    "གྲང་ནས་ལྡོག་དུས་ལྡོག་ཚུལ་ལོག་རྗེས་བརྟག།",
    "ཆལྡོག་དུས་རླངས་མ་ཡལ་བར་ལྡོག་པ་ཚ།",
    "ཞེས་སོགས་འདུག་བྱེ་རིང་སེམས་ཀྱི་བདེ་སྐྱིད།",
    "འདི་ལ་འདྲ་མིན་འདུག་པ་འདི་ལྟ་སྟེ།",
    "འུ་སུ་ཤིང་མངར་བཀྲ་འབུམ་གཅེས་བསྡུས་ལ་པྲི་ཡང་ཀུ་ཤིང་མངར་མན་མཛད་འདུག་གཟེ་མ་དེ་ཀུན་དང་།",
    "ཚ་གྲང་རང་རང་སྐབས་བརྩིས་པའི།",
    "ཁྱད་པར་འབྲུམ་པ་མི་ཐོན་དཔེ་མི་སྲིད།",
    "ཞེས་གསུངས་འདུག་ཟླ་འོད་ནོར་ཁྱུང་།",
    "གུ་གུལ་དང་ནི་མཚལ་སྣོན་ལུགས་གསུམ་འདུག།",
    "སྦྱར་བ་ཐོ་རངས་དུས་བཏང་རོ་ཙ་ནི།",
    "ཤར་གྲོལ་རིས་མེད་ཉིན་མཚན་བར་མེད་བླང་དོར་མཐའ་འདས་དགག་བསྒྲུབ་མཉམ་དག་དུས་གསུམ་གྱི་མཚན་མ་བློ་ལས་འདས་ཤིང་།",
    "སྔ་མ་ཚེས་འདི་ལ་འཐེན་ཁྱེར་སྣ་ཚོགས་བྱས་འདུག་ཀྱང་འདི་ལྟ་བུའི་ཐ་སྙད་སྦྱོར་སྒྲུབ་པ་གཅིག་ཀྱང་མ་བྱུང་གསུངས་གསུང་།",
    "སྔོན་པོ་ཁ་མཁར་ཐོག་ཏུ་ཞུགས་ཙ་ནཁ་བ་བབས་པ་ལ་དོནུབ་གཞོན་ནུ་མ་བདུན་གྱི་རྟོགས་བརྗོད་ལས།",
    "ཞེས་དེ་ལ་གླགས་ཚོལ་ཞིང་འདུག་གོ།",
    "དོན་དུ་སྐྱེས་བུ་གསུམ་གྱི་ལམ་ལ་རིམ་པ་བཞིན་འདུག་དགོས་ཏེ།",
    "ཁྱེད་རང་ལས་འདི་ལ་ཁུར་དུ་ལྟོས།",
    "འགྲོ་འདུག་ཉལ་འཆག་སོགས་ཅི་བདེར་མི་བྱས་པར་བག་ཟོན་ཆེན་པོས་ཟླ་བ་བཅུའི་བར་གཅེས་པར་བཟུང་།",
    "ཁོ་བོས་ཕྱུག་བོར་གཏོང་བ་འདུག།",
    "བོད་གར་ཁ་བརྒྱུད་ཟེར་ཡང་དག་འདུག་རིགས་རུས་མི་འཆོལ་ཞིང་ཁྲེལ་ཡོད་བསྲུང་བའི་ཕྱིར་བག་མ་གཏོང་ལེན་གྱི་སྲོལ་འཛུགས།",
    "དགུང་ལོ་བརྒྱ་དང་བཅུ་གཅིག་གོདེ་ཙ་ན་མངའ་འོག་པ་རྣམས་ཀྱིས་རྒྱལ་པོ་དེའི་ཡོན་ཏན་དང་དྲིན་ལ་བསམས་ཞེས་ཁང་པ་གཙང་མར།",
    "བདག་བས་གཞན་གཅེས་ཀྱི་ལྷག་བསམ་རྣམ་དག་དང་རང་བཞིན་གྱིས་ལྡན་པའི་སྐྱེས་བུ་ཁྱད་དུ་འཕགས་པ་ཞིག་མ་གཏོགས་མི་རུང་བར་དགོངས་ནས།",
    "ཉེ་སྐོར་བ་ཐམས་ཅད་ཀྱིས་མགུ་ཞིང་རངས་པར་གྱུར་ཏེ།",
    "ཁམས་རྒྱལ་ཁྲི་ཕྲག་གང་ཡོད་པ་རྣམས་བསྡུས་ནས་བཟང་ངན་གྱི་ཚོད་བགམ་ཞིང་གོ་སའི་ཚུགས་ཐུབ་བརྟགས་ཙ་ན།",
    "ཀླུ་མ་རུངས་བ་ཞིག་འགྲུག་འཇིགས་སུ་རུང་བའི་གཟུགས་ཀྱིས་ཐོ་འཚམས་པར་བརྩམས་ཙ་ན་།",
    "དག་སྣང་ཆེ་བ་སོགས་ཀྱི་ཡོན་ཏན་མང་བས་རྒྱ་ནག་པ་ཐམས་ཅད་ཀྱི་ཡོའུ་ཞུན་ཆུང་ངུར་འབོད་ཅིང་རང་ལོ་ཞེ་དྲུག་ཐོག་ཁྲི་འདོན་བྱས་པ་སྟེ་ཁྱུང་ཐུང་ལོ་བཞི་ཊི་ཡུའན་སོ་གཅིག་བཅས་ལོ་སོ་ལྔར་ས་སྐྱོང་བྱས་ལ།",
    "དེ་རྗེས་དེའི་བུ་ཆེ་བ་རྒྱལ་ཚབ་ཨ་སུ་ཀི་པས་དེ་བས་སྔོན་དུ་ཁྱི་ཕག་ཅེས་སྣང་ཡང་རྒྱའི་ཡིག་ཚང་ན་འདུག་པ་བཞིན་བྲིས།",
    "ནང་པར་བལྟས་ཙ་ན་ཤར་ལྷོའི་ཕྱོགས་སུ་ཞལ་བསྒྱུར་འདུག་ཟེར།",
    "དེའི་དུས་སུ་རྒྱ་ནག་ཕན་ཚུན་འགྲུལ་ལམ་ཐར་མ་མྱོང་འདུག་གཤིས་མངོན་ཤེས་ཀྱིས་རིག་པར་གོར་མ་ཆག་གོལས་སྟོན་པ་ཅུང་ཙི་ཞེས་བྱ་བས་རྨང་ལམ་དུ་ཕྱེ་མ་ལེབ་རྨིས་ནས་སད་རྗེས་མནོ་དཔྱད་བཏང་བས་ཅིར་ཡང་སྣང་ལ་ཅིར་ཡང་མ་གྲུབ་པའི་དོན་གྱི་རྟོགས་པ་ཐུགས་ལ་འཁྲུངས་པ་སོགས་མང་ལ།",
    "མནལ་སད་ཙ་ན་རྒྱ་སྐད་ལ་རྒྱ་མི་དང་ཁྱད་མེད་པས་ཐམས་ཅད་ངོ་མཚར་སྐྱེས།",
    "སྟོང་ཕྲག་ཉི་ཤུ་ལྔ་པ་སྤྱན་དྲངས་ཏེ་ལོག་ཙ་ན།",
    "ཆུ་མེད་པས་ཐོགས་པ་ན་ཕུག་ཅིག་ན་ཕྱག་འཁར་བཙུགས་ཏེ་འདིར་ཆུ་མི་གཅིག་འདུག་ན་གསུངས་མ་ཐག་དེ་ཉིད་དུ་ཆུ་ཡུར་གྱིས་བརྡོལ།",
    "རལ་གྲི་བསྣམས་ནས་འདུག་སྟེ་མི་ཞིག་བཏང་ནས་སློབ་དཔོན་ལ།",
    "ད་ཅི་རྒྱལ་པོ་མ་མཐོང་བ་གང་ན་འདུག་གང་ལྟར་འདུག་ཅེས་འདྲི་རུ་བཏང་བ་འབྱོར་མ་ཐག་འདྲི་ལོང་མ་བྱུང་བར་སློབ་དཔོན་གྱིས།",
    "ལྕང་མའི་ལྕག་མར་སྔགས་བཏབ་ནས་བརྒྱབས་པས་རོ་བསླངས་ནས་འདུག་ཐུབ་པར་གྱུར།",
    "སྐྱབས་དགོས་པར་འདུག་གསུངས་ནས།",
    "ཞལ་ཆེམས་སུ་སྤུར་ཞོག་གསུངས་འདུག་པས་ཞུགས་མ་ཕུལ་བར།",
    "ཕྱིས་གཞན་མན་གྱིས་ས་སློག་རྡོ་སློག་བྱས་ཤིང་ཤི་གསོན་མ་ལུས་པ་ལ་སྡུག་པ་སྟེར་བའི་ཞོར་ལ་སློབ་དཔོན་གྱི་བང་སོ་དང་སྤུར་ཁང་ཡང་ཕྱེ་སྟེ་བལྟས་ཙ་ན།",
    "ལྷུང་བཟེད་དང་འཁར་གསིལ་མ་གཏོགས་མེད་འདུག་པ།",
    "སད་ཙ་ན་དངོས་པོ་དེ་གཉིས་པང་ན་འདུག་སྐད།",
    "འོན་ཀྱང་རང་བཞིན་གྱིས་དབེན་གནས་ལ་དགའ་བས་ཕྲིན་ལས་དེ་ཙམ་མི་ཆེ་ལ།",
    "ཧྥན་ཤན་ཟེར་བའི་རི་ཁྲོད་ཉམས་དགའ་བ་ཞིག་ལ་འཆག་འདུག་བྱེད་ཙ་ན།",
    "ལན་གཅིག་ལྷུང་བཟེད་བསྣམས་ནས་ཆུ་ལེན་དུ་ཕྱིན་ཙ་ན།",
    "ལམ་འཕྲང་ཤིན་ཏུ་དོག་པར་བྱ་གག་གཤོག་པ་ཡ་གཅིག་ཆག་པ་ཞིག་ལམ་ཁ་ན་འགྲེ་ལྡོག་བྱེད་ཅིང་འདུག་པ་མཐོང་ནས་ལམ་གཞན་མེད་ཀྱང་འགུལ་སྐྱོད་ཀྱིས་གནོད་དུ་དོགས་ཏེ་སྤྱིལ་བུར་ལོག་མ་འགྲུངས་བར་སྐོམ་གྲིར་འདས་སོ།",
    "བྲུས་པས་ཇི་ལྟ་བ་བཞིན་འདུག་པ་བླངས་ནས་སྤྱི་ཐེབས་བྱས་ཏེ།",
    "བསྟན་པ་དང་འགྲོ་བ་ལ་ཕན་ཐོགས་པ་རྣམ་པ་སྣ་ཚོགས་མང་པོ་སྔ་ཕྱིར་བྱུང་འདུག་གོ།",
    "ཁ་ཆེའི་པཎྜི་ཏ་བུ་དྷཱ་ཧུན་སོགས་འགུགས་པ་དང་རང་བྱོན་བསྡོམས་པ་འཕགས་ཡུལ་གྱི་པཎ་གྲུབ་བདུན་བརྒྱུས།",
    "ཆུ་མིག་དང་ནགས་ཚལ་གྱིས་བརྒྱན་ཞིང་ཉམས་དགའ་བ་ལ་བྱ་སྐད་སྙན་པར་སྒྲོག་པ་འགའ་ཞིག་མ་གཏོགས་མི་མེད་པས་འདྲི་མས་དབེན་ཀྱང་ཉམས་དགའ་བས་ངལ་དུབ་མི་ཚོར་བར་ལེ་དབར་ཁ་ཤས་བགྲོད་ཙ་ན།",
    "དེར་སྔར་གྱི་དགེ་སྦྱོང་དེ་འདུག་པ་བྱུང་ནས་བསུས།",
    "ཚང་མ་ཡིད་དུ་འོང་ཞིང་གཟི་རྗིད་ཆེ་བ་ཁོ་ནར་འདུག་ཟེར།",
    "ཟམ་ཆུང་བརྒལ་ནས་བལྟས་ཙ་ན།",
