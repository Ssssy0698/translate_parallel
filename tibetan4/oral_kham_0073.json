    "དེ་ལྟར་སྙམ་བཞིན་ཁོའི་མིག་ངོར་རྡོ་རྗེའི་གདོང་རིས་མངོན་སུམ་དུ་འཆར་བ་དང་རྡོ་རྗེས་དོན་གྲུབ་རང་ཉིད་ལ་མི་འདོད་པའི་རྣམ་འགྱུར་སྟོན་བཞིན་ཨ་ཇོ་དོན་གྲུབ།",
    "ཁྱེད་རང་ངའི་ནང་དུ་འབག་གྱོན་ནས་ཕེབས་པ་ཨེ་ཡིན་ཞེས་དང་།",
    "རྡོ་རྗེས་དོན་གྲུབ་ཡར་འཛུལ་ཡོང་བ་མཐོང་རྗེས་དེ་རིང་གཞི་ནས་ཐེངས་གཅིག་ཕེབས་བྱུང་ཞེས་དོན་གྲུབ་གདན་དུ་འཁོད་དུ་བཅུག་པ་དང་ལམ་སེང་རང་ཉིད་ཀྱི་དངུལ་བཤན་ཕོར་པ་དེ་སྤྲད་ནས་ཆང་བླུགས།",
    "ཁྱེད་རང་དེ་འདྲ་སེམས་ནས་དྲན་ཡང་ཞལ་ནས་གསུངས་ཡོད་ཀྱི་འདུག་གམ།",
    "སྐད་ཆ་ཕྱི་ནང་ཤེས་ཀྱི་མི་འདུག་ཅེས་མཁང་ར་བྱས།",
    "སེམས་སྡུག་ཐེ་ཚོམ་སོགས་ཀྱི་སྐད་ཆ་མང་དག་ཅིག་དུས་གཅིག་ཏུ་སྨྲས་ནས་ཧ་ལམ་གཞན་གྱིས་སྐད་ཆ་ཤོད་དུ་མ་བཅུག་དོགས་ལྟར་བྱེད།",
    "མི་མང་པོ་འདི་འདྲའི་ཁྲོད་དུ་ངའི་གདོང་ལྤགས་བཤུ་དགོས་བསམ་གྱི་འདུག་གམ་ཞེས་སྐད་ཆུང་ངུས་སྨྲས།",
    "ཁོ་གཉིས་ནི་ཧུར་བརྩོན་ཅན་འདྲ་འདྲ་ཡིན་པས་གཅིག་བྱས་ན་ཁོའི་ལས་འགན་དེ་ཨ་ཇོ་ལ་སྤྲད་ཡོད་ཀྱང་སྲིད།",
    "དེ་རིང་ཡང་ཞོགས་པ་སྔ་པོ་ནས་བོང་བུར་རྩྭ་སྟེར་བ་དང་རང་ཁྱིམ་གྱི་བོང་བུ་རྒས་འཁོགས་དེའི་སྒལ་པར་བྱམས་བརྩེ་ཆེན་པོས་བྱིལ་ཙམ་བྱས།",
    "ཁོའི་ཨ་ཞང་ཟླ་བ་ད་ཆ་རང་ཁྱིམ་དུ་ཡོང་བ་ཧ་ཅང་ཉུང་ཞིང་།",
    "དོན་གྲུབ་ཀྱིས་རང་ཉིད་ཀྱི་བསམ་ཚུལ་རྣམས་དེ་རིང་ཨ་ཞང་ཟླ་བ་ཁྱིམ་དུ་ཡོང་བའི་སྐབས་དང་བསྟུན་ནས་སྨྲས་པར་ཟླ་བས་མནོ་བསམ་ཡུད་ཙམ་བཏང་བ་དང་དེ་ནས་ནན་ཏན་གྱིས་དོན་གྲུབ།",
    "ད་དུང་ང་ཡང་འདིར་ཉལ་དགོས་ཟེར་གྱི་འདུག་ཅེས་བཤད།",
    "གཅིག་བྱས་ན་སྤེན་པར་ཁོག་པ་རྐྱོང་མཁན་ཡོད་པ་ཡིན་འགྲོ།",
    "པ་ཕ་ཁྱེད་རང་ཞེས་དྲིས།",
    "ད་ནི་ཉི་མ་གནམ་ལ་ཤར་ཚད་ལ་ངལ་རྩོལ་བྱེད་པར་འགྲོ་དགོས་པས་ལྟོ་ཆས་ཀྱིས་ཀྱང་འགན་བཟོད་པ་མི་འདུག་ཅེས་བཤད།",
    "ཡིད་མ་ཆེས་ན་ཁྱེད་རང་ལྟོས་ཨང་།",
    "སྒྲོལ་མས་ཧ་གོ་བ་ཙམ་མ་ཟད་སྤྱང་པོ་ག་ཚོད་མི་འདུག་གམ།",
    "སུས་ཟེར་གྱི་འདུག་གམ།",
    "དོན་གྲུབ་ཀྱིས་ལམ་སེང་ཁྱེད་རང་སྐད་ཆ་དེ་འདྲ་ཤོད་མཁན་ཡོད་དམ།",
    "ད་དུང་ཡང་ཡོང་མཁན་མིན་འདུག་ཅེས་འཁང་ར་བྱས།",
    "དགུན་གྱི་ཉི་མ་ད་དུང་རྒྱང་ཙམ་བསྡད་ཡོད་པས་བུ་ཁྲིད་ཀྱིས་ཉི་མར་ལྟ་ཙམ་གྱིས་ཨ་ཙི།",
    "ད་ནི་ར་ལུག་ཀྱང་ལོག་སླེབས་ཀྱི་འདུག་པས་ལས་ཐག་གཅོད་རོགས་གནང་ཞེས་བརྗོད།",
    "སྐྱིལ་ཀྲུང་དུ་བསྡད་པའི་རྐང་པ་གཉིས་ཀྱང་རང་བཞིན་གྱིས་བརྐྱངས་རྗེས་མགོ་བོ་སྒུར་སྒུར་གྱིས་ག་ལེར་ཡར་ལངས།་",
    "དེ་ནས་སྟོད་ཡར་དགྱེ་ཙམ་བྱས་པ་དང་དོན་གྲུབ་ལ་ཉེ་ཙམ་བྱས་ཏེ་ཅུང་ཤོད་མི་བདེ་བའི་ཚུལ་གྱིས་ཨ་ཇོ་དོན་གྲུབ།",
    "ཁོ་སྒོ་འགྲམ་དུ་སླེབས་སྐབས་སྒྲོལ་མ་ཡར་ཡོང་བ་དང་ཏག་ཏག་འཕྲད་ཀས་སྒྲོལ་མས་འཛུམ་ཙམ་གྱིས་ཁྱེད་རང་གང་དུ་ཕེབས་པ་ཡིན་ནམ།",
    "ཁོའི་སྐད་ཆའི་མཇུག་སྒྲིལ་ཁོམ་མ་བྱུང་གོང་སྒྲོལ་མས་ངས་ཤེས་ཀྱི་འདུག་དེ་བས་ཁྱེད་རང་ངའི་སྐད་ཆ་ཉོན་དང་།",
    "རྐང་པར་ཀོ་ཏོ་ལྷམ་ཀླད་བརྒྱབ་ཅིང་ཁ་སྒྲོག་ཀྱང་ཅུང་འཐོར་བ་ཞིག་གྱོན་ནས་རྐང་པ་གཡས་པ་ཅུང་འཐེང་བཞིན་དེ་གར་སླེབས་མ་ཐག་དོན་གྲུབ་ཡར་ལངས་ནས་ཨ་ཞང་ལ་སྡོད་ས་གཟུར།",
    "མི་གསོད་ཀྱི་འདུག་ཡུལ་ལུང་པའི་མི་ཚོ་མགྱོགས་པོ་ཤོག་མི་གསོད་ཀྱི་འདུག་ཅེས་སྐད་ལྷད་མེད་བརྒྱབ།",
    "སུས་དེའི་སྐོར་འདྲི་ཡི་འདུག་གམ།",
    "མི་དེ་ཚོར་ལྟ་སྐབས་ཀྱང་དེ་འདྲའི་རྒྱང་ཐག་རིང་ལ་རྒྱུས་མངའ་མེད་པ་ལྟར་དུ་སྣང་སྟེ་རང་ཉིད་ནི་འཇིག་རྟེན་འདིའི་སྟེང་དུ་གཅིག་པུར་གནས་པ་ལྟ་བུའི་སྣང་བ་དང་རང་ཉིད་ཀྱི་གོམ་སྒྲ་ནི་དེ་འདྲའི་རྐྱང་པ་དང་ཡུལ་ཡུལ་པོའི་སྣང་བས་ཡོངས་སུ་ཁེངས།",
    "མི་དེ་ཚོས་ང་ལ་རྒྱུས་མངའ་གཏན་ནས་མེད་པ་ལྟར་བྱེད་ཀྱི་འདུག་ཅེས་འདྲི་བཞིན་དེ་མ་ཐག་རང་ཉིད་ཀྱི་སེམས་ནང་དུ་དེ་ནི་ཕུན་ཚོགས་དང་འབྲེལ་བ་ཡོད་པའི་གཏན་ངན་ཞིག་ཡིན་པ་དང་།",
    "ཨ་ཅེ་དེ་ཅི་འདྲ་ཞིག་འདུག་གམ།",
    "ཆུ་འཐོར་ནས་ཕྱུ་པ་རློན་རྐྱང་བཟོས་འདུག་ཆུ་ཁ་མཐོ་ནས་ཐུག་ཆུ་མི་ཉན་ཟེར་བས།",
    "བུ་ཁྲིད་ཀྱིས་འཛུམ་མདངས་ཅུང་བསྡུས་ནས་ཨ་ཙི།",
    "ཁྱེད་རང་སེམས་ཁྲལ་བྱེད་དགོས་མེད་ཅེས་བཤད།",
    "ལྷག་རྡོར་གྱིས་བསམ་བློ་གཏོང་སྐབས་དངོས་གནས་རང་ཉིད་ལ་ཡོད་པ་ནི་སྐར་ཆའི་ལག་དེབ་དེ་རང་ལས་མེད་པ་དང་སྐར་ཆ་མང་པོ་ཡོད་ཀྱང་དེས་ཕྱི་ལོ་མ་གཏོགས་ཕན་མི་ཐོགས་པས་ཁོ་གཉིས་ལའང་ཁག་མི་འདུག་སྙམ།",
    "ཁྱེད་རང་ཐུགས་ཁྲལ་གནང་མི་དགོས།",
    "དཀར་ཐིག་མ་བརྒྱབ་ན་ཁང་པ་ནག་སྟོང་སྟོང་ཞིག་མི་འདུག་གམ་ཞེས་དྲིས་པ་དང་འདྲེན་བྱེད་གཉིས་ནི་སྔར་བཞིན་གྱང་ལྡེབས་ཀྱི་དཀར་ཐིག་གསལ་ལ་མི་གསལ་དེ་ལ་ལྟ་བཞིན་ཡོད།",
    "ལྷག་རྡོར་གྱིས་ག་དུས་ཡིན་ནའང་རང་ཉིད་ནི་ཤ་རྒྱས་ཁྲག་རྒྱས་ཀྱི་སྐབས་ཡིན་པས་ཅི་ཞིག་ལའང་ཉམ་ང་མི་དགོས་པར་རྫས་མདེལ་དང་བཟའ་ཆས་སོགས་ཁྱེར་ནས་འགྲོ་རྒྱུ་དང་ཐ་ན་གཡུལ་ས་མདུན་མར་འགྲོ་དགོས་བྱུང་ནའང་ཐེ་ཚོམ་དང་སྐྲག་སྣང་ཅི་ཡང་བྱེད་མི་དགོས་པའི་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད།",
    "ངའི་དོ་ཆས་བཤིག་ནས་ལྟ་སྐབས་རྩམ་པ་ནི་མང་ཤོས་ཀྱི་གྲས་ཡིན་པས་ཡག་པོ་འདུག་ཟེར།",
    "བུང་བའི་སྡོད་རྟེན་མི་འདུག་སྤེན་པར་ཀུ་རུ་འཁེལ་བས།",
    "བསམ་བློ་ཇི་ཙམ་བཏང་ཡང་རང་ཉིད་ཀྱི་བྱེད་སྟངས་ནི་དེ་དང་འབྲེལ་བ་གཏན་ནས་མི་འདུག་སྙམ་བཞིན་སླར་ཡང་སྐབས་དེའི་གནས་ཚུལ་ཐར་ཐོར་ཞིག་ལ་བསམ་བློ་མི་གཏོང་ཀ་མེད་བྱུང་།",
    "སྐད་ཆའི་ཤོད་སྟངས་ཚང་མར་འགྱུར་ལྡོག་ཆེན་པོ་བྱུང་ནས་ག་དུས་ཡིན་ནའང་སྐད་ཆ་ཐད་ཀར་འདྲི་བ་དང་།",
    "མ་གཞི་ནས་རང་ཉིད་ཀྱི་ལྟ་བ་ཆག་རོགས་ཡིན་འགྲོ་ཞེས་བཤད།",
    "ཕུན་ཚོགས་ཀྱི་སྐོར་ཡིན་འགྲོ།",
    "ཁ་ཤས་ཀྱིས་ཞིམ་པོ་མི་འདུག་ཟེར།",
    "ཡང་ཁ་ཤས་ཀྱིས་གྲོ་ཞིབ་བཏགས་ཚེ་ལྟོ་ཆས་བཟོ་རྒྱུ་དེ་རྙོག་དྲ་ཚ་པོ་འདུག་པས་དེ་ལས་གྲོ་རྩམ་བཏགས་ན་ཡག་པ་འདུག་ཟེར།",
    "རྫུས་མ་ཡིན་ཐག་ཆོད་འབྱོར་རྒྱུས་ཧྲུའུ་ཅི་ཡིན་འགྲོ།",
    "ཝང་ཀྲང་ཅང་ཡའོ་ཟེར་གྱི་འདུག་ཅེས་བཤད།",
    "མི་འདི་ཚོར་བྱེད་རྒྱུ་འདུག་ནམ་དུས་སྟོན་ཁ་ཡིན་ནའང་ད་དུང་ཞབས་བྲོ་བརྒྱབ་ནས་སྡོད་ཁོམ་འདུག་ལྟོས་ཨང་།",
    "བསོད་ནོར་གྱིས་ཕུན་ཚོགས་ལ་ཆང་གང་བླུགས་པ་དང་ཧ་ཅང་ཡིད་ཕམ་པའི་ཚུལ་གྱིས་དེ་རིང་ངས་ཁྱེད་རང་ལ་འགྱོད་གཤགས་ཞུ་བར་བཅར་བ་ཡིན་པས་མ་གཞི་བྱས་ན་འདི་ལས་ཆེ་ཙམ་དགོས་ནའང་དེང་སྐབས་ཆང་ཡག་པོ་གཏན་ནས་ལངས་ཀྱི་མི་འདུག་པས་ཧུའུ་གང་པོ་འདིའང་ཁྱིམ་མཚེས་ཀྱི་ས་ནས་གཡར་བ་ཡིན་ཞེས་བཤད།",
    "བསོད་ནོར་གྱིས་ང་རང་སྐབས་དེར་རྦད་དེ་མགོ་འཐོམ་དྲགས་འདུག་དེ་དུས་ང་ལ་སྣང་བ་གཏན་ནས་མ་བྱུང་ནའང་ལྷག་རྡོར་གྱིས་ཟེར་ན་ཁྱེད་རང་དང་ངའི་ཨ་ཅེ་འགབ་མཐུན་བྱེད་ཀྱི་འདུག་པས་སོ་སོའི་ཨ་ཅེ་ལའང་བདག་པོ་རྒྱག་ཐུབ་ཀྱི་མི་འདུག་གམ་ཞེས་དྲན་སྐུལ་བྱས་བྱུང་བས་ངས་ཁྱིམ་དུ་ལོག་ནས་ཨ་ཅེ་བརྡུངས་པ་དང་སྐད་ཆ་འདྲི་སྐབས་ཁས་གཏན་ནས་མི་ལེན་པ་མ་ཟད།",
    "ཁྱེད་རང་སུ་ལ་གསུངས་ཀྱི་ཡོད་དམ་ཞེས་ཟུར་ཟའི་ངང་ནས་དྲིས།",
    "བརྒྱུད་གཅིག་དུས་ཆེན་གྱི་ཉིན་དང་པོ་དང་གཉིས་པར་ཀུང་ཧྲེ་ཡོངས་ཀྱི་མི་རྣམས་ཀུང་ཧྲེ་གནས་ཡུལ་གྱི་གླིང་གཤོངས་རུ་ཁག་ཏུ་འཛོམས་པ་དང་།",
    "ཁོའི་བཞིན་ལ་བལྟས་ཚེ་ཁོང་ཁྲོ་རབ་ཏུ་འབར་བ་དང་མིག་ལས་ཁྲོ་བའི་ཉམས་ཤིག་མངོན་གྱི་ཡོད་པས་ལྷག་རྡོར་ཡང་རང་ཉིད་ཀྱིས་ཅི་ཞིག་ནོར་བ་མ་ཤེས་ལ་ལྷག་པར་དུ་སྤེན་པ་ནི་རང་ཉིད་ལྟར་གཟུགས་སྟོབས་ཆེ་ལ་དམག་མི་ལས་ལོག་པ་ཞིག་ཡིན་པས་ཁོ་ཅུང་དཔའ་ཞུམ།",
    "རྟ་ཕོའི་ཇུས་གཏོགས་གཡག་ལ་མི་འདུག་ཨང་དཀར་རྭ་ཅོ་བཙུམས་ནས་སྡོད།",
    "ད་ནི་ཉེན་ཁ་འདུག་པས་གཡུག་ཞོག་ཅེས་སྐད་བརྒྱབ་ནའང་ལྷག་རྡོར་གྱིས་ཨུ་ཚུགས་བྱས་ཏེ་བསྐོན།",
    "ཕུན་ཚོགས་ཟེར་མཁན་གྱི་མི་དེ་དེང་སང་སྤོབས་པ་མཐོ་རུ་གང་འདྲ་ཕྱིན་མི་འདུག་གམ།",
    "རྟག་པར་སྒྱུར་ཙག་ཙག་ཁོ་ན་ལངས་ཀྱི་ས་འདུག་ཅེས་བཤད།",
    "ཕ་མ་སྤུན་མཆེད་ཚོས་ཤེས་རྗེས་མག་པ་དེ་དུས་ཚོད་སྔ་སྣུར་གྱིས་བླངས་ཏེ་ཕྲུ་གུའི་པ་ཕ་བྱེད་དུ་འཇུག་དགོས་སྙམ་ནའང་སྟོན་འབྲས་ད་དུང་སླེབས་རྒྱུ་ཡིན་པས་བུའི་ཁྱིམ་ནས་ཁྱིམ་ཚང་གཉིས་ཀའི་འབྲུ་རིགས་ཀྱི་གནས་ཚུལ་ལ་བལྟས་ཏེ་སྟོན་འབྲས་སླེབས་ན་མ་གཏོགས་ཡོང་བ་མི་འདུག་ཅེས་ཁ་ཆད་བྱས་པའི་དུས་ཚོད་དེ་མ་སྒུག་ཀ་མེད་བྱུང་།",
    "ཕག་པར་ཇུས་གཏོགས་མི་འདུག་ཕག་པ་ཕག་ཚང་ནང་དུ།",
    "སྤྱི་ཐུག་ལ་སྒེར་ཚྭ་བརྒྱབ་པར་གཞན་གྱིས་ཐུགས་རྗེ་དང་ཡག་བྱུང་ཞེས་ཤོད་མཁན་སུ་འདུག་གམ།",
    "ཁ་ཤས་ཀྱིས་ཟེར་ན་གྲོ་དང་སྲན་མ་བསྲེས་ནས་བཏགས་ན་ཡག་པོ་འདུག་ཅེས་ཟེར་གྱི་འདུག་ཅེས་ཤོད་བཞིན་དེ་གར་བསྡད།",
    "དེང་སྐབས་ཟླ་རྒྱགས་རྒྱག་མཁན་མང་ཐག་ཆོད་འདུག་ཅེས་བཤད།",
    "ད་ཆ་སོ་སོ་ལ་ཕྲུ་གུ་ཞིག་ནི་འདུག་ཚེ་མཇུག་ཕྲུ་གུ་འདི་ལ་བློ་གཏད་བཅོལ་ན་མི་འགྲིག་པ་ཅི་ཡོད།",
    "གསར་བརྗེའི་བཀའ་དྲིན་ལས་རྒྱན་ཆ་འདོགས་དགོས་ནི་མི་འདུག་ཅེས་བཤད།",
    "དེང་སང་མི་ཚང་མ་གྲ་རྒྱས་སུ་ཕྱིན་ནས་གྱོན་ཆས་རྗེས་ཟིན་པ་མི་འདུག་ཅེས་བཤད།",
    "དེང་སང་ཁྱིམ་ཚང་ནང་དུ་བུ་གཉིས་ཡོད་པ་ལས་འཐུས་སྒོ་ཚང་བ་མི་འདུག་ཅེས་བཤད།",
    "རྒྱལ་པོ་གླང་དར་མའི་དབུ་ལ་རྭ་ཅོ་ཡོད་ཀྱང་འདུག་ཞུ་ས་མི་འདུག་ད་ལྟ་ལས་ཀ་ཚར་དགོས་ཚོར་བས་མིའི་རྩིབ་མ་བཤེར་ནས་ཅི་བྱེད།",
    "སྤེན་པ་ཡང་གང་འཚམས་བཟི་ཡོད་པས་ཕུན་ཚོགས་ཀྱི་འཁྲིས་སུ་བསྡད་དེ་བུ་ཁྲིད་ཀྱི་འབོད་ཚུལ་ལྟར་ཨ་ཇོ།",
