    "དེ་གང་ན་འདུག་ཀྱང་ཐེ་ལེ་ལེ།",
    "རང་རང་སོ་སོའི་ཚེ།",
    "བཟོད་པའི་བླག་མེད་པའི་སྡུག་བསྔལ་མྱོང་དགོས་པར་འདུག་པ་འདི་ལྟ་བུ་མི་སྐྱེ་བའི་གདེང་ཅུང་ཟད་ཀྱང་མེད་ཅིང་།",
    "སྐྱེས་ན་དེ་འདྲའི་སྡུག་བསྔལ་ལ་བཟོད་ཐབས་མི་འདུག་ཅིང་།",
    "ཐར་བའི་དུས་མི་འདུག་པས་ཅི་ནས་ཀྱང་མི་སྐྱེ་བ་ཞིག་བྱེད་དགོས།",
    "གང་ལྟར་ཡང་སྐྱབས་ཡུལ་དང་རང་སེམས་འདྲེས་པའི་བརྗོད་མེད་ཀྱི་ངང་དུ་ཅི་ཙམ་གནས་ཀྱི་བར་དུ་གཞག་རྣམ་རྟོག་ཅིག་ཐོལ་གྱིས་སྐྱེས་པ་ན།",
    "དེ་བཟོད་པའི་ཐབས་ནི་མི་འདུག་མི་བཟོད་བཞིན་དུ་དེར་མི་སྐྱེ་བའི་གདེང་ནི་ཅིའང་མེད་པའི་ཁར།",
    "ངེས་པར་སྐྱེ་ཐག་ཆོད་འདུག་སྐྱེས་ན་དེ་འདྲའི་སྡུག་བསྔལ་བཟོད་པའི་བླག་དང་།",
    "བྱུང་བའི་ཤུལ་ཙམ་ཡང་མི་འདུག་པས་ཡི་མུག་ཅིང་ག་ཆད་ལ་ཅི་བྱ་ཟད་པ་ན།",
    "ཐུར་ལ་ཆགས་སེམས་དང་འཇིགས་སེམས་ཀྱིས་འགྲིལ་གྱིན་མཆོངས་ཀྱིན་མགྱོགས་པར་ཕྱིན་པས་ལྕགས་ཀྱི་ཚེར་མ་ཐམས་ཅད་ཁ་གྱེན་ལ་ཕྱོགས་པས་ལུས་ཐམས་ཅད་ཕུགརྩ་བར་སླེབས་ཙ་ན་གྲོགས་ལ་སོགས་པའི་རྗེས་ཙམ་ཡང་མེད།",
    "བྱ་རྒོད་ཕུང་པོ་ནས་ཕར་ཙམ་གྱི་བར་སྣང་སྟོང་པ་ལ་མི་དབྱིབས་ལུས་ཚད་ཁང་པ་གཉིས་ཙམ་བྱས་པ་ལ།",
    "ལུས་ཀྱི་ཕྱི་ནང་ཐམས་ཅད་མེ་འབར་བའི་སྡུག་བསྔལ་མྱོང་བ་ཞིག་འདུག་དེ་བཤན་པ་ཕྱུགས་མང་པོ་གསོད་པ་དེར་སྐྱེས་པ་དང་།",
    "དེ་ནས་ཚུར་ཙམ་གྱི་བར་སྣང་ལ་མིའི་རྣམ་པ་ལུས་བོང་ཆེ་བ་ཞིག་ལ་འབྲས་བུ་རིའི་གཏོས་ཙམ་ཐུར་དུ་འཕྱང་བ།",
    "ལུས་དང་འབྲས་བུའི་བར་ཤའི་ཐག་པ་རྟ་རྔ་ཙམ་གྱིས་སྦྲེལ་ནས་སྡུག་བསྔལ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་འདུག་པ་ནི་རྟ་བོང་སོགས་ཕྱུགས་ལ་བྱ་གཅོད་བྱས་པའི་རྣམ་པར་སྨིན་པ་དེ་ལྟར་མྱོང་བ་སྟེ་གསུམ།",
    "ནམ་ལ་ཅིང་བདེ་སྐྱིད་མཐའ་ཡས་པར་འདུག་པ་ལ།",
    "གླ་རྣམས་དུས་ལ་མ་བླང་པར་ལན་ཅིག་རྩིས་བྱས་པས་མང་པོ་བྱུང་འདུག་པ་ཐམས་ཅད་ཁོང་ལ་ཕུལ།",
    "དེ་དག་ཀྱང་བཟོད་པའི་བླག་མི་འདུག་པས་ཅིས་ཀྱང་དེར་མ་སྐྱེས་པ་ཞིག་བྱ་དགོས་པར་འདུག་པ་སོགས་གོང་བཞིན་བསམ་པར་བྱའོ།",
    "ཟན་གྱི་རི་བོ་ཆེན་པོ་འདུག་པ་མཐོང་།",
    "སྡུག་བསྔལ་དེ་ཙམ་སྤྱད་ནས་ཕྱིན་པས་འཁྲིས་སུ་སླེབས་ཙ་ན།",
    "སའམ་དཀར་གོང་ལྟ་བུའི་ཕུང་པོར་གྱུར་ནས་ཟན་ལ་སོགས་པ་བྱུང་བའི་ཤུལ་ཙམ་ཡང་མི་འདུག་པས་ངུ་ཞིང་འགྲོ་ལྡོག་པ་དང་།",
    "སྔར་ཕན་ཆད་གང་ལ་འདུག་པ་དེར་འདོད་ཡོན་ལ་ཡེངས་ནས་ལྷོད་དེ་གནས་པ་ལ།",
    "སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་རྒྱུ་ལ་ལོངས་སྤྱོད་ཀྱིན་འདུག་པས།",
    "དེ་དག་དེ་བས་ཀྱང་ཆེས་ལྷག་པའི་བྱང་སེམས་རྣམས་ལའང་རང་དོན་ལས་ལྷག་པའི་ཉན་རང་འཕགས་པ།",
    "དེ་ལྟར་བཞག་པའི་ཚེ་ན་སེམས་དང་མེ་ཏོག་འདྲེས་པ་ཆམ་མེ་ཤིག་གེ་འདུག་ན་རང་སོ་བཟུང་བ་ཞེས་བྱ་སྟེ་བཅས་བཅོས་ཅིའང་མི་བྱེད་པར་དེ་ཀའི་ངང་ལ་འཇོག་སེམས་གཞན་དུ་འཕྲོ་ན་ཚུར་བཀུག་ནས་སྔར་བཞིན་བསྒྲིམ།",
    "ཕ་མ་རྣམས་ཧ་ཅང་སྡུག་བསྔལ་ཡུན་རིང་དྲག་འོང་འདུག་པས།",
    "གསུངས་ཡོད་པར་འདུག་སྙམ་དུ་རང་གཞུང་ལ་བརྟེན་ནས་ཡིད་ཆེས།",
    "སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "བདེ་བའི་སྟན་ལ་བསམ་གཏན་གྱི་རོལ་པས་འདུག་སྟེ།",
    "མེད་ན་ནི་བེམས་པོ་དང་ཁྱད་མེད་དུ་འདུག་པ་ལས།",
    "ད་ལྟ་གྱ་གྱུ་ཧྲིག་ཧྲིག་འདུག་པ་འདི་ཡིན།",
    "ཁོ་རང་རྐྱང་འདེད་བྱས་དུས་འོང་འོང་འདྲ་པོ་ཡིན་པ་ལ།",
    "དཔེ་མེད་ཀྱི་ཐུགས་དམ་པར་བྱེད་པ་ཚེཡུལ་དུ་སླེབས་ཙ་ན།",
    "རྫི་ཆོམ་མེ་བའི་ངང་ལ་འགྲོ་ཡིན་གདའ་བ་འདི་རྣམས་སྣང་བ་སེམས་སུ་ངོ་མ་ཕྲོད་པའི་སྐྱོན་དུ་གདའ།",
    "འོན་ཀྱང་འདི་འདྲའི་ཚོད་ན་ཅུང་མི་ཟབ་པར་གདའ་གསུངས།",
    "ལམ་དུ་ཐག་པ་ཞིག་ཡོད་པ་མཐོང་མ་ཐག་སྦྲུལ་འདུག་གོ་སྙམ་དུ་འཇིགས་སྐྲག་པས་བྲོས་པའི་ཚེ།",
    "དགྲ་ལ་ཞེ་སྡང་སྐྱེས་ན་ང་རང་འཁྲུལ་པ་ཡིན།",
    "འདུག་བཟའ་བཏུང་སོགས་ཐམས་ཅད་ལ།",
    "སྔ་མ་ཁོ་རང་འབར་བཞིན་དུ་གནས་པའོ།",
    "གཡའ་བ་དེ་ཚུལ་འདི་ལྟར་འདུག་ཅེས་བརྗོད་མི་ཤེས་པ་ལྟ་བུའོ།",
    "གང་ཟག་དེའི་བློ་ཡུལ་དུ་ཟླ་བ་དེ་འདི་འདྲ་ཞིག་ཡོད་པར་འདུག་སྙམ་དུ་དོན་སྤྱིའི་རྣམ་པར་འཆར་བ་བཞིན།",
    "སེམས་ཀུན་གཞི་ཁོ་རང་ངོ་མ་ཤེས་པའི་ཚེ།",
    "དངོས་གཞི་དཔེ་དྲན་པ་རིག་པ་སྐད་ཅིག་མ་འདི་ལས་ལོགས་སུ་གྲུབ་པ་ཏིལ་འབྲུ་ཙམ་ཡང་མི་འདུག་སེམས་ཀྱི་ངོ་བོ་སོགས་མེད་པས།",
    "དེ་དག་ཀྱང་སོ་སོའི་སྣང་ངོ་ཙམ་དུ་འདུག་ངོ་བོ་ཟུང་འཇུག་ལས་མ་འདས་པར་འདུག་སྙམ་དུ་ངེས་ཤེས་སྐྱེ་བ་ཡིན་གསུངས།",
    "བསྒོམ་བྱའི་དོན་ལ་ཐོས་བསམ་གྱིས་སྒྲོ་འདོགས་གཅོད་པ་ཙམ་ཞིག་བྱས་པའི་ཚེ་ཡིན་པར་འདུག་སྙམ་པའི་གོ་ཡུལ་ལམ་མེ་བ་ལས་རྒྱུད་ལ་མ་སྐྱེས་པ།",
    "གསལ་ཐེབས་པ་ན་དེ་དང་རང་སེམས་དབྱེར་མེད་དུ་བསྲེས་ནས་ཆམ་མེར་འཇོག་གསལ་ན་གསལ་ཏེ་འཕྲོ་གཅད།",
    "ཡང་སྔར་བཞིན་ཞི་གནས་དང་འདྲེས་ནས་རྟོག་མེད་དུ་ཆད་དེ་གནས་ཀྱིན་འདུག་ན་སྤོ་མི་དགོས།",
    "ཟླ་བ་འབུམ་ཕྲག་དུས་གཅིག་ཏུ་ཤར་བ་ལྟ་བུ།",
    "མདུན་གྱི་ལྷ་དང་རང་སེམས་བསྲེས་ནས་བརྗོད་མེད་དུ་ཆམ་ཆམ་འཇོགདེ་ལྟ་བུ་ལ་སོགས་པས་གོམས་སུ་འཇུག་སྟེ།",
    "ད་ང་ཤི་འདུག་སྙམ་དུ་སྡུག་བསྔལ་བསམ་གྱིས་མི་ཁྱབ་པ་འབྱུང་།",
    "དེ་ལྟར་རྨི་ལམ་བཟུང་བས་རྨི་ལམ་གྱི་སྐབས་སུ་འདི་ལྟར་རྨི་ལམ་གྱི་སྣང་བར་འདུག་སྙམ་པ་ཤར་བའི་ཚེ།",
    "བདག་རྒྱུད་བྱིན་གྱིས་བརླབ་པར་གསོལ་བ་འདེབས་ཤིང་རང་ལ་བསྟིམ།",
    "འདུག་སྟངས་སྔར་ལྟར་ལས།",
    "སྤྱན་སྔར་འདུག་སྟེ་འདི་སྐད་གསོལ།",
    "སྤྱན་སྔར་འདུག་སྟེ་ཞེས་བྱ་བ་ནི་རྗེས་མ་ཡིན་པ་སྤང་བར་བྱ་བའི་ཕྱིར་རྒྱབ་དང་ལོགས་སུ་ནི་མི་འདུག་གོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག།",
    "གང་ཡང་རང་ཉིད་མེད་པ་དེ་ནི་སྐྱེ་བ་མེད་དེ།",
    "ཨ་ར་པ་ཙ་ནཱ་མ།",
    "ཕྱོགས་རྣམས་སུ་ར་པ་ཙ་ན།",
