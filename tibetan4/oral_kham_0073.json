    "རྫི་ཅོམ་མེ་ནི་བྱུང་གདའ་གསུངས།",
    "འུ་ཅག་ལ་བླའི་མཆོད་གནས་ཞིག་དགོས་པར་དགོས་པར་འདུག་པས་སུ་འཐད་དགོངས་པ་ན།",
    "ཁོང་རང་གསུམ་པོས་ཕྱག་འདོན་མཛད་ནས་བསྙེན་བཀུར་འབུལ་བ་བསམ་གྱིས་མི་ཁྱབ་པ་མཛད།",
    "དེ་ནས་ལེང་ཡང་དེ་ན་ཡོད་འདུག་པས་ཁོང་རྣམས་ལྷན་ཅིག་ཏུ་རིམ་གྱིས་བལ་པོར་བྱོན།",
    "རྒྱལ་པོ་ཙ་ན་ཀ་ཞེས་བྱ་བས་ལོ་གསུམ་གྱི་བར་གསོལ་བ་བཏབ་ནས།",
    "ཁྱེད་རང་ཡང་དེར་གཏོད་ལ་ཤོག་གསུངས།",
    "ཧ་ཅང་གྲགས་པའི་རྣམ་པས་ནུབ་ཕྱོགས་ཀྱི་རྒྱལ་པོ་བྷོ་ཛནྟ་ཧ་ར་ལ་སོགས་པའི་རྒྱལ་པོ་བཅོ་ལྔའི་དམག་དཔག་ཏུ་མེད་པ་ཉིན་ལམ་ལྔའི་ས་ན་སླེབས་ཡོད་པར་འདུག་རྒྱལ་པོ་འདི་གཡོ་སྒྱུ་ཁྲམ་གསུམ་ཆེ་བས་ལན།",
    "ཙ་ན་ཀས་གྲུབ་ཆེན་དཔའ་བོ་རྡོརྗེའི་མཚན་ནས་སྐད་ཆེན་པོས་ཐེང་གསུམ་བོས་པའི་རྗེས་སུ་གྱད་དེ་ལ།",
    "ཙ་ན་ཀ་དང་ཕ་རོལ་གྱི་རྒྱལ་པོ་དྲག་པོ་དེ་གཉིས་ཉི་མ་ཕྱེད་ཀས་ཙམ་གྱི་བར་དུ་ཐམས་ཅད་སྦྱིན་གསུངས་པས།",
    "ཙ་ན་ཀ་འཁོར་དང་བཅས་པ་གཡུལ་ལས་རྒྱལ་ཞིང་།",
    "འདི་པ་ཅིར་གདའ་གསུང་བསྟན་པས།",
    "ཐམས་ཅད་ཁ་མཐུན་པར་འདི་པ་གསེར་དུ་གདའ།",
    "གསེར་གྱི་ནང་ནས་ཀྱང་བཟང་ཐག་ཆོད་པ་འདི་ལྟ་བུ་གདའ་ཞུས་པས།",
    "སྐུ་གདུང་བསྒུལ་བས་དྲོད་མ་ཉམས་པར་བཞུགས་འདུག་པ་ལ།",
    "དེ་དག་རྐུན་མས་ཁྱེར་གྱིས་དོགས་ནས་དེའི་དབུས་སུ་ཁོང་རང་གཟིམས།",
    "དུས་མཚུངས་ཀྱི་སྐྱེ་བོ་དྲག་ཞན་ཕལ་ཆེ་བས་བསྟེན་ཅིང་འདུད་པ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "ཁོང་རང་རྒྱལ་པོས་མ་བཏང་བར་འབུལ་མི་བརྫངས་ཏེ།",
    "ག་ཡ་དྷ་རའི་ཐུགས་དམ་ཀྱེ་རྡོར་གྱི་བྲིས་སྐུ་ཞིག་ཡོད་པའང་ཁོང་ལ་སྐྱེས་ལན་དུ་བསྐུར་བར་གདའ་གསུངས།",
    "གཙོ་བོར་ཐུགས་དམ་ལ་དྲིལ་བ་ཞིག་བྱུང་བར་གདའ་གསུངས།",
    "ང་བཟང་སྙམ་པ་ནི་དུ་མ་གདའ།",
    "ཐམས་ཅད་མཐུན་སྣང་དུ་གྲུབ་པའི་འགྲན་ཟླ་ཐམས་ཅད་དང་བྲལ་བ་ནི་འབྲོག་མི་ལོ་ཙཱ་བར་གདའ་སྟེ།",
    "དེ་ནི་ཁྱེད་རང་ཐག་ཉེ་བས་རྒྱུས་ཆེའམ་ཟེར་བ་ལ།",
    "ཁོང་རང་རྟ་བཟང་པོ་གཅིག་ལ་ཞོན།",
    "ཨ་ཇོའང་ཡིན་པ་ཞིག་བདོག་པས་དེ་ལ་ཞུས་ནས་མ་བྱས་པར།",
    "དེར་ཨ་ཇོ་རྒྱལ་ལེ་ལ་ཞུ་ཡིག་བསྐུར་ཏེ་དགོངས་པ་ལེན་དུ་བཏང་བས།",
    "ཁྱེད་རང་ལ་བར་ཆད་ཀྱི་ལྟས་ཅུང་ཟད་གདའ་བས་དེ་ཟློག་པའི་ཐབས་ལ་འབད་པ་མཛོད་གསུངས་ནས་བཀའ་ཁྲོལ།",
    "དེ་འཁོར་ནས་འོངས་བ་ན་ཁོང་བྱིས་པའི་ཁྲོད་ན་རྩེ་ཞིང་བཞུགས་འདུག་པས།",
    "འདི་ངེད་ལ་དགོས་པ་གདའ་གསུངས་ནས་ཁྱེར།",
    "ཁོང་རང་མི་དེ་ཙམ་དུས་གཅིག་ཏུ་བསད་པས་ཐུགས་སྐྱོ་སྟེ་མཐུ་རྣམས་གཅུང་པོ་འོད་ཟེར་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་བསླབས།",
    "ཁྱེད་དག་གཞོག་སློང་བྱེད་པར་འདུག་སྟེ།",
    "ཁྱེད་རང་ཡུལ་དུ་མི་འགྲོ་བར་བསྡད་པས་ཆོག་གསུངས་པ་ལ།",
    "ཁོང་རང་ཡང་ཐུགས་ཅུང་ཟད་ཆད་དེ།",
    "ངའི་སྣོད་བརྟགས་པར་འདུག་པ་ལ་ངས་དེ་མ་གོ་བས་ཅུང་ཟད་ལན།",
    "ཁྱེད་རང་རྣམས་གདམས་ངག་ཞུས་ན་ངའི་དཀའ་སྤྱད་ཙམ་མི་དགོས་པར་གདམས་ངག་གནང་བར་འདུག་བྱ་བ་ལ་སོགས་པའི་ཞལ་ཆེམས་བཞག་ནས་མྱ་ངན་ལས་འདས།",
    "ཁོང་རང་རི་ལ་གཡག་འཚོ་རུ་བྱོན་པས།",
    "དེ་ནས་ཕ་ཚད་ཕྱིན་པ་ན་གཞོན་པ་འདྲ་སྤང་རྐོ་ཡིན་འདུག་པའི་ཙར་བྱོན་ནས།",
    "དེའི་ནང་ནས་ཀྱང་མང་མཁར་མུ་གུ་ལུང་བྱ་བའི་ཐད་ཡིན་པར་གདའ།",
    "ཁོང་རང་ལ་ཤིན་ཏུ་བརྩེ་བའི་ཞང་པོ་སྟོན་ཆུང་དར་ཡེ་བྱ་བ་ཞིག་ཡོད་པ་དེའི་རྩར་བྱོན་ནས།",
    "གྲོས་ཁམ་པོ་ཆེ་འདྲའང་འདྲི་རྒྱུ་འདུག་པས་དོན་ནུབ་འགོལ་ས་ཞིག་ཏུ་འབྱོན་པས།",
    "བདག་སེམས་ལ་བརྗོད་མི་ཤེས་པ་ཞིག་གདའ་ཞུས་པས།",
    "དེ་པད་དུང་སྡོད་འདུག་གམ་གསུངས།",
    "བསྡད་གདའ།",
    "སྟོན་ཁ་མིརྣམས་བྲེལ་དུས་ཁྱེད་རང་གཞན་ཚོ་ལས་ཀ་གཞན་ས།",
    "ད་ལྟའང་ལུས་མ་སྤངས་པར་ཏི་སེ་ན་བཞུགས་པར་གདའ་གསུངས།",
    "ཁོང་རང་འཁོར་གསུམ་སོགས་ཁྱེར་ཏེ་བྱོན་པས་སིལ་མ་ལ་ཁར་ལསྟོད་པའི་ཚོང་པ་མངཔོ་ལོག་འགྲོ་བ་དང་ཕྲད་ནས་བསྡོངས་ཏེ་བྱོན་པས།",
    "ཤ་ཕྱེད་གཅིག་ཆང་བུམ་གཅིག་རྣམས་སྐུ་སྐལ་ལ་འདུག་པས།",
    "བླ་ཆེན་གྱི་ཞལ་ནས་སྔར་གྱི་དེས་ཁོ་འགྲངས་པའི་ཚན་མིན་པར་འདུག་པས།",
    "བླ་ཆེན་གྱིས་གྱད་བྲན་དུ་བཀོལ་འདུག་ཟེར་ཁྲོམ་ཐོག་ཆོད།",
    "ང་ཁ་སྐོམ་གྱིན་འདུག་པས་ཆང་བླང་ཟེར།",
    "ཆབ་ཆེན་ཞིག་འདུག་པ་དེར་གསོལ་བ་གཡོས་ནས་དྲོངས།",
    "འོ་ན་ཁྱེད་ཀྱང་བདུད་ཀྱིས་ཁྱེར་ནས་གདའ་ཨང་གསུངས་པས།",
    "ངེད་སྦྱིན་བདག་རྣམས་ཀྱང་དད་པ་འགྲོཁྱེད་རང་རྣམས་ཀྱང་ལེགས་པ་ཡིན་ཏེ་ཞེས་གསུངས།",
    "དེར་ཁོང་རང་སྐུ་མཆེད་ཀྱང་ཤིན་ཏུ་དད་ནས་བསྙེན་བཀུར་ཕྲན་ཚེགས་མཛད་པ་ན།",
    "ཁོང་འགྲོ་གྲབས་སུ་གདའ།",
    "བརྒྱུད་པ་འདིའི་སྲོལ་གྱིས་ཕར་གནང་བའི་སྲོལ་ནི་མི་འདུག་ཁྱེད་སྐུ་མཆེད་ཀྱིས་གྲོས་ཐོབ་གསུང་བ་ནཞངསྟོན་གྱི་ཞྭ་མ་ལྕམ་ལམ་འབྲས་ཁོག་ཕུབ།",
    "ཁྱེད་ཐུགས་ལའང་ཤིན་ཏུ་དགེས་པར་གདའ་བས།",
    "ཁྱེད་ཀྱི་སྐུ་དྲིན་གྱིས་ངེད་རྣམས་ལའང་ཕན་པར་གདའ་ཞུས་པས།",
