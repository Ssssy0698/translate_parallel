    "ཐ་དད་པ་ཡང་དག་པར་ཤེས་པའི་ཚུལ་རྒྱ་མཚོའི་སྤྲིན་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་ལ་ཡང་རབ་ཏུ་ཞུགས་པར་གྱུར་ཏོ།",
    "སྤྱོད་པ་རྒྱ་མཚོའི་སྤྲིན་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་ལ་ཡང་རབ་ཏུ་ཞུགས་པར་གྱུར་ཏོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་དང་ཡེ་ཤེས་མ་འདྲེས་པའི་ཚུལ་རྒྱ་མཚོའི་སྤྲིན་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་ལ་ཡང་རབ་ཏུ་ཞུགས་པར་གྱུར་ཏོ།",
    "མྱ་ངན་ལས་འདས་པ་བསྟན་པ་རྒྱ་མཚོའི་སྤྲིན་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་ལ་ཡང་རབ་ཏུ་ཞུགས་པར་གྱུར་ཏོ།",
    "ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ཐམས་ཅད་མ་ལུས་པར་བག་ལངས་པ་ཙམ་དུ་གཡོས་ཏེ།",
    "ཀུན་ཏུ་རྣམ་འཕྲུལ་རྣམ་པར་འདི་འདྲ་སྟོན་པར་བྱེད།",
    "ཐམས་ཅད་དབྱངས་ཀྱིས་ཆགས་པ་མྱེད་པར་རྒྱ་ཆེ་སྒྲོག།",
    "རྒྱལ་བ་ཀུན་གྱི་སྤྱོད་ཡུལ་ཡངས་པ་གང་བྱས་ཏེ།",
    "ཞིང་རྣམས་ཀུན་ཏུ་རྣམ་པར་འཕྲུལ་པ་མང་པོ་སྟོན།",
    "ཏིང་འཛིན་རྣམ་པར་འཕྲུལ་པ་ཐམས་ཅད་མ་ལུས་སྟོན།",
    "ལུས་ཀྱི་སྤྲིན་ནི་འགྲོ་བ་ཀུན་དང་མཉམ་པར་ཀུན་བཀྱེ་ཞིང་།",
    "རྣམ་པར་འཕྲུལ་པ་འདི་འདྲ་དམ་པ་ཚད་ཀྱང་མེད།",
    "རྣམ་པར་འཕྲུལ་པ་དམ་པ་སྟོན་པར་རབ་ཏུ་སྣང་།",
    "ཞིང་རྣམས་འབྱམ་ཀླས་ཀུན་ལ་བཞུགས་མྱེད་ཀྱང་།",
    "རྡུལ་སྦུབས་ཀུན་ཏུ་དེ་དག་ཆུད་བྱས་ཤིང་།",
    "ཞིང་རྣམས་ཀུན་ཏུ་རྣམ་པར་རབ་ཏུ་མཛེས།",
    "རྡུལ་དང་མཉམ་པའི་བསྐལ་པར་ཀུན་ཀྱང་སྣང་།",
    "ནམ་མཁའི་དབྱིངས་ནི་ལུས་ཀྱིས་གང་བྱས་ཤིང་།",
    "མཐའ་ཡས་པར་ནི་བཟང་པོའི་སྤྱོད་སྤྱད་པ།",
    "ཀུན་ཏུ་བཟང་པོའི་ཏིང་ངེ་འཛིན་དང་རྣམ་པར་འཕྲུལ་པ་རབ་ཏུ་བྱུང་བ་ཞེས་བྱ་བ་སྟེ་ལེའུ་གསུམ་པའོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ལ་རྣམ་པར་བལྟས།",
    "དུས་རྒྱ་མཚོ་ལ་རྣམ་པར་བལྟས།",
    "གཟུངས་ཀྱི་སྟོབས་ཡང་དག་པར་བསྐྱེད་པ་དང་།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་དགའ་བའི་ཤུགས་རྒྱ་མཚོ་རྣམ་པར་འཕེལ་བར་བྱ་བའི་ཕྱིར།",
    "འདི་དག་ཐོས་ཤིང་དགའ་བ་ཐོབ་པར་འགྱུར།",
    "གཞན་གྱི་ཡུལ་གྱིས་ཤེས་པར་མྱི་ནུས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ཡུལ་དང་མཐུ་ཡིན་ནོ།",
    "ད་ལྟར་བྱུང་བ་རྣམས་ཀྱིས་གསུངས་སོ་གསུང་ངོ་གསུང་བར་འགྱུར་རོ།",
    "འདི་ལྟ་སྟེ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ཡོངས་སུ་དག་པར་བྱ་བའི་ཚུལ་ཤིན་ཏུ་བསྟན་པ་དང་།",
    "ད་ལྟར་བྱུང་བ་རྣམས་ཀྱིས་གསུངས་སོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་འཇུག་པའི་སྒོས།",
    "དད་པ་རྒྱ་མཚོ་རྣམ་པར་སྤེལ་བའི་ཕྱིར།",
    "རྣམ་པར་སྣང་མཛད་རྒྱ་མཚོའི་ཞིང་མྱི་ཟད།",
    "ཚུལ་གྱི་ཁྱད་པར་མཐའ་ཡས་སྣ་ཚོགས་པས།",
    "རྒྱན་གྱི་རྣམ་པ་ཚུལ་ཀུན་རབ་ཏུ་མཁྱེན།",
    "དེ་ནས་བཅོམ་ལྡན་རྣམ་པར་སྣང་བ་མཛད་ཀྱི་འཁོར་ལོ་རྟག་ཏུ་འཁོར།",
    "ཀུན་ནའང་རྣམ་འཕྲུལ་འདི་དག་རྒྱ་ཆེན་རྣམ་པར་སྣང་མཛད་སྟོན་པ་མཛད།",
    "ཞིང་རྡུལ་ཀུན་ལ་ཀུན་ཏུ་བཟང་པོ་རྟག་པར་རབ་ཏུ་སྒྲུབ་བྱེད་ཅིང་།",
    "དེ་ན་བསྐལ་པ་རྒྱ་མཚོར་འགྲོ་བ་སྨིན་པར་བྱ་ཕྱིར་སྤྱད་པ་སྤྱོད།",
    "མཁའ་ལ་གནས་པ་དེ་དག་རྟག་པར་འབྱུང་ཞིང་འཇིག་པར་དེ་བཞིན་འགྱུར།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་འབྱམ་ཀླས་པ་ལ་ལ་ནི་ནམ་མཁའི་རྣམ་པ་དུ་མར་རྣམ་པར་ཕྱེ་བའོ།",
    "དབྱིབས་ཀྱིས་རྣམ་པར་ཕྱེ་བ་སྣ་ཚོགས་ཏེ།",
    "ཀུན་ཀྱང་ལས་རྣམས་རྒྱ་མཚོས་རྣམ་པར་བྲིས།",
    "དེ་དག་རིན་ཆེན་མང་ཞིང་རྣམ་པར་ཕྱེ།",
    "ཞིང་རྣམས་འདི་ཀུན་སེམས་ཀྱིས་རྣམ་པར་བརྟགས།",
    "ཁ་དོག་དབྱིབས་རྣམས་ཀུན་ཀྱང་རྣམ་པར་བརྟགས།",
    "སྣ་ཚོགས་སེམས་དང་བསམ་པས་རྣམ་པར་བརྟགས།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་དེ་ལ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་ལྷུན་དག་ནི་གཞན་དང་གཞན་དུ་ཤེས་པར་བྱ་སྟེ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་དུ་ཤེས་པར་བྱ་སྟེ།",
    "འདི་ལྟ་སྟེ་སེམས་ཀྱི་སྐད་ཅིག་ལ་བསྐལ་པ་མཐའ་ཡས་པར་རྣམ་པར་འཕྲུལ་པའི་ཡུལ་ཡོངས་སུ་སྟོན་པའི་རྒྱན་དང་།",
    "འོད་ཀྱི་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་སྟོན་པའི་རྒྱན་དང་།",
    "སྣ་ཚོགས་རྒྱན་ཅན་ཡངས་པར་ཀུན་ནས་གནས།",
    "རྒྱ་མཚོ་རྟག་པར་ཕྱོགས་རྣམས་ཀུན་ཏུ་འབྱུང་།",
    "རྟག་པར་ཀུན་ཏུ་ཁྱབ་པར་རབ་ཏུ་འབྱུང་།",
    "སྣ་ཚོགས་རྒྱན་ཅན་ཀུན་ཀྱང་མ་ལུས་པར།",
    "ནམ་མཁའི་སྤྲིན་བཞིན་རྣམ་པར་སྟོན་པ་སྣང་།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ཡོངས་སུ་དག་པར་བྱ་བའི་ཚུལ་རྒྱ་མཚོ་ནི་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་དུ་ཤེས་པར་བྱ་སྟེ།",
    "དེ་དག་ལ་སྩོགས་པ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ཡོངས་སུ་དག་པར་བྱ་བའི་ཚུལ་རྒྱ་མཚོ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་དུ་ཤེས་པར་བྱའོ།",
    "རྒྱལ་བའི་མཉམ་ཉིད་མ་ནོར་རྟོགས་བྱས་ནས།",
    "ཞིང་རྣམས་རྒྱ་མཚོ་རྣམ་མང་རྣམ་པར་དག།",
    "གཟུགས་ཀྱི་ཁྱད་པར་འགྲོ་བ་འདི་དག་ཏུ།",
    "སྐུ་ཚེ་ཐུང་བར་ལ་ལ་རྣམ་པར་སྟོན།",
    "རབ་ཏུ་མཛེས་པར་འགྲོ་བ་འདི་ན་བཞུགས།",
    "བསམ་ཡས་བསྐལ་པར་དེ་དག་གསུང་སྒྲོག་ཅིང་།",
    "ཞིང་མང་རྒྱ་མཚོ་ཕྱོགས་སུ་གང་བྱས་ཤིང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་དུ་ཤེས་པར་བྱ་སྟེ།",
    "འདི་ལྟར་ཞིང་རྒྱ་མཚོ་ལ་ལ་ནི་བསྐལ་པ་གྲངས་མེད་པར་བྱིན་གྱིས་བརླབས་པའོ།",
    "ཞིང་རྒྱ་མཚོ་ལ་ལ་ནི་བསྐལ་པ་དཔག་ཏུ་མེད་པར་བྱིན་གྱིས་བརླབས་པའོ།",
    "ཞིང་རྒྱ་མཚོ་ལ་ལ་ནི་བསྐལ་པ་བསམ་གྱིས་མི་ཁྱབ་པར་བྱིན་གྱིས་བརླབས་པའོ།",
    "ཞིང་རྒྱ་མཚོ་ལ་ལ་ནི་བསྐལ་པ་མཚུངས་པ་མེད་པར་བྱིན་གྱིས་བརླབས་པའོ།",
    "ཞིང་རྒྱ་མཚོ་ལ་ལ་ནི་བསྐལ་པ་ཀུན་ནས་མཐའ་ཡས་པར་བྱིན་གྱིས་བརླབས་པའོ།",
    "ཞིང་རྒྱ་མཚོ་ལ་ལ་ནི་བསྐལ་པ་ཀུན་ནས་མུ་མེད་པར་བྱིན་གྱིས་བརླབས་པའོ།",
    "ཞིང་རྒྱ་མཚོ་ལ་ལ་ནི་བསྐལ་པ་གཞལ་དུ་མེད་པར་བྱིན་གྱིས་བརླབས་པའོ།",
    "ཞིང་རྒྱ་མཚོ་ལ་ལ་ནི་བསྐལ་པ་བརྗོད་དུ་མེད་པར་བྱིན་གྱིས་བརླབས་པ་སྟེ།",
    "སྐད་ཅིག་ཡུད་ཙམ་ཉི་མའི་གྲངས་ཀྱིས་བསྐལ་པར་འགྱུར།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་དེ་ལ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་བསྐལ་པ་མཐའ་ཡས་པའི་རྒྱུད་ཀྱི་ཚུལ་རྒྱ་མཚོ་ནི་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་དུ་ཤེས་པར་བྱ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམ་པར་འཕྲུལ་པས་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་བསྐལ་པ་མཐའ་ཡས་པ་ཡོངས་སུ་དག་པར་གནས་པ་དང་།",
    "དེ་དག་ལ་སྩོགས་པ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་བསྐལ་པ་རྒྱ་མཚོ་མཐའ་ཡས་པའི་རྒྱུད་ཀྱི་ཚུལ་རྒྱ་མཚོ་ཀུན་ནས་གནས་པའི་ཚུལ་ནི་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་དུ་ཤེས་པར་བྱའོ།",
    "དེ་དག་འབྱུང་ཞིང་འཇིག་པར་འགྱུར་བ་ཡང་།",
    "བསྐལ་པ་དེ་ནི་རྣམ་པར་དག་པར་སྣང་།",
    "ཞིང་རྣམས་རྒྱ་མཚོ་དེ་ཚུལ་དག་པར་འགྱུར།",
    "ཞིང་རྣམས་རྒྱན་གྱིས་ཤིན་ཏུ་བརྒྱན་པར་འགྱུར།",
    "དེ་ཚེ་དེ་ཞིང་རྒྱན་རྣམས་འགྲིབ་པར་འགྱུར།",
    "ཀུན་ཀྱང་རྒྱན་གྱིས་རྣམ་པར་བརྒྱན་པར་འགྱུར།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་དེ་ལ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ཐ་མྱི་དད་པའི་ཚུལ་ནི་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་དུ་ཤེས་པར་བྱ་སྟེ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་དེ་དག་ལ་སྩོགས་པ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ཐ་མི་དད་པའི་ཚུལ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་དུ་ཤེས་པར་བྱའོ།",
    "ཞིང་རྣམས་རྒྱ་མཚོ་ཐམས་ཅད་ཁྱབ་བྱས་ཀྱང་།",
    "འཇིག་རྟེན་ཀུན་ཏུ་བཀང་སྟེ་འཕགས་བཞུགས་ཀྱང་།",
    "སྤྲུལ་པའི་སྤྲིན་གྱིས་ཀུན་ཏུ་གང་བྱས་ཏེ།",
    "འགྲོ་བ་སྣོད་དུ་གྱུར་ལ་དེ་དག་བརྗོད་བྱས་ཏེ།",
    "རྒྱ་མཚོའི་ཞིང་དུ་བསྐལ་པར་བྱིན་བརླབས་ཀྱང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ཤིན་ཏུ་བསྟན་པའི་ཕྱོགས་གསལ་བར་བྱ་བ་ཡང་དག་པར་བསྒྲུབས་པ་ཞེས་བྱ་སྟེ་ལེའུ་བཞི་པའོ།",
    "བསྐལ་པ་རྒྱ་མཚོ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་ཀྱིས་ཡོངས་སུ་དག་པར་བྱས་ཏེ།",
    "ནོར་བུའི་རྒྱལ་པོ་འོད་རྣམ་པར་དག་པའི་རྒྱལ་མཚན་གྱི་གཞིས་རྟོན་ཏོ།",
    "འཇིག་རྟེན་རྒྱ་མཚོའི་ཁམས་དེ་ཡངས་ཤིང་རྣམ་པར་དག།",
    "རྒྱ་མཚོའི་རྒྱན་རྣམས་ཐམས་ཅད་སྣ་ཚོགས་བརྟན་པར་གནས།",
    "ཕྱོགས་དང་ཕྱོགས་མཚམས་ཀུན་གྱི་ཞིང་རྣམས་ཁྱབ་པར་བྱེད།",
    "འགྲོ་བ་མ་ལུས་ཀུན་གྱི་བསམ་པ་ཚིམ་བྱས་ནས།"
  ]
}