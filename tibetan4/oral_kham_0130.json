    "དུས་དེ་རིང་རང་དང་སྐལ་མཉམ་འགར།",
    "རང་མཁས་པར་འདུག་ཀྱང་ང་རྒྱལ་ཆེ།",
    "ཕྱོགས་གང་ན་འདུག་པར་ཕྲག་དོག་ཆེ།",
    "ཤྭ་བ་རི་དྭགས་དང་ལྷན་གཅིག་འདུག་པ་དེ་སྐྱིད་པ།",
    "ཨ་བྷི་ཥེ་ཙ་ནི།",
    "རང་རང་དགྱེས་པའི་གདན་ལ་ལེགས་བཞུགས་ནས།",
    "རང་རང་ཞོན་པ་ཕྱག་མཚན་སྣ་ཚོགས་བཅས།",
    "རྒྱ་དམག་དུས་འཁྲུགས་ཁ་སྨྲས་ཀྱི།",
    "ཙ་ན་རྒྱུ་བའི་ཤ་ཟ་འབྱུང་པོ་དང་།",
    "རང་རང་དགྱེས་པའི་ཚུལ་གྱིས་བཞུགས་སུ་གསོལ།",
    "རང་རང་དགྱེས་པའི་གདན་ལ་ལེགས་བཞུགས་ནས།",
    "རང་རང་འཁོར་ཚོགས་འབུམ་དང་འབུམ་གྱིས་བསྐོར།",
    "ཞག་དུས་དར་དང་ཡར་ངོ་གཅེས།",
    "གུ་གུལ་གྱིས་འདུག་ཡུངས་དཀར་གྱིས་བྲབ་ལ།",
    "ཞག་དུས་གྲངས་ཀྱི་ངེས་པ་ཅན་ཡིན་ཡང་རུང་སྟེ།",
    "སྤྲོ་བ་བསྐྱེད་པ་ནི་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "ཐ་མར་འགྲོ་བའི་ས་ཅི་འདུག་རྩད་བརྡར་ཆོད་ལ་ལྟོས་ཤིག་ཞེས་བརྡ་སྦྱར་ལ་ངོ་། སྤྲད་པ་ནི།",
    "འགྲོ་འདུག་སྤྱོད་ལམ་ཅི་བྱེད་ཀྱང་",
    "ངོ་བོ་སྟོང་ཞིང་རང་བཞིན་གསལ",
    "དེ་ནས་དང་པོ་ལུས་རུ་ཤན་དབྱེ་བ་ནི་ལུས་རྡོ་རྗེའི་འདུག་སྟངས་བྱ།",
