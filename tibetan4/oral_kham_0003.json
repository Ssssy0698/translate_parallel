    "ཟིང་འཁྲུག་པའི་ནང་དགྲ་དང་རང་ཕྱོགས་བར་གྱི་འགལ་བ་དང་།",
    "གོམ་པ་དང་བོ་ནས་དགྲ་དང་རང་ཕྱོགས་དབར་གྱི་འགལ་བ་ལྟར་དྲག་ཤུགས་ཀྱིས་ཐག་གཅོད་བྱེད་པ་དེ།",
    "ཡང་དག་པའི་ངང་དགྲ་དང་རང་ཕྱོགས་དབྱེ་འབྱེད་དང་།",
    "བཙོན་པའི་ཕུང་བོ་ཟླས་མི་ཚར་བའི་གནས་ཚུལ་ཐོན་འདུག་དེར་བརྟེན་རྐྱེན་ལམ་དུ་ཕྱིན་པའི་མི་ཁྲི་ཕྲག་ཁ་ཤས་ཀྱི་ཕ་མ་དང་བཟའ།",
    "ཕོན་འབོར་ཆེན་པོ་ཞིག་དུས་མིན་རྐྱེན་ལམ་དུ་བཏང་དང་གཉིས།",
    "མི་ཕྱུགས་གཉིས་དར་གྱི་རྣམ་པ་གསར་བ་ཐོན་འདུག་པས།",
    "མི་རྣམས་ཧ་ཅང་འདོད་བློ་ཁེངས་པ་དང་སེམས་པའང་སྐྱིད་པོ་ཆགས་འདུག་པ་མ་ཟད།",
    "ལེགས་གྲུབ་བྱུང་ཡོད་ཅེས་བཀོད་འདུག་གོང་རིམ་གྱིས་ཀྱང་དངོས་ཡོད་གནས་ཚུལ་ལ་བརྟག་དཔྱད་ཞིབ་འཇུག་མ་བྱས་པར།",
    "མཚམས་འདིར་རྒྱ་ཡིག་མ་དཔེའི་ཤོག་གྲངས་གཅིག་ཚང་མི་འདུག།",
    "སྙན་གྲགས་བཅས་པར་ཕན་པ་དང་རང་རྒྱལ་མྱུར་མགྱོགས་སུ་དེང་རབས་ཅན་དང་།",
    "མཐར་ལུགས་མཐུན་གྱིས་དཀར་ནག་དབྱེ་འབྱེད་མ་བྱས་པར་ཚང་མར་རྡུང་རྡེག་བྱས་འདུག་པ་དང་།",
    "ཞོ་སྟོན་ཟེར་བ་དེ་ལ་གྲ་སའི་ཁ་རྒྱུན་ཡ་མཚན་བགོད་བྲོ་བ་ཞིག་འདུག་པ་ནི།",
    "བསྐང་གསོའི་སྐབས་ཞིག་ལ་ཉིན་གཅིག་དགོང་ཇའི་དོད་ལ་ཚོགས་ཡོངས་ལ་ཆང་དྲངས་བགྱི་འདུག་པས།",
    "དེའི་ཁ་ཡོག་ཀྱང་བདད་ཨ་ཁྱུང་རྒྱལ་པོ་ལ་བཞག་གྱི་འདུག་པས།",
    "བདུད་མགོ་སྐོར་གཏོང་ཐབས་ཤིན་ཏུ་ཡ་མཚན་ཆེ་བ་དེ་འདྲ་མང་ཙམ་ཡོད་ཚོད་འདུག་དོན་དངོས་གནས་ལ་ནི།",
    "ཐོག་མར་འབྲས་སྤུངས་ཞོ་སྟོན་ལས་ཟེར་སྲོལ་མི་འདུག་ཀྱང་།",
    "མཁས་ཟེར་ན་མཁས་པོ་རང་དང་མི་འདག་སྙན་ཟེར་ན་སྙན་པོ་རང་དང་མི་འདུག་ལུས་ཀྱི་རྣམ་འགྱུར་བདེ་པོ་རང་དང་མི་འདུག་ཏེ།",
    "རིན་ཆེན་གསེར་ཁྲིའི་སྟེང་དུ་སྐུ་ལ་འགྱུར་བ་མེད་པ་ཟིལ་པ་ཁྲོམ་མེར་བཞུགས་གདན་འཇགས་འདུག་གོཁྱེད་ཚོ་བཀྲིས་ཞོལ་པ་སྐྱོ་མི་དགོས་མགོ་འདྲེན་དང་དར་རྒྱས་ལས་ཀྱི་ཡོང་།",
    "བསྒྲུགས་བསྒྲུགས་པས་སྤྲིན་ཟླ་དེས་ས་ལ་མར་ཁ་ཁྱིལ་ནས་ཤ་ཞག་མར་གྱི་རྒྱ་རི་ལ་གྲི་ཡི་དགོས་བྱེད་མི་འདུག་སེན་འཐོག་རྒྱག་ནི་མི་དགོས།",
    "འཕགས་པ་འཇམ་དཔལ་དབྱངས་ཀྱི་སྤྲུལ་པར་ཐེ་ཚོམ་མི་འདུག་བདག་ཅག་སྐྱེ་འགྲོ་ཀུན་གྱི་བདེ་སྐྱིད་དཔལ་དུ་ཤར་རོ།",
    "བློན་པོའི་གཏམ་དང་བྱེད་ལུགས་གང་ལ་བལྟས་ཀྱང་རྒྱལ་ས་ཇོ་ཇོས་འཛིན་པར་འདུག་པས།",
    "མི་མིན་བདུད་ཀྱི་ཆོ་འཕྲུལ་ཡིན་པར་འདུག་འདི་ཉིད་སྐྱེས་ནས་ཡུམ་ཆེན་ཀུན་བཟང་མ།",
    "ཀོ་ཤའི་གནས་སུ་བརྫང་ན་ཕན་པར་འདུགདེ་འདྲའི་ལུང་བསྟན་རྨི་ལྟས་གསལ་པོ་བྱུང་།",
    "མི་མིན་བདུད་ཀྱི་སྤྲུལ་པ་ཡིན་འདུག་པས།",
    "ཨ་ཇོ་མཐའ་འཁོབ་མི་མེད་ལྷ་འདྲེའི་ཡུལ།",
    "ཁྱེད་རང་ཨ་ཇོའི་ཟླ་ལ་མ་སྡོད་པར།",
    "གཅུང་པོ་དོན་ཡོད་ཀྱིས་ཨ་ཇོ་ལ་འདི་སྐད་དུ།",
    "ཨ་ཇོ་མི་མེད་འཐའ་འཁོབ་ལྷ་འདྲེའི་ཡུལ།",
    "ཨ་ཇོ་མེད་པར་བདག་ཅག་རྒྱལ་སྲིད་དུ།",
    "མཉམ་དུ་འགྲོ་བ་ཨ་ཇོས་འཁྲིད་རོགས་གནང་།",
    "ཞེས་གསུངས་ནས་ཨ་ཇོའི་མགུལ་དུ་འཁྲིལ་ནས་ཤུམ་པས།",
    "དེ་ཚེ་༢ཨ་ཇོ་དོན་གྲུབ་ཀྱིས་ཐུགས་ཀྱི་དགོངས་པར།",
    "དེ་ནས་གཅུང་དོན་ཡོད་ཀྱིས་ཨ་ཇོ་མེད་པ་མཁྱེན་ནས་ཨ་ཇོའི་རྗེས་སུ་ཕྱག་ཕེབས་ཏེ།",
    "ཨ་ཇོ་ལ་འདི་སྐད་གསུངས་པར་ཞུ།",
    "ཨ་ཇོ་བདག་ཅག་ཞོག་པར་ཕོད་ལགས་སམ།",
    "ཞེས་གསུངས་པར་ཨ་ཇོས་དེ་ལན་དུ།",
    "ཨ་ཇོས་ཟས་ལྷག་ཕྲན་ཙམ་ཡོད་པའི་ཤ་རྐྱལ་དེ་ཕྲག་པར་བཀླ་ཏེ་གཅུང་དོན་ཡོད་འཁྲིད་དེ་ཕྱག་ལ་ཕེབས་པར་ཞུ།",
    "ཨ་ཇོ་དོན་གྲུབ་ལ་འདི་སྐད་དུ།",
    "ཨ་ཇོ་གསོན་དང་རྒྱལ་སྲས་དོན་ཀུན་གྲུབ།",
    "ཨ་ཇོས་དེའི་ལེན་དུ།",
    "མ་གཡེངས་ཨ་ཇོའི་ཕྱོགས་ལ་ཚུར་གསོན་དང་།",
    "ཨ་ཇོ་མི་སྡོད་ཆུ་ཞིག་འཚོལ་དུ་འགྲོ།",
    "དེ་ཕྱིར་བདག་ཅག་ཨ་ཇོས་བསྐྱར་བ་འདྲ།",
    "དེ་ལན་ཨ་ཇོས་འདི་སྐད་དུ།",
    "དེ་ཕྱིར་ཨ་ཇོས་ཆུ་ཞིག་འཚོལ་དུ་འགྲོ།",
    "དབུགས་མ་ཆད་ཙམ་དུ་འདུག་པ་དང་།",
    "དེར་ཨ་ཇོས་པང་དུ་བླངས་ཏེ་སྐེ་རགས་བཀྲོལ་ནས་ཤ་ལ་སྦྱར།",
    "ཨ་ཇོ་བདག་ལ་ཐུགས་ངལ་མ་མཛད་པར།",
    "དེ་ཚེ་ཨ་ཇོས་གཅུང་པོའི་དབུ།",
    "བཀའ་དྲིན་ཅན་གྱིས་ཨ་ཇོའི་ཟས་སྐལ་མཛོད།",
    "དེའི་ཚེ་ཨ་ཇོ་ནི་ལ་ཀླུང་མང་པོ་བརྒལ་ཏེ་ཕྱག་ཕེབས་ཟིན་སྟབས།",
    "ནམ་ཞིག་དུས་དེ་ལ་བབས་ཏེ་རྒྱལ་པོ་ཆེན་པོ་གོ་ཆས་བློན་འབངས་རྣམས་ལ་འདི་སྐད་དུ།",
    "ཀླུ་རྒྱལ་མཚོ་རྫས་འཁྱེར་ལ་འོས་པ་ཞིག་ཡོད་པར་འདུག་པས་རྒྱལ་པོའི་ཐུགས་ལ་འཇོག་ཞེས་ཞུས་པས་རྒྱལ་པོས་འདི་སྐད་ད།",
    "ནམ་ཞིག་དུས་ཀྱི་བསྐལ་པས་བྲི་བ་ཡོད།",
    "ཨ་ཇོ་དོན་གྲུབ་ད་ལྟ་འདི་ན་ཡོད།",
    "དོན་ཡོད་ཀྱིས་ཨ་ཇོ་ཡིན་པ་མཁྱེན་ནས་སྐད་ཅིག་ལ་ཨ་ཇོའི་རྩར་ཕྱག་ལ་ཕེབས་པ་ཞ།",
    "ཡུམ་གྱིས་ཕྱག་ཏུ་ཆང་དིམ་པི་གང་འཁྱེར་ནས་བསུ་བ་ལ་གཤེགས་ཏེ་གཞིས་བྱེས་དགའ་འཛོམས་ཀྱི་དཔལ་ལ་བཞུགས་ཙ་ན།",
    "རྔོན་པས་ཀྱང་མགྱོགས་པར་ལངས་ནས་བལྟས་ཙ་ན།",
    "སྔགས་པ་འཇིགས་སུ་རུང་བ་ཞིག་མཚོ་ཁར་འདུག་པ་མཐོང་མ་ཐག་སོམ་ཉི་མེད་པར་གྲི་གུག་དེ་སྔགས་པའི་མགོ་བོར་བསྣུན་པས་ཞྭ་ནག་ཕྱོགས་སུ་འཐོར་ཞིང་རལ་པ་ཡང་བཅད།",
    "ཁྱེད་ཀྱིས་སྐྱེ་འགྲོའི་དོན་ཆེན་སྒྲུབ་ནས་འདུག་ཅེས་གསུངས་ནས་ནོར་བུ་གཙུག་ཏུ་བཞེས་ནས་རྔོན་པ་དང་བཅས་ཀེའུ་རིའི་བྲག་ཕུག་ཏ་ཕྱག་ཕེབས།",
    "དགྲ་པོ་འདལ་བར་ནོར་བཟང་མི་གཏོང་རང་ཟེར་ན།",
    "ཚོང་དཔོན་རྒྱལ་པོའི་དྲུང་དུ་འཁྲིད་ཤོག་འདུག་ཅེས་གསུངས་པར།",
    "ཡུམ་ཆེན་ཁྱེད་ནི་ཐུགས་འབྲེལ་མ་མཛད་ཅིག་ང་རང་རྒྱལ་པོའི་དྲུང་དུ་བྱོན་ནི་ཆོག་ཅེས་གསུངས་ཏེ།",
    "ནོར་བུའི་རིགས་དེ་བསམ་གྱིས་མི་ཁྱབ་ཡོདགཏེར་ཆེན་དགོས་འདོད་ཀུན་འབྱུང་མི་འདུག་པས།",
    "མཐའ་གླིང་རྒྱ་མཚོ་ཅན་ལ་ནོར་བུ་དེལེན་དུ་ཁྱེད་རང་འགྲོ་དགོས་ཅེས་སྨྲས་སོ།",
    "རྦབ་རྡོ་གྱེན་ལ་ལོག་པའི་དཔེ་མི་སྲིདརྒྱལ་པོའི་བཀའ་དང་ཆུ་བོའི་རྦ་རླབས་འདྲ།",
    "ཁྱེའུའི་ཐུགས་ཀྱི་དགོངས་པར་འདི་གར་བསྡད་པས་མ་ཡི་ལྟོ་གོས་མི་ཕྱིད་པར་འདུག་ལུང་པའི་ཕུར་ཤིང་དང་ཤིང་ཏོག་འཐུ་རུ་འགྲོ་དགོངས་ནས་བྱོན་པ་ལས།",
    "དུད་འགྲོ་ཡིན་ཀྱང་ཕ་མའི་འདུ་ཤེས་འདུགང་ལ་ཕ་ཞིག་མེད་པས་སེམས་པ་སྐྱོ།",
    "ཡང་ཁྱེའུ་དགོངས་པར་འདི་གར་བསྡད་ན་མ་བུ་གཉིས་ལྟོ་གོས་ཕྱིད་པར་མི་འདུག་པས།",
    "བདག་ལ་ཚོང་ཟོག་ཆེན་པོ་མི་འདུག་སྟེ།",
    "མིག་ནས་མཆི་མ་མང་དུ་འདོན་པར་བྱེད་ཅིང་འདུག་ཁྱེའུས་འདི་སྐད་དུ།",
    "སྔ་དར་རྒྱ་མཚོ་ཅན་ལ་དར་བར་འདག་བར་དར་སྲིན་པོའི་ཡུལ་ད་དར་བར་འདག་ཕྱི་དར་མུ་སྟེགས་ཡུལ་ད་དར་བར་འདུག་ཁྱེད་ཀྱི་བུ་ལ་མ་དང་མཁའ་འགྲོ་ཡིས།",
    "ཀླུ་གདོལ་ནག་པོས་བར་ཆད་གཏོང་ཉེན་འདུག་ཇི་ལྟར་དྲག་གམ་པད་མ་འོད་འབར་ལགས།",
    "ང་རང་མིང་ལ་པད་མ་འོད་འབར་ཟེར།",
    "རྒྱ་མཚོ་ཅན་ལ་ནོར་བུ་ལེན་དུ་བཏང་ཀླུ་ཡིས་མ་འཇིགས་གནས་འདིར་སླེབས་ནས་འདུགའདི་འདྲ་ང་ཡི་གོང་དུ་ཤོར་ཉེན་འདུག་གསོད་པའི་ཐབས་ཤིག་ཇི་ལྟར་བྱས་ན་དྲག་ཡང་སྒོས་ཉོན་དང་སྡིག་བློན་རྐང་མགྱོགས་པ།",
    "ང་རང་མི་སྡོད་སྲིན་པོའི་ཡུལ་ད་འགྲོ།",
    "སྐུ་ལ་མེ་དཔུང་བཞེས་པའི་དུས་ཙ་ན།",
    "ཏེའདི་ལྟར་རྗེས་དཔག་རིགས་རྟགས་འཛིན་ལས་སྐྱེས་ཤིག་དེ་འབྲས་བུ་དང་རང་བཞིན་ཙམ་ལས་སྐྱེ་ལ།",
    "འདོད་པར་མི་ནུས་ཏེ་སྤྱིའི་དོན་ཅན་གྱི་རྣམ་རྟོག་ཏུ་འདུག་པས་བསལ་ལོ་ཞེ་ན།",
    "འབད་པ་མེད་པར་ཡང་རང་བཞིན་བཟློག་མི་ནུས་ཏེ་སྔར་གཙང་སྦྲ་ཅན་དུ་གྱུར་ན་ཕྱིས་ཐོད་པ་ཅན་དུ་གྱུར་ཀྱང་གཙང་སྦྲའི་རྟོག་པ་སྤོང་བ་ལ་འབད་དགོས་པ་བཞིན་ནོ།",
    "འདོད་པར་མི་ནུས་ཏེ་ཁྱེད་རང་རིགས་དང་།",
    "ཨ་སྟ་ཕྱི་རྟོགས་པ་ཐ་དད་མེད་པ་ཡང་རང་མཚན་ལ་ལྟོས་ནས་མ་གྲུབ་ལ།",
    "དོན་ནི་འཆི་ཀའི་ཤེས་པས་པའི་རྣམ་ཀྱང་ཕྱི་མ་དང་མཚམས་སྦྱོར་ཏེ་རྒྱུ་ཚང་ཞིང་གེགས་མེད་པའི་ཕྱིར་ཞེས་པའམ་ད་ལྟར་གྱི་རིག་པ་དང་རང་བཞིན་ཁྱད་པར་མེད་པའི་ཕྱིར་ཞེས་པའོ།",
    "དཔེར་ན་ཁྱེད་རང་ཐ་དད་མེད་པར་འདོད་པའི་ཡོན་ཏན་ལ་ཡོན་ཏན་གཅིག་དང་ཡོན་ཏན་གསུམ་དང་ཡོན་ཏན་ཉི་ཤུ་རྩ་བཞི་ཞེས་པའམ།",
    "གྲངས་དང་ལས་ལ་སོགས་པ་བུམ་པ་ལས་དོན་གཞན་དུ་གྱུར་པ་མིན་ཡང་དངོས་པོ་དེ་ཉིད་གྲངས་དང་ལས་དེ་ལྟ་བུ་དང་མི་ལྡན་པ་ལས་པའི་རྣམ་ལོག་པར་གནས་པ་ལ་རྟོག་པས་ཐ་དད་དུ་དབྱེ་བ་བྱས་པས་གྲངས་ལ་སོགས་པའི་སྒྲ་ཐ་དད་དུ་འཇུག་པ་ཡིན་ཏེ་ཁྱེད་རང་ལྟར་ན་ལས་ལ་འདི་རྫས་མ་ཡིན་ཞེས་པ་དང་རྫས་ལ་འདི་ལས་སམ་ཡོན་ཏན་མ་ཡིན་ཞེས་པ་བཞིན་ནོ།",
    "འོ་ན་རིམ་གྱིས་ཀྱང་དུ་མ་སྐྱེད་པ་མིན་པར་འགྱུར་ཏེ་སྔར་གྱི་དེ་དང་རང་བཞིན་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཞེ་སྡང་ཇི་ལྟ་བུ་ཞེ་ན་དེའང་རང་རིགས་སྔ་མའི་ས་བོན་ལས་སྐྱེས་པའི་རྒྱུ་ཅན་ནོ།",
    "འདོད་ན་ཆགས་སོགས་ཡུལ་དང་དུས་དང་རང་བཞིན་ངེས་པ་མེད་པར་སྐྱེ་བར་འགྱུར་ཞེས་སྦྱར་ཏེ།",
    "ལྡོག་པ་ཐ་དད་ལ་ལྟོས་ནས་རྗེས་དཔག་དང་རང་རྣམ་འགྲེལ་རིག་མངོན་སུམ་ངོ་བོ་གཅིག་པར་ཡང་འདོད་དོ།",
    "སྤྱིའང་རང་སྤྱི་གཉིས་ཀར་མི་འགལ་བར་བསྟན་པའོ།",
    "རྨི་ལམ་གྱི་སྔོ་སོགས་ཀྱང་རང་ཁོ་ནས་ཤེས་པ་ཡིན་ནོ།",
    "དེ་དག་ཀྱང་རང་ཉིད་ཁོ་ནས་ཤེས་པའི་ཕྱིར་རོ།",
    "གོ་བ་ཡིན་ཏེ་རྟོག་པ་ལ་སྣང་བ་དང་རང་མཚན་གཅིག་ཏུ་ཞེན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྒྲས་སྤྱི་དངོས་མེད་བརྗོད་ཀྱང་རང་མཚན་ལ་འཇུག་པར་འདོད་པ་མི་འཐད་དེ་དངོས་མེད་སྒྲའི་ཡུལ་དུ་མི་རུང་བའི་ཕྱིར་རོ།",
    "མ་ངེས་པ་མིན་ཏེ་འཇིག་པ་ནི་དངོས་པོ་ཡོད་ཙམ་དང་རང་ཆས་སུ་འབྲེལ་བ་ཡིན་པའི་ཕྱིར་མེའི་ཚ་བ་བཞིན་ནོ།",
    "རྒྱུ་དང་ཁྱབ་པར་བྱེད་པ་དང་རང་བཞིན་མ་དམིགས་པ་སྟེ་གསུམ་པོ་འདི་ཅི་ཙམ་ཞིག་མེད་པ་དང་དེའི་ཐ་སྙད་སྒྲུབ་པ་ལ་ངེས་པའི་འབྲས་བུ་ཅན་ཡིན་གྱི་འབྲེལ་ཡུལ་མ་བཀག་པ་ནི་རྟགས་མ་ཡིན་ནོ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "འདོད་པར་པའི་མི་ནུས་ཏེ་ཐམས་ཅད་ལས་ནི་ཞེས་པའི་ཚིགས་བཅད་གཅིག་སྟེ་དེའི་ཚེ་གཟུགས་ལ་སོགས་པ་མཐོང་ཞིང་འདུག་པས་བསལ་ཅེས་པའོ།",
    "ཁང་བཟངས་ནི་རྫས་མ་ཡིན་ཏེ་རྡོ་ཤིང་ལ་སོགས་པའི་ཚད་རིགས་མི་མཐུན་པས་རྫས་མི་རྩོམ་པར་ཁྱེད་རང་འདོད་པའི་ཕྱིར་རོ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "ཕྱི་རོལ་གྱི་དོན་ཁས་བླངས་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པའོ།",
    "དེས་ཕྱིའི་དོན་ལ་ལྟོས་པའི་གཟུང་འཛིན་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པ་དང་།",
    "གཉིས་པ་ཕྱིའི་དོན་ཁས་བླངས་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པ་ནི།",
    "ཕུང་པོ་དང་སོགས་པ་སྟེ་ཁམས་དང་སྐྱེ་མཆེད་ཀྱི་མཚན་ཉིད་ཐམས་ཅད་ཀྱང་རང་བཞིན་མེད་པར་འགྲུབ་སྟེ།",
    "གལ་ཏེ་ཡུལ་དུ་སྣང་བ་ཕྱི་རོལ་གྱི་དོན་ལ་མི་ལྟོས་ན་རྣམ་རིག་ཙམ་ལ་ཡུལ་དང་དུས་དང་རང་བཞིན་ངེས་པ་མི་འཐད་དོ་ཞེ་ན།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འགྲེལ་འདོད་། དོན་ལ་མ་ཡིན་དེ་རྟོག་ཕྱིར།",
    "ཇི་ལྟར་མྱུར་ཡང་སྐད་ཅིག་གསུམ་དགོས་ལ་བདེ་སོགས་དང་རང་རིག་གཉིས་སྐད་ཅིག་གཉིས་པར་མི་སྡོད་པའི་ཕྱིར་དང་།",
    "བདེ་སོགས་དང་རང་རིག་ལ་ཐ་དད་དུ་སྣང་བ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "འོ་ན་ཡིད་དེས་བདེ་སྡུག་གཉིས་དུས་གཅིག་ཏུ་སྐྱེད་པའང་སྲིད་པར་འགྱུར་ཏེ་བདག་རྐྱེན་དེ་ནི་འབྲས་བུ་འགལ་བ་དག་དུས་གཅིག་ཏུ་སྐྱེད་པའང་ནུས་པ་མཐོང་བའི་ཕྱིར་རོ།",
    "ཡུལ་སྔོན་པོ་ལ་རིགས་སོགས་པའི་རང་བཞིན་ནི་བདེ་སོགས་དང་རང་བཞིན་གཅིག་ཡིན་ཏེ་སྔོན་པོ་ལ་སོགས་པ་ནི་ཚོར་བ་གསུམ་མམ་རྡུལ་ལ་སོགས་པ་གསུམ་གྱི་བཀོད་པའི་ཁྱད་པར་ཡིན་པའི་ཕྱིར་རོ།",
    "སློབ་དཔོན་གྱིས་། ཀྱང་རྟོག་པའང་རང་རིག་ལ་མི་འདོད།",
    "གསུམ་པ་དོན་ཁས་བླངས་ཀྱང་རང་རིགས་འབྲས་བུར་འདོད་དགོས་པ་ནི།",
    "མ་ཡིན་ཏེ་ཕྱི་རོལ་ཅེས་པ་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་རིགས་ཏེ་ཇི་ལྟར་ཉམས་སུ་མྱོང་བ་བློ་ལ་སྣང་བའི་སྔོན་པོ་ལ།",
    "དོན་ཇི་ལྟ་བ་བཞིན་དུ་ཉམས་སུ་མྱང་བ་མི་སྲིད་པ་དེའི་ཕྱིར་ཕྱི་རོལ་གཞལ་བྱར་འདོད་པའི་ལུགས་ལའང་རང་ཉིད་མྱོང་བ་མཛོད་འབྲས་བུ་ཡིན་གྱི་དོན་རིག་པ་ནི་མ་ཡིན་ཏེ།",
    "བདག་ཉིད་གཅིག་ཏུ་འབྲེལ་ན་གློ་རྣམ་བཅས་དང་རང་རིག་ཏུ་གྲུབ་བོ།",
    "ཤེས་པ་དང་པོའི་རྣམ་པ་གཉིས་དང་རང་ཉིད་ཀྱི་རྣམ་པའོ།",
    "རང་རིག་ལ་མི་མཐུན་པ་ཡོད་དེ་འགའ་ཞིག་མྱོང་བ་ཙམ་ཡོད་ཀྱང་རང་རིག་མེད་པར་འདོད་པའི་ཕྱིར་རོ།",
    "ཤེས་པ་གཅིག་ཉིད་ཡུལ་དང་མྱོང་བའི་རྣམ་པ་སྟེ་ཚུལ་གཉིས་སྒྲུབ་པར་བྱེད་པའི་རིགས་པ་ཡུལ་ཤེས་པ་དང་དེ་ཤེས་པ་ལ་ཁྱད་པར་ཡོད་པའི་དྲན་པའི་རྟགས་དང་ལྷན་ཅིག་དམིགས་ངེས་པ་ལ་སོགས་པས་ཀྱང་རང་རིགས་རིག་འགྲུབ་པ་ཡིན།",
    "གཞན་གྱི་བདེ་སོགས་རང་མཚན་དང་སྤྱི་མཚན་གཉིས་ཀ་མི་འཛིན་པར་འདུག་པ་དེའི་ཕྱིར་བློ་དེ་ལ་བདེ་བ་ལ་སོགས་པའི་དོན་སྣང་བ་དེ་ནི་གང་ལ་སྣང་བའི་བློ་དེ་ལས་གཞན་དུ་གྱུར་པ་མིན་གྱི་བློའི་བདག་ཉིད་ཡིན་པ་དེས་ན་སྟེ་དེ་ཕྱིར་མངོན་སུམ་དང་ཁྱད་པར་དུ་བདག་རིག་པའི་མངོན་སུམ་དུ་གྲུབ་པ་ཡིན་ནོ།",
    "འོ་ན་གང་ཟག་གཞན་གྱིས་མཐོང་བར་གྱུར་པའི་པཀྵདོན་བུམ་པ་ལ་སོགས་པས་ཀྱང་རང་དང་གཞན་གྱི་བློ་རྗེས་སུ་དཔག་ནུས་པར་འགྱུར་ཏེ་དོན་ལ་གསལ་བར་གྲུབ་ན་དེ་ལྟར་བློས་མ་ངེས་ཀྱང་རྟགས་སུ་འདོད་པའི་ཕྱིར།",
    "ཡང་ན་ཡུལ་ཤེས་དེའི་ཤེས་པའི་ཁྱད་པར་ལས་རང་རིག་པ་གྲུབ་པར་མ་ཟད་དྲན་པའི་རྟགས་ལས་ཀྱང་རང་རིག་འགྲུབ་པ་ཡིན་ཏེ་རང་རིག་པ་དེ་དྲན་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "དོན་ནི་འདི་ལྟར་ཡིན་ཏེ་རིག་པ་སྔ་མ་དེས་རིག་པ་ཕྱི་མ་དེ་བློ་སྔ་མ་རང་ཉིད་འཛིན་པ་འུ་ཡུག་དང་མ་འཛིན་པའི་ཤེས་པ་གཉིས་དུས་གཅིག་ཏུ་སྐྱེད་ན་ཡི་གེ་ཨ་འཛིན་པར་བྱེད་པའི་ཤེས་པ་དེས་ཡང་རང་ཉིད་འཛིན་པའི་ཤེས་པ་དང་དོན་ཡི་གེ་ཨི་འཛིན་པའི་ཤེས་པ་གཉིས་ཀ་དུས་གཅིག་ཏུ་བསྐྱེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་ཤེས་པ་རང་ཉིད་གསལ་བའམ་རིག་པར་མ་གྲུབ་ཀྱང་རང་ཡོད་པ་ཙམ་གྱིས་དོན་གསལ་བར་འགྱུར་ན་འགྲོ་བ་དྲུག་པོ་འདི་མཐའ་དག་ཀྱང་གསལ་བར་འགྱུར་ཏེ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བུའི་རྟགས་འདི་ནི་འཇིག་རྟེན་ལས་འདས་པའི་ལུགས་ཡིན་གྱི་དེ་ལྟ་བུའི་དཔེ་མི་སྲིད་པས་ཁྱབ་པ་བསྟན་པར་མི་ནུས་པའི་ཕྱིར་དང་མ་བསྟན་ཡང་འཇིག་རྟེན་ན་སྒྲུབ་བྱེད་དུ་རུང་བ་ཡོད་པའི་ཕྱིར་རོ།",
    "འོ་ན་ཐག་རིང་ན་འདུག་པས་ཀྱང་ཐོས་པ་དང་འགལ་ཅེ་ན།",
    "འོ་ན་གཟུགས་ཀྱང་ནམ་མཁའི་ཡོན་ཏན་དུ་འགྱུར་ཏེ་ཐག་རིང་ན་འདུག་པས་ཀྱང་མཐོང་བའི་ཕྱིར་རོ།",
    "ཀུན་ལས་བཏུས་པར་ཁས་བླངས་དང་རང་ཚིག་གཉིས་གཅིག་ཏུ་བསྡུས་པའི་དོན་ངེས་པར་བྱ་བ་དང་།",
    "ལུང་དང་རང་ཚིག་ལ་བྱེད་པའི་དབྱེ་བ་མེད་དེ་གཉིས་ཀ་གེགས་བྱེད་ཡིན་པ་དེས་ན་སྟེ་དེའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་ཚིག་དང་འགལ་བ་ནི་ཡུལ་ཐམས་ཅད་ཀྱི་སྟེང་དུ་འཇུག་པར་འདོད་དོ།",
    "བསྟན་བཅོས་དང་རང་ཚིག་ནི་དེ་ལྟར་མ་ཡིན་པས་ཐ་དད་དུ་བསྟན་ཏེ།",
    "འདི་ལྟར་རང་བཞིན་གྱིས་མཐུན་ཕྱོགས་ཐམས་ཅད་ལ་ཁྱབ་པ་ཡིན་ཏེ་རང་བཞིན་དང་རང་བཞིན་ཅན་ཁྱབ་མཉམ་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ལ་བྱུང་རང་བཞིན་གྱི་རྟགས་ཡིན་པར་ནི་རྒོལ་བ་ཀུན་ལ་མཐུན་ལ་འབྲས་བུའི་རྟགས་ཡིན་པར་ནི་ད་ལྟ་ཉིད་དུ་བསྒྲུབ་པའི་ཕྱིར།",
    "སྒྲུབ་དང་ཞེས་པ་སྟེ་འོག་ཏུ་འུ་ཡུག་སྲོག་སོགས་མཐུན་ཕྱོགས་ལ་ཡོད་མེད་དཔྱོད་པའི་སྐབས་འདིར་ནི་བདག་ཉིད་མི་སྨྲ་བར་ཁ་རོག་འདུག་པ་ཉིད་འཐོབ་སྟེ་སྲོག་སོགས་བདག་དང་བཅས་པ་ལ་ཡོད་ཅེས་པའི་སྒྲུབ་པ་དང་མེད་ཅེས་པའི་འགོག་པའི་ཐ་སྙད་དེ་གཉིས་ཀ་ཡང་དངོས་མེད་ལ་འཇུག་པའི་རྣམ་པ་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་མེད་པ་ལ་དགག་པ་མི་མཛོད་སྲིད་ཀྱང་ཡོད་པ་ཉིད་ཡུལ་དང་དུས་དང་རང་བཞིན་འགའ་ཞིག་འགོག་པ་ཡིན་ཏེ་ཡུལ་འདི་ན་ཡོད་པའི་བུམ་པ་འདི་ན་མེད་དོ་ཞེས་པ་ལྟ་བུ་ཡིན་ནོ་ཞེ་ན།",
    "མ་ཡིན་ཏེ་སྤྱིར་འབྲས་བུའི་རང་བཞིན་ཁ་དོག་དང་དབྱིབས་དང་རོ་དང་དྲི་ལ་སོགས་པའི་ཐ་དད་རྣམས་རྒྱུ་ཐ་དད་རྣམས་ལས་བྱུང་བ་ཡིན་ཏེ་གཞན་དུ་ཡུལ་དང་དུས་དང་རང་བཞིན་ངེས་པ་མི་འཐད་པའི་ཕྱིར་རོ།",
    "ཕན་ཚུན་སྤང་འགལ་ངེས་པར་བྱེད་པ་ནི་གནོད་པ་མི་བྱེད་ཀྱང་རང་བཞིན་ཐ་དད་དུ་གྲུབ་པ་ཙམ་གྱིས་འགལ་བ་ཡིན་ནོ་ཞེས་པ་ནི།",
    "བདག་ཀྱང་རང་བཞིན་དེ་ལས་མ་འདས་པས།",
    "རྔོན་པས་གཙེ་ཞིང་རང་རང་གནོད་པས་ཉེན།",
    "མཐུ་སྟོབས་ཉམས་པས་འགྲོ་འདུག་བསྒུལ་བསྐྱོད་དཀའ།",
    "རང་རང་ས་དེར་ལྡན་པར་ཤེས་པར་བྱ།",
    "རིགས་དང་རང་བཞིན་ཀུན་སྤྱོད་སྐལ་པ་ངན།",
    "མཐར་ཡང་རང་ཉིད་ལུས་ཅན་ཀུན་གྱི་སྐྱབས།",
    "རང་རང་བདེ་བས་གནས་ཏེ་དགའ་བ་བསྒོམ།",
    "རང་རང་གཞུང་ནས་གསུངས་པའི་ལུང་མནོས་ཏེ།",
    "དེ་ཡང་རང་སེམས་རྣམ་དག་ཚུལ་ལ་བསླབ།",
    "སུས་ཀྱང་མི་མཐོང་ཁོ་བོ་གང་ན་འདུག།",
    "དབེན་པའི་ཕྱོགས་སུ་སྟན་ལ་རབ་འདུག་ནས།",
    "རང་དོན་ཞི་བ་གཉེར་མིན་འགྲོ་བའི་ཕྱིར།",
    "འགྲོ་དྲུག་གནས་སུ་རང་རང་སྟོན་པར་སྣང་།",
    "རང་རང་མཐུན་པའི་གཟུགས་ཀྱིས་དོན་མཛད་དོ།",
    "རིས་སུ་བྲིས་དང་འབུར་དང་རང་བྱོན་དང་།",
    "༡༢་ག་འདུག་གནཡྻན་བརྟེན་དང་།",
    "དོན་གྱི་འདུག་ཚུལ་སྒྲོ་སྐུར་མེད་བརྗོད་ཅིང་།",
    "ཤེལ་གྱི་བྲག་བཟང་ལ་ཉན་པའི་ཚུལ་དུ་འདུག་དེར་བློན་པོས་ཀྱང་ཉན་པས།",
    "ཕྱི་དཀར་ལ་ནང་བཀྲ་བ་ཅིག་གདའོ་ཞེས་པས།",
    "འཁོར་རྣམས་ལ་རང་རང་སོ་སོར་གཉེར་དུ་གཏད།",
    "སྐད་ཅིག་ལ་རླགས་འགྲོ་བར་འདུག་པས།",
    "བ་གོར་བེ་རོ་ཙ་ན་གཉིས་ལ་བསྒྱུར་ཏེ་རྒྱ་ནག་ཏུ་དར་རོ།",
    "ངས་དངོས་གྲུབ་གནང་བའི་འབྲེལ་པ་མི་འདུག་པས།",
    "བོད་ཡིག་རྣམས་སྒྲ་གཟུགས་བརྙན་དང་བཅས་པ་མི་མཐུན་པར་འདུག་པའི་ཕྱིར་རོ།",
    "བི་རོ་ཙ་ནས་རྒྱ་གར་ནག་ནས་བསྒྱུར་བ་གསུམ་འགྱུར་རོ།",
    "རྩི་ཤིང་རང་སྡུད་བྱེད་པའི་གཅོ་གྱིམ་བུ་ལན་ཚ།་",
    "ད་ལྟ་རྒྱལ་གཤེན་དོ་མཉམ་ཙམ་གདའ་སྟེ།",
    "ལར་ཡང་གྲོས་འདི་འདྲེའི་བྱེད་པ་ཅིག་འདུག་པས་མ་བྱས་ན་འཐད།",
    "བདག་མི་འདུག་ཟེར་ནས་བཞུགས་སུ་མ་འདོད་དོ།",
    "དུས་ལ་བབས་ཙ་ན།",
    "ད་འདིའི་འཐབ་ཟླ་མ་བྱས་ན་ནི་ཆབ་གསོལ་བར་འདུག་བྱེད་པར་ཁས་བླངས་ནས་བྲོས་ཀྱང་།",
    "འོ་སྐོལ་གཉིས་ལ་རྗེ་འབངས་ཀྱི་ཁྱད་འདུག་པས།",
    "བུ་ཙ་ཅིག་ཙེར་ཙེར་དུ་ཡིན་འདུག་པས།",
    "གཞན་རྐྱེན་དང་རང་རྐྱེན་ནོ།",
    "ཁུར་ཡང་བ་ཅིག་ཡོད་པར་འདུག་པས།",
    "དེ་དུས་བྷེ་རོ་ཙ་ན་དང་པད་མ་འབྱུང་གནས་ཀྱི།",
    "རྩ་བ་ན་སྒོ་མི་འདུག་དཔའ་བོའི་འཁྲུ་ས་ཡིན་ནམ་བྱས་ན།",
    "བདུད་འདུལ་སྒྲ་སྒྲོགས་གཡུང་དྲུང་རྩེགས་པའི་མཆོད་རྟེན་ཅིག་བར་སྣང་ལ་བཀྲ་ལམ་མེ་གདའ་འོ།",
    "དེ་ནས་སྒོ་ནང་དུ་བྱོན་པས་ལྡེར་བཟོ་ཆེན་པོ་ཅིག་གདའ་ནས།",
    "ཐུགས་ཀ་ནས་གཙོ་བོ་ཡབ་ཡུམ་འཁྲིལ་སྦྱོར་དུ་ལམ་མེ་གདའོ།",
    "དེའི་རྟགས་ནི་ད་ལྟ་ཡང་ཁ་ལན་ཚུར་སྨོད་གྱིས་གདའོ་སྐད།",
    "ཤི་བ་འདུར་བ་དགའ་བས་གསོན་འདྲེ་ངོ་ནག་ཁྱེད་རང་ཡིན།",
    "བ་གོར་བྷེ་རོ་ཙ་ན་ལོ་པཎ་གྱིས་ཕུད་དུ་ཁུར་བ་ཡང་།",
    "གཤེན་འདུར་གྱི་བོན་པོ་མེད་ན་གཤིན་པོ་ལ་གནས་མི་ངོ་བར་འདུག་གསུང་།",
    "མུན་ནག་པོ་ཅིག་འདུག་པས་ཕུགས་སུ་ཕྱིན་ཙ་ན།",
    "ཕྱི་ན་བོན་པོ་རྒད་པོ་ཅིག་གདའ་བས།",
    "བོན་པོ་རྣམས་ཀྱི་ཆོ་ག་བགོས་ནས་བྱེད་ཅིང་འདུག་ཁོང་ལ་ཡང་ཐབས་འདོན་བློ་ལ་ཡོད་ན་ཐང་ཟེར།",
    "གཡག་ཁུག་དུས་མི་གསོད་པའི་དམ་ཚིག་ལ་བསྒར་ནས།",
    "དེ་གདའ་བྱས་པས།",
    "ཁྱེད་རང་སྐད་མ་འདོན་པར་བེའུ་ཐོགས་ཚད་དུ་ཐོགས་ཤིག་གསུངས་ནས་དགོངས་པ་མཛད་ནས་རྒོད་ཁྱུ་ཅིག་བྱུང་སྟེ།",
    "དེར་སྒྲོ་བ་ཅིག་ལ་ཁྲོ་ཆུའི་རྒྱས་གདབ་པ་ཅིག་འདུག་ནས།་",
    "གྲོང་ཅིག་ན་རྡ་དིང་དིང་ཟེར་བ་འདུག་ཅི་བྱེད་པ་ཡིན་དྲིས་པས་མཐའ་བཞི་འཁྲུལ་གསས་བྱ་བ་བོན་བྱེད་པ་ཡིན་ཟེར།",
    "དཀྱིལ་འཁོར་དཔེའུ་ཆུ་ཡང་གླེགས་ཤིང་ངོས་ལ་འདུག་སྐད།",
    "འོད་དང་མེ་སྟག་འཕྲོ་ཡིན་འདུག་ནས།",
    "གཟེ་སྐུར་འདི་ཡོ་བྱད་ཆུང་བར་འདུག་པས་བྱིན།",
    "ད་ལྟ་ཉམས་སུ་ལེན་པ་ཡང་ཕུར་པ་འདི་གཏེར་སྲུང་རང་ཆས་པ་ཡིན་པས་འཇིག་རྟེན་གྱི་གཏེར་སྲུང་མེད་དོ།",
    "དེ་ལ་པོད་ཆུང་གཉིས་གདའོ་འདི་ཡང་བྱང་གཏེར་དུ་སྡུད་དོ།",
    "མི་གཅིག་འགའ་འདུག་ན།",
    "དེ་ནུབ་རྫ་སྐྱ་སེང་གེས་ཐོད་པ་བསྐྱལ་གདའ།",
    "ཟངས་གཞོང་ནམ་མཁའ་ལ་འཕུར་ཚར་ཙ་ན་བབས་བྱུང་།",
    "ཅོག་གེ་སྡོད་འགོ་དང་མིག་ཅོར་བྱས་པས་སུ་ཡང་མི་གདའོ།",
    "བྲག་ཁར་ཕྱིན་ནས་བལྟས་པས་སུ་ཡང་མི་གདའ།",
    "བཤམ་ན་ཤེལ་གྱི་གཡུང་དྲུང་ལམ་མེ་བ་ཡོད་བྱ་བ་གདའ།",
    "དེར་ལྟས་པས་དེ་ག་བཞིན་གདའ་སྟེ།",
    "འདོད་པར་འདུག་ནས།",
    "དེའི་སྟེང་ནས་ཡང་ཕ་བོང་གྲུ་བཞི་ལ་མཚལ་དང་ཤེལ་གྱི་གཡུང་དྲུང་གཉིས་བྲིས་པ་གཅིག་གདའོ།",
    "ཆེ་ཤོག་ན་རྒྱུ་འབྲས་གཉིས་ཀའི་བོན་མང་དུ་གདའ་ནས།་",
    "ད་ཅིའི་དེ་ཚོ་ཁྱེར་གདའ་ནས་ཁྱེར་འོང་བས།",
    "སོ་བདུན་འདུག་པ་ལ།",
    "ཞལ་བསྲོ་མཛད་ཅིང་གདའ།",
