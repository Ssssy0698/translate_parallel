    "ལམ་གྱི་རྣམ་པ་བཞི་བརྟེན་པར་བྱེད་དོ།",
    "འོ་ན་ལམ་བདེན་གྱི་རྣམ་པ་རྣམས་ཀྱང་ངོ་བོས་བསྟན་པར་མི་འགྱུར་ཏེ།",
    "བྱང་ཕྱོགས་སོགས་ནི་ལམ་ལ་སོགས་པའི་རྣམ་གྲངས་མ་ཡིན་གྱི་མཚན་གཞི་ཉིད་ཡིན་པས་དེ་བསྟན་པས་ངོ་བོས་བསྟན་པར་རིགས་པའི་ཕྱིར་རོ།",
    "མི་རྟག་སོགས་རྟོགས་པར་བྱེད་པ་ལ་ཡིད་བྱེད་ཞེས་བྱའོ།",
    "དང་པོར་ནི་ཉན་རང་ལས་ཁྱད་པར་དུ་འཕགས་པར་སྒྲུབ་པའི་ཕྱིར་ཡིན་ལ།",
    "རྣམ་པ་སྟོང་པ་ཉིད་རྣམས་དབྱེར་མེད་པར་རྟོགས་པའི་རྣམ་པ་ཅན་དུ་གསུངས་པའི་ཕྱིར་དང་།",
    "དེས་བསྟན་པའམ་རྟོགས་པ་དྲོད་ཡིན་ནོ་ཞེས་སོགས་དམིགས་པར་སྦྱོར་བར་མཛད་དོ།",
    "དེའི་ལམ་ཤེས་བསྟན་པར་ནི་མི་འགྱུར་རོ་ཞེ་ནསྐྱོན་མེད་དེ།",
    "དབྱེར་མེད་རྟོགས་པས་ཉན་ཐོས་ཀྱི་སྦྱོར་ལམ་ཡང་མི་དམིགས་པར་རྟོགས་པར་དོན་གྱིས་བསྟན་ལ།",
    "ཁྱད་པར་ལ་དམིགས་པ་འགོག་ཚུལ་བསྟན་པས་རྟོགས་པ་གོང་ནས་གོང་དུ་ཞིབ་པར་བསྟནཔས་གཟུང་མེད་ཀྱི་གསལ་སྣང་ཆུང་འབྲིང་ཆེན་པོ་མཚོན་པའི་ཕྱིར་དང་།",
    "རྣམ་པར་གྲོལ་བར་བྱ་བའི་བསམ་པ་ཅན་དང་།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་སྔོན་མ་སྐྱེས་པ་དང་།",
    "སློབ་དཔོན་ལྟར་ན་དང་པོ་གཉིས་གཞན་གྱིས་བསྟན་མི་དགོས་པའི་ཁྱད་པར་དང་།"
  ]
}