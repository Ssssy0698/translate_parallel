    "རྟགས་དང་རྟགས་ཅན་དག་གི་ཞེས་པ་དགོངས་པའོ།",
    "སྦྲུལ་དང་སྦྲེ་མོ་དག་ནི་གནོད་བྱ་གནོད་བྱེད་ཀྱི་དངོས་པོ་ཡིན་ལ།",
    "འོན་ཀྱང་སྦྲུལ་རྒྱལ་བ་དང་སྦྲེ་མོ་འཕམ་པ་དག་སྟེ།",
    "ཡོད་པ་ཉིད་དང་ཁྱབ་བདག་ཉིད་ལ་སོགས་པ་རྣམས་ཀྱང་དེ་ལྟ་བུའོ་ཞེས་པ་རང་བཞིན་གྱི་ཐལ་བར་འགྱུར་བ་གཉིས་གསུངས་སོ།",
    "ཐུན་མོང་དུ་མངོན་སུམ་པ་ཡང་ངེས་པར་མ་བཟུང་བའི་དོན་ཁྱད་པར་མཐོང་བ་ལས་ཁྱད་པར་དུ་རྟོགས་པར་བྱེད་དོ་ཞེས་པ་ལ་སོགས་པའི་ཚིག་ལ།",
    "དེ་ལྟར་འགྱུར་མོད།",
    "གང་གི་ཕྱིར་རྗེས་སུ་འགྲོ་བ་ལ་སོགས་པ་རྣམས་ཁོ་ན་བསྟན་བཅོས་སུ་གཏན་ཚིགས་ཉིད་དུ་གཟུང་བར་བྱའི།",
    "འཕངས་པ་བདེན་མོད།",
    "ཆ་ཤས་ཁོ་ནས་ཞེས་པ་རྣམ་པ་འགའ་ཞིག་གིས་ཞེས་པའི་དོན་ཏོ།",
    "དེའི་ཕྱིར་དེའི་སྒོ་ནས་རྟགས་ཀྱིས་གསལ་བར་བྱེད་ཅིང་རང་གི་འབྲེལ་པ་དང་རྗེས་སུ་མཐུན་པ་ཉིད་ལས་ཆ་འགའ་ཞིག་ཁོ་ནས་གསལ་བར་བྱེད་དོ་ཞེས་པ་རིགས་སོ།",
    "རང་གི་ལྟ་བ་ལས་རྒྱལ་པོ་ལ་སོགས་པ་ལ་ནོར་ཅན་གྱི་རྣམ་པ་ཁོ་ནར་རྟོགས་པར་འགྱུར་ལ།",
    "གལ་ཏེ་རང་གི་འབྲེལ་པའི་རྗེས་སུ་མཐུན་པ་ཉིད་ལས་ལོག་པར་འཛིན་པར་ནུས་པར་འདོད་ན།",
    "འབྲེལ་པ་ལ་ལྟོས་པ་མེད་པས་རྟོགས་པར་བྱེད་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ་ཞེས་པ་དགོངས་པའོ།",
    "གལ་ཏེ་རང་གི་འབྲེལ་པའི་སྒོམ་གཏོགས་པར་གཞན་དུ་སྟེ།",
    "རྣམ་པ་གཞན་གྱིས་ཀྱང་རང་གི་དོན་རྟོགས་པར་ནུས་པར་འགྱུར་ན་ནི།",
    "རང་གི་འབྲེལ་པ་དང་རྗེས་སུ་མཐུན་པས་མ་ཡིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "གཉིས་ཀ་དག་གི་གོ་བར་བྱེད་པ་ཉིད་ཀྱང་མ་ཡིན་གྱི།",
    "འདིར་འགྱུར་མོད།",
    "གཞན་ཡང་རྣམ་པར་གནས་པ་གཉིས་དག་གིས་ལྷན་ཅིག་སྤྱོད་པའི་དངོས་པོར་འགྱུར་ཏེ།",
    "གང་གི་ཚེ་མེ་དང་དུ་བ་འབྲེལ་པ་མཐོང་ནས།",
    "ལྷག་མ་དང་ལྡན་པ་ནི་གང་གི་ཚེ་འབྲས་བུ་གྲུབ་པ་མཐོང་ནས་རྒྱུ་བྱུང་ཟིན་པ་ཉིད་རྟོགས་པ་སྟེ།",
    "དེ་ལས་ཀྱང་འབྲས་བུ་དང་རྒྱུ་དག་ལས་ཡང་དང་ཡང་དུ་རྗེས་སུ་དཔག་པ་མེད་པར་ཐལ་བར་འགྱུར་ལ།",
    "གང་གི་ཕྱིར་སྤྱིར་མཐོང་བ་རྣམ་པ་གཉིས་ཁོ་ནའི་ངེས་པར་གཟུང་བའི་འབྲས་བུ་ནི་གྲངས་གཞན་རྣམ་པར་སེལ་བའོ།",
    "ནིའི་སྒྲ་གཅིག་ནི་གང་གི་ཕྱིར་གྱི་དོན་ལའོ།",
    "གང་གི་ཕྱིར་རྗེས་སུ་དཔག་པ་རྣམ་པ་གཉིས་ཁོ་ན་ཡིན་པ་དེའི་ཕྱིར་ནོར་དང་ནོར་ཅན་ལ་སོགས་པ་གསུམ་རྣམས་ཀྱིས་དང་པོར་རྗེས་སུ་དཔག་པར་བྱ་བ་རྟོགས་པ་ན་རྗེས་སུ་དཔག་པ་གསུམ་པོ་གང་ཡིན་པ་དེ་རྣམས་གང་གི་ཁོངས་སུ་བསྡུ་སྟེ།",
    "རྣམ་པ་གཞན་དུ་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "གནོད་བྱ་གནོད་བྱེད་ཀྱི་དངོས་པོ་ལ་ཡང་སྦྲུལ་རྒྱལ་བ་དང་སྦྲེ་མོ་འཕམ་པ་དག་འབྲས་བུ་དང་རྒྱུའི་དངོས་པོ་དག་ཁོ་ན་སྟེ།",
    "འབྲེལ་པ་གཞན་མེད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་པ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བ་ཡང་ནའོ།",
    "རྟོགས་པར་བྱ་བ་དང་རྟོགས་པར་བྱེད་པའི་འབྲེལ་པ་ཅན་དག་གིས་བྱས་པ་ཕན་ཚུན་ནམ་གང་ཡང་རུང་བའི་ཇི་ལྟར་སྲིད་པར་ཕན་འདོགས་པ་ཡོད་དེ།",
    "རྟོགས་པར་བྱ་བ་དང་རྟོགས་པར་བྱེད་པ་དག་གིས་ཞེས་པ་ལ་སོགས་པ་ལྷག་མ་སྔ་མ་བཞིན་ནོ།",
    "འབྲེལ་པ་ཅན་དག་གི་བདག་ཉིད་དུ་གྱུར་པའི་རྗེས་སུ་འཛིན་པའོ།",
    "འོ་ནའང་རྣམ་པ་གཉིས་ཉིད་མ་ཤེས་པ་རྟོགས་པར་བྱེད་པ་ཁོ་ན་ངག་གི་འབྲས་བུར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "དོན་གཞན་རྣམ་པར་གཅོད་པས་ནི་དེའི་རང་གི་ངོ་བོ་རྟོགས་པའི་ཕྱིར་ལ།",
    "དེའི་རང་གི་ངོ་བོ་རྟོགས་པ་ག་ལས་ཡིན།",
    "འགའ་ཞིག་གི་ཚེ་ཞེས་པའི་ཚིག་ལས་མི་འགྱུར་བ་ཡང་ངོ།",
    "གང་གི་ཕྱིར་འགྱུར་བ་དེའི་ཕྱིར་རྗེས་སུ་དཔག་པའི་རྒྱུ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་རྗེས་སུ་དཔག་པར་བརྗོད་པར་བྱའོ།",
    "དེའི་ཕྱིར་དེའི་རྒྱུས་རྗེས་སུ་དཔག་པར་ཉེ་བར་གདགས་པར་རིགས་མོད།",
    "གང་གི་ཚེ་ཡང་དོན་ཇི་ལྟ་བ་ཡིན་པ་དེའི་ཚེ་འཁྲུལ་པ་ཉིད་མེད་དོ།",
    "གང་འདིས་རྗེས་སུ་དཔག་པ་ཉེ་བར་བཀོད་པ་དེ་དག་གིས་སུན་ཕྱུང་ངོ་ཞེས་པ་དང་།",
    "གང་ཁོ་ནའི་མི་འཁྲུལ་བ་ཉིད་ཀྱི་རང་གི་ངོ་བོ་ལ་ལྟོས་པ་ཞེས་པའི་དོན་ཏོ།",
    "རང་གི་ངོ་བོ་ཞེས་པ་འདི་གང་ལས་ཤེ་ན།",
    "རྟགས་ཀྱི་རང་གི་ངོ་བོ་ཁོ་ན་ཅི་འདི་འབྲས་བུར་འགྱུར་རམ་མི་འགྱུར་ཞེས་རྣམ་པར་དཔྱད་པར་རིགས་སོ།",
    "དེ་ལ་ནི་རང་གི་ངོ་བོ་རྟོགས་པ་ཁོ་ན་ལ་རྣམ་པར་དཔྱད་པ་སྟེ།",
    "གང་གི་ཚེ་འདི་དབུ་བ་འཁྲུག་པ་དང་ཆུ་རྡུལ་དང་ལྡན་པ་ལ་སོགས་པའི་མཚན་མ་རྣམས་ཀྱིས་རང་གི་ངོ་བོ་ངེས་པར་འགྱུར་བ་དེའི་ཚེ་སླར་ཡང་མི་འཁྲུལ་བ་ཉིད་ལ་རྣམ་པར་དཔྱད་པ་ལ་ལྟོས་པ་མ་ཡིན་ནོ།",
    "སེན་མོ་ལྔ་ལྔ་རྣམས་ཀྱིས་བཟའ་བར་བྱའོ་ཞེས་པ་ཇི་ལྟ་བ་བཞིན་ཡིན་ན།",
    "ཇི་ལྟར་བ་རྣམས་ཀྱི་ནག་མོ་ནི་ཤིན་ཏུ་འོ་མ་ཕུན་སུམ་ཚོགས་པ་ཞེས་པས།",
    "ནག་མོ་ཁོ་ན་ཤིན་ཏུ་འོ་མ་ཕུན་སུམ་ཚོགས་པ་ཉིད་བཞིན་ནོ།",
    "འདི་ནི་རང་གི་བསམ་པས་ཏེ།",
    "གང་ལས་རང་གི་ངོ་བོ་ཤེས་པར་འགྱུར་བའོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་ཡུལ་ཅན་ཞེས་བརྗོད་ཟིན་ཏོ་ཞེས་པ།",
