    "བྱིས་པ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདོད་པ་ཅན་འགའ་ཞིག་དེ་ལྟར་ཚེ་འདུས་བྱས་པས་སྐྱེལ་བར་བྱེད་ཀྱི་འདོད་པའི་བདེ་བའི་རོ་ནི་མྱང་བ་མ་ཡིན་ནོ།",
    "ཚར་གཅོད་ཅེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པ་ཐམས་ཅད་དུ་དེ་ལྟར་གྱུར་པས་ཁྱུད་ཀོར་ལས་ཀྱང་སྟེ་དུ་མར་ཟད་པར་གྱུར་ཀྱང་བུ་དང་ཆུང་མ་མི་མཐོང་སྟེ་སྤྱོད་ཡུལ་དུ་མ་གྱུར་ཏོ།",
    "ཀྱེ་མ་འདི་རྣམས་འབྲས་བུ་མེད་པར་ཉམས་སུ་ལེན་པ་ཡིན་ནོ་ཞེས་ཤིན་ཏུ་མྱ་ངན་མཛད་པར་བདག་ནི་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཚེའི་འདུ་བྱེད་པ་ཉིད་ཁོ་ན་དོན་མེད་པར་གཞན་གྱི་ལས་ཉམས་སུ་ལེན་པར་ཟད་པར་བྱས་པ་སྟེ།",
    "བདེ་བ་ཐོབ་པར་འདོད་པས་ཞུགས་པ་རྣམས་སླར་སྡུག་བསྔལ་དེ་ཉིད་ལ་འདི་རྣམས་ལྷུང་ངོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ལ་ལ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་རྣམས་ལ་གཞན་ཕྱིན་ཅི་ལོག་འདི་ཡང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་འདོད་ནས།",
    "འདོད་པས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེར་ཞུགས་པས་ན་གསོན་པར་འགྱུར་རམ་མི་འགྱུར་ཞེས།",
    "སྟོར་དོགས་པས་འདི་ལྟར་བྱས་ནས་སོ།",
    "འདོད་ལྡན་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་ཡང་འདི་བདེ་བ་སྒྲུབ་པ་ཉིད་ཀྱིས་ནོར་ལེན་པར་བྱེད་པ་ན་ཡང་དོན་མེད་པ་རྒུད་པ་སྐྱེ་བར་འགྱུར་བའི་རྒྱུ་ཉིད་དོ་ཞེས་བསྟན་པར་འདོད་ནས།",
    "བསགས་པ་དང་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སོགས་པ་ནི་མེད་པ་ལ་སོགས་པར་བྱེད་པའོ།",
    "ཤིན་ཏུ་དཀའ་བ་དེ་ལྟར་སྲུང་བ་ཡང་བརྒྱ་ལ་རྐུན་མ་ལ་སོགས་པ་རྣམས་ཀྱིས་བརླག་པར་བྱེད་པས་གདུང་ཞིང་ཡིད་མི་བདེ་བ་སྡུག་བསྔལ་བའི་རྒྱུ་ནི་ཕུང་ཁྲོལ་ཡིན་ལ་དེ་ཉིད་དོན་མེད་པ་རྒུད་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རྒྱུ་ལ་བརྟགས་ནས་ནོར་ཉིད་ཕུང་ཁྲོལ་དུ་བརྗོད་དོ།",
    "བསགས་པ་ལ་སོགས་པས་རྟག་ཏུ་རྣམ་པར་གཡེངས་པའི་ཕྱིར་དང་།",
    "འདོད་ལྡན་རྣམས་ལ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིར་བདེ་བ་སྐྱེད་པར་བྱེད་པ་ནི་གཏམ་ཙམ་ཡང་མེད་དེ།",
    "དོན་མེད་པར་བྱས་སོ་ཞེས་པའི་དོན་ཏོ།",
    "ཁྱད་པར་ཇི་ལྟ་བུ་ཞེ་ན།",
    "དེས་མནར་བའི་ནི་ཕན་པ་དང་མི་ཕན་པ་ཤེས་པ་ལ་ཕྱིན་ཅི་ལོག་པའི་བློ་ཡིན་ཏེ་རྨོངས་པས་བྱས་ཞེས་པའི་དོན་ཏོ།",
    "ངེས་པར་འཇིག་ཅིང་ཆུང་གྱུར་པ།",
    "ངེས་པར་འཇིག་ཅིང་ཞེས་པ་ནི་མི་བརྟེན་པའི་རང་བཞིན་ཡིན་ལ།",
    "དམྱལ་ལ་སོགས་པར་ལྷུང་བྱེད་ཅིང་།",
    "འདོད་ལྡན་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་རྣམས་མནར་མེད་པར་ལྷུང་བར་བྱེད་པའི་ཕྱིར་དང་།",
    "ཡང་ཁྱད་པར་དུ་འདོད་པའི་རྒྱུས་སྡུག་བསྔལ་བ་ཉིད་དུ་རབ་ཏུ་བསྟན་པའི་ཕྱིར།",
    "དམྱལ་སོགས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཚོན་ལ་སོགས་པ་འདི་རྣམས་སྡུག་བསྔལ་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་ཉིད་དུ་རབ་ཏུ་གྲགས་པ་དང་།",
    "འདོད་པ་རྣམས་མཚུངས་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "དྲན་པས་ཡུལ་དུ་བྱས་པ་ལས་སོ།",
    "མཚོན་ཆ་ལ་སོགས་པ་ཡང་དུས་ངེས་པར་འཆི་བ་ལ་སོགས་པ་འདི་རྣམས་སྡུག་བསྔལ་སྐྱེད་པར་བྱེད་པ་པོ་ཡིན་ལ།",
    "དེ་ལྟར་ལུས་རྣམ་པར་དབེན་པའི་རྗེས་ལ་སེམས་རྣམ་པར་དབེན་པ་བརྗོད་ནས།",
    "དེ་ལྟར་འདོད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་གསུངས་པ།",
    "རྩོད་པ་དང་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕན་ཡོན་སྐལ་ལྡན་ཞེས་པ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "སྐལ་ལྡན་ནི་ལེགས་པར་སྤྱོད་པ་རྣམས་ཡིན་ལ།",
    "ཁྱད་པར་ཅི་ལྟ་བུ་དང་ལྡན་པ་ཞེ་ན།",
    "རང་བཞིན་གྱིས་གཙང་ཞིང་དག་པ་རྩུབ་པ་ལ་སོགས་པའི་ཉེས་པ་དང་བྲལ་བ་རྣམས་སོ།",
    "ཇི་ལྟ་བུར་གྱུར་པའི་དམ་པས་འཆག་པར་བྱེད་ཅེ་ན།",
    "འཆག་པར་བྱེད་པ་ནི་ཡང་དང་ཡང་དུ་དལ་བས་འཆག་པའོ།",
    "རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་ནི་འདི་ཐམས་ཅད་འབད་པ་མེད་པར་འགྲུབ་པ་ཡིན་ལ།",
    "འདོད་པ་ཅན་རྣམས་ཀྱིས་ནི་འབད་པས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "དེ་ལས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པ་ཡིས་ཞེས་པ་ནི་ལུས་དང་སེམས་ཀྱིས་རྣམ་པར་དབེན་པ་ཡིན་ལ།",
    "བདག་ཏུ་འཛིན་པ་ནི་བདག་ཉིད་ལ་ཁྱད་པར་དུ་འཇུག་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཞེས་པ་ནི་འཆད་པར་འགྱུར་བའི་ཚུལ་གྱིས་སོ།",
    "བདག་ལས་འདི་དག་ལ་ཁྱད་པར་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་འདི་རྣམས་ལ་ཡང་ཞེས་སྲོག་ཆགས་ཐམས་ཅད་ལ་བདེ་བ་དང་སྡུག་བསྔལ་མཉམ་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "བདེ་བ་དང་སྡུག་བསྔལ་ཐ་མི་དད་པར་ཡང་ཇི་ལྟར་འདོད་པར་འགྱུར་ཞེ་ན།",
    "འདི་ལ་ལག་པ་ལ་སོགས་པ་ཞེས་པ་ལ་སོགས་པ་གསུངས་པ་ལ།",
    "ཁྱད་པར་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "གལ་ཏེ་གཞན་གྱི་ལུས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ལ་ཆགས་པས་བཟོད་པར་དཀའ་བ་ཡིན་ཏེ་མི་ནུས་སོ་ཞེས་པ་སྟེ་འདི་ནི་གཏན་ཚིགས་ཀྱི་ཚིག་ཡིན་ལ།",
    "སྡུག་བསྔལ་གྱི་རང་བཞིན་ཉིད་དུ་ཁྱད་པར་མེད་པར་བསྒྲུབ་པའི་ཕྱིར་རོ།",
    "གང་ཚེ་བདག་དང་ཞེས་པ་ལ་སོགས་པ་གསུངས་པ་ལ།",
