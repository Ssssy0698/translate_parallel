    "རྨི་ལམ་གྱི་ཀུན་སྤྱོད་ཏིང་ངེ་འཛིན་གྱི་རྒྱ་མཚོའི་རིམ་པ་ནི་མ་གཏོགས་ཏེ་དེ་ནི་གཉིད་ཐུན་གཅིག་ལ་ཡང་མཐའ་ཡས་པ་སྣང་བའི་ཕྱིར་བསྡུ་བར་མི་ནུས་ལ་དུམ་ཁྲིགས་ཅུང་ཟད་ནི་གཞན་དུ་ཡང་གསལ་བར་བྱས་སོ།",
    "ཞེས་གསུངས་པ་ལྟར་ཆ་ཙམ་རྗེས་སུ་འང་བརྗོད་པ་ཉིད་དོ།",
    "མཛད་ཅིང་རྒྱུན་རིང་པར་བཞུགས་པ་ལ།",
    "གསུང་སྒྲོས་ཇི་ལྟ་བའི་ཟིན་བྲིས་ཀྱང་མང་དུ་བཏབ་པས་མཉེས་པར་གྱུར།",
    "ཀའ་སྤྲོ་རབ་ཏུ་མཚོན་བྱང་དང་དབུས་སུ་ཐེགས་པའི་རྗེས་སུ་དགའ་ལྡན་གྱི་རི་བོར་བཞུགས་པའི་སྐབས་སུ།",
    "གཞན་ཕན་ནུས་པར་དགོངས་ནས་འཕྲལ་གྱི་འཚོ་བའི་ཡོ་བྱད་ཀྱིས་བསྐྱངས་ཕྱགས་ཕྱིར་ལོ་གསུམ་འབྲངས།",
    "སླར་ཡང་ཀོང་པོར་ཕེབས་པ་ན།",
    "ཉང་ཁ་སྨད་དང་བྲག་གསུམ་རྒྱུད་དེ་གངས་ལ་བརྒལ་ནས་ཡུལ་དེར་ཕེབས།",
    "གངས་དཀར་སོགས་ཀྱི་ལམ་རྣམས་བགྲོད་དེ་འབྲི་ཁུང་ཐིལ་དུ་ཕེབས།",
    "ཕན་ཚུན་དགྱེས་སྤྲོ་རྨད་དུ་བྱུང་བ་དང་ལྡན་པའི་ངང་ནས་ཞག་གསུམ་བཞུགས།",
    "ལྷ་སར་ཕེབས།",
    "ལྷོ་རགས་ཁར་ཞག་གསུམ་བཞུགས།",
    "གནས་ནང་རྒྱལ་བའི་རི་ཁྲོད་དུ་བྱོན་ཞག་བདུན་བཞུགས།",
    "བཞུགས་གནས་ཐུགས་རྗེ་ལྷ་ཁང་དུ་བྱས།",
    "སྐུ་སྐྱེས་གང་འོས་འབུལ་གནང་མཛད།",
    "གོང་མ་ཏའི་མིང་རྒྱལ་པོའི་གནང་སྦྱིན་ཡང་གསེར་ཡིག་པས་ཕུལ།",
    "སྤྲེ་ལོའི་འཇུག་དང་བྱ་ལོའི་ཟླ་བ་དང་པོའི་བར་འཚུར་ཕུར་བཞུགས་ཏེ།",
    "གོང་དུ་རྒྱས་པར་སྨོས་པ་ལྟར།",
    "དབུས་སུ་བསྡད་ན་ཚེ་རིང་གཞན་དོན་ཆུང་།",
    "གྲྭ་སློབ་དད་ལྡན་སྤོ་འབོར་བ་མང་པོས་ཁམས་སུ་ཕེབས་དགོས་པའི་ཞུ་ནན་ཕུལ།",
    "མ་འོངས་པ་ལུང་བསྟན་པའི་རྣམ་པར་ཐར་བ་ནི།",
    "མཐར་སྤྱོད་པའི་ནོར་འཛིན་གྱི་བུར་བྱས་ཏེ་རྫས་ཀྱི་ནུས་པ་མི་ཟད་པའི་གསང་བ་འཚོལ་བར་བྱེད་དོ་ཞེས་བྱ་བ་དང་།",
    "གནས་དང་ཉེ་བའི་གནས་ལྷག་པར་བགྲོད་ཅིང་བདུད་རྩི་འཐུང་བར་དགའ་བས་ལན་བཞིར་བརྒྱུད་མ་ཁོ་ནར་རྩེ་ཞིང་ཕྱོགས་ཐམས་ཅད་དུ་འགྲོའོ་ཞེས་པ་དང་།",
    "ཨོཊྛན་དང་ཁ་ཆེའི་བར་དུ་སློབ་དཔོན་ལ་བ་པའི་མན་ངག་འཛིན་པར་འགྱུར་རོ་ཞེས་དང་།",
    "ཏོང་ཀུན་དང་ཉེ་བར་རྫོགས་པ་ཆེན་པོ་ལ་མཆོག་ཏུ་སྤྱོད་པར་འབྱུང་ངོ་ཞེས་བྱ་བ་ལ་སོགས་པ་མ་ངེས་པ་དུ་མ་མཐོང་ཡང་བྲིས་ཤིང་བརྗོད་པས་མཐའ་གཏུགས་པ་མ་མཐོང་སྟེ།",
    "ཉིད་ཀྱི་གསུང་དང་ངག་རྒྱུན་སྤེལ་བྱས་ནས།",
    "གསང་བའི་སྒྲོན་མ་རྣམ་པར་བཀོད་པ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཉིད་ཐོབ་པར་བསྔོ།",
    "འཇིག་རྟེན་འདས་པའི་ལེགས་ཚོགས་འགྲུབ་གྱུར་ཅིག་པར་ཡིག་གསལ་ལ་དག་པར་བཀོད་པ་དང་།",
    "འདས་མ་འོངས་ད་ལྟར་བྱུང་བ་ལ་ཆགས་ཐོགས་མི་མངའ་བའི་མཁྱེན་པ་བླ་ན་མེད་པས་འགྲོ་བ་མཐའ་དག་ཡང་དག་པར་འདྲེན་པ།",
    "བོད་དང་བོད་ཆེན་པོའི་མཚམས་ཀྱི་ཆར་སྐྱེ་བ་བཞེས་ནས།",
    "འགྲོ་བའི་དོན་རྒྱ་ཆེན་པོས་འགྲོ་བ་ཐམས་ཅད་རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་བླ་ན་མེད་པ་ལ་བཀོད་ཅིང་།",
    "ཆིབས་ཁ་འཐེན་ནས་ཡུན་རིང་དུ་བཞུགས་ཏེ།",
    "བདག་ཉིད་ཆེན་པོ་འདིས་སླར་ཡང་གདུལ་བྱ་དཔག་ཏུ་མེད་པ་ལ་ཐུགས་རྗེའི་ཐུགས་ཀྱིས་དགོངས་པར་མཛད་དོ།",
    "དགའ་ལྡན་བདེ་བ་ཅན་སོགས་དག་པའི་གནས་རྒྱ་མཚོ་ལས་ཡང་དག་པར་གཤེགས་ཏེ།",
    "ཡུམ་གྱི་ལྷུམས་སུ་ཞུགས་པར་གྱུར་ཏོ།",
    "བྱང་ཕྱོགས་ནས་རྒྱན་དང་ལྡན་པའི་མི་མང་པོ་ལྷགས་པའི་ནང་ནས་རྟ་པ་གསུམ་ཉེ་བར་འོངས་ཏེ་བསྐོར་བ་བྱས་པ་དང་།",
    "གོས་ཀྱི་མཐུ་བ་གང་ཁྱེར་བ་ལས་གཡས་འཁྱིལ་གཅིག་བླངས་ཏེ་འབུང་པར་བརྩམས་པ་དང་།",
    "མེ་ཏོག་སེར་པོའི་ཚལ་དུ་བསྡད་པ་སོགས་ངོ་མཚར་བའི་རྨི་ལྟས་མང་དུ་སྣང་ཞིང་།",
    "སྤྲུལ་པའི་སྐུ་མྱུར་དུ་འབྱོན་པའི་རྟགས་ངེས་པར་སྣང་བའི་གཏམ་གཞན་ལ་བསྒྲགས་པའི་མཐུས།",
    "རྒྱལ་མཆོག་ཐུགས་རྗེའི་མངའ་བདག་ནི་མྱུར་བ་ཉིད་དུ་མཐོང་ངོ་ཞེས་ཕལ་ཆེར་སེམས་པར་བྱེད་དོ།",
    "དད་པ་སོགས་ཅི་རིགས་སྐྱེས་པའི་གྲགས་པས་ཀྱང་ཕྱོགས་ཀྱི་རྒྱུད་ཁྱབ་པར་གྱུར་ཏོ།",
    "འདི་ནི་བླ་ན་མེད་པའི་ཡང་བླ་ན་མེད་པའོ་ཞེས་སོགས་ངེས་པའི་ཤེས་པ་མཐུ་བརྟས་པར་གྱུར་པས།",
    "འཇིག་རྟེན་གྱི་སྐྱེ་བོ་རྣམས་དགའ་མགུ་ཡི་རངས་པ་རྒྱ་ཆེར་ཐོབ་པ་དེའི་གྲགས་པ་ཡང་ཕྱོགས་ཀྱི་ཐ་གྲུ་ཀུན་དུ་ཁྱབ་པར་འགྲོ་བ་གདུལ་བར་བྱ་བའི་སྐྱེ་བོ་ཇི་སྙེད་པ།",
    "ཡི་དམ་ལྷས་རྗེས་སུ་གནང་བ་དུ་མས་བསྐུལ་བ་དང་།",
    "དུས་གསུམ་མཁྱེན་པ།",
    "ཟླ་བ་ལྔ་བཞེས་པའི་ཚེ།",
    "ན་བཟའ་བཞེས་ལུགས་སོགས་སྔར་གྱིས་ཀུན་དུ་སྤྱོད་པ་བཞིན་དུ་མཛད་པས།",
    "ཕལ་པ་ལྟར་གོག་འགྲོས་མི་དགོས་པར་འབྱོན་ཐུབ་པ་ཡ་མཚན་ཆེ་ལགས་ཀྱང་།",
