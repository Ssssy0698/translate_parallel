    "ད་དུང་མི་དེ་ཚོས་ཀྱང་ཟ་བཞིན་འདུག།",
    "བྱིས་པ་རྣམས་སྐྲག་ཐག་ཆོད་སྔགས་རྒན་ཀློང་གསལ་ནམ་རྒྱུན་དང་མི་འདྲ་དེ་རང་རང་སར་བྲོས།",
    "བྲག་པོའི་སྟེང་མགོ་བོ་མལ་ཐུལ་གྱིས་བཏུམས་ཏེ་གཉིད་ཕུག་ནང་ནག་འཐིབ་བེར་འདུག་པས་མཐོང་ལམ་སྲིད་པ་ཁོའི་སེམས་ན་ཁྲིགས་ཁྲིགས་ཡིན།",
    "མཐའ་སྣེ་ཡར་སྔོན་གནས་འདིར་བསླེབས་མྱོང་མཁན་དེ་དག་རྣམས་རལ་བོར་གྱུར་འདུག་པར་མ་ཟད།",
    "ལོས་ཡིན།",
    "དཔལ་ཕྱག་ན་རྡོ་རྗེས་བསྲུངས་ཀྱང་མི་དྲེག་འཆགས་འདུག་པར་མ་ཟད།",
    "བཞེང་ཐད་ལ་རང་ནུས་ཅི་ལྕོགས་བྱེད་ཀྱིན་འདུག་ལགས་སོ།",
    "ཁ་བའི་སྟེང་དཔར་པའི་རྐང་རྗེས་ཆུང་ཆུང་མང་བོ་སྒོ་ཆེན་གྱི་ཕྱི་རོལ་ཏུ་འཐེན་འདུག་ལ།",
    "ཚོས་ཁོ་ལ་སེམས་ཁུར་བྱ་རིན་འདུག་གམ།",
    "མི་ཡོང་དགུ་ཡོང་ལོས་ཡིན།",
    "ཁྲོས་པའི་རྣམ་འགྱུར་འཇིགས་སུ་རུང་བ་ཞིག་སྟོན་མཐའ་མར་གྱོང་གུད་དེ་སུ་ལ་ཕོག་འདུག་པ་ཤེས་སྦྲང་ཆར་སྒྲུང་གཏམ།",
    "ཅན་གྱི་མིག་ཤེལ་དེ་མི་ལེན་པར་གྱོན་འདུགརྒྱུའི་སྐོར་མི་ཚང་མར་གསང་དགོས།",
    "ལུས་ལ་རས་ནག་པོའི་སྟེང་དུ་གོས་ཆེན་དང་རྒྱ་སེ་གཅིག་ན་ཉིན་དེ་ནས་བཟུང་སྙན་གྲགས་ལ་སློབ་སོགས་ཀྱིས་མཐའ་ཤན་བརྒྱན་པ་ཞིག་གོན་འདུག་ལ་ཆེན་གྱི་འཚོ་བར་སླར་ལོག་པའི་བསམ་བློ་གཏང་།",
    "འདུག་པས་དངོས་པོ་ཙག་ཙིག་ཉོས་ལ།",
    "ལྷ་སྐུའི་མདུན་དུ་ཚེ་འབར་གྱི་མཆོད་རྐོང་ཆེན་པོ་ཞིག་བཤམས་འདུགསྒྲོལ་མས་ཉི་འོད་འོག་ཏུ་ཁྱིམ་ལས་ཙག་ཙིག་རྣམས་ལས་བཞིན་ཡོད།",
    "དེ་ནི་དུད་ཁྱིམ་གྱི་སྟོབས་འབྱོར་མཚོན་བྱེད་ཀྱི་རྟགས་མཚན་གལ་ཆེན་ཞིག་ཏུ་གྱུར་འདུག་པས།",
    "ངས་སྡོང་ཤིང་ལས་པ་ཡག་པོ་མི་འདུག།",
    "ད་ལོའི་བཟའ་མར་ལ་དཀའ་ཁག་མི་འདུག་ཀྱང་།",
    "དུད་ཁྱིམ་བར་གྱི་འོ་མའི་མང་ཉུང་སྡུར་བ་ནི་གོམས་སྲོལ་ཞིག་ཏུ་གྱུར་འདུག་པས།",
    "བེའུས་ནུ་རྡེབ་བྱས་འདུག།",
