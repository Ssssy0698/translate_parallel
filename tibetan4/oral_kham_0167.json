    "ལྷན་ཅིག་སྐྱེས་པའི་ལྷ་ངུ་ཞིང་འདུག་གསུང་།",
    "དེར་གསེར་མང་པོ་འདུག་གོ་ཞེས་པའི་སྒྲ་བྱུང་སྟེ།",
    "ཇོ་བོའི་ཞལ་ནས་བྱམས་པས་གསུངས་པ་ཡིན་ཚོད་དུ་འདུག་གསུངས་ནས།",
    "འདི་རང་བཞིན་གྱི་རྣལ་འབྱོར་མ་ཅིག་འདུག་སྙམ་ནས་ཕྱག་བྱས་ཏེ་གདམས་ངག་ཞུས་པས།",
    "རང་བཞིན་གྱི་རྣལ་འབྱོར་མར་འདུག་གསུང་།",
    "ཁོང་རང་ཉིད་ཀྱི་ཡི་གེ་ལས་ཀྱང་།",
    "རྣལ་འབྱོར་པ་གོང་འོག་འདི་ཀུན་ཡང་རྟ་རྫི་དང་ཡོས་འཐག་ཡིན་ཁོང་རང་གང་དགའ་བར་ཐོང་།",
    "ཇོ་བོའི་བྱིན་བརླབས་ཀྱིས་མི་དེ་རྣམས་ཧད་དེ་ལས་ན་མི་གདའ་སྐད།",
    "དེ་ངོས་ན་གཏམ་གསར་བ་མི་འདུག་གམ་གསུངས་པས།",
    "གཞན་རྣམས་སྙམ་ན་མི་དང་མི་འཕྲད་པ་ཡིན་ནམ་སྙམ་ཙ་ན།",
    "ཕྱི་རོལ་གྱི་རྣམ་པར་རྟོག་པ་ལས་མཚམས་པོ་ཆེ་བཅད་པ་ལགས་པར་གདའ།",
    "ཁོང་གསང་ཕུ་དང་རྭ་སྒྲེང་ཡར་རྙོག་མར་རྙོག་བྱེད་པ་ལ་གྲོ་ཟན་འཁྱེར་མི་དགོས་པར་གདའ།",
    "དེངས་ཡང་ནགས་སུ་དེངས་ཆུང་བ་ཆེན་པོ་དེ་སྐྱེས་ཀྱང་ནགས་སུ་སྐྱེསསྒྲུབ་པ་སྐུ་ཉམས་སུ་བཞེས་པ་ཅིག་པ་ལྟ་བུ་ཅིག་ལགས་པར་གདའ་སྟེ།",
    "ཇོ་བོ་ལོ་བཅུ་དགུ་བསྟེན་པའི་ལོ་ཙཱ་བ་ཆེན་པོ་དེ་གུང་ཐང་ན་ད་དུང་བཞུགས་པར་འདུག་ཇོ་བོ་བཞུགས་ཀྱང་ལོ་ཙཱ་བར་དུ་འཇུག་པ་ལས་མེད་དེ་ལ་དེངས་ཤིག་ཐུག་དགོས་སྙམ་ནས་ཡར་བྱོན་པས།",
    "ནོར་འཕྲོད་ཁྱེད་རང་དང་མཇལ་ཀྱང་འདི་ལྟར་བསྟན་པའི་བྱ་བ་ཆེས་པས་གདན་མ་འདྲོངས།",
    "ང་རང་ལ་ཡང་བར་ཆོད་བྱུང་ན་ཇོ་བོ་ཆེན་པོ་སྤྱན་མི་འདྲོངས་པར་གདའ་བས་ཁོ་དང་ཐབས་མཁས་པས་བསྟུན་གྱིས་བསླུས་པ་དང་།",
    "འོ་ན་ཁྱེད་རང་པཎྜི་ཏ་གདན་འདྲེན་པའི་འཕྲོ་བཤོལ།",
    "ཁྱེད་རང་ཡང་ངའི་འོག་ཏུ་ཞུགས།",
    "པཎྜི་ཏ་གདན་མ་དྲངས་པར་ཁྱེད་རང་ངེད་ཀྱི་འོག་ཏུ་ཞུགས་ཟེར་བ་པ་ནི།",
    "གསེར་ང་རང་ཙམ་རྙེད་པ་ཤིན་ཏུ་རྔམས་ཆེ་ན་ད་མགོ་བོ་ཙམ་པ་ག་ན་རྙེད།",
    "ལྷ་བཙུན་པའི་གསུང་དེ་རྣམས་ཤིན་ཏུ་མད་པར་འདུག་པ་དང་།",
    "ཐུང་ས་ན་ཐུང་བ་འདི་ལྟར་བྱེད་པ་ཡིན་ཟེར་ནས་མ་ཎི་པདྨེའི་གདངས་ཤིག་འདི་ལྟར་འཐེན་གྱིན་གདའ།",
    "དེ་ནས་སྒོ་སྲུངས་བྱིས་པ་ཅིག་གདའ་བ་དེ་ལ་གསེར་རྣམས་བཅོལ་བ་དང་།",
    "ཁྱེད་རང་རྣམས་འོན་ཀྱང་བློ་གཏད་ཐུབ་པ་གྲོགས་ཀྱི་མཆོག་བྱ་བ་ཡིནབག་ཕེབས་པར་གཟིམས་ཟེར་བས་ཆུང་ཆུང་འདིའི་ཁ་ནས་དེ་འོང་བ་གང་ཟག་ཐ་མལ་བ་ཅིག་མིན་ནམ་སྙམ་དུ་བག་ཕེབས་པར་གྱུར།",
    "དྲང་སྲོང་དེ་ནས་སྲང་ནང་རིང་པོ་ཅིག་ལ་ཞུགས་ཕྱིན་ཙ་ནབྱུང་།",
    "རི་རྒྱལ་ལྷུན་པོ་ལྟ་བུར་བཞུགས་གདའ་བ།",
    "གཤེགས་བཞུགས་བྱེད་ཙ་ན།",
    "སྐུ་འགྱིང་མི་བྱེད་པར་ལྕམ་པོར་གཤེགས་པ་ཅིག་ཕྱི་ནང་དུ་རྒྱངས་ཏེ་བྱོན་ཙ་ན།",
    "ཚོར་བ་ཨ་བྱས་ཙ་ན།",
    "ཕྱི་གཞུག་ན་ཕར་ལ་ཕྱིན་ཙ་ན་སྤྲང་བོ་ཅིག་ལ་གཏོར་ཟན་དང་ལྷ་བཤོས་སྟེར་གྱིན་གདའ།",
    "ནངས་པར་དེར་བསྒུགས་ཙ་ན་རྣལ་འབྱོར་མ་ཁྲི་སྙན་རྐེད་ལ་དཀྲིས་པ།",
    "དེ་དག་མེད་ན་ནི་དོས་དྲུག་ཅུ་རྩ་གཉིས་ཙམ་ཡོད་པ་མི་འདྲོངས་པར་གདའ་བས།",
    "བོད་ཀྱི་ཚེ་དང་ལྡན་པ་འདི་ལ་གནས་ཆེན་རྣམས་ཀྱི་གཙུག་ལག་ཁང་སྟོན་དགོས་པར་གདའ།",
    "འོན་ཏེ་བོད་དུ་བཞུགས་ཞེས་གསོལ་བ་ཐོབ་ཅིག་དེ་ཙ་ན་རྒྱལ་བ་ཡབ་སྲས་ཀྱི་ཞལ་ནས།",
    "དེ་ནས་མི་ཏྲའི་གཙུག་ལག་ཁང་སྒྲོལ་ནས་མཐའ་འཁོབ་ན་ཕར་སླེབ་ཙ་ན།",
    "ཅེས་པའི་སྤྲིང་ཡིག་གདའ་བ་དང་།",
    "སུ་ལའང་མི་བསྐུར་ང་རང་འཁུར།",
    "ཕྱོགས་དེ་བཞུགས་ཉམས་དགའ་ཞིང་ཡིད་སྤྲོ་བ་ཅིག་གདའ་བས་ཞག་བདུན་ཙམ་བཞུགས།",
    "ད་པཎྜི་ཏ་དེ་ཅི་འདྲས་སྣང་རང་ལྟ་དགོས་ཟེར་ནས་པཎྜི་ཏ་གར་སླེབ་ཀྱི་གཏམ་ཉན།",
    "ལྷ་ཁུ་དབོན་གྱི་མི་ནོར་ཟས་གསུམ་ཟད་པའི་པཎྜི་ཏ་དེ་ཇི་འདྲ་ཅིག་སྣང་རང་ལྟའོ་ཟེར་ནས།",
    "བལ་བོར་ཨ་ཏི་ཤའི་ཐུགས་དམ་གཙུག་ལག་ཁང་ཅིག་བཞེངས་པར་གདའ་བས།",
    "དུས་རྣམས་ཐམས་ཅད་དབྱར་གྱི་དུས་བཞིན་གདའ།",
    "ལེའུ་ཆེ་བ་རྣམས་ཀྱི་རྒྱབ་བར་སྐབས་བར་སྐབས་ན་བྲིས་ནས་འདུག་གསུང་ངོ།",
    "མཐུན་འགྱུར་བརྗོད་ཅིང་མཁའ་ལ་བྱོན་ཞེས་གདའ།",
    "རི་བྲག་ཏུ་བསོད་སྙོམས་པས་བསྐྱང་རང་མི་ནུས་པ་དང་།"
  ]
}