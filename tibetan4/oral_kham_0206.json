    "དོ་སྣང་བྱེད་དགོས་པ་ཞིག་ནི་ཤེས་ཀྱི་འདུག་ཡིན་ན་ཡང་།",
    "ལོ་གཅིག་མ་སུ་རི་ལ་ཕྱིན་པའི་སྐབས་སུ་ཕྲེང་རིང་ཁོ་རང་གཉིས་དང་སྐད་ཆ་བྱུང་དོན།",
    "བཀའ་གནང་རང་ཞེས་པའི་སྐད་ཆ་དེ་ཚོའི་སྒང་ལ་ཕྱིན་པ་ཡིན་ན།",
    "དེ་ཚོར་ངེས་པར་དུ་བསམ་བློ་གཏོང་དགོས་ཀྱི་འདུག་དཔེར་ན།",
    "ཚུར་འདྲི་མཁན་མ་བྱུང་ན་ང་ཡས་ཡས་དྲན་གྱི་འདུག་མས་མས་དྲན་གྱི་འདུག་ཅེས་ལབ་མི་ཤེས།",
    "གནས་ཚུལ་འདི་གོ་ལྡོག་པའི་སྐྱོན་འདུག་བསམ་པ་དྲན་བྱུང་།",
    "ང་ལ་དམིགས་བསལ་ཞུ་རྒྱུ་གང་ཡང་མི་འདུག་ཚང་མས་ཧུར་ཐག་བྱས་དོགས་པ་མེད།",
    "རང་རང་སོ་སོས་ལས་དོན་སྒྲུབ་ཐུབ་པ་ཞིག་མ་བྱུང་ན།",
    "མི་དེ་སྤུས་དག་པོ་ཞིག་དགོས་ཀྱི་འདུག་དེ་གལ་ཆེན་པོ་འདུག།",
    "ག་དུས་ཡིན་ཀྱང་དུས་དང་རྣམ་པ་ཀུན་ཏུ་རྒྱ་མི་ཟོས་མི་བདེ་བ་བཟོ་རྒྱུ་དང་།",
    "གང་འདྲ་ཞིག་འདུག་གམ།",
    "རྒྱ་གར་ནང་སྐྱེས་པའི་ཕྲུ་གུ་ཚོ་ཀླད་པ་སྐྱོ་བ་འདུག་ཟེར་བ་དེའི་མཐོང་ཚུལ་གང་ནས་བྱུང་བ་ཡིན་ནམ།",
    "ཨ་རབ་མི་ཚོས་ཨེ་ཌོམ་ཟེར་གྱི་འདུག་བསམ་བྱུང་།",
    "བོད་སྐད་ཁོ་རང་ཡར་རྒྱས་གཏོང་ཐུབ་ན་ལུང་པ་གཞན་དག་ཅིག་ལ་བརྗེས་པ་ཡིན་ན་ནི་གང་ཤེས་མ་གཏོགས།",
    "ངས་འདིར་དམིགས་བསལ་ཤོད་རྒྱུ་དེ་ཙམ་མི་འདུག།",
    "སྔོན་ལ་སོ་སོར་ཞུ་དག་གཏོང་རྒྱུ་གལ་ཆེན་པོ་འདུག།",
    "བསམ་བློ་གཏོང་སྟངས་དེ་དཔེ་མི་སྲིད་པའི་གལ་ཆེན་པོ་འདུག་དེས་འཕྲལ་སེལ་གྱི་ཕྲུ་གུའི་བསམ་བློར་ཞི་བདེ་བག་ཕེབས་སྤྲོད་ཐུབ་པ་དང་།",
    "རྐུན་མ་ཙག་ཙིག་རྐུ་མཁན་དེ་འདྲ་ཡང་ཡོང་གྲབས་བྱེད་ཀྱི་འདུག་མ་གཞི་མི་ཡོངས་རྫོགས་བརྒྱ་ཆའི་བརྒྱ་ཐམ་པའི་སྤུས་དག་པོ་ཡོང་ཐུབ་རྒྱུ་དེ་མི་སྲིད་པ་ལྟ་བུ་ཡིན་ན་ཡང་།",
    "མ་བླངས་ནའང་རུང་ཁྱད་གང་ཡང་མི་འདུག་མི་དེ་མ་ཤི་བར་དུ་རྫུན་མི་ཤོད་མཁན་ཞིག་དང་།",
    "ཡག་པོ་མི་འདུག་ཅེས་ཤོད་ཀྱི་འདུག་དེ་ཚོའི་གྲས་ཤེས་བཞིན་ཁྱད་གསོད་བྱས་པ་ག་ནས་ཡིན་ཏེ།",
    "ཕྱིན་ཆད་དེ་འདྲའི་མཐོང་ཚུལ་མ་ལྷགས་པའི་ཡར་རྒྱས་ཡོང་ཐབས་ལ་རིག་པ་བསྒྲིམ་དགོས་ཀྱི་འདུག་ཚང་མས་གཟབ་གཟབ་བྱེད་དགོས།",
    "གཞན་དག་མི་འདུག་གམ།",
    "ཁྱེད་རང་གཉིས་ནས་འདིར་སླེབས་པའི་གྲས་ལ་དོ་སྣང་དང་ཉམས་མྱོང་ཡོད་པ་སུ་འདུག་རྒྱུས་ཡོད་བྱེད་དགོས།",
    "རྒྱ་གར་བ་ཁོང་སོགས་བོད་ཀྱི་རིག་གཞུང་ལ་དོ་སྣང་ཡོད་པ་ཁ་ཤས་ཕེབས་འདུག་པར་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "རང་རང་སེམས་པ་སྐྱིད་པོ་ཡོང་བ་ལའང་དགོས་མཁོ་ཡོད།",
    "ང་རང་སྒེར་གྱིས་དེ་ལྟར་ཡིད་ཆེས་བྱེད་ཀྱི་ཡོད།",
    "ཞིབ་ཚགས་ཐོག་ལ་ངོས་ཀྱིས་ཤེས་ཀྱི་མེད་ལ་ཞུ་རྒྱུ་གང་ཡང་མི་འདུག་ཕྱོགས་ཡོངས་ནས་བསམ་བློ་ཞིག་བཏང་བ་ཡིན་ན།",
    "དེ་ཏན་ཏན་ཕན་ཐོགས་ཡག་པོ་ཡོང་བ་འདུག་གཞན་རིགས་ལམ་སློབ་ཟེར་དུས་ཡིན་གཅིག་མིན་གཅིག་བསྡུས་གྲྭ་ཁ་དོག་དཀར་དམར་ལྟ་བུ་བསྡུས་ཆུང་དང་བསྡུས་འབྲིང་ནས་སློབ་དགོས་པ་དེ་འདྲ་མིན་པ་བྱས།",
    "ཞེས་ཆེད་མངགས་ལྟ་སྐོར་ལ་ཡོང་མཁན་བྱུང་འདུག་རྗེས་སུ་དེ་འདྲ་ལ་དོ་སྣང་གསར་པ་བྱུང་སྟེ།",
    "འོན་ཀྱང་ཁོ་ཚོས་དཔྱད་པ་བྱེད་སྟངས་དེ་ཡག་པོ་ཞེ་དྲག་འདུག་བསམ་བློ་ཧ་ལས་པའི་གསལ་པོ།",
    "རྒྱ་ཡིག་ནང་ལ་མེད་པ་དེ་འདྲ་ཡིན་གཅིག་མིན་གཅིག་བསྒྱུར་དགོས་ཀྱི་འདུག་ཅེས་སྐད་ཆ་བྱུང་།",
    "དེ་རིགས་པའི་འགྲོ་སྟངས་ཤིག་མི་ལ་ཡང་རང་བཞིན་ལྷན་སྐྱེས་ཀྱི་རྣམ་དཔྱོད་ཀྱི་ནུས་པ་ཞིག་ཡོད།",
    "རྒྱལ་ཁབ་དང་མི་རིགས་གཞན་སུས་ཀྱང་འགྲན་མི་བཟོད་པའི་མཁས་པ་མང་པོའི་འབྱུང་གནས་སུ་གྱུར་ནས་སྒྲ་སྒྱུར་དང་རང་རྩོམ་གྱི་གཞུང་ལུགས་གཉིས་ཆ་ནས་ས་སྟེང་འདིའི་ཡུལ་ཁམས་ཐམས་ཅད་ལས་བཟང་ཤོས་དང་མང་ཤོས་བྱུང་བའི་ཁར།",
    "ལས་བྱེད་སུའི་ཐད་ནས་ཀྱང་རང་བཞིན་དེ་མུར་འཇོག་ཐབས་མེད་པའི་གནས་ཚུལ་ཚབས་ཆེ་ཞིག་ཡིན།",
    "ཚང་མས་ཐུགས་སྣང་དགོས་པ་ཅི་སྙེད་ཅིག་འདུག་སྟབས།",
    "འདི་ལོ་༢༩ ལོར་འཛིན་རིམ་༡༢ ཐོན་མཁན་གྲངས་༡༢ བྱུང་འདུག་སློབ་ཐོན་གྲངས་འབོར་དེའི་ཕྱེད་ཀ་ཙམ་བོད་ཁྱིམ་གཉིས་ནས་ཡིན་ཞིང་།",
    "གནས་ཚུལ་དེ་དག་ལས་ཕྲུ་གུའི་ཕ་མ་དང་འབྲེལ་ཡོད་དགེ་ལས་མང་པོའི་ཡིད་ཆེས་དང་སེམས་ཤུགས་འཕེལ་བཞིན་འདུག་༡༧",
    "གཙོ་བོ་རང་རང་སོ་སོས་དཔྱད་པ་གནང་དགོས།",
    "ང་རང་སྒེར་ལྟ་བུ་ཡིན་ན།",
    "དེར་ཐུགས་སྣང་དང་མཁྱེན་པ་གནང་དགོས་ཀྱི་འདུག་ཟེར་བ་དེ་དོན་དག་གཅིག་ཡིན།",
    "ཕ་མས་བརྡུངས་ནའང་ཁ་ལ་མི་ཉན་པར་ག་དུས་ཡིན་ཡང་རྐུ་མ་བརྐུས་ནས་མདུན་དང་རྒྱབ་ཚང་མར་བུ་རམ་བཟའ་སྡོད་མཁན་ཞིག་ཡོད།",
    "ཁོས་དེ་འདྲའི་བུ་རམ་བཟའ་བསྡད་ཀྱི་འདུག་དེར་བཀའ་སློབ་ཅིག་གནང་རོགས་གནང་།",
    "གཟུགས་པོར་གནོད་ཀྱི་འདུག་ཞུས་པས།",
    "གནྡྲིས་ཁ་སང་ཁྱེད་རང་ཡོང་བའི་སྐབས་སུ་ངས་ཀྱང་བུ་རམ་བཟའ་བསྡད་ཡོད་ཅེས་གསུངས།",
    "དེ་ལ་དགོས་པ་ཡོད་པ་དང་དགག་བྱ་ཡོད་པ་ཞིབ་ཚགས་པོ་བྱས་ནས་མ་བལྟས་པའི་བཟོ་འདྲ་པོ་འདུག་ཡིན་ནའང་།",
    "ག་འདྲའི་མགྱོགས་པོ་རྒྱུག་ཐུབ་ཀྱི་མི་འདུག་ཁྱེད་རང་ད་ལྟ་གོག་ནས་སྡོད་ཀྱི་འདུག་ཟེར་བ་ལྟ་བུ།",
    "ལབ་ཀྱི་འདུག་ཨིན་ཇིའི་སྐད་ལ་ལབ་ཀྱི་འདུག་སྟབས།",
    "དྲི་བ་དྲིས་ལན་གྱི་དུས་ཚོད་དེ་ཏོག་ཙམ་མང་བ་དགོས་ཀྱི་འདུག་གང་ཡིན་ཞེ་ན།",
    "ཚོགས་ཞིང་རང་ལ་ཐིམ་པར་གྱུར།",
    "སླར་ཡང་རང་ཉིད་དགྱེས་པ་རྡོ་རྗེ་ཞལ་གཅིག་ཕྱག་གཉིས་པའི་རྣམ་པར་གྱུར།",
    "དང་པོའི་ཕྱག་གཉིས་རང་རང་རྟགས་མཚན་ལྡན།",
    "སླར་སྔགས་ཕྱོགས་ཀྱི་ཉམས་ལེན་སྐོར་ལ་དྲི་བ་ཞུས་པ་འདི་གལ་ཆེ་འདུག་པས་ཊཱིཀྐ་རྒྱས་པ་ཞིག་བགྱི་ལ་བསྐུར་ཞེས་གསུང་ཡིག་བྱུང་བ་ལ་བརྟེན་ནས་ལན་འབུལ་བ་ལ།",
    "དེ་ཡང་རང་ཉིད་སྲིད་པའི་མཚོར།",
