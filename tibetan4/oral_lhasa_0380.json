    "རྣམ་པར་མ་ཆད་པར་གནས་པ་ནི་རྒྱུན་ཆད་པ་མེད་པས་སོ།",
    "འོ་ན་ནི་རིམ་པར་རྣམ་པར་མ་ཆད་པར་གནས་པ་དེ་ཡང་ཇི་ལྟར་ཞེ་ན་སྐྱེ་བ་དང་འཆི་བ་བརྒྱུད་པས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གལ་ཏེ་རྒྱུན་ཅན་ཐ་དད་པར་ཡོད་དུ་ཟིན་ཀྱང་རྒྱུན་ནི་གཅིག་པ་ཉིད་ཡིན་ནོ་ཞེ་ན།",
    "བརྗོད་པར་རིགས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྒྱུན་འདི་ནི་གཅིག་པ་ཁོ་ན་ཡིན་པས་ཞེས་བྱ་བ་ནི་སྔོན་པོའི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པའི་མཚན་ཉིད་ཅན་རྣམས་སོ།",
    "གལ་ཏེ་དེ་ལྟར་ཡིན་ན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་རྒྱུན་གཅིག་པ་ཡིན་པར་གྲུབ་ནའོ།",
    "འདི་ནི་བསྒྲུབ་བྱ་ཞིག་གོ་ཞེས་བྱ་བ་ནི་རྒྱུན་གཅིག་པ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་ཞེས་བྱ་བ་ནི་རྒྱུན་གཅིག་པ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་པ་ཅིའི་ཕྱིར་ཞེ་ནའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སྐབས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྒྱུན་ཐ་མི་དད་པའི་རྟེན་ཅན་ཉིད་དུ་ཡོད་པར་མི་འོས་ཏེ་ཞེས་བྱ་བ་ནི་ཐ་མི་དད་པའི་རྒྱུན་གྱི་རྟེན་ཉིད་དུ་གང་བརྟགས་པ་དེ་མི་རིགས་པའོ།",
    "ལན་ནི་གཞན་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བྱམས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གཞན་ཉིད་ཀྱི་ཕྱིར་ན་ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་སྐད་ཅིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་འགྲེལ་བས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ནུས་པའི་སྐད་ཅིག་མར་མེད་པ་གང་ཞིག་ལས་ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ཡོད་པའི་བག་ཆགས་ཡོངས་སུ་སྨིན་པའི་མཚན་ཉིད་ཅན་ནུས་པའི་སྐད་ཅིག་མ་ལས་སོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རྟེན་དུ་གྱུར་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཕྱི་གཟུང་བ་མེད་པར་ཞེས་བྱ་བ་ནི་ཕྱི་རོལ་གྱི་དོན་མེད་ཀྱང་ངོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་ཉིད་ཅེས་བྱ་བ་ནི་སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པར་སྣང་བ་ཉིད་དོ།",
    "དེ་ལ་དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དཔེར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་རྣམ་པར་ཤེས་པ་ལས་ཕྱི་རོལ་གྱི་དོན་ཡོད་པ་ཁྱམ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་མཇུག་བསྡུ་བའོ།",
    "གཟུགས་དོན་གཞན་མེད་པར་ཞེས་བྱ་བ་ནི་ཕྱི་རོལ་གྱི་དོན་མེད་པར་རོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནི་དེ་ལྟར་མ་ཡིན་ནོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྨི་ལམ་དུ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་སྟེ།",
    "སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པར་སྣང་བའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་འགྱུར་བའོ།",
    "སྨིན་ལས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ཡོད་པའི་བག་ཆགས་ལས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཡང་མི་རིགས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ལྔ་ལ་ལྟོས་ནས་དྲུག་པ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་གཉིད་ཀྱི་རྐྱེན་གྱི་སྟོབས་ཀྱིས་རྨི་ལམ་ན་ནུས་པ་སྨིན་པ་ཡོད་ལ།",
    "ཅི་ལྟར་སད་པའི་གནས་སྐབས་ན་ལོང་བ་ལ་དྲུག་པ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ནུས་པ་སྨིན་པ་མེད་པ་དེ་བཞིན་དུ་རྨི་ལམ་གྱི་ཚེ་ཡང་དྲུག་པ་ནུས་པ་མེད་ཅེས་ཅིའི་ཕྱིར་མི་རྟོགས་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དྲུག་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ན་ཅི་ལྟར་སད་པ་ལ་རྣམ་པ་དེ་ལྟ་བུའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེས་ན་སད་པའི་གནས་སྐབས་ན་དེ་མེད་པས་རྣམ་པ་དེ་ལྟ་བུའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མེད་པ་ཡིན་ལ།",
    "རྨི་ལམ་ན་ནི་རྐྱེན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་རྣམ་པ་དེ་ལྟ་བུའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "པར་ཤེས་པ་སྐྱེ་བར་འགྱུར་ན་གཉིད་ཀྱི་རྒྱུ་ཅན་མ་ཡིན་ནོ་ཞེས་ངེས་པར་གྱིས་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྨི་ལམ་མཐོང་བས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཡོངས་སུ་འགྱུར་བ་ནི་དེ་ལས་སྐྱེས་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡིན་ལ།",
    "དེས་ན་ཅི་ལྟར་ལོང་བ་ལ་མིག་མེད་པ་ཡིན་དུ་ཟིན་ཀྱང་རྣམ་པ་དེ་ལྟ་བུའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་རྒྱུར་མིག་མེད་པ་དེ་མི་འགྱུར་བ་དེ་བཞིན་དུ་རྨི་ལམ་ན་ཡང་གཉིད་ཡོད་དུ་ཟིན་ཀྱང་རྣམ་པར་ཤེས་པ་དེ་ལྟ་བུའི་རྒྱུ་ཉིད་དུ་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "སད་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ཡིན་པའི་ཕྱིར།",
    "འདི་ལྟར་སྔར་བསྟན་པའི་རྣམ་པས་རྨི་ལམ་གྱི་རྣམ་པར་ཤེས་པ་ལ་དོན་གྱིས་སྟོང་པ་ཉིད་དང་།",
    "རུས་སྦལ་གྱི་སྤུའི་གོས་ཀྱང་བཏགས་པའི་དངོས་པོར་ཡོད་པས་མེད་པར་མ་གྲུབ་པའི་ཕྱིར་དང་།",
    "ཞེས་གསུངས་པས་ཐམས་ཅད་ལ་ཡུལ་མེད་པར་མ་གྲུབ་པས་ལན་ཐམས་ཅད་དམ་བཅའ་བ་དང་མཚུངས་པ་ཁོ་ན་ཡིན་ནོ།",
    "འོན་ཀྱང་བཏགས་པ་དེ་ཉིད་ལ་རྟོག་གེ་པ་ངན་པ་དངོས་པོའི་རང་བཞིན་དུ་ཕྱིན་ཅི་ལོག་ཏུ་རྟོགས་ནས་དངོས་པོའི་རང་བཞིན་དུ་རྟོག་པར་བྱེད་དོ།",
    "ཀུན་གཞི་མེད་ཅིང་ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་འགོག་པའོ།",
    "ཞེས་བྱ་བ་ནི་རང་བཞིན་ཕྱིན་ཅི་ལོག་ཏུ་རྟོག་པར་བྱེད་པའི་བྱིས་པ་རྣམས་ཀྱི་དངོས་པོ་ལ་སོགས་པ་འདི་དག་བཏགས་པའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཅིག་ལ་གཅིག་མེད་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དངོས་པོ་མེད་པར་རྣམ་པར་རྟོག་པ་རྣམས་ལྡོག་པར་མི་འགྱུར་བས་སོ།",
    "བ་ལང་རྟ་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་སྒྲས་ནི་གལ་ཏེ་རྣམ་པར་ཤེས་པའི་རང་བཞིན་འགྲུབ་པར་འགྱུར་ན་དེའི་ཚེ་གཅིག་ལ་གཅིག་མེད་པའི་སྟོང་པ་ཉིད་ཀྱིས་དངོས་པོ་རྣམས་ལ་རང་བཞིན་མེད་པ་ཉིད་རིགས་པ་ཡིན་གྱི།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྗེས་སུ་འཛིན་པར་བྱེད་པའི་རྣམ་པར་ཤེས་པ་ལྔ་དང་མཚུངས་པར་ལྡན་པ་དང་།",
    "རྣམ་པར་ཤེས་པ་ལྔ་དང་མཚུངས་པར་ལྡན་པ་དང་།",
    "ཡང་ཤེས་པར་བྱར་མེད་དོ་ཞེས་ཁོང་དུ་ཆུད་པའི་ཕྱིར་རོ།",
    "སྡུག་བསྔལ་ལ་ནི་ཁོང་ཁྲོ་དང་སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་པ་ལ་ནི་མ་རིག་པའོ་ཞེས་གསུངས་པས་སོ།",
    "རྒྱས་པར་མཛོད་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ནི་མིག་མ་ལགས་སོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་མེད་པས་སོ།",
    "ཡང་དག་པ་མ་ལགས་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "མིང་དུ་གདགས་པར་བས་ཀྱི་ཞེས་བྱ་བ་ནི་དོན་གྱིས་སྟོང་པའི་ཕྱིར་རོ།",
    "དོན་ལ་སྦྱར་བར་བྱ་བའི་ཕྱིར་དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བརྫུན་ཞིང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྒྱས་པར་བསྟན་པའོ།",
    "དོན་དམ་པར་ནི་མ་ལགས་སོ་ཞེས་བྱ་བ་ནི་གྲོ་སླའོ།",
    "དོན་དམ་པར་མ་ལགས་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྨི་ལམ་ན་ཡང་དེས་དེ་དག་མ་རྙེད་ན་ཞེས་བྱ་བ་ནི་བདག་ལས་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པས་སྐྱེ་བ་མེད་པར་བསྒྲུབས་པའི་ཕྱིར་རོ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར་དེའི་ཕྱིར་སྟོན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཤེས་རབ་ཀྱི་རྩལ་མེད་པར་སྦྱར་བ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འོན་ཀྱང་ཀེང་རུས་ཀྱི་ཡུལ་ཅན་གྱི་ཤེས་པ་ནི་སྐྱེ་བའི་ཕྱིར་ཡུལ་མེད་པའི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གྲུབ་པ་ཡིན་ནོ་ཞེ་ནའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཏིང་ངེ་འཛིན་དེ་ནི་ལོག་པ་ཡིད་ལ་བྱེད་པར་བསྟན་པསྐོ་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་འདིར་ཏིང་ངེ་འཛིན་ནི་རྣམ་པ་གཉིས་ཏེ།",
    "དེ་ལྟར་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་དེ་ཁོ་ན་ཉིད་ཡིད་ལ་བྱེད་པར་མ་གྱུར་ནའོ།",
    "རྟོགས་འགྱུར་ཞེས་བྱ་བ་ནི་ཀེང་རུས་རྟོགས་པར་འགྱུར་བའོ།",
    "དེ་ནི་བརྫུན་པར་ཡང་མི་འགྱུར་ཞེས་བྱ་བ་ནི་ཏིང་ངེ་འཛིན་དེ་ཁོ་ན་ཉིད་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པ་མ་ཡིན་པར་མི་འགྱུར་རོ་ཞེས་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཏིང་ངེ་འཛིན་དེ་ཁོ་ན་ཉིད་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པར་ཡང་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་ཀྱིས་ཀེང་རུས་ཀྱི་རྣམ་པར་རྟོག་པ་ཡིན་པས་སོ།",
    "དེ་བཞིན་དུ་གཞན་ལ་ཡུལ་མེད་པའི་བློ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་སྔར་བཞིན་གསུངས་པ་བསྡུ་བར་བྱའོ།",
    "སྤྲོས་པས་ཆོག་གོ་ཞེས་བྱ་བ་ནི་ཡུལ་མེད་པའི་ཤེས་པ་ཡོད་པ་ཉིད་དུ་བསྒྲུབ་པ་དང་དེ་འགེགས་པར་བྱེད་པའི་སྤྲོས་པས་ཆོག་གོ་ཞེས་བྱ་བའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཤེས་བྱ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་གང་ཤེས་པས་ཡུལ་དུ་མ་བྱས་པ་དེ་ཤེས་པར་བྱ་བ་མ་ཡིན།",
    "དེས་ན་ཤེས་པ་ལ་ལྟོས་ནས་ཤེས་པར་བྱ་བར་འགྱུར་རོ།",
    "དེ་མེད་རྣམ་པར་ཤེས་མེད་པ།",
    "ཞེས་བྱ་བ་ནི་ཤེས་བྱ་མེད་ན་ཤེས་པ་ཡོད་པར་མི་འགྱུར་ལ།",
    "དེས་ན་ཤེས་བྱ་ལ་ལྟོས་ནས་ཤེས་པ་ཡོད་པར་འགྱུར་བའོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱི་རོལ་གྱི་ཡུལ་མེད་པར་རྣམ་པར་ཤེས་པ་ཙམ་ཁས་ལེན་པས་སོ།",
    "རྣམ་པར་ཤེས་པ་རྫས་སུ་སྨྲ་བའི་བརྗེད་བྱེད་ཀྱི་གདོན་གྱིས་བཟུང་བ་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཤེས་པ་དོན་དམ་པར་ཡོད་པ་ཡིན་ནོ་ཞེས་གང་སྨྲ་བ་དེ་ནི་བརྗེད་བྱེད་ཀྱི་གདོན་ཡིན་ཏེ།",
    "རིགས་པའི་དྲན་པ་ཉམས་པར་བྱེད་པས་སོ།",
    "ལུང་དང་རིགས་པའི་གསང་སྔགས་བཟང་པོ་བཏབ་པས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལན་ནི་མ་བཟུང་བར་ཡོད་ཅེས་བྱར་མི་རུང་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྣམ་པར་ཤེས་པ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་དཔེའི་སྒོ་ནས་རང་རིག་གྲུབ་པར་བསྟན་ནས།",
    "དྲན་པའི་མཚན་ཉིད་ཅན་གྱི་འབྲས་བུའི་རྟགས་ཀྱི་སྒོ་ནས་རང་རིག་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "གང་ཞིག་མི་འདོད་པ་དེས་ཀྱང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིའི་དོན་ནི་མཐོང་ངོ་ཞེས་མཐོང་བས་ཁྱད་པར་དུ་བྱས་པའི་ཡུལ་དྲན་པ་ཡིན་ལ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཤེས་པ་ལ་སྒྲུབ་བྱེད་མེད་པ་ཉིད་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རང་རིག་པ་མེད་པའི་ཕྱིར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤེས་པ་གཞན་གྱིས་ཉམས་སུ་མྱོང་བས་སུན་འབྱིན་པ་ནི་ཤེས་པ་གཞན་གྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཤེས་པ་གཞན་གྱིས་ཉམས་སུ་མྱོང་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཤེས་པ་གཞན་གྱིས་ཉམས་སུ་མྱོང་བ་ལ་ཐུག་པ་མེད་པར་འགྱུར་བའི་སྐྱོན་བརྗོད་ནས་སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཤེས་པ་ཡུལ་གཞན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྣམ་པར་ཤེས་པའི་རྒྱུན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཉིས་པས་ཤེས་པ་ཡོངས་སུ་གཅོད་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་གར་མཁན་གྱི་ཁང་པ་ལ་སོགས་པར་ཞུགས་པའི་ཚེ་ཤེས་པ་ཅིག་ཅར་དུ་སྐྱེ་བ་མཐོང་བ་ཡིན་ཏེ།",
    "གླིང་བུ་ལ་སོགས་པའི་སྒྲ་ལ་དམིགས་པའི་རྣ་བའི་རྣམ་པར་ཤེས་པ་དང་།",
    "ག་པུར་ལ་སོགས་པའི་དྲི་ལ་དམིགས་པའི་སྣའི་རྣམ་པར་ཤེས་པ་དང་།",
    "སོ་རྩི་ལ་སོགས་པའི་རོ་མྱོང་བའི་དམིགས་པ་ལྕེའི་རྣམ་པར་ཤེས་པ་དང་།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འཇུག་པ་མྱུར་བས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཨུཏྤ་ལའི་འདབ་མ་བརྒྱ་འབིགས་པ་ལྟར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེས་ན་རང་རིག་ཁས་བླང་བར་བྱ་དགོས་སོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཐུག་པ་མེད་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་རྒྱས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཤེས་པའི་རང་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁྱད་པར་གཞན་ཡང་ཇི་ལྟ་བུ་ཞེ་ན།",
    "གང་ལ་དུས་ཕྱིས་གཉིས་ཀུའི་ཡུལ་ཅན་གྱི་དྲན་པ་སྐྱེ་བ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རང་ཉམས་སུ་མྱོང་བ་ཡོད་ན་ཞེས་བྱ་བ་ནི་རང་རིག་ཡོད་པར་གྱུར་ནའོ།",
    "དེ་ཡང་རིགས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མི་རིགས་པ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཉིད་ཀྱིས་དེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མ་གྲུབ་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཚེ་ཞེས་བྱ་བ་ནི་རྫས་སྒྲུབ་པར་བྱེད་པའི་ཕྱོགས་ལའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་མ་གྲུབ་པའི་དྲན་པས་མ་གྲུབ་པའི་རང་རིག་སྒྲུབ་པར་འགྱུར་ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གལ་ཏེ་འདིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་མ་ངེས་པ་ཉིད་དུ་དཔེའི་སྒོ་ནས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་དག་མེད་པར་ཡང་ཞེས་བྱ་བ་ནི་ནོར་བུ་ཆུ་ཤེལ་དང་ནོར་བུ་མེ་ཤེལ་དག་གོ།",
    "དེ་མེད་པར་མེད་པས་ཞེས་བྱ་བ་ནི་རང་རིག་མེད་པར་དེའི་རྒྱུ་ཅན་དྲན་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "ད་ནི་རང་རིག་ཁས་བླངས་ཀྱང་དྲན་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་སྟེ་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་རྣམ་པར་དཔྱོད་པ་བཏང་ནས་ཀྱང་།",
    "གཞན་ཕྱིར་མ་ཤེས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་ཤེས་པའི་རྒྱུད་ཡིན་པས་ན་ཤེས་པའི་རྒྱུད་དེ་བྱམས་པའི་ཤེས་པའི་རྒྱུད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "གཞན་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བྱམས་པ་དང་ཉེར་སྦས་ཀྱི་ཤེས་པ་དག་ནི་རྒྱུད་གཅིག་ཏུ་གཏོགས་པ་དང་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་གཞན་ཡིན་པ་ཙམ་གྱི་སྒོ་ནས་དྲན་པ་མེད་པར་ཅི་ལྟར་སྒྲུབ་ཅེ་ན།",
    "གཏན་ཚིགས་འདིས་ནི་ཁྱད་པར་དག་ཀྱང་འཇོམས།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྒྱུ་དང་འབྲས་བུའི་དངོས་པོའི་མཚན་ཉིད་ཅན་གྱི་ཁྱད་པར་དག་འཇོམས་པར་བྱེད་པའོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ན་ཞེས་བྱ་བ་ནི་རྣམ་པར་དཔྱད་ན་རང་རིག་མི་རིགས་པས་རང་རིག་ཁས་བླངས་པ་ཙམ་དུ་སྟོན་པའོ།",
    "དྲན་པའི་ཤེས་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དྲན་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཤེས་པ་དང་དོན་དག་གོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདིའི་དོན་ནི་གལ་ཏེ་ཉམས་སུ་མྱོང་བ་དང་དྲན་པའི་ཤེས་པ་དག་ཐ་དད་དུ་ཁས་ལེན་ན་དེའི་ཚེ་རྒྱུད་གཞན་དུ་གཏོགས་པའི་ཤེས་པ་བཞིན་དུ་དྲན་པར་མི་རིགས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཏན་ཚིགས་འདིས་ནི་ཁྱད་པར་དག་ཀྱང་འཇོམས།",
    "དྲན་པ་དང་ཡུལ་དང་ལྡན་པར་འབྱུང་ལ་ཞེས་བྱ་བ་ནི་དྲན་པ་ཉམས་སུ་མྱོང་བའི་ཤེས་པས་ཉམས་སུ་མྱོང་བའི་ཡུལ་དང་ལྡན་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་དྲན་པའི་སྒོ་ནས་རང་རིག་མི་འགྲུབ་པར་བསྟན་ནས།",
    "རང་རིག་ངོ་བོའི་སྒོ་ནས་ཀྱང་མི་རིགས་པ་ཉིད་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བྱེད་པ་པོ་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་འདིར་རང་རིག་ནི་བདག་ཉིད་རིག་པ་ཡིན་ལ།",
    "བདག་ཉིད་ཀྱིས་ཡིན་པར་ཁས་ལེན་ན་བདག་ཉིད་བྱེད་པ་པོར་ཁས་བླངས་པ་ཡིན་ལ།",
    "བདག་ཉིད་རིག་པར་བྱ་བ་ཡིན་པས་བདག་ཉིད་བྱ་བར་ཡང་ཁས་བླངས་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "དེ་ཉིད་ཀྱིས་དེ་འཛིན་པར་རིགས་པ་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བདག་རིག་པ་བྱེད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
