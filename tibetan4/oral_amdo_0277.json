    "སྒྲིབ་གཉིས་རྣམ་བྱང་ཚོགས་གཉིས་རབ་རྫོགས་ཕྱིར།",
    "ཤུགས་ཆེན་སྤྱོད་པས་ཉོན་མོངས་གདར་ཤ་གཅོད།",
    "མཆོག་ཐུན་དངོས་གྲུབ་རེ་དོགས་མེད་པར་ཐོབ།",
    "སྡུག་བསྔལ་ཉོན་མོངས་ཚ་གདུང་བསིལ་མཛད་པ།",
    "འཆད་པའི་ངག་གིས་གདུལ་བྱ་སྤྲོ་ཞིང་དྭངས།",
    "བདག་འཛིན་ཉོན་མོངས་སྡུག་བསྔལ་གྲོལ་ནས་ཀྱང་།",
    "རྗེས་འབྲང་ཉོན་མོངས་མ་ལུས་རྩད་ནས་བཀྲུ།",
    "གཟིགས་དགོངས་མཛད་པ་ལྷུན་གྲུབ་དབེན་ས་ཁར།",
    "དུང་གི་ཟླ་བ་མཁའ་ལ་ཚེས་པ་བཞིན།",
    "སྒྲིབ་གཉིས་བྱང་ཞིང་ཚོགས་གཉིས་རིམ་པ་རྫོགས།",
    "ཉོན་མོངས་བརྒྱད་ཁྲི་བཞི་སྟོང་ཕྱགས་མས་འདེ་བས།",
    "རིག་པའི་གནས་ལྔར་གཟིགས་པའི་སྤྱན་གཅིག་པ།",
    "ཐུགས་རྗེའི་ལྕགས་ཀྱུས་ངན་སོང་མཐོ་རིས་འདྲེན།",
    "གསུང་གི་རྔ་སྒྲས་སེམས་དཔའ་རྒྱ་མཚོའི་དབུས།",
    "བརྒྱད་ཁྲི་བཞི་སྟོང་གཟིགས་པའི་ཐུགས་ཉིད་ཀློང་།",
    "སྟག་གཟིག་ཡུལ་དུ་ལི་མུར་གཙུག་ཕུད་ཅེས།",
    "ཉོན་མོངས་དུག་ལྔའི་དགྲ་ཚོགས་ཆམ་ལ་ཕབ།",
    "ཉོན་མོངས་སངས་མཛད་གཡུ་བྱ་ཁུ་བྱུག་གསུང་།",
    "གཟུགས་སྒྲ་དྲི་རོ་རེག་རྒྱན་བོན་གཏེར་བཅས།",
    "བདག་སོགས་ཕ་མ་ངན་སོང་སྦྱོང་ཚད་དང་།",
    "རིགས་ངན་མུ་སྟེགས་བྲན་དང་བུད་མེད་དང་།",
    "བདེར་གཤེགས་སྟོང་དང་ལྷ་གཤེན་ལྷ་མོ་བཅས།",
    "མོས་འདུན་སྤྱོད་པར་ལྷ་མི་ཡི་རང་ངོ།",
    "བདག་གིས་སྒོ་གསུམ་འདུན་ཏེ་བསྟོད་པ་ཡིས།",
    "ངན་སོང་གནས་སྦྱང་འགྲོ་རྣམས་དོན་དུ་བསྔོ།",
    "བསྐལ་ངན་ཁྲག་གི་རྒྱ་མཚོ་འཁྱིལ་བའི་དབུས།",
    "བར་ལམ་གཡུང་དྲུང་གླིང་དུ་མཁའ་འགྲོ་མ་ཞིག་གཤེགས་སོང་བས།",
    "གཡོན་དུ་མཁའ་འགྲོ་མོ་རྒྱུད་ཐམས་ཅད་བཞུགས་ནས་སྣང་།",
    "བདག་གིས་ཀྱང་དད་པ་མོས་འདུན་ཆེན་པོ་བསྐྱེད་ནས་མཁའ་སྤྱོད་ནས་མར་བྱོན་ནས།",
    "སྟག་གཟིག་ཞང་བོད་ལོ་པཎ་ཚོགས་རྣམས་དང་།",
    "སྒོ་གསུམ་རྩེ་གཅིག་མོས་པས་གསོལ་བ་འདེབས།",
    "བདག་གི་བློ་གྲོས་པདྨོའི་ཁ་ཕྱེ་སྟེ།",
    "བཅུ་གསུམ་སྟོབས་ཀྱིས་བདུད་བཞིའི་དཔུང་ཚོགས་འཇོམས།",
    "འཛམ་གླིང་མཁས་པ་ཀུན་གྱི་གཙུག་གི་རྒྱན།",
    "གཡུང་དྲུང་བོན་གྱི་ཆེ་བའི་ཡོན་ཏན་ལ་རོང་སྟོན་ཤེས་བྱ་ཀུན་རིག་གིས་བསྟོད་པ་དགེའོ།",
    "བཀའ་སྐྱོང་ཡེ་ཤེས་ཀྱི་དབལ་མོ་ལ་གསོལ་བ་འདེབས།",
    "མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་བསྩལ་ཏུ་གསོལ།",
    "ཡུམ་ཆེན་སྲིད་པའི་རྒྱལ་མོ་ལ་གསོལ་བ་འདེབས།",
    "མ་སྲིང་ཡེ་ཤེས་སྤྱན་གྱིས་བདག་ལ་གཟིགས།",
    "ཞེས་ལན་གསུམ་བརྗོད་དོ། ། ཡུམ་ཆེན་བྱམས་མ་ཆེན་མོའི་སྔགས་བསྟོད་བཞུགས་སོ།",
    "འདིར་བྱམས་མ་ཆེན་མོ་རྩ་བའི་འབུམ་བཞི་ལས།",
    "ད་ལྟ་འདི་ལ་ཐུག་གི་བར་དུ།",
    "རྩ་ལག་གི་ཉམས་ཆགས་སྔར་བྱས་པ་ལ་གནོང་ཞིང་བཤགས་པར་འཚལ་ལོ།",
    "གཡུང་དྲུང་གི་ས་ཆེན་པོ་ལ་རབ་ཏུ་ཞུགས་ནས།",
    "གཡུང་དྲུང་སེམས་དཔའི་སྤྱོད་པ་ཟབ་མོ་ལ་བསླབ་པར་བགྱིའོ།",
    "མ་མཆོག་དུས་གསུམ་རྒྱལ་བའི་ཡུམ་ཆེན་མོ།",
    "ཨོཾ་མ་བ་མ་དེ་མ་ཧི་མོ་ཧ་ཨེ་མ་ཧོ་མ་ཡེ་རུ་པ་ཡེ་ཏ་འདུ་འདུ་སྭཱ་ཧཱ།",
    "ཨོཾ་ནི་ཀུན་གསལ་བྱམས་མ་ཆེན་མོ།",
    "སྟོབས་ཀྱི་བྱམས་མ་སྐུ་ལྔ་མཆོག་གི།",
    "ཀུན་མཁྱེན་ཐམས་ཅད་ཡུམ་གྱུར་ཇོ་མོ།",
    "ཀུན་སྐྱོབ་གཟི་བརྗིད་ཆེ་བའི་ལྷ་མོ།",
    "མོ་ནི་གཡོ་མེད་ངོ་བོ་ཉིད་སྐུ།",
    "རྣམ་དག་པདྨ་གཡུང་དྲུང་ཀློང་གི།",
    "བཅུ་དྲུག་ལམ་འབྱེད་མངོན་ཞུགས་ཆེན་མོ།",
    "ཨོཾ་མ་བ་མ་དེ་མ་ཧི་མོ་ཧ་ཨེ་མ་ཧོ་མ་ཡེ་རུ་པ་ཡེ་ཏ་འདུ་འདུ་སྭཱཧཱ།",
    "ལུང་གི་རྒྱལ་པོ་ཀུན་གསལ་ཆེན་མོ།",
    "ཀུན་གསོལ་བྱམས་མ་ཆེན་མོ་འབུམ་ལྔ་ཁམས་བརྒྱད་བསྟོད་པ་རྗེ་བཙུན་ཁྲོ་ཚང་འབྲུག་ལྷས་ཟར་གྱི་སྟག་སྣ་ནས་གཏེར་ལ་གདན་དྲངས་པ་དགེའོ།",
    "འགྲོ་ལ་རྣམ་བརྩེས་གཟིགས་ཚད་ལྔ་དགོངས་ནས།",
    "ངན་སོང་ལྟུང་ནས་སྡུག་བསྔལ་ཚ་གདུང་ཚེ།",
    "སྟོང་གསུམ་ཀུན་གྲགས་སྒྲ་རྒྱལ་འབྲུག་གི་ཁྲི་ལ་རོལ་བའི་འགྱིང་བག་ཅན།",
    "མི་ཕམ་རྒྱལ་མཛད་དགྱེས་པའི་ཞབས་པད་བདག་གི་སྤྱི་བོར་མྱུར་དུ་ཞོག།",
    "ཅུང་ཟད་མེད་སྙམ་འོན་ཀྱང་བདག་གི་ཉེས་པའི་སྐྱོན་གྱི་སྒྲིབ་པར་ཟད།",
    "བདག་ལ་མགོན་བྱེད་རེ་ས་ཁྱེད་ལས་ལྷག་པའི་གཞན་ན་སུ་མེད་པས།",
    "བདག་གིས་གཞན་ཕྱིར་བཀའ་ཡི་འཁོར་ལོ་བསྐོར་ཞིང་འགྲོ་རྣམས་མྱུར་སྒྲོལ་ཤོག།",
    "དུང་འབུད་པ་དང་།",
    "ནང་གི་རྟགས་ནི་ཉོན་མོངས་ཆུང་བ་དང་།",
    "ཉི་མ་རེར་ཤོ་ལོ་ཀ་སྟོང་རེ་བློ་ལ་ཟིན།",
    "ཉོན་མོངས་ཆུང་བ་དང་།",
    "ཐམས་ཅད་བདག་གིས་ཐོབ་ནས་སུ།",
    "ཤེས་རབ་ལྷ་མཆོག་གྱུར་པར་མོས།",
    "ཁྱོད་ལ་གསང་བའི་འཛབ་མཆོད་འབུལ།",
    "གཟིགས་ནས་ཤེས་རབ་ཡེ་ཤེས་སྩོལ།",
    "བསྐྱེད་རྫོགས་བཟླས་གསུམ་རང་བྱན་ཆུབ་པའི་རྣལ་འབྱོར་པ་རབ་ཀྱིས་འབུམ་ཚོ་གཅིག་གིས་འགྲུབ།",
    "འབྲིང་གིས་འབུམ་ཕྲག་དྲུག་གིས་འགྲུབ།",
    "ཤ་ཆང་སྒོག་པ་བུད་མེད་བཞི་ལ་མི་སྤྱོད།",
    "ཉི་ཟླ་རང་གིས་བལྟ་མི་རུང་བས་རོགས་མིས་སྒྲོག་པའམ།",
    "ཧིརི་རབ་རྩེ་མོ་རྩ་གསུམ་ལྷ་གནས་ཀྱི།",
    "གླིང་དགུ་བཅུད་ཀྱི་ཆུ་གཏེར་ཆེན་མོ་ལས།",
    "རྒྱལ་ཡུམ་ཤེས་རབ་བྱམས་མ་ཆེན་མོ་ཡི།",
    "རྫུ་འཕྲུལ་གསུང་གི་རོལ་གར་གྷིཡིག་ལས།",
    "བསྐྱེད་པའི་ཡུམ་ཆེན་སྒྲ་དབྱངས་ལྷ་མོ་ཞེས།",
