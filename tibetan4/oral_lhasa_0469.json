    "མཁས་པ་ཡོན་ཏན་གྱིས་མི་ངོམས་ཞེས་གསུངས་པ་ལྟར།",
    "དབུས་གཙང་ཐམས་ཅད་གྱི་དགོན་གནས་དང་གཙུག་ལག་ཁང་ཐ་ན་བྲག་ཕུག་དང་གནས་རྙིང་ཞིག་རལ་ཚུན་ཕྱོགས་མཐའ་དག་ཏུ་མྱུལ་ནས།",
    "ཉམས་ཁྱད་པར་ཐོན་པ་ཙམ་སྣང་བས།",
    "རས་རིས་མཐོང་བ་དོན་ལྡན་གྱི་ཞལ་ཐང་ཁྱད་འཕགས་གཅིག་གཡོན་གྱི་ཀུན་དགའ་ར་བ་སྒོ་ཁྱིམ་ལྔའི་དབུས་སུ་ཆེ་ཤེས་ལྷ་བཟོ་རང་ཉིད་ཀྱི་ཐུགས་དམ་རྟེན་དུ་ཕྱག་བཟོ་གནང་བའི་མགོན་པོ་ཕྱག་དྲུག་པའི་སྐུ་བྱིན་ཅན།",
    "ཤེལ་དགོན་དུ་བཞུགས་རིང་ཚེ་ཆུའི་བུམ་པ་གཏེར་ནས་བཏོན་པ་སོགས་གྲུབ་པའི་རྟགས་མཚན་མང་དུ་བསྟན་པར།",
    "གྲུབ་ཐོབ་མཚན་ལྡན་དུ་རྗེ་སྐལ་ལྡན་རས་པ་སོགས་སྐྱེས་ཆེན་དུ་མས་ཞལ་གྱིས་བཞེས།",
    "བཟོའི་ལག་ཤེས་སྤྱི་དང་ཁྱད་པར་བླུག་གཏོང་བའི་ལག་རྩལ་ལ་མཆོག་ཏུ་མཁས་པ་ཞིག་བཞུགས་པས།",
    "བླུག་པར་ཞལ་འབྱེད་པའི་ཚེ།",
    "ཡུལ་མི་ཀུན་ཡ་མཚན་ཞིང་གུང་རུ་མཁའ་འགྲོ་མའི་ཡང་སྲིད་ཡིན་པར་ཡིད་ཆེས་ཏེ་སྐྱེ་འགྲོ་ཀུན་འདུད་པར་གྱུར།",
    "ཀུན་མཁྱེན་བར་མའི་ཞབས་རྡུལ་སྤྱི་བོར་བླངས་ཏེ་མི་སོགས་སྨིན་གྲོལ་གྱི་གདམས་པ་གསན།",
    "ཙོང་སོགས་གཏན་ནས་མི་བཞེས་ལ།",
    "སོ་ཐར་གྱི་སྡོམ་པ་ལྷུར་ལེན་སྒོས་སྨྱུང་གནས་སྟོང་དང་མ་ཎི་དུང་ཕྱུར་དུ་མ་བསགས་པར་མཛད་དོ།",
    "ཧན་སྟག་ལུང་དགོན་སོགས་སུ་ཕེབས་ནས་མཆོད་འབུལ་དང་བསྟན་པའི་ཞབས་ཏོག་རྒྱས་པ་མཛད།",
    "གསུང་སྐྱེས་ཀྱི་སློབ་བུ་བྲག་དཀར་བ་འཇིགས་མེད་རབ་གསལ་སོགས་མང་དུ་བསྐྱངས་མཐར་དགུང་ལོ་ཞེ་བཞི་བཞེས་པའི་ཤིང་ཁྱི་ལོར་སྐུ་གཤེགས།",
    "དགུང་ལོ་བདུན་པར་མཁའ་སྤྱོད་བདེ་སྟོང་ཨེ་ཝཾ་དགའ་འཁྱིལ་དུ་གདན་སར་མངའ་གསོལ།",
    "༣ཀུན་མཁྱེན་འཇམ་དབྱངས་བཞད་པའི་རྟེན་བཞེངས་དང་བཟོའི་བསྟན་བཅོས་སོགས།",
    "བཅུ་གསུམ་པར་དགེ་ཚུལ་གྱི་སྡོམ་པ་བཞེས།",
    "དགུང་ལོ་ཉེར་དགུ་པར་དཔལ་ལྡན་རྒྱུད་སྨད་གྲ་ཚང་དུ་བཞུགས་ཏེ་སྔགས་ལ་སྦྱངས་པས་རྒྱུད་དོན་མ་ལུས་ཐུགས་སུ་ཆུད་ཅིང་།",
    "དགུང་ལོ་དོན་གཅིག་པར་ཡུལ་གཏེར་ལུང་ནས།",
    "དོན་གསུམ་པར་གོང་མ་ཁང་ཤིན་རྒྱལ་པོས་བསྟན་པ་འཛིན་ཅིང་སྐྱོང་པར་བྱེད་པའི་པཎྜི་ཏ་ཨེརྟི་ནི་ནོ་མིན་ཧང་ཞེས་པའི་ཆོ་ལོ་དང་གསེར་ཐམ་གསེར་ཡིག་སོགས་གནང་བ་འབྱོར།",
    "དེ་ནས་ས་སྐྱོང་འཕྲིན་ལས་རྒྱ་མཚོ་སོགས་ལས་བྲིས་དང་རྩིས་དཀར་ནག་སྒྲ་སོགས་གསན་བཞེས་ཀྱི་དབུ་ཚུགས།",
    "དགུང་ལོ་ཞེ་གསུམ་པར་ལྕགས་རི་རིག་བྱེད་འགྲོ་ཕན་གླིང་ཞེས་པ་གསར་འཛུགས་གནང་ཞིང་།",
    "འཇམ་དབྱངས་ཚངས་པ་ལྷའི་མེ་ཏོག་ལྷ་སྲས་མུ་ནི་བཙན་པོ།",
    "དུས་རབས་བཅུ་བདུན་པར་གཙང་སྟོད་དུ་སྐུ་འཁྲུངས།",
    "དེའི་བྲིས་རྒྱུན་གཙང་ཕྱོགས་སུ་དར་ཁྱབ་ཆེ་བས་གཙང་བྲིས་དང་།",
    "བོད་གངས་ཅན་གྱི་ལྗོངས་ཡོངས་ནས་ལྷ་བཟོ་བ་མཁས་ཅན་ཉིས་བརྒྱ་ལྔ་བཅུ་ང་བདུན་བཀུག་པའི་དབུ་ཆེན་དུ་ལྷོ་བྲག་ནས་ལྷ་སར་གདན་དྲངས།",
    "སྣར་ཐང་ཆིམས་ནམ་མཁའ་གྲགས་ཀྱི་འཕགས་པའི་གནས་བརྟན་བཅུ་དྲུག་གདུགས་ཚོད་དུ་སྤྱན་དྲངས་པའི་ལུགས་ཀྱི་གནས་བཅུའི་བྲིས་ཐང་བཅས་ལ་དཔེ་བླངས་ནས་ཐང་སྐུ་ཁྱད་པར་ཅན་མང་དུ་བྲིས།",
    "རྗེ་འདི་ཉིད་བཟོ་རྩལ་ཕུལ་དུ་བྱུང་བ་ཙམ་དུ་མ་ཟད་ཐིག་རྩ་དང་བཅས་པའི་བཟོའི་བསྟན་བཅོས་ལའང་མཆོག་ཏུ་མཁས་པས་ཁོང་ཡབ་སྲས་ཀྱིས་ཐིག་ཡིག་རྣམ་འགྲེལ་ཉི་མའི་འོད་ཟེར་ཞེས་པ་དེའང་རྩོམ་གནང་མཛད།",
    "ཀར་ཕྱོགས་ལ་ཐུགས་རྒྱུས་ལྷག་པར་མངའ་བའི་ཕྱིར་ཁུངས་ཆེ་བར་སྙམ་པས་སོ།",
    "དགུང་ལོ་ལྔ་བཞེས་པའི་དུས་སུ་ཡི་གེ་ཚེགས་མེད་དུ་མཁྱེན།",
    "སི་ཏུ་པཎ་ཆེན་ཉིད་བལ་ཡུལ་བརྒྱུད་རྒྱ་གར་དུ་ཕེབས་པའི་ལམ་བར་ལི་ཐའི་འགོར་ཡུམ་བུ་རྒྱལ་པོ་བསུ་བ་འབྱོར་ཏེ་ཀ་ཤིའི་པཎྜི་ཏ་ཛ་ལ་མངྒ་གཉིས་དང་མཇལ་འཕྲད་མཛད།",
    "དུར་སེང་དང་སྒྲ་ཡི་རྒྱ་མཚོ་ཟེར་བའི་སུ་པྲ་མཐའ་རྒྱས་པ་དེ་བློ་ནས་གསུངས་པས།",
    "ས་ག་ཟླ་བར་ཞུ་དག་གྲུབ་ནས་དཔལ་སྤུངས་སུ་ཕེབས།",
    "ཀརྨ་པ་ཞྭ་དམར་ནག་གཉིས་རྒྱ་ནག་ཏུ་ཕེབས་ཁར་དང་འཕྲད་དེ།",
    "ཞྭ་དམར་ནག་གཉིས་རྒྱ་ནག་ཏུ་ཕེབས་པའི་ལམ་བར་འདས་པ་ལ་དགོངས་རྫོགས་དང་།",
    "དེའི་ལམ་བར་རྒྱ་ནག་ཏུ་ཕེབས།",
    "ཡང་ན་དེ་དག་ལ་གཞིར་བྱས་ནས་གསར་རྩོམ་མཛད་པ་དང་།",
    "འཕགས་ཡུལ་མངོན་སུམ་མཐོང་བཞིན་བྱས།",
    "ཉམས་འགྱུར་འབུམ་གྱིས་ཁྱད་པར་བྱས།",
    "ལྷ་སྐུ་རྣམས་ཀྱི་སྤྱན་དང་ཞལ་ཆུང་བ།",
    "མངོན་བརྗོད་འཆི་མེད་མཛོད་བཅས་གསར་དུ་བསྒྱུར་བའམ་འགྱུར་བཅོས་མཛད་པ་སོགས་པོ་ཏི་བཅུ་གསུམ་གྱི་གྲངས་བཞུགས་ཤིང་།",
    "བྱང་གནམ་མཚོར་ལོ་འགའ་བཞུགས།",
    "༣༨ཀོང་སྤྲུལ་ཡོན་ཏན་རྒྱ་མཚོས་བོད་བཟོའི་རིག་གཞུང་བང་མཛོད་རྒྱས་པར་མཛད་ཚུལ།",
    "གཞན་དྲིང་མི་འཇོག་པའི་མཁྱེན་པ་ནམ་མཁའི་ཀློང་ལྟ་བུ་གྱུར་པས་སརྦ་ཛྙཱ་ན་མ་ཧཱ་པཎྜི་ཏ་ཞེས་མཚན་སྙན་གྲགས་པ་དོན་ལྡན་གྱི་གོ་འཕང་མཐོན་པོ་བརྙེས།",
    "ཕྱག་ལེན་ཞིབ་ཕྲ་དང་བཅས་ཐུགས་ཀྱི་བུམ་པར་བསྐྱིལ་ནས།",
    "སྤྱིར་རིག་པ་འདི་ཕྱི་གླིང་པའི་བཟོའི་རིག་པའི་ཁོངས་སུ་གཏོགས་ཀྱང་གོང་སྨྲས་ཀྱི་རིག་པ་ནི་དེ་ལྟར་མིན་པར་སེམས་སོ།",
    "བཅུ་ཙམ་ནས་འབྲི་ཀློག་ལ་ཐོགས་པ་མེད་ཅིང་ལྗགས་རྩོམ་ཀྱང་ཅི་རིགས་གནང་།",
    "དབུས་དང་ལྷོ་བྲག་སོགས་སུ་ཕེབས་ཁར་ཐ་མལ་གྱི་སྣང་བ་འགྱུར་ནས་གང་སྣང་བདེ་སྟོང་དུ་ཤར་ནས་བདེ་དྲོད་ཀྱི་ཉམས་འབར།",
    "མཁྱེན་རབ་ཀློང་ནས་བརྡོལ་ཏེ་ཟབ་དོན་མཐའ་དག་དགོངས་གཏེར་བསྟན་བཅོས་ཀྱི་ཚུལ་དུ་བཀོད་པར་མཛད་ཚུལ་ནི།",
    "ལྷའི་སྐུ་གཟུགས་ཐམས་ཅད་ཡང་དག་གཞུང་ལས་ཇི་ལྟར་གསུངས་པའི་ལུགས་དང་ཆ་ཚད་ལ་ཡོངས་སུ་མཐུན་པར་བྲིས་ཀྱང་།",
    "རུས་ཚུགས་དང་ཤ་ཚུགས་བཟང་ཞིང་གཞན་གྱིས་བསྒྲུབ་པར་དཀའ་བའི་ཉམས་འགྱུར་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པ།",
    "ཚོན་མདངས་བཅད་རིས་ཐམས་ཅད་ཤིན་ཏུ་ལེགས་པས་རྒྱང་ཐག་རིང་ཐུང་གང་ནས་བལྟས་ཀྱང་མཛེས་ཆ་ཆེ་བ་བཅས་ཏེ་དེའང་ཐིག་དངོས་སུ་འདེབས་མིན་གྱི་ཁྱད་པར་ཙམ་དང་།",
    "བྲིས་རྒྱུན་འདི་ཁམས་ནས་བྱུང་ཞིང་ཁམས་ཕྱོགས་སུ་དར་ཁྱབ་ཆེ་བས་ཁམས་རིས་ཞེས་པའི་ཐ་སྙད་ཀྱང་འདོགས་པར་བྱེད་དོ།",
    "སྐུ་གཟུགས་བཞེངས་སྐབས་ལྷ་ཐིག་དངོས་སུ་འདེབས་མིན་ལ་ཐུག་ཅིང་རྙིང་ལུགས་ཀྱིས་ལྷ་གང་བྲིས་པ་ཐམས་ཅད་ལ་ཐོག་མར་ཐིག་ལེགས་པར་དྲངས་ཤིང་།",
    "ལྷ་བཟོ་བྲིས་འབུར་གཉིས་ཀྱི་སྲས་རྒྱུན་ད་ལྟའི་བར་དུ་མཁས་པའི་ཟམ་མ་ཆད་པར་བྱོན་པ་ཡིན་ནོ།",
    "དགུང་ལོ་ཉེར་ལྔ་པར་དབྱིན་ཇིས་གདན་འདྲེན་ཞུས་པ་ལྟར་རྒྱ་གར་དུ་ཕེབས་ཏེ།",
    "དགུང་ལོ་ཞེ་གཅིག་པར་བྱང་ཐང་བརྒྱུད་པེ་ཅིང་དུ་ཕེབས་པར་ཀྲུང་ཧྭ་མིན་གོའི་ཞི་དྲག་དཔོན་རིགས་ཐམས་ཅད་ཀྱིས་འཇམ་དབྱངས་གོང་མ་མཆོད་ཡོན་གྱི་མཛད་སྲོལ་ལྟར་སྣེ་ལེན་དང་བཀུར་བསྟི་རྒྱ་ཆེན་པོ་ཐོབ།",
    "ལམ་སྒྲོན་འགྲེལ་པ་སོགས་པོད་བཞི་ཙམ་བཞུགས།",
    "ཁྱད་པར་ཐིག་ཚད་ལ་མཆོག་ཏུ་མཁས་པའི་ལྷ་བཟོ་ཀར་འབྲུག་ཅེས་གྲགས་པ་དེའི་མདུན་ས་ནས་ཡང་སྐྱར་སྐུ་གཟུགས་ཀྱི་ཐིག་རྩ་ཐམས་ཅད་སོ་སོར་མ་འདྲེས་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཐུགས་སུ་ཆུད་པར་སྦྱངས་ནས།",
    "ལུང་རིག་མན་ངག་གསུམ་གྱིས་སྨིན་པར་མཛད་དེ།",
    "རིག་གཞུང་ལག་ལེན་དང་བཅས་རང་རྐྱ་ཐུབ་པའི་སློབ་བུ་ས་སྟེང་ཀུན་ཏུ་ཁྱབ་པར་སྤེལ་བས།",
    "ཁྱད་པར་ཅན་གྱི་ལྡེབས་བྲིས་འགའ་བཅས་ངོ་སྤྲོད་བྱེད་པ་ལ།",
    "ཆུ་ཚོན་གྱིས་མདངས་རྒྱུག་པའི་ཤེས་བྱ་ལས་འཆད་འགྱུར་ལྟར་བྱས་པའི་སྟེང་བཀྲག་རྩི་བྱུག་ནས་གྲུབ་པ་དང་།",
    "ཐམས་ཅད་མཁྱེན་པ་བུ་སྟོན་རིན་ཆེན་གྲུབ་སོགས་མཁས་གྲུབ་དུ་མའི་བཀའ་དྲིན་ལ་བརྟེན་ནས་བོད་གངས་ཅན་གྱི་ལྗོངས་གཙོ་བོར་གྱུར་པའི་ཡུལ་གྲུ་དུ་མར་གཙུག་ལག་ཁང་བགྲང་ལས་འདས་པ་ཞིག་བཞེངས་ཤིང་།",
    "གཞན་ཡང་གོང་སྨྲས་ཀྱི་བཙན་པོ་ཁྲི་གཙུག་ལྡེ་བཙན་ནས་རིམ་པར་ལི་ཡུལ་གྱི་ཏུན་ཧོང་ཕྱེ་རྩེ་མཁར་གྱི་བྲག་ཕུག་དང་།",
    "དུས་ནམ་དང་ཚུལ་ཇི་ལྟ་བུས་བོད་དུ་ཐང་ཀ་བཟོ་སྲོལ་དར་བར་རགས་ཙམ་དཔྱད་པར་བྱ་བ་ལ།",
    "གཞི་སྟོང་པ་གཙང་ཞིང་ཁོད་སྙོམས་པའི་སྟེང་གཟུགས་བརྙན་སྣ་ཚོགས་འཆར་པ་ཞེས་འགྲེལ་པ་དང་།",
    "དེའི་སྟེང་དུ་གསེར་བཟང་པོས་བཅད་ལེགས་པར་དྲངས་ནས་གྲུབ་པ་སྟེ།",
    "མཚལ་ཐང་ལས་ལྡོག་སྟེ་རས་གཞིའི་སྟེང་དུ་གསེར་ལེགས་པར་བྱུག་པའི་སྟེང་།",
    "རྒྱུ་གསེར་དང་མཚལ་ལེགས་གཙང་སྤང་གཙང་མཐིང་ལ་སོགས།",
    "ལེགས་པར་བརྒྱང་བའི་རས་གཞིའི་སྟེང་དུ་མི་ཡོ་བའི་ཐབས་སུ་ཐིག་གདབ།",
    "བཅད་ཀྱི་ཚབ་ཏུ་སྟོང་སྐུད་དང་གསེར་སྐུད་སོགས་ཀྱིས་ཚོན་གྱི་ཟུར་ནོན་པར་དྲུབ།",
    "རིན་ཐང་གཞལ་དུ་མེད་པའི་བཟོ་རིག་པའི་དངོས་པོ་མང་པོ་བཞུགས་ཏེ།",
    "དཔེར་ན་ལྷ་ལྡན་སྤྲུལ་པའི་གཙུག་ལག་ཁང་དུ་བཞུགས་པའི་ཐང་སྐུའི་རྟེན་གཙོ་རྒྱལ་པོ་སྲོང་བཙན་ཡབ་ཡུམ་ཀྱི་ཐང་རྙིང་མེ་ཐུབ་མ་དང་།",
    "དྭགས་ལྷ་སྒམ་པོའི་རྗེ་བཙུན་ཙོང་ཁ་པའི་ཐུགས་དམ་གྱི་རྟེན་བྲིས་ཐང་ཐུབ་པ་གསོ་སྦྱོང་མ་དང་།",
    "དྭགས་ལྷ་སྒམ་པོའི་སྒམ་བདེ་རྩེའི་གཟིམ་ཆུང་དུ་བཞུགས་པའི་སྒྲ་སྒྱུར་མར་པའི་ཕྱག་བྲིས་ནཱ་རོའི་སྐུ་ཐང་དང་།",
    "སྐུ་འབུམ་དུ་བཟོ་རྒྱལ་བི་ཤྭ་ཀརྨའི་རྣམ་འཕྲུལ་དུ་བསྔགས་པ་ཆེ་ཤེས་བློ་བཟང་བཤེས་གཉེན་གྱི་ཕྱག་བྲིས་ཐང་ཀ་ཁག་སོགས་བགྲངས་ཀྱིས་མི་ལང་པ་བཞུགས་པ་ལས་དཔེ་བརྗོད་ཀྱི་ཚུལ་དུ་འགའ་ཞིག་བཀོད་པ་ལས།",
    "གངས་ཅན་ཡོངས་ཀྱི་ཐང་སྐུ་ནི་དེ་བས་ཀྱང་བརྗོད་པར་མི་ནུས་སོ།",
    "རྒྱ་ནག་བཀྲ་ཤིས་ཁྲི་སྒོར་ཡུན་བཞུགས་མཛད་ནས།",
    "དེ་ནས་རིམ་བཞིན་འཕེལ་རྒྱས་བྱུང་བར་གསུངས་པ་ནི།",
    "དེའང་ཤིན་ཏུ་བདེན་པར་མཐོང་སྟེ།",
    "དྭགས་ལྷ་སྒམ་པོའི་སྒམ་བདེ་རྩེའི་གཟིམ་ཁང་དུ་བཞུགས་སུ་གསོལ་བའི་མཉམ་མེད་ཇོ་བོ་རྗེའི་ཕྱག་བཟོ་ཐུགས་རྗེ་ཆེན་པོ་གཙོ་འཁོར།",
    "བཞི་རྣམས་ལས་གནོད་སྦྱིན་གྱི་བཟོ་བོས་བླུགས་ཏེ་རིམ་པར་རྣམ་སྣང་།",
    "བསམ་ཡས་སུ་གསེར་གར་ལུགས་ཀྱི་སྐུ་བརྙན་གང་དང་གང་བཞུགས་ཚུལ་གསལ་པོ་མ་འཁོད་ཀྱང་།",
    "དེ་འཕྲོས་འཆི་མེད་ལྷ་ཁང་དུ་བསྒྲིགས་ཅེས་བཀྲ་ལྷུན་གྱི་བྱུང་བ་ཞེས་པར་གསལ་བ་དང་།",
    "ད་ལྟའང་ཆ་ཤས་ཙམ་ཡང་མ་ཉམས་པར་སྐྱེ་བོ་ཀུན་གྱི་འདྲེན་བྱེད་ཀྱི་ཡུལ་དུ་གྱུར་ལ།",
    "སྒྲོལ་དཀར་སོགས་བཞུགས་ཚུལ་དང་ཐང་རྒྱལ་གྱི་ར་ས་འཕྲུལ་སྣང་དུ་དངུལ་ལས་གྲུབ་པའི་ཕྱག་རྡོར་གྱི་སྐུ།",
    "བྱ་ཁྱུང་དགོན་དུ་དངུལ་གྱི་རྒྱ་ཕིབས་ཉིས་རིམ་གསེར་གྱི་གཉྫ་ར་སོགས་ཀྱིས་མཛེས་པར་སྤྲས་པ།",
    "བོད་དུ་ཟངས་དང་ཟངས་གསེར་གྱི་ལག་རྩལ་དར་སྔ་ཞིང་དར་ཁྱབ་ལྷག་པར་ཆེ་བ་ཤེས་ཐུབ།",
    "ནུབ་ཏུ་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་བློས་བསླང་སོགས་དཀྱིལ་འཁོར་ལས་ཞིབ་ཏུ་འཆད་པར་འགྱུར་བ་ལྟར་དང་།",
    "བོད་ཀྱི་ལི་མ་སོགས་ཀྱི་སྐུ་བརྙན་མཐའ་ཡས་པ་ཞིག་བཞུགས་པ་ལས།",
    "འབྲོ་ཡུལ་ཐག་རིང་བས་གསོ་མི་མི་འོང་ཞེས་མཆི་ནས་སྐུ་ཐམས་ཅད་ལུགས་མ་བྱས་ཞེས་འཁོད་པ་དང་།",
