    "ཕན་བདེའི་སྡོང་བུ་ལོ་མ་མེ་ཏོག་གིས།",
    "ནང་གི་རྟོགས་པ་ཕལ་བའི་སྤྱོད་ཡུལ་མིན།",
    "སྤངས་རྟོགས་གྲུབ་པ་མཆོག་གི་དཔལ་ལས་ཏེ།",
    "འཁྲུལ་བྲལ་ཡེ་ཤེས་གཟིགས་པ་མི་དམན་པས།",
    "ཡེ་རྫོགས་རང་གི་རིག་པ་འོད་གསལ་བ།",
    "ཕྱག་རྫོགས་ཇོ་མོ་ནང་པའི་ལྟ་སྒོམ་ལ།",
    "མཐའ་བཞིའི་སྤྲོས་བྲལ་ཟབ་མོའི་གནས་ལུགས་འདི།",
    "ངོ་ཚ་ཁྲེལ་འདས་སོར་མོའི་རྩེར་ཐོགས་ནས།",
    "འཛམ་གླིང་འཛིན་མའི་ཁྱོན་ལ་འགྲེམ་པ་ཡིན།",
    "སྙན་པའི་གསུང་གིས་ཉམ་ཐག་དབུགས་དབྱུང་འཚལ།",
    "བཀའ་བརྒྱུད་སྐྱེས་མཆོག་བྱེ་བའི་གཙུག་གི་རྒྱན།",
    "ཐུགས་བསྐྱེད་ཕྱོགས་ཀྱི་བུ་མོའི་འགྲམ་པ་ལ།",
    "བློ་བཟང་ཉིན་མོར་བྱེད་པའི་སྣང་བ་ལ།",
    "གཞན་ངོར་བྲིས་པའི་རི་མོ་གཞན་སྣང་ཡང་།",
