    "འདི་དག་བདག་གི་འདོད་པར་བྱ་བ་ཡིན།",
    "ཡིད་འཕྲོག་རྡོ་རྗེའི་ལང་ཚོ་འབར་གྱུར་ཅིག།",
    "ཅེས་ཀུན་ཏུ་ཤིས་པའི་དྲང་སྲོང་གི་བདེན་ཚིག་རེ་སྐོང་ནོར་བུའི་འཕྲུལ་འཁོར་ཞེས་བྱ་བ་འདི་ནི།",
    "ཕྱི་ནང་གི་གཞུང་ལུགས་རྒྱ་མཚོ་ལྟ་བུའི་ཚུལ་ལ་མཐོང་ཐོས་ཀྱི་སྤོབས་པ་ཅུང་ཟད་ཐོབ་པ།",
    "ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པ།",
    "གཅིག་གིས་གཅིག་ཟ།",
    "གང་གིས་གང་ཐུབ།",
    "དུད་འགྲོའི་སྤྱོད་པ་ངོ་ཚ་དང་བྲལ་བས་སའི་སྟེང་ལ་སྡུག་བསྔལ་གྱི་ཁྲག་ཆར་འབེབས་པར་རྩོམ་པ་འདི་དག་བདག་ཅག་གི་ཀུན་མཁྱེན་གོའུ་ཏམ་སྨྲ་བའི་སེང་གེས།",
    "བཙན་ལུགས་ཀྱི་སྤྱི་བོའི་ཅོད་པན་ཨ་མི་རི་ཀ་སྔོན་ཆད་འཛིན་མའི་ཁྱོན་ན་ངའོ་སྙམ་པའི་ཁེངས་རློམ་ལྷུན་པོའི་གོང་བ་ལས་ཀྱང་བརྒལ་བ་དེ་ཉིད།",
    "ད་ནི་དམག་གི་དཔུང་ཤི་བ་དང་།",
    "སྤུན་ཟླ་མི་མང་གི་དོན་དུ་འཆི་བ་ལ་ངང་བ་པད་མཚོར་འཇུག་པ་ལྟ་བུའི་དགའ་སྤྲོ་ཅན།",
    "རང་རེས་གཡུལ་ལས་རྒྱལ་བའི་བ་དན་མྱུར་བར་སྒྲེང་རྒྱུར་ཐེ་ཚོམ་དོགས་པ་མི་དགོས་པས་བློ་བདེ་ཞི་འཇམ་ཆེན་པོའི་ཀློང་ནས་ཆབ་སྲིད།",
    "བདག་གིས་བརྟགས་ནའང་འཕགས་པའི་གསུང་གི་ཟིལ་མ་དམིགས་པ་ཙམ་དུ་མ་ཟད་ཀྱི།",
    "རང་གི་བསྟན་པའི་སྲོག་གཤེད་དུ་འགྱུར་ཉེན་ཆེ་བས་ཆང་ལན་ཆུ་འཇལ་འདི་འདྲ་ག་ལ་འཐད།",
    "། ལུང་བསྟན་རྫུན་མ་སུན་འབྱིན་རྨོངས་པའི་མུན་སེལ་ཤེས་རབ་ཉི་མའི་འོད་ཟེར། ། བླུན་སྐྱོན་སྤྱན་རས་གཟིགས་ལ་བསྒོ་འདོད་པའི།",
    "ལུང་བསྟན་རྫུན་ནག་ཆང་གི་ཁུ་བ་ཅན།",
    "ལུང་བསྟན་འདིའི་མེ་ཕག་རབ་བྱུང་བཅོ་ལྔ་པའི་ཡིན་ན་འདས་ལོ་རེ་ལྔ་དང་ད་ལོ་རེ་དྲུག་པ།",
    "བདག་ལྟ་བུ་མངོན་ཤེས་ཀྱིས་དབུལ་བས་འདིའི་རེད་ཅེས་ཁ་ཚོན་གཅོད་པའི་འོས་མ་མཆིས་མོད།",
    "དེའི་ནང་ན་འགྲིག་པའི་ཚིག་འགའ་རེ་ལོས་ཡོད།",
    "རང་དགར་གྲགས་འདོད་དང་རྙེད་བཀུར་ལ་ཆགས་པས་སྒྲོ་སྐུར་རྫུན་གླེང་གིས་ཆུ་སྣ་གར་ཁྲིད་ཀྱི་བླུན་པོ་ཅེ་རེ་ལོང་པ་ཕལ་མོ་ཆེ་མཆོག་གི་དོན་ལས་ཉམས་པར་བགྱིད་པ་ནི།",
    "རྒྱལ་བའི་བསྟན་པ་དང་རང་གི་བདེ་སྐྱིད་རང་གིས་མ་བཤིག་ན་གུང་ཁྲན་ཏང་ནས་མི་བཤིག་པར་ཐག་གིས་ཆོད།",
    "མོ་ཀྲུའུ་ཞི་ལ་དད་འདུན་ཆེན་པོའི་མིག་གིས་བལྟ་བ་ཟབ།",
    "ཤི་བའང་མིག་གིས་མཐོང་ཟེར།",
    "ཁྱད་པར་བོད་ཁ་བ་ཅན་གྱི་ལྷ་སྐལ་འཕགས་མཆོག་སྤྱན་རས་གཟིགས་ཀྱི་བྱིན་མཐུ་ཡིན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགོངས་པ་བཞི་དང་ལྡེམ་དགོངས་བཞི་གསུངས་པའི་ནང་ཚན་དུས་དང་བསམ་པ་ལ་དགོངས་པའི་རྣམ་གཞག་མཁས་རྣམས་ཀྱི་ཐུགས་ངོར་ལྷང་ངེར་གསལ་བ་དེ་ལགས་མོད།",
    "སྟོད་དབུས་གཙང་གི་མིའི་ཕྱེད་ཆ་ཡིན།",
    "དང་པོ་གཉིས་གང་ཡིན་ཡང་ཧ་ཅང་ཐལ་བ་རྟོགས་སླ་ལ།",
    "ཁ་བ་ཅན་གྱི་འདྲེན་མཆོག་སྤྱན་རས་གཟིགས།",
    "རིམ་དང་གཅིག་ཅར་ཇི་ལྟར་ཤི་རིམ་གྱིས་ཤི་ན་ལུང་བསྟན་འདི་མ་བྱུང་བའི་སྔོན་རོལ་རིང་མོ་ཞིག་ནས་འཆི་དགོས་ལ།",
    "གཅིག་ཅར་ཡིན་ན་དེ་ལས་ཀྱང་མི་འཐད་པ་སོགས་ཅི་བྱས་གྲ་མི་འགྲིག་གི་བླུན་གཏམ་འདི་ཡ་མཚན་རེད།",
    "སྒྲ་སྙན་པོ་བཏང་བྱུང་ཞེས་པ་འདི་སོག་པོ་བོད་སྐད་ཇི་བཞིན་མི་འབྱོར་པ་ཞིག་གིས་བོད་སྐད་སྨྲས་པའི་རྫོབ་རྟགས་རྔམས་འཐུག་པ་ཞིག་ཡིན་པར་ཉམས་མྱོང་ཅན་གྱིས་འཁུམས།",
    "མ་བརྗེད་ལན་དུ་སྐྱོལ་ཞེས་སྐད་ཆའང་རྫིག་ལ་ནན་ཏན་ཡང་ཆེ་མོད།",
    "འདི་ལ་དོན་སྐྱོན་དང་རྩོམ་སྐྱོན་ཅི་ཡོད་རྣམ་དཔྱོད་ཅན་གྱིས་མཐོང་མ་ཐག་ཏུ་ཤེས་མོད།",
    "བཅོས་བསླད་བྱེད་པའི་མི་རྣམས་ཁྲག་སྐྱུག་གིས་འཆི་བའི་འཇིགས་བསྐུལ་ཡོད་གཤིས་དེའི་ཕྱོགས་སུ་ལྕེ་རྐྱོང་བ་ལ་དཔའ་ཞུམ་པ་ཡིན་མཆི་ན་ཡང་དཔར་ཐུང་ཤོག་གྲངས་ལྔ་ཙམ་ལ་ཡི་གེ་མ་དག་པ་བཞི་བཅུ་ཙམ་འདུག་པ་ཞུ་དག་པས་ངེས་པར་འདོར་དགོས་སྟབས་ཡོན་ཏན་ཅན་གྱི་མཁས་པ་ཚོས་མ་གཟིགས་པ་འདྲ།",
    "རྣལ་འབྱོར་མ་བུ་ཡི་རི་ལེན་མོ།",
    "བཀའ་བསྟན་པོ་ཏི་སུམ་བརྒྱ་ལྷག་གི་ཉིང་ཁུ།",
    "མ་ཎི་ཡིག་བརྒྱ་སོགས་ཚོགས་གསོག་སྒྲིབ་སྦྱོང་གི་རྣམ་པར་དཀར་བ་ནི།",
    "སོ་སོའི་དད་པའི་གསང་བ་ཡི་རང་གི་གནས་ལགས་ཏེ།",
    "གཞན་དང་མི་མཉམ་དལ་བ་མཆོག་གི་ལུས།",
    "དམ་པའི་གཟིགས་ངོར་མཁས་དང་མི་མཁས་ནི།",
    "མིག་རྣའི་སྣང་བར་བློ་ཡི་སྲོག་སོང་བའི།",
    "མཚར་སྡུག་རི་མོ་རང་གིས་མཐོང་བཞིན་དུ།",
    "གཞན་ལ་དྲི་གཏུགས་སྟོང་གི་སྒོ་དབྱེ་བ།",
    "ཡིད་ལ་གདུང་བའི་རི་བོ་ཆེས་ལྕི་མོད།",
    "འཛམ་གླིང་ནོར་འཛིན་སྒེག་མོའི་མཛེས་རྒྱན་ཡིན།",
    "ཚིག་གི་གོ་བ་ནམ་མཁའི་མཐོངས་ལྟར་ཡངས།",
    "ཐུབ་བསྟན་མི་འགྱུར་སྲོག་གི་ཀ་བ་ཡིན།",
    "བདེན་གཉིས་བདེན་བཞིའི་ཆ་ཤས་རེ་རེ་ཡང་།",
    "ནང་གི་སྟོབས་ལ་ཤེས་བྱའི་ཁྱོན་ཀུན་བསྐྱིལ།",
    "རྩོད་སྐོར་གཅིག་གི་རིགས་པའི་སྣང་བས་ཀྱང་།",
    "མཁས་པའི་ཚིག་གི་ཟེགས་མ་རེ་རེས་ཀྱང་།",
    "དེ་ཡིས་ཇི་ལྟར་གདམས་པའི་ཐིག་གི་གཞིར།",
    "རྣམ་པ་དུ་མར་སྣང་མོད་དེ་ལྟ་ནའང་།",
    "འཇམ་དཔལ་དགྱེས་པའི་བློ་གྲོས་བདག་གིས་མཐོང་།",
    "མི་སྲུན་ཧ་ཅང་ཐལ་བ་མ་ལགས་ན།",
    "སྟོབས་ཀྱི་བསྡིགས་པས་ཡ་རབས་གཅིག་གི་ཡང་།",
    "ཉམ་ཐག་སྡུག་གི་བཙོན་དུ་ཚུད་པ་རྣམས།",
