    "ཀུན་བྱེད་ང་ཡི་ལུང་འདི་ངེས་པར་ཟུང་།",
    "འདོད་པ་མེད་པས་བདེ་བ་ལེན་པར་བྱེད།",
    "མེད་པ་རང་མལ་ལས་མ་གཡོས་པར་གདམས་པ་ནི།",
    "བྱར་མེད་བསམ་ཡུལ་འདས་པར་ཁྱབ་གདལ་ལ།",
    "དེ་ཕྱིར་ཅི་ཡང་མེད་པར་ནི།",
    "མཛད་དང་སྤྱོད་པར་མ་ཕྱེ་བས།",
    "སྒོམ་དང་མི་སྒོམ་ཐ་སྙད་རྣམ་པར་དག།",
    "རང་བཞིན་གྱིས་བསམ་གཏན་རྙེད་ནས་གོལ་སྒྲིབ་མེད་པར་འགག་བསྡམ་པ་ནི།",
    "མཚོན་དང་མི་མཚོན་མེད་པར་ཐག་ཆོད་དེ།",
    "རིག་པ་རང་མལ་ལས་མ་གཡོས་པར་མཐོང་ནས་དེའི་ངང་ལ་གནས་པའི་རྣལ་འབྱོར་པས་རང་བཞིན་གྱི་བསམ་གཏན་རྙེད་པའི་ཚེ།",
    "གནས་པས་ཏིང་ངེ་འཛིན་རྙེད་དེ་ཞི་ལྷག་ཟུང་དུ་འབྲེལ་བས་བྱིང་རྒོད་ལ་སོགས་པ་བསམ་གཏན་གྱི་གོལ་སྒྲིབ་སྤང་མ་དགོས་པར་རང་དག་གོ།",
    "མཚོན་དང་མ་མཚོན་མེད་པར་ཐག་བཅད་དེ།",
    "ཕྱི་སྣང་བ་ཐམས་ཅད་རིག་པའི་ཀློང་ན་སྐྱེ་འགག་གནས་པར་སྣང་ཡང་སྟོང་པའི་ངང་ལས་མ་གཡོས་པ།",
    "དེ་ག་ལ་བསྡད་པས་རང་ཡལ་རྗེས་མེད་དུ་གྲོལ་བ་ལ།",
    "ཡངས་པར་འགྱུར་འཇུག་པ་དང་།",
    "རྩལ་མ་རྫོགས་པར་བལྟས་པས་ཡལ་ན་དེ་བས་ཆེ་བའི་རྐྱེན་མི་ཐུབ།",
    "དེའང་རིག་པ་རང་ཤར་ལ་འདོད་བློ་བདེ་བདེ་བོ་མེད་པར་ཕྱལ་ཡས་རང་བབས་སུ་མ་ཡེངས་པ་ལ་མི་རྩོལ་བར་བཞག་སྟེ།",
    "རིག་པ་སྟོང་པ་ཟང་ཀ་ལས་མ་གཡོས་པར་རྟོགས་པའི་ཀློང་ལ་འདྲིས་པར་འགག་བསྡམས་ཏེ།",
    "རྒྱུ་འབྲས་ལས་འདས་པར་འགག་བསྡམ་པ་ནི།",
    "མ་བྱས་ལྷུན་གྱིས་གྲུབ་པའི་རིག་པ་ལས་༡།",
    "ཡེ་སྟོང་གདོད་ནས་དག་པར་བཅིང་བ་ནི།",
    "འདི་ནི་ངའི་སྣང་བ་དང་ཁྱད་པར་མེད་པར་ཡུལ་ཅན་དུ་མའི་ཀློང་གཅིག་ཏུ་འདྲིལ་བ་ཞེས་བྱ་བ།",
    "ཕྱོགས་ཐམས་ཅད་དུ་མཛད་པ་མང་པོའི་འཕྲིན་ལས་འགྲོ་བ་རྣམས་ལ་གཉིས་སུ་མེད་པར་བྱས་ནས།",
    "དེ་ནས་མི་སྣང་བའི་ནམ་མཁའ་དང་གཉིས་སུ་མེད་པར་གྱུར་ཏོ།",
    "དེའི་ཚེ་ང་ནི་བྱེད་པ་མེད་པར་རང་བྱུང་ནས།",
    "དྲང་དོན་གྱི་ལུང་ལ་བརྟེན་ནས་ཡོད་པར་སྟོན་ཅིང་འཛིན་པ་རྣམས་ནམ་ཡང་མི་ཐར་ལ།",
    "རང་བཞིན་རྫོགས་པ་ཆེན་པོར་རྒྱུ་འབྲས་དགེ་སྡིག་ལས་འདས་པར་རྟོགས་པར་བྱ་སྟེ།",
    "གདོད་ནས་བྱས་པ་མེད་པའི་སེམས་ཉིད་ལ།",
    "སེམས་ལ་ངེས་ལུང་གཏན་ལ་ཕེབས་པ་མེད།",
    "སྦྱང་བཅོས་བྱས་གྲུབ་ལུང་འདི་ངས་མ་བསྟན།",
    "ཡེ་ཤེས་ཡུལ་ལ་རྟོགས་པར་མ་བྱེད་ཅིག།",
    "ལས་མ་བྱས་པས་དེ་བཞིན་ཉིད་དུ་གནས།",
    "དེ་ཡིས་མ་ནོར་མ་བཅོས་གྲུབ་པར་འགྱུར།",
    "ཇི་བཞིན་བཅོས་པ་མེད་པར་མ་རྟོགས་ཏེ།",
    "རྒྱུ་འབྲས་བྱ་རྩོལ་མེད་པར་བཅིངས་པ་ནི།",
    "བྱས་ཟིན་རྩོལ་སྒྲུབ་འདས་པ་མ་རིག་ནས།",
    "ཡེ་ནས་བྱས་ཟིན་རྩོལ་བའི་སེམས་མི་འབྱུང་།",
    "ང་ཡིས་དོན་བྱས་གཞན་གྱིས་བྱ་མི་དགོས།",
    "ང་ལ་ཀུན་རྫོབ་ཡེ་ནས་བྱས་ཟིན་རྫོགས།",
    "ཡེ་ནས་བྱས་ཟིན་ལྟ་བ་སྒོམ་མི་དགོས།",
    "སྔ་ཕྱི་དུས་གསུམ་མེད་དེ་ཁྱད་པར་ན།",
    "དེ་ལྟར་མ་རིག་རྩོལ་སྒྲིབ་བྱས་གྱུར་ན།",
    "བྱས་པས་བསླུས་པར་བསྟན་པ་ནི།",
    "རིག་པའི་དོན་ལ་མ་རིག་པས་བསླུ་བ་ཉིད་དེ་ཚེ་རབས་སྔ་མ་ཡང་སྔར་བྱས་པ་ད་ལྟའི་འཁྲུལ་སྣང་སྣ་ཚོགས་སུ་སྣང་བས་མཚོན་ལ།",
    "སྔར་བྱས་ཟིན་པས་ད་ནི་བྱེད་མི་དགོས།",
    "མི་རྟོག་ཅིར་མི་དགོངས་ལ་མཉམ་པར་ཞོག།",
    "ཏིང་འཛིན་རྣམ་པར་རྟོག་པ་བསྒོམ་མ་མྱོང་།",
    "ད་ལྟ་བཞུགས་དང་སླད་ཀྱིས་བྱོན་པ་དང་༡།",
    "རྟོག་མེད་མཉམ་པ་ཉིད་ཀྱིས་གྲུབ་པར་འགྱུར།",
    "དང་པོར་མཐར་འཛིན་མེད་པར་ལ་བཟླ་བ་ནི།",
    "གང་སྣང་ཅི་ཤར་དུས་ཉིད་ནས་མཐའ་བཞི་རང་སངས་ཀྱི་དགོངས་པར་གནས་པ་ཉིད།",
    "གོལ་དང་སྒྲིབ་པར་འཛིན་པ་ག་ལ་ཡོད།",
    "དགེ་སྡིག་ལས་འབྲས་ལས་འདས་པར་ལ་བཟླ་བ་ནི།",
    "བཅོས་མེད་ལྟོས་དང་བྲལ་བའི་གཞི་མེད་པར།",
    "ཕྱོགས་མེད་རིས་སུ་མ་བཅད་སེམས་མེད་པར།",
    "ཡེ་གྲོལ་བྱ་བྲལ་སོར་བཞག་གདེང་མེད་པར།",
    "དཀར་ནག་སྤྲིན་ཚོགས་སྒྲིབ་པར་མཉམ་པ་ལྟར།",
    "དགེ་སྡིག་གཉིས་ཀ་རིག་པའི་སྒྲིབ་པར་མཉམ།",
    "རང་བཞིན་བཅུ་ཡིས་ང་ལ་རྩོལ་བྱས་ནས།",
    "ཟད་དང་མ་ཟད་མེད་པར་བཟླས་ཟིན་པས།",
    "མེད་མཚོན་བརྗོད་འདས་པར་ཁོ་ཐག་ཆོད།",
    "རྣལ་འབྱོར་པ་ཐམས་ཅད་དང་རྟོགས་པ་དབྱིངས་གཅིག་པས་ཕྱོགས་བྲལ་རྒྱ་གྲོལ་རང་ཡན་དུ་ཤར་བས་བློ་བདེ་དགའ་བ་ཆེན་པོར་རྒྱས་པར་ཞེས་བྱའོ།",
    "མི་འགྱུར་མི་ཕྱེད་འདུས་མ་བྱས་པའི་ཀློང་།",
    "མེད་པ་ཡོད་པར་འཛིན་པས་འཁྲུལ་བར་བཏགས།",
    "འཁྲུལ་དང་མ་འཁྲུལ་མེད་པར་ཐག་ཆོད་པས།",
    "སྐྱེ་དང་མ་སྐྱེས་མེད་པར་ཐག་ཆོད་པས།",
    "དག་དང་མ་དག་མེད་པར་ཐག་ཆོད་པས།",
    "བཟང་ངན་སྤང་ལེན་མེད་པར་ཕྱམ་འདས་༡",
    "བྱ་བྱེད་མེད་པས་ཕྱི་ཡུལ་དང་ནང་སེམས་ལས་འདས་པའོ་ཞེས་གསུངས་སོ།",
    "དགེ་སྡིག་རྒྱུ་འབྲས་མེད་པར་རྣམ་དག་པས།",
    "དམ་ཅན་རྒྱ་མཚོའི་ཚོགས་རྣམས་དགྱེས་པར་མཛོད།",
    "ཡུལ་སྣང་ཐམས་ཅད་སྟོང་པའི་རང་གཟུགས་རྡུལ་ཕྲན་དང་ཆ་ཤས་མེད་པས་ཕྱོགས་ཆ་དང་དངོས་པོ་མེད་པ་དུས་གསུམ་སྟོང་པར་དག་པས་ངོ་བོ་ཕྱལ་བ།",
    "ཡུལ་མེད་གཟུང་འཛིན་རྣམ་པར་དག།",
    "ལྟ་བ་སྒོམ་དུ་མེད་པར་བསྟན་པ་ཡིན།",
    "དམ་ཚིག་བསྲུང་དུ་མེད་པར་བསྟན་པ་ཡིན།",
    "འཕྲིན་ལས་བཙལ་དུ་མེད་པར་བསྟན་པ་ཡིན།",
    "ལམ་ལ་བགྲོད་དུ་མེད་པར་བསྟན་པ་ཡིན།",
    "གནས་ལ་སྦྱང་དུ་མེད་པར་བསྟན་པ་ཡིན།",
