    "དེ་ལྟར་ཡང་གི་ཆོ་གསྟེ་ལྔ་པའོ།",
    "ཁམ་ཐོང་ཞེས་པ་ནི་སྔོན་དུ་གསུངས་པའི་རེངས་པའི་འཁོར་ལོ་བྱ་བའོ།",
    "ཀླུརྣམས་ཀྱི་རངརང་གི་མིང་དང་ལྡན་པའི་ཕུ་ཞེས་པ་དང་སྤེལ་བ་དགོད་པའོ།",
    "རྐང་པའི་རྩེ་མོའི་ཕྱི་ཆས་མ་ནན་པ་དེའི་ཚེ་ཇི་སྐད་གསུངས་པ་བཞིན་བྱེད་དོ།",
    "འདིར་རང་གི་ཕྱག་རྒྱ་ཞེས་པ་ནི་ཀླུ་བརྒྱད་པོ་རྣམས་ཀྱི་ཀླུའི་བུ་མོ་བརྒྱད་གཞུག་པར་བྱའོ།",
    "སྐད་ཅིག་གིས་ནི་ཞེས་པ་ནི་དེ་བཞིན་དུ་སྔགས་ཀྱི་ཚིག་རྣམས་ལན་གཉིས་སུ་བཟླས་ཏེ་བརྗོད་པའོ།",
    "དེཡོངས་སུ་གྱུར་པ་ལས་བདག་ཉིད་སྒྲོལ་མའི་གཟུགས་སོ་བདུནསུ་སྐད་ཅིག་གིས་བསམ་པར་བྱའོ།",
    "དེ་བཞིན་དུ་རྒྱན་ཀུན་ཞེས་པཞི་དེ་ལྟར་བྱས་ནས་རྣལ་འབྱོང་པའི་ལང་ཚོ་གཞོན་པ་ཕུན་སུམ་ཚོགས་པ་སངས་རྒྱ་ས་ཀྱི་མཚ་ན་གྱིས་བརྒྱ་ན་པ་རྟག་ཏུ་གོམས་པའི་ཕྱིར།",
    "དེ་ཡང་སྟག་གི་ཞེས་བྱ་བ་ལ་སོགསཔ་ནི།",
    "གཏུམམོ་སྦར་བར་བྱའོ།",
    "དེ་དག་གི་ནབཟའ་ཞེས་པ་ནི་ག་ནས་དེང་དུས་ཐམས་ཅད་དུ་གནས་པའོ།",
    "གར་གི་ཕྱིར་ཤིན་ཏུ་ཆགས་པ་རྒྱུན་ཏུ་འབབ་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱིས་ན་གང་གི་རྨོངས་པ་འཆི་འགྱུར་བ།",
    "ལྷམོ་དེ་ནི་རྣམ་པར་སྤྲས།",
    "དེ་ལྟ་བུར་གྱུར་པ་འདབ་མ་བརྒྱད་པའི་དབུསསུལྷ་མོ་བཞིས་ཡོངས་སུ་བསྐོར་བའི་བཅོམ་ལྡན་འདས་བསྒོམས་པར་བྱའོ།",
    "དེ་ལསརེའུ་མིག་བཅུ་བདུནལ་ཡལ་སོགས་པ་ཡི་གེ་བཅུ་བདུན་དགོད་པར་འགྱུར་ཏེ།",
    "ནང་གི་འཁོར་ལོའི་ཤར་ལ་སོགས་པའི་གནས་བཞི་རུ།",
    "དེའི་ཕྱི་རོལ་ཏུ་རེ་མིག་བཅུ་དྲུག་བྱའོ།",
    "དེ་རྣམས་ལ་ཤར་ལ་སོགས་པའི་རེའུ་མིག་རེརེ་བར་དུ་ཨོཾ་ཧྲཱི་ཥྛ་ཞེས་བྱ་བ་ལ་སོགས་པཡི་གེ་རེ་རེ་བྲི་བར་བྱའོ།",
    "བུད་མེད་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "དེས་མནན་པ་ནི་སྟོང་པའི་སྟ་རེའོ།",
    "དེ་བཞིན་དུ་བསམ་གཏན་ཞེས་པའ་ཏིང་ངེ་འཛིན་གང་གིས་དངོས་པོ་གཡོ་བ་ཐམས་ཅད་འགོག་པའོ།",
    "གང་གི་ཕྱིར་བསམ་གྱིས་མི་ཁྱབ་པའི་ས་དེས་ན་བསམ་དུ་མེད་པའི་ཡེ་ཤེས་དེ་ཉིད་གཉིས་སུ་མེད་པ་བསམ་བུ་མེད་པའི་བསམ་དུ་མེད་པཞེས་པའི་དོན་ཏོ།",
    "དེས་ན་ཕྱི་རུ་དེའི་རང་བཞིན་ཉིད་གཟུགསབརྙན་བཞིན་སྣང་གི་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་ཕྱིའི་ལས་གྲུབ་པ་ནིམ་ཡིན་ནོ།",
    "དྲིལ་བུའི་སྟེང་གི་རྔོ་རྗེ་སྟེ།",
    "རྩེ་གཅིག་པ་ནས་དང་པོར་བརྩམས་ཏེ་ཇི་སྲིད་བྱེ་བའི་རྩེ་མོའི་བར་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ནས་ཀོ་སྐོ་ནས་མགྲིན་པའི་མཐར་ཐུག་པ་ནི་རྡོ་རྗེའི་འོག་གི་པདྨའོ།",
