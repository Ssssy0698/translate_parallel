    "པའོ་ འགྲོ་འོང་གི་ཐོབ་བྱར་མེད་པས་འགྲོ་བ་མེད་པའི་དང་།",
    "དེ་ལྔ་ནི་ཤེས་སྒྲིབ་རགས་པའི་གཉེན་པོ་སྒོམ་ལམ་མོ།",
    "མཉམ་ཉིད་ཡེ་ཤེས་ཀུན་ཞེས་ཉོན་མོངས་པའི་ཕྱི་དོན་མེད་པའམ།",
    "གཏི་མུག་མེད་པའི་རྣམ་པ་གསུམ་མོ།",
    "རབ་སྐྱེའི་རྣམ་པ་སྔ་ཕྱི་ཀུན་དུ་རྙོག་པའི་ཕྱིན་ཅི་ལོག་གི་ཀུན་རྟོག་སྤོང་བྱེད་ཉོན་མོངས་པ་མེད་པའི་རྣམ་པ་གཅིག་ཏྩོ།",
    "དེ་རིགས་པ་ཡིན་ཏེ་དམནཔ་ཉན་རང་གིས་ལ་མཆོག་ཏུ་འཛིན་པ་མེད་པའི་རྣམ་པ་ཅན་ཡིན་པས་ཤིན་ཏུ་རིགས་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་མི་ངམིགས་པ་ང་པཉིད་གསུམ།",
    "སངས་རྒྱུས་ཉིད་ཀྱི་རྣམ་པ་སྟེ་ཁྱོན་བསྡོམས་པས་སུམ་ཅུ་རྩྭ་དགུ་སྟེ།",
    "སྡུག་ཀུན་གྱི་དྲུག་གི་རྣམ་པ་ཅན་གྱི་སྨོན་པ་མེད་པ་སྟེ་ཏིང་ངེ་འཛིན་གསུམ།",
    "བསམ་གཏན་བཞི་དང་གཟུགས་མེད་བཞི་འགོག་པའི་སྙོམས་འཇུག་གིརྣམ་པ་བཅས་མཐར་གྱིས་གཞས་པའིསྙོམས་འཇུགདགུ།",
    "སྣུམ་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་དུང་།",
    "བསྣམ་པ་ཞག་དལྟཟླ་གྱི་དུས་ལ་མ་ཆགས་མ་ཐོགས་པའི་ཡེ་ཤེས་ཀྱི་གཟིགས་པ་འཇུག་པ་རྣམ་པ་གསུམ་སྟེ།",
    "གཞན་རྐྱེན་ལ་མ་ལྟོས་པར་རང་བྱུང་གི་ཡེ་ཤེས་མངོན་དུ་བརྙེས་པའང་བྱུང་གི་རྣམ་པ་དང་།",
    "ཉོན་མོངས་རྣམས་དྲུག་མ་དལ་ལྟར་སྤོང་བས་ཟག་པ་མེད་པ་ཡིན་ཏེ་མཉམ་བཞག་ཏུ་སྒོམ་བྱའི་རྣམ་པ་ཡིན་པའི་ཕྱིར།",
    "བྱད་སེམས་ཀྱི་ལམ་ཤེས་ཀྱི་རྣམ་པ་སོ་དྲུག་ནི་ཉོན་མོངས་རྣམས་མི་གཙང་བའི་ལུད་ཁུ་མཤིང་གི་ཞིང་དང་།",
    "ཕྱི་ཨ་ཕྱི་མར་རིམ་གྱིས་བཞག་ནས།",
    "རྫོགས་པའི་བྱང་ནུབ་དང་ཉེ་བའི་ཡོན་ཏན་འཐོབ་སྟེ་དོན་དེ་དག་གིས་དེ་བཞིན་གཤེགས་པ་དང་ཉེ་བའི་ཕྱིར་དང་།",
    "རྩེ་དགོད་སོགས་རིགས་པ་མ་ཡིན་པས་བསྐྱེད་པས་རག་གི་གཞས་ངན་ལེནཁ་ཏོན་བྱེད་པ་སོགས་དང་།",
    "འབྲས་བུ་གྱ་ནོམ་པ་ཤེར་ཕྱིན་གྱི་རོ་མྱོང་བ་ལས་ཉམས་པ་བཟང་མང་སྟེར་བའིཇོ་བོ་ལ་མཐོང་བ་ངན་ཞུར་སྟེར་བའི་བྲུན་ལ་རེ་བ་ཁྱི་ལྟ་བུ་དང་།",
    "རྣམ་རྒྱལ་ཁང་བཟང་གི་དཔེ་ལེནཔར་འདོད་པས་ཉི་ཟླའི་ཁང་ཚད་བྱས་པ་ལྟ་བུ་དང་།",
    "སྲོག་གི་བར་ཆད་དུ་འགྱུར་བའི་ཕྱོགས་དང་མི་འགྱུར་བའི་ཕྱོགས་སུ་འགྲོ་བར་འདོད་པས་དང་།",
    "པར་ཐམས་ཅད་པར་མཁྱེན་ལས་མཁྱེན་པ་ངེའི་ཐུན་མོང་མིན་པའི་ཡུལ་གཞས་དང་གུས་པར་བྱ་བ་སོགས་འབྲས་བུ་མི་སློབ་པའི་མཁྱེན་ཚུལ་སྟོན་ཅིང་།",
    "རང་གི་དོན་ལྡོག་ལྟ་བུ་ཡིན་པས་མཚན་ཉིད་ཀྱང་ཡིན་ཏེ་ལྟོ་ལྡིར་བ་ལས་བུམ་པར་མཚོན་པ་བཞི་ན་ནོ།",
    "འཇོག་བྱེད་ངེ་ནི་དབྱིབས་དང་ཁ་དོག་རེག་བྱ་སོགས་རྔོ་བོ་འམ།",
    "འཇིག་རྟོན་དེ་ཕུང་པོལྔ་ཐ་སྙད་དུ་མ་ནོར་ཐར་ཤེས་ཤིང་དོན་དམ་པར་རྒྱུན་དང་སྐད་ཅིག་གིས་འཇིག་པ་མེད་པའི་བདག་ཉིད་དུ་ཤེས་པ་དང་།",
    "སོགས་ཀྱི་སྒྲས་དྲི་མའི་བདག་ཉིད་ཆགས་སོགས་ཀུན་ནས་ཉོན་མོངས་པ་མེདཔང་ཤེས་པ་དང་།",
    "གཉེན་པོ་གཞི་ཤེས་ལའང་ཉན་ཟང་གི་དེ་ལས་འཕགས་པར་དོན་གྱིས་འཕང་ངོ།",
    "ཤེར་ཕྱི་ན་ཐབ་མོ་འདི་ཐོས་ནས་འབྲི་བ་དང་།",
    "ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའི་རིགས་ཀྱི་བུའམ་རིགས་གྱི་བུ་མོ།",
    "གནས་དང་མཐར་ཐུག་གི་དོན་གཉིས་གྲུབ་པའི་སྐམ་སར་ཡོངས་སུ་འདྲེན་པར་བྱེད་པ་ཞེས་བྱ་བ་དང་།",
    "གཉི་མུག་གི་རྟགས་ཀྱིས་དབེན་པར་འགྱུར་རོ།",
    "ཉོན་མོངས་དེའི་རྟགས་སྒོ་གསུམ་གྱི་གནས་ངན་ལེན་པའི་དབེན་པ་དང་།",
    "གཉེན་པོ་ཉོན་མོངས་མེང་པ་དག་ལ་ངེར་ཞེན་གྱིས་དབེན་པ་སྟེ།",
    "དེ་རེ་རེ་བཞིནནུད་འབྲིང་ཆེན་པོའི་དབྱེ་བས་བཅོ་བརྒྱད་ལ་ལྟས་སམ་མཚན་མ་བཅོ་བརྒྱད་ཅེས་བྱའོ།",
    "གང་ཟག་དེའི་ཤོམ་རིམ་མོ།",
    "དེ་ལ་སྔར་རྣམ་མཁྱེན་གྱི་སྐབས་ལ་ཞི་མཉམ་གཞག་གི།",
    "གཞན་དེ་ལུས་ཀྱིས་འགོད་པ་དང་ངག་གིས་བསྔགས་པ་དང་ཡིད་ཀྱིས་མཐུན་པར་བྱེད་པ་དང་།",
    "རང་གིརྟོགས་པ་ལ་ཡིད་ཆེས་གཏིང་ཚུགས་པས་གཞན་གྱི་དྲིང་ལ་མིའ་ཇོག་པའི་བློ་གྲོས་ཀྱི་མཐུས་བདུང་སོགས་གཞན་གྱིས་དམན་པའི་ལམ་དུ་དཀྲི་བར་མི་བཏུངཔ་ཛྫང་སདས་རྒྱས་ཐེ་བབྱེད་ཀྱི་ཐབས་མ་ནོར་བར་ཤེས་པས།",
    "དེས་དྲང་པའི་ལུས་ངག་གི་ཐ་སྙད་ཁྱད་པར་ཅན་ནི།",
    "རྒྱལ་བློན་གྱི་གཏམ་གྱིས་བདག་དང་དག་གི་བར་བཅས་པ་ཡི།",
    "འབྲས་བུ་རྣམ་སྨིན་སྤང་མི་དགོས་པར་རང་གི་ངང་གིས་འགོག་པའོ།",
    "གཏམཞེ་འདོད་ཀྱི་རྗེས་སུ་བྱེད་པས་ཞང་གི་རྣམ་པ་མཚོན་པའི་རྟགས་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་གང་ཟག་གཞན་གྱི་རྟོག་པའི་ཡུལ་དུ་གྱུར་པའི་ལུས་ངག་གི་ཐ་སྙད་བཅུ་དྲུག་ནི།",
    "་རྟོགས་ཟིན་ཡང་ཡང་གོམས་པས་སྔར་ལས་ཇི་བསཇེ་ཟབ་ཏུ་སོང་ནས་ཆེས་ངེསཔར་རྟོགས་པ་ཡིན་པས་ན།",
    "བདེན་པར་གྲུབ་པའི་འབྲས་བུ་གྲངས་མེད་པར་འབྱུང་ངོ་ཞེས་མང་ཉུང་གི་གྲངས་ཀྱིས་དབྱེ་བའ་བཟོད་པའམ་ནུས་༴",
    "དོན་ལ་དེ་ལྟར་ཡིན་པ་གཟིགས་ནས་བསྟན་པ་ཡིན་གྱི་དགོངས་པ་ལས་ཅན་འབྲས་བུ་དུ་མསྐྱེ་བཙམ།",
    "སྔ་ཕྱིར་ཕྱེ་བའི་སྐད་ཅིག་རེ་རེལ་ཞུས་པམ་ཚང་ཞིང་ཕྱི་མའི་དུས་ན་སྔ་མ་འགགས་ནས་མེད་པས་ཀྱང་ཆུ་བ་ཐོབ་པ་མི་སྲྀད་དོ་ཞེན།",
    "དེ་ལ་ཟབ་མོ་བརྒྱད་ནི།",
    "ད་རུང་ཤེས་བྱའི་སྒྲིབ་པ་ཕྲ་མོ་དང་བཅས་པཕྱིར་དེ་བཞི་ན་ཉིད་ལ་གཟིགས་པ་ཤིན་ཏུ་རྣམ་པར་དག་པ་སངསརྒྱས་ལྟ་བུ་ཡིན་ཅིང་།",
    "འབྲས་བུ་གཉིས་མེད་དེ་སྒྲུབ་བྱེད་བསྒྲུབ་བྱ་གཉིས་སུ་མེད་པར་གཟིགས་པའི་ཆ་ནས་སོ།",
    "རང་བྱུང་གི་རྣའམ་རང་བྱུང་ཡེ་ཤེས་ཀྱི་སྐུ་འདུས་མ་བྱས་པ་། རྒྱས་སྒྲུབ་པར་མིཞུས་པར་གཟིགས་པས་སོ།",
    "དེ་ལྟར་མི་འགལ་བརམཉམ་པའི་ཚུལ་དུ་རྟོགས་པའི་ཟབ་མོ་བརྒྱད་དང་ལྡན་པའི་ཡེ་ཤེས་ས་བརྒྱདཔ་ནས་ཐོབ་ལ།",
    "དེ་དང་རྗེས་སུ་མཐུན་པའི་ལུས་ངག་གི་ཐ་སྙང་ནི་གཞན་བོ་ཕྱིར་མི་ལྡོག་པའི་རྟགས་ཡིན་པའ་གཞུང་རྣམས་ལས་གསུངས་ཤིང་།",
    "སེང་བཟང་གིས་ཁྱད་པར་ལམ་ལ་བཞག་པ་མི་འཐད་ཅེས་ཨ་བྷྱ་ཡས་གསུངས་ཀྱང་འཕགས་པའི་དེ་ནི་དེ་ཕན་ཆར་བསླབ་པར་བྱ་བ་མེད་པའམ།",
    "གཉིས་པ་རྣམ་འཕེལ་གྱིས་མཚོན་པའིརྩེ་མོ་ནི།",
    "འཛམ་བུའི་གླིང་གི་སྐྱེ་བློ་ཇི་སྙེད་ཀྱིས།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ཞིག་གིས་རིམ་གྲོར་བྱས།",
    "སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་སྟེ་རིམ་པའ་ས་དང་པོ་དང་བདུན་པའི་བར་དང་བརྒྱད་པ་དང་ས་བཅུ་པ་ལ་གཞས་པ་སྟེ་དེ་བཞི་ཡི་སེམས་བསྐྱེད་པའི་ད་གེ་རྟ་ལ་ཡི་རང་བའོ།་",
    "དང་པེ་ལ་སྐབས་འདིར་ཐེག་ཆེན་གྱི་ལཨ་འཟླས་སུ་དང་ཅས་པ་ལ་འཇུག་ཡུལ་དུ་གཟུང་བའི་རྟོག་པ་དང་ཉན་རང་གི་ལམ་འབྲས་ལྡོག་བྱའི་ཡུལ་དུ་གཟུང་བ་སྟེ་གཉིས་དང་།",
    "གོང་སྨྱོས་གཟུང་དང་པོའཇུག་པ་གཟུདརྟེག་ལའཛིན་གྱི་རྟོག་པ་བཞི་པོ་རེ་རེ་ལའང་ནང་ག་དབྱེ་བས་ཡུལ་ལ་བརྟེན་ནས་འཛིན་སྟངས་ཀྱི་རྣམ་པས་དགུ་སྟེ་སུམ་ཅུརྩ་དྲུག་ཡོད་པ་རྣམས་ནི།",
    "རབ་འབྱོར་འདི་ཅི་སྙམ་དུ་སེམས་སྒྱུ་མ་ལྟ་བུའི་སེམས་དེ་ཁྱོད་ཀྱིས་ཡང་དག་པར་རྗེས་སུ་མཐོང་དུམ་ཞེས་པ་ནས་ཤིང་གི་འཁྲུལ་འཁོར་གྱི་དཔེས།",
    "དེ་ལྟར་བསྟན་པའི་ཤུགས་ལ་ཀུན་བྱང་གི་མཚ་ནོཉིད་དང་།",
    "སྲིད་ཞིར་ལྷུང་བ་ལས་འཛིན་པའི་ཐེགཆེན་ཀྱི་བཤེས་གཉེན་དང་ཐབས་ལ་མཁས་པ་སྟེང་གིཡོངས་སུ་འཛིན་པ་མེད་པ་དང་།",
    "འབྲས་བུ་ཉི་ཚེ་བྱ་སྤང་བྱ་ཕྱོགས་རེ་ཙམ་སྤོངབ་དང་།",
    "དེ་ལྟ་ན་སྤྱོད་ལམ་ཙམ་ལ་འདྲ་མོད་སུམ།",
    "ཡུལ་གང་ལའང་ཡུལ་འདི་ལ་བདག་གིས་ལོངས་སྤྱོད་དོ་སྙ་མ་པའི་རྣམ་པར་ོ་རྟོག་པ་མེད་བཞི་ཞ་ལྷུན་གྱིས་གྲུབ་པའི་ཕྲིན་ལས་ཀྱིས་འཇུག་ལྡོག་བྱེད་པ་ཡིན་ལ།",
    "དེ་ལྟར་མ་གྱུར་པའི་འཕགས་པ་གཞ་ཞ་གྱིས་བཏགས་པ་ཙ་མོ་གྱི་བདག་གིས་ཡུལ་ལ་ལོངས་སྤྱོད་པར་འཛིན་ཞིང་འཇུག་ལྡོག་བྱེད་ལ།",
    "དེ་མཐོང་དུ་རུང་གི་གལ་ཏེ་དྲི་མ་དང་བཅས་པ་ཞིག་ན།",
    "མི་སྐྱེ་བ་ལ་ཟད་མི་སྐྱེ་ཞེས་འདོད་ཀྱང་དྲི་མ་སྔར་བདེན་པར་ཡོད་པ་ཞིག་ཞ་འགོག་པ་མེད་པའི་རང་བཞིན་དུ་ངེས་པས་དེ་དག་གི་ལུང་རིགས་དང་འགལ་ལ།",
    "ཡང་ན་སྦྱིན་སོགས་ཐབས་ཀྱི་རྣམ་པ་མལུས་པའི་རང་བཞིན་སྟོང་པ་ཉིད་དུ་གཟིགས་པའི་ཡེ་ཤེས་བྱ་སྟེ།",
    "འབྱུང་གི་བདེན་པའི་རང་བཞིན་རྟོགས་ལ།",
    "བསམ་གཟུགས་བརྒྱ་དུ་འཁྱོགདང་བཅས་པའི་མཐར་གྱིས་གནས་པའི་སྙོམས་འཇུག་དགུར་ལུགས་འབྱུང་ལྡོག་གམ་ལུགས་མཐུན་དང་ལུགས་མི་མཐུན་རྣམ་པ་གཉིས་སུ་ཡར་མོར་ཞིང་ཨའ་འོང་ནས་ཏེ།",
    "བསམ་གཏན་དང་པོ་ནས་བཟུང་སྐྱེ་འགོག་པའི་བར་དུ་སོང་ནས་དེའི་འོག་ཏུ་འགོག་པ་ནས་བཟུང་སྟེ་བསམ་གཏན་དང་པོའི་བར་འོངས་པ་ཡི་ན་ནོ།",
    "བསམ་གཏན་དང་པོ་ནས་སྙོམས་འཇུག་བརྒྱད་ལ་འགོག་པ་རེ་སྤེལ་ནས་སྙོམས་པའྀ་འཇུག་ཅིང་སླར་སྲིད་རྩེར་ནུད་ཆུང་དང་བཅས་ན་བཅུ་བངུན་ནོ།",
    "དེ་ཡང་འདོད་པར་གཏོགས་པའིསེམས་རྣམ་པར་ཤེས་པ་བསམ་གཟུགས་ཀྱི་ཏིང་ངེ་འཛིན་མཉམབཞག་གི་ངོ་བོམིན་པའི་ཐུན་མཚམས་ཀྱི་ངོ་བོར་བཟུང་སྟེ་སྙོམས་འཇུག་དགུ་དང་འདོད།",
    "སྤྱིར་སྤང་བྱ་རྟོག་པལ་འཇུག་ལྡོག་གི་གཟུང་ཁ་གཉིས་དང་།",
    "ལྡོག་པ་ནི་སྦྱོར་བས་མི་ལེན་ཀྱང་སེམས་སེམས་བྱུང་འཇུག་ཡུལ་ཙམ་མོ།",
    "ཉན་ཐོས་ཚོགས་ལམ་པ་རྞམ་མཁྱེན་སྒྲིབ་པ་སྤོང་བ་ལ་ཀུན་ཏུ་རྨོངས་ཏེ་ཇི་ལྟ་ཇི་སྙེད་ཀྱི་རྣམ་པ་ཤེས་ལས་མོ།",
    "བདུད་དང་མུ་སྟེགས་སོགས་གང་དང་མི་མཉམ་པའི་ལ་མཟབ་མོལ་རྨོངས་པ་ལ་དང་།",
    "སྐྱེས་བུ་འགའ་ཞིག་གིས་ལྗང་བུའདོད་པས་སོགས་ལོའབྲས་ཕུན་ཚོགས་ཀྱི་དཔེས་བསྟན་པ་བཞིན།",
    "དེས་ན་རྒྱུན་མཐའི་བང་ཆད་མེད་པའི་རྩེ་མོའི་བསླབ་པ་འདི་ནི།",
    "སྦྱོར་བ་ཕྱིན་དྲུག་གི་ཉམས་ལེན་ཀྱང་མི་འཐད་དེ་སྦྱིན་སོགས་མེད་པའི་ཕྱིར་སྙམ་དུ་མི་འཇད་པར་དང་།",
    "དེ་ལ་བདེན་གཉིས་འགལ་བར་འཛིན་པའི་གང་ཟག་གིས།",
    "ཐལཞེ་ན་ཁྱབ་པ་མ་ངེས་པ་སོགས་བདེནགཉིས་རྣམ་པར་ཕྱེ་ཞིང་སྟོང་རྟེ་རྡ་འབྱུང་འགལ་མེད་ཀྱི་ཚུལ་ལས་བརྩམས་ཏེ་ལོག་རྟོག་བསལ་བར་བྱ་བ་ལ་ཡང་དག་པ་མཁའ་རྡུག་གི་དོན་དུ་ཀུ་ན་རྫོབ་ལས་ལེགས་ཤིག་ཏུ་དོན་དམ་ཉེ་བར་མི་དམིགས་པས།",
    "རྟོགས་པར་དཀའ་ཁ་བར་ཆད་མེད་རྩེའི་དམིགས་རྣམ་ལ་ཕ་རོལ་གྱི་ལོག་པར་རྟོག་པབསལ་ནས་ད་མིགས་བ་སོགས་འཐད་པར་བསྡུབས་ཤིང་ཡིད་ཆེས་པའི་སྒོ་ནས་བརྒྱ་ཞེ་པའི་མོའི་དེརྣ་ལ་ཕྱིན་ཅི་མ་ལོག་པར་འཇུག་པར་བྱའོ།",
    "མ་ཤེས་ནས་གང་ཟག་གི་བདག་འཛིར་ཡོད་ན།",
    "དེར་ཕྱིན་ཟབ་མོའི་དོན་ནི་ཐོས་བསམ་གྱིས་སྒོ་འདོགས་ཆོད་པའི་དུས་ནས་ཀྱང་།",
    "ཐབས་ཤེས་ཟུང་འཇུག་གི་ཤེར་ཕྱིན་ཟབ་མོའི་སྦྱོར་བ་ལ་མཁས་པར་བྱའོ།",
    "ཉམས་ལེན་སྣ་གཅིག་གིས་ཀྱང་གཞིལ་སྒྲོ་འདོགས་ཆོད་པ་དང་།",
    "འབྲས་བུ་དཔེ་བྱད་ཀྱི་བརྡ་བསྡུས་པ་ལ་དམིགས་རྣམ་རྗེ་གསལ་དུ་སོང་ནས་མཐའ་མེད་པར་འཕེལ་བ་སྟེ།",
    "དེ་ཡང་བློ་གཅིག་གི་སྟེང་ནས་གསལ་བ་རབ་ཀྱི་མཐར་ཐུག་པ་སྒོ་མ་ཞུས་ན་གྲུབ་པའི་ཚད་ངེ་སྐདཅིག་མ་ཡིནལ།",
    "ད་ལྟ་སྐད་ཅིག་མ་རང་གི་ངོ་བོ་ནི་སྒམ་པར་སྨིན་པ་ཡིན་ཏེ།",
    "ཡུལ་ཅན་གྱི་བློས་ཀྱང་དེ་དེ་བཞི་ཞ་དུ་བསྒོམ་ཞིང་ས་རྣམས་སུ་འབད་རྩོལ་གྱིས་བསྒྲུབ་ནས་སྐད་ཅིག་ལ་མངོན་དུ་བྱེད་པར་གྱུར་ཅིག་སྙམ་པའི་འཕེ་ནཔ་དང་ཚོགས་ཡོངས་སུ་རྫོགས་པའི་ཤུགས་ཀྱིས།",
    "ཇི་ལྟར་གནས་པའི་ཟབ་མོ་དེ་དེ་བཞིན་དུ་མཐོང་ནུསཔའི་མཐུན་རྐྱེནཚང་ཞིང་འགལ་རྐྱེན་བྲལ་བརྒྱུ་ན་མཐའི་རྡོར་ཏིང་གི་སྐད་ཅིག་མའི་སྐ་བས་འདིའ་མཐའ་གྱིས་པའི་སྐབས་ལྟར་རི་མཅན་མིན་ཏེ།",
    "དེའི་ཕྱིར་ན་རྣམ་པར་སྨིན་པ་ནི་གང་ཚོ་རྒྱུན་མཐའི་བར་ཆད་མེད་ཐོབ་པ་ན།",
    "རྒྱུན་གྲལ་མཐའི་ཡེཤེས་སྐད་ཅིག་མ་གཅིག་གིས་ཇི་ལྟར་གནས་པ་བཞིན་མཐོང་བ་ལ་གཉིས་སུ་མེད་པའི་སྐད་ཅིག་མཞེས་དོན་དང་མཐུན་པའི་མིང་བརྗོད་པའོ།",
    "བརྟེན་ནས་བརྟགས་པས་འདུས་བྱས་སུ་སོང་བ་དངོས་མེད་གཉིས་ཀའང་འདུས་བྱས་ཏེ།",
    "དེ་ལ་མ་ལྟོས་པར་མི་གྲུབ་པས་གཞན་ལ་ལྟོས་པས་རེས་འགའ་བའམ་འདུས་བྱས་ལྟ་བུ་ཡིན་ལ།",
    "དེ་ཡང་མཉམ་པ་ཆེན་པོའི་དབྱིངས་སུ་ཚུལ་གཅིག་པ་སོས་འརྡ་གིས་རིག་པར་བྱ་བ་ཡིན་གྱི་གཉིས་སུ་སྣང་ཞེནཅ་ན་གྱི་ངོར་སྣང་བ་ལྟ་བུ་ནི་མ་ཡིན་ནོ།",
    "འོ་ཞ་བློ་གཅིག་གིས་ཇི་ལྟར་རྟོགས་ཞེ་ན།",
    "ཤེས་ན་མི་ཤེས་འཇིག་པར་ཐལ།"
  ]
}