    "མི་མཐུན་པའི་ཚིག་རྒྱན་ཞེས་པ་འདི་ཚིག་དོན་གཉིས་ཀའི་ཆ་ནས་མི་མཐུན་པ་ཞིག་དགོས་ཀྱི་འདུག་འདིའི་དཔེར་བརྗོད་ནི།",
    "ཅ་ལག་རྐུབ་རིལ་འདི་ག་ཚོད་བཞག་ཀྱང་ཁ་ཐུག་ལ་སྡོད་ཀྱི་མི་འདུག་ཅ་ལག་རྐུབ་རིལ་དེ་ག་ཚོད་བཞག་ཀྱང་ཁ་ཐུག་བསྡད་མི་ཡོང་།",
    "རིག་པ་རྟུལ་པོའི་མི་རྣམས་ལ་ཡང་བསླབ་ཀྱང་ཤེས་ཁག་པོ་འདུག་རིག་པ་རྟུལ་པོའི་མི་དེ་ལ་ཡང་ཡང་བསླབ་ཀྱང་ཤེས་ཁག་པོ་ཡོང་།",
    "ནམ་མཁའི་མཐོངས་ཀྱི་བྱ་འཕུར་དེ་ལ་ནན་ཏན་བལྟས་ཀྱང་གསལ་པོར་ངོས་འཕྲོད་ཀྱི་མི་འདུག་ནམ་མཁའི་མཐོངས་ཀྱི་བྱ་འཕུར་དེ་ལ་ནན་ཏན་བལྟས་ཀྱང་གསལ་པོར་ངོས་འཕྲོད་ཁག་པོ་ཡོང་། མཆན་༡",
    "ཁོ་ཚོས་སྐད་ཆ་དེ་ལ་ག་ཚོད་ཉན་ཡང་དོན་དག་གསལ་པོ་ཞིག་ཧ་གོ་མི་འདུག་ན་མཐར་ཡང་སྦྱར་བ།",
    "དོན་མེད་ཀྱི་འཁྲབ་རྩེད་རྒྱག་རྒྱུ་འདི་སེམས་པ་དགའང་གཟུགས་པོ་བདེ་པོ་རང་མི་འདུག་དོན་མེད་ཀྱི་འཁྲབ་རྩེད་རྒྱག་རྒྱུ་དེ་སེམས་པ་དགའང་གཟུགས་པོ་བདེ་པོ་མི་ཡོང་།",
    "མི་འདི་ཁ་ཚའང་སེམས་པ་བཟང་པོ་ཞིག་འདུག་མི་དེ་ཁ་ཚའང་སེམས་པ་བཟང་པོ་ཞིག་ཡོད།",
    "པོ་འདུག་ག་མཐར་ཀྱང་སྦྱར་བ།",
    "བང་མཛོད་ཀྱང་མང་པོ་འདུག་ད་མཐར་ཀྱང་སྦྱར་བ།",
    "པོ་འདུག་བ་མཐར་ཀྱང་སྦྱར་བ།",
    "མཆོད་ཆང་ཡང་ཞིམ་པོ་འདུག་ང་མཐར་ཡང་སྦྱར་བ།",
    "བློ་མཐུན་པ་དེ་སྐུ་ཡོན་ཆེ་ལ་མཚན་ཡང་སྙན་པར་གྲགས་པ་ཞིག་འདུག་ན་མཐར་ཡང་སྦྱར་བ།",
    "མཚོ་བོད་རླངས་འཁོར་གཉིས་པོ་འདིར་སྡོད་གནས་སྐྱིད་ཅིང་འགྲོ་ལམ་ཡང་བདེ་པོ་འདུག་ནག་མངའ་རླངས་འཁོར་དེར་སྡོད་གནས་སྐྱིད་ཅིང་འགྲོ་ལམ་ཡང་བདེ་པོ་ཡོད་ཟེར།",
    "མི་དེ་རྩལ་ལག་འཛོམས་ཤིང་མེ་མདའ་ཡང་ཚ་པོ་འདུག་འ་མཐར་ཡང་སྦྱར་བ།",
    "མི་དེ་རིག་པ་བརྟན་ལ་ཁ་བཟོ་ཡང་འཕེར་པོ་ཞེ་དྲག་འདུག་མཐའ་མེད་ལ་ཡང་སྦྱར་བ།",
    "དོན་ཡང་མཐུན་གྱི་འདུག་ན་མཐུན་པའི་རྒྱུན་དུ་བཞེད་པ་རྣམས་ཀྱིས་ནི་སྡུད་སྒྲ་ལ་སྡུད་ཚིག་གསལ་བྱེད་ཀྱི་སྒྲ་སྔོན་དུ་སློབ་ཚན་ཐོག་བཀོད་ཟིན་པ་དེ་དག་གང་རུང་ཞིག་སྦྱར་དགོས་ཞེས་གསུངས་པ་ལྟར་ལ་དཔེར་བརྗོད་འགོད་པར།",
    "རྒྱ་ཡིག་ཀྱང་བྲི་ཤེས་ཀྱི་འདུག་མཐར་ཀྱང་སྦྱར་བ།",
    "ཨུ་རུ་སུའི་སྐད་ཀྱང་རྒྱག་ཤེས་ཀྱི་འདུག་ད་མཐར་ཀྱང་སྦྱར་བ།",
    "བཙའ་ཡང་བརྒྱབ་འདུག་ལྕགས་རིགས་དེ་ཚོར་བདག་སྤྲོད་མ་བྱུང་བས་མི་ཚད།",
    "དོ་པོ་དེ་ཚོ་རྟ་དྲེལ་ལ་བཀལ་ཏེ་དབོར་གྱི་འདུག་པ་མ་གཏོགས།",
    "སོན་དེ་ཚོ་འདེབས་དུས་མ་འཕྱུགས་པར་བཏབ་སྟེ་འདེབས་ཆུའང་གཏོང་དགོས་འདུག་བ་མཐར་ས་སྟེ་སྦྱར་བ།",
    "རྟ་རྒོད་མ་འོལ་བ་དེ་ལ་རྟེའུ་ཟེག་མ་གཅིག་འཁྲིད་འདུག་ཅེས་པ་དང་།",
    "མཚོ་ཆེན་པོ་དེ་ལས་མཚེའུ་ཆུང་ཆུང་དེ་བློ་ལ་འགྲོ་བ་འདུག་ན་བ་ཆེན་པོ་དེ་ཚོ་ལས་ནེའུ་གསིང་དེ་ངལ་གསོ་རྒྱག་ས་སྐྱིད་པོ་ཡོང་།",
    "རིང་ལུགས་གསར་པ་ཐམས་ཅད་ཀྱི་ནང་ནས་གུང་ཁྲན་རིང་ལུགས་དེ་མཆོག་ཏུ་གྱུར་འདུག་ཅེས་དང་།",
    "རང་རང་སྡོད་གནས་ན་ས་རྨེ་རུ་གླིང་ཁའི་བར།",
    "ང་རང་ཚང་མར་འཕྲལ་དང་ཕུགས་སུ་ཕན།",
    "གཟུགས་པོར་ཅ་ག་བྱེད་དགོས་ཟེར་འདུག་སྐྱིད་འཛོམས་མ་ཡེ།",
    "ཤེལ་ཁྲ་ནི་འདུག་ཐངས་ནི་དཀར་བ་མ་ཟད།",
    "སྡོད་བག་ནི་ཕེབས་པ་ཞིག་འདུག་ཅེས་པ་ལྟ་བུ།",
    "བོད་གངས་ཅན་དེ་ཞེས་པ་ལྟ་བུ་ཡིན་འདུག་ཅིང་།",
    "འདི་འདྲ་ཟེར་གྱི་འདུག་གོ།",
    "དེ་འདྲ་ཟེར་གྱི་འདུག་གོ་ཞེས་པའི་དོན་དག་ཡིན།",
    "ས་མཐར་དམིགས་བསལ་ཞེས་ཐོབ་པ་ནི་རྗེ་ཞ་ལུ་བའི་དག་ཡིག་ཟ་མ་ཏོག་ཅེས་པ་དེ་མ་བརྩམས་པའི་གོང་དུ་རྗེས་འཇུག་ས་མཐར་ཤེས་ཞེས་སྦྱར་སྲོལ་ཡོད་འདུག་རུང་།",
    "ཕོ་ཡིས་ཕོ་ཡི་མིང་མཐའ་དྲངས་ཏེ་ས་མཐར་ཅེས་ཞེས་སྦྱོར་སྲོལ་གྱི་ལུགས་ཤིག་ཀྱང་འདུག་སློབ་ཚན་ཉེར་དགུ་པ།",
    "སྟབས་ཅིག་ལ་དོན་གཉིས་འགྲིག་པ་བྱུང་འདུག་ཅེས་པ་ལྟ་བུ་དང་།",
    "ར་བཏགས་གསུམ་ལ་འ་མཐའ་སྤངས་དགོས་པ་ཞིག་བྱུང་འདུག་དེའི་མཇུག་ཞ་ལུ་ལོ་ཆེན་གྱི་སྐུ་རིང་ནས་བཟུང་ད་ལྟའི་བར་གཞུང་ལས།",
    "འདོགས་ཞེས་པ་ཡ་ར་ལ་ཝའི་འདོགས་ཅན་གྱི་རིགས་བཅས་ལ་འ་མཐའ་སྤངས་དགོས་པ་གསུངས་པས་ན་དེང་སང་བརྡ་ཐོ་ཞེས་པའི་དག་ཆར་འ་མཐའ་དང་ཝ་འདོགས་གཉིས་ཀ་དགོས་ཀྱི་མི་འདུག་ཡང་།",
    "པ་ཕའི་སྡུད་ཚིག་ལ་པཱ་ལགས་ཞེས་འབྲི་སྲོལ་འདུག་པའི་པ་འ་མཐའ་ཅན་དེ་འ་འདོགས་ཅན་དུ་བསྒྱུར་པ་ནི་མཛེས་ཆའི་ཆེད་དུ་ཡིན་འདུག་པ་ལྟར་ལེགས་པར་སྣང་།",
    "བཅྭ་བརྒྱད་གཉིས་ལ་སྔ་དུས་ཝ་བཏགས་འགོད་སྲོལ་འདུག་པ་དེང་སྐབས་ན་རོ་ཅན་བྲི་མཁན་རྒྱུན་",
    "འདུག་འདོགས་ཅན་གྱི་ཁོངས་ནས་ཕྱྭ་ཝ་བཏགས་ཅན་ཞིག་བྱུང་འདུག་པ་ནི་བོད་འདིར་སྔར་དུས་བོན་ལུགས་ཤས་ཆེ་བའི་ཕྱྭ་དང་།",
    "གྲོགས་ཆ་སོགས་ལ་ཆ་ཡིག་རྐྱང་པ་དེ་བྲི་སྲོལ་འདུག་པ་བཅས་ཡིན།",
    "ལའི་འཇུག་པ་བརྒྱད་ཅེས་པ་འདི་དག་ཉེར་མཁོའི་གནས་སུ་འདུག་པའི་ཁར།",
    "དེང་དུས་མེས་རྒྱལ་ན་གང་ཅིའི་ཡར་རྒྱས་བྱ་རྒོད་འཕུར་བ་ནང་བཞིན་འདུག་ཅེས་པ་ལྟ་བུ།",
    "ནའི་འཇུག་པ་བཅུ་བཞི་ཞེས་པ་ཞིག་གསུངས་འདུག་ན་དེ་དག་ལ་དཔེར་བརྗོད་འགོད་སྟངས་གང་འདྲ་ཡིན་ཞེས་པ་ལྟ་བུ།",
