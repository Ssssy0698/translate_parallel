    "རིགས་ལམ་གྱི་འགྲོ་སྟངས་དེ་བོད་པ་མ་གཏོགས་ནང་པའི་ཡུལ་གྲུ་སུ་གཅིག་ལ་མི་འདུག་རིགས་ལམ་འགྲོ་སྟངས་དེ་དག་བོད་ཡིག་ནང་ཡོད་པར་བརྟེན།",
    "འོན་ཀྱང་དོན་དག་ཐོག་སྐད་ཆ་ཤོད་སྐབས་སེམས་འཚབ་པ་དང་དངངས་སྐྲག་ལང་དགོས་དོན་རྩ་བ་ནས་མི་འདུག་དེ་དག་ནི་དཔལ་ན་ལེནྡྲའི་གཞུང་ལ་སྦྱང་བརྩོན་བྱས་པའི་འབྲས་བུ་ཞིག་ཆགས་ཡོད།",
    "ཁེ་ཕན་གང་ཞིག་འཐོབ་རྒྱུ་འདུག་དེར་བརྟེན་གཞན་གཅེས་འཛིན་ཐོག་བསམ་བློ་བཏང་ན།",
    "ག་དུས་ཡིན་རུང་ངོས་རང་མི་དུང་ཕྱུར་བདུན་ཅུའི་ནང་ནས་གཅིག་ཡིན་བསམས་པ་མ་གཏོགས།",
    "ངོས་རང་ག་དུས་ཡིན་རུང་གྲ་སྒྲིག་ཨང་གསར་ཡིན།",
    "རུ་སུའི་སྐད་བཅས་ཀྱི་ཐོག་གསུང་སྒྱུར་ཞུས་ཡོད་འདུག་པ་བཅས།",
    "ང་རང་ས་གནས་འདིར་བཅར་ཐེངས་གསུམ་པ་ཆགས་ཡོད།",
    "དེར་བརྟེན་ཁྱིམ་ཚང་སོ་སོའི་ནང་བོད་པའི་སྐད་བེད་སྤྱོད་གཏོང་རྒྱུའི་ལས་འགུལ་སྤེལ་ཐུབ་ན་དགེ་མཚན་ཆེན་པོ་མེད་དམ་བསམ་གྱི་འདུག་ཕྱི་རྒྱལ་ཁག་ལ་ཡང་ལས་འགུལ་སྤེལ་གྱི་ཡོད།",
    "སེམས་གཏིང་དུ་བློ་བདེ་པོ་ཞིག་མེད་པར་ག་དུས་ཡིན་ནའང་བདེན་མེད་ངོ་གནོང་བ་དང་།",
    "དགྱེས་ཤིང་སོགས་སྦྱར་བ་དང་རང་སྔགས་བརྗོད།",
    "མས་སློབ་དཔོན་ཤར་དུ་འདུག་ནས།",
    "ཤར་ཕྱོགས་སུ་སྟན་བདེ་བ་ལ་འདུག་ནས།",
    "སྐྱིལ་ཀྲུང་ངམ་ཙོག་པུར་འདུག་ལ།",
    "ཡུལ་སྐོར་བྱ་གཞག་འཕེལ་རྒྱས་གཏོང་བ་སོགས་ཀྱི་དུས་རབས་ཉེར་གཅིག་པ་འདིའི་ནང་མི་རྣམས་ལ་དགོས་ངེས་ཀྱི་ཆ་འཕྲིན་མང་དག་ཅིག་ངོ་སྤྲོད་གནང་འདུག་པས།",
    "སྔར་ཡང་ཕ་ཡུལ་ངོ་བོ་འདུག་ད་འང་ཕ་ཡུལ་བྱེད་པ་ཡིན་ཞེས་ནགས་ཤོད་དང་སོག་ཤོད།",
    "ཉག་ཆུ་ནི་ཆུ་ཆེན་ཞིག་ཡིན་ཀྱང་རང་ཚུགས་ཀྱིས་རྒྱ་མཚོར་མ་བབས་ཞིང་འབྲི་ཆུ་དང་འདྲེས་པས་ཆུ་ཆེན་དུ་མ་བགྲངས་སོ།",
    "ལར་གྱིས་ཡུལ་ལ་ཁྱེད་རང་གང་གསུངས་དུ་འདུག་སྟེ།",
    "ནགས་ཤོད་ན་ཨོང་ཅོང་ཀོང་ཇོ་འཁོར་དང་བཅས་པ་འདུག་པས་ཐུགས་དགྱེས་སོ།",
    "སྔར་ཡང་ཕ་ཡུལ་ངོ་བོར་འདུག་དའང་ཕ་ཡུལ་བྱེད་པ་ཡིན།",
    "སྔར་མིའི་ཤོད་སྲོལ་ལ་ཧོར་ཚོ་འདི་སོག་དུས་རྒྱ་དུས་བོད་དུས་ཞེས་དབྱེ་བས་འདི་ཡན་སོག་དུས་ཡིན།",
    "སོག་དུས་དང་རྒྱ་དུས་བཅས་ལ་ལྷོ་སྨྲེ་ཏིའི་དགྲ་སྒོ་འགོག་མི་ཞེས།",
    "རྗེ་སྐྱོབ་པས་སྐྱོབ་ཟེར་རྫུན་དུ་གདའ།",
    "འགོམ་དགོན་བཀག་པོ་སྒང་དུ་སྤོས་ནས་ལོ་ཞེས་སོགས་འཁོད་ཡོད་འདུག་པས།",
    "སྒོམ་གསར་པ་ལ་དགའ་བར་འདུག་གཡའ་རི་དང་།",
    "རྩལ་འགྲན་ན་དོ་ཡ་ཨེ་འདུག་ལགས།",
    "ད་ང་རང་མར་ལ་ལོག་རྩིས་ཡོད།",
    "ཁོ་དེ་རིང་ངའི་དབུགས་འདི་མ་འདྲ་ཙམ་མི་འདུག་གམ་ཞེས་གསུངས་པས།",
    "གཞན་ཡང་རང་དགོན་དང་ཕྱོགས་ཁག་ལ་རྟེན་གསུམ་བཞེངས་པ་དང་།",
    "དེ་རྣམས་ཀྱིས་འབྲི་གུང་སྐྱབས་མགོན་རྣམ་གཉིས་ཀྱི་སྐུ་ཚེའི་ཚེ་སྒྲུབ་གཙོ་བོ་དང་རང་ལུགས་ཕྱག་ཆེན་ལྔ་ལྡན་སོགས་ལ་འབད།",
    "དག་སྣང་དང་རང་བྱུང་རྣམས་གཏན་ལ་ཕབ་པ་དེ་ཉིད་ལས།",
    "ཚ་འགག་རྐྱང་རི་སོགས་གནས་རི་མང་པོ་གནས་སྒོ་འབྱེད་པ་དང་རང་བྱུང་ངོ་མཚར་བརྟན་ལ་ཕབ་ནས་ལུང་བསྟན་མང་ཡང་ཡི་གེས་འཇིགས་པས་མ་བྲིས།",
    "སྔར་གྲོང་ལྟག་ཏུ་ལྷ་ཁང་ཞིག་ཡོད་ཀྱང་རིག་གསར་གོང་ནས་ཉམས་གུད་དུ་ཕྱིན་འདུག་དེ་རྗེས་སྤྱི་ལོ་༡༩རྡོ་༩ས་སྦྲུལ་ལོ་ཟླ་དང་པོའི་ཚེས་བཅུ་གཉིས་ལ་སྔར་མལ་དུ་ཁང་བུ་བརྩེགས་པའི་མཆོད་རྟེན་ཞིག་བཞེངས།",
    "མུ་ནམ་གཅོད་རྒན་ཁེར་འདུག་བླ་རི་བན་དེ་སྤུན་བདུན།",
    "གནས་དགོན་ལ་བྱིན་མེད་ལྟ་བུ་རིན་ཐང་མེད་པ་ཞིག་ཆགས་འགྲོ་འདུག་པས།",
    "ཞན་གྱི་ཁ་ལ་སོགས་བྱིན་གྱིས་བརླབས་པ་དག་ཡིན་ཏེ་ཐུགས་རྗེ་བྱིན་གྱིས་བརླབས་ཅེས་ག་བ་པ་དང་རྡོ་ཤིང་རང་འགྱུར་གྱི་བོན་ཅེས་སོགས་འབུམ་ལས་གསུངས་སོ།",
    "དར་ཚ་ཚོ་བཞི་ཡོད་པའི་གཅིག་ཁྲོ་ཚང་ཡིན་པར་གདའ།",
    "ཆུང་བ་དེ་རྗེ་འབྲུག་ཡིན་པར་གདའ།",
    "ཁྱད་པར་གཟི་མདངས་དང་ལྡན་པ་གཅིག་གདའ།",
    "ཅི་ཡང་མི་གསུང་བར་ལྷོད་དེ་བཞུགས་ནས་གདའ།",
    "ཁོང་ལ་བཀྲེས་སྐོམ་མི་མངའ་བར་གདའ།",
    "མདུན་དུ་གཞའ་ཚོན་གྱི་གདུགས་ཤིང་ལྗོན་ཡུ་བའི་ཚུལ་ཅན་ཞིག་འདུག་པས།",
    "རྐང་མགྱོགས་དང་རྫུ་འཕྲུལ་ཀྱང་དེ་དུས་རྙེད་ནས་གདའ།",
    "གཏེར་བཏོན་པ་ལ་རྗེ་འབྲུག་པས་སྔ་མེད་པ་གདའ།",
    "ལམ་དུ་རོ་སུམ་ཏུལ་ཅིག་འདུག་དམ་པའི་ཞལ་ནས།",
    "ཁྱེད་རང་ཟོ་གསུངས་བཞུགས་མ་ཉན་བྱོན་ནས་འོང་།",
    "ཁྱེད་རང་ཡང་ཡར་བྱོན་དང་ངད་རང་འདིར་ཆབ་ཡབ་བྱེད་གསུངས།",
    "མཆོད་རྟེན་དེ་བས་ལེགས་པ་ཅིག་བཞེངས་ནས་གདའ།",
    "རྗེ་ལྷ་རི་གཉེན་པོ་བྱ་བ་དེ་སྤྲུལ་པའི་སྐུ་ཆེན་པོ་ཞིག་ཡིན་པ་གདའ།",
    "ངས་ཕུད་མ་ཉམས་པར་བྱས་ལ་སྒུག་ནས་ཁོང་མངོན་ཤེས་དང་རྫུ་འཕྲུལ་ལྡན་པས་བྱོན་ཙ་ན་དྲངས་དགོས་བསྙམ་པས།",
    "ཁོང་རང་གཅིག་པུས་ཆོག་པར་སྐད་པ་དོན་ངེས་པ་མ་ཡིན་ཁ་མཁས་པ་ཡིན་སྙམ་ན།",
    "བྲག་སུལ་ཐར་དཀའ་བ་ལས་ཁྱེར་ཙ་ན།",
    "བུ་རྣམས་ཀྱིས་ཁ་སྐབ་པར་འདུག་སྐད།",
    "དེ་ནས་རྗེ་འབྲུག་གསང་ཕུག་ཏུ་བྱོན་ཙ་ན།",
    "མཆོད་རྟེན་ཀུན་དུས་གཅིག་ཚར་བ་གདའ།",
    "ཁོ་རང་ཁྱིམ་དུ་བཏང་བས་ཆོག་འོ་སྐོལ་གཉིས་འགྲོ་དགོས།",
    "ཁྱེད་རང་ཡང་འཚོ་བ་རུ་ཟུང་།",
    "རྗེ་འབྲུག་མ་སླེབས་པར་ཁྱེད་རང་གྲོངས་ན།",
    "ལན་གཅིག་ཁྱེད་རང་གང་དགའ་བྱེད་གསུངས།",
    "ང་ཡི་ཡབ་རྫ་མཁན་སྣང་བྱེད་གྲོངས་ནས་ཡོད་པར་གདའ།",
    "ད་ཐེངས་གཅིག་རྒྱ་གར་དུ་འགྲོ་དགོས་པར་འདུག་ད་རུང་ཁྱེད་ཐེངས་ཅིག་ཡ་ཐོག་ཞང་བོད་ཁྱད་ནོར་དཔེ་ཚོགས།",
    "ཁས་དམན་པ་གཅིག་འདུག་ངས་ཚུར་ལ་ཕུག་རོན་ཞིག་ཏུ་སྤྲུལ་ནས་འོང་ཙ།",
    "བྱང་ཕུ་ན་རི་དྭགས་པ་འགའ་འདུག་རི་དྭགས་མ་སོད་ནས།",
    "མཐུ་མྱུར་བའི་ཚད་དེ་ལ་བྱེད་པར་གདའ།",
    "ཁོང་སྟེང་ཁང་ན་མི་བཞུགས་པར་འདུག་ཟེར།",
    "ཁྱེད་མི་བཞུགས་པར་འདུག་ཅི་ལགས་ཞུས་པས།",
    "གཡུང་དྲུང་བོན་གྱི་དབུ་འཕང་དམའ་བར་འདུག་པས།",
    "གཡུང་དྲུང་བོན་གྱི་དབུ་འཕང་དམའ་བར་འདུག་པས།",
    "རྫུ་འཕྲུལ་སྣ་ཚོགས་ལ་ཐོགས་པ་མེད་པ་གཅིག་བྱང་ནས་གདའ།"
  ]
}