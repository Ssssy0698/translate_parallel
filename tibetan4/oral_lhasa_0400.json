    "ངེས་པར་འཇོག་པའི་ཡིད་དང་གསུམ་པོ་དེ།",
    "ངེས་པར་འཇོག་པའི་ཡིད་ཀྱིས་ཕྱེ་བ་དེ་ལ་ངེས་པར་གཟུང་།",
    "བཙལ་བས་རྙེད་པར་མི་འགྱུར་ཏེ།",
    "མངའ་བདག་ཆེན་པོ་འདི་ལྟར་ཤེས་པར་གྱིས།",
    "བྱས་པའི་ལྷུན་གྲུབ་ལྔ་བཅུ་མ་ཕྱེད་ན།",
    "ཡང་མངའ་བདག་ཆེན་པོ་འདི་ལྟར་ཤེས་པར་བྱ།",
    "འདིའི་མིང་ནི་ཇི་སྐད་ཡིན་ཞེས་བྱས་ནས་དྲི།",
    "དེ་ལྟ་ཡང་ཟེར་དུ་ཆུག་དང་བྱས་ལ་དྲིའོ།",
    "ཁོ་བོས་གོང་དུ་མིང་ལྷུན་གྲུབ་ཡིན་བྱས་པ་ཞེས་བྱའོ།",
    "མངའ་བདག་ཆེན་པོ་འདི་ལྟར་ཤེས་པར་བྱའོ།",
    "འདིའི་ཁ་དོག་ཅི་ཡིན་བྱས་ལ་དྲི།",
    "ཕར་ལ་འདྲི་བའི་འདྲི་ལུགས་འདི་ལྟར་ཤེས་པར་བྱ།",
    "ཚུར་ལ་འདྲི་ན་འདི་ལྟར་ཤེས་པར་བྱ།",
    "མི་བསྐྱོད་འཕོ་ལྡོག་མེད་པར་གནས།",
    "ཐམས་ཅད་མ་ལུས་ཡོངས་སུ་རྫོགས་པར་བསྟན།",
    "གསལ་ཡང་དེ་ལ་རང་བཞིན་མེད་པར་བསྟན།",
    "གསལ་ཡང་དེ་ལ་མིང་འདོགས་མེད་པར་བསྟན།",
    "ཡེ་ནས་གནས་ཀྱང་ཕྱེ་བ་མེད་པར་བསྟན།",
    "གདལ་ཁྱབ་ཆེན་པོའི་ངོ་བོར་ཡེ་ནས་གནས་པར་བསྟན་པའོ།",
    "ཀྱེ་སློབ་དཔོན་ཆེན་པོ་ལགས།",
    "ལག་ཡད་འབད་ལ་བྱས་པས་དྲི་མ་སླར་ལ་བསླང་།",
    "ཡས་འཁྲུལ་གཏན་ལ་མ་ཕེབས་པའི།",
    "མངའ་བདག་ཆེན་པོ་ཡིད་ལ་གཡེང་བ་མ་བྱེད་པར།",
    "གསུང་ནི་གཡོ་མེད་མི་གཡོའི་གསུང་དུ་བཞུགས།",
    "ཐུགས་ནི་རང་གསལ་རྟོག་པ་མེད་པར་བཞུགས།",
    "སྐུ་ནི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་རུ་བཞུགས།",
    "གསུང་ནི་བྲག་ཅ་ལྟ་བུའི་གསུང་དུ་བཞུགས།",
    "ཐུགས་ནི་སྐྱི་བསེར་ལྟ་བུའི་ཐུགས་སུ་བཞུགས།",
    "ཡུལ་ནི་སྐུ་ཡི་རྩལ་གྱི་རྣམ་པར་བཞུགས།"
  ]
}