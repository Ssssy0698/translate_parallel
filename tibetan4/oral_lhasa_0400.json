    "ཁྱད་པར་དུ་བྱེད་ན།",
    "དྲུག་པ་འགྲུབ་པར་བྱེད་པ་ནི།",
    "དྲུག་པ་མང་པོའི་ཚིག་འགྲུབ་པར་བྱེད་དེ།",
    "བདུན་པ་འགྲུབ་པར་བྱེད་པ་ནི།",
    "བདུན་པ་མང་པོའི་ཚིག་འགྲུབ་པར་བྱེད་དེ།",
    "དེ་དག་གང་ཕན་ཚུན་གང་བསྒྱུར་དུ་བཏུབ་པའི་སྒྲ་གཅིག་སྒྲ་ཐམས་ཅད་ལ་འཇུག་པར་ནུས་པ་ཡིན་ནོ།",
    "དེ་ལྟར་བསྒྱུར་བ་བདུན་བོད་པ་དང་བརྒྱད་ལ་རྣམ་པར་དབྱེ་བ་ཡིན་ནོ།",
    "ཁོང་དུ་ཆུད་པ་ཉིད་ལྟ་བུའམ་མཚོན་པར་ནུས་པའོ།",
    "སྒྲའི་སྒོ་ནས་དོན་གྱི་དངོས་པོ་སྒྲུབ་པར་བྱེད་པ་ཞེས་པ་ནི།",
    "ཀ་བའི་སྒྲའི་སྒོ་ནས་ཀ་བའི་དངོས་པོ་ཆུད་པར་བྱེད་པ་སྟེ།",
    "བྱེད་པས་བྱེ་བྲག་རྣམ་པར་འབྱེད།",
    "བྱ་བ་ཡོངས་སུ་རྫོགས་པར་སྟོན།",
    "ཞེས་བྱ་བ་ནི་བྱེད་པ་པོ་ལྷ་སྦྱིན་དང་།",
    "འབྲེལ་བའམ་མིང་ཡང་འདོགས་པར་བྱེད།",
    "དེ་ཡང་བཏགས་པའི་སྦྱོར་བ་ལ་མཁས་ནས་མིང་བཏགས་པ་དང་བཏགས་པའི་གཞི་གནས་མཐོང་ངམ་སྨྲ་བ་པོ་ལས་ཐོས་པ་ན་ཁོང་དུ་ཆུད་པར་འགྱུར་རོ།",
    "སྐད་བྱིངས་ཁོང་དུ་ཆུད་པར་འགྱུར།",
    "དེ་ལ་ཉེ་བར་བསྒྱུར་བས་ཉེ་བར་བསྒྱུར་ན་ཐེ་ཚོམ་ལེགས་པར་སེལ་བ་ཡིན་ནོ།",
    "གཞན་སེལ་བ་ཡང་ཤེས་པར་འགྱུར།",
    "དགོས་འབྲེལ་ཁོང་དུ་ཆུད་པར་འགྱུར།",
    "སྒྲའི་རྣམ་པས་དོན་གྱི་རྣམ་པ་རྟོགས་པར་འགྱུར་བས་སྤྱིའི་རྣམ་པའི་སྒོ་ནས་ནི་འབྲེལ་པ་ཡིན་ནོ།",
    "རྟོག་པ་དང་མི་ལྡན་བ་དག་ནི་དོན་ཡོད་པར་ཡིད་ལ་བྱ་སྟེ།",
    "སྒྲ་འོ་ཅོག་ལ་མཁས་པར་འགྱུར།",
    "སྒྲ་འོ་ཅོག་ལ་མཁས་པར་འགྱུར་བ་ནི།",
    "ཞེས་བྱ་བ་ནི་དངོས་གཞི་གང་ཞིག་ཤེས་པར་བྱ་བ་དེ་ཉིད་དོན་གྱི་དངོས་གཞི་ཡིན་ནོ།",
    "མིང་ཅན་ཐ་དད་པར་སྟོན་པ་ལྟ་བུ་དང་།",
    "ཞེས་བྱ་བ་ནི་གཞི་མཐུན་པ་ནི་ཁྱད་པར་དང་ཁྱད་པར་ཅན་གྱི་གཞི་ནི་གཉི་ག་ལ་ཐེ་ཚོམ་སེལ་བ་ཡིན་ལ།",
    "ལས་འཛིན་པ་ནི་ཁྱད་པར་གྱི་གཞི་ཡིན་ལ་ཐེ་ཚོམ་ཟ་བ་སེལ་བའི་དགོས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་མཐུན་པ་དགོས་པ་ཐ་དད་པར་སྟོན་པའོ།",
    "ཕྱོགས་གཅིག་མཐུན་པར་སྟོན་པ་རྣམས།",
    "དེ་དག་ཀུན་ཀྱང་སྒྲའི་མིང་ལ་མཁས་ན་ཤེས་པར་འགྱུར་བ་ཡིན་ནོ།",
    "སྦྱོར་བ་ཁ་ཅིག་ནི་ཚིག་སྔ་མའི་དོན་བསྟན་པར་བྱ་བའི་གཙོ་བོ་ཡིན་ནོ།",
    "ཁ་ཅིག་ནི་ཚིག་ཕྱི་མ་བསྟན་པར་བྱ་བའི་དོན་གྱི་གཙོ་བོ་ཡིན་ནོ།",
    "ཁ་ཅིག་ནི་ཚིག་གཉི་གའི་དོན་བསྟན་པར་བྱ་བའི་གཙོ་བོ་ཡིན་ནོ།",
    "ཁ་ཅིག་ནི་དོན་གཞན་བསྟན་པར་བྱ་བའི་གཙོ་བོ་ཡིན་ཏེ།",
    "ས་ཕལ་པ་དག་ལ་མི་གནས་པས་ཤིན་ཏུ་རྙེད་པར་དཀའོ།",
    "གྲུ་ཆེན་པོ་ལེགས་པར་ཟག་ལྷན་བྱས་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཐ་སྙད་དང་རྟོགས་པ་ལ་མི་གནས་པའི་ཕྱིར་ཤིན་ཏུ་རྙེད་པར་དཀའོ།",
    "བདེ་གཤེགས་རིག་པ་གསུམ་དང་རྐང་པར་ལྡན།",
    "རིགས་པས་ཚུལ་བཞིན་གཟུད་པ་བསྒྲུབ་པར་བྱ།",
    "ཕམ་པར་བྱར་མེད་ཕྱོགས་ཉིད་བསྒྲུབ་པར་བྱ།",
    "འཇིག་རྟེན་ཀུན་ལ་ཕན་གདགས་ལེགས་པར་བསྒྲུབ།",
    "རྣམ་པར་གཞོམ་པའི་ཐབས་འདི་བསྒྲུབ་པར་བྱ།",
    "དཔལ་ལྡན་ལུང་ཉིད་འཛིན་པར་བསྒྱུར་བ་བསྒྲུབ།",
    "མ་ལུས་བཞིན་དུ་མནན་པ་བསྒྲུབ་པར་བྱ།",
    "རྣམ་པར་རྒྱལ་བ་ངེས་པར་བསྒྲུབ་པར་བྱ།",
    "ནམ་ཡང་སུས་ཀྱང་མི་གཡོས་བསྒྲུབ་པར་བྱ།",
    "ཨཱ་ཙརྱ་བོདྷི་སཏྭས་གསུངས་པ་མེད་དེ།",
    "སོ་སོའི་བསམ་པ་རྫོགས་པར་འགྱུར་བས་ན་གང་འཇིག་རྟེན་ལས་འདས་པའི་ཕུན་སུམ་ཚོགས་པ་འདོད་ཀྱང་རུང་།",
    "དེ་བཞིན་གཤེགས་པའི་བསྟན་པ་ལ་མཉན་པ་དང་བསམ་པ་དང་གོམས་པར་བྱ་བ་ལས་འདའ་བ་མེད་དོ།",
    "ཡང་དག་པའི་བྱེ་བྲག་གཏན་ལ་དབབ་པའི་གཏན་ཚིགས་སྒྲུབ་པའི་རིགས་པ་ཤེས་པར་བྱའོ།",
    "གཞན་ལ་བདེ་བ་དང་སྡུག་བསྔལ་བར་བྱས་པའི་ལས་ཀྱི་འབྲས་བུ་ཡང་བདེ་བ་དང་སྡུག་བསྔལ་བའི་སྨིན་པ་མྱོང་བ་ལ་དེའི་ནང་ནས་ཀྱང་རྐྱེན་གང་དང་ཕྲད་བ་དེའི་བྱེ་བྲག་ཏུ་འགྱུར་བ་ནི།",
    "སྦམ་པོ་ལ་སོགས་པའི་རིམ་པར་འགྱུར་ཏེ།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ལས་སེམས་དང་སེམས་ལས་བྱུང་བའི་སྐྱེ་བ་ཡང་ནམ་འགོག་པའི་སྙོམས་པར་འཇུག་པའི་ཚེ་ན་ཡང་ལས་ཀྱི་མཚན་ཉིད་བཀག་སྟེ།",
    "འདོད་པ་བྱས་པའི་སྒྲ་དང་།",
    "ཡིད་དུ་མི་འོང་བའི་འབྲས་བུ་རྣམ་པར་སྨིན་པ་དམིགས་པ་ནི་མཐའ་གཉིས་པའོ།",
    "ལྷག་ཆད་མེད་དོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རྣམ་པར་སྨིན་པའི་རྒྱུ་དང་།",
    "འབྲས་བུར་སྨིན་པའི་བར་དུ་དེ་ལ་གནོད་པ་བསྲུང་ཞིང་ཕན་པ་བསྡུ་བའི་ནན་ཏན་གྱིས་རྫོགས་པར་བྱེད་པའོ།",
    "འཕགས་པའི་ས་ཐོབ་པས་གོང་མའི་ས་ཡོངས་སུ་གྲེག་པར་བྱེད་པ་ལ་སོགས་པའོ།",
    "དཔེར་ན་ཤིང་ལྕུག་མ་ལ་སོགས་པར་སྐྱེས་ཕྱིན་ཆང་ལྕུག་མས་ནི་བཅིང་བའི་ལས་བྱེད།",
    "དེ་ལ་དམ་བཅའ་བ་ཞེས་བྱ་བ་ནི་ཇི་སྐད་དུ་སྨྲས་པ་ད་བཞིན་དུ་འབྲས་བུ་དང་བཅས་པར་ཁས་བླངས་པའོ།",
    "གཏན་ལ་ཕབ་པའི་ཡན་ལག་རྣམ་པ་བདུན་དང་ལྡན་པར་བསྟན་པའོ།",
    "འགལ་བ་དང་གྲུབ་པའི་མཐའ་རྫོགས་པར་བྱ་བ་དང་།",
    "སྒྲ་ལ་གང་མཁས་ཀྱིས་བརྒྱ་ཞིང་རྩོད་ན་ནི་འཇིག་རྟེན་གྱི་འགྲན་ཐོར་ཅན་ཁས་བརྒྱ་པར་ཟད་དེ་དོན་མེད་ཀྱིས་ཡལ་གཟུགས་མི་འཁྲ་བར་ཅི་དགར་རྩོད་ཅིག།",
    "ལྷག་མ་གཉིས་ཀྱང་དེ་བཞིན་དུ་ཅི་རིགས་པར་བྱའོ།",
    "ཇི་ལྟར་སྣང་བ་དེ་བཞིན་ཉིད་ལས་གཞན་མ་ཡིན་པར་ཞེན་པའོ།",
    "སྐྱེས་བུ་དང་གང་ཟག་ཏུ་ལྟ་བ་ངན་པར་ཞེན་པའོ།",
    "མེད་པའི་རྒྱུར་སྒྲོ་འདོགས་པ་ནི་སྔོན་རྒྱུ་ལས་མ་སྐྱེས་པའི་རྣམ་པར་ཤེས་པ་ཕྱིས་སྒྱུ་མ་ལྟ་བུར་སྔོན་མ་བྱུང་ཞིང་མེད་པ་ལས་གཟུགས་དང་སྣང་བའི་རྒྱུ་དྲན་པ་སྔོན་དུ་འཇུག་པས་འབྱུང་ཞིང་མེད་པ་ལས་བྱུང་ནས་ཀྱང་འཇིག་པར་འཛིན་པའོ།",
    "མྱ་ངན་ལས་འདས་པ་མ་བྱས་པ་དངོས་པོ་མེད་པར་ཞེན་པའོ།",
    "རྣམ་པར་ཕྱེ་སྟེ་ལུང་བསྟན་པ་དང་།",
    "རྣམ་པར་ཕྱེ་སྟེ་ལུང་བསྟན་པ་ནི།",
    "རྣམ་པར་གྲོལ་བ་ལ་ནི་བྱེ་བྲག་མེད་དེ།",
    "འདི་ལྟ་བུ་ལ་སོགས་ཏེ་སོ་སོའི་མཚན་ཉིད་ལས་སྤྱིའི་མཚན་ཉིད་དུ་འདྲི་བ་ལ་རྣམ་པར་ཕྱེ་སྟེ་བསྟན་ཏོ།",
    "ཕྱིར་དྲིས་ཏེ་ལུང་བསྟན་པ་ནི་ཟླ་མི་སྨོས་པར་བཟང་ཁྱད་ཇི་ཙམ་ཞེའམ།",
    "སྲོག་ཆགས་ཆད་པར་བཅུག་སྟེ།",
    "ཇི་ལྟར་འཕགས་པ་དྲི་མ་མེད་པར་གྲགས་པ་བཞིན་དུ་མི་སྨྲ་བ་དང་།",
    "དེ་ལྟ་བས་ན་དངོས་པོ་མེད་པ་ལས་ཡོད་པར་འཛིན་པ་བཟློག་པར་བྱ་ན་ཡང་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་མེད་དོ་ཞེས་མི་བྱ་བར་ཡོད་པར་འདོད་པ་དེ་རྐྱེན་གང་ལས་གྱུར་པའི་དངོས་པོ་གཞན་ཡོད་པར་བསྒྲུབས་ལ་དེའི་གཏན་ཚིགས་ཀྱིས་བསྟན་ཏོ།",
    "མཚན་གྱི་གཞི་ཡོད་པ་དང་མེད་པ་ལ་མི་རྩོད་པར་མཚན་ཉིད་ལ་རྩོད་པ་ཞིག་ཡོད་ན་ཡང་།",
    "ཕ་ལོགས་སྨྲ་བའི་མཚན་ཉིད་མ་ཡིན་པ་འབའ་ཞིག་ཏུ་མི་སྒྲུབ་པར་མཚན་ཉིད་ཇི་ལྟར་འདོད་པ་དང་།",
    "ནོར་བའི་གཏན་ཚིགས་དང་བཅས་པས་བསྟན་པར་བྱའོ།",
    "བདག་མེད་པ་བསྟན་པར་བྱ་ན།",
    "རྣམ་པར་ཤེས་པའི་རང་བཞིན་ཡིན་པར་མ་རྟོགས་ནས་བདག་ཅེས་བྱ་བ་རྟག་པ་ཁྱབ་པ་གཅིག་པུ་ཞིག་ཡོད་པར་འདོད་པ་ནི་འདི་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "སྒྲིབ་པའི་རྣམ་པ་གང་ལ་རིགས་པས་སྒྲིབ་པར་བྱེད་པ་བསྟན་པ་ལ་སོགས་པའོ།",
    "འཇིག་པར་ཡང་མི་དམིགས་པའི་རིགས་ན།",
    "ཞིག་བར་དམིགས་པ་ལས་ནི་མི་རྟག་པར་ཡང་མངོན་ཏེ།",
    "རྣམ་པ་ལྔར་ཤེས་པར་བྱ་སྟེ།",
    "ཡང་དག་པར་ཤེས་པར་བྱ་བ་ནི་ཕ་ལོགས་གོ་བར་བྱ་བ་ཡང་ཇི་ལྟར་མ་ལོག་པ་ཡང་དག་པའི་དོན་ཉིད་གོ་བར་བྱའོ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་ལུང་གཏན་ལ་ཕབ་པར་བསྟན་པའི་མཚན་ཉིད་དོ་ཞེས་གསུངས་སོ།",
    "སྨྲ་བའི་དོན་འགྲུབ་པ་དང་ཡང་དག་པར་ཤེས་པར་བྱེད་འདོད་པ་ཡང་མངན།",
    "ཡོངས་སུ་དག་པའི་མཚན་ཉིད་དང་ལྡན་པའི་གཏན་ཚིགས་ཀྱིས་ནི་དོན་མ་ལོག་པར་རྟོགས་ཏེ་འགྲུབ་པར་རུང་།",
    "ཡོངས་སུ་མ་དག་པའི་མཚན་ཉིད་དང་ལྡན་པའི་གཏན་ཚིགས་ཀྱིས་ནི་དོན་ལ་ལོག་པར་འཛིན་ཏེ་འགྲུབ་ཏུ་མི་རུང་ངོ།",
    "མཚན་ཉིད་ཀྱི་ཡོན་ཏན་དང་བྱེ་བྲག་མི་ཤེས་པ་ནི་བདག་ཀྱང་ལོག་པར་ལྟ་བ་ལ་གནས་ཤིང་གཞན་ཡང་ལོག་པར་ལྟ་བ་ལ་འཇོག་སྟེ།",
    "ད་ལྟར་བྱུང་བའི་རྣམ་པར་ཤེས་པ་ལྔ་པོ་དག་དང་།",
    "དེས་དྲངས་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་བཅས་པས་དུས་གཅིག་སྤྱོད་ཡུལ་གཅིག་ཏུ་ད་ལྟར་བྱུང་བའི་ཡུལ་ཐད་ཀར་བབ་པ་ལ་དམིགས་ནས།",
    "མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་དང་།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་བཅས་ཏེ་ཡུལ་སོ་སོར་ངེས་པ་ལ་འཇུག་པ་གཅིག་དང་མཉམ་དུ་འཇུག་གམ་ལྔ་ཆར་དང་མཉམ་དུ་འཇུག་ཅེ་ན།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་གཉིས་མཉམ་དུ་འཇུག་སྟེ།",
    "དེ་ལ་ཡངས་པའི་བློ་གྲོས་རྣམ་པར་ཤེས་པ་དང་བཅས་པའི་རྣ་བ་དང་སྣ་དང་ལྕེ་དང་།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་དེ་དང་ལྷན་ཅིག་ཏུ་རྗེས་སུ་འཇུག་པ་དུས་གཅིག་པ་སྤྱོད་ཡུལ་མཐུན་པ་རྣམ་པར་རྟོག་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་འབྱུང་ངོ།",
    "ཡོངས་སུ་ཟད་པར་ཡང་མི་མངོན་ཞེས་གསུངས་སོ།",
    "དགོངས་པ་ངེས་པར་འགྲེལ་པའི་ཡངས་པའི་བློ་གྲོས་ཀྱི་ལེའུ་ལས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ཅིང་རྣམ་པར་ཤེས་པའི་ཚོགས་དྲུག་སྐྱེ་བར་གསུངས་པའི་དོན་འདི་ནི།",
    "རྣམ་པར་ཤེས་པའི་རང་བཞིན་གྱི་ངོ་བོ་ཉིད་དང་།",
    "ཐ་དད་པ་ལས་རྣམ་པར་གྲོལ་བ་ལས་དང་རིགས་ཀྱི་མཚན་ཉིད་དང་།",
    "ཤིན་ཏུ་འབྲེལ་བའི་རང་བཞིན་ངོ་བོ་ཉིད་ཁོང་དུ་མི་ཆུད་པ་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་འཇུག་གོ།",
    "མིག་ལ་ཇི་ལྟ་བ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་གཞན་གྱི་རྐྱེན་བཞི་ཡང་གོང་དུ་སྨོས་པ་བཞིན་ནོ།",
    "སྤུའི་ཁུང་བུ་ནས་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་ལ་བྱའོ།",
    "གཅིག་པ་དང་ཐ་དད་པ་ལས་རྣམ་པར་གྲོལ་བ་ཞེས་བྱ་བ་ནི་འཇུག་པའི་རྣམ་པར་ཤེས་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་ཞེས་བྱ་བ་ནི་མིག་ནས་ལུས་ཀྱི་བར་གྱི་རྣམ་པར་ཤེས་པ་ལྔ་ལ་བྱའོ།",
    "དེ་དག་དང་དེའང་བདག་ཅག་ལྷན་ཅིག་རྒྱུར་གྱུར་པ་ལ་སོགས་པར་མི་སེམས་པ་ནི་དངོས་པོ་ཐམས་ཅད་སེམས་ཙམ་དུ་ནི་མ་རིག་པ་དང་།",
    "རྣམ་པར་ཤེས་པ་ལྔས་རྒུད་པའི་རྐྱེན་བྱས་ཏེ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་དང་།",
    "རྣམ་པར་ཤེས་པ་གཞན་གྱི་མྱོང་བ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ།",
    "འོན་ཀྱང་ཐ་མི་དད་པའི་མཚན་ཉིད་དུ་འཇུག་གོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྣམ་པར་ཤེས་པ་ལྔ་དང་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དེ་དག་ཡུལ་ལ་མཉམ་དུ་ཞུགས་པ་ན་ཤེས་པ་གཉིས་ཀས་ཀྱང་ཡུལ་མཚན་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་ཐ་མི་དད་པར་དམིགས་པ་ལ་བྱའོ།",
    "རྣམ་པར་སྨིན་པའི་སྒྲིབ་པའམ།",
    "བརྩམ་པ་ཡོངས་སུ་དག་པ་ཁོང་དུ་ཆུད་པར་མི་འགྱུར་བའམ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་བསྐང་བ་དང་བྱས་པ་བསྲུང་བ་ཁོང་དུ་མི་ཆུད་པའམ།",
    "གཟུངས་ཀྱི་རྒྱན་གྱི་སྣང་བ་མི་འཐོབ་པར་འགྱུར་བའམ།",
    "ནན་ཏན་ཐམས་ཅད་ལ་ཀུན་དུ་རྒྱབ་ཀྱིས་ཕྱོགས་པར་གྱུར་པའི་འགེབས་པ་ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "ཆོད་པ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཀུན་བརྟགས་པ་སྒྱུ་མ་ལ་སོགས་པར་དམིགས་པ་གང་ཞེ་ན།",
    "ཀེང་རུས་ལ་སོགས་པར་མཐོང་བ་དང་།",
    "ས་ཤ་སྟག་ལ་སོགས་པར་མཐོང་བ་དང་།",
    "རྟགས་ལ་སོགས་པ་དེ་ལ་གནས་པ་ཤེས་པར་བྱ་བ་དང་།",
    "འདས་པ་དང་མ་འོངས་པ་ཤེས་པར་བྱ་བ་ཡོད་དོ།",
    "གང་མངོན་སུམ་གྱིས་དམིགས་པ་དེའི་རྗེས་སུ་འཇུག་པའི་བློས་དེ་དང་འབྲེལ་པའི་དངོས་པོ་མངོན་སུམ་གྱིས་མ་དམིགས་པ་ལ་རྗེས་སུ་དཔག་ཅིང་ཤེས་པར་བྱའོ།",
    "རྗེས་སུ་དཔག་པར་ཤེས་པར་བྱ་བ་ཡང་རུང་།",
    "སྐྱེ་བ་དང་འཇིག་པ་དཔེས་བསྟན་པའི་ནང་དུ་འདུས་པར་ཤེས་པར་བྱའོ།",
    "འཇིག་པའི་གཉེན་པོས་གཞིག་པར་འགྱུར་བ་ནི་སླ།",
    "བརླན་གྱི་གཉེན་པོ་མེ་ལ་ཆུ་བབ་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་མེ་དང་འདུས་བྱས་སུ་ཡང་རིགས་གཅིག་ལ་ཆུ་བླུགས་ན་མེ་འགག་པར་དམིགས་ཤིང་འཇིག་རྟེན་དག་མེ་གསོད་ན།",
    "རྟག་པར་སྣང་བ་དེ་མི་རྟག་པའི་རྒྱུན་ཡིན་པར་བསྟན་པ་ནི་ཆུའི་རྒྱུན་ལ་དང་བ་དང་།",
    "རྗེས་སུ་དཔག་པར་རིག་པ་དང་།",
    "དེ་གསུམ་ལྡན་ན་དོན་ལ་ངེས་པར་བྱས་བ་ནི་དཔེར་ན་སྔོན་གྱི་བྱེ་བྲག་ཞིག་ཐོས་ཏེ།",
    "དེ་ཡིན་པར་ཅིས་མངོན་ཞེས་བྱ་བ་ནི་རྗེས་སུ་དཔག་པ་དང་འདྲ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་ལུང་གཏན་ལ་དབབ་པར་བསྟན་པའི་མཚན་ཉིད་ལ།",
    "རྣམ་པ་འདི་ལྟ་བུ་དག་ནི་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ལུང་གཏན་ལ་དབབ་པར་བསྟན་པའི་མཚན་ཉིད་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ཉིད་ཀྱི་རང་བཞིན་ཡོངས་སུ་དག་པར་རྟོགས་པ་དང་གཉིས་སོ།",
    "བཀྲི་བའི་དོན་དང་ངེས་པའི་དོན་གྱི་བྱེ་བྲག་ཏུ་ཤེས་པར་གྱིས་ཤིག།",
    "སྒྲུབ་པ་དང་བསྒྲུབ་པར་བྱ་བ་ཀུན་ཀྱང་ལུང་དང་སྦྱར་རོ།",
    "ཅིའི་ཕྱིར་ལུང་ཤིན་ཏུ་རྣམ་པར་དག་པ་ཡིན་ཞེ་ན།",
    "དགེ་སྦྱོར་དམིགས་པས་ཐམས་ཅད་མཁྱེན་པའི་མཚན་ཉིད་ལྔར་ཤེས་པར་བྱའོ་ཞེས་གསུངས་པ་འདི་ནི་འབྲས་བུའི་མཚན་ཉིད་བསྟན་པའོ།",
    "ཐམས་ཅད་མཁྱེན་པས་ཅི་ཞིག་མཁྱེན་ཅེ་ན།",
    "ད་ལྟར་བྱུང་བའི་ལས་ཀྱི་རྒྱུ་རྣམ་པར་སྨིན་པ་འཛིན་པ་ཤེས་པའི་སྟོབས་དང་།",
    "རྣམ་པར་འཇོག་པ་དང་།",
    "རྣམ་པར་བྱང་བ་དང་ལྡན་པའི་ཤེས་པའི་སྟོབས་དང་།",
    "ཟག་པ་ཐམས་ཅད་ཟད་པར་ཤེས་པ་ལ་མི་འཇིགས་པ་དང་།",
    "ཁམས་གསུམ་ན་སྤྱོད་པར་སྣང་ཡང་ཏིང་ངེ་འཛིན་གྱིས་མཐུ་ལས་གྱུར་བས་ན།",
    "རྣམ་པར་དག་པའི་ལུང་སྟོན་པ་ཡང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་མཚན་ཉིད་འདི་ལྟ་བུ་ཡིན་པར་ཡང་རྣམ་པར་དག་པའི་ལུང་ལས་འབྱུང་ངོ།",
    "དེ་ལྟར་ཐམས་ཅད་མཁྱེན་པ་དང་ལུང་གཉིས་གཅིག་ལས་གཅིག་ཤེས་པར་རུང་བ།",
    "ཅི་ལ་ཞུགས་པའི་མཐུས་ཤེས་པར་འགྱུར་ཞེ་ན།",
    "མཚན་ཉིད་ལྔས་ཡོངས་སུ་དག་པའོ་ཞེས་གསུངས་ཏེ།",
    "ཡོངས་སུ་དག་པའི་མཚན་ཉིད་ལྔ་ཞེས་གསུངས་པ་རྣམས་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་མཚན་ཉིད་ལྔས་ཡོངས་སུ་དག་གོ་ཞེས་གསུངས་སོ།",
    "རྗེས་སུ་དཔག་པ་ནི་མངོན་སུམ་དུ་མྱོང་བས་དོན་ལ་ངེས་པར་གཞོག་སྟེ།",
    "མཚན་ཉིད་འདི་ལྔས་ཡོངས་སུ་དག་པར་འགྱུར་རོ།",
    "གང་ལ་དོན་རྟོགས་པར་བྱེད་དོ་ཅོག་ནི་ཡོངས་སུ་དག་པའི་མཚན་ཉིད་རྫོགས་པས་རྟོགས་པར་འགྱུར་ཏེ།",
    "མ་བསྒྲིབས་པའི་ཡུལ་ལ་མངོན་སུམ་གྱིས་སྔོན་དུ་དྲངས་པའི་སྟེང་དུ་ཉེ་བའི་རྗེས་སུ་དཔག་པ་ལ་སོགས་པ་མཚན་ཉིད་ལྔས་ཡོངས་སུ་དག་པར་བྱས་པ་ཡིན་ནོ།",
    "དེ་གསུམ་མཐུན་པས་སྒྲུབ་པར་གྱུར་པ་ཡོངས་སུ་གྲེགས་པའི་མཚན་ཉིད་དང་།",
    "སྔ་མ་འགག་པའི་ཕྱིར་མི་རྟག་པ་ཉིད་དུ་རྟོགས་པར་ཁོང་དུ་ཆུད་པ་ནི་ཉེ་བར་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་དོ།",
    "གང་ཐམས་ཅད་མཁྱེན་པས་གསུངས་པ་ཁོང་དུ་ཆུད་པ་ནི་ཉེ་བའི་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་དོ།",
    "དེ་ལྟར་ན་མཚན་ཉིད་ལྔས་ཡོངས་སུ་དག་པའི་མངོན་སུམ་གྱིས་མི་རྟག་པར་ཡོངས་སུ་གྲུབ་པའོ།",
    "གང་ཡང་མི་དམིགས་པས་བདག་མེད་པ་ཉིད་དུ་རྟོགས་པར་ཁོང་དུ་ཆུད་པ་ནི་ཉེ་བའི་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་དོ།",
    "དེ་ལྟར་ན་མཚན་ཉིད་ལྔས་ཡོངས་སུ་དག་པའི་མངོན་སུམ་གྱིས་བདག་མེད་པར་གྲུབ་པའོ།",
    "དེ་ལྟར་ན་མཚན་ཉིད་བཞིས་ཡོངས་སུ་དག་པའི་མངོན་སུམ་གྱིས་སྒྱུ་མ་ལ་སོགས་པ་ཉིད་དུ་ཤེས་པར་གྲུབ་པའོ།",
    "རང་བཞིན་རྟོགས་པར་ཁོང་དུ་ཆུད་དེ།",
    "ཟད་པར་ས་ལ་སོགས་པར་མཐོང་བ་དང་།",
    "འདི་ལྟ་བུ་ལ་སོགས་པར་དམིགས་པ་ནི་མངོན་སུམ་གྱི་མཚན་ཉིད་དོ།",
    "དེའི་ཚེ་སྔོན་མ་བསྒོམས་པ་ནི་འདི་དག་མེད་པ་ལས་བསྒོམས་པའི་མཐུས་བྱུང་བ་ཙམ་དུ་རྟོགས་པར་ཁོང་དུ་ཆུད་པ་ནི་ཉེ་བའི་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་དོ།",
    "དངོས་པོ་མེད་པ་ལ་སེམས་ཀྱིས་བརྟགས་པ་ཙམ་དུ་རྟོགས་པར་ཁོང་དུ་ཆུད་པ་ནི་ཡོངས་སུ་དག་པའོ།",
    "བསྒྲིབས་པའི་ཡུལ་དེ་ལ་གནས་པ་མངོན་སུམ་དུ་དམིགས་པའི་རྗེས་སུ་དཔག་པས་སྔོན་དུ་དྲངས་པའི་སྟེང་དུ་མངོན་སུམ་དུ་མྱོང་བ་ལ་སོགས་པ་མཚན་ཉིད་ལྔས་ཡོངས་སུ་དག་པར་བྱས་པ་ཡིན་ཏེ།",
    "རྟགས་ལ་སོགས་པ་གནས་པ་མངོན་སུམ་གྱིས་དམིགས་པའི་རྗེས་སུ་འཇུག་པའི་བློས་དེ་དང་འབྲེལ་པའི་དངོས་པོ་མངོན་སུམ་གྱིས་མ་དམིགས་པ་ལ་རྗེས་སུ་དཔག་ཅིང་ཤེས་པར་བྱ་བ་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་དང་།",
    "ཉེ་བའི་མཚན་ཉིད་བཞི་པོ་སྐྱེ་བ་ནི་སྐྱེད་པར་བྱེད།",
    "ལས་དང་འབྲས་བུའི་རྣམ་པར་སྨིན་པ་འཕགས་པ་རྣམས་ཀྱིས་མངོན་སུམ་དུ་དམིགས་ཞེས་བྱ་བ་ནི་ཉེ་བའི་མངོན་སུམ་གྱི་མཚན་ཉིད་དོ།",
    "གཞན་གྱིས་ཀྱང་ཆད་པས་བཅད་པ་ལ་སོགས་པ་གནོད་པར་བྱ་བའི་སྡུག་བསྔལ་མྱོང་བ་དང་།",
    "འབྲོག་པ་ཕྱུགས་འཚོ་བ་ལ་བརྩོན་པ་ནི་ཤེ་དང་ཕྱུགས་ཀྱི་ཕུན་སུམ་ཚོགས་པར་འགྱུར་བ་དང་།",
    "གང་འཚོ་སྐྱོང་ཞན་ཅིང་ཕྱུགས་ལ་མིག་ཆེ་བ་ནི་རྐང་འགྲོས་ཀྱིས་ཕོངས་པར་འགྱུར་བ་དང་།",
    "སྡུག་བསྔལ་བ་དང་མཚན་མ་ཐམས་ཅད་ཞི་བའི་མྱ་ངན་ལས་འདས་པ་ཞིག་ཀྱང་ཡོད་པར་འཐད་པ་ནི་ཉེ་བའི་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་དོ།",
    "དེ་ལས་གཞན་དང་མི་མཐུན་པར་དམིགས་པའི་མཚན་ཉིད་དང་།",
    "ཐམས་ཅད་མཐུན་པར་དམིགས་པའི་མཚན་ཉིད་དང་།",
    "ཐམས་ཅད་མི་མཐུན་པར་དམིགས་པའི་མཚན་ཉིད་དང་།",
    "དེ་ལས་གཞན་དང་མཐུན་པར་དམིགས་པ་ཞེས་བྱ་བ་ནི་རྣམ་པ་གཉིས་ཏེ།",
    "འདུས་བྱས་ཀྱི་ཡུལ་གྱི་མཚན་ཉིད་མི་རྟག་པ་ལ་སོགས་པ་ཇི་ལྟ་བ་ལས་རྟག་པ་དང་བདག་ལ་སོགས་པ་གཞན་དུ་དམིགས་ཏེ།",
    "ཕྱིན་ཅི་ལོག་བཞིར་ལྟ་བས་འདུས་མ་བྱས་ཀྱི་མཚན་ཉིད་དང་མཐུན་པར་དམིགས་པ་ལ་སོགས་པའོ།",
    "དེ་ལས་གཞན་དང་མི་མཐུན་པར་དམིགས་པ་ཞེས་བྱ་བ་དེ་ལས་གཞན་ནི་སྔ་མ་བཞིན་ནོ།",
    "མི་མཐུན་པར་དམིགས་པ་ནི་རྣམ་པ་གཉིས་ཏེ།",
    "ཡུལ་གྱི་མཚན་ཉིད་གཞན་དང་མི་མཐུན་པར་དམིགས་པ་ཡིན་ཏེ།",
    "ཐམས་ཅད་མཐུན་པར་དམིགས་པ་ནི་ཡོངས་སུ་མ་དག་པའི་མངོན་སུམ་ཡིན་ནོ།",
    "ཐམས་ཅད་མི་མཐུན་པར་དམིགས་པ་ནི་ཡོངས་སུ་མ་དག་པའི་རྗེས་སུ་དཔག་པ་ཡིན་ནོ།",
    "ལུང་རྣམ་པར་མ་དག་པ་ནི་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་པས་བསྟན་པའི་ལུང་ངོ།",
    "རྣམ་པར་ཤེས་པར་བྱ་བ་ཉིད་དོ་ཞེས་བྱ་བ་འདི་ནི་ཐམས་ཅད་མཐུན་པར་དམིགས་པའི་མཚན་ཉིད་དོ་ཞེས་གསུངས་པ་དེ་ཇི་ལྟར་ཡོངས་སུ་མ་དག་པའི་མངོན་སུམ་ཡིན་ཞེ་ན།",
    "ཐམས་ཅད་མཐུན་པར་དམིགས་པས་ན་ཡོངས་སུ་མ་དག་པའོ།",
    "མངོན་སུམ་གྱིས་མི་དམིགས་སོ་ཅོག་མེད་པར་ལྟ་བ་དང་།",
    "འདི་ལྟ་བུ་དག་ནི་ཐམས་ཅད་མཐུན་པར་དམིགས་པ་ཡིན་ནོ།",
    "འབྲས་བུ་གང་ཞེ་ན་དེས་བསྐྱེད་པར་བྱ་བའོ།",
    "གནས་པ་བརྟན་པར་སྣང་བའོ།",
    "རྒྱུ་ནི་སྲ་བར་རྣམ་པར་རྟོག་པའོ།",
    "འབྲས་བུ་ནི་སྣུམ་པ་དང་མཉེན་པར་གྱུར་པའོ།",
    "ལས་ནི་འཚེད་པར་བྱེད་པའོ།",
    "འབྲས་བུ་ནི་ཚོས་པར་འགྱུར་བའོ།",
    "འབྲས་བུ་ནི་གཡོས་པར་གྱུར་པའོ།",
    "རང་བཞིན་ནི་རྣམ་པར་ཤེས་པའོ།",
    "གནོད་པའམ་གཉིས་ཀ་མ་ཡིན་པར་བྱེད་པའོ།",
    "རང་བཞིན་ནི་ཟག་པ་དང་བཅས་པའི་རྣམ་པར་ཤེས་པའོ།",
    "སྐྱེས་པའི་རང་བཞིན་དུ་མཚུངས་པ་ཡང་ཡོད་པས་ན་རྟགས་མི་མཐུན་པ་ཞེས་ཕན་ཚུན་ངེས་པར་མི་མཐུན་པའི་ནང་དུ་གཞུག་ཏུ་དེ་ལྟར་མི་རུང་ངོ།",
    "ལམ་བགྲོད་པར་བྱེད་པ་ལས་མཐུན་པ་ལ་སོགས་པ་ཡང་ཡོད།",
    "མི་མཐུན་པའི་ཆ་ཡང་ཡོད་པ་ལ་རྣམ་པ་ཐམས་ཅད་མི་མཐུན་པར་དཔག་ཏུ་དེ་ལྟར་མི་རུང་ངོ།",
    "བརྟི་ཀའི་ཚུལ་གསུམ་པའི་རྗེས་སུ་དཔག་པ་ནི་བེའི་ཤེ་ཤི་ཀའི་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་དཔག་པར་བྱ་བ་དང་འབྲེལ་པར་གྲུབ་པ་དེ་དང་ལྡན་པ་ལ་ཡོད་པ་དེ་མེད་པའི་རྟགས་ཀྱིས་རྗེས་སུ་དཔག་གོ་ཞེས་ཟེར་བ་དང་མཐུན་ཏེ།",
    "དེ་ལ་ཡང་ཁྱབ་པར་སྟོན་པས་མི་མཐུན་པར་ཡོད་པ་དང་།",
    "ཕྱོགས་ཀྱི་བྱེ་བྲག་ལ་ལ་ཞིག་ན་བུམ་པ་དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པ་ལས་མ་དམིགས་པའི་ཕྱིར་བུམ་པ་མེད་པར་སྤྱོད་པའི་ཡུལ་དུ་འགྲུབ་སྟེ།",
    "སྒྲུབ་པར་བྱེད་པ་གཉིས་སུ་དབྱེར་མེད་དེ་རང་བཞིན་མི་མཐུན་པ་ཡོད་པ་དང་།",
    "དྲོ་བ་ཙམ་གྱིས་ཚིག་པར་མི་འགྱུར་བས་སྒྲུབ་པ་ལ་མ་ངེས་པ་དང་།",
    "མེད་པར་མ་ངེས་པ་དང་།",
    "དེ་མ་ཡིན་པ་གཞན་དམིགས་པ་ལས་དངོས་པོ་མེད་པ་སྒྲུབ་པ་ཡང་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མངོན་སུམ་གྱིས་མེད་པར་དམིགས་སུ་ཟད་དེ།",
    "བདག་ཅེས་བྱ་བ་ཉིད་ཡོད་པར་མ་གྲུབ་པས་ན་གཞལ་ཞིང་སྒྲུབ་ཏུའང་མི་རུང་སྟེ།",
    "བདག་མེད་པ་ལ་སོགས་པའི་རང་བཞིན་ཡིན་པ་ལས་སྐྱེ་བའི་རྒྱུན་ལ་འདུས་མ་བྱས་རྟག་པ་དང་མཐུན་པ་དང་བདག་ཡོད་པ་ལ་སོགས་པར་དམིགས་ཏེ།",
    "དཔེར་ན་དངོས་པོ་དག་དེ་ཉིད་ཡིན་པར་ངོ་ཤེས་པ་ལས་ན་རྟག་པར་མངོན་ཏེ།",
    "བྲག་དང་རྡོ་རྗེ་བཞིན་ནོ་ཞེས་ཟེར་བ་ལ་སྐྱེ་བོའི་རྒྱུན་ལ་ཡང་འགྱུར་བའི་རྒྱུན་ཆད་པ་ལྟ་བུ་མི་མཐུན་པ་ཡོད་པ་དང་དེ་ཉིད་ཡོད་པར་འཛིན་པ་ཡང་ཆུ་འབབ་པ་དང་།",
    "རྩི་ཤིང་ལ་སོགས་པ་བརྔས་ནས་སླར་སྐྱེས་པ་ལྟ་བུ་མི་རྟག་པ་ལ་ཡང་དེ་ཉིད་ཡིན་པར་འཛིན་པ་ཡོད་དེ་འགྲུབ་པ་ལ་གཅིག་ཏུ་མ་ངེས་པ་དང་།",
    "མངོན་སུམ་གྱི་མཚན་ཉིད་བཞི་དང་སྦྱར་ན་ལ་ལས་ནི་ཁྱབ་པར་དམིགས།",
