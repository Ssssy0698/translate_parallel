    "ལེའུ་བརྒྱད་པ་གཉེན་སྒྲིག་སོགས་སྒྲུང་ཧྲིལ་པོར་ཐད་ཀར་འབྲེལ་བ་ཆེན་པོ་མེད་པའི་བྱུང་རིམ་འདི་དག་སྒྲུང་གི་ཡན་ལག་ཏུ་བྱས་ཤིང་།",
    "ཇག་པའི་གྲས་ཀྱི་ཞོ་དགའ་ཚེ་རིང་དང་སྐྱ་ལོ་བུ་ཆུང་གཉིས་ཀྱིས་འབྲི་གཡག་སུམ་ཅུ་དེད་དེ་གར་སོང་ཆ་མེད་དུ་གྱུར་པའི་དོན་རྐྱེན་འདི་ནི་སྒྲུང་ཧྲིལ་པོའི་གཞུང་སྐུད་དུ་བསྲིངས་ཐུབ་མེད་པ་དང་གཉིས།",
    "མཇུག་རྫོགས་པའི་ལེའུ་དགུ་པ་བསླུ་བྲིད་ཅེས་པའི་ཚན་པར་རྩྭ་ཐང་གི་གནམ་གཤིས་ནི་དེ་འདྲའི་འགྱུར་སླ་བ་ལ་ཨང་ཞེས་རྗོད་པ་བཞིན།",
    "ཁྱོད་བཟང་ང་བཟང་གི་གནས་སྐབས་ཡིན་བཞིན་དུ།",
    "མི་གཤིས་དང་སྒྲུང་གཤིས་གཉིས་ལ་ཅུང་ཟད་མི་འཕྲོད་པའི་སྣང་བ་ཞིག་སྟེར་བ་དང་གསུམ་བཅས་ནི་རང་གིས་ཚར་གཅིག་བཀླགས་པའི་མྱོང་ཚོར་ཙམ་དང་བསམ་འཆར་བརྗེ་རེས་ཙམ་ཡིན་པ་ལས་ཡང་དག་བདེན་ཐུབ་ཡིན་པའི་ངེས་པ་མེད་ན།",
    "བོད་ཡིག་རྩོམ་འབྲིའི་གཞུང་ལུགས་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་ལོའི་ཟླ་པར་པར་དུ་བསྐྲུན།",
    "ཁ་སང་གི་ཚོ་བ་མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་ལོའི་ཟླ་པར་པར་དུ་བསྐྲུན།",
    "ད་ལྟའི་བར་གློག་བརྙན་བགྲང་གིས་མི་ལང་བ་ཞིག་ལ་བལྟས་ཟིན་ཀྱང་།",
    "ཐེངས་དུ་མ་ཞིག་ལ་ཁར་ལག་པ་བཅུག་སྟེ་སྡོད་དགོས་པའི་སྐབས་ཀྱང་བྱུང་དང་འབྱུང་གིན་ཡོད་པས།",
    "ད་རེས་ལས་གྲོགས་ཁ་ཤས་དང་སློབ་བུ་འགའ་རེའི་རེ་བ་འགན་དུ་ཁུར་བ་དང་།",
    "བསམ་བཞིན་དུ་དེ་ལྟར་སྨྲ་མཁན་རེ་འགའ་ལ་རང་སེམས་དྲང་བོས་ཟིན་དགོས་པའི་གཞེན་པ་འདེབས་པའི་ཕྱིར་དང་།",
    "རང་ཉིད་ཀྱིས་རང་གི་མདུན་ལམ་གང་ཞིག་ཏུ་འཐེན་ཡོད་པ་ལ་བསམ་གཞིག་ཅུང་ཙམ་རེ་བྱས་ཏེ་ལམ་དུ་བགྲོད་པའི་ཕྱིར་དུ།",
    "ད་ནི་མུ་གེའི་སྟེང་ལ་ཟླ་ལྷག་ཟེར་བ་ལྟར་གྱུར་སོང་སྙམ་པའི་སྐྱོ་སྣང་ཞིག་ཡིད་ལ་སྨུག་པ་བཞིན་འཐིབས་ནས་བྱུང་བའི་སྒང་ལ།",
    "ཐར་ལོས་དུ་བ་ཞིག་ལ་མེ་བསྒོས་ཤིང་ཆང་དཀར་དམ་བེ་གང་གི་ཁ་ཕྱེ་སྟེ་མགོ་ལ་གཡོན་ཐེངས་གསུམ་བྱས་རྗེས།",
    "དམ་བེ་དེ་ཆང་ལྷག་མ་དང་བཅས་རང་གི་རྒྱབ་ཕྱོགས་ཀྱི་སོ་མ་བརྒྱུད་མ་ཐག་པའི་ལམ་ཁ་ལ་བརྡབས་ཤིང་།",
    "དེ་ནས་ཡང་བསྐྱར་ཅི་ཞིག་དྲན་པའམ་ཅི་ཞིག་གིས་དྲན་གསོས་པའམ།",
    "ཡང་ན་ཡི་ཆད་དམ་དམ་བཅའ་གང་རུང་ཞིག་གི་སྒུལ་ཤུགས་ལ་བརྟེན་ནས།",
    "མ་གཞིར་ཁ་ཆིངས་དཀྲོགས་བྱེད་དུ་ཉོས་པའི་ཤོག་སྦག་ཉིས་གྲག་ཅིག་ཚམ་ཚོམ་ཅི་ཡང་མེད་པར་རང་གི་གཡོན་ལག་གི་ལག་པའི་སྤར་ཁྱིམ་དུ་བསྡམས་ནས་མེ་བསྒོས།",
    "ཐར་ལོ་དེ་ལྟར་མཇུག་རྫོགས་སོང་།",
    "མ་གཞི་སྐྱོ་སྣང་ཞིག་གིས་མནན་འོངས་པའི་ཁར།",
    "ཅི་ཡང་མ་ཤོད་པའམ་ཡང་ན་འཁྲབ་ཁྲིད་པས་བསམ་གཟས་ནས་ཐར་ལོ་འཆི་ལམ་དུ་དྲངས་སོང་བ་ལྟ་བུའི་ངོས་ཟིན་ཞིག་གི་རྗེས་སུ་འཇུག་པ་མང་ལ།",
    "ཐར་ལོས་ཅིས་ཀྱང་རང་སྲོག་རང་གིས་མི་ལེན་ཐུ་མེད་རེད་སྙམ་པའི་གདུང་སེམས་ཤིག་གིས་མནར་མྱོང་ཡོད་པའང་མི་ཉུང་བ་འདྲའོ།",
    "དེ་ནི་དེ་ལྟར་ལགས་ཀྱང་སྲིད་མོད།",
    "ཐར་ལོ་ཅིས་ཀྱང་ལྕེབས་མི་སྲིད་མོད།",
    "ཁོ་ལ་མཐའ་མཇུག་གི་ལམ་བུ་འབའ་ཞིག་ལྷག་ཡོད་པ་ནི།",
    "དེ་ནི་གཙོ་བོ་ཐུན་མོང་གང་རུང་ཞིག་གིས་བསམ་བཞིན་དང་བསམ་བཞིན་མ་ཡིན་པ་ཅི་རིགས་ཀྱིས།",
    "རང་ལས་སྟོབས་ཆེ་བའི་ཐུན་མོང་ཞིག་གི་ཟིལ་ཤུགས་འོག་ནས་རང་གི་ཕུན་ཚོགས་ལ་རྒྱབ་ཀྱིས་ཕྱོགས་ཏེ་རིང་དུ་གྱེས་པའམ།",
    "དེའི་དོད་དུ་གཞན་གྱི་ཕུན་ཚོགས་སུ་བསྙད་པ་དག་བདག་གིར་བྱེད་པའི་གོ་རིམ་ཞིག་གོ།",
    "རལ་ལུ་བཞར་བ་ལ་སོགས་པའི་བྱུང་རིམ་མང་བོ་ཞིག་གིས་སྔ་མོ་ནས་གསལ་ལེར་བསྟན་ཡོད་པར་མ་ཟད།",
    "ཐར་ལོ་གང་གི་རེད།",
    "ལྟད་མོ་པ་མང་བོ་གཙོ་བོ་དྲ་འབུ་ཚོ་འུར་ལངས་ཚུལ་དང་ཀུ་འདེབས་སྟངས་ལ་བསམས་ན།",
    "ཁོང་གི་གསུང་དེ་དག་ནི་ཡུལ་ལུང་གཞན་ཞིག་ནས་རིགས་ཚོགས་གཞན་ཞིག་ལ་ཁ་གཏད་དེ་གསུངས་པའང་རྟོགས་སླ་མོད།",
    "འདི་ཐར་ལོ་མ་རེད་ཕག་ལོ་རེད།",
    "ཁོ་ལས་བསམ་སར་མི་འགྲོ་གསེག་སར་འགྲོ་བ་ཞིག་རེད་ཡ་ཟེར་བ།",
    "ཐར་ལོས་བོད་མི་རིགས་མཚོན་གོ་ཟེར་ན་ཆེ་སོང་བ་རེད་ཟེར་བ།",
    "ཐར་ལོས་བོད་མི་རིགས་ཀྱི་ཞབས་འདྲེན་གྱི་ཆ་མཚོན་གྱིན་ཡོད་པ་རེད་ཟེར་བ་སོགས་སྣ་ཚོགས་ཤིག་ཐོས་པའམ་མཐོང་བའི་མོད་ལ།",
    "ཁོ་བོས་ཐར་ལོ་གང་གི་ཡིན་པ་དེའང་ངེས་པར་བསམ་གཞིག་བྱེད་དགོས་པ་ཞིག་དང་།",
    "ཐར་ལོ་སུ་རེད།",
    "ཐར་ལོ་དེ་བོད་ཅིག་ཡིན་པ་གཞིར་བཞག་གིས།",
    "གློག་བརྙན་ནང་གི་ཐར་ལོ་ནི་འཚོ་བའི་ནང་གི་ཁེར་གཟུགས་ཆུང་ཆུང་ཞིག་ཏུ་ངོས་འཛིན་གྱིན་འདུག་དོན་ལ་དེ་ནི་འཚོ་བ་ཁོ་ནར་ཁ་གཏད་ནས་སྒྱུ་རྩལ་གྱི་བསྐོས་ཐང་བརྗེད་པའི་ཕྱོགས་ལྷུང་ཞིག་རེད་ལ།",
    "ཐར་ལོ་མ་གཞིར་སྒྲུང་གཏམ་ནང་གི་མི་སྣ་ཞིག་རེད་ལ།",
    "འགྲོ་གྲོན་མི་ཉུང་བ་ཞིག་བཏང་ནས་གློག་བརྙན་དུ་ཕབ་པའི་གློག་བརྙན་ནང་གི་སྒྱུ་རྩལ་སྣང་བརྙན་ཞིག་ཀྱང་རེད།",
    "བསྔགས་འོས་སུ་གྱུར་པ་ཡི་བརྗོད་བྱ་དེར་དགོངས་པ་ཟབ་མོ་ཞིག་ཅིས་ཀྱང་ཡོད་དགོས་ལ་ཡོད་ཀྱང་ངེས།",
    "ཐར་ལོའི་ཕམ་ཁ་ནི་དྲང་བོ་དེ་འཁྱོག་པོ་དང་ཕྲད་པའི་ཕམ་ཁ་རེད།",
    "དྲང་བོ་དེ་གནས་སྐབས་སུ་འཁྱོག་པོ་ལས་ཕམ་པའི་སྐྱོ་གར་ཞིག་རེད།",
    "ངག་འཁྱོག་གཡོ་སྒྱུའི་སྨྲ་བ་ཅན།",
    "ཡིད་འཁྱོག་བསླུ་བའི་བསམ་པ་ཅན།",
    "གཡང་འཚོ་ནི་འཁྱོག་པོའོ།",
    "ངེད་ཅག་གིས་བརྗེད་ཟིན་པ་མ་རྟོགས།",
    "ངེད་ཅག་ཐར་ལོ་རེད་ལ།",
    "འུ་ཅག་གཡང་འཚོ་ཡང་ཡིན་ཆོག་ང་ཡིན་ལ་ཁྱོད་ཚོའང་རེད་དོ།",
    "དེ་ཡང་འཐེན་འཁྱེར་ཞིག་དང་རང་ལྟ་མཆོག་འཛིན་ཞིག་མ་ཡིན་ནམ་ཟེར་ནས་དྲི་བ་འདོན་ཡང་སྲིད་མོད།",
    "ངས་དེ་དག་གི་ལན་དུ་ཞུ་འདོད་པ་ནི་རྒྱ་ནག་སྐད་ཀྱི་ཚིག་དུམ་ཞིག་སྟེ་ཞེས་པ་འདི་དང་།",
    "ཐར་ལོའི་གཏམ་རྒྱུད་ནི་ང་ཚོའི་གཏམ་རྒྱུད་ཡིན་ལ།",
    "ཐར་ལོ་ནི་ང་ཚོའི་བསྡུས་གཟུགས་ཡིན།",
    "ང་ཚོ་མི་རབས་ཤིག་གི་བསྡུས་གཟུགས་ཡིན་པདྨ་ཚེ་བརྟན་ཞེས་པ་འདི་གཉིས་ཡིན་ཏེ།",
    "ལོའི་སྦྲང་ཆར་དེབ་དང་པོ་ལས་བདམས་བོད་ཀྱི་དུས་རབས་གསར་བའི་སྙན་ངག་གི་རིན་ཐང་སྣང་ཚུལ་ཐད་ཀྱི་མཐའ་དཔྱོད།",
    "ད་ལྟའི་སྙན་ངག་གི་གནས་བབ་བསྟན་པ།",
    "ཁོ་ཚོས་རེ་སྙེག་བྱེད་སྟངས་ཐལ་དྲགས་པས་ཁོ་ཚོའི་སྙན་ངག་ནི་ཁེད་ལན་མེད་པའི་གབ་ཚིག་ཅིག་ཏུ་གྲུབ་པ་དང་།",
    "དེ་བཞིན་ལོའི་ནོའུ་པེལ་རྩོམ་རིག་བྱ་དགའ་ཐོབ་མཁན་ཨོ་ཁུ་ཐ་ཝེ་ཕ་སིས་སྙན་ངག་ནི་འགྲེལ་མི་རུང་པ་ཞིག་ཡིན་མོད།",
    "དེ་ལྟ་ནའང་གོ་རྟོགས་བྱ་མི་བཏུབ་པ་ཞིག་གཏན་ནས་མིན་ཞེས་པའི་ཟེར་སྲོལ་ལ་དཔག་ན་སྙན་ངག་ནི་རང་གཞན་གཉིས་ཀྱིས་མི་གོ་བ་ཞིག་མིན་པ་ཐག་གིས་བཅད་ཡོད།",
    "སྙན་ངག་གསར་རྩོམ་སྐབས་བསམ་གཞིག་གཙོར་འཛིན་བྱས་པ་མང་དྲགས་ནས་རང་བྱུང་གི་ཚོར་བ་དེ་ཉིད་རྩ་བརླག་ཏུ་བོར་པ་དང་ཡང་ན་རྩ་བ་ནས་མི་མཐོང་།",
    "སྣང་ཚུལ་འདི་ངས་ད་ལྟའི་སྙན་ངག་གི་གནས་སྟངས་ཤིག་རེད་འདོད་དོ།",
    "མི་དམངས་མང་ཚོགས་ཀྱི་སེམས་ཁམས་དང་འཕྲོད་པ།",
    "རང་གི་འདོད་པ་ཙམ་དང་།",
    "མིང་དོན་ཙམ་སོགས་ལ་དམིགས་པ་རྒྱུག་ཆེ་བས་ད་ལྟའི་ང་ཚོའི་སྙན་ངག་གི་རིན་ཐང་དེ་ཡང་ལོ་རེར་ཇེ་ཞན་དང་ངོ་བོ་གཞན་ཞིག་ཏུ་འགྱུར་བཞིན་ཡོད་པར་མཐོང་།",
    "སྙན་ངག་ཟེར་ན་གཞན་གྱི་མཐོང་ཆུང་བྱེད་ཡུལ་ཞིག་ཏུ་ངོས་བཟུང་ཡོད་པ་ཡང་མ་གཞི་སྙན་ངག་དེ་དག་གི་བསྟན་དོན་རྒྱ་ཆུང་བ།",
    "རང་གི་དགའ་སྐྱོ་ཆགས་སྡང་ཙམ་ལས་གྱེས་ཐུབ་མེད་པ།",
    "ད་ལྟའི་སྙན་ངག་གི་རིན་ཐང་ཐད་ཀྱི་སྣང་ཚུལ་གསེད་བཀྲོལ།",
    "ད་ལྟའི་སྙན་ངག་གི་རིན་ཐང་དེ་ལོ་རེ་ནས་ཇེ་ཞན་ཡིན་པ་རྩོམ་རིག་བྱ་དགའ་ཞིག་དང་སྦྲགས་ཏེ་འཆད་ན་འོས་ཤིང་འཚམ།",
    "སྐབས་གཉིས་པའི་གངས་རྒྱན་མེ་ཏོག་གི་རྩོམ་རིག་བྱ་དགའ་ཐོབ་པའི་སྙན་ངག་དག་ལ་མཚོན་ན་ཀློག་མཁན་རྣམས་ཀྱིས་གདེང་འཇོག་མི་མཐོ་བ་དང་ཡང་ན་དོ་སྣང་མི་བྱེད་པར་མ་ཟད།",
    "ཀློག་མཁན་རྣམས་ལ་བག་ཆགས་ཟབ་མོ་ཐེབས་མེད།",
    "སྙན་ངག་དེ་དག་གིས་བོད་ཀྱི་རྩོམ་སྟེགས་སུ་ཤུགས་རྐྱེན་ཆེར་འཇོག་ཐུབ་མེད།",
    "དཔེར་ན་འབྲོང་གི་སྙན་ངག་སྟེ་ལྷ་ས།",
    "ཀློག་པ་པོ་དག་གི་སེམས་ཀྱི་ན་ཟུག་གང་ཞིག་མཚོན་ཡོད་པས།",
    "སྐབས་གཉིས་པའི་གངས་རྒྱན་མེ་ཏོག་གི་རྩོམ་རིག་བྱ་དགའ་ཐོབ་པའི་སྙན་ངག་སྟེ།",
    "མི་སྐྱིད་གླིང་གི་སེམས་ངལ་སེམས་ཀྱི་འབབ་ཚིགས་སོགས་ལ་ཀུན་གྱིས་གདེང་འཇོག་དམན་པར་མ་ཟད།",
    "སྐབས་གཉིས་པའི་གངས་རྒྱན་མེ་ཏོག་གི་རྩོམ་རིག་བྱ་དགའ་ཐོབ་པའི་སྙན་ངག་དེ་དག་གི་རིན་ཐང་དང་དེས་ཀློག་པ་པོར་བྱིན་པའི་བག་ཆགས་ནི་ཆེས་སྤྱིར་བཏང་བ་ཞིག་དང་།",
    "སྙན་ངག་དེ་དག་ལ་ཡང་བསྐྱར་བལྟས་ཀྱང་ཡིད་སྒུལ་མི་ཐུབ་ལ་བཀླགས་ཚེ་སུན་སྣང་ཞིག་གིས་མནར་འོངས་པའི་ཚུལ་འདིས་སྙན་ངག་གི་རིན་ཐང་རིམ་གྱིས་རྒུད་བཞིན་པའི་སྣང་ཚུལ་བསྟན་པ་ཡིན།",
    "དེ་བཞིན་སྐབས་གསུམ་པའི་གངས་རྒྱན་མེ་ཏོག་གི་རྩོམ་རིག་བྱ་དགའ་ཐོབ་པའི་སྙན་ངག་སྟེ།",
    "རུས་རྐང་གི་མཆོད་མེ་དང་།",
    "གུ་གེའི་གནའ་ཤུལ་གྱི་ངོས་གསུམ་སྐབས་བཞི་པའི་གངས་རྒྱན་མེ་ཏོག་གི་རྩོམ་རིག་བྱ་དགའ་ཐོབ་པའི་སྙན་ངག་ལྷུ་བ་སོབ་སོབ་དང་།",
    "སྤྱིར་གངས་རྒྱན་མེ་ཏོག་གི་རྩོམ་རིག་བྱ་དགའི་བྱ་འགུལ་འདི་ཐེངས་བཞི་ཙམ་ལ་སྤེལ་མོད།",
    "སྙན་ངག་གི་རིན་ཐང་དེ་སྐབས་གཉིས་པ་ནས་ཇེ་སྡུག་ཏུ་གྱུར་དང་འགྱུར་བཞིན་པ་མངོན་གསལ་རེད།",
    "ཐ་ན་སྙན་ངག་རེ་གཉིས་ནི་གནས་སྐབས་རིང་རྒྱུག་ཆེ་བའི་གླུ་གཞས་རིགས་ནང་བཞིན་ཚོར་བ་རགས་ཙམ་ཡང་སྟེར་མི་ཐུབ།",
    "སྙན་ངག་གི་རིན་ཐང་མར་རྒུད་བཞིན་པ་འདི་ཕྱོགས་གཅིག་ནས་མི་མང་པོས་ཐ་སྙད་འཁོལ་སྟངས་དང་རྒྱན་སྦྱོར་ཚུལ།",
    "བརྗོད་བྱའི་སྲོག་ལ་རེག་ཐུབ་མི་འདུག་སྙམ་པའི་སྣང་བ་ཞིག་སྦྱིན་འོང་ཟེར་བ་དེ་དོན་དངོས་སུ་སྣང་།",
    "ལབ་བརྡོལ་ཚིག་གི་ཉོག་སྙིགས་ཙམ་ལས་འཐོབ་བྱ་ཅི་ཡང་མེད་ཟེར་བ་ད་ལྟ་ང་ཚོའི་རྩོམ་སྟེགས་དངོས་དང་འཕྲོད།",
    "ད་ལྟའི་སྙན་ངག་པ་རྣམས་དང་ཡང་ན་ཁོ་ཚོའི་སྙན་ངག་ལ་སྔོན་གྱི་སྙན་ངག་པ་དང་ཁོང་ཚོའི་སྙན་ངག་ཇི་བཞིན་གྱི་གོ་བབ་དང་རིན་ཐང་དེ་ལྟ་བུ་མེད་པར་གྱུར་འདུག་དེའི་རྒྱུ་རྐྱེན་ནི།",
    "ལྷག་དོན་སྙན་ངག་ནི་རྩེད་སྤྱད་ཅིག་ཏུ་བསྒོམས་ནས་ཡི་གེའི་རོལ་རྩེད་གཉེར་མཁན་ཡང་མང་པོ་བྱུང་བས་རེད།",
    "རང་རེའི་ད་ལྟའི་སྙན་ངག་དག་ལ་འཁྱུག་ཙམ་བལྟས་ན།",
    "ཁོ་བོར་ཚོར་བ་རྨ་མེད་ཅིག་སྐྱེས་པ་ནི་སྙན་ངག་ཏུ་བསྙད་པ་ཕལ་ཆེ་བ་ནི་རབ་བཏགས་དང་རྟོག་བཟོ་དང་བློ་བཅོས་དང་འཆར་ཡན་དང་འུད་བརྗོད་དང་ཁ་ཤོམ་གྱིས་ཕྱུར་བུར་གཏམས་པ་ཏག་ཏག་རེད།",
    "ད་ལྟ་ང་ཚོའི་སྙན་ངག་གི་རིན་ཐང་ནི་འགག་སྒོ་ཞིག་གི་མེ་མཚམས་ན་གནས་ཡོད།",
    "རྩོམ་རིག་གི་ལམ་ཁར་འཇུག་མཁན་སྔོན་མ་དང་བསྡུར་ན་ཇེ་ཉུང་དུ་ཕྱིན་ཡོད་པ་མངོན་སུམ་དུ་མཐོང་།",
    "འཇུག་མཁན་ཁ་ཤས་ཡོད་པའང་དམིགས་ཡུལ་མག་མོག་ཅན་དག་ལས་མ་འདས།",
    "རྩོམ་རིག་གི་ལམ་འདིར་ནན་ཏན་གྱིས་འཇུག་མཁན་རེ་འགའ་མ་གཏོགས་མེད་ཅིང་།",
    "རྩོམ་རིག་གི་དགོངས་པ་ལྟར་ན་རྩོམ་རིག་གིས་མི་ལ་སྤྲོ་བ་སྟེར་ཐུབ་པ།",
    "རྩོམ་རིག་གི་འགན་འཁྲི་ཤིན་ཏུ་ནས་གཅེས་སུ་འཛིན་དགོས་པས་རོལ་རྩེད་རིང་ལུགས་ལས་གྱེས་དགོས།",
    "ང་ཚོས་ཅིའི་ཕྱིར་དུ་སྙན་ངག་འབྲི་བ་ཡིན་ནམ།",
    "ནུབ་གླིང་གི་རིག་རྩལ་བསྐྱར་དར་དུས་སྐབས་ཡིན་ནའང་འདྲ།",
    "རྨོངས་གཉིད་ལས་སློང་བྱེད་ལྟ་བུ་ཞིག་བློ་ཡི་སྒོ་མོ་འབྱེད་བྱེད་ལྟ་བུ་ཞིག་ཉི་འོད་ཀྱི་ཟེར་མ་འདྲེན་བྱེད་ལྟ་བུ་ཞིག་ཡིན་འདུག་ཅེས་པ་ལས་ཀྱང་རང་གི་དོན་དག་གམ་རང་གི་རོལ་རྩེད་ཙམ་ཞིག་མིན་པ་ཤེས་ཐུབ་བོ།",
    "མི་ལ་ཡར་བསྐྱེད་དང་སྐུལ་སློང་གི་ནུས་པ་ལྟ་ཅི།",
    "ཐ་ན་ང་ཚོའི་མི་རབས་རྗེས་མ་རྣམས་ཀྱིས་ཉེན་ཁའི་ཞྭ་མོ་ཞིག་མི་གྱོན་པའི་ངེས་པ་མེད།",
    "ཡང་ང་ཚོའི་ན་གཞོན་རྣམས་ཀྱིས་སྙན་ངག་ལ་གསར་གཏོད་བྱ་དགོས་ཟེར་བཞིན་འུར་ལངས་བཞིན་ཡོད་མོད།",
    "མིའི་བསམ་བློ་འཁྱེར་སོ་དང་རྒྱབ་འགལ་དུ་སོང་བའི་ཡ་མ་བརླའི་སྙན་ངག་སྟེ།",
    "འདི་དག་དང་འགལ་བའི་ཚིག་གི་གསར་གཏོད་ཅིག་གང་དུའང་མེད་ལ།",
    "སྙན་ངག་གི་དོན་གྱི་ཆ་ནས་ཀྱང་མི་རིགས་ཤིག་གམ།",
    "སྤྱིར་ན་སྒྱུ་རྩལ་གྱི་རིགས་ལ་མཐའ་དང་རྩེ་མོ་མེད་པས་སྙན་ངག་ཀྱང་འདི་འདྲ་ཞིག་ཡིན་དགོས་ཤིང་།",
    "ཀན་འདྲ་ཞིག་འཁྱོངས་དགོས་པའི་སྡོམ་ཚིག་འགོད་མི་རུང་མོད།",
    "སྙན་ངག་འབྲི་བ་རྣམས་ཀྱིས་ཀྱང་སྙན་ངག་ནི་རང་གི་རོལ་རྩེད་ཅིག་དང་།",
    "ཚིག་གི་འཁྲབ་སྟོན་ཞིག་རང་ཉིད་སྒྲོག་བྱེད་ཅིག་སྣང་བ་འདྲེན་བྱེད་སྤྱིར་བཏང་བ་ཞིག་ལ་ངོས་མི་འཛིན་པར།",
    "ཐ་སྙད་བཀོལ་སྟངས་སོགས་མང་ཚོགས་བྱིངས་ཀྱི་སྐད་ཆར་གཏུགས་ཅི་ཐུབ་གྲོང་ཚིག་ལ་མཉམ་འཇོག་དགོས་བྱེད་པ་ལས་བོད་བྱིངས་ཀྱི་སྐད་ཆའི་བརྡ་སྤྲོད་ཀྱི་ལུགས་དང་འགལ་བ་དང་རྒྱན་གྱི་ཁུར་མང་བ།",
    "སྤྱིར་སྙན་ངག་གི་མཛེས་པ་དེ་གབ་སྦས་ཀྱི་ཆ་དང་།",
    "གསར་རྩོམ་བྱེད་དུས་གལ་ཆེ་བའི་ཡོ་བྱད་ཅིག་ཡོད་པ་ནི་སྐད་ཆ་རེད།",
    "ང་ཚོ་སྙན་ངག་རྩོམ་མཁན་རྣམས་ཀྱིས་བརྗོད་དོན་རྫོགས་པར་སྟོན་ལ་ཚིག་ཉག་ཉོག་མ་ཡིན་པར་གང་བརྗོད་བྱའི་དོན་རྣམས་ཚིག་གིས་བདེ་བླག་ཏུ་སྟོན་པ།",
    "ང་ཚོས་སྙན་ངག་པ་ཟེར་བའི་ཆོ་ལོ་འདི་ལ་བསྐྱར་དུ་དོགས་སློང་དང་བསྐྱར་དུ་གོ་བ་ལེན་དགོས་པར་མ་ཟད།",
    "སྙན་ལ་མཆི་མ་འཆོར་བ་ལྟ་བུའི་སྙན་ངག་གསར་རྩོམ་བྱ་རྒྱུ་དེ་གལ་ཆེན་པོ་རེད།",
    "ང་ཚོའི་རྩོམ་པ་པོ་རྣམས་ལ་མཚོན་ནའང་རང་གི་མི་ཚེ་ལ་བཀྲག་མདངས་རེ་ཡོད་ན་དེ་ནི་རྩོམ་རིག་ཅེས་པའི་རླབས་ཆེ་བའི་འཕྲིན་ལས་འདི་ཡི་དྲིན་ཡིན་པས་ང་ཚོས་གསར་རྩོམ་བྱེད་དུས་ཀྱང་གཟབ་ནན་བྱ་རྒྱུ་ནི་དོན་བཟང་ཞིག་ཏུ་མཐོང་དགོས་པར་སེམས།",
    "བོད་ཀྱི་རྩོམ་པའི་རྣམ་གཞག་གི་ཤེས་བྱ་གཅེས་བཏུས་བོད་ལྗོངས་བོད་ཡིག་དཔེ་རྙིང་དཔེ་སྐྲུན་ཁང་།",
    "བསམ་གཞིག་གི་ཁ་དོག་ཀན་སུའུ་མི་རིགས་དཔེ་སྐྲུན་ཁང་།",
    "བསམ་གཞིག་གི་ཁ་དོག་ཀན་སུའུ་མི་རིགས་དཔེ་སྐྲུན་ཁང་།",
    "གངས་རྒྱན་མེ་ཏོག་རྩོམ་སྒྲིག་ཁང་གིས་བསྒྲིགས།",
    "གངས་རྒྱན་མེ་ཏོག་རྩོམ་སྒྲིག་ཁང་གིས་བསྒྲིགས།",
    "བོད་ཀྱི་རྩོམ་པའི་རྣམ་གཞག་གི་ཤེས་བྱ་གཅེས་བཏུས་བོད་ལྗོངས་བོད་ཡིག་དཔེ་རྙིང་དཔེ་སྐྲུན་ཁང་།",
    "མཐའ་དཔྱོད་བྱེད་མཁན་རང་གི་ཐུན་མོང་མ་ཡིན་པའི་མྱོང་རྟོགས་ཟབ་མོ།",
    "ད་དུང་མྱོང་རྟོགས་ཤིག་གི་ཐད་ནས་དཔྱད་དགོས་ཏེ།",
    "རང་གི་ཐུན་མོང་མ་ཡིན་པའི་མཛེས་དཔྱོད་ཀྱི་ལྟ་བ་དང་།",
    "བསམ་བློ་བརྗེ་རེས་དང་།",
    "དེ་ནི་ཏག་ཏག་སྒྱུ་རྩལ་རྩོམ་རིག་གི་ཆ་ནས་ཡོད་དགོས་པའི་ཟད་མི་ཤེས་པའི་མཛེས་པ་ཞེས་པ་དེ་ཡིན།",
    "གཉིས་ནས་བསམ་བློ་གཉིས་བརྗེ་རེས་དང་བགྲོ་གླེང་བྱེད་པ་ནི།",
    "དེ་ལས་གོང་གི་རིན་ཐང་གསར་བ་དང་།",
    "བསམ་བློ་དེ་ནི་མི་ཞིག་གི་ཐུན་མོང་མ་ཡིན་པའི་མཚོན་བྱེད་ཅིག་ཡིན་ལ།",
    "མི་གཤིས་ཀྱི་ཟབ་ས་ཞིག་ཀྱང་རེད།",
    "ཡང་རང་རེའི་རྩོམ་རིག་མཐའ་དཔྱོད་དེ་དུས་ཡུན་རིང་བོ་ཞིག་གི་ནང་།",
    "འོན་ཏེ་བོད་ཀྱི་རྩོམ་རིག་གསར་བ་དར་ཏེ་མི་ལོ་སུམ་ཅུ་ལྷག་ཙམ་སོང་བའི་རྗེས།",
    "ང་ཚོས་གོང་གི་མཐའ་དཔྱོད་བྱེད་ལུགས་དེ་ཉིད་རྨང་གཞིར་བཟུང་སྟེ།",
    "དེ་ལས་སྒྱུ་རྩལ་རྩོམ་རིག་རང་གི་ངོ་བོ་ཉིད་དང་མཐུན་པའི་མཐའ་དཔྱོད་བྱེད་པའི་ལམ་བུ་གཞན་ཞིག་འདོད་པའི་ཐད་ལ་བསམ་གཞིག་བྱེད་པ་དེའང་།",
    "དུས་རབས་ཀྱིས་ཀྱང་ང་ཚོར་བཏོན་པའི་རེ་བ་ཉག་ཅིག་རེད།",
    "དེ་ཙམ་གྱིས་དེ་ནི་རྩོམ་རིག་གི་ཡོད་ཚད་དེར་གཏུགས་དགོས་པའི་ངེས་པ་མེད་དེ།",
    "དེ་ནི་རྩོམ་རིག་གི་འབྱུང་ཁུངས་ཙམ་དང་རྩོམ་རིག་གི་ནང་དོན་ཙམ་ལས།",
    "རྩོམ་རིག་དངོས་སུའམ་མཐར་ཐུག་གི་བགྲོད་སའི་དམིགས་ཡུལ་དེ་མིན།",
    "མཐར་ཐུག་གི་དམིགས་སའི་ཡུལ་དེར་དཔྱད་པ་དང་སྔོག་འདོན་གཏིང་ཟབ་བྱེད་དགོས་པ་ལས།",
    "བསམ་གཞིག་གི་མཚོན་ཆ་ཐོགས་པའི་མི་ཞིག་ཡིན་པ་ལས།",
    "དེ་ནི་བསམ་བློ་རེད།",
    "ཚེ་སྲོག་གི་དུངས་པ།",
    "ཚེ་སྲོག་གཅིག་གིས་ཚེ་སྲོག་གཞན་ཞིག་ཉམས་སུ་མྱོང་བ་དང་།",
    "བླ་སྲོག་གཅིག་གིས་བླ་སྲོག་གཞན་ཞིག་ལ་གཟབ་ཉན་བྱེད་པའང་ཡིན།",
    "མཐའ་དཔྱོད་བྱ་ཡུལ་དེ་ལས་རང་དགར་སྒྲུབ་བྱེད་ཙམ་བཙལ་ཏེ་གཞུང་ལུགས་སམ་ལུང་གང་རུང་ཞིག་ལ་སྐྱབས་སུ་སོང་བའི་བསྒྲུབ་བྱ་གང་དེ་བསྒྲུབས་པ་ཙམ་ཞིག་ཡིན་པས།",
    "མཐའ་དཔྱོད་དེའི་རིགས་འཆི་ལམ་དུ་སོང་བར་གདུང་སེམས་བྱེད་དོན་མེད་ཅེས་གསུངས།",
    "ཡང་བསམ་གཞིག་གི་རྒྱུ་དེ་མུ་མཐུད་དུ་བསྐྱེད་ན།",
    "ང་ཚོས་རྩོམ་རིག་མཐའ་དཔྱོད་བྱེད་ཐབས་གང་མང་ཞིག་སྤྱད་དེ་ཉུང་ཤས་ཤིག་གིས་སེམས་ཁམས་དབྱེ་ཞིབ་དང་།",
    "མཐའ་དཔྱོད་ཀྱི་ལག་ལེན་ནང་དུ་ངེས་པར་ཡོད་དགོས་པ་ཞིག་རེད།",
    "དེ་དག་གི་ཐོག་ནས་ར་སྤྲོད་མ་ཐུབ་ཚེ།",
    "བདག་གིས་འཚོལ་སྡུད་བྱས་པ་བརྒྱུད་སྒྲུང་གཏམ་འདིར་བོད་ཡིག་གི་ལམ་ནས་མཐའ་དཔྱོད་བྱས་པ་ཁྱོན་བཅུ་གྲངས་ཤིག་འདུག་ཅིང་།",
    "གོ་བ་དེ་རང་གི་མྱོང་བ་དང་སྤེལ་མའི་ཚུལ་དུ་བྲིས་ཡོད་པས།",
    "འོན་ཏེ་མཐའ་དཔྱོད་དེའི་རིགས་ལ་གཞུང་ལུགས་ཀྱི་རྒྱབ་རྟེན་མེད་མོད།",
    "དེ་ནི་མཐའ་དཔྱོད་ཀྱི་གཞུང་ལུགས་གཞན་ཁོང་དུ་ཆུད་པ་རྣམས་ཀྱིས་སྔོག་འདོན་ཅུང་བྱེད་དཀའ་བ་ཞིག་རེད།",
    "བསམ་གཞིག་གི་ཁ་ཕྱོགས་ཤིག་དང་རང་ཚུགས་ཀྱི་མི་གཤིས་ཤིག་གི་ཕྱོགས་སུ་ཁྲིད་སྟོན་གནང་བས།",
    "བྱེ་བྲག་ཁོང་གིས་གཙུག་གཡུ་ཡི་སྐོར་ལ་མཐའ་དཔྱོད་གནང་སྐབས།",
    "དེར་ཤེས་བྱ་ཕུན་སུམ་ཚོགས་པོ་ཞིག་དང་འཚོ་བར་འཛིན་པའི་ལྟ་བ་ཐུན་མོང་མ་ཡིན་པ་དང་།",
    "ནང་གི་བླ་སྲོག་ཞན་སོང་ལ།",
    "དེར་གསར་གཏོད་དང་རེ་བའང་བཏོན་གནང་མཛད་ཡོད།",
    "སྔར་བཞིན་མཐའ་དཔྱོད་ནང་དུ་རང་གི་ལྟ་བ་དང་གསར་གཏོད་ཀྱི་ཆ་དེ་ཅུང་མི་འདང་ཞིང་།",
    "བདེ་སྐྱིད་ཀྱི་འཚོ་བ་བཅས་ལ་རེ་སྙེག་བྱེད་པར་མ་ཟད།",
    "འོན་ཏེ་དཔྱད་རྩོམ་དེའི་ནང་དུ་བོད་མིའི་ཕྱིར་མི་ལྡོག་པའི་དད་སེམས་ཀྱི་ཐད་ནས་སྒྲུང་གཏམ་ནང་གི་མི་དང་མིའི་བར་གྱི་འབྲེལ་བར་རྟོག་འཇུག་གནང་བ་དེར་དགེ་མཚན་ཆེ་བར་མཐོང་སྟེ།",
    "ཅུང་གཏན་འཇགས་ཡིན་པའི་མི་རིགས་ཤིག་གི་སེམས་ཁམས་ཀྱི་ཐད་ནས་སྒྲུང་གཏམ་ལ་དཔྱད་པ་གནང་ཡོད་པས།",
    "གོང་གི་དེ་དག་དང་ཕལ་ཆེར་གཅིག་མཚུངས་སུ་གྲུབ་སྟེ།",
    "འགའ་རེ་ནི་ཀློག་འགྲེལ་ཙམ་དང་།",
    "ཕྲན་ཡིག་ཚོགས་ལ་འཇིགས་ཏེ་རེ་རེ་བཞིན་དཔེར་འགོད་པའི་ངལ་བ་མ་བྱས།",
    "གཙུག་གཡུ་ལ་གོང་གི་མཐའ་དཔྱོད་བྱེད་སྟངས་དེའི་རིགས་ནི།",
    "བསམ་བཞིན་དང་བསམ་བཞིན་མ་ཡིན་པར་ང་ཚོའི་བསམ་བློར་ཉེ་ལམ་གོམས་འདྲིས་སུ་སོང་བའི་རྒྱུ་གཉིས་འགལ་བའི་ལྟ་བ་སྔོན་དུ་སོང་བ་གཞིར་བཅས་པ་ཡིན་ཞིང་།",
    "གྲལ་རིམ་དེ་ལས་བྱུང་བའི་འདུ་ཤེས་ཁག་གི་སྣང་ཚུལ་དག་རིམ་པར་འཕྲོས་ཤིང་ཕྱུང་བས།",
    "གསར་རྙིང་གི་དབྱེ་བས་གསལ་ཁ་བཅད་པས།",
    "སྤྱིར་ན་མི་བདེན་པ་མེད་མོད།",
    "གཅིག་ནས་བསམ་གཞིག་བྱེད་སྟངས་གཅིག་གྱུར་ཅིག་གི་ཐོག་ཏུ་འགྱུར་བའི་ཉེན་ཁ་ཆེ་བར་སེམས།",
    "མཐའ་དཔྱོད་བྱེད་མཁན་རང་རང་གི་མཛེས་དཔྱོད་ཀྱི་ལྟ་བ་དང་།",
    "རྩོམ་རིག་གིས་མཚོན་དགོས་ངེས་ཀྱི་མི་གཤིས་ཀྱི་ཟབ་སར་འཇུག་མི་ཐུབ་པའི་ཉེན་ཁ་ཡོད་པས་ཡིན།",
    "སླར་ཡང་ང་ཚོས་དཔེ་མཚོན་གྱི་ཐོག་ནས།",
    "ལུགས་སྲོལ་རྙིང་བའི་ནག་ཉེས་ལ་དགག་རྒྱག་གིས།",
    "དུས་རབས་གསར་བའི་ཕོ་མོ་ཚོས་བརྩེ་དུངས་རང་མོས་ལ་སྙེག་ཚུལ།",
    "གཙོ་བོ་དེ་ལ་སུན་འབྱིན་དང་དགག་རྒྱག་གི་ཆར་ཡོད་པར་བསྒྲུབས་ཡོད་པ་ཡིན།",
    "མཐའ་དཔྱོད་བྱེད་ཐབས་དེ་གཉིས་ཀྱིས་རང་རེའི་རྩོམ་རིག་གསར་རྩོམ་དང་།",
    "རྩོམ་རིག་གི་གཞུང་ལུགས་འཐུས་ཚང་དུ་གཏོང་བར་ནུས་པ་འགངས་ཆེན་ཐོན་ཡོད།",
    "ང་ཚོས་དེ་ལས་གཞན་པའི་མཐའ་དཔྱོད་བྱེད་ཐབས་གཞན་པར་སློབ་སྦྱོང་དང་ལག་ལེན།",
    "དེ་བཞིན་རང་ཉིད་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་རྩོམ་རིག་གི་མཐའ་དཔྱོད་བྱེད་ཐབས་ཤིག་བཙལ་རྒྱུ་ནི་ཧ་ཅང་གལ་འགངས་ཆེན་པོ་ཡིན་ཏེ།",
    "དེས་བོད་ཀྱི་གནའ་དེང་གི་རྩོམ་རིག་ལ་མཐོངས་རྒྱ་ཡངས་པོ་དང་།",
    "ང་ཚོས་རང་རང་ལ་འཚམ་པའི་མཐའ་དཔྱོད་ཀྱི་རྒྱུན་ཞིག་འཚོལ་དགོས་ན།",
    "དེས་རང་ལ་ཐབས་ལམ་གསར་བ་དང་བསམ་གཞིག་གི་སྒོ་མོ་འབྱེད་པར་ཕན་ཐོགས་ལྡན།",
    "ང་ཚོས་ངེས་པར་རྩོམ་རིག་གི་རྒྱུན་ཏེ།",
    "འགའ་ཞིག་ན་རེ།",
    "གོང་གི་གྲོས་འཆར་དེ་ཧ་ཅང་རབ་རིབ་དང་མག་མོག་ཙམ་མམ།",
    "ཡང་ན་དོན་གྱི་སྣེ་མོ་དྲངས་པ་ཙམ་ལས།",
    "མིའི་ཚེ་སྲོག་དང་ཚེ་སྲོག་གི་རིན་ཐང་ལས་གྲུབ་པའི་དུས་ཚོད་དེ་རེད།",
    "ཚེ་སྲོག་གི་དུས་ཚོད་དེ་གལ་ཆེན་ཡིན་ཚུལ་གྱི་ཐད་ནས།",
    "ནམ་མཁའི་གློག་རི་གཟར་རྦབ་ཆུ་ལྟ་བུ་ཐམས་ཅད་མི་རྟག་པ་དང་སྐད་ཅིག་མ་ཞིག་གི་སྟེང་དུ་ཚུགས་ཡོད།",
    "དེ་འདྲའི་དཔེ་ནི་རང་རེའི་བོད་ཀྱི་སྲོལ་རྒྱུན་རྩོམ་རིག་ནང་དུ་ཁེངས་ནས་འདུག་དེ་དག་ནི་ཡུལ་དང་དུས་ཀྱི་ནང་དུ་གནས་པ་ཞིག་ཡིན་པར་མ་ཟད།",
    "དེ་ནི་མི་རྟག་པ་ཞིག་ཡིན་པས་རེད།",
    "དེ་ནི་ཚེ་སྲོག་གི་རིན་ཐང་ལས་གྲུབ་པའི་དུས་ཚོད་དེ་རེད།",
    "ཕ་རོལ་གྱི་མཐར་ཐུག་གི་བདེ་བ་ཞིག་འཚོལ་སྙེག་བྱེད་པའི་ཐོག་ཏུ་འབད་དགོས།",
    "དེ་བས་ཐུན་མོང་མ་ཡིན་པའི་མཛེས་རྟོག་གི་རྣམ་པ་ཞིག་བསྐྲུན་ཐུབ་ལ།",
    "ང་ཚོས་འཚོ་བ་དེ་བཅད་མཚམས་ཀྱི་ར་བ་རེ་རེའི་ནང་བཞག་ཅིང་།",
    "བཅད་མཚམས་ཀྱི་ར་བ་རེ་རེར་ཡང་སྙན་ཆ་དོད་པའི་མིང་གིས་སྤྲས་པའི་ཚན་རིག་གིས་དོ་དམ་བྱེད་པའོ།",
    "འོན་ཏེ་རྒྱུ་རྐྱེན་གང་ཞིག་ཡིན་མིན་མི་ཤེས་མོད།",
    "ང་ཚོའི་ལག་ནས་ག་ལེར་བརླག་པའི་དངོས་པོ་ནི།",
    "ཚེ་སྲོག་གི་སྒྱུ་རྩལ་ཞེས་པ་དེ་ཡིན་ཞེས་གསུངས་པས།",
    "རྩོམ་རིག་མཐའ་དཔྱོད་དེའང་གཙོ་བོ་མི་རང་ཉིད་ཀྱི་ཚེ་སྲོག་གི་རིན་ཐང་དང་དེར་འཚོལ་སྙེག་ཅིག་གི་སྟེང་དུ་འབད་རྒྱུ་གཙོ་བོར་འཛིན་པ་ལས།",
    "མཐའ་དཔྱོད་བྱེད་མཁན་གང་དེའི་མི་ཚེའི་ལངས་ཕྱོགས་དང་རིན་ཐང་གི་འཛིན་ཕྱོགས་ཤིག་ངེས་པར་དགོས་པ་གཉིས་ཡིན།",
    "རྙིང་བ་དང་གསར་བ་ལྟ་བུའི་རྒྱུ་གཉིས་འགལ་བའི་ལྟ་བ་དང་མི་གཅིག་པའི་སྡོམ་ཚིག་ཅིག་ཀྱང་ཐོབ་ངེས་རེད།",
    "ང་ཚོས་སླར་ཡང་གཙུག་གཡུ་དེ་ཉིད་དཔེ་མཚོན་དུ་དྲངས་ཏེ་མཐའ་དཔྱོད་བགྱིས་ན།",
    "དད་པ་དང་འདོད་ཆགས་གཉིས་པོ་རེད།",
    "ང་ཚོས་སྒྲུང་རིང་འདིར་ཕྱིར་རྟོག་ཅིག་བགྱིས་ན།",
    "ཇོ་བོའི་ཞལ་མཇལ་ཐུབ་པ་དང་གཙུག་གཡུ་འབུལ་ཐུབ་པ་དེས་ངེད་གཉིས་ཀྱི་བསམ་འདུན་ཏན་ཏན་འགྲུབ་ཐུབ་ཀྱི་རེད།",
    "དེ་ལ་དོགས་པ་བྱས་ན་ཉེས་དམིགས་བསམ་གྱིས་མི་ཁྱབ་པ་གསོག་ངེས་པའི་འདུ་ཤེས་ཤིག་གིས་ཁྱབ་ནས་ཡོད།",
    "གཙུག་གཡུ་དེས་ཕུན་ཚོགས་ཀྱི་ཁྱིམ་ལ་གོད་ཆག་ཆེན་པོ་ཞིག་ཁྱེར་ཡོད་མོད།",
    "དད་པ་བརྟན་པོ་དེར་སུ་ཞིག་གིས་ཀྱང་མི་འགྲིག་ཅེས་ཤོད་དཀའ།",
    "བོད་མིའི་སེམས་ཀྱི་ཟབ་སར་འཇུག་མི་ཐུབ་པའི་སྐྱོན་ཡང་བྱུང་བ་རེད།",
    "ད་ཆ་ངའི་དུས་སུ་བབ་སྐབས་དགྲ་གཉེན་གྱི་དབྱེ་བ་ཡང་མི་ཆོད་པ་བྱས་ན་ག་ནས་འགྲིག་པའི་ལྟ་ཕྱོགས་ཤིག་དཔལ་ལྡན་གྱི་སྨྲ་བརྗོད་གཡར་ཏེ་གསལ་བར་བསྟན་འདུག་དད་པ་དེ་ནི་བོད་མིའི་རྒྱུད་ལ་ཡོད་པའི་ཚེ་སྲོག་གི་གྲུབ་ཆ་ཞིག་ཡིན་ལ།",
    "ལྷག་པར་སྒྲུང་རིང་ནང་གི་ཕ་ཕུན་ཚོགས་དང་།",
    "མི་ཚེའི་རིན་ཐང་གི་འཇལ་བྱེད་གཙོ་བོ་ནི་དད་པ་ཡིན་ལ།",
    "དད་པ་དེ་སྒྲུང་རིང་ནང་གི་དྲང་ཕྱོགས་སུ་གྱུར་པའི་མི་སྣ་གཙོ་བོའི་སྤྱིའི་གཤིས་སྤྱོད་དུ་གྲུབ་ཡོད་ན།",
    "དེ་དང་ལྡོག་ཕྱོགས་སུ་གྲུབ་པའི་མི་སྣ་གཙོ་བོ་མདའ་དཔོན་གྱི་གཤིས་སྤྱོད་དེ་འདོད་ཆགས་ཀྱི་སྟེང་དུ་བཞེང་སྐྲུན་བྱས་འདུག་འདོད་ཆགས་ཀྱིས་བསྐྲུན་པའི་འབྲས་བུ་དེ་དག་གིས་ཕ་ཕུན་ཚོགས་ཀྱི་ཁྱིམ་མི་ཡོད་ཚད་སྡུག་བསྔལ་ལ་སྦྱར་བ་དང་།",
    "ཕྱིས་སུ་བུ་མོ་ཡེ་ཤེས་མཁའ་འགྲོ་དང་།",
    "མདའ་དཔོན་གྱི་ཡིད་ལ་སྡུག་བསྔལ་དཔག་མེད་ཅིག་བཟོས་པ་ལེའུ་བདུན་པ་འཁྱོལ་དཀའ་བའི་མཚན་མོ་ཞེས་པའི་ནང་དུ།",
    "འཇིགས་སྣང་གི་རྨི་ལམ་རྨིས་ཚུལ་གྱི་ཐད་ནས་མཚོན་པར་བྱས་ཡོད།",
    "དེ་བས་མི་གཤིས་ཀྱི་རྣམ་པ་ལྷང་ལ་འབུད་དུ་བཅུག་ཅིང་།",
    "མཐར་སྒྲུང་རིང་དེས་རང་རེའི་སྲོལ་རྒྱུན་རྩོམ་རིག་གི་རྩོམ་རྒྱུན་ཏེ།",
    "ཁོང་གཉིས་བཞུད་སའི་ཐག་རིང་དེ་ནི་རྟོག་བཏགས་དང་རེ་བས་བསྐྲུན་པའི་ཕ་རོལ་གྱི་འཇིག་རྟེན་ཞིག་ཡིན་སྲིད་མོད།",
    "རྩོམ་རིག་གི་མཛེས་རྟོག་གི་ཐད་ནས་དཔྱད་ན།",
    "དེ་ནི་མི་ཉིད་འཆིང་བ་ལས་གྲོལ་བའི་ཐབས་ལམ་ཞིག་རེད་ལ།",
    "མིའི་མཐར་ཐུག་གི་རེ་སྙེག་ལ་བཅོལ་བའི་འགན་འཁྲི་དེ་འཁུར་དགོས་ལ།",
    "རྒྱུན་སྲོལ་གྱི་མཛེས་རྟོག་གི་རྣམ་པ་དེ་ཡོངས་སུ་བསྐྱུར་ཐབས་མེད་པར།",
    "ང་ཚོས་དེ་ལ་སྔོག་འདོན་དང་འཚོལ་ཞིབ་བྱས་ཏེ།",
    "ང་ཚོས་ཀྱང་རང་གི་ཐུན་མོང་མ་ཡིན་པའི་ཁྱད་ཡོན་དེ་ཉིད་བཅུད་གཞིབ་འདོན་སྤེལ་བྱས་ན་དགེ་མཚན་ཆེ་བར་མཐོང་མོད།",
    "གལ་ཏེ་དཔྱད་རྩོམ་འདིར་སྐྱོན་དང་ནོངས་ཆ་མཆིས་ན་བགྲོ་གླེང་གི་ཚུལ་དུ་བཀའ་སློབ་གང་མང་ཡོང་བར་ཞུ།",
    "ནགས་ཀློང་ཁུ་བྱུག་འདུ་གནས་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་ལོའི་ཟླ་པར་པར་དུ་བསྐྲུན།",
    "གལ་སྲིད་བདག་གིས་སྦྲང་ཆར་དུ་སྤེལ་པའི་དཔྱད་བརྗོད་སྒོ་འགྲམ་གྱི་འགྲུལ་པ་གཏོལ་མེད་ལོའི་དེབ་བཞི་པ་ཅེས་པ་ནས་བགྲངས་ཚེ།",
    "ཁོང་གི་སྒྲུང་གཏམ་ཀློག་མགོ་ཚུགས་ནས་ཀྱང་མི་ལོ་བཅུ་ཕྲག་གཅིག་ལྷག་འགོར།",
    "རེད་དེ།",
    "སྒྲུང་གཏམ་མ་ཡུམ་ནས་རོང་གྲོང་གི་འགྲུལ་བཞུད་དང་།",
    "མི་ཚེའི་དགའ་སྐྱོ་ཆགས་སྡང་མང་པོ་སྒྲུང་གཏམ་གསར་རྩོམ་གྱི་དུས་ཚོད་དུ་བསྟིམས་ཤིང་ཐིམ་པ་འདི་ནི་སེམས་བསྐྱེད་ཅི་འདྲ་ཞིག་གིས་བསྐུལ་ཅིང་འོངས་པ་ཡིན་ནམ།",
    "སྐྱེས་བུ་ཞིག་གི་མི་ཚེ་ནི་མི་ལོ་ཉི་ཤུ་ག་ཙམ་གྱིས་གྲུབ་ཡོད་དམ།",
    "ཁོང་གི་གསར་རྩོམ་དང་མ་འབྲེལ་བའི་འདྲི་ཚིག་མང་པོ་བློ་ཡུལ་དུ་ཡང་ཡང་བཀོད་ཅིང་ཡང་ཡང་འཆར།",
    "ལྷ་བྱམས་རྒྱལ་གྱིས་གཉིད་དུ་ཡུར་བའི་ཆུ་ཞེས་པའི་སྒྲུང་གཏམ་ཕྱོགས་བསྒྲིགས་འདི་པར་དུ་བསྐྲུན་པའི་བཀྲ་ཤིས་དུས་བཟང་གི་ཉིན་མོར།",
    "ཕལ་མོ་ཆེའི་ཁ་བྱང་ལ་བསྡུས་བརྗོད་དང་ཤུགས་བསྟན།",
    "ཁ་བྱང་ནི་དོན་དུ་རྗེས་མ་རྗེས་མའི་ལས་རིམ་དུ་གཏོགས་པའི་རྩོལ་བ་གལ་ཆེན་ཞིག་རེད།",
    "ཁོང་ནི་བྱེ་བྲག་གི་མི་སྣ་དང་བྱུང་རིམ།",
    "སྤྱི་མཚན་དང་རྟོག་བཏགས་ཀྱི་ལམ་ནས་ཁ་བྱང་བསྒྲིག་པར་མོས་པ་ཟབ།",
    "ལམ་གྱི་ཉི་འོད་དང་རྨ་འགྲམ་གྱི་ལྗོན་པ་ཁེར་སྐྱེས་གཉིད་དུ་ཡུར་བའི་ཆུ་དབུས་ལམ་རིང་མོ་ནུབ་ཀྱི་སྐར་མ་ང་ནི་ཡར་འབྲོག་གཡུ་མཚོའི་ནང་གི་ཉ་ཞིག་ཡིན་བཅས་པར་མཚོན་ན།",
    "དེ་དག་གི་ཁ་བྱང་ནི་ཕུན་སུམ་ཚོགས་པའི་སྙན་རོ་ཇི་བཞིན་ཡང་ཡང་ཉམས་སུ་མྱོང་ཆོག་པ་ཞིག་ཏུ་འཁུམས།",
    "བལྟས་ཚོད་དུ་འདི་ནི་ཕོ་མོའི་བརྩེ་འདང་བརྗོད་པའི་སྒྲུང་གཏམ་ཕལ་བ་ཞིག་རེད་ལ།",
    "རྩོམ་པ་པོས་སྔར་ནས་རང་ཆས་སུ་མངའ་བའི་ཐུན་མིན་གྱི་བརྗོད་པ་དེར་བརྟེན་ནས་ཡོད་ཚད་ལྟ་ན་སྡུག་པའི་རི་མོ་ཞིག་ཏུ་བྲིས་པར་མངོན།",
    "ཞྭ་མོ་དམར་པོ།",
    "ད་དུང་ལྷ་ཀླུ་ཟམ་ཁ་བཅས་སྙན་ངག་ནང་བཞིན་གྱི་ཡིད་བརྙན་བག་བྲོ་བ་དང་ཡིད་འཕེར་བ་དག་གིས་གྲུབ་པར་བྱས་ནའང་།",
    "ཤུགས་སུ་ལྷ་སའི་ཉི་འོད་ལས་ལྡོག་པའི་མུན་ནག་གི་འཇིག་རྟེན་ཞིག་བསྐུངས་ཤིང་།",
    "གོ་རིམ་དེའི་ཁྲོད་དུ་ཁེར་རྐྱང་ནས་ཁེར་ཚུགས་སུ་བུད་པ་དང་།",
    "དོན་དུ་ང་ཚོ་བསྐལ་པའི་འཇིགས་སྔངས་ལས་ཐར་ཅིང་།",
    "འདི་ནི་ལམ་གྱི་ཉི་འོད་ཀྱི་ལྷན་ཐབས་སམ་མུ་འབྲེལ་སྒྲུང་གཏམ་དུ་སོང་བའི་ཆ་ནས།",
    "དེར་གཙང་མོ་ཆུ་ཡི་རང་གཤིས་སྐྱོང་བའི་མི་སྣ་རེ་གཉིས་ཀྱང་མཆིས་ལ།",
    "ཟང་ཟིང་གི་འཇིག་རྟེན་དཀར་ངོགས་འདིར་གཉིད་དུ་ཡུར་བའི་གཙང་མོ་ཆུ་དེར་སླར་ཡང་ཧར་སད་ཐེབས་པ་དང་།",
    "འདི་ཡང་གཏམ་རྒྱུད་གཉིས་རྐྱ་འཐབ་པའི་སྒོ་ནས་གཙོ་ཕལ་ལྡོག་སྟེ་བྲིས་པ་ཞིག་རེད།",
    "དེའི་ཁྲོད་དུ་ཨ་ཕའི་སྣང་བརྙན་དེ་སྐྱེས་པ་ཕོ་ཡི་སྟོབས་ཤུགས་ཀྱིས་ཁྱོགས་པ་ཞིག་ཏུ་སྣང་སྟེ།",
    "དཔེར་ན་སྤྱང་ཀི་བསད་པའི་སྐབས་ཀྱི་དཔའ་བོའི་སྣང་བརྙན་སོགས་བརྗོད་པ་ཐུང་ངུ་ཙམ་གྱིས་རྡོ་ལ་རི་མོ་བརྐོས་པ་བཞིན་འོད་དུ་འཚེར་བ།",
    "ང་ནི་ཡར་འབྲོག་གཡུ་མཚོའི་ནང་གི་ཉ་ཞིག་ཡིན་ཞེས་པར་མཚོན་ན།",
    "བོད་ཀྱི་འབྲོག་ཁྱི་དག་ནང་ལོགས་སུ་དྲུད་པའི་དངོས་མཐོང་གི་སྐྱོ་གར་དང་ཆ་འདྲ་ཞིང་།",
    "མི་འདྲ་ས་ནི་སྔ་མ་མི་དང་ཕྱི་མ་ཁྱི་ཡིན་པ་ཙམ་རེད།",
    "རྩོམ་པ་པོ་ཡར་འབྲོག་གཡུ་མཚོ་ལྟ་བུའི་དྭངས་གཙང་གི་ཕ་ཡུལ་ལ་དུངས་ཀྱང་ཕ་ཡུལ་དུ་ལྡོག་མི་ཐུབ་པ།",
    "ཁོང་གི་སྒྲུང་གཏམ་ཕལ་མོ་ཆེར་ཡུལ་དུས་ཁོད་ཆེ་བ་ཞིག་དང་མི་སྣ་རླབས་ཆེ་བ་ཞིག་བརྗོད་བྱ་རྒྱ་ཆེ་བ་ཞིག་བྲིས་པ་ཉུང་ཚོད་རེད།",
    "འདི་ནི་དེང་གི་སྒྲུང་གཏམ་གྱི་འཕེལ་ཕྱོགས་རིགས་ཤིག་དང་མཐུན་ཞིང་།",
    "རང་རེའི་གནས་བབ་དང་ཡང་འཚམ་པར་འདོད།",
    "ཉམས་མྱོང་ཆེ་མ་ཆུང་གསུམ་དང་ཕྲ་ཞིབ་རགས་གསུམ་གྱི་ངོས་ཐད་ནས་འཚར་ལོངས་དང་ནར་སོན་པའི་གོ་རིམ་རིང་མོ་ཞིག་བརྒྱུད་ཅིང་།",
    "དངོས་བརྒྱུད་ཀྱི་ཉམས་མྱོང་ཅུང་ཟད་དབུལ་བའི་རྐྱེན་གྱིས་ཁོང་གི་སྒྲུང་གཏམ་དེར་མ་འདང་ས་རེ་གཉིས་མཆིས་པར་འདོད།",
    "ལོ་དེ་ལ་ཞེས་པར་མི་སྣ་ཁོ་ཕ་ཡུལ་དང་ཁ་བྲལ་ཏེ་ཕྱི་རྒྱལ་དུ་སོང་བའི་མཚམས་ནས་སྒྲུང་གཏམ་གྱི་འགྲོས་ཚབ་ཚུབ་དང་བྱུང་རིམ་རྩིང་རགས་སུ་གྱུར་པ་དང་།",
    "གསལ་སྒྲོན་བཅས་གསུམ་པོ་མར་ནང་གྲོང་ཚོ་དང་ཁ་བྲལ་ཏེ་གནས་ཡུལ་བརྗེས་པའམ་ལང་ཚོ་དར་ལ་བབ་པའི་གནས་སྐབས་ནས་བཟུང་།",
    "ཁོང་གི་སྒྲུང་གཏམ་ལེགས་ཤོས་ཐམས་ཅད་བྱིས་དུས་ཀྱི་འཚོ་བ་དང་གཞོན་ནུའི་དུས་སྐབས་ཀྱི་བརྩེ་དུངས་བརྗོད་བྱར་བྱས་པ་རྐྱང་རྐྱང་རེད།",
    "ཁོང་གིས་དུས་ནམ་ཡང་རང་ཉིད་རང་ལ་དག་ཐེར་དང་སྐྱོན་སེལ་གནང་བའི་མཚུངས་སུ།",
    "ལྷ་བྱམས་རྒྱལ་གྱིས་ཡར་འབྲོག་གཡུ་མཚོའི་ནང་གི་ཉ་ཞིག་ཡིན་ཞེས་པའི་སྒྲུང་འབྲིང་གི་ཚད་ལ་སླེབས་པ་ཞིག་ཀློག་པ་པོའི་སྤྱན་ལམ་དུ་བསྟབས་པ་ནི།",
    "རང་ཉིད་རང་ལ་ནམ་ཡང་ཡིད་མི་ཚིམ་པ་དང་མགུ་མི་གང་བའི་རྣམ་འགྱུར་དཔེ་ལེགས་ཅན་ཞིག་ཀྱང་རེད།",
    "རྩོམ་པ་པོ་ཁོང་གི་སྒྲུང་གཏམ་གྱི་འཇོན་ཐང་དང་ཡང་རག་ཆེན་པོ་ལས་འདུག་སྙམ།",
    "དེ་ནི་བོད་ཀྱི་གཅེས་ཕྲུག་གི་ལྷན་ཐབས་གང་རུང་ཞིག་མིན་ནམ་སྙམ་པའི་མུར།",
    "ང་ནི་ཡར་འབྲོག་གཡུ་མཚོའི་ནང་གི་ཉ་ཞིག་ཡིན་ཞེས་པ་ནི་ལྷ་བྱམས་རྒྱལ་ཁོང་ཉིད་འཚར་ལོངས་བྱུང་བའི་དན་རྟགས་ཤིག་དང་ཁོང་གི་སྒྲུང་གཏམ་ནར་སོན་པའི་ལམ་ཚད་རྡོ་རིང་ཞིག་ཏུ་བལྟས་ཆོག་ཆོག་རེད།",
    "རྩོམ་པ་པོ་ཁོང་གིས་རྗོད་སྟངས་གསར་པ་ཞིག་རྙེད་པ་དང་འབྲེལ་བ་མཆིས་པས་རེད།",
    "དེ་ནི་གྲྭ་རྒན་བློ་བཟང་གི་ངག་བཞིན་དེ་འབྲེལ་གྱི་བརྗོད་བྱ་སྒྲུང་གཏམ་དུ་བྲིས་པ་ལས།",
    "གྲྭ་རྒན་བློ་བཟང་གི་ངག་ལས་བྱུང་བའི་ང་བརྒྱད་དང་རིག་གསར་ལ་བདེན་སྟོབས་ཀྱིས་ཕྱུག་འདུག་ཡང་དཔེར་ན།",
    "ཁོང་གི་པར་དུ་བསྐྲུན་འགྱུར་གྱི་གཉིད་དུ་ཡུར་བའི་ཆུ་ཞེས་པ་ལྟ་བུར་མཚོན་ན།",
    "ང་ཚོས་ལམ་གྱི་ཉི་འོད་སྐབས་དོན་དུ་ལྷགས་ཏེ་བརྗོད་པར།",
    "ངས་དེར་ལྷ་བྱམས་རྒྱལ་ཁོང་ལྷ་སའི་མག་པ་རེད་ཅེས་ལབ་པ་ཡིན།",
    "གོང་ནས་བརྗོད་བྱ་དང་ཉམས་མྱོང་གི་སྐོར་ནས་ཅུང་ཟད་གླེང་བའི་ཞོར་དུ།",
    "དངོས་གཞིའི་སྐབས་ཀྱི་རྗོད་སྟངས་ཅི་དང་ག་འདྲ་ཡིན་པའི་ཐད་རེ་གཉིས་བྲི་འདོད་པ་ལ།",
    "རྗོད་སྟངས་ནི་མིང་གང་གིས་བརྗོད་པ་དང་འབྲེལ་བ་ཡོད་ལ།",
    "རང་མིང་གི་ལམ་ནས་བརྗོད་པའི་སྒྲུང་གཏམ་བརྒྱད་མཆིས་ཤིང་།",
    "ལེགས་འགྲུབ་བྱུང་བའི་སྒྲུང་གཏམ་ཕལ་མོ་ཆེ་ནི་རང་མིང་གི་ལམ་ནས་བརྗོད་པའི་རིགས་སུ་སྣང་།",
    "ཁོང་གིས་བར་མིང་དང་གཞན་མིང་གི་ལམ་ནས་བརྗོད་པའི་རིགས་ལའང་ལམ་གྱི་ཉི་འོད་དང་གཉིད་དུ་ཡུར་བའི་ཆུ་ལྟ་བུ་ལེགས་འགྲུབ་བྱུང་བའི་སྒྲུང་གཏམ་རེ་གཉིས་ཀྱང་མཆིས་ཏེ།"
  ]
}