    "ཞེས་པའི་ཁྱད་པར་གྱི་དོན་གྱི་འགྲོ་བའི་མིང་ཅན་ཡིན་པས་ཕྱིས།",
    "ཤྲ་ཡིག་ཤསྲ་ལའོ་ཞེས་པའི་ཁྱད་པར་གྱི་དོན།",
    "ཊཱ་ཡིག་རྗེས་སུ་འབྲེལ་བ་ཊཱ་ཨི་ནའོ་ཞེས་ཁྱད་པར་གྱི་དོན།",
    "ཨ་ཡིག་མཐའ་ལས་ཕ་རོལ་གྱི་ཊཱ་ནི་ཨི་ན་ཞེས་པར་འགྱུར་ཏེ།",
    "དྲ་ཡིག་རྣམས་ང་འགྲོ་བའི་ཁྱད་པར་གྱི་དོན།",
    "མིང་མཐའ་མཚུངས་པའི་ཡི་གེ་ལས་ཕ་རོལ་གྱི་ཨཱམྲ་ལ་ནུཊཱ་ཨཱ་ག་མ་སྦྱིན་པར་བྱ་སྟེ།",
    "ཨུ་བྷའི་སྒྲ་ལ་ནི་ངེས་པར་གཉིས་ཚིག་ཁོ་ནའི་མཐའ་སྟེ།",
    "ཀྱེ་ཟླ་བ་དག་ཧེ་མཱ་ས་ཧེ་མཱ་ཀ་ཀྱེ་ཟླ་བ་རྣམས་ཐམས་ཅད་དུ་དབྱངས་ཀྱིས་དམན་པ་ཕ་རོལ་ཏུ་ཡང་དག་པར་སྦྱོར་བ་དང་།",
    "དེ་ལ་ཡང་ཨི་ཨེ་དང་ཨུ་ཨོ་རུ་འགྱུར་བའི་ཁྱད་པར་ཙམ་མ་གཏོགས།",
    "གཞུང་དང་སྒྲུབ་ཚུལ་སོགས་ཧ་རི་དང་ཁྱད་པར་མེད་དེ།",
    "མ་བྱིན་པར་སྤྱིར་བཏང་ལྟར་བསྒྲུབས་པས།",
    "རྀ་ཡིག་མཐའ་ལས་ཕ་རོལ་གྱི་སི་ནི་ཨཱ་ཞེས་པར་འགྱུར་ཏེ།",
    "རྀ་ཡིག་མཐའ་ལས་ཕ་རོལ་གྱི་དྷི་ནི་ཨར་ཞེས་པར་འགྱུར་ཏེ།",
    "ཀནྟིཾའི་སྒྲ་ལ་རྣམ་དབྱེ་ཐོག་མ་ལྔ་ལ་ཁྱད་པར་ཡོད་དེ།",
    "ང་འགྲོ་བ་རྣམས་ལ་ཁྱད་པར་ཡོད་དེ།་",
    "སྟག་རྐང་མཆོག་ཅེས་པའི་རིགས་ལས་བྱུང་བའི་དྲང་སྲོང་ལྷ་མིན་ཉི་མ་ཞེས་པ་དེས་འདོད་པ་ཡིན་ནོ་བོད་པར་ཨུ་ཤ་ནས་ཀྱི་གཟུགས་གསུམ་སྟེ།",
    "ཤསྤ་ལ་སོགས་པ་དབྱངས་ལ་མྲ་བྲ་ཡང་དག་པར་སྦྱོར་བ་མ་ཡིན་པའི་ཨཏྲ་དབྱིའོ།",
    "དེ་བཞིན་དུ་ཨོཾ་ཡིག་མཐའ་ཅན་ཨ་ཏི་ནོ་ཞེས་པ་ལ་ཐུང་ངུར་བྱས་པས་ཨ་ཏི་ནུ་ཞེས་པར་བསྒྱུར་བ་ལ།",
    "སཾ་ཡོ་གཱནྟ་སྱ་ལོ་བ་ཡང་དག་པར་སྦྱོར་པའི་མཐའ་དབྱིའོ།",
    "ར་ས་སོ་སོར་བསྡུ་བའི་ཡི་གེ་ཕ་རོལ་དང་ཚིག་མཐའ་ལས་ཀྱང་ཡང་དག་པར་སྦྱོར་བའི་མཐའ་དབྱི་བར་བྱ་སྟེ།",
    "ཡང་མ་དྷུ་ལིཧྭ་ཞེས་པའི་སྒྲ་ལའང་ཁྱད་པར་ཡོད་དེ།",
    "ཤསྲ་སོགས་རྣམ་དབྱེ་དབྱངས་དང་པོ་ཅན་ཕ་རོལ་ལ་བཱཧའི་བཱ་ཡིག་དབྱངས་བཅས་ཨོཾ་ཞེས་པར་འགྱུར་ཏེ།",
    "ཙ་ཏུར་གྱི་སྒྲ་ལས་ཤི་སྟེ་རྣམ་དབྱེ་དང་པོ་ལྔ་ཕ་རོལ་ལ་ཨཱམྲ་ཨཱ་ག་མ་སྦྱིན་པར་བྱ་སྟེ།",
    "སོགས་ཏེ་དངོས་པོའི་དོན་བརྗོད་པའི་སྐབས་སུ་ཡང་དེས་རིགས་འགྲེ་སྟེ་ཤེས་པར་བྱའོ།",
    "ཛ་ཡིག་དང་ཉ་ཡིག་ཡང་དག་པར་འདུས་པ་ནི་ཛྙ་ཞེས་པར་འགྱུར་ཏེ།",
    "ནྲ་ཡིག་མཐའ་ཅན་པ་ཐིན་ཞེས་པའི་སྒྲ་ལའང་ཁྱད་པར་ཡོད་དེ།",
    "ནྲ་ཡིག་མཐའ་ཅན་པྲདྨ་ཧན་ཞེས་པའི་སྒྲ་ལ་ནི་རྣམ་དབྱེ་ཐོག་མ་ལྔ་དེ་དང་འདྲ་ཞིང་ཤསྲ་སོགས་ལ་ཁྱད་པར་ཡོད་དེ།",
    "མི་དབྱི་བ་གསུམ་འདམ་ག་ཅན་དུ་བྱས་པས།",
    "ཨ་དབྱི་བ་དང་མི་དབྱི་བ་ཡང་ན་བར་བྱས་པས།",
    "ནྲ་ཡིག་མཐའ་ཅན་པཉྩན་ལ་གྲངས་ཀྱི་དོན་བརྗོད་པ་ལ་མང་ཚིག་ཁོ་ན་ལས་མི་འཇུག་ཅིང་རྐྱེན་ལ་མི་ལྟོས་པར་རང་བཞིན་གྱི་རྟགས་གསུམ་པ་ཞེས་ཟེར་ཏེ།",
    "ཨཥྚན་ལས་ཕ་རོལ་གྱི་ཛས་ཤསྲ་གཉིས་ནི་ཡང་ན་ཌོ་ཞེས་པར་འགྱུར་ཏེ།",
    "ཨི་དམ་གྱི་སྒྲ་ནི་སྐྱེས་པའི་རྟགས་ཀྱི་སྐབས་སུ་སི་དང་ལྷན་ཅིག་པར་ཨ་ཡཾ་ཞེས་པར་འགྱུར་ཏེ།",
    "ཨི་དམ་གྱི་སྒྲ་ནི་རྣམ་དབྱེ་ཊཱ་དང་ཨོས་དང་ཕ་རོལ་ལ་ཨ་ན་ཞེས་པར་འགྱུར་ཏེ།",
    "རྣམ་པར་གསལ་བ་ལ་སོགས་པ་ཡང་འདི་དང་འདྲའོ།",
    "ཡང་དག་པར་སྦྱོར་བའི་མཐའ་དབྱི་འོས།",
    "ཨུ་དཱིཙ་རུ་བསྒྱུར་ནས་སྒྲུབ་པ་སོགས་བྱས་པས།",
    "དེ་བཞིན་དུ་ས་མྱརྱ་ལ་ཡང་ཤསྲ་སོགས་དབྱངས་ཐོག་མ་ཅན་ལ་ས་མཱིནྡ་རུ་སྒྱུར་བ་སོགས་བྱས་པས།",
    "ཡང་དག་པར་སྦྱོར་བའི་མཐའ་ཕྱིས།",
    "ཡང་དག་པར་སྦྱོར་བའི་མཐའ་ཕྱིས་པས།",
    "ཡང་དག་པར་སྦྱོར་བ་ས་ཡིག་དང་ཀྲ་ཡིག་གཉིས་འཛོམ་པ་ལ་ནི་གང་སྔོན་ན་ཡོད་པ་དེ་དབྱི་བར་བྱ་སྟེ།",
    "ཀྲ་ཥ་ཡང་དག་པར་སྦྱོར་བ་ཀྵ།",
    "སྲ་ཡིག་མཐའ་ཅན་ཨུ་ཤ་ནས་ཞེས་པའི་སྒྲ་ལ་ཁྱད་པར་ཡོད་དེ།",
    "ཨ་དགྲ་ལས་ཕ་རོལ་གྱི་སི་ནི་ཨོཾ་ཞེས་པར་འགྱུར་ཏེ།",
    "མྲ་ལ་ཨུ་བྱས་པས།",
    "ཏི་སྲྀ་དང་ཙ་ཏ་སྲྀ་ཞེས་པར་འགྱུར་ཞིང་མཐའི་རྀ་ཡིག་དེ་ཡང་རཱྀ་ཡིག་བཞིན་དུ་སྟེ་ཨར་དུ་མི་བསྒྱུར་བ་རྔ་ཡིག་ཏུ་འགྱུར་ཏེ།",
    "ཥའི་ཌའོས་ཌཱུར་སྒྱུར་བ་འདམ་ག་ཅན་དུ་བྱས།",
    "ཨུ་པ་དྷཱའི་ཨ་དབྱི་བ་དང་མི་དབྱི་བ་ཡང་ན་བར་བྱས་པས།",
    "པྲཧྨན་ལ་ངི་བྱིན་པས་པྲཧྨ་ཎི་ཞེས་གྲུབ་པ་ལ་རྟགས་མཐའི་ན་མི་དབྱི་བར་ངི་དབྱི་བ་དང་མི་དབྱི་བ་ཡང་ན་བར་བྱས་པས།",
    "ཨཱ་ག་མའི་ནྲ་ཤི་དང་བཅས་པ་དབྱི་བ་དང་མི་དབྱི་བ་ཡང་ན་བར་བྱས་རྟགས་མཐའ་ཐུང་ངུར་མི་འགྱུར་བས།",
    "ཡུཥྨདྲ་ཨསྨདྲ་དག་ནི་རྣམ་དབྱེ་དང་པོའི་སི་ཕ་རོལ་ལ་རིམཔ་བཞིན་རྟགས་དང་རྣམ་དབྱེ་ལྷན་ཅིག་པར་ཏཱཾ་དང་ཨ་ཧཾ་ཞེས་པར་འགྱུར་ཏེ།",
    "ཡུཥྨདྲ་དང་ཨསྨད་དག་ནི་གཉིས་ཚིག་ཕ་རོལ་ལ་རིམ་པ་བཞིན་ཡུ་བ་ཨཱ་བ་ཞེས་པར་འགྱུར་ཏེ།",
    "ཡུཥྨད་དང་ཨསྨད་དག་ལས་ཕ་རོལ་གྱི་རྣམ་དབྱེ་ཨོཾ་གཉིས་ནི་ཨཱམྲ་ཞེས་པར་འགྱུར་ཏེ།",
