    "དེ་ནས་སྟག་ཟླའི་ཚེས་བཅོ་བརྒྱུད་ཉི་ཤར་དུས་སུ་ཚུལ་གོས་ཐམས་ཅད་ལེགས་པར་གསོལ་ནས་ཞལ་འཛུམ་མདངས་དང་བཅས་ཏེ་གསོལ་བ།",
    "ཉེས་འགལ་ཅི་མཆིས་སྐྱབས་ཡུལ་ཚོགས་ལ་བཤགས།",
    "པར་བྱང་སྨོན་ཚིག་༧བསྟན་པའི་སྲོལ་འབྱེད་དམུ་རྒྱལ་ཐོད་དཀར་སྲས།",
    "པར་བྱང་སྨོན་ཚིག་གཙང་གཤེན་རིག་གྲོལ་རོང་སྟོན་པཎ་ཊི་ཏ།",
    "ཕ་མའི་གཙོར་བྱས་འགྲོ་ཀུན་དོན་དུ་བསྔོ།",
    "གཡུང་དྲུང་བོན་ཞང་བོད་གནའ་བོའི་རིག་གཞུང་ཞིབ་འཇུག་ཚོགས་པ་རྩ་འཛུགས་བྱས།",
    "མ་འོངས་པར་ཚོགས་པ་དང་དཔེ་ཚོགས་ཀྱི་རྒྱ་ཇེ་ཆེར་གཏོང་བའི་འཆར་གཞི་ཡོད་པ་མ་ཟད།",
    "དེ་བས་ད་ལོ་ཡ་ཐོག་ཞང་བོད་ཁྱད་ནོར་དཔེ་ཚོགས་ཞེས་པའི་དེབ་ཕྲེང་འདི་སྡུད་བསྒྲིགས་བྱས་ཏེ།",
    "འཚོལ་སྡུད་ཀྱི་སྐབས་སུ་འགྲོ་གྲོན་གནང་བའི་སྦྱིན་བདག་པེ་ཏེས་ཀྱི་དམངས་སྒོར་ལྔ་སྟོང་།",
    "༢ ༡ ༢ལོའི་ཟླ་༥པར་པར་གཞི་དང་པོ་བསྒྲིགས།",
    "༢༡༤ལོའི་ཟླ་༡ པོར་པར་ཐེངས་གཉིས་པ་དཔར།",
    "༡༧༢༤དཔར་ཤོག་༢༥༥ ཡིག་གྲངས།",
    "༣༦ དཔར་གྲངས།",
    "པར་སྒྲིག་ལག་རྩལ་པ།",
    "དཔེ་སྒོམ་བཞེངས་ཏེ་སྲུང་སྐྱོབ་མཛད་གནང་བ་དང་གནང་མུས་སུ་ཡོད་པ་ནི།",
    "ཉེ་ཆར་དཔལ་བརྩེགས་བོད་ཡིག་དཔེ་རྙིང་ཞིབ་འཇུག་ཁང་དང་འདི་ག་དཔེ་སྐྲུན་ཁང་གཉིས་ཞིབ་གྲོས་བྱས་མཐར།",
    "འཐར་འཐོར་དུ་བཞུགས་པའི་དཔེ་དཀོན་གལ་ཆེན་དག་ཕྱོགས་གཅིག་ཏུ་བསྡུས་ཏེ་བསྒྲིགས་པ་འདིའི་ནང་དོན་ཐད་ལ།",
    "ལྷག་པར་དུ་ཀྲུང་གོའི་བོད་རིག་པ་ཞིབ་འཇུག་ལྟེ་གནས་ཀྱི་དབུ་ཁྲིད་ལྷན་རྒྱས་དང་།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "སེམས་ལྡན་མི་དང་མི་མིན་གྱི་གནོད་པས་ཉམས་ཉེས་ཆེན་པོར་སྒྱེར་པ་ནི་རྒྱ་བོད་ཡོངས་གྲགས་ལྟར་ལགས།",
    "ཏང་དང་རྒྱལ་ཁབ་ཀྱིས་འགོ་ཁྲིད་དང་རྩ་འཛུགས་གནང་ནས།",
    "གས་པ་རྣམས་བསྒྲིགས་ཏེ་དཔེ་ཚོགས་འགའ་རིམ་པ་བསྟར་ཆགས་སུ་པར་དུ་བསྐྲུན་པ་དང་བསྐྲུན་རྩིས་ལས།",
    "དེ་བཞིན་དགོངས་དབྱིངས་སུ་ཆུབ་པར་ཞུའོ།",
    "དེང་སང་ཡོངས་གྲགས་སུ་རྟག་བརྟན་པར་མ་ཞེས་འབོད་པ་འདི་ནི།",
    "དེའི་སྟེང་དུ་རྟག་བརྟན་རང་ནས་བརྐོས་པ་བཅས་པོད་བཅོ་ལྔ་ཙམ་ཞིག་ཡོད་པ་དེའི་བུ་དཔེ་པར་མ་ཚར་གཅིག།",
    "དེང་སེང་བོད་ལྗོངས་དཔེ་མཛོད་ཁང་དུ་སྤྱན་དྲངས་ཏེ་བཞུགས་པ་དེ་ཡིན།",
    "ལྡེབ་གྲངས་བདུན་སྟོང་བརྒྱད་བརྒྱ་ལྔ་བཅུ་བཞུགས།",
    "ད་ལྟ་རྟག་བརྟན་གྱི་པར་རྙིང་བོད་ལྗོངས་དཔེ་མཛོད་ཁང་དུ་བཞུགས་པ་པོད་བཅོ་ལྔ་དང་།",
    "དེ་རྗེས་སྔར་ཇོ་ནང་རྟག་བརྟན་དུ་བཞུགས་པ་རྩོམ་པ་པོ་ཏཱ་ར་ནཱ་ཐ་རང་ཉིད་ཀྱི་ཕྱག་དཔེ་སྐབས་འགར་ཕྱག་མཆན་ཡོད་པ།",
    "ཇོ་ནང་རྟག་བརྟན་གྱི་པར་རྙིང་པོད་བཅོ་ལྔ་བོད་ལྗོངས་དཔེ་མཛོད་ཁང་དུ་བཞུགས་པ་དང་།",
    "གུག་རྟགས་ནང་དུ་བཅུག་ཏེ་གསལ་པོ་བྱས་ཡོད།",
    "འཛམ་ཐང་པར་མའི་ནང་བཞུགས་གསུང་ཐོར་བུའི་སྐོར་ཝ་རྟགས་ཅན་དང་།",
    "རྟག་བརྟན་པར་རྙིང་དང་འབྲས་སྤུངས་བྲིས་མ་གཉིས་ཀྱི་བསྡུར་གཞི་མ་རྙེད།",
    "དཔེ་རྟགས་ཕྱི་༢༩༨ནང་བཞུགས་གཏམ་དུ་བྱ་བ་ནོར་བུའི་འབྱུང་གནས་ལྡེབ་༦།",
    "ད་ལམ་དངོས་སུ་པར་དུ་བསྐྲུན་ཐུབ་པ་བྱུང་སྟེ་རྒྱ་ཆེའི་ཀློག་པ་པོ་རྣམས་ཀྱི་སྤྱན་ལམ་དུ་ཕུལ་བ་ཡིན།",
    "ལས་གཞི་འདིར་བོད་ལྗོངས་དཔེ་མཛོད་ཁང་ནས་མ་དཔེ་པོད་བཅོ་ལྔ་གཡར་གནང་བྱུང་བ་དང་།",
    "ཞུ་དག་བཅས་ལ་རོགས་རམ་གང་མང་གནང་བ་དང་།",
    "ཆུ་བོ་ཆེན་པོ་ལོ་ཧི་ཏའི་ཉེ་འགྲམ་དུ་རྭ་ལོ་ཙཱ་བ་ཆེན་པོའི་བརྒྱུད་པ་བར་མ་ཆད་པར་བྱོན་པ་ལ།",
    "དགུང་ལོ་བཞི་པར་ཇོ་ནང་མཁན་ཆེན་ལུང་རིགས་རྒྱ་མཚོ་དང་།",
    "དེ་ནས་དགུང་ལོ་དྲུག་པ་ནས་ཡི་གེ་སྦྱོར་ཀློག་ཕུལ་དུ་ཕྱིན་པ་མཁྱེན་ཏེ།",
    "དགུང་ལོ་བརྒྱད་ལ་ཕེབས་སྐབས་སྟག་ལུང་ཀུན་དགའ་བཀྲ་ཤིས་རྒྱལ་མཚན་གདན་དྲངས་ཏེ་ཐོག་མར་བཀའ་གདམས་གླེགས་བམ་གྱི་ལུང་ཞུས་ཏེ།",
    "ཀུན་མཁྱེན་དོལ་བོ་པའི་གསུང་འབུམ་སོགས་ལུང་མང་པོ་གསན།",
    "སྒྲུབ་ཐབས་བརྒྱ་རྩའི་རྗེས་གནང་།",
    "བྱང་ས་སོགས་གཞུང་མང་ཤེད་ར་ཐོས་བསམ་གནང་བས་བློ་གྲོས་ཀྱི་ལུས་སྟོབས་ཆེས་ཆེར་རྒྱས་ཏེ་གཞུང་ལུགས་རབ་འབྱམས་སྨྲ་བའི་མཁས་པ་ཆེན་པོར་གྱུར།",
    "ཕྱིས་ཀུན་མཁྱེན་ཆེན་པོའི་བཞེད་དགོངས་ལྟར་ཉམས་སུ་མྱོང་བའི་བརྡ་རུ་གོ།་",
    "དེ་ནས་རྒྱ་གར་གྱི་པཎྜི་ཏ་པུརྞ་ནནྡ་དང་པྲ་ཡཱ་མཱ་ནནྡ་གཉིས་དང་མཇལ་འཕྲད་མཛད་དེ་གསུང་གླེང་གནང་བརྨི།",
    "རྗེ་ཙོང་ཁ་པའི་བཞུགས་ཁྲིའི་སྟེང་ནས་ལམ་རིམ་གསུངས།",
    "དེ་ནས་ཀུན་མཁྱེན་དོལ་པོ་པའི་སྐུ་བརྙན་གསུང་བྱོན་མ་དང་།",
    "བཀའ་འབུམ་སྐོར་པོ་ཏི་བཞི་བཅུ་ཤིང་པར་དུ་བརྐོས་པ་སོགས་རྟེན་གསུམ་མང་པོ་གསར་བཞེངས་གནང་།",
    "གཏོར་མའི་ཆོ་ག་དང་བཅས་པ་འཕྲིན་ལས་གཏེར་མཛོད་བཞུགས་སོ། ཚོ།",
    "བཆོད་པརདཀའ་བའི་གཟི་བརྗིད་མཐའ་ཡས་པ།",
    "རློན་པ་ཁྲག་འཛག་པ་ལྔ་བཅུའི་དོ་ཤལ་བྱས་པ།",
    "བདུད་དང་དགྲ་བགེགས་ཐམསཅད་རླགཔར་མཛད་པ།",
    "བསྐལ་པའི་མེ་ལྟ་བུའི་ཡེ་ཤེས་ཀྱི་མེ་དཔུང་འབར་བའི་དབུསན་བཞུགས་ཤིང་།",
    "སྲིན་པོའི་ཡ་མགལ་ལ་སྒའི་སྔ་རུ་བྱས་ཤིང་།",
    "ཕྱག་གཡས་པས་གྲི་གུག་ནམ་མཁའ་ལ་འཕྱར་བས་ལྷ་དང་ལྷ་མིན་ཐམསཅད་སྐྲག་པར་བྱེད་པ།",
    "བསྟན་པ་བསྲུང་བར་ཞལ་བཞེསཔའི།",
    "རྒྱན་གྱི་གཏོར་མ་འདི་བཞེས་པ།",
    "བཆོལ་པའི་འཕྲིན་ལས་སྒྲུབ་པར་མཛོད།",
    "ཛ་ཧོ་གཉིས་སུ་མེད་པར་ཐིམ།",
