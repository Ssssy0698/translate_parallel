    "ཀུན་མཁྱེན་དོལ་པོ་སངསརྒྱསལ་ཕྱགའཚལ་ལོ།",
    "གཙང་ཞིང་བཟང་བའི་རྒྱུ་དམ་རྫས་དང་བཅས་པ་ལ།",
    "དེ་ནསགཏོར་མ་རྣམས་བྱིན་གྱིས་བརླབ་པར་བྱ་སྟེ།",
    "དེའི་འོད་ཟེར་གྱིས་མ་དག་པའི་རྫས་རྣམས་སྦྱ་༤པརགྱུར།",
    "འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་ཐམས་ཅད་མདུན་གྱི་ནམ་མཁར་བཞུགས་པར་གྱུར།",
    "རྡོ་རྗེ་འཇིགས་བྱེད་འཇིགས་པར་མཛད།",
    "ཟད་པར་བསྙེས་པ་རྣམ་པ་གཉིས་གཉིས་ཏེ།",
    "ཟད་པར་ཁྲོ་བོས་སེམས་ཀྱི་ཁམས་བསྲུང་ཞིང་།",
    "ཧོ་སྭ་བྷཱ་ཝས་སྟོང་པར་སྦྱང་ལ།",
    "ཡེ་ཤེས་ཀྱི་མེ་རབ་ཏུ་འབར་བའི་དབུས་ན་བཞུགས་པ།",
