    "ཁོང་གཉིས་ཚེ་ཐར་བཏང་ནས་འདུག་ལྕམ་སྲིང་གཉིས་ཀྱི་ཡབ་ཡུམ་བཞུགས་པའི་དུས།",
    "ཨ་ཇོ་རང་ཉོན་དང་།",
    "ཨ་ཇོ་གསོན་དང་གདོལ་པ་གཞོན་པ་ལགས།",
    "ཁྱེད་རང་ཡོང་བ་དང་པོ་གང་ནས་ཡོང་།",
    "ད་ཁྱེད་རང་པདྨ་ཅན་གྱི་རྒྱལ་པོ་མཛད་ན་མི་ལེགས་སམ་ཞུས་པས།",
    "ངས་རྒྱལ་པོ་ཡོང་བ་འདུག་གམ་གསུངས་པས།",
    "ང་པདྨ་ཅན་གྱི་རྒྱལ་པོར་ཡོང་བ་འདུག་གམ་གསུངས་པས།",
    "ནེ་ཙོས་དེ་ལྟར་ཡོང་བ་འདུག་ལགས་ཞུས་པས།",
    "ལྷ་ཐུགས་རྗེ་ཆེན་པོའི་སྤྲུལ་པ་དགུང་ལོ་གསུམ་དུ་བཞེས་པ་ཞིག་ཤིང་ཙན་དན་སྡོང་པོའི་བསིལ་གྲིབ་ལ་བཞུགས་འདུག་པས།",
    "ཐུགས་རྗེ་ཆེན་པོའི་སྤུལ་པ་དགུང་ལོ་གསུམ་དུ་བཞེས་པ་ཞིག་ཤིང་ཙན་དན་སྡོང་པོའི་བསིལ་གྲིབ་ལ་བཞུགས་འདུག་ཟེར་བ།",
    "སྨྲ་མཁན་ནེ་ཙོའི་ལུང་བསྟན་བྱུང་འདུག་ཟེར་བ་ལ།",
    "ང་རང་ཡང་ལྕེབ་དགོས་དགོངས་ནས།་",
    "ཁོང་རང་ཚེ་ཐར་ལ་གཏོང་བའི་གདོལ་པ་རྒན་པ་ཁོས་ལྕེབ་ཏུ་མ་བཅུག་པར།",
    "དེ་བས་ང་རང་ཤི་བ་དྲག་བསམས་ནས།",
    "ཁོ་རང་ལ་གྲི་གུ་ཐོ་གང་བ་ཞིག་ཡོད་པ།",
    "དེ་ན་ལྷ་སྲས་རྒྱལ་བུའི་སྐུ་པུར་ནི་མི་འདུག་གཞན་ཡང་མི་ནག་ཆེན་ཐམས་ཅད་གཡང་ལ་བསྒྱུར་པའི་རུས་པ་དཀར་ནག་ཁྲ་གསུམ་མང་དུ་འདུག་པས།",
    "བྲམ་ཟེ་སྒོམ་ཆེན་གཅིག་འདུག་པ་དེའི་དྲུང་དུ་ཕྱིན་ཏེ།",
    "ང་ཡི་ཨ་ཅེ་དེ་ཡིན་པ་འདུག་གསུངས་ཏེ།",
    "ད་ནི་ཅི་འདྲ་ཞིག་འདུག་ཅེས་ཞུས་པས།",
    "ལྟས་ངན་བྱུང་ན་རྒྱག་དགོས་འདུག་དེ་རྣམས་ཐམས་ཅད་བདག་ལ་གནང་བར་ཞུ།",
    "ཡབ་ཆེན་རྒྱལ་པོ་སྐུ་ལུས་རུས་པ་ཁྲོམ་མེ་མ་ཤི་ཙམ་ལ་བཞུགས་འདུག་པས།",
    "གཏམ་རྒྱུད་ཇི་སྙེད་ཅིག་གསུངས་འདུག་པ་ལས།",
    "སྔོན་བོད་དུ་ལོ་ཙ་བ་བེ་རོ་ཙ་ན་དང་།",
    "སྙན་པའི་གླུ་ལེན་བཞིན་འདུག་པ་དེ་ཤིན་ཏུ་མཛེས་པ་ལྟ་བས་ཆོག་མི་ཤེས་པ།",
    "མཚར་ཞིང་ཡིད་དུ་འོང་བ་སོགས་ཀྱི་ཡོན་ཏན་འདུག་ཅིང་།",
    "ཁོ་པའི་བསམ་པ་ལ་རི་ཕག་འདི་བསད་ན་ཤ་རྐྱང་ལས་མི་འདུག་དེ་བས་གླ་བ་འདི་བསད་ན་ཤ་དང་པགས་པ་གཉིས་ཀ་འོང་བར་འདུག་བསམས་ནས།",
    "དེ་བས་ཤྭ་བ་འདི་བསད་ན་ཤ་དང་པགས་པ་རྭ་ཅོ་གསུམ་གྱི་ཕན་ཐོགས་པ་འདུག་སྙམ་སྟེ།",
    "བུམ་པ་དང་ནལ་ཚེ་བཞག་པའི་རྗེས་གཅིག་འདུག་པས།",
    "རྒྱལ་པོའི་དྲུང་དུ་གཏམ་སྙན་ཞིག་འབུལ་རྒྱུ་ཡོད་ཟེར་འདུག་སྟེ།",
    "ཁོང་རྣམས་མིག་སེར་ཡོད་པར་གདའ།",
    "ཁོང་རྣམས་ཀྱིས་མ་ཐོས་པ་བྱེད་ཟེར་བ་ཡིན་པར་འདུག་དེ་ནས་ཡིད་བཞིན་ནོར་བུ་ངའི་ལག་ཏུ་འོང་ཟེར་བ་འདི།",
    "འཇག་མའི་སྤྱིལ་བུ་གུར་ལྟར་ཕུབ་པ་ཕ་ཚད་ཚུན་ཆད་འདུག་པ་ལ།",
    "གསེར་གྱི་དོང་ཙེ་གཅིག་ཕུལ་ནས་མདུན་དུ་ཙོག་བུར་འདུག་པས།",
    "ཆ་གཅིག་ཨ་ལ་ལ་ཧོཟེར་ནས་ཁོ་རང་གསོལ།",
    "དེ་དག་ཀུན་ལ་མི་རྒན་ང་རང་མ་བས།",
    "རང་སྲོག་དོར་བའི་བར་དུ་མ་འདུག་ཅིག་ཅེས་སྨྲས་པ་དང་།",
    "རྒྱལ་པོ་ཟླ་བའི་སེང་གེ་ལ་ཟེར་བར་འདུག་ལྔ་གསུམ་བར་དུ་འཕེལ་ཞེས་པ་འདི།",
    "ཟླ་བ་ཡར་ངོའི་ཚེས་བཅོ་ལྔ་ལ་ཟེར་བར་འདུག་བཅུ་བཞིའི་ཐོ་རངས་ཉི་མས་བཟུང་ཞེས་པ་དེ།",
    "དེའི་ཉི་མ་ནི་གཟུགས་ཀྱི་ཉི་མ་ལ་ཟེར་བ་ཡིན་པར་འདུག་ཁྱབ་འཇུག་ལ་མགོན་སྐྱབས་བཅོལ་ན་ཟེར་བ་དེ།",
    "གསེར་གྱི་གྲི་གུ་གཅིག་འདུག་པ་དེ་ཁྱེར་ནས།",
    "གླུ་གར་གྱིས་མཚན་ཐུབ་ཐུབ་བྱེད་ཀྱིན་འདུག་པ་ལས།",
    "ཁ་ནས་ཁྲག་འཛག་ཚུལ་བྱས་འདུག་པ་ལ།",
    "ཕན་ཚུན་རྒྱུགས་ནས་བལྟས་ཙ་ན།",
    "གཅན་གཟན་དེ་ལས་མི་འདུག་པས།",
    "བྱ་ར་བྱེད་ཅིང་བསྡད་ཙ་ན།",
    "དེ་ནས་ལོག་སྟེ་བལྟས་ཙ་ན།",
    "བུ་ཆུང་མལ་དུ་ཉལ་བསྡད་འདུག་དུག་སྦྲུལ་ཁ་ལ་མེ་འབར་གཉིས།",
    "ནེ་ཙོ་དེས་བྱ་སྐྱེལ་ཉེན་འདུག་བསམས་ཏེ།",
    "རྒྱལ་པོའི་དྲུང་དུ་བྱ་སྐྱེལ་ཉེན་འདུག་དོ་ནུབ་ལ་དོན་ཆོད་པ་བྱེད་དགོས་ཟེར་བའི་ཞིབ་གཏམ་མང་པོ་གླེང་བའི་མཐར།",
    "གཟུགས་ཀྱི་ཉི་མ་མེད་པར་བྱས་འདུག་ན།",
    "སྐུ་ལུས་ཕྱེད་ཙམ་ཕྱིར་དོན་འདུག་པ།",
    "ཁ་ནས་ཁྲག་འཛགས་ཏེ་འདུག་པ་ལས།",
    "དེ་དག་རྒྱལ་པོ་ཡབ་སྲས་ཀྱི་ཐུགས་ཀྱིས་མི་བཟོད་པ་འདུག་པས།",
    "ཨ་ཙ་མ་ན་བཟོད་གླགས་མི་འདུག་པས།",
    "གདམས་ངག་ལོག་ནས་བཙལ་དགོས་པ་གདའ་ཡེ།",
    "གཉེན་དང་མཛའ་བཤེས་ཀྱི་ཕན་པ་གདའ་ཡེ།",
    "ལུས་དང་ལོངས་སྤྱོད་ཀྱི་ཕན་པ་གདའ་ཡེ།",
    "ཁྱིམ་བདག་བུ་སྨད་ཀྱི་ཕན་པ་གདའ་ཡེ།",
    "འགྲོགས་པའི་སྐྱེས་པ་དེས་ཕན་པ་གདའ་ཡེ།",
    "མཚང་འབྲུ་བའི་གཞི་ལས་མི་འདུག་སྟེ།",
    "འདི་དག་ཁྱེད་རང་རྣམས་ཀྱིས་སེམས་ལ་སྦྱོར་དང་།",
    "ད་ནི་ཁྱེད་རང་རྣམས་ཀྱང་འཆི་བ་ནམ་ཡོང་ཆ་མེད།",
    "ཁྱེད་ཚོའི་སེམས་ལ་བདེན་བསམས་པ་ཞིག་མི་འདུག་རང་སྲོག་འདྲེ་འགོང་པོ་པེ་ཀར་བདུད་ཤ་ཟའི་ཚོགས་ཀྱིས་འཁྱེར་དོགས་པས་ཟོན་འདི་བྱེད་དོན་ཆུང་།",
    "འཆི་བ་ཡོང་སྙམ་པ་མི་འདུག་སྟེ།",
    "མྱ་ངན་མི་གདའ་བཞུགས་པར་གསོལ་བ་འདེབས།",
    "དེ་ནས་རྒྱང་གྲགས་གཅིག་ཙམ་ཕྱིན་ཙ་ན།",
    "གསོད་ཀྱང་ཁོ་རང་ལ་གསོད་དུ་འཇུག་པ་དྲག་ཞེས་ཁ་འཆམས་ནས།",
    "འོ་དེ་བཞིན་བྱེད་དོ་རྔན་པའང་ང་རང་འཁྱེར་ཏོ།",
    "རྔན་པ་ཡང་ཁྱེད་རང་གཉིས་ཁྱེར།",
    "ད་ནི་ངེད་རང་གསུམ་གྱིས་ནི་གསོད་མི་ནུས་པ་འདུག་མ་བསད་པར་ཡུལ་དུ་ཕྱིན་ན་ནི།",
    "ཁོང་རང་གཤེད་མ་གསུམ་པོ་དེ་ནས་རྒྱང་གྲགས་གཉིས་ཙམ་གྱི་ས་ན་བྲག་བྱ་སྐྱིབས་ཚལ་ཞེས་བྱ་བ་དེར་བཞུད་དོ།",
    "དེ་དུས་གཤེད་མ་མི་གསུམ་པོས་ནི་བསད་མི་ནུས་པར་འདུག་གཅན་གཟན་སྲིན་པོའི་ཚོགས་ཀྱི་ནི་མི་ཟ་བས་མི་ཆོག་དད་པ་དང་གུས་པའི་ཚུལ་གྱིས་ཞབས་ཏོག་བྱེད་ཅིང་འདུག་འདི་མ་བསད་པར་ངེད་རང་གསུམ་རང་ཡུལ་དུ་ཕྱིན་ན།",
    "ཁྱེད་རང་སྔར་ག་ནས་འོངས་བའི་སར་ལོག་བྱོན།",
    "ངེད་རང་རྣམས་ཁྱེད་གསོད་མི་ཡོད་པར་འདུག་པས།",
    "མི་མ་ཡིན་གྱིས་མཆོད་སྐོར་བྱེད་ཅིང་འདུག་པས།",
