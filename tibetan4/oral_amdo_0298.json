    "གིས་ཀྱི་བུ་རྣམ་གྲངས་དེསནཁྱོད་ཀྱིས་འདི་ལྟརགལ་ཏེ་དགེ་སློང་ཤཱ་རིའི་བུ་དང་།",
    "ཤེས་རབ་ཀྱི་ཡར་ཏུཕྱིན་པ་ཡོངས་སུ་བསྒོམས་པའི་སེམས་ཐམས་ཅད་མཁྱེན་བཉིད་ལ་བརྟན་པར་གཏད་པས་འདོད་པའི་འདམ་ཆེན་བོར་འཇུག་པར་བྱེད་ཀྱང་དེཐམསཅདམཁྱེན་པ་ཉིད་ཀྱི་སེམས་ལེགས་བརབསླུས་པ་དེསགང་གི་ཚོ་འདོད་པ་དེའི་ཚན་འདོད་པའི་ཁམསསུངས་ཏེ་ཚངས་པའི་འཇིག་རྟེན་དུ་སྐྱེ་བར་བྱེད་དོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སེམས་ལེགས་པར་བསྲུངས་བཙག་གིས་འདོད་པའི་ནས་ཚངས་པའི་འཇིག་རྟེན་དུ་སྐྱོབར་བྱེད་དོ།",
    "དེནི་གནས་ད་ནི་ཚུལ་མ་ཡིན་པས་འཆི་བར་འགྱུར་རོ་ཞེས་ཀྱང་ཟེར་མོད་ཀྱི།",
    "དེའི་རིམ་གྲོ་བྱེདཔའི་བསྙེན་བཀུརམལྷའི་བུམོ་ཁྲི་བཞི་སྟོང་ཡང་ཉེ་བར་གནས་པར་གྱུར་ཏོ།",
    "བདག་འདོད་པའི་འདོད་ཆགས་ཀྱིས་ཀུན་ནས་གྱིས་པའི་སེམས་ཀྱིས་འཆི་བའི་དུས་བྱས་ནས་བུད་མེད་ཀྱི་ལུས་རྗེས་ཏེ།",
    "བདག་གིས་འདིའི་སྐྱེས་པའི་ལུས་ཐོབ་ཅང་བདག་ལ་འབྱོརཡོདཔག་ཏུ་མེད་པའདི་ལྟ་བུ་དག་ཀྱང་བྱུང་བར་གྱུར་ཏོ་སྙམ་ནས་སྔོན་གྱི་ལས་རྗེས་སུདྲན་པའི་ཤེས་པ་ཡང་སྐྱེས་པར་གྱུར་ཏོ།",
    "སྐད་ཅིག་དེ་ལ་བུད་མེད་ལུས་སྤངས་ཏེ།",
    "སུག་ལས་གང་གིརྣམ་སྨིན་འདི་འདྲ་ལ།",
    "ཆགས་བཅས་སེམས་ཀྱིས་བདག་གིསཁལྟས་གྱུར་པས།",
    "ལྷའི་བུ་གང་གིས་ད་ལམཆོད་བྱས་ཏེ།",
    "འདཔྱད་ཁྱོད་སྤོབས་པར་གྱིས་ཤིག།",
    "འབམེདཔར་ཁྱེད་ཅག་གི་ཡོངས་སུ་སྐྱོབ་པ་ཡིན་ཏེ།",
    "སེམས་གཡོ་བར་ཡང་མི་འགྱུར་རེ།",
    "སྙམ་ན་ཁྱོད་ཀྱིས་དེ་ལྟརམིབལྟའོ།",
    "ཚངས་པ་དག་གིས་འཁུར་བྱེད་དེ།",
    "བཙུན་མོའི་འཁོར་གྱི་གླུ་བྱ་བ་བ་ཀུན་དུ་བསྟནཔ་དང་།",
    "རྩེ་མོ་དང་།",
    "རྩེད་མོ་དག་ལེགས་པར་བསླབས་ཤེན།",
    "སྤྲུལ་པ་དེ་དང་བུད་མེད་དེ་དག་ལྷན་ཅིག་གདབ་དང་།",
    "བྲམ་ཟེའི་ཁྱེའུ་འོད་ཟེར་ཕྲེང་གིས་རིགས་ཀྱི་བུ་དེ་ག་སྣོད་ཡིན་པར་རིག་ནས་དེ་ཐབས་ལ་མཁས་པས་བྲམ་ཟེའི་རིགས་ཤིང་སཱ་ལ་ཆེན་པོ་ལྟ་བུའི་བུ་ལྕཔོ་དེ་དག་རིམཀྱིས་མུ་སྟེགས་ཅན་དེ་དག་གི་དྲུང་ནས་ཕྱིར་བཟློག་པར་འདོད་པས་དེ་ཐབས་ལ་མཁས་པས་རྫམཁན་བུམ་བྱེད་ལཚིག་འདིས་ད་ཅེས་དགེ་སྦྱོང་མགོ་རེག་མཐོང་བས་ཁོ་བོ་ལཞིག་ལ།",
    "དེནས་རྫ་མཁན་བུམ་བྱེད་དེས་ཕྱོགས་གལ་བ་དེར་སོང་སྟེ།",
    "དེ་བཞིནགཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའིསས་རྒྱས་འོད་སྲུང་གི་བསྔགས་པ་བརྗོད་ཅིང་བསྔགས་པ་བརྗོད་ནསཁྲམ་ཟེའི་ཁྱེའུ་འོད་ཟེར་དི་སྐད་ཅེས་སྨྲས་སོ།",
    "འོདཟེར་ཕྲེང་ཚུར་ཤོག་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའིསས་རྒྱས་འོད་སྲུང་གི་སྦྱནསྡུག་མིགས་ཀྱི་བུ་དེ་ནས་བྲམ་ཟེའི་ཁྱེའུ་འོད་ཟེར་ཕྱོགས་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དེ་ནསཛ་ཁནབུམ་བྱེད་དེས་བྲམ་ཟེའི་ཁྱེའུ་འོད་ཟེར་ཕྲེང་གི་ཐོར་ཏོ་ནས་བཟུང་སྟེ།",
    "དེ་བཞིན་གཤེགས་བདགྲབཅོམ་པ་ཡང་དག་པར་རྫོགས་པའིསངསརྒྱུས་འོད་སྲུང་ག་ལ་བ་དེར་ཁྲིད་དེ་སོང་ངོ།",
    "དེ་དག་གིས་དད་པ་ཐོབ་ནས་བྲམ་ཟེའི་ཁྱེའུ་འོད་ཟེར་ཕྲེང་ལ་སྨྲས་པཾ།",
    "མཆོག་ཏུ་གའ་བ་གཅིག་གིསཀྱུད་བསྐལ་པ་འབུམ་ཕྲག་མང་པོརཁ་ཟས་མེད་པར་གནས་པར་ནུས་ཏེ།",
    "པག་གིས་བདུད་སྡིག་ཅན་དང་གཡུལ་སྤྲད་དེ།",
    "འོད་དེས་སྟོང་གསུམ་གྱི་སྟོང་ཆེནཔོའི་འཇིག་རྟེན་གྱི་ཁམས་འདི་སྣབར་བྱས་ཤིང་ཉི་མ་དང་ཟླ་བ་དག་གི་འོད་ཀྱང་ཡོངས་སུ་གཞུགས་ཏེ་བདུད་ཀྱི་གནས་ཐམས་ཅད་སྦབཀོང་ནས་འོད་དེ་ལས་སྒྲ་འདིལྟ་བུ་བྱུང་ངོ།",
    "སུམནས་དེ་དག་གིས་ཞག་བདུན་དུ་སེམས་གཅིག་ཏུ་བསྡུས་ཏེ་བརྟགས།",
    "གཞན་གྱི་ནོར་འཕྲོག་གཞིག་འདུག་པ་དེས་འདི་ལྟར་སེམས་བསྐྱེད་རེད།",
    "བདག་གིས་ཚོང་པ་འདི་དག་ཐམས་ཅད་སྲོག་དང་ཕྲལ་ལནོར་རྫས་ཀྱི་རྣམ་པ་འདི་དག་ཐམས་ཅད་ཁྱེར་ཏེ་འཛམ་བུའི་གླིང་དུའགྲོའོ་སྙམ་དུ་སེམས་པས།",
    "དེལ་དེད་དཔོན་ཁྱོད་ཀྱིས་དེ་ལྟ་བུ་ལས་བརྟེན་ཏེ།",
    "ངཛོ་ཆེན་པོདང་ལྡནཔཞེས་བྱ་བར་གྱུར་པ་དེ་གཞནཞིག་ཡིན་སྙམ་དུ་ཁྱོདཡིདགཉིས་དང་ཐེ་ཚོམ་ཟབརགྱུརན་དེ་ལྟརམི་བལྟའོ།",
    "གང་གི་ཕྱིར་ཐབསལམཁས་པ་དེ་དང་།",
    "མན་ཁྱོདཀྱིས་དེ་ལྟར་མི་བལྟ་སྟེ།",
    "རིགས་ཀྱི་བུ་དེས་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའི་ས་རྒྱས་ཀྱིས་མིབཞིབཅུ་པོ་དེ་དག་གལ་བའི་དབངགི་ཕྱིར་དང་།",
    "མོད་གལ་གྱི་བུ་ཆེན་པོ་ཁྱོད་ཀྱིས་སེང་ལྡེང་གིཚལ་པ་འདིས་ཕྱོགས་འདི་ནས་གཞག་དབར་ནས་སོ།",
    "རིགས་ཀྱི་བུ་དེ་ནས་གནས་བརྟན་མོད་གལ་གྱི་བུ་ཆེན་པོས་སྟོབསཀྱི་ཤུགས་ཀྱིས་སེང་ལྡེངགི་ཚལབ་དེབཟུང་བ་དང་།",
    "འདིཝཱརསྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོ་འཇིག་རྟེན་གྱི་ཁམས་འདི་ཁ་གྱེན་དུ་བལྟས་ཏེ་འབཏུག་ཡོས་པར་གྱུར་ཀྱང་སེང་ལྡེང་གིཚལ་པ་དེ་ནི་ཐན་སྐུའི་རྩེ་མོའི་ཆ་ཤས་ཙམ་ཡང་མི་འགུལ་ལོ།",
    "སེང་ལྡེང་གི་ཚལ་པ་དེ་ཡང་ཚ་ས་པའི་འཇིག་རྟེན་ནས་བབས་ཏེ་བཅོམལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་གོ།",
    "བཅོམ་ལྡན་འདསཀྱིས་སེང་ལྡེང་གི་ཚལ་པའི་སྟེང་དུ་ཞབས་བཞགམ་ཐག་ཏུ་དེ་ནས་དེའམོ་ལ་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟན་གྱི་ཁམས་འདི་གཏུག་ཡོས་པར་གྱུར་ཏོ།",
    "ཀུན་དགའ་བོང་སྔོན་རྒྱ་མཚོ་ཆེན་པོའིནང་དུ་སོང་བན་ཚོང་པ་གཡོན་ཅནཞིགམདུང་ཐུང་གིས་བཏབ་སྟེ་སྲོག་དེར་ཕུལ་བར་གྱུར་པས་འདི་ནི་ལས་དེའི་ལྷག་མ་ཡིན།",
    "གང་གི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་གབར་རྫོགས་པའི་གསོ་རྒྱསཀྱི་ཞབས་ལ་སེང་ལྡེང་གི་ཚལ་པས་ཟུག་པ་རཔའི་རྒྱུནི་དེ་ཡིན།",
    "དེ་ཚོ་དང་ལྡན་པ་དག་ཁྱེད་ཅག་སྙན་གཞན་དགཚོའགལ་འཆིབའི་དུས་བྱེད་པར་མི་འགྱུར་བར་གྱིས་ཤིག་དགེ་སློང་དེ་དག་གིས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "རིགས་ཀྱི་བུ་དེལ་དེ་བཞིནགཤེགས་པ་ལནི་ལས་ཀྱི་སྒྲིབ་པཙུང་ཟད་ཀྱང་མི་མངའ་མོད་ཀྱི།",
    "ལསཀྱི་སྒྲིབ་པ་ཅུང་ཟད་ཀྱང་མིམཔ་མོདཀྱི།",
    "ཁྱིམ་བདག་དེ་དག་བྱིན་གྱིསབརླབས་པར་ཟདཀྱི་རང་གི་བློས་ནིམཡིན་ནོ།",
    "དེ་ནས་དེའི་མོད་ལ་ལྷའི་བུ་བདུས་དད་པ་ཐོབ་པར་གྱུར་ནས།",
    "ཅིའི་ཕྱིར་བྲམ་ཟེའི་བུམོ་དྲེགས་མས་ཤིངགི་གཤོང་བུ་ལྟོ་བར་བཅིངས་ཏེ།་",
    "ཅིའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མཁྱེན་པས་ཀུན་ཏུ་རྒྱམཛེས་མ་ཀུན་ཏུ་རྒྱུ་དག་གིས་སྲོག་དང་ཕུལ་ཏེ།",
    "ཞེས་བདག་ཉིད་ཀྱི་རང་གི་ཉེས་པས་ཤིན་དུ་ཚར་གཅོད་བར་འགྱུར་རོ།",
    "རྟ་ཅང་ཤེས་དེ་ཡིད་ཀྱི་མཐུས་རྟ་ལྔ་བརྒྱ་པོ་དེ་དག་ཐམས་ཅད་ཀྱིས་སྔོན་གྱི་ཚ་བས་རྗེས་སུ་དྲན་པར་གྱུར་ཅིང་དེ་དག་གི་ཁྱད་ཆུབ་ཀྱི་སེམས་དེ་ཡང་མངོན་དུ་གྱུར་བའི་ཕྱིར་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་དུད་འགྲོའི་སྐྱེ་གནས་སུ་སྐྱེས་པ་དེ་དགགི་དོན་དུ་དབྱར་ཟླ་བ་གསུམ་དེནག་བཞལ་གྱིས་བཞེས་སོ།",
    "དེན་རྟལྕབརྒྱ་པོ་དག་གིས་ཆས་ཀྱི་ནས་གང་དག་ཡིན་པ་དེ་དག་ལས་ཕྱེད་ཕྱེད་པ་དགེ་སློང་ལྟ་བཔ་དེ་གལ་འབུལ་ལོ།",
    "ཁྱེད་ཅག་གི་ཆས་ཀྱི་ནས་དག་ཕྱི་དེ་བཞིན་གཤེགས་པ་དང་།",
    "དགའལྡན་གྱི་ལྷ་རྣམས་དང་སྐལ་བ་མཉམ་པར་སྐྱེས་ནས་ལྷར་གྱུར་གིས་ཡང་དེ་བཞིན་གཤེགས་པ་ལ་ཞལ་ཟས་ཕུལ་ཞིང་བཀུརཚུར་བུས།",
    "རོབྲོ་བའི་མཚོག་གི་ཁྱད་པར་གང་དག་ཡིན་པ་དེ་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ན་ཡ་འགའ་ཡང་མེད་དོ།",
    "ང་ལ་འདི་སྐད་ཅེས་བཅོ་ལྡན་འདས་བདག་གི་ཁྱིམ་དུ་སྐྱེས་ཤིང་།",
    "འོད་སྲུང་ང་ནི་རོ་ནུབ་ཀྱི་ཡན་ལག་དག་ཤོད་ཅེས་གསུངས་པར་ཟདཀྱི་རེ་བཞིན་གཤེགས་པའི་སྐུལ་སྙནམངའ་བ་ནི་མ་ཡིནནོ།",
    "རིགས་ཀྱི་བུ་གང་གི་ཚེ་དེ་བཞིན་གཤེགས་པས་གནས་བརྟན་ཀུན་དགའ་བོ་ཡཚིགའདི་སྐད་ཅེས།",
    "གང་གི་ཚེ་སྦྱིན་པ་དེ་ཡང་མི་ཤེས།",
    "གང་གི་ཚེ་ལྷས་བྱིན་གྱིས་དེ་བཞིན་གཤེགས་པ་དགྲོངས་པའི་ཕྱིར།",
    "གཅིག་ལགཅིག་ཕྲག་དོག་གིས་འཐབ་པ་དང་།",
    "རྐང་ལག་དང་སོར་མོ་ཤིན་ཏུ་འཐམ་པ།",
    "ཁང་པ་བརྩེགས་པ་ནོར་བུདང་།",
    "གསེར་ཕུན་སུམཚོགས་ལ་འདོད་པ་དང་ལྡན་པའི་ཡུལ་རྣམས་ཀྱིས་ཀྱང་དྲེགས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀམསུལ་མས་པ་དག་འདོད་སོངས་སྤྱོད་རྒྱས་བའི་ཁྱད་པ་དག་གིས་དྲེགས་པར་མི་འགྱུར་ཏེ།",
    "བཙམ་ལྡན་འདས་ལབ་ར་སྐྱོང་གིས་འདིསྐད་ཅེས་གསོལ་ཏོ།",
    "ལུས་ཀྱི་རྐྱེན་གྱིས་རེག་བྱ་སྟེ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོས་གང་ཡིནཔ་དེའི་ནགི་གཟུགས་སོ།",
    "ལག་པ་གླང་པོ་ཆེ་མཆོག་གི་སྐལྟར་རིང་བ།",
    "ཐལ་གོང་ཡངས་ཤིང་རྒྱས་ལ།",
    "དེ་ཡང་མེ་ལོངགི་རྐྱེན་གྱིས་བཞིན་གྱི་གཟུགས་བརྙནགདུལ།",
    "ལས་འདིདག་ནི་བདག་གི་ཕྱི་བཞིན་འབྲང་ངོ།",
    "རེག་བྱའི་ཁམས་དང་།",
    "འདིནི་བདག་གི་ཁོག་པ་ཨན་སྙམ་དུ་ཡང་ཤེས་སོ།",
    "བཅོམོ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་འདི་ཇི་ནསྙམམོ།",
    "དཔེར་ནས་བན་དེ་མེ་ཏོག་གི་ཁ་དོག་དང་།",
    "ཁྱོནམོངས་པ་བླངས་པརྣམས་ཀྱང་སྲེག་པརབྱེད་དེ།",
    "ས་བོན་དང་མེ་ཏོག་ཀྱང་གཉིས་སུདབྱེར་མ་ལས་ཀྱང་ལས་འབྱུང་ལས་ལས་ཀྱང་ལུས་འབྱུངམོདཀྱི།",
    "དེགཉིས་ཇི་ལྟརདུག་ཆེལ་སློབ་ཆེ་ཞིང་ཡངས་པ་བཞིན་དུ་ནོར་རྒྱས་ཀྱི་བུདང་འཇོག་པོ་གཉིས་ཀྱང་དེ་དང་འདྲའོ།",
    "ལྷའི་བུ་མོ་བས་བསྐོར་བ་མ་མཐོང་ངོ།",
    "དེའཆི་བའི་དུས་ཀྱི་ཚེ་ལྷ་དང་ལྷ་མོ་ལྷནཅིག་ཏུ་ཁྲི་གཅིག་གི་སྟེང་འདུག་ལ།",
    "ལྷམོ་ཁྲིའི་སྟེངན་འདུག་པའི་ལག་པའི་ལག་པའི་སྟེང་དུ་བཞག་ཅིང་དེའི་ལག་པ་གཉིས་ལས་མེ་ཏོག་དག་འབྱུང་སྟེ།",
    "ཇི་ལྟར་མི་ཀྱི་མགཚོགས་ཀྱིས་འཇིགས་ཤིང་སྐག་ནས་རྟ་ཞོན་ཏེ་འབྲོས་པ་དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པའདི་ཐོག་མ་ཤིའཕོས་ནསལྷའི་དམིགས་པས་ཡོངས་སུ་ཟིན་ཅིང་ལྷ་དང་ལྷ་མོ་ཁྲིའི་སྟེང་ནའདུག་པ་མཐོང་ནུས་ཤིན་ཏུ་མྱུར་བར་སྐྱེ་བ་ཡོངས་སུ་ལེནཙོ།",
