    "གསོད་པ་ལ་རྗེས་སུ་ཡི་རང་བར་མི་བྱའོ་སྙམ་མོ།",
    "བློ་བདག་གི་སྲོག་ཕངས་གང་ཡིན་པ།",
    "རང་གི་ཉམས་ལ་དཔག་བགྱིས་ཏེ།",
    "རང་གི་ལུས་ལ་དཔེ་མི་ལོངས་ལ།",
    "ཕག་འབྲི་གཡག་བ་ཕྱུགས་སོགས་དང་རི་དྭགས་སོགས་གསོད་སར་སོང་ནས་རང་དེ་ཡིན་པར་བློ་བཞག་ནས་བསམ་མནོ་བཏང་ན་དར་ཅིག་ནས་ཤ་ཟིང་སྤུ་ཟིང་དུ་འགྱུར་བར་འོངས་ཏེ།",
    "ཐབས་ཤེས་སྤུ་ཙམ་ཡང་མེད་པར་གཞན་གྱི་ལག་འོག་ནས་འཇིགས་སྐྲག་གི་སྣང་བ་ཆེན་པོ་དང་།",
    "ད་ལྟ་རང་རེར་དབུགས་བསུབ་ཅུང་ཟད་ཐེབས་དུས་འཇིགས་དངངས་ཅི་ཙམ་ཡོད།",
    "གཏམ་དཔེར་མི་བསྡད་སར་རང་སྡོད་དགོས་ཟེར་བ་བཞིན་སྲོག་ཆགས་ཀྱི་བསྡད་སར་རང་བསྡད་ནས་བསམ་བློ་བཏང་ན་ཉམས་མྱོང་ཅུང་ཟད་སྐྱེ་ངེས་རེད།",
    "འོན་ཀྱང་སྲོག་གཅོད་ལ་དགའ་བའི་མི་རྣམས་ནི་རང་གི་ཁེ་ཕན་མ་གཏོགས་གཞན་གྱི་སྡུག་བསྔལ་ལ་བསམ་གཞིགས་དང་སེམས་ཁུར་ཅུང་ཟད་ཀྱང་མི་བྱེད་པར་ཅི་མི་སྙམ་དུ་གསོད་མཁན་ཤ་སྟག་ཡིན།",
    "དེང་རབས་ཀྱི་ཡར་ཐོན་གྱི་བསམ་བློ་དང་གཏན་ནས་མི་མཐུན་པ་ཞིག་རེད།",
    "སྦལ་སྦྲུལ་འབུ་སོགས་སྲོག་ཆགས་ཐམས་ཅད་ཁ་ཟས་སུ་བྱེད་པའི་སྲོལ་འདི་འཛམ་གླིང་གི་ཡུལ་གྲུ་གང་སར་དར་ཞིང་།",
    "དེང་སང་བོད་དུའང་དར་བས་བོད་མི་བསམ་བློ་མེད་པ་རྣམས་དེར་སོང་ནས་འཛེམས་མེད་དུ་ཟ་བ་མ་ཟད།",
    "མིག་གི་མཐོང་ཚད་ཀྱི་སྲོག་ཆགས་རྣམས་བསད་དེ་བཟའ།",
    "སྲོག་ཆགས་གསར་པ་ཞིག་མཐོང་ཚེ་ཐོག་མའི་རྣམ་རྟོག་ནི་འདིའི་ཤ་ཟོས་ན་ཞིམ་པོ་ཨེ་ཡོད་སྙམ་པ་དེ་རེད།",
    "ད་དུང་དེ་བས་ཡ་ང་བ་གཞན་ནི་སྲོག་ཆགས་ཕལ་མོ་ཆེ་གསོན་པོར་བཟའ་བ་སོགས་བརྩེ་མེད་ཀྱི་གདུག་སྤྱོད་ཆེས་འཇིགས་སུ་རུང་བ་དག་བྱེད་དེ།",
    "ཉ་དེའི་རོ་སྨད་ནས་ཁམ་རེ་རེ་བཞིན་བཅད་དེ་གསོན་གསོན་དུ་ཟ་བར་བྱེད་དོ།",
    "ཟ་མཁན་རྣམས་ཀྱིས་གད་མོ་དགོད་བཞིན་ཟ་བ་ལས་ལྟ་ཙམ་ཡང་མི་བྱེད་དོ།",
    "ལ་ཀག་ཟླ་བ་ནི་ལས་ཀྱིས་རྣམ་གཞན་ཡང་སྦྲུལ་གསོན་པོའི་མཇུག་མ་ནས་ཟ་ཚོད་རེ་བཅད་དེ་ཟ་ཞིང་།",
    "སྡིག་སྲིན་གསོན་པོ་ལྕགས་ཀྱི་སླ་ངའི་ནང་དུ་བཅུག་ཅིང་ཁ་བཅད་ནས་འོག་ཏུ་མེ་བཏང་བའི་ཚེ་ཚ་རེག་མི་བཟོད་ནས་སླ་ངའི་ནང་དུ་ཕར་རྒྱུག་ཚུར་རྒྱུག་བྱེད།",
    "སྦལ་པ་རྣམས་ཀྱི་མགོ་བཅད་དེ་ཐང་ལ་ལྷུངས་ཚར་ཡང་ད་དུང་ལག་པ་གཉིས་ཀྱིས་རང་གི་མགོའི་གནས་སུ་བསྙབས་ནས་མགོ་ཨེ་ཡོད་ལྟ་བར་བྱེད།",
    "རྒྱུ་འགི་སྟག་གིས་མི་གསོན་པོར་ཟ་བ་དང་།",
    "ལེགས་པར་བསམས་ན་འཇིག་རྟེན་ཐོག་གི་སྲོག་ཆགས་ཡོད་དོ་ཅོག་གི་ནང་ནས་གདུག་རྩུབ་ཆེ་ཤོས་ནི་སྡིག་ཅན་གྱི་མི་དེ་དག་ཡིན་པར་སྣང་སྟེ།",
    "དེ་དག་གི་བྱ་སྤྱོད་ཐམས་ཅད་ཆེས་ཀླ་ཀློའི་སྤྱོད་ཚུལ་ཁོ་ན་རེད།",
    "བྱིས་པ་ཆུང་ངུ་རྣམས་ཀྱང་ཅི་རུང་རུང་གིས་དམར་གསོད་བཏང་ཆོག་པ་མ་ཡིན་ནམ།",
    "ཐ་ན་རྩེད་མོའི་ཕྱིར་དུ་གསོད་པར་བྱེད་ལ།",
    "དེ་ལ་སོ་བཏབ་ཚེ་མི་ལ་ན་ཚ་སོགས་ཡོད་པ་གཏན་ནས་མ་ཤེས་པས་རྐང་བཙུགས་ནས་གནོད་པ་བྱས་པ་མ་རེད།",
    "སྦྲང་བུས་སོ་བཏབ་པའི་ན་ཚ་དེ་མི་ལ་མཚོན་ན་སྡུག་བསྔལ་ཕྲ་མོ་ཞིག་ཡིན་ལ།",
    "ཕྲ་མོ་དེ་མིས་མ་བཟོད་པར་བསམ་བཞིན་དུ་སྦྲང་བུ་ལ་སྲོག་ཐོག་གི་ཆད་པ་གཅོད་པར་བྱེད་པ་དེ་སྦྲང་བུ་ལ་མཚོན་ན་སྐྱེ་བ་ཚེ་གཅིག་གི་རིང་ལ་དེ་ལས་ལྷག་པའི་སྡུག་པོ་དང་།",
    "སྦྲང་བུ་དེ་དག་ཀྱང་རང་གི་སྐྱེ་བ་སྔ་མའི་ཕ་མ་ཡིན་པས་ཉེས་པ་ཕྲ་མོ་དེ་འདྲ་ལ་ཆད་པ་དེ་འདྲ་གཅོད་ག་ལ་རུང་།",
    "ཀྲུང་གོར་ལོ་རེར་ཐ་མག་འཐེན་ནས་ཤི་བའི་མི་གྲངས་དེ་ཁྲི་ཚོ་ལྔ་བཅུ་ཡན་ཟིན།",
    "ཕག་གསོ་རྣམས་སུ་གཟིགས་ན་མཁྱེན་ཐུབ་ལ།",
    "རེ་ཞིག་ན་ཁོའི་ལུས་ཡོངས་ལ་རི་མོ་སེར་པོ་དང་ཐིག་ལེ་ནག་པོས་ཁྱབ་ཅིང་སོ་རྣམས་གཅན་གཟན་གྱི་མཆེ་བ་ལྟར་རིང་པོར་སྐྱེས།",
    "ཤ་རློན་ཟ་ཞིང་རྒྱུད་ཤིན་ཏུ་གཏུམ་པའི་མི་གཟིག་ཏུ་གྱུར་ཏོ།",
    "དམག་འཁྲུག་བཅས་མང་པོ་བྱུང་བ་ནི་སྲོག་བཅད་པའི་ཉེས་པ་ཧ་ཅང་ལྗིད་དྲགས་པའི་རྐྱེན་གྱིས་བྱུང་བ་ཞིག་རེད།",
    "འཛམ་གླིང་འཁྲུག་ཆེན་གཉིས་པ་ཚུན་ཆད་ནས་མི་རྣམས་ཀྱིས་འདི་ནི་ཡང་དག་པའི་ཚན་རིག་གི་ལྟ་བའི་སྔོན་ཐོན་གྱི་ཟས་སྤྱོད་ཡིན་སྙམ་སྟེ་དེའི་རྗེས་སུ་འབྲངས།",
    "གཞུང་དཀར་ནག་གི་འབྲས་སྐྲན།",
    "དེ་ན་མི་རྣམས་ཤ་བཟའ་བ་ནི་ལུས་ཀྱི་དོན་དངོས་གཏན་ནས་མི་འཚམས་ཞེས་བསྟན་ཡོད་པ་རེད།",
    "འོན་ཀྱང་ང་ཚོས་དགེ་སྡིག་ལས་བདེ་སྡུག་འབྱུང་ཞེས་པ་དེ་མ་མཐོང་ངོ་ཞེ་ན།",
    "དགེ་སྡིག་ཅེས་པ་དེ་གཞན་ཞིག་མ་ཡིན་པར་བྱ་བ་དེ་དག་གི་ནུས་པ་ལ་ཟེར་བ་ཡིན།",
    "གལ་ཏེ་ལས་དཀར་པོ་འབའ་ཞིག་དང་ནག་པོ་འབའ་ཞིག་ལས་མེད་ན་འབྲས་བུའང་དཀར་ནག་ཟང་ཐལ་ཞེས་ཡར་གྱི་ཟང་ཐལ་དང་ཡང་ན་མར་གྱི་ཟང་ཐལ་གཉིས་ལས་འགྲོ་ས་གཞན་མེད་མོད།",
    "འགའ་ཞིག་གིས།",
    "འགའ་ཞིག་དུག་ཟོས་ཀྱང་དུག་གི་ནུས་པ་མ་སྨིན་པའི་སྐབས་སུ་འགའ་ཞིག་གིས་ཁྱོད་ལ་ད་ལྟ་ན་ཚ་མི་འདུག་པས་ཁྱོད་ཀྱིས་ཟོས་པ་དེ་དུག་མ་ཡིན་ནོ་ཞེས་བརྗོད་ན་འགྲིག་གམ།",
    "ཞེས་གསུངས་པ་ལྟར་དགེ་སྡིག་གི་ལས་སྣང་ནི་བསམ་གྱིས་མི་ཁྱབ་ཅིང་།",
