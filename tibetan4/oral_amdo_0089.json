    "མོ་གཤམ་གྱི་བུ་བཞིན་དེ་ནི་རྫས་སུ་མེད་པ་ཉིད་དོ།",
    "ཡང་ཚོར་བ་རྣམ་པ་གཉིས་ཏེ།",
    "ལུས་ཀྱི་ནི་རེ་ཞིག་གཟུགས་ཀྱི་ཕུང་པོས་བསྡུས་པའི་ཕྱིར་ཉེ་བར་མི་དམིགས་སོ།",
    "ཚོར་བ་དང་འདུ་ཤེས་དང་སེམས་པ་དང་འདུན་པ་དང་རེག་པ་དང་།",
    "བློ་གྲོས་དྲན་པ་དང་ཡིད་ལ་བྱེད་པ་དང་མོས་པ་ཞེས་བྱ་བ་སེམས་ལས་བྱུང་བ་འདི་རྣམས་དང་།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་དེ་རྣམས་རེ་རེ་འམ་སོ་སོ་བ་རང་བཞིན་མི་དམིགས་སོ།",
    "དེ་ལྟར་མིག་ལ་བརྟེན་ནས་གཟུགས་རྣམས་ལ་མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་གཟུགས་ཀྱི་ཕུང་པོ་ཉིད་ཡོད་ན་མིག་དང་གཟུགས་ལས་སྐྱེ་ན།",
    "དེ་ལྟར་རེ་ཞིག་མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེ་བའོ།",
    "དེ་ལྟར་རེ་ཞིག་འདས་པའི་རྣམ་པར་ཤེས་པ་ནི་འགགས་པའོ།",
    "རེ་ཞིག་གཟུང་བ་མེད་པ་ཇི་ལྟར་ཞེ་ན།",
    "གསང་བ་པའི་བདག་པོ་སེམས་ནི་སྔོན་པོ་མ་ཡིན་སེར་པོ་མ་ཡིན་དཀར་པོ་མ་ཡིན་དམར་པོ་མ་ཡིན་བཙོད་ཀ་མ་ཡིན་ཤེལ་གྱི་ཁ་དོག་མ་ཡིན་རིང་པོ་མ་ཡིན་ཐུང་ངུ་མ་ཡིན་ཟླུམ་པོ་མ་ཡིན་གྲུ་བཞི་མ་ཡིན་སྣང་བ་མ་ཡིན་མུན་པ་མ་ཡིན་བུད་མེད་མ་ཡིན་སྐྱེས་པ་མ་ཡིན་མ་ནིང་མ་ཡིན།",
    "དེ་ལྟར་ན་རེ་ཞིག་གཟུང་བའི་སེམས་དེ་མེད་པ་ཡིན་ནོ།",
    "གང་འདི་དག་རང་གི་སེམས་ཀྱི་རང་བཞིན་མ་རྟོགས་པ།",
    "འདི་ནི་བདག་གི་གཉེན་ཡིན་ནོ་སྙམ་ནས།",
    "དེ་ལ་བྱམས་པ་ནི་མོས་པས་སྤྱོད་པའི་ས་ནི་ངེས་པར་འབྱེད་པའི་ཆ་བཞི་པོ་སྣང་བ་ཐོབ་པ་དང་སྣང་བ་མཆེད་པ་དང་།",
    "ཐོག་མར་འབྲིང་ཙམ་དུ་སྡུག་པ་དེ་ཕ་མ་ལ་སོགས་པར་རབ་ཏུ་བསྒོམ་མོ།",
    "དེ་ནས་ནི་མཐའ་ཡས་པར་བསྒོམ་མོ་ཞེས་བྱ་བའི་དོན་བསྟན་ཏོ།",
    "འདི་ལྟར་བདག་གིས་ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པ་རྙེད་པ་ན་དེ་ལ་དགའ་བ་སྟེ་ཆགས་པ་ཡང་མེད་ལ།",
    "བདག་གི་མཛའ་བོ་བྱམས་པ་ཞིག་གིས་བདག་གི་ལུས་ལ་སྤོས་དང་ཙནྡན་ལ་སོགས་པའི་བྱུག་པས་ཉུག་ཅིང་བསྙེན་བཀུར་དང་བསྟི་སྟང་བྱེད་ན་བཀུར་སྟིའི་བདེ་བ་ལ་དགའ་ཞིང་ཆགས་པ་ཡང་མེད་ལ།",
    "དགྲ་བོ་ཞིག་གིས་བདག་གི་ལུས་ལ་བརྡེག་བརྡུང་ལ་སོགས་པ་བྱེད་ན་ཡང་དེ་ལའང་མི་ཁྲོ་ཞིང་བརྡེག་བརྡུང་གི་སྡུག་བསྔལ་དང་དུ་བླང་བ་དང་།",
    "བདག་གི་མཛའ་བོ་ཞིག་གིས་བདག་གི་རིགས་ལས་གླེངས་ཏེ་སྙན་པའི་ཚིག་གིས་བསྟོད་ན་དེ་ལ་དགའ་ཞིང་གཟེངས་མཐོ་བར་འགྱུར་བ་ཡང་མེད་ལ།",
    "དགྲ་བོ་ཞིག་གིས་བདག་གི་སྐྱོན་བྲུས་ཤིང་བསྒྲགས་ན་ཡང་དེ་ལ་ཡང་མི་དགའ་ཞིང་དཔའ་ཞུམ་པ་མེད་པ་ནི་བསྟོད་པ་དང་སྨད་པ་ལ་དགའ་བ་དང་།",
    "བདག་གི་ཡོན་ཏན་ཡོད་པ་སྐྱེ་བོ་མང་པོས་ཐོས་ཤིང་ཤེས་པར་གྱུར་པ་ན་འདི་སྙམ་དུ་བདག་ནི་ཡོན་ཏན་ཅན་དུ་སྐྱེ་བོ་མང་པོས་ཤེས་པས་བདག་གི་ཡོན་ཏན་གྲགས་ཏེ་མ་སུབས་སོ་ཞེས་ཡོན་ཏན་གྲགས་པ་ལ་དགའ་བ་ཡང་མེད་ལ།",
    "བདག་གི་ཡོན་ཏན་སྐྱེ་བོ་མང་པོས་མ་ཐོས་ཤིང་མ་ཤེས་ན་ཡང་བདག་གི་ཡོན་ཏན་མ་གྲགས་ཏེ།",
    "ཚོགས་ཞེས་བྱ་བ་ནི་གོང་གི་ཚིག་སྟེ།",
    "ལོ་བརྒྱར་ཡང་ལ་ལས་མཆིལ་མའི་ཐལ་བ་དང་།",
    "གང་དག་གཟུགས་དང་གཟུགས་མེད་པ་ན་སྤྱོད་པ་དེ་དག་ཀྱང་སྐད་ཅིག་སྡུག་བསྔལ་གྱིས་སྡུག་བསྔལ་བ་ལས་འདས་མོད་ཀྱི།",
    "འདི་ལྟར་རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ནི་བྱ་བ་མང་བྱེད་པ་མང་སྟེ།",
    "བདག་གི་འདས་པ་དང་།",
    "རྗེས་སུ་ཡི་རང་བའི་མཆོག་གིས་རྗེས་སུ་ཡི་རང་བར་གྱིས་ཤིག།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་དེ་ལྟར་ཞུགས་ལ་རྒྱལ་པོ་གྱིས་ཤིག།",
    "ཀུན་ནས་ཉོན་མོངས་པར་མི་འགྱུར་རོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁྱོད་མོས་པར་བྱའོ།",
    "ཁྱོད་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ང་ཀ་ཤི་ཀའི་རྒྱལ་པོར་གྱུར་པ་གང་ཡིན་པ་དེས་འདི་ལྟར་ཕུག་རོན་གྱི་ཕྱིར་བདག་གི་ཤ་ཁྲ་ལ་བྱིན་པ་དེ་ཤེས་རབ་འཆལ་པ་ཡིན་ནམ།",
    "མ་ཕམ་པ་ཁྱོད་ཀྱིས་བསྐལ་པ་དྲུག་ཅུར་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་བསྒྲུབས།",
    "དེ་ལ་ཐོག་མར་རེ་ཞིག་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་རབ་བསྐྱེད་པར་བྱ་སྟེ།",
    "དེས་རེ་ཞིག་ལུང་གི་དོན་ཀུན་ཏུ་འཛིན་པར་བྱེད་དོ།",
    "ཡང་དག་པའི་དངོས་པོའི་རང་གི་ངོ་བོ་ནི་དོན་དམ་པར་ན་སྐྱེ་བ་མེད་པ་ཁོ་ན་སྟེ།",
    "རིགས་པ་དང་ལུང་གིས་གཏན་ལ་དབབ་བོ།",
    "རང་གི་མཚན་ཉིད་ཀྱིས་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་བཀའ་སྩལ་ཏོ།",
    "དེ་ལྟར་རེ་ཞིག་ལུང་གིས་བརྟག་པར་བྱའོ།",
    "རིགས་པས་བརྟག་པར་བྱས་ན་ལུང་གི་དོན་གུད་དུ་བཀྲི་མི་ནུས་ཏེ།",
    "རྟག་པ་ཡིན་པས་དེ་ལ་གཞན་དག་གིས་ཕན་གདགས་མི་དགོས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་རེ་ཞིག་དེ་དག་ནི་རྟག་པ་ལས་སྐྱེར་མི་རུང་ངོ།",
    "དཔེར་ན་རྡུལ་ཕྲ་རབ་རྣམས་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་འདྲེས་ནས་གོང་བུ་རྡུལ་ཕྲ་མོ་ཙམ་ཉིད་དུ་འགྱུར་བ་བཞིན་ནོ།",
    "ཇི་སྟེ་ཕྱོགས་གཅིག་གིས་ཕྲད་ན་ནི་དེའི་ཚེ་སྐད་ཅིག་ལ་ཆ་ཤས་ཡོད་པར་འགྱུར་རོ།",
    "དེ་ལ་རེ་ཞིག་གཟུགས་ཅན་བུམ་པ་ལ་སོགས་པ་དེ་དག་ནི་རྡུལ་ཕྲ་མོ་ཐ་དད་པའི་ངོ་བོ་ཉིད་ཡིན་པས་ན་རང་བཞིན་གཅིག་པ་མ་ཡིན་ནོ།",
    "རྡུལ་ཕྲ་མོ་ཤར་ནུབ་ན་གནས་པ་རྣམས་ཀྱང་ཤར་ལ་སོགས་པའི་ཕྱོགས་དང་ལྡན་པ་ཉིད་ཀྱིས་ཐ་དད་པ་རྣམས་ཀྱང་རྣམ་པར་ཕྱེ་ན་མི་འགྲུབ་པའི་ཕྱིར་རྡུལ་ཕྲ་མོ་རྣམས་ནི་བསགས་པའི་བདག་ཉིད་ཡིན་པས་ན།",
    "བློ་གྲོས་ཆེན་པོ་གླང་གི་རྭ་ཡང་རྡུལ་ཕྲ་མོར་བཤིག་ན་མི་འདུག་གོ།",
    "རྡུལ་ཕྲ་མོ་རྣམས་ཀྱང་སོ་སོར་བཤིག་ན་རྡུལ་ཕྲ་མོའི་མཚན་ཉིད་ལས་མི་གནས་སོ་ཞེས་སོ།",
    "རང་གི་སེམས་ནི་ཕྱི་རོལ་སྣང་།",
    "གང་གི་ངོ་བོ་ཉིད་གཅིག་ཏུ་མ་གྲུབ་པའི་ཕྱིར་དུ་མའི་ངོ་བོར་ཡང་མི་རུང་སྟེ།",
    "གཟུགས་ལ་སོགས་པའང་བདག་ཉིད་ཀྱིས་སྣང་བར་བྱེད་ན་རྣམ་པར་ཤེས་པའི་རང་གི་ངོ་བོར་གྱུར་པ་རྣམས་བརྫུན་པ་ཉིད་ཡིན་པས་རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ཀྱང་བརྫུན་པ་ཡིན་པར་ཁས་བླངས་པར་གྱུར་ཏོ།",
    "ཁྱོད་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱ།",
    "མོས་པར་བྱ།",
    "དེ་ལ་རྣལ་འབྱོར་པས་སེམས་གནས་པར་བྱ་བའི་ཕྱིར་ཐོག་མ་ཁོ་ནར་རེ་ཞིག་ཞི་གནས་བསྒྲུབ་པར་བྱའོ།",
    "གཟུགས་ཅན་མ་ཡིན་པའི་བྱེ་བྲག་གིས་རྣམ་པ་གཉིས་ཏེ།",
    "ལས་དང་པོ་པའི་རྣམ་པར་གཡེང་བའི་ཉེས་པ་བསལ་བའི་ཕྱིར་རེ་ཞིག་འདུས་པ་དེ་ལ་ནི་དམིགས་པའི་རིགས་སོ།",
    "གང་གི་ཚེ་ཡིད་ལ་བྱེད་པ་ཁུགས་པར་གྱུར་པ་དེའི་ཚེ་ཕུང་པོ་དང་ཁམས་ལ་སོགས་པའི་བྱེ་བྲག་གིས་རྒྱས་པར་ཡང་དམིགས་པར་བྱེད་པ་ཁོ་ན་སྟེ།",
    "འདི་སྐད་དགོངས་པ་ངེས་པར་འགྲེལ་པ་ལ་སོགས་པ་ལས་ཀྱང་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་སྟོང་པ་ཉིད་རྣམ་པ་བཅོ་བརྒྱད་ལ་དམིགས་པ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་དམིགས་པའི་རྣམ་པ་ཀུན་ཏུ་བཀའ་སྩལ་ཏོ།",
    "གང་གི་ཚེ་བར་སྐབས་སུ་འདོད་ཆགས་ལ་སོགས་པས་སེམས་ཕྱི་རོལ་དུ་རྣམ་པར་གཡེང་བར་བྱེད་པ་དེའི་ཚེ་རྣམ་པར་གཡེང་བར་ཤེས་པར་བྱས་ལ་མི་སྡུག་པ་ལ་སོགས་པ་བསྒོམས་པས་རྣམ་པར་གཡེང་བ་ཞི་བར་བྱས་ཤིང་མྱུར་དུ་དེ་ཉིད་ལ་སེམས་ཕྱི་ཕྱིར་གཞུག་པར་བྱའོ།",
    "གང་གི་ཚེ་ལ་མི་དགའ་བར་མཐོང་བ་དེའི་ཚེ་ཏིང་ངེ་འཛིན་གྱི་ཡོན་ཏན་ལ་ལྟ་བས་དེ་ལ་དགའ་བ་བསྒོམ་ཞིང་རྣམ་པར་གཡེང་བ་ལ་ཉེས་པར་ལྟ་བས་མི་དགའ་བ་རབ་ཏུ་ཞི་བར་བྱའོ།",
    "ཇི་སྟེ་གང་གི་ཚེ་རྨུགས་པ་དང་གཉིད་ཀྱིས་ནོན་ཏེ།",
    "དེ་རྣམས་ཀྱི་གཉེན་པོར་སྤོང་བའི་འདུ་བྱེད་བརྒྱད་བསྒོམ་མོ།",
    "དེ་ནས་འདོད་པས་བརྩོན་འགྲུས་རྩོམ་མོ།",
    "དེ་བས་ན་དད་པ་ལ་སོགས་པ་ནི་ལེ་ལོ་སྤང་བའི་ཕྱིར་བསྒོམ་མོ།",
    "དེའི་གཉེན་པོར་སེམས་པ་བསྒོམ་མོ།",
    "གང་གི་ཚེ་སེམས་རྣལ་དུ་འཇུག་པ་དེའི་ཆེ་རྩོལ་བ་ཉེས་པ་ཡིན་ཏེ།",
    "དེའི་གཉེན་པོར་དེའི་ཚེ་བཏང་སྙོམས་བསྒོམ་མོ།",
    "འདི་ལྟར་གང་གི་ཚེ་བཏང་སྙོམས་ཀྱི་ཚོར་བ་དང་ལྡན་ཞིང་རྟོག་པ་དང་བཅས་པ་དང་།",
    "གང་གི་ཚེ་འདོད་པའི་སྲེད་པ་དང་།",
    "གང་གི་ཚེ་རྟོག་པ་དང་དཔྱོད་པ་དང་བྲལ་ཏེ་བསམ་གཏན་དང་པོའི་སའི་སྲེད་པ་དང་བྲལ་བར་གྱུར་ནས་དགའ་བ་དང་བདེ་བ་དང་།",
    "གང་གི་ཚེ་བསམ་གཏན་གཉིས་པའི་སའི་སྲེད་པ་དང་བྲལ་བར་གྱུར་ཏེ་བདེ་བ་དང་།",
    "གང་གི་ཚེ་བསམ་གཏན་གསུམ་པའི་སའི་སྲེད་པ་དང་བྲལ་ཏེ་སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་ཞིང་།",
    "ཟིལ་གྱིས་གནོན་པའི་སྐྱེ་མཆེད་ལ་སོགས་པ་ཡང་དམིགས་པ་དང་རྣམ་པ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་སྦྱར་བར་བྱའོ།",
    "དེ་ལྟ་མ་ཡིན་ན་མུ་སྟེགས་ཅན་རྣམས་ཀྱི་བཞིན་དུ་ཏིང་ངེ་འཛིན་ཙམ་གྱིས་ཉོན་མོངས་པ་སྤོང་བར་མི་འགྱུར་རོ།",
    "དེ་ཡི་ཉོན་མོངས་ཕྱིར་ཞིང་རབ་འཁྲུག་སྟེ།",
    "དེ་ལྟར་རྣལ་འབྱོར་པ་གང་གི་ཚེ་གཉིས་མེད་པའི་ཤེས་པ་སྣང་བ་མེད་པའི་ཤེས་པ་ལ་གནས་པར་གྱུར་པ་དེའི་ཚེ།",
    "ཤེས་རབ་ཀྱི་མིག་གིས་བརྟགས་ན་གཟུགས་ལ་སོགས་པ་སྔར་དམིགས་པ་དམིགས་སུ་རུང་བའི་མཚན་ཉིད་དུ་གྱུར་པ་དེ་དག་མི་དམིགས་པའི་ཕྱིར་ཐག་པ་ལ་སྦྲུལ་དུ་ཤེས་པ་བཞིན་དུ་སྤང་གི།",
    "ཤེས་རབ་ཀྱི་མིག་གིས་མ་བལྟས་ན་མུན་ཁུང་ན་འདུག་པའི་མི་ལྟར་ཁྱིམ་གྱི་ནང་ན་ཡོད་པའི་བུམ་པ་ལ་སོགས་པ་སོམ་ཉི་ཟ་བར་གྱུར་པ་བཞིན་དུ་རྣལ་འབྱོར་པ་ཡང་གཟུགས་ལ་སོགས་པ་ཡོད་པར་སོམ་ཉི་ཟ་བ་ལྡོག་པར་མི་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་ཏིང་ངེ་འཛིན་གྱི་ལག་གིས་སེམས་གཟུང་སྟེ་ཤིན་ཏུ་ཆ་ཕྲ་བའི་ཤེས་རབ་ཀྱི་མཚོན་གྱིས་གཟུགས་ལ་སོགས་པ་ལོག་པར་རྣམ་པར་རྟོག་པའི་ས་བོན་གྱི་ཟུག་རྔུ་སེམས་དེ་ལ་ཡོད་པ་བསལ་བར་བྱའོ།",
    "འདི་ལྟར་གང་གི་ཚེ་ཞི་གནས་ཀྱིས་དམིགས་པ་ལ་སེམས་བརྟན་པར་བྱས་པ་དེའི་ཚེ་ཤེས་རབ་ཀྱིས་རབ་ཏུ་བརྟགས་ན་ཡང་དག་པའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་འབྱུང་སྟེ།",
    "གང་གི་ཚེ་རྣལ་འབྱོར་པས་ཤེས་རབ་ཀྱི་མིག་གིས་བརྟགས་ན་དུས་གསུམ་དུ་ཡང་དངོས་པོ་མི་དམིགས་པ་དེའི་ཚེ་ཅི་ཞིག་བཀག་པས་དངོས་པོ་མེད་པར་རྣམ་པར་རྟོག་པར་བྱེད།",
    "ཉོན་མོངས་པའི་སྒྲིབ་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་ཡང་དག་པར་སྤོང་ངོ།",
    "འདི་ལྟར་ཉོན་མོངས་པའི་སྒྲིབ་པ་ནི་མ་སྐྱེས་པ་དང་མ་འགགས་པའི་དངོས་པོ་རྣམས་ལ་དངོས་པོ་ལ་སོགས་པར་ཕྱིན་ཅི་ལོག་པའི་རྩ་བ་སྟེ་རྒྱུ་ཡིན་ནོ་ཞེས་འཕགས་པ་བདེན་པ་གཉིས་བསྟེན་པ་ལ་སོགས་པ་ལས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་ཏོ།"
  ]
}