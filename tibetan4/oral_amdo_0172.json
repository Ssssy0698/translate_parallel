    "དཔེར་ན་མ་མཐོང་བའི་གཡང་ས་ཆེན་པོ་དང་ཐལ་བས་གཡོགས་པའི་མེ་དོང་དང་འདྲ་གཞུང་དང་གདམས་ངག་ཟུང་འཇུག་བདུད་རྩིའི་བུམ་བཟང་བས།",
    "ནང་གི་ཐུགས་དགོངས་མི་ཤེས་པས།",
    "སྲོག་གི་ཕྱིར་ཡང་ཤེས་བཞིན་དུ་རྫུན་མི་སྨྲ་བ་དང་།",
    "བདག་དགེ་ཉམས་ཤིང་གཞན་སེམས་འཁྲུགས་པའི་ལས་ཕྲ་མོ་ཙམ་ཡང་མི་གསོག་པ་ནི།",
    "གསུམ་པ་སྦྱིན་བདག་གི་ཁྱིམ་ལ་ཆགས་པ་སྤོང་བ་ནི་རྩ་བར།",
    "སྦྱིན་བདག་གི་ཁྱིམ་རྣམས་ལ་ཆགས་པ་སྤོང་བ་གཞུང་དང་གདམས་ངག་ཟུང་འཇུག་བདུད་རྩིའི་བུམ་བཟང་།",
    "མེ་ཡི་ནང་གི་པདྨོ་བཞིན།",
    "རྒྱལ་སྲས་ལག་ལེན་སོ་བདུན་གྱི་འགྲེལ་པ་བཞི་པ་རྩུབ་མོའི་ཚིག་སྨྲ་བ་སྤོང་བ་ནི་རྩ་བར།",
    "རྩུབ་མོའི་ཚིག་གིས་གཞན་སེམས་འཁྲུག་འགྱུར་ཞིང་།",
    "རྣར་མི་སྙན་པ་སོགས་ཚིག་གི་སྐྱོན་མང་པོ་སྤངས་ནས།",
    "སྤང་བྱ་ལོག་པར་སྨྲ་བ་ཀུན་ནས་མནར་སེམས་སྐྱེ་བའི་གཞིར་འགྱུར་བ་མི་གཙང་བ་ལྟ་བུ་དུག་གསུམ་གང་རུང་གིས་བསླབ་པའི་ཚིག་མི་སྙན་པར་བརྗོད་པའོ།",
    "རྟག་ཏུ་འཛུམ་པའི་བཞིན་དང་བྱམས་པའི་ཡིད་ཀྱི་ཁྲོ་མེད་གསོང་པོར་སྨོས།",
    "དེ་ཡང་འཇམ་རྩུབ་གང་གི་སྒོ་ནས་བརྗོད་ཀྱང་ཕན་སེམས་འབའ་ཞིག་ཡིན་ན་མ་གཏོགས་ཚིག་རྩུབ་ཏུ་འགྲོ་བས།",
    "རྩུབ་མོའི་ཚིག་གཏན་ནས་སྤངས་ཏེ།",
    "རྒྱལ་སྲས་རྣམས་ཀྱི་རྩུབ་མོའི་ཚིག་སྤོང་བའི་ལག་ལེན་ནོ།",
    "བདག་གི་འཁྲུལ་པ་ལ་སོ་སོར་བརྟགས་པ་དང་།",
    "མཛའ་བཤེས་ཀྱི་ཁྱིམ་དང་སློང་མོ་སྟེར་བའི་ཁྱིམ་ལ་མི་བལྟ་བ་དང་།",
    "གསུམ་པ་ཉོན་མོངས་སྤོང་ཚུལ་ལ་བསླབ་པ་ནི་རྩ་བར།",
    "ཉོན་མོངས་གོམས་ན་གཉེན་པོས་བཟློག་བཀའ་བས།",
    "ཆགས་སོགས་ཉོན་མོངས་དང་པོ་སྐྱེས་མ་ཐག།",
    "ཆགས་སོགས་ཉོན་མོངས་པ་རྣམས་ཅི་སྐྱེ་སྐྱེ་ལ་གཉེན་པོ་མ་བསྟེན་པར།",
    "སྒོ་གསུམ་གྱི་གནས་སྐབས་ཅིར་འགྱུར་རྟོག་པའི་ཤེས་བཞིན་གྱི་སྐྱེས་བུས་གཉེན་པོའི་མཚོན་ཆ་ཤིན་ཏུ་རྣོན་པོས་སྟོབས་ཤུགས་དང་ལྡན་པའི་མཚོན་བཟུང་ནས་ཆགས་སོགས་ཉོན་མོངས་པ་དང་པོ་སྐྱེས་པ་ལ་ཕྱོགས་པ་འམ།",
    "ཉོན་མོངས་དང་པོ་ནས་མགོ་འབུར་བ་ངོས་ཟིན་པ་བྱས་ཏེ།",
    "དང་པོ་བྱུང་ཙ་ན་དང་དུ་བླངས་ན་ཁོ་སྟོབས་ཆེ་རུ་སོང་ནས་སྤང་དཀའ་བས།",
    "སྐྱེས་བུ་དགྲ་ཐབས་ལ་མཁས་པ་ལྟར་ཉོན་མོངས་པའི་གཉེན་པོ་བསྟེན་པ་ལ་མཁས་དགོས་པ་དང་།",
    "ཉོན་མོངས་སྐྱེས་མ་ཐག་འགོག་དགོས་པ་དང་།",
    "ཉོན་མོངས་ལ་ཤིན་ཏུ་བསྒྲིམས་ནས་སྤོང་དགོས་པ་སོགས་མང་ངོ།",
    "ཉོན་མོངས་བྱུང་ན་གཉེན་པོ་དྲན་དགོས་པ་ཡིན།",
    "སྙིགས་མའི་དུས་འདིར་ཉོན་མོངས་ཤས་ཆེ་བ་ལ་བསམ་སྟེ་བསྐུལ་མ་ཡང་ཡང་གདབ་གསུངས།",
    "ཉོན་མོངས་པའོ་གསུངས།",
    "རྗེ་རྒྱལ་སྲས་པ་གང་གིས་ཀྱང་།",
    "དེ་ལྟར་རྒྱལ་སྲས་རྣམས་ཀྱིས་ཉོན་མོངས་ལ་གཉེན་པོ་བསྟེན་ཚུལ་གྱི་ལག་ལེན་ནོ།",
    "རང་གི་སེམས་ཀྱི་གནས་སྐབས་ཅི་འདྲ་ཞེས།",
    "གནས་གང་དུ་སྤྱོད་ལམ་རྣམ་བཞི་ཅི་བྱེད་ཀྱང་རང་གི་སེམས་ཀྱི་གནས་སྐབས།",
    "གདམས་ངག་གི་མཆོག་རྟག་ཏུ་རང་སེམས་ལ་བལྟ་བ་ཡིན།",
    "མི་སྲུན་རྟ་དང་བུད་མེད་གླང་།",
    "རྫོགས་བྱང་དུ་བསྔོ་མ་ཤེས་ན་ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་འབའ་ཞིག་གིས་འཛད།",
    "གོང་གིས་ལོག་རྒྱལ་སྲས་ལག་ལེན་སོ་བདུན་གྱི་འགྲེལ་པ་པར་བསྔོ་བ་རྣམས་སྤངས་ནས།",
    "ལས་དང་པོའི་གང་ཟག་གིས་མི་འོང་བས་ན།",
    "འཁོར་གསུམ་ཡོངས་དག་གི་བསྔོ་བའི་གོ་ཆོད་དེ།",
    "གང་གི་དོན་དུ་ཇི་ལྟར་བརྩམས་པ།",
    "དང་པོ་གང་གི་དོན་དུ་ཇི་ལྟར་བརྩམས་པ་ནི་རྩ་བར།",
    "དམ་པ་རྣམས་ཀྱི་གསུང་གི་རྗེས་འབྲངས་ནས།",
    "དེ་དག་གི་དགོངས་པ་འབྲེལ་བའི་བསྟན་བཅོས་རྣམས་ལས་ལེགས་པར་གསུངས་པའི་དོན།",
    "སྤྱན་རས་གཟིགས་མགོན་དེ་དང་མཚུངས་པར་ཤོག།",
    "གང་གིས་བརྩམས་པ།",
    "དེ་ནས་ཇོ་བོ་ཡབ་སྲས་དང་གསར་རྙིང་གི་སེམས་དཔའ་ཆེན་པོ་རྣམས་ཀྱི་གསུང་གི་གཞུང་དང་གདམས་ངག་ཟུང་འཇུག་བདུད་རྩིའི་བུམ་བཟང་།",
    "འཆི་མེད་ཞི་བ་མཆོག་གི་དཔལ་སྟེར་བྱེད།",
    "ཚིག་གི་ཟེགས་མ་རེས་ཀྱང་དུག་གསུམ་གྱི།",
    "འཛམ་གླིང་ཡངས་པའི་ཁྱོན་ལ་འཚེ་མེད་ཞི་བའི་ལམ་སྟོན་རྣམ་འདྲེན་ཤཱཀྱ་སེང་གེའི་རིང་ལུགས་སྒོ་ཀུན་ནས་རྒྱས་པ་སོགས་འཕྲལ་ཡུན་ལེགས་ཚོགས་དུ་མའི་ཆེད་དུ་དམིགས།",
    "དེ་དག་གི་སྒྲ་དོན་རིམ་བཞིན་བརྗོད་ན།",
    "གཞུང་ཚིག་མི་མཐུན་པ་རྣམས་ཕན་ཚུན་དཔྱད་བསྡུར་དང་བརྟག་ཞིབ་བྱས་ཏེ་མ་དག་རྒྱུན་འབྱམས་སུ་སོང་བ་མི་ཉུང་བ་ཞིག་ལ་གསལ་དག་གཙང་གསུམ་གྱི་ལེགས་བཅོས་ཞུ་ཐུབ་པ་བྱུང་བ་ནི།",
    "ཞུ་དག་གི་ལས་རིམ་ཁྲོད་ཀྱི་གྲུབ་འབྲས་བཟང་ཤོས་ཡིན་སྙམ་པས་ཡིད་སེམས་སྤྲོ་བའི་དཔལ་ཡོན་རབ་ཏུ་བརྟས།",
    "འདིར་རྒྱ་ཆེའི་གཟིགས་པ་པོ་རྣམས་ཀྱིས་འཕྲལ་དུ་བརྗོད་དོན་གང་མཁོ་མྱུར་འཚོལ་བྱེད་ཐབས་སུ་དེང་དུས་ཀྱི་སྲོལ་བཞིན་དཀར་ཆག་ཀླད་དུ་བཀོད་ཅིང་།",
    "མཁྱེན་བཟང་རལ་གྲི་རྣོན་པོས་ཉོན་མོངས་གཅོད།",
    "ཟབ་མོ་སྔགས་ཀྱི་ལམ་བཟང་གསལ་མཛད་པ།",
    "བྱེ་བྲག་རང་ཅག་གི་སྟོན་པ་འབྱོན་ཚུལ་གཉིས་ཀྱི།",
