    "བ་སྤུའི་བུ་ག་རེ་རེར་ཇི་ལྟ་བ་དེ་བཞིན་དུ་བ་སྤུའི་བུ་ག་མ་ལུས་པ་ཐམས་ཅད་ལ་ཡང་སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ལ་འཇིག་རྟེན་གྱི་ཁམས་བརྗོད་དུ་མེད་པའི་ཡང་བརྗོད་དུ་མེད་པའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་རྣམ་པར་གནོན་པ་ཕྱི་མའི་མཐའི་མུར་ཐུག་པའི་བསྐལ་བར་བྱིན་གྱིས་བརླབས་པ།",
    "བདག་གིས་མ་ལུས་དེ་དག་ཐམས་ཅད་ལ།",
    "ཞིང་གི་རྡུལ་སྙེད་ལུས་རབ་བཏུད་པ་ཡིས།",
    "ཐམས་ཅད་རྒྱལ་བ་དག་གིས་གང་བར་མོས།",
    "བདེ་བར་གཤེགས་པ་ཐམས་ཅད་བདག་གིས་བསྟོད།",
    "དེ་དག་རྒྱལ་བ་ཐམས་ཅད་ལ་ཡང་མོས།",
    "བཟང་པོ་སྤྱོད་ལ་དད་པའི་སྟོབས་དག་གིས།",
    "དེ་དག་ཐམས་ཅད་བདག་གིས་སོ་སོར་བཤགས།",
    "མགོན་པོ་དེ་དག་བདག་གིས་ཐམས་ཅད་ལ།",
    "བསྐལ་བ་ཞིང་གི་རྡུལ་སྙེད་བཞུགས་པར་ཡང་།",
    "བདག་གིས་ཐལ་མོ་རབ་སྦྱར་གསོལ་བར་བགྱི།",
    "འཐུན་པར་གྱུར་ཅིང་རེ་བའང་གྲུབ་པར་ཤོག།",
    "ལས་དང་ཉོན་མོངས་བདུད་ཀྱི་ལས་རྣམས་ལས།",
    "ཇི་ལྟར་པད་མོ་ཆུས་མི་ཆགས་པ་བཞིན།",
    "ཞིང་གི་ཁྱོན་དང་ཕྱོགས་རྣམས་ཇི་ཙམ་པར།",
    "ངན་སོང་སྡུག་བསྔལ་རབ་ཏུ་ཞི་བར་བྱེད།",
    "བདག་གི་སྤྱོད་དང་མཚུངས་པར་གང་སྤྱོད་པ།",
    "དེ་དག་བདག་གིས་ནམ་ཡང་ཡིད་མི་དབྱུང་།",
    "མངོན་སུམ་རྟག་ཏུ་བདག་གིས་རྒྱལ་བ་ལྟ།",
    "སྐྲ་ཙམ་ཁྱོན་ལ་དུས་གསུམ་ཚད་སྙེད་ཀྱི།",
    "དེ་དག་གི་ཡང་གསུང་དབྱངས་མྱི་ཟད་ལ།",
    "སྐད་ཅིག་གཅིག་གིས་བདག་ཀྱང་འཇུག་པར་བགྱི།",
    "དེ་དག་སྐད་ཅིག་གཅིག་ལ་བདག་གིས་བལྟ།",
    "རྟག་ཏུ་དེ་དག་གི་ནི་སྤྱོད་ཡུལ་ལ།",
    "གང་ཡང་དུས་གསུམ་དག་གི་ཞིང་བཀོད་པ།",
    "རྒྱལ་བ་རྣམས་ཀྱི་ཞིང་གི་རྒྱན་ལ་འཇུག།",
    "ཀུན་ཏུ་ཁྱབ་པ་བྱམས་པ་དག་གི་སྟོབས།",
    "ཤེས་རབ་ཐབས་དང་ཏིང་འཛིན་སྟོབས་དག་གིས།",
    "ཉོན་མོངས་སྟོབས་རྣམས་ཀུན་ཏུ་འཇོམས་པར་བྱེད།",
    "དེ་ཀུན་བདག་གིས་མ་ལུས་རྫོགས་པར་བགྱི།",
    "གང་གི་མིང་ནི་ཀུན་ཏུ་བཟང་ཞེས་བྱ།",
    "ཅི་ཙམ་ལས་དང་ཉོན་མོངས་མཐར་གྱུར་པ།",
    "ཞིང་གི་རྡུལ་སྙེད་བསྐལ་བར་ཕུལ་བ་བས།",
    "གང་གིས་བསྔོ་བའི་རྒྱལ་པོ་འདི་ཐོས་ནས།",
    "དེས་ནི་ངན་སོང་ཐམས་ཅད་སྤོང་བར་འགྱུར།",
    "དེ་དག་གི་ནི་རྗེས་སུ་བདག་སློབ་ཅིང་།",
    "དེ་དག་མ་ལུས་བདག་གིས་ཡོངས་སུ་བསྐང་།",
    "པད་མོ་དམ་པ་ཤིན་ཏུ་མཛེས་ལས་སྐྱེས།",
    "ལུང་བསྟན་པ་ཡང་བདག་གིས་དེར་ཐོབ་ཤོག།",
    "དེར་ནི་བདག་གིས་ལུང་བསྟན་རབ་ཐོབ་ནས།",
    "གང་གིས་བཟང་པོ་སྤྱོད་པ་སྟོན་པ་ཡིས།",
    "སྐད་ཅིག་གཅིག་གིས་ཐམས་ཅད་འབྱོར་བར་ཤོག།",
    "སུ་རེནྡྲ་བོ་དྷི་དང་།",
    "དེང་སང་གི་དཔེ་རྣམས་ལའང་བམ་གྲངས་མང་ཉུང་ཅི་རིགས་ཡོད་པར་སྣང་།",
    "རྒྱ་ནག་གི་འགྱུར་ལ།",
    "སུ་རེནྟྲ་བོ་དྷི་དང་།",
    "ལུང་གི་བརྒྱུད་རིམ་ལའང་རྒྱ་ནག་ནས་འགྱུར་བའི་བརྒྱུད་པ་ནི།",
    "གོང་གི་པཎྜི་ཏ་གཉིས།",
    "དེ་ནས་ལོ་ཙཱ་བ་མཆོག་ལྡན་ནས་དེང་སང་གི་བར་དུ་བརྒྱུད་པ་དང་།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "ཁ་ཅིག་ནི་རིང་ཞིང་བོང་ཆེ་ཡང་གཞན་དག་གི་གཡོག་བགྱིད་པ་དང་།",
    "གྲང་བ་དག་གིས་ཉེན་པར་འགྱུར་ལ།",
    "ཁ་ཅིག་ནི་གཞན་དག་གིས་སྤོང་བར་བགྱིད་པ་དང་།",
    "ཁ་ཅིག་ནི་དཔའ་ཞིང་རྩལ་དང་ལྡན་ཡང་ཞེས་མ་མཆིས་ལ་ཁ་ཅིག་ནི་ཚིག་འབྲུ་དང་དོན་དག་ལ་སློབ་པར་མོས་པ་དང་།",
    "ཀུན་དགའ་བོ་ཁྱོད་ཀྱིས་ཇི་ལྟར་དྲིས་པ་དེ་དེ་བཞིན་ཏེ།",
    "མིར་གྱུར་ཀྱང་མཆུ་ཤོ་རེར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་ཉའི་འགྲམ་པ་ཕུག་པ་ལས་གྱུར་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་སྐྲ་སེར་པོར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་ཕག་གི་སྤུ་བཏོགས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་རྣ་བ་རལ་བར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་གཞན་དག་གི་རྣ་བ་ཕུག་པ་ལས་གྱུར་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་མཛེ་ཅན་དུ་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་ཉེས་པ་མེད་པར་གཞན་དག་གི་ནོར་བླངས་པ་ལས་གྱུར་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་དབུགས་ཐུང་བ་གང་ཡིན་པ་དེ་ནི་དགུན་གྲང་བའི་དུས་ཀྱི་ཚེ་གཞན་དག་ལ་ཟས་གྲང་མོ་དག་བྱིན་པ་ལས་གྱུར་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་བུ་ཁྱེའུ་དང་བུ་མོ་མེད་པར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་བྱ་མང་པོ་རྣམས་ཀྱི་ཕྲུ་གུ་བསད་པ་ལས་གྱུར་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་གཞན་གྱི་བྲན་དང་བྲན་མོ་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་བུ་ལོན་ཆགས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ནས་གླུ་གར་ལ་དགའ་བ་གང་ཡིན་པ་དེ་ནི་རོལ་མོ་མཁན་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "གཅིན་རྟུག་གི་སྲིན་བུ་བྱེད་པར་འགྱུར་རོ།",
    "ཚེ་སྔ་མ་ལ་ཤིང་གི་ལྷམ་བགོས་ནས་དྲི་གཙང་ཁང་དུ་ཞུགས་པ་གང་ཡིན་པ་དེ་ནི་ཚེ་འདི་ལ་རྟའི་རིགས་སུ་སྐྱེ་བར་འགྱུར་རོ།",
    "ཚེ་སྔ་མ་ལ་གཞན་དག་གི་ཟས་ཀྱི་གེགས་བྱས་ན་ཚེ་འདི་ལ་ཤིང་སྲིན་བྱེད་པར་འགྱུར་རོ།",
    "ཁྱོ་ཤུག་གཙུག་ལག་ཁང་དུ་གནས་ནས་ཉལ་པོ་བྱས་ན་བྱ་མགོ་སྔོན་དག་ཏུ་སྐྱེ་བར་འགྱུར་རོ།",
