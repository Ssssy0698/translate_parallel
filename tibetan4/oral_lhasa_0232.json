    "དེ་ཡང་དེ་ལྟ་བུར་གྱུར་པ་འདམ་སྐྱེས་ཀྱི་གེ་སར་ལ་སོགས་པའི་ས་བོན་ལ་སོགས་པ་བོང་བ་ལ་སོགས་པའི་གནས་སྐབས་ཀྱི་ཁྱད་པར་ཐོབ་པ་ལ་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དང་ལྡན་པ་སྟེ།",
    "དངོས་དང་བརྒྱུད་པས་བྱས་པའི་ཁྱད་པར་འབའ་ཞིག་ཏུ་ཟད་དོ།",
    "ཁྱད་པར་ཅན་ཉིད་དོ།",
    "དེ་ལྟ་མ་ཡིན་ནམ་བག་མར་ལེན་པར་འོས་པའི་ཡུལ་དུ་སྐྱེ་བའི་འབྲ་གོ།",
    "མ་བག་མར་ལེན་པ་མེད་ན་མེད་པའི་ཕྱིར་འཁྲུལ་པར་འགྱུར་རོ།",
    "འདི་ཡང་བསྟན་པར་མི་ནུས་ཏེ།",
    "དེ་ལྟ་བས་ན་གང་ཞིག་དེ་ལས་གཞན་པའི་ཡུལ་དང་དུས་ཡོངས་སུ་སྤངས་ནས་སོ་སོར་ངེས་པའི་ཡུལ་ལ་སོགས་པར་ངེས་པར་འཇུག་པ་དེ་ནི་ལྟོས་པ་དང་བཅས་པ་ཡིན་ནོ་ཞེས་བྱ་བར་ངེས་སོ།",
    "དཔེ་ཡང་པར་བྱ་བ་མ་ཚང་བ་ཡིན་ནོ་སྙམ་དུ་བསམས་པའོ།",
    "ད་ནི་གཏན་ཚིགས་གྲུབ་པར་ཁས་བླངས་ནས་མ་ངེས་པ་ཉིད་དུ་བསྟན་པའི་ཕྱིར།",
    "རྒྱུ་ཡོད་པར་ནི་གྲུབ་པ་ལ།",
    "ཐ་དད་པ་ནི་ཡོད་པའི་ཕྱིར་ཐ་མི་དད་པ་ཁོ་ན་ཁྱབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "གང་མེད་པར་ཡང་གང་བྱུང་བ་དེ་ནི་དེའི་རྒྱུར་རིགས་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་ལྟའི་རྣམ་པ་མིན་ཞེས་བྱ་བ་ནི་རྒྱུ་ཡང་མ་ཡིན་ཁྱབ་པར་བྱེད་པ་ཡང་མ་ཡིན་པའོ།",
    "དེ་ལྟ་ན་ནི་རྟ་ལོག་པ་ན་བ་ལང་ཡང་ལྡོག་པར་འགྱུར་རོ།",
    "དེ་ནི་ཚུ་རོལ་མཐོང་བས་ངེས་པར་མི་ནུས་པ་ཉིད་ཀྱིས་ཐེ་ཚོམ་ཟ་བའི་ཕྱིར་རོ།",
    "གཞན་ཡང་འདི་ལྟར་ཁྱེད་ལ་བརྒལ་ཞིང་བརྟག་པར་བྱ་སྟེ།",
    "ཅི་སྟེ་ལེན་པ་དེ་ལྟ་ན་ཡང་ཁྱེད་ཀྱི་ཕྱོགས་མི་འགྲུབ་པོ་ཞེས་འཆད་པར་འགྱུར་བ་དང་འབྲེལ་ཏོ།",
    "ངེས་པ་ནི་རྒྱུ་དེས་བསྐྱེད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་ནི་ཐམས་ཅད་ཐམས་ཅད་ཀྱི་ཤེས་པར་བྱེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཇི་ལྟར་སློབ་དཔོན་གྱིས་། བྱེད་པ་པོ་ལས་ཤེས་པར་བྱེད་པར་མཛད་དེ།",
    "སྐྱེད་པར་བྱེད་པ་བཞིན་དུ་ཡང་དག་པའི་དོན་གྱིས་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "བསྒྲུབ་བྱ་སྐྱེད་པར་མི་བྱེད་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་བསྒྲུབ་བྱའི་དོན་སྐྱེད་པར་མི་བྱེད་པའི་ཕྱིར་འདི་ཤེས་པར་བྱེད་པ་ཞེས་བྱ་བའི་བྱེད་པ་པོ་ནི་མ་ཡིན་ནོ།",
    "གང་ཡང་མྱུ་གུ་ལ་སོགས་པའི་བསྒྲུབ་པར་བྱ་བ་སྐྱེད་བར་བྱེད་པ་དེ་ནི་བྱེད་པ་པོར་བརྗོད་དོ་ཞེས་བྱ་བ་ལ་སྐྱོན་མེད་དོ།",
    "དེ་ནི་ཤེས་པར་བྱེད་པའི་རྒྱུ་སྨྲ་ཞིང་བྱེད་པ་པོ་ནི་སྤོང་ངོ།",
    "དེའི་ཕྱིར་འདིར་ལན་ནི་ཤེས་པར་བྱེད་པ་ཡང་བྱེད་པ་ཉིད་ཡིན་ཏེ་ཤེས་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པས་མཇུག་བསྡུ་བའི་ཐབས་ཀྱིས་དམ་བཅས་པའི་དོན་རྗེས་སུ་དཔག་པས་གནོད་པར་སྟོན་པར་བྱེད་དོ།",
    "གཞན་དག་ཀྱང་ཞེས་བྱ་བ་ནི་པད་མའི་གེ་སར་ལ་སོགས་པ་བསྒྲུབ་པར་བྱ་བའི་དོན་གྱི་ཡུལ་ཅན་གྱི་ཤེས་པ་ལས་མ་གཏོགས་པ་རྣམས་སོ།",
    "ཞབས་གཉིས་ཕྱེད་སྐྱིལ་མཉམ་པར་རོལ་པ་ཡི།",
    "སྐུ་གསུམ་དབྱེར་མེད་བདེ་བ་ཆེན་པོར་བཞུགས།",
    "དཔག་ཡས་ནམ་མཁའ་ཁྱབ་པར་འཕྲོས་པ་ཡིས།",
    "ཡེ་ཤེས་སྤྱན་དྲངས་གཉིས་སུ་མེད་པར་གྱུར།",
    "གཤེགས་དང་བཞུགས་པའི་མཚན་མ་མི་མངའ་ཡང་།",
    "བློས་བྱས་འཁྲུལ་པའི་སྡིག་ལྟུང་ཇི་སྙེད་ཀུན།",
    "འགྱུར་མེད་ཡོངས་གྲུབ་ཀ་དག་ཀློང་དུ་བཤགས།",
    "ཁྱད་པར་ཚེ་འདིའི་སྣང་བ་ནུབ་མ་ཐག།",
    "ཡབ་ཡུམ་མཉམ་པར་སྦྱོར་བའི་མཁའ་གསང་ནས།",
    "ཞེས་བརྗོད་རིག་སྟོང་རྗེན་པར་བཞག།",
    "དོན་གཉིས་འགྲུབ་པར་ཐེ་ཚོམ་མེད།",
    "མཉམ་གཞག་རྣམ་པར་མི་རྟོག་དང་།",
    "འདུ་འབྲལ་མེད་པར་རྗེས་བཟུང་ནས།",
    "སྐྲ་ལོ་ནི་འཕྱིངས་ནས་རལ་པར་གྱུར།",
    "ལག་པར་འཁར་བ་དང་ཁྱི་སྲུང་གཅིག་ལྕོགས་ཀྱི་དབྱུག་པ་ཞིག་ལས་ཅི་ཡང་མེད་པ་མཐོང་།",
    "ཚུལ་དེ་ཕྲག་ཏུ་ཕོར་པ་ཁ་ཆག་གཅིག་དེ་མིན་རྒྱུ་ནོར་གྱི་གྲས་སུ་འཇོག་པར་འོས་པ་ནི།",
    "གནས་སྐོར་བ་ཕ་བུ་འདི་གཉིས་ལ་སྦྱིན་པ་བཏང་ན་རང་ཉིད་ཕྱིན་པ་དང་ཁྱད་པར་མ་མཆིས་བསམས་ནས་ཕ་བུ་གཉིས་རང་ཁྱིམ་དུ་ཡར་ཤོག་ཅེས་བརྗོད་ནས་ཇ་དང་།",
    "ཐུག་པ་སོགས་ཚིམས་པར་བྱིན།",
    "ཉིན་མཚན་བལྟོས་མེད་སྡུག་མཉམ་འཁུར་གྱིས་ཉལ་མཇུག་ཏུ་ཙོག་པུར་བསྡད་དེ་ཡང་ནས་ཡང་དུ་ང་ལ་ལུས་ཁམས་བདེ་མིན་གྱི་སྐད་ཆ་འདྲི་བར་བྱེད།",
    "དབུགས་ཀྱང་གཏོང་འཐེན་དཀའ་བའི་གནས་སུ་གྱར་བས་ཨུ་ཧུ་ལགས།",
    "ཕ་བུ་གཉིས་རིམ་གྱིས་ལྷ་སའི་གླིང་སྐོར་ལམ་དུ་སླེབས་པ་ན་ནམ་ལངས་ཐང་གསལ་བས།",
    "གླིང་སྐོར་ལམ་གྱི་གཡས་ཟུར་ལ་མི་མང་པོ་ཞིག་གྲལ་བསྒྲིགས་ཏེ་ས་ལ་བསྡད་ཡོད་པ་མཐོང་།",
    "བུ་བར་གཏུགས་ནས་ཇོ་བོ་ཡིད་བཞིན་ནོར་བུས་མཁྱེན་ནོ།",
    "ལུས་ཕུང་འདི་ལ་སེར་སྣ་བྱས་པ་ནི་གཏན་ནས་མིན།",
    "ཇོ་བོ་ཁྱེད་ཀྱི་ཐུགས་བརྩེས་ཅི་ནས་ཀྱང་མི་འདོར་བ་མཁྱེན།",
    "ཇག་པ་སོགས་ཚུལ་མིན་གྱི་བྱ་བའི་རིགས་མཐའ་དག་བསྒྲུབ་མི་དགོས་པར་ཡ་རབས་དམ་པའི་སྤྱོད་པ་དང་ལྡན་པ།",
