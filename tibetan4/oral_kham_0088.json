    "གུས་པ་དང་བཅས་པས་ཞུམ་ཞུམ་པོར་འདུག་སྟེ་སྨྲས་པ།",
    "འོན་ཀྱང་རང་སྡུག་དཀའ་བ་དང་བླངས་ནས།",
    "འདི་སྐབས་ལུང་བསྟན་འགའ་ཞིག་འདུག་ཀྱང་ཆེས་གསང་བའི་ལུང་བསྟན་མཁའ་འགྲོའི་རྒྱས་བཏབ་པས་འགོད་པར་མི་ནུས་སོ།",
    "ཡས་མས་ནས་གདན་འདྲེན་ཞུ་མི་རིམ་ཅན་བྱུང་བར་ད་ལན་བྲེལ་གཡེང་འགའ་ཞིག་འདུག་པས་ཕེབས་རྒྱུའི་སྐབས་མི་འདུག་སྟེ།",
    "བསྙུན་འདྲི་བྱས་པར་མ་ཞུ་རྙིང་བ་འཁྲུགས་པས་ཚ་བ་ཞིག་འདུག་སྟེ་གསུངས།",
    "ཚེ་དཔག་མེད་གཅིག་འདུག་སྙམ་པ།",
    "དེ་བར་སྒྲིབས་ཤིང་རང་ཚུགས་ཟུངས།",
    "ལར་ཕྱོགས་ཙམ་མ་གཏོགས་མི་འདུག།",
    "ཟེར་བ་འདུག་གོ།",
    "དགྲ་མིག་སྟོང་གྲིབ་མི་ཕོག་ཉེན་གདའ།",
    "གཞན་ལ་སྤེལ་ན་ཐེ་ཚོམ་ལོག་ལྟ་འདུག།",
    "མེ་མདའ་བཅུ་དྲུག་དུས་གཅིག་ལ་བསྣུན་པས།",
    "བཅས་དང་རང་བཞིན་ཉེས་ལྟུང་མཐའ་དག་བཤགས།",
    "དེ་ཤིང་ཏོག་ཡིན་ཏེ་ཁྱེད་རང་ཟླ་བ་ཕྱི་མར་མི་སྡོད་པ་འདྲ་གསུངས།",
    "ཞབས་ཕྱི་རྣམས་ནས་ས་ལམ་ངན་པས་སྐུ་ངལ་ཆེ་ཞུས་ན་སྐྱོན་མེད་ས་ལམ་བཟང་བར་འདུག་གསུངས་ཏེ་ཞབས་ཐང་ཁོ་ནར་ཕེབས་པ་གནང་།",
    "བདུད་རྩིའི་ཐིགས་པ་རང་རང་འཁོར་ལ་འགྱེད།",
    "རྔ་བའི་སྐུ་ཚབ་མཇལ་བར་ཁོང་རང་འཁྲུལ་མེད་ངོས་བཟུང་བ་དང་།",
    "ཏཱ་ཆེན་ལྔ་ཞེས་ས་བོན་དུ་བཀོད་འདུག་གོ།",
    "དེ་ལྟར་གནང་བཞིན་ཡོད་མེད་ངས་ཀྱང་འདི་ནས་འདྲི་རྟོག་བྱེད་ཀིན་འདུག་རྒྱུ་ཡིན།",
    "གྲྭ་ཚང་ནས་གྲྭ་བ་བརྒྱ་ལྷག་ལ་ཡ་མ་རཱ་ཛཱའི་བསྙེན་མཚམས་ཁ་སྐོང་དང་བཅས་བགྱིད་དུ་བཅུག་དུས་འཁོར་ས་གར་མཆོད་གར་དང་།",
    "རྡོ་རྗེ་འཆང་སྐུ་གོང་མ་དངོས་སུ་འདུག་ཅེས་བཅོས་མིན་གྱི་བསྔགས་པ་བརྗོད་པས་དུས་འདའ་བ་བྱུང་།",
    "དེ་ནས་བཟུང་བླ་བྲང་རང་དང་གདན་ས་ཆེ་ཆུང་དགོན་ལེ་ལག་མངའ་འབངས་སྦྱིན་བདག་དང་བཅས་པས་མཆོག་སྤྲུལ་འཁྲུལ་མེད་མྱུར་བར་ངེས་འདྲོངས་འབྱུང་ཆེད་དུ་འདུན་པ་ཆིག་དྲིལ་གྱིས།",
    "ཞེས་ལྗགས་བཀོད་མཛད་འདུག་པ་དང་།",
    "པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་ལན་གྲུ་ནས་ལེ་བར་བརྒྱའི་སར་ཞིས་ལུང་ཧྲན་ཞེས་པའི་གནས་སུ་ཕེབས་འདུག་པར་འབྱོར་མཇལ་ཞུས།",
    "ངོས་ནས་ཀྱང་འདོད་དོན་ཡིད་སྨོན་ལྟར་འགྲུབ་པའི་སྨོན་འདུན་བགྱིད་ཅེས་གསུང་འདུག་པས་དེར་ཚོགས་པ་ཐམས་ཅད་ཀྱི་རྒྱུད་ལ་སྨྲ་མི་ཤེས་པའི་དགའ་དད་བསམ་བརྗོད་ལས་འདས་པ་བྱུང་ངོ།",
    "བླ་བྲང་རང་ནས་དཀར་དམར་གྱི་སྤྲོ་སྟོན་རྒྱ་ཆེན་པོ་དང་།",
    "འབྲིང་ཙམ་ཞིག་ཏུ་ལུང་བསྟན་འདུག་པས་ཇི་ལྟར་བགྱི་ཞེས་གྲོས་འགོ་བཏོན་པར།",
    "སྐུ་སྙུན་དྭངས་སྐྱེད་ཆེ་བར་མ་བྱུང་བ་ལ་བརྟེནགྲོ་ཞུན་ཟླ་བའི་ཚེས་གསུམ་ནས་བླ་བྲང་རང་ནསརྒྱལ་བའི་བཀའ་དང་རྗེའི་གསུང་འབུམ་དག་སྒྲོགས།",
    "དབོ་ཟླའི་ཟླ་བ་ཉ་གང་བ་ཡར་ངོའི་རྫོགས་པ་གསུམ་པ་ཤར་བའི་ཕྱི་དྲོ་ཁ་བྱང་དུ་འཁོར་ནས་འདུག་དགོས་གསུངས་པ་ལྟར་བཞུགས་ཤིང་།",
    "ཡིན་ཕྱིར་དངོས་སྨྲ་རྣམས་ཀྱང་རང་ལུགས་ཀྱི།",
    "དེ་བཞིན་དུ་ཐོབ་བྱ་མཆོག་དམན་དང་རང་གཞན་གྱི་ཧཱུཾ་བ་དོན་ལ་དམིགས་པ་སོགས་བསམ་པའི་ཁྱད་པར་ཅན་ངང་།",
    "ངོ་བོ་དབྱིབས་དང་ཁ་དོག་སོགས་གང་དུ་འདུག་བརྟགས་པས་གང་དུའང་མ་རྙེད་པའི་དོན་ལ་མཉམ་པར་གཞག་པར་བྱའོ།",
    "དེ་ཡང་རང་བཞིན་ཞི་བར་རྟོཊ་པའོ།",
    "སྟོངས་དེའང་རང་བཞིན་གྱིས་གདོད་མ་ནས་ཞི་བའི་ཚུལ་རྟོགས་པས་འབད་པ་མེད་པའི་རང་བཞིན་གྲུབ་པར་འགྱུར་རོ།",
    "རིགས་དང་ས་བོན་དང་རང་བཞིན་དང་ཁམས་ཞེས་བྱ་ཞིང་།",
    "གཉིད་སད་ཙ་ན་མ་རིག་པ་ལས་སད་པར།",
    "སྟན་ལ་འདུག་ན་རྡོ་རྗེའི་སྟན་ཐོབ་པར་གྱུར་ཅིག་སྙམ་དུ་སེམས་བསྐྱེད་དོ།",
    "ཧཱུྃ་བ་དེའང་རང་རྒྱུད་པ་རྣམས་ནི་སེམས་བསྐྱེད་དང་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱི་དཔྱད་པ་སྔོན་དུ་བཏང་ནས་གོམ་བྱེད་ཀྱི་བློ་ཉིད་ཀྱང་གོམ་བྱ་ཡོད་མེད་སོགས་སྤྲོས་པའི་མཐའ་ཐམས་ཅད་བཀག་པའི་མེད་དགག་ནམ་མཁའ་ལྟ་བུའི་སྟོང་པ་ཉིད་དེའི་ངོ་བོར།",
    "དེའང་རང་བཞིན་མེད་པར་ཤེས་པས་ཐ་མལ་དང་ལྷའི་སྣང་བ་གཉིས་ཀར་བདེན་ཞེན་ཡང་འགགས་ཏེ།",
    "སྣང་ཞེན་བདེན་འཛིན་གསུམ་ལ་རང་རང་དང་རྣམ་པ་འགལ་བའི་གཉེན་པོ་ལ་འབད་པ་ཡིན་པའི་ཕྱིར།",
    "གཞན་དོན་རྒྱ་ཆེན་པོ་སྒྲུབ་པར་བྱེད་པ་དང་རང་སྔགས་སེམས་དཔའ་གསུམ་དང་།",
    "གནས་དེར་ཡོ་བྱད་ཐམས་ཅད་ཚོགས་པར་བྱས་ལ་གདན་དང་ཁ་ལྟ་ཕྱོགས་དང་འདུག་སྟངས་སོགས་ཀྱི་ཁྱད་པར་དང་ལྡན་པས་སྔོན་དུ་འབྱུང་པོ་ལ་གཏོར་མ་སྦྱིན་པར་བྱ་སྟེབརྟག་གཉིས་སུ།",
    "འབྱུང་རིམ་རི་རབ་ཧཱུྃ་བ་དང་བཅས་པའི་སྟེང་དུ་སྣ་ཚོགས་པདྨ་དང་སྣ་ཚོགས་རྡོ་རྗེའི་ལྟེ་བར་གཞལ་ཡས་ཁང་དང་ལྷ་གཉི་ག་དུས་གཅིག་ཏུ་བསྐྱེད་པའི་རྣམ་གཞག་མང་ལ།",
    "འཆི་བ་འོད་གསལ་ལས་སླར་སྣང་གསུམ་དང་རང་བཞིན་བརྒྱད་ཅུར་ལུགས་འབྱུང་དུ་ལྡངས་ནས།",
    "རིག་པ་དང་རང་བཞིན་བདེ་བ་ཟུང་དུ་འཇུག་པ་དང་།",
    "བདེ་དགྱེས་སོགས་སུ་རྒྱུ་རྡོར་འཛིན་སྙོམས་པར་འཇུག་དུས་ཞུགས་པའི་ཧཱུཾ་སོགས་དང་།",
    "སྒྲུབ་པའི་ལུང་སྦྱིན་ཅིང་རང་གཞུང་རྩ་བའི་ཚིག་ལ།",
    "སྣང་ཡང་རང་བཞིན་མ་གྲུབ་པའི་ཕྱིར་སྒྱུ་མའི་ལུས་ཞེས་བྱའོ།",
