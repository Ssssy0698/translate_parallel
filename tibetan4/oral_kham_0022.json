    "རིན་ཆེན་བཟང་པོ་བཅས་ཡོད་པ་བཀོད་འདུག།",
    "གྲྭའུ་དཔོན་༡༡༧ བསྟན་འཛིན་རྒྱ་མཚོས་རྨ་ཁྱི་ཚང་དམག་དཔོན་ཞིག་ལ་དཔུང་རོག་སུ་སྐྱབས་ཞུས་ནས་རྒྱ་དམག་བཏང་སྟེ་ཕྱིར་མངའ་འོག་ཏུ་བཅུག་ཚུལ་བཀོད་འདུག།",
    "ཕྱི་ལོ་༡༩༣༧ལོ་དཔོན་རུ་སྨད་མ་དང་ཤུལ་མ་གཉིས་རྒྱ་དམག་ལ་འཁྲུག་དུས་ཐོག་མར་རྒྱ་དམག་མང་པོ་བསད་པ་དང་།",
    "བོད་གཞུང་ཨ་རིར་ཡོད་པའི་དཔོན་པོ་ཞིག་ལ་ཞུས་རུང་ཁུངས་བཙན་པོ་མི་འདུག་ཅེས་མི་སྟོང་ཕྱེད་ཙམ་སྤྱད་དེ་ཐག་མ་ཆོད་པར་ལུས།",
    "དགོན་གནས་དེ་ཡང་མགོན་པོ་སྟག་ཞོན་ལ་གཏད་འདུག་གསུངས།",
    "བློ་གྲོས་རྒྱལ་པོས་སྲས་ནོར་བུ་རྒྱལ་པོ་མཛད་འཕྲིན་རྒྱས་འདུག་ང་གཅུང་༢༧༩ ཀརྨ་རབ་བརྟན།",
    "ཙེའུ་དམར་པོ་སོགས་བསུ་མཁན་འབྱོར་འདུག་འགྲོ་དགོས་གསུང་ནས་ཅུང་ཟང་བསྙུང་ཚུལ་གྱིས་ཞི་བར་གཤེགས་སོ།",
    "མཁར་རྫས་མེར་བསྲེགས་སོགས་འཐབས་འཛིངས་ལན་མང་བྱས་འདུག་ཀྱང་དྲག་ཆས་མེད་པའི་ཁར།",
    "དབོན་པོ་བེ་ཧུ་བཅས་ཕེབས་ཐུབ་འདུག།",
    "དེ་ལྟར་སྐྱེ་དགུ་བསྐོར་མཁན་གྱི་བོད་དམག་ཚོ་ཡང་རང་བཞིན་ཕྱི་གཤོལ་བྱས་རྗེས།",
    "ཀི་སྒྲ་རྒྱབ་སྟེ་དགྲ་བོའི་ཐོག་ཤོར་སྐབས་རྒྱ་མིས་མེ་མདའ་རྒྱང་འཕེན་བྱས་ནས་ཚང་མ་ར་ཤིང་ཟེར་བའི་ཞིང་ཁ་ཞིག་ཡོད་པ་དེས་འགྲམ་གྱི་མཆོད་རྟེན་འགྲམ་དེར་བསད་འདུག།",
    "རྒྱ་དམག་སྟོབས་ཤུགས་ཆེ་བས་འགོག་རྒོལ་བྱས་ཀྱང་ཕན་པ་མེད་པ་ཤེས་རུང་འགག་རྩར་ཐུག་དུས་བསྟན་དགོན་ཤུལ་དུ་བཞགས་ཏེ་བྲོས་པ་ལས་ཤི་བསོན་ལ་མ་ལྟོས་པར་རྒོལ་འཛིང་མཐའ་གཅིག་ཏུ་བྱེད་པ་དགའ་བས་ཕྱིར་བཤོལ་མི་བྱེད་པའི་དམ་བཅའ་བརྟན་པོར་བཞགས་སྟེ་རྒྱ་དམག་ལ་འཛིང་རྒྱུའི་གྲ་བསྒྲིགས་ཨང་གསར་བྱས་ནས་བསྡད།",
    "ཕྱོགས་ལྷུང་གྱ་གྱུའི་སེམས་དང་རང་དོན་གྱི།",
    "དེ་ལྟ་ན་ཡང་རང་ཉིད་བློ་གྲོས་ཀྱི།",
    "རང་རང་གཞུང་དང་གྲུབ་པའི་མཐའ་ཡིས་ཀྱང་།",
    "རང་བྱུང་རང་ཞི་ཆུ་ཡི་དབའ་རླབས་འདྲ།",
    "གནས་སོ་ཞེས་བྱ་བ་ནི་འདུག་པར་གྱུར་པའོ།",
    "འདུག་ཅིང་ཞེས་བྱ་བ་ནི་ཉེ་བ་ར་བཞུགས་པའོ།",
    "བདེབར་གནས་པ་ཞེས་བྱ་བནི་བདེ་བར་འདུག་པའོ།",
    "གནས་མལཞེས་བྱབ་ནི་འདུག་པའི་གནས་ཏེ།",
    "ལྕང་བཟེད་ཆུང་བཞེས་བྱ་བ་ནི་སྣོད་ཆུང་ངུའོ་། གནས་སུ་ཞེས་བྱ་བ་ནི་འདུག་པའི་གནས་སུའོ།",
    "བསེར་ལྟ་བུ་ཞེས་བྱ་བ་ནི་གཅིག་པུ་འདུག་པའོ།",
    "ཆུའི་སྟེང་ན་འདུག་ཅེས་བྱ་བའི་ཐ་ཚིག་སྟེ་དེ་ནི་ཡབ་ཅེས་བྱ་བའི་ཕྱིར་རོ།",
    "རྡུལ་ཁྲོད་ཀྱི་འདྲེ་འམ་ཞེས་བྱ་བ་ནི་ཕྱག་དར་ཁྲོད་ཀྱི་འདྲ་འམཚུབ་མའི་ནང་ན་འདུག་པའི་འདྲེའོ།",
    "བདག་ཀྱང་ལྷན་ཅིག་གནས་པར་བྱེད་ཅེས་བྱ་བ་ནི་ལྷན་ཅིག་ནའདུག་པའོ།",
    "པའི་རྒྱུས་ཞེས་བྱ་བ་ནི་ལྷན་ཅིག་ན་འདུག་པའི་རྒྱས་སོ།",
    "ཞེས་བཙ་ན་ཞེས་བྱ་བ་ནི་མུ་སྟེགས་གཅེར་བུ་པ་སྟེ།",
    "གནས་ཞེས་བྱ་བ་ནི་ཁྱིམ་སྟེ་འདུག་པའི་གནས་ཡིན་པའི་ཕྱིར་རོ།",
    "རྩ་བ་འབྱུང་ཞེས་བྱ་བ་ནི་གངལ་རྩ་བ་དགོས་པའི་དྲུང་རུ་འཁྲལ་ལ་འཇུད་ཅིང་རང་ཉིད་རྐྱེན་གཞན་མར་པར་འབྱུང་ངོ།",
    "ཉག་ཟགཅིག་བསྲེལ་ཞིངཞེས་བྱ་བ་ནི་སྐམས་ལ་འདུག་པའི་ཕུར་པ་ལས་སོ།",
    "གྲོང་རྒྱང་གྲགས་ཀྱིས་བར་དུ་ཚད་བ་བདུན་བདུན་ཞེས་བྱ་བ་ནི་ཆུའི་ནང་ན་འཇུག་ཀྱང་རུཅུ་ཆུའི་འགྲམ་ན་འདུག་ཀྱངང་ང་བར་ཤེས་པའོ། ཡོ་བ་ཞེས་བྱ་བ་ནི་ཆུའི་གཞུང་ཡོ་བའོ།",
    "འངུའིཞེས་བྱ་བནི་ཉེ་དུས་བྱེད་དུ་བཅུག་པའི་འདུག་གནས་ཏེ།",
    "ཞེས་བྱ་བ་གཉིས་ནི་མདུན་ན་འདུག་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ལམ་ལམ་ལམ་ཞིང་འདུག་པ་ཞེས་བྱ་བ་ནི་འབར་ཞིང་འདུག་པའོ།",
    "དགེ་སློང་འཇུག་པ་ལ་སྨྲབར་བྱའོ་ཞེས་བྱ་བཞི་དེ་ན་དགེ་སློང་གང་འདུག་པལ་ཁོབ་གྲོང་དུ་འགྲོ་བའོ་ཞེས་སྨྲ་བར་བྱའོ།",
    "ཁྱིམ་ན་འདུག་མི་བད་ཅེས་བྱ་བཞི་ཁྱར་ན་གཞས་པར་མ་བྱེད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གནས་པ་ཞེས་བྱ་བ་ནི་འདུག་པའོ།",
    "ལམ་པོ་ཆེ་ན་འདུག་པ་ཞེས་བྱ་བ་ན་ལམ་པོ་ཆེའི་ནང་ན་རྣམ་པར་གནས་པའོ།",
    "སྒོ་ཞག་འདུག་ན་ཞེསབྱ་བ་ནི་སྦྱིན་དུ་འཇུག་ཅིང་འདུག་ནའོ།",
    "རྐང་པ་མི་བསྣོལ་བར་ཞེས་བྱ་བ་ནི་རྐང་པའི་སྟེང་དུརྐང་པ་བཞག་སྟེ་འདུག་པར་མི་བྱ་བའོ།",
    "བརླ་འ་མི་བསྣོལ་བར་ཞེས་བྱ་བ་ཡང་བརླའི་སྐརང་དུ་བརླ་བཞག་སྟེའདུག་པར་མི་བྱ་བའོ།",
    "རྐར་པམི་དགུག་པར་བྱ་ཞེས་བྱབ་ནི་རྐང་པ་གཉིས་བཀག་སྟེ་འདུག་པརམི་བྱ་བའོ།",
    "རྐང་པ་མི་གདར་བརཞེས་བྱ་བ་ནི་རྐང་གཉིས་ཐད་ཀར་ག་དངས་ཏེ་འདུག་པར་མི་བྱ་བའོ།",
    "མཐར་ཆ་གསས་ཞེས་བྱ་བཞི་སྟན་ལ་འདུག་པའི་གྲལ་གྱི་རིམ་པ་བཞིན་དུ་ཟས་བླང་པར་བྱ་བའོ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏམ་ཞེསབྱ་བ་ནི་དྲང་ན་འདུག་པའི་དགེ་སློང་ལཐ་ཨ་འབགས་པའི་ཆུསམི་གཏོང་བར་བསླབ་པར་བྱ་བ་སྟེ་དྲུང་ན་འདུག་ལ་ཞེས་བྱ་བ་དང་།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཐས་དར་འབགས་པ་ཀྱིས།",
    "པིབཏེག་པའིཕྱོགས་ན་འདུག་པའོ།",
    "བཞོན་པའི་སྟེང་ནའ་དུག་པཞེས་བྱ་བ་ནི་ཞིང་ལ་ལེགས་པ་མིས་བཏེག་པ་མ་ཡིན་པའི་སྟེང་ན་འདུག་པའོ།",
