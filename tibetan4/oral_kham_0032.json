    "སྟོང་པར་འདུག་ཀྱང་སྟོང་པ་ཞེས་བྱ་བ་རང་དུ་ཡང་མ་གྲུབ་ལ།",
    "གཞི་དང་རང་བཞིན་འབྲས་བུ་དང་ཞེས་པ་ལ་སོགས་པ་གསུངས་སོ།",
    "མེ་ཏོག་པདྨ་ལྟར་ཁ་ཟུམ་མེ་འདུག་པས་དེ་ལ་དུང་ཅན་མ་དང་གླང་སྣ་མ་དང་།",
    "ཁ་ཅིག་ནི་གཞི་རང་བཞིན་འབྲས་བུ་གསུམ་ཆར་གྱི་སྔགས་སུ་འདུག་གོ།",
    "མི་མཐོང་སྟེ་དཀར་པོ་ཡིན་པ་ལ་སེར་པོར་འདུག་སྙམ་པ་ལས་སྣང་ཐབས་མེད།",
    "མིག་དང་ལྡན་པ་ནི་མིག་མས་འགེབས་པ་མིག་དཀྱུས་རིང་བ་མིག་རྩ་དམར་བར་འདུག་པ་དང་གཉིས།",
    "དྲི་ལུས་ནི་ལུས་ལ་དྲི་ཞིམ་པར་འདུག་པ་དང་གསུམ།",
    "རང་ཉིད་གནས་ཁང་གཅིག་ཏུ་སྟན་ལ་འདུག་ལ་ཡི་དམ་ལྷའི་སྐུ་སྤྲོ་བསྡུ་ཞག་བདུན་བྱའོ།",
    "ཞེས་པས་འདུག་ནས་དང་པོ་གཏོར་ཆོག་བཞིན་དུ་ཨིནུའི་སྔགས་ཀྱི་གཏོར་མ་ཞིག་བཏང་ལ།",
    "དཀྱིལ་འཁོར་གྱི་སྟེགས་བུའི་དབུས་སུ་འདུག་སྟེ།",
    "རྨོངས་པའི་བདག་ཉིད་གང་གདའ་བ།",
    "དེ་ནས་ཡང་བསྐོར་ཏེ་གྲོགས་ལྷོར་འདུག་ལ།",
    "དེ་ནས་གྲོགས་ཀྱིས་བསྐོར་ཏེ་བྱང་ཤར་མཚམས་སུ་འདུག།",
    "སློབ་དཔོན་བསྐོར་ཏེ་ཤར་ལྷོའི་མཚམས་སུ་འདུག་ལ་ཤར་གྱི་ལོགས་ཐིག་གདབ།",
    "དེ་ནས་གྲོགས་ཀྱིས་བསྐོར་ཏེ་ལྷོ་ནུབ་ཀྱི་མཚམས་སུ་འདུག་ལ།",
    "དེ་ནས་སློབ་དཔོན་གྱིས་བསྐོར་དེ་ཤར་ལྷོར་འདུག་ལ།",
    "གྲོགས་ཀྱིས་བསྐོར་ནས་ལྷོ་ནུབ་དུ་འདུག་སྟེ་ལྷོའི་ཐིག་གདབ།",
    "ཤར་གྱི་ལྷ་སྣམ་དུ་འདུག་པར་སོམས་ལ།",
    "དེའི་མདུན་དུ་ང་འདུག་སྟེ།",
    "ལུས་ཙོག་པུར་འདུག་ལ།",
    "དེའང་རང་ཟས་རོ་རྩ་བཟང་པོས་ལུས་ཟུངས་རྒྱས་པར་བྱས་ལ།",
    "དེ་ལ་འབྱོངས་ནས་མི་འཆོར་བར་འདུག་ན་ཕྱག་རྒྱ་མ་ལ་ཡོན་ཕུལ་ཏེ་གཏང་ངོ།",
    "ལམ་ཡང་རང་སྐྱ་བར་བཞེད་དོ།",
    "སྟན་བདེ་བ་ལ་འདུག་ནས་ཁྲོ་བོ་གང་ཡང་རུང་བའི་དྲག་སྔགས་བཟླས་པ་བྱ་བ་ནི་བསྲུང་བའི་འཁོར་ལོ།",
    "དེ་དུས་ཀྱི་བྱ་རོག་དེ་ནི་དཔལ་མགོན་ཞལ་གྱི་རྣམ་འཕྲུལ་དུ་འདུག།",
    "འདིའི་ལྟར་ན་ཡུལ་དེའི་དྲུང་དུ་ཙོག་པུར་འདུག་སྟེ་ལན་གསུམ་བརྗོད་དགོས་སོ།",
    "མིའམ་ཅི་ལུས་མི་ལ་མགོ་རྟ་དང་༡༨བ་སྦྲུལ་དུ་འདུག་པ།",
    "མི་གནས་པར་འདུག་པར་མི་བྱའོ་ཞེས་པས་རང་ཉིད་ཀྱང་གནས་ལ་ངེས་པར་བརྟེན་དགོས་པར་བསྟན་ནོ།",
    "གནས་ཉིད་དང་མི་གནས་པར་འདུག་པར་མི་བྱའོ།",
    "ཉེ་བར་འཁོར་དེས་ཀྱང་གཞན་ལ་གནས་པས་འདུག་པར་བྱའོ་ཞེས་ས།",
    "རྩྭ་དང་ལོ་མ་སོགས་བཏིང་བར་ཡང་འདུག་སྟེ་སྐྲ་བྲེག་པར་མི་བྱའོ།",
    "དེ་དྲི་མི་ཞིམ་པ་ཉིད་བསལ་བའི་ཕྱིར་འདུག་སྤོས་མེར་བླུགས་སོ།",
    "འཕགས་པའི་མི་སྨྲ་བ་མི་རྟག་སོགས་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པ་ལ་དམིགས་པས་འདུག་གོ།",
    "མི་གནས་པར་འདུག་པར་མི་བྱ་བའི་དམིགས་བསལ་ནི།",
    "ཐ་མལ་བའི་གཟུགས་སུ་འདུག་པ།",
    "གནས་འདུག་པའི་གཙུག་ལག་ཁང་དེ་ན་གནས་པ་ཡང་འདུག་ན་གནས་པས་གནས་ཀྱི་དྲུང་དུ་ཉིན་བར་ལན་གསུམ་དུ་འགྲོ་བར་བྱའོ།",
    "གནས་དེ་ལ་བཞར་བ་ཐག་མི་རིང་བར་འདུག་པར་བྱའོ།",
    "གང་དང་ལྷན་ཅིག་གནས་གཅིག་ན་འདུག་པ་དང་ལམ་གཅིག་ཏུ་འགྲོགས་པས་འདྲིས་པའི་སྨོན་འདྲིན་དང་།",
    "གནས་བརྟན་གྱིས་དགེ་སློང་རྣམས་ཁྱིམ་གྱི་ནང་དུ་འདུག་པ་དང་ཕྱི་རོལ་ཏུ་ཡང་འདི་ན་ཁ་ཅིག་ལེགས་པར་མ་བགོས་པ་དང་ལེགས་པར་སྦྱངས་པར་མ་གྱུར་ཏམ་ཞེས་སོ་སོར་བརྟག་པར་བྱའོ།་།",
    "དབྱར་གནས་པར་ཁས་བླངས་པའི་གནས་བརྟན་གྱིས་གཙུག་ལག་ཁང་བྱི་དོར་མི་བྱེད་པ་ལ་ནི་གྲོས་བཏབ་སྟེ་བྱི་དོར་བྱེད་དུ་གཞུག་ཅིང་རང་ཉིད་ཀྱིས་བྱི་དོར་བྱེད་པ་ལ་ནི་རབ་ཏུ་བྱུང་བའི་ཚུལ་དང་མཐུན་ནོ་ཞེས་སྤྲོ་བར་བྱའོ།",
    "ཚུལ་བཞིན་ཡིད་བྱེད་མེད་པར་གྱི་ནར་ཁ་རོག་འདུག་པ་ལ་བཏང་སྙོམས་སུ་མི་གཞག་གོ།",
    "འདུག་པ་དང་ཉལ་བ་ལ་སོགས་པ་འཁོར་དེ་ཇི་ལྟ་བ་བཞིན་བྱའོ།་།",
    "གནས་བརྟན་གྱི་གོང་དུ་འདུག་པ་དང་འགྲེང་བར་ཡང་མི་བྱའོ།",
    "གཡོག་འཁོར་གྱི་བྱ་བ་ཚུལ་དང་མི་མཐུན་པ་ལྷ་དྲག་པོའི་རྟེན་འཛུཊ་པ་སོགས་གལ་ཏེ་དགེ་སློང་རང་དང་ཡུལ་མི་ལྟ་བུ་གཞན་ལ་གནོད་པར་མི་འགྱུར་བ་ནི་ཅི་བདེར་བཞག་གོ།",
    "སྐྱེས་པ་དང་ནི་འདུག་མི་བྱ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་སྦྱིན་པ་ཞེས་བྱ་བ་རྣམ་ཐོས་ཀྱི་བུ་ལ་ནོར་གྱིས་འགྲན་པ་ཞིག་འདུག་པའི་ཆུང་མ་ལ་བུ་བཙས་ནས།་",
    "དེ་ཡང་རང་བཞིན་དང་བཅས་པ་བསམ་བཞིན་དུ་འདས་པ་ནི་སྔ་མ་ཡིན་ལ།",
    "དུ་མའི་དབུས་ན་འདུག་པའི་ཕྱིར།",
    "གནས་ནས་སྤོས་པའི་དོན་ཡང་འདུག་ས་སྤོས་པ་དེ་ཙམ་ཡང་མིན་ཏེ།",
    "མིའམ་ཅི་ལུས་མི་ལ་མགོ་རྟ་དང་༡༨བ་སྦྲུལ་དུ་འདུག་པ།",
    "འཚུབ་མའི་ནང་ན་འདུག་པའི་འདྲེའོ།",
    "སྟན་ལ་འདུག་ཅིག།",
    "ཉལ་པོ་བྱེད་པར་གཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "རྒྱར་དཀྱིལ་དཀྲུང་བཅས་ཏེ་འདུག་མི་ནུས་པ་དང་།",
    "འདི་དག་དུས་འབྲེལ་དུ་མཚུངས་པ་ལ་ཞག་གྲངས་མང་ཉུང་འཇོག་པ་ཅི་ཡིན་ཞེ་ན།",
    "ཀུན་སློང་རང་དགར་འབྲལ་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "བྱ་གག་སྤར་ནས་འདུག་པའི་ལམ་གྱིས་ཁྱབ་པ་ཉེ་འཁོར་ཡིན་ནོ།",
