    "དེ་དང་བྲལ་ན་གནས་ལུགས་མཐའ་དག་ཀྱང་རང་སྲོག་བྲལ་བའི་བམ་རོ་ཡིན།",
    "ཁོས་འཚོལ་ཞིབ་བྱས་པའི་བསམ་བློ་དེའང་རང་ཁོ་ནར་མངའ་བ་མིན་ལ།",
    "སྙན་ངག་ལ་དངོས་ཡོད་ཀྱི་ཉམས་སྣང་ལྡན་འདུག་པར་མ་ཟད།",
    "ཕྲག་དོག་གཡོ་སྒྱུ་དང་བདེན་དྲང་སོགས་སྐྱོན་ཡོན་གང་རུང་ཞིག་དུས་ཀྱི་ཀློང་དུ་ཇི་འདྲར་ཉམ་ཆུང་ཨང་།",
    "སྙན་རྩོམ་གྱི་དཔངས་རྒྱ་དེའང་རང་བྱུང་ཉིད་དུ་བརྩེ་སེམས་ཐད་ཀར་བ་ལས་འགོངས་ཏེ།",
    "མའི་བྱམས་བརྩེའི་འདུ་ཤེས་དེའང་གཏིང་ཟབ་ས་ཞིག་ནས་མངོན་འདུག་ལྷུག་ལྷུག་དགོད་དང་།",
    "མཇུག་མཐར་ང་རང་ཉིད་ལས་ཐར་དུས།",
    "སྒམ་དཀྱེལ་ཆེ་བའི་ཚིག་སྦྱོར་དང་རང་བྱུང་དུ་ཐོན་པ་ལྟ་བུའི་བློས་བསླང་།",
    "སྐབས་ཤིག་རྨི་ལྟས་སུ་གནས་བཅུའི་ཐང་སྐུ་ཤིན་ཏུ་ངོ་མཚར་བ་ཞིག་འདུག་པར།",
    "འཁོར་ལོ་བདེ་མཆོག་འདི་ལ་བག་ཆགས་ཆེན་པོ་ཞིག་ཡོད་པར་འདུག་འདིའི་བསྒོམ་བཟླས་གཡེལ་ན་ཡང་ཡང་བསྐུལ་བའི་ཉམས་བྱེད་ཀྱིན་འདུག་གསུངས་པ་དང་།",
    "དར་ཅིག་དགོངས་པར་བཞུགས་ནས་དུས་ལ་བབས་འདུག་པས།",
    "ང་ཚེ་རབས་མང་པོར་སློབ་དཔོན་ཆེན་པོས་རྗེས་སུ་བཟུང་བ་ཞིག་ནི་ངེས་པར་ཡིན་འདུག་ཕེབས་པར།",
    "རྨི་ལམ་ཞིག་ལ་ཞལ་བྲམ་གཟུགས་ཀྱི་སྐུ་ཐང་ལེགས་པ་ཞིག་འདུག་པའི་གཤམ་ན་འདི་ཏ་ཐཱ་ག་ཏ་རཀྵི་ཏའི་ཐུགས་དམ་མ་ཡིན་ཟེར་བ་ཞིག་འདུག་པར།",
    "ས་སྐྱའི་ཤར་ཕྱོགས་སུ་མུ་སྟེགས་འཕྲོག་བྱེད་དགའ་བོའི་གུར་ཡིན་འདུག་ཟེར་བའི་གུར་མང་པོ་རྨིས་པས།",
    "སྐུ་ཆས་ཐམས་ཅད་ལན་གསུམ་དག་པར་མཛད་སྐབས་ཤིན་ཏུ་བཀྲེན་པར་བྱུང་འདུག་ཅིང་།",
    "དུས་སྨེ་དགུ་སྨུག་དུས་སྦྱོར་བྱེད་པའི་གཟའ་དཀར་པོ།",
    "སྐུའི་སྲི་ཞུ་ལ་བརྩོན་པར་ཡོད་འདུག་པས།",
    "དེང་སང་ནི་གནོད་བྱ་གནོད་བྱེད་ཀུན་ལ་ཕན་སེམས་བསྐྱེད་དེ་བྱས་ཀྱང་ཕན་གནོད་ཆེར་མེད་པ་འདྲ་ཞིག་འདུག་ཅེས་རྗེས་སོར་བཀའ་ལས་ཐོས།",
    "དེས་ན་ཁྱེད་རང་ལ་མི་འོང་གསུངས་པས།",
    "དེ་ནས་ཁྱེད་རང་ཤེས།",
    "ཞལ་འཛུམ་པ་ཙམ་ཡང་མི་མཛད་པར་སྔགས་ལོས་ཡིན་གསུངས།",
    "དངོས་པོའི་སྒོ་ནས་གནང་དཀར་བསྟན་ཙམ་བྱུང་འདུག་པ།",
    "ཞབས་འབྲིང་ལས་བྱེད་རྣམས་ནས་བློས་བླངས་ན་དེ་ཙམ་དགོས་དོན་ཅི་ལ་སྲིད་ཀྱང་ཇི་བཞིན་མ་བྱུང་འདུག་པ་བཅས།",
    "ད་ལམ་ཁྱེད་རང་ཕྱིན་ཐོག་ཐག་ཆོད་པ་ཞིག་དགོས་ཟེར་བ་བཞིན།",
    "བསྟན་དོན་ཅུང་ཟད་བགྱིད་རྒྱུ་འོང་བ་འདི་དེ་ཁོ་ནའི་ཐུགས་རྗེར་གདའ་གསུངས།",
    "གཉིད་སད་ནས་དགེས་ཚོར་དཔེ་མེད་བྱུང་ཞེས་རྗེ་ངག་ལ་གསུང་འདུག་པ་འདི་ལ་དཔག་ན།",
    "ཞེས་པ་དེ་ཡིན་འདུག་གསུངས།",
    "ལོ་འདི་ནང་དུ་སྐུ་གེགས་འཚུབས་ལྷོང་ལྟ་བུས་རྗེ་ཉིད་ཀྱི་ཡབ་རྒྱལ་པོ་ཨོ་སྒྲོན་ལགས་ཞེ་དགུའི་དགུང་ཀེག་ཐོག་དབུས་སུ་ཞི་བར་གཤེགས་འདུག་ཅིང་།",
    "དེ་ལ་དགུ་མཐའ་མི་ཤེས་པ་འདུག་ཞུས་པས།",
    "ཤར་ཆུ་ཁ་ཟེར་བ་དེར་རི་ཆུ་ཤིང་སོགས་ཇི་ལྟ་བ་བཞིན་འདུག་པར།",
    "རྗེས་སུ་ཕྱག་རིས་ཀྱིའང་བསྐུལ་མ་གནང་བ་བཅས་དབུས་འགྲོའི་སྐབས་ཡར་ཀླུང་དུ་དེ་ལུགས་ཀྱི་སྙན་སྦྲོན་ཞུ་རྩིས་ཡོད་འདུག་པ་ལྟར།",
    "ཡར་ཀླུང་ཞབས་དྲུང་ཕེབ་བསུར་བྱོན་འདུག་པས་མཇལ་ཕྱག་ལ་བཅར་ན་ཞེས་མགྲོན་གཉེར་གྱིས་ཟེར་དོན་བཞིན་དེ་འཕྲལ་ཕེབ་ཏུ་བཅུག་པས།",
    "ཞལ་འཛུམ་མདངས་དང་བཅས་དགེས་ཉམས་འདུག་པས།",
    "མ་ཆེན་རྡོར་བཀྲས་ཀྱིས་ཚར་ཆེན་ལ་མཐུ་དགོས་ཞུས་པས་ཞལ་གྱིས་མ་བཞེས་པར་ངོ་ནག་ཐུག་གེར་བསྡད་པ་སོགས་ཀྱི་ཞིང་བཀོད་ཡིན་འདུག་གསུངས།",
    "ཚར་ཆེན་དུས་མཆོད་ཟླ་བ་སྔོན་མར་གྲུབ་ཀྱང་ཕྱི་མའི་ཚེས་བཅུ་བཞི་བཅོ་ལྔ་ལ་འཆམས་དང་མི་མང་གནས་མཇལ་བ་སོགས་བྱུང་འདུག་ཅིང་།",
    "རྗེས་སུ་བསམས་པས་ཨེ་ཀ་ཛ་ཏཱི་འདི་ཡིན་པར་འདུག་གསུང་ཞིང་།",
    "མངོན་དགའ་དབུ་བྱེད་ནས་ལུང་ཞིག་ཕུལ་འདུག་ཀྱང་གང་ཡིན་མ་ངེས་སོ།",
    "ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་ཚིགས་བཅད།",
    "སྤར་བ་དེང་དེང་བྱེད་པ་ཞིག་འདུག་གསུངས་ནས།",
    "ཐུགས་དམ་བཟང་བའི་ཚད་ཐུབ་པ་ཞིག་འདུག་གསུངས་ནས་ཐུགས་གཙིགས་ཤིན་ཏུ་ཆེ།",
    "མི་མཐུན་པའི་གཡུལ་ལས་རྣམ་པར་རྒྱལ་བར་འདུག་གསུངས།",
    "མགོན་པོའི་རྗེས་གནང་སྐབས་མགོན་ཁང་ནས་བཙོ་རྒྱུགས་པ་དིང་རི་བ་ཀུན་གྱིས་མཐོང་བའི་ཆོ་འཕྲུལ་ཆེ་བར་བྱུང་འདུག་དེར་ཆིབས་དྲེལ་སོགས་ཀྱིས་ཧ་ཅང་ཡུན་རིང་བཞུགས་མ་ཐུབ་པ་དང་།",
    "ཞེས་གསུངས་འདུག་པ་ལྷས་མི་ལ་བསྐང་བཤགས་ཇི་ལྟར་བྱེད་ཅེས་ཉམས་ལྡན་གྱི་གསུང་དང་བཅས་བཞད།",
    "འདི་སོགས་ལས་སྒྲུབ་ཀྱི་སྔགས་དུ་མ་ཞིག་རྒྱུན་པར་བཟླས་བརྗོད་བྱེད་པ་ཡིན་གསུང་བ་ལ་དཔག་ན་བསྒོམ་བཟླས་ཀྱི་རིམ་པ་དུ་མ་ཐུགས་ཉམས་སུ་བཞེས་ཚོད་དུ་འདུག་ཅིང་།",
    "རྗེས་སུ་ཡུམ་སོགས་ཀྱིས་མ་ངེས་པར་འདུག་གསུངས་པ་དག་སྣང་ཞིག་ཡིན་ནམ་སྙམ།",
    "ལུང་བསྟན་ཡང་མང་པོ་ཞིག་ཡོད་ཚོད་གདའ་སྟེ་གསལ་བར་མ་ཤེས།",
    "ད་ནངས་གུང་སེང་སྐབས་པྲསྟཱ་ར་འགོད་མ་ཤེས་པ་བློ་མ་བདེ་བས་གུང་སེང་རྣམས་བདུད་རྩིར་དམིགས་པས་ཡི་དྭགས་སོགས་ལ་བསྔོ་བཞིན་པའི་ཚེ་པྲསྟཱ་ར་པྲསྟཱ་ར་ཞེས་པ་ཞིག་བྱུང་ནས་ལྷང་ལྷང་འདུག་པར་པྲསྟཱ་ར་འགོད་ཚུལ་རྣམས་རྣམ་པ་གསལ་པོར་ཤར་བྱུང་ཞེས་འགོད་ཚུལ་ཐོགས་མེད་དུ་སྩལ་ཞིང་ལྗགས་རྩོམ་ཤློ་ཀ་གཅིག་ཀྱང་མཛད་པའི་ཁ་ཡིག་ཞལ་བྱང་དུ།",
    "ང་རང་ལ་རྟེན་བཞེངས་བྱུང་མ་བྱུང་ལ་ཁྱད་མེད་དེ།",
    "རབ་བྱུང་གྲྭ་ཚང་དུ་གུ་རུ་མཚན་བརྒྱད་ཀྱི་སྐུ་ཐང་གྲྭ་མཚུངས་དགུ་ཚར་གཅིག་གསར་བཞེངས་ཀྱི་སྦྱོར་འཇགས་བྱས་འདུག་གོ།",
    "ཁ་ཕྱེ་ནས་བལྟས་པས་ཚིགས་བཅད་ཁ་ཤས་འདུག་ཀྱང་གམ་ལ་མ་ཟིན།",
    "གདུང་རུས་སྐོར་ལ་ཡིག་ཚང་རྙིང་མའི་ཁུངས་དང་རང་ཕྱོགས་ཀྱི་ངག་རྒྱུན་བཅས་བཀོད་ཅིང་།",
    "ཁྱེད་རང་དྲན་བྱུང་།",
    "ཕར་མཇལ་བ་ཙམ་གྱིས་འཕགས་པའི་གནས་བརྟན་དགྲ་བཅོམ་པ་ཟེར་བ་དེ་འདི་འདྲ་ཞིག་ལོས་ཡིན་སྙམ་པའི་དད་གུས་སྐྱེས།",
    "ཁོང་ནས་ཡང་ཡང་ཕྲན་གྱི་གནས་ཚུལ་འདྲི་བཞིན་འདུག་ཟེར།",
    "ཉལ་ས་སྐྱིད་པོ་འདུག་གམ།",
    "ང་རང་ཚམ་ཚོམ་མེད་པར་འོག་ཏུ་ལྡང་།",
    "ཕྱི་ཉིན་ཞོགས་པར་སྤྱན་འའབེབ་བྱས་པས་འགྲིག་འདུག་གསུངས།",
    "ཁྲིད་རྒྱུན་ཆད་ལ་ཉེ་བས་ཁྱེད་རང་ཧུར་ཐག་བྱོས་གསུངས།",
    "འདི་ལྟར་འདོན་སྐབས་ཚིག་དོན་གང་ཅིའི་ཐད་འགྲིག་ནས་འདུག་གསུངས།",
    "དོན་ལ་མནལ་མ་ཡིན་པར་གནས་ཚུལ་ངོ་མ་ཡིན་འདུག་ལ་དེ་ལ་རང་བློས་དཔག་ཚོད་ཅིག་ཞུས་ན།",
    "སླེབས་དུས་ཉི་མ་ཡང་ཤར་འདུག་པ་སྟེ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་མངའ་བརྙེས་ལོའི་གུར་ཀུམ་ཆུན་པོ།",
    "དེ་ནས་མནལ་སད་འདུག་པ་སྟེ་མ་རིག་པའི་མུན་པ་རྩ་བ་ནས་མེད་པར་བྱས་པའི་དོན་ཡིན་ནམ་སྙམ་སྟེ་གནས་འདི་ནི་དག་ས་བ་སོགས་ཀྱི་སྤྱོད་ཡུལ་ལས་མ་འདས་སྙམ།",
    "ང་ཐོས་དུས་ཙ་ན་བསམ་སྒོམ་བསྡོ།",
    "བསམ་དུས་ཙ་ན་ཐོས་སྒོམ་བསྡོ།",
    "སྒོམ་དུས་ཙ་ན་ཐོས་བསམ་བསྡོ།",
    "དེ་དག་མཐོང་བའི་སྐལ་བ་ནི་མི་འདུག།",
    "དེང་རབས་མཁས་པ་མི་གསུམ་གྲལ་ན་གདའ།",
    "བསྟན་དང་རང་རིགས་སྐྱོང་བའི་མགོན།",
    "ཆེན་པོ་དག་ཀྱང་རང་ཚུགས་ཉམས་པའི་ཚེ།",
    "ཁྱེད་རང་དྲན་བྱུང་།",
    "བོད་ཀྱི་སྐད་དང་ཡི་གེའི་སླད་དུ་དཀའ་ངལ་མྱོང་བ་མང་དུ་གདའ།",
    "གངས་ཅན་རིག་པའི་དཔའ་བོ་མང་དུ་གདའ།",
    "སྤྱིའི་དེབ་གྲངས་ཉི་ཤུ་བ། ། ཁྱེད་རང་དྲན།",
    "ཁྱེད་ཀྱི་ཐུགས་རྗེའི་འོད་ཀྱིས་བསྐྱངས་པའི་ཉམ་ཆུང་བུ་ལོས་ཁྱེད་རང་དྲན།",
    "གཞལ་མེད་བཀའ་དྲིན་མཚོན་པའི་སྐྱེས་སུ་ཐ་སྙད་གཙུག་ལག་བཞེངས་ཙམ་གདའ།",
    "ཚ་གྲང་དཀའ་བ་ལས་ལྷག་དུས་རབས་བརྒལ།",
    "སྔོན་ཆད་ང་རང་བྱིས་པ་ནོར་རྫི་ཡིན་དུས།",
    "ང་དང་ང་ལྟ་བུ་མང་བོ་ཞིག་རྒྱ་མཚོ་དེའི་ནང་དུ་ལྷུང་འདུགདེ་བས་ན།",
    "ང་ཡི་ཁེར་རྐྱང་དང་དྲན་གདུང་ཤོང་ཐབས་མི་འདུགཉེས་ཅན་བཞིན་རྒྱུ་བའི་ལྡབ་ལྡིབ་ཀྱི་སྐད་ཆའི་བར་ནས།",
    "སྔར་བཞིན་འཛུམ་མདངས་ལ་འདྲེས་འདུགཉི་ཟེར་རམ་ཞོགས་པ་ལྟ་བུའི་ཚེ་སྲོག་ལོ་བརྒྱའི་རྗེས་དྲན་ཆེད་རྩོམ།",
    "ཀོང་བོ་ནས་འོངས་པའི་དམག་དཀར་ཁག་གསུམ་ཡང་སྟོད་ཀྱི་ཟངས་དཀར་ནས་འོངས་མི་རྣམས་ཆུ་དཀར་ཕྱོགས་སུ་འདུག་ཏུ་བཅུག་དེ་ཕིན་ཝུའི་པ་ཡིན་སྟབས་མིང་ཡང་མ་འགྱུར་བར་ཡོད།",
    "ཐབ་ཀའི་གོང་ངམ་བྱང་དུ་བཟའ་གནའ་དུས་ཟླ་གཉིས་པའི་ནང་དམར་མཆོད་བྱེད་པ་ཡིན་དཔོན་འདུག་པ་དང་།",
    "དྭགས་པོའི་ཆ་ལུགས་གཤིས་ལུགས་སྲོལ་དག་ཀྱང་མ་མཐོང་མ་ཤེས་འདུག་སྟེ།",
    "རང་བཞིན་ཧ་ཅང་འཇམ་པའི་བོད་མི་འདུག་གཞན་གོ་ཐོས་ཁུངས་ལྡན་ལ་ཞིབ་འཇུག་པ་རྣམས་གཞན་ཡང་ཡོད།",
    "གང་ཟེར་ན་དེའི་འབྲས་གང་འདྲ་ཐོབ་པ་རང་རང་སོ་སོར་རག་ལས།",
    "འདུག་དེ་གང་ཡིན་ཟེར་ན་སྐབས་དེར་མི་རིགས་རིག་པར་ལོ་བརྒྱའི་རྗེས་དྲན་ཆེད་རྩོམ།",
    "ང་རང་དམ་པ་ཁོང་ལ་དགོང་དྲོའི་ཆུ་ཚོད་དྲུག་ལ་ཉེ་དུས།",
    "འཛམ་གླིང་ཡུལ་གྲུ་ཁག་ལ་ཁྱབ་བཞིན་འདུག་ལ།",
    "དེ་ནི་སུམ་རྟགས་ཀྱི་དགོངས་པ་དང་མཐུན་གྱིན་འདུག་ཅེས་གསུངས་སོ།",
    "དམ་པ་སྐུ་དྲིན་ཅན་ཚོའི་མཛད་རྗེས་ཤིག་ལོས་ཡིན།",
    "དུས་མཚུངས་སུ་ཐུགས་སྟོབས་དཔྱོད་ཤེས་མི་གཉིས་པའི་མཚན་བསྟོད་ཀྱང་ཕུལ་འདུག་ལ།",
    "ཤིང་སྐམ་ནང་བཞིན་ཚོར་བ་གང་ཡང་མེད་པ་ཞིག་ཡིན་ན་དེ་ལ་སེམས་ཁྲལ་བྱེད་དགོས་པ་མི་འདུག།",
    "པ་ཞིག་ཡིན་པས་ཧ་ཅང་ནུས་པ་ཆེན་པོ་འདུག།",
    "ཁྱི་ལྟ་བུར་མཚོན་ནའང་རང་ཉིད་དང་པོ་ལྷོད་ལྷོད་བྱས་ནས་བསྡད་ཡོད་པའི་སྐབས་ཤིག་འདོད་ཆགས་དྲག་པོ་སྐྱེས་པའམ་ཡང་ན་ལྟོགས་སྐོམ་གྱིས་ཟས་ལ་རྔམ་པས་མ་སྐྱིད་པ་བྱེད་ཀྱི་འདུག།",
    "རབ་ཏུ་དོག་པ་མུན་གནག་འཐིབས་བོར་འདུག་པ་ཡི།",
    "ཧ་ཅང་རྒྱུག་པ་མགྱོགས་པ་དང་མཆོང་བ་དང་རྐྱལ་བ་དང་མེའི་དྲུང་ན་འདུག་གམ་ཙོག་ཙོག་པུར་འདུག་ན་ཡང་མངལ་ལ་གནས་པ་ལ་གནོད་པར་གསུངས་ཤིང་།",
    "རང་ཅག་ཀྱང་དེ་ལྟ་བུ་ཞིག་མི་འདུག་གམ།",
    "དེ་མིན་ན་ཡང་ད་ཚེ་རྫོགས་ན་ཡག་པོ་འདུག་བསམ་པའི་སུན་སྣང་ཡོང་དགོས་པ་ལྟ་བུ།",
    "བགྲེས་མི་འདུག་ཅེས་བཤད།",
    "ཁོས་ཧ་ཅང་སྒམ་ཚུགས་དོད་པོ་བྱེད་དགོས་ཀྱི་འདུག།",
    "མི་ཡང་དེ་ལྟ་བུ་ཆགས་གྲབས་ཆགས་གྲབས་བྱེད་ཀྱི་མི་འདུག་གམ།",
    "རྒྱ་མཚོའི་ཆུ་སྲིན་གྱིས་འབུ་ཕྲ་རབ་མང་པོ་ཞིག་དུས་གཅིག་ལ་མེད་པར་བྱེད་ཀྱི་ཡོད་པས་དེ་ལྟ་བུ་ཡིན་ནམ་སྙམ།",
    "ཁོ་ང་ལས་ཞན་པ་ཡིན་ཀྱང་ཁོ་སྔོན་ལ་འགྲོ་བཞིན་འདུག་བསམ་པའི་ཕྲག་དོག་སྐྱེ་སྲིད།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་རང་ཅག་ལ་དགོས་པའི་བདེ་སྐྱིད་ཡོངས་རྫོགས་ཤིག་གནང་ཐུབ་མེད།",
    "མགོ་འདི་བསམ་བློ་གཏོང་བ་ལ་ཕན་ཐོགས་ཆེན་པོ་ཡོད་ན་ཡང་ན་དུས་ཧ་ཅང་དཀའ་ལས་འདུག།",
    "རྗེས་སུ་ཞག་ལ་དགའ་མཁན་ཁ་ཤས་ཀྱིས་གློ་ལུད་མ་བྱེད་མ་གཏོགས་ཇ་སླ་རུ་གཏོང་ཡོང་ཞེས་སེམས་ཁྲལ་བྱེད་ཀྱི་འདུག།",
    "ཞེས་པ་རིག་པ་ཧ་ཅང་རྣོན་པོ་འདུག།",
    "ཞེས་གསུངས་པ་ལྟར་སྲིད་པའི་ཕུན་ཚོགས་ཇི་སྙེད་ཅིག་ཐོབ་ཀྱང་རང་ལ་ཕན་པ་ཅུང་ཟད་ཙམ་ཡང་མ་བྱུང་བས།",
    "ཡང་པོ་ཏོ་བའི་གསུང་ལས་སྔར་ཕན་ཆད་སྡུག་བསྔལ་དེ་ཙམ་མྱངས་པ་ཞིག་རང་ལོག་མ་བྱུང་ཙ་ན།",
    "འགྲོ་འདུག་དང་ཉལ་བ་དང་བཟའ་བཏུང་དང་ཉི་མ་དང་གྲིབ་མ་བསྟེན་པ་སོགས་ཀྱང་ཇི་ཙམ་རིང་དུ་བསྟེན་པ་དེ་ཙམ་དུ་བདེ་བ་ཇེ་འཕེལ་དུ་འགྲོ་དགོས་པ་ལ།",
    "གཅུང་དགའ་བོ་འཆག་པ་དང་འདུག་པ་དང་འགྲེང་བ་དང་ཉལ་བའི་སྤྱོད་ལམ་དག་ཀྱང་སོ་སོ་སོ་སོར་སྡུག་བསྔལ་བར་རིག་པར་བྱ་སྟེ།",
    "གལ་ཏེ་འཆག་པས་ཉི་མ་འདའ་བར་བྱེད་ཅིང་འགྲེང་བར་མི་བྱེད་འདུག་པར་མི་བྱེད་ཉལ་བར་མི་བྱེད་ན།",
    "ཙི་ཙི་དེ་འདྲ་རག་ན་གསོན་པོར་ཟ་བ་ལྟ་བུ་བྱུང་འདུག།",
    "དམག་ཆེན་གཉིས་པའི་སྐབས་ལ་མི་ས་ཡ་ཉི་ཤུ་ཡས་མས་ཤིག་ཤི་འདུག།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "རང་དགར་བཞག་ན་སྡོད་མི་འཇུག་པས་མཐར་ཁོང་ཁྲོ་ལངས་ནས་གསོད་པ་མ་གཏོགས་ཐབས་ཤེས་མེད་པ་ཆགས་ཀྱི་མི་འདུག་གམ།",
    "རང་རང་སོ་སོའི་ཉམས་མྱོང་ལ་གཞིགས་ན་ཡང་ཇི་ཙམ་གྱི་སེམས་ཞི་བ་ཡོད་པའི་ཚོད་ཀྱིས་སྐྱིད་པ་དང་།",
    "བཤེས་གཉེན་ལ་དད་པ་དེ་དག་དུས་རྒྱུན་ལྟར་ཧ་ཅང་དཀའ་ལས་བྱས་ནས་བསམ་བློ་གཏོང་མི་དགོས་པར།",
    "དེ་ལ་ཆགས་པར་འགྱུར་རོ་ཞེས་པ་དང་མཐུན་པ་མི་འདུག་གམ།",
    "སྲེད་པ་ཆང་འཐུང་འདྲ་ཞེས་གདའ།",
    "སྲིད་པ་སྦྲུམ་མ་འདྲ་ཞེས་གདའ།",
    "རྒ་ཤི་རོ་འཁུར་འདྲ་ཞིག་གདའ།",
    "མགྱོགས་ན་ཚེ་གཉིས་གསུངས་པ་འདི་སྐྱེ་བ་སྔ་ཕྱི་ཡོད་པའི་གོ་བ་ལའང་ཕན་གྱི་འདུག།",
    "མི་རྟག་པ་ཉིད་ཀྱི་མེ་རབ་ཏུ་འབར་བ་ན་འདུག་པ་ནི།",
    "ཆང་ལྟ་བུའི་ཁར་རྩམ་པ་བཏབ་ན་ཁ་ན་ཕར་ཡམ་མེ་བ་ཞིག་ལས་མི་འདུག་ན།",
    "བསམ་བློ་ཐུང་ཐུང་མཐོང་རྒྱ་ཆུང་དྲགས་པས་འཕྲལ་སེལ་གྱི་བདེ་བ་ལ་སྐྱིད་པོ་འདུག་བསམ་མ་གཏོགས།",
    "འཇིགས་པ་བྱུང་ན་ཁོང་ཁྲོ་སྐྱེས་པ་དེ་ཡང་རང་ལ་ཕན་པ་ལྟ་བུ།",
    "བོ་ཏོ་བའི་ཞལ་ནས་ཀྱང་སྔར་དེ་ཙམ་ཞིག་འཁྱམས་པ་ལ་རང་ལོག་མ་བྱུང་ཙ་ན།",
    "རྗེ་ཉིད་ཀྱིས་གསུངས་པའི་ཚིག་དེ་ནུས་པ་ཆེན་པོ་འདུག།",
    "ཞེས་གསུངས་པ་བཞིན་ཁྱིམ་པ་དང་ཁྱད་པར་མི་འདུག་གསུངས་པ་ཡིན།",
    "རང་དོན་ཁ་ཡོད་ལག་ཡོད་ཟེར་བ་དེ་ལྟར་བྱེད་ཀྱི་མི་འདུག་གམ།",
    "མུ་གེ་བྱུང་ཙ་ན་ཐམས་ཅད་ནས་ཀྱི་སྟེང་དུ་འོང་།",
    "དེ་ལྟ་མིན་པར་དང་པོར་བྱུང་ཙ་ན་དང་དུ་ལེན།",
    "སེམས་ལ་མ་རུངས་པ་ཞིག་འཁོར་གྱི་འདུག་ན།",
    "འབྲོམ་སྟོན་པ་རྒྱལ་བའི་འབྱུང་གནས་གཤེགས་ཁ་པོ་ཏོ་བའི་སྐུ་པང་ལ་དབུ་བཞག་ནས་བཞུགས་ཙ་ན།",
    "དེ་དངོས་ཡོད་ཀྱི་སེམས་ལ་ཕན་པོ་འདུག།",
    "རྣལ་འབྱོར་ལུས་ཀྱི་རྩ་ན་གདའ།",
    "མིག་མཛེས་པོ་འདུག་བསམ་པ་ལྟ་བུའི་སྒོ་ནས་སྒྲོ་བཏགས།",
    "མཚམས་ཤིག་ནས་ཁྱིམ་པ་ལས་ཀྱང་ལྷག་པ་དངུལ་ཁོ་ནའི་ཆེད་དུ་རྒྱུག་མཁན་དེ་འདྲ་འདུག།",
    "ཁ་ཤས་ཀྱིས་ཁེ་གང་ཡོད་མཐོང་ཞིང་འགན་གཏན་ནས་མ་མཐོང་བ་ལྟ་བུ་བྱེད་ཀྱི་འདུག།",
    "དེ་ལས་མ་འཇོན་པ་མ་འཇོན་པའི་སར་བསྡད་ན་ངོ་ཚ་བ་དང་རང་གཤིས་ཤོར་བ་གང་ཡང་མི་འདུག།",
    "སྒོ་གསུམ་གྱི་སྤྱོད་པ་ངོ་མ་དེ་ཁྱིམ་པ་ཕལ་པ་ཞིག་དང་ཁྱད་མེད་པ་དང་ཕྱིའི་རྟགས་ཀྱི་རྣམ་འགྱུར་སོགས་དེ་དག་ལ་བསམས་ན་ང་རྒྱལ་གྱི་གཉེན་པོར་འགྲོ་བའི་ཕན་ཐོགས་འདུག།",
    "དུད་འགྲོ་ཞིག་ལས་ཀྱང་ང་རང་ཐབས་སྐྱོ་བསམ་བ་ཞིག་ཡོང་བ་འདུག།",
    "ཤིན་ཏུ་རྙེད་སླའི་རྩྭ་ཁམ་འགའ་ལྟ་ཟུགས་ཀྱང་རང་ཉིད་ཟ།",
    "རྩྭ་ཟ་མཁན་གྱི་དུད་འགྲོ་ཞིག་ཡིན་ནའང་ཁོ་རང་སྤྱང་གྲུང་འཛོམས་ཐག་ཆོད།",
    "ཁོ་རང་དེ་ལྟར་འཚོ་ནས་ཡོད།",
    "ཚིག་དེ་ཧ་ཅང་ནུས་པ་ཆེན་པོ་འདུག།",
    "དེ་ལ་གནོད་ཐུབ་པ་མི་འདུག།",
    "ཕ་རོལ་གནོད་བྱེད་ཀྱིས་ཀྱང་རང་ཉིད་རྩ་ཆེན་པོ་བརྩིས།",
    "རྨི་ལམ་དུ་འཇིགས་སྣང་ཅན་ལྟ་བུ་བྱུང་བའི་སྐབས་དྲག་སྔགས་བགྲངས་ན་ཕན་གྱི་མི་འདུག།",
    "ཞེས་གསུངས་པ་ནུས་པ་ཆེན་པོ་མི་འདུག་གམ།",
    "བྱེད་མ་ཤེས་པ་དེ་འདྲ་འདུག།",
    "དེའི་རྗེས་སུ་དེ་དག་དམིགས་རྟེན་ལྟ་བུར་བྱས་ནས་བསམ་ན་ཧ་ཅང་ཕན་གྱི་འདུག།",
    "ཕན་སེམས་ཡོད་ཀྱང་རང་ལག་རྡུམ་ཡིན་ན་བྱེད་ཐབས་མེད་པ་ལྟར་ཡིན།",
    "སྤྱིར་གཞན་གཅེས་པར་བཟུང་ཞིང་རང་ལ་དེ་ཙམ་གྱི་གལ་འགངས་ཆེན་པོ་མི་བྱེད་པའི་བློ་སྐྱེ་དཀའ་ཡང་།",
    "མི་ཇི་བཞིན་ཕན་ཚུན་ཤ་ཚ་ཡོད་མེད་གང་ཡིན་རུང་ནང་ཚགས་གྲོགས་བྱས་ནས་སྡོད་ཀྱི་འདུག།",
    "གཞན་ཕན་མེད་ན་སྟོབས་དང་ཡོན་ཏན་དཔལ་དང་གྲགས་པ་སོགས་ཇི་ཙམ་ཡོད་ཀྱང་ངོ་མཚར་བ་མི་འདུག།",
    "མིང་ཙམ་མ་གཏོགས་དོན་སྟེང་ནས་མེད་པར་བལྟ་བ་དེ་འདྲའི་སྒོ་ནས་སེམས་སྙོམས་པར་སྒྲུབ་པ་དེ་ཞིབ་ཚགས་པོ་དང་གསལ་པོ་ཧ་ཅང་ཡག་པོ་འདུག།",
    "སྤྱིར་བཏང་རང་བཞིན་ལྷན་སྐྱེས་ཀྱི་གཉུག་མའི་རང་བཞིན་ཡིན་ན་ཡང་དེ་དག་འགྱུར་བ་སྣ་ཚོགས་འགྲོ་བཞིན་ཡོད་པ་དེ་ལས་དང་འབྲེལ་བ་གསལ་པོ་ཡིན།",
    "སུ་ཡོན་ཏན་ཆེ་བ་དང་སུ་སྐྱིད་པ་འདུག།",
    "ཐ་ན་རྨི་ལམ་ཚུན་ཆད་ལའང་ང་རང་སྐྱིད་པོ་ཞིག་བྱུང་ན་བསམ།",
    "བདག་འཛིན་དང་རང་གཅེས་འཛིན་གཉིས་ཀྱིས་ད་ལྟའི་བར་དུ་ཕན་པའི་ཟོལ་གྱིས་སྡུག་སྣ་དགུ་ལ་སྦྱར་ནའང་།",
    "ཞིང་བཅུ་ཚང་བའི་དགྲ་ངོ་མ་དེ་རང་རྒྱུད་ཀྱི་བདག་འཛིན་དང་རང་གཅེས་འཛིན་རྒྱལ་སྲས་ཀྱི་སྤྱོད་པ་སྤྱི་ལ་བསླབ་པའི་ཚུལ།",
    "ཐེག་བ་ཆེན་བོའི་རྩ་བ་ཚུགས་མི་ཚུགས་དང་ཐེག་ཆེན་བའི་གསེབ་ཏུ་བཅོས་མ་མིན་བར་ཚུད་མི་ཚུད་ཐམས་ཅད་འདི་ལ་ཐུག་འདུག་པས་དུས་ཐམས་ཅད་དུ་འདི་ལ་བློ་སྐྱེད་ཅི་བྱུང་བལྟས་ལ་སྐྱེ་ན་ནི་ལེགས།",
    "སྤྱིར་བཏང་རང་ཅག་བོད་པའི་ངག་རྒྱུན་ལ།",
    "དེ་ཙམ་ཞིག་ངོས་ཟིན་ནའང་སེམས་ལ་ཧ་ཅང་བསྒྱུར་བཅོས་ཐེབས་ཀྱི་འདུག།",
    "འགྱུར་བ་ཆེན་པོ་འགྲོ་བཞིན་འདུག།",
    "ཤར་ཕྱོགས་ཀྱི་སྦྱོར་ལམ་པ་ཟེར་བ་མ་མ་གཏོགས་བཙལ་ན་མི་རྙེད་པ་ལྟ་བུ་མི་འདུག་གམ།",
    "ཅུང་ཙམ་སེམས་ནང་ལ་ཐག་རིང་པོ་ཞིག་ཆགས་ཀྱི་མི་འདུག་གམ།",
    "རང་ཉིད་ཀྱིས་རྩོལ་བ་བསྐྱེད་ནས་བསྒོམས་ན་སེམས་ལ་འགྱུར་བ་ཐེབས་པ་ཞིག་འདུག་ཅེས་ངས་འཆད་ཀྱིན་ཡོད།",
    "དེ་ལྟར་བྱུང་ན་ཚད་རན་པོ་ཞིག་ཆགས་ཀྱི་འདུག།",
    "གོ་རྒྱུ་ཆེན་པོ་ཡག་པོ་ཞིག་འདུག།",
    "བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་ཐམས་ཅད་འགྱོད་པ་དང་བཅས་ཏེ་བཤག་པར་བྱ།",
    "གལ་ཏེ་སྲུང་ཐུབ་པ་མི་འདུག་བསམ་པ་ཞིག་ཡོད་ཚེཚེ།",
    "ང་ལ་མཚོན་ན་སེམས་ཡང་ནས་ཡང་དུ་བསྐྱེད་ཀྱི་ཡོད་པ་འདིས་སེམས་ལ་ཧ་ཅང་ཕན་གྱི་འདུག།",
    "དེ་ལས་གཞན་ཆེན་པོ་ཞིག་བྱེད་ཐུབ་པ་མི་འདུག་སྟེ་འདི་རླབས་ཆེན་པོ་ཡིན་ཞིང་།་",
    "སེམས་བསྐྱེད་ཅིག་ཅེས་འབོད་སྐུལ་ཞུ་མཁན་ང་རང་ལ་མཚོན་ན་ཡང་སྐལ་བ་བཟང་པོ་ཡིན་སམས་ནས་དྲན་བཞིན་ཡོད།",
    "སེམས་ཀྱི་གཏིང་ནས་བརྩེ་བ་དོར་ནས་འདིའི་དོན་ངས་བྱེད་ཐུབ་པ་མི་འདུག་བསམ་པ་ལྟ་བུ་རྒྱལ་སྲས་ཀྱི་སྤྱོད་པ་སྤྱི་ལ་བསླབ་པའི་ཚུལ།",
    "དེར་འདྲེས་གནོད་པ་བྱེད་ཀྱི་འདུག་ཅེས་ཞེད་སྣང་བྱས་ནས་ང་ལ་ཡོང་རོགས་ཟེར།",
    "གནོད་བྱེད་དེ་ཡང་རང་ཅག་ལྟ་བུ་རང་གཅེས་པར་འཛིན་པ་ནི་ཡོད།",
    "རྗེས་སུ་ཅུང་ཙམ་ཕན་འདུག་ཟེར།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་རྒྱལ་སྲས་ཀྱི་སྤྱོད་པ་སྤྱི་ལ་བསླབ་པའི་ཚུལ།",
    "ཐུན་གཉིས་པ་དེའི་སྐབས་སུ་བསམ་བློ་བཏང་ནས་ཨ་ཙི་ངའི་ནོར་འཁྲུལ་ཤོར་གྱི་འདུག།",
    "དེ་ནས་བསམ་ཡས་སུ་ཕེབས་པ་ན་དེ་ལ་ལོ་ཙྪ་བས་སྣོན་བ་ཞུས་ནས་རྒྱས་སུ་བཏང་ཟེར་བ་འདུག་པས་ཇོ་བོས་འགྲེལ་བ་བསྡུས་པ་ཞིག་མཛད་བ་ལ།",
    "བཅས་པའི་ཁ་ན་མ་ཐོ་བ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་དེ་ལེགས་པར་སྡོམ་དགོས་ཞེས་གསུངས།",
    "སྐྱེ་བོ་རྣམས་བདེ་བས་ཕོངས་བ་དང་སྲིད་བའི་མེས་ཚིག་བ་དང་སྡུག་བསྔལ་སེལ་བའི་མཐུ་མེད་པ་དང་རང་བཞིན་གྱིས་སྡུག་བསྔལ་བར་མཐོང་བའི་ཕྱིར་རོ།",
    "ཚོགས་ཀྱིས་སྐྱོ་བ་མེད་པ་དང་རང་བསླུ་བ་ལ་སོགས་པའི་སློང་བ་བོའི་སྐྱོན་མཐོང་ཡང་གཞན་སྒྲོག་བའི་བསམ་པ་མེད་པ་དང་།",
    "འཚོ་གོས་ཡོ་བྱད་གང་ལ་ཡིན་ན་ཡང་ཁོ་རང་སྐབས་སུ་བབ་པའི་མཐུན་རྐྱེན་སོ་སོས་སྦྱར་ཐུབ་པ་སྦྱར།",
    "ཕྱིས་སུ་ཕངས་སེམས་སྐྱེས་ནས་སེམས་ཁྲལ་བྱེད་ཀྱི་འདུག་གསུངས།",
    "ཞེས་པའི་ཚིག་འདི་ཧ་ཅང་རྣོན་པོ་འདུག།",
    "གནོད་པ་བྱེད་མཁན་ཁོ་རང་ལ་ཁྲོ་ན་ནི།",
    "མཐོ་འདུག་ཟེར་ན་ཅུང་ཙམ་སྐྱིད་པ་ལྟ་བུ་དང་།",
    "འོ་སྐོལ་ལ་འགབ་མ་ཡང་གྲགས་ཟེར་ནས་མིས་སྨྲ་ཡིན་འདུག་བྱས་པས།",
    "དགྲ་རྒུད་པ་ལ་དགའ་བ་དང་བརླག་ན་སྙམ་པའི་བསམ་པ་ངན་པ་རྣམས་ཀྱང་དེ་ཙམ་གྱིས་དགྲ་ལ་མི་གནོད་བས་རང་སྡུག་བསྔལ་བ་ཙམ་དུ་ཟད་ལ་གནོད་ནའང་རང་འགྱུར་བའི་ཉེས་དམིགས་བསམས་ནས་རྣམ་བ་ཐམས་ཅད་དུ་དགག་བར་བྱ་སྟེ།",
    "འོན་ཀྱང་རང་ལ་ནི་གནོད་ཐག་ཆོད་ཡིན།",
    "རྒྱུན་ལྡན་ལྷོད་ཤིག་ཤིག་ངང་བསྡད་ན་དགྲ་དེས་ཀྱང་ངས་ཁོ་ལ་གནོད་པ་མང་པོ་བསྐྱལ་ཡང་ཁོ་ནི་སྣང་བ་སྐྱིད་ནས་བསྡད་འདུག་བསམ་པ།",
    "སྡུག་བསྔལ་བྱུང་བ་དེ་སླར་བཅོས་སུ་འདུག་ན་ནི་ཡིད་མི་དགའ་བ་བྱ་མི་དགོས་ལ།",
    "འཆག་པ་དང་འགྲེང་བ་དང་འདུག་བ་དང་ཉལ་བ་ནི་སྤྱོད་ལམ་བཞི་ཡིན་བ།",
    "ཚེ་འདིར་སྒྲུབ་པའི་འདོད་པ་དང་བརྩོན་འགྲུས་ཡོད་ན་ཡང་རང་ལ་སྤོབས་པ་མེད་པར།",
    "ད་ལྟ་དེ་འདྲ་མེད་ནའང་རིམ་གྱིས་འབྲེལ་བ་ཡོང་ཐུབ་རྒྱུ་ཡིན་པ་ལས་དེ་མྱུར་པོར་འབྲེལ་དཀའ་སེ་བ་འདུག།",
    "སྤྱི་ཡོངས་ནས་ཅུང་ཙམ་ཐག་རིང་པོ་ལྟ་བུར་བྱུང་བ་དེ་འདུ་ཤེས་ཀྱིས་བྱེད་ཀྱི་འདུག།",
    "གསུང་རྣོན་པོ་སེམས་ལ་ཕན་པོ་ཧ་ཅང་ཡག་པོ་འདུག།",
    "ཡིད་བཞིན་མཛོད་སོགས་ཧ་ཅང་ཡག་པོ་འདུག།",
    "བདག་ཉིད་ཀྱང་ནི་ཇི་ལྟར་འདུག།",
    "གཞུང་གཞན་འགའ་ཞིག་ནང་ཚིག་མང་ཙམ་སྣོན་པར་བྱས་པ་མ་གཏོགས་ཧ་ཅང་འབྲེལ་ཆགས་པོ་མི་འདུག།",
    "བོད་པ་གཅིག་པུ་མ་ཡིན་པར་རྒྱའི་གྲོགས་པོ་ཚོའི་ནང་ལ་ཡང་དེ་འདྲ་འདུག།",
    "ཚུལ་འདི་བསམས་ཤིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ།",
    "ངས་འདི་ཚོ་བསྐུར་རྒྱུ་བརྗེད་འདུག་ངའི་ལག་པ་འཇུས་དང་།",
    "འདིར་རྐུ་མ་ཧ་ཅང་སྡང་པོ་ཡོད་པས་ག་དུས་ཡིན་ནའང་སྒོ་དང་ཁ་མ་བྲལ་བ་གྱིས་ཞེས་མངགས་བྱ་ནན་པོ་གནང་།",
    "ཨ་ཞང་།",
    "གང་ལྟར་མཐོང་མྱོང་འདུག་སྙམ་ནས་བསྡད།",
    "ཁྱེད་རང་དངོས་འབྲེལ་སློབ་སྦྱོང་ཏོག་ཙམ་བྱེད་དགོས་འདུགསྒྲ་གདངས་སྒྲིག་སྦྱོར་ལས་ཀྭ་ལོ་ལྷག་བྱས་ཙང་ང་རའི་བསམ་པར་ང་རང་ཀང་ཆིན་གྱི་སྒྲ་རྒྱགས་ཚད་ཉན་རྒྱུ་བྱུང་སྙམ།",
    "གལ་སྲིད་ཁྱེད་རང་ཀང་ཆིན་གཏོང་རྒྱུར་དགའ་པོ་དེ་འདྲ་ཡོད་ན་ཁྱེད་རང་དངོས་འབྲེལ་སློབ་སྦྱོང་ཏོག་ཙམ་བྱེད་དགོས་འདུག་ཅེས་ཟེར་བྱུང་།",
    "ང་དྲན་གྱི་མི་འདུག་ངས་བསམ་བློ་ཞིག་བཏང་ཟེར་ནས།",
    "མི་འདུག་ཅེས་ལན་བཏབ།",
    "བུ་ཡིན་ན་ལོ་སོན་རྗེས་གཞི་ནས་དམག་མིར་ཞུགས་ཆོག་དེས་ན་དམག་མིའི་ཨེམ་རྗེས་ཁོའི་གཟུགས་པོར་བརྟག་དཔྱད་བྱེད་སྐབས་ཁོས་ཁོ་རང་ལོ་ཡིན་ཞེས་ཞུས།",
    "ཁྱེད་རང་ལོ་ག་ཚོད་ཡིན་ནམ་ཞེས་དྲིས།",
    "ངས་འདི་ཚོ་བསྐུར་རྒྱུ་བརྗེད་འདུགཡེ་ཤུའི་འཁྲུངས་སྐར་དུས་ཆེན་ཟིན་པར་གཟའ་འཁོར་གཉིས་ལས་བསྡད་མེད་པས་ལྕམ་སི་སྨི་སི་ནི་བྲེལ་བ་ཤིན་ཏུ་ཆེ།",
    "ངས་ན་ནིང་བྲིས་ནས་ད་བར་བསྐུར་རྒྱུ་བརྗེད་ནས་ལུས་འདུག་ཅེས་བཤད།",
    "ད་ལྟ་ཡང་བོང་བུ་ལྔ་ལས་མི་འདུག་ཁྱེད་རང་ལྟོས་དང་།",
    "ག་དུས་ཡིན་རུང་དེ་བཏུང་ཚར་རྗེས་ཡང་བསྐྱར་གྷ་ལ་སེ་དོ་དགོས་ཟེར་གྱི་ཡོད།",
    "ངས་ཁྱེད་རང་ལ་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན་ཞེས་ཞུས།",
    "དེས་ན་ངས་ང་རང་དང་ཐུག་མཁན་མི་ཚང་མ་སེམས་པ་སྐྱིད་པོ་ཡོང་བ་བྱེད་ཐུབ་ཀྱི་ཡོད་ཅེས་བཤད།",
    "འོ་ན་ཁྱེད་རང་ཉི་གདུགས་བསྣམས་ནས་ཉི་འོད་བཀག་ཡས་ཡིན་ནམ།",
    "ང་སྐད་ཆ་དེ་འདྲ་ཉན་འདོད་མི་འདུག་གལ་ཏེ་ངས་གནམ་དྭངས་བའི་སྐབས་སུ་ཉི་གདུགས་འཁྱེར་ནའང་མི་ཚོས་མ་མཐར་ཡང་ཁྲེལ་རྒོད་དང་བཅས་ལྟོས་དང་།",
    "དངུལ་ཁང་རང་ལ་ང་ཞུ་དགོས་ཡས་གང་ཡང་མེད།",
    "ངས་འོ་ན་ཁྱེད་རང་ད་དུང་ཁ་བྲལ་དགོས་དོན་ཅི་ཡིན་ཞེས་དྲིས་པར།",
    "བྱས་ཙང་ང་བློ་ཕངས་པོ་ཞེ་དྲག་འདུག་ཟེར།",
    "ཁོས་ཕྱི་ནས་སྒོ་ཕྱེ་སྟེ་སྒོ་རའི་ནང་འཛུལ་རྗེས་སྒོ་རྒྱག་རྒྱུར་སྒུག་ནས་སྡོད་པ་དང་དེ་རྗེས་སླར་ཡང་མིས་སྒོ་ཕྱེ་ནས་ཕྱིར་མ་བཏང་བར་སྒོའི་ནང་དུ་སྐད་བརྒྱབ་ནས་སྡོད་ཀྱི་འདུག་ཕྱིར་ཐོན་རྗེས་ཡང་ལམ་སེང་ནང་དུ་འཛུལ་ཡོང་བ་དང་དེ་ནས་ཡང་སྐད་རྒྱག་འགོ་ཚུགས་ཀྱི་ཡོད་སྟབས།",
    "རྟ་གོག་སྤྱོད་ངན་པ་འདིས་ང་ལ་གང་ཡང་ཟེར་གྱི་མི་འདུག་ཅེས་ལན་བརྒྱབ།",
    "ནང་དུ་སྔ་ས་ནས་བཟས་ཆས་འདང་ངེས་མེད་ལ་ལྷག་པར་དེ་དགོང་ཁོ་རང་དང་ཨ་ཅེ་ཡང་རྒྱགས་པ་ཞིག་མེད་སྟབས།",
    "བྱས་ཙང་ཁྱེད་རང་ཡིག་ཟམ་ཅུས་ལ་ཕྱིན་ཏེ་ཁྱེད་ཀྱི་ཡིག་སྒམ་ལས་རང་ཉིད་ཀྱི་ཡི་གེ་དང་སྦྲག་གཏོང་དངོས་རྫས་ཚུར་ལེན་དགོས།",
    "ཁག་ཅིག་ནི་བརྡོལ་ཡང་བརྡོལ་འདུག་པས།",
    "གོང་བ་ཆུང་ཐག་ཆོད་འདུག་ཅེས་བཤད།",
    "མི་དེས་སྔོན་ཤེས་ཐུབ་ཀྱི་འདུག་ཟེར་བ་དང་ལྷན་མི་དེའི་རྗེས་ཟིན་པ་བྱས་ནས་རང་ཉིད་ཚེ་རིང་ཐུང་ག་ཚོད་ཡོད་མིན་སྐད་ཆ་འདྲི་དགོས་བསམ་ཡང་མི་དེ་ཕྱིན་ཚར་ནས་མེད།",
    "ལྡུམ་རའི་ནང་མི་གཞན་འདུག་གམ།",
    "ངས་རྟ་ཞིག་མིད་ཁྱུར་བཏང་བས་ད་བདེ་པོ་གཏན་ནས་མི་འདུག་ཅེས་སྨྲས།",
    "ཉ་ཤ་ཞིམ་པོ་འདུག་གམ་ཞེས་དྲིས།",
    "མན་པའོ་ཟས་དེབ་ཐོག་འཁོད་མེད་ཀྱང་ཁྱེད་རང་དེ་ཚོ་བཟའ་དོན་གང་ཡིན་ནམ་ཞེས་དྲིས།",
    "ད་བྱས་ན་ཁྱེད་རང་ཞོག་གོག་སྣུམ་བཀྲག་ཟ་རྒྱུར་དགའ་པོ་ཡོད་དམ་ཞེས་དྲིས།",
    "ཕས་ཡག་པོ་འདུག་ཅེས་སྨྲས།",
    "ངས་དེ་འདྲ་ཞུས་པར་གལ་སྲིད་ཁྱེད་རང་དགོངས་པ་མ་འཚོམས་ན་ཞེས་ཟེར།",
    "དེ་ལྟར་དབེན་གསུམ་དང་ལུས་ཀྱི་བྱེད་པ་བཅིངས་པའི་འདུག་སྟངས་ཀྱིས་རྩ་གཡོ་མེད་དུ་འཆིང་།",
    "དེ་ཡང་མཐའ་གཅིག་ཏུ་མ་ངེས་པར་འདུག་ཅིང་ལྷབ་ལྷབ་འབར་བའི་རྣམ་པ་ཅན་དུ་བྱུང་ན།",
    "རྐང་པ་བརྐྱངས་བསྐུམ་དུ་འདུག།",
    "འཇུག་དུས་སེམས་དང་རྟགས་སྣང་བསྲེ།",
    "དེ་ལ་རྩོལ་བ་ལ་འཇུག་དུས་འཁོར་རྫོགས་རིམ།",
    "འཁོར་ལོ་སོ་སོར་བུམ་ཅན་འཛིན་པ་དང་འདུག་སྟངས་སྤོག་ཆོག་རྣམས་ཞིབ་པར་ཁྲིད་ཡིག་ལས་ཤེས་པར་བྱའོ།",
    "དེ་ཡང་རང་དང་ཡུམ་དུས་འཁོར་ཡབ་ཡུམ་དུ་གསལ་བཏབ་རྩ་གསུམ་འཁོར་ལོ་བཞིའམ་དྲུག་གསལ་དེ་དང་སྟོང་གཟུགས་བསྲེ་ཐུབ་ན་རབ།",
    "ཆ་དྲུག་ལ་ནི་འབུམ་ཕྲག་གཉིས་གཉིས་སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྦྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "ཚངས་དང་ཁྱབ་འཇུག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རྒྱལ་པོ་ལོ་ནི་མཐའ་དག་དུས་འཁོར།",
    "རྗེས་སུ་ཉིན་ཞག་དུས་སྦྱོར་ཆུ་ཚོད་དག་དང་ཆུ་ཡི་སྲང་རྣམས་ཏེ།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད།",
    "དེ་ལྟར་གཟའ་རྣམས་ཀྱི་ནི་རྒྱུ་བ་མཐའ་དག་དུས་ཀྱི་འཁོར་ལོ་དག་ལས་ཤིན་ཏུ་ངེས་པར་འགྱུར།",
    "དཀར་པོའི་མདའ་དང་ཆུ་གཏེར་ཟླ་བ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར།",
    "ཚོད་དེ་ནི་དུས་ཀྱི་ཉིན་ཞག་དུས་ལ་ཆ་དམན་ཟླ་བ་སྟེ།",
    "དེ་ལ་ཡུད་ཙམ་སུམ་ཅུ་རྣམས་དང་ཉིན་ཞག་དུས་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ན་སྟེ།",
    "ཡང་དག་དུས་སྦྱོར་ཐམས་ཅད་ཀྱིས་ཏེ་སླར་ཡང་གལ་ཏེ་རང་ལུས་གཡོན་གྱི་རྩ་ལས་གྱུར་པ་ན།",
    "རང་རང་ཡི་གེས་ཤེས་བྱ་རྣམ་གསུམ་ཁྱབ་བདག་བགྲོད་པ་རྣལ་འབྱོར་པ་ཡིས་སྟོང་པའི་དབྱེ་བས་སོ།",
    "ཅན་དང་རང་བཞིན་མེད་པའོ།",
    "དེ་ཡིས་དངུལ་གྱི་འདབ་མ་བྱུགས་པ་གསེར་ཉིད་དུ་འགྱུར་སྨིན་པ་དག་དུས་འཁོར།",
    "ཁམ་བུའི་ཐོག་མ་ཐ་མར་སྦྲང་རྩི་དག་དུས་འཁོར།",
    "བྱེད་པོ་བདག་དང་ལས་དང་དུས་དང་རང་བཞིན་དང་ནི་ཡོན་ཏན་སྟོང་དུས་འཁོར།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཇི་ལྟར་འགྲོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཡིས།",
    "ལཱ་བ་ཕུག་དུས་འཁོར།",
    "ངེས་པར་འཇམ་པའི་མལ་སྟན་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་བསྲུང་བ་བྱས་ནས་ནི།",
    "དེ་བཞིན་ངེས་པར་མཚོན་ཆ་དག་དང་བཅས་པའི་ཕྱག་རྣམས་དག་དུས་འཁོར།",
    "ཕྱི་ནས་ཤེས་རབ་ལ་སོགས་དྲུག་ནི་རབ་ཏུ་གསལ་བར་བདག་པོར་ང་རང་པདྨའི་གདན་ལའོ།",
    "གདེངས་ཅན་རིགས་དང་བཅས་པ་རང་རང་ཕྱོགས་ཀྱི་བཞོན་པར་གནས་པའི་ལྷ་རྣམས་རྡོ་རྗེ་གདན་གྱིས་གནས།",
    "ཀཾ་པ་ཁྱབ་འཇུག་དུས་ཏེ་འཕྲོག་བྱེད་ཅེས་དང་ནོར་སྦྱིན་དག་ཀྱང་སཾ་དང་འདིར་ནི་ཉིད་དོ།",
    "ཧཱུཾ་ཡིག་ཡེ་ཤེས་ལས་སྐྱེས་འཇིག་དུས་སྤྲིན་དང་མཚུངས་པ་རྩེ་ལྔ་འོད་ཟེར་དང་བཅས་དགོད་པར་བྱ།",
    "བསྒྲུབ་བྱ་འཁོར་ལོས་འཇིགས་པར་བྱས་ནས་ས་ལ་རབ་ཏུ་བསྐྱེལ་ཏེ་ལྕགས་སྒྲོག་དུས་འཁོར།",
    "སྔགས་ཀྱིས་དགུག་པར་རབ་ཏུ་འགྱུར་ཏེ་གདོན་གྱི་ཚོགས་པ་མཐའ་དག་དུས་ཀྱི་སོས་ཟིན་རྗོད་པར་བྱེད།",
    "གཡས་པ་བརྐྱང་ཞིང་རང་རང་སྣོད་རྣམས་ཀྱིས་ནི་ལྷ་མིན་ཁྲག་འཐུང་སྐྲ་གྲོལ་གོས་དང་བྲལ་བ་སྟེ།",
    "སྣ་ཚོགས་དངོས་རྣམས་ཀྱིས་བྱེ་རྒྱལ་བ་དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཉིས་འགྱུར་མི་བདག་གཞན་རྣམས་ཚེས་ནི་བརྒྱད་གཉིས་དབྱེ་བ་ལ།",
    "རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྐང་པ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ།",
    "དེ་ཡི་དུས་སུ་རྒྱལ་པོའི་འགྲོ་བ་དག་ནི་རང་རང་ཚད་ཀྱིས་རྣམ་མི་ཕམ་བཀའ་འབུམ།",
    "ཉི་ཤུ་འགའ་ཞིག་ལྷག་པའི་བརྒྱ་ཕྲག་གང་ཞིག་དུས་དང་དགུ་ཡིས་མི་རྣམས་ཀྱི་ནི་འཇིག་རྟེན་ཚད།",
    "དེ་བཞིན་དུ་ངོ་བོ་ཉིད་ཀྱིས་གནས་པ་ཞེས་ཚིག་དུས་འཁོར་ཁམས་ལེ་འགྲེལ།",
    "ལུང་སྟོན་པའམ་བརྡའ་སྤྲོད་པ་དག་ལ་ལྷ་ཀླུས་བཀོད་པའི་རྐྱེན་དང་རང་བཞིན་སོགས་སུ་ཕྱེ་བའི་སྒྲ་སོགས་འདི་རིགས་འདི་མི་རིགས་ཞེས།",
    "རིགས་བཞི་དང་རང་བཞིན་གྱི་རིགས་ལྷན་ཅིག་པའི་རིགས་ལྔ་དང་།",
    "རང་བཞིན་མེད་ཀྱང་རྣལ་འབྱོར་པས་དམིགས་ཤིང་རང་རིག་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་ལྟར་གཙོ་བོ་རང་རང་ལས་མ་བྱུང་བའི་ཁམས་ལྷག་མ་གསུམ་ནི་ཁུ་བ་དང་རྡུལ་ཕན་ཚུན་འདུས་པའི་རྐྱེན་ལས་ཕལ་པའི་རྒྱུ་ལས་བྱུང་བའོ།",
    "བསྒྱུར་བ་སོགས་བཞི་ཀ་ཙ་ན་སོགས་སྒྲ་གཞུང་རྣམས་ལ་ཡོངས་སུ་གྲགས་པ་ཡིན་ལ་ཨ་ཡིག་ཧར་བསྒྱུར་བ་འདི་ཀ་ཙ་ན་སོགས་སུ་མ་གྲགས་ཀྱང་ཤམ་བྷ་ལའི་འཇམ་དཔལ་བརྡ་སྤྲོད་ཀྱི་ལུགས་ལ་ཡོད་དོ།",
    "དེ་ལྟར་དེ་དག་རང་རང་སོ་སོའི་དབུགས་དེ་ཉི་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱ་ལ་སོ་སོའི་ཉིན་ཞག་གཅིག་ཏུ་བརྩི་བ་ཡིན་ནོ།",
    "རང་རང་ལས་ལ་ཉེར་སྤྱོད་པས།",
    "རང་རང་རྒྱུ་བ་ལས་རབ་གྲུབ།",
    "དེར་མ་ཟད་གཟའ་རང་རང་སྐྱེས་པའི་སྐར་མ་ལ་ཡང་དགྲར་གྱུར་པ་དག་ལྷན་ཅིག་གྱུར་ན་འཐབ་སྟེ།",
    "བྱང་བགྲོད་མཐར་ཐུག་དུས་ལྷུན་པོའི་རྭ་དང་ཐད་མཉམ་དུ་ཉི་མ་སླེབས་པ་དང་།",
    "གླང་ལ་དབྱུག་བཞི་ཆུ་སྲང་བཞི་བཅུ་སོགས་བཀོད་པ་འདུག་གོ།",
    "བརྒྱད་པོ་དེ་ལས་རབ་ཏུ་གསལ་བར་དུ་བའི་ལོངས་སྤྱོད་ཀྱི་ཆ་ཆུ་ཚོད་ཕྱེད་དོར་བའི་ལྷག་དུས་ཕྱེད་བཅས་བདུན་གྱི་ཝ་",
    "དེ་ལྟར་སྦྱང་བའི་ཕྱི་ནས་ཏེ་རྗེས་སུ་གཟའ་དེ་དྭག་རྣམས་ནི་དྭག་པར་འགྱུར་ཏེ་ཇི་ལྟར་ན་ཀྱེ་མི་ཡི་བདག་པོ་གཟའ་རང་རང་སྐྱེ་བའི་རྒྱུ་སྐར་གང་ཡིན་པ་དེ་ཝ་",
    "གཟའ་རྣམས་རང་རང་དཀྱིལ་འཁོར་ལོ།",
    "དེ་ཡང་རང་བྱུང་རྩ་བའི་དབྱངས་ཨ་ཨི་རྀ་ཨུ་ལྀ།",
    "གང་ཤར་བ་དེ་ཉིད་ནི་ཕྱི་ནས་སམ་སླར་ཡང་རང་ས་ནས་བགྲང་བའི་ལྔ་པ་ལ་ནུབ་པ་ཉིད་དུ་འགྱུར་བའོ།",
    "རིམ་པ་བཞིན་ཕ་རོལ་གྱི་དགྲ་ཉམས་པ་དང་རང་ཉིད་ཀྱི་དཔལ་རྒྱས་ཤིང་གཡུལ་དུ་རྣམ་པར་རྒྱལ་ཏེ་དགའ་མ་དང་བཅས་པའི་ནོར་དག་ཐོབ་པར་འགྱུར་རོ།",
    "གཞན་ཡང་མགོན་པོ་ཀླུ་སྒྲུབ་དགུང་ལོ་དྲུག་དུས་འཁོར་ཁམས་ལེ་འགྲེལ།",
    "དེ་ལས་མང་ན་མང་སྐྱོན་འདུག་པས།",
    "ཉི་མ་རིང་བ་མཐར་ཐུག་དུས་ཉིན་ཆུ་ཚོད་སོ་དྲུག་མཚན་ཉེར་བཞི།",
    "འདི་རྒྱ་རྩིས་ཀྱི་ཉི་ལྡོག་དང་འདྲ་འདུག།",
    "དེ་སྐད་དུ་ཡང་རང་འགྲེལ་ལས།",
    "རྟོག་པ་དེ་རྟོག་མྱོང་རང་རིག་མངོན་སུམ་གྱི་འཇུག་ཡུལ་དང་།",
    "དེ་ཡང་རང་མཚན་དང་།",
    "དངོས་པོ་དང་རང་མཚན་ལ་ཁྱབ་ཆེ་ཆུང་ཇི་ལྟར་ཡོད་སྙམ་ན།",
    "དངོས་པོ་དང་རང་མཚན་ལ་ཁྱད་པར་མེད་དེ།",
    "དེ་ཡང་རང་ལས་དོན་གཞན་པའི་ཡུལ་རིག་པ་ལ་བྱེད་དོ་ཅེས་ཟེར་བ་ནི་མི་འཐད་དེ།",
    "གཞན་ཡང་རང་རིག་ལ་ཡུལ་མེད་པས་ཤེས་སོ་བཞི་པའི་མཚན་ཉིད་མེད་པར་འགྱུར་རོ།",
    "དེས་རང་མཚན་མཚན་ཉིད་པ་མི་འཛིན་ཡང་རང་མཚན་དུ་སྣང་བ་ཙམ་ཞིག་འཛིན་ཏེ།",
    "གཞན་ཡང་རང་མཚན་ཁོ་ན་བརྗོད་བྱ་ཡིན་ན།",
    "རང་མཚན་ཉིད་ལ་བརྡ་སྦྱོར་དངོས་སུ་མེད་ན་སྤྱི་དང་འབྲེལ་བ་བསྣན་ཀྱང་རང་མཚན་གོ་མི་ནུས་པའི་ཕྱིར།",
    "འཆད་དུས་དང་འཇུག་དུས་གཉིས།",
    "འཇུག་དུས་ཀྱི་བརྗོད་བྱ་ལ།",
    "འཇུག་དུས་ཀྱི་ཞེན་པའི་བརྗོད་བྱ་མེད་པའི་ཕྱིར་ཏེ།",
    "འཇུག་དུས་ཀྱི་བརྗོད་བྱ་། ཡིན་ན།",
    "དེ་བཞིན་དུ་འཇུག་དུས་ཀྱི་རྗོད་བྱེད་ལ་ཡང་དངོས་དང་ཞེན་པ་གཉིས་སུ་མེད་དེ།",
    "འཇུག་དུས་ཀྱི་རྗོད་བྱེད་ཡིན་ན་སྒྲ་སྤྱི་ཡིན་པས་ཁྱབ་པའི་ཕྱིར།",
    "མཚན་གཞི་ནི་བུམ་པའི་སྒྲ་སྤྱི་དོན་ལྔ་དང་དེའི་ཆ་ཤས་ཀྱི་སྒྲ་རང་མཚན་པ་གཉིས་གཅིག་ཏུ་འཁྲུལ་པའི་གནས་སྐབས་ཀྱི་སྒྲ་དེ་འཇུག་དུས་ཀྱི་བུམ་པའི་རྗོད་བྱེད་ཡིན་པ་ལྟ་བུའོ།",
    "དེས་ན་འཇུག་དུས་ཀྱི་བརྗོད་བྱ་རྗོད་བྱེད་གང་རུང་ཡིན་ན།",
    "འཇུག་དུས་ཀྱི་དེ་གང་རུང་ཡིན་པས་མ་ཁྱབ་སྟེ།",
    "མིང་ཚིག་ཡི་གེ་རྣམས་ཀྱང་རང་མཚན་དུ་ཁས་ལེན་དགོས་པས།",
    "འཆད་དང་འཇུག་དུས་འགལ་དང་མི་འགལ་དང་།",
    "གཞན་ཡང་རང་དུས་སུ་རྒྱུ་ལ་རག་ལས་ན་རང་དུས་སུ་རྒྱུ་འདས་པས་དངོས་མེད་དང་།",
    "རང་མྱོང་རང་རིག་མངོན་སུམ་ནི་རྟོག་མེད་དང་།",
    "རང་མྱོང་རང་རིག་མངོན་སུམ་དང་འབྲེལ་པ་མ་དྷཱི",
    "རིག་གཏེརཁྱབ་བྱེད་མ་དམིགས་པ་དང་རང་བཞིན་མ་དམིགས་པ་ནི་ལྡོག་འབྲེལ་བདག་གཅིག་འབྲེལ་འགྱུར་བས་སོ།",
    "དངོས་ནའང་རང་གྲུབ་རྒྱུ་ཅི་དགོས།",
    "འབྲས་བུ་དེ་དེ་རང་རང་རྒྱུ་དེ་ལས།",
    "ཕན་ཚུན་སྤང་འགལ་བསྟན་པ་ཁྱེད་རང་ཡང་འདོད་དགོས་པས་རྣམ་རིགས་ཀྱི་གཞུང་དེ་གཉིས་འགལ་བ་ལ་ལྷན་ཅིག་མི་གནས་འགལ་དང་།",
    "བརྗོད་བྱ་རྗོད་བྱེད་ལྟར་འདིར་ཡང་འཆད་དུས་ཀྱི་མཚན་མཚོན་དང་འཇུག་དུས་ཀྱི་མཚན་མཚོན་གཉིས་སུ་ཕྱེ་ནས།",
    "དང་པོ་དངོས་པོ་དང་དངོས་མེད་གཉིས་ལ་རྣམ་གཞག་བྱས་ཏེ་ཐད་སོར་མཚན་ཉིད་པ་དང་འཇུག་དུས་ཀྱི་མཚན་མཚོན་ནི།",
    "རང་རང་བློས་བཏགས་གྲུབ་པའི་མཐའ་མང་ཡང་།",
    "འོན་ཀྱང་འཆད་༡༥༣དང་འཇུག་དུས་རྣམ་དབྱེ་གཅེས།",
    "དེ་ལ་རང་མྱོང་རང་རིག་མངོན་སུམ་ངོ་བོ་གཅིག་ཏུ་ལྡན་པའི་ཕྱིར།",
    "རློམ་ཚོད་ནི་སྒྲ་དོན་དང་རང་མཚན་གཅིག་ཏུ་རློམ་ཞིང་འཁྲུལ་པ་སོགས་ཡིན་པས།",
    "དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "འདིར་ཡང་རང་ལུགས་སུ་བཀོད་པ་ཡིན་ཞིང་།",
    "དེའི་དོན་ཡང་རང་མཚན་གཞིར་བཟུང་བའི་ཚེ།",
    "དེ་ཡང་རྟོག་མྱོང་རང་རིག་མངོན་སུམ་སོགས་རང་རིག་དེ་དང་དེའི་ཉེར་ལེན་གྱི་རྒྱུར་གྱུར་པའི་ཤེས་པ་སྔ་མ་དེ།",
    "དབྱེ་བ་ཡུལ་གཞན་མཐོང་དང་རང་མཐོང་དང་།",
    "གསུངས་པ་མཁས་རྣམས་རང་རང་འོལ་སྤྱི་ཡིས།",
    "ཀ་རིག་གཉིས་པོ་དེ་རང་མྱོང་རང་རིག་མངོན་སུམ་དང་རྫས་གཅིག་པ་མ་གཏོགས།",
    "རང་རིག་པའི་ཡེ་ཤེས་དང་རང་རིག་པའི་མངོན་སུམ་ཡིན་ན།",
    "དེའི་མཚུངས་པ་དེ་མ་ཐག་རྐྱེན་གྱི་ལག་རྗེས་དེ་མ་ཡིན་པ་ལ་ཤེས་བྱེད་མི་འདུག་པའི་ཕྱིར།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "ཤེས་པ་རང་རང་ངོ་བོ་མྱོང་བྱེད་ལ།",
    "ཤེས་པ་ཐམས་ཅད་རང་རང་ངོ་བོ་ལ།",
    "འོ་ན་གཞལ་བྱ་ཀུན་ཀྱང་རང་མཚན་དུ།",
    "ཤེས་ཀུན་རང་རང་སྣང་ཡུལ་མ་ཡིན་ན།",
    "ཁྱེད་རང་གཞུང་དེས་སྒྲུབ་བྱེད་ཀྱི་རྟགས་མཚན་ཉིད་པ་བསྟན་གསུངས་པ་འོལ་སྤྱོད་དེ།",
    "ཐེག་གསུམ་རང་རང་འབྲས་བུ་ཐོབ་པ་ནི།",
    "སྒྲུབ་བྱེད་རྣམ་གཉིས་འབྲས་དང་རང་བཞིན་ཡིན།",
    "དེ་ལས་གཞན་པའི་འཛིན་ཚུལ་མི་འདུག་པའི་ཕྱིར་ཏེ།",
    "ཡང་རང་འགྲེལ་ལས།",
    "སྣང་བ་དེ་གཉིས་ལས་གང་རང་རིག་པ་ནི་འབྲས་བུའོ།",
    "ཤེས་པ་གང་རང་རིག་པ་ལ་འདིའི་འབྲས་བུར་འཇོག་པ་ཡིན་ཞེ་ན།",
    "སྣང་བ་དེ་གཉིས་ལས་གང་རང་རིག་པ་ནི་འབྲས་བུའོ།",
    "ཕྱི་དོན་གཞལ་བྱ་ལ་ཡང་རང་རིག་འབྲས་བུར་འཇོག་པའི་ཚད་འབྲས་ཀྱི་རྣམ་གཞག་རིགས་པ་ཡིན་ནོ།",
    "ཕྱི་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་སྒྲུབ།",
    "རང་རང་བློ་ཡིས་འགྲེལ་ཚུལ་མང་བྱུང་ཀྱང་།",
    "གསུངས་ཀྱང་རང་རང་རྨོངས་པས་སྒྲིབ་པ་བཞིན།",
    "བཟོ་རིག་པའི་ཞབས་ཏོག་རྒྱུ་གསེར་དངུལ་ལ་སོགས་པ་ཟས་ནོར་གྱི་ཕུང་པོ་ཆེན་པོ་དགོས་པ་འདུག་ནའང་།",
    "གནའ་རབས་ཀྱི་སྒྲུང་རྩོམ་གཞན་དག་དང་བསྡུར་ན་ཐོག་ཁང་དམར་པོའི་རྨི་ལམ་འདིའི་བརྗོད་བྱ་དོན་གྱི་གོ་རིམ་སྒྲིག་ཚུལ་གཞན་དང་མི་མཐུན་པ་འདིའི་ཐོག་ནས་རྩོམ་པ་པོའི་ལྷན་སྐྱེས་ཀྱི་སྒྱུ་རྩལ་རིག་སྟོབས་གཞན་དྲིང་མི་འཇོག་པ་ཞིག་ཡིན་པ་གསལ་བོར་མཚོན་འདུགསྒྲུང་རྩོམ་འདི་རྗོད་བྱེད་ཕུན་སུམ་ཚོགས་པས་རབ་ཏུ་བརྒྱན་པས།",
    "ཁྱེད་རང་ལ་ཐུགས་ཁོམ་ཡོད་དུས་ང་ལ་བལྟ་བར་ཕེབས་རོགས།",
    "ཁྱེད་ལམ་འདི་ནས་ཡར་ཕེབས་ན་འགྲིག་འདུག་ཅེས་འགྲོ་ལམ་བསྟན་ནོ།",
    "འདུག་ཅེས་ཟེར།",
    "ལྷ་ལྕམ་ཝང་ཧྥུ་རིན་གྱིས་དེ་ད་ལོས་ཡིན།",
    "ང་ད་རུང་ཡུད་ཙམ་ཞིག་ལ་འདུག་འདོད་ཡོད་ཅེས་ཞུས།",
