    "འཇིག་རྟེན་གྱི་སྐྱེ་བོ་གནག་རྫིའི་བར་ལ་ཡང་རང་བཞིན་མེད་པ་དང་།",
    "སྣ་ཚོགས་དངོས་རྣམས་ཀྱིས་ཕྱེ་རྒྱལ་བ་དང་བཅས་ལྷ་མི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "མ་ནིང་རང་བཞིན་ཉེ་བར་ཐོབ་པའང་དེ།",
    "བདག་ཉིད་ཞེ་སྡང་རྡོ་རྗེའི་ང་རྒྱལ་དང་ལྡན་པས་འདུག་ལ།",
    "རང་གཙོ་བོ་ལ་མར་མེ་གཅིག་ལས་གཉིས་ཆད་ཀྱི་ཚུལ་དུ་མི་བསྐྱོད་པར་བསྒོམ་ཧེ་རུ་ཀ་ཕྱག་གཉིས་པའི་རྣམ་པར་ཆད་ནས་ཤར་གྱི་ལྷ་སྣམ་གྱི་སྟེང་དུ་འདུག་སྟེ།",
    "པུ་ཁ་སྭཱ་མ་ན་སུ་ལཱ་བྷི་ནོ་བྷ་ཝན་ཏུ་སྒྲ་ནཾ་ཙ་ནིར་ཨུ་པ་དྷ་བི་ཀུརྦནྡྷ་སརྦ་བྷུ་ཏ་ཨི་ཏྟཱ་ནི་ན་ཨོཾ་ཨཱ",
    "སྟན་ལ་འདུག་ཏུ་བཅུག་ལ།",
    "བསམ་གཏན་གྱི་འདུག་སྟངས་ཀྱི་གནས་སུ་བཅུག་ལ།",
    "བདེ་བའི་སྟན་ལ་ལུས་འདུག་ལུགས་བརྒྱད་དམ་སྤྱོད་ལམ་གང་བདེར་འཁོད་ནས་རང་རྒྱུད་ལ་ལེགས་པར་བརྟགས་ཏེ།",
    "ད་ང་ཤེས་རབ་དམན་ནས་བྲམ་ཟེའི་རིག་བྱེད་སོགས་ཡོན་ཏན་གང་ཡང་མ་ལོབ་པར་དང་པོར་ཕ་མ་གཉིས་ཀྱིས་གནས་ནས་ཕྱུང་ཏེ་ཨ་ཇོ་ལམ་བརྟན་པའི་རྩར་བཏང་།",
    "རིག་བྱེད་གང་ཡང་མ་ལོབ་པར་ཨ་ཇོས་ཀྱང་གནས་ནས་བཏོན་ཏེ་གནས་སྐབས་འདི་འདྲ་ཞིག་ཏུ་༩བ་གྱུར་པའི་ཉམ་ཐག་ཚུལ་ཞུས་པར།",
    "ཡང་བཀྲུས་ནས་ཡོན་ཆབ་འབུལ་བ་སོགས་གནང་བ་ཡིན་འདུག།",
    "གཤིས་བརྒྱུད་འཇམ་ཐིང་ངེར་འགྲོ་བ་ཡིན་འདུག།",
    "དེ་ལྟ་བུའི་མཚམས་རྒྱུན་རིང་པོའི་བར་དུ་བསྡད་ཀྱང་ལུས་ལ་ན་ཟུག་སོགས་མི་སྐྱེད་པའི་བདེ་བའི་སྟན་ལ་འདུག་ལུགས་བརྒྱད་དང་།",
    "བོད་ཀྱི་སྒོམ་ཐམས་ཅད་སྒྲིལ་ཀྱང་ངའི་འདུག་ལུགས་གཅིག་བུ་མི་དོ་གསུང་བ་དེ་ཡིན།",
    "ཀ་བ་དང་ཞལ་བ་ལ་སྙེས་ནས་སྡོད་པ་སོགས་བག་མེད་པའི་འདུག་སྟངས་བྱས་ན།",
    "དེ་ལྟ་བུའི་འདུག་ལུགས་བརྒྱད་དང་ལྡན་པའི་སྒོ་ནས་ཐོག་མར་རང་རྒྱུད་ལ་ལེགས་པར་བརྟག་དགོས་པ་ཡང་།",
    "དེ་ཡང་ལུས་འདུག་ལུགས་བརྒྱད་དང་སྤྱོད་ལམ་གང་བདེར་འཁོད་ནས་རང་རྒྱུད་ལ་བརྟག་པའི་སྐབས་རིག་པ་དྭངས་སྙིགས་འབྱེད་ཚུལ་ལ།",
    "ལྷོད་བྱ་བའི་ཚིག་གསུམ་པོ་འདི་ལ་འདུས་ནས་འདུག་གསུངས།",
    "ད་ལོ་འདི་བྱས་ཁ་སང་ཡང་ཁོ་གཞན་ཞིག་དང་ལབ་གླེང་བྱེད་འདུག་པ་ང་རང་ལ་སྨོད་པ་ཡིན་སྙམ།",
    "དགེ་སློང་དག་དགེ་སློང་འདིས་ས་ཇི་ཙམ་ནོན་པའི་འོག་དཔག་ཚད་བརྒྱད་ཁྲི་བཞི་སྟོང་ན་གསེར་གྱི་ས་གཞི་ལ་ཐུག་པའི་བར་གྱི་བྱེ་མ་ཇི་སྙེད་ཡོད་པ་དེ་སྙེད་དུ་དགེ་སློང་འདིས་འཁོར་ལོས་བསྒྱུར་བའི་རྒྱལ་སྲིད་སྟོང་འགྱུར་དུ་ལོངས་སྤྱོད་པར་འགྱུར་རོ་ཞེས་༣༨ན་གསུངས་འདུག་པ།",
    "སྤྱན་སྔ་བ་རུག་པ་ན་བཞུགས་ཙ་ན།",
    "དེ་མ་ཐག་༥༡བ་སྤྱན་ས་ལ་ལྷུང་བ་ཡིན་འདུག།",
    "དེ་ཡང་རང་ཉིད་སྐུ་ཚེ་རིང་ཐུང་དང་།",
    "དགེ་སློང་ལེགས་པའི་སྐར་མ་དེས་མི་ལོ་བཅུ་གཉིས་ཙམ་སྟོན་པའི་ཞབས་དྲུང་དུ་སྡོད་པ་དེ་ཁོ་ལ་ལྟོ་གོས་ཕྱིད་སླ་བར་བསམ་ནས་སྡད་པ་ཡིན་འདུག།",
    "ཁོ་རང་ལ་ཅུང་མ་དད་པ་སོགས་བྱེད་མི་བྱུང་ན།",
    "སྟོན་པའི་ཞབས་དྲུང་དུ་ཕྱིན་ད་དུང་རྫུན་མ་ཤིག་པར་གཅེར་བུ་སྡུག་བསྔལ་འགྱུར་ཤི་ནས་སུམ་ཅུ་རྩ་གསུམ་གྱི་ལྷར་སྐྱེས་འདུག་ལགས་བྱས་པས།",
    "མེ་དོང་དུ་མཆོང་པ་སོགས་དཀའ་སྤྱད་བསམ་གྱིས་མི་ཁྱབ་པར་མཛད་དགོས་བྱུང་འདུག་ན།",
    "འོ་དེ་ཡག་ཁྱེད་རང་དེ་ག་རང་བྱས་པ་དགའ་གསུངས།",
    "མི་ཡོང་བ་ལ་ཁ་འཆམ་འདུག་ཟེར་བ་བྱུང་།",
    "དཔེར་ན་ཞིང་པ་རྣམས་ཞིང་ལས་ས་བོན་འདེབས་པའི་ཚེ་འབྲུ་གྲངས་མེད་ལ་གཏོར་ཡང་རང་ལ་གྱོང་བཀལ་ནས་ཞིང་དེ་ལ་བཀའ་དྲིན་༦༦བ་བསྐྱངས་པའི་འདུ་ཤེས་ག་ལ་སྐྱེ།",
    "དོན་དང་ཐུན་པ་དགའ་རབ་བྱུང་འདུག་ན།",
    "དམིགས་པའི་གྲངས་དང་གོ་རིམ་ནོར་བ་དང་དགེ་སྦྱོར་ལ་ཐང་ལྷོད་ཤོར་བ་སོགས་བྱུང་འདུག་ན།",
    "ཕར་ཙམ་ཚུར་ཙམ་བྱེད་དགོས་སོགས་ཅི་དྲག་ལ་གྱར་བ་བྱུང་།",
    "འདུག་ནས་སྒྲིབ་པ་ལྔ་ལས་སེམས་ཡོངས་སུ་སྦྱངས་པའི་དོན་ལྡན་དུ་བྱ་དགོས་པ་དང་།",
    "དྲན་པ་ཡང་རང་ག་བ་མ་ཡིན་པར།",
    "ནམ་ཕྱེད་ཙ་ན་གཉིད་ལ་ཧར་སད་ཡོང་།",
    "ལྷག་པར་རྒྱུན་ཆགས་གསུམ་པ་འདོན་པ་འདི་འགྲོ་འདུག་སྤྱོད་ལམ་གྱི་སྐབས་ཐམས་ཅད་དུ་མ་ཆག་པ་དགོས།",
    "བདེ་བའི་སྟན་ལ་ལུས་འདུག་ལུགས་བརྒྱད་དང་སྤྱོད་ལམ་གང་བདེར་འཁོད་ནས་རང་རྒྱུད་ལ་ལེགས་པར་བརྟགས་ཏེ་དགེ་སེམས་ཁྱད་པར་ཅན་གྱི་ངང་ནས་སྐྱབས་ཡུལ་གསལ་བཏབ་ཏེ།",
    "དེ་ལ་ཡིད་ཆེས་ཙ་ན།",
    "བསམ་བློ་གཏོང་ལོང་བྱུང་ཨེ་འདུག།",
    "དེ་ལྟར་རྙེད་པ་དེ་ཡང་རང་ག་བ་མ་ཡིན་པར་དོན་ཆེན་པོ་ཡིན་པར་བསམ་དགོས།",
    "དབྱར་གྱི་དུས་ནམ་མཁའི་མཐོངས་འདི་ལ་ཕུར་ནས་འགྲོ་བའི་སྲོག་ཆགས་སྦྲང་བུ་འདི་འདྲ་འདུག།",
    "དེ་ཡིན་ན་དེ་ཡིན་པ་རྒྱན་ལ་སོགས་པའི་༩༣བ་བྱམས་མགོན་གྱི་གཞུང་གང་ནས་ཀྱང་མ་གསུངས་པ་འདུག་པ་སྙམ་པ།",
    "དེ་རིང་རང་ཡང་འཆི་ཉེན་ཡོད་པས་ངེས་པར་འཆི་གྲབས་ཞིག་བྱ་དགོས་པར་འདུག།",
    "དེ་རིང་རང་ཤི་འགྲོ་བསམ་པ་འདི་རང་རྒྱུན་དུ་དགོས།",
    "དེའི་ཚེ་དྲང་སྲོང་རང་ཉིད་འཆི་བར་ཤེས་ཏེ་ཡིད་སྐྱོ་ཏེ་མིག་ནས་མཆི་མ་བཏང་བས།",
    "འདི་འདྲ་ཞིག་འདུག་ཨང་བསམ་པ་མ་གཏོགས།",
    "ད་དེ་རིང་རང་ཤི་མི་འགྲོ་བའི་ཆ་ཅི་ཡོད།",
    "རང་རྒྱུད་ལ་བསྐོར་ཏེ་བལྟས་པས་སྡོམ་པ་གསུམ་གྱི་བཅད་མཚམས་རྣམ་པར་དག་པ་བསྲུང་འདུག་ན་བདེ་༡༤བ་འགྲོར་སྐྱེ་མི་སྐྱེད་ལུང་བསྟན་ཞུ་མི་དགོས།",
    "གནས་འདི་དག་ཡོད་ཚུལ་ཁྱེད་རང་མཚན་ཉིད་པ་སོགས་ལ་དོགས་པ་ཆེན་པོ་ཡོད།",
    "དེ་གཉིས་ཐད་ཀ་ཐད་ཀ་ན་ཡོད་བྱས་ཙ་ན།",
    "དེས་ངེད་རྣམས་ལ་གཏད་པས་ངེད་རྣམས་འབྲོམ་རྒས་པོའི་བུ་ཡིན་བྱས་པས་འོ་ན་ཐུགས་བདེན་པར་འདུག་ཟེར།",
    "ད་འདི་ནང་དུ་མཎྜལ་གཏན་ནས་མི་འདུག་གོ་སྙམ་བློ་ཐག་རྦད་དེ་ཆོད་པ་དང་འདྲ།",
    "དེས་ན་འདི་ལྟ་བུའི་ངན་འགྲོའི་སྡུག་བསྔལ་བཟོད་གླགས་མི་འདུག་པས།",
    "དུས་ཚོད་འདི་འདྲ་ཞིག་ལ་བགེགས་ཆགས་འདི་འདྲ་འདུག་པས།",
    "དེའི་ནང་ནས་ཀྱང་རང་གཞན་གྱི་བྱ་བ་གང་འདྲ་ཞིག་བསྒྲུབས་ཀྱང་།",
    "དེའི་ཐད་དུ་ཕྱི་རོལ་པའི་རྟོག་གེ་པ་ཞིག་འདུག་པ་ལོག་༡༢༢ན་ལྟ་སྐྱེས་ནས་ཡིད་མ་ཆེས་པར།",
    "ཉི་མ་དྲོ་པོ་འདུག་ཟེར་བ་དང་།",
    "ཟླ་བ་དཀར་པོ་འདུག་ཟེར་བའི་ཡ་མ་ཆ་ཕན་གནོད་གང་ཡང་མེད་པ་ཞིག་བཤོད་པ་ལས།",
    "བདེ་སྡུག་ཇི་ལྟར་མྱོང་སོགས་ཚེ་ཕྱི་མ་འདི་རང་གལ་ཤིན་ཏུ་ཆེ་བ་འདུག་སྙམ་དུ་ཡིད་འགྱུར་བས།",
    "བདེ་བའི་སྐབས་སྐད་ཅིག་ཀྱང་མི་འདུག་སྟེ།"
  ]
}