    "སོག་རྒྱལ་སྟོབས་ལྡན་ཆི་གི་སིའི་དམག་དཔུང་བོད་དུ་བྱོན་ནས་སྟོད་མངའ་གཚོམ་བུ།",
    "དེའི་རྗེས་ཆིང་གི་སིའི་ཚ་བོ་གུ་ཡུག་དང་གུ་ཏན་གཉིས་ཀྱིས་ལང་ཀྲུའུ་སོགས་ཁམས་ཀྱི་རྒྱལ་པོ་བྱེད་སྐབས།",
    "དེའི་རྗེས་ཤི་རེ་ཐུ་གུ་ཤྲིས་ཡུམ་གསུམ་བོད་ཡིག་ལས་སོག་སྐད་དུ་བསྒྱུར་བ་དང་།",
    "ཀུ་ལེ་མུའི་འཇར་མན་སྐད་ཀྱི་བརྡ་སྤྲོད་རིག་པ་ལས་རིར་མན་སྐད་ནི་རྒྱ་གར་དང་ཏ་ཟིག་གི་སྐད་དང་མཚུངས་ཤིང་།",
    "འདིས་ཀྱང་གནའ་རབས་ཧིན་ཡོ་སྐད་ནི་ཆེས་སྔ་མོ་ནས་ཡ་གླིང་དང་ཡོ་རོབ་གླིང་གི་ཡན་ལག་གགཉིས་སུ་གྱེས་པ་གསལ་པོར་བསྟན་ཡོད།",
    "ནང་གསེས་ཡ་གླིང་སྐད་ནི་སཾསྐྲྀཏའི་སྐད་དང་པར་སིག་གི་སྐད་གཙོ་བོ་ཡིན་ཞིང་རྩ་བའི་དབྱངས་གསུམ་དུ་ངེས་པ་དང་།",
    "ཡོ་རོབ་གླིང་གི་སྐད་ལ་དེ་ལས་གཞན་ད་དུང་དབྱངས་ཞེས་པ་ཞིག་ཀྱང་སྣང་བས།",
    "དེ་དག་གི་ཐོན་སྐྱེད་ཀྱི་བྱ་འགུལ་སྣ་ཚོགས་དང་།",
    "ང་ཚོས་ཞིབ་འཇུག་གི་ཁྲོད་དུ་དེ་དག་དཀྱུས་གཅིག་ཏུ་འབྲེལ་ཞིང་ཕན་ཚུན་གཞོགས་འདེགས་ཀྱིས་ར་འཕྲོད་པར་བྱས་ན་ཆེས་ལེགས་པར་སྙམ།",
    "ང་ཚོས་ཤེས་ཤིང་རྟོགས་པའི་བྱ་དངོས་ཐམས་ཅད་དང་།",
    "མིར་འཕྲད་ཐེངས་རེ་རེ་ལ་བརྡ་དོན་སྤྲོད་སྐབས་ཐོག་མར་ཁྲེས་པོའི་ནང་གི་ཡོ་ཆས་རེ་རེ་བཞིན་བླངས་ནས་གོ་བརྡ་སྤྲད་པས།",
    "དུས་ཚོད་གཅིག་གི་རིང་ལའང་བརྡ་དོན་ཕྲན་ཙམ་ལས་སྤྲོད་མ་ཐུབ་ཅེས་བྲིས་ཡོད།",
    "སྒྲ་སྤྱི་དང་དོན་སྤྱི་འཛིན་པའི་གནས་ལུགས་ཟབ་མོའམ་དགོངས་དོན་སྤྱི་མཚན་པའང་མཚོན་ནུས་ལ།",
    "བོད་སྐད་དུ་གདངས་དྲག་ཞན་རན་པས་མ་ནིང་གི་ཡི་གེར་བཞག་པ་ལྟ་བུ་སོ་སོར་ཁྱད་པར་ཆེན་པོ་ལྡན་པས།",
    "ཨ་མེ་རི་ཁའི་འགྲོ་བ་མིའི་རིག་པ་བ་ཨིན་པེ་དང་ཨིན་པེ་གཉིས་ཀྱིས་ཀྱང་།",
    "སྤྱིར་ང་ཚོའི་འབྲེལ་འདྲིས་བྱེད་ཐབས་ལ་ཁ་སྐད་ལས་གཞན་ལུས་ཉམས་དང་།",
    "རོལ་མོའི་དབྱངས་རྟ།",
    "ལམ་རྟགས་སོགས་སྣ་ཚོགས་སུ་སྣང་ན་ཡང་བརྡ་འཕྲིན་སྤེལ་རེས་ཀྱི་ཁྲོད་དུ་སྐད་བརྡ་ལས་ལྷག་པའི་གལ་ཆེ་བ་ཞིག་ར་དཔྱད་པ་གསར་བཞད་མེ་ཏོག་ཚོམ་བུ།",
    "སྐད་བརྡས་རྣམ་པ་སྣ་ཚོགས་པའི་རྣམ་འགྱུར་དང་བློ་མོས་མི་མཚུངས་བ་མཚོན་ནུས་པ་མ་ཟད།",
    "རིགས་རིང་ལུགས་པ་རྣམས་ཀྱིས་ཀྱང་དབྱིན་ཇིའི་མྱུར་བགྲོད་གཞུང་འལམ་སྟེང་གི་དབྱིན་ཡིག་གི་ལམ་རྟགས་སྣ་ཚོགས་གསུབ་བཅོས་བྱས་ཏེ།",
    "ཁག་གཅིག་གིས་དེང་རབས་ཐུར་ཁེའི་སྐད་བརྡའི་ཁྲོད་དུ་ཕྱོགས་ཡོངས་ནས་ཁས་ལེན་ཐོབ་ཅིང་རརང་སྐད་ལ་གཞི་ནས་གྲུབ་པའི་མིང་བརྡ་རྣམས་ཁྱབ་ཆེ་བར་བཀོལ་བ་དང་།",
    "ཁད་མོར་གྱི་ཐུར་ཁེའི་སྐད་བརྡ་ལྷན་ཚོགས་དང་འགྲན་འཛུགས་པའི་བླང་བྱ་ནན་མོ་བཏོན།",
    "ཐུན་མོང་གི་སྡོད་གནས་ས་ཁོངས་དང་མེ་ཏོག་ཚོམ་བུ།",
    "སྐད་བརྡ་དེ་ཡང་མི་རིགས་ཡོངས་ཀྱི་མི་སྣ་རེ་རེར་འབྲེལ་བ་ཡོད་ཅིང་།",
    "བོད་སྐད་ཀྱིས་ཡོད་ཚད་ཨ་ཁུ་དང་།",
    "བུ་མོ་སྟོན་བྱེད་ཀྱི་མིང་དེ་རྟ་ཡོད་པའི་མི་རུ་བསྒྱུར་ཆོག་ལ།",
    "ཧ་སག་རིགས་ཀྱིས་ཡུན་རིང་བོར་སྒོ་ཕྱུགས་འཚོ་སྐྱོང་གི་འཚོ་བ་ལ་འབྲེལ་ནས་བྱུང་།",
    "ཁ་སྐད་ཁྲོད་དུ་མིང་བརྡ་སྦྱོར་སྐབས་མི་ལ་མེད་སོང་ངམ་འཇའ་སོང་ཟེར་བ་ལས་ཕྱུགས་ཟོག་དང་དབྱེར་མེད་ཀྱིས་ཤི་སོང་ཟེར་སྲོལ་མེད་ལ།",
    "ཤི་ཞེས་པ་འཛེམ་བྱའི་བརྡ་དོན་དུ་བརྩིས་ནས་སྤྱིར་བཏང་གིས་བརྗོད་པར་མི་བྱེད།",
    "སྐད་བརྡ་ནི་འདས་ཟིན་པའི་མི་རིགས་ཀྱི་གནས་ཚུལ་སྣ་ཚོགས་ལ་ཞིབ་འཇུག་བྱེད་པའི་ཁུངས་ལུང་གལ་ཆེན་ཞིག་ཀྱང་རེད།",
    "བུད་ཤིང་གཅོད་པ།",
    "ཞིང་རེངས་ལ་ས་རྒོད་ལ་སོན་འདེབས་བྱེད་བཞིན་པའི་ས་ཞིང་ལ་ཞེས་ཟེར་ལ།",
    "ཡང་དཔེར་ན་ཡུན་ནན་ལིས་ཅང་ས་ཆའི་འཇང་རིགས་སྐད་ལས་ཁྱོ་ཤུག་ཅེས་པའི་མིང་བརྡ་ལ་ཞེས་བརྗོད་པ་བོད་སྐད་དུ་ཐད་སྒྱུར་བྱས་ན་ཆུང་མ་ཁྱོ་བོ་ཞེས་པའི་དོན་དུ་སྣང་བ་དང་།",
    "དཔེར་ན་ཡིའུ་ཐའེ་བ་ནི་གནའ་བོའི་དུས་ནས་རང་གི་རྒྱལ་ཁབ་ཉམས་དམུས་སུ་གྱུར་པར་བརྟེན་འཛམ་གླིང་གི་ས་གནས་མང་པོར་ཁྱབ་ཡོད།",
    "ཡུན་ནན་ཏེ་ཧུང་གི་ཏའེ་རིགས་དང་ཞི་ཧྲོང་པན་ནའི་ཏའེ་རིགས་ལ་མཚོན་ན།",
    "མི་རིགས་དང་སྐད་བརྡའི་འབྲེལ་བ་ནི་རྙོག་འཛིང་དང་འགལ་ཟླ་ཧེ་བག་ཙམ་ཡང་མེད་པར་ཕན་ཚུན་དོ་མཉམ་ཞིང་གཅིག་ལ་གཅིག་རྐྱང་གི་སྣང་ཚུལ་ཞིག་མ་ཡིན།",
    "མི་རིགས་གཅིག་གིས་སྐད་རིགས་གཉིས་སམ་དུ་མ་བཀོལ་བའི་སྣང་ཚུལ་ཡང་མི་ཉུང་བར་སྣང་།",
    "འཕེལ་འགྱུར་ལ་ཤུགས་རྐྱེན་བཟོ་བའི་རྒྱུ་རྐྱེན་མི་མཚུངས་པ་རེ་སྣང་བ་ཤུགས་ཀྱིས་བསྟན་ཡོད།",
    "དེ་ལྟ་ནའང་མི་རྣམས་ཀྱིས་མིའི་རིགས་ཀྱི་ཚོགས་པ་ཞིག་མི་རིགས་ཤིག་གི་གནས་སུ་གདེང་འཇོག་བྱེད་སྐབས།",
    "ནམ་རྒྱུན་ཁོ་ཚོ་ཐུན་མོང་ལ་མངའ་བའི་སྐད་བརྡ་ཚད་གཞི་ཞིག་ཏུ་རྩི་བར་བྱེད་ཅིང་།",
    "དཔེར་ན་རང་རྒྱལ་གྱི་ཡའོ་རིགས་ཁག་གཅིག་གིས་ཡའོ་སྐད་དང་ཁག་ཅིག་གིས་མིའོ་སྐད་རྗོད་བཞིན་ཡོད་རྒྱལ།",
    "ཁག་གཅིག་གིས་ཀྲོང་ཏུང་སྐད་རིགས་སུ་གཏོགས་པའི་ལ་ཅ་སྐད་རྗོད་བཞིན་ཡོད་ལ།",
    "འཚོ་བའི་གོམས་སྲོལ་སོགས་གཅིག་མཚུངས་ཡིན་ན་ཡང་སྐད་བརྡའི་ཐད་ནས་སྐོར་ཁག་གཉིས་སུ་གྱེས་ཏེ་ཁག་གཅིག་གིས་ཅིང་ཕོ་སྐད་རྗོད་བཞིན་ཡོད་པ་དང་།",
    "ཁག་གཅིག་གིས་དེ་ཝ་སྐད་རྗོད་བཞིན་ཡོད་ལ།",
    "ཁོ་ཚོ་ལས་ཕལ་ཆེ་བ་པར་སིག་དང་ཨ་རབ་ནས་མཆེད་འོང་བས་པར་སིག་གི་སྐད་དང་ཨ་རབ་ཀྱི་སྐད་རྗོད་པ་ཤས་ཆེ།",
    "ཡིན་ན་ཡང་སི་ཕེན་སྐད་ནི་དུས་རབས་བཅུ་དྲུག་པའི་སི་ཕེན་བཙན་འཛུལ་པས་མོ་ཞི་ཁོར་སྤེལ་ཞིང་།",
    "ཡུལ་སྲོལ་གོམས་གཤིས་དང་རྒྱན་གོས་ཆ་ལུགས་དང་བཅས་པ་ཡུལ་དུས་ངེས་ཅན་ཞིག་གི་ནང་དུ་སྒྱུར་བཅོས་དང་བརྗེ་སྤོར་བྱེད་མི་རུང་བ་མེད་ཀྱང་།",
    "མི་རིགས་ཤིག་གིས་ནམ་ཡང་འདོར་མི་རུང་བ་ནི་སྐད་ཆ་ཡིན་ཏེ།",
    "ཕྱོགས་ངེས་ཅན་ཞིག་གི་ཆ་ནས་སྐད་ཆ་ནི་མི་དང་མི་རིགས་ཀྱི་མཚོན་བྱེད་གལ་ཆེན་ཞིག་ཏུ་གྲུབ་ཕྱིར།",
    "སྐད་ཆ་ནི་མི་རིགས་ཤིག་གི་བླ་སྲོག་དང་།",
    "མི་རྣམས་ཀྱིས་སྐད་ཆ་ལ་བརྟེན་ནས་བསམ་བློ་བརྗེ་རེས་དང་།",
    "སྐད་ཆའི་བྱུང་ལུགས་དང་གིས་མི་རིགས་ཀྱི་གྲུབ་ཚུལ་གཉིས་ཐ་དད་དུ་ཕྱེ་མི་རུང་ཞིང་།",
    "ཧྥ་རན་སེའི་སྐད་ཀྱི་ཞེས་པ་དུས་རབས་བཅོ་བརྒྱད་པའི་ནང་དུ་འབྱོར་བ་ལྡན་པའི་ལྕམ་མོ་རྣམས་ཀྱི་རྒྱན་ཆ་འཇོག་སའི་སྒམ་དུ་བྱེད་པ་དང་།",
    "དབྱིན་ཡིག་གི་ཞེས་པའི་ཐ་སྙད་འདི་ཡང་ཐོག་མར་ལ་ལ་ཏིང་གི་སྐད་ལས་ཕྱུང་དུས་བྱ་སྒྲོའི་དོན་ཁོ་ན་མ་གཏོགས་མེད་ཀྱང་།",
    "བོད་སྐད་ཀྱི་གཙང་བོ་ཞེས་པ་གདོད་མའི་དུས་སུ་ཡར་ཀླུང་གི་ཡུལ་དུ་གནས་པའི་ཆུ་བོ་བྱེ་བྲག་པ་དེ་རང་གི་མིང་དུ་བྱེད་པ་ལ།",
    "རུ་ཞེས་པའང་ཐོག་མར་དམག་གི་དོན་དུ་སྤྱོད་ཀྱང་།",
    "མིང་གི་འཕེལ་གྲུབ་ཀྱི་ཆ་ནས་བལྟས་ན་དེ་བས་ཀྱང་གསལ་བོ་ཡིན་ཏེ།",
    "འདི་དུས་ཁྲི་ངོར་སྣང་བཙུན་མོང་གི་བུས།",
    "ཐོན་སྐྱེད་ལས་སྒོ་ཇེ་ཞིབ་དང་ཁྱད་པར་དུ་ཚོང་ཟོང་བརྗེ་རེས་བྱེད་པའི་སྲོལ་བྱུང་བ་དང་བསྟུན།",
    "འཇལ་གཤོར་གྱི་དངོས་པོ་དག་གི་མིང་རྣམས་རིམ་གྱིས་འཇལ་བྱེད་ཀྱི་ཚད་སྟོན་པའི་མིང་དུ་འགྱུར་བ་ཡིན་ཏེ།",
    "རྒྱ་ཡིག་གི་འཇལ་བྱེད་ཀྱི་མིང་ནི་ཆིན་སྔོན་མའི་དུས་སུ་ཐོག་མར་བྱུང་ཞིང་།",
    "དེ་ཡང་འདོད་རྒྱལ་དང་ལད་ཟློས་གང་རུང་གིས་བཏགས་པ་ཡིན་ལ།",
    "གློག་ཅེས་པ་གཞི་བྱས་ཏེ་གློག་བརྙན་དང་གློག་ཆས་ལ་སོགས་པ་བྱུང་བ་ད་ལྟའི་མི་རྣམས་ལ་དངོས་པོ་དེ་རིགས་མིག་མཐོང་ལག་ཟིན་དུ་གྱུར་པས་ཡིད་ལ་མི་འཆུན་པལ་མེད་མོད།",
    "ཡོ་རོབ་གླིང་དུ་ཕུ་ནུ་ཆེ་ཆུང་གི་ལོ་གྲངས་དང་ཕ་སྤུན་སྣག་མཚམས་ཀྱི་ཁྱད་པར་ལ་དེ་འདྲ་ནན་ཏན་མི་བྱེད་པ་དང་།",
    "བོད་དུའང་ཕོ་མཆོག་མོ་དམན་དང་གཉེན་ཚན་ཕྱི་ནང་གི་དབྱེ་བ་གཙིགས་སུ་མི་འཛིན་པའི་རྐྱེན་གྱིས།",
    "ད་ལྟའི་ཉི་སྐད་ཀྱི་ནང་དུ་རྒྱ་ཡིག་གི་གཡར་མིང་གིས་༤༧ ༥དང་།",
    "དེ་དག་གིས་ཉི་སྐད་ཀྱི་སྦྱོར་རིམ་དང་བརྡ་སྤྲོད་ཀྱི་ཆ་ལ་འགྱུར་བ་མེད་པ་ནི།",
    "ཅ་ལག་ཅིག་ཡིན་ན་དེ་ལ་བཟོ་བཅོས་མ་བྱས་ཀྱང་ཆོག་མོད།",
    "ཚིག་གི་སྦྱོར་བ་དང་བརྡ་སྤྲོད་ཀྱི་ཆ་ལ་འགྱུར་བ་ཅུང་ཟད་ཀྱང་མེད་པ་གནའ་དེང་གི་བསྟན་བཅོས་དག་གཤིབ་བསྡུར་བྱས་པས་བདེ་བླག་ཏུ་རྟོགས་ཤིང་།",
    "ཤིང་སྡོང་ལ་གཅད་བྱ་ཞེས་བཏགས་པ་ནི་གཅད་གཅོད་བཅད་སོགས་ཀྱི་བྱ་བ་ལ་བལྟས་ནས་བཞག་གི་བྱ་བ་མེད་ན་ཤིང་སྡོང་གཅད་བྱ་ཡིན་པ་གང་གིས་ཤེས།",
    "ཤིང་བཟོས་སྟ་རེས་ཤིང་གཅོད་པའི་དུས་ན་རང་ཉིད་གཅོད་པ་པོ་དང་སྟ་རེ་གཅོད་བྱེད་དུ་གྲུབ་ཀྱང་།",
    "རྒྱ་སྐད་ལ་བརྗོད་གཞིའི་རྗེས་སུ་གསལ་བྱེད་ཀྱི་སྒྲ་ལྟ་བུར་རང་གི་འདོད་བློ་གཞན་ལ་བཙན་གྱིས་འགེལ་བའི་བཟོ་ལྟ་མངོན་ཞིང་།",
    "བོད་སྐད་ལ་བརྗོད་གཞིའི་སྒྲ་ཚིག་གི་ཡ་མཐའ་ན་སྣང་བ་དང་།",
    "དེ་ལ་ད་དུང་བྱ་བ་བྱེད་སའི་ཡུལ་ཏེ་འབྲེལ་ཡུལ་ཡོད་ན་དེ་ཡང་ལ་དོན་སོགས་ཚིག་ཕྲད་དག་གིས་མཚོན་པ།",
    "བོད་སྐད་ལ་ཚིག་མཐའི་བྱ་བ་བརྗོད་པའི་སྒྲ་ལ་མ་ཐུག་བར་དུ་རྗེས་འབྲས་གསལ་བར་མི་ཤེས་པས་ཕྱིར་འཐེན་པའི་ངང་ཚུལ་གསལ་བའང་མི་རིགས་རང་རང་གི་བསམ་བློ་གཏོང་ཕྱོགས་དང་དམ་དུ་འབྲེལ་ཕྱིར།",
    "མི་རིགས་ཤིག་གི་སྐད་ཆ་ནི་མི་རིགས་དེའི་བསམ་བློ་མཚོན་བྱེད་དུ་གྲུབ་པས།",
    "སྤྱི་མཐུན་གྱི་སྐད་ཆ་དང་དེ་ལ་བརྟེན་པའི་ཐུན་མོང་གི་བསམ་བློའི་འདུ་ཤེས་གཉིས་ནི་ནམ།",
    "ཐུན་མོང་གིས་གོ་བའི་སྐད་ཆའི་སྦྱོར་བ་ལ་མ་བརྟེན་ན།",
    "སྐད་ཆ་དང་ཡུལ་སྲོལ་གོམས་གཤིས་སྔར་ལྟར་གནས་པ་འཇང་དང་བྷོད་མི་ཞེས་པའི་མི་རིགས་དག་གི་སྟེང་ནས་གསལ་བར་རྟོགས་སོ།",
    "སྐད་ཆ་ནི་མི་རིགས་ཤིག་གི་ཁྱིམ་རྒྱུད་ནོར་བུ་དང་བསམ་བློའི་རྟེན་གཞི་འབའ་ཞིག་ཏུ་སྣང་བའི་ཕྱིར་རོ།",
    "མི་རིགས་གང་གི་ཡུལ་སྲོལ་གོམས་གཤིས་ལ་སྣང་བ་ཐམས་ཅད་སྐད་ཆ་ན་གསལ་ཡང་སྐད་ཆའི་སྦྱོར་བ་ལ་ཡོད་པས་མ་ཁྱབ་ཀྱང་།",
    "མིང་གི་འཕེལ་གྲུབ་སོགས་ལའང་དམངས་ཀྱི་འཚོ་བའི་གོམས་གཤིས་ངང་ངམ་ཤུགས་ཀྱིས་ཐོན་པ་གདོན་མི་ཟ་ན།",
    "གཅིགརྗེས་འཇུག་གི་སྦྱོར་བ་ནི་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་དང་མཚུངས་པ།",
    "མིང་གི་ཁོང་ནས་ཚིག་ཕྱུང་ནས།",
    "ཚིག་གིས་དོན་རྣམས་སྟོན་པ་བྱེད།",
    "ཕོ་ནི་ཕོ་དང་མོ་ལ་འཇུག།",
    "མོ་ནི་མོ་དང་མ་ནིང་ལ།",
