    "དགའ་མགུར་སྤྱོད་པར་བྱེད་དོ།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་པ་ལས་བུ་ཕོ་ཡང་མེད།",
    "དེས་སྐབས་དེ་དེ་རྣམས་ལ་རྒྱས་པར་སྨྲས་པ་དང་།",
    "གསུམ་པོ་དེ་དག་གང་ཞེན་ཕ་དང་མ་དག་ཆགས་པར་གྱུར་ཅིང་འདུས་པ་དང་།",
    "སྐྱེས་པ་ཆགས་པར་གྱུར་པ་ཤེས་ཤིང་ཆགས་པ་དང་བྲལ་བ་ཤེས་པ་དང་།",
    "ཁོ་བོ་དང་མཐུན་པར་སྐྱེ་ཞིང་མི་མཐུན་པར་མི་སྐྱེ་བ་དང་།",
    "ཁོ་བོའི་རིགས་རྒྱུད་ཡུན་རིང་དུ་གནས་པར་སྒྲུབ་པ་དང་།",
    "ཅེས་ཆེད་དུ་བརྗོད་པ་ཆེད་དུ་རྗོད་པར་བྱེད་དོ།",
    "དེས་སྒྲ་ཡིད་དུ་མི་འོང་བ་ཅུང་ཟད་ཀྱང་མི་ཐོས་པར་ཉམ་བག་ཏུ་བཞག་གོ།",
    "དེའི་ཕྱིར་ཉི་མ་བདུན་གསུམ་ཉི་ཤུ་གཅིག་ཏུ་བཙས་པའི་བཙས་སྟོན་རྒྱ་ཆེར་བྱས་ནས་ཁྱེའུའི་མིང་ཅིར་གདགས་ཞེས་མིང་འདོགས་པར་བྱེད་པ་ན།",
    "ཁྱེའུ་འདི་རྒྱལ་པོ་ནོར་ཅན་གྱི་སྲས་ལགས་པས་ཁྱེའུའི་མིང་ནོར་བཟངས་སུ་གདགས་སོ་ཞེས་དེའི་མིང་ནོར་བཟངས་ཞེས་བྱ་བར་གཏགས་སོ།",
    "བརྟག་པར་བརྒྱད་དང་དབྱེ་བ་དང་བཀླག་པ་ལ་མཁས་པ་དང་།",
    "དགའ་བར་བྱེད་དགའ་མགུར་སྤྱོད་པར་བྱེད་དོ།",
    "ངུར་པས་མཛེས་པ་དེ་མཐོང་ནས་དེ་བསྟི་གནས་དེར་འཁྱམ་པར་བརྩམས་པ་ལས།",
    "ལེགས་ལྡན་མཐོང་ལགས་སོ།",
    "འདི་ནི་ཚངས་པར་འདུ་བའི་རྫིང་ཞེས་བྱ་སྟེ།",
    "འཛིན་པ་ལེགས་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "ནུ་མ་གསེར་གྱི་བུམ་པར་དང་རུ་སྦལ་ལྟར་རྒྱས་ཞིང་རློ་བ་དང་།",
    "མཁྲང་ཞིང་མཁྲེགས་པས་ཤིན་ཏུ་ལེག་སཔར་ཟླུམ་པ་ལྡེམ་པ་དང་།",
    "ཀླུང་ཚུ་རླབས་དང་བཅས་པའི་ཆུ་སྲིན་ལྟ་བུར་རྟོགས་པར་དཀའ་བ།",
    "ཕྲད་པར་འདོད་པས་ཤིན་ཏུ་དབྱུང་མི་བཟོད་པའི་སྒྲ་འབྱིན་པ།",
    "དགའ་མགུར་སྤྱོད་པར་བྱེད་དེ་ཡིད་འཕྲོག་མའི་གཟུགས་དང་ན་ཚོད་དང་བསྙེན་བཀུར་བརྒྱ་ཕྲག་དུ་མའི་ཡོན་ཏན་གྱིས་གཞོན་ནུ་ནོར་བཟངས་ཀྱི་སེམས་ཇི་ལྟར་དེ་དང་སྐད་ཅིག་ཀྱང་འབྲལ་མི་ཕོང་པ་དེ་ལྟར་ཕྲོགས་སོ།",
    "རྣམ་པར་བཅོམ་སྟེ་ཕམ་པར་བྱས་ནས་སླར་ལོག་གོ།",
    "རྣམ་པར་བཅོམ་སྟེ་ཕམ་པར་བྱས་ནས་སླར་ལྷགས་སོ་།",
    "ལྷ་དེ་ལྟ་བུས་ན་དེ་བབ་པར་རྔོ་མི་ཐོག་གོ།",
    "གཞོན་ནུ་ནོར་བཟངས་འདི་ནི་དར་ལ་བབ་ཅིང་མཐུ་རྩལ་སྙེམས་པ་དང་ལྡན་པ་ལགས་པས་དམག་འདི་རྣམས་དང་ལྷན་ཅིག་དགྱེར་གསོལ།",
    "དེ་ནས་ཡང་རྒྱལ་པོས་བསྒོ་བ་དང་ཡང་མཐོང་མ་ཐག་ཏུ་ཐམས་ཅད་བརྗེད་པར་གྱུར་ཏོ།",
    "དཔུང་བུ་ཆུང་ཕུན་སུམ་ཚོགས་པ་འཚོག་ཆས་གོ་མཚོན་རྣམ་པ་དུ་མ་དང་ལྡན་པ་དག་སྟ་གོན་བྱས་སོ་།",
    "གཞོན་ནུ་ཐོགས་པར་འགྱུར་གྱིས་མ་ལྟ་ཤིག།",
    "ཡུམ་བདག་རི་འོར་བ་རྣམས་འབེབས་སུ་མཆི་ལགས་ཀྱིས།",
    "དེ་ལམ་དེ་ནས་ཆས་པ་ན་ནམ་མཁའི་ལམ་ལ་ཐོགས་པར་གྱུར་ནས་དེ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "འདིའི་གྲོགས་བྱས་ཏེ་རི་འོར་བ་འདི་རྣམས་སྲོག་ཆགས་འགའ་ཡང་གནོད་པ་མི་འགྱུར་བར་དབབ་བོ་སྙམ་དུ་བསམས་ནས།",
    "དགྲ་སྟ་ལ་སོགས་ཏེ་མཚོན་ཆའི་ཁྱད་པར་རྣམ་པ་སྣ་ཚོགས་དང་།",
    "གལ་ཏེ་མྱུར་དུ་མ་ཕྱེ་ན་ཐམས་ཅད་རྨེག་མེད་པར་འགྱུར་རོ།",
    "ལྷ་རྨི་ལམ་དེ་ལྟ་བུ་མཐོང་བ་ནི་གདོན་མི་ཟ་བར་གཞོན་ནུས་རི་འོར་བ་རྣམས་ཕམ་པར་བྱས་ཀྱིས་ལོག་པ་ཞིག་ཏུ་བསྟན་པར་བྱའོ་སྙམ་ནས་སྨྲས་པ།",
    "སྐུ་ཚེའི་བར་ཆད་དུ་འགྱུར་ལགས་སོ།",
    "གཅིག་ལས་ཞུགས་ནས་གཉིས་པ་ལ་འཛེག་པར་བགྱིའོ།",
    "གཉིས་པ་ལས་ཞུགས་ནས་གསུམ་པ་ལ་འཛེག་། པར་བགྱིའོ།",
    "གསུམ་པ་ལས་ཞུགས་ནས་བཞི་པ་ལ་འཛེག་པར་བགྱིའོ།",
    "ལྷ་ཡིད་འཕྲོག་མ་འདི་མི་མ་ལགས་པ་མ་ལགས་སམ།",
    "ཡིད་འཕྲོག་འདི་ནི་དགུམ་པར་མཛོད།",
    "ད་ནི་བདག་ཅག་དང་གཞོན་ནུ་ནོར་བཟངས་སུ་ཡོངས་སུ་དགའ་མགུར་སྤྱོད་པར་འགྱུར་རོ་ཞེས་དེ་རྣམས་རབ་ཏུ་དགའ་བར་བྱེད་པ་དེ་དག་ཡིད་འཕྲོག་མས་མཐོང་ནས་དྲིས་པ།",
    "ཁྱེད་ཅག་ཅིའི་ཕྱིར་ལྷག་པར་དགའ།",
    "དེས་བརྟགས་ན་ཡང་བདེན་པར་མཐོང་ནས།",
    "ལྷ་ད་ནི་དོན་གྲུབ་སྟེ་དངོས་སྡིག་དང་བྲལ་ལགས་སོ།",
    "སྐྱེས་བུ་སྲིན་པོ་སེར་སྐྱའི་གཟུགས་ཅན་དག་ཀྱང་གཞོམ་པར་བགྱིའོ།",
    "དེ་ནི་ཞོ་སས་གཞོམ་པར་བགྱིའོ།",
    "མདའ་ཡིས་བསྣུན་ཏེ་གསད་པར་གྱིས།",
    "ལམ་ནི་རྙེད་པར་འགྱུར་ལགས་སོ།",
    "ལམ་ནི་རྙེད་པར་འགྱུར་ལགས་སོ།",
    "མི་བཟད་བསྙེན་པར་དཀའ་བ་ཡི།",
    "ནང་ག་ལ་ནི་བརྟན་པར་བྱ།",
    "གདུངས་པར་འཛིན་ཁྲི་ཁ་བཅིང་ངོ།",
    "ཆུ་བོ་རྣམས་རྒལ་ནས་གཅན་པའི་གནས་ན་གནོད་སྦྱིན་ལྔ་བརྒྱ་ཡོད་པ་དེ་རྣམས་ལ་སྲན་ཚུགས་ཏེ་གཞོམ་པར་མཛོད་ཅིག།",
    "སྣ་བོ་བསྐོས་ལགས་ཏེ།",
    "དཔྱ་དང་སྐྱེས་ཀྱང་འདི་དག་ལགས་ཀྱིས་ཕྱག་མཛོད་དུ་གཞུག་ཏུ་གསོལ།",
    "བུ་ལེགས་པར་བྱས་ཀྱིས་བཞེས་སོ།",
    "དེ་ནས་གཞོན་ནུས་ཕ་ལ་ཕྱག་བྱས་ནས་ཆས་པ་དང་།",
    "ཡབ་ངེས་པར་དེང་ཉིད་བདག་མཆི་ལགས་སོ།",
    "དེས་ཇི་ལྟར་གྱུར་པ་ཐམས་ཅད་རྒྱས་པར་སྨྲས་པ་དང་།",
    "ཡུམ་དེ་མ་རྙེད་པར་བདག་དགའ་བར་གལ་འགྱུར།",
    "དེའི་བསྟི་གནས་ན་ཚངས་པ་འདུ་བཞེས་བགྱི་བའི་རྫིང་མཆིས་ཏེ།",
    "ད་ནི་དེ་བས་ཁྱད་པར་འགས་པའི་ཆུང་མ་སྦྱིན་ནོ།",
    "དགེ་སློང་བརྩོན་འགྲུས་བརྩམས་པ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
