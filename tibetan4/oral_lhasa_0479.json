    "མདུན་རྒྱབ་ལེབ་ཆགས་པ་ལ་སྟ་ཟུར་རྣམས་སུལ་མང་པོ་ཡོད་པའི་ཤམ་ཐབས་ཕན་ཚུན་རྒྱབ་ཏུ་འཕྱར་བ་སྟེ་བཞུགས་པའོ།",
    "རྒྱན་དང་ཕྱག་མཚན་འདི་རྣམས་ཀྱི་མཚོན་དོན་དང་ངོ་བོ་ནི་ལྷ་ལྷག་མ་འཆད་འགྱུར་རྣམས་ལའང་ཅི་རིགས་ཤེས་པར་བྱའོ།",
    "གཉིས་པ་ནི་རྡོ་རྗེ་ནི་ཐབས་དང་ཞེས་སོགས་བརྗོད་པའི་ཚེ་རྡོར་དྲིལ་བྱིན་གྱིས་བརླབ་པ་དང་མཚོན་དོན་དྲན་པར་བྱ་སྟེ།",
    "དྲིལ་བུའི་ལྕེས་ཡུམ་གྱི་དྷཱུ་ཏཱིའི་མར་སྣ་མཚོན་པ་སོགས་རྫོགས་རིམ་དང་སྦྱར་ནས་འཆད་ཚུལ་ཡང་ཤེས་པར་བྱའོ།",
    "དྲིལ་བུས་དེའི་བར་གྱི་ཤེས་རབ་ཀྱི་ཆ་ཐམས་ཅད་མཚོན་པའི་ཚུལ་དྲན་པར་བྱའོ།",
    "ཨོཾ་ནི་ཅི་ཞིག་ཡིན་པར་བརྗོད།",
    "ཅེས་གསུངས་པ་ལྟར་དོན་བདུན་ལ་འཇུག་པའི་མཚོན་དོན་དྲན་པའི་སྒོ་ནས་བརྗོད་ན་ཕན་ཡོན་ཆེན་པོར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཞེས་གསུངས་པ་ལྟར་དོན་དྲན་པའི་སྒོ་ནས་རྡོ་རྗེ་འཛིན་ནོ།",
    "དེའི་སྒྲས་ཀྱང་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་སྒྲོགས་པར་སེམས་པའོ།",
    "དགོས་དོན་དེ་ལྟར་དྲན་པར་བྱའོ།",
    "དེའི་ཚེ་སྒྲུབ་གཞི་སོགས་རང་བཞིན་གྱིས་སྟོང་པར་བསམས་ཏེ་ཐ་མལ་གྱི་སྣང་ཞེན་དགག་པར་བྱའོ།",
    "དེ་ལྟར་སྟོང་པར་སྦྱངས་པའི་བདེ་སྟོང་དབྱེར་མེད་ཀྱི་ངང་ལས།",
    "ཧཱུཾ་ཡཾ་ཧཱུཾ་ཞེས་སོགས་ཀྱི་དོན་བསམས་པའི་སྒོ་ནས་བསྐྱེད་པར་བྱ་སྟེ།",
    "དེ་དག་རིམ་པར་ཡོངས་སུ་གྱུར་པ་ལས།",
    "ཁ་ཅིག་དེ་ལས་ལྡོག་སྟེ་མཚོན་པར་ཡང་བཤད།",
    "ཤཱུནྱ་ཏས་སྟོང་པར་སྦྱངས།",
    "པྲ་ཏཱིཙྪ་ནི་སོ་སོར་བཞེས།",
    "ཐུན་མཚམས་སུ་ནི་སྤྱད་པར་བྱ།",
    "ཏིཥྛ་ནི་གནས་པར་མཛོད།",
    "སྐྱབས་སེམས་བྱེད་པའི་ཚིག་དོན་ནི་འོག་ཏུ་འཆད་པར་བྱའོ།",
    "ཤྲཱི་ཡེ་ནི་བཞིན་དུ་བཞེས།",
    "གཟུགས་ཕུང་རྣམ་པར་དག་པའི་ངོ་བོ་རྣམ་སྣང་དང་།",
    "རྡོ་རྗེ་དོན་གྲུབ་ཀྱི་རིགས་སྟོབས་པོ་ཆེ་ཡིན་པར་བསྟན་ཏེ།",
    "བཤགས་ཚུལ་རྒྱལ་བས་གསུངས་པའི་ཆོ་ག་བཞིན་ཏེ་སྟོབས་བཞི་ཚང་ཞིང་འཁོར་གསུམ་མི་དམིགས་པར་རྟོགས་པའི་ཤེས་རབ་ཀྱིས་ཟིན་པའི་སྒོ་ནས་གཤག་པར་བགྱིའོ།",
    "བསམ་དང་རྣམ་པར་སྨིན་པ་ཞེས་སོགས་ཤློ་ཀ་གཉིས་ཀྱི་སྟོན་ཏེ།",
    "དེའི་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་སྦྱོར་བ་རྣམ་པར་དག་པར་གྱུར་པས་སྒྲིབ་པ་ཀུན་གྱི་བག་ཆགས་ཡང་དག་པར་འབྱིན་ཅིང་།",
    "འོན་ཀྱང་སྡོམ་པ་ཐམས་ཅད་ལྡན་པར་ནི།",
    "མཇུག་ཏུ་ཚོགས་ཞིང་རྣམས་རང་བཞིན་གྱིས་སྟོང་པར་བསམ་པ་དང་།",
    "རང་གནས་སུ་གཤེགས་པ་སོགས་དུ་མ་ཡོད་པ་ལས་འདིར་སྔར་སྤྱན་དྲངས་པའི་རང་གནས་སུ་གཤེགས་པར་བསམ་པའོ།",
    "སྔར་བསྐྱེད་པའི་ཟླ་གདན་དེ་ཉི་གདན་དུ་གྱུར་པའི་སྟེང་དུ་རང་ཞེ་སྡང་རྡོ་རྗེ་སེམས་དཔའ་སུམ་བརྩེགས་ཅན་དུ་བསྐྱེད་པར་བྱ་སྟེ་མངོན་རྟོགས་ལྟར་རོ།",
    "ཕུར་བུའི་མགོར་བརྡུང་བའི་སྟངས་ཀ་ཙམ་བྱས་པས་བགེགས་རྣམས་ཀྱི་མགོ་བོ་ནས་རྐང་མཐིལ་གྱི་བར་དུ་ནུན་ནུན་མར་ཟུག།",
    "དཔངས་སྟེང་ཚངས་པའི་འཇིག་རྟེན་ལས་འོག་གསེར་གྱིས་གཞི་ལ་ཐུག་པར་ལྭ་བ་པ་དང་།",
    "གང་དུ་འཚང་རྒྱའི་ཞིང་ཀུན་དག་བྱས་ནས།",
    "ཕྱི་མ་འཆགས་པའི་རིམ་པ་དང་མཐུན་པར་བསྒོམ་ཚུལ་ལོ།",
    "དེའི་རྗེས་སུ་བསམ་གཏན་དང་པོའི་ལྷ་རྣམས་ཀྱི་རྒྱུད་ལ་བསམ་གཏན་གཉིས་པའི་ཏིང་ངེ་འཛིན་རིམ་གྱིས་སྐྱེས་ནས་བསམ་གཏན་གཉིས་པར་ཚེ་འཕོས་པའི་ཚུལ་གྱིས་སྟོང་།",
    "གཉིས་ཀ་མ་ཡིན་པར་རང་བཞིན་གྱིས་གྲུབ་པའི་མཐའ་བཞི་དང་བྲལ་བའི་ཕྱིར།",
    "དེ་ལྟར་དོན་དམ་དཔྱོད་བྱེད་ཀྱི་རིགས་པས་ལེགས་པར་དཔྱད་པ་ནི།",
    "རང་ཡང་རིམ་གྱིས་མི་སྣང་བར་བྱས་ཏེ་དེ་ཀའི་ངང་ལ་ལྟ་བ་དྲན་པར་བྱས་ནས་ལྟ་ཐོག་ཏུ་འཇོག་གོ།",
    "ཞེང་ནི་ཐམས་ཅད་ཀྱང་ཆ་ཕྲན་གསུམ་གསུམ་བྱས་ན་ལེགས།",
    "རྣམ་སྣང་གཟུགས་ཕུང་རྣམ་པར་དག་པའི་ལྷ་ཡིན་པས།",
    "རྡོ་རྗེ་མ་བཞི་བཞུགས་པ་ནི་ལྷ་སྣམ་ཕྱི་མ་ལས་ཅུང་ཟད་མཐོ་བ།",
    "ལྷ་གཞན་བཞུགས་པ་ནི་གོ་སླ་ཞིང་།",
    "གདན་རྣམས་ནི་ཧ་ཅང་མཐོ་བ་མིན་པར་ཅུང་ཟད་འབུར་བའི་རྣམ་པ་ཅན་ནོ།",
    "ནང་འཁྲིགས་པར་གང་བར་བསམ།",
    "དེ་བཞིན་དུ་ཕྱོགས་གཞན་གསུམ་རིམ་བཞིན་རིན་འབྱུང་འོད་དཔག་མེད་དོན་གྲུབ་ཀྱི་ཞིང་དུ་གཤེགས་པར་བསམ།",
    "རང་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པའི་ཐུགས་ཀར་ཐིམ་པར་བསམ་པ་ནི་གཤེགས་པའི་དོན་དུ་མཛད་ཀྱང་།",
    "གཤིན་རྗེ་གཤེད་ཀྱི་དབུ་ལག་པ་གཡས་ཀྱི་མཐེ་བོང་དང་ཞལ་ནང་དུ་ཕྱོགས་པར་གསུངས་པའི་ནང་ནི་ལག་མཐིལ་ཕྱོགས་ལ་བལྟ་བའི་དོན་དུ་སེམས།",
    "གཞི་དུས་ཀྱི་ཡེ་ཤེས་ལྔ་སྟེ་རགས་པ་ཉེར་ལྔའི་ཐིམ་རིམ་དང་མཐུན་པར་འོད་གསལ་དུ་སྡུད་པ་ཡིན་ལ་དེ་ཡང་རྣམ་སྣང་ནས་མི་གཡོ་བའི་བར་འོད་གསལ་དུ་ཐིམ་པ་ནི།",
    "གཙོ་བོ་འོད་གསལ་དུ་ཐིམ་པ་ན་སྔར་བཞིན་ལྟ་བ་དྲན་པར་བྱས་ལ།",
    "དེ་བརྟན་པར་བྱ་བའི་ཆེད་དུ་ཤཱུནྱ་ཏའི་སྔགས་བརྗོད་པར་བྱའོ།",
    "འོད་གསལ་ལས་གཞན་གྱིས་བར་ཆོད་པ་མེད་པར་ལུས་རྫོགས་པར་འགྲུབ་པ་ཡིན་ནོ།",
    "ཡི་གེ་ཧཱུཾ་སྔོན་པོའི་རྣམ་པར་ཐོལ་གྱིས་བྱུང་།",
