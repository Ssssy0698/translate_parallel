    "ཁ་ཅིག་ནི་བདག་དང་ཡིད་འབྲེལ་པའི་ངོ་བོ་ཡིན་པར་བརྗོད་ད་དོ།",
    "དེ་ཡང་མངོན་སུམ་གྱིས་ཡོང་ས་སུ་ག་ཅད་༤པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་ལ་འབྲས་བུ་ལ་ལོག་པར་རྟོགས་༧པ་ནི་འདི་ལྟ་སྟེ།",
    "འཇིག་རྟེན་ན་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པ་དག་ནི་ཕན་ཚུན་ཐ་དད་པའི་བདག་ཉིད་དུ་གྲགས་པའི་ཕྱིར།",
    "རྫས་ལ་སོགས་པའི་ཁྱད་པར་ཅན་གྱི་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་འབྲས་བུ་ཡིན་ནོ་ཞེས་ཟེར་ཏེ།",
    "འདིས་ནི་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་རྣམ་པ་གཉིས་ཁོ་ན་ཞལ་གྱིས་༤བཞེས་པ་ཡིན་ཏེ།",
    "ད་པེ་ལ་སོགས་པས་ཡོངས་སུ་བརྟགས་པར་ཞལ་གྱིས་བཞེས་པའི་ཕྱིར་ར་རོ།",
    "སྔོན་པོ་ཤེས་པ་དང་༢དོན་དུ་འདུ་ཤེས་ཀྱི་ཞེས་བྱ་བ་འདི་གཉིས་ཀྱིས་ནི་ཡུལ་ཕྱིན་ཅི་མ་ལོག་པར་བསྟན་པའི་ཕྱིཕྱིར།",
    "དེ་ཉིད་ལས་མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ངེས་པར་རྟོག་པ་དང་།",
    "རྗེས་སུ་དྲན་པའི་རྣམ་པར་རྟོག་པས།",
    "ཅེས་གསུངས་ཏེ།",
    "འདིས་ནི་བྱེད་པ་པོ་དང་ལས་ལ་སོགས་པའི་དངོས་པོ་ཡང་དག་པར་༥བཀག་པས་བྱ་བ་ལ་སོགས་པ་ཐམས་ཅད་ཀྱི་ཁོངས་སུ་འདུས་པ་སྤངས་པའི་ཕྱིར།",
    "རྗེས་སུ་ད་པག་པ་ལ་ཡང་ལོག་པར་རྟོགས་པ་སྣང་སྟེ།",
    "༡དེའི་བུ་སྣང་བ་ཡིན་༢ནོ་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་ལ་ཚུལ་གསུམ་པ་ཡོད་ཀྱང་གཞན་དུ་མི་འཐད་པ་ཉིད་ཀྱི་ཡན་ལག་མེད་པའི་ཕྱིར་རྟོགས་པར་བྱེད་པ་ཉིད་མ་ཡིན་ནོ།",
    "ཚུལ་གསུམ་པ་མེད་ཀྱང་གཞན་དུ་མི་འཐད་པ་དང་ལྡན་པ་ཙམ་ཁོ་ནས་གཏན་ཚིགས་རྟོགས་པར་བྱེད་པ་ཡིན་པ་ཡང་མཐོང་སྟེ།",
    "དངོས་པོ་མེད་པ་ཕྱོགས་སུ་བྱས་པའི་ཕྱིར་རོ་། དེ་དག་ལ་མ་གཏོགས་པ་གཞན་མེད་པའི་ཕྱིར་གང་ཞིག་དཔེ་ཉིད་ཡིན་པར་འགྱུར།",
    "དེ་ལྟར་ན་རྟགས་ནི་ཚུལ་གཅིག་པ་ཁོ་ན་ཡིན་པར་རིགས་ཀྱི་ཚུལ་གསུམ་པ་ཉིད་ནི་མ་ཡིན་པའི་རིགས་སོ་ཞེས་ཟེར་ར་རོ།",
    "བརྗོད་༤པར་འདོད་པའི་གྲངས་གཅིག་པ་ཅན་ཉིད་ད་དང་།་",
    "རྗེས་སུ་དཔག་པར་འདོད།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་ཤེས་པ་ནི་མ་ཡིན་ནོ་ཞེས་ཟེར་ར་རོ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་ཤེས་པ་ནི་འབྲས་བུ་ཡིན་པར་འདོད་ད་དེ།",
    "བྱེ་བྲག་པ་ལ་སོགས་པ་ནི་ཡང་ད་ག་པར་མ་གྲུབ་པ་ཡང་གཏན་ཚིགས་སུ་ཉེ་བར་རྟོགས་པར་བྱེད་ད་དེ།",
    "དེ་བཞིན་དུ་བརྗོད་༢པར་འདོད་པའི་སྐྱེས་བུ་འགའ་ཞིག་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་ཏེ།",
    "གྲངས་ཅན་པ་ལ་སོགས་པ་ནི་གཏན་ཚིགས་འགལ་བར་མཐོང་བཞིན་དུ་ཡང་ཤིན་ཏུ་ངོ་མཚར་ཆེ་བའི་མ་རིག་པས་བློ་གྲོས་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པས་མི་འགལ་བ་བཞིན་དུ་རྟོགས་པར་བྱེད་དེ།",
    "མི་མཐུན་པའི་ཕྱོགས་གཅིག་ལ་ཡོད་པ་ལ་༧ཡང་གཏན་ཚིགས་སུ་རྟོགས་༨པར་བྱེད་ད་དེ།",
    "དེ་བཞིན་དུ་དཔེར་བརྫོད་པ་ཡང་འདི་ཉིད་ལས་སྟོན་པར་འགྱུར་རོ།",
    "འོན་ཏེ་སྒྲུབན་ནི་བསྒྲུབ་པར་བྱ་བ་སྔ་ཉིད་ནས་གྲུབ་པའི་ཕྱིར།",
    "འདི་ལས་རྗེས་སུ་དཔག་པར་བྱ་བ་ནི།",
    "རིགས་པ་ཅན་ལ་སོགས་པ་གང་དག་མེད་པའི་ངོ་བོ་མི་མཐུན་པའི་ཕྱོགས་ཡིན་པར་མི་འདོད་ད་དོ།",
    "མེད་པའི་ངོ་བོ་ལས་འགའ་ཡང་ལྡོག་པར་མི་རུང་བའི་ཕྱིར་ར་རོ།",
    "ཁྱད་པར་དུ་མཐོང་བའོ་ཞེས་ཟེར་ར་རོ།",
    "མེ་ལ་སོགས་པ་འགྲུབ་པར་བྱ་བ་ལ་སོགས་པ་འབྲས་བུའི་རྟགས་འཁྲུལ་པ་སྨྲ་སྨྲ་སྟེ།",
    "ལྷ་སྦྱིན་དང་མཆོད་སྦྱིན་༨ལྟ་བུའོ།",
    "སྤྱོད་པ་པ་རྣམས་ནི་ད་ལྟར་ཐམས་ཅད་མཁྱེན་པ་ལ་སོགས་པ་མི་དམིགས་པའི་ཕྱིཕྱིར།",
    "མ་འོངས་པའི་དུས་ན་ཡང་དེའི་སྒོ་ནས་དེ་མེད་པར་ཤེས་ཏེ།",
    "ཁྱད་པར་བྱེད་པ་མ་ཡིན་པ་ད་ང་།",
    "པོ་དང་བསྒྲུབ་༡༧པས་ཀྱང་མི་འགལ་བ་བསྒྲུབ་པའི་སྒོ་ནས་ཐམས་ཅད་མཁྱེན་པ་ལ་སོགས་པ་འགོག་པར་སྨྲ་སྟེ།",
    "འཇིག་པ་༡༧རྒྱུ་དང་བཅས་པར་སྨྲ་བ་འགག་༡༧པའི་ཕྱིཕྱིར།",
    "ཕ་རོལ་པོས་རབ་ཏུ་སྦྱར་བའི་མི་དམིགས་པ་ལ་ནུས་པ་མེད་པར་བསྟན་པ་ཡིན་ན་ནོ།",
    "བཅོམ་ལྡན་འདས་རྗེས་སུ་དཔག་པའི་རྟེན་གྱི་རྟགས་སྟོན་པར་མཛད་པ་ཉིད་ཀྱིས་གསུངས་ཏེ།",
    "གཏན་ཚིགས་ལ་ཁྱབ་པར་སྟོན་པར་མཛད་པས།",
    "མི་དམིགས་པའི་ཁྱད་པར་ཞེས་བྱ་བ་ཡང་བསྟན་པ་ཁོ་ན་སྟེ།",
    "གཞན་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་འགྱུར་ར་རོ།",
    "དེ་ལྟ་བས་ན་གཉི་ག་རྟོགས་པར་བྱ་བའི་ཕྱིར་གཉི་ག་བརྗོད་པར་བྱ་དགོས་སོ་ཞེས་བྱ་བར་རྟོགས་ས་སོ།",
    "རང་བཞིན་གྱི་གཏན་ཚིགས་རྣམ་པ་འདི་གསུམ་ཆར་གྱི་ཡང་ལོག་པར་རྟོགས་པར་བསལ་བའི་ཕྱིཕྱིར།",
    "མཇུག་བསྡུ་བ་དག་ནི་ལྡོག་༢པ་ཡིན་པའི་ཕྱིར་མ་བསྟན་པ་ལ་ཡང་རག་ན་ཕྱོགས་གོ་ཅི་སྟེ་སྟོན་པར་མི་བྱེད་སྙམ་སྟེ་སེམས་པ་དེ་དག་ལ་སྦྱོར་བ་འདི་གཉི་ག་ལ་ཡང་ཕྱོགས་བསྟན་པར་ངེས་པ་མེད་དེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་༤།",
    "གཞན་དག་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་པ་ཡང་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བཟུང་ནས།",
    "དེའི་སྒོ་ནས་གཏན་ཚིགས་ཀྱི་སྐྱོན་རྗོད་༥པར་བྱེད་ད་དེ།",
    "རིགས་པ་ཅན་ལ་སོགས་པ་ནི་ད་མ་བ་ཅའ་ནི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཡིན་ནོ་ཞེས་ཕྱོགས་ཀྱི་མཚན་ཉིད་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པར་ཉེ་བར་སྟོན་ཏོ།",
    "ནམ་མཁའི་གོས་ཅན་རྣམས་ནི་ཕྱོགས་ཀྱི་ཕྱོགས་གཅིག་ལ་ཡོད་པར་༧ཡང་གཏན་ཚིགས་ཡིན་པར་རྟོགས་ཏེ།",
    "དེ་རྣམ་པར་གཅད་པར་གོ་རིམས་བཞིན་དུ་རྗེས་སུ་དཔག་པར་བྱ་བ་ལ་ཡོད་པ་དང་།",
    "ཡུལ་ཁྱད་པར་ཅན་དུ་ངེས་པར་གཟུང་༨བ་ནི་འདོད་པའི་དོན་རྟོགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "གྲངས་ཅན་པ་རྣམས་ནི་རྒོལ་བ་དང་ཕྱིར་རྒོལ་བ་དག་ལ་མ་གྲུབ་པ་ཡང་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་སྟོན་ཏེ།",
    "བསྟན་བཅོས་བྱེད་པར་༡འདོད་པ་ཐམས་ཅད་བསྒྲུབ་པར་བྱ་བ་ཁོ་ན་ཡིན་ནོ་ཞེས་བྱ་བར་བུ་རྟོགས་༐",
    "སོ་། ༡དེའི་སྒོ་ནས་བྱས་པ་ཉིད་ལ་སོགས་པ་ཡང་དག་པའི་སྒྲུབ་པ་ལ་ཡང་འགལ་བ་རྗོད་༢པར་བྱེད་ད་དེ།",
    "དེའི་ཕྱིར་རྗེས་སུ་དཔག་པས་གནོད་པ་བསལ་ཏོ་། བརྡ་སྤྲོད་པ་༢༡ཁ་ཅིག་སྒྲ་བཟང་པོ་ཁོ་ན་རྗོད་པར་བྱེད་པ་ཡིན་གྱི་མི་བཟང་བ་ནི་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "བསྒྲུབ་པར་བྱ་བ་དང་།",
    "དུས་ལས་འདས་པ་ནི་གཏན་ཚིགས་ལྟར་སྣང་བ་དག་ཡིན་ནོ་ཞེས་གཞན་དུ་འཆད་པར་བྱེད་ད་དེ།",
    "དཔེར་ན་བྱེ་བྲག་ནི་༡རྡུལ་ཕྲ་རབ་ད་ག་ནི་ལུས་ཅན་མ་ཡིན་པའི་ཕྱིར་རྩོམ་པར་བྱེད་པ་མ་ཡིན་༢ཞེས་ཟེར་བ་ལྟ་བུའོ།",
    "ལུས་ལས་འོང་བ་ད་ང་ལྡན་པའི་ཕྱིར་རོ་ཞེས་དཔེར་རྗོད་༦པར་བྱེད་པ་ལྟ་བུའོ།",
    "དཔེར་ན་སྒྲ་ནི་མི་རྟག་པ་སྟེ་བུམ་པ་བཞིན་ནོ་ཞེས་སྨྲས་ནས་དྲིས་པ་དང་བྱས་པའི་ཕྱིར་རོ་ཞེས་གཏན་ཚིགས་༐",
    "གང་ལ་རྟགས་དང་རྟགས་ཅན་དག་འབྲེལ་པར་མ་གྲུབ་པ་དེ་ལ་མ་གྲུབ་པ་ཡིན་ན་ནོ།",
    "སྐྱེས་བུ་ཐམས་ཅད་ཐམས་ཅད་མཁྱེན་པ་ཉིད་མ་ཡིན་པར་དམ་འཆའ་བ་ནི་རྒྱལ་དཔོག་པ་རྣམས་ཀྱི་ཡིན་ནོ།",
    "དོ་ཞེས་རྗོད་པར་བྱེད་དོ།",
    "དེ་ལ་དཔེར་བརྗོད་༦པ་ནི་དཔེར་ན་སྒྲ་མི་རྟག་པ་སྟེ་བྱས་པའི་ཕྱིར་བུམ་པ་ལྟ་བུའོ་ཞེས་༐",
    "སྒྲ་ནི་རྟག་པ་སྟེ་མཉན་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་སྒྲ་ཉིད་ལྟ་བུའོ་ཞེས་སྨྲས་པ་དེའི་ཚེ་སྦྱོར་བ་སྔ་མ་མ་ངེས་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ་ཞེས་༐",
    "སྒྲ་མི་རྟག་པ་སྟེ་བྱས་པའི་ཕྱིར་བུམ་པ་བཞིན་ནོ་ཞེས་ཟར་༐",
    "སེར་སྐྱ་ལ་སོགས་པ་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ནམ་མཁའི་གོས་ཅན་རྣམས་ཀྱི་སྦྱོར་བ་ཡིན་ནོ།",
    "ཉིད་དེ་༡བྱས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རིགས་པ་ཅན་གྱི་ཡིན་ནོ།",
    "དེ་ལ་ལྟག་ཆོད་༢རྣམས་ཀྱི་དཔེར་བརྗོད་༢པ་ཕྱོགས་ཙམ་ཞིག་བརྗོད་པར་བྱ་སྟེ།",
    "དེའི་ཚེ་བསྒྲུབ་པར་བྱ་བ་དང་ཁྱད་པར་མེད་པར་འགྱུར་ཏེ།",
    "གཞན་ཡང་འདི་བསྒྲུབ་པར་བྱ་བ་གྲུབ་ཟིན་པ་ད་ང་ལྷན་ཅིག་ཕྲད་པར་འགྱུར་ར་རམ།",
    "གཏན་ཚིགས་མ་ཕྲད་པ་རྣམས་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ལྟ་བུ་ཡིན་ནོ།",
    "༨པེ་སྣར་དེ་ཞེས་བརྗོད་པར་བྲེད་དེ།",
    "༧པེ་སྣར་བྱས་པ་ལ།",
    "ཁྱད་པར་བྱེ་བྲག་སྦྱོར་བའོ།",
    "འགྲོ་བ་ཤུགས་ཀྱིས་རྟོགས་པར་བྱ་༤།",
    "རྣམ་པ་གཉིས་སུ་ཤེས་པར་བྱ།",
    "བསྒྲུབ་པར་བྱ་བ་བདུན་ཅུ་ལྔ།",
    "བཟོད་པར་གསོལ་ལོ་མཁས་པ་རྣམས།",
    "པེ་སྣར་ལ་རིགས་པའི་ཐིགས་པའི་དོན་བསྡུས་པ་སློབ་ད་པོན་ཛི་ན་མི་ཏྲས་མཛད་པ་བཞུགས་སོ།",
    "བློ་དང་ལྡན་པ་རྣམས་ཀྱིས་བསྔགས་བྱ་གཏན་ཚིགས་ཐིགས་པ་རབ་གསལ་ལུགས་རྒྱས་རྣམ་པར་དབྱེ།",
    "བརྗོད་པར་བྱ་བ་དང་།",
    "དགོས་པའི་ཡང་དགོས་པ་རྣམས་སྟོན་པར་བྱེད་ད་དོ།",
    "བརྗོད་པར་བྱ་བ་མེད་པ་དང་།",
    "འདི་ལ་བརྗོད་པར་བྱ་བ་ནི་ཅི་ཞིག་ཡིན་ཞེས་བྱ་བ་མ་གཏོགས་༡པ་ད་ང་།",
    "འདིའི་འབྲེལ་པ་ནི་གང་ཞིག་ཡིན་ཞེས་བྱ་བ་ཡང་དག་པར་མ་རིག་༢པ་དེ་སྲིད་དུ་རབ་ཏུ་བྱེད་པ་ལ་དགའ་བ་ཡང་སྐྱེད་པར་མི་བྱེད་ན་མཉན་པ་དང་སེམས་པ་ལ་སོགས་པ་ལ་འཇུག་པར་འགྱུར་བ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "བརྗོད་པར་བྱ་བ་བསྙད་པས་ནི་འདི་ལ་བརྗོད་པར་བྱ་བ་ནི་ཅི་ཞིག་ཡིན་སྙམ་དུ་བརྗོད་པར་བྱ་བ་ལ་བརྟེན་པའི་རྨོངས་པ་དེ་ལྟ་བུ་ཟློག་པར་བྱེད་དོ།",
    "དགོས་པ་བརྗོད་པ་༥ནི་འབྲས་བུ་མེད་པར་དོགས་པ་ཟློག་པར་བྱེད་ད་དོ།",
    "འབྲེལ་པ་བསྙད་པས་ནི་ཐབས་མ་ཡིན་པར་དོགས་པ་སེལ་བར་བྱེད་ད་དོ།",
    "དེ་འདིར་དེ་བྱེ་བྲག་ཏུ་རྟོགས་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་འདིས་ནི་བརྗོད་པར་བྱ་བ་དང་དགོས་པ་དངོས་སུ་བསྟན་ཏོ།",
    "དེ་ལ་ཤུགས་ནི་འདི་ཡིན་པར་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "རྗེས་སུ་དཔག་པ་བྱེ་བྲག་ཏུ་རྟོགས་པར་བྱ་བའི་ཕྱིར་རབ་ཏུ་བྱེད་པ་རྩོམ་ན་རབ་ཏུ་བྱེད་པ་ནི་དོན་གྱིས་ན་ཐབས་ཉིད་ཡིན་པར་སྟོན་པར་བྱེད་དེ།",
    "འདིར་རྗེས་སུ་དཔག་པ་བྱེ་བྲག་ཏུ་རྟོགས་པར་བྱ་བ་ཞེས་བྱ་བ་འདི་ནི་བརྗོད་པར་བྱ་བ་ཡིན་ན་ནོ།",
    "དེ་ལྟ་བས་ན་རབ་ཏུ་བྱེད་པ་དང་དགོས་པ་གཉིས་ནི་ཐབས་དང་ཐབས་ཀྱིས་བསྒྲུབ་པར་བྱ་བའི་མཚན་ཉིད་ཀྱི་འབྲེལ་པ་ཡིན་ཏེ།",
    "རྗེས་སུ་དཔག་པ་ནི་ཐབས་ཀྱིས་བསྒྲུབ་པར་བྱ་བ་ཡིན་པར་གྲུབ་བ་བོ།",
    "བསྒྲུབ་པར་བྱ་བ་དང་།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་འབྲས་བུ་ཡིན་ན་ནོ།",
    "རྒྱས་པར་བྱ་བའི་མཇུག་ཐོགས་སུ་བསྟན་པ་ཡིན་ཞེས་བྱ་བ་དེ་ཙམ་གྱིས་ནི་དོན་དུ་གཉེར་བ་རྣམས་ཐབས་མ་ཡིན་པ་ལ་འཇུག་པར་མི་འགྱུར་རོ།",
    "པ་དེའི་༡ཕྱིར་རྗེས་སུ་དཔག་པ་འབད་དེ་ཡོངས་སུ་ཤེས་པར་བྱའོ།",
    "ཡོངས་སུ་ཤེས་པ་དེ་ཡང་རབ་ཏུ་བྱེད་པ་འདི་ལས་འགྱུར་བས་དེའི་ཕྱིར་རྗེས་སུ་དཔག་པ་དགོས་པར་གྱུར་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་རབ་ཏུ་བྱེད་པ་འདི་བརྩམ་པར་བྱའོ་ཞེས་བསྟན་པར་འགྱུར་ཏེ།",
    "ལྐོག་ཏུ་གྱུར་པ་ཞེས་སྨོས་པས་ནི་དེ་ཉིད་ཁྱད་པར་དུ་བྱས་ས་སོ།",
    "བཏང་སྙོམས་སུ་བྱ་བ་རྗེས་སུ་དཔག་པར་མི་འགྱུར་རོ།",
    "སྒྲུབ་པར་༤ཞེས་བྱ་བའི་སྒྲ་ནི་ལེན་པ་དང་འདོར་བ་དང་བཏང་སྙོམས་ཀྱི་མཚན་ཉིད་ཀྱི་བསྒྲུབ་པ་ལ་བྱའོ།",
    "འདིར་རྗེས་སུ་དཔག་པའི་སྒྲ་ནི་རྗེས་སུ་དཔག་པར་བྱ་བའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ལ་བྱའོ།",
    "དེ་བྱེ་བྲག་ཏུ་རྟོགས་པར་བྱ་བ་དེའི་ཕྱིར་ར་རོ།",
    "ཡང་ན་དོན་ལྐོག་ཏུ་གྱུར་པ་སྒྲུབ་པ་ནི་རྗེས་སུ་དཔག་པར་བྱ་བའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ཡིན་ལ།",
    "འདིས་རྗེས་སུ་དཔོག་པར་བྱེད་པའི་ཕྱིར་ར་རོ།",
    "ཚིགས་སུ་བཅད་པ་འདིས་རབ་ཏུ་བྱེད་པའི་ཡུལ་མཐའ་དག་བསྡུས་ནས་སྟོན་པར་བྱེད་དོ།",
    "བསྡུས་པའི་དོན་ནི་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་སྤྱི་ཕྱོགས་ཡིན་པར་གཟུང་༦ན་ནི་དེའི་ཚེ་གཏན་ཚིགས་མ་གྲུབ་པར་འགྱུར་བ་འམ་གྲུབ་ན་ཡང་རྗེས་སུ་དཔག་པ་དོན་མེད་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་པ་ལ།",
    "དངོས་སུ་བསྟན་དུ་རུང་བ་ལ་ནི་དགོས་པ་མེད་པར་ཉེ་བར་གདགས་སུ་མི་རུང་སྟེ།",
    "བརྟེན་པར་བྱ་བ་ནི་རྟེན་ཏེ།",
    "འདིར་ཉེ་བ་ནི་བློ་ལ་སྣང་བའམ་ཡང་ན་བསྒྲུབ་པར་བྱ་དགོས་པའོ།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བས་ཀྱང་ཉེ་བར་༢འཁྲུལ་པར་བསྟན་པའི་ཕྱིཕྱིར།",
    "དེ་ཡང་བློ་ལ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་སྣང་ལ།",
    "བསྒྲུབ་པར་བྱ་བའི་སྐབས་ཀྱང་ཡིན་པས་དེའི་ཕྱིར་ཐེ་ཚོམ་དུ་༐",
    "ཁྱབ་པ་ཡིད་ཆེས་པར་བྱ་བའི་ཕྱིར་དེའི་ཆས་ཁྱབ་པ་ཞེས་བྱ་བ་ཡང་གདོན་མི་ཟ་བར་བརྗོད་པར་བྱ་དགོས་སོ།",
    "དེ་བརྗོད་མ་དེ་ཁོ་ནས་ཡོད་པར་འགྲུབ་སྟེ།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བས་གྲུབ་ཀྱང་ངེས་པར་བྱ་བའི་ཕྱིར་ཡང་སྨོས་སུ་དོགས་པར་འགྱུར་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་མེད་པ་ལ་གཏན་ཚིགས་མེད་དོ་ཞེས་སྨོས་པ་གང་ཡིན་པ་དེ་ནི་འདི་ལྟར་གཏན་ཚིགས་ནི་མེད་པ་ཁོ་ན་ལས་ལོག་པ་ཡིན་གྱི།",
    "དེ་བས་ན་དེ་ལྟར་ངེས་པར་བྱ་བ་ཡིན་པར་དོགས་པ་བཟློག་པའི་ཕྱིར་ཉེ་བར་གདགས་པར་བྱའོ་ཞེས་བྱ་བར་གནས་ས་སོ།",
    "ངེས་པར་བྱ་བ་ཡིན་པར་དོགས་པ་ཡོངས་སུ་སྤངས་པ་ཡིན་པ་༡འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "བསྒྲུབ་པར་བྱ་བ་དང་།",
    "དེ་ལྟ་བས་ན་ཉེ་བར་གདགས་པ་མི་བྱའོ་ཞེས་བྱ་བ་ཡིན་ལ་དོགས་པར་བྱ་སྟེ།",
    "ཡང་ཞེས་བྱ་བའི་སྒྲའི་དོན་ནི་སྒྲུབ་པར་བྱེད་པའི་དཀའ་བ་ཡང་ཡོངས་སུ་སྤངས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གང་ཞིག་ཕྱོགས་ཀྱི་༦ཁྱད་པར་དུ་བྱེད་པ་དེ་ནི་ཕྱོགས་ཁོ་ན་ལ་ཡོད་ཀྱི་གཞན་ལ་ནི་མེད་ད་དོ།",
    "དེ་ལྟ་བས་ན་དེ་གཞན་དུ་འཇུག་པར་ལྟ་ག་ལ་འགྱུར།",
    "མ་འབྲེལ་བ་རྣམ་པར་བཅད་པས་བྱེ་བྲག་ཏུ་བྱས་པའི་ཕྱིར་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "འདིར་ནི་མ་འབྲེལ་པ་རྣམ་པར་གཅོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེས་ན་འདི་སྐད་དུ་སྒྲ་ལ་བྱས་པ་ཉིད་ཡོད།",
    "མི་འདོད་པའི་ངེས་པར་གཟུང་བ་བསལ་བར་བྱ་བའི་ཕྱིར།",
    "གཞན་དང་འབྲེལ་པ་རྣམ་པར་བཅད་པས་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ལ་ལར་ནི་གཞན་དང་འབྲེལ་བ་རྣམ་པར་༐",
    "གཅད་པ་༢ངེས་པར་གཟུང་བར་འདོད་པའི་འདོད་རྒྱལ་འདི་ག་ལས་སྨྲས་པ།",
    "དེ་ཉིད་མ་འབྲེལ་བ་རྣམ་པར་བྱ་བཅད་པ་ཞེས་བྱ་སྟེ།",
    "གཞུ་ཐོགས་པ་ཉིད་མི་སྲིད་པ་ཉིད་རྣམ་པར་གཅོད་པ་ཡིན་ལ།",
    "གཞན་ལ་ཕུལ་དུ་བྱུང་བ་ཡོད་དམ་མེད་པ་ཐེ་ཚོམ་ཟོས་ནས་མེད་པ་སྒྲུབ་པར་བྱེད་པའི་སྒྲ་སྦྱོར་བར་བྱེད་པ་དེར་ནི་གཞན་དག་དང་འབྲེལ་པ་རྣམ་པར་གཅོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "གཞན་དང་འབྲེལ་པ་རྣམ་པར་གཅོད་པར་བྱེད་པ་ཡིན་ན་ནོ།",
    "གཞན་དང་འབྲེལ་པ་རྣམ་པར་གཅད་༢ིཔར་བྱ་བ་ནི་མ་ཡིན་ནོ།",
    "ཁྱབ་པ་ནི་དེ་ལ་བྱ་ཁྱབ་པར་བྱེད་པ་ཡོད་པ་ཁོ་ནའམ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གདོན་མི་ཟ་བར་དེ་ཡོད་པ་ཁྱབ་པའི་སྒྲར་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་ག་གོ།",
    "གལ་ཏེ་ང་ལ་ཁྱབ་པར་བྱེད་པ་ཁོ་ན་ཡོད་དོ་ཞེས་དེ་སྐད་དུ་ངེས་པར་གཟུང་༢ན།",
    "འོན་ཏེ་དེ་ཁོ་ན་ལ་ཁྱབ་པར་བྱེད་པ་ཡོད་དོ་ཞེས་ངེས་པར་གཟུང་༢ིངོ་ཞེ་ན་ནི།",
    "འདིར་ཡང་གལ་ཏེ་དེ་ལ་ཁྱབ་པར་བྱ་བ་ཁོ་ན་ཡོད་དོ་ཞེས་ངེས་པར་གཟུང་ན་ནི་དེའི་ཚེ་མི་ཅ་སྲིད་པ་ཅན་གྱི་མཚན་ཉིད་དུ་འགྱུར་ཏེ།",
    "འོན་ཏེ་དེ་ཁོ་ན་ལ་ཁྱབ་པར་བྱ་བ་ཡོད་དམ་༡ཞེས་ངེས་པར་གཟུང་བར་བྱའོ་ཞེ་ན་ན་ནི།",
    "འདི་ལྟར་རྟག་པ་དག་ལ་ནི་གཞལ་བྱ་ཉིད་ཡོད་པར་གདོན་མི་ཟ་བ་༤ཡིན་ན་ནོ།",
    "ལྡན་པ་༦རྟེན་ཉིད་དུ་ཐ་མི་དད་ཅིང་རྣམ་པ་གཅིག་པར་རྟོགས་སོ།",
    "ལྟོས་ན་ཞནི་མ་འབྲེལ་པ་རྣམ་པར་བཅད་པས་ཁྱབ་པ་ཡིན་ལ།",
    "ཁྱབ་པར་བྱ་བ་ལ་ལྟོས་ན་ནི་གཞན་དང་འབྲེལ་པ་རྣམ་པར་བཅད་པས་འབྲེལ་པ་ཡིན་པས་འབྲེལ་པ་རྣམ་པ་ཐ་དད་པར་རྟོགས་ས་སོ།",
    "དེའི་ཕྱིར་དང་པོར་དེ་གཉས་ཁོ་ན་གཏན་ལ་དབབ་པ་བརྗོད་པར་བྱ་དགོས་སོ་ཞེས་སེམས་པར་འགྱུར་བ་དེའི་ཕྱིར།",
    "ཇི་ལྟར་ན་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ངེས་པར་༢ཁྱབ་པ་འཕེན་པར་བྱེད་སྙམ་པ་ལ།",
    "ཁྱབ་པར་བྱེད་པ་ལོག་ན་༢ཡང་ལྡོག་པར་ངེས་པ་ཡིན་ན་ནོ།",
    "དེ་ལྟ་བས་ན་གང་ཞིག་ལོག་ན་ངེས་པར་ལྡོག་པར་འགྱུར་བ་དེ་ནི།",
    "དེའི་ཁྱབ་པར་བྱེད་པ་ཡིན་པར་འགྲུབ་པར་ཁྱབ་པ་ནི་ལྡོག་པ་ལ་རག་ལུས་པ་ཡིན་ན་ནོ།",
    "མཇུག་བསྡུས་ཏེ་བསྟན་པར་བྱ་བའི་ཕྱིཕྱིར།",
    "དེ་ལྟ་ན་ནི་འཕེན་པ་འབའ་ཞིག་སྒྲུབ་༥པར་་ཟད་དོ།",
    "ཇི་ལྟར་དེ་ན་མངོན་སུམ་གྱི་སྒོ་ནས་དུ་བ་འགྲུབ་པར་འགྱུར།",
    "དེ་ལ་ནི་མངོན་སུམ་གྱིས་འཛིན་པར་༢སྲིད་དོ།",
    "དེ་ལྟ་བས་ན་ཉེས་པ་མཚུངས་སོ་ཞེས་བརྒལ་ཞིང་བརྟག་པར་བྱའོ།",
    "འོ་ན་ནི་འདི་ན་ཡང་ཕྱོགས་ཀྱི་ཡན་ལག་ཅན་ཡོད་པར་འགྱུར་བས་མཚུངས་ས་སོ།",
    "སྒྲ་ལས་བྱས་པ་ཉིད་ལྟ་བུའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "སྒྲ་ལ་ནི་རྐྱེན་ཐ་དད་པས་ཐ་དད་པའི་བྱས་པ་ཉིད་རྗེས་སུ་དཔག་པའི་སྒོ་ནས་གྲུབ་བ་བོ་། མངོན་སུམ་རྟགས་༥པ་མེད་པ་ཉིད་ཡིན་ན་ཇི་ལྟར་དེས་ཕྱོགས་ན་དུ་བ་བྱ་འཛིན་འདི་ལྟར་ཕྱོགས་འདི་ན་དུ་བ་ཡོད་དོ་ཞེས་ཕྱོགས་དང་འབྲེལ་པ་ཅན་དུ་དུ་བ་གཟུང་༡བར་བྱ་དགོས་ན།",
    "མངོན་སུམ་རྣམ་པར་རྟོག་པ་མེད་པ་ནི་རྟེན་དང་བརྟེན་པའི་དངོས་པོ་མི་འཛིན་ན།",
    "དེ་ལྟ་བས་ན་དེ་ལྟར་མངོན་སུམ་ནི་རྣམ་པར་རྟོག་༢ིཔ་གཉིས་ཀྱི་རྒྱུ་ཡང་ཡིན་ལ།",
    "དེ་ཇི་ལྟར་ཕྱོགས་ན་དུ་བ་ཡོད་པའི་འབྲེལ་པ་ཡོངས་སུ་གཅོད་པར་མི་འགྱུར་ཏེ།",
    "དེ་ཡང་རྣ་མ་པར་མི་རྟོག་བཞིན་དུ་མངོན་སུམ་ལ་སྲིད་ན་ཇི་ལྟར་མི་འཛིན་ཅེས་བྱ་བ་ནི་བསྡུས་པའི་དོན་ཡིན་ནོ།",
    "དེའི་སྟོབས་ཁོ་ནས་རྣམ་པར་རྟོག་༢པ་སྐྱེའོ།",
    "རྣམ་པར་རྟོག་༦པ་ནི་ཇི་ལྟར་ཡོངས་སུ་མཐོང་བའི་རྣམ་པ་འཛིན་པ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ག་ལས་སྙམ་པ་ལ།",
    "དེ་མཐོང་ནས་ཕྱིས་རྣམ་པར་རྟོག་༩པ་འཇུག་པ་གང་ཡིན་པ་དེ་༡༧ནི་དོན་བྱ་བ་བྱེད་པའི་དངོས་པོ་མ་མཐོང་བ་ཅུང་ཟད་ཀྱང་རྟོགས་པ་མེད་དོ།",
    "ཇི་ལྟར་རྗེས་སུ་དཔག་པས་དོན་བྱ་བ་བྱེད་པའི་དངོས་པོ་མ་མཐོང་བ་རྟོགས་པ་ལྟར་རྣམ་པར་རྟོག་པ་ནི།",
    "དེ་ལྟ་མ་ཡིན་ནོ་སྙམ་དུ་དགོངས་པའོ་། དེ་ལྟ་བས་ན་རྣམ་པར་རྟོག་པ་ནི་དོན་བྱ་བ་བྱེད་པའི་དངོས་པོ་མ་མཐོང་བ་༐",
    "དོ་། ༤འཇིག་རྟེན་ནི་ཕལ་ཆེར་རྣམ་པར་རྟོག་པ་དང་བཅས་པས་ལྷས་བྱིན་གྱིས་བྱས་ས་སོ།",
    "ཡང་ན་གཞན་གྱིས་བྱས་སོ་ཞེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པ་སྨྲའོ།",
    "དེའི་སྟོབས་ཀྱིས་ཕྱིས་རྣམ་པར་རྟོག་༡༧པའི་ཤེས་པ་སྐྱེ་བ་གང་ཡིན་པ་དེས་༐",
    "དཔེར་ན་མངོན་སུམ་གྱིས་སྔོན་པོ་མཐོང་ནས་ཕྱིས་འདི་བྱ་སྙམ་དུ་འདི་ནི་སྔོན་པོའོ་སྙམ་དུ་རྣམ་པར་རྟོག་པའི་ཤེས་པ་སྐྱེ་བ་གང་ཡིན་པ་དེ་ལ་སྣང་བའི་སྤྱི་གང་ཡིན་༐",
    "རྣམ་པར་རྟོག་༢པའི་ཤེས་པའི་གཟུང་བ་སྤྱི་དོན་བྱ་བ་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ག་ལས་སྙམ་པ་ལ།",
    "དེ་ལྟ་བུས་བསྒྲུབ་པར་བྱ་བ་སྟེ།",
    "འདི་ནི་དེ་ལྟ་བུས་བསྒྲུབ་པར་བྱ་བ་ཡང་ཡིན་ལ།",
    "དེ་ལྟ་བུས་བསྒྲུབ་པར་བྱ་བ་དོན་བྱ་བ་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ལ་རྣམ་པར་རྟོག་པས་ཅི་ཞིག་བྱེད་པར་༦འགྱུར།",
    "སྔོན་པོའི་སྤྱི་ཡང་བྱ་བ་བྱེད་པར་གྱུར་ན།",
    "ཡང་གནོད་པ་ཅི་ཡད་སྙམ་དུ་སེམས་པར་འགྱུར་བས་དེའི་ཕྱིར།",
    "འདི་ལྟར་སྤྱི་ནི་རྟག་པ་འམ་བརྟགས་༩བྱ་པ་ཞིག་ཡིན་པར་ཁས་བླངས་གྲང་ན།",
    "རྟག་པ་ནི་ཤེས་པའི་ངོ་བོ་ཙམ་གྱི་དོན་བྱེད་པར་༡ཡང་མི་འཐད་ད་དེ།"
  ]
}