    "འཇག་སྐྱ་དབུ་རུ་ཟར་བའི་ས་ཆ་ཞིག་ཏུ་བསླེབས་ནས་ཅི་བྱ་བཏོལ་མེད་ཅིང་ཡིད་སློང་སློང་པོར་ཡོད་ཙ་ན།",
    "ཨ་ཙི་འཇིགས་པ་ལ།",
    "ཆེ་ཐབས་དང་སྙན་གྲགས་བསྒྲུབ་པ་ལ་སོགས་ཅི་དང་ཅི་བྱས་ཀྱང་ཡིད་བརྟན་དང་བློ་ལྟོས་རུང་བ་མི་འདུག།",
    "ཡང་རང་ཉིད་གང་ནས་ཕྱིན་ཆ་མེད་པའི་ལུང་པ་ཐག་རིང་ངོ་མི་འཚལ་བ་ཞིག་ཏུ་སླེབས་གར་འགྲོའི་གཏད་སོ་མེད་པར་ཐོམ་ཐོམ་ཡོད་ཙ་ན།",
    "ཚེ་ཟད་ལོང་མེད་པར་འཆི་བ་བཙན་ཐབས་སུ་བསླེབས་ནས་གདའ།",
    "ད་ནི་འབྲོས་ས་ཡང་མི་འདུག་སྙམ་ནས་ངུ་སྐད་ལྷང་ལྷང་འབོད་པའི་ཚེ།",
    "སྟོབས་ལྡན་གྱི་འདབ་ཆགས་འཇིགས་པ་ཅན་འདི་ལྟ་བུས་བདག་ཉིད་གསོན་ཟས་བྱེད་པ་ཨ་ཙི།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་ལྷ་ཡི།",
    "རང་ཉིད་ཐོག་མ་མེད་པ་ནས་གོམས་པའི་ལས་ཉོན་གྱི་མཐུས་སྐྱོན་དུ་ཤར་བར་འདུག།",
    "ཅི་ལྟར་མཛད་ཀྱང་རང་སྐྱོན་གྱི།",
    "རང་བྱུང་རང་ཤར་གྱི་རྒྱུད་ལས།",
    "ཁ་རོག་འདུག་ལ་མཁས་པ་དང་།",
    "ཞེས་གསུངས་འདུག་པས་ཧ་བྷོ་ཧ་བྷོ་ང་ནི་མེད་དོ།",
    "དབུགས་འཐུམས་པ་དང་མས་ཟས་གོས་སྤྱོད་ལམ་ཉེས་པ་ན་མེའི་ནང་ན་འདུག་པ་ལྟར་ཚ་བ་དང་།",
    "དགྲ་དང་དེའི་ཕྱོགས་ལ་སྡང་ཞེན་མི་བཟད་པར་བྱེད་པ་འདི་ཡང་མ་བརྟགས་པའི་སྐྱོན་དུ་འདུག།",
    "རྒྱལ་པོ་རོལ་པའི་འདུག་སྟངས་ཅན།",
    "ཐམས་ཅད་ཀུན་ཀྱང་རང་བྱུང་བདེ་བའི་ཞིང་།",
    "འདི་ཀུན་ཤར་ཡང་རང་བཞིན་འགག་མེད་དེ།",
    "གང་སྣང་རང་བཞག་བྱ་རྩོལ་བྲལ་ན་མངོན།",
    "མི་འགྱུར་མཉམ་པའི་དོན་ལས་གཞན་དུ་མེད་། དེ་ཡང་རང་བྱུང་ངང་འདིར་ལྷུན་གྲུབ་པས།",
    "གཉིས་སུ་མེད་པ་ངོ་བོའི་འདུག་ཚུལ་ཏེ།",
    "ཟ་འཆག་ཉལ་འདུག་ཉིན་ཞག་ཕྱམ་གདལ་བས།",
    "ད་ལྟ་སེམས་ལས་གང་བྱུང་རང་ཞིར་གློད།",
    "མཉམ་པར་གྲོལ་ཡང་རང་བྱུང་ཡེ་ཤེས་ཀློང་།",
    "རྒྱལ་བའི་དགོངས་ཀློང་རང་བཞིན་ཡངས་པའི་མཆོག།",
    "དྲན་དྲན་བབསམ་ཐམས་ཅད་རང་བྱུང་རང་ཞི་ན།",
    "རང་བཞིན་བར་མ་འགྲོ་འདུག་གྱིན་འདར་གནས།",
    "གཉིད་ཀྱང་རང་བྱུང་གདོད་མའི་ཀློང་ཆེན་ཏེ།",
    "ཁྱེད་ཅག་ཅི་བྱ་ང་ནི་གང་ན་འདུག།",
    "སྐུ་དང་ཡེ་ཤེས་ལྷུན་གྲུབ་ཉི་མ་ཤར་། གཞན་ནས་མ་འོང་རང་སྣང་དག་པ་ཙམ།",
    "ལུས་ནི་འགྲོ་དང་འདུག་པ་དང་།",
    "དེས་དུབ་ན་ཕྱི་མ་མི་འགྱུར་རྡོ་རྗེའི་འདུག་སྟངས།",
    "དེས་ཡུལ་སྣང་རང་བཞིན་མེད་པར་གྲོལ་བའི་དགོས་པ་ཡོད་དོ།",
    "དེ་ལྟར་གནས་ལུགས་རང་གནས་ཆེན་པོའི་རྒྱུན་བསྐྱངས་པའི་ཚེ་རིག་པ་དེའི་ངོ་བོ་སྟོང་པར་འདུག་སྙམ་ན།",
    "ཀུན་མཁྱེན་གྱིས་ཁ་ཅིག་རྐང་མཐིལ་ས་ལ་ཕབ་ནས་ཙོག་པུར་འདུག་པའི་གཡས་གཡོན་གཉིས་སུ་ལག་པའི་མཐིལ་ས་ལ་འཛུགས་པར་འདོད་དེ།",
    "རང་སྣང་རང་བཞིན་མེད་པར་ཤེས་པར་གྱིས་ལ་བཙན་ས་ཟུངས་ཤིག།",
    "སྐད་ཅིག་མ་དང་པོར་རང་སྣང་རང་བཞིན་མེད་པར་ཡིད་ཆེས།",
    "དཔེར་ན་མུ་མེན་གྱི་ཕོར་བ་ཁ་སྦུབ་པ་ལྟ་བུ་ལ་ཡེ་ཤེས་ཀྱི་གཏིང་མདངས་དང་ལྡན་པ་ཤིན་འ་ལ་འཚེར་བ་དེ་ཡངཔང་རང་བཞིན་གྱི་ཐིག་ལེ་ལྔ་ལྔས་བརྒྱན་ཏུ་གསལ་༩པའོ་། ཡང་དེའི་སྟེང་དུ་དཀར་པོའི་སྣམ་བུའི་སྟེང་དུ་ཐིག་ལེ་ཤིན་ཏུ་གསལ་བ་དཔེར་ན་ཤེལ་གྱི་ཕོར་བ་ཁ་སྦུབ་པ་ལྟ་བུ་ཡེ་ཤེས་ཀྱི་གཏིང་མདངས་དང་བཅས་པ་སྔ་མ་ལྟར་འཆར་རོ།",
    "དེ་བས་ན་སྣང་བ་ལ་ཤེས་པ་ཤར་ནས་དེར་འདུག་གོ་སྙམ་དུ་ཡུལ་རྟོག་པའི་ཡུན་ལ་རྣམ་གྲོལ་གྱི་སྐད་ཅིག་ཏུ་བྱེད་ལ།",
    "རྩེ་གཅིག་སྤྲོས་བྲལ་རོ་གཅིག་སྒོམ་མེད་ལ་སོགས་པའི་རྣམ་གཞག་གཙོ་བོར་ཕྱག་རྒྱ་ཆེན་པོའི་ཕྱོགས་ལ་གྲགས་ཆེ་བར་འདུག་པས་མི་ལའི་མགུར་ནའང་གསལ་ཞིང་།",
    "རློམ་པ་ཆེ་བ་དག་སྒོམ་མེད་དམ་དེ་འདི་ག་ཡིན་སྙམ་ནས་འགྲོ་དོན་ལ་རིངས་ནས་གཡེང་བས་ཁྱེར་བའང་འདུག་གོ།",
    "བློས་མ་བྱས་པའི་ཡེ་ཤེས་ཀྱི་ངོ་བོར་བསྒོམ་བྱ་རྡུལ་ཙམ་མི་འདུག་པ་ལ་སྒོམ་བྱེད་གང་ནས་རྙེད།",
    "འཇོག་རྒྱུ་ནི་མེད་དེ་ལྷུན་གྲུབ་ཏུ་འདུག་གོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་བློ་ལས་འདས་པ་ཡང་འདི་གར་འདུག་གོ།",
    "རྫོགས་པ་ཆེན་པོ་གདོད་ནས་རྣམ་དག་ཀྱང་འདི་གར་འདུག་གོ།",
    "དེ་ལྟ་ནའང་ལྷག་མཐོང་གསལ་བའི་ཡེ་ཤེས་ཀྱི་རྩལ་མ་རྫོགས་པས་སྔར་གྱི་ཀུན་གཞིའི་སྦུབས་སུ་འཐུམས་ནས་འོད་གསལ་གྱི་མར་མེ་དེ་ནི་ཤི་ནས་མི་འདུག་གོ།",
    "སྐུ་གསུམ་འདུ་འབྲེལ་མེད་པའི་ངང་དུ་ཉིན་མཚན་རིས་མེད་དུ་ལ་བཟློས་པ་ཞིག་ལ་ཟེར་བ་གདའ་སྟེ།",
    "འགྱུ་བའི་དབུགས་ཀྱང་རང་སོར་ཀློད",
    "རྣམ་རྟོག་ཁོ་རང་གྲོལ་བ་སྦྲུལ་གྱི་མདུད་པ་ཞིག་པ་ལྟར་གྲོལ་བ།",
    "གནས་འགྱུ་གང་ཡིན་ཡང་འདྲ་སྟེ་ངོ་ཤེས་མཁན་ཁོ་རང་ཡུལ་མེད་མཐའ་བྲལ་དུ་མ་སངས་ན།",
    "ད་ལྟ་ལམ་དུས་སུའང་དཔེར་མཚོན་ན་སྡུག་བསྔལ་དང་འཇིགས་སྐྲག་ལྟ་བུའི་རྣམ་རྟོག་དེས་དྲག་པ་ཤར་བའི་ཚེ་རྣམ་རྟོག་ཁོ་རང་ངོ་ཤེས་པ་ཙམ་གྱིས་ཁྱེད་ཀྱི་སྡུག་བསྔལ་དང་འཇིགས་སྐྲག་མཐའ་གྲོལ་དུ་སང་བ་དེ་དགོད་འཆོར།",
    "མགྲིན་པ་འདི་གདམས་པའི་བང་མཛོད་དུ་འདུག་གོ།",
    "རྫོགས་ཆེན་ཁོས་བསླུས་ཡོང་བསམ་པ་རང་མི་གདའ།",
    "འོན་ཀྱང་རང་སེམས་མ་བཅོས་པར་བཞག་པ་ཉིད་འོད་གསལ་བའི་ཡེ་ཤེས་ཡིན་ལ།",
    "དེ་ཡང་རང་གནས་ཀྱི་ཡེ་ཤེས་རང་ལ་གནས་པ་ཉིད་ངོ་སྤྱོད་པ་ཡིན་གྱིས་གཞན་ནས་བཙལ་དུ་ཡོད་པ་མ་ཡིན།",
    "སེམས་འདུག་ན་འདུག་པའི་ཐོག་ཏུ་མ་བཅོས་པར་ཞོག།",
    "བལྟ་མཁན་བསམ་མཁན་སེམས་ཁོ་རང་ཐོག་ཏུ་མ་བཅོས་པར་ཞོགརང་སེམས་ཚུར་ལ་མ་བཞག།",
    "སྒོམ་བྱེད་སེམས་མཁན་སེམས་ཁོ་རང་ཐོག་ཏུ་མ་བཅོས་པར་ཞོག་རང་བཙལ་བས་མི་རྙེད་སེམས་ཉིད་ཡེ་ནས་སྟོང་།",
    "བཙལ་མཁན་ཁོ་རང་ཐོག་ཏུ་མ་ཡེངས་པར་ཞོག།",
    "ཨི་ཤེས་མི་ཤེས་བལྟ་རྒྱུ་གདའ་འམ་མི་གདའ་ཡིན་ནམ་མ་ཡིན་གང་བྱུང་ན་ཡང་།",
    "བསམ་མཁན་ཁོ་རང་ཐོག་ཏུ་མ་བཅོས་པར་ཞོག།",
    "སྤང་བླང་མི་བྱེད་པར་དྲན་མཁན་ཁོ་རང་ཐོག་ཏུ་མ་བཅོས་པར་ཞོག།",
    "སེམས་དགའ་སྡུག་བྱུང་དུས་དགའ་དགའ་སྡུག་སྡུག་བྱེད་མཁན་ཁོ་རང་ཐོག་ཏུ་མ་ཡེངས་ཞོག་ལ་སྡོད།",
    "ཡེ་ནས་ཡོད་པའི་སེམས་འདི་ནི་དྲན་དུས་དྲན་མི་དྲན་དུས་མི་དྲན་འདུག་འདུག་མི་འདི་ནི་རང་ཡིན་སེམས་ཁོ་རང་ཅི་དྲན་བྱུང་ན་ཡང་།",
    "མི་དགོས་པའི་སེམས་ཀྱིས་ཕར་བལྟ་ཚུར་ཉུག་མང་པོ་བྱེད་པ་གདའ་སྟེ།",
    "ཕར་ལྟ་ཚུར་ཉུག་ཅི་མི་དགོས་ཕར་ལྟ་ཚུར་ཉུག་བྱེད་མི་སེམས་ཁོ་རང་ཐོག་ཏུ་ཞོག་དང་དེ་རང་ཡིན།",
    "ཕར་བཙལ་ཚུར་ཉུག་བྱེད་པ་གདའ་སྟེ།",
    "རང་སེམས་ཡིད་མ་ཆེས་ནས་ཨི་ཡིན་མི་ཡིན་བསམ་ནས་ཐེ་ཚོམ་བྱེད་པ་ཡང་གདའ་སྟེ།",
    "ཐེ་ཚོམ་བྱུང་ན་ཐེ་ཚོམ་ཁོ་རང་ཐོག་ཏུ་ཞོག་དང་དེ་རང་ཡིན།",
    "དྲན་པའི་ཡུལ་རྒྱུ་ཟོག་ས་རྡོ་རྣམས་ལ་བལྟ་མི་ཡང་མང་པོ་གདའ་སྟེ།",
    "དྲན་མཁན་ཁོ་རང་ཐོག་ཏུ་ཞོག་ལ་ལྟོས།",
    "སྣང་བ་རང་འདེད་ཅིང་འགྲོ་མི་ཡང་གདའ་སྟེ།",
    "རྣམ་རྟོག་ཅི་བྱུང་བལྟ་འདུག་མི་ཡང་གདའ་སྟེ།",
    "སྔ་མ་དྲན་པའི་རྗེས་སུ་ལྟ་ཞིང་འགྲོ་མི་ཡང་གདའ་སྟེ།",
    "དྲན་པའི་རྗེས་མི་གཅོད་པར་གཅོད་མཁན་ཁོ་རང་ཐོག་ཏུ་ཞོག།",
    "སྒོམ་བཟང་པོ་ཞིག་འདོད་ནས་སེམས་གན་བཅར་མདུན་ཚུག་ཧྲིག་ཧྲིག་མང་པོ་བྱེད་པ་ཡང་གདའ་སྟེ།",
    "སྒོམ་ཆེན་ལ་ལས་གང་དྲན་མི་བཅུག་པར་ཤེད་ཕྱུང་ནས་སེམས་བཟུང་འདུག་མི་ཡང་གདའ་སྟེ།",
    "སྒོམ་ཆེན་ལ་ལས་ལས་ཁྱད་གསོད་ལྟར་སེམས་ཧང་ཧང་བྱེད་འདུག་པ་གདའ་སྟེ།",
    "ངན་པ་བཙོག་པོ་དྲན་བྱུང་དུས་མི་བལྟ་མཁན་ཡང་གདའ་སྟེ།",
    "སྒོམ་ཆེན་ལ་ལས་དགོས་མི་དགོས་མེད་པར་སྒྲིམ་ལྷོད་གང་ཡ་ཡང་མི་བྱེད་པ་གདའ་སྟེ།",
    "ཡར་ལངས་ནས་ཟས་སྐོམ་ཞིམ་མངར་ཅན་ཞིག་ཨི་ཐོབ་མི་ཐོབ་བྱེད་ནས་ཟས་སྐོམ་ཞིམ་མངར་ལ་ལོངས་སྤྱོད་པ་གདའ་སྟེ།",
    "མ་བཞག་བཏང་ཡང་རང་སར་འཁོར།",
    "རྟོགས་པར་འདུག་གམ་རྟོགས་ལྡན་རྣམས།",
    "ཤེས་པར་འདུག་གམ་སྒོམ་ཆེན་རྣམས།",
    "སྒོམ་ཆེན་འདུག་པའི་དུས་སུ་ནི།",
    "འགྲོ་འདུག་ཉལ་བ་ཅི་བྱེད་ཀྱང་།",
    "རང་སེམས་འདི་ནི་རྟོགས་མི་མང་པོ་གདའ།",
    "ཡང་དག་དོན་ནི་རྟོགས་མི་མང་པོ་གདའ།",
    "ཉམས་རྟོགས་མ་སྐྱེས་མིའང་མང་པོ་གདའ་། ཡང་དག་དོན་ནི་མ་རྟོགས་མང་པོ་གདའ།",
    "མིན་པ་ཡིན་སྣང་བྱེད་མི་མང་པོ་གདའ།",
    "མི་ཤེས་བླུན་སྒོམ་བྱེད་པ་མང་པོ་གདའ་། དོན་མེད་བརྩོན་འགྲུས་བྱེད་པ་མང་པོ་གདའ།",
    "དེ་འདྲའི་དོན་ཤེས་མཁན་དང་མི་བསམ་པར་འདུག་མཁན་ཁོ་རང་ལ་བབ་ཀྱིས་བལྟས་པས།",
    "དབྱིབས་དང་ཁ་དོག་ལ་སོགས་ཇི་ལྟར་འདུག།",
    "བཞག་དུས་ས་ཐ་ཐ་མལ་ཤེས་པ་རྗེན་ནེ་བ།",
    "དེ་ཡང་རང་བྱུང་རིག་པའི་ཡེ་ཤེས་འདི།",
    "རང་སེམས་ཉིད་ལ་འགྲོ་འོང་ཨེ་འདུག་ལྟོས་། བལྟས་ཚེ་འགྲོ་འོང་སེམས་ལ་མི་གདའ་ན།",
    "རྟོགས་པ་འཕྲོ་བའི་འཕྲོ་མཁན་ཨེ་འདུག་ལྟོས་། རྟོག་པ་འཕྲོ་བའི་འཕྲོ་མཁན་མི་གདའ་ན།",
    "སེམས་ལ་ཁ་དོག་དབྱིབས་སོགས་ཨེ་འདུག་ལྟོས།",
    "སྟོང་པ་ཉིད་ལ་མཐའ་དབུས་ཨེ་འདུག་ལྟོས།",
    "མཐའ་དབུས་མེད་ཚེ་ཕྱི་ནང་ཨེ་འདུག་ལྟོས།",
    "སྣང་སྟོང་གྲགས་སྟོང་རང་བཞིན་ཡེ་ནས་སྟོང་།",
    "རྨི་ལམ་གཉིད་ཀྱི་སྐབས་སུའང་རང་ང་བཞིན་མེད།",
    "ཕྱི་རོལ་འགྱུར་བ་མེད་ཀྱང་རང་སྣང་འགྱུར།",
    "སྣང་ཡང་རང་བཞིན་ཡེ་ནས་སྟོང་པའོ།",
    "ཁྱེད་རང་རྣམས་ལ་སྔོན་ལ་གནོད་པ་བསྐྱལ།",
    "དབྱིབས་དང་ཁ་དོག་ལ་སོགས་ཨེ་འདུག་ལྟོས།",
    "དབྱིབས་དང་ཁ་དོག་ལ་སོགས་ཨེ་འདུག་སྟོས།",
    "གང་དུ་གནས་དང་ཐ་མ་གང་དུ་འགྲོ་། དབྱིབས་དང་ཁ་དོག་ལ་སོགས་ཨེ་འདུག་ལྟོས།",
    "དབྱིབས་དང་ཁ་དོག་ལ་སོགས་ཨེ་འདུག་ལྟོས།",
    "དབྱིབས་དང་ཁ་དོག་ལ་སོགས་ཨེ་འདུག་ལྟོས།",
    "ལྟ་བ་འདི་ཉིད་ངེས་པར་ཡིན་པར་འདུག།",
    "ཐམས་ཅད་ཡེ་ཟིན་འདུག་སྟེ་ཡང་བྱེད་དོ།",
    "ཡེ་གྲོལ་ཉིད་དུ་འདུག་སྟེ་ཡང་དགྲོལ་ལོ།",
    "ཡེ་བཞག་ཉིད་དུ་འདུག་སྟེ་ཡང་འཇོག་གོ།",
    "ཡེ་ལྟོས་ཉིད་དུ་འདུག་སྟེ་ཡང་བལྟའོ།",
    "ཡེ་བགྲོད་ཉིད་དུ་འདུག་སྟེ་ཡང་བགྲོད་དོ།",
    "འགྲོ་དང་འདུག་དང་མཆོངས་དང་རྒྱུག་པ་དང་།",
    "མཐར་ནི་ཞི་ཞིང་བདེ་བའི་ངང་ལ་འདུག།",
    "ཞེ་སྡང་རང་སར་དག་པའི་ངོ་བོ་ཉིད།",
    "ལམ་སྲུང་རང་བཞིན་ཐིག་ཆེན་གདབ་པ་དང་།",
    "ཡུལ་རྐྱེན་བྲལ་བ་ནམ་མཁའ་གཡའ་དག་དུས།",
    "ཡེ་ནས་མ་བྱས་རང་བྱུང་རང་ཤར་བའི།",
    "ཇི་ལྟར་སྣང་ཡང་རང་བཞིན་མ་གྲུབ་པར།",
    "བདེ་བའི་མལ་དུ་དྲང་སྲོང་འདུག་སྟངས་བྱ།",
    "འདུག་སྟངས་བཅས་ཏེ་སྤྱི་བོའི་ནམ་མཁའ་ཡི།",
    "ལིང་ངེར་འདུག་པར་བསྒོམས་ལ་སེམས་བཟུང་ངོ།",
    "འདིའི་དུས་འདུག་སྟངས་ལྟ་སྟངས་ལ་སོགས་ཀྱིས་། ཆེད་དུ་མ་བསྒོམས་ན་ཡང་འབྲེལ་བ་མེད།",
    "འདུ་འཛིའི་ནང་དུ་མི་འདུག་པར་། རི་དྭགས་བཞིན་དུ་དབེན་པ་རུ།",
    "འདུག་ས་སྡོད་བདེ་འགལ་རྐྱེན་མེད།",
    "དེ་ནས་འདུག་སྟངས་གསུམ་པོ་ཡི།",
    "འདུག་སྟངས་གཙོ་བོར་བྱ་བ་ཡིན།",
    "དྲང་སྲོང་འདུག་སྟངས་གཙོ་བོར་བྱ།",
    "སེང་གེའི་འདུག་སྟངས་གཙོ་བོར་བྱ།",
    "སྔ་དྲོ་གླང་པོའི་འདུག་སྟངས་བྱ།",
    "དགུང་ལ་སེང་གེའི་འདུག་སྟངས་བྱ།",
    "ཕྱི་དྲོ་དྲང་སྲོང་འདུག་སྟངས་བྱ།",
    "སྲོད་ལ་དྲང་སྲོང་འདུག་སྟངས་བྱ།",
    "ནམ་དགུང་གླང་པོའི་འདུག་སྟངས་བྱ།",
    "འདུག་སྟངས་དག་ལ་བསླབ་ཀྱང་མཆོག།",
    "རྒྱུན་དུ་སྐུ་གསུམ་འདུག་སྟངས་གྱིས།",
    "སེམས་ལས་མ་བྱུང་རང་བྱུང་ཡེ་ཤེས་སྐུ།",
    "བཞུགས་གང་རང་འདྲའི་བློ་རྟུལ་རྣམས་ཀྱི་ངོར།",
    "ད་ལྟར་གྱི་ཤེས་པ་ཡང་དག་རྣལ་མར་ཙན་གྱིས་ཞོགདེ་ལ་འདས་པའི་རྗེས་མི་དཔྱོད་ཟེར་ཙ་ན།",
    "མ་འོངས་པའི་སྔོན་མི་བསུ་ཟེར་ཙ་ན།",
    "ད་ལྟར་གྱི་ཤེས་པ་རྣལ་མར་ཙན་གྱིས་ཞོག་ཟེར་ཙ་ན།",
    "དེ་དུས་ལུས་ཅོག་གེར་འདུག་ཀྱང་དོན་མེད་སྟོང་འདུག་ཡིན།",
    "ནོར་ཕྱུགས་རྣམས་རྩྭ་ཆུ་ཡོད་པའི་ཕྱོགས་སུ་བཞག་ནས་འགྲོ་འདུག་གང་བྱེད་ཀྱང་བྱེད་དུ་བཅུག་ཅིང་།",
    "སྔར་གྱི་གཉེན་པོ་ཐམས་ཅད་རྣམ་རྟོག་སྐྱེས་འདུག་པས་མ་ཡེངས་པར་བྱེད་དགོས་སྙམ་པ་སོགས་བྱ་རྩོལ་སྤོང་ལེན་གྱི་སྤྲོས་པས་བསླད་པའི་བཟུང་དྲན་ཁོ་ན་སྟེ།",
    "ལུས་སེམས་ཡོད་དུ་མི་ཚོར་བར་བར་སྣང་སྟོང་པ་ལ་འདུག་པ་ལྟ་བུ་དང་།",
    "རྣམ་པར་རྟོག་པ་ཕྲ་རགས་གང་ཡང་རུང་བ་སྐྱེས་པ་དང་དེ་ངོ་ཤེས་པའི་དྲན་རིག་དུས་མཉམ་དུ་ལངས་ནས།",
    "གནས་ན་གནས་པའི་ངོ་བོ་ཇི་ལྟ་བུ་ཞིག་འདུག་ཚུལ་ཇི་ལྟར་གནས།",
    "འགྱུ་བའི་ཚེ་གནས་པ་ཨེ་འདུག་འགྱུ་བ་དེ་གནས་པ་ལས་གཞན་པ་ཞིག་ཡིན་ནམ་མིན།",
    "འགྱུ་བ་དེ་ཀའི་ངོ་བོ་ངོས་བཟུང་ཇི་ལྟ་བུ་ཞིག་འདུག་མཐར་འགྱུ་ཆ་འགག་པའི་ཚུལ་ཇི་འདྲ་ཞེས་དཔྱད།",
    "གནས་དུས་འགྱུ་མཁན་སོགས་འདུག་སྙམ་ན།",
    "འགྲོ་དུས་གཅིག་འགྲོ་གཅིག་འདུག་གམ།",
    "མཉམ་འགྲོ་མཉམ་འདུག་ཇི་ལྟར་བྱེད་བལྟ།",
    "ཡང་གནས་དུས་འགྱུ་བ་མིན་འདུག་ཅིང་།",
    "འགྱུ་དུས་ཀྱང་གནས་པ་མིན་འདུག་པས་དེ་གཉིས་གཅིག་གོ་སྙམ་ན།",
    "འགྱུ་ཆའི་རྣམ་རྟོག་མེད་དུས་གཅིག་པར་འདུག་གམ།",
    "ཡོད་དུས་གཅིག་པར་འདུག་མེད་དུས་གཅིག་པར་འདུག་སྙམ་ན།",
    "ཁོང་གཉིས་འདྲེས་པའི་ཚུལ་དུ་གཅིག་པར་འདུག་གམ་སོགས་དཔྱད།",
    "རྣམ་རྟོག་ཡོད་དུས་གཅིག་པར་འདུག་སྙམ་ན།",
    "དེའི་ཚེ་བལྟ་བྱ་དང་ལྟ་བྱེད་དབྱེར་མེད་པའི་ཤེས་པ་གསལ་སྟོང་རང་རིག་རང་གསལ་ཙམ་ཞིག་ཉམས་སུ་མྱོང་བ་འབྱུང་།",
    "ཤེས་རབ་ཁོ་རང་ཡང་དམིགས་པ་མེད་པའི་ངང་དུ་ཞི་ཚུལ།",
    "སྔ་མ་དེ་ལ་གནས་འགྱུ་ངོ་ཤེས་པའི་གསལ་ཆ་ཡོད་ཀྱང་རང་ངོ་ཤེས་པའི་རིག་ཆ་མེད་ལ།",
    "དེ་སྐབས་སྣང་བ་ཐམས་ཅད་སྣང་ཙམ་གྱི་དུས་ཉིད་དུ་སེམས་ཉིད་དུ་རྟོགས་པ་ནི་སྣང་ཐོག་ཏུ་སེམས་ཀྱི་འདུག་ཚུལ་རིག་པ་ཞེས་བྱ་ལ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲོད་པ་དང་།",
    "དང་པོ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲད་པ་ནི།",
    "རང་སར་རང་ངོ་ཤེས་ཤིང་རང་གྲོལ་བ་ལ་ཕྱག་རྒྱ་ཆེན་པོ་ཟེར་བ་ཡིན་ནོ།",
    "མ་བཟུང་མ་བཏང་རང་ག་ཉིད་དུ་ཞོག།",
    "རྩེ་གཅིག་དུས་སུ་ངོ་བོ་རྟོགས།",
    "རོ་གཅིག་དུས་སུ་མཉམ་རྗེས་འདྲེས།",
    "རྩེ་གཅིག་དུས་སུ་གཟུགས་ཀྱི་ཕུང་པོ་དང་བྲལ།",
    "ཡུམ་གཡོ་སྒྱུ་ཆུང་ཞིང་རང་བཞིན་བཟང་བ།",
    "ད་ལྟ་རྒྱལ་རོང་བྲག་ལྷ་མགོན་པོ་དང་སྤྲུལ་པའི་སྐུ་འདི་གཉིས་ཀྱི་འདྲེན་སྟོབས་ཆེ་བ་སུ་ཡང་མི་འདུག།",
    "ཡང་སྦྱིན་དཔལ་ཞེས་པའི་གྲྭ་བ་དེ་ལ་མར་རྒྱ་དོ་གནང་བ་ཁོས་ཟླ་བ་མང་པོའི་རིང་ལ་ཟོས་ཀྱང་མ་ཟད་གཞན་ལ་སྦྱིན་རྒྱུ་སོགས་བྱུང་བས་ཁོ་རང་ངོ་མཚར་བའི་གནས་སུ་གྱུར།",
    "བདག་ཁྱེད་རང་གཉིས་བར་གྱི་ལྡེའུ་མིག་ལྟ་བུ་ཡིན།",
    "ད་ལྟ་ཁྱེད་གཉིས་མཉམ་དུ་འཛོམས་ན་བསྟན་དང་འགྲོ་ལ་ཕན་པ་རྒྱ་ཆེན་འབྱུང་ཚུལ་རྣམས་གཏེར་ལུང་ཐམས་ཅད་ན་ཡོད་ཚོད་འདུག།",
    "གཏེར་འདོན་པའི་ལྡེའུ་མིག་ང་རང་ཡིན།",
    "རྫས་རིན་ཆེན་སྒྲོམ་བུའི་བཅུད་དུ་གདའ།",
    "ཞིབ་ཏུ་ཉན་ན་ཏཱར་པོའི་ཕྱོགས་སུ་གྲགས་འདུག་པས་དེ་ནི་མི་བཟང་བའི་རྟགས་ཞིག་ཡིན་པར་གསུངས།",
    "ད་ང་འདི་ལྟ་བུ་ལ་ཐུག་དུས་གླེགས་བམ་འདི་རྣམས་ཐོན།",
    "ཞེས་པ་ལྟར་འཇིག་རྟེན་འདི་ནས་འདུག་ཐབས་མེད་པ་ཙམ་ལ་ཐུག་འདུག།",
    "བྲིས་ན་འཕྲལ་ཡུན་དགོས་དོན་མི་འདུག་ཀྱང་།",
    "བཾ་ཡིག་དམར་པོའི་ཡིག་འབྲུ་འདུག་པའི།",
    "དེང་འདིར་སྒྱུ་མ་རྨི་ལམ་བཞིན་དུ་རང་གྱུར་འདུག།",
    "རང་སར་རང་བབ་ངང་དུ་རྗེན་ལྷག་གེར་གནས་འདུག།",
    "དོན་ལ་རིག་སྟོང་བློ་བྲལ་རང་ས་དེ་ཟིན་འདུག།",
    "ཡིད་འཛིན་རིན་ཆེན་ག་འུའི་སྣོད་བཟང་དུ་བསྐྱིལ་འདུག།",
    "ཀུན་བཟང་གདོད་མའི་ས་ལ་ཐག་རིང་ནི་མི་འདུག།",
    "ང་ཅག་ཇི་ལྟར་བྱས་ཀྱང་བདེ་དགའི་ངང་གནས་འདུག།",
    "དཔལ་བདེ་མཆོག་སྒྲུབ་པའི་ཟབ་བཅུད་གདའ།",
    "གྲོགས་ཁྱེད་ལ་འབྲལ་སྙམ་ཡེ་མི་འདུག།",
    "བྲུན་ནག་གཏོར་བ་ལྔ་དྲུག་དུས།",
    "ཞ་འཕྱེའི་མི་བཞིན་འགྲོ་འདུག་ཉུང་བར་མཛོད།",
    "མཛོད་དང་རང་གཞན་དོན་གཉིས་ལྷུན་གྲུབ་འགྱུར།",
    "དེང་འདིར་དུས་སུ་བབ་འདུག།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ནའི་སྒྱུ་འཕྲུལ་མཁན་སྤྲུལ་པདྨ་འཇིགས་མེད་བདེ་ཆེན་གཉིས་མི་འགྱུར་གསེར་གྱི་ཁྲི་ལ་མངའ་གསོལ་བའི་མཛད་སྒོ་ཆེར་རྒྱས་སུ་སྤྲོས།",
    "ཚེས་ཉེར་ལྔ་ལ་རྩོད་ལྡན་སྙིགས་མའི་རང་མཚང་ཕྱི་རུ་རྡོལ་ཞིང་རང་རྒྱུད་ལོག་ལྟས་བསླད་པའི་མི་བསྲུན་སྐྱེ་བོ་ངན་པས་རྗེ་འདི་དང་གཞན་གངས་ལྗོངས་བསྟན་འཛིན་སྐྱེས་ཆེན་འགར་ངན་སྨྲས་གླེང་བརྗོད་དུ་མ་བྱས་པ་ཐོས་བས་རྒྱུད་བསྐུལ་ཏེ་སྨད་པ་ལམ་ཁྱེར་གྱི་གདམས་པ་འདི་གསུངས་སོ།",
    "མི་སྨྲ་ལྐུག་པ་བཞིན་དུ་འདུག་པ་ནི་དམ་བཅའ།",
    "བདེན་མེད་སྒྱུ་མའི་དམག་ལ་སྐྲག་སྣང་ནི་མི་གདའ།",
    "སྟོང་གསུམ་དགྲ་རུ་ལང་ཡང་ཡ་ང་བ་མི་འདུག།",
    "ཡེ་གནས་རང་བྱུང་རིག་པར་འཕོ་འགྱུར་ནི་མི་འདུག།",
    "རྣམ་རྟོག་འཕྲོ་འདུ་རྗེས་དེད་དགོས་དོན་ནི་མི་འདུག།",
    "དགུན་དུས་ཀྱི་གྲངས་ལྷགས་ཀྱང་རང་སར་ཞི་སྟེ་དབྱར་དུས་ལྟར་དྲོད་ད་རྒྱས།",
    "གདུང་དང་རངས་བསྲེལ་གདུལ་བྱའི་སྐལ་བར་བཞག་ཨེ་མ་མགོན་དེས་ལེགས་བྱས་རྣམ་དཀར་གཟི།",
    "གཉིད་ལས་སད་ཅིང་ཉམས་སྣང་རང་སར་ཡལ་ལ",
    "ཨ་ར་པ་ཙ་ན་དང་ཧྲཱི་ཡིག།",
    "རྫ་ས་སྒྲོམ་ལྔ་དང་རང་བྱུང་བུམ་པ།",
    "ཉམས་རྟོགས་རྒྱས་ཤིང་རང་རིག་ཞལ་མཐོང་།",
    "དེ་ལ་ཉན་ཐོས་དང་རང་རྒྱལ་བ་དང་།",
    "གང་གཞུའི་དབྱིབས་ལྟར་འདུག་པའམ།",
    "རྒྱུ་དང་རྐྱེན་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ།",
    "༦༥ལན་དུ་མ་བསྐོར་བ་བྱས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་གནང་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་སྟེ།",
    "གཡོག་དང་བཅས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་ནས།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ལུས་བཏུད་ནས་འདུག་སྟེ།",
    "ཡང་དེའི་ཚེ་ལྷའི་བུ་བཟང་སེམས་ཞེས་བྱ་བ་འཁོར་དེ་ཉིད་དུ་འདུས་པར་གྱུར་ནས་འདུག་པ་དེས།",
    "༧ གཡུང་པེ་འདུག་གཡུང་པེ་ཏེ།",
    "སྤྲིན་དང་ཆར་རྣམས་གདའ་བར་གྱུར།",
    "སོ་སོའི་ལུས་ལ་བརྒྱན་པ་གདའ།",
    "དྲི་ཟ་ལ་སོགས་པ་འཁོར་གྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་འདུག་པ་ལས་ལངས་ནས་ཅི་ནུས་སུ་སོ་སོ་ནས་གསེར་དང་དངུལ་དང་།",
    "བཟོ་ཤིན་ཏུ་མཁས་པས་ལས་སུ་བྱས་པའི་གཞལ་མེད་ཁང་ཆེན་པོར་སྔོན་རྒྱལ་པོ་སྔ་མ་འདུག་འདུག་པའི་ཁྲི་ལ་བཞག་ནས་རྒྱལ་པོར་བཅུག་གོ།",
    "༦༥༣༡༨ཕ་རོལ་པོ་རིགས་ཀྱི་བུ་དེ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པ་ཡང་རང་བཞིན་ལ་ཤིན་ཏུ་ཐབས་མཁས་པས་མཁྱེན་པའི་ཡེ་ཤེས་དང་ལྡན་པས་བདུད་སྡིག་ཅན་མ་རུངས་པ་དང་།",
    "འདི་སྙེད་ཀྱི་བར་དུ་འདུག་འདུག་གོ།",
    "ཆུང་ངུ་ན་དུག་བྱིན་པས་མངལ་ན་འདུག་པ་བསད་པ་སྟེ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཨུ་པ་ལིས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་འདི་དག་ཐོས་ནས་འདུག་པ་ལས་ལངས་ཏེ།",
    "ཡོན་ཏན་ལྔ་ཕྲུགས་དང་ལྡན་པ་གཅིག་འདུག་པ་ལས་ལངས་ཏེ།",
    "ཇི་སྟེ་འདུག་པ་ཞིག་ཡོད་ན་ཡང་མི་འདོད་ཅིང་གཏོང་བའི་བསམ་པ་སྐྱེས་པས་བསྐྱབ་ིཅིང་བསྲུང་བའི་སེམས་མེད་དོ།",
    "ཕས་རྒོལ་བའི་དགྲ་ཐམས་ཅད་ཞི་ཞིང་རང་ལྡོག་པར་འགྱུར་བ་དང་།",
    "དགེ་སྦྱོང་དེ་ནི་དེར་འདུག་མ་གནང་།",
    "མི་མང་པོ་དེའི་ནང་དུ་འདུག་ནས་ལམ་ཆེན་པོར་འགྲོའོ།",
    "ཉན་ཐོས་དག་དང་རང་རྒྱལ་བ་ཡི།",
    "གཡུང་པེ་འདུག་༤གཡུང་པེ་ལས།",
    "༢སྣར་ཞོལ་ལྷགས་གཡུང་ལི་པེ་འདུག་གཡུང་ལི་པེ་སྣར་ཅོ་སའི།",
    "༣༩༩ གཡུང་རང་སྲེལ།",
    "༧གཡུང་པེ་འདུག་༢གཡུང་པེ་བཅོད།",
    "ཞུགས་པར་གྱུར་ཅིང་བདག་ཉིད་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པའི་མདུན་ན་འདུག་པར་ཤེས་ཏེ།",
    "འདུག་ནས་གནས་ཁང་དང་བཅས་ཏེ།",
    "འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་ལ་མིག་མི་འཛུམས་ོཔར་ལྟ་ཞིང་འདུག་པ་དང་།",
    "པད་མ་ཆེན་པོ་དེ་ལ་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་འདུག་ནས།",
    "༦༥འདུག་པར་གྱུར་ཏོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་པད་མ་དེ་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་གྱི་དབུས་སུ་འདུག་པ་མཐོང་ངོ།",
    "དེ་དག་གནས་ཁང་དེ་ཉིད་ན་འདུག་བཞིན་དུ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "བདག་ཉིད་ཀྱི་རྫུ་འཕྲུལ་གྱི་སྟོབས་ཀྱིས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་སྟེ།",
    "འོད་དེས་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་ཐམས་ཅད་གདའ་བར་གྱུར་པ་དང་།",
    "སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་གདའ་བར་གྱུར་པ་ཡང་མཐོང་ན་བཅོམ་ལྡན་འདས་འདི་སུའི་སྔ་ལྟས་ལགས།",
