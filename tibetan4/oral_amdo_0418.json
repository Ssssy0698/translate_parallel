    "རང་གིས་རང་ལ་བདེན་ཁ་བྱིན།",
    "གཞན་ལ་བཞད་གད་སློང་བ་ཙམ་ལས་ཕན་པ་ཅི་ཡང་མེད་པ་རེད།",
    "གོ་མིན་ཏང་དང་ཅང་ཅེ་ཧྲི་ལ་རྒྱལ་ཁབ་ཕྱིར་བཙོང་གི་དོན་གང་མང་མང་ཡོད་པ་རེད།",
    "རེ་འགར་སྐྱ་བོར་སོང་ཞིང་།",
    "ཚེར་བློ་མའི་མལ་གདན་ལ་བསྡད་པ་ལྟར་སྡོད་མི་ཚུགས་པ་བྱུང་འདུག་མཐུན་རུའོ་ཧྥེས་ཅང་ཅེ་ཧྲིའི་རྒྱལ་ཁབ་ཕྱིར་བཙོང་གི་ནག་ཉེས་མངོན་གསལ་དུ་འབྱིན་པའི་མགོ་བརྩམས་པ་ན།",
    "འདི་ཁྱོད་རང་གི་གཡོག་རྒན་གྱི་རང་གཤིས་རེད།",
    "ཐེངས་དེར་འདྲི་གཅོད་ལྕགས་དྲའི་སྒེའུ་ཁུང་གི་ཕྱི་ནང་།",
    "རྒྱང་རིང་ལེ་བར་སྟོང་གི་ལམ་ནས་དེར་སྐྱོབས་ཐབས་བྱེད་དུ་འོངས་པ་རེད།",
    "བློ་མཐུན་རུའོ་ཧྥེ་དང་མ་ཞང་གཉིས་ཕན་ཚུན་ཤ་ཞེན་ཧ་ཅང་གཏིང་ཟབ་པ་རེད།",
    "ཁོང་ལོ་ན་ཆུང་དུས་ནས་བཟུང་གསར་བརྗེ་ལ་ཞུགས་རག་བར་མ་ཞང་དང་ཆབས་ཅིག་གནས་པ་རེད།",
    "མ་ཞང་གི་ཁྱིམ་ཡང་དབུལ་འཕོངས་ཡིན་པས།",
    "བློ་མཐུན་རུའོ་ཧྥེ་མ་ཞང་ལ་འགྲོགས་ནས་འབྲི་ཆུ་བཞུར་ཡུལ་ལ་སོང་ནས་གསར་བརྗེའི་བྱ་འགུལ་བྱས་ཤིང་།",
    "རི་པིན་གྱི་ཏུང་ཅིན་ལ་སོང་བ་རེད།",
    "དེར་མཐུད་རང་རེའི་རྒྱལ་ཁབ་དུ་ལྔ་བཞིའི་ལས་འགུལ་ལངས་པས།",
    "ཁོང་གིས་གང་ས་གང་དུ་གསར་བརྗེའི་བློ་མཐུན་འཚོལ་འདྲི་བྱས་པ་དང་།",
    "འཐབ་རྩོད་བྱ་འགུལ་དེ་དག་གི་ཁྲོད་དུ་དངོས་བརྒྱུད་ཅི་རིགས་ཀྱི་སྒོ་ནས་མ་ཞང་གི་ཡི་རང་དང་རྒྱབ་སྐྱོར་ཐོབ་པ་དང་།",
    "ཆགས་སྡང་གི་རུས་ཤན་འབྱེད་པ་བཅས་ལ་བརྩི་འཇོག་བྱས་པ་དང་།",
    "བློ་མཐུན་རུའོ་ཧྥེ་ཏང་གི་བྱ་འགུལ་ལ་ཞུགས་ནས་ཧྥ་རན་སི་ནས་རྡོག་ཐོན་ཏེ།",
    "ད་གཟོད་འཕྲིན་ཡིག་བྲིས་ནས་མ་ཞང་ལ་བརྡ་བཏང་བ་རེད།",
    "བཙོན་རར་ཚ་བོ་ལ་བསྐོར་རྒྱག་ཏུ་སོང་བ་རེད།",
    "བགྲེས་པོས་མིག་ཤེལ་མར་བླངས་ནས་ཞིབ་མོར་ལྟ་ཡག་བྱས་པ་ན།",
    "ལྷག་པར་ཁོག་ཇེ་ཟབ་ཏུ་སོང་ཡོད་པ་མཐོང་བས།",
    "ཁྱོད་སོང་ནས་ལོ་ངོ་བཅུ་ལ་ཉེ་བ་སོང་རུང་།་",
    "ང་ཚོས་མི་དམངས་ལ་གནོད་པའི་ལས་དོན་གཏན་ནས་བྱེད་མི་རུང་བ་ཁྱོད་ཀྱིས་ཤེས་པ་ལྟར་རེད།",
    "རྩོལ་སྡུག་གི་མང་ཚོགས་རྒྱ་ཆེན་པོ་བཅིངས་འགྲོལ་ཐོབ་པར་བརྩོན་ལེན་བྱས་ནས།",
    "རང་གིས་དམག་གཤེད་དང་འཐབ་རྩོད་བྱས་པའི་ཉམས་མྱོང་དང་།",
    "ང་རང་སེམས་བདེ་སོང་བ་ཡིན།",
    "ཉིན་རེ་བཞིན་ཕྱོགས་ཀུན་ལ་སོང་ནས།",
    "ཧྥུའུ་ཙོ་ཡེས་གུང་ཁྲན་ཏང་གིས་རྒྱལ་ཁབ་སྐྱོབས་པའི་བཀོད་པ་ལྟར་ལས་དོན་སྒྲུབ་པ་དང་།",
    "མང་ཚོགས་ལས་འགུལ་བྱེད་ཆོག་པ་དང་།",
    "ཧོང་སྐུ་ཞབས་བགྲེས་པོ་ལ་ཁོང་གིས་བློ་མཐུན་རུའོ་ཧྥེ་ལ་ཁ་བསྒོ་བྱས་ནས།",
    "ཁོང་གིས་ཕྱོགས་མང་པོར་བསམ་བློ་བཏང་རུང་།",
    "དོན་བསྒྲུབ་དགོས་ཟེར་བ་དེ་ཆ་རྐྱེན་མ་རེད་དམ།",
    "ང་རང་གིས་ཅི་བྱེད་འདོད་ན་དེ་བྱེད་པ་དང་།",
    "ང་རང་གང་ལ་འགྲོ་འདོད་ན་དེར་སོང་ནས།",
    "གཉའ་གནོན་མྱོང་བའི་མི་རྣམས་ལ་བཅིངས་འགྲོལ་ཐོབ་ཐབས་བྱེད་འདོད་པ་གཏན་ནས་མ་རེད།",
    "རང་རེའི་དོན་ཆེན་ནི་ངལ་རྩོལ་མི་དམངས་བཅིངས་འགྲོལ་ཐོབ་པ་དང་།",
    "ང་རང་གིས་བློ་ཐག་བཅད་ནས།",
    "ཡག་པོ་འདུག་ཁྱོད་རང་གི་བསམ་པ་ལྟར་གྱིས།",
    "ང་རང་གིས་ཅུང་ཙམ་ཡང་མི་བྱེད།",
    "ཁྱོད་རང་འདི་འདྲའི་སྲ་བརྟན་ཡིན་པས།",
    "ཁོ་པ་ཚོས་ཁྱོད་རྒྱ་ཡན་དུ་མི་གཏོང་ངེས་ཅན་རེད།",
    "རང་རེའི་ལས་དོན་གྱི་ཆེད་དུ།",
    "གལ་ཏེ་མི་ལེགས་པ་རེ་བྱུང་སོང་ན།",
    "གུང་ཁྲན་རིང་ལུགས་པ་ཞིག་གི་བླ་ན་མེད་པ་དང་དྲི་མས་མ་གོས་པའི་གཤིས་ལུགས་མཚོན་པར་གྱིས་ཞེས་བཤད།",
    "དེ་ལྟར་བགྲེས་པོའི་ཞེ་རྩ་ལྷག་པར་ཇེ་བརྟན་ལ་སོང་ནས།",
    "ཁོང་གིས་མཆི་མ་ཕྱིས་ཏེ།",
    "སྲ་བརྟན་འགྱུར་མེད་ཀྱི་སྤྱོད་སྟངས་བཅས་ངོ་སྤྲོད་བྱས་པ་རེད།",
    "བགྲེས་པོ་ཉིད་སྐྲོད་རྩིས་བྱས་པ་རེད།",
    "ཁོང་གི་སྙན་གྲགས་ལ་གཏོར་བརླགས་གཏོང་འདོད་བྱུང་ན་ཡང་།",
    "ཁོང་གི་འཐབ་རྩོད་ལྷག་པར་སྲ་བརྟན་འགྱུར་མེད་དུ་སོང་།",
    "སྡུག་གྲོགས་ཐམས་ཅད་འཁྱག་གྲང་གིས་འཆི་ལ་ཁད་བྱེད་ཀི་ཡོད་པ་ཡིན།",
    "སྤོད་ཡ་ཟེར་བ་གཏན་ནས་མེད་པ་རེད།",
    "འཆི་བའི་འཇིགས་སྣང་རྣམ་པ་ཀུན་ཏུ་ང་ཚོའི་རྗེས་སུ་འབྲངས་ཡོད་པ་ཡིན།",
    "རྐང་བ་ནས་བཟུང་སྟེ་ཕྱི་ལ་དྲུད་འགྲོ་བ་རེད།",
    "ལྷག་པར་འཇིགས་སུ་རུང་བ་རེད།",
    "ང་ཚོས་རྒྱུན་པར་བློ་མཐུན་རུའོ་ཧྥེའི་སྐུ་ཁམས་བདེ་ཐང་ལ་སེམས་ཁྲེལ་བྱེད་བཞིན་ཡོད་པས།",
    "ཁོང་མཐོང་ཐེངས་རེར།",
    "ཉེ་ཆར་ཁྱེད་སྐུ་ཁམས་ཅི་འདྲ་རེད།",
    "ང་ཚོས་སྤོབས་པ་ལྡབ་འགྱུར་དུ་བསྐྱེད་ནས་འཐབ་འཛིངས་བྱེད་དགོས།",
    "དགྲ་ཟླས་ང་ཚོའི་ལུས་ཕུང་ཉམས་ཉེས་སུ་གཏོང་རྩིས་ང་ཚོས་ངེས་པར་དུ་རང་གི་ལུས་ཕུང་ལ་གཅེས་སྐྱོང་བྱེད་ཡིན་པས།",
    "ང་ཚོ་གསར་བརྗེ་མཁན་ཚོས།",
    "ང་ཚོས་ངན་ཞན་གྱི་འཚོ་བའི་ཆ་རྐྱེན་འདི་འདུལ་མི་ཐུབ་རྒྱུ་ཅི་ཡོད།",
