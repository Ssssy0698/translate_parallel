    "སྒྲུབ་བརྒྱུད་ཐམས་ཅད་ཀྱི་ཆུ་མགོ་ལྟ་བུར་གྱུར་པ་དེའི་སྐུ་ལགས་པར་གདའ།",
    "སྒྲུབ་བརྒྱུད་ཀྱི་བསྟན་པ་ཉི་ཟླ་ལྟར་མཛད་པ་དེའི་སྐུ་ལགས་པར་གདའ་ཞིང་།",
    "འབྲི་སྟག་མཚལ་འབྲུག་ལ་སོགས་བརྒྱུད་འཛིན་ནམ་མཁའི་སྐར་ཚོགས་ཙམ་ད་ལྟའི་བར་དུ་ཡོལ་བར་མཛད་པ་དེ་ཉིད་ཀྱི་སྐུ་ཡིན་པར་གདའ།",
    "ཉི་མ་གཏོད་ལ་གནོན་པ་སོགས་ངོ་མཚར་བའི་བལྟས་དཔག་ཏུ་མེད་པ་བསྟན་པ་དེ་ཉིད་ཀྱི་སྐུར་གདའ།",
    "ལོ་དྲུག་ཏུ་དབུ་སྔས་ལ་མི་འཇོག་པར་ཐུགས་དམ་མཛད་པས་གྲུབ་པ་བརྙེས་ཏེ་དག་པའི་སྣང་བ་སྟོན་ནུས་པ་དེའི་སྐུ་ཡིན་པར་གདའ།",
    "མཐར་སྐུ་མྱ་ངན་ལས་འདའ་ཁར་སེང་གེའི་ཁྲི་ལ་མཁའ་འགྲོ་མ་དུ་མས་སྤྱན་དྲངས་པ་དེ་ཉིད་ཀྱི་སྐུར་གདའ།",
    "སྲིད་པ་གསུམ་གྱི་མགོན་སྐྱབས་སུ་གྱུར་པ་དེ་ཉིད་ཀྱི་སྐུ་ཡིན་པར་གདའ།",
    "གྲགས་ཡེ་བ་སྐུ་མཆེད་ཀྱི་དབོན་པོཪ་གདའ།",
    "བཀའ་བསྲུངས་གྲགས་པ་ཅན་མ་ལུས་པ་བྲན་ཞིང་དུ་འཁོལ་བ་དེ་ཉིད་ཀྱི་སྐུར་གདའ་ཞིང་།",
    "ཚེས་བཞི་རྙིང་མ་བ་སྐུ་མཆེད་ཀྱི་དབོན་པོར་གདའ།",
    "བདག་འཇུག་སྦྱིན་སྲེག་ལ་སོགས་བརྒྱ་ཕྲག་མང་དུ་མཛད་པ་དེའི་སྐུར་གདའ།",
    "བསྟན་པའི་སྦྱིན་བདག་མཐའ་ཡས་པ་མཛད་པ་དེ་ཉིད་ཀྱི་སྐུར་གདའ་ཞིང་།",
    "དེའི་གཡོན་ཕྱོགས་ཀྱི་ཀ་བ་ལ་བཞུགས་པའི་ཁ་སརྦ་ཎིའི་སྐུ་འདི་ཇོ་བོ་རྗེའི་ཐུགས་དམ་དུ་གདའ།",
    "གྲུབ་ཐོབ་གླིང་ཆེན་རས་པའི་ནང་རྟེན་དུ་གདའ་ཞིང་།",
    "གྲུབ་ཐོབ་གཤེན་དགོན་དཀར་བའི་ནང་རྟེན་དུ་གདའ།",
    "རྒྱལ་བུ་ཧུ་ལས་ཁོང་རང་སྐུ་མཆེད་བཞི།",
    "དེ་ལ་དར་ཡུལ་བཏགས་ཏེ་འཇག་སྤྱིལ་ལ་བཏགས་པས་བཞུགས་པ་ཡིན་པ་ར་གདའ།",
    "འཇམ་དབྱངས་གྲགས་ཡེ་བའི་ནང་རྟེན་སྒོ་མངས་ཀྱི་དོད་དུ་བཞེངས་པའི་ལྷ་ཆེན་དུ་གདའ།",
    "ཁྲི་དཔོན་རྡོ་རྗེ་དཔལ་གྱི་ནང་རྟེན་དུ་གདའ།",
    "རྒྱ་བྲག་ཁ་བའི་ནང་རྟེན་དུ་གདའ།",
    "ས་སྐྱོང་ཆེན་པོ་ཤཱཀྱའི་རྒྱལ་མཚན་ཅན་པའི་ཕྱི་རྟེན་དུ་བཞེངས་པ་ཡིན་འདུག་ལགས།",
    "དགུང་ལོ་གསུམ་པ་ལ་ཡུམ་གྱིས་པང་དུ་ཐོགས་ནས་ཆུ་བཙགས་པས་མས་ངོ་ཚ་བསྲུངས་མི་ཤེས་པར་འདུག་སྙམ་པའི་བློ་སྐྱེས་པ།",
    "རྔུར་པ་ལྷང་ལྷང་འདུག་པས།",
    "དྭགས་པོ་སྙི་སྒོམ་གྲགས་ཆེ་བར་འདུག་པས་ཁོང་བཞུགས་སར་ཕྱིན་ན་ཐམས་ཅད་གསུང་།",
    "སྔར་བཞིན་གྱི་དྲི་བའང་མི་མཛད་པར་གདའ་བ།",
    "ཞིང་ཁམས་གཞན་དུ་མྱུར་དུ་གཤེགས་པའི་ལྟས་ཡིན་པར་འདུག་གསུངས།",
    "ཁོ་བོ་འདི་ནས་ཕྱིར་མི་ལྡོག་ཟེར་བར་འདུག་རྟེནའབྲེལ་ཤིན་ཏུ་བཟང་གསུངས།",
    "གནམ་འཁོར་ལོ་རྩིབས་བརྒྱད་ཀྱི་དབྱིབས་ལ་སོགས་པའི་ལྟས་ཁྱད་པར་ཅན་མང་དུ་འདུག་པས་ཤིན་ཏུ་དགྱེས།",
    "དེའི་སང་ཁོ་རང་ག་ཉེསདཔྱད་ཨེ་མཐུན་བརྟགས་པའི་ཕྱིར་དུ་འགྲོགས་ཕྱིན་པས།",
    "དུང་འཁྱིལ་བའི་ཁ་མ་ཁབ་བཙུགས་འདུག་སྐད།",
    "ཁྱེད་འདྲ་ཀྱིས་ཇི་ལྟར་འདོད་པ་བཞིན་གྲུབ་པར་འདུག་པས་བསམ་གྲུབ་རས་ཆེན་དུ་ཐོགས་ཞེས་གསུངས།",
    "རྗེ་བཙུན་ནཱ་རོ་པའི་དབུ་གདུགས་སྐྱེས་མཆོག་མར་པས་བོད་དུ་གདན་དྲངསཔ་དེ་ཉིད་ཡིན་པར་གདའ་ཞིང་།",
    "ཅེས་པ་དེ་ཡིན་པར་འདུག་སྐུ་མདུན་གྱི་ཞབས་རྗེས་འདི་ཉིད།",
    "ཀུན་གྱིསམཐོང་བ་འདི་བྱུང་བར་གདའ།",
    "འོག་མ་ཇའི་མཛོད་དུ་གདའ།",
    "དཔོན་ཆེན་བསད་པའི་དུས་རྟགས་དེར་འདུག་ཅིང་།",
    "སྔ་ཕྱི་བསྟུན་པའི་བརྟག་པའི་གནས་སུ་འདུག་ཇོ་རྩེའི་གཏེར་མའཕེལ་གདུང་དང་སྐུ་འདྲ་འདི་རྣམས་མ་གཏོགས།",
    "གཞན་དུ་ལྟོ་གོས་གཏམ་གསུམ་གྱི་ནང་ནས་གཏམ་འདི་ལ་ཞེན་པ་ཆོད་དཀའ་བར་འདུག་ལྟོ་གོས་གཉིས་ཀ་ཤིན་ཏུ་བཟོད་སྲན་ཆུང་བའི་རིགས་ཤིག་མིན་ཚེ་ངན་ངོན་ཙམ་གྱིས་འཚོ་བར་བྱེད་ཐུབ་པ་ཡིན།",
    "འདི་ལ་མཚན་གཞི་བཞག་ན་ང་བཞག་ཆོག་འདུག་རོགས་པ་ལ་ལ་ཡོད་ནའང་ཐང་།",
    "བསམས་ཤིང་ཡི་མུག་གང་ཟག་མང་བར་གདའ།",
    "དེ་ལྟ་བུའི་བསམས་ཤིང་བསམས་ཤིང་ཡི་མུག་བྱེད་དགོས་པའི་གང་ཟག་སྙིགས་མའི་དུས་འདིར་མང་བར་གདའ་འོ།",
    "ཆགས་སྡང་རང་རིག་མཉམ་ཉིད་མ་ཤེས་ན།",
    "དེ་ལྟ་བུའི་འོང་བ་དྲུག་དེ་ལྟར་ཡིན་ཡང་དེ་བཞིན་དུ་མཛད་པའི་སྐྱེ་བོ་ཉུང་བར་འདུག་གོ།",
    "དེ་ཡང་རང་རྒྱུད་གཏིང་ནས་ཐུལ་བ་ནི་འཕགས་ས་མ་ཐོབ་བར་དུ་མེད་ལ་དེའི་བར་དུ་གཞན་དོན་གཏན་ནས་མི་བསྒྲུབ་པ་ནི་མིན་པར།",
    "དེ་ཡང་རང་འདོད་ཀྱི་འཁྲི་བ་གཅོད་དགོས་དུས་འཕགས་ས་ལ་མ་ཐོན་ན་དཀའ་བ་ཡིན་ཡང་།",
    "རིག་པ་ཅི་རིག་རང་བྱུང་རང་དག་བཞག།",
    "རིག་པ་གང་དང་ཅི་རིག་ན་ཡང་རང་བྱུང་རང་དག་ཏུ་བཞག་པ་དང་།",
    "མེད་དོ་སྙམ་པའང་རང་གྲོལ་བ།",
    "དེའང་རང་ཉིད་དེའི་ཕྱོགས་སུ་མ་ཤོར་བར་གལ་ཆེ་བ་ལས་གཞན་བརྟག་དཀའ་ཕྱིར་བཟང་པོ་ཡིན་མིན་གྱི་ཁུར་མི་ལེན་ཞིང་བསྟོད་སྨད་གཉིས་ཀ་མི་བྱེད་པར་བཏང་སྙོམས་སུ་འཇོག་པ་དང་།",
    "འཛེགས་ན་ཐར་བ་གམ་ན་འདུག།",
    "འོན་ཀྱང་རང་འདོད་ཡིད་བྱེད་ཀྱི་བློ་མ་དོར་བའི་ཐེག་དམན་ཐར་བ་ཆ་མཐུན་གྱི་གྲལ་དུ་འགྲོའམ་ཞེ་ན།",
    "དེ་ཡང་བསམ་པ་བཟང་པོ་ཞིག་དགོས་འདུག་སྙམ་པ་ཙམ་དུ་མི་འཇོག་པར།",
    "ང་རང་ཉིད་བཞིན་དུ་དགྲ་ལ་སོགས་པ་ཐམས་ཅད་ཀྱིས་བདེ་བ་འདོད་པ་དང་།",
    "ཤེས་པ་སྙམ་བྱེད་ཀྱི་བདུད་དང་འབྲེལ་བའི་སྤྲོས་པའི་འདུན་མ་སྣ་ཚོགས་དང་བྲལ་བར་བྱས་ནས་འདུག་པར་བྱ།",
    "དུས་ཚོད་ངེས་གཟུང་འདི་ཙམ་ཞིག་ལ་འདུག་པའི་དམ་བཅའ་ཡིན་ཟེར་བ་ལྟ་བུའི་སྡུག་སྒུར་གྱི་མཚམས་གཅད་མི་དགོས་པའོ།",
    "དེ་འདྲའི་བདུད་ཀྱི་ཞགས་པ་གཞན་གྱི་བཀུར་གནས་སུ་འདུག་པ་དེ་བོར་བ་གྱིས་ཤིག་ཅེས་པ་སྟེ།",
    "གར་འདུག་གནས་ལ་མགྲོན་ཁང་འདུ་ཤེས་སྒོམས།",
    "ཡུན་རིང་བསྒོམས་ཀྱང་རང་རྒྱུད་མ་གྲོལ་ན།",
    "ཕྱིའི་དངོས་པོའི་ཚེ་གཡོག་ཅིག་ཕར་བྱེད་དགོས་སར་ཐུག་དུས་མ་འཇོན་པའི་ས་ཚོད་ལ་ཐུག་ཡོད་པ་ཡིན་ཏེ།",
    "དེ་བཟོད་ཐུབ་པར་མི་འདུག་བསམས་ཚེ་བྱ་རིག་པ་ཅན་གྱིས་ནམ་ཚོད་བཟུང་ནས།",
    "ཡུན་རིང་མི་འགོར་བར་ཚེའི་མཐར་གཏུགས་ནས་ཕུང་པོ་དུར་ཁྲོད་ནང་དུ་འཕེན་རྒྱུ་ཡིན་པ་དེ་གཞན་ལ་ཡོང་ནའང་རང་ལ་མགྱོགས་པོར་མི་ཡོང་སྙམ་པའི་རྟག་འཛིན་དེ་ལས་གནོད་ཆེ་བ་ཞིག་མེད་པ་ཡིན།",
    "ཐོས་བསམ་ཤེས་རྒྱ་ཆེ་ཡང་རང་གཞན་ཕན་མི་ཐོགས།",
    "ཐོས་བསམ་ཤེས་རྒྱ་ཆེ་ཡང་རང་གཞན་ལ་ཕན་མི་ཐོགས་པ་དང་།",
    "འོ་ན་ཁྱེད་རང་གང་ཅན་པོའི་གྲལ་ན་ཡོད་ཅེས་ང་ལ་འདྲི་ན།",
    "ཞེས་པ་འདིའི་མཚན་གཞི་དེ་ང་ལ་ཟེར་འདུག་བསམ་པ་ཞིག་བྱུང་།",
    "གཞན་དོན་བྱེད་པའི་དུས་དེ་རང་དོན་ཟད་ཙ་ན་ཡིན།",
    "གཡམ་རྒྱུག་སྤྲོས་བྲལ་འདིས་ཀྱང་རང་སེམས་སླུ།",
    "བླུན་སྒོམ་ཡིད་དཔྱོད་འདིས་ཀྱང་རང་སེམས་སླུ།",
    "སྨྱོ་སྤྱོད་རྩིང་པོ་འདིས་ཀྱང་རང་སེམས་སླུ།",
    "སྲུང་སྡོམ་ངོ་ལྐོག་འདིས་ཀྱང་རང་སེམས་སླུ།",
    "ང་མཁས་གྲགས་འདོད་འདིས་ཀྱང་རང་སེམས་སླུ།",
    "ཕྱི་དུས་ཡིད་སྨོན་འདིས་ཀྱང་རང་སེམས་སླུ།",
    "ཁྱིམ་པ་རང་ཉིད་དང་མཉམ་འགྲོ་མཉམ་འདུག་མཉམ་ཟ་མཉམ་འཐུང་བྱས་པས་མཉམ་འགྲོགས་ཀྱི་བདུད་ཞུགས་ནས་ནམ་ཞིག་དད་པ་ལྡོག་པ་མ་ཟད།",
    "སྐྱེད་ཁེ་ཞིག་ཡར་འཕེལ་དགོས་འདུག་བསམས་ན་ཡོན་ཏན་ཉམས་སུ་ལོངས་དང་ཁེ་སྤོགས་ཀྱི་སྐྱེད་དེར་འཕེལ་དུ་ཡོད་པ་ཡིན།",
    "མཉམ་བཞག་དུས་ན་དུག་ལྔ་མགོ་ནོན་ཡང་།",
    "དེས་ན་གཞན་དོན་སྒྲུབ་པ་ལའང་རང་སྨིན་པ་ཞིག་མིན་ན་གཞན་སྨིན་པ་དང་གྲོལ་བའི་ལམ་དུ་ཇི་ལྟར་དུ་འགོད།",
    "བསྡད་ན་འདུག་རྟེན།",
    "ན་སོ་རྒས་གཞོན་སུ་ཡིན་ཡང་རང་གར་འཆི་བདག་གཤིན་རྗེ་དང་གདོང་ཐུག་རྒྱུར་སྒུག་བཞིན་འདས་ཚེ་དཀའ་ཚེགས་ཆེན་པོར་འཕྲད་ངེས་པ་ཡིན།",
    "སྡུག་དེ་ཙམ་ཁོ་ན་ཡིན་ན་སྐྱོན་མེད་པར་འདུག་ཀྱང་།",
    "མི་རྟོག་དུས་ན་མ་འགགས་ཝལ་ལེ་བ།",
    "མཉམ་བཞག་དུས་ན་མཐའ་གྲོལ་སང་ངེ་བ།",
    "ཐོག་མ་ཉིད་ནས་ལེགས་སྨོན་དང་རང་དོན་ལ་མ་འདྲེས་པ་ནི་དཀའ་ཡང་།",
    "གང་བྱུང་རང་སར་རང་ངོ་ཤེས་པ་དེས།",
    "སེམས་ཉིད་ཀུན་སྣང་རང་བཞིན་ཤེས་པ་དེས།",
    "མཐར་ཐུག་ཉམས་སྣང་རང་ངོ་རང་འགགས་དང་།",
    "གསང་བ་སྣང་ངོར་དམིགས་པའི་འདུ་ཤེས་ཙམ་ཡང་རང་འགགས་སུ་འགྲོ་བ་དང་།",
    "འགྲོ་འདུག་སྒྱུ་མའི་འཕྲིན་ལས་མ་འདས་དང་།",
    "འགྲོ་འདུག་ཐམས་ཅད་སྒྱུ་མའི་ཕྱག་རྒྱ་འཕྲིན་ལས་སྟངས་སྟབས་ཀྱི་ངོ་བོ་ལས་མ་འདས་པ་ཡིན་པ་དང་།",
    "རང་བྱུང་རང་ཞིག་ཆུ་ཡི་ཆུ་བུར་འདྲ།",
    "མི་འབྲལ་འདུག་པར་འདོད་ཀྱང་འགྲོ་བར་ངེས།",
    "དེ་ལྟར་རང་རང་སོ་སོའི་གཞུང་བཞིན་དུ་བསྒྲུབས་ན་དེ་ལྟར་དུ་འོང་བར་ངེས་སོ།",
    "རྣམ་རྟོག་བཟང་ངན་ཅི་ཞིག་སྐྱེས་ཀྱང་རང་སར་གྲོལ་ནུས་པ།",
    "རང་རང་སོ་སོའི་གནས་ལ་འགྲོ་རན་ནས་གྱེས་ན་ཡང་།",
    "མི་བདེ་འདུག་བྱེད་ཀྱི་རྨོག་ཁོ་རང་ཕུད་བཞག་ན་གཞི་ནས་མདའ་འཕེན་བདེ་བར་འགྱུར་བ་བཞིན་དུ།",
    "སེམས་སྐྱིད་པོར་འོང་བར་མི་འདུག་པས་དེ་བས་ང་གཅིག་པུའི་བདེ་བ་བློས་བཏང་ནས།",
    "དགའ་བ་དང་བདེ་བ་ཐམས་ཀྱི་གཞི་དེ་ན་ཡོད་འདུག་བསམ་པར་བྱུང་དུས།",
    "འབྱོར་བ་ཅན་མང་པོས་དེ་རིང་ཁ་སང་རང་ལྕེབས་བྱེད་དགོས་ཐུག་པ་ལ་སོགས་པས་མཚོན་ནས།",
    "རང་སྐྱོན་གྱི་མཚང་རང་ལ་ཡོད་པ་དེ་ཤེས་ཐུབ་དགོས་པ་དང་།",
    "རང་ལ་ཚེ་འདིར་རྒྱགས་ཕྱེ་ལྟ་བུའི་རྟོགས་པའི་གདེང་མེད་པར་རམ་ཡང་ན་རང་མདའ་འདི་ནས་འཕངས་ན་མདེའུ་འདིར་རྒྱག་པར་འདུག་སྙམ་པའི་ཞེ་ཚོད་དང་རྟོགས་པའི་གདེང་མེད་པར།",
    "ཆེ་བཟང་མཐོ་ས་མི་གཟུང་དམན་པའི་འདུག་སར་བསྡད།",
    "ཉམས་ལེན་འགྲུབ་པའི་དུས་ཤིག་རྡུགས་པར་གདའ།",
    "འཕགས་པའི་ཐུགས་རྗེས་འདྲེན་པ་རྡུགས་པར་གདའ།",
    "ཕྱོགས་རིས་མེད་པའི་གདམས་པ་རྡུགས་པར་གདའ།",
    "ཉམས་ལེན་འགྲུབ་པའི་དུས་ཤིག་མེད་པར་རྡུགས་པར་གདའ་བ་དང་།",
    "འཕགས་པས་ཡར་འཐེན་པ་གཉིས་ཀ་གང་ཞིག་མ་འཛོམས་ན་ཡང་མཐུ་རྡུགས་པར་གདའ་བ་དང་།",
    "ཕྱོགས་རིས་མེད་པའི་གདམས་པ་གང་ཡིན་ཡང་མཐུ་རྡུགས་པར་གདའ་འོ།",
    "འཇིག་རྟེན་འཁྲུལ་བའི་སྤྱོད་པ་མཐོང་ཙ་ན།",
    "འོན་ཀྱང་ཡི་མུག་ནས་འདུག་རྒྱུ་ཡོད་པ་མིན་ཏེ།",
    "བསམས་ཤིང་བསམས་ན་ཡི་མུག་པའི་གནས་སུ་འདུག་པས།",
    "ཟ་ཉལ་འགྲོ་འདུག་དང་སྐད་བརྡའི་སྨྲ་རྗོད་ཐམས་ཅད་ཀྱང་འཇིག་རྟེན་དང་མཐུན་པར་འཇུག་ནས།",
    "མ་ལག་རྡུམ་མའི་བུ་ཆུས་ཁྱེར་བ་ལྟར་དུ་གཅིག་ངུས་ནས་ལྟ་མི་འདུག་པར།",
    "གཞན་ཡང་རང་མཐོང་དང་ང་རྒྱལ་སོགས་ཀྱང་སྤང་བ་ལ་བརྩོན་དགོས་པ་ནི་ལྟ་ཅི་སྨོས་ལ།",
    "ཡང་ན་རང་ཉིད་གཅིག་པུར་འདུག་པར་བྱ་བ་དང་།",
    "ངན་ལ་བརྙས་བཅོས་བྱེད་མཁན་གྱིས་ཁོ་རང་ངན་པ་ཡིན་པའི་རྟགས་སྟོན་པ་ཡིན་པས།",
    "བདེ་བར་གཤེགས་པས་འདི་ལྟར་གསུངས་འདུག་པས་འུ་ཚོས་ཇི་ལྟར་བྱས་ན་བཟང་།",
    "རྒས་པའི་སྡུག་བསྔལ་རྒས་པ་ཁོ་རང་མ་གཏོགས་པས་མི་ཤེས་པའི་ས་ཚོད་ལ་ཐོན་ཚེ།",
    "ད་དུང་གསོན་པོའི་ས་ཆ་ལ་འདུག་རྒྱུ་ཡོད་ཀྱང་།",
    "ཞེས་པ་ལྟ་བུའི་བྱ་བའི་མཐའ་ཞིག་ལ་ཐུག་དུས།",
    "བསྡད་ན་འདུག་རྟེན།",
    "ཡུལ་སྣང་རང་ཡལ་སྟོང་པར་རྟོགས་པ་ཡིན།",
    "སྣང་བ་འདི་ཡང་རང་བཞིན་གྱིས་སྟོང་ནས་བདེན་འཛིན་གྱི་མ་རིག་པ་སངས་པའི་ཚེ་ན་དག་པ་ཡིན་པ་ནི།",
    "ལོངས་སྐུ་འདུག་ཚུལ་འོད་གསལ་རང་བཞིན་ཏེ།",
    "ལོངས་སྐུའི་འདུག་ཚུལ་སྐུ་གསུམ་ལྷུན་གྲུབ་ཀྱི་ཆ་དེ་འོད་གསལ་བའིི་རང་བཞིན་ཅན་ཡིན་པ་དེ་ཇི་ལྟ་བུས་བསྟན་ཞེ་ན།",
    "དབྱིངས་ལྟར་འདུག་ཚུལ་འོད་གསལ་ལོངས་སྤྱོད་རྫོགས།",
    "དེ་ལྟར་དུ་མ་ཤེས་ན་བུ་ཆུང་ངན་པ་ཁ་ཉན་མེད་པ་དེ་འགག་ལ་ཐུག་དུས་མེད་པ་བཞིན་དུ།",
    "མེད་དོ་སྙམ་པའང་རང་གྲོལ་བ།",
    "འདུག་གདན་དར་ཟབ་དང་འབོལ་གདན།",
    "དུག་ལྔ་སྐྱེ་དུས་ངོས་གཟུང་རང་གློད་པས།",
    "འཛིན་པའི་སེམས་དང་རང་བཞིན་བྲལ་བ་ཡིན།",
    "སེམས་ཉིད་ཡེ་ཤེས་ཀྱི་ངང་དུ་འདུས་པའི་ཚེ་ཡིན་པས་དེའི་དུས་སུ་འཛིན་པའི་སེམས་དང་རང་བཞིན་བྲལ་བ་ཡིན་པ་དང་།",
    "གཞན་མགོ་གནས་སྐབས་འདོན་མ་ཐུབ་ཀྱང་རང་མགོ་ཐོན་པ་ཞིག་རན་པའི་དུས་ལ་བབས་ཡོད་དེ།",
    "འདིར་བཞུགས་རྣམ་པ་ཡང་སང་ཉིན་ནས་མང་ཆེ་བ་རང་རང་སོ་སོའི་ཕྱོགས་སུ་ཕེབས་རན་པ་ཡིན་པ་ནི།",
    "དབྱེར་མེད་པ་ཡང་རང་བཞིན་དབྱེ་བ་མི་དམིགས་པ་དང་།",
    "འདིར་ནི་གཤིན་རྗེ་གཤེད་ཐུགས་ཀྱི་རིགས་སུ་བསྟན་པས་ཅུང་ཟད་བསྣོལ་བར་བྱུང་ན་ཡང་རང་བཞིན་འགལ་བ་མེད་པ་སྔ་མ་བཞིན་ནོ།",
    "དེ་ཡང་རང་བཞིན་ཉིད་ལས་ཉམས་པ་མེད།",
    "བྱེ་བྲག་ཏུ་ནི་དཔའ་བོ་ཆེན་པོའི་ཏིང་ངེ་འཛིན་ཡན་ལག་ལྔ་དང་ལྡན་པ་དེ་ཉིད་ཐབས་ལ་མཁས་པས་གསང་སྔགས་སུ་བྱིན་གྱིས་བརླབས་ཏེའདི་ལྟར་ཨ་བྷི་ར་ཧཱུཾ་ཁཾ་ཞེས་བྱིན་གྱིས་བརླབས་ཏེདེ་ཡང་རང་ཐད་དུ་ན་ཨ་བྷི་ར་ཞེས་བྱ་བ་ནི།",
    "གྲོགས་པོ་ཙམ་དུ་མཐོང་བའི་ཕྱིར་རང་རང་གཙོ་བོ་ཡིན་ནོ།",
    "རྀ་ནི་ལོ་ཙ་ན་སྟེ་སྤྱན་ནོ།",
    "དེ་ལ་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་ཀྱང་རིག་པ་རང་སྣང་མབཀའ་༩ བ་ཙམ་ཡིན་པའི་ཕྱིར་བདག་དང་རང་བཞིན་དབྱེར་མེད་དེདེ་ལྟ་བུའི་དཀྱིལ་འཁོར་དེར་རྣལ་འབྱོར་བ་འཇུག་པའི་མཚན་ཉིད་དམ་ལུགས་ཀྱང་།",
    "འགྲོ་དྲུག་དུས་གནས་མ་ལུས་སྣང་།",
    "དེ་དག་ཀྱང་རང་བཞིན་དབྱེར་མེད་པར་གསུངས་པ་ཡང་ཡིན་ནོ།",
    "འདུག་སྟངས་དང་།",
    "ང་རང་དེ་དང་དེ་ལྟ་བུ་ཡིན་ནོ་སྙམ་ནས་ཆེད་དུ་འཛིན་ན་རང་རྒྱུད་ཀྱི་སྐྱོན་མི་མཐོང་།",
    "ཁོ་རང་དེའི་འོག་ཏུ་ཉལ་ནས་ད་ངས་ནས་འདི་ལ་གཞི་བྱས་ལོངས་སྤྱོད་མང་པོ་འོང་།",
    "དེ་ལྟར་འདས་མ་འོངས་པའི་རྟོག་ཚོགས་མང་པོ་ཐོག་ཏུ་ཁེལ་དུས་མེད་ཅིང་རང་རྒྱུད་གཡེང་པའི་རྒྱུ་ཡིན་པས་ལེགས་པར་སྤངས་ཏེ་དྲན་ཤེས་བག་ཡོད་དང་ལྡན་པས་ཉན།",
    "དེ་ལས་གཞན་དུ་གྲོང་ཆོག་པ་རྣམས་ཤི་བོའི་རོ་སྔས་སུ་ཕྱིན་ནས་ཡར་འགྲོ་མར་འགྲོའི་ས་མཚམས་རྡོ་ཁ་སྲབ་ཀྱིས་བསྒྱུར་བ་དང་འདྲ་ཞེས་ཟེར་གྱིན་འདུག་སྟེ།",
    "རབ་ཏུ་དམའ་བའི་ས་ལ་འདུག།",
    "མི་ཞིག་ཡིན་ན་ཇི་ལྟར་ཞན་ཡང་ཁོ་རང་གད་ཕུག་གམ་ཤིང་དྲུང་ལྟ་བུ་ཞིག་ཏུ་ཕྱིན།",
    "བསྟན་པ་གནས་ཀྱང་རང་ཉིད་བསྟན་པའི་སྒོར་མ་ཞུགས་ན།",
    "མི་ཚང་བར་འདུག་ན་ཐབས་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་ཚང་བའི་ཐབས་ལ་ཅི་ནས་ཀྱང་འབད།",
    "སོ་ཞོ་ངོམས་ནས་དྲུང་དུ་སླེབ་ཙ་ན།",
    "དེ་ཙ་ན་གསོན་པའི་དུས་སུ་ལུས་དར་ཟབ་ཀྱི་སྦུབས་ན།",
    "དུས་ད་ལྟ་ལུས་ཀྱི་རྩ་ན་གདའ།",
    "དུས་དང་གནས་སྐབས་ཐམས་ཅད་དུ་འཆི་བ་ཁོ་ན་བསྒོམ་ཞིང་འགྲོ་འདུག་ཉལ་གསུམ་ཐམས་ཅད་ལ་འཇིག་རྟེན་འདིའི་སྤྱོད་ལམ་གྱི་ཐ་མ་ཡིན་ནོ།",
    "གང་ན་འདུག་ཀྱང་འདིར་འཆིའམ་སྙམ་པ་དང་།",
    "འདུག་ན་གནས་མི་རྟག་པས་དག་པའི་ཞིང་ཁམས་ཡིད་ལ་བྱ།",
    "ཕ་རོལ་པོ་ཤི་བ་མཐོང་ཡང་རང་འཆི་བ་མི་ཤེས་པས་ལེ་ལན་དང་པོ་དེ་ལ་ཐུག་ཅེས་གསུངས།",
    "ཤི་ནས་ཀྱང་མེ་ཤི་བའམ་ཆུ་སྐམ་པ་ལྟ་བུ་ཞིག་ཡིན་ན་དེ་ཀ་ལས་གཞན་མི་འདུག་ཀྱང་།",
    "དེ་སྟོན་པར་ཞུས་པས་རྫུ་འཕྲུལ་གྱིས་མཚོ་དེ་སྐད་ཅིག་ལ་བསྐམས་ཙ་ན།",
    "བཞེས་པ་ཟིན་ཙ་ན་ཞལ་སྣུམ་ཆིལ་ལེ།",
    "སྔར་གྱི་དེ་མ་ཡིན་པའི་རྒྱ་དམར་ཙིག་གེ་བ་ཞིག་བྱས་ནས་དབུ་བཏེགས་འོང་བར་འདུག་སྟེ།",
    "སྡོང་དུམ་གཤེགས་པའི་ནང་ན་སྦལ་པ་ཆེན་པོ་ཞིག་ལ་སྲོག་ཆགས་མང་པོས་ཟ་གྱིན་འདུག་པ་དེ་ལ་ཁྲུས་ཆོག་སོགས་མཛད།",
    "ཀརྨ་པ་ཞྭ་དམར་ནག་གཉིས་ནི་དེ་དུས་གྲགས་ཆེན་པོ་ཡོད་པས་བབ་ཅོལ་དུ་བགྲང་བར་འདུག།",
    "ཡི་དྭགས་མང་པོས་རུབ་བརྒྱབ་པའི་ཁྲོད་ན་ཁོ་རང་འདུག་ཆུང་མའི་འཕྲིན་བསྐུར་རྣམས་བསྐྱལ་བས།",
    "ཁོ་རང་སྣབས་ལུད་རྩོད་ས་ནས་ཡི་དྭགས་གཞན་གྱིས་ལུས་ལ་རྨ་མང་པོ་གཏོད་འདུག་གསུངས།",
    "དེ་གཞན་ལ་སྤྲོ་བར་འདོད་པས་གང་དུ་ཕྱིན་པ་དེར་ཡང་གནོད་ཅིང་རང་ལ་མི་ཕན།",
    "སྤྱི་བོར་མར་བྱུག་དུས་བཀྱིགས་ནས་དོང་དུ་འཕང་བ་ལྟ་བུ་ལ་སོགས་པའི་སྡུག་བསྔལ་མྱོང་།",
    "འགྲོ་འདུག་དང་སྒུལ་བསྐྱོད་ཐམས་ཅད་ཀྱང་མི་ནུས་བཞིན་དུ་དཀའ་བས་བྱེད་དགོས་པ་ཡིན་ཏེ།",
    "མི་སྡིག་ཅན་འཆི་བ་མཐོང་ཙ་ན།",
    "ནོར་མེད་ཙ་ན་དགྲ་དང་བྲལ།",
