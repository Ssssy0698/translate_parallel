    "ཐམས་ཅད་དང་རང་བཞིན་མེད་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ཡིན་དང་གཅིག་སྐྱེད་པར་བྱེད་པ་དང་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་འགལ་བ་དེ་ཉིད་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "གང་ཟག་དང་རྒྱུན་རང་བཞིན་མེད་པ་དེ་བཞིན་དུ་བྱ་བ་ཡང་རང་བཞིན་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་དུས་དཔག་ཏུ་མེད་པར་འགྱུར་བ་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "འཁྲུལ་པ་ཞེས་བྱ་བ་ནི་ཉམས་སུ་མྱོང་བ་ཇི་ལྟ་བ་བཞིན་དུ་སོ་སོར་ངེས་པའི་ཡུལ་དང་དུས་དང་རང་བཞིན་ལ་སོགས་པའི་ཁྱད་པར་གྱི་ངོ་བོས་མི་འཇུག་པའི་ཕྱིར་རོ།",
    "འདི་སྙམ་དུ་དཔེར་ན་ད་ལྟར་བྱུང་བའི་སེམས་ཀྱི་སྐད་ཅིག་འདས་པ་དང་མ་འོངས་པའི་སེམས་ཀྱི་སྐད་ཅིག་དག་དུས་ཀྱིས་བྱས་པའི་བར་མེད་པ་ཉིད་ཡོད་ཅིང་།",
    "ཐམས་ཅད་ཀྱི་རང་རང་སོ་སོར་རིག་པའི་ཕྱིར་རོ།",
    "གང་དང་རང་རིག་པ་ཡིན་པ་དེ་དང་དེ་ནི་ཤེས་པ་ལས་དོན་གཞན་དུ་གྱུར་བའི་ཡུལ་ཅན་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་བས་ན་ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་དད་དུ་ཡོད་པའི་ཕྱིར་བུམ་པ་ལ་སོགས་པ་བཞིན་དུ་སྒྲ་ཐ་དད་པ་དང་མི་རྟག་པར་གྲུབ་པའི་ཕྱིར་དེ་ཇི་ལྟར།",
    "བློ་གསལ་བ་དང་གཞན་པ་ལ་སོགས་པ་ཐ་དད་པར་འགྱུར་བ་དེ་བཞིན་དུ་སྒྲ་ཡང་རང་ལས་རང་བཞིན་ཐ་དད་པ་མེད་ན་ཡང་གསལ་བར་བྱེད་པའི་སྒྲ་ཙམ་ཐ་དད་པའི་ཕྱིར་རིང་པོ་ལ་སོགས་པ་ཐ་དད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སྐྱོན་མེད་དོ།",
    "འདི་ལྟར་དེ་དག་རིགས་ཀྱི་ཁྱད་པར་ཐ་དད་མ་ཡིན་ཡང་རང་ལས་རིམ་པ་ཡོད་པ་མ་ཡིན་ཏེ་ཆ་ཤས་མེད་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱིས་ཡིན་ཏེ།",
    "དེ་ཡང་རང་ཉིད་འོད་མ་ལ་སོགས་པ་དྲུང་པ་ལས་བྱུང་བ་གང་ཡིན་པ་དེ་འདིར་འཁྲུལ་པའི་ཡུལ་ཉིད་དུ་བལྟ་བར་བྱའི་གང་གཙུབ་ཤིང་གཙུབས་པའི་སྐྱེས་བུས་བྱས་པ་དེ་ལ་སྐྱེས་བུས་མ་བྱས་པ་མི་སྲིད་པའི་ཕྱིར་དེས་གཏན་ཚིགས་འཁྲུལ་པ་མ་ཡིན་ནོ་སྙམ་དུ་བསམས་པ་ཡིན་ནོ།",
    "སྐྱེས་བུས་མ་བྱས་པ་དག་ལ་ཡང་རང་བཞིན་གྱིས་ལོག་པའི་དོན་ཤེས་པའི་རྒྱུ་ཉིད་སྲིད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྐྱེས་བུའི་འདོད་པ་ཡང་རང་དགའ་བ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཉེ་བ་དང་བསྐལ་པ་དག་དུས་མཚུངས་པར་འཛིན་པའོ།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་གྱིས་དམིགས་པར་འགྱུར་བའམ།",
    "དེ་ལྟ་ཡིན་དང་འཇིག་པ་འདི་གཉིས་ཀྱང་རང་བཞིན་མེད་པ་ཡིན་ན།",
    "དེ་ཡང་རང་ཉིད་ལས་གནས་པའི་ཕྱིར་ཐུག་པ་མེད་པ་གང་ལས་ཡིན།",
    "དེ་ལ་ཡང་ཉེས་པ་མེད་པ་ནི་ཡོན་ཏན་དག་ལ་ཡོངས་སུ་ཤེས་ལ་དེ་ལྟ་ན་ཡང་དེ་ལྟ་བུ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རྣམ་པར་གཞག་པ་ཐམས་ཅད་ཉམས་པ་ཐུག་པ་མེད་པའི་གནས་སྐབས་དེ་ཉིད་སོན་འདུག་པ་ཡིན་ནོ།",
    "དེ་དག་དུས་ཕྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "འདི་ལ་ཡུལ་དང་དུས་དང་རང་བཞིན་དང་གནས་སྐབས་ཇི་ལྟ་བ་བཞིན་དུ་སྣང་བ་ཡོད་པ་མ་ཡིན་ལ།",
    "རང་ལས་གྲུབ་པ་ཡིན་ན་ཡང་རང་ཉིད་གསལ་བའི་བདག་ཉིད་ཀྱིས་སམ།",
    "འདི་ལྟར་མི་དམིགས་པ་ཡང་དངོས་པོ་མེད་པའི་བདག་ཉིད་ཡིན་པར་ཇི་ལྟར་གྲུབ་ཅེས་དེ་ལ་ཡང་རང་ངམ་གཞན་ལས་ཞེས་བྱ་བའི་བསམ་པ་འདི་འཇུག་པ་ཉིད་དོ།",
    "རྟག་པའི་ཕྱིར་དང་རང་བཞིན་དུ་བྱ་བར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་དང་སྐྱོན་གྱི་གནས་སྐབས་སོ་ན་འདུག་པ་ཡིན་ནོ་སྙམ་ན།",
    "དེ་ལྟ་བས་ན་ཐེ་ཚོམ་ཟ་བ་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་དད་པས་དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་ཐ་དད་པར་རིག་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་དང་རང་ཉིད་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་ཁས་བླངས་པར་འགྱུར་རོ།",
    "དེ་ཡང་རང་བཞིན་དང་།",
    "གཉིས་ཀ་ཡང་རང་བཞིན་གྱིས་བསྐལ་པས་མི་དམིགས་པར་སྲིད་པའི་ཕྱིར་རོ།",
    "སྐྱོན་རྣམས་རང་བཞིན་མ་ཡིན་པ་ཉིད་ཡིན་ན་ཡང་ཟད་པའི་ཐབས་མི་སྲིད་པའི་ཕྱིར་མི་འདུག་པའམ་སྟེ།",
    "གལ་ཏེ་ཡོད་པ་ཉིད་དང་ཤེས་བྱ་ཉིད་ཡོད་པ་ན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལྡོག་པ་ཡིན་ནོ་ཞེས་ཁྱེད་ཀྱི་ཁས་ལེན་པ་དེ་ལྟ་ན་ནི་ཡོད་པ་ལ་སོགས་པ་ཉེ་བ་ལས་སྔར་འདིའི་མེད་པ་ཉིད་དང་རང་རིག་པས་ཀྱང་ཤེས་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་ཅེས་ཁས་བླངས་པར་འགྱུར་ལ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་བའི་དོན་མཐོང་བར་ཁས་ལེན་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་རྟོག་པ་ཡང་རང་བཞིན་གྱིས་འཁྲུལ་པ་ཡིན་པའི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པ་ལ་མངོན་དུ་འགྱུར་ན་འཁྲུལ་པར་འགྱུར་རོ་ཞེ་ན།",
    "གསེར་གྱི་བྱེ་ཆུང་སྐད་སྙན་པ་སྣ་ཚོགས་སྒྲོག་པ་གཅིག་འདུག་སྐད།",
    "ཚར་གྱིས་འགྲོ་མ་ཤེས་པར་འདུག་སྐད།",
    "ཕན་ཡོན་གྱི་འགྲེལ་བ་ནི་བོད་རྩོམ་ཟངས་མར་འདུག་ཅིང་།",
    "ངེས་པར་འཇམ་པའི་མལ་ཆ་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་སྲུང་བ་བྱས་ནས་ནི།",
    "དེ་དག་ཀུན་ལ་གསོལ་བ་བཏབ་ནས་སེང་ལྡེང་རང་བཞིན་སྲ་བའི་ཕུར་བུ་རྣམས་ཀྱིས་ས་ལ་གདབ།",
    "ཡང་རང་ཉིད་ལྷར་བསྐྱེད་ནས་ཞལ་དག་པ་བྱེད་པའང་མཐོང་སྟེ།",
    "ངེས་པར་འཇམ་པའི་མལ་ཆ་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་སྲུང་བ་བྱས་ནས་ནི།",
    "བསྲུང་རྒྱུ་ནི་འདིར་ཡང་རང་ལུས་ཉིད་ཡིན་པས་ཡན་ལག་དྲུག་ཞེས་པ་ལུས་ཀྱི་ཡན་ལག་ཉིད་ལ་འཇོག་པ་འཐད་ཀྱི།",
    "ཕྱིས་བྱུང་ཁ་ཅིག་ལྟར་དང་པོ་ལྔ་བོ་རང་ལུས་སྲུང་བར་འདུག་ཀྱང་ཕྱི་མ་འདི་ཕྱི་རོལ་ཏུ་བསྲུང་རྒྱུ་ཞིག་ཡིན་ནམ་སྙམ་ནས།",
    "དོན་ལ་མི་གནས་པ་ཤ་སྟག་ཏུ་འདུག་ཅིང་དགག་སྒྲུབ་ཀྱང་འགངས་ཆུང་བས་འདོད་པ་བསྐྱར་བ་ལ་དགོས་པ་མི་སྣང་ངོ།",
    "རྡོ་རྗེ་ཤུགས་གཅིག་པར་ཐད་བརྡོལ་བ་ཁྱེད་རྣམས་དེ་སྐད་སྨྲ་བ་དེ་གཞན་གྱི་སྐྱོར་བཟློས་རྟིང་མ་ཞིག་ཡིན་པར་འདུག་ལ།",
    "བདག་དུས་འཁོར་སྤྲུལ་བའི་སྐུ་ཡིན་ཅིང་།",
    "དེ་རྣམས་གཅིག་ལ་གཅིག་བྲིས་བཤུས་ལྟ་བུར་འདུག་ཀྱང་།",
    "བགེགས་རྣམས་བཅིངས་ཏེ་ཙོག་ཙོག་པུར་འདུག་པའི་སྤྱི་བོ་ནས་བཏབ་པས།",
    "ཕུར་བུ་ཐོ་བའི་སྔགས་ཀྱིས་སྐབས་འདི་དག་ཏུ་སོ་སོའི་ཕྱག་རྒྱ་འཆའ་བའི་ལུགས་ཀྱང་འདུག་སྟེ།",
    "ཐུན་མཚམས་ཀྱི་ལྷའི་སྐབས་སུ་ཡང་བདག་འཇུག་རྒྱས་པ་ལེན་པའི་ལག་ལེན་ཡོང་ཉེན་གདའོ།",
    "ལུས་དང་བྲལ་བའི་མགོ་གཞུག་གཅིག་ཁོ་ན་འགོད་པ་མི་རིགས་ཞེས་པ་ནི་ཁྱེད་རང་ལ་ཡང་མཚུངས་ཏེ།",
    "པདྨའི་འདུག་སྟངས་ཟླ་གམ་གྱི་དབྱིབས་ཅན་ཏེ།",
    "འདི་ལ་བོད་རྣམས་འཇིག་རྟེན་ཁམས་མཉམ་གྱི་ཐ་སྙད་སྦྱོར་བར་འདུག་གོ།",
    "རྡོ་རྗེའི་འོད་ཡིད་གདའ་བའི་ས་དང་།",
    "འགལ་བའང་ཆེར་མེད་པ་ལྟར་སྣང་ཡང་རྒྱུད་འགྲེལ་ལས་གསལ་བར་མ་གསུངས་ཤིང་རང་ལུགས་ལ་མི་བཞེད་དོ།",
    "རྒྱལ་བ་རིགས་ལྔ་ལ་ཡང་རང་རིགས་ཀྱིས་རྒྱས་བཏབ་རུང་བའི་སྐབས་ཤིག་ཀྱང་རྒྱུད་འདིར་གཏན་ནས་མེད་པ་ནི་མ་ཡིན་ནོ།",
    "བྱས་ན་སུས་རྒྱས་བཏབ་ཀྱང་གཞན་རིགས་སུ་མི་འགྱུར་ཞིང་རང་རིགས་ཉིད་དེ་ཀུན་ཁྱབ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡབ་རྡོར་སེམས་ལ་ཡུམ་དབྱིངས་ཕྱུག་མས་འཁྱུད་ཟེར་བ་སོགས་ཀྱང་རང་གང་སྨྲས་པར་ཟད་དེ།",
    "རང་བཟོའི་རྣམ་འགྱུར་དུ་ཤིན་ཏུ་གསལ་བ་ཕལ་གྱིས་གོ་སླ་བ་འདུག་ཅིང་།",
    "ལོགས་སུ་མ་བསྐྱེད་ཀྱང་རུང་བ་ཞིག་ཡིན་པར་འདུག་ཅིང་།",
    "དམིགས་བསལ་གྱི་ཁུངས་འཚོལ་ས་མ་རྙེད་པ་རྣམས་མནོ་བསམ་གང་སྨྲ་གྱི་སྟེང་ནས་བསྒྲིགས་པར་འདུག་པས།",
    "ཁྱེད་རང་ལྟར་ན།",
    "གང་མངལ་བཟུང་བའི་ཟླ་བ་དེ་ཉིད་ཕྱི་རོལ་གྱི་ཟླ་བ་དང་ཞག་དུས་གང་ལ་ཡང་མ་ལྟོས་པར་མ་རིག་པ་ཆུ་སྲིན་གྱི་ཟླ་བར་འཇོག་ཅིང་།",
    "དེ་ནས་ཟླ་བ་བརྒྱད་པ་ལ་གསང་བའི་འཁོར་ལོ་དང་སྤྱི་བོའི་འཁོར་ལོ་ཡང་རང་གནས་སུ་སླེབ་ཅིང་བྱ་བ་བྱེད་ནུས་སུ་གྱུར་བ་དང་།",
    "སྐུ་བཞིའི་རྣམ་དག་རྩའི་རྣམ་དག་དུས་ཀྱི་རྣམ་དག་ཕུང་ཁམས་ཀྱི་རྣམ་དག་མཚན་མའི་རྣམ་དག་བཞུགས་སྟངས་ཀྱི་རྣམ་དག་འཕྲོས་དོན་གྱི་དག་པ་གཞན་ཏེ་བདུན་ལས།",
    "དེ་རྣམས་དག་པ་ས་གའི་འདུག་སྟངས་ལ་སོགས་ལ་ལྔ་ཡིན་ལ།",
    "དེ་ལྟར་ན་ལྷ་སོ་སོར་རང་རང་དང་།",
    "ལྷ་རང་རང་སོ་སོའི་སྟེང་ཕྱོགས་ཀྱི་མདུན་ངོས་སུ་བྱོན་པར་གྱུར།",
    "གཡས་ཀྱི་ཐོ་བ་དྲིལ་བུར་བསྒྱུར་ཏེ་ལྷ་ཐམས་ཅད་ཀྱི་མདུན་དུ་འདུག་ཅིང་།",
    "ཁྱེད་རང་ལ་ཡང་འགལ་ལ།",
    "དོན་དམ་ཀུན་རྫོབ་ཀྱི་སྲིད་གསུམ་དེ་ཀུན་ཡང་རང་བཞིན་ཁྱབ་བྱེད་བདེ་སྟོང་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་སུ་རོ་གཅིག་པ།",
    "དེ་ནི་དཔྱད་པ་མེད་པར་ཁས་ལེན་གྱི་འདུག་ན།",
    "དེ་དང་འདི་ལ་ཁྱད་ཅི་འདུག་ལྟོས་ཤིག་དེས་ན་བསྐྱེད་རིམ་གྱི་ཆ་ལག་ཐིག་ཕྲ་ལ་རྫོགས་རིམ་གྱི་ཐ་སྙད་སྐབས་འགར་སྦྱར་བ་ལ་ཉེས་པ་ཅི་ཡོད།",
    "སྔགས་ཀྱི་ལྷ་ལ་རྣམ་རྟོག་ཀྱང་མེད་ཅིང་རང་ལས་གཞན་དུ་གྲུབ་པ་ཡང་མེད་དེ།",
    "འོན་ཀྱང་རང་ལུགས་ནི་འདི་ཡིན་ཏེ།",
    "རང་རང་ས་བོན་ལ་སྤྱི་དང་མཐུན་པར་དེ་ཉིད་གསུམ་སྤེལ་ལམ་ལྔ་སྤེལ་དུ་བྱེད་པ་ལྟ་བུའི་ཐུགས་ཀྱི་བཟླས་པ་བྱ།",
    "སྒྲུབ་པོའི་མིང་ཡིག་དང་པོ་ར་ཡིག་ལ་སྔགས་ཀྱི་དང་པོ་ལོ་ཙ་ན་ལྟ་བུ་ལ་ཡིག་ས་ཁམས་ཡོད་ན།",
    "ཡང་རང་ལུས་ཕལ་བ་རྩ་འཁོར་ལས་བྱུང་བའི་རྡོ་རྗེ་དང་བཅས་པ་བཞག་ནས།",
    "མཁའ་འགྲོ་མའི་གཏོར་སྔགས་ཀྱང་དེ་ལ་འཐུས་པར་མཛད་པའི་སྲོལ་ཞིག་རྗེ་ཕྱོགས་པ་མན་ཆད་ལ་བྱུང་འདུག་ཀྱང་།",
    "གཞལ་ཡས་ཁང་གུར་དང་བཅས་པ་བཅུ་གཅིག་དུས་གཅིག་ཏུ་བསྐྱེད།",
    "རྩ་བ་མེད་པར་མང་དུ་སྨྲ་ཞེས་བྱ་བ་དོན་ཏེ་ཁྱེད་དག་རང་ལ་ཚང་འདུག་པ་ངོ་ཤེས་པར་མཛད་འཚལ་ལོ།",
    "ཕ་རོལ་སུན་འབྱིན་ཅིང་རང་གཞུང་འཛུགས་པ་དགོས་པ་དང་།",
    "དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་མངོན་སུམ་ཞེས་པ་ཡང་བསྐྱེད་རིམ་ལ་བརྟན་པ་ཐོབ་པའི་གང་ཟག་དེ་ཚེ་འདིར་ས་བདུན་པ་ངེས་པར་ཐོབ་ཅེས་པར་གོ་འདུག་སྟེ།",
    "ཞེས་བསམ་པར་འདུག་སྟེ།",
    "ཞིང་སྣ་ཚོགས་སུ་མི་རྒྱུ་བར་གནས་གཅིག་ཏུ་འདུག་པ་ལ་ནི།",
    "གནས་དང་ལོངས་སྤྱོད་དང་འཁོར་རྣམས་སྔགས་ཀྱིས་སྤྲུལ་བའམ་ལྷ་རྫས་ཀྱི་རང་བཞིན་དེ་ཡང་རང་ལ་ཇི་ལྟར་སྣང་བ་དེ་ཙམ་ཁྱབ་པར་འགྱུར་ཏེ།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "གར་ལ་ལྟ་བའི་ཁྲོད་ན་འདུག་པ་ཞིག།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "དེ་རིང་སང་རང་འཆི་བར་ཐག་ཆོད་པ་ན།",
    "ད་དུང་མི་འཆི་སྙམ་པ་འདི་ལ་ཐུག་འདུག་པས་ན།",
    "འཕྲོ་ནས་ཞུས་ཙ་ན་འཕྲོ་ཡེ་མ་ཐོད་པ་ཞེས་གསུང་ལོ།",
    "དེ་ཡང་བུ་ལོན་དང་བཅོལ་བ་ལ་གཡོ་བྱས་པ་དང་གཡོ་ཐབས་གཞན་གྱིས་ཀྱང་མ་བྱིན་པར་ལེན་པ་དང་རང་ངམ་གཞན་དོན་ན་ཕ་རོལ་ལ་གནོད་པ་སོགས་ཀྱི་ཕྱིར་བྱེད་ནའང་མ་བྱིན་ལེན་ནོ།",
    "དེ་བཞིན་དུ་འཐོབ་བྱ་མཆོག་དམན་དང་རང་གཞན་གྱི་དོན་ལ་དམིགས་པ་སོགས་བསམ་པའི་ཁྱད་པར་དང་།",
    "རྒས་པ་ཁད་ཀྱིས་ཁད་ཀྱིས་འོང་བས་དྲག་དུས་གཅིག་ལ་འོང་ན་བསྲན་ཐབས་མེད་གསུང་ངོ།",
    "ངོ་བོ་ཉིད་ཀྱིས་བདེ་བའི་རྒྱུ་ཡིན་ན་སྡུག་བསྔལ་གྱི་རྒྱུ་ཇི་ལྟར་བསྟེན་པ་ཙམ་གྱིས་སྡུག་བསྔལ་ཇེ་འཕེལ་དུ་འགྲོ་བ་བཞིན་དུ་འགྲོ་འདུག་ཉལ་བ་དང་།",
    "ཉེ་ཉོན་རྣམས་ངོ་ཤེས་པར་བྱས་ནས་ཆགས་སྡང་ལ་སོགས་པ་གང་རུང་རྒྱུད་ལ་སྐྱེས་ཙ་ན་འདི་དེ་ཡིན་ཨང་།",
    "སྔར་དེ་ཙམ་ཞིག་འཁྱམས་པ་ལ་རང་ལོག་མ་བྱུང་ཙ་ན་ད་ཡང་རང་ལོག་མི་འོང་བས་བཟློག་དགོས།",
    "མུ་གེ་བྱུང་ཙ་ན་ཐམས་ཅད་ནས་ཀྱི་སྟེང་དུ་འོང་།",
    "ཤིན་ཏུ་རྙེད་སླའི་རྩྭ་ཁམ་འགའ་ལྟ་ཕྱུགས་ཀྱང་རང་ཉིད་ཟ།",
    "རང་ཕུན་ཚོགས་ཤིག་བྱེད་པར་འདོད་ཀྱང་རང་དོན་གཙོ་བོར་བཟུང་སྟེ་ཐབས་མ་ཡིན་པ་ལ་ཞུགས་པས།",
    "དེ་ཡང་རང་ངོས་ནས་གདུལ་བྱ་དེ་ལ་སྦྱར་བ་དགོས་ཀྱི་གདུལ་བྱ་དེ་ལ་བསམ་པ་དེ་མ་སྐྱེས་ན་ཉེས་པར་འགྲོ་བ་མ་ཡིན་ཏེ།",
    "སྡུག་བསྔལ་བྱུང་བ་དེ་སླར་བཅོས་སུ་འདུག་ན་ནི་ཡིད་མི་དགའ་བ་བྱ་མི་དགོས་ལ།",
    "དེ་འདུག་མ་ཐོག་ཏུ་སེམས་འཇོག་སྟེ།",
    "ལུས་ནི་ཧ་ཅང་དགྱེ་བ་དང་དགུ་བ་མིན་པར་དྲང་པོར་བསྲངས་ལ་དྲན་པ་ནང་དུ་བཞག་སྟེ་འདུག་པར་བྱའོ།",
    "དེ་ཡང་བློས་གསར་དུ་བསྐྱེད་པ་དང་རང་བཞིན་གྱིས་བཞུགས་པ་གསལ་འདེབས་པ་གཉིས་ལས།",
    "འདི་ཙམ་ཞིག་ལ་བཞག་ན་བྱིང་བ་སྐྱེ་སླ་བར་འདུག་སྙམ་པའི་ཚད་དེ་ལས་ཀྱང་འཕང་མཐོ་བའི་འཇོག་ཚུལ་ལ་བྱའོ།",
    "ཐུན་གཅིག་གམ་ཇི་སྲིད་ནུས་པ་དེ་སྲིད་དུ་འདུག་པར་བྱའོ།",
    "སེམས་མུན་པ་ལྟར་འདུག་པ་དང་།",
    "གང་ཚེ་ཐ་མལ་འདུག་པ་ཡང་།",
    "ང་རང་བཞིན་མེད་པར་གཏན་ལ་དབབ་པ་དང་།",
    "གང་ཟག་ལ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་རྡུལ་ཙམ་མེད་ཀྱང་།",
    "དེའི་ཕྱིར་ཡོད་པར་དམིགས་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་དོ།",
    "ཀུན་རྫོབ་དེས་གང་ཞིག་བདེན་པར་སྣང་ཞིང་རང་བཞིན་མེད་བཞིན་དུ་རང་བཞིན་དུ་སོ་སོར་སྣང་བ་དེ་ནི་འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་ཀུན་རྫོབ་ཏུ་བདེན་པས་འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་བདེན་པ་སྟེ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "བདག་མེད་པ་དང་རང་བཞིན་མེད་པའི་ངེས་པའི་རྒྱུན་བསྐྱང་བར་བྱའོ།",
    "ཡོངས་གྲགས་སུ་གླེང་བཞིན་པའིསྔོན་བྱོན་མཁས་པའི་གསུངས་པ་བདེན་པར་འདུགཅེས་པ་ལས་མ་འདས་ལ།",
    "གྲངས་རིག་འཕེལ་རྒྱས་ཀྱི་ཁེར་རྐྱང་རང་བཞིན་ཅན་གྱི་ཞིབ་འཇུག་དེ་ནི་འདིའི་རིགས་ཡིན།",
    "གྲངས་རིག་གཞུང་ལུགས་ཀྱིགསོག་གཉེར་རང་བཞིན་ནི་གྲངས་རིག་འཕེལ་རྒྱས་དང་ཁེར་རྐྱང་རང་བཞིན་ཡིན་པའི་མངོན་ཚུལ་གཅིག་ཡིན།",
    "བརྗོད་པ་འདི་དག་དུས་སྐབས་དེར་བཀྲམས་སྤེལ་བྱེད་མ་ཐུབ་པ་དང་།",
    "སྔོན་མཐོང་རང་བཞིན་གྱི་ལུགས་མཐུན་རྗོད་གཞིའམ་ངེས་སྲོལ་གྱི་བདེན་དཔང་དེ་ཆད་ལྷག་མེད་པར་གཏན་ཚིགས་རྣམ་འབྱེད་ཀྱི་རྨང་གཞི་སྟེང་དུ་འཛུགས་དགོས་ཞེས་གསུངས་སོ།",
    "རིགས་སྡུར་རིགས་བསྒྲེ་ནི་ཁ་གཏད་གཉིས་བར་གྱི་ས་འདུག་སྟངས་དང་ཉེ་མཚུངས་ལ་སོགས་པའི་ཕྱོགས་སྣ་ནས་གནས་གཞན་པར་དྲངས་པའི་ཉེ་མཚུངས་སམ་འདྲ་མཐུན་གྱི་གཏན་ཚིགས་རིགས་བསྒྲེ་ཐབས་ལམ་གཅིག་གྲུབ་པ་དེར་ཟེར།",
    "གྲངས་རིག་པ་དེར་དེའི་ནང་དོན་གྲུབ་ཚུལ་སྟེང་དང་ཐབས་ལམ་སྟེང་དུའང་རང་ཉིད་ཀྱི་མཛེས་སྡུག་ཅིག་ལྡན་པ་ཡིན།",
    "ཐད་ཚོར་ལུགས་ཀྱིས་གྲངས་རིག་པའིརློམ་རུང་རང་བཞིན་ག་ལ་བསམ་བློ་གཏོང་བ་དང་།",
    "བྱ་དངོས་གང་རུང་ཞིག་བདེན་པའང་ཡིན་ལ་རྫུན་པའང་ཡིན་པའི་དཔེ་མི་སྲིད་ཅེས་པ་དེ་ལམིན་ན་མིནཞེས་པས་མཚོན་དགོས།",
    "དོན་སྤྱིའི་རྒྱུ་དང་རིགས་བལྟོས་བཅས་སུ་གདའ།",
    "དོན་སྤྱི་ནས་བཏོན་པའི་མཚན་ཉིད་འཇོག་དུས་ན།",
    "མཇུག་སྡུད་ལ་ལར་ཡང་ཐག་གཅོད་ཚིག་དུ་མ་འདུས་འདུག་དཔེར་ན།",
    "འགྲོ་བ་དང་ནི་འདུག་པ་ན།",
    "ཅུང་ཟད་གསོན་པོར་འདུག་པ་ན།",
    "དེ་ལྟར་སོ་སོར་གཞན་ལའང་རང་སྡུག་པས།",
    "ཁྱིམ་འདུག་ཉེས་རྩོམ་བྱེད་པ་དག།",
    "འགྲེང་དང་འདུག་དང་དེ་བཞིན་ཉལ་བ་དང་།",
    "གཉེན་འདུན་དབུས་ན་ལམ་མེར་འདུག།",
    "འགའ་ཞིག་རི་བོའི་སྤོ་ལ་འདུག་ནས་སུ།",
    "དག་དང་མ་དག་རང་རང་བྱེད།",
    "ལྡང་བའི་དུས་ཚེ་འདུག་པར་བྱེད་པ་དང་།",
    "རབ་ཏུ་གཡོ་བ་མེད་འདུག་པ།",
    "རྡུལ་དང་དྲི་མས་མ་ཡིན་ཅོག་པུར་འདུག་ལ་འབད་པ་ཡིས།",
    "གང་ཞིག་འདུག་ནས་རྡུལ་བྲལ་བ།",
    "འདུག་ནས་རྡུལ་བྲལ་སེམས་པ་དེ།",
