    "དང་པོ་ནི་གང་གིས་རྟེན་ཅིང་ཞེས་པ་རྐང་པ་དང་པོ་སྟེ།",
    "ཀ་ལ་འཇིགས་མེད་ཀླུ་སྒྲུབ་ཉིད་ཀྱིས་མཛད་པར་གྲགས་ན་ཡང་པ་ར་ན་རེ་མིན་ཟེར།",
    "དེའི་ཕྱིས་ཟླ་གྲགས་ཀྱིས་རང་རྒྱུད་སུན་ཕྱུང་ནས་བུ་ཏ་པ་ལི་གཞུང་བསྐྱངས་ཏེ་ཐལ་འགྱུར་དུ་བཀྲལ་བ་དང་བཞིའོ།",
    "སློབ་དཔོན་ཁ་ཅིག་ན་རེ་བུ་ཏ་པ་ལི་ཏའི་སྒྲའི་དོན་ལྟར་ན་འབྲས་བུ་ནི་བྱེད་པ་པོ་པོ་ཡིན་ལ།",
    "དང་པོ་མི་འཐད་དེ་བུམ་པ་གྲུབ་ཟིན་པ་འདི་ཡང་རྫ་མཁན་ལ་སོགས་པའི་རྒྱུ་ལ་རྟེན་པར་ཐལ་བས་སོ།",
    "གཉིས་པ་ལྟར་ཡང་མི་འཐད་དེ་རི་བོང་རྭ་ཡང་རྒྱུ་ལ་རྟེན་པར་ཐལ་བས་སོ།",
    "དུས་མཉམ་པ་ལ་བརྟེན་ནས་ཞེས་པའི་རིམ་པ་སྟོན་པའི་ཚིག་གི་དོན་སྦྱར་པ་མི་འཐད་པས་མ་ལེགས་ཤེའོ།",
    "གལ་ཏེ་ཁྱོད་ན་རེ་རྒྱུའི་དུས་ན་འབྲས་བུ་དངོས་པོ་ལ་མེད་ཀྱང་བློས་ཡོད་པར་སྒྲོས་བཏགས་ནས་རྒྱུ་ལ་བརྟེན་ནས་སྐྱེ་ཞེས་བྱ་ལ།",
    "འགག་པ་ལ་སོགས་པ་གང་ཡང་ཡེ་ཤེས་དེ་དག་གི་ཡུལ་ན་མེད་དོ།",
    "དོན་གཉིས་པ་བརྩད་པ་སྤང་པ་ལ་གསུམ་ལས་དང་པོ་བརྩད་པ་ནི་ཊི་ཀ་འཁན་གཞན་དག་ནི་སློབ་དཔོན་གྱི་མཆོད་བརྗོད་འདི་ལ་རང་གི་ཚིག་དང་འགལ་བ་དང་།",
    "ངའི་མ་མོ་གནམ་ཞེས་པ་ལྟར་རང་གི་ཚིག་དང་འགལ་ལོ།",
    "གཞི་ཐ་དད་པ་ལ་མ་དང་མོ་གཤམ་མི་འགལ་བ་ལྟར།",
    "འཕགས་པའི་ཡེ་ཤེས་ཀྱི་ངོ་ན་མེད་པར་བསྟན་པ་ཡིན་པས་རང་གི་ཚིག་དང་འགལ་བ་ག་ལ་ཡོད།",
    "བརྒལ་བ་གཉིས་པ་ནི་སློབ་དཔོན་གཞན་དག་ན་རེ་ཉེས་པས་སྔར་གྱི་དེ་དག་དེ་ལྟར་མི་འོང་ཡང་།",
    "ཆགས་པ་དང་སྡང་བ་དང་ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་གསུམ་ལས་བྱུང་སྟེ།",
    "ཞི་ཞེས་པ་ནི་མཐར་ཐུག་གི་དགོས་པ་སྟེ་སྐུ་གསུམ་གྱི་རང་བཞིན་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པ་ཐོབ་སྟེ།",
    "རང་གིས་རྟོགས་ནས་སྟོན་པ་མིན་པས་ནའོ།",
    "བུ་ཏ་ནི་དེ་དག་རང་གིས་མངོན་སུམ་དུ་རྟོགས་ཏེ་སྟོན་པས་ན་དམ་པའོ།",
    "ལུང་ལས་དགེ་སློང་རྣམས་ཀྱི་ཉོན་མོངས་པ་ཆད་ནས་རྟག་པ་མྱ་ངན་ལས་འདས་པའི་གནས་ཐོབ་བོ་ཞེས་གསུངས་པ་དང་།",
    "རིགསཔས་ཀྱང་ཆད་པ་དོན་དམ་དུ་ཡོད་དེ་དགེ་སློང་མྱ་ངན་ལས་འདས་པ་ཐོབ་པ་རྣམས་ཀྱི་ཉོན་མོངས་པ་དོན་དམ་པར་མ་ཆད་ན་ཕྱིས་ཡང་སྐྱེ་བར་ཐལ་བ་ལས་མི་སྐྱེ་བས་ཆད་པ་དོན་དམ་ཡིན་ལ།",
    "དེ་ཐོབ་ནས་ཕྱིར་ལྡོག་པར་ཐལ་བ་ལས་མི་ལྡོག་པས་ན་རྟག་པ་དོན་དམ་པར་ཡོད་ཅེས་པའི་རིགས་པ་དང་འགལ་བར་འགྱུར་བས་ན་རྟག་པ་དོན་དམ་དུ་ཡོད་པས་དེ་གཉིས་དོན་དམ་དུ་འགག་པ་མི་འཐད་དོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ན་ཁྱོད་ཀྱི་ལུང་རིགས་གཉིས་དང་ཡང་འགལ་བ་མེད་དེ།",
    "དོན་གཉིས་པ་གཞུང་གི་དོན་ལ་རབ་ཏུ་བྱེད་པ་ཉི་ཤུ་རྩ་བདུན་ལས།",
    "སྐྱེ་བའི་སྤྱི་བཀག་ནས་སྐྱེ་མེད་དུ་བསྟན་པས་ཆོག་མོད་ཅེ་ན་ཞེས་པའོ།",
    "ཡང་ན་སྐྱེ་བ་ཐུག་མེད་དུ་ཐལ་ཏེ་ཡོད་པ་སྐྱེ་བའི་ཕྱིར་རོ།",
    "མེད་པ་སྐྱེ་ན་རྒྱུ་ས་བོན་ལ་མྱུ་གུ་མེད་པ་སྐྱེ་བ་ལྟར་རི་བོང་རྭ་ཡང་སྐྱེ་བར་འགྱུར་ཏེ་ཐམས་ཅད་ལས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་མེད་པ་སྐྱེ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ཐལ་བ་ལས་མ་ཡིན་པས་ས་བོན་ལས་མྱུ་གུ་མེད་པ་ཡང་མི་སྐྱེ་ཞེས་ཐལ་བ་ཕར་ལོག་ཚུར་ལོག་གིས་གཞན་ལས་སྐྱེ་བ་འགོག་པའོ།",
    "དང་པོས་མ་ཡིན་ཏེ་ཚིག་ཙམ་གྱིས་གྲུབ་ན་རང་བཞིན་ཡོད་པ་ཉིད་དུ་ཡང་ཚིག་ཙམ་གྱིས་གྲུབ་པར་ཐལ་བས་སོ།",
    "གཉིས་པ་ལུང་གི་ཚིག་ཁྱད་པར་ཅན་གྱིས་གྲུབ་པར་འདོད་པ་ལ་གསུམ་སྟེ།",
    "དེ་ལས་དང་པོ་བརྟག་པ་གསུམ་གྱིས་འགོག་པ་ནི་སྐྱེས་བུ་ཁྱད་པར་ཅན་ཉེས་པ་ཟད་པའི་ཚིག་གིས་གྲུབ་པར་འདོད་དམ།",
    "སྐྱེས་བུས་མ་བྱས་པའི་རིག་བྱེད་གྱི་ཚིག་གིས་གྲུབ་པར་འདོད་དམ།",
    "གང་ཡིན་མྱི་ཤེས་པས་དེའི་ཚིག་གིས་སྒྲུབ་པར་མི་འཐད་དོ།",
    "འོན་དེ་ཚིག་གི་འབྲེལ་བ་སྐྱེས་བུས་མ་བྱས།",
    "དང་པོ་ལྟར་མི་འཐད་དེ་འབྲེལ་བ་སྐྱེས་བུས་མ་བྱས་པར་དངོས་པོ་ལ་གནས་ན་བརྡའ་མ་བསླབས་པ་རྣམས་ཀྱིས་ཀྱང་སྒྲ་དོན་འབྲེལ་པ་རིག་པར་ཐལ་བས་སོ།",
    "གཉིས་པ་ཡང་མི་འཐད་དེ་སྒྲའི་ངོ་བོ་སྐྱེས་བུའི་བྱེད་པ་ལ་ལྟོས་ཤིང་རེས་འགའ་མ་བྱས་ན་རྟག་པར་དམིགས་པས་སོ།",
    "དེས་ན་རང་བཞིན་མེད་པར་མི་འགྲུབ་བོ་ གཉིས་པ་ལུང་གི་ཡུལ་མ་ཡིན་པས་མི་འགྲུབ་སྟེ།",
    "དེ་དག་ནི་གང་ཟག་གི་བདག་མེད་པ་ལ་དགོངས་པ་ཡིན་ནམ།",
    "འོན་དེ་རྗེས་དཔག་གིས་གྲུབ་པར་འདོད།",
    "ཕ་རོལ་གཟིགས་པ་འཕགས་པའི་མངོན་སུམ་གྱིས་གྲུབ་པར་འདོད་དམ་སོ་སོའི་སྐྱེ་བོའི་མངོན་སུམ་གྱིས་གྲུབ་པར་འདོད།",
    "འགྲུབ་ན་འཕགས་པར་ཐལ་བས་སོ།",
    "གལ་ཏེ་མངོན་སུམ་གྱིས་འགྲུབ་པར་མི་འདོད་ཀྱི་རྗེས་དཔག་གིས་འགྲུབ་བོ་ཞེ་ན།",
    "རང་རྒྱུད་ཀྱི་རྗེས་དཔག་གིས་འགྲུབ་བམ།",
    "འོན་ཏེ་ཐལ་འགྱུར་གྱིས་རྗེས་དཔག་གིས་འགྲུབ།",
    "སྐྱོན་དེར་ཐལ་བས་རང་རྒྱུད་པ་ལ་འགེལ་བ་ཡིན་ན་ཡང་དཀའ་ཞེས་པའོ།",
    "གཉིས་པ་ལྟར་ན་ཧ་ཅང་ཐལ་ཏེ།",
    "ཁྱེད་རང་གི་འདོད་པ་དང་ཡང་འགལ་ཏེ།",
    "དེ་ལ་དང་པོར་རང་བཞིན་མི་དམིགས་པ་ནི་དགག་བྱ་ཡོད་ན་སྣང་དུ་རུང་བ་ལ་འཇུག་གི་སྣང་དུ་མི་རུང་བ་ལ་མི་སྣང་བ་མི་དམིགས་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "དགག་བྱ་ཡང་དག་གི་རང་བཞིན་ཡང་ཡོད་ན་སྣང་དུ་རུང་བ་མ་ཡིན་པས་དེ་སྣང་བ་མི་མི་དམིགས་པས་བཀག་ནས་རང་བཞིན་མེད་པ་བསྒྲུབ་ཏུ་མི་བཏུབ་བོ།",
    "རྒྱུ་དང་མི་དམིགས་པ་ཡང་བཟློག་པ་ལ་རྒྱུ་འབྲས་སུ་འགྲུབ་པ་ལ་འཇུག་པ་ལས་ཡང་དག་གི་རང་བཞིན་དང་།",
    "འགྲུབ་ན་ཡང་དག་གི་དངོས་པོ་ལ་གཞི་འབའ་ཞིག་གི་སྟེང་དུ་གཅིག་དང་དུ་མ་ལ་སྩོགས་པས་ཁྱབ་པ་གྲུབ་དགོས་ཏེ།",
    "དེ་དཔེར་ན་ཤ་པ་ལ་ནི་ཤིང་གིས་ཁྱབ་པར་གྲུབ་ན་ཤིང་བཀག་པས་ཤ་པ་མེད་པར་རྟོགས་པ་བཞིན་ནོ།",
    "རང་རྒྱུད་པ་ནི་ཡང་དག་གི་དངོས་པོ་གཅིག་དང་དུ་མས་ཁྱབ་པ་ནི་གང་གིས་ཀྱང་ཁྱད་པར་དུ་མ་བྱས་པའི་བུམ་པ་ལ་སྟོགས་པ་ཡོད་པ་ཙམ་ལ་གཅིག་དང་དུ་མ་ཙམ་གྱིས་སྣང་ཚོད་ཀྱི་གཞི་ལ་ཁྱབ་པ་གྲུབ་པས་ཡང་དག་ཏུ་ཡོད་པ་ནི་ཁྱད་པར་ཡིན་པས་དེ་ལ་ཡང་དག་གི་གཅིག་དང་དུ་མས་ཁྱབ་པ་གྲུབ་པར་འདོད་པས་གཞི་ཡང་དག་ཏུ་ཡང་གྲུབ་མི་དགོས་པས་ཉེས་པ་སྤོང་ངོ།",
    "དེ་ལྟར་རང་རྒྱུད་ཀྱིས་རྗེས་དཔག་གིས་རང་བཞིན་མེད་པར་མི་འགྲུབ་བོ།",
    "གཉིས་པ་ཐལ་འགྱུར་གྱི་རྗེས་དཔག་གིས་མི་འགྲུབ་སྟེ།",
    "ཐལ་འགྱུར་གྱིས་འགྲུབ་པར་འདོད་ན།",
    "གཞན་ཡང་ཐལ་འགྱུར་ནི་ཡུལ་མ་ངེས་པ་ལ་འཇུག་པ་ཡིན་ཏེ།",
    "ཁྱེད་རང་བཞིན་མེད་པར་འདོད་པས་ཐལ་འགྱུར་དུ་མྱི་འཐད་ཅེའོ།",
    "རང་རྒྱུད་པའི་སློབ་དཔོན་པ་ན་རེ།",
    "མི་དམིགས་པའི་རྗེས་དཔག་གིས་སྒྲུབ་ལ།",
    "ཁྱབ་པ་ཡང་གཞི་གང་ཞིག་གི་སྟེང་དུ་ཡང་དག་ཏུ་ཡོད་པ་ལ་ཡང་དག་གིས་གཅིག་དང་དུ་མས་ཁྱབ་པ་གྲུབ་པའི་ཁྱབ་བྱེད།",
    "ཡང་དག་གི་གཅིག་དང་དུ་མ་སྣང་བ་ཙམ་པོ་ལ་འགག་པས་ཡང་དག་གི་རང་བཞིན་བཀག་ནས་རང་བཞིན་མེད་པ་གྲུབ་སྟེ།",
    "བདག་གི་འབྲས་བུ་མ་ཡིན་ཏེ།",
    "གཞན་རིག་གིས་ཡུལ་གཞན་ཡོད་པ་ཡིན་པ་ལ་བརྟག་པ་དངོས་པོར་མེད་པས་སོ།",
    "རང་རིག་གིས་མི་འགྲུབ་སྟེ་རང་གིས་གཞལ་བྱ་རང་གི་ངོ་བོ་ཡིན་པས་གཞལ་བྱ་རྗོད་བྱེད་ངོ་བོ་གཅིག་པ་ཡིན་པས་བདག་དང་རང་རིག་ངོ་བོ་གཅིག་པས་རྟག་པར་ཐལ་བས་སོ་ རང་རིག་པའི་མངོན་སུམ་གྱི་ཤུགས་ཀྱིས་གྲུབ་བོ་ཞེ་ན།",
    "གཞན་རིག་གི་མངོན་སུམ་དོན་མེད་པར་ཐལ་བ་དང་།",
    "གཞལ་བྱ་སྐོག་གྱུར་མེད་པར་ཐལ་བ་དང་།",
    "དེ་ལ་ཤེས་པ་ཐམས་ཅད་རང་གི་ངོ་བོ་ལ་རང་རིག་པའི་ངོ་བོ་ལ་རང་རིག་པའི་མངོན་སུམ་ཡིན་པས་གཟུགས་ལ་སྩོགས་པ་འཇལ་བའི་རང་རིག་པའི་ཤུགས་ཀྱིས་གཟུགས་ཨེ་དེ་པའི་ཡུལ་སྒྲུབ་པ་གཞན་རིག་དོན་མེད་དུ་ཐལ་ལོ།",
    "རྗེས་དཔག་གི་ཤེས་པའི་རང་རིག་པའི་མངོན་སུམ་གྱི་ཤུགས་ཀྱིས་ལ་མེ་ལྡན་ཨེ་དེ་པ་རྟོགས་པས་ན་དེ་དག་མངོན་སུམ་གྱི་གཞལ་བྱར་གྱུར་པས་སྐོག་གྱུར་གཏན་མེད་དུ་ཐུལ་ལོ།",
    "དངོས་མེད་རི་བོང་གི་རྭ་ལ་རྟོག་རྟོག་པའི་རང་རིག་གི་ཤུགས་ཀྱིས་རི་བོང་གི་རྭ་ཡང་གྲུབ་པས་ཀུན་མངོན་སུམ་གྱིས་གཞལ་བྱ་གྱུར་པས་སོ།",
    "དང་པོས་གྲུབ་པས་གྲུབ་པའི་གོ་མི་ཆོད་ཐག་པ་ལ་སྦྲུལ་དུ་འཛིན་པའི་རྟོག་པ་སྤྲུལ་གྲུབ་པར་ཐལ།",
    "མིག་གི་ཡུལ་དུ་ཐལ་བས་སོ།",
    "རྣམ་པ་ཚོགས་པ་ཙམ་གྱིས་དོན་དངོས་སུ་མྱོང་བའི་མྱོང་བ་གཉིས་སྐྱེ་བར་ཐལ་བ་ལས་མེད་པས་སོ།",
    "ཚིག་གི་དོན་དྲུག་ཏུ་འདོད་པ་ཆ་ཤས་དང་བཅས་པའི་རྫས་གཅིག་ཏུ་འདོད་དོ།",
    "ཆ་ཤས་མེད་པའི་གཅིག་གི་རང་བཞིན་དུ་འདོད་པའོ།",
    "རྗེས་དཔག་གཅིག་པུས་གྲུབ་པར་འདོད་པ་ཡང་ཡོད་པ་ལས་གང་གི་ལུགས་ཡིན་ཡང་རུང་སྟེ།",
    "གཅིག་བསྒྲིབས་པས་ཀུན་བསྒྲིབས་པར་ཐལ་བ་དང་།",
    "གཅིག་ཚོན་གྱིས་ཁ་བསྒྱུར་བས་ཀུན་བསྒྱུར་བར་ཐལ་བས་སོ།",
    "ཡང་དག་གི་གཅིག་དང་དུ་མ་གཉིས་སྣང་བའི་ཁྱབ་བྱེད་མ་ཡིན་པས་སྙམ་མོ།",
    "གསུམ་པ་ཁྱབ་པ་ལ་བརྟགས་པ་ལས་གཅིག་དང་དུ་བྲལ་གྱི་ཁྱབ་པ་ཡང་དག་གི་རང་བཞིན་ལ་གཅིག་དང་དུ་མས་ཁྱབ་པར་སྒྲུབ་པའི་སྒོ་ནས་བྱེད་པ་ཡིན་པ་ལ།",
    "ཡང་དག་གི་རང་བཞིན་ལ་གཅིག་དང་དུ་མས་ཁྱབ་པའི་གཞི་གང་ལ་སྒྲུབ།",
    "སྣང་ཚོད་པའི་དངོས་པོ་ལ་སྩོགས་པ་ཉིད་ཡང་དག་གི་དངོས་པོར་བྱས་ནས།",
    "དང་པོ་ལྟར་ན་སྣང་ཚོད་ཀྱི་དངོས་པོ་གྲུབ་བམ་མ་གྲུབ།",
    "གྲུབ་ན་སྣང་ཚོད་ཡང་དག་འཛིན་པས་རང་བཞིན་མེད་པའི་དམ་བཅའ་ལ་མངོན་སུམ་གྱིས་བསལ་བ་བྱུང་བ་དང་།",
    "སྣང་བ་དང་ཡང་དག་གཅིག་པས་ཡང་དག་རང་བཞིན་མེད་ཅེས་པའི་དམ་བཅའ་བའི་ཁྱད་པར་དགོས་པ་མེད་པར་འགྱུར་ཏེ་ཉེས་པ་གསུམ་མོ།",
    "གཉིས་པ་ལྟར་ན་ཡང་དག་གི་དངོས་པོ་གྲུབབམ་མ་གྲུབ།",
    "གསུམ་པ་ལྟར་ན་ཡང་སྒྲ་རང་བཞིན་ཙམ་ལ་གཅིག་དང་དུ་མས་ཁྱབཅེས་བརྗོད་ཀྱང་སྐབས་ཀྱི་འདོད་པ་ཡང་དག་པའི་གཅིག་དང་དུ་མ་དང་བྲལ་ཡིན་པས་ཁྱབ་པ་ཡང་ཡང་དག་གི་དངོས་པོ་ལ་གཅིག་དང་དུ་མས་ཁྱབ་དགོས་པས་ན་དངོས་པོ་ཙམ་ལ་གཅིག་དང་དུ་མས་ཁྱབ་པ་གྲུབ་པས་མི་ཕན་པར་ཡང་དག་ལ་འདོད་དགོས་པས་ཉེས་པ་སྔ་མ་ལས་མི་འདའོ།",
    "རྗེས་འགྲོ་མེད་པའི་དཔེ་ལྟར་སྣང་བར་སོང་བ་ལྟར་འདིར་ཡང་ཚིག་ཏུ་རང་བཞིན་ཙམ་པོ་ལ་ཁྱབ་པ་གྲུབ་ཀྱང་ཞེ་འདོད་ཀྱི་བརྟག་པ་དག་གི་གཅིག་དང་དུ་བྲལ་ཡིན་པས་ཡང་དག་གི་དངོས་པོ་ལ་ཁྱབ་པ་གྲུབ་དགོས་པས་དེ་མ་གྲུབ་པས་མི་ཕན་ནོ།",
    "སྣང་བ་ཡང་དག་གི་རང་བཞིན་དུ་བྱས་པ་ཡང་མི་འཐད།",
    "རིགས་པས་གྲུབ་ཅིང་མི་གནོད་པའི་ཡང་དག་གི་རང་བཞིན་རང་ཡང་མི་འཐད་པས་ན།",
    "གཞན་ཡང་ཡང་དག་གི་རང་བཞིན་གཅིག་དང་དུ་མས་ཁྱབ་ཅེས་འདོད་པ་ཉིད་མི་འཐད་དེ།",
    "སྣམ་བུ་ལ་ཡང་བུམ་པས་ཁྱབ་པར་ཐལ་བས་སོ།",
    "དེ་ཉིད་ཀྱིས་འདིར་མི་འཐད་པས་ཀྱང་རང་བཞིན་མེད་པར་རང་རྒྱུད་ཀྱི་རྗེས་དཔག་གིས་མི་རྟོག་སྟེ།",
    "དང་པོ་ལྟར་ན་མིག་གིས་སྒྲ་ཡང་ཐོས་པར་ཐལ་ལོ།",
    "བསྒྲུབ་བྱ་མེད་དགག་ལས་རྗེས་དཔག་བྱུང་ན་དོན་བྱེད་ནུས་པས་དངོས་པོར་ཐལ་བས་སོ།",
    "ཁ་ཅིག་ན་རེ་དངོས་སུ་འབྲེལ་བ་མེད་ཀྱང་བཟློག་པ་ལ་འབྲེལ་བ་ཡོད་ཟེར་ན།",
    "དེ་ཡང་རྗེས་སུ་འགྲོ་ལྡོག་གཅིག་གིས་གཅིག་སྡུད་པ་ཡིན་པས་ཤེའོ།",
    "བསྒྲུབ་བྱ་དངོས་ལ་འབྲེལ་བ་མེད་ཀྱང་རྟོགས་པ་མི་འགལ་སྙམ་མོ།",
    "དོན་བཞི་པ་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱི་དགོངས་པ་ཐལ་འགྱུར་བ་ཡིན་པ་ཉིད་དུ་ཟླ་གྲགས་རང་གི་ལུགས་རྣམ་པར་གཞག་པ་སྟོན་པ་ལ་གཉིས་ཏེ།",
    "དེ་ལ་དྲི་བ་དང་པོ་ནི་ངེད་རང་རྒྱུད་འདོད་པ་ལ་གོང་གི་སྐྱོན་བརྗོད་པ་དེ།",
    "ཁྱེད་ཐལ་འགྱུར་བ་ལ་ཅི་སྟེ་མི་འོང་སྟེ།",
    "ཐལ་འགྱུར་བ་ཁྱེད་ཁས་བླང་བའམ་དམ་བཅའ་བ་གང་ཡང་མེད་དོ་ཞེས་པ་ཉིད་དམ་བཅའ་བ་ཡིན་པས་དེ་སྒྲུབ་དགོས་ཏེ།",
    "བདེན་པ་གཉིས་ཀྱི་དབྱེ་བ་དོན་དམ་པར་མེད་པར་ཐལ་བ་འདོད་ཐོག་ཡིན་པ་ལ།",
    "ཡང་དག་པར་རྟོགས་པ་ལ་སྒྲིབ་པས་སོ་ དགོས་པ་གོང་གི་སྔོན་གྱི་མཐར་རྟོག་པ་དགག་པ་ལ་སྩོགས་པ་དགག་པའོ།",
    "དེས་ན་ཕན་ཚུན་རྟེན་པས་གང་ཡང་མི་རྟོགས་པར་ཐལ་ལོ།",
    "ཐལ་འགྱུར་གྱི་སྒོ་ནས་སྒྲོ་འདོགས་གཅོད་པའོ།",
    "ཐལ་འགྱུར་གྱི་སྒྲོ་འདོགས་ཆོད་པར་འགལ་ལོ་ཞེ་ན།",
    "དཔེ་ནི་གཞན་གྱིས་བ་ལང་ཉིད་ཅེས་པའི་སྤྱི་དངོས་པོར་གྱུར་བའི་རྟག་པར་འགྲོ་འོང་གི་བྱ་བ་མེད་པ་གཅིག་གསལ་བ་དུ་མ་ལ་ཁྱབ་པར་ཁས་བླངས་པ་ན།",
    "དེ་ལྟར་སྤྱི་དུ་མ་དང་མ་འབྲེལ་བར་ཐལ།",
    "དེ་ལྟར་ན་གཏན་ཚིགས་ཆེན་པོ་བཞི་ཅར་ཐལ་འགྱུར་འབའ་ཞིག་ལས་རང་རྒྱུད་དུ་ཀླུ་སྒྲུབ་མི་བཞེད་དོ།",
    "དེ་ལ་གཅིག་དང་དུ་བྲལ་ཐལ་འགྱུར་དུ་ཅི་ལྟར་བཞེད་ན།",
    "དེ་མི་འཐད་དེ་ཐལ་འགྱུར་གྱིས་དགག་པའི་སྒོ་ནས་རང་བཞིན་ཡོད་པར་མི་འཐད་ཅེས་པའོ།",
    "དེ་ལ་སྤྱིར་ཤེས་བྱ་ལ་ཐལ་འགྱུར་གྱིས་གཅིག་དང་དུ་མ་དགག་པ་དང་།",
    "དང་པོ་ལྟར་ན་གཅིག་བསྒྲིབས་པས་ཀུན་བསྒྲིབས་པར་ཐལ།",
    "གཅིག་ཚོན་གྱིས་བསྒྱུར་བས་ཀུན་བསྒྱུར་བར་ཐལ།",
    "དང་པོ་ལྟར་ན་བུམ་པ་དང་སྣམ་བུ་ལ་ཡང་ཡན་ལག་ཅན་གྱི་རྫས་གཅིག་ཡོད་པར་ཐལ་ཐ་དད་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་ལྟར་ན་ཡན་ལག་ཅན་དུ་མ་ཡིན་པ་ལྟར་རྫས་ཀྱང་དུ་མར་ཐལ།",
    "ཡང་ན་ཡན་ལག་ཀྱང་གཅིག་ཏུ་ཐལ་གཅིག་དང་ཐ་མི་དད་པའི་ཕྱིར་རོ།",
    "དང་པོ་ལྟར་ན་བར་དང་བཅས་ཞེས་པ་བཞིན་དུ་དམིགས་པར་ཐལ་ལོ།",
    "གཉིས་པ་ལྟར་ན་རྡུལ་ཕྲ་རབ་མེད་ན་དབུས་ཀྱི་ལ་ཕྱོགས་དྲུག་གིས་དུས་ཅིག་ཅར་སྦྱར་བས་ཕྲ་རབ་རྡུལ་ཆ་དྲུག་ཏུ་འགྱུར་རོ།",
    "དང་པོ་ལྟར་ན་སྣ་ཚོགས་སུ་སྣང་བ་མེད་པར་ཐལ་ཏེ།",
    "ཤེས་པ་གཅིག་གི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་ལྟར་ན་ཤེས་པ་རྡུལ་ཕྲ་རབ་ཀྱི་ཚད་དང་མཉམ་པ་སིལ་བུ་དུ་མར་གནས་པ་ཡིན་པས་ན་རགས་པར་སྣང་བ་མེད་པར་ཐལ་བ་དང་།",
    "རགས་པ་རྣམ་རྟོག་ལ་སྣང་གི་རྟོག་མེད་ལ་མི་སྣང་ངོ་ཞེ་ན།",
    "གསལ་བར་མི་སྣང་བར་ཐལ།",
    "དེ་ཉིད་དང་གཞན་ཉིད་དུ་བརྗོད་དུ་མེད་ཅེས་པ་དེ་མ་ཡིན་དགག་གི་དངོས་པོ་གཅིག་ཏུ་འདོད་དམ།",
    "དང་པོ་ལ་ཤེས་པ་གཅིག་གི་ངོ་བོར་བདེན་ནམ་དུ་མར་བདེན།",
    "གཉིས་པ་ཤེས་པ་དུ་མར་བདེན་ན་དུ་མ་རྡུལ་ཕྲ་རབ་ཀྱི་ཚད་དང་མཉམ་པའི་ཤེས་པར་ཐལ་ལོ་ རྣམ་བརྫུན་དང་རྣམ་མེད་ཀྱི་ཤེས་པར་བདེན་ཟེར་ན།",
    "དེ་ལ་རྣམ་རྫུན་པ་ན་རེ་མེད་ཀྱང་མ་རིག་པའི་སྟོབས་ཀྱིས་རྣམ་པ་སྣང་བ་ཡིན་ཞེས་མི་འགལ་ཞེས་སོ།",
    "རྣམ་པ་མེད་པར་སྨྲ་བ་བྱེ་བྲག་སྨྲ་བ་རྣམས་ན་རེ།",
