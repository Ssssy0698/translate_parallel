    "གསོག་འཇོག་གི་དྲི་མ་གསལ་ཏེ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "གང་གིས་དེའི་སྦྱིན་པ་ཁ་ན་མ་ཐོ་བ་མེད་པར་འགྱུར་བ་ཡིན་ཞེ་ན།",
    "དོན་ཀྱི་མཆོག་ཐོབ་པར་བྱ་བའི་ཕྱིར་རྣམ་པ་དེ་དག་གིས་ཁྱེམ་པའམ་རབ་ཏུ་བྱུང་བ་དག་ལ་སྦྱིན་པར་བྱེད་ན་སྦྱིན་པ་ནི་ཁ་ན་མ་ཐོ་བ་མེད་པར་འགྱུར་བ་ཡིན་ཏེ་དེ་ནི་གཏོང་བ་སྤེལ་བ་ཞེས་བྱའོ།",
    "དགེ་སྦྱོང་གི་རྒྱན་གང་ཞེ་ན།",
    "དེ་ལྟར་ཚིགས་སུ་བཅད་པ་གཉིས་པོ་དེ་དག་གིས་ནི་ཚོགས་ཀྱི་ལམ་དཀོན་པས་དེ་འབྲས་བུ་དང་བཅས་པར་བྱ་དགོས་པའི་སྒོ་ནས་ཚོགས་ཀྱི་ལམ་འབྲས་བུ་དང་བཅས་པར་བྱ་བ་བསྟན་ཏོ།",
    "མི་དང་ཞེས་བྱ་བས་ནི་བདག་གི་འབྱོར་པ་རྙེད་པར་སྒེབསྟན་ཏོ།",
    "དགེ་སྦྱོང་གི་རྒྱན་རྙེད་པ་བསྟན་ཏོ།",
    "ལུས་ཀྱིས་ལེགས་པར་བྱེད་པ་དང་ངག་གིས་ལེགས་པར་སྨྲ་བར་བརྗོད་པ་དང་།",
    "མིག་གིས་གཟུགས་མཐོང་ན་མཚན་མར་མི་འཛིན་མངོན་རྟགས་སུ་མི་འཛིན་ཅིང་།",
    "འདིར་ཡང་ཚིགས་སུ་བཅད་པ་དྲུག་པོ་དེ་དག་གི་བརྗོད་པར་བྱ་བ་དང་།",
    "དེ་ལ་ཚིགས་སུ་བཅད་པ་དྲུག་པོ་དག་གིས་ཙེབསྡུས་པའི་དོན་ནི་རྣམ་པ་བདུན་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ཚིགས་སུ་བཅད་པ་གཅིག་གིས་ནི་ཐོབ་པར་བྱ་བ་དང་དེ་སྒྲུབ་པ་བདེ་བ་བསྟན་ཏོ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་ཚིགས་སུ་བཅད་པ་གཅིག་གིས་ནི་སྒྲུབ་པར་བྱེད་པ་སྦྱངས་པའི་ཡོན་ཏན་དང་ལྡན་པ་བདེ་བ་བསྟན་ཏོ།",
    "དེ་ནི་རེ་ཞིག་སྤྱིའི་དོན་ཏོ།",
    "རྣམས་སུ་ཡང་ཞེས་བྱ་བ་ནི་བྱེ་བ་ཕྲག་གྲངས་མེད་པ་དག་གིས་ཀྱང་བརྒྱ་ལ་རྙེད་པར་དཀའ་བས་མང་པོའི་ཚིགས་སུ་བསྟན་ཏོ།",
    "ཐོས་པ་ཞེས་བྱ་བ་ནི་རྣ་བའི་རྣམ་པར་ཤེས་པས་ཚིག་གི་བདག་ཉིད་ཐོས་པའོ།",
    "གཟུང་ཞེས་བྱ་བ་ནི་དེའི་རྗེས་ལ་ཐོབ་པའི་ཡིད་ཀྱིས་རྣམ་པར་ཤེས་པའི་ཚིག་གི་བདག་ཉིད་དང་དོན་གྱི་བདག་ཉིད་ཡོངས་སུ་དཔྱོད་པའོ།་།",
    "རྒྱ་མཚོ་ཆེན་པོར་གཉའ་ཤིང་གི་མིག་ཏུ་རུ་སྦལ་ཞར་བ་མགྲིན་པ་ཆུད་ཌཔའི་ཚུལ་གྱིས་གཞན་གྱི་འབྱོར་པ་དང་།",
    "བདག་གི་འབྱོར་པ་ལ་སོགས་པ་རྙེད་པར་དཀའ་བས་བསྐལ་པ་ཆེན་པོ་བྱེ་བ་ཕྲག་བགྲང་བར་འདས་པས་ཀྱང་དེ་དག་ཏྲེརྙེད་པར་དཀའ་བའི་ཕྱིར་རོ།",
    "ཐོས་པ་དང་གཟུང་བ་དང་འཛིན་པ་རྙེད་པར་དཀའ་བ་དག་ནི་ལུང་གི་སྒོ་ནས་རྙེད་དཀའ་བ་ཡིན་ལ།",
    "ཉོན་མོངས་པ་དང་ཉེས་པར་སྤྱོད་པ་གདུང་བར་བྱེད་པ་ཡང་བདེ་བའི་རྒྱུ་ཡིན་པ་དང་།",
    "ལྷག་མཐོང་གི་ཡན་ལག་ལ་གནས་པའོ།",
    "ལྷག་མཐོང་གི་ཡན་ལག་ལ་གནས་པ་ནི་མང་དུ་ཐོས་པ་ཞེས་བྱ་བས་བསྟན་ཏེ།",
    "དགྲ་བཅོམ་པ་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པའི་དགྲ་རྣམས་བཅོམ་པ་བསྟན་ཏོ།",
    "དེ་ལ་འདིར་ཡང་གཞུང་རྒྱས་པ་དེ་དག་གི་བརྗོད་པར་བྱ་བ་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ཚིགས་སུ་བཅད་པ་གཅིག་གིས་ནི་མཆོད་ཅིང་ལུང་དབོག་པ་བསྟན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ཚིགས་སུ་བཅད་པ་གཅིག་གིས་ནི་དེའི་ཕན་ཡོན་བསྟན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ཚིགས་སུ་བཅད་པ་གཅིག་གིས་ནི་ཡང་དག་པར་མི་སྒྲུབ་པའི་ཉེས་དམིགས་བསྟན་ཏོ།",
    "དེ་ནི་རེ་ཞིག་སྤྱིའི་དོན་ཡིན་ནོ།",
    "ཚེ་དང་ལྡན་པ་དག་སོ་ག་པ་རྣམས་ཀྱི་འདས་པ་དང་ལྷག་མ་ཇི་ཙམ་པ་དེ་ཙམ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཚེ་དང་ལྡན་པ་དག་ཅེས་བྱ་བ་ནི་རྒན་པ་དང་གཞོན་པ་དག་ལ་སྙན་པའི་ཚིག་གིས་བོད་པའོ།",
    "དེ་ལ་དུས་ཚིགས་དྲུག་པོ་རེ་རེ་ལ་ཟླ་བ་གཉིས་གཉིས་ཡོད་པས་མང་པོའི་ཚིག་ཏུ་བྱ་སྟེ།",
    "འདས་པ་དང་ལྷག་མ་ཇི་ཙམ་པ་དེ་ཙམ་མོ་ཞེས་བྱ་བ་ནི་ཟླ་བ་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "ལྷག་མ་ཇི་ཙམ་པ་དེ་ཙམ་མོ་བརྗོད་པར་བྱའོ།",
    "གསོ་སྦྱོང་གི་ཉི་མ་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "ལང་ཚོ་དང་གསོན་པས་ཚངས་པར་སྤྱོད་པ་བསྒྲུབ་ཅིང་།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེའི་ཐུཕྱིར།",
    "ཚེ་དང་ལྡན་པ་དག་གིས་བག་ཡོད་པས་རྣལ་འབྱོར་དུ་བྱའོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "སྲོག་གི་བར་ཆད་དང་།",
    "ཚངས་པར་སྤྱོད་པའི་བར་ཆད་ཀྱིས་མུའཇིགས་པ་གང་དག་གི་གསོ་སྦྱོང་གི་གནས་སུ་མ་ལྷགས་པ་རྣམས་སོསྤྱོ།",
    "མི་འདུ་བར་གནང་བ་དེ་དག་ལས་མ་གཏོགས་པ་གཞན་ནི་མཚམས་ཀྱི་ནང་ན་འདུག་ན་གསོ་སྦྱོང་གི་གནས་སུ་མི་འདུར་མི་རུང་སྟེ།",
    "ཡོངས་སུ་དག་པ་དྲི་བ་ནི་མ་ལྷགས་པ་གང་དག་གི་འདུན་པ་ཕུལ་བ་དེ་དག་སྣོད་དུ་འགྱུར་བར་བྱ་བའི་ཕྱིར་རོ།",
    "དེ་ལ་་༧་ཆོ་ག་ནི་དགེ་སྐོས་ཀྱིས་གསོ་སྦྱོང་གི་ཚེ་ཚུལ་ཤིང་བྲིམས་པས་དགེ་སློང་རྣམས་བགྲང་ཞིང་མ་ལྷགས་པ་དངོས་སུ་ཡོད་དམ།",
    "མཐོན་པོར་འདུག་སྟེ་ཕྱོགས་སུ་བལྟ་བ་ལ་སོགས་པ་དག་གིས་བསམ་པ་ཐག་པ་ནས་མཚམས་ཀྱི་ནང་བཙལ་ཏེ།",
    "ཙོག་ཙོག་པོར་ལྤིའདུག་སྟེ་ཐལ་མོ་སྦྱར་ནས་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "བདག་གི་གསོ་སྦྱོང་ཡོངས་སུ་དག་གོ།",
    "ལུས་སམ་ངག་གམ་ལུས་དང་ངག་གི་རྣམ་པར་རིག་བྱེད་ཀྱིས་འདུན་པ་འབུལ་བར་བྱེད་པ་མི་ནུས་ན།",
    "སྟེང་གི་ནམ་མཁའ་ལ་འདུག་པར་མི་བྱསྣེ།",
    "གོམ་པ་གཅིག་གིས་སྐས་ཀྱི་རིམ་པ་གཉིས་ཐོད་རྒལ་དུ་འཛེག་པར་མི་བྱ།",
    "གོམ་པ་གཅིག་གིས་ཐེམ་སྐས་གཉིས་ལ་ཐོད་རྒལ་ཨྱོདུ་འཛེག་པར་མི་བྱ།",
    "གནས་ག་གེ་མོ་ཞིག་ན་དགེ་སློང་བྲོ་འཚལ་བ་སྡུག་བསྔལ་བ་བྲོ་ཚབས་ཆེ་བ་མིང་འདི་ཞེས་བགྱེ་བའི་གསོ་སྦྱོང་ཡང་བཅོ་ལྔ་པ་ལགས་ཏེ།",
    "གནས་ག་གེ་མོ་ཞིག་ན་དགེ་སློང་བྲོ་འཚལ་བ་སྡུག་བསྔལ་བ་བྲོ་ཚབས་ཆེ་བ་མིང་འདི་ཞེས་བགྱི་བའི་གསོ་སྤྱོང་ཡང་བཅོ་ལྔ་པ་ལགས་ཏེ།",
    "གནས་ག་གེ་མོ་ཞིག་ན་དགེ་སློང་བྲོ་འཚལ་བ།",
    "སེན་བྱམོ་བཅུ་ཡིས་ཐལ་སྦྱར་ཏེ།",
    "མི་བསྙེངས་པ་དག་གིས་མྱུ་སྟེགས་ཅན་གྱི་རི་དྭགས་སྐྲག་པར་མཛད་པའི་ཕྱིར་རོ།",
    "སེན་མོ་བཅུ་ཞེས་བྱ་བ་ནི་སོར་མོ་བཅུ་མཚོན་པར་བྱེད་དོ།",
    "ཐལ་སྦྱར་ཏེ་ཞེས་བྱ་བས་ནི་ལག་མཐིལ་གཉིས་ཀྱི་སོར་མོ་བཅུ་ཐལ་མོ་སྦྱར་ཏེའོ།",
    "ཐལ་མོ་སྦྱར་ཏེ་ཅི་ཞིག་བྱ་ཞེ་ན།",
    "བསྒྲུབ་པར་བྱ་ཞེས་བྱ་བ་ནི་སྤྱོར་བ་དང་དངོས་དང་མཇུག་གི་སྒོ་ནས་ནན་ཏན་དུ་བྱའོ།་།",
    "ཕྲ་རྣམས་ལ་ཞེས་བྱ་བ་ནི་བཅས་པའི་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པ་ཕྲ་མོ་རྣམས་ལའོ།",
    "ཕྲ་མོ་རྣམས་ལ་ཡང་བརྟུན་ཅིང་བྱེད་པ་ཉིད་བྱ་ན།",
    "དེ་དག་གིས་དྲང་སྲོང་ཆེན་པོས་ཇི་སྐད་གསུངས་པ་བཞིན་བསྒྲུབ་པ་དང་།",
    "ཉོན་མོངས་གཡུལ་ལས་ངེས་རྒྱལ་འགྱུར།",
    "ཉོན་མོངས་གཡུལ་ལས་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པའི་ངོ་བོ་ཉིད་ནི་བདག་དང་གཞན་ལ་གནོད་པ་ཉིད་ཀྱིས་གཡུལ་དང་འདྲ་སྟེ།",
    "ངེས་རྒྱལ་འགྱུར་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་མཐར་བྱེད་ཅིང་མྱ་ངན་ལས་འདས་པའི་འབྲས་བུ་ཐོབ་པར་འགྱུར་བའོ།",
    "ཉོན་མོངས་པའི་གཡུལ་ལས་ངེས་པར་རྒྱལ་བར་འགྱུར་བའི་སྒོ་ནས་ཡང་དག་པར་སྒྲུབ་པ་དེའི་ཕན་ཡོན་བསྟན་ཏོ།",
    "དེ་དག་ཉོན་མོངས་གཡུལ་གྱིས་དཀྲུགས།",
    "དུས་དང་པོར་བྱས་པའི་ཧཱུཾཚིག་དག་ཇེ་སྟོན་ནས་དེའི་འོག་ཏུ་གསོལ་བ་འབའ་ཞིག་གིས་ལས་འདི་བྱའོ།",
    "ཚོགས་དང་ཚོགས་མཐུན་པར་བྱའོ།",
    "དེ་དག་ནི་གང་གི་ཚེ་བྱ་བར་ཟད་ཀྱི་དུས་ངེས་པ་ནི་མེད་དོ།",
    "འདིར་ཀྱེནི་གསོ་སྦྱོང་གི་དུས་དང་སྦྱར་རོ།་།",
    "འདི་ཡང་གསོ་སྦྱོང་གི་ལས་དང་སྦྱར་རོ།",
    "འདི་ནི་གསོལ་བའི་ལས་ཉི་ཤུ་རྩ་བཞི་པོ་དག་གི་ནང་ནས་གཅིག་ཡིན་ནོ།",
    "ཅང་མི་སྨྲ་ན་ཡོངས་སུ་དག་པས་རེག་པར་བྱ་བའི་ཕྱིར་ཆོ་ག་གླེང་གཞི་རྣམ་པར་གཞག་པའོ།",
    "ཅང་མི་སྨྲ་ན་བདག་གིས་ཚེ་དང་ལྡན་པ་དག་ཡོངས་སུ་དག་པར་རིག་པར་བྱའོ་ཞེས་བྱ་བས་ནི་གླེང་གཞི་རྣམ་པར་གཞག་པའི་ལུང་དབོག་པ་བསྟན་ཏོ།",
    "ཇི་ལྟར་སོ་སོར་དྲིས་ནས་དགེ་སློང་གིས་ལན་བཏབ་པ་དེ་བཞིན་དུ་དགེ་སློང་གི་འདི་ལྟ་བུར་ཡང་ལན་གསུམ་གྱི་བར་དུ་བསྒྲགས་ཕྱེཔར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གླེང་གཞི་རྣམ་པར་གཞག་པའི་ཐབས་བསྟན་ཏོ།",
    "མཐོལ་ན་བདེ་བ་ལ་རེག་པར་གནས་པར་འགྱུར་རོ་ཞེས་བྱ་བས་ནི་དག་པའི་ཕན་ཡོན་བསྟན་ཏོ།",
    "དེ་ལ་བདག་གིས་ཚེ་དང་ལྡན་པ་དག་ལ་ཅི་འདི་ལ་ཁྱེད་ཡོངས་སུ་དག་གམ་ཞེས་དྲིའོ།",
    "དེས་ཀྱང་མི་ནུས་པ་ཉིད་ཡིན་ན་ཐམས་ཅད་ཀྱིས་རེས་ཀྱིས་གདོན་པར་བྱའོ།",
    "རེས་བབ་པའི་ཚེ་ཨྱོདེས་འདོན་མི་ནུས་ན་གཞན་ལ་བཅོལ་བར་བྱའོ།",
    "འདོན་པ་དེ་དག་གིས་ཚིག་ཕྱེད་ཀྱང་མ་སྐྱེ་འཁྲུལ་བར་ལེགས་པར་ཐོན་སྐྱེཔ་ཉིད་ཡིན་ན་གདོན་གྱེ་གཞན་དུ་མི་འཆགས་སོ།",
    "དེའི་དུས་ཁོ་ན་བཞིན་ཉེ་བར་མ་བཟུང་བ་ནི་གསོ་སྦྱོང་གི་དུས་ལས་གཞན་པའི་དུས་སུ་འདོན་པའོ།",
    "དེས་རང་གི་སྟན་ལ་འདུག་སྟེ་འདི་ལྟར་སེམས་བསྐྱེད་པར་བྱ་ཞིང་ཚིག་ཏུ་ཡང་བརྗོད་པར་བྱའོ།",
    "ཚེ་དང་ལྡན་པའི་མདུན་ཚེདུ་མཐོལ་ལོ་མི་འཆབ་བོམཐོལ་ཞིང་བཤགས་ན་བདག་བདེ་བ་ལ་རེག་པར་གནས་པར་འགྱུར་གྱི་མ་མཐོལ་མ་བཤགས་ན་ནི་མི་འགྱུར་རོ།",
    "ཉན་པས་ཕྱིན་ཆད་སྡོམ་མམ་ཞེས་སྨྲ་ཞིང་འཆགས་པས་སྡོམ་མོ་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "རང་གི་སེམས་ཀྱིས་བསྡམས་པར་༦བྱའོ།",
    "ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་གེའདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "མ་མོ་འཛིན་པ་རྣམས་ལ་དྲིས་ཏེ།",
    "ཅི་སྟེ་མ་གྲུབ་ན་དགེ་སློང་དེ་རྣམས་ཀྱིས་གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་བྱེན་གྱིས་བརླབ་པར་བྱའོ།",
    "དགེ་སློང་གཅིག་མཚམས་གཞན་ཀྱི་དགེ་སློང་གི་དྲུང་དུ་འདུག་སྟེ།",
    "གལ་ཏེ་ཆོ་ག་དེ་མ་གྲུབ་ན་དགེ་སློང་གིས་གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "དགེ་སློང་དེ་རྣམས་ཀྱིས་གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "གལ་ཏེ་ཆོ་ག་དེ་མ་གྲུབ་ན་དགེ་སློང་གཅིག་གིས་གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་བྱེན་གྱིས་བརླབ་པར་བྱའོ།",
    "མ་མོ་འཛིན་པ་རྣམས་ལ་དྲིས་ཏེ།",
    "འགྲོགས་བཤེས་གང་ཡིན་པའི་དྲུང་དུ་སོང་སྟེ།",
    "དགེ་སློང་གཅིག་གིས་གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
