    "སངས་ཙ་ནསཡཔ་ཀམ་ཚ་རྒྱས་ཀྱི་ས་ཁོ་ན་ན་ཡོད་དོ།",
    "འབྲས་བུ་དང་རང་བཞིན་དང་།",
    "ཐ་སྙད་ནོར་བའི་དོན་ཅན་ཡིན་ཡང་རང་མཚན་ལ་མི་བསླུ་བར་བསྟན།",
    "ཐ་སྙད་འཁྲུལ་བར་འདྲ་ཡང་རང་མཚན་ལ་བསླུ་མི་བསླུ་མི་མཚུངས་པར་བསྟན་པ།",
    "རང་བཞིན་མ་དམིགས་པའི་གཏན་ཚིགས་འཇུག་དུས་སོ།",
    "སྐྱེས་བུ་དང་རང་བཞིན་གཅིག་ཏུ་ཞེན་པ་ལ་མི་ལྟོས་པ།",
    "རྟོག་པའི་གཟུང་རྣམ་དེ་མིང་རང་མཚན་ཁོ་ནས་གཏད་པར་འདོད་པ་དགག།",
    "དེ་ཙམ་ལྔ་བདེ་སོགས་དང་རང་བཞིན་གཅིག་ཡིན་པས་ཅིག་ཅར་འཛིན་པའི་རྩོད་པ་དང་།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "ཕྱི་རོལ་དོན་ཡོད་དུ་ཆུག་ཀྱང་རང་རིག་འབྲས་བུར་རིགས་པའི་རྣམ་གཞག་གསུམ་པ་བསྟན་པའོ།",
    "དེ་རྐྱེན་གསུམ་གྱིས་བསྐྱེད་ཀྱང་རང་འདྲའི་རྣམ་པ་གཏད་པའི་ཆ་ནས་གཟུང་ཡུལ་དུ་འཐད་པའོ།",
    "རང་༦༣ བ་མཚན་གཟུང་དོན་དུ་བྱེད་པའི་ཤེས་པ་རྣམ་མེད་ཐུག་ཕྲད་དུ་འཛིན་པར་དགོས་ན་ཡང་འདས་པ་བག་པཉྩ་ི་དྲན་པའི་བློ་བློ་ཚུལ་གཉིས་པ་ཅན་དང་རང་རིག་ཏུ་གྲུབ་པ་དང་།",
    "དེ་མིང་རང་མཚན་གཟུང་དོན་དུ་བྱེད་པ་བཀག་ཟིན་པ།",
    "གཟུང་རྣམ་བློའི་ངོ་བོ་ཡིན་ན་༦༨བ་བློ་མངོན་སུམ་དང་རང་རིག་ཏུ་གྲུབ་པ།",
    "དེ་གསུམ་ཡང་རང་རྒྱུད་ལ་བློ་སྒྲུབ་པའི་འབྲས་རྟགས་མིན་པའོ།",
    "དེ་རྣམས་རྟོག་པའི་གཟུང་བྱ་ལ་བཏགས་ནས་བཞག་པ་དེ་ལ་བཏགས་ནས་བཞག་པ་ཡིན་ཡང་རང་མཚན་གྱི་མཐར་ཐུག་པ་ཅན་ཡིན་པས་མི་བསླུ་བར་འཐད་པ།",
    "གསུང་བྱ་རྟེན་འབྱུང་རང་བཞིན་གྱིས་མ་སྐྱེས་པས།",
    "དེ་ལྟར་རིགས་པས་རྣམ་པར་དཔྱད་པ་ནི་ཅི་ཡང་རང་དང་གཞན་གྱི་ངོ་བོས་སྐྱེ་བ་མེད་ལ།",
    "ཁམས་གསུམ་མི་རྟག་པའི་མེ་རབ་ཏུ་འབར་བའི་ནང་དུ་འདུག་པར་ཤེས་པས་དེ་ལས་འདའ་བར་འདོད་ཅིང་།",
    "མྱ་ངན་ལས་འདས་པར་འགྲོ་བའི་ལམ་དུ་རྟོགས་པའི་དངོས་པོ་ལ་མཁས་པ་རྣམས་ཀྱིས་ནི་དངོས་པོ་རྣམ་པར་དབེན་ཞིང་རང་༢༤ན་བཞིན",
    "གང་ཚེ་བར་མར་འདུག་པ་ཡང་།",
    "སྙམ་པ་ཡང་རང་སྣང་ལ་མེད་པས།",
    "འདི་དག་ཀྱང་ཕན་འདོགས་པ་ལ་སྦྱོར་ཡང་རང་རྒྱུད་ལ་དགོས་པ་སྲིད་པས་གཙོ་བོར་རང་ལ་ངེས་པ་བསྐྱེད་པའི་ཡན་ལག་ཏུ་གཞུང་འདི་དག་བཀོད་པར་རྣམ་པ་ཐམས་ཅད་དུ་བཟུང་བར་བྱའོ།",
    "ཤེས་ཀྱང་རང་འདོད་ཡབ་མ་འཕུགས་སུ་ཞུགས་པ་གཉིས་ལས།",
    "མཐའ་གཅིག་ཏུ་འདོད་བྱ་མིན་པ་འདི་དང་མ་བྲལ་བའི་ཐབས་མི་འདུག་སྙམ་ནས་འབྲལ་འདོད་ཀྱི་བློ་སྐྱེས་པ་དེའི་ཚེ་ནི་སྡུག་བསྔལ་འབྲལ་ནུས་དང་།",
    "ཚོགས་རྒྱུན་གང་ལ་ཡང་བཏགས་པ་ཙམ་མ་ཡིན་པའི་གང་ཟག་དང་རང་བཞིན་གཅིག་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་ལས་གསོག་དུས་ཀྱི་གང་ཟག་རྣམ་སྨིན་མྱོང་དུས་ན་མེད་ཅིང་།",
    "མྱོང་དུས་ཀྱི་གང་ཟག་ལས་གསོག་དུས་ན་མེད་ཀྱང་།",
    "དེ་ལ་དང་པོ་བཞི་ནི་མངོན་སུམ་དང་རང་དོན་ལེའུར་རང་ཉིད་ཀྱིས་གཞལ་བྱ་ངེས་པའི་ཐབས་སུ་སྟོན་ལ།",
    "རབ་རིབ་ཅན་ལ་སྣང་བའི་སྐྲ་ཤད་ཀྱང་རང་རྒྱུད་ལྡན་གྱི་སྐྱེས་བུས་ཞེས་སོགས་༦བ་ཁྱབ་བྱེད་མ་དམིགས་པའོ།",
    "གཞི་གཅིག་ཉིད་ཡུལ་སོ་སོ་ལ་ལྟོས་ནས་ཀྱང་རང་མཚན་དང་སྤྱི་མཚན་གྱི་གཞི་མཐུན་དུ་ཁས་ལེན་པ་མིན་ནོ།",
    "སྒྲ་ཙམ་གྱི་བདག་རྐྱེན་ལ་བརྟེན་ནས་རྟོག་པ་ལ་མཚན་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་༩ན་སྣང་བའི་ཡུལ་གང་ཡིན་པ་དེ་རྟོག་པའི་སྣང་ཡུལ་གྱི་དོན་ཡིན་གྱི་དེ་ལ་སྣང་ཡང་རང་མཚན་ནི་རྟོག་པའི་སྣང་ཡུལ་མིན་ནོ།",
    "ཡང་རང་མཚན་སྒྲ་དང་རྟོག་པའི་ཡུལ་དུ་ཁས་བླངས་པ་ན་སྒྲ་དོན་དངོས་པོ་ཡིན་པར་རིགས་པས་ལེགས་པར་མ་ཁེགས་ན།",
    "དོན་བྱེད་ནུས་པ་དེ་ཡང་རང་མཚན་ཁོ་ན་ལས་གཞན་མེད་པས་རང་མཚན་གཅིག་པུ་གཞལ་བྱ་ཞེས་བྱའོ།",
    "དེ་ལ་དཔྱོད་པ་ཡང་རང་མཚན་ཁོ་ནའི་རྟེན་ཅན་ཡིན་ཏེ།",
    "དེ་ཡང་གཟུང་རྣམ་ལ་ཕྱི་རོལ་ཏུ་ཞེན་པས་དེ་ལ་ཡང་རང་བཞིན་སེམས་པའི་བློ་གཞན་ཞིག་བཙལ་དགོས་པས།",
    "སྒོ་གསེབ་ཀྱི་འོད་ཀྱི་སྣང་བ་ཁྱད་པར་གྱི་གཞིར་གཟུང་ནས་དེ་ན་ནོར་བུ་འདུག་གོ་སྙམ་དུ་ཞེན་པའི་ཕྱིར།",
    "གཞི་གང་ན་འདུག་སྙམ་དུ་དཔྱད་པ་དེར་མེད་པས་མ་ཐོབ།",
    "རྣམ་པར་རྟོག་པའི་ཤེས་པས་ཀྱང་རང་མཚན་གཟུང་ཡུལ་དུ་བྱེད་ན་མངོན་དུ་འགྱུར་བས་མངོན་ལྐོག་མི་འགལ་བར་འགྱུར་རོ།",
    "ས་ཀ་ཀ་བ་པཙ་ནས་པན་ཀ་ཏྟཾ་ར་ཏཱིཙྪ་ཀ་ད་༧ངམ་ཡག་ཨརྗེས་དཔག་ཡིན་ན་རྟགས་རྟགས་ཅན་རྗེས་རྟགས་ཅན་གྱི་བློ་ཉིད་མི་བསླུ་བར་དེ་རྟགས་ལ་འབྲེལ་བར་ངེས་པར་ཅེས་པའི་ཉེས་པ་ཡང་མི་གནས་ཏེ།",
    "ནོར་བུ་ཕུགས་དང་འོད་སྒོ་གསེབ་ན་འདུག་པ་ལ་ནོར་བུ་འདུག་སྙམ་པ་རྒྱུ་ལ་ཆུའི་རང་བཞིན་སྤངས་པ་ཡིན་པས་ཆུའི་ཆབ་གང་ལ་མི་བསླུ་བ་སྤངས་ཞེས་བྱ་བ་མེད་ལ།",
    "དེ་མི་སྣང་ཡང་རང་བཞིན་འགལ་བ་འཛིན་པར་མ་གྲུབ་བོ།",
    "དེ་དང་རང་བཞིན་གཅིག་ཡིན་པའི་ཕྱིར།",
    "ས་མྱུག་དུས་མི་མཉམ་ཡང་མྱུ་གུ་སྐྱེ་བའི་བྱ་བ་དང་།",
    "ཀུན་གཞི་མེད་ཀྱང་རང་བཞིན་མེད་པའི་ལས་ཀྱིས་འབྲས་བུ་འབྱིན་ནུས་པར་བསྟན་པ་དང་།",
