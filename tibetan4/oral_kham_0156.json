    "ལ་ཉེ་བར་འདུག་ལ་རྡོ་རྗེ་ལག་པ་གཉིས་ཀས་བཟུང་ནས་ཇསྲིདེ་འབར་བ་དེ་སྲིད་དུ་བཟླས་ནས།",
    "དེའང་རང་རྒྱུད་ཀྱི་བློ་ལྷན་སྐྱེས་ལ་བརྟག་ནས་ངོས་ཟིན་པ་དགོས་ཀྱི།",
    "རང་བཞིན་གྱིས་གྲུབ་ན་བཅོས་མིན་སོགས་ཁྱད་པར་གསུམ་ལྡན་དུ་གྲུབ་དགོས་ཀྱང་ཁྱད་པར་གསུམ་ལྡན་གྱི་དངོས་པོ་དང་རང་བཞིན་གྱིས་གྲུབ་པ་དོན་མི་གཅིག་པ་བཞིན་ནོ།",
    "བདག་ཕུང་རང་བཞིན་གྱིས་གཅིག་ཐ་དད་གང་དུ་ཁས་ལེན་ཀྱང་།",
    "མེ་ཤིང་རང་བཞིན་གྱིས་གཅིག་ཐ་དད་ལ་མངོན་སུམ་གྱིས་གནོད་པ་བསྟན་ནུས་སོ།",
    "དེར་མ་ཟད་བདག་ཕུང་རང་བཞིན་གྱིས་ཐ་དད་པའི་ཕྱོགས་ལའང་མངོན་སུམ་གྱིས་གནོད་སྒྲུབ་བྱ་བར་འོས་ཏེ།",
    "འདི་ལྟར་བདག་ཕུང་རང་བཞིན་གྱིས་ཐ་དད་ཡིན་ན་ཕུང་པོ་ལས་ལོགས་སུ་བདག་དམིགས་དགོས་ལ།",
    "བདག་ཕུང་བོ་ལྔ་དང་རང་བཞིན་གྱིས་ཐ་དད་ཡིན་ན་ངོ་བོ་ཐ་དད་དུ་འགྱུར་བས་དེ་ལྟ་ན་ཕུང་བོ་ལྔ་དང་ལུས་སེམས་གཉིས་སོགས་གདགས་གཞི་ཕུང་བོའི་ཆ་རྣམས་སོ་སོ་རུ་བསལ་བའི་རྗེས་སུ་བདག་ནི་འདིའོ་ཞེས་ཡན་འགར་དུ་ངོས་བཟུང་རྒྱུ་ཞིག་ཡོད་དགོས་ཀྱང་བཟུང་དུ་མེད་དེ།",
    "གཞན་དག་ཡུལ་ཅིར་ཡང་མ་གྲུབ་པ་ལ་བློས་ཀྱང་ཅིར་ཡང་མི་བཟུང་བ་གནས་ལུགས་དང་མཐུན་པར་འདུག་སྙམ་ནས་རིགས་ཤེས་ཡུལ་མེད་དུ་སྨྲ་བ་བྱུང་སྟེ།",
    "འདི་ལྟར་ངའོ་སྙམ་པའི་ཞེན་པ་ཤུགས་ཆེ་ཞིང་རྒྱུན་ཆགས་པས་ན་འཛིན་པ་དེའི་སྣང་ཚུལ་དང་ཞེན་ཚུལ་འདི་ལྟར་འདུག་སྙམ་དུ་བདེ་བླག་ཏུ་ངེས་ནུས་ཤིང་།",
    "དེ་ལྟ་ཡིན་ནའང་རང་བཞིན་མེད་པའི་དཔེར་རུང་ལུགས་ནི་གང་དུ་སྣང་བ་དེའི་ངོ་བོས་སྟོང་བས་གང་དུ་སྣང་བ་དེའི་རང་བཞིན་མེད་པ་ནི་མངོན་སུམ་གྱིས་གྲུབ་པས་དེ་ཉིད་དཔེར་བྱེད་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཟུགས་སྒྲ་སོགས་སངས་རྒྱུས་ལ་སྣང་ཡང་རང་ངོས་ནས་མི་སྣང་བའི་ཞིབ་ཆ་ཐོན་པ་དགོས་ཏེ།",
    "ཞེས་གསུང་གདའ་བས་དགོངས་པ་རྫོགས་ཐབས་སུ་བསམས་ཏེ་ཅུང་ཟད་རྒྱས་ཙམ་ཞིག་ཟུར་དུ་བྲིས་ཡོད་ཅིང་།",
    "ཞིབ་ཏུ་བརྟགས་ན་སྐྱེ་འཆིའི་འཁོར་ལོ་བསྐོར་བའི་ཚུལ་བསམས་ཏེ་སྐྱོ་བའང་མི་རྟག་པའི་སྒོ་ནས་སྡུག་བསྔལ་དུ་སེམས་ལུགས་སུ་གདའ་བས།",
    "བདག་ནི་མལ་སྟན་བཟང་པོའི་ནང་ན་འདུག་བཞིན་དུ་གཉེན་བཤེས་ཀུན་གྱིས་མཐའ་ནས་བསྐོར་ཡང་རུང་སྟེ་སྲོག་འཆད་པ་ཡི་ཚོར་བ་མི་བཟད་པ་དག་ནི་བདག་ཉིད་གཅིག་པུས་མྱོང་བར་འགྱུར་ལ།",
    "གཅིག་ཏུ་གཤིནརྗེའི་ཕོ་ཉ་འཇིགས་འཇིགས་ལྟ་བུར་འདུག་པའི་ཤ་ཚུགས་ཅན་གྱིས་བཟུང་བར་གྱུར་ཅིང་།",
    "དེ་རིང་ཁོ་ན་མི་འཆི་ཞེས་ཅི་བདེ་བར་འདུག་པ་ནི་གཏན་ནས་རིགས་པ་མ་ཡིན་ཏེ།",
    "ཅི་ལྟར་ན་བདག་ཡིད་སོས་དལ་དུ་བདེ་བར་འདུག་སྟེ་འདུག་མི་འོས་སོ།",
    "འོག་མ་འོག་མས་ཚིམ་ནས་འདུག་མི་རུང་ལ།",
    "ཁྱིམ་དུ་འདུག་པའི་ཚེ་ཡང་རྐང་པ་བརྐྱངས་ཏེ་མི་འདུག་ཅིང་ལག་གཉིས་དུས་མཉམ་པར་མི་མཉེའོ།",
    "འགྲེང་འཆག་ཉལ་འདུག་སྤྱོད་ལམ་ཐམས་ཅད་དུ།་",
    "དེས་ན་མི་དགར་བྱས་པ་ལ་ནི་དོན་ཅུང་ཟད་ཀྱང་མི་འདུག་སྙམ་དུ་དགག་གོ།",
    "གཞན་དག་སོ་ནམ་སོགས་དང་རང་གཅིག་པུ་ཐར་ཐབས་ལྟ་བུ་ཆེས་ཤིན་ཏུ་དམན་པའི་ལས་ཀྱང་ལྷུར་བྱེད་ན།",
    "ཡོངས་སུ་ཞེན་ནས་འདུག་པ་ལས་ཅིའི་ཕྱིར་མྱ་ངན་ལས་འདས་པར་མི་འགྲོ་སྟེ་འགྲོར་རིགས་སོ།",
    "གཞན་ཡང་རང་བཞིན་མེད་པ་བློའི་ཡུལ་ཡིན་ནམ་མིན།",
    "ཞེས་གང་རང་བཞིན་མེད་པ་བློས་ཁེགས་ན་དེ་རང་བཞིན་ཡོད་པ་བློས་ཤུགས་ཀྱིས་གྲུབ་པར་གསུངས་པའི་ཕྱིར་རོ།",
    "དཔེར་ན་སྔར་ཤི་བའི་དུག་བྱུག་པ་མ་མྱོང་ཡང་གཞན་རྨུགས་པ་མྱོང་བ་དང་འབྲེལ་བ་ལས་རྨུགས་པ་དེའི་ཚེ་དུག་ཞུགས་འདུག་སྙམ་དུ་ཕྱིས་དྲན་པ་བཞིན་ནོ།",
    "སྟོང་གཞི་དང་སྟོང་བ་སོགས་ཅི་ཡང་རང་བཞིན་མེད་ཅེས་གོམས་པས་ནི་སྟོང་བ་རང་བཞིན་ཡོད་པར་འཛིན་པ་དེ་ཡང་ཕྱི་ནས་སྤོང་བར་འགྱུར་རོ།",
    "ལུང་ཁྱད་པར་བ་གཞན་རྣམས་ལའང་རང་གཞན་དག་རྩོད་པ་དང་བཅས་པ་ཡིན་པའི་ཕྱིར་དོར་བྱུར་འགྱུར་རོ།",
    "མཁའ་བཞིན་སྟོང་པར་འགྱུར་བས་དེས་ན་ཕྲ་རྡུལ་ཡང་རང་བཞིན་མེད་དོ།",
    "དེར་མ་ཟད་ཚོར་བ་བོ་འགའ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མིན་ཏེ།",
    "དེར་མ་ཟད་རིགས་པས་ཀྱང་བདག་ནི་གཟུགས་དང་རང་བཞིན་གྱིས་ལྡན་པ་མིན།",
    "དབུགས་ནང་དུ་རྔུབས་ནས་ཕྱིར་མ་བྱུང་བའི་བར་དེར་ཡང་འཆི་ཉེན་འདུག་པ་ལ་མ་ཤི་བར་སླར་དབུགས་འབྱུང་ཁོམ་པ་དང་མདང་གཉིད་ཀྱིས་ལོག་པ་ལས་ད་ནངས་མ་སད་པའི་བར་དེར་ཡང་འཆི་ཉེན་འདུག་པ་ལ་མ་ཤི་བར་སླར་སད་ཁོམ་པ་གང་ལགས་པ་དེ་ཡང་ནི་ཆེས་ངོ་མཚར་ཆེ་བར་བྱར་འོས་ན།",
    "ཕ་བུ་དང་ས་སྨྱུག་སོགས་ཐ་དད་དུ་རྟོགས་པའི་འཇིག་རྟེན་རང་འགའ་བའི་བློ་ལ་དེ་དག་རང་ངོས་ནས་གྲུབ་པའི་ཐ་དད་དུ་སྣང་ཞིང་སྣང་བ་ལྟར་དུ་གྲུབ་པར་འཛིན་པའི་བློ་ཡང་རང་ཤུགས་ཀྱིས་ཡོད་མིན།",
    "གཞན་ཡང་དཔལ་ལྡན་ཟླ་བས་རང་རྒྱུད་པའི་ཁས་ལེན་ལ་བལྟོས་ཏེ་རྨི་ལམ་གྱི་གཟུགས་དེ་མྱུ་གུ་བདེན་མེད་དུ་སྒྲུབ་པའི་དཔེ་མི་རིགས་ཚུལ་གསུངས་པ་སོགས་དང་ཕྱོགས་མཐུན་དུ་གོ་འདུག་ན།",
    "ཕུང་པོ་ལ་བརྟེན་ནས་བདག་བཏགས་པ་ཞེས་བརྟེན་ནས་ཞེས་པའི་ཚིག་ཡོད་མེད་ཀྱི་ཁྱད་པར་སྐབས་མང་དུ་གསལ་འདུག་ན།",
    "དེ་གཉིས་ཀྱི་ཙམ་སྒྲས་གཅོད་ཚུལ་ལ་ཁྱད་པར་ཡོད་པ་ལྟ་བུར་སྣང་འདུག་ན་དེ་ལྟར་འབྱེད་རིགས་མིན་དང་།",
    "ཞེས་གསུངས་པ་འདི་ནི་བརླང་བ་ཞིག་ཏུ་འདུག་པས།",
    "སྔོན་པོ་ལ་ཡང་རང་མཚན་གྱིས་གྲུབ་པར་སྣང་བའི་ཆ་ཐམས་ཅད་ནས་སྣང་བ་ལྟར་གྱི་དོན་ལ་མེད་ཀྱང་།",
    "ཞེས་གསུངས་པ་སོགས་དང་ཅུང་མི་འགྲིགས་པ་ལྟ་བུར་སྣང་འདུག་ལགས།",
    "དུས་སྔ་ཕྱིར་མི་རུང་ན་རྒྱུ་འབྲས་སུ་དེ་བས་ཀྱང་མི་རུང་བར་འདུག་སྙམ་ནས།",
    "ཀ་བུམ་གང་རུང་ཡིན་མིན་གཉིས་དངོས་འགལ་མིན་པར་འདོད་ན་འགྲིགས་མིན་དོགས་འདུག་ལགས།",
    "མངལ་ན་འདུག་པའི་སྔོན་རོལ་བློ་དེ་ནི།",
    "ཡང་ཡང་རང་བཞིན་དེ་སྒོམ་བྱ།",
    "བློ་ལྡན་ཁྱིམ་ན་འདུག་གམ།",
    "དེའི་གོ་རོ་ཙ་ན་ལ་བརྟེན་པའི་ཆོ་ག་དང་ཕན་ཡོན་གྱི་ལེའུ་སྟེ།",
    "སློབ་དཔོན་བགྲེས་པར་འདུག་པས་ཕྱག་བྱས།",
    "གཞན་གྱིས་མིང་མ་ཐོས་པའི་རྒྱུད་མང་པོའི་ཁུངས་བསྟན་བཅོས་ན་འདུག་སྐད།",
    "གལ་ཏེ་དེའང་རང་རྒྱུད་ཀྱི་ཆེ་བ་སྨོས་པའམ།",
    "དེའང་རང་ལྷའི་ང་རྒྱལ་དུ་འཕོས་ཏེ།",
    "ས་ཆོག་དུས་སུ་རྣལ་འབྱོར་ཆེན་པོ་བསྒོམས་ན་རྒྱས་གདབ་ལ་སེམས་མ་བཞི་མ་གཏོགས་པའི་ཕྱག་རྒྱ་བཞི་དགོས།",
    "ས་མ་ཡ་སྟྭཾ་ཞེས་བྱ་བས་འདུག་པར་བྱའོ།",
    "པདྨའི་འདུག་སྟངས་ཀྱིས་འདུག་ལ།",
    "ཡི་གེ་ཧཱུྃ་ལས་བདག་ཉིད་ཧཱུྃ་མཛད་ཀྱི་ང་རྒྱལ་གྱིས་དབུས་སུ་འདུག་པ་ནི།",
    "ཀུ་ཤ་ཡི་ནི་སྟན་ལ་འདུག་ཅེས་པས་སོ།",
    "འགོས་འབྲོག་དུས་མཚུངས་ཤིང་།",
    "དེབ་འདི་ཀློག་དུས།",
    "དེ་ཡང་རང་གཅེས་འཛིན་ལས་བྱུང་བའི་བསམ་བློ་མ་རུང་དག་ཉུང་དུ་གཏོང་བ་དང་།",
    "དེ་བཞིན་དུ་རྒྱུ་དང་འབྲས་བུའི་འབྲེལ་བ་ཡང་རང་བཞིན་དེ་ལས་མ་འདས་པ་སྟེ།",
    "བདག་ལ་ཐོག་མ་དང་མཐའ་མ་མེད་པར་འདོད་པའི་ཕྱོགས་དེ་ངོས་ཀྱི་བློ་ངོར་འཐད་པ་འདུག།",
    "དེ་ངེས་པར་དུ་བདེན་པར་གྲུབ་པ་དང་རང་བཞིན་གྱིས་གྲུབ་དགོས་པ་ཡིན།",
    "དེའི་ཆ་ཤས་གང་ལའང་རང་ངོས་ནས་གྲུབ་པ་ཞིག་མེད་པར་སྨྲ་བས།",
    "དེ་ཡང་རང་ངོས་ནས་མེད་པ་རྙེད་ཡོང་།",
    "ཡང་རང་ཉིད་ཁོང་ཁྲོ་སློང་བའི་གནས་སྟངས་ཤིག་གམ་ཡིད་དུ་མི་འོང་བའི་ཡུལ་ཞིག་ལ་འཕྲད་སྐབས།",
    "ཞལ་བཙུམ་ཞིང་ལྕེ་རྩེ་ཡ་རྐན་ལ་སྦྱར་བ་བཅས་ཀྱིས་འདུག་དགོས།",
    "ལུས་ཀྱི་འདུག་སྟངས་ཀྱིས་སེམས་ཀྱི་གནས་བབས་ལ་ཤུགས་རྐྱེན་ཏན་ཏན་སྤྲོད་ཀྱི་ཡོད།",
    "ད་དུང་རང་ཉིད་ཀྱི་གཤིས་ཀ་འཇམ་དུ་འགྲོ་བ་དང་།",
    "ཁོའི་ལག་ཤུགས་སྔོན་མ་དེ་ལྷུག་ལྷུག་ཆགས་འདུག།",
    "ཆུ་ཚོད་འགའ་ལ་སྒོམ་ཉམས་ལེན་གནང་བཞིན་འདུག།",
    "ཞེས་ཅུང་ཟད་མཉམ་པར་བཞག་སླར་ཡང་རང་ཉིད་གསང་བའི་བདག་པོ་ཕྱག་གཉིས་པའི་སྐུར་གྱུར།"
  ]
}