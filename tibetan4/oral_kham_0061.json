    "འབའ་རི་ཕྱུག་དང་གནས་པོ་རྡོ་རྗེ་གུར་མགོན་གཉིས་གང་ལ་དམག་སྒར་སྤོས་ན་རྒྱ་མིས་གནོད་པ་མི་ཡོང་བ་དྲག་འདུག་ཞུས་པ་དང་།",
    "སྦྲ་སྒོ་ནས་ལྟ་དུས་རྒྱ་དམག་ཚོ་གཅིག་ཕར་ཙམ་དེ་ནས་ཡོང་བ་མཐོང་།",
    "རྟ་འབོག་ཆེན་པོ་ཞིག་རྒྱབ་པའི་སྟེང་དུ་བཞོན་ནས་འགྲོ་དུས་རྟ་འགྲོ་མི་ཐུབ་ནས་དབུགས་ལྷེམ་ལྷེམ་བྱེད་བཞིན་གཟུགས་པོ་མགོ་མཇུག་ཚང་མར་རྔུལ་ནག་ཐོན་གྱི་འདུག་ཀྱང་།",
    "གཞན་དག་སྦག་ཆེན་རྒྱག་ཤེས་ཟེར་མཁན་དང་ངས་རྒྱབ་ཆོག་ཟེར་མཁན་སུ་ཡང་མི་འདུག་རྒྱ་དམག་དང་འཛིང་དུས་སྦག་ཆེན་རྒྱག་མཁན་གྱིས་གདོང་ལེན་བྱེད་དགོས་ཀྱི་ཡོད་པར་བརྟེན།",
    "དེའི་ནང་རྒྱ་དམག་ལ་ཤི་རྨས་ཕྲན་བུ་ཐུབ་ཀྱང་རང་ཕྱོགས་ལ་ཕམ་ཉེས་ཆེན་པོ་བྱུང་།",
    "རྒྱ་དམག་ལ་བསད་རྨས་བྱས་ཀྱང་རང་ཕྱོགས་ལ་ཤི་རྨས་མང་པོ་བྱུང་།",
    "དེ་ནས་མགུལ་དུ་བཏགས་པའི་གའུ་མཚོན་སྲུང་དང་བཅས་པ་ཕར་ཙམ་བཞག་སྟེ་ཤི་རྫུན་བྱས་ནས་བསྡད་པ་དང་རྒྱ་དམག་ཅིག་འགྲམ་དུ་བྱུང་བ་དང་རྐང་པ་ནས་འཐེན་ཏེ་གྲི་རྒྱབ་ནས་བསད།",
    "དངོས་འབྲེལ་བྱེད་དུས་འཁྱག་ཐོག་ཏུ་ཚིབས་པ་འགྱེལ་བའི་རྐྱེན་ཡིན་པ་ལས་སྤྱི་མཛོད་མི་རྟ་གཉིས་ལ་མེ་མདའ་ཐེབས་མི་འདུག་ངས་ཕ་བཟང་བུ་ཚོ།",
    "ང་དམག་སྒར་འདིའི་ནང་བསྡད་ཀྱང་ཁྱེད་ཚོར་སྲུང་སྐྱོབ་ཀྱི་ཁུར་པོ་ལྗིད་དུ་བཏང་རྒྱུ་ལས་ཕན་ཐོགས་གང་ཡང་མི་འདུག་དེ་བས་རྒྱ་གར་དུ་ཐར་ཐབས་བྱུང་ན་བྲག་གཡབ་ཀྱི་བདེ་སྡུག་རྣམས་གོང་ས་སྐྱབས་མགོན་ཆེན་པོར་ཞུ་རྒྱུ་དང་།",
    "འོ་ན་ཚང་མས་རྒྱ་མིར་མགོ་བཏགས་པ་ལས་འོས་མི་འདུག་ཞུས།",
    "ཁང་ཐོག་རྒྱ་མིའི་སྲུང་དམག་བསྡད་འདུག་ཟེར་མ་ཐག་ཁང་པའི་སྒེའུ་ཁུང་ནང་ནས་མེ་མདའ་མང་པོ་བརྒྱབ་བྱུང་བས་ཕྱི་ནས་སྒེའུ་ཁུང་ལ་གཏད་ནས་མེ་མདའ་བརྒྱབ།",
    "མཐར་ཁོ་རང་ཕ་ཡུལ་དུ་རྒྱ་མིས་བསད་འདུགགཡོག་པོ་རྒྱལ་མཚན་བཀྲ་ཤིས་ཀྱིས་རྒྱ་དམག་གཅིག་དང་།",
    "བྱམས་པས་ཁྱེད་རང་འགྲོ་དགོས་དོགས་མེད་ཟེར།",
    "ཡང་བསྐྱར་སྦག་ཆེན་རྒྱབ་ཀྱང་མདེའུ་གཉིས་གསུམ་ཙམ་ལས་མ་རྒྱུགས་པར་ཁ་འབྱར་ནས་མདེའུ་རྒྱུག་ཐུབ་ཀྱི་མི་འདུག་ལ་མདེའུ་ཡང་སུམ་ཅུ་སོ་གྲངས་ཙམ་ལས་མི་འདུག་གནས་ཚུལ་ནི་ཛ་དྲག་ཅན་དུ་གྱུར།",
    "རྡོ་གཅོད་ཀྱི་ཉེ་བ་ལ་གཏུག་ན་ཧ་ཅང་ཡག་པོ་འདུག་ཟེར།",
    "ད་དུང་ལོ་༦༨ ཡིན་པའི་རྒད་པོ་བཅས་ཕུད་ན་འཛིང་འཕེར་གྱི་མི་ཉི་ཤུ་རྩ་དྲུག་འདུག་དེ་ཉིན་རི་ཁུག་ཅིག་ཏུ་གབ་ནས་བསྡད།",
    "ཇ་སྐོལ་སྣོད་ཧ་ཡང་ཆེ་ཆུང་བཞི་འདུག་སྐྱོགས་ཆེ་ཆུང་ལྔ།",
    "རྩམ་པ་བཅས་བསྡོམས་རྩིས་བྱས་ན་མི་སུམ་ཅུ་སོ་གཅིག་དེ་ལ་ཉིན་བཞི་ལྔ་ཙམ་ཟ་རྒྱུ་འདུག་པ་དེ་གཉེར་པ་གཉིས་ཀྱིས་ཚོད་འཛིན་བྱེད་རྒྱུ་བྱས།",
    "ང་རང་གཉིས་རྫི་བོ་ཞིག་དང་འཕྲད་བྱུང་།",
    "རྗེས་སུ་རྒྱ་མིས་ས་ཆ་དེ་ལ་དིས་པ་ཀུའུ་ཟེར་གྱི་འདུག་དུས་ཚོད་ནི་༡༩༦ཕྱི་ཟླ་༦ པའི་ཟླ་འགོ་ཙམ་ལ་ཡིན།",
    "ནམ་རྒྱུན་ཁོ་པ་བློ་ཐིག་པོ་ཡོད་པས་དེར་ཆ་བཞག་སྟེ་སོ་པ་མ་བཞག་ཤར་རིའི་རྩེ་ནས་ཉི་མ་ཤར་ཙམ་དུ་ནོར་བུ་ཚེ་རིང་ཕར་ཙམ་དེར་གཅིན་པ་བཏང་བར་ཕྱིན་ནས་མགྱོགས་ཙམ་ཡོང་བཞིན་རྒྱ་དམག་བསླེབས་ཚར་འདུག་ཟེར།",
    "དུས་ཚོད་ནི་ཉིན་ཕྱེད་ཙམ་ཟིན་འདུག་སྤང་ལ་ཆུང་ཆུང་ཞིག་འདུག་པ་དེའི་ཐོག་ནས་ལྟ་དུས་ནམ་མཁའ་སྔོ་ལ་དྭངས།",
    "མེ་མདའི་སྐད་གོ་དོགས་ཀྱིས་འུ་ཐུག་དུས་མ་གཏོགས་རི་དྭགས་གསོད་ཕོད་ཀྱི་མེད།",
    "ཡུལ་འབྲོག་གཉིས་ཀའི་ནང་སྔོན་མའི་དམག་མི་མང་ཆེ་བ་མགོ་བཏགས་ཞུས་འདུག་བདུད་རུའི་བརྒྱ་དཔོན་ཀར་དགེ་དང་བུ་གྲགས་པ།",
    "ང་རང་ཁོང་ཁྲོ་མནན་མི་ཐུབ་པ་ལངས་ཏེ་ཚེ་དཔལ་སྒྲུབ་ཀྱི་གདོང་ལ་མཆིལ་མ་བཏབས་ནས།",
    "ང་དང་མཉམ་དུ་ཨུ་ཚུགས་མཐའ་སྐྱེལ་གྱིས་ཡོང་མཁན་གཉིས་འདུག་པས་ང་རང་གསུམ་མཉམ་དུ་འགྲོ་རྒྱུའི་སེམས་ཐག་བཅད།",
    "ང་དང་འཕྲད་པས་ཧ་ཅང་དགའ་པོ་བྱེད་ཀྱི་འདུག་སྒེའུ་ཁུང་ལ་ཡོལ་བ་བརྒྱབ་སྟེ་མེ་འོད་ཕྱི་ནས་མི་མཐོང་བར་བྱས་ནས་ཇ་བསྐོལ།",
    "སྣུམ་གྱིས་བཙོས་པ་གྲོ་རྒྱ་མ་དོ་ཙམ་ལས་ཟ་རྒྱུ་གང་ཡང་མི་འདུག་ལམ་སེང་དེ་བཟས།",
    "དེ་ནས་ཕ་རིར་ཤུག་པ་དང་ཆུ་མགོ་ཡོད་ས་ཞིག་འདུག་པ་དེར་འགྲོ་རྒྱུ་བྱས་ཏེ་ཡོང་།",
    "གབ་ས་ནི་མི་འདུག་རྒྱ་མི་གསུམ་པོས་ངེད་གསུམ་མཐོང་བ་དང་མེ་མདའ་རྒྱག་རྒྱུ་ཡིན་པ་ཐག་ཆོད།",
    "ང་རང་མགོ་བཏགས་པ་ལས་འོས་མེད།",
    "རྒྱང་ཤེལ་ནས་ལྟ་དུས་ཡུལ་མི་དང་རྒྱ་དམག་ཡར་མར་འགྲོ་མཁན་འདུག་ས་རུབ་མཚམས་ལ་དེ་བརྒྱབ་ནས་རུས་རོ་ཟེར་བའི་ས་དེར་གབ་ནས་བསྡད།",
    "དེ་དུས་སྐྱིད་པོ་ཡིན་པའི་སྐོར་ང་རང་གསུམ་གྱིས་ལབ་གླེང་བྱས།",
    "དེ་མིན་རྒྱ་དཔོན་གཉིས་འདུག་ཡི་གེ་ཞིག་འབྲི་དགོས་འདུག་ཟེར།",
    "ཁོ་པའི་ལག་པ་འདར་བ་དང་རྐང་པའི་ཉ་སྒྱིད་ཀྱང་འདར་སིག་སིག་བྱེད་ཀྱི་འདུག་ངའི་ཁང་པའི་ནང་རྒྱ་དམག་ཉི་ཤུ་ཙམ་ཡོད་པ་དེ་ཚོས་མཆོད་ཁང་ནང་དྲག་ཆས་སྤྲས་ནས་ཡོད་འདུག་མཆོད་ཁང་སྒོ་ཕྱེས་པ་དང་མེ་མདའ་ཁ་གཏད་ནས་སྐོར་བྱུང་།",
    "ཚོགས་རྭའི་ཕྱི་ལ་དམག་མི་བཀྲམ་འདུག་འཐབ་འཛིང་བྱེད་མཁན་ཚང་མས་ཁྱེད་ཀྱིས་རྒྱ་མི་ག་ཚད་བསད་ཡོད།",
    "དེ་ནི་ཕྱི་རྐྱེན་དང་ནང་རྐྱེན་གཉིས་ལ་ཐུག་འདུགབོད་དང་རྒྱ་ནག་རྒྱལ་ཁབ་གཉིས་པོ་མི་འབོར་མང་ཉུང་དང་མཚོན་ཆ་བཟང་ངན་ཧེ་བག་ཆེན་པོ་ཡོད་པ་དེ་བོད་ཕམས་པའི་ཕྱི་རྐྱེན་དུ་གྱུར་པ་ཤོད་མ་དགོས་ཀྱང་།",
    "ཕར་ཚུར་བལྟས་པས་སྤྱི་ཡི་གཅིན་སྐྱག་གཏོང་བྱེད་ཤིང་ཟོམ་ཞིག་བཞག་འདུག་པ་དེའི་འཁྲིས་སྟོང་པ་འདུག་པ་དེར་མི་སྡོད་ཀ་མེད་བྱུང་།",
    "ཕར་ཚུར་བལྟས་པས་ངོ་ཤེས་པ་དང་མི་ཤེས་པ་ཉི་ཤུ་ཙམ་འདུག་པ་ཚང་མ་འཇམ་ཐིང་ངེར་སྡོད་ཀྱི་འདུགཡུད་ཙམ་ནས་རྩལ་བཟང་བརྒྱ་དཔོན་འཇམ་དབྱངས་རྡོ་རྗེ་ག་ལེར་འཇབ་ནས་སྒོ་ཡི་དཀྱིལ་ཨེ་ཁུང་དེ་ནས་ལྟ་ཡག་གཅིག་བྱས་ཏེ་ག་ལེར་ངའི་འཁྲིས་ལ་སླེབས་བྱུང་།",
    "ད་དུང་བཙོན་པ་མང་པོ་དམར་གསོད་གཏོང་རྒྱུའི་འཆར་གཞི་ཡོད་འདུག་ཀྱང་།",
    "ཁོ་པས་དེར་བཅིངས་འགྲོལ་དམག་ག་ཚོད་བསད་ཡོད་ཤེས་ཀྱི་འདུག་གམ།",
    "སྐབས་དེ་དུས་ང་རང་གསུམ་ལ་རྐང་ལྕགས་ཡོད་ཡོད་པར།",
    "དེ་ནས་ང་རང་གསུམ་ལ་གྲོ་ཞིབ་འཐག་རྒྱུའི་ལས་འགན་སྤྲད་བྱུང་།",
    "དེ་ནས་ང་རང་མ་བུ་གཉིས་གཏན་དུ་བྲལ་བ་དེའི་སྐོར་ད་ལྟའང་དྲན་གྱི་འདུག་༡༩༦༢ ཟླ་༡༢ ནང་མགྲོན་ཚབ་དང་འགྲམ་ཐོག་ལྡེ་འཆང་།",
    "ང་རང་གསུམ་ལ་ཚེ་བཙོན་གྱི་ཐག་གཅོད་བྱས་པ་དང་།",
    "ཕ་ཡུལ་ལ་སྡོད་རིང་ག་དུས་བསད་ཡོང་བསམ་པའི་སེམས་ཁྲལ་ཁོ་ནའི་ངང་སྡོད་དགོས་བྱུང་།",
    "ང་རང་བཅས་གསུམ་ལོ་ཤས་རིང་ཕ་བུ་ལྟར་མཐུན་པོ་ཡོད་པར་བརྟེན་བློ་ཕམ་བྱུང་།",
    "མི་ཁ་ཤས་ཀྱིས་ཆུ་ཁོལ་ཐུང་ཕོད་ཀྱི་མི་འདུག་གང་ཡིན་ཟེར་ན་གཅིན་པ་གཏོང་བར་རླངས་འཁོར་ནས་བབས་དུས་ལྕགས་ཀྱིས་འགྲོ་དཀའ་བ་དང་།",
    "ལག་པར་སེར་ཁ་གས་དུས་ཕྲན་བུ་བྱུག་རྒྱུའི་ཕན་ཐོགས་འདུག་པ་བཅས་ལ་བརྟེན་ཞུས་པ་ཡིན་པས།",
    "བཅིངས་འགྲོལ་དམག་མི་དང་འཛིངས་དུས་སྐུད་མེད་ཏར་འཕྲིན་གྱི་སྒམ་གཉིས་ཡོད་པ་ནས་གཅིག་རྩིས་འབུལ་མ་ཞུས་པར་སྦས་སྐུང་བྱས་ཡོད་འདུག་པ་དེ་ག་པར་ཡོད་དྲང་པོ་ཤོད་ཟེར་ནས་འདྲི་ཞིབ་ཐེངས་གསུམ་བྱས་པར་མ་ཟད།",
    "ང་རང་ནི་ལྟོ་བ་ཆུང་གྲས་ཡིན་ཀྱང་ལྟོགས་སྡུག་མྱང་དགོས་བྱུང་།",
    "ནགས་འདབས་རུ་ཁག་ནས་སྨར་ཁམས་ཨ་ཁྲིད་ཟེར་བ་དེ་བྲོས་བྱོལ་འགྲོ་རྩིས་བྱེད་ཀྱི་འདུག་ཟེར་ནས་བསད་དེ།",
    "ད་དུང་རང་ཤི་བརྒྱབ་པ་དང་ཉེས་རྡུང་འོག་བསད་པ་མང་དག་ཅིག་བྱུང་ཡོད་ཀྱང་།",
    "ཞེས་རྣ་ལམ་དུ་བསྒྲགས་ནས་བསད་ཀྱི་ཡོད་པ་དེ་ནི་ལུས་རྟེན་འདིར་བསགས་པའི་འབྲས་བུ་དེ་ལུས་རྟེན་འདིར་སྨིན་པ་ཡིན་པས་ཕྱི་མའི་ཁུར་པོ་ཆུང་དུ་འགྲོ་བའི་ཐབས་ཡིན་པ་ཟེར་སྲོལ་འདུག་ཡང་དཔེར་ན།",
    "ང་རང་གཉིས་ཀྱིས་གཡས་གཡོན་ནས་བསྐྱོར་ནས་གསང་སྤྱོད་ནང་ཁྲིད་དེ་ཚུར་ཡོང་།",
    "ཐེ་ཚོམ་ཤོར་གྱི་འདུག་ཀྱང་།",
    "ཁོ་རང་རང་ཤེད་ཆེ་བ་ཞིག་ཡོད་པ་དེ་ན་ནས་ཞག་ཁ་ཤས་ཕྱིན་སྐབས།",
    "ཉིན་ཞིག་ཞིང་ར་དྲུག་པ་ཟེར་བ་ཆེན་པོ་ཞིག་ཡོད་པ་དེར་རྡོ་ཕྲན་བུ་ཕྲན་བུ་འདུག་པ་དེ་ཚོ་ཕྱིར་བཏོན་དུས་རྡོ་ལ་འབྱར་ཡོད་པའི་ས་དེ་ཚོ་ལག་པས་ཕྱིས་ཏེ།",
    "བྱས་མི་འདུག་ཉིན་གུང་ཁ་ལག་རྒྱབ་ལ་ཡིན་ཟེར་གྱི་འདུག་སྔོན་ལ་ཞིང་ཁའི་ནང་ལྟ་སྐོར་གྱིས་ཟེར་ནས་མི་འདི་སྣེ་ཤན་བཏང་བྱུང་ཟེར།",
    "གྲ་འགྲིག་པ་དངོས་གནས་ཡག་པོ་འདུག་པ་དེར་བལྟས་རྗེས།",
    "ཅེས་པ་དེ་བྲིས་འདུག་ནང་དུ་ཕྱིན་པས་ཕྲུ་གུ་བཅུ་ལྷག་ཙམ་ཚོ་གསུམ་འདུགཚོ་དང་པོ་དེའི་ནག་པང་ཐོག་ཆུང་ཆུང་དུས་ནས་སློབ་སྦྱོང་ཡག་པོ་བྱེད།",
    "ཀ་བསྐུལ་གྱི་ཡོད་པས་༡༩༦༣ ལ་ང་རང་པང་ལེབ་བཤགས་མཁན་གྲས་སུ་བཞག་བྱུང་།",
    "ཕུ་འགེབས་ཞེས་པ་ནི་སྲིན་བལ་གྱི་ཉལ་ཆས་ཤིག་ལ་ཟེར་༡༩༧༦ ལོའི་ཟླ་༩ ཚེས་༩ ཉིན་མའོ་ཙེ་ཏུང་ཤི་ཡོད་འདུག་པར་བརྟེན།",
    "སྒེའུ་ཁུང་ནང་ནས་ལྟ་དུས་སྒོ་སྲུང་དམག་མིས་ཀྱང་དཔུང་རྟགས་ནག་པོ་རྒྱབ་འདུག་པས།",
    "ལྷག་པར་དུ་ལོ་ཉི་ཤུ་རྩ་གྲངས་སོན་པའི་བུ་རྒྱུད་ཚོས་ཕ་ངོ་ཤེས་མཁན་གཅིག་ཀྱང་མི་འདུག་བཟའ་ཟླ་དང་སྤུན་མཆེད་མང་ཆེ་བ་མནར་གཅོད་འོག་གྲོངས་པ་དང་།",
    "རྒྱུ་ནོར་ཁང་གཞིས་ཚང་མ་བཅོམ་ནས་འཐབ་རྩོད་ཧ་ལས་དགོས་པ་བྱས་འདུག་ཀྱང་།",
    "ཞང་པོ་གཉིས་ཡོད་འདུག་ཀྱང་གཅིག་དམག་ས་ནས་རྒྱ་མིས་མེ་མདའ་བརྒྱབ་སྟེ་བསད་པ་དང་།",
    "༡༩༥༩ ལོ་ནས་ང་རང་རི་ཁར་དམག་སར་ཕྱིན་པ་ནས་ངོ་ཐུག་མ་བྱུང་བའི་རྐྱེན་གྱིས་ད་བར་ལོ་ཉི་ཤུ་ལྷག་ཙམ་ངོ་ཐུག་མ་བྱུང་བ་དང་།",
    "དམེ་སྟོད་ཡུལ་ལུང་དེར་དུད་ཚང་༣ ཙམ་ཡོད་པ་ནས་མུ་གེས་ཤི་བ་ཉི་ཤུ་རྩ་བཞི་བྱུང་འདུག་དེ་ཡང་མུ་གེས་ཤི་བ་ནི།",
    "དེ་རྗེས་མགོ་བཏགས་ཞུས་ཤིང་རྒྱུ་ནོར་ཕྲན་བུ་གང་ཡོད་རྩིས་ལེན་བྱས་པ་མ་གཏོགས་ཉེས་རྡུང་དང་གཤེ་གཤེ་གང་ཡང་བྱས་མི་འདུག་ཁོང་ཉིན་མཚན་ག་དུས་ཡིན་ཀྱང་ཙོག་པུར་སྡོད་ཅིང་མཉམ་བཞག་བྱེད།",
