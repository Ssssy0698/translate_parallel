    "བློ་རྡོར་གྱིས་ང་བཤུའདོད་མི་འདུག་ཁྱེད་ཀྱིས་ང་ལ་བཀའ་བཙན་པོ་ཕབ་དོན་ཅི་ཡིན་ནམ།",
    "སྐད་ཆ་གང་བྱུང་མ་ཤོད་མི་འདི་ཁ་ཆེན་པོ་མི་འདུག་མ་གཞི་ནས་ང་གཉིས་པགས་པ་ཚོང་བར་ཁ་ཆེ་ཆུང་ལ་ལྟ་དགོས་དོན་ཅི་ཡོད་དམ་ཞེས་གཤེ་གཤེ་བཏང་།",
    "ཁྱེད་རང་དགོས་པའི་སློབ་སྦྱོང་མ་བྱས་པར་མི་དགོས་པའི་སྐྲ་སེར་པོ་བཟོས་ནས་གང་བྱེད་དམ།",
    "པ་ལགས་ཁྱེད་རང་སེམས་ཁྲལ་གནང་མི་དགོས།",
    "ངའི་ཡིག་རྒྱུགས་ཀྱི་སྦྱངས་འབྲས་ཀྱང་དེ་སྔ་ལས་དམའ་རུ་ཕྱིན་འདུགའགྲེལ་བཤད།",
    "མདང་དགོང་ཁྱེད་རང་ཁྱིམ་ལ་སླེབས་རྗེས་ལྟོ་བཟས་པ་ཡིན་ནམ།",
    "བུ་ཆུང་བ་དེ་ལས་ལྡོག་སྟེ་སྤྱང་གྲུང་ལྡན་ལ་བློ་རིག་བཀྲ་བ་ཞིག་ཡོད་ཕ་བུ་གསུམ་སྡུག་མཉམ་སྡུག་དང་སྐྱིད་མཉམ་སྐྱིད་ཀྱི་འཚོ་བ་སྐྱེལ་བཞིན་གདའ།",
    "གླུ་གཞས་ཚང་མ་བཏང་ཚར་འདུག་ཅེས་བཤད།",
    "ཁྱེད་རང་ཐུགས་སྐྱོ་སྣང་དེ་འདྲ་གནང་མི་དགོས།",
    "གང་འདྲ་ཟེ་བྲིས་འདུག་གམ།",
    "ཁྱེད་རང་གཉིད་ཁུག་བཞུགས་ན་ང་ལ་དྲི་ལན་རྙེད་ཀྱི་འདུག་ཅེས་ལན་བཏབ།",
    "ངས་ངོ་གདོང་ལ་ལག་པ་བཀབ་མི་འདུག་གམ་ཞེས་བཤད།",
    "སྦྲ་ནག་ཞོལ་ལ་ཅི་གདའ་ཞེས་པའི་ལན་ལ་སྦྲ་གུར་ནག་ཅིག་གེར་བསྡད་གདའ་ཞེས་ལན་བཏབ།",
    "རྩེ་པོ་ཏ་ལ་མཐོ་ལོས་གདའ་ཞེས་པའི་ལན་ལ་མཐོ་བ་ལ་ནི་མདང་ནུབ་མི་ཞིག་ལྷུང་ན་དེའི་སང་ཞོགས་ཡང་སར་ལྷུང་ཚར་མི་གདའ་ཞེས་ལན་བཏབ།",
    "སྣང་རྩེ་ཤག་ལ་ཅི་གདའ་ཞེས་པའི་ལན་ལ་མི་ཚང་མ་སྣང་བ་སྐྱིད་པོ་བྱས་ནས་བསྡད་གདའ་ཞེས་ལན་བཏབ།",
    "ངའི་ཚ་དམ་ཤུགས་དྲག་དེ་ཙམ་ལྷུང་ཡང་ཤེལ་མ་གཏོགས་ཆག་མི་འདུག་པས་རྗེས་སུ་གཏམ་དེ་རིགས་ལ་ཆ་འཇོག་བྱེད་མི་རུང་ཞེས་བརྗོད་ཀྱིན་ཚ་དམ་སླར་ཡང་རྒྱབ་ཏུ་འཁུར་ནས་དགའ་སྤྲོའི་ངང་སྙན་པའི་སི་གླུ་ལེན་བཞིན་གཡག་རྣམས་འདེད་དེ་ལམ་ལ་ཆས་སོ།",
    "ཨ་ཇོ་དང་མནའ་མ་བཅས་གཉེན་སྒྲིག་བྱས་ཡོད།",
    "དཔལ་ལྡན་གྱིས་ང་ཤི་རྒྱུར་སེམས་ཁྲལ་སྤུ་ཙམ་མི་འདུག་ཅེས་ལན་ཕུལ།",
    "ང་དངུལ་ཁང་ནང་ལས་ཀ་བྱེད་ཀྱི་མི་འདུག་གམ་ཞེས་སྨྲས།",
    "ཨེམ་རྗེས་ཁོང་ཁྲོ་དང་བཅས་བྱས་ན་རང་ད་དུང་ཐག་རིང་པོ་ག་ཚོད་ཙམ་མཐོང་དགོས་འདུག་གམ་ཞེས་གཤེ་གཤེ་བཏང་།",
    "ངའི་དངུལ་ཁུག་བསྡད་མི་འདུག་ཅེས་བརྗོད།",
    "བཀྲ་ཤིས་ཀྱིས་ང་མིག་ཤེལ་མ་རྒྱབ་ན་དེ་བས་མཛེས་པ་འདུག་ཅེས་གསུངས་ཀྱི་འདུག་པས་ངས་ཀྱང་མཛེས་པོ་ཡོང་ཕྱིར་མིག་ཤེལ་མ་བརྒྱབ་པ་ཡིན་ཅེསབརྗོད།",
    "གཡས་གཡོན་ནོར་འདུག་ཁྱེད་ཀྱིས་དངུལ་འདི་ལ་གཡས་གཡོན་མ་ནོར་བའི་ལྷམ་གསར་པ་ཞིག་ཉོ་རོགས་ཞེས་སྨྲས་སོ།",
    "དེ་ལ་འདུག་ཅིང་འཁོར་ལོ་ཐོགས་པ་མེད་པས་བསྐྱང་བ་དང་།",
    "ཡང་རང་བཞིན་དུ་གནས་པའི་མཚན་ཉིད་ནི།",
    "འཇིག་རྟེན་བདེ་དང་རང་སྲོག་ལ།",
    "སྒོམ་ཚུལ་ནི་ཨ་ར་པ་ཙ་ན་ལ་སོགས་པའི་ཡི་གེའི་དོན་སྐྱེ་མེད་ནམ་མཁའ་ལྟ་བུར་སྒྲོ་བཏགས་བོ་དོང་པཎ་ཆེན་གྱི་གསུང་འབུམ་ལས།",
    "འོན་ཀྱང་རང་རྒྱུད་པ་ཕལ་ཆེར་སྣང་བཅས་ཀྱི་ཕྱོགས་འདི་བཞེད་པ་ཡིན་ནོ།",
    "ལམ་ཤེས་ཀྱི་དམིགས་པའི་ལམ་འདིས་ཉན་རང་རང་རྒྱུད་པའི་ལམ་མ་བསྡུས་ན་ལམ་ཤེས་ཀྱིས་ནི་ཉན་རང་རང་རྒྱུད་པའི་ལམ་ཤེས་པ་ཉིད་དུ་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཉན་རང་རང་རྒྱུད་པའི་ལམ་ལ་དེ་ལྟར་འགལ་ཡང་འདི་བྱང་སེམས་ཀྱི་རྒྱུད་ལ་ཡོན་ཏན་ཡར་ལྡན་དུ་སྐྱེ་བའི་ལམ་ཡིན་པས་མི་འགལ་ལོ་ཞེ་ན།",
    "དེ་ཡང་རང་བྱུང་བདག་ཉིད་རྟོགས་པ་ལས་གཞན་མི་འཐད་པས་རྟོགས་པ་ཕན་ཚུན་བརྟེན་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "སེམས་ཙམ་པ་ཕལ་ཆེར་ཀྱང་རང་རྒྱལ་གྱིས་གཟུང་མེད་རྟོགས་པར་མི་འདོད་དེ།",
    "རང་རྒྱལ་མ་ཡིན་ན་གང་ཟག་འདིའི་རིགས་ལ་སོགས་པ་ཡང་རང་རྒྱལ་གྱི་རིགས་ལ་སོགས་པ་མིན་པར་འགྱུར་བས་སྐབས་དོན་ཉམས་ཤིང་།",
    "སྐྱེ་འགག་དུས་མཉམ་པས་དུས་མཉམ་དུ་གྱུར་ན་ནི་འགལ་བ་ཡིན་ཏེ།",
    "སྤང་གཉེན་སྐྱེ་འགག་དུས་མཉམ་དུ་བཞག་པ་དང་འགལ་བའི་ཕྱིར་རོ།",
    "ཁྱེད་རང་ལྟར་ན།",
    "དེ་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་དང་།",
    "རྟག་པ་ལ་ཡང་རང་བཞིན་གྱིས་ཡོངས་གྲུབ་དང་།",
    "ལམ་ཤེས་ཀྱི་སྐབས་སུ་ཁྱེད་རང་ལྟར་ནའང་འགོག་པ་གང་ཡིན་པ་གསུམ་དང་།",
    "ཐེག་ཆེན་གྱི་ལམ་རྒྱུད་ལ་སྐྱེད་པ་དང་རང་བཞིན་མེད་པ་སོགས་སུ་མི་ཤེས་ཀྱང་བདག་མེད་ཙམ་དུ་ཤེས་དགོས་ཏེ།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "དེ་ལྟར་འདུག་པ་ལ་ཡོན་ཏན་ལྔ་ཡོད་དེ།",
    "སྤྱོད་ལམ་འདུག་པ་ལ་དགའ་སྟེ་ཕན་ཡོན་སྔར་ལྟར་མཐོང་བའི་ཕྱིར་རོ།",
    "ཆུ་རྒྱུས་ཙམ་གྱིས་སྦྲེལ་ནས་རྣམ་པར་དམར་བར་གྱུར་ཅིང་འཇིགས་པ་སྐྱེ་བ་ལྟར་འདུག་སྟེ།",
    "བྱེ་ཞིང་བྲལ་ནས་སྐྲའི་བར་དུ་ལྷགས་པ་བསྐྱེད་པས་ཡེང་ཡེང་པོར་གྱུར་ནས་ཐམས་ཅད་འབྲལ་བའི་བརྡ་སྟོན་པ་ལྟར་འདུག་སྟེ།",
    "སྐྱེད་སྐྱེད་པ་ཡང་མཐའ་མའི་མལ་ན་འདུག་པའི་ཚེ།",
    "གཞི་དང་རྩ་བ་མེད་ཅིང་རང་གྲོལ་བ།",
    "ནང་དུ་ཡང་དག་འཇོག་ལ་འདུག་ཏེ་སེམས་རྟོགས་པ་ན་མྱུར་བ་མྱུར་བར་སེམས་དང་ལུས་ཤིན་ཏུ་སྦྱངས་པར་འགྱུར་བ་སོགས་དང་།",
