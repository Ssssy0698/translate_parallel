    "གནོད་སྦྱིན་འབྲོག་གནས་ཀྱང་གདུལ་བར་བྱའོ་སྙམ་དུ་རིག་ནས་མ་ག་དྷཱ་དག་ཏུ་ལྗོངས་རྒྱུ་ཞིང་གཤེགས་ནས་འབྲོག་གནས་སུ་བྱོན་ཏེ་གནོད་སྦྱིན་འབྲོག་གནས་ཀྱི་གནས་སུ་མཚན་མོ་གནས་པར་ཞལ་གྱིས་བཞེས་སོ།",
    "དེའི་ཚེ་ན་གནོད་སྦྱིན་འབྲོག་གནས་གནོད་སྦྱིན་རྣམས་ཀྱི་གནོད་སྦྱིན་འདུ་བར་སོང་བར་གྱུར་ཏོ།",
    "གནོད་སྦྱིན་བོང་བུ་བས་བཅོམ་ལྡན་འདས་གནོད་སྦྱིན་འབྲོག་གནས་ཀྱི་གནས་སུ་མཚན་མོ་གནས་པར་ཞལ་གྱིས་བཞེས་པ་མཐོང་ངོ།",
    "མཐོང་ནས་ཀྱང་གནོད་སྦྱིན་འབྲོག་གནས་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་གནོད་སྦྱིན་འབྲོག་གནས་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "གྲོང་དཔོན་ཁྱོད་ཀྱི་གནས་སུ་བཅོམ་ལྡན་འདས་མཚན་མོ་གནས་པར་ཞལ་གྱིས་བཞེས་པ་གང་ཡིན་པ་དེ་ནི་ཁྱོད་ཀྱིས་རྙེད་པ་ལེགས་པར་རྙེད་དོ།",
    "གྲོང་དཔོན་མིར་གྱུར་པ་ཡང་བདག་གི་གནས་སུ་མཚན་མོ་གནས་པར་ཁས་ལེན་ཏམ།",
    "དེ་ནས་གནོད་སྦྱིན་འབྲོག་གནས་ཀྱིས་གནོད་སྦྱིན་རྣམས་ཀྱི་གནོད་སྦྱིན་འདུ་བ་ཟིལ་གྱིས་མནན་ནས་རང་གི་གནས་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "གྲོང་དཔོན་ཁྱོད་ཀྱིས་ང་ལན་གསུམ་གྱི་བར་དུ་གནས་སུ་སྤྱན་དྲངས་པས་ད་ནི་མི་འབྱུང་ངོ།",
    "དགེ་སྦྱོང་དེའི་ཕྱིར་ཁྱོད་ལ་དྲི་བ་དྲིས།",
    "གལ་ཏེ་སེམས་རངས་པར་མི་བྱེད་ན་ཁྱོད་ཀྱི་སེམས་གཡེངས་པའམ།",
    "ཕྱག་གཉིས་ནས་བཟུང་སྟེ་ཆུ་ཀླུང་སྐལ་ལྡན་ཤིང་རྟ་པའི་ཕ་རོལ་གྱི་འགྲམ་དུ་འཕེན་པ་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་གིས་གྲོང་དཔོན་འདི་ལྟར་ཅི་དང་ཅི་འདོད་པ་ཞུས་ཤིག།",
    "དུ་ཞིག་གིས་ནི་འཇིག་རྟེན་འབྱུང་།",
    "དུ་ཞིག་གིས་ནི་འཇིག་རྟེན་བཀུར།",
    "དྲུག་གིས་འཇིག་རྟེན་འབྱུང་འགྱུར་ཏེ།",
    "དྲུག་གིས་འདྲིས་པ་ཐོབ་པར་འགྱུར།",
    "དྲུག་གིས་འཇིག་རྟེན་བཀུར་འགྱུར་ཏེ།",
    "དྲུག་གིས་འཇིག་རྟེན་ཟིལ་གནོན་འགྱུར།",
    "ཟབ་མོར་གང་ཞིག་འབྱེད་མི་འགྱུར།",
    "ཟབ་མོར་འབྱིང་བར་མི་འགྱུར་རོ།",
    "ཅི་ཞིག་གིས་ནི་རྒྱ་མཚོ་རྒལ།",
    "ཅི་ཞིག་གིས་ནི་ཡོངས་དག་འགྱུར།",
    "གཞན་དང་གཞན་དུ་ཁྱོད་དྲིས་ཤིག།",
    "འདི་ལྟར་དཔའ་ཆེན་ཁྱོད་ཀྱིས་ནི།",
    "གང་གིས་དེད་དཔོན་བླ་ན་མེད།",
    "ཁྱོད་ལ་ཁོ་བོ་བྱས་པ་གཟོ།",
    "བཞིན་བཟངས་ཁྱོད་ཀྱིས་དགེ་སློང་ཤཱ་རིའི་བུ་དང་།",
    "ལག་པ་ཁྲག་གིས་གོས་པ།",
    "འདི་ནས་ཤི་འཕོས་ན་ཁྱོད་ཀྱི་འགྲོ་བ་ནི་ཅིར་འགྱུར།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་ཅི་བགྱི་བ་བཀའ་སྩལ་དུ་གསོལ།",
    "ཁྱོད་ངའི་སྤྱན་སྔར་སྐྱབས་སུ་འགྲོ་བ་དང་།",
    "བདག་གིས་དེ་རིང་ཕྱི་མ་ཡི།",
    "གླུ་དང་རོལ་མོའི་སྒྲས་གནོད་སྦྱིན་གྱི་དྲུང་དུ་འཕགས་པ་དང་།",
    "ཁྱིམ་བདག་ཁ་ཅིག་གིས་ཐོས་ནས་སྨྲས་པ།",
    "རོལ་མོའི་སྒྲ་འདི་ཅི་ཡིན།",
    "ཁ་ཅིག་གིས་སྨྲས་པ།",
    "འདི་ནི་ཁྲག་གི་ཐིགས་པ་དེ་གནོད་སྦྱིན་གྱི་གན་དུ་ཁྱེར་བ་ཡིན་ནོ།",
    "ཤེས་ལྡན་དག་ཁྲག་གི་ཐིགས་པ་འདིས་གནོད་སྦྱིན་མི་མགུ་བས་གལ་ཏེ་འདི་མ་བཟློག་ན་གདོན་མི་ཟ་བར་གནོད་སྦྱིན་འཁྲུགས་པར་འགྱུར་ཞིང་།",
    "འདི་བཟློག་པར་བྱའོ་ཞེས་དེ་དག་གིས་དེ་བཟློག་པར་བརྩམས་པ་དང་།",
    "གླུ་དང་རོལ་མོའི་སྒྲ་དེ་གསན་ཏོ།",
    "གླུ་དང་རོལ་མོའི་སྒྲ་འདི་ཅི་ཡིན།",
    "འོངས་ཀྱང་རུང་གིས་བདག་གི་ཟན་ཐ་མ་འདི་བཅོམ་ལྡན་འདས་ལ་བསོད་སྙོམས་དབུལ་ལོ་སྙམ་མོ།",
    "ཁྱིམ་བདག་དེས་དེ་ཁྱེར་ཏེ་འབྲོག་གནས་སུ་སོང་བ་དང་།",
    "ཁྲག་གི་ཐིགས་པ་དེ་ཁྱེར་ཏེ་འོངས་པ་ལས་ན།",
    "བཅོམ་ལྡན་འདས་ཁྱེའུ་འདི་ལ་ཐུགས་བརྩེ་བའི་སླད་དུ་དེའི་གནས་སུ་མཚན་མོ་གནས་པར་ཞལ་གྱིས་བཞེས་ནས།",
    "གང་གི་ཚེ་སྔོ་བསངས་ཅན་མགོ་བསྒྱུར་རན་པར་གྱུར་པ་དེའི་ཚེ་ན་དེ་སློང་བ་རྒྱལ་པོ་དག་དང་།",
    "གང་དག་ལ་མ་བྱིན་པ་དེ་དག་བདག་གི་དགྲ་བོར་འགྱུར་རོ་སྙམ་ནས་ལག་པ་ལ་འགྲམ་པ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "ཡབ་ཁྱོད་ཅིའི་སླད་དུ་ཕྱག་ལ་ཞལ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་བཞུགས།",
    "བུ་མོ་ཁྱོད་སློང་བ་རྒྱལ་པོ་དག་དང་།",
    "གཞན་ཡང་མང་པོ་དག་ལྷགས་པས་གང་དག་ལ་ཁྱོད་མ་བྱིན་པ་དེ་དག་ངའི་དགྲར་འགྱུར་ན།",
    "དེང་ནས་གདུགས་བདུན་ན་ངན་བུ་རང་གིས་གནས་བཙལ་བར་བགྱིའོ།",
    "བུ་མོ་དེ་ལྟར་གྱིས་ཤིག།",
    "འོན་ཀྱང་རེ་ཞིག་ལྷ་ལ་ཞུ་བར་བྱའོ་ཞེས་དེ་བད་སའི་རྒྱལ་པོ་ཤར་པའི་གན་དུ་སོང་སྟེ་སྨྲས་པ།",
    "ལྷ་དེང་ནས་གདུགས་བདུན་ན་སྔོ་བསངས་ཅན་རང་གིས་གནས་ཚོལ་བར་འགྱུར་གྱིས་ལྷས་གནང་བར་མཛོད་ཅིག།",
    "འདི་སྐད་ཅེས་དེང་ནས་ཉི་མ་བདུན་ནས་སྔོ་བསངས་ཅན་རང་གིས་གནས་ཚོལ་བར་འགྱུར་རོ་ཞེས་དྲིལ་སྒྲོགས་ཤིག།",
    "གྱོ་མོ་མེད་པར་རྣམ་པར་བཞག་ནས་ཙན་དན་གྱི་ཆུས་ཆག་ཆག་བཏབ་སྟེ།",
