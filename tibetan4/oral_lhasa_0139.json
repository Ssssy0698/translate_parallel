    "ཞེས་པས་བསྟན་པའི་དོན་ནི་ར་སཱ་ཡ་ནས་ཤེས་པར་བྱའོ། ། གཡས་ནས་རྒྱུ་ན་གཡས་རྩ་མནན།",
    "ལྔ་བཅུ་པ་རི་དྭགས་ཀྱི་རྒྱལ་པོ་སེང་གེ་རྣམ་པར་རྩེ་བ་བཞིན་དུ་བྱའོ།",
    "འོག་རྒྱབ་ནས་དྲག་པོར་དེར་འཐེན་པ་བསྲེས་པའི་ཁ་སྦྱོར་དེ་ཁ་སྟེང་འོག་ཕྱོགས་མཚམས་ཐམས་ཅད་དུ་ཆ་མཉམ་པར་རིམ་རིམ་འཕུལ་བས་མཐར་ལུས་ཐམས་ཅད་ཐེར་བརྒྱངས་སུ་དགང་ངོ།",
    "སྟེང་དུ་མ་འཕྱུགས་པར་བྱས་པས་ལྟེ་འོག་ཏུ་འགྲོ།",
    "ལྔ་པ་རྡོ་རྗེའི་བཟླས་པ་རྣམ་པར་ཕྱེ་བ་ལ།",
    "བརྗོད་དང་དམིགས་པར་བཅས་པ་དང་།",
    "ཕྱི་མ་གཉིས་རྫོགས་རིམ་པའི་གཙོ་བོར་བསྒོམ་བྱར་ཤེས་པར་བྱའོ།",
    "བདེ་བའི་སྟན་ལ་ལུས་སེམས་རྣལ་དུ་ཕབ་ནས་འབྱུང་འཇུག་གནས་པ་གསུམ་གཅིག་ཏུ་བྱས་པ་དབུགས་ཏེ།",
    "དེ་བགྲངས་པས་ཉིན་ཞག་གཅིག་ལ་ཉི་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱ་འབབ་པ་རིགས་པར་འགྱུར་རོ།",
    "དེ་ནས་དབུགས་ཉིད་ལ་ཤེས་པ་གཏད་པས་རིང་ཐུང་དང་ཁ་དོག་ཤེས་པར་འགྱུར་ལ།",
    "དེ་ལྟར་ལོབས་ནས་ཕྱག་མཚན་དེ་ཡོངས་སུ་གྱུར་པ་ལས་རྣམ་པར་སྣང་མཛད་ཡབ་ཡུམ་གྱི་སྐུ་ནམ་མཁའ་ཁྱབ་པར་སྤྲོ་ཞིང་བསྡུ་བར་བྱའོ།",
    "དེ་བཞིན་དུ་རིགས་གཞན་རྣམས་ལའང་བགྲེས་ཏེ་ཤེས་པར་བྱའོ།",
    "དེས་ཀྱང་སྙོམས་པར་འཇུག་པས་སྔར་ལྟར་དུ་ཕྱུང་ནས་ནམ་མཁའ་ཁྱབ་པར་སྤྲོ་བ་ཚ་བོའི་ཚུལ་ལོ།",
    "དེ་བཞིན་དུ་རིགས་ལྷག་མ་རྣམས་ལའང་ཤེས་པར་བྱའོ།",
    "སྣང་བ་གསུམ་གྱི་ཡེ་ཤེས་མངོན་དུ་བྱས་པའི་མཐར་མི་ཤིགས་པ་མཐོང་བར་འགྱུར་ལ།",
    "རྣ་བར་སྒྲ་གང་དང་གང་ཐོས་པ་ལ་སྦྱར་བས་སྒྲ་རྣམས་བྱུང་མ་ཐག་འགགས་པས་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་རྟོགས་པར་འགྱུར་ལ།",
    "དེ་བཞིན་སྣ་ལྕེ་ལུས་ཀྱི་བྱ་བ་འགོག་པའང་ཤེས་པར་བྱའོ།",
    "འདིའང་མི་ཤིགས་པའི་ཁམས་ཀྱི་ཡུམ་ལྔའི་གླུས་བསྐུལ་ནས་དག་པའི་སྒྱུ་ལུས་པར་ལངས་ནས་ཕྱག་རྒྱ་གསུམ་ཀའམ།",
    "སྔར་གྱི་འོད་གསལ་བ་དེའང་སེམས་རྣམ་པར་དབེན་པ་ཙམ་ཡིན་པས་སྣང་བ་གསུམ་པ་ཉིད་དུ་ཟད་ལ།",
    "མགྲིན་པར་བཅུ་དྲུག་ཡར་བསྟན།",
    "དག་ནས་གཤིས་ཐོག་ཏུ་བབས་པས་མྱ་ངན་ལས་འདས་པར་མཚོན་པར་བྱེད་པའི་བརྡའོ།",
    "རྨི་ལམ་གྱི་གནས་སྐབས་ན་མགྲིན་པར།",
    "དེ་མ་རྟོགས་ན་རྨི་ལམ་གྱི་སྒྲིབ་པར་ཤར།",
    "པར་ཤར།",
    "དེ་མ་རྟོགས་པ་སད་པའི་སྒྲིབ་པར་ཤར།",
    "དོན་ཤེས་པ་གཅིག་ཉིད་ཡུལ་ཕྱིར་ཆད་ཀྱི་རྣམ་པར་ཤར་བ་དང་།",
    "དེ་ལས་གཞན་པའི་ཅང་མེད་པར་ཡང་མི་བལྟ་བར་སེམས་ཀྱི་ངང་བསམ་དུ་མེད་པ་ཉིད་རྩེ་གཅིག་ཏུ་བཞག་པས།",
    "སྙོམས་པར་འཇུག་པའི་རྣལ་འབྱོར་གསུམ་ལས།",
    "གསང་གནས་ནོར་བུའི་མཐར་ཐུག་པར་གང་བ་འཛིན་ནུས་པར་འགྱུར་རོ།",
    "ཤེས་པ་གཟེགས་ཁྱེར་ནས་ལུས་སེམས་མི་བཟོད་ན་གང་ལའང་མ་ཞེན་པར་ཤེས་པ་གློད་ཀྱིན་བཞག་པས་སས་རོ་མཉམ།",
    "ལྷག་པར་རྒྱབ་དྲག་པོར་འཐེན་ནས་ཁ་སྦྱོར་བཅིངས་མི་ཐུབ་ལ་ཁད་ན་རྔུབ་ཆུང་བྱས་ཏེ་མནན།",
    "རས་ཕུད་གཏོང་བ་ལ་སོགས་པར་འདོད་། ཀྱང་འདིས་སོ།",
    "དེར་སྙོམས་པར་འཇུག་པའི་བར་དུ་སེམས་ཆུད་དེ་བདེ་བས་བརྒྱལ་བ་ཙམ་དུ་བསམ།",
    "གསལ་ཀྱང་རྣམ་པར་མི་རྟོག་པ་འབའ་ཞིག་ཏུ་འགྱུར་མི་ཐུབ་ན།",
    "གལ་ཏེ་མི་གནས་པར་འཕྲོ་ན་འཕྲོ་དུས་དེ་ཉིད་དུ་འཕྲོ་མཁན་ངོས་གཟུང་བས་རང་ཞིག་སྟེ་ཆུ་བུར་ཆུར་ཐིམ་པ་ལྟ་བུར་འགྱུར་རོ།",
    "དེ་སྐྱེས་པ་དང་མྱང་བྱ་མྱོང་བྱེད་གཅིག་པའམ་མཚན་མ་མེད་པའི་ཞི་གནས་སོ་སོར་རྟོག་པའི་རིག་པར་ལྡང་བ་དེའང་འདག་གོ།",
    "ཞེས་པས་དངོས་པོ་གཅིག་ཉིད་དངོས་པོ་ཐམས་ཅད་པར་སྣང་ལ།",
    "དམིགས་ཡུལ་གྱི་སྒོ་ནས་རྣམ་པ་བཞིར་ཕྱེའོ་ཞེས་བསྟན་པའི་དང་པོ་རྟགས་བཅུ་ལ་སོགས་པའི་སྣ་ཚོགས་པའི་གཟུགས་ཤར་ནས་སྟོང་པ་ཉིད་ཀྱི་གཟུགས་བརྙན་དེ་ལས་སྣང་བ་རགས་པའི་སྟེང་དུ་ཁྲིད་པས་སྔར་དེ་ལ་བདེན་པར་ཞེན་པའི་ཕུགས་བརྡོལ་ནས་བདེན་པ་མ་ཡིན་ཞིང་རྫུན་པ་མ་ཡིན་པ་སྒྲ་མ་ཙམ་དུ་འགྱུར་རོ།",
    "རྒྱས་པར་སློབ་དཔོན་ཏོག་རྩེ་ཞབས་ཀྱིས་མཛད་པ་ལས་སོ།",
    "ལུས་ནི་བསྒྲུབས་པར་གྱུར་པ་ན།",
    "དེ་རྣམས་འོད་དམ་བདུད་རྩིའི་རྣམ་པར་ཞུ་སྟེ།",
    "འདག་སྦྱར་ལྟ་བུ་བྱེད་ནའང་ཁང་པ་འདོམ་གང་གྲུ་བཞི་དཔངས་ཅུང་ཟད་མཐོ་བར་བྱས་ཏེ།",
    "འཆུགས་སུ་མི་འཇུག་གལ་ཏེ་སྒྲེགས་པར་འཆུགས་ན་དེ་ལས་ལྷག་ཙམ་སླར་ཟ།",
    "དཀའ་ཐུབ་ཀྱི་རྗེས་ལ་ཟས་བཏུང་གཞུང་མ་གཏང་ན་རྒྱུན་གཅོད་བྱས་པའི་དཀའ་ཚེགས་དོན་མེད་དུ་འགྱུར།",
    "མེ་ཉིར་མི་བསྡད།",
    "གེགས་སེལ་ཡིད་བཞིན་ནོར་བུ་གསལ་བྱེད་ཉི་མ་ཞེས་བྱ་བ་རྗེ་བཙུན་མར་པའི་ཞལ་སྔ་ནས་ཀྱིས་མཛད་པ་སོགས་ལས་ཤེས་པར་བྱའོ།",
    "མགྲིན་པར་འདབ་མ་བཅུ་དྲུག་དམར་པོ།",
    "དེ་ལྟ་བུའི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་ང་རྒྱལ་དང་མི་འབྲལ་བས་བདེ་བར་སྤྱོད་པར་བྱའོ།",
    "དེ་དག་རིམ་པ་བཞིན་ཐོབ་པར་འགྱུར་རོ།",
    "སྲོག་རྒྱུན་མི་འཆད་པར་ཟླ་བ་དྲུག་ལ་སོགས་པར་འགོག་པར་ནུས།",
    "བདེ་བ་ཆེན་པོའི་ཡེ་ཤེས་དེ་ལ་གནས་པས་རྒ་བ་དང་འཆི་བ་ཐམས་ཅད་གཞོམ་པར་བྱེད།",
    "མགྲིན་པར་པདྨ་དམར་པོའི་དབུས་སུ་ཟླ་གདན་ལ་ཨོ།",
    "མགྲིན་པར་སླུ་ཏ་ཤིན་ཏུ་རིང་པོ་གསུམ་ཡུན།",
