    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་ཆེན་པོ་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་། བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་དོན་དམ་པ་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་མི་རྟག་གོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ལོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་བདག་མེད་དོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་མི་སྡུག་གོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་འདུས་བྱས་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དེ་ལྟར་དེ་དག་འདུས་བྱས་སྟོང་པ་ཉིད་མི་རྟག་གོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ལོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་བདག་མེད་དོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་མི་སྡུག་གོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མི་རྟག་གོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ལོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་། བདག་མེད་དོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མི་སྡུག་གོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་འདུས་མ་བྱས་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་བ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དེ་ལྟར་དེ་དག་འདུས་མ་བྱས་སྟོང་པ་ཉིད་མི་རྟག་གོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ལོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་བདག་མེད་དོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མི་སྡུག་གོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་། པར་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་དོར་བ་མེད་པ་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་མི་དམིགས་པ་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་། སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མི་དམིགས་པ་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་། རོ་ དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མི་རྟག་གོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་མི་རྟག་གོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་སྡུག་བསྔལ་ལོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་བདག་མེད་དོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་མི་སྡུག་གོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་ཡང་དག་པར་སྤོང་བ་རྣམས་མི་རྟོག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ་ ཡང་དག་པར་སྤོང་བ་རྣམས་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དེ་ལྟར་དེ་དག་ཡང་དག་པར་སྤོང་བ་རྣམས་མི་རྟག་གོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་སྡུག་བསྔལ་ལོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་བདག་མེད་དོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་མི་སྡུག་གོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ་ རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་སྟོབས་རྣམས་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "སྟོབས་རྣམས་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "སྟོབས་རྣམས་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "སྟོབས་རྣམས་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་འཕགས་པའི་བདེན་པ་རྣམས་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "སུ་ལ་བསྟན་པ་དེ་དག་ཀྱང་བསམ་གཏན་རྣམས་མི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "བསམ་གཏན་རྣམས་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་། འགྱུར་རོ།",
    "བསམ་གཏན་རྣམས་བདག་མེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "བསམ་གཏན་རྣམས་མི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།"
  ]
}