    "ནགས་མ་བརྟགས་པ་ལས་བྱུང་བའི་སོར་བཤགས་ཏེ་བཞིའོ།",
    "དགེ་སློང་མ་ལས་ཟས་ལེན་པའི་སོར་བཤགས་འཆད་པ་ལ།",
    "སོར་བཤགས་གཉིས་པ།",
    "དགེ་སློང་མས་བསྐོ་བཤམས་བྱས་པ་མ་བཟློག་པར་ཟས་བཟོས་པའི་སོར་བཤགས་འཆད་པ་ལ།",
    "མ་ཕེབས་བྲིས་བ་མ་བཟློག་པར།",
    "བསླབ་པ་དྲལ་བའི་སོར་བཤགས་འཆད་པ་ལ།",
    "ལུས་ཐ་མལ་པར་གནས་པའོ་ གང་ལེན་ཞིང་ཟ་བའི་དངོས་པོ་ནི།",
    "སོར་བཤགས་བཞི་པ།",
    "ནགས་མ་བརྟགས་པའི་སོར་བཤགས་འཆད་པ་ལ།",
    "སྦྱིན་བདག་ཁྱིམ་པར་ཟས་བླངས་ཏེ།",
    "པ་ལ་བྱ་བ་བྱས་པས་ས་ས་གནས་ནང་པ་ཚུ་ལུ་ན།",
    "ཞེས་གསུངས་པ་ལྟར་ཤམ་ཐབས་གྱོན་ཚུལ་ཉེས་པ་ལས་བྱུང་བའི་ཉེས་བྱས་བདུན་ནི།",
    "ཞེས་གསུངས་པ་འདིས་ནི་མཐང་གོས་ལ་ཡང་རྣམ་བདུན་པོ་མཚོན་ནས་བསྟན་ཏོ།",
    "ཞེས་གསུངས་ལ།",
    "དེ་ལྟ་ན་རྣམ་འབྱེད་ཀྱི་སྐབས་ནས་དངོས་སུ་བསྟན་པའི་ཉེས་བྱས་ལ་བརྒྱ་དང་བཅུ་གཉིས་ལས་མང་བར་འགྱུར་བས་དཔྱད་དོ།",
    "གཉའ་ཤིང་གང་ལས་ལྷག་པར་ལྷ་དང་ལྔ།",
    "མགོ་གཡོགས་འདོམས་སྣང་གོས་བརྗེས་ཕྲག་པརགཟར།",
    "སྟན་ཐབས་སུ་བཀུར་བ་གཉིས་གསུངས་ཀྱང་།",
    "ཉེས་བྱས་འདི་གཉིས་ནི།",
    "ཟས་བླང་པར་ཉེས་པའི་ཉེས་བྱས་བརྒྱད་ནི།",
    "ལེགས་པར་མི་ལེན་མུ་ཁ་མཉམ་པོར་ལེན།",
    "ཟས་ལ་ལེགས་པར་བྱ་བ་དྲུག་པ་ཙུག་ཙུག་ལ་སོགས་རྣམ་པ་ལྔ།",
    "དེ་ལས་དང་པོ་ཟས་ཟ་ཚུལ་ཉེས་པའི་ཉེས་བྱས་དྲུག་ནི།",
    "ས་ལེགས་པར་མ་ཟོས་ཁམ་ཆེ་ཆུང་དང་ནི།",
    "རན་པར་མ་ཟོས་ཟ་བཞིན་ཁ་གདངས་ཤིང་།",
    "ཟས་ཀྱིས་ཁ་བཀང་ཚིག་སྨྲས་ཉེས་བྱས་དྲུག།",
    "ཟས་ཟ་ཚེ་སྒྲ་འབྱིན་པ་སོགས་ཀྱི་ཉེས་བྱས་ལྔ་ནི།",
    "ལྕེ་ཕྱིར་བྱུང་སྟེ་ཟ་བའི་ཉེས་བྱས་ལྔ།",
    "འབྲུ་ནས་ཐ་དད་ཕྱེ་བ་སོགས་ཀྱི་ཉེས་བྱས་ལྔ་ནི།",
    "ཁམ་འཕྲོ་བཅད་ཅིང་ཟ་བའི་ཉེས་བྱས་ལྔ།",
    "དཔལག་པ་ལྡག་པ་སོགས་ཀྱི་ཉེས་བྱས་ལྔ་ནི།",
    "མགོ་གཡོག་ལ་སོགས་ཀྱི་ཉེས་བྱས་ལྔ་ནི།",
    "ཆདོ་ཀེར་ཅན་ལ་སོགས་ཀྱི་ཉེས་བྱས་ལྔ་ནི།་",
    "གླང་ཆེན་ལ་བཞོན་པ་སོགས་ཀྱི་ཉེས་བྱས་ལྔ་ནི།",
    "མ་ལག་ན་འཁར་བ་ལ་སོགས་ཉེས་བྱས་དྲུག་ནི།",
    "སོར་བཤགས་བཅུ་གཅིག་ཉེས་བྱས་བརྒྱ་བཅུ་གཉིས།",
    "བསྙེན་བཀུར་བསྔགས་པ་མ་ལ་ཉེས་བྱས་སུ་ཞུ་བ་ཆུང་ཤོས་ལས་གསུངས་ཞེས་མཚོ་ཊཱིཀ་ལས་གསུངས་སོ་ ཁང་པ་དང་ཁང་ཆེན་གཉིས་མ་ལ་ཉེས་བྱས་སུ་ཞུ་བ་ཆུང་ཤོས་ལས་གསུངས་སོ།",
    "གྲོགས་མེད་པར་མི་ཐར་བའི་ཆུ་བོ་ལ་གྲུ་ལ་སོགས་པས་ཕྱིན་པ་དང་།",
    "༩ ནན་ཏུར་བྱས་པའི་དགེ་སློང་མ་རང་ལ་བཟོད་གསོལ་བཅུག་པ་དང་།",
    "ཅི་ཡང་རུང་བ་ལེན་དང་ལེན་འཇུག་སོགས་ལྷག་མ་དགུ་པོ་རྣམས་ལ་འ་ནས་བྱས་སུམཁའ་ལས་གསུངས་པ།",
    "ཞེས་གསུངས་པའི་ཕྱིར།",
    "༡ བྱིན་གྱིས་མ་བརླབས་པར་ལྷུང་བཟེད་ཞག་ཅིག་འཆང་བ་དང་།",
    "༣ སྲ་བརྐྱང་དབྱུང་བའི་རྐྱེན་མེད་པར་དུས་ཀྱི་སྔ་རོལ་དུ་ལས་ཀྱིས་དབྱུང་བ་དང་།",
    "གོས་ལྕི་བ་དང་ཡང་བ་བསྟེན་པ་བཞི་པོ་ཕ་ལ་ལྟུང་མེད་དུ་གསུངས་ལ།",
    "སྲ་བརྐྱང་དུས་ཀྱི་སྔ་རོལ་དུ་འབྱིན་པ་སོགས་ལྷག་མ་བཅུ་ལ་ཉེས་བྱས་སུ་གསུངས་སོ།",
    "སྲིན་བལ་སོགས་གཞན་དགུ་ནི་མ་ལ་ཉེས་བྱས་སུ་གསུངས་སོ།",
    "བརྟད་བྱུང་གཉིས་མ་ལའང་སྤང་ལྟུང་དུ་གསུངས་ལ།",
    "༡ རང་ཉིད་བསྙེན་པར་རྫོགས་ནས་ལོ་བཅུ་གཉིས་མ་ལོན་པར་གཞན་བསྙེན་རྫོགས་བྱེད་པའོ།",
    "༩ དེ་ལ་ལོ་གཉིས་སྤྱད་ཟིན་པ་བསྙེན་པར་རྫོགས་འདོད་ཡོད་པ་བསྙེན་པར་རྫོགས་པར་མི་བྱེད་པ་དང་།",
    "འབད་བྱས་འཁྲུལ་སྦྲུམ་མྱ་ངན་རྩབ་ཀྲོལ་དང་།",
    "༣ ཆུང་མ་ཁྱིམ་ཐབས་ཀྱིས་མ་གནང་བར་རབ་ཏུ་འབྱིན་ང་དགེ་སློང་མའི་རྣམ་འབྱེད།",
    "ཁ་པར་གྱི།",
    "བ་པ་འབག་དྲིལ་ཕྱིས་བྱས་པ་རྣམ་པ་ལྔ།",
    "ན་པར་ཆ་༡ སྨྱུགས་ཤད་གསུམ་དང་སྒྲ་བརྙན་དང་།",
    "༤ ཁྱིམ་པའི་སྟན་སྤྱད་པ་ཁྱིམ་པ་ལ་མ་སྦྲན་པར་བོར་ཏེ་འགྲོ་བ་དང་།",
    "༡ ན་བ་མིན་པར་སྒོག་སྐྱ་ཟ་བ་དང་།",
    "༦ དགེ་སློང་དང་ལྷན་ཅིག་བཟང་ངན་བརྗེ་བ་མ་གཏོགས་པར་སྣམ་སྦྱར་བརྗེ་བ་དང་།",
    "༡ དགེ་སློང་མ་གཞན་གྱི་བསོད་སྙོམས་ཀྱི་རྙེད་པ་ལ་སེར་སྣ་བྱས་པའོ།",
    "༡ དགེ་སློང་མའི་རྩོད་པ་བཞི་པོ་ལ་རང་ལ་མཐུ་ཡོད་བཞིན་པ་ཞི་བར་མ་བྱས་པའོ།",
    "༡ དབྱར་གྱི་ནང་ལྗོངས་རྒྱུ་ཞིང་རྒྱང་གྲགས་ལས་འདས་པར་འགྲོ་བ་རྣམས་སོ།",
    "༢ ཡུལ་འཁོར་དོགས་པ་དང་བཅས་པར་དང་དགྲ་བོ་མི་མཐུན་ཡོད་པར་འགྲོ་བ་དང་།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "མ་ལ་སོར་བཤགས་སུ་འགྱུར་རོ།",
    "ལྷག་མ་དགུ་བཅུ་གོ་གཉིས་པོ་རྣམས་ནི་ཉེས་བྱས་སུ་འགྱུར་བ་གསུངས་ལ",
    "བཅུ་དྲུག་པོ་ལས་གཞན་དགུ་བཅུ་གོ་གཉིས་པོ་རྣམས་ནི་དགེ་སློང་ཕ་ལ་ཉེས་བྱས་སུ་འགྱུར་བར་གསུངས་སོ།",
    "དགེ་སློང་མ་ཡི་སོར་བཤགས་བཅུ་གཅིག་འཆད་པ་ནི།",
    "བསླབ་དྲལ་སོ་སོར་བཤགས་པ་བཅུ་གཅིག་གོ།",
    "ཁྱིམ་སྡོམ་སྦྱིན་པ་ལས་ཟས་བསླངས་ཏེ་ཟོས་པ་སྟེ་མའི་སོར་བཤགས་བཅུ་གཅིག་གསུངས་ལ།",
    "མའི་སོར་བཤགས་བཅུ་གཅིག་པོ་འདི་རྣམས་དགེ་སློང་ཕ་ལ་ཅི་འགྱུར་ནི།",
    "དེ་ལྟར་ན་སོ་སོར་བཤགས་པར་བྱ་བ་གསུམ་པོ་དེ་དག་ནི།",
    "ཞེས་གསུངས་པས་ཟས་ལེན་པ་དང་གྲལ་རིམ་དུ་མ་ཕེབས་པ་དང་ནགས་མ་བརྟགས་པར་ཟས་ཟོས་པ་གསུམ་ཡང་མ་ཡི་སོར་བཤགས་སུ་གསུངས་ཁམ་ཡི་ཉེས་བྱས་བརྒྱ་དང་བཅུ་གཉིས་འཆད་པ་ནི།",
    "ཕ་ལ་ཉེས་བྱས་ཙམ་ཞིག་འགྱུར་བར་གསུངས།",
    "དཔར་དུ་བསྐྲུན་པའི་རྣམ་དཀར་ཕུང་པོའི་མཐུས།",
    "དེ་བྱས་པ་སྟན་བདེ་མི་འདབ་མཉིས་པ་ད་ང་བྱེད།",
    "། རྫོགས་པ་ཆེན་པོ་ཞང་ཞུང་སྙན་རྒྱུད་ཀྱི་ཉམས་རྒྱུད་རྒྱས་པའི་སྐོར་བཞུགས་སོ།",
    "དེ་དག་ནི་གདོད་མའི་དུས་རབས་ནས་བྱུང་བའི་བོད་མི་སྤྱང་གྲུང་བ་རྣམས་ཀྱིས་རང་བྱུང་ཁམས་ལ་འཐབ་རྩོད་བྱས་པའི་དངོས་ཡོད་ཉམས་མྱོང་བརྒྱུད་དེ།",
    "ཡང་ན་ཡི་གེར་བཀོད་ནས་ཉར་ཚགས་དམ་པོར་བགྱིས་ཏེ་ད་ལྟའི་བར་དུ་བཞུགས་པ་འདི་དག་ཡིན།",
    "དག་སྒྲིག་བྱེད་མཁན་བཅས་ཀྱིས་ཧུར་བརྩོན་གྱིས་འབད་པ་ཆེན་པོས་ཕྱག་ལས་ཤུགས་ཆེན་གནང་བ་བརྒྱུད་དེ་འབྲས་བུ་གཡུར་དུ་ཟ་བའང་བླངས་ཡོད་པས།",
    "རྣམ་མཁྱེན་སྟོན་པ་གཤེན་རབ་མི་བོ་ཆེ་མཆོག་མི་མཇེད་འཇིག་རྟེན་གྱི་ཞིང་འདིར་བྱོན་ནས་ད་ལྟའི་བར།",
    "སྤྱི་ལོ་སྔོན་གྱི་ལོ་ངོ་ཆིག་ཁྲི་དྲུག་སྟོང་བཅུ་བདུན་ཏེ་ཤིང་བྱི་ལ་སྐུ་འཁྲུངས་པར་གསུངས་ཡོད་དེ།",
    "གངས་རིའི་ལྗོངས་འདི་སྔར་ལས་རི་མཐོ་ས་གཙང་རྩི་བཅུད་ལེགས་པ་དང་།",
    "ཕྱིའི་སྣོད་ཀྱི་བཀོད་པ་མཛེས་སྡུག་ཅན་གྱི་རྣམ་པར་ལྷུན་ཆགས་ཤིང་།",
    "རང་དོན་ཡིད་བྱེད་ལྟ་བུའི་དམིགས་པ་གཙོར་བཟུང་ནས་མཁས་འདོད་གྲགས་འདོད་ཀྱི་ཆེ་བ་ཙམ་མ་ཡིན་པར།",
    "དེ་སྔོན་རང་རྒྱལ་གྱི་དཔེ་སྐྲུན་ཁང་སོ་སོ་ནས་པར་དུ་བཏབ་མ་མྱོང་ཡང་།",
    "གཤེན་ཀུན་མཁྱེན་ཡེ་ཤེས་བློ་གྲོས་ཀྱི་གསུང་རྩོམ་པོད་གཅིག་གཤེན་ཉི་མ་རྒྱལ་མཚན་གྱི་གསུང་འབུམ་པོད་གསུམ།",
    "མིང་བརྡ་ཐ་སྙད་ཀྱི་ཆར་ཞང་སྐད་དང་བརྡ་རྙིང་མང་པོ་རྒྱུད་འཛིན་བྱས་ཡོད་པ།",
    "བོན་གྱི་གནའ་དཔེ་སྲུང་སྐྱོང་མྱུར་སྐྱོབ་ཀྱི་བྱ་བ་ལ་རྒྱལ་ཁབ་ཀྱིས་སྔར་ལས་ལྷག་པའི་མཐོང་ཆེན་གནང་སྟེ།",
    "གྲངས་ཉུང་མི་རིགས་ཀྱི་སྐད་དང་ཡི་གེའི་ཆེད་དངུལ་རོགས་སྐྱོར་ལས་གཞི་ཞེས་རྒྱལ་ཁབ་རིམ་པའི་ལས་གཞི་གཉིས་ཀྱི་ནང་དུ་ཚུད་པར་མངོན།",
    "པོད་གཉིས་པ་ནས་པོད་དགུ་པའི་བར་དམུ་རིགས་གཤེན་གྱི་གདུང་རབས་རིམ་བྱོན་ལས་གཤེན་སྟོན་ནམ་མཁའ་རྒྱལ་མཚན་དང་གཤེན་ཀུན་མཁྱེན་ཡེ་ཤེས་བློ་གྲོས།",
    "ཁྱད་པར་དུ་བསྟན་པ་ཕྱི་དར་སྐབས་སུ་ལྷོ་གཏེར་གྱི་མཛོད་སྒོ་ཕྱེ་བའི་གཏེར་སྟོན་ཆེན་པོ་གཤེན་ཆེན་ཀླུ་དགའ་སོགས་ནི་མཚན་སྙན་གྱི་བ་དན་སྲིད་ན་མཐོ་བའི་དམུ་རིགས་གཤེན་གྱི་གདུང་འཛིན་ཆེན་པོ་དག་ཡིན།",
    "གཤེན་སྟོན་ཆེན་པོ་ནམ་མཁའ་རྒྱལ་མཚན་དང་གཤེན་ཀུན་མཁྱེན་ཡེ་ཤེས་བློ་གྲོས།",
    "ཁོང་ནི་གཤེན་གྱི་གདན་ས་ཁྲི་བརྟན་ནོར་བུ་རྩེའི་མཁན་རབས་ཉི་ཤུ་པ་ལགས་ཤིང་།",
    "ཀུན་མཁྱེན་ཤེས་རབ་དགོངས་རྒྱལ།"
  ]
}