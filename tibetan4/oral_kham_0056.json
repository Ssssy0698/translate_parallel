    "ཝང་མགོ་ཆེས་ཁྱི་ཕྲུག་ཐར་གྱི་ཨུ་ཚུགས་ལ་འགྱུར་ལྡོག་ཅུང་ཙམ་ཡང་བྱུང་མི་འདུག་པ་མཐོང་ནས་ཁ་ཏ་བྱེད་པའི་ཚུལ་གྱིས།",
    "ཁྱི་ཕྲུག་ཐར་གྱིས་ཁོ་རང་མཐོང་འཕྲལ་གྲོགས་པོ་རྙིང་བ་ཞིག་བསྐྱར་དུ་འཕྲད་པ་ལྟར་ཧ་ཅང་དགའ་བའི་ངང་།",
    "འོ་ན་ཁྱི་ཕྲུག་ཐར་དང་ཁོའི་རོགས་པ་དེ་ཚོས་ད་ལྟ་ཅི་ཞིག་བྱེད་བཞིན་འདུག་ཁོ་ཚོའི་ཕྱོགས་ན་ཁུངས་སྣེ་འདྲ་མེད་དམ།",
    "དོན་འདི་ཡ་མཚར་བོ་འདུག་པས་ལྐོག་ཏུ་རྩད་ཞིབ་བྱོས།",
    "ཟེར་བ་དང་སླར་ཡང་རང་ཉིད་ལ་ལེ་བདའ་བྱས་བྱུང་།",
    "འདི་ཚང་མ་ང་རང་ལན་པ་ཡིན།",
    "དེ་ལས་ལྡོག་སྟེ་དོན་དག་ཕྱི་ལ་སྒྲོག་པའི་རྒྱང་སྒྲོག་ལྟ་བུར་གྱུར་འདུག་ལ།",
    "ཝང་མགོ་ཆེ་ཡུལ་གཙོའི་གཞུང་ལས་ཁང་དུ་ཐོན་དུས་ཡུལ་གཙོ་པད་ཐར་དངོས་གནས་ཁྲོས་འདུག་ཁོ་རང་ནང་དུ་ཐོན་མ་ཐག་ནས་བཀའ་བཀྱོན་གནང་བྱུང་།",
    "ཝང་མགོ་ཆེས་ནི་ད་དུང་དོན་དག་ཅི་ཞིག་བྱུང་བའང་ཤེས་མེད་པས་སྐད་ཆ་དེའི་ནང་དོན་མ་གོ་བ་དང་ལན་ཡང་ཇི་ལྟར་གདབ་དགོས་པ་མ་ཤེས་པར་དེ་གར་ཀྲོང་ཀྲོང་ངེར་ལངས་ནས་འདུག་དགོས་བྱུང་།",
    "ཡུལ་གཙོས་ཁོར་ལན་གདབ་རྒྱུ་ཅི་ཡང་མི་འདུག་པ་མཐོང་འཕྲལ་མུ་མཐུད་དུ་མང་པོ་མ་བཤད།",
    "སླར་ཡང་ཁྱི་ཕྲུག་ཐར་གྱི་སྟེང་ལ་སྔར་བས་བཟོད་མི་ཐུབ་པའི་ན་ཟུག་སྐྱེས་བར་གྱུར་ཏེ་ཁོ་རང་རང་ཉིད་ཀྱི་གན་ནས་གཉའ་ཞུམ་སྟེ་འགྲོ་དགོས་པ་ཞིག་ཏུ་ཇི་ལྟར་གཏོང་བར་བསམ་བློ་བཏང་།",
    "ང་རང་ཡང་མི་གྲལ་ནས་འགྲོ་བར་ངོ་ཚ་འོང་ཟེར།",
    "འོ་ན་ང་རང་མི་གྲལ་དུ་འགྲོ་བར་ངོ་མི་ཚའམ།",
    "ཡུལ་གཙོ་དང་ཆུང་མས་ཕག་ཕྲུག་རྙེད་འདུག་པ་མཐོང་ནས་ཧ་ཅང་དགའ་བྱུང་ལ།",
    "དྲང་བོ་བྱས་ན་དེ་ལས་ལྷག་པའི་དྲང་བོ་ཞིག་མི་འདུག་ལ།",
    "གཞོང་གྲུག་སྟེགས་བུ་འགའ་དགོས་པར་འདུག་བལྟ་དང་ཟེར།",
    "དེ་བས་རང་རང་སར་ཚོད་དཔག་སྣ་ཚོགས་བྱེད་བཞིན་ཕན་ཚུན་ལ་ཤགས་འགྱེད་བྱས།",
    "ད་དུང་ནང་ཁྲོལ་ཀྱང་རྒྱ་སྒོའི་ཁར་འཕངས་འདུག་ཟེར།",
    "འགྲོ་ས་གཅིག་མ་གཏོགས་མི་འདུག་ཟེར།",
    "ཁྱི་ཕྲུག་ཐར་གཅིག་པུ་འདུག་ཅེས་ཞུ་དགོས་བྱུང་།",
    "ཁྱི་ཕྲུག་ཐར་གཅིག་པུ་འདུག་ཡུལ་གཙོ་པད་ཐར་གྱིས་ངག་ནས་བསྐྱར་བཟླས་ཤིག་བྱས་རྗེས་སྨྲ་བ་མེད་པར་བསམ་བློ་གཏོང་བཞིན་བསྡད་བྱུང་།",
    "ཡུལ་གཙོས་ཁོ་རང་འབོལ་སྟེགས་སྟེང་དུ་སྡོད་དུ་བཅུག་ནས་ཐ་མག་སྤུས་ལེགས་ཤིག་སྟེར་བཞིན།",
    "ངོ་མ་ཞིམ་པོ་འདུག་ཟེར།",
    "ཡུལ་གཙོས་གཞི་ནས་མགོ་བོ་ཡར་བཏེགས་ཏེ་ད་སོ་མར་ཁོ་རང་མཐོང་བ་ལྟར།",
    "ཁོའི་སེམས་ལ་ཡུལ་གཙོས་ཁོ་རང་ལ་ཁ་གྲག་མ་འདོད་པ་ཨེ་ཡིན་ནམ་སྙམ་ནས་ཐེ་ཚོམ་པར་གྱུར།",
    "ཧ་ཅང་ཞིམ་པོ་འདུག་ཚང་མས་ཐུངས་དང་།",
    "མགྲོན་པོ་ཚོས་ཀྱང་ཅོག་ཙེ་དང་འདུག་སྟེགས་ཅི་ཡང་མི་དགོས་ལ་སྤམ་རྫུ་དང་འཛེམ་དོགས་ཅི་ཡང་མེད་པའི་སྒོ་ནས་བཟའ་མགོ་བརྩམས།",
    "ཡུལ་གཙོས་ནི་དོན་དག་ཆེན་པོ་ཞིག་བསྒྲུབས་ཏེ་ཐང་ཆད་ཡོད་པ་ལྟར་འདུག་སྟེགས་སྟེང་དུ་སྒྱིད་ལུག་ངང་ཐ་མག་འཐེན་བཞིན་ངལ་གསོས་བརྒྱབ་ཡོད་ལ།",
    "ཁྱི་ཕྲུག་ཐར་གྱིས་གུས་ཚུལ་དང་བཅས་ཡུལ་གཙོས་ང་རང་འབོད་པ་ཡིན་ནམ་ཞེས་ཞུས།",
    "སུན་གྱིན་མི་འདུག་ཅེས་ཞུས།",
    "དེ་ལོས་ཡིན།",
    "ད་ནི་གཞོང་གྲུག་སྲུང་ནས་འདུག་ཁོམ་ག་ལ་ཡོད།",
    "ཁྱི་ཕྲུག་ཐར་ནི་དེ་མ་ཐག་ཡར་ལངས་ནས་རང་ཉིད་ཀྱི་འཁྲིས་སུ་འདུག་སྟེགས་ཤིག་བཞག་ནས་དེ་རུ་སྡོད་པར་སྐུལ།",
    "ཁྱི་ཕྲུག་ཐར་ནི་ད་ལྟ་ངོ་མ་མི་ཞིག་ཏུ་གྱུར་འདུག་ད་ལྟ་རང་ཉིད་ལ་རླངས་འཁོར་ཞིག་ཡོད་པར་མ་ཟད་ད་དུང་ཡུལ་གཙོའི་བློས་ཐུབ་ཅིག་ཏུའང་གྱུར་ཡོད་པ་འདྲ།",
    "ཁྱིམ་མི་ཆད་མི་ཆོག་བྱང་བུ་དག་ཁྱིམ་ཚང་རང་རང་ལ་དོ་དམ་ལེགས་པོ་བྱེད་དུ་འཇུག་དགོས་པར་མ་ཟད།",
    "ཤགས་འགྱེད་ཇི་ལྟར་བྱས་ཀྱང་བདེན་ཐག་གཅོད་པའི་དཔང་རྟགས་ཅི་ཡང་མི་འདུག་པས་གསར་བུ་ཚོས་ཕན་ཚུན་བར་གྲོས་བྱས་ཏེ།",
    "ཡོད་ཚད་གཉིད་དུ་ཡུར་ཟིན་པ་ལྟར་ནག་རོག་གེར་གྲགས་འགུལ་ཅི་ཡང་མི་འདུག་ལ།",
    "ང་རང་ཡིན་ཟེར་བ་ཅི་ཡིན།",
    "ང་རང་ཆུ་ཁོལ་ཞིག་སློང་དུ་ཡོང་བ་ཡིན་ཞེས་བཤད།",
    "ང་རང་ཅུང་ལྷོད་དུ་བབས་བྱུང་།",
    "ཆང་འཐུངས་ཏེ་ཉལ་རྒྱུའང་མི་ཤེས་པར་འདུག་གམ་ཞེས་ཟེར།",
    "ང་རང་ཕྱིར་ཡོང་ཞོར་དུ་གཞི་ནས་རང་ཉིད་གསར་བུ་དེ་ཚོའི་གཡོ་འོག་ཏུ་ཚུད་པ་ཡིན་པ་རྟོགས་བྱུང་།",
    "ཁོའི་གདོང་ལ་སྔར་མེད་པའི་འཛུམ་ཞིག་ལངས་འདུག་པར་མ་ཟད་ད་ཐེངས་ལག་ཏུ་ཆང་སྤུས་ལེགས་ཤེལ་དམ་གཅིག་ཀྱང་ཁྱེར་འདུགང་རང་ཡར་ལངས་ཏེ་ཁོ་རང་མལ་ཁྲིའི་མཐའ་འགྲམ་དུ་སྡོད་དུ་བཅུག་པ་ན།",
    "མ་གཞི་མི་དེ་ཚོས་ཆེད་དམིགས་ཀྱིས་ང་ལ་བསྙད་བརྐོ་བ་ཡིན་འདུག་གལ་སྲིད་ཁོ་ཚོ་ངའི་ལག་ཏུ་ཚུད་ཐུབ་པ་བྱུང་ན་ངས་ཁོ་ཚོར་སྐྱག་པའང་གཏོང་མི་ནུས་པ་ཞིག་བྱེད་ངེས་ཟེར་བ་དང་།",
    "འོན་ཀྱང་ད་ཐེངས་ཀྱི་སྐད་ཅོར་གྱི་ནང་དོན་ནི་ད་སྔོན་གྱི་ང་རང་དམྱལ་ཁམས་བཅོ་བརྒྱད་ཀྱི་ཞབས་ནས་སྐྱེ་ངེས་པའི་སྨོན་འདུན་སོགས་གང་ཡང་མ་ཡིན་པར།",
    "ཞེས་ལྷང་ལྷང་དུ་གྲགས་ཀྱིན་འདུགདོན་དག་དེས་ངའི་སེམས་སྐྱིད་པོ་ཞིག་བྱུང་དུ་མ་བཅུག་པས།",
    "དེ་རྗེས་ཁྱི་རྒན་རྒྱ་བྷའི་སྐེ་ལ་ཐག་པ་བརྒྱབ་ནས་སྒོ་ཁིས་ཀྱི་ཁོ་རང་ཉལ་སའི་གནས་སུ་འདོགས་པར་བྱེད།",
    "འོན་ཀྱང་ང་རང་རང་གར་སྡོད་མི་བདེ་བ་ཞིག་བྱུང་བས་གཞུང་ལས་ཁང་དུ་ཕར་འགྲོ་ཚུར་འགྲོ་བྱེད་བཞིན་ཁོང་གཉིས་ཀྱི་སྐད་ཆའི་མཇུག་འབྲས་ལ་བསྒུགས་ནས་བསྡད།",
    "ཁོས་ཀྱང་གོ་རིམ་དེ་བརྒྱུད་ནས་ང་ལ་འཁོན་ལན་སློག་པའི་གོ་སྐབས་ཤིག་བཙལ་སྙམ་པ་ཡིན་འདུག་འདི་དག་ངས་རྗེས་ནས་ད་གཟོད་ཚོར་རྟོགས་བྱུང་བ་ཡིན།",
    "ཐ་ན་སློབ་ཁང་ནང་དུ་ཡང་དཔོན་ཚུགས་ངོམ་ཀྱིན་འདུག་སྙམ་བྱུང་།",
    "ཨ་ཙི།",
    "ངས་ཀྱང་ཁོའི་སྐད་ཆ་དེར་གནས་ལུགས་འདུག་པ་རྟོགས་ཀྱང་།",
    "སྐྱབས་ལོ་ནི་གསར་བུ་རྩེ་དགའ་ཅན་ཞིག་ཡིན་པར་མ་ཟད་མི་གཞན་དག་བསྡུར་ན་ཧ་ཅང་སྣང་བ་མཐུན་པ་ཞིག་ཀྱང་འདུག་ལ།",
    "སྐྱབས་ལོས་དེ་ལ་སྣང་དོགས་ཙམ་ཡང་མི་བྱེད་པར་ཁྱེལ་འདུག་ཅིག་བྱས་ནས་དེའི་ཕྱོགས་ནས་ང་ལ་ཐབས་བཀོད་ཡོད་ཟེར་ནས་མུ་མཐུད་དུ་ཆང་འཐུང་བྱུང་།",
    "སྒྲོལ་མ་སྐྱིད་ཀྱིས་ཅུང་འཚེར་སྣང་བྱེད་པའི་ཉམས་ཀྱིས་མལ་ཁྲིའི་མཐའ་རུ་མི་སྡོད་པར་ལངས་ནས་བསྡད་ཅིང་ནང་ཡོངས་ལ་མིག་ཉུལ་ཞིག་བྱས་རྗེས་ངོ་ལ་འཛུམ་ཞིག་ལངས་འདུག་པས།",
    "ངོ་མ་ལྟ་རྒྱུ་འདུག་ཡིན་ན་ཡང་བདེ་སྤྱོད་བཟང་བོའི་ཁ་ནས་གཏམ་ཤོར་བ་དེར་ཅི་འདྲའི་ཕངས་པ་ལ་ཨང་ཟེར་ནས་དགོད་པར་བྱེད།",
    "བསམ་ཡུལ་ལས་འདས་པ་ཞིག་ལ་ཁོ་ནི་དེ་ལས་ལྡོག་སྟེ་གཉེན་གཏམ་དུ་ཡོང་བ་ཡིན་འདུག་ང་རང་དེ་མ་ཐག་སེམས་བློང་བློང་བོར་གྱུར་ཏེ།",
    "ང་རང་ཕ་ཡུལ་དུ་འབྱོར་དུས་སུ།",
    "མིག་མདངས་དེ་ལས་ཧ་ཅང་ཡིད་སྨོན་བྱེད་ཀྱིན་ཡོད་པའི་ཉམས་ཤིག་ཀྱང་མངོན་འདུག་ཐ་མི་གྱ་བྷ།",
    "ང་རང་མུ་མཐུད་དུ་དེ་གར་སྡོད་འདོད་མ་བྱུང་བར་དེ་མུར་ཡར་ལངས་ཏེ་རང་ཁྱིམ་དུ་ཡོང་དགོས་བྱུང་།",
    "ད་ནི་ར་མ་ཡང་བཙོང་ཟིན་པས་ང་རང་གཅིག་པུ་ཡུལ་ནས་འདུག་མི་ཐུབ་རྒྱུ་ཅི་ཡོད།",
    "མི་ཆོག་ང་རང་གཏན་ནས་ཡིད་འཐད་མིན་ཟེར།",
    "ང་རང་ཡང་ཧ་ཅང་ཚིག་པ་ཟོས་ཏེ།",
    "ད་དུང་ང་རང་མི་གྲལ་ནས་འགྲོ་བར་ངོ་མི་ཚའམ་ཞེས་བཤད།་",
    "མཇུག་མཐར་གན་དུ་མི་མང་པོས་བལྟས་འདུག་པ་མཐོང་ནས་ཧ་ཅང་འཚེར་སྣང་སྐྱེས་བྱུང་བ་འདྲ།",
    "ཆེད་དུ་ང་ལ་ཚོད་བགམ་པར་འདུག་སྙམ་ནས།",
    "ཕྱོགས་གཅིག་ནས་ང་རང་ཡུལ་དང་ཐག་རིང་ཞིང་དུས་ཡུན་རིང་པོར་ཆུང་མ་དང་གྱེས་སྡོད་བྱེད་པར་གདུང་སེམས་འཆངས་ཀྱིན་པའི་ནང་དོན་འདུག་ལ།",
    "ཁོ་རང་ཕར་འགྲོ་བཞིན་པའི་སྐབས་དེར་ངའི་མི་རྒྱ་ཐཱ།",
    "ཚང་མ་བྲིས་ཚར་འདུག་གཅིག་ཀྱང་ནོར་མི་འདུག་ལྟོས་དང་།",
    "ད་དུང་མཇུག་ཏུ་ཚིགས་བཅད་ཅིག་ཀྱང་བྲིས་འདུག་ཟེར་ནས་རྒྱུགས་ཤོག་ངའི་ལག་ཏུ་སྤྲད་བྱུང་།",
    "དངོས་གནས་ཚང་མ་བྲིས་ཚར་འདུག་པར་མ་ཟད་ནོར་ཡོད་པ་གཅིག་ཀྱང་མི་འདུག་ལ།",
    "ཞེས་པའི་གཞས་ཚིག་ཅིག་བྲིས་འདུག་པས།",
    "ང་རང་ཕྱིར་མལ་ཁང་ནང་དུ་ཡོང་ནས་བསྡད་པ་ན་ལུས་སྟེང་ནས་ཁུར་བོ་ཆེན་པོ་ཞིག་ཕབ་ཟིན་པའི་སྣང་བ་སྐྱེས་ལ།",
    "ཁོང་གཉིས་ཀྱི་གྱོད་ཡ་ང་རང་ཡིན་དུ་ཆུགས་ཀྱང་།",
    "ཕྱི་ཉིན་སྔ་སེ་ང་རང་གཞུང་ལས་ཁང་དུ་འགྲོ་དུས།",
    "ཁོ་རང་གུས་ཚིག་འདི་རིགས་ལ་ཧ་ཅང་དགའ་བོ་ཡོད་པས།",
    "དྲི་བ་འདོན་པའི་དུས་སུ་ནམ་རྒྱུན་ལྟར་མིག་ཟུང་ལས་ངའི་ཁ་ནང་ནས་ཅི་ཞིག་ཐོབ་འདོད་ཀྱི་འོད་ཅིག་འཕྲོ་བཞིན་ངའི་གདོང་ལ་ཅེར་ནས་འདུག་མདང་དགོང་ང་རང་གང་དུ་འགྲོའམ།",
    "ངས་དེ་འཕྲལ་མདང་དགོང་རང་ཉིད་ཇི་ལྟར་ཉལ་བའི་བརྒྱུད་རིམ་ལ་ཕྱིར་འདང་ཞིག་རྒྱག་བཞིན།",
    "ཁོས་ད་དུང་མུ་མཐུད་དུ་དྲི་བ་བཏོན་ཡོང་བ་དེ་ནི་ང་རང་ལ་ཡིད་ཆེས་མི་བྱེད་པའི་རྣམ་འགྱུར་ཡིན་པས།",
    "ངས་ཁོ་ཚོས་ཇི་ལྟར་ཤེས་པའི་ཐད་ལ་བརྟག་དཔྱད་ཞིབ་འཇུག་བྱ་དགོས་དོན་མི་འདུག་པས་དེ་ངས་མ་ཤེས་ཞེས་ལན་བཏབ།",
    "ཡུན་རིང་ཙམ་ལ་ངེད་གཉིས་ལ་ཁ་བརྡ་མི་འདུག་པས་རང་རང་སར་དེ་ལྟར་སྡོད་དགོས་བྱུང་།",
    "དེ་ཙམ་གྱི་ཆེད་དུ་ཉིན་བཞིན་ཆུ་ཁོལ་མ་འཐུང་བར་འདུག་པ་ཡང་གཞན་གྱིས་ཤེས་ཚེ་ངོ་གནོང་དགོས་པ་ཞིག་མ་ཡིན་ནམ།"
  ]
}