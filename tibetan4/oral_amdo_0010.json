    "བྱི་ལའི་གཞང་གིས་ཀཀྐོ་ལ་སྒོ་བསྡམ།",
    "ཁྱི་ར་མོ་ཡི་མཚན་ཤ་ཚིལ་དགའ་སྦྱིན།",
    "སོག་ཐལ་ཚད་རྙིང་ལུས་ལ་ཞེན་པ་འགོག།",
    "མི་རུས་གང་རུང་ཐལ་བས་རྨ་འབྲས་གཅོད།",
    "འབྲུག་གཟིག་རུས་པས་ཁྱི་རྨ་ལྷོག་ཐབས་འཇོམས།",
    "ར་ཡི་དཔྱི་རུས་ཐལ་བས་གག་པ་དང་།",
    "ཁྲུང་ཁྲུང་བྱ་རྒོད་རྔ་མོང་ཆུ་འགགས་སེལ།",
    "སྟག་གཟིག་རུས་པའི་ཐལ་བས་སྐྲན་ལ་བརྐོ།",
    "འགྲོན་ཐལ་ཁྲག་གཅོད་འགྲིལ་བཤིག་རྣག་ཆུ་སྐེམ།",
    "འབྲོང་གི་རྐང་མར་བྱུགས་པས་རྨ་ལ་ཕན།",
    "མི་ཡི་རྐང་བྱུགས་རེག་བྱ་ཚོར་བར་བྱེད།",
    "རྨིག་ཟླུམ་རྐང་གིས་ཤུ་བ་ཟ་རྐོང་འཇོམས།",
    "རྐང་རིགས་གང་བྱུང་ཡན་ལག་རེངས་འཁུམ་མཉེན།",
    "གཟུགས་མོ་ཁྱི་གུའི་ཀླད་པས་ཀླད་འཛག་གཅོད།",
    "ཝ་ཀླད་རྩ་སྡོམ་ཉ་ཀླད་མོ་ཆགས་སྐྱེད།",
    "ལུག་གི་ཀླད་པས་མགོ་འཁོར་མཚོ་འཁྱོམ་གསོ།",
    "ར་ཚིལ་སྲིན་དང་རེག་དུག་རྨ་ལ་ཕན།",
    "བཅུ་དྲུག་ཁྲག་གི་ཕན་ཡོན་བསྟན་པ་ནི།",
    "ཕག་ནག་སྣ་ཁྲག་ར་རོག་གཉའ་ཁྲག་གིས།",
    "ཤ་བའི་ཁྲག་གིས་སྲིན་གསོད་ཟླ་མཚན་གཅོད།",
    "པད་མའི་རྡུལ་འབེབས་ཨོག་ཞོལ་ཁྲག་གིས་བསྡམས།",
    "ར་ཡི་ཁྲག་གིས་རེག་དུག་འབྲུམ་ནག་སེལ།",
    "གཙོད་དང་གཡག་རྒོད་ཁྲག་གིས་འཁྲུ་བ་གཅོད།",
    "གཟུགས་མོའི་ཁྲག་གིས་སྨིན་མ་བྱི་བ་སྐྱེ།",
    "གླང་དམར་ཐུག་པོའི་གསོན་ཁྲག་དྲོན་མོ་ཡིས།",
    "མི་རྒོད་སེང་གེ་སྟག་གཟིག་དོམ་ར་རྒོད།",
    "སྲེ་མོང་ཤ་ཡིས་ཤ་ལས་སྦྱར་དུག་དང་།",
    "སྐྱར་མོའི་ཤ་ཡིས་ཉྭ་ཤར་སྦྱར་དུག་སེལ།",
    "གྲུམ་པ་ཏི་ལོ་སྲེ་མོང་གསུམ་གྱི་ཤས།",
    "བྱ་མོ་ནག་མོའི་ཤ་ཡིས་སྦྱར་དུག་སེལ།",
    "སྦ་བྱི་ཟེར་མོ་ཁུ་བྱུག་ཤིང་རྟ་དང་།",
    "ཕུ་དིག་ནེ་ཙོ་ཁྱིམ་བྱ་གོང་མོ་སྲེག།",
    "འཇོལ་མོ་མཆིལ་བ་ལ་སོགས་བྱིའུ་སྣ་ཚོགས།",
    "ཁྲུང་ཁྲུང་ངུར་བ་དཀར་སེར་ཆུ་སྐྱར་མོ།",
    "ར་ཝགས་རློན་པས་སྲིན་དང་རེག་དུག་སེལ།",
    "ཕོ་རྨོངས་མོ་ཡི་སྤྱི་སྐྲས་བུ་འབྱིན་བྱེད།",
    "ཕོ་རྨོངས་མོ་གདོན་གཙོར་གྱུར་གདོན་ཀུན་འཇོམས།",
    "མོ་རྨོངས་དུད་པས་རྟ་བོང་ཁྲག་དུག་འཇོམས།",
    "སྟག་གསོན་སྨ་རས་དུག་སེལ་སྟག་གཟིག་སྤུས།",
    "སྲེ་མོང་སྨ་རས་བྱ་ཤར་སྦྱར་དུག་འཇོམས།",
    "རྔ་མོང་ཤ་བ་ར་སྤུས་རྨ་རེབ་འདུལ།",
    "ལུག་ཐུག་ནག་པོའི་སོག་བལ་མོ་གདོན་སྲུང་།",
    "བྱ་རོག་མཇུག་སྤུས་རྨ་གསོ་སྐྱར་མོའི་སྤུའི།"
  ]
}