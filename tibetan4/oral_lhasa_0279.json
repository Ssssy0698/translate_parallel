    "དེ་ནི་རྣམ་པ་བརྒྱད་དུ་རིག་པར་བྱ་སྟེ།",
    "སེམས་ཀྱི་རྒྱུད་ཐ་དད་པ་མེད་པའི་བྱམས་པས་མཉམ་པར་སོ་སོར་ཀུན་དགའ་བར་བྱེད་པ་ཉིད་དང་།",
    "འདུ་འཛིའི་གཏམ་སྤངས་ཏེ་དགའ་བའི་བཞིན་དུ་བྱས་ནས་ཁུར་བླངས་པ་ཉམས་སུ་ལོན་པར་བྱེད་པ་ཉིད་དང་།",
    "མཉམ་པར་ཁུར་མ་བླངས་པ་ལེན་པར་བྱེད་པ་ཉིད་དང་།",
    "མཉམ་པར་གདུལ་བ་དཔག་ཏུ་མེད་པའི་ཐབས་ཡོངས་སུ་ཚོལ་བ་ཉིད་དང་།",
    "མཉམ་པར་ཕན་ཚུན་ཚིག་ཡང་དག་པར་བཟོད་པའི་ཚིག་དང་ལྡན་པ་ཉིད་དང་།",
    "དེ་ནི་རྣམ་པ་བདུན་དུ་རིག་པར་བྱ་སྟེ།",
    "ཡོངས་སུ་སྨིན་པར་བྱ་བའི་ཐབས་ལ་མཁས་པ་ཉིད་དོ།",
    "ཡང་དག་པར་སྒྲུབ་པར་བྱེད་དོ།",
    "དེ་ནི་རྣམ་པ་བཅུ་གཉིས་སུ་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་བརྟེན་ནས་གུས་པར་བྱས་ཏེ་གདམས་ངག་ལེན་པར་བྱེད་པ་ཉིད་དང་།",
    "མི་འགྲོགས་པར་དེ་ལས་གཞན་པ་རྣམས་དང་འགྲོགས་པ་ཉིད་དང་།",
    "འཇིག་རྟེན་པའི་ཤེས་པས་ཆོག་པར་མི་འཛིན་པར་འཇིག་རྟེན་ལས་འདས་པའི་ཤེས་པ་ཡོངས་སུ་ཚོལ་ཞིང་རྣམ་པར་སྦྱོར་བ་ཉིད་དང་།",
    "ཤེས་པ་རྣམ་པར་དག་པའི་ཉེས་པ་བཞི་སྤངས་ཏེ་ཚོགས་ཡོངས་སུ་སྡུད་པ་ཉིད་དེ།",
    "མ་ངེས་པར་སྟོན་ཅིང་འདོམས་པ་ཉེས་པ་དང་།",
    "དྲང་བའི་དོན་བསྟན་པར་བྱ་བ་མ་ཡིན་པ་ལས་ཤིན་ཏུ་འདས་ནས།",
    "ངེས་པའི་དོན་བསྟན་པར་བྱ་བ་ལ་བརྩོན་པར་བྱེད་པ་ན་ཚུལ་བཞིན་ལ་བརྩོན་པ་ཞེས་བྱའོ།",
    "གང་ཟག་སྟོང་པ་ཉིད་སྨོས་པར་བྱེད་པ་དང་།",
    "དེ་ཉིད་ཀྱེ་མཐུ་སྨོས་པར་བྱེད་དོ།",
    "ཇི་ལྟར་གང་ཟག་སྟོང་པ་ཉིད་སྨོས་པར་བྱེད་ཅེ་ན།",
    "དེའི་ལོངས་སྤྱོད་ཀྱི་དངོས་པོ་ལ་བྱིས་པ་རྣམས་ཀྱིས་ཀུན་ཏུ་བརྟགས་པའི་བདག་ནང་དང་ཕྱི་རོལ་དང་གཉི་ག་མེད་པར་ཡང་མི་དམིགས་པའོ།",
    "ཇི་ལྟར་གང་ཟག་ལ་བདག་མེད་པ་སྨོས་པར་བྱེད་ཅེ་ན།",
    "དངོས་པོ་གསུམ་པོ་མི་རྟག་པས་བསྡུས་པ་དེ་ཉིད་ལ་བྱིས་པས་ཀུན་བརྟགས་པ་ཐ་སྙད་ལས་བྱུང་བའི་ངོ་བོ་ཉིད་ནང་དང་ཕྱི་རོལ་དང་གཉི་ག་མ་གཏོགས་པར་མི་དམིགས་པའོ།",
    "མཚན་མ་ཐམས་ཅད་ལས་ཡང་དག་པར་འདས་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་སྤྱོད་ཡུལ་ལས་ཡང་དག་པར་འདས་པ་དང་།",
    "ཇི་ལྟར་སྒྲོ་འདོགས་པའི་མཐའ་སྨོས་པར་བྱེད་ཅེ་ན།",
    "དངོས་པོ་དེ་ཉིད་ལ་རྟག་པར་འཛིན་པས་སྒྲོ་འདོགས་པ་དང་།",
    "མི་རྟག་པར་འཛིན་པས་སྒྲོ་འདོགས་པ་དང་།",
    "རྟག་པར་འཛིན་པས་སྒྲོ་འདོགས་པ་ལ་བརྟེན་ནས་བདག་ཏུ་འཛིན་པས་སྒྲོ་འདོགས་པ་དང་།",
    "མི་རྟག་པར་འཛིན་པས་སྒྲོ་འདོགས་པ་ལ་བརྟེན་ནས་བདག་མེད་པར་འཛིན་པས་སྒྲོ་འདོགས་པ་དང་།",
    "མཚུངས་པར་ལྡན་པ་སྟེ།",
    "ཉེས་པར་སྤྱོད་པའི་ཀུན་ནས་སློང་བའི་ཉེས་པ་དང་།",
    "དེའི་གཉེན་པོ་རྣམ་པར་བྱང་བ་དག་ལ་ཡང་དག་པའི་སེམས་སུ་འཛིན་པས་སྒྲོ་འདོགས་པ་ལ་བརྟེན་ནས།",
    "གཞན་དག་ལ་ཡང་དག་པར་འཛིན་དུ་ཡང་མི་འཇུག་བསྔགས་པ་རྗོད་པར་ཡང་མི་བྱེད་དོ།",
    "ཇི་ལྟར་སྐུར་པ་འདེབས་པའི་མཐའ་སྨོས་པར་བྱེད་ཅེ་ན།",
    "འདུས་བྱས་དང་།",
    "འདུས་མ་བྱས་སུ་རྣམ་པར་གནས་པ་ལ་ངོ་བོ་ཉིད་མི་དམིགས་པ་ཡོངས་སུ་བསྟན་པ་དང་བྱེ་བྲག་མི་དམིགས་པ་ཡོངས་སུ་བསྟན་པ་དང་།",
    "དེ་གོམས་པར་བྱས་པས་ཤེས་པ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་རབ་ཏུ་རྟོགས་པ་ཡོངས་སུ་བསྟན་པས་སོ།",
    "ངོ་བོ་ཉིད་དེ་ཉིད་ལ་སྐྱེ་བ་དང་འགག་པ་ཡང་དག་པར་འགྲུབ་པ་གཉིས་སུ་མེད་པས་མི་དམིགས་པ་གང་ཡིན་པའོ།",
    "དེའི་ངོ་བོ་ཉིད་དང་དེའི་མཚན་མ་ཡིད་ལ་མི་བྱེད་ཅིང་ཡང་དག་པར་མི་སྣང་བའི་སྦྱོར་བས་སོ་སོ་རང་རིག་པ་དང་མཐུན་པའི་ཤེས་པ་རབ་ཏུ་རྟོགས་པ་གང་ཡིན་པའོ།",
    "སྨོན་པ་མེད་པ་ནི་སྲིད་པར་སྨོན་པའིའོ།",
    "སྡུག་བསྔལ་མེད་པར་ཡང་དག་པར་རྗེས་སུ་མཐོང་བའོ།",
    "ཇི་ལྟར་བྱེ་བྲག་སྨོས་པར་བྱེད་ཅེ་ན།",
    "སྤོང་བ་ལ་རྣམ་པར་འཁྲུལ་པའི་བྱེ་བྲག་ཡོངས་སུ་བསྟན་པ་དང་།",
    "དེ་ལ་སྤོང་བ་ལ་རྣམ་པར་འཁྲུལ་པའི་བྱེ་བྲག་ནི་འདི་ཡིན་ཏེ།",
    "དེ་ལ་སེམས་རྣམ་པར་འཁྲུལ་པའི་བྱེ་བྲག་ནི་འདི་ཡིན་ཏེ།",
    "ཇི་ལྟར་རྒྱུ་ཉིད་སྨོས་པར་བྱེད་ཅེ་ན།",
    "སྐད་ཅིག་མ་ཉིད་ཀྱིས་བཏང་བར་བྱ་བ་ཡིན་པར་སོ་སོར་རྟོག་པ་གང་ཡིན་པའོ།",
    "གཟུང་བ་དང་འཛིན་པ་ལ་ཡོངས་སུ་རྟོག་པར་བྱེད་པའི་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པ་དག་ཡིད་ལ་བྱས་པའི་རྒྱུས་སོ་སོ་རང་རིག་པ་དང་མཐུན་པའི་ཤེས་པ་ངེས་པ་སྐྱེས་པ་གང་ཡིན་པའོ།",
    "ཇི་ལྟར་མཐར་ཐུག་པའི་སྟོང་པ་ཉིད་སྨོས་པར་བྱེད་ཅེ་ན།",
    "ཇི་ལྟར་སྟོང་པ་ཉིད་དེ་ཉིད་ཀྱི་མཐུ་སྨོས་པར་བྱེད་ཅེ་ན།",
    "འདི་ལྟ་སྟེ་དཔེར་ན་རྒྱལ་པོའི་བུ་གནས་མཚུངས་པར་སྐྱེས་ཤིང་།",
    "རྒྱལ་པོའི་བདེ་བའི་ལོངས་སྤྱོད་ཀྱིས་མཚུངས་མཉམ་པར་གྱུར་པ་གཉིས་ཤིག་ཡོད་པ་ལས།"
  ]
}