    "རང་གིས་ལག་སྒྲོན་བཀར་ནས་རྟ་གསོད་སར་རྟོག་ཞིབ་བྱས།",
    "འཇབ་རྒོལ་བྱེད་སའི་ཕྱོགས་དེ་མཚེའུའི་འགྲམ་ཡིན་པ་མྱུར་མོར་ཤེས་སོང་།",
    "འདམ་རྫབ་ཀྱི་ཐོག་ཏུ་མཛུབ་མོ་གསུམ་ལྡན་གྱི་རྐང་རྗེས་ཆེན་པོ་གདུགས་དབྱིབས་ཅན་ཞིག་བཞག་འདུག་རྐང་རྗེས་རེའི་རིང་ཚད་ལ་སྤྱི་ཁྲུ་གཉིས་ཡས་མས་ཡོད་པར་མ་ཟད།",
    "གཡས་ན་གཅིག་དང་གཡོན་ན་གཅིག་བྱས་ཏེ་ཤར་མོར་བསྒྲིགས་ཡོད་པས།",
    "དེ་ནི་རྐང་པ་གཉིས་ལྡན་གྱི་སྲོག་ཆགས་ཀེག་གིས་འགྲོ་བ་ཞིག་གི་རྗེས་ཡིན་པ་ལྷང་རེད།",
    "སླར་བསད་པའི་རྟ་རོ་དུམ་བུ་དེ་ཁྱེར་ནས་མྱུར་མོར་ཕྱིར་བྲོས་པ་ཤ་སྟག་རེད།",
    "བདུད་འབྲུག་མཚོ་ནང་དུ་ངོ་མ་སྲོག་ཆགས་གདུག་ཅན་ཞིག་ཡོད་ཤ་སྟག་རེད།",
    "མཚོ་འབྲུག་གདུག་པ་དགུ་འཛོམས་ཀྱི་ཤ་གཟན་མཚོ་འབྲུག་ཁྲིན་ཞང་གི་ཡིད་ལ་འཆར་སྣང་དེ་ལྟ་བུ་ཞིག་གློག་འཁྱུག་པ་ལྟར་ཤར་འོངས།",
    "ཁྲིན་ཞང་གི་སེམས་ལ།",
    "གཉིད་ན་ཉེན་ཁའང་ཆེན་པོ་འབྱུང་ངེས་རེད།",
    "མཛུབ་མོ་མེ་མདའི་མ་ཤུབ་དང་མ་བྲལ་བར་མཚན་མོའི་ཐུན་དེ་ཡལ་བར་སྒུགའདུ་ཟིང་ཅན་གྱི་མཚན་མོ་དེ་གང་ལྟར་ཀྱང་ཕར་ལ་འདས་སོང་།",
    "ཞོགས་པའི་སྐྱ་རེངས་ཤར་བའི་དུས་དེར།",
    "ཁོ་གཉིས་སླར་ཡང་མཚེའུའི་འགྲམ་དུ་སོང་ནས་རྟོག་དཔྱོད་ཅིག་བྱས།",
    "ད་དུང་རྐང་རྗེས་གསལ་མི་གསལ་བ་ཤར་མོ་གཉིས་མཐོང་ཐུབ་ནའང་།",
    "ཁྲིན་ཞང་གིས་ཁོ་ཡིད་མཐུན་པར་བྱས།",
    "ད་གཟོད་རྟ་ལ་ཞོན་ནས་བུད་སོང་།",
    "རང་བྱུང་ཁམས་ཀྱིས་རང་ཉིད་ཀྱི་གསང་བ་དེ་ལས་སླ་མོར་ཕྱིར་མི་བརྟོལ་བའི་ངང་ཚུལ་ནི་ཁྲིན་ཞང་གིས་ཤེས་ཡོད།",
    "རང་ཉིད་ལ་དཔའ་སེམས་དང་ངང་སྒུག་གི་འདུན་པ་འདང་ཚིམས་པ་ཞིག་ཡོད་མེད་ལ་རག་ལས་པའང་ཁོས་ཤེས་ཡོད་པ་རེད།",
    "གཟན་འཚོལ་དུས་ད་གཟོད་མཚེའུའི་འགྲམ་དུ་འོང་གིན་ཡོད་པའང་ཁྲིན་ཞང་གིས་བརྡར་ཤ་གཅོད་ཐུབ།",
    "ཉིན་ཧྲིལ་པོ་དགུ་འགོར་སོང་།",
    "ཁོའི་ལུས་ཧྲིལ་པོར་སྐྲང་འབུར་དམར་པོས་གང་བར་བྱས་སོང་།",
    "མེ་ཡང་སྦར་འདོད་མེད་པས་ཉིན་གང་བོར་ཆུ་གྲང་མོ་རེ་དང་བག་ལེབ་སྐམ་པོ་རེ་ལ་བརྟེན་ནས་ལུས་ཤུགས་བསྲུངས་པ་རེད།",
    "དེ་ལྟར་དཀའ་བ་འདི་དག་ཐམས་ཅད་ཁྲིན་ཞང་གིས་མ་མགལ་སོ་བཅིང་གིས་བཟོད་བསྲན་བྱས།",
    "ཁྲིན་ཞང་གི་འབད་བརྩོན་གྱི་མྱུ་གུ་ལ་འབྲས་བུ་ཤར་བྱུང་།",
    "ཁྲིན་ཞང་གིས་དེ་རིང་ཡང་གྲུབ་འབྲས་ཅང་མི་འདུག་སྙམ་མོད།",
    "དེ་མ་ཐག་ཏུ་མཚེའུའི་ནང་ཡལ་སོང་།",
    "ཡང་ན་སྲོག་ཆགས་གདུག་པ་ཅན་དེ་ཕྱིར་བུད་པ་ཡིན།",
    "ཁྲིན་ཞང་གིས་ས་དབྱིབས་འོས་མོ་ཞིག་བདམས་ཏེ་བྲག་རྩའི་སའི་ཆགས་དབྱིབས་ལ་ཞིབ་ལྟ་བྱས་པ་ན།",
    "དེ་གར་ངོ་མ་བྲག་ཁུང་ཞིག་ཡོད་པ་ཤེས་སོང་།",
    "ཁུང་སྒོ་ནག་པོ་འདི་སུས་ཀྱང་མཐོང་ཁག་པོ་རེད།",
    "བྲག་ཁུང་དེའི་ནང་དུ་འཛུལ་བ་ལས་ཐབས་གཞན་ཅི་ཡང་མི་འདུག་མི་ཁེར་རྐྱང་ཞིག་མུན་ནག་གི་བྲག་ཁུང་དེའི་ནང་འཛུལ་ཏེ་སྲོག་ཆགས་གདུག་པ་ཅན་དེ་དང་འཕྲད་པ་ཡིན་ན།",
    "ཉེན་ཁ་ནི་དཔོག་མི་ཐུབ་པ་ཞིག་རེད།",
    "ཁྲིན་ཞང་གི་ཚེ་གང་བོར་ཐེ་ཚོམ་ཟོས་པ་ནི་ཐེངས་དང་པོ་རེད།",
    "ཁྲིན་ཞིང་གི་སེམས་ལ།",
    "འཛམ་བུ་གླིང་ན་དཀོན་པའི་ཚན་རིག་གི་གསང་བ་འདི་བརྟོལ་ཆེད།",
    "གང་ལྟར་ཀྱང་མི་ཞིག་བྲག་ཁུང་ནང་དུ་སོང་ནས་བརྩད་གཅོད་ཡག་བྱེད་དགོས་པས།",
    "ཐོག་མར་རང་ཉིད་སོང་ནས་ཚོད་ལྟ་ཞིག་བྱས་ན་དགའ།",
    "དེ་ནས་ཁྲིན་ཞང་གིས་སེམས་ཐག་རྦད་ཀྱིས་བཅད་པ་རེད།",
    "ཁོ་རང་སྔོན་གྱི་སྡོད་གནས་སུ་སོང་སྟེ།",
    "གལ་ཏེ་ཡེ་ཤེས་རྒྱ་མཚོ་ཁྱོད་ཀྱིས་ཡི་གེ་འདི་ཀློག་སྐབས་ཁྲིན་ཞང་ད་དུང་མ་ལོག་པ་ཡིན་ན།",
    "ཁྱོད་མྱུར་མོར་ཕྱིར་སོང་སྟེ།",
    "ཕྱིན་ཆད་གཞི་ཁྱོན་རྒྱ་ཆེ་བའི་རྟོག་ཞིབ་རུ་ཁག་ཡོང་དུས།",
    "ང་རང་ཁྱོད་ལ་ཞེ་རྩིས་ཤིན་ཏུ་ཆེ་ཞེས་པའི་ཡིག་འབྲུ་འགའ་མ་གཏོགས་མེད།",
    "ཁྲིན་ཞང་གིས་ཡི་གེ་དེ་འཁུར་ཁུག་ཅིག་གི་ཐོག་ཏུ་བཞག་པ་དང་རྡོ་ཞིག་གིས་མནན་རྗེས།",
    "པར་ལེན་སྤྱད་བཅས་ཁྱེར་ནས་བུད་སོང་།",
    "ས་དེ་ནས་འཁྲིལ་ཤིང་གི་ལྕུག་མ་ལ་འབྱར་ཏེ་ཐུར་དུ་དཔྱངས་ན།",
    "མཚན་མོ་གཟན་འཚོལ་དུ་འོང་བ་ཡིན་པས།",
    "ཁྲིན་ཞང་གི་སེམས་ལ་སྲོག་ཆགས་དེ་ད་ལྟ་གཉིད་ཡོད་ན་ཅི་མ་རུང་སྙམ་བྱུང་།",
    "གལ་ཏེ་ཁྲིན་ཞང་གིས་རྐང་འཇམ་ལག་འཇམ་བྱས་ན།",
    "དེ་ལ་ཁ་རོག་གིས་ལྟ་ཞིབ་བྱེད་ཐུབ་ན་ཐང་།",
    "ཁྲིན་ཞང་གི་སེམས་ལ་རང་གི་བྱ་སྤྱོད་དེར་གདེང་ཚོད་དེ་འདྲ་རང་མེད་པར་སྙམ།",
    "ཁྲིན་ཞང་ཆུང་ངུའི་དུས་ནས་བཟུང་དཀའ་བར་འཕྲད་ན་ཕྱི་བཤོལ་བྱེད་པ་ཞིག་མ་རེད།",
    "རང་གི་སེམས་བསམ་པའི་གཏིང་ན་དངངས་འཚུབ་ཇི་ལྟར་ཆེ་རུང་།",
    "ཁོས་དེ་དག་ལ་མ་བལྟས་པར་སེམས་བརྟན་པོའི་ངང་ནས་རང་གི་ཅ་ལག་རྣམས་ལ་ཞིབ་ལྟ་ཞིག་བྱས་པ་དང་།",
    "དེ་ནས་སེམས་ཆུང་སྒོས་བྲག་ཁའི་འཁྲིལ་ཤིང་གི་ལྕུག་མ་ལ་འབྱར་ཏེ་ཐུར་དུ་དཔྱངས་ནས་སོང་།",
    "བྲག་ངོས་གཟར་བོ་ཞིག་ཡིན་མོད།",
    "དེ་གར་ཁོས་ཐག་པ་སྡོང་བོ་ཞིག་གི་རྩ་ལ་བཏགས་ཏེ་ཐུར་དུ་བསྣར་ནས་སོང་མཐར།",
    "ཁུང་སྒོའི་ཕྱོགས་ཟུར་ཞིག་ཏུ་རྡོ་འབུར་ཞིག་ཡོད་པ་དེའི་སྟེང་དུ་རྐང་པ་སྤོ་ཐུབ་སོང་།",
    "ཁུང་མཐིལ་ནི་གྱེན་ལ་ཕྱོགས་པ་ཞིག་ཡིན་པས་སྤྱི་ཁྲུ་འགའི་ས་ལ་སོང་རྗེས་བརླན་གཤེར་ཅུང་ཟད་ཙམ་ཡང་མི་འདུག་བྲག་ཁུང་འདི་ཤིན་ཏུ་རྒྱ་ཆེ་བ་དང་།",
    "དེའི་ཡ་ཀླད་ནི་ས་ངོས་དང་སྤྱི་ཁྲུ་བཅུ་ལྷག་ཡོད་པ་རིག་ཁྲིན་ཞང་གིས་ཁུང་ངོའི་སྲུབས་ཀ་དེད་ནས་ནང་དུ་སོང་བ་ལ།",
    "ཡུན་རིང་མ་འགོར་བར་ཆུ་ཁར་བུད་པའི་ཁུང་མཐིལ་ལ་བསླེབས།",
    "ཁྲིན་ཞང་གིས་ས་དེ་ནས་ངལ་ཅུང་ཙམ་གསོས་རྗེས།",
    "མི་གཤིས་རླབས་པོ་ཆེ་དེ་དག་ལས་བྱུང་བའི་མཚར་སྡུག་གི་འོད་སྟོང་དེ།",
    "སྐབས་འདིར་མུན་ནག་གི་བྲག་ཁུང་ནང་དུ་སྤྲོས་ཏེ་སྣང་བར་བྱས་པ་དང་འདྲ།",
    "མཛའ་མཐུན་གྱི་ལག་པ་བགྲང་ལས་འདས་པ་ཞིག་གིས་རང་གི་རྒྱབ་ཕྱོགས་ན་གཡས་སྐྱོར་གཡོན་འདེགས་བྱེད་བཞིན་པའི་སྣང་བ་ཞིག་སྐྱེས་བྱུང་།",
    "ལུས་བརླིང་ཞིང་སེམས་ཀྱང་བརྟན་པོར་གྱུར་འདུག་བྲག་ཁུང་ནང་དུ་ཇི་ལྟར་སོང་ན།",
    "ཉི་འོད་ཀྱང་དེ་ལྟར་མོག་པོར་གྱུར།",
    "ཁྲིན་ཞང་གི་རྐང་ལག་སྔར་ལས་ཀྱང་ཇེ་དལ་ཇེ་འཇམ་དུ་སོང་བ་དང་།",
    "གོམ་པ་རེ་རེ་བཞིན་མྱུལ་ཞིང་སོང་།",
    "དབུགས་འབྱིན་རྡུབ་བྱེད་པའི་སྒྲ་ཡང་མོ་མ་ཐོས་ལ།",
    "མུན་ནག་གི་ཡོལ་བ་འདིའི་རྒྱབ་སྟེ།",
    "མིག་ཁྲ་ཆུང་གཉིས་ཀྱིས་ཁོ་ལ་ཅེ་རེར་བལྟས་ཡོད་པ་དང་།",
    "ཁོས་སེམས་ཆུང་བྱེད་རྒྱུ་བརྗེད་སོང་བ་དང་།",
    "འོད་ཀྱི་ཞགས་པ་དེ་ཕར་འཁྱུག་ཚུར་འཁྱུག་བྱེད་པའི་མོད་ལ།",
    "ཆེ་ཆུང་དང་དབྱིབས་གཟུགས་ནི་ས་འདེད་འཕྲུལ་འཁོར་དང་ཨ་ན་མ་ན་རེད།",
    "སྤྱི་གཙུག་ཏུ་རུས་ལེབ་ཤར་མོ་ཞིག་ཡོད་པ་དེ་ནི་རྭ་ཅོ་རེད།",
    "ལུས་ཡོངས་ལ་བརླན་ཚིར་གྱི་ཤུན་པགས་ཀྱིས་གཡོགས་འདུག་གཟུགས་གཞི་ཆེན་པོ་དེ་དང་ཆ་མི་མཐུན་པ་ནི་མིག་རེད།",
    "འདི་ནི་མཚོ་འབྲུག་ངོ་མ་ཞིག་དང་ཀླུ་བཙན་གསོན་པོ་ཞིག་རེད།",
    "མི་དང་གཅན་གཟན་འདི་གཉིས་ཀྱིས་གཅིག་ངོ་གཅིག་གིས་ཅེར་ཞིང་བསྡད།",
    "མི་ནི་ད་ལྟ་སའི་གོ་ལའི་བདག་པོ་རེད།",
    "ཐོག་མར་ཁྲིན་ཞང་གིས་རྐང་ལག་འགུལ་བ་ཡིན་ཏེ།",
    "ཡང་མོར་ཐག་སྒྲ་དང་བཅས་ཏེ་མནན་པའི་མོད་ལ།",
    "འོད་འཚེར་གློག་གི་ཞགས་ཟེར་དེས་མིག་མདངས་ཀྱང་འཕྲོགས་པ་དང་།",
    "ཁྲིན་ཞང་བྱིས་པའི་དུས་ཀྱི་རེ་བ་དེ་ད་ལྟ་མངོན་དུ་གྱུར་སོང་།",
    "ཁྲིན་ཞང་གིས་སྔར་བཞིན་མེ་མདའ་མ་བརྒྱབ།",
    "དེ་ནི་ཚན་རིག་ལ་ཞིབ་འཇུག་བྱེད་ཡུལ་དང་མིའི་རིགས་ཡོངས་ཀྱི་རྒྱུ་ནོར་ཡིན་པ་ཁྲིན་ཞང་གིས་ལོས་ཤེས།",
    "མཚོ་འབྲུག་གིས་ཚུར་རྒོལ་མ་བྱས་གོང་།",
    "ཕྱིས་སུ་ལག་སྒྲོན་གཟིམས་པ་དེ་ནི་ཁོང་རང་གི་སྲོག་ལ་ཉེན་པའི་ནོར་འཁྲུལ་ཞིག་ཡིན་པ་ཁྲིན་ཞང་གིས་ཤེས་སོང་།",
    "འདི་ནི་ངོ་མ་འཇིགས་སུ་རུང་བའི་རྡུང་རྡེག་ཅིག་རེད།",
    "ཁྲིན་ཞང་གི་ལུས་ལ་སྤྱི་རྒྱ་དྲུག་ཅུ་རེ་ལྔ་ཡོད་ན་ཡང་།",
    "མཚོ་འབྲུག་གི་མཆུ་ནི་ཁོའི་མདུན་དུ་བསྲིངས་པ་དང་།",
    "འོད་ཞགས་དཀར་པོ་གཉིས་ཀྱིས་མུན་ནག་གི་ཡོལ་བ་འཕྲེད་དུ་གཏུབས་ཏེ།",
    "གཟུགས་གཞི་ཆེ་ཞིང་མི་སྡུག་པའི་ཉམས་དང་ལྡན་པའི་མཚོ་འབྲུག་གི་མགོ་ལ་འཕྲོས།",
    "ཞེས་ཁོའི་རྨི་ལམ་དུ་ཡང་ཡང་འཁོར་མྱོང་བའི་སྐད་སྒྲ་ཆ་ཡོད་ཅིག་ཁྲིན་ཞང་གིས་ཐོས།",
    "སྐད་དེ་ནི་ཆིན་ཞའོ་ཝུན་གྱི་སྐད་གདངས་རེད།",
    "ཁྲིན་ཞང་གིས་མིག་ཟུང་ཆེ་རུ་ཅེར་ཏེ་བལྟས་ན་ཡང་།",
    "མཚོ་འབྲུག་གི་མགོས་ཁོའི་མཐོང་ལམ་བཀག་འདུག་སྐབས་འདིར།",
    "མཚོ་འབྲུག་གི་རྣམ་འགྱུར་ཡ་མཚན་ཅན་དེ་ཁོས་མཐོང་བྱུང་།",
    "དེས་སྔར་བཞིན་ཁ་ཆེ་རུ་གདངས་ཏེ་འཇིགས་རུང་གི་ཉམས་ཤིག་སྟོན་ཀྱིན་ཡོད་མོད།",
    "ལྷ་སྒྲུང་ནང་གི་འབྲུག་གདུག་པ་ཅན་སྔགས་མཐུའི་བྱིན་གྱིས་བརླབས་པ་དང་གཅིག་འདྲ་རེད།",
    "ལོ་མང་པོའི་རིང་ལ་བསགས་པའི་ཚན་རིག་གི་ཤེས་བྱ་དང་།",
    "ཁྲིན་ཞང་གིས་སྟོབས་ཤུགས་ཡོད་ཚད་ཕུད་ནས་དེ་ལྟར་ལབ་ན་ཡང་།",
    "རང་གི་སྣང་བ་ལ་སྐད་གདངས་ཧ་ཅང་དམའ་དྲགས་པ་དང་།",
    "ལག་སྒྲོན་དེ་ལ་གཏོད་ཅིག་འདི་ནི་ཡེ་ཤེས་རྒྱ་མཚོའི་སྐད་རེད།",
    "དེར་མཐུད་ནས་ཁྲིན་ཞང་གིས་རང་གི་གྲོགས་པོས་བློ་རྒྱ་བསྐྱེད་དེ་མཚོ་འབྲུག་གི་ལོགས་སུ་འཛུལ་ཏེ།",
    "སྟོབས་དང་ལྡན་པའི་ལག་པ་གཉིས་ཀྱིས་རང་ཉིད་པང་ནས་བྲག་ཁུང་གི་ཕྱི་རོལ་ཏུ་མྱུར་མོར་སོང་བ་ཤེས།",
    "ཁྲིན་ཞང་གིས་ཆིན་ཞའོ་ཝུན་ལ་སེམས་ཆུང་བྱེད་དགོས་ཞེས་གདམས་དགོས་བསམས་ཀྱང་།",
    "ཁོ་དྲན་མེད་དུ་བརྒྱལ་སོང་།",
    "དང་མ་སྡོད་སའི་མེ་ཕུང་གི་འཁྲིས་སུ་སླེབས་འདུག་ཤར་ཕྱོགས་སུ་ཞོགས་པའི་མཚམས་སྤྲིན་ལང་ལོང་དུ་བཀྲ་ཞིང་།",
    "སྨུག་པ་དཀར་པོ་མཚེའུའི་ངོས་ལས་དལ་མོར་ལངས་པ་ནི་སེང་རས་ཀྱི་ཡོལ་ཆེན་ཞིག་ཁ་ཕྱེས་པ་དང་འདྲ།",
    "ཡང་ཉིན་གསར་པ་ཞིག་གི་མགོ་བརྩམས་སོང་།",
    "ཁྲིན་ཞང་གིས་ཁ་ཕྱིར་འཁོར་ནས་བལྟས་པ་ན།",
    "ཆིན་ཞའོ་ཝུན་ད་དུང་རང་གི་གམ་དུ་ཙོག་པུར་བསྡད་ཡོད་པ་མཐོང་།",
    "ཁོ་མོའི་མིག་ཆེ་ཞིང་ནག་པ་དེ་ལ་སེམས་ཚེགས་དང་དོགས་པའི་རྣམ་པ་ཤར་བ་དང་།",
