    "སྤྲོ་སྣང་འཕེལ་བའི་དོན་དག་རྒྱུན་ལྡན་དང་མི་མཚུངས་པ་ཞིག་རེད།",
    "ཚན་རིག་པ་ཚོས་དེ་ཚོར་རྟོག་དཔྱོད་ཅུང་ཟད་ཞིབ་མོ་ཞིག་བྱས་རྗེས།",
    "སེམས་ཀྱི་སྤྲོ་སྣང་གནོན་མ་ཐུབ་པར་གཅིག་གི་ཚིག་རྔ་གཅིག་གིས་སྐྱོར་ནས་ལབ་གླེང་བྱེད་འགོ་བརྩམས།",
    "ཁྱོད་ཚོས་ལྟོས་དང་།",
    "མཐེ་བོང་གི་ནུས་པ་ཡང་ཆེན་པོ་འདུག་མཛུབ་མོ་གཞན་པ་བཞི་པོ་དང་བཀར་ཡོད་པས།",
    "འདི་ནི་སྤྲོ་མིའི་ལག་འགོ་མ་ཡིན་པར་མིའི་ལག་པ་དང་འདྲ་པོ་འདུག་རེད་ཡ།",
    "ན་ཁོ་ཚོའི་ལག་གི་གཞོག་བྱེད་ཀྱི་རྡོའི་ལག་ཆ་དེ་ཨེ་རིག་གི་དེ་ནི་གས་པའི་རྡོ་ལེབ་ཀྱིས་བཟོས་པ་རེད།",
    "འདི་ཡང་རྡོ་གས་མའི་ལག་ཆ་གཙོ་བོ་བྱེད་པ་ལས་རྡོ་བརྡར་མའི་ལག་ཆ་བཀོལ་བ་ཉུང་བ་དེ་རེད།",
    "ང་ཚོས་ད་ལྟ་མཐོང་བ་ནི་རང་བྱུང་ཁམས་ཀྱི་སྣང་ཚུལ་སྤྱིར་བཏང་བ་ཞིག་མ་ཡིན་ཏེ།",
    "མར་ཁེ་སི་རིང་ལུགས་ཀྱི་གཞུང་ལུགས་ཀྱི་རྒྱལ་ཁ་རེད།",
    "མིའི་རིགས་ནི་སྤུ་ལས་མཆེད་པའི་ལྟ་བ་དེ་མངོན་གསལ་དུ་བཏོན་པའི་ཚུན་གྱི་དུས་རབས་གཅིག་ལྷག་གི་རིང་ལ།",
    "ཉེ་ལམ་ལོ་བཅུ་ལྷག་གི་རིང་ལ་གནའ་བོའི་མིའི་རིགས་ཀྱི་འགྱུར་རྡོ་རྙེད་པའང་ཉིན་རེ་བཞིན་ཇེ་མང་དུ་སོང་བ་དང་།",
    "ཞིབ་འཇུག་ཀྱང་དེ་བཞིན་གཏིང་ཇེ་ཟབ་ཏུ་སོང་ཡོད་མོད།",
    "ང་ཚོར་ཡོད་པའི་དཔྱད་གཞིའི་རྒྱུ་ཆ་དེ་དག་ནི་ད་དུང་ཧ་ཅང་ཉུང་ཉུང་ཞིག་རེད།",
    "ད་ལྟ་ང་ཚོའི་མདུན་དུ་སྤྲ་མི་གསོན་པོ་ཁྱུ་གཅིག་ཡོད་པ་འདིས་སྤྲ་དང་མིའི་བར་གྱི་འབྲེལ་བ་དང་།",
    "ལོ་ངོ་ས་ཡ་གཅིག་གི་སྔོན་ལ་བྱུང་བའི་གནས་ཚུལ་གསོན་ཉམས་དང་ལྡན་པ་དེ་རྣམས་ཇི་མ་ཇི་བཞིན་དུ་ང་ཚོའི་མིག་ལམ་དུ་བཤམས་ཡོད་པས།",
    "ང་ཚོ་ཚང་མ་དགའ་བ་དང་སྤྲོ་བའི་རླབས་རྒྱུན་གྱིས་བསྣུབས་པར་གྱུར།",
    "ང་ཚོས་ཀྱང་དགའ་བའི་ང་རོ་སྒྲོག་འདོད་པ་ནི་སྨོས་ཅི་དགོས།",
    "ང་ཚོས་ལབ་གླེང་བྱེད་པའི་སྐབས་དེར།",
    "སྤུ་མི་ཚོས་འབྲུ་རིགས་དང་སྐམ་ཤ་རྣམས་ཁུར་ནས་རིམ་གྱིས་ནགས་ཚལ་སྡུག་པོའི་ནང་དུ་ཡལ་སོང་།",
    "རང་བྱུང་ཁམས་ཀྱི་བུ་དང་བུ་མོ་གཞུང་རྒྱུད་དྲང་བ་དེ་ཚོས་འབྲུ་རིགས་དང་སྐམ་ཤའི་ཁྲོད་དུ་ང་ཚོས་སྐུད་མེད་གློག་འཕྲིན་གཏོང་བྱེད་འཕྲུལ་འཁོར་ཕྲ་མོ་བཞག་ཡོད་པ་ག་ལ་ཤེས།",
    "གློག་གི་རྦ་རླབས་དང་བསྟུན་ནས་ཁོ་ཚོ་ཡིབ་སའི་ཚང་གང་ལ་ཡོད་པ་ཤེས་རྒྱུ་ནི་ལས་སླ་མོ་ཞིག་རེད།",
    "རྗེས་སོར་ང་ཚོས་དེ་མཚུངས་ཀྱི་ཐབས་ལ་བརྟེན་ནས་སྤྲ་མིའི་ཚོ་བ་ལྷག་མ་རྣམས་ཇི་ལྟར་འཚོལ་རྒྱུ་དང་།",
    "སྤུ་མི་དེ་ཚོ་རང་མོས་བག་ཕེབས་ཀྱིས་བདེ་སྐྱིད་འཚོ་བ་ལ་རོལ་བར་འཇུག་པ་དང་མཉམ་དུ།",
    "ང་ཚོར་ཡང་ཚན་རིག་གི་དཔྱད་གཞི་རྩ་ཆེན་གང་མང་ཐོབ་པར་བརྟེན།",
    "མཚོ་འབྲུག་གི་རྗེས་སྙེག་མཁན།",
    "གཡང་གཟར་མོ་ཞིག་གི་ཐོག་ཏུ་སྐྱ་མི་གཉིས་གཤིབས་ནས་འགྲེང་འདུག་མི་རྟའི་གྲིབ་མ་ནག་ཡོར་རེ་བ་དེ།",
    "བལྟས་ཚོད་ཀྱིས་དེ་ནི་རྣོ་རྡོ་རྗེ་ཕ་ལམ་གྱི་མཐའ་ལ་ཤན་པའི་དངུལ་གྱི་རྒྱན་ཆ་ཞིག་དང་ཨ་ན་མ་ན་རེད།",
    "ཇ་སྡོང་སེར་པོ་ལ་སོགས་པའི་ལྗོན་ཤིང་གི་ནགས་ཚལ་སྐྱེས་ཡོད་ལ།",
    "ཚོན་སྣ་དམར་སེར་སྔོ་ནག་གིས་བྲིས་པའི་རི་མོ་ཞིག་དང་མཚུངས།",
    "རི་སྐེད་དུ་ཐང་ཤིང་གི་སྡོང་བོ་གྲལ་འགྲིག་པོ་དག་སྐྱེས་ཡོད་པ་དེ་རྣམས་ཀྱི་རྩེ་མོ་དགུང་ལ་བསྙེགས་ཏེ་གདུགས་ཕུབ་པ་དང་འདྲ་ཞིང་།",
    "ཡེ་ཤེས་རྒྱ་མཚོས་གདངས་དམའ་མོའི་ངང་དེ་ལྟར་བཤད།",
    "ཁྲིན་ཞང་གིས་རྒྱ་སྐད་ཀྱིས་འོར་བཟླས་ཤིག་བྱས།",
    "འདི་ནི་བདུད་འབྲུག་མཚོ་ཟེར་བ་དེ་རེད།",
    "ཉིན་ཉི་ཤུའི་རིང་གི་དཀའ་སྤྱད་ཀྱི་ལམ་ཐག་བརྒྱུད་མཐར།",
    "གནའ་སྔ་མོའི་དུས་སུ།",
    "འཕགས་པ་སྤྱན་རས་གཟིགས་ཀྱིས་འབྲུག་གདུག་པ་ཅན་དེ་མཚེའུ་འདིའི་ནང་དུ་དམ་ལ་བཏགས་ཤིང་།",
    "འོན་ཀྱང་རྒྱང་གྲགས་སུམ་ཅུའི་ཕྱི་རོལ་ཏུ་སོང་མི་ཆོག་ཅེས་གྲོས་ཐག་བཅད།",
    "བདེན་རྫུན་གྱི་ངེས་པ་ཇི་ལྟ་བུ་ཡོད་པ་ནི་དཔོག་ཐབས་བྲལ་བ་ཞིག་རེད།",
    "གང་ལྟར་ཀྱང་བོད་རིགས་དམངས་ཁྲོད་དུ་མི་རབས་རེ་རེ་བཞིན་བརྒྱུད་པ་རེད།",
    "དུས་རབས་ཇི་འདྲ་མང་པོ་ཞིག་གི་རིང་ལ།",
    "པུས་མོའི་ཚིགས་ལ་སླེབས་པའི་རྒོད་སྐྱེས་རྩྭ་སྔོན་གྱིས་མཚེའུ་འདི་ཡོངས་སུ་བསྐོར་བ་རེད།",
    "མཚེའུ་འདིས་ཞོགས་པའི་མཚམས་སྤྲིན་ཇི་འདྲ་མང་པོ་ཞིག་གི་མདུན་བསུས་པ་དང་།",
    "དགོང་ཁའི་ཉི་མ་ཇི་འདྲ་མང་པོ་ཞིག་ཕར་ལ་བསྐྱལ་ཏེ་བགྲང་གིས་མི་ལང་བའི་དུས་རབས་མང་པོ་ཞིག་འདས་ན་ཡང་།",
    "དེ་དག་གི་སྐབས་སུའང་མཚོ་མོའི་གཉིད་ཀྱི་བདེ་བ་དཀྲུགས་པའི་གང་ཟག་སུ་ཡང་མ་བྱུང་ལ།",
    "ཁྲིན་ཞང་ནི་ས་གཤིས་རྟོག་པའི་རུ་ཁག་ཅིག་གི་རྗེས་འབྲངས་ཏེ་བོད་ལྗོངས་ལྷོ་ཕྱོགས་སུ་རྟོག་དཔྱོད་ཀྱི་ལས་ལ་བྲེལ་ཞིང་མཆིས།",
    "བདུད་འབྲུག་མཚོ་མོའི་ངག་རྒྱུན་དེ་ཁོའི་སྙན་ལམ་དུ་གསན་རྗེས།",
    "རང་གི་གྲོགས་པོའམ་ས་གཤིས་རུ་ཁག་གི་ལམ་ཁྲིད་པ་ཡེ་ཤེས་རྒྱ་མཚོ་གདན་དྲངས་ཏེ་ལྷན་དུ་བདུད་འབྲུག་མཚོ་ཁར་ཡོང་བ་རེད།",
    "གདོད་མའི་ནགས་ཚལ་གྱི་ཁྲོད་དུ་སྟ་རེ་ཐོགས་ཏེ་ལམ་ཕྲན་ཞིག་གཤགས་པ་ན།",
    "ཁྲིན་ཞང་ནི་མཐོ་སྒང་རི་སྟོང་གི་འཚོ་བ་ལ་གོམས་ཟིན་པ་ཞིག་ཡིན་མོད།",
