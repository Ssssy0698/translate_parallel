    "ལའི་རྒྱབ་ལ་བེ་རོ་ཙ་ནའི་སྒྲུབ་ཆུ་ཡོད།",
    "དེའི་ལམ་ལྟག་ལ་གཤིན་རྗེ་འཇིགས་པའི་སྐུ་གདུང་རང་བྱོན་དང་།",
    "གཞན་ཡང་རང་བྱོན་སྣ་ཚོགས་ཡོད།",
    "ཆུའི་ཕུགས་ལ་བེ་རོ་ཙ་ནའི་སྒྲུབ་ཕུག་ཚེ་ཆུ་དང་གཏེར་ལེན་པའི་རྟགས་སྣ་ཚོགས་དང་།",
    "ལམ་ཕ་ཁར་བེ་རོ་ཙ་ནའི་སྒྲུབ་ཕུག་དང་།",
    "མ་ཎི་དུང་གཅིག་ལོ་གསུམ་མཚམས་འདུག་ནས།",
    "གནས་ཆེན་རྩ་རི་འདྲ་འདུག།",
    "སྐྱེས་བུ་མང་པོའི་མཇལ་འདུག།",
    "བདག་མཉམ་བཞག་ཅུང་ཟད་འདུག་པའི་དུས།",
    "ང་རྣལ་འབྱོར་ས་གཞིའི་སྟེང་དུ་འདུག་ཁོང་ཌཱཀྐི་རྣམ་གཉིས་དབྱིངས་སུ་འཕྱོ།",
    "ཁྱེད་གཉིས་ལས་མཚར་བའི་མི་མི་འདུག།",
    "ང་རང་སེམས་ཡངས་པ་མཁའ་སྤྱོད་ཞིང་།",
    "ང་རང་དེར་འབྲལ་མེད་འོང་གསུངས་སོ།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ནའི་ཞབས་རྗེས་དང་",
    "བེ་རོ་ཙ་ན་ནམ་མཁར་བྱ་ལྟར་ལྡིང་།",
    "ཡེ་རྒྱལ་མཐའ་བསྐོར་རྒྱས་པ་བྱས་ཙ་ན།",
    "གནས་ཁྲིད་བྱེད་ཅིང་རང་བྱོན་གྱི་རྟེན་དེ་དག་གཞན་ལ་བསྟན་ན་གསུང་དབྱངས་ཡན་ལག་དྲུག་ཅུ་ཐོབ་ཅིང་།",
    "རྣམ་སྣང་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན།",
    "ལུང་པའི་ཕར་ཚུར་དུ་ཨ་ཡིག་ཕྱེད་ཕྱེད་དུ་གནས་པར་གདའ།",
    "རྣམ་སྣང་ལོ་ཙཱ་བེ་རོ་ཙ་ན།",
    "བྱ་བྱེའུ་རི་དྭགས་སོགས་ཀྱི་ཉན་ཏེ་མདུན་དུ་འདུག་པས་གནས་དེར་འགུར་ཐོག་ཞེས་མིང་ཐོག་པ།",
    "སྤྱིར་ཀུན་དགའ་རྡོ་རྗེས་ཡི་གེར་བཏབ་པའི་རྒྱའི་ཡིག་ཚང་དེ་ལ་ཡིག་ནོར་མང་དུ་བྱུང་འདུག་སྟེ།",
    "ད་སྔ་དེ་གཉིས་མ་གཏོགས་སུ་ཡང་སླེབས་མྱོང་བའི་གཏམ་ཙམ་ཡང་མི་འདུག་གོ།",
    "དེར་སློབ་དཔོན་པདྨས་སྤྲུལ་བ་བཀྱེས་ནས་ཐོག་མར་གནས་སྒོ་ཕྱེ་ཞིང་ཨུ་རྒྱན་གྱི་སྒྲུབ་ཕུག་ཏུ་ཌཱ་མ་རུ་དང་རྐང་གླིང་རང་བྱོན།",
    "བླ་བྲང་གོང་འགབ་གཉིས་ཡོད་པ་ལས་བླ་བྲང་རྙིང་བར་སྔོན་གྱི་ཐེབ་ཆགས་ཙམ་ལས་ད་སྔ་རྟེན་བཞེངས་སོགས་ཅི་ཡང་མ་མཛད་འདུག་ལ།",
    "བཞི་བ་སྤྱན་གཟེངས་པ་ཞེས་བྲིས་འདུག་པ་དེ་ལ་ཡང་བརྟག་རྒྱུ་ཡོད་དོ།",
    "བྱིས་པ་རྒྱུན་དུ་ངུ་ཞིང་སུ་ཡིན་གྱི་པང་ནས་མི་ཉལ་བར་ཅོག་ཙེ་ཁར་འདུག་པ་སོགས་འཛིན་མ་བདེ་བ་བྱུང་།",
    "འདི་དག་དུས་ཀྱི་མཐར་ཡང་བསྔགས་པའི་ཕུལ།",
    "ཧཱུཾ་མཚོ་སྐྱེས་རྡོ་རྗེ་བེ་རོ་ཙ་ན་དང་།",
    "ཕྱོགས་མཚོན་ཙམ་དང་སླར་དཔྱད་ཀྱི་སྐུལ་མ་ལས་ཁ་ཚོན་བཅད་མི་འདུག་ལ།",
    "ལོ་རྡོ་རྗེ་བྲག་ཏུ་རྣལ་འབྱོར་ལ་བརྩོན་པར་བཞུགས་ཙ་ན།",
    "གཅིག་ལ་གདའ་ཞེས་པ་ལྟར།",
    "སྣང་བ་མཐའ་ཡས་སྐུ་ཡང་རང་བྱུང་བཞུགས",
    "གཞན་ཡང་རང་བྱུང་རྟེན་མཆོག་བསམ་མི་ཁྱབ",
    "དད་པ་ཡོད་ཀྱང་རང་བྱོན་རྣམས་བཀོག་ནས་མ་ཁྱེར།",
    "ས་ངན་ཕྱོགས་སུ་ཀློང་གསལ་གཏེར་གནས་སྤོ་ནེ་བྲག་དཀར་ཟེར་བ་ཞིག་ཀྱང་ཡོད་པར་འདུག་གོ།",
    "བསྒྲུབས་ན་རང་རང་དངོས་གྲུབ་འགྲུབ",
    "དཀྱིལ་འཁོར་དགུ་ཀློང་རང་བྱོན་བྱུང་",
    "བྱ་རོག་གདོང་རང་བྱོན་གྱི་མདུན་དུ་གཏོར་ཚོགས་འབུལ་ཞིང་ཕྲིན་ལས་བཅོལ།",
    "གང་ཞིག་དུས་རྣམས་ཨེཀུན་དུ་ཧི་ཊ་ཊ་ཞེས་བཞད་པའི་སྒྲ་ཡིས་ཤིན་ཏུ་འཇིགས་མཛད་ཅིང་།",
    "ཧ་ཧ་ཊ་ཊ་ཞེས་བཞད་སྒྲ་ཡིས་ཅིགང་ཞིག་དུས་ཀུན་དུ་ནི་ཤིན་ཏུ་འཇིགས་མཛད་ཅིང་མི།",
    "མ་ཧཱ་གོ་རོ་ཙ་ན་ཁཱ་ཧིའི།",
    "ད་བར་སུས་ཀྱང་དཔེ་སྐྲུན་མ་ཐུབ་པར་རིམ་འགྱངས་སུ་ལུས་འདུག་པར་བརྟེན།",
    "ནམ་མཁའ་མིག་དུས་གཟུགས་ཀྱི་ཡུལ་གྲུ་ན།",
    "རྣམ་ཀུན་མཆོག་ལྡན་ཟུང་འཇུག་དུས་འཁོར་ལོའི།",
    "ཟུང་འཇུག་དུས་ཀྱི་འཁོར་ལོ་ཐོབ་བྱའི་གཙོ།",
    "རང་རང་ཉམས་ཀྱིས་མངོན་སུམ་ཇི་བཞིན་སྟོན།",
    "དུས་རིམ་ཆེ་ཆུང་སོགས་ལ་མཁོ་བའི་ཉེར་དཔྱད་གྲྭ་ཚང་རང་དུ་རྩིས་སྤྲད་པའི་དེབ་ཀྱི་མཆོད་བརྗོད་འཛད་མེད་འདོད་རྒུའི་ཆར་ཆེན།",
    "བེ་རོ་ཙ་ནའི་ཕྱག་དཔེའི་ཆ་ཤས།",
    "དབེན་ཞིང་ཉམས་དགའ་བའི་སྒྲུབ་པའི་བསྟི་གནས་ཡིན་པས་དོན་མེད་འཇིག་རྟེན་གྱི་རྣམ་གཡེང་ཟར་ཟིར་མང་པོ་དང་ཚེ་འདི་དོན་དུ་གཉེར་བའི་སྐྱེ་བོ་མང་པོའི་འདུ་ཚོགས་ལ་དགོས་པ་མི་འདུག་ཀྱང་།",
    "ནོར་བཟང་སླར་ཡང་རང་ཡུལ་སླེབས།",
    "མ་གནོད་འོན་ཀྱང་རང་ལུས་བྱིན།",
    "རང་རང་སྐབས་དང་སྦྱར་བའི་འདོད་གསོལ་ཅན།",
    "རྣམ་འདྲེན་འཕྲིན་ལས་རྒྱུན་འཇུག་དུས་༡༦༩ན་བབས་པ།",
    "ཡལ་འདབ་སུམ་ཅུ་རྩ་དྲུག་པའི་རྒྱ་སྐད་ཙ་ཏུ་ར་སོགས་རྐང་པ་གཅིག་བོད་སྐད་དུ་མ་བསྒྱུར་འདུག་བ།",
    "ཞེས་སོགས་བློ་ཀ་གཉིས་ལ་སྐད་ཤན་སྦྱར་ཡོད་པའི་གླེགས་བམ་རྣམས་སྒོ་མཐུན་པར་རྒྱ་སྐད་མི་འདུག་པས།",
    "པན་སྦི་སོགས་ཚིག་རྐང་གཉིས་ཀྱི་སྐད་དོད་འདུག་པ་སྐད་ཤན་སྦྱར་ཡོད་པའི་གླེགས་བམ་ཚོར་བོད་སྐད་དུ་མ་བསྒྱུར་བར་ས་སྟོང་བཞག་འདུག་ཅིང་།",
    "ཐམས་ཅད་མཁྱེན་པ་བཙོང་ཁ་པ་ཆེན་པོའི་ཕྱག་དཔེ་སྐད་ཤན་སྦྱར་མེད་པ་དེར་ཡང་ཚིག་རྐང་གཉིས་པོ་དེ་མི་འདུག་པས།",
    "འབྲས་བཟང་རོ་བརྒྱ་གདའ་བའི་གཡང་ཆགས་པའི།",
    "རང་བདེ་ཁོ་ནའི་ཆེད་མིན་འགྲོ་ཀུན་དོན།",
    "རྩོད་པའི་ཡི་གེ་རྣམས་པར་དུ་འཁོད་འདུག་ནའང་།",
    "རྣམ་རྒྱལ་ཚེ་རིང་རང་ལོ་ཞེ་གཉིས་ཐོག།",
    "བེ་རོ་ཙ་ན་རྣམས་ཀྱི་འབུར་སྐུ་གསར་བསྐྲུན།",
    "རྒྱབ་ཏུ་གཤིས་གས་ཡོད་འདུག་པར་མེ་སྤྲེ་ལོ་མཇལ་བར་མི་གནོད་པའི་དངུལ་སྲང་བཞི་བཅུའི་ཐུམས་ཕུལ།",
    "རང་བདེར་གཞོལ་མིན་འགྲོ་ཀུན་ལ་བསྔོས་དགེའི།",
    "འཛམ་གླིང་མང་པོས་བཀུར་བའི་རྒྱལ་ཁབ་ཆེན་པོའི་ཁྲིར་འདུགས་པའི་འཇམ་དབྱངས་གོང་མ་རྒྱལ་པོའི་བཀའ་ལན་དང་ཞུ་མཆིད་འབུལ་སྐབས་སྙན་ངག་དང་འབྲེལ་བའི་ཚིག་བཅད་མི་བྱེད་ཚེ་ཚིག་སྦྱོར་ལྷུག་པ་འདི་བཞིན་དང་འབེབས་མཛུབ་གང་འོག་ཏུ་ནོན་པའི་ཞུ་བ་ནས་བརྩམས་ཏེ་བརྗོད་བྱ་གང་ལེགས་མཇུག་ཏུ་ཕུལ་བའི་ཞུ་ཡིག་ཅེས་པ་ཅུང་ཟད་འབེབས།",
    "གདན་སའི་ཞལ་ངོ་དགུང་ལོ་བཅུ་གསུམ་ཅན་ཁྲི་ཐོག་ཏུ་ཕེབས་སྲོལ་མི་འདུག་པས་དེ་རིགས་ལ་འབབ་སྒང་སོར་བཞི་གཞན་མ་གོང་དང་འདྲ།",
    "ཡང་ཟུར་གཉིས་ལ་དྲུང་པ་ཟེར་གྱི་འདུག་ཅིང་།",
    "སྔོན་གྱི་ལ་དགས་རྒྱལ་པོ་ཁུངས་བཙུན་རྣམས་ལ་འདི་བཞིན་མཛད་སྲོལ་འདུག་ཀྱང་།",
    "ཡང་ན་རྔ་གཟར་གཡོགས་པའང་ཡོད་འདུག་ཅིང་གལ་ཆེ་སྐབས་དིང་དཔོན་གཡོག།",
    "ཆ་ཙེའི་འོག་ཏུ་གྲུམ་ཙེ་སེར་པོ་འཇག་མ་བརྒྱག་པ་སྔ་དུས་ཀྱི་སྲོལ་ལ་འདུག་ཅིང་བབས་ཆགས་པ་ཙམ་ཡོང་།",
    "འདི་ལས་གདན་འདིང་དགོས་མི་དགོས་ཀྱི་སྐབས་དབྱེ་གོང་སྣེའུ་སྡོང་པའི་མཚན་དོན་ཡར་འགྲོའི་དུས་བཞིའི་སྲོལ་མེད་འདུག།",
    "ནང་སོ་རྣམ་པ་ལ་ངོ་ཐོག་དྲག་ཞན་རྩི་སྲོལ་འདུག་པ་བཞིན་བྱེད།",
    "ཨོ་རོད་སེ་ཆེན་རྒྱལ་པོ་སོགས་རྒྱལ་སར་མངའ་གསོལ་ངེས་ཀྱི་རིགས་ལ་འདིང་ཞིང་རང་ཉིད་ཁལ་ཁ་ཨོ་རོད་ལས་ཅུང་ཟད་མཐོ་བ་བྱེད།",
    "དཔྱད་དོན་ལྟར་ན་དཀར་ཡོལ་ལེགས་ཉེས་ལ་ད་དུང་དཔྱད་རྒྱུ་འདུག།",
    "ད་ལྟར་གྱི་ཕུང་པོ་དང་རང་བཞིན་གཅིག་ཏུ་ཡང་མ་གྲུབ།",
    "ད་ལྟར་གྱི་ཕུང་པོ་དང་རང་བཞིན་གཅིག་ཏུ་མ་གྲུབ་སྟེ།",
    "དེ་ཡང་རང་ཉིད་ཀྱིས་ཇི་ལྟར་གཏན་ལ་ཕབ་པ་ལྟར།",
    "དོན་དམ་པར་མེད་དོ་ཞེས་ཁྱེད་རང་ཡང་ཁས་ལེན་པའི་ཕྱིར།",
    "རྟགས་མ་གྲུབ་ན་མེད་དགག་ཐམས་ཅད་དངོས་མེད་དུ་ཁྱེད་རང་འདོད་པ་དང་འགལ་ཞིང་།",
    "འབྲེལ་པ་དངོས་པོ་བ་མི་སྲིད་པར་ཁྱེད་རང་ཡང་འདོད་ཅིང་།",
    "ཚུལ་འདི་ནི་ཁྱེད་རང་ལ་ཡང་མཚུངས་ཏེ།",
    "ཁོ་རང་ལ་ཡོད་པའི་ཡན་ལག་རྣམས་དང་རྫས་གཅིག་གམ་ཐ་དད།",
    "ཁོ་རང་ལ་ཡོད་པའི་སྐད་ཅིག་སྔ་ཕྱི་རྣམས་དང་རྫས་གཅིག་གམ་ཐ་དད་ཅེས་བརྟགས་ན་གོང་དང་མཚུངས་སོ་ཞེས་སྨྲ་ཞིང་།",
    "དེ་དང་རང་མཚན་ཡིན་པ་མི་འགལ་ཏེ།",
    "སྤྱི་དང་རགས་པ་དང་རྒྱུན་ཡིན་ན་རྫས་སུ་གྲུབ་དང་རང་མཚན་སོགས་ཡིན་པར་མི་འགལ་ཞིང་།",
    "ཕྱི་རོལ་དོན་དུ་མེད་ཀྱང་རང་ལ་ཕྱི་རོལ་དོན་དུ་སྣང་བའི་སྣང་བ་དེ་ཉིད།",
    "ཁོ་ཡང་རང་བཞིན་འདྲེས་འཛིན་གྱི་བློ་ཡིན་པའི་ཕྱིར།",
    "བརྡ་དུས་ཀྱི་སྒྲ་དོན་དེ་ཐ་སྙད་ཀྱི་དུས་ཀྱི་སྒྲ་དོན་དང་རང་མཚན་གང་ལ་ཡང་རྗེས་འགྲོ་མི་བྱེད་པའི་ཕྱིར།",
    "ཞེས་སོགས་ཀྱིས་ཀྱང་རང་མཚན་བརྡའི་ཡུལ་དུ་དོན་དམ་པར་གྲུབ་པ་འགོག་པ་ཡིན་ཞིང་།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "ཞེས་སོགས་ཀྱིས་དོན་དམ་བདེན་པ་དང་རང་མཚན་གཉིས་ཀྱི་མཚན་ཉིད་བསྟན་པ་ཡིན་ཞེས་འདོད་པས་ནི།",
    "ཡུལ་ཅན་ནི་རྟོག་པ་དང་རང་རིག་ཁོ་ན་ཡིན་ཞིང་།",
    "དེའི་ཚེ་རྟག་པ་དང་རང་མཚན་གྱི་ཚོགས་པ་དགག་གཞི་རང་མཚན་གྱི་སྟེང་དུ་འགོག་གོ་ཞེ་ན།",
    "ཞེས་པའི་སྐྱོན་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "ངེས་ཤེས་ཡིན་ན་རྟོག་པ་ཡིན་པར་ཁྱེད་རང་འདོད་པ་དང་འགལ་ཞིང་རིགས་པས་ཀྱང་གནོད་དོ།",
    "འཇུག་པར་བྱ་བའི་ཡུལ་ཡང་རང་རྒྱུད་ལྡན་གྱི་གང་ཟག་དེ་འཇུག་པར་བྱ་བའི་ཕྱིར།",
    "རང་རང་ལས་སྔ་རོལ་ཏུ་བྱུང་བ་ཡིན་ལ།",
    "ཁྱེད་རང་གཟུགས་མེད་ཁམས་ནས་ཤི་འཕོས་ནས་འདོད་ཁམས་སུ་སྐྱེ་བའི་བར་སྲིད་ཀྱི་ལུས་སྐད་ཅིག་དང་པོའི་ཉེར་ལེན་ཇི་ལྟར་སྣང་ཞེ་ན།",
    "དེ་གསུམ་སྔོན་འཛིན་མིག་ཤེས་དང་རྫས་གཅིག་དུས་མཉམ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡུལ་གང་རང་འཛིན་གྱི་ཤེས་པ་གང་དང་རྫས་གཞན་མ་ཡིན་པར་མ་གྲུབ་ན།",
    "དེའི་འཁོར་གྱི་སེམས་བྱུང་རྣམས་ཀྱང་རང་རིག་མངོན་སུམ་གྱིས་མྱོང་བས་ཁྱབ་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་རིག་མངོན་སུམ་མ་ཡིན་ནོ་ཞེས་ཟེར་ཏོ།",
    "གཞན་ཡང་རང་རིག་རྫས་གྲུབ་ཏུ་ཁས་བླངས་ནས།",
    "ཚུལ་གཉིས་པས་ཀྱང་རང་རིག་གྲུབ།",
    "གཟུང་རྣམ་མེད་པར་ཁས་ལེན་པ་དང་རང་རིག་ཡོད་པར་ཁས་ལེན་པ་ལ་འའགལ་མེད་པར་འགྱུར་ཞིང་།",
    "ཟག་བཅས་ཀྱི་དངོས་པོ་གང་རང་འབྲས་སྡུག་བསྔལ་གྱི་རྒྱུར་གྱུར་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་དཔྱད་པ་ན་ཕུང་པོ་དང་རང་བཞིན་གཅིག་ཐ་དད་གང་དུ་ཡང་མ་གྲུབ་པ་ལ་སོགས་པའི་རིགས་པས།",
    "ཚོགས་རྒྱུན་གང་ལ་ཡང་བཏགས་པ་ཙམ་མ་ཡིན་པར་ཕུང་པོ་དང་མཚན་ཉིད་མི་མཐུན་པའི་རང་སྐྱ་ཐུབ་པའི་རྫས་ཡོད་དུ་གྱུར་པའི་གང་ཟག་ཀྱང་ཕུང་པོ་དང་རང་བཞིན་གཅིག་ཐ་དད་གང་དུ་ཡང་མེད་དོ་ཞེས་པ་རང་བཞིན་མ་དམིགས་པའོ།",
    "དེ་ཡང་རང་བཞིན་གཅིག་ཏུ་མ་གྲུབ་པར་སྒྲུབ་པ་ནི།",
    "དེ་ལ་ཡང་རང་རྒྱུད་ཀྱིས་བསྡུས་པ་དང་།",
    "ཤེས་པ་རྣམ་བཅས་དང་རང་རིག་དང་བཅས་པར་གྲུབ་ཀྱང་།",
    "ཁྱེད་རང་ཕྱི་རོལ་དོན་དུ་འདོད་པའི་སྔོ་སོགས་གཞལ་བྱར་བྱས་པ་ལ་ཡང་།",
    "ཁྱེད་རང་ཡང་འདོད་པའི་ཕྱིར་རོ།",
    "མི་རྟག་པ་ཁྱེད་རང་ལ་ཡང་མཐུན་ཕྱོགས་སུ་ཁས་ལེན་པས།",
    "ཕུང་པོ་དང་རང་བཞིན་གཅིག་ཐ་དད་གང་དུ་ཡང་མ་གྲུབ་པའི་ཕྱིར་རོ་ཞེས་པ་ཙམ་ཞིག་འགོད།",
    "ཕུང་པོ་དང་རང་བཞིན་གཅིག་ཐ་དད་གང་དུ་ཡང་མ་གྲུབ་པའི་ཕྱིར།",
    "དུ་བའི་རྒྱུར་གྱུར་པའི་མེ་ཡོད་པ་ཙམ་ཞིག་དུས་ཀྱི་ཁྱད་པར་དུ་མ་བྱས་པར་སྒྲུབ་པ་ཡིན་ལ།",
    "ཁྱེད་རང་ཡང་བུམ་པ་མ་དམིགས་པའི་རྟགས་ཀྱིས་བུམ་མེད་སྒྲུབ་པ་ལྟ་བུ།",
    "ཁྱེད་རང་རང་བཞིན་མ་དམིགས་པའི་རྟགས་སུ་འདོད་པ་དེ་དག་ཀྱང་།",
    "དེ་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག།",
    "དེ་དག་ཀྱང་རང་བཞིན་གྱི་རྟགས་སུ་འགྱུར་བས།",
    "མངོན་རྗེས་གཉིས་དང་རང་ཚིག་སྔ་ཕྱི་འགལ་བ་སོགས་དང་གསུམ་གྱིས་གནོད་པ་མེད་པའི་ལུང་ཡིན་པ་ལ་བྱའོ།",
    "ཁྱེད་རང་ཡང་དེ་ལྟར་ཁས་ལེན་པ་དང་འགལ་ལོ།",
    "རྩ་བ་མ་མཐོང་བ་ཤ་སྟག་ཏུ་འདུག་པས།",
    "སྔ་རྒོལ་གྱི་ཞེ་བས་མི་འདོད་པའི་ལུང་དོན་ལའང་རང་མཚན་ཉིད་འདི་འཇུག་པར་འཛིན་པའི་ལོག་རྟོག་སྐྱེ་སྲིད་པ་ལ།",
    "ཁྱེད་རང་ཡང་འདོད་པ་དང་འགལ་ལོ།",
    "འོན་ཀྱང་རང་མཚན་སྒྲའི་དངོས་ཀྱི་བརྗོད་བྱ་ནི་མ་ཡིན་ཏེ།",
    "རིང་ན་འདུག་ཀྱང་དེ་དང་དེར།",
    "དེ་ཡང་རང་ཉིད་ཀྱིས་ཇི་ལྟར་གཏན་ལ་ཕབ་པ་ལྟར་དོན་འལ་གནས་མི་གནས་ནི།",
    "རྗེས་དཔག་དེ་ཡང་རང་ཉིད་ཀྱིས་བསྒྲུབ་བྱ་རྟོགས་པར་བྱེད་པའི་ཐབས་རང་དོན་རྗེས་དཔག་དང་།",
    "འབྲས་རྟགས་དང་རང་བཞིན་གྱི་རྟགས་སོགས་སུ་སྒྲུབ་པ་སྐབས་སུ་བབ་པ་ཡིན་ན།",
    "འདིར་འབྲས་རྟགས་དང་རང་བཞིན་གྱི་རྟགས་གཉིས་ལ།",
    "རང་བཞིན་དང་རང་བཞིན་ཅན་ལ་འཁྲུལ་བ་མེད་པའི་ཕྱིར།",
    "རྒྱུ་འབྲས་དང་རང་བཞིན་དང་རང་བཞིན་ཅན་དག་རྗེས་སུ་འགྲོ་ལྡོག་མི་འཁྲུལ་བའི་འབྲེལ་བ་ངེས་པའི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ནོ།",
    "དཀར་ཟལ་གྱི་རང་བཞིན་གང་ཡིན་པ་དེ་ཉིད་ནག་སྒུར་གྱི་ཡང་རང་བཞིན་ཡིན་པ་ལ་སོགས་པའི་སྒོ་ནས་རྣམ་འགྱུར་ཐམས་ཅད་རང་བཞིན་གཅིག་ཏུ་ཁས་ལེན་པར་བྱེད་པ་ཡིན་ལ།",
    "དེ་ཐམས་ཅད་ཀྱང་རང་བཞིན་གཅིག་འཛིན་གྱི་བློ་ལྷན་སྐྱེས་འདིའི་རྩ་བ་ཅན་ཡིན་ཏེ།",
    "རྗོད་བྱེད་ཀྱི་སྒྲའི་དོན་ཡང་རང་མཚན་དུ་འགྱུར་བས་སྒྲ་ཡང་སྒྲུབ་འཇུག་ཏུ་འགྱུར་དགོས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ཡང་རང་འགྲེལ་ལས།",
    "འོན་ཀྱང་རང་འགྲེལ་གྱི་དགོངས་པར་མི་སེམས་ཏེ།",
    "དེ་ཡང་རང་ལུགས་ལ།",
    "འོ་ན་ཁྱེད་རང་ལ་ཡང་མངོན་སུམ་གྱིས་སྒྲ་སྣང་ཡུལ་དུ་བྱས་པ་ལ་སྒྲ་བྱས་མི་རྟག་པ་སོགས་མཐོང་མ་མཐོང་ཆ་གཉིས་འགལ་བ་ལྟར།",
    "ཁྱེད་རང་སེལ་བ་སྨྲ་བ་ལ་ཡང་མཚུངས་སོ།",
    "དཔེར་ན་ཆོམ་རྐུན་དང་འགྲོགས་པའི་དགེ་སློང་རང་ཉིད་ཀྱིས་མ་བྱིན་པར་མ་བླངས་ཀྱང་།",
    "དེས་ན་ཤིང་གསལ་རྣམས་རང་བཞིན་འདྲེས་པར་སྣང་བའི་སྒོ་ནས་རིགས་གཅིག་ཏུ་འཛིན་པའི་འཁྲུལ་རྒྱུ་ནི་བག་ཆགས་དེ་ཉིད་ཡིན་ལ་བག་ཆགས་དེ་ཉིད་གང་མཐོང་བའི་སྒོ་ནས་འཇོག་པའི་ས་བོན་ནམ་འཁྲུལ་གཞི་ནི་ཤིང་མ་ཡིན་དང་མ་འདྲེས་པར་གནས་པའི་ཤིང་རང་མཚན་རྣམས་ཡིན་ནོ།",
    "ཤིང་གསལ་འགའ་ཞིག་ནི་དོན་ཤིང་གསལ་རྣམས་རིགས་གཅིག་ཏུ་རྟོགས་པའི་ཤེས་པ་བསྐྱེད་པ་ལ་སོགས་པའི་དོན་གཅིག་སྒྲུབ་པ་ལ་སྤྱི་དོན་གཞན་མེད་པའི་ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས་སམ་རང་རྒྱུ་ལས་དེར་ངེས་པ་མི་འགལ་ཏེ།",
    "ཤིང་དེའི་འབྲས་བུ་ཀྭཅན་མིན་པའི་དོན་ལས་ཐ་དད་པའི་ཤིང་རང་མཚན་གྱི་མཐར་ཐུག་ཅིང་བརྒྱུད་ནས་སྐྱེ་བ་སྟེ།",
    "དམ་པའི་དོན་གྱི་དོན་ཤིང་རང་མཚན་པ་རྣམས་ནི།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཁྱེད་རང་ལའང་མཚུངས་པར་འགྱུར་ཏེ།",
    "དེ་དག་ཚོགས་པ་ལའང་རང་འཛིན་མིག་ཤེས་སྐྱེད་པའི་ནུས་པ་འགྲུབ་པ་ཡིན་ལ།",
    "འདི་ལྟར་གསལ་བ་རྣམས་རང་རང་ནང་ཕན་ཚུན་ཐ་དད་ཅིང་།",
    "རང་རང་ཡང་ཐ་མི་དད་པའི་བ་ལང་དང་བ་ལང་ལྟ་བུ་ཤིན་ཏུ་ཐ་མི་དད་པ་དང་།",
    "བརྡ་དེའི་རྗེས་སུ་འབྲང་བའི་རྟོག་པས་རང་ལ་སྣང་བ་ཕྱི་རོལ་གྱི་ཤིང་དང་སྣང་བཏགས་གཅིག་ཏུ་འཁྲུལ་བའི་སྒོ་ནས་ཞུགས་པས་ཤིང་རང་མཚན་ཐོབ་ནུས་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཤིང་ཞེས་སོགས་ཀྱི་སྒྲ་རྣམས་ལས་ཤིང་མ་ཡིན་ལས་ལྡོག་པར་སྣང་བའི་གཞན་སེལ་དེ་སྣང་ཡུལ་དུ་བྱས་ནས་རྟོགས་པ་ཉིད་ཀྱིས་གཞན་ཤིང་མ་ཡིན་ལས་ལྡོག་པའི་ཤིང་རང་མཚན་དག་རྟོགས་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དེ་ཡང་རང་འགྲེལ་དུ།",
    "སྒྲ་ནི་ཞེས་སོགས་རྟོག་ངོར་འཇོག་ཀྱང་རང་མཚན་ལ་མི་སླུ།",
    "རང་ཉིད་དང་རང་ཉིད་གཞི་མཐུན་པ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཁྱེད་རང་ལ་ཡང་གཞན་སེལ་བའི་སྤྱི་དེ་གསལ་བ་རྣམས་དང་རྫས་གཅིག་ཐ་དད་བརྟགས་ན་ཉེས་པ་དེ་དག་མི་འབྱུང་ངམ་ཞེ་ན།",
    "དངོས་པོ་ཀུན་རང་རང་ངོ་བོ་ལ་མ་འདྲེས་པར་གནས་པའི་ཕྱིར།",
    "དེ་ཡང་རང་བཞིན་ལས་འབྲས་བུ་ཐོབ་པ་ཡིན་གྱི།",
    "གལ་ཏེ་ཁོ་བོ་ལྟར་ན་ས་ཆུ་ལུད་ས་བོན་སོགས་སྤྱི་གཙོ་བོའི་ངང་དུ་བདག་ཉིད་གཅིག་པ་ཡིས་ས་བོན་གྱིས་མྱུ་གུ་སྐྱེད་པའི་རང་བཞིན་གང་ཡིན་པ་དེ་ཉིད་སས་མྱུ་གུ་སྐྱེད་པའི་རང་བཞིན་ཡང་ཡིན་པ་ལ་སོགས་པའི་སྒོ་ནས་རྒྱུ་དུ་མ་གནས་སྐབས་ཐ་དད་ཀྱང་རང་བཞིན་གཅིག་ཡིན་པས་འབྲས་བུ་གཅིག་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "ནས་ཀྱི་རང་བཞིན་དུ་གྱུར་པའི་གཙོ་བོ་གང་ཡིན་པ་དེ་ཉིད་ཆུ་ལུད་སོགས་ཀྱིའང་རང་བཞིན་ཡིན་པའི་སྒོ་ནས་དེ་དག་གཙོ་བོའི་ངང་དུ་རང་བཞིན་འདྲེས་པར་སྨྲས་པས་སོ།",
    "ཞེས་པའི་ཉེས་པ་ཁྱེད་རང་སེལ་བ་སྨྲ་བ་ལའང་མཚུངས་སོ་ཞེ་ན།",
    "དེ་དག་ལ་ཐ་དད་མིན་པའི་གཙོ་བོའང་རང་བཞིན་འདྲེས་པའི་ཚུལ་དུ་ཡོད་པས་འབྲས་བུ་བསྐྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "འོན་ཀྱང་རང་ལུགས་ལ་སྤྱི་བློའི་སྣང་ཡུལ་དེ་ཉིད་གཞན་སེལ་བའི་སྤྱི་ཡིན་ལ།",
    "འཇིག་རྟེན་ཐམས་ཅད་ཀྱི་སྟེང་ན་འདུག་པའི་གནས་འཇིག་རྟེན་འདུས་པ་ཞེས་བྱ་བ།",
    "དངོས་པོ་ཐམས་ཅད་རང་དང་རང་མ་ཡིན་ཀུན་གྱི་བདག་ཉིད་ཡིན་པའི་ཕྱིར།",
    "ཆུ་ལུད་སོགས་གཙོ་བོའི་ངང་དུ་རང་རང་བཞིན་འདྲེས་པ་མ་ཡིན་ན།",
    "དེ་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག།",
    "གཞུང་དེ་དག་དང་རང་བཞིན་མཚུངས་པའི་རྟགས་ཀྱིས་རིག་བྱེད་ཀྱི་ངག་སྐྱེས་བུས་བྱས་པར་གྲུབ་བོ་ཞེས་སྟོན་པ་ནི།",
    "ཡང་ན་རིག་བྱེད་ཀྱི་ཡི་གེ་དེ་ལ་སྐྱེས་བུའི་འབྲས་བུ་འཇིག་རྟེན་པའི་ཡི་གེ་དག་དང་རང་བཞིན་མཚུངས་པ་དེ་མཐོང་བའི་ཕྱིར་ན།",
    "གསལ་བྱ་དེའི་རིགས་འདྲ་སྔར་ནས་གྲུབ་ཟིན་པའི་དོན་ལ་གསལ་བྱེད་རང་ཉིད་ཀྱང་རང་འཛིན་ཤེས་པས་མཐོང་བར་གྱུར་བའི་སྒོ་ནས།",
    "དུག་ཞི་བ་ལ་སོགས་པའི་འབྲས་བུ་བྱེད་པའི་ཡི་གེའི་གོ་རིམས་དང་ཆོ་ག་ལ་སོགས་པ་མང་དུ་རྩོམ་ཤེས་ཤིང་རང་ཇི་ལྟར་འདོད་པ་བཞིན་གྱི་འབྲས་བུ་འབྱིན་ནུས་སུ་བྱིན་གྱིས་རློབ་པའི་མཐུ་དང་ལྡན་པའི་སྐྱེས་བུ་ཡིན་པའི་ཕྱིར།",
    "འདི་ལྟར་ངར་འཛིན་ལྷན་སྐྱེས་མ་སྤངས་པའི་ཐ་མལ་པ་དག་ལ་ད་ལྟར་གྱི་ལུས་འདི་དང་ལྷའི་ལུས་ལྟ་བུའི་ཕུང་པོ་ཁྱད་པར་ཅན་བརྗེ་བའི་ནུས་པ་བྱུང་ན་ངེས་པར་སྔ་མ་འདོར་ཞིང་ཕྱི་མ་ལེན་པར་འདོད་པའི་མངོན་ཞེན་འདུག་པའི་ཕྱིར།",
    "འབྲས་བུ་མི་སྐྱེད་པའི་གནས་སྐབས་དང་རང་བཞིན་ཁྱད་པར་མེད་པར་གནས་པའི་ཕྱིར་རོ།",
    "འོ་ན་ཁྱེད་རང་ལའང་མྱུ་གུ་བསྐྱེད་པ་དང་མི་སྐྱེད་པའི་གནས་སྐབས་ཀྱི་ས་སོགས་ལ་རང་བཞིན་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "སོ་སོ་སོར་དེའི་ནུས་པ་མེད་པ་རྣམས་དང་རང་བཞིན་ཁྱད་པར་མེད་པས་ནའོ།",
    "ནམ་ཡང་རང་བཞིན་ཁྱད་པར་མེད་པའི་རྟག་པ་ཡིན་པའི་ཕྱིར།",
    "མར་མེ་ཞིག་པ་ན་དེ་དང་དུས་མཉམ་པའི་མར་མེའི་འོད་ཡུལ་གཞན་ན་འདུག་པའང་འཇིག་པ་དེ་བཞིན་དུ།",
    "འོ་ན་ཁྱེད་རང་ལའང་སེམས་ལས་སེམས་བར་མ་ཆད་དུ་སྐྱེ་ན་ཤི་བའི་ལུས་ལའང་སེམས་མི་ལྡོག་པའི་ཉེས་པར་མི་འགྱུར་རམ་ཞེ་ན།",
    "འགལ་རྐྱེན་གྱིས་བཅོམ་པས་འབྲས་བུ་མི་སྐྱེད་པར་ཁྱེད་རང་ཡང་འདོད་པས་སོ་ཞེ་ན།",
    "མར་མེ་ཞིག་པ་དེ་དང་དུས་མཉམ་པའི་མར་མེའི་འོད་ཡུལ་གཞན་ན་འདུག་པ་དག་ཀྱང་འཇིག་པ་དེ་བཞིན་དུ།",
    "ཁྱད་པར་འཕེལ་ཡང་རང་བཞིན་ཉིད།",
    "ད་ཧོར་ཡུལ་འདི་རུ་འདུག་པ་ལས།",
    "དེ་ནས་ང་རང་འབྱོན་ངེས་ཡིན།",
    "༢ཁྲག་དམར་པོས་མཚོ་ཞིག་བསྐྱིལ་ནས་གདའ།",
    "ར་ཚསྡུག་ཨ་ཐང་ཆད་ནས་ཁེར་འདུག་དེས།",
    "ཤ་ཟ་ཚད་རྒྱག་ཚད་སྟེར་ཚོད་འདུག།",
    "སྔར་མེད་པའི་ནོར་མང་པོ་འདུག་པ་དེ་གང་ཡིན་ལྟོས་དང་།",
    "རྒད་པོས་ང་གདན་འདི་འདྲའི་སྟེང་ནས་འདུག་པའི་སྐལ་བ་མེད་ཟེར།",
    "མགྲོན་ཡར་འདུག་ཟས་སྣ་དྲངས་པ་ན།",
    "དེ་ཧོར་གླིང་གཉིས་ཀ་འཁྲུག་དུས་སུ།",
    "བུ་སེང་ཆེན་ཕེབས་སྐད་ཨེ་འདུག་ལགས།",
    "ཁོས་ཨ་ཙི།",
    "ཤི་འདུག་ཟེར་ནས་ལོ་གསུམ།",
    "ཉི་མ་ཕྱི་དྲོ་དྲོ་ཟེར་བ་དེ་ཡོང་འདུག་བསམ་པའི་དོན་འགྲུབ།",
    "དུས་ད་ལན་ཕུལ་བ་མ་ནོར་འདུག།",
    "ལན་དྲིན་གཟོ་གཅིག་ཀྱང་ཡོད་མི་གདའ།",
    "ལན་དྲིན་གཟོ་གཅིག་ཀྱང་ཡོད་མི་གདའ།",
    "ལན་དྲིན་གཟོ་གཅིག་ཀྱང་ཡོད་མི་གདའ།",
    "ལན་དྲིན་གཟོ་གཅིག་ཀྱང་ཡོད་མི་གདའ།",
    "ཁོ་ཁྲོ་ཐུང་ཡུལ་དུ་འདུག་མ་ནུས།",
    "ཁོ་ཁྲོ་ཐུང་ཡུལ་ན་མི་འདུག་ལགས།",
    "ཁོ་ཁྲོ་ཐུང་ཡུལ་ན་མི་འདུག་ལགས།",
    "དུས་བསྐལ་པ་འཇིག་དུས་ནམ་མཁའ་མཐོང་།",
    "གཉན་གེར་མཛོའི་སྤྲུལ་པ་སྤྲང་པོ་ཕ་མ་བུ་གསུམ་གྱིས་ཡུང་མའི་ཆོལ་ཁུ་ཚྭ་རྡོར་གང་ཡང་མེད་པ་ཞིག་འཐུང་ཞིང་འདུག་པ་དང་།",
    "ད་ཧོར་ཡུལ་སྟོང་པར་མ་བསྒྱུར་ན་བདུད་ནག་པོ་བཏུལ་ཀྱང་ཕན་པ་མི་འདུག་སྤྱིར་འཛམ་བུའི་གླིང་ལ་ཕན་ཐོགས་མི་ཡོང་ཞིང་།",
    "ཆུང་བྱེའུ་ཕྲུག་གཤོག་པ་ཞན་པར་གདའ།",
