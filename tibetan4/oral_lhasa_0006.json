    "འབུམ་ཕྲག་བཟླས་པས་རྒྱལ་པོ་འགུགས་པར་འགྱུར་རོ།",
    "ཡང་ན་དཀའ་བས་ཟླ་བ་དྲུག་ཏུ་མི་སྨྲ་བར་བཟླས་ན་ཡིད་ལ་གང་འདོད་པས་དེ་རྙེད་པར་འགྱུར་རོ།",
    "ཞོ་བསྲེས་ནས་སྲེག་བླུགས་སྟོང་བྱས་ན་གསེར་སྲང་སྟོང་སྟེར་བར་འགྱུར་རོ།",
    "ཚིགས་བཅད་སྟོང་ཡང་འཛིན་པར་འགྱུར་རོ།",
    "ཐོར་ཚུགས་ལྡན་པར་བྱས་ལ་དེའི་མདུན་ཨ་པ་མརྒའི་ཡམ་ཤིང་ལ།",
    "སྔགས་འདིས་སྦྱིན་སྲེག་སྟོང་བྱས་ན་དོང་རྩེ་བརྒྱ་རྙེད་པར་འགྱུར་རོ།",
    "ལེགས་པར་ཡན་ལག་སྟེར་བ་དང་།",
    "བསྐུལ་བའི་ཡི་གེ་དང་ཡང་དག་པར་ལྡན་པ་འདི།",
    "དེ་ཉིད་དུ་ཟད་པར་བྱའོ།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་རྩ་བའི་སྔགས་ཀྱི་རྟོག་པ་གསུངས་པ།",
    "བསོད་སྙོམས་ཀྱིས་འཚོ་ཞིང་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "ཟླ་བ་དྲུག་ཏུ་ཆུ་ནང་དུ་ཆུའི་སྦྱིན་སྲེག་བྱས་ན་སྟོང་ཕྲག་བརྒྱ་རྙེད་པར་འགྱུར་རོ།",
    "སྦྲང་རྩི་སྤགས་ནས་སྟོང་ཕྲག་བརྒྱད་དུ་སྦྱིན་སྲེག་བྱས་ན་བར་སྣང་ལས་སྒྲ་ཐོས་པའམ།",
    "སེམས་ཀྱིས་བྱས་པས་ཚོགས་པར་འགྱུར་རོ།",
    "སྦྲང་རྩིས་སྦགས་ལ་སྟོང་ཕྲག་བརྒྱད་དུ་སྦྱིན་སྲེག་བྱས་ན་གྲོང་མཆོག་བཅུ་གཉིས་རྙེད་པར་འགྱུར་རོ།",
    "བག་མེད་པས་ལས་མ་གྲུབ་ན་སྟོང་ཕྲག་བཅུའི་ནང་ནས་གྲོང་གཅིག་རྙེད་པར་འགྱུར་རོ།",
    "སྦྲང་རྩིས་སྦགས་ནས་སྟོང་ཕྲག་བརྒྱད་དུ་སྦྱིན་སྲེག་བྱས་པ་དང་།",
    "མངར་གསུམ་གྱི་བཤོས་གཙང་མ་དང་།",
    "ལྷག་མ་མེད་པར་ཟད་པར་བྱའོ།",
