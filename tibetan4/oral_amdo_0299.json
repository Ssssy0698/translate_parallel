    "དེལྟ་འཆི་བདག་གི་ཁར་སོན་པ་དེའི་ཚེ་དུས་མ་ཡིན་པང་ལ་ལ་སྦས་ཀྱང་ཅི་ཞིག་བྱ་སྟེ།",
    "གང་གི་གདོང་ལ་དེ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "རེཐག་ཆད་པ་ལའོ།",
    "འི་ཚེ་ཡང་ངན་སོང་གི་འགྲོ་བ་ལས་གྲོལ་པའི་གྲུའང་རྙེད་པར་དཀའ་སྟེ།",
    "རྒོད་པ་ནིདྲག་གིས་རྣམཔར་གཡེང་བ་ཡིན་ཏེ།",
    "དགའ་བ་དང་བཅས་པའི་རིག་གི་རྣམ་པའགྱུར་བའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་གིས་བརྩོན་པའི་སྟོབས་བསྐྱེད་པའི་བརྩོན་འགྲུས་འབྲེལ་བའི་སྟོབས་ཀྱིས་ཚོགས་བསགས་པ་འོ།",
    "བདག་གིས་ཞིསཔ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེའི་ཕྱིར་ཤིན་ཏུཡང་སྡུག་བསྔལ་ཆུང་ངུ་ལ་བཟོད་པར་བྱའོ།",
    "བློ་དང་ལྡན་པས་འདི་ལྟར་རེ་ཞིག་ཁས་བླངས་པར་རིགས་ཏེ་འ།",
    "སྦྱིན་པཆེན་པོའི་ཆེན་པོ་ལ་གོམས་པ་ཤུལ་དུ་ཕྱིན་པར་གྱུར་པ་ན་ཕྱི་ནསནི་དུས་ཕྱི་ནས་དཀའ་བ་མེད་པ་ཉིད་དུ་རང་གི་ཤ་དང་ཁྲག་ལ་སོགས་པ་ཡང་དང་བས་སྟེར་བར་བྱེད་དོ།",
    "འདི་ནི་དཔུང་གི་ཚོགས་བཞི་ཡིན་ཏེ།",
    "དན་དཔུང་གི་ཚོགས་ཀྱི་བྱ་བ་བསྟན་པའི་ཕྱིར།",
    "དེ་ལ་རེ་ཞིག་འདུན་པ་པསྐྱེད་པ་དང་པོར།",
    "དེའི་ཚངན་སོང་དུ་ལྷུང་བ་ལས་གཞན་རྟེན་ཡོད་པ་མ་ཡིན་པ་བདག་གིས་བསམས་ནས་སྐྱོ་བ་མངོན་དུ་བྱསྟེ།",
    "རེ་རེ་ལ་ཞེས་པ་ནི་རེ་ཞིག་མང་པརྣམས་བཞག་སྟེ།",
    "རྣམ་པ་གང་གིས་སོ།",
    "བདག་གི་སྐྱེ་བ་ནི་མི་ཁོམ་པ་བརྒྱུདལས་གྲོལ་བ་པན་ལ་ཁྱོར་བ་ནི་བསྐལ་པས་ཏེ་རྒྱབ་ཏུ་བྱས་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "བརྒྱ་ལན་ཐོབ་པ་ནི་རྒྱ་མཚོ་ཆེར་གཡེངས་གཉའ་ཤིང་གི།",
    "དེ་རྣམས་ཀྱི་བདེ་བའི་འབྱོར་པ་དུ་མ་སྟོན་པར་བྱེད་དེ་རྒྱ་ཆེར་བ་ནི་ཤརེཏུ་སྤངས་པ་ཡིན་ལ།",
    "དེ་ནི་ལས་དང་ཉོན་མོངས་ནུས་ཞེས་གསུངས་ཏེ།",
    "དེ་ལ་ཉེ་བའི་ཉོན་མོངས་པ་ནི་དངོས་པོར་ཕྲན་ཚེགས་ཀྱི་མིང་ཅན་ཏེ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་རྣམས་ཉིད་ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་སུ་བརྗོད་དོ།",
    "ཉིད་བསྟན་པའི་ཕྱིར་ཉོན་མོངས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཉོན་མོངས་པས་དཔང་དུ་བྱས་པ་ནི་སྐྱེ་བོའི་ཚོགས་འདི་ཐམས་ཅད་ཡིན་ཏེ།",
    "གང་དུ་ཡང་རང་གི་དོན་བསྒྲུབ་པ་ལ་ནུས་པ་དང་ལྡན་པར་མ་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེའི་ཕྱིར་སྐྱེ་པོ་འདི་དག་འདི་ལྟ་བའི་ཁུར་བསྐུར་བ་ལ་བདག་ལ་ནུས་པ་མེད་པ་མ་ཡིནནོ།",
    "བདག་གི་བྱ་བ་རྗེ་ལྟར་གཞན་གྱིས་སྤྱོད་དེ་བདག་ཉིད་ཀྱིས་བྱ་བར་འོས་སོ་ཞེས་པའི་དོན་ཏོ།",
    "འོན་ལས་དེ་བདག་གིས་རྗེསུ་མཐུན་པ་ཉིད་དོ་ཞེས་པའི་སེམས་ཁེངས་པ་བཟློག་པར་འདོདོནས་འདི་ལ་ང་རྒྱལ་གྱིས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ཉིད་དེའི་བུ་ཡིན་ལ་ལས་འདིའི་ཤིན་ཏུ་དམན་པ་ཡིན་ཏེ་དེ་བདག་གིས་བྱ་བར་རིགས་པ་མ་ཡཞིནོཞེས་ནས་གལ་ཏེ་ང་རྒྱལ་གྱི་མི་ཕྱེདན་དེའི་ཚེ་བདག་གི་ང་རྒྱལ་བརླག་ན་བླ་སྟེ།",
    "གལ་ཏེ་ཉ་པའི་ཉོན་མོངས་པ་རྣམས་ལ་ང་རྒྱལ་བཅོམ་པས་བདག་གི་སེམས་ཞན་པར་གྱུར་ཏེ།",
    "ཆུང་ངུ་ཡང་ན་ཉེ་བའི་ཉོན་མོངས་པས་བསྐྱོད་པའི་སྤྱོད་པ་ཞན་པའོ།",
    "ཉོན་མོངས་པའ་སྡུག་བསྔལ་ཅན་དེ་རྣམས་ཀྱང་ང་རྒྱལ་ཅན་དུའགྱུར་བ་མ་ཡིན་པ་ཉིད་དོ།",
    "ཉོན་མོངས་ཆགས་ཀྱིས་ཤེས་ཏེ།",
    "ཉོན་མོངས་པའི་ཚོགས་ཀྱིས་ཚུགས་པར་དཀའ་བ་ནི་མ་ཚུགསཔ་སྟེ།",
    "དེ་ལྟར་བརྗོད་པའི་རོ་དང་ཡག་གི་ཚུལ་གྱིས་ཉམ་ང་བྱུང་གྱུར་ཀྱང་།",
    "རྒྱ་ལམར་རང་མཡཟིགསཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གནས་སྐབས་འདི་དག་ལ་དྲི་རྟོན་མོངས་པ་འཇུག་པའི་གནས་སྐབས་ལའོ།",
    "གང་པ་ཕྱི་མ་སྟེ་སྐྱེས་བུ་ཏིང་ངེ་འཛིན་སྐུ་པར་རྣམ་པར་གཡེང་བའི་སེམས་ཏེ་མཉམ་པར་བཞག་པ་ཉེ་བར་སྤྱོད་པས་བརྩོན་འགྲུས་དང་ལྡན་ཡང་སྲིན་པོ་ལྟ་བུའི་ཉོནམོངས་པ་རྣམས་ཀྱི་མཆོ་པའི་ཕྲག་ནསྟེ།",
    "དེ་ལྟ་བས་ན་དེ་ལ་རེ་ཞིག་ཏིང་ངེ་འཛིན་གྱི་སྤྱི་མཐུན་པའི་ཕྱོགས་རྣམས་པར་གཡེས་པ་སྤྲོས་བར་འདོད་ནས་གཞི་འཆའ་བ།",
    "དེ་ལྟར་ལུས་དང་སེམས་དྲག་གི་རྣམ་པར་མི་པེན་པ་ལ་ཞེན་པ་མེད་པ་ཉིད་ཀྱིས་རྣམ་པར་གཡེང་བ་སྟེ།",
    "དེ་དག་གི་གཟེངས་བསྟོང་པ་ཉིད་ལ་དམགིས་པ་ཉིད་ཀྱིས་རབ་ཏུ་གནས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེའི་ཕྱིར་དང་པོར་འཇིག་རྟེན་ཏེ།",
    "ཁྱོནམེངས་པ་ལས་གྲོལ་བར་འདོད་པས་ཞི་གནས་ཐོག་མར་ཏེ་དང་པོར་བཅིལ་བ་སྟེ་ཉེ་བར་བྱ་ཞིང་བསྐྱེད་པར་བྱའོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "གཞན་ཡང་དོན་ཉམས་པ་ཐམས་ཅད་ཀྱི་རྒྱུ་སྡུག་པ་དང་ཕྲད་པ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་ཡང་དག་གྱུར་པ་ལ་སོགས་པ་གསུངས་ཏེ་སྡུག་པ་དང་ཕྲད་པར་འདོད་པས་ཡང་དག་པར་གྱུར་པ་སྟེ་མ་སོང་བའི་ཡོན་ཏན་དང་སྐྱོན་མ་མཐོང་སྟེ་མི་ཤེས་སོ།",
    "ཁྱོད་གཅིག་པུ་ངལ་བའི་འབྲས་བུ་འཛིཉམསུ་བླངས་ནས་ཆུ་བཞིས་བདག་དེ་ལ་ཞུགས་པ་དེ་ལས་བཟློག་པར་བྱེད་དོ།",
    "བག་གི་ཚིག་ལས་འདི་མ་ལོག་གོ་ཞེས་པས་སོ།",
    "མི་སྙན་བརྗོད་པ་སྟེ་བདག་གི་ཉེས་པ་བསྒྲིགས་པ་ཐོས་པ་ལས་ཏེ་དོན་གྱིས་ནམ་སྙན་པར་བརྗོད་པ་ལས་ཡོང་ཁྲོ་བ་སྟེ་ཞེ་སྡང་སྐྱེའོ།",
    "བསྙེན་བཀུར་རེ་བའི་བསམ་པས་མ་ཡིན་པའོ།",
    "ཅིའི་ཕྱིར་ཞེན་གང་གི་ཕྱིར་དགོས་པ་མེད་པར་བྱས་པ་གྲྭ་ལོ་ཡང་ངགང་བ་སྐྱེ་བར་མི་འགྱུར།",
    "བག་གིས་ང་སྟོན་པ་ལ་སོགས་པ་བརྟེན་པ་ལ་གནས་པར་བྱའོ་ཞེས་ནས་དེའི་ཕནཡོན་བསྟན་པའི་ཕྱིར།",
    "ལྗོན་ཤིང་གི་དྲུང་ནི་ཤིང་གའོག་ཡརེ་ལ།",
    "གང་ལ་ཡང་བདག་གིར་བྱས་པ་མེད་པའི་ཕྱིར་རོ།",
    "ཕྱི་དང་ནང་གི་བདག་ཆདི་ཡོངས་བཟུང་བ་མེད་པའི་ཕྱིར་བསྲུང་བ་དང་བྲལ་བ་ཡིན།",
    "ཡང་ནཱརེ་དྲུམས་ཀྱི་མྱངནམཐོང་བས་འཆི་བ་པོའི་ཡིད་གདུང་བར་བྱེད་པ་མ་ཡིནནོ།",
    "དམག་མི་གཅིག་གིས་ཞེས་པ་ནི་རྩེ་གཅིག་པ་ནི་གཙོ་བོ་ཡནིཏཾ།",
    "དེ་ལྟར་ན་བདག་ཁྱེད་ཀྱིས་གསོན་པར་བྱས་པ་ཡིན་ནོཞིས་གསོལ་བ་འདེབས་པ་སྔོན་དུ་སོང་བས་ལུག་པ་ཐལམོ་སྦྱར་ཏིལན་དུམར་གསོལ་བ་འདེབསས།",
    "ཁྱོད་སྐུག་ནས་ཟུར་གྱིས་འདྲི་བར་བྱེད་དེ།",
    "གཞན་ཡང་ཁྱོད་ལ་འདི་འདྲི་བར་བྱ་སྟེ།",
    "དེ་ལ་ཁྱོད་ཉིད་ཅེས་པ་ལ་སོགས་པ་གསུངས་སོཡོད་གཞན་དུ་སྤྱར་བར་བྱ་སྟེ།",
    "དྲོ་འདོད་པ་ན་འཇིམ་པའི་མ་བུཔ་ཡང་འགྱུར་ལ་དེ་བཞིན་དུ་ཡང་ཁྱོད་ཀྱང་སེམས་དང་བྲལ་བར་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་བདག་ཀྱང་དེའི་ལུས་དེ་ལྟ་བུ་ཡནི་ལ།",
    "༡༤ ལ་ཁྱོངནི་ཞེས་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རང་གི་དངོས་པོ་བཙོངས་ནས་མཆེ་བ་བཞི་འཁྲིགས་པའི་ཡུལ་དུ་འདུ།",
    "དེའི་ཕྱིར་བདག་བཞིན་དུ་བདག་གིས་བསྐྱང་བར་བྱ་སྟེ།",
    "བདག་བདག་ཉིད་ལ་ཡང་བནམ་འདོགས་པར་ཐལ་བར་འགྱུར་བས་མ་ངེས་པ་ཡང་མ་ཡིན།",
    "དེའི་ཕྱིར་སྐུའི་མ་འདི་རྣམས་ཚིག་གཅིག་གིས་བློའི་ཐ་སྙད་བྱ་ད་དུ་ཕྱུད་ཅེསབརྗོད་བྱས།",
    "ཨཞན་དུ་ན་གང་གིས་ཁས་མི་ལེན་པར་འགྱུར་བ་བདག་གིས་གནོད་པ་ཚེ་ཞིག་གིས་བྱས།",
    "ཚུ་རོལ་མཛེས་པ་ཡང་འདིའི་རང་གི་སྡུག་བསྔལ་སྤོང་བར་ཞུགས་པའི་ཕྱིའི་རོ།",
    "བདག་གི་བདེ་བ་ཡང་གཞན་སྡུག་བསྔལ་བསསྡུག་བསྔལ་བ་ཉིད་གང་རྣམས་ཀྱིས་ཡིན་པ་ཞེས་པའི་དོན་ཏོ།",
    "དེའི་རང་བཞིན་དེར་རང་གི་ལུས་གྲུབ་པ་ཉིད་དོ།"
  ]
}