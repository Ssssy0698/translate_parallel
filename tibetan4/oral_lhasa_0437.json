    "ཞེས་ལན་གསུམ་བརྗོད་ལ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཨོཾ་ཏིཥྛ་བཛྲ་ཞེས་ལན་གསུམ་བརྗོད་ལ་བྱིན་གྱིས་བརླབ་པར་བྱ་ཞིང་།",
    "ཐུགས་ཀྱི་རྡོ་རྗེའི་དབྱིངས་ཕྱག་རྒྱ་རྣམ་པ་བཞིའི་ངོ་བོ་ཉིད་དེ་བཞིན་གཤེགས་པའི་ས་བོན་གྱི་ཡི་གེས་བྱིན་གྱིས་བརླབས་པའི་མཐུ་ལས་རྡོ་རྗེ་ཆེན་པོ་དེའི་ལྟེ་བའི་དབུས་སུ་ཞུགས་པར་གྱུར་པར་བསམས་ལ།",
    "ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ།",
    "ཞེས་ལེན་གསུམ་བརྗོད་པར་བྱའོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མེད་པ་རྣམས་སུ་ཁ་དོག་དང་སྤྱོད་ལམ་སྣ་ཚོགས་པའི་རྣམ་པར་སྣང་མཛད་དང་།",
    "འདུས་ནས་རྣམ་པར་སྣང་མཛད་ཆེན་པོའི་ཕྱག་རྒྱ་ཆེན་པོའི་སྐུར་གྱུར་ནས་འོད་ཟེར་གྱི་རང་བཞིན་གྱི་ཚོགས་ཀྱི་ཕྱི་རོལ་དུ་གནས་ཏེ།",
    "བྱིན་གྱིས་བརླབས་ནས་ཡོངས་སུ་མཉེས་པར་བྱ་ཞིང་།",
    "དེ་ནས་བྱིན་གྱིས་བརླབ་པར་གསོལ་བར་བྱ་སྟེ།",
    "དོན་ཡོད་པར་གྲུབ་པས་ཕྱག་རྒྱ་ཆེན་པོ་དང་།",
    "ཨོཾ་བཛྲ་བནྡྷ་ཏྲ་ཊ་ཅེས་བྱ་བ་སྔགས་ལེན་གསུམ་བརྗོད་པར་བྱའོ།",
    "ཡང་དག་པར་འདྲེས་ནས་བཛྲ་སྥོ་ཊ་བཾ་ཞེས་བརྗོད་པ་འདི་དང་།",
    "དེ་ནས་ལན་གསུམ་མམ་བདུན་ཡི་གེ་བརྒྱ་པ་བཟླས་པས་བརྟན་པར་བྱ་སྟེ།",
    "བཛྲ་མཱ་མེ་མུཉྩ་བཛྲཱི་བྷ་བ་མ་ཧཱ་ས་མ་ཡ་སཏྭ་ཨ་དེ་ནས་རིམ་པ་འདིས་བྱིན་གྱིས་བརླབ་པར་བྱ་སྟེ།",
    "དོན་ཡོད་པར་གྲུབ་པ་ཡི་གེ་དེ་དག་ཉིད་ཀྱིས་མཚན་པའམ།",
    "དེ་དང་བཅས་པར་གཅིག་ཏུ་གྱུར་ནས་ས་བོན་གྱི་ཡི་གེ་ལ་ཐིམ་པར་གྱུར་ཅིང་།",
    "གཡས་སུ་འཁྱིལ་བ་དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་གྱི་ཚོགས་ཡང་དག་པར་འགུགས་པ་ལ་བརྩོན་པ།",
    "མཛོད་སྤུ་ལྟ་བུར་གནས་པར་གྱུར་པར་བསམས་ལ།",
    "དེ་ནས་དོན་ཡོད་པར་གྲུབ་པའི་ཕྱག་རྒྱ་བཅིངས་ལ་སྤྱི་བོར་བཞག་སྟེ།",
    "རྗེ་བཙུན་དང་བཅས་པར་ཐིམ་པར་གྱུར་ཏེ།",
    "སྤྱི་གཙུག་ན་གནས་པའི་རྡོ་རྗེའི་ས་བོན་གྱི་ཡི་གེའི་ནང་དུ་ཞུགས་ནས་སྤྱི་གཙུག་བལྟར་མི་མཐོང་བ་ལྟ་བུར་གནས་པར་གྱུར་པར་བསམས་ལ།",
    "བུམ་པའི་དབུས་སུ་ཡི་གེ་ཨ་རྣམ་པར་བསྒོམས་ལ་བདུད་རྩི་འབབ་པར་གྱུར་པ་དང་།",
    "རྟག་པ་དེའང་ལུས་ལ་ཞུགས་པར་བསམ་པར་བྱའོ།",
    "དེ་ཡོངས་སུ་གྱུར་ནས་ཡི་གེ་ཧཱུྃ་ལས་མི་བསྐྱོད་པར་གྱུར་ཏེ།",
    "ཨ་བྷི་ཥིཉྩ་མཱཾ་ཧཱུྃ་ཞེས་པའི་སྔགས་འདི་ཡང་བརྗོད་པར་བྱའོ།",
    "ཨ་བྷི་ཥིཉྩ་སྭ་མཱཾ་ཏྲཱཾ་ཞེས་བརྗོད་པར་བྱའོ།",
    "ཞེས་བྱ་བའི་སྔགས་བརྗོད་པར་བྱའོ།",
    "དོན་ཡོད་པར་གྲུབ་པའི་ཕྱག་རྒྱ་རྣ་བ་གཡོན་པའི་སྟེང་དུ་བཞག་ལ།",
    "ཨ་བྷི་ཥིཉྩ་སྭ་མཱཾ་ཨ་ཞེས་བརྗོད་པར་བྱའོ།",
    "གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་སྔགས་དང་ཕྱག་རྒྱ་རྣམས་ནི་ཤིན་ཏུ་ཡང་བྱིན་གྱིས་རློབ་པར་བྱེད་པས་སྔགས་དང་ཕྱག་རྒྱ་དེ་དག་ཉིད་བྱིན་གྱིས་བརླབ་པ་དང་།",
    "བཛྲ་ཛྙཱ་ན་ཨ་དྷི་ཏིཥྛ་སྭ་མཱཾ་ཧཱུྃ་ཞེས་ཀྱང་བརྗོད་པར་བྱའོ།",
    "བཛྲ་ཛྙཱ་ན་ཨ་དྷི་ཏིཥྛ་སྭ་མཱཾ་ཨ་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "སྔགས་འདི་དག་དང་བཅས་པས་དང་པོ་བྱིན་གྱིས་བརླབ་པར་བྱས་ལ།",
    "དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པ་ནི་མ་བྱས་ཀྱང་ཉེས་པར་མི་འགྱུར་རོ།",
    "བྱས་སུ་ཟིན་ཀྱང་དེར་ཤིན་ཏུ་བྱིན་གྱིས་རློབ་པར་འགྱུར་རོ།",
    "ཞེས་བྱ་བའི་ཁྱད་པར་འདིས་བྱའོ།",
    "དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་སེམས་དཔའ་རྣམས་ཀྱི་སྔགས་ཐུགས་ཀ་ལ་སོགས་པར་བཀོད་པས་བྱིན་གྱིས་བརླབ་པ་དང་།",
    "རྣམ་པར་དག་པའི་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་གྱི་རང་བཞིན་ཅན་དེའི་ཁའི་ཆ་ལས་བྱུང་བའི་ལྕེ་ཧྲཱི་ལས་བྱུང་བ་བྱིན་གྱིས་བརླབ་པར་བྱས་ལ།",
    "ཨོཾ་པདྨ་སར་སྭ་ཏི་སད་དྱ་མ་བརྨ་ཏ་ཡ་ཤོ་དྷ་ཡ་ཧཱུྃ་ཧྲཱི་ཞེས་བརྗོད་ལ་ལྕེ་དེའི་དབུས་སུ་ཡི་གེ་ཧཱུྃ་ལས་རྡོ་རྗེ་ལྕེའི་ཁམས་ཀྱི་གཟུགས་ཅན་ཆུར་གནས་པ་དེའི་ཆང་ཟུངས་ཀྱི་དབུས་སུ་ཡི་གེ་ཧྲཱི་ལས་པདྨ་དེ་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་ལྟེ་བའི་ནང་དུ་འོད་དཔག་མེད་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པའི་ཡེ་ཤེས་ཀྱི་སྐུ་དེའི་ཐུགས་ཀར་ཡི་གེ་ཧྲཱི་ཐམས་ཅད་དུ་ཁྱབ་པར་བྱེད་པའོ།",
    "དེ་ནས་ཧཱུཾ་ཧ་ཧཱུྃཞེས་བྱ་བ་རྡོ་རྗེ་བཞད་པར་བྱིན་གྱིས་རློབ་པར་བྱེད་པར་བསམས་ལ།",
    "སོ་གསལ་བས་རྣམ་པར་སྤྲས་པའི་ཁ་ལ་མདུན་སོ་གཉིས་སུ་ཡི་གེ་ཧོ་གཉིས།",
    "གཙུག་ཏོར་བསྐྱེད་པར་བྱའོ།",
    "རྡོ་རྗེ་བསྲུང་བའི་ཕྱག་རྒྱ་བཅིངས་ནས་སྔགས་བརྗོད་ནས་བྱིན་གྱིས་བརླབ་པར་བྱ་སྟེ།",
    "ནིར་བྷ་ཡ་སྟྭཾ་ཞེས་བརྗོད་པར་བྱའོ།",
    "ཆོ་གའི་འོག་ཏུ་རྐང་པའི་མཐར་ཐུག་པར་རབ་ཏུ་འཕྱང་བ།",
    "ང་རྒྱལ་བསྐྱེད་པར་བྱ་སྟེ།",
    "བྷ་ག་ཝཱན་བཛྲ་དྷཱ་ཏུ་ཞེས་བརྗོད་པར་བྱའོ།",
    "ཧཱུྃ་ཧྲཱཾ་ཧྲཱི་ཨ་ཞེས་བྱ་བ་འདི་དག་ལས་བསྐྱེད་པར་བྱའོ།",
    "ཕྱིའི་དཀྱིལ་འཁོར་གྱི་མཚམས་རྣམས་སུ་རྡོ་རྗེ་བདུག་པ་མ་ལ་སོགས་པ་ཨ་ཏྲ་དྷཱི་བ་ཞེས་བྱ་བ་འདི་དག་ལས་བསྐྱེད་པར་བྱའོ།",
    "ཕྱག་རྒྱ་བཞིའི་དཀྱིལ་འཁོར་གྱི་ཚུལ་གྱིས་བཞུགས་པར་བསམ་པར་བྱ་བའམ།",
    "ཡི་གེ་ཤིན་ཏུ་གསལ་ཞིང་འོད་ཀྱི་ཚོགས་འཕྲོ་བ་འདུས་པར་གྱུར་པ་ལས་ལྷའི་སྐུ་བསམ་པར་བྱའོ།",
    "བྱམས་པ་ལ་སོགས་པ་འཁོར་གྱི་ཚོགས་རྣམས་ཀྱང་ཕྱོགས་བཞིར་ཕྱི་རོལ་གྱི་སྣམ་བུ་ལ་བསམ་པར་བྱ་སྟེ།",
    "མྱ་ངན་དང་མུན་པ་ཐམས་ཅད་ངེས་པར་འཇོམས་པའི་བློ་གྲོས་དང་།",
    "འགྲོ་བ་རྣམས་བྱིན་གྱིས་བརླབ་པར་བྱ་སྟེ།",
    "དེའི་སྟེང་དུ་ཡི་གེ་ཁཾ་ལས་རྣམ་པར་སྣང་མཛད་བསམས་ལ།",
    "བཅོམ་ལྡན་འདས་ཀྱང་དེ་ཉིད་དུ་ཐིམ་པར་གྱུར་པར་བསམས་ནས།",
    "འདུས་པའི་ཏིང་ངེ་འཛིན་བརྟན་པར་གྱུར་པའི་མཐུས།",
    "སའི་དཀྱིལ་འཁོར་དཔག་ཏུ་མེད་པར་བསམ་པར་བྱའོ།",
    "དེའི་སྟེང་དུ་ཡི་གེ་ཁཾ་ལས་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་མ་ལུས་པ་ཁྱབ་པའི་གཞལ་ཡས་ཁང་ཆེན་པོ་རྣམ་པར་བསམ་པར་བྱའོ།",
    "བསྟོད་པར་གྱུར་ཅིང་གདུགས་དང་།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀར་རྗེས་སུ་ཞུགས་པར་བསམ་པར་བྱའོ།",
    "དེ་ལ་ཡི་གེ་ཧོ་ཞུགས་ནས་ཡོངས་སུ་མཉེས་པར་བྱེད་དོ།",
    "ཡི་གེ་ཨ་ཡིས་དེས་རྫོགས་པར་བྱེད་པ་བྱིན་གྱིས་རློབ་པ་དང་།",
    "ཐུགས་སུ་ཆུད་པར་བྱ་བ་དག་བྱེད་དོ།",
    "བཛྲ་དྷཱ་ཏུ་ཞེས་བྱ་བའི་སྒྲས་ནི་རིགས་བཞིའི་ངོ་བོ་ཉིད་དུ་བྱིན་གྱིས་རློབ་པར་བྱེད་དོ།",
    "ཡི་གེ་ཧོ་ཡིས་ནི་ཡང་ཡོངས་སུ་མཉེས་པར་བྱེད་དོ།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་མཁྱེན་པ་པོ།",
    "མཉེས་པར་བྱས་ནས་བཞུགས་སུ་གསོལ་ལོ།",
    "ཁ་ཕྱིར་བལྟས་པར་བཞག་ལ།",
    "སྔགས་དང་བཅས་པ་བརྗོད་པར་བྱའོ།",
    "དེ་ལ་རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀར་ནི་རྡོ་རྗེ་མཆོད་རྟེན་བྱིན་གྱིས་བརླབས་ལ།",
    "དེ་ལྟར་ལྷའི་ཁྱད་པར་ཐམས་ཅད་དུ་འང་ཕྱག་རྒྱ་བཞི་དང་སྦྱར་བར་ཁོང་དུ་ཆུད་པར་བྱ་བའམ།",
    "གཟུགས་ཅན་ཉིད་དུ་བསམ་པར་བྱའོ།",
    "ལས་ཀྱི་ཕྱག་རྒྱ་བསྟན་པའི་དུས་སུ་ནི་ལས་ཀྱི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་ཏེ་འདི་ནི་ཁྱད་པར་ཡིན་ནོ།",
    "ཕྱག་རྒྱ་དེ་རྣམས་ཀྱང་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་སྣ་ཚོགས་རྡོ་རྗེའི་ནང་དུ་ཆུད་པའི་ས་བོན་གྱི་ཡི་གེ་བསམ་པར་ཤེས་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་དྷཱ་ཏུ་ཛ་ཧཱུྃ་བཾ་ཧོ་བཛྲ་ཛྙཱ་ན་ཞེས་བརྗོད་པར་བྱའོ།",
    "དེའི་བདག་པོའི་ཕྱག་རྒྱ་ཉིད་བཅིངས་ལ་སྔགས་བརྗོད་པར་བྱ་སྟེ།",
    "ཧཱུྃ་སཏྭ་བཛྲ་ཛ་ཧཱུྃ་བཾ་ཧོ་བཛྲ་ཛྙཱ་ན་ཞེས་བརྗོད་པར་བྱའོ།",
    "ཏྲ་རཏྣ་བཛྲི་ཛ་ཧཱུྃ་བཾ་ཧོ་བཛྲ་ཛྙཱ་ན་ཞེས་བརྗོད་པར་བྱའོ།",
    "ཧྲཱི་དྷརྨ་བཛྲི་ཛ་ཧཱུྃ་བཾ་ཧོ་བཛྲ་ཛྙཱ་ན་ཞེས་བརྗོད་པར་བྱའོ།",
    "དོན་ཡོད་པར་གྲུབ་པའམ་ལས་ཀྱི་སེམས་མའི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཨ་ཀརྨ་བཛྲི་ཛ་ཧཱུྃ་བཾ་ཧོ་བཛྲ་ཛྙཱ་ན་ཞེས་བརྗོད་པར་བྱའོ།",
    "རྡོ་རྗེ་བསྡམས་པ་བཅིངས་ལ་མཐེ་བོ་མཉམ་པར་བྱས་ཏེ།",
    "ཕན་ཚུན་བལྟས་པར་བསྒྲེངས་པ་ནི་རྡོ་རྗེ་གླུ་མཁན་མའི་ཕྱག་རྒྱ་སྟེ།",
    "དེ་ནས་དེ་ཉིད་དགྲོལ་ལ་གཡས་པར་བྱ་བ་གཡོན་གྱིས་བྱས་ལ།",
    "གཡོན་པར་བྱ་བ་གཡས་ཀྱིས་བྱས་ནས།",
    "རྡོ་རྗེ་བསྡམས་པ་བཅིངས་ལ་མཐེ་བོ་གཉིས་གཤིབས་ཏེ་བསྒྲེངས་ལ་མཉམ་པོར་བྱས་ནས་གྱེན་དུ་བལྟས་པར་མར་མེའི་རྩེ་ལྟར་བཞག་པ་ནི་རྡོ་རྗེ་མར་མེའི་ཕྱག་རྒྱ་སྟེ།",
    "རྡོ་རྗེ་བསྡམས་པ་བཅིངས་ལ་མཐེ་བོ་གཉིས་མདུད་པར་བྱ་བ་ནི་རྡོ་རྗེ་ཞགས་པའི་ཕྱག་རྒྱ་སྟེ།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "བཅོམ་ལྡན་འདས་མི་བསྐྱོད་པའི་རྡོ་རྗེ་རིགས་བྱིན་གྱིས་བརླབ་པར་མཛད་པ་གནས་ཤིང་ས་གནོན་གྱི་ཕྱག་རྒྱས་བཞུགས་པར་བསམ་པར་བྱའོ།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "ལས་ཀྱི་སེམས་མ་ནི་སྣ་ཚོགས་རྡོ་རྗེའི་ནང་དུ་ཆུད་པ་བཅོམ་ལྡན་འདས་ཀྱི་ལས་ཀྱི་ཕྱག་རྒྱས་བྱིན་གྱིས་རློབ་པར་བྱེད་པ་དང་།",
    "སེམས་དཔའི་ཚུལ་གྱིས་སྒེག་པའི་ཆགས་པའི་ཉམས་དང་ལྡན་པས་དེ་བཞིན་གཤེགས་པའི་གར་གྱི་འཁོར་ལོས་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མེད་པར་གར་མཛད་པ།",
    "དེ་ཉིད་ནས་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མེད་པར་ཉི་མ་དང་ཟླ་བའི་དཀྱིལ་འཁོར་དང་།",
    "དེ་ལས་གཞན་པ་སྣོད་ཀྱི་འཇིག་རྟེན་དག་ཀྱང་ཤིན་ཏུ་གསལ་བར་གྱུར་པར་བསམ་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་སྤྱན་འདྲེན་པར་བྱེད་པ།",
    "ལས་ཀྱི་ཕྱག་རྒྱ་བསྟན་པར་བྱ་ཞིང་།",
    "སྔར་བསྟན་པའི་སྔགས་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་ལས་ཀྱི་ཕྱག་རྒྱ་ཐམས་ཅད་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ལས་ཀྱི་ཕྱག་རྒྱ་དེ་དག་ཀྱང་དེ་དང་ཐ་མི་དད་པར་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ལག་པ་གཡས་པ་གན་རྐྱལ་དུ་བྱས་ཏེ།",
    "འདི་དག་ནི་རྡོ་རྗེ་ཁུ་ཚུར་ལས་བྱུང་བ་ཡིན་པས་ན་ཁྱད་པར་ནི་དེ་དག་ཡོད་དོ།",
    "དེ་སྤྲོས་པ་ལས་བདག་ཉིད་རྡོ་རྗེ་བདུག་པ་མ་ལ་སོགས་པའི་གཟུགས་སུ་ཡོངས་སུ་གྱུར་པར་བསམས་ནས་ལག་པས་ལས་ཀྱི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "དེ་ན་ཡང་དག་པར་བསྡུས་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དཀྱིལ་འཁོར་གྱི་ནང་ན་གནས་པའི་རྡོ་རྗེ་བདུག་པ་མ་ལ་སོགས་པ་ལ་གཞུག་ཅིང་བཅིང་བ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་བྱིན་གྱིས་རློབ་པར་མཛད་པ།",
    "མཆོག་ཏུ་རྟག་པའི་རྣལ་འབྱོར་བདེ་བས་བདེ་བ་གྲུབ་པར་མཛོད།",
    "འགྲོ་བའི་རྒྱུད་ནི་རྣམ་པ་སྣ་ཚོགས་གདུལ་བར་གསལ་བར་མཁྱེན།",
    "རྣམ་པར་སྤྲུལ་ཧཱུྃ་རྣམ་པར་མཛོད།",
    "དེ་བཞིན་གཤེགས་པའི་དམ་པ་འགྲུབ་པར་མཛོད།",
    "དམ་ཚིག་དམ་པ་འགྲུབ་པར་མཛད་དུ་གསོལ།",
    "གང་དག་འགྲུབ་པར་མ་གྱུར་དང་།",
    "ཕྱག་རྒྱ་འདི་ཡིས་མཆོད་བྱས་པ།",
    "ཨཱ་བཛྲ་དྷཱ་ཏུ་ཛ་ཧཱུྃ་བཾ་ཧོ་བཛྲ་ཛྙཱ་ན་ཞེས་བྱ་བ་བརྒྱ་རྩ་བརྒྱད་བརྗོད་པར་བྱའོ།",
    "དེ་ནས་རིམ་པ་འདིས་གྲུབ་པའི་དཀྱིལ་འཁོར་ཕྱུང་ལ་གཞག་པར་བྱ་སྟེ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་སྤྱི་གཙུག་ནས་ཕྱུང་སྟེ་སྔ་མ་བཞིན་དུ་བཞག་ལ།",
    "སྔགས་བརྗོད་ནས་དེའི་མཐར་ཌི་ཌྷ་བཛྲ་ཏིཥྛ་ཞེས་བརྗོད་ལ་བརྟན་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་མུཥྚི་བཾ་ཞེས་བྱ་བ་ཕྱག་རྒྱ་དང་བཅས་པས་ཀྱང་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "གཟི་བྱིན་བསྐྱེད་པར་བྱ་བའི་ཕྱིར་དང་།",
    "དེ་ལྟར་ཇི་སྲིད་ལན་གཉིས་ལན་གསུམ་གྱི་བར་དུ་བྱས་ན་འདི་དག་ཐམས་ཅད་བརྟན་པར་འགྱུར་ཏེ།",
    "བག་ཆགས་ཙམ་དུ་ཡང་འགྲོ་བ་གཞན་ཡིན་པར་བསམ་པར་མི་བྱའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་དང་།",
    "ལས་ཀྱི་ཕྱག་རྒྱ་རྣམས་སྔ་མ་སྔ་མ་བརྟན་པར་བྱས་ལ་རིམ་གྱིས་བསྒྲུབ་པར་བྱའོ།",
    "དེ་ཉིད་ཀྱི་ཚིག་འདི་དག་ལེགས་པར་རྟོགས་ནས།",
    "བཅོམ་ལྡན་འདས་སྤྲོས་ནས་སྲིད་པ་གསུམ་པོ་མ་ལུས་པར་འབར་བ་ཀུན་དུ་བཀང་སྟེ།",
    "རྡོ་རྗེ་ལྕགས་ཀྱུའི་དྲིལ་བུ་འཛིན་ཅིང་སྨིན་མ་འདེགས་པར་བྱེད་པ་དང་།",
    "དཔྲལ་བའི་དབྱེས་བསྙེར་བས་རྣམ་པར་འཕྲོ་ཞིང་ཐུགས་རྗེས་གནོད་མཛེས་ལྟ་བུར་གཡོན་བརྐྱང་བའི་གནས་པར་བྱེད་པ་དང་།",
    "ས་བཅུ་ཡོངས་སུ་ཐོབ་པར་སྦྱང་བར་བྱས་ཏེ།",
    "རྡོ་རྗེ་དྲིལ་བུས་མཉེས་པར་བྱས་ཏེ།",
    "སྤྱན་དྲངས་ནས་མདུན་དུ་ཡང་དག་པར་བཞག་སྟེ།",
    "བརྟན་པར་བྱས་ནས་གནས་པར་གྱུར་པར་བསམ་པར་བྱའོ།",
    "དེ་ལ་དང་པོ་ཁོ་ནར་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་པོ་གཅིག་ཏུ་གཞུག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་བཞུགས་པའི་རིམ་པ་ཐམས་ཅད་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "དེ་དག་ཐམས་ཅད་ཀྱིས་བཅུ་གཉིས་པ་རྡོ་རྗེ་འཛིན་པའི་ས་ཉིད་ཤེས་པར་བྱ་སྟེ།",
    "ཐམས་ཅད་བདག་ཉིད་རྟག་ཏུ་བཞུགས།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པའི་ཕྱིར་རོ།",
    "མཉམ་པར་མ་བཞག་སྦྱོར་བ་ཡིས།",
    "དེར་ནི་སྤྱི་རྒྱུད་ལས་གསུངས་པའི།",
    "ཆོ་ག་མཁས་པས་བསྟན་པར་བྱ།",
    "དེའི་དབུས་སུ་པདྨའི་སྟེང་དུ་རྡོ་རྗེ་རྩེ་ལྔ་པ་སོར་བརྒྱད་པར་བྱ།",
    "དཔངས་དང་རྒྱར་སོར་བཞིའི་ཁ་ཁྱེར་ཀུན་ནས་བྱས་ལ།",
    "སྟེང་དུ་སོར་བརྒྱད་པ་ཙམ་གྱི་ཁ་ཁྱེར་དབྱིབས་མཉམ་པར་བྱས་ལ།",
    "མེ་ཏོག་སྣ་ཚོགས་དགྲམ་པར་བྱའོ།",
    "རྡོ་རྗེ་སྣ་ཚོགས་རྡོ་རྗེའི་དབུས་སུ་ཆུད་པའི་འཁོར་ལོའི་ཕྱག་རྒྱས་མཚན་པར་བྱའོ།",
    "ནུབ་དུ་ནི་དགུག་པའི་ཐབ་ཁུང་ལས་དང་རྗེས་སུ་མཐུན་པར་ཐབ་བརྐོ་བའམ།",
    "དགང་གཟར་ནི་གསེར་རམ་ཟངས་ཀྱི་རྒྱུ་ལས་བྱས་པའམ།",
    "ཕུབ་མ་ལ་སོགས་པ་ལས་དགྲ་བོའི་གཟུགས་བརྙན་བྱས་ལ།",
    "གཞན་ཡང་མེ་ཏོག་དང་བཅས་པར་བྱའོ།",
    "དེ་ནས་སྒྲུབ་པ་པོ་ཁྲུས་བྱས་ཤིང་ལུས་དྲི་ཞིམ་པོས་བསྒོས་པ།",
    "ནང་པར་ཁ་ཤར་དུ་བལྟས་ཏེ་བློས་བསྒྲུབ་པར་བྱ་བ་ལ་དམིགས་ནས་ཡར་གྱི་ངོའི་ཚེས་གཅིག་ནས་བརྩམས་ཏེ་ཞི་བའི་ཡིད་ཀྱིས་ཞི་བར་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བའི་གཟུགས་བརྙན་གྱི་བྲང་ལ་མནན་ཅིང་།",
    "སྟན་མེད་པར་རྐང་པ་གཡོན་པས་མནན་ཏེ།",
    "ཟངས་སམ་ཤིང་ངམ་ས་ལས་བྱས་པའམ།",
    "དུང་ཕོར་དང་ཉ་ཕྱིས་སམ་ལོ་མ་ལས་བྱས་པའི་མཆོད་ཡོན་གྱི་སྣོད་ལ་ནས་དང་བཅས་པའི་འོ་མ་དྲི་དཀར་པོ་ལ་སོགས་པ་དང་།",
    "ཆུ་རྣམས་ལས་ཇི་སྙེད་པ་ལས་ཀྱི་རྗེས་སུ་མཐུན་པར་གཞུག་པར་བྱའོ།",
    "དེ་དག་ཉིད་ལེགས་པར་བཟླས་པའི་ཆུ་ལག་པ་གཡས་པས་བླངས་པས་བསངས་ལ།",
    "རྫས་བཞག་པའི་ཚུལ་དུ་བྱས་པའོ།",
    "དེ་ནས་རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་སྔགས་དང་ཕྱག་རྒྱས་མེ་རྣམ་པར་སྦྱངས་ཏེ།",
    "བསྐོར་ཞིང་ལན་གསུམ་བསང་གཏོང་བྱས་པའི་ཐབ་དུ་གཙང་ཞིང་ཤིན་ཏུ་སྐམ་པའི་རྩ་བ་དང་བཅས་པའི་ཤིང་བཅུག་ལ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་བླ་འོག་ཏུ་བྱས་པའི་འདོད་པའི་རྒྱལ་བོའི་ཕྱག་རྒྱ་འདི་དང་།",
    "བསྲུང་བ་བྱས་ཏེ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ངེས་པར་བཙིར་བའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་ཕྱག་རྒྱ་དང་།",
    "ཡང་ལྕེ་ལ་རྡོ་རྗེ་དཀར་པོ་རྣམ་པར་བསམས་ལ།",
    "ཅེས་བརྗོད་པས་དམ་ཚིག་ལ་གཞག་པར་བྱའོ།",
    "འདིའི་ཕྱག་རྒྱ་ནི་རྡོ་རྗེ་སེམས་མ་བསྟན་པར་བྱས་ལ།",
    "དེ་ནས་རྡོ་རྗེ་བསྲུང་བ་བསྟན་པར་བྱས་ལ།",
