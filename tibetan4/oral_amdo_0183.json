    "འདི་མེད་ན་ནི་ཇི་ལྟར་ཡུལ་གྱིས་རང་གི་ཤེས་པ་ཁྱད་པར་དུ་མི་བྱེད་དེ།",
    "གང་ཞིག་གང་གི་རྣམ་པ་ཅན་དུ་རང་གི་ཤེས་པས་དམིགས་པ་དེ་དེའི་རྣམ་པ་ཅན་དུ་འགྱུར་ཏེ།",
    "དཔེར་ན་ལྐོག་ཤལ་ལ་སོགས་པ་དང་ལྡན་པའི་རྣམ་པ་ཅན་དུ་རང་གི་ཤེས་པས་དམིགས་པའི་བ་ལང་ནི་ལྐོག་ཤལ་ལ་སོགས་པ་དང་ལྡན་པའི་རྣམ་པ་ཅན་ཡིན་པ་བཞིན།",
    "ཡུལ་གྱི་ཤེས་པ་ཡང་ཡུལ་གྱི་རྣམ་པ་ཅན་དུ་རང་གི་ཤེས་པས་དམིགས་སོ།",
    "དཔྱོད་པའི་ཤེས་པ་ཡང་ཇི་ལྟར་བསམས་པའི་དོན་གྱི་རྣམ་པ་ཅན་དང་ཤེས་པའི་རྣམ་པ་ཅན་དུ་རང་གི་ཤེས་པས་དམིགས་སོ།",
    "དེ་ལྟར་འགྱུར་མོད་རྣམ་པ་མེད་པ་ཁོ་ནར་ཡུལ་གྱི་ཤེས་པ་སྐྱེ་སྟེ།",
    "དེ་ལྟར་ནི་ཕྱི་མ་ཕྱི་མའི་ཤེས་པ་ནི་རྣམ་པ་རེ་རེས་ལྷག་པར་ཉེ་བར་དམིགས་ཏེ།",
    "དེ་རྣམས་ཀྱི་རང་གི་ཡུལ་ཡང་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཁྱོད་ཀྱིས་བརྗོད་པའི་ཚུལ་གྱིས་དེ་ལྟར་འཛིན་པ་དེའི་ཕྱིར་དེ་རྣམས་རང་བཞིན་ཁོ་ནས་དེའི་རྣམ་པ་ཅན་རྣམས་སུ་འགྱུར་རོ་ཞེས་ཁས་བླང་བར་བྱའོ།",
    "གང་གི་ཕྱིར་དེའི་ཡུལ་གྱི་ཤེས་པ་དང་འབྲེལ་པ་ཅན་དེའི་སྒོ་ནས་འོངས་པ་ཡུལ་གྱི་རྣམ་པ་དང་ཉམས་སུ་མྱོང་བའི་རྣམ་པ་དག་དང་།",
    "གསུམ་པ་རང་སྣང་བའི་མཚན་ཉིད་ཅན་གྱི་རྣམ་པ་ཞེས་པ་གསུམ་པོ་འདི་རྣམས་རང་གི་ཤེས་པས་དམིགས་སོ།",
    "གང་ཞིག་གང་གི་རྣམ་པ་ཅན་དུ་རང་གི་ཤེས་པས་དམིགས་པ་དེ་ཞེས་པ་ལ་སོགས་པའི་སྒྲུབ་བྱེད་རྣམ་པར་ཤེས་པའོ།",
    "གང་གི་ཕྱིར་ཤེས་པ་གང་གི་ཡུལ་ཉེ་བར་གྱུར་པ་དེ་ལ་ཐེ་ཚོམ་སྐྱེ་སྟེ།",
    "ཤེས་པ་གང་ཞིག་གི་ཡུལ་རིང་བར་གྱུར་པ་དེའི་ཚེ་ནི་མེད་དོ་ཞེས་པས་ངེས་པར་གྱུར་པ་སྟེ།",
    "སྒྲའི་ཤེས་པ་བྱུང་གི་གཟུགས་ཀྱི་ཤེས་པ་ནི་མ་ཡིན་ནོ་ཞེས་གང་འདི་ཐ་དད་པར་དྲན་པ་དེ་མེད་པར་འགྱུར་རོ།",
    "དེ་ལྟར་འགྱུར་མོད་ཀྱི་ཇི་ལྟར་ཉམས་སུ་མྱོང་བའི་བདག་ཉིད་དུ་མཚུངས་པ་ལ།",
    "ཚོགས་པའི་བྱེ་བྲག་ལས་བདེ་བ་ལ་སོགས་པའི་བྱེ་བྲག་ཏུ་འགྱུར་བ་དེ་བཞིན་དུ་ཡུལ་སོ་སོ་ལ་ཚོགས་པ་གཞན་དང་གཞན་གྱིས་བྱས་པའི་ཁྱད་པར་ཕྲ་མོ་ཡོད་དེ།",
    "རེ་ཞིག་ཅེས་པ་ནི་འབའ་ཞིག་ལས་ཉམས་སུ་མྱོང་བ་ཡོད་དེ།",
    "དེའི་ཕྱིར་དྲན་པར་ཡང་འགྱུར་མོད།",
    "ཤེས་པ་གང་གིས་ཤེས་པ་ཉམས་སུ་མྱོང་བ་དེ་ལ་ཡང་དུས་ཕྱིས་དྲན་པ་མཐོང་ལ།",
    "ཤེས་པ་བརྒྱུད་པ་ཤེས་པ་ཕྱི་མ་ཕྱི་མ་ཤེས་པ་སྔ་མ་སྔ་མ་ལ་དམིགས་པ་མཐའ་ཡས་པ་རྣམས་སུ་ཐལ་བར་འགྱུར་རོ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ནི་འགྱུར་མོད་ཀྱི་ཤེས་པ་ཐ་མ་ནི་ཤེས་པ་གཞན་གྱིས་ཉམས་སུ་མྱོང་བར་བྱ་བ་ཉིད་དང་དྲན་པར་ཡང་མི་འགྱུར་གྱི།",
    "གང་ཞིག་གི་དམིགས་བྱེད་གང་ཡིན་པ་ལྐོག་ཏུ་གྱུར་པ་དེ་དེ་ཡིས་ཉམས་སུ་མྱོང་བ་མ་ཡིན་ཏེ།",
    "འདིར་འགྱུར་མོད།",
    "རེ་ཞིག་གྲགས་པ་ཙམ་གྱིས་ནི་དོན་ངེས་པར་མི་འགྱུར་ཏེ།",
    "སྐྱོན་དེ་རྣམས་ཁོ་ན་ཁོ་བོ་ཅག་གིས་རབ་ཏུ་གསལ་བར་བྱའོ་ཞེས་སྟོན་པ་གསུངས་པ།",
    "ཡུལ་གང་གིས་རྣམ་པར་ཤེས་པ་ཐ་སྙད་བྱ་བ་དེ་ཁོ་ན་ལས་གལ་ཏེ་དེ་སྐྱེ་ཞིང་གཞན་ལས་མ་ཡིན་ལ།",
    "དུ་བའི་ཤེས་པ་དང་འབྲེལ་བ་དྲན་པ་དག་ལས་ཀྱང་དེ་བྱུང་གི་མེ་ཁོ་ན་ལས་མ་ཡིན་པས་སོ།",
    "གལ་ཏེ་དེ་ལས་ཞེས་པ་འདིས་རྐྱེན་རྣམ་པ་བཞི་པོ་ཐམས་ཅད་ཀྱང་བརྗོད་པར་བྱ་ཞེས་པའི་དོན་གང་འདི་ནི་འདིར་ཁྱོད་ཀྱིས་ཡོངས་སུ་བརྟགས་པ་མ་ཡིན་ཏེ།",
    "གང་གིས་དམིགས་པའི་རྐྱེན་དང་འབྲེལ་པ་ཅན་ཉིད་ཀྱིས་ཤེས་པ་བསྟན་པར་བྱ་བ་དེ་དེ་ཁོ་ན་ལས་བྱུང་བ་མ་ཡིན་གྱི།",
    "འདིར་འགྱུར་མོད་ཀྱི་རྗེས་སུ་དཔག་པར་བྱ་བའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ནི་མེ་ཙམ་ལས་སྐྱེ་བ་མ་ཡིན་གྱི།",
    "དེས་ན་ཐལ་བར་འགྱུར་བ་འདི་ཅིའི་ཕྱིར་ཞེ་ན་གསུངས་པ།",
    "གལ་ཏེ་ཡང་དེ་དོན་གཞན་ལས་ཀྱང་སྐྱེ་མོད།",
    "དྲན་པ་ལ་སོགས་པ་རྣམས་ནི་དམིགས་པ་གང་གིས་ཐ་སྙད་བྱེད་པ་དེ་ལས་སྐྱེ་བ་ཡང་མ་ཡིན་ཏེ།",
    "ཡང་གི་སྒྲ་ལས་མེ་ལས་ཀྱང་དེ་འབྱུང་ངོ་ཞེས་བརྗོད་པར་འགྱུར་རོ།",
    "ཤེས་བྱ་ནང་གིར་སྨྲ་བ་རྣམས་དང་།",
    "རང་གིས་རིག་བྱ་བསྟན་བྱ་མིན།",
    "ཅི་གང་སྣང་བ་ཞེས་པ་འདིས་གཟུགས་ལ་སོགས་པའི་རྡུལ་ཕྲ་རབ་རྣམས་སོ་སོར་རང་གི་ངོ་བོས་སྣང་བ་མེད་པའི་ཕྱིར་དང་།",
    "ཇི་ལྟར་ཡོད་པ་ཞེས་པ་སྔོན་པོ་ལ་སོགས་པའི་རང་གི་མཚན་ཉིད་དུའོ།",
    "གལ་ཏེ་ཡང་རང་སྣང་བའི་རྣམ་པར་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་དེ་ལྟ་ནའང་ཞེས་པ་ཡང་གི་སྒྲའི་དོན་ཏོ།",
    "སོགས་པ་ཡང་ཚོགས་པའོ།",
    "དོན་དེ་ལས་ཞེས་པའི་མཚན་ཉིད་འདི་ལས་ཁྱོད་ཀྱི་ལུགས་ཀྱི་མངོན་སུམ་ཉིད་དུ་འགྱུར་རོ།",
    "རྫས་ལ་སོགས་པ་རྣམས་ལ་གང་ཤེས་པ་དེ་མངོན་སུམ་ཉིད་དུ་ཐལ་བ་མེད་དོ་ཞེས་པའི་དོན་ཏོ།",
    "དེའི་ཕྱིར་དེའི་ཤེས་པ་མངོན་སུམ་ཉིད་དུ་ཐལ་བ་མ་ཡིན་ལ།",
    "དེ་ལྟར་གྱུར་ན་རྡུལ་ཕྲ་རབ་རེ་རེས་དེ་ཐ་སྙད་བྱེད་པར་འགྱུར་ལ།",
    "དེའི་ཕྱིར་གང་གིས་དེའི་ཐ་སྙད་བྱེད་པ་ཞེས་པ་འདི་ཐོབ་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གང་གིས་དེ་ཐ་སྙད་དུ་བྱ་བ་དེ་ཁོ་ན་ལས་སྐྱེའོ་ཞེས་པས་སྔོན་པོ་ལ་སོགས་པའི་ཤེས་པ་རྣམས་མངོན་སུམ་ཉིད་དུ་གྲུབ་བོ་ཞེས་གསུངས་པ།",
    "དེས་ན་གང་གིས་དེའི་ཐ་སྙད་བྱེད་པ་ཞེས་པ་འདི་ཐོབ་པ་མ་ཡིན་ནོ་ཞེས་པ་ཐལ་བར་འགྱུར་བ་དེ་ཁོ་ནའོ།",
    "དེ་ལྟར་ནི་དོན་གང་གིས་ཤེས་པ་གང་ཐ་སྙད་བྱེད་པ་ནི།",
    "དེས་ན་གང་གིས་ཐ་སྙད་བྱ་བ་ཞེས་པ་དེ་མི་སྲིད་དོ་ཞེས་སྟོན་པར་གསུངས་པ།",
    "ཁྱོད་ཀྱིས་ཀྱང་གདོན་མི་ཟ་བར་འདི་ཁས་བླང་བར་བྱའོ།",
    "འདི་དེ་ལྟར་འགྱུར་མོད།",
    "རྣམ་པ་ཐམས་ཅད་དུ་རང་གི་རྣམ་པ་ཅན་གྱི་རྣམ་པར་ཤེས་པ་བྱེད་པར་བྱེད་པ་ཉིད་གཟུང་བྱ་ཉིད་དུ་འགྱུར་རམ།",
    "འོན་ཏེ་རྣམ་པ་འགའ་ཞིག་གིས་མ་ཡིན།",
    "གལ་ཏེ་བརྟག་པ་དང་པོ་ཡིན་ན་ཤེས་པ་ནི་རྣམ་པ་ཐམས་ཅད་དུ་དོན་གྱི་རང་བཞིན་ཉིད་ཐོབ་པའི་ཕྱིར་ཤེས་པ་མ་ཡིན་པ་ཉིད་དུ་ཐལ་ལོ།",
    "གང་གི་ཕྱིར་དེ་ལ་ཡང་ཤེས་པ་ཉིད་ལ་སོགས་པའི་རྣམ་པ་འགའ་ཞིག་གིས་རང་སྣང་བའི་ཤེས་པ་སྐྱེད་པ་ཡོད་པ་ཁོ་ནའོ་ཞེས་པའོ།",
    "གང་བདག་གི་ཡིད་དང་སྦྱར་བར་བྱ་བ་ཡིན་ཞིང་།",
    "ཡང་ན་ཤེས་པ་དེ་ཁོ་ན་རང་གི་ངོ་བོས་ཐ་སྙད་དུ་བྱ་བ་མ་ཡིན་པ་སྟེ་ངེས་པར་བསྟན་བྱ་མ་ཡིན་པའོ་ཞེས་པ་ཐ་སྙད་དུ་བྱ་བ་མ་ཡིན་པའོ།",
    "རང་གི་མཚན་ཉིད་ནི་མ་ཡིན་ཏེ།",
    "དུ་བ་ལ་སོགས་པ་རྣམས་ཀྱིས་སྔར་མཐོང་བ་དང་ཐུན་མོང་བར་མེ་ལ་སོགས་པ་རྗེས་སུ་དཔོག་པའི་ཕྱིར་རོ།",
    "དེ་ནི་ཐུན་མོང་མ་ཡིན་པའི་ཡུལ་ཅན་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ཅི་སྟེ་ཡང་ཡུལ་ཐ་སྙད་དུ་བྱ་བ་མ་ཡིན་པར་འགྱུར་མོད།",
    "མེད་མོད་ཀྱི་ཤེས་པ་ནི་ཐ་སྙད་དུ་བྱ་བ་སྟེ།",
    "དེ་ལས་ཀྱང་འཁྲུལ་པའི་ཕྱིར་ཐ་སྙད་དུ་བྱ་བ་མ་ཡིན་པ་ཉིད་ཀྱི་ཁྱད་པར་རིགས་སོ་ཞེ་ན་འདིར་ཡང་ཤེས་པ་དེ་ཁོ་ན་རང་གི་ངོ་བོས་གང་བསྟན་པར་བྱ་བ་མ་ཡིན་པ་དེ་ཐ་སྙད་དུ་བྱ་བ་མ་ཡིན་པ་ཉིད་དུ་རིགས་སོ་ཞེས་གསུངས་པ།",
    "ཤེས་པ་ཐམས་ཅད་ནི་ཐ་སྙད་དུ་བྱ་བ་མ་ཡིན་པའི་རང་གི་ངོ་བོ་ཁོ་ན་ཡིན་པས་ན།",
    "ཕྱོགས་ཅན་ལེན་པས་སྨྲ་བ་གང་གིས་རྟོགས་པར་བྱ་བ་བཞིན་པ་ཐ་སྙད་ཀྱི་ཆེད་དུ་འགྱུར་བ་ཤེས་པ་ལ་མཚུངས་པར་སྟོན་པའི་སྒྲ་མེད་དེ།",
    "ཐ་སྙད་ཀྱི་དུས་ན་ཡང་ཤེས་པའི་རང་གི་ངོ་བོ་ཐ་སྙད་དུ་བྱ་བར་མི་ནུས་པའི་ཕྱིར།",
    "རེ་ཞིག་ཡུལ་དེ་ཡང་རང་གི་ངོ་བོར་ཐ་སྙད་དུ་བྱ་བར་མི་ནུས་ན་ཅི་ཞིག་ལས་ཡང་དེས་གཞན་ཐ་སྙད་དུ་སྟོན།",
    "ཐ་སྙད་དུ་བྱ་བ་ལས་སྒྲ་ལས་བྱུང་བ་ཉིད་དུ་ཐལ་བར་འགྱུར་བ་ཡང་མ་ཡིན་གྱི།",
    "དེ་ཡང་ཤེས་པ་གང་ལ་རང་གི་ངོ་བོས་སྣང་བ་དེ་ལ་ལྟོས་ནས་འཁྲུལ་པར་འགྱུར་བ་མ་ཡིན་པ་ཁོ་ན་སྟེ།",
    "གང་གི་ཚེ་ཤེས་པ་དེ་ཁོ་ན་རང་ཉིད་མ་འཁྲུལ་པ་ཞེས་དེའི་སྐྱེས་བུ་ལ་ཕ་རོལ་པོ་རྣམས་ཀྱིས་བརྟེན་པ་དེའི་ཚེ་འདི་སྐད་སྨྲ་བར་བྱ་སྟེ།",
    "གཞན་ཡང་དོན་གཞན་ལ་རྣམ་པར་རྟོག་པ་ན་ཡང་མིག་གིས་གཟུགས་མཐོང་ལ།",
    "རང་གི་དོན་སྨོས་པ་ཙམ་གྱིས་མི་སྲིད་པར་སྟོན་ཏོ།",
    "འགའ་ཞིག་ཏུ་ཡང་གི་སྒྲ་མི་འདོན་ཏེ།",
    "དངོས་སུ་སྨོས་པ་ནི་རིང་པོའི་དོན་ཇི་ལྟ་བ་བཞིན་མ་ཡིན་པའི་ཤེས་པའི་འབྲས་བུ་ཅན་རྣམ་པར་གཅད་པར་བྱ་བ་ཉིད་ན་མངོན་སུམ་མེད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་གིས་གང་ལ་འཁྲུལ་པ་དང་སྲིད་པ་མེད་པ་དེ་དེའི་ཁྱད་པར་མ་ཡིན་ཏེ།",
    "དེ་ལ་འདིར་འགྱུར་མོད་མངོན་སུམ་གྱི་མཚན་ཉིད་དེ་ཁོ་ན་དེའི་རང་བཞིན་རབ་ཏུ་བསྟན་པ་མེད་པར་སྨྲ་བར་ནུས་པ་མ་ཡིན་ནོ་ཞེ་ན་གསུངས་པ།",
    "ཧ་ཅང་ཐལ་ལོ་ཞེས་སྟོན་པ་གསུངས་པ།",
    "གཞན་ཡང་ཐ་སྙད་དུ་ཡང་ཞེས་པ་མ་ཡིན་པ་འཁྲུལ་པ་མེད་པ་ཞེན་པའི་བདག་ཉིད་ཅེས་པ་འདི་ཙམ་མཚན་ཉིད་དུ་འགྱུར་མོད།",
    "མཚན་ཉིད་སྔ་མ་དོན་མེད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་མིག་དང་རྣ་བའི་རྣམ་པར་ཤེས་པ་དག་ཀྱང་མངོན་སུམ་ཉིད་དུ་འདོད་དེ།",
    "གཟུགས་དང་སྒྲ་དག་ཀྱང་དེ་ལྟ་བུའོ་ཞེས་འགལ་བས་ཁྱབ་པའི་ཐལ་བར་འགྱུར་བ་གསུངས་སོ།",
    "གཟུགས་སྨོས་པ་ནི་འདིར་མིག་གི་ཡུལ་ཉེ་བར་མཚོན་པའི་དོན་ཏོ།",
    "དེ་འགྱུར་མོད་ཀྱི་གཟུགས་ལ་སོགས་པ་རྣམས་གང་དུ་འཕྲོད་པ་འདུས་པའི་རྫས་དེ་ཆུང་ངུའམ་ཆེན་པོ་སྟེ།",
    "ཇི་ལྟ་བ་དེ་ལྟར་འགྱུར་མོད།",
    "མ་རྟོགས་པས་དོན་དམ་པའི་ཕྱོགས་ལ་བརྟེན་པས་ཕྱི་རོལ་དུ་འཇུག་པ་ཉིད་དུ་རེས་འགའ་ཕ་རོལ་པོས་རྟོགས་པར་བྱེད་དོ་ཞེས་པ་དེའི་ཕྱིར་དོགས་པར་རིགས་སོ།",
    "དེ་ལྟར་གྱུར་ན་རྐང་པ་ལ་སོགས་པས་གཟུགས་འཛིན་པར་ཐལ་ལོ།",
    "གང་གི་ཕྱིར་རྟེན་ལས་ཀྱང་རྣམ་པར་བཅད་པའི་དོན་ཞེས་འཛིན་ཏེ།",
    "མིག་དང་རྣ་བ་དག་ཀྱང་རང་གི་རྟེན་བཀབ་པ་ན་ཡུལ་འཛིན་པ་མེད་དོ།",
    "འོ་ན་མིག་གི་ནུས་མཐུའི་མཚན་ཉིད་འཇུག་པ་ནི་རྟེན་བཀབ་པ་ན་འཇིག་པའམ།",
    "མིག་གི་ངོར་གལ་ཏེ་འདི་ལན་ཡིན་ཞེས་སོ་སོར་རེ་བར་འགྱུར་ན་དེ་ཡང་དོར་ཅིག།",
    "གང་གི་ཕྱིར།",
    "མིག་གི་བདག་ཉིད་དུ་གྱུར་པའི་འོད་ཀྱི་ཆ་ཤས་ཅན་ནི་འཕོྲས་ནས།",
    "རྟེན་མ་ཡིན་ན་ཡང་བཀབ་པ་ན་དེའི་འཇིག་པ་དང་འཇུག་པ་དག་ཅིས་འགྱུར་ཞེས་པའམ་ཧ་ཅང་ཐལ་བའོ།",
    "དེའི་མཚན་ཉིད་ལས་མིག་གི་ཡིན་ཞིང་།",
    "དེ་ལ་འདིར་འགྱུར་མོད།",
    "གལ་ཏེ་ཡང་བདེ་བ་ལ་སོགས་པ་མངོན་སུམ་གྱི་ཡུལ་དུ་མི་འགྱུར་མོད།",
    "རང་གི་རྣམས་ནི་གང་གི་ཚེ་རྟགས་མེད་པའི་ཕྱིར་རྗེས་སུ་དཔག་པ་མེད་ལ།",
    "ཤེས་པ་ལས་དོན་གཞན་མ་ཡིན་པའི་འབྲས་བུ་སྨྲ་བའི་ཡང་ཇི་ལྟར་རང་གི་འདོད་པར་བསྟན་པ་བཞིན་ནོ་ཞེས་སེམས་པའོ།",
    "གཞན་དུ་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "རྟོག་པ་ཡང་རེ་ཞིག་སྲིད་པར་འགྱུར་རོ།",
    "མ་ཡིན་ཏེ་ཧ་ཅང་ཐལ་བའི་ཕྱིར་རོ་ཞེས་པ།",
    "གང་གི་ཆེད་དུ་སྦྱིན་པ་དེ་ཡང་དགོས་ཆེད་དེ།",
    "འདི་ཐམས་ཅད་ཀྱང་ཁྱད་པར་དུ་བྱ་བའི་ཤེས་པའི་རྒྱུ་ཉིད་ཀྱི་ཕྱིར་ཁྱད་པར་གྱི་ཤེས་པ་བཞིན་དུ་བྱེད་པར་ཐལ་ལོ་ཞེས་པའི་དོན་ཏོ།",
    "གང་གི་སྒྲ་ནི་གང་གི་ཞེས་དྲུག་པའི་མཐའ་ཅན་དུ་མཉན་པར་བྱ་བའོ།",
    "ཡང་གི་སྒྲ་ནི་ངེས་པར་གཟུང་བའི་དོན་ཏེ།",
    "གང་གི་ཚེ་སྣང་བ་ཞན་པའི་ཕྱོགས་སུ་བ་ལང་ལ་སོགས་པ་ཙམ་གྱི་ཁྱད་པར་འབའ་ཞིག་ཁོ་ན་ཡོངས་སུ་གཅོད་ཀྱི་གསལ་བའི་བྱེ་བྲག་ནི་མ་ཡིན་ཏེ།",
    "འདིར་ཡང་གཅིག་གི་གཉིས་ཀའི་ངོ་བོ་འགལ་བ་ཡོངས་སུ་སྤང་བའི་ཆེད་དུ་དཔེར་ན་ཞེས་པ་ལ་སོགས་པས་མཐོང་བའི་མཐའ་སྟེ།",
    "གང་གི་ཕྱིར་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་རྣལ་འབྱོར་རྫོགས་པ་ན་བདག་ཉིད་མཐོང་བ་རྣམས་ཀྱི་དེ་གཟུང་བྱར་ཡང་འགྱུར་ལ།",
    "དེ་ལྟར་གྱུར་ན་ཐལ་བར་འགྱུར་རོ་ཞེས་གསུངས་པ།",
    "དེ་ཡང་ཁྱོད་ཀྱིས་བདག་ཉིད་དཔེར་བརྗོད་པས་གཞུང་བཙུགས་སོ་ཞེས་པའོ།",
    "གང་ལ་གང་གི་རྩོལ་བ་ཙམ་གྱིས་ཤེས་པ་སྐྱེ་བ་དེ་ལ་དེའི་མི་ཤེས་པ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དཔེར་ན་ཤེས་རབ་ཅན་ཁ་ཅིག་གིས་བཟོའི་གནས་འགའ་ཞིག་ལ་བཞིན་འཇིག་རྟེན་གྱི་ཤེས་པ་ཡང་ཤེས་བྱ་འགའ་ཞིག་ལ་རྩོལ་བ་ཙམ་གྱིས་སྐྱེའོ།",
    "འབྲེལ་པ་འགའ་ཞིག་གིས་ཞེས་པ་ལ།",
    "འབྲེལ་པ་བྱེད་པའི་འདོད་པའི་བྱེ་བྲག་གིས་འབྲེལ་དུ་མ་རྣམས་ཏེ།",
    "འབྲེལ་པ་འགའ་ཞིག་གིས་ཞེས་སྨྲས་སོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་རྒྱུ་ཉིད་ཀྱི་ཕྱིར་ཞེ་ན།",
    "ཇི་ལྟར་བདག་ཉིད་མེ་ལ་སོགས་པ་རྗེས་སུ་དྲན་པ་དང་ལྡན་པའི་རྟགས་མངོན་སུམ་པ་མཐོང་ནས་མངོན་སུམ་མ་ཡིན་པའི་དོན་ལ་རྗེས་སུ་དཔག་པར་འགྱུར་བ་དེ་ལྟར་ཁྱད་པར་དྲན་པ་དང་ལྡན་པ་འདི་ཁོ་ནའི་སྤྱི་ཙམ་མཐོང་བ་ལས་གཟུང་བཞིན་པ་མ་ཡིན་པའི་ཁྱད་པར་རྣམས་ལ་ཐེ་ཚོམ་མོ་ཞེས་པ་ཐེ་ཚོམ་འགྲུབ་པ་ནི་རྟགས་ཅན་དང་མཚུངས་སོ།",
    "རྣམ་པར་བརྟགས་པ་ལས་གང་གི་ཚེ་ཁྱད་པར་གྱི་ངོ་བོས་དོན་ངེས་པར་འཛིན་པ་དེའི་ཚེ་འདི་ནི་བ་ལང་ཁོ་ན་ཡིན་གྱི་བ་མེན་ནི་མ་ཡིན་ནོ་ཞེས་གཏན་ལ་ཕེབས་པ་སྐྱེའོ།",
    "གང་གིའང་ཡུལ་ཉམས་སུ་མྱོང་བ་ཙམ་དགོས་པ་ཡིན་པ་དེ་རྣམ་པར་བརྟག་པ་ལ་ལྟོས་པ་མེད་པར་འཇུག་སྟེ།",
    "ཁྱད་པར་བསྒྲེ་བར་བྱེད་པ་དོན་མེད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྣམ་པ་ཐམས་ཅད་འཛིན་པར་ཐལ་ལོ་ཞེས་པ།",
    "གང་གི་ཚེ་ཕ་རོལ་རྣམས་མཐོང་བ་པོས་བལྟས་ནས་དོན་མཐོང་བ་ལས་སྔར་ཁོ་ནར་འདི་ཅི་ཞེ་ན་ཁྱད་པར་མེད་པར་འཛིན་པར་འདོད་པར་གྱུར་པ་ན།",
    "ཁོ་བོ་ཅག་གིས་ཕྲད་པ་དེའི་རྒྱུར་འདོད་པ་མ་ཡིན་ཏེ།",
    "འདི་ནི་རྟ་ཁོ་ན་ཞེས་པ་ལྟ་བུ་དེ་མངོན་སུམ་མོ་ཞེས་སྨྲས་པའི་ཕྱིར་རོ།",
    "འདི་ནི་རེག་པའོ་ཞེས་པའོ་ཞེས་ཀྱང་བརྗོད་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་མངོན་སུམ་ངེས་པའི་བདག་ཉིད་དུ་ཕ་རོལ་པོས་འདོད་པས་སོ།",
    "འདི་ཁོ་ན་ཡང་ངེས་པ་རྣམས་ཀྱི་རང་གི་དོན་རྟོགས་པ་སྟེ།",
    "མངོན་སུམ་ནི་གང་གིའང་ངེས་པར་བྱེད་པའི་བདག་ཉིད་མ་ཡིན་ཏེ།",
    "བདག་གི་ཕ་འོང་ངོ་ཞེས་སྔོན་ལ་ངེས་པར་འགྱུར་གྱི།",
    "གང་འདི་ལྟར་འདོད་པ་ལའོ་ཞེས་པ་ཤིན་ཏུ་ཐལ་ཆེས་པས་ཆོག་གོ།",
    "གང་གི་ཕྱིར་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "རང་གི་དོན་ཙམ་འཛིན་པ་ཉིད་ཀྱི་ཕྱིར་ཞེས་པ་འདི།",
    "དེའི་རང་གི་ངོ་བོ་སྟོན་པར་བྱེད་པ།",
    "གང་གི་ཕྱིར་བྱ་བ་དང་རྫས་ཀྱི་ངོ་བོས་རྟེན་རྟོགས་པ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "རྫས་ཀྱང་དེ་ལྟ་བུའོ་ཞེས་ཁྱབ་བྱེད་དང་འགལ་བའི་ཐལ་འགྱུར་རོ།",
    "བལྟ་བར་བྱ་བ་དང་རེག་པར་བྱ་བ་ཡང་རྫས་སོ་ཞེས་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "འགྱུར་མོད།",
    "ཡོད་པ་དང་ཡོན་ཏན་ཉིད་དག་ལྟ་བུ་ཞེས་པ་འདིས་ཀྱང་ཡོད་པ་དང་ཡོན་ཏན་ཉིད་དག་གིས་མ་ངེས་པར་སྨྲས་སོ།",
    "ཐ་མི་དད་པའི་ཤེས་པ་ནི་སླར་ཡང་གང་ཁོ་ན་བདག་གིས་མཐོང་བ་དེ་ཁོ་ན་རེག་གོ་ཞེས་པ་སྟེ།",
    "གཅིག་གིས་དོན་དུ་མ་ནི་མ་ཡིན་ཞིང་།",
    "རང་གི་དོན་ལ་ཡང་ཐ་དད་ན་ཡང་སྔོན་པོ་ལ་སོགས་པ་བཞིན་ཏེ།",
    "གཟུགས་ལ་སོགས་པ་བཞིན་རྫས་ཀྱང་དེ་ལྟ་བུའོ་ཞེས་ཁྱབ་བྱེད་དང་འགལ་བའི་ཐལ་འགྱུར་གསལ་བར་བྱེད་དོ།",
    "དེའི་ཚེ་ཇི་ལྟར་སྔོན་པོ་ལ་སོགས་པ་རྣམས་མིག་གི་སྤྱོད་ཡུལ་ཉིད་ཀྱིས་ཐ་མི་དད་པར་དེ་ལྟར་གཟུགས་དང་རེག་བྱ་དག་ཀྱང་འགྱུར་རོ།",
    "དེ་ལས་ཀྱང་རེག་བྱ་ཡང་མིག་གིས་འཛིན་པར་འགྱུར་རོ།",
    "གང་ལས་མིག་གིས་མི་འཛིན་པ་ཞེས་པ།",
    "རེག་བྱ་བཞིན།",
    "འདི་ཁོ་ནའི་བསྒྲུབ་པར་བྱ་བ་ལས་བཟློག་པ་ལ་མི་འདོད་པར་ཐལ་བར་གྱུར་པ་གསུངས་པ།",
    "དེ་ལས་ཀྱང་རང་གི་དོན་ཉིད་ཀྱི་ཕྱིར་དེ་རེག་བྱ་དང་རོ་ལ་སོགས་པའི་དབྱེ་བས་ཐ་དད་ཀྱང་སྔོན་པོ་ལ་སོགས་པ་བཞིན་དུ་མིག་གིས་གཟུང་བར་བྱའོ་ཞེས་པ་འདིའི་ཕྱིར་ན།",
    "རང་གི་བྱེ་བྲག་ལ་ངེས་པར་བྱེད་པ་རྣམས་སོ་ཞེས་པ་རང་གི་ཁྱད་པར་ལ་ངེས་པར་བྱེད་པ་རྣམས་ཏེ།",
    "རྫས་ནི་རེག་བྱེད་དང་མིག་གིས་འཛིན་པར་མི་འགྱུར་ལ།",
    "ལྷག་མ་རྣམས་མིག་གིས་སོ་ཞེས་སྦྱར་བར་བྱའོ།",
    "དེ་མེད་པའི་ཕྱིར་རེག་པ་ཉིད་ལ་སོགས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེས་ཀྱང་རེག་བྱ་ཉིད་ལ་སོགས་པ་མེད་པས་གཟུགས་ཉིད་ཡོད་པར་མཚོན་པར་བྱའོ།",
    "གཞན་ཡང་རང་གི་བྱེ་བྲག་རྣམས་ཀྱི་སྐབས་ཉིད་ཀྱི་ཕྱིར།",
    "འགྱུར་མོད་ཅེས་པ་ལ་སོགས་པ་གང་སྨྲས་པའོ།",
    "གང་བདག་གིས་མཐོང་བ་དེ་ཁོ་ན་རེག་པའོ་སྙམ་པ་ཐ་དད་པ་མེད་པའི་ཤེས་པ་འདིའི་ཡུལ་ཅི་ཡིན།",
    "གཟུགས་དང་རེག་བྱ་ཡང་ཕན་ཚུན་ལས་བཟློག་པའི་ཡུལ་ཉེ་བར་དམིགས་པ་དང་ལྡན་པ་ལས་དེ་སྐྱེའོ།",
    "དེ་ལྟར་གཟུགས་དང་རེག་བྱ་དག་ལྷན་ཅིག་སྤྱོད་པ་ཉེ་བར་མཚོན་པ་ཉིད་དུ་གྱུར་ན་ཡང་དྲི་ལ་སོགས་པ་ཚོགས་པ་ཙམ་ཡུལ་ཉིད་དུ་བརྗོད་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "གཟུགས་ལ་སོགས་པ་གང་རྣམས་ལ་ཉམས་སུ་མྱོང་བ་སྔོན་དུ་འགྲོ་བའི་བུམ་པ་ཞེས་པའི་བརྡ་ཡིན་པ་དེའི་ཚོགས་པ་ལ་སླར་ཡང་ཕྱི་མའི་དུས་སུ་གཟུགས་དང་རེག་པ་ཉེ་བར་དམིགས་པ་དང་ལྡན་པ་པོའི་དྲན་པ་སྟེ།",
    "གང་ཚོགས་པ་ནི་དངོས་པོ་མ་ཡིན་པའི་ཕྱིར་ཤེས་པ་འགའ་ཞིག་གིས་ཀྱང་ཉམས་སུ་མྱོང་བ་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་ཚོགས་པ་ནི་བརྟགས་པ་ཡིན་ལ་གང་ཡང་བརྟགས་པའི་དངོས་པོ་དེ་ནི་རྣམ་པར་ཤེས་པའི་གཟུང་བའི་ཆ་ཤས་ཉིད་ཀྱིས་བདག་ཉིད་དུ་གྱུར་པའོ་ཞེས་པ་རང་རིག་པ་ཁོ་ནས་ཉམས་སུ་མྱོང་བས་སོ།",
    "ཡོད་པ་དང་ཡོན་ཏན་ཉིད་དག་གིས་སྔར་མ་ངེས་པར་བརྗོད་པ་དེ་ཡོངས་སུ་སྤང་བའི་ཆེད་དུ་ཉེ་བར་བཀོད་པ་སྟེ།",
    "རང་གི་རྣམ་པ་ཐ་མི་དད་པ་ཡང་འདི་རྣམས་ལ་ཞེན་ཏེ།",
    "མི་འདོད་པ་ལ་ཐལ་བར་འགྱུར།",
    "ཞེས་པ་ཐལ་འགྱུར་གྱི་ཟོལ་གྱིས་མ་ངེས་པ་ཉིད་དུ་གསུངས་སོ།",
    "དེའི་ཕྱིར་འདི་ཐལ་བར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "གང་གི་ཚེ་ཡང་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "གང་གི་ཚེ་འདི་མིག་གིས་མཐོང་ནས་མེ་འདི་དྲོ་བའོ་ཞེས་འཛིན་པ་དེའི་ཕྱིར་དེའི་ཚེ་རེག་བྱ་ཡང་མེའི་ཁྱད་པར་ཉིད་ཀྱི་ཕྱིར་མིག་གིས་གཟུང་བར་བྱ་བར་འགྱུར་ལ།",
    "དེ་ལྟར་འགྱུར་མོད་མ་ངེས་པའོ་ཞེས་པ་འདིས་གཏན་ཚིགས་འཁྲུལ་པར་བརྗོད་པ་མ་ཡིན་གྱི།",
    "རང་གི་རྟེན་ཅན་ནི།",
    "ཡོན་ཏན་དང་ལས་དག་གི་རང་གི་སྤྱི་སྟེ།",
    "གང་གི་རྟེན་རང་ཉིད་ཡིན་པ་དེ་རང་གི་རྟེན་ཅན་ཏེ།",
    "གཞན་རྣམས་ན་རེ་ཡིད་ཀྱིས་བྱིན་གྱིས་བརླབས་པ་ཞེས་པ།",
    "རང་གི་ཡུལ་ཉེ་བར་གྱུར་པ་ན།",
    "འདི་ཡང་བདག་གི་ངོ་བོ་ཡིན་གྱི་གཞན་འགའ་ཞིག་གི་མ་ཡིན་ཏེ།",
    "སྒྲ་དང་རེག་བྱ་དང་གཟུགས་དང་རོ་དང་དྲི་རྣམས་ལས་རིམ་པ་ཇི་ལྟ་བར་ཞེས་པ་འདིས་རང་གི་ཡུལ་ལ་ངེས་པར་འཇུག་པར་བརྗོད་པ་ལས་ཡུལ་ངེས་པ་ཉིད་དོ།",
    "དེས་ཡོངས་སུ་རྫོགས་པ་ནི་ནང་གི་འཛིན་པའོ་ཞེས་སོ།"
