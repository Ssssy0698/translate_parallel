    "བློ་བཟང་རང་ལུགས་སྨྲ་བའི་སེང་གེ་ལ།",
    "ས་གནས་གཞན་དང་གཞན་དུ་འགྲོ་བར་དཀའ་ངལ་ཤུགས་ཆེན་འཕྲད་མུས་ཡིན་འདུག་ལ།",
    "ཅེས་དྲིལ་བསྒྲགས་ཤུགས་ཆེན་བྱེད་བཞིན་འདུགཕྱི་ལོ་༢༢ ཟླ་༡ པའི་ནང་རྒྱ་ནག་གཞུང་ནས་སྤེལ་བའི་གནས་ཚུལ་ནང་།",
    "དེ་བཞིན་བཙོན་འཇུག་དུས་ཡུན་མ་རྫོགས་སྔོན་ལ་རང་ཁྱིམ་དུ་བཏང་སྟེ་ཉིན་ཤས་ཀྱི་རྗེས་དང་།",
    "ཁོང་ལ་མྱ་ངན་དང་གདུང་སེམས་མཉམ་སྐྱེད་བྱེད་བཞིན་འདུག་ལ།",
    "ཞེས་བརྗོད་འདུག་པ་དང་།",
    "ཁྱིམ་ཚང་སོགས་ཀྱི་ནང་དུ་མགོ་འཁྲིད་ཚོའི་འདྲ་པར་བཤམ་དགོས་པའི་བཙན་འཛུལ་བྱེད་ཀྱི་ཡོད་འདུགཁ་སང་ཕྱི་ཚེས་༡༣ ཉིན།",
    "ཁོ་ཚོའི་བསམ་པར་ཅ་ལག་ཅིག་དུས་གཏན་དུ་གཞན་ཞིག་དང་བརྗེ་བོ་བརྒྱབ་ན་ནུས་པ་ཆེན་པོ་ཞིག་འཐོན་རྒྱུ་ཡོད་པར་ཡིད་ཆེས་བྱེད་ཀྱིན་ཡོད།",
    "ཕྱི་ལོ་༢༡༤ ཟླ་༣ ཚེས་༡༩ ཉིན་རང་ལོ་༢༣ ཡིན་པའི་བོད་ཀྱི་ཆབ་སྲིད་བཙོན་ཟུར་སྒོ་ཤུལ་བློ་བཟང་ལགས་ཀྱང་རང་ཁྱིམ་དུ་སྐུ་གྲོངས་ཡོད་པ་དང་།",
    "འདས་ལོའི་ཕྱི་ཟླ་༧ དང་༨ ཡས་མས་ཤིག་ལ་རང་སྲོག་བཅད་ཡོད་ཚོད་འདུག་ཀྱང་།",
    "དེ་བཞིན་ཁྱིམ་མིའི་གནས་སྟངས་སོགས་ཁ་གསལ་མེད་པས་མུ་མཐུད་རྩད་གཅོད་གཏོང་བཞིན་འདུག་ལ།",
    "ཞེས་གསུངས་འདུགཡང་འབོད་སྐུལ་ཞུ་ཡིག་དེའི་ནང་།",
    "ཁོང་རང་གཙང་ཞིང་དྲི་མ་མེད་པ།",
