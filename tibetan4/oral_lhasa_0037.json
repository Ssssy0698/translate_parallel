    "རྟག་པ་དང་བྱས་པ་ལྟ་བུའི་ཁྱབ་བྱེད་དང་འགལ་བ་གཉིས་ཏེ།",
    "སྔོན་པོ་ལ་རྟག་པ་མ་དམིགས་པས་དེ་གཉིས་འགལ་བར་ངེས་ཏེ་དེ་ལ་དེ་དམིགས་ན་ཕན་ཚུན་མེད་པར་མི་འགྲུབ་པས་སོ།",
    "འགལ་བ་གཉིས་ཐ་དད་མེད་པར་འགྱུར་ཏེ།",
    "གསུམ་པ་དེ་དག་སྣང་རུང་མ་དམིགས་པར་བསྡུ་བ།",
    "གལ་ཏེ་མེའི་འབྲས་བུས་གྲང་མཛོད་བ་ཁེགས་ན་མེའི་རྒྱུས་ཀྱང་གྲང་བ་ཁེགས་པར་འགྱུར་རོ་ཞེ་ན།",
    "ལན་ནི་འགལ་འབྲས་ལ་ཡང་ཞེས་པ་སྟེ་དུ་བ་ཡོད་ཙམ་གྱིས་མི་ཁེགས་ཀྱང་དུ་བ་ཁྱད་པར་ཅན་ཡོད་པའི་དུས་དང་།",
    "རྟགས་གསུམ་དུ་གྲངས་ངེས་ན་ཚོགས་པ་ཚང་བས་འབྲས་བུ་དཔོག་པར་བྱེད་པ་རྟགས་མིན་པར་འགྱུར་ཏེ།",
    "འདོད་པར་ཡང་མི་ནུས་ཏེ།",
    "དང་པོ་རྒྱུ་ཚོགས་པས་འབྲས་བུ་སྐྱེད་སྲིད་པར་དཔོག་པ་རང་བཞིན་དུ་བསྡུ་བ་ནི།",
    "འདི་ལྟར་རུང་བ་ནི་རྒྱུའི་དོན་གཞན་ལ་མི་ལྟོས་པར་ཚོགས་པ་ཡོད་ཙམ་དང་རྗེས་སུ་འབྲེལ་བས་སོ།",
    "དངོས་སུ་དཔོག་ན་མ་ངེས་པར་བསྟན་པ་ནི།",
    "རོ་ལས་གཟུགས་རིགས་རྟོགས་པ་རྟགས་མིན་པར་འགྱུར་ཏེ་གསུམ་དུ་མ་འདུས་པའི་ཕྱིར་ཞེ་ན།",
    "ནུས་པ་འཇུག་པ་མེད་པར་ནི།",
    "དེས་ན་ཆར་བབས་ཟིན་དང་འབབ་བཞིན་པ་མི་དཔོག་ལ་འབབ་པར་ངེས་པའང་མིན་ཏེ་རྒྱུ་ལ་གེགས་སྲིད་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་ལྟར་ན་དེ་རྟག་པར་འགྱུར་། ལ།",
    "ནུས་པ་གཏན་མེད་སྲེད་པར་འགྱུར་བས་སོ།",
    "ཆེ་བར་གྱུར་ན་གཞན་ལ་མ་ལྟོས་པར་དེ་ཉིད་ཀྱིས་ནུས་པར་འགྱུར་བས་འབྲས་བུ་བསྐྱེད་པར་འགྱུར་རོ།",
    "གཉིས་པ་འབྲས་བུའི་སྤྱིས་རྒྱུའི་ཁྱད་པར་དཔོག་པ་ལྷག་ལྡན་དུ་བསྟན་པ་ནི།",
    "འདོད་པར་མི་ནུས་ཏེ།",
    "མི་མཐུན་ཕྱོགས་ལ་རྟགས་མ་མཐོང་ཙམ་གྱིས་མ་དམིགས་པ་འདིས་འཁྲུལ་པ་མེད་པ་མིན་ཞེས་པ་དེ་ལ་རྟགས་མེད་པར་མི་འགྲུབ་ཅེས་པའོ།",
    "རྒྱུ་ཁྱད་མེད་ལ་འབྲས་བུའི་ཁྱད་པར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "དེས་ན་མི་མཐུན་ཕྱོགས་རིགས་འགའ་ཞིག་ལས་ལྡོག་པར་ངེས་ཀྱང་འགའ་ཞིག་ལས་ལྡོག་པར་མ་ངེས་ན་ལྷག་ལྡན་ཞེས་བྱ་སྟེ།",
    "སློབ་དཔོན་རྟགས་ལ་འབྲེལ་པ་བཞེད་པར་བསྟན་པ་དང་།",
    "བརྗོད་པར་མཛད་ཅེས་དྲང་ངོ།",
    "དེ་དག་ནི་ཕྱོགས་དང་མཐུན་ཕྱོགས་ཡིན་པས་དེ་དག་ལ་རྟགས་མཐོང་ཡང་མ་ངེས་པར་མི་འགྱུར་ལ་འབྲས་བུ་གཞན་དང་རྡོ་བ་ལ་སོགས་པ་ལ་རྟགས་གཉིས་པོ་མ་མཐོང་བའི་ཕྱིར་རོ།",
    "འདིར་རོ་ལ་སོགས་པ་ཕྱོགས་སུ་བྱས་པ་ལ་མངོན་སུམ་གྱིས་གནོད་པ་མི་སྲིད་དེ་རོ་ལྐོག་གྱུར་ཡིན་པའི་ཕྱིར་རོ།",
    "ལྐོག་གྱུར་ལ་ཡང་གལ་ཏེ་ན་མངོན་སུམ་གྱིས་གནོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ལྟར་ན་ཕྱོགས་སྐྱོན་མེད་མི་སྲིད་པར་འགྱུར་ཏེ་ཁྱེད་ལྟར་ན་འབྲེལ་པ་ཁས་མི་ལེན་པས་དོགས་པ་དེ་མི་ལྡོག་པའི་ཕྱིར་རོ།",
    "ཞེས་གསུངས།",
    "དེས་ན་རྣལ་འབྱོར་པའི་མངོན་སུམ་གྱིས་དེ་ལ་གནོད་པར་དོགས་པར་བརྗོད་ན་དམ་བཅའ་སྐྱོན་མེད་མི་སྲིད་ཅེས་པར་ཡང་གསལ་ལོ།",
    "དེ་ལ་སྲོག་ལ་སོགས་པ་ཡོད་པར་གྲུབ་པས་བདག་ཡོད་ཅེས་པའི་སྦྱོར་བ་འདི་ཡང་རྟགས་སུ་འགྱུར་ཏེ་མ་མཐོང་བ་ཙམ་གྱིས་ལྡོག་པ་ཡོད་པའི་ཕྱིར་རོ།",
    "དེས་ན་དེ་ལ་རྟགས་མཐོང་ཡང་ལྡོག་པ་མེད་པར་མི་འགྱུར་རོ།",
    "འོ་ན་དེ་དག་བདག་མེད་པར་ཅིས་གྲུབ་ཅེ་ན།",
    "འདི་ལྟར་བུམ་སོགས་བདག་མེད་པར་མ་གྲུབ་ན་དེ་ལ་སྲོག་མ་མཐོང་ཡང་མི་མཐུན་ཕྱོགས་ལ་མ་མཐོང་བར་མི་རུང་ངོ།",
    "ཇི་ལྟར་ཞེ་ན་མ་གྲུབ་པ་བཞི་དཔེ་དང་བཅུ་དགུ་རྗེས་སུ་འགྲོ་ལྡོག་གཉིས་དོན་དུ་བྱས་ནས་ཁྱབ་པ་ལ་ཐེ་ཚོམ་ཟ་བ་ལྟར་སྣང་དུ་བསྟན་པའོ།",
    "དེ་བཞིན་དུ་མཐུན་པའི་ཕྱོགས་ལ་ཡོད་པ་དང་མེད་པ་ལ་སོགས་པ་ལ་ཡང་ཅི་རིགས་པར་བརྗོད་པར་བྱའོ།",
    "དེས་ན་མ་གྲུབ་པ་བཞི་དང་དཔེ་དོན་སྦྱར་ནས་ཅི་རིགས་པར་ལྟར་སྣང་དུ་བསྟན་པ་འདི་བརྗོད་པཔར་བྱ་བ་མིན་པར་འགྱུར་ཏེ་མ་མཐོང་ཙམ་གྱིས་ལྡོག་པ་རྟགས་སུ་འདོད་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་འདོད་དེ་ཅི་རིགས་པ་ལྟར་སྣང་དུ་བརྗོད་པར་བྱའོ་ཞེས་འུ་ཡུག་སྨྲོས་པས་སོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་མཉན་བྱ་རྟག་པ་ཁོ་ན་ལས་ལྡོག་པར་འགྱུར་ཏེ་དངོས་པོ་ཡིན་པའི་ཕྱིར་རོ།",
    "མཉན་བྱས་གཉིས་ཀ་འགོག་པ་མི་སྲིད་དེ།",
    "ཡུལ་ཞེས་པ་སྟེ་འབྲས་བུ་འདི་དག་ནི་རོ་དང་ནུས་པ་དང་སྨིན་པ་ཁྱད་པར་ཅན་ཡིན་ཏེ།",
    "ཅི་ཞེ་ན་རོ་དང་ནུས་པ་སྨིན་པར་བྱེད་པ་ལ་སོགས་པའོ།",
    "ད་ཅིས་ཞེ་ན་འགྲེལ་ཡུལ་དང་སོགས་པས་བསྡུས་པ་དུས་དང་སོ་ནམ་ལེགས་པར་བྱ་བ་གསུམ་ལ་སོགས་པའི་རྒྱུ་ལ་ཁྱད་པར་ཡོད་པའི་ཕྱིར་རོ།",
    "ཨ་སྨྲ་གཅིག་ལ་རོ་ཁྱད་པར་ཅན་མཐོང་རིགས་བས་རོ་དེ་གཞན་ལའང་ཡོད་དོ་ཞེས་དཔག་པར་རིགས་པ་མིན་ནོ།",
    "སོགས་པ་སྟེ་གྲངས་ཅན་པ་འོ་མ་ལ་སོགས་པའི་རྒྱུ་ལ་ཞོ་ལ་སོགས་པའི་འབྲས་བུ་ཡོད་པར་འདོད་པའོ།",
    "རྒྱུ་ལ་ཉེར་གཅིག་འབྲས་བུ་ཡོད་དེ་དེ་བསྐྱེད་པའི་ནུས་པ་ཡོད་པའི་ཕྱིར་རོ་ཞེས་པས་ཀྱང་དེ་དག་སྒྲུབ་མི་ནུས་པར་ཤེས་པར་བྱའོ།",
    "དགག་རྟགས་ཀྱི་ཁྱབ་པ་འབྲེལ་པ་ལ་ལྟོས་པར་བསྟན་པའོ།",
    "ངེས་པར་དེ་ཁྱབ་པར་མི་འདོད་པ་ཡིན་གྱི་འགའ་ཞིག་ལ་ཡོད་དེ་དུ་བས་མེ་སྒྲུབ་པའི་ཚེ་ཆུ་ཀླུང་བཞིན་ནོ།",
    "རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་དེ་ལས་བྱུང་བར་ངེས་པར་བྱེད་པ་དང་།",
    "དེ་བྱུང་དང་བདག་གཅིག་པའི་འབྲེལ་པར་ངེས་བྱེད་དོ།",
    "ངེས་པར་ཡོད་པའི་ངེས་པ་གང་ཞེས་པ་འདིར་ཡང་དྲང་ངོ།",
    "འོ་ན་ཁྱེད་འཇིག་པ་རྒྱུ་གཞན་ལ་མི་ལྟོས་པར་འདོད་ཀྱང་འཇིག་པ་རྒྱུ་གཞན་དུ་འགྱུར།",
    "དངོས་པོ་ཡོད་པ་དང་འཇིག་པར་བྱེད་པར་ཡང་འགལ་བའི་ཕྱིར་ཞེ་ན།",
    "མི་འགལ་ཏེ་དངོས་པོ་དེ་ཉིད་སྐད་ཅིག་གཉིས་པར་མི་སྡོད་པའི་ཕྱིར་རོ།",
    "འོ་ན་དངོས་པོ་མངོན་སུམ་གྱིས་གྲུབ་པ་བཞིན་སྐད་ཅིག་ཀྱང་དེས་འགྲུབ་པར་འགྱུར་ལ།",
    "འདོད་ན་རྟགས་ལ་མི་ལྟོས་པར་འགྱུར་རོ་ཞེ་ན།",
    "གལ་ཏེ་དུ་བ་མེ་ལ་མི་འཁྲུལ་བ་ཉིད་དུ་མི་རྟོགས་པར་འགྱུར་ཏེ།",
    "མེའི་འབྲས་བུ་མིན་པར་འགྱུར་ཏེ་མེ་དེ་མེད་པར་ཡང་དུ་བ་དེ་ཡོད་པའི་ཕྱིར་རོ།",
    "མ་ངེས་ན་འབྲས་བུའི་གཅིག་དང་ཐ་དད་རྒྱུའི་རིགས་གཅིག་དང་ཐ་དད་ཀྱི་རྗེས་སུ་མི་བྱེད་པར་འགྱུར།",
    "མ་ཡིན་ཏེ་དུ་བ་ཁྱད་པར་ཅན་གྱི་རྒྱུན་ནི་མེ་ཁྱད་པར་ཅན་གྱི་རྒྱུན་གྱི་འབྲས་བུ་ཡིན་པས་དེས་དེ་རྗེས་སུ་དཔོག་པའོ།",
    "དེས་ན་རྟགས་སུ་རུང་བའི་དུ་བའི་རྒྱུན་ཁྱད་པར་ཅན་དང་།",
    "བྱས་ཡོད་ལ་འཇིག་པས་ཁྱབ་པ་སྒྲུབ་པའོ།",
    "དེས་ན་མི་རྟག་པ་དེ་མེད་ན་བྱས་པའམ་ཡོད་པའི་བདག་ཉིད་ཀྱང་མེད་པར་འགྱུར་ཏེ་དེ་དག་ཐ་དད་མེད་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་ཐམས་ཅད་རིགས་ལྡོག་པ་དང་ལྡན་པར་བསྟན་པ་དང་།",
    "དེ་ཡང་གྲངས་ཅན་ནི་སྤྱི་དང་བྱེ་བྲག་གཅིག་ཏུ་འདོད་ལ་རིག་པ་ཅན་ཐ་དད་དུ་འདོད་ཀྱང་སྤྱིའི་སྒོ་ནས་གཅིག་ཏུ་འདྲེས་ཞེས་ཟེར་ཏེ་འདི་དག་དགག་པ་འགྲེལ་པར་ཤེས་པར་བྱའོ།",
    "ཐམས་ཅད་མ་འདྲེས་པ་དེའི་ཕྱིར་རྟག་པ་དང་མ་བྱས་པ་ལ་སོགས་པ་གང་དང་གང་ལས་བུམ་པ་ལ་སོགས་པའི་དོན་དེ་ལྡོག་གོ།",
    "དེ་ལ་བརྟེན་ནས་དབྱེ་བ་དེའི་ཁྱད་པར་ཏེ་བྱེ་བྲག་བྱས་པ་དང་མི་རྟག་པ་ལ་སོགས་པ་རྟོགས་འགྱུར་བ་ཞེས་པ་རྟོགས་བྱ་ཉེར་དྲུག་རྟོགས་བྱེད་ཐ་དད་ཀྱི་ཐ་སྙད་མཁས་པ་རྣམས་ཀྱིས་བྱེད་དོ།",
    "རྟགས་དང་རྟགས་ཅན་ཐ་དད་དུ་རྣམ་པར་གནས།",
    "མེད་པའི་སྒྲ་རྟོག་སེལ་བ་ལ་འཇུག་པར་སྒྲུབ་པའོ།",
    "སེལ་བ་ལ་འཇུག་པར་སྒྲུབ་པ་དང་།",
    "དེའི་དཔེ་གང་ཞེ་ན་ཉ་ཕྱིས་ཀྱི་རྣམ་པ་ལ་དངུལ་གྱི་རྣམ་པར་སྒྲོ་འདོགས་པ་ལྟ་བུའོ།",
    "ཉ་ཕྱིས་ལ་དངུལ་དུ་འཁྲུལ་པ་ནི་ཉ་ཕྱིས་ཀྱི་གཟུགས་ཁྱད་པར་ཅན་མཐོང་བས་དེར་འཁྲུལ་པ་མིན་གྱི་དངུལ་ལ་ཡོད་པའི་གཟུགས་ཀྱི་སྤྱི་ཉ་ཕྱིས་ལ་མཐོང་བས་འཁྲུལ་ཞེས་ཟེར་རོ།",
    "འོན་ཀྱང་མཐོང་བ་དེ་ཉིད་ལ་སྒྲུབ་པ་སྟེ་འཁྲུལ་པ་སེལ་བའི་རྗེས་དཔག་ཀྱང་འཇུག་སྟེ་མཐོང་བ་ཙམ་གྱིས་དེ་ལ་ངེས་པ་སྐྱེད་པར་མི་བྱེད་པའི་ཕྱིར་རོ།",
    "འོ་ན་མངོན་སུམ་ལ་སྣང་མི་སྣང་གཉིས་ཀྱང་མི་འགལ་པར་མཚུངས་སོ།",
    "སྒྲ་རྟོག་ཁྱད་པར་ཅན་ཁོ་ན།",
    "ཁྱད་པར་ཁོ་ན་ལ་འཇུག་པ་དགག་པའོ།",
    "ཁྱད་པར་ཅན་ནི་ཁྱད་པར་ལ་ཕན་འདོགས་པ་ཡིན་ཏེ་མི་འདོགས་ན་འབྲེལ་མེད་དུ་འགྱུར་བས་སོ།",
    "ཁྱད་པར་སྣ་ཚོགས་པ་ནི་བྱས་པ་དང་མི་རྟག་པ་ཉིད་ལ་སོགས་པའོ།",
    "དེ་དག་ལ་ཕན་པའི་ཡན་ལག་ནི་རྒྱུ་སྟེ་ཁྱད་པར་ཅན་ནོ།",
    "ནུས་པ་ནི་དེ་ལ་ཡོད་པའི་ཁྱད་པར་ལ་ཕན་པའི་ནུས་པའོ།",
    "འོ་ན་ཁྱད་པར་དུ་མ་ལ་ཕན་འདོགས་པའི་ནུས་པ་རྣམས་ཀྱང་ཐ་དད་མེད་པར་ཉེར་དགུ་འགྱུར་ཏེ།",
    "ཁྱད་པར་ཅན་དེ་ཁྱད་པར་ཀུན་ལ་ཕན་འདོགས་བྱེད་དུ་བཟུང་བབའི་ཕྱིར་རོ།",
    "ཁྱད་པར་གཅིག་ལ་ཕན་འདོགས་བྱེད་དང་ཀུན་ལ་ཕན་འདོགས་བྱེད་དེ་དག་ཐ་དད་མེད་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་ཀུན་ལ་ཕན་འདོགས་པའི་ཁྱད་པར་ཅན་བཟུང་བས་ཕན་སགདགས་པར་བྱ་བའི་ཁྱད་པར་ཐམས་ཅད་བཟུང་བར་མི་འགྱུར་ཏེ་ཡན་ལག་དང་ཡན་ལག་ཅན་དེ་དག་ཐ་དད་པས་ཞེ་ན།",
    "གང་ཞེ་ན་འུ་ཡུག་ཁྱད་པར་ཕན་གདགས་བྱ་དང་ཕན་འདོགས་བྱེད་ཁྱད་པར་ཅན་གཉིས་ཀའོ།",
    "ཕན་འདོགས་བྱེད་ཁྱད་པར་ཅན་ཤེས་པའི་དུས་ནའོ།",
    "འོག་ཏུ་གཅིག་ལ་ཞེས་པ་སྟེ་ཁྱད་པར་ཅན་དེ་ཁྱད་པར་གཅིག་ལ་ཕན་འདོགས་རྣམ་འགྲེལ་བྱེད་དུ་བཟུང་བར་འདོད་ན་ནི།",
    "ཁྱད་པར་ཅན་དེ་ཁྱད་པར་གཅིག་ལ་ཕན་འདོགས་བྱེད་དུ་བཟུང་བའི་ཕྱིར་རོ།",
    "རིགས་ཁྱབ་པ་ནི་ཁྱད་པར་གཅིག་པོ་དེ་ལ་ཁྱད་པར་ཅན་ཕན་འདོགས་པ་མཐོང་ན་མ་མཐོང་བའི་ཁྱད་པར་རྣམས་ལ་ཕན་འདོགས་པའི་ཁྱད་པར་ཅན་ཡང་མཐོང་སྟེ་གཞན་ཡིན་པ་དེའི་ཕྱིར་ཞེས་པ་དེ་དག་ཐ་དད་མེད་ཅེས་པའོ།",
    "ཁྱད་པར་ཅན་དེ་ཡིས་ཁྱད་པར་དེ་དག་ལ་ཕན་འདོགས་པ་མེད་པར་འདོད་པའི་དུས་ནའོ།",
    "གལ་ཏེ་ཁྱད་པར་ཅན་གྱི་ནུས་པ་དང་པོ་ལ་ཕན་མི་འདོགས་ཀྱང་དེ་བསྐྱེད་པའི་ནུས་པ་གཉིས་པ་ལ་ཕན་འདོགས་པས་ནུས་པ་དང་ནུས་པ་ཅན་འབྲེལ་ལོ་ཞེ་ན།",
    "གཉིས་པ་ཁྱད་པར་ཁོ་ན་ལ་འཇུག་པ་དགག་པ་ནི།",
    "གལ་ཏེ་ཞེས་པ་སྟེ་ངེས་པའི་ཤེས་པས་ཁྱད་པར་ཅན་དེ་ཁྱད་པར་གཅིག་ལ་ཕན་འདོགས་བྱེད་དུ་བཟུང་བའི་ཚེ།",
    "ཁྱད་པར་ཐམས་ཅད་དེས་བཟུང་སྟེ་ཐ་དད་མེད་པའི་ཕྱིར་རོ།",
    "བཟུང་ཡང་ཁྱད་པར་ཐམས་ཅད་མི་ངེས་ཏེ་ཡིད་འཁྲུལ་པས་ཟིན་པའི་ཕྱིར་རོ།",
    "དང་པོ་རྟོག་པ་ཕྱི་མ་སེལ་བ་ལ་འཇུག་པར་སྒྲུབ་པ་ནི།",
    "གཉིས་པ་བཟུང་ན་མ་ངེས་པར་འགལ་བ་སྤང་བ་ནི།",
    "ཁྱད་པར་ཞེས་པ་སྟེ་ཁྱད་པར་ནི་མི་རྟག་པ་ལ་སོགས་པའོ།",
    "གཉིས་པ་སྒྲ་རྟོག་སེལ་བ་ལ་འཇུག་པར་སྒྲུབ་པ་ལ་གསུམ་སྟེ།",
    "ཐ་དད་མེད་ན་སྒྲ་གཉིས་དང་རྟོག་པ་གཉིས་འཇུག་པར་འགལ་ཞེས་པའོ།",
    "དེས་ན་སྒྲ་ནི་དོན་ལས་སྐྱེས་པ་མ་ཡིན་གྱི་བརྗོད་འདོད་ཀྱི་ས་པར་སྦྱར་བ་ཡིན་ནོ།",
    "སྒྲ་གཉིས་ཀྱི་ཁྱད་པར་དང་།",
    "ཁྱད་པར་ཞེས་པ་སྟེ་གཞིའམ་རྒྱུ་ཡིན་ནོ་ཞེས་དྲང་ངོ།",
    "སོ་གཉིས་བརྡའི་ཁྱད་པར་ནི་རྟོགས་པ་པོའི་འདོད་པའི་རྗེས་སུ་བྱེད་པ་ཅན་ནོ།",
    "གཞན་ནི་དེ་ལ་ཡོད་པའི་རྟ་མ་ཡིན་པ་ཉིད་ལས་གཞན་དུ་གྱུར་པ་དེའི་མི་རྟག་པ་ཉིད་དང་བྱས་པ་ཉིད་ལ་སོགས་པའོ།",
    "གཉིས་པ་ཁྱད་པར་དེ་རིགས་ཅན་གཞན་ལ་སྦྱར་བ་ལ་གཉིས་ལས།",
    "དེ་དག་བརྗོད་བྱ་ལ་ཁྱད་པར་མེད་ཅེས་པ་ནི་བ་ལང་ཉིད་ཅེས་པས་བ་ལང་མ་ཡིན་པ་བཅད་པ་གོ་བ་ལྟར་བ་ལང་ཞེས་པས་ཀྱང་དེ་གོ་འུ་ཡུག་བའི་ཕྱིར་རོ།",
    "དོན་དེ་ཞེས་པ་སྟེ་ཁྱད་པར་གཞན་དེ་དག་སྤོང་བ་དང་མི་སྤོང་བའི་དོན་དེ་ཤེས་པར་འདོད་པའི་རྗོད་བྱེད་ཀྱི་སྒྲ་དེ་ལ་ཕན་པའི་རྐྱེན་ནམ་བྱེད་ལྡན་གྱི་རྐྱེན་ནམ་གལ་ཏེ་དེ་གཉིས་ལས་གཞན་པ་ཡིད་བྱེད་ཀྱི་མཐའ་པའི་རྣམ་ཅན་ལ་སོགས་པས་བརྗོད་ཀྱང་རུང་སྟེ་སྤོང་མི་སྤོང་དེ་ལས་གཞན་པའི་ཁྱད་པར་མེད་དེ་དོན་གཅིག་པའི་ཕྱིར་རོ།",
    "དང་པོ་ཐ་དད་མེད་པ་ལ་སྐྱོན་མེད་པར་བསྟན་པ་ནི།",
    "གཉིས་པ་ཐ་དད་ལ་རིགས་སྐྱོན་ཡོད་པར་བསྟན་པ་ནི།",
    "འོ་ན་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "ཕྱི་རོལ་གྱི་དོན་གཅིག་དང་དུ་མ་ལ་མི་ལྟོས་པར་བརྡས་ཕྱེ་བའི་གཅིག་དང་དུ་མ་གོ་བ་ཡིན་ནོ།",
    "འཇུག་ཚུལ་རྒྱས་པར་བསྟན་པའོ།",
    "དེས་ན་སྤྱི་འཛིན་འཁྲུལ་པར་བསྟན་པའོ།",
    "བུམ་པ་ཐམས་ཅད་བུམ་པ་མ་ཡིན་པ་ལས་ལོག་པར་མཚུངས་པ་ལ་སྤྱི་ཞེས་བརྗོད་དེ་བུམ་པ་ཐམས་ཅད་ལ་ཁྱབ་པའི་ཕྱིར་རོ།",
    "སོགས་པ་ཤེས་པའི་ཁྱད་པར་དུ་མ་ལ་ཁྱབ་པའི་སྤྱི་ཡང་མིན་ཏེ་དེ་དག་ལ་རྗེས་སུ་མི་འགྲོ་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་མ་ཞེན་ན་དེ་ལྟར་སྣང་བའི་རྟོག་པ་སྐྱེས་ཀྱང་ཕྱི་རོལ་ཏུ་དོན་བྱེད་ནུས་པའི་བུམ་པ་གང་རུང་ལེན་པ་ལ་མི་འཇུག་པར་འགྱུར་ཏེ་སྣང་ལ་མ་ངེས་པ་བཞིན་ནོ།",
    "རིགས་མི་མཐུན་པ་ལས་ལོག་པ་དེ་ཉིད་དེ་ལས་གཞན་པའི་པའི་རིགས་མཐུན་ལས་ཀྱང་ལོག་པར་སྣང་སྟེ་དེ་ལ་ཞེས་པ་ནི་ལྡོག་པ་གཉིས་ཀྱིས་ཟིན་པའི་ཕྱིར་གཞི་མཐུན་གྱི་ཐ་སྙད་ཀྱི་ཡུལ་ལོ།",
    "གཉིས་པ་ལ་གསུམ་སྟེ་ཐ་སྙད་ཐམས་ཅད་འཁྲུལ་པར་བསྟན་པ་དང་།",
    "དེ་ལ་ཞེས་པ་སྟེ་རྒྱས་པར་བྱེད་ཅེས་དྲང་ངོ།",
    "མི་རྟག་པར་རྟོག་པ་གང་ལ་ཞེས་པ་བློའོ།",
    "དེ་དག་བརྡ་ལལས་ཡིན་གྱི་དངོས་པོ་ལ་མི་སྲིད་པར་བསྟན་པའོ།",
    "དེ་ཡང་ཐ་སྙད་འཇུག་པར་བྱེད་ཅེས་དྲང་ངོ།",
    "ཇི་ལྟར་ཞེ་ན་དོན་དམ་པར་དེ་དག་ཡོད་པ་མིན་ཡང་རྟོག་པའི་ངོར་ཇི་ལྟར་གྲགས་པ་བཞིན་དུའོ།",
    "གང་ཞེ་ན་བསྒྲུབ་བྱ་དང་སྒྲུབ་པར་བྱེད་པ་ཀུན་ནོ།",
    "ཞེས་པ་ལ་མཛོད་སོགས་པའི་རྣམ་གཞག་དང་གཅིག་དང་ལྡོག་པའི་སྒོ་ནས་ཐ་དད་པ་དང་བུམ་པ་དུ་མ་ཡང་རིགས་མི་མཐུན་པ་ལས་ལོག་པའི་སྒོ་ནས་ཐ་དད་མིན་པར་འཇོག་པ་ལ་སོགས་པའོ།",
    "ཇི་ལྟར་བཞག་ཅེ་ན་དེ་ཁོ་ན་ཉིད་ཀྱི་དོན་དངོས་པོའི་གནས་ལུགས་ཇི་ལྟར་ཡོད་དེ་། དཔ་ལ་མ་བརྟག་པར་ཏེ་མ་ལྟོས་པར་འཇིག་རྟེན་ན་ཇི་ལྟར་རྟོག་པ་ལ་གཅིག་དང་ཐ་དད་ལ་སོགས་པར་སྣང་བ་དེ་དོན་ལའང་དེར་ཞེན་པའི་སྟོབས་ཀྱིས་གྲགས་ནས་ཡོད་པ་དེ་ལ་བསྟན་བཅོས་བྱེད་པས་ཀྱང་དེ་བཞིན་ཁོ་ནར་བརྟེན་ནས་ལོ་ཀ་དང་མཐུན་པར་བཞག་གོ།",
    "ཅིའི་ཆེད་དུ་ཞེ་ན་འཇིག་རྟེན་པས་ཀྱང་དམ་པའི་དོན་མི་རྟག་པ་ལ་སོགས་པའི་རང་མཚན་རྟོགས་པར་བྱ་བའི་ཕྱིར་མཁས་པས་ཀྱང་དེ་ལྟར་བྱས་པ་ཡིན་ཏེ།",
    "ཡང་དེ་ལ་དུ་མའི་ཐ་སྙད་ཀྱང་མེད་དེ་བྱས་པ་དང་མི་རྟག་པ་ལ་སོགས་པ་རང་བཞིན་གྱིས་ཐ་དད་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ནི་ཁྱད་པར་རོ་ཞེས་བྱ་བའི་བྱེ་བྲག་སྟེ་ཐ་དད་པའི་ཐ་སྙད་འདི་ནི་བློ་ལ་སྣང་བའི་དོན་ལ་ཡིན་ནོ།",
    "རྟོག་པ་ལ་སྣང་བ་དངོས་མེད་ཡིན་པའི་ཕྱིར་བྱས་པ་ཉིད་ལ་སོགས་པའི་ཐ་སྙད་དེ་ལ་མི་རུང་ངོ་ཞེ་ན།",
    "ཅིས་ཞེ་ན་མ་བྱས་པ་ལ་སོགས་པ་གཞན་ལས་ལྡོག་པར་སྣང་བས་སོ།",
    "འོ་ན་གང་ཡིན་ཞེ་ན་རྟོག་པ་ལ་སྣང་བའི་ལ་ལ་སོགས་པའི་ཁྱད་པར་རོ།",
    "དེ་ཉིད་ཅི་སྟེ་ཞེ་ན་བྱས་མཛོད་པ་དང་མི་རྟག་པ་ལ་སོགས་པའི་བྱེ་བྲག་མང་པོ་རྣམས་དངོས་པོ་དེ་གཅིག་ལ་མི་རུང་བའི་ཕྱིར་རོ།",
    "བྱེ་བྲག་ཇི་ལྟ་བུ་ཞེ་ན་ཁྱད་པར་ཏེ་དངོས་པོའི་ངོ་བོ་མང་པོའོ།",
    "ལོག་པ་དེ་དེ་ཁོ་ན་བཞིན་དུ་རྟོགས་པར་བྱེད་པའི་སྒྲ་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེའི་ཚེ་རང་མཚན་གཞན་ཡོད་ཀྱང་དེ་ལ་བརྡ་མ་བྱས་པས་མི་གོ་ལ་སྔ་ཕྱིའི་རང་མཚན་གཅིག་ཏུའང་མི་རུང་བའི་ཕྱིར་རོ།",
    "འདིར་བརྡ་དཀའ་བ་དང་མི་ནུས་པའི་རྟགས་ཀྱང་ཤེས་པར་བྱའོ།",
    "ཅི་ཞེ་ན་རྗོད་པར་བྱེད་པའི་བརྡའོ།",
    "དེ་ཡང་རྒྱལ་པོའི་ཆད་པས་འཇིགས་པ་ལ་པའི་རྣམ་སོགས་པ་མ་ཡིན་གྱི་དགོས་པ་ཁྱད་པར་ཅན་ཡོད་པར་ཤེས་ནས་བརྡ་སྦྱོར་རོ།",
    "གཉིས་པ་རིགས་དོན་བྱེད་མི་ནུས་པར་བསྟན་པ་ནི།",
    "དེ་ཡང་ཁ་ཅིག་དེ་དངོས་མེད་དུ་འདོད་ལ་ཁ་ཅིག་བཏགས་པར་འདོད་པས་སོ།",
    "དེ་ལྡན་ཞེས་པ་རིགས་དེ་དང་ལྡན་པའམ་དེས་ཁྱད་པར་དུ་བྱས་པའི་གསལ་བ་དོན་བྱེད་ནུས་པ་མཛོད་ལ་སྦྱོར་ཞེ་ན།",
    "འོ་ན་རིགས་ཀྱིས་ཁྱད་པར་དུ་བྱས་པ་འདི་ལའང་མི་ནུས་ཏེ་མཐའ་ཡས་པར་མཚུངས་པའི་ཕྱིར་ཏེ་རིགས་ཀྱིས་གསལ་བ་ཉུང་དུ་བཏང་བ་ནི་མེད་དོ།",
    "དེས་ན་སྒྲ་དང་གསལ་བ་གཉིས་འབྲེལ་བ་མ་བྱས་ན་མི་གོ་ལ་བྱ་བར་ནི་མི་ནུས་ཏེ་མཐའ་ཡས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྤྱི་ལ་བརྡ་བྱས་པས་གསལ་བ་རྣམས་གོ་སྟེ་དེ་གཉིས་འབྲེལ་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "མཚུངས་པ་ནི་བུམ་པ་ཐམས་ཅད་དེ་མ་ཡིན་ལས་ལོག་པར་ཐ་དད་མེད་ཅེས་པའོ།",
    "དེ་ལྟ་བུའི་གཞན་སེལ་ལ་བརྡ་ཅིས་མ་བྱས་ཞེས་པ་ནི་དེ་ལ་བརྡ་མི་བྱེད་པར་སྤྱི་གཞན་རྟོག་པའི་རྒྱུ་ཅི་ཡིན་ཞེས་འདྲི་བའོ།",
    "ཁྱད་པར་དང་།",
    "སྐྱོན་མཚུངས་པར་ཁས་བླངས་ཀྱང་བླ་སྟེ་དེའི་ནང་ནས་རིགས་གཞན་སྐྱོན་ཅན་ཁས་བླང་མི་དགོས་སོ།",
    "དེ་ལས་ཞེས་པ་སྟེ་བུམ་པའི་སྒྲས་ཆུ་འཛིན་པ་དེ་ལས་སགཞན་དུ་གྱུར་པའི་ཀ་བ་ལ་སོགས་པ་ཡོངས་སུ་སྤང་ནས་ཉན་པ་པོ་ཆུ་འཛིན་པའི་དོན་ལ་འཇུག་པར་འགྱུར་བའི་དོན་དུ་སྒྲ་བརྗོད་དོ།",
    "གཉིས་པ་བཟློག་ཕྱོགས་མ་བསལ་ན་དགོས་པ་དེ་མི་འགྲུབ་པར་བསྟན་པ་ནི།",
    "འོ་ན་རིགས་སུ་རྟོག་པ་དང་སེལ་བར་རྟོག་པའི་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "གལ་ཏེ་ཞེས་པ་སྟེ་སྒྲ་འདི་ལ་རྣམ་གཅོད་བརྗོད་བྱར་ཡོད་དེ་ཞེས་པའམ་བུམ་པ་འདི་ལ་སྒྲའི་ཡུལ་དུ་གྱུར་པའི་རྣམ་གཅོད་ཡོད་པར་འདོད་ཅེ་ན།",
    "འོ་ན་མུ་སྟེགས་པ་ཁྱེད་ལ་སྒྲའི་དོན་གཏན་ལ་འབེབས་པའི་སྐབས་དེར་སྤྱི་གསལ་བ་ལས་གཞན་དུ་གྱུར་པ་ཡོད་ཅེས་བརྟགས་པས་ཅི་ཞིག་བྱ་སྟེ་དོན་མེད་པར་འགྱུར་ཏེ་སྒྲ་སྦྱར་བ་རྣམས་ཀྱི་དགོས་པ་མི་འདོད་པ་བསལ་ནས་འདོད་པའི་དོན་རྟོགས་པ་དེ་ཙམ་དུ་ཟད་པའི་ཕྱིར་རོ།",
    "ལན་དུ་གསལ་བ་ཤེས་པ་སྟེ་ངོ་ཤེས་པར་བྱེད་ཅེས་དྲང་ངོ།",
    "གང་དག་ཀྵབསྲེས་ཞེ་ན་སྔར་ཟངས་ལས་བྱས་པའི་ཆུ་སྐྱོར་བའི་དོན་རྣམས་མཐོང་ནས་ཕྱིས་དེ་ལས་དངོས་པོ་གཞན་དུ་གྱུར་པ་རྫ་ལས་བྱས་པའི་ཆུ་སྐྱོར་བ་མཐོང་ཡང་ངོ།",
    "ཞེས་པར་བསྒྱུར་སྣང་ངོ།",
    "བུམ་པ་འཛིན་པ་དེ་སྐྱེད་འུ་ཡུག་པར་བྱེད་པ་གཅིག་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་དེས་གསལ་བ་གཏན་མི་ཤེས་པར་འགྱུར་རོ།",
    "དེ་འདོད་ན་རིགས་དེ་དང་གསལ་བ་ལྡན་ནོ་ཞེས་དེ་གཉིས་སྦྱར་ནས་ངེས་པ་མི་སྲིད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་གསལ་བ་དུ་མའང་སྤྱི་དངོས་པོ་གཅིག་དང་མ་བྲལ་ཙམ་ལ་ལྟོས་ནས་གསལ་བ་རྣམས་ལ་ཐ་དད་མིན་པར་འཛིན་པའི་བློ་སྐྱེད་ཅེ་ན།",
    "འདོད་ན་སྤྱིའི་བློས་གསལ་བ་འཛིན་པ་མེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་གསལ་བས་སྤྱི་གཅིག་ལ་ཕན་འདོགས་ཀྱང་གཅིག་ཏུ་འཛིན་པའི་བློ་ལ་ཕན་མི་འདོགས་ཏེ་ཐ་དད་མིན་པར་སྣང་བའི་སྤྱིའི་བློ་དེ་རྣམ་པ་འགལ་བ་ཉིད་ཀྱིས་གསལ་བ་ཐ་དད་པ་རྣམས་ལས་སྐྱེ་བ་མིན་པར་འདོད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་རྟོག་པས་གསལ་བ་དེ་དག་མཚུངས་པར་འཛིན་ན།",
    "ཇི་ལྟར་ཐ་དད་པའི་བློ་ཁོ་ནས་གཟུང་འུ་ཡུག་བར་བྱ་སྟེ་ཐ་དད་མེད་པའི་བློས་ཀྱང་འཛིན་པར་འགྱུར་རོ།",
    "འདི་ལྟར་མཚུངས་པར་འཛིན་པ་ལ་ཐ་དད་དང་།",
    "གལ་ཏེ་གསལ་བ་རྣམས་ལ་འབྲས་བུ་གཅིག་ཡོད་ན་སྤྱི་དངོས་པོར་གྲུབ་པར་འགྱུར་རོ་ཞེ་ན།",
    "མིན་ཏེ་འབྲས་བུ་གཅིག་པ་དེ་ཡང་དེའི་འབྲས་བུ་ཅན་མ་ཡིན་པ་དང་བྲལ་བའི་སྒོ་ནས་ཡིན་ཏེ་བུམ་པ་ཐམས་ཅད་ཆུ་མི་འཛིན་པ་ལས་ལོག་པར་གཅིག་ཅེས་པ་བཞིན་ནོ།",
    "གལ་ཏེ་ན་ཡོད་ཀྱང་ཤེས་པའི་རྒྱུར་མི་རུང་སྟེ་དེ་རྟག་པར་འདོད་པའི་ཕྱིར་རོ།",
    "གང་ཞེ་ན་སྐྱེད་པར་བྱེད་པའི་འུ་ཡུག་སྒྲའོ།",
    "དེ་ཉིད་ཇི་ལྟ་བུ་ཞེ་ན་ཁྱད་པར་གསུམ་ལྡན་ཏེ་དང་པོ་སྣང་བའམ་ཞེན་པའི་ཁྱད་པར་ནི།",
    "གཉིས་པ་རྒྱུའི་ཁྱད་པར་ནི།",
    "གསུམ་པ་ཡུལ་གྱི་ཁྱད་པར་ནི།",
    "གལ་ཏེ་སྤྱི་ལ་བརྡ་སྦྱར་ན་དོན་གཏན་མི་རྟོགས་པར་འགྱུར་མཛོད་ཏེ་སྤྱི་མི་སྲིད་ཅིང་གཞན་མ་བརྗོད་པའི་ཕྱིར་རོ།",
    "དེ་འདོད་ན་ཤིང་དང་ཤིང་མ་ཡིན་པ་གཉིས་ཀ་འཛིན་པ་མེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་ཞེས་འགྲེལ་པ་སྟེ་ཁྱེད་ལྟར་རིགས་མི་མཐུན་གཞན་བཀག་ནས་བརྡའི་ཡུལ་མི་སྒྲུབ་ཀྱི་འོན་ཀྱང་སྒྲུབ་པ་རྐྱང་པའི་ཚུལ་གྱིས་དེ་མདུན་ན་གནས་པའི་གསལ་བ་གཅིག་ལ་གནས་པའི་སྤྱི་དངོས་པོ་གཅིག་ཅེས་པ་ནི་བརྡའི་ཡུལ་ཏེ་དེ་ལ་བརྡ་བྱས་པས་གསལ་བ་ཐམས་ཅད་ལ་རིགས་བརྡ་བྱས་པར་འགྱུར་ཏེ་དེས་དེ་དག་ཐམས་ཅད་ལ་ཁྱབ་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་འགའ་ཞིག་ལ་ཤིང་ཉིད་ལ་སོགས་པའི་སྤྱི་གཅིག་མཐོང་ཞིང་འགའ་ཞིག་སྤྱི་དེས་དབེན་པར་མཐོང་བའི་ཤེས་པ་སྐྱེའོ།",
    "དེ་ལས་དེ་གཉིས་རིགས་མི་མཐུན་པར་ངེས་ཤིང་ཐ་དད་དུ་འབྱེད་པའི་རྟོག་པ་སྐྱེའོ།",
    "འདི་ཁོ་ན་ཞེས་ངེས་པར་ཞེ་དྲུག་བཟུང་བའི་ཤུགས་ཀྱིས་ཡལ་འདབ་མེད་པ་རྣམས་ཤིང་མིན་དུ་ངེས་པར་འགྱུར་རོ།",
    "གཅིག་རྟོག་ཅེས་པ་སྟེ་འདི་ཡང་སྤྱི་ཡོད་མེད་དང་སྒྲུབ་པ་ལ་སྦྱོར་བ་ཙམ་མི་མཐུན་གྱི་བརྡ་སྦྱོར་བའི་ཚུལ་དང་རིམ་པ་ནི་མཐུན་པར་སྟོན་ཏེ་འབྱེད་པར་བྱེད་ཅེས་དྲང་ངོ།",
    "གཅིག་ཏུ་འཛིན་པའི་བློ་དེ་ལ་ཡོད་པ་ནི་འགྲེལ་ཡལ་འདབ་ལ་སོགས་པར་སྣང་བའོ།",
    "གང་ལ་ཞེ་ན་རིགས་མི་མཐུན་པ་ལས་ཐ་དད་པར་སྣང་བའི་བློའི་གཞན་སེལ་རིགས་མཐུན་ཐམས་ཅད་ལ་གཅིག་ཏུ་མཛོད་སྒྲོ་བཏགས་པ་ལའོ།",
    "ཅིའི་དོན་དུ་ཞེ་ན་ཐ་སྙད་ཀྱི་དུས་སུ་བརྡའི་ཡུལ་དེ་རིགས་མི་མཐུན་ལས་ཐ་དད་པར་ཤེས་པར་འགྱུར་བའི་དོན་དུའོ།",
    "དེ་ལས་ཞེས་པ་སྟེ་རྟོགས་པར་འགྱུར་ཞེས་དྲང་ངོ།",
    "ཅིའི་དོན་དུ་ཞེ་ན་རྨོངས་པའི་བློ་བུམ་མིན་ལ་སོགས་པའི་དོན་འགའ་ལས་བཟློག་ནས་བུམ་པ་ལ་སོགས་པའི་དོན་འགའ་ཞིག་ལ་འཇུག་པར་བྱ་བའི་ཕྱིར་རོ།",
    "སྒྲས་དོན་རྟོགས་པ་གཞན་བཟློག་པ་ལ་ལྟོས་པ་ཅི་ཞེ་ན་སྒྲ་ཚད་དེའི་དོན་གཞན་ལྡན་རྣམ་གཅོད་དུ་ངེས་པར་བཟུང་བའི་ཕྱིར་རོ།",
    "གཉིས་པ་ཤེས་བྱ་ལ་སོགས་པའི་ཚིག་ལའང་གཞན་སེལ་ཡོད་པར་བསྟན་པ་ནི།",
    "དེས་ན་ཞེས་པ་སྟེ་རྣམ་པར་གཅོད་པ་ཡོད་ཅེས་དྲང་ངོ།",
    "དང་པོ་ལྟར་ན་དམ་བཅའ་ཉམས་ལ་གཉིས་པ་ལྟར་ན་སེལ་བ་ཐུག་མེད་དུ་འགྱུར་ཏེ་སེལ་རིགས་བའང་གཞན་རྣམ་པར་བཅད་པས་སྟོན་ལ་དེ་ལའང་སེལ་བ་གཞན་དགོས་པའི་ཕྱིར་རོ་ཞེས་ཟེར་རོ།",
    "སྒྲས་ལྡོག་པས་ཁྱད་པར་དུ་བྱས་པའི་དངོས་པོ་རྟོགས་པའི་ཚུལ་དང་།",
    "གང་ལ་ཞེ་ན་མཚུངས་པར་སྣང་བ་ཅན་ལ་ཞེས་དྲང་ངོ།",
    "དེས་ན་རྟོག་པ་ལ་མཚུངས་པར་སྣང་བ་ཅན་གྱི་རྣམ་པ་གཅིག་ལ་དགོད་ཅེས་བྱ་སྟེ།",
    "མཚུངས་པར་སྣང་བ་གཅིག་ལ་དགོད།",
    "ཡང་ན་དངོས་པོ་དེའི་ཆ་ནི་སྐད་ཅིག་གཉིས་པར་མི་སྡོད་པ་ལ་སོགས་པ་ཡིན་ལ་དེ་མི་རྟག་པ་ལ་སོགས་པའི་སྒྲ་ལས་རྟོགས་པར་འགྱུར་བའོ།",
    "འདི་ནི་སྒྲའི་ལྡོག་པ་ཡིན་ལ་དངོས་པོ་དེའི་ཆ་རྟོགས་པ་ནི་རྗེས་འགྲོ་ཡིན་པས་དེ་གཉིས་ཀྱི་སྒྲ་དོན་དང་ལྡན་པར་འགྱུར་ཏེ་རྟགས་པ་བཞིན་ནོ།",
    "ལྡོག་པ་དང་ལྡོག་ལྡན་ཐ་དད་ན་སྤྱི་དངོས་པོར་ཁས་བླངས་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྒྲ་ཞེས་པ་སྟེ་རྟོགས་པར་འགྱུར་ཞེས་དྲང་ངོ།",
    "གཉིས་པ་ལྡོག་པས་ཁྱད་པར་དུ་བྱས་པའི་རྣམ་འགྲེལ་ཚུལ་ནི།",
    "དེ་ལ་ནི་ཞེས་པ་སྟེ་སྒྲས་རྟོགས་པར་འགྱུར་བ་མེད་ཅེས་དྲང་ངོ།",
    "གང་མེད་ཅེ་ན་སེལ་བའི་སྤྱི་འགའ་ཡིས་ཁྱད་པར་དུ་བྱས་པའོ།",
    "ཇི་ལྟར་ཞེ་ན་གཞན་འགའ་ཞེས་པ་སྐྱེས་བུ་ལ་དབྱུག་པ་ལྟར་རིགས་སེལ་པའི་སྤྱི་དོན་གཞན་དུ་གྱུར་པས་ཁྱད་པར་དུ་བྱས་པ་མེད་ཅེས་པའོ།",
    "འོ་ན་ཇི་ལྟར་ཁྱད་པར་དུ་བྱས་ཞེ་ན།",
    "དང་པོ་ལྟར་ན་དཔལ་པའི་རྣམ་སོགས་པ་ཤིང་མིན་པར་འགྱུར་ཏེ་ཤིང་མིན་ལས་འབྱེད་པའི་ལྡོག་པ་དེ་དག་ལ་མེད་པའི་ཕྱིར་རོ།",
    "འོ་ན་ཤ་པ་ལ་སོགས་པ་ཤིང་མིན་པ་ལས་ལོག་པ་དེ་ལས་ཀྱང་ལོག་པར་འགྱུར་ལ་འདོད་ན་དེ་དག་ཤིང་མིན་དུ་འགྱུར་ཏེ་བུམ་པ་བཞིན་ནོ།",
    "བརྗོད་བྱ་ལ་དངོས་པོས་ཁྱབ་པར་བསྒོམས་ནས་འདི་སྐད་ཅེས་སྒྲོལ་ཏེ་རང་མཚན་ཁོ་ན་བརྗོད་བྱར་འགྱུར་ཏེ་སེལ་མཛོད་བའི་སྤྱི་ཕྱིའི་དངོས་པོར་མི་འདོད་ཅིང་གཞན་གྱིས་བརྟགས་པའི་སྤྱི་ཡང་མི་འདོད་པའི་ཕྱིར་རོ།",
    "པའམ་རྣམ་གྲངས་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྒྲས་སེལ་བ་ཙམ་པ་བརྗོད་པ་ནི་མ་ཡིན་ཏེ་དེས་ཁྱད་པར་དུ་བྱས་པའི་དངོས་པོ་བརྗོད་པའི་ཕྱིར་རོ།",
    "འདིས་ནི་སྒྲའི་པའི་དོན་གཞན་སེལ་ལ་གཞི་མཐུན་སྲིད་པར་བསྟན།",
    "དང་པོ་ལ་བཞི་ལས་དང་པོ་གཞན་སེལ་ལ་གཞི་མཐུན་རྣམ་འགྲེལ་སྲིད་པར་བསྟན་པ།",
    "ནིཁྱེད་ལ་སྤྱི་མེད་པའི་ཕྱིར་གཞི་མཐུན་མི་སྲིད་པར་འགྱུར་རོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "བུའི་བློ་རྟོག་པའི་ངོར་བྱས་ནས་གཞི་མཐུན་དུ་འགྱུར་རོ།",
    "གལ་ཏེ་མེད་ན་ཐམས་ཅད་འདྲེས་པར་འགྱུར་རོ།",
    "མ་ངེས་ཞེ་ན་སྣང་རུང་མ་དམིགས་པ་ལ་དགག་བྱའི་དངོས་པོ་མེད་པར་ངེས་པས་ཁྱབ་པའི་ཕྱིར་རོ།",
    "གང་ཞེ་ན་སྒྲ་རྣམས་དང་བློ་ཉིད་དོ་། ཅི་བསྟན་ཅེ་ན་རྟོག་པ་ལ་སྣང་བ་གཞན་སེལ་གྱི་ཡུལ་ལ་འཇུག་པར་རོ།",
    "གཞན་སེལ་ཡུལ་ཅན་དུ་བསྟན་ཏེ་བྱས་ན་ལེགས་སོ།",
    "གཞི་མཐུན་མེད་པའི་ཉེས་པ་ནི་རྣམ་གཅོད་གཅིག་ཅིག་སྟོན་པ་ན་ཞེས་པར་སྤངས་ཟིན་ཏོ།",
    "དེའི་འབྲས་བུ་ཞེས་པ་སྟེ་བརྡར་བྱས་ཞེས་དྲང་ངོ།",
    "འོ་ན་བུམ་པ་དང་སྣམ་བུ་ལའང་སྒྲ་གཅིག་བྱེད་པར་འགྱུར་རོ་ཞེ་ན་མིན་ཏེ་དེ་དག་ཐ་དད་དུ་འདྲ་ཡང་ཆུ་འཛིན་པའི་འབྲས་བུ་གཅིག་པ་དག་ལ་སྒྲ་གཅིག་བྱེད་དོ།",
    "ཅིའི་དོན་དུ་ཞེ་ན་བུམ་པ་ཐམས་ཅད་ཆུ་འཛིན་པ་དེའི་འབྲས་བུ་གཅིག་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "རང་མཚན་ཐ་དད་པ་དེ་དག་སྒྲས་བསྟན་པར་བྱ་བ་ནི་མིན་ཏེ་དེ་དག་སོ་སོར་པའི་བརྗོད་པར་དཀའ་བ་སྟེ་ཚོགས་ཆེ་བའི་ཕྱིར་དང་།",
    "སྒྲས་བཟློག་ཕྱོགས་མ་བསལ་ན་དེ་གཞན་དང་མ་འདྲེས་པར་བསྟན་པར་མི་ནུས་པའི་ཕྱིར་དང་།",
    "དཔེར་ན་ཁྲ་བོ་ལ་ཡོད་པའི་ཁྱད་པར་བ་ལང་རིགས་སེར་སྐྱ་ལ་མེད་པ་བཞིན་ཞེས་པ་ནི་ཁྲ་བོ་ཡིན་ཞེས་པའོ།",
    "དཔེར་ན་ཞེས་པ་སྟེ་སྟོན་པའི་སྐབས་སྲིད་པར་འགྱུར་ཞེས་དྲང་ངོ།",
    "གནས་སྐབས་ཁྱད་པར་ཅན་གྱི་སྒྲ་སྟེ་གསུམ་ཙམ་བརྗོད་པར་བྱའོ།",
    "ཆུ་འཛིན་པ་ནི་གཟུགས་ལ་སོགས་པའི་རྡུལ་བརྒྱད་འདུས་པ་ཡིན་ལ་དེ་དག་ཚེགས་ཆུང་ངུས་རྟོགས་པར་བྱ་བའི་དོན་དུ་འཇིག་རྟེན་པ་བུམ་པ་ཞེས་པའི་སྒྲ་གཅིག་སྦྱོར་ཏེ་འབྲས་བུ་གཅིག་པའི་ཕྱིར་རོ།",
    "དེས་ན་བུམ་པའི་གཟུགས་ཞེས་དྲུག་པའི་སྒྲ་སྦྱར་བ་ཡང་གཟུགས་ལ་སོགས་པ་ལས་གཞན་པའི་བུམ་པ་མེད་ཀྱང་བུམ་པའི་གཟུགས་ནི་ཆུ་འཛིན་པའི་ནུས་པ་ཅན་ནོ་ཞེས་སྣམ་བུ་ལ་སོགས་པའི་གཟུགས་ལས་ཁྱད་པར་དུ་བྱས་པའོ།",
    "དེ་དག་ནི་ཅིའི་དོན་དུ་ཞེ་ན་འགའ་ཞིག་སྟེ་ཚོགས་པ་དང་རྒྱུད་དང་གནས་སྐབས་དུ་མ་དེ་དག་ཅིག་ཅར་དུ་ཀུན་མཛོད་རྟོགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "རྣམ་པར་དཔྱད་པའི་སྒོ་ནས་རྟེན་དུ་མི་འཐད་པའོ།",
    "ཕན་མི་འདོགས་ཀྱང་རྟེན་དང་བརྟེན་པར་མི་འགལ་ཏེ་རྟེན་དེ་ལ་སྤྱི་དེའི་འཕྲོད་པ་འདུ་བ་ཡོད་པས་སོ།",
    "དེས་ན་འབྲེལ་བ་དུ་མ་འདོད་དེ་དེ་ལ་རྟེན་དང་བརྟེན་པ་ཡུལ་ཐ་མི་དད་པར་གྲུབ་པ་ནི་འཕྲོད་པ་འདུ་བ་ཡིན་ཏེ་བརྩམ་པར་བྱ་བ་དང་འུ་ཡུག་རྩོམ་པ་པོ་དག་ལྟ་བུའོ།",
    "ཇི་ལྟར་ཞེ་ན་རྒྱ་ཤུག་སྔ་མ་ཉེར་ལེན་དུ་རིགས་གྱུར་པ་དང་འཁར་གཞོང་གཉིས་ཕྲད་པ་དེའི་དུས་སུ་རྒྱ་ཤུག་རྟེན་པར་བསྐྱེད་ནུས་པའོ།",
    "དེ་ལྟ་བུའི་རྒྱུ་འབྲས་དེ་ཡང་སྤྱི་དེ་ལ་མི་སྲིད་དེ་དེ་རྟག་པར་འདོད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་གསལ་བས་སྤྱི་མི་སྐྱེད་ཀྱང་སྔར་མི་གནས་པ་གནས་པར་མཛོད་བྱེད་པའི་ཕྱིར་རྟེན་ཡིན་ཞེ་ན།",
    "སྤྱི་གནས་པར་བྱེད་པ་མིན་ཏེ་གསལ་བ་དེ་མེད་པའི་ས་ན་ཡང་སྤྱི་དེ་གནས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་དེ་གནས་པ་དེ་ལ་རག་ལས་པར་འདོད་ན་དེ་ཡང་མི་རིགས་ཞེས་དྲང་ངོ།",
    "ཐ་དད་མེད་ཅེས་དཔྱོད་པས་ཏེ་ཐ་དད་ན་དེས་སྤྱི་གནས་པར་མ་བྱས་པར་འགྱུར་ཏེ་དེ་ལས་དོན་གཞན་བྱས་པས་སོ།",
    "གང་ཞེ་ན་བྱེད་པ་གང་ཞེས་པ་བུམ་འཛིན་སྐྱེད་པར་བྱེད་པའི་བུམ་པའོ།",
    "བུམ་པས་བུམ་འཛིན་སྐྱེད་པ་སྒྲོན་མ་ལ་པའི་རྣམ་ཇི་ལྟར་ལྟོས་ཞེ་ན་བུམ་པ་བདག་ཉིད་ལ་དམིགས་པའི་ཤེས་པ་སྐྱེད་པར་རུང་བ་སྟེ་ནུས་པ་སྒྲུབ་པའི་དོན་དུའོ།",
    "བུམ་འཛིན་སྐྱེས་པ་ནི་འགྲེལ་གསལ་བར་བྱ་བའི་ཚུལ་ཏེ་དེ་མ་སྐྱེས་ན་སྒྲོན་མ་ཡོད་ཀྱང་དེས་དེ་གསལ་བར་བྱས་པ་མིན་པའི་ཕྱིར་རོ།",
    "འོ་ན་དུ་བའང་མེའི་གསལ་བྱེད་མིན་པར་འགྱུར་ཏེ་མེའི་སྐྱེད་བྱེད་མིན་ལ།",
    "གང་དག་ཅེས་པ་སྟེ་རིགས་པ་ཅན་དང་གྲངས་ཅན་གང་དག་རིགས་དངོས་པོར་གྱུར་བ་གཅིག་ནི་གསལ་བ་རྣམས་ལས་གཞན་དུ་གྱུར་པའམ་གཞན་མིན་པར་ཡོད་པ་ཁོ་ནར་འདོད་པ་དེའི་ལུགས་ལ།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་སྔོན་གྱི་གསལ་བ་གཅིག་ལ་ཡོད་པར་མཐོང་བའི་སྤྱི་ནི་དེ་ལས་གཞན་ཕྱི་མིའི་འུ་ཡུག་གསལ་བ་རྣམས་ལ་དེ་མཐོང་བ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "སྤྱི་རྟག་པ་ལ་རྟེན་པར་བྱེད་པ་དང་།",
    "གསལ་བར་བྱེད་པ་མི་འཐད་པར་གོང་དུ་བསྒྲུབས་པས་རིགས་སོ་། གལ་ཏེ་གསལ་བ་ཐམས་ཅད་ལ་སྤྱི་མི་བརྟེན་ན་གཅིག་ལ་ཡོད་པ་མཐོང་ཞེས་པ་དང་སྔོན་མེད་གསལ་བ་ཞེས་དམིགས་ཀྱིས་བཀར་བ་མི་འཐད་ཅེ་ན།",
    "ཁྱབ་པ་ནི་མི་འགྲོ་ཞེས་པ་སྟེ་རྫས་སྔ་མ་ལ་འཕྲོད་འདུས་འབྲེལ་བའི་སྤྱི་ནི་རྫས་ཕྱི་མ་ལ་རྗེས་སུ་མི་འགྲོ་སྟེ་གཡོ་བའི་བྱ་བ་མེད་པར་འདོད་པའི་ཕྱིར་རོ།",
    "སྔ་མའི་ཡུལ་དེ་ལས་གནས་གཞན་དུ་སྐྱེ་བའི་གསལ་བ་ལའང་ཁྱབ་པར་གནས་ན་ཤིན་ཏུ་རིགས་ཞེས་པ་ནི་བསྟིང་བ་སྟེ་འགལ་ཞེས་པའོ།",
    "རིགས་ལ་གསལ་བར་བྱེད་པ་མི་སྲིད་པར་གནས་ལ་རྟེན་ནམ་གསལ་བ་ཡིན་ཞེས་པའི་སྐབས་སུ་བསྟན་ཟིན་ཏོ།",
    "གལ་ཏེ་ལྟོས་ན་འགའ་ཞིག་ཏུ་གསལ་བྱེད་ཀྱི་རྫས་རྟོགས་པ་མིན་ན་གསལ་བྱའི་སྤྱི་རྟོགས་པ་མི་སྲིད་པར་འགྱུར་ཏེ་སྒྲོན་མ་མ་རྟོགས་ན་བུམ་པ་མི་རྟོགས་པ་བཞིན་ནོ།",
    "དེ་ལྟར་ན་སྤྱི་དང་དེ་དང་ལྡན་པའི་གསལ་བ་གཉིས་ཅིའི་ཕྱིར་ན་བཟློག་པར་འདོད་ཅེས་པ་ནི་འདིར་རིགས་ནི་གསལ་བྱ་དང་རིགས་ལྡན་གསལ་བྱེད་ང་དུ་འདོད་དོ།",
    "གཞན་དུ་ཁྱད་པར་མ་བཟུང་བའི་ཁྱད་པར་གྱི་གཞིའི་བློ་མི་འཇུག་ཅེས་སྤྱི་མ་བཟུང་བར་ཁྱད་པར་མི་འཛིན་པར་འདོད་པ་གཉིས་འགལ་ཞེས་པའོ།",
    "རྟགས་དེ་མ་ངེས་པར་བསྟན་པ་དང་།",
    "དེ་དག་ལ་འཚེད་པ་པོ་ཉིད་ལ་སོགས་པའི་སྤྱི་གཅིག་ཡོད་པ་མིན་ནམ་ཞེ་ན་ཐ་དད་མེད་དོན་ཞེས་པ་ནི་སྤྱི་གཅིག་ཡིན་ལ་དེ་མེད་པར་ཡང་ངོ།",
    "དེས་ན་ལས་འགག་པའི་ཚེ་པའི་རྣམ་འཚེད་པ་པོ་ལ་སོགས་པའི་སྒྲ་བློ་མི་འཇུག་པར་འགྱུར་རོ།",
    "འདས་པའི་ལས་ཀྱང་རྫས་སུ་ཡོད་ན་ད་ལྟར་བ་བཞིན་དུ་དམིགས་པར་འགྱུར་རོ།",
    "ཐ་མི་དད་ན་ལས་བསྐྱེད་པའི་ནུས་པའང་རྫས་འུ་ཡུག་དང་ཐ་དད་མེད་པར་མཚུངས་སོ།",
    "འོག་ཏུ་མིན་ན་ནི་ཞེས་པ་ནི་དེ་དག་དང་པོ་ནས་འབྲེལ་པ་མིན་ན་དུས་ཕྱིས་འཚེད་པའི་བྱ་བ་ཡོད་པའི་དུས་ནའང་དེ་དག་འབྲེལ་བར་མི་འགྱུར་ཏེ་རྫས་དེ་རིགས་རྟག་པ་ཉིད་ཀྱིས་ཁྱད་པར་དུ་འགྱུར་བ་མེད་པའི་ཕྱིར་རོ།",
    "སྐད་ཅིག་ཉིད་ཕྱིར་ཞེས་པ་རྫས་སྐད་ཅིག་མ་ཉིད་དུ་འགྱུར་ཏེ་ལས་སྐད་ཅིག་མའི་ཕན་གདགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདོད་ན་དེས་ཕན་བཏགས་པའི་རྫས་ཀྱི་སྤྱི་གསལ་བའང་མེད་པར་འགྱུར་རོ།",
    "དེས་ན་དངོས་པོ་ཐ་དད་དུ་འདྲ་ཡང་འགའ་ཞིག་ལ་སྒྲ་རྟོག་གཅིག་འཇུག་ལ་འགའ་ཞིག་ལ་མི་འཇུག་པ་ནི་གཞན་སེལ་གྱིས་བྱས་ཞེས་སྟོན་པ་ནི་ཐ་དད་མཚུངས་པ་ཞེས་པའོ།",
    "དེས་འཛེམ་མེད་པའང་ཁེགས་པར་བསྟན་པའོ།",
    "གཞན་ཞེས་པ་ནི་ལྡོག་པའི་སྤྱི་ལས་གཞན་པའི་དངོས་པོའི་སྤྱི་མེད་ན་དུ་མས་འབྲས་བུ་གཅིག་པའི་རྣམ་བསྐྱེད་པ་མི་རུང་སྟེ་འདི་ལྟར་སྤྱིར་རྒྱུ་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནི་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཞེས་པ་སྟེ་ས་ལ་སོགས་པ་རྒྱུ་དུ་མས་འབྲས་བུ་མྱུ་གུ་གཅིག་སྐྱེད་པར་བྱེད་དེ་དེ་དག་ཐམས་། ཅད་ལ་གཙོ་བོའི་བདག་ཉིད་གཅིག་ཡོད་པའི་ཕྱིར་རོ་ཞེས་ཟེར་རོ།",
    "གང་དག་འགྲོ་ཞེ་ན་ས་ལ་སོགས་པའི་རྒྱུའི་ཁྱད་པར་རྣམས་ངེས་པ་དང་བྲལ་བ་སྟེ་ཐམས་ཅད་ལ་རྗེས་སུ་འགྲོ་བར་ཁས་བླངས་པའོ།",
    "དེས་ན་ཁྱད་པར་རྣམས་དོན་བྱེད་ནུས་པས་དོན་དམ་ཡིན་ལ་སྤྱི་ནི་དོན་བྱེད་མི་ནུས་པས་དངོས་མེད་དུ་སྟོན་པ་ནི་དོན་བྱེད་ཅེས་པའོ།",
    "ཐ་དད་མེད་ན་ཉེས་པ་ཡོད་པར་བསྟན་པའོ།",
    "ཐ་དད་ཅེས་པ་སྟེ་ས་ལ་སོགས་པའི་ཁྱད་པར་དེ་དག་ཐ་དད་མེད་པའི་ཕྱིར་དུས་ཅིག་ཅར་དུ་སྐྱེ་འཇིག་བྱེད་པར་འགྱུར་རོ།",
    "དེ་ལས་ཞེས་མཛོད་པ་སྟེ་གཙོ་བོ་གཅིག་ཡིན་ཀྱང་གཙོ་བོ་དེ་ལས་སྐྱེས་པའི་ས་བོན་ལ་སོགས་པའི་རྣམ་འགྱུར་དང་གཙོ་བོ་ཐ་དད་ཅིང་རྣམ་འགྱུར་ངན་ཡང་ཐ་དད་པས་ཅིག་ཅར་སྐྱེ་འཇིག་བྱེད་པ་དེ་ལྟར་མི་འགྱུར་ཞེ་ན་ཁྱད་པར་གཅིག་འཇིག་པའི་ཚེ་སྤྱིའི་བདག་ཉིད་གཙོ་བོ་དེ་དག།",
    "ནི་གནས་པར་འདོད་ན་སྤྱི་དེ་ཁྱད་པར་དེའི་རང་བཞིན་མིན་པར་འགྱུར་རོ།",
    "འདོད་ན་སྤྱི་དང་ཁྱད་པར་གཉིས་འབྲེལ་བར་སྣང་བའི་བློ་མི་སྐྱེ་བར་འགྱུར་ཏེ་དངོས་པོ་ཐ་དད་ཡིན་པ་དེས་ནའོ།",
    "ནིགལ་ཏེ་གསལ་བ་གཅིག་ཞིག་པ་ན་སེལ་བའི་སྤྱི་ཞིག་གམ་མ་ཞིག་དང་པོ་ལྟར་ན་གསལ་བ་གཞན་ལ་སྤྱི་མེད་པར་འགྱུར་ལ།",
    "གཉིས་པ་ལྟར་ན་སྤྱི་དང་གསལ་བ་ཐ་དད་དུ་འགྱུར་ལ་འདོད་ན་སྤྱི་དང་ཁྱད་པར་གྱི་བློ་མི་འཇུག་པར་འགྱུར་རོ་ཞེ་ན།",
    "བློ་ལ་ཤིང་ཉིད་ལ་སོགས་པ་གཅིག་ཏུ་སྣང་བ་སྒྲའི་བརྗོད་བྱར་བཞེད་པ་དེ་ཡིན་ཏེ་འདིས་གཞན་སེལ་ལ་འཇུག་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་ཞེ་ན་ཁྱད་པར་གཅིག་ཞིག་པའི་ཚེ་དེ་དག་གནས་སམ་མི་གནས་ཞེས་པ་ལ་སོགས་པའོ།",
    "གཉིས་པ་བློའི་ལྡོག་པའི་པའང་ཁྱད་པར་གཅིག་ཞིག་པའི་ཚེ་དེ་གནས་མི་གནས་ཀྱི་སྒོ་ནས་སུན་དབྱུང་དུ་མེད་དེ་དེ་ཡང་ངོ་བོ་ཉིད་མེད་པའི་ཕྱིར་རོ།",
    "ས་བོན་གྱི་ནུས་པ་མེད་ན་དེའི་མྱུ་གུ་སྐྱེད་པའི་ནུས་པ་ཡོད་པར་འགལ་ཞེ་ན་མཛོད་མིན་ཏེ།",
    "དེས་ན་དངོས་པོ་ཐ་དད་པའི་ས་ལ་སོགས་པའི་ཁྱད་པར་ཉིད་ཀྱིས་མྱུ་གུ་གཅིག་སྐྱེད་པར་བྱེད་དེ་དེ་དག་དང་ལྡོག་པ་ངེས་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་གཅིག་ལའང་དེ་ཡོད་ཕྱིར།",
    "གཉིས་པ་དེ་མེད་པའི་སྒྲུབ་བྱེད་ནི་སྣང་བའང་ཞེས་པ་སྟེ་ཐ་དད་དུ་སྒྲུབ་པར་བྱེད་ཅེས་དྲང་ངོ།",
    "ཐ་དད་མེད་ནའང་ཞེས་པ་དངོས་པོ་ཐམས་ཅད་ལ་ཐ་དད་མེད་པའི་གཙོ་བོ་གཅིག་འདོད་ནའང་སཱ་ལུ་དང་ནས་ཀྱང་གཅིག་ཡིན་པ་ཚདམ་ཉིད་ཀྱིས་སཱ་ལུའི་མྱུ་གུ་སྐྱེད་པར་བྱེད་པ་དང་།",
    "འོན་ཏེ་ཞེས་པ་ནི་དེའི་ལན་འུ་ཡུག་ཏེ་གྲངས་ཅན་ལ་འབྲས་བུ་སྐྱེད་པའི་ཚུལ་གཉིས་ཏེ་ཀུན་རྫོབ་དང་དོན་དམ་པར་སྐྱེད་པའོ།",
    "གཙོ་བོས་དོན་བྱེད་པ་སྟེ་དེ་ཡང་དུས་རིམ་གྱིས་ནས་ལ་སོགས་པ་ཐམས་ཅད་འབྲས་བུ་སཱ་ལུའི་མྱུ་གུ་ལ་སོགས་པ་ཐམས་ཅད་ཀྱི་བྱེད་པ་པོ་ཉིད་དུ་འདོད་དེ་སྔར་སཱ་ལུའི་ས་བོན་གྱི་ཚུལ་གྱིས་ས་འགྲེལ་ལུའི་མྱུ་གུ་སྐྱེད་པར་བྱེད་པ་དེ་འགྱུར་ནས་ཕྱིས་ནས་ཀྱི་ས་བོན་གྱི་ཚུལ་གྱིས་ནས་ཀྱི་མྱུ་གུ་སྐྱེད་པར་བྱེད་ཅེས་ཟེར་རོ།",
    "ཁ་ཅིག་སྤྱི་དང་ཁྱད་པར་གཉིས་དང་ལྡན་པའི་བུམ་པ་ལ་སོགས་པའི་རྫས་གཅིག་མཛོད་འདོད་ལ་དེ་ཉིད་ཀྱི་སྤྱི་དང་ཁྱད་པར་གཉིས་ཀྱང་ཐ་དད་མེད་པར་འདོད་དོ།",
    "སྤྱི་ནི་དུ་མར་འགྱུར་ཏེ་ཁྱད་པར་དང་ཐ་དད་མེད་པའི་ཕྱིར།",
    "ཡང་ཁྱད་པར་རྣམས་ནི་གཅིག་ཏུ་འགྱུར་ཏེ་སྤྱི་གཅིག་དང་ཐ་དད་མེད་པའི་ཕྱིར་རོ།",
    "ཤིན་ཏུ་ཐ་དད་མེད་པར་འགྱུར་ཏེ་ཁྱད་པར་གཏན་ནས་མེད་པའི་ཕྱིར་རོ།",
    "རྣམ་གྲངས་ཞེས་པ་སྤྱི་དང་ཁྱད་པར་དེ་དག་ཕན་ཚུན་ཐ་དད་དུ་འགྱུར་ཏེ།",
    "གཞན་ཡང་ཁྱད་པར་སྤྱི་དང་ལྡན་པར་ཡང་མི་འགྱུར་ཏེ་གཙོ་བོ་གནས་པ་ན་ཁྱད་པར་ལྡོག་པར་འདོད་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་ཞེས་པ་སྤྱི་དང་ཁྱད་པར་ནི་ཐ་དད་པ་ཁོ་ནའམ་ཐ་དད་མེད་པ་ཁོ་ནའང་མ་ཡིན་ཏེ་སྤྱི་དང་ཁྱད་པར་དེ་དག་ལ་ཡང་སྤྱི་ནི་ནུས་པའི་ངོ་བོ་ཡིན་ཏེ་གཙོ་བོས་གཞན་དག་སྐྱེད་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་ནི་གསལ་བའི་ངོ་བོ་ཡིན་ཏེ་འཇིག་རྟེན་པ་ཐམས་ཅད་ཀྱིས་ཏྟཱམཐོང་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་ན་འོག་ཏུ་སྤྱི་དང་ཁྱད་པར་དུ་འདོད་པ་དེ་དག་ལའང་སྤྱི་ཁྱད་པར་ཅན་དང་ཁྱད་པའི་རྣམ་པར་སྤྱི་ཅན་གྱི་བློར་སྐྱེ་བར་འགྱུར་ཏེ་དེ་དག་ལ་བྲེལ་པ་མེད་པའི་ཕྱིར་རོ།",
    "སྐྱེས་བུ་ཇི་ལྟ་བུ་ཞེ་ན་བསྒྲུབ་པར་བྱ་བའི་དོན་ཁྱད་པར་དེའི་འབྲས་བུ་རྨོ་བ་ལ་སོགས་པ་འདོད་པ་ཅན་ནོ།",
    "དེས་ན་འབྲས་བུའི་ཁྱད་པར་དེའི་རྟེན་ཐ་དད་པ་སྟེ་ཁྱད་པར་རིགས་ཡིན་ནམ།",
    "ཐ་དད་ཅེས་པ་སྟེ་མི་སྲིད་པར་འགྱུར་ཞེས་དྲང་ངོ།",
    "དཔྱད་པར་བྱ་བ་ཉིད་མ་ཡིན་ཞེས་དྲང་ངོ།",
    "འོ་ན་དངོས་མེད་ལ་དབྱེ་བ་མེད་པའི་ཕྱིར་སྒྲ་ཐ་དད་མེད་པར་འགྱུར་ཞེ་ན།",
    "རྟག་པ་དང་མ་བྱས་པ་ལ་སོགས་པ་བཅད་པ་ལ་ལྟོས་ནས་དུ་མ་འཇུག་ན་འདིར་ཡང་དགག་བྱ་ལ་ལྟོས་ནས་དུ་མ་འཇུག་གོ།",
    "ཇི་ལྟར་ཞེ་ན་ཁྱད་པར་གྱི་བྱེ་བྲག་འགའ་ཞིག་ལ་ལྟོས་པའམ།",
    "འོན་ཏེ་ཁྱད་པར་དང་བྲལ་བའི་རྟགས་འབའ་ཞིག་པའོ།",
    "དཔེར་ན་གང་ལྟ་བུ་ཞེ་ན་རིམ་པ་བཞིན་དུ་འཇིག་པ་སྒྲུབ་པ་ལ་འབྲས་བུ་བྱས་པ་དང་ཡོད་པ་བཀོད་པ་བཞིན་ནོ།",
    "དེ་ལ་ལྟོས་པ་ལ་གསུམ་ལས་དང་པོ་ཁྱད་པར་རྟགས་ཀྱི་ངོ་བོ་ལས་ཐ་དད་ཅིང་སྒྲས་མ་བརྗོད་པ་ནི།",
    "བྱས་པ་ལྟ་བུ་སྟེ་དེ་བྱེད་པ་པོའི་རྒྱུ་འུ་ཡུག་ལ་ལྟོས་ཀྱང་དངོས་སུམ་བརྗོད་པའི་ཕྱིར་རོ།",
    "འོ་ན་ཡོད་པའི་ཁྱད་པར་བསྒྲུབ་བྱར་འགྱུར་ཏེ་སྤྱི་གྲུབ་ཟིན་པས་བསྒྲུབ་བྱར་མི་རུང་བའི་ཕྱིར་རོ།",
    "འདོད་ན་ཁྱད་པར་རྗེས་འགྲོ་མེད་པའི་ཕྱིར་བསྒྲུབ་བྱ་ལས་ཉམས་ཞེས་མཛོད་སྦྱར་རོ།",
    "མཚན་ཉིད་ཡིན་པ་མི་ཤེས་པའི་ཕྱིར་ཞེས་གསུངས་སོ།",
    "ཁྱད་པར་རྗེས་འགྲོ་མེད་པའི་ཕྱིར།",
    "ཁྱད་པར་བསྒྲུབ་བྱར་མི་རུང་བ་དང་ཡོད་པའི་སྤྱི་སྒྲུབ་བྱེད་དུ་རུང་བར་བསྟན་པའོ།",
    "གང་ཞེ་ན་ཡོད་པའི་ཁྱད་པར་ཞེས་པ་ནི་ཡོད་པའི་བྱེ་བྲག་ནི་མ་ཡིན་ཏེ་ཚིག་ཕྱི་མ་གཉིས་དང་འགལ་བའི་ཕྱིར་རོ།",
    "ཡོད་པའི་སྤྱི་བསྒྲུབ་ན་གྲུབ་ཟིན་པ་དང་རྒོལ་བའི་འདོད་པ་མི་འགྲུབ་པའི་སྐྱོན་གཉིས་ཡོད་པའི་ཕྱིར་གྲངས་ཅན་ཡོད་པའི་རང་མཚན་བསྒྲུབ་ན་གཙོ་བོའི་ཁྱད་པར་ལས་འོས་མེད་ཅེས་སྟོན་པ་ནི་ཡོད་པ་ཞེས་པའོ།",
    "དེ་ཇི་ལྟ་བུ་ཞེ་ན་རྟགས་དེ་ཡོད་ཙམ་ལ་ཁྱབ་པར་བྱེད་པའོ།",
    "དྲུག་པའི་སྒྲ་ནི་ཕ་རོལ་གྱི་བསམ་པའི་ངོར་ཁྱད་པར་གཞན་མཛོད་སྤངས་ནས་བརྗོད་པའོ།",
    "དེ་ལ་ཁྱབ་བྱེད་ཅེས་པ་སྟེ་བྱས་པ་དེ་ལ་ཁྱབ་བྱེད་དུ་དོན་ལ་ངེས་པའི་མི་རྟག་པའི་རང་བཞིན་དེ་བློས་ཀྱང་དེ་ལྟར་ངེས་པ་གོ་བྱའོ།",
    "གང་ལ་ཞེ་ན་བྱས་པ་ལའོ།",
    "དེ་ལྟར་ཡིན་ན་ཡང་བུམ་པ་འགའ་ཞིག་ལ་འཇིག་པ་སྲིད་པར་མི་པའི་རྣམ་འགྱུར་ཏེ་ཐོ་བ་ལ་སོགས་པ་དང་མ་ཕྲད་པ་སྲིད་པའི་ཕྱིར་རོ།",
    "གང་ཞེ་ན་འགྲེལ་བུམ་པ་ལ་འཇིག་པས་ཁྱབ་པར་སྒྲུབ་པའི་རྟགས་སུ་བཀོད་པའི་འཇིག་རྒྱུ་ཐོ་བ་ལ་སོགས་པ་ཐམས་ཅད་དོ།",
    "གང་ལ་ཞེ་ན་ཡོད་པར་ངེས་པའི་ཐ་སྙད་ལ་སོགས་པ་དགག་པ་ལའོ།",
    "དེ་ལ་འཇུག་པ་ནི་བུམ་པ་ལ་སོགས་པ་ཡོད་པར་ངེས་པའི་ཤེས་པ་དང་ཡོད་པར་བརྗོད་པའི་སྒྲ་དང་ཡོད་པ་ལ་འཇུག་པའི་ཐ་སྙད་དོ།",
    "རྟགས་ཀྱི་ཞེས་པ་སྟེ་སྣང་རུང་རྟགས་ཀྱིས་ཁྱད་པར་དུ་ཡོད་ན་ཞེས་པའོ།",
    "བསྐལ་པའི་རྒྱུར་ངེས་པ་མི་སྲིད་ཀྱང་མ་བསྟན་པའི་ཡུལ་ཙམ་མེད་པར་རྟོགས་པའི་ཕྱིར་ཞེས་གསུངས།",
    "དོན་གྱི་ཞེས་པ་སྟེ་དོན་མཛོད་ནི་ཁྱབ་པར་བྱེད་པའོ།",
    "དེའི་རང་བཞིན་དུ་གྱུར་པའི་རྟགས་ཅན་ནི་ཁྱབ་པར་བྱ་བའོ།",
    "ལ་ཞེས་པ་ནི་དེ་མེད་པར་བསྒྲུབ་པར་བྱ་བ་ལ་ཁྱབ་བྱེད་ཀྱི་རང་བཞིན་མི་དམིགས་པ་ཡང་རྟགས་ཡིན་ཏེ་ཤིང་ཙམ་མེད་པས་ཤ་པ་མེད་པ་ལྟ་བུའོ།",
    "གལ་ཏེ་ཞེས་པ་སྟེ་གཏན་ཚིགས་སྣང་རུང་མ་དམིགས་པ་ཞེས་པ་འགའ་ཞིག་ལས་འབྲས་བུ་དང་ཁྱབ་བྱེད་མེད་པར་རྟོག་པར་འགྱུར་རོ།",
    "གལ་ཏེ་བུམ་པ་མ་མཐོང་། བས་བུམ་པ་མེད་པར་མི་འགྲུབ་སྟེ་བུམ་འཛིན་བཀག་པ་དེ་བུམ་པའི་འབྲས་བུ་བཀག་པ་ཙམ་ཡིན་པའི་ཕྱིར་ཞེ་ན།",
    "མ་ཡིན་ཏེ་རྟོགས་པར་འགྱུར་ཞེས་དྲང་ངོ།",
    "ཇི་ལྟར་ཞེ་ན་མ་དམིགས་པའི་དངོས་པོ་མེད་པར་ཞེས་པ་ནི་མཐོང་བ་དང་ལྡན་པའི་བུམ་པའི་དངོས་པོ་ཡོད་པར་རྟོགས་ཞེས་པ་སྟེ་དགག་པ་གཉིས་ཀྱིས་རྣལ་མ་གོ་བའི་ཕྱིར་རོ།",
    "འདི་ཡང་དགག་པ་གཉིས་ཀྱིས་རྣལ་མ་བསྟན་པ་སྟེ་བུམ་པ་མཐོང་བའི་རྒྱུ་ཐམས་ཅད་ཚང་ཞིང་གེགས་མེད་པའི་དུས་ན་དེ་ཡོད་པར་རྟོགས་ཏེ་དེ་ལྟ་བུའི་རྒྱུ་ལ་འབྲས་བུས་ཁྱབ་པའི་ཕྱིར།",
    "འགལ་བའི་ཞེས་པ་སྟེ་ངེས་པར་འགྱུར་ཞེས་དྲང་ངོ།",
    "འདིར་སྒྲུབ་པ་རྟགས་སུ་སྦྱར་ཡང་མ་དམིགས་པའི་རྟགས་ཡིན་ཏེ་མ་དམིགས་པ་ལས་འགལ་བར་རྟོགས་ཤིང་འགལ་བ་ལས་དངོས་པོ་མེད་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "དམ་བཅའ་བའི་ཚིག་མི་འཐད་པར་འགྱུར།",
    "རྟགས་ནི་རྟོག་པ་དེ་གཙོ་བོའི་རྗེས་སུ་འགྲོ་ལྡོག་བྱེད་པར་མ་དམིགས་པ་ཡིན་ཏེ་འདི་ལྟར་ལྡོག་པ་མེད་དེ་གཙོ་བོ་རྟག་པར་འདོད་པས་སོ།",
    "ཡོད་པར་འཛིན་པའི་རྟོག་པའི་བག་ཆགས་གོམས་པ་ལས་བྱུང་བ་དུ་བ་ལ་སོགས་པ་སྐྱེ་བར་རྟོག་པ་དང་།",
    "ཞེས་པ་སྟེ་དེ་ཞེས་པ་ནི་གཙོ་བོ་ལ་སོགས་པའི་སྒྲ་དོན་སྣང་བའི་རྟོག་པ་སྟེ་དེ་གཙོ་བོ་ལ་སོགས་པའི་དངོས་པོའི་ཉེར་ལེན་ཅན་མིན་པར་སྒྲུབ་པའོ།",
    "གཙོ་བོ་ལ་སོགས་པའི་སྒྲ་དོན་མི་སྤོང་ན་རང་མཚན་ཀྱང་གྲུབ་པར་འགྱུར་ཏེ་དེ་གཉིས་གཅིག་ཡིན་པའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་ན་སྒྲ་ཐམས་ཅད་དོན་དམ་ཁོ་ན་ལ་གཅིག་ཏུ་ངེས་པར་འཇུག་པ་ཁོ་ན་ཡིན་པས་ཞེ་ན་ལན་ནི་མཐོང་བའི་ཞེས་པ་སྟེ་འཇུག་པར་མི་འགྱུར་ཞེས་དྲང་ངོ།",
    "བརྫུན་ཚིག་མི་སྲིད་པར་ཡང་འགྱུར་རོ།",
    "དོན་ཞེས་པ་ནི་མ་དམིགས་པས་གཙོ་བོ་ལ་སོགས་པའི་སྒྲ་དོན་བཀག་ན་བསྒྲུབ་བྱ་མི་སྲིད་དེ་སྒྲ་དོན་དང་མེད་པའི་ཚོགས་དོན་བསྒྲུབ་པར་མི་འགྱུར་ལ་ཡན་གང་པའི་མེད་པ་རྐྱང་པ་རི་བོང་ལ་རྭ་མེད་པ་ལ་སོགས་པ་གྲུབ་ཟིན་པའི་ཕྱིར་རོ་ཞེས་པའོ།",
    "དཔྱད་པར་བྱ་ཞེས་དྲང་ངོ།",
    "དེ་དག་ཅེས་པ་སྒྲ་དེ་དག་སྨྲ་བ་པོའི་བརྗོད་འདོད་ཀྱི་བསམ་པ་སྟོན་ཅིང་དཔོག་པར་བྱེད་དེ།",
    "རྗེས་མཐུན་ཐབས་ནི་འབྲས་བུ་སྒྲུབ་པར་ནུས་པའི་ཐབས་སྟོན་པ་སྟེ་དུག་ཞི་བའི་དོན་དུ་འཇོག་པོའི་གཙུག་རྒྱན་ལེན་པའི་མན་ངག་ལྟ་བུ་མ་ཡིན་པའོ།",
    "ཡིད་ཆེས་ཞེས་པ་སྟེ་ཡིད་ཆེས་པའི་ཚིགས་ལས་ཤིན་ཏུ་ལྐོག་གྱུར་རྟོགས་པ་ནི་དེ་ལ་མི་བསླུ་བ་ཡིན་ཏེ་ཚིག་དེ་ལས་གཞན་བྱ་གཉིས་ལེགས་པར་རྟོགས་པ་བཞིན་ཞེས་སྟོན་པ་ནི་མི་བསླུ་དོན་ལྔ་བའི་སྤྱི་ཞེས་པ་ནི་གཞལ་བྱ་གཉིས་ལ་མི་བསླུ་བ་དང་མཚུངས་པའི་ཕྱིར་ཞེས་ཁྱབ་པ་རྟགས་སུ་བཀོད་པའོ།",
    "འདི་ཡུལ་ཞེས་པ་སྟེ་སློབ་དཔོན་གྱིས་གསུངས་ཞེས་དྲང་ངོ།",
    "དེ་ཅིར་གསུང་ཞེ་ན་རྗེས་སུ་དཔག་པར་རོ།",
    "བླང་དང་ཞེས་པ་སྟེ་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་ནོ་ཞེས་དྲང་ངོ།",
    "གང་ཞེ་ན་གཞན་ཞེས་པ་གཙོ་བོའི་དོན་མིན་པ་ཤིན་ཏུ་ལྐོག་གྱུར་གཞན་ལའང་ལུང་ཁྱད་པར་ཅན་ལ་བརྟེན་པའི་འུ་ཡུག་བློ་མི་བསླུ་བར་དཔག་པའོ།",
    "མི་ཤེས་ཀྱང་དེ་སྲིད་པར་སྒྲུབ་པའོ།",
    "གལ་ཏེ་ཞེས་པས་མི་ཤེས་པར་སྟོན་ཏེ་རྟོག་ལྡན་ནི་བརྟགས་ནས་ལུང་ཡིད་ཆེས་པའི་རྒྱུར་ཁས་ལེན་ལ་བརྟག་ན་ཁྱད་པར་ཅན་གྱི་ཚིག་འཇུག་པའི་རྒྱུར་མི་རུང་སྟེ་ཁྱད་པར་ཅན་དེ་ཤེས་པར་མི་ནུས་པའི་ཕྱིར་སརོ་། དེའི་ཚིག་བདེན་པ་འགོག་པ་ནི་མིན་ཏེ་དེའི་ཚིག་ལ་བསླུ་བ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "འགྲིབ་དང་ཞེས་པ་སྟེ་ཟད་པར་འགྱུར་ཞེས་དྲང་ངོ།",
    "འཕེལ་འགྲིབ་བྱེད་ཀྱང་རྩ་བ་ནས་ཟད་པར་མི་འགྱུར་ཞེ་ན་མིན་ཏེ་བློ་གཉེན་པོ་དེའི་བདག་ཉིད་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྦྱོར་བ་ནི་གང་ཞིག་གང་དང་ཉེ་ན་འགྲིབ་པ་སྟེ་དེ་ཤིན་ཏུ་འཕེལ་ན་གཏན་ཟད་པར་ཡང་འགྱུར་ཏེ་ཆུའི་སྟོབས་ཀྱིས་མེ་འགྲིབ་པ་བཞིན་ནོ།",
    "འདོད་ཆགས་ལ་སོགས་པའང་གཉེན་པོ་དང་ཉེ་ན་འགྲིབ་པར་མཐོང་ངོ་ཞེས་པའོ།",
    "ནིཉེས་པ་གཏན་ཟད་པར་མི་འགྱུར་ཏེ་སླར་ལྡོག་པ་སྲིད་པའི་ཕྱིར་རོ།",
    "འབད་པ་ས་། མེད་པ་ཉིད་ཅི་སྟེ་ཞེ་ན་གཉེན་པོའི་སྐྱོན་དང་སྤང་བྱའི་ཡོན་ཏན་མཐོང་ན་འབད་པ་བྱེད་པར་རིགས་པ་ལ་དེ་མི་སྲིད་དོ།",
    "ཆགས་པ་དེ་ལས་ཞེ་སྡང་སྐྱེ་སྟེ་ཆགས་ཡུལ་ལ་གནོད་པ་བྱས་ན་མི་བཟོད་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་པའི་སྐྱེས་བུས་མ་བྱས་པའི་ལུང་དགག་པ་ལ་གཉིས།",
    "སྒྲ་མ་བྱས་པ་ཉིད་དགག་པ་དང་།",
    "མ་བྱས་པའི་རྟགས་མ་ངེས་པར་བསྟན་པའོ།",
    "དེས་ན་སྐྱེས་བུས་མ་བྱས་པ་ལ་རྒྱུ་ཡོན་ཏན་མེད་པས་འབྲས་བུ་བདེན་པའི་དོན་ཅན་ཡང་མེད་དོ།",
    "དེ་མ་བྱས་པས་ན་མི་འཁྲུལ་ཞེ་ན་སྒྲའི་ངོ་བོ་སྐྱེས་བུས་བྱས་པ་མིན་ཡང་ང་།",
    "སྒྲ་དོན་གྱི་འབྲེལ་པའམ་བརྡ་ནི་སྐྱེས་བུས་བྱས་པ་ལ་ལྟོས་པ་མིན་ཏེ་རང་བཞིན་གྱི་དོན་དང་འབྲེལ་ལོ་ཞེ་ན།",
    "འོ་ན་བརྡའི་འབྲེལ་པ་ལས་གཞན་པའི་བརྟག་པའི་འབྲེལ་པ་ལས་དོན་གོ་བའི་ནུས་པ་མེད་པར་འགྱུར་ཏེ་དོན་རྟོགས་པའི་ཤེས་པ་བརྡ་ལས་སྐྱེས་པའི་ཕྱིར་དང་།",
    "འོ་ན་སྒྲ་དེ་ལས་དོན་གཞན་རྟོགས་པར་མི་འགྱུར་རོ།",
    "འོ་ན་མེ་ལ་སྦྱིན་སྲེག་སྦྱིན་ཞེས་པའི་སྒྲ་ལས་འདོད་པའི་དོན་འགྲེལ་དང་འགལ་བ་ཁྱི་གསོད་པའང་གསལ་བ་སྟེ་གོ་སྲིད་པར་འགྱུར་ལ་འདོད་ན་ངག་དེས་སྐྱེས་བུ་མཐོ་རིས་ཀྱི་རྒྱུ་ལས་བཟློག་པར་འགྱུར་རོ།",
    "ཡང་སྐྱེས་བུས་ཞེས་པ་སྟེ་སྐྱེས་བུའི་ཚིག་ལ་བསླུ་བ་སྲིད་པ་དེ་བསལ་བའི་རིགས་དོན་དུ་སྒྲ་སྐྱེས་བུས་མ་བྱས་པར་བརྟག་པ་དོན་མེད་དུ་འགྱུར་ཏེ།",
    "ཐ་མི་དད་ན་གཉིས་ཀའི་རང་བཞིན་ཉམས་པར་འགྱུར་ཏེ།",
    "རྣམ་པ་ཀུན་ཏུ་སྟེ་བདེན་རྫུན་གྱི་དོན་གཉིས་ཀ་གཏན་མེད་དུ་འགྱུར་ཏེ་མ་བྱས་པའི་ཕྱིར་རོ།",
    "བདེན་རྫུན་གྱི་དོན་གང་ལུང་དང་ལྡན་པ་ལ་སྐྱེས་བུས་བྱས་པས་ཁྱབ་པའོ།",
    "མི་བྱེད་པ་ཞིག་དང་པོ་ལྟར་ན་དེ་འཁྲུལ་པར་འགྱུར་ཏེ་སྐྱེས་བུས་བྱས་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་དོན་དགུ་ལྟར་ན་དེས་སྐྱེས་བུས་འདོད་པའི་དོན་ཡུལ་དུས་ངེས་པ་ཅན་དུ་སྟོན་མི་ནུས་པར་འགྱུར་ཏེ་རི་བོ་བཞིན་དུ་འདོད་པས་འགའ་ཞིག་ཏུ་སྦྱར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "འོ་ན་འདོད་རྒྱལ་བའི་སྒྲ་ལ་སོགས་པ་མི་སྲིད་པར་འགྱུར་ཏེ།",
    "དེ་ཕྱིར་ཞེས་པ་སྟེ་ལེགས་པར་བྱས་ཞེས་དྲང་ངོ།",
    "རྟེན་ཞིག་ཀྱང་བརྟེན་པ་མི་འཇིག་པར་འདོད་པ་དགག་པའོ།",
    "འོ་ན་མཛོད་སྒྲ་རྣམས་ལ་འབྲེལ་པ་སྔར་དོན་ཕྱི་མ་དང་འབྲེལ་པ་མེད་པའི་རང་བཞིན་དེ་དོན་ཕྱི་མ་སྐྱེས་པའི་ཚེ་བཟློག་པར་འགྱུར་རོ།",
    "རྟེན་ཞེས་པ་བསྐྱེད་པ་པ་ལ་མི་བརྗོད་ཀྱི་གསལ་བ་དང་བརྗོད་བྱས་རིགས་དང་འབྲེལ་པ་ལ་སོགས་པ་གསལ་བར་བྱེད་པའོ་ཞེ་ན།",
    "གང་ཞེ་ན་རིགས་ལ་སོགས་པར་མ་ཟད་བུམ་པ་ལ་སོགས་པ་གསལ་བྱར་གྲགས་པ་རྣམས་ཀྱང་ངོ།",
    "ཅི་སྟེ་ན་བུམ་འཛིན་གྱི་ཤེས་པ་སྐྱེད་པའི་རྐྱེན་སྒྲོན་མ་ལ་སོགས་པ་རྣམས་ཚོགས་ན་བུམ་པ་དེ་བུམ་འཛིན་གྱི་ཤེས་པ་དེ་སྐྱེད་པར་རུང་བ་ཉིད་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "ནུས་པ་བུམ་པ་ལས་ཐ་དད་ན་པའི་རྣམ་མས་བུམ་པ་ལ་ཕན་མ་བཏགས་པར་འགྱུར་ལ་འདོད་ན་སྣང་བ་ལ་མ་ལྟོས་པར་བུམ་སོགས་འཛིན་པར་འགྱུར་བ་དང་ནུས་པ་ཐ་དད་ལས་ཤེས་པ་སྐྱེ་ན་དེས་ནུས་པ་ཉིད་འཛིན་པར་འགྱུར་ལ་འདོད་ན་བུམ་སོགས་གཏན་མི་འཛིན་པར་འགྱུར་རོ།",
    "གཉིས་པ་དེ་རིགས་ལ་སོགས་པ་ལ་མི་སྲིད་པར་བསྟན་པ་ནི།",
    "ཅི་སྟེ་ན་རིགས་ལ་སོགས་པ་ཁྱད་པར་དུ་བྱར་མཛོད་མེད་པའི་ཕྱིར་རོ།",
    "གཞན་སྒྲ་དོན་གཉིས་ལ་རག་ལས་པར་ཇི་ལྟར་འགྱུར་ཏེ་དེ་དངོས་པོར་གྲུབ་ཟིན་པའི་ཕྱིར་ཏེ་བུམ་པ་བཞིན་ནོ།",
    "འདོད་ན་འབྲེལ་པར་མི་རུང་སྟེ་རག་མ་ལུས་པའི་ཕྱིར་རོ།",
    "འབྲེལ་པ་ནི་སྒྲ་དོན་དེ་དག་ལས་ཐ་དད་མིན་ཞེ་ན་འོ་ན་དེ་ཉིད་ཅེས་པ་སྒྲ་དོན་དེ་ཉིད་འབྲེལ་པར་གྱ་གཅིག་འགྱུར་རོ།",
    "འདོད་ན་འབྲེལ་པ་མེད་པར་འགྱུར་རོ།",
    "དེས་ན་ཚིག་སོགས་ལ་དངོས་པོའི་འབྲེལ་པ་འདི་ཇི་ལྟར་འཇུག་པར་འགྱུར་ཏེ་མི་འགྱུར་རོ།",
    "དེ་ཉིད་ཀྱང་ཀུན་བཏགས་ཏེ་ཉན་ཤེས་ཁྱད་པར་ཅན་གྱི་རྗེས་ལས་བྱུང་བའི་རྟོག་པས་སྒྲ་དོན་གཅིག་ཏུ་སྒྲོ་བཏགས་པའི་ཕྱིར་འུ་ཡུག་རོ་། གཉིས་པ་སྒྲ་མ་བྱས་པ་ཉིད་དགག་པ་ལ་གཉིས་ཏེ།",
    "མ་བྱས་པའི་སྒྲུབ་བྱེད་དགག་པ་དང་།",
    "དེ་ཕྱིར་འདི་མ་བྱས་པའོ་ཞེས་ཟེར་རོ།",
    "དེས་སྒྲ་མ་བྱས་པར་མི་འགྲུབ་བས་གྱ་དང་།",
    "མ་བྱས་པ་ལ་གནོད་པ་མཐོང་བ་དང་།",
    "དེས་ཐོག་མེད་དུ་གྲུབ་ཀྱང་མ་བྱས་པར་མི་འགྲུབ་པ་དང་།",
    "རྒྱུ་སྐྱེས་བུ་དེ་ལས་སྐྱེ་བར་འགྱུར་བར་ཡང་དག་པར་ཤེས་ཏེ་སྒྲའི་རིགས་གང་སྐྱེས་བུ་གང་ལས་གྲུབ་པ་སྟེ་སྐྱེས་བུའི་རྗེས་སུ་འགྲོ་ལྡོག་ངེས་པའི་སྒྲ་དེ་དང་འདིའི་རང་བཞིན་ཁྱད་པར་མ་མེད་པའི་ཕྱིར་ཏེ་མེ་གཅིག་ཤིང་ལས་སྐྱེས་པར་གྲུབ་ན་དེའི་རིགས་ཅན་གཞན་ཤིང་ལས་སྐྱེ་བར་མ་མཐོང་ཡང་དེ་ལས་སྐྱེས་པར་རྟགས་ཀྱིས་འགྲུབ་པ་བཞིན་ནོ།",
    "གལ་ཏེ་ཁྱད་པར་མེད་པར་མ་གྲུབ་སྟེ་བཀློག་དཀའ་སླ་དང་ནུས་པ་ཆེ་ཆུང་ལ་སོགས་པའི་འུ་ཡུག་ཁྱད་པར་མཐོང་བས་ཞེ་ན།",
    "དེ་དག་བྱས་མ་བྱས་གཉིས་ཀ་ལ་མཐོང་བའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་ཐོག་མའི་རིག་བྱེད་འདོན་པ་འགའ་ཞིག་ལ་སློབ་དཔོན་མེད་པར་རང་ཉིད་ཀྱིས་ཤེས་ནས་རིགས་འཆད་པ་ཡིན་ནོ།",
    "ཇི་ལྟར་ཞེ་ན་འཇིག་རྟེན་གྱི་སྒྲ་དང་མཛོད་ཁྱད་པར་མ་བསྟན་པར་རོ།",
    "དུ་གྲུབ་པ་དེའི་ཕྱིར་སྐྱེས་བུས་མ་བྱས་པར་གྲུབ་ཅེ་ན།",
    "དགེ་སྡིག་དང་ཕ་རོལ་མེད་པ་ལ་སོགས་པའང་ཐོག་མ་མེད་པའི་ཕྱིར་མ་བྱས་པར་འགྱུར་རོ།",
    "དེ་དག་ཐོག་མེད་དུ་ཅིས་འགྲུབ་ཅེ་ན་སྔོན་ལེགས་པར་འདུས་བྱས་པའི་མཐུས་རྒྱུན་གྱིས་འཇུག་པའི་ཕྱིར་རོ།",
    "དོན་གྱི་ཞེས་པ་ནི་རིག་བྱེད་ཀྱི་སྒྲ་མ་བྱས་ཀྱང་དོན་ལ་ཐེ་ཚོམ་དུ་འགྱུར་ཏེ་དོན་གྱི་འདུ་བྱེད་ཅེས་པ་སློབ་དཔོན་རྣམས་དོན་ཐ་དད་དུ་གྱ་གསུམ་འཆད་པ་མཐོང་བའི་ཕྱིར་རོ།",
    "ངག་མ་བྱས་པ་དགག་པའོ།",
    "འདོད་རྣམ་འགྲེལ་ན་སྐྱེས་བུས་བྱས་པར་འགྱུར་ཏེ་མི་ལ་སེང་གེ་ལ་སོགས་པར་སྒྲོ་བཏགས་པ་བཞིན་ནོ།",
    "སྐད་ཅིག་ལ་བརྗོད་བྱ་རྟོགས་པར་འགྱུརམཛོད་རོ་། གཉིས་པ་དེའི་ལན་དགག་པ་ནི།"
  ]
}