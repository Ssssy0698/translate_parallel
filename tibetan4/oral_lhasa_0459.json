    "དེ་དག་ཕྱིར་རྒོལ་བརྒྱན་པར་བསྒོམ།",
    "ནམ་མཁའི་ཁམས་ཀུན་གཡོས་པར་བསྒོམ།",
    "གསུངས་པ་ཉིད་ཀྱང་མ་གྲུབ་པོ།",
    "མཉེས་བྱས་སྔོན་བཞིན་རང་ཉིད་ཞུགས།",
    "བདག་པོ་ང་རྒྱལ་དང་ལྡན་པར།",
    "འཁོར་ལོ་བདག་ལ་ཞུགས་བྱས་ཏེ།",
    "ཞག་བདུན་སོགས་པར་ཡང་དུ་བརྟག།",
    "ཇི་སྐད་གསུངས་པ་ཐོབ་པར་འགྱུར།",
    "དེ་ལྟར་བྱས་ཀྱང་ཕྱག་རྒྱ་ཆེ།",
    "དབྱེ་བའི་སྒོ་ནས་བསྒྲུབ་པར་བྱ།",
    "རྗེ་བཙུན་རྣམས་ཀྱི་སྤྱན་སྔར་བཤགས།",
    "ཅི་བཞིན་བྱིན་གྱིས་བརླབས་བྱས་ནས།",
    "དངོས་གྲུབ་རྣམ་པར་འཕྲུལ་འདི་བྱ།",
    "གླུ་དང་སིལ་སྙན་རྣམ་པར་འབུལ།",
    "དག་པའི་གདན་ཆེན་བཤམ་པར་བྱ།",
    "དངོས་གྲུབ་ཕྱིར་ནི་རྣམ་པར་རོལ།",
    "དེ་ཀུན་མཉེས་པར་བྱ་དགོས་སོ།",
    "གཞན་བཞིན་འཁོར་ལོར་བསྒྲུབ་བྱས་ལ།",
    "གོང་གསུངས་གཏོར་མའི་ཚོགས་རྣམས་ཀྱིས།",
    "དེ་དག་ཚིམ་པར་ཡང་བྱའོ།",
    "ཉམས་པར་དོགས་པ་ཐམས་ཅད་བསལ།",
    "མ་ཉམས་སྐྱོན་མེད་སྤྱོད་པར་ལྡན།",
    "རྡོ་རྗེ་དམ་ཚིག་བསྐྱེད་བྱས་ནས།",
    "མྱུར་དུ་དངོས་གྲུབ་ཐོབ་པར་འགྱུར།",
    "དེ་ལ་ཁྲོས་པར་རིག་པ་ཡིན།",
    "དམ་པའི་གཞུང་ལས་གསུངས་པ་ལྟར།",
    "བདག་དང་འཁོར་ལ་དམིགས་བྱས་ནས།",
    "གནས་ཤིང་ཁྲོས་པ་བསམ་བྱས་ཏེ།"
