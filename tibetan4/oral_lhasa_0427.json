    "སྐྱེས་བུ་གདུལ་བའི་ཁ་ལོ་སྒྱུར་བ་བླ་ན་མེད་པ་ཞེས་གསུངས་ཏེ།",
    "ཡོན་ཏན་གྱི་ཁྱད་པར་བསྐྱེད་པའི་ཕྱིར་ཏེ།",
    "བློ་ཁྱད་པར་དུ་འཕགས་པ་ཡང་རྣམ་པ་དགུ་སྟེ།",
    "ཐམས་ཅད་མཁྱེན་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་དང་།",
    "བསྒྲིམ་མི་དགོས་པར་མཁྱེན་པ་དང་།",
    "ལུང་ཕོག་པ་མེད་པར་མཁྱེན་པ་དང་།",
    "ཡང་ན་སྟོན་པ་པོ་བཅོམ་ལྡན་འདས་ལ་དད་པའི་ཁྱད་པར་བསྐྱེད་པའི་ཕྱིར་རོ།",
    "དེ་དང་ལྡན་པའང་སྟོན་པར་བྱེད།",
    "གསུངས་པ་ཉིད་ཀྱི་མཚན་ཉིད་དང་།",
    "དེ་ལ་གསུངས་པ་ཉིད་ཀྱི་མཚན་ཉིད་ནི།",
    "ཡོངས་སུ་རྫོགས་པར་བསྟན་ཏེ།",
    "ཡང་ན་ཁོང་དུ་ཆུད་པ་ལ་བྱ་བར་ཤེས་པར་བྱའོ།",
    "གལ་ཏེ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བའི་དུས་ལ་བབ་པ་པར་ངེས་ན།",
    "འདི་ནི་རབ་ཏུ་མ་བྱུང་བའི་སྔ་རོལ་གྱི་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དེ་ལོ་བདུན་ཁྲིར་ལན་འགའ་ཡང་ས་ལ་གློས་མ་ཕབ་སྟེ་ཞེས་གསུངས་སོ།",
    "གཅིག་ཏུ་ངེས་པར་ནང་དུ་ཡང་དག་འཇོག་ལ་གནས་སོ་ཞེས་གསུངས་ཏེ།",
    "གཅིག་ཏུ་ངེས་པའི་སྐྱེ་བོ་མེད་པའི་ཕྱོགས་སམ་གཅིག་ཏུ་ངེས་པར་ནང་དུ་ཡང་དག་འཇོག་པས་རང་བཞིན་གྱིས་སེམས་རྩེ་གཅིག་ཏུ་བྱེད་པ་ལ་ནི།",
    "གཅིག་ཏུ་ངེས་པར་ནང་དུ་ཡང་དག་འཇོག་ལ་བྱའོ།",
    "ལོ་དགུ་ཁྲི་ཞེས་གསུངས་སོ།",
    "བྱས་པའི་ཚིག་ལ་ཉེས་པ་མེད།",
    "འཇིག་རྟེན་གྱི་ཁམས་གཞན་ན་བཞུགས་པ་རྣམས་འཕགས་པ་སྒོ་མཐའ་ཡས་པ་སྒྲུབ་པའི་གཟུངས་ཀྱི་རྒྱ་ཆེར་འགྲེལ་པ།",
    "སྔ་ཕྱི་མེད་པར་དེ་བཞིན་གཤེགས་པ་གཉིས་འཇིག་རྟེན་དུ་མི་འབྱུང་ཞེས་བྱ་བ་འདི་ནི།",
    "ཡང་ན་སྔ་ཕྱི་མེད་པར་མི་འབྱུང་ཞེས་སྨོས་པས་དེ་དག་རིམ་གྱིས་བྱུང་བ་ཁོ་ནར་བཀའ་སྩལ་པ་ཡིན་ནོ།",
    "ལོངས་སྤྱོད་རྫོགས་པའི་སྐུའི་ཚུལ་གྱིས་བཞུགས་པ་དེས་ན།",
    "མང་པོ་ཡང་དག་པར་དམིགས་པ་ཙམ་དུ་ཟད་པའི་ཕྱིར་ཉེས་པ་མེད་དོ།",
    "དེ་ཐོས་པ་ནི་བསྟན་པ་ཐོས་པར་ཟད་ན་་བསྟན་པ་ཞེས་སྨོས་ཅི་དགོས་ཞེས་དེ་སྐད་ཟེར་ན་ནི།",
    "སྟོན་པར་འགྱུར་རོ།",
    "ཡོན་ཏན་སྐྱེད་པར་འགྱུར་བ་ཡིན།",
    "དེས་ན་ཐུབ་པ་བཞུགས་པ་ནི།",
    "བཅོམ་ལྡན་འདས་དེ་དེ་སྲིད་ཀྱི་བར་དུ་བཞུགས་པ་ནི་རྒྱལ་པོའི་བུ་དེ་དེས་གདུལ་བ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "གཟུངས་ནི་ཐོབ་པར་ཐུབ་པ་དེས།",
    "བརྩོན་འགྲུས་བརྩམས་པས་གཟུངས་འདི་ཐོབ་པར་འགྱུར་གྱི།",
    "གཞན་གྱིས་མ་ཡིན་པར་ནི་ལོ་དགུ་ཁྲི་ཞེས་བྱ་བ་ལ་སོགས་པས་བསྟན་ཏེ།",
    "གཟུངས་འདི་འཐོབ་པར་འགྱུར་གྱི།",
    "གཞན་གྱིས་མ་ཡིན་པར་ནི་བསྒྲུབས་ནས་ཀྱང་ཞེས་བྱ་བ་ལ་སོགས་པས་བསྟན་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་ན་ནི་རབ་ཏུ་བྱུང་བ་ལ་སོགས་པ་བསྟན་པ་ཡང་དོན་མེད་པར་འགྱུར་རོ།་",
    "ཡང་དག་པར་རབ་ཏུ་བསྟན་པ་དང་།",
    "ཡང་དག་པར་རབ་ཏུ་བསྟན་པའི་འབྲས་བུའོ།",
    "ཡང་དག་པར་རབ་ཏུ་བསྟན་པ་ཡང་།",
    "ཡང་དག་པར་སྦྱིན་པ་དང་།",
    "ཐམས་ཅད་ཀྱི་སྒྲ་ནི་བརྗོད་པར་འདོད་པས་མ་ལུས་པ་ལ་བྱ་བའི་ཕྱིར་རོ།",
    "དེ་དག་ལ་ནི་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་པས་ཡང་དག་པར་རབ་ཏུ་བསྟན་པར་བྱ་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཡང་དག་པར་ཕྱིན་ཅི་མ་ལོག་པ་དང་།",
    "ཡང་དག་པར་རབ་ཏུ་བསྟན་པའི་འབྲས་བུ་ནི།",
    "དེའི་ཕྱིར་དེའི་འོག་ཏུ་ཤཱ་རིའི་བུ་འཁོར་དེ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཟུངས་ཐོབ་པ་རྒྱུན་གྱིས་འབྲེལ་པས་ནི་ཇི་ལྟ་བུར་བརྩོན་པར་བྱེད་ཀྱང་རུང་བ་གང་དང་གང་ཡིན་པ་དེ་དང་དེས་ནི།",
    "གཟུངས་འདི་ངེས་པ་ཁོ་ནས་འཐོབ་པར་འགྱུར་ཏེ།",
    "ང་ལ་ལས་མ་ཐོབ་པ་གང་ཡིན་པ་དེ་ནི་བདག་ཉིད་ཀྱི་ཉེས་པ་ལ་སོགས་པ་ལས་གྱུར་པར་བསྟན་ཏོ།",
    "དེ་དག་མཉེས་པར་བྱ་བའི་དུས་དང་།",
    "མཉེས་པར་བྱ་བ་དང་།",
    "༧ འཁོར་ལོ་དང་བཅས་པར་ཟུང་ཤིག་ཅེས་བྱ་བ་ལ་སོགས་པ་དེ་བཞིན་དུ།",
    "དགུ་བཅུ་ཞེས་བྱ་བའི་ཚིག་གང་ཡིན་པ་དེས་ནི་དུས་གཞན་ལ་དགོངས་ཏེ་གསུངས་པ་ཡིན་ནོ།",
    "ཡང་ན་ཕུལ་དུ་ཕྱིན་པ་མ་ལུས་པའི་མཚན་ཉིད་དང་ལྡན་པའི་སྒོ་མཐའ་ཡས་སྒྲུབ་ཀྱི་པའི་གཟུངས་ནི་ཐོབ་པར་གྱུར་པའི་ཕྱིར།",
    "ཡེ་ཤེས་ཁྱད་པར་དུ་འཕགས་པ་ནི།",
    "རྫུ་འཕྲུལ་ལ་སོགས་པས་འདུན་པར་བྱེད་པའོ།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ།",
    "བསྒྲུབ་པ་མཉེས་བྱེད་ཡིན་པར་འདོད།",
    "མ་ཞིག་མ་རལ་བ་ལ་སོགས་པའི་ཡོན་ཏན་དང་ལྡན་པ་སྒྲུབ་པ་གང་ཡིན་པ་དེ་ནི་མཉེས་པར་བྱེད་པ་ཡིན་པར་འདོད་དོ།",
    "ཚོགས་ཡོངས་སུ་རྫོགས་པ་ནི་མཉེས་པར་བྱས་ནས་ཞེས་བྱ་བ་འདིས་བསྟན་ཏེ།",
    "༡ ༣༩པར་བྱེད་ན་དེ་ལྟར་དེ་དག་ཤིན་ཏུ་མཉེས་པར་བྱས་པ་ཡིན་ནོ།",
    "དེ་བཞིན་གཤེགས་པ་མར་མེ་མཛད་དུ་གྱུར་ཏོ་ཞེས་ངེས་པར་བྱ་བའི་ཕྱིར་ཡང་།",
    "ཚོང་དཔོན་གྱི་བུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཡོངས་སུ་བཅད་པར་མི་རུང་ཕྱིར།",
    "དེའི་ཕྱིར་མིང་གསུམ་དུ་གསུངས་སོ།",
    "ཤཱ་རིའི་བུ་ང་དང་བསྐལ་པ་བཟང་པོའི་ཞེས་བྱ་བ་ལ་སོགས་པ་འདི་ནི་སྤྱིར་གསུངས་པ་ཡིན་ཏེ།",
    "ཁ་ཅིག་ཏུ་ནི་ཉུང་ངུ་ཞིག་ཏུ་བྱེད་པར་འགྱུར་བ་ཙམ་དུ་ཟད་དོ།",
    "གཟུངས་བསྟན་པས་གདུལ་བ་ཐམས་ཅད་ཀྱི་འབྲས་བུ་ནི་དེ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ད་ནི་བཞེད་པའི་དོན་བསྒྲུབས་ནས་དེ་ལྟ་བས་ན་ཞེས་བྱ་བ་ལ་སོགས་པས་མཇུག་སྡུད་པར་མཛད་དེ།",
    "དེ་བཞིན་དུ་གཞན་ཡང་བསམ་པའི་སྟོབས་ཀྱིས་དེ་ལས་ལྷག་པར་ཡང་ཕྱིར་བསྙིལ་བར་བྱེད་དེ།་",
    "དེ་ལྟ་ེབས་ན་མྱུར་དུ་ཞེས་བྱ་བ་གསུངས་སོ་། དེའི་གཏན་ཚིགས་བཀའ་སྩལ་པ།",
    "རྒྱུད། ནུ་༧༣ ཀཀཀཔོ་དེ་ཉིད་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "སྦྱོར་བས་གཟུད་པ་བསྙད་པ་ནི་ཡི་གེར་འདྲི་བ་ལ་སོགས་པ་རྣམ་པ་བདུན་གསུངས་པ་ཡིན་ནོ།",
    "འདིར་ནི་ཀུན་ཆུབ་བྱེད་པར་བསྟན།",
    "དོན་དང་ཡི་གེ་གཉི་གའི་སྒོ་ནས་ཀུན་ཆུབ་པར་བྱེད་པ་ནི།",
    "ཀུན་ཆུབ་པར་བྱེད་པ་སྟེ།",
    "ཀུན་ནས་ཆུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "འདིར་ཡང་ཀུན་ཆུབ་པར་བྱེད་པར་བསྟན་ཞེས་བྱ་བ་དང་སྦྱར་རོ།",
    "འདིར་ཡང་ཀུན་ཆུབ་བྱེད་པར་བསྟན།",
    "དེ་ནི་རྒྱ་ཆེར་ཡང་དག་པར་རབ་ཏུ་སྟོན་པའོ།",
    "ཉན་པ་པོས་ིཚད་དེ་ནི་བསམ་པར་མི་ནུས་སོ།",
    "ཤེས་པར་བྱར་མེད་པ་དང་།",
    "ཤེས་བྱ་མ་ལུས་མཁྱེན་པའི་ཕྱིར།",
    "མངོན་སུམ་ཡོངས་སུ་མཁྱེན་པ་དང་།",
    "དགོངས་པར་ཡང་ནི་སྤྱོད་པ་ཡིན།",
    "དེ་བས་ན་དེ་བཞིན་གཤེགས་པ་མ་གཏོགས་པར་ཞེས་གསུངས་པའི་ལྷག་མའོ།",
    "དོན་དེ་ཚིགས་སུ་བཅད་པརྣམས་ཀྱིས།",
    "ཐུབ་པ་ཡིས་ནི་བཟླས་ཏེ་གསུངས།",
