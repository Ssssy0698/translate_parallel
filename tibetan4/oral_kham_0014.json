    "ཡང་རང་རྒྱུད་ལ་རིག་པ་ཙམ་རིག་པ་ཕྱི་མ་བསྐྱེད་པར་གྲུབ་པས་རིག་པ་ཕྱི་མ་མི་བསྐྱེད་པའི་རིག་པ་ཙམ་དངོས་སུ་ཁེགས་པ་ན་ཕྱི་མ་མི་བསྐྱེད་པའི་རིག་པའི་བྱེ་བྲག་ཐམས་ཅད་ཤུགས་ལ་ཁེགས་ཏེ་སྒྲོན་མ་ཙམ་གྱིས་འོད་འབྱིན་པར་གྲུབ་པས་འོད་མི་འབྱིན་པའི་སྒྲོན་མའི་བྱེ་བྲག་ཐམས་ཅད་ཤུགས་ལ་ཁེགས་པ་བཞིན་ནོ་ཞེས་གསུང་ངོ།",
    "བེམས་པོ་ལས་ལོག་པའི་ཕྱིར་རང་རིག་མངོན་སུམ་བཞིན་ཞེས་བཀོད་པ་ན་མངོན་སུམ་དང་རང་རིག་ཁྱབ་མཉམ་ཡང་དཔེ་དང་ཤེས་འདོད་དུ་འགྱུར་བ་བཞིན་ནོ།",
    "མི་དམིགས་པ་ཐམས་ཅད་དཔེ་ལ་སྣང་རུང་མི་དམིགས་པར་འདུ་ལ་དེ་བདག་གཅིག་པའི་འབྲེལ་པ་ལ་བརྟེན་པས་རང་བཞིན་གྱིས་རྟགས་ཡིན་ཅིང་དེ་དག་བཟློག་པས་མི་དམིགས་པའི་འགལ་བའང་རང་བཞིན་འགལ་བའི་ལྟར་སྣང་དུ་འདུ་བས་འགལ་བའང་གཉིས་ཉིད་དེ།",
    "སྒྲ་དོན་དང་རང་མཚན་སོ་སོར་མ་ཕྱེ་བར་ཚོགས་དོན་བསྒྲུབ་བྱའོ།",
    "ཞེས་བརྗོད་པས་དགག་སྒྲུབ་སྒྲ་དོན་ལ་བྱས་ཀྱང་རང་མཚན་གོ་བ་ཡིན་ཏེ།",
    "གཞན་དག་ལུང་དང་རང་ཚིག་ཟེར།",
    "རང་ཚིག་དང་ཁྱད་པར་མེད་པས་དེ་ཁས་བླངས་ནས་འགལ་ཡང་རང་ཚིག་དང་འགལ་བ་དང་།",
    "བརྗོད་འདོད་ཀྱི་གྲགས་པ་ཁས་མི་ལེན་ན་ཁྱེད་རང་ཁས་ལེན་པའི་རི་བོང་ཅན་ལ་སོགས་པར་འདོད་པའང་འཇིག་པས་ཐ་སྙད་ཐམས་ཅད་འཇིག་པར་འགྱུར་རོ།",
    "དམ་བཅའ་དང་རང་ཚིག་འགལ་བ་དཔེར་ན་དགེ་སྦྱོང་མ་སྦྲུམ་མའམ་བདག་མེད་དོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "ཡང་རང་ལ་གྲུབ་པའི་བ་ལང་ཉིད་ལ་སོགས་༣༤༦",
    "ཞེས་བསྲེགས་ཏེ་མི་སྨྲ་བར་འདུག་ན་སྐབས་དོན་གྲུབ་བོ་སྙམ་ན།",
    "མི་སྨྲ་བར་འདུག་གམ།",
    "ཁྱེད་རང་དེར་མི་འདོད་པའི་ཕྱིར་སྐྱེས་བུ་རྐུན་མ་ལ་རྟགས་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་སྒྲ་རྟག་སྟེ་མཉན་བྱ་ཡིན་པའི་ཕྱིར་སྒྲ་ཉིད་བཞིན་ཞེས་ཟེར་བ་མ་ངེས་པར་འདུག་ལ།",
    "དེའང་རང་དོན་དུ་དོན་གྱི་སྐྱོན་འབའ་ཞིག་དཔྱད་ལ་གཞན་དོན་དུ་བློ་དང་སྒྲའི་སྐྱོན་ཡང་དཔྱད་དོ།",
    "མེ་དང་སྤུ་ལོང་བྱེད་པ་ཕན་ཚུན་འགོག་པ་རྒྱུ་དང་འགལ་བ་དམིགས་པ་དང་རང་བཞིན་འགལ་བའི་འབྲས་བུ་དམིགས་པ་གཉིས་དང་།",
    "ཚུར་ལོག་དུས་ཨོཾ་གྱི་ཚུལ་དུ་ཡུམ་གྱི་བྷ་ག་ནས་ཞུགས།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ན་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "བདག་ཅག་དུས་འདི་ནས་བཟུངས་ནས།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "གང་སྤྱོད་དེ་ཡང་རང་བཞིན་སྟོང་པ་སྟེ།",
    "རབ་རིབ་ཅན་ལ་བརྒལ་ཞིང་བརྟག་པ་ལྟར་ཕར་འདུག་ཅིག།",
    "གདའ་བདའ་བརྡ་ལྡ་ཡོད་གདའ་དང་།",
    "ལས་ལོས་སྔོན་ལས་ལོས་ཡིན་སྙམ།",
    "ཡིན་ན་ཡང་ཁོང་རང་ཉིད་སྔར་བཞིན་ལྟོ་སྐྱ་གོས་ཧྲུལ་དང་།",
    "བདག་གཞན་དུས་གསུམ་གྱི་རྣམ་བཞག་དུས་གསུམ་གྱི་ལས་ཚིག་རྣམས་འདུམ་བདེ་ཕྱིར་སྤྱི་བྱེ་ཐོར་གསུམ་དུ་དབྱེ་ཚུལ།",
    "བཀད་ས་ནི་གཡོས་ཁང་ངམ་འདུག་ས་ཞེས་འབྱུང་།",
    "འཇིགས་ནས་སྐད་ཆུང་ངུར་སྨྲས་པའམ་ཁ་རོག་འདུག་པ་སྟེ།",
    "རྒས་པ་ཁད་ཀྱིས་ཁད་ཀྱིས་འོང་བའི་དྲག་དུས་གཅིག་ལ་འོང་ན་བསྲན་ཐབས་མེད་ཞེས་དང་།",
    "དགག་སྒྲུབགཞན་ལུགས་མི་འཐད་པར་སུན་འབྱིན་པ་དང་རང་ལུགས་འཐད་ལྡན་དུ་བཞག་པ།",
    "ཞབས་དྲུངམདུན་འདུག་པའམ་དྲུང་ཡིག་པ་ལ་ཟེར།",
    "ཟ་མ་ཏོག་བཀོད་པ་ན་གདོས་པ་འཛིན་པར་བསྒྱུར་འདུག་པས།",
    "དེ་ད་བྱིད་དུ་བསྒྱུར་ནས་འདུག་སྙམ་གསུངས།་",
    "ས་མྱུག་དུས་མཉམ་འགྱུར་བ་དང་།",
    "སིང་སྐྱུར་ལ་བཏབ་པའི་ཕྱེ་བཞིན་ཁ་ན་ཕར་ཡམ་མེ་བ་ཞིག་ལ་མི་འདུག་ན།",
    "དཔེར་ན་རྩྭའི་ཟིལ་བ་དེ་དཀར་ཁྲོམ་མེ་འདུག་ཀྱང་།",
    "དེ་ཉིད་མ་མཐོང་རང་དགར་གྱུར་བ་ཡི་།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "ཙ་ན་ཡིན་ཡང་བརྡ་སྤྲོད་དགའ་ཚལ་གྱི་ཀློང་དུ།",
    "ཀ་ཅ་ཏ་པ་ཙ་ནི་ཕོ།",
    "༡༢ འགྱུར་ཕྱག་འདི་བསྒྱུར་བྱའི་གཞུང་རང་ན་ཡོད་དམ།",
    "བསྒྱུར་བྱའི་གཞུང་རང་ན་མེད་དོ།",
    "གལ་ཏེ་ཀྱེ་སོགས་མ་སྦྱར་ཡང་མིང་རང་ངོས་ནས་གང་ཟག་གང་ཞིག་འབོད་པ་སྟོན་ནུས་པས་ན་རྣམ་དབྱེ་དངོས་མིན་ནོ།",
    "བདག་གཞན་དུས་གསུམ་གྱི་རྣམ་གཞག་དུས་གསུམ་གྱི་ལས་ཚིག་རྣམས་འདུམ་བདེ་ཕྱིར་སྤྱི་བྱེ་ཐོར་གསུམ་དུ་དབྱེ་ཚུལ།",
    "ཀ་ཅ་ཏ་པ་ཙ་ནི་ཕོ།",
    "ལོ་ཟླ་བ་ཚེས་གང་རུང་ཞིག་དུས་ཀྱི་ད་ལྟ་བར་བཟུང་བ་དེ་ལ་བལྟོས་པའི་སྔ་མ་ཡན་ཆད་ལ་དུས་ཀྱི་དུས་འདས་པ་དང་།",
    "རྟགས་ནི་སེང་གེའི་ཁྲི་ལ་འདུག་པ་དང་།",
    "མུན་ཁང་དང་བལྟ་སྟངས་ངེས་པ་ཅན་ཡང་ཕྱག་ལེན་ལ་མཛད་པར་གདའ།",
    "གོང་མ་མང་པོ་དག་དུས་ཞབས་སྙན་བརྒྱུད་ལས།",
    "སྔར་གྱི་ལས་རྟགས་སྣང་ཅུང་ཟད་མི་གསལ་དུ་འགྲོ་ཡིན་འདུག་ན་ད་དུང་བོགས་འདོན་དེ་སྒོམ་མ་རན་པ་ཡིན་པས།",
    "རྟགས་སྣང་ཡལ་ནས་ལས་སྣང་འདུག་པའམ།",
    "མཚན་ཉིད་ཤེས་ཚུལ་ཡང་རང་སེམས་ཙམ་ཡིན་པར་ཉམས་སུ་མྱོང་བའོ།",
    "རྔུབ་པའི་ཚེ་གཡས་འགེགས་པ་ལག་ལེན་ཁ་ཅིག་ལ་འདུག་ཀྱང་།",
    "ཐོག་མ་ནས་མཉམ་རྒྱུར་འདུག་ན་ལེགས།",
    "རྐང་པ་ཟླུམ་པོའི་འདུག་སྟངས་དང་།",
    "མཉམ་རྒྱུར་འདུག་ན་ལྟ་སྟངས་ཐད་ཀར་བྱས་ལ་མྱུར་བར་རྔུབས།",
    "ནང་དུ་འཇུག་དུས་སེམས་ཉིད་དང་བསྲེ།",
    "འདུག་སྟངས་ལ་བསླབ་པས་སྲོག་ཐུར་བསྲེ་བ་བརྟན་པོར་བྱེད་པ་དང་།",
    "ཁྲོ་བོ་སེང་གེའི་འདུག་སྟངས་ནི།",
    "ཞི་མ་ཁྲོ་གླང་པོ་ཆེའི་འདུག་སྟངས་ནི།",
    "རྣམ་སྨིན་གྱི་ལུས་གནས་མ་འགྱུར་ཡང་རང་སེམས་ལྷ་སྐུར་དངོས་སུ་གྱུར་པ་དང་།",
    "སེམས་འོད་གསལ་དུ་འཇུག་དགོས་པར་འདུག་སྙམ་དུ་འདུན་པས་མཚམས་སྦྱར་ལ།",
    "དེ་ཐིག་ལེ་ཁྲ་བོར་གྱུར་པ་འདར་ཁྲིལ་ལི་ལི་འདུག།",
    "ཁྱད་པར་ཐུན་མཚམས་འགྲོ་འཆག་ཉལ་འདུག།",
    "རྨི་ལམ་དུའང་ཕལ་ཆེར་འཆར་གྱིན་འདུག་ན།",
    "གསལ་མི་གསལ་ལ་སྔར་དང་ཁྱད་མི་འདུག་ན།",
    "འགྲོ་འཆག་ཉལ་འདུག་སྤྱོད་ལམ་ཀུན་ཏུ།",
    "རང་ཡུལ་དང་རང་ཁྱིམ་ལ་ཞེན་པ་དང་།",
    "མཉམ་མེད་བུ་རམ་ཤིང་པས་བདག་ཅག་དུས་ཀུན་ཤིས་པས་བསྐྱངས་དུ་གསོལ།",
    "རགས་པ་བཅིངས་པས་ཕྲ་བ་ཡང་རང་ཤུགས་ཀྱིས་འཆིང་བར་འགྱུར།",
    "དོན་ལའང་ཡོད་པར་འདུག་ད་ལྟ་ཡོངས་སུ་གྲགས་པ་བི་བྷུ་ཏི་དངོས་སློབ་བཞིའི་ལུགས་གསན་པར་བྱེད།",
    "དུས་དེ་ཙ་ན་བོད་སྒོམ་ལ་གྲུབ་ཐོབ་ཀོ་བྲག་པ་ལས་བཟང་བ་དང་མཚན་གྲགས་ཆེ་བ་མེད།",
    "གཞུང་ཆུང་དེ་དག་ལ་ཁོང་བས་མཆན་བུ་དང་ས་དཔྱད་ཀྱང་མཛད་གདའ།",
    "གང་ལྟར་ཡང་སློབ་དཔོན་དེ་ཡུལ་ཤིན་ཏུ་གཉན་པ་ཞིག་ཏུ་འདུགསྔོན་རོང་པ་ཤེར་སེང་དང་རྡོ་རྗེ་རྒྱལ་མཚན་པ་སོགས་ཀྱིས་ཀྱང་ཞལ་སྨོད་མང་པོ་མཛད་དེ།",
    "ལྟ་སྤྱོད་ལོག་པ་འདུག་ཀྱང་།",
    "ཉམས་མྱོང་ལ་ཞག་དུས་ཐེབས་པ།",
    "མར་གྱི་གཡོག་ཐད་ཀར་རང་དང་མཉམ་པའི་གྲོགས་པོ་སོགས་སུས་ཀྱང་སྐྱོབ་པའི་ནུས་པ་མི་འདུག་ཇི་སྐད་དུ།",
    "བདག་ནི་མལ་ན་འདུག་བཞིན་དུ།",
    "སྐྱབས་གཅིག་ཁོ་ནས་ཆོག་པ་ལྟར་འདུག་ཀྱང་།",
    "གཞན་ཡང་རང་དང་གཞན་གྱི་དོན་ཉམས་ལུགས་མང་པོ་དང་།",
    "ལས་འདི་ལ་ཁྱེ་བོགས་ཡེ་མི་འདུག་པ་ལ་དེ་ཙམ་དུ་དགའ་བ་སྐྱེ་བ་ཨང་།",
    "ཉེས་དམིགས་འདི་ཙམ་ཅིག་འདུག་པ་ལ།"
  ]
