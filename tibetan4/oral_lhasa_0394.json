    "དེ་དང་མཚུངས་པར་ལྡན་པ་རྣམས་ནི།",
    "སྡུག་བསྔལ་དངོས་ཡིན་པའི་ཞེས་གསུངས་པའི་ཕྱིར།",
    "མཐོང་ན་དགའ་བའི་ཟས་ཀྱི་སྣོད་དང་ཕྲད་པ་ན་ཆེས་དགའ་བ་བཞིན་དུ་བུམ་པ་ཤེས་པར་བྱ་ཞེས་ཟེར་ན་ཟེར་བ་པོ་དེ་བླ་རྡོལ་བྱེད་པར་རྩི་རིགས་པ་བཞིན་ཡིན་པའི་ཕྱིར།",
    "གཞན་དུ་ན་འགལ་འདུའི་ཕུང་པོ་རི་རབ་ལྟ་བུའི་འོག་ནས་ནམ་ཡང་ལྡང་མི་ནུས་པར་གདོན་མི་ཟ།",
    "ཞེས་གསུངས་པ་གང་ཞིག་གཞན་བཞི་ཡང་དེ་དང་མཐུན་དགོས་པའི་ཕྱིར།",
    "འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་གྱིས་སྡུག་བསྔལ་བའོ་ཞེས་གསུངས་པའང་དངོས་བཏགས་མ་ཕྱེ་ན་ཟག་བཅས་ཀྱི་ཚོར་བ་བཏང་སྙོམས་རྐྱེན་ཡུལ་མཚུངས་ལྡན་དང་བཅས་པ་ལ་གཞག་ཆོག་ཅིང་།",
    "སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་མཚུངས་པར་ལྡན་པ་ཞེས་དང་།",
    "གཙོ་བོ་ཀུན་གཞིའི་འཁོར་གྱི་ཚོར་བ་བཏང་སྙོམས་ཞེས་སོགས་གསུངས་ཏེ།",
    "རྐྱེན་ཡུལ་གྲོགས་གསུམ་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་བཏགས་པ་དང་དེའི་སྡུག་བསྔལ་བ་དངོས་གནས་སུ་རྗེན་པར་བསྟན་པའི་ཕྱིར།",
    "ཚོར་བ་བཏང་སྙོམས་ཏེ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "སྔར་རྒྱས་པར་སྤྲོས་ཟིན་པས་ཆོག་གོ།",
    "ཐམས་ཅད་སྡུག་བསྔལ་གསུམ་པོ་གང་རུང་ལ་ཚོར་བས་ཁྱབ་པར་སྨྲ་བ་ཁོ་བོའི་ཕྱོགས་སུ་རྒོད་པོ་ཚང་ལ་གཞོལ་བ་ལྟ་བུར་གཅིག་ཤོར་གཉིས་ཤོར་དུ་འོངས་པ་འདི་ནི།",
    "བདེ་སྡུག་གཉིས་ལས་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་ཟག་ཚོར་བཏང་སྙོམས་ཉིད་ལ་འཁྲིལ་བ་སྟེ།",
    "དེ་དང་དེའི་སྡུག་བསྔལ་བར་གསུངས་ཀྱི་སྡུག་བསྔལ་དུ་གསུངས་པ་ག་ལ་ཡིན།",
    "འདིའང་ཁོ་བོའི་ཕྱོགས་ལགས་ཏེ།",
    "ལྷག་པར་སྡུག་བསྔལ་སྔ་ཕྱི་གཉིས་རང་བཞིན་གྱི་སྡུག་བསྔལ་བ་དང་།",
    "དེ་དག་ཟག་བཅས་ལ་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་བས་ཁྱབ་པར་གསུངས་པ་ཤ་སྟག་ཡིན་པར་སྔར་ཡང་དང་ཡང་དུ་ལུང་རིགས་ཀྱིས་བསྒྲུབས་པ་ལྟར་ཡིན་པའི་ཕྱིར།",
    "སྡུག་བསྔལ་གྱི་སྡུག་བསྔལ་མངོན་གྱུར་ཉེ་བར་ཞི་བའི་ལྷའི་བདེ་བ་ལྟ་བུ་ལ་ཡིད་འབྱུང་སྐྱེ་མི་སྲིད་དོ་ཞེས་གསུངས་པ་འདིས་ཀྱང་སྡུག་བསྔལ་གྱི་སྡུག་བསྔལ་དང་ཁྱབ་པ་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་མི་འགལ་བར་འདོད་པ་དང་།",
    "བྱུར་དུ་དོགས་ན་སྔོན་སྲོལ་ཡིན་པར་སྨྲར་རུང་བའི་ཕྱིར་དང་།",
    "དེ་ལྟ་ནའང་ཁྱབ་པ་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་འདི་ཤིན་ཏུ་རྟོགས་པར་དཀའ་བ་ཞིག་སྟེ།",
    "ཚོར་བ་ཐམས་ཅད་སྡུག་བསྔལ་བར་གསུངས་པ་སྡུག་བསྔལ་སྔ་མ་གཉིས་ལ་མི་འགྲིག་པ་དང་།",
    "ཉེར་ལེན་གྱི་ཕུང་པོ་དོན་དམ་པའི་སྡུག་བསྔལ་དུ་ཀུན་བཏུས་ལས་གསུངས་པ་དང་།",
    "འགྱུར་བའི་སྡུག་བསྔལ་མི་རྟག་པའི་སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གཞན་གཉིས་རང་བཞིན་གྱི་སྡུག་བསྔལ་དུ་བསྡུ་བ་ལས་གསུངས་པ་དང་།",
    "དེ་དག་ཏུ་ཡང་སྡུག་བསྔལ་དང་སྡུག་བསྔལ་བའི་ཁྱད་པར་གསལ་མི་གསལ་སྣ་ཚོགས་ཡོད་པ་དང་།",
    "དེ་གཉིས་དོན་གཅིག་ཏུ་བྱས་པ་ལྟ་བུའང་མང་དུ་སྣང་བ་དང་།",
    "ཟག་མེད་ལ་རྟག་པས་ཁྱབ་ཅིང་རྣམ་མཁྱེན་ཡང་རྟག་པར་སྨྲ་བ་དང་།",
    "གཞན་དག་འདུས་བྱས་ཀྱི་ཡེ་ཤེས་མེད་ཀྱང་འདུས་མ་བྱས་ཀྱི་ཡེ་ཤེས་ཡོད་པར་ཁས་ལེན་པ་དང་།",
    "ཀཱ་རུ་ཎི་ཀ་བདེ་འགོག་ལ་འཇུག་པའི་ཕུགས་རྩའང་གཅོད་པར་འོས་པ་དང་།",
    "རི་ཀླུང་མེད་པར་མུ་གེའི་མཆུ་འཛུགས་པ།",
    "ཀུན་མཁྱེན་རྒྱལ་བའི་བ་དན་དཀར་པོར་བསྒྲེངས།",
    "ཁོང་པར་ཆགས་སྡང་མེ་དཔུང་མཆེད་པའི་རླབས།",
    "རྩ་བའི་དམ་བཅའ་གཉིས་པ་ཟག་བཅས་ཡིན་ན་ཉེར་ལེན་གྱི་ཕུང་པོ་ཡིན་པས་ཁྱབ་པར་འདོད་པའི་ལོག་རྟོག་གཞོམ་པར་བྱ་སྟེ།",
    "འདོད་པ་དང་འདོད་ཆགས་དང་ལྡན་པའི་ཕུང་པོ་རྣམས་ལ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ཞེས་བྱའོ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "དེས་ཉེར་ལེན་གྱི་ཕུང་པོ་ཡིན་ན་ཤེས་རྒྱུད་ཀྱིས་བསྡུས་པས་ཁྱབ་པར་བསྟན་པའི་ཕྱིར།",
    "འདོད་པས་མ་འོངས་པའི་ལུས་ཀྱི་དངོས་པོ་ལ་ཆགས་པའི་རྒྱུས་མ་འོངས་པའི་ཕུང་པོ་ལེན་པར་བྱེད་པ་དང་།",
    "ལེན་པར་བྱེད་པས་ན།",
    "འདོད་པ་དང་འདོད་ཆགས་དང་ལྡན་པའི་ཕུང་པོ་རྣམས་ལ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ཞེས་བྱའོ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "འདི་ཡང་ཕུང་པོ་ལྔ་ལ་བཏགས་པས་གཟུགས་དང་སེམས་དང་སེམས་ལས་བྱུང་བའི་དུས་ལ་གདགས་པར་ཟད་ཀྱི་ཞེས་གསུངས་པའི་ཕྱིར།",
    "དེས་ཉེར་ལེན་གྱི་ཕུང་པོ་ལ་བཏགས་ན་མིང་གཟུགས་ཀྱི་ཕུང་པོ་ལ་བཏགས་པས་ཁྱབ་པར་གསུངས་པའི་འབྲེལ་འཐད་པའི་ཕྱིར་དང་།",
    "དོན་དུ་ན་ཕུང་པོ་ལྔ་ལ་ལུས་ཞེས་བྱའོ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "གཟུགས་མེད་པ་རྣམས་ལ་ནི་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་ཉིད་དོ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "སྡུག་བསྔལ་གསུམ་ཡང་ཉེར་ལེན་གྱི་ཕུང་པོའི་ནང་ཚན་ཟག་བཅས་ཀྱི་ཚོར་བ་བདེ་སྡུག་བཏང་སྙོམས་གསུམ་དང་སྦྱར་ཏེ་རྟེན་གསུམ་ལ་རིམ་པར་བཞག་པའི་ཕྱིར་དང་།",
    "སྡུག་བསྔལ་གསུམ་ལ་ཡུལ་དང་བཅས་པ་འཇོག་ཅིང་སྡུག་བསྔལ་སྔ་མ་གཉིས་ལ་ཕྱི་མས་ཁྱབ་ན་སྐབས་འདིའི་རྟེན་གསུམ་གྱི་ཁྱད་པར་དེ་བརྙིང་པོར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ལས་རྒྱུད་ཀྱིས་བསྡུས་པའི་ཕུང་པོ་ལ་ཉེར་ལེན་གྱི་ཕུང་པོས་ཁྱབ་མ་ཁྱབ་ཀྱི་དོགས་གཅོད་མཛད་པས་ཀྱང་ཉེར་ལེན་གྱི་ཕུང་པོ་ལ་ཀ་བུམ་སོགས་མེད་པར་འབད་མེད་དུ་འགྲུབ་སྟེ།",
    "དེ་ཡང་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་ཉིད་དམ་བཞིའི་བདག་ཉིད་དོ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "འོག་ཏུ་འཆད་པར་འགྱུར་རོ།",
    "འདི་དག་དང་ལྡན་པའི་ཕུང་པོ་རྣམས་ནི་ཉེ་བར་ལེན་པའི་ཕུང་པོ་རྣམས་སོ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "མིང་དང་མཚན་ཉིད་ཀྱི་སྡུག་བསྔལ་སྐྱེ་རྒ་ན་འཆི་ཞེས་གསུངས་པའི་ཕྱིར།",
    "ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔའོ་ཞེས་གསུངས་པའི་ཕྱིར་དང་།",
    "རྗེ་ཡབ་སྲས་ཀྱིས་ཀྱང་གསུངས་པའི་ཕྱིར་རོ།",
    "གཅོད་ཀྱི་གཞུང་དུ་ཐོགས་བཅས་ཀྱི་བདུད་ལ་སོགས་པ་གསུངས་ཀྱང་རྣམ་པར་གཞག་པ་གཞན་ཡིན་ཏེ།",
    "ཕུང་པོ་ཚོགས་པའི་གང་ཟག་འཆི་བའི་ཕྱིར་ཞེས་གསུངས་ཏེ།",
    "དེས་ཀྱང་ཉེར་ལེན་གྱི་ཕུང་པོ་ཡིན་ན་རྒྱུད་ཀྱིས་བསྡུས་པས་ཁྱབ་པར་བསྟན་པའི་ཕྱིར་ཏེ།",
    "སྣམ་བུ་ལ་སོགས་པ་དག་ཀྱང་རིག་པར་བྱའོ་ཞེས་དང་།",
    "གཉིས་པས་དེའི་ལུས་རྟེན་བདག་ཏུ་གསུངས་ཤིང་ཕྱི་རོལ་གྱི་ས་བོན་བུམ་སྣམ་སོགས་དེ་མ་ཡིན་པར་གསུངས་པའི་ཕྱིར་དང་།",
    "རྒྱས་པར་སྤྲོས་ཡིན་ཏེ།",
    "ངའོ་སྙམ་པའི་བག་ལ་ཉལ་མ་སྤངས་སོ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "རྣམ་པར་གཞག་པ་གཞན་ཡིན་པས་སྐབས་འདིར་དཔྱད་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་ཡིན་པའི་ཕྱིར།",
    "དེ་གཉིས་ལས་བྱུང་བའི་ཕུང་པོ་ཞེས་པ་འདི་བཞི་གས་ཉེར་ལེན་གྱི་ཕུང་པོ་ལ་རྒྱུད་ཀྱིས་བསྡུས་པས་ཁྱབ་པར་དམར་རྗེན་དུ་བསྟན་པའི་ཕྱིར་ཏེ།",
    "དེ་དང་ཀུན་བཏུས་རྩ་འགྲེལ་གྱིས་ཀྱང་ཉེར་ལེན་གྱི་ཕུང་པོའི་སྒྲ་དོན་གསུངས་པ་སྔར་བཞིན་ཏེ།",
    "འབྲས་གནས་རྣམས་རྣམ་གྲངས་སུ་མཛོད་འགྲེལ་རྒྱལ་སྲས་མར་གསུངས་པ་བཞིན་ནོ།",
    "གང་དུ་ལེན་པའི་གནས་སྣོད་ཀྱི་འཇིག་རྟེན་ཞེས་ཐ་སྙད་གདགས་པ་ལགས་སོ་ཞེས་པ་འདི་ཡིན་པའི་ཕྱིར།",
    "གསུམ་པས་ཟག་བཅས་རྣམ་སྨིན་གྱི་ཕུང་པོ་ལ་ཉེར་ལེན་གྱི་ཕུང་པོས་ཁྱབ་པར་གསུངས་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "རིགས་མཐུན་ཉེ་འཁོར་གྱི་བློ་ཆུང་དག་མ་འདྲིད་པར་ཁྲེལ་དང་ངོ་ཚའི་མར་མེ་ཅུང་ཟད་སྦོར་ཅིག་རིགས་པ་དྲུག་ཅུ་པའི་དར་ཊཱིཀ་དང་ཐུབ་དགོངས་ཀྱང་དེ་བཞིན་ཏེ།",
    "ལམ་གྱི་དམིགས་པར་སྟོན་པ་དང་།",
    "དངོས་བསྟན་ཤུགས་བསྟན་ཀྱང་བརྗོད་བྱ་གཙོ་ཕལ་དང་སྒྲས་ཟིན་མ་ཟིན་ལ་བྱེད་ཚུལ་གཉིས་ཡོད་པར་གསེར་ཕྲེང་སོགས་སུ་གསུངས་པའང་དྲན་པར་བྱའོ།",
    "བཟོད་པའི་མུ་ཁྱུད་ཀྱི་རྗེ་བོ་སྟོན་དུ་འོངས་ན་འཐད་མི་འཐད་བརྟག་པར་བྱ་བའི་རིགས་སོ།",
    "དེ་ནི་རིགས་ལམ་གྱི་མཚོན་རྩེ་རྣོ་བ་ཞིག་ཡིན་པར་ཐོས་སོ།",
    "ལྷག་མ་མེད་པར་ཡོངས་བཏང་བ།",
    "བད་པ་པདྨའི་ལྗོན་པར་བརྫུས།",
    "ཞི་བ་ལྷས་གསུངས་བློ་ཡི་ཁྱད།",
    "ཡུད་ཀྱིས་ནོངས་པར་འགྱུར་བའི་ཚེ།",
    "མཁའ་གོས་གྱོན་པར་དབྱེར་མེད་ཀྱང་།",
    "དཔྱོད་པའི་མེལ་ཚེ་གཟུགས་པར་འོས།",
    "ལྷ་ལ་སོགས་པའི་རིས་མཐུན་པའི་གནས་སུ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་རྣམས་སྐད་ཅིག་མའི་རྒྱུན་དུ་རྒྱུན་མ་ཆད་པར་འབྱུང་ཞིང་སྐྱེ་བ་ནི།",
    "ཕུང་པོ་ལྔ་ཚེ་གཅིག་ནས་གཅིག་ཏུ་རྒྱུན་མ་ཆད་པར་སྐྱེ་བ་ནི།",
    "འདུས་བྱས་ཀྱི་དོན་འཆད་པའི་སྐབས་སུ་རྭ་དང་ལྡན་པ་ལ་འདུས་བྱས་ཞེས་བྱའོ་ཞེས་ཟེར་ན་གཞན་དང་མི་མཉམ་པའི་བླུན་རྟགས་སུ་འགྱུར་བའི་ཕྱིར།",
    "ཉེ་བར་ལེན་ནས་ལེན་མེད་པར།"
  ]
}