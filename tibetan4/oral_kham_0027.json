    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག།",
    "ལོ་ཆེན་གྱི་འགྱུར་དང་མི་མཐུན་པའི་ཚིགས་རྐང་འགའ་ཤས་འདུག་པ་མ་ཟད།",
    "ཚིགས་རྐང་སོ་སོའི་མཐའ་མའི་ཚིག་པ་པོ་འཆང་བདག་སྟེ་ནི་སོགས་འདྲ་མིན་མང་པོ་འདུག་པ་དེ་དག་བརྗོད་དོན་གྱི་གོ་རྟོགས་ལ་དེ་ཙམ་འགལ་རྐྱེན་དུ་མ་མངོན་ཡང་ཚིགས་རྐང་དཀྱུས་སུ་བོད་སྐད་དུ་སྒྲ་མཚུངས་པའི་ཡིག་ནོར་མང་དག་ཅིག་བར་སྐབས་ཀྱི་པར་མ་རྣམས་སུ་བྱུང་འདུག་པ་དེ་དག་དགོངས་འགྲེལ་ཁག་དང་།",
    "འཕགས་པ་འཇམ་དཔལ་གྱི་མཚན་ཡང་དག་པར་བརྗོད་པའི་ཕན་ཡོན་གྱི་འགྲེལ་པ་དུས་ཞབས་པས་མཛད་པ་ཨབྷཡབཛྲ་དང་རྡོ་རྗེ་རྒྱལ་པོས་བསྒྱུར་བ་གཉིས་ནས་ཀྱང་ལེགས་ཆ་ཅི་རིགས་བཞེས་འདུག།",
    "དུས་འགྲེལ་དྲི་མེད་འོད་ལ་ཞལ་འཕངས་པའང་ཅི་རིགས་འདུག་གོ་དགེ་སློང་རྡོ་རྗེ་འཛིན་པ་དཔལ་བསོད་སྙོམས་པ་ཆེན་པོ་སྟེ།",
    "ཞེས་གསུངས་འདུག་པ་ནི་དོན་ལ་གནས་པར་མ་མཐོང་ཞིང་བླུན་རྨོངས་བདག་ལྟ་བུས་ཀུན་མཁྱེན་བུའི་གསུང་ལ་ཀླན་ཀ་འཚོལ་བར་ག་ལ་ནུས་ཀྱང་གཞུང་གཞན་གཉིས་ཞིབ་པར་མཇལ་ལོངས་མ་བྱུང་ཡང་།",
    "འགོས་ལོའི་དེབ་སྔོན་དུ་དཔེ་མེད་འཚོ་པདྨ་དཀར་པོའི་དངོས་སློབ་ཏུ་བཞེད་འདུག།",
    "ན་འ་གསུངས་འདུག་ཅིང་།",
    "ཐམས་ཅད་མཁྱེན་པ་བུ་སྟོན་ཁ་ཆེས་ཀྱང་ཐེ་ཚོམ་གྱི་གཞིར་མཛད་འདུག་པས་འཇམ་དཔལ་གྱི་གསུང་ཡིན་མིན་བརྟག་པར་བྱ་ལ།",
    "ཞེས་གསུངས་འདུག་ཀྱང་།",
    "ཞེས་པའི་མཆན་ཞིག་འཁོད་འདུག་པ་བཅས།",
    "ཞེས་འགྲེལ་བརྗོད་མཛད་འདུག་ཅིང་།",
    "དྷ་ས་བོད་ཀྱི་དཔེ་མཛོད་ནས་པར་བ་དེར་ཞུ་དག་གང་འཚམས་གནང་འདུག་པ་དང་།",
    "ཚིག་བརྗོད་མི་ཉུང་བ་ཞིག་ཆད་ལྷག་མེད་དམ་སྙམ་པའི་དྭགས་གཞི་ཅན་དུ་འདུག་ཀྱང་ཁུངས་གཏུག་དཔེ་བསྡུར་བྱ་ཡུལ་མ་རྙེད་པས་རང་སོར་བཞག་པ་ལས་བྱ་ཐབས་མ་བྱུང་།",
    "སྣར་ཐང་བཅས་ཀྱི་པར་མ་དང་བསྡུར་ཏེ་བརྗོད་ཚིག་མི་མཐུན་པ་རྣམས་མཆན་འགོད་འདུག་སྟབས།",
    "ལུང་འགའ་ཤས་བསྟན་བཅོས་སུ་དྲངས་པའང་འདུག་པས།",
    "རྒྱ་སྐད་དུ་ཡོད་པའི་ཅ་ཆ་སོགས་ལ་ཙ་ཚ་སོགས་བྲིས་སྲོལ་དར་བ་ནི་ཡིག་རྙིང་ཁག་ཏུའང་འདུག་པས་འདིར་བཟོ་བཅོས་ཞུ་ནུས་མ་གྱུར་པར་རྒྱུན་ལྡན་ལྟར་བཞག་ཡོད་དོ།",
    "བསམ་གཏན་གྱི་ཁང་པར་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "བྱེ་བྲག་དུས་ཀྱི་འཁོར་ལོ།",
    "སྤྱན་སྔར་འདུག་སྟེ་འདི་སྐད་གསོལ།",
    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག།"
  ]
}