    "བསམ་གཏན་གནས་སུ་རབ་འདུག་ཆ་སྟེ་། ཕྱག་རྒྱར་ལྷན་ཅིག་རབ་ཞུགས་ནས།",
    "ཁོ་ནམ་ཡོང་ཏིག་ཏིག་མི་འདུག་པས།",
    "སེམས་ངོ་བོ་སྟོང་པར་འདུག་པ་དེ།",
    "ཁྱེད་འགྲོ་ཞིང་འདུག་ཅིང་སེམས་ལ་ལྟོས།",
    "འགྲོ་འདུག་དོན་དམ་གྱི་བསྐོར་བ་ཡིན།",
    "དེའི་ཚེ་དྲི་ཡུལ་དེས་འདི་སྨྱོན་པར་འདུག་སྙམ་དུ་ཅང་མི་སྨྲ་བའམ།",
    "མཐར་འབུའི་དཔེ་དང་རང་བློའི་དོན་ལ་ཐུག་པར་འགྱུར་བའི་ཕྱིར།",
    "དེའི་མཐའ་འབུ་ལ་ཐུག་འདུག་པའི་ཕྱིར་རོ།",
    "སྣང་བ་འཁྲུལ་ཡང་འཛིན་སྟངས་དོན་དང་མཐུན་པས་ཁུག་མ་དག་དག་གང་འདུག་པའི་ཕྱིར།",
    "ཞེས་ཐག་བཅད་འདུག་སྟེ།",
    "ལམ་ཡིག་འདིར་ཡང་གྲོག་མའི་སྤུན་ཟླ་དག་ཡིད་ཆེས་ཀྱིས་ཚིམ་པར་བྱ་བའི་ཕྱིར་ད་ལྟའི་ཐ་སྙད་གཅིག་ཀྱང་མ་བསྒུལ་པར་རང་སོར་བཞག་སྔོན་གྱི་རྙིང་པ་རྣམས་ལ་གཡོ་འཕྲུལ་ཁབ་འགྲོ་འབིགས་འགྲོ་སྣ་ཚོགས་པས་སྤྲང་པོའི་ལྷན་བསྒྲིགས་ཅི་ཡང་བགྱིས་གདའ་བ་ཡི་གར་གཏན་ནས་མི་འོང་།",
    "ཞེས་དམུས་ལོང་ལ་སྨྲས་པ་དང་ཁྱད་ཅི་འདུག་དེ་ལ་གཟི་བརྗིད་ཅི་ཞིག་ཡོད།",
    "འདི་ཙམ་ལའང་ཧོལ་རྒྱུག་བྱས་འདུག་ན་གཞན་ལ་ལྟ་ཅི་སྨོས།",
    "སྔོན་གྱི་རབས་ལ་དཔྱད་པ་རྫོགས་པའི་མཁས་པ་དྲི་གཏུགས་བྱ་ཡུལ་ཡང་བཅུ་ཕྲག་མང་པོ་ཡོད་གདའ་བ་དེ་དག་ཀྱང་འདི་དང་འདི་ཞེས་སྨྲས་ན་ལེགས།",
    "དེའི་ཚེ་རྟོག་པ་ཁོ་རང་མེད་པའི་ཕྱིར།",
    "གསལ་པོ་ཨེ་འདུག་ཚིག་དེ་བོད་སྔ་མའི་ཡིན་ན་ཆད་ལྟ་བ་བླུན་པོ་ཞེས་སྨོད།",
    "དཔེ་ལ་ཡང་རང་གོས་གྱོན་དུ་མི་རུང་བར་ངེས་པར་ལྷན་པ་འདེབས་དགོས་རིགས་ལ་མི་འདེབས་ལ།",
    "དེས་ང་ང་ཙམ་དུ་བཟུང་བ་མ་ཡིན་པར་ང་རང་རྐྱ་པའི་རྣམ་པར་བཟུང་བའི་ཕྱིར་ཏེ།",
    "ང་ཕོབ་ཕོབ་པ་ཞེས་སོགས་འདུག་པའང་གདགས་གཞི་ལ་མ་ལྟོས་པར་ཚུགས་ཐུབ་ཏུ་གྲུབ་པའི་བརྡ་ཡིན་ཏེ།",
    "རྒྱ་མཚོའི་གཏིང་ནའང་ཡོད་པ་དེ་ཉིད་ཡིད་རྟོན་མི་རུང་བར་སྒྲུབ་པའི་ཁ་སྟབས་ཡག་པོ་འདུག་པ་ད་ལྟ་རང་ངོམས་ཤིག་ཀྱེ་མ་ཀྱི་ཧུད།",
    "ཆ་ཤས་བྱེ་བ་འབུམ་ཕྲག་དེ་ཀུན་ཞེས་བྲིས་འདུག་པའི་ཕྱིར།",
    "མི་ཆུ་ལ་སྐྲག་པ་གཉིས་ལ་ཁོ་རང་གཉིས་ཡིད་ཆེས་པ་ཙམ་དུ་མ་ཟད།",
    "དཔའ་བོ་དང་སྡར་མ་སུས་འཕྱར་ཡང་རལ་གྲི་རལ་གྲི་རང་ཡིན་འགྲོ།",
    "དེ་བས་ཀྱང་དཔེ་གསལ་བ་དེ་མ་ཐག་མཚོན་བྱའི་དོན་གོ་ནུས་པ་ཞིག་འདུག་དགྲ་གཉེན་ཐམས་ཅད་ཕྱོགས་གཅིག་ཏུ་བསྡུས་ནས་མེ་སྒྱོགས་འཕོངས་ཤིག་དང་འཆི་རྒྱུ་དེ་འཆི།",
    "རང་རང་ས་ན་བདེན་པའི་སྟོབས་རྫོགས་པས།",
    "རང་རང་ལུགས་ཀྱི་བརྟག་དཔྱད་བྱས་པར་ངེས།",
    "རིང་ན་འདུག་ཀྱང་དེ་དང་དེར།",
    "དོན་དམ་ཁོ་རང་ཡང་མེད།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "ཁྱེད་རང་གཉིས་གོ་བ་ཆེ་བས་དེ་ལྟར་ཤར་བ་ཡིན་མཆི།",
    "མེས་ཚིག་དུས་ཨ་ཚ་ཟེར་བ་དེ་གཞན་ངོ་མ་གཏོགས་རང་ལ་ཚ་བར་ཡིད་ཆེས་མེད་པ་དང་།",
    "བདེན་མི་བདེན་ལྕང་སྐྱ་ཁོ་རང་ལ་དྲིས།",
    "ཤིང་ཁོ་རང་ཚུགས་ཐུབ་ཏུ་གྲུབ་པར་བཞེད་པ་གང་ནས་ཡིན།",
    "མིང་རྐྱང་བཏགས་ཡོད་ཙམ་ཞིག་ཡིན་མིན་སོགས་འདིའི་དོན་ལ་གསལ་བར་ཐོན་འདུག་པའི་ཕྱིར།",
    "བདེན་པར་མེད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་ཅེས་ཞིབ་ཆ་ཕྱེ་ནས་འཛིན་པ་འདི་ལེགས་ལྡན་གྱིས་གསར་དུ་བཟོས་པའི་ཀུན་བཏགས་མིན་ན་དེ་འདྲ་སུས་འདོད།",
    "ཁ་ནས་དད་པ་ཤེས་སྒྲིབ་ཡིན་འདུག་སྟེ།",
    "ཁྱད་གཞི་ཁོ་རང་རྩ་བ་ནས་མེད་པའི་ཕྱིར་ཞེས་ཐག་གཅད་ཆོག་ཆོག་ཡིན་པའི་ཕྱིར།",
    "དཔེ་མི་སྲིད་པ་ཞིག་སྟེ།",
    "མྱུ་གུ་ཁོ་རང་ཁས་མི་ལེན་པའི་ཕྱིར།",
    "ཞེས་བྱ་བའང་རང་བཞིན་དྲང་པོར་མཚོན་པའི་ཚིགས་སུ་བཅད་པའོ།",
    "འབེན་མ་མཐོང་བར་མདའ་འཕངས་འདུག་གམ།",
    "འབེན་གྱི་མིག་ཐོག་ཏུ་འཕངས་འདུག་ལེགས་པར་ལྟོས།",
    "ལྟ་ལས་བྱུང་ཞེས་པ་གདན་ས་ཆེན་པོའི་བྱིས་པ་རྣམས་ཀྱང་མ་ཎི་དང་མཉམ་དུ་བློ་བྱང་ཁ་བྱང་ཡིན་པས་བར་འདིར་ཟླ་བ་བཟང་པོ་འོས་མེད་དུ་འཚངས་དོན་ཅི་འདུག་ཀུན་རྫོབ་ཏུ་ཡོད་ཟེར་བ་བདེན་འཛིན་གྱི་ངོར་ཡོད་པའི་དོན་དུ་འཇོག་པའི་བརྟག་ཐུབ་ཀྱི་ལུང་དང་གང་ཟག་གཅིག་ཀྱང་མེད།",
    "བཟང་རང་ངེ་རོང་ངེ་བྱེད་སྲིད་ཀྱང་ཁ་ལ་སྣ་ཚོགས་རྡོ་རྗེའི་བྱིན་ཆེན་དབབ་པར་བྱའོ།",
    "ཟླ་བཟང་ཡང་ཆེས་མི་འགོར་བར་འཚང་རྒྱ་རྒྱུ་ཡིན་འགྲོ།",
    "སེམས་ཙམ་པས་ཕྱི་དོན་ཡོད་པ་མ་རྙེད་པ་ཁོ་རང་བློ་རྩལ་ཞན་པས་མ་རྙེད་པ་ཡིན་གྱི།",
    "ཁས་མ་བླངས་ཞེས་པ་དང་འཇིག་རྟེན་ངོར་བྱས་ཞེས་པ་འདི་གཉིས་ཀྱང་རང་ལ་ཁས་ལེན་མེད་པ་དང་།",
    "སྨྱོ་འབུ་སྟོང་ཕྲག་དུས་གཅིག་ཏུ་བླངས་པ་ཡིན་ངེས།",
    "ཡོད་པ་ཡོད་འཛིན་ཞི་བའི་ཕྱོགས་ལོས་ཡིན།",
    "སེམས་སེམས་བྱུང་གཉིས་ཀས་ཡུལ་གྱི་ངོ་བོ་དང་ཁྱད་པར་གཉིས་ཀ་རིག་ཀྱང་རང་སྟོབས་གྲོགས་སྟོབས་ཀྱི་ཁྱད་པར་འབྱེད་དགོས་པ་བཞིན་ནོ།",
    "དེ་ཉིད་མ་མཐོང་རང་དགར་གྱུར་པ་ཡི།",
    "རང་བྱུང་རང་བྱུང་བསྟན་པ་གཅེས་འཛིན་རྣམས།",
    "ཤར་ནུབ་རི་དང་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་ཀྱི་བདག་དང་རྫས་ཡོད་ཀྱི་བདག་གཉིས་མི་འདྲ།",
    "བརྗོད་མེད་ཀྱི་རྫས་ཡོད་དང་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་གཉིས་ཀྱང་གཏན་ནས་མི་འདྲ།",
    "དམིགས་བློ་དང་མྱོང་བློའམ་གཞན་རིག་དང་རང་རིག་གོ་ཞེས་བསམ་པར་བྱ་བ་ཡིན།",
    "འགོག་མཁན་ཙམ་མི་འདུག་གསུངས་པ་ག་ལ་ཡིན།",
    "དེ་ལས་ཀྱང་རང་རྒྱུད་པའི་གཞི་ལམ་འབྲས་བུའི་རྣམ་པར་གཞག་པ་ངེས་པར་བྱ་སྟེ།",
    "བྱེ་བྲག་སྨྲ་བ་དང་རང་རྒྱུད་པས་ཀྱང་ཁས་མི་ལེན་པའི་ཕྱིར།",
    "སྤྱིར་སེམས་ཙམ་པ་དང་རང་རྒྱུད་པས་ཀྱང་འདོད་པའི་ཕྱིར།",
    "དྲན་པའི་རྟགས་ཀྱིས་རང་མྱོང་རང་རིག་སྒྲུབ་པ་ཡང་རང་དོན་འགྲུབ་པའི་གནས་མ་མཆིས་པའི་ངལ་བ་འབའ་ཞིག་གོ།",
    "ཤེས་སྒྲིབ་ལ་ཤེས་པ་ཡོད་མེད་སྐྱེས་མཆོག་དམ་པ་རྣམས་ཀྱི་བཞེད་ཕྱོགས་གཉིས་འདུག་ཀྱང་ལེགས་པར་དཔྱད་དགོས་ཏེ།",
    "ཤེས་བྱའི་སྒྲིབ་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་ལ་བརྟགས་ནའང་འདིའི་འཁྲུལ་བ་བློ་ཡིན་པར་ཤེས་པའི་ཚོད་དུ་འདུག་གཉིས་སྣང་འཁྲུལ་བའི་བག་ཆགས་ཞེས་པའང་གཉིས་སྣང་འཁྲུལ་བ་དེས་བཞག་པའི་བག་ཆགས་ཞེས་བྱ་བ་ཡིན།",
    "སྟངས་སྟབས་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "སྐྱིལ་ཀྲུང་སོགས་ཀྱི་འདུག་སྟངས།",
    "དང་པོའི་སྦྱོར་བ་དང་རང་དོན་སྒྲུབ་པའི་ཡན་ལག་ཏུ་འདོད་ཅིང་།",
    "མ་སྦྱངས་ཕལ་བའི་མྱོང་སྣང་རང་ག་པར་གྲུབ་པའི་མཐའ་འཆའ་བ་དེ་དག་ཀྱང་བཟང་པོར་མི་སེམས་སོ།",
    "འོན་ཀྱང་རང་སྐད་བསྒྱུར་རྒྱུ་དང་གཅིག་སྐད་ཀུན་གོ་ཧ་ཅང་དཀའ་ངལ་ཆེ་བས་གང་ལ་གང་འོས་སུ་ཡུལ་སོ་སོའི་བརྡའང་མ་བཀོལ་ན་མཐར་གང་ལ་ཡང་ཕན་མི་ཐོགས་པའི་ཡ་མ་ཆ་ཞིག་ཏུ་བསྒྱུར་ཉེན་མཆིས།",
    "ཕོ་ཡིག་དུས་གསུམ་གྱི་འདས་པ་དང་།",
    "བཙན་རྒྱལ་རིང་ལུགས་ལ་དགྲར་ལྟ་ཞིང་རང་ལ་གཅེས་པའི་ཤེས་རབ་ཅན་རྣམས་ནས་ཤིན་ཏུ་སྒྲིམས་ཤིག་ད་ནི་དུས་ངན་སྙིགས་མའི་ཡང་མཐའ་འདིར།",
    "ལྟས་ངན་རྨོངས་རྒན་འདིས་དུ་རུ་ཀ་ཙམ་ཡང་ཧ་གོ་མི་འདུག་དུ་རུ་ཀ་དང་།",
    "ལུས་རྒས་ན་ཚོད་ནུབ་རིའི་རྩེར་འཛེགས་མི་རྟག་དུས་ཀྱི་རིང་ལུགས་འཛིན།",
    "རང་རང་འགྲུབ་བྱེད་དེ་ཡིས་བསྒྲུབས།",
    "ཀ་ལན་སྦུགས་ནས་འབྲལ་ཁར་ངས་སྨྲས་པ་ཇི་བཞིན་བྱས་འདུག་ད་ཁྱི་རྒན་གྱིས་རུས་གོག་སྲུང་བ་བཞིན་མཐོང་ཚད་དགྲར་མ་འཛིན།",
    "སྔར་ཁོ་རང་ལའང་ཡི་གེས་མཚོན་ཞིང་།",
    "ད་ལྟ་ནི་ཕྱོགས་གང་ནའང་ལུང་བསྟན་ལྟ་བུར་ཐོག་ཏུ་བབ་འདུག་གཤིས།",
    "ཁོ་རང་ཕ་བོང་ཁར་ཚུལ་མཐུན་གྱིས་བསྡད་ཡོད་སྐད་ཐོས་པ་སྤྲོ།",
    "གསོན་པ་ལེགས་ན་འདུག་གོ་ཞེས།",
    "གཅིག་འདོད་ཁ་ཚང་དཔེ་མི་སྲིད།",
    "ནོར་བུ་དོན་རྒྱམ་གཉིས་ཀྱང་ངའི་ངག་བཀོད་ལྟར་གྲྭ་ཚང་ན་འདུག་ཚུལ་ཡགས།",
    "ནང་ཆེན་སོགས་གང་དུ་འདུག་ན་ཡང་འདོད་རྒུར་བྱས་པས་ཆོག་སྟེ།",
    "རང་རང་ས་རུ་ཕུན་སུ་ཚོགས་པར་བཞུགས།",
    "སྡར་མ་ཡིབས་ནས་འདུག་ས་མེད།",
    "ན་འཆི་གཉིས་ལ་ཡིད་བརྟན་མི་འདུག་པས།",
    "ཧ་ཅང་རང་བསྟོད་ཚ་དྲགས་ན།",
    "རྗེས་མའི་གསུམ་པར་ཡང་རྒྱ་གར་སིངྒ་ལ་ལ་འགྲོ་མི་དགོས་པའི་ངེས་བའང་མི་འདུག་ཁོ་བོས་འབྱོལ་ཐབས་བྱེད་མུས་ལ་བསམ་ཐོག་ཏུ་ཡོང་མིན་མི་ཤེས།",
    "འཇམ་པའི་དབྱངས་ཀྱང་རང་སྲིད་འཆོར་དུ་དོགས།",
    "ཡང་རང་རྒྱུད་པའི་ཤིང་རྟའི་སྲོལ་འབྱེད་ཆེན་པོ་སློབ་དཔོན་ལེགས་ལྡན་འབྱེད་ཀྱི་སྤྲུལ་པ་ཡིན་ཞེས་དབུས་གཙང་ཀུན་ལ་མཐུན་པར་གྲགས།",
    "ཁྱད་པར་ཅན་གྱི་ཟླས་དྲངས་པའི་རང་རྒྱུད་སོགས་ཀྱང་དེའི་ལུགས་ལ་ངེས་པར་ཁས་ལེན་དགོས་པ་ལྟ་བུར་འདུག་ན།",
    "རང་རྒྱུད་ཀྱི་དོན་དགག་བྱ་ལ་མ་སྦྱར་བར་རང་རྒྱུད་ཡོད་པའི་ཕྱོགས་ཀྱི་དཔྱོད་ཚུལ་མང་དུ་ཞུས་པ་ལ་ཐུགས་མ་དགྱེས་འདུག་སྙམ་ནས་ཐུགས་ཤིན་ཏུ་ཕམ་སྟེ།",
    "སེམས་ཀྱིས་བཟོད་ཐབས་མི་འདུག་ཞུས་པས།",
    "ཊིཀྐ་ཆུང་ལོ་ཆེན་གྱི་རང་ལུགས་ཡིན་ཚུལ་འདུག་པ་དང་།",
    "ཕྱོགས་ཕེབས་ཀྱི་ཚེ་གནམ་གྲུ་མེ་འཁོར་རླངས་འཁོར་གང་ལའང་ལམ་ཆས་དགོས་རིགས་ཇི་ལྟར་ཡང་གཞུང་རང་ནས་མཛད།",
    "གསང་སྔགས་ཀྱི་རྣལ་འབྱོར་བ་དང་དེའི་ཉམས་ལེན་སོགས་གང་ཡང་མི་འདུག་གསུངས།",
    "སྟན་བདེ་བ་ལ་འདུག་སེམས་བྱ།",
    "ཁྱེད་རང་རྣམས་དཔལ་ཡེ་ཤེས་ཀྱི་མགོན་པོ་མ་ཧཱ་ཀཱ་ལ།",
    "དེའི་གཅུང་རང་གཞན་གྱི་གྲུབ་པའི་མཐའ་རྒྱ་མཚོ་ལྟ་བུའི་ཕ་རོལ་ཏུ་སོན་པ།",
    "ས་པདྨ་འདབ་བརྒྱད་དུ་འདུག་པ།",
    "ཨེ་འདུག་ལྟོས་དང་གསུངས།",
    "ངེད་ཀྱི་ཨ་ཆེ་ལགས་ལ་བུ་ཆུང་ཞིག་སྐྱེས་ཡོད་པ་གཙེར་གཙེར་འདྲ་ཡོང་འདུག་པས་མིང་འདོགས་རོགས་དང་ཕྱག་མདུད་ཅིག་གནང་བ་ཞུ་ཟེར་བར།",
    "སྔར་མཚན་ལམ་ལ་བྱུང་བའི་གནས་དེ་འདི་ཀ་ཡིན་པ་འདུག་ལགས་སམ་ཞུ་བ་མཛད་པས།",
    "ན་བཟའ་དཀར་པོ་འགན་སྦྱར་བགྲོ་ཞིག་ཞུས་འདུག་པར།",
    "བུག་སྒོ་གསར་པ་ཞིག་འདུག་པ་དེ་ལ།",
    "སོས་འདི་སྤྱིལ་པོ་རྒྱག་རྒྱུ་ཡིན་པས་ང་རང་སྡོད་དུ་ཡོང་གསུང་བ་མཛད་འདུག་པ་ལྟར།",
    "སྒར་པ་ཕེབས་ཀྱི་ཡོད་འདུག་ཟེར་བ་གསན་པས།",
    "དེས་ན་གདན་སར་སྤྱན་འདྲེན་ཞུས་པའི་མི་རྒན་དང་མཇལ་བ་ཞིག་ཅིས་ཀྱང་དགོས་འདུག་ཅིང་།",
    "དཔའ་བོ་མཁའ་འགྲོའི་བསུ་མར་འདུག་གསུངས།",
    "སྔར་གཏོར་མ་ལ་བྱི་བས་གནོད་པར་འདུག་སྟེ།",
    "གས་པར་འདུག་སོགས་བསྔགས་པ་མཛད་ཅེས་གླེང་ངོ།་",
    "རྔོག་ལོ་ཆེན་པོ་བློ་ལྡན་ཤེས་རབ་ཀྱིས་ཀྱང་དགུང་ལོ་བཅུ་བདུན་ལ་བསྙེན་པར་རྫོགས་པའི་གཏཔ་རྒྱུད་བསྒོན་མེད་འདུག་པ་དང་།",
    "རྒྱལ་བ་དམ་པ་རྣམས་ཀྱི་སྐུ་བརྙན་བཞེངས་འདུག་པར་རབ་གནས་རྒྱས་པ་གནང་།",
    "ཉམས་ཁྲིད་དུ་བསྟར་བ་ཞིག་བྱེད་དགོས་འདུག་གསུང་བ་ཕེབས་པ་ལྟར།",
    "སྐྱེད་ཚལ་གྱི་ས་དབྱིབས་ཁབས་ཀྱི་གཞིས་ཀ་དེ་ཇི་ལྟ་བ་རང་དུ་འདུག་གསུང་བ་བཞིན།",
    "ཀྲིཥྛ་སཱ་རའི་བཞུགས་ར་། གདན་གྱི་ཁོར་སེམས་ཉིད་ངལ་གསོའི་བཞུགས་སྟངས་མཛད་བཞུགས་འདུག་པར།",
    "ཞབས་ཏོག་ཏུ་འགྱུར་བ་འདུག་ཚ་གཞིས་ཀ་ཕྱོགས་སུ་སྐྱེ་བ་མྱུར་དུ་ཡོང་ཕེབས་པ་ཞིག་བྱུང་།",
    "དེ་དང་མཚུངས་པར་དཀར་བརྒྱུད་ཀྱི་ཅོད་པན་དམ་པ་སྒམ་པོ་པ་ནོར་བུ་རྒྱན་པ་ཞེས་གྲགས་པ་དེས་ཀྱང་དེ་མཐུན་གྱི་ལུང་བསྟན་སྙན་འབུལ་ཞུ་བ་གནང་འདུག་ནའང་།",
    "གཟིམས་སྤྱིལ་ནང་དུའང་སྐུ་རྐྱང་ལས་མི་ཕེབས་ང་གནང་འདུག་ཀྱང་།",
    "ཞབས་ཕྱིར་སྒར་པ་ཉིས་བརྒྱ་ཙམ་ཕེབས་འདུག་པར་ཚོགས་ཀྱི་འཁོར་ལོའི་བསྙེན་བཀུར་རྒྱས་པ་ཕྱག་མཛོད་ནས་ཞུས།",
    "ཇ་གོས་དར་སོགས་འབུལ་ལམ་རྒྱས་པ་འདུག།",
    "སྟག་མའི་མེ་ཏོག་ཡིན་པ་འདུག་གསུངས་པས།",
    "རྟེན་གསུམ་མཆོད་ཆས་གསེར་སོགས་འབུལ་བ་རྒྱ་ཆེར་འདུག་པ་བཞེས།",
    "འབུལ་ནོད་ཀྱང་རྒྱ་སྤམ་ཆེ་བ་འདུག།",
    "བཞུགས་སྒར་བློ་བདེར་ཕེབས་འདུག་ཟེར་གགསན་པས་ཤིན་ཏུ་མཉེས་ཏེ།",
    "ཉིན་བྱེད་གླིང་པའི་ཚོགས་གུར་དུ་སྤྱན་དྲངས་འབུལ་བ་རྒྱས་པ་འདུག།",
    "སྔ་སོར་གྱི་གྲྭ་ཚང་གྱོ་ལེ་བ་འདི་རྣམས་ལ་ཕན་གང་ཐོགས་ཞིག་ནི་ངེད་རང་རྗེ་གོང་མའི་ཕྱག་བཞེས་ཀྱི་མཇུག་སྐྱོང་བའི་འོས་བབ་འདུག་པ་ལྟར་བགྱིད་རྩིས་ཡིན་ཕེབས་པར།",
    "རྣམ་རྒྱལ་ལྷུན་པོ་བའི་ཆིབས་བསུ་དང་བཅས་པ་འདུག།",
    "རག་མའི་ཀླུ་བཙན་སོགས་གཞི་བདག་དགའ་བའི་མཚན་མ་ཡིན་འདུག་གསུངས།",
    "རྡོ་རྗེ་གདན་པ་ཆེན་པོ་ཀུན་དགའ་རྣམ་རྒྱལ་གྱི་མཛད་པ་ལ་རྗེས་སུ་ཡི་རངས་པའི་སྒོ་ནས་བསྔགས་པ་ཆེ་བར་མཛད་ཀྱིན་འདུག།",
    "བྱམས་ཁང་ཡངས་པ་ཅན་དུ་སྨར་སྟོན་ལུང་བསྟན་རྡོ་རྗེའི་སྐུ་སྐྱེ་གྲ་ཕྱི་ཕུན་རབ་པའི་ཞལ་ངོར་འཁྲུངས་འདུག་པ་གཙུག་ཕུད་འབུལ་བ་དང་ལྷན་ཅིག་ཕྱག་འབུལ་ལ་བྱུང་བར།",
    "རྫུ་འཕྲལ་གྱིས་ཕེབས་པར་འདུག་ཅེས་ཀུན་གྱིས་སྒྲོག།",
    "ཕྱིས་སྒམ་པོ་ཞབས་དྲུང་ནོར་བུ་རྒྱན་པ་སོགས་སྐྱེས་ཆེན་རྣམས་ཀྱིས་ཀྱང་དེ་མཚུངས་ཀྱི་བསྔགས་པ་མཛད་པར་འདུག།",
    "གྲུམ་མདའ་ཚུན་ཆིབས་སྐྱེལ་ཐབ་འཛིན་དང་བཅས་པ་འདུག།",
    "དེ་དུས་མིང་ལམ་གྱི་མཚན་མ་མི་བསྲུན་པ་འགའ་ཞིག་བྱུང་བ་རྣམ་རྒྱལ་ལྷུན་པོ་སོགས་ལ་བལྟ་བར་འདུག་གསུངས།",
    "གདན་སར་འབོད་པ་ཡིན་གསུང་བཤར་ནས་ཕེབས་འདུག་ཀྱང་།",
    "ཕྱགས་བྲལ་གྱི་བསྟན་པ་ལ་ཕན་ཐོགས་ཆེར་ཐུབ་པར་མི་འདུག།",
    "ལྷོ་ཕྱོགས་ཀྱི་མཁའ་ལས་བྱ་རྒོད་བརྒྱད་ཅུ་རྩ་བཞིའི་གྲངས་ཀྱི་ངེས་པ་་འོངས་ཏེ་བག་ཕེབས་པར་ཉེ་འཁོར་དེར་འཁོད་ཅིང་འདུག་པ་ལས།",
    "རང་རང་བཅོལ་བའི་བྱ་བ་རྒྱབ་ཏུ་སྐྱུར།",
    "ཁ་རོག་མི་སྨྲ་འདུག་ན་ལྐུག་པར་མཐོང་།",
    "གཞིས་ཀ་ཞིག་གསོས་མཛད་འདུག་པར་ཕྱག་ནས་གནང་།",
    "ད་ལམ་ངོས་ཀྱི་བཅད་རྒྱར་བར་ཆད་ཙམ་དུ་འདུག་སྟེ།",
    "ད་དུང་ས་ཐག་རིང་པས་སྐུ་གཞོགས་སུ་འཕྲལ་འགྲོར་ཐུབ་པ་མི་འདུག་པས་སྐུ་མཚམས་བཅད་རྒྱའི་ཁོངས་སུ་ཚུད་པའི་སྐུ་ངོ་ཐུགས་ལ་འདོགས་པ་ཞུ་གསུང་བའི་སྙུ་ཡིག་བྱུང་བ་ལྟར།",
    "མངའ་རིས་རྒྱལ་པོ་མཆོད་ཡོན་གྱི་ཞུ་ཐོ་གསེར་སོགས་འབུལ་བ་སྟོབས་ཆེ་བ་དང་བཅས་འདུག།",
    "གཞི་གཅིག་ཏུ་ཞི་བདེ་དོན་གཉེར་གྱི་རྣམ་པ་ཀུན་ཏུ་འདུག་པ་ནི་སྐྱེས་བུ་ཆེན་པོའི་ཚུལ་མ་ཡིན་པས།",
    "སེར་སྦྲེངས་ཀྱི་བཀོད་པའང་ཕུན་སུམ་ཚོགས་པ་འདུག།",
    "ཁྲོམ་པ་རྣམས་ལ་ངོ་མཚར་བའི་མཐོང་སྣང་མང་པོ་བྱུང་འདུག་ཅིང་།",
    "ཞལ་ཆེམས་བཞིན་བསྔོ་རྟེན་འབུལ་བ་རྒྱ་ཆེར་འདུག་པ་རྣམས་ཡོངས་སུ་བསྔོ་བའི་རྒྱས་འདེབས་མཛད།་",
    "ཞབས་དྲུང་ཉིད་གཟིམས་ཆུང་འགག་ཏུ་ཕེབས་འདུག་པར་མཇལ་དར་ཕྱག་འབུལ་རྩེ་སྤྲོད་གནང་།",
    "ཆོག་ཐུ་རྒྱལ་པོ་དང་དབྱེར་མི་ཕྱེད་པར་མཐོང་བས་དད་པ་དང་ཟིལ་ཚུགས་པ་མེད་པ་བྱུང་འདུག།",
    "རྟ་དང་གོས་སྡིག་སོགས་འབུལ་བ་རྒྱ་ཆེན་པོ་འདུག།",
    "སྤྱི་སོ་ཕྱག་མཛོད་རྣམས་ནས་འབུལ་ཞབས་བསམ་གྱིས་མི་ཁྱབ་པ་འདུག།",
    "བདག་ལ་ཞུ་བ་ཞིག་འདུག་པས་དགོངས་དགོས་ཞུས་པས།",
    "འདི་ལ་སློབ་དཔོནི་ཆེན་པོ་པདྨ་སམྦྷ་ཝས་བཟློག་ཐབས་འབའ་ཞིག་གསུངས་པ་མ་གཏོགས་རྫོར་ཐབས་གསུངས་པ་མི་འདུག།",
    "ང་ནི་བྲེལ་བ་འདི་རྣམས་ཆོད་ནས་བྱ་ཡུལ་དུ་མགྱོགས་པར་སླེབ་དགོས་པ་འདུག།",
    "ད་ལམ་བྱ་ཡུལ་ཕྱོགས་རིངས་ཁྱད་འདུག་པས་ཡུན་རིང་མི་སྡོད།",
    "རྨི་ལྟས་འདི་ཡང་རྒོད་བྲོ་པོ་འདུག།",
    "ད་ན་རྒྱུ་གང་ཡང་མི་འདུག་གསུངས།",
