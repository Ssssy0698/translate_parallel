    "གཡུལ་གྱི་དུས་སུ་ས་ཡི་དཀྱིལ་འཁོར་ལ་ཕྱོགས་གང་དུ་ཇི་ལྟར་གནས་པའི་ཚུལ་ཤེས་པར་བྱ་སྟེ།",
    "དེ་ཇི་ལྟར་ཤེས་པར་བྱ་ཞེ་ན།",
    "དེར་མ་ཟད་གཟའ་བདུན་པོ་ཡང་རྒྱུ་སྐར་གང་དང་གང་ལ་གནས་པ་ཤེས་པས་ད་ལྟ་ཕྱོགས་གང་དང་གང་ན་འཁོད་པ་དེ་ཤེས་ཤིང་ས་ཡི་སྟོབས་བརྩི་བའི་ཚུལ་དཀའ་བ་མེད་པར་ཁོང་དུ་ཆུད་པར་འགྱུར་བས་སྒྲ་གཅན་བརྩི་བའི་འཁོར་ལོ་སུམ་བརྩེགས་མ་འདི་དེང་སང་སྐར་རྩིས་པ་ཡོངས་ལ་གྲགས་པའོ།",
    "སྒྲ་གཅན་གྱི་དུས་མི་བཟད་པ་ལ་གནས་པ་རྣམས་ནི་འཆི་བ་དང་བཅས་པར་འགྱུར་ཞིང་དེར་གནས་པའི་དཔུང་རྣམས་མཉམ་དུ་ལྷུང་བ་སྟེ་འཕམ་པ་ནི།",
    "སྲིད་གསུམ་རྣམ་རྒྱལ་གྱི་དུས་སྦྱོར་ཁྱད་པར་ཅན་ནི།",
    "མདུན་དབུས་སུ་ཟླ་བ་ཡོད་པ་ལ་ལས་བརྩམ་པ་ན་སྲིད་པ་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དུས་ཁྱད་པར་འཕགས་པ་ཡིན་ནོ།",
    "དང་པོ་ཕ་རོལ་གཞོམ་པའི་འཁྲུལ་འཁོར་གྱི་དགོས་པ་གསུངས་པ།",
    "གཡུལ་དུ་ཕམ་པར་གྱུར་པའི་དགྲ་བོ་དག་ནི།",
    "ཞེས་པ་བུག་པ་སོར་བཅུ་བཞི་པ་ཞེང་དུ་སོར་བདུན་པ་ཕུག་པར་བྱས་ལ།",
    "སྒྱོགས་མདའ་དེ་དེའི་བུ་གར་རབ་ཏུ་གཞུག་པར་བྱ་སྟེ།",
    "འཕྲུལ་ཤིང་ཨོ་ལོག་གཅུ་ཡི་རྒྱབ་ཀྱི་ཆ་ལ་ལྕགས་ཀྱི་གཟེར་གྱིས་གདབ་སྟེ་བརྟན་པར་བྱའོ།",
    "སུམ་ཆའི་བར་དུ་བུག་པ་གཉིས་ཕུག་པར་བྱས་པའི་བུག་པ་དེར་ལྕགས་ཀྱི་ཨ་ལོང་གཉིས་ལྡན་པ་དེའི་དབྱིབས་ཟླུམ་པོ་མཐའ་སྐོར་སོར་དྲུག་ཅུ་པ་ལྕགས་ཀྱི་དབྱུག་གུ་ཟླུམ་པོ་དེའི་རྒྱར་སོར་དྲུག་པའོ།",
    "སྤང་ལེབ་ཁ་འགྲིག་པར་གཤོང་བྲུས་ཏེ་ཆུ་མི་འཆོར་བར་སྤྲད་པ་དག་སྟེང་འོག་ཤར་ལྷོ་ནུབ་བྱང་ཀུན་ཏུ་དང་།",
    "སྲིད་དུ་ཁྲུ་ལྔ་པ་རྒྱར་གཅིག་པ་ཅན་གྱི་རྒྱལ་མཚན་རྣམས་དང་བཅས་པ་ཀ་བར་གདགས་པར་བྱའོ།",
    "འཁྲུལ་འཁོར་དེར་མེ་ཡི་འབྲུ་མར་དང་མེ་དང་བཅས་པའི་སྐྱེས་བུ་ཞིག་གཞུག་པར་བྱ་ཞིང་།",
    "འཁོར་ལོ་དེ་ཡི་ཚད་ནི་ཐད་ཀར་ཁྲུ་ནི་ཕྱེད་དང་གསུམ་པར་འགྱུར་ཞིང།",
    "ཞེས་གསུངས་ཏེ།",
    "རི་ཡི་མཐོ་དམན་དང་དགྲ་ཡི་ས་ཡི་བར་ཐག་ལ་ཇི་ཙམ་ཡོད་པའི་ཚད་ཀྱང་ཚུལ་དེ་ཡིས་ཤེས་པའམ་བརྗོད་པར་འགྱུར་ཏེ།",
    "དེ་ནས་མཁར་གྱི་རྩིག་པ་འཇིག་པ་རྡོ་རྗེ་གུར་གྱི་འཁྲུལ་འཁོར་གསུངས་པ།",
    "དེ་ནས་གོ་ཆ་འབིགས་པ་ལྕགས་མདའི་འཁྲུལ་འཁོར་གསུངས་པ།",
    "ཁྲུ་གཉིས་ཐུར་དུ་བརྐོས་པའི་ས་ཡི་ནང་དུ་ནུབ་ཅིང་བརྟན་པར་བཙུགས་པ་དག་ཏུ་བྱས་ལ།",
    "ས་ཡི་གནས་ནས་སྟེང་དུ་ཁྲུ་ཕྱེད་དང་གཉིས་དོར་ཏེ་དེ་ནས་གཡས་དང་གཡོན་གྱི་ཀ་བའི་བུག་ལ་འཕྲུལ་ཤིང་ངམ་གདང་བུ་གཞུག་པར་བྱའོ།",
    "སྟེང་དུ་སོར་དྲུག་དོར་ནས་ཐག་པ་རྣམས་ཀྱིས་དམ་པོར་དཀྲིས་པར་གྱུར་པ་སྟེ།",
    "ཟླུམ་པོ་དང་རལ་གྲིའི་ཆང་ཟུང་ཐད་ཀར་ཕུག་པ་ལ་ངེས་པར་གཡོ་བ་མེད་པར་བྱ་བའི་དོན་དུ་སྣ་གཟེར་གྱིས་བཏབ་པར་རབ་ཏུ་འགྱུར་རོ།",
    "དབུས་ཀྱི་ཆ་ལ་ལྕགས་ལས་བྱས་པ་ཆུང་ངུ་ཡང་ལ་སྲབ་པ་གཅིག་ཀྱང་བཞག་པར་བྱ་སྟེ་རལ་གྲི་མནན་པའི་དོན་དུའོ།",
    "དེ་ནས་རྒྱལ་རིགས་འཐབ་པ་ཤིང་རྟའི་མཚན་ཉིད་གསུངས་པ།",
    "ཤིང་རྟའི་དོན་དུ་དང་པོར་སྲོག་ཤིང་བརྟན་པོར་བྱས་ལ།",
    "དེ་ལྟར་ཟླ་བ་ཆ་གཅིག་ལ་སོགས་པ་རྣམས་རྩ་བའི་གནས་དང་སོ་སོའི་གདན་ལ་སོགས་པ་རྣམས་ཀྱི་ཚད་ངེས་པར་ཤེས་པར་བྱའོ།",
    "དགའ་བའི་ཤིང་རྟས་དབྱེ་བ་དག་ལ་གྲུ་བཞི་པར་མཉམ་པར་འགྱུར་རོ།",
    "ལྷ་མ་ཡིན་རྣམས་རྣམ་པར་འཇོམས་པ་ཡི་ཤིང་རྟའོ།",
    "གཡུལ་དུ་ཕྱིར་མི་ལྡོག་པར་འཇུག་པར་འགྱུར་བ་མི་མཉམ་པ་དང་མཉམ་པའི་ཤིང་རྟ་ཆེན་པོ་རྒྱལ་རིགས་རྣམས་ཀྱི་ཤིང་རྟའོ།",
    "དེ་འདྲེན་པའི་གཉའ་ཤིང་གསུམ་དང་ཐག་པ་གཉིས་ཀྱིས་རྟ་སོགས་འདྲེན་བྱེད་དེའི་རྒྱབ་ཀྱི་སྟེང་གནོན་ཅིང་འཇོམ་པས་ན་མངོན་དུ་ཕྱོགས་པའི་དགྲ་འཇོམས་དང་འདྲེན་བྱེད་ཀྱི་སྟེང་ངམ་རྒྱབ་འཇོམས་པ་ནི་མཉམ་པར་འགྱུར་རོ།",
    "དེ་ལྟར་རང་ཕྱོགས་བསྲུང་བའི་ཆེད་དུ་ས་འོག་རལ་གྲིའི་འཁྲུལ་འཁོར་དང་རྒྱལ་རིགས་འཐབ་པའི་ཤིང་རྟའི་མཚན་ཉིད་གཉིས་གསུངས་སོ།",
    "དེ་ནས་ཞར་ལ་བདེ་བར་སྤྱོད་པའི་འཁྲུལ་འཁོར་གསུངས་པ་ལས།",
    "བུག་པའི་གྲངས་མཉམ་པར་བུག་པར་འགྱུར་ཏེ་གང་ཞེ་ན།",
    "སྟེང་དང་འོག་ཏུའམ་གཡས་དང་གཡོན་བྱས་ཀྱང་རུང་སྟེ།",
    "བུམ་པ་ཡོད་པའི་སྦུབས་ལས་གཞན་པའི་སྦུབས་རྩ་བའི་འཁྲུལ་འཁོར་གྱི་ཆུའི་ནང་དུ་གཞུག་པར་བྱའོ།",
    "དེ་ནས་ཇི་སྲིད་རྩ་བའི་འཁྲུལ་འཁོར་ཆུས་གང་བར་གྱུར་གྱི་བར་དུ་རྩ་བའི་འཁྲུལ་འཁོར་གྱི་དབུས་སུ་བུག་པ་ནས་ཆུ་གཞུག་པར་བྱའོ།",
    "སྐབས་མིན་ལ་མི་དགོས་པར་མཁས་པ་དག་བཞེད།",
    "དོན་དུ་མི་གནས་པ་ཅུང་ཟད་ཡོད་ན་མཐོལ་ཞིང་བཤགས་སོ།",
    "འཁྲུལ་འཁོར་གསུངས་པའི་སྐབས་ཀྱི་མཇུག་བསྡུ་བ་ནི།",
    "ཞེས་གསུངས་པ་ལྟར་དུས་ཀྱི་འཁོར་ལོ་ཡོངས་སུ་ཤེས་པ་དང་ལྡན་པའི་རྗེས་འཇུག་གཞན་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་ཀྱི་བཀའི་ངེས་པའོ།",
    "ལྷོ་ན་ཆུ་བོ་ཤཱི་ཏ་འབབ་པ་མདུན་དུ་བྱས་པའི་རྒྱབ་མདུན་ལ་ལྟོས་ནས།",
    "ཕྱེད་ཤར་མ་གཡོན་མར་བྱས་ཏེ་དེའི་ཕྱེད་གཡས་ན་ཤམ་བྷ་ལ་ཞེས་པའི་ཡུལ་ཡོད་པ་དེ་ཉིད་ལ་པདྨ་འདབ་བརྒྱད་ལྟར་བྱས་ནས་འཆད་དགོས་པར་མཁས་གྲུབ་འགྲེལ་ཆེན་དེ་ཉིད་སྣང་བར་གསུངས་ལ།",
    "བདག་པོ་ཇི་ལྟ་བུ་གནས་ཞེ་ན་གསུངས་པ།",
    "དེ་ཕན་ཆད་གཡོན་དུ་བྱས་ཏེ་འཛམ་གླིང་ཆུང་ངུའི་ས་འདི་དུམ་བུ་གཉིས་སུ་ཕྱེད་མར་བྱས་པ་ནི་གླིང་འདིའི་ཤར་ལ་མདུན་དུ་བརྩིས་ཤིང་ནུབ་ལ་རྒྱབ་ཏུ་བྱས་པའི་ཚུལ་གྱིས་ལྷོ་ལ་གཡས་དང་བྱང་ལ་གཡོན་ཅེས་རྒྱུད་འདིར་དུ་མར་གསུངས་པ་ལྟར་བྱས་ནས།",
    "སྐབས་འདིར་ཡུལ་དྲུག་ཏུ་ཕྱེ་བའི་གངས་ཅན་གྱི་ནུབ་ཕྱེད་ཀྱི་དུམ་བུ་ལ་ཤམ་བྷ་ལ་ཡོད་པར་བཞེད་པ་དེའི་ལུགས་ལ།",
    "ཤམ་བྷ་ལའི་ཡུལ་གྱི་གྲོང་མང་པོ་དེ་ཙམ་ཤོང་བར་མི་སྲིད་སྙམ་དུ་དོགས་པ་བསལ་བ་མཁས་གྲུབ་པའི་འགྲེལ་ཆེན་དེ་ཉིད་སྣང་བྱེད་དུ་གསུངས་པ།",
    "བསྒྱུར་བྱ་སྒྱུར་བྱེད་གཉིས་ཀ་འདོམ་གྱི་ཕུང་པོར་བྱས་ནས་ཤེད་མཚུངས་པར་བསྒྱུར་བར་བྱ་སྟེ།",
    "དེ་ལ་ཤམ་བྷ་ལ་དེར་མིའི་བདག་པོ་ཇི་ལྟར་བྱོན་པ་གསུངས་པ།",
    "དབྱེ་བ་ཡིས་ཕྱེ་བ་འཁོར་ལོ་ཅན་ནི་ཞེས་གསུངས་པའི་ཚིག་དོན་ལ་མ་ཞུགས་སོ་ཞེས་མཁས་པ་དག་གསུངས།",
    "ལུང་གཞན་ལས་སྒྲ་མི་སྙན་སོགས་སུ་བསྟན་པ་མེད་པར་གསུངས་པ་སོ་ཐར་གྱི་སྡོམ་པའི་རྟེན་དུ་མི་རུང་བའི་ཆ་ནས་ཡིན་གྱི།",
    "ཞེས་དོན་དུ་འཁོར་ལོ་ཅན་ནི་ཡང་དག་ཡེ་ཤེས་སོགས་འོག་ནས་འཆད་པར་འགྱུར་བ་ལྟར་དུའོ།",
    "ཕྱི་རོལ་དུ་ལོ་གཅིག་དང་བགྲོད་པ་གཉིས་ལ་སོགས་པའི་དུས་ཀྱི་དབྱེ་བར་ངེས་པར་འགྱུར་ཏེ།",
    "དེ་ལས་གཞན་པ་རྗེ་དཔོན་ལ་སོགས་པའི་རྣམ་པར་སྣང་བ།",
    "ཕྱག་རྒྱ་ལག་པས་འཛིན་པའི་དོན་ཡང་ཇི་ལྟ་བུ་ལ་བྱ་བ་ཤིན་ཏུ་དཀའོ་ཞེས་གསུངས་སོ།",
    "ཞེས་སོགས་གསུངས་པ་ལྟར་གྲགས་པ་ནས་རིགས་ལྡན་བཅུ་གཉིས་དང་།",
    "སུམ་ཅུ་རྩ་གཉིས་གདན་གྱི་མཐར་ནི་ཞེས་པ་ཉི་ཤུ་རྩ་གཉིས་ཞེས་པར་འདོན་ཏོ།",
    "ཞེས་གསུངས།",
    "ཞེས་གསུངས་པ་དང་།",
    "ལྷ་མིན་རིགས་ལ་འཇིགས་པ་དངོས་སུ་སྟེར་བའི་གཙོ་བོ་འཁོར་ལོ་ཅན་དང་སྲས་གཉིས་སོགས་ལྷ་མིན་ལ་འཇིགས་པ་སྟེར་བའི་སྐྱེ་གནས་བརྒྱད་དུ་མི་གཏོགས་པར་འདོད་པའི་ལུགས་ལ།",
    "འོད་སྲུང་མ་གཏོགས་པའི་རིགས་བརྒྱུད་ལྷག་མ་དུམ་ཅན་བརྒྱད་པོས་ཀླ་ཀློའི་རིགས་ལ་ལྷག་པར་འཇིགས་པ་ཅི་ཞིག་སྟེར་ཏེ།",
    "ཀླ་ཀློའི་སྟོན་པ་འབྱུང་ཚུལ་དང་ཀླ་ཀློ་རྣམས་ཀྱི་ཀུན་སྤྱོད་གསུངས་པ།",
    "ཀླ་ཀློ་རྣམས་ཀྱི་ཀུན་སྤྱོད་ནི་ཡུལ་གང་དུ་འཇིག་རྟེན་ན་ལྷ་མིན་གྱི་ཡན་ལག་གམ་ཕྱོགས་སམ་རིགས་སུ་གྱུར་པའི་བདུད་ཀྱི་རིས་སྟོབས་དང་ལྡན་པར་བྱེད་པ་ཉིད་དུ་གནས་ཤིང།",
    "ཐིག་ལེ་ནུས་མ་ཞེས་སོགས་གསུངས་ཏེ།",
    "དེ་ལྟར་རྒྱལ་བ་ཡི་ནི་ཡེ་ཤེས་ཀྱི་སྐུ་གཉིས་སུ་མེད་ཅིང་མཆོག་ཏུ་མི་འགྱུར་བ་ནམ་མཁའ་དང་མཉམ་པ་ལ་བཞུགས་ནས།",
    "དུས་གསུམ་གྱི་དོན་དུ་གྱུར་པའི་ཤེས་བྱ་དང་གནས་ལྔ་རིག་པ་རྣམས་གདུལ་བྱ་ལ་སྟོན་པར་མཛད་དོ་ཞེས་སོ།",
    "དུས་ཀྱི་འཁོར་ལོའི་གཞལ་ཡས་ཁང་བཞེངས་པ་ལ་སོགས་པའི་བྱ་བ་དག་ནི་རྫོགས་པར་བྱས་ནས།",
    "ཅིའི་ཕྱིར་ན་རིགས་དང་རིགས་མ་ཡིན་པར་དབྱེ་བའི་བརྟུལ་ཞུགས་ཐ་དད་པ་ལ་གནས་པའི་བྲམ་ཟེ་སོགས་རིགས་བཞི་པོ་རྣམས་ལ།",
    "རིགས་ལྡན་གྲགས་པ་ཉིད་ཐོག་མར་བྱས་ཏེ།",
    "དེ་ཉིད་ཀྱི་སྐུའི་རྣམ་པའང་སྤྲུལ་པའི་རྡོ་ཡི་རྟ་ལ་བཅིབས་ཤིང་འཁོར་ལོ་ཅན་གྱི་ཕྱག་ན་མདུང་ཐུང་བསྣམས་ནས་མཐའ་དག་དགྲ་ཡི་ཚོགས་ལ་སྣུན་པར་བྱེད་པའི་སྐུ་བལྟ་བར་མི་བཟོད་པ་ཉི་མའི་གཟི་བརྗིད་ཅན་ནོ།",
    "དེ་ཡང་འཆི་མེད་མཛོད་རྩ་འགྲེལ་ལས་གསུངས་པ་གླང་པོ་གཅིག་ཤིང་རྟ་གཅིག་རྟ་གསུམ་རྐང་ཐང་ལྔ་དང་བཅས་པའི་མིང་ལ།",
    "པདྨ་ཅན་ནས་རྐང་ཐང་ས་ཡ་ཕྲག་དྲུག་གསུངས།",
    "དེ་ཡང་འཆི་མེད་མཛོད་ལྟར་རྟ་པ་གསུམ་ལ་རྐང་ཐང་ལྔ་ཐོབ་པས་དེ་ཡི་འགྲོས་ཀྱིས་རྟ་པ་བྱེ་བ་དགུ་རྒྱུད་ལས་གསུངས་པས་རྐང་ཐང་དུང་ཕྱུར་གཅིག་དང་བྱེ་བ་ལྔ་ལ།",
    "བཏྟི་གཅིག་བྱས་ནས་སྔ་མ་ལྟར་ཨ་ཀྵོ་ཧི་ཎཱིའི་བར་དུ་བརྩིས་པས་རྐང་ཐང་ཁྲག་ཁྲིག་གསུམ་དང་ཐེར་འབུམ་ཆེན་པོ་གཉིས་ཐེར་འབུམ་བརྒྱད་བྱེ་བ་ལྔ།",
    "ཨཀྵོ་ཧི་ཎཱི་ནི་འཆི་མེད་མཛོད་རྩ་འགྲེལ་ལས་གྲགས་པ་ལྟར་དཔུང་བཞི་ཀའི་གྲངས་སུ་བྱས་ནས་དེ་དྲུག་འགྱུར་ཞིག་ཡོད་པར་བྱས་ན་མི་རུང་བ་ཅི་ཞིག་ཡོད་དེ་དོན་མེད་ཀྱི་རྐང་ཐང་གྲངས་མང་བརྩི་བ་མི་དགོས་པ་འདྲ་ཞིང་།",
    "ཀླ་ཀློའི་དམག་དཔོན་རྟ་ཡི་བཞོན་པ་ལ་གནས་པ་ཟླ་བ་ཆེན་པོའི་བུ་ནི་རིགས་ལྡན་གྱི་འཁོར་ཧ་ནུ་མཱན་དཱ་ཞེས་བྱ་བས་རྣོན་པོའི་མཚོན་གྱིས་བསྣུན་པར་འགྱུར་ཞིང་།",
    "བྱེད་པའི་བློ་འམ་བྱས་པའི་བློ་ཞེས་སུ་ཡང་བསྒྱུར་རོ།",
    "དཔེར་ན་ལས་ཁྱད་པར་ཅན་ནམ།",
    "ཞེས་གསུངས།",
    "པད་དཀར་སོགས་ལ་སྦྱར་ནས་གྲགས་པ་ནས་དྲག་པོའི་བར་གྱི་མི་རྣམས་ལོ་བརྒྱ་ཕྲག་བཅོ་བརྒྱད་དང་ལྡན་པར་འཆད་པ་སོགས་ཡོད་ལ།",
    "དེ་ནི་ལོ་བརྒྱ་ཁོ་ནར་ངེས་པར་བཟུང་བ་མ་ཡིན་ནོ།",
    "དེས་ན་མི་ཡི་ལོ་ནི་བརྒྱ་ཕྱེད་ན་རིགས་ལྡན་གྲུབ་པར་འགྱུར་ཏེ་ཞེས་གསུངས་པའང་།",
    "གཞན་དག་འདི་སྙམ་དུ་རིགས་ལྡན་གྲགས་པ་སོགས་ཀྱི་སྐུ་ཚེའི་ཚད་དགུ་བརྒྱ་ཡིན་པར་ངེས་ན།",
    "བསྡུས་རྒྱུད་བསྟན་པའི་རྗེས་སུ་ཡང་ལོ་བརྒྱ་ཕྲག་འགའ་ཞིག་ཏུ་བཞུགས་དགོས་ན་ཡང་།",
    "གྲགས་པའི་ཁྲི་ལོ་རྫོགས་པ་དེ་ནས་ལོ་བརྒྱད་བརྒྱ་ན་ཀླ་ཀློའི་དུས་ཡིན་པར་རྩོད་པ་མེད་ཀྱང་།",
    "འཁོར་ལོས་སྒྱུར་བ་ཆེན་པོ་ནས་རིགས་ལྡན་གྱི་མཐར་ཐུག་པའི་མི་རྣམས་ཀྱི་ཚེའི་ངོ་བོ་ཉིད་ཀྱི་གནས་པ་ཞེས་པའི་དོན་ལ་རྟོག་དཔྱོད་མ་ཞུགས་པར་ཟད་དོ།",
    "རིགས་ལྡན་བཅུ་པ་བརྒྱ་མཚོ་རྣམ་རྒྱལ་ཁྲིར་ཕེབས་པའི་ལོ་དེ་ལ།",
    "དེའི་རྗེས་སུ་རིགས་ལྡན་བཅུ་གཅིག་པ་རྒྱལ་དཀའ་ཁྲི་ལ་བཞུགས་ཤིང་བྱེད་པའི་རྩིས་མགོ་བཟུང་།",
    "བཅོ་བརྒྱད་པ་སེང་གེབཅུ་དགུ་པ་རྣམ་པར་གནོན།",
    "དེ་ཕྱིན་ཆད་རིགས་ལྡན་དྲག་པོ་འཁོར་ལོ་ཅན་གྱིས་གསོས་པའི་བསྟན་པ་ཕྱི་དར་གྱི་གནས་ཚད་སྟོང་དང་བརྒྱད་བརྒྱར་གསུངས་སོ།",
    "ཀླ་ཀློའི་གནས་ཚད་སྟོང་བརྒྱད་བརྒྱར་གསུངས་པ་དང་ཆད་ལྷག་མེད་པར་འགྲིགས།",
    "ཕུག་པ་པས་གོ་དྲུག་བར་དུ་ཁྲིར་བཞུགས་གོ་བདུན་གྱི་ལོ་ལ་ཀླ་ཀློ་འདུལ་དུ་བྱོན་པར་བཞེད་ཅིང་སྐུ་ཚེའི་ཚད་བརྒྱར་འདོད་དོ།",
    "དང་པོ་ཡོངས་སུ་གྲགས་ཆེ་བའི་རྩིས་གཞུང་ཕུག་པ་པའི་ལུགས་ཀྱི་དུས་འཁོར་རྩ་རྒྱུད་གསུངས་པའི་ལོ་དག་བརྗོད་པར་བྱས་པ་གཞིར་བྱས་ནས།",
    "དེ་ལས་མང་བ་དང་ཉུང་བར་འདོད་པ་རྣམས་ཕྲི་སྣོན་གྱི་སྒོ་ནས་ཤེས་པར་བྱ་བ་ལ།",
    "ངོ་ཐོག་གྱ་གཅིག་པ་ལྕགས་འབྲུག་ནག་པའི་ཉ་ལ་འབྲས་སྤུངས་ཀྱི་མཆོད་རྟེན་དུ་དུས་འཁོར་རྩ་རྒྱུད་གསུངས།",
    "དེའི་ཟླ་བ་ཕྱི་མ་ས་གའི་ཉ་ཡི་མཚན་ཐུན་ཐ་མར་རྩྭ་མཆོག་གྲོང་དུ་མྱ་ངན་ལས་འདས་སོ་ཞེས་བཞེད་པ་འདིའི་ལུགས་ཀྱི་དུས་འཁོར་ཞལ་ཆེམ་གྱི་ཚུལ་དུ་བསྟན་ནས་ལོ་དེ་ལ་མྱ་ངན་ལས་འདས་པར་བཞེད་དོ།",
    "དུས་འཁོར་རྩ་རྒྱུད་གསུངས་པ་དང་།",
    "ཞེས་གསུངས་ཐོག་མ་འདི་ཡིན་ལ།",
    "བཅུ་དགུ་བསྣན་པར་བྱས་པ་ན།",
    "ལོ་དེར་མ་འགགས་པ་ཁྲིར་ཕེབས།",
    "དྲུག་ཅུས་བསྒྱུར་བ་བསྲེས་བྱས་ན།",
    "རིགས་ལྡན་བཅུ་གཉིས་པར་གྱུར་པ།",
    "སེང་གེ་དང་ནི་རྣམ་པར་གནོན།",
    "འདས་པར་འདོད་ཀྱང་དཔྱད་བྱར་སྣང་།",
    "ལུགས་གཞན་སྣོན་འབྲིད་བྱས་པས་ཤེས།",
    "མཁས་གྲུབ་རྗེ་སོགས་བཞེད་པར་གྲུབ།",
    "ཟླ་བ་དེའི་རྗེས་མ་ས་གའི་ཉ་ལ་མྱ་ངན་ལས་འདས་པར་བཞེད།",
    "རིགས་ལྡན་ཉེར་ལྔ་བྱས་ན་ལུགས་དེར་བསྟན་པའི་གནས་ཚད་ལྔ་སྟོང་ལས་ལོ་བརྒྱ་ལྷག་ཙམ་ཉུང་ཞིང་།",
    "དེ་ཉིན་ཚེས་རྩིས་བྱས་པས་གཟའ་འཛིན་དང་འགྲིགས།",
    "བྱ་རྒོད་སྤུངས་རིར་ཤེར་ཕྱིན་གསུངས།",
    "ཞེས་གསུངས།",
    "ཕུག་ལུགས་ཀྱི་སྟོན་པས་དུས་འཁོར་རྩ་རྒྱུད་གསུངས་ཕྱིན་གྱི་འདས་པའི་ལོ་གྲངས་དེ་ལ་བཞིས་ཕྲི་ན་ཇོ་ནང་ཕྱོགས་ལས་རྣམ་རྒྱལ་གྱི་ལུགས་སོ།",
    "འདིའི་ལུགས་ལ་ཤིང་སྤྲེལ་ལ་རྩ་རྒྱུད་གསུངས་པར་བཞེད།",
    "འདི་རྣམས་ཕུག་ལུགས་ཀྱི་དུས་འཁོར་རྒྱུད་གསུངས་པའི་ལོ་དག་ལས་ཉུང་ངོ།",
    "ཡང་ཕུག་ལུགས་པའི་རྩ་རྒྱུད་གསུངས་པར་འདོད་པའི་ལོ་གྲངས་དེ་ལ་བཞི་བརྒྱ་དང་བདུན་ཅུ་རྩ་གཉིས་བསྣན་པ་འགོས་ལོ་གཞོན་ནུ་དཔལ་གྱི་ལུགས་སོ།",
    "སྟོན་ཐའི་ཚེས་བརྒྱད་ལ་འདས་པར་འདོད་པའང་སྣང་།",
    "རབ་བྱུང་སོགས་དྲུག་ཅུའི་ཐ་སྙད་ཙམ་ཡོད་པས་མེ་ཡོས་དང་རབ་བྱུང་དོན་གཅིག་པར་བཞེད།",
    "དུས་འཁོར་རྩ་རྒྱུད་གསུངས་པའི་ལོ་གྲངས་ཕུག་ལུགས་ཀྱི་འདོད་པ་དེ་ལས་བཞི་ཕྲི་བ་ལས་མང་བར་ཕྲི་ན་དུས་འཁོར་རྒྱུད་ཀྱི་དངོས་བསྟན་ལོ་གྲངས་དང་མི་འགྲིགས་ཤིང་།",
    "ཕུག་ལུགས་ཀྱི་དུས་འཁོར་རྒྱུད་གསུངས་པའི་ལོ་དང་སྟོན་པ་མྱ་ངན་ལས་འདས་པའི་ལོ་གྲངས་འདྲ་ལ་དེ་ལས་མང་བ་ནི་དུས་འཁོར་རྒྱུད་རྩ་འགྲེལ་གྱི་དངོས་བསྟན་དང་མི་འགྲིགས་པ་ལྟ་ཅི།",
    "རིགས་ལྡན་འཇམ་དཔལ་གྲགས་པ་ལོ་ཉིས་བརྒྱར་བཞུགས་པ་དང་།",
    "དེ་རྣམས་ཕལ་ཆེ་བ་རྒྱུད་ཀྱི་ཚིག་དང་མི་མཐུན་ཞིང་ཁུངས་དང་མ་འབྲེལ་པའི་རྟོག་བཟོ་དཔྱད་མི་བཟོད་པར་སྣང་ཡང་འདིར་མ་སྤྲོས་སོ།",
    "ལྔ་སྟོང་དུ་གསུངས་པ་དགོངས་པ་ཅན་མ་ཡིན་པར་དོན་ལ་གནས་པར་མཁས་པ་ཀུན་བཞེད་པ་མཐུན་ཅིང་།",
    "དེ་ཉིད་དུས་འཁོར་གྱི་རྒྱུད་ལས་གསུངས་པ་ཞིབ་རྩིས་ཡིན་པའི་ཁྱད་ཅུང་ཟད་ལས་ཁོག་འགྲིགས་པས་རྒྱུད་འདི་ལས་གསུངས་པ་བཞིན་རྩི་དགོས་ལ།",
    "དྲག་པོ་འཁོར་ལོ་ཅན་ནམ་འབྱོན་པ་སོགས་ལེགས་པར་རྟོགས་པ་ནི་ལོ་དག་ལ་རག་ལས་པས་འདིར་སོ་སོའི་ལུགས་དང་།",
    "རྔ་པན་ཀུན་དགའི་མཚན་ཅན་གྱིས་རྩིས་གསར་ཐུབ་བསྟན་མཛེས་རྒྱན་ཞེས་པ་གཟའ་འཛིན་ཐིག་པར་དེ་དུས་གྲགས་ཆེ་ཡང་གཞུང་ནོར་ཚབས་ཆེ་བ་ཅན་དུ་མཐོང་།",
    "ལྷོ་བགྲོད་ཀྱི་ཕྱོགས་སུ་གྱུར་ཚེ་སྔ་མ་ལས་གོ་ལྡོག་པར་མཐོང་སྟེ།",
    "དེ་དང་བསྟུན་པར་ཡུལ་དུས་བསྒྲིག་པའི་ཞིབ་ཆ་སོགས་དུ་མ་ཞིག་དགོས་པར་མངོན་ནོ།",
    "ཁྱད་པར་དུ་ཉི་འཛིན་ཐིག་དཀའ་བར་སྣང་།",
    "ཉི་དག་ལས་བརྩི་དགོས་པར་མངོན་ལ།",
    "རྒྱུད་དོན་རྒྱ་མཚོ་ཕ་མཐའ་དཔག་ཡས་པར།",
    "དེ་ཕྱིར་སླར་ཡང་བདག་ནི་ཉན་པར་འཚལ་ལོ།",
    "ཅི་ཞིག་ཉན་འདོད་ན་ཕྱི་རོལ་དུ་སྣང་བའི་སྲིད་པ་གསུམ་པོ་མཐའ་དག་ནང་ལུས་ཀྱི་དབུས་སུ་ཇི་ལྟར་གནས་པར་གྱུར་པ་ལགས།",
    "ཞེས་ཞུས་པའི་ཟླ་བ་བཟང་པོའི་ཚིག་དེ་དག་གསན་ནས་སྟོན་པ་བདེ་བར་གཤེགས་པས་དེ་ལྟར་ཞུས་པ་ལ་ལེགས་སོ་ཞེས་བྱ་བ་བྱིན་ནས་རབ་ཏུ་གསུངས་པ།",
