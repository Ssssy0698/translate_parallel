    "ྐ་ཤ་ཥ་ྉྤ་ས་ནི་དཀར་པོའི་རགས་པ་དང་ཕྲ་བའི་གནས་སྐབས་ལ་ཤེས་པར་བྱའོ།",
    "འདིར་ནི་ཚེའི་གནས་སྐབས་ཚན་ལྔ་པ་ཉིད་དུ་རྣམ་པར་ཕྱེ་བ་ལ་དབྱངས་གསལ་འཆར་ཚུལ་ལོ།",
    "ཀྱེ་མི་ཡི་བདག་པོ་དེ་བཞིན་དུ་ཉ་རུ་ཉི་མ་ཞུགས་པ་དབོ་ཟླ་དག་ལ་ནི་རྣམ་པར་ཤེས་པ་སྟེ་ལུག་ཏུ་ཉི་མ་ནག་པ་ཡི་ཟླ་བ་ལ་ནི་མིང་དང་གཟུགས་སོ།",
    "ཐ་སྐར་ཟླ་བ་ཡི་མཐའ་མ་དག་ལ་རིམ་བཞིན་ལེན་པ་ཉིད་དང་སྲིད་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་ཉི་མ་ཁྱིམ་བཅུ་གཉིས་ལ་ཞུགས་པ་དང་ཟླའི་ཞེས་པ་ཟླ་བ་སོ་སོའི་དབྱེ་བ་དག་ལས་མ་རིག་པ་སོགས་འཆར་ཚུལ་དེ་ལྟར་ཤེས་པར་བྱ་ལ།",
    "མཉམ་མི་མཉམ་ནི་མ་རིག་པ་ནས་རིམ་པར་བརྩིས་པས་ཡ་རྣམས་མི་མཉམ་ལ་ཟུང་རྣམས་མཉམ་པའོ།",
    "གཉིས་པར་རྒ་ཤི་གསུམ་པར་སྐྱེ་བ་སོགས་སྡུད་པའི་རིམ་པས་སྟོང་ལ་སྐྱེ་བའི་བར་དུའོ།",
    "གཡུལ་འགྱེད་པ་སོགས་ཕ་རོལ་དང་རྩོད་པའི་དུས་སུ་དྲག་པོའི་གཟའ་ཉི་མ་དང་མིག་དམར་དང་མཇུག་རིངས་དང་སྤེན་པ་བཞི་ནི་ཁྱིམ་གྱི་རྒྱུ་སྐར་གྱི་རྐང་པ་གང་ལ་གནས་པ་གཟའ་ལྔའི་རྩིས་ཀྱིས་ཤེས་པར་བྱ་ཞིང་།",
    "ཡང་ན་རྒྱབ་ཀྱི་ཕྱོགས་དག་ཏུ་ཡང་དག་གནས་པར་བྱས་པས་ཕ་རོལ་དགྲ་ནི་འཆི་བར་བྱེད་དོ།",
    "རྣལ་འབྱོར་མ་བརྒྱད་ཀྱི་རྒྱུ་ཕྱོགས་གསུངས་པ།",
    "དེ་ལྟར་ཕྱོགས་འདི་དག་ཏུ་ཚེས་དེ་ལ་རྣལ་འབྱོར་མ་འདི་དག་ནི་འཆར་བ་དག་ཏུ་བྱེད་དེ་འཆར་ཕྱོགས་དེ་རྒྱབ་ཏུ་བཞག་ནས་དགྲ་དང་འཐབ་པར་བྱའོ།",
    "དེ་ནས་བིཥྚི་འཆར་ཚུལ་གསུངས་པ།",
    "ཉ་ལ་གནོད་སྦྱིན་གྱི་ཕྱོགས་ཉིད་དུ་ཡང་འདིར་འཆར་པར་འགྱུར་རོ།",
    "དེ་ནས་དྲག་པོ་འཆར་ཕྱོགས་ཀྱི་སྟོབས་གསུངས་པ།",
    "བྱང་བགྲོད་ཀྱི་ཁྱིམ་དྲུག་རྫོགས་ནས་ཆུ་སྟེ་ནུབ་ཕྱོགས་ནས་མ་ལྡན་ཤར་ལྷོའི་བར་དག་ཏུ་དྲག་པོ་དེ་ནི་ངེས་པར་འགྲོ་སྟེ་ནུབ་ནས་ལྷོ་རུ་ཕྱོགས་པར་ལྷོ་རུ་བགྲོད་པ་ཡི་ཉི་མ་ཡི་ཞག་དག་ལའོ།",
    "ཞེས་གསུངས་པ་ལྟར།",
