    "རིགས་པ་ཞེས་བྱ་བར་སྦྱར་ཏེ་སྙོམས་པར་འཇུག་པ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "ཤེས་རབ་རིགས་པའི་ཞེས་བྱ་བ་ནི་རྣམ་པར་མི་རྟོག་པ་ཉིད་ཀྱིས་སོ།",
    "དེ་སྟོན་པར་བྱེད་པ་ལ་ཡང་མིང་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "རྣམ་པར་ཤེས་པ་ནི་རྡོ་རྗེ་གཙུག་ལག་ལ་སོགས་པའོ།",
    "འཛིན་པ་ལས་ཡང་དག་པར་གྲོལ་བར་འགྱུར་ཏེ།",
    "ཞེས་བྱ་བ་ལ་དངོས་པོ་ཉིད་རྣམ་པར་མི་རྟོག་པར་བསྒོམས་པས་དངོས་པོ་མེད་པར་གསུངས་སོ།",
    "དེ་ཡང་གསུངས་པ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་མི་རྟོག་པའི་༡༥བ་ཏིང་ངེ་འཛིན་གྱི་ཚུལ་གྱིས་སོ།",
    "ལུས་ཀྱིས་མི་སྐྱེད་ཅེས་བྱ་བ་ནི་དེ་ལས་ལྷག་པར་གྱུར་པ་གཞན་མེད་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའི་རང་བཞིན་མ་ལུས་པར་ནུབ་པས་སོ།",
    "ལུས་གནས་ཀྱང་ཞེས་བྱ་བ་ནི་ལུས་ཀྱི་རྣམ་པར་སྣང་ཡང་ངོ།",
    "སྐྱེས་པ་རུས་སྦལ་སྐྱེ་བར་གསུངས།",
    "ངེས་དེ་འདེབས་མར་རབ་ཏུ་གསུངས།",
    "སེམས་ནི་མཉམ་པར་སྦྱོར་བས་ན།",
    "དེ་འདིར་བྲལ་མར་རབ་ཏུ་གསུངས།",
    "ལྷག་པར་གནས་པའི་སེམས་དང་བཅས་པས་དངོས་པོའི་མཚན་ཉིད་དེ།",
    "དབྱེ་བ་ནི་ཁྱད་པར་དུ་གྱུར་པ་སྟེ་༡༥༡བ་དེ་ཉིད་ཉན་ཐོས་ལ་སོགས་པའི་ལམ་ལས་འཕགས་པའོ།",
    "ཨཱ་ལི་ཀཱ་ལི་ཞེས་བྱ་བ་ནི་མ་ལུས་པའི་ཡོན་ཏན་རྫོགས་པར་བྱེད་པ་སྟེ་དབྱངས་དང་གསལ་བྱེད་ཀྱི་ཚོགས་སོ།",
    "སྡུག་བསྔལ་ནི་ཁམས་གསུམ་པོ་རྣམས་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "ཡོངས་སུ་ཤེས་པར་བྱའོ།",
    "ཡང་ན་འདུ་བྱེད་རྣམ་པར་འགྱུར་བ་དང་།",
    "འདི་ནི་ཤེས་པར་བྱ་སྟེ།",
    "སྤྲུལ་པའི་འཁོར་ལོ་ནི་དབྱུག་ཚོད་དྲུག་ཅུ་རྩ་བཞི་རྣམ་པར་དག་པས་འདབ་མ་དྲུག་ཅུ་རྩ་བཞིའོ།",
    "བདེ་བ་ཆེན་པོའི་འཁོར་ལོ་ནི་རྩ་ཆུ་ཚོད་སུམ་ཅུ་རྩ་གཉིས་རྣམ་པར་དག་པས་འདབ་མ་སུམ་ཅུ་རྩ་གཉིས་སོ།",
    "ཧཾ་ནི་ཞེས་བྱ་བ་ནི་མི་མཐུན་པའི་ཕྱོགས་ཀྱི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ལས་གྲོལ་བའི་མི་ཤིགས་པའོ།",
    "ལྟེ་བར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ་ཞེས་ཟེར་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ལྔ་ཞེས་བྱ་བ་ནི་ཕུང་པོ་ལྔའི་རྣམ་པར་རྟོག་པ་ཡིན་ལ།",
    "དེས་ནི་ཕུང་པོ་ལ་སོགས་པའི་རྫས་སུ་གྱུར་པའི་སྲེག་བླུགས་བསྟན་པར་འགྱུར་རོ།",
    "ཞེས་བསྟན་པའི་ཕྱིར་སྔགས་ཀྱི་ལེའུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞི་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་ལ་སྔགས་༡༥༣བ་པས་དང་པོ་གཏོར་མ་ཕུལ་ཏེ་འཇུག་པར་བྱའོ།",
    "ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་སྔགས་ཀྱི་ལེའུ་དེ་ལས་དང་པོར་གཏོར་མའི་སྔགས་སྟོན་པར་མཛད་པ་ཡིན་ཏེ།",
    "ཨ་ཀཱ་རོ་མུ་ཁཾ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གཏོར་མ་རྣམ་པར་དག་ཅིང་རྫོགས་པར་བྱེད་པ་ཡིན་ནོ།",
    "བྲུཾ་ཞེས་བྱ་བ་ལ་སོགས་པ་དེ་བཞིན་གཤེགས་པའི་ས་བོན་གསུངས་པ་ཡིན་ནོ།",
    "རྒྱུད་འདི་ལས་རྣམ་པར་དག་པ་ཐམས་ཅད་གསུངས་པའི་ཕྱིར་གཙོ་བོ་ཉིད་དུ་གྱུར་པས་དེའི་འོག་ཏུ།",
    "ཨོཾ་དེ་ཝ་བི་ཙུ་བཛྲ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཕྱག་བཅུ་དྲུག་པའི་སྔགས་གསུངས་པ་ཡིན་ཏེ།",
    "གྷུ་ཊྱ་གྷུ་ཊྱ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཀླུ་རྣམས་སྐྱོད་པར་བྱེད་པའི་སྔགས་བཟླས་པས་དབབ་པར་བྱའོ།",
    "རྒྱུད་འདི་ཉིད་ཀྱི་ལེའུ་གཞན་དག་ལས་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་སོ་སོར་བསྟན་པས་འཆད་པར་འགྱུར་རོ།",
    "ལྷའི་རྣལ་འབྱོར་མ་རྟོགས་པས་༡༥༤ཨ་རྣམ་པ་ཐམས་ཅད་དུ་ཐ་མལ་པའི་རྣམ་པ་བཟློག་པར་མི་ནུས་སོ་ཞེས་བྱ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར་དེ་ནས་ལྷའི་ལེའུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།"
  ]
}