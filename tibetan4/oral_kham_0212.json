    "ཡ་མཚན་ཞིང་ངོ་མཚར་བའི་རྟགས་རྣམས་རྒྱས་པར་བརྗོད་ན་བསམ་གྱིས་མི་ཁྱབ་ཅིང་བརྗོད་ཀྱིས་མི་ལང་བར་འདུག་པས།",
    "བོགས་ཀྱི་འདོན་ཐབས་གེགས་ཀྱི་སེལ་ལུགས་ལ་སོགས་པ་ཐང་མར་བརྡལ་ནས་འདུག་ཅེས་པའི་དོན་ནོ།",
    "ལར་ནས་མ་དཔེ་དེའི་ནང་དུ་ནོར་འཁྲུལ་ཆད་ལྷག་ཇི་སྙེད་ཅིག་འདུག་པས་མངོན་གསལ་དོད་པོའི་རིགས་རྣམས་བཅོས་པ་མ་གཏོགས་གཞན་བཅོས་མ་བདེ་བའི་དྭོགས་གཞིའི་རིགས་རྣམས་འོལ་ཚོད་ཀྱིས་བཅོས་ན་དཔེ་དེབ་པར་སྐྲུན་བྱེད་པའི་དགེ་ལས་སྐྱོན་ཚབས་ཆེ་བར་བསམས་ནས་རང་གསོར་བཞག་པ་ཡིན།",
    "རྒྱ་གར་འཕགས་ཡུལ་དུ་བསྟན་བཅོས་ཀྱི་མིང་རང་བཞིན་གྱིས་སྐད་རིགས་ཆེན་པོ་བཞི་ཡོད་པ་ལས།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "དབྱེ་གཞི་འོག་མིན་འགྲོ་ལ་ཕྱེ་བའི་གོང་འཕོ་འཕར་བ་གསུམ་གྱི་མིང་ཅན་རྣམས་དང་།",
    "རྟག་ཆད་ལས་འདས་ཤིང་རང་བཞིན་གྱིས་ཤིན་ཏུ་རྣམ་པར་དག་པ་དང་།",
    "འདིའི་ཞར་བྱུང་རང་ལུགས་ལ།",
    "སྲིད་པའི་ཆུ་ཀླུང་ལས་སྒྲོལ་ཞིང་རང་གཞན་གྱི་དོན་རྟོགས་པའི་རྟེན་གྱི་ངོ་བོ་ཉིད་དང་།",
    "རྒྱལ་བ་ཉི་མ་ཇི་བཞིན་འཕགས་ཏེ་ཞིང་རྣམས་བྱེ་བ་བརྒྱ་དག་ཏུ་ཡང་རབ་ཏུ་གདའ།",
    "མི་དང་རང་བྱུང་སོགས་ཀྱི་དབར་ཡང་དག་པའི་ཚོད་འཛིན་ཞིག་དགོས་སོ།",
    "ཞོ་ལའེ་ནི་དུས་ནམ་ཡིན་ཡང་རང་བྱུང་ཁམས་ཆེན་པོའི་ནང་མི་རང་ཉིད་ཀྱི་གཟུགས་བརྙན་དང་ནུས་པ་འཚོལ་བ་དང་།",
    "དེ་ལྟར་མཚོན་པ་བརྒྱུད་མི་རྣམས་དངོས་པོའི་མདུན་དུ་མིའི་ལ་རྒྱ་དང་རང་གཤིས་མི་འདོར་བར་གསལ་འདེབས་བྱེད་དོ།",
    "ཨོ་ཉིར་གྱིས་མཛད་པའི་སྤྲསྤུ་ཅན་ཞེས་པའི་རྩོམ་གྱི་མི་སྣ་གཙོ་བོ་ཡཱང་ཁི་ཡིས་དངོས་པོའི་དཔལ་ཡོན་གྱི་བཙིར་གནོན་འོག་སྡུག་བསྔལ་ངང་རང་ཉིད་ཁོངས་གང་ལ་གཏོགས་པ་འཚོལ་བའི་དེང་རབས་ཀྱི་མི་ཞིག་མཚོན་ཞིང་།",
    "ཁོ་རང་མདུན་དུ་ཕྱིན་ན་གཞན་བསྒྱུར་གྱི་འདམ་རྫབ་དུ་བྱིང་འགྲོ་ལ།",
    "ཀེ་རི་སེའི་གནའ་རབས་རྩོམ་རིག་དུས་རིམ་གསུམ་དུ་དབྱེ་ཡོད་དེ།",
    "དཔེའི་ཆ་ནས་མི་དང་རང་བྱུང་ཁམས་ཀྱི་འབྲེལ་བ་མཚོན་པ།",
    "ལྷའི་གདུང་རབས་རྙིང་བས་མ་རྒྱུད་ཚོ་ཁག་དུས་སྐབས་ཀྱི་རྣམ་པ་མཚོན་པ་དང་།",
    "དེ་ནི་ཡ་ཐོག་གདོད་མའི་དུས་སུ་འགྲོ་བ་མི་དང་རང་བྱུང་ཁམས་དབར་འཐབ་རྩོད་བྱས་པ་ལ་བསྟོད་གླུ་བླངས་པ་ཞིག་དང་།",
    "ཁོ་རང་ཡུལ་འཁྱར་བྱས་ནས་ལོ་བདུན་ཙམ་འགོར་རྗེས།",
    "དེའི་རྗེས་མི་གཅིག་མི་རྒོད་ཕའོ་ལེ་ཧྥེ་མའོ་སི་ཡིས་ཁོ་རང་མཚོ་ལྷའི་སྲས་ཀྱི་བྲག་ཕུག་ཏུ་བཙོན་འཇུག་བྱས་ཤིང་།",
    "འཐབ་རའི་ནང་རང་ཉིད་ཀྱི་ཕུགས་བསམ་མཚོན་པར་དགའ།",
    "གལ་སྲིད་ཁོ་རང་རང་ཁྱིམ་དུ་ཞི་བདེའི་འཚོ་བ་རོལ་ཏེ་བསྡད་པ་ན་བདེ་སྐྱིད་མངའ་བར་མ་ཟད་ཚེ་ཐག་ཀྱང་རིང་བ་ཡིན།",
    "དེ་ཡང་ཁོ་རང་དམག་ལ་འགྲོ་གྲབས་བྱེད་དུས།",
    "དེ་ལས་ཀྱང་གཙོ་ཆེ་བ་ཞིག་ནི་ཁོ་རང་མེས་རྒྱལ་ལ་དགའ་བ་དང་།",
    "ཁོ་རང་རོ་མཱའི་སྙན་ངག་མཁས་ཅན་ཝེཅིར་ལ་ཤིན་ཏུ་དགའ་བས་རང་ཉིད་ཀྱི་དེད་དཔོན་དུ་རྩིས་འཇོག་བྱེད།",
    "ཏན་ཏིང་ཁོ་རང་ཉིད་ནགས་ཚལ་དུ་མགོ་ནོར་ཐེབས་པས་མི་རྣམས་མགོ་ཐོམ་པ་མཚོན།",
    "ཏན་ཏིང་ཁོ་རང་ཉིད་དམྱལ་ཁམས་ནས་ལྷའི་ཡུལ་ཁམས་སུ་བརྒྱུད་པའི་འགྲོས་རིམ་གྱིས་འགྲོ་བ་མི་རྣམས་རིགས་ཤེས་ཀྱི་སྣེ་ཁྲིད་འོག་དཀའ་སྡུག་མང་པོ་མྱངས་མཐར་ཀུན་སྤྱོད་ཐད་དག་གཙང་དང་།",
    "དེའི་ཕྱིར་ཁོ་ཡིས་སྐྱིད་པའི་འཚོ་བ་དང་རང་ཉིད་ཀྱི་བདེ་སྐྱིད་རྩྭ་བཞིན་དོར་ནས་ལག་རོགས་རྣམས་དང་མཉམ་དུ་རྒྱ་མཚོའི་ནང་ཕྱིན་ཏེ་ཉེན་ཁའི་ལས་ལ་ཕྱོགས།",
    "ལན་དུ་ང་རང་སྐྱོ་ཤས་ཆགས་ཡོད་ཀྱང་སྙན་ངག་ལ་ཉམས་མྱོང་མང་པོ་བླངས་ཡོད་ཅེས་བཤད།",
    "དེ་མིན་འགྲུལ་ཁང་ཐབས་ཆགས་ཨུ་ཁང་བ་གླས་ཏེ་ཁྱིམ་མི་དང་མཉམ་པོར་འདུག་དགོས་བྱུང་།",
    "གསར་རྩོམ་ལ་དཀའ་ལས་བརྒྱབ་དྲག་པས་རྩོམ་འཕྲོ་བཏོན་པའི་ཕྱི་ལོར་ཁོ་རང་ཡང་ཚེ་ལས་འདས།",
    "ཁྱེད་རང་ཞིང་བའི་བུ་ཕྲུག་ཙམ་གྱིས་ངོ་གནོང་མི་དགོས་ལ།",
    "དཀའ་ཁག་མང་པོ་བརྒྱུད་དེ་རིམ་གྱིས་སེམས་རྒྱ་ཡང་ཇེ་ཆེར་ཕྱིན་ནས་བྱ་བ་ཆུང་ཆུང་ལ་སེམས་ཁྲལ་མི་བྱེད་པ་དང་ཐ་ན་སྤྱི་གཉེར་བར་འདུག་པར་ཡང་གལ་ཆེན་དུ་མི་འཇོག་པའི་ཚད་དུ་སླེབས་ལ།",
    "ཡང་ཐང་ཅི་ཁེ་ཏེ་ནི་སྨྲ་བརྗོད་ལ་མཁས་ཤིང་རྒྱུན་པར་ཞལ་གནག་ནས་འདུག་ལ།",
    "འོན་ཀྱང་ཁོ་ནི་རིགས་ཤེས་བོར་བརླག་ཏུ་ཕྱིན་ཞིང་རང་གཤིས་གྱོང་བ།",
    "ཧམ་ལེ་ཀྲི་སྣང་བརྙན་གྱི་ཟབ་ཚད་དང་རྙོག་འཛིང་རང་བཞིན།",
    "གཤིས་ཀའི་སྣ་མང་ཕུན་ཚོགས་དང་རྙོག་འཛིང་རང་བཞིན་ཡང་མཚོན་ནོ།",
    "ཁོ་རང་ལས་ལ་ཤིན་ཏུ་བརྩོན་པས་ཡུན་རིང་ངལ་དུབ་གྱིས་སྙུན་གཞི་ཕོག་སྟེ་མིག་གཉིས་ཡང་ཞར།",
    "སྤྲོ་སྣང་དང་བློ་གཤོག་ཆེ་བའི་སྤོབས་པ་མངོན་འདུག་དུས་རབས་བཅུ་བདུན་པའི་དུས་མཇུག་ཏུ་སླེབས་དུས།",
    "གསར་རྩོམ་ཁྲོད་དུ་ཆབ་སྲིད་ཀྱི་ཕྱོགས་ལྷུང་རང་བཞིན་ཧ་ཅང་གསལ་བོར་མངོན་ཡོད།",
    "སྤྲོ་གར་འདིའི་སྟེང་དུ་གནའ་རབས་རིང་ལུགས་ཟློས་གར་གྱི་ལེགས་པའི་ཆ་འགའ་མངོན་འདུག་སྟེ།",
    "ད་དུང་ཟློས་གར་གྱི་ནང་དོན་ཆེས་ཛ་དྲག་ཏུ་གྱུར་བའི་སྐབས་སུ་ཏར་ཏུ་ཧྥུ་ཡིས་ཨོར་ཀུང་བཟའ་མི་གང་བོ་ཕལ་ཆེར་བརླག་ཚར་བ་ལྟ་བུའི་འབྲས་བུ་དེ་ནི་དེ་བས་ཀྱང་སྐྱོ་བའི་ཟློས་གར་གྱི་ཆར་གྲུབ་འདུག་འོན་ཀྱང་རྩོམ་པ་པོས་སྐྱོ་གར་གྱི་རྣམ་པ་འདི་དག་བསྲེས་ཏེ་སྤྲོ་གར་འདིའི་འགལ་བ་སྔར་ལས་ཚབས་ཆེན་དང་རྣོ་ངར་ཅན་དུ་བཏང་བར་བརྟེན།",
    "བབ་ཆགས་ཤིང་གསོན་ཉམས་དང་ལྡན་པ་ཞིག་ཏུ་འདུག་པས།",
    "གང་ཐུབ་ཅི་ཐུབ་ཀྱིས་ཚིག་རྒྱན་ལ་བཅིབས་པ་ཞིག་ཏུ་འདུག་པ་མ་ཟད།",
    "མངོན་གསལ་དོད་པོའི་བབཀས་བཀོད་རྒྱུད་འཛིན་འགོག་པའི་ཆབ་སྲིད་ཀྱི་ཕྱོགས་ལྷུང་རང་བཞིན་དང་འཐབ་རྩོད་རང་བཞིན་མངའ་ལ།",
    "༡ སྲིད་གླེང་རང་བཞིན་དང་གཏན་ཚིགས་རང་བཞིན།",
    "ཨེན་ཀི་སིས་བརྩམས་སྒྲུང་འདི་འ་རྩོད་སྒྲུབ་རིག་པས་ཁེངས་འདུག་ཅེས་གསུངས།",
    "བློ་མཛངས་སྤྲོ་སྣང་ཅན་གྱི་ཁོ་རང་ནི་སྐུ་དྲག་ལ་རྒོལ་རྡུང་གཏོང་བའི་ཚུལ་མཐུན་དཔྱད་བརྗོད་པ་ཞིག་ཡིན།",
    "རྒྱལ་ཕྲན་ཙམ་གྱིས་རང་རང་སར་སྲིད་བསྐྱངས་སྟབས།",
    "དེས་ན་གཞོན་རྣམས་ཀྱི་ཞེ་འདང་བདེ་སྐྱིད་རྩ་བརླག་བཏང་བའི་ནག་ཉེས་ཀྱང་བགྲང་འདུག་ཅིང་།",
    "ཨེན་ཀི་སིས་དེ་ལ་འཇར་མན་གྱི་ཆབ་སྲིད་ཕྱོགས་ལྷུང་རང་བཞིན་ལྡན་པའི་ཟློས་གར་ཨང་དང་པོ་ཞེས་བསྔགས།",
    "ཞེ་ལེ་སྐུ་གྲོངས་པ་དང་ན་ཕོ་ལོན་གྱི་འཐབ་འཁྲུག་དུས་སྐབས་སུ།",
    "རང་ཉིད་སྐྱེད་པ་དང་རང་ཉིད་སྡོམ་པའི་འགལ་བའི་ཁྲོད་གནས་ཤིང་།",
    "སྐབས་དེར་འདས་ལོག་དུས་ཆེན་གྱི་ཅོང་བརྡ་བརྒྱབ་པ་དེས་ཁང་པའི་ཕྱི་ན་རྒྱལ་ཁམས་ཡོད་པ་གོ་རུ་བཅུག་ཅིང་།",
    "དེར་བརྟེན་མེ་ཧྥེ་སི་ཐིས་ལྡོག་ཕྱོགས་ནས་ཧྥུ་སི་ཐི་མུ་མཐུད་དུ་མདུན་སྐྱོད་བྱེད་པར་སྐུལ་འདེད་བྱས་ཏེ་ཁོ་རང་སྒུལ་ཤུགས་སུ་གྱུར།",
    "བློ་སྤོབས་ཆེན་པོའི་རྟོག་བཟོ་བྱས་པའི་སྣང་བརྙན་དང་མཚར་སྡུག་ཁྱད་མཚར་གྱི་བཀོད་འབྲིས་ཁེངས་འདུག་ཅིང་།",
    "དམངས་གླུའི་སྤྲོ་སྣང་རང་བཞིན་གྱི་གསོན་ཉམས་ལྡན་པའི་འབྲི་ཐབས་སྤྱད་པ་དང་།",
    "གཟུགས་བཞེངས་སྒྱུ་རྩལ་དང་རང་བྱུང་བར་གྱི་འབྲེལ་བ་གླེང་བ་ཞེས་པ་སོགས་གསུང་རྩོམ་དུ།",
    "ཏག་ཏག་འདི་ནང་བཞིན་རང་བྱུང་ཆེན་པོར་བརྩེ་ཞེན་རྣལ་མར་ཡོད་པ་དང་རང་བྱུང་ཁྲོད་ནས་དགའ་སྣང་ཐོབ་པ་མ་ཟད།",
    "གདོད་མའི་དུས་རབས་སུ་མི་དང་རང་བྱུང་ནི་ཧ་ཅང་སྙོམས་པོར་གནས་ཤིང་།",
    "མི་དང་རང་བྱུང་ལ་གནའ་བོའི་དུས་ཀྱི་མཉམ་དུ་འདྲེས་པའི་མཛའ་གཅུགས་འབྲེལ་བ་དེ་མེད་པར་གྱུར་ལ།",
    "མིའི་རིགས་དང་རང་བྱུང་།",
    "ལོར་ཧྥ་རན་སིར་ཉམས་ཆག་བྱུང་སྒང་རང་རྒྱལ་དུ་ལོག་པར་སེམས་ཐག་བཅད།",
    "རན་ཨ་རང་འཚོ་བ་དབུལ་ཡང་རང་གཤིས་བཟང་ཞིང་སྐབས་དེ་དུས་ཚ་བོའི་བཀྲེས་སྐོམ་གྱིས་ཉེས་པ་ཁེལ་ནས་སྡུག་བཙོན་ལོ་ལྔ་ལ་སྐྱེལ་དགོས་བྱུང་།",
    "ཟོལ་མེད་ཀྱི་ངལ་རྩོལ་དང་རང་སྒེར་གྱི་བློ་གྲོས་ལ་བརྟེན་ནས་ལོ་གསུམ་ནང་འབྱོར་བདག་ཅིག་ཏུ་གྱུར།",
    "ཡོ་རོབ་གླིང་ནུབ་མ་ནས་མཆེད་པའི་བློ་འབྱེད་རིང་ལུགས་བསམ་བློ་སོགས་ཀྱིས་ཁོ་རང་ཁེར་རྐྱང་ལས་བསྐྱབས།",
    "སྐུ་དྲག་ན་གཞོན་འདི་དག་དུས་བབ་ཀྱི་རྗེས་སུ་མི་འབྲང་ཞིང་གཡུལ་འཐབ་ལ་མི་ཞུགས་པ།",
    "ཕྱི་རོལ་དོན་དངོས་འབྲི་བའི་དངོས་ཡོད་རིང་ལུགས་དང་རང་སྣང་འཆར་སྒོ་འབྲི་བའི་འཆར་ཡན་རིང་ལུགས་གཉིས་སྒྱུ་རྩལ་གྱི་ཀུན་སློང་ཐད་ལ་ཁྱད་པར་གསལ་བོ་ཡོད།",
    "དེ་ཚོའི་བསམ་བློ་དང་རང་གཤིས།",
    "རང་རང་འགྱོད་ཅིང་བཤགས་པའི་རྗེས་སུ་ཕན་ཚུན་ལ་བཟོད་སྒོམ་དང་རྒྱུས་ལོན།",
    "ལོ་ན་བཅོ་བརྒྱད་ལ་སོན་པ་ལོ་དང་མེ་སྒྱོགས་བཟོ་མཁན་ལོ་ང་རང་ཉེན་རྟོག་པའི་སྤྱིའི་ལྟ་ཞིབ་པ་ཞིག་བྱ་འདོད་ཡོད་ལོ་སོགས་ནི་གྲགས་རྩོམ་ཡིན་ཨན་ཁེ་སིས་ཝེར་ཐི་ལ་འཇར་མན་འབྱོར་མེད་གྲལ་རིམ་གྱི་སྙན་ངག་པ་ཐོག་མ་དང་གཙོ་བོ་ཡིན་ཞེས་བསྔགས།",
    "རྗེསསོར་ཁོ་རང་གསོད་རར་ཁྲིད།",
    "གྲགས་རྩོམ་ལ་འཇིགས་སྐྲག་དུས་རབས་ཀྱི་དོན་དག་ཅིག་ཅེས་པ་ཡོད།",
    "འདི་ནི་ཁོས་ཐོག་དང་པོར་མྱངས་པའི་ཕྱོགས་ལྷུང་རང་ཕན་རིང་ལུགས་ཀྱི་མི་ཚེའི་མཚན་ཉིད་རིག་པའི་སློབ་ཐུན་ཞིག་ཡིན།",
    "ཁོ་རང་ཧམ་སེམས་ཀྱི་ལམ་དུ་གོམ་སྟབས་ཆེན་པོར་བསྐྱོད།",
    "ཁོ་རང་ཉིད་ཀྱང་རང་ཕན་རིང་ལུགས་དང་དངུལ་དད་རིང་ལུགས་ཀྱི་འཆི་རྫས་སུ་བཏང་།",
    "ཁོའི་བསམ་བློའི་ངོ་བོ་ནི་ཕྱོགས་ལྷུང་རང་ཕན་རིང་ལུགས་ཡིན།",
    "སེམས་གཤིས་བཟང་ཞིང་རང་བཀུར་གྱི་སེམས་ཆེ་བས་མིའི་བསླུ་བྲིད་ཐེབས་སླ་བ་དང་།",
    "མི་དང་རང་ཉིད་བཅས་ལུས་སེམས་འགལ་བ་མང་པོའི་རྙོག་གསེབ་ཏུ་བྱིང་།",
    "རྒུད་པས་ཁེངས་འདུག་པས་སོ།",
    "སྔ་མས་དཔྱོད་ཤེས་སྒྲིག་སྲོལ་ཁོ་ནར་བརྟེན་ནས་འཚོ་བ་དང་དེས་ཁོ་རང་གནས་འདི་འདྲ་ཞིག་ལ་ཁྲིད་དེ་སླེབས་པ་དང་།",
    "དེར་མཐུད་དེ་ཁོ་རང་ཉེས་གསོག་གནས་ཡུལ་དུ་ཁྲིད།",
    "མིའི་རིགས་ཀྱི་ཆེད་དུ་སྡུག་མྱངས་ཤིང་རང་སྲོག་བློས་གཏོང་ཕོད།",
    "ཉེས་པ་བསགས་པ་ཡིན་ཡང་རང་སྲོག་བློས་གཏོང་བྱེད་ཀྱིན་ཡོད།",
    "བུའི་མི་སྣ་གཙོ་བོ་ཉེ་ཧོ་ལིའུ་ཏོ་ཧྥུའི་བསམ་བློ་དང་རང་གཤིས་ཀྱི་འཕེལ་རྒྱས་དེ་དུས་རིམ་གསུམ་ལ་བརྒྱུད་ཡོད་པ་སྟེ།",
    "དེ་ནི་སྲོག་ཆགས་རང་བཞིན་གྱི་མིས་བསམ་ཤེས་རང་རང་བཞིན་གྱི་མི་རྣམ་པར་གནོན་པའི་དུས་རིམ་ཞིག་ཡིན།",
    "ཀུན་སྤྱོད་རང་རང་ལེགས་བཅོས་གཏོང་བའི་བརྒྱུད་རིམ་ཞིག་ཡིན།",
    "ད་དུང་རང་འགུལ་མིན་པའི་ཐོག་ནས་དེ་དག་ལ་ཁས་ལེན་ཐོབ་ནས་དོན་ངོ་མར་ཞེ་ལོག་ཅིང་སྐྲག་དགོས་པའི་བྱ་དངོས་དག་རྒྱུན་གཏན་གྱི་སྤྱོད་ཚུལ་དུ་ངོས་འཛིན་བྱེད།",
    "མི་ཡུལ་ཐོག་ཏུ་འཚོ་གནས་སྐབས་གལ་ཆེ་ཤོས་ནི་ཟམ་མི་ཆད་པར་ཀུན་སྤྱོད་རང་རང་ལེགས་བཅོས་གཏོང་རྒྱུ་དང་།",
    "བརྩམས་སྒྲུང་ནང་ཨན་ཎའི་སེམས་ཁམས་ཀྱི་བརྒྱུད་རིམ་དེ་བརྩེ་དུང་དང་སེམས་ཁམས་འགལ་འདུའི་སྣེ་མང་རང་བཞིན་ཅན་དང་།",
    "རྙོག་འཛིང་རང་བཞིན་མངོན་རྒྱུ་གཙོ་བོར་བྱས་ནས་བཀོད་འབྲི་བྱས་ཡོད་པ་སྟེ།",
    "ཁོ་རང་ཉིད་ཀྱང་གྲང་ངར་ཁྲོད་འཁྱགས་སྦོས་སུ་ཤོར་བའི་ཡན་ལག་གཅོད་བྲེག་བྱེད་དགོས་པར་ཐུག་ཆི་ཁེ་ཧྥུས་ཡིད་འགྱུར་མཚོན་པའི་རྩོམ་རྩལ་སྤྱད་ནས་མི་དཀྱུས་མའི་སེམས་ཁམས་ཀྱི་སྐྱོ་ཤས་བྲིས་ཡོད།",
    "མིའི་གྲོགས་མེད་ཁེར་རྐྱང་རང་བཞིན་དང་།",
    "ཆི་ཁེ་ཧྥུས་ད་དུང་རང་ཉིད་ཀྱི་བསམ་པའི་བརྩེ་དུང་དེ་ཡུལ་ལྗོངས་བཀོད་འབྲིའི་ནང་བླུགས་འདྲེན་གང་ཐུབ་བྱེད་པ་སྟེ།",
    "སྙན་ངག་ཀྱང་སྦྱོང་འགོ་བརྩམས་ནས་སྐྱོ་སྣང་རང་བཞིན་མཚོན་པའི་སྙན་ངག་མི་ཉུང་བ་ཞིག་བརྩམས།",
    "ལོ་བརྒྱད་རིང་རང་ཉིད་ཆ་རྒྱུས་མེད་པའི་མི་ཞིག་དང་མཉམ་དུ་འཚོ་བ་བསྐྱལ་བ།",
    "ཁོ་རང་ཉིད་དེའི་བདག་པོ་ཞིག་ཏུ་བལྟ་ཞིང་།",
    "ལོ་མང་རིང་རང་གཤིས་ངོ་མ་འགེབས་བྱེད་ཀྱི་རྫུན་འབག་ཡོངས་སུ་བརྟོལ་བ་དེས།",
    "མི་བྱེ་བྲག་པར་དམིགས་བསལ་རང་བཞིན་དང་རང་གཤིས་ལྡན་ཡོད་པས།",
    "དངོས་ཡོད་རིང་ལུགས་དང་རང་བྱུང་རིང་ལུགས་རྩོད་ལེན་མི་བྱེད་པར།",
    "ག་དུས་ཡིན་ཡང་བྲག་ཕུག་རྡིབ་ནས་ལུས་སྲོག་ཤོར་ཉེན་ཆེ་ཚུལ་གསལ་སྟོན་བྱས་ཡོད།",
    "ནོར་འཁྲུལ་ཅན་གྱི་བསམ་པའི་རླབས་རྒྱུན་བཀག་འགོག་བྱེད་པར་དཔའ་ངར་ཞུམ་མེད་དང་རང་སྲོག་ཤོར་བར་མི་སྐྲག་པ་དེས་བཟོ་པའི་གོ་རྟོགས་སད་རྒྱུཪ་བློ་སྒོ་འབྱེད་དེ་བཟོ་པའི་ལས་འགུལ་ལ་སྐུལ་འདེད་གཏོང་བར་ཡར་ཐོན་གྱི་ནུས་པ་ཐོན་ཡོད།",
    "སྔར་ནས་བཟུང་རང་བྱུང་རིང་ལུགས་དང་དངོས་ཡོད་རིང་ལུགས་ཀྱི་འབྲེལ་བ་ཅུང་དམ་པོ་ཡོད་པས་སོ།",
    "ཅེས་གསུངས་འདུག་མ་གཞི་རྩོམ་པ་པོའི་ངོ་ལོག་འགོག་རྒོལ་གྱི་མི་ཚེ་གང་པོ་སྐྱོ་གར་ཐོག་ནས་མཇུག་འགྲིལ་ཡོད་རུང་།",
    "པོ་ཏེ་ལེར་གྱི་གྲགས་ཅན་སྙན་ཚིག་སེམས་ཚོར་ཞེས་པའི་ནང་རང་བྱུང་ཁམས་ནི་ལྷ་ཁང་ཞིག་ཡིན་ལ་དེར་གསོན་པོར་གནས་ཐུབ་པའི་ཀབ་ཡོད།",
    "མི་རྣམས་ལ་འཕྲིན་བརྡ་སྤེལ་བར་བྱེད་པས་མི་དང་རང་བྱུང་ཁམས་དང་།",
    "མཐོང་ཐོས་རྒྱ་ཆེ་ཞིང་རང་ཉིད་ཀྱི་ལྟ་བ་སྨིན་གྲུབ་བྱུང་བ་འབའ་ཞིག་ཡིན།",
    "སུའུ་ལེན་དང་ཨུ་རུ་སུའི་རྩོམ་རིག་དུས་སྐབས་སུ་སླེབས་ཡོད།",
    "ཞེས་པའི་ནང་རང་ཉིད་ཀྱི་མི་སྣ་གཙོ་བོ་བཞི་པོ་སྟེ།",
    "ཕན་ནོ་ཝའི་ལོ་གཅིག་དུས་བཞི་དང་།",
    "མི་རབས་བཞི་པའི་རྩོམ་པ་པོའི་གཞོན་ནུའི་ངོས་ལེན་བརྩམས་སྒྲུང་ཞེས་པར་ཡང་ལོ་ཆུང་གཞོན་ནུར་ཆེད་དུ་ལྡན་པའི་ཁ་རི་ཁ་ཐུག་དང་རང་སྣང་གང་ཤར།",
    "ཁོ་ཚོའི་འགོག་རྒོལ་དེ་ཡང་རང་འཕེལ་དང་།",
    "ཁོའི་ལུས་ཐོག་ཏུ་གནས་པའི་མཁྲེགས་བཟུང་དང་རྗེས་ལུས་ཀྱིས་ཏག་ཏག་ཨུ་རུ་སུའི་འབྱོར་ལྡན་གྲལ་རིམ་གྱི་མཁྲེགས་བཟུང་རང་བཞིན་དང་རྗེས་ལུས་ཀྱི་རང་བཞིན་གསལ་སྟོན་བྱས་ཡོད།",
    "ཁོ་རང་འཚོ་བའི་ཁྲོད་གནས་མུས་སུ་གྱུར་བའི་འགལ་བ་སྣ་མང་ལ་མི་གཡོལ་ལ།",
    "བརྩེ་སེམས་ཀྱི་དྲི་དང་བྲལ་ལ་ག་དུས་ཡིན་ཡང་གདུག་རྩུབ་ཆེན་པོས་མི་གཞན་གྱི་སེམས་ཁམས་རྡོག་རོལ་དུ་གཏོང་།",
    "རྒན་པོ་ཁོ་རང་མཇུག་མཐར་བླ་འཁྱམ་ཧོན་འཐོར་གྱི་ཚུལ་དུ་གནས།",
    "ཁོ་རང་ཉིད་ཀྱི་དད་སེམས་དང་བསམ་པའི་རྒྱགས་ཕྱེ་ཤོར་ཟིན་པས་ལྷག་འཕྲོར་ལུས་པ་ནི་ལུས་ཕུང་འབའ་ཞིག་པ་མ་ཟད།",
    "ངན་པས་བཟང་པོ་བཅོམ་ཞིང་མིའི་རིགས་དང་རང་བྱུང་ཡང་བརླག་པས།",
    "འཛམ་གླིང་ནུབ་ཕྱོགས་གང་སར་ཡུན་རིང་རང་ཐར་མི་ཐུབ་པའི་བསམ་པའི་འཇིགས་ཉེན་ཐོན།",
    "དབུལ་ཕྱུག་དོ་སྙོམས་ནི་མཐར་གཏུགས་ཀྱི་དམིགས་འབེན་དུ་བྱས་པར་བརྟེན་ངོ་བོའི་ཐོག་དུས་རབས་བཅུ་དགུ་པའི་སྲོལ་རྒྱུན་རྒྱུན་འཛིན་བྱས་པས་མཐོ་ཚད་གསར་པ་ཞིག་ཏུ་སླེབས་ཐུབ་མེད།",
    "མི་སྣ་འབྲི་བཞེངས་སྐབས་གཤིས་ཀའི་སྣེ་མང་རང་བཞིན་ནན་བཟུང་བྱེད་པ།",
    "འོན་ཀྱང་དེས་འཁྲུལ་སྣང་དང་མགོ་འཐོམ་གྱི་གནས་སུ་ལྷུང་པས་ཡུན་རིང་རང་དམའ་རང་འབེབས་སུ་གྱུར།",
    "ཕུལ་དུ་བྱུང་བའི་སེམས་ཁམས་བཀོད་འབྲི་དང་རང་བྱུང་མཛེས་ངས་བཀོད་འབྲི།",
    "དེའང་དང་ཐོག་ཁོང་རང་ཉིད་མགོ་འཐོམ་པའི་མི་ཞིག་མིན།",
    "འོན་ཀྱང་ཧའེ་མིང་ཝེཡིས་གནའ་བོའི་གཏམ་རྒྱུད་དེའི་ནང་རང་ཉིད་ཀྱི་ཡིད་ཆེས་ལྟ་བ་བཅུག་ཡོད།",
    "མན་ནོ་ལིན་དེ་ཚོས་ང་དངོས་གནས་ཕམ་ཉེས་བཏང་བྱུང་ཕྲུ་གུས་དེས་ཁྱེད་རང་ཕམཕམ་ཉེས་བཏང་མེད།",
    "ཁྱེད་རང་འཚོལ་མཁན་ཆུ་ཐོག་ཉེན་རྟོག་པ་འདུག་ད་དུང་གནམ་གྲུ་འདུག་རྒས་པོས་རྒྱ་མཚོ་ཚེལ་གྲུ་ཆུང་བས།",
    "འོན་ཀྱང་རང་གཤིས་ཀྱི་རང་བཙན་དང་ལྟོས་མེད་ཀྱི་བློ་འདུན་བར་གྱི་འགལ་བ་ནམ་ཡང་ཐག་ཆོད་ཐབས་མེད་པས།",
    "གཅིག་ནི་མི་དང་རང་བྱུང་ཁམས་ཡིན།",
    "ཡིད་བརྙན་ངོ་མཚར་ལ་ཚིག་སྦྱོར་བདེ་ཞིང་རང་བྱུང་དུ་ཐོན་པར་སྣང་།",
    "མངོན་མཚོན་རིང་ལུགས་དར་ཁྱབ་བྱུང་བ་ནི་ཕྱི་རོལ་ཡུལ་གྱི་བདེན་དངོས་བཀོད་འབྲི་བྱེད་རྒྱུ་གཙོ་བོར་འཛིན་པའི་དངོས་ཡོད་རིང་ལུགས་དང་རང་བྱུང་རིང་ལུགས་ལ་ངོ་ལོག་བྱས་པ་ཡིན།",
    "མི་དང་རང་ཁོངས་མིན་པའི་སྟོབས་ཤུགས་ཀྱི་འགོག་རྒོལ་གྱི་ཚབ་བྱས།",
    "ཡང་རང་བྱུང་རིང་ལུགས་ནས་མངོན་མཚོན་རིང་ལུགས་དང་མཚོན་རྟགས་རིང་ལུགས་སུབསྐྱོད་པ་ཡིན།",
    "མ་ལི་ཎའེ་ཡི་འཁྲབ་གཞུང་ཁོ་ཚོ་སླེབས་བྱུང་ཞེས་པའི་ནང་རང་ཉིད་ཀྱི་རིགས་པའི་གཞུང་ལུགས་ཀྱི་ལྟ་བ་ར་སྤྲོད་བྱས་ཡོད།",
    "འདས་པའི་ནམ་ཟླ་སྒྲོན་སྟེགས་བཅས་ཕྱོགས་གསུམ་གྱིས་རྩོམ་པ་པོའི་ཕ་མ་གཉིས་ཀྱི་སྣང་བརྙན་དང་རང་ཉིད་བྱིས་པའི་དུས་ཀྱི་འཚོ་བའི་སྣང་ཚུལ་བསྐྱར་མཚོན་བྱས་ཡོད།",
    "དོན་མང་རང་བཞིན་ལས་མངོན་མཚོན་བྱས་ཤིང་།",
    "དུས་རབས་ཉི་ཤུ་པའི་དེང་རངརབས་རིང་ལུགས་ཀྱི་རྩོམ་རིགསྲིད་སྙན་ངག་ཅིག་རྩོམ་པ་པོ་རང་ངོས་ཀྱིས་ཤེས་ཚོར་ཐུབ་པའི་ཁྱབ་ཁོངས་ལས་འདས་པའི་གོ་བ་ལས་རྒྱ་ཆེར་བརྒལ་སྲིད་ཅེས་གསུངས།",
    "ཁོའི་རྩུབ་ཅིང་རང་ཤེད་ཚ་བའི་གཤིས་ཀ་གྲུབ།",
    "ཡང་རང་ཉིད་ཀྱི་ཁྱིམ་ཚང་ནང་།",
    "དེའི་སྟེང་རང་ཉིད་ཀྱི་ཆགས་སྤྱོད་ནུས་པ་ཉམས་ལ།",
    "ཕྱི་རོལ་ཡུལ་གྱི་འཇིག་རྟེན་དང་རང་སྣང་ཡུལ་ཅན་གྱི་འཇིག་རྟེན།",
    "འོན་ཀྱང་རང་ཉིད་ལ་གྲོགས་མེད་ཅིང་ཤུགས་ཞན་པས་བྱ་ཐབས་ཟད།",
    "གཡོན་ཕྱོགས་པར་ཁ་གཡར་ས་ཞིག་དང་གཡས་ཕྱོགས་པས་བློ་རུ་མི་གཤོང་བ་ནི་ལོས་ཡིན།",
    "ཁོ་རང་འགུལ་མིན་པའི་ངང་གླུད་རྫས་སུ་གྱུར་ཏེ་ཆབ་སྲིད་འཐབ་རྩོད་ཀྱི་མཆོད་ཁྲིར་སྐྱེལ།",
    "ཡུ་གོ་ནི་ཟློས་གར་ནང་ཧ་ལམ་ག་དུས་ཡིན་ཡང་ངེས་པར་དུ་གདམ་ག་བྱེད་དགོས་པའི་ཡུལ་དུས་ནང་གནས།",
    "ལྐོག་གསོད་དང་རང་ཤི་ལས་ཁོས་རང་ཤི་བདམས།",
    "གཉིས་ནས་དགའ་དགའ་ག་དུས་ཡོང་མིན་ཡང་མི་རྟོགས་པར་དཀའ་ཐུབ་ཀྱིས་སྒུག་རྒྱུ་ཙམ་དུ་ཟད།",
    "ག་དུས་ཡིན་ཡང་སྨྲ་བརྗོད་དཀའ་བའི་ལྐོག་གཡོ་དང་སྐྱུག་བྲོ་བའི་སྣང་ཚུལ་གྱིས་ཁེངས་ཤིང་།",
    "ཁོ་རང་ཆུང་ལེའུ་བཅུ་གཉིས་པ།",
    "ཁོས་ཤིན་ཏི་ཅ་ཀུང་སིར་བཀོད་པ་བཏང་ནས་དགྲ་དང་རང་ཕྱོགས་ཀྱི་དབྱེ་བ་མ་ཕྱེ་བར་མ་རྐང་འཇོག་ཆོག་པ་བྱས།",
    "འཛམ་གླིང་རང་བཞིན་གྱི་མཚན་སྙན་ཡང་ཐོབ་ཡོད།",
    "གཞི་རྒྱ་ཆེ་བའི་ཁྲག་སྦྱོར་གྱི་གདོང་ཐུག་དུས་ཡུན་རིང་བ།",
    "ཁོས་ཡུན་རིང་རང་བཞིན་གྱི་སྤ་སེ་ཞིག་ཉོས་ནས།",
    "ཡོ་རོབ་དང་རང་རྒྱལ་གྱི་ཐོག་མའི་བརྩམས་སྒྲུང་ལས་ལོ་ངོ་སུམ་བརྒྱ་བཞི་བརྒྱས་སྔ་ཞིང་།",
    "བརྩམས་སྒྲུང་དུ་མི་དང་རང་བྱུང་དང་།",
    "ཨ་ལི་པ་པ་དང་ཇག་པ་བཞི་བཅུའི་སྒྲུང་དུ་ཨ་ལི་པ་པ་ལ་རིན་ཆེན་གྱི་ནོར་བུ་ཕོན་ཆེན་པོ་ཐོབ་ནའང་རངརང་གཅིག་པུས་སྒེར་བདག་མ་བྱས་པ་དང་།",
    "དེ་ཡང་ཕྱོགས་གཅིག་ནས་ཁོ་པ་ནི་མི་ཕལ་པ་བྱེད་པར་མི་འདོད་ཅིང་རང་བརྩིའི་སྤོབསསེམས་ཆེ་ལ།",
    "མཐའ་མཇུག་སྒྲུང་ཆུང་རང་ཚུགས་ཐུབ་པ་ཡོད་ལ།",
    "མི་རིགས་ཀྱི་སྤོབས་སེམས་དང་རང་ཞེན་འཕེལ་ཐུབ་པ་བྱུང་།",
    "ལོ་ན་བཅུ་དྲུག་དུས་ཀྱི་ཉིན་ཐོ་ཡབ་ཡུམ་ལ་བསྲིངས་པའི་ཡི་གེ་སོགས་བཀོད་འབྲི་ཞིབ་ཚགས་དང་།",
    "གསར་རྩོམ་གྱི་བསམ་བློའི་ཕྱོགས་ལྷུང་རང་བཞིན་ཅུང་རྙོག་འཛིང་ངདུ་ཁ་ཕྱོགས།",
    "རྡོ་ཚོན་དང་ཐེངས་ཐོག་མར་ཐུག་དུས་ཁོ་པར་སེམས་པ་ཤོར་བ་དང་།",
    "ཁྱིམ་དུ་སྐྱེས་པའི་མིང་འཛིན་པ་ཁོ་རང་གཅིག་པུར་ཟད།",
    "རྒྱུན་གྱི་ཆོ་ག་དུས་གསུམ་དུ།",
    "ངང་དང་རང་བཞིན་འདུ་འབྲལ་མེད་པ་ནི།",
    "བ་སྤུའི་བུ་ག་ཐམས་ཅད་ནས་འོད་ཟེར་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་དྲུག་ཅུ་དྲུག་ཅུ་དང་རང་བཞིན་གྱི་འོད་སྤྲོ་བ་དང་།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "འདི་ནི་སྐྱེ་བ་མེད་པ་ལ་སོགས་པ་དང་རང་བཞིན་གཅིག་ཉིད་ཡིན་ནོ།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའི་ཚེ།",
    "ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས།",
    "འདུག་ཀྱང་རུང་སྟེ་ཞེས་བྱ་བ་ནི་གཡུལ་དུ་འདུག་སྟེ།",
    "མི་མཐུན་པའི་ཕྱོགས་ཆུང་ངུའི་ཆུང་ངུ་ལ་གཉེན་པོའི་ཕྱོགས་ཆེན་པོའི་ཆེན་པོ་དང་ཡང་དག་པར་ལྡན་པས་གཡུལ་དུ་ལེགས་པར་འདུག་པའོ།",
    "དེར་འདུག་པ་ནི་དེའི་མཐའ་ལ་བརྟེན་པའོ།",
    "ལྷག་པའི་བསམ་པས་མཉན་པར་བྱ་ཞེས་བྱ་བ་ནི་ཐོད་པ་ལ་སོགས་པ་བོར་ལ་སྟན་དམའ་བ་ལ་འདུག་སྟེ།",
    "ག་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་ཡུལ་མ་ག་དྷཱ་ལ་སོགས་པ་གང་ན་གནས་པའོ།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་དང་རང་བཞིན་དབེན་པས་ན་ཞེས་བྱ་བ་ནི།",
    "གོ་རིམས་བཞིན་དུ་ངོ་བོ་ཉིད་མེད་པ་དང་མ་སྐྱེས་པ་དང་མ་འགགས་པ་དང་གཟོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་འདས་པའི་མཚན་ཉིད་ནི་སྤྱིར་ཤེས་བྱའི་སྒྲིབ་པའི་གཉེན་པོར་གྱུར་པ་དག་ཡིན་ཏེ།",
    "དེ་ནས་རིམ་པ་བཞིན་དུ་བྱས་ལ་འདུག་སྟེ།",
    "དེ་ཡང་རང་བཞིན་གཅིག་ཡིན་ན་དུ་མའི་རང་བཞིན་གྱིས་མ་ཁྱབ་པས་དུ་མའི་རང་བཞིན་ཉིད་ལ་སོགས་པར་སྣང་བར་མི་འཐད་དེ་བརྒལ་ཞིང་བརྟག་པ་མཚུངས་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "སྟན་གཅིག་ལ་འདུག་ནས་ཇི་ལྟར་དགའ་བར་ཡོངས་སུ་ལོངས་སྤྱོད་པས་ན་སྟན་གཅིག་པའོ།",
    "དེ་བཞིན་དུ་ཡིད་བདེ་བ་རྣམ་པ་གསུམ་སྐྱེས་པས་རབ་ཏུ་དགའ་བ་དང་རངས་པ་དང་ཡིད་བདེ་བ་སྐྱེས་ཏེ་ཞེས་བྱ་བའོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་ཞིག་ནས་འདུག་གོ།",
    "པེ་སྣར་འདུག་༡༢༤པེ་སྣར་བས།",
    "དངོས་པོར་སྨྲ་བ་རྣམས་ཀྱིས་ཀྱང་རང་རང་འདོད་པའི་དོན་དམ་བདེན་པ་དེ་དག་བདེན་མེད་དུ་རྟོགས་པར་འགྱུར་ཏེ།",
    "ཡུལ་དུས་གྲུབ་པའི་མཐའ་གང་ན་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་ནམ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འཇིག་རྟེན་པའི་རྟོག་པ་ལྷན་སྐྱེས་ཀྱིས་གཞན་སྐྱེ་ཁས་བླངས་ཀྱང་རང་ལུགས་ཀྱི་ཀུན་རྫོབ་བདེན་པ་ལ་རིགས་པས་དཔྱད་པའི་ཉེས་པ་མེད་པ།",
    "དེའི་ཤེས་བྱེད་ཀྱང་རང་བཞིན་གྱི་སྐྱེ་བ་བཀག་ཤུལ་དུ།",
    "བདེན་མེད་དེ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་པར་སྒྲུབ་བྱེད་ཀྱི་རིགས་པ་ཕྱི་མ་དེས་ཀྱང་།",
    "དེ་ཉིད་མ་མཐོང་རང་དགར་གྱུར་པ་༢༢",
    "གཡོ་དང་རང་བཞིན་སྟོང་པར་མཐོང་བ་ཡི།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་ལ།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པའི།",
    "རྣམ་སྨིན་ཕྱུང་ཟིན་པ་དང་མ་ཟིན་པའི་ལས་དག་ཀྱང་མ་འགགས་ཤིང་རང་བཞིན་མེད་པར་མཚུངས་ཀྱང་སྔར་འབྲས་བུ་བྱུང་མ་ཟིན་པའི་ལས་ཀྱི་སླར་ཡང་རྣམ་སྨིན་འབྱིན་ལ།",
    "དེ་དག་ཀྱང་རང་ལུགས་ཀྱི་ཕྱོགས་གང་ཡང་མ་འཆའ་བར་མི་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་ཀུན་རྫོབ་ཏུ་ཡོད་པར་ཁས་བླངས་པ་ནའང་རང་བཞིན་ཅུང་ཟད་ཀྱང་ཁས་མ་བླངས་པའི་ཕྱིར།",
    "གཞན་ཡང་རང་༢༢༧",
    "དེ་སྐད་སྨྲ་ཞིང་རང་ཕྱོགས་ཁོ་ན་རྣམ་འཇོམས་པ།",
    "གལ་ཏེ་དེ་དག་ལའང་རང་བཞིན་ཅུང་ཞིག་ཡོད་ན་མི་འཇིག་པ་ཐེར་ཟུག་ཏུ་གནས་པའམ།",
    "དེ་ཏིང་ངེ་འཛིན་དེ་ཐོབ་མ་ཐག་ཏུ་པདྨ་དེ་ལ་འདུག་པར་ཀུན་ཏུ་སྣང་ངོ།",
    "དེ་དེ་ལ་འདུག་པ་དང་།",
    "ཇི་ལྟར་ཉིད་ཀྱི་སྤྱོད་པ་དང་དེ་བཞིན་གཤེགས་པ་གཞན་གྱི་སྤྱོད་པ་དག་དུས་གཅིག་ཏུ་རང་ཉིད་ཀྱི་བ་སྤུའི་ཁུང་བུར་སྟོན་༣༣༦",
    "ཞེས་ཝི་ཀ་ཙ་ན་ཀ།",
    "སྦྲང་རྩི་མ་དྷུ་སྤུ་ད་ནའཇོམས་དང་རང་བྱུང་ངོ།",
    "དགྱེས་འདུག་སྙམ་ནས་ལོག་ལྟ་སྐྱེ་བའམ།"
