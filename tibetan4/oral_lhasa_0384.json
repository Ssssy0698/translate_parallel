    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བརྒྱ་བྱིན་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སོགས་པའི་སྒྲས་ནི་གདུལ་བྱ་རྣམས་བསམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཅིག་ཅར་ལུས་སྟོན་པར་མཛད་པ་དང་།",
    "དེའི་འོག་ཏུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡོན་ཏན་ཅུང་ཟད་ཙམ་ཞིག་བརྗོད་པར་འདོད་པ་ཞེས་བྱ་བ་ནི་ཡོན་ཏན་འགའ་ཞིག་སྟོན་པར་འདོད་པ་སྟེ།",
    "ཡོན་ཏན་མ་ལུས་པར་བརྗོད་པར་མི་ནུས་པས་སོ།",
    "རྟོགས་པ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པའི་སྒོ་ནས་བསྟོད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་ལྟར་ནམ་མཁའ་དྲི་མ་མེད་པ་ལ་ཚེས་བཅོ་ལྔའི་ཟླ་བས་སྣང་བ་གསལ་བས་མུན་པ་སེལ་བའི་སྒོ་ནས་འགྲོ་བ་མ་ལུས་པར་གསལ་བར་ནུས་པ་དེ་བཞིན་དུ་སེམས་བཅུ་པ་བསྐྱེད་པའི་ཚེ་སྟོབས་བཅུ་བསྐྱེད་པ་སྟེ།",
    "བརྩོན་འགྲུས་བརྩམས་པར་འགྱུར་བའོ།",
    "རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ལས་འདས་པས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དཔེར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་རྟོག་པའི་བག་ཆགས་ཀྱི་མཚན་ཉིད་ཅན་ཡིན་ལ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཞེས་བྱ་བ་ནི་ཤིན་ཏུ་རྣམ་པར་དག་པའི་དེ་ཁོ་ན་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་མཚན་ཉིད་ཅན་ནོ།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་དེ་ཁོ་ན་སྟེ་སྟོང་པ་ཉིད་ཀྱི་མཚན་ཉིད་ཅན་ལ་དངོས་བྱས་ཏེ།",
    "རོ་མཉམ་ཉིད་དུ་ཡང་དག་ཐུགས་སུ་ཆུད་པར་མཛད་གྱུར་ན།",
    "རྣམ་འགྱུར་མེད་པ་ཉིད་ཀྱིས་དེ་ཁོ་ན་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་རོ་མཉམ་པ་ཉིད་དུ་མཁྱེན་པས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དཔེར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བུམ་པ་དང་གཞོང་པ་ལ་སོགས་པར་རྟོགས་པའོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
