    "སེམས་ཀྱི་སྐད་ཅིག་གཅིག་ལ་བརྗོད་དུ་མྱེད་པའི་བསྐལ་པ་ཡང་དག་པར་བསྟན་པ་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དང་།",
    "གྲངས་མྱེད་པའི་བསྐལ་པ་ལ་ཡང་དག་པར་འཇུག་པ་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དང་།",
    "བསྐལ་པ་གཅིག་གྲངས་མྱེད་པའི་བསྐལ་པར་ཡང་དག་པར་འཇུག་པ་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དང་།",
    "བསྐལ་པ་རིང་པོ་བསྐལ་པ་ཐུང་ངུར་ཡང་དག་པར་འཇུག་པ་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དང་།",
    "བསྐལ་པ་ཐུང་ངུ་བསྐལ་པ་རིང་པོར་ཡང་དག་པར་འཇུག་པ་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དང་།",
    "བསྐལ་པ་ཐམས་ཅད་མ་ལུས་པར་བསྐལ་པ་མ་ཡིན་པར་ཤིན་ཏུ་བརྟག་པ་ཤེས་པ་ཤིན་ཏུ་ཕྲ་བ་དང་།",
    "རྟོག་པ་དང་རྣམ་པར་རྟོག་པའི་སྤྲོས་པ་ཐམས་ཅད་རབ་ཏུ་བསྩལ་བའི་སེམས་དང་ལྡན་པ།",
    "ཚིག་རྣམ་པར་དགོད་ཅིང་ཤིན་ཏུ་བསྟན་པ་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དུ་གྲགས་པ་དང་།",
    "ཁོང་དུ་ཆུད་པར་གྱུར་ཅིག།",
    "དེ་ཡང་བདག་གམ་གཞན་ལ་རྣམ་པར་མི་རྟོག་པ་དང་།",
    "དེ་ཡང་དངོས་པོ་དང་དམྱིགས་པ་ལ་རྣམ་པར་མྱི་རྟོག་པ་དང་།",
    "ཆགས་པ་མྱེད་པ་དང་གྲོལ་ཞིང་བཅིངས་པ་མྱེད་པའི་རྣམ་པར་སྨིན་པ་དང་།",
    "གནས་ཐམས་ཅད་ཡང་དག་པར་བཅོམ་པ་ཡང་རབ་ཏུ་འཐོབ་པ་ཡིན།",
    "དེ་དག་ཟིལ་གྱིས་མྱི་ནོན་འགྱུར་བྱས་ཤིང་།",
    "ལས་རྣམས་ཅི་འདྲར་ཡོངས་སུ་བསགས་བྱས་པ།",
    "དེ་དག་ཀུན་ལ་བརྙས་པར་ཡོང་མྱི་བྱེད།",
    "དེ་དག་སེམས་ལ་མཐོ་བ་མྱེད་བྱས་ཤིང་།",
    "ཡིད་ལ་དམའ་བའང་འཆང་བ་མྱེད་བྱས་ཏེ།",
    "ཇི་སྙེད་འཇིག་རྟེན་ཡངས་པར་འགྲོ་བ་ཡི།",
    "དེ་དག་ཤེས་བྱས་སྤྱད་པ་སྤྱོད་པའི་ཚེ།",
    "སྒྲའི་སྦུབས་སུ་ཀུན་ཀྱང་བསྡུ་བྱས་ཏེ།",
    "དེ་དག་སེམས་སུ་ཡང་དག་བསྡུ་བྱས་ཏེ།",
    "ཡེ་ཤེས་སྒོ་ནས་དེ་དག་ཤེས་བྱས་ནས།",
    "སྤྱོད་ལམ་ལྡོག་པ་མྱེད་པར་སྤྱད་པར་བྱ།",
    "ཐམས་ཅད་ཡེ་ཤེས་སྒོ་ནས་ཤེས་བྱས་ཏེ།",
    "དུས་རྣམས་སྣྲེལ་ཞིར་དུས་གསུམ་གཟུང་བྱས་ཤིང་།",
    "སུ་བཞུགས་དེ་དག་རྣམ་པར་འཕྲུལ་མཛད་པ།",
    "དགའ་ལྡན་གནས་ན་རང་བྱུང་གང་བཞུགས་པ།",
    "རྣམ་པར་འཕྲུལ་པ་ཇི་སྙེད་མཛད་པ་དང་།",
    "མི་ཡི་སེང་གེ་བལྟམས་པར་གྱུར་པའི་ཚེ།",
    "ཕྱོགས་ན་གང་ཡོད་ཐམས་ཅད་བསྡུ་བྱས་ཤིང་།",
    "གཤེགས་ཐབས་བདུན་པོར་གཤེགས་པར་གྱུར་པ་དང་།",
    "སེང་གེའི་ང་རོ་རྣམ་པར་སྒྲོག་མཛད་པ།",
    "འགྲོ་བ་ཀུན་གྱི་སྐྱེ་བ་དགག་པར་བྱ།",
    "མི་ཡི་སེང་གེ་རྣམ་པར་འཕྲུལ་མཛད་དང་།",
    "ས་རྣམས་བསྐྱོད་བྱས་དཔེ་ཟླ་མེད་པ་ཡི།",
    "མ་ལུས་སྐྲ་ཡི་སྦུབས་སུ་བསྡུ་བྱས་ཤིང་།",
    "ཕྱོགས་རྣམས་ཞིང་རྒྱུད་དེ་བཞིན་བསྡུ་བྱས་ཏེ།",
    "ཚུལ་རྣམས་འདི་དག་མ་ལུས་ཤེས་བྱས་ཏེ།",
    "འཇིག་རྟེན་མཁྱེན་པའི་ཡོན་ཏན་བརྗོད་པ་དང་།",
    "ཡེ་ཤེས་མཁྱེན་པའི་ཡོན་ཏན་མ་བརྗོད་པ།",
    "ཞིང་ན་མི་ཡི་སེང་གེ་གང་བཞུགས་དང་།",
    "ཚངས་པའི་གནས་ན་རང་བྱུང་གང་བཞུགས་པ།",
    "དུས་ཀྱི་དུས་གསུམ་བསྐལ་པ་ཇི་སྙེད་པར།",
    "ཀུན་ན་རྒྱལ་བ་བསམ་ཡས་བཞུགས་པ་དག།",
    "བགོས་ཤིང་རྒྱལ་བའི་མཆོད་རྟེན་བྱས་པའི་བར།",
    "དེ་དག་རྣམ་པར་འཕྲུལ་པ་ཇི་སྙེད་པ།",
    "འགྲོ་བ་འདི་ན་འཇིག་རྟེན་མཁྱེན་པ་ཡི།",
    "གང་ཡོད་ཐམས་ཅད་མ་ལུས་རྟོགས་པར་ཤེས།",
    "ཀུན་ཀྱང་ཡེ་ཤེས་སྤྱོད་པས་ཤེས་བྱས་ཤིང་།",
    "འཇུག་པ་ཤིན་ཏུ་ཕྲ་བ་མཐའ་དག་བསྡུ་བྱས་ཤིང་།",
    "རྣམ་པར་ཕྱེ་བ་ཇི་སྙེད་ཡོད་པ་རྣམས།",
    "སྤྱོད་པའི་སྟོབས་ལ་གནས་ཤིང་ཤེས་པར་བྱེད།",
    "གང་རྣམས་མ་བྱོན་གང་དག་བཞུགས་པ་རྣམས།",
    "རྒྱལ་བ་ཀུན་གྱི་ཡེ་ཤེས་ཐོབ་པར་འགྱུར།",
    "ཡོངས་སུ་བསྔོ་བ་འདི་དག་ཐོབ་པར་འགྱུར།",
    "འགྲོ་བ་ཀུན་གྱིས་ཐུབ་པར་དཀར་གྱུར་ཅིང་།",
    "ཐམས་ཅད་མཁྱེན་པའི་སྒོའི་དམྱིགས་པ་མཐའ་དང་དབུས་མེད་པ་ལ་སེམས་པ།",
    "སྟོན་ཏམ་ཡང་དག་པར་འཛིན་ཀྱང་རུང་སྟེ།",
    "དེ་དག་ཡོངས་སུ་རྫོགས་པར་བྱེད་པར་གྱུར་ཅིག།",
    "ཚངས་པའི་སྤྱོད་པ་མ་གོད་པར་སྤྱོད་པར་གྱུར་ཅིག།",
    "ཚངས་པའི་སྤྱོད་པ་མཉམས་པར་ཡོངས་སུ་རྫོགས་པར་བྱེད་པར་གྱུར་ཅིག།",
    "ཚངས་པའི་སྤྱོད་པ་མ་འདྲེས་པར་ཡོངས་སུ་སྤྱོད་པར་གྱུར་ཅིག།",
    "ཚངས་པའི་སྤྱོད་པ་རྙོག་པ་མེད་པ་ལ་གནས་པར་གྱུར་ཅིག།",
    "ཟིལ་གྱིས་མི་ནོན་པའི་ཚངས་པའི་སྤྱོད་པ་ཡོངས་སུ་སྤྱོད་པར་གྱུར་ཅིག།",
    "མི་གནས་པའི་ཚངས་པའི་སྤྱོད་པ་རབ་ཏུ་སྒྲུབ་པར་གྱུར་ཅིག།",
    "ཇི་ལྟར་བདག་ཚངས་པའི་སྤྱོད་པ་དེ་ལ་ནན་ཏན་དུ་བྱེད་པ་དེ་བཞིན་དུ་ཚངས་པར་སྤྱོད་པ་ཆགས་པ་མེད་པ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་གནས་མེད་པ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་ཉམས་པ་མེད་པ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་བསྒྲིབས་པ་མེད་པ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་བརྟན་པ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་གཞན་གྱི་དྲིང་མི་འཇོག་པ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་མི་སྒུལ་བ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་མི་གཡོ་བ་དང་།",
    "གཞན་གྱིས་བརྒལ་བ་ཐམས་ཅད་ལས་རྣམ་པར་འདས་པ།",
    "དོར་བ་དང་གཞག་པ་རབ་ཏུ་འགག་པ་ཐོབ་པར་གྱུར་ཅིག།",
    "ཐ་དད་པ་ཡང་དག་པར་ཤེས་པ་ལ་ཞུགས་པས་སྟོན་ཅིང་འགྲོ་བ་ཐམས་ཅད་ཀྱིས་ཕྱི་མའི་མཐར་ཐུག་པ་མི་བདེ་བ་དང་ལྡན་པ་དང་།",
    "ཚིག་ཐམས་ཅད་ཡང་དག་པར་གཟུང་བའི་བྱིན་གྱི་རླབས་ཀྱིས།",
    "རྣམ་པར་དག་པ་མཉམ་པ་དང་།",
    "རྣམ་པར་འཕྲུལ་བ་མཉམ་པ་དང་།",
    "དོན་མཉམ་པ་དང་རྣམ་པར་ངེས་པ་མཉམ་པ་དང་།",
    "ཉམས་པ་མེད་པའི་རྣམ་པར་སྨིན་པས་ཡོངས་སུ་བསྔོའོ།",
    "འདོད་པ་དང་ལྡན་པར་བྱ་བའི་བསམ་པས་ཡོངས་སུ་མི་བསྔོའོ།",
    "ཏིང་ངེ་འཛིན་དང་སྙོམས་པར་འཇུག་པའི་རོ་ལ་ཆགས་པས་ཀྱང་ཡོངས་སུ་མི་བསྔོའོ།",
    "འདི་ལྟར་འགྲོ་བ་ཐམས་ཅད་ཡོངས་སུ་སྨྱིན་པར་བྱ་བ་དང་།",
    "གདུལ་བའི་དོན་དུ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་རྫོགས་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "བསམ་པ་བརྟེན་པ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་སྤྱོད་པ་ལ་གྲུབ་པའི་སེམས་ཀྱིས་ཡོངས་སུ་བསྔོའོ།",
    "བདུད་ཀྱི་དཀྲུགས་མ་ཐམས་ཅད་རྣམ་པར་གཏོར་བ་དང་།",
    "དྲན་པ་རྣམ་པར་སྦྱངས་པས་ཡོངས་སུ་བསྔོའོ།",
    "བློ་གྲོས་རྣམ་པར་ངེས་པས་ཡོངས་སུ་བསྔོའོ།",
    "ལྷག་པའི་བསམ་པ་རྣམ་པར་དག་པས་ཡོངས་སུ་བསྔོའོ།",
    "བདུད་ཀྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་རྣམ་པར་གཏོར་བའི་སེམས་ཀྱིས་ཡོངས་སུ་བསྔོའོ།",
    "རྣམ་པར་དག་པ་དང་ཆགས་པ་མེད་པ་ཐམས་ཅད་རབ་ཏུ་འཐོབ་པར་བྱ་བའི་སེམས་ཀྱིས་ཡོངས་སུ་བསྔོའོ།",
    "བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱ་བ་དང་།",
    "འགྲོ་བ་ཐམས་ཅད་ཡོངས་སུ་སྨིན་པར་བྱ་ཞིང་གདུལ་བ་དང་།",
    "བསམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་སེམས་ཀྱི་རྒྱུད་ཤིན་ཏུ་ཚིམ་པར་བྱ་བ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་རིགས་སུ་འཇུག་པར་འགྱུར་རོ།",
    "ཞིང་ཐམས་ཅད་དུ་སྒྲས་རྒྱས་པར་འགེངས་པའི་དབྱངས་དང་།",
    "སྒྲ་ཆེ་བས་རྣམ་པར་འཁྲུག་པ་ཐམས་ཅད་རབ་ཏུ་ཞི་བར་བྱེད་པའི་དབྱངས་དང་།",
    "འགྲོ་བ་ཐམས་ཅད་ཀྱིས་ངག་མཉན་པའི་དབྱངས་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "སྒྲ་དང་དབྱངས་ཐམས་ཅད་རྣམ་པར་དག་པ་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "དབྱངས་ཐམས་ཅད་ཀྱིས་བརྒྱན་པའི་དབྱངས་ཀྱི་ཡན་ལག་རྣམ་པར་དག་པའི་དབྱངས་རབ་ཏུ་ཐོབ་པར་གྱུར་ཅིག།",
    "འགྲོ་བ་ཐམས་ཅད་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་རྣམ་པར་དག་པའི་མཐར་ཐུག་པར་བྱེད་པ་དང་།",
    "འགྲོ་བ་ཐམས་ཅད་ཀྱི་ཤེས་པའི་དབྱངས་དང་ལྡན་པར་གྱུར་ཅིག།",
    "འགྲོ་བ་ཐམས་ཅད་ཀྱི་ཐེ་ཙོམ་གཅོད་ཅིང་ཁོང་དུ་ཆུད་པར་བྱེད་པའི་དབྱངས་དང་།",
    "སྤོབས་པས་ལེགས་པར་སྦྱར་བའི་དབྱངས་དང་།",
    "རྣམ་པར་དག་པ་རྡུལ་མེད་པ་དྲི་མ་དང་བྲལ་བ་འོད་གསལ་ཞིང་དང་བ།",
    "མིག་ཡོར་གྱི་རྣམ་པར་དམྱིགས་པས་འགྲོ་བ་ཐམས་ཅད་སྣང་བར་གྱུར་ཅིག།",
    "ཡོན་ཏན་ཡང་དག་པར་སྟོན་པ་དང་།",
    "ནན་ཏན་ཡང་དག་པར་སྟོན་པ་དང་།",
    "འགྲུབ་པ་ཡང་དག་པར་སྟོན་པ་དང་།",
    "ཆོ་འཕྲུལ་ཡང་དག་པར་སྟོན་པ་དང་།",
    "བསྐལ་པ་ཐམས་ཅད་དུ་སྐྱོ་བ་མེད་པར་བྱང་བས།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དུ་མ་འོངས་པའི་དུས་ཀྱི་ཕྱི་མའི་མཐའི་མུར་ཐུག་པར་གནས་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་ཤེས་པ་ལ་འཇུག་པ་དང་།",
    "བཟང་ཞིང་སྒྲིབ་པ་མེད་པར་གྱུར་ཅིག།",
    "ཅེས་བྱ་བ་ནས་ཡེ་ཤེས་ཀྱི་མེ་ཏོག་ཆགས་པ་མེད་པའི་མཐར་ཐུག་པའི་ཡིད་ཀྱི་ལས་མེ་ཏོག་རྒྱ་ཆེ་ཞིང་ཡོངས་སུ་དག་པ་བསམ་གྱིས་མི་ཁྱབ་པ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག།",
    "ཕྱེ་མ་དང་བདུག་པ་སྣ་ཚོགས་ཐམས་ཅད་ཀྱི་ཕྱེ་མ་དང་བདུག་པའི་རྒྱན་ས་མཚམས་མེད་པ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག་ཅེས་བྱ་བ་ནས་ཡེ་ཤེས་ཀྱི་ཕྱེ་མ་དང་བདུག་པ་ཆགས་པ་མེད་པའི་མཐར་ཐུག་པའི་ཡིད་ཀྱི་ལས་ཀྱི་ཕྱེ་མ་དང་བདུག་པ་ཡོངས་སུ་དག་པས་མཚམས་མེད་པའི་བར་དུ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག།",
    "ཞིང་ཐམས་ཅད་དུ་གདུགས་སྣ་ཚོགས་ཡང་དག་པར་བཙུགས་པའི་གདུགས་ཀྱི་རྒྱན་ས་འཚམས་མེད་པ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག་ཅེས་བྱ་བ་ནས་ཡེ་ཤེས་ཀྱི་གདུགས་ཀྱི་རྒྱན་ཆགས་པ་མྱེད་པའི་མཐར་ཐུག་པའི་ཡིད་ཀྱི་ལས་ཡེ་ཤེས་ཀྱིས་ཡང་དག་པ་ཁྱབ་པ་ཡོངས་སུ་དག་པས་མཚམས་མེད་པའི་བར་དུ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག།",
    "ལྷབ་ལྷུབ་སྣ་ཚོགས་ཐམས་ཅད་ཀྱི་ལྷབ་ལྷུབ་ཀྱི་རྒྱན་བརྗོད་དུ་མེད་པའི་ཡང་བརྗོད་དུ་མེད་པ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག་ཅེས་བྱ་བ་ནས།",
    "ཡེ་ཤེས་ཀྱི་ལྷབ་ལྷུབ་ཀྱི་རྒྱན་གྱི་མཐར་ཐུག་པའི་ཡིད་ཀྱི་ལས་ཀྱི་ཡེ་ཤེས་ཀྱི་ལྷབ་ལྷུབ་ཀྱི་རྒྱན་གྱིས་བརྒྱན་པ་རྣམ་པར་དག་པ་བརྗོད་དུ་མེད་པའི་ཡང་བརྗོད་དུ་མེད་པའི་བར་དུ་ཀུན་ནས་གནས་པར་གྱུར་ཅིག།",
    "དེ་ལྟར་ཚུལ་དེ་བཞིན་དུ་ཐམས་ཅད་དུ་ཡང་ཤེས་པར་བྱ་སྟེ།",
    "དེ་ལྟར་ཚུལ་དེ་བཞིན་དུ་ཀུན་ཏུ་བྱས་ཏེ།",
