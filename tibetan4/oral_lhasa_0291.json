    "འཇིག་རྟེན་གྱི་ལམ་གྱི་རྒྱུད་ཐམས་ཅད་ལས་ཡང་དག་པར་འདའ་བར་བྱ་བ་དང་།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་སྤོབས་པ་སྐྱེད་ཅིག།",
    "ཤིན་ཏུ་སྦྱངས་པའི་ཡེ་ཤེས་རྣམ་པར་ཕྱེ་བ་ལ་འཇུག་པ་ཉེ་བར་བསྒྲུབ་པ་མཛད་དོ།",
    "བློ་གྲོས་ཤིན་ཏུ་ངེས་པར་རྟོགས་པས་མཁས་པ་ཉེ་བར་བསྒྲུབ་པ་མཛད་དོ།",
    "ཡོངས་སུ་སྦྱང་བ་ཤིན་ཏུ་བྱས་པ་དང་།",
    "མི་བརྗོད་པས་སྐོམ་པར་གྱུར་ནས་དེ་དག་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "ས་ཡི་མཆོག་ནི་བརྗོད་བྱས་ཏེ།",
    "མཁས་པས་རྣམ་པར་ཕྱེ་མི་བཤད།",
    "འདི་ཀུན་ངེས་པར་རྟོགས་པ་སྟེ།",
    "ཀུན་ཀྱང་ཤིན་ཏུ་ཉན་པར་འདོད།",
    "ཀུན་ཀྱང་རིམ་གྲོ་བཅས་པར་གནས།",
    "ས་རྒྱུ་དམ་པ་རྣམ་པར་དབྱེ་བྱ་བ།",
    "ཕྲ་ཞིང་བལྟ་དཀའ་རྣམ་པར་རྟོག་པ་སྤངས།",
    "སེམས་ཀྱིས་དང་བྲལ་བས་བསྒྲུབ་པར་དཀའ།",
    "ཡེ་ཤེས་དམ་པ་འདི་བཟོད་མཉན་པར་ནུས།",
    "ཤིན་ཏུ་བལྟ་དཀའ་ཐུབ་པས་རྣམ་པར་ཕྱེ།",
    "འགྲོ་བ་གང་རྣམས་དད་པར་བྱེད་དཀོན་ཞེས།",
    "ཀུན་ཏུ་རྟོག་པ་ཡོངས་སུ་སྦྱངས་པ་སྤྱད་པར་བྱ་བ་ཤིན་ཏུ་སྤྱོད་པ།",
    "ལེགས་པར་ཡིད་ཆེས་པར་འགྱུར་རོ།",
    "སྤྱོད་པ་རྣམ་དག་ཐམས་ཅད་མཁྱེན་པའི་སྲས་ཀྱིས་ལེགས་པར་ཤོད།",
    "དེ་བཞིན་ས་མཆོག་བློ་ཡི་ཡུལ་དུ་ཐ་མ་ཐུག་པར་འདོང་།",
    "སྤོབས་པ་མཐའ་ཡས་རྣམ་པར་དབྱེ་བ་རྟོགས་མཁྱེན་པས།",
    "ཐ་དད་ཡང་དག་དོན་མཁྱེན་སྤྱོད་པས་ཤོད།",
    "དེ་བྱུང་ནས་ཕྱོགས་བཅུ་ཐམས་ཅད་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་འབྱམ་ཀླས་པ་ཐམས་ཅད་མ་ལུས་པར་སྣང་བར་བྱས་ནས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་འཁོར་གྱི་དཀྱིལ་འཁོར་སྣང་བར་བྱས་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཁམས་མི་མཇེད་འདི་ཡང་སྣང་བར་བྱས།",
    "བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པ་དེ་བཞིན་གཤེགས་པའི་འཁོར་གྱི་དཀྱིལ་འཁོར་འདིའང་སྣང་བར་བྱས་ཏེ།",
    "རྡུལ་མེད་ས་ཀུན་རིམ་གྱིས་རབ་ཏུ་རྫོགས་བྱས་ནས།",
    "སྟོབས་བཅུ་ལྡན་པའི་རྒྱལ་བ་དམ་པར་འགྲུབ་པར་འགྱུར།",
    "དེ་ཕྱིར་ས་ཡི་ཡེ་ཤེས་ལམ་མཆོག་བསྟན་པར་གྱིས།",
    "འཁོར་ཐམས་ཅད་དེ་བས་ཀྱང་དད་པར་བྱ་བའི་ཕྱིར་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་སྨྲས་སོ།",
    "རྒྱུད་ལས་རྣམ་གྲོལ་མཉམ་པར་མྱ་ངན་འདས།",
    "སྨྲ་བའི་ལམ་རྣམས་ཀུན་གྱིས་བརྗོད་པར་དཀའ།",
    "སྨྲ་བར་དཀའ་ན་བསྟན་པར་ག་ལ་ནུས།",
    "དེ་ནི་བསམ་ཡས་སེམས་ལམ་རྣམ་པར་སྤངས།",
    "ཤིན་ཏུ་སྨྲ་དཀའ་བསྟན་པར་མི་ནུས་པ།",
    "ཡེ་ཤེས་ཚུལ་གྱིས་རྫོགས་པར་བྱ་བའོ།",
    "རང་རིག་ཡིན་པས་བརྗོད་པར་མི་ནུས་ཀྱང་།",
    "ཐམས་ཅད་མཐུན་པར་ནན་ཏན་གྱིས་དེ་ཉོན།",
    "བསྐལ་པ་བྱེ་བར་ཟད་པར་མི་ནུས་ཏེ།",
    "མཐུན་ཞིང་ནན་ཏན་ཡོད་པར་སྟ་གོན་གནས།",
    "སྟོབས་བཅུའི་སྟོབས་ཐོབ་པར་བྱ་བ་དང་།",
    "མི་འཇིགས་པ་ཆེན་པོ་ཐོབ་པར་བྱ་བ་དང་།",
    "འགྲོ་བ་ཐམས་ཅད་ཡོངས་སུ་བསྐྱབ་པར་བྱ་བ་དང་།",
    "ཕྱོགས་བཅུ་མ་ལུས་པར་ཐོགས་པ་མེད་པའི་ཡེ་ཤེས་མངོན་དུ་འགྱུར་བར་བྱ་བ་དང་།",
    "ནམ་མཁའི་མཐར་ཐུག་པར་གནས་པ།",
    "ཕྱི་མའི་མཐའི་མུར་ཐུག་པར་སྐྱེ་བར་འགྱུར་ཏེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་རྗེས་སུ་དྲན་ཞིང་རབ་ཏུ་དགའ་བ་ཡིན།",
    "བདག་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡུལ་ལ་ཡང་དག་པར་འབྱུང་ངོ།",
    "ཡོ་བྱད་ཐམས་ཅད་ལ་ཕངས་པར་སེམས་པ་ལྟ་ག་ལ་ཡོད་དེ།",
    "མི་ངོམས་པར་མང་དུ་ཐོས་པ་ཚོལ་བ་དང་།",
    "སྐུ་ན་བཞུགས་པ་དང་།",
    "མི་འཕྲོགས་པ་ཐ་མི་དད་པ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐམས་ཅད་ཀྱིས་ཡང་དག་པར་བསྡུས་པ།",
    "སྦྱིའུ་ཚུགས་སུ་རྒྱུ་བ་ཐམས་ཅད་མ་ལུས་པ་ལྷག་མ་མྱེད་པ་མཐའ་དག་གཞི་མཉམ་པར་ཡང་དག་པར་འཇུག་པ་ཁོང་དུ་ཆུད་པར་བྱ་བ་དང་།",
    "རྣམ་པར་ཕྱེ་བའི་ཡེ་ཤེས་ཁོང་དུ་ཆུད་ཅིང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་འགྲངས་པར་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ལ་འཇུག་ཅིང་ཡོངས་སུ་དག་པར་བྱ་བའི་ཕྱིར།",
    "ཞིང་ཐམས་ཅད་ཞིང་གཅིག་ཏུ་ཡང་དག་པར་གཞོལ་བར་བྱ་བ་དང་།",
    "ཞིང་གཅིག་ཞིང་ཐམས་ཅད་དུ་ཡང་དག་པར་གཞོལ་བར་བྱ་བ་དང་།",
    "མཐུ་དང་ཡེ་ཤེས་ཁོང་དུ་ཆུད་པར་བྱ་བ་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དུ་རྣམ་པར་རྒྱུ་བར་བྱ་བ་དང་།",
    "ཡིད་ཀྱི་ལས་དོན་ཡོད་པར་བྱ་བ་དང་།",
    "དབྱངས་བརྗོད་མ་ཐག་ཏུ་ཡེ་ཤེས་ཁོང་དུ་ཆུད་པར་བྱ་བ་དང་།",
    "ལུས་ཡིད་བཞིན་གྱི་ནོར་བུ་ལྟ་བུ་འཐོབ་པར་བྱ་བ་དང་།",
    "རབ་ཏུ་ཞི་བ་ཐོབ་པར་བྱ་བ་ཡང་དག་པར་བསྟན་པ་དང་།",
    "བསམ་པ་ཤིན་ཏུ་ཚིམ་པར་བྱ་བ་དང་།",
    "སྤྱོད་པ་རྣམས་རྒྱུན་མི་འཆད་པར་བྱ་བ་དང་།",
    "གློང་བ་མེད་པའི་སེམས་དང་ལྡན་པ་དེ་ནི་ལེགས་པར་རྟོག་པ་མང་ཞིང་དད་པ་དང་ལྡན་པ་ཡིན་ཏེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་བསྡུ་བ་ལ་ཡིད་ཆེས་པ་ཡིན།",
    "ས་ཡང་དག་པར་བསྒྲུབ་པ་དང་།",
    "ཁྲོ་བ་དང་ཁོན་དུ་འཛིན་པས་འབར་བར་བྱས་པའི་སེམས་ཀྱི་མེ་ལྕེ་དང་།",
    "ཡིད་དང་རྣམ་པར་ཤེས་པའི་ས་བོན་གྱིས་འདི་ལྟ་སྟེ།",
    "ཉེ་བར་ལེན་པ་རྣམ་པར་འཕེལ་བས།",
