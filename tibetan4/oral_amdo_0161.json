    "བོད་རང་ཐམས་ཅད་ནམ་ཟླ་ཕྱི་མོར་སོང་།",
    "བོད་རྣམས་ལ་ལམ་རྒྱགས་འབྲས་ཕེངས་འབྲས་ཕམ་བཅུ་བཞི་རེ་བསྐུར་ཞིང་།",
    "གཞན་ཨུ་རྒྱན་པའི་འགྲོས་དཔོན་མེད་ཀྱང་ལམ་ཤོགས་ཏེ་འོངས་ཟེར་བས་མི་མང་པོ་ཞིག་ལ་མི་རེས་གསེར་ཞོ་རེ་ཙམ་གྱི་ཁྲལ་ཤོར་འདུག་གསུང་།",
    "དེ་ནས་བོད་ཟལ་མོ་སྒང་ཞེས་བྱ་བའི་ས་ཆར་ཕྱག་ཕེབས་པའི་ཚེ།",
    "སྔོན་ལ་སོང་བའི་ན་ཆུང་གཅིག་ལ་གླེན་ཚད་བྱུང་སྟེ།",
    "གྲོགས་རྣམས་ཀྱིས་ཤི་བར་བྱས་ནས་སོང་འདུག།",
    "ཁྱོད་དང་ང་གཉིས་ལ་སྟོབས་ཅི་འདུག་བལྟའོ་གསུངས་ཏེ།",
    "ཡོན་བདག་མོ་འདི་ཡི་གདོང་པ་ལ་ཁ་ཕྲུ་གཅིག་བཏབ་པས།",
    "མོ་དངས་རྒྱངས་བྱུང་སྟེ་མོ་སྔངས་ཏེ།",
    "ཆང་གི་བཏུང་བ་བག་མེད་དཔག་མེད་གསོལ་ན་ཡང་།",
    "ཡོན་བདག་མོ་གཟོར་མོ་ཞིག་གིས་མཐོང་ནས་ཆང་གཤོག་མ་གཅིག་ཁྱེར་ནས་འདྲེན་དུ་བྱུང་།",
    "དེར་གཞན་གྱིས་ཀྱང་ཚོར་ནས་གཟོ་མོ་དྲུག་ཅུ་ཙམ་གྱིས་གཤོག་མ་རེ་ཁྱེར་ནས་འདྲེན་དུ་བྱུང་སྟེ་གསོལ་གྱིན་བཞུགས་པའི་ཚེ།",
    "ཨུ་རྒྱན་པ་འདི་ཡོན་བདག་མོ་མང་པོ་བསྡུས།",
    "ཆང་ཡོན་བདག་མོ་ཁོང་རང་འཐུང་གིན་འདུག་གིས།",
    "ཁོང་གི་དབུགས་ལ་སྣོམ་དུ་བཅུག་པས།",
    "སྐྱུར་དྲི་ཆེན་པོ་རེ་འདུག་ཟེར་ཁོང་རང་ལ་ཡང་སྐྱུར་སྐྱུགས་བྱུང་བས་ངོ་ཚ་ནས།",
    "སྐྱི་རོང་བདེ་ལེགས་སྟེངས་སུ་བདེ་མཆོག་འཁོར་ལོའི་ཞལ་གཟིགས་བདག་ཏུ་འཛིན་པའི་མགོ་བོ་ནི།",
    "འོད་གསལ་གྱི་ངང་ནས་དཔལ་བདེ་མཆོག་འཁོར་ལོ་ལྷ་དྲུག་བཅུ་རྩ་གཉིས་ཀྱི་བདག་ཉིད་ཅན་གྱི་ཞལ་གཟིགས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་གདན་དུ་ལྷ་མོ་དབུ་ཨུ་མ་དེ་བ་ཡོང་ཡོད་པར་རིགས་པ་ལ།",
    "བསྟན་གདན་ཡིན་ཟེར་ནས་ལོགས་ཤིག་ན་ལྷ་མོ་ཙཎྜི་ཙན་ཏི་ཀ་འདུག།",
    "ལྷ་མོ་ཙཎྜི་མ་ཙན་ཏི་ཀ་ལ་མགོ་བོ་ཕུལ་ཟེར་བའི་སྒྲ་ཞིག་ནམ་མཁའ་ནས་བྱུང་ནས།",
    "ཁོ་བོ་རང་གིས་རལ་གྲི་གཅིག་བརྡེག་པར་བརྩམས་འདུག་ནའང་ཅུང་ཟད་རྡེག་པ་མ་ཕོད་པ་ལས།",
    "གཞན་གཅིག་གིས་ཁོ་བོ་ཡི་མགོ་རལ་གྲིས་རྦད་ཀྱིས་བཅད་ནས་ཙཎྜི་ཀ་ལྷ་བ་བ་ལཟ་མོ་ཙན་ཏི་ཀ་ལ་ཕུལ་ནས།",
    "རྟག་ཏུ་རང་གི་རང་འདོད་སྒྲུབ་སྒྲུབ་བསྒྲུབས་བསྒྲུབས་ནས།",
    "བདག་ཅག་རྣམས་ལའང་ངོ་མཚར་བསྟན་པའི་སླད་དུ་བཟའ་མི་མཛའ་མོ་གཉིས་བདོག་གི།",
    "ད་ལོ་ངའི་ལུས་ཀྱི་རྩ་མདུད་མང་པོ་ཞིག་སོང་།",
    "དུས་དེ་ཙ་ན་དབུས་གཙང་གི་མི་དཔོན་ཀུན་དགའ་བཟང་པོས་བྱེད་ཅིང་ཡོད་པས།",
    "ངའི་ཚིགས་རེ་ལ་ལྕགས་ཀྱི་ཕུར་པ་རེ་བརྒྱབ།",
    "དེའི་ཚེ་ངན་སོང་གསུམ་གྱི་སྡུག་བསྔལ་ཟུག་གི་སྟེང་དུ་བླངས་ནས་དགའ་བ་བསྒོམས་པས།",
    "ཕྱག་གིས་དབྱུགས་བྱུགས་པས་ཟུག་ཐམས་ཅད་ཆག་སོང་།",
    "ཁོ་རང་གི་ཤ་བཅད་ནས་ཁ་རུ་བཅུག།",
    "དེ་ནས་ལོ་ལྔ་ཙམ་ནས་རྗེ་རྗེས་ཀྱང་སྤོང་བ་རྗེས་ཙམ་ཡང་མེད་པར་སོང་བ་ལགས་སྐད།",
    "དེ་ནས་སླར་བླུད་ཏར་བྱོན་ཏེ་རྒྱལ་པོ་ཨ་རོག་རྗེས་ཡོན་བདག་མཛད་ནས་གཟིམས་ཁང་སླར་བཟང་དུ་བཞེངས་སོ།",
    "སྔོན་ང་ལ་རྨི་ལམ་ན་མི་དཀར་པོ་གཅིག་ན་རེ།",
    "ཁྱོད་ཧོར་ཡུལ་དུ་འགྲོ་ན་འགྲོ་དོན་བོལ་ནུབ་ཙམ་ཞིག་ཡོང་།",
    "ལ་སྟོད་ན་བཞུགས་ན་པུས་མོ་ནུབ་ཙམ་ཡོང་།",
    "རྒྱལ་རིན་ལ་ཁྱོད་ཀྱིས་བུམ་པ་ཟུངས་ཤིག་གསུང་།",
    "སང་དུས་ཇོ་བོ་སྟོན་བཙན་མཆན་ཁྱེར་འཕྱན་ཁྱོ་རེ་བྱས་ནས་བལྟ་མི་ནུས་པ་བྱེད་ཀྱིན་འདུག།",
    "ཅི་ཡོད་བྱས་པས་དཔོན་ཀུན་དགའ་བཟང་པོའི་མགོ་དེ་བསྟན་ནས་སོང་གསུང་།",
    "དེ་ཡི་ཚེ་མི་ཆེན་སཾ་གྷ་ཞེས་བྱ་བ་ན་རེ།",
    "མི་ཆེན་སམ་གྷ་ན་རེ།",
    "ཁྱོད་ཀྱིས་སྒྲ་གང་ན་གོ།",
    "རིགས་བདག་གི་ལྷ་ཐམས་ཅད་ཆད་པར་གདའ་གསུང་།",
    "དེར་གཞན་ཞིག་ན་རེ།",
    "སྐྱོ་སྟོན་དྲི་མེད་ཀྱིས་ཉོ་ཆང་ཤེས་པ་ཡིན་མོད།",
    "དེ་ནས་མི་ཤེས་བྱས་ན་ཀོ་ལོང་གཡག་གི་སག་རེ་ཙམ་བྱེད་དུ་ཡོང་གསུང་།",
    "དེ་ན་ཡོད་ན་ཁ་རུ་ཐལ་བ་ཐོབ་གསུང་པས།",
    "ཚོང་དུས་འགུར་མོར་ཐུགས་བསྐྱེད་མཛད་པའི་ཚེ།",
    "དེ་ནས་རྩང་གི་ས་ཆ་ཉང་རོར་བྱོན།",
    "ཆུ་མིག་རིང་མོར་ཁྲོམ་པ་སྡུད་པའི་སྦྱོར་བ་མཛད་པས།",
    "མི་ཁྲི་ཕྲག་རེ་ཙམ་གར་གཤེགས་པའི་ཕྱིར་འབྲངས་པ་བྱུང་།",
    "དེ་ནས་ཚོང་འདུས་འགུར་མོར་བྱོན་ནས་ཐུགས་བསྐྱེད་གསུངས་པས།",
    "ལ་ལས་ནི་རང་གི་སྐུ་དུས་གཅིག་ལ་བྲེགས་ནས་འབུལ།",
    "མི་ཆེ་བ་དུ་མས་རང་རང་གི་གནས་སུ་བསུ་ཞིང་།",
    "དེ་ནས་ཡར་རེས་བྱང་ཕྱོགས་ལ་བྱོན་ཏེ།",
    "ང་སྒྲུབ་པ་བྱེད་པ་ཡིན་པས་ཐམས་ཅད་ཕྱི་རོལ་དུ་ཏུ་སོང་ལ་སྦྲ་སྒོ་སུམས་ཤིག་གསུང་།",
    "དེའི་དུས་ན་ཚ་མདའ་བའི་དཔོན་གཡུ་མགོན་ཞེས་བྱ་བའི་བཙུན་མོར།",
    "ཁོང་གི་བར་ན་དཔོན་མོ་དེའི་སྲས་སྲས་མོ་གཙུག་ཏོར་རྒྱན་ཞེས་བྱ་བ་དང་།",
    "ཁོང་གི་ཕུན་སུམ་ཚོགས་པ་ཉམས་འགྲོ་བར་འདུག།",
    "དཔོན་གཡུ་མགོན་གྱིས་སྲས་མོ་གཉིས་ཀྱི་དབུ་ལ་བྱིལ་མཛད་ནས།",
    "ཤར་ཕྱོགས་འདི་ན་གུར་མགོན་གྱི་ལྐོག་མའི་འོག་ན་འོ་ཅག་གི་གཟིམས་ཁང་ཚུད་པ་ཞིག་འདུག་པ་ལ།",
    "ངས་ཀྱང་ཁྱེད་ཀྱི་ཕྲིན་ལས་ཀྱི་གྲོགས་བྱེད་པས་གཏོར་མ་རེ་ཡང་བླང་ཟེར་གྱིན་འདུག་གསུང་།",
    "དཔོན་བྱང་རིན་གྱིས་བསམ་ཡས་ཀྱི་གཙུག་ལག་ཁང་གི་ཝ་རྡུང་ཝ་གདུང་གི་ནང་ནས་གཡུ་སྐུ་ཁྱེར།",
