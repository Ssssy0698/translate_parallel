    "ཀོ་རི་ཡའི་མི་གཅིག་ལ་ཧ་ཝར་ཌི་མཐོ་སློབ་ཀྱིས་ཨ་རིའི་གོམས་སྲོལ་འཇགས་སུ་བཅུག་འདུག།",
    "འདི་ནི་ང་རང་ཉིད་ཀྱིས་བཟོས་པའི་གྱོན་ཆས་ཤིག་ཡིན།",
    "ང་དང་ཨོ་ཕི་ར་ལྟར་ཁོས་ཀྱང་ལྟ་བ་དེ་ཡག་པོ་ཞིག་རྟོགས་ཐུབ་མེད་པ་དེར་ང་རང་དགའ་ཚོར་ཞིག་སྐྱེས་བྱུང་།",
    "ང་རང་རྒྱ་མི་ལས་བོད་པ་ཞིག་ཡིན།",
    "གལ་སྲིད་ཕྱི་ལོ་༡༩༧༢ ལོར་ང་རང་ཨ་ཧྥི་གྷ་ནི་སི་ཐན་ནང་བཙན་ཁྲིད་བྱས་མེད་ན།",
    "དེར་ཨེམ་བྷ་སི་ཌོར་རྟགས་ཅན་གྱི་རླངས་འཁོར་དཀར་པོ་ཞིག་བཞག་ནས་འདུག།",
    "ཉེན་རྟོག་པས་ལམ་ཆེན་ཐོག་ཏུ་རླངས་འཁོར་དང་རྐང་གསུམ་འཁོར་ལོ་གཅིག་ཀྱང་འགྲོ་རུ་མ་བཅུག་པར་བཀག་ནས་འདུག།",
    "དུས་རབས་བཅུ་དགུ་པའི་ཨིན་ཇིའི་གནའ་རྫས་བརྟག་དཔྱད་མཁན་ཚོས་སྐུ་བརྙན་དེ་ས་འོག་ནས་ཐོག་མར་སྔོག་དུས།",
    "ལོ་ན་ཉི་ཤུའི་སྟོད་ལ་སོན་པའི་ཕོ་གཞོན་དེའི་ལག་ཏུ་ལག་རྟེན་ཞིག་ཐོགས་འདུག།",
    "ཁོ་རང་ལོ་ན་བཅོ་ལྔར་སོན་དུས་བརྡབས་སྐྱོན་ཆེན་པོ་ཞིག་བྱུང་ནས་མིག་ལོང་བར་གྱུར།",
    "ང་རང་བོད་ནས་ཡོང་བའི་གནས་སྐོར་བ་རྣམས་འདུག་སའི་སྒར་དུ་ཕྱིན་པ་ཡིན།",
    "བྱེད་ཐབས་བྲལ་འདུག།",
    "སྐབས་དེ་དུས་ཁོང་ནང་དུ་བཞུགས་མི་འདུག།",
    "ཁོང་རང་ཉིད་ཀྱི་གོ་རྟོགས་གཞིར་བཞག་ན།",
    "རྒྱ་གར་གྱི་དམིགས་བསལ་དམག་མི་ལྔས་མཐའ་བསྐོར་ནས་སྲུང་འདུག།",
    "མཐའ་བཞི་པ་སྟེ་རལ་གྲིའི་སོ་ཁ་དང་མཚུངས་པའི་བྲག་གདོང་དེ་གཡང་གཟར་ཞིང་དེའི་ཤོད་དུ་ལུང་བ་ཞིག་འདུག།",
    "དེའི་ཐོག་ཏུ་ལཱ་སྒྲོན་གྱི་མཆོད་མེ་མང་པོ་ཞིག་བཤམས་འདུག།",
    "ངོས་ཀྱིས་དོན་དག་ཅིག་དྲན་སོས་ཀྱིན་འདུག།",
    "ཕྱག་ཟུང་ཕན་ཚུན་འཇུས་ནས་པང་ཐོག་ཏུ་བཞག་འདུག།",
    "དེའི་ནང་དངོས་གནས་འདུག་སྙམ་པ་དེ་ཡིན།",
    "ཁོང་རང་ཉིད་ཀྱི་ཉམས་མྱོང་དངོས་ལས།",
    "ང་ལ་ད་རུང་དྲི་བའི་ཤོག་ལྷེ་གཅིག་དང་ཕྱེད་ཙམ་འགྲོ་རྒྱུ་ལྷག་འདུག།",
    "ང་རང་ཐེངས་དུ་མར་ཧ་ལས་མྱོང་བ་ལྟར།",
    "དེར་སྨྱུག་མ་བསླས་པའི་རྐུབ་སྟེགས་དང་ཅོག་ཙེ་དམའ་བོ་འགའ་ཤས་བསྒྲིགས་འདུག།",
    "དེ་ཡང་ཁོང་ང་རང་ཉལ་གྲབས་ཡོད་དུས་སླེབས་བྱུང་།",
    "ཕྱི་ཉིན་ཞོགས་པར་ང་རང་གཉིད་ལས་སད་དུས།",
    "ཞོགས་ཇ་འཐུང་བའི་དུས་ཚོད་མི་འདུག།",
    "ང་རང་ཟ་ཁང་དུ་ཕྱིན་ནས་ཞོགས་ཇ་བཏུང་བ་དང་།",
    "ང་དང་ཐག་མི་རིང་བའི་མཚམས་སུ་ལོ་ན་བགྲེས་པའི་བོད་མི་མཆོད་མཇལ་བ་སྐོར་ཞིག་བསྡད་འདུག།",
    "ད་ཐེངས་མཇལ་སྐབས་ང་རང་ཧ་ལས་ཧོན་ཐོར་བྱུང་།",
    "ངོས་ཀྱི་ད་ལྟའི་ལུས་ཀྱི་གནས་སྟངས་ལ་བལྟས་ན་དེ་འདྲ་ཡོང་བ་མི་འདུག།",
    "མགོ་མཁྲེགས་པོ་ཆགས་ཀྱི་འདུག།",
    "མཛེས་ཤིང་ལྟ་ན་སྡུག་པའི་རྡོ་རྐོས་ཀྱིས་བརྒྱན་པའི་བྱིན་ཅན་མཆོད་རྟེན་དང་ལྷ་ཁང་ཆུང་བ་རྣམས་ཀྱི་ཐོག་ཏུ་ལྭ་སྒྲོན་ས་ཡ་ཕྱེད་ཙམ་བསྒྲོན་འདུག་ཅིང་།",
    "མཇལ་སྐོར་བ་ཁྲི་སྟོང་མང་པོས་དལ་བུར་མཆོད་རྟེན་ལ་གཡས་སྐོར་རྒྱག་བཞིན་འདུག།",
    "ཕྱི་ཉིན་ང་རང་སླར་ཡང་དུས་འཁོར་ལྷ་ཁང་དུ་ཕྱིན་པ་ཡིན།",
    "ཁོ་ཚོས་ནོར་འཁྲུལ་ཆུང་ཆུང་ཞིག་བཟོས་འདུག་སྟེ་སྐུ་ཆུང་ཆུང་ཞིག་ཕྱོགས་ནོར་ནས་བཞེངས་འདུག་ཅིང་།",
    "ཁོས་ཡུད་ཙམ་ལ་སོ་སོའི་ལས་འགན་ཏེ་མི་མང་ལ་སྟངས་འཛིན་བྱ་རྒྱུ་བརྗེད་འདུག།",
    "ང་རང་ཕྱིར་སོ་སོའི་མགྲོན་ཁང་དུ་ལོག་པ་དང་།",
    "དེ་གཉིས་ལ་མཚན་རྟགས་བསྐྱོན་མི་འདུག།",
    "ཡང་ནས་ཡང་དུ་ཕྱི་ལ་དགོང་ཟས་ཟ་བར་ཁྲིད་དེ་སྣང་མེད་དུ་བསྐྱུར་བའི་ཚོར་སྣང་སྐྱེ་རུ་འཇུག་མི་ཉན་པའི་བཀའ་མངགས་གནང་འདུག་པའང་ཤེས་ཡོད།",
    "ང་རང་མཆོད་རྟེན་གྱི་ལྷོ་ཕྱོགས་སུ་ས་སྟོང་ཕྲན་བུ་ཞིག་འདུག་པ་དེར་འགྲོ་མཚམས་བཞག་པ་ཡིན།",
    "སྐོར་བ་གཅིག་བསྐོར་རྗེས་ང་རང་ཕྱིར་མགྲོན་ཁང་དུ་ལོག་པ་དང་།",
    "ཁོ་མཐོང་བ་དེར་ང་རང་དགའ་པོ་བྱུང་།",
    "དེར་ད་རུང་ཡང་ཀརྨ་པ་ཕེབས་སྒུག་ཞུ་བཞིན་པའི་མི་ཚོགས་ཀྱིས་གང་འདུག།",
    "ནུབ་ཕྱོགས་པ་ཉུང་ཤས་ཤིག་རྒྱབ་ལོགས་ཀྱི་འབོལ་སྟེགས་སྟེང་དུ་བསྡད་འདུག།",
    "ང་རང་ཡར་སོ་སོའི་ཁང་མིག་ཏུ་ཕྱིན་པ་དང་།",
    "མཁའ་དབུགས་ཀྱི་ཁྲོད་དུ་སེམས་འཚབ་ཀྱིས་ཁེངས་འདུག་ལ།",
    "དེ་དག་ལས་གོ་གནས་དམའ་བའི་དམག་མི་རྣམས་ཀྱིས་དམག་ཆས་དང་ཕྱིང་ཞྭ་རྨོག་རིལ་གྱོན་ནས་སྒོར་སྒོར་ཏུ་བསྡད་འདུག།",
    "འདུག་ས་ཆུང་ཆུང་དེར་བོད་བརྒྱུད་ནང་བསྟན་གྱི་བླ་ཆེན་བཅུ་ཕྲག་ཅིག་འབོལ་སྟེགས་ཐོག་ཏུ་བཞུགས་ཤིང་།",
    "ངས་ཉིན་ཤས་གོང་དུ་མཇལ་དུས་ལས་སྐྱོ་བ་མི་འདུག།",
    "ཨར་འདམ་གྱི་གྱང་ཤིན་ཏུ་མཐུག་པོས་འོག་ཁང་བསྐོར་ནས་འདུག་ཅིང་།",
    "ང་རང་ཁོང་དང་ལྷན་དུ་འགྲོགས་ཏེ་ཞོགས་པའི་ཞབས་འཁྱམ་ལ་ཞུགས་ཐེངས་དང་པོ་དེར།",
    "ཉིན་དེའི་ཉིན་གུང་དེར་ང་རང་མཇལ་ཞུ་ཁང་དུ་འཛུལ་སྐབས།",
    "དེང་སྐབས་ཁྱེད་ཀྱི་སྐུ་གཟུགས་ཅི་འདྲ་འདུག་གམ།",
    "དབུགས་མང་དུ་ཕྱིན་འདུག་པ་དང་།",
    "གོམ་པ་བརྒྱབ་ན་དཀའ་ངལ་མི་འདུག།",
    "དེ་འདྲའི་ན་ཟུག་དྲག་པོས་མནར་བ་སྔོན་ཆད་གཏན་ནས་མཐོང་མྱོང་མི་འདུག།",
    "དེ་ལྟ་བུ་ཞིག་གཏན་ནས་མཐོང་མྱོང་མི་འདུག།",
