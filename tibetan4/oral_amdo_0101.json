    "འདི་རྣམས་ལས་ཀྱང་རྩ་འདབ་ཕྲ་མོ་དུ་མར་གྱེས་པ་ལས་རྩ་སྟོང་ཕྲག་བདུན་རྩ་གཉིས་སུ་འགྱུར་བར་གསུངས་སོ།",
    "དུས་སྦྱོར་རེ་རེ་ལ་དབུགས་སྟོང་བརྒྱད་བརྒྱར་འགྱུར་ལ།",
    "ཐིག་ལེ་བཀག་པར་གྱུར་ན་ཀུན་ནས་མཆོག་གི་ཁྱབ་བདག་བདེ་བ་མཐའ་ཡས་དུས་སུ་འཇུག་པར་འགྱུར།",
    "ཡང་དག་རིག་པ་བདག་གིས་བཤད།",
    "ས་བཅུ་གཉིས་ཀྱི་ས་རེ་རེ་འཐོབ་པོ།",
    "གནས་ལ་སོགས་པ་དོན་དམ་མོ།",
    "སྦྱོར་བ་ཡན་ལག་དྲུག་གི་འབྲས་བུ་ས་བཅུ་གཉིས་པོ་དེ་དག་དུས་ཇི་ཙམ་ན་ཡོངས་སུ་རྫོགས་ཤིང་ཐོབ་པར་འགྱུར་ན།",
    "ཡེ་ཤེས་ཐོབ་ནས་མི་ཟད་མཆོག་གི་གནས་སུ་རབ་འགྲོ་སླར་ཡང་གང་དུའང་སྐྱེ་བ་ལྡན་པ་མིན།",
    "ཅི་སྟེ་གང་གི་ཚེ་ལམ་དུ་རབ་ཏུ་ཞུགས་པར་གྱུར་པ་རྣལ་འབྱོར་མ་ཐོབ་པར་ཤི་བར་གྱུར་པ་ན།",
    "དེ་ཡི་འདོད་པའི་དངོས་གྲུབ་རི་བོང་ཅན་གྱི་ཞག་གི་ཐོ་རངས་དང་ནི་མཚན་མོ་ཕྱེད་ལ་འགྱུར།",
    "རི་བོང་ཅན་ཉ་གང་བའི་ཞག་གི་ཐོ་རངས་ཀྱི་ཆའམ་མཚན་ཕྱེད་ཀྱི་དུས་སུ་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་འཐོབ་ལ།",
    "གུར་གུམ་དང་མེ་ཏོག་གི་ཆར་ལ་སོགས་པའི་སྟེང་དུ་འབབ་པར་འགྱུར་བ་དང་།",
    "ལྷ་རྣམས་མགོ་ཡི་གཙུག་གི་ནོར་བུའི་འོད་ཟེར་ཚོགས་ཀྱི་ཞབས་ཀྱི་པད་མ་ལ་གཏུགས་ཤིང་།",
    "བདག་གི་སྤྲུལ་བའི་སྐུ་མཆོག་གོ།",
    "བདག་གི་ལོངས་སྤྱོད་རྫོགས་སྐུ་མཆོག།",
    "བདག་གི་ཡེ་ཤེས་སྐུ་རབ་བསྒྲགས།",
    "བདག་གི་བདེ་སྐུ་འགྱུར་མེད་མཆོག།",
    "དེ་ལ་འཁྲོལ་བྱེད་མེད་མོད་ཀྱི་ འོན་ཀྱང་སྒྲ་དག་འབྱུང་འགྱུར་བ།",
    "འོན་ཀྱང་སྒྲ་དག་འབྱུང་མོད་ཀྱི།",
    "ཐུན་མོང་མ་ཡིན་པའི་སྔོན་འགྲོ་དབེན་པ་གསུམ་བསྟེན་པ་དང་།",
    "ངོ་སྤྲོད་ཟབ་མོའི་ཚུལ།",
    "ཐུན་མོང་མ་ཡིན་པ་ཐམས་ཅད་གསང་བ་ལས་ཀྱང་ཆེས་གསང་བར་བྱ་སྟེ།",
    "དེང་ཁྱོད་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་བྱིན་གྱིས་རློབ་པར་འགྱུར་གྱིས་ཁྱོད་ཀྱིས་ཀྱང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་མཆོག་ཏུ་གསང་བའི་དཀྱིལ་འཁོར་འདི་དཀྱིལ་འཁོར་དུ་མ་ཞུགས་པ་རྣམས་ལ་སྨྲ་བར་མི་བྱ་ཞིང་།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་སུ་ཞུགས་ཀྱིས།",
    "དེ་བས་ན་ངས་ཁྱོད་ལ་རྡོ་རྗེའི་ཡེ་ཤེས་བསྐྱེད་པར་བྱ་སྟེ།",
    "ཡེ་ཤེས་གང་གིས་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དངོས་གྲུབ་རྣམས་ཀྱང་ཐོབ་པར་འགྱུར་ན།",
    "ཁྱོད་ཀྱིས་དཀྱིལ་འཁོར་འདི་མ་མཐོང་བ་རྣམས་ཀྱི་མདུན་དུ་སྨྲ་བར་མི་བྱ་སྟེ།",
    "ཁྱོད་དམ་ཚིག་ཉམས་པར་གྱུར་ཏ་རེ།",
    "གྲགས་པ་༨དང་པད་དཀར་༩དང་རིམ་པས་དེ་དག་གི་གོང་དུ་སོ།",
    "འདས་པའི་རྒྱལ་པོ་ཉི་མའི་ཅེས་རྒྱལ་པོ་ཟླ་བཟང་གི་ཡབ་འོད།",
    "ཕྱག་ན་རྡོ་རྗེ་ཟླ་བཟང་༡ཁྱོད།",
    "སྨྲ་མཁས་རྟ་མཆོག་ཏིང་འཛིན་གྱིས་སྤྲུལ་པའི་དམག་གིས།",
    "ཟླ་བཟང་ཁྱོད་ནི་རྩ་བའི་རྒྱུད།",
    "ཡིན་ཞིང་དེ་དག་གིས།",
    "སྤྱན་རས་གཟིགས་ལ་གསན་པར་ཡང་འཆད་དོ།",
    "རིང་པོར་གནས་ཀྱང་མཛུབ་མོས་སྟོན་པ་ལྟར།",
    "དགེ་འདིས་འགྲོ་ཀུན་རེ་བ་ཀུན་རྫོགས་ཏེ།",
    "དེ་ཡང་ཐོག་མར་ཐུན་མོང་གི་སྔོན་འགྲོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་སྔོན་འགྲོ་ལ།",
    "སྟག་གི་ལྤགས་པའི་ཤམ་ཐབས་ཅན།",
    "རལ་བའི་ཅོད་པན་གྱི་རྩེ་མོར་རྡོ་རྗེ་ནོར་བུ་དང་།",
    "གཡོན་ཐོད་པ་ཁྲག་གིས་གང་བ་འཛིན་པས་ཡབ་ཀྱི་མགུལ་ནས་འཁྱུད་ཅིང་ཞལ་དུ་སྟོབ་པ།",
    "གཡོན་བརྐྱང་གི་སྟབས་ཀྱིས་ཡབ་ཀྱི་ཞབས་དང་མཉམ་པར་གནས་པའོ།",
    "ཕྱག་དང་སྐོར་བ་སོགས་ཀྱང་མི་བྱེད་པར་གནས་པས་རྡོ་རྗེ་དཀྱིལ་ཀྲུང་ངམ་དེ་མ་གྲུབ་ན་དཀྱིལ་ཀྲུང་རྒྱ་ཆེ་ཆུང་རན་པ་པུས་མོ་གཉིས་སྟན་ལ་ཕེབས་པར་བྱས་ཏེ།",
    "དེའི་ཐད་ཀའི་སྟེང་གི་ནམ་མཁའ་ལ་ཁྲོ་བོའི་མིག་བཞིན་བགྲད་པའི་ཕྱེད་འོག་མ་དཀར་པོ་དང་གོང་མ་ནག་པོར་ཡོད་པ་ཙམ་དུ་གྱེན་ལ་བཟློག་པའི་ལྟ་སྟངས་བྱས་ཏེ།",
    "སེམས་རིག་པ་ཡང་མིག་གི་ལྟ་ས་དེ་ཉིད་ཅིར་ཡང་མི་རྟོག་ཅིང་ཡིད་ལ་མི་བྱེད་པའི་ཚུལ་གྱིས།",
    "ལུས་ཆེན་པོ་འམ་ཆུང་ངུར་སོང་བ་སྙམ་བྱེད་པ་འབྱུང་ཞིང་།",
    "ཐུན་མོང་མ་ཡིན་པའི་སྔོན་འགྲོར་མིང་བཏགས་པ་སྒོམ་ཉམས་མི་སྒུགས་པར་སྒོམ་སྐྱེ་སླ་བའི་དགོས་པ་ཡོད་ཅིང་།",
    "ཐུན་མོང་མ་ཡིན་པའི་སྔོན་འགྲོའི་སྐོར་རོ།",
    "ཕུགས་རྩེ་གཅིག་ཏུ་བསྒྲིམས་པའི་ངང་དུ་འཕྲལ་བློད་པ་རྔ་མོ་ཁལ་བཀྲོལ་བ་ལྟ་བུ་རྣམས་ཚང་བའི་ངང་དུ་མཉམ་པར་གཞག་གོ།",
    "ནམ་མཁའ་རྒྱ་ཆེན་པོ་མཐོང་བའི་ས་རི་རྩེ་འམ་ཐང་གི་དཀྱིལ་ལ་སོགས་པར་རང་གི་ལུས་གཞན་གྱིས་མི་མཐོང་ཙམ་གྱི་རྩིག་པས་བསྐྱོར་བར།",
    "སྔ་དྲོ་དང་དགོངས་མོ་ཉི་མ་ལ་རྒྱབ་བསྟན་ཏེ།",
    "དག་རྒྱུ་རང་རྒྱུད་ལ་ཡོད་པའི་ཉོན་མོངས་རྣམས་ཡིན་ཅིང་།",
    "དག་བྱེད་སོར་སྡུད་སོགས་ལམ་ཟབ་མོ་ཡན་ལག་དྲུག་གིས།",
    "དག་པར་བྱས་པའི་འབྲས་བུ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་རྒྱལ་བ་རིགས་དྲུག་གི་གོ་འཕང་ཐོབ་པར་འགྱུར་པ་ཡིན་གྱི།",
    "ཉིན་མོའི་གནས་སུ།",
    "འོད་གསལ་འཕེལ་བར་འགྱུར་ཏེ་ལས་སྣང་མི་གཏོད་པ་དེ་འོད་གསལ་དུ་སོང་བ་མིན་ཅིང་དེ་འགགས་པའི་རྗེས་ནས་སྣང་བ་ཡིན་ཏེ།",
    "ཞལ་ཤེས་གཞན་དང་མི་མཐུན་ཡང་འདི་ཉིད་ཤེས་བྱེད་གཟིགས་པའི་ངེས་པ་ཅན་ཡིན་ཞེས་གསུང་ངོ།",
    "རྒྱ་གར་ལྷོ་ཕྱོགས་དང་དཔལ་ལྡན་འབྲས་ཕུང་གི་མཆོད་རྟེན་དུ།",
    "ཞེས་པ་ལྟ་བུ་ཡང་ཉོན་མོངས་ཅན་གྱི་ཕུང་པོ་འདི་མ་ཡིན་ཞིང་།",
    "ཉོན་མོངས་པ་དང་བཅས་པའི་སེམས་འདི་དང་བྲལ་ནས་སེམས་གཞན་རྣམ་ཀུན་མཆོག་ལྡན་མངོན་དུ་གྱུར་ནས་དོན་དམ་པའི་སྐུ་བཞི་ཐོབ་པའོ།",
    "རྣམ་ཀུན་མཆོག་ལྡན་གྱི་སྟོང་པ་ཉིད་ཕན་ཚུན་གཅིག་ལ་གཅིག་གི་རྒྱས་བཏབ་པས་ན་ཕྱག་རྒྱ།",
    "བསྒོམས་པའི་སྟོབས་ཀྱི་ཤའི་མིག་གིས་མཐོང་ལ་དེ་ནས་རིམ་གྱིས་ལྷའི་མིག་སོགས་ཀྱིས་མཐོང་ཞིང་།",
    "ཡེ་ཤེས་ཀྱི་སྤྱན་ཐོབ་ནས་གཟིགས་སོ།",
    "མཉམ་བཞག་གམ་པུས་མོ་ལ་ལག་མཐིལ་བཀབ་པ་གང་བདེ་བྱ་ཞིང་།",
    "ལྟ་སྟངས་ཀྱང་བགྲད་པའི་མིག་གིས་མཐོན་པོར་མི་ལྟ་བར།",
    "མགོ་གཡས་སུ་བསྒྱུར་ཏེ་ལག་པ་གཡོན་རྡོ་རྗེ་ཁུ་ཚུར་མཛུབ་མོ་སྦྲེང་བའི་མཛུབ་མོས་སྣ་བུག་གཡས་པའི་ཕྱི་བཤོག་མནན་པས་བཀག་སྟེ།",
    "གཡས་པ་སྔར་བཞིན་བྱས་པའི་འཛུབ་མོས་སྣ་བུག་གཡོན་པའི་ཕྱི་བཤོག་མནན་པས་བཀག་སྟེ།",
    "དེ་ལྟ་མིན་ནས་དགང་གཏོང་གིས་མཉམ་རྒྱུར་བསྒྱུར་ལ།",
    "གནས་ནི་ཉིན་མོ་དང་མཚན་མོ་རིམ་པ་བཞིན་ཉིན་མཚན་གྱི་རྣལ་འབྱོར་གནས་སུའོ།",
    "རང་གིས་འདེབས་སམ་གཞན་གྱིས་ཀྱང་རུང་སྟེ་ལག་པ་གཉིས་ཀྱི་སོར་མོ་རྣམས་ལྟག་པར་བསྣོལ་ལ་མཐེ་བོ་གཉིས་ཀྱིས་རྩེ་ཆུང་གཉིས་བཙིར་ཞིང་སེམས་རྟོག་མེད་དུ་བཞག་གོ་འདི་བུམ་པ་ཅན་གྱི་བོགས་འདོན་ཡིན་པས།",
    "བུ་ག་དགུའི་རྩ་སྒོ་རྣམས་ཧཱུཾ་ཡིག་གིས་བཀག་པར་བསྒོམས་ཤིང་།",
    "དེ་དག་ཁོར་གཅིག་གིས་མ་ཕེབས་ཀྱང་བསྐྱར་ཞིང་བསྒོམས་པས་ཕེབས་པར་འགྱུར་རོ།",
    "རིངས་ཀྱིས་རིང་དུ་བུས་ནས་འབུད་ཅིང་རྔུབ་པ་སྣ་བུག་ཉི་ཀ་ནས་ནང་དུ་ཧཱུཾ་ཐུང་གིས་རྔུབས་ཅིང་སྲོག་ཐུར་སེལ་འདྲེས་པ་གསང་གནས་སུ་ནོན་པར་མནན།",
    "དེ་མ་ཐག་སྤྱི་གཙུག་ནས་མར་ལོག་པ་ཕཊ་ཀྱིས་འོག་སྒོ་རྡེབས་གསང་གནས་སུ་དྲག་ཏུ་མནན་ནས་ལྟེ་བ་ཕྱིར་འཕུལ་བ་ལན་འགར་བྱས་ནས་སླར་ཡང་ཕྱིར་ཧཱུཾ་རིངས་ཀྱིས་བུད་དོ་གསང་གནས་ནས་དྲངས་པ།",
    "སྤྱི་གཙུག་གི་འཁོར་ལོ་ལྔའི་ལྟེ་བ།",
    "དེ་ལས་ཀྱང་རྩའི་རྩེ་མཛོད་སྤུར་གུག་པ་ལྟར་སོང་ནས།",
    "གོང་གི་བདུད་རྩི་ལྕེ་སྦྱོར་དང་ཁྱད་པར་མེད་དོ།",
    "བདག་ཕན་ཐབས་མཁས་སུ་ཞིག་རང་གི་བརྩོན་པ་འདོར།",
    "དེ་ཕྱིར་སྐྱེ་བོ་དམ་པས་རིགས་པའི་ཤིང་རྟ་ལུང་གི་འཁོར་ལོས་དྲངས་པ་ཆེན་པོ་ཡིས།",
    "གང་ཡིན་དེ་འདིར་རང་གི་ཆེད་དུ་ལེགས་པར་ཡོངས་སུ་སྤྱད་པ་མཁས་པ་རྣམས་ཀྱིས་རྟོགས།",
    "དོན་འདི་ཉིད་འཕགས་པ་བྱམས་པ་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་དེས་གཟིགས་ཏེ།",
    "འགྲོ་བ་རབ་ཏུ་ལྡོངས་པ་དམིགས་བུ་མེད་པ་དེ་དག་གི་ཕྱིར་དེ་དག་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཕྱོགས་ཀྱི་སྒོ་སྣང་བར་བྱ་བའི་ཕྱིར་རྒྱལ་བའི་ཡུམ་མ་ལུས་པ་ཐུགས་ལ་བཞག་སྟེ།",
    "དེ་བས་ན་འདི་ནི་མན་ངག་གི་བསྟན་བཅོས་ཡིན་གྱི།",
    "འཇུག་པ་པོ་རྣམས་ལ་ཉེ་བར་བསྟན་པ་མ་ཡིན་གྱི་དུས་ཡུན་རིང་མོས་གོ་བ་སྐྱེད་པ་ཙམ་གྱི་ཡན་ལག་ཏུ་གྱུར་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་རིམ་པ་གསུམ་དུ་བྱུང་བས་རྒྱལ་བའི་ཡུམ་ལེགས་པར་གཏན་ལ་ཕབ་མོད་ཀྱི།",
    "དེ་བས་ན་རིམ་པ་རེ་རེ་ཡང་དོན་མེད་པར་ནམ་ཡང་མི་བསམ་མོ།",
    "ཚིག་གི་དོན་ནི་དངོས་སུ་བསྟན་ཅིང་།",
    "འཕགས་པ་བྱམས་པ་བདག་ཉིད་དམ་པ་རྣམས་ཀྱི་སྤྱོད་པ་དང་མཐུན་པར་རབ་ཏུ་སྟོན་པས་སོ་སོ་རང་གི་རིག་པའི་ཡེ་ཤེས་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡུལ་ཅན་གྱི་རབ་ཏུ་དང་བ་ནི་ལེགས་པ་ཐམས་ཅད་འཐོབ་པའི་རྒྱུའི་གཙོ་བོ་ཡིན་ནོ་ཞེས་བྱ་བར་ངེས་པར་བཟུང་ནས།",
    "སྐབས་བརྒྱད་པ་ལས་ནི་བཅུ་གསུམ་མོ།",
    "དེའི་འོག་མ་ཚིགས་སུ་བཅད་པ་གཅིག་གིས་ནི།",
    "དེ་ནས་ནི་གཞུང་ཇི་ལྟར་བརྩམས་པ་རང་གི་མིང་གིས་སྨོས་པ་དང་བཅས་པའི་ཚིགས་སུ་བཅད་པ་གཉིས་སྨོས་སོ།",
    "དེ་ནས་ནི་ཡུམ་འདི་ཟབ་པས་བདག་གི་ཡུལ་མ་ཡིན་ཞིང་སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱི་ཡུལ་དུ་བསྟན་པའི་ཚིགས་སུ་བཅད་པ་གཅིག་གོ།",
    "འདི་ནི་རེ་ཞིག་འགྲེལ་པའི་བསྡུས་པའི་དོན་དུ་ཤེས་པར་བྱའོ།",
    "ད་ནི་ཡན་ལག་གི་དོན་ཅུང་ཟད་དགྲོལ་ཏེ།",
    "དེ་ལྟར་དགོས་པ་དེ་གཉིས་གཟིགས་ནས་དང་པོ་ཉིད་དུ།",
    "རང་བཞིན་ལ་ནི་འབྲས་བུའི་མིང་གིས་སོ།",
    "དེ་ལས་འདས་ཤིང་རིང་དུ་སོང་བ་འཇིག་རྟེན་ལས་འདས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དོན་ཏོ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བ་གང་ཡིན་པ་དེ་ནི་རིང་དུ་སོང་བ་སྟེ།",
    "གང་ལས་རིང་དུ་སོང་བ་ཞེས་བྱ་ཞེ་ན།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་ཕུང་པོ་རྣམས་ལས་རིང་དུ་སོང་བས་ན།",
    "དེའི་ཕྱིར་རིང་དུ་སོང་བ་ཞེས་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡི་གེ་པའི་རིང་པོ་ཉིད་ནི་གཙུག་ལག་གི་ཚིག་ཡིན་པས་འགལ་བ་མེད་དོ།",
    "དེའི་ཕྱིར་ན་ཡང་དག་པར་ན་རང་བཞིན་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱིས་ཀྱང་མི་གཟིགས་ཏེ།",
    "ཁྱོད་ཉིད་གཅིག་པུ་གཟུགས་མང་དང་།",
    "ཁྱོད་ནི་གང་ལའང་མི་བརྟེན་ཞིང་།",
    "སུ་ཡིས་འདིར་ཁྱོད་བསྟོད་པར་ནུས།",
    "ཁྱོད་ལ་བསྟོད་པ་མ་བྱས་ཀྱང་།",
    "དགྱེས་མི་དགྱེས་ལས་འདས་མོད་ཀྱི།",
    "དེའི་ཞེས་བྱ་བའི་བུད་མེད་ཀྱི་རྟགས་ཀྱིས་བསྟན་པའི་ཕྱིར་དང་།",
    "རྒྱན་ཞེས་བྱ་བ་ནི་ཚིག་ལེའུར་བྱས་པའི་མན་ངག་གིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་དོན་ཤེས་པར་བྱ་སྟེ།",
    "སྐྱེས་པའམ་བུད་མེད་གང་ཞིག་གི་གཟུགས་ལ་དགའ་བ་སྐྱེ་བའི་རྒྱུ་ནི་རྒྱན་རྣམས་ཡིན་ཏེ།",
    "དེ་ནི་དེ་ལྟར་འགྲུབ་པ་ཉིད་འགྲེལ་པ་འབའ་ཞིག་གིས་མི་སྲིད་ལ།",
    "ཕུང་པོ་དང་ཉོན་མོངས་པ་དང་།",
    "རང་གི་ནུས་པ་ལྷོད་པར་མི་བྱེད་དེ།",
    "ད་ནི་སློབ་དཔོན་བདག་ཉིད་སྔོན་གྱི་སློབ་དཔོན་གྱི་ལུགས་ལ་མཁས་པར་བསྟན་པས་འགྲོ་བ་རྣམས་རང་གི་འགྲེལ་པ་ལ་འཇུག་པར་བྱ་བ་དང་།",
    "ཁ་ཅིག་ན་རེ་ཡི་གེ་ཨ་ནི་རིང་པོ་ཡིན་པས་ལྷག་པར་སྟོན་ཏེ།",
    "དེ་དག་གིས་ནི་མཚམས་སྦྱོར་བ་མ་རྟོགས་པ་སྟེ།",
    "སློབ་དཔོན་དབྱིག་གཉེན་དག་གིས་སྐབས་བརྒྱད་དུ་ཕྱེ་མོད་ཀྱི་དོན་གཞན་དུ་རྣམ་པར་རིག་པའི་གྲུབ་པའི་མཐར་རྒྱལ་བའི་ཡུམ་བཀྲོལ་ཏེ།",
    "དེ་ལྟར་དེ་དག་གི་སྐབས་ཀྱི་དོན་མ་བརྗོད་ཅིང་རྣམ་པར་རིག་པའི་ཞེན་པ་མ་སྤངས་པས་ན།",
    "ཁ་ཅིག་ན་རེ་རྒྱལ་བའི་ཡུམ་མཐའ་དག་མ་རྙེད་པར་ཞེས་ཟེར་ཏེ་དེས་ནི་ལེགས་པར་མ་སྨྲས་སོ།",
    "ཞེས་པ་ནི་དེ་རང་གི་ཤེས་རབ་འཕེལ་བར་བྱ་བའི་ཕྱིར་གཞུང་བརྩམས་ཀྱི།",
    "ཁ་ཅིག་གིས་ནི་བསྟན་བཅོས་ཀུན།",
    "ཉོན་མོངས་དགྲ་རྣམས་མ་ལུས་འཇོམས་པ་དང་།",
    "ཅེས་པའི་ངེས་པའི་ཚིག་གི་ཚུལ་གྱིས་ན་བསྟན་བཅོས་ཏེ།",
    "ཀུན་མ་རྙེད་པ་ཉིད་ཅེས་པ་ནི་རང་རང་གི་བློས་མ་རྟོགས་པ་སྟེ་གཞུང་མ་རྙེད་པ་ནི་མ་ཡིན་ནོ།",
    "ཁ་ཅིག་གིས་ནི་ཞེས་པ་ནི་སློབ་དཔོན་དབྱིག་གཉེན་དང་།",
    "དེ་ལྟར་མཁས་པས་སྣང་བར་བྱས་པ་ཡང་བདག་གིས་ཤེས་ལ།",
    "ལ་ལས་ནི་དོན་ཚང་བར་མ་ཤེས་ལ་བདག་གིས་ཚང་བར་ཤེས་སོ་ཞེས་བསྟན་ནས།",
    "དེ་ཡང་རང་གི་ལྷས་བྱིན་པ་ལ་སོགས་པ་ནི་མ་ཡིན་ཏེ།",
    "ཟབ་མོའི་ལམ་ཅན་འདི་ལྟ་སྟེ།",
    "རང་གི་འབད་པའི་རྗེས་སུ་བྱིན་གྱི་རླབས་འབྲང་བ་ནི་ཆུའི་ཟླ་བ་ལྟ་བུ་སྟེ།",
    "རྣམ་པ་ཀུན་ཏུ་བདག་གིས་ནི།",
    "རྣམ་པ་ཀུན་ཏུ་བདག་གིས་ནི།",
    "སེམས་བསྐྱེད་གཅིག་ཅེས་གདམས་ངག་གི་རྐྱེན་ཅན་དུ་ཡང་སྦྱར་རོ།",
    "སོ་སོ་རང་གིས་རིག་པའི་ཡེ་ཤེས་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡུལ་ཅན་གྱི་རབ་ཏུ་དང་བ་ནི་ཞེས་བྱ་བ་ལ།",
    "སོ་སོ་རང་གིས་རིག་པ་ཞེས་བྱ་བ་ནི་ངག་གི་ལམ་ལས་འདས་པས་བརྗོད་པ་དང་བྲལ་བ་སྟེ།",
    "རང་གིས་ཡང་དག་པར་རིག་པ་དེ་ནི་གཞན་ལ་བསྟན་ནུས་པ་མ་ཡིན་ལ།",
    "དེ་བས་ན་རང་ཁོ་ནས་ཡང་དག་པར་རིག་པ་ནི་རང་གིས་ཡང་དག་པར་རིག་པའོ།",
    "མཐའ་དང་དབུས་མེད་ཚིག་གིས་བརྗོད་དུ་མེད།",
    "ཅི་སྟེ་རི་བོང་གི་རྭ་ལྟར་ཤིན་ཏུ་མེད་པས་ན་བརྗོད་པར་མི་ནུས་སམ།",
    "དེས་ན་ཐལ་བར་འགྱུར་བ་དང་།"
  ]
}