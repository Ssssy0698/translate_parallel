    "རྣམ་པར་འཕེལ་བར་བྱེད་པ་མ་ཡིན་ནོ།",
    "ཀློག་ཅིང་ཀུན་ཆུབ་པར་བྱེད་པ་དང་།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་དེ་ལ་རྟག་ཏུ་རྒྱུན་མི་ཆད་པར་བསྲུང་བ་དང་།",
    "ཀློག་ཅིང་ཀུན་ཆུབ་པར་བྱེད་པ་དང་།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་དེ་ལ་རྟག་ཏུ་རྒྱུན་མི་ཆད་པར་བསྲུང་བ་དང་།",
    "སྦྱིན་པའི་ཕ་རོལ་དུ་ཕྱིན་པས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི་ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ་མི་དམིགས་པའི་ཚུལ་གྱིས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི་ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ།",
    "མི་དམིགས་པའི་ཚུལ་གྱིས་ནང་སྟོང་པ་ཉིད་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ།",
    "མི་དམིགས་པའི་ཚུལ་གྱིས་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་བར་དུ་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ།",
    "མི་དམིགས་པའི་ཚུལ་གྱིས་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ།",
    "མི་དམིགས་པའི་ཚུལ་གྱིས་ཡང་དག་པར་སྤོང་བ་དང་།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་གྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ།",
    "དེའི་ཚིག་བླང་བར་འོས་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "ཚིག་རན་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "ཚིག་འཆལ་པ་མེད་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "ཁྲོ་བས་ཟིལ་གྱིས་ནོན་པ་མེད་པར་འགྱུར་རོ།",
    "ང་རྒྱལ་གྱིས་ཟིལ་གྱིས་ནོན་པ་མེད་པར་འགྱུར་རོ།",
    "གཞན་ཡང་སྲོག་གཅོད་པ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར་རོ།",
    "སྲོག་གཅོད་པ་སྤོང་བའི་ལེགས་པ་རྗོད་པར་འགྱུར་རོ།",
    "བདག་ཀྱང་མ་བྱིན་པར་ལེན་པ་དང་།",
    "འདོད་པས་ལོག་པར་གཡེམ་པ་དང་།",
    "གནོད་སེམས་དང་ལོག་པར་ལྟ་བ་སྤངས་པར་འགྱུར།",
    "གཞན་ཡང་ལོག་པར་ལྟ་བ་སྤོང་བ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ལོག་པར་ལྟ་བ་སྤོང་བའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་སྦྱིན་པའི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་སྦྱིན་པའི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "སྦྱིན་པའི་ཕ་རོལ་དུ་ཕྱིན་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་འཇུག་པར་འགྱུར་རོ།",
    "གཞན་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "ནང་སྟོང་པ་ཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་སྙོམས་པར་འཇུག་པར་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་སྙོམས་པར་འཇུག་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་གཟུངས་རྣམས་ཐོབ་པར་འགྱུར།",
    "གཞན་ཡང་གཟུངས་རྣམས་ཐོབ་པར་བྱ་བ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "གཟུངས་རྣམས་ཐོབ་པར་བྱེད་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་བསམ་གཏན་དང་པོ་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་བསམ་གཏན་དང་པོ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བསམ་གཏན་དང་པོའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གསུམ་པ་དང་བཞི་པ་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་བསམ་གཏན་བཞི་པ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བསམ་གཏན་བཞི་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་བྱམས་པ་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་བྱམས་པ་ལ་སྙོམས་པར་འཇུག་པ་ལ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བྱམས་པ་ལ་སྙོམས་པར་འཇུག་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "གཞན་ཡང་བཏང་སྙོམས་ལ་སྙོམས་པར་འཇུག་པ་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "བཏང་སྙོམས་ལ་སྙོམས་པར་འཇུག་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པར་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "ཆུང་ཟད་མེད་པའི་སྐྱེ་མཆེད་དང་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པར་ཡང་དག་པར་སྐུལ་བར་འགྱུར།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ལ་སྙོམས་པར་འཇུག་པའི་ལེགས་པ་རྗོད་པར་འགྱུར།",
    "བདག་ཀྱང་ཡང་དག་པར་སྤོང་བ་དང་།",
