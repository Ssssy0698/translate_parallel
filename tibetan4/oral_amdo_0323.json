    "གཟིམས་ཁང་གོང་གི་སྤྲུལ་བའི་སྐུ།",
    "ངས་བློ་གསལ་འཇུག་ངོགས་སུ་རེ་གཉིས་རེ་ཕུད་ཡོད།",
    "ཕུན་ཚོགས་ཕུན་ཚོགས་རེད།",
    "བདག་གིས་ཀྱང་ཤོག་མཐར་བྲིས་ནས་ཡོད་མོད།",
    "རང་གིས་ལོངས་སྤྱོད་པའི་ཆུའི་འགོ་ལ་ཁ་ཟེར་སྣ་ཟེར་མང་ན།",
    "འཕྱུག་འགྲོ་རྒྱུ་ཞིག་ཡོད་ཚོད་རེད།",
    "མཚོ་སྔོན་དུས་འཁྲུགས་ཀྱི་མགོ་དཔོན་མ་རེདམཚོ་སྔོན་དུས་འཁྲུགས་སྐབས་ཀྱི་བོད་སོག་གི་མགོ་དཔོན་ནི་ཨོ་རོད་གུ་ཤྲིར་ཝང་གི་སྲས་རྒྱུད་ཆང་ཝང་བློ་བཟང་བསྟན་འཛིན་ཟེར་བ་དེ་རེད།",
    "ཨོ་རོད་ཚོ་དྲུག་གི་ཚོ་བཞི་ཡང་ཟེར་དཔོན་རྣམས་ནི་སྔོན་གྱི་གེ་སར་དམག་གི་རྒྱལ་བོ་ཟེར་བ་དེའི་རྒྱུད་པ་ཡིན།",
    "ཁྲི་ཆེན་བློ་གྲོས་རྒྱ་མཚོས་བར་ཆིངས་པ་མངགས་ནས་འདུམ་པར་མཛད་པསརེ་ཞིག་ཙམ་ལ་བདེ་བར་གནས།",
    "མ་འཆམ་པརལྷ་བཟང་གི་ལོ་བཅུ་གསུམ་པ་རབ་བྱུང་ཉི་མའི་བྱ་ལོར།",
    "ཨོ་རོད་ཀྱི་རྒྱལ་བོ་དགའ་ལྡན་ཚེ་རིང་གིས།",
    "ཆིན་དམག་ལ་གཡུལ་མང་བོ་བཀྱེས་ཚོད་རེད།",
    "ལྷ་མོ་ཨེར་ཏི་ནི་དར་རྒྱས་ཟེར་བས་རྒྱལ་ས་བཟུང་ལྕགས་ལུག་ལོར་ཏཱ་བ་ཆེ་བ་དང་ཨ་མོར་ས་ནཱ་ཟེར་བ་གཉིས་ཀྱིས་ལྷ་མོ་ཨེར་ཏི་ནི་དར་རྒྱས་བསད་ནས།",
    "དེ་ནས་ཡང་ས་ནཱ་ཟེར་བ་དེ་སོང་ནས་ཆིན་གོང་མ་ལ་མགོ་བཏགས་ཏེ།",
    "ཤིང་ཁྱི་ལོར་དམག་མང་བོ་ཁྲིད་ནས་སོང་སྟེ་ཤིང་ཕག་ལོར་ཨོ་རོད་ཀྱི་རྒྱལ་བོ་ཏཱ་བ་ཆེ་བཟུང་ནས་ཆིན་གོང་མ་ལ་གཏད།",
    "གུ་ཤྲི་ཧན་གྱི་བུ་བཀྲ་ཤིས་པ་ཐུར་འདི་གཡོག་མོ་ཞིག་གི་བུ་རེད་ཟེར་མཚོ་སྔོན་སྤྱིའི་དཔོན་བྱས།",
    "དེའི་བུ་བློ་བཟང་བསྟན་འཛིན་འདི་མཚོ་སྔོན་སྤྱིའི་དཔོན་བྱས་པ་རེད།",
    "གསང་རྒྱ་གྲོལ་ནས་མཚོ་སྣ་ནས་རྒྱལ་བ་ཚངས་དབྱངས་རྒྱ་མཚོ་གདན་སར་བཀོད་ཀྱང་ཁོང་གིས་སྤྱོད་པ་རྩིང་བོ་གནང་སྟེ།",
    "འོལ་དགའའཕྱོང་རྒྱསགོང་དཀར་སོགས་སུ་ཕེབས་ནས་རྩེ་འཇོར་རོལ་བ་དང་མཚན་མོར་ལྷ་ས་དང་ཞོལ་གྱི་གྲོང་ནང་གི་བུད་མེད་དག་གི་ཁྱིམ་དུ་ཞུགས་ཏེ་ཆུང་འདྲིས་བུ་མོ་མང་བོ་བཙལ་བ་སོགས་ཀྱི་མཛད་པ།",
    "སྔར་རྒྱུན་བཞིན་གུ་ཤྲི་ཁཱང་གི་སྲས་རྒྱུད་རྒྱལ་བོར་མ་བཞག་པཔ་སོགས་བློར་མ་བབ་པར།",
    "སོག་དཔོན་རྣམས་ཀྱིས་གསེར་གདུང་ཆེན་མོའི་མདུན་ནས་རྒྱ་ལ་ངོ་ལོག་བྱེད་རྒྱུའི་མནའ་བོར།",
    "ཕྱིར་ལོག་ནས་བསྟན་འཛིན་ཝང་གིས་འགོ་བསྡུས་ནས་རྒྱ་ལ་ངོ་ལོག་རྒྱ་ཆེན་པོ་བྱས་རྒྱ་དམག་ཆུ་རྡོལ་བ་བཞིན་བྱུང་བས་བསྟན་འཛིན་ཝང་ཇུན་གར་དུ་བྲོས།",
    "རྨ་ཆུའི་ལྷོ་རྒྱུད་བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་སོགསགནོད་བྱེད་ཁྱི་མང་གིས་གཙེས་ཚེ།",
    "ནང་དུ་ཤིང་གིས་བཞེངས་པའི་ཐུགས་རྗེ་ཆེན་པོ་ཕྱག་སྟོང་སྤྱན་སྟོང་སུམ་ཐོག་གང་བའི་ཆེན་པོ་ཞིག་ཡོད།",
    "མ་གཞི་བསམ་ཡས་ལ་དཔེ་བླངས་ནས་བཞེངས་པའི་ལྷ་ཁང་ཞིག་རེད།",
    "གཞེས་ནིང་ལོར་བདག་དེ་གར་སོང་ནས་བདུན་གཅིག་ལ་བསྡད་དེ་མཇལ་སྐོར་ཞིབ་མོ་བྱས།",
    "རྗེ་འཇམ་དབྱངས་བཞད་པའི་ཐུགས་རྟགས་བཅད་པ་རེད་ཟེར་སྲོལ་ཡོད།",
    "སྐྱ་རེངས་ཕོ་ཉ་སྔོན་དུ་འོངས་པ་ལ།",
    "ལེགས་ཉེས་སྟོན་བྱེད་མོ་རྩིས་བྱེད་པ་ལ་བོན་ཟེར་ཞིང་།",
    "རྒྱལ་བོས་དེ་དག་བྱེད་མཁན་ཞིག་ཨ་མཆོད་དུ་བསྟེན་ནས་རྒྱལ་སྲིད་དོན་དུ།",
    "དེ་ལྟ་བུའི་བོན་དག་ནི་ད་ལྟའི་དགེ་ཚུལ་སློང་གི་བོན་དགོན་དག་དང་མི་འདྲ།",
    "མོ་རྩིས་སོགས་བྱེད་པར་མ་ཟད།",
    "ཁྲི་སྲོང་གི་དུས་སུ་རྒྱང་འཕུད་བཏང་བ་དག་གི་ཤུལ་རྒྱུན་ཡིན་ནམ་སྙམ།",
    "ལྷ་སྒྲུང་སོགས་ཀྱི་སྒོ་ནས་རྒྱལ་སྲིད་ལ་བློ་དཀར་ཞིང་ཡིད་ཆེས་པར་བྱེད་པ་ལ་ཆབ་སྲིད་སྒྲུང་གིས་བསྐྱངས་ཞེས་ཐ་སྙད་བཏགས་ཏེ།",
    "བསླབ་པ་གསུམ་ལ་འཇུག་པ་གོ་བར་བྱ་བའི་ཕྱིར་གཡུང་དྲུང་གི་བོན་བསྟན།",
    "སྙན་ངག་གི་གབ་ཚིག་རྒྱན་དང་ཁེད་ལྡེའུ་གཉིས་མི་འདྲ་ཚུལ་ངེད་ཀྱིས་བྲིས་པའི་དྲང་སྲོང་ཚངས་ཐིག་ཟེར་བ་ཞིག་ཡོད་སྙམ།",
    "གང་གི་མཐུ་ཡིས་ཡེ་ཤེས་མཐུ་གྲུབ་མཛོད།",
    "ཞེས་པ་ནིབུམ་པ་རྩོད་གཞིར་བཟུང་བ་རེད།",
    "རྩོད་གཞི་གཉིས་དོན་གཅིག་རེད།",
    "༢ཡིན་པར་ཐལ།",
    "ཡིན་པར་འགྱུར་ཞེས་པའམ་ཡིན་དགོས་པར་གྱུརཞེས་པའི་དོན་རེད།",
    "ཞེས་པའི་ཐལ་འགྱུར་འདི་ལ་མཚོན་ན།",
    "གསེར་ཡིན་པའི་ཕྱིར་ཞེས་པའི་ཐལ་འགྱུར་ལྟ་བུ་ལ་མཚོན་ན།",
    "ཞེས་མི་འདོད་པའི་ཐལ་བ་འཕངས་པ་ལྟ་བུའོ།",
    "སྤྱིར་ཐལ་ཞེས་པ་བརྒལ་བ་ལ་འཇུག་པ་དང་།",
    "༤མེད་པར་ཐལ།",
    "ཞེས་པའི་ཐལ་འགྱུར་ལྟ་བུ་ལ་མཚོན་ནརི་བོང་རྭ་མེད་པ་ཡིན་པར་འགྱུར་ཞེས་པ་ཡིན་ལ།",
    "ཞེས་པ་འདི་ཐལ་འགྱུར་ལྟར་སྣང་ཡིན་ཏེ།",
    "ལྟར་སྣང་ཞེས་པ་ནི་ཡང་དག་མ་ཡིན་པའི་དོན་རེད།",
    "ཐལ་སྦྱར་ས་དེ་གསལ་བ་དང་།",
    "ཐལ་འགྱུར་འདི་རྟགས་གསལ་རྩོད་གཞི་གསུམ་ག་ཚང་བའི་ཐལ་འགྱུར་རེད།",
    "ཐལ་འགྱུར་འདིའི་རྟགས་གྲུབ་སྟེ།",
    "ཞེས་པའི་ཐལ་འགྱུར་འདིའི་རྟགས་མ་གྲུབ་སྟེ།",
    "ཡོད་པ་ཡིན་པར་ཐལདངོས་པོ་ཡིན་པའི་ཕྱིར།",
    "དངོས་པོ་ཡིན་ན་ཡོད་པ་ཡིན་ཞེས་པ་ཐམས་ཅད་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་སོདེས་ན་སྔར་ཁྱབ་ཅེས་ཁས་བླངས་ནས་ཕྱིས་ཁས་ལེན་དེ་དོར་ནས།",
