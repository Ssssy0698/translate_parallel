    "དེས་ན་བོད་ཡིག་གི་ཆེད་མཁས་པ་ཚོས།",
    "ཡུལ་གྲུ་འགའ་རེའི་སྐད་རགས་རིམ་རེ་ཐོས་མ་ཐག་ནསའདི་ཁོ་ནའོ་ཞེས་ཁ་ཚོན་མི་གཅོད་པར་བོད་སྤྱི་འགྲོས་སྐད་ལ་བྱང་བར་བྱེད་པ་དང་།",
    "ཉི་མ་སྟོང་གི་འོད་འབར་བས།",
    "དཔྱོད་ལྡན་དག་གི་རྣ་བའི་དཔྱིད།",
    "འཕྲིན་ལས་ཉི་མ་སྟོང་གི་འོད།",
    "གསེར་ལྡན་བུ་མོའི་གོས་སུ་བཀླུབས།",
    "ཡབ་སྲས་གསུང་གི་ག་བུར་ཟེརཡོངས་སུ་སྤྲོས་པའི་བྱིན་མཐུ་ལསསྐྱེ་འགྲོའི་ཚ་གདུང་ཀུན་ནས་བསལ།",
    "ཕྱིས་སུ་རྗེ་བཙུན་འཇམ་པའི་དབྱངས་ཀྱི་ཞལ་དངོས་སུ་གཟིགས་ཏེ།",
    "དྲང་ངེས་སོགས་མཐའ་ཡས་པ་ཞིག་གི་དྲི་བ་མཛད་དོགས་པ་ཆོད་པའི་ཆེད་དུ་བརྒལ་ཞིང་བརྟག་པའི་སྒོ་ནས་དྲི་བ་ལ་སོགས་པ་གཙོ་བོར་མཛད་དོ།",
    "གང་གིའང་མིན་ཞེས་གསུངས་ཤིང་།",
    "སྔར་བསགས་ཀྱི་སྡིག་ལྟུང་སྦྱོང་ཞིང་ཚོགས་རྒྱ་ཆེན་པོ་གོང་ནས་གོང་དུ་སྤེལ་བའི་བསགས་སྦྱང་ལ་འབད་པ།",
    "ལམ་རིམ་ཆེ་ཆུང་གི་ལྷག་མཐོང་གི་སྐབས་སུ་ལྟ་བ་རྣམ་པར་དག་པ་གཏན་ལ་ཕབས་པས།",
    "ཧཱུཾ་ཧཱུཾ་དང་ཕཊ་ཕཊ་ཀྱིས་བསྐོར་ཟེར་བ་ནི་བདུད་ཀྱི་གཏམ་མོ།",
    "ནག་པོ་སྤྱོད་པ་སོགས་པཎ་གྲུབ་མང་བོས་ཞལ་གཟིགས་ཤིང་།",
    "དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་དང་དུས་ཀྱི་འཁོར་ལོ་སོགས་ཡི་དམ་དཔག་ཏུ་མེད་པའི་ཞལ་གཟིགས་ཤིང་གསུང་གིས་དབུགས་དབྱུང་།",
    "སྟག་ཚང་ལོ་ཙཱ་བའི་ཞལ་ནསཁྱོད་བློའི་ཉི་མ་གཞོན་ནུའི་དུས་ཀྱི་ཚེ།",
    "ལུང་རིགས་གཉིས་ཀ་ཡ་བྲལ་དུ་སོང་བས་བ་བསྟན་པ་འཛིན་པར་རློམ་པ་མང་བོ་བྱུང་བའི་སྐབས་སུ་ལུང་རིགས་གཉིས་ཀའི་སྒོ་ནས་བསྟན་པ་འཛིན་པའི་བསྟན་པའི་བདག་པོ་རྗེ་འདི་ཉིད་བྱུང་བ་ཡིན་ཏེ།",
    "རྫོགས་པར་ཉམས་སུ་ལེན་མཁས་ཁྱོད་ལ་འདུད།",
    "འགྲོ་ཐབས་མེད་པར་གཟིགས་པ་ཁྱོད་ལ་འདུད།",
    "ལ་ལ་སྤྱོད་པ་ཞིབ་མོས་ལྟ་བ་འགོག།",
    "དོན་དུ་ལྷག་པར་འདོམས་པ་ཁྱོད་ལ་འདུད།",
    "འཛིན་ཚུལ་གསལ་མཛད་ཁྱོད་ལ་གུས་པས་འདུད།",
    "གངས་ཅན་འདི་ན་བསྟན་འཛིན་མཐའ་དག་གིས།",
    "རྟག་ཏུ་བསྔགས་པར་འོས་པ་ཁྱོད་ལ་འདུད།",
    "དགུང་ལོ་རེ་གཅིག་པ་རབ་བྱུང་བཅུ་གཅིག་པའི་ས་རྟ།",
    "ཆབ་འབངས་རྣམས་དཔོན་མོ་ཨ་སྐྱོང་བཟའ་བདེ་སྒྲོན་དང་།",
    "དེ་ནས་རྒྱལ་ཁང་དུ་ཁོང་གི་དབུ་ཞྭ་དང་།",
    "ས་བརྟག་བསླང་སྦྱངས་པའི་སྐོར་ལྟོ་འཕྱེའི་ཐིག་གདབ་པ་སོགས་མཛད་ནས་ས་མིག་བརྐོ་བའི་སྐབས་མེ་ཏོག་གི་ཆར་བབས།",
    "གང་ལྟར་བླ་བྲང་དང་འདུ་ཁང་གི་རྨང་བཏིང་ཞིང་ཤིང་ཆ་སོགས་འདྲེན་རྒྱུའི་འགོ་བརྩམས་ཤིང་།",
    "ལོ་དེའི་ཟླ་བརྒྱད་པར་མ་དགོན་དུ་ཕེབས་རྔ་བའི་དགོན་གསར་དུ་འདུ་ཁང་དང་གྲ་ཤག་ཁ་ཤས་གྲུབ་འདུག་པ་ལ་གཟིགས་གཏོགས་མཛད་ནས།",
    "མི་བདག་གི་མཐར་ཐུག་གཏན་གྱི་སྐྱབས།",
    "མགོན་ཁྱོད་ཀྱིས་འབྲལ་མེད་སྐྱབས་མཛོད་ལ།",
    "མོས་གུས་དྲག་པོས་མཆི་མ་འཁྲུགས་པ་ཡུན་རིང་ཚོད་དཀའ་བ་བྱུང་ཞིང་།",
    "ན་མོ་མ་ཧ་མུ་དྲ་ཡལྷུན་གྲུབ་སྐུ་གསུམ་གྱི་གཞལ་ཡས་སུ།",
    "ངུར་སྨིག་གི་གར་གྱིས་འགྲོ་ཀུན་འདྲེན།",
    "མཆོག་མྱུར་དུ་ཐོབ་པར་བྱིན་གྱིས་རློབསསྙན་བརྒྱུད་ཀྱི་གདམས་པའི་མན་ངག་གིས།",
    "འཆད་རྩོད་དང་རྩོམ་པའི་མན་ངག་གིས།",
    "མ་འགྲོ་ཀུན་སྒྲོལ་བའི་ཁུར་ཁྱེར་ནསལམ་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི།",
    "འཕྲིན་ལས་ས་ཆེན་ཁྱབ་མཛད་ཁྲི་ཆེན་མཆོག་ཡབ་སྲས་ཟུང་གི་འཕྲིན་ལས་ཉི་མ་ཆེ།",
    "ཡིད་བཞིན་འཁོར་ལོ་རྗེ་བཙུན་ཏཱ་རེ་མ།",
    "ཡབ་སྲས་འབྲེལ་བའི་ལང་ཚོ་རབ་རྒྱས་ཏེ།",
    "བློ་གྲོས་བཟང་བོས་ཤེས་བྱའི་གནས་ཀུན་གཟིགས།",
    "ངན་སོང་གི་སྡུག་བསྔལ་དྲན་པ་དང་།",
    "ཉམ་ཐག་རྣམས་རང་གི་མར་ཤེས་ནས།",
    "གང་དེའི་ཤིས་པ་འབུམ་གྱིས་ཁྱོད་ལ་སྲུངས།",
    "ཇི་བཞིན་ཁྱོད་ཞལ་འགྱུར་མེད་ཞབས་བརྟན་ཤོག།",
    "རྒྱལ་བསྟན་པད་མོའི་འཛུམ་ཞལ་མངོན་གྱུར་ཏེ།",
    "ལྟེ་བའི་གཞོན་ནུ་དམར་མོས་སྤྱི་བོ་ཡི།",
    "ཧཾ་ཡིག་བ་མོ་བཞུས་པ་དྷུ་ཏཱིའི་དབུསའཁྱིལ་ལས་ཚེ་སྲོག་རྡོ་རྗེའི་གཤིས་གྱུར་པ།",
    "ཚེ་དཔག་མེད་བཞིན་ཁྱོད་ཞབས་རྟག་བརྟན་ཤོག།",
    "ཁྱོད་ཞབས་བསྐལ་བ་རྒྱ་མཚོར་བརྟན་བཞུགས་ནས།",
    "མཛད་མཆོག་གསུང་གི་བདུད་རྩིའི་གྲུ་ཆར་གྱིསསྙིགས་དུས་སྐྱེ་འགྲོའི་ཤེས་རྒྱུད་བརླན་པར་མཛོད།",
    "ཁྱོད་ཞབས་བརྟན་ཅིང་མཛད་འཕྲིན་རབ་རྒྱས་ཤོག།",
    "འོད་སྣང་འབུམ་གྱིས་རྒྱལ་བསྟན་པད་མོའི་ཚལ།",
    "ཕྱོགས་ཀྱི་བུ་མོ་མཛེས་པའི་རྒྱན་གྱུར་ནས།",
    "རབ་དཀར་འཕྲིན་ལས་ལྷ་མོས་དགེ་ལེགས་སྩོལ།",
    "འཆི་བདག་བདུད་ལས་རྣམ་རྒྱལ་ལྷ་མོ་དང་།",
    "འགྲོ་རྣམས་བདུད་བཞི་ལས་སྒྲོལ་ཏཱ་རེ་མའི།",
    "ལྷག་མེད་ཞི་ནས་དགེ་མཚན་འབུམ་ཕྲག་གི་སྣང་བའི་འོད་ཀྱིས་ས་ཆེན་ཀུན་ཁྱབ་པའི།",
    "མྱུར་མ་དཔའ་མོ་ཡིས་བུ་བཞིན་དུ་དགོངས་ལ།",
    "སྐྱེ་དགུའི་རེ་འདོད་མྱུར་སྐོང་གི་ནོར་བུ།",
    "མྱུར་མ་དཔའ་མོ་ཡིས་བུ་བཞིན་དུ་དགོངས་ལ།",
    "ལྷག་བསམ་བརྟན་པོའི་གསེར་བཟང་གི་ཡུ་བར།",
    "དད་གུས་ཤམ་བུ་གཡོ་བ་ཡི་རྩེ་མོར།",
    "རྒྱལ་ཀུན་ཟག་མེད་བདེ་སྟེར་གྱི་བཙུན་མོ།",
    "མྱུར་མ་དཔའ་མོ་ཡིས་བུ་བཞིན་དུ་དགོངས་ལ།",
    "སྲིད་ལས་ངེས་འབྱུང་གོས་བཟང་གིས་བརྒྱན་ཅིང་།",
    "ངེས་དོན་བདེ་སྟོང་ཟུང་འཇུག་གི་རྒྱལ་བོའི།",
    "མྱུར་མ་དཔའ་མོ་ཡིས་བུ་བཞིན་དུ་དགོངས་ལ།",
    "མྱུར་མ་དཔའ་མོ་ཡིས་བུ་བཞིན་དུ་དགོངས་ལ།",
    "ཐལ་ཀར་ལག་ལྡན་རིན་ཆེན་དུ་མཛོད་ཅིག།",
    "མྱུར་མ་དཔའ་མོ་ཡིས་བུ་བཞིན་དུ་དགོངས་ལ།",
    "ཤེས་བྱའི་ཁྱོན་ཡངས་ཡིད་ཙམ་གྱིས་བགྲོད་དེ།",
    "བདེ་ཆེན་རྒྱལ་བོའི་མངག་གཞུག་གི་འཁོར་ལོསབདུད་དཔུང་ལྷག་མེད་དུ་གཞོམ་པ་ཡི་དཔའ་བོ།",
    "མྱུར་མ་དཔའ་མོ་ཡིས་བུ་བཞིན་དུ་དགོངས་ལ།",
    "བློ་གྲོས་འོད་ཀྱིས་གནས་ལྔ་རིག་པའི་པད་མོའི་ཁ་ཕྱེས་ཏེ།",
    "རྒྱལ་བསྟན་ལུང་རྟོགས་པད་མོའི་ཚལ།",
    "ཤིང་གི་དཔར་གྱི་འཕྲུལ་འདེགས་འདི།",
    "གློག་འཕྲུལ་ཟབ་མོའི་ཐབས་མཁས་ལས།",
    "འགྱུར་རོ་ཅོག་གི་དཔར་ཆེན་བསྐྲུན།",
    "ལུང་རྟོགས་ཟུང་གིས་བསྡུས་པ་རྙེད་བཀུར་བཅས།",
    "ཕན་ཡོན་བདེན་པའི་གསུང་གིས་བཀའ་བསྩལ་བཞིན།",
    "ལམ་ཁྲིད་འཇམ་དཔལ་ཞལ་ལུང་གིབརྒྱུད་འདེབས་ཁ་སྐོང་། ། ལམ་ཁྲིད་འཇམ་དཔལ་ཞལ་ལུང་གི་བརྒྱུད་འདེབས་ཁ་སྐོང་ནི།",
    "ཤེས་བྱ་ཀུན་གཟིགས་ཡེ་ཤེས་བསྟན་སྒྲོན་ཞབས།",
    "གཅིག་བསྡུས་བློ་བཟང་བསྟན་པའི་ས་ཆེན་ཁྱོན།",
    "སྐུལ་བཟང་ཐར་འདོད་ཡོངས་ཀྱི་གཙུག་གི་རྒྱན།",
    "ཐུབ་བསྟན་པད་ཚལ་བཞད་པའི་ཉིན་མོར་བྱེད།",
    "འཇམ་དཔལ་དབྱངས་ཀྱི་ཡེ་ཤེས་པད་མོའི།",
    "འགྲོ་བའི་ཞལགཉེན་གྱུར་ཉིན་མོའི་མགོན་པོ་དེས།",
    "ཅེས་པ་འདི་ནི་སྐྱབས་མགོན་ཐམས་ཅད་མཁྱེན་གཟིགས་མཆོག་ཁྲོ་གོ་ཆུ་ཁ་མར་ཞལ་བསྒྱུར་གནང་སྐབས་དགེ་སློང་བསྟན་པ་དར་རྒྱས་རང་གིས་ཁོང་ལ་ཚེ་རབས་རྗེས་འའཛིན་གྱི་སྨོན་ཚིག་ཅིག་དགོས་ཞེས་གསོལ་བ་བཏབ་པར།",
    "གཅིག་བསྡུས་བློ་བཟང་བསྟན་པའི་ས་ཆེན་ཁྱོན།",
    "ཐུབ་བསྟན་པད་ཚལ་བཞད་པའི་ཉིན་མོར་བྱེད།",
    "མོས་གུས་དྲག་པོའི་ངང་ནས་འདོན་པའམཐུབ་པའི་དབབང་བོ་ལྟ་བུ་གཅིག་གསལ་བཏབ་སྟེ།",
    "ཐམས་ཅད་ཐམས་ཅད་ཁྱོད་ལ་འདུད།",
    "ཡེ་ཤེས་སྐུ་ཉིད་ཁྱོད་ལ་འདུད།",
    "ཞེས་པའི་མན་ངག་གི་འདོན་ཚུལ་ཡིན་པར་ཡང་དེ་ཉིད་ཀྱིས་གསུངས་སོ།",
    "ཞེས་གུང་ཐང་འཇམ་པའི་དབྱངས་ཀྱི་གསུང་དུ་འབྱུང་ལདེའི་མཇུག་དེ་མ་ཐག་ཏུ་སྔགས་ལུགས་ཐུན་མོང་མ་ཡིན་པའི་འདོན་ཚུལ་ཡང་གསུངས་འདུག་དེའི་ལག་ལེན་ནིཆོ་ག་འདོན་པ་དང་གཞུང་ཀློག་པ་སོགས་ཀྱི་ཐོག་མར།",
    "ཞེས་པ་འདིའང་གཞན་ལ་ཕན་དུ་རེ་ནས་བྲིས་པའོ།",
    "ཨོཾ་སྭ་སྟིཁམས་གསུམ་དམུ་རྒོད་འགྲོ་བ་མཐའ་དག་གིས།",
    "ཉམས་ལེན་བྱ་ཚུལ་རང་བློའི་བཅུད་ཐིགས། ། ན་མོ་གུ་རུ་བྷྱ།",
    "འདིར་ཁྱོད་ཀྱིས་དྲིས་པའི་ལན་རགས་རིམ་ཞིག་བརྗོད་ན།",
    "མཐོང་ནས་སྲོག་གི་ཕྱིར་ཡང་མི་གཏོང་བར།",
    "མན་ངག་ཕྲ་མོ་ཡན་ཆད་སློབ་པའི་རྣམ་པ་སྣ་ཚོགས་ཤིག་སྤྲུལ་བ་ཡིན།",
    "ཐ་མལ་བའི་རང་རེའི་སྣང་ངོར་ཐ་མལ་བའི་རྣམ་པ་བཟུང་ཡོད་སྟབསསྣང་བ་དེ་ལོག་ནས།",
    "གང་ལྟར་ཡང་ལམ་རིམ་ལྟར་བཤེས་གཉེན་བསྟེན་ཚུལ་ལ་དད་པ་དང་མོས་གུས་སྦྱངས་པ་གལ་ཆེ།",
    "མོས་གུས་ཀྱི་ཉི་མ་མ་ཤར་ན།",
    "ཡིད་མོས་གུས་འདི་ལ་གཟབ་པར་འཚལ།"
