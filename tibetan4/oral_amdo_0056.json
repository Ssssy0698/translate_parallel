    "འདོད་ན་རྟེན་དེས་བརྟེན་པའི་དངོས་པོ་ལ་གནས་པ་ཅི་ཞིག་ཀྱང་མ་བྱས་པར་འགྱུར་ཏེ་གནས་པ་དོན་གཞན་བྱས་པའི་ཕྱིར་རོ་། གཉིས་པ་ལ་གཉིས་ལས་དང་པོ་ཐལ་བ་དགོད་པ་ནི།",
    "བློ་དེ་གཏན་འཇིག་པ་མེད་པར་ཐལ་ཏེ།",
    "འཇིག་རྒྱུ་དེ་ལ་ཡང་གནས་པ་དེ་ཉིད་དང་གཞན་དུ་བརྟགས་པའི་ཐལ་བ་མཚུངས་པར་འབྱུང་སྟེ།",
    "འདི་ལྟར་པའི་དེས་འཇིག་པ་དངོས་པོ་དེ་ཉིད་དུ་སྐྱེད་ན་མི་དགོས་ཏེ་རང་གི་རྒྱུ་ལས་གྲུབ་པས་སོ།",
    "འདོད་ན་དངོས་པོའི་རང་བཞིན་འདི་ལ་རྟེན་ལ་སོགས་པ་གང་གིས་ཀྱང་གནོད་པ་མེད་པའི་ཕྱིར་གནས་པའི་རྒྱུས་ནི་འཇིག་བྱེད་ཀྱི་རྒྱུ་དང་མཛོད་མ་ཕྲད་ཀྱི་བར་དུ་ཡང་གནས་པས་ཅི་ཞིག་བྱས།",
    "ཆུ་ལ་སོགས་པའི་རྟེན་དུ་བརྗོད་པ་ཡིན་ཏེ་ཆུ་ལ་འསོགས་པའི་དངོས་པོ་རྣམས་སྐད་ཅིག་རེ་རེར་ཡུལ་གཞན་དུ་འཕོ་ཞིང་འཇིག་པ་ན་སྣོད་དང་ཕྲད་པའི་སྟོབས་ཀྱིས་དངོས་པོའི་རྒྱུན་རྟེན་གྱི་ཡུལ་དུ་གནས་པ་དེ་ལྟ་བུར་སྐྱེ་བའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་གིས་ཞེ་ན་རྟེན་དང་བརྟེན་པ་འགོག་པའི་རིགས་པ་འདིས་ནིའོ།",
    "དུས་འགའ་ཞིག་གི་ཚེ་ནའང་འཇིག་པར་མི་འགྱུར་ཏེ།",
    "གསུམ་པ་རང་གི་ངང་གིས་འཇིག་མི་རིགས་འཇིག་གཉིས་ཀ་ལ་རྟེན་དགོས་ནུས་མེད་པ་ནི།",
    "བློའི་ཉེར་ལེན་ཅན་ཡིན་ཏེ་བློ་སྟེ་ཡིད་ཀྱི་གོམས་པ་ཆེ་ཆུང་གི་ཁྱད་པར་གྱིས་དེ་དག་ཕུལ་དུ་བྱུང་བ་དང་འགྲིབ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཡོད་ན་མར་མེ་ལ་བརྟེན་པའི་འོད་ཀྱང་མར་མེ་ལས་གཞན་གྱི་རྗེས་སུ་བྱེད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེ་དག་གི་དཔེ་བསྟན་པའོ།",
    "ལུས་ལས་དུས་ཐམས་ཅད་ཀྱི་ཚེ་ཆགས་སོགས་འཕེལ་ལམ་ཞེ་ན་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པ་ཡོད་པའི་དུས་འགའ་ཞིག་གི་ཚེ་ནའོ།",
    "བདེ་སྡུག་གཉིས་པོ་དེ་ཡང་ནང་སྟེ་ལུས་ལ་ཡོད་པའི་དོན་རེག་བྱའི་ཁྱད་པར་ལས་སྐྱེས་པའོ།",
    "ནང་གི་དོན་གང་ཞེ་ན་ཁམས་སྙོམས་པའི་རྣམ་པ་དང་མ་སྙོམས་པའོ།",
    "དེ་དག་ཇི་ལྟར་འདུས་བྱས་ཞེ་ན་རང་རང་གི་བྱ་བ་ཇི་ལྟ་བ་བཞིན་དུ་སེམས་ལ་བརྟེན་ནས་གོམས་པར་བྱས་པའོ།",
    "དམན་པའི་གནས་སུ་མི་འཇུག་པར་ཐལ་བ་སྤང་བ་དང་།",
    "གང་ཞེ་ན་ཁྱི་དང་ཕག་གི་མངལ་ལ་སོགས་པ་དམན་པའི་གནས་སོ།",
    "མི་འགལ་མཛོད་ཏེ་དེ་དག་གིས་དམན་པར་མ་ཤེས་པའི་ཕྱིར་སྦྲང་བུ་བཞིན་ཞེས་པ་ནི་མངལ་ལ་སོགས་པ་སྡུག་བསྔལ་ཡིན་ཡང་ཕྱིན་ཅི་ལོག་ཏུ་དེ་ལ་བདེ་བར་འཛིན་པའི་བློ་ཡོད་པའི་ཕྱིར་རོ།",
    "ལུས་ཀྱི་ཆ་ཤས་ལག་སོགས་གང་རུང་འུ་ཡུག་གཅིག་གཡོ་བའི་དུས་ན་རྐང་པ་ལ་སོགས་པ་ལུས་ཐམས་ཅད་གཡོ་བར་ཐལ་ཏེ་གཡོ་བ་དེ་དང་ཐ་དད་མེད་པའི་ཕྱིར་རོ།",
    "ཡང་ན་ཀུན་མི་གཡོ་བར་ཐལ་ཏེ་མི་གཡོ་བ་དང་ཐ་དད་མེད་པས་སོ།",
    "འདི་དག་གི་ཁྱབ་སྒྲུབ་དང་ཉེས་སྤོང་གི་ལན་དགག་པ་ནི་བྱ་བ་ལ་བརྟེན་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཐལ་བའི་རྟགས་གཉིས་མ་གྲུབ་པ་དང་།",
    "མཐོང་བ་ལ་སོགས་པ་ལ་ཡན་ལག་ཅན་གཅིག་དགོས་ན་ཧ་ཅང་ཐལ་བའོ།",
    "རྡུལ་ཕྲན་ཡིན་པའི་ཕྱིར་ཚད་ལུས་འདི་ལ་སྒྲིབ་བྱེད་མེད་པ་དང་སོགས་པ་སྟེ་ཐོགས་པ་མེད་པ་དང་དོན་བྱེད་པའི་ནུས་པ་མེད་པར་ཐལ་ཞེས་པ་ལ་སོགས་པ་བསལ་བ་ཡིན་ནོ།",
    "རྫས་གཅིག་མེད་པས་མི་སྣང་ན་ཧ་ཅང་ཐལ་བ་དང་།",
    "རྫས་གཅིག་མེད་པས་མ་ནུས་པ་མེད་ན་ཧ་ཅང་ཐལ་བ་དང་།",
    "དེ་དག་གི་ལན་དགག་པའོ།",
    "རྡོ་ཚན་མོ་ལ་སོགས་པ་མི་སྣང་བར་ཐལ་ཏེ་རྡུལ་རིགས་མི་མཐུན་པས་རྫས་མི་རྩོམ་པ་ཉིད་ཀྱིས་དེ་དག་ལ་རྫས་མེད་པའི་ཕྱིར་རོ།",
    "རྐྱང་པ་དང་ཚོགས་པ་གཉིས་ཀ་ལ་ནུས་པ་མེད་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་སྦྱར་བའི་བཏུང་བ་ལ་སོགས་པ་མི་སྲིད་པར་ཐལ་བ་ནི།",
    "གསུམ་པ་ཕྲེང་རིང་པོའི་ཐ་སྙད་མི་སྲིད་པར་ཐལ་བ།",
    "ཇི་ལྟར་ཞེ་ན་གྲངས་ལ་སོགས་པ་དེ་དང་ལྡན་པ་རང་གི་ངོ་བོ་དང་གཅིག་དང་གཉིས་ལ་སོགས་པའི་རྗོད་པ་དག་ལས་ཐ་དད་པར་མི་སྣང་བའོ།",
    "གང་གིས་ཞེ་ན་རྣམ་རྟོག་གིས་སོ།",
    "གཉིས་པ་ལ་གཉིས་ལས་དང་པོ་སྒྲ་ཐམས་ཅད་བཏགས་པ་བར་ཐལ་བ་ནི།",
    "དངོས་མིང་མི་སྲིད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་ན་དེ་ལྟར་རིགས་པས་མ་གྲུབ་པའི་ཕྱིར་དང་འཇིག་རྟེན་ནའང་དངོས་མིང་དང་བཏགས་མིང་གི་ཁྱད་པར་གཞན་དུ་འདོད་པའི་ཕྱིར་རོ།",
    "སྒྲ་ཐ་དད་དོན་མེད་དུ་ཐལ་བ་སྤང་བ་དང་།",
    "དྲུག་པའི་སྒྲ་མི་འཐད་པར་ཐལ་བ་སྤང་བའོ།",
    "དོན་མེད་ན་ཞེས་པ་རྣམ་གྲངས་པར་ཐལ་ཞེས་པའོ།",
    "དང་པོ་ཡོན་ཏན་གྱི་གྲངས་ཀྱིས་མ་ངེས་པ་ནི་དོན་གཞན་ཞེས་པ་རྐང་པ་གསུམ་མོ།",
    "གཉིས་པ་དེ་དག་ཀྱང་ཐ་དད་དུ་འདོད་ན་ཧ་ཅང་ཐལ་བ་ནི།",
    "གང་གིས་ཞེ་ན།",
    "དཔེར་ན་སྐབས་ལ་ལར་སོར་མོ་དང་ལྡན་པ་ལ་ཐ་དད་མེད་ཀྱང་སོར་མོའི་ལྡན་པ་ཞེས་བརྗོད་པ་བཞིན་ནོ།",
    "དཔེར་ན་སོར་མོ་ལྡན་གྱུར་ཅེས་བརྗོད་པ་བཞིན་ནོ།",
    "རིགས་ཀྱི་སྒྲ་ཡང་ཚོགས་པའི་སྒྲའི་ཡུལ་སྤངས་ནས་འཇུག་པ་དེས་ན་ཚོགས་པའི་སྒྲ་བུམ་པ་ཞེས་པ་དང་རིགས་ཀྱི་སྒྲ་བུམ་པའི་གཟུགས་ཞེས་པ་རྣམ་འགྲེལ་གཉིས་གཞི་གཅིག་པ་ཅན་གྱི་སྒྲ་མ་ཡིན་ནོ།",
    "ཚོགས་པ་དང་ཚོགས་པ་ཅན་རྗོད་པ་ལ་རིགས་དང་ཚོགས་པའི་སྒྲར་བསྟན་པ་དེས་ན་བུམ་པ་ཞེས་པའི་སྒྲ་འདི་ནི་རིགས་བརྗོད་པའི་ཁྱད་པར་རིགས་ཀྱང་ཡིན་ཏེ་བུམ་པ་དུ་མའི་ནང་ནས་གསེར་གྱི་བུམ་པ་ཞེས་བརྗོད་པ་བཞིན།",
    "རིགས་དང་ཚོགས་པ་གཉིས་ཀ་མི་བརྗོད་པའི་སྒྲ་མི་སྲིད་པས་མུ་བཞི་པ་མེད་དོ།",
    "གང་གིས་ཞེ་ན་བུམ་པ་དེའི་སྤྱི་ཡན་ལག་གམ་ཁྱད་པར་དུ་བྱས་ཏེ་བུམ་པའི་གཟུགས་བུམ་པའི་དྲི་ཞེས་པ་ལ་སོགས་པའི་སྒྲ་ཡིས་སོ།",
    "རེ་རེ་རྒྱུ་ཡིན་པ་དགག་པའོ།",
    "ཐལ་བ་དགོད་པ་དང་།",
    "གཅིག་གིས་གཅིག་བསྐྱེད་པ་དགག་པའོ།",
    "དང་པོ་ལ་གཉིས་ལས་དང་པོ་ཐལ་བ་དགོད་པ་ནི།",
    "གཉིས་པ་། ལ་གཉིས་ལས་དང་པོ་ཐལ་བ་དགོད་པ་ནི།",
    "གལ་ཏེ་དོན་སྔ་ཕྱི་དུ་མ་ཡང་བློ་གཅིག་གིས་རིམ་གྱིས་ཤེས་པ་ཡིན་ནོ་ཞེ་ན།",
    "དབུགས་རང་གི་རིགས་མིན་པ་སྟེ་ལུས་ལས་སྐྱེ་འུ་ཡུག་བར་འདོད་པའོ།",
    "དབུགས་ཀྱི་རྒྱུ་ལུས་མིན་གྱི་དབུགས་རང་གི་རིགས་སྔ་མ་རྒྱུ་ཉིད་ཡིན་ཞེ་ན།",
    "མ་ངེས་པ་མིན་ཏེ་འབྲས་བུར་འདོད་པ་གང་ཞིག་རྒྱུར་འདོད་པ་གང་གི་ཐ་དད་པ་ལས་ཐ་དད་དུ་འགྱུར་བ་མིན་པ་དེ་ནི་རྒྱུར་འདོད་པ་དེའི་འབྲས་བུ་མིན་ཏེ་མེ་དང་མྱུ་གུ་གཅིག་བཞིན་ཡིད་ཀྱང་དབུགས་དྲག་ཞན་གྱི་རྗེས་སུ་མི་བྱེད་ན་དེའི་འབྲས་བུར་མི་འགྱུར་རོ།",
    "སྔམ་གཅིག་ནི་ཕྱི་མ་གཅིག་གི་ཉེར་ལེན་གྱི་རྒྱུ་ཡིན་ཏེ་རེ་རེ་སྐྱེད་པ་ལ་ནུས་པ་ངེས་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་ལུས་ལས་བློ་དུ་མ་ཅིག་ཅར་སྐྱེས་ཤིང་ཕྱིས་རང་འུ་ཡུག་རིགས་ལས་རེ་རེར་ངེས་པ་དགག་པ་ནི།",
    "གལ་ཏེ་མངལ་ལ་སོགས་པར་འཇུག་པའི་ཚེ་དང་པོ་ལུས་ལས་བློ་དུ་མ་ཅིག་ཅར་དུ་སྐྱེ་ཞིང་དུས་ཕྱིས་བློ་རང་གི་རིགས་སྔ་མ་ལས་བློ་རེ་རེ་སྐྱེ་བར་ངེས་པ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་དེའི་ཞེས་པ་སྟེ་སེམས་ཀྱི་རྒྱུན་ལུས་ལ་གནས་པའི་ཉེར་ལེན་གྱི་རྒྱུ་སེམས་སྔ་མ་དེ་འཆི་ཀའི་ལུས་ཀྱིས་ལུས་ཕྱི་མ་སྐྱེད་པའི་ཡན་ལག་གམ་རྐྱེན་དུ་མི་འགྱུར་ན་ཤི་བའི་མཛོད་འོག་ཏུ་སེམས་འབའ་ཞིག་གནས་པར་ཐལ་བར་འདོད་དེ་གཟུགས་མེད་ཀྱི་སེམས་བཞིན་ནོ།",
    "ཁ་ཅིག་ན་རེ་འཆི་ཀའི་ལུས་སེམས་གཉིས་ཕྱི་མའི་ལུས་སེམས་གཉིས་ཀྱི་རྒྱུ་རྐྱེན་དུ་མི་འཐད་དེ་དེ་དག་ལས་ཕྱི་སོ་གཉིས་མའི་ལུས་སེམས་སྐྱེ་བ་མ་དམིགས་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དུས་གཞན་གྱི་རྗེས་དཔག་གིས་གྲུབ་པ་དང་དེ་ལའང་རྒྱུ་གཞན་རྟོག་པ་དགག་པའོ།",
    "གཉིས་པ་ལྟར་ན་སྔ་མ་སྟེ་ལུས་སམ་དབུགས་ལ་སེམས་སྐྱེ་བར་འདོད་པ་ལ་བཀོད་པ་བཞིན་དུ་ཐལ་བར་འགྱུར་ཏེ་སྐྲ་སེན་གྱི་རྩེ་མོ་དང་།",
    "གསུམ་པ་དེ་དག་གི་དོན་བསྡུ་བ་ནི།",
    "གང་གིས་མི་འགྲུབ་ཅེ་ན་སེམས་ཀྱི་རྒྱུ་ལུས་དང་བྲལ་བའི་ཕྱིར་ཞེས་པའི་རྟགས་ཀྱིས་སོ།",
    "དེ་དག་གིས་འཇིག་རྟེན་ཕ་རོལ་སྒྲུབ་པའི་རྟགས་བབསྟན་པ་ཡིན་ནོ།",
    "གང་གིས་མ་ངེས་ཞེ་ན་མཆོངས་དང་ཞེས་པ་སྟེ་མཆོངས་པ་ཁྱད་པར་དུ་འགྱུར་ཡང་མཐའ་མེད་པར་མཆོངས་མི་ནུས་པ་དང་ཆུ་སྲོས་པའི་ཚེ་དྲོད་ཁྱད་པར་དུ་འགྱུར་ཡང་མཐར་མེའི་རང་བཞིན་དུ་མི་འགྱུར་བ་བཞིན་ཞེ་ན།",
    "གཉིས་པ་མཆོངས་པ་ནི་ཡང་རྩོལ་བ་ལ་ལྟོས་པ་ཡིན་ཏེ་མཆོངས་པ་སྔ་མ་དེ་ལ་ཕན་འདོགས་པར་ནུས་པའི་ལུས་ཀྱི་རྩོལ་བ་རྣམས་ལ་མཆོངས་པའི་ཁྱད་པར་ཕྱི་མ་དག་འགྲེལ་རང་གི་ངང་གིས་འཇུག་པའི་རང་བཞིན་དུ་སྒྲུབ་པའི་ནུས་པ་མེད་པའི་ཕྱིར་ཏེ་ནས་ལ་སཱ་ལུའི་མྱུ་གུ་སྐྱེད་པའི་ནུས་པ་མེད་པ་བཞིན་ནོ།",
    "དེས་ན་མཆོངས་པ་རེ་རེ་ལ་རྩོལ་བ་རེ་དགོས་པས་མཐར་ཐུག་པར་མི་འཕེལ་བ་ཡིན་ནོ།",
    "ཐོག་མའི་དུས་གང་གི་ཚེ་མཆོངས་པ་དང་ཆུ་སྲོས་པ་ལ་རྩོལ་བ་བྱས་པར་གྱུར་པ་དེ་ལས་ཡང་རྩོལ་བ་ཕྱི་མ་ལ་ལྟོས་པར་མི་འགྱུར་བར་རང་གི་ངང་གིས་འཇུག་ན་རྩོལ་བ་གཞན་ཕྱི་མ་དང་ཕྱི་མ་རྣམས་ཀྱི་ཁྱད་པར་མཐར་ཐུག་པ་འཕེལ་བར་བྱེད་པ་ཡིན་ནོ།",
    "གོམས་པ་ཇི་ལྟ་བུ་ཞེ་ན་རང་གི་རང་གིས་འཇུག་པ་སྟེ་ཡང་རྩོལ་བ་ལ་མི་ལྟོས་པར་འཕེལ་བའོ།",
    "དཔེར་ན་ཀླུ་མེས་ཤིང་སྲེག་པ་ནི་འགལ་རྐྱེན་མེད་ན་ཐལ་བར་སོང་གི་བར་དུ་ངང་གིས་འཇུག་པ་དང་།",
    "དངུལ་ཆུ་གདུལ་བ་དང་སྦྱང་བ་ལེགས་པ་ནི་གསེར་ལ་ངང་གིས་འཇུག་པ་བཞིན་ནོ།",
    "བར་ཆད་མ་མེད་པར་གོམས་པར་གྱུར་ན་ཚད་ངེས་པ་གང་ལ་གནས་ཏེ་གནས་པར་མི་འགྱུར་ཏེ་གང་གི་ཕྱིར་ཞེ་ན་ཉེར་ལེན་རིགས་མཐུན་པའི་ས་བོན་སྔ་མ་ལས་འཕེལ་བ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "མཆོངས་པ་དེའི་རྒྱུ་ནི་དང་པོ་ནས་ཡོད་པའི་ལུས་ཀྱི་སྟོབས་དང་འཕྲལ་གྱི་རྩོལ་བ་དག་ཡིན་པས་དེ་དག་གི་འབྲས་བུ་རིགས་མཆོངས་པ་ནི་ཆད་ངེས་པའི་བདག་ཉིད་ཡིན་ནོ།",
    "གཉིས་པ་དེ་ལ་ཧ་ཅང་ཐལ་བ་སྤང་བ་ནི།",
