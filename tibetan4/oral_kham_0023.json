    "གཉིས་ལས་གང་བྱས་ཀྱང་འགལ་བ་མི་འདུག་ཅིང་འོན་ཀྱང་།",
    "ལྷོ་ཕྱོགས་གདའོ།",
    "ཞེས་གདུང་ཤུགས་དྲག་པོའི་གསོལ་བ་གདའ་བརྟན་བཞུགས་བྱ་བ་ནི།",
    "དུརང་ཉིད་སྟན་བདེ་བར་འདུག་སྟེ།",
    "ཚོགས་ཞིང་རང་གནས་སུ་གཤེགས་བར་གྱུར།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱིསུ་མ་ཏི་ཀཱིརྟི་ཤྲཱི་བྷ་དྲ་ཨདྷིཥྛ་ན་ཨདྷིཥྛ་ཏེ་ཀུཅནྟུ།",
    "ལུས་ལ་ཁབ་རྩེ་དང་ཚེར་མ་ཟུག་པ་ཙམ་ལ་ཡང་དོགས་ཟོན་ཆེར་བྱེད་པར་འདུག་ན།",
    "ཆ་དྲུག་ལ་ནི་འབུམ་ཕྲག་གཉིས་གཉིས་སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྦྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "ཚངས་དང་ཁྱབ་འཇུག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རྒྱལ་པོ་ལོ་ནི་མཐའ་དག་རྗེས་སུ་ཉིན་ཞག་དུས་སྦྱོར་ཆུ་ཚོད་དག་དང་ཆུ་ཡི་སྲང་རྣམས་ཏེ།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད།",
    "དེ་ལྟར་གཟའ་རྣམས་ཀྱི་ནི་རྒྱུ་བ་མཐའ་དག་དུས་ཀྱི་འཁོར་ལོ་དག་ལས་ཤིན་ཏུ་ངེས་པར་འགྱུར།",
    "དཀར་པོའི་མདའ་དང་ཆུ་གཏེར་ཟླ་བ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར།",
    "གང་ཞིག་མ་སྤྱད་ཕྱེད་ཀྱི་ཆུ་ཚོད་དེ་ནི་དུས་ཀྱི་ཉིན་ཞག་དུས་ལ་ཆ་དམན་ཟླ་བ་སྟེ།",
    "དེ་ལ་ཡུད་ཙམ་སུམ་ཅུ་རྣམས་དང་ཉིན་ཞག་དུས་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ན་སྟེ།",
    "ཡང་དག་དུས་སྦྱོར་ཐམས་ཅད་ཀྱིས་ཏེ་སླར་ཡང་གལ་ཏེ་རང་ལུས་གཡོན་གྱི་རྩ་ལས་གྱུར་པ་ན།",
    "རང་རང་ཡི་གེས་ཤེས་བྱ་རྣམ་གསུམ་ཁྱབ་བདག་བགྲོད་པ་རྣལ་འབྱོར་པ་ཡིས་སྟོང་པའི་དབྱེ་བས་སོ།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཇི་ལྟར་འགྲོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཡིས།",
    "ངེས་པར་འཇམ་པའི་མལ་སྟན་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་བསྲུང་བ་བྱས་ནས་ནི།",
    "ཕྱི་ནས་ཤེས་རབ་ལ་སོགས་དྲུག་ནི་རབ་ཏུ་གསལ་བར་བདག་པོར་ང་རང་པདྨའི་གདན་ལའོ།",
    "གདེངས་ཅན་རིགས་དང་བཅས་པ་རང་རང་ཕྱོགས་ཀྱི་བཞོན་པར་གནས་པའི་ལྷ་རྣམས་རྡོ་རྗེ་གདན་གྱིས་གནས།",
    "ཀྃ་ང་ཁྱབ་འཇུག་དུས་ཏེ་འཕྲོག་བྱེད་ཅེས་དང་ནོར་སྦྱིན་དག་ཀྱང་སྃ་དང་འདིར་ནི་ྐ་ཉིད་དོ།",
    "ཧཱུྃ་ཡིག་ཡེ་ཤེས་ལས་སྐྱེས་འཇིག་དུས་སྤྲིན་དང་མཚུངས་པ་རྩེ་ལྔ་འོད་ཟེར་དང་བཅས་དགོད་པར་བྱ།",
    "སྔགས་ཀྱིས་དགུག་པར་རབ་ཏུ་འགྱུར་ཏེ་གདོན་གྱི་ཚོགས་པ་མཐའ་དག་དུས་ཀྱི་སོས་ཟིན་རྗོད་པར་བྱེད།",
    "གཡས་པ་བརྐྱང་ཞིང་རང་རང་སྣོད་རྣམས་ཀྱིས་ནི་ལྷ་མིན་ཁྲག་འཐུང་སྐྲ་གྲོལ་གོས་དང་བྲལ་བ་སྟེ།",
    "སྣ་ཚོགས་དངོས་རྣམས་ཀྱིས་བྱེ་རྒྱལ་བ་དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཉིས་འགྱུར་མི་བདག་གཞན་རྣམས་ཚེས་ནི་བརྒྱད་གཉིས་དབྱེ་བ་ལ།",
    "རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྐང་པ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ།",
    "དེ་ཡི་དུས་སུ་རྒྱལ་པོའི་འགྲོ་བ་དག་ནི་རང་རང་ཚད་ཀྱིས་རྣམ་པར་ཉམས་པར་རབ་ཏུ་འགྱུར།",
    "ཉི་ཤུ་འགའ་ཞིག་ལྷག་པའི་བརྒྱ་ཕྲག་གང་ཞིག་དུས་དང་དགུ་ཡིས་མི་རྣམས་ཀྱི་ནི་འཇིག་རྟེན་ཚད།",
    "ལུང་སྟོན་པའམ་བརྡའ་སྤྲོད་པ་དག་ལ་ལྷ་ཀླུས་བཀོད་པའི་རྐྱེན་དང་རང་བཞིན་སོགས་སུ་ཕྱེ་བའི་སྒྲ་སོགས་འདི་རིགས་འདི་མི་རིགས་ཞེས།",
    "རིགས་བཞི་དང་རང་བཞིན་གྱི་རིགས་ལྷན་ཅིག་པའི་རིགས་ལྔ་དང་།",
    "རང་བཞིན་མེད་ཀྱང་རྣལ་འབྱོར་པས་དམིགས་ཤིང་རང་རིག་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་ལྟར་གཙོ་བོ་རང་རང་ལས་མ་བྱུང་བའི་ཁམས་ལྷག་མ་གསུམ་ནི་ཁུ་བ་དང་རྡུལ་ཕན་ཚུན་འདུས་པའི་རྐྱེན་ལས་ཕལ་པའི་རྒྱུ་ལས་བྱུང་བའོ།",
    "དེ་ལྟར་དེ་དག་རང་རང་སོ་སོའི་དབུགས་དེ་ཉི་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱ་ལ་སོ་སོའི་ཉིན་ཞག་གཅིག་ཏུ་བརྩི་བ་ཡིན་ནོ།",
    "རང་རང་ལས་ལ་ཉེར་སྤྱོད་པས།",
    "རང་རང་རྒྱུ་བ་ལས་རབ་གྲུབ།",
    "དེར་མ་ཟད་གཟའ་རང་རང་སྐྱེས་པའི་སྐར་མ་ལ་ཡང་དགྲར་གྱུར་པ་དག་ལྷན་ཅིག་གྱུར་ན་འཐབ་སྟེ།",
    "བྱང་བགྲོད་མཐར་ཐུག་དུས་ལྷུན་པོའི་རྭ་དང་ཐད་མཉམ་དུ་ཉི་མ་སླེབས་པ་དང་།",
    "གླང་ལ་དབྱུག་བཞི་ཆུ་སྲང་བཞི་བཅུ་སོགས་བཀོད་པ་འདུག་གོ།",
    "བརྒྱད་པོ་དེ་ལས་རབ་ཏུ་གསལ་བར་དུ་བའི་ལོངས་སྤྱོད་ཀྱི་ཆ་ཆུ་ཚོད་ཕྱེད་དོར་བའི་ལྷག་དུས་ཕྱེད་བཅས་བདུན་གྱི་ཆུ་ཚོད་དག་ནི་སྒྲ་གཅན་གྱི་ལོངས་སྤྱོད་དེ་ཇི་ལྟར་ན་ཆུ་ཚོད་བདུན་དང་ཕྱེད་བཅས་དེ་ནི་ཉི་མའི་ཁྱིམ་གྱི་ཟླ་བ་གཅིག་པོ་འདི་ཉིད་ལ་སྤྱོད་དེ།",
    "གཟའ་རྣམས་རང་རང་དཀྱིལ་འཁོར་ལོ།",
    "དེ་ཡང་རང་བྱུང་རྩ་བའི་དབྱངས་ཨ་ཨི་རྀ་ཨུ་ལྀ།",
    "གང་ཤར་བ་དེ་ཉིད་ནི་ཕྱི་ནས་སམ་སླར་ཡང་རང་ས་ནས་བགྲང་བའི་ལྔ་པ་ལ་ནུབ་པ་ཉིད་དུ་འགྱུར་བའོ།",
    "དེ་ཡང་དང་པོ་ལ་ནི་དབྱངས་རྣམས་རང་རང་འཆར་བ་ནི་བྱིས་པ་སྟེ།",
    "རིམ་པ་བཞིན་ཕ་རོལ་གྱི་དགྲ་ཉམས་པ་དང་རང་ཉིད་ཀྱི་དཔལ་རྒྱས་ཤིང་གཡུལ་དུ་རྣམ་པར་རྒྱལ་ཏེ་དགའ་མ་དང་བཅས་པའི་ནོར་དག་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་ལས་མང་ན་མང་སྐྱོན་འདུག་པས།",
    "ཉི་མ་རིང་བ་མཐར་ཐུག་དུས་ཉིན་ཆུ་ཚོད་སོ་དྲུག་མཚན་ཉེར་བཞི།",
    "འདི་རྒྱ་རྩིས་ཀྱི་ཉི་ལྡོག་དང་འདྲ་འདུག།",
    "ཡང་སྔོན་ལྷ་མ་ཡིན་འགྲོ་སྐྱོབ་གསེར་ཅན་ཞེས་བྱ་བས་ལོ་བདུན་འབུམ་གྱི་བར་དུ་དཀའ་ཐུབ་སྤྱད་པ་དེས།",
    "རང་བཞིན་དང་རང་བཞིན་མེད་པའི་དབྱེ་བ་ལས་ཞེས་པའི་དོན་ཀྱང་མ་ཤར་བར་སྣང་ངོ་ཞེས་མཁས་གྲུབ་རྗེས་གསུངས།",
    "འགའ་ཞིག་དུང་ཅན་མའི་མཐའ་ན་ཨི་ཊ་ཞེས་པའི་རྩ་གཞན་ཞིག་ཡོད་པ་ལ་གོ་བར་འདུག་ཀྱང་མི་འགྲིག་གོ།",
    "ཕ་རྒྱུད་ཀྱི་དཀྱིལ་འཁོར་དགུ་ཡི་གྲངས་ཕྱོགས་གསུམ་གྱི་ཞག་དུས་སྦྱོར་བཅུ་གཉིས་ཀྱིས་བསྒྱུར་བ་མཐའ་དག་ཕྱོགས་ཀྱི་དབྱེ་བའི་ལྷའི་ཚོགས་ལྔ་བརྒྱ་དང་བཞི་བཅུའི་གྲངས་སུ་གྱུར་པའོ།",
    "སྐབས་འདིར་འཆི་ཞག་དང་རང་བཞིན་པའི་ཞག་ཇི་ལྟར་འབྱུང་ཚུལ་ལ་སྔ་འགྲེལ་རྣམས་སུ་བཞེད་པ་མི་མཐུན་པ་ཅུང་ཟད་བྱུང་ཡང་སྔ་མ་དེ་རྣམས་ལས་འཐད་ཆ་བཟུང་བ་མཁས་གྲུབ་འགྲེལ་ཆེན་ལྟར་ན།",
    "འཆི་ལྟས་མེད་པའི་མི་རྣམས་ལའང་རང་བཞིན་དུ་གཡས་གཡོན་དུ་དབྱུག་གུ་ལྔར་འབབ་ཅིང་།",
    "རྩ་བདུན་ཁྲི་ཉིས་སྟོང་ཆགས་པའི་རྗེས་ནས་དེ་ཐམས་ཅད་རྫོགས་པར་ཆད་དེ་འཆི་བ་ནི་ལོ་བརྒྱ་པའི་གང་ཟག་དུས་སུ་འཆི་བ་ཡིན་གྱི།",
    "གཞན་དག་གཉིད་འཐུག་དང་རྨི་ལམ་གཉིས་ལ་ཨ་ཨི་སོགས་ཐུང་རིང་སྦྱར་བར་བྱས་འདུག་པ་བརྟག།",
    "དེ་ལྟར་སྤྱིར་དེ་ཉིད་ཉེར་ལྔ་ཅི་རིགས་ཡི་གེས་མཚོན་ཚུལ་ཙམ་ལས་སོ་སོར་སྦྱར་བར་མཛད་མི་འདུག་གོ།",
    "ཀླ་ཀློ་རྣམས་ལ་ལྷ་མིན་གྱི་འདུག་སྟངས་སམ་གདན་བསྔགས་པ་ཡང་ངོ།",
    "དེའི་རྒྱབ་ཏུ་དཔྱི་བཞག་པ་རྒུར་པོར་འདུག་པའང་ཡང་སྒྲས་སྡུད་དོ།",
    "ལྷ་དང་རང་འཇིགས་ཕ་མེས་དང་།",
    "ད་ནི་དྲི་ཡི་སྦྱོར་བ་དེ་དག་འདུག་པས་སྨིན་པར་བྱ་བ་ཉིན་ཞག་སོ་སོར་བྱ་བའི་ཚུལ་བསྟན་པ་སྟེ།",
    "སྤྱིར་ཁྱབ་འཇུག་པའི་བྱེད་པོ་དང་བདག་དང་ལས་དང་དུས་དང་རང་བཞིན་དང་ཡོན་ཏན་སྟེ་ལམ་དྲུག་འདོད་པ་དང་།",
    "གང་ཞིག་ཕྲར་གྱུར་གཅིག་ཏུ་སྐྱེ་གནས་འདུག་དེ་ཡིས་འདི་ཀུན་སྐྱེ་ཞིང་འཇིག་པར་བྱེད།",
    "ལོ་ཟླ་ཞག་དུས་ཀྱི་སྐག་རིགས་སུམ་བརྒྱ་དྲུག་ཅུ།",
    "ཨོཾ་ནག་པོ་ཏི་པ་རཱ་ཙ་ནཱ་ག་རཀྵ་སུ་ཏྲི་ཡ་མ་དུ་ཛ་ཞེས་སྤྱན་དྲངས་ནས།",
    "ཨོཾ་ནག་པོ་ཏི་པ་རཱ་ཙ་ནཱ་ག་རཀྵ་ས་པ་རི་ཝཱ་ར་ཨརྒྷཾ་ནས།",
    "ཨོཾ་ནག་པོ་ཏི་པ་རཱ་ཙ་ནཱ་ག་རཀྵ་ས་པ་རི་ཝཱ་ར་ཨེ་དཾ་སོགས་ལན་བདུན་ནམ་ལྔ་དང་།",
    "རང་རང་ཞིང་དུ་གཤེགས་ནས་ཀྱང་།",
    "རྡོ་རྗེའི་སློབ་དཔོན་རང་ཉིད་འགྱིང་བག་དང་བཅས་པས་རྡོར་དྲིལ་འཛིན་བཞིན་དུ་ཁྲིའི་ཤིང་ལ་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་འཁོད།",
    "དེ་བཞིན་འདུག་ནས་གསོལ་བ་བཏབ་པས།",
    "དེ་དག་རྫོངས་ཟེར་བ་འདུག་འབོག་དེ་ཁ་དབྱེ་བས་འཁོར་ལོ་བཅས་བཅས་པ་བསམ་གྱིས་མི་ཁྱབ་པ།",
    "གསུམ་དུ་ཕྱོགས་འཛིན་གྱིས་བློ་མིག་འགྲིབས་པས་ལན་པར་གདའ།",
    "ཁྱེད་རང་རྣམས་གསན་པས་ཁྱབ་པར་གདའ།",
    "མདུན་དུ་དུལ་བར་འདུག་པ་དང་།",
    "སྔགས་ལམ་ལ་སྤྲོ་བ་བསྐྱེད་པ་སྟེ་གསན་པས་ཁྱབ་པར་གདའ།",
    "དེ་ཡང་རང་ཉིད་གཅིག་པུའི་ཆེད་དུ་མ་ཡིན་པར།",
    "དེར་འདུག་ཚུལ་གསང་བ་སྤྱི་རྒྱུད་ལས།",
    "ཁྱེད་རང་རྣམས་ཀུ་ཤའི་སྔས་གདན་ལ་སེངྒེའི་ཉལ་སྟབས་ཀྱིས་དུག་གསུམ་གྱི་སྤྲོས་པ་སྤངས་ཏེ་ཉོལ།",
    "ལྡང་འདུག་བདེ་ཕྱིར་ཁྲིའི་ཤིང་ལ་སྔར་བཞིན་དུ་འཁོད་དེ་འདི་སྐད་ཅེས་གླེང་བར་བྱའོ།",
    "ལྷོ་བལ་སོགས་ཡུལ་འགའ་ཞིག་ཏུ་མནའི་གལ་ལ་ཆུ་བླུད་སྲོལ་ཡོད་འདུག་པའི་ལུགས་ལྟར།",
