    "དེས་ན་ཙམ་སྒྲས་བདེན་པར་ཀུན་བཏགས་པ་དེ་རང་ངོས་ནས་དང་རང་མཚན་གྱིས་གྲུབ་པ་གཅོད་པ་དང་།",
    "དེས་ན་སེམས་ཙམ་པ་དང་རང་རྒྱུད་པའི་རང་མཚན་གྱིས་གྲུབ་པའི་དོན་མི་འདྲ།",
    "དངོས་སྨྲ་བས་བདག་ཕུང་རང་ངོས་ནས་ངོ་བོ་གཅིག་ལ་རང་ངོས་ནས་ལྡོག་པ་ཐ་དད་དུ་ཁས་བླངས་པ་ལ།",
    "ཀུན་རྫོབ་སྟེ་རང་བཞིན་གྱིས་གྲུབ་པར་སྣང་ཡང་རང་བཞིནགྱིས་སྟོང་པའི་རྫུན་པ་ཙམ།",
    "འདི་ལས་ཆ་མེད་པ་ལ་གསལ་བ་དུ་མ་ལ་ཁྱབ་པ་འགལ་བ་ཡིན་པར་བདེན་འདུག་པས་བ་སྤྱི་ཆ་མེད་མ་ཡིན་ནོ་སྙམ་དུ་རྟོགས་པར་འགྱུར་བའི་ཕྱིར།",
    "ཚོར་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཕྱིར།",
    "སྒྲུབ་བྱེད་ཚོར་ཕུང་རང་འཇུག་ཊཱིཀ་སྣང་རྒྱན།",
    "བསྒྲུབ་བྱ་གཟུགས་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་ལ་སྒྲུབ་དཀའ་སླའི་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "གསེར་བུམ་པའི་རྣམ་འགྱུར་དུ་གྲུབ་ཀྱང་རང་བཞིན་གསེར་ཡིན་པ་བཞིན་དུ་མྱུ་གུའི་རྒྱུའི་ས་བོན་གྱི་རྣམ་པ་དང་།",
    "རང་བཞིན་དེ་འབྲས་བུ་གསལ་བ་དང་རང་བཞིན་ཐ་དད་ཡིན་པའི་ཕྱིར།",
    "ས་མྱུག་གཉིས་ཀྱི་ངོ་བོ་དང་རང་བཞིན་ལ་རྣམ་པ་ཐམས་ཅད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "དེ་ཡང་རང་བཞིན་གཅིག་ཏུ་ཡོད་པར་འདོད་པས་ན་ས་མྱུག་གཉིས་གཅིག་ཡིན་དགོས་པའི་ཕྱིར་རོ།",
    "ཞེས་བཀོད་འདུག་པ་གང་ཞིགསྐྱེ་བ་དོན་མེད་དང་ཐུག་མེད་གཉིས་ཀྱི་རྟགས་ཀྱིས་དངོས་པོ་རྣམས་བདག་ལས་སྐྱེ་བ་མེད་པ་སྒྲུབ་མི་ཐུབ་པའི་ཕྱིར་ཏེ།",
    "ཡང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་དང་།",
    "རང་གྲགས་ཀྱི་རྟགས་དང་རང་གྲགས་ཀྱི་རྗེས་དཔག་གཉིས་དང་།",
    "མ་ཡིན་པ་དེ་ལྟ་བུ་ལ་ཡང་རང་རྒྱུད་ཀྱི་རྟགས་དཔེས་བསྒྲུབ་ནུས་ཞེས་རང་རྒྱུད་ཀྱི་རྟགས་འཚངས་ཀ་བྱེད་པ་ནི་གཏན་ཚིགས་སྨྲ་བ་ལ་དགའ་བ་ཙམ་ལས་འབྲས་བུ་ཅི་ཡང་མེད་པའི་ཕྱིར།",
    "རང་བཞིན་གྱིས་ཡོད་ཅེས་དང་གཏན་མེད་ཀྱི་མེད་ཅེས་དང་རང་བཞིན་གྱིས་ཡོད་མེད་ཅེས་དང་རང་བཞིན་གྱིས་འཇིག་པས་རྟགས་ཐུབ་པ་མེད་ཅེས་པ་གང་ལ་ཁས་ལེན་པའི་ཕྱོགས་འཇུག་ཊཱིཀ་སྣང་རྒྱན།",
    "གྲངས་ཅན་གྱི་ལུགས་ལ་དམ་བཅའ་མིག་སོགས་ཀྱི་བདག་ཉིད་དེ་རྒྱུ་དང་རང་བཞིན་གཅིག་ཏུ་ཡོད་པའི་མིག་སོགས་ཀྱི་བདག་ཉིད་དང་གསལ་ཟིན་འབྲས་བུའི་བདག་ཉིད་གཉིས་ཡོད་པས་བདག་ལས་མི་སྐྱེ་ཞེས་པའི་བདག་དེ་གང་ཡིན་མི་གསལ་བ་དང་།",
    "རང་རྒྱུད་ཀྱི་སྦྱོར་བའི་གཏན་ཚིགས་དང་དཔེ་མ་བརྗོད་པ་དང་རང་རྒྱུད་ཀྱི་སྦྱོར་བ་ལ་གཞན་གྱིས་སྨྲས་པའི་ཉེས་པ་མ་བསལ་བ་དང་སྐྱོན་གཉིས་པོ་དེ་མེད་ཀྱང་།",
    "ཀྱི་ཡུལ་ཅེས་པ་ནི་རང་རང་ལ་དངོས་སུ་སྣང་བའི་ཡུལ་དེ་ལ་བྱེད་པ་ཡིན་ལ།",
    "དཔལ་ལྡན་ཟླ་བས་བདེན་མེད་དང་རང་མཚན་གྱིས་གྲུབ་པ་གཉིས་ཀ་ཡིན་པ་མི་རིགས་པས་གཟུགས་སོགས་བདེན་པར་གྲུབ་པས་སྟོང་པ་དང་།",
    "ཡང་རང་ལ་མི་ལྟ་ན་གཞན་ལ་ངོ་བོ་ཉིད་ཀྱིས་ལྟ་བ་ཡང་ཇི་ལྟར་ཡོད་དེ།",
    "དེ་དང་འགལ་བ་སྔོན་པོ་ལ་སོགས་པ་གཞན་ལ་ངོ་བོ་ཉིད་ཀྱིས་ལྟ་བ་གཉིས་ནི་ཕྱི་རྒོལ་ཁོ་རང་ལ་གྲགས་པའི་རྗེས་སུ་དཔག་པའི་རྟགས་དེ་དང་འགལ་བ་ཡིན་ཏེ།",
    "བཟློག་དོན་གྱི་བདག་སྐྱེ་འགོག་པའི་རྟགས་ལ་ཐ་སྙད་དུ་སྐྱེ་བ་ཤུགས་ལ་འཕེན་ཐུབ་པའི་རྟགས་ཤིག་བཀོད་འདུག་པས་མཐའ་བཞིའི་སྐྱེ་བ་འགོག་པའི་སྐབས་འདིར་མཐའ་བཞི་ལས་སྐྱེ་བ་བཀག་པ་ཙམ་མ་ཡིན་པར་དེ་བཀག་པ་དང་ཐ་སྙད་འཇུག་ཊཱིཀ་སྣང་རྒྱན།",
    "འདིར་ང་རང་བཞིན་གྱིས་མེད་པར་རྟོགས་པའི་བློས་ཕུང་པོ་སོགས་རང་བཞིན་མེད་པར་ཤུགས་ལ་རྟོགས་པར་གསུངས་པ་སོགས་ནི།",
    "དོན་དམ་པར་ཡང་རང་ལ་དམ་བཅའ་ཡང་མེད་པ་ཡིན་ཞེས་བྱེད་མི་རུང་བའི་ཕྱིར།",
    "དོན་དམ་པའི་ངོར་ནི་དགག་བྱ་དང་དེ་འགོག་པའི་དམ་བཅའ་དང་རང་ལ་དམ་བཅའ་མེད་པ་སོགས་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བའི་ཕྱིར་ཏེ།",
    "དེ་རྒྱུ་དུས་སུ་ཡོད་པ་དེ་ཁོ་རང་ལ་གྲགས་པ་གཉིས་ཀ་ཡིན་པས་ན་གཞན་གྲགས་ཀྱི་གཏན་ཚིགས་ཡང་དག་ཡིན་ནོ།",
    "གདོད་ནས་དག་པར་འདུག་པས་བཞི་པའི་ལམ་དུ་ངོ་སྤྲད་དོ།",
    "དེ་བཞིན་དུ་སེམས་འདིའང་མི་བདེན་པར་འདུག་སྙམ་དུ་བསྒོམ།",
    "གཟུགས་བརྙན་དེ་ཡོད་ན་དངོས་པོར་ཡོད་པར་རིགས་པ་ལ་མི་འདུག།",
    "ཕྱི་ནང་གང་ལ་བལྟས་ཀྱང་གསལ་བའི་ངོ་བོར་འདུག་པ་དེ་ལ་ཆེར་བལྟས་ནས་དེའི་ངང་ལ་རྟོག་པ་མེད་པར་འཇོག་པའོ།",
    "ཕྱི་ནང་གང་ལ་བལྟས་ཀྱང་རང་བཞིན་གྱིས་སྟོང་སྟེ།",
    "གནས་པ་ལུས་ཀྱི་ནང་ནའང་མི་འདུག།",
    "ཕྱི་རོལ་ནའང་མི་འདུག།",
    "དབྱིངས་ལ་བལྟས་ན་དབྱིངས་ལའང་མི་འདུག་ལ།",
    "དེས་ན་རང་བཞིན་སྟོང་པར་འདུག་པ་དེའི་ངང་ལ་ཆེར་བལྟས་ནས་རྟོག་པ་མེད་པར་འཇོག་པའོ།",
    "དེ་ནས་སྭ་བྷཱ་ཝའི་སྔགས་ཀྱིས་རང་འདུག་སའི་གནས་དེ་སྟོང་པར་བསྒོམ།",
    "ཉི་མ་ལ་འདུག།",
    "ལུས་བྲེད་འདར་ཞིང་སྒུར་བ་ཀུམ་ཀུམ་པོར་འདུག་པ།",
