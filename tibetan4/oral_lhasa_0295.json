    "བདེ་ཞིང་གནོད་པར་འགྱུར་བ་དེ་དག་ཀུན་ན་མེད།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཚུལ་གྱིས།",
    "གཞི་འོད་ཟེར་གྱིས་རྣམ་པར་བརྒྱན་པ།",
    "ཡེ་ཤེས་ཀྱི་ཡུལ་ཡང་དག་པའི་མཐའ་སྤྱོད་ཡུལ་ཆགས་པ་མེད་པས་རྣམ་པར་གསལ་བ་ན།",
    "ཡེ་ཤེས་ཆེན་པོ་རྣམ་པར་ཕྱེ་བའི་སྤྱོད་ཡུལ་ལ་གཞོལ་བ།",
    "མཐའ་དང་དབུས་མེད་པ་ལ་རྣམ་པར་སྤྱོད་པ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམ་པར་སྣང་མཛད་དང་།",
    "རྣམ་པར་གྲོལ་བ་བསྒྲིབས་པ་མེད་པའི་ཟླ་བ་དང་།",
    "དེས་འཇིག་རྟེན་གྱི་ཁམས་འབྱམ་ཀླས་པ་ཐམས་ཅད་དུ་མ་ལུས་པར་སྣང་བར་བྱས།",
    "དེ་བཞིན་གཤེགས་པའི་རྣམ་པར་འཕྲུལ་པ་བསྟན་ནས།",
    "ནམ་མཁའི་མཐས་གཏུགས་པར་འབྱམ་ཀླས་པ་ཐམས་ཅད་མ་ལུས་པར་རྒྱས་པར་ཁྱབ་པར་བྱས་ནས་ཕྱིར་འོངས་ཏེ།",
    "དགའ་བ་ཐོབ་པར་གྱུར་ཏེ།",
    "རྟོག་པའི་བློ་ཡང་ཐོབ་པར་གྱུར་ཏོ།",
    "རྣམ་དག་བློ་མངའ་ཡོན་ཏན་མཁྱེན་པས་འཕགས་པ།",
    "ཐུགས་རྗེ་ལྡན་པས་སུ་ལའང་འཇིགས་པར་མི་མཛད།",
    "ཆོ་འཕྲུལ་མཐའ་ཡས་ཡང་དག་བསྟན་པར་བགྱིས་ཏེ།",
    "ཚོགས་འདི་དག་པ་འདུས་པས་རྣམ་པར་དག་པ།",
    "ཡང་དག་མ་ནོར་བརྗོད་པར་ནུས་པ་གང་ལགས།",
    "སྐྱེས་བུ་ཁྱུ་མཆོག་རྣམས་ཀྱི་སྲས་ནི་གང་ལགས།",
    "དེས་འཇིག་རྟེན་གྱི་ཁམས་འབྱམ་ཀླས་པ་ཐམས་ཅད་མ་ལུས་པར་སྣང་བར་བྱས་ནས།",
    "དེ་བཞིན་གཤེགས་པའི་རྣམ་པར་འཕྲུལ་པ་བསྟན་ནས།",
    "ནམ་མཁའི་མཐས་གཏུགས་པར་འབྱམ་ཀླས་པ།",
    "ཐམས་ཅད་མ་ལུས་པར་རྒྱས་པར་ཁྱབ་པར་བྱས་ནས་ཕྱིར་འོངས་ཏེ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དེ་བཞིན་གཤེགས་པས་ཆོ་འཕྲུལ་ཆེན་པོ་འཇིག་རྟེན་ཐམས་ཅད་ཀྱིས་ཁོང་དུ་ཆུད་པར་དཀའ་བ།",
    "དེའི་ཚེས་ཆེན་པོ་གཡོས་པར་གྱུར་ཏོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ལེགས་པར་སྤོབས་པར་མཛོད་ཅིག།",
    "སྐུ་ཡང་དག་པར་བསྟན་པ་དང་།",
    "བདེ་གཤེགས་མྱ་ངན་འདས་དང་འོན་ཏམ་བཞུགས་ཀྱང་རུང་སྟེ།",
    "དེ་དག་དོན་ཀྱང་ཅིར་འགྱུར་འཁོར་འདིར་བསྟན་པར་མཛོད་ཅིག།",
    "ཇི་ལྟར་ཞིང་རྣམས་ཐམས་ཅད་མ་ལུས་རྒྱས་པར་བཀང་ཞིང་།",
    "རྐྱེན་གཅིག་མ་ཡིན་པས་ཡང་དག་པར་འགྲུབ་བོ།",
    "བསམ་པ་དང་ལྷག་པའི་བསམ་པ་སྔོན་ཤིན་ཏུ་སྦྱངས་ཤིང་ཡང་དག་པར་བསྒྲུབས་པ་དང་།",
    "ཐབས་དང་ཤེས་རབ་ཀྱི་ལམ་རྣམ་པར་དག་ཅིང་།",
    "འདི་ལྟར་སྤྲིན་ཆེན་པོའི་ཆར་དུས་ལས་མྱི་འདའ་བར་རབ་ཏུ་འབབ་པས་ཀྱང་རྒྱུ་བྱས་ལ།",
    "གནས་ཀྱི་རྣམ་པའི་རྒྱན་རྣམ་པར་ཕྱེ་བ་ཤིན་ཏུ་རྣམ་པར་དབྱེ་བས་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་རྣམ་པར་དབྱེ་བའི་ཕྱིར་ལྡང་སྟེ།",
    "དེ་ལྟར་རྒྱལ་བའི་སྲས་དག་དཔེའི་སྒོ་དང་པོས་ཁོང་དུ་ཆུད་པར་བྱ་བ་འདིས།",
    "བཟོད་པར་མི་ནུས་སོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་གཉིས་པ་འདིས་ཀྱང་།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་གསུམ་པ་འདིས་ཀྱང་།",
    "སྤྲིན་ཆེན་པོའི་ཆར་དེ་ལ་བལྟས་པས་མིག་འཁྲུགས་པར་འགྱུར་རོ།",
    "དེ་ལ་ཆུང་ངུ་ན་ཆར་པའི་ཐིགས་པ་གཅིག་ཀྱང་མ་རིག་པར་མི་འབབ་པོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བ་སྒོ་བཞི་པ་འདིས་ཀྱང་།",
    "རྣམ་པར་འབྱེད་པ་ཞེས་བྱ་བའི་སྤྲིན་ཆེན་པོའི་ཆར་འབབ་པ་ཡོད་དེ།",
    "དེ་ནི་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་དེ་རྣམ་པར་འབྱེད་དོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་ལྔ་པ་འདིས་ཀྱང་།",
    "སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོ་ཡོངས་སུ་འགྲུབ་པར་འགྱུར་བའི་ཚེ།",
    "ཐོག་མ་ཉིད་དུ་གཟུགས་ལ་སྤྱོད་པའི་ལྷའི་བུ་རྣམས་ཀྱི་གཞལ་མེད་ཁང་ཡོངས་སུ་འགྲུབ་པར་འགྱུར་རོ་དེའི་འོག་ཏུ་འདོད་པ་ལ་སྤྱོད་པའི་ལྷའི་བུ་རྣམས་ཀྱི་གཞལ་མེད་ཁང་ཡོངས་སུ་འགྲུབ་པར་འགྱུར་རོ།",
    "དེའི་འོག་ཏུ་མི་རྣམས་ཀྱི་གནས་ཡོངས་སུ་འགྲུབ་པར་འགྱུར་རོ།",
    "ཆར་སྤྲིན་ཆེན་པོ་ཡང་རོ་གཅིག་ལ་ཆུའི་ཕུང་པོ་ཡང་རྣམ་པར་མི་རྟོག་པ་ལས།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་བདུན་པ་འདིས་ཀྱང་།",
    "དེ་དག་ནི་འཇིག་རྟེན་ཐམས་ཅད་འོད་ཀྱིས་རྒྱས་པར་འགེངས་ཏེ།",
    "གནས་གཙང་མའི་རིས་ཀྱི་ལྷའི་བུ་གཞན་རྣམས་ཀྱིས་ཀྱང་།",
    "དེ་ནི་གཟུགས་ལ་སྤྱོད་པའི་ལྷ་རྣམས་ཀྱི་གཞལ་མེད་ཁང་ཡོངས་སུ་གནས་པར་བྱེད་དོ།",
    "དེ་ནི་ས་ཆེན་པོ་ཀུན་ནས་གནས་པར་བྱེད་དོ།",
    "ཀླུ་དང་དྲི་ཟའི་ཁྱིམ་ཀུན་ནས་གནས་པར་བྱེད་དོ།",
    "དེ་ནི་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་སུ་གཏོགས་པའི་རྒྱ་མཚོ་ཆེན་པོ་ཀུན་ནས་གནས་པར་བྱེད་དོ།",
    "དེ་ནི་ཡིད་བཞིན་གྱི་ཤིང་ཐམས་ཅད་ཀུན་ནས་གནས་པར་བྱེད་དོ།",
    "ཆུའི་ཕུང་པོ་རྣམ་པར་མི་རྟོག་པ་ལས།",
    "དེ་བཞིན་གཤེགས་པའི་རིགས་རྒྱུན་མི་གཅོད་པ་ཞེས་བྱ་བ་འཇིག་རྟེན་གྱི་ཁམས་མ་ལུས་པ་ཐམས་ཅད་རྒྱས་པར་འགེངས་པ་འབྱུང་སྟེ།",
    "འོད་ཟེར་དེས་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ཡེ་ཤེས་ཟག་པ་མེད་ཅིང་མི་ཟད་པ་ཡང་དག་པར་འགྲུབ་པར་འགྱུར་རོ།",
    "འོད་ཟེར་དེས་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་སྟོབས་མི་སྒུལ་བ་ཡང་དག་པར་འགྲུབ་པར་འགྱུར་རོ།",
    "ཡང་དག་པར་འཕགས་པ་ཞེས་བྱ་བ་འབྱུང་སྟེ།",
    "འོད་ཟེར་དེས་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་སྟོབས་དང་མི་བསྙེངས་པ་ཟིལ་གྱིས་མི་ནོན་པའི་ཡེ་ཤེས་ཡང་དག་པར་འགྲུབ་པར་འགྱུར་རོ།",
    "འོད་ཟེར་དེས་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ཡེ་ཤེས་ཐམས་ཅད་དུ་བརྗོད་པ་ལས་འདས་ཤིང་ཐམས་ཅད་དུ་ཐོགས་པ་མེད་པ་ཡང་དག་པར་འགྲུབ་པར་འགྱུར་རོ།",
    "ཡེ་ཤེས་མི་ཟད་པའི་ཚོགས་འགྲོ་བ་ཐམས་ཅད་ཉེ་བར་འཚོ་བ་ཡང་དག་པར་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་ཆེན་པོ་འཇུག་པར་དཀའ་བ་ཞེས་བྱ་བ་འབྱུང་སྟེ།",
    "འོད་ཟེར་དེས་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ཡེ་ཤེས་མཚན་དང་དཔེ་བྱད་བཟང་པོའི་རྒྱན་སྣ་ཚོགས་ཀྱིས་འགྲོ་བ་ཐམས་ཅད་རྣམ་པ་ཐམས་ཅད་དུ་དགའ་བར་འགྱུར་བ་ཡང་དག་པར་འགྲུབ་བོ།",
    "ནམ་མཁའི་མཐས་གཏུགས་པར་སྐུ་ཚེའི་ཚད་རྒྱུན་མི་འཆད་པ་ཡང་དག་པར་འགྲུབ་པར་འགྱུར་ཏེ།",
    "དེ་བཞིན་དུ་ཤེས་པར་འགྱུར་བ་ལ་ལྟོས།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ལ་ཆུང་ངུ་ན་ཆ་ཤས་གཅིག་ཙམ་བསྟན་པ་ཡང་ཤེས་པར་འགྱུར་བའམ།",
    "ཁོང་དུ་ཆུད་པར་འགྱུར་བའི་གནས་མེད་སྐབས་མེད་དེ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་དེ་ལྟར་དེ་བཞིན་གཤེགས་པའི་མཐུའི་ཁྱད་པར་གྱིས།",
    "ཁོང་དུ་ཆུད་པར་བྱེད་ཀྱང་།",
    "རྣམ་པར་རྟོག་པ་མི་མངའ་སྟེ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དག་ཁོང་དུ་ཆུད་པར་བྱ་བའི།",
    "རྣམ་པར་མི་འཇིག་པས་དེའི་ཕྱིར་ས་ནི་ཆུ་ལ་གནས་སོ།",
    "འགྲོ་བ་མང་པོ་རྣམ་པར་ཕྱེ་བ་འབྱམ་ཀླས་པའི་ནང་ན་ཐབས་མཁས་པ་ལ་གནས་པའི་བྱམས་པ་ཆེན་པོས།",
    "དེའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་ཡང་དག་པར་འགྲུབ་པ་ནི་འགྲོ་བ་ཐམས་ཅད་ཉེ་བར་འཚོ་བ་ཡིན་ཞེས་བྱའོ།",
    "ཕྱོགས་བཅུ་ཐམས་ཅད་རྒྱས་པར་འགེངས་པས་ན་ཤིན་ཏུ་ཡངས་པར་ཤེས་པར་བྱའོ།",
    "སྐྱེ་བ་དང་འཇིག་པའི་གནས་དང་བྲལ་བས་ན་ལེན་པ་མེད་ཅིང་འདོར་བ་མྱེད་པར་ཤེས་པར་བྱའོ།",
    "སེམས་དང་ཡིད་དང་རྣམ་པར་ཤེས་པ་དང་བྲལ་བས་ན་རྒྱུ་བ་མེད་ཅིང་རྒྱུ་བ་དང་བྲལ་བར་ཤེས་པར་བྱའོ།",
    "ལུས་མེད་པར་ཤེས་པར་བྱའོ།",
    "ཕྱི་མའི་མཐའི་མུར་ཐུག་པར་རྒྱུན་མི་འཆད་པས་ན།",
    "ཕྱིར་མི་ལྡོག་པར་ཤེས་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ལ་གཉེན་པོ་མེད་པས་ན་མི་འཕྲོགས་པར་ཤེས་པར་བྱའོ།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་མཉམ་པ་ཉིད་དུ་ཐུགས་སུ་ཆུད་པས་ན།",
    "མི་གཉིས་པར་ཤེས་པར་བྱའོ།",
    "འགྲོ་བ་ཐམས་ཅད་ཉེ་བར་འཚོ་བར་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་ལ་ལས་རྩིས་འགོ་བཟུང་སྟེ་བགྲང་བྱས་ཀྱང་།",
    "གཞལ་བར་མི་ནུས་མཐའ་ཡང་རྙེད་པར་མི་རུང་བ།",
    "དུས་གསུམ་ཀུན་དང་རྣམ་པ་ཀུན་ཏུ་རྣམ་པར་བྲལ།",
    "རང་བཞིན་བྱས་པ་མེད་པས་རྣམ་པར་འགྱུར་བ་མེད།",
    "རྒྱལ་བའི་སྤྱོད་ཡུལ་འདི་ལ་འཇུག་པར་སུ་འདོད་པ།",
    "རྟོག་དང་རྣམ་པར་རྟོག་དང་འདུ་ཤེས་འཛིན་སྤངས་ཏེ།",
    "ནམ་མཁའ་ལྟ་བུའི་ཡིད་ཀྱིས་དེ་ལ་འཇུག་པར་གྱིས།",
    "ཤས་ཙམ་ཤེས་པར་བྱ་བའི་དོན་དུ་ཆུང་ཟད་བརྗོད།",
    "ཇི་ལྟར་སྤྲིན་དང་དུས་ཀྱི་ཆར་ལ་བརྟེན་བྱས་ཤིང་།",
    "རྣམ་པར་དག་པ་མ་གཏོགས་གཞན་གྱིས་འཛིན་མི་ནུས།",
    "དེ་བཞིན་བདེ་གཤེགས་ཆར་ཆེན་འབབ་པ་མ་ལུས་པར།",
    "རྣམ་པར་འབྱེད་པ་སྟོང་གསུམ་ཐམས་ཅད་རྣམ་པར་འབྱེད།",
    "རྒྱལ་བའི་རིན་ཆེན་སྒྲུབ་ཅིང་བསམ་པ་རྣམ་པར་འབྱེད།",
    "འོན་ཀྱང་ཆུ་ལ་རྟོག་མེད་རྣམ་པར་རྟོག་པ་མེད།",
    "རོ་གཅིག་ཞི་ཞིང་རྟོག་མེད་རྣམ་པར་རྟོག་མེད་དེ།",
    "དེ་ནས་འདོད་ཁམས་གཞལ་མེད་ཁང་རྣམས་རྣམ་པར་འགོད།",
    "དེ་ཕྱིར་ས་སྟེང་གནས་རྣམས་འཇིག་པར་མི་འགྱུར་རོ།",
    "མགོན་པོ་རྣམས་ཀྱང་ཤེས་རབ་ཡེ་ཤེས་གཞི་ལ་བཞུགས།",
    "ཞིང་ཐམས་ཅད་ཀུན་ཏུ་ཁྱབ་པར་ཤེས་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་ལ་རྣམ་པར་རྟོག་པ་མི་མངའ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་ནི་ཐོག་མ་ནས་སྤྲོས་པ་ཐམས་ཅད་ཡང་དག་པར་ཆད་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་བལྟར་ཡོད་པར་ཤེས་པར་བྱའོ།",
    "ལོ་ཐོག་ལ་བབ་ཅིང་ཡོངས་སུ་སྨིན་པར་བྱེད་པས་ཀྱང་ཉེ་བར་འཚོ་བ་ཡིན།",
    "ལས་ཀྱི་རྣམ་པ་སྣ་ཚོགས་ལ་བབ་ཀྱང་དགོས་པ་བརྩམས་པ་ཡོངས་སུ་གྲུབ་པར་བྱེད་པས་ཉེ་བར་འཚོ་བ་ཡིན།",
    "རྒྱུ་དང་འབྲས་བུ་རྣམ་པར་ཆུད་མི་ཟ་བས་མཐོང་བ་དོན་ཡོད་པས་ཀྱང་།",
    "སྤྱད་པ་བརྩམས་པ་ཡོངས་སུ་གྲུབ་པར་མཛད་ཅིང་།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་བལྟར་ཡོད་པར་ཤེས་པར་བྱའོ།",
    "ཞེས་བྱ་བའི་རྣམ་པར་རྟོག་པ་མེད་དེ།",
    "ས་མཐོན་དམན་གྱི་ཁྱད་པར་གྱིས་མཐོ་མཐོ་ལ་སྔར་འཆར་རོ།",
    "རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་ཐོགས་པ་མེད་པའི་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་སྣང་བ་འགྱེད་དེ།",
    "མ་འོངས་པའི་རྒྱུ་ཡང་ཡོངས་སུ་སྨིན་པར་མཛད་ཅིང་།",
    "ལྟ་བ་བསྲང་བར་བྱའོ་ཞེས་རྣམ་པར་རྟོག་པ་མི་མངའ།",
    "འོན་ཀྱང་འོད་ཟེར་མཉམ་པར་འགྱེད་པས།",
    "དེ་ནི་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཀྱི་སྐུ་ཉི་མའི་དཀྱིལ་འཁོར་ལ་རྣམ་པར་རྟོག་པ་མི་མངའ་བའི་ཕྱིར་རོ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་རྣམ་པར་རྟོག་པ་མེད་ཅིང་།",
    "དེ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཀྱི་སྐུ་ཉི་མའི་དཀྱིལ་འཁོར་རྣམ་པར་རྟོག་པ་མི་མངའ་ཞིང་།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་བལྟར་ཡོད་པར་ཤེས་པར་བྱའོ།",
    "རྣམ་པར་དག་པས་རྣམ་པར་རོལ་པའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་དང་ལྡན་པ་ཞེས་བྱ་བའི་འོད་ཟེར་དང་དབྱངས་ཆེན་པོས་ཡེ་ཤེས་རྣམ་པར་དགོད་པའི་དོན་སྣང་བ་དང་ལྡན་པ་ཞེས་བྱ་བའི་འོད་ཟེར་དང་།",
    "སྤྱོད་པ་ཐམས་ཅད་ཀྱིས་ཤིན་ཏུ་ཚིམ་པར་བྱེད་པའི་ཡེ་ཤེས་སྣང་བ་དང་ལྡན་པ་ཞེས་བྱ་བའི་འོད་ཟེར་དང་།",
    "མི་གནས་པའི་ཡེ་ཤེས་རྣམ་པར་འཕྲུལ་པའི་སྣང་བ་དང་ལྡན་པ་ཞེས་བྱ་བའི་འོད་ཟེར་དང་།",
    "སྤྲོས་པ་ཐམས་ཅད་ཡང་དག་པར་གཅོད་པའི་ཡུལ་ལ་ཡེ་ཤེས་ཀྱི་རྣམ་པར་རོལ་པ་ཞེས་བྱ་བའི་འོད་ཟེར་དང་།",
    "ཡེ་ཤེས་འབྱམ་ཀླས་པ་ཡོངས་སུ་དག་པ་བཅུ་རབ་ཏུ་འཐོབ་པར་འགྱུར་ཏེ།",
    "རྣམ་པར་དག་པ་དང་།",
    "ཤིན་ཏུ་དུལ་བ་རབ་ཏུ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ལུས་ཀྱི་བདེ་བ་དེ་དང་ལྡན་པར་གྱུར་ནས་ཀྱང་།",
    "བདག་ཅག་ནི་ཚངས་པས་བྱས་པ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་བལྟར་ཡོད་པར་ཤེས་པར་བྱའོ།",
    "དེ་ལ་རྣམ་པར་རྟོག་པ་མེད་དོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་ཟླ་བའི་དཀྱིལ་འཁོར་དེ་ལ་རྣམ་པར་རྟོག་པ་མི་མངའ་སྤྲོས་པ་མི་མངའ་འོ།",
    "རྣམ་པར་རྟོག་པ་མི་མངའ་ཞིང་སྤྲོས་པ་མི་མངའས་ཀྱང་།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་བལྟར་ཡོད་པར་ཤེས་པར་བྱའོ།",
    "ལུས་ཐ་དད་པར་བྱེད་པ་མེད་དོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་ལ་རྣམ་པར་རྟོག་པ་མི་མངའ།",
