    "རྩི་དང་ནགས་ཚལ་སྣ་ཚོགས་རྣམ་པར་སྤེལ་བ་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་མ་ལུས་པ་ཐམས་ཅད་ཐུགས་རྗེ་ཆེན་པོའི་སྤྲིན་གྱིས་རྒྱས་པར་བཀང་སྟེ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་བདུན་པ་འདིས་ཀྱང་།",
    "དེ་བཞིན་གཤེགས་པའི་གསུང་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཞག་བདུན་འདས་ནས་ཆར་གྱི་རྒྱུན་ཤིན་ཏུ་ཕྲ་བས་ས་ཐམས་ཅད་ཡོངས་སུ་ངོམས་པར་བྱེད་དོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་བརྒྱད་པ་འདིས་ཀྱང་།",
    "དེ་བཞིན་གཤེགས་པའི་གསུང་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཆར་པ་དེ་དག་ལ་རྣམ་པར་རྟོག་པ་གང་ཡང་མེད་དེ།",
    "བསམ་གྱིས་མི་ཁྱབ་པ་རྣམ་པར་ཕྱེ་བའི་བྱིན་གྱིས་རྣམ་པར་དགོད་པའི་རྒྱན་བརྒྱ་ཕྲག་སྟོང་དང་ལྡན་པའི་ཆར་འབབ་པ་ཡོད་ཅིང་སྣང་ངོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་དགུ་པ་འདིས་ཀྱང་དེ་བཞིན་གཤེགས་པའི་གསུང་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ནམ་ཀླུའི་རྒྱལ་པོ་ཆེན་པོའི་རྣམ་པར་རྩེ་བས།",
    "ཡོངས་སུ་ཚིམ་པར་བྱ་བར་འདོད་པར་གྱུར་པ་དེའི་ཚེ།",
    "ཏིང་ངེ་འཛིན་གྱི་འབྲུག་སྒྲ་འགྲོ་བ་ཐམས་ཅད་ཚིམ་པར་བྱེད་པ་ཤིན་ཏུ་བསྒྲགས་པའི་ཚེ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་བཅུ་པ་འདིས་ཀྱང་།",
    "འཇིག་རྟེན་འཇིག་པར་འགྱུར་ཚེ་གཞལ་མེད་སྒྲ་དབྱངས་བཞི།",
    "དེ་སྐད་སྒྲ་ཐོས་འདོད་པའི་ཁམས་རྣམས་རྣམ་པར་སྤོང་།",
    "གཞན་གྱི་སྒྲ་ཕྱུང་རྣམ་པར་དམིགས་པས་སྒྲ་དེ་འབྱུང་།",
    "སྒྲ་དེ་ཐོས་ཤིང་ལྷ་རྣམས་བག་ཡོད་སྤྱོད་པར་འགྱུར།",
    "ཇི་ལྟར་ཚངས་པ་ཚངས་པའི་སྟན་ལས་མ་གཡོས་པར།",
    "འཁོར་རྣམས་ཇི་སྙེད་ཐམས་ཅད་ཁོང་དུ་ཆུད་པར་བྱེད།",
    "ས་སྟེངས་སྣོད་ཀྱི་ཁྱད་པར་གཞན་དང་གཞན་གྱུར་པས།",
    "དེ་བཞིན་རྒྱལ་སྲས་ཐམས་ཅད་མཁྱེན་གསུང་ཐམས་ཅད་ཀྱང་།",
    "ས་གཞི་ངོམས་པར་བྱ་ཕྱིར་ཆར་བའི་རྒྱུན་ཀྱང་གཏོང་།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དེ་བཞིན་གཤེགས་པ་རྣམས་ནི་སེམས་ཀྱིས་རྣམ་པར་དགོད་པ་མ་ཡིན།",
    "ཡིད་ཀྱིས་རྣམ་པར་དགོད་པ་མ་ཡིན།",
    "རྣམ་པར་ཤེས་པས་རྣམ་པར་དགོད་པ་མ་ཡིན་ཏེ།",
    "ནམ་མཁའ་ལ་བརྟེན་ཅིང་བྱ་བ་ཐམས་ཅད་རྣམ་པར་དགོད་པར་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པའི་ཤེས་པ་ཐམས་ཅད་རྣམ་པར་དགོད་པ་ཡིན་ཏེ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་དང་པོ་འདིས།",
    "རྣམ་པར་དགོད་ཅིང་ལས་དང་བཟོའི་གནས་ཐམས་ཅད་རྣམ་པར་དགོད་ཀྱང་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ལ་འཕེལ་ཞིང་འགྲིབ་པ་མེད་དོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་གཉིས་པ་འདིས་ཀྱང་།",
    "རྒྱ་མཚོ་ཆེན་པོ་ལ་རྣམ་པར་རྟོག་པ་མེད་དོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་རྒྱ་མཚོ་ཆེན་པོ་དེ་ནི་སྙོམས་ཤིང་རྣམ་པར་མི་རྟོག་ལ་རིམ་པར་འབྱེད་པ་མི་མཛད་ཀྱང་།",
    "བསམ་པ་དང་སྦྱོར་བའི་ཁྱད་པར་གྱིས་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་སྣང་བའི་ཁྱད་པར་དུ་འགྱུར་བ་ཡང་ཡོད་དོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་གསུམ་པ་འདིས་ཀྱང་།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་བཞི་པ་འདིས་ཀྱང་།",
    "རྒྱ་མཚོ་ཆེན་པོར་རླུགས་པའི་ཆུའི་ཕུང་པོ་ཐམས་ཅད་ཡོངས་སུ་འགྲིབ་པར་འགྱུར་ཏེ།",
    "དེ་ཡོད་པས་རྒྱ་མཚོ་ཆེན་པོ་ཡང་འཕེལ་བ་དང་འགྲིབ་པར་མི་འགྱུར་རོ།",
    "གླིང་ཆེན་པོ་བཞི་པའི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱང་གཅིག་ཏུ་ཆུས་ཡོངས་སུ་རྒྱས་པར་འགྱུར་ཏེ།",
    "ཐམས་ཅད་ལྷག་མ་མེད་ཅིང་མ་ལུས་པར་མི་སྣང་བར་འགྱུར་རོ།",
    "དེ་དག་ཡོད་པས་དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཀྱི་རྒྱ་མཚོ་ཆེན་པོ་གང་བ་དང་འགྲིབ་པར་མི་མངོན་ནོ།",
    "ཏིང་ངེ་འཛིན་ལ་རྩེ་གཅིག་ཏུ་གནས་པར་འགྱུར་རོ།",
    "ཏིང་ངེ་འཛིན་གྱི་རོ་དང་གནས་རྣམ་པར་སྤངས་ཏེ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་ལྔ་པ་འདིས་ཀྱང་།",
    "འདུས་བྱས་ལ་སྤྱོད་པའི་ཡེ་ཤེས་སམ།",
    "འདུས་མ་བྱས་ལ་སྤྱོད་པའི་ཡེ་ཤེས་གང་ཇི་སྙེད་ཡོད་པ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ལ་གནོད་པའམ་མི་བདེ་བར་འགྱུར་བ་མེད་ཀྱང་ཡེ་ཤེས་ཡང་དག་པར་འགྲུབ་པ་རྣམ་པ་ཐ་དད་པར་འགྱུར་བ་ཡང་ཡོད་དོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་སྒོ་ཇུག་པ་འདིས་ཀྱང་།",
    "འཛམ་བུའི་གླིང་ན་ཡོད་པའི་ཤིང་ཐམས་ཅད་ཀྱི་རྩ་བ་ཆགས་པར་འགྱུར་ཏེ།",
    "སྡོང་པོའི་འོད་ཀྱིས་སྡོང་པོ་ཆགས་པར་འགྱུར་རོ།",
    "ཡལ་གའི་འོད་ཀྱིས་ཡལ་ག་ཆགས་པར་འགྱུར་རོ།",
    "ལོ་མའི་འོད་ཀྱིས་ལོ་མ་ཆགས་པར་འགྱུར་རོ།",
    "འབྲས་བུའི་འོད་ཀྱིས་འབྲས་བུ་ཆགས་པར་འགྱུར་རོ།"
  ]
}