    "ཆུང་ན་ཕ་རོལ་ནོར་རྣམས་འཕྲོག་པར་བྱེད།",
    "འབངས་པོའི་འབངས་ཀྱི་ལས་རྣམས་བྱེད་པར་འགྱུར།",
    "རྟག་ཏུ་སྡུག་བསྔལ་འབའ་ཞིག་སྤྱོད་པར་བྱེད།",
    "སྐྱེས་པ་སྡུག་བསྔལ་བཞིན་དུ་གནས་པར་བཤད།",
    "བྲམ་ཟེ་གསོད་དམ་བཀུར་འོས་གསོད་པར་བཤད།",
    "དེས་ནི་གཉེན་པོ་བྱས་པ་མི་བཟང་སྟེལཾ།",
    "མཉམ་སྙོམས་པས་ནི་བདེ་བ་ཐོབ་པར་བྱེད།",
    "རྟག་ཏུ་འགྲོ་བ་འབའ་ཞིག་འཐོབ་པར་བྱེད་ཡི།",
    "ལོངས་སྤྱོད་མང་པོའི་བདག་པོ་བྱེད་པར་འདོད།",
    "དེ་དང་དེ་ཡི་ལོངས་སྤྱོད་ཐོབ་ིཔར་བཤད།",
    "སྦོམ་ཕྲ་མེད་པར་མཛེས་ཤིང་སྙོམས་པ་ནི།",
    "ཡོན་ཏན་མང་པོ་འཛིན་པར་བྱེད་པ་ཡིན།",
    "རྟག་ཏུ་རྒྱུ་འགྲུལ་བྱེད་པར་འགྱུར་བ་ཡིནི།",
    "བཟང་པོའི་མཚན་མ་ཡིན་པར་རྒྱ་མཚོས་གསུངས།",
    "དྲི་ཆུ་གཉིས་གསུམ་བཞི་ལྔ་ངན་པར་བཤད།",
    "རྟག་ཏུ་བདེ་ཆེན་བདག་པོ་བྱེད་པར་འགྱུར།",
    "དེ་ནི་ས་ཡི་བདག་པོ་བྱེད་པར་འགྱུར།",
    "ཟླུམ་པོ་ཕྱི་རུ་འཐོན་ན་ངན་པར་བཤད།",
    "གཡོན་དུ་འཁྱིལ་བས་དོན་རྣམས་སྟོང་པར་བྱེད།",
    "མཚན་ངན་སྡུག་བསྔལ་མང་པོ་འཐོབ་པར་བྱེད།",
    "སྤུ་སྙོམས་ཅུང་ཟད་སྐྱེས་པ་མཁས་པར་འགྱུར།",
    "གཉིས་དང་གསུམ་དུ་སྐྱེས་པ་ངན་པར་བཤད།",
    "ས་སྐྱོང་རྒྱལ་པོ་བྱེད་པར་འགྱུར་བ་ཡིན།",
    "ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་རྒྱས་པ་ཡིན་གྱི།",
    "ཕ་རོལ་གྲགས་པའི་རྒྱལ་པོ་ཐོབ་པར་འགྱུར།",
    "དམར་ལ་ིཟླུམ་པ་ཤ་དང་བཅས་པ་ནི་། འཇམ་པ་ནང་དུ་ཆུ་བླུགས་འཛིན་པར་བྱེད།",
    "ལག་པའི་རྟིང་པར་ཉ་འམ་རྔ་མ་འདྲ།",
    "གཞན་ཡང་རིག་པ་འཛིན་པར་བྱེད་པ་ཡིན་། ལག་པའི་དཀྱིལ་ལམ་ཡང་ན་གནས་གཞན་དུ།",
    "དུད་འགྲོ་མང་པོའི་བདག་པོ་བྱེད་པར་འགྱུར།",
    "གང་ལ་ཡོད་པ་རྒྱལ་པོ་ངེས་པར་ཐོབ།",
    "ཕ་རོལ་ནོར་ལ་རློམ་སེམས་བྱེད་པར་འགྱུར།",
    "བཟའ་བཏུང་ལོངས་སྤྱོད་མང་པོ་འཐོབ་པར་བྱེད།",
    "དོན་རྣམས་རྫོགས་པར་སྨྲ་བ་རྒྱལ་པོར་འགྱུར།",
    "ཡ་མཆུ་མཐུག་པར་གྱུར་པ་རྨོངས་པར་འགྱུར།",
    "ལོངས་སྤྱོད་དག་དང་ལྡན་པར་འགྱུར་བ་ཡིནི།",
    "དཀར་པོ་ལྕེ་ཅན་སྤྱོད་པ་གཙང་བ་ཡིན།",
    "སྣུམ་དང་ིདམར་བ་རིག་པ་འཛིན་པར་བྱེད།",
    "དམར་སྨུག་དཀར་ཅན་རིགས་རྣམས་ཉམས་པར་བྱེད།་",
    "ཚིག་གཏམ་ཟེར་བ་སྡིག་ཅན་ཡིན་པར་བཤད།",
    "འཇིག་རྟེན་འདྲེན་པ་བྱེད་པར་འགྱུར་བ་ཡིན།",
    "དེ་ཡང་སྡུག་བསྔལ་མང་པོ་འཛིན་པར་བྱེད།",
    "མཆོག་ཏུ་མིག་འབོར་མཐོ་བ་སྡུག་པར་བཤད།",
    "ཟླུམ་པའི་མིག་ཅན་ཉུང་ངུ་གསོན་པར་བཤད།",
    "གླང་ཆེན་ལྟ་བུས་ལོངས་སྤྱོད་ཐོབ་པར་བྱེད།",
    "མིག་རྩ་དམར་བ་ལོངས་སྤྱོད་ཐོབ་པར་བྱེད།",
    "འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་བྱེད་པར་འགྱུར།",
    "རིན་ཆེན་མུ་ཏིག་མིག་ཅན་མཁས་པར་འགྱུར།",
    "འབྱེད་འཛུམས་ཉུང་བ་རིང་དུ་གསོན་པར་བྱེད།",
    "ལན་བཞི་འཛུམས་པ་ལྟོགས་པར་གནས་པ་ཡིན།",
    "དེ་ནི་ཚེ་ཐུང་སྡུག་ཅིང་བཀྲེན་པར་བཤད།",
    "གཉེར་མ་བཞི་པ་དགུ་བཅུར་གསོན་པར་བཤད།",
    "གཉེར་མ་གཉིས་པ་དགུ་བཅུ་གསོན་པར་བཤད།",
    "རྐང་པ་སྐམས་པ་ལྟོགས་པར་འགྱུར་བ་ཡིན་། འགྲོ་ན་བྱ་བྲན་ལྟ་བུའང་དེ་བཞིན་དིུ།",
    "སྐྱེས་པ་ལྟ་བུའི་སྤྱོད་པ་བྱེད་པར་འགྱུར།",
    "རིང་བ་སྙོམས་པ་གཙང་བ་བདེ་བར་འགྱུར།",
    "དེ་ལ་བུ་དང་ནོར་རྣམས་བརྟན་ལེ་པར་འགྱུར།",
    "རྟག་ཏུ་སྡུག་བསྔལ་འབའ་ཞིག་སྤྱོད་པར་བྱེད།",
    "དེ་ཡི་སྤུན་ཟླ་ཉམས་པར་འགྱུར་བ་ཡིན།",
    "རྐང་པའི་མཐིལ་གྱི་ཤ་རྒྱུད་མཛེས་ཤིང་ཀོང་། དེ་ནི་སྨད་འཚོང་བྱེད་པར་འགྱུར་བ་ཡིན།",
    "དམར་སེར་སྤུ་ཅན་ལྟོགས་པར་འགྱུར་བ་ཡིན།",
    "སྙོམས་ཤིང་མཛེས་པར་གྱུར་པའི་སྤུ་དང་ལྡན།",
    "མི་འགྱུར་བརྟན་པ་བདེ་བ་ཐོབ་པར་བྱེད།",
    "ལྟེ་བ་མཐོ་བ་རྒྱས་པ་རྡུལ་དང་སྤུ་། མེད་པ་སྡུག་བསྔལ་མང་པོ་འཛིན་པར་འགྱུར།",
    "ལེགས་པ་མེད་པ་གང་ཞིག་འཇིགས་པར་སྐྱེས།",
    "བདེ་སྤོང་སྡུག་བསྔལ་ཆེན་པོ་འཛིན་པར་བྱེད།",
    "རྟག་ཏུ་རྟོགས་ཤིང་ནོར་མེད་སྡུག་བསྔལ་འགྱུར་། གསུས་པ་གཙང་ཞིང་སྣུམ་པ་ལེགས་པ་སྟེ་། ནུ་མ་གཡས་པ་རྒྱས་པ་བུ་དང་བཅས།",
    "ཤ་སྐམས་རྩ་ཡིས་གང་བ་སྡུག་པར་འགྱུར།",
    "དེ་ལ་སྡུག་བསྔལ་ཆེན་པོ་ཐོབ་པར་འགྱུར།་",
    "ནོར་བུ་དང་ནི་ལྡན་པར་འགྱུར་བ་ཡིན།",
    "བདེ་ཞིང་གསོན་པར་འགྱུར་བའི་མཚན་མ་ཡིན།",
    "སྣ་ཚོགས། ཛི་༢༡༨སྤུ་དང་བཅས་པ་དེ་ནི་སྡུག་པར་འགྱུར།",
    "ལག་པ་བཀྲ་ཤིས་རྟགས་ཅན་སྣུམ་པ་ནི་། བུ་དང་ནོར་རྣམས་ཐོབ་པར་བྱེད་པ་ཡིན།་།",
    "ལག་པ་དམར་པོ་སྣུམ་པ་གཙང་བ་ནི།་",
    "གཙང་མ་པདྨོ་ིརྒྱལ་མཚན་ཡོད་གྱུར་ན།",
    "རིང་བ་ཀྱི་སྙོམས་པ་བདེ་བ་འཐོབ་པར་བྱེད།",
    "ཤ་མཚན་དཀར་པོ་གཙང་བ་ཡོད་པ་ནི།",
    "དཔོན་པོའི་ཆུང་མ་བྱེད་པར་འགྱུར་བ་ཡིན།",
    "མཆོག་ཏུ་མཐུག་པ་སྨད་འཚོང་བྱེད་པར་འགྱུར།",
    "དེ་ནི་ཀུན་དང་འཁོན་པར་བྱེད་པ་ཡིན་་། རིང་བར་སླེབ་ཅིང་དམར་བ་སྣུམ་པ་ནི།",
    "བུ་དང་བདེ་བ་མང་པོ་འཐོབ་པར་བྱེད།",
