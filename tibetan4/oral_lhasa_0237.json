    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་སྟོན་པའི་ཐབས་ལ་མཁས་པ་ལ་གཡོ་སྒྱུ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྟོན་པའི་ཐབས་ལ་མཁས་པ་ལ་གཡོ་སྒྱུ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྟོན་པའི་ཐབས་ལ་མཁས་པ་ལ་གཡོ་སྒྱུ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་སྟོན་པའི་ཐབས་ལ་མཁས་པ་ལ་གཡོ་སྒྱུ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་སྟོན་པའི་ཐབས་ལ་མཁས་པ་ལ་གཡོ་སྒྱུ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་སྟོན་པའི་ཐབས་ལ་མཁས་པ་ལ་གཡོ་སྒྱུ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་སྟོན་པའི་ཐབས་ལ་མཁས་པ་ལ་གཡོ་སྒྱུ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་སྟོན་པའི་ཐབས་ལ་མཁས་པ་ལ་གཡོ་སྒྱུ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སྟོན་པའི་ཐབས་ལ་མཁས་པ་ལ་གཡོ་སྒྱུ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་སྟོན་པའི་ཐབས་ལ་མཁས་པ་ལ་གཡོ་སྒྱུ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "གང་ཞིག་བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་གཤེན་རབ་གཡུང་དྲུང་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ།",
    "གང་ཞིག་བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་གཤེན་རབ་གཡུང་དྲུང་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོ་ཤེས་རབ་གསལ་བ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "གང་ཞིག་ཐམས་ཅད་མཁྱེན་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "གང་ཞིག་རྣམ་པར་ཤེས་པ་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "གང་ཞིག་རྣ་བའི་རྣམ་པར་ཤེས་པ་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "གང་ཞིག་སྣའི་རྣམ་པར་ཤེས་པ་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "གང་ཞིག་ལྕེའི་རྣམ་པར་ཤེས་པ་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་ས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "གང་ཞིག་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "གང་ཞིག་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "གང་ཞིག་རྣམ་པར་ཤེས་པ་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "སྦྱིན་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "བཟོད་པའི་བླ་ན་མེད་པར་ཕྱིན་པ་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "བརྩོན་འགྲུས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "བསམ་གཏན་གྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "སྟོབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "ཐབས་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "ཤེས་རབ་ཀྱི་བླ་ན་མེད་པར་ཕྱིན་པ་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "མཚན་མ་མེད་པ་ལ་སྙོམས་པར་འཇུག་པ་བཞི་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་པ་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "སྙོམས་པར་གནས་པའི་ངང་ཉིད་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་འབྲས་བུ་ལ་ཐབས་ལ་མཁས་པའི་ཤེས་རབ་གསལ་བར་གྱུར་པ་ལ་འཁྲུལ་པ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "མཁས་པར་བློ་སྦྱོང་ཞིང་དད་པ་བསྐྱེད་པ་ལ་སྐྱོ་ངས་བྱེད་ན་ངོ་མཚར་ཆུང་ངོ།",
    "གང་ཞིག་སྟོབས་དང་ལྡན་པའི་སྐྱེས་བུ་རྣམས་ནི་གཞན་ལ་རྣམ་པར་འཚེ་ན་ངོ་མཚར་ཆུང་ངོ།",
    "གང་ཞིག་སྟོབས་དང་ལྡན་པ་ལ་རྣམ་པར་འཚེ་བ་མེད་པའི་སྐྱེས་བུ་རྣམས་ནི་སྟོབས་དང་ལྡན་པ་ཆེན་པོས་ལ་བཅད་པས་ཨེ་མ་ངོ་མཚར་ཆེའོ།",
    "དེ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པས་ངོ་མཚར་ཆེའོ།",
    "བོན་ཐམས་ཅད་མི་གཡོ་བ་ལ་མཉམ་པར་བཞག་པའི་ཕྱིར།",
    "ཅི་ཡང་མ་ཡིན་པའི་ཏིང་ངེ་འཛིན་ཅེས་བྱ་བ་ཡོད་དེ་ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "རྒྱུ་ཅི་ཡང་མ་ཡིན་པའི་ཏིང་ངེ་འཛིན་ཅེས་བྱ་བ་ཡོད་དེ་ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཡང་དག་པར་གསལ་བའི་ཏིང་ངེ་འཛིན་ཅེས་བྱ་བ་ཡོད་དེ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "རྣམ་པར་དག་པ་ཡོངས་སུ་རྫོགས་པའི་ཏིང་ངེ་འཛིན་ཅེས་བྱ་བ་ཡོད་དེ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགས་པའི་ཏིང་ངེ་འཛིན་ཅེས་བྱ་བ་ཡོད་དེ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་མི་དམིགས་པའི་ཚུལ་གྱིས་སྙོམས་པར་འཇུག་སྟེ་གནས་པ་དེ་ནི་ཤིན་ཏུ་རིག་པར་བྱའོ།",
