    "ལྷ་ནི༵་མི་ལས༵་མཛེས་སོགས་ལྟ་བུའི་དཔེ་བརྗོད་ཤིན་ཏུ་མང་བ་རྣམས་ཡིན་རྒྱུ་ནི༵་སྒྲ་དགར་བ་ལ་འཇུག་པའི་དཔེར་བཀོད་འདུག་ཀྱང་དོན་དུ་དགར་བའི་དོན་དངོས་ནི༵་སྒྲས་བསྟན་ནམ་ཡང་ན་ནས༵་དང་ལས༵་ཀྱིས་བསྟན་གང་ཡིན་ཕན་ཚུན་འདྲེས་ཤིང་མི་གསལ་བ་དང་།",
    "འཇུག་ཡུལ་གཉིས་པོ་དེ་གང་འདྲ་ཞིག་ལ་ངོས་འཛིན་དགོས་མིན་དབྱངས་ཅན་གྲུབ་པའི་རྡོ་རྗེ་ཁོང་རང་ཉིད་ཀྱིས་མཛད་པའི་རང་འགྲེལ་ནི་མེད་པས།",
    "རི་བོ་དེ༵་མཐོ་ཞིང་བརྗིད་ཆགས་པ་ཞིག་འདུག།",
    "ཡུལ་ལྗོངས་དེ༵་མཛེས་ཤིང་ལྟ་ན་སྡུག་པ་ཞིག་འདུག།",
    "མི་དེས་ཆས་ཡ་མ་ཟུང་ཞིག་སྤྲས་འདུག།",
    "རང་ཡུལ་དུ་འབྱོར་ཅེས༵་བྲིས་འདུག།",
    "དགོངས་ཤིག་དུས་གསུམ་བདེ་གཤེགས་དང་།",
    "མ་ཧཱ་གོ་རོ་ཙ་ན་༴",
    "འོན་ཀྱང་རང་ཉིད་ལ་མཚོན་ན་བསྟན་བཅོས་འདིའི་གཞུང་ལུགས་ཤེས་ཚད་ཞན་པ་དང་།",
    "ལྟ་བ་ཁག་ཅིག་དུས་ལས་ཡོལ་ཟིན་ཅིང་།",
    "དེར་བརྟེན་དགྲ་དང་རང་ཕྱོགས་གཉིས་ཀའི་ཚུལ་རྟོགས་ན་ལན་བརྒྱ་འཐབ་ཀྱང་ལན་བརྒྱ་ཕམ་མི་སྲིད་པ་དང་།",
    "དགྲ་བོའི་སྣང་ངོར་སྙོད་ཆུང་ནུས་མེད་ཀྱི་འཁྲུལ་སྣང་སྟོན་པ་དེ་ཡང་རང་ལ་སྟོབས་དང་ལྡན་པའི་དམག་དཔུང་ཞིག་ཡོད་པ་ལས་བྱུང་བ་ཡིན་དགོས།",
    "དགྲ་བོའི་དམག་སྒར་གྱི་ཕྱི་ནས་མེ་བརྒྱབ་ནའང་འགྲིག་ཕྱི་ནས་མེ་རྒྱག་དུས་ནང་ནས་རམ་འདེགས་བྱེད་མཁན་སྒུག་མི་དགོས་པར་སྐབས་ལ་བབས་ན་མེ་རྒྱག་རྐྱང་བྱས་ན་འགྲིག་ལྷག་པ་ཡོང་ས་ནས་མེ་རྒྱག་དུས་ལྷག་པ་འགྲོ་སནས་ཕར་རྒོལ་བྱེད་མི་རུང་།",
    "ཚིག་དེ་ལྡེབམ་དེའི་མདུན་རྒྱབ་ཀྱི་ཕྲེང་གར་ཡོད་ཀྱངམིནོར་བར་མཁྱེན་པའི་ཤེས་རབ་ཀྱི་བསབསམ་ལས་འདས་པ་ཞིག་ཏུ་བྱུང་འདུག།",
    "སམཡང་ཤ་ཟམཁའ་འགྲོའི་རིགས་ཅན་ཡིན་པསདེང་སང་གནས་ཡུལ་ཀུན་ཏུ་ཉུལ་བའི་ཤཟམཁའ་འགྲོ་ཞིག་དུ་སྐྱེས་ནས་སྐབས་དེར་ལུང་སྟོན་པའང་བྱེད་འདུག་གསུངས།",
    "སེམས་དོན་གྱི་ངོ་སྤྱོད་ཕུལ་བས་ཕྱིས་ཀྱང་སེམས་ཀྱི་ངོབལདེལ་ས་བོགས་དབྱུང་དུ་མི་འདུག་གསུངས།",
    "བྱམས་པའི་སྐུ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་ཐིགས་པས་འཇིགལ་ཁདདུའདུག།",
    "མཧཱསནྡྲི་པ་ཨ་ནུ་ཧི་ཏུའང་བཞུགས་འདུག།",
    "སྟོད་ཆ་དེར་ཚིག་འགའ་ཞིག་འདུག་ཀྱང་བརྗེད།",
    "གཤམ་དེར་སྙན་བརྒྱུད་འཆི་མེད་བཅུད་ལེན་ཟུར་དུ་བྲིས་པ་འདིཛིལྟ་བ་བཞིན་གདའ།",
    "འདི་ལྟར་འདུག་ཅེས་ཞུས་པས།",
    "དམཚིག་གཙང་བ་ཡིན་འདུག།",
    "ལུད་ཡོད་ཀྱང་བརྒྱུད་པ་ངེས་འདྲོངསམི་འདུག་གསུངས།",
    "འདི་དེ་ཙམགྱི་རྙིང་མ་བཅའ་བ་སོགསམི་འདུག་པས་ནམ་ཅི་ཆེ་གསུངས་པས།",
    "ཁྱེད་རང་གསུམཙམ་མགཏོགསསྐས་ཆེན་འདི་ཚུགས་ཐུབཔནི་སུའང་མི་འདུག་ཟེར་བཞིག་བྱུང་བས་འདི་ལའང་གོ་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་གསུངས།",
    "སྦངཝོདཱནེའུ་གསེར་ཆུ་མཚོ་རྣམསལམེ་ཏོག་དཀར་དམར་སོགས་ཀྱིས་སྤུས་ཤིང་ཤིན་ཏུ་ཉམས་དགའ་ལ་ཡིད་དུ་འོང་བ་ཞིག་ཏུ་ཕེབས་འདུག་པར།",
    "དེ་ལྟར་ཚེས་༧ཡོནཏནལྟཞོ་འཇིག་རྟེན་ཀྱི་༡ལཛེས་ནསལྕང་ལྗོཉིད་ཀྱི་ཡབ་དེ་ཤིན་ཏུ་བློ་དྲང་ཞིང་ངོ་ལྐོག་ཐུབ་པ་ཞིག་ཡོད་འདུག་སྟབས།",
    "རྗེཉིད་སྐུན་གཞོན་ནུའི་དུས་སྐུ་གཟུགས་ཐང་པོ་ཞིག་ཡིན་འདུག་རུང་།",
    "ཨེཝཾ་ངོར་ཐར་རྩེ་བླབྲང་རང་དུ་གཏན་བཞག་འབུལ་རྒྱུ་ཐུབ་དབངགར་ཤརམི།",
    "བླཡསྐུ་བཞིའི་ཚོསཾསྐོརནིཚེས་བཅུའི་སྐུའི་རྣམ་འགྱུར་རྣམས་གཞིར་བྱས་པའི་སྒྲུབ་ཐབས་རྒྱས་འབྲིང་བསྡུས་གསུམ་དུ་བཞུགས་པའི་རྒྱས་པདེཡིན་པར་འདུག་ཀྱང་།",
    "ཞེས་གསུངས་པའང་ཇི་བཞིན་བྱུང་བར་འདུགགོ།",
    "ཁྱེད་སྔ་འགྱུརལཙཱབ་ཡིན་ན་རྗེ་འབངས་ཉེར་ལྔའི་གྲལ་དུ་མི་འདུག་ན་གསུངས་པས་རྗེའབངས་ཉེངལ་ཐུལ་དུ་ཡོད་རུང་མེད་རུང་ངེད་རང་ལ།",
    "དེར་ཤིཨོ་སྔོན་པོའིསྤྱིལ་བུ་ཞིག་འདུག་པ་སྒོར་ཕེབས་པས།",
    "བསྒོམས་ནས་ཉམ་ཆུང་རི་ལ་རྒྱས་པ་ཡིན་ཟེར་མཁན་ནི་སྲིད་མཐའ་མ་བཀག་ཙམ་ལས་མི་འདུག་གྲུབ་ནས་བརྟུལ་ཞུགས་སྤྱོད་པ་ཡིན་གསུངས་མཁནན་མང་བར་འདུག་པས།",
    "དེནས་བརྩམས་ལོ་བཅུ་གཉིས་བར་དུ་ལོ་ལེགསསྐྱརྒྱལ་བྱུང་བར་འདུག་གོག་ཐུབ་ཙམ་ནས་གཙང་སྦྲ་ཤིན་ཏུ་ཆེ་བས་གཅིན་གཏུགས་ཕབྲད་དུ་སྐྱེལ་བ་ཡིན་ཟེར།",
    "ལོ་དྲུག་པ་བདུན་པ་གཉིས་ལ་ཀློག་སློབ་འདུག་པས་འབྲུ་དེད་ཅུང་ཟད་དང་།",
    "ཕྱིས་བསམ་དུས་ད་ལྟ་མི་གྲལ་ཚུད་ཙམ་འདི་ཐགན་དེའི་དྲིན་ཡིན་པར་འདུག་པས་དྲིན་ཤིན་ཏུ་ཆེ་ཞིང་།",
    "དེ་འདྲའིམ་དྲང་པོ་དང་ཤེས་པ་ཅན་ད་ལྟ་ནི་ཡོད་དཀའ་འདུག་སྙམ།",
    "ཕྱིས་ཀྱི་མི་རབས་གསུམ་ཙམ་ལ་རྟེན་བཞེངས་འཚོགས་སྒོ་སོགས་གང་རྒྱས་བྱུང་བར་འདུག་ཀྱང་།",
    "བེ་རོ་ཙ་ན་རྣམས་ཀྱི་སྐུཕྲིས།",
    "དེ་ལས་སད་ཙ་ན།",
    "ཁམཁས་འདུག་གསུངས།",
    "འདི་ཉིན་ཁ་བ་ཆེ་བ་ཞིག་བབ་པ་ལམ་བཀྲ་ལེགས་པའི་མཚན་མར་འདུག་ཕྱིར་ཉིན་ནས་འཇམ་མགོན་བར།",
    "ཕྱིས་ཀྱང་དོ་ཕོ་ལནི་དེ་ཀ་ལས་འཕོ་འགྱུར་མི་འདུག་སྔགས་རམ་པ་ཀུན་བཟང་བསང་སྔགས་དེ་ཉིད་མདུན་ནསཀྱང་སྨིན་གླིང་སྡོམ་གསུམ་ཁྲིད་དང་།",
    "དེ་གའི་ཚེས་དྲུག་ལ་བསྙེན་རྫོག་ས་ཁུ་མཁན་ཁ་ཤས་འདུག་པ་ན།",
    "ཚུར་ནང་དེ་ནས་ཆུ་ཆེན་པོ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་བབས་འདུག་པ་ད་ཅིའི་རྨི་ལམ་བཟུང་བ་དེ་བརྗེད་ནས་སྐྲག་སྔངས་སྐྱེས་པ་དང་སད།",
    "འདུག་དུས་དྲན་ཤེས་བསྟེན།",
    "དེར་ཀླུགས་ཤི་ཙམ་སྙམ་པ་དང་རང་སྔོན་དུ་ཕྱིན་འདུག་པས་པདྨ་ཉིན་བྱེད་དུ་བསྒོམས་ཤིང་གསོལ་བ་འདེབས་པའི་འཕྲོར་སད།",
    "ཁྱད་པར་ཕྱག་ཆེན་རྒྱ་གཞུང་སྐབས་དཔའ་པོ་རིན་པཆེ་ཉིད་ཁྲི་མཐོན་པོ་ཞིག་ཏུ་བཞུགས་པའི་མདུན་དུ་ཚེ་རིལ་དངཤིང་ཏོག་སོགས་བསྲེས་པ་མང་དུ་བཞག་འདུག་པ་རྗེ་ཉིད་ཀྱི་སྙེམས་པས་བཅུས་ཏེ།",
    "གྱུར་འདུག་པས་ཁམས་གསུམ་ཐམས་ཅད་ཞིང་ལྤགསཀྱིས་བརྡབས་ནས་ཟིལ་གྱིས་མནན་པ་དང་།",
    "སཾ་སྐྲྀ་ཏའི་སྐད་སྨྲ་བའི་དོ་ཤེས་གཉིས་འདུག་པ་ལ་རྡོ་རྗེ་གདན་དད་བྱདོད་སྤུངས་རིར་འགྲོས་ནི།",
    "ལག་ཏུ་འབད་མེད་ཐེབས་འདུག་པས།",
    "རང་ཡུལ་དུ་ས་གཡོས་སྦྱན་གྱིས་ཁང་ནོར་ཐམས་ཅད་ཤུལ་མེད་བཏང་འདུག་པས་མརྒན་ཀྱང་ཕྱིར་སློབས་ཙབྱུང་བས་ཡིག་དྲུག་བཏོན་ནས་མཉམ་དུ་བསྡད།",
    "སྤྲིན་དཀར་གྱི་དབུས་ན་རཱ་ལོ་ཙཱ་བ་རྡོ་རྗེ་གྲགས་གསལ་བར་བཞུགས་འདུག་པ་དང་།",
    "བི་མ་ལ་བཅས་གསུམ་གཟི་བརྗིད་དང་ལྡན་པར་བཞུགས་འདུག་པ་མཐོང་ནས་ས་ལ་བབས་ཏེ་སྐོར་བ་དང་།",
    "ཁྱེད་རང་རྗེས་ལ་བྱོན་དང་།",
    "དེ་ཕྱོགས་གཞི་བདག་དྲག་རྩལ་ཅན་འགའ་ཞིག་ཡོད་འདུག་པས་ཡིན་ནམ་ལན་ཅིག་ཉིན་རིལ་པོར་ང་བརྒྱད་ཕྱོགས་ཀུན་ནས་སེར་བ་བབས།",
    "འདི་ནིཕྱིས་སུ་མཆོག་གྱུར་གླིང་པས་ཐུགས་སྒྲུབ་བར་ཆད་ཀུན་སེལ་གནང་བ་ལ་བལྟས་འདུག་དབྱར་ཐོཔ་ཏུ་བྱིས་པ་ཁ་ཤས་འཚོགས་རྒྱུ་ས་དཔོ་ངས་འདུས་བྲིས།",
    "མཆོད་ཁྲིར་གླེགས་བམདམར་པོ་འདུག་པ།",
    "ཕྱི་དོལུང་པའི་སྐེད་ཙམ་སློབཔཆུ་ཕར་ཀ་དེར་འབྲོག་དུདབྱུག་པོ་ཞིག་འདུག།",
    "དེཔགཙང་སྦྲ་ཤིན་ཏུ་ཆེ་བ་ཡིནཔས་དཔོན་སློབ་ནས་ཐོ་གཏོར་སོགས་འབག་འབོག་མི་མཛད་པར་ཞུ་འདུག་དེ་ནུབ་ཐུགས་དམ་འདྲ་མཛད་ཀྱིན་བཞུགས།",
    "གནས་རཚང་ནས་བཀའ་བརྒྱུད་ཁྲོ་རོལ་བཅའ་སྒྲུབ་དགོས་པས་འོད་ངོགས་བྱས་འདུག་ཀྱང་ཁོམས་ལྕོགས་མེད་པསཚབ་ཏུ་སྐྱ་གཏེར་བཏང་།",
    "འདི་པ་ཀུན་གཞི་བཟང་བ་སོགས་གང་ལ་བརྟགས་ཀྱང་གཞན་དང་མ་འདྲ་ཙམ་ཞིག་འདུག་པས་ཁོང་དང་གསུང་ལྟརགཏེར་སྟོན་ཞིག་ཡིན་ནམ་སྙམ།",
    "ས་དམིགས་བཙལ་བར་ཕེབས་པས་སེང་བུ་ནས་རྙེད་འདུག་སྒྱུར་པ་དེར་སྨོས།",
    "གཏེར་གསརཚེ་བདག་པར་སོགསཞབས་བརྟན་མང་ཞིག་བསྒྲུབ་དགོས་འདུག་པ་རྣམས་ཞུས་གྲུབ་ནས་དབུས་རི་བར་བསྐོར་ཀྱོག་རྩིསཀྱིས་ལྷ་ལྡན་དུ་ཕྱིན།",
    "འདི་ཉིན་རྒྱང་བལྟས་མཁན་རྣམས་ཀྱིས་ངེད་རང་རྣམསཀྱི་མཐའ་བསྐོར་དུ་འཇའ་དཀར་པོ་ཨ་ལང་ལྟ་བུསབསྐོར་བ་མཐོང་འདུག།",
    "ཡང་རྒྱལ་བོ་བེ་ཧར་ནས་ངེད་ལ་གུ་རུ་པདྨས་བོད་ཡུལ་ལྷ་ཁང་བྲེ་ཞབས་ཙམ་ཡན་གྱི་གཉེར་དུ་བརྙེས་པ་ཡིན་ཀྱང་ཁྱེད་རང་རྣམསཀྱིས་གསོལ་མཆོད་སྣེ་གཅིག་ཙམ་ཡང་མི་བྱེད།",
    "མཁའ་འགྲོས་སྒོ་ཕྱེས་པའི་སྟོབས་ལས་བྱུང་བཡིན་འདུག་པས་འདི་ཉིད་མཛོད་ཆེན་ལྔའི་ཐོག་མ་ཤེས་བྱ་མཛོད་དུ་བཞག་རང་འགྲེལ་ཅིག་ཅིས་ཀྱང་དགོས་ཞེས་ལེགས་སའི་གནང་སྐྱེས་སྩལ།",
    "སྔོན་དུས་སྲས་གསར་འཁྲུངས་ཀྱི་སྐུ་རིམ་བསྒྲུབ་སྐབས་ཞིང་ཤིན་ཏུ་ཆེན་པོ་ཞིག་ཐ་བར་ལུས་པའི་ལྷགཟུར་ཞིག་ཏུ་མེ་ཏོག་ཕྲམ་འགའ་ཞིག་འདུག་པ་དང་།",
    "བོད་གཞུང་ས་ཆེན་པོས་ཞབས་པད་ཕུ་ལུ་ང་པ་སོགས་དཔུང་དམག་མང་པོས་གནམ་ས་འགུལ་བ་ལྟར་ཕྱིར་འོང་པའི་ཟིང་ཆ་ཆེ་སྐབས་སུ་སེང་ཀམ་ཐོག་དུས་སྤུ་ཇེདཔོ་ཤི་སར་མ་འོང་ཐབས་མེད་ཟེར་བའི་དཀའ་བྱས་ཆེན་པོས་ཁྱུགས་ཙ་མ་ཕྱིན་ནསཚོ་ག་བཏང་།",
    "བསྐོར་ལམ་ཞིག་འདུག་པ་ནས་བསྐོར་བ་བྱས་ཏེ་ཤེལ་རྡོམང་པོ་བཏུས་ནས་རུམ་དུ་བཙུད་པ་ཞིགརྨིས།",
    "དབོན་སྤྲུལ་པ་ཉག་ཁོག་ཕེབས་དགོས་བྱུང་སྟབས་འདི་ལ་དབྱར་གནསའཛུག་མཁན་མི་འདུག་པས་དགེ་སློང་བཅུ་གསུམ་སྐོར་སྒྲུབ་ཁང་འདིར་དབྱར་གནས་མཛད་རྒྱུའི་མཐུན་རྐྱེན་སྒྱུར།",
    "གཤིན་རྗེ་གཤེད་པོའི་ཞལ་འབགས་ཟིལ་ཅན་ཤིན་ཏུ་གཉན་པ་ཞིག་འདུག་པ་གྱེན་ནས་ཚོམ་རྡམ་བྱས་པ་དང་།",
    "དགུརའདུག་དེ་སྔ་བླ་བྲང་ནས་ཅིའང་མ་ཐེངས།",
    "ཟླ་བ་བཞི་པར་སྒྲུབ་ཁང་མདུན་གྱི་སྤང་ཐང་དུ་སྒར་པ་མཛད་འདུག་པར་ཕྱིན་ནས་ཚེས་བཅུ་བཞི་ལ་དཀོན་རྣམ་བཅུ།",
    "འདིར་ལེགས་འདུག་པས་དེ་རྗེས་ར་བསྒྲིགས་དགོས་གསུངས།",
    "འདིར་མཁའ་འགྲོ་འཁྲུགས་པས་གནོད་པར་འགྱུར་བ་ཡིན་འདུག་ཅེས་ཕྱིར་དང་གསུང་འཕྲོས་དང་།",
    "ནར་བའི་ཁང་པ་དང་རྒྱན་སོགས་ལ་ལོངས་སྤྱོད་པའི་ཡ་མཚན་ཅན་ཞིག་འདུག་སྙམ་བྱེད་པའི་ངང་དེ་ལས་སད།",
    "དོཇི་འཚོ་འདི་དུསརྒྱུན་དྲན་ལམ་གསལ་བར་འདུག་གསུངས་པས་སར་གནས་རྣམས་ཀྱི་སྤྲུལ་པ་ལ་ཚད་བཟུང་མེད་པས་འདིའང་སྐུའི་བཀོད་པ་གཅིག་ཡིན་པར་མངོན།",
    "སུ་དགོན་ཆེན་ལ་ཚེས་བཅུ་དགུར་ཕྱིན་པའི་སྔ་ཉིན་ཐད་རྒྱལ་ལྷ་ཁང་ནས་ཚེ་འངའ་བལྟམས་མ་ཐགཕྱུར་བའི་ཆོ་འཕྲུལ་ཡང་བྱུང་འདུག་ཉིཤུ་དང་དེར་སྲིབ་དགོན་དུ་དཔོན་སློབ་ཁ་ཤས་འཚོགས་ནས་ཨར་གཏད་བདུན་གཅིག་བསྒྲུབས།",
    "གཏེར་སྟེན་ཀྱང་ལ་ཐོག་བར་བསུ་མར་ཕེབས་འདུག་དགོན་དུ་ཡབསད་ནས་ཁོང་པའི་གཏེར་བསར་པོད་བཅུ་གསུམ་མཇལ་ཁ་བགྱིས།",
    "སྒོ་ཡིག་སྦྱར་བ་བཅས་དམ་སེལ་ཆེན་པོའི་ཐོག་མ་ཚུགས་པས་དེའི་ལྟས་ཡིན་པར་འདུག།",
    "ཐར་རྩེ་ཞབས་དྲུང་དང་རང་བཅས་ཀྱིས་གཟུངས་སྒྲུབ་དང་།",
    "ཉིད་ཀོ་ཇི་སེར་ཁུག་ཅིག་ལ་དབུ་གཏད་ནས་གཟིམས་འདུག་པར།",
    "བྱིན་འབེབས་མངའ་གསོལ་ཤིས་བརྗོད་བགྱིས་སྐབས་ཉམས་ལྟས་ལེགས་ཕྱི་རོལ་ཏུའང་འཇའ་ཚོན་དང་མེ་ཏོག་ཆར་པ་འདུག་ཟེར།",
    "སྐུ་སྨད་མེད་པ་གཅིག་རྣམས་ངེདལ་གནང་ནས་གཅིག་འདི་གསོ་དགོས་གསུངས་པས་འདི་ངོས་ནས་ཐོན་དཀའ་ཞེས་འཚོར་བག་བྱེད་པའི་མནལ་ལམ་བྱུང་གསུངས་པའདི་ཕྱིས་འབྱུང་ལྟས་སུ་འདུག་འདི་སྐབས་རྩ་གསུམ་བཀའ་འདུས་རྟེན་གུ་རུའི་དམ་ཚིག་རྡོ་རྗེདྷི་ལོ་ལས་གྲུབ་པ་མུན་ནང་འོད་འབར་བ་དང་།",
    "གཉན་ལྡང་དུ་འདུ་པའི་ལྟས་འདུག་རྒྱུ།",
    "རྫོགས་པ་ཆེན་པོ་རང་སྣང་རིས་མེད་ཀྱི་དགོངས་པའི་རྩལ་རྫོགས་པ་ཡིན་འདུག་པས་ཨོ་རྒྱན་ཆེན་པོ་དང་བི་མ་ལ་ཉིད་ལས་གཞན་དུ་མ་མཆིས་པའི་ངེས་ཤེས་སྐྱེས།",
    "སྣང་སྲིད་མཚོ་སྐྱེས་རྡོ་རྗེའི་དཀྱིལ་འཁོར་དུ་ཤར་བ་སོགས་བྱིནརླབས་ཀྱི་བབ་ཆེ་འདུག་གསུངས།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་ལས་དོན་འགའ་རྩོམ་པ་དེ་ལ་བྱ་མ་ཉྙ་རྣམ་པརྒྱ།",
    "ཕྱགགཡོན་བེ་རོའི་དབུར་བཞག་བཀའ་ལུང་ཡོད་དུསྩལ་འདུག་པ་ཡུད་ཅིག་མཇལ་བ་རྨིས།",
    "ངེད་རོང་རང་གནས་སུ་འཁོར།",
    "གཏོར་ཆེན་མདུན་ངོས་ཉིལ་འདུག་ལྕགས་འབྲུག་གནམ་ལོ་གསར་ཚེས་ནང་སྔ་རྒྱུན་ལྟར་གྱི་རྡོར་སེམས་དང་།",
    "རི་ཆེན་དང་གནས་ཆེན་བཞིར་ཚོགས་འཁོར་ཐོག་མ་རྣམ་བརྒྱ་། དྲུབབས་འདུག་པས་ཉེ་ཕྱོགས་རྣམས་སུ་གཏེར་སྟོན་དང་ཆབཅིག་བགྲོད་ནས་དེ་དག་ཚང་པ་བསྒྲུབས།",
    "བཞི་བཅུ་ཙམ་བརྐོ་གྲུབ་འདུག་པས་ཞུ་དག་པ་ལྷག་བསམ་དང་ལྷན་ཅིག་གོ་རིམ་བསྒྲིགས།",
    "ཚེས་བཅུར་རྩ་གསུམ་སྤྱི་འདུས་གསར་ཕབམཛད་འདུག་པའི་ཚོགས་བཏང་།",
    "བྱིལ་གནོན་གྱི་སྒྲ་ཞིག་བར་སྣང་དུ་གསལ་བའི་གདོན་འོག་ཏུ་ཚོགས་བཅད་ཡིག་ཕྲེང་གཉིས་འདུག་པ་བཀླགས་པས་ཡིད་ལ་ཟིན་པར་རྨིས།",
    "རྡོར་གླིང་ཚེས་སྐོར་འདི་ནམ་གསུང་བའི་སྐབས་མདུནམཁར་རྡོར་གླིང་དངོས་སུ་བཞུགས་ཡོད་པའི་ཉམས་དང་སྣང་སེམས་རོ་གཅིག་སྐྱ་འདྲེསཔ་ཞིག་བྱུང་འདུག་གསུངས།",
    "འདི་ལྷོ་ཕྱོགས་དཔལ་གྱི་ནི་ཚེའཕགས་མཆོག་ཀླུ་སྒྲུབཀྱིས་ལྟ་བ་བཙུགས་པ་འཁྲུལ་མེད་དེ་ཡིན་ཀྱང་བར་ལམ་ནས་ཅུང་ཟད་རྙེདསེད་བས་ཉིད་ཀྱིས་བཀའ་འདུས་བུམ་ཆུ་དེས་བྲ་ཙ་ན་སོས་འོད་ཟེར་ཕུལ་བྱུང་བ་ལ་གཞི་སྟེང་ཡོད་པའི་བཀའ་འདུས་བུམཆུས་བྲན་མ་ཐག་པར་མེ་ཏོག་སྔར་ལས་ཆེར་རྒྱས།",
    "དགོངས་རྫོགས་སྒྲུབལུགས་རྒྱུས་ཡོད་སོགས་ལ་ངེད་རང་འཕྲལ་དུ་འོང་དགོས་པའི་གསུང་བྱིས་བོངམི་བཅས་དབོནན་སྤྲུལ་མདུན་ནས་མཛད་འདུག་པ་ལྟར་ཕྱིན།",
    "ཞབས་བརྟན་རྒྱབ་ཆོག་སྐོར་མང་ཙམ་བསྒྲུབས་འདུག་ཀྱང་།",
    "སེམས་ཉིད་ངལ་གསོ་དང་རང་སྲོལ་སྐོར་གསུམ་གྱི་ཁྲིད།",
    "སྨིན་གླིང་གཏེར་ཆེན་གྱི་སྐྱེས་རབས་ཡས་གྲགས་བཅུ་བཞི་མ་ནི་གཙོ་བོ་རགས་བསྡུས་ཡིན་པར་འདུག་ཅིང་།",
    "གཏེར་གཞུང་དང་རང་ཉིད་ཀྱི་མཁྱེན་ངོར་གསལ་བ་ནི་རྒྱལ་སྲས་པདྨ་འགྱུར་མེད་རྒྱ་མཚོས་མཛད་པ་ལས་འདི་ལྟར་འབྱུང་སྟེ།",
    "སྤྲུལ་པའི་ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ན་ནི།",
    "མཚན་ཡང་བེ་རོ་ཙ་ན་རཀྵི་ཏ་ཞེས་གསོལ།",
    "དེ་ཕྱིར་འདི་ཡང་རང་ལ་ཐོལ་བསྟོད་དང་།",
    "བློམ་མཁས་གྲུབ་རྣམསཀྱི་བཀའ་དྲིན་ལས་བསླབ་གཉེར་འདེགས་པོ་ཤེས་པ་ཙམ་ཡང་ད་ནི་བརྗེད་ནས་མི་འདུག་སོགས་ཁོ་ན་གསུངས་ནས་དམན་པའི་ཚུལ་དུ་བཞུགས།",
    "ཕྱིས་སུ་གཟིམ་གཏན་ནས་ཁུག་མི་འདུག་ཐེབས་ཀྱང་མདུན་དུ་གཅར་མཁན་གྱི་བརྟག་དུས་མནལ་དུ་འགྲོ་བར་སྣང་བས་དེ་ནི་ཉིན་མཚན་འདྲེས་པའི་རྟགས་ཡང་དག་གོ།",
    "མདུན་དུ་གཉུག་མར་གནས་པའི་ཕྱི་ལ་ཐུགས་བརྩེ་བཞིགཚོའི་དུས་བྱུག་པས་སྐྱབས་མགོན་པདྨཏིན་བྱེད་མདུན་ཡང་བསྔོ་རྟེན་ཕུལ་བས་དེ་ཉིན་པདྨ་བཛྲའི་གནས་འདྲེན་མཛདཔ་དང་ཁེལ་ཡོད་འདུག་པས་དེ་ཡི་ཐུགས་རྗེ་ལོས་ཡིན།",
    "ལུས་ཟུངས་ངན་པས་རང་གཞནལ་ཟག་པ་སོག་པའི་སྤྱལུས་གོག་པོ་འདི་དོར་ན་རུང་སྟེ་ད་དུང་དབུགས་རྗེ་ནི་ཆད་ཐུབ་པ་མི་འདུག།",
    "སླད་ནས་ཉེ་གནས་དམ་པཚེ་རིང་དོན་ཀུན་གྲུབ་པས་ཀྱང་འདི་བགྱིས་གྲུབ་པ་ཉིད་ཀྱང་ལེགས་འདུག།",
    "དེ་དག་རྣམས་ཀྱང་འཛིན་པར་བྱེད་ཅིང་ཡང་གང་དག་དུས་ཤིན་ཏུ་རིང་བ་ན་དཀའ་བླས་ཆེན་པོས་ལྡང་བར་འགྱུར་ཏེ།",
    "དེ་དང་རང་བཞིན་མཚུངས་པ་འབའ་ཞིག་དང་བརྗོད་པ་དང་གསོད་གསལ་དང་ཀུན་རྗོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "འཆི་བདག་དུས་ནི་ཉེར་བྱུང་ལ།",
    "དེ་དང་ཡང་དག་པར་ལྡན་པའི་དགེ་སྦྱོང་ངམ་བྲམ་ཟེའམ་དེ་དག་དང་རང་བཞིན་མཚུངས་པར་གྱུར་པ་གཞན་རྣམས་ཐམས་ཅད་དང་།",
    "བྱི་དོར་བྱས་ནས་ཀྱང་དམན་ཞིང་དམན་པའི་སེམས་ཀྱིས་སྟན་ལ་འདུག་པར་བྱའོ།",
    "ས་མཚམས་རིགས་པ་མ་ཡིན་པར་ཀུན་ཏུ་གོ་བར་བྱེད་པའི་གནས་མལ་རྣམས་ལ་བརྟགས་ཏེ་འདུག་པར་མི་བྱ་བ་འདི་ཉིད་ནི།",
    "གཞན་ཡང་དེ་དང་རང་བཞིན་མཚུངས་པ་རྣམས་ཀྱི་ཡིད་ལ་བྱའོ་ འདིའང་གང་ཞེ་ན།",
    "ཤིན་ཏུ་སེམས་སྟོབས་ཡང་བར་གྱུར་པ་འདུག་པའི་ས་མི་ཟིན་པས་ཉེ་བར་བཅོམ་པ་རྟག་ཏུ་འཕྲད་པར་བྱེད་པ་རྟག་ཏུ་ཞབས་འབྲིང་བྱེད་པ་ཡིན་ནོ།",
    "སྐད་ཅིག་མ་ལུས་པར་རབ་འདུག།",
    "ཙུན་ཙུ་ར་ཀ་ཞེས་བྱ་བའི་ངའི་སྲིན་གྱིས་ཀྱང་རང་བཞིན་དུ་གནས་པའམ་རང་བཞིན་དུ་མི་གནས་པ་ཅི་བྱེད་པ་ཡིན་ན།",
    "གལ་ཏེ་ཡང་རང་ལྟོགས་པར་གྱུར་ན་ནི།",
    "ཡང་གལ་ཏེ་བདག་ཉིད་ལྟོགས་པར་གྱུར་ནའང་རང་བཞིན་དུ་གནས་པའམ་རང་བཞིན་དུ་མི་གནས་པ་ཅི་ཞིག་བྱེད་པ་ཡིན་ན།"
  ]
}