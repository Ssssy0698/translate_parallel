    "བདེན་པ་འདུག་པས་ད་ཝཱ་རཱ་ཎ་སིའི་རྒྱལ་བོ་སོད་ཅིག་ཤེས་རབ་ཅན་གྱི་ཅི་དགོས་སྦྱོར་དང་རིམ་པས་བགྱིའོ་ཞེས་ཁས་བླང་ངོ།",
    "འོན་ཀྱང་ཁོ་བོས་ཕུལ་ཡང་ཁྲོན་པ་འགྲོར་མི་འཚལ་ཏེ་ང་རྒྱལ་པོའི་ཁབ་ཏུ་འགྲོ་དགོས་ན་འཁྲིད་མཁན་ཕོ་ཉ་ཞིག་དགོས་དེ་མ་བྱུང་ན་མི་འགྲོ་ཞེས་གླེངས་ཀྱིན་འདུག་པས་མིའི་བདག་པོས།",
    "དེར་ཕྱིན་ནས་རྒྱལ་སྲས་ཀྱི་གཟི་བརྗིད་ཀྱི་ཁྱད་པར་ལ་ངོ་མཚར་བསྐྱེད་དེ་མདུན་དུ་བཞག་ནས་སོ་སོར་རྟོག་ཅིང་འདུག་པ་ན།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "དེ་ཡང་རང་ཉིད་རྣམ་པར་དཔྱོད་པའི་བློ་གྲོས་དང་ལྡན་ན།",
    "དེ་ཡང་རང་གཞན་ཀུན་གྱི་བདེ་ལེགས་ཀྱི་རྩ་བ་གཅིག་པུ་མིང་དོན་མཐུན་པའི་མཁས་པའི་བདེ་བ་ཐོབ་པར་བྱེད་པ་ལ།",
    "དེ་ཡང་རང་བཞིན་བཟང་ཞིང་སྐྱེ་བོ་དམ་པ་མཁས་པ་རྣམས་དང་།",
    "ད་ཁོ་རང་སོད་ཅིག་ཅེས་བསྒོའོ།",
    "རྒྱལ་པོ་བཟང་པོ་གཅིག་བཙལ་ནས་འདུག་གོ།",
    "ཡིད་ཆེས་ཏེ་བདེན་ན་ཁོ་རང་བོས་ཤིང་ཁོ་འོང་བ་དང་།",
    "ལེ་ལོ་ཅན་གྱི་སྐྱེ་བོ་འགའ་ཤས་ཀྱིས་སང་ཟ་རྒྱུ་དེ་རིང་བླངས་པར་བྱས་ཚུལ་དེ་ཆོད་ཆེ་བར་འདུག་བསམ་སྟེ་ཉིན་ཤས་ཟ་རྒྱུ་ལེན་པ་སོགས་བྱས།",
    "དེའི་རྐྱེན་གྱིས་སྤུན་བཅས་ཀྱི་བྲན་རྣམས་བགོས་ཏེ་རང་རང་སོ་སོའི་སྐལ་བ་ཕུང་པོར་སྤུང་སྟེ་བཞག་དགོས་པ་བྱུང་།",
    "དེ་ཡང་རང་བཞིན་གཏིང་དཔག་དཀའ་བའི་བློ་གྲོས་གསལ་ཞིང་ཟོལ་སྤྱོད་ཀྱི་ཉེས་པས་མ་སྒྲིབ་ཅིང་རང་དོན་གྱི་འཁྲི་བ་ཟད་ཅིང་རིས་སུ་མ་ཆད་པའི་བསྟན་འགྲོ་ཁོ་ན་ལ་ཕན་པའི་འོད་ཟེར་འགྱེད་པའི་ཉི་མ་ལྟ་བུའི་བདག་ཉིད་ཆེན་པོ་གནས་ཤིང་བཞུགས་པའི་ས་ཕྱོགས་དེར།",
    "འཁོར་འདུག་རང་ཡང་བསད་ཅེས་གྲགས།",
    "དེ་ཚེ་ཁོ་རང་རིགས་ཡིན་ན་ཁོ་ཡང་བརྒྱལ་ལོ།",
    "རྨོངས་པ་སེལ་བའི་ཐོས་པ་མི་སྒྲུབ་པར་འདི་སྣང་དུ་ལྟོ་བ་འགྲངས་པ་དེ་ཙམ་འབའ་ཞིག་དོན་དུ་གཉེར་བ་ནི་དུད་འགྲོའི་ནང་ནས་ཐ་ཆད་གཙང་བཙོག་མེད་ཅིང་རང་བཞིན་ངན་པའི་ཕག་ལྟ་བུ་ཡིན་ཏེ།",
    "ཡང་དག་པའི་ཆོ་ག་བྱེད་མཁན་དག་ལ་གཤེ་བར་བྱེད་པ་འདི་ཡང་རང་ཚུལ་མི་ཤེས་ཤིང་ལུགས་གཉིས་སྲོལ་བཟང་ཉམས་པའི་རྟགས་ཡིན་ནོ།",
    "ཁེངས་དྲེགས་མཐོ་བའི་སྐྱེ་བོ་རྣམས་ནི་གནས་སྐབས་གཞན་གྱི་མཐུ་ལས་སྐྱོན་མེད་ཙམ་དུ་གནས་ཀྱང་ནམ་ཞིག་ན་གཞན་གྱི་ཐུགས་རྗེ་དང་བྲལ་ཞིང་རང་ཉིད་ཁེངས་མཐོའི་སྐྱོན་གཉིས་ཀྱིས་ཅི་ནས་ཀྱང་ཉམས་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ཝ་ཉིད་ཀྱིས་གཞན་ལས་ཀྱང་རང་ཕྱོགས་ཝ་ཡི་རིགས་ལ་ལྷག་པར་དུ་འགྲན་ཅིང་བསྡུར་ཏེ་རང་སྡུག་གཞན་སྡུག་བྱེད་པ་བཞིན་ནོ།",
    "དེ་ཡང་རང་རྒྱུན་མ་དུལ་བའི་སྡིག་སྤྱོད་ཀྱི་བླུན་པོ་དག་ནི་ཕྱིའི་མི་མཐུན་པའི་རྐྱེན་ལས་སྒོ་གསུམ་ཉམས་པ་མ་ཟད།",
    "དེའི་ཚེ་སྐྱེ་བོ་ཕོངས་པ་ཐམས་ཅད་བསྡུས་རང་རང་གང་འདོད་ལ་ལོངས་སྤྱོད་པ་ན།",
    "དེར་སོལ་བ་ཚོང་མཁན་ཞིག་ཀྱང་བྱུང་སྟེ་ཕན་ཚུན་གཏམ་གླེང་ཞིང་ཙནྡན་གྱི་བདག་པོས་ཡུལ་ཕྱོགས་འདི་ན་ཟོང་ཉོ་བ་པོ་ཡེ་མི་གདའ་འོ་ཞེས་སོགས་བརྗོད།",
    "ཆུའི་ནང་ན་ཤིང་བུའི་ཚལ་བ་ཞིག་འདུག་པ་དེ་མཐོང་བས་འདི་ལགས་སོ་ཞེས་བསྟན་པ་ན་ཐམས་ཅད་ངོ་ཚའི་གནས་སུ་གྱུར་པ་བཞིན་ནོ།",
    "ཡང་རང་ངོས་ནས་ངོ་ཚ་དང་གཞན་ངོས་ནས་ཁྲེལ་བག་མེད་པར་ངོ་ཚ་ཁྲེལ་ལས་བརྒལ་བ་ན།",
    "དེ་ཡང་སྐྱེས་བུ་དམ་པ་རྣམས་གཞན་གྱིས་དབྱེན་དང་ཕྲ་མས་མི་མགུ་ཞིང་རང་བཞིན་གྱི་དབྱེ་བ་དཀའ་བ་ཡིན་ཏེ།",
    "ནམ་ཞིག་དུས་ལ་བབས་པའི་ཚེ་ཆེན་པོ་གཞན་གྱིས་སྨོས་ཅི་ཉམ་ཆུང་རྣམས་ཀྱིས་ཀྱང་བརླག་པ་ཤིན་ཏུ་མང་ངོ།",
    "དམན་པའི་སྐྱེ་བོ་ཡང་རང་ཉིད་དྲན་འགྱུར་ཆེ་ཞིང་།",
    "ད་ནི་ང་རང་ཡིན།",
    "དེ་ནས་ཁྱེད་རང་ང་གསོད་ཅིག་ཅེས་སོ།",
    "འདི་བསྲེག་ན་ཁྱེད་རང་ལ་མི་རུང་བ་འོང་ངོ་བྱས་པས།",
    "ཀྱེ་མ་འཇིག་རྟེན་ན་བྲམ་ཟེ་ཁྱི་འཁྲིད་པའང་གདའ་འོ་བྱས་པས།",
    "ཁོ་རང་ལ་ཟེར་དུ་ཚད་ཙམ་མ།",
    "སྤྲེའུ་དེ་མ་ཧེའི་རྒྱབ་ནས་ཕབ་སྟེ་སླར་ཡང་དེ་ལ་རྣམ་པར་མི་འཚེ་བར་བྱས་ཏེ་འདུག་གོ་ཞེས་གྲགས་སོ།",
    "ཤིང་ཏིན་ཏུ་ཞིག་གད་པ་གཡང་སའི་ཁ་ན་འདུག་པ་ཡལ་ག་འབྲས་བུ་སྨིན་པའི་ལྗིད་ཀྱིས་དུད་པ་གཅིག་མཐོང་ངོ།",
    "གཅན་གཟན་སོགས་ནི་མི་འདུག་མི་ངན་ཁོ་མགོ་སྨད་གདོང་སྐྱེངས་པ་མཐོང་ནས་མི་ངན་གྱི་དྲིན་ལན་ཕྱིན་ཅི་ལོག་དེ་མ་བཟོད་ནས་སྨྲས་པ།",
    "དེས་ན་བྱས་ཤེས་དྲིན་གཟོ་རང་བཞིན་དྲང་ཞིང་རང་ཚུགས་ཐུབ་པའི་བཟང་བོའི་རིགས་ལ་ཕན་ཐོགས་ཅི་འགྱུར་དུ་བརྩོན་པར་བྱའོ།",
    "མ་སྤེལ་བར་ཡང་རང་ཉིད་འཕེལ།",
    "སྤུ་མེད་ལ་རྭ་ཡོད་མངོན་མི་འདུག་པ་འདིས་ཅི་རུང་ཟེར་ཏེ་རྒྱལ་པོ་ཕར་བཞག་བྱ་ཕལ་པའི་གྲལ་དུ་ཡང་མ་ཚུད་པར་ལུས་པ་བཞིན་ནོ།",
    "རྒྱལ་པོ་ལྐོག་ཏུ་འདུག་ན་མཛེས།",
    "མང་པོས་བཀུར་འོས་ཡུལ་གྱི་རྒྱལ་པོ་ལ་སོགས་པ་ཀུན་གྱིས་མཐོང་སར་སྨྲ་བ་ཉུང་ཞིང་ལྐོག་ཏུ་འདུག་ན་མཛེས་ཤིང་ཀུན་གྱིས་བརྩི་བཀུར་ཆེ་བར་འགྱུར་བ་ཡིན་ནོ།",
    "མ་བསྡུས་པར་ཡང་རང་ཉིད་འདུ།",
    "ཀུན་གྱིས་བཀུར་འོས་ཆེན་པོའི་གོ་སར་སོན་པས་རང་ལས་དམན་པ་རྣམས་བྱམས་པས་ལེགས་པར་སྐྱོང་བ་སྟེ་གསུམ་པོ་འདི་ནི་གཞན་ལ་འཕྲལ་དུ་བདེ་ཞིང་རང་ལའང་ཕུགས་སུ་ཕན་པའི་རྒྱུར་གྱུར་པ་ཡིན་ནོ།",
    "དེས་ཀྱང་དེ་ལྟར་བྱས་ཏེ་ཞག་བདུན་ནས་བལྟས་པས་བྱིས་པ་ཆུང་ངུ་བརྒྱ་ཐམ་པར་གྱུར་ནས་འདུག་པ་ལ།",
    "དེས་ན་ཉམ་ཆུང་རྣམས་ཀྱིས་ང་རྒྱལ་དང་ཕོ་ཚོད་སྤངས་ཏེ་བསྲུང་ནུས་ཤིང་རང་བཞིན་བཟང་པོ་དང་ལྡན་པའི་ཆེན་པོ་དག་ལ་བརྟེན་པ་ཤིན་ཏུ་གལ་ཆེའོ།",
    "དེ་ཡང་རང་ཉིད་ལོངས་སྤྱོད་ཀྱིས་དབུལ་ཏེ་ལུས་བཙོང་ནས་གཞན་གྱི་ཟས་གོས་ཀྱིས་འཚོ་དགོས་པའི་བྲན་གཡོག་ང་རྒྱལ་ཆེ་བ་དང་།",
    "དཔེར་ན་གང་ཞིག་རང་རང་ལ་སྐྱབས་ཞུ་བར་འོང་བའི་མི་དེ་བསད་པ་ལ་ཉམས་ཆུང་གསོད་པའི་དཔའ་བོ་ཡིན་ནོ།",
    "དེ་ལ་ཡང་རང་ལ་མི་ཕན་ཡང་བསམ་པ་འཚེངས་པར་འགྱུར་རོ་སྙམ་ན།",
    "བདག་ཅག་རྣམས་ཀྱིས་དགྲ་བོ་འདི་དང་འཐབ་ཏུ་ནི་མི་ཐུབ་པར་འདུག་བསྡུམས་བྱས་ཀྱང་ཧ་ཅང་འགྲས་ཆེ་བ་དཀའ་བར་འདུག་ན།",
    "ཕ་རོལ་པོས་དེ་ལྟར་བྱས་ཀྱང་རང་སེམས་མ་ཐུལ་ན་གླང་ཆེན་སྨྱོན་འདྲའི་སྐྱོན་དུ་འགྱུར་བ་དང་།",
    "ཕ་ཁྲིའི་སྟེང་ན་འདུག་པ་ལ་ཚིགས་སུ་བཅད་པས་བསྟོད་པ་དང་།",
    "རྩོལ་བ་དོར་ནས་འདུག་པ་ལ།",
    "ལྷག་པར་ལྔ་བདོའི་འགྲོ་བ་རྣམས་དམུ་རྒོད་དང་རང་འདོད་སོགས་ཧ་ཅང་ཆེ་བ་ཡིན་པས་ཐམས་ཅད་ཀྱི་བློ་མགུ་ནུས་པ་ཞེས་བྱ་བ་ནི་སུས་ཀྱང་དཀའ་བ་ཡིན་ཏེ།",
    "ད་ཁྱེད་རང་ལའང་ནུས་པ་ཡོད་ན་ཕྲོགས་གཞན་ང་བྲོས་ནས་མི་འགྲོའོ་སྨྲས།",
    "རང་ལ་ཡོན་ཏན་ཡོད་ཀྱང་རང་འདོད་སྤོངས་དང་ནམ་ཐུག་རིང་བ་ཡིན།",
    "དེ་ཡང་ཧམ་ཤུགས་ཆུང་ལ་སྤྱོད་པ་བཟང་པོ་ཡ་རབས་ཀྱི་བསམ་པ་དང་ལྡན་པའི་ཉམ་ཆུང་ཅན་གྱི་གང་ཟག་རྣམས་ཀྱིས་རང་ཉིད་ཀྱི་གང་སྨྲ་བ་བྱས་ཀྱང་དེ་ཐམས་ཅད་འཁྲུལ་བ་ཕན་མེད་གནོད་སྐྱེལ་དུ་འགྲོ་བར་བསམ་པའི་དོགས་པས་ངག་ནས་མི་འདོན་པ་ཁོག་ཏུ་སྐྱེམས་ཏེ་འདུག་གོ།",
    "ད་དུང་རང་རྒྱུད་ཀྱི་སྨད་བྱའི་སྐྱོན་དེ་ཕྱིར་འདོན་པར་མི་བྱེད་པར་གནས་ན།",
    "བྱ་བྱེད་སེམས་བྲེལ་གཡེང་བ་བྱེད་དགོས་ནི་མི་འདུག།",
    "དེ་ཡང་གལ་ཏེ་གཞུང་བཟང་ཞིང་རང་ངོས་ནས་ངོ་ཚ་དང་།",
    "དེ་ཡང་རང་ལ་བློ་ངན་ཀྱག་ཀྱོག་གཡོ་སྒྱུའི་སེམས་ངན་མེད་པར་བཅས་ཏེ།",
    "ནམ་དགོས་ཚེ་ན་ཕྱིར་གཏོང་བའི་ཕྱུག་པོའི་སྦྱིན་གཏོང་རང་དང་རིགས་རྒྱུད་གཉིས་ཀ་མཐོན་པོ་ཐོབ་བྱེད་དང་།",
    "ཐེངས་ཤིག་ཡུད་ཙམ་དལ་བར་མི་འདུག་པ།",
    "དེ་ཡང་དཔེར་ན་རྟ་མཆོག་ཏུ་གྱུར་པ་ཡིན་མིན་འགྲོ་བའི་ཚེ་ན་འགྲོས་བཟང་པོ་དང་ལྡན་མིན་གྱིས་ཤེས་པ་དང་།",
    "དེ་གང་ན་འདུག་པའི་ཕྱོགས་དེའི་མུན་པ་སེལ་ཞིང་སྣ་བས་ཁྱབ་པའི་མཐུ་ནས་ཡོད་པ་དེ་བཞིན་དུ།",
    "སྟན་ཡང་གདིང་ཞིང་ཚུར་ཤོག་འདུག་པར་གྱིས།",
    "དེ་དག་ཀྱང་རང་ཉིད་འདམ་ལ་གནས་པས་གཞན་འདམ་ལས་འབྱིན་པའི་ནུས་པ་མེད་པས་དམན་པའོ།",
    "རྐང་རྟེན་བཅས་པའི་ཁྲི་ལ་རབ་འདུག་ཅིང་།",
    "གོས་ཀྱི་སྟན་དེ་ལ་ནི་རབ་འདུག་ནས།",
    "རང་རང་ཉིད་ཀྱིས་འབུལ་བ་གྱིས་ཤིག་ཅེས་བཅའ་བ་བྱས་སོ།",
    "དེའི་ཚེ་ཤཱཀྱ་མི་བསྲུན་པ་ཐམས་ཅད་ཐུབ་པ་བཞིན་འདུག་པས་ཤཱཀྱ་ཐུབ་པ་ཞེས་བཏགས་སོ།",
    "དེ་ནས་ཙ་ན་ལར།",
    "སྟན་ལྷག་པ་ཡོད་པས་ཁོ་རང་སྡོད་ན་སྡོད་དུ་བས་སོ་ཞེས་བྱས་ཏེ།",
    "དེ་ལ་བསྐོར་ནས་འདུག་སྟེ་མདུན་དུ་ཞ་ལུ་ཏེ་མངོན་དུ་བདར་རོ།",
    "ཡང་འོད་སྲུངས་ཀྱིས་ཁྲི་ལ་འདུག་སྟེ།",
    "སྨྲས་པ་དད་དོ་ཞེས་ཁྲི་ལ་འདུག་གོ།",
    "དེ་ནས་གནས་བརྟན་ཀུན་དགའ་བོ་འཁོར་དང་བཅས་ཏེ་སྨྱུག་མའི་ཚལ་ན་འདུག་གོ།",
    "སྒོ་ང་སྐྱེས་བཞིན་གནས་སུ་འདུག།",
    "སྒྱུར་བྱེད་དམ་པ་བེ་རོ་ཙ་ན་རཀྵི་ཏ་དང་།",
    "ངོས་རང་རྒྱ་གར་གྱི་བུ་ཕྲུག་ཅིག་ཡིན་བསམ་པ་དྲན་བཞིན་འདུག་དེར་བརྟེན་ངོས་རང་འཛམ་གླིང་ས་ཕྱོགས་གང་དུ་བསྐྱོད་ཀྱང་རྒྱ་གར་གནའ་རབས་ཀྱི་འཚེ་མེད་ཞི་བ་དང་།",
    "ང་རང་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ལ་བསྟོད་བཀུར་བསྔགས་གསུམ་ཞུ་མཁན་གྱི་མི་ཞིག་ཡིན།",
    "ལོ་ཤས་གོང་ང་རང་རི་ཤི་ཀེ་ཤིར་གནས་མཇལ་དུ་གོང་ས་མཆོག་དང་ལྷན་དུ་ཡོད་སྐབས།",
    "འོན་ཀྱང་ང་རང་ལྡེ་རྒྱ་གར་དུ་བསྐྱངས་པའི་མཛད་འཕྲིན།",
    "སྐབས་དེར་གལ་ཏེ་ཁྱེད་ཚོས་ཞི་བདེ་དང་འདྲ་མཉམ་གྱི་འཛམ་གླིང་ཞིག་བསྐྲུན་ཆེད་འབད་བརྩོན་བྱེད་ཀྱི་འདུག་ན།",
    "གོ་སྐབས་དམ་འཛིན་ཐོག་ཐེངས་འདིར་འབོད་སྐུལ་གྱི་བསྒྲགས་གཏམ་འདི་སྤེལ་གནང་མཛད་པ་ཞིག་ཡིན་འདུག་དེ་ཡང་བསྒྲགས་གཏམ་དེའི་ནང་འཁོད་དོན།",
    "དེ་བཞིན་རྒྱ་མཚོའི་མཐོ་ཚད་རྒྱས་ནས་དཀའ་ངལ་འཕྲད་བཞིན་པ་རྣམས་ལ་རོགས་རམ་ཞལ་འདེབས་གནང་དགོས་སྐོར་བཅས་འཁོད་འདུག།",
    "རྡ་ས་ནས་ལ་དྭགས་ཀྱི་རྒྱལ་ས་སླེ་བར་གོམ་བགྲོད་ཉིན་གྲངས་༣ ནས་༤༥ བར་འགོར་རྒྱུ་ཡིན་འདུག་པ་དང་།",
    "ང་རང་ངོས་ནས་ད་ལྟ་བར་དུ་གང་ཡོང་བྱས་པ་ཡིན།",
    "དེ་ལ་དམིགས་ཏེ་བསམ་བློ་གཏོང་ཡོང་དུས་གྲྭ་ས་མ་གཏོགས་འགྲོ་ས་མི་འདུགགཞི་རྩའི་དེང་སྐབས་ཨ་རིའི་ནང་ལ་ཡང་བྱམས་བརྩེའི་ཉམས་ལེན་ཐོག་དོ་སྣང་ཆེན་པོ་བྱེད་བཞིན་པ་དང་།",
    "ཧ་ཅང་ཡག་པོ་བྱུང་འདུགཐུགས་རྗེ་ཆེ།",
    "ཞེས་གསུངས་འདུག་དེར་བརྟེན་དེའི་ཚེ་དེའི་དུས་རྒྱ་གར་འཕགས་པའི་ཡུལ་དུ་འཇིག་རྟེན་བཀོད་པ་པོ་འདོད་མཁན་དང་།",
    "སྡུག་བསྔལ་སྤངས་པའི་བྲལ་བ་དེ་ཐོབ་བྱ་འབྲས་བུར་བཞག་དེའི་ཐོབ་བྱེད་ཀྱི་རྒྱུ་ལམ་བདེན་ཞེས་གསུངས་འདུགདེ་ནས་བཅོམ་ལྡན་འདས་ཀྱི་གདུལ་བྱ་ཚོས་གཞི་ནས་རྟེན་འབྱུང་ལ་དོ་སྣང་ལྟ་བུ་སླེབས་ནས་གོ་བ་ལོན་སྐབས།",
    "ཅེས་གསུངས་འདུག་དེར་བརྟེན།",
    "ངོས་རང་སྒེར་ལ་མཚོན་ན་མི་ལ་ཕན་ན་བསམས་ནས་སྐད་ཆ་འདི་འདྲ་ཤོད་སྐབས་སོ་སོ་སྒེར་ལའང་ཕན་ཐོགས་འདུག་སོ་སོ་ལའང་ཁེ་ཕན་འདུག་ངོས་ལ་འཛམ་གླིང་འདིའི་སྒང་གྲོགས་པོ་ཧ་ཅང་མང་པོ་ཡོད།",
    "ཕན་ཐོགས་ཀྱང་གང་ཙམ་འདུགལ་དྭགས་ལ་ཆ་མཚོན་ན་ནང་པ་དང་ཁ་ཆེའི་བར་འབྲེལ་བ་ཡག་པོ་འདུག་ལ།",
    "བསྟན་པ་ངོ་མ་གང་ཡིན་ངོས་འཛིན་ཐུབ་ཀྱི་མི་འདུག་ཅེས་སོགས་ཀྱི་བཀའ་སློབ་སྩལ།",
    "བར་སྐབས་ནུབ་ཕྱོགས་ནས་ཡོང་བའི་རབ་བྱུང་མ་དེ་འདྲས་དགེ་སློང་མ་སྒྲུབ་དགོས་ཀྱི་འདུག་ཅེས་འབོད་སྐུལ་བྱེད་མཁན་ཤུགས་ཆེན་པོ་བྱུང་།",
    "འཛམ་གླིང་འདི་གང་འདྲ་ཞིག་འདུག།",
    "ནང་པའི་ཡུལ་གྲུ་ཁག་གང་འདྲ་འདུག་དེ་དག་ཚང་མ་མཐོང་བ་བྱེད་དགོས།",
    "ཆང་རག་སྤོང་དགོས་པ་དང་རང་ལས་དམན་པ་ལ་བྱམས་བརྩེ་དགོས་པ།",
    "རང་རྒྱལ་གཞན་ཕམ་གོ་མཚོན་གྱི་ཐོག་ནས་བྱེད་པའི་བསམ་བློ་ཤུགས་ཆེན་པོ་ཞིག་བྱུང་འདུག་བག་ཆགས་རྙིང་པ་དེ་དུས་རབས་ཉི་ཤུ་རྩ་གཅིག་པའི་སྐབས་ལའང་ཡོད་པས་དེང་སང་དཀྱིལ་ཤར་གྱི་ལུང་པ་ཚོའི་ནང་དུ་དཀའ་ངལ་མང་པོ་ཞིག་ཡོང་བཞིན་འདུག་དུས་རབས་ཉི་ཤུ་པའི་ནང་བསམ་བློའི་འཁྱེར་སོ་ལ་ཧ་ཅང་དཀའ་ངལ་འཕྲད་ན་གང་མགྱོགས་དཔུང་ཤུགས་ཀྱི་ཐོག་ནས་དཀའ་ངལ་སེལ་བའི་བག་ཆགས་ཤིག་ཡོད་པས།",
    "དེར་བརྟེན་ང་རང་ངོས་ནས་ཡིན་ནའང་།",
    "དེར་བརྟེན་ང་རང་ངོས་ནས་འདུན་པ་བསྐྱེད་ཀྱི་ཡོད།",
    "ནི་ཅི་ལིངྒ་པའི་སེམས་ཁུར་ད་དུང་ཡིན་ནའང་འཁྱེར་བཞིན་འདུག་པར་བརྟེན་བསྔགས་བརྗོད་ཞུ་རྒྱུ་ཡིན།",
    "དད་པ་གཅིག་པུའི་ཐོག་ཕྱིན་པ་ཡིན་ན་ཚན་རིག་པ་ཟེར་དུས་ཕྲན་བུ་ཟོན་བྱེད་དགོས་པའི་བཟོ་འདྲ་ཞིག་འདུག་ཅེས་སོགས་ཀྱི་བཀའ་སློབ་སྩལ་རྗེས་བོད་ནས་གསར་དུ་ཕེབས་པའི་བོད་མི་ཁག་གཅིག་ལ་མཇལ་ཁ་སྩལ།",
    "སེམས་པ་བཟང་པོ་ཟེར་རྒྱུ་ནི་དུད་འགྲོ་ཡིན་ནའང་སེམས་པ་བཟང་པོ་ཡོད་ན་དགའ་པོ་བྱེད་ཀྱི་འདུག་མི་ནི་ལྟ་ཅི་སྨོས།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "ད་ཆ་བརྗེད་ཟིན་འདུག་སྔོན་མ་མཚན་ཉིད་གྲྭ་ཚང་མིན་པ་རྒྱུད་སྟོད་སྨད་གཉིས་དང་།",
    "པོ་རྒྱག་མཁན་མི་འདུག་པས།",
    "ད་ལྟ་བར་ཧུར་ཐག་བྱེད་ཀྱི་འདུག་ད་དུང་ཡང་ཧུར་ཐག་བྱེད་ཤོག་ཨང་།",
    "ཞབས་རིམ་སྒྲུབ་པ་སོགས་མང་པོ་ཞིག་གནང་འདུག་ལྷག་པར་དུ་བོད་ནང་དུའང་མང་པོ་བྱས་འདུག་ལ།",
    "ཁ་ཤས་ལ་དཀའ་ངལ་འཕྲད་པའང་བྱུང་འདུག་ཚང་མར་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "ཕྱི་ལ་བལྟས་པ་ཡིན་ན་ཁྲ་ཁྲ་ཟིང་ཟིང་འདུག་ཀྱང་སེམས་སྐྱིད་པོ་ཡོད་མེད་ཐེ་ཚོམ་ལྟ་བུ་འདུག་ཕྱི་ལོ་༡༩༧༩ལོར་ཨ་རིར་བསླེབས་པ་ནས་བཟུང་ངོས་ལ་ངོ་ཤེས་པ་མང་པོ་ཆགས་སྟབས།",
    "དཔྱད་སྒོམ་དེ་ནུས་པའང་ཆེ་བ་འདུག་ཅེས་བཀའ་སྩལ་བ་དང་།",
    "སྟོན་པ་བཅོམ་ལྡན་འདས་ཀྱི་བཀའ་ཡིན་ནའང་རིགས་པ་དང་འགལ་བ་ཞིག་འདུག་ན་དེར་མི་བརྩི།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་རྣམ་པར་རྗེས་སུ་ལྟའོ།",
    "དེ་དུས་རྒྱ་ནག་དང་ཉི་ཧོང་དམག་འཁྲུག་འགོ་འཛུགས་རྒྱུའི་མཚམས་ལ་སླེབས་འདུག་ཡུ་རོབ་ལ་ཆ་བཞག་ན།",
    "དེར་བརྟེན་ག་ཚོད་ཐུབ་ཐུབ་ཀྱི་ཕན་ཐོགས་བྱེད་པ་ཡིན་ན་ཕན་ཐོགས་བྱ་རྒྱུའི་གོ་སྐབས་ཤིག་ཡོད་པ་ལྟ་བུ་འདུག་འཛམ་གླིང་འདིའི་སྟེང་མི་འབོར་དུང་ཕྱུར་བདུན་བཅུ་ཙམ་ཡོད་པ་དེ་དག་མི་བཟང་པོ་ཞིག་དང་།",
    "བླ་རྒན་ཁ་ཤས་ཀྱིས་འདོན་པ་བཏོན་དུས་ཁོ་ཚོས་དཀའ་ངལ་ཁྲོད་དུ་བསྟན་པ་མི་ཉམས་པར་དཀའ་ལས་བརྒྱབ་འདུག་སྙམ་པ་བྱུང་།",
    "བོད་སྐད་ཐོག་དུས་མཉམ་མམ་ཅིག་ཅར་དུ་བསྒྱུར་ནས་ཕན་ཚུན་གོ་བརྡ་སྤྲོད་པར་བྱས།",
    "སོག་རིགས་ན་གཞོན་༡༢ ཙམ་ལྷན་འཛོམས་བྱེད་འཆར་ཡོད་འདུགཞོགས་པ་བཞུགས་ཡུལ་མགྲོན་ཁང་དུ་དད་ལྡན་༤ ཙམ་བཅར་བར་ཕེབས་ལམ་དུ་མཇལ་ཁ་གནང་ཞིང་།",
    "གོང་ས་མཆོག་སོག་ཡུལ་དུ་ཐེངས་ཁ་ཤས་ཕེབས་པར་སོག་ཡུལ་དུ་འགྱུར་བ་ག་འདྲ་ཕྱིན་འདུག་གམ་ཞེས་དྲིས་པའི་བཀའ་ལན་དུ།",
    "གཞི་ནས་ཀླད་པ་ལས་ལོགས་སུ་ཡོད་པ་ཞིག་ལ་དོ་སྣང་གསར་པ་ཞིག་བསླེབས་ཏེ་དེ་འདྲའི་ཐོག་ལ་ཉམས་ཞིབ་བྱེད་མཁན་ཡང་འདུག་༣ ནང་པའི་སེམས་ཁམས་རིག་པ།",
    "སྤྱིར་མི་ཚང་མས་འདི་ལྟར་འཆད་ཀྱི་འདུག་བོད་པ་ནི་གཤིས་ཀ་ཡག་པོ་དང་སེམས་པ་བཟང་པོ།",
    "ཡ་རབས་ཀྱི་སྤྱོད་པ་བཟང་པོ་ཅན་ཞིག་ལ་མང་ཆེ་བས་ངོས་འཛིན་བྱེད་ཀྱི་འདུག་ཡིན་ནའང་།",
    "སོ་སོས་སློབ་སྦྱོང་མ་བྱས་ན་ཡོང་ཐབས་མི་འདུག་ཅེས་དང་།",
    "དེ་དུས་ངོས་རང་ཤོག་ཟེར་གྱི་འདུག་དེ་དེས་ངོས་ཀྱིས་འབོད་སྐུལ་བྱས་པ་ཡིན།",
    "ཐེངས་ཤིག་ངོས་ཀྱི་དངོས་ཁམས་རིག་པའི་སློབ་སྟོན་པ་སྐུ་ཞབས་ལགས་ཀྱིས་ཁོང་རང་ཉིད་ཕྲུ་གུ་ཆུང་ངུ་ཡིན་པའི་གནས་སྐབས་སུ་ཧྥ་རན་སིའི་མིག་ནང་འཇར་མན་ཡོངས་རྫོགས་ཧྥ་རན་སིའི་དགྲ་བོ་ཡིན་པ་མཐོང་བ་བཞིན།",
    "འདིར་བྱེད་ཐུབ་ན་གང་འདྲ་འདུགཅེས་དྲིས་པ་ཡིན།",
    "མི་སྒེར་པ་སོ་སོར་དངོས་དང་བརྒྱུད་པའི་ཐོག་ནས་གྱོང་མ་གཏོགས་ཕན་གང་ཡང་མི་འདུག་དེར་བརྟེན་ངོས་རང་འཛམ་གླིང་འདིའི་སྟེང་མི་དུང་ཕྱུར་བདུན་ཅུ་ཡོད་པའི་ནང་ནས་གཅིག་ཆགས་ཡོད།",
    "མགོན་པོ་གང་ཉིད་མཆོག་དུས་རྟག་ཏུ་༧ཞལ་རས་འཛུམ་མདངས་ངང་ཐུགས་སྤྲོ་སྣང་དོད་པོ་དེ་འདྲ་ཇི་ལྟར་ཡོང་ཐུབ་བཞིན་ཡོད་སྐོར་གྱི་དྲི་བར་བཀའ་ལན་མཛད་དོན།",
    "ཧ་ཅང་ཡག་པོ་འདུག་འོན་ཀྱང་ཁོང་རྣམས་དང་ལྷན་སྐད་ཆ་ཤོད་རྒྱུའི་དུས་ཚོད་དེ་ཙམ་མ་བྱུང་།",
    "ཝེ་ཐི་ནམ་བཅས་ཀྱིས་ཧ་ཅང་དོགས་པ་བྱེད་ཀྱི་འདུག་གནས་སྟངས་འདི་འདྲ་ཞིག་ཆགས་ཡོད།",
    "སེམས་ཁུར་ལྗིད་པོ་ཞིག་བླངས་པ་སོགས་བྱུང་འདུག་པས།",
    "ཞེས་འཁོད་འདུགགསུང་འཕྲིན།",
    "ཇི་ཙམ་སོ་སོའི་ཕྱོགས་དང་མཚམས་སུ་འཁོད་ནས་ཇི་ཙམ་བྱེད་ཐུབ་པ་འདུག་གམ།",
    "ཞེས་འཁོད་འདུགགསུང་འཕྲིན།",
    "ཅེས་འཁོད་འདུག།",
    "ཕྱི་ལོ་༡༩༦༧ ལོར་གོང་ས་མཆོག་ཡུལ་དེར་ཐོག་མར་ཆིབས་སྒྱུར་བསྐྱངས་སྐབས་རྒྱལ་པོ་ཞིང་གཤེགས་དམ་པ་ཁོང་དང་མཇལ་འཕྲད་མཛད་སྐོར་ཐུགས་དྲན་གསོ་མཛད་འདུགགསུང་འཕྲིན།",
    "ཞེས་འཁོད་འདུག་༢༡༦བཀའ་ལན།",
    "འདོད་ཚུལ་དེ་ཡང་རང་རྒྱུད་ལ་ལྷག་བསམ་སྐྱེ་རྒྱུའི་ནུས་པ་ཧ་ཅང་ཆེ།",
    "གནས་སྟངས་འདི་འདྲར་ཐུགས་བློ་ཁེངས་པ་ཞིག་འདུག་གམ།",
    "ཁོང་རྣམས་ལ་ཐུག་སྐབས་མང་པོས་མིག་ཆུ་གཏོང་བཞིན་འདུགདེར་བརྟེན་འགྱུར་བ་ཏན་ཏན་འགྲོ་བཞིན་འདུགབཀའ་ལན།",
    "གླང་ཆེན་གྱིས་མི་ཞིག་བསད་འདུག་ཅེས་བརྗོད་ཚེ།",
    "ཨ་ཙི་རྐྱེན་ངན་ཧ་ལས་པ་ཞིག་བྱུང་འདུག་ཅེས་སེམས་མི་བདེ་བ་བྱེད་དགོས་པ་ཞིག་ཡིན།",
    "མིས་མི་བརྒྱ་ཕྲག་དང་སྟོང་ཕྲག་བསད་འདུག་ཅེས་བརྗོད་ན།",
    "ཨི་རན་ནས་ཡིན་པའི་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་སྔར་ནས་ངོ་ཤེས་པ་ལགས་ཕེབས་ཐུབ་མི་འདུག་ཀྱང་།",
    "མི་ལ་དཀའ་ངལ་བཟོ་བའི་ཆ་རྐྱེན་ཞིག་ཏུ་འགྲོ་ཉེན་འདུག་༤ འཚེ་བའི་འབྲས་བུ་ལ་བདེ་སྐྱིད་བྱུང་མེད།",
    "ངོས་ནས་དུས་རབས་ཉི་ཤུ་པ་དེ་འཚེ་བའི་དུས་རབས་ཤིག་ཆགས་འདུག་ཅེས་རྟག་ཏུ་བརྗོད་ཀྱི་ཡོད།",
    "ཞི་མི་འཛིན་ཆེད་ལྟོ་ཆས་ཤིག་སྤྲད་ནའང་ལྟོ་ཆས་ཟོས་ཟིན་རྗེས་ལམ་སང་བྲོས་འགྲོ་བ་ལས་ཚུར་འཁོར་གྱི་མི་འདུགཁྱི་དང་ཞི་མི་སོགས་གང་ཞིག་ཡིན་ནའང་བྱམས་བརྩེ་བྱས་ན་ཧ་ཅང་དགའ་པོ་བྱེད་ཀྱི་ཡོད།",
    "ཧ་ལས་པའི་ཡག་པོ་འདུག་ཅེས་དགའ་པོ་བྱེད་ཀྱི་ཡོད་ཚུལ་བརྗོད་ཀྱི་འདུག་༢ ནང་པའི་ཚན་རིག་དང་ལྟ་གྲུབ་ཀུན་བཏུས།",
    "བྱམས་བརྩེ་ཡར་རྒྱས་གཏོང་ཐབས་སོགས་ཀྱི་ཐོག་ལ་དོ་སྣང་བྱེད་མཁན་ཤུགས་ཆེན་པོ་འདུགའདི་ལྟར་དོ་སྣང་བྱེད་མཁན་ཡོད་པའི་སྐབས་སུ་བྱམས་བརྩེ་ཡར་རྒྱས་གཏོང་ཐབས་ཇི་ལྟར་བྱེད་དགོས་སམ་ཞེ་ན།",
    "དེའི་ཐོག་བརྟག་དཔྱད་ཞིབ་འཇུག་བྱས་པའི་འབྲས་བུ་ར་འཕྲོད་པ་ཞིག་འདུག་ན་ཁས་ལེན་དགོས་ཞེས་གསུངས་ཡོད།",
    "ངོས་ནས་ཚན་རིག་པ་དང་ཐུག་འཕྲད་ཀྱིས་ཕན་ཚུན་གོ་བསྡུར་བྱས་ན་བསམ་གྱི་འདུག་ཅེས་བརྗོད་པར།",
    "དེ་ལ་རིགས་པས་གནོད་པ་འདུག་ཅེས་གསུངས་ཡོད་ལ།",
    "ཚན་རིག་པ་རྣམས་དང་འབྲེལ་བ་བྱས་ན་སྐྱོན་གང་ཡང་མི་འདུག་སྙམ་ནས་ངོས་ཀྱིས་ཚན་རིག་པ་རྣམས་དང་འབྲེལ་བ་བྱས་པ་ཡིན།",
    "ད་ལྟ་དེའི་ཐོག་གང་ཞིག་དགོངས་ཀྱི་འདུག་གམ་ཞེས་བཀའ་འདྲི་ཞུ་སྐབས།",
    "ཁྱེད་རང་ལ་ཆ་མཚོན་ན་རྒྱ་གར་བ་ཡིན་སྟབས།",
    "དེ་ལྟ་བུའི་གོ་སྐབས་ཧ་ཅང་ཡག་པོ་ཡོད་པ་ལྟ་བུ་ཞིག་འདུགགོ་སྐབས་ཡག་པོ་ཡོད་ཀྱང་འབྲེལ་བ་ཡག་པོ་ཞིག་མཐུད་མ་ཐུབ་པ་དང་།",
    "སྟབས་བདེ་པོ་དེ་རིགས་བརྗོད་ཀྱི་འདུགངོས་ནས་ཡག་པོ་འདུག་ཅེས་བརྗོད་པ་ལས།"
  ]
}