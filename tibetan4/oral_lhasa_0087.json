    "དེ་ལྟར་རྒྱལ་པོ་ལ་བརྟེན་པ་ཐབས་དུ་མས་སྨད་པ་ནི་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་ཐམས་ཅད་ཀྱིས་སྨད་དོ།",
    "དེ་ནི་གཏན་དུ་བའི་ཞི་བ་བསྟེན་པར་འགྱུར་རོ།",
    "གདོན་མི་ཟ་བར་ལེགས་པ་འཐོབ་པར་འགྱུར་རོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་བསྟེན་པའོ།",
    "དེ་བསྟེན་པ་ན་བསམ་གཏན་དང་ཀློག་པ་ལས་ཉམས་པར་འགྱུར་རོ།",
    "དེས་དེ་མངལ་ཆགས་པར་གྱུར་པ་དེའི་ཚེ་རྒྱལ་པོ་འདི་སྙམ་དུ་འགྱུར་ཏེ།",
    "འདིར་རབ་ཏུ་བྱུང་བ་མ་གཏོགས་པ་གཞན་འགའ་ཡང་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "འདིར་རབ་ཏུ་བྱུང་བ་མ་གཏོགས་པར་གཞན་འགའ་ཡང་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "འདིར་རབ་ཏུ་བྱུང་བ་མ་གཏོགས་པ་གཞན་འགའ་ཡང་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "འདིར་རབ་ཏུ་བྱུང་བ་མ་གཏོགས་པར་གཞན་འགའ་ཡང་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "དགེ་སློང་དག་གཞན་ཡང་རྒྱལ་པོ་དུས་མ་ཡིན་པར་བསྟེན་པ་ལ་སྦྱོར་བ་དེའི་ཚེ་གང་དག་དེའི་ཡིད་དུ་མི་འོང་བ་དེ་དག་འདི་སྙམ་དུ་འགྱུར་ཏེ།",
    "ཁོང་ཁྲོ་བ་མེད་པས་སྦྱིན་པ་དེ་གཉིས་ལ་གནས་པར་བྱའོ།",
    "རུང་བ་སྦྱིན་པ་དག་སྦྱིན་པར་བྱེད་དེ།",
    "ཡོ་བྱད་རྣམས་ཡོངས་སུ་བཏང་ཞིང་མགྲོན་དུ་གཉེར་བར་བྱེད་དོ་ཞེས་གསུངས་སོ།",
    "སྦྱིན་པ་དེ་ནི་འདུས་མ་བྱས་ལ་བསྔོས་པ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་བྱེ་བྲག་འཐོབ་པར་འགྱུར་བ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་ལེགས་པར་བྱས་པ་གདོན་མི་ཟ་བ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་ཡང་དག་པར་བསྔོས་པ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་བསྔོས་པ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་བཏང་བ་སྟེ།",
    "སྦྱིན་པ་དེ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཕྱིར་བསྒྲུབས་པ་སྟེ།",
    "བློན་པོ་ཆེན་པོ་ལ་ཡང་དག་པར་སྟོན་པ་དེ་ལྟར་གདོལ་པའམ།",
    "གདོལ་བུ་ལ་ཡང་དག་པར་སྟོན་ན།",
    "དེ་སྦྱིན་པ་ཡང་སྦྱིན་ཞིང་སྦྱིན་པ་དེས་ཁེངས་པར་ཡང་མི་འགྱུར་ཏེ།",
    "མང་དུ་ཐོས་པས་རྒྱགས་ཤིང་དྲེགས་པས་སྦྱིན་པ་མི་སྦྱིན་གྱི་ཅི་སྦྱིན་པ་དེ་ཡང་བསྟི་སྟང་དུ་བྱས་ཤིང་སྦྱིན་པས་སྦྱིན་པར་བྱེད་དོ།",
    "བཙུན་པར་བྱས་ཤིང་སྦྱིན་པ་སྦྱིན་པར་བྱེད་དོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་དག་མཐོང་ན།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་ལ་སྤོས་སམ།",
    "ཀུན་ཆུབ་པར་བྱེད་དོ།",
    "རྣམ་པར་དག་དང་རྣམ་དགུ་སྟེ།",
    "རྣམ་པར་དག་པའི་སྦྱིན་པའོ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཁ་ན་མ་ཐོ་བ་མེད་པ་ཐམས་ཅད་ཡོངས་སུ་གཏོང་བ་དང་།",
    "སུ་གང་འདོད་པ་དེ་ལ་དངོས་པོ་དེ་སོ་སོར་སྦྱིན་པར་བྱེད་པ་ནི།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་རྣམ་པ་གཉིས་ཏེ།",
    "ཇི་སྐད་སྨོས་པ་འདི་ལས་མ་གཏོགས་པའི་ལྷག་མ་སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཡོངས་སུ་གཏོང་བ་ནི།",
    "ཕྱི་རོལ་གྱི་སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཡོངས་སུ་གཏོང་བ་ཁོ་ན་ཞེས་བྱའོ།",
    "གཞན་ལ་རག་ལས་པར་བྱེད་ཅིང་བདག་ཉིད་གཞན་དག་ལ་སྦྱིན་པར་བྱེད་དེ།"
  ]
