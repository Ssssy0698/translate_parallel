    "གཞན་གྱིས་བརྗོད་པ་དེ་དག་རིགས་པའི་ལམ་གྱིས་སུན་ཕྱུང་ནུས་ན་ཕ་རོལ་དེ་ཉིད་ཁ་སྐེངས་པའི་རྒྱུ་ཙམ་དུ་སོང་བས་རང་ཉིད་ཀྱི་ལུགས་དེ་ཇེ་དག་ཏུ་འགྲོ་བའི་རྒྱན་དུ་འགྱུར་བ་ལས་གནོད་མི་ནུས་ན་ཁྲོ་བ་སྐེད་དོན་མེད་དོ།",
    "ཁྱོད་དང་འཕྲད་ན་འཇིག་པར་འགྱུར།",
    "མ་སྨྱོས་པར་ཚུལ་བཞིན་སྨྲ་བ་ལ་ཐོ་ཅོས་སྨྱོས་པའི་གནང་བ་སྦྱིན་པ་དེ་ཉིད་དོན་གྱིས་སྨྱོས་པར་གནང་བ་རང་གིར་བྱས་སོང་ངོ།",
    "དེ་ལྟ་ནའང་བསྙོན་དོར་གྱི་རྒྱན་ལྟ་བུར་མོས་པས་བརྟག་པར་བྱ་སྟེ།",
    "ཞེས་སོགས་སྨོས་པ་ནི་ངེས་པར་བསྙོན་དོར་གྱི་རྒྱན་ལྟ་བུར་བབ་ཅོལ་དུ་སོང་སྟེ།",
    "གྲགས་པའི་ཉོན་མོངས་སྲེད་པ་མེད་ཅེས་པ་ལ་སྲེད་འདི་ཞེས་བཀར་ཏེ་ཁྱོད་ཀྱིས་འདོད་པའི་ཉོན་མོངས་ཅན་མིན་ཡང་།",
    "འདི་ཞེས་ཉེ་ཚིག་གིས་ཟླས་དྲངས་པའི་སྲེད་པ།",
    "ཁོའི་འདོད་པ་ལྟར་གྱི་ཉོན་མོངས་ཅན་ཡིན་པར་ཡང་བསྟན་པས།",
    "ལུགས་གཉིས་ཀྱི་ཉོན་མོངས་ཕྲ་རགས་ལ་མཁས་དགོས་པ་དང་།",
    "ངར་འཛིན་ཕྲ་མོས་དྲང་བའི་སྲེད་པ་ཅི་སྟེ་མེད་ཅེས་སྔར་བརྗོད་པ་དེ་ལས་ཁྱད་པར་ཅི་ཡང་མེད་པའི་ཁ་ཁྲལ་འཇལ་བ་ཙམ་དུ་ཟད་ལ།",
    "ཡང་སྲེད་འདི་ཞེས་པའི་ཉེ་ཚིག་གིས་ཟླས་དྲངས་པའི་སྲེད་པ།",
    "ཕྱིར་རྒོལ་བའི་འདོད་པ་ལྟར་གྱི་ཉོན་མོངས་ཅན་ཡིན་པར་ཡང་བསྟན་པས་ཞེས་སྤྲོས་པ་ཕྱིར་རྒོལ་གྱི་འདོད་པ་ལྟར་གྱི་ཉོན་མོངས་ཅན་ཡིན་པ་དང་མིན་པ་གཉིས་ཀ་ཡིན་ཟེར་བ་འདི་སྤར་མར་འདུག་པས་ཚིག་ཆད་པ་འདྲ་མིན་ན་དངོས་སུ་བསྙོན་དོར་གྱི་གཏམ་ཡ་མཚན་པ་དངོས་སོ།",
    "ཞེས་གསུངས་པའི་དོན་ལྟར་སོང་ངོ།",
    "གཞན་དུ་ན་སྲེད་པ་ཉོན་མོངས་ཅན་མིན་ཏེཞེས་པས་གྲུབ་བོ།",
    "དེའི་ཕྱིར་ཡང་དཔེ་དོན་གཉིས་ཀ་ལ་གཉིས་རེ་འབྱེད་པར་འཕངས་སོ།",
    "ཡང་སྲེད་པ་ལ་ཉོན་མོངས་ཅན་མིན་པ་ཡོད་ན་ང་རྒྱལ་ལ་ཡང་དེ་ཡོད་པར་ཁས་ལོངས་ཤིག་ཅེས་པ་ཉོན་མོངས་ཅན་མིན་པའི་སྲེད་པ་ཡོད་ན་ང་རྒྱལ་ཀྱང་ཡོད་དགོས་པའི་འཐད་པ་བསྟན་པར་རིགས་སོ།",
    "དང་པོ་བརྒྱད་པ་སོགས་ནས་རེ་ཞིག་བཞག་གོའི་བར་ལ་དཔྱད་དགོས་པ་ཆེར་མི་སྣང་ལ།",
    "བུ་ལ་སྲེད་པའང་མི་དགོས་པས་ཁྱོད་ལྟར་ན་སྲེད་པ་མེད་ཀྱང་རུང་ཞེས་ལན་འདེབས་དགོས་པ་མ་ཡིན་གྱི།",
    "ཁྱེད་ཀྱིས་གསུངས་པ་ལྟར་ན་ལས་ཕལ་མོ་ཆེ་ཞིག་སྲེད་པས་གསོས་འདེབས་མི་དགོས་པར་ཐལ་བ་སོགས་དཔྱད་བྱ་མང་ཡང་བཞག་གོ།",
    "ད་ལྟའི་སྲེད་པ་མེད་ཀྱང་རུང་ཞེས་སྦྱར་ན་མི་རུང་བ་མེད་མོད་སྦྱར་དགོས་པའི་གལ་འགག་གང་ཡང་མི་སྣང་ངོ།",
    "པ་མོདྒལ་གྱི་བུ་ལྟ་བུ་ལ་སྦྱར་ན་བདེ་ཡི།",
    "ཉོན་མོངས་ཡོད་པ་ཞིག་ལ་ལས་ཀྱི་ནུས་པ་མཐོང་བ་ནི་གྲུབ་ཟིན་བསྒྲུབ་པར་འགྱུར་རོ།",
    "རེ་ཞིག་ཅེས་དང་།",
    "ཡང་སྲིད་ཉེར་ལེན་གྱི་སྲེད་པ་མེད་ཅེས་བརྗོད་པའང་མོངྒལ་གྱི་བུ་ལྟ་བུ་ལ་འབྱོར་གྱི།",
    "ཁྱེད་ལྟར་ན་བདག་མེད་ཕྲ་བ་མ་རྟོགས་པའི་ཉོན་མོངས་ཅན་ཡིན་པར་ནི།",
    "སྲེད་འདི་ཉོན་མོངས་ཅན་མིན་ཡང་ཞེས་པའི་སྐབས་སུ་བསྒྲུབས་ཟིན་པས།",
    "རེ་ཞིག་སྲིད་པ་ཉེར་ལེན་གྱི་སྲེད་པ་མེད་ཅེས་ལན་འདེབས་མི་རིགས་ཏེ།",
    "སྲིད་པ་ཉོན་མོངས་ཅན་མིན་པའང་ཅི་སྟེ་མེད།",
    "ཞེས་བྲིས་པའི་འང་སྒྲས་ཉོན་མོངས་ཅན་གྱི་སྲེད་པ་སྡད་པར་སོང་སྟེ།",
    "ཉོན་མོངས་མིན་པ་ལའང་སྒྲ་སྦྱར་བའི་ཕྱིར།",
    "ཁྱོད་ཀྱི་རང་ལུགས་ངོས་ཟིན་ན་སྲིད་པའང་ཞེས་སྦྱར་ན་ཀུན་རྨོངས་བསྡུས་པར་འགྱུར་པས་ཚིག་སྦྱོར་ལ་མཁས་ཉམས་ཅི་ཡང་མེད་པ་མཐའ་བྲལ་སྟོང་ཆེན་གྱི་དབྱིངས་སུ་ཡལ་ལོ།",
    "རྩ་བར་ཀུན་རྨོངས་དཔེར་བཀོད་པ་ལྟར་ཁྱོད་རང་གིས་ཀྱང་གོང་དུ་བྲིས་པའི་ཕྱིར།",
    "ཀུན་རྨོངས་རྟགས་ཀྱི་ཆར་སོང་བས་དཔེར་གསུངས་པ་དང་འགལ་ལ།",
    "དཔེར་ན་བྱས་པ་བཞིན་ཞེས་འགོད་པར་ཐལ་ལོ།",
    "དཔེ་ཅན་སྲེད་པའང་དེ་བཞིན་ཁྲིད་མོད།",
    "དཔེ་དོན་དེ་ལྟར་འདྲ་དགོས་ན་ཧ་ཅང་ཐལ་ལོ།",
    "ཁོ་བོ་ཅག་གིས་དཀྱུས་ཀྱི་ལམ་མ་བཏང་བར་གོང་འོག་གི་དམིགས་བཅས་དང་སྟོང་པ་ཉིད་དང་བྲལ་བ་དང་འགག་པ་སླར་སྐྱེ་བ་རྣམས་ཁོག་གཅིག་ཏུ་བསྒྲིགས་པ་ནི།",
    "ཁྱོད་ཀྱི་རྣལ་འབྱོར་བདག་མེད་མཐོང་བ་ཡིས།",
    "ཁྱོད་ཀྱི་བདེན་པ་མཐོང་བས་དེ་ཉིད་རྟོགས་པས་གོ་མི་ཆོད་པ་དང་།",
    "ཁྱོད་གསུང་ཐར་འདོད་ཡོངས་ཀྱི་གསོས།",
    "མཁྱེན་རབ་རལ་གྲི་འབར་བ་ཁྱོད་ལ་གཏད།",
    "ཞེས་བྱ་བ་ནི་རང་བཞིན་བརྗོད་པའི་དབྱངས་ཀྱི་མཆོད་སྤྲིན་གྱི་མེ་ཏོག་གི་བླ་རེ་ཀུན་ཏུ་བྲེས་པའོ།",
    "སྤྱིར་རྟོག་ལྡན་དོགས་པ་སྐྱེ་ནུས་ཀྱི་བརྒལ་བ་ཟབ་མོ་ཡིན་ན་ལན་ཀྱང་ཤིན་ཏུ་གསལ་པོར་སྟོན་རིགས་ཀྱི།",
    "སྐབས་ཀྱི་བརྗོད་པ་འདི་འདྲའི་རིགས་ལ་ལན་གྱི་ངལ་བ་མ་དགོས་མོད།",
    "སྲེད་པ་ཉོན་མོངས་ཅན་མིན་པའང་ཞེས་པའི་འང་སྒྲས་ཉོན་མོངས་ཅན་གྱི་སྲེད་པ་བསྡུས་པར་སོང་སྟེ་ཉོན་མོངས་རིགས་ལམ་རབ་གསལ་དེ་ཉིད་སྣང་བྱེད།",
    "ཚིག་གི་དུམ་བུ་འཕྲེད་བཟུང་གོ་ལོག་སྟེ།",
    "དཔེར་ན་ཀུན་རྨོངས་ཏེ་ཡུལ་དུས་རྣམ་པ་བསྐལ་པའི་དངོས་པོ་མི་ཤེས་པའི་རྨོངས་པ་ཡོད་པར་འདོད་པ་བཞིན་དུ་སྲེད་པ་ཉོན་མོངས་ཅན་མིན་པའང་ཅི་སྟེ་མེད་ཅེས་སྦྱར་འདུག་པས་ན།",
    "ཉོན་མོངས་ཅན་མ་ཡིན་པ་ཡོད་པར་བསྒྲུབ་པའི་སྐབས་ཡིན་པ་དང་།",
    "ཁྱོད་ཀྱིས་རང་ལུགས་ངོས་ཟིན་ན་སྲེད་པའང་ཞེས་སྦྱར་ན་ཀུན་རྨོངས་བསྡུས་པར་གོ་རུང་ངོ་ཞེས་ཟེར་བ་ཚིག་སྦྱོར་ལ་མཁས་སོ་སྙམ་དུ་རློམ་ཡང་མ་མཁས་པའི་རྟགས་སུ་སོང་སྟེ།",
    "དེ་ཉོན་མོངས་ཅན་དུ་བསྒྲུབ་པ་ཙམ་ཞིག་གི་དོན་དུ་སོང་བས་བརྗོད་ཚུལ་མི་ལེགས་ལ།",
    "སྲེད་པ་ཉོན་མོངས་ཅན་མིན་པའང་ཞེས་བརྗོད་ན།",
    "ཉོན་མོངས་ཅན་མིན་པས་ཁྱད་པར་དུ་བྱས་པའི་སྲེད་པ་བསྒྲུབ་བྱར་འགྲོ་བས་གོ་ཐོབ་བདེ་མི་བདེ་ཡོད་པས་དེ་ལྟར་སྦྱར་བ་ལེགས་ཏེ།",
    "བསྡུ་བྱ་ཀུན་རྨོངས་ཉོན་མོངས་ཅན་མིན་པ་དང་།",
    "སྡུད་ཟླ་སྲེད་པ་ཉོན་མོངས་ཅན་མིན་པ་ཡིན་པས།",
    "ཡིན་པ་དང་མིན་པ་སོགས་གང་གི་མཐར་སྡུད་སྒྲ་སྦྱར་ཚད་ཀྱིས་ཅིག་ཤོས་སྡུད་དགོས་ན་ཧ་ཅང་ཐལ་ཏེ།",
    "ཁྱོད་ལྟར་ན་སྒ་མི་རྟག་པ་ཡང་མེད་ཅེས་སྡུད་དགོས་པས་དེ་འདྲའི་ཚིག་སྦྱོར་མཁས་ཉམས་དེ་ཁོང་དུ་སྦས་ནས་ངག་ཏུ་མ་བཏོན་ན་ལེགས་སོ།",
    "དེས་ཟག་མེད་ཀྱི་ལས་འདུ་བྱེད་པའི་ཆེད་དུ་སྲེད་པ་ཉོན་མོངས་ཅན་མ་ཡིན་པ་དམིགས་ཀྱིས་བཀར་ནས་བསྟན་པ་དང་།",
    "ཀུན་རྨོངས་རྟགས་ཀྱི་ཆར་སོང་བས་དཔེར་གསུང་བ་དང་འགལ་ལ་གང་བྱས་ན་མི་རྟག་པས་ཁྱབ།",
    "དཔེར་ན་བྱས་པ་བཞིན་ཞེས་འགོད་པར་ཐལ་ལོ་ཟེར་བ།",
    "སྦྱོར་བ་སྐོར་གཅིག་གི་དཔེར་བྱས་པ་དེ་སྐབས་དེའི་བསྒྲུབ་བྱར་མི་བྱེད་ཀྱི།",
    "དཔེ་དཔེ་ཅན་དེ་ལྟར་འདྲ་དགོས་ན་ཧ་ཅང་ཐལ་ལོ་ཞེས་ཟེར་བ་ནི།",
    "དཔེ་དཔེ་ཅན་སྒོ་ཐམས་ཅད་ནས་འདྲ་དགོས་ན་ཧ་ཅང་ཐལ་མོད།",
    "ཁྱོད་ཀྱི་རྣལ་འབྱོར་བདག་མེད་མཐོང་བ་ཡིས།",
    "ཁྱོད་ཀྱི་བདེན་པ་མཐོང་བས་དེ་ཉིད་རྟོགས་པའི་གོ་མི་ཆོད་པ་དང་།",
    "བསྟོད་པ་དོན་དང་ལྡན་པར་སོགས་ནས་བསྔགས་པའི་བླ་རེས་བྲེས་པའི་བར་དུ་བརྗོད་པ་ནི།",
    "ཁྱེད་ཅག་གིས་དཀྱུས་ལམ་མ་བཏང་བ་ཡིན་ནམ།",
    "ཁྱེད་ཅག་གིས་མི་ཆོད་པར་བསྒྲུབ་ལ།",
    "བདག་ཅག་གིས་སྟོང་པ་ཉིད་རྫོགས་པར་རྟོགས་པ་ཐེག་ཆེན་གྱི་རྟོགས་རིགས་ཐུན་མོང་མིན་པར་སྒྲུབ།",
    "ཁྱེད་ཅག་གིས་རྫོགས་པར་རྟོགས་ཀྱང་ཉན་རང་དང་ཐུན་མོང་པའི་ལམ་དུ་སྒྲུབ་ལ།",
    "གཟུགས་སོགས་ལ་དམིགས་ནས་ཆགས་པ་སྐྱེ་བ་མེད་མོད།",
    "འཁོར་གསུམ་མི་དམིགས་པའི་ཤེས་རབ་དང་ལྡན་ན་ཤེས་བྱའི་སྒྲིབ་པའང་ལྡོག་ན་ཆགས་སོགས་ཉོན་མོངས་རྣམས་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "འོན་ཀྱང་ཞེས་པ་འདི་སྔར་གྱི་ཙམ་སྒྲ་དང་ཡང་སྒྲ་ལ་ཉིད་ཀྱིས་དཔྱད་པ་ལྟར་བྱས་ན་ཚིག་ཅུང་མི་བདེ་ཡང་དེ་འདྲའི་དཔྱད་པས་ཅི་བྱ་སྙམ་མོ།",
    "འདི་ལ་གལ་ཏེ་མོས་མེད་གྲུབ་པ་ཡིན།",
    "ཟབ་མོ་འཁུ་འཕྲིག་ཅན་འཇིགས་པ།",
    "སྔོན་དུས་འཁྲུལ་པའི་ནགས་འཁྱམས་བུད་ཤིང་དག།",
    "སྟོང་ཕྲག་ཉི་མ་འབར་བས་བསྲེག་པའི་ཐལ།",
    "བདེ་མཆོག་གི་རྒྱུད་དུའང་།",
    "ཁྱོད་ཀྱིས་ཡུལ་ལ་བདག་མེད་མཐོང་ན་ནི།",
    "དེ་ལྟར་ན་ཁྱེད་ཅག་གིས་བདག་མེད་པར་བཟུང་ན་མེད་མཐའ་དང་།",
    "ཤེར་འབྱུང་གིས་ཀྱང་།",
    "ཐུབ་པའི་མངོན་རྟོགས་མི་འཐད་དེ་དངོས་དངོས་མེད་ཀྱི་ངོ་བོར་རྟོག་པ་བཀག་པས་དེ་ལས་གཞན་རྟོགས་ཚུལ་མེད་སྙམ་པ་སོགས་ཡིན་པ་རྒྱ་འགྲེལ་ཐམས་ཅད་ན་གསལ་བ་དེ་ལྟར་འདིར་ཡང་ཁྱོད་ཀྱིས་སྨྲས་པ་སྐབས་སུ་བབས་སོ།",
    "དེ་ལས་གཞན་དང་གཞན་མེད་ཤིན་ཏུ་ཟབ་ཅིང་རྗེས་སོང་ཕྱིར།",
    "ཟབ་མོ་ཅི་ཡི་ཕྱིར་ན་རྟོག་གེའི་ཡུལ་མ་ཡིན།",
    "ཅིའི་ཕྱིར་ཟབ་མོའི་དོན་རིག་པ་དག་ཐར་འགྱུར་ཞེས།",
    "དམན་པར་མོས་ཤིང་ཁམས་ཀྱང་ཤིན་ཏུ་དམན།",
    "གྲོགས་པོ་དམན་པ་དག་གིས་ཡོངས་བསྐོར་བ།",
    "འདི་ལ་གལ་ཏེ་མོས་མེད་གྲུབ་པ་ཡིན།",
    "རྨོངས་པ་གང་གི་ཕྱིར་ན་ངེས་པར་བྱེད།",
    "ཟབ་མོ་འཁུ་འཕྲིག་ཅན་འཇིགས་པ་ཞེས་དང་།",
    "ཁྱོད་ཀྱི་བདག་མེད་དང་བདེན་སྟོང་ལས་ལྷག་པའི་གནས་ལུགས་མེད་དེ།",
    "དེ་བཞིན་དུ་མཚན་མར་འཛིན་ཅིང་དེས་རློམ་སེམས་སུ་བྱེད་ཅིང་དམིགས་པ་ལ་ཆགས་པ་དེ་དག་གིས་ཤེར་ཕྱིན་གསོག་ཏུ་འབྱིན་ཅིང་རིང་དུ་སྤང་ངོ།",
    "དེ་དག་གི་དགོངས་དོན་ལྟར་མངོན་རྟོགས་རྒྱན་ལས་ཀྱང་།",
    "འདི་ནི་ཡི་གེ་དང་ངག་གིས་གདམས་པར་མི་ནུས་སོ།",
    "ཚིག་གི་སྤྱོད་ཡུལ་ཐམས་ཅད་ལས་ཡང་དག་པར་འདས་པ།",
    "ངག་གི་ལམ་ཐམས་ཅད་ལས་ཡང་དག་པར་འདས་པ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱི་སྤྱོད་ཡུལ་ལས་ཡང་དག་པར་འདས་པ།",
    "དེ་དག་ཉིད་ཀྱིས་སོ་སོ་རང་གིས་རིག་པ།",
    "དོན་གང་གི་ཕྱིར་འབད་ཅིང་རྩོལ་བ་དང་།",
    "རང་གིས་རིག་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཡི་གེ་དག་གིས་སྨྲ་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "འཕགས་པ་རྣམས་ཀྱིས་སོ་སོ་རང་གིས་རིག་པའོ།",
