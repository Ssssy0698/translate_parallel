    "ཉན་ཐོས་དང་རང་རྒྱལ་རྣམས་ཀྱི་རྣམ་པར་ཤེས་པའི་ཡུལ་ཡང་མ་ལགས་སོ།",
    "ནམ་མཁའ་མེད་ན་སྐྱེ་འགག་དང་འགྲོ་འདུག་སོགས་ཀྱི་གོ་སྐབས་མི་རྙེད་ལ།",
    "འདི་ཡོད་པས་སྐྱེ་འགག་དང་འགྲོ་འདུག་སོགས་ཀྱི་གོ་རྙེད་པ་ནི་གོ་འབྱེད་པའི་དོན་ནོ།",
    "ལུས་དང་རང་རང་བསྣན་པས་ལྔ་དང་ལྡན་ནོ།",
    "ངེས་ལྡན་གསུམ་དང་བདེ་བ་དང་རང་ཉིད་དེ་ལྔའོ།",
    "རང་རང་བསྣན་པས་སོ།",
    "བདེ་བ་དང་ཡིད་བདེ་དང་དད་སོགས་ལྔ་དང་རང་རང་བསྣན་པས་བཅུ་གཅིག་དང་ལྡན་ནོ།",
    "རང་རང་སྟེ་ཉི་ཤུ་རྩ་གཅིག་འབྱུང་ངོ།",
    "གཟུགས་མེད་ཀྱི་མ་བསྒྲིབས་པའང་རང་སའི་གསུམ་ལས་དང་།",
    "ཚངས་པ་ཆེན་པོའི་མདུན་དུ་འདུག་སྟེ་ཚིག་འདོན་པས་ཚངས་པ་མདུན་ན་འདོན་དང་།",
    "ཡང་མངལ་དུ་འཇུག་པ་དང་པོ་གསུམ་པོ་རྣམས་ནི་རིམ་པ་ལྟར་འཁོར་ལོ་སྒྱུར་བ་དང་རང་འབྱུང་རང་རྒྱལ་དང་།",
    "འདོད་ཁམས་ན་བཅོ་བརྒྱད་པོ་ཐམས་ཅད་ཡོད་ལ་དེ་ཡང་རང་སའི་ཡུལ་དྲུག་ལ་དམིགས་པ་ཅན་ནོ།",
    "དེ་ཡང་རང་སའི་ཡུལ་ཅན་ནོ།",
    "མཐར་ཐུག་དུས་ནི་སྐད་ཅིག་འདོད།",
    "དེ་རྣམས་ཀྱང་བྱེ་བྲག་པ་འཇིག་རྟེན་འཇིག་དུས་རྡུལ་ཕྲ་རབ་རྟག་པ་མ་ཞིག་པ་ལས་སྐྱེ་བར་འདོད་པ་འགྲེལ་པར་བཀག་གོ།",
    "དེ་ཚེས་བཅོ་ལྔ་ལ་ཁྲུས་བྱས་ནས་བསྙེན་གནས་ལ་གནས་ཤིང་བློན་པོའི་ཚོགས་ཀྱིས་བསྐོར་ཏེ་འདུག་པ་ན།",
    "ཁ་ཅིག་འགྲོ་འདུག་ལ་སོགས་པའི་ཆོ་ག་ཉམས་པའང་དེའོ་ཞེས་སོ།",
    "དེ་ཡང་རང་རྒྱུད་ཀྱི་ཐོབ་པ་ཆད་པས་དང་།",
    "རང་རྒྱལ་ཚོགས་སྤྱོད་ནི་དྲོད་རྩེ་ཐོབ་ནས་ཀྱང་རང་ལམ་ལས་བཟློག་ཅེས་དམིགས་ཀྱི་བཀར་བས་བཟོད་པ་ཐོབ་ནས་མི་བཟློག་གོ།",
    "གོང་འཕོ་དེ་ནི་ལྷག་མཐོང་ཤས་ཆེར་སྤྱོད་པ་འོག་མིན་འགྲོ་དང་།",
    "གཉིས་པ་འོག་མིན་འགྲོ་ལས་གཞན་ནི།",
    "དེའི་གོང་ན་ཞི་བར་ལྟ་ས་མེད་ཅིང་རང་ས་དང་འོག་སས་ངེས་པར་འབྱུང་མི་ནུས་པས་སོ།",
    "མཚུངས་ལྡན་འཛིན་ན་དེ་དང་དམིགས་པ་གཅིག་པས་མཚུངས་པ་རྣམས་ཀྱིས་ཀྱང་རང་རང་ལ་དམིགས་དགོས་པ་ལས་རང་རིག་མེད་པས་ན་དེ་འདྲ་མི་སྲིད་པ་དང་།",
    "དེའང་རང་དང་གཞན་གྱི་ལུས་དང་འབྲེལ་བ་གཉིས་སོ།",
    "བསམ་གཏན་བཞི་པའི་འོག་མ་བཞི་དང་རང་ས་ཏེ་ལྔའི་བར་རིམ་པ་བཞིན་ཡིན་གྱི།",
    "གོང་ས་མེད་ཅིང་རང་ས་དང་འོག་ས་ནས་དེར་སྐྱེ་བ་ལ་ནི་སྔར་ནས་ལྡན་པས་སོ།",
    "རྗེས་ཤེས་ཕྱོགས་མཐུན་དང་བཅས་པའི་ལམ་གོང་འོག་དང་རང་ས་ཐམས་ཅད་དང་།",
    "འདུག་ཀྱང་རུང་།",
    "རིགས་པ་འདི་ལ་བརྟེན་ནས་གཟུང་འཛིན་གཉིས་མེད་ཀྱི་ཤེས་པ་དེ་ཡང་རང་བཞིན་མེད་པར་བརྟགས་ལ་ཏིང་ངེ་འཛིན་གྱི་སྟོབས་ཀྱིས་དེ་ལ་ཤིན་ཏུ་གོམས་པར་བྱས་ནས།",
    "དེ་ལ་སེམས་ཙམ་ཡང་སླར་ཡང་རང་བཞིན་མེད་པར་གཏན་ལ་ཕབ་པའི་ཚུལ་འདིས་ནི་གཟུང་འཛིན་གཉིས་སུ་མེད་པའི་ཤེས་པ་དེ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པར་མི་འཐད་པར་རྟོགས་ནས་བདག་མཐའ་དག་མེད་པ་ཉིད་དུ་འཇུག་པས་ནི་བདག་མེད་པ་ཉིད་མཆོག་ཏུ་རྟོགས་པ་ལ་ཞུགས་པ་ཡིན་ནོ།",
    "གཉིས་མེད་ཀྱི་ཤེས་པའང་རང་བཞིན་མེད་པར་མཐོང་བའི་ཚུལ་འདི་ལྟར།",
    "གནས་སྐབས་ནི་ཏིང་ངེ་འཛིན་ལ་འདུག་ཀྱང་རུང་།",
    "སེམས་མྱལ་མྱལ་པོར་འདུག་པ་དང་།",
    "གཉིད་ཀྱིས་ནོན་པ་ལྟ་བུར་འདུག་པ་དང་།",
    "བསམ་གཏན་དང་གཉིད་དབྱེ་བ་མེད་པར་འདུག་པའོ།",
    "རྒྱུ་དང་རང་བཞིན་སློབ་ཚུལ་དང་།",
    "ཇི་ལྟར་མི་དག་ནགས་རིའི་ཁྲོད་འདུག་སྟེ།",
    "སྣང་ཙམ་ཉིད་ནས་ཆུ་ཟླ་ལྟར་སྡོད་ཚུལ་དང་འདུག་ཚུལ་དང་།",
    "སྨིག་རྒྱུའི་དཔེ་ལ་སོགས་པ་གཞན་ལ་བརྟེན་ནས་ཀྱང་རང་བཞིན་མེད་པའི་དོན་རྟོགས་པར་བྱའོ།",
    "འདུག་གོ་སྙམ་པ་དང་།",
    "ཧ་ཅང་ཡང་མི་དགྱེ་བར་སྒལ་ཚིག་དོང་ཙེ་རྩེགས་པ་ལྟར་དྲང་པོར་སྲང་ལ་ཡིད་ཀྱི་དྲན་པ་ཕྱི་རོལ་དུ་ཧ་ཅང་མི་འཕྲོ་བར་ནང་དུ་བཞག་སྟེ་འདུག་པར་བྱའོ།",
    "རྣལ་འབྱོར་པ་དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ་ནང་དུ་ཏིང་ངེ་འཛིན་ལ་ཡང་དག་པར་བཞག་ནས་སྦྱོར་བའི་དུས་སུ་ཇི་ལྟར་ལེགས་པར་བསམས་པའི་དོན་དེ་དག་ཉིད་ཡིད་ལ་བྱེད་ཅིང་།",
    "དེའི་ཚེ་ཇི་སྲིད་འདོད་ཀྱི་བར་དུ་མཉམ་གཞག་ཏུ་འདུག་པར་བྱའོ།",
    "འདི་ནི་འདུག་ཚུལ་གྱི་ཁྱད་པར་རོ།",
    "ལུས་ཧ་ཅང་ཡང་མི་སྒུ་ཧ་ཅང་ཡང་མི་དགྱེ་བར་ལུས་དྲང་པོར་བསྲང་ལ་སེམས་ཕྱི་རོལ་ཏུ་མི་འཕྲོ་བར་དྲན་པ་ནང་དུ་བཞག་སྟེ་འདུག་པར་བྱའོ།",
    "ཇི་སྲིད་འདོད་ཀྱི་བར་དུ་ཏིང་ངེ་འཛིན་ལ་འདུག་པར་བྱའོ།",
    "ཅི་གཟུགས་སུ་སྣང་བ་འདི་དག་དོན་དམ་པར་སེམས་ལས་གུད་ན་ཡོད་དེ་འདུག་པ་ཞིག་གམ།",
    "ཡུལ་དང་ཡུལ་ཅན་དང་དེ་ལ་སྒྲོ་འདོགས་གཅོད་པའི་གཉེན་པོ་གསུམ་ཡང་རང་བཞིན་མི་དམིགས་པར་རྟོགས་པས་མཚན་མར་འཛིན་པའི་སྤྲོས་པ་མཐའ་དག་ཆོད་པས་འདིས་མཚན་མ་མེད་པའི་རྣལ་འབྱོར་ལ་འཇུག་གོ་ཞེས་འབྱུང་ངོ།",
    "ཐུན་གཅིག་གམ་ཇི་སྲིད་དུ་ནུས་པ་དེ་སྲིད་དུ་འདུག་པར་བྱའོ།",
    "རྟོག་པའང་རང་རིག་ལ་མི་འདོད།",
    "དེ་ཡང་རང་རིག་པས་རྟོགས་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་ཡང་རང་ཉིད་རྟོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ཉིད་ལན་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་དང་རང་ཉིད་ཁོ་ན་གསལ་བ་ཡིན་གྱི་དེ་ལས་གཞན་ནི་མེད་དོ་ཞེས་གནས་སོ།",
    "དེས་ན་འབྲས་བུ་བཞིན་དུ་དོན་རིག་པ་ཡང་རང་རིག་པ་ཙམ་ཉིད་དོ།",
    "ཇི་ལྟར་ངས་འདི་རྟོགས་པ་དེ་བཞིན་དུ་རུང་བའི་ཡུལ་ན་འདུག་པ་གཞན་གྱིས་ཀྱང་རྟོགས་སོ་ཞེས་འཇིག་རྟེན་ན་གྲགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "རྨི་ལམ་གྱི་གནས་སྐབས་ན་ཡང་རང་བཞིན་དེ་ཉིད་དོ།",
    "དངོས་སུ་བྱས་པ་ཤེས་པའི་རང་བཞིན་སྐད་ཅིག་མ་ཉིད་དེ་ཡང་རང་རིག་པ་ཉིད་ཀྱིས་མ་ཡིན་ཏེ།",
    "སྔོན་པོ་ཡང་རང་རྟོགས་པའི་རང་བཞིན་ཉིད་ནི་གཞན་ཡིན་ལ།",
    "འགའ་ཡང་མ་ཡིན་པའི་ཕྱིར་གཉི་ག་ཡང་རང་རིག་པ་ཉིད་དོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "སྐྲ་ལ་སོགས་པ་ལྟར་ཡུལ་ཐ་དད་ཀྱང་རང་བཞིན་གཅིག་ཏུ་འགྱུར་གྱི།",
    "མངོན་དུ་ཕྱོགས་པ་མཚུངས་ཀྱང་རང་བཞིན་འགའ་ཞིག་གསལ་བར་སྣང་བའི་ཕྱིར་གོམས་པ་ལ་སོགས་པ་ལས་ཀྱང་འགྱུར་རོ།",
    "གཞན་ཡང་ཕྱིའི་དོན་ཁས་བླངས་ཀྱང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་ནོ།",
    "དེས་ན་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་ནོ་ཞེས་སྟོན་ཏོ།",
    "རྣམ་པར་ཤེས་པའི་སྨྲ་བ་ལ་ཡང་རང་རིག་པ་ཉིད་རྣམ་པ་གཞན་མེད་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་གྱི་དོན་རིག་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་ནི་འོ་ན་དོན་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་པས་ང་རང་རིག་པས་ཅི་བྱ་ཞེ་ན།",
    "དོན་དམ་པ་ལ་ལྟོས་ནས་འདིའི་དོན་རིག་པ་ཡིན་ཡང་རང་རིག་པ་ཉིད་དོ།",
    "གཟུགས་ལ་སོགས་པའི་ཡུལ་གྱི་ཤེས་པ་གང་ཡིན་པ་ནི་དོན་དང་རང་སྣང་བ་ཡིན་ལ།",
    "ཡུལ་གྱི་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་དོན་དང་རང་སྣང་བའི་ཡིན་ལ་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱའོ།",
    "འོན་ཏེ་དོན་ཡང་རང་རིག་པས་བསྒྲུབ་པ་ཡིན་ན།",
    "བུམ་པ་ལ་སོགས་པ་འབའ་ཞིག་པ་ཡང་རང་བཞིན་ཉིད་ཡིན་ཏེ།",
    "སྔོན་པོ་ལ་སོགས་པའི་ཡུལ་ནི་བློ་དང་ལྷན་ཅིག་དུས་གཅིག་ཉིད་དུ་མྱོང་བ་ཡིན་ཏེ།",
    "དེས་ན་རྣམ་པ་དུ་མའི་ཉེས་པ་དེ་ནི་སོ་ན་འདུག་པ་ཉིད་དོ་ཞེ་ན།",
    "ཤེས་པ་གཅིག་དུས་ཉིད་དུ་ཡོངས་སུ་རྫོགས་པའི་ཕྱིར་རྟག་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "ཇི་ལྟར་ལུས་ལ་ལྟོས་ནས་རྩིག་པ་མདུན་ན་འདུག་པ་དེ་བཞིན་དུ་ལུས་ཀྱང་རྩིག་པ་ལ་ལྟོས་ནས་ཡིན་པར་འགྱུར་ན།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་མིན།",
    "ལུས་ཀྱི་རྣམ་པ་ཡིན་ཡང་རང་རིག་པར་ཁས་མི་ལེན་པའི་ཕྱིར།",
    "དེ་ཡང་རང་རིག་པའི་རང་བཞིན་ཡིན་པས་རང་རིག་པ་གྲུབ་པོ།",
    "གལ་ཏེ་བློ་ཡང་རང་རིག་པ་མ་ཡིན་ན་ནི་ཁྱད་པར་དང་ཁྱད་པར་ཅན་མ་ཡིན་པའི་དོན་ཉིད་རྟོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བར་འགྱུར་རོ།",
    "དེས་ན་བརྗོད་པ་ལྡོག་པས་ཁ་རོག་འདུག་པར་བྱའོ།",
    "འོན་ཏེ་གཞན་གྱིས་ཀྱང་རང་བཞིན་དེ་ཉིད་རྟོགས་པ་ཡིན་ནོ།",
    "འོན་ཏེ་དེ་ཡང་རང་རིག་པ་ལ་སོགས་པ་དོན་གྱི་སྣང་བ་སྣང་བ་ཡིན་པས་ན།",
    "དེས་ན་དེ་ཡང་རང་ཉིད་རབ་ཏུ་གསལ་བ་ཉིད་ཀྱིས་གསལ་བ་ཡིན་གྱི།",
    "འོན་ཏེ་མི་གནས་ཀྱང་རང་ཉིད་གནས་སོ་ཞེ་ན།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "དེའི་ཕྱིར་འགྲོ་བ་འདི་ན་བདེ་བ་ལ་སོགས་པ་དང་སྔོན་པོ་ལ་སོགས་པ་ལས་གཞན་རིག་པ་མེད་པའི་ཕྱིར་ན་བདེ་བ་ལ་སོགས་པ་བཞིན་དུ་སྔོན་པོ་ལ་སོགས་པ་ཡང་རང་རིག་པ་ཡིན་ནོ་ཞེས་རིགས་པ་འདི་ནི་གདོན་མི་ཟའོ།",
    "དེ་ཡང་རང་ཉིད་རྟོགས་པ་ཡིན་ཏེ།",
    "རིག་པ་དེ་ཡང་རང་རིག་པ་མ་ཡིན་ན་ནི།",
    "གལ་ཏེ་བློ་དེ་དག་དུས་ཀྱི་རང་བཞིན་འཛིན་པ་ཡིན་ན་ནི་དེའི་ཚེ་ཐོག་མ་དང་ཐ་མ་མེད་པ་ཉིད་དང་།",
    "འདོད་པ་དང་རང་ཉིད་ཀྱི་ཚིག་བཞིས་མ་གྲུབ་པ་དང་།",
    "དེ་ལྟ་ན་ཡང་རང་ཉིད་སྨོས་པ་ནི་ལོག་པར་རྟོག་པ་དགག་པའི་ཕྱིར་ཡིན་ནོ།",
    "ཅི་སྟེ་ཁ་རོག་ཉིད་དུ་མི་འདུག་ཅེ་ན་མ་ཡིན་ནོ།",
    "གཏན་ཚིགས་ལྟར་སྣང་བ་ཡང་རང་ཉིད་དེ་ལྟར་འགྱུར་བ་ཡིན་པའི་ཕྱིར་རྒོལ་བ་ལ་ཉེས་པ་ཅི་ཡོད།",
    "ཐག་རིང་ན་འདུག་པས་ཅི་ཕྱིར་ཐོས་ཤེ་ན།",
    "དེ་ལྟ་ན་ཤིང་ལ་སོགས་པའི་དོན་རྣམས་ཀྱང་རང་ཉིད་སྔ་མ་དང་ཕྱི་མ་ལ་སོགས་པ་ཡིན་གྱི་སྔ་མ་ཉིད་ལ་སོགས་པས་དུས་གཞན་ལ་ལྟོས་པ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་མི་གནོད་དོ་ཞེ་ན་ཡང་རང་ཉིད་འཇུག་པས་ན་རང་ཉིད་སྨོས་པས་ཅི་བྱ་ཞེ་ན།",
    "འོན་ཏེ་གཞན་མ་གྲུབ་ཀྱང་རང་ཉིད་ནི་ལུང་ལས་གྲུབ་པ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་མེ་དང་དུ་བ་དག་ཀྱང་རང་ཡུལ་ཅན་གྱི་རྣམ་པར་ཤེས་པ་ལ་སྣང་བའི་ཕྱིར་ཅི་ལྟར་དེར་འགྱུར།",
    "འབྲས་བུའི་གཏན་ཚིགས་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱིས་རབ་ཏུ་འགྲུབ་པ་འགལ་བའི་དོན་གྱིས་གསལ་ཞབ་དེར་ཡང་ཕྱོགས་མ་ཡིན་ནོ་ཞེས་འདི་རྗེས་སུ་དཔག་པ་ཉིད་ལ་ཅི་སྟེ་མི་བརྗོད།",
    "འགའ་ཡང་འདུག་པར་ཡང་མི་བྱ་འགྲོ་བར་ཡང་མི་བྱ་བར་འགྱུར་རོ།",
    "སྦྱོར་བ་ཡང་རང་བཞིན་དང་རྐྱེན་གྱི་དོན་ལས་སྐྱེས་པ་ཡིན་པའི་ཕྱིར།",
    "དེ་ལ་ཡང་རང་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པ་ནི་ཕྱོགས་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "འོན་ཀྱང་རང་བཞིན་འགས་ནི་ཐ་དད་པ་ཡིན་ལ།",
    "འོན་ཏེ་ཁྱད་པར་དང་སྤྱི་ཐ་དད་པ་དག་ཀྱང་རང་བཞིན་འགས་ནི་ཐ་དད་པ་ཡིན་ལ་རང་བཞིན་འགས་ནི་ཐ་དད་པ་མ་ཡིན་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "ཡུལ་ཐག་རིང་པོ་ན་འདུག་པའི་ཐོ་ཡོར་ལ་ཐ་དད་པ་ཡོད་ཀྱང་རྟོགས་པར་མི་ནུས་ཏེ།",
    "དེ་ཡང་རང་བཞིན་གཞན་ཡིན་པའི་ཕྱིར་ཐུག་པ་མེད་པས་སྒྲའི་བདེན་པའི་བདག་ཉིད་ནི་མི་རྟག་པ་ཉིད་དོ།",
    "དེའི་ཕྱིར་འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་གཉིས་ཀ་ཡང་དཔེ་འདི་ཉིད་ཀྱིས་བསྟན་པ་ཡིན་ནོ།",
    "གལ་ཏེ་འབྲས་བུ་དང་རང་བཞིན་གྱི་དཔེ་ཉིད་ཐ་དད་པར་ཅིའི་ཕྱིར་བསྟན་ལ་དབྱེ་བ་གཞན་ནི་མ་ཡིན་ཞེ་ན།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་སོ།",
    "རྒྱུ་དང་ངོ་བོ་ལྡོག་པ་ཉིད་ཀྱི་འབྲས་བུ་དང་རང་བཞིན་གྱི་དོན་ལྡོག་པར་བརྗོད་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་རང་བཞིན་མི་དམིགས་པ་ཁོ་ནའོ།",
    "རྒྱུ་དང་རང་བཞིན་ལྡོག་པ་ཉིད།",
    "འབྲས་བུ་དང་རང་བཞིན་གཉིས་ནི་དེའི་དབྱེ་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་འགལ་བས་ཁྱབ་པ་དམིགས་པ་ནི་མི་དམིགས་པའི་དབྱེ་བ་ཉིད་ལ་དེ་ཡང་རང་བཞིན་གྱི་ཁོངས་སུ་འདུ་བར་འགྱུར་རོ།",
    "ཕྲད་པར་བྱ་བའི་འབྲས་བུ་རྟོགས་པར་ཡང་རང་ཉིད་ལ་ཁོ་ན་ལས་ངོ་བོ་བཞིན་དུ་ཐེ་ཚོམ་མེད་པ་ཡིན་ནོ།",
    "ཤེས་པ་ཕྱི་མའི་དུས་སུ་ཡང་རང་བཞིན་མི་འདོར་བས་ཡུལ་ངེས་པ་ཅན་དུ་མི་འགྱུར་རོ།",
    "གང་ལ་ཐེ་ཚོམ་མམ་ཕྱིན་ཅི་ལོག་པ་ཡང་རང་ཉིད་སྐྱེས་པ་ཡིན་ན་དེ་འདི་ལྟ་བུ་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ནོ་མ་ཡིན་ཏེ།",
    "ཕྲད་པར་བྱ་བ་ཡང་རང་ཉིད་རིག་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དེ་ཡང་རང་ཉིད་ཁོ་ན་ལས་ཡིན་པའི་ཕྱིར་མི་མཐུན་པ་མེད་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ།",
    "དེ་ཡང་རང་བཞིན་ཁོ་ན་ཡིན་གྱི་ཁྱབ་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "འབའ་ཞིག་པ་ཉིད་ཀྱང་ས་ཕྱོགས་ལ་སོགས་པའི་མེད་པ་བཞིན་དུ་མེད་པ་གཞན་མེད་ཀྱང་རང་ཉིད་ཁོ་ན་ལས་གྲུབ་པར་བསྟན་པ་ནི།",
    "འདུག་པའི་ནག་པ་ནི་འགྲོ་བ་མ་ཡིན་ནོ།",
    "འདིར་ཡང་འདུག་པ་དང་།",
    "སྐྱེས་བུ་རྣམས་ཐ་སྙད་འདོགས་པ་ན་དྲུང་ན་འདུག་པ་དེ་རང་བཞིན་གྱིས་གོ་བ་འདི་ཡང་གཏམ་ཙམ་ཡིན་ཏེ།",
    "གཟུང་བའི་རྣམ་པ་ཡང་རང་རིག་པ་མ་ཡིན་ནམ།",
    "ད་ནི་དེ་ཡང་རང་ལས་སམ་གཞན་ལས་ཡིན་ཞེས་རྣམ་པར་དཔྱད་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་གནོད་པ་མེད་པ་ཉིད་ཀྱི་མཚན་ཉིད་ཀྱང་རང་ལས་ཡིན་ནོ་སྙམ་པ་སྔོན་དུ་འགྲོ་བས་ཟེར་བ་ནི་འོན་ཏེ་གནོད་པ་མེད་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་ནས།",
    "དེ་ཡང་རང་དངོས་སོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "བདེ་བ་བཞིན་དུ་སྔོན་པོ་ཡང་རང་རིག་པ་ཁོ་ན་ཡིན་ཏེ།",
    "ཅིག་ཤོས་ཀྱང་རང་ལས་རྟོགས་པ་མ་ཡིན་ནོ།",
    "དེས་ཀྱང་རང་བཞིན་དང་རྒྱུའི་དངོས་པོ་ཉིད་འཛིན་པར་བྱེད་པའི་བདག་ཉིད་དང་།",
    "འབྲེལ་པ་ཅན་མ་ཡིན་པ་ཡང་རང་བཞིན་གྱིས་འབྲེལ་པ་ཅན་དུ་བྱེད་པ་ནི་སྐྱེས་བུ་ཡིན་ནོ་ཞེ་ན།",
    "དཔེར་ན་ཡི་གེ་ག་དང་ཨའུ་དང་ཚེག་དྲག་རྣམས་ཀྱང་རང་ཉིད་རྟག་པ་དང་།",
    "བ་ཞོས་ཙམ་དུ་འདུག་ཅེས་བྱ་བ་ནི་བྱ་བ་ཉིད་བྱ་བ་གཞན་ཡོངས་སུ་གཅོད་པ་ཙམ་དུ་སྣང་ངོ་ཞེས་དེ་ལྟར་ཡང་བརྟག་པར་མི་བྱའོ།",
    "ཤེས་བྱའི་དུས་སུ་ཡང་ཡལ་བར་འདུག་པ་ཉིད་ཀྱི་ཕྱིར་ཇི་ལྟར་དེ་ཡང་དག་པར་རིག་པར་རྣམ་པར་གཞག་པར་འགྱུར་ཞེ་ན།",
    "དེ་བཞིན་དུ་སེམས་ཀྱི་རང་བཞིན་ཡང་མ་རིག་པའི་དྲི་མས་གཡོགས་པའི་སྐྱེས་བུ་ནི་ཤིན་ཏུ་གཉིད་ལོག་པ་ལྟ་བུར་འདུག་པ་ཡིན་ལ།",
    "རྟོགས་པར་བྱེད་པ་ཡིན་ལ་བྱ་བ་དེ་ཉེ་བར་ཟད་ནའང་དེ་ཁོ་ན་ལྟར་ཤིན་ཏུ་གཉིད་ལོག་པ་བཞིན་དུ་འདུག་པའི་ཕྱིར།",
    "གལ་ཏེ་དམིགས་པ་མེད་པ་བཞིན་དུ་རུང་བའི་མེད་པ་ཡང་རང་ལས་རྟོགས་པར་ཅིས་མི་འདོད།",
    "སེམས་པ་ཅན་མ་ཡིན་པ་འདུག་པར་མཐོང་བ་ཡིན་ན་གཞན་འཇུག་པར་བྱེད་པ་ཉིད་ནི་མ་ཡིན་ཏེ།",
    "ཕ་རོལ་པོས་ཁས་བླངས་པ་ཡིན་ཡང་རང་ཉིད་མ་མཐོང་ན།",
    "རྟག་པ་ཉིད་ཡིན་པས་འབྲས་བུ་ཡོད་པ་དང་མེད་པའི་དུས་སུ་བྱ་བ་མེད་པར་འདུག་པ་ཡིན་པར་བསྟན་ནས།",
    "སྡོད་པར་མི་བྱེད་པ་རྣམས་ཀྱི་ཡང་ཉེ་བར་འགྲོ་བའི་རྒྱུ་རྣམས་ཀྱིས་བྱ་བ་མེད་པར་འདུག་པ་ཉམས་པ་རྣམས་ཁོ་ནར་ཉེ་བར་འགྲོ་བར་བྱ་བའི་ཕྱིར།",
    "དེ་ཡང་རང་དོན་མ་བོར་བས།",
    "དེ་ལ་ཡང་རང་ཉིད་ལས་རིག་པ་མེད་པ་ཡིན་ཏེ།",
    "མངལ་ན་འདུག་པ་ལ་སོགས་པའི་སྡུག་བསྔལ་མང་པོས་བརྗེད་པ་སྲིད་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་རིམ་པ་ཇི་ལྟར་བྱ་བའི་དོར་བྱ་ལ་སོགས་པ་ལ་གོམས་པར་གྱུར་པ་ཡལ་བར་འདུག་པ་དང་པོ་ཉིད་ནས་མ་ལུས་པ་ལ་བཏང་སྙོམས་པའི་ཡང་སེམས་པ་ནི།",
    "དེ་ཡང་དེ་ཚེ་ཡོད་ན་རྟོག་པ་དང་བཅས་པའམ་ཅིག་ཤོས་ཀྱང་རང་རིག་པ་ཡིན་ན་རྨི་ལམ་གཞན་བཞིན་དུ་ཅིའི་ཕྱིར་དྲན་པར་མི་འགྱུར།",
    "འདོད་ཆགས་དང་འདོད་ཆགས་མེད་པ་དག་དུས་གཅིག་ཏུ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "ཡང་ན་ལུས་བཞིན་དུ་གཞན་གྱི་སེམས་ཀྱང་རྟེན་མ་ཡིན་ཏེ་དེ་ལ་ཁྱད་པར་མེད་ཀྱང་རང་གོམས་པའི་ཁྱད་པར་གྱིས་ཁྱད་པར་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཐ་དད་པ་ཡང་རང་བཞིན་ཐ་དད་པའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "འགའ་ཞིག་ནི་འདི་ན་འདུག་པ་ཉིད་ཅེས་བྱ་བ་སྟེ་རྒྱུན་གྱིས་སོ།",
    "དེ་དེས་དབེན་པའི་ངོ་བོ་ཁོ་ན་ཡིན་པའི་ཕྱིར་ཤེས་པ་ཡིན་ཏེ་དེ་ལ་རུང་བའི་ཡུལ་ཅན་རྣམས་ཀྱིས་མི་ཤེས་ཀྱང་རང་ཉིད་ཤེས་པའི་ཕྱིར་རོ།",
    "ཁྲི་ལ་འདུག་པ་ལ་ཁྲིའི་སྒྲ་ལྟ་བུའོ་ཞེས་ཟེར་བ་ན།",
    "ཁྲི་དང་དེ་ལ་འདུག་པ་ཁོ་ན་བཞིན་དུ་རྡུལ་ཕྲ་རབ་དང་དེའི་ཕྲད་པ་དག་སོ་སོར་སྣང་བ་ཐ་དད་པར་འགྱུར་ལ་དེ་རྣམས་རྟག་ཏུ་མ་དམིགས་པ་ཡིན་ན་གཟུགས་བཞིན་དུ་དམིགས་བྱ་ཡིན་པར་ཉེ་བར་བཏགས་པ་མ་ཡིན་ནོ།",
    "ཡོན་ཏན་ནི་ཡོན་ཏན་ཅན་གྱི་ཁྱད་པར་མཚོན་པར་བྱེད་པ་ཡང་རང་ཡོངས་སུ་གཅོད་པས་མཚོན་པར་བྱེད་པ་ཡིན་གྱི་གཞན་མཚོན་པར་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་དུ་མའང་གཅིག་དུས་ཅན།",
    "འདི་ཡང་རང་ཡིན་ལ་རིགས་ཀྱང་ཡིན་ལ་ཞེས་བྱ་བའི་ཤེས་པའི་ནུས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་ཚེ་ཡང་དེའི་རྒྱུ་དང་འབྲས་བུ་དང་རང་བཞིན་དང་དབྱེ་བ་རྣམས་ཀྱི་འབྲེལ་པ་ནི་འབྲས་བུ་དང་རྒྱུ་ཉིད་དེ་རིགས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "བདེ་བ་ཡང་རང་སྐྱེས་པ་ཙམ་གྱིས་སྐྱེད་བྱེད་མ་ཡིན་གྱི།",
    "དེ་ཡང་རང་ལ་ཕན་འདོགས་པས་བྱེད་པའི་བག་ཆགས་གང་ཡིན་པ་དེ་ནི་ཕན་འདོགས་པའི་བག་ཆགས་སོ།",
    "རུང་བའི་ཡུལ་ན་ཡོད་པ་རྣམས་མི་ཤེས་ཀྱང་རང་ཉིད་ཤེས་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི།",
    "ཁ་ཅིག་ཏུ་སྔ་ན་ཡང་རང་ཉིད་ཁོ་ན་མེད་པ་ཡིན་ཏེ།",
    "སྟོན་པ་པོ་ལ་ལྟོས་ནས་འབད་པ་པོའི་རྟོགས་པ་ཡང་རང་རིག་པ་ཙམ་ནི་འདོད་ཆགས་དང་བྲལ་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "བདག་ཏུ་འཛིན་པ་ཡང་རང་བཞིན་ཁོ་ན་མ་ཡིན་ནམ།",
    "ཡང་དག་དོན་དང་རང་བཞིན་ཞེས་བྱ་བའི་ཚིག་གཉིས་ནི་གསལ་བར་མི་ནུས་པ་ཉིད་དང་འབད་པ་མེད་པ་ལ་རྒྱུ་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ཉམས་སུ་མྱོང་ན་ཡང་རང་རིག་པ་ཡིན་ན་ཇི་ལྟར་ལོངས་སྤྱོད་པར་བྱེད་པར་རྟོགས་པའི་ཐུག་པ་མེད་པ་མ་ཡིན་ཏེ།",
    "བག་ཆགས་ནི་གཙོ་བོའི་རྣམ་པར་འགྱུར་བ་མ་ཡིན་གྱི་འོན་ཀྱང་རང་རིག་པ་བདག་ཁོ་ནའི་རང་བཞིན་ཡིན་ནོ་ཞེ་ན།",
    "འདུ་བྱེད་ལས་སྐྱེས་པའི་ཤེས་པ་ལ་ཡང་རང་ལ་ཡོད་པར་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "སྤྱི་ནི་དམིགས་པར་བྱ་བ་ཡིན་ཡང་རང་བཞིན་གྱིས་དམིགས་བྱ་མ་ཡིན་པས།",
    "དེ་མེད་ཀྱང་རང་རིག་པ་ལ་སོགས་པ་མངོན་སུམ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི་མ་ཡིན་ཏེ།",
    "དམིགས་པ་ལོག་པ་ཡང་རང་བཞིན་མི་དམིགས་ངོ་བོ་ནི་དངོས་པོའི་ལྡོག་བྱེད་ཉིད་མ་ཡིན་ནམ།",
    "བྱེད་པ་པོ་དང་ཁྱབ་བྱེད་དང་རང་བཞིན་མི་དམིགས་པ་རྣམས་ནི་མེད།",
    "འབྲས་བུ་དང་རང་བཞིན་དང་།",
    "ཡོད་པ་ཉིད་དང་རང་རྒྱུད་དང་།",
    "ཡིད་དག་དུས་གཅིག་ཏུ་འཇུག་པར་བྱེད་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ཤེས་པ་ཅིག་ཅར་མི་སྐྱེ་བ་ནི་ཡིད་ཀྱི་རྟགས་ཞེས་བྱའི་རིགས་པས་སོ།",
    "གཟུང་བའམ་འཛིན་པའི་ཤེས་པ་ལ་ཡང་རང་ལ་ཡོད་པའི་ཁྱད་པར་མེད་པའི་ཕྱིར་དང་།",
    "ལྐོག་ཏུ་གྱུར་པ་མ་ཡིན་པ་ཉིད་ཀྱིས་ཀྱང་རང་རིག་པར་བརྗོད་པ་ནི།",
    "བ་ལང་ཉིད་ལ་སོགས་པ་དབྱེ་བ་བྱེད་པར་མི་འགྱུར་བར་བསྟན་པ་ནི་བ་ལང་རང་ཉིད་ཀྱིས་ཞེས་བྱ་བའོ།",
    "རིག་པའི་བདག་ཉིད་ཀྱི་རྣམ་པ་ཤེས་ཀྱང་རང་ཉིད་རིག་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "སྔོན་པོ་ཡང་མི་རིག་པ་དང་རང་རིག་པའི་ཕྱོགས་ལས་མ་འདས་པའི་ཕྱིར།",
    "རྣམ་པར་འགྱུར་བ་ཡང་རང་བཞིན་གྱིས་ཞེས་བྱ་བའོ།",
    "རྒྱུ་ལས་དང་རང་བཞིན་ལས་ཀྱང་སྔོན་པོ་ལ་སོགས་པ་རྣམས་ལ་དྲི་བ་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ཡང་རང་ལ་མེད་པ་ཡིན་ཏེ།",
    "གནོད་པར་བྱེད་པའི་རྗེས་སུ་དཔག་པ་ཡང་རང་རིག་པའི་མངོན་སུམ་ལ་ནི་མ་ཡིན་ཏེ།",
    "གཉི་ག་དུས་གཅིག་ཏུ་རིག་བྱ་ཡིན་ལ།",
    "བཟློག་པ་ཡང་རང་རིག་པ་ཙམ་ཉིད་དུ་དམིགས་པ་ཡོད་དོ་ཞེས་ཟེར་བ་ལ།",
    "ཐོབ་པ་ཡང་རང་དང་རྗེས་སུ་མཐུན་པའི་ཤེས་པ་གཞན་སྐྱེད་པའི་རྗེས་སུ་དཔག་པ་ལའོ།",
    "ཤེས་པ་ཆ་ཁ་ཅིག་ཉིད་དུ་དོན་ཉིད་དུ་ངེས་པའི་རྗེས་སུ་འགྲོ་བའི་ཕྱིར་བདག་ནི་སྔོན་པོ་རིག་གོ་ཞེས་བྱ་བ་ཡང་རང་ཉིད་རིག་པའི་ལས་ཉིད་རྗེས་སུ་བརྗོད་པ་ཡིན་གྱི་ལས་གཞན་ཉིད་ནི་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་རྗེས་སུ་མཐུན་པ་ངེས་པས་ཐ་དད་པར་རྣམ་པར་འཇོག་པར་བྱེད་ཀྱི་འཛིན་པའི་རྣམ་པ་ནི་མ་ཡིན་ཏེ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་རྟོག་པ་ཡང་རང་རིག་པ་ཙམ་ཉིད་ཡིན་པའི་ཕྱིར་རོ་ཞེས་ཟེར་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "རྣམ་པ་མེད་པ་ཉིད་ཡིན་ཡང་རང་ཉིད་ཁོ་ན་ཡིན་ཏེ།",
    "དེས་ན་ཡུལ་ཡང་རང་རིག་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟ་ན་དེས་བྱས་པ་ཡིན་པ་དེའི་ཕྱིར་དེར་དེའི་ངོ་བོ་ཉེ་བ་ན་འདུག་པ་ཡང་ཤེས་པར་འགྱུར་རོ།",
    "ཐ་མི་དད་ན་ཡང་གཉི་ག་དུས་གཅིག་པར་འགྱུར་རོ།",
    "དེ་ལ་ཡང་རང་རིག་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་བསྟན་པ་ནི་རང་རིག་པ་གཞན་ཞེས་བྱ་བ་སྟེ།",
    "དོན་མྱོང་བ་གྲགས་པ་དང་རང་རིག་པ་གཉི་གར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁ་རོག་འདུག་པ་ནི་སེམས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཅེས་བྱ་བ་ནི་གཞན་གྱི་བདེ་བའི་ངོ་བོ་སྟེ་རྗེས་སུ་དཔག་པ་ཡང་རང་ཉིད་རིག་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མིག་ལ་སོགས་པ་མེད་ཀྱང་རང་རིག་པ་བཞིན་དུ་གསལ་བ་ཉིད་ཙམ་ལས་མངོན་སུམ་ཡིན་པར་བསྟན་པ་ནི་དང་པོ་ཞེས་བྱ་བའོ།",
    "དེའི་བློ་ཉིད་དུ་ཡང་རང་རིག་པ་ལ་རྩོད་པའི་མ་ཡིན་པར་བསྟན་པ་ནི་བྱ་བས་བྱས་པ་སྟེ་ཡིན་ན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དོན་བརྟགས་པས་ཅི་ཞིག་བྱ་ཞེས་བྱ་བ་ནི་ཕྱི་རོལ་དང་བེམས་པོ་དང་སྐད་ཅིག་མ་དང་རང་རིག་པ་མ་ཡིན་པས་སོ།",
    "དེ་ལ་ཡང་རང་ཉིད་དང་འབྲེལ་པ་ཡིན་ན་དེ་ལས་དང་པོར་དོན་མཐོང་བ་དང་།",
    "གཟུགས་དང་དེའི་རིག་པའི་སྣང་བ་དག་ལ་ཡང་རང་རིག་པ་མ་ཡིན་པར་རྗེས་སུ་དཔག་པའི་རིམ་པ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "དང་པོ་ཡང་རང་ཉིད་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "རྗོད་པར་བྱེད་པ་ཉིད་ལ་སོགས་པ་ཡང་རང་ཉིད་ཀྱིས་མ་ཤེས་པ་གཞན་གྱིས་ཤེས་སོ་ཞེས་བྱ་བ་ནི་ཐ་སྙད་ལ་སོགས་པས་ཤེས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནི་ཐ་སྙད་ལ་ཞེས་བྱ་བ་ནི་སྔ་ནས་འདུག་པའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དེས་སྒྲོ་བཏགས་པའི་དེའི་ཡུལ་ཉིད་ཀྱང་རང་བཞིན་མ་ཡིན་པ་ཡིན་ཏེ་མ་ངེས་པའི་ཕྱིར་རོ།",
    "ངེས་པའི་དོན་ལ་ཡང་རང་བཞིན་གྱིས་གོ་བྱེད་ཡིན་ཡང་བསྟན་བཅོས་དང་ལྡན་པ་ནི་ཁས་བླངས་པས་གནོད་པའི་འཇིགས་པས་དེ་ལས་རྟོགས་པར་བྱེད་པ་མ་ཡིན་ཞེས་ཟེར་བ་ལ་དེ་ནི་འདོད་པའི་ཞེས་བྱ་བ་སྟེ།",
    "གཞན་མེད་པས་ཀྱང་རང་ཉིད་ཀྱིས་བྱས་པ་ཁོ་ན་ལ་མ་བྱས་པ་ལྟ་བུར་ཐ་སྙད་ཡིན་པའི་ཕྱིར་རྟོགས་པ་དགག་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི་ཡང་ན་ཞེས་བྱ་བའོ།",
    "བརྩལ་མ་ཐག་ཏུ་ཤེས་པ་སྐྱེ་བའི་རང་བཞིན་ཉིད་ཀྱིས་འབྲས་བུ་དང་རང་བཞིན་དག་གྲུབ་པ་ཡིན་ན།",
    "འཇུག་མིན་ཡུལ་དང་ཞེས་བྱ་བ་ནི་ཡལ་བར་འདུག་པའི་ཡུལ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་དང་རང་བཞིན་གྱི་ལྡོག་པ་ནི་རང་བཞིན་མི་དམིགས་པ་ཡིན་ཡང་འབྲས་བུ་དང་ཁྱབ་བྱ་ལ་ལྟོས་ནས་དེ་ལྟར་བརྗོད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "འབྲས་བུ་དང་རང་བཞིན་དག་ནི་དེ་དང་བྲལ་བ་ལ་རྒྱུ་དང་ཁྱབ་པར་བྱེད་པ་དག་ལ་ཡང་ངོ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་རོ།",
    "སྣང་དུ་རུང་བ་དག་ཁོ་ནའི་འབྲས་བུ་དང་ཁྱབ་བྱ་དག་ལ་རྒྱུ་དང་རང་བཞིན་མེད་པ་ལས་མེད་པ་མ་ཡིན་ནམ།",
    "དེ་ཡང་རང་བཞིན་མི་དམིགས་པ་ནི་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ལ་དབྱེ་བ་བསྟན་པ་ནི་དམིགས་པར་བྱ་བ་མེད་པ་ནི་ཞེས་བྱ་བའོ།",
    "ཤེས་པ་ཡང་རང་དང་གཞན་གྱི་ཤེས་པས་སྣང་དུ་རུང་བ་དང་སྣང་དུ་རུང་བ་མ་ཡིན་པ་ཡིན་ལ་ཤེས་བྱ་བ་ཡང་རང་དང་གཞན་ལ་གནས་སུ་རུང་བ་ཉིད་དེ་བཞིན་དུ་ཡིན་གྱི་གཞན་དུ་ན་ཐུག་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་ཁྱད་པར་ཤེས་པར་བྱ་བ་ཡིན་ལ་ད་ལྟར་མེད་དོ་ཞེས་བྱ་བར་གྲུབ་པའི་དོན་ཅན་ནི་མ་ཡིན་ནོ།",
    "འདི་ལས་ཀྱང་རང་བཞིན་མི་དམིགས་པ་དོན་མེད་པར་བསྟན་པ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཞེས་བྱ་བའོ།",
    "དེ་ཉིད་ཅེས་བྱ་བ་ནི་རྒྱུ་དང་ཁྱབ་བྱེད་དང་རང་བཞིན་གྱི་མི་དམིགས་པའི་དབྱེ་བས་ཁྱབ་པར་བྱ་བ་དང་ཅིག་ཤོས་ཀྱི་ངོ་བོ་ཡང་ཡིན་གྱི་ཐ་དད་ནི་མ་ཡིན་ནོ།",
    "རིགས་པ་རྣམས་ཀྱང་རང་བཞིན་གྱིས་རྟོགས་རྒྱས་པ་མང་པོས་འདིར་མ་བཤད།",
    "འབྲས་བུ་ཡང་རང་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་ཡིན་ནོ།",
    "དེ་ཡང་འབྲས་བུ་དང་རང་བཞིན་ལས་མི་འདའ་བའི་ཕྱིར།",
    "དེ་ལྟར་ན་ཡང་འབྲས་བུ་དང་རང་བཞིན་དང་མི་དམིགས་པ་གསུམ་གཏན་ཚིགས་ཡིན་པ་ག་ལས་ཤེས་དོགས་ན་རང་བཞིན་འབྲེལ་པ་གསུམ་ལ་ངེས་པར་བསྟན་པའི་ཕྱིར་རྩོམ་པ་ནི་དེ་ནི་ཞེས་བྱ་བའོ།",
    "འབྲས་བུ་ཇི་སྲིད་པ་ཡང་རང་བཞིན་འབྲེལ་པ་ཡིན་ནོ།",
    "མི་དམིགས་པ་ཡང་རང་སྒྲུབ་པར་བྱེད་པའི་མི་དམིགས་པ་རྟོགས་ན་ཡིན་ནོ།",
    "དེས་ན་འདི་ཡང་རང་བཞིན་མི་དམིགས་པ་ཡིན་ཞིང་འདིར་ཡུལ་ཅན་བསྒྲུབ་པར་བྱ་བར་འགྱུར་རོ་ཞེ་ན།",
    "བཞི་པ་ཡང་རང་བཞིན་མ་གྲུབ་པ་ནི་ཞེས་བྱ་བ་རང་བཞིན་མི་དམིགས་པས་ནི་དཔེར་ན་འདི་ན་དུ་བ་མེད་དེ་མི་དམིགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "སྲིད་པའི་བསྒྲུབ་བྱ་ལ་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་མཚན་ཉིད་དང་ལྡན་པའི་ཕྱིར་རང་བཞིན་གྱི་གཏན་ཚིགས་ཉིད་དུ་སྟོན་པས་རྒྱུ་ཚོགས་པ་ཡིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "འོན་ཀྱང་གཏན་ཚིགས་འདི་འབྲས་བུ་མ་ཡིན་ཞིང་རང་བཞིན་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བར་འགྱུར་རོ།",
    "ཕྲུ་བའི་ནང་ན་འདུག་པ་རྣམས་ལས་མང་པོ་ཞིག་ཚོས་པར་མཐོང་བས་ན་ཕྲུ་བའི་ནང་དུ་ཚུད་པ་ཞེས་བྱ་བ་ཁོ་ནས་ནི་ཚོས་པར་མི་འགྲུབ་སྟེ།",
    "ཡང་ན་གཉི་ག་ཡང་གཉི་ག་ལ་ཐེ་ཚོམ་ཟ་བ་ཡིན་ཏེ་ཕྲུ་བའི་ནང་ན་འདུག་པ་ཉིད་ནི་མཐུན་པའི་ཕྱོགས་ལ་ཡང་ཐེ་ཚོམ་ཟ་བའི་ཕྱིར་རོ།",
    "སྔར་གྱི་མ་མཐོང་བ་ཡང་རང་བཞིན་འདི་ཉིད་དུ་ཟད་དོ།",
    "དེས་ན་ངོ་བོ་ཅན་མཐའ་ཡས་ཀྱང་རང་ཉིད་ངེས་པའི་ཡུལ་དང་དུས་ཀྱི་དངོས་པོ་ལ་མི་ལྟོས་པར་སྣང་བའི་སྤྱོད་ཡུལ་དུ་མི་འགལ་ལོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པས་བལྟར་མི་ནུས་པ་དག་ལ་ནི་སྤང་བ་སྲིད་པ་མ་ཡིན་ནོ།",
    "འོ་ན་ཇི་ལྟར་སྐད་ཅིག་མ་ཉིད་ལ་སོགས་པ་སྣང་བ་དང་རང་བཞིན་གཅིག་པ་ཡིན་ཡང་མངོན་སུམ་མ་ཡིན་ན།",
    "དེ་ཡོད་པ་ལས་མངོན་སུམ་ཉིད་ཡིན་ཡང་དེ་ལས་ཤེས་པ་དེ་སྐྱེས་སོ་ཞེས་བྱ་བ་གོ་ག་ལས་ཡིད་ལ་བྱེད་པ་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ཡང་དེ་ལས་ཤེས་པ་སྐྱེས་སོ་ཞེས་བྱ་བར་ནི་མ་གྲུབ་བོ།",
    "དེ་སྟེ་འོ་མ་དང་རང་བཞིན་གཅིག་པ་ཉིད་ཀྱི་འོ་མའི་བདག་ཉིད་དུ་དམིགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཅི་སྟེ་ཡང་རང་ཉིད་མ་གྲུབ་ཅིང་ནུས་པ་གཞན་ཡང་མཚོན་པར་མི་བྱེད་པ་ནི་ཐེ་ཙོམ་ཟ་བ་ཡང་ངེས་པ་དང་ལྡན་པ་ཉིད་དུ་བསྟན་པར་འགྱུར་བའི་ཕྱིར་དེ་ཇི་ལྟ་བ་བཞིན་མ་ཡིན་པ་ཁོ་ནར་བསྟན་པར་འགྱུར་རོ།",
    "གཏན་ཚིགས་དེའི་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག་མེད་པ་སྟེ།",
    "དེས་ན་ལྡོག་ན་ལྡོག་པར་བྱེད་པ་རང་བཞིན་འབྲེལ་པ་ཡིན་པ་དེས་ན་དཔེས་ཉེ་བར་བསྟན་པ་ན་གཏན་ཚིགས་ཀྱི་ཡན་ལག་མ་ཡིན་ཡང་གང་ཞིག་དགག་པར་འདོད་པ་དེ་བཀག་པ་ཡང་རང་བཞིན་འབྲེལ་པ་ལ་བརྟེན་པ་ཁོ་ནས་རྟོགས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་འོ་ན་དགག་པའི་གཏན་ཚིགས་ཀྱི་སྒྲའི་དོན་དེའི་ཡུལ་ཅན་གྱིས་ཐ་སྙད་ཀྱི་དོན་ཡིན་པ་དེས་ན་རྒྱུ་དང་རང་བཞིན་མི་དམིགས་པ་ཞེས་བྱ་བ་དེར་རྗེས་སུ་འགྲོ་བ་འགལ་ལོ་ཞེ་ན།",
    "སྦྱོར་བ་གཞན་ཁོངས་སུ་འདུ་བ་ཅན་དེ་དག་ཀྱང་རང་བཞིན་མི་དམིགས་པའི་ཁོངས་སུ་འདུའོ།",
    "གལ་ཏེ་དངོས་པོའི་གནས་ལུགས་ཀྱང་རང་ཉིད་གསལ་བ་ནི་མ་ཡིན་ལ།",
    "དཔེར་ན་ལོ་མ་ལ་སོགས་པ་དང་ལྡན་པའི་ཁྱད་པར་ཁོ་ན་ཤ་པའི་ཕྱིར་ཤ་པ་ཞེས་བྱ་བས་ཤིང་ཉིད་ཀྱི་ནང་དུ་འདུག་པ་ཡིན་ཡང་སེང་ལྡེང་ལ་ཡང་ཡོད་པའི་ཕྱིར་རྣམ་པར་རྟོག་པས་ཐ་དད་པར་བྱེད་པ་དེ་བཞིན་དུ་དེའི་དུས་སུ་གྲུབ་པ་དུས་གཞན་དུ་གྲུབ་པ་ལས་རང་བཞིན་ཐ་དད་པ་ཡིན་ཡང་ཐ་དད་པ་ཙམ་གྱི་ཁྱད་པར་དུ་གྱུར་པ་ཞེས་བྱ་བར་མི་འགྲུབ་པོ།",
    "དེས་ན་དེ་ལྟར་དེས་དེ་དང་དུས་གཞན་དུ་གྲུབ་པ་དག་དུས་ཐ་དད་པ་དང་གཅིག་ཉིད་བདག་ཉིད་གཞན་དང་བྲལ་བའི་རང་བཞིན་ཡིན་པར་རྣམ་པར་ཕྱེ་ནས་དེ་དག་ཐ་དད་པར་ངེས་པ་ཡིན་ནོ།",
    "དེ་མེད་པར་ཡང་རང་བཞིན་མི་དམིགས་པ་ཉིད་ཀྱིས་རྟོགས་པ་ཡིན་ཏེ་ཕྱིས་ཡོད་པའི་ཕྱིར་རོ།",
    "དེ་ཇི་ལྟར་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་དུས་ཀྱི་ཁྱད་པར་གྱིས་ཁྱད་པར་མེད་པས་རྟག་ཏུ་ཡོད་པའམ་མེད་པར་བརྗོད་ཅེ་ན།",
    "དེ་ཡོད་པ་ཡང་རང་བཞིན་དེ་ཉིད་ཡིན་པ་ནི་བསྟན་ཟིན་ཏོ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "དངོས་པོའི་དེའི་ངོ་བོ་ཉིད་ནི་དེ་དང་རང་བཞིན་གཅིག་པའམ་དེ་དང་འབྲེལ་པ་ལས་འགྱུར་ལ།",
    "མི་རྟག་པའོ་ཞེས་དེ་བཞིན་དུ་གཞན་སེལ་བ་ན་ཐ་དད་པ་ལ་བསླད་པ་མེད་ཀྱང་རང་བཞིན་ལ་བསླད་པར་འགྱུར་རོ།",
    "འོན་ཀྱང་རང་བཞིན་གྱིས་གཅིག་ཡིན་ཡང་དུ་མ་དང་ལྡན་པ་ཡིན་ནོ།",
    "དངོས་པོ་གཅིག་དང་རང་བཞིན་ཉིད།",
    "དེས་ན་གལ་ཏེ་ཨུཏྤ་ལ་དང་སྔོན་པོ་བཞིན་དུ་དཀར་པོ་ཉིད་བ་ལང་ཉིད་དང་རང་བཞིན་གཅིག་པར་སྣང་ན།",
    "དེ་ལྟར་རྗེས་སུ་འགྲོ་བ་ལ་བརྟེན་པས་དེ་དང་རང་བཞིན་གཅིག་ཉིད་དུ།",
    "མང་པོ་ལ་ནི་རྫས་ལ་སོགས་པའོ་ཞེས་བྱ་བ་དེ་ཡང་རང་ཉིད་ཞུགས་པ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་ལྟ་བུ་མ་ཡིན་པའི་ཁྱད་པར་དུ་གྱུར་པའི་སྤྱི་དང་ལྡན་ཡང་རང་བཞིན་མེད་པ་ཡིན་ན་ནི་བ་ལང་ཉིད་དང་ལྡན་ཡང་བ་ལང་ལ་བ་ལང་ངོ་ཞེས་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "དེ་ཡང་རང་བཞིན་མེད་པ་ཡིན་པའི་ཕྱིར་ནམ་མཁའ་ཉིད་གཞན་དང་ལྡན་ཡང་དེ་དག་རང་བཞིན་མེད་པ་མ་ཡིན་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན་བརྗོད་པ།",
    "སྲེད་ན་ཡང་རང་རིག་པའི་ཡུལ་ལ་དོན་ཉིད་དུ་ངེས་པར་འདིའི་ཡུལ་གང་ཡིན་ཞེས་ཡུལ་བསམ་པ་ནས།",
    "དེས་ན་གསལ་བ་གཞན་ལ་ཡང་རང་བཞིན་དེ་ཉིད་རྟོགས་པ་ཡིན་པའི་ཕྱིར་དེར་ཡང་དེ་ཁོ་ན་བཞིན་རྟོགས་པས་ན་ཐ་མི་དད་པར་རྟོགས་པ་ཡིན་ནོ།",
    "ཅི་སྟེ་ཡང་རང་བཞིན་ཡིན་པ་དེ་ལྟ་ན་སྤྱི་ཉིད་བྱེད་པ་པོར་འགྱུར་གྱི་གསལ་བ་ནི་མ་ཡིན་ནོ།",
    "འབྲེལ་པ་ཙམ་ཡོད་ཀྱང་དུས་ཐ་དད་ན་རང་བཞིན་དང་རང་བཞིན་ཅན་ཉིད་མ་ཡིན་པས་ན།",
    "བ་ལང་ལ་སོགས་པའི་སྒྲ་ཡང་རང་བཞིན་རྗོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "རང་བཞིན་དང་རང་བཞིན་ཅན་དག་གྲུབ་སྟེ་གཅིག་པ་ཉིད་ཡིན་ན་ནི་ཐ་མི་དད་ལ་ཐ་དད་པ་དང་རྗེས་སུ་འབྲེལ་པ་མེད་པར་འགྱུར་རམ།",
    "ཐ་དད་པ་ནི་རྗེས་སུ་འགྲོ་བ་ཡིན་ཡང་རང་བཞིན་རྟོགས་པ་མི་སྲིད་པ་དེས་ཇི་ལྟར་ཐ་དད་པ་རིགས་ཀྱི་དོན་བསྒྲུབ།",
    "ཅིའི་ཕྱིར་འདི་ན་བ་ལང་འདུག་གོ་ཞེས་བརྗོད་པ་ན་བ་ལང་བརྟེན་པའི་མི་བསླུ་བར་ངེས་པར་འགྱུར་གྱི་བུམ་པ་ལ་མ་ཡིན་ན་ཤེས་པ་དེ་དེའི་ཡུལ་མ་ཡིན་པས་ན་བུམ་པ་རྙེད་པ་ན་ཇི་སྟེ་མི་བསླུ་བ་མ་ཡིན་ལ་གཞན་དུ་བཟློག་པར་འགྱུར་ཞེས་བྱ་བའི་རྩོད་པར་འགྱུར་རོ།",
    "རིགས་མི་མཐུན་པ་རྣམས་ལ་ཡང་རང་བཞིན་གཞན་དུ་མཚོན་པའི་འཁྲུལ་པས་དེའི་རིགས་སུ་གཏོགས་པ་ཉི་ཚེའི་སྦྱིའི་རྒྱུ་ཅན་ཡིན་ནོ་ཞེས་གཞན་གྱི་ཁས་བླངས་པ་དགག་པའི་དོན་དུ་ཡང་དག་པ་དང་།",
    "ཁྲག་ལ་སོགས་པ་མཐོང་བ་ཙམ་གྱིས་ཀྱང་རང་བཞིན་གྱིས་སྡར་མའི་ཡིད་འགྱུར་བར་མཐོང་བའི་ཕྱིར་ཡིན་གྱི།",
    "གཉིད་ལོག་དུས་སུ་གཞན་མེད་པའི་ཕྱིར་རོ།",
    "མ་བརྩངས་པར་ཡང་རང་ཉིད་སད་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་དུ་མའང་གཅིག་དུས་ཅན།",
    "དེ་བས་ན་གོམས་པས་སོ་སོར་ངེས་པའི་ཁྱད་པར་ཡོད་ཀྱང་རང་བཞིན་ལས་འདས་པ་ཐམས་ཅད་མྱོང་བར་མི་འགྱུར་རོ་ཞེ་ན་འདིར་ལན་བཏབ་པ།",
    "གལ་ཏེ་ཐ་མའི་སེམས་ལ་ཐ་དད་པའི་དོན་བྱེད་པ་མེད་པ་དེ་ལྟ་ན་ཡང་རང་རིག་པའི་ཕྱིར་ཇི་ལྟར་མེད་པ་ཡིན་འདི་ལྟར་དམིགས་པ་ལ་ཡོད་པར་བརྗོད་དོ།",
    "གལ་ཏེ་ཡང་རང་རྒྱུད་པ་ནུས་པ་ཅན་ཡིན་ན།",
    "དེ་ལྟ་ན་ནི་རྟག་པའི་ཡང་རང་སྡུག་བསྔལ་བར་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་ཉིད་འཆིང་བ་ཡིན་པར་འགྱུར་ན།",
    "དེ་བས་ན་རྟོག་པའི་ངོ་བོ་ཉིད་དང་རང་བཞིན་ལ་ཐ་དད་པར་ཤེས་ཏེ།",
    "སྐྱེས་བུ་ལ་སོགས་པ་མེད་ན་དཔུང་རང་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལ་ཡང་རང་བཞིན་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དུས་ཐ་དད་པས་དངོས་པོ་ཐ་དད་པ་དང་དེ་ཉིད་ཡིན་པར་ཇི་ལྟར་ཤེས་ཏེ་ཡོད་པའི་ཡུལ་ཅན་ཡིན་ཡང་སྔ་ཕྱིའི་ཤེས་པ་དག་དུས་ཐ་དད་པ་ཉིད་ཡིན་གྱི་དངོས་པོ་ཐ་མི་དད་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "འོ་ན་སྤྱི་དངོས་པོ་མེད་པ་ཉིད་དུ་གྱུར་ན་མི་དམིགས་པ་དང་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཇི་ལྟར་ཐ་དད་པར་འགྱུར་ཏེ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་ཡུལ་ཡིན་ལ།",
    "དེ་བས་ན་དེའི་རྒྱུ་ཡང་འབྲས་བུ་དང་རང་བཞིན་དང་མི་དམིགས་པ་དག་ཐ་དད་པ་ཡིན་ཏེ།",
    "ཡོད་པ་ཉིད་ཀྱང་གཉིས་ཏེ་ཐ་དད་པ་དང་ཐ་མི་དད་པ་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་ཡུལ་ཡིན་ནོ།",
    "རྗེས་སུ་དཔག་པ་ཡང་རང་བཞིན་ལ་ལྟོས་ནས་འཁྲུལ་པ་མེད་པ་དང་།",
    "གང་དུ་བསྒྲུབ་པར་བྱ་བས་ཁྱབ་པ་དེ་ལ་འབྲས་བུ་དང་རང་བཞིན་གྱིས་གཏན་ཚིགས་གོ་བར་བྱེད་པ་ཡིན་ལ།",
    "དེ་ལྟར་འབྲས་བུ་དང་རང་བཞིན་དང་མི་དམིགས་པའི་མཚན་ཉིད་ཅན་གསུམ་ནི་རྗེས་སུ་དཔག་པ་ཡིན་ནོ་ཞེས་བསྒྲུབས་པ་ཡིན་ནོ།",
    "མི་དམིགས་པ་དེ་ཡང་རྒྱུ་དང་ཁྱབ་པར་བྱེད་པ་དང་རང་བཞིན་ཏེ།",
    "རྟོག་པ་མེད་པ་ཡང་རང་རིག་པའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་རྟོག་པ་དང་བྲལ་བ་ཤེས་པ་ཡིན་ཡང་ངེས་པ་གཞན་གྱིས་ཁོང་དུ་ཆུད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "རྒྱུ་དང་འབྲས་བུ་དག་དུས་ཐ་དད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་ཡང་རང་དང་གཞན་དུ་སྣང་བའི་རྣམ་པ་གཉིས་རང་རིག་པར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "འོ་ན་བདག་དེ་ཡང་རང་རིག་པ་ཉིད་ཡིན་ནམ།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་ངོ་བོ་ཉིད་ཀྱིས་བྱེད་པ་པོ་རིགས་པ་ཡིན་ཏེ།",
    "དོན་དང་རང་བློ་ལྷན་ཅིག་མིན།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ངོ་བོ་ཉིད་ཀྱང་རང་རིག་པ་ལ་རྟོག་པ་མེད་པ་སྟེ།",
    "བདེ་བའི་རྣམ་པ་ཡང་རང་རིག་པ་སྟེ།",
    "ཇི་ལྟར་རང་རང་སྐྱེ་བའི་ནུས་པ་ཅན་གྱི་སེམས་པ་བདེ་བ་ལ་སོགས་པ་སྐྱེ་བར་སྣང་བ་དང་།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པ་ཉིད་མ་ཡིན་ནོ།",
    "འོན་ཏེ་སྔོན་པོ་དང་སེར་པོ་ཉིས་ཀྱིས་རང་རང་དུ་སྣང་བ་ཅན་གྱི་ཤེས་པ་སྐྱེད་ན།",
    "འོན་ཏེ་དྲན་པ་ཡང་རང་རིག་པའི་ངོ་བོ་ཉིད་ཅན་མ་ཡིན་ཏེ་དྲན་པ་ནི་ཁ་དོག་དང་དབྱིབས་ཀྱི་རྣམ་པ་ཅན་ཉིད་ཀྱི་དོན་སྣང་བའི་ཕྱིར་རོ།",
    "རྟོག་པ་ཡང་རང་རིག་པར་གསལ་བ་ཡིན་ཏེ།",
    "གཉི་གའི་ཤེས་པའི་ཡང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་ནོ།",
    "སྔོན་པོ་ལ་སོགས་པའི་བློ་ཡང་རང་རིག་པར་འགྱུར་རོ།",
    "གཞན་ཡང་ཕྱི་རོལ་གྱི་དོན་དུ་སྨྲ་བས་ཀྱང་རང་རིག་པ་ཉིད་འབྲས་བུར་ཁས་བླང་བར་བྱ་སྟེ།",
    "དོན་མེད་ཀྱང་རང་རིག་པའི་གླགས་སྐབས་མེད་དོ་ཞེ་ན།",
    "འོན་ཀྱང་རང་རིག་པ་ཉིད་ཡོད་པའི་ཕྱིར་རོ།",
    "དོན་ཇི་ལྟ་བ་བཞིན་དུ་དོན་རིག་པ་མ་ཡིན་པའི་ཕྱིར་ཕྱི་རོལ་གྱི་གཞལ་བྱ་ལ་ཡང་རང་ཉིད་ཉམས་སུ་མྱོང་བ་སྟེ།",
    "དྲན་པར་བྱེད་པ་ཡང་རང་རིག་པ་མ་ཡིན་ཏེ་དོན་གྱི་རྣམ་པ་ཉིད་དྲན་པའི་ཕྱིར་རོ།",
    "དོན་དང་མི་ལྡན་པའི་སེམས་སྐྲ་ཤད་ལ་སོགས་པ་དང་འདས་པའི་དོན་འཛིན་པ་ལ་ནི་དྲན་པ་ཡོད་པས་ཚུལ་གཉིས་པ་ཅན་དང་རང་རིག་པ་གྲུབ་པ་ཡིན་ཏེ།",
    "གཞན་གྱི་མཐོང་བ་མི་མཐོང་ཞིང་རང་ཉིད་ཀྱིས་ཁོང་དུ་ཆུད་པ་གཞན་གྱིས་མི་མཐོང་བའི་ཕྱིར།",
    "ཡུལ་གྱི་ཤེས་པའི་ཤེས་པ་གང་ཡིན་པ་དེ་དོན་དང་རྗེས་སུ་མཐུན་པའི་ཤེས་པ་སྣང་བ་དང་རང་སྣང་བ་ཡིན་ནོ།",
    "ཡུལ་གྱི་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་དོན་སྣང་བ་ཅན་དང་རང་སྣང་བ་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བ་སྟེ།",
    "བློ་ཡང་རང་རིག་པའི་ངོ་བོ་ཉིད་དེ་གཞན་ལ་ལྟོས་ནས་འཛིན་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་བས་ན་དོན་གང་ཞིག་དུས་ཡུན་རིང་པོར་གནས་པ་དེ་ཁོ་ན་བཞིན་དུ་ཅིག་ཅར་མཐོང་བར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་རྩིག་པ་ལ་སོགས་པ་ལ་ཡང་རང་རིག་པ་ལས་ངའི་རྩིག་པའོ་སྙམ་པའི་རྟོག་པ་སྐྱེ་བར་གྱུར་པ་ཞིག་ན།",
    "འོ་ན་གལ་ཏེ་གཟུགས་ལ་སོགས་པ་མ་རྟོགས་པའི་བློ་མེད་པ་དེ་ལྟ་ན་ཡང་རང་རིག་པ་མ་ཡིན་ཏེ་གཟུགས་ལ་སོགས་པའི་བློ་ལ་དེའི་རྣམ་པ་ཅན་གྱི་ཐ་དད་པའི་ཕྱིས་རིག་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེ་བཞིན་དུ་གལ་ཏེ་ཤེས་པ་ཡང་རང་རིག་པ་མ་ཡིན་ན།",
    "འོན་ཏེ་བདེ་བ་ལ་སོགས་པ་མངོན་སུམ་ཡིན་ཡང་རང་རིག་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཚེ་རང་མཐོང་བ་ཉིད་ལ་ཡང་རང་མཐོང་བ་གཞན་ཡོད་པས་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་བདེ་བ་ལ་སོགས་པ་དང་རང་མཐོང་བ་ནི་རང་རིག་པ་ཁོ་ནའོ་ཞེས་བསྟན་པས་དེའི་བདག་ཉིད་ཅན་གྱི་བློ་ཡང་རང་རིག་པ་ཉིད་དོ།",
    "དེ་ཡང་རང་ཉིད་ཀྱིས་སྣང་བ་འདོད་ཀྱི།",
    "བློའི་ནི་གཉི་ག་ཡང་རང་གསལ་བ་ཉིད་ཡིན་པའི་ཕྱིར་གསལ་བར་བྱ་བ་དང་གསལ་བར་བྱེད་པའི་དངོས་པོ་མ་ཡིན་ནོ།",
    "སྡོད་ན་ཕྱིས་ཀྱང་རང་ཉིད་ནི།",
    "གསལ་ཡིན་འགྲོ་འདི་གསལ་བར་འགྱུར།",
    "དེ་བས་ན་ཡུལ་སྣང་བ་དང་རང་རིག་པར་ནི་ཤེས་པ་ཐམས་ཅད་གྲུབ་པ་ཡིན་ནོ།",
    "སྤྲོས་པ་དེ་ཡང་རང་རིག་ཙམ་ལ་གནས་པ་ལས་འདས་ཐ་སྙད་ཙམ་ཉིད་དོ།",
    "བརྟག་པས་ཅི་བྱ་ཞེས་བྱ་བ་དེ་སོ་ན་འདུག་གོ་ཞེ་ན།",
    "གལ་ཏེ་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་དུས་མཚུངས་པ་མི་སྲིད་པའི་ཕྱིར་གལ་ཏེ་དེའི་ཚེ་མ་རྟོགས་པའི་བུམ་པ་དང་ཡང་དངོས་པོ་མེད་པ་འབྲེལ་པར་རིག་ན་དེའི་ཚེ་སྐྱོན་ཅི་ཡོད་ཅེ་ན།",
    "དེས་ན་ཅི་ལྟར་གཉི་ག་དུས་གཅིག་ཏུ་མི་རྟོགས་པ་འདི་རང་བཞིན་ཡིན་པ་དེ་བཞིན་དུ་འབྲེལ་པ་ཅན་ཉིད་དུ་ངེས་པ་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བར་གྲུབ་པོ།",
    "གཉི་ག་དུས་གཅིག་ཏུ་མཐོང་བ་ལ་ནི།",
    "འདིར་ཏྲོ་ལོ་ཙ་ནས་གལ་ཏེ་ངེས་པའི་ཚིག་ལ་གདོན་མི་ཟ་བར་བརྟེན་པར་བྱ་བ་ཡིན།",
    "སྐྱེས་བུ་ཡང་རང་ཉིད་མཆོད་སྦྱིན་ལ་སོགས་པ་རྟོགས་པར་ཅི་ལྟར་ནུས།",
    "འོན་ཀྱང་རང་གྲུབ་པར་བྱ་བའི་དོན་དུ་ངེས་པར་སྦྱོར་བར་བྱེད་པའི་དོན་གཞན་ཁོ་ན་ཞིག་ངེས་སྦྱོར་དུ་སྨྲ་བའོ།",
    "དེ་ལ་སྦྱིན་སྲེག་གྱིས་ཤིག་ཅེས་བྱ་བས་ནི་ལིང་ངའི་དོན་དང་རང་གྲུབ་པའི་དོན་དུ་སྐུལ་བ་འཕངས་པས་ངེས་པར་སྦྱོར་བ་དང་།",
    "གལ་ཏེ་ཡང་གཞན་དག་ཏུ་ཡང་འདི་སྐད་བརྗོད་པ་ནུས་པ་དེ་ལྟ་ན་ཡང་དེ་དག་ཏུ་ནི་སོ་སོ་རང་རང་སུན་འབྱིན་པར་འགྱུར་བས་སྐྱོན་མེད་དོ།",
    "ཕན་ཚུན་བསྟེན་པའི་ཉེས་པ་སོ་ན་འདུག་གོ།",
    "དེ་ཡང་རང་རིག་པ་ཉིད་ཀྱིས་རྟོགས་པའི་ཕྱིར།",
    "རྫ་མཁན་ལ་སོགས་པ་ནི་རང་བསྡད་ཅིང་བསྡད་ཅིང་འདུག་པ་ཡིན་ལ།",
    "བལྟར་རུང་བ་ཡང་རང་བཞིན་གྱིས་བསྐལ་པ་སྤངས་པ་ཁོ་ནས་ཡིན་གྱི།",
    "རིགས་པ་ནི་ནམ་ཡང་རང་རིག་པས་བལྟ་བར་བྱ་བ་ཉིད་ལས་འདའ་བ་མེད་ལ།",
    "ལུས་ཀྱི་བདག་ཉིད་དམ་ཞེས་བྱ་བ་ནི་རང་བཞིན་ཡང་རང་བཞིན་ཅན་ལ་བརྟེན་པ་ཞེས་བརྗོད་པར་འདོད་པས་སོ།",
    "གཞན་དག་འབྲས་བུ་དང་རང་བཞིན་གྱི་ཕྱོགས་སྦྱར་བར་བྱ་བའི་ཕྱིར་གལ་ཏེ་ཞེས་བརྗོད་དོ།",
    "དེ་བཞིན་དུ་དངོས་པོ་ཡང་རང་བཞིན་འགྱུར་བ་ན།",
    "དེ་བཞིན་དུ་འཆི་བའི་གནས་སྐབས་སུ་ཡང་རང་ངམ་གཞན་གྱི་སེམས་རྣམ་པར་ཆད་པས་མི་རྟོགས་སོ།",
    "འོན་ཀྱང་རང་ངམ་འབྲེལ་བ་ཅན་གྱི་ཡོད་པ་དང་མེད་པ་སྲིད་ན་ཡིན་ནོ།",
    "རྒྱུད་ཀྱང་རང་བཞིན་གྱིས་བརྩེ་དང་ལྡན་པ་ལ་ནི་བརྩེ་བ་ཉིད་འབྱུང་ལ།",
    "དེ་ལྟར་ན་ཡང་རང་ལོག་ན་ལྡོག་པར་བྱེད་པ་གོ་ཅི་ལྟར་སྙམ་ན།",
    "འོན་ཀྱང་རང་ལོག་པས་ཟློག་པར་བྱེད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "དེས་ན་ཡན་ལག་ཅན་རིག་པའི་རང་བཞིན་ཡིན་ཡང་རང་ཉིད་རྡུལ་ཕྲ་རབ་དག་ལས་སྐྱེ་བར་རིག་པར་ཇི་ལྟར་ཤེས།",
    "ཡོན་ཏན་གྱི་མཚན་ཉིད་ཉམས་པ་སོན་འདུག་གོ་སྙམ་དུ་དོགས་པའོ།",
    "གཞན་གྱིས་ནི་སྟེ་སོ་སོའི་སྐྱེ་བོས་ནི་དེའི་ཚེའི་ད་ལྟར་བའི་དུས་དང་རང་འབྲེལ་པར་མི་འཛིན་པའི་ཕྱིར་རོ།",
    "བདེ་བ་ཡང་རང་སྐྱེས་པ་ཙམ་གྱིས་ནི་སྐྱེད་བྱེད་མ་ཡིན་གྱི།",
    "འོན་ཏེ་ཡང་རང་ཉིད་ཐམས་ཅད་རྟོགས་པ་མ་ཡིན་ནོ་སྙམ་ན།",
    "གང་ཡང་ལུས་ཉིད་དེའི་རྒྱུ་ཡིན་པ་ཞེས་བྱ་བ་ཕྱོགས་སྔ་མར་བཀོད་པ་དེ་ལྟ་ན་ཡང་རང་བཞིན་ཡིན་པ་ཞེས་རྗེས་སུ་བརྗོད་པ་ནི་ཉེས་པ་མཚུངས་པའི་ཕྱིར་རོ།",
    "འདུག་གོ་སྙམ་དུ་དོགས་པ་བསུ་ནས་དབྱེར་མེད་ཕྱིར་ན་ཞེས་སྨོས་སོ།",
    "གཞན་ལ་ནི་དཀར་པོ་ལ་སོགས་པ་ལོག་ཀྱང་རང་བཞིན་གཞན་སྐྱེས་པ་ན།",
    "འདོད་ཆགས་དང་བྲལ་བའི་འབད་པ་ཡང་རང་རིག་པ་ཙམ་ཡིན་གྱི་རྣམ་པར་རྟོག་པ་ནི་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "དེ་ཉིད་དང་གཞན་ཉིད་ཀྱི་ཕྱོགས་དག་ལ་ཁྱད་པར་མེད་པ་འདུག་པ་དང་ལྡན་པ་ཡང་མེད་པ་ཁོ་ནའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ན་གཅིག་དུས་ཐ་དད་པ་ཉིད་མེད་པའི་ཕྱིར་ན་མཐོང་བ་དང་མི་མཐོང་བ་ཉིད་དོ་སྙམ་དུ་དགོངས་པའོ།",
    "ཡང་དག་དོན་དང་རང་བཞིན་ཞེས་བྱ་བ་གཉིས་ཀྱང་སྤང་བར་མི་ནུས་པ་རྩོལ་བ་མེད་པའི་རྒྱུར་བརྗོད་པ་ཡིན་ནོ།",
    "དོན་དམ་པ་སོ་ན་འདུག་གོ་ཞེས་ལན་བཏབ་པ་ནི།",
    "འདོད་ཆགས་ལ་སོགས་པ་དེ་དང་ལྡན་པ་ཡང་རང་ཉིད་དེ་རང་བཞིན་གྱིས་བདག་གཞན་ཡིན་ཏེ།",
    "མི་དམིགས་པ་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་རྣམ་པ་ཉིད་ཡིན་པས་དངོས་པོའི་ཡུལ་ཅན་ལས་འདས་པ་མ་ཡིན་ནོ།",
    "དེ་ཡང་རང་རིག་པས་གྲུབ་པའི་ཕྱིར།",
    "དམིགས་པར་བྱ་བ་ཡང་རང་རང་ལ་ངེས་པ་ཡིན་པའི་ཕྱིར་ན།",
    "གལ་ཏེ་བྱ་བའམ་རྣམ་པར་རྟོག་པའི་ཕྱི་རོལ་རྟོགས་པར་བྱེད་པ་ཡང་རང་རྒྱུད་ཁོ་ན་ཡིན་ཏེ།",
    "འབྲེལ་པ་དང་མ་འབྲེལ་པ་བརྗོད་ན་ཉེས་པ་སོ་ན་འདུག་གོ་ཞེས་བརྗོད་པ་ནི།",
    "འོ་ན་ཕྱི་རོལ་ན་འདུག་པ་མཐོང་བ་ཡིན་ནོ་སྙམ་ན།",
    "ཅི་སྟེ་ཡང་རང་བཞིན་གང་ཞིག་རྣམ་པར་རྟོག་པ་ལ་སྣང་བའི་རང་བཞིན་དེ་ནི་ཐ་དད་པའམ་ཐ་མི་དད་པ་ཡིན་ཡང་སླ་སྟེ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཅི་ལྟར་ཐ་དད་ཅེ་ན།",
    "འོན་ཏེ་ཡང་ཤེས་པ་བཞིན་དུ་དེ་མེད་པར་ཡང་རང་ཉིད་ལས་འགྲུབ་པ་དེས་ན།",
    "ཐུག་པ་མེད་པ་མ་ཡིན་ན་དེ་ལྟ་ན་དོན་མེད་པ་ཡང་རང་ལས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ཤེས་པ་མེད་པ་ཡང་རང་ལས་འགྲུབ་པ་མ་ཡིན་པས་ན་ཐུག་པ་མེད་པ་ཁོ་ནའོ།",
    "ཅི་སྟེ་ཡང་མངོན་སུམ་གྱི་ཡུལ་དང་རང་བཞིན་ཡུལ་གཅིག་ཉིད་དུ་རྣམ་པར་རྟོག་པས་ཞེན་པར་བྱེད།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་དང་འབྲེལ་པའི་ཕྱིར་གོ་བར་བྱེད་པ་ཉིད་ཡིན་ནོ།",
    "སྐད་ཅིག་སོ་སོར་མི་འཇིག་ན་མཐའི་སྐད་ཅིག་ལ་ཡང་རང་བཞིན་དེ་ཉིད་ཡིན་ཏེ།",
    "ལྐོག་ཏུ་གྱུར་པ་ལ་འཇུག་ཀྱང་རང་བཞིན་དངོས་སུ་མེད་པ་ཁོ་ནའོ་སྙམ་ན།",
    "འོན་ཀྱང་འདུག་བཞིན་དུའོ།",
    "འདིར་ཡང་རང་བཞིན་དུ་འགྱུར་རོ་སྙམ་ན་སྣ་ཚོགས་པ་ནི་འདིར་ཞེས་བྱ་བའོ།",
    "གཞན་ཡང་རང་རིག་པ་ཡིན་ན་ནི་ཤེས་པ་གཞན་རིག་པ་ལ་དགོས་པ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་བདག་དེ་ཡང་རང་རིག་པའམ་གཞན་རིག་པར་འགྱུར་ཞེས་པའི་བརྒལ་ཞིང་བརྟག་པ་འདི་ཉིད་ལས་འཕར་བ་མ་ཡིན་ནོ།",
    "གཞན་ལ་ཕྱོགས་པས་ཀྱང་རང་བཞིན་གཞན་ཁོ་ན་རིག་པ་དེས་ནའོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་རྣམས་འབྲེལ་པ་སྟེ།",
    "འདིས་ནི་ཡིད་ཀྱི་མངོན་སུམ་དང་རང་རིག་པ་ཡང་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་ཡོད་པ་དང་རང་རིག་པ་ལ་སོགས་པའོ།",
    "རང་བྱུང་རང་ཉིད་ཁོ་ན་སྤྲུལ།",
    "འདོད་ཆགས་དང་འདོད་ཆགས་མེད་པ་དག་དུས་གཅིག་ཏུ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་དུས་མཚུངས་པ་ཁོ་ན་ཡིན་ཏེ།",
    "བློས་ཅི་བྱ་དེས་ན་ཉེས་པ་སོ་ན་འདུག་གོ་ཞེས་དགོངས་པའོ།",
    "དེའི་ཚེ་ངེས་པ་ཡང་རང་ཉིད་ནུས་པ་མེད་པར་ཇི་ལྟར་བྱེད།"
  ]
}