    "རྣམ་བྱང་གི་རྒྱུའི་དོན་བྱེད་ནུས་པའི་ལུང་དང་།",
    "ལུང་གི་གནོད་པ་སྤང་བ་ནི་འདི་སྨྲ་བ་ཞེས་བྱ་བ་ལ་སོགས་པའི་རྒོལ་བ་སྔོན་དུ་བཏང་པའི་སྒོ་ནས་སྟོན་ཏེ།",
    "རྒོལ་བ་འདི་ལ་ལན་བཏབ་མ་ཐག་ཡིན་པས་ཡང་སུན་དབྱུང་བར་མི་རིགས་མོ་ད་ཀྱི་ཡང་འདིར་བཀོད་པ་ནི་དོན་དམ་པར་ཇི་སྐད་བསྟན་པའི་འཐད་པས་མི་སྐྱེ་བ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "ངེས་པར་བྱེད་པའི་ཤེས་པ་མེད་ན་རང་གིས་རྟོགས་པ་མེད་པར་གཞན་ལ་སྐྱེ་བ་མེད་པར་ཅི་ལྟར་རྟོགས་པར་བྱ་བར་ནུས་ཞེས་པའོ།",
    "ཐུན་མོང་གི་དོན་བསྡུ་བ་དང་བཞིས་སྟོན་ཏེ།",
    "གལ་ཏེ་དེ་ལྟར་ཁྱོད་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་དང་།",
    "ད་ནི་ཅི་ཞིག་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་དང་།",
    "ཞེས་སྒྲུབ་བྱེད་བརྗོད་པའི་མཚོན་པར་བྱེད་པས་རང་གི་མཚན་ཉིད་དང་སྤྱིའི་མཚན་ཉིད་ཅེས་བྱེད་པ་སྒྲུབ་པ་ཡིན་ནོ།",
    "བྱེ་བྲག་གཞལ་བྱར་ཐལ་བ་དང་།",
    "ཤེས་པ་རང་གི་མཚན་ཉིད་བྱེད་པ་ཡིན་ན།",
    "བྱེ་བྲག་གཞལ་བྱར་ཐལ་བ་ནི་ཞེས་ཏེ་ས་ལ་སོགས་པས།",
    "ས་ལ་སོགས་པས་ས་ལ་སོགས་པའི་རང་གི་མཚན་ཉིད་དང་སྤྱིའི་མཚན་ཉིད་དེ་བྱེད་པའི་ཤེས་པས་རྟོགས་པར་བྱ་བའི་ལས་ཡིན་ལ།",
    "པ་ཡིན་ན་རང་གི་མཚན་ཉིད་ཡིན་ཡང་གཞལ་བྱ་མ་ཡིན་ཏེ་རང་གི་མཚན་ཉིད་ཁོ་ན་གཞལ་བྱར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ར་གི་མཚན་ཉིད་ཀྱི་བྱེ་བྲག་གཞལ་བྱར་ཐལ་བར་འགྱུར་རོ།",
    "ལོང་བ་དང་འོན་པ་མེད་པ་ཐ་སྙད་དུ་བྱེད་པ་ཉམས་མྱོང་གིས་གྲུབ་པས་སོ།",
    "ཁྱོད་ཀྱིས་ཤེས་པ་ལས་བསྒྲུབ་པར་ཁས་བླངས་པས་ཤེས་པར་བྱེད་པ་མེད་པས།",
    "རང་གི་མཚན་ཉིད་ལས་ཐ་དད་པར་མ་གྲུབ་ཅེས་པ་ནི་ཤེས་པ་ལས་སུ་སྒྲུབ་པར་ཁས་བླངས་པས་ཤེས་པ་ལ་སོགས་པ་རང་གི་མཚན་ཉིད་བདག་ཉིད་གཅིག་པས་སོ་ ཤེས་པ་ལས་སུ་བསྡུས་པས་མཚན་གཞི་ཤེས་པ་མི་འཐད་པས་དེའི་མཚན་ཉིད་རང་རིག་མེད་པའི་གོང་དུ་མཚན་ཉིད་དང་མཚན་གཞི་ཐ་དད་པ་ཡིན་ན་གཞལ་བྱ་གསུམ་པ་གྲུབ་པས་གྲངས་ངེས་ཉམས་སོ་ཞེས་པའི་ཉེས་པ་བརྗོད་པ་སྤང་བའི་ཕྱིར་བརྒལ་བ་འདི་བྱུང་བ་ཡིན་ཏེ།",
    "གཞན་རིག་པས་སེམས་ཀྱི་འཁྲི་ཤིང་ནི་ལས་དང་ཉོནམོངས་རྟོག་པ་དང་བཅས་པས་ཤེས་རབ་རྟོག་མེད་པས་མཐོང་བའོ།",
    "ད་རེས་མཚན་ཉིད་མཚན་གཞི་ལས་ཐ་དད་པས་སོ།",
    "གལ་ཏེ་དེ་གཉིས་ཐ་དད་པ་ཡིན་ན་ཚངས་པ་དེ་འབད་པ་མེད་པར་གྲོལ་བར་ཐལ།",
    "ད་རེས་མཚན་ཉིད་དང་མཚན་གཞི་གཉིས་ཀ་དངོས་པོ་མེད་པས།",
    "ད་རེས་གཉིས་ཀ་མ་གྲུབ་པས་བརྗོད་དུ་མེད་པ་མི་འཐད་དོ།",
    "ཐུན་མོང་དུ་གཙོ་བོའི་ལས་ཤིག་ལ་ཉེ་བར་སྦྱོར་བ་ནི་བྱེད་པ་པོ་ལ་སོགས་པའི་མཚན་ཉིད་ཡིན་ན།",
    "གལ་ཏེ་སེམས་བྱེད་པ་པོ་ཡིན་ན་སེམས་དང་སེམས་ལས་བྱུང་བ་གཙོ་བོར་གྱུར་བའི་འབྲས་བུ་རེ་རེ་ལ་སྦྱོར་བས་ཐུན་མོང་དུ་གྱུར་བའི་འབྲས་བུ་གཅིག་འགྲུབ་པམེད་པའི་ཕྱིར་རོ།",
    "ལུང་གི་དོན་མ་བཟུང་ཞེས་པ་ནི་བྱེད་པ་པོ་མེད་པ་ལྟར་བྱེད་པ་ལ་སོགས་པ་མ་དཔེ་མི་གསལ།",
    "ལུང་གི་དོན་གོ་བར་མ་གྱུར་བའོ།",
    "བྱེད་པ་སྒྲུབ་པ་ལ་བརྗོད་པའི་ཉེས་པ་སྤོང་བ་དགག་པ་ནི་ཅི་སྟེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པས་རྒྱལ་པོའི་སྐེས་སུ་ཞེས་བྱ་བ་ལྟ་བུ་དངོས་པོ་ཐ་དད་པ་ལ་ཐ་དད་པའི་རྟེན་ཅན་གྱི་རྣམ་པར་དབྱེ་བ་དྲུག་པར་སྦྱར་བ་བཞིན་དུ་དངོས་པོ་ཐ་མི་དད་པ་མཆི་གུའི་ལུས་སྒྲ་གཅན་གྱི་མགོ་ཞེས་བྱ་བ་ཁྱད་པར་གྱི་གཞི་ལུས་དང་མགོ་ལ་ཐ་དད་པའི་ཁྱད་པར་མཆི་གུ་དང་སྒྲ་གཅན་མེད་མོད་ཀྱི་འོན་ཀྱང་མཆི་གུའི།",
    "གང་གི་ལུས་དང་འགོ་ཡིན་པའི་ཁོང་དུ་ཆུད་པ་ལ་ཁྱད་པར་མཆི་གུའི་ལུས་དང་སྒྲ་གཅན་གྱི་མགོ་ཞེས་བརྗོད་པས་གཞན་གྱི་ལུས་དང་མགོ་ལས་ཁྱད་པར་དུ་བྱས་ནས།",
    "རིགས་པ་དང་འགལ་ཞེས་པ་ནི་མུ་སྟེགས་པས་ལྡན་པ་དང་འདུ་བའི་འབྲེལ་བ་ཁས་བླངས་བ་ལ་ཁྱོད་ཀྱི་ལྡན་པ་ཞེས་བྱ་བ་དཔེར་ན་རྭ་གཡས་གཡོན་ལྟ་བུ་གཉིས་ཀ་སོ་སོར་གྲུབ་པ་ལ་ཡོད་པ་ཡིན་པ་ལ།",
    "གཅིག་ཏུ་ཡོད་ན་མཚནཉིད་དང་མཚན་གཞི་ཡང་ཐ་དད་པ་བཞིན་དུ་འདུ་བ་ཡང་ཐ་དད་པར་ཐལ།",
    "གལ་ཏེ་ཐ་དད་པར་ཡོད་ན་འདུ་བའི་འབྲེལ་བ་ཡང་འབྲེལ་བ་གཅིག་དགོས་པས་ཐུག་པ་མེད་པར་ཐལ།",
    "བདག་ཅེས་བཏགས་པའི་ཕྱིར་ན་གང་ཟག་ཅེས་སྤྲོས་སོ་ ཁྱོད་ཀྱིས་མཚན་ཉིད་དང་མཚན་གཞི་རྫས་སུ་ཡོད་པར་འདོད་པ་ནི་དཔེར་བཏགས་པ་ཡོད་དུ་འདོད་པ།",
    "གསུམ་པ་ནི་ཞིབ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "བཞི་བ་དང་ལྔ་པ་ནི་ཁྱོད་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་དང་།",
    "མཇུག་བསྡུ་བ་ནི་གང་གི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པས་བསྟན་ཏོ།",
    "བཏགས་པར་ཡོད་པའི་བུམ་པ་མངོན་སུམ་མོ།",
    "མངོན་སུམ་གྱིས་འཇིག་རྟེན་གྱི་ཐ་སྙད་མ་བསྡུས་པར་ཐལ་ལོ་ཞེས་བྱ་བའོ།",
    "བཏགས་པར་ཁས་བླངས་ཀྱང་ཧ་ཅང་ཐལ་བའོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་སྒྲ་བརྗོད་པ་མེད་པ་དང་།",
    "ཡུལ་དང་དོན་ཞེས་པ་ནི་མིང་གི་རྣམ་གྲངས་སོ།",
    "ལུང་གིས་མཚན་ཉིད་བསྒྲུབ་པར་མི་ནུས་པའོ།",
    "ལུང་གིས་སྒྲུབ་པར་བྱེད་མི་ནུས་པ་ནི་མིག་གི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་མེད་པའི་བྱེད་པའོ།",
