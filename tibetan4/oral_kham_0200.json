    "འདུག་གནས་དེ་མུ་སྟེགས་ཅན་གྱི་ཡིན་པ་ལ་ན་སྨད་པ་མེད་དོ།",
    "འདུག་གནས་དེའི་བདག་པོ་མེད་པ་དང་།",
    "ཉི་མ་གཉིས་པ་ལ་གཞན་ནས་བསོད་སྙོམས་བླངས་ནས་འདུག་གནས་དེར་ཟོས་པ་ལ་ཉེས་བྱས་སོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།་",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་གཞན་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "དེ་རང་ཉིད་སོ་ནམ་བྱེད་ཅིང་འདུག་གོ།",
    "དགེ་སློང་ཟས་ཟོས་ཟིན་ཅིང་སྤངས་ལ་སྤྱོད་ལམ་ལས་མ་༤ཉམས་པ་གང་ཡིན་པ་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ།",
    "ཟས་སྤངས་པ་ཉིད་ཅེས་བྱ་བ་ནི་དགེ་སློང་ཟས་བརྩམས་པས་འདུག་པའི་གནས་བཏང་བ་སྟེ།",
    "དགེ་སློང་ཟས་བརྩམས་པའི་གནས་སུ་འདུག་སྟེ།",
    "ཆོག་གོ་ཞེས་བྱ་བ་དག་ལས་གང་ཡང་རུང་བས་བྱིན་ལེན་སྟོབས་པ་དེ་སྤངས་པ་བྱས་ནས་ཟས་བརྩམས་པའི་ཕྱོགས་གང་དུ་སྔར་འདུག་པར་གྱུར་པའི་གནས་བཏང་སྟེ།",
    "འདི་ལ་རྒྱུ་ལྔས་ནི་ཟས་བརྩམས་པས་འདུག་པའི་གནས་མེེགཏོང་བར་མི་འགྱུར་ཏེ།",
    "སྤྱོད་ལམ་ལས་མ་ཉམས་པ་གང་ཡིན་པའམ་དགེ་སློང་ཟས་ཟོས་ཟིན་ཅིང་སྤངས་ལ་སྤྱོད་ལམ་ལས་མ་ཉམས་པ་གང་ཡིན་པ་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "ཟས་བརྩམས་པའི་གནས་སུ་འདུག་སྟེ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་༤དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད་དགའ་བར་བྱེད་དགའ་མགུར་སྤྱོད་པར་བྱེད་༥དོ།",
    "པའི་དགེ་སློང་ཅིག་ཅར་དུ་ཟ་བས་མཚམས་ཀྱི་ནང་དུ་དབེ་འདུན་གཞིའི་༢ འདུག་གནས་སུ་ཟ་བ་ལས་ལོགས་ཤིག་ཏུ་འདུག་སྟེ་དུས་སྟོ།",
    "གཞིའི་འདུག་གནས་སུ།་",
    "དགྲེ་འདུན་གཞིའི་༡འདུག་གནས་སུ་ཟ་བ་ལས་ལོགས་ཤིག་ཏུ་འདུག་སྟེ་ཟ་བ་ལ་ན་སྨད་པ་གྲེད་དོ།",
    "ཟས་གང་ཡང་རུང་བ་ཆུང་ཟད་ཀྱིས་གཞིའི་༡་འདུག་གནས་སུ་ཟ་བའམ་འདུས་ཤིང་ཟ་བ་གང་ཡང་རུང་བ་ཅིག་ལ་༡་མ་བསྲུལ་བར་འདུས་ཤིང་ཟ་བ་ལ་ན་སྨད་པ་མེད་དོ།",
    "ཟས་གང་ཡང་རུང་བ་ཆུང་ཟད་ཀྱིས་གཞིའི་འདུག་གནས་སུ་ཟ་བའམ་འདུས་ཤིང་ཟ་བ་གང་ཡང་རུང་བ་ཞིག་ལ་མ་བསྲུལ་བ་དང་།",
    "དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་དུས་མ་ཡིན་པར་བཅའ་བ་དང་ཟ་བར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "བཙོས་པའི་སྣོད་རུང་བ་མ་ཡིན་པའི་ཕྱོགས་ན་འདུག་ན་དེས་ཀྱང་བཙོ་བར་བྱ་བའི་རྫས་དེ་རུང་བ་ཕྱ་ཡིན་པའི་ས་དེར་བཙོས་པ་ཉིད་ཡིན་པས་ནང་དུ་བཙོས་པ་ཉིད་ཡིན་ནོ།",
    "འཚོད་པར་བྱེད་པའི་མེ་མཚམས་ཀྱི་ནང་རོལ་ན་འདུག་པ་ཉིད་ཀྱིས་བཙོ་བར་བྱ་བའི་རྫས་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་འཚེད་པར་བྱེད་པ་ནི་ནང་དུ་བཙོས་པ་ཉིད་མ་ཡིན་པས་དེ་ལ་ཉེས་པ་མེད་དོ།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེས།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་དང་།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་དང་།",
    "མཐའ་གཅིག་ཏུ་འདུག་གོ།",
    "དེང་ལ་ལྷག་རོལ་ཆུང་ཟད་ཅིག་གདའ་བ་དེ་བྱིན་ཅིག།",
    "སྲོག་ཆགས་བཅས་དང་ཉལ་སར་འདུག།",
    "ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱེམ་ན་འདུག་པ་དང་།",
    "བཞིན་བཟངས་མིག་ལམ་ན་མ་འདུག་ཤིག་མཅེས་བཇོད་པར་བྱའོ།",
    "དགེ་སློང་དོན་ཉུང་ངུ་དག་བྱུའི་ཕྱིར་དགེ་སློང་དག་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱེམ་དུ་ཕྱིས་གནོན་ཉུ་བྱས་ཏེ་སྟན་ལ་འདུག་པར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "ཡང་དགེ་སློང་གང་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱེམ་དུ་ཕྱིས་གནོན་བྱས་ཏེ་སྟན་ལ་འདུག་ན་ཐོང་བྱེད་དོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱེམ་དུ་ཕྱིས་གནོན་བྱས་ཏེ་སྟན་ལ་འདུག་པའོ།",
    "ཕྱོགས་པར་ཤེས་བཞིན་དུ་མངོན་སུམ་དུ་བརྣག་པས་འདུག་ན་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱེམ་ན་འདུག་པའི་བེེང་བྱེད་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "མངོན་སུམ་དུ་བརྣག་པས་འདུག་པ་ལ་ན་སྨད་པ་མེད་དེ་ཕྱེ།",
    "མངོན་སུམ་དུ་བརྣག་པས་འདུག་པའོ།",
    "དགེ་སློང་དེར་མངོན་སུམ་དུ་བརྣག་པས་འདུག་པའི་ལྟ་བ་དང་ཉན་པ་སྤྲོད་པར་བྱེད་པ་གཉིས་ཀྱི་གནས་ལས་གཞན་པའི་གནས་ལ་སེམས་གཏོད་པ་ལ་ཉེས་བྱས་སོ།",
    "དབེན་པར་བརྣག་པས་འདུག་པ་ལ་ཉེས་བྱས་སོ།",
    "དེ་ན་དགེ་སློང་འདུག་པ་ཡིན་ན་ཡང་།",
    "བྱེ་བྲག་ཏུ་ན་སྔ་མ་ནི་མངོན་སུམ་དུ་བརྣག་པས་འདུག་པའི་ཡུལ་ལ་རྣམ་པར་གཞག་གོ།",
    "ཤེས་པ་ཅན་དགེ་སློང་དག་ཟན་ཟ་བའི་མིག་ལམ་དུ་འདུག་ཅིག་དང་།",
    "དེ་དེར་འདུག་པ་དང་དགེ་སློང་རྣམས་ཀྱིས་དེ་ལ་ལྷུང་བཟེད་ཀྱི་ལྷག་མ་བྱིན་ནས་དེའི་སློང་ཕོར་ཁུར་བས་བྱུར་བུར་བྱས་སོ།",
    "རི་བྲགས་པ་དེ་དེ་ལྟ་ན་ཡང་མི་ཕེབས་ནས་རྒྱལ་པོས་དེ་ཉིད་དུ་ཕྲུ་མ་བཏབ་སྟེ་འདུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཡོངས་སུ་མྱ་ངན་ལས་པེའདས་ཤིང་བདག་ཅག་དུས་ལ་བབ་ན་བསྟན་པ་ནུབ་པར་བརྗོད་པར་བྱ་སྟེ།",
