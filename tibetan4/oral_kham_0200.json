    "དགེ་སློང་རང་བཞིན་དུ་གནས་པས་ཀྱང་དེ་ལ་དེ་དག་མི་བྱའོ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་གོམ་པ་བསྲི་བ་ཉིད་ལས་གཞན་ལས་བཅག་པར་མི་བྱའོ།",
    "སྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་པས་འདུག་པར་མི་བྱའོ།་།",
    "དེའི་འདུག་པ་ལ་སོགས་པ་ནི་བསྙེན་པར་རྫོགས་པ་ཐམས་ཅད་ཀྱི་མཐའ་ཉིད་དུའོ།",
    "བསླབ་པ་བྱིན་པས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་མ་ཡིན་པ་དང་།",
    "གྲོང་ན་འདུག་པའམ་ཞེས་བྱ་བ་ནི་ར་བའི་ནང་ན་འདུག་པའོ།",
    "ལུས་དང་དེ་དང་འབྱེལ་པ་དང་འཕངས་པ་དང་གཞན་དང་རང་ལ་བསྒོ་བ་ལ་༤ན་སྨད་པ་མེད་དོ།",
    "དོང་དང་ཤིང་དང་རང་བཞིན་ཉམས་པ་གཏོང་བ་དང་།",
    "རྒྱལ་བྱེད་ཀྱི་ཚལ་གྱི་སྒོ་ན་འཆག་ཅིང་འདུག་གོ།",
    "དགེ་སློང་རང་བཞིན་གྱིས་གནས་ངན་ལེན་བརྗོད་པས་གནས་ངན་ལེན་སྨྲས་ན་ཉེས་པ་སྦོམ་པོའོ།",
    "ཐ་མལ་པར་གནས་པ་ལས་ཕྲིན་བླངས་ཏེ་ཐ་མལ་པར་གནས་པ་ལ་ཕྲིན་ཕར་བསྐྱལ་ཞིང་རང་བཞིན་ཉམས་པ་ལ་ཕྲིན་ཕྱིར་བསྐྱལ་བ་ལ་སོགས་པ་ཡང་ཉེས་པ་སྦོམ་པོའོ།",
    "འདུག་པ་དང་ཉལ་བ་དག་ཤོང་པའོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "གཞི་རྩོད་པ་དང་བཅས་པ་ནི་རྒྱལ་པོ་དང་ལྷའི་གནས་དང་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སྤུ་ལ་བརྟེན་པ་ཉིད་དང་།",
    "ཡང་རང་བཞིན་གཞན་སྤྱོགྱིས་རྗེས་སུ་བསྒྲུབ་པ་ལ་ཉེས་བྱས་སོ།",
    "དགེ་སློང་རང་དག་རྟོག་ཏུ་འདོང་བར་བྱའོ་༧།",
    "འདུན་པ་དོན་ཡོད་པས་འདུག་པ་དང་།",
    "ས་ཕྱོགས་དེ་ཡང་ཅི་ནས་ཀྱང་གནས་ཀྱི་ཤིང་ལྗོན་པ་དེའི་ཕྱོགས་གང་ན་འདུག་འདུག་པར་གྱུར་ཅེས་བྱ་བ་སུས་ཀྱང་མི་ཤེས་པ་དེ་ལྟར་མཉམ་པར་བྱས་སོ།",
    "ཕྱོགས་འདི་ན་ནི་བདག་སྤྱོང་སྤྱོང་ན་དེ་ཅི་ནོངས་ཇི་ལྟར་གྱུར་པ་མ་འཚལ་ཏོ་ཞེས་ཟེར་རོདེ་དག་དེ་ལྟར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་ན་མི་ཞིག་འོངས་ནས་དེས་སྨྲས་པ།",
    "འགྲེང་བ་དང་འདུག་པ་དང་ཉལ་བ་དག་ཤོང་བའོ།",
    "འདི་ལྟར་བྱ་སྟེ་འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "གྱད་རྣམས་ལ་ཅོད་པན་མེད་པའི་རྒྱལ་སྲིད་བྱེད་དུ་འཇུག་པ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད་དགའ་བར་རྔུ་བྱེད་དགའ་མགུར་སྤྱོད་པར་བྱེད་པ་ན།",
    "ཆུ་བཙགས་ནས་ལོ་མ་ལྷགས་པ་དག་བླངས་ཏེ་འདུག་ནས་ཟས་ཀྱི་བྱ་བ་བྱས་ཏེ།",
    "ཚེ་དང་ལྡན་པ་གྱད་བུ་ནོར་རྒྱལ་པོའི་ཁབ་ན་བྱ་རྒོད་ཕུང་པོའི་རི་ལ་འདུག་སྟེ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཐའ་གཅིག་ཧཱུཾ་ཏུ་འདུག་ནས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "བཅོམ་ལྡན་འདས་ལ་བསེལ་ཡབ་ཀྱིས་སྤུ་གཡོབ་ཅིང་འདུག་གོ།",
    "དེས་ན་བདག་ཅག་ཤི་ཞིང་དུས་ལ་བབ་པ་དག་ན་དགེ་སྤྱོང་གོ་ཏ་མ་དེ་ཙམ་དུ་རྫུ་འཕྲུལ་ཆེ་བ་དེ་ཙམ་དུ་མཐུ་ཆེ་བ་འདུག་བཞིན་དུ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཤཱ་ཉན་ཐོས་མཐུ་ཆེ་བ་རྫུ་འཕྲུལ་ཆེ་བ་ལྷའི་མིག་དང་ལྡན་པ་གཞན་ཀྱི་སེམས་ཤེས་པ་གང་དག་ཡོད་པ་དེ་དག་ནི་ཐག་རིང་པོ་ཡང་མཐོང་ལ་དྲུང་ན་འདུག་པས་ཀྱང་མཐོང་ཞིང་།",
    "དབྱེན་བྱེད་པར་འགྱུར་བའི་རྩོད་པ་ཡང་དག་པར་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་མ་འདུག་ཤིགཧཱུཾ།",
    "འདུག་ཕྱེལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དབྱེན་བྱེད་པར་འགྱུར་བའི་རྩོད་པ་རྔུཡང་དག་པར་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་མ་འདུག་ཤིག།",
    "དབྱེན་བྱེད་པར་འགྱུར་བའི་རྩོད་པ་ཡང་དག་པར་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་མ་འདུག་ཤིག་།",
    "འདུག་པ་དེའི་གྲོགས་བྱེད་ཅིང་མི་མཐུན་པར་༥སྨྲ་བའི་རྗེས་སུ་ཕྱོགས་པར་མ་བྱེད་ཅིག།",
    "འདི་ལྟར་བྱ་སྟེ་འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདུག་པ་དེའི་གྲོགས་བྱེད་ཅིང་མི་མཐུན་པར་སྨྲ་བའི་རྗེས་སུ་ཕྱོགས་པར་མ་བྱེད་ཅིག།",
    "དབྱེན་བྱེད་པར་འགྱུར་བའི་རྩོད་པ་ཡང་དག་པར་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་འདུག་པ་དེའི་གྲོགས་བྱེད་ཅིང་མི་མཐུན་པར་སྨྲ་བ་དེའི་གྲོགས་རྗེས་སུ་ཕྱོགས་པར་མ་བྱེད་ཅིག།",
    "ལོགས་ཤིག་ན་འདུག་ཅེས་སྨྲས་པ་ཡིན་ནོ།",
    "རྒྱ་མཚོས་བྱིན་བཞི་པོ་ལོགས་ཤིག་ཏུ་འདུག་གོ།",
    "དབྱེན་བྱེད་པར་འགྱུར་བའི་རྩོད་པ་ཡང་དག་པར་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་མ་འདུག་ཤིག།",
    "དབྱེན་བྱེད་པར་འགྱུར་བའི་རྩོད་པ་ཡང་དག་པར་རབ་ཏུ་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་འདུག་ན་ཞེས་བྱ་བ་ནི་ཀོ་ཀ་ལི་ཀ་དང་།",
    "རྒྱ་མཚོས་བྱེན་ཡང་དག་པར་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་འདུག་ནའོ།",
    "རབ་ཏུ་བཟུང་སྟེ་འདུག་ན་ཞེས་བྱ་བ་ནི་དམ་དུ་བཟུང་སྟེ་འདུག་པའོ།",
    "དབྱེན་བྱེད་པར་འགྱུར་བའི་རྩོད་པ་ཡང་དག་པར་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་མ་འདུག་ཤིག་ཞུཅེས་བྱ་བ་ནི་དེ་ལ་དམིགས་ནས་དམ་དུ་ཟུབཟུང་སྟེ་མ་འདུག་ཤིག་ཅེས་པའོ།",
    "སྟན་གཅིག་ལ་འདུག་པར་བྱེད།",
    "མཐའ་གཅིག་ཏུ་འདུག་གོ།",
    "ལམ་གྱི་བར་དུ་འདུག་ལ་དགེ་སློང་གླེང་བ་པོ་འདུན་པས་མི་འགྲོ་བ་དང་།",
    "འདི་ལྟར་བྱ་སྟེ་འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "ལམ་གྱི་བར་དུ་འདུག་ནས་དགེ་སློང་གླེང་བ་པོ་བསྐོས་སོ།",
    "ལམ་གྱི་བར་དུ་འདུག་ནས་དགེ་སློང་གླེང་བ་པོ་བསྐོས་སོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "གསོ་སྦྱོང་གཞག་པར་ཞེས་བྱ་བ་ནི་གང་ཟག་འདི་འདུག་པ་དང་ལྷན་ཅིག་དགེ་སློང་རྣམས་ཀྱིས་གསོ་སྦྱོང་མི་བྱའོ་ཞེས་བྱ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདི་ལྟར་བྱ་སྟེ་འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དགག་དབྱེ་གཞག་པ་ཞེས་བྱ་བ་ནི་གང་ཟག་འདི་འདུག་པ་དང་ལྷན་ཅིག་དགེ་སློང་རྣམས་ཀྱིས་བྱེདགག་དབྱེ་མི་བྱའོ་ཞེས་བྱ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ཡོངས་སུ་དག་པའི་ས་ནས་ཡོངས་སུ་མ་དག་པའི་ས་གཞན་དུ་སྤོ་བའོ།",
    "ཁྱིམ་པ་དེ་བཞིན་གཤེགས་པའི་ལྟ་བ་ཅན་མཚམས་ཀྱི་ནང་ན་འདུག་པ་དང་།",
    "ལྟ་བ་མི་མཐུན་པ་མཚམས་གཞན་ན་འདུག་པ་དག་གོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པས་ཀྱང་དེ་ལ་དེ་དག་མ་བྱའོ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་གོམ་པ་བསྲི་བ་ཉིད་ལས་གཞན་པས་བཅག་རྗོཔར་མི་བྱའོ།",
    "སྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་པས་འདུག་པར་མི་བྱའོ།",
