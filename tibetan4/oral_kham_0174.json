    "སྟོང་དང་ལྷོད་པའི་རྩ་འདུག་གྲང་བ་ཡིན།",
    "རྩ་མ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "རྩེ་འཕྲེད་ཟུག་པ་ལྟར་འདུག་ན།",
    "གཞན་ཡང་མ་ངེས་ཇི་ལྟར་འདུག་གྱུར་ཀྱང་།",
    "རྩ་ནི་དེ་ལྟར་འདུག་པ་རྣམས།",
    "མིག་འགྱུར་ཧར་ཧར་འདུག་པ་དང་།",
    "འགྲོ་འདུག་མི་བརྟན་གྱུར་ཚེ་སྲིབས་ཞན་གྱི།",
    "ལྕེ་ཡི་དབྱིབས་དང་འགུལ་འདུག་དེ་ཡི་སྟེང་།",
    "ལྕེ་དབྱིབས་འགུལ་འདུག་འགྱུར་ལྡོག་བྱུང་བའི་དུས།",
    "ཡོན་ནར་འཁྱིལ་བ་འགུལ་འདུག་ངེས་མེད་དྲུག།",
    "དྲོད་ལྡན་ལྕེ་སྲ་གཏམ་བརྗོད་དཀའ་ཁག་དུས།",
    "དྲི་མ་གཏོང་དཀའ་ཞིག་ཏུ་འདུག་པ་ན།",
    "ཞིག་ཏུ་འདུག་པ་ན།",
    "དྲག་དུས་རིག་པ་དུབ་ལ་སྐད་མཐོ་བ།",
    "ལྕེ་དྲེག་བརྟག་དུས་མཉམ་འཇོག་བྱེད་ས་ནི།",
    "སྐེ་ལ་བརྟག་དུས་མཐོང་བའི་སྐྲང་བོ་དེ།",
    "༦ དམུ་ཆུ་ལྕེ་མཆུ་རྙིལ་དཀར་འགྲོ་འདུག་དཀའ།",
    "གཅིན་གྱི་དྲི་མ་མི་འདུག་ཙམ་དུ་བཤད།",
    "སྐ་བ་ཞེས་བྱ་གར་བ་ཞིག་འདུག་དང་།",
    "དུགས་རྔམ་ཆེ་བ་འདུག་ན་འགྲམས་རིམས་སམ།",
    "ནམ་ཟླའི་རྐྱེན་གྱིས་ལྡོག་དུས་འགྱུར་བ་ནི།",
    "ཁ་དོག་དཀར་སྔོ་གྲང་བ་ལྟར་འདུག་ཀྱང་།",
    "ཁ་དོག་དམར་སེར་ཚ་ཆུ་ལྟར་འདུག་ཀྱང་།",
    "ཆུ་ཡི་ཁ་དོག་ཇི་ལྟར་འདུག་གྱུར་ཀྱང་།",
    "ཁ་དོག་ཇི་འདྲ་ཞིག་ནི་འདུག་གྱུར་ཀྱང་།",
    "ཆུ་མ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "༡ ལྡོག་དུས་མཉམ་འཇོག་བྱེད་དགོས་ཆུ་གཅིག་ནི།",
    "ཁམ་པར་འདུག་ན་ཤ་སོགས་མ་ཞུའི་རྟགས།",
    "རྡོ་རྗེ་སེམས་དཔའི་གནས་འདུག་ནས།",
    "མེ་ཏོག་ཐོགས་ཏེ་སྒོ་ཕྱོགས་འདུག།",
    "ཐ་༡མལ་ཐ་མལ་དངོས་པོའི་འདུག་ཚུལ་ནི།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནས་བསྟན་པ་རྫོགས་སོ།",
    "བདག་ཉིད་བེ་རོ་ཙ་ན་མཆིས་པ་འདི།",
    "དེ་ལྟར་ཡེ་ནས་ཡིན་པའི་དོན་ཇི་བཞིན་པར་རྟོགས་ཙ་ན།",
    "ཉིད་ནི་གང་ཟག་སོ་སོ་རང་རང་གང་ལ་སྟོན་པ་དེ་ཉིད་དོ།",
    "སེམས་ཉིད་དེ་ཡང་འདུས་མ་བྱས་པ་མི་འཛད་པའི་ཀློང་དུ་འདུག་པས།",
    "དེ་ཙ་ན་མཚན་ཉིད་གསུམ་གཅིག་ཏུ་འདྲེས་པས་འདི་བཞག་ཕྱིས་མི་ལེན་གྱི་དགོངས་པ་རང་རིག་དང་པོའི་སར་ཚུད་པ་ཞེས་བྱ་བ་སྟེ།",
    "སེམས་ཉིད་དངོས་པོའི་གནས་ལུགས་ཡེ་ནས་ཡིན་པའི་དོན་དེ་ཤེས་ཙ་ན།",
    "ངེད་རང་སོ་ནམ་བྱེད་དགོས་པར་འདུག།",
    "བརྒྱུད་པ་ནི་རྡོ་རྗེ་སེམས་དཔའ་ནས་བེེ་རོ་ཙ་ན་ཡན་ཆད་དུ་གཅིག་ནས་གཅིག་ཏུ་ཕྲེང་མ་ཆད་པར་བརྒྱུད་པའོ།",
    "ང་དོ་ནུབ་འོང་ངོ་བྱ་བའི་བརྡར་འདུག་སྟེ།",
    "འདི་རིགས་བྱེད་ལྷའི་སྤྲུལ་པ་གཅིག་། འདུག་ལ།",
    "དེ་ནས་དགའ་རབ་རྡོ་རྗེས་ལོ་བརྒྱད་ལོན་ཙ་ན་ཡུམ་འདི་རུ་བདེ་བར་བཞུགས་ཤིག།",
    "ནམ་མཁའི་དག་པའི་དཀྱིལ་ན་འཇའ་གསལ་བ་གཅིག་ཤར་ནས་འདུག་པ་དེ་ལ་དགའ་རབ་རྡོ་རྗེ་བལྟས་པས།",
    "དེའི་གོང་དུ་གྲོལ་བའི་ཐབས་མི་འདུག་པས།",
    "དེའི་གོང་དུ་གྲོལ་བའི་ཐབས་མི་འདུག་པས།",
    "དེ་ལྟ་བུ་ཞིག་མེད་ན་དེ་རིང་སང་དུས་བཏབ་པའི་མི་ཡང་སྟབས་ཀ་འཛོལ་ནས་མི་འཕྲད་པར་འདུག་པ་ལ།",
    "འོ་སྐོལ་ལ་གདམས་ངག་མི་གནང་བར་འདུག་པས།",
    "ང་རང་འདིར་ལྕེབས་ནས་ཤི་ལ་བསྡད་དགོས།",
    "གཞུ་དང་སྤྲད་དུ་འདུག་པ་དེ་ཡང་ཐབས་དང་ཤེས་རབ་ཡ་མ་བྲལ་བར་ཟུང་དུ་འཇུག་པར་གོ།",
    "དེ་ཡང་ནམ་ཐོ་རངས་གཅིག་ཙ་ན།",
    "དེའི་གོང་དུ་གྲོལ་བའི་ཐབས་མི་འདུག་པ།",
    "ཁོང་རང་ངེད་ཀྱི་ཞལ་མཇལ་བ་དང་ངོ་ཤེས་པ་མེད་ཟེར་རོ།",
    "ཅམ་མེར་ཕྱིན་པས་ཆུ་ཁ་གཅིག་ཏུ་བརྟོལ་ཙ་ན།",
    "འདི་ཁྱིམ་བཙུན་ནམ་ཁྲམ་བཙུན་ནམ་ཟོག་བཙུན་གཅིག་ཡིན་ཚོད་འདུག་སྟེ།",
    "ད་རུང་དུ་རྫི་རྟོག་དགོས་པར་འདུག་སེམས་ནས།",
    "ཚིག་ལའང་རྨོངས་པ་གསུངས་ཏེ་ཚིག་དེ་རྣམས་ཀྱང་མཁས་པར་འདུག་སྟེ།",
    "དོན་མ་གོ་བར་འདུག་པས་བྱ་བར་གོ་བྱུང་བས།",
    "དེར་ཐེ་ཚོམ་མ་ཟོས་ཏེ་བཙུན་པ་འདི་སློབ་དཔོན་འཇམ་དཔལ་བཤེས་གཉེན་ཡིན་ངེས་འདུག།",
    "ཐང་ཆད་ནས་སློབ་དཔོན་གྱི་མདུན་ན་ཀྲོང་ངེར་ལངས་ནས་ཡོད་ཙ་ན།",
    "སློབ་དཔོན་གྱི་དབུ་སྔས་ན་ཤིང་ཐོག་རྡོག་པོ་ཆེ་བ་ཁ་དོག་ལེགས་པ་དྲི་ཞིམ་པ་གཅིག་འདུག་ནས་ད་ཅིང་ལ་འབོད་པ་དེ་འདི་ཟོ་དང་བྱ་བ་རང་ཡིན་ནམ་སེམས་ནས་ཤིང་ཐོག་དེ་ཟོས་པས་རོ་མཆོག་བརྒྱད་དང་ལྡན་པ་ཞིག་བྱུང་སྟེ།",
    "དེ་ཟོས་ཟིན་པ་དང་དུག་ཏུ་གྱུར་ཏེ་སྐྱུག་ཅིང་འགྱེལ་ནས་ཤི་འཕྲས་བྱེད་ཅིང་འཆི་བ་ལ་ཐུག་ནས་ཡོད་ཙ་ན།",
    "དེ་ནས་སློབ་དཔོན་གྱི་དབུ་སྔས་ན་ཤིང་ཐོག་ཁ་དོག་ལེགས་པ་དྲི་ཞིམ་པ་གཅིག་འདུག་ནས་འདི་ཟོ་བྱ་བ་ཡིན་འདུག་སེམས་འདུག་སེམས་ནས།",
    "སྐྱུག་པའི་འཕྲོ་ཡང་ཆད་ནས་སློབ་དཔོན་གྱི་མདུན་དུ་ཀྲོང་དེར་བསྡད་ཙ་ན།",
    "དང་པོ་རྒྱུ་འདི་ལས་བྱུང་བྱ་བ་མི་འདུག།",
    "སློབ་དཔོན་ཤྲཱི་སིང་ཧ་བཞུགས་པའི་དུས་ཙ་ན།",
    "ང་རང་འགྲོ་བའི་དོན་ཕྱིན་པ་ཡིན་ཟེར་རོ།",
    "ང་རང་འགྲོ་བའི་དོན་ལ་ཕྱིན་པ་ཡིན་ཟེར་ཙ་ན་རིའུ་ལུག་བཙས་ནས་བྱུང་སྐད།",
    "ལན་གཅིག་འགྲོ་བ་འོང་ཙ་ན་གཏོང་བ་ཡིན་ཅིང་།",
    "གཞན་གྱིས་འོང་བར་མི་འདུག་པས་བུ་འདི་ང་ལ་མི་སྦྱིན་པའི་ཐབས་མེད་ཅེས་གསུངས་པས།",
    "ཕ་མ་གཉིས་དར་གཅིག་རོག་པ་རྩར་བཞུགས་སུ་བཅུག་བེ་རོ་ཙ་ན་བྲག་དམར་བསམ་ཡས་སུ་བཞུགས་སུ་བཅུག་ནས་ལོ་བརྒྱད་ཀྱི་བར་དུ་ཟས་དཀར་གསུམ་དང་མངར་གསུམ་གསོལ་བ་ཡིན།",
    "དེ་ནས་ལོ་བརྒྱད་གཉིས་བཅུ་དྲུག་ལོན་ཙ་ན་རྒྱ་གར་དུ་འགྲོ་བ་ལ།",
    "གསེར་མི་རྙེད་པར་བྱ་བའི་ཐབས་ལ་བེ་རོ་ཙ་ནའི་དབུ་སྐྲ་བཞར་ནས་གསེར་གྱི་པ་ཏྲ་བདུན་ཐོད་པའི་དབྱིབས་སུ་བརྡུངས་ནས་བུ་ག་གསེར་དུ་ཚོར་ཙམ་པ་མང་པོ་ཕུག་ནས་དབུ་ལ་བཀབ་སྟེ་དབུ་སྐྲ་ཕྱིར་ནག་ཐིབས་ཀྱིས་ཕྱུངས་ནས།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནས་སྲོད་ལ་རྨི་ལམ་རྨིས་པ།",
    "དེ་ནས་ཡང་བེ་རོ་ཙ་ན་གུང་ལ་ལོག་པའི་རྨི་ལམ་རྨིས་པ།",
    "ཡང་བེ་རོ་ཙ་ནས་ཐོ་རངས་གཟིམས་པའི་རྨི་ལམ་བྱུང་བ་དྲིས་པས།",
    "བེེ་རོ་ཙ་ན་བོད་དུ་བྱོན་ནས་ཀྱང་།",
    "རྨི་ལམ་ཕྱེད་བཟང་ཕྱེད་མི་བཟང་དུ་གདའ།",
    "དེ་ནས་རྒྱ་གར་གྱི་ཚུར་འཕྲང་ཤིང་འཕྲང་བྱ་བར་བརྟོལ་ཙ་ན།",
    "ཁོང་གཉིས་བསད་ལ་གསེར་ཕྱེ་ཕྲོག་པར་བྱས་ཙ་ན།",
    "བེེ་རོ་ཙ་ནས་ཆོ་འཕྲུལ་བསྟན་པ།",
    "འདི་བསད་དུ་མི་བཏུབ་པ་གཅིག་འདུག་པས་འདི་ཞོག་ལ་ཟླ་བོ་འདི་བསད་དོ་བྱས་པས།",
    "བེ་རོ་ཙ་ནས་སྒྲ་དེ་བོད་སྐད་དུ་འདི་ལྟར་གོ་སྟེ།",
    "ཆུ་ལེན་པ་དེས་སྲོད་ཙ་ན་མཇལ་བའི་དུས་བཏབ་ནས་དུས་ཚོད་དེར་མཇལ་ཙ་ན།",
    "དུས་དེ་ཙ་ན་པཎྜི་ཏ་ཕྱི་མ་བདུན་པོ་ཚང་བར་བཞུགས་པས།",
    "བེ་རོ་ཙ་ན་ད་རུང་མ་ཚིམ་ཟེར་བར།",
    "སློབ་དཔོན་ཤྲཱི་སིང་ཧ་དང་བེ་རོ་ཙ་ནས་སྐྱེལ་ཆུང་མཛད་ནས་ལོག་ཙ་ན།",
    "སློབ་དཔོན་ཤྲཱི་སིང་ཧའི་ཐུགས་ཀྱིས་མཁྱེན་ནས་བེ་རོ་ཙ་ན།",
    "སྔོན་པོ་ལེགས་གྲུབ་གཅན་འཕྲང་དང་པོ་བས་བཀྲོངས་པ་གསུངས་པས་གྲོགས་པོ་བཀྲོངས་པ་སེམས་ནས་བེ་རོ་ཙ་ན་སྤྱན་ཆབ་ཤོར་ཏེ།",
    "བསམ་པའི་ཤེས་རབ་སྒྲ་དོན་ཕྱེད་མར་འདུག།",
    "ཕྱག་གཡས་པ་བེ་རོ་ཙ་ནའི་སྤྱི་བོར་བརྐྱང་ནས།",
    "སྔོན་པོ་ལེགས་གྲུབ་གཅན་འཕྲང་བས་བཀྲོངས་པས་བེ་ཙ་ན་ཡང་བཀྲོངས་ཀྱི་དོགས་ནས།",
    "དེ་ནས་བོད་དུ་བྱོན་པར་དགོངས་ཙ་ན།",
    "དེ་ནས་བེ་རོ་ཙ་ནས་ལན་བཏབ་པ།",
    "དེ་ནས་བེ་རོ་ཙ་ན་བོད་དུ་འབྱོན་པར་དགོངས་པ་ལ།",
    "སློབ་དཔོན་ཤྲཱི་སིང་ཧ་དྲིན་ཆེ་བས་འབྲལ་ཀྱང་མ་ཕོད་ཙ་ན།",
    "དེ་ནས་བེ་རོ་ཙ་ནས་བལ་ཡུལ་དུ་ང་ཤ་ཀ་ར་བྱ་བའི་ཡུལ་དུ་སླེབ་ནས་པཎྜི་ཏ་པྲ་སིདྡྷི་བྱ་བ་གཅིག་རྟོགས་ཚད་འདྲིར་བྱུང་བ་ནི།",
    "བོད་ཀྱི་བན་ཆུང་རང་སེམས་ཇི་ལྟར་བྱས་ན་རྟོགས།",
    "བེ་རོ་ཙ་ན་དང་བཞིའོ།",
    "དེར་རྐང་མགྱོགས་ཀྱིས་གཅན་འཕྲང་དང་པོར་བརྟོལ་ཙ་ན་ད་མི་སླེབ།",
    "དེ་མ་སྤྲུགས་མ་བསད་ན་བོད་ཕུང་སྟེ་འོད་ཟེར་གྱི་འདུག་བྱ་བར་བྱུང་སྟེ།",
    "ད་བེ་རོ་ཙ་ན་གསོད་དགོས་སྤྲུགས་དགོས་ཟེར་བས།",
    "དུས་ནམ་ཞིག་ན་སྤྲང་པོ་ལྡོམ་བུ་པ་གཅིག་བཟུང་ནས་སློབ་དཔོན་བེ་རོ་ཙ་ནའི་ན་བཟའ་རྣམས་དེ་ལ་བསྐོན་ནས་འཕྲལ་ལ་དགོས་པའི་བཟའ་བཏུང་རྣམས་ཀྱང་དེར་བཅུག་ནས་བསམ་ཡས་ཀ་ཆུ་ནས།",
    "ངས་བེ་རོ་ཙ་ན་ཆུ་ལ་བསྐྱུར་བ་འདི་ཡིན་ནོ་གསུངས་ནས།",
    "མི་རྣམས་ཀྱིས་གློ་རུ་བཏོལ་ལ་ཁད་ཙ་ན་སྤྲང་པོ་དེ་ཟངས་ཀྱི་ནང་དུ་བཅུག་ནས་ཟངས་ཀྱི་ཁ་ལ་ལྕགས་ཀྱི་གཟེར་བཏབ་ནས་གཙང་པོ་ལ་བསྒྱུར་རོ།",
    "མའ་བདག་ལས་ཅོལ་ཆུང་བ་མི་འདུག།",
    "ཆུ་ལ་བསྐུར་བ་དེ་སྤང་པོ་ཡིན་པར་འདུག་སྟེ།",
    "སློབ་དཔོན་ངན་ཐབས་མཁན་དེ་ད་རུང་གློ་འབུར་ན་སྦས་ནས་འདུག་པས་བོད་ཕུང་ཟིན་པ་ལས་མི་ཚོར་བས་ད་ལྟ་ཙམ་ལ་རྒྱལ་པོར་གྲོས་ཐོབ་ལ་སོད་ཅིག་བྱས་པས།",
    "ད་འོ་བརྒྱལ་ཏེ་སློབ་དཔོན་གཤེགས་པར་ཞུ་དགོས་འདུག་བྱས་ནས་ཞུ་བ་ཕུལ་བས།",
    "དབུ་རུའི་སྐྱི་གཙང་ལ་བརྒལ་བའི་དུས་སུ་སློབ་དཔོན་གྲུ་ནང་དུ་བཞུགས་ནས་ཡོད་ཙ་ན་འདི་སྐད་གསུངས་ཏེ།",
    "མ་མྱོང་དགུ་མྱོང་ཤི་བ་མ་མྱོང་ཙམ་གྱི་བེ་རོ་ཙ་ན་ང་།",
    "མ་མྱོང་དགུ་མྱོང་ཤི་བ་མ་མྱོང་ཙམ་གྱི་བེ་རོ་ཙ་ན་ང་།",
    "རི་ཐམས་ཅད་བྱ་རྒོད་སྤུངས་པའམ་ཤེལ་གྱི་མཆོད་རྟེན་བཞིན་དུ་འདུག།",
    "ལུང་པ་ཐམས་ཅད་ཁ་བ་བབས་པའམ་ནམ་ལངས་པ་བཞིན་དུ་འདུག།",
    "ཆར་མུན་འཐིབས་པ་བཞིན་དུ་ནག་སུབས་སེ་འདུག་ནས།",
    "འདི་མ་ལེགས་པས་རི་ཐམས་ཅད་བཤུས་ནས་ག་ན་འདུག་པ་བཙལ་ནས་རྙེད་ན་གསོད་དགོས་ཟེར་ནས།",
    "ཆེ་མེད་ཆུང་མེད་ཐམས་ཅད་ལག་སྦྲེལ་ནས་བཙལ་བས་སློབ་དཔོན་བེ་རོ་ཙ་ན་རྙེད་དེ།",
    "འདིར་བོད་ཀྱི་འབུག་ཐུ་ལུམ་པ་གཅིག་འདུག་པས་ངེད་ཀྱི་ཡུལ་འཕྲོག་པའི་སོ་རྟོག་པའི་རྟོག་ཆེན་པ་ཡིན་པས་མིག་འབྲུ་ནས་མ་བསད་ན་ད་དུང་དུ་འོང་ཉེན་ཡོད་ཟེར་ནས་ལ་ལས་ཕུལ།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནས་དོང་ནང་ནས་འདི་སྐད་སྨྲས་སོ།",
    "དེ་ནས་ཞག་བདུན་ལོན་ཙ་ན་བལྟས་པས་ཤིག་རྣམས་ཁ་ཕྱིར་ལོག་སྟེ།",
    "སློབ་དཔོན་ཟར་མ་བཏུབ་པར་སློབ་དཔོན་ཟིལ་པ་ཕྲུམ་མེ་མདངས་ཡལ་ལེ་བཞུགས་འདུག་གོ།",
    "དེ་ནས་སློབ་དཔོན་བེ་རོ་ཙ་ནས་སྦལ་པ་དང་ཤིག་ལ་དོང་ནང་ནས་བཤགས་པ་བྱས་པ།",
    "བདག་ཉིད་བེ་རོ་ཙ་ན་མཆིས་པ་འདི།",
    "དེར་མི་འོང་བར་འདུག་སེམས་ཙ་ན།",
    "ཕ་ཡོད་ཀྱང་དྭའུ་ཞད་དུ་འདུག་པ་ཟེར་སྐད།",
    "དེར་དུས་ནམ་ཞིག་ན་བོད་དུ་བསྐོར་ནས་ལོག་པའི་རྩྭ་མི་ཤིང་མིའི་ཚོང་པ་མང་པོ་བྱུང་ནས་སློབ་དཔོན་བེ་རོ་ཙ་ནས་ཚོང་པ་རྣམས་ལ་བོད་དུ་བསྐོར་བ་ཡིན་ནམ་བྱས་པས།",
    "འོ་ན་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེའུ་བཙན་སྐུ་ཁམས་བདེ་བར་འདུག་གམ།",
    "མཆོད་གནས་སུ་སུ་བཞུགས་འདུག།",
    "རྒྱལ་པོ་སྐུ་ཁམས་ཤིན་ཏུ་བདེ་བར་འདུག།",
    "འོ་ན་ཁོས་ཤེས་པ་འདུག་གམ་བྱས་པས།",
    "ཁྱེད་མངའ་བསྐུར་བའི་ལོ་ཙཱ་བར་འདུག་པས་བར་ཞུགས་བྱར་མི་རུང་བས།",
    "སློབ་དཔོན་གྱི་ཞལ་ནས་དེ་ལྟ་བུ་ཤེས་པའི་བེ་རོ་ཙ་ན་བྱ་བ་དེ་ང་རང་ཡིན་ཏེ།",
    "སྡུག་ལ་ཚེ་རིང་བ་འདིས་ཅི་བྱེད་ཤི་ན་རུང་ཤི་ན་རུང་སེམས་ཙ་ན།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནས་ཕྱག་སྤྱི་བོར་བཞག་ནས་ཨ་ཧ་ཧོའི་ཞེས་བྱིན་གྱིས་བརླབས་པས།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན་དེ་ལ་མཉེས་ནས།",
    "བདག་ཉིད་བེ་རོ་ཙ་ན་མཆིས་པ་འདི།",
    "བདག་ཉིད་བེ་རོ་ཙ་ན་མཆིས་པ་འདི།",
    "དུས་དེ་ཙ་ན་བསམ་ཡས་ན་རྒྱ་གར་གྱི་པཎྜི་ཏ་པདྨ་སཾ་བྷ་ཝ་དང་།",
    "དེའུ་དུས་དེའི་ཚེ་སྒྲ་དང་དོན་བསྒྱུར་བ་ལ་ལོ་ཙཱ་བ་མཁས་པ་གཅིག་ནི་བན་ཆུང་བེ་རོ་ཙ་ནས་མཛད་དོ།",
    "ཞེས་བྱ་བར་གསུངས་ནས་ཡོད་དོ་ དུས་དེ་ཙ་ན་བེ་རོ་ཙ་ནའི་ཡུམ་བསྒྲེས་པར་འདུག་པས་ཚེ་ལ་ལོང་མི་འདུག་པས་སྔོན་ལ་ཡུམ་ལ་བསྙེན་གནས་ཀྱི་སྡོམ་པ་ཕོག།",
    "ད་ལྟ་བེ་རོ་ཙ་ནའི་མཆོད་རྟེན་ཟེར་བ་དེ་ཡིན་ནོ།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནའི་ཡབ་ཀྱི་ཞལ་ནས།",
    "བདག་ཉིད་བེ་རོ་ཙ་ན་མཆིས་པ་འདི།",
    "བདག་ཉིད་བེ་རོ་ཙ་ན་མཆིས་པ་འདི།",
    "དེ་ནས་ནང་མ་གཅིག་སློབ་དཔོན་གྱི་བཞུགས་ས་ན་ཆུ་གཅིག་ལྟེམ་མེར་གདའ་སྐད།",
    "སྤྱན་ཅི་ཉེས་བྱས་པས་ངའི་མལ་ན་ཆུ་གཅིག་འདུག་པ་མ་དྲན་ནམ་གསུངས་སྐད།",
    "ནངས་པར་བལྟར་ཕྱིན་ཙ་ན།",
    "སློབ་དཔོན་མི་བཞུགས་པར་ལྷག་མེད་དུ་གཤེགས་ནས་མི་གདའ་སྐད་དོ།",
    "ད་ལྟ་ཟིམ་ཤི་འཛིང་ཨ་ཇོ་རྒྱུད་བྱ་བ་ཡིན་གསུང་།",
    "དེ་ནས་ལོ་བཅུ་བདུན་ལོན་ཙ་ན།",
    "ཚོས་དོལ་གྱི་གདུང་སྣ་རུ་ཚོང་ལ་ཕྱིན་ཙ་ནཱ།",
    "དོལ་གྱི་འཚེར་ཆུང་བྱ་བ་ན་མི་མང་པོ་སྤུང་ངེ་འདུག།",
    "དོལ་དུ་འགྲོ་བའི་ཟླ་བོ་འདུག་གོ་གསུངས་ནས་ཕྱིན་ཙ་ན།",
    "ད་ལྟ་ཞི་བྱེད་པ་ལ་ཚིག་མང་པོ་འདུག་སྟེ་དམ་པས་དེ་ཙམ་གསུང་མི་སྲིད་པ་གཅིག་ཡོད།",
    "ངས་ལོ་སུམ་ཅུ་སོ་ལྔ་ཙམ་ལོན་ཙ་ན་གཙང་བ་སྐོར་ནས་སྤྱང་རྩིགས་སུ་བརྟོལ་ཙ་ན།",
    "དེ་ཚོ་ཁྱེར་ནས་འོ་དེ་ན་གཅིག་ཀྱང་འདུག་པ་གསུངས་ནས།",
    "གསང་བ་དེ་མི་ཡིད་དུ་འོང་བ་སེམས་མཐུན་པ་དང་འཕྲད་ཙ་ན།",
    "དེ་ཙ་ན་སློབ་དཔོན་གྱི་ཞལ་ནས།",
    "དེ་ནས་སློབ་དཔོན་རྦ་སྒོམ་དེ་དགུང་ལོ་དགུ་བཅུ་རྩ་བརྒྱད་ལ་གྲོངས་པའི་ཚུལ་བསྟན་པ་ཡིན་ཏེ་བསྙུང་བའི་ན་ཚ་མེད་པར་གཤེགས་འདུག་སྐད།",
    "ཆེད་དུ་བསྒྲུབ་མི་དགོས་པར་མངོན་ཤེས་ཞར་ལ་འཆར་བར་འདུག།",
    "དེ་ཙ་ནའི་རྣལ་འབྱོར་པ་བཟང་པོ་ཤ་སྟག་དང་འགྲོགས་ཏེ།",
    "འཛེང་སྒོམ་གསས་ཐོག་དེ་ད་དུང་དུ་དྭགས་པོ་ན་འདུག་ཟེར་བ།",
    "ང་དང་། གཉིས་གཞོན་ཙ་ན་གྲོགས་པོ་ཡིན་ཏེ།",
    "དགུང་ལོ་བརྒྱ་དང་བཅུ་བདུན་ཁོ་ན་ལོན་འདུག་གོ།",
    "དམ་པ་རྒྱ་གར་དང་མཇལ་བ་ཡིན་བྱ་བ་དེ་ལྷ་བཟོ་ཀླུ་རྒྱལ་དམ་པའི་སྐུ་འབག་གཅིག་འབྲི་ཡིན་འདུག་པ་ལ།",
    "དད་པ་ཅན་གདམས་ངག་འདོད་ངེས་པ་འདུག་ན་ངའི་གམ་དུ་ཁྲིད་ལ་ཤོག་ཅིག།",
    "སློབ་དཔོན་གྱི་ཞལ་ནས་ང་རང་ལོ་ལྕགས་ཁྱི་ལོའི་ཟླ་བ་ཉའི་སྐར་མ་རྒྱལ་ལ་སྐྱེས་པ་ཡིན་པར་འདུག།",
    "མ་སྐྱེས་ཙ་ན་མའི་ཁོང་པ་ནས་སྐད་ལྷང་ལྷང་བ་གཅིག་ལན་གསུམ་ཙམ་བྱུང་ནས་མི་རུང་སྙམ་ནས་རྟོག་པ་ཞུགས་པ་ཡིན་ཏེ།",
    "སློབ་དཔོན་གྱི་ཞལ་ནས་ངས་ལོ་དགུ་ལོན་ཙ་ན་ཉི་ཟླ་གཉིས་པོ་ས་ལ་བབས་ནས།",
    "ལོ་བཅོ་ལྔ་ལོན་ཙ་ན་སློབ་དཔོན་སྐོར་སྟོན་རཱ་ཛ་གྲོངས་ནས་སློབ་དཔོན་བུའི་གན་དུ་ལོ་ལྔ་ཙམ་ཞི་བྱེད་ཞུ་ཡིན་དུ་བསྡད་དེ་ཞབས་ཏོག་གྲུབ་ཚད་བྱས།",
    "སློབ་དཔོན་པ་ཀུན་ཤིན་ཏུ་བདེན་པར་འདུག་སེམས་པ་ཡང་བྱུང་གསུངས་སོ།",
    "སློབ་དཔོན་ཇོ་སྲས་དང་ལོ་བརྒྱད་ཙམ་ལ་ཕལ་ཆེར་མ་བྲལ་བར་འགྲོགས་ནས་འདུག་པ་ལ།",
    "ཕྱི་ནས་སློབ་དཔོན་ཆེན་པོ་གྲོངས་འགྲོ་ཙ་ན་། སྟོན་ཟླ་ར་བའི་ཉི་ཤུ་གཉིས་ཀྱི་སྲོད་ལ་ཚེས་པ་བཅོ་ལྔའི་ཟླ་བ་ཇེ་ཆུང་ཇེ་ཆུང་ལ་ཟད་པའི་ཤུལ་ན་སྐར་མ་གཉིས་འདུག་པ་གཅིག་རྨིས་པ་དེ།",
    "སྔར་སློབ་དཔོན་དང་མཇལ་ཙ་ན་སྐར་མ་གཉིས་ཐེམ་པ་རྨིས་པ་དང་།",
    "ཕྱིས་ཟླ་བའི་ཤུལ་ན་འདུག་པ་རྨིས་པ་དེས་ངེད་སློབ་དཔོན་ཇོ་སྲས་དང་གཉིས་ཀྱི་བརྡར་བྱུང་གསུངས།",
    "མིན་གསུངས་ཙ་ནཱ།",
    "འོང་ཡང་ཁྱེའུ་གཤའ་མ་གཅིག་འོང་བ་གཅིག་འདུག།",
    "ནམ་མཁའ་ལ་སྐར་མའི་མི་རྐང་ལག་ཅན་གཅིག་ཤར་འདུག་པ་གཅིག་རྨིས།",
    "རྫུན་ཡིན་སྙམ་ཙ་ན།",
    "དབྱར་ཤམ་པོ་གངས་ལ་ལག་བདེ་བྱས་པའི་མར་ལ་འོང་ཙ་ན་ལྷུམས་སུ་ཞུགས་པ་ཡིན་འདུག་ནས་སྐར་མ་འོད་། ལྷག་ལྷག་པ་གཅིག་རྨིས་པ་ཡིན།",
