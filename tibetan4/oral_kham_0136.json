    "བདག་མིང་འདི་ཞེས་བགྱི་བ་དུས་འདི་ནས་བཟུང་སྟེ་ཇི་སྲིད་འཚོའི་བར་བྱས་ཤིང་ཕྱག་གསུམ་འཚལ་ཏེ་འདུག་ལ།",
    "རང་རང་བཞིན་ཅན་དུ་གྱུར།",
    "རང་རང་འཁོར་ཚོགས་རྒྱ་མཚོར་བཅས།",
    "ཞེས་པའི་ཡིག་འབྲུ་དྲུག་རང་སྒྲ་དང་བཅས་ཏེ་སྟེང་འོག་ཕྱོགས་དེ་བླ་གབ་ཀྱི་རྣམ་པར་ཁྱིལ་ལེ་བ་ཁང་པ་ཀ་བ་བཞི་ཙམ་རྒྱ་ཁེབས་པ་བཏུད་ནས་བཞི་དང་བཅས་པར་འོད་ཟེར་གྱི་རྣམ་པར་འཕྲོས་ཤིང་སླར་ཡང་འོད་དེའི་དཀྱིལ་བལྟས་ན་ཨོཾ་གྱི་རྣམ་པར་གནས་པ་ཞིག་འདུག་གོ།",
    "འོག་གཞི་ཟླ་བའི་དཀྱིལ་འཁོར་དེ་གཡོ་ཞིང་འདུག་པའི་གསེབ་ནས་བྱུང་བ་སྙམ་བྱེད་པའམ།",
    "ད་ནི་འགྲོའམ་འདུག་ཀྱང་བླའི།",
    "དེས་ཀྱང་རང་ལ་དགོས་པར་གསུངས་པ་ལ།",
    "མ་དེ་ཐིག་ལེར་ཡལ་ནས་མི་གདའ་བ།",
    "དེ་ནས་བརྒྱུད་པ་གསུམ་ལྡན་གྱི་ཐིག་ལེ་ལ་རྩེ་གཅིག་ཏུ་བཞུགས་མཁོན་གདའ།",
    "དེ་རིང་རང་ཡང་མི་ཐོབ་འདོད་ན།",
    "དུས་མཚན་མ་དང་རང་བྱུང་རྒྱལ།",
    "རང་རང་འཁོར་ཚོགས་རྒྱ་མཚོར་བཅས།",
    "ས་གཞི་ནམ་མཁའི་ཁམས་དང་རང་བཞིན་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "ལས་ཀྱི་རིགས་རི་བོ་ལྟ་བུར་རབ་ཏུ་གདའ།",
    "བཅུ་དྲུག་དུས་སུ་རྫོགས་འགྱུར་བ།",
    "དེ་ནས་ཚངས་པ་ཆེན་པོ་གཙུག་ཕུད་ལྔ་པ་བྱུང་སྟེ་བརྒྱ་བྱིན་གྱི་པང་བར་གླེར་འདུག་པ་དང་།",
    "འཛམབུ་ཆུ་བོའི་གསེར་ལས་བྱས་པ་ལྟ་བུ་ལྟཅི་སྨོས་སྙམ་ནས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་དང་།",
    "ཐག་རིང་པོ་ན་འདུག་པས་ཇི་ལྟར་གཉེནབྱ།",
    "གཞན་ཡང་བཅུ་དགུ་རིང་པོ་ན་འདུག་པ་དང་གཉེན་བྱ་བ་དེ་ནི་བརྟནཔ་ཡིནནོ།",
    "གདིང་བ་བཤམས་པ་ལ་སྐྱིལ་ཀྲུང་བཅས་ནས་འདུགགོ།",
    "བྲམ་ཟེ་དེ་ཅང་མི་སྨྲ་བརའདུག་ག་ཚར་བཅད་རྣམས་ཀྱི་ནང་ན་ལན་ལ་སྤོབས་པ་མེད་པ་འདི་ཐ་ཆད་ཡིན།",
    "རྣམ་ཐོས་ཀྱི་བུའི་ནོར་ནོར་གྱིས་འགྲན་བཞིག་འདུག་སྟེ།",
    "རྒོལ་བའི་སྟན་ལ་འདུག་ཅིག།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་ཕྱག་བཙལནས་ཕྱོགས་གཅིག་ཏུ་འདུག་པ་ད་དེདག་ལ་སྦྱིན་བ་དང་།",
    "ཁྱིམན་འདུགབཞིན་དུ་རབ་ཏུ་བྱུང་བ་བསྙེན་པར་རྫོགས།",
    "དེདགགས་ཀྱངབཤགས་པ་དང་བསྡམ་པ་དང་བྱིན་གྱིས་བརླབས་པསཕྱིར་བཙས་ཏེ་འདུག།",
    "གེ་ཚུལཉེ་བར་གཞག་པར་བྱ་ཞིང་བདག་ཉིད་ཀྱང་མི་གནས་པར་འདུག་པརབྱའོ།",
    "རྒྱལ་པོའི་ཁབ་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེསརིགས་མཉམ་ལསཾཆུང་མ་བླངས་ནས་དགའ་དགུརཾ་སྤྱད་པས་བུ་ཞིག་སྐྱེས་ནས་བསྲིངས་བསྐྱེད་དེ།",
    "གོས་ངུར་སྨྲིག་བགོས་ཏེ་འདུག་པ་དང་།",
    "རྒྱལ་ཆེན་རིམ་བཞི་པའི་ལྷར་སྐྱེས་ནས་སྟོན་པའི་སྤྱན་སྔར་བཞིན་པ་མཐོང་སྟེ་ལྷ་རྣམས་ཀྱི་ནང་ན་འདུག་པ་མཐོང་ཊའཛུམ་བསྔོན་དུ་བཏང་སྟེ།",
    "དགེ་སློང་རྣམས་ཁྲུས་བྱས་ནས་འདུག་རྫས་སོགསགཙུག་ལག་ཁང་དུ་ལེན་པས་འགེངནས།",
    "ལནམེདཔརཾཅང་མི་ཟེར་བར་འདུག་གོ།",
    "སྟོན་པས་ཕྱེ་བ་དང་སྤྲུལཾཞིགམགོའི་གདེངས་ཀ་ཆེརབྱས་ནས་འདུག་གོ།",
    "དེའི་ཚེ་བཟང་སྦྱིན་འཁོར་དེ་ཉིདན་འདུག་པ་འགྱོད་པ་དག།",
    "དེ་འདུག་པ་དང་།",
    "སྤོབས་པམེདསེམས་ཁོང་དུ་ཆུད་ཅིང་འདམ་བུ་སེནཔརབས་བརྙིངས་པ་ལྟར་འདུག་གོ།",
    "རྒྱལ་པོ་ཚངས་བྱིན་གྱི་ཞང་པོས་སྔོནཔྱད་པ་ཞིག་འདུག་གོ།",
    "གེ་སློང་ཞིག་ནགས་སྟུག་ན་འདུག་བ་དང་།",
    "དེའི་ཚོརྒྱལ་པོའི་ཁབ་ན་ཤིང་སྲུང་བའི་མི་སྣ་ཆེན་པོ་ལ་གཏོགས་པ་དགེ་སློང་ནོར་ཅན་གྱི་གཏམ་འདྲེས་པཕིབསཔར་སྨྲ་བ་ཞིག་འདུག་གོ།",
    "ཏེ་དཀྱིལ་ཀྲུང་བྱེད་ཀྱིས་འདུག་གོ།",
    "གནོད་སྦྱིན་དག་འདུག་པས།",
    "སདེའི་ལགཔགཡསཔབཅདཔས་གཉིས་ཀ་འཕྱང་ཞིང་འདུག་གོ།",
    "དགེ་སློང་ཞིགརིའི་དྲུང་ན་དཀྱིལ་ཀྲུང་བཅས་ཏེ་འདུག་པ་དང་།",
    "དེ་ནས་སྟོན་པས་ཆུ་སྲིན་ཉའི་རིགས་མགཏོགས་པའི་སྲོག་ཆ་གསདེདགཆུ་ཀླུང་ཡིད་འོང་ལྡན་དུའདུག་བདང་།",
    "རལ་བ་ཡང་སེར་སྐྱར་འདུག་པསཨིང་སེར་སྐྱར་བཏགས་སོ།",
    "འབུམ་ལུས་འབྲུ་མར་གྱིས་བྱུགས་ནས་ཁྲིའུའི་སྟེང་དུ་འདུག་པ་དགེ་སློང་མས་མཐོང་ནས།",
    "འདུན་པ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་ན།",
    "ཏིང་ངེ་འཛིན་ལས་ལངསཔའི་ཚོ་དྲུངང་འགྲོ་སྙམནས་མཐའ་ཞིག་ཏུ་འདུག་གོ།",
    "ངེས་སྟོན་པའི་ཞབས་གཉིསལམགོ་བོས་ཕྱག་བཙལ་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུགགེ།",
    "འདིའི་ང་བངགལསྨྱོན་འཛུགས་ཤིང་ཆུང་གཞན་ལེན་པར་འདོད་པས་དེ་སྐད་ཟེར་ཞིང་སེམས་ཁོང་དུ་ཆུད་འདུག་པས།",
    "དབྱེན་བྱེད་པོར་འགྱུར་བའི་རྩོད་པ་ཡང་དགོཔར་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་འདུག་པ་བདེན་ནམ།",
    "འདོད་པ་བྱར་རུང་བར་སྟནལའདུགཔར་བྱེད་ཅིང་།",
    "འདོད་པ་བྱར་མི་རྙིང་རུང་བར་སྟན་ལ་འདུག་པར་བྱེད་ཅིང་།",
    "ཟསགཙང་ཉིད་ཀྱང་རྒྱལ་པོའི་འབྱོར་པ་དང་མཐུ་ཆེན་པོས་རྒྱ་གྲོ་དྷའི་ཀུན་དགའར་བན་སྟོན་པ་ལ་སྡོད་ཅིང་འདུགགོ།",
    "དོན་འཐུན་དེའི་ནང་ན་མུ་སྟེགས་ཅན་ཞིག་འདུག་པ་དེས་དྲུག་སྤྲེསལཁྱེད་ཅག་གང་དུ་ཁུར་འཇུག།",
