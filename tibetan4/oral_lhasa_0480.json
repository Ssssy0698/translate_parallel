    "གསལ་བར་བྱས་པ་དང་གཉིས།",
    "འགོས་ཀྱིས་ས་གླང་དེ་དྲུག་ཅུ་སྐོར་སྔ་མའི་ས་གླང་དུ་བྱས་ནས་སྲོང་ག་བཙན་དགུང་ལོ་གྱ་གཉིས་ལ་བཞུགས་པར་གསུངས།",
    "དེ་དུས་སྲོང་བཙན་དོན་གཉིས་ལ་ཕེབས།",
    "སྲོང་བཙན་དོན་དགུ་ལ་ཕེབས་ཚེ་ཀོང་ཇོ་དང་བཤོས།",
    "སྤྱིར་སྲོང་བཙན་བརྒྱད་ཅུ་ལྷག་བཞུགས་ཟེར་མཁན་རྣམས་ཀྱིས།",
    "རྒྱལ་བོ་དོན་དགུའི་སྐབས་རྒྱ་བཟའ་བག་མར་བཞེས་སོ་བྱ་བ་འདི་འཛུམ་བག་ཅུང་ཟད་དང་བཅས་ཁས་ལེན་དགོས་པ་བཟློག་ཏུ་མེད།",
    "དེའི་ཡབ་ནི་གུང་སྲོང་གུང་བཙན་ཡིན་པས་དེ་དགུང་ལོ་དུའི་ཐོག་སྲས་བསྐྲུན་པར་མཛད་ཅེས་འདྲིའོ།",
    "མེ་གླང་ལ་འཁྲུངས་པར་འདོད་པ་ལྟར་ནའང་།",
    "དེབ་གཉིས་པར་སྲོང་བཙན་ཀྱི་སྲས་གུང་སྲོང་དང་།",
    "ཞེས་ཀུན་མཁྱེན་འཇམ་དབྱངས་བཞད་པའི་བསྟན་རྩིས་དང་མཐུན་པར་གསུངས་པ་ནི་ལོ་ཚིགས་རྣམ་པར་དག་པ་ཡིན་ནོ།",
    "ཇོ་བོ་ཆུ་རྟ་ལ་བོད་དུ་ཕེབས་པ་ནས་ལོ་བརྒྱ་དང་གསུམ་པ་ཤིང་བྱིར་ཁ་ཆེ་པཎ་ཆེན་བོད་དུ་བྱོན་ཞེས་པ་མ་དག་སྟེ།",
    "ཞེས་གསུངས་པ་ནི་འཁྲུལ་བ་མེད་པའི་ལོ་ཚིགས་སུ་ཤེས་པར་བྱའོ།",
    "༨ནམེ་མཁའ་རྒྱ་མཚོའི་འདས་ལོ་སུམ་བརྒྱ་དོན་བཞི་པ་མེ་བྱ་༩༩༧ལ་ཕྱི་དཪ་བྱུང་བར་གསུངས་པ་ནི་འབྲོམ་གྱིས་བཞེད་པའི་ས་སྟག་ལས་ལོ་བཅུ་དགུས་འཕྱི་སྟེ་ཁུངས་གང་ལ་བརྟེན་པཙལ་བར་བྱའོ།",
    "འདི་འདྲ་ནི་གཞུང་ལུགས་ལ་ཐོས་བསམ་བྱས་པ་ལྟ་ཅི་སྨོས།",
    "ཤེས་པ་རང་བཞིན་དུ་གནས་པ་སུས་ཀྱང་མི་སྨྲ་བས་གཟུར་གནས་ཀུན་ལེགས་པར་སོམས་ཤིག་ཅེས་བཀའ་བཀྱོན་མཛད་ཡོད་དོ།",
    "མ་གསུངས་པ་ནི་ཤིན་ཏུ་ཕངས་སོ།",
    "སྲོང་བཙན་མེ་གླང་ལ་འཁྲུངས་པར་བྱེད་པ་ནི།",
    "ཞེས་གསུངས་པས་ཀྱང་མགོ་བོ་འཁྲུག་པར་འགྱུར་ཏེ།",
    "དཔའ་པོའི་མཁས་པའི་དགའ་སྟོན་རྣམས་དང་ཡང་མཐུན་པར་འགྱུར་རོ།",
    "འོན་ཀྱང་འདི་ལྟར་ན་ཁྲི་སྲོང་དགུང་ལོ་དོན་ག་ཅིག་ལ་བཞུགས་པར་ཁས་ལེན་དགོས་ཏེ།",
    "ཁྱེད་ལྟར་ན་རལ་བ་ཅན་ལ་ཁྲི་ལྡེ་སྲོང་བཙན་དུ་འབོད་པར་བཞེད་ནའང་།",
    "ཁྭ་ཏས་མི་གཙང་ཟོས་པའི་མཆུ།",
    "གཙང་མའི་ངོས་ལ་འབད་དེ་འཕྱིད།",
    "དེ་ནས་སློབ་དཔོན་སྲིན་ཡུལ་རྒྱུ་ཕེབས།",
    "ཞེས་སྣང་ཡང་འདི་སྐབས་ཕལ་ཆེར་ན་བོད་ཕྱི་རབས་ཀྱི་རྩོམ་རིགས་ཁོ་ནར་སྣང་བས་ལྷད་བསྲེས་པ་ཞིག་ཡིན་པར་དོགས་ལ།",
    "གཅེན་གཙང་མ།",
    "འགྲོ་མགོན་མངའ་རིས་སུ་བྱོན་པའི་ལོའི་སྐབས་སུ་ལོ་བཅུ་ཆད་པ་རྣམས་སྦྱན་ལ་མ་ཐོགས་པར་ལུས་འཇུག་གོ།",
    "མེ་ཡོས་ནས་ལོ་བཞི་ལོན་པ་ལྕགས་རྟ་ལ་ཁྲི་སྲོང་འཁྲུངས་པའི་ཕྱིར་དགུང་ལོ་ཉེར་གཉིས་བཞེས་པ་ལྕགས་ཡོས་ལ་རྨང་བཏིངས།",
    "ཀྱིས་བསམ་ཡས་ཚར་བ་འདི་ངེས་པར་སྣང་ངོ།",
    "མེ་མཁའ་རྒྱ་མཚོའི་ལོ་བརྒྱ་དང་ཉག་མ་བདུན་པར་འབབ་པ་ལྕགས་རྟ་སྤྱི་ལོ་༧༣ལ་ཁྲི་སྲོང་ལྡེ་བཙན་འཁྲུངས།",
    "ལྷ་ས་དགུང་ལོ་ཉེར་གསུམ་དང་ཉེར་ལྔར་བཏབ་ལ་དང་།",
    "རྒྱ་བཟའ་ཕེབས་ལོ་མི་མཐུན་པ་སོགས་ལུང་རིགས་ཀྱི་ཁུངས་ཡོད་ཀྱང་ཡི་གེ་མང་བ་ལ་འཇིགས།",
    "ཉིས་ལ་ལོསྐོར་ག་ཅིག་རྒྱུགས་ཤིང་ཀོང་ཇོ་བོད་དུ་ཕེབས་ལོའི་བར་ལ་ལོ་དྲུག་རྒྱུགས།",
    "བསྟན་བསྣུབས་ཀྱི་ལོ་རྣམས་ནི་མ་དང་མཐུན་ཏེ་ས་སྐྱ་གྲགས་པ་རྒྱལ་མཚན་སོགས་ཀྱི་བཞེད་པ་དང་མཐུན་པར་སྣང་ངོ།",
    "ལྟར་དབུ་ཅན་གྱི་འབྲི་ཚུལ་ལེགས་པར་བྱང་ཞིང་ཚད་དང་ལྡན་པར་གྱུར་པ་ན།",
    "དེ་ལེགས་པར་ལོབས་པ་ན་རྒྱུགས་ཡིག་གམ་འཁྱུགས་ཡིག་ཇི་ལྟར་འབྲི་ཚུལ་སྦྱོང་དགོས།",
    "བོད་ཀྱི་ཐང་ཡིག་རྣམས་ལེགས་པར་སྦྱངས་པའི་རྗེས་ནས་ལབརྩེགས་མ་རྣམས་རྫི་ལེགས་སྦྱར་སྔགས་ཀྱི་དབྱངས་གསལ་དང་།",
    "བོའི་ཡི་གེ་རྟ་ལྟ་བུ་དང་ཐིག་ཕྲེང་འགབ་མའི་ཡི་གེ་བྱི་ལ་ལྟ་བུ་སྤྱིར་ཡོན་ཡིན་ཚེ་ད་དུང་གཞི་ནས་ལེགས་པར་སྦྱོང་དགོས།",
    "བློ་ཆེན་ཀུན་བཟར་མཁྱེན་གཏེར་འཇམ་དབྱངས་དངོས།",
    "དེ་ལ་འདིར་རྒྱལ་བའི་བསྟན་ལ་སྟོན་པ་གཉིས་པར་གྱུར་པ།",
    "དགུང་ལོ་བདུན་གྱིདུས་སུ་བྲག་བྱ་ཁྱུང་དུ་ཕེབས་ནས།",
    "ཐོག་མར་མངོན་རྟོགས་རྒྱན་རྩ་འགྲེལ་ལ་སྦྱངས་པས་མཁྱེན་རབ་ཀྱི་རྩལ་ལ་མཁས་བ་རྣམས་ཧ་ལས་པ་བྱུང་།",
    "དེ་ནས་གཙང་ཕྱོགས་ཀྱི་ས་སྐྱ་དང་།",
    "གནས་རྙིང་རྣམས་སུ་རིམ་པར་ཕེབས་ནས་ཉ་སྟོན་ཀུན་དགའ་དཔལ་བ་དང་།",
    "ད་ལྟ་མཐའ་འཁོབ་མི་བཟད་པར་གྱུར་པའི།",
    "ཉིད་ཀྱིས་ལེགས་པར་བཙུགས་སོ་ཞེས།",
    "ཞེས་གང་གསུངས་པ་ལྟར་རོ།",
    "ཞལ་ཐང་འདི་ནམ་སྤྱན་དྲངས་པའི་ལོ་ནི་སྐུ་འབུམ་གདན་རབས་དཀར་ཆག་རྒྱས་བསྡུས་གཉིས་དང་བསྡུན་ན་རྗེ་དགུང་ལོ་ཉེར་ག་ཉིས་བཞེས་པ་རབ་བྱུང་དྲུག་པའི་བགྲང་བྱ་ང་གཉིས་པ་ས་ཕོ་རྟ་ཡི་ལོ་སྤྱི་ལོ་༡༣༧༨ཡིན་པར་དཔོག་ཐུབ།",
    "དཀར་ཆག་དེར་གསུངས་པ་ལྟར་སྐུ་འབུམ་དཀར་ཆག་རྙིང་བའི་ནང་ནོར་བ་མང་བས་ཡིད་བརྟན་ཐུབ་པ་ཞིག་མེད་ཀྱང་།",
    "མ་ཡུམ་གྱི་དབུ་སྐྲ་དཀར་པོའི་ངལན་བུ་ཞིག་དང་བཅས་རྗེ་བདག་ཉིད་ཆེན་པོ་རང་ཡུལ་དུ་གདན་འདྲེན་ཞུ་བའི་དུས་དེར་ཡབ་ཀླུ་འབུམ་དགེ་ཕལ་ཆེར་དག་ཞིང་དུ་ཕེབས་ཚར་བའི་གཏན་ཚིགས་ཆེ་བ་དང་།",
    "གཡས་ཟུར་དུ་རྗེ་བཙུན་འཇམ་དབྱངས་དམར་སེར་བྱང་སེམས་རྣམ་ཅན་ཟུར་བཞུགས།",
    "གཡོན་ཟུར་དུ་རྗེ་བཙུན་ཕྱག་རྡོར་སྔོན་པོ་པྱང་སེམས་རྣམ་ཅན་ཟུར་བཞུགས།",
    "རྗེ་གླིང་འཕུར་མའི་སྐུ་དཔར་དངོས་མ་གསེར་གང་བླུགས་ཅན་བྱིན་པར་གྲགས།",
    "དུས་དེར་ཞིན་ཀྱ་ཞབས་དྲུང་ཟེར་བས་ཞལ་ཐང་པདན་དྲངས་ནས་སོག་ཡུལ་དུ་བྲོས་ཏེ་དད་འབུལ་བྱུང་བའི་དངོས་རྫས་ཀྱིས་འདུ་ཁང་གསར་བཞེངས་བྱས་པ་དེ་རབ་རྒྱལ་ས་ཁྱི་ལོའི་བར་དུ་བརྟན་པར་བཞུགས།",
    "དགོན་བདག་ཨ་ལགས་དུའུ་གྱ་ཚཇ་དང་།",
    "གཙང་བ་ཨ་ལགས་ཡིན་པར་གྲགས་སོ།",
    "དེ་ཡང་ལྔ་རིག་པའི་འདུན་སར་བདེ་བླག་ཏུ་ཕྱིན་པར་འདོད་པ་རྣམས་ལ་མེད་རྡུ་མི་རུང་བའི་སྒྲ་རིག་པའི་ཡན་ལག་ཡུལ་དང་དུས་ཀྱིས་ཕན་ཚུན་རིང་བར་གྱུར་ཀྱང་ཉི་མ་དང་པད་མའི་འབྲེལ་པ་ལྟར་མཛའ་གཅུགས་མི་ཕྱེད་པའི་ཐབས་ཁྱད་དུ་འཕགས་པ།",
    "རྡོ་ཆག་དུམ་བུ་བཙན་བསྒྲིགས་ཀྱི་ཐེམ་པ་ལྟ་བུའི་ཚིག་སྦྱོར་ཅི་རིགས་དྲི་ངན་ཞིག་བྲོ་བར་གྱུར་ཚེ་མཁས་པའི་ཡིག་ག་ཏིང་ནས་ལོག་པར་འགྱུར་བས་ཚུལ་དེ་དག་ལ་སྒོ་ཀུན་ནས་གཟབ་པར་བྱའོ།",
    "མཁྱེན་ཁརྩེ་ནུས་གསུམ་ལྡན་པའི་བཤེས་གཉེན་ཞེས་པ་ལྟ་བུའི་སྤྱི་ལྡོག་ནས་སམ།",
    "སྔོན་མེད་ཤེས་བྱའི་གསང་ཚིག་རྗེན་པར་སྟོན་པའི་སློབ་དཔོན།",
    "ཞེ་ས་སོགས་ཅི་ཡང་མེད་པར།",
    "ཚིག་མཐར་ད་དུང་ཉན་སྤྲོ་བའི་ཚིག་ཉམས་བཏོད་པར་འདོད་ན།",
    "ཞིམ་ཡངར་བཞེས་སྤྲོ་ཤེལ་ཀ་ར་རྡོག་པོ་གཅིག་དང་།",
    "སྦྱང་བྱའི་ནས་ལ་ཚིམ་པ་མེད་པར་མཁས་པའི་རྒྱལ་ཐབས་ཅི་ཟིན་དང་།",
    "འབྱོར་ཚོགས་ཟད་མི་ཤེས་པའི་དགའ་སྟོན་ལ་ཉིན་མཚན་དུ་རོལ་བའི་ཡོ་ལང་པསམ་བརྗོད་ལས་འདསཔ་སྤྲོ་སྒང་དུ་བཞུགས་པ་གོར་མ་ཆགསླད་དུ་འང་།",
    "ལྔ་རིག་ཚལ་དུ་བག་ཡངས་སུ་རྩེན་པའི་རྣམ་དཔྱོད་ཀྱི་གཟེངས་མཐོ་བ་མཁྱེན་རབ་འདོད་འཇོ་ནས་ཆེད་དུ་སྤེལ་དོན།",
    "མཚུངས་ཟླསདབེན་པའི་མཛའ་གྲོསགང་ཉིད་སྐུ་ཁམས་སྟོན་ཟླའི་དཔལ་ལ་འགྲན་པ་གཞིར་བྱས།",
    "ཁྱེད་ལ་ལྷག་པཔར་གདུང་ཞེན་ཡོད་པ་སྨོས་མ་དགོསལ།",
    "ཟླུམ་སྟེ་གུས་པས་གསོལ་བ་འདེབས་པ་ལགས།",
    "ཕོ་ཉ་བསམ་གྲུབ་ཚེ་དཔལ་ཆེད་མངགས་གདོང་ཕུལ་བར་ཐུས་བྱམས་བརྩིའི་ཀློང་ནས་དགྱེས་བཞེསམཛད་པར་ཅི་གནང་།",
    "འབྲུ་ཁལ་གསུམ་བཅས་བསྐུར་ཡོད་ལགས་ཞེས་པ་ལྟ་བུ་སྟེ།",
    "མཚན་དངོས་ནས་བརྗོད་པར་དཀའ་པའི་ཚུལ་གྱིས་བཀའ་དྲིན་རྗེས་སུ་དྲན་པའི་ཐབས་ལ་གཟབ་པར་བྱའོ།",
    "རྩིའི་གཟེགས་མ་ཅི་དགར་འགྱེད་པའི་དྲིན་ལྡན་ཕ་མ་རྣམས་ག་ཉིས་ལྷན་བཞུགས་ཀྱི་མདུན་སར།",
    "རིགས་པར་སྦྱར་རོ།",
    "ཀྱི་ན་ཚོད་ཅུང་ཟད་ནར་སོན་པ་ཞིག་ཡིན་ཚེ་འདི་ཙམ་གྱིས་ཚིམ་པར་བྱར་ག་ལ་རིགས།",
    "བིས་པ་མི་ཕམ་ཟླ་བ་སོགས་ཀྱི་ཡིག་སྐུར་རྣམ་བཞག་དག་ལ་འདྲིས་པར་བྱས་ནས་ཚུལ་འདིར་བློ་རྒྱས་པར་བྱ་འཚལ།",
    "བྲི་གཞི་དར་གོས་སོགས་རྒྱུ་ཅི་ཙམ་བཟང་བ་དེ་ཙམ་གྱིས་ཞེ་ས་དང་བཀུར་སྟི་བྱས་པ་ཡིན་ན་ཡང་ད་ལྟའི་ཤོག་གུ་སྤུས་བཟང་འདི་ཉིད་ཤིན་ཏུ་ལེགས་ལ།",
    "སྟོད་དང་གཡས་ངོས་ས་སྟོང་ཆེ་བར་བཞག་པ་ཞེ་ས་བྱས་པ་དང་།",
    "ཕྱེད་དང་བཞི་ལྟེབ་དེ་ཡང་མི་དགོས་པར་སུམ་ལྟེབ་ཀྱིས་ཆོག་གོ།",
    "བཀའ་ཤོག་ལ་ལྟེབ་ཞེང་ཆེ་ཞིང་གུག་པ་ཉིས་ལྟེབ་བྱས་པས་འཐུས།",
    "དཀྱིལ་ཚད་དུ་ཟིན་པ་བྱས་ཏེ་ཉིས་ལྟེབ་ཏུ་བཀྱག་དེ་ནས་ནང་སོར་གང་དོ་ཙམ་གྱི་ཚད་ལྟར་དྲིལ་བར་བྱ།",
    "དེ་ལའང་ཞེ་ས་བྱེད་ན་ཉིས་ལྟེབ་བྱས་འཕྲལ་པུས་པཙུགས་ཀྱི་གོ་བ་དེ་བརྒྱབ་ནས་ཤོག་དྲིལ་དུ་བྱེད་པའང་ཡོད་དོ།",
    "ཞེ་ས་ཐོབ་པར་དར་དང་ཡི་གེ་སོགས་ལྷོད་པོར་ཤོང་བའི་ཚད་ཀྱི་ཡ་ཁེབས་སུམ་ཆ་གཉིས་དང་།",
    "མཁས་པ་རྣམས་ཡི་ག་ལོག་པའི་རྐྱེན་དུ་འགྲོ་ཉེན་ཆེ་བས་རྣམ་པ་ཀུན་ཏུ་གཟབ་པར་བྱའོ།",
    "ལོའི་ཟླ་པར་པར་གཞི་དང་པོར་བསྒྲིགས།",
    "ལོའི་ཟླ་པར་པར་ཐེངས་གཉིས་པོ་དཔར།",
    "པའི་དཀར་ཆག་བཞུགས་སོ།",
    "གྲུབ་བརྙེས་བརྒྱད་ཅུ་རྩ་བཞི་ལ་ཡན་ལག་བདུན་པ་འབུལ་བ་ཚོགས་ཟུང་རྒྱ་མཚོ་འཕེལ་བའི་ཟླ་འོད་ཅེས་བྱ་བ་བཞུགས་སོ།",
    "འཛམ་གླིང་ཐུབ་པའི་རྒྱལ་ཚབ་ཆེན་པོ་རྡོ་རྗེ་འཆང་ཀུན་དགའ་བཟང་པོ་ལ་བསྟོད་ཅིང་གསོལ་བ་འདེབས་པ་སྙན་ངག་ཆུ་གཏེར་བསྐྱོད་པའི་རླབས་ཕྲེང་ཞེས་བྱ་བ་བཞུགས།",
    "མཁས་བཙུན་གྲུབ་པ་ནམ་མཁའ་དཔལ་བཟང་ལ་བསྟོད་པ་དགེ་ལེགས་དབྱར་དུས་འགུགས་པའི་ཕོ་ཉ་བཞུགས།",
    "སྐྱབས་མཆོག་རྣམ་པ་གཉིས་ལ་བསྟོད་པ་འདོད་དོན་ཀུན་འགྲུབ་ཅེས་བྱ་བ་བཞུགས་སོ།",
    "རྡོ་རྗེ་འཛིན་པ་ཀུན་དགའ་རྣམ་རྒྱལ་ལ་བསྔགས་པ་དད་པའི་ཆུ་འཕེལ་ཟླ་བ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "བསྟོད་ཀྱིན་གསོལ་བ་འདེབས་པ་ཐུགས་རྗེར་བསྐུལ་བའི་རྒྱང་གླུ་ཞེས་བྱ་བ་བཞུགས།",
    "ཉེར་ལྔ་པ་ཁྱད་པར་བརྗོད་པ་ལས་ཡོན་ཏན་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "རྡོ་རྗེ་གུར་རིགས་བསྡུས་དཀྱིལ་འཁོར་ཆོ་གའི་མདུན་བསྐྱེད་ཀྱི་ངག་འདོན་གྱི་གསལ་བྱེད་ཅེས་བྱ་བ་བཞུགས་སོ།",
    "དཔལ་དུས་ཀྱི་འཁོར་ལོའི་དཀྱིལ་འཁོར་གྱི་ས་གཟུང་བའི་ཆོ་ག་ཉུང་ངུ་དོན་ཚང་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "གུ་རུ་དྲག་པོ་མངའ་བདག་ལུགས་ཀྱི་ལས་བྱང་པདྨ་རཱ་གའི་མགུལ་རྒྱན་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "གུ་རུ་དྲག་དམར་གྱི་བསྙེན་པ་བྱ་ཚུལ་གྱི་ཡི་གེ་ཉུང་ངུ་དོན་འདུས་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ཡལ་འདབ་ཇི་སྙེད་འཁྲུངས་པར་གྱུར་པའི་གྲངས་དེ་སྙེད།",
    "གཉེན་གྱི་བུ་ཡིས་བསླབ་ལྟར་ཟས་གཙང་སྲས།",
    "བཞུགས་གནས་པདྨར་གྱུར་པའི་ཁྲིར་བཞུགས་ཚེ།",
    "དེ་བཞིན་གཤེགས་པས་བུ་གཅིག་བསྒྲིབས་བྱས་པའི།",
    "གསལ་ལྡན་གྲོང་དུ་བབས་པར་ཨུཏྤ་ལས།",
    "གཉེན་པོས་ཕམ་བྱས་རྒྱལ་བྱེད་ཚལ་དེ་བཟུང་།",
    "ཟས་གཙང་ཕོ་ཉ་རིམ་བཏང་རབ་བྱུང་མཐར།",
    "མྱོས་པའི་གསོད་བྱེད་། བཀྱེ་བ་ཀུན་མཁྱེན་གྱི།",
    "ཉམ་ངའི་གཡང་དུ་བསྐྱར་ཡང་མ་ནོངས་པར།",
    "རྒྱལ་སྲིད་ཐོབ་པ་ཁྱད་པར་ལོ་མར་གྲགས།",
    "བྲོས་པར་མི་འཇིགས་མཆོག་སྦྱིན་སྟོན་མཆོག་ལ།",
    "སྐྱབས་སུ་འགྲོ་བྱས་དགའ་བོ་ཉེར་དགའ་བཏུལ།",
    "བཅོ་བརྒྱད་མགོ་བོ་གདེངས་པས་སྟོན་པར་གུས།",
    "རྒྱལ་ཐབས་སྤངས་ནས་དངོས་མཇལ་ལེགས་གསུངས་ཀྱིས།",
    "བདོག་དགུ་སྦྱིན་པར་བསྟབས་ནས་རབ་ཏུ་བྱུང་།",
    "ཡུལ་རྐྱེན་ལ་བརྟེན་དགྲ་བཅོམ་མཁས་པར་གྲགས།",
    "སློང་རྣམས་ཚིམ་བྱས་སྟོན་པའི་ལེགས་གསུངས་མནོས།",
    "སྔོན་ཡང་བྱས་མི་ཤེས་དུས་རབ་གཙོས་ཀྱང་།",
    "རྣམ་འདྲེན་གཟུགས་སྐུའི་མཁའ་དཀྱིལ་དྭངས་པར་ཡང་།",
    "རང་ལུས་ཤ་ཚོགས་ཟད་པར་སྲོང་བཅལ་ཡང་།",
    "འཚོབ་པར་མ་ནུས་ལུས་རྫོགས་གཞལ་བའི་སེམས།",
    "ལེགས་གསུངས་ཐོས་པའི་སྐལ་བཟང་ལྷ་དང་མིར།",
    "སྐྱབས་ཀྱི་དམ་པར་ལེགས་བཟུང་ཆུ་གཏེར་ཀློང་།",
    "གཙང་མའི་ཞལ་ཟས་ཀྱིས་བསྟབས་འབྱོར་ལྡན་དུ།",
    "གསོད་པར་བཏང་བས་ཉ་པའི་ཁྱིམ་ནང་དུ།",
    "རྒྱལ་བསྟན་རྣམ་པར་རྒྱས་མཛད་ཤ་ནའི་གོས།",
    "བདེ་གཤེགས་རྣམ་པར་སྤྲུལ་བཅུག་ཉེ་སྦས་སོ།",
    "ཕྲག་པར་བཀོད་དེ་བཅལ་བ་ཀླུར་སྤྲིངས་ཡིག།",
    "མགོ་མཇུག་ཁྱབ་པར་རྨ་སྐྱེས་སྲིན་བུའི་ཚོགས།",
    "བདེན་མཐོང་རྣམ་པར་གྲོལ་བཀི་ནེ་ཡ།",
    "བཅོམ་ལྡན་མེ་ཁམས་སྙོམས་ཞུགས་སད་བྱས་ཏེ་། འཆི་འཕོའི་མཚན་ཉིད་ཀྱིས་སྐྱག་སྐབས་གསུམ་བདག།",
    "ཕན་མཛད་རྒྱལ་བའི་སྣང་བས་གཙང་བྱས་ཏེ།",
    "དེ་སྐད་མཁྱེན་བརྩེའི་འཁོར་ལོ་སྔོན་འགྲོ་མའི།",
    "འཕགས་དང་སོ་སྐྱེའི་ལེགས་བྱས་ཁ་བའི་རྡུལ།",
    "རྒྱལ་བའི་ཐུགས་རྗེས་བྱིན་གྱིས་བརླབས་ཀྱི་འབབ་སྟེགས་བྱས།",
    "བལ་ཡུལ་མཆོད་རྟེན་ཉེ་འདབས་ནས་རྒྱལ་ཡོངས་ས་ཆེན་ཞེས་པ་ལས་གྲྭ་གུ་རུས་ཕྱི་ལོ་༢༥ ལོར་པར་བསྐྲུན་ཞུས།་ ། དཱིགཎཡུགཎཎབཝནྟནྡནཱམསིདྡྷམྤཔཱཏུརཱཤིཏིས་ངྒབྷོཀཏེབིཛཧཱརམ། ། གྲུབ་བརྙེས་བརྒྱད་ཅུ་རྩ་བཞི་ལ་ཡན་ལག་བདུན་པ་འབུལ་བ་ཚོགས་ཟུང་རྒྱ་མཚོ་འཕེལ་བའི་ཟླ་འོད་ཅེས་བྱ་བ་བཞུགས་སོ།",
    "སྣང་བྱས་རྣམས་ཀྱི་བཀའ་དྲིན་མཐའ།",
    "ཐམས་ཅད་། མཁྱེན་པའི་བཀའ།",
    "དགྱེས་པར་སྐྱེད་པའི་ཡོན་དུ་འབུལ།",
    "སྡིག་ལྟུང་འདམ་དུ་བསྐྱར་བྱས་པ།",
    "ལེགས་བྱས་ཟླ་འོད་སྤྲོས་པའི་རྗེས།",
    "རྟག་པར་བྱ་བའི་རང་བཞིན་བརྗོད་པ།",
    "མྱ་ངན་མི་འདའ་བཞུགས་པར་གསོལ།",
    "གཡོ་སྒྱུའི་འཕྲུལ་ལ་མ་ཆགས་པར།",
    "ཐམས་ཅད་མཁྱེན་རབ་རྟོག་པའི་རྒྱུ་ཡི་གཙོ།",
    "ཟུང་འཇུག་རྒྱལ་ས་ཟིན་པར་ཤོག།",
    "ཕྱོགས་བཅུའི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཀུན་གྱི།",
    "ཞེས་གསུངས།",
    "གནས་ཁང་གཙང་ཞིང་རྒྱན་གྱིས་བརྒྱན་པར།",
    "གང་ཞིག་སྐྱབས་སུ་ངེས་པར་བསྟེན་ཙམ་གྱིས།",
    "ཞིང་ཀུན་ཁྱབ་པར་ལྡང་བ་བདུག་པའི་སྤྲིན།",
    "སྟོབ་པར་འོས་པའི་ཞལ་ཟས་རི་བོའི་ཕྲེང་། དབྱངས་བདུན་སྐད་ཀྱི་འགྱུར་བ་གླུར་འཇོ་བའི།",
    "ཡོན་གནས་མཆོག་ལ་འབུལ་གྱིས་བཞེས་སུ་གསོལ།",
    "བདག་ཅག་ཁྱེད་ཀྱི་འབངས་སུ་འབུལ་ལགས་ན།",
    "དགྱེས་པའི་ཕྲིན་ལས་གང་ཡིན་བསྒྲུབ་པར་གནང་།",
    "འགྲོ་འདི་ལྡོངས་པར་འགོད་ན་མི་རུང་ཞེས།",
    "དེང་འདིར་ཐབས་མཁས་སྒྱུ་འཕྲུལ་རྣམ་པར་རོལ།",
    "རྒྱུན་ཆད་མེད་པར་རྟག་ཏུ་སྡུག་བསྔལ་བའི།",
    "ཚེ་འདིའི་ཕུན་ཚོགས་སྒྲུབ་ལ་མ་ཆགས་པར།",
    "བླང་དོར་ཚུལ་བཞིན་ནུས་པར་བྱིན་གྱིས་རློབས།",
    "སྒྲོལ་འདོད་སྨོན་སེམས་འབྱོངས་པར་བྱིན་གྱིས་རློབས།",
