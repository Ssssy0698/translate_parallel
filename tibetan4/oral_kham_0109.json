    "ཁོང་རང་སླར་ལོག་དགོས་པ་བྱུང་།",
    "དེ་དུས་ཙ་ན་བོད་ཀྱི་བློན་ཆེན་མགར་སྟོང་བཙན་དེ་གྲོངས།",
    "ཡང་རང་སྒེར་གཅེས་འཛིན་དང་བག་འཁུམ་གྱི་ལྟ་བ།",
    "ད་ལྟའང་འཛམ་གླིང་རང་བཞིན་གྱི་ཡུལ་སྐོར་བ་ཞིག་ཏུ་བརྫུས་ནས་ཡོད།",
    "པར་མངོན་ལ་ཚན་རིག་རང་བཞིན་གྱི་གཏམ་རྒྱུད་ཀྱང་གང་མང་ཞིག་བཞག་སྐད་འདུག་དགུང་ལོ་ཉེར་བཞི་བར་བླ་བྲང་ནས་ལམ་ལ་ཆས་ཏེ་ཕ་ཡུལ་དུ་ཡུད་ཙམ་བསྡད་རྗེས་སྐུ་འབུམ་དང་མཚོ་སྔོན་པོ།",
    "ག་དུས་ཤི་ཡང་མི་འགྱོད་དེ།",
    "འདི་ནི་སྙན་ངག་སྤྱི་དོན་གྱི་ནང་དུ་བཀོད་འདུག་པ་དེ་ཡིན་ལ།",
    "ཞེས་གསུངས་པ་ལྟར་དབུས་གཙང་གཉིས་བོད་ཆེན་པོ་མིན་ན་བསམ་ཡས་ཀྱང་བོད་ཆེན་པོར་འཇོག་ཐབས་མེད་པས་འབྲོམ་སྟོན་པའི་གསུང་དེ་ལ་ལན་ཅི་ཞིག་འདེབས་བསམ་དགོས་པར་འདུག་གོ།",
    "བོ་རོ་ཙ་ན་ནམ་མཁའ་དག་དང་མཉམ།",
    "བོད་ཀྱི་ཆབ་འབངས་སུ་ཡོད་པ་གོར་མ་ཆག་ཅེས་གསུངས་འདུག་པ་དེའོ།",
    "གླེགས་བམ་སོགས་ཀྱང་འདུག་སྐད་ནི་གཅིག་ལ་གཅིག་ག་དང་།",
    "ད་ལྟ་རྡོ་རིང་ངོ་བཤུས་ཀྱི་ཡི་གེ་དཔར་དུའང་བཀོད་འདུག་གོ།",
    "གཞན་གྱིས་སྒྲ་ཇི་བཞིན་མ་ཐོན་པར་ཟུར་ཆག་པའི་མིང་སོགས་སྣ་ཚོགས་ཤིག་འདུག་པ་ལས།",
    "བོད་ཀྱི་གདོད་མའི་དུས་ཀྱི་མིང་ཕལ་ཆེར་ནི་འདོད་རྒྱལ་རང་དུ་འདུག་ཅིང་།",
    "བློན་པོ་མཛངས་མི་མི་བདུན་གྱི་ལྔ་བ་སྟེ་སྲོང་བཙན་སྒམ་པོའི་བློན་པོ་ཉང་ཁྲི་བཟང་ཡང་ང་སྟོན་སོགས་རུས་རྒྱུད་དེ་གཉིས་ལས་མཁས་པ་དང་བློན་པོ་མང་དུ་བྱུང་འདུག་སྐབས་འགར་ཉང་ལ་མྱང་ཞེས་བྲིས་པའང་ཡོད་དེ།",
    "ཞང་ཞེས་པའི་ཐ་སྙད་འདི་ནི་ཕྱིས་སུ་བོད་ཀྱིས་སྦྱར་བའི་ཐ་སྙད་ཅིག་ཡིན་ལས་ཆེ་ཞེས་སོགས་མང་དུ་བརྗོད་འདུག་སྟེ་བདེན་མིན་དཔྱོད་ལྡན་རྣམས་ཀྱིས་དལ་བུར་དཔྱད་པར་མཛོད།",
    "དེའི་སྟེང་དུ་སུམ་པའི་རུ་བསྣན་ན་དེ་དུས་རུ་ཆེན་ལྔ་ཡོད་འདུག་གོ།",
    "ཁོ་རང་རིན་སྤུངས་པའི་གཉེན་ཚན་ཏུ་གཏོགས་ཤིང་དེའི་ཞབས་འབྲིང་དང་ཆིབས་དཔོན།",
    "དབུས་གཙང་དུ་ལྷ་བ་རྣམས་ཀྱིས་གྱོན་རྒྱུ་བཙན་ཞུ་བྱ་བའི་ཞྭ་ཁུག་མའི་དབྱིབས་སམ་མདའ་ཤུབས་ལྟ་བུའི་རིང་བོ་ཞིག་འདུག་ཅེས་གསུངས་ཏེ།",
    "བླུན་འཆར་གྱི་རྫུན་ཡང་མང་དུ་བསྲེས་པས་ཡི་གར་འོང་བ་ཞིག་མི་འདུག་ཅེས་གསུངས་པ་ཆེས་ཆེར་དོན་ལ་གནས་ཤིང་།",
    "ཞེས་གསུངས་འདུག་པ་ལྟར་རོ།",
    "དེའི་མཐའ་སྐོར་དུ་ས་ངཀར་གསོལ་བའི་མཆོད་རྟེན་བརྒྱུད་ཀྱིས་བསྐོར་བ་སོགས་ངོ་མཚར་ངརྗོད་ལས་འདས་པ་ཞིག་ཡོད་འདུག་གོ།",
    "༡༢༩ ཨོ་ཏན་ཏ་པུ་རི་འདི་ནི་རྒྱ་གར་གྱི་གནས་མཆོག་ཅིག་ཡིན་ལ་དེར་ཡུལ་གྱི་སྒོ་ནས་བཏགས་པའི་གཙུག་ལག་ཁང་ཨོ་ཏན་ཏ་པུ་རི་ཞེས་པ་ཞིག་ཀྱང་ཡོད་འདུག་ཨོ་ཏན་ཏ་ནི་འཕུར་བྱེད་དང་།",
    "ས་འདི་ཡིན་ཟེར་བཙམ་ལས་གནས་ཀྱི་ཤུལ་ལ་སོགས་པ་ནི་མི་འདུག་རི་འདི་ནི་ནཱ་རོ་བའི་བཞུགས་གནས་ཕུ་ལ་རི་བྱ་བ་དེ་ཡིན་པར་ཐེ་ཚོམ་མི་འདུག་སྟེ།",
    "འགྲོམ་གྱི་རི་གཉིས་ཁོ་ན་ལས་མི་འདུག་པར་གསུངས་ལ།",
    "ཞེས་གསུངས་པ་ནི་ཧ་ཅང་བདེན་པའི་གསུང་དུ་འདུག་གོ་སྙམ།",
    "ཅེས་ཞིབ་རྒྱུས་སུ་བཀོད་འདུག་པ་ལྟར་རོ།",
    "དར་རྒྱས་ཆེ་བ་མ་བྱུང་འདུགཅེས་གསུངས།",
    "པོས་དབུས་གཙང་རུ་བཞི་རུ་བགོས་ཚེ་དྭགས་པོ་འདི་གཡས་རུ་དང་རུ་ལག་གཉིས་སུ་གཏོགས་པར་བྱས་འདུག་བར་སྐབས་ཤིག་ལ་དྭགས་པོ་དེ།",
    "ཡོད་འདུག་འཕགས་པ་ཐུགས་རྗེ་ཆེན་པོ་བསམ་བཞིན་དུ་རྒྱལ་བོའི་རྣམ་པར་བྱོན་པ་ཁོང་སྐུ་གཞོན་ནུའི་དུས་ནས།",
    "རྗེ་བཙུན་ལུང་བཙན་སོགས་འབྲི་ཚུལ་སྣ་ཚོགས་ཤིག་འདུག་གོ།",
    "ཀོང་ཇོ་བརྫངས་ནས་ལོ་དགུ་ཙ་ན་བཙན་པོ་འདས་ཚུལ་དང་འདི་གཉིས་སྦྱར་ཚེ།",
    "ཀོང་ཇོ་བརྫངས་ནས་ལོ་དགུ་ཙ་ན་བཙན་པོ་འདས་ཚུལ་དང་འདི་གཉིས་སྦྱར་ཚེ།",
    "འོག་ཏུའང་ལྕགས་ཁྱི་ལོར་འདས་པ་དེ་རང་ལུགས་འཐད་ལྡན་དུ་བཟུང་བ་རྣམས་ལ་ནང་འགལ་བྱུང་བ་མངོན་སུམ་ཡིན་པས་དོན་དམ་སྲོང་བཙན་སྒམ་པོའི་འདས་ལོ་གང་ལ་བྱེད་པ་ད་དུང་དཔྱད་གཞིར་ལུས་འདུག་གོ་སྙམ།",
    "ཞེས་གསལ་བོར་གསུངས་འདུག་གོ།",
    "ཚོར་བ་མྱུར་ལ་དཀྱེལ་ཀྱང་ཆེ་ཞེས་པའི་དོན་དུའགྲེལ་འདུག་སྟེ་སྐབས་དོན་དང་ཤིན་ཏུ་འབྱོར་བར་སྙམ།",
    "གཟུར་བོར་གནས་པ་ཞིག་ཡིན་ཚེ་དེ་དག་ནི་ཕྱིས་སུ་བོད་ཡིག་ལ་བལྟས་ཏེ་བཟོས་འདུག་ཅེས་མི་བརྗོད་ཐབས་མེད་དུ་གྱུར་ཡོད་དོ།",
    "ཐུག་འདུག་པ་མ་ཡིན་ནམ།",
    "དེ་དུས་ཙ་ན་གུཔྟའི་ཡི་གེ་དང་ཁྱད་མེད་ལྟ་བུ་ཡིན་ཚོད་འདུག་ཅེས་དང་།",
    "༢༨༨ ལྷ་སའི་གཙུག་ལག་ཁང་འདི་བི་ཀྲ་མ་ཤི་ལའི་ལྷ་ཁང་ལ་དཔེ་བྱས་ནས་བཞེངས་སོ་བི་ཀྲ་མི་ལ་ཤི་ལ་རྒྱ་གར་གྱི་ཆེས་གནའ་བོའི་ནང་བའི་གཙུག་ལག་ཁང་བཞེངས་རྩལ་སོགས་ཆེས་ངོ་མཚར་བ་ཞིག་ཡིན་འདུག་སྟེ།",
    "དེར་གྲོང་དང་ཉེ་བའི་གང་གཱའི་ཆུ་དཀྱིལ་ན་བྲག་རི་ལྷ་ཁང་ཅན་ཞིག་ཡོད་པའི་ཚུ་རོལ་གྱི་ཆུ་འགྲམ་ན་བྲག་རི་ཆུང་ཆུང་ཞིག་ཡོད་པ་དེ་བི་ཀྲ་མ་ལ་ཤི་ལའི་དགོན་ཤུལ་ཡིན་འདུག་ཀྱང་།",
    "དེས་ན་པཱ་ལའི་རྒྱལ་རྒྱུད་དེ་དག་དང་ལོ་བརྒྱ་ཕྲག་གཅིག་ཙམ་གྱིས་སྔ་བར་འདུག་པས་ལྷ་སའི་གཙུག་ལག་ཁང་རྒྱ་གར་གྱི་ལྷ་ཁང་བཞེངས་སྟངས་ཤིག་ལ་དཔེ་བླངས་ཡོད་སྲིད་ཀྱང་དེ་བི་ཀྲ་མ་ལ་ཤཱི་ལའི་ལྷ་ཁང་ཡིན་མིན་ད་དུང་དཔྱད་པའི་གནས་སོ།",
    "རྒྱ་བཟའི་སྐུ་དམར་གདུང་ཡིན་ཟེར་བ་ཞིག་ནི་ཕ་བོང་ཁའི་རི་ཁྲོད་དུ་མཇལ་རྒྱུ་འདུག་ཅེས་བོད་ཀྱི་སྲིད་དོན་རྒྱལ་རབས་ལས་གསུངས་སོ།",
    "སེ་རིབ་ཀྱི་རྒྱལ་བོ་ཞིག་ཀྱང་ས་བྱ་སྟེ་སྤྱི་ལོ་༧༩ལོར་གསོན་བཟུང་བྱས་པ་སོགས་བྱས་རྗེས་ཤིན་ཏུ་ཆེ་བ་ཞིག་ཡིན་འདུག་གོ།",
    "དཔུང་ཉམས་རྒུད་འགྲོ་བའི་སྣ་འདྲེན་གཙོ་བོ་ཞིག་ཏུ་གྱུར་ཡོད་ཚོད་འདུག་སྟེ།",
    "ཁོའི་བློས་ཐུབ་བརྒྱར་ཉེ་བའང་རང་སྲོག་བཅད་ནས་ཤི།",
    "དེས་ན་མང་སྲོང་རང་ལོ་བཞི་བའི་སྐབས་ཁྲི་ལ་འཁོད་ནས་དགུང་ལོ་ཉེར་བདུན་པ་མེ་བྱིའི་ལོ་ལ་འདས་པ་ཡིན་ནམ་སྙམ་ཞེས་ཁྲི་དངོས་ལོ་ཉེར་བཞི་ལས་མ་བསྐྱངས་ཤིང་།",
    "ཐང་ཡིག་གསར་རྙིང་དུ་ཞན་ཆིན་ཁྲི་ལོ་དང་བོ་དང་གཉིས་པ་ཞེས་བྲིས་འདུག་པའི་སྒྲ་གདངས་ཀྱི་འགྱུར་ཁྱད་ཙམ་ལས་ཞན་ཙིང་དང་དོན་གཅིག་པར་བཤད།",
    "རྒྱུའི་ཡི་གེར་ཞེས་བྲིས་ཡོད་འདུག་གོ།",
    "མགར་གྱི་བུ་རྣམས་ཀྱི་མཚན་ལ་འབྲི་ཚུལ་སྣ་ཚོགས་ཤིག་འདུག་ལ།",
    "མགར་གྱི་མི་རྒྱུད་ཀྱིས་དམག་དཔོན་བྱས་ཏེ་ལོ་མང་བོར་དམག་བརྒྱབ་པས་བོད་ལ་བལྟས་ན་རྒྱ་ནག་ལ་སྐད་གྲགས་ཆེ་བ་ལྟ་བུར་འདུག་ཅིང་།",
    "འདི་དུས་ཀྱི་དམག་དཔོན་ནི་མགར་བཙན་གཉན་ལྡེམ་བུ་ཡིན་འདུག་ལ།",
    "ཐང་ཡིག་རྙིང་མ་བོད་འགྱུར་མར་མཚོ་ནག་ཅེས་བསྒྱུར་འདུག་པས་སྔར་རྒྱ་བོད་གཉིས་ཀས་ཡང་ཡང་དམག་བརྒྱབ་ཅིང་སྲོང་བཙན་དང་རྒྱ་བཟའ་མཇལ་འཕྲད་བྱེད་སའི་མཚོ་དེ་ཡིན་ནམ་སྙམ།",
    "སྐབས་དོན་གཅིག་ལ་གཅིག་འབྲེལ་དུ་ཆུ་དང་ཆབ་རོམ་གྱི་རྣམ་པས་དབྱེར་མེད་དུ་བསྟན་འདུག་སྟེ།",
    "ཡང་ན་མ་ཕྱི་གཅིག་ལས་གཞན་བསྡུར་ཡ་མ་རྙེད་པའི་རིགས་ཀྱང་འགའ་ཤས་འདུག་སྟེ།",
    "གན་རྐྱལ་འདུག་པའི་ལྟོ་བའི་སྟེང་།",
    "སྲས་སྟོང་རང་བྱུང་དག་ཏུ་འཁྲུངས།",
    "ཞེས་པའི་ཚིག་ཀྱང་བརྗོད་དེ་འདུག།",
    "རྡོ་ཤིང་རང་འགྱུར་བོན།",
    "ཞེ་སྡང་རང་རྒྱུད་བསྲེགས་པས་སེང་གེ་མཚོར་མཆོང་བཞིན།",
    "སོ་སོར་རང་རང་རིགས་སྐྱེ་ཟེར།",
    "སྤྱོད་པ་ཉལ་འདུག་འགྲོ་འཆག་ཤེས་པར་བྱ།",
    "དར་ཞིང་རྒྱས་པར་གྱུར་ཅིག་དུས་གསུམ་བདེར་གཤེགས་བཀའ།",
    "བདག་དགུང་ལོ་གསུམ་ལ་སྐུ་འཆག་དུས།",
    "རང་རང་ཡུལ་དུ་སྐད་རིགས་སོ་སོར་བསྒྱུར།",
    "གཉིས་ཀའི་རྒྱུན་ཡུན་དུ་འདུག་པའི་ཕྱིར་ན།",
    "ཡན་ལག་རུས་སུལ་ཀུན་ཀྱང་རང་བཞིན་དོད།",
    "ཕྱི་ན་འདུག་པའི་འབུ་རྣམས་ལ།",
    "སྐྲ་ཡོ་བྲེག་དུས་དེའི་ཧོས་རུའམ་སྐུ་གང་ཡོད་པ་དེ་ལ་ཡིད་དམ་དུ་བཟུང་ལ།",
    "སྤྱི་བོ་ཧར་བར་འདུག་པ་ཅིའི་དོན་ན།",
    "ལེའུ་ཉེར་གཅིག་པ་ཆ་ཚང་ཆད་འདུག་ལེའུ་ཉེར་གཉིས་པ།",
    "བག་སྒྲིབ་ཀྱང་རང་ལ་འདུས་ཏེ་འོང་ངོ།",
    "སྐད་ཅིག་མ་ལ་ཐུགས་སུ་ཆུད་པ་ཞིག་འདུག་སྟེ།",
    "རྩི་ཤིང་དང་ནགས་ཚལ་དུ་སྐྱེས་ནས་གདའོ།",
    "ང་རང་ཤི་ན་རུང་ངོ་ཟེར་ནས།",
    "བར་འདི་ན་ལྟོ་སྐྱ་ཞིག་གདའ་སྟེ།",
    "ལུས་འདི་ན་འདུག་སྟེ།",
    "ཞབས་པད་མར་འདུག་པ་ནི།",
    "ལེའུ་ཉེར་དྲུག་པ་འདིའི་མཇུག་ཆ་ཚང་མི་འདུག་ལེའུ་ཉེར་བདུན་པ།",
    "གཤེན་རབ་ཞལ་འཛུམ་ལོག་ནས་གདའ་བ་ཇུ་ཙུག་ལགས།",
    "མྱ་ངན་ནག་པོའི་ཁང་པ་ན་འདུག་གོ།",
    "བདེ་བར་གཤེགས་པའི་གནས་སུ་འདུག་ཁྲུས་ཀྱི་རྒྱ་མཚོ་གླིང་དགུའི་ཆུས།",
    "དགེ་སྤྱོད་ཅན་གྱི་ཡུལ་དུ་འདུག་རི་བལྟས་སྤོས་རི་ངད་ལྡན་རི།",
    "བདུད་རྩི་གྲུབ་པའི་ཡུལ་དུ་འདུག་རྩྭ་ནི་ཐམས་ཅད་འདྲེས་པ་ཅན།",
    "དགེ་སྤྱོད་ཅན་གྱི་ཡུལ་དུ་འདུག་རྩེ་དྲུག་དཀར་པོ་ཟངས་ཟེ་ཟངས་དང་ལྡན།",
    "བརྣག་པ་ཐམས་ཅད་མི་འདུག་གནས།",
    "ཡུལ་འཁོར་འདི་རུ་མ་འདུག་པར།",
    "ཁྲག་རྣག་མཚོ་ལ་འདུག་པ་ནི།",
    "ཡི་དྭགས་བཀྲེས་སྐོམ་ལུས་སུ་འདུག་དེ་ནས་དགུང་ལོ་གསུམ་ནས།",
    "ད་རུང་འཆི་དུས་མི་གདའ་ན།",
    "ལུས་ལ་འདིའི་མཇུག་མ་དཔེ་ན་མི་འདུག་པས་འགོད་ཐབས་མ་བྱུང་།",
    "དབྱར་གྱི་རྩི་ཐོག་བཞིན་རྒྱས་པ་ཞིག་གདའ་འོ།",
    "ངང་དང་རང་བཞིན་ཡེ་ཤེས་ཐུགས་ཀྱི་གཏེར།",
    "བདེན་པ་ཉོན་ལ་རང་རང་གནས་སུ་དེངས།",
    "གལ་ཏེ་མི་འགྲོ་གནས་འདིར་འདུག་གྱུར་ན།",
    "རང་རང་ཀུན་ལ་གནས་པ་ཡིན།",
    "བསྐལ་བར་བགྲང་ཞིང་ཕྱི་མཐར་འདུག།",
    "བསྐལ་པའི་བར་དུ་འདུག་པ་ཡིན།",
