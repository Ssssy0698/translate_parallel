    "ལུས་ཅན་རྣམས་ལ་གནོད་བྱས་ན་སྟེ།",
    "ངེས་པར་བྱུང་བ་ན་འདི་ལས་གཞན་གནོད་པའི་རྒྱུ་ནི་མེད་དོ།",
    "དེ་བས་ན་རིགས་པ་འདི་ཡིས་དེ་དག་སྟེ་བརྗོད་མ་ཐག་པའི་གནོད་པའི་ངོ་བོ་ཉིད་བཟོད་པར་གྱིས་སྲན་པར་གྱིས་ཤིག་པའོ།",
    "ལ་ལ་རྨོངས་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་ནི་གནོད་པ་བྱས་པས་དེ་ལ་ཁྲོ་བར་གྱུར་ན་སྟེ་འཚིག་པར་འགྱུར་ནའོ།",
    "རྨོངས་པས་ནི་རྣམ་པར་རྨོངས་ནས་ཏེ།",
    "འཁྱལ་པ་ལ་སོགས་པ་བརྩོན་པར་བྱེད་པའོ།",
    "གལ་ཏེ་དེ་ལྟ་ཡིན་ན་ཡང་ཕྱིར་བཅོས་པར་རིག་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "ཐམས་ཅད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་མཐོང་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕངས་པའི་དངོས་པོ་འཇོམས་པར་བྱེད་པ་ལ་གནོད་པའི་སེམས་ལས་བཟློག་པར་བྱ་བའི་ཆེད་དུ་འཇིག་རྟེན་པའི་དཔེ་བརྗོད་པས་ཞེ་སྡང་ལས་ལྡོག་པར་བྱའོ་ཞེས་ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱིས་བསྟན་པ།",
    "དཔེར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དཔེར་ན་ཁྱིམ་གཅིག་ན་མེས་ཚིག་པར་གྱུར་པ་ན།",
    "དེ་ནི་ཕྱུང་སྟེ་དོར་བར་རིགས་ཏེ་སོ་སོར་བྱས་ཏེ་བསྩལ་བར་བྱའོ།",
    "དེ་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེ་སྡང་མེ་ནི་ཁོང་ཁྲོ་བའི་མེ་ཡིན་ལ་མཆེད་པར་གྱུར་པ་ནི་ཡོངས་སུ་གདུང་བར་བྱེད་པ་སྟེ།",
    "དེ་ནི་བསྟན་པའི་རིམ་པས་ཚིག་པར་ཏེ་ཡོངས་སུ་ཟད་པར་མ་གྱུར་ཅིག་ཅེས་པས་སོ།",
    "བསད་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "འདིར་ད་ལྟའི་སྡུག་བསྔལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཟོད་པ་ལས་ནི་དེ་ལ་དོན་ཆེན་པོ་རྙེད་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱིས་བསླབ་པར་བྱ་བའི་ཕྱིར།",
    "ཁྲོ་བའི་དོན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བས་ན་ད་དུང་ཡང་དེ་བཞིན་དུ་བདག་མི་བཟོད་པ་བྱ་བར་རིགས་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་པ།",
    "གཞན་གྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བས་ན་བདག་ནི་བདེ་བ་ཐམས་ཅད་ལས་ཕྱིར་ཕྱོགས་པ་ཡིན་པའི་ཕྱིར་འདི་ཡང་ལེན་པར་མི་བྱེད་དེ།",
    "བདེ་བར་རྣམ་པར་རྨོངས་པའི་ཡིད།",
    "ཞེས་འཆད་པར་འགྱུར་བ་ཡིན་ནོ་ཞེ་ན།",
    "གཞན་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བས་ན་མཐོང་བ་ནི་ཚེ་འདིའི་འབྲས་བུ་དང་མ་མཐོང་བ་ནི་འཇིག་རྟེན་ཕ་རོལ་གྱི་སྟེ་གཞན་གྱི་བདེ་བ་ཕུན་སུམ་ཚོགས་པ་ལ་མི་བཟོད་པའི་གཉི་ག་ཉམས་པར་འགྱུར་རོ།",
    "སྟོད་པར་བྱེད་པ་པོའི་བདེ་བ་མི་བཟོད་པ་ནི་མ་ཡིན་ནོ།",
    "འཇིག་རྟེན་གསུམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འཇིག་རྟེན་གསུམ་མཆོད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྗེད་པར་བྱ་བའོ།",
    "ཐོབ་པར་གྱུར་ནས་དགའ་བར་མི་འགྱུར་རམ་ཞེས་ཟུར་གྱིས་འདྲི་བའོ།",
    "དེ་ཅི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་སྟེ་རྙེད་པར་འགྱུར་བ་ཡང་དེ་དག་ལས་མི་བླང་བར་བྱ་བའམདྷི།",
    "གང་འདོད་པ་བཙལ་ཏེ་མ་རྙེད་པ་དེ་ཡང་སྡུག་བསྔལ་བའོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་འཆད་པར་འགྱུར་བའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་འཆད་པར་འགྱུར་བའི་ཕྱིར།",
    "ཇི་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ཡང་ཕ་རོལ་སྡུག་བསྔལ་བ་ལ་དགའ་བ་དེ་གལ་ཏེ་འཚེངས་པར་དང་དགོས་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཅི་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ཏེ།",
    "དེ་ལྟ་བས་ན་འདི་ལ་འདོད་པར་མི་བྱའོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "བསྟོད་དང་གྲགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་ངེས་པར་གཟུང་བར་མི་རིགས་སོ་ཞེ་ཕྱིན།",
    "འདིར་རྒྱན་སོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བས་ན་ཡིད་བདེ་བའི་རྒྱུས་བསྟོད་པ་ལ་སོགས་པ་བྱིས་པའི་སྐྱེ་བོ་དགའ་བར་བྱས་པ་ནི་བླང་བར་བྱ་བ་ཉིད་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་བསྟོད་པ་ལ་སོགས་པ་ནི་བྱིས་པ་སྐྱེ་བོའི་ཚིག་ཡིན་ནོ་ཞེས་གྲགས་པའི་དོན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མིག་གདངས་པའི་བཞིན་གྱིས་གྲགས་པ་དོན་དུ་གཉེར་བས་གླང་པོ་ཆེ་དང་རྟ་ལ་སོགས་པའི་ནོར་རྩྭ་བཞིན་དུ་སྦྱིན་པར་བྱེད་དོ།",
    "འདི་ལ་དོན་དམ་པར་དགོས་པ་ཅུང་ཟད་ཀྱང་མེད་དེ།",
    "གཞན་དུ་ན་ལོག་པའི་རྣམ་པར་རྟོག་པ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ།་",
    "ཚིག་འབྲུ་རྣམས་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསྟོད་པ་ལ་སོགས་པ་རྗོད་པར་བྱེད་པའི་ཡིག་འབྲུ་སྟེ་ཡི་གེ་རྣམས་ཀྱིས་ཅི་བཟའ་ཞིང་མྱུར་དུ་རུང་ངམ།",
    "བྱེ་མའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དཔེ་དེ་ཉིད་ལྟར་འདིར་ཡང་གསུངས་པ།",
    "དེ་བཞིན་ཞེས་བྱ་བ་ལ་དེ་བཞིན་དུ་བསྟོད་པ་དང་གྲགས་པ་ཉམས་ན་སྟེ་རྣམ་པར་བཅོམ་ན།",
    "ཡང་གཞན་དུ་དཔྱད་ན་འདི་ནི་བྱིས་པའི་ཚིག་ཡིན་ནོ་ཞེས་ཚིགས་སུ་བཅད་པ་བཞིན་གསུངས་པ།",
    "སྒྲ་ནི་རྗོད་པར་བྱེད་པའི་བདག་ཉིད་དེ་ཕྱི་རོལ་གྱི་དོན་ཡིན་པའི་ཕྱིར་སེམས་མེད་ཅིང་སེམས་མེད་པ་སྟེ་དེའི་དངོས་པོ་ནི་དེ་ཡིན་པའི་ཕྱིར་རོ།",
    "བདག་ལ་གཞན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གྲག་ཅེས་བྱ་བ་ནི་འདི་ཡང་དོན་མེད་པ་ཡིན་ནོ་ཞེས་མི་འདོད་པ་སྟོན་པར་བྱེད་པའོ།",
    "འབྲེལ་པ་མེད་པ་ཉིད་བསྟན་པ་གཞན་ནམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིར་བདེ་བ་ཡིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཕ་རོལ་བདེ་བས་བདེ་བ་དང་ལྡན་པར་འགྱུར་ན།",
    "དེ་ལྟ་བས་ན་དེས་ནི་ཚིག་ཙམ་ཡིན་གྱི་དོན་དམ་པ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ལ་བསྟོད་དོ་ཞེས་དེ་ལྟར་རྣམ་པར་རྟོག་པས་རང་ལ་དགའ་བ་སྐྱེ་བར་འགྱུར་ཞིང་གཞན་བདེ་བས་བདེ་བར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "གཞན་ཡང་བསྟོད་འདོད་པ་ལ་སོགས་པས་ནི་བདག་ལ་གོད་པ་ཉིད་བསྒྲུབ་པ་ཡིན་ནོ་ཞེས་ཉེ་བར་བསྟན་པ་བསྟོད་སོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཇིག་པར་བྱེད་པ་ནི་འཇོམས་པར་བྱེད་པའོ།",
    "ཁྲོ་བར་བྱེད་པ་ནི་དེ་དག་ལ་མི་བཟོད་པར་བྱེད་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་དུ་བདག་ཁོང་ཁྲོ་བའི་སེམས་སུ་མི་རིགས་སོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་བདག་ནི་གྲོལ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣམ་པར་གྲོལ་བར་འདོད་པ་ལ་ནི་རྙེད་པ་དང་བཀུར་སྟི་རྣམས་འཆིང་བ་དང་འདྲ་སྟེ།",
    "བདག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཅེས་གསུངས་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་གང་མེད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་སྐབས་སུ་བབ་པ་ལ་ཡང་སྐྱེད་པར་བྱེད་པ་དེ་ཇི་ལྟར་ན་བསྐྱེད་པར་བྱ་བའི་གེགས་སུ་བརྗོད་དོ།",
    "གེགས་ཀྱི་རྒྱུ་ཞེས་རྗོད་པར་བྱེད།",
    "རྣམ་པ་དེ་ལྟ་བུ་ལ་ཡང་དེ་ལྟར་ཐ་སྙད་དུ་བྱེད་ན་མིང་ལ་ལོག་པར་རྟོག་པར་ཟད་དོ།",
    "བསྟན་པའི་དོན་དཔེ་ཉེ་བར་བསྟན་པའི་སྒོ་ནས་གསལ་བར་བྱེད་པ་དུས་སུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཇིག་རྟེན་ན་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་སྦྱིན་པར་བྱེད་པ་ན་ཕྱིར་མི་ལྡོག་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་བས་ངལ་བས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིས་ཀྱང་གནོད་པ་བྱས་པ་ཡིན་ཏེ་གཉི་གས་བསྐྱེད་པ་ཡིན་ནོ།",
    "འདི་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་གྲོགས་བྱས་ཤིང་བསྟེན་པའི་བཟོད་པའི་འབྲས་བུ་སྟེ།",
    "གལ་ཏེ་བཟོད་བསྒྲུབ་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ལ་དེ་ལས་བཟློག་པ་སྣང་ངོ་ཞེས་གལ་ཏེ་དགྲ་འདི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བས་ན་གནོད་པ་བྱེད་པ་ཉིད་ལ་ཁོང་ཁྲོ་བའི་སེམས་བཟློག་ན་བཟོད་པ་ཡིན་ནོ་ཞེས་དེ་ཉིད་བསྟན་པ་དེ་བས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་སྐད་དུ་བསྟན་པར་འགྱུར་ཏེ་བདག་ལ་བསམ་པ་དཔྱད་པ་འདིས་དགོས་པ་ཅི་ཞིག་ཡོད།",
    "གཉི་ག་ཡང་དེ་ལ་རྒྱུ་ཉིད་ཡིན་པར་ཁྱད་མེད་དོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "བསམ་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ཡང་ཉེ་བར་མཁོ་བར་སྦྱོར་བ་ཉིད་ཀྱི་ཕྱིར་རྒྱུའི་དངོས་པོ་མཚུངས་པས་ན་ཆེ་བའི་བདག་ཉིད་མཉམ་པར་བརྗོད་དོ།",
    "དེ་ལྟར་ན་འདིར་བྱེད་པ་ལ་ཁྱད་པར་མེད་པ་ཡིན་ནོ།",
    "གང་དུ་སོ་སོར་ངེས་པའི་བདག་ཉིད་ཀྱི་ཚུལ་ལ་ནི་ཁྱད་པར་དེ་བསྟན་པའི་ཕྱིར།",
    "བྱམས་སེམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིར་མཚུངས་པར་བསྒྲུབ་པའི་ས་བོན་ནི་འདི་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བསྟན་པའི་དོན་ཉིད་གསལ་བར་བྱེད་པ་ཡོན་ཏན་མཆོག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕན་འདོགས་པ་མཐའ་ཡས་པ་མཛད་པ་རྣམས་ལ་ལན་ལྡོན་པ་ནི་དེས་ཕན་གདགས་པ་བྱས་པའི་ལན་གླེན་པ་སྟེ།",
    "དེ་ཉིད་མཆོག་ཏུ་ལན་ལྡོན་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མངོན་ཞེན་མེད་པར་རྩྭ་བཞིན་དུ་ཡོངས་སུ་འདོར་བའོ།",
    "གང་དག་བདེ་བས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་ལྟར་ན་དེ་ལ་གནོད་པ་བྱས་པས་ཐུབ་པ་རྣམས་ལ་གནོད་པ་བྱས་པར་འགྱུར་ཞེ་ན།",
    "འདིར་ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་ལྟར་སྐྱེས་བུའི་ལུས་ལ་ཀུན་ནས་ཡན་ལག་ཐམས་ཅད་ལ་ཁྱབ་པར་མེ་འབར་བ་ན་འདོད་པའི་ཡོན་ཏན་ལྔས་ཡིད་བདེ་བར་མི་འགྱུར་ཞིང་།",
    "དེ་བས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་དེ་བཞིན་དུ་ཤེས་བཞིན་དུ་མི་བགྱིད་དོ་ཞེས་སླན་ཆད་བསྡམ་པར་བགྱིའོ།",
    "བཟོད་པ་གསོལ་ནས་ད་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་མཉེས་པར་བགྱི་སླད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་ལ་བདག་ཉིད་གཅིག་པུ་གཞོལ་བར་སྟོན་པར་བྱེད་དོ།",
    "གཞན་ཡང་མ་འོངས་པའི་འཇིགས་པ་བསྟན་པས་ཀྱང་གཞན་ལ་གནོད་པ་བྱེད་པ་ལ་ཕྱིར་ཕྱོགས་པ་གོམས་པར་བྱའོ་ཞེས་དཔེ་བརྗོད་པས་གསུངས་པ།",
    "དཔེར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
