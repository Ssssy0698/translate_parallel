    "སྣང་བ་འཛིན་མེད་དུ་ལྷང་ངེ་བ་ཞིག་ཡོང་བས་དེའི་དུས་ན་རང་དང་སྣང་བ་སྣང་སྟོང་ཡུལ་མེད་དུ་ལྷང་ངེ་འདུག་ན།",
    "སེམས་ཀྱང་རང་མདངས་མ་གཏོགས་གཞན་དུ་གྲུབ་པ་ཅུང་ཟད་ཀྱང་མེད་པས་ལུས་སེམས་ཀྱང་དབྱེར་མེད་སེམས་ཁོ་ནས་བཏགས་ནས་བཞག་པ་ཙམ་དུ་ཟད་པའོ།",
    "བྱེད་མཁན་སེམས་གཅིག་པུས་བྱེད་པར་འདུག་ཅིང་གཉིས་པོ་འདིའི་ངོ་བོ་གསལ་སྟོང་རྗེན་པ་དེ་ལས་མ་འདས།",
    "སྤྱོད་ལམ་རྣམ་བཞི་ཀུན་ཏུའང་རང་ངོ་ངོས་བཟུང་ནས་ཕྱག་རྒྱ་ཆེན་པོ་དང་བསྲེས་མ་བཅོས་སྤྲོས་པ་དང་བྲལ་བའི་ཞི་ལྷག་དབྱེར་མེད་དེ་ཉིད་དང་མ་བྲལ་བར་ཉམས་སུ་ལེན།",
    "བདུད་ཀྱིས་བསླུས་འདུག།",
    "ཟས་ནོར་གོས་གྲོགས་འཁོར་གཡོག་སོགས་ཀྱིས་ཀྱང་རང་འཆི་བའི་རྐྱེན་ཇི་ལྟར་བྱེད་མི་ཤེས།",
    "ད་ལྟ་རང་འཆི་བདག་སྒོ་དྲུང་ན་སླེབ་ཚར་བའི་ཚོད་དུ་འདུག་པས་ཟས་ནོར་ལྟོ་གོས་སྙན་གྲགས་སོགས་ལ་བསམ་བློ་བཏང་ལོང་མེད་དོ་སྙམ་ནས་ལུས་ངག་ཡིད་ཕྱག་རྒྱ་ཆེན་པོའི་བོད་གཞུང་གླེགས་བམ་བརྒྱད་པ།",
    "དེ་རྣམས་ནི་ཇི་ཙམ་འཛོམ་ཡང་རང་འཆི་བའི་ཚེ་ཕན་པ་ཏིལ་འབྲུ་ཙམ་ཡང་མེད།",
    "གླེན་ཅིང་མི་ཤེས་པ་ཆེན་པོ་ཡིན་འདུག་ཀྱང་དེ་སྔ་ཉེས་དམིགས་སྣ་གཅིག་ཀྱང་མ་དྲན་པ་འདི་ལ་མི་ཉན་མ་བྱེད་ཟེར་བ་ཞིག་ཀྱང་མ་བྱུང་།",
    "དེ་ཙ་ན་བཤགས་པ་ཚད་ལྡན་ཞིག་འོང་།",
    "བཞིན་འགྲོ་བ་ཡིན་འདུག།",
    "དེ་ཙ་ན་བཀའ་བསྟན་བཅོས་དབྱིངས་ཆེན་མཇལ་ཡང་གོ་དོན་སེམས་དང་འཕྲོད་པའི་བོགས་ཆེན་འོང་།",
    "དཔེ་ཟབ་དགུ་མཇལ་ཡང་རང་རྒྱུད་ལ་སྣེ་གཅིག་ཀྱང་མ་ཕྱག་རྒྱ་ཆེན་པོའི་བོད་གཞུང་གླེགས་བམ་བརྒྱད་པ།",
    "སོ་སོའི་ས་ན་རང་རང་ལ་བདེན་པ་ཡོད་པས་གང་ལའང་གཤེ་མི་རུང་།",
    "རྗེས་ཐོབ་ཐུན་མཚམས་སུ་ཡང་རང་ངོ་ཤེས་ཙམ་གྱི་དྲན་རྫི་བསྟེན་ནས་མ་ཡེངས་པར་བསྐྱང་།",
    "འདི་སྐབས་སེམས་ཀྱི་ལེར་གནས་པ་དང་རྣམ་རྟོག་འཕྲོ་རྒོད་ཀྱི་འགྱུ་བ་དེ་གཉིས་ཐ་དད་དུ་བཟུང་སྟེ་གནས་འདུག།",
    "འགྱུ་འདུག་བསམ་ནས་ངོ་བལྟ་བྱེད་པ་མ་གཏོགས་རང་ངོ་ལྟ་བ་ངོ་མ་ནི་མི་ཤེས་པས་གནས་འགྱུ་ཤེས་ཟེར་བ་ཡིན།",
    "དེའང་མི་ཤེས་ན་གནས་འདུག།",
    "ཉམས་ཀྱི་མྱོང་བ་ཙམ་ལས་རྟོགས་པའི་རང་ངོ་མཐོང་བ་དངོས་ནི་མིན་འདུག།",
    "འདི་སྐབས་བལྟ་བྱ་ལྟ་བྱེད་གཉིས་སུ་མེད་པར་ངེས་ཤེས་སྐྱེས་ནས་མ་བཅོས་པར་ཞོག་གསུངས་པ་དེ་འདི་ཡིན་པར་འདུག་སྙམ་པའང་འབྱུང་།",
    "སླེབ་ཀྱང་མགོ་ནོན་དཀའ་བར་འོང་བས་བརྟན་པ་ཤིན་ཏུ་ཐོབ་ན་མ་གཏོགས་རྣམ་གཡེངས་སྤང་ནས་རྩེ་གཅིག་ཏུ་བསྒོམ་ནུས་པ་ཞིག་གལ་ཅི་ནས་ཆེ་བར་གདའ།",
    "ཉིད་ནས་བཅས་བཅོས་མང་པོ་མི་དགོས་པ་རང་བབ་དེ་ཀས་ཆོག་པ་ཞིག་བྱུང་ན་རང་ངོ་ཕྱོགས་ཙམ་རྟོགས་པའི་རྩིས་བྱེད་དགོས་པར་སྣང་སྟེ་ད་དུང་དེ་ཙམ་གྱིས་ནི་གར་ཡང་མི་ཕྱིན་པར་འདུག་པསབསྒོམ་ཡུན་ཤི་དང་མཉམགྱོང་ལྟོ་གོས་གཏམ་གསུམ་ལ་བསྐུར།",
    "རང་རང་ནི་བདུད་ཀྱིས་ཕྱག་ཆེན་སྔོན་འགྲོ་བཞི་སྦྱོར་གྱི་ཁྲིད་རིམ་ངེས་དོན་སྒྲོན་མེ།",
    "བག་མེད་རོ་ཉལ་སོགས་ལ་ཞེ་ཟོན་དགོས་འདུག།",
    "བུ་ཡིན་འདུག་པས་རྣམ་རྟོག་མེད་འགྲོ་བ་མི་སྲིད།",
    "རང་ངོ་མ་ཤེས་ན་མི་རྟོག་པའང་ལུང་མ་བསྟན་ཁོ་ན་ཡིན་འདུག།",
    "གཞན་གྱི་བསྟོད་བཀུར་ལ་མི་དགའ་དེ་རྣམས་ཀྱིས་ང་རྒྱལ་སྐྱེ་བའི་རྐྱེན་བྱེད་པར་འདུག།",
    "སེམས་གནས་འགྱུ་དགའ་སྡུག་སོགས་གང་ལྟར་སྣང་ཡང་རང་བབས་གཉུག་མའི་ཕྱག་ཆེན་སྔོན་འགྲོ་བཞི་སྦྱོར་གྱི་ཁྲིད་རིམ་ངེས་དོན་སྒྲོན་མེ།",
    "འགྲོ་འཆག་ཉལ་འདུག་སོགས་བྱེད་པ་ལ་སྤྱོད་པ་ཤུགས་འབྱུང་ཞེས་གྲགས།",
    "ཅེས་གསུངས་པ་ལྟར་འོ་སྐོལ་འཛམ་གླིང་པའི་ཚེ་ལ་ངེས་པ་མེད་ཅིང་དེང་སང་ལྔ་བཅུ་ཁ་རལ་གྱི་སྐབས་སུ་འདུག།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "བདག་ནི་མལ་དུ་འདུག་བཞིན་དུ།",
    "ལག་མཐིལ་སྤུ་ཉག་གཅིག་འདུག་པ།",
    "དེའི་མདུན་དུ་ཅུང་ཟད་དམའ་བའི་སྟན་ལ་རང་ཉིད་འདུག་སྟེ་ལག་པ་གཡོན་མཎྚལ་དང་གཡས་སུ་ཚོམ་བུ་ཐོགས་ལ་ཡིག་བརྒྱ་ཚར་གཅིག་འདོན་པ་དང་སྦྲགས་ནས་གོང་བཞིན་མཎྚལ་གྱི་རྡུལ་གཙང་ཞིང་དག་པར་ཕྱི་བ་དང་སྦྲགས་གཟུང་འཛིན་གྱིས་བསྡུས་པའི་རང་གཞན་གྱི་རྒྱུད་ཀྱི་སྡིག་སྒྲིབ་ཐམས་ཅད་སངས་ཀྱིས་ཚིག་འདོན་པ་དང་དོན་གསལ་འདེབས་པ་དང་དག་པར་བསམ།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་སྟེ།",
    "ཞེས་སོགས་མཐའ་ཡས་པར་གསུངས་པས་རྟེན་ལུས་འཁྲུལ་འཁོར་གྱིས་བཅིངས་ཙ་ན་བརྟེན་པ་སེམས་ལ་རྣམ་རྟོག་མི་འགྱུ་དགུ་འགྱུ་རང་འགགས་སུ་འགྲོ་སྟེ།",
    "དེ་ནས་ཞེ་སྡང་རང་རྒྱུད་པ་འབྱུང་ཞིང་གདོན་རྒྱལ་པོ་སོགས་གནོད་པའི་ཉེན་ཡོད།",
    "དེ་ལ་འདས་པའི་རྗེས་མི་བཅད་ཟེར་ཙ་ན་འོ་སྐོལ་གྱི་བློ་རྣམ་རྟོག་སྔ་མའི་ཕྱིར་མི་འབྲང་བ་ཡིན།",
    "མ་འོངས་པའི་མདུན་མི་བསུ་ཟེར་ཙ་ན་འོ་སྐོལ་གྱི་བློས་རྣམ་རྟོག་ཕྱི་མའི་མདུན་མི་བསུ་བ་ཡིན།",
    "ད་ལྟར་གྱི་ཤེས་པ་རྣལ་མར་ཙེན་གྱིས་ཞོག་ཟེར་ཙ་ན་ད་ལྟར་གང་དུའང་མི་དམིགས་པ་ལ་ཟེར་བ་ཡིན།",
    "ད་ལྟ་རང་ཉིད་རྣམ་རྟོག་ཅི་འདྲ་ཞིག་འགྱུ་ཡིན་འདུག་སྙམ་དུ་ད་ལྟར་གྱི་རྟོག་པ་སྐད་ཅིག་མ་འདི་ཉིད་ལ་ཅེར་གྱིས་བལྟས་པས་རྟོག་པའི་རྒྱུ་འགྲུལ་རྦད་ཀྱིས་ཆད་ནས་མ་ཡེངས་བར་དུ་རྟོག་པ་མི་འོང་ནམ་ཡེངས་པ་དང་རྟོག་པ་ཡེར་གྱིས་ཡོང་སྟེ།",
    "དེ་ལྟར་བྱུང་ཙ་ན་སེམས་ཕྱག་རྒྱ་ཆེན་པོའི་བོད་གཞུང་གླེགས་བམ་བརྒྱད་པ།",
    "སྒོམ་དགོས་པར་འདུག་ཅིས་ཀྱང་མི་ཕན་འཆི་བར་འདུག་སྙམ་པ་འོང་།",
    "སྤྱིར་རང་སེམས་ཀྱི་མཚན་ཉིད་ནི་བཟུང་ན་མི་ཟིན་བཏང་ན་འགྲོ་ས་མེད་པ་ཞིག་ཏུ་གདའ།",
    "ཡིད་ལ་མི་བྱེད་ཞེ་འདོད་ཀུན་དང་བྲལ་། རང་བྱུང་རང་ཞི་ཆུ་ཡི་པ་ཏྲ་འདྲ།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པ་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "དེ་ཡུན་རིང་བ་ལ་ཡོན་ཏན་དུ་མི་ལྟ་ཡུན་ཐུང་བ་ལ་སྐྱོན་དུ་མི་ལྟ་བར་སྐད་ཅིག་ཙམ་དུ་འཁྱེར་ཞིང་བསྒོམས་པས་དུས་ཅི་ཞིག་ཙ་ན་རྟོག་པའི་རང་བཞིན་ཤེས་ཏེ་རྣམ་རྟོག་འོད་གསལ་དུ་ཤར་ནས་རྒྱུན་ཆད་མེད་པར་ཕྲིལ་གྱིས་འཆར་བར་ཐེ་ཚོམ་མེད་དོ།",
    "སེམས་གང་ལྟར་འདུག་པ་དེ་ཀ་ལྟར་བཞག་གོ།",
    "ངོས་བཟུང་མཐའ་དག་དང་བྲལ་བར་འདུག་བྱ་བ་ཡིན།",
    "ཁོ་རང་ཐོག་ཏུ་གློད་ལ་ཞོག།",
    "ཐུན་བསྟུང་མ་དགོས་པར་རིག་པ་སྤུན་སི་ལི་ལིར་འགྲོ་བ་འདྲ་ཞིག་འདུག་ཀྱང་སྒོམ་གྱི་རྒྱུན་དེ་མ་ཆད་པར་བྱུང་ན་གནས་པ་དང་པོ་རི་གཟར་གྱི་ཁ་ནས་ཆུ་འབབ་པ་འདྲ་ཟེར་བ་ཡིན།",
    "དེ་ལ་གལ་མེད་དུ་ལྟ་བ་འདྲ་ཞིག་འདུག་ན་ཡིན།",
    "དེའང་རང་ཐག་རིང་པོ་ཞིག་དུ་འདུག་ནས་དེའི་འབབ་ལུགས་ལེགས་པོ་མི་མཐོང་བ་འདྲ་ན་མིན།",
    "རྩར་འདུག་ནས་མཐོང་བ་འདྲ་ན་ཡིན།",
    "གནས་པ་གསུམ་པོ་དེ་གང་སྐྱེས་འདུག་ཙ་ན་ངོ་སྤྲད་པས་རང་ངོ་ཤེས།",
    "སེམས་འཛིན་གྱི་སྐབས་ཐམས་ཅད་དུ་དྲན་པའི་སོ་པ་བཀོད་དེ་བྱིང་རྨུགས་ལ་སོགས་པའི་སྐྱོན་འདུག་གམ་མི་འདུག་ལྟ་ཞིང་མི་འདུག་ན་དེ་ཀར་འཇོག་པ་དང་།",
    "བྱིང་ན་འདུག་ས་བསེང་བར་བྱ།",
    "རང་རང་གཞུང་དང་གྲུབ་པའི་མཐའ་ཡིས་ནི།",
    "ཁོ་རང་མ་ཡེངས་པར་ཡོད་སྙམ།",
    "དངོས་པོར་འདུག་གམ་དངོས་མེད་དུ་འདུག།",
    "དེ་ལ་གནས་པའི་ངང་ནས་སེམས་ཀྱི་ངོ་བོ་དེ་ཅི་ལྟ་བུ་ཞིག་འདུག་དྲིས་ལ།",
    "འོ་ན་ཤེས་པ་དེ་ལུང་མ་བསྟན་གྱི་ཤེས་པ་ཚོམ་མུན་ནེ་བ་ཞིག་འདུག་གམ།",
    "གསལ་ཧྲིག་གེ་བ་ལ་རྗེན་ནེ་བ་ཞིག་འདུག་དྲིས་པས་རྟིང་མ་ལྟར་འདུག་ཟེར་ན་སེམས་ངོ་མཐོང་བ་ཡིན།",
    "སྦྲང་མ་གར་སྤྱིན་ལ་འབྱར་བ་ལྟ་བུ་རིག་པ་མི་གསལ་བའི་ངང་དུ་གནས་པ་ཞིག་འདུག་ལ།",
    "ད་ལན་སེམས་གནས་པ་དེ་གསལ་དྭངས་སིང་ངེ་བ་ངོས་བཟུང་དང་བྲལ་བ་ཞིག་འདུག་ཟེར་ན།",
    "དེ་སྔར་དང་ཁྱད་མི་འདུག་ཟེར་ན།",
    "མིག་ཡུལ་གྱི་གཟུགས་ལ་འདུག་གམ་ཕྱག་རྒྱ་ཆེན་པོའི་བོད་གཞུང་གླེགས་བམ་བརྒྱད་པ།",
    "དེ་ལྟར་བཙལ་བའི་ཚེ་མ་རྙེད་ན་ཚོལ་མཁན་དེ་ཀའང་ཇི་ལྟར་འདུག།",
    "སྔར་རང་ལུགས་སུ་གློད་པའི་སེམས་དེ་དང་ད་བརྟག་དཔྱད་བྱས་པའི་སེམས་དེ་ལ་ཁྱད་པར་ཇི་ཙམ་འདུག།",
    "སེམས་དེའི་བྱུང་གནས་འགྲོ་གསུམ་ཇི་ལྟར་འདུག་ལེགས་པར་བརྟག་ནས་བཙལ་བར་བྱའོ།",
    "དཔེ་བཟའ་མི་གཉིས་ལ་བུ་གཅིག་ཡོད་པ་དེ་མའི་རྩར་ཡོད་ན་ཕའི་རྩར་མི་ཡོང་ཕའི་རྩར་ཡོད་ན་མའི་རྩར་མི་ཡོང་འཕྲིན་ཕར་སྐྱེལ་ཚུར་སྐྱེལ་བྱེད་པ་བཞིན་སེམས་དེའང་གནས་ཙ་ན་མི་འགྱུ་འགྱུ་ཙ་ན་མི་གནས།",
    "འདིའི་སྐབས་སུ་སེམས་དེ་ཅི་འདྲ་ཞིག་འདུག་ཅེས་འདྲི།",
    "ཡང་རྟོག་མེད་དུ་བལྟས་པའི་དུས་དེར་གནས་པ་དེ་ཀ་མིན་པ་ཅི་ཡང་མི་འདུག་ཟེར་ན།",
    "ལྷག་མཐོང་མ་ཤར་བས་ད་དུང་ཞག་འགའ་བསྲིང་ཞིང་བལྟར་འཇུགཡང་ཅི་ཡང་ངོས་བཟུང་མེད་པའི་སྟོང་པ་ཅང་མེད་དུ་འདུག་ཟེར་ན།",
    "ཕྱོགས་གཅིག་ཙམ་མཐོང་ཡང་མཐའ་དག་མ་མཐོང་བས་ད་དུང་མ་ཡེངས་པའི་སྒོ་ནས་ཐག་ཆོད་ལ་སྟོང་རྐྱང་ཞིག་འདུག་གམ་སྟོང་ལུགས་ཅི་འདྲ་ཞིག་འདུག་བལྟར་འཇུག།",
    "འདི་ཡིན་སྨྲ་ཡང་མི་ཤེས་པ་ལ་ཐག་ཆོད་པ་ཞིག་འདུག་ཟེར་བ་དང་།",
    "འདི་འདྲ་ཞིག་འདུག་སྙམ་རྒྱུའང་མེད་པ་ལ་སྐྱེ་འགག་མེད་པར་ཤེས་རྒྱུ་ཞིག་ཀྱང་འདུག་ཟེར་ན།",
    "རྟོག་པ་དེ་ལ་བལྟས་པས་རྗེས་མེད་དུ་ཤིག་ཤིག་འགྲོ་ཡིན་འདུག་ཟེར་ན་ཅུང་ཟད་ཤར་བ་ཡིན།",
    "རྟོག་པ་ཤར་ཚད་ངོས་གཟུང་མེད་པར་འཆར་གྱིན་འདུག་ཟེར་ན།",
    "དེ་དུས་ངོས་གཟུང་མི་འདུག་སྙམ་པ་ཡོང་མི་ཡོང་དྲི།",
    "འདི་སྙམ་པ་མེད་བཞིན་དུ་གལ་མེད་འཛིན་མེད་དུ་ངོས་བཟུང་མེད་པར་ཤར་གྲོལ་དུས་མཉམ་དུ་འགྲོ་ཡིན་འདུག་ཟེར་ན།",
    "དེར་ལམ་མེར་འདུག་སྙམ་རྒྱུའི་ཀད་དེ་བ་ཞིག་འདུག་གམ་མི་འདུག་དྲི།",
    "འདུག་ཟེར་ན་དེ་སྐད་སྙམ་པ་དེ་བལྟར་གཞུག།",
    "དེའང་ཁོ་རང་ལ་མཐོང་ལུགས་ཇི་ལྟར་བྱུང་བ་དེ་གོ་ཡུལ་ཙམ་མ་ཡིན་པར་རྒྱུད་ཐོག་ཏུ་ཁེལ་ངེས་གྱིས་ནས་ཁྱེར་ཤོག་བྱས་ལ་བསྒོམ་དུ་ཕྱག་རྒྱ་ཆེན་པོའི་བོད་གཞུང་གླེགས་བམ་བརྒྱད་པ།",
    "དེ་ལ་བལྟས་པས་ངོས་གཟུང་ཅི་ཡང་མེད་པ་ཞིག་འདུག་ཟེར་ན་ངོ་འཕྲོད་པ་ཡིན།",
    "དེ་ལ་རྩེ་གཅིག་ཏུ་མི་ཡོང་བ་འདུག་ཟེར་ན་གོ་ཡུལ་ཡིན་པས་གོ་ཡུལ་མ་ཡིན་པའི་ཉམས་མྱོང་རྒྱུད་ཐོག་ཏུ་འཕྲོད་པ་ཞིག་དགོས་པས་གཞན་གྱི་གཞིག་འགྲེལ་མང་པོ་མ་བྱེད་པར་ངས་བསྟན་པ་བཞིན་སྒོམས་ལ་ཤོག་བྱས་ཏེ་ཉམས་རྟོགས་གོང་བཞིན་མ་སྐྱེས་ཀྱི་བར་སྒོམ་དུ་གཞུག་ཅིང་སྐྱེས་ནས་ངོ་སྤྲོད་པར་བྱའོ།",
    "སླར་ཡང་འགྱུ་མཁན་གྱི་སེམས་དེ་དང་གནས་པའི་སེམས་དེ་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "འགྱུ་སེམས་དེ་དང་དེ་ལ་ལྟ་བའི་སེམས་དེ་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "གཉིས་ཀྱི་ངོ་བོ་ལ་ཁྱད་པར་ཅི་འདུག།",
    "དགའ་བར་འགྱུས་པའི་སེམས་དེ་དང་མི་དགའ་བར་འགྱུས་པའི་སེམས་དང་ཐོག་མའི་གནས་པའི་སེམས་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "ཡང་སེམས་སྤྲོ་གང་ཐུབ་ཅིག་དུས་གཅིག་ལ་ཕྱོགས་བཞི་མཚམས་བརྒྱད་དུ་སྤྲོས་ནས་དེ་དང་སྔར་གྱི་གནས་པའི་སེམས་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "ཡང་རྣམ་པར་རྟོག་པ་གང་ཤར་བ་དེ་ཀའི་ངོ་བོ་ལ་ཅེར་གྱིས་བལྟས་པས་རྣམ་རྟོག་དེ་ཀ་ངོས་གཟུང་མེད་པར་གསལ་སྟོང་དུ་ཤར་ཙ་ན་རྟོག་པ་ངན་པ་ཞིག་ལོགས་སུ་སྤང་མི་དགོས་གཉེན་པོ་ཞིག་ལོགས་ནས་བཙལ་མི་དགོས་ཏེ།",
    "དེ་ལ་མ་ཡེངས་པར་བཞག་པས་དུག་ལྔ་གཞི་མེད་རྩ་བྲལ་དུ་ཤར་ཙ་ན་འདོད་ཆགས་སོགས་མ་སྤངས་པར་དག་པས་རང་གྲོལ་ཞེས་ཀྱང་བྱ་ལ་དེ་ཀ་ལ་སོར་རྟོགས་ཡེ་ཤེས་སོགས་ཡེ་ཤེས་ལྔ་དང་འོད་དཔག་མེད་སོགས་རྒྱལ་བ་རིགས་ལྔ་ཟེར་བ་ཡིན་ནོ།",
    "གཉེན་པོས་བཅོས་སུ་མེད་པར་གདའ།",
    "རིག་པ་གསལ་བའི་ངང་དུ་གདའ་། ཞེས་དང་།",
    "དེའང་སེམས་འདི་འགྲོའམ་སྡོད་དམ་ལས་བྱེད་དམ་ཅི་འདྲ་འདུག་ལྟོས་ལ་འདུག་ཚུལ་ཁྱེར་ཤོག་བྱས་ཞག་འགའ་བརྟག་འཇུག།",
    "དེ་ནས་དྲིས་པས་སེམས་དེ་གང་ཡང་མི་བྱེད་པར་སྡོད་འདུག་ཟེར་ན།",
    "དེ་ལྟར་མི་འདུག་ཟེར་ན།",
    "༢༢ ཡང་སྒོམ་ཆེན་རྙིང་པ་ལྟ་བུས་སེམས་མ་བཅོས་གཉུག་མའི་ང་ལ་སྡོད་གདའ་ཟེར་བའམ་སྤྲོས་བྲལ་དུ་འདུག་ཟེར་བའི་སྟོང་སྐད་འདོན་གྱིན་འདུག་ན་ཁ་སང་ནས་གྲུབ་མཐས་མ་བསྒྱུར་གཉེན་པོས་མ་བཅོས་པའི་ཐ་མལ་གྱི་ཤེས་པ་ཁྱེར་ཤོག་བྱས་པ་མ་གཏོགས་ཁྱེད་ལ་སྒོམ་སྐད་ཞུས་པ་མ་ལགས།",
    "ཡང་བསྐྱར་གྱིན་དྲིས་པས་གཉེན་པོས་མ་བཅོས་གྲུབ་མཐས་མ་བསྒྱུར་བའི་ཐ་མལ་གྱི་སེམས་རང་ག་མ་འདི་ལ་སྡོད་རྒྱུ་སྐད་ཅིག་ཀྱང་མི་འདུག།",
    "རྣམ་རྟོག་མི་འཕྲོ་དགུ་འཕྲོ་མི་བྱེད་དགུ་བྱེད་བྱེད་ཀྱིན་གདའ་ཟེར་ན།",
    "ད་དུང་ཆགས་སྡང་དང་དགའ་སྡུག་དང་དགྲ་གཉེན་གྱི་དབྱེ་བ་དང་སྣོད་བཅུད་སོགས་སྣང་བ་དུ་མ་འཆར་བ་འདི་རྣམས་བྱེད་མཁན་ལོགས་ན་འདུག་གམ་སེམས་ཀྱིས་བྱས་པ་ཡིན་ནམ་སེམས་རང་ཡིན་ཞིབ་ཏུ་ལྟོས་ལ་ཤོག་ཅིག་བྱས་ལ་བརྟག་ཏུ་གཞུག་གོ།",
    "མུ་སྟེགས་པ་དང་འཇིག་རྟེན་གྱི་གཏམ་རྒྱུད་རྫུན་མ་ཐོས་འདུག་པ་དེ་ལ་ཏིག་ཏིག་མེད་ད་དུང་བརྟག་གཞིག་ཐོང་བྱ།",
    "ཡང་དྲིས་པས་བྱེད་མཁན་ཐམས་ཅད་སེམས་སུ་འདུག།",
    "སེམས་བསྡད་ཙ་ན་གང་ཡང་མི་འདུག་སེམས་འཕྲོ་ཙ་ན་ཐམས་ཅད་བྱེད་ཕྱག་རྒྱ་ཆེན་པོའི་བོད་གཞུང་གླེགས་བམ་བརྒྱད་པ་༧འདུག་ཟེར་ན།",
    "སེམས་བྱེད་པ་པོ་དེ་དང་དེའོ་བྱ་བ་བྱས་པ་གཉིས་གཅིག་ཏུ་འདུག་གམ་ཐ་དད་དུ་འདུག་བྱས་པས།",
    "ཐ་དད་དུ་འདུག་ཟེར་ན།",
    "ཀ་བ་སྙམ་པའི་དུས་སུ་ཀ་བ་སྙམ་པ་དེ་ནི་སེམས་ཡིན་ལ་དེ་དང་དུས་མཉམ་དུ་དེ་མ་གཏོགས་པའི་ཀ་བ་ཞིག་ལོགས་སུ་འདུག་གམ་དྲིས་པས།",
    "གཉིས་མི་འདུག་ཟེར་ན་ངོ་འཕྲོད་པ་ཡིན་པས་དེ་ལྟར་ཐབས་ལ་མཁས་པས་འཁྲུལ་སེམས་ངོ་ཤེས་པར་བྱ།",
    "དེ་དག་ངོ་སྤྲད་པ་ནི་ཁྱེད་རང་སེམས་འདི་མི་བྱེད་དགུ་བྱེད་བྱེད་ཀྱིན་འདུག་ཟེར་བ་དེ་དུས་རྣམ་རྟོག་ངོས་ཟིན་པ་ཡིན།",
    "ཡང་ཁྱེད་རང་བྱེད་མཁན་ཐམས་ཅད་སེམས་སུ་འདུག་གཞན་སུས་ཀྱང་བྱས་པར་མི་འདུག་སེམས་བསྡད་ཙ་ན་གང་ཡང་མི་འདུག་སེམས་འཕྲོ་ཙ་ན་ཐམས་ཅད་བྱེད་ཀྱིན་འདུག་ཟེར་བ་དེ་ཀ་ཡིན།",
    "ལས་ལོགས་སུ་ཨེ་འདུག་བལྟ།",
    "ད་དུང་དམིགས་རྟེན་ལ་སེམས་མ་ཟིན་པར་འདུག་པས་སེམས་ལ་གཟུགས་དེ་སྣང་ལུགས་དང་ཁ་དོག་དབྱིབས་ཇི་ལྟར་འདུག་ལྟར་འཇུག།",
    "གལ་ཏེ་སྣང་བ་སེམས་སུ་འདུག་ཟེར་ན།",
    "ཡང་སེམས་ནང་དུ་བཀུག་སྟེ་ལུས་སེམས་ཐ་དད་དུ་འདུག་གམ་གཅིག་ཏུ་འདུག་དྲི།",
    "ཐ་དད་ཟེར་ན་ལུས་སེམས་ཁང་པ་དང་མི་བཞིན་དུ་འདུག་གམ་ལུས་དང་གོས་བཞིན་དུ་འདུག།",
    "དེར་མ་ཟད་སྣང་བ་སེམས་སུ་འདུག་ཟེར་བྱུང་བ་ཐག་རིང་པོའི་སྣང་བ་རྣམས་སེམས་སུ་འདུག་ན་ཉེ་བ་ལུས་སེམས་སུ་མེད་པ་གར་སྲིད་པས་ལུས་སྣང་གཉིས་སེམས་ཡིན་ན་ཡིན་མཉམ་དང་མིན་ན་མིན་མཉམ་ལས་འོས་མེད་པའི་ཕྱིར་ད་དུང་ལེགས་པར་བརྟག་གཞིག་གྱིས་ཤིག་ཅེས་བསྒོ།",
    "ཤི་བའི་སྐབས་ཀྱི་ཕུང་པོ་དེའང་དེ་མཐོང་མཁན་གྱི་གང་ཟག་རྣམས་ཀྱིས་སེམས་སྣང་ཡིན་གྱི་དེ་ས་ལོགས་སུ་གྲུབ་པ་མི་འདུག་ཟེར་ན།",
    "ད་ངོ་འཕྲོད་འདུག་པས་གཟུང་ཕྱག་ཆེན་ལྷན་ཅིག་སྐྱེས་སྦྱོར་གྱི་ཟབ་ཁྲིད་ངེས་དོན་རྒྱ་མཚོ།",
    "འཛིན་མེད་ལ་གནས་ཀྱིན་འདུག་ན་དེ་ཀ་ཕྱག་རྒྱ་ཆེན་པོ་ཡིན།",
    "ན་རྐྱེན་སྣང་ཁོ་རང་རང་སེམས་ཡིན་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་སེམས་སྟོང་པར་ངོ་སྤྲོད་པ་ནི་སེམས་ཉིད་དེའང་རང་བཞིན་གྱིས་འོད་གསལ་བ་ཞེས་ཐ་སྙད་ཇི་ལྟར་བཏགས་ཀྱང་གཟུགས་ཁ་དོག་དབྱིབས་ལུས་ཀྱི་ཕྱི་ནང་རྣམ་པ་སོགས་འདི་འདྲར་གྲུབ་ཅེས་སྨྲ་བསམ་གྱི་ཡུལ་ལས་འདས་པ་སྟེ་དཔེར་ན་ནམ་མཁའ་ལྟ་བུའོ།",
    "གཉིས་སུ་འཛིན་པ་ཟད་སར་བསྐྱལ་། སྡུག་བསྔལ་མ་མཆིས་སྐྱིད་པར་གདའ།",
    "སེམས་ཁོ་རང་དེའི་ངོ་བོར་ཤར་ན་རྟོགས་པ།",
    "སྒོམ་བདེ་གསལ་མི་རྟོག་སྟོང་པ་རྣམས་ལ་སྒོམ་རྒྱུའམ་མྱོང་རྒྱུ་ཞིག་འདུག་ན་ཉམས།",
    "སྒོམ་མཁན་དང་སྒོམ་གཉིས་སུ་མེད་པ་ཡིད་བཟོ་དང་གོ་བ་ཙམ་མིན་པར་མངོན་སུམ་དུ་ཤེས་ན་རྟོགས་པ་ཡིན་པར་འདུག།",
    "འཛིན་པ་དེའང་ཡུལ་ལ་བརྟེན་ནས་སྐྱེ་བ་ལས་འདིར་གཟུང་ཡུལ་ཐམས་ཅད་གཉུག་མ་རང་གསལ་དུ་ཤར་བས་དེ་མེད་ཙ་ན་འཛིན་བྱེད་ཀྱི་ཤེས་པ་དང་བྲལ།",
    "དུས་སུ་ཡེངས་འདུག་སྙམ་པའི་རྗེས་ལ་དགེ་སྦྱོར་རྒྱུད་ཐོག་ཏུ་ཡེར་ཡོང་བ་དེ་གཟུང་དྲན་ཡིན་ཞིང་སྔར་འཛིན་པ་ཞུགས་པའི་རྟགས་ཡིན།",
    "སྤྲོས་བྲལ་མཐོང་ལམ་ཡིན་ན་ཡོན་ཏན་བརྒྱ་ཕྲག་བཅུ་གཉིས་སོགས་མི་འདུག་པས་འགལ་བ་ལ་སོགས་པ་དེ་རྣམས་ལ་ངེས་པ་ཆེན་པོ་མི་འོང་སྟེ་མཚན་ཉིད་ནས་ཀྱང་མཐོང་ལམ་གྱི་ཡོན་ཕྱག་རྒྱ་ཆེན་པོའི་བོད་གཞུང་གླེགས་བམ་བརྒྱད་པ།",
    "འོ་ན་ཇི་ལྟར་ཡིན་གྱིས་དང་ད་ལྟར་གྱི་ཐ་མལ་གྱི་ཤེས་པ་དངོས་འཛིན་དང་སྟོང་འཛིན་ཡེ་བྲལ་དུ་འདུག་པ་འདི་ལ་ཕྱག་རྒྱ་ཆེན་པོར་མཛུག་གུ་འཛུགས་པ་ཡིན་ཏེ་འདི་ལ་འཆར་སྒོ་དཔག་ཏུ་མེད་པ་ཞིག་ཡོད་ཀྱང་གཉུག་མ་མ་བཅོས་པའི་ཤེས་པ་གཅིག་པུ་འདི་ཀའི་འགྲོས་ལས་མེད།",
    "གཉེན་པོས་བཅོས་གཅིག་ཀྱང་མ་བྱས་པར་རང་སར་ངོ་ཤེས་ཤིང་རང་གྲོལ་བ་ལ་ཕྱག་རྒྱ་ཆེན་པོ་ཟེར་བ་ལགས་སོ་། ཞེས་གསུངས་པ་དང་།",
    "ཡང་རང་བྱུང་བས་གསུངས་པ་ལྟར་ན།",
    "ཡང་རང་བཞིན་གྱི་གནས་ལུགས་ལ་དགོངས་ནས་གནས་ལུགས་ཕྱག་ཆེན།",
    "དེ་རང་ཡང་ཐ་དད་འདུག་པ་ལྟ་བུ་མ་ཡིན་ཏེ།",
    "དེ་ལ་དེའི་རང་བཞིན་མི་འདུག་ཀྱང་དེའི་རྣམ་པ་གསལ་བར་སྣང་བའོ་། དེ་སྐད་དུ་ཕྱག་རྒྱ་ཆེན་པོ་ཐིག་ལེའི་རྒྱུད་ལས།",
    "དེའང་ཤེས་པ་སྐད་ཅིག་མའི་ཐོག་ཏུ་ཕྱོགས་གཅིག་ཏུ་སྦྱར་ན་རྣམ་པར་རྟོག་པ་ཞིག་ཐོལ་ཏེ་སྐྱེས་པའི་དུས་སུ་རྣམ་རྟོག་དེ་ལ་དགག་སྒྲུབ་གཅིག་ཀྱང་མ་བྱས་པར་རྣམ་རྟོག་ཏ་ལེ་བ་དེ་རང་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ཀྱི་དངོས་གཞིར་འདུག་ལ།",
    "མི་དགའ་བ་རྣམས་ཀྱིས་བློ་ཕམ་གྱི་དབུགས་རིང་དབྱུང་བ་ལས་ཐབས་གཞན་ཅི་ཡང་མི་འདུག་གོཕངས་པ་ཞིག་ལ་རྩོམ་ལུགས་གསར་པ་འདི་ལ་རྩོམ་པ་པོ་རྣམས་སུན་སྣང་མེད་པར་འཇུག་བཞིན་པ་མ་གཏོགས་བོད་ཕྱི་ནང་ཀུན་དུ་མཁས་པ་རྣམས་ཀྱིས་དགོས་ངེས་ཀྱི་དོ་སྣང་མཛད་མེད།",
    "སྔ་མའི་སྐབས་སུ་ཡུལ་དང་ཡུལ་ཅན་འཕྲད་ཅིང་ལུས་སེམས་ཀྱིས་ཚོར་བ་ཞིག་བརྒྱུད་ནས་སྦྱངས་པ་ཡིན་པས་མིང་དེ་དང་མཉམ་དུ་ལུས་སེམས་ཀྱི་ཚོར་བ་དེ་ཡང་རང་ཤུགས་ཀྱིས་གནས་ཡོད་པ་ཡིན།",
    "མི་དང་རང་བྱུང་ཁམས་བར་གྱི་འབྲེལ་བ་བཅས་ཕྱོགས་བཞི་ལ་གོ་དགོས་པ་དང་།",
    "དེ་ལོས་ཡིན།",
    "སྙན་ངག་མཁན་ལྗང་བུའི་ང་རང་སྤར་ཆོག་ཅེས་པའི་སྙན་རྩོམ་ནི་དེའི་མིག་དཔེར་འཕེར་བའི་དཔེར་བརྗོད་ཅིག་ཡིན།",
    "སྙན་ངག་དེ་གང་ན་འདུག་ཤེས་སམ།",
    "བོད་གངས་ཅན་གྱི་མི་རབས་གསར་པའི་ཕུགས་བསམ་མངོན་འདུག་རྙིང་ཞེན།",
    "༢ང་རང་སྤར་ཆོག་ལ་ཕུལ་བ།",
    "འོན་ཀྱང་ང་རང་སྤར་ཆོག་ངས་སྤང་ལྗོངས་ལ་འོད་སྣང་སྟེར་ཐུབ།",
    "འོན་ཀྱང་ང་རང་སྤར་ཆོག་ངས་སྦྲ་གུར་གྱི་མུན་པ་སེལ་ཐུབ།",
    "མཐོང་མི་འདུག་སྟེ།",
    "རྡ་རམ་ས་ལའི་རྙོག་གླེང་ག་དུས་ནས་འགོ་ཚུགས་པ་དང་།",
    "ངའི་ཡིད་ཆེས་དེ་ནོར་འདུག་ང་རྡ་སར་འབྱོར་དུས་ངའི་དཔྱད་རྩོམ་དེ་པར་གློག་བརྒྱབ་ནས་ག་ས་གར་ཁྱབ་བཞིན་པ་དང་།",
    "སྔར་ཡང་བཞག་མ་མྱོང་སོགས་ཟེར་དཀྲོག་གཏམ་སྣ་ཚོགས་འཕེལ་བ་དང་མཉམ་དུ་མེག་ལོ་གྷན་ཇིའི་མི་རྣམས་ཀྱི་ངོས་ནས་རྣམ་འགྱུར་ཡང་འདྲ་མིན་ཐོན་གྱི་འདུག་ལ་ལས་ང་མཐོང་མ་ཐག་མགོ་རུབ་རུབ་བྱས་ནས་ཤུབ་སྨྲ་བྱེད་པ་དང་།",
