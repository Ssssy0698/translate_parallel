    "བྱང་དུ་གོས་འཛིན་མ་སྔོན་མོ་གོས།",
    "བྱང་ཤར་དུ་སྤྱན་མ་དཀར་མོ་འཁོར་ལོའི་ལྟེ་བར་སྤྱན་གྱིས་མཚན་པ།",
    "ཤར་ལྷོར་མཱ་མ་ཀཱི་སྔོན་མོ་རྡོ་རྗེ།",
    "ལྷོ་ནུབ་ཏུ་གོས་དཀར་མོ་དམར་མོ་པདྨ།",
    "ཕྱིའི་ཤར་སྒོར་ལྕགས་ཀྱུ་མ་དཀར་མོ་གཡས་ལྕགས་ཀྱུ།",
    "ལྟོ་སྒོར་ཞགས་པ་མ་སེར་མོ་ཞགས་པ།",
    "ནུབ་སྒོར་ལྕགས་སྒྲོག་མ་དམར་མོ་ལྕགས་སྒྲོག།",
    "གཡས་པས་རང་རང་གི་ཕྱག་མཚན་འཛིན་ཅིང་།",
    "དེནས་རང་གི་ཤེས་པ་མཚམས་ཀྱི་ལྷ་མོ་བཞིའི་ང་རྒྱལ་དུ་འཕོས་ཏེ།",
    "ཁྱོད་ནི་ཞེ་སྡང་རྡོ་རྗེ་ཡོངས་སྐྱོང་བ།",
    "སྤོས་མོ་སོགས་ཀྱི་གནས་ལུགས་པའི།",
    "མཚམས་ཀྱི་ལྷ་མོ་རྣམས་ཀྱི་གླུས།",
    "དེའི་ཚེ་མེ་ཏོག་མ་ནི་བདག་ལ་མྱུར་དུ་གཟིགས་ཞེས་སོགས་འདོན་པ་བསྒྱུར་དགོས་སོ།",
    "སཱི་ནི་བདག་ལ་མྱུར་དུ་གཟིགས།",
    "ཁྱོད་ནི་གཏི་མུག་རྡོ་རྗེ་ཡོངས་སྐྱོང་བ།",
    "རི་། ཁྲོད་མ་ནི་བདག་ལ་མྱུར་དུ་གཟིགས།",
    "ཁྱོད་ནི་འདོད་ཆགས་རྡོ་རྗེ་ཡོངས་སྐྱོང་བ།",
    "གཏུམ་པར་ལྡན་པ་བདག་ལ་མྱུར་དུ་གཟིགས།",
    "གཡུང་མོས་རྡོ་རྗེ་ཉི་མ་དང་།",
    "ཌོམྦི་ནཱི་ནི་བདག་ལ་མྱུར་དུ་གཟིགས།",
    "བྱང་གི་ཐིག་ལེ་ཁི་༜ ཏཱཾ་གི་ས་བོན་འོད་འབར་ཞིང་འཇིགས་པར་གྱུར།",
    "ཞལ་ཕྱག་ལྷག་མ་རྣམས་དང་ཡུམ་རྣམས་རྒྱུའི་རྡོ་རྗེ་འཆང་གི་སྐབས་ལྟར་གསལ་གདབ་བོ།",
    "རལ་གྲི་རྣམས་རང་རང་གི་ས་བོན་གྱིས་མཚན་པ།",
    "བཅུད་ཐམས་ཅད་མཁའ་འགྲོ་ལྔའི་ལྷ་ཚོགས་སུ་བྱས་པར་བསམ་མོ།",
    "ཚོགས་ཞིང་གི་སྐབས་ལྟར་ལྷ་མོ་བརྒྱད་ཀྱིས་མཆོད་ནས།",
    "ཁྱོད་ནི་རྣལ་འབྱོར་མ་ཚོགས་སོགས་ཀྱིས་བསྟོད།",
    "ཡེ་༣ ཤེས་པ་རྣམས་ཀྱི་ཐུགས་ཀར་རེག་པའི་ཚུལ་དུ་བྱས་པས་ཡེ་ཤེས་པ་རྣམས་སྲུང་བའི་འཁོར་ལོའི་ནང་དུ་དགུག་པར་བསམས་ལ་ལུས་ཀྱིས་ལྕགས་ཀྱུའི་ཕྱག་རྒྱ་བཅས་ཏེ།",
    "དེ་བཞིན་དུ་ཙོ་རཱི་སེར་མོ་ཞགས་པ་ཐོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས་ཏེ་ཡེ་ཤེས་པ་རྣམས་ཀྱི་མགྲིན་པར་རེག་པའི་ཚུལ་དུ་བྱས་པས།",
    "ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་རྟེན་དང་བརྟེན་པར་བཅས་པ་རང་གི་དམ་ཚིག་གི་འཁོར་ལོ་ལ་བཅུག་པར་བསམས་ལ་ཞགས་པའི་ཕྱག་རྒྱ་དང་།",
    "བེ་ཏཱ་ལཱི་དམར་མོ་ལྕགས་སྒྲོག་ཐོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས་ནས་དཀྱིལ་འཁོར་པ་ཐམས་ཅད་ཀྱི་ཞབས་ལ་ལྕགས་སྒྲོག་གིས་རེག་པའི་ཚུལ་དུ་བྱས་པས་ཡེ་ཤེས་པ་དང་དམ་ཚིག་པ་དབྱེར་མེད་གཅིག་ཏུ་གྱུར་པར་མོས་ལ་ལྕགས་སྒྲོག་གི་ཕྱག་རྒྱ་དང་།",
    "གྷསྨ་རཱི་དྲིལ་བུ་ཐོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས་ཏེ་གཞལ་ཡས་ཁང་གི་ཕྱི་ནང་ཐམས་ཅད་གང་བས་ལྷ་རྣམས་དགྱེས་པ་ཁྱད་པར་ཅན་བསྐྱེད་ཅིང་།",
    "དེ་ནས་ལྷ་ཐམས་ཅད་ཀྱི་མིག་ཏུ་མཾ་ལས་གཏི་མུག་རྡོ་རྗེ་མ་དཀར་མོ།",
    "རྣ་བར་དཾ་ལས་ཞེ་སྡང་རྡོ་རྗེ་མ་སྔོན་མོ།",
    "སྣར་པཾ་ལས་སེར་སྣ་རྡོ་རྗེ་མ་སེར་མོ།",
    "ལྕེ་ལ་རཾ་ལས་འདོད་ཆགས་རྡོ་རྗེ་མ་དམར་མོ།",
    "སྤྱི་བོར་ཨོཾ་ལས་སྐུ་རྡོ་རྗེ་མ་དཀར་མོ།",
    "མགྲིན་པར་ཨཱ་ལས་གསུང་རྡོ་རྗེ་མ་དམར་མོ།",
    "གྲུ་མོ་ན་ཁ་ཊཱཾ་ག་འཛིན་ཅིང་རོའི་སྟེང་ན་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་གར་གྱིས་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པར་བསམས་ལ་ཨོཾ་ཁེ་ཙ་རཱི་བཛྲ་སྭ་བྷཱ་ཝ་ཨཱཏྨ་ཀོཧཾ།",
    "ཨོཾ་ཨེ་ཧྱ་ཧི་བྷ་ག་ཝཱན་མ་ཧཱ་ཀཱ་རུ་ཎི་ཀ་པཉྩ་ཀུ་ལ་ས་པ་རི་ཝཱ་ར་བཛྲ་ས་མཱ་ཛ་ཞེས་བརྗོད་ལ་ལྷ་མོ་བརྒྱད་ཀྱིས་མཆོད་ཅིང་།",
    "ཁྲོ་བོ་ཁྲོ་མོ་རྣམས་ཀྱིས་བགེགས་བསྐྲད་པར་བསམ་ཞིང་།",
    "གཙོ་བོ་ཡབ་ཡུམ་གཞན་བཞི་ལ་རང་རང་གི་རིགས་ཀྱི་བདག་པོས་དབུར་བརྒྱན་པའི་རྣམ་སྣང་གི་སྤྱི་བོར་འཁོར་ལོ་དཀར་པོ།",
    "འཁོར་འཁོར་། གྱི་ལྷ་མོ་བྱང་ཤར་བ་དང་ཤ་ཕྱོགས་པ་རྣམས་ལ་མི་བསྐྱོད་པ།",
    "རང་རང་གི་གཙོ་བོས་དབུར་བརྒྱན་པ་འདི་ཉིད་གུར་ལེའུ་དང་པོའི་དག་པའི་སྐབས་དང་།",
    "མི་ཐུབ་ཟླ་བའི་གཞུང་གི་དགོངས་པ་ཡིན་ནོ།",
    "གྱི་ལྷ་མོ་རྣམས་ལ་རང་རང་གི་གཙོ་བོས་དབུར་བརྒྱན།",
    "ཨོྃ་བཛྲ་ཨ་མྲྀ་ཏ་ཀུནྜ་ལི་ཧ་ན་ཧ་ན་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "སྟོང་པའི་ངང་ལས་ཡཾ་ལས་རླང་གི་དཀྱིལ་འཁོར་གཞུ",
    "ཟླ་བའི་སྟེང་དུ་ཤར་དུ་གོ་ལས་བ་གླང་གི་ཤ།",
    "ཤ་ལྔ་པོ་རེ་རེའི་སྟེང་དུ་ཤར་དུ་བྷཾ་ལས་དྲི་ཆེན།",
    "དེ་ཐམས་ཅད་ཀྱི་སྟེང་གི་ནམ་མཁའ་ལ་ཨཾ་ཡིག་དཀར་པོ་མགོ་ཐུར་དུ་ལྟ་བ།",
    "དེའི་སྟེང་དུ་ཧཱུཾ་ལས་རྡོ་རྗེ་ཧཱུཾ་གིས་མཚན་པ་བསམ་པར་བྱའོ།",
    "དེས་ཐོད་པའི་ནང་གི་ཤ་ལྔ་དང་བདུད་རྩི་ལྔ་པོ་ཐམས་ཅད་བསྐོལ་ཞིང་ཞུ་བའི་རླངས་པ་གྱེན་དུ་སོང་བ་ཨོཾ་དང་རྡོ་རྗེའི་ལྟེ་། བའི་ཧཱུཾ་ལ་ཕོག།",
    "རྡོ་རྗེ་ཉི་མ་ཨོཾ་དང་བཅས་པ་ཐོད་པའི་ནང་དུ་ལྷུང་སྟེ་འོད་དུ་ཞུ་ནས་དམ་ཚིག་གི་བདུད་རྩི་དང་གཉིས་སུ་མེད་པར་གྱུར་ཏེ།",
    "དེ་ནས་རང་དང་ལྷ་ཐམས་ཅད་ཀྱི་ལྕེ་ལ་རྡོ་རྗེ་བཅོ་བརྒྱད་ནས་འབྲས་ཙམ་རེ་བསམས་ལ་དེ་ལས་འོད་བྱུང་ནས་བདུད་རྩི་གསོལ་བས་ཚིམ་ཞིང་དགེས་པར་མོས་ཏེ།",
