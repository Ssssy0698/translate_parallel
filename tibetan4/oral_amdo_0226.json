    "དྲུག་གི་རྗེས་སུ་སྐྱེས་སོགས་གླུ་ཡི་རིགས།",
    "ལག་སྟབས་འདུག་སྟངས་ངག་གི་འདྲེན་པའོ།",
    "ཡེ་ཤེས་ཚོགས་བསག་སྔོན་དུ་སོང་ནས།",
    "ཐོག་མར་སའི་ལྷ་མོ་ལ་བསླང་བ་ནི།",
    "སའི་ལྷ་མོ་ལ་བསླང་བའི་སྐབས་ཀྱི་ཚིག་ལྷུག་པ་བརྗོད་དེ་དྲིལ་བུ་གསིལ་བར་བྱའོ།",
    "རོལ་མོའི་སྒྲ་དྲག་ཏུ་བྱའོ།",
    "ས་ཕྱོགས་ནམ་མཁའི་རང་བཞིན་དུ་བསམ་མོ།",
    "དཀྱིལ་འཁོར་གྱི་ས་གཞི་དེར་ཐུན་མོང་བའི་སྲུང་བའི་འཁོར་ལོ་དང་།",
    "ཕྱོགས་བཞིའི་སློབ་དཔོན་གྱིས་དགའ་ཆེན་ཁྱོད་བདག་ལན་གསུམ་གྱིས་གཙོ་བོ་ལ་གསོལ་བ་གདབ།",
    "མཛུབ་མོ་གཉིས་རྩེ་སྤྲད་པའི་ཕྱག་རྒྱ་སྤྱི་བོར་བཟློག་སྟེ།་",
    "ཧཱུྃ་བཛྲ་། ཨུཏྟིཥྛ་རང་གིས་བསྒོམས་པའི་རྟེན་དང་བརྟེན་པར་བཅས་པའི་དཀྱིལ་འཁོར་ནམ་མཁར་བཞུགས་ཏེ།",
    "རྐང་པ་གཉིས་རེས་མོས་ཀྱིས་མདུན་ནས་བསྐོར་ཏེ་གཡབ་ཀྱིན་འགྲོ་བའོ།",
    "གཡས་པ་སྤོ་བའི་ཚེ་གཡོནཕྱོགས་སུ་བྱ་བ་རེས་མོས་སུ་བྱ་བའོ།",
    "གཡོན་དྲིལ་བུ་དང་བཅས་པ་། བརྐྱངས་ཏེ་གསིལ་བ་རེས་མོས་ཀྱིས་འགྲོ་བའོ།",
    "གོམ་སྟབས་བཞི་པོ་འདི་དག་ལ་ཧཱུཾ་ཐུང་རེ་རེ་བརྗོད་པར་བྱའོ།",
    "ཕྱོགས་རེ་རེ་ལ་གར་བཅའ་བ་གསུམ།",
    "ཚུལ་དང་པོ་ལྔ་ལ་ཕྱག་རྒྱ་རེ་རེའང་བཅའ་ཐེབས་ལན་གསུམ་གསུམ་བྱ།",
    "དབུས་སུ་མདུང་གི་ཚུལ་ཡང་དེ་དང་འདྲ།",
    "ལག་པ་གཉིས་རྒྱབ་སྦྱརབའི་མཛུབ་མོ་གཉིས་དང་།",
    "ཕྱག་རྒྱ་སྔར་གྱི་ལ་མཛུབ་མོ་གཉིས་བསྒྲེང་བ་དང་བཞིན་ཁྲོས་པའོ།",
    "ས་ག་ནི་གཡོན་སྔོན་འགྲོའི་རྐང་པ་གཉིས་ཅུང་ཟད་བགྲད་པའི་བར་ཁྲུ་གང་དང་སོར་གཉིས་སུ་བྱས་ཏེ་པུས་མོ་དྲང་པོར་བསྲང་།",
    "ཟླུམ་པོ་ནི་གཡས་སྔོན་འགྲོའི་རྐང་པ་བགྲད་པའི་པུས་མོ་གཉིས་ཀྱི་བར་ཁྲུ་དོར་བྱས་ཏེ་ངང་པའི་གཤོག་པ་ལྟ་བུ་དང་།",
    "མཐེའུ་ཆུང་དང་མཛུབ་མོ་གཉིས་ཕན་ཚུན་སྦྲེལ་བ་འཁོར་ལོ་བསྐོར་བ་ལྟར་བྱས་ནས་གཡས་ཕྱོགས་སུ་གྱེན་ལ་འཕྱར་བའི་ཚུལ་ལོ།",
    "རལ་གྲི་ནི་གཡས་པའི་མཐེ་བོང་སྲིན་ལག་དང་མཐེའུ་ཆུང་གིས་མནན་ནས་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་ཤུབས་ནས་ཕྱུང་ནས་ཕྱར་བའོ།",
    "མདུང་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཛུབ་མོ་གཉིས་བསྒྲེངས་ནས་གཡས་གཡོན་དབུས་གསུམ་དུ་བསྣུན་པའི་ཚུལ་ལོ།",
    "གཏུན་ཤིང་ནི་གཏུན་ཤིང་གིས་འབྲས་དྲུ་བའི་ཚུལ་ལོ།",
    "རྡོ་རྗེ་རྩེ་གཅིག་པ་ནི་རྡོ་༡༥༩རྗེ་བསྡམས་པའི་གུང་མོ་གཉིས་བསྒྲེང་བའོ།",
    "ཁ་བཅུ་པ་ནི་སྙིམ་པའི་སོར་མོ་བཅུ་ཕྱོགས་བཅུར་གདེངས་ནས་བསྐྱོད་པའོ།",
    "བ་དན་གཉིས་དང་གསུམ་ནི་གཡས་པའི་སོར་མོ་གཉིས་དང་གསུམ་སྟོན་པའོ།",
    "སེམས་ཀྱིས་རྡོ་རྗེའི་ས་གཞིར་བསྒོམ་མོ།",
    "པདྨའི་ནི་ལོང་བུ་གཉིས་བསྣོལ་ནས་བོལ་གཉིས་མ་རེག་པར་མཐེ་བོང་གཉིས་རྩེ་སྤྲད་དེ།",
    "བཀྲ་ཤིས་ཤིང་བདུན་གཉིས་བར་མཐོ་གང་ཙམ་དུ་བྱས་ཏེ་ཙོག་པུ་བ་འཇོ་བའི་ཚུལ་དུ་འདུག་ནས་ལག་པ་གཉིས་པུས་མོ་སོ་སོའི་སྟེང་དུ་རྐྱལ་བ་དང་རྨད་དུ་བྱུང་བའི་ཞལ་ལོ།",
    "གཡས་པས་ཕྱག་མཚན་འཛིན་པའི་ཚུལ་དུ་པུས་མོ་གཡས་ཀྱི་སྟེང་དུ་གཞག་པ་དང་རྨད་དུ་བྱུང་བའི་ཞལ་ལོ།",
    "རྒྱུད་འདིར་དང་པོ་དྲུག་གིས་ཀྱང་ཆོག་གོ།",
    "གླུའི་བཀོད་པ་རྣམས་ཀྱང་རང་རང་གི་ཉམས་ཅི་ལྟ་བ་བཞིན་དུ་བྱའོ།",
    "ཞེས་སོགས་ལན་གསུམ་གྱིས་བགེགས་ལ་བཀའ་བསྒོས་ཏེ་རེ་རེའི་མཚམས་སུའང་རོལ་མོ་དྲག་ཏུ་བྱའོ།",
    "རེ་རེ་ལའང་ཉུངས་ཀར་གྱི་ཐུམ་བུ་དང་དར་དམར་པོའི་། ཅོད་པན་གྱིས་བརྒྱན།",
    "གཡོན་པའི་པུས་མོ་ས་ལ་བཙུགས།",
    "དེའི་ཚེ་རོལ་མོའི་སྒྲ་དྲག་ཏུ་བྱའོ།",
    "ཆོ་གའི་ཚུལ་འདི་རྒྱུད་དང་གཞུང་བཟང་གི།",
    "དེ་ལ་རྩ་བའི་རྒྱུད་ཀྱི་བརྟག་པ་དང་པོའི་ལེའུ་དང་པོ་ལས་ལྷ་མོ་བཅོ་ལྔའི་རང་བཞིན་གྱི་རྩ་སུམ་ཅུ་རྩ་གཉིས་གསུངས།",
    "བརྒྱད་པར་སྦས་པ་ལྟར་ན་ཉེ་རྒྱུ་སྟོན་མོད་ཀྱི།",
    "སྤྱི་དོན་ལྟར་ན་ལྷ་མོ་བཅོ་ལྔའི་རྟེན་དང་བརྟེན་པར་བཅས་པའི་བསྐྱེད་རིམ་གསུངས།",
    "ཞེས་རྒྱུད་འདིའི་ལུགས་ཀྱི་ཚེ་འདི་ལ་ཕྱག་ཆེན་མཆོག་གི་དངོས་གྲུབ་སྒྲུབ་པའི་རྟེན་ལ་ཧེ་རུ་ཀ་ཕྱག་བཅུ་དྲུག་པའམ།",
    "བདག་མེད་མ་གང་རུང་གི་རྣལ་འབྱོར་དགོས་པ་ཙམ་ཞིག་བསྟན།",
    "བཞི་པར་ལྷ་མོ་བཅོ་ལྔ་ལ་ཕྱག་རྒྱ་གང་གིས་རྒྱས་འདེབས་པ་དང་།",
    "རྩ་སོ་གཉིས་ལྷ་མོ་གང་ཡིན་པ་སོགས་གསུངས་སོ།",
    "ཁྱོད་ཀྱི་འཁོར་ལོ་ཇི་ལྟར་ལགས།",
    "བྱང་ཕྱོགས་སོ་བདུན་གང་གི་ངོ་བོ་ཡིན་པ།",
    "ས་གང་གི་རྟོགས་པ་བསྐྱེད་པ་དང་རྣམ་པ་ལྔ་ལྔར་། གནས་པ་ནི་དང་པོའི་དང་པོ་དང་།",
    "བཅོ་ལྔ་པ་རྣམས་ལྷ་མོས་སྦྱོང་ཞིང་།",
    "ལྷ་མོ་གང་།",
    "ཕྱི་ནང་གི་བསྐྱེད་པའི་རིམ་པ་དེ་དག་ནི་བདག་མེད་མའི་བསྟོད་པ་རྩ་འགྲེལ་གྱི་སྟེང་དུ་རྟོགས་པར་བྱ་ཞིང་།",
