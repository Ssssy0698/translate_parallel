    "བྱ་ཀུན་ལ་ཐོགས་མེད་འཇུག་པ་རང་རང་ཆད་པ་མེད་ཅིང་ཟད་པ་མེད་པའི་མཚན་ཉིད་ཅན་ནོ།",
    "རང་བཞིན་ནི་ཁོ་རང་ཙམ་ལས་དགག་བྱ་དོར་བའི་འཛིན་སྟང་ཕར་ཆེར་འདྲ་ལ།",
    "པར་འདུག་གོ།",
    "ཏིང་ངེ་འཛིན་དེ་ཐོབ་མ་ཐག་པདྨ་དེ་ལ་འདུག་པར་སྣང་ངོ།",
    "དེ་དེ་ལ་འདུག་པ་དང་།",
    "དེ་ཡང་རང་འགྲེལ་ལས།",
    "འཇིག་རྟེན་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཞན་སྐྱེ་མེད་པས་འཇིག་རྟེན་པའི་མི་གནོད་པའི་ཚུལ་གཉིས།",
    "གཉིས་པ་འཇིག་རྟེན་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱི་གཞན་སྐྱེ་མེད་པར་སྟོན་པ།",
    "གང་ཕྱིར་མྱུ་གུགཉིས་པ་ཀུན་རྫོབ་ཙམ་དུའང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པར་སྟོན་པ་ལ།",
    "ཀུན་རྫོབ་ཏུ་ཡང་རང་བཞིན་གྱི་སྐྱེ་བ་བཀག་པ་དང་།",
    "གཉིས་པ་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་དགག་པའི་ཕན་ཡོན་ལ།",
    "ཞར་བྱུང་རང་ལུགས་ལ་རང་རིག་མེད་ཀྱང་དྲན་པ་སྐྱེ་ཚུལ་གཉིས།",
    "རྒྱུ་ཡང་རང་བཞིན་མེད་པར་བསྟན་པ་དང་གཉིས།",
    "ཇི་ལྟར་རབ་རིབགཉིས་པ་རྒྱུ་དེ་ཡང་རང་བཞིན་མེད་པར་བསྟན་པ་ནི།",
    "ཇི་ལྟར་བརྗོད་ཀྱང་རང་བཞིན་མེད་པའི་ཕྱོགས་སུན་འབྱིན་མི་ནུས་པའི་ཚུལ་གྱིས་མཇུག་བསྡུ་བ་གསུམ།",
    "འགྲོ་འདུག་ཉལ་འཆག་ལ་སོགས་པའི་སྤྱོད་ལམ་ཅི་བྱེད་ཀྱང་གང་ཤར་ཐམས་ཅད་གཉིས་མེད་ཡེ་ཤེས་དེའི་ངང་དུ་རོ་མཉམ་པར་བལྟ་བ་ཡིན་ཏེ།",
    "དེ་ཡང་རང་ཉིད་དམན་ས་བཟུང་ནས་ཡིད་གུས་པས་ཞུ་བའི་དོན་ནོ།",
    "དེ་ཡང་རང་ཉིད་བློའི་སྐྱོན་ཡིན་ནམ་ཡིག་སྐྱོན་ཤོར་བ་གང་རུང་ཞིག་ཡིན་པ་འདྲ་སྟེ།",
    "རང་རང་ཕྱོགས་སུ་ལྷུང་བའི་འདོད་ཞེན་གྱིས།",
    "སྤྱོད་ལམ་ཐམས་ཅད་དུའོ་ཞེས་པ་ནི་ལྡང་བ་འདུག་པ་དང་ཉལ་བའི་སྟེ་འཆག་པ་ཞེས་བྱ་བ་སྟེ་བཞི་ལའོ།",
    "སྡིངས་ཁ་སྒར་པ་དགོན་ནས་མན་ཐང་ད་ལྟ་མན་ཐང་ཞེས་འབྲི་ནའང་སྔོན་གནས་དེར་མ་ཎིའི་གདང་རིང་པོ་ཞིག་ཡོད་པ་ལ་ལས་མན་ཁྲིའང་ཟེར་འདུག་བར་ཕྱིན།",
    "མཁའ་འགྲོ་སྤྱན་གདོང་རང་བྱོན་ད་ལྟའང་མཇལ་རྒྱུ་ཡོད།",
    "འོན་ཀྱང་ཇུན་གར་དམག་དུས་རྩ་གཏོར་བཏང་ནས་ལྷ་ཁང་སོ་ལྟ་ཁང་དང་།",
    "དེའང་སྐྱོབ་པ་འཇིག་རྟེན་གསུམ་དགོན་གྱིས་གནས་བྱང་ཕྱོགས་རྒྱུད་དུ་གཤེགས་ཙ་ན།",
    "འོན་ཀྱང་ཇུན་གར་དམག་དུས་བཀའ་རྙིང་སྤྱི་མཚུངས་དགོན་དེའང་རྩ་གཏོར་བཏང་།",
    "པ་ཁ་ཤས་ཡོད་འདུག་ཀྱང་མིང་མ་བྱུང་།",
    "རྗེས་སུ་རྟེན་རྫས་ཁ་ཤས་ལུང་དཀཪ་དགོན་ལ་སླཪ་ཡང་རང་སློག་ཏུ་བྱུང་དང་ཁྱུང་ནག་རྒྱལ་བ་བསྟན་འཛིན་སོགས་ཀྱིས་སླར་ཡང་དགོན་གནས་དེ་ཉིད་བསྐྱར་འཛུགས་གནང་།",
    "ཀླུ་མཁར་དགོན་གྱི་ཁ་འཛིན་ག་དུས་གནང་བ་མི་གསལ་ཡང་ཕྱིས་རིག་འཛིན་གཡང་སྐྱོབ་དང་།",
    "སླར་ཡང་རྒད་པོ་སོས་དལ་འདུག་ཐབས་རང་མ་བྱུང་།",
    "ནོར་གླིང་ས་གཞིའི་རིན་ཐང་བརྗོད་ཐབས་རང་མིན་འདུགརི་དྭགས་གཅན་གཟན་རང་ཁ་རང་ཉིད་ཀྱིས་གསོས་ཀྱང་།",
    "རང་རང་ཚེ་ཚད་ཇི་ཡོད་ཟད་ཟད་ལ་སྡོད་ཆོགའོན་ཏེ་མགོ་ལ་རྭ་ཅོ་བང་རྩལ་གྱིས་ཕྱུག་ཅིང་།",
    "རྡོ་རྗེ་འཆང་རང་ཉིད་ནས་ཀྱང་ཟ་བྱེད་མཁའ་འགྲོའི་སྦྱིན་སྲེག་དང་དམ་ཚིག་རྡོ་རྗེའི་བཟླས་པ།",
    "རྗེ་གཅིག་ཆོག་ཁྱེད་རང་མཁྱེན་ལགས་པས།་།",
    "ཐོ་ཡོན་དར་རྒྱས་ནས་བསྐུལ་མ་ཞུས་ངོར་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་ཀུན་གསལ་ཤེས་རབ་མཆོག་སྦྱིན་ཞེས་པ་དང་།",
    "སྐུ་མཚམས་གྲོལ་རྗེས་གོང་མ་ཆེན་པོའི་བཀས་མངགས་པའི་མི་དྲག་ཡུ་ཨ་ཧན་ཨམ་པ་སོགས་དཔོན་ཁག་གསར་འབྱོར་རྣམས་ཀྱི་གདོང་གསེར་ཡིག་གནང་རྟེན་དང་བཅས་འདུག་པ་བཞེས་ཤིང་མི་དྲག་རྣམས་ལ་དཀར་སྤྲོ་སོགས་རྒྱས་པ་སྩལ།",
    "འདི་སྐབས་ཝང་ད་ལའི་ནས་ནན་ཏན་ཆེན་པོས་འབྲུམ་ཡོལ་གྱི་ཆེད་རྭ་སྒྲེང་ལྟ་བུར་ཕེབས་དགོས་ཞེས་ཞུས་རུང་རིམས་དན་ད་མི་རིང་བ་ན་ཆད་འགྲོ་བས་མཆོག་གསུམ་ལ་གསོལ་བ་བཏབ་སྟེ་འདི་ག་རང་དུ་སྡོད་པ་ལེགས་ཞེས་བཀའ་ཕེབས་ཏེ་བཞུགས་འདུག་པ་ནི་འགྲོ་བ་རྣམས་བྱམས་པས་མི་གཏོང་བའི་རང་རྟགས་སུ་མངོན་ནོ།",
    "འཕྲལ་གྱི་འདོད་ཡོན་ཟ་ཟིར་ཐམས་ཅད་ལ་བདག་དེ་རིང་རང་ཡང་མི་འཆི་བའི་ཆ་མེད་པ་ལ་འདི་དག་བྱུང་བས་ཅི་རང་བྱེད་སྙམ་དུ་ཞེ་ནས་ཆགས་ཞེན་གྱི་འཆིང་བ་ལྷོད་གང་ཐུབ་དང་།",
    "བྱང་སེམས་དང་གསང་སྔགས་ཀྱི་སྡོམ་པ་ལ་དེང་སང་གཏམ་ཙམ་ཞིག་ལས་ལག་ལེན་བྱེད་མི་སྲིད་མཐའ་རུ་འདུག་པས་ན།",
    "དེང་སྔོན་ཆད་གྲུབ་པ་ཅང་གདའ་འམ།",
    "ཁྱེད་རང་ལུས་འདི་ལ་ཁུར་དུ་ལྟོས།",
    "ཚུལ་ཇི་ལྟར་འདུག་སྙམ་རྟོག་དཔྱོད་ངོས།",
    "གོང་མ་ཆེན་པོར་མཚམས་ཞུར་འགྲོ་མི་མཁན་ནང་ཚུར་འབྱོར་གྱི་གདོང་གསེར་ཡིག་རྟེན་བཅས་འདུག་པ་རྣམས་བཞེས།",
    "འདི་ལོ་ཆིབས་སྒྱུར་གནང་ཐུབ་པ་བྱུང་ན་བསྟན་འགྲོར་བཀའ་དྲིན་ཆེན་པོ་ཡོད་པ་འདུག་ཚུལ་གྱི་བཀའ་ལན་ཡང་འཕྲལ་མར་གནང་།",
    "གཉིས་སུ་ཝང་ཁོ་རང་ཡང་རིང་པོར་མི་ཐོགས་པར་རྐྱེན་ངན་གྱི་ལམ་དུ་འགྱུར་བའི་ལྟས་སུ་མངོན་ནོ།་",
    "འཆི་བདག་དུས་ཀྱི་ཕོ་ཉས་མདུན་བསུས་པའི།",
    "སེམས་དཔའ་སྤྲུལ་པའི་སྐུ་ནས་གསོལ་བ་བཏབ་པ་བཞིན་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་དང་།",
    "རང་གཞན་མང་པོ་འཕུང་བའི་ཐབས་ཚུལ་ལ་རིངས་པ་ལྟ་བུ་ཞིག་བྱེད་ཡོད་འདུག་པ།",
    "ལས་ཀྱི་རིག་སྔགས་ཀྱིས་རྨོངས་པ་ལྟ་བུས་བཀའ་ལ་བརྩི་བ་ཞིག་མ་བྱུང་འདུག་ཀྱང་།",
    "སྐུ་འཁོར་ཉུང་རགས་དང་བཅས་ཐུགས་རྗེ་ཆེན་པོ་རྒྱལ་བ་རྒྱ་མཚོ་དང་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་བདག་འཇུག་བཞེས།",
    "ཙ་ན་ཡིན་ཡང་ཡི་དམ་རྣལ་འབྱོར་ལ།",
    "བསྐུལ་ཡང་རང་ཕྱོགས་འཇོམས་བྱེད་པའི།",
    "ཝང་ད་ལའི་བཱ་ཐུར་ནས་སེམས་མི་དགའ་བའི་བྱེད་སྒོར་བརྟེན་དགོངས་ཁྲོལ་མི་ཞུ་མཐུ་མེད་བྱུང་འདུག་པར།",
    "སྐུ་སྙེ་བཞུགས་གདན་སོགས་རིན་ཐང་བརྒལ་བ་དུ་མ་སྩལ་འདུག་པ་རྣམས་ཀྱང་བཞེས་ཤིང་།",
    "དེ་འཕྲལ་ཏཱ་ཞིན་གཉིས་ནས་གོང་མའི་བཀའ་ཡིན་ཚུལ་གྱིས་གུང་པཎྜི་ཏར་བོད་ཀྱི་ལས་དོན་བྱེད་དགོས་རྒྱུའི་ཕྱག་མདའ་སྐྱེལ་བར་བཱ་ཙོང་ཞིག་བཏང་སྟེ་སྤྲད་འདུག་པས།",
    "བློན་པོ་དང་དམག་ཐམས་ཅད་ཟད་ཟད་དུ་བཅོམ་འདོད་སོགས་མནོ་བསམ་ཕྱིན་ཅི་ལོག་གྲངས་ཀྱིས་མི་ལང་བ་འདུག་ངེད་ཀྱིས་མནོ་བསམ་ཞིབ་ཏུ་བཏང་ན་གཙོ་ཆེར་འགྱུར་མེད་རྣམ་རྒྱལ་ངང་ཚུལ་ངན་པ་ལས་བྱུང་ཡང་།",
    "ཨམ་བན་གཉིས་ཀྱི་བསམ་པར་དབུས་གཙང་ལ་ཉིན་གཅིག་ཀྱང་འགོ་བ་བྱེད་པའི་མི་མེད་ན་མི་རུང་བསམ་འདུག་ཡང་པཎྜི་ཏ་ནས་འཕྲལ་དུ་དམག་དཔུང་འཁྲིད་ནས་ཕན་གྲོགས་བྱེད་ཡོང་བསམས་ནས་སྟབས་གཅིག་ཏུ་གང་འོས་པ་དབྱེ་འབྱེད་བྱེད་ཆུག་སྙམ་དུ་ལབས་འདུག་པཎྜི་ཏ་ནས་ངེས་པར་བསམ་ཚོད་མཐུན་པར་ངོ་ལོག་མི་རྣམས་ཚར་བཅད་ནས་གསོད་པ་དང་།",
    "འགྱུར་མེད་ཚེ་བརྟན་སྔར་ནས་ལོག་པ་མེད་ཅིང་ཉེས་མེད་དུ་བསད་འདུག་པས་ངེས་པར་དག་ཚངས་བྱེད་འོས་སུ་འདུག་པཎྜི་ཏར་གཏད་ནས་འགྱུར་མེད་ཚེ་བརྟན་གྱི་བུ་བརྩད་བཅད་ནས་ངེད་ཀྱི་བཀའ་ཕབ་སྟེ།",
    "ཁྱད་པར་དུ་ཆུང་དུས་རྗེ་ཉིད་ལན་ཅིག་མཇལ་རུང་ད་ལྟ་ཚེ་མཇུག་ལའང་མཇལ་རྒྱུ་བྱུང་བ་སྐལ་བ་བཟང་པོ་བྱུང་ཞེས་ཁོ་རང་ཡང་སྤྲོ་བ་ཆེ་ཞིང་ཅིས་ཀྱང་ཞབས་འདེགས་ལ་ལྷག་བསམ་བཟང་པོས་འབད་བྱེད་རྒྱུ་ཡིན་ཚུལ་ཞུས་པ་བཞིན་གྱིས་ཐོག་ཏུ་ཁེལ་བ་བྱུང་སྣང་།",
    "གོས་ཡུག་ཆེན་མང་པོ་བཅས་གནང་འདུག་པ་ཕུལ།",
    "བོད་འབངས་སྤྱི་ལའང་ཕན་པ་མ་བྱུང་འདུག་པས།",
    "སྐུ་ཚ་ཞབས་ཕྱི་སོགས་ལ་གཞན་དོན་དུ་གཤེགས་དགོངས་ཀྱི་ཕེབས་སྒོ་མང་དུ་གནང་འདུག་པར་བརྟེན།",
    "བཀའི་ཕེབས་སྒོར་ངེད་དེ་ཙམ་གྱི་ལུས་ཟུངས་ངན་པ་མི་འདུག་ཆུ་ཚན་ལ་འགྲོ་ཐུབ་ན་ཞེས་དང་།",
    "ལམ་དུ་མི་སྐྱོན་ཙམ་གྱི་གདེངས་བན་རྒན་ང་རང་ལའང་ཡོད་རུང་གཙོ་ཆེར་ནི་ཁྱེད་ཀྱི་ཐུགས་རྗེས་སྐྱོངས།",
    "བོད་ཀྱི་མི་རྗེ་སྲོང་བཙན་སྒམ་པོ་ནས་བཟུང་ད་ལྟའི་བར་དུ་དེ་རིགས་ཀྱི་སྲོལ་མི་འདུག་པར་མ་ཟད།",
    "འགྲོ་འདུག་སོགས་སྤྱོད་ལམ་བག་ཡོད་པ་བྱེད་དགོས་པའི་ཞལ་ཏའང་གནང་།",
    "ཐའི་ཇི་ཧ་དུན་སོགས་ཀྱིས་ཀྱང་འབུལ་བསྐུར་སྤམས་མཐོ་འདུག་པ་རྣམས་བཞེས།་།",
    "ཇུན་ཝང་རང་ལ་ཨེར་ཏེ་ནི་དའི་ཆིང་ཧོང་ཐའི་ཇི་ཞེས་པའི་ཆོ་ལོ་དང་ཐམ་ག་རྟ་ཐུག་གྱོན་པ་ཆ་ཚང་བཅས་ལེགས་སྐྱེས་རྒྱ་ཆེ་བ་གནང་།",
    "ཡིད་སྨོན་འོས་ཆ་ཙམ་མི་གདའ་བས།",
    "ནག་ཚང་ཨ་ཇོ་དཔལ་བཟང་།",
    "དེར་རྒྱལ་བ་གོང་མ་རིམ་ཕེབས་ཀྱིས་བཞུགས་པའི་རྡོ་ཁྲི་ཞིག་འདུག་པའི་སྟེང་དུ་བཞུགས་ཏེ།",
    "དེ་ནས་སྒྲུབ་ཕུག་འོག་ཏུ་རྗེ་ཉིད་སྐུ་རྐྱང་ནས་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་ལྷ་ལྔའི་ཆོ་ག་དང་།་",
    "རྗེ་བཙུན་འཇམ་དཔལ་དབྱངས་ལ་བསྟོད་པ་འཇམ་དབྱངས་མཉེས་པར་བྱེད་པའི་བསྟོད་སྤྲིན་རྒྱ་མཚོ་བཅས་གསུངས་ཤིང་རང་བྱོན་རྣམས་ལ་དངུལ་གྱི་མཎྜལ་དང་བཟང་གོས་ཀྱི་ཡོལ་བ་སོགས་མཆོད་རྫས་དུ་མ་དང་།",
    "འཕྱོས་ལམ་རིམ་པ་སོགས་དུ་མ་བྱུང་འདུག་ཐང་ཆེན་བླ་གྲྭ།",
    "ས་འདིར་བཀྲ་ཤིས་སྤེལ་བའི་བྱེད་པོ་རང་ལོས་ཡིན།",
    "མཁའ་མཉམ་ཡིད་ཅན་ཀུན་གྱི་མགོན་སྐྱབས་རང་ལོས་ཡིན།",
    "བདག་ཅག་སྐལ་ལྡན་གདུལ་བྱའི་གདུང་སེལ་རང་ལོས་ཡིན།",
    "ལྷག་པར་སྔོན་མ་དེ་དུས་ཆབ་ཞག་ཡུན་ཐུང་བའི་སྟབས་ཧ་ཅང་རུས་ཆོད་མ་བྱུང་བ་ཡིན་འདུག་པས།",
    "ཨམ་བན་གཉིས་རང་མཚམས་ཞུར་ཡང་ཡང་འོངས་ཏེ་ཆབ་སྐུ་ལ་འཇུག་མིན་དང་ས་འདི་བཞུགས་ཉམས་སྤྲོ་བ་བཅས་ཡུན་རིང་ཙམ་འཕྲོད་བཞེས་བསྐྱངས་ན་ཐུགས་རྗེ་ཆེན་པོ་ཡོང་བ་འདུག་ཚུལ་སོགས་ཞུས།་",
    "སོ་སོའི་ཕྱོགས་ཀྱི་སེར་སྐྱ་མཆོག་དམན་གྱི་སྐྱབས་ཞུའི་རྟེན་ཆེས་མང་དུ་འདུག་པ་རྣམས་ཕུལ།",
    "ད་ཆ་སྐུ་འཁྲུགས་མྱུར་དུ་སིང་གདངས་དང་ཞབས་པད་ཡུན་རིང་བརྟན་པའི་ཐུགས་རྗེའི་མཐུ་དཔུང་བསྐྱེད་པ་ཞིག་མཁྱེན་མཁྱེན་ཞུས་འདུག་པར།",
    "དེ་རིང་ཡང་ཞག་དུས་ལ་སླེབས་པ་ཡིན་འགྲོ་བས་དེ་འདྲའི་ཐུགས་ངལ་མཛད་མི་དགོས་ཕེབས།",
    "ད་ལྟ་བདེ་མུས་སྟར་ཆགས་འདུག་པས་དགུན་རིང་མཚམས་བཅད་བྱེད་རྒྱུ་དང་།",
    "དེ་སྐྱེལ་བ་དང་མཚམས་ཞུ་བཅས་སུ་མི་དྲག་ཁི་ཡཱ་ཞིག་ཟླ་བ་བཅུ་གཅིག་པའི་ནང་རང་ལ་གང་མགྱོགས་ཐོན་པ་གཏོང་རྒྱུ་ཡིན་ཕེབས།",
    "གོས་དར་སོགས་སྤམས་མཐོ་བ་བཅས་འབུལ་རྒྱུ་འདུག་པ་རྣམས་བཞེས།",
    "ཆ་དཀར་ཁོ་བོད་ཤ་རིའི་ཤོག་དུས་འདས་ནོར་བུ་ཁི་ཡའི་ཆེད་དུ་བསྔོ་རྟེན་འབུལ་མི།",
    "འདི་ལོ་རང་ཁོ་བོ་ཅག་བསྡད་ཡོང་སྙམ་པ་མི་འདུག་ཅེས་པ་སོགས་ཀྱི་ཕེབས་སྒོ་ཅི་རིགས་སྩལ་བར།",
    "འདི་སྐབས་འཁོར་སློབ་འདི་འདྲ་ཡོད་ཟེར་བ་སོགས་ཡོང་རྒྱུ་ཡིན་འདུག་ཅེས་པའི་ཕེབས་སྒོ་ཅི་རིགས་ཀྱང་བྱུང་སྣང་།",
    "སྐྱོན་མེད་ལུས་ངལ་བ་ཙམ་ལས་སྐྱོན་ཆེར་མི་འདུག་པས་ཚོགས་སུ་འགྲོ་རྒྱུ་དང་།",
    "དེ་བས་གཟུགས་ངན་པ་འདི་བདེ་སྐྱིད་མ་བྱུང་བ་རང་འདོད་པ་འདུག་གཟུགས་ངན་འདིར་བརྟེན་པ་ལས།",
    "བཀའ་བློན་སོགས་ནས་ཀྱང་རང་རང་ལ་བབ་པའི་ལས་ལ་འབད་པ་དང་།",
    "དྲུང་ཡིག་བསྐལ་བཟང་བློ་གྲོས་བཅས་ནས་རིམ་པར་སོ་སོའི་བློ་ནུས་དང་བསྟུན་པའི་ཟིན་བྲིས་བཀོད་འདུག་པར་གཞི་བྱས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་དཀར་པོའི་སྒྲུབ་ཐབས།",
    "དེ་ཡང་རང་རིག་པའོ་ཞེས་དང་།",
    "དོན་བཀག་ནས་རང་རིག་འབྲས་བུར་འཇོག་པ་དང་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་འཇོག་པ་གཉིས་ལས།",
    "མཐོང་བྱ་ཤེས་པ་དང་རང་མྱོང་བྱེད་ཀྱི་ཤེས་པས་ལྷན་ཅིག་དམིགས་ངེས་ཡིན་པའི་ཕྱིར།",
    "དེ་མྱོང་རང་རིག་འབྲས་བུ།",
    "གཉིས་པ་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་འཇོག་པ་ནི།",
    "བྱེ་བྲག་འཇམ་མགོན་ས་སྐྱ་པའི་བསྟན་པ་ལ་ཞབས་འདེགས་ཕུན་སུམ་ཚོགས་པ་ཞིག་བྱུང་འདུག་པར་ཤེས་ནས།",
    "ད་དུང་སྒོ་ཁོག་ན་ས་སྐྱ་པའི་བསྟན་པ་རྣམ་དག་འདུག་ཅེས་བསྟོད་བསྔགས་བསྒྲགས་མཛད།",
    "ཁྱེད་ལ་རིག་པ་བཟང་པོ་འདུག།",
    "ཆེས་ཉེ་དུས་ཁོང་རང་ཉིད་ཀྱིས་ཐར་ལམ་དུ་ས་གནས་སློབ་དཔོན་ཞིག་གམ།",
    "རྗེ་འདིས་སྐུ་བརྙན་དེ་༡༤ ལོར་རྒྱ་དམར་གུང་ཁྲན་ལས་བྲོས་དགོས་ཐུག་དུས་བར་ཉར་ཚགས་མཛད།",
    "ཟེར་བ་གསན་ཙ་ན།",
    "དེ་ཡང་མཆོད་རྟེན་ཆེན་པོ་གཅིག་ཁོང་རང་ཉིད་གཅིག་པུས་ས་རྡོ་སྒལ་པས་བསྐྱལ་ནས་བཞེངས།",
    "ཁྱེད་ཀྱིས་ལོ་གཉིས་དེ་ཆུད་ཟོས་ཕྱིན་འདུག་གསུངས།",
    "ཆུང་ཆུང་ཁ་ཤས་བརྔན་པའི་རོ་རྣམས་ཁོང་རང་ལ་མང་བ་བྱས་ཏེ་བགོ་བཤའ་བརྒྱབ།",
    "མིག་ནས་མཆི་མ་འཁྱུག་འདུག་གསུངས།",
    "མི་ཡུལ་དུ་སྐྱེ་བ་ལེན་པ་ལ་དགོས་པ་མི་འདུག་ཚེ་འདི་བརྗེས་མ་ཐག་ཏུ་ནུབ་ཕྱོགས་བདེ་བ་ཅན་དུ་སྐྱེ་བ་ལེན་གསུངས།",
    "མི་ཉག་ནས་ལན་འབྱོར་དུས་ང་རང་ཐར་ལམ་ནས་ཐོན་རན་བསྡད་ཡོད།",
    "གུས་རང་ལོ་མང་རྗེས་སུ་ཕྱིར་ལོག་དུས་ཁྱེད་ག་པར་བཞུགས་ཡོད།",
    "ཁོ་རང་གསེར་དངུལ་མགར་བ་ཡིན་ཀྱང་།",
    "རྗེས་སུ་དུས་ཚེས་བརྩིས་པས་ཧོར་ཟླ་གསུམ་པ་ནག་པ་ཟླ་བའི་ཚེས་ཉི་ཤུ་དགུའི་ཕྱེད་ཡོལ་༡༩༤༡༢རྗེ་འདིས་སྒང་རྒྱུད་དེར་སྐུ་ངལ་གསོས་པའི་ཉིན་དེ་རང་ལ་སྒྲ་སྟོན་སྐུ་གཤེགས་འདུག་ཟླ་ཚེས་འདི་ཐར་ལམ་གྲུབ་ཆེན་ཀུན་དགའ་རྣམ་རྒྱལ་དང་།",
    "ང་རང་འཆི་ས་དགོན་ནང་དུ་དགོས་པས།",
    "ཨེམ་ཆི་ཀུན་བཟང་ཉི་མས་ཁོ་རང་སྒ་ཁོག་གྲྭའུ་དཔོན་གྱི་མཉམ་དུ་འགྲོ་མཁན་ཚོའི་གྲས་ནས་གཅིག་ཡིན།",
    "ཁྱེད་རང་ཉིད་ཀྱིས་མཁྱེན་ཡོང་།",
    "ཁྲི་ལོ་༡༩༤༧༡༣དགའ་ཁྲི་དང་ཕྱག་མཛོད་གཉིས་ཀ་མི་ཉག་ནས་ཡིན་འདུག་ཅིང་།",
    "ལོ་གཉིས་ནང་འབད་བརྩོན་ཤུགས་ཆེས་བུ་ལོན་མ་སྐྱེད་ཆ་ཚང་ཕྱིར་སྤྲོད་གནང་ཐུབ་ཡོད་འདུག་གོ།",
    "ཉིན་ཤས་སྔོན་ནས་གཤེགས་འགྱུར་མཁྱེན་ནས་ཚང་མར་གསུང་འཕྲིན་བཞག་འདུག་ཅེས་ཕྱག་བྲིས་བསྐུར་གནང་།",
    "སྐྱེས་ཆེན་མངོན་ཤེས་ཅན་ཞིག་ཡིན་ཚུལ་བསྟོད་བསྔགས་མཛད་པ་འདི་ལྟར་ང་རང་བོད་དབུས་ཕྱོགས་ལ་ཐོན་ཉེའི་དུས་སུ།",
    "མི་ལེགས་པ་གསུམ་འབྱུང་ཉེན་འདུག་དང་པོ་ནི།",
    "ཁྲིད་གསུང་རྒྱུ་ཕར་ཙམ་འགྱངས་ནའང་།",
    "ཞབས་ཕྱི་ཚོས་རོགས་ཞུ་ཐབས་བྱས་པས་ཁོང་རང་ཉིད་ཀྱིས་ཚུགས་གཟུང་ཐུབ་གསུངས་མཐར་དབུགས་མཐའ་མ་འཕངས་ཏེ་འདས།",
    "ཁོ་ཚོ་ཉེ་སར་སླེབས་དུས་མི་ཁ་ཤས་ཀྱིས་རྒྱ་མི་འདི་ན་འདུག་ཅེས་ཉེན་བརྡ་བཏང་།",
    "འཁྱགས་ཟིལ་སྐྱོབ་ཆེད་ཚང་མ་འཚང་ཀས་མཉམ་འདུག་བྱས།",
    "བྲོས་བཞིན་པའི་སྐབས་འགར་གདོང་དུ་རྒྱ་དམག་ཚོ་ཁག་གབ་འདུག་ཅེས་གནས་ཚུལ་ཐོས་ནས་ལམ་སང་འགྲུལ་ཕྱོགས་བསྒྱུར།",
    "ཡིན་ནའང་ཁྱེད་ཀྱིས་བཀའ་འདྲི་གང་ཞུ་དགོས་ཤེས་ཀྱི་མི་འདུག་གསུངས།",
    "ཇིན་སྲམིཐས་རྗེ་འདི་ལ་ཁོང་རང་ལ་གསུངས་པ་བཞིན་སྒྲུང་གསུངས་ནས་ཕྲུ་གུའི་སྤྲོ་སྣང་འཕེལ་ཐབས་གནང་ན་ལེགས་ཞུས།",
