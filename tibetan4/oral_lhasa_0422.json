    "གསུམ་པ་རྒྱུན་རྫོགས་ལ་རང་ཉིད་དབལ་གསས་རྔམ་པ་ལ་མགྲིན་པར་ལྷ་རྒོད་ཐུགས་ཀར་གཙོ་མཆོག་ཡབ་ཡུམ་བསྐྱེད་དོ།",
    "མི་ལས་ཆུར་གྱུར་ནས་བཀྲུས་དག་ཅིང་དྲི་མ་མེད་པར་བསམ།",
    "ཅེས་སྤྱི་ལྟར་བརྒྱ་རྩ་འམ་ཅི་རིགས་༧བརྗོད་པས་ཐུགས་དམ་གྱི་རྒྱུད་བསྐུལ་ཏེ་ཡབ་ཡུམ་རོལ་པའི་ཐིག་ལེ་མུ་ཏིག་ཞུན་མ་ལྟ་བུ་རྒྱུན་ཆད་མེད་པར་བདུད་རྩིའི་སྣོད་དུ་བབས་སྟེ་ལྟེམ་གྱིས་ཁེངས་པར་བསམ།",
    "དེའི་ཕྱི་རིམ་རམ་ལས་ཧེ་ཤག་མ་བརྒྱད་དང་།",
    "ཁྲོ་གཏུམ་རྔམ་བརྗིད་རྒྱན་དང་ཆ་ལུགས་ཡོངས་སུ་རྫོགས་པར་བསྐྱེད་པ་སྟེ།",
    "ཕན་མེད་གནོད་མེད་མ་ཡིན་མཁྱེན་རྩེ་སྟོབས་དང་ལྡན་ཅེས་གསུངས་པ་ལྟར་བསྐྱེད་ལ།",
    "གཤེན་རབ་རིག་པའི་རྩལ་དང་སྦྱོར་ཅེས་གསུངས་སོ།",
    "དཔེ་ཉི་ཟླ་གཟའ་སྐར་འདྲ་སྟེ་གསལ་ལ་ཡོངས་སུ་རྫོགས་པར་གཤེགས་སོ།",
    "འཇའ་ཚོན་ལྟར་ཡུལ་ཤེས་སྣང་ལ་རང་བཞིན་མེད་པར་ག།",
    "ལ་བ་ཅི་བགྱིས་པ་ལ་འགྱོད་པ་བསྐྱེད་ཅིང་ཕྱིས་མི་བྱེད་པར་དམ་བཅའ་ལ་བཤགས་པའོ།",
    "བྱེ་བྲག་ཏུ་སྔར་གསུང་པ་ལྟར་ཡིན་ལ་ཡེ་ཤེས་ནི་སྤྱན་མིག་རྣམཔར་དག་པས་ཤེས་བྱ་ཐམས་ཅད་མཁྱེན་པ་ཁྱེད་ཀྱི་བཀའ་དང་དམཚིག་མནོས་ནས།",
    "སྒོ་གསུམ་སྐུ་གསུང་ཐུགས་སུ་ཡེ་ནས་གནས་པའི་གཙོ་བོ་གསུམ་དང་འགལ་བ་དེ་བཤགས་པ་དང་།",
    "སད་དོ་སྐུ་ཡི་ལྷ་ལ་རྐོ་ཕུང་ཨུ་དུག་ལུས་ཀྱི་སྒྲིབ་པ་ལ་གཤའ་ཡ་ནི་བཤགས་པས་བྱང་བར་གྱུར་ཅིག་པ་དང་།",
    "ཁྲི་སེག་ཨུ་དུག་ནི་ཡིད་ཀྱི་སྒྲིབ་པ་དག་ཅིང་ཚངས་པར་གྱུར་ཅིག་པའོ།་",
    "འདི་ལྟར་སྣང་བ་ཐམས་ཅད་དོན་དམ་པར་སྐྱེ་མེད་སྟོང་པ་ཉིད་དང་ཀུན་རྫོབ་ཏུ་ལྷ་དང་གཞལ་ཡས་ཀྱི་རོལ་པར་འགྱུར་བར་བསམ་ལ་གཡུང་དྲུང་ལུ་གུ་རྒྱུད་ཀྱི་ཕྱག་རྒྱ་བཅས་ལ་དལ་ལ་བསྐོར་བ་བྱ་ཞིང་བཅད་དེ་མཁའ་ནི་སེམས་ཉིད་ཀྱི་གསལ་ཆ་དང་ཀློང་སྟོང་ཆ་གཉིས་དབྱེར་མེད་པའི་ངང་དེའི་དབྱིངས་སྐྱེ་བ་མེད་པ་ཡིན་ལ་དེ་ལས་གཞན་སྣང་སྤྲུལ་པ་འགག་མེད་དུ་ཤར་བ་ནི།",
    "ཐིག་ལེ་དམར་པོ་བླངས་ཏེ་ལྕེ་སྟེང་དུ་གཞག་པས་འགག་མེད་གསུང་དང་ལྡན་པར་བསམ།",
    "ཕྱག་རྒྱ་གར་སྟབས་སུ་བསྒྱུར་ཞིང་སྣོད་། བཅུད་ལྷ་ཚོགས་ཀྱི་རོལ་པར་བསམ་པ་ལ་བསྟོད་དེ།",
    "མཐིང་ནག་ནི་བོན་ཉིད་སྤྲོས་པར་མི་འགྱུར་བ་ལ།",
    "དོན་དམ་པར་སྐྱེ་མེད་དང་ཀུན་རྫོབ་ཐུགས་རྗེ་རོལ་པའི་སྤྲུལ་པ་གྲངས་མེད་པའི་ཕྱག་རྒྱུར་ལྡན་པ་སྟེ།",
    "ཅེས་བྱ་ལ་འོག་མ་རྣམས་ཀྱང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དེ་ཡང་འཇིགས་པར་སྣང་།",
    "བསྭོ་ནི་དབལ་གསས་ཀྱི་ཐུགས་རྣམ་པར་མི་རྟོག་པ་ལས་གཞན་སྣང་ཁྲོ་བོར་བྱུང་པ་ནི་ཐམས་ཅད་སྟེ།",
    "དེའི་ཡོན་ཏན་གྱིས་ཏིང་ངེ་འཛིན་ནི་དམིགས་མེད་རྣམ་པར་དག་པས་དུས་ལ་བབ་པས་ཐུགས་རྗེས་འཛིན་པ་དང་།",
    "གཡས་ཀྱི་ལ་སོགས་དཀྱུས་ཉིད་དུ་གསལ་ལ་ལྷ་ཆེན་ནི་ལྷ་སྲིན་གདུག་པས་བསྐྱེད་དུ་མེད་པ་དང་།",
    "རྟོགས་པའི་ཐབས་སུ་མདུན་ནས་ཏེ་རང་ལ་གནས་བཞིན་པ་ལ་རྩོལ་བས་གཞན་ནས་བཙལ་བས་མི་རྙེད་པས་ཁུམ་པར་མ་གྱུར་ཅེས་བྱ།",
    "དེའི་ཕྱིར་དཀའ་བ་སྟེ་ཤེས་རབ་རྣམ་གསུམ་སྦྱངས་ཤིང་བརྩོན་འགྲུས་དྲག་པོས་ཉམས་སུ་བླངས་པས་དུས་འདིར་ཏེ་ཉོན་ཤེས་ཀྱི་སྒྲིབ་པ་བྱང་ནས་ལྷ་སྟེ་ཕྱི་བདེརགཤེགས་དང་།",
    "སྤྲོ་བ་སྐྱེད་པར་གྱུར་གཅིག་ཅེས་བྱ།",
    "ཨོཾ་ཡེ་ཤེས་ནི་རང་བཞིན་རྣམ་པར་དག་པས་བསྒྲིབས་སྐྱེམས་མི་མངའ་ཡང་བདག་ཅག་བཀྲེས་སྐོམ་དང་བཅས་པའི་སྒྲིབ་པ་བསལ་བའི་ཕྱིར་དད་འདུན་གྱིས་འབུལ་བ་ནི།",
    "ཞེས་བྱས་ལ་དངོས་གྲུབ་ལ་རོལ་ལོ།",
    "བྲོ་བརྡུང་བ་ལ་། དགྲ་བགེགས་བསྒྲལ་བའི་རྗེས་སུ་གཏོར་གཞོང་སྦུབ་ལ་སྒྲུབ་གཤེན་རྣམས་དབལ་མདུང་ཐོག་པ་འམ་གཡུང་དྲུང་ལུ་གུ་རྒྱུད་ཀྱི་ཕྱག་རྒྱ་བཅས་ལ་དགྲ་བགེགས་སྐུ་དང་ཡེ་ཤེས་ཀྱིས་ཟིལ་གྱིས་ཟགནོན་པར་བསམ་ལ་བརྡུང་སྟེ།",
    "མཁའ་ཀློང་དབྱིངས་འཇིག་འབྲལ་མེདཔ་ནས་ཕྱི་ནང་གསང་བའི་དགྲ་བགེགས་བསྒྲལ་བའི་རྗེས་ཤུལ་ནི་བག་ལ་ཉལ་གྱི་བག་ཆགས་གནོན་པར་བྱེད་པ་སྟེ།",
    "མཁྱེན་ལྡན་སྐྱེས་བུ་རྣམས་ལ་བཟོད་པར་གསོལ།",
    "ཁྱད་པར་དུ་ཡིག་རྙིང་དཔེ་དཀོན་འཚོལ་སྡུད་དང་མྱུར་སྐྱོབ་བྱེད་རྒྱུ་ནི་དེ་བས་ཀྱང་གལ་ཆེན་གྱི་ལས་སུ་འདོད།",
    "མེ་སྒོམ་ཤེས་རབ་འོད་ཟེར་༡ ༨༥༡༡ ༣༢ནས་བརྩམས་གནང་མཛད་པའི་ལྟ་བའི་རིམ་པ་དང་།",
    "ནས་པོད་ཆེན་ལྔའི་ཚན་པ་བྱས་ཏེ་བསྒྲིགས་ཡོད་པ་འདི་ལྟར།",
    "གཡུང་དྲུང་བོན་ཞང་བོད་གནའ་བོའི་རིག་གཞུང་ཞིབ་འཇུག་ཚོགས་པ་གསར་དུ་རྩ་འཛུགས་བྱས།",
    "བོན་གྱི་དཔེ་རྙིང་སྣ་ཚོགས་སྡུད་པསྒྲིགས་བྱས་ཏེ་མི་ལོ་གསུམ་གྱི་རིང་དུ་ཕྱག་ལས་མཛད་ཡོད།",
    "གཙང་གཤེན་རིག་པ་རང་གྲོལ།",
    "༧ རྒྱལ་ཚབ་ཐམས་ཅད་མཁྱེན་པ།",
    "དཀར་ཆག་ཡང་མི་བཅོས་བར་གསུང་བསྐུལ་གནང་བ་དང་།",
    "གཞུང་ལུགས་ཕལ་ཆེར་མ་ཡིག་ལྟར་དུ་སྟོང་༣་ཞེས་པ་ལྟ་བུའི་ཨང་ཀི་ཡང་མ་བཅོས་པར་རང་སོར་དུ་འཇོག་ཅི་ཐུབ་བྱས་པ་ཡིན།",
    "ཀློག་པ་པོ་རྣམས་ཀྱིས་དེ་ལྟར་དགོངས་འཇགས་གནང་རོགས་ཞུ།",
