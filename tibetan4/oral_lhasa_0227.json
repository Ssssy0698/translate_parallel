    "གཏོར་མ་དང་པོ་འདས་པ་ལ་འབུལ་བའི་བར་སྔ་མ་ལྟར་བྱས་ལ།",
    "གཞན་བཞི་པོ་སྤྱི་བསྟབ་བརྗོད་ཅིང་ས་གཙང་སར་བསྐྱལ།",
    "དམ་ཚིག་པ་རྣམས་བདག་ལ་བསྡུས་ནས་སྐྱེ་མཆེད་དང་སྐུ་གསུང་ཐུགས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "དྲག་པོ་རྣམས་མཉམ་པར་བརྩེགས་པ།",
    "བརྒྱད་པ་ན་མ་ཧེ་ནི་བདག་མདུན་ཐམས་ཅད་དུ་ཁྱད་པར་རོ།",
    "དེ་ནས་སྐྱེ་མཆེད་དང་སྐུ་གསུང་ཐུགས་བྱིན་བརླབ་མི་བྱེད་པར།",
    "དེ་ནས་ཡུམ་བསྡུ་བ་ནས་ཐུན་དྷཱི་། མཚམས་ཀྱི་ལྷར་ལངས་པའི་བར་སྔ་མ་བཞིན་བྱས་ནས།",
    "ཞེས་སོགས་ཀྱིས་དག་པ་དྲན་པར་བྱ།",
    "དང་པོ་ས་ལྷ་སྟ་གོན་ནི།",
    "ངོ་བོ་ཉིད་ཀྱིས་སྲིད་བྲལ་བྱས།",
    "། དམ་པའི་སྲིད་པ་བྱེད་པར་ཤོག།",
    "ནངས་པར་དཀྱིལ་འཁོར་འབྲི་བར་བགྱིད།",
    "བྱིན་གྱིས་བརླབ་པར་མཛད་དུ་གསོལ།",
    "ཁྱད་པར་ཅན་གྱི་དོན་ཞུ་བ་དང་།",
    "དེ་དག་ཐམས་ཅད་བཤགས་པར་བགྱི།",
    "བྷཾ་ལས་བུམ་པར་བསྐྱེད་པའི་ནང་དུ།",
    "ལྷ་སྟ་གོན་གྱི་སྐབས་ལྟར་གདན་དང་ཡན་ལག་བཞི་རྫོགས་བྱ།",
    "ཡི་གེ་བརྒྱ་པས་དམ་ཚིག་བཤགས་པ་སྔོན་དུ་འགྲོ་བས་ཚོགས་གཉིས་བསགས་པ་ཇི་ལྟ་བ་བཞིན་དུ་བསྒོམ།",
    "འདུ་ཤེས་གསུམ་དང་ལྡན་པས་སྙོམས་པར་ཞུགས་པའི་སྒྲས་ཕྱོགས་བཅུའི་དེ་བཞིན་༡༤༢གཤེགས་པ་ཐམས་ཅད་གཡོན་ནས་ཞུགས།",
    "སྐུའི་དབྱིབས་བརྒྱུད་རྡོ་རྗེའི་ལམ་ནས་ཡུམ་གྱི་མཁར་ཐིག་ལེའི་གཟུགས་ཀྱིས་བབ་པ་ལས་ལྷ་དགུ་གཞལ་ཡས་ཁང་དང་བཅས་པ་རྫོགས་པར་བསྐྱེད།",
    "དེ་ནས་གཙོ་བོ་ཡབ་ཡུམ་ལས་ཡབ་ཡུམ་དཔག་ཏུ་མེད་པར་གྱུར་ཏེ་སྤྲོས་པས་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་དུ་ཁྱབ་པས།",
    "རྣམ་པ་ཡབ་ཡུམ་འབའ་ཞིག་ཏུ་གྱུར་ནས་དོན་བྱེད་པ་དང་བྱས་པ་གཉིས་ཀ་ཚུར་འདུས་ཏེ་བདག་ཉིད་ལ་ཐིམ།",
    "གོ་རཱི་དཔག་ཏུ་མེད་པར་གྱུར་ཏེ་སྤྲོས་པས།",
    "ཤེས་རབ་གཉིས་སུ་མེད་པར་རྟོགས་པར་གྱིས་ཤིག་ཅེས་བརྡ་སྤྲད།",
    "མགོན་པོ་བདག་ནི་གཞུག་པར་འཚལ།",
    "གསང་སྔགས་ལ་ཡང་བརྩོན་པར་གྱིས།",
    "ཞེས་བརྗོད་པས་སྤྱིར་བསྟན་ལ་གང་ལ་མེ་ཏོག་ཕོག་པ་དེ་ཉིད་ཁྱད་པར་དུ་བསྟན་ནོ།",
    "སྒོ་བཞི་ནི་དྲན་པ་ཉེ་བར་གཞག་པ་བཞི་རྣམ་པར་དག་པའི་རང་བཞིན་ནོ།",
    "རྟ་བབས་བཞི་ནི་ཡང་དག་པར་སྤོང་བ་བཞི་རྣམ་པར་དག་པའི་རང་བཞིན་ཡིན་ནོ།",
    "ཀ་བ་བརྒྱད་ནི་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་རྣམ་པར་དག་པའོ།",
    "འདོད་པའི་ཡོན་ཏན་ནི་གཟུགས་སྒྲ་ལ་སོགས་པ་རྣམ་པར་དག་པའི་རང་བཞིན་ནོ།",
    "ལྷའི་དེ་ཁོ་ན་ཉིད་བཅོམ་ལྡན་འདས་ཀྱེ་རྡོ་རྗེ་ནི་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་དང་ཞེ་སྡང་རྣམ་པར་དག་པའི་རང་བཞིན་ནོ།",
    "གོ་རཱི་ནི་ཞེ་སྡང་དང་གཟུགས་རྣམ་པར་དག་པའི་རང་བཞིན་ནོ།",
    "ཆོམ་རྐུན་མ་ནི་གཏི་མུག་དང་སྒྲ་རྣམ་པར་དག་པའི་རང་བཞིན་ནོ།",
    "རོ་ལངས་མ་ནི་ང་རྒྱལ་དང་དྲི་རྣམ་པར་དག་པའི་རང་བཞིན་ནོ།",
    "གྷསྨ་རཱི་ནི་འདོད་ཆགས་དང་རོ་རྣམ་པར་དག་པའི་རང་བཞིན་ནོ།",
    "པུཀྐ་སཱི་ནི་ཞེ་སྡང་དང་ས་རྣམ་པར་དག་པའི་རང་བཞིན་ནོ།",
    "རི་ཁྲོད་མ་ནི་གཏི་མུག་དང་ཆུ་རྣམ་པར་དག་པའི་རང་བཞིན་ནོ།",
    "གཡོན་བརྒྱད་དེས་ཡུ་བ་བྱས་པའི་དྲིལ་བུ་འཛིན་པ་ཡུམ་མཱ་མ་ཀཱིས་འཁྱུད་པ་བསྐྱེད་གསུམ་ཀ་ལ་ཡེ་ཤེས་པ་དགུག་གཞུག་བྱ།",
    "ཟག་པ་མེད་པའི་བདེ་བས་རྒྱུད་གང་ནས་ཆུ་ལྷག་མ་ཡར་ལུད་པ་ལས་མི་བསྐྱོད་པ་ཞི་བས་དབུར་བརྒྱན་པར་བསམ།",
    "ཡུམ་རིན་ཆེན་སྒྲོལ་མ་དང་མཉམ་པར་སྦྱོར་བ།",
    "གཡོན་གཉིས་བསྐུམ་པའི་གར་སྟབས་ཀྱིས་བཞུགས་པ།",
    "དེས་ཟག་པ་མེད་པའི་བདེ་བ་མངོན་དུ་བྱས་ནས་སྤྱི་བོར་དོན་གྲུབ་ཀྱིས་དབུར་བརྒྱན་པར་བསྒོམ།",
    "སྔགས་དང་རྒྱུད་རྣམས་འཛིན་གྱུར་པར།",
    "ལྷ་རྣམས་ཀྱིས་ཀྱང་མཐུན་པར་གསུངས།",
    "དེས་ལུས་ཀྱི་དྲི་མ་དག་པའི་རྟགས་ལུས་རྣམ་སྣང་དུ་གྱུར་པར་དྲན་པར་བྱའོ།",
    "མཐའ་བརྟེན་རྗེས་གནང་ལ་བཞི་ལས།",
    "ལས་དེ་རྣམས་ནི་བསྒྲུབ་པར་གྱིས།",
    "དེ་ནི་ཅི་དགར་བསྒྲུབ་པར་གྱིས།",
    "ཕྱོགས་བཅུ་ན་བཞུགས་པའི་དཔའ་བོ་དང་རྣལ་འབྱོར་མ་རྣམས་སྤྱན་དྲངས་ཏེ།",
    "གཡས་པས་མི་འཇིགས་པའི་ཕྱག་རྒྱ་བྱས་ཏེ།",
    "ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་ལུང་བསྟན་པར་འགྱུར་རོ་ཞེས་ངེས་པའི་ཤེས་པ་བསྐྱེད་དོ།",
    "གསོལ་བ་གདབ་པ་སྔར་བཞིན་བྱས་ཏེ།",
    "ཤེས་རབ་ཡང་དག་དད་པར་བགྱིད།",
    "འདབ་མ་བརྒྱད་། ཀྱིས་རྣམ་པར་བརྒྱན།",
    "ཞེས་བརྗོད་ཅིང་པང་དུ་བྱོན་པར་བསམ།",
    "ཁྱད་པར་གྱི་དགའ་བ་དང་བཞིའོ།",
    "དེ་ནི་མི་རྟོག་པ་བསྐྱེད་པར་བྱེད་པའོ།",
    "འོ་ན་དེ་གར་གཏོགས་པ་ཡིན་ཞེ་ན་སྨྲས་པ་འཁོར་ལོ་བཞིའི་རང་བཞིན་དང་མཉམ་པར་བྱ་བར་རོ།",
    "འོ་ན་ཁྱད་པར་དགའ་བའི་གྲངས་སུ་མི་འགྲོ་ན་དགའ་བ་ནི་གསུམ་ལས་མེད་པས་འཁོར་ལོ་བཞི་དང་དགའ་བ་བཞི་ཇི་ལྟར་སྦྱར་ཞེ་ན།",
    "སྨྲས་པ་ཁྱད་པར་ཡང་དགའ་བའི་གྲངས་སུ་འགྲོ་སྟེ།",
    "རྒྱུས་ཅན་གཅིག་ལ་ཚེགས་མེད་པར།",
    "རིན་ཆེན་སྒྲོལ་མས་ལེགས་པར་འཁྱུད།",
    "དེ་ནས་དཀྱིལ་འཁོར་དུ་ལྷ་སྤྲུལ་པ་འབྱུང་ངོ།",
    "དེ་ལྟར་ཚུལ་གཉིས་སུ་སློབ་དཔོན་བྷ་བིའི་ལྷས་ཀྱང་གསུངས་སོ།",
    "འདིར་རྟེན་བསྐྱེད་པ་ཕྱིའི་རྡུལ་ཚོན་བྱིན་གྱིས་བརླབ་པ་དང་འབྲེལ་བས་ཕྱིས་བྱས་ན་བདེའོ།",
    "སྤྱིར་དུ་ན་གང་བྱས་ཀྱང་འགལ་བ་མེད་དོ།",
    "རྡོ་རྗེ་དང་པདྨ་བྱིན་གྱིས་བརླབ་པར་བྱས་ཏེ་སྙོམས་པར་ཞུགས་པ་ལས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་སྤྱན་དྲངས་ཏེ།",
    "ས་བོན་ཙམ་ལས་བསྐྱེད་པའམ་ཡང་ན་ཆོ་ག་གསུམ་ལས་བསྐྱེད་པར་བྱའོ་ཞེས་གསུངས།",
    "སྟོང་པའི་ངང་ལས་ཧཱུཾ་ཡཾ་ཧཱུྃ་ནས་གདན་བསྐྱེད་པའི་བར་སྒྲུབ་ཐབས་ལྟར་བྱས་པའི་རྗེས་སུ།",
    "རང་གཙོ་བོ་ཡབ་ཡུམ་གྱི་མཁའ་གསང་བྱིན་གྱིས་བརླབ་པ་ནས་ཐུགས་ཀར་ཡིག་འབྲུའི་དཀྱིལ་འཁོར་རྫོགས་པའི་བར་བྱས་ལ།",
    "ས་ཆོག་དང་མ་འབྲེལ་བའི་ལྷ་སྟ་གོན་དང་།",
    "འཁོར་རྣམས་བདག་བསྐྱེད་ཀྱི་ཐུགས་ཀར་རྡོ་རྗེ་ཆོ་ག་གསུམམམ་ས་བོན་ལས་བསྐྱེད་པ་གང་རུང་བྱས་ནས་ཕྱིར་སྤྲོས་ཏེ་འཁོད་པ་འདི་ཁོ་ན་བཞིན་དགོངས་པ་ཡིན་ནོ།",
    "འཁོར་རྣམས་དེའི་ཐུགས་ཀ་ནས་འབྱིན་པར་བྱེད་པ་ནི་རྒྱུད་འགྲེལ་གྱི་དགོངས་པ་ཡང་མ་ཡིན་ཅིང་།",
    "སླར་འདུས་སོ་སོའི་མཚན་མ་དང་རོ་གཅིག་ཏུ་གྱུར་པ་ལས་འཁོར་རྣམས་བསྐྱེད་དོ་ཞེས་གསུངས་པའི་ཐུགས་ཀ་ནས་སྤྲོ་བ་བདག་བསྐྱེད་ཁོ་ན་ལ་དགོངས་པར་ཚིག་འགྲོས་དེ་ཉིད་ཀྱིས་ཀྱང་ཤེས་པའི་ཕྱིར་དང་།",
    "ཀུན་གྱིས་། རྣལ་འབྱོར་རྫོགས་པར་བསྒོམས་རྗེས་སུ།",
    "བཅུ་དགུ་བྱས་ཏེ་འདི་དག་གོམ་སྟབས་དང་།",
    "གཙོ་བོ་ཡབ་ཡུམ་རྡོ་རྗེ་ཆོ་ག་གསུམ་ལས་བསྐྱེད་པ་ཡན་ལག་བཞི་རྫོགས་སུ་བྱས་ནས་རྩ་བའི་སྔགས་ཉི་། ཤུ་རྩ་གཅིག་བཟླས་ཏེ།",
    "ས་ལྷ་སྟ་གོན་གྱི་སྐབས་ཇི་ལྟ་བ་བཞིན་དུ་བྱ་སྟེ།",
    "ཕྱོགས་སྐྱོང་འཁོར་དང་བཅས་པ་བཀུག་པར་བསམ་ཞིང་།",
    "དེ་ནས་གཏོར་མ་དེ་ཉིད་ཀྱི་ལྷག་མ་བྱིན་བརླབ་མི་དགོས་པར།",
    "དཔོན་སློབ་ཀུན་གྱིས་བདག་བསྐྱེད་ཡོངས་སུ་རྫོགས་པ་བཟླས་པ་དང་བཅས་པ་བྱས་ཏེ།",
    "ཕྱོགས་བཞིའི་སློབ་དཔོན་གྱིས་ལྷ་སྟ་གོན་ལ་མི་འཇུག་ན་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་བསྡུས།",
    "འཇུག་ན་འོག་ཏུ་གཙོ་བོ་དང་མཉམ་དུ་དཀྱིལ་འཁོར་ནམ་མཁར་འདེགས་པར་བྱ་བ་ཡིན་པས།",
    "རང་གཙོ་བོ་ལས་བྱེ་བའི་ཧེ་རུ་ཀ་ཞལ་གཅིག་ཕྱག་གཉིས་པར་གྱུར་ཞེས་བརྗོད་ལ།",
    "གསོས་པར་བྱས་ནས་གཡས་སྔོན་འགྲོའི་གཞི་བཅའ་སྔོན་དུ་འགྲོ་བས།",
    "གཡས་པའི་དཀྱིལ་གཡོན་པའི་རྟིང་པར་གཞག་པའོ།",
    "ཁུ་ཚུར་གཉིས་ཁ་གྱེན་དུ་བསྟན་ནས་རྐེད་པར་འཇོག་པ་གང་རུང་བྱའོ།",
    "མཛེས་པའི་གོམ་པ་ནི་མདུན་དུ་སྤོ་བ་ངོས་མདུན་ནས་གཡབ་ཅིང་མི་སྤོ་བ་ངོས་ཀྱི་བརླ་ལ་བཙུགས་ནས་ཁྱིམ་བྱའི་གོམ་པ་ལྟར་བྱས་ཏེ་འགྲོ་བའོ།",
    "གཡས་བརྐྱང་ནི་གཡས་སྔོན་འགྲོའི་མཐོ་ལྔ་རྣམ་པར་བརྐྱངས་པའི་གཡས་བརྐྱང་དང་།",
    "གཡོན་བརྐྱང་ནི་གཡོན་སྔོན་འགྲོའི་མཐོ་ལྔ་རྣམ་པར་བརྐྱངས་པའི་གཡོན་བརྐྱང་དང་།",
    "རུས་སྦལ་ནི་གཡས་སྔོན་འགྲོའི་རྐང་པ་གཡོན་པའི་བོལ་གོང་དུ་གཡས་པའི་མཐིལ་བཞག་ནས་ལག་གཉིས་དཔུང་པའི་ཐད་ཀར་བསྐུམ་མེ་བྱས་པའོ།",
    "བུང་བ་ནི་གཡས་མསྔོན་འགྲོའི་བརླ་གཡོན་པར་གཡས་པའི་མཐིལ་གཏད་ནས་ལག་གཉིས་མཐིལ་གདེངས་པ་དང་སྒེག་པའི་བཞིན་ནོ།",
    "རོལ་པའི་ནི་རྐང་པ་གཡས་ཕྱེད་སྐྱིལ་དུ་བྱས་ཏེ་གཡོན་ཅུང་ཟད་ཅིག་མདུན་དུ་བརྐྱངས་ནས་ལག་པ་གཡོན་པའི་མཐིལ་རྒྱབ་གཡོན་དུ་ས་ལ་བཙུགས་ཏེ།",
    "ལྟེ་བ་མན་ཆད་མདུང་རྩེ་གཅིག་པའི་དབྱིབས་ཅན་བཅུ་སྤྲོས་པར་བསམ།",
    "ནུབ་ཀྱི་གཡོན་དུ་བཀོད་པར་བསམས་ལ།",
    "ཕན་བདེ་རྒྱ་མཚོའི་དཔལ་ལ་སྤྱོད་པར་ཤོག།",
    "རང་ཡི་དམ་གང་འདོད་ཀྱི་བསྒོམ་བཟླས་རྫོགས་པར་བྱ་སྟེ།",
    "དེའང་སང་ནངས་པར་བགྱིད་པར་འཚལ་ཞེས་པའམ།",
    "ད་ནི་བགྱིད་པར་འཚལ་ཞེས་པ་སྐབས་ཐོབ་དང་སྦྱར་ཏེ་གསོལ་བ་གདབ།",
    "རྟེན་འདི་གང་ཟག་ཁྱད་པར་ཅན་གྱིས་རབ་ཏུ་གནས་པར་བྱས་པ་ཡིན་ནའང་།",
    "ཡེ་ཤེས་པ་བཅུག་པའི་ཚབ་ཏུ་རྟེན་རྙིང་པ་དེའི་ཡེ་ཤེས་པ་བཅུག་ལ་མཆོད་བསྟོད་བསྡུས་པ་བྱས་ནས་སྟེང་འོག་མི་འཁྲུལ་པའི་མཚན་མ་བྱས་ཏེ།",
    "ཆུའི་སྐྱེ་བོ་ལ་ཕན་པའི་ཕྱིར་དུ་ཆུ་ནང་དུ་བླུག་པའམ་མཆོད་རྟེན་ལྟ་བུར་བྱས་ཏེ་རབ་གནས་བྱེད་པ་གང་རུང་བྱའོ།",
    "གཉིས་པར་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་ཕྲེང་སྔགས་གསུངས།",
    "ལྔ་པར་རྫོགས་རིམ་གྱི་རྟེན་ལས་ཀྱི་ཕྱག་རྒྱའི་ཚུལ་དུ་གསུངས་དྲུག་པར་རྣལ་འབྱོར་མ་རྣམས་དང་སྤྱོད་པ་སྤྱད་པའི་ཚུལ་གསུངས།",
    "དགུ་པར་དེའི་རྣམ་དག་གསུངས།",
    "གཉིས་ཕྱི་མའི་གཉིས་པར།",
    "བསྐྱེད་རིམ་གྱི་ཁྱད་པར་སྐུ་མངོན་བྱུང་།",
    "སྔགས་ཀྱི་ཁྱད་པར་གསུང་མངོན་བྱུང་།",
    "ཕྱི་མའི་བཞི་པ་སྦྱར་ཏེ་ཤེས་པར་བྱའོ།",
    "འདིར་ཕྱི་བསྐྱེད་པའི་རིམ་པ་བསྒོམ་ཚུལ་རྗེ་བཙུན་གྲགས་པ་རྒྱལ་མཚན་གྱིས་བདག་མེད་མའི་མངོན་རྟོགས་ཡན་ལག་བཞི་དྲུག་གཉིས་ཆར་སྟོན་པར་མཛད་པ་ལས།",
    "ཞེས་གསུངས་པས་སོ་སྙམ་ན།",
