    "བཙུན་མོ་སྲས་དང་ཕོ་ཉའི་ཚོགས་ཀྱིས་བསྐོར་བ།",
    "བདག་གིས་གདུང་བས་སྤྱན་འདྲེན་ན།",
    "བཙུན་མོ་བློན་འབངས་འཁོར་དང་བཅས།",
    "ལྷ་མོའི་ལོངས་སྤྱོད་འཛད་མེད་འདོད་རྒུའི་གཏེར།",
    "རབ་འབྱམས་ནམ་མཁའི་ཁྱོན་རྣམས་ཡོངས་གང་བ།",
    "མཚོན་མིན་སྟོང་ཕྲག་ཉི་མའི་ལང་ཚོ་ཅན།",
    "གཏེར་བདག་བྱེ་བའི་ཅོད་པན་ཁྱོད་ལ་བསྟོད།",
    "ཟག་མེད་བདེ་བ་བའི་དཔལ་སྟེར་བཙུན་མོ་བཞི།",
    "གཞན་ཡང་འཁོར་སྔགས་བཟླ་བར་འདོད་ན་སྒྲུབ་ཡིག་གི་གཞུང་བཞིན་ཇི་ལྟར་རིགས་པ་བཟླས་པའི་མཐར་མཆོད་ཅིང་འདོད་དོན་གསོལ།",
    "རིན་ཆེན་ཡ་ལད་སྤྱན་གཟིགས་དཀོར་ཆ་སོགས།",
    "ཁྱོད་ཀྱི་བཞེད་པ་གང་ཡིན་དེ་དག་ཀུན།",
    "བསམ་པའི་རེ་བ་གང་བའི་མཆོག་སྩོལ་ཅིག།",
    "རྗེས་གནང་གི་ཆོ་ག་ནི་འདོད་འཇོའི་བུམ་བཟང་བཞིན་ནོ།",
    "སྟེང་ན་དུག་གི་སྤྲིན་ནག་འཁྲིགས་ཤིང་འབྲུག་སྒྲ་དྲག་པོ་དང་བཅས་པས་གནམ་ལྕགས་ཐོག་གི་བུ་ཡུག་འཚུབས་པ།",
    "ལྗགས་གློག་དམར་ལྟར་བསྐྱོད་ཅིང་དུག་གི་ཁ་རླངས་འཐུལ་བ།",
    "འཁོར་དུ་ལྷའི་གིང་ཆེན་ཚངས་པ་དཀར་པོ།",
    "གཤིན་རྗེའི་གིང་ཆེན་རྨེ་རུ་ཙེ་དམར་པོ།",
    "བདུད་ཀྱི་གིང་ཆེན་ཡབ་རྗེ་ནག་པོ།",
    "གཡས་ན་དྲེད་མོ་ལག་དཀར་རྡེབ་པ།",
    "དར་གྱི་གཡབ་མོར་ཚིལ་སྤོས་དཀར་སོགས་སྦྱར་བའི་སྤོས་སྤྲིན་རོལ་མོ་དབྱངས་དང་བཅས་ཏེ།",
    "ཛམ་བུ་གླིང་གི་སྐྱེས་གཅིག་པུ།",
    "དེང་གི་གནས་མཆོག་དམ་པ་འདིར།",
    "བདག་གི་ཕྲིན་ལས་ཡོངས་འགྲུབ་མཛོད།",
    "སོགས་ཀྱིས་དམ་ཚིག་གི་གཉེར་གཏད།",
    "སིལ་སྙན་གླུ་གར་རོལ་མོའི་དབྱངས།",
    "མ་ཧཱ་པཉྩ་ཨ་མྲྀ་ཏ་ཁ་རཾ་ཁཱ་ཧི།",
    "སྒྲོལ་བྱེད་གིང་ཆེན་དཔའ་བོ་ཁྱོད་ལ་བསྟོད།",
    "ཐོགས་མེད་རྫུ་འཕྲུལ་སྟོབས་ལྡན་ཁྱོད་ལ་བསྟོད།",
    "ནོར་བདག་དགྲ་ལྷའི་གཙོ་བོ་ཁྱོད་ལ་བསྟོད།",
