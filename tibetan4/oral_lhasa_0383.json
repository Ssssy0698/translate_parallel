    "གང་མ་བྱས་པ་དེ་ལ་རང་བཞིན་ཞེས་བྱ་སྟེ།",
    "དེ་ལྟར་མ་བྱས་པ་ནི་རང་བཞིན་ཡིན་ནོ་ཞེས་འཇིག་རྟེན་གྱི་ཐ་སྙད་གནས་པ་ལ་ཁོ་བོ་ཅག་ཀྱང་ངག་མེའི་དྲོ་བ་ཉིད་གང་ཡིན་པ་དེ་རང་བཞིན་མ་ཡིན་ནོ་ཞེས་སྨྲས་ཏེཞབྱས་པ་ཡིན་པས་སོ།",
    "དེས་ན་དྲོ་བ་ཉིད་དང་རྒྱུ་དང་རྐྱེན་གྱིས་བསྐྱེད་པ་ཡིན་པས་བྱས་པའི་ཕྱིར་ཆུའི་དྲོ་བ་ཉིད་བཞིན་རང་བཞིན་ཉིད་དུའང་མི་འགྱུར་རོ་གསལ་བར་ཁོང་དུ་ཆུད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་མེའི་དྲོ་བ་ཉིད་ལ་སོགས་པ་འདི་རྒྱུ་དང་རྐྱེན་དག་ལས་བྱུང་བའི་ཕྱིར་བྱས་པ་ཉིད་ཡིན་པས་རང་བཞིན་མེད་པར་བརྗོད་ན་འོ་ན་རང་བཞིན་གྱི་མཚན་ཉིད་ཅི་ཞིག་ཡིན།",
    "རང་བཞིན་ཉིད་ཀྱང་ཅི་ཞིག་ཡིན་པ་དེ་བརྗོད་པར་བྱ་དགོས་སོ་ཞེ་ན།",
    "དེ་ལ་ལན་བརྗོད་པར་བྱ་སྟེ།",
    "དངོས་པོའི་རང་བཞིན་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་ཤེས་པར་བྱའོ།",
    "བསྟན་བཅོས་ལས་ཁྱད་པར་དུ་མཛད་པ་ཞེས་བྱ་བ་ནི་བཅོས་མ་མ་ཡིན་པ་དང་།",
    "གཞན་ལ་ལྟོས་པ་མེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཁྱད་པར་མཛད་པའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་དག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ན་འཕགས་པའི་སྐྱེ་བོ་ཁོ་ནས་ཐུགས་སུ་ཆུད་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མ་རིག་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཅི་དེ་ཡོད་དམ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ཞེས་བྱ་བ་ནི་འཕགས་པའི་ཤེས་པས་རྟོགས་པར་བྱའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མེད་དོ་ཞེས་དེ་སྐད་དུ་སྨྲ་བ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཡོད་པ་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་མེད་ན་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འགག་པ་མེད་པ་ཞེས་བྱ་བ་ནི་གྲངས་ཅན་པས་གཙོ་བོའི་ཁུག་མའི་ནང་དུ་ཐིམ་པར་འགྱུར་བར་འདོད་པ་བཞིན་དུ་ནི་མ་ཡིན་ནོ།",
    "འཇིག་པ་མེད་པ་དང་ཞེས་བྱ་བ་ནི་ལྷག་མ་མ་ལུས་པར་འཇིག་པས་སོ།",
    "སྤྲོས་པས་རྟོག་པ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་དེ་རྣམ་པར་རྟོག་པའི་སྤྱོད་ཡུལ་མ་ཡིན་པས་སོ།",
    "མཇུག་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རིགས་ཀྱི་བུ་དོན་དམ་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞི་བ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའི་སྤྲོས་པའི་ཡུལ་མ་ཡིན་པས་སོ།",
    "ཡང་དག་པར་དད་པ་ཞེས་བྱ་བ་ནི་མཐོ་རིས་ཐོབ་པར་བྱ་བའི་ཆེད་དུ་མ་ཡིན་གྱི།",
    "སྐྲའམ་མགོ་ལ་མེ་ཤོར་བ་ལྟར་བརྩོན་འགྲུས་རྩོམ་ཞིང་གནས་པ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་སྐྲའམ་མགོ་ལ་མེ་ཤོར་ན་ཤིན་ཏུ་མྱུར་བར་མེ་གསད་པའི་དོན་དུ་སྐྱེས་བུ་རྣམས་བརྩོན་འགྲུས་རྩོམ་པ་དེ་བཞིན་དུ་དོན་དམ་པ་ཐོབ་པར་བྱ་བའི་ཆེད་དུ་བརྩོན་འགྲུས་རྩོམ་པའོ།",
    "རྣམ་པར་འཇིག་པ་མེད་པ་ཞེས་བྱ་བ་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་བྱུང་ཡང་རུང་མ་བྱུང་ཡང་རུང་སྟེ།",
    "དོན་དམ་པ་ཡོད་པར་ཁས་བླངས་པ་ལ་སྐྱོན་བརྗོད་པ་ནི།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་གསུངས་པས་སོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདིའི་དགོངས་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོན་དམ་པར་ནི་དེ་བརྗོད་དུ་མེད་པས་བརྗོད་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "དེ་ནི་རང་བཞིན་གྱིས་ཞི་བ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དོན་དམ་པའི་རང་བཞིན་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ལས་འདས་པའོ།",
    "གཞན་ལ་མི་ལྟོས་པ་ཉིད་ཁས་བླངས་པས་བཅོས་མ་མ་ཡིན་པ་དང་གཞན་ལ་ལྟོས་པའི་ཕྱིར་རང་བཞིན་དུ་ཁས་བླངས་པས་ཕན་ཚུན་འགལ་བའི་དོན་ཇི་ལྟར་བརྗོད་པར་འགྱུར།",
    "འོ་ན་རང་བཞིན་དེ་ཡང་ཇི་ལྟར་ཡོད་པར་འགྱུར་ཏེ།",
    "ཉན་པ་པོའི་སྐྱེ་བོ་རྣམས་ལ་དཔེའི་སྒོ་ནས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཆེད་དུ་ཡིན་གྱི་དོན་དམ་པར་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་བུའི་རང་བཞིན་དེ་གཉི་ག་ལ་ཡང་གྲུབ་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རང་བཞིན་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པས་སོ།",
    "གང་དག་མེ་ལ་སོགས་པའི་རང་བཞིན་ཚ་བ་ལ་སོགས་པ་ཡིན་པར་སྨྲ་བ་དེ་དག་མི་རིགས་སོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་རོ།",
    "གང་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡོད་པ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ཞེས་བྱ་བ་འདིས་རང་བཞིན་བརྗོད་པ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་དེ་ལ་ཞེས་བྱ་བའི་སྒྲས་ནི་རང་བཞིན་ཡོད་པར་བརྗོད་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "དངོས་པོ་མེད་པའི་ཕྱིར་ལ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདིའི་དོན་ནི་གལ་ཏེ་ཚ་བ་ལ་སོགས་པའི་མཚན་ཉིད་ཅན་གྱི་རང་བཞིན་ཡོད་པར་འགྱུར་ན།",
    "བཅོས་མ་ཉིད་ལ་སོགས་པ་མ་ཡིན་པར་གྱུར་པ་ལས་འོན་ཀྱང་ཡོད་པ་ཉིད་དུ་མ་གྲུབ་པས་དེ་ལ་བཅོས་མ་མ་ཡིན་པ་ཉིད་ལ་སོགས་པ་ཅི་ལྟར་ཡོད་པར་འགྱུར།",
    "ཀུན་རྫོབ་ཏུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་མིག་ལ་སོགས་པ་རྣམས་ལ་སྟོང་པ་ཉིད་གང་སྨྲས་པ་དེ་ཕྱི་རོལ་གྱི་དོན་ཡོད་པར་སྨྲ་བ་དང་།",
    "སེམས་ཙམ་དུ་སྨྲ་བས་འདོད་པ་བཞིན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཟུང་བ་དང་འཛིན་པའི་དངོས་པོས་སྟོང་པ་ཉིད་དེ་ཕྱི་རོལ་གྱི་དོན་ཡོད་པར་སྨྲ་བ་དང་།",
    "ཕྱི་སྟོང་པ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་ཕྱི་སྟོང་པ་ཉིད་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་སྒྲ་ལ་སོགས་པ་ཡང་ཕྱི་སྟོང་པ་ཉིད་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་སྒྲ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་འོག་མ་རྣམས་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཉིས་ཆར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་སྐད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "སྟོང་པ་ཉིད་མ་ཡིན་པའི་དངོས་པོ་ལ་ལྟོས་ནས་རྣམ་པར་འཇོག་པས་སོ།",
    "དེས་ན་རང་བཞིན་མེད་པའི་མཚན་ཉིད་ཅན་གྱི་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེའི་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ལ་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་བསྙད་པར་བྱ་སྟེ།",
