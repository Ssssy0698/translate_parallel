    "སྒྲུབ་ཐབས་བདེ་གཤེགས་འདུས་པར།",
    "བསྟན་ལ་བྱ་བ་བགྱིད་པར་ཤོག།",
    "བལ་ཡུལ་མཆོད་རྟེན་ཉེ་འདབས་ནས་རྒྱལ་ཡོངས་ས་ཆེན་ཞེས་པ་ལས་གྲྭ་གུ་རུས་ཕྱི་ལོ་༢༥ ལོར་པར་བསྐྲུན་ཞུས།",
    "རྗེས་ནི་མཆོད་ཅིང་བཟོད་པར་གསོལ་ཏེ་གཤེགས།",
    "བཀྲ་ཤིས་དབྱངས་ས་བས་མ་ཡས་མས་ལགས་ཀྱིས་མཐའ་མར་བརྒྱན་བྱའོ།",
    "ལྟེ་བ་དང་ཕྱོགས་བཞིའི་འདབ་མ་ལ་ལྷ་སོ་སོའི་ཁ་དོག་དང་མཐུན་པའི་ཚོན་ཕུང་དགོད་དོ།",
    "སྒྲུབ་པ་པོའི་གཡས་ལོགས་ནས་རིམ་པར་ཡམ་ཤིང་འོ་མ་ཅན་གྱི་རིགས་བརྒྱ་རྩ་དང་ཉེར་གཅིག་པའམ་བདུན་ཚན་གཉིས།",
    "རང་རྡོ་རྗེ་མཁའ་འགྲོའི་ང་རྒྱལ་དུ་གནས་པར་བྱའོ།",
    "ཁྱབ་པར་བླུགས་ཏེ།",
    "ལྷ་མཉེས་པ་དང་སོ་སོའི་ལས་སྒྲུབ་པའི་ནུས་པ་དང་ལྡན་པར་བསམས་ལ།",
    "ཕྱི་རོལ་གྱི་གྲྭ་བཞིར་ཟླ་ཕྱེད་རྡོ་རྗེས་མཚན་པ་བྲིས་པ་དང་གཉིས་སུ་མེད་པར་བསམ།",
    "སྲེག་བླུགས་ཞལ་ཟས་བཞེས་སླད་དུ།",
    "འདི་ཉིད་དུ་ནི་བཞུགས་སུ་གསོལ།",
    "ཞེས་པས་དམ་ཚིག་པར་བསྟིམ།",
    "དྲི་མ་དག་ཆུའི་ལྷག་མ་ཡར་ལུད་པ་ལས་རྣམ་པར་སྣང་མཛད་ཀྱིས་དབུར་བརྒྱན་པར་བསམས།",
    "ཐབ་མས་བསམ་པམ་ལ་བ་མ་བསམ་། དང་ཡོ་བྱད་རྣམས་ཀྱི་འབགས་པ་དང་མ་དག་པ་སེལ་བའི་ནུས་པ་དང་ལྡན་པར་བསམས་ཏེ།",
    "ཨོཾ་ཀུ་ཤ་འདི་ནི་གཙང་ཞིང་དགེ།",
    "འཇིགས་བྱེད་མེ་ལྷ་ཉིད་ལ་རྣམ་པར་འདུད།",
    "སླར་ཡེ་ཤེས་ཀྱི་བདུད་རྩིར་གྱུར་པར་བསམས་ལ།",
    "ཐུགས་རྗེས་འགྲོ་བའི་དོན་ཕྱིར་བཞེས་སུ་གསོལ།",
    "དཀྱུས་ལྟར་ཕུལ་ནས་མཆོད་བསྟོད་འདོད་དོན་ཞུས་ལ་ཡི་གེ་བརྒྱ་པ་ལན་གསུམ་དང་མ་འབྱོར་པ་དང་སོགས་ཀྱིས་ནོངས་པ་བཟོད་པར་གསོལ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་བཛྲ་མུཞེས་དང་མཐེབ་སྲིན་གྱི་སེ་གོལ་གྱི་སྒྲས་ཡེ་ཤེས་པ་རང་བཞིན་གྱི་གནས་སུ་གཤེགས་པར་བསམས་ལ།",
    "རྗེས་ལ་གཉིས་ཀྱི་དང་པོ་མཆོད་ཅིང་བཟོད་པར་གསོལ་བ་ནི།",
    "སླར་ཡང་འབར་བ་མེ་ལྷའི་རྣམ་པར་གྱུར་པར་བསམས་ལ།",
    "ཡོ་བྱད་དམན་པ་ལ་སོགས་པ་སྐྱོན་དུ་གྱུར་པ་ཐམས་ཅད་བཟོད་པར་མཛད་དུ་གསོལ་ཞེས་བརྗོད་དོ།",
    "དེ་དག་ས་ཆ་གའི་འགྲོས་ཕལ་ཆེར་ཞི་བ་གཞིར་བྱས་ནས།",
    "དམ་ཚིག་པ་རང་ལ་ཐིམ་པར་བསམས་ལ།",
    "ལྷ་ཚོགས་སྲེག་བླུགས་མགྲོན་དུ་གཉེར་བྱས་པ།",
    "གཉིས་པ་རང་གཞན་གྱི་དོན་དུ་རྒྱས་པའི་སྦྱིན་སྲེག་བྱ་བར་འདོད་པས་ཆོ་གའི་འགྲོས་ཕལ་ཆེར་ཞི་བ་གཞིར་བྱས་ནས།",
    "འདིར་ཁྱད་པར་རྣམས་བརྗོད་པར་བྱ་སྟེ།",
    "ཟས་མཆོག་དཱརྦ་སྟེ་བསྲེག་རྫས་ཀྱི་གཙོ་བོ་དེ་ཙམ་ཀྱང་ཆོག་པར་བཤད།",
    "དཔལ་འབར་ཐབ་ཀྱི་དབྱིབས་དང་མཐུན་པར་གཡས་ནས་བསྐོར་བ་སོགས་ས་ནས་དགང་གཟར་ཁུ་ཚུར་གཉིས་བཅངས་པའི་མཐེབ་མཛུབ་གཉིས་བརྐྱངས་པའམ།",
    "འདིར་ཁྱད་པར་རྣམས་བརྗོད་པར་བྱ་སྟེ།",
    "དེའང་གནས་ཡིད་དུ་འོང་བར་ས་སྟེགས་ལ་ཐིག་ཆེན་བརྒྱད་བཏབ་པའི་དབུས་ནས་ཤར་དུ་སོར་གསུམ་འཕགས་པའི་སར་ཐབ་དབུས་ཀྱིས་མཚན་མ་བྱས་ལ་ཁྲུ་ཕྱེད་ཀྱི་ཚད་ཀྱིས།",
    "སླར་ཡང་དེའི་ཁར་སོར་བཞི་བཞི་བསྐྱེད་ལ་ལན་གཉིས་བསྐོར་བས་ཁ་སྐྱེར་དང་མུ་རན་ཏེ་ཤར་གྱི་ཐིག་རྩེ་སོ་སོར་སྦྲེལ་བའི་ཐིག་བཏབ་པས་ཟླ་གམ་གྱི་དབྱིབས་འབྱུང་ནུབ་ཀྱི་ཚངས་ཐིག་དང་ཟླུམ་སྐོར་ཕྲད་པ་ནས་དབུས་བར་གྱི་ཚད་དེས་ཟུར་བཞིར་མཚན་མ་བྱས་པའི་སྟེང་ནས་ཐིག་གྲུ་བཞིར་བཏབ།",
    "ཕྱི་རོལ་གྱི་གྲྭ་བཞིར་ཟླ་ཕྱེད་རྡོ་རྗེས་མཚན་པར་བྱའོ།",
    "དགང་གཟར་བླུགས་ཁུ་ཚུར་བཅངས་པའི་མཐེབ་མཛུབ་པདྨའི་འདབ་ལྟར་བྱས་པ་པདྨའི་ཁུ་ཚུར་གྱིས་བཟུང་བ་མ་ས་བསམ་སམས་མ།",
    "ཆོ་གའི་འགྲོས་ཕལ་ཆེར་ཞི་བ་གཞིར་བྱས་ནས་འདིར་ཁྱད་པར་རྣམས་བརྗོད་པར་བྱ་སྟེ།",
    "ཟླུམ་སྐོར་ཕྱི་མ་གཉིས་ཀྱི་སྟེང་ནས་ཀྱང་དེ་ལྟར་བྱས་ནས་ཐིག་བཏབ་པས་ཁ་སྐྱེར་དང་མུ་རན་འབྱུང་ངོ།",
    "ཤ་ཁྲག་སོགས་ཁྱད་པར་གྱི་རྫས་དེ་གསུམ་ཙམ་གྱིས་ཆོག་པའང་བཤད།",
    "བགེགས་ལ་སོགས་པ་ཚར་བཅད་པའི་བསམ་པས་ཁ་ལྷོར་ཕྱོགས་པར་རྐང་པ་གཡས་པས་གཡོན་པ་མནན་པའམ།",
    "ཁྱད་པར་གྱི་རྫས་མཁའ་འགྲོ་ལྔའི་། སྔགས་བརྗོད་ཅིང་ལག་པ་གཡོན་པས་འབུལ།",
    "གོ་རིམ་ཏིལ་གྱི་གོང་དུ་ཤ་ཁྲག་སོགས་ཁྱད་པར་རྗེས་འོང་བ་མ་གཏོགས་འདྲ།",
    "གྲུབ་ཀྱང་སྐད་ཅིག་གཉིས་པར་ཚུགས་སམ་ཅི།",
    "གཉིས་སྐྱེས་མཆོད་སྦྱིན་བྱེད་པར་མ་སྐྱེས་ཤིང་། མེ་ཡི་མིག་ཅན་གྲོགས་སུ་བཀུག་མིན་པར།",
    "ཡེ་ཤེས་སྣང་བ་མི་ཟད་སྟོབས་བདོ་བས་། ཀུན་མཁྱེན་ཕྲིན་ལས་རྒྱས་པར་བྱེད་གྱུར་ཅིག།",
    "བཀྲ་ཤིས་པར་གྱུར་ཅིག།",
    "བལ་ཡུལ་མཆོད་རྟེན་ཉེ་འདབས་ནས་རྒྱལ་ཡོངས་ས་ཆེན་ཞེས་པ་ལས་གྲྭ་གུ་རུས་ཕྱི་ལོ་༢༥ ལོར་པར་བསྐྲུན་ཞུས།",
