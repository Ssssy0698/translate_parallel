    "མ་རྒྱུད་པ་ལྟར་ན་ཞུ་བདེ་ལྷན་སྐྱེས་དང་རང་བཞིན་ལྷན་སྐྱེས་ཟུང་དུ་འཇུག་པ་དེ་རྣམས་སྦས་དོན་ཡིན་གསུང་།",
    "མ་རྒྱུད་པ་ལྟར་ན་ལྷན་སྐྱེས་ལ་ཞུ་བདེ་ལྷན་སྐྱེས་དང་རང་བཞིན་ལྷན་སྐྱེས།",
    "གཅིག་ཏུ་འདུག་དཀའ།",
    "འཁྲུལ་སྣང་རང་བཞིན་མེད་པར་རྨི་ལམ་སྒྱུ་མར་རྒྱས་གདབ།",
    "འཆི་བ་ཡོང་སྙམ་མི་གདའ་སྟེ།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "ས་གཞི་རབ་ཏུ་འབར་བར་འདུག་པ་དང་།",
    "རྒོད་ན་འགོལ་སར་འདུག་ལྟ་སྟངས་སྨད།",
    "དེ་ལྟར་སྔར་གྱི་གཉེན་པོ་ཐམས་ཅད་རྣམ་རྟོག་སྐྱེས་འདུག་པས་མ་ཡེངས་པ་བྱེད་དགོས་སྙམ་པ་ཁོ་ན་སྟེ།",
    "མི་རྟོག་པ་ལུས་སེམས་ཡོད་དུ་མི་ཚོར་བ་བར་སྣང་སྟོང་པ་ལ་འདུག་པ་ལྟ་བུ་ལ་སོགས་པའི་ཉམས་ཀྱི་སྣང་བ་ཅི་ཤར་ཡང་དགའ་བ་དང་སྐྱོན་དུ་བལྟས་ནས།",
    "དེ་དུས་ཀྱི་གནས་པ་དང་འགྱུ་བ་ངོ་ཤེས་མཁན་དེ་ལ་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའམ་སོ་སོར་རྟོག་པའི་ཤེས་རབ་དང་རང་རིག་པ་ཞེས་བྱའོ།",
    "གསུམ་པ་རྗེས་ལ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་གཟུང་ཞིང་རང་ངོ་སྤྲད་པ།",
    "དང་པོ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་གཟུང་ཞིང་རང་ངོ་སྤྲད་པ་ནི།",
    "ང་རང་ནི་གོང་དུ་ཞུས་པའི་ངེད་མིང་སྲིང་བཞིའི་ནང་ནས་ཐ་ཆུང་དེ་ཡིན།",
    "དེ་དུས་རོང་བཙན་ཕེབས་ཡོད་པའི་ལུས་གཡར་དེས་རྟ་གཅིག་ལ་སྒ་གཉིས་འོང་ཐུབ་པ་མི་འདུག་གསུངས།",
    "སྐུ་གོང་མའི་ཕྱག་ཕྲེངསོགས་ངོ་མ་རྣམས་བླངས་པ་ཡིན་འདུག་མ་ཟད་སྐུ་གོང་མའི་མ་བྱན་མེ་མེ་དེ་ཡང་ངོ་ཤེས་ནས་མིང་ནས་བོས་པས་ཁོང་རྣམས་ངོ་མཚར་དུ་གྱུར་ནས་སྐུ་གོང་མའི་ཡང་སྲིད་འཁྲུལ་བྲལ་ཡིན་པར་ངོས་འཛིན་མཛད།",
    "འགྲོ་འདུག་བྱེད་ཚུལ་སོགས་བསླབས་པར་མཛད།",
    "དེ་དུས་ང་རང་ཡང་ཚུབ་པོ་ཡོད་ལ།",
    "དཀའ་ཆེན་ལགས་ཀྱིས་རྟ་ལྕག་དེ་བསྣམས་ཏེ་ང་རང་ལ་མང་པོ་གཞུས་བྱུང་།",
    "ང་རང་བཀྲ་ཤིས་ལྷུན་པོར་དཔེ་ཐུབ་ཁང་ཚན་གྱི་སྤྲོ་ཁང་ཤར་དུ་བསྡད་པ་ཡིན།",
    "དེ་དུས་ང་རང་ལ་ལམ་འགྲོ་ཡང་ཆེན་པོ་བྱུང་།",
    "ད་བརྟག་དུས་ངོས་ལ་འབྱུང་འགྱུར་གང་ཡིན་མཚོའི་ནང་ནས་ལུང་བསྟན་པ་ཡིན་འདུག་མི་ཁ་ཅིག་ལ་ནི་མཚོའི་ནང་ན་ཅི་ཡང་མ་མཇལ།",
    "ཧ་རི་ཅནྡ་ཀོལ་དང་གར་ཞ་བ་སུ་བི་དཱར་བྷིམ་སིདྷ་སོགས་འདུག་དེ་ཀུན་ལ་ལ་དྭགས་པ་ཚང་མས་ཀྱང་རོགས་རམ་གང་ལེགས་བྱས།",
    "ད་དུ་རྟ་ལེགས་པོ་མི་འདུག་ཟས་ཞིམ་པོ་མི་འདུག་དུས་ཐོག་རྟ་སོགས་མ་འབྱོར་ཟེར་བ་སོགས་བསྙད་བཏགས་ཏེ།",
    "དེ་བཞིན་ཡོན་ཏན་ལྡན་པ་ཅི་ཙམ་འདུག་ལྟ་དུས།",
    "གླེར་སྐབས་འགར་ཁྲོམ་སྐོར་ལྟ་བུ་བཏོན་དགོས་བྱུང་ཚེ་གྲོང་ཡུལ་སོ་སོའི་མི་མངས་ཀུན་གྱིས་རྟ་ལྕག་པ་སོགས་གསུམ་པོ་དེར་འཐུས་ཀྱི་ཡོད་དམ་མེད་རྩད་གཅོད་བྱེད་ཅིང་གལ་ཏེ་ཡོད་པར་ཧ་གོ་ཚེ་རང་རང་སོ་སོས་རྒྱགས་དང་ཆུ་སོགས་ཁུར་ཏེ།",
    "དབྱིན་ཡིག་ཐོག་བྲིས་ཡོད་པ་གཉིས་མཐུན་གྱི་མི་འདུག་གསུངས།",
    "དེས་ན་ང་དང་ངའི་རོགས་པ་ཀུན་རྒྱ་གར་གྱི་སྲིད་བློན་ཆེན་པོ་དཔལ་ཇ་ཝཱ་ཧར་ལཱལ་ཁོང་རང་མཇལ་ཕྱིར་ཀཤྨཱིར་ནས་དིལླཱི་རུ་ཕྱིན་པ་ཡིན།",
    "སྐུ་ངོས་བོད་ནས་བྲོས་ཏེ་དེར་ཕེབས་ཏེ་འདུག་དེ་བཞིན་ཌཀར་ཡུ་རི་རོ་རིག་ཨུ་རུ་སུའི་རྩོམ་རིག་པ་མཚན་སྙན་གྲགས་ཅན་ཡང་མཇལ།",
    "ལ་དེ་ནི་སྒང་ཏོག་དང་བོད་ཀྱི་ས་མཚམས་ན་འདུག་དེའི་མཐོ་ཚད་༡༦ འདུག་ལ་དེ་བརྒྱབས་པ་དང་བོད་དུ་སླེབ་འདུག་ལ་དེ་ལ་ཁ་བ་མང་པོ་མེད་རྐྱེན་དེ་བརྒལ་བ་ལ་དམིགས་བསལ་དཀའ་ངལ་ལྟ་བུ་གང་ཡང་མ་བྱུང་།",
    "དེ་དུས་སྐུ་མདུན་བཅད་རྒྱར་བཞུགས་འདུག་པས།",
    "དགོན་གནས་དེ་ཀུན་མཇལ་ཕྱིར་རྟ་དང་དྲེལ་མ་གཏོགས་གཞན་བཞོན་པ་གང་ཡང་མི་འདུག་དགོན་གནས་དེ་ཀུན་དགུན་དུས་སུ་མཇལ་དུ་ཕྱིན་པ་ཡིན།",
    "དེའི་ནང་དུ་མཚོ་ནས་སྐབས་སྐབས་སུ་ཐོན་པའི་དངོས་རྫས་རང་བྱོན་ཁྱད་པར་ཅན་མང་པོ་མཇལ་རྒྱུ་འདུག་ངས་མཚོ་ལ་མཚོ་རྫས་གྱ་ནོམ་པ་ཕུལ་པ་ཡིན།",
    "མཚོ་དེའི་དབྱིབས་ནི་མིའི་པགས་པ་ཆ་ཚང་བཤུས་ནས་བཀྲམ་པ་ལྟ་བུ་འདུག་ཧིན་རྣམས་ཀྱིས་འདི་ལ་རཱཀས་ཏཱལ་ཟེར་འདུག་ཁ་འབབ་རྣམས་བཞིའི་འབྱུང་གནས་ལྟེ་བ་ནི་མཚོ་མ་ཕམ་རང་ཡིན་འདུག་མཚོ་དེའི་ཕྱོགས་བཞི་ནས་རྨ་བྱ་ཁ་འབབ།",
    "རུ་ཐོག་ནིསྔོ་ལྗང་རྒྱས་ལ་ཤིན་ཏུ་མཛེས་པའི་ཡུལ་ལྗོངས་ཤིག་འདུག་སྔོན་དུས་ལ་དྭགས་པ་ཚོང་པ་རྣམས་དགུན་དུས་དེར་བསྡད་ནས་ཚོང་བྱེད་པ་ཡིན།",
    "དེ་ཡང་དེ་དུས་ང་རང་ལ་དྭགས་ཀྱི་དོན་རྩའི་བློན་པོ་ཡིན་པས།",
    "རྒྱ་མིས་བོད་ལ་གང་དང་གང་བྱེད་པ་འདུག་བརྟག་དཔྱད་ལེགས་པར་བྱས་པ་ཡིན།",
    "ངས་རྒྱ་མིས་བོད་མ་ཚད་རྒྱ་གར་ཡང་ཟ་འདོད་འདུག་དེའི་ཕྱིར་རྒྱ་བོད་ཀྱི་ས་མཚམས་ཁག་བརྟན་པོ་མཛད་དགོས་པ་འདུག་ཞུས་པས།",
    "དེ་ཉིན་ཛཱ་པཱན་གྱི་ལོ་གསར་ཡིན་འདུག་དེར་ཕུ་ཇི་གུ་རུ་ཛིའི་སྐུ་ཚབ་དང་མཇལ།",
    "༡༩༦ ལོར་དགའ་ལྡན་ཐེག་ཆེན་གླིང་དུ་དུས་འཁོར་སྒྲུབ་མཆོད་སླར་བཙུགས་ཐུབ་པ་བྱུང་འདུག་དེ་ནས་བཟུང་ད་བར་ཉམས་མེད་གནས་ཐུབ།",
    "ཕྱིན་ཆད་ང་རང་ལ་གང་འཇོན་པའི་ཞབས་ཏོག་ཞུ་ཆོག་ཅེས་ཞུས་པ་ཡིན།",
    "རི་བོ་རྣམས་ཀྱང་ལྗོན་ཤིང་དང་རྩྭ་ཡིས་སྤྲས་པ་ཧ་ཅང་སྐྱིད་པོ་འདུག་སྤང་ཐང་ཀུན་ལ་རྟ་དང་།",
    "ར་ལུག་གྲངས་མེད་ཡོད་པ་དང་གུར་ཡང་ས་ཆ་མང་པར་མཐོང་རྒྱུ་འདུག་ང་དེར་སླེབས་པ་དང་གུར་ཁ་ཤས་ཀྱི་མི་མངས་ཀུན་ངའི་རྩར་མཇལ་དུ་འཛོམས།",
    "ང་རང་བཅས་མི་ལྔ་ཚང་ཙམ་བྱུང་།",
    "དེ་བཞིན་མི་མངས་རྣམས་ཆང་ལ་ཧ་ཅང་དགའ་པོ་འདུག་པས།",
    "སེངྒེ་ཁ་འབབ་ཀྱི་ཕར་ཀར་ཆགས་ཡོད་པའི་ཡུལ་མི་རྣམས་ཀྱིས་སྔོན་ལོ་ཙཱ་བ་རིན་ཆེན་བཟང་པོས་བརྒྱ་རབས་བཅུ་གཅིག་པའི་ནང་དུ་བཞེངས་པའི་བྲག་ཁུང་ཁ་བོ་ཆེ་བྱ་བའི་སྒྲུབ་གནས་ཁྱད་པར་ཅན་དེར་ངོས་ཀྱི་ཆེད་དུ་གཟིམས་ཆུང་ཞིག་ལོགས་སུ་གསར་བཞེངས་བྱས་འདུག་པར་བཅས་ལ་རབ་གནས་དང་།",
    "ཧ་ཅང་ལེགས་པོ་འདུག་ཅེས་བཀའ་གནང་།",
    "དེར་མ་ཎི་རང་བྱོན་ཞིག་ཀྱང་འདུག་དེ་ལ་ཁྲུས་གསོལ་རྒྱས་པ་བྱས།",
    "ད་ལྟ་གཅིག་མ་གཏོགས་མི་འདུག་དེ་ལ་དགའ་ལྡན་ཚེ་འཕེལ་གླིང་ཞུའོ།",
    "ད་ལྟ་མཆོད་རྟེན་གསུམ་གྱི་ཞིག་ཤུལ་ཙམ་མ་གཏོགས་གང་ཡང་མི་འདུག།",
    "དེར་དགེ་ཚུལ་མ་མང་པོ་འདུག་མ་ཎི་དབྱངས་དང་བཅས་ལེགས་པར་བཏོན།",
    "དེར་ཨུམ་ཁེ་ཞེས་པའི་ས་གནས་སུ་ཆུ་ཚན་གཉིས་འདུག་གཅིག་ནང་ང་རང་ཁྲུས་བྱས་པ་ཡིན།",
    "དེ་ནི་བེ་ཇིང་ནས་ཀི་ལོ་མི་ཊར་༨ ཙམ་གྱི་རིང་ན་འདུག་ཚེས་༢༦ ཉིན་དེར་ཕྱག་མཆོད་དང་།",
    "དེའི་ནང་ན་སྒྲུབ་ཆུ་ཁྱད་པར་ཅན་ཞིག་འདུག་ངས་སྒྲུབ་ཆུ་ཤེལ་བུམ་གང་ཞུས་པ་ཡིན།",
    "དེའི་ཆ་ཤས་ཙམ་ཡང་ད་ལྟ་བོད་དུ་ཡར་རྒྱས་བྱས་མི་འདུག་དེ་ནས་ལྷ་སར་འབྱོར།",
    "དེ་དུས་ངས་ཇོ་བོའི་བཞུགས་གནས་ཀྱི་ཕྱི་ནང་ཚང་མ་གཙང་མར་བཞག་དགོས་འདུག་ཞུས་པ་ཡིན།",
    "དེར་ཁང་ཚན་གྱི་གྱང་ཤུལ་ཙམ་མ་གཏོགས་གཞན་གང་ཡང་མི་འདུག་པས་སེམས་སྐྱོ་པོ་བྱུང་།",
    "དེ་དུས་སྔར་མེ་སྒྱོགས་བརྒྱབས་ནས་གནོད་སྐྱོན་བྱས་ཡོད་པ་ཀུན་ལ་ཉམས་གསོ་ཆེན་པོ་བྱེད་བཞིན་འདུག་ངས་རྩེ་པོ་ཏཱ་ལ་རུ་གཟིམ་ཆུང་ཀུན་དང་།",
    "དེ་ལྟར་འབྱུང་རྒྱུ་ཧ་ཅང་ཁག་པོ་འདུག་དེ་ཉིན་སྔར་རྒྱ་གར་གཞུང་ཚབ་སྡོད་གནས་བདེ་སྐྱིད་གླིང་དུའང་སླེབས།",
    "དེ་དུས་ཚོགས་ཚོགས་བྱ་ཧ་ཅང་མང་པོ་ཡོད་ཀྱང་དེང་སང་དེ་འདྲ་མི་འདུག་ད་ནི་སྲང་རྣམས་ནས་ཁྱི་རྣམས་ཕར་རྒྱུགས་ཚུལ་རྒྱུགས་བྱེད་བཞིན་འདུག་སྔར་གྱི་མཁས་མང་བྱེ་བའི་འབྱུང་གནས་དེ་ཉིད་ཀྱི་གནས་སྟངས་སྐྱོ་པོ་དེ་མཐོང་ནས་བློ་ཕམ་ཆེན་པོ་བྱུང་།",
    "ང་རང་དང་བོད་ཀྱི་འབྲེལ་ཇི་ལྟར་ལུས་ཞིབ་ཅིང་ཕྲ་བ་ནས་བཤད།",
    "ང་རང་བཅས་རྒྱ་གར་ནས་ཨུ་ལན་བཱ་ཊོར་དུ་འབྱོར།",
    "དེའི་དམིགས་ཡུལ་མཐར་ཐུག་ཇི་ལྟར་ཡིན་པ་སོགས་ཀྱི་སྐོར་ལ་སྐད་ཆ་འདྲི་རུ་གཏོང་བར་མཛད་པ་ཡིན་འདུག་ངས་གོང་དུ་ཞུས་པ་ལྟར་དགོན་སློབ་འཛུགས་དགོས་དོན་དང་།",
    "དེ་ཙམ་ཕན་ཐོགས་མི་འདུག་ལ་དྭགས་སུ་ཕྱིའི་ཡར་རྒྱས་འགྲིག་ཙམ་བྱུང་འདུག་སྟེ།",
    "འཛིང་དགོན་ནའང་འཛིང་ཆོག་ཆོག་བྱས་ནས་འདུག་དགོས།",
    "སྔོན་མ་ན་ཡིན་ན་ང་རང་ཡུལ་ཡུལ་ལ་མཇལ་ཏེ་ཡུལ་གྱི་སྐྱིད་སྡུག་དང་ཆེ་བ་ལ་རྒྱའི་སྐོར་ལ་ཞུ་བ་འབུལ་བ་ཡོད་ཀྱང་ད་ནི་རང་ལོ་༨༤ ལ་སླེབས་པའི་མི་རྒན་ཞིག་ཏུ་གྱུར་ཡོད།",
    "དེ་ཕྱིར་ཉིད་ཅག་རང་ཀུན་གྱི་ཡུལ་སོ་སོར་མཇལ་ཐུབ་རྒྱུ་ཁག་པོ་འདུག་ཡིན་ཀྱང་མ་འོངས་ལ་དྭགས་ཀྱི་དོན་རྩའི་སྐོར་ལ་ངས་ཡི་གེ་འདི་བརྒྱུད་དེ།",
    "མ་འོངས་པ་ན་ལ་དྭགས་ལ་ནང་པ་ལུས་ཐུབ་བྱ་ཡང་ཁག་པོ་མཐོང་འདུག་དེའི་ཕྱིར་གཅིག་སྒྲིལ་མཛོད་གཅིག་སྒྲིལ།",
