    "དངུལ་དག་ཀྱང་བྱིན་པར་གྱུར་ཏོ།",
    "རྒྱན་གྱིས་ལེགས་པར་བརྒྱན་པ།",
    "ཁོང་དུ་ཆུད་པར་བྱ་བ་ལ་ཡིད་གཞུངས་པ་དང་ལྡན་པ།",
    "གཞན་ལ་ཕན་པར་དགའ་བའི་སེམས་དང་ལྡན་པ།",
    "འདི་ལམ་གང་ནས་ཞུགས་པ་དེ་ནས་བདག་ཀྱང་འཇུག་པར་ཤོག་ཤིག།",
    "གཡོག་འཁོར་མཐའ་ཡས་ལ་གཞན་གྱིས་མི་ཐུབ་ཅིང་ཐུབ་པར་དཀའ་སྟེ།",
    "དེ་སྐད་ཅེས་བྱས་པ་དང་།",
    "ཆབ་ཀླུང་ཀུན་ཀྱང་མ་ལུས་སྐམས་པར་གྱུར།",
    "རུས་པ་དཀར་པོས་དོག་ས་གཏམས་པར་གྱུར།",
    "ཕྱོགས་བཞི་ཀུན་ནས་སྤྲིན་ཆེན་འདུས་པར་གྱུར།",
    "ཐང་དང་གཤོང་རྣམས་ཀུན་ཀྱང་ངོམས་པར་བགྱིས།",
    "སླན་ཅད་རྐུན་ཆོམ་གཡོན་ཅན་ཆད་པར་གྱུར།",
    "མགོན་མེད་གང་ཡང་འགུམ་པར་མི་འགྱུར་ཏེ།",
    "བརྒྱ་སྟོང་གྲངས་སུ་འགྲངས་པར་གྱུར་པ་ལས།",
    "དཔག་བསམ་ཤིང་ལས་མཛོད་རྣམས་རྣམ་པར་འཐོན།",
    "གང་མཚན་གང་དང་གང་ལགས་རིམ་བཞིན་དང་།",
    "འཛམ་བུའི་རྒྱལ་མཚན་ཁྱབ་པར་ཀུན་ཏུ་སྒྲོག།",
    "བདག་ཅག་སྐྱོབ་པ་ངེས་པར་འབྱུང་ཞེས་མཆིས།",
    "ཁམས་ཀྱི་དོགས་ཡོངས་སུ་གཡོས་པར་གྱུར།",
    "ཆབ་བཟང་ཡན་ལག་བརྒྱད་ལྡན་རྒྱས་པར་གྱུར།",
    "ཞུགས་ཤིང་ཀུན་ཀྱང་ལོ་མ་འཁྲུངས་པར་གྱུར།",
    "ནགས་ཚལ་མ་ལུས་དེ་དག་ངོམས་པར་བགྱིས།",
    "འཛམ་བུའི་རྒྱལ་མཚན་ཆབ་ཀྱིས་བལྟམ་པར་གྱུར།",
    "ཀུན་ཀྱང་ཆབ་ཀྱིས་བརླན་པས་རྣམ་པར་འཁྲུངས།",
    "དེ་ཚེ་ཐམས་ཅད་རབ་ཏུ་མཉམ་པར་གྱུར།",
    "དེ་དག་ཀུན་ཀྱང་དེ་ཚེ་མཉམ་པར་གྱུར།",
    "དེ་ཚེ་ཡུད་ཀྱིས་ཀུན་ཀྱང་མཉམ་པར་གྱུར།",
    "སྙན་པར་བརྗོད་པ་དེ་སྐད་ཆད་ཏུ་བརྗོད།",
    "བཟའ་ཤིང་ར་བར་དགྱེས་པར་གཤེགས་པ་མཛད།",
    "དགུང་བདུན་ལོན་པར་གྱུར་ནས་དེ་ཡི་ཆབ།",
    "དོག་སའང་དེ་ཚེ་ཡོངས་སུ་གཡོས་པར་གྱུར།",
    "བྱེ་བའི་གཏེར་རྣམས་རབ་ཏུ་འཐོན་པར་གྱུར།",
    "རྣམ་པར་འཚེ་བ་དེ་དག་བསྩལ་བར་གྱུར།",
    "ཁོང་ནས་བྱམས་པར་དེ་ཚེ་འགྲོ་ཀུན་གྱུར།",
    "ཐམས་ཅད་མཁྱེན་ལམ་ནན་ཏན་ལྡན་པར་གྱུར།",
    "མཐོ་རིས་ལམ་ཆེན་ཀུན་ཀྱང་བཏོད་པར་གྱུར།",
    "ཐམས་ཅད་མཁྱེན་པའི་ལམ་ཡང་ཤིན་ཏུ་བསྟན།",
    "སྙན་པར་བཀུར་ནས་རབ་ཏུ་བསྔགས་ཏེ།",
    "ལན་བརྒྱ་ཕྲག་སྟོང་དུ་གཡས་ཕྱོགས་སུ་བསྐོར་བ་བྱས་ཏེ།",
    "བློ་ཕྱིན་ཅི་ལོག་ལ་ཞུགས་པ་སེམས་འཁྲུགས་པར་གྱུར་པ།",
    "རྒྱུད་འཛིངས་པར་གྱུར་པ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་ལ་བརྟག་པར་བྱ་བའམ།",
    "རྒྱལ་པོ་ཟས་གཙང་མ་ནི་དེའི་ཚེ་དེའི་དུས་ན་རྒྱལ་པོ་སྐར་མའི་འོད་ཅེས་བྱ་བར་གྱུར་ཏོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་འཇུག་པ་སྣ་ཚོགས་དང་།",
    "ཡང་དག་པར་བསྒྲུབ་པ་སྣ་ཚོགས་དང་།",
    "ལམ་གྱི་རྒྱན་རྣམ་པར་དག་པ་སྣ་ཚོགས་དང་།",
    "རྣམ་པར་འཕྲུ་པ་དང་།",
    "ལམ་གྱི་རྒྱན་རྣམ་པར་སྣ་ཚོགས་ཀྱིས་ཡོངས་སུ་བྱུང་སྟེ།",
    "འབྱམ་ཀླས་ཞིང་རྣམས་ཀུན་ན་བཞུགས་པ་ཡི།",
    "ཇི་ལྟར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཤིན་ཏུ་མཉེས་པར་བྱ་བས་བསྙེན་བཀུར་ཞིང་རིམ་གྲོར་བྱ་བ་དང་།",
    "ཁ་དོག་རྒྱ་མཚོ་ཡངས་པ་མཐའ་དང་དབུས་མྱེད་པ་རྣམ་པར་དམྱིགས་པར་སྟོན་པའི་ལུས་དང་ལྡན་པ་སྤྱོད་ལམ་ཐམས་ཅད་ལ་རྣམ་པར་སྤྱོད་པའི་ཚུལ་ཡོངས་སུ་སྟོན་པའི་ལུས་དང་ལྡན་པ།",
    "དུས་ཐམས་ཅད་དུ་འགྲོ་བ་ཐམས་ཅད་ཀྱི་དོན་ལ་མངོན་དུ་བལྟས་པར་ནམ་མཁའི་དབྱིངས་ཀྱིས་ཀློ་བའི་ལུས་དང་ལྡན་པ།",
    "དྲན་པས་ཡོངས་སུ་འཛིན་པའི་ལུས་དང་ལྡན་པམཐའ་དང་དབུས་མེད་པའི་འོད་ཀྱིས་ཕྱོགས་དང་ཕྱོགས་མཚམས་ཐམས་ཅད་རྒྱས་པར་འགེངས་བའི་ལུས་དང་ལྡན་པ།",
    "འདུ་ཤེས་རྣམ་པར་དག་པ་བཅུ་ཐོབ་པར་གྱུར་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་བརྩམས་པའི་བརྩོན་འགྲུས་ལ་དམྱིགས་པ་ཐམས་ཅད་དུ་གནས་པར་བྱ་བའི་ཕྱིར།",
    "ཡང་དག་པར་འཕེལ་བར་བྱེད་པ་དང་།",
    "ཡོངས་སུ་སྐྱོང་བའི་འདུ་ཤེས་རབ་ཏུ་ཐོབ་པར་གྱུར་ཏོ།",
    "འདུ་ཤེས་རྣམ་པར་དག་པ་བཅུ་པོ་དེ་དག་རབ་ཏུ་ཐོབ་པར་གྱུར་ཏོ།",
    "བློ་ནམ་མཁའ་དང་མཉམ་པས་དུས་གསུམ་ཐམས་ཅད་ཀྱི་ཚུལ་རྒྱ་མཚོ་སྣང་བ་རབ་ཏུ་ཐོབ་པར་བྱ་བའི་ཕྱིར་བློའི་སྐལ་བ་མཉམ་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་སྣང་བར་རབ་ཏུ་ཐོབ་པར་བྱ་བའི་ཕྱིར་སྤྱོད་ཡུལ་གྱི་སྐལ་བ་མཉམ་པ་དང་།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཚུལ་རྒྱ་མཚོ་ལ་འཇུག་པའི་ལམ་སྣང་བ།",
    "རྣམ་པ་ཐམས་ཅད་རབ་ཏུ་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཚུལ་གྱི་རྗེས་སུ་འབྲང་བའི་སྐལ་པ་མཉམ་པ་དང་།",
    "སྒྲིབ་པ་ཐམས་ཅད་ཀྱི་རི་རྣམ་པར་གཏོར་པའི་ཕྱིར་མི་འཇིགས་པའི་སྐལ་བ་མཉམ་པ་དང་།",
    "བསམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་འགྲོ་བ་རྣམས་ལ་རྣམ་པ་ཐ་དད་པར་ཡོངས་སུ་བསྟན་པའི་མཚན་དང་དཔེ་བྱད་བཟང་པོས་རྣམ་པར་བྲིས་པའི་ལུས་རྣམ་པར་དག་པར་རབ་ཏུ་ཐོབ་བར་བྱ་བའི་ཕྱིར་གཟུགས་ཀྱི་ལུས་རྣམ་པར་དག་པའི་སྐལ་པ་མཉམ་པ་དང་།",
