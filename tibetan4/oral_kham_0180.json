    "ཉིན་ཞིག་ཁོ་བོ་ཇོ་བོར་ལྟ་སྐོར་དུ་ཕྱིན་ཏེ་ཇོ་བོའི་ལོགས་སུ་ཇོ་ཁང་ཞབས་ཀྱི་མཚོ་ཡི་རླབས་སྒྲ་ཉན་ས་ཡིན་ཟེར་བའི་དད་པ་ཅན་རྣམས་མགོ་སྐོར་བྱེད་ཀྱི་བུ་ག་ཞིག་འདུག་པར་ཉན་གྲབས་བྱེད་དུས།",
    "ངའོ་སྙམ་པའི་བློ་སོགས་དང་ཁོག་དཔུང་དང་ལ་རྒྱའི་འདུ་ཤེས་བསྐྱེད་པར་བྱེད་པ་དེ་བཞིན་དུ་མི་རིགས་ཀྱི་རང་རློམ་དང་རང་རྩིས་ཀྱི་བློ་སོགས་དང་མི་རིགས་ཀྱི་ཁོག་དཔུང་ལ་རྒྱའང་སློང་བར་བྱེད།",
    "བསམ་གཞིག་བསུབས་པས་རང་རྩིས་དང་རང་རློམ་གྱི་བློ་བསུབས།",
    "རང་རྩིས་དང་རང་རློམ་གྱི་བློ་བསུབས་པའི་མཇུག་འབྲས་ནི་མི་བུ་རང་བསུབས་པ་སྟེ།",
    "འུ་ཚོར་ཁོང་ཉིད་ལྟ་བུའི་གཅེས་ནོར་མང་པོ་མི་འདུག་ཡིན་ནའང་།",
    "བདེན་དོན་ཞིག་གཉུག་མའི་དུས་ཀྱི་རང་གཤིས་ཤིག་སྟོན་གྱི་འདུག་པས།",
    "ཏག་ཏག་སྙན་ངག་མཁན་ཁོང་རང་ལ་ལྡན།",
    "སྐད་ཆ་དེས་ང་རང་ལན་མེད་དུ་བྱས་བྱུང་།",
    "དོན་དམ་དུ་རང་ས་ནས་ལམ་ལ་ཆས་པའི་ཐོག་མའི་དུས་ནས་བཟུང་གཡོ་འོག་ལྟ་བུ་ཞིག་ཏུ་ཚུད་འདུག་པ་འདྲ།",
    "བཞི་བཅུ་བརྒྱབ་པའི་ཚོང་ཟོག་སྤུས་ལེགས་ཀྱང་གང་མང་མང་འདུག་དེ་དག་རྫུས་མ་མིན་ནའང་ཐང་།",
    "ངེད་ཚོའི་སེམས་ཁམས་ད་དུང་ཁྲོམ་ཆུང་མི་བུ་ཡི་ཚད་དུ་ལུས་འདུག་པ་ཨེ་ཡིན་ནམ་ཞེས་པ་དེ་ཡིན།",
    "ཕྱི་ལྗོངས་ཀྱི་ངོ་མཚར་དག་ཚིག་རྒྱན་གྱིས་སྤྲས་ཏེ་བརྗོད་པ་དཔེ་ལུགས་ཤིག་ཏུ་གྱུར་འདུག་ཡིན་ནའང་།",
    "བཞད་གད་བྱེད་དོན་སྣ་གཉིས་འདུག་གཅིག་ནི་རིགས་མ་མཐུན་པས་དང་།",
    "ནམ་ཡང་ཚད་བཀག་དེ་ལས་འདའ་མི་ཐུབ་པའི་རྒྱ་བཏབ་འདུག་སུ་ཞིག་ཁོ་ཚོའི་ལྟ་ཚུལ་དེ་དག་ལ་འགལ་བ་དང་གང་ཞིག་ཁོ་ཚོའི་སྐོར་རྟགས་ལས་བརྒལ་ན།",
    "འཁོན་ལན་གྱི་རྐུན་འགྲོ་འཇབ་འདུག་མེད་པས་བག་ཕེབས་ཤིང་།",
    "དངོས་པོ་རྐུ་ཤོར་གྱི་གྱོད་དོན་བྱུང་རྗེས་ཀྱི་ང་ཡི་བསམ་བློ་དང་བྱེད་སྟངས་དེ་ལྟར་མ་ལེགས་པར་འདུག་པས།",
    "ད་ནི་བྲན་གཤིས་ཀྱང་སྐྱེས་མ་ཐག་ནས་ཡོད་པ་ལྟར་འདུག་བྲན་གཡོག་ཡིན་མིན་དང་།",
    "འུ་ཚོར་ད་ལྟའང་ཚུལ་དེ་ཤིན་ཏུ་དར་རྒྱུགས་ཆེ་བར་འདུག་དེང་དུས་འདྲ་མཉམ་དང་།",
    "ཞྭ་སུག་ལྷེམ་ལྷེམ་དུ་འདུག་ཅིང་།",
    "གུས་འདུད་སྟོན་པའི་རྣམ་པ་ཁྱད་པར་བ་ཞིག་ཏུ་བསམས་ནས་མི་མཛེས་མི་ལེགས་པའི་སྣང་བ་མེད་ཚོད་དུ་འདུག་ནའང་།",
    "དེ་ལའང་ཁག་མི་འདུག་སྟེ།",
    "འཇིག་རྟེན་པ་རྣམས་ལ་འཇིག་རྟེན་པའི་ཚོད་ཀྱི་ཤེས་དང་མ་ཤེས་ཀྱི་སྐད་ཆ་ལབ་རྒྱུ་འདུག་པ་ལྟ་བུའོ།",
    "མང་པོ་འདུག་ཅེས་ཞུས་པས།",
    "ཀུན་གྱིས་གཟབ་དགོས་འདུག་གོ།་",
    "མི་གྲངས་ཁྲི་ཡོད་ཅེས་ལན་བཏབ་འདུག་པའང་ཡོད་སྐད།",
    "ངས་མི་ཤེས་ཞེས་བརྗོད་པ་ལ་གོ་དོན་གཉིས་འདུག་སྟེ།",
    "བྱེད་ལས་ཐེ་ཚོམ་ལྡོག་པར་བྱེད་ཅིང་རང་ཡུལ་བརྟག་པར་བྱ་བའི་དངོས་པོ་ལ་དམིགས་ནས་རང་སྟོབས་ཀྱིས་བླང་དོར་འབྱེད་པའི་རྣམ་པ་ཅན་གྱི་སེམས་བྱུང་དེ་ཤེས་རབ་ཀྱི་མཚན་ཉིད།",
    "ཤེས་བྱ་ནི་གོ་སླ་ལ་ཤེས་རབ་ནི་གོ་དཀའ་ཙམ་འདུག་ནའང་།",
    "རྒྱན་ཆ་མཆོར་གོས་ལ་དགའ་བ་དེ་ནི་རྒྱན་ཆ་དང་གཟབ་མཆོར་སྤྲས་པ་ཁོ་ནའི་ངོ་བོ་ལས་རབ་ཏུ་འགོངས་ཏེ་རྒྱུ་ནོར་ངོམ་སོ་སྟོན་པའི་རྟགས་མཚན་ཞིག་ལ་སླེབས་འདུག་འགྲན་བསྡུར་དེའི་ཁྲོད་དུ།",
    "ལོར་འཛམ་གླིང་རང་བྱུང་ཐེབས་རྩ་ཚོགས་པས་བསྒྲགས་གཏམ་སྤེལ་དོན།",
    "ནམ་ཞིག་འཛམ་གླིང་སྒང་འདིར་སྲོག་ཆགས་དེ་རིགས་རྩ་བ་ནས་མེད་པ་ཆགས་འགྲོ་ཞེས་ཀྱང་སྐད་བརྒྱབ་འདུག་པ་མཐོང་ཐོས་བྱུང་།",
    "སྤྱི་ཟླ་པའི་ཚེས་ཉིན་ཏེ་བོད་ལུགས་ལོ་སར་གྱི་རྗེས་ནི་སྲེག་སྦྱོར་དུས་ཚོད་ཡིན་པ་དུས་བཅད་བྱས་འདུག་སོགས་བཀོད་པ་བདེན་རྒྱབ་ངོ་ཐོན་བྱུང་།",
    "ཚུལ་འདིར་བླུན་པོ་དད་པའི་རྗེས་འབྲངས་ཀྱི་ཆ་ཞིག་ཅིས་ཀྱང་འདུག་སྟེ།",
    "ལ་ཤས་ཀྱིས་རང་ཁྱིམ་གྱི་རྒྱུན་ལྤགས་སྟེང་ལ་གཞན་གྱི་རྒྱན་ལྤགས་ཉོས་ཏེ་བརྡ་འཕྲིན་དུས་སྐད་མི་རྒྱུགས་པའི་ཡུལ་དུ་ཚོང་ལ་འགྲོ་ཡི་འདུག་ཚུལ་ཐོས།",
    "བློ་ཐུང་ལ་བརྗེད་ངས་ཆེ་ཞིང་བཟོད་བསྲན་བརྟན་བརླིང་མིན་པའི་གཤིས་དག་ཀྱང་རང་ཆས་སུ་ཡོད་པ་འདྲ།",
    "ཡང་རང་ཡུལ་ལ་རང་སྟོབས་ཀྱིས་འཇུག་པ་དང་གཏོད་ཅིང་བརྟན་པར་བྱེད་པའི་སེམས་བྱུང་ཞིག་ཡིན་པའི་ཆ་ནས་མལས་རིགས་ཤེསཀུན་གྲོལ།",
    "འགན་ཚོར་རམ་འགན་སེམས་སམ་འགན་ཡིད་ཅེས་ཚིག་བསྡུ་རྒྱག་སྟབས་ཀྱང་བདེ་བོ་འདུག་པ་འདྲ།",
    "གཞན་ལ་བལྟོས་པའི་འགན་འཁྲིའི་འདུ་ཤེས་ཆེ་ཞིང་ཤུགས་དྲག་པོའི་མི་རིགས་དང་མི་བུས་ལས་དོན་ཆེན་པོ་གྲུབ་དང་འགྲུབ་ཀྱིན་འདུག་ལ།",
    "ཁོ་ཚོའི་མི་བུའི་བསམ་སྤྱོད་ལ་ཡར་སྐུལ་གྱི་ནུས་པ་ཐོན་དང་འཐོན་བཞིན་འདུག་པ་མངོན་རིགས་ཤེས་ཀུན་གྲོལ།",
    "སྤྱི་ཁྱབ་དང་ཕྱོགས་ཀུན་ནས་བལྟས་ཚེ་མི་རྣམས་ཀྱི་བློ་རིག་དེ་ད་དུང་ནར་མ་སོན་པའི་བྱིས་པའི་དུས་ལྟར་འདུག་པ་དང་།",
    "འུ་ཚོ་ད་དུང་མི་བུར་གྱུར་མི་འདུག་ཅེས་པའི་སྐད་ཆ་དག་ནི་ངས་རིགས་འདེད་དང་འོལ་ཚོད་བྱས་པའི་སྐད་ཆ་ཡིན།",
