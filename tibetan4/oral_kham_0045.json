    "ལས་ཀར་འགྲོ་སྐབས་ངས་སྐུ་ཞབས་གཡུ་ལོ་ལགས་སུ་དེ་རིང་དོགས་པ་གང་མི་འདུག་གམ་ཞེས་ཞུས་པས་གང་ཡང་མི་འདུག་གསུངས།",
    "ང་རང་བཅས་གསུམ་གྱིས་ཞུ་ནན་ཨུ་ཚུགས་མཐར་སྐྱེལ་གྱིས་མཐའ་མ་དེ་ལ་ཉལ་ཆས་གཅིག་གཏང་རྒྱུར་ཁས་ལེན་བྱུང་བ་ཕྲན་ལ་རྒྱབ་ཤ་དམར་ཅན་གྱི་སྲིན་བལ་བར་འཚངས་མལ་ཆས་ཤིག་ཡོད་པ་དེ་སྤྲད་པ་ཡིན།",
    "ལམ་ལ་ཞུགས་པ་རྣམས་ཀྱིས་མངོན་དུ་བྱ་རྒྱུ་དང་རང་ངོ་སྤྲོད་རྒྱུ་ཡང་འདི་ཡིན་ནོ།",
    "འདིར་ཡང་ཀུན་གཞིའི་ངོ་བོ་གཉིས་ལ་རིག་ཅིང་རང་ངོ་ཤེས་ན་གྲོལ་བ་དང་།",
    "ཐ་མལ་པའི་དུས་ཀྱི་རྣམ་རྟོག་ལུ་གུ་རྒྱུད་དུ་འཕྲོ་བ་དེ་ཉིད་ལྷག་མཐོང་ཁོ་རང་རྣམ་རྟོག་ཏུ་སྣང་བ་ལས་གཞན་མིན་ལ།",
    "ཐམས་ཅད་རང་སྣང་རང་གྲོལ་ཡིན།",
    "གནས་པ་དང་འགྱུ་བ་ནི་སེམས་ཁོ་རང་གཅིག་པུའི་རོལ་པ་ལས་མ་འདས་པས།",
    "བདེ་གསལ་མི་རྟོག་གང་རུང་དུ་ལྷན་ནེར་འདུག་གམ།",
    "འདི་ནི་གཞན་ཕུང་རང་ཡང་བརླག་པར་བྱེད།",
    "ཅེས་གསུངས་པ་དེ་ལྟ་བུར་མ་གྱུར་པའི་རང་མགོ་བསྒྲིམ་པ་ལ་འབད་པ་གལ་ཆེ་བར་གདའོ།",
    "དེ་དང་སེམས་གཉིས་ཐ་མི་དད་པར་སེམས་ཁོ་རང་དེའི་ངོ་བོར་ཤར་ཞིང་ཐག་ཆོད་ཀྱི་ངེས་པ་ཐོབ་པ་ལ་རྟོགས་པ་ཞེས་བྱ་སྟེ།",
    "རྩེ་གཅིག་དུས་སུ་འཁྲུལ་པ་རང་ག་མར་འཆར།",
    "བློས་བྱས་ཀྱིས་མ་བསླད་པའི་རང་བབས་ཐ་མལ་ཤེས་པའི་རང་འགྲོས་སྐྱོང་ཚུལ་ཤེས་པ་ཞིག་ཁོ་ན་གལ་ཆེ་བར་གདའ་སྟེ།",
    "བཟོ་མེད་གཤིས་ཀྱི་འདུག་ཚུལ་སྐྱོང་བ་ཁོ་ན་ལ་དྲིལ་བ་ནི་ལམ་འཁྱེར་གྱི་སྤྱོད་པ་ཀུན་ཏུ་བཟང་པོ་མཆོག་ཏུ་གྱུར་པ་དང་།",
    "དེ་སྙེད་བསྟན་ཀྱང་རང་སྣང་མ་དག་འཁྲུལ།",
    "ང་རང་ནགས་ཁྲོད་ནས་ཐར་ན་དེ་ཕྱོགས་ཡོང་གཏན་ཡིན་ཟེར་བའི་ཁ་ལན་ཡང་བསྐུར་འདུག་པར་སྡོད་ས་ཡོད་ཅེས་ལན་བསྐུར་བ་ཡིན།",
    "དང་ཐོག་སྒར་ཆགས་གཞིས་སྡོད་གཉིས་ཀྱིས་སྒོ་ང་ལྔ་བརྒྱ་ཙམ་ཁྱེར་འདུག་པ་དེ་དག་སྐད་སྒྱུར་ཚེ་རིང་ལ་སྤྲད་པ་དང་།",
    "ང་རང་དེ་རིང་རྒྱ་གར་བས་ཤོག་ཟེར་མཁན་མི་འདུག་ཀྱང་།",
    "སྦས་ཆགས་ཤྲཱི་ས་གནས་ཀྱི་ཡིག་རིགས་ཉར་མཁན་ང་རང་ཡིན།",
    "དབུ་ཤེལ་གྱི་བུམ་པ་དམུ་ལུགས་སུ་འདུག་ཅིང་།",
    "མ་མཆུ་སྲབ་ལ་ལེགས་པ་ཟར་མའི་མེ་ཏོག་ལྟར་འདུག་པ་སྟེ།",
    "རང་བཞིན་སྟོང་དང་རང་བཞིན་མེད་པ་སྟོང་པ་ཉིད།",
    "གསུམ་སྡོམ་པས་ཟླ་བ་གཅིག་དུས་བཟང་གསུམ་ལ་སྲུང་བ་དང་།",
    "ནམ་ཞིག་མི་རྟག་དུས་བྱུང་ཚེ།",
    "ཟླ་བའི་དབྱིབས་སྟེང་འདུག་གནས་ནས།",
    "ཟླ་བའི་དབྱིབས་ཀྱི་སྟེང་འདུག་ནས།",
    "རྡོ་རྗེ་སེམས་དཔའི་ལ་གན་འདུག།",
    "མཆོད་རྟེན་མཁྲིལ་ལེགས་འདུག་པ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་ཀྱི་རྡོ་རྗེའི་དབྱིབས་སུབདག་བྱིན་གྱིས་བརླབས་ཏེ་འདུག་གོ།",
    "ཀུན་ཀྱང་རང་བཞིན་འོད་གསལ་བ།",
    "འགྲེང་ངམ་ལང་ན་འདུག་ཀྱང་རུང་།",
    "བརྩོན་འགྲུས་ཆུང་བས་མི་འདུག་སྟེ།",
    "ཟླ་བ་རྒྱས་ལ་འདུག་ནས་ཀྱང་།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱོགས་ཀུན་དུ་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཚུལ་དུ་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་འདུག་སྟེ་ཆེད་དུ་བརྗོད་པ་འདི་ཆེད་དུ་བརྗོད་དོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་སྣང་མཛད་ཀྱི་ཐུགས་ཀར་འདུག་སྟེ།",
    "བོད་ཡིག་དང་བརྡ་སྤྲོད་རིག་པའི་གཞུང་མ་བྱུང་བའི་གོང་རོལ་བོད་ཀྱི་འགྲོ་བ་འཇིག་རྟེན་དུ་ཆགས་དུས་ནས་བཟུང་མཁས་བླུན་གང་ཡང་རང་སྐད་ཤོད་ཤེས་པ་མིན་ནམ།",
    "ཆ་ཚང་ཞིང་མ་ནོར་བར་མཚོན་ཐུབ་པའི་ཚད་ཐུབ་ཀྱི་རིག་པའི་གཞུང་ལུགས་ནི་ཤིན་ཏུ་དཀོན་པར་གདའོ།",
    "སུམ་རྟགས་ཀྱི་རྩ་འགྲེལ་གང་ཡིན་ཡང་ཤ་གཟུག་ཟ་རྐྱང་རང་དཀོན་པ་ཡིན་པས།",
    "ཕྲ་ཞིབ་རིགས་པའི་ལམ་ནས་དྲངས་པའི་རྟོག་དཔྱོད་དང་དག་ཐེར་བྱེད་དགོས་པར་གདའོ།",
    "གལ་ཏེ་བཙན་གྱིས་བསྒྱུར་ཀྱང་རང་སྐད་ཀྱི་གོམས་སྲོལ་དང་མི་མཐུན་པས་བསྟན་དོན་གྱི་སྒྲིབ་བྱེད་དུ་འགྱུར་ཏེ་བརྡ་མི་འཕྲོད།",
    "བྱིང་རྒོད་ཀྱི་གཉེན་པོ་བརྟེན་པའི་བསྒྲིམ་པ་ཆེ་དགོས་པར་དུ་སེམས་བརྣལ་དུ་འདུག་པ་ཉིད་དང་།",
    "གྲོད་སོགས་བང་ན་འདུག་ཀྱང་རུང་།",
    "ཐ་མ་བརྒྱད་ཀྱང་རང་བཞིན་གྱི་ཉེས་པ་དང་།",
    "བེ་རོ་ཙ་ན་སྭཱ་ཧཱ།",
    "ཀན་ཙ་ན་ས་ཏྲི་ཤེ་སྭཱ་ཧཱ།",
    "ལེགས་པར་འོངས་པ་དེ་བཞིན་གཤེགས་པའི་སེང་གེའི་ཁྲི་བཤམས་པ་དེ་ལ་བདག་འདུག་སྟེ།",
    "དེའི་ཚེ་ན་གང་ཡང་ཉན་ཐོས་འཁོར་དེར་འདུག་པ་དེ་དེ་བཞིན་གཤེགས་པ་མི་མཐོང་ཞིང་།",
    "གང་ཡང་འདིར་འདུག་འདུག་པ་འདུས་པར་གྱུར་པ་གཞན་དུ་ན་ཅུང་ཟད་གཟུགས་སྣང་བ་ཡང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "ཅིའི་རྐྱེན་གྱིས་ན་གང་མེ་ཏོག་མེར་སྣང་བ་བེ་ད་ཱུརྱའི་དབྱིག་པ་འདི་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་པར་གྱུར།",
    "བཅོམ་ལྡན་འདས་དྲང་སྲོང་ཤཱཀྱ་ཐུབ་པའི་སྤྱན་སྔར་འདུག་སྟེ།",
    "བསམ་གཏན་ལ་འདུག་པ་མེད་པ་དང་།",
    "ནགས་འདབ་ཏུ་འདུག་པའི་ཕྱིར་སྤྱོད་པར་འགྱུར་རོ།",
    "རྒྱལ་བ་དཔའ་གཏོད་འདི་ལ་ཤིན་ཏུ་འདུག།",
    "གཅིག་ནས་གཅིག་ཏུ་གནས་ལ་འདུག་པའང་མེད།",
    "འདུག་པའང་མེད།",
    "དེ་ནས་མུ་སྟེགས་ཅན་དེ་དག་ཐམས་ཅད་མགུ་ཞིང་རངས་པ་དང་།",
    "ལ་ལ་འོད་འཕྲོ་བའི་ཕུང་པོའི་བར་དུ་གཟུགས་ཀྱིས་མདུན་དུ་འདུག་པར་གྱུར་ཏོ།",
    "ཚེར་མའི་མལ་དང་སྟན་ལ་འདུག་པ་ནས་ཙོག་པུའི་མལ་གྱི་བར་དུ་བྱོས་ཤིག།",
    "གཟུགས་རྣམས་འདྲེས་ནས་དུས་གསུམ་དུ་འདྲེས་པར་འདུག་གོ།",
    "མྱ་ངན་ལས་འདའ་བའི་ཁམས་ན་འདུག་པ།",
    "སུམ་ཅུ་རྩ་གསུམ་གྱི་ལྷར་སྐྱེས་སོ་ཞེས་གདའ་ན་དེང་བཅོམ་ལྡན་འདས་འཁོར་འདི་དག་དང་།",
    "ཡང་རང་སྨོས་ཏེ།",
    "ལྕགས་ཀྱི་ཁང་པ་བར་ཆད་བཅྭ་བརྒྱད་པོ་བརྩེག་མར་འདུག་སྟེ།",
    "དེའི་གྲྭ་བཞིར་ཟངས་ཀྱི་ཁྱི་ཆེན་པོ་བཞི་འདུག་པ་ལུས་ཀྱི་བོང་ཚད་ནི་འཕང་དུ་དཔག་ཚད་བཞི་བཅུ་ལ།",
    "ཨཱཾ་བ་བ་འབའ་ཞིག་ཟེར་ཞིང་འདུག་གོ།",
    "སྐད་ཅིག་དུས་སུ་ཕྱག་བྱས་ན།",
    "དེཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་ནི་མ་ཡིན་གྱི།",
    "དཔེ་མི་སྲིད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཟློས་པའི་ཉེས་པ་ཡང་སོ་ན་འདུག་སྟེ།",
    "དེ་ལ་ཡང་ཕ་རོལ་དང་ཚུ་རོལ་གྱི་ཆ་ཡུལ་དང་རང་བཞིན་ཐ་དད་པ་གཅིག་ཏུ་རྟོགས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་ན་གོམས་པ་ལས་འདི་ཞེས་ཞེན་པའི་རྣམ་པར་མདུན་ན་འདུག་པའི་དངོས་པོ་བདེ་བ་ལ་སོགས་པ་ལ་འཛིན་པ་ཡང་ཡིད་ཀྱི་མངོན་སུམ་ཡིན་ནོ།",
    "ཡུལ་དང་དུས་གཞན་དང་རང་བཞིན་གཞན་དང་མ་འདྲེས་པའི་ཕྱིར་རོ།",
    "འོ་ན་འོད་སྐྱེ་བ་ན་དེ་དག་མ་ལོག་པས་མ་ཁྱབ་པ་སོ་ན་འདུག་གོ་ཞེས་རྟོག་ན།",
    "དང་དུས་དང་རང་བཞིན་ངེས་པ་མི་རུང་བའི་ཕྱིར་ཏེ།",
    "རང་བཞིན་གཅིག་ཁོ་ནར་ངེས་ཤིང་རང་བཞིན་གཞན་སྤོང་བ་ནི་མི་འཐད་དེ།",
    "རྐྱེན་གཞན་ཡང་རང་ཉིད་ངེས་པའི་རྐྱེན་ཏེ།",
    "དུས་གཅིག་དང་རང་བཞིན་མི་གཅིག་པ་ལ་འབྲེལ་པ་གཉི་ག་འགལ་བའི་ཕྱིར་དང་།",
    "དེ་ལྟ་ན་ཡང་ཤེས་པ་དང་བརྗོད་པ་གཉིས་ཡང་རང་དང་གཞན་གྱི་དོན་ཡིན་པས་དབྱེ་བ་ག་ལ་ཡོད།",
    "དབྱེ་བ་མ་བསྟན་ཀྱང་རང་དོན་གྱི་མཚན་ཉིད་རྟོགས་ལ།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ནོ།",
    "འདི་གཉི་ག་ལ་ཡང་རང་ཉིད་རྟོགས་སམ།",
    "འཆོལ་བ་སོ་ན་འདུག་གོ།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་ཁོ་ནའོ།",
    "ཡོད་བཞིན་པའི་བློ་དང་རང་བཞིན་ཁྱད་པར་མེད་པས།",
    "དེའི་དུས་ན་ཡང་ས་ཕྱོགས་དང་རང་བཞིན་ཁྱད་པར་མེད་པའི་བུམ་པ་ནི་ཡོད་མ་སྲིད་དེ།",
    "སྔོན་མཐོང་བ་ལ་ལྟོས་པའི་ངོ་ཤེས་ཀྱིས་སྔོན་མཐོང་བ་དང་རང་བཞིན་མཚུངས་པར་ངེས་པར་བྱ་བའི་སྣང་བ་མི་དམིགས་པ་ཡོད་པས།",
    "གང་ཡང་ཤེས་པར་བྱེད་པ་མེད་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་དོན་གྱི་ངོ་བོ་དང་རང་བཞིན་གྱི་ཁྱད་པར་ལ་སྐུར་པ་འདེབས་པའི་འཁྲུལ་པ་ཉིད་དཔེ་དང་བཅས་ཏེ་བརྗོད་པ་ནི།",
    "ཀ་བ་དང་བུམ་པ་གཉི་ཀ་ཡང་རང་མེད་པའི་དུས་སུ་ལྡོག་པའི་ཕྱིར།",
    "འོན་ཏེ་འདིར་རྒྱུ་འབྲས་ཡིན་པ་ལ་མི་སྙོན་ཡང་གཞན་དུ་དེའང་རང་བཞིན་ཅན་རྒྱུ་འབྲས་མ་ཡིན་པ་སྲིད་པའི་དོན་ཡིན།",
    "དེ་གཉིས་དང་རང་བཞིན་མི་དམིགས་པ་ཐ་དད་པར་གྲུབ་བོ།",
    "གཞན་ཡང་རང་ཉིད་ཀྱིས་རབ་གསལ་བྱེད་ཅེས་བྱ་བ་རྗོད་པ་ཙམ་ལ་བྱས་ན་མ་ཁྱབ་པར་འཆད་པ་ཡང་འགལ་ཏེ།",
    "དེས་ན་རྟག་པ་ཐམས་ཅད་ནི་མེད་ལ་ཡོད་པ་ཐམས་ཅད་ནི་མི་རྟག་ཅེས་བྱ་བ་འདིས་ནི་དངོས་པོ་སོ་སོར་ངེས་པ་གང་ལ་ཡང་རྗེས་སུ་འགྲོ་ལྡོག་དུས་གཅིག་གམ་རིམ་གྱིས་རྟོགས་པ་མ་ཡིན་གྱི།",
    "དེ་ལྟ་བུ་དེ་ལས་བྱུང་བ་དང་དེའི་བདག་ཉིད་དེ་གཉིས་ཉིད་རྒྱུ་དང་རང་བཞིན་ལ་མི་འཁྲུལ་བའི་རྒྱུ་ཡིན་ནོ་ཞེས་བསྟན་པའི་དོན་དུ་གཏན་ཚིགས་གཉིས་སུ་ཕྱེའོ།",
    "གྲགས་པ་ཡང་རང་བཞིན་དུ་འདུ་བར་བསྟན་ཟིན་པས་ལོགས་སུ་མ་བྱས་སོ་ཞེས་སྟོན་པ་ནི།",
    "དེ་ཡང་རང་རིག་པས་གྲུབ་པ་མི་དམིགས་པ་ནི་རང་རིག་པས་གྲུབ་བོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "ཕྱེད་འོག་མས་ཀྱང་རང་དགའི་ཉེས་པ་སྤངས་ཏེ་སློབ་དཔོན་གྱི་ལུགས་འཆད་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "རྣམ་པ་གཉིས་ཏེ་ཞེས་པ་ནི་ཕྱེ་བའི་གྲངས་ཏེ་འདིས་ནི་བློ་དེ་ལ་ཡུལ་ལ་གསལ་བ་དང་མི་གསལ་བར་འཇུག་པའི་རྣམ་པ་གཉིས་ཡོད་པར་བསྟན་གྱི་རྫས་ནི་མ་ཡིན་ཏེ་གཉིས་ཀའང་རང་རིག་ཏུ་གཅིག་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "དུས་དང་རང་བཞིན་འགལ་བར་འཛིན་པར་མ་བསྐྱེད་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་རྗེས་དཔག་རྟོག་བྲལ་དང་རང་རིག་རྟོག་པ་ལས་ལོག་ན་རང་ཉིད་རང་ལས་ལོག་པར་འགྱུར་ལ་མ་ལོག་ན་ཡང་རྗེས་དཔག་རྟོག་བྲལ་དང་རང་རིག་རྟོག་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཕྱིས་ཀྱང་སྐྱེད་བྱེད་མ་ཡིན་པར་འགྱུར་ཏེ་ཉེ་བར་སྦྱོར་བའི་དོན་སྔ་མ་དང་རང་བཞིན་དང་ནུས་པ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་ཉམས་སུ་མྱོང་བའི་དུས་དེ་ཉིད་ཀྱི་ཚེ་དོན་དུ་སྒྲོ་འདོགས་ལ་སྒྲོ་བཏགས་པ་དེ་ཡང་དོན་དང་ཤེས་པ་གཉིས་ཀའི་རང་བཞིན་མ་ཡིན་ཏེ་བཙོ་བསྲེག་ལ་སོགས་པའི་དོན་བྱ་བ་སྒྲུབ་མི་ནུས་པའི་ཕྱིར་དང་།",
    "ངེས་པའི་བདག་ཉིད་མ་སྐྱེས་པ་ཡང་རང་རིག་པས་ཡུལ་དུ་བྱས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཡིན་ནོ།",
    "བདེ་བ་ལ་སོགས་པ་ཡང་རང་རིག་ལ་གཟུང་བའི་ཆར་མི་སྣང་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་བྱེད་མི་དམིགས་པ་ཡིན་ནོ།",
    "བདེ་སོགས་དང་རང་རིག་ཀྱང་དེ་ལ་སྒྲ་འགོད་པའི་དུས་ན་ཞིག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཡིན་ནོ།",
    "འདི་ལྟར་ནི་ཁྱེད་རང་ཡང་འདོད་པ་ཡིན་ནོ་ཞེས་སྨྲོས་ཏེ་མི་སྡུག་པའི་ཡུལ་ཅན་ནི་རུས་པའི་ཏིང་ངེ་འཛིན་ནོ།",
    "རྩོད་པའི་གནས་སུ་གྱུར་པའི་ཤེས་པ་ཐམས་ཅད་ཀྱང་རང་རིག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་འགལ་བ་དམིགས་པའོ།",
    "འདི་ལ་ཡུལ་རང་དང་རང་མ་ཡིན་པ་ཕན་ཚུན་སྤངས་ཏེ་གནས་པའི་འགལ་བ་ཡིན་པ་ན་དེ་རིག་པ་ཡང་དེ་ལྟར་དུ་འགྱུར་བ་ཡིན་ཏེ་ཡུལ་ཐ་དད་ཀྱང་ཡུལ་ཅན་གཅིག་ཡིན་ན་ནི་མིག་ལ་སོགས་པའི་ཤེས་པ་དུ་མ་དོན་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདིར་འཐད་པ་འདིས་ཕྱི་རོལ་གྱི་དོན་འགོག་པར་འདོད་པ་ནི་མ་ཡིན་གྱི་འོན་ཀྱང་དོན་ཡོད་ཀྱང་རང་རིག་པ་འབྲས་བུར་རིགས་ཀྱི་དོན་རིག་པ་ནི་མ་ཡིན་ཏེ་དོན་རྣམས་ནི་ཤེས་པ་རྟོག་མེད་མ་འཁྲུལ་བ་རྣམས་ཀྱིས་ཇི་ལྟར་བཀོད་པ་ལྟར་སྣང་བའི་ཕྱིར་རོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "གལ་ཏེ་གསལ་བའི་རང་བཞིན་དུ་རིག་ཀྱང་གཞན་ཡིན་པ་ཅི་འགལ་ཞེ་ན་ཤེས་པས་གཞན་གསལ་བའི་རང་བཞིན་དུ་རིག་ན་རང་མ་རིག་པར་འགྱུར་ཏེ་ཡུལ་རང་དང་རང་མ་ཡིན་པ་ཐ་དད་པས་ཡུལ་ཅན་ཡང་ཐ་དད་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྔོན་པོ་ལ་སོགས་པ་དེ་ཡང་གསལ་བ་དེའི་བདག་ཉིད་ཡིན་པ་དེའི་ཕྱིར་ཤེས་པ་དེ་ལྟར་སྣང་བ་ན་ཡང་རང་དང་གཞན་ལྟ་བུ་དེ་གསལ་བར་བྱེད་པར་འགྱུར་ཏེ་གསལ་བའི་སྒྲོན་མ་བཞིན་ནོ།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་དེ་གང་ལས་ལྡོག་པ་དེ་ལ་ནི་ཐེ་ཚོམ་སྐྱེད་པར་མི་འགྱུར་ཏེ་འོན་ཀྱང་རང་ཉིད་ཡོད་པས་དེ་མེད་པས་གོ་བར་འགྱུར་ལ་འགལ་ཟླ་མེད་པར་གོ་ན་ཡང་ཅིག་ཤོས་ཡོད་པར་གོ་བར་འགྱུར་བའི་ཕྱིར་དེས་ཐེ་ཚོམ་སྒྲུབ་པར་མི་འགྱུར་ན་འདི་ནི་ཐེ་ཚོམ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "མཉན་པར་བྱ་བ་ཡང་རང་ཡུལ་ལ་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་དོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་འགལ་བ་དམིགས་པ་ཡིན་ནོ།",
    "བསྒྲུབ་བྱ་ཡང་སྒྲུབ་པ་དང་དགག་པ་འགལ་བས་ཐ་དད་པ་ན་གཏན་ཚིགས་ཀྱང་གཉིས་ཡིན་ལ་སྒྲུབ་པ་ཡང་རང་ལས་ཐ་དད་པ་དང་ཐ་མི་དད་པའི་ཕྱིར་གཏན་ཚིགས་ཀྱང་གཉིས་ཏེ་དེའི་ཕྱིར་ཡུལ་གསུམ་དུ་གནས་པས་གཏན་ཚིགས་གསུམ་དུ་གནས་པ་ཡིན་ནོ།",
    "ནི་ཅི་སྟེ་དམིགས་པ་སྟེ་ཤེས་པ་མེད་པ་མི་དམིགས་པ་མེད་པར་རང་ཉིད་ཀྱིས་འགྲུབ་པར་འགྱུར་ན་ནི་དེ་བཞིན་དུ་དོན་གྱི་ཡོད་པ་མེད་པར་ཡང་རང་ཉིད་ཀྱིས་འགྱུར་བས་མི་དམིགས་པ་དོན་མེད་དོ།",
    "དགག་པའི་སྒོ་ནས་འཇུག་པ་རྒྱུ་དང་རང་བཞིན་མི་དམིགས་པ་གཉིས་ཏེ་བཞི་ཡིན་ནོ།",
    "རིག་བྱེད་རང་ཉིད་ཀྱང་རང་ཉིད་རིག་པར་བྱེད་པ་མིན་ཏེ་ཤེས་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་དང་རང་བཞིན་དེ་དག་ཁོ་ན་ཞེས་སྦྱར་རོ།",
    "གཉིས་པ་ལུང་རང་ཉིད་རང་དང་འགལ་བ་སྒྲུབ་པའི་གཏན་ཚིགས་སུ་མི་འཐད་པ་ནི།",
    "སྨྲས་པ་ཙམ་དང་རང་ཉིད་འདོད་པ་མ་ཡིན་པ་བཞི་ལ་ནི་མཚན་ཉིད་དེ་འཇུག་པ་མེད་པའི་ཕྱིར་རོ།",
    "དང་པོ་ལ་གཉིས་ཏེ་ཁས་བླངས་དང་རང་ཚིག་ཐ་དད་དུ་འདོད་པའི་ལུགས་དགག་པ་དང་།",
    "གསུམ་པ་འབྲས་བུ་དང་རང་བཞིན་ཕྱེ་བའི་དགོས་པ་བརྗོད་པ་ལ་དང་པོ་སྒྲུབ་པའི་དགོས་པ་ནི།",
    "གཅིག་ཏུ་ངེས་པ་དམིགས་པ་དེ་ཡང་རང་རིག་པའི་ཞེས་སྦྱར་ཏེ་དེའི་ཕྱིར་ཤེས་པའི་རྒྱུ་བྱེད་ཅིང་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡང་ཡིན་པས་རྩོད་པ་གཉི་ག་སྤངས་པ་ཡིན་ནོ།",
    "ཁྱད་པར་ཉིད་འཆད་པ་ན་གཅིག་པུ་ནི་ཐམས་ཅད་ཀྱང་རང་བཞིན་དང་ཐ་མི་དད་པའི་ཕྱིར་རོ།",
    "བསྟན་བཅོས་མི་ཤེས་པ་རྣམས་ཀྱང་དེ་ལྟར་མི་འཛིན་པ་དེའི་ཕྱིར་ཞེས་བྱ་བ་དང་གཞན་ལ་དེ་ཉེ་བར་ཞེས་བྱ་བ་དང་བདག་ལ་མཐོང་བ་དེ་ཙམ་གྱིས་ཞེས་བྱ་བ་དང་རང་བཞིན་མི་དམིགས་པ་དང་འགལ་བ་དམིགས་པ་དང་འགལ་ཁྱབ་དམིགས་པ་ལས་ཀྱང་ལྡོག་པ་མི་གྲུབ་པ་དེའི་ཕྱིར་ཞེས་སྦྱར་རོ།",
    "འདི་རྣམས་རང་རང་ལོངས་པ་ན།",
    "རང་རང་འཁོར་ལོས་དབྱུག་གུར་སྒྲོལ།",
    "མཁའ་རོ་ཐིག་དུས་ཐུབ་པས་སྒྲིལ།",
    "མེ་མིག་དུས་ཤར་དང་པོའི་སྒང་།",
    "ཚུལ་འདི་བཞིན་བགྱིས་ན་རྩིས་སློབ་གསར་བུ་བ་དག་ལ་ཕན་ཆེར་ཡོང་འདུག་པས།",
    "བྱས་ཙང་ཡག་པོ་བྱུང་འདུག་ཞུ་རྒྱུ་ཡིན།",
    "ས་ཐམས་ཅད་ཀཱི་སེང་ན་འདུག་པས་ཞོའི་སྤྲཱིས་མ་དང་འདའོ།",
    "འདཱི་རྣམས་ཀཱིས་སྣང་བར་བྱས་ཤཱིང་རང་བཞཱིན་གཱིས་ཁ་དོག་བསྒྱུར་བ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "དེ་ཡང་རང་བཞཱིན་གཱིས་རྣམ་པར་དག་པ་ཡཱིན་པའཱི་ཕྱཱིར་རྣམ་པར་དག་པ་སེ།",
    "ད་ནཱི་དེ་བཞཱིན་གཤེགས་པ་བཞཱི་པས་ཀང་རང་གཱི་མཚན་མའཱི་ཕྱག་རྒྱ་བཅོམ་ལྡན་འདས་དེ་བཞཱིན་གཤེགས་པ་རྣམ་པར་སྣང་མཛད་ལ་འཁོར་དུ་དབུལ་བར་བསན་པའཱི་ཕྱཱིར།",
    "སོད་ལམ་སྣ་ཚོགས་པ་ནཱི་འདུག་པ་དང་འགྲོ་བ་ལ་སོགས་པའོ།",
    "རང་གཱི་ཚིག་གཱིས་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ནཱི་འཆཱིང་བ་ཡཱིན་ནོ་ཞེས་བྱ་བ་བཞཱིན་ཏེ།",
    "དེ་ནས་རང་རང་གཱི་རཱིགས་ཀཱི་ཡེ་ཤེས་ལ་ཕྱག་རྒྱས་གདབ་པའཱི་ཕྱཱིར་ཕྱག་རྒྱ་བཞཱིའཱི་བདག་པོ་རྣམས་ཀཱིས་ཕྱོགས་ཐམས་ཅད་དུ་གནས་པའཱི་ཕྱག་རྒྱ་བཞཱི་སྤྲུལ་པ་མཛད་དོ།",
    "གང་འདཱི་ལྟར་རང་རང་གཱི་ཐུགས་ལ་ཞུགས་ནས་རྣམ་པར་སྣང་མཛད་ཀཱི་ཐུགས་ལ་ཞུགས་པ་འདཱི་ནཱི་ལུང་སཱིན་པའཱི་ཕྱཱིར་ཡཱིན་ཏེ།",
    "ལོངས་སོད་པའཱི་སྐུས་རང་རང་གཱི་དེ་བཞཱིན་གཤེགས་པའཱི་ཐུགས་ཀ་ནས་བྱུང་སེ།",
    "ཞེས་བྱ་བ་ནཱི་ཚུལ་ཇཱི་ལྟ་བ་བཞཱིན་དུ་འདུག་པའོ།",
    "ཇཱི་ལྟར་འདུག་པར་བྱ་བ་མཱི་ཤེས་པས།",
    "དེ་བཞཱིན་གཤེགས་པ་ཐམས་ཅད་ཀཱི་སེང་གེའཱི་གདན་ལ་འདུག་ཅཱིང་འཁོར་ལོ་སྤྲུལ་པ་དང་།",
    "ཁེད་རྣམས་གནས་འདཱིར་མ་འདུག་ཅཱིག་ཅེས་བརོད་པར་བྱ་བ་དང་།",
    "རང་རང་གཱི་ལས་མཛད་པའཱི་ཚུལ་དུ་གནས་པར་བྲཱིའོ།",
    "སེམས་དཔའ་ཆེན་པོ་དེ་རྣམས་རང་རང་གཱི་སོརསྐོར་གཞུག་པར་བྱའོ།",
    "འོན་ཀང་རང་གཱི་གནས་཈ཱིད་དུ་ཤེས་པར་བྱའོ།",
    "སོད་པ་ཞེས་བྱ་བ་ནཱི་འདུག་པ་དང་འགྲོ་བ་དང་཈ལ་བའཱི་སོད་ལམ་བཞཱི་པོ་རྣམས་སུ་ཇཱི་ལྟར་གནས་ཀང་རུང་སེ།",
    "བླ་ན་མེད་པ་ཡང་ཡཱིན་ལ་དགའ་བ་དང་མགུ་བ་དང་རངས་པ་ཡང་ཡཱིན་པས་བླ་ན་མེད་པའཱི་དགའ་བ་དང་མགུ་བ་དང་རངས་པའོ།",
    "གང་རང་དང་འཚམ་པའཱི་ཡུལ་ལ་ཡོངས་སུ་ལོངས་སོད་པ་ལས་བྱུང་བ་ནཱི་སྔོན་བྱུང་བ་ཡཱིན་ལ།",
    "ཐམས་ཅད་ཀང་རང་གཱི་ལས་ལ་བདག་པོར་གྱུར་པ་ནཱི་འགལ་བ་མེད་དོ།",
    "གཏོར་མ་ཁ་ན་མ་ཐོ་བ་མེད་པ་ཡང་ཅཱི་ནུས་སུ་བྱཱིན་ནས་དེར་འདུག་སེ་བསོམ་པར་བྱའོ།",
    "དེ་ནས་ཟ་བ་བཞཱིའམ་ལོ་གཅཱིག་གཱི་མཐར་གནས་དེ་ན་འདུག་བཞཱིན་དུ་སྒྲུབ་པའཱི་དུས་སུ་ཁཱིའམ་གཙུག་ལག་ཁང་གཱི་སེང་ངམ།",
    "རཱི་ལ་སོགས་པའཱི་སེང་དུ་འདུག་ལ་མཚན་ཐོག་ཐག་ཏུ་སཱིང་པོ་ཟོས་ཤཱིང་བསོམས་ན་འགྲུབ་པར་འགྱུར་ཏེ།",
    "མ་཈མ་པར་གནས་པས་འདུག་བའཱི་པའཱི་དུས་སུ་རང་གཱི་སཱིང་གར་བསོད་པའཱི་ཚུལ་གཱིས་འཇོག་པའཱི་གསོར་བའོ།",
    "དེ་ནས་ཁུ་ཚུར་ག་཈ཱིས་རང་རང་གཱི་རྣ་བའཱི་ལྟག་ཏུ་དངས་ལ།",
    "ལྡང་བའཱི་ཚེ་ཕྱག་རྒྱ་ཐམས་ཅད་རང་རང་གཱི་གནས་སུ་བཞག་སེ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་དང་རང་གཱི་དམ་ཚིག་གཱི་ཕྱག་རྒྱ་བཟུང་ནས།",
    "འདུག་གམ་཈ལ་ལམ་འགྲེང་ངམ་སེས་ཀང་རུང་།",
    "ཕྱག་རྒྱ་དེ་རྣམས་རང་རང་གཱི་གནས་སུ་གཞག་པར་བྱའོ།",
    "ད་ནཱི་དེ་བཞཱིན་གཤེགས་པ་མཱི་བསོད་པས་ཀང་རང་གཱི་རཱིག་པ་བསན་ཏེ།",
    "ས་གའཱི་འདུག་སངས་དང་།",
    "ཟླུམ་པོའི་འདུག་སངས་དང་།",
    "གཡས་བརྐྱང་བ་དང་གཡོན་བརྐྱང་བའཱི་ཐབས་རྣམ་པ་ལྔས་འདུག་སེ།",
    "ས་གའཱི་འདུག་སངས་ནཱི་རྐང་པ་ག་཈ཱིས་ཀཱི་བར་མཐོ་གསུམ་ཙམ་གཱིས་ཆོད་པར་བྱས་ལ་ལུས་དང་པོར་བྱའོ།",
    "ཇཱི་སྲཱིད་དཔུང་པ་བསྣོལ་ནས་སཱིང་པོ་ཟོས་ཤཱིང་འདུག་པ་དེ་སྲཱིད་དུ་དེ་བསྲུང་བར་འགྱུར་ཏེ།",
    "དབེན་པའཱི་ཕྱོགས་སུ་འདུག་ལ།",
    "ཀུན་ཀང་རང་བཞཱིན་འོད་གསལ་བ།",
    "དེ་ཡང་རང་བཞཱིན་ཏེ་ངོ་བོ་཈ཱིད་ཀཱིས་འོད་གསལ་ཞཱིང་དག་པ་ཡཱིན་པས་ན་རང་བཞཱིན་འོད་གསལ་བའོ།",
    "འགྲེང་ངམ་ཡང་ན་འདུག་ཀང་རུང་།",
    "སོ་སོ་ནས་རང་རང་གཱི་དངོས་གྲུབ་རྣམས་སྩོལ་བར་མཛད་པའོ།",
    "གང་ཞཱིག་གླུ་དང་གར་ལ་སོགས་པ་ལས་ལྡོག་པའཱི་བསབ་པ་བླངས་ཀང་རང་བཞཱིན་གཱིས་གླུ་གར་ལ་སོགས་པ་ལ་ཡང་དགའ་བ་ཞཱིག་ཡཱིན་ན།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའཱི་ཚེ།",
    "ཐམས་ཅད་དུ་ཡང་ཕྱག་ག་཈ཱིས་རང་རང་གཱི་ཕྱག་རྒྱ་དང་བཅས་པར་འཇོག་པ་ཡཱིན་པར་ཤེས་པར་བྱའོ།",
    "སེམས་དཔའ་གཞན་ཟོས་པས་ཀང་རང་གཱི་ཕྱག་རྒྱ་དང་ལྷན་ཅཱིག་ཏུ་སར་བར་བྱའོ།",
    "གང་དུ་ཞུགས་ནས་རང་གཱི་ལྷ་དང་རང་གཱི་ཕྱག་རྒྱ་མནོས་ནས།",
    "ཞུགས་ནས་འདུག་ལ་ཇཱི་སྐད་གསུངས་པའཱི་ཚུལ་བཞཱིན་དུ་བསྒྲུབ་པར་བྱའོ།",
    "རང་རང་ཕྱག་རྒྱ་རྣམས་སུ་ཞེས་བྱ་བ་སེ།",
    "དེ་བཞཱིན་དུ་ཕྱག་རྒྱ་བཞཱི་པའཱི་དཀཱིལ་འཁོར་གཞན་རྣམས་སུ་ཡང་རང་རང་གཱི་ཕྱག་རྒྱ་རྣམས་བྲཱི་བར་ཤེས་པར་བྱའོ།",
    "ཟ་རྒྱས་དཀཱིལ་འཁོར་ལོ་འདུག་སེ།",
    "དེ་ལ་འདུག་པས་ན་ཟ་རྒྱས་དཀཱིལ་འཁོར་ལ་འདུག་སེའོ།",
    "སན་སྔར་ན་འདུག་པའཱི་བཅོམ་ལྡན་འདས་ཀུན་དུ་བཟང་པོ་ཡཱིན་པར་བསོད་དོ།",
    "དེའཱི་མདུན་དུ་ཁེད་རྣམས་དགོས་པ་དེ་འགྲུབ་པར་བྱ་བའཱི་ཕྱཱིར་འདུག་པར་གཱིས་ཤཱིག་པའོ།",
    "དེའཱི་མདུན་དུ་དེ་བཞཱིན་དུ་འདུག་ཅེས་བྱ་བ་སེ།",
    "དེ་ཡཱི་རྒྱབ་ཏུ་འདུག་པར་བྱོས།",
    "དེ་ཡཱི་མདུན་དུ་རག་པར་འདུག།",
    "ཅེས་བྱ་བ་ནཱི་དེའཱི་མདུན་དུ་རྒྱུན་དུ་འདུག་ཅེས་པའོ།",
    "དེའཱི་དབུས་སུ་འདུག་སེ་ཡཱིད་ཀཱིས་སོ་བཞཱི་དབྱེ་བར་བྱའོ།",
    "དེར་འདུག་ནས་མངོན་སོད་ཀཱི་ལས་བྱ་དགོས་པའཱི་ཕྱཱིར་རོ།",
    "དཀཱིལ་འཁོར་དགོད་པ་ཇཱི་ལྟ་བ་དེ་བཞཱིན་དུ་འདཱིར་ཡང་ཟ་བའཱི་དཀཱིལ་འཁོར་ལ་འདུག་ནས་ཞེས་བྱ་བ་གནས་ནས་ཆེད་དུ་བརོད་པར་མཛད་པའོ།",
    "དེ་བཞཱིན་དུ་འདུག་པ་ཕྱག་རྒྱ་གཡོན་ལོགས་སུ་ཅུང་ཟད་བཏུད་ནས།",
    "དེ་ལ་ཐམས་ཅད་ཀང་རང་བཞཱིན་མེད་པ་཈ཱིད་དུ་བསོམ་པ་ནཱི་འོད་གསལ་བ་཈ཱིད་དེ།",
    "ཚུལ་ཇཱི་ལྟ་བ་བཞཱིན་དུ་འདུག་སེ།",
    "ཞཱི་བའཱི་ལས་ལ་ནཱི་སན་འཇམ་པོ་ལ་འདུག་ནས།",
    "འབྲས་ཀཱི་སཱིན་སྲེག་གཱིས་ཀང་རང་གཱི་ལྷ་དང་མེ་ལྷ་ཤཱིན་ཏུ་ཚིམ་ཞཱིང་དགེས་པར་བསམ་ཞཱིང་།",
    "དུར་བའཱི་མྱུ་གུ་མར་དང་བཅས་པས་ཀང་རང་གཱི་ལྷ་དང་མེ་ལྷ་ཡོངས་སུ་ཚིམ་ཞཱིང་མ་཈ེས་པར་བསམས་ལ།",
    "མེ་དང་རང་གཱི་ལྷ་ཁ་ལོ་བ་ལྟ་བུ་ག་཈ཱིས་བསྒྲུབ་པར་བྱ་བ་གང་པོ་ཆེ་ལྟ་བུའཱི་ཕག་པ་ལ་ཞོན་ཏེ།",
    "མང་པོ་ནས་ཇཱི་སྲཱིད་སེ་བོ་ཐམས་ཅད་ལ་ཐུག་གཱི་བར་དུ་དགའ་ཞཱིང་རངས་པར་འགྱུར་རོ་ཞེས་སོར་བའཱི་མཐུ་བསན་པ་ཡཱིན་ནོ།",
    "དེ་ལྟ་བུའཱི་འདོད་པའཱི་འབྲས་བུ་བསྲེགས་ན་འདོད་པའཱི་འབྲས་བུ་དེས་མེ་ལྷ་དང་རང་གཱི་ལྷ་དགེས་པར་འགྱུར་རོ།",
    "གོ་རོ་ཙ་ན་བུ་གར་བཅུག།",
    "ཞེས་བྱ་བ་ནཱི་དེ་཈ཱིད་ཀཱིས་གོ་རོ་ཙ་ན་དེ་གཡོགས་པར་བྱ་ཞེས་བྱ་བའཱི་དོན་ཏོ།",
    "དེ་ནས་གོ་རོ་ཙ་ན་དེ་ནམ་འབར་བར་གྱུར་པ་དང་།",
    "མཚན་ཐོག་ཐག་ལྷན་ཅཱིག་འདུག་པས་ན་གནས་པའོ།",
    "གང་རང་གཱི་ལུས་ཀཱི་ནང་དུ་བཅུག་པ་ཀུན་ནས་འབྱརའབྱོར་བར་བྱེད་པ་དེ་ལ་ནཱི་ལྷན་ཅཱིག་འཁྱུད་པ་ཞེས་བྱ་བ།",
    "ང་རང་ཡིད་འཕྲོག་འཚོལ་དུ་འགྲོ་བ་ཡིན།",
    "འབིགས་བྱེད་ཀྱི་ཤྲཱནྟ་ཀ་རཾ་མི་ལི་ཏ་ལོ་ཙ་ནཾ།",
    "ཨི་ཏི་ཏདྤ་ཙ་ན་ཤྲུ་ཏྭཱ་རཱ་ཛཱ་བི་ར་ཛ་སཾ་ར་བ།",
    "སྥུ་རནྟི་བ་ཙ་ནེ་ཡེ་ཥཱཾ་ས་ཛཱི་བསྟེ་ག་ཏཱ་ཤ་བ།",
    "ཨི་ཏྱུཀྟཱ་ཧྲྀ་ད་ཡ་ད་ཡི་ཏཱཾ་རཱ་ཛཱ་རཱ་ཛཱི་བ་ལོ་ཙ་ནཱཾ།",
    "ཨ་ཙིནྟ་ཡ་ད་ནོ་ཙི་ཏྱ་མཱཏྨ་ན་ཀརྨ་བི་པླ་བཱཏ།",
    "པདྨོ་དཱ་ར་ས་མུ་ད་བྷཱུ་ཏཱ་ཀ་ཎྱཱ་ཀ་མ་ལ་ལོ་ཙ་ནཱ།",
    "དེ་རྣམས་རང་རང་གནས་གཤེགས་ཏེ།",
    "བུ་དང་ཆུང་མ་ལུས་ལ་རཱི་རཱ་དི་ན་དེ་ཡཾ་ཏ་སྱ་ཀིཾ་ཙ་ན།",
    "ན་ཏྱཀྟུ་མརྷ་སྱ་ཛ་ནེ་བ་ནེ་བ་ན་ཛ་ལོ་ཙ་ན།",
    "སློང་བའི་གཉེན་ཁྱེད་རང་ཉིད་སྲོག་ལ་ཡང་།",
    "མདུན་དུ་འདུག་སྟེ་དེ་ལ་སྨྲས།",
    "ཤྲུ་ཏྭེ་ཏི་དེ་བ་དཱུ་ཏ་སྱ་བ་ཙ་ནཾ་མུ་ནི་མ་དྷྱ་ག།",
    "མཱུ་ཧཱུརྟྟ་བིསྨ་ཡཱ་སྱནྡ་སཱ་ནནྡ་སྣིག་ྡྷལོ་ཙ་ན།",
    "ཨ་ཙིནྟ་ཡཏ་སུ་ཀྲྀ་ཏི་ནཱ་མི་མཱསྟཱ་པ་བཞིན།",
    "ཏ་ཏ་སརྦ་སུ་རོཏྶྲྀཥྚ་སྤཥྚ་ལོ་ཙ་ན་ཥཊྤ་དེ།",
    "དེར་ནི་སྟན་གཅིག་ལ་འདུག་བའི།",
    "ཏྭཏྤྲ་སཱ་ད་པྲ་བྷཱ་བོ་ཡཾ་བི་ཏྱུ་བཱ་ཙ་ན་ཏཱ་ན་ན།",
    "ཨརྠི་སཾ་རོ་དྷསཾ་ཛཱ་ཏ་ལཛྫཱ་ཙ་ན་མི་ཏཱ་ན་ན།",
    "བྱ་བ་བསྒྲུབ་སླད་འདུག་པར་གྱུར།",
    "ཡཱ་ཙ་ན་ཏད་བྷག་བ་ཏ་ས་པུཎྱོ་པ་བ་ནཾ་ཡ་ཡོ།",
    "བི་ལོ་ཀྱ་ཀཱཾ་ཙ་ན་རུ་ཙིཾ་རཏྣ་བྷཱུ་ཥ་མེ་ཏོག་འབྲས་བུ་ཆེ།",
    "དུས་མིན་འགྲོ་བས་ཡིད་བྱུང་ནས།",
    "ཏསྨིན་སུ་ཀྵྨ་ཀྲ་མ་པ་རི་ཎ་ཏིརྨཱི་ན་བཪྻུཥྚ་ཀ་སོ་ནཱ་ནཱ་ཀཱ་ར་པྲ་ཙུ་ར་ར་ཙ་ནཱ་ཙི་ཏྲ་རཱུ་པོ་དྲལ་བུ་ཡིས།",
    "དེར་ནི་ཕྲ་བའི་རིམ་པས་ཡོངས་སུ་འགྱུར་ཞིང་རང་བཞིན་གྱིས་བཙིར་འདིར།",
    "ནི་ཏྱཱ་ཀྲནྡཱི་བ་ཙ་ན་བི་ར་ཧཱཏ་ཀཱ་ཡ་ཀཱིཾ་ཀླེ་ཤེ་ལཾ་ཀནྦོ་བྲཱུ་ཏེ་བི་ཥ་མ་བི་པ་དཱ་མཱསྤ་ད་ཏྭཾ་པྲ་ཡཱ་ཏ།",
    "སྲོག་ནི་མཐར་ཐུག་དུས་སུ་བློ་ཡིས་དེ་དྷི་ཡཱ་པྲཱ་ཎཱ་པཪྻནྟ་ཀཱ་ལེ།",
    "ནནྡ་པྲ་ཎ་ཡི་ནི་དྲྀཥྚཱ་སོ་ཙྪཱ་སཱཾ་ཙ་ནི་དྲང་ཞིང་རབ་ཏུ་གཡོ་བ་དག།",
    "ཨ་ཙིནྟ་དྷཙྩི་རཾ་ཏཏྟ་དུ་པ་བི་ཤྱ་ཤི་ལཱ་ཏ་ལེ།"
  ]
}