    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ལྡོག་ཁྱབ་ཡིན་ན།",
    "ཁ་ཅིག་བྱས་ན་མི་རྟག་པས་ཁྱབ་པ་དེ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་རྗེས་༧༧བ་ཁྱབ་དང་།",
    "རྟག་ན་མ་བྱས་པས་ཁྱབ་པ་དེ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ལྡོག་ཁྱབ་ཡིན་ལ།",
    "གལ་ཏེ་གང་བྱས་ན་མི་རྟག་པས་ཁྱབ།",
    "བྱས་ན་མི་རྟག་པས་ཁྱབ་པ་དེ།",
    "གང་རྟག་ན་མ་བྱས་པས་ཁྱབ།",
    "རྟག་ན་མ་བྱས་པས་ཁྱབ་པ་དེ་དེ་སྒྲུབ་ཀྱི་ལྡོག་ཁྱབ་མ་ཡིན་པའི་ཕྱིར་ཞེ་ན།",
    "སྒྲུབ་ངག་དེས་བྱས་ན་མི་རྟག་པས་ཁྱབ་པ་དང་།",
    "སྒྲ་བྱས་པར་དངོས་སུ་བསྟན་པས་བྱས་པ་དེ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པར་རྟོགས་ལ།",
    "དེའི་ཤུགས་ལ་བྱས་པ་དེ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ལ་མེད་པ་ཁོ་ནར་རྟོགས་པས་རྗེས་ཁྱབ་དངོས་བསྟན་དང་།",
    "དེ་བཞིན་དུ་སྒྲུབ་ངག་དེས་རྟག་ན་མ་བྱས་པས་ཁྱབ་པ་དང་སྒྲ་བྱས་པར་དངོས་སུ་བསྟན་པས་བྱས་པ་དེ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ལ་མེད་པ་ཁོ་ནར་རྟོགས་ལ།",
    "དེའི་ཤུགས་ལ་བྱས་པ་དེ་དེ་སྒྲུབ་ཀྱི་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པར་རྟོགས་པས་ལྡོག་ཁྱབ་དངོས་བསྟན་དང་།",
    "སྒྲ་རྟག་པར་མ་གྲུབ་པའི་ཕྱིར།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ངེས་པའི་ཕྱིར།",
    "བྱས་པ་དེ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་པར་ངེས་པའི་ཕྱིར་ཏེ།",
    "བྱས་པའི་རྟགས་ཀྱིས་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་རྗེས་ཁྱབ་ངེས་པའི་ཕྱིར་ཏེ།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ཡིན་པའི་ཕྱིར་ཏེ།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་མཐུན་ཕྱོགས་ཀྱི་མཚན་ཉིད།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་སྒྲུབ་ཚུལ་ལྟར་མི་རྟག་པས་མི་སྟོང་པ།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ཀྱི་མཚན་ཉིད།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་སྒྲུབ་ཚུལ་ལྟར་མི་རྟག་པས་སྟོང་པ།",
