    "ཡང་ཁ་ཅིག་གིས་ཀ་རྒྱ་ཆབ་རིལ་ཞེས་པ་དེ་རང་རེའི་ཆབ་འགག་ཡུལ་གྱི་སའི་ལྟེ་བ་དེར་ཕེབས་ནས་སའི་སྣོད་བཅུད་ཤིན་ཏུ་ལེགས་པར་མཁྱེན་ཏེ་ལབ་རྩེ་ཞིག་བསྟད་ན་འགྲོ་བ་ཀུན་ལ་ཕན་འབྲས་རྒྱ་ཆེན་པོ་མཆིས་པར་དགོངས་ནས།",
    "ཁོང་གིས་རབ་གནས་ཀྱང་ལེགས་པར་མཛད་པ་ནས་བཟུང་།",
    "ལོ་རེའི་ཟླ་དྲུག་པའི་ཚེས་བཅུ་བདུན་ཉིན་སྐྱེ་བོ་རྣམས་རང་ཤུགས་སུ་གནས་འདིར་འཛོམས་ནས་ལབ་ཙེ་བསྟོད་པ་དང་རྟ་རྒྱུག་མདའ་འཕེན་བྱེད་པ།",
    "ད་དུང་མི་འགའ་ཞིག་གིས་ཀ་རྒྱ་ཆབ་རིལ་ཞེས་པ་དེ་ཆབ་འགག་ཡུལ་འདིར་ཕེབས་ནས་གཞིས་ཆགས་ཤིང་།",
    "ཁོང་གི་དགོངས་པར་ད་ལྟའི་ལབ་རྩེ་ཆབ་རིལ་ཐང་ཟེར་བ་དེར་ལབ་རྩེ་ཞིག་བསྟད་ན་མི་ཕྱུགས་ཀུན་ལ་ཕན་པ་ཆེ་སྙམ་ནས་ལབ་རྩེ་ཞིག་བསྟད་ཅིང་།",
    "ཕྱིས་སུ་ཀ་རྒྱ་ཆབ་རིལ་གྱིས་འགོ་འཛིན་གནང་ནས་ལོ་རེའི་ཟླ་དྲུག་པའི་ཚེས་བཅུ་བདུན་ཉིན་ལ་ལབ་ཙེ་བསྟོད་པ་དང་།",
    "ལོ་རེའི་ཧོར་ཟླ་དྲུག་པའི་ཚེས་བཅུ་བདུན་ནས་བཅུ་དགུའི་བར་ལབ་ཙེ་བསྟོད་པ་དང་།",
    "བསང་འབོད་ཀྱི་ཚིག་ཀྱང་གསར་བ་བརྩམས་པ་ནས་བཟུང་ལོ་རེར་ལབ་རྩེ་བསྟོད་པའི་མི་གྲངས་ཀྱང་སྔར་ལས་ཇེ་མང་དུ་སོང་།",
    "འདུ་ཚོགས་ཀྱི་རྒྱ་ཁྱོན་ཡང་ལོ་རེ་ལས་ལོ་རེར་ཇེ་རྒྱས་སུ་གྱུར་ཏོ།",
    "བསང་རྩི་སོགས་རང་གིས་ཁུར་ནས་ལབ་རྩེ་ཆབ་རིལ་ཐང་ལ་འགྲོ་བ་དང་།",
    "རྒྱལ་མཚན་རྩེ་མོ་སོགས་ཀྱི་དར་ལྕོག་འཐེན་པ་དང་།",
    "སྐྱ་རེངས་ལྷ་ཁང་།",
    "གོམ་པ་འགྲན་པར་ཡང་བང་རྒྱུག་དང་ཁྱད་པར་ཆེན་པོ་མ་མཆིས་མོད།",
    "རྟ་རྒྱུག་གི་རྒྱལ་ཕམ་ཡང་མི་སྒེར་ཁོ་ནའི་མཚན་སྙན་དང་ལ་རྒྱ་མིན་པར།",
    "མི་རེས་འཕེན་ཐེངས་རེར་མདའ་གཉིས་ལས་འཕང་མི་ཆོག་གལ་སྲིད་མདའ་འཕེན་འགྲན་སྡུར་སྐབས་སུ་རྒྱལ་ཁ་བླངས་པས་ན་དགའ་རྟགས་ཡོད་པར་མ་ཟད།",
    "གཙོ་བོ་རང་གིས་མཆོད་བཀུར་བགྱིས་པའི་ཡུལ་ལྷ་གཞི་བདག་གིས་སྡོངས་གྲོགས་མཛད་པའི་འབྲས་བུ་ཡིན་པར་བསམ་འདུག་མདའ་རྩེད་ཀྱང་ཉིན་དང་པོ་སྟེ་ཚེས་བཅུ་བདུན་ལ་མཇུག་རྫོགས་མ་ཐུབ་ན།",
    "གལ་སྲིད་མོ་གསར་སྐྱེ་གཟུགས་ཡག་ལ་སྐད་ངག་ཀྱང་སྙན་ཞིང་འཇེབས་པ་ཞིག་ཡིན་ནའང་གླུ་ཁ་མཚར་དང་ཤགས།",
    "དུས་ཚོད་གཉིས་གསུམ་ལ་ལེན་རེས་བྱས་པས་མཇུག་རྫོགས་དཀའ་མོ་འདུག་གླུ་བ་དང་གླུ་མ་ཕུལ་བྱུང་ཅན་ཞིག་ཡིན་ཕྱིན།",
    "ཕན་ཚུན་བར་ཉིན་ཞག་གཉིས་རེར་ལེན་རེས་བྱས་ཀྱང་བླངས་མི་ཚར་ལ།",
    "མོས་འབྲེལ་བའི་ཟམ་ལམ་བཟོ་བའི་ལམ་ལུགས་ཤིག་ཀྱང་ཡིན་པ་བསྙོན་དུ་མེད་དོ།",
    "ལུང་བ་རེ་ལ་ཆུ་མིག་རེ།",
    "ས་ཆ་རེ་ལ་ལུགས་སྲོལ་རེ།",
    "དུས་ཡུན་ངེས་ཅན་ཞིག་གི་ནང་ཕན་ཚུན་ལ་བརྩེ་དུང་གི་ས་བོན་ཡང་ཡང་གཏོར་ཏེ།",
    "ཤི་ན་མཉམ་འཆི་དང་གསོན་ན་མཉམ་སྐྱིད་ཅེས་པའི་བརྩེ་དུང་ཟབ་མོ་མི་འགྱུར་རྡོ་རྗེའི་མནའ་ཡིས་མནན་ཡོད་པ་ཞིག་ཡིན།",
    "དེ་གཉིས་ཕན་ཚུན་འཕྲད་པའི་གོ་སྐབས་ནི་དགོང་མོ་མ་གཏོགས་ཕལ་ཆེར་མེད་ཅེས་བརྗོད་ཆོག་ལ།",
    "དེ་ནས་ཡང་སྐྱེས་པ་དང་བུ་མོ་གཉིས་ཀྱིས་བཟའ་རྟགས་བརྗེ་རེས་ཏེ་ཡང་བསྐྱར་སྐྱིད་ཀྱི་རྟ་ཕོར་མཉམ་ཞོན་དང་སྡུག་གི་ཁུར་བོ་མཉམ་ཁུར་བྱ་རྒྱུའི་ཆོད་སེམས་བརྟན་པོ་བཙུགས་ཤིང་ཕན་ཚུན་བར་སྐུ་རགས་བརྗེས་ནས།",
    "མཚོ་སྔོན་པོའི་འགྲམ་རྒྱུད་ཀྱི་འབྲོག་པ་ཚོར་མཚོན་ན་མུན་རུབ་རྗེས་ད་གཟོད་བག་མ་ཁྲིད་པའམ་བུ་མོ་རྐུ་བའི་སྲོལ་ཡོད།",
    "དགོང་མོ་དེ་ནི་ཧ་ཅང་ཉེན་ཁ་ཆེ་བ་ཞིག་སྟེ།",
    "དེ་བས་དགོང་མོ་དེར་རྐང་འཇབ་ལག་འཇབ་ཀྱིས་ངེས་པར་དུ་ཉེན་ཁ་དེ་ལས་རྒྱལ་དགོས་པས།",
    "སྐྱེས་པ་མག་གསར་ཉིད་འཇབ་འཇབ་ངང་བུ་མོའི་མལ་ཁང་སྔོན་ཆད་འབྲོག་པ་རྣམས་སྦྲ་ནང་དུ་བསྡད་ཡོད་སྟབས་ཕ་མེས་ཚོར་བའི་ཉེན་ཁ་ཧ་ཅང་ཆེ་དུ་འཛུལ་ཏེ་མགྱོགས་མྱུར་གྱིས་བུ་མོར་གོས་ལྭ་གསར་བ་བསྐོན་རྗེས་མཉམ་དུ་ཕྱིར་འབུད་པ་དང་མོ་རང་གི་མལ་སའི་ལཱ་བ་རྙིང་བའི་སྟེང་ཁ་བཏགས་དྲི་མ་མེད་པ་ཞིག་བཞག་པ་དེས་བུ་མོ་གནས་ལ་བྲོས་སོང་བ་ཤེས་ཐུབ་སྟེ།",
    "དེས་བུ་མོར་དེ་ཚང་གི་ཁྱིམ་གྱི་འབྱོར་ཕྱུག་དང་།",
    "དགོང་མོའི་ཉེན་ཁ་དང་ཉིན་སྐར་ཐག་གཅོད་པ་སོགས་ཀྱི་གོ་རིམ་ཡང་གོང་གསལ་དང་གཅིག་མཚུངས་ཡིན་པས་རྒྱས་སྤྲོས་མི་བྱའོ།",
    "ཤ་ཉེ་རིང་དང་ཕ་མས་བུ་མོ་བྱིན་ཏེ་གཉེན་སྒྲིག་པ་ཞེས་པ་ནི།",
    "བསམ་གཟས་ནས་ཁྱིམ་ཚང་ག་གེ་མོ་ཚང་གི་བུ་མོ་ཆེ་གེ་མོ་སློང་བར་བར་བ་མི་གཉིས་ནས་གསུམ་ཙམ་མངགས་ཏེ་དེ་དག་གིས་ཁ་བཏགས་དཀར་པོ་དྲི་མ་མེད་པ་ཞིག་དང་གོས་བཟོ་མགོ་བཅས་མདུན་ལ་བླངས་ནས།",
    "གཏམ་ཁ་ལྕེ་ཅན་གྱི་སསཔསབརྒན་པོ་ཞིག་གིས་ཆུ་བཞུར་བ་ལྟར།",
    "ད་རེབ་སྒོ་ཁའི་བུད་དེ།",
    "བུ་བུ་མོ་གཉིས་ཀྱི་དོན་དག་ཡིན་ཞེས་ཚིག་མགོ་གླེང་སྟེ།",
    "པ་རྒན་པོ་དྲང་བོ་ཁ་ཤས་ཀྱིས་བུ་མོ་འགྲོ་ས་གནས་དང་བན་དེ་འགྲོ་ས་སྒར་ཞེས་དཀའ་ལས་མི་གཏོད་པར་ཁ་ཡ་གཏོགས་མཚོ་སྔོན་པོའི་འགྲམ་རྒྱུད་ཀྱི་འབྲོག་པའི་གཉེན་སྲོལ་སྐོར་རགས་ཙམ་གླེང་བ།",
    "ལ་ལ་ཞིག་ལ་མཚོན་ན་དོན་རྣམས་གྲུབ་སྟེ་གཉེན་རྟགས་དང་སྟོན་མོའི་སྟེང་ལ་འཇོག་ཐུབ་པ་དང་།",
    "དེ་ལས་གཞན་ད་དུང་བུ་ཚ་ཕར་མག་པར་སྟེར་བའི་སྲོལ་ཡང་ཡོད་མོད།",
    "སྤྱིར་བུ་མོ་གནས་ལ་བྲོས་སོང་ན།",
    "བུ་མོས་གནས་དྲན་པ་དང་།",
    "མཛོ་མོས་ས་དྲན་ཞེས་པ་ལྟར་བློས་མི་ཐོངས་ནའང་།",
    "བུ་མོ་གཞན་ལ་མནའ་མར་སྟེར་སྲིད་པ་དང་།",
    "དེ་ལྟར་ཟ་མ་གཉེན་རྟགས་དང་སྟོན་མོ་གཉིས་ཉི་ཐོག་སྐར་ཐོག་ལ་བཞག་རྗེས་བར་བ་རྣམས་ཀྱང་མགྱོགས་མྱུར་གྱིས་ཕྱིར་བསྙེགས་ཏེ་ཨ་ཞང་ཚང་གི་ཆ་རྐྱེན་ལྟར།",
    "གཉེན་རྟགས་རྒྱག་པའི་ཉིན་མོར།",
    "གོས་ཚར་གོས་ལྭ་སོགས་བླངས་ཏེ་ཅུང་ཁེངས་སྐྱུང་གི་ཚུལ་དུ།",
    "ད་དུང་ཨ་མའི་ནུ་རིན་བཅས་ཁྱེར་ཡོང་སྟེ་ཀུན་གྱི་མིག་མདུན་ལ་བཤམས་ངེས་ཡིན།",
    "དེ་ལས་གཞན་ད་དུང་གཉེན་རྟགས་ལ་རྟ་སྟེར་བའི་སྲོལ་ཡང་ཡོད་མོད།",
    "ཉིན་དེར་ཨ་ཞང་ཚང་གི་ཉེ་རིང་ཡོད་ཚད་འདུས་ནས་གཉེན་ཚང་ས་མཚོ་སྔོན་པོའི་འགྲམ་རྒྱུད་ཀྱི་འབྲོག་པའི་གཉེན་སྲོལ་སྐོར་རགས་ཙམ་གླེང་བ།",
    "གྱོན་ཆ་དང་རྒྱན་ཆས་མི་འདང་ན་ཨ་ཞང་ཚང་གི་ཤ་ཉེ་རིང་གང་རུང་གིས་བྱ་རྒོད་པོ་ལ་ཅི་ཚང་།",
    "དེ་ལྟ་བུར་ཐུག་ཚེ་གཉེན་ཚང་གི་བར་བས་དོན་དེ་འདྲ་ཐེག་དཀའ་ན་ཡང་།",
    "ཇ་ཆང་གི་རྒྱ་མཚོ་བསྐྱིལ་བ།",
    "གདན་དཀར་དམར་གྱི་གྲལ་འགྲིག་པ་བཅས་ཀྱི་ཆ་རྐྱེན་སྣ་ཚོགས་ཚང་བའི་དམངས་ཁྲོད་ཀྱི་འདུ་འཛི་ཆེ་བའི་མི་ཚེ་གཅིག་གི་དོན་ཆེན་ཞིག་ཡིན།",
    "ཉིན་དེར་གཅིག་ནས་སྟོན་མོར་གཡང་འབོད་བྱེད་དགོས་ཏེ།",
    "སྟག་གཟིག་རྒྱལ་པོའི་ནོར་གཡང་ཤོག།",
    "སྨད་གླིང་སྤྱང་མོ་ལུང་བཞི་ཆགས།",
    "མཚོ་སྔོན་པོའི་འགྲམ་རྒྱུད་ཀྱི་འབྲོག་པའི་གཉེན་སྲོལ་སྐོར་རགས་ཙམ་གླེང་བགཉིས་ནས་ཉིན་དེར་མཆོད་ཁ་འཕེན་མཁན་ནི་བུད་མེད་ཁ་གཙང་མགོ་གཙང་བུ་མང་བ།",
    "ཉིན་དེར་ཨ་ཞང་ཚོས་ཀྱང་ཉི་རྩེ་ཤར་མ་ཐག་རྒྱན་གོས་ལེགས་པར་སྤྲས་ཏེ་བག་མ་སྐྱེལ་མཁན་གྱི་མི་ཉི་ཤུ་ནས་སུམ་ཅུ་ཙམ་གྱིས་བསྐོར་ནས།",
    "མག་ལྕག་མག་པར་སྐ་རགས་བཅིངས་པ་ཤ་རྒྱུག་ཤ་བུབས་གཅིག་ཨ་ཞང་ཚང་དང་གཉེན་ཚང་གིས་འཐེན་རེས་བྱེད་པའི་རྩེད་མོ་ཞིག་སོགས་སྟོན་མོའི་ཆོ་ག་སྣ་ཚོགས་ཀྱང་ཡོད་དོ།",
    "དང་ཆབས་ཅིག་བག་མ་དེ་ཁོ་མོའི་མིང་བོ་དང་གཞན་མ་གཉིས་ཀྱིས་བསྐྱོར་ནས་དལ་བུར་ཁྱིམ་དུ་འོང་།",
    "བག་མ་ལ་བག་རས་ཞེས་རས་གུར་ཆུང་ཆུང་མཛེས་ཤིང་ཡིད་དུ་འོང་བ་ཞིག་ཕུབ་སྟེ་དེའི་ནང་དུ་མོ་དང་བག་རོགས་མ་གཏོགས་གཅིག་ཀྱང་མེད།",
    "དེ་ནས་གྲལ་ལ་འཁོད་སྐབས་ཨ་ཞང་ཚོའི་གྲལ་གྱི་གོ་རིམ་ནི་འགྲུལ་མགོ་རྒན་པོ།",
    "ཨ་མྱེ་རྨ་ཆེན་སྤོམ་ར་མཆོད།",
    "གླིང་གི་དཔའ་རྟུལ་སུམ་ཅུ་མཆོད།",
    "ཅེས་ཇ་མཆོད་བསྡུས་པ་ཞིག་འུར་འདོན་བྱས་པའི་རྗེས་སུ་ལབ་གླེང་གི་འགོ་འཛིན་པ་ཡིན།",
    "དེ་ནས་མོ་ཁྱིམ་གྱི་མ་སྲུ་ཚོའི་གྲས་ནས་བུད་མེད་ཁ་བདེ་ཞིག་གིས།",
    "ཨ་མཚོ་སྔོན་པོའི་འགྲམ་རྒྱུད་ཀྱི་འབྲོག་པའི་གཉེན་སྲོལ་སྐོར་རགས་ཙམ་གླེང་བཞང་འགའ་རེས་བརྗེད་སོང་ཟེར།",
    "དེ་ལྟར་རྩེད་མོ་སྣ་ཚོགས་རྩེ་རྗེས་དམངས་གླུ་བླངས་ཏེ་གཅིག་གིས་གཅིག་ལ་གླུའི་ལྟ་བའམ་བསུ་མ་བྱེད་པ་ཡིན་ལ།",
    "ལོ་གཅིག་གི་ལོ་ཆང་ཁམ་པོ་འདི།",
    "གླིང་གི་སེང་ལྕམ་འབྲུག་མོས་༣༣ བསྙལ།",
    "བོད་དཔའ་རྩལ་ཆེ་བ་དེ་དོན་རེད།",
    "ལྟ་བུ་སོགས་བླངས་ནས་ཇ་ཡུན་ཙམ་འགོར་བའི་རྗེས་སུ་ཨ་ཞང་གི་གྲལ་ནས་ཀྱང་ཀླུ་བ་སྐད་ངག་ཡངས་པ་ཞིག་གིས།",
    "རི་མཐོན་པོ་ཡོད་ན་དམའ་མོ་བྱོས།",
    "ངས་སྲིད་པའི་གླུ་རྒན་ལེན་རྒྱུ་ཡིན་ཞེས་བརྗོད་མ་ཐག་ཚང་མ་ཕྱོགས་སོ་སོར་འཐོར་ནས་ངོ་མི་བསྲུང་བ་མ་གཏོགས་མཉམ་གཅིག་ཏུ་མི་འདུག་དུས་དེར་གཉེན་ཚང་རྒན་པོ་ཞིག་གིས།",
    "སྟ་རེ་བཟུང་ནས་ནགས་ལ་འགོ་ན་གནང་བ་བྱིན་པ་ཡིན་ཟེར་བ་ན།",
    "ཕོ་མོ་ཟུང་གིས་ལ་གཞས་ལེན་རེས་བྱེད་འགོ་རྩོམ་པ་དང་།",
    "གསར་བུ་གསར་མོ་ཚོས་ནམ་མ་གསལ་བར་དུ་ལ་གཞས་ལེན་རེས་བྱས་ཏེ་རྒྱལ་ཕམ་གྱི་དབྱེ་བ་ཐག་གིས་གཅོད་པ་རེད།",
    "གཉེན་ཚང་གིས་བཀྲ་ཤིས་པའི་ཁ་གཡང་སྒྲོག་བཞིན་དཔག་ཚད་གཅིག་གི་སར་སྐྱེལ་མ་བྱས་ཏེ་ཁ་གྱེས་པ་ཡིན།",
    "དེ་ལྟར་རིམ་གྱིས་བུ་དང་བུ་མོ་བཙས་ནས་ཁྱིམ་ཚང་དེའི་མནའ་མའམ་བདག་མོར་གྱུར་ཏེ་འཚོ་བ་ཕུན་སུམ་ཚོགས་པར་རོལ་ནས་ཚེ་མཇུག་སྐྱོང་བ་ཡིན་ནོ།",
    "ལོ་གསར་མ་ཐོན་གོང་གི་གྲ་སྒྲིག་ལོ་གསར་ནི་འཛམ་གླིང་གི་རྒྱལ་ཁབ་མང་པོ་དང་མི་རིགས་མང་པོར་ཐུན་མོང་དུ་དར་བའི་ལོ་གཅིག་གི་ཆེས་འདུ་འཛི་ཆེ་བའི་དུས་སྟོན་རྒྱ་ཆེན་པོ་ཞིག་ཡིན།",
    "ཆུང་བ་ནི་དཀར་ཡོལ་གྱི་ཆེ་ཆུང་ཙམ་མོ།",
    "དེའི་སྟེང་དུ་མེ་ཏོག་དང་རི་མོ་སྣ་ཚོགས་ཕབ་ཡོད་པའི་གོ་རེ་ཁྱད་པར་བ་ཞིག་ཡིན།",
    "ལོ་གསར་ཚེས་གཅིག་གི་ཆོ་ག་ནམ་གུང་སྟེ་ཆུ་ཚོད་བཅུ་གཉིས་ལ་ཐོན་མ་ཐག་ནས་ཁྱིམ་ཚང་ཕལ་ཆེ་བ་ཞིག་གིས་བསང་ཕུད་དེ་ལོ་གསར་གྱི་མཛད་སྒོ་ཐོག་མ་སྟེ་དཀར་ཡོལ་འབྲུག་མའི་ནང་ལ་འོ་ཇ་དཀར་པོའི་ཁར་འབྲི་མར་སེར་པོ་འཕངས་ནས།",
    "འབྲོག་པ་ཚོར་མཚོན་ན་ཉལ་གནོན་རྒྱག་པ་ཟེར་བ་ཞིག་ཡོད་ལ་དེ་ནི་ནངས་སྔ་མོར་སུ་ཚང་ལངས་མེད་ན་དེ་ཚང་ལ་བཀྲ་ཤིས་པའི་ཁ་གཡང་སྒྲོག་བཞིན་སོང་ནས་ཁྱིམ་མཚོ་སྔོན་པོའི་འགྲམ་རྒྱུད་ཀྱི་འབྲོག་པའི་ལོ་གསར་རོལ་སྟངས།",
    "འཚོ་བའི་ཆ་རྐྱེན་ཇེ་ལེགས་སུ་སོང་བ་དང་བསྟུན་ནས་ཆང་དམ་དང་ཇ་བག་ཀ་ར་རྡོ།",
    "ཚེས་པ་གཉིས་གསུམ་ལ་སླེབས་ཚེ་བུད་མེད་རྣམས་ཕན་ཚུན་ལ་ལོ་གསར་དུ་འགྲོ་བ་ཡིན་ནོ།",
    "ཚེས་གསུམ་གྱི་སྐྱ་རེངས་བཀྱགས་མ་ཐག་རྒན་པོ་ལོ་ལོན་ཁ་གཙང་མགོ་གཙང་ཞིག་གིས་བྱིས་པའི་སྐྲ་བཞར་ཏེ་རལ་བ་འཇོག་པ་ཡིན།",
    "ཁྱོད་བཙན་གྱི་རྩེ་མོ་དགུང་དང་མཉམ།",
    "རྒན་པོའམ་རྒན་མོ་ལོ་བདུན་ཅུ་ཟད་ནས་བརྒྱད་ཅུ་གྱ་གཅིག་ལ་སླེབས་ཚེ་བརྒྱད་ཅུའི་གྱ་སྟོན་བྱེད་པ་ཡིན།",
    "གྱ་སྟོན་ནི་མི་ཚེ་གཅིག་གི་མཇུག་མཐའི་སྟོན་མོ་ཡིན།",
    "གྱ་སྟོན་གྱི་རྒན་པ་དེ་ཚོར་མཚོན་ན་སྔ་མོ་ནས་སྐྲ་དང་ཁ་སྤུ་བཞར།",
    "ཞེས་པའི་ཚིག་གིས་སྔོན་བསུས་ཏེ།",
    "སྙན་ངག་གི་བསྟན་བཅོས་འདི་གནའ་དུས་ཀྱི་རྒྱུ་གར་གྱི་སྙན་ངག་མཁན་ཆེན་པོ་རྣམས་ལས་མཆེད་ཅིང་།",
    "ད་ལྟ་ང་ཚོ་བོད་རིགས་རྣམས་ཀྱི་ཕན་ཚུན་གྱི་ཚིག་སྦྱོར་གྱི་ནང་དུ་ཡང་དངོས་སུ་འབྲེལ་འདུག་པ་གསལ་ལེར་མཐོང་ཐུབ་པ་སྟེ།",
    "གླུ་གཞས་ཤགས་ལ་སོགས་པ་ཇི་སྙེད་ཅིག་བྱུང་བ་ཐམས་ཅད་ཕལ་ཆེར་སྙན་ངག་དང་ཚིག་རྒྱན་གྱིས་བཅིངས་ཡོད་པ་རེད།",
    "ཚིག་སྦྱོར་གང་ཡིན་ཡང་སྙན་ངག་དང་ཚིག་རྒྱན་གྱིས་སྤྲས་ན་དེ་དག་གི་དོན་གྱི་བརྗོད་བྱ་སྟོན་ཚུལ་རྣམས་མཛེས་ཤིང་གསལ་ལ་ཀློག་པ་པོའི་བློ་ཡིད་འགུག་ཐུབ་པ་ཞིག་ཡིན་ལ།",
    "སྙན་ངག་གི་ཚིག་རྒྱན་སྦྱོར་ཚུལ་སོགས་ལེགས་པར་བཀོལ་སྤྱོད་བྱེད་ཤེས་ན།",
    "དེ་ལས་ལྡོག་སྟེ་ངག་གི་སྦྱོར་བ་གང་ཞིག་སྙན་ངག་དང་ཚིག་རྒྱན་གྱིས་སྤྲས་པ་ལེགས་པོ་མ་བྱུང་ན།",
    "བུད་མེད་མཛེས་མ་སྒྲེན་མོར་རྒྱུ་བའི་དཔེ་བཞིན།",
    "རང་གིས་བསྟན་བཅོས་ལེགས་པོ་ཞིག་རྩོམ་དཀའ་ཞིང་།",
    "གཞན་གྱིས་བརྩམས་པའི་སྙན་ངག་གི་བསྟན་བཅོས་སམ་ཡང་ན་སྙན་ངག་གིས་བརྒྱན་པའི་བསྟན་བཅོས་ཇི་སྙེད་པའི་དོན་མི་གོ་ཞིང་འགྲེལ་མི་ནུས་ལ།",
    "བོད་ཀྱི་སྙན་ངག་རིག་པ་གལ་ཆེ་བའི་རང་བཞིན་ལ་རགས་ཙམ་དཔྱད་པརྒྱལ་པོ་ལང་ཚོས་དྲེགས་གྱུར་ཀྱང་།",
    "དེ་བས་ང་ཚོས་སྙན་ངག་རིག་པར་མཐོང་ཆུང་གི་བསམ་པ་འཛིན་མི་རིགས་པར་མ་ཟད་སློབ་སྦྱོང་གང་ལེགས་ཀྱིས་མཛེས་ཉམས་ལྡན་ཞིང་གོ་བདེ་ལ་དོན་དག་ཀྱང་གསལ་བོར་སྟོན་ཐུབ་པའི་རྩོམ་རིག་སྣ་ཚོགས་བརྩམས་ཏེ།",
    "ལྷག་པར་དུ་ཅན་བཞི་མངོན་འགྱུར་བཅས་ཀྱི་ཐད་ལ་ཞབས་འདེགས་ཞུས་ན་ཕན་ཐོགས་ཆེན་པོ་ཡོད་པ་རེད།",
    "གཉིས་པ་ལ་སུམ་བརྒྱ་བོད་ཀྱི་སྙན་ངག་རིག་པ་གལ་ཆེ་བའི་རང་བཞིན་ལ་རགས་ཙམ་དཔྱད་པདང་དྲུག་ཅུ་རེ་ལྔ།",
    "གཞན་ཡང་རྐང་པ་རེ་ལ་ཚེག་བར་མང་ཉུང་ཅི་རིགས་ཡོད་ནའང་ཚེག་བར་བདུན་མ་དང་དགུ་མ་དར་སྲོལ་ཆེ་ཞིང་།",
    "ཚེག་བར་ཉེར་བདུན་ཡན་ལ་རྒྱུན་ཆགས་སམ་རབ་བསགས་ཟེར་མོད།",
    "རྒྱན་ལ་ཡང་ཐུན་མོང་གི་རྒྱན་དང་ཐུན་མོང་མ་ཡིན་པའི་རྒྱན་གཉིས་ཡོད་ཅིང་།",
    "དེའི་སྔ་མ་སྟེ་ཐུན་མོང་གི་རྒྱན་ལའང་དོན་རྒྱན་དང་།",
    "གབ་ཚིག་གི་རྒྱན་རྣམས་སུ་དབྱེ་ཡོད་དེ།",
    "རང་རེའི་བོད་རིགས་ལ་མཚོན་ན།",
    "འཛམ་གླིང་སྟེང་གི་སྔོན་ཐོན་ཡིག་རིགས་ཀྱི་གྲས་སུ་ཡང་ཚུད་ཡོད།",
    "དུས་སྐབས་ཤིག་ལ་རང་རེའི་ཁ་བའི་ཡུལ་གྱི་ལྗོངས་འདིར་གཡོན་ལྷུང་ལམ་ཕྱོགས་ཀྱི་ཤུགས་རྐྱེན་ཐེབས་ཏེ།",
    "ཨ་རོགས་ཁྱོད་ཀྱིས་ཟ་མ་ཨེ་ཟོས་ཞེས་དྲིས་པ་ན།",
    "ང་ཚོ་ཚང་མ་ཏང་ཀྲུང་དབྱང་གི་ཟླལཟླ་བྱས་ཏེ།",
    "ལ་ཡང་ཧང་ལྟ་བུ་རྒྱ་སྐད་ཀྱི་སྒྲ་མི་དག་པའི་མིང་ཚིག་ཐ་སྙད་འདི་དག་གིས་བོད་སྐད་ཀྱི་ཚབ་བྱས་ནས་རྗོད་པ་ལ་བརྟགས་ན།",
    "བོད་སྐད་བཀོལ་སྤྱོད་ཀྱི་ཐད་དུ་ཚད་ལྡན་མིན་པའི་སྐད་ཆ་གསར་བ་སྣ་ཚོགས་བྱུང་སྟེ་ཕྱི་རབས་པར་རྙོག་དྲ་ཆེན་པོ་བཟོས་པ་རེད།",
    "མི་དེ་དག་གི་བསམ་པར་བོད་ཡིག་དང་བོད་སྐད་ལ་བཀོལ་སྤྱོད་ཀྱི་ནུས་པ་མེད་བསམས་ཏེ་དེར་མཐོང་ཆེན་བྱེད་ཀྱིན་མེད་པས་སོ།",
    "རང་རེའི་བོད་རིགས་ཕ་མ་སྐོར་ཞིག་གིས་རང་གི་བུ་དང་བུ་མོར་རྒྱ་ཡིག་ཁོ་ན་སློབ་ཏུ་འཇུག་པ་དང་།",
    "ངེད་ཅག་མི་རབས་འདིས་རང་གི་མི་རིགས་ཀྱི་སྐད་དང་ཡི་གེ་མ་སྦྱངས་ན།",
    "ད་དུང་དེང་རབས་ཀྱི་གསར་སྐྱེས་ན་གཞོན་སྐོར་ཞིག་གིས་དུས་རྒྱུན་རང་གི་མི་རིགས་ཀྱི་སྐད་ཆ་བཀོལ་སྤྱོད་མི་བྱེད་པའི་རྐྱེན་གྱིས་མི་རིགས་ཀྱི་འདུ་ཤེས་གསལ་བོ་མེད་པ་དང་།",
    "མི་རིགས་ཀྱི་སྐད་ཆའི་གལ་ཆེན་གྱི་རང་བཞིན་ལ་གོ་བ་ཟབ་མོ་མ་ལོན་པས་མི་རིགས་རང་གི་སྐད་སྨྲ་བར་ངོ་ཚ་བའི་གནས་ཚུལ་ཡང་ཡོད་པ་ཡིན།",
    "སི་ཏ་ལིན་མཆོག་གིས་མི་དམངས་མང་ཚོགས་ཁྲི་འབུམ་མང་པོས་རང་གི་མི་རིགས་ཀྱི་སྐད་ཆ་བཀོལ་སྤྱོད་བྱས་ན།",
    "ད་ལྟ་ང་ཚོའི་མི་སྐོར་ཞིག་གིས་མི་རིགས་པ།",
    "ཐ་ན་ཕན་ཚུན་ལ་ཚིག་བརྡ་ཙམ་ཡང་མི་འཕྲོད་པས་ན་སྐྱོབ་རྒྱུ་ཟེར་བ་དེ་ཁ་སྟོང་ནང་གི་ཚིག་སྟོང་ཙམ་དུ་ཟད་པ་མིན་ནམ་སྙམ་མོ།",
    "མི་རིགས་རང་གི་སྐད་དང་ཡི་གེ་བཀོལ་སྤྱོད་ལེགས་པོ་ཞིག་ཡོང་བར་བྱེད་ན།",
    "གོ་རིམ་ཡོད་པའི་ངང་ནས་བྱ་བ་འདི་དམ་འཛིན་ལེགས་པོ་བྱེད་དགོས་པ་རེད།",
    "མི་ཀརིགས་རང་གི་སྐད་དང་ཡི་གེ་བཀོལ་སྤྱོད་བྱེད་པའི་ཤེས་ལྡན་མི་སྣ་མང་པོ་སྐྱེད་སྲིང་བྱེད་དགོས་པར་བརྟེན།",
    "གལ་ཏེ་བོད་ཡིག་དང་བོད་སྐད་བཀོལ་སྤྱོད་བྱེད་པའི་གོ་སྐབས་ཡོད་པའི་སྐབས་སུ་རང་གི་མི་རིགས་ཀྱི་སྐད་ཆ་བཀོལ་སྤྱོད་གང་ལེགས་མ་བྱས་ན།",
    "དེ་སྔ་ལེ་ཉིན་མཆོག་གིས་ཀྱང་མི་སུས་མི་རིགས་འདྲ་མཉམ་དང་སྐད་ཆ་འདྲ་མཉམ་ཡིན་པ་ཁས་ལེན་དང་རྒྱུན་འཁྱོངས་བྱསམི་བྱེད་པ་དང་།",
    "མི་རིགས་རིང་ལུགས་པའི་ཞྭ་མོ་བསྐོན་པར་སྐྲག་ནས་མི་རིགས་ཀྱི་ཡི་གེ་དང་སྐད་ཆ་འཕེལ་རྒྱས་སུ་གཏོང་བར་འཇོག་འོས་པའི་གྲུབ་འབྲས་འཇོག་མ་ཐུབ།",
    "མི་རིགས་ཀྱི་བརྩེ་དུང་ཟབ་མོ་བཅངས་ཏེ།",
    "དེ་རིང་གི་བོད་རིགས་འདི་སང་ཉིན་མཉྫ་རིགས་སུ་འགྱུར་རྒྱུ་རེད་ཅེས་པ་ལྟ་བུ་ཡིན་པས།",
    "ངེད་ཅག་ཆེ་ཆུང་རྒན་གསུམ་ཀུན་གྱིས་རང་གི་མི་རིགས་ཀྱི་སྐད་དང་ཡི་གེ་བཀོལ་སྤྱོད་བྱེད་པར་འབད་བརྩོན་བྱེད་དགོས་པ་ལས་གཞན།",
    "གལ་ཏེ་མི་རིགས་རང་གིས་རང་ཉིད་ཀྱི་སྐད་དང་ཡི་གེ་མི་ཤེས་པ་དང་།",
    "རང་གི་བྱིས་པ་དག་ལའང་སྦྱངས་བརྩོན་བྱེད་དུ་མ་བཅུག་ན་མི་རིགས་ཞེས་པ་འདི་ཇི་ལྟར་གནས་ཐུབ།",
    "རང་རེའི་མི་རིགས་འདི་ཡང་གཞན་པའི་མི་རིགས་ཤིག་གི་སྐད་དང་ཡི་གེའི་རྗེས་སུ་འབྲངས་ནས་མི་འགྲོ་ཐབས་མེད་དུ་འགྱུར་ངེས་རེད།",
    "དེ་བས་ན་ངེད་ཅག་མི་སུ་དང་སུ་ཡིན་རུང་ཚང་མས་མི་རིགས་རང་གི་སྐད་དང་ཡི་གེ་རྒྱུན་འཛིན་དང་འཕེལ་རྒྱས་སུ་གཏོང་རྒྱུ་ནི་བརྗེད་དུ་མི་རུང་བ་ཞིག་ལགས།",
    "ད་དུང་མི་རིགས་གཞན་པའི་ཉམས་མྱོང་བརྗེ་རེས་སོགས་ཀྱི་ཐབས་ཤེས་སྤྱད་ནས་མི་རྣམས་ལ་མི་བོད་སྐད་བཀོལ་སྤྱོད་བྱེད་པའི་ཐད་ལ་ལྟ་ཚུལ་འགའ་བརྗོད་པརིགས་ཀྱི་སྐད་དང་ཡི་གེ་བཀོལ་སྤྱོད་མ་བྱས་ན་མི་ཆོག་པའི་གལ་ཆེན་རང་བཞིན་ཤེས་སུ་འཇུག་རྒྱུ་ནི་དགོས་མཁོ་ཤིན་ཏུ་ཆེ་བ་ཞིག་ཡིན་པར་སེམས་སོ།",
    "མི་རིགས་རང་གི་སྟོབས་དང་བརྩོན་འགྲུས་ལ་བརྟེན་དགོས་པ་ནི་སྨོས་མ་དགོས་སོ།",
    "ན་དེ་རིང་ངེད་ཅག་གི་རིག་གཞུང་གྲོས་ཚོགས་འདིར་མཚོན་ནའང་སྐྱེས་བུ་དམ་པ་མི་གཅིག་ཙམ་ཁོ་ནའི་རིག་གཞུང་གི་འབྲས་བུ་བརྗོད་པ་ཙམ་མིན་ཞིང་།",
    "དེ་ཡང་ཁོང་གི་གསུང་རྩོམ་མང་པོ་ལས་བདག་ལ་བག་ཆགས་ཟབ་མོ་ཞིག་བཞག་འདུག་པ་ནི།",
    "དེ་ནས་དབྱངས་ཅན་དགྱེས་གླུའི་དཔེར་བརྗོད་ཆ་ཚང་བ་དང་བོད་མཁས་དང་རྗེ་ཞྭ་དམར་པཎྜི་ཏའི་དཔེར་བརྗོད་གཉིས་ལས་གང་འཚམས་ཆ་ཚང་བ་བཀོད་དེ་ཞིབ་འགྲེལ་བྱས་པའི་མཐར་རང་ཉིད་ཀྱིས་དོན་ཟབ་གོ་སླའི་དཔེར་བརྗོད་ཆ་ཚང་བ་རེ་བཀོད་ཡོད།",
    "སྔོན་བྱོན་མཁས་པའི་སྙན་ངག་གི་འགྲེལ་བ་དག་ལས་གསལ་ཞིང་གོ་བདེ་བ་དང་།",
    "སྙན་ངག་གི་རྩ་བ་དང་དཔེར་བརྗོད་དག་འགྲེལ་བའི་སྐབས་སུ།",
    "དེར་རང་གི་ལྟ་བ་གསར་བའང་མང་པོ་བརྗོད་ཡོད་པར་མ་ཟད།",
    "གཅིག་ལས་གཅིག་ལྷག་གྲངས་མང་འཁྲུངས་མོད་ཀྱང་།",
    "མིག་བརྒྱ་སྤྲུལ་ནས་བཙལ་ཀྱང་ཡོད་རེ་སྐན།",
    "ཁྱོད་ཀྱི་མཛད་འཕྲིན་རི་བོའི་གཏོས་དང་མཉམ།",
    "ཁྱོད་ཀྱི་བློ་གྲོས་རྩལ་ལ་དོ་ཟླས་དབེན།",
    "དབྱིག་ལྡན་བུ་མོས་འཁུར་ཀྱང་འདེགས་མ་ནུས།",
    "བགྲང་བྱ་ཉི་ཤུའི་བགྲོད་ལམ་རིང་མོའི་སྟེང་དུ།",
    "ཡ་རབས་སྤྱོད་བཟང་གི་ལམ་དུ་འདྲེན་པའི་ནུས་པ་ཐོན་ཡོད་པ་དང་།",
    "གངས་ལྗོངས་འཛིན་མའི་ཁྱོན་ཡོངས་སུ་ས་ཁྱབ་རྡོ་ཁྱབ་ཏུ་སོང་ཡོད་པ་དང་།",
    "ན་གཞོན་རྩོམ་པ་པོ་དེ་དག་གི་ཁྲོད་དུ།",
    "དེ་མིན་རྩོམ་པ་པོ་སྐོར་ཞིག་གི་མཚན་དང་སྙན་གྲགས་རིམ་གྱིས་གངས་ལྗོངས་འཛིན་མའི་ཁྱོན་དུ་ཁྱབ་བཞིན་ཡོད་པ་ལས་གཞན།",
    "དུར་བུད་རྣམ་དུ་གྲགས།",
    "གང་ཞིག་སྦྲང་ཆར་བསིལ་མས་རིས་མེད་ཀྱིས་སྙོར་སྐྱོང་མཛད་པར་བརྟེན་ནས་གྲུབ་འབྲས་འབུར་དུ་ཐོན་པའི་ཆུ་སྐྱེས་མེ་ཏོག་གི་ཚོགས་ཤིག་ཡིན་པ་སུས་ཀྱང་བསྙོན་དུ་མེད།",
    "ཨུ་རུ་སུ་དང་ཨ་མེ་རི་ཁ།",
    "མི་རིགས་གཞན་གྱི་རྩོམ་རིག་གི་ཉིང་བཅུད་ལེན་པའི་གོ་སྐབས་ལེགས་པོ་བྱིན་པར་བརྟེན།",
    "སུང་གི་སུའུ་ཏུན་པོ་སོགས་ཀྱི་སྙན་ངག་སྐོར་ཞིག་བོད་ཀྱི་སྲོལ་རྒྱུན་སྙན་ངག་གི་ལུས་ལྟར་བསྒྱུར་འདུག་པ་དག་ལ་ཀློག་པ་པོ་མང་པོས་ཡི་རང་བྱེད་བཞིན་པར་མ་ཟད།",
    "སྦྲང་ཆར་རྩོམ་སྒྲིག་ཁང་གིས་སྐུ་བསོད་ཅན་གྱི་ཀློག་མཁན་ཞེས་པའི་བྱ་འགུལ་སྤེལ་ཏེ་ཀློག་པ་པོ་མི་ཉུང་བར་བྱ་དགའ་གནང་བས།",
    "བགྱིས་པ་ཉུང་བ་དང་གསུམ་བཅས་ཀྱི་ཐད་དུ་ཞན་ཆ་རེ་མཆིས་ཀྱང་།",
    "མ་འགྱངས་པར་གངས་ཅན་འཛིན་མའི་རྩོམ་རིག་གི་འདབ་བརྒྱའི་དབུས་སུ།",
    "ཕན་ཡོན་དགེ་མཚན་གྱི་མཐུན་རྐྱེན་ལེགས་མཚོ་སྔོན་མང་ཚོགས་སྒྱུ་རྩལ་གྱི་ཆུ་སྐྱེས་འདབ་པར་བསྒྲུབས་པར་བརྟེན།",
    "རིགས་མང་ཚོགས་རྣམས་ཀྱི་ལྟོགས་པའི་ཟས་བཅུད་དང་སྐོམ་པའི་བདུད་རྩིར་གྱུར་ཡོད་པ་འདིར་དགའ་མགུའི་གླུ་གཞས་མི་གཏོང་བའི་སྐྱེ་བོ་ཞིག་གང་ན་མཆིས།",
    "གང་གི་འདོད་མོས་ཇི་བཞིན་རིས་མེད་དུ་སྦྱིན་པ་ནས་བཟུང་།",
    "ལྷག་པར་དུ་རྩྭ་ཐང་གི་ན་གཞོན་སྐྱེ་ཕོ་མོ་རྣམས་ཀྱིས་མང་ཚོགས་སྒྱུ་རྩལ་མིག་གིས་མཐོང་བ་ན་གཅེས་ནོར་ཇི་བཞིན་བདག་དམ་བྱེད་པར་མ་ཟད།",
    "ལ་ལས་ནངས་དགོང་གི་དུས་ཚོད་བེད་སྤྱད་དེ་བློ་ལ་འཛིན་བཞིན་མཆིས་ཤིང་།",
    "ངོ་མ་ཉིན་མོའི་སྐར་མའི་དཔེ་བཞིན་དུ་གྱུར་པ་སྨོས་ཅི་འཚལ།",
    "རྒྱ་ཆེ་བའི་མང་ཚོགས་རྣམས་ཀྱི་ངག་ལས་འདི་སྐད་བརྗོད་བྱུང་།",
    "མང་ཚོགས་ཀྱི་སྐད་དང་ཕལ་ཆེར་མཐུན་པའི་སྒོ་ནས་རྩོམ་རིག་དག་ལེགས་སྒྲིག་དང་གསར་རྩོམ་བྱས་པས།",
    "ཕྱིས་སུ་བོད་སྤྱིའི་གོ་ཐུབ་པའི་ཐུན་མོང་གི་ཡི་གེ་དང་ཚིག་བཀོལ་ནས་རྩོམ་རིག་སྣ་ཚོགས་བྲིས་ན་ལེགས་པོ་འབྱུང་ཐུབ་པ་དང་བཞི་བཅས་ཀྱི་ཕྱོགས་སུ་ཅུང་ཟད་ལེགས་བཅོས་བྱེད་དགོས་པའི་རེ་བ་ཆེན་པོ་ཡོད་མོད།",
    "ཇི་བཞིན་ལྷང་ངེར་མ་མངོན་ཡིད་རེ་མུག།",
    "ཁོང་གི་ངོ་མཚར་ལྡན་པའི་གཏམ་རྒྱུད་དག་གངས་ཅན་ལྗོངས་ཡོངས་སུ་གནའ་ནས་ད་ལྟའི་བར་ཕལ་ཆེར་ས་ཁྱབ་རྡོ་ཁྱབ་ཏུ་གྱུར་ཡོད།",
    "རྩོམ་པ་པོས་འདི་འདྲའི་བརྗོད་བྱ་ཁྱབ་ཆེ་ཞིང་དོན་དང་ལྡན་པ་ཞིག་བཟུང་སྟེ་རྩོམ་རིག་གི་རྟོག་བཟོའི་རྩོམ་སྟངས་ལ་བརྟེན་ནས་གོ་རིམ་ཡོད་པའི་བརྩམས་སྒྲུང་རིང་གྲས་འདི་འདྲ་ཞིག་བརྩམས་ཏེ།",
    "ད་དུང་རྩོམ་པ་པོས་མི་རིགས་རང་གི་དཔའ་བོར་བཅངས་པའི་བརྩེ་དུང་དང་འདུ་ཤེས།",
    "བརྩམས་སྒྲུང་འདིའི་རྗོད་བྱེད་ཚིག་གི་ཐད་ནས་བལྟས་ན།",
    "སྙན་ངག་དང་བརྡ་རྙིང་གིས་མ་བཅིངས་པར་རྒྱ་ཆེ་བའི་མང་ཚོགས་ཀུན་གྱིས་གོ་སླ་བའི་ལམ་ནས་བརྩམས་ཡོད།",
    "ཁྱད་པར་དུ་བརྩམས་སྒྲུང་ནི་ཚིག་སྦྱོར་བདེ་ཞིང་མཛེས་ཉམས་ལྡན་པ་ཞིག་རེད།",
    "ངོ་མས་མིག་གི་སྤྱོད་ཡུལ་དུ་མཛེས་ལྗོངས་ཡིད་དུ་འོང་བ་ཞིག་ཤར་བའི་ཚོར་སྣང་བཅོས་མིན་ཞིག་སྟེར་ཐུབ་པར་མ་ཟད།",
    "གཞན་ཡང་མི་སྣ་ཞིབ་འབྲིའི་ཐད་དུ་ཡང་རྗོད་བྱེད་ཚིག་ལ་གསོན་ཉམས་ལྡན་ཞིང་ཡིད་འགུག་གི་ནུས་པ་ཐོན་ཡོད།",
    "དོ་བསྡོ་ལྟ་བ་མིག་གིས་མི་བཟོད་པ་ཞིག་བྲིས་པ་འདི་ལྟར།",
    "ཁྱོད་སྔོན་ཆད་ཀྱི་ཁྱོད་དང་འབྲལ་དགོས་པའི་རྐྱེན་གྱིས་ཁྱོད་ལ་མིང་གསར་བ་ཞིག་འདོགས་དགོས།",
    "ཁྱད་པར་དུ་ཕན་ཚུན་ཁ་བརྡ་བགྱིད་པའི་སྐབས་སུ་ཚིགས་བཅད་སྙན་ཞིང་འཇེབས་པའི་ལམ་ནས་བརྗོད་པ་དེས་བརྩམས་སྒྲུང་གི་རྗོད་ཚིག་ཕུན་སུམ་ཚོགས་པར་བཏང་འདུག།",
    "འདི་འདྲའི་རྩོམ་སྟངས་རྒྱ་རིགས་ཀྱི་བརྩམས་སྒྲུང་གསར་རྙིང་དུ་མཐོང་རྒྱུ་ཡོད་ཀྱང་རང་རེའི་བོད་ཀྱི་རྩོམ་རིག་གི་ནང་དུ་མཐོང་བ་ཧ་ཅང་དཀོན།",
    "ང་ཚོས་གང་ནུས་ཀྱིས་རྩོམ་སྟངས་ལེགས་པོ་སྣ་ཚོགས་སྤྱད་དེ་དར་ཁྱབ་ཏུ་བཏང་ན་མི་རིགས་རང་གི་རྩོམ་འབྲིའི་སྒྱུ་རྩལ་ཇེ་མཐོ་ཇེ་ལེགས་སུ་འགྲོ་བར་ཕན་ཐོགས་རྒྱ་ཆེན་པོ་མཆིས།",
    "ཁོ་བོས་གཤམ་དུ་ལྷག་བསམ་དྲི་མེད་ཀྱི་རེ་བ་འགའ་བཏོན་ན།",
    "གཅིག་ནི་བརྩམས་སྒྲུང་གི་མི་སྣ་གཙོ་བོ་ཀླུ་འབུམ་མི་རྒོད་ཉིད་བློ་རིག་རྒོད་ཅིང་དཔའ་ངར་རྟུལ་ཕོད་ཅན་ཞིག་ཡིན་པར་མ་ཟད།",
    "ཕམ་གཉིས་ནི་དམངས་ཁྲོད་ངག་རྒྱུན་གྱི་ཀླུ་འབུམ་མི་རྒོད་ནི་སྟོབས་ཤུགས་འགྲན་ཟླ་མེད་པའི་སྐྱེས་བུ་ཞིག་ཡིན་པ་ལས་གཞན་རྫུ་འཕྲུལ་ལྡན་པའི་མི་ཞིག་ཀྱང་ཡིན་ཕྱིར་ལྷ་སྒྲུང་གི་གྲུབ་ཆ་ཇེ་མང་དུ་བཏང་ན་བརྩམས་སྒྲུང་གི་སྒྱུ་རྩལ་གྱི་རང་བཞིན་མཐོ་རུ་འདེགས་ཐུབ་སྙམ།",
    "གསུམ་ནི་རྗོད་བྱེད་ཚིག་གི་ཐད་དུ་སྤྱིར་ཕུན་སུམ་ཚོགས་པ་ཞིག་ཡིན་ཡང་རྗོད་ཚིག་གི་སྒྱུ་རྩལ་མཐོར་འདེགས་ཡོང་བའི་སླད་དུ་ཚིགས་བཅད་ཀྱི་སྐོར་ཅུང་ཇེ་མང་ལ་བཏང་ན་ཚིག་ཤུགས་ཇེ་ཆེ་དང་ཇེ་བཟང་དུ་འགྲོ་ཐུབ་སྙམ་མོ།",
    "བརྩམས་སྒྲུང་འདི་རིགས་ཀྱི་སྐོར་མུ་མཐུད་དུ་དར་ཁྱབ་ཏུ་གཏོང་རྒྱུ་ནི་བདག་དང་བདག་འདྲའི་སྐྱེ་བོ་ཀུན་གྱི་རེ་འདུན་ཟློག་ཏུ་མེད་པ་ཞིག་གོ།",
    "གང་གི་གསང་གསུམ་ཉིན་བྱེད་དབྱེ་བའི་གཟི།",
    "བརྡར་བཏགས་ཇི་སྙེད་འཁྲུལ་པའི་མཚང་གཟིགས་ཀྱང་།",
    "ཐ་སྙད་ཕྲ་མོའི་གནས་ལའང་ཡེ་ཤེས་ཀྱི།",
    "འཆི་མེད་སེང་གེའི་མཛོད་འདི་བདག་གིས་དབྱེ།",
    "གཞན་དུ་བོད་སྐད་ཁོ་ནའི་སྟེང་ནས་མཁས་པར་རློམ་པ་དག་གིས་དོན་དཔྱིས་ཕྱིན་པར་གོ་བ་སྐད་དུ་བྱས་པ་རྣམས་ལའང་མུན་ནང་གི་མདའ་ལྟར་རློམ་ཚོད་དུ་མ་སོང་བ་ཆེས་མང་ངོ།",
    "དེ་ལྟ་མོད་ཀྱི་ཕྱི་དུས་འདིར་སྒྲ་རིག་པའི་གཞུང་ལུགས་ཆེན་པོ་རྣམས་ལ་སློབ་པ་འགའ་ཞིག་མཆིས་ཀྱང་དཔྱིས་ཕྱིན་པར་ཤེས་པ་ལྟ་ཞོག།",
    "ཕྱོགས་འགོ་དོད་པ་ཙམ་ཡང་ཆེས་དཀོན་པར་མཐོང་མོད།",
