    "ཀླུ་མོ་རྣམས་དགའ་བར་འགྱུར་ཞིང་ཀླུ་མོ་ཐམས་ཅད་ཚིམ་པར་འགྱུར་རོ།",
    "དེ་ནས་ཀླུ་མོ་བརྒྱད་སྟོང་ཕྲག་རེ་རེ་བཟླས་ན་མྱུར་དུ་ཀླུའི་༢་བུ་མོ་རྣམས་རང་གི་ཁྱིམ་ནས་འོང་ངོ།",
    "འོངས་པ་ལ་ལེགས་པར་འོངས་སོ་ཞེས་བརྗོད་ཅིང་བདག་གི་ཆུང་མ་༡གྱིས་ཤིག་ཅེས་བསྒོ་༢༢ན་ཉི་མ་རེ་རེ་ཞིང་རི་དོང་ཙེ་བརྒྱད་བརྒྱད་སོ་སོར་སྟེར་བར་བྱེད་དོ།",
    "ཆེ་གེ་མོ་འཚོ་བར་ཤོག་ཤིག་༢༥ཆེ་གེ་མོ་སོད་ཅིག་༢ཅེས་བྱ་བ་ལ་སོགས་པ་ཐམས་ཅད་འགྲུབ་༢་པར་བྱེད་དེ་ན།",
    "ཆུ་བོ་འདུས་པའི་འགྲམ་དུ་སོང་སྟེ་འོ་མའི་བཟའ་བས་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་བཟླས་པའི་མཐར་ཀླུའི་བུ་མོ་བཟང་མོ་འོང་ངོ།",
    "དོང་ཙེ་ཚོ་སྟེལྔ་ལྔ་ཉི་མ་རེ་རེ་ཞིང་རྐྱོ་༡སྟེར་བར་བྱེད་དོ།་།",
    "མཚན་མོ་པདྨའི་ཚལ་དུ་སོང་སྟེ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་ཀླུའི་བུ་མོ་རྣམས་མྱུར་དུ་འོང་ངོ།",
    "མཚན་མོ་ཆུ་བོ་འདུས་པའི་འགྲམ་དུ་སོང་སྟེ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་བཟླས་པའི་མཐའ་ལ་ཀླུའི་བུ་མོ་ངེས་པར་འོང་ངོ།",
    "འོངས་པ་ལ་གསེར་གྱི་པདྨའི་གདན་བྱིན་ཏེ་ལེགས་པར་འོངས་སོ་ཞེས་བརྗོད་ཅིང་བདག་གི་ཆུང་མ་གྱིས་ཤིག་ཅེས་བསྒོ་༥ན་ཉི་མ་རེ་རེ་༦",
    "གསེར་སྲང་རེ་རེ་སྦྱིན་པར་བྱེད་དོ།",
    "མཚན་མོ་རྒྱ་མཚོ་ཆེན་པོར་སོང་སྟེ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་དེ་ནམ་བཟླས་པའི་མཐའ་ལ་ཀླུའི་བུ་མོ་འོང་ངོ།",
    "འོངས་པ་ལ་བདག་གི་ཆུང་མ་གྱིས་ཤིག་ཅེས་བསྒོ་༧ན་དོང་ཙེ་ནགཅིག་དང་རས་ཟུང་གཅིག་༩",
    "ཀླུའི་ཁང་པར་སོང་སྟེ་ལྟེ་བ་ནུབ་ཙམ་དུ་ཆུར་ཞུགས་ཏེ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་དེ་ནས་བཟླས་པའི་ཐ་མ་ལ་ཀླུའི་བུ་མོ་འོང་ངོ།",
    "མཚན་མོ་ཀླུའི་ཁང་པར་སོང་སྟེ་མཚན་ཐོག་ཐག་བཟླས་ན་དེའི་ཐོ་རངས་༡་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་མི་ཏེ་ཀླུའི་བུ་མོ་སྐད་ཅིག་དེ་ལ་འོང་ངོ་འོངས་པ་ལ་མེ་ཏོག་དང་ཙནྡན་གྱི་མཆོད་ཡོན་བྱིན་ཏེ་ལེགས་པར་འོངས་༡་སོ་ཞེས་བརྗོད་ཅིང་ཆུང་མ་གྱིས་ཤིག་ཅེས་བསྒོ་༡ན་ལྷའི་དངུལ་ཆུ་དང་བཅུད་ཀྱིས་ལེན་དང་།",
    "མཚན་མོ་ཀླུའི་གནས་སུ་སོང་སྟེ་ཁྲི་བཟླས་ན་ཀླུའི་བུ་མོ་ངེས་པར་འོང་ངོ།",
    "ཀླུ་འོངས་པ་ལ་མྱུར་དུ་ཆགས་པར་བྱས་ནས་ཆུང་མ་གྱིས་མིཤིག་ཅེས་བསྒོ་དརིན་ཉི་མ་རེ་རེ་༣དོང་ཙེ་༥བརྒྱད་དང་།",
    "མཚན་མོ་ཀླུའི་ཁང་པར་སོང་ལ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན།",
    "དེ་ནས་བཟླས་པའི་ཐ་མ་ལ་ཀླུའི་བུ་མོ་རིངས་པར་འོང་ངོ་།་།",
    "ཉསྤོས་དང་མེ་ཏོག་གི་སྔགས་སོ།",
    "ཨོཾ་ཕུ་༡༢ཨ་ཕུ་ཧུ་དྲི་དང་མཆོད་ཡོན་གྱི་སྔགས་སོ།",
    "ཐལ་མོ་མཉམ་པར་བྱས་ཏེ།",
    "སོར་མོ་རྣམས་མགོ་བོའི་ཚུལ་དུ་སྦྱར་ལ་མཛུབ་ན་མོ་ཁ་བསྒྱུར་བས་མཐེ་བོའི་སོར་མོ་བརྐྱང་༢༢བ་ནི་ཀླུ་མོ་ཐམས་ཅད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "མཐེའུ་ཆུང་གི་སེན་མོ་མཐེ་༢བོས་མནན་ནས།",
    "སོར་མོ་ལྷག་མ་བརྐྱང་༧བ་ནི་ཀླུ་མོ་ཐམས་ཅད་ཀྱི་ཕྱག་རྒྱའོ།",
    "ཀླུ་མོ་རྣམས་ཀྱི་སྒྲུབ་པའི་ཐབས་ཀྱི་ཆོ་ག་རྒྱས་པའི་ཝ་ལེའུའོ།",
    "ཀླུ་མོ་རྣམས་སྒྲུབ་པར་བྱེད་པའི་ཆོ་ག་རྒྱས་པའི་ལེའུའོ།་།",
    "དེ་ནས་འཁོར་གྱི་དཀྱིལ་འཁོར་དེར་མི་འམ་ཅི་མོ་དྲུག་ལངས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དཔལ་རྡོ་རྗེ་འཆང་གི་ཞབས་ལ་སྤྱི་བོས་བཏུད་ནས།",
    "རིའི་རྩེ་མོ་ལ་སོང་སྟེ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན།",
    "མི་འམ་ཅི་མོ་དྲུག་གི་བཟླས་པ་རྫོགས་པ་དང་།་",
    "ཀྱེ་བཟང་མོ་བདག་གི་ཆུང་མ་གྱིས་ཤིག་ཅེས་སྨྲས་ནས།",
    "ལྷ་མོའི་ལག་པ་འཇམ་པོས་རྐང་པ་ལ་ཉུག་པར་བྱེད་ཅིང་མྱུར་དུ་ཆགས་པ་བྱས་ན་ཆུང་མར་འགྱུར་ཞིང་།་",
    "ཆུ་བོའི་འགྲམ་དུ་སོང་ནས་ཁྲི་བཟླས་ནས།",
    "ཉི་མ་རེ་རེ་ཞིང་༥་དོང་ཙེ་༥༦ལྔ་ལྔ་སྟེར་བར་བྱེད་དོ།",
    "མཚན་མོ་ཆུ་བོ་འདུས་པའི་འགྲམ་དུ་སྟོང་ཕྲག་བརྒྱད་བཟླས་ན་བཟླས་པའི་མཐའ་ལ་ངེས་པར་འོང་ཞིང་ལྟ་༧བར་བྱེད་དོ།",
    "ཉིན་གཅིག་བཞིན་དུ་རིའི་རྩེ་མོར་ཤ་ཟ་ཞིང་ཁྲི་ཁྲི་བཟླས་ན།",
    "ལྷ་མོའི་གཟུགས་ཀྱིས་མྱུར་དུ་འོངས་ཤིང་མདུན་དུ་སྡོད་དོ།",
    "མི་འམ་ཅིའི་བུ་མོ་སྒྲུབ་༡་པའི་ཐབས་ཀྱི་ཆོ་ག་རྒྱས་པའི་ལེའུའོ།",
    "རང་གི་སྟན་ལ་འཁོད་པར་རོ།",
    "འབྱུང་མོ་བརྒྱད་ནི་བྲི་བར་བྱ།",
    "འབྱུང་མོ་ཆེན་མོ་བརྒྱད་པོ་སྟེ།",
    "འབྱུང་མོ་བཞི་རྣམས་མཚུངས་པར་ནི།",
    "རྫུ་འཕྲུལ་ཆེ་ལྡན་འབྱུང་མོ་བརྒྱད།",
    "ལྷ་ཐམས་ཅད་གཞོམ་ཞིང་ལྷའི་བུ་མོ་ཐམས་ཅད་དང་།",
    "གནོད་སྦྱིན་མོ་དང་།",
    "ཀླུ་མོ་དང་།",
    "འབྱུང་མོ་རྫུ་འཕྲུལ་ཆེན་མོ་ཅན་རྣམས་སྐད་ཅིག་དེ་ཉིད་ལ་༡གཞོམ་པར་བྱ་སྟེ།",
    "ལག་པ་གཡོན་པ་ཁུ་ཚུར་བཅངས་ཏེ་གུང་མོ་བརྐྱང་བ་ནི་ཡིད་བཞིན་གྱི་ནོར་བུའི་རྒྱལ་མཚན་གྱི་ཕྱག་རྒྱའོ།",
    "ཐལ་མོ་མཉམ་པར་སྦྱར་་ཏེ།",
    "མཛུབ་༥མོ་གཉིས་བཀུག་པ་ནི་མེ་ཏོག་གི་ཕྱག་རྒྱའོ།",
    "སོར་མོ་རྣམས་ཕན་ཚུན་དུ་འཁྱུད་དེ་མཛུབ་ཕྱིརམོ་གཉིས་བརྐྱང་བ་ནི་སྤོས་ཀྱི་ཕྱག་རྒྱའོ།",
