    "ཧཱུཾ་ཡིག་གཅིག་རྣམས་འདུག་པ་ལ་ཕྱག་མཆོད་བྱས་པ་ཡིན་གསུངས།",
    "ཨ་ར་པ་ཙ་ན་འདི་སྒྲུབ་གསུངས་ནས་བསྒྲུབས་པས།",
    "མིག་མཐོང་མཁན་ཅིག་ཡོད་པ་དེས་སྔ་དྲོ་ཉི་མ་ལ་འཐོན་ནས་བསྡད་ཙ་ན།",
    "དེ་ཙ་ན་ས་སྐྱ་པའི་གཞིས་པས་འཕྲིན་བསྐུར་ཏེ།",
    "དེ་ནས་ཡར་བྱོན་ནས་མཁར་ཆུང་དུ་བཞུད་དགོངས་ཏེ་ཁྲེས་པོ་ཚུན་ཆོད་གྲབས་ཡོད་ཙ་ན།",
    "འོན་ཀྱང་སང་ཕོད་འགྲོ་སྙམ་ཙ་ན་སེ་གསུངས་པ་བདེན་ཏེ་སྐུ་འདས་པ་དང་།",
    "ལན་ཅིག་བླ་ཆེན་འདི་མེད་པར་མལ་ལོ་དཔོན་སློབ་ཚོས་རྟོག་བདུན་གྱི་སྔགས་ཤིག་ཐུ་ཡིན་འདུག་པ་དང་།",
    "དེ་ཁྱེར་ཏེ་འདི་ན་གདའ་ཞུས་པས།",
    "དེ་ལྟར་བྱས་པས་ཁོང་དམ་ཚིག་པ་བསམ་གྱིས་མི་ཁྱབ་པར་འདུག་པ་ལ།",
    "ད་ང་རང་ནོར་བ་ཡིན་ནམ་སྙམ་ནས་ལོག་པ་དང་།",
    "ཡི་གེར་འབྲིའམ་གང་བྱེད་ཀྱང་ཁྱེད་རང་དྲུག་པ།",
    "སྔགས་བོན་གཉིས་འདུག་པའི་གནས་དེར་སྔར་ནས་མེད་པའི་གཡག་རྒོད་རོག་པོ་གཉིས་རྭ་བདར་ལ་སོགས་པ་དྲག་པོའི་སྤྱོད་པ་ཟིལ་དང་ལྡན་པ་དུ་མ་བྱེད་པ་ཞིག་བྱུང་ཞིང་།",
    "དེ་ནས་ཁོང་རང་གཅིག་པུས་ཞག་བཅུ་ཕྲག་གསུམ་གྱི་བར་དུ་སྔགས་བོན་གཉིས་ཀྱི་ཞབས་ཏོག་ལ་ཆེས་ཆེར་བརྩོན་པ་ལྟར་བྱས་ནསཞག་སུམ་ཅུ་ལོན་པ་ཉེར་དགུའི་ནུབ།",
    "དུད་རིས་ལས་གྲུབ་པ་ཡིན་ཞེས་གླེང་བར་འདུག་གོ།",
    "ད་དེ་ཙམ་འདོད་པ་མི་འདུག་ནས་བསྟེན་གསུངས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ་དཀར་པོའི་མངོན་རྟོགས།",
    "ཨ་ར་པ་ཙ་ནའི་དཀྱིལ་འཁོར།",
    "ཕྱེད་ཙམ་ཐོན་ཙ་ན་གཉིད་སད།",
    "དེ་རྩ་བ་མཚལ་གྱིས་བྲིས་པར་བཤར་མར་འདུག་པ་དྲན།",
    "གཉིད་སད་པ་དང་སྟོན་པ་སྦལ་སྟོན་གམ་ན་འདུག་པ་ལ་བཟླས་ཏེ་དཔེ་གཡངས་པས་འགྲེལ་པ་དེ་སྣང་ངོ།",
    "འགའ་ཞིག་ལངས་ནས་དེ་ཉིད་ན་འདུག་།",
    "འོག་ན་གཡང་ས་ཆེར་ཡོད་པའི་ལམ་ཅིག་འདུག་པ་ལ།",
    "མང་པོ་གཅིག་ངེད་ཀྱིས་མི་ཐར་ཟེར་ཏེ་དེ་ན་འདུག།",
    "ད་ཁྱེད་རང་རྣམས་ཤོག་བྱས་ནས་བཞི་པའི་ལམ་ས་སྐྱ་བཀའ་འབུམ།",
    "དེར་དཔོན་གཡོག་ཐོན་པ་རྣམས་ཡར་བྱོན་པའི་བྱང་ངོས་ན་རི་ཟུར་ཟུག་པོ་ཅིག་འདུག།",
    "ཕྱི་ལ་ངོ་ཤེས་པ་དགའ་སྟོན་དང་གཞན་ལྔ་དྲུག་ཙམ་སླེབས་འདུག།",
    "ཞུ་ཡས་ལྟ་བུའི་བཟོད་པ་ཐོབ་པ་ལྔ་དྲུག་ཡོང་བར་འདུག་གསུངས།",
    "རྡོར་དྲིལ་ཅོག་ཙེ་ཁར་བཞག་དགོངས་ཙ་ན་བར་སྣང་ལ་ཁྲོལ་ལེ་བཞག་འདུག་པ་ལ།",
    "སྔ་གོང་ནས་ཀྱང་ཕྱག་ལན་མི་མཛད་པར་ཞུ་ཕུལ་བ་གདའ།",
    "ད་ལན་ཅིས་ཀྱང་མི་འཛིན་པ་འདུག་ཞུས་པས།",
    "ཚེས་བཅོ་ལྔའི་ཟླ་བ་རྒྱས་པ་ན་ལུང་པའི་མདའ་ན་ཇིག་དིར་མང་པོ་འདུག་པ་ལ།",
    "རྗེ་པ་འགྲོ་བའི་དོན་ལ་འབྱོན་དགོས་ཚུལ་ཞུ་ཡིན་འདུག་པ་ན།",
    "མདུན་ན་རྡོ་དཀར་འཇམ་ཅིག་འདུག་པས་དྲུང་ན་འཁོད་ནས་འདིའི་སྟེང་དུ་ཞབས་བཞག་ན་མཁའ་སྤྱོད་དུ་འགྲོ་ཟེར།",
    "དེ་ཙུག་འདུག་གསུངས་པས།",
    "མཐར་ཤར་ཕྱོགས་ནས་སྒོ་གཅིག་ཕྱེ་ནས་ནང་དུ་ཕྱིན་པར་སྣང་ནས་གཙུག་ལག་ཁང་ཤིན་ཏུ་བཟང་བ་ཅིག་འདུག།",
    "རྒྱལ་པོ་དཔེ་དཀར་ཁོ་ཆོ་འཕྲུལ་ཅིག་སྟོན་གྱིན་འདུག་པ་ཡིན་ཏེ།",
    "ཞེས་གསུངས་པའི་དོན་ཅི་དེ་ལགས་ཞུ་ཡིན་འདུག་པ་ལ།",
    "དེའི་གོང་དུ་རྒྱལ་པོའི་དྲུང་དུ་བོད་ཀྱི་བནྡེ་འགའ་འདུག་པ་ལ།",
    "ཧོར་གྱི་ལྷ་པ་གྲལ་མགོར་འཇོག་པ་ཡོད་པ་འདུག།",
    "ས་སྐྱ་པས་འབོད་ཅིང་འདུག་པས་དྲུག་པ།",
    "གསུངས་ནས་ཆེད་གཉེར་མཛད་ཅིང་འདུག།",
    "སྒོ་སྲུང་འཇིགས་སུ་རུང་བ་མང་པོ་འདུག་པ་དེ་རྣམས་ལ་བཀའ་བསྒོ་དང་།",
    "ཁྱད་པར་འཕགས་པ་སྤུན་ལ་ཐུགས་འདོགས་ཆེ་བར་འདུག།",
    "རྒྱལ་ཁམས་ཐམས་ཅད་ལ་ཕན་པར་བྱ་སྙམ་པའི་ཐུགས་དགོངས་བཟང་པོ་ཅིག་འདུག།",
    "ཁོང་རང་དང་མཐུན་པ་ཚོ་སྐྱིད་སྡུག་ཁོང་རང་དང་མཉམ་པར་བྱེད།",
    "རྟིང་བརླག་པར་བྱེད་པ་ཅིག་འདུག།",
    "ཧོར་ཁོ་རང་འུ་ལག་དང་དམག་ཁྲལ་ཆུང་།",
    "དེ་དང་སྦྱར་ན་གཞན་ཚོ་ང་བར་གདའ།",
    "ངོ་བལྟས་པ་རྣམས་བརྟན་ནམ་བྱས་པ་དེ་ཚོ་སྔོན་ལ་འདྲི་བར་འདུག།",
    "མགུ་ན་ཕན་ཐོགས་ནུས་པ་ཅིག་གདའ།",
    "འདིར་མི་གང་དྲག་པ་དང་འདབ་ནོར་ཁྱེར་ནས་འོང་བ་ཚོ་བཟང་པོར་གཏོང་བར་གདའ།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་ཀྱང་དེ་བཞིན་བྱེད་པའི་རིགས་སུ་མེད་པ་འདུག།",
    "གསེར་ཡོད་ན་གང་འདོད་འོང་བར་འདུག་པས་དགོངས་མཛོད།",
    "སྡིག་ཤས་ཆུང་བར་འདུག་སྟེ།",
    "འཇམ་དབྱངས་དང་བྱམས་པ་གཉིས་བགྲོ་གླེང་མཛད་ཀྱིན་འདུག་གསུངས།",
    "ཁྱེད་ལ་དེ་ཚང་ནས་འདུག་པས།",
    "དེ་ལྟར་ན་བོད་ཀྱི་བནྡེ་འདིར་འོངས་ནས་བསྡད་པ་ལ་དགོས་པ་མི་འདུག་པས་རང་ཡུལ་ལ་འགྲོ་བར་ཞུ་ཞུས་པས།",
    "སྔར་གྱི་ཚལ་པ་ལ་སོགས་པའི་བནྡེ་རྒན་པོ་འདི་རྣམས་ལ་འདིའི་ཡོན་ཏན་གྱི་ཆ་ཤས་སྔོན་གྱི་གཏམ་རྒྱུད་ཙམ་ཡང་མི་འདུག་པས་བོད་ལ་མ་བཏང་བར།",
    "བནྡེ་བོང་དང་མི་མཐུན་པའི་རྫུན་ཟེར་བ་ཅིག་འདུག་གསུངས་པ་ལ།",
    "རྒྱའི་ཡིག་ཚངས་ན་བཏབ་འདུག་པས་རྒྱལ་པོ་ཤིན་ཏུ་ཡིད་ཆེས་ཤིང་།",
    "ཨའུ་ཙེ་བ་འདུག་ན་ང་ཡང་ཞུ་གསུངས་པས།",
