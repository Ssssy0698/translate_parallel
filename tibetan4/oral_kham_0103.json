    "འོག་ཏུ་གཡང་ས་ཆེན་པོ་བྱས་པའི་སྟེང་ན་ལམ་ཞིག་འདུག་པ་ལ་བྱོན་ནས་ཡར་ཤོག་གསུངས་པས་མི་བརྒྱ་ཙམ་ཕྱི་ན་ཡར་བྱུང་།",
    "ཤར་ངོས་ན་གོང་ཉག་གཅིག་ལ་ལམ་ཞིག་འདུག་པ་ལ།",
    "མི་ཐར་བས་ཤར་ལམ་ལ་འགྲོཁྱེད་རང་འགྲོ་འདོད་ཡོད་པ་དག་ཀྱང་ཤོག་གསུངས་ཏེ།",
    "ཞུ་བྱས་ལྟ་བུའི་བཟོད་ཐོབ་ལྔ་དྲུག་ཙམ་ཡོང་བར་འདུག་གསུངས་སོ།",
    "འདི་ཁར་བྱོན་དང་གསུང་གླེང་ཕྲན་བུ་གདའ།",
    "མཚན་ཡང་དོན་དང་མཐུན་པ་འདུག་གོ་གསུངས།",
    "གསུངས་ནས་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི།",
    "ཕུག་པ་འདི་ཉིད་ཅུང་ཟད་ཆུང་འདུག་པས།",
    "དེ་དུས་ང་རང་རྒྱ་འོ་ཉིས་བརྩེགས་ཅན།",
    "ཁྱེད་རང་ས་སྐྱ་པ་ཚོ་ཅི་མནོ་བསམ།",
    "ཟམ་པ་ཤིན་ཏུ་ཆེ་བ་གསུམ་འདུག་པ།",
    "ཟམ་པ་གསུམ་འདུག་དེ་ཡི་དང་པོ་ལ།",
    "ལེགས་པར་ཕེབས་འདུག་ཅེས་པའི་སྐད་ཆ་གསན།",
    "བཟང་པོ་ཡིན་པའི་སྙན་གྲགས་འདུག་པ་ན།",
    "ཅི་འདྲ་འདུག་ཅིག་བལྟ་རུ་འགྲོ་དགོངས་ནས།",
    "ས་ཆེན་ཉིད་ལ་ཁྱེད་རང་གང་ནས་ཡིན།",
    "བ་རི་བ་ཞེས་བྱ་བ་གཅིག་འདུག་ཟེར།",
    "མི་རྣམས་ཤི་གསོན་མི་འཕྲད་ཟེར་འདུག་ཀྱང་།",
    "ཞལ་ཆེམས་ལ་ནི་ཁྱེད་རང་རབ་བྱུང་ནས།",
    "ཐོག་མར་ཁྱེད་རང་ཡོང་བར་བྱེད་མཁན་ཀྱང་།",
    "ང་རང་ཡིན་ཏེ་སེར་ཆས་མ་མཛད་པ།",
    "ཤབ་ཤོབ་འར་འུར་མང་པོ་མཛད་ཀྱིན་འདུག།",
    "ཡིན་ཤས་ཆེ་སྟེ་ཁྱེད་རང་མ་ནོར་རམ།",
    "ངས་ནི་ནོར་འདུག་བྱས་པས་མ་ནོར་ཟེར།",
    "གཏང་དགོས་འདུག་པས་ད་ལན་ཁྱེད་རང་ཡང་།",
    "ཉེས་པ་ཅུང་ཟད་འདུག་པས་ཡིག་བརྒྱ་དང་།",
    "ད་ནི་ང་བས་ཁྱེད་རང་མི་ཞན་པས།",
    "གང་བྱེད་ཁྱེད་རང་གང་བདེ་མཛད་པས་ཆོག།",
    "ཟེར་བ་མི་འདུག་དེ་དང་མཚུངས་པར་ནི།",
    "ལོ་ཟླ་ཚེས་གྲངས་གཅིག་པར་འདུག་ཅེས་གྲགས།",
    "གསུངས་འདུག་ཐུགས་གཞིག་མཛད་པ་ཞུ།",
    "འདི་སྐད་གསུངས་འདུག་དགོངས་གཞིག་མཛད་པ་ཞུ།",
    "སྔར་གྱི་བཞུགས་ཁྲི་ཆུང་ངུ་འདུག་པ་དེ།",
    "གསུངས་ནས་ཁོང་རང་བཞུགས་སའི་ཕུག་པ་དེའི།",
    "ལྗགས་ཆབ་བཏབ་ནས་དེ་ན་ཆུ་འདུག་པ།",
    "རང་རང་ཕྱོགས་ཞེན་བྱེད་པ་མང་ཡོད་ཀྱང་།",
    "བདག་ནི་མཐོང་རྒྱ་ཆུང་བས་ལོས་ཡིན་ནམ།",
    "གོང་མའི་སྙན་བརྒྱུད་འདུག་པའང་མ་ཐོས་སོ།",
    "འདུག་ས་དེ་རུ་ང་ཡི་མ་ཤེས་སྙམ།",
    "ཕེབས་ཀྱི་ཡོད་འདུག་ཟེར་བའི་སྙན་གྲགས་ཀྱིས།",
    "ཚོགས་པ་དེ་ཡི་དབུས་ན་བཞུགས་འདུག་པ།",
    "ཁྱེད་རང་རིམ་གྱིས་ཤོག་ཅིག་གསུངས་པ་ལྟར།",
    "འོ་ན་ཁྱེད་རང་ཅི་རྩོལ་གྱིས་ལ་རྒྱུག།",
    "ན་ནིང་ངེད་ཀྱི་ཅུང་ཟད་མ་ཤེས་འདུག།",
    "འགྲུལ་པ་ལ་སོགས་སུ་ཡང་མི་འདུག་པས།",
    "ཡིད་བརྟན་ཐུབ་པ་ཤིན་ཏུ་དཀའ་བ་འདུག།",
    "བྲལ་བ་དེ་འདྲ་འདུག་ན་ཐུགས་རྗེས་བཟུང་།",
    "ད་ནི་ང་ལ་བཅོས་ཁ་བྱེད་རན་འདུག།",
    "དབུ་བཙུགས་ཞལ་ཀྱང་ནུབ་ཕྱོགས་འགྱུར་ནས་འདུག།",
    "ལེགས་པར་འབྱོར་སྟེ་སྐུ་འབག་འཆུས་འདུག་པས།",
    "བཀའ་ནན་བྱུང་འཕྲལ་ཕོ་ཉ་ཁོ་རང་ནི།",
    "གལ་སྲིད་ངེས་པར་བདག་ཅག་དགོས་འདུག་ན།",
    "ཕོ་ཉས་སླེབས་རྗེས་སྤངས་ཞེས་གནང་འདུག་པས།",
    "བརྡབ་ཁོ་རང་སྐད་ཅིག་ལ།",
    "གཞན་མ་ཁྱེད་རང་བཀའ་ལུང་གང་གནང་ཡིན།",
    "ཞལ་ནི་གདངས་ཁ་ཆེ་བར་འདུག་པ་ལས།",
    "མི་གནང་ཁ་མེད་འདུག་གོ་ཐུགས་རྩོལ་གནང་།",
    "ཀུན་གྱིས་མཐུན་པར་འདི་འདྲ་འདུག་ཅེས་པ།",
    "ཁྱེད་ཚོར་མཐོང་སྣང་ག་འདྲ་འདུག་ཅེས་དྲིས།",
    "འདི་ལའང་དམ་ཤིང་ཤུབ་བཅས་ཟེར་བ་འདུག།",
    "རྣམ་གྲངས་ཤིན་ཏུ་མང་བ་འདུག་ན་ཡང་།",
    "སྔ་དུས་སྙུག་སྡོང་ཆེན་པོ་ཞིག་ཀྱང་འདུག།",
    "འདུག་ས་གདན་སའི་ཤར་གྱི་གྲོགས་པོ།",
    "འོ་ན་དེ་ལྟར་ལེགས་སོ་ཁྱེད་རང་རྣམས།",
    "གོས་ལྷམ་གནང་ན་ཐུགས་རྗེས་བཟུང་བ་གདའ།",
    "རྣལ་འབྱོར་མ་ནི་དཔོན་སློབ་བཞི་གདའ་སྐད།",
    "རྣལ་འབྱོར་མ་ནི་སྒྲུབ་པ་མཛད་ཀྱི་འདུག།",
    "ང་རང་ཆེ་བས་ལོ་ཙཱ་དཔོན་སློབ་ཀྱིས།",
    "བར་ཆད་ཅིག་ནི་འོང་བར་འདུག་པས་ན།",
    "ལེགས་པར་ཕེབས་གྲུབ་འདུག་པས་ངོ་མཚར་སྟེ།",
    "བྲན་དུ་འཁོལ་བའི་ནུས་པ་ཅན་ཞིག་འདུག།",
    "ཁྱེད་རང་རྒྱ་གར་འཕགས་པའི་ཡུལ་གཤེགས་ཤིག།",
    "རྫུ་འཕྲུལ་དུ་མ་སྟོན་པར་འདུག་པ་དང་།",
    "གཉན་གྱི་བཀའ་བཞིན་ཁྱེད་རང་ནམ་གཤེགས་བར།",
    "འགྲོ་འདུག་བྱེད་པའི་སྐྱེ་བོ་ཐམས་ཅད་ཀྱིས།",
    "དེ་སོགས་རྒྱས་པར་གསུངས་འདུག་ཐུགས་གཞིས་འཚལ།",
    "ཤིན་ཏུ་མང་བར་འདུག་པས་དེ་དག་རྣམས།",
    "དེ་འདྲ་ཡོད་ཀྱང་རང་ཉིད་ང་རྒྱལ་གྱིས།",
    "མི་གསོན་ཤི་མི་འཕྲད་ཟེར་ཏེ་རྫུན་དུ་འདུག་གསུངས་ནས་ཞལ་སྤྲད་ཅིང་ཤིན་ཏུ་དགེས་པར་མཛད་ནས་ཞག་འགའ་དབུ་སྔས་སྦྲེལ།",
    "ང་རང་པོ་ཆེ་ཡང་བུན་ལེན་པ་ཞིག་ཡིན་གསུངས།",
    "ཁྱེད་ལ་བརྒྱུད་པ་མཆོག་གཅིག་ཡོད་འདུག་པ།",
    "ཕྱིས་ནི་པུར་བཞུ་བའི་དུད་རིས་ལས་གྲུབ་པ་ཡིན་ཞེས་གླེང་བར་འདུག་གསུངས།",
    "རྒྱང་ནས་སྒྲ་སྙན་ཆེ་བ་ཙམ་ནི་འདུག།",
    "དེ་ཙམ་དུ་གདའ་ཡོ་གསུངས་ཏེ།",
    "འཁྱགས་ན་དགའ་སྟེ་སྙམ་ཙ་ན་འཁྱགས།",
    "རྗེ་པས་ཕྱག་མཛད་སྙམ་བཞེངས་རྡོར་དྲིལ་ལྕོག་རྩེ་ཁར་བཞག་པ་དགོངས་ཙ་ན་བར་སྣང་ལ་ཁྲོལ་ལེར་བཞག་འདུག།",
    "སྔ་གོང་ནས་ཀྱང་ཕྱག་ལེན་མི་མཛད་པར་ཞུ་ཕུལ་བར་གདའ།",
    "དེ་ཡིན་ཏེ་ངོ་མ་ཧེ་བཛྲ་དངོས་སུ་འདུག་པ་གསུངས་ཏེ།",
    "ད་ལན་ཅིས་ཀྱང་མི་འཛིན་པ་འདུག་ཞུས་པས།",
