    "ཉིན་ཞིག་མགར་ཚང་གི་སྒེའུ་ཁུང་ནས་ཨེས་ཊིལ་ལཱས་ལྟ་བཞིན་ཡོད་པ་ངའི་མིག་གིས་མཐོང་གི་རེད་སྙམ་པ་དེ་རེད།",
    "གང་ལྟར་ཉིན་གཅིག་ཁོ་མོས་ངའི་གདོང་དང་ལག་པ་ནག་པོ་ཡོད་པ་དེ་མཐོང་ནས།",
    "བཞད་གད་དང་སྦྲགས་དམའ་འབེབས་བྱེད་ཀྱི་རེད་སྙམ་པའི་ཞེད་སྣང་ཡོད།",
    "ངས་ཨེས་ཊིལ་ལཱའི་སྐོར་ལ་བསམ་བློ་མང་པོ་གཏོང་གི་ཡོད།",
    "མཚན་མོའི་རྨི་ལམ་དུའང་ཁོ་མོའི་བྱད་བཞིན་དེ་མེ་རླབས་ཀྱི་ནང་དུ་མངོན་དུ་གྱུར་ནས།",
    "ཁོང་གིས་ངའི་འཆར་གཞི་དེར་གལ་ཆེན་པོར་བརྩིས་མ་སོང་ཡང་།",
    "སྔོན་མའི་གནས་སྟངས་ལ་འགྱུར་བ་གང་ཡང་ཕྱིན་མི་འདུག་ཁོང་གིས་འོ་ད།",
    "གང་ཡང་ཐོབ་ཀྱི་ཡང་མ་རེད།",
    "ང་རང་གི་ལྕགས་བཟོའི་སློབ་སྦྱོང་དེ་ཡག་པོ་བྱེད་ཀྱི་ཡོད་པ་དང་།",
    "ཁོང་གིས་འོ་འགྲིགས་ག་ང་ཐུག་འཕྲད་ལ་ཡང་ཡང་ཤོག་ཅེས་དང་།",
    "ཁྱོད་རང་གི་སྐྱེས་སྐར་གྱི་ཉིན་མོ་དེར་ཤོག་ཁྱོད་རང་ཨེས་ཊིལ་ལཱ་འཚོལ་གྱི་ཡོད་དམ།",
    "ངའི་རེ་བ་ལ་ཁོ་མོ་བདེ་པོ་ཡོད་པའི་ཡིད་ཆེས་ཡོད།",
    "ཅེས་ཞུས་པས་ལྕམ་ཧབི་ཤཱམ་གྱིས་ད་ལྟའང་ཕྱི་རྒྱལ་ལ་སུས་ཀྱང་མི་སླེབས་པའི་ས་ལ་ཡོད་པ་རེད།",
    "ཁོ་མོ་སྔོན་མ་ལས་ཞེ་དྲགས་མཛེས་པ་དང་།",
    "ཀུན་གྱིས་བསྟོད་བསྔགས་བྱེད་ཀྱི་ཡོད་རེད།",
    "ཁྱོད་རང་གིས་ཁོ་མོ་ཤོར་སོང་བསམ་གྱི་འདུག་གམ།",
    "ང་ནི་ལན་ག་རེ་རྒྱག་དགོས་པའང་མ་ཤེས་པར་ལུས་སོང་བར།",
    "དེ་ནས་ཁོང་གིས་ང་ཕྱིར་སློག་བཏང་བར་བརྟེན་ལན་འདེབས་བྱ་རྒྱུ་ལས་ཐར་སོང་།",
    "སྐབས་དེར་ང་རང་གི་ཁྱིམ་དང་།",
    "ལས་ཀ་མི་ཚེའི་ནང་གི་བྱ་གཞག་ཚང་མར་ངོ་ཚ་ཁ་སྐྱེངས་ཀྱི་ཚོར་བ་དྲག་པོ་ཞིག་སྐྱེས་པ་དང་སྦྲགས།",
    "དེའི་མཚན་མོ་སྨག་རུམ་འཐིབས་པའི་ནང་དེར།",
    "མི་ཞིག་གིས་སྒོ་ཕྱེས་ཏེ་ལག་ཏུ་ཤེལ་དམ་ཞིག་འཁྱེར་ནས་རྒྱུགས་ཡོང་བ་དང་འབྲེལ།",
    "ཁྱེད་རང་གི་ནང་དུ་རྐྱེན་ངན་ཞིག་འཕྲད་འདུག་ཅེས་བརྗོད་བྱུང་།",
    "ག་རེ་བྱས་འདུག་ཅེས་དྲིས་པར་ཁོང་གིས་ངས་ཡག་པོ་ཞིག་ཤེས་མ་སོང་།",
    "ཉེས་ཅན་འགའ་ཤས་ཀྱིས་ཁྱེད་རང་གི་ཁང་པར་འཛུལ་བ་འདྲ།",
    "རྒོལ་འཛིང་བྱས་པར་བརྟེན་མི་ཞིག་ལ་རྨས་སྐྱོན་བྱུང་འདུག་ཁོང་ཚོས་ང་ཨ་རག་ལེན་པར་བཏང་བྱུང་།",
    "ང་གཉིས་ཀྱིས་ང་ཚོའི་ཐབ་ཚང་ནང་དུ་མ་སླེབས་བར་ཤར་རྒྱག་རྒྱུགས་ཕྱིན་པ་ཡིན།",
    "ཁོང་ཚོས་ང་མཐོང་བ་དང་རྒྱབ་བཤིག་བྱས་སོང་བས་གཞི་ནས་ངའི་གཅེན་མོ་ཡིན་པ་ཤེས་བྱུང་།",
    "གཅེན་མོའི་མགོའི་ལྟག་ལ་མི་ཞིག་གིས་ཤུགས་ཆེར་གཞུས་པས།",
    "ངའི་གཅེན་མོ་ནི་ཉལ་སར་ཚུད་དེ་ཡོད་པ་དང་།",
    "གཅེན་མོར་སྐད་ཆ་ཤོད་རྒྱུའི་ནུས་པ་ཉམས་པ་དང་།",
    "སྐུ་ཞབས་ཝུབས་ལེ་ཡི་གཅེན་པོ་འདས་གྲོངས་སུ་གྱུར་བའི་བུ་མོ་བྷི་ཌི་ང་ཚོའི་སར་སྡོད་པར་སླེབས་བྱུང་།",
    "ཁོ་མོ་ཨེས་ཊིལ་ལཱ་ནང་བཞིན་མཛེས་པོ་མེད་ཀྱང་།",
    "ད་ཆ་གཅེན་མོ་གཅིག་པུ་ནང་དུ་འཇོག་དགོས་པ་བྱུང་མ་སོང་།",
    "གཅེན་མོར་ཇཱོ་ཡིས་ལྟ་སྐྱོང་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "དབྱར་ཁའི་ཉིན་གཅིག་མོ་དང་ང་གཉིས་གཙང་འགྲམ་ཞིག་ཏུ་སྡོད་པའི་སྐབས།",
    "བྷི་ཌི་ལ་བློ་གཏད་དེ་སྦས་གསང་མེད་པའི་སྐད་ཆ་ཤོད་རྒྱུའི་གོ་སྐབས་བཟང་པོ་ཞིག་རེད་སྙམ་སྟེ་ངས་བྷི་ཌི།",
    "སྐད་ཆ་དེ་ཡ་རབས་པོ་མ་རེད་ལ།",
    "བདེན་པ་ཡང་མ་རེད།",
    "ངས་ལྕམ་ཧབི་ཤཱམ་གྱི་སར་ཡོད་པའི་བུད་མེད་མཛེས་མ་དེས་བརྗོད་བྱུང་།",
    "ཁོ་མོའི་ཆེད་དུ་རང་ཉིད་མི་དྲག་ཅིག་བྱེད་འདོད་འདུག་བརྗོད་པས།",
    "བྷི་ཌིས་གང་འཚམ་ཞིག་ནས་ཁྱེད་རང་མི་དྲག་བྱེད་དོན་དེ་ཁོ་མོར་གནག་གནག་གི་དོན་དུ་ཡིན་ནམ།",
    "ཡང་ན་ཁོ་མོ་རང་ཕྱོགས་སུ་འགུག་རྒྱུའི་དོན་དུ་ཡིན་ན་ནི་ངའི་བསམ་པ་ལ།",
    "ག་རེ་བྱེད་དགོས་མིན་ཁྱེད་རང་གིས་ཡག་ཤོས་ཤེས་ཀྱི་རེད།",
    "ཁོ་མོས་ཁྱེད་རང་ལ་ཕན་ཐོགས་ཀྱི་མ་རེད།",
    "འོན་ཀྱང་དེས་ཁྱད་པར་གང་ཡང་བཟོས་མ་སོང་།",
    "དེ་འདྲ་སོང་ཙང་ཁོ་མོ་ཐོབ་པའི་ཐབས་ལམ་ཡག་ཤོས་དེ་ང་རང་མི་དྲག་ཆགས་དགོས་པ་དེ་རེད་སྙམ་པ་བྱུང་།",
    "ངའི་ལས་ཞོར་སློབ་སྦྱོང་གི་ལོ་བཞི་པ་འགྲོ་བའི་སྐབས་དེར།",
    "གཟའ་སྤེན་པའི་མཚན་ཞིག་ལ་ང་ཚོ་ཚང་མ་ཐབ་ཚང་ནང་དུ་མེ་ལ་བསྐོར་ནས་ཡོད་པའི་དུས་སུ་སྒོ་བརྡུང་མཁན་ཞིག་བྱུང་།",
    "ཁོ་མོས་ཡང་ལཱ་ཞིག་སྦར་ཏེ་མཇལ་འཛོམས་ཁང་དུ་འཁྲིད་འདུག་སྐུ་ཞབས་དེ་མཐོང་མ་ཐག་ངས་ངོ་ཤེས་སོང་།",
    "དེར་སྐས་འཛེགས་སྟེང་དུ་འཕྲད་པ་དེ་རེད།",
    "ཁོ་རང་གིས་ང་ངོ་ཤེས་ཀྱི་མེད་ཀྱང་།",
    "ང་ཚོས་ཁོང་ནང་དུ་གདན་འདྲེན་ཞུས་ཏེ།",
    "ཁོང་གིས་ངའི་མིང་ཇཱག་གྷར་ཡིན།",
    "ང་ད་རེས་ཡོང་དོན་ནི་ཁྱེད་རང་གི་ལས་གཡོག་ཕོ་གསར་འདི།",
    "ཇཱོ་ཡིས་ཁོང་ལ་མིག་ཆེན་པོས་ཅེ་རེར་བལྟས་ནས་བསྡད་སོང་།",
    "ངའི་ཕྱོགས་ལ་དོ་སྣང་སྤྲད་དེ་ཁོང་གིས།",
    "སྐུ་ཞབས་ཇཱག་གྷར་གྱིས་ང་ལ་མཛུབ་མོ་བཙུགས་ཏེ།",
    "འགྲུབ་མི་སྲིད་པའི་སེམས་ཀྱིས་རི་མོ་བཀོད་པ་རྣམས་མངོན་སུམ་དུ་གྱུར་སོང་།",
