    "དེ་དག་ཐམས་ཅད་ནི་དུས་གསུམ་དུ་གཤེགས་པའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནས་མཁས་པ་ཐམས་ཅད་ཀྱིས་སྤངས་པའི་བར་དུའོ་ཞེས་གསུངས་སོ།",
    "དེ་ཉིད་ལས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "ངས་ཀྱང་དེ་དག་ལ་དེ་སྣང་ངོ་ཞེས་གསུངས་སོ།",
    "ཤེས་རབ་ཕུན་སུམ་ཚོགས་པ་ཡང་བསྐྱེད་པར་བགྱིའོ།",
    "ལོག་པར་ལྟ་བ་རྣམས་ལས་བཟློག་པར་བགྱིའོ་ཞེས་འབྱུང་ངོ།",
    "དེ་བཞིན་གཤེགས་པ་མི་མཉེས་པར་འགྱུར་བ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་མཉེས་པར་འགྱུར་བ་དང་།",
    "ལྷ་དང་ཀླུ་དང་གནོད་སྦྱིན་གྱིས་ཀྱང་དམ་པར་མི་བཀུར་ཞིང་འགྱོད་པ་དང་ལྡན་པ་ཡིན།",
    "སྒྲུབ་པ་ལ་མི་གནས་པ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "དམིགས་པར་སྤྱོད་པ་ལ་གྲུབ་པ་མེད་དེ།",
    "སྒྲུབ་པ་ཤེས་པར་འདོད་པས་མང་དུ་ཐོས་པ་དང་།",
    "ནང་དུ་ཡང་དག་འཇོག་ལ་བརྩོན་པར་བྱ་སྟེ།",
    "དེས་ང་ལ་བསྟི་སྟང་དུ་བྱས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་དེ་བཞིན་གཤེགས་པས་རྗེས་སུ་ཡི་རང་ཞིང་གནང་བ་ཡིན་ནོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སེམས་ཀྱི་རྩ་བ་མི་གཅོད་པ་དེ་ནི་རྩ་བ་དེ་ཡང་དག་པར་འཛིན་དུ་འཇུག་པ་སྟེ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སུ་བསྔོ་བའི་ཕྱིར་སྦྱིན་པས་ཆོག་མི་ཤེས་པ་དང་།",
    "ཐམས་ཅད་ལ་རྣམ་པར་སྤྱོད་པའི་ཕྱིར་ཤེས་རབ་ཀྱིས་ཆོག་མི་ཤེས་པའོ།",
    "འཚོ་བ་དེ་དག་ཐམས་ཅད་ནི་ཁ་ན་མ་ཐོ་བ་མེད་པའོ་ཞེས་གསུངས་སོ།",
    "ཁ་ཏོན་གྱི་བར་དུ་གཅོད་པར་བྱེད་པའོ།",
    "འདྲེ་ཞིང་གནས་པ་སྟེ་བཅུ་པོ་འདི་དག་གོ་ཞེས་གསུངས་སོ།",
    "རྙེད་པ་དང་བཀུར་སྟི་ནི་གཏི་མུག་བསྐྱེད་པས་དྲན་པ་འཇོམས་པར་བྱེད་པ་དང་།",
    "ལྷག་སྤྱོད་ཀྱི་སྤྱོད་པ་དང་མཚུངས་པར་གནས་པ་ཡིན་པར་སོ་སོར་བརྟག་པར་བྱའོ།",
    "དེ་དེར་ཟས་གཙང་མ་ཞིམ་པོ་ཅི་འདོད་པ་ཟོས་ནས་ཕྱི་དེ་ཉིན་ཀྱང་ཟས་ལ་འོས་པའི་ཟས་ཁྱེར་ཏེ་འོངས་ནས་དགེ་སློང་དག་ལ་སྨྲས་པ་ཚེ་དང་ལྡན་པ་དག་ཁོ་བོས་ཟས་གཙང་མ་ཞིམ་པོ་འདི་ཅི་འདོད་པ་ཟོས་ནས།",
    "ཟས་འདི་མི་དགོས་ཏེ་ལྷག་པར་གཏོར་བའི་རིགས་ན།",
    "ཁྱེད་འདོད་ན་འདི་ཟོ་ཤིག་ཅེས་དེ་དེས་དེ་ཙམ་གྱིས་དགེ་སློང་རུང་བ་ངེས་པ་གཞན་དག་ལ་བརྙས་པར་བྱེད་དོ།",
    "བཀུར་སྟི་དང་གྲགས་པ་ནི་མི་བཟད་པའོ་ཞེས་རྒྱ་ཆེར་གསུངས་སོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སེམས་བསྐྱེད་པ་དེའི་བར་དུ་གཅོད་པ་གཉིས་ཏེ།",
    "གཡོ་མེད་པའོ་ཞེས་གསུངས་སོ།",
    "གཞན་ཅི་ཡང་རུང་བ་ཞིག་ལ་བརྟེན་པ་དེ་དག་ནི་བདེ་བར་འགྲམ་དུ་ཕྱིན་པར་འགྱུར་རོ།",
    "ཡང་ཐམས་ཅད་མཁྱེན་པའི་སེམས་རབ་ཏུ་ཐོབ་སྟེ།",
    "རྣམ་པར་སྨིན་པའང་མི་ཟད་པར་འགྲུབ་པོ།",
    "རྣམ་པར་སྨིན་པ་མཉམ་པར་ཤེས་པར་བྱ་སྟེ།",
    "བྱེ་བྲག་གམ་ཐ་དད་དུ་བྱ་བ་མེད་དོ་ཞེས་ཇི་སྐད་གསུངས་པ་ལྟ་བུའོ།",
    "ངའི་ཕྱིར་མཆོད་རྟེན་བྱས་པ་རྣམས་ལ་བསྟི་སྟང་བྱེད་པ་ལྟ་ཡང་ཞོག་སྟེ།",
    "འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་སྲིད་རྣམས་ཀྱི་མཐའ་རྙེད་པར་མི་ནུས་སོ།",
    "དེ་དོན་མེད་པར་མི་འགྱུར་རོ།",
    "བཅུག་མ་ཐག་ཏུ་ཉས་མིད་པར་འགྱུར་ན།",
    "སྲད་བུ་ཐངས་ཤེས་བྱེད་པ་ལས་ཉ་ཟིན་པར་ཤེས་ཏེ།",
    "མྱ་ངན་ལས་འདས་པའི་ཐང་ལ་འཇོག་གོ་ཞེས་གསུངས་སོ།",
    "རྒྱུན་མི་འཆད་པར་དེ་བཞིན་གཤེགས་པའི་བསྔགས་པ་བརྗོད་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་བྱེད་པ་དང་།",
    "རྩིག་ངོས་ལ་དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་བྲི་བར་བྱ།",
    "འདྲུམ་པ་བཅོས་པར་བྱ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་བྱས་ན།",
    "ལོག་པར་ལྟ་བའི་རིགས་རྣམས་སུ་མི་སྐྱེ་སྟེ།",
    "ཡན་ལག་གང་ཡང་རུང་བ་མ་ཚང་བ་མེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་མཚམས་མེད་པ་ལྔ་བྱས་སུ་ཟིན་ཀྱང་།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུའི་གཟུགས་བྱས་ནས།",
    "སྤོས་ཀྱིས་བྱུགས་ན་དེའི་དྲི་མི་ཞིམ་པ་མེད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་མཚམས་མེད་པ་བྱས་པ་དེའི་སྡིག་ཀྱང་མེད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་དད་པ་རྙེད་དེ་དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་བྱས་ན།",
    "སོ་སོ་ནས་དེ་བཞིན་གཤེགས་པའི་མཆོད་རྟེན་འཕང་དུ་རིའི་རྒྱལ་པོ་རི་རབ་ཙམ་བྱས་ཏེ།",
    "ཐམས་ཅད་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་སྲིད་དང་ལྡན་པར་གྱུར་ལ།",
    "རྒྱ་མཚོ་ཆེན་པོ་ཙམ་གྱི་མར་མེའི་སྣོད་བྱས་ཏེ།",
    "བདེ་བའི་ཡོ་བྱད་ཐམས་ཅད་ཀྱིས་བསྟི་སྟང་དུ་བྱས་པ་བས།",
    "སྦྱིན་པ་སྔ་མས་སྦྱིན་པ་འདིའི་བརྒྱའི་ཆར་ཡང་མི་ཆོག་པ་ནས་རྒྱུའི་བར་དུ་ཡང་མི་ཆོག་གོ་ཞེས་གསུངས་སོ།",
    "བཟང་པོ་ཕན་ཡོན་བཞི་པོ་འདི་ཡང་དག་པར་རྗེས་སུ་མཐོང་ན།",
    "བཞི་པོ་འདི་དག་གོ་ཞེས་གསུངས་སོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་ཡོངས་སུ་བསྒོས་པའོ་ཞེས་གསུངས་སོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "མ་བྱོན་པ་རྣམས་ཀྱང་སྐད་ཅིག་གཅིག་ལ་མངོན་དུ་བྱས་ཤིང་།",
    "དེས་ནི་གཉིས་ཀྱི་འདུ་ཤེས་ཀྱང་བསྐྱེད་པར་མི་བྱ།",
