    "གནས་ལུང་སྟོན་པར་འདུག་དགོངས་ནས།",
    "འདིར་དེ་ཉིད་གཙོ་བོར་བསྟན་འདུག་པའི་ཕྱིར་རོ།",
    "རང་རང་བཞེད་དང་མཐུན་པའི་སྤྱིལ་པོ་དང་།",
    "ཐོན་པར་འདུག་ནའང་ནས་ལ་གད་བྱེད་ཅིང་།",
    "ཟླ་གམ་དྲུག་ཅུ་རྣམས་ཀྱི་རང་རང་ལ།",
    "དུས་བཟང་བྱུང་ངོ་ཅོག་ལ་རང་རང་བློ་དང་འཚམ་པ་གང་འགྲུབ་ཀྱིས།",
    "ནམ་ཡང་འཚེ་བར་མི་བྱ་བདེ་བར་བཞག་དུས་ཆེན་བཞི་དང་དུས་བཟང་གསུམ་རྣམས་ལ།",
    "རབ་གནས་སྐྱར་ནན་གྱི་ཚུལ་དུའང་མཛད་པར་གདའ།",
    "ད་ལྟ་ལོངས་སྤྱོད་པ་རྣམས་ལས་ཁྱད་ཀྱི་ལྷག་པ་འདུག་ཅིང་།",
    "དོན་སེམས་པའི་སྒོ་ནས་བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བའི་ཉེས་པ་ཕྲ་ཞིང་ཕྲ་བ་རྣམས་ཀྱིས་ཀྱང་མ་གོས་པའི་འཕགས་པ་ཉེ་བ་འཁོར་གཉིས་པ་ལྟ་བུར་གྱུར་ཏེ།",
    "མེ་ཕོ་འབྲུག་ལ་དུས་མཉམ་དུ་བསྒྲུབས་ནས་ཕུལ་བར་འདུགགཞན་ཡང་བྱང་སེམས་ཀུན་དགའ་འདྲེན་པའི་དོན་དུ།",
