    "ཆུ་རགས་གཏོར་བའི་བྱས་ཉེས།",
    "དཀར་ཆགགས་གཏོར་གཏོང་བའི་བྱས་ཉེས།",
    "འགྲིམ་འགྲུལ་ཡོ་བྱད་ལ་གཏོར་བརླག་གཏོང་བའི་བྱས་ཉེས་དང་སྐྱེལ་འདྲེན་སྒྲིག་ཆས་ལ་གཏོར་བརླག་གཏོང་བའི་བྱས་ཉེས་ཟེར་བ་ག་འདྲ་ཡིན།",
    "ཉར་ཚགས་བཅས་བྱེད་པའི་བྱས་ཉེས་ཟེར།",
    "རྫས་མདེལ་བདག་བཟུང་དང་སྒེར་ཉར་བྱེད་པའི་བྱས་ཉེས་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་འགན་འཛོལ་ཆེན་པོས་བྱུར་ཉེས་ཚབས་ཆེན་བཟོས་པའི་བྱས་ཉེས་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་ངལ་རྩོལ་བདེ་དོན་ཐད་ལ་བྱུར་རྐྱེན་ཚབས་ཆེན་བཟོས་པའི་བྱས་ཉེས་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་ཐོན་རྫས་སྤུས་ཞན་ཐོན་སྐྱེད་དང་ཕྱིར་འཚོང་བྱེད་པའི་བྱས་ཉེས་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་དུག་དང་གནོད་ཆ་ལྡན་པའི་བཟའ་བཅའ་ཐོན་སྐྱེད་དང་ཕྱིར་འཚོང་བའི་བྱས་ཉེས་ཟེར།",
    "ས་བོན་རྫུན་མ་ཐོན་སྐྱེད་དང་ཕྱིར་འཚོང་བྱེད་པའི་བྱས་ཉེས་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་གཞུང་དོན་སྒྲུབ་པར་བཀག་འགོག་བཟོས་པའི་བྱས་ཉེས་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་གཡོ་སྒྱུས་མགོ་སྐོར་གཏོང་བའི་བྱས་ཉེས་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་བྱས་ཉེས་གསོག་སྟངས་བསླབས་པའི་བྱས་ཉེས་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་སྦས་སྐུང་དང་འགེབས་སྲུང་བྱེད་པའི་བྱས་ཉེས་ཟེར།",
    "ཉོ་སྒྲུབ་བམ་ཚབ་འཚོང་བྱེད་པའི་བྱས་ཉེས་ཟེར།",
    "བཟོ་སྐྲུན་བཅས་བྱེད་པའི་བྱས་ཉེས་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་ལྐོག་རྔན་སྤྲོད་པའི་བྱས་ཉེས་ཟེར།",
    "བྱ་སྤྱོད་ག་འདྲ་ཞིག་ལ་བྱས་ཉེས་ཟེར།",
    "ཉེས་གསོག་དམིགས་ཡུལ་ནི་བྱས་ཉེས་ཁ་ཤས་ལ་མེད་མི་རུང་བའི་རྒྱུ་རྐྱེན་ཏེ།",
    "ག་འདྲ་ཞིག་ལ་ཤེས་བཞིན་དུ་བྱས་ཉེས་བསགས་པ་ཟེར།",
    "ཤེས་བཞིན་དུ་བྱས་ཉེས་གསོག་མཁན་གྱིས་ཉེས་འགན་འཁུར་དགོས་ཞེས་གཏན་ལ་ཕབ་ཡོད་དེ།",
    "དུང་མཚམས་མ་བཞག་པར་བསྟུད་མར་བསྣུན་འགོ་རྩོམ་དུས།",
    "ཀ་བས་ཤེད་ཤུགས་ཀྱིས་ག་བར་ཕུར་རྒྱག་བྱས་རྗེས་ཡང་བསྐྱར་ཁ་བར་གྱིས་ཐེངས་གཉིས་བསྣུན་པ་ལྟ་བུར་མཚོན་ན།",
    "ག་འདྲ་ཞིག་ལ་ལས་འཛོལ་གྱི་བྱས་ཉེས་བསགས་པ་ཟེར།",
    "འགོག་སྲུང་ཚད་ལས་བརྒལ་བ་ཟེར་བ་ནི་ཚུལ་མཐུན་འགོག་སྲུང་བྱས་ཚུལ་མངོན་གསལ་དུ་བྱ་འོས་ཀྱི་ཚད་ལས་བརྒལ་ཏེ།",
    "ཚུལ་མཐུན་འགོག་སྲུང་བྱས་ཚུལ་མངོན་གསལ་དུ་བྱ་འོས་ཀྱི་ཚད་ལས་བརྒལ་ཏེ་གནོད་སྐྱོན་ཚབས་ཆེན་བཟོས་པའི་ཚེ།",
    "མགོ་རྔ་མེད་པར་རྡུང་རྡེག་དྲག་པོ་བཏང་རྗེས།",
    "ག་འདྲ་ཞིག་ལ་ཉེན་སེལ་ཛ་དྲག་ཆེན་པོ་བྱས་ཚུལ་བྱ་འོས་ཀྱི་ཚད་ལས་བརྒལ་བ་ཟེར།",
    "ཉེན་སེལ་ཛ་དྲག་ཆེན་པོ་བྱས་ཚུལ་བྱ་འོས་ཀྱི་ཚད་ལས་བརྒལ་བ་ཟེར་བ་དེ་ཇི་ལྟར་ངོས་འཛིན་དགོས་ཞེ་ན།",
    "བྱ་སྤྱོད་དེ་རིགས་བྱ་འོས་ཀྱི་ཚད་ལས་བརྒལ་པར་གོ་བ་ལེན་འོས་ཏེ།",
    "འགྲིམ་འགྲུལ་ཡོ་བྱད་དང་འགྲིམ་འགྲུལ་སྒྲིག་ཆས་ལ་གཏོར་བཤིག་བཏང་བའི་བྱས་ཉེས་ལྟ་བུར་མཚོན་ན།",
    "བྲོས་བྱོལ་དུ་ཕྱིན་པའི་བྱས་ཉེས་ལྟ་བུར་མཚོན་ན།",
    "མི་རིགས་འཁོན་འཛིན་དང་མི་རིགས་མཐོང་ཆུང་བྱེད་པར་ངན་སྐུལ་བྱེད་པའི་བྱས་ཉེས་དང་འཇིགས་སྐུལ་བྱེད་སྒོའི་རྩ་འཛུགས་ལ་ཞུགས་པའི་བྱས་ཉེས་ལྟ་བུ་སོགས་སོ།",
    "བྱས་ཉེས་གསོག་མཚམས་བཞག་པའི་ཉེས་ཅན་གྱིས་ཉེས་འགན་འཁུར་དགོས་སམ།",
    "ག་འདྲ་ཞིག་ལ་བྱས་ཉེས་མཉམ་བསགས་ཟེར།",
    "གྱོད་གཞི་འདིའི་ཁྲོད་ཀྱི་ཀ་བས་རང་ལོ་བཅོ་བརྒྱད་ལ་མ་ལོན་པའི་སྐྱེ་བོར་ངན་སྐུལ་བྱས་པས།",
    "གཙོ་བོ་རྒྱུ་ནོར་ལ་འདོད་རྔམ་ཆེབ་དང་རྒྱུ་ནོར་ལ་འབྲེལ་བ་ཡོད་པའི་བྱས་ཉེས་ལ་སྤྱད་འཐུས་པ་དང་མཉམ་དུ།",
    "ཅི་ཞིག་ལ་བྱས་ཉེས་རིམ་པར་གསོག་པ་ཟེར།",
    "རང་ཉེས་རང་ཞུ་བྱས་ཚེ་ཇི་ལྟར་ཐག་གཅོད་དགོས་སམ།",
    "དོགས་ཡོད་ཉེས་ཅན་དེའི་གྲོགས་པོའམ་གཉེན་ཉེས་ཁ་ཏ་བྱས་པ་ཡང་ན་དེ་དག་འགྲོ་རོགས་བྱས་ཏེ་བྱས་ཉེས་ཞུས་པ་དང་།",
    "ཡང་བསྐྱར་ངོས་ལེན་བྱས་པ་ཡོངས་ཁས་མ་བླངས་ཚེ།",
    "ཅི་ཞིག་ལ་བྱས་རྗེས་བཞག་པ་ཟེར།",
    "བྱས་རྗེས་བཞག་པའི་གནས་ཚུལ་ཡོད་ཚེ་ཇི་ལྟར་ཐག་གཅོད་དགོས་སམ།",
    "བྱས་རྗེས་ནི་ཉེས་ཅན་གྱིས་མི་གཞན་པའི་ཉེས་སྤྱོད་ཐེར་འདོན་བྱས་པ་འཛོལ་མེད་ར་སྤྲོད་བྱུང་བའམ་ཡང་ན་ཁུངས་སྣེ་གལ་ཆེན་འདོན་སྤྲོད་བྱས་མཐར།",
    "ཉེས་ཅན་གྱིས་མི་གཞན་གྱི་ཉེས་བསགས་སྤྱོད་ངན་ཐེར་འདོ་ན་བྱས་ཡོད་པ་དེ་ཞིབ་བཤེར་གྱིས་འཛོལ་མེད་ར་སྤྲོད་བྱུང་བའམ་ཡང་ན་ཁུངས་སྣེ་གལ་ཆེན་འདོན་སྤྲོད་བྱས་ཡོད་པ་དེ་ལ་བརྟེན་ནས་གྱོད་དོན་གཞན་དག་མྱུལ་ཞིབ་བྱས་ཏེ་རྩད་ཆོད་བྱུང་བ་སོགས་ཀྱི་བྱས་རྗེས་བཞག་པའི་བྱ་སྤྱོད་ཡོད་ན།",
    "མི་གཞན་པའི་ཉེས་སྤྱོད་ཐེར་འདོན་དང་མཚང་འབྱིན་བྱས་པར།",
    "མི་གཞན་པའི་ཉེས་སྤྱོད་ཚབས་ཆེན་ཐེར་འདོན་ནམ་མཚང་འབྱིན་བྱས་པ་དང་།",
    "གྱོད་དོན་ཚབས་ཆེན་གཞན་རྩད་ཆོད་བྱུང་བར་འདོན་སྤྲོད་བྱས་པའི་ཁུངས་སྣེ་གལ་ཆེན་འཛོལ་མེད་ར་སྤྲོད་བྱུང་བ།",
    "ཚན་པ་སྔོན་མར་བཀོད་པའི་བྱས་ཉེས་ཚབས་ཆེན་དང་གྱོད་གཞི་གལ་ཆེན།",
    "ད་དུང་བྱས་རྗེས་བཞག་པའི་གནས་ཚུལ་ཡོད་ཚེ།",
    "བྱས་ཉེས་བསགས་རྗེས།",
    "རང་ཉེས་རང་ཞུ་བྱས་པ་མ་ཟད།",
    "ཉེས་ཚབས་ཅུང་ཆུང་བའི་བྱས་ཉེས་བསགས་དུས།",
    "རང་ཉེས་རང་ཞུ་བྱས་པ་མ་ཟད།",
    "ད་དུང་བྱས་རྗེས་བཞག་པའི་གནས་ཚུལ་ཡོད་ཚེ།",
    "ག་འདྲ་ཞིག་ལ་བྱས་ཉེས་དུ་མ་བསགས་པ་ཟེར།",
    "དོན་དངོས་སྟེང་བྱས་ཉེས་དུ་མ་བསགས་ཡོད་དེ།",
    "ཚོད་བགམ་གློད་འགྲོལ་བྱེད་པར་ཆ་རྐྱེན་གང་དག་འཛོམ་དགོས་སམ།",
    "རྨས་སྐྱོན་གཏོང་བའི་བྱས་ཉེས་གསོག་མཁན་ཡངཡང་ཇེ་མང་དུ་འགྲོ་བཞིན་ཡོད།",
    "བྱས་ཉེས་གསོག་ཐབས་སྣ་རྐྱང་ཅན་དུ་འགྱུར་བཞིན་ཡོད་དེ།",
    "དྲག་ཤུགས་རང་བཞིན་ཅན་གྱི་བྱས་ཉེས་ཟེར་བ་དེ་མི་གཞན་པའི་ལུས་ཁམས་དང་བདེ་ཐང་ལ་གནོད་པ་བཟོ་བའི་དྲག་ཤུགས་ཀྱི་བྱ་སྤྱོད་སྤེལ་བའི་བྱས་ཉེས་ལ་ངོས་འཛིན་དགོས།",
    "མངོན་གསལ་དུ་མཇུག་འབྲས་ལ་འདང་མི་རྒྱག་པར་སྤྱི་དམངས་ཀྱི་མི་ལུས་དང་རྒྱུ་ནོར་ལ་གནོད་སྐྱོན་ཆེན་པོ་བཟོ།",
    "བྱས་ཉེས་གསོག་ཐབས་སྣ་རྐྱང་ཅན་ཏེ།"
