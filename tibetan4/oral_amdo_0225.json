    "ཕྱོགས་མཚམས་བརྒྱད་དུ་ཉི་མའི་དཀྱིལ་འཁོར་རེ་རེར་གྱུར་པ་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས།",
    "གཉིས་པ་གང་ཟག་རྟོགས་པ་དང་བློ་གྲོས་འབྲིང་གིས་བསྒོམ་༜ པར་བྱ་བ་ལ་གཉིས་ཏེ་ཡན་ལག་བཞི་པའི་ཕྱོགས་དང་།",
    "ཧཱུཾ་ལས་ཐོད་པ་དཀར་པོ་དུམ་བུ་གསུམ་པ་དཔྲལ་བར་སྣ་ཚོགས་རྡོ་རྗེའི་ལྟེ་བ་ལ་ཧཱུྃ་གིས་མཚན་པ།",
    "དེའི་གཡོན་དུ་ཨཾ་ལས་གྲི་གུག་སྔོ་ནག་ཡུ་བ་ལ་ཨཾ་གིས་མཚན་པ་སོ་སོར་ཀུན་ཏུ་རྟོག་པའི་ཡེ་ཤེས།",
    "དེ་གཉིས་ཀྱི་བར་དུ་ཧཱུཾ་ལས་ཐོད་པ་དཀར་པོ་དུམ་བུ་གསུམ་པ་དཔྲལ་བར་སྣ་ཚོགས་རྡོ་རྗེའི་ལྟེ་བ་ལ་ཧཱུྃ་གིས་མཚན་པ།",
    "དེའི་གཡོན་དུ་ཨཾ་ལས་གྲི་གུག་སྔོ་ནག་ཡུ་བ་ལ་ཨཾ་གིས་མཚན་པ་སོ་སོར་ཀུན་ཏུ་རྟོག་པའི་ཡེ་ཤེས།",
    "དབུས་ཀྱི་གདན་གྱི་སྟེང་དུ་བདག་ཉིད་སྐད་ཅིག་གིས་རྒྱུའི་རྡོ་རྗེ་འཛིན་པ་ནག་པོ་གསལ་གདབ་སྟེ་ཕྱི་མ་གཉིས་པོ་འདི་ཡན་ལག་བཞིས་འཆིང་ངོ།",
    "ཞལ་རེ་རེ་ལ་སྤྱན་གསུམ་གསུམ་དང་ལྡན་པ།",
    "ཕྱག་བཅུ་དྲུག་གིས་ཐོད་པ་བཅུ་དྲུག་བཟུང་བའི་གཡས་ཀྱི་དང་པོ་ན་གླང་པོ་ཆེ་དཀར་པོ།",
    "ལྔ་པ་ན་རྔ་མོ་ཐལ་ཁ།",
    "དབུ་རེ་རེ་ལ་མི་མགོ་སྐམ་པོ་ལྔ་ལྔས་དབུ་བརྒྱན་ཅིང་།",
    "ཞབས་གཡས་གཉིས་བརྐྱངས་པའི་བརླ་ལ་གཡོན་གཉིས་བསྐུམས་པའི་སོར་མོ་རྣམས་གཏད་པའི་གར་སྟབས་ཀྱིས་བཞུགས་པ་སྒེག་ཅིང་དཔའ་བ་མི་སྡུག་པ།",
    "གཉིས་པ་འཁོར་གྱི་ལྷ་མོ་དབྱུང་ཚུལ་ནི།",
    "ཡབ་ཀྱི་གསང་བའི་། གནས་མི་དམིགས་ཏེ་སྟོང་པའི་ངང་ལས་ཧཱུཾ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པ་ལྟེ་བ་ལ་ཧཱུྃ་གིས་མཚན་པ།",
    "དེ་ནས་མངོན་བྱང་གི་ཡན་ལག་བཞི་པ་གསུམ་ལ་ཐིག་ལེ་སྤྲོ་བ་དང་ས་བོན་སྤྲོ་བཅོ་ལྔ་གཉིས་གཉིས་ལས་དང་པོ་ནི་དེ་རྣམས་ཡུམ་གྱི་བྷ་ག་ནས་ཕྱིར་འཐོན་ཏེ་ཕྱོགས་མཚམས་ཀྱི་ཉི་ཟླ་ཁ་སྦྱོར་གྱི་བར་དུ་སྤྲོས་པ་ལས།",
    "གཾ་ལས་གྲི་གུག་སྔོ་ནག་གི་ཡུ་བ་ལ་གཾ་གིས་མཚན་པ།",
    "བྱང་གི་ཉི་ཟླ་ཁ་སྦྱོར་གྱི་བར་དུ་གྷཾ་ལས་སྦྲུལ་ལྗང་གུའི་དཔྲལ་བར་གྷཾ་གིས་མཚན་པ།",
    "ཤར་ལྷོའི་ཉི་ཟླ་ཁ་སྦྱོར་གྱི་བར་དུ་ཤཾ་ལས་དགེ་སློང་དཀར་བོའི་ཐུགས་ཀར་ཤྀ་གིས་མཚན་པ།",
    "ནུབ་བྱང་གི་ཉི་ཟླ་ཁ་སྦྱོར་གྱི་བར་དུ་ཌཾ་ལས་རྡོ་རྗེ་ཁྲ་བོའི་ལྟེ་བར་ཌི་གྱིས་མཚན་པ་སོ་སོར་ཀུན་ཏུ་རྟོག་པའི་ཡེ་ཤེས།",
    "ཤར་གྱི་ཉི་ཟླ་ཁ་སྦྱོར་གྱི་བར་དུ་གཾ་ལས་གྲི་གུག་སྔོ་ནག་གི་ཡུ་བ་ལ་གཾ་གིས་མཚན་པ་ཞེས་སོགས་སྔར་དང་འདྲའོ།",
    "ཡན་ལག་དྲུག་པའི་ཕྱོགས་གསུམ་ལ་ས་བོན་སྤྲོ་བ་དང་ལྷ་མོ་སྤྲོ་བ་གཉིས་གཉིས་ལས།",
    "དེ་རྣམས་ཡུམ་གྱི་མཁའ་ནས་ཕྱིར་འཐོན་ཏེ་སོ་སོའི་གདན་གྱི་སྟེང་དུ་འཁོད་པ་ལས་ཤར་དུ་གཾ་ལས་གོ་རཱི་ནག་མོ་ཞེས་པ་ནས།",
    "ནུབ་བྱང་དུ་ཌཾ་ལས་གཡུང་མོ་ཁ་དོག་སྣ་ཚོགས་པ་ཞེས་པའི་བར་གསལ་གདབ།",
    "དེ་རྣམས་ལྷ་མོ།",
    "ཤར་དུ་གོ་རཱི་ནག་མོ་ཞེས་སོགས་གསལ་གདབ།",
    "ས་བོན་ལས་བསྐྱེད་པ་ལ་ནི་འཁོར་གྱི་མལྷ་མོ་སྤྲོ་ཚུལ་སྔར་གྱི་ཡན་ལག་དྲུག་པའི་ལྷ་མོ་སྤྲོ་བའི་སྐབས་དང་ཁྱད་པར་མེད་དོ།",
    "སྐད་ཅིག་གིས་བསྐྱེད་པ་ལ་ནི་ཐིག་ལེ་བརྒྱད་དུ་གྱུར་ཞེས་པའི་རྗེས་སུ།",
    "དེ་རྣམས་ལྷ་མོ་བརྒྱད་དུ་གྱུར་ནས་གདན་སོ་སོའི་སྟེང་དུརིམ་པ་བཞིན་དུ་འཁོད་པ་ནི་ཤར་དུ་གོ་རཱི་ནག་མོ་ཞེས་སོགས་གསལ་གདབ།",
    "ས་བོན་ལས་བསྐྱེད་པ་དང་སྐད་ཅིག་ལས་བསྐྱེད་པ་གཉིས་ལ་འཁོར་སྤྲོ་ཚུལ་རེ་རེར་ངེས་པས་བཅུ་བཞིའོ།",
    "ཐུན་མོང་དུ་ལྷ་མོ་གསལ་གདབ་པ་ནི་ཤར་དུ་གོ་རཱི་ནག་མོ་གཡས་གྲི་གུག།",
    "ནུབ་ཏུ་བེེ་ཏཱ་ལཱི་སེར་མོ་གཡས་རུས་སྦལ།",
    "བྱང་ཤར་དུ་པུཀྐ་སཱི་སྔོན་མོ་གཡས་སེང་གེ།",
    "ཤར་ལྷོར་རི་ཁྲོད་མ་དཀར་མོ་གཡས་དགེ་སློང་།",
    "ལྷོ་ནུབ་ཏུ་གདོལ་པ་མོ་སྔོན་མོ་གཡས་འཁོར་ལོ།",
    "ནུབ་བྱང་དུ་གཡུང་མོ་ཁ་དོག་སྣ་ཚོགས་པ་གཡས་རྡོ་རྗེ།",
    "ཡན་ལག་དྲུག་པ་རྣམས་ལ་སླར་ཡང་ཡབ་ཡུམ་སྙོམས་པར་ཞུགས་པས་བར་སྣང་གི་ༀཨཱ་ཧཱུྃ་ཧོ་དམར་པོ་གཉིས་ཀྱིས་མཐའ་བརྟེན་པའི་བར་དེའི་རྣམ་པར་ཤེས་པ་བཀུག།",
    "ཐོག་མར་གླུས་བསྐུལ་བ་ནི་རང་གི་ཤེས་པ་མཚམས་ཀྱི་ལྷ་མོ་བཞིར་འཕོས་ལ་གླུས་བསྐུལ་བར་བསམས་ཏེ།",
    "ཁྱོད་མེད་ན་ནི་བདག་འགུམས་པས།",
    "ཀྱེ་ཡི་རྡོ་རྗེ་ཁྱོད་བཞེངས་ཤིག།",
    "ཁྱོད་མེད་ཕྱོགས་ནི་མི་འཚལ་བས།",
    "གདོལ་པ་མོ་བདག་ཞུ་བ་བགྱིད།",
    "བདག་གིས་ཁྱོད་ཀྱི་ཐུགས་འཚལ་གྱིས།",
    "མིག་འཕྲུལ་མངའ་བ་ཁྱོད་བཞེངས་ཤིག།",
    "གཡུང་མོ་བདག་ཉིན་དྲན་ཉམས་པས།",
    "དེ་ནས་ཨཱ་ལི་ཀཱ་ལི་ལ་ལྟོས་པའི་༜ མངོན་བྱང་གི་ཡན་ལག་བཞི་པ་རྣམས་ལ་ཞེས་བསྐུལ་བས།",
    "སྟེང་གི་ཐིག་ལེ་དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུའི་ངོ་བོ་མར་མེའི་རྣམ་པ་ལྟ་བུ་ཀ་ཁ་སོགས་ཕྲག་གཉིས་བརྗོད།",
    "བར་གྱི་ཐིག་ལེ་ཧཱུཾ་ལས་ཐོད་པ་དཀར་པོ་དུམ་བུ་གསུམ་པ་དཔྲལ་བར་སྣ་ཚོགས་རྡོ་རྗེའི་ལྟེ་བ་ལ་ཧཱུྃ་གིས་མཚན་པ།",
