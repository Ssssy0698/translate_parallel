    "འབྲིང་དང་རབ་གསུམ་གསུམ་དུ་ཕྱེ་ནས་རང་རང་གི་ཅི་ལྟར་འདོད་པའི་ལམ་གྱིས་སོ་སོར་བཀྲི་བའོ།",
    "ཕྱི་ནང་གི་མཛད་པ་བཅུ་གཉིས་རྣམས་ཏེ།",
    "འདི་དག་གིས་སྔར་གྱི་ཉམས་མྱོང་དེ་དག་ལ་རྟོགས་པ་ཁྱད་པར་ཅན་བསྐྱེད་པའི་སྒོ་ནས་བོགས་དབྱུང་བའོ།",
    "འདི་དག་ནི་སྔར་གྱི་ཉམས་མྱོང་དེ་དག་གི་གེགས་ནམ་བྱུང་བའི་ཚེ་སེལ་ཚུལ་ཤེས་དགོས་པ་ཡིན་ལ།",
    "གཏུམ་མོའི་རྣལ་འབྱོར་གྱི་སྐབས་སུ་གཙོ་བོར་དགོས་པའོ།",
    "ཚོགས་ཀྱི་འཁོར་ལོའི་ཆོ་ག་གསུམ་ནི་དམ་ཚིག་གི་སྐབས་སུ་སྦྱར་བར་བྱ་བ་ཡིན་ནོ།",
    "དམ་ཚིག་གི་རྗེས་དེ་ནས་ལྟ་བ་ལ་བློ་སྦྱངས་ནས།",
    "དམ་ཚིག་གི་རྗེས་སུ་ཕྱི་བསྐྱེད་པའི་རིམ་པ་ཡན་ལག་དང་བཅས་པ་བསྟན་ནས།",
    "དང་པོ་ནི་ཁྲིད་ཀྱི་གཞུང་ཤིང་གི་དགོངས་པ་སྟེ།",
    "། བཟླས་བརྗོད་སྦྱིན་སྲེག་དག་གིས་རྒྱུད་སྦྱངས་ལ།",
    "ལམ་བསྡུས་པ་ནི་རང་གི་གཞུང་ཅུང་ཟད་དང་བཅས་པ་སྒྲུབ་པའི་ལུང་སྦྱིན་པ་སྟེ་ཡི་གེ་ཅིག་ཡོད་དོ་། དེ་ལྟར་ལམ་རྒྱས་འབྲིང་གསུམ་བསྟན་ནས།",
    "སྔར་གསེབ་ཚགས་སུ་བསྟན་པའི་དམ་ཚིག་གི་ཚོགས་ཉི་ཤུ་བསྐྱངས་པས་སྐྱེ་བ་བཅུ་དྲུག་ཕྱིན་ཆད་ནས་སངས་རྒྱ་བ་སྟེ།",
    "རྡོ་རྗེའི་ཚིག་རྐང་གི་འགྲེལ་པ་རྗེ་ས་སྐྱ་པ་ཆེན་པོས་ཞུ་བ་པོ་སོ་སོའི་ངོར་བཅུ་གཅིག་ཙམ་མཛད་པ་ལས།",
    "དང་དེ་དག་གི་སྐབས་སུ་ཞལ་ལས་ཤེས་པར་བྱའོ་ཞེས་པ་དགུ་ལས་མེད་ཀྱང་།",
    "བཞི་ཆར་ལ་ཕན་འདོགས་པ་མན་ངག་ཕྲ་མོའི་རྐང་གྲངས་གཞན་དུ་ཁ་འཕངས་པ་དང་དྲུག་ཅུའོ།",
    "རྗེ་བཙུན་གྱིས་མན་ངག་ཕྲ་མོའི་རྐང་གྲངས་གཞན་ཡང་བརྗོད་པར་ག་ལ་ནུས་པས་འདིར་བྲི་བར་མི་བྱའོ་ཞེས་གསུངས་པའི་དོན།",
    "དངོས་གཞི་ལ་གཏུམ་མོ་འཁོར་ལོ་བཞིའི་དམིགས་པ་རྒྱས་པ།",
    "གཏུམ་མོའི་དམིགས་པ་ཉི་ཤུ་རྩ་དགུ།",
    "ཡི་གེ་གཉིས་འདུག་པ་འདིར་བཞུགས་ན་ལེགས་སམ་སྙམ་མོ།",
    "གྲུབ་ཆེན་བཅུ་དང་ཕྲ་མོ་བརྒྱད་རྩ་འགྲེལ།",
    "དེ་དག་གི་གསལ་བྱེད།",
    "བིར་སྲུང་གི་མན་ངག་རྙིང་པ་གསུམ།",
    "བིར་སྲུང་གི་མན་ངག་བར་ཆད་ཀུན་སེལ།",
    "ཐུན་མོང་མ་ཡིན་པའི་བིར་སྲུང་ཉམས་སུ་ལེན་ཚུལ།",
    "ཞར་ལ་རྣལ་འབྱོར་པ་རིན་ཆེན་རྡོ་རྗེས་མཛད་པའི་བིརླ་པའི་སྐུའི་རྣམ་འགྱུར་དྲུག་གི་ཟིན་བྲིས་རྣམས་སོ།",
    "ཐུན་མོང་གི་ལམ་གྱིས་སྦྱང་བར་བྱས་ན།",
    "ཕྱི་བསྐྱེད་པའི་རིམ་པ་སྔོན་དུ་སོང་ནས།",
    "དང་པོ་ལ་ངན་སོང་གསུམ་གྱི་སྡུག་བསྔལ་གསུམ་སྟེ།",
    "རྣག་ཁྲག་གིས་ལུས་ཀྱི་ཕྱི་གཡོགས་ཤིང་འཁྱག་པ་ཆགས་པས་སྡུག་བསྔལ་བའོ།",
    "ཨུཏྤལ་ལྟར་གས་པ་ནི་ལུས་ཀྱི་ཕྱིའི་ཁ་དོག་སྔོན་པོར་སོང་ནས་དེ་ཡང་ཚལ་པ་བརྒྱད་དང་བཅུ་དྲུག་ལ་སོགས་པར་གས་པའོ།",
    "གཅིག་གིས་གཅིག་གི་ལུས་གཅོད་པའི་མཐུས་བརྒྱལ་བ་ལྟ་བུར་གནས་སོ།",
    "སོག་ལེ་སོགས་མཚོན་ཆ་མེ་འབར་བ་དག་གིས་དྲས་ཏེ།",
    "རལ་གྲི་ལོ་མའི་ནགས་ཚལ་ཤིང་དེའི་གྲིབ་བསིལ་ན་ཕྱིན་པ་ན་ཤིང་གི་ཡལ་ག་དང་ལོ་འདབ་ཐམས་ཅད་རལ་གྲིའི་ཆར་དུ་གྱུར་ནས་ལུས་གཅོད་པ་སྟེ།",
    "ཐལ་ཚན་གྱི་ཆུ་བོ་རབ་མེད་པ་སྟེ་བཞི་བཞིས་བསྐོར་བའོ།",
    "ནང་གི་སྒྲིབ་པ་ཅན།",
    "ལྟོ་བ་རྒྱ་མཚོ་ཙམ་དུ་སོང་ཡང་མི་ཁེངས་པའི་སྡུག་བསྔལ་ལོ།",
    "གླིང་བཞི་རེ་རེ་ལ་ཉི་ཟླ་རེ་རེས་ཁྱབ་ཀྱང་།",
    "ཉི་ཟླས་མ་ཁྱབ་པའི་གླིང་བར་གྱི་གནས་སུ་སྐྱེས་ཏེ་རང་གི་ལག་པ་བརྐྱང་བསྐུམ་བྱེད་པ་ཙམ་ཡང་མི་མཐོང་བའོ།",
    "དེ་ལྟར་དེ་དག་གི་ཚེ་ཚད་དང་།",
    "སྤྱིར་ཐུན་མོང་དུ་འགྱུར་བའི་སྡུག་བསྔལ་བསམ་པ་དང་།",
    "སྒོས་གྱི་མི་ལ་ལེགས་པར་བརྟགས་ཏེ་ཕྱུག་པོ་སྤྲང་པོར་སོང་བའམ།",
    "ཁ་དྲག་པོ་ཁ་ཞན་པར་སོང་བ་ལ་སོགས་པ་ཡུལ་མི་ཁྱིམ་ཚེས་དང་།",
    "འགྱུར་བའི་སྡུག་བསྔལ་ལ་ངེས་ཤེས་སྐྱེས་སྐྱེས་བསྒོམ་མོ།",
    "ངག་གི་ལས་བཞི།",
    "གཉིས་པ་ངན་སོང་གསུམ་དང་།",
    "བརྣབ་སེམས་ཡིད་ལ་རེ་བ་འཇོམས།",
    "ཕྲག་དོག་གིས་ནི་གཟི་ཆུང་ཉིད།",
    "ངག་གི་ལས་བཞི།",
    "མི་དགེ་ཞེས་བྱ་དེ་དག་གི།",
    "རང་གི་སེམས་ནི་ཡོངས་སུ་གདུལ།",
    "ཉམས་ཀྱི་སྣང་བ་ནི་དེ་དག་གི་ཉམས་མྱོང་ཚུལ་བཞིན་དུ་རྒྱུད་ལ་སྐྱེས་ཏེ།",
    "དེ་དག་གི་བསྒོམ་ཚུལ་ཀྱང་།",
    "དེ་དག་གི་སྤྱོད་པ་ལ་བསླབ་པའོ།",
    "བདག་དང་ཕུང་སོགས་རྣམ་རིག་གི།",
    "སེམས་ཙམ་པས་བརྟགས་པའི་རྣམ་རིག་གི་རྟོག་པ་རྣམས་ཀྱིས་མ་བསྒྲིབས་པ་སྟེ།",
    "དེ་དག་གང་གིའང་ངོ་བོར་མ་གྲུབ་པ།",
    "རྣལ་འབྱོར་པའི་སེམས་རྣམ་པར་གཡེང་བ་དེའི་ཚེ་སེམས་འཁྲུགས་པར་བྱེད་པའི་རྒྱུ་ཉོན་མོངས་པ་དང་རྣམ་རྟོག་ལ་ཉེས་པར་བལྟས་ཏེ།",
    "བྱེད་པ་པོའི་སེམས་ཀྱང་གསལ་རིག་ཙམ་མོ་སྙམ་དུ་ངེས་པར་བྱས་ལ་དེའི་སྟེང་དུ་བློ་བཞག་གོ།",
    "གསུང་གི་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པ་དང་།",
    "དེ་དག་གི་མཐའ་སུས་ཀྱང་རྟོགས་པར་མི་ནུས་པ་ཡིན་ལ།",
    "ཐུགས་ཤེས་བྱ་ཇི་ལྟ་བ་དང་ཇི་སྙེད་པ་ཡེ་ཤེས་སྐད་ཅིག་མ་གཅིག་གིས་མཁྱེན་པའོ།",
    "བློ་ཆེན་སྦྱངས་པ་ཟབ་མོ་དག་ལ་མོས།",
    "སྤང་བྱ་ཉོན་མོངས་པ་གང་ཤས་ཆེ་བའི་སྒོ་ནས་དེ་བཞིན་གཤེགས་པའི་རིགས་ལྔ་སོ་སོའི་རིགས་སུ་ངེས་པ་དང་།",
    "གང་ཟག་འབྲིང་གི་ལམ་གྱི་གཙོ་བོ་ཡིན་པས་དམ་ཚིག་ཉི་ཤུ་བསྐྱང་བར་བྱ་སྟེ།",
    "ཐོབ་པ་མི་ཉམས་པར་བསྲུང་བ་དམ་ཚིག་གི་ཚོགས་བསྐྱང་བ་གཉིས་ལས།",
    "འདིར་སྨོན་འཇུག་གིས་བསྡུས་པའི་ཀུན་རྫོབ་སེམས་བསྐྱེད་ཀྱི་སྡོམ་པ་ཐོབ་པ་གཙོ་བོ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་ཐོབ་པ་མི་ཉམས་པར་བསྲུང་བ་དམ་ཚིག་གི་ཚོགས་བསྐྱང་བ་ལ་གཉིས་ཏེ།",
    "རྗེས་སྤྱོད་རང་བྱུང་གི་ཡེ་ཤེས།",
    "ཚོགས་འཁོར་ནི་བཟའ་བའི་དམ་ཚིག་གི་ཆེད་དང་།",
    "གྲུབ་ན་དམ་ཚིག་གི་བྲིས་སྐུ་དང་།",
    "རྡོ་རྗེ་དྲིལ་བུ་རྣམས་མཚན་ཉིད་དང་ལྡན་པ་ཚུལ་བཞིན་དུ་མི་འབྲལ་བར་འཆང་ཞིང་དེ་ཙམ་མ་གྲུབ་ན་དམ་ཚིག་གི་རྡོ་རྗེ་དང་དྲིལ་བུ་ཚད་དང་ལྡན་པ་རབ་གནས་ལེགས་པར་བྱས་པ་མི་འབྲལ་བར་བཅང་ངོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "གང་རུང་སྔོན་དུ་སོང་ནས་རྫོགས་རིམ་བསྒོམ།",
    "འདུས་པ་བར་པ་ལ་ཐིག་ལེ་བདེ་སྟོང་གི་ལམ་ཁྲིད་པ།",
    "ཞེས་པ་ལ་བརྟེན་ནས་མཆོག་གི་དངོས་གྲུབ་སྒྲུབ་པའི་མངོན་རྟོགས་ཀྱི་གཙོ་བོའི་སྒོ་ནས་ཡབ་གྱི་བསྐྱེད་རིམ་དང་།",
    "གུར་ལས་ཡན་ལག་དྲུག་གི་ཆིངས་གསུངས་པ་ལ་བརྟེན་ནས་འཆིང་བྱེད་མངོན་རྟོགས་ཀྱི་སྒོ་ནས་ཡན་ལག་བཞི་པའི་ཕྱོགས་དང་།",
    "ཕྱི་མའི་ལྔ་པར་སྐད་ཅིག་གིས་བསྐྱེད་པ་དང་།",
    "ས་བོན་ལས་བསྐྱེད་པ་གཉིས་གསུངས་པ་ལ་བརྟེན་ནས་བསྐྱེད་ཆོག་གི་སྒོ་ནས་མངོན་བྱང་ལས་བསྐྱེད་པ་དང་།",
    "སྐད་ཅིག་གིས་བསྐྱེད་པ་སྟེ་གསུམ།",
    "གཞལ་ཡས་ཁང་གིས་མ་དག་པའི་སྣོད།",
    "བསྐྱེད་ཆོག་གིས་སྐྱེས་གནས་བཞི།",
    "སྦྱིན་སྲེག་གི་ཚུལ་རྣམས་བརྒྱུད་པའི་མན་ངག་ཇི་ལྟ་བ་བཞིན་ལེགས་པར་བསྟན་ནས།",
    "སྦྱིན་སྲེག་གི་སྒྲུབ་པ་ལ་འཇུག་པར་བྱའོ།",
    "རེ་རེ་ལ་ཡང་འཇུག་པའི་རིམ་པ་དང་།",
    "རང་གིས་བརྗོད་པས་གསལ་གདབ་པ་ནི།",
    "དེ་དག་གི་དུས་སུ་ཡང་མ་བསྒོམ་ཙ་ན་རྣམ་པ་ཝལ་ཝལ་བྱུང་ན་བསམ་གཏན་གྱི་དུག་ཡིན་པས་གཞན་ལ་ཤེས་པ་ཡེངས་སུ་བཅུག།",
    "བཞི་པ་ལ་གཡོན་པའི་ཞལ་གཉིས་གནག་པ་དང་སྟེང་གི་ཞལ་གསལ་གདབ།",
