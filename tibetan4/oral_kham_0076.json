    "ཕལ་ཆེར་ཨེ་ཀར་གཉིས་ཡོད་པ་ནས་ཕྱེད་ཀ་ཙམ་གཞན་གྱི་ཟས་འདུག་མུ་མཚམས་སོ་སོར་རྡོ་རྟགས་འཛུགས་སུ་བཅུག་ཕྱིས་འབྱུང་ཧམ་པ་སུ་ཆེ་བྱས་ན་མི་འགྲིག་པ་དང་།",
    "གྲོང་མི་ཚང་མས་ཤོག་རུབ་ལྟ་བུ་བྱས་ཏེ་དཀའ་ངལ་ཆེན་པོ་བློ་ཕམ་སྐྱེ་འོས་པ་ཞིག་བྱུང་འདུག་ཅིང་།",
    "དེ་ཉིན་ཕྲན་རང་ཡོད་ས་དེར་ཡང་མང་པོ་ཞིག་འཛོམས་ནས་ཁ་རུབ་བྱེད་ཀྱི་འདུག་སྟབས།",
    "སྐབས་དེ་དུས་ཅོ་ནེ་འཕགས་པ་ཚེ་རིང་ཅན་ཁ་ཤས་འདུག་ཀྱང་།",
    "ལྷ་ཁང་ཞིག་ཀྱང་གསར་བཞེངས་བྱས་འདུག་ཀྱང་།",
    "ཁེ་འབབ་ཀྱང་བགྲང་རྒྱུ་ཡོད་པ་ཞིག་འདུག་དེའི་གོང་དུ་གཞིས་འགོ་རྡོ་རྗེ་རྣམ་རྒྱལ་དང་།",
    "མཉམ་འབྲེལ་གྱི་ལས་གཞི་སྒོ་རྒྱག་དགོས་པ་ལྟ་བུ་མི་འདུག་ཀྱང་།",
    "དེར་བརྟེན་ཐབས་ཤེས་གང་འདྲ་ཞིག་དགོས་ན་ཡང་ཡང་མ་བྱས་པར་སྡོད་ཐབས་ཡེ་ནས་མེད་པ་ཆགས་ཀྱི་འདུག་དཔེར་ན།",
    "ལོ་དེའི་ཡིག་རྒྱུགས་ནས་སློབ་ཕྲུག་༤ ལ་འཛིན་རིམ་༡༢ ཀྱི་ཡིག་རྒྱུགས་ཨང་དང་པོ་ཐོབ་འདུག་སྟེ།",
    "ལྷག་པར་དུ་བོད་མིར་མི་དགའ་བའི་ལྟ་བ་ཤུགས་ཆེ་འཛིན་མཁན་དེ་འདྲ་ཡིན་འདུག་སྟབས།",
    "ཁྱད་བྲིས་གཉིས་པའི་ནང་ཏུང་ཧྲུའུ་ཕན་ལ་དྲི་བ་བྱེད་མཁན་ཀྲི་ན་ཅའོ་ཡིན་པ་བསྟན་གྱི་འདུག་དེར་བརྟེན་ཀྲི་ན་ཅའོ་དང་།",
    "འབྲེལ་བ་བྱེད་མཁན་གཙོ་བོ་རྒྱ་རི་བློ་གྲོས་ཡིན་འདུག་པ་དང་།",
    "རང་རང་སོ་སོའི་ངོས་ནས་གནས་སྟངས་གང་ས་ཅི་ཐད་ལ་དོ་སྣང་དང་འགན་ཁུར་ཆེན་པོ་བྱེད་དགོས་པ་མ་ཟད།",
    "ཕྱོགས་བཟུང་ནས་གཅིག་སྒྲིལ་ཚོགས་པར་མགོ་གནོན་སྡང་ཟུག་བྱེད་ཀྱི་འདུག་ཅེས་ཁ་དམག་སྤེལ་བ་དང་།",
    "དེ་རྩིས་དགོངས་པ་བཞེས་དགོས་ཞེས་སོགས་བརྗོད་ཀྱི་འདུག་ཅིང་།",
    "བློ་ཕམ་ཆེ་བའི་རྣམ་འགྱུར་ཤུགས་ཆེན་བསྟན་འདུག་དངོས་འབྲེལ་བྱས་ན་བདེན་པ་ཡིན་རུང་གོང་དུ་བརྗོད་པ་ལྟར་བཀའ་ཤག་ལ་ཐག་གཅོད་བྱེད་པའི་གནས་སྟངས་བསྡད་མེད།་",
    "ཁྱེད་རང་ནས་ལུང་ཚན་དང་།",
    "ཡག་པོ་ཡོད་པའི་དུས་ཚོད་ཡིན་ན་ཕྲན་བུ་སྤོའོ་འགྱེལ་རྨོའོ་སླངས་ཟེར་བ་ལྟར་བྱས་པ་ཡིན་ན་ཁྱད་མི་འདུག་གམ།",
    "གཡར་དམ་གཉེན་པོའི་ཐ་ཚིག་དུས་འདིར་དགོངས།",
    "འོན་ཀྱང་རང་ཕྱོགས་ལའང་ཆ་རྐྱེན་འདོན་ཕྱོགས་ལ་འབྲེལ་བ་ཆགས་ཀྱི་ཡོད་པར་བརྟེན་སྐབས་མཚམས་སུ་བསམ་བློ་གཏོང་རྒྱུ་ལས་ད་ལྟའི་ཆར་དམིགས་བསལ་བརྗོད་ཐུབ་པ་དཀའ་ཞིང་།",
    "དྲིལ་བསྒྲགས་དྲུང་ཆེ་ལས་འཕར་རྒྱ་རི་བློ་གྲོས་རྒྱལ་མཚན་གསུམ་ཐུགས་གཏན་འཁེལ་བ་རྣམས་ཀྱི་མིང་ཐོ་སྤྲད་དེ་དེ་དོན་ག་དུས་ཕེབས་ན་འགྲིགས་རྒྱའི་ཐག་ཆོད་གཏན་འཁེལ་བྱུང་།",
    "སྔ་ལོར་ཁྱེད་རང་རྣམ་པས་གསུངས་དོན་གཅིག་ལ།",
    "ཡང་ཁྱེད་རང་རྣམ་པས་སྔ་ལོར་གསུང་དོན་གཅིག་ལ།",
    "ཁྱེད་རང་རྣམ་པས་གོང་ས་མཆོག་ཚུར་ལོག་ཕེབས་ན་དགའ་བསུ་དང་།",
    "དེ་འདྲའི་གནས་ཚུལ་ལ་བརྟེན་ནས་བོད་ནང་དུ་ཡོད་པའི་བོད་མི་ཚོས་ད་ལྟའི་ཆར་གོང་ས་མཆོག་ཚུར་ཕེབས་པའི་དུས་ལ་བབས་མི་འདུག་ཅེས་དང་།",
    "རྣམ་འགྱུར་གང་བཟང་ཐོག་ཞལ་ཏོག་སོག་འདྲ་མིན་བཀོད་འདུག་ནང་ཚགས་བྱ་དགོས་ཡང་ཡང་ཟེར།",
    "རྒྱ་མི་བོད་སྐད་ཤེས་མཁན་ཞིག་འདུག་པ་དང་།",
    "དེ་ཉིན་སྣེ་ལེན་པ་མི་གཉིས་འབྱོར་འདུག་རུང་སྔར་ལྟར་དོ་འཁུར་མ་བྱས་སྟབས་དུས་ཡུན་རིང་ཙམ་བཀག་མཐར།",
    "པེ་ཅིང་གནམ་ཐང་དུ་སྔར་གྱི་སྣེ་ལེན་པ་ལེའུ་ལུང་ཞེས་པ་འདུག་ཅིང་།",
    "ཁྱེད་རང་རྣམ་པ་སྔོན་དུ་ཕེབས་འཆར་ལྟར་མགྲོན་ཁང་གྲ་སྒྲིག་བྱས་ཀྱང་།",
    "ཁྱེད་རང་རྣམ་པས་གསུང་པ་དེ་ཚོ་གསལ་པོ་བྱས་ན་འགྲིགས་ལུགས་སོགས་གསུངས།",
    "མཉམ་དུ་ཧྲུའུ་ཅི་དབྱིན་ཧྥ་ཐང་བཅར་དགོས་ལུགས་གསུང་འདུག་པ་ལྟར།",
    "སྣེ་ལེན་པ་འགོ་པ་ཡང་གླིང་རྡོ་རྗེ་ནས་དེ་དོན་ཞུས་འཐུས་ཞུས་འདུག་ཀྱང་།",
    "དེ་འདྲའི་ཕེབས་བསུ་བྱས་མི་ཆོག་པ་སྔོན་མ་ཞིག་ཏུ་ཀྲུང་དབྱང་ནས་བཀའ་བཏང་ཡོད་པ་ལ་རྩ་འཛིན་བྱས་ཏེ་དབྱིན་ཧྥ་ཐང་ཕེབས་བསུར་ཕྱིན་མི་འདུག་འཕགས་པ་ལྷ་དགེ་ལེགས་རྣམ་རྒྱལ་མཉམ་བཅར་བྱས་ན་བརྗོད་འདུག་ཀྱང་།",
    "ཁོང་ཡང་བཅར་གྱི་མིན་གསུངས་སྟེ་བྱུང་མི་འདུག་ཆིབས་ཀྲོར་ཁེབས་མེད་གོ་སྒྲིག་ཞུས་འདུག་དེ་དུས་བལ་ཡུལ་རྒྱལ་པོ་ཕེབས་པའི་སྣེ་ལེན་དུ་ངོས་རང་ཕྱིན་པ་ཡིན།",
    "བཀའ་དྲིན་ཅི་ཆེ་ཡོད་འདུག་ནའང་།",
    "དེ་སྐབས་སུ་བོད་ནང་དུ་དྲག་པོའི་དཔུང་དམག་ཀྱང་ཕོན་ཆེན་གསར་དུ་འབྱོར་འདུག་ལུང་པར་ཞི་བདེ་དེབ་བཅུ་གཅིག་པ།",
    "ཡང་བསྐྱར་དམག་བསྣོན་དགོས་དོན་མི་འདུག་ངཚོས་བལྟས་ན།",
    "ག་དུས་ཡིན་ན་ཡང་པེ་ཅིང་དང་།",
    "ནོར་འཁྲུལ་ངོས་ལེན་བྱས་ན་ག་དུས་ལོག་ཀྱང་དགའ་བསུ་དང་།",
    "ཁྱེད་རང་རྣམ་པས་དེབ་བཅུ་གཅིག་པ།",
    "དེང་རབས་སུ་ཁྱེད་རང་རྣམས་པས་མི་རིགས་གླེང་སྟངས་ལ།",
    "བཟོ་གྲྭ་ཆུང་ཆུང་ཁག་མང་པོ་འདུག་ཅིང་།",
    "གཞན་ཡང་གླིང་ཁ་ཁག་ཤས་འདུག་པར་བསྐྱོད།",
    "དེའང་རང་ལོ་༡༣ ནས་༣ བར་ཡིན།",
    "དེ་མིན་འཚེམས་ཚར་བ་དེ་འདྲ་མཐོང་ན་འཚེམ་གྲུབ་ཡིན་པའི་ཡིད་ཆེས་འཕེར་དཀའ་བ་དེ་འདྲ་འདུག་མུ་མཐུད་དེའི་ཉེ་སྐོར་དུ་གཡང་ཊི་སོགས་ལ་རང་བརྐོས་རྒྱག་སའི་བཟོ་གྲྭ་དང་།",
    "ཡུལ་གྲུ་དེ་དག་ལྷ་ཡི་ཡུལ་གྲུ་རང་ཡིན་ཚུལ་བརྗོད་ཀྱི་འདུག་ལ།",
    "གླང་ཆེན་མཆེ་བ་དང་རུས་པ་ཙན་དན་སོགས་ལ་སྐུ་འདྲ་མིན་བརྐོས་རྒྱག་སའི་བཟོ་གྲྭ་འདུག་པ་དེར་ཕྱིན།",
    "ཆུ་ཟུར་ནས་ཆུའི་དཀྱིལ་བར་ཟམ་པ་འཛུགས་པའི་ཐོག་ནས་དབོར་འདྲེན་བྱས་འཆར་བཟོས་འདུག་བཟོ་གྲྭ་དེར་འཇམ་མན་རྒྱལ་ཁབ་ནས་ཀྱང་འབྲེལ་བ་ཡོད་ཟེར།",
    "ལན་ཅི་ཡང་མི་སྨྲ་བར་བསྡད་འདུག་མུ་མཐུད་ནས་དེ་འདྲ་ཡིན་ན།",
    "ཁྱེད་རང་རྣམ་པས་བོད་དེ་དམིགས་བསལ་ཅན་གྱི་གནས་བབ་དགོས་ལུགས་ཟེར་བ་དེ།",
    "རིང་སྲེལ་ཡོད་པའི་བུམ་པ་ཆེན་པོ་ཞིག་འདུག་པ་དེ་ཡིན་པ་དང་།",
    "བུམ་པ་བཞུགས་པའི་དཀྱིལ་འཁོར་མཆོད་རྟེན་དེ་རྒྱུན་དུ་བདག་སྐྱོང་ཞབས་ཏོག་ཞུ་མཁན་ཡང་ཁོང་རང་ཡིན་ཟེར།",
    "༡༨ ཙམ་འདུག་ཅིང་།",
    "བྲག་ངོས་ཁོ་ན་ཡིན་འདུག་ལུང་པ་དེའི་འདབས་ནས་བཟུང་གཡོན་ཕྱོགས་ཀྱི་བྲག་ངོས་ཐམས་ཅད་ལ།",
    "གསེར་སྐུ་མང་ཙམ་འདུག་པའི་བོད་ཀྱི་བླ་སྐུ་མང་པོ་འདུག་སྔ་རབས་སུ་བོད་དང་འབྲེལ་བ་ཤུགས་ཆེ་ཡོད་པ་གསལ་པོར་མངོན།",
    "དེ་འདྲ་ཟེར་བའི་མི་ཞིག་གཏན་ནས་མི་འདུག་བརྗོད་ཀྱི་འདུག་ཟེར།",
    "ཁྲུའུ་ཀྲང་རན་རན་ནས་སེམས་འཚབ་འཚུབ་ཀྱིས་རྣམ་པའི་ངང་ནས་ལག་འདོགས་ཆུ་ཚོད་བལྟས་ཏེ་ད་ཆ་བསྒྲགས་ཚར་བ་འདུག་ཁྱེད་རང་རྣམ་པའི་གསུང་དོན་དེབ་བཅུ་གཅིག་པ།",
    "ང་རང་དང་།",
    "དེའི་དབར་ཁོང་ཞེ་དྲག་དྲན་གྱི་འདུག་ལྷག་པར་ཁོང་རྒྱལ་ཕྱིར་གནས་བབ་དང་།",
    "ང་རང་ཡང་ལོ་མང་རིང་དཀའ་ངལ་མྱོང་དགོས་བྱུང་།",
    "ཆབ་སྲིད་གྲོས་ཚོགས་ཀྱི་ཀྲུའུ་ཞི་གཞོན་པ་གནང་རྒྱུ་འཁོད་འདུག་པ་དེའང་ཁས་ལེན་བྱེད་མི་ཐུབ་བམ།",
    "མཁའ་ཐོག་ནས་ཕེབས་ན་དགའ་བསུ་ཞུ་བའི་མཛད་སྒོ་གཞི་རྒྱ་ངེས་ཅན་གྲ་སྒྲིག་བྱེད་རྒྱུ་ཡིན་ལུགས་འཁོད་འདུག་པ་དེ་ཡང་ཁས་ལེན་མི་ཐུབ་བམ།",
    "ཐན་སྐྱོན་ཚབས་ཆེ་བྱུང་འདུག་པས།",
    "ཉག་གཅིག་ཏུ་འཛིན་རྒྱུ་ཨེ་ཡོད་བསམ་གྱི་འདུག་དཔེར་ན།",
    "༡༩༨༥ ལོའི་ནང་ཆིབས་བསྒྱུར་གནང་རྒྱུ་འཚམས་པོ་མི་འདུག་སྙམ།",
    "ཁྱེད་རང་རྣམ་པས་དོགས་པ་ཡེ་ནས་མ་བྱས་པར།",
    "འོ་ལོས་ཡིན།",
    "དེས་ན་ང་རང་ཡང་བོད་མི་ཞིག་ཡིན་པ་མ་ཟད།",
    "ཉེས་ཁྲལ་རིགས་གང་ཡང་མེད་པར་ཧོང་ཀོང་ཇི་བཞིན་བྱ་ཆོག་པ་ཡིན་འདུག་ན་ཡང་།",
    "ཁྱེད་རང་རྣམ་པས་ཁག་དཀྲི་ཁག་བཏགས་བྱེད་ཀྱི་ཡོད་ན་ནི།",
    "འོན་ཀྱང་བདེན་པའི་འདོད་ཚུལ་ལག་ལེན་དངོས་སུ་འཁེལ་མིན་ནི་དངོས་དོན་གཞན་ཞིག་ཡིན་འདུག་པ་སྟེ།",
    "རང་སྣང་རང་ལ་དག་ཆེས་དྲགས་པ་དེ་འདྲ་ཡིན་སྲིད།",
    "དེ་འདྲའི་དུས་སྐབས་སུའང་རང་བཙན་ཡིན་མུས་ལ།",
    "གོང་ས་མཆོག་གང་དུ་བཞུགས་མིན་སྐོར་ཁྱད་པར་ཅི་ཡང་མི་མངའ་བ་ཤེས་ཐུབ་པ་འདུག་སྙམ།",
    "དེ་ལྟའི་ལྟོས་ས་ལྟོས་བཅས་རྒྱབ་འགལ་དུ་ཆགས་པས་ཕན་ཐོགས་པའི་ལམ་མི་འདུག་འོ་ན་དེ་འདྲ་ཁས་མ་བླངས་ན།",
    "ད་ལྟ་ཡར་རྒྱས་གང་ལ་གང་འཚམས་འགྲོ་ཡི་འདུག་སྟེ།",
    "བོད་ཙམ་མ་ཡིན་པར་འཛམ་གླིང་མི་རིགས་སྤྱི་ལ་ཞབས་འདེགས་སྒྲུབ་ཐུབ་པའི་ཆ་རྐྱེན་ཏན་ཏན་ཡོད་པ་ལྟ་བུ་འདུག་ཆ་རྐྱེན་དེ་བེད་སྤྱོད་ཐུབ་མིན་དང་།",
    "ས་ཆའི་བདག་པོ་མིན་པའི་རྒྱ་མི་མང་བ་ཆགས་འདུག་རྒྱ་མིས་ཤིང་ཅང་ཟེར་བ་དང་།",
    "འགྲོ་གྲོན་ཧ་ཅང་ཉུང་དུ་ཕྱིན་འདུག་དཔེར་ན།",
    "བོད་ཀྱི་གཞོན་ནུའི་ལྷན་ཚོགས་ཞེས་མིང་བསྒྱུར་འདུག་གཞི་རྩའི་ཆ་ནས་བྱས་ན།",
    "དགོས་ཀྱི་མི་འདུག་ལབ་པ་ཡིན།",
    "བཀག་འགོག་བྱེད་མཁན་བཀའ་བློན་བགྲེས་པ་འཇུ་ཆེན་ཐུབ་བསྟན་ཡིན་ལུགས་ཀྱང་བཀོད་འདུག་ཕྱི་ཚེས་༢༢ ཉིན་བཀའ་ཤག་ནས་པད་མ་རྒྱལ་པོས་དགོངས་ཤོག་ཕུལ་བ་དང་།",
    "ཕྱི་ཚེས་༢༧ ཉིན་བཞུགས་སྒར་དུ་ཕྱིར་འབྱོར་འདུག་ཕྱི་ཚེས་༢༩ སྔ་ཐོག་བཀའ་ཤག་ཏུ་པད་མ་རྒྱལ་པོ་ངོ་བཅར་བྱུང་བར།",
    "འོན་ཀྱང་ཁྱེད་རང་ལ་དེ་འདྲ་ཞིག་ཡོད་དེབ་བཅུ་གཅིག་པ།",
    "བཀའ་བློན་རྣམ་པར་ཐུགས་ཁྲེལ་རྒྱུ་ཡོད་དགོས་པ་ཞིག་ལོས་ཡིན།",
    "གུས་ནས་ཁོང་རང་ལ་གསལ་པོ་ལབ་ཡོད་པ་ནི།",
    "གོང་ས་མཆོག་ནས་ཀྱང་འགྱུར་བ་གཏོང་དགོས་དོན་མི་འདུག་ལ།",
    "ནང་དོན་གསལ་པོ་ཞིག་ཤེས་དགོས་ཀྱི་འདུག་ཅེས་དྲིས་པ་ཡིན།",
    "རྩེ་མཁན་མགྲོན་ཆེ་བ་བཅས་ལས་ཚན་ཐེམ་སྐས་རིམ་འཛེགས་ཀྱིས་ཞབས་ཞུ་གཟེངས་སུ་ཐོན་པ་ཞུས་ཡོད་འདུག་རྒྱ་དམར་བོད་དུ་བཙན་འཛུལ་བྱས་པ་ནས་བཟུང་བོད་རྒྱལ་ཁབ་དང་།",
    "མི་རིགས་ཀྱི་ཆབ་སྲིད་འཐབ་རྩོད་ཀྱི་སྲོག་ཤིང་ལྟ་བུ་འགན་འཁུར་ཆེ་བཞེས་ཞུས་ཡོད་འདུག་པ་དང་།",
    "ཡུལ་མི་ཕལ་ཆེ་བས་བློ་ཕམ་བྱེད་ཀྱི་འདུག་གང་ཡིན་ཟེར་ན།",
    "སྔོན་ལས་ལ་བསམས་ནས་ཕྱིར་ལོག་བྱ་རྒྱུ་ཡིན་ལུགས་སྔ་རྗེས་སུ་ནན་ཞུ་བྱེད་ཀྱི་འདུག་བཀའ་ཤག་ལྷན་རྒྱས་གནང་བའི་ཐོག་ཁོང་རྣམ་པར་གསུང་དོན།",
    "ལྷག་པར་ཁྱེད་རང་རྣམ་པ་ནས་མཚོན་གཞིས་ལུས་བོད་མི་མང་པོ་ཞིག་རྒྱ་གར་ནང་ཡོང་སྟེ།",
    "ང་རང་ལྟ་བུར་ཆ་མཚོན་ན།",
    "ཚང་མས་སེམས་ཤུགས་བསྐྱེད་དེ་རང་རང་སོ་སོས་འཁུར་ལེན་གྱིས་གཞིས་ཆགས་སོགས་རྟེན་གཞི་གནས་ས་བཟུང་ཐབས་ཕྱར་གྲུ་མཉམ་འདེགས་དགོས་གལ་ཞེས་ཡོངས་ཁྱབ་ཏུ་བཀའ་སྩལ་བ་ལ་ལྟོས་ཏེ།",
    "དེང་དུས་ཀྱི་ཁྲ་ཁྲ་ཟིང་ཟིང་དུ་འབད་ཀྱི་འདུག་པ་དང་།",
    "ངོ་ཚ་ཁྲེལ་མེད་འཆལ་སྤྱོད་ཅི་རིགས་འབད་དེ་རང་མཐུ་རང་སྒྲུབ་ཏུ་སྤྱོད་ཀྱི་ཡོད་པ་བློ་ཕམ་གྱི་རང་བཞིན་དུ་འགྱུར་མུས་སུ་འདུག་པ་ནི།",
    "མི་སྣ་འདི་ཚོ་དང་རང་ཉིད་འབྲེལ་འདྲིས་ཆེན་པོ་ཡོད་པ་དང་།",
    "སྲས་འཇིགས་མེད་ཁོང་ཉིད་ཀྱིས་ཕྲན་རང་ལའང་འབྲེལ་འདྲིས་ཆེ་བའི་ཆ་ནས་ཐུགས་ཕམ་ཆགས་ཡོད་འདུག་ཀྱང་།",
    "ད་ཆ་འགྲིགས་མི་འདུག་སྙམ་པ་ཤར་ནའང་།",
    "བལ་ཡུལ་དུ་མཆོད་རྟེན་བྱ་རུང་ཁ་ཤོར་གྱི་བྱང་ངོས་ས་ཡི་ཆར་དགོན་ས་གསར་དུ་ཐབས་འཚོལ་གྱིས་ཁོང་རང་ཉིད་དང་འབྲེལ་དུ་མེད་པ་ཕ་ཡུལ་རང་ནས་ལྷན་གཅིག་ཏུ་ཡོང་བའི་ཞབས་ཕྱི་བསམ་འགྲུབ་རྒས་པོར་ས་བཟུང་དུ་བཅུག་སྟེ།",
    "ཡིག་གྱར་སྤེལ་བ་སོགས་བྱེད་འདུག་ནའང་།",
    "བོད་ཀྱི་སྐུ་ཚབ་ཚོགས་མི་བཀའ་ཟུར་ཁོ་རང་དང་།",
    "ལྕགས་རིའི་ནུབ་ཕྱོགས་ཀྱི་གཡང་ཊིའི་རྒྱལ་སྒོ་ཞེས་པ་དེ་རྒྱ་ནག་ནུབ་ཕྱོགས་ཀྱི་ས་མཚམས་ཚད་འཛིན་བྱེད་ས་ཡིན་པ་ཕྱི་ལོ་༡༩༣༩ ལོར་བཀོད་པའི་རྒྱ་ནག་གསར་པའི་ས་བཀྲའི་ནང་ཤིན་ཏུ་གསལ་པོ་འཁོད་འདུག་ཕྱི་ལོ་༡༩༤༧ ལོར་རྒྱལ་རབས་ཀྱི་དེབ་ཅིག་འགྲེམས་སྤེལ་བྱས་ཡོད་པ་དེའི་ནང་སྔ་དུས་རྒྱ་ཚོས་ལྕགས་དང་།",
    "ཤར་ཏུར་ཀི་སི་ཐན་བཅས་ནི་རྒྱ་མིའི་མི་སེར་སྤེལ་ཡུལ་ཁོ་ན་ཆགས་འདུག་ཕྱི་ལོ་༡༩༦ ལོ་ནས་བོད་ལ་བསྡད་པའི་རྒྱའི་སྐད་བསྒྱུར་ཞིག་ལ་ངས།",
    "ཁོ་པས་ལས་སླ་པོར་བསྒྱུར་ཐུབ་ཀྱི་འདུག་ཅེས་བྲིས་འདུག་རྒྱ་མིའི་ལྟ་བའི་ནང་ཡུ་གུར་བ་ཚོ་ཀླ་ཀློ་དང་།",
    "བོད་གཞུང་མང་རང་ཉིད་ནས་རང་མགོ་རང་འཁོར་རྣམ་གཡེང་ལྷོད་ཡེངས་རང་བཞིན་ཅན་དུ་གྱུར་པས་ལན་པ་ཞིག་ཡིན།",
    "རྒྱ་ནག་དམར་པོའི་གཞུང་མ་ཚུགས་གོང་ནས་མན་ཇུའི་མི་རིགས་ཁོ་རང་ཆེད་མངགས་རྩ་མེད་བཏང་ནས་མན་ཇུའི་ཡུལ་དང་།",
    "སུད་སི་བཅས་སུ་ཡོད་པའི་དོན་གཅོད་པ་ཁག་བཅས་ཡོད་འདུག་ཅིང་།",
    "ཡིན་ནའང་དེང་སྐབས་ངའི་མི་མང་རྣམས་རང་ཉིད་མི་རིགས་ཀྱི་ངོ་བོ་ཁྱད་འཕགས་ཅན་དེ་བརླག་རྒྱུའི་ཉེན་ཁ་སླེབས་འདུག་གང་ཡིན་ཞེ་ན།",
    "མི་སྒེར་བཅས་ཚང་མ་ངོ་ཆེ་ངོ་ཆེན་གྱི་ཕྱོགས་སུ་འགྲོ་བ་ནི་ཀུན་གྱི་བྱ་བ་ཞིག་ཡིན་འདུག་པ་དང་།",
    "ཡུལ་དུ་གྱར་བའི་གནས་སྐབས་འདི་དག་ཏུའང་བློས་གཏོང་མི་ཐུབ་ངེས་ཅན་ཡིན་འདུག་སྐབས་འཚོལ་རིང་ལུགས་ཟེར་ཆོག་པའི་བོད་མིའི་རྒྱུན་གཤིས་འདི་རིམ་པས་ཡལ་ཐབས་ཀྱི་སྲིད་བྱུས་ལྟ་བུ་སྤྱོད་རྒྱུ་ཡོད་ན་ལས་མེད་ཕྱིན་བོད་མི་རིགས་ཀྱི་བོད་དོན་འཐབ་རྩོད་བྱ་རྒྱུའི་ནུས་པ་གཅིག་ཏུ་འབུངས་ཐུབ་རྒྱུ་ཁག་པོ་ཞིག་མཐོང་།",
    "འདི་དུས་ཀྱི་ཡས་མས་སུ་ཚོད་དཔག་ཐུབ་སྟེ་དོགས་པ་རང་ཞིར་ཕྱིན་ནས་རྒྱ་ནག་པ་བློ་བདེ་པོ་ལྟ་བུ་བྱེད་ཀྱི་འདུག་པ་དང་།",
    "རྒྱ་དང་ཐུག་དུས་རྒྱ་ཡིན་ཟེར་མཁན་དང་།",
    "རྗེས་སུ་ཚུར་ཡོང་སྟེ་སྲིད་དོན་གྱི་ངོ་བོ་འགྱུར་ཐབས་ལ་འབད་འདུག་ཀྱང་།",
    "ཕ་ཡུལ་ཆུ་ཤུར་དུ་མི་ཚང་ཆེན་པོ་རྒྱུ་ནོར་ཁ་རྗེ་ཆེན་པོ་ཅན་ཞིག་ཡིན་འདུག་ནའང་།",
    "ཆུ་ཤུར་བ་བ་སྨད་ཀུན་བཟང་ནས་དེ་སྔ་༡༩༥༨ ལོ་ནས་ཁོང་རང་ཆུ་བཞི་སྒང་དྲུག་བསྟན་སྲུང་དང་བླང་དེབ་བཅུ་གཅིག་པ།",
    "བྱམས་པ་སྐལ་ལྡན་བདེ་སྲུང་དྲུང་ཆེ་རྒྱུན་རིང་བྱས་རིང་ཚེ་དགའ་མའི་བརྒྱུད་ནས་ཐའེ་ཝན་གྱི་དངུལ་བླངས་བསྡད་པ་ཡིན་འདུག་རྗེས་སོར་བོད་སྤྱིའི་ལས་དོན་ཐོག་གནོད་འགལ་ཆེན་པོ་ཆགས་ཡོད།",
    "རྒྱ་ནག་ཏུ་བོད་ཀྱི་སྐུ་ཚབ་དོན་གཅོད་ཁང་འཛུགས་གལ་སྐོར་ཞུས་ཡོད་འདུག་པ་ལྟར།",
    "འབྲི་ཆུ་མན་ཆོད་ལ་ཤིས་ཁམས་སྲིང་ཞེས་ཟུར་དུ་བཅད་དེ་བོད་ཀྱི་དོན་གཅོད་ཁང་ཟེར་བའང་གླེང་གཞི་ཙམ་མེད་པ་བྱས་འདུག་ནན་ཅིང་དུ་ཡོད་པའི་བོད་ཀྱི་དོན་གཅོད་ཁང་དེ་ལ་ཤིས་ཙང་བོན་སི་ཁྲུའུ་ཞེས་འབོད་འདུག་ཅིང་།",
    "ངས་ང་རང་རྟོགས་ཀྱིན་མི་འདུགང་ལ་སྐྲག་སྣང་སྐྱེས་བྱུང་།",
    "ང་རང་ཅུང་ཧད་པ་དང་མདུན་ཅོག་ཐོག་ཏུ་ལྗིད་ཏིག་གེར་ལྷུང་བའི་དཔེ་དེབ་ལ་བལྟས།",
    "ང་རང་ཉིད་ཀྱི་སེམས་མཚོན་བྱེད་སྒོར་ཉིས་བརྒྱ།",
    "ངོ་མ་རྫིག་པོ་འདུག་ང་ནི་ཁོའི་ལོགས་ནས་འཕྱི་བ་དང་འདྲ།",
    "ཨ་ཨ་ཙིཙི།",
    "མྱུར་དུ་ཐུངས་ཤིག་དུས་ཚོད་བསླེབ་གྲབས་འདུག་ཟེར།",
    "མི་རང་རང་སོ་སོའི་སྐྱོན་ཆ་ཡིན་ནམ།",
