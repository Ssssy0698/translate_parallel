    "མིག་རྩ་དམར་ཁྲོས་མ་རངས་གད་མོས་རེ་སྙམ་འདེབས།",
    "སྐྱེ་བོ་ཐམས་ཅད་དགའ་འགྱུར་བདག་གི་ཚེ་འདི་ནི།",
    "ཞི་གནས་རབ་ཏུ་ལྡན་པའི་ལྷག་མཐོང་གིས།",
    "ཉོན་མོངས་རྣམ་པར་འཇོམས་པར་ཤེས་བྱས་ནས།",
    "འདི་ནི་བདག་ཏུ་ལྟ་བ་ལ་སོགས་པ་སྟོང་པ་ཉིད་དང་འགལ་བར་འཇུག་པ་དེ་དག་གི་ཕྱིར་སྟོང་པ་ཉིད་ཀྱི་ཆེ་བ་བསྟན་པ་སྟེ།",
    "ཉོན་མོངས་སྒྲིབ་པ་མེད་པར་སྤོང་།",
    "ཉོན་མོངས་པ་ཡང་ཞི་བ་དེ་ལ་ནི་འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པའི་ཡོན་ཏན་རྣམས་ཚེགས་མེད་པར་འགྲུབ་པར་འགྱུར་ཏེ།",
    "སྟོང་པ་ཉིད་འབའ་ཞིག་གིས་ཆོག་པར་གསུངས་པ་ཉིད་དོ།",
    "གང་ན་སྟག་གཟིག་སེང་གེ་མེད་པ་དང་།",
    "གྲོག་པོ་གྲོག་མཁར་ཐལ་བ་སྐྲ་ཤད་དང་།",
    "བཀྲེས་སྐོམ་གདུངས་པས་རང་གི་བུ་ཡི་ཤ།",
    "རང་གི་འབྱོར་ཕྱིར་སྒྲུབ་ལ་བདེ་བར་འཇུག།",
    "བཀྲེས་དང་སྐོམ་དང་ཉོན་མོངས་བཟོད་པ་དང་།",
    "རང་གི་འཚོ་བ་ཙམ་ཞིག་སེམས་པ་ཡང་།",
    "འདོད་ལ་མ་ཆགས་ལུས་ཀྱིས་ཉོན་མོངས་བཟོད།",
    "ལུས་ཀྱི་ཉོན་མོངས་སྤྱད་པ་ལས།",
    "རང་གི་སྡུག་བསྔལ་ཞི་བར་བྱ།",
    "དེ་བཞིན་དུ་འཕགས་པ་འཇིག་རྟེན་གསུམ་ལས་རྒྱལ་བའི་ཆོ་ག་ཞིབ་མོ་ལས་ཀྱང་།",
    "འདི་ནི་རྗེས་སུ་མཐུན་པའི་སྤྱོད་པ་རྣམ་པ་གསུམ་མོ།",
    "དེ་དག་གི་གཉེན་པོ་སྤོང་བའི་འདུ་བྱེད་བརྒྱད་ཀྱང་དེ་ཉིད་ལས་གསུངས་ཏེ།",
    "མཚན་མ་ཕྲ་མོ་ལ་དམིགས་པ་དང་།",
    "ལྷག་མཐོང་གི་འབྲས་བུ་ནི་ཞི་གནས་དང་ལྷག་མཐོང་ཟུང་དུ་འབྲེལ་པ་ཡིན་ཏེ།",
    "བདག་གི་བློ་རབ་ཏུ་འཕྲོ་བར་བཟོད་མོད་ཀྱི།",
    "ཞི་གནས་འབའ་ཞིག་གིས་ཉོན་མོངས་པ་རབ་ཏུ་གནོན་ཅིང་སེལ་བ་དང་།",
    "ཤེས་རབ་མིག་གིས་དེ་བཞིན་ཉིད་ཡུལ་རབ་གསལ་ཐོབ་པར་ཤོག།",
    "རང་གི་ཡོན་ཏན་ལ་རློམ་སེམས་མི་བསྐྱེད་པ་དང་།",
    "ཧ་ཅང་ཡང་ཐལ་བར་འགྱུར་བ་ཡང་ཤེས་པར་བྱ་བ་དང་།",
    "གང་གི་གཉེན་པོར་འགྲོ་བ་བསྟེན་ཤེས་པར་བྱ་བ་སྟེ།",
    "གཞན་གྱི་སྡུག་བསྔལ་རང་གི་གཉེན་པོར་བསྟེན་པར་ཤེས་པར་བྱ་བ་དང་།",
    "རང་གི་གཉེར་མ་དང་སྐྲ་དཀར་ལ་སོགས་པ་ལ་རྟག་ཏུ་བརྟག་ཅིང་སྐྱོ་བར་བྱ་བ་སྟེ།",
    "དེ་དག་ནི་རང་ལ་རང་གིས་གཞན་བསྐུལ་བཏབ་པའི་ཡན་ལག་རྣམ་པ་བདུན་ནོ།",
    "ཕྱི་དང་ནང་གི་དངོས་པོ་འདི་དག་ལ་སྒྱུ་མའམ་རྨི་ལམ་ལྟ་བུར་རྒྱུན་དུ་དཔྱད་པར་བྱ་བ་སྟེ།",
    "དེར་ཡང་རེ་བ་དང་དོགས་པ་དང་འདོད་པ་དང་།",
    "སེམས་དཔའ་ཞིང་རྟུལ་ཕོད་པའི་སྒོ་ནས་བླང་དོར་མེད་པར་ངས་སྒྲུབ་པ་འདིའི་སྒོ་ནས་འདོད་པའི་དོན་མ་གྲུབ་པའི་བར་དུ་ལུས་དང་སྲོག་གི་ཕྱིར་ཡང་མི་གཏོང་ངོ་ཞེས་དམ་བཅས་པ་སྒྲུབ་པ་དང་།",
    "དེ་ལྟ་བུའི་གང་ཟག་གི་ལུས་ནི་ཤིན་ཏུ་དཀོན་ཞིང་གཅེས་པས་ན་ལུས་བསྲུང་བར་བྱ་སྟེ།",
    "བྱ་བ་དང་བྱེད་པའི་རྣམ་རྟོག་བྱུང་ན་རང་གིས་རང་ལ་ལྕག་བརྡབ་ཅིང་གཉེན་པོ་བསྐྱེད་པར་བྱའོ།",
    "དེ་དག་ཁ་འཕངས་པའམ་ཁ་སྐོང་གི་ཡན་ལག་རྣམ་པ་བཞིའོ།",
    "སེར་སྐྱ་མོ་དང་ཆུ་སྐྱར་སྦྲུལ།",
    "རེ་བ་སྟོབས་ལྡན་ཉོན་མོངས་ཏེ།",
    "རེ་བ་མེད་པ་བདེ་བའི་མཆོག།",
    "རེ་བ་རེ་བ་མེད་བྱེད་པ།",
    "བདེ་བར་གཉིད་ལོག་སེར་སྐྱ་མོ།",
    "རྔོན་པ་ནགས་སུ་སོང་གྱུར་ཏེ།",
    "རེ་བ་ཟང་ཟིང་ཁྱིམ་སྤངས་དང་།",
    "སེར་སྐྱ་མོ་དང་ཆུ་སྐྱར་སྦྲུལ།",
    "དེ་ཡང་དཔེ་དྲུག་གིས་སྟོན་པ་ལས།",
    "དང་པོར་རེ་བ་སྤང་བར་སྟོན་པ་ནི།",
    "རེ་བ་སྟོབས་ལྡན་ཉོན་མོངས་ཏེ།",
    "སེར་སྐྱ་མོ་ཞེས་བྱ་བ་ནི་བུད་མེད་སྨད་འཚོང་མ་ཞིག་སྐྱེས་པ་དང་དུས་བཏབ་པ་ལས།",
    "མཚན་གྱི་སྟོད་ནི་སྐྱེས་བ་འོང་དུ་རེ་བ་ལས་ཡིད་སྡུག་བསྔལ་བར་གྱུར་ལ།",
    "མཚན་གྱི་སྨད་ནི་སྐྱེས་པ་མི་འོང་བར་རེ་ཐག་ཆོད་པས་སེམས་བདེ་བར་གཉིད་ཀྱིས་ལོག་པ་དེ་བཞིན་དུ།",
    "འདོད་པའི་ལོངས་སྤྱོད་སྔར་མ་ཐོབ་པའི་ཡུལ་རྣམས་ཐོབ་པར་རེ་བའི་སྐྱེས་བུ་སྟོབས་དང་ལྡན་པ་རྣམས་ཀྱང་སྡུག་བསྔལ་བར་འགྱུར་ན།",
    "དེ་བས་ན་འདོད་པའི་ཡོན་ཏན་མ་ཐོབ་པ་ལ་རེ་བ་མི་བྱེད་པ་ནི་བདེ་བའི་མཆོག་ཡིན་ཏེ།",
    "དཔེར་ན་ཆུ་སྐྱར་ཞིག་གིས་ཉ་ཅིག་བཟུང་བ་དང་།",
    "ཟང་ཟིང་གི་ལོངས་སྤྱོད་ཅི་ཙམ་ཡོད་པ་དེ་ཙམ་དུ་འཐབ་ཅིང་རྩོད་པའི་སྡུག་བསྔལ་བར་འགྱུར་ལ།",
    "ཟང་ཟིང་གི་ལོངས་སྤྱོད་ཀུན་སྤངས་ཏེ་མེད་པ་ལ་ནི་སྡུག་བསྔལ་གྱི་གདུང་བ་མེད་ཅིང་བདེ་བ་ཐོབ་པ་ཡིན་ནོ།",
    "དཔེར་ན་སྦྲུལ་ཞིག་རང་གི་ཚང་ན་གནས་པ་ལས།",
    "རྔོན་པ་ནགས་སུ་སོང་གྱུར་ཏེ།",
    "དཔེར་ན་རྔོན་པ་ཞིག་དུས་རྟག་ཏུ་ནགས་སུ་རྒྱུ་ཞིང་རི་དགས་ཚོལ་དུ་སོང་བ་ན།",
    "དཔེར་ན་བུད་མེད་གཞོན་ནུ་མ་གཅིག་ཙནྡན་བརྡར་བ་ན་ལག་པའི་གདུ་བུ་མང་པོ་འཁྲུལ་བ་མ་བདེ་ནས་རིམ་གྱིས་ཕྱུང་སྟེ་གདུ་བུ་གཉིས་ཤིག་གཞག་པ་ལས་དེ་ཡང་འཐབ་ནས་མ་བདེ་སྟེ།",
    "ཚིག་རྐང་གཅིག་གིས་ནི་སྤང་བར་བྱ་བ་སྟོན་ཏེ།",
    "རེ་བ་ཟང་ཟིང་ཁྱིམ་སྤངས་དང་།",
