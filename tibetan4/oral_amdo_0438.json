    "སྤྱན་དྲངས་པའི་ཕྱག་རྒྱ་ལས་མཐེ་བོ་ངོས་ལ་མཛུབ་མོ་བཙུགས་པ་ནི་མེ་ལྷའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ཕྱག་རྒྱ་དེ་ཉིད་ལས་མཛུབ་མོ་མཐེ་བོའི་ངོས་ལ་བཙུགས་ཏེ་ཕྱིར་དྲག་ཏུ་བརྐྱང་བ་ནི་སླར་བཏང་བའི་ཕྱག་རྒྱའོ།",
    "སོར་མོ་ཕན་ཚུན་བསྣོལ་ལ་ཁུ་ཚུར་བཅངས་ནས་སྲིན་ལག་གཉིས་བསྒྲེངས་ཏེ།",
    "གཡོན་པའི་མཛུབ་མོ་བཀུག་སྟེ་གཡབ་པ་ནི་བདེན་བྲལ་སྤྱན་དྲངས་པའི་ཕྱག་རྒྱའོ།",
    "སྤྱན་དྲངས་པའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་བརྐྱང་བ་ནི་སླར་བཏང་བའི་ཕྱག་རྒྱའོ།",
    "མཐེ་བོ་དང་མཛུབ་མོ་གཅིག་ཏུ་སྦྱར་ཏེ།",
    "ཕྱག་རྒྱ་དེ་ཉིད་ལས་གཡོན་པའི་མཛུབ་མོ་ཁུ་ཚུར་གྱི་ཚུལ་དུ་བཞག་པ་ལས་ཞགས་མིག་ལྟར་བྱས་པ་ནི་ཆུ་ལྷའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "གཡོན་པའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་བརྐྱང་བ་ནི་སླར་བཏང་བའི་ཕྱག་རྒྱའོ།",
    "ལག་པ་གཡོན་པ་ཁུ་ཚུར་བཅངས་ཏེ་གུང་མོ་བསྒྲེང་བའི་ཚིགས་དང་པོར་མཛུབ་མོ་བཀུག་པའི་ཐོར་ཏོ་བཙུགས་ལ།",
    "ཀུ་བེ་ར་ལ་མངོན་དུ་བལྟས་ཏེ་འདུག་ནས་ལག་པ་གཉིས་ཐལ་མོ་སྦྱར་ལ་རྡོ་རྗེ་བཅིང་བ་ནང་དུ་བཟློག་སྟེ།",
    "གུང་མོ་གཉིས་རྡོ་རྗེ་ལྟར་བཀུག་སྟེ་གཡབ་པ་ནི་ཀུ་བེ་ར་སྤྱན་དྲངས་པའི་ཕྱག་རྒྱའོ།",
    "ཕྱག་རྒྱ་དེ་ཉིད་ལས་གུང་མོ་གཉིས་ནང་དུ་རྡོ་རྗེ་བཅིང་བའི་ཚུལ་དུ་བཞག་པ་ནི་ཀུ་བེ་རའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "སྤྱན་དྲངས་པའི་ཕྱག་རྒྱ་ལས་གུང་མོ་གཉིས་བརྐྱང་པ་ནི་སླར་བཏང་བའི་ཕྱག་རྒྱའོ།",
    "སྤྱན་དྲངས་པའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་བརྐྱང་བ་ནི་སླར་བཏང་བའི་ཕྱག་རྒྱའོ།",
    "ལག་པ་ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་ཏེ་བཞག་ལ།",
    "སྟེང་དུ་བལྟས་ཏེ་མཛུབ་མོ་གཉིས་ཀྱི་ལྕགས་ཀྱུས་ནི།",
    "དེ་ཉིད་ལས་མཛུབ་མོ་གཉིས་སྔ་མ་ལྟར་བཞག་པ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "སྤྱན་དྲངས་པའི་ཕྱག་རྒྱ་ལས་མཛུབ་མོ་གཉིས་བརྐྱང་བ་ནི་སླར་བཏང་བའི་ཕྱག་རྒྱའོ།",
    "སོར་མོ་རྣམས་མཚམས་མེད་པར་རྩེ་མོ་ཕན་ཚུན་སྦྱར།",
    "འོག་ཏུ་བལྟས་ཏེ་སའི་ལྷ་ལ་སོགས་པ་མཛུབ་མོ་ལྕགས་ཀྱུས་སྤྱན་དྲང་བ་ནི་འོག་གི་ལྷ་སྤྱན་དྲངས་པའི་ཕྱག་རྒྱའོ།",
    "སྤྱན་དྲངས་པའི་ཕྱག་རྒྱ་ལས་སྔ་མ་བཞིན་དུ་མཛུབ་མོ་བཞག་པ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "མཛུབ་མོ་གཉིས་བཏང་བ་ནི་སླར་བཏང་བའི་ཕྱག་རྒྱའོ།",
    "སྔགས་ནི་ཨ་དྷོ་པྲི་ཐི་བྷྱ་སྭཱ་ཧཱ་ཨ་སུ་རེ་བྷྱ་སྭཱ་ཧཱ།",
    "བདག་གིས་པུས་མོ་ས་ལ་བཙུགས་ནས་སུ།",
    "སྟེང་གི་ཉི་ཟླ་ཚངས་པ་ཆེན་པོ་དང་།",
    "རང་གི་བུ་སྨད་མཛའ་བཤེས་གཉེན་འདུན་དང་།",
    "བདག་གི་ལས་འདི་འབྲས་བུ་མཆིས་པར་མཛོད།",
    "གནས་པའི་ལས་ཐམས་ཅད་པའི་ཐབ་ཁུང་གི་དབུས་སུ་དཔལ་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཐམས་ཅད་ཀྱི་སྔགས་ཟློས་ཤིང་མེ་ཏོག་གིས་བཞུགས་སུ་གསོལ་ལ།",
    "སྦྱིན་སྲེག་གི་ཆོ་གས་དཔལ་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་སྔགས་ཀྱིས་པའི་མར་ལས་སྦྱིན་བླུགས་བརྒྱ་རྩ་བརྒྱད་དབུལ་ལོ།",
    "དེ་ནས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་མེ་ཐབ་ལས་མེ་ཏོག་གིས་སྤྱན་དྲངས་ཏེ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་སྔགས་ཀྱིས་བྲིས་པའི་དཀྱིལ་འཁོར་དུ་རང་རང་གི་གནས་སུ་བཞུགས་སུ་གསོལ་བར་བྱའོ།",
    "དེ་དག་གིས་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་འདིར་ཞུགས་ཏེ་མཐོང་ན་ངན་སོང་ཐམས་ཅད་དང་བྲལ་བར་འགྱུར་རོ།",
    "གླུ་དང་གད་མོ་དང་།",
    "རྩེད་མོ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དཀྱིལ་འཁོར་རེ་བ་ཐམས་ཅད་ཡང་དག་པར་འགྱུར་བ་བླ་ན་མེད་པའི་དགའ་བ་དང་།",
    "རངས་པར་འགྱུར་བ་དེར་ནི་བསླབ་པའི་ཚིག་གིས་འཇིགས་ཤིང་སྐྲག་ནས་མི་འཇུག་པ་དག་ཀྱང་མཆིས་ཏེ།",
    "དེ་དག་ངན་སོང་གི་དཀྱིལ་འཁོར་གྱི་ལམ་དུ་འཇུག་པར་ཁ་བལྟས་ཤིང་གནས་པ་རྣམས་ཀྱང་དགའ་བ་དང་།",
    "ངན་སོང་གི་རྒྱུད་ཐམས་ཅད་དུ་ཁ་བལྟས་པའི་ལམ་ལས་བཟློག་པར་བགྱི་བའི་སླད་དུ།",
    "ཉོན་མོངས་པ་དག་ཀྱང་མཆིས་ཏེ།",
    "དགེ་སྦྱོང་ངམ་དགེ་སློང་གི་སྡོམ་པ་ཡོངས་སུ་བླངས་ལ།",
    "དགའ་ཆེན་ཁྱོད་བདག་སྟོན་པ་བས།",
    "སློབ་དཔོན་ཁྱོད་ནི་དགོངས་སུ་གསོལ།",
    "བདག་ཉིད་ཆེན་པོ་ཁྱོད་འདོད་དམ།",
    "བློ་ཆེན་ཁྱོད་ཀྱིས་གཟུང་བར་གྱིས།",
    "ཉིན་དང་མཚན་མོ་ལན་གསུམ་དུ།",
    "ཉིན་དང་མཚན་མོ་ལན་གསུམ་དུ།",
    "ཉིན་རེ་ཞིང་ནི་བཟླ་བར་བྱ།",
    "ཁྱོད་ཀྱིས་སྲོག་ཆགས་གསད་མི་བྱ།",
    "ངག་གི་རྣམ་པ་བཞི་རྣམས་དང་།",
    "ཁྱོད་ཀྱིས་བརྙས་པར་མི་བྱ་ཞིང་།",
    "ཁྱོད་ཀྱིས་རྟག་ཏུ་བསྲུང་བར་བྱ།",
    "དེང་ཁྱོད་ཅེས་བྱ་བ་ལ་སོགས་པ་བརྗོད་པར་མི་བྱ་སྟེ།",
    "ནུབ་ཕྱོགས་ནས་ལྕགས་སྒྲོག་གིས་བསྡམ་པར་བྱའོ།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་སུ་ཞུགས་ཀྱིས།",
    "ངས་ཁྱོད་ལ་ཡེ་ཤེས་གང་གིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་འགྲུབ་པ་ཡང་ཐོབ་ན་དངོས་གྲུབ་གཞན་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཏེ།",
    "ཁྱོད་ཀྱིས་དཀྱིལ་འཁོར་ཆེན་པོ་མ་མཐོང་བ་རྣམས་ལ་སྨྲ་བར་མ་བྱེད་ཅིག།",
