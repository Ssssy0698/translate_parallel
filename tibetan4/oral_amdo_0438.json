    "དམ་ཚིག་གི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་སྒོ་བཅད་དེ།",
    "ལྷ་ལྷག་མ་རྣམས་ཀྱི་གནས་སུ་ནི་དཀྱིལ་འཁོར་ཟླུམ་པོར་བྱ་ཞིང་རང་རང་གི་སྔགས་ལན་བདུན་བདུན་བཟླས་པར་བྱའོ།",
    "དེ་ནས་ཕྱི་རོལ་དུ་གཏོར་མ་བྱིན་ལ་ཉེ་རེག་བྱས་ནས།",
    "སྒེག་མོ་ལ་སོགས་པའི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་ཀྱང་ཡང་དག་པར་མཆོད་ནས།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་ཕྱག་རྒྱས་ཡོངས་སུ་བཟུང་བའི་རྡོ་རྗེ་དང་མེ་ཏོག་གི་ལྕུག་མ་ལས་ཨོཾ་བཛྲ་ཡཀྵ་ཧཱུཾ་ཞེས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ནས་མེ་ཏོག་གིས་སིལ་མར་གཏོར་ནས་སྤོས་ཀྱང་གཏུལ་བར་བྱའོ།",
    "མཱ་མ་ཀཱི་ལ་རེ་རེ་ཞིང་མར་ལ་སོགས་པའི་རྫས་ལས་བརྒྱ་རྩ་བརྒྱད་དབུལ་བར་བྱའོ།",
    "ལྷག་པར་གནས་པའི་སྦྱིན་སྲེག་གི་ཆོ་གའོ།",
    "དེ་ལ་རེ་ཞིག་དང་པོར་ལེགས་པར་ཁྲུས་བྱས་ལ།",
    "དགའ་ཆེན་ཁྱོད་བདག་སྟོན་པ་བས།",
    "སློབ་དཔོན་ཁྱོད་ནི་དགོངས་སུ་གསོལ།",
    "རང་གི་སེམས་ནི་དག་པར་བྱ་བའི་ཕྱིར།",
    "བདག་གིས་ལོག་པའི་བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་གཏང་བར་བགྱིའོ།",
    "བདག་གིས་མ་ཡེངས་པའི་སེམས་དང་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་སེམས་ཀྱིས་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ལ་བསླབ་པར་བགྱིའོ།",
    "དཀར་པོ་དྲི་ཞིམ་པོས་བསྒོས་པས་སྲད་བུ་སོ་སོར་ཁ་བསྒྱུར་ལ་གོ་རིམས་འདི་ཉིད་ཀྱིས་བཞག་ནས་ཧཱུཾ་ཧྲཱཾ་ཧྲཱི་ཨ་ཨཱ་ཞེས་བྱ་བ་རང་གི་ས་བོན་འདི་ལས་བྱུང་བའི་ཐིག་གི་འོད་ཟེར་གྱིས་མི་བསྐྱོད་པ་ལ་སོགས་པ་རང་རང་གི་ཕྱོགས་ན་བཞུགས་པར་ཡང་དག་པར་བཏང་བ་དང་།",
    "འབར་བའི་ལྕགས་ཀྱུས་དྲངས་ཏེ་རང་གི་ལག་ན་གནས་པའི་སྲད་བུ་ལེགས་པར་དགང་བར་བྱ་ཞིང་།",
    "མེ་ཏོག་གིས་མཆོད་དེ་རྡོ་རྗེ་བསྡམས་པས་བཟུང་ལ་ཐིག་གདབ་པའི་སྔགས་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "ཛ་ཞེས་བྱ་བས་སྒྲུབ་པའི་གྲོགས་མཆོག་གི་ལག་དུ་སྲད་བུ་དེ་བཏང་ལ།",
    "སྲད་བུ་དང་པོ་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་བཟུང་ལ་ཕྱིས་ནི་ཅི་བདེར་བྱ་ཞིང་ཕྱོགས་ཐམས་ཅད་མཉམ་པ་ཉིད་དུ་བསམ་མོ།",
    "གལ་ཏེ་བགེགས་ཟློག་པར་བྱེད་འདོད་པར་གྱུར་ན་སེང་ལྡེང་གི་ཕུར་བུ་སྟོད་རྡོ་རྗེ་རྩེ་ལྔ་པའི་རྣམ་པ་ལ།",
    "འོད་ཀྱི་དཀྱིལ་འཁོར་དེར་གྲོག་མཁར་གྱི་ས་ལ་སོགས་པས་བགེགས་ཀྱི་གཟུགས་བརྙན་བྱས་ནས་བརྒྱ་བྱིན་གྱི་གཟུགས་བརྙན་རང་གི་ཕྱོགས་ན་གནས་པ་ལ་ཨི་ལས་བརྒྱ་བྱིན་སེར་པོ།",
    "ཐིག་ལེ་རེ་རེ་ཞིང་ཡང་ནང་དུ་ཆུད་པར་བྱས་ལ།",
    "འཕགས་པ་མི་གཡོ་བས་བཀུག་ནས་ཞགས་པས་བཅིངས་པར་གྱུར་པར་བསམ་མོ།",
    "དབུས་སུ་ཡི་གེ་ཧཱུཾ་གི་ས་བོན་ལས་བྱུང་བའི་རྡོ་རྗེ་རྩེ་ལྔ་པ་མཚམས་རྣམས་སུ་མདུང་རྩེ་རྣམ་པར་བསམས་ལ།",
    "དེའི་མོད་ལ་མྱུར་དུ་ཚིག།",
    "མདུང་ཐུང་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "མཛུབ་མོ་གཉིས་ནང་སྦྱར་བ་ནི་མདུང་ཐུང་གི་ཕྱག་རྒྱའོ།",
    "ཡང་ན་མངོན་སྤྱོད་ཀྱི་སྦྱིན་སྲེག་གིས་བགེགས་རྣམས་བཟློག་པར་བྱའོ།",
    "མཛུབ་མོའི་རྩེ་མོ་མཉམ་སྦྱར་བ།",
    "ཧི་ཞེས་བྱ་བ་དང་རྡོ་རྗེ་ཉི་མའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་མཐར་སྤར་བར་བྱའོ།",
    "མིག་གི་རྫི་མ་འགུགས་བྱེད་པ།",
    "ཡིད་ཀྱིས་རི་མོ་བཏེག་ནས་ནི།",
    "ཨོཾ་སརྦ་སཾ་སྐཱ་ར་པ་རི་ཤུདྡྷ་དྷརྨ་ཏེ་མ་ཧཱ་ན་ཡ་པ་རི་བཱ་རེ་སྭཱ་ཧཱ།",
    "ཁྱབ་འཇུག་ལ་སོགས་པ་འདི་དག་ཐམས་ཅད་འཇིག་རྟེན་ལས་འདས་པའི་ལྷ་རྣམས་ཀྱི་སྐུའི་ཕྱེད་ཀྱི་ཚད་ཙམ་དུ་ཐམས་ཅད་ཁྱམས་ལ་བརྟེན་པར་བྱའོ་ཞེས་རྡོ་རྗེ་རྩེ་མོ་ལས་གསུངས་པ་ཡིན་ནོ།",
    "ཨོཾ་ཨ་མྲྀ་ཏེ་སརྦ་དུ་ཥྚཱཾ་གྲྀ་ཧྣ་བནྡྷ་ན་ཧ་ན་པ་ཙ་བིདྷྭ་ནྶ་ཡ་བི་ནཱ་ཤ་ཡ་ཚིནྡ་བྷེནྡ་བྷསྨི་ཀུ་རུ་མུརྟ་ན་ཧ་ད་ཡ།",
    "བཛྲེ་ཎ་ཡེ་ཀེ་ཙིཏ་མ་མ་ཨ་མུ་ཀ་སྱ་བི་གྷྣ་བི་ནཱ་ཡ་ཀ་སྟྭཾ་ད་མ་ཡ་དཱིཔྟ་ཀྲོ་དྷ་བཛྲི་ཎི་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་བཛྲ་ཨཱ་ཤ་ན་ནི་བྷ་ཀྵ་ཡ་སརྦ་དུ་ཥྚཱ་ན་བཛྲ་ད་ཤ་ནི་ཤཀྟི་ད་ར་ཎི་མ་ནུ་ཥ་མཱཾ་ས་ཨཱ་ཧ་རེ་ན།",
    "མཱཾ་ས་རུ་དྷིར་བྲི་ཡེ་ཨེ་ཧྱེ་ཧི་གྲྀ་ཧྞ་གྲྀ་ཧྞ་གྲྀཧྞ་བྷ་ཀྵ་ཡ་བཛྲ་ཌཱ་ཀི་ནི་བཛྲ་ཤཾ་ཀ་ལེ་སརྦ་དེ་བ་ག་ཎ་མ་ཏྲ་བྷཱུ་ཏེ་ཧ་ར་ཧ་ར་པྲཱ་ཎཱ་ན་ཨ་མུ་ཀ་སྱ་ཀ་པཱ་ལ་ཨ་ལཾ་ཀྲྀ་ཏ་སརྦ་ཀཱ་ཡེ་ཀི་ཉྩིར་ཡ་སི།",
    "ཤ་རཱི་རེ་ཤཱི་གྷྲཾ།",
    "ཀ་རེ་ཏོ་གརྦྷ་ཧཱ་རི་ཎཱ་ཡ་ཧི་ཤཱི་གྷྲཾ་ཨི་དཾ་ཨ་མུ་ཀ་སྱ་ཀུ་རུ་བཛྲ་ཤོ་དྷ་ནི་ཀ་ད་རི་ནི་སརྦ་ཀརྨ་ཎི་མེ།",
    "ཨོཾ་བཛྲ་མ་ཀ་རེ་གྲ་ས་ཤཱི་གྷྲཾ།",
    "དཔལ་མོ་དང་།",
    "རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་དང་།",
    "ཁྲོ་བོ་སྒེག་མོ་སྔོན་མོ།",
    "ཁྲོ་མོ་ཁུ་ཚུར་གཉིས་ཀྱིས་རྡོ་རྗེ་གཉིས་བསྣམས་ཏེ།",
    "ཆ་ལང་བརྡུང་བ་ལ་སོགས་པའི་ལྷ་མོ་བཞིས་བསྐོར་བ།",
    "མན་ཏ་ལི་ཀ་བརྡུང་བའི་ལྷ་མོ་བཞིས་བསྐོར་བ།",
    "མུ་ཀུན་ད་ཐོགས་པ་གནས་པའི་ལྷ་མོ་བཞིས་བསྐོར་ཏེ་གནས་པའོ།",
    "རུ་དུང་འབུད་པ་ལ་བརྩོན་པའི་ལྷ་མོ་བཞིས་བསྐོར་བ།",
    "ཕྱག་གཡོན་པ་མེ་ཏོག་གི་སྣོད་ཐོགས་ནས།",
    "གཡས་ཀྱིས་མེ་ཏོག་གི་ཆར་འབེབས་པ།",
