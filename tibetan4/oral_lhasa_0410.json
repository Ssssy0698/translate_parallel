    "ཚེ་དང་ལྡན་པ་ས་ག་དགེ་སློང་འགོག་པ་ལ་སྙོམས་པར་ཞུགས་པ་ལས་ལངས་པ་ན་དང་པོ་ཉིད་དུ་ཡིད་ཀྱི་འདུ་བྱེད་སྐྱེ་བར་འགྱུར་རོ།",
    "འཕགས་མ་དགེ་སློང་འགོག་པ་ལས་ལངས་པ་སེམས་ཞིང་ལ་གཞོལ་ཞིང་ཞིང་ལ་འབབ་པ་དང་གང་ལ་བབ་པར་འགྱུར།",
    "དབེན་པ་ལ་བབ་པར་འགྱུར་རོ།",
    "མྱ་ངན་ལས་འདས་པ་ལ་བབ་པར་འགྱུར་རོ།",
    "ཚེ་དང་ལྡན་པ་ས་ག་དྲི་བ་འདི་ནི་ཐོག་མ་ཉིད་དུ་དྲི་བར་བྱ་བ་དང་ད་ལྟར་བྱས་ཀྱང་ལུང་བསྟན་པར་བྱའོ།",
    "འཕགས་མ་བདེ་བའི་ཚོར་བ་ལ་གང་ཞིག་རྒྱས་པར་འགྱུར།",
    "སྡུག་བསྔལ་གྱི་ཚོར་བ་ལ་གང་ཞིག་རྒྱས་པར་འགྱུར།",
    "བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་ལ་གང་ཞིག་རྒྱས་པར་འགྱུར།",
    "ཚེ་དང་ལྡན་པ་ས་ག་བདེ་བའི་ཚོར་བ་ལ་འདོད་ཆགས་རྒྱས་པར་འགྱུར་རོ།",
    "སྡུག་བསྔལ་གྱི་ཚོར་བ་ལ་ཞེ་སྡང་རྒྱས་པར་འགྱུར་རོ།",
    "བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་ལ་གཏི་མུག་རྒྱས་པར་འགྱུར་རོ།",
    "འཕགས་མ་བདེ་བའི་ཚོར་བ་ཐམས་ཅད་ལ་འདོད་ཆགས་རྒྱས་པར་འགྱུར་རམ།",
    "སྡུག་བསྔལ་གྱི་ཚོར་བ་ཐམས་ཅད་ལ་ཞེ་སྡང་རྒྱས་པར་འགྱུར་རམ།",
    "བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་ཐམས་ཅད་ལ་གཏི་མུག་རྒྱས་པར་འགྱུར་རམ།",
    "བདེ་བའི་ཚོར་བ་གང་ལ་འདོད་ཆགས་རྒྱས་པར་མི་འགྱུར་ཞིང་སྤོང་བར་འགྱུར་བ་ཡོད་ལ།",
    "སྡུག་བསྔལ་གྱི་ཚོར་བ་གང་ལ་ཞེ་སྡང་རྒྱས་པར་མི་འགྱུར་ཞིང་སྤོང་བར་འགྱུར་བ་ཡོད་ལ།",
    "བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་ལ་གཏི་མུག་རྒྱས་པར་མི་འགྱུར་ཞིང་སྤོང་བར་འགྱུར་བ་ཡང་ཡོད་དོ།",
    "འཕགས་མ་བདེ་བའི་ཚོར་བ་འདོད་ཆགས་རྒྱས་པར་མི་འགྱུར་ཞིང་སྤོང་བར་འགྱུར་བ་གང་།",
    "འདི་ནི་བདེ་བའི་ཚོར་བ་ལ་འདོད་ཆགས་རྒྱས་པར་མི་འགྱུར་ཞིང་སྤོང་བར་འགྱུར་བ་ཞེས་བྱའོ།",
    "འཕགས་མ་སྡུག་བསྔལ་གྱི་ཚོར་བ་ལ་ཞེ་སྡང་རྒྱས་པར་མི་འགྱུར་ཞིང་སྤོང་བར་འགྱུར་བ་གང་།",
    "ཡིད་མི་བདེ་བ་འདི་ནི་སྡུག་བསྔལ་གྱི་ཚོར་བ་ཞེ་སྡང་རྒྱས་པར་མི་འགྱུར་ཞིང་སྤོང་བར་འགྱུར་བ་ཞེས་བྱའོ།",
    "འཕགས་མ་བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་ལ་གཏི་མུག་རྒྱས་པར་མི་འགྱུར་ཞིང་སྤོང་བར་འགྱུར་བ་གང་ཞེ་ན།",
    "འདི་ནི་བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བ་ལ་གཏི་མུག་རྒྱས་པར་མི་འགྱུར་ཞིང་སྤོང་བར་འགྱུར་བ་ཞེས་བྱའོ།",
    "འཕགས་མ་བདེ་བའི་ཚོར་བ་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་གང་།",
    "སྡུག་བསྔལ་གྱི་ཚོར་བའི་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་གང་།",
    "བདེ་བ་དང་སྡུག་བསྔལ་གྱི་ཚོར་བའི་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་གང་།",
    "བདེ་བ་ཡང་མ་ཡིན་སྡུག་བསྔལ་བ་ཡང་མ་ཡིན་པའི་ཚོར་བའི་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་གང་།",
    "མ་རིག་པའི་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་གང་།",
    "རིག་པའི་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་གང་།",
    "འཕགས་མ་མྱ་ངན་ལས་འདས་པའི་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་གང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་དྲུང་དུ་མྱ་ངན་ལས་འདས་པར་འགྲོ་བ་དང་།",
    "མྱ་ངན་ལས་འདས་པའི་མཐར་འགྱུར་བ་སྡུག་བསྔལ་ཟད་པར་འགྱུར་བ་ཡང་དག་པའི་ཚངས་པར་སྤྱོད་པ་སྤྱད་པར་བྱའོ།",
    "ངས་འདི་ལྟ་བུ་རྣམ་པར་ཤེས་སོ་ཞེས་ཐོས་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་དོན་ལས་བརྩམས་ཏེ་གཏམ་བརྗོད་ཅིང་སྨྲ་བ་སྟེ།",
    "རྣམ་པར་ཤེས་པའི་དོན་ལས་བརྩམས་ཏེ་གཏམ་བརྗོད་ཅིང་སྨྲ་བའོ།",
    "བདེ་བར་གཤེགས་པས་དེ་སྐད་གསུངས་ཏེ།",
    "འཆད་པར་བྱེད་འདིར་རབ་ཏུ་གནས།",
    "སྲིད་པར་སྐྱེ་དང་འཆི་བའི་ཕ་རོལ་འགྲོ།",
    "རྣམ་པར་ཤེས་པ་གང་ཅུང་ཟད་འདས་པ་དང་།",
    "ཐམས་ཅད་གཅིག་ཏུ་བསྡུས་ནས་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་ཞེས་བྱ་བའི་གྲངས་སུ་འགྲོ་སྟེ།",
    "རྣམ་པར་ཤེས་པ་འདས་པ་དང་།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་།",
    "ལྕེ་དང་ལུས་ཀྱང་བརྗོད་པར་བྱའོ།",
    "སེམས་དང་ཡིད་དང་རྣམ་པར་ཤེས་པ་ནི་གཟུགས་ཅན་མ་ཡིན་པ་བསྟན་དུ་མེད་ཅིང་ཐོགས་པ་མེད་པའོ།",
    "རྒྱས་པར་ནི་རྣམ་པར་མ་ཕྱེ་ན།",
    "བཙུན་པ་ཇི་ལྟར་ན་གཟུགས་ཕྱིའི་སྐྱེ་མཆེད་ལགས།",
    "རྒྱས་པར་ནི་རྣམ་པར་མ་ཕྱེ་ན།",
    "རྒྱས་པར་ནི་རྣམ་པར་མ་ཕྱེ་ན།",
    "གཞན་གཉིས་བསྟན་པར་བྱའོ་ཞེས་པ་ནི་ཚིག་ཙམ་དུ་ཟད་ཅིང་དྲི་བའི་ལན་ཡོངས་སུ་མི་ཤེས་པ་ཡིན་ཞིང་སླར་ལ་ཀུན་ཏུ་རྨོངས་པ་སྐྱེས་པ་དང་ཡང་དག་པའི་ཡུལ་ཅན་མ་ཡིན་པ་སྟེ།",
    "འདུ་བྱེད་ནི་སྟོང་པ་ཞེས་སེམས་ཀྱིས་རྣམ་པར་ཤེས་ཤིང་འདུ་ཤེས་ནས་ཡང་དག་པར་དགའ་བ་སྐྱེ་སྟེ།",
    "སྐྱེས་བུ་མིག་དང་ལྡན་པ་མར་མེ་ཐོགས་ཏེ་ཁང་པ་སྟོང་པའི་ནང་དུ་ཞུགས་ན་དེར་སྟོང་ཞིང་སྟོང་པར་མཐོང་བར་འགྱུར་བ་དེ་བཞིན་དུ་དགེ་སློང་འདུ་བྱེད་རྣམས་སྟོང་ངོ།",
    "འདུ་བྱེད་རྣམས་སྟོང་ངོ་ཞེས་སེམས་ཀྱིས་ཤེས་ཤིང་འདུ་ཤེས་པ་ན་སེམས་ཡང་དག་པར་དགའ་བ་སྐྱེ་སྟེ།",
