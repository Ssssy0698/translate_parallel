    "གཉིས་པ་གནོད་བྱ་ལྡོག་དུས་ནི་གནོད་བྱེད་སྟོབས་ཆེན་མྱུར་དུ་ལྡོག་སྟེ་སྐད་ཅིག་དང་པོ་ལ་འུ་ཡུག་ཕྲད་གཉིས་པ་ལ་གནོད་བྱ་ནུས་མེད་དུ་སོང་ནས་གསུམ་པ་ལ་ལྡོག་པ་ཡང་སྲིད་པས་སོ།",
    "གང་ཞིག་གང་གི་རང་བཞིན་ཡིན་པས་དབེན་པའོ།",
    "སྔོན་པོ་དེ་ཉིད་འགྱུར་བ་མེད་པའི་རྟག་པར་འདོད་ན་དེ་ནི་མངོན་སུམ་མམ་རྗེས་དཔག་གིས་ཁེགས་སོ།",
    "བདེན་མོད་ཀྱི་འོན་ཀྱང་ཡུལ་གྱི་སྒོ་ནས་ཕྱེ་བ་ཡིན་ཏེ།",
    "རྟགས་སུ་མི་རུང་བས་སྣང་རུང་གི་རྒྱུ་དང་བཅུ་གསུམ་འབྲས་བུ་བཀག་པ་གཉིས་སོ།",
    "གྲོང་རེག་ལ་སོགས་པ་ནི་སྒྲུབ་པ་རྟགས་སུ་བཀོད་པའི་ཕྱིར་མ་དམིགས་པའི་རྟགས་སུ་མི་རུང་ཞེ་ན་མ་ཡིན་ཏེ་རྟགས་དང་དགག་བྱ་འགལ་བར་ངེས་པ་སྣང་རུང་མ་དམིགས་པ་ལ་རག་ལས་པའི་ཕྱིར་ཨཱདང་དེ་དག་གྲུབ་པས་དགག་བྱ་མེད་པར་རྟོགས་པའི་ཡང་ཕྱིར་རོ།",
    "འགལ་དང་འབྲས་བུ་དག་གྲུབ་ཅེས་པ་གྲང་རེག་འགོག་པ་ལ་མེ་དང་དུ་བ་རྟགས་སུ་བཀོད་པ་གཉིས་འུ་ཡུག་དང་།",
    "རྒྱུ་དང་ངོ་བོ་བལྟར་རུང་བའི་ཞེས་པ་འགའ་ཞིག་ཏུ་སྣང་རུང་གི་མེ་བཀག་ནས་དུ་བ་འགོག་པ་དང་།",
    "དེ་དག་ལ་རྒྱས་པར་ཕྱེ་ན་འདི་ན་བ་མོའི་རེག་པ་མེད་དེ།",
    "སྐྱེས་བུ་འདི་ལ་སྤུ་ལོང་གི་ཁྱད་པར་མེད་དེ་མེའི་ཁྱད་པར་ཉེ་བའི་ཕྱིར་ཞེས་པ་དང་།",
    "ཕྱོགས་འདི་ན་སྤུ་ལོང་གི་ཁྱད་པར་དང་ལྡན་འགྲེལ་པའི་མེ་མེད་དེ་དུ་བ་ཡོད་པའི་ཕྱིར།",
    "དང་པོ་འགལ་པའི་རྒྱུ་དམིགས་པ་རྟགས་སུ་ཐལ་བ་སྤང་བ་ནི།",
    "མེའི་རྒྱུ་ཙམ་གྱིས་གྲང་རེག་མི་ཁེགས་ཏེ།",
    "དེ་ནི་གྲང་རེག་གི་རྒྱུ་དང་ངོ་བོ་གཉིས་ཀ་དང་མི་འགལ་བའི་ཕྱིར་ཏེ་ཤིང་གིས་གྲང་རེག་འགོག་པ་ལྟ་ང་།",
    "གཉིས་པ་འགལ་འབྲས་རྟགས་སུ་མི་རུང་བར་ཐལ་བ་སྤང་བ་ནི།",
    "དུ་བས་ཀྱང་གྲང་རེག་ལ་སོགས་པ་མི་ཁེགས་པར་འགྱུར་ཏེ་དུ་བའི་ངོ་བོ་དང་གྲང་རེག་ལ་སོགས་པ་མི་འགལ་ཞིང་དེ་དག་དང་འགལ་བའི་མེའང་སྒྲུབ་མི་ནུས་ཏེ་ད་ལྟ་མེ་མེད་པའི་དུ་བའང་སྲིད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེ་ལས་གཞན་དུ་ན་འཁྲུལ་པར་འགྱུར་ཏེ་མེའི་འབྲས་བུ་བཅུ་བཞི་ཐལ་བས་མེ་གྲང་བ་སྒྲུབ་པ་བཞིན་ནོ།",
    "དབྱེ་བ་ལ་རྩོད་པ་སྤང་བ་ལ་གཉིས་ལས་དང་པོ་རྒྱུ་ཚོགས་པས་འབྲས་བུ་དཔོག་པ་རྟགས་མིན་པར་ཐལ་བ་སྤང་བ་ནི།",
    "གཉིས་པ་རོས་གཟུགས་རྟོགས་པ་རྟགས་མིན་པར་ཐལ་བ་སྤང་བ་ནི།",
    "ད་ལྟ་པའི་རོས་རང་རྒྱུ་རོ་སྔོན་དུ་སོང་བ་དཔག་པ་ན།",
    "དཔེར་ན་དུ་བས་མེ་དཔག་པས་དེ་ལ་ཡོད་པའི་བུད་ཤིང་གི་འགྱུར་བ་བསྐྱེད་པའི་ནུས་པའང་རྟོགས་པ་བཞིན་ནོ།",
    "རྒྱུ་གཅིག་གིས་རྐྱེན་སོ་སོ་ལ་ལྟོས་ནས་འབྲས་བུ་དུ་མ་བསྐྱེད་པ་མཐོང་བས་ས་བོན་གཅིག་ལ་ནུས་པ་གཅིག་དང་དུ་མ་གང་ཡོད་པ་རྟགས་ནའང་མི་འཐད་པའི་ཕྱིར་རོ།",
    "མི་བཞེད་ན་ཧ་ཅང་ཐལ་བས་དགག་པའོ།",
    "འཁྲུལ་པ་ཅན་ཐུན་མོང་གི་མ་ངེས་པ་དང་དེ་དང་མཐུན་པའི་ཡང་དག་པའི་ལྷག་ལྡན་དང་ཐུན་མོང་མ་ཡིན་པའི་མ་ངེས་པའི་གཉེན་པོར་ལྡོག་པ་ངེས་པར་བརྗོད་དོ།",
    "གཉིས་པ་མི་བཞེད་ན་ཧ་ཅང་ཐལ་བ་ལ་གཉིས།",
    "ཏེསློབ་དཔོན་ཉིད་ཀྱི་ལུང་ལ་བརྟེན་པའི་ཧ་ཅང་ཐལ་བ་དང་།",
    "རིགས་པས་ཐོབ་པའི་ཧ་ཅང་ཐལ་བའོ།",
    "ལྷག་ལྡན་འཁྲུལ་པ་མིན་པར་ཐལ་བ་དང་།",
    "ལྡོག་པ་ཅན་རྟགས་སུ་ཐལ་བ་དང་།",
    "ཐེ་ཚོམ་ཟ་བ་རྟགས་ཡིན་པ་མ་བཟློག་པར་ཐལ་བ་དང་།",
    "ཐུན་མོང་མ་ཡིན་པ་གཉིས་ཀ་འགོག་པའི་རྟགས་སུ་ཐལ་བ་དང་།",
    "མི་སྣང་བ་མ་དམིགས་པས་དགག་བྱ་འགོག་པ་རིགས་པར་ཐལ་བའོ།",
    "དང་པོ་ལ་གཉིས་ལས་དང་པོ་ཐལ་བ་དགོད་པ་ནི།",
    "གཉིས་པ་ཉེས་སྤོང་གི་ལན་དགག་པ་ནི།",
    "མཐོང་བ་བཀག་པས་མ་མཐོང་བ་མི་ངེས་ན་མི་མཐུན་ཕྱོགས་ལ་རྟགས་མེད་ཅེས་བརྗོད་པའི་ཚིག་གིས་ཀྱང་མཛོད་རྟགས་ཏེ་མེད་པ་ཁོ་ནར་ངེས་པ་མིན་ཏེ་དེས་ཀྱང་མཐོང་བ་བཀག་ཙམ་དེ་བརྗོད་པའི་ཕྱིར་རོ།",
    "ཐལ་བ་འདི་འདོད་པར་མི་ནུས་ཏེ་ལུང་རིགས་དང་འགལ་བའི་ཕྱིར་རོ།",
    "ལྡོག་པ་ཅན་ཞེས་པ་ནི་གསོན་ལུས་ལ་བདག་མེད་ན་སྲོག་མེད་འུ་ཡུག་པར་ཐལ།",
    "ཐལ་བ་འདི་འདོད་པར་མི་ནུས་ཏེ་ལྡོག་པ་མེད་པའི་ཕྱིར་རོ།",
    "སྒྲུབ་བྱེད་གང་གིས་མ་མཐོང་བས་མི་འགྲུབ་སྟེ་དེ་བལྟར་མི་རུང་བའི་ཕྱིར་རོ།",
    "རྟག་མི་རྟག་གཉིས་ཀ་རྣམ་པར་གཅོད་པར་ཐལ་ཏེ།",
    "འོན་རིགས་ཀྱང་འདིར་ནི་རྟག་པའང་དངོས་པོར་འདོད་པའི་ལྟ་བ་ལ་ལྟོས་ནས་ཐུན་མོང་མ་ཡིན་པ་ཞེས་བརྗོད་དེ།",
    "ཁོ་བོའི་ལུགས་ལ་མཉན་བྱ་དངོས་པོ་ཡིན་ཡང་དེས་རྟག་པའང་མི་མཛོད་ཁེགས་ཏེ་རྟག་པའང་མཉན་བྱ་དང་མིག་གིས་བཟུང་བྱ་ལ་སོགས་པའི་དངོས་པོར་འདོད་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་ཉེས་སྤོང་གི་ལན་དགག་པ་ནི།",
    "རེག་བྱ་སྣང་རུང་ཡིན་པས་མ་དམིགས་པས་ཁེགས་པར་ཐལ་བ་འདོད་ཅེ་ན།",
    "འོ་ན་དགག་གཞི་སྣང་རུང་གི་ས་ལ་སོགས་པ་ལ་འགོག་གམ་ཀུན་ལ་འགོག་དང་པོ་ལྟར་ན་རང་ཉིད་ལ་ཁེགས་ཀྱང་རང་ཉིད་ས་ལ་སོགས་པའི་སྤྱི་དགག་གཞིར་འདོད་པ་དང་འགལ་ལོ།",
    "གཉིས་པ་ལྟར་ན་མི་ཚད་ཁེགས་ཏེ་ས་སོགས་ཀུན་གྱི་རེག་བྱ་སྣང་དུ་མི་རུང་བའི་ཕྱིར་རོ།",
    "མི་འདྲ་སྟེ་འདིར་ནི་མཐོང་བ་ཡི་ས་ལ་མ་སོགས་པ་ལའང་རེག་བྱ་འཇམ་རྩུབ་དུ་མ་མཐོང་བའི་ཕྱིར་རོ།",
    "གཉིས་པ་རིགས་པས་ཐོབ་པའི་ཧ་ཅང་ཐལ་བ་ནི།",
    "དེ་དག་གིས་སློབ་དཔོན་མ་མཐོང་བ་ཙམ་གྱིས་ལྡོག་པ་བཞེད་པར་འདོད་པ་ལ་རང་གི་ལུང་དང་རིགས་པ་དང་འགལ་བར་བསྟན་ཏོ།",
    "སྲིད་ན་རྟག་པ་རྐྱེན་ལ་མི་ལྟོས་པས་བདེ་སྡུག་རྟག་ཏུ་དམིགས་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "མི་ལྟོས་ན་ཧ་ཅང་ཐལ་བའོ།",
    "འབྲེལ་བ་ཡོད་པ་དེ་ལྟར་མིན་ན་རྟ་མེད་ན་ཕྱུགས་ཀྱང་མེད་པར་ཐལ་ཅེས་པའོ།",
    "གཉིས་པ་རྗེས་འགྲོ་ལ་ཧ་ཅང་ཐལ་བ་ནི།",
    "དེ་བཞིན་ཞེས་པ་ཕྱུགས་ཡོད་ན་རྟའང་ཡོད་པར་ཐལ་ཞེས་པའོ།",
    "ཅི་སྟེ་ཞེ་མཛོད་ན་རང་བཞིན་དང་རྒྱུ་དེ་དག་མེད་ན་རང་བཞིན་ཅན་དང་འབྲས་བུ་དེ་དག་མེད་དོ་ཞེས་ངག་ཏུ་བརྗོད་པ་ལས་ཀྱང་ལྡོག་པ་དེ་རྟོགས་པའི་ཕྱིར་ཏེ་མོ་གཤམ་གྱི་བུ་ལ་མི་རྟག་པ་མེད་པས་བྱས་པ་མེད་ཅེས་བརྗོད་པས་ཀྱང་ལྡོག་པ་རྟོགས་པ་བཞིན་ནོ།",
    "དཔེ་ལ་དེ་དག་གི་འབྲེལ་པ་སྟོན་པ་དེ་ཉིད་ཀྱི་ཕྱིར།",
    "དབྱེ་བ་ནི་དེ་དག་གི་དབྱེ་བའི་སྒོ་ནས་སོ།",
    "རྒྱུ་པའི་རྣམ་དང་ཁྱབ་བྱེད་དང་འགལ་བ་སྟེ་གསུམ་མོ།",
    "རང་ཉིད་ཡོད་ཙམ་དང་མ་འབྲེལ་ན་དེས་དེ་ལ་མ་ཁྱབ་པར་ཐལ་བ་དང་།",
    "དེ་། ལས་དེ་དོན་གཞན་དུ་ཐལ་བ་དང་།",
    "འོ་ན་ས་བོན་ལ་སོགས་པ་ཐམས་ཅད་ལས་འབྲས་བུ་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བ་དང་ཐམས་ཅད་དུས་གཅིག་ཏུ་སྐྱེ་འཇིག་བྱེད་པར་ཡང་འགྱུར་རོ།",
    "དེས་ན་རྒྱུ་གཉིས་ཡིན་ཏེ་ཡོད་པར་དམིགས་པ་ཞེས་པ་ནི་འཁྲུལ་པའི་རྒྱུ་ནང་གི་བདག་ཉིད་མུ་སྟེགས་ལ་ཡོད་པ་ཡིན་ཏེ།",
    "དེ་དག་གི་དོན་བསྡུ་བའོ།",
    "དེ་ལ་དང་པོ་མེ་དུ་གཉིས་ཀ་སྣང་རུང་གི་གཞི་ལ་དེ་དག་མ་དམིགས་པ་དགོས་ཏེ་དེས་དུ་བ་མེའི་སྔ་རོལ་ན་ཡོད་པ་དང་།",
    "གལ་ཏེ་སྣང་རུང་གི་གཞི་ལ་རྟ་བོང་གཉིས་ཀ་མ་དམིགས་པ་ལས་རྟ་དམིགས་ཏེ་དེ་ནས་བོང་བུ་དམིགས་པས་དེ་དག་རྒྱུ་འབྲས་སུ་འགྱུར་རོ་ཞེ་ན།",
    "གཉིས་པ་ལ་གསུམ་ལས་དང་པོ་ཐལ་བ་དགོད་པ་ནི།",
    "གསུམ་པ་དེ་དག་གི་དོན་བསྡུ་བ་ནི།",
    "དེ་དག་གི་ཁྱབ་པ་ནི་དུ་བའི་རྒྱུའི་རང་བཞིན་དུ་འགྱུར་བའི་མེ་ནི་དུ་བ་དེ་བསྐྱེད་པའི་ནུས་པ་ཡོད་པས་བྱེ་བྲག་སྟེ་མེ་མིན་ལས་ཁྱད་པར་དུ་བྱས་ཞེས་པའོ།",
    "དེས་ན་འབྲས་བུས་དཔག་པར་བྱ་བའི་རྒྱུའང་ཚོགས་པ་ཉིད་ཡིན་ནོ།",
    "འོ་ན་མེ་དང་བུད་ཤིང་གི་ཚོགས་པ་ལས་སྐྱེས་པའི་དུ་བ་དང་པོ་ནི་སྐད་ཅིག་ལས་མེད་པས་རྟགས་སུ་མི་རུང་ཉེར་ལྔ་ལ་དུ་བའི་རྒྱུ་ནི་དུ་བ་སྔ་མ་ལས་སྐྱེས་པའི་ཕྱིར་རྟགས་མི་སྲིད་པར་འགྱུར་ཞེ་ན།",
    "དེ་འུ་ཡུག་ལ་དམ་བཅའ་བའི་ཕྱོགས་གཅིག་རྟགས་སུ་ཐལ་བ་སྤང་བ་དང་།",
    "རང་གི་གཞན་ས་ལ་སྒྲུབ་པའི་ཕྱིར་འདིར་ཡང་བསྟན་ཏོ།",
    "དངོས་པོ་ཐམས་ཅད་རང་བཞིན་གྱིས་རང་རང་གི་ངོ་བོ་གཞན་དང་། མ་འདྲེས་པར་གནས་པའི་ཕྱིར་རོ།",
    "ཁ་ཅིག་ན་རེ་རྟགས་འདི་མ་གྲུབ་སྟེ་དངོས་པོ་ཐམས་ཅད་སྤྱི་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "སྒྲ་རྟོག་སྒྲུབ་པ་ལ་འཇུག་ན་དགག་སྒྲུབ་འུ་ཡུག་རིམ་གྱིས་རྟོགས་པ་མི་འཐད་ཅེས་སྟོན་པ་ལ་གསུམ་ལས་དང་པོ་ཐལ་བ་དགོད་པ་ནི།",
    "རང་གི་ངོ་བོ་ནི་དེའི་བྱས་པ་དང་འཇིག་པ་ལ་སོགས་པའོ།",
    "ཁ་ཅིག་ན་རེ།",
    "དང་པོ་དགག་པ་དངོས་ཚད་ནི་རྗེས་སུ་དཔག་པ་ལས་ཀྱང་དངོས་པོ་བསྒྲུབ་པས་འཛིན་པར་འདོད་ན་ཞེས་པའི་ཀྱང་གི་སྒྲ་ནི་མངོན་སུམ་དུ་མ་ཟད་ཅེས་པའོ།",
    "དེས་ན་ཁོ་བོ་ཅག་རྗེས་དཔག་སེལ་བས་འཇུག་པར་འདོད་པ་ལ་སྒྲོ་འདོགས་གཅིག་ཆོད་པས་འུ་ཡུག་ཐམས་ཅད་ཆོད་པའི་ཉེས་པ་འདིར་ཐལ་བར་མི་འགྱུར།",
    "ཁྱབ་པ་ལ་གུས་པར་མི་བྱེད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེ་ཕྱིར་ཞེས་པ་སྟེ་ཡུལ་ཅན་དུ་བསྒྲགས་ཞེས་དྲང་མཛོད་ངོ་། གང་གི་ཞེ་ན་སེལ་བའི་འོ།",
    "སེལ་བ་ལ་འཇུག་པ་མིན་པར་ཐལ་ཏེ།",
    "དངོས་པོ་གཅིག་གི་ཆ་ཤས་ལ་དེ་མིན་དུ་སྒྲོ་འདོགས་པ་སྟེ་བུམ་པའི་མི་རྟག་པ་ལ་རྟག་པར་འཛིན་པ་ལྟ་བུའོ།",
    "བཞི་པ་སྒྲུབ་པས་འཇུག་ན་ཧ་ཅང་ཐལ་བ་ནི།",
    "ཉེས་སྤོང་གི་ལན་དགག་པའོ།",
    "བྱེ་བྲག་པ་གང་གི་ལྟར་ན་འཛིན་ཞེས་དྲང་ངོ།",
    "གང་གིས་ཞེ་ན་རྟོག་པའི་བློས་སམ་སྒྲས་ཀྱང་ངོ།",
    "དེས་ན་སྒྲ་རྟོག་དངོས་པོ་འཛིན་ཡང་དེ་དག་ཅིག་ཅར་དུ་འཛིན་པར་ཐལ་བ་མེད་དེ་དེ་རྣམས་ཐ་དད་དུ་ཡོད་པའི་ཕྱིར་བུམ་སྣམ་བཞིན་ཞེས་ཟེར་རོ།",
    "འདི་དགག་པ་ལ་གསུམ་ལས་དང་པོ་ཐལ་བ་དགོད་པ་ནི།",
    "འདོད་ན་བློ་དེས་ཕན་གདགས་པར་བྱ་བའི་བྱེ་བྲག་སྟེ་ཁྱད་པར་མི་རྟག་པ་ཉིད་ལ་སོགས་པ་གང་མ་ངེས་ཏེ་ཀུན་ངེས་པར་ཐལ་ཏེ།",
    "ཁ་ཅིག་ན་རེ་ཁྱད་པར་ཅན་དེ་ཁྱད་པར་གཅིག་ལ་ཕན་འདོགས་བྱེད་དུ་བཟུང་ན་ཀུན་ལ་ཕན་འདོགས་བྱེད་དུ་བཟུང་བ་བདེན་ཏེ།",
    "གང་གི་ཚེ་ཞེ་ན་གཅིག་ཅེས་པ་སྟེ།",
    "དེ་ཁྱད་པར་གཅིག་ལ་ཕན་འདོགས་བྱེད་དུ་བཟུང་བའི་བློ་དེས་ཁྱད་པར་ཅན་དེ་ཁྱད་པར་ཐམས་ཅད་ལ་ཕན་འདོགས་བྱེད་དུ་བཟུང་བར་ཐལ་ཏེ།",
    "འོ་ན་ནུས་པ་དེ་དག་ནུས་པ་ཅན་དེའི་ཅི་ཡིན་ཞེས་པ་ནུས་པ་དང་ནུས་པ་ཅན་འབྲེལ་མེད་དུ་ཐལ་ཞེས་པའོ།",
    "གང་གི་ཚེ་འབྲེལ་མེད་དུ་འགྱུར་ཞེ་དུ།",
    "སྒྲ་རྟོག་ཐམ་གིས་མི་རྟག་པ་ལ་སོགས་པའི་ཁྱད་པར་ཁོ་ན་ལ་འཇུག་པས་རིམ་གྱིས་རྟོགས་སོ་ཞེ་ན།",
    "གསུམ་པ་ཉེས་སྤོང་གི་ལན་དགག་པ་ལ་གཉིས་ལས།",
    "གསུམ་པ་ངེས་པས་བཟུང་ཡང་མ་ངེས་ན་ཧ་ཅང་ཐལ་བ་ནི།",
    "ཇི་ལྟར་ངེས་པ་དེའི་ཡུལ་ཡིན་ཏེ་མིན་པར་ཐལ་ཏེ།",
    "བཞི་པ་ཐལ་བ་དེ་མངོན་སུམ་ལ་མི་འགྲེལ་སྒྱུ་མཚུངས་པའི་འཐད་པ་ལ་གཉིས་ལས།",
    "མངོན་སུམ་གྱིས་ཀྱང་སྐད་ཅིག་མ་བཟུང་བར་ཐལ་ཏེ།",
    "དཔེར་ན་བུད་མེད་ཀྱི་རོ་གཅིག་ལ་སྐྱེས་བུ་གསུམ་ལ་རྟོག་པ་གསུམ་སྐྱེ་བ་བཞིན་ནོ།",
    "གང་གིས་ཞེ་ན་རྣམ་དབྱེ་བརྒྱད་ཀྱི་ནང་ནས་ཐ་དད་དུ་འབྱེད་པའི་དྲུག་པའི་སྒྲ་ཡིས་སོ།",
    "འོ་ན་དེ་གཉིས་ཐ་རེ།",
    "གཉིས་པ་སྒྲ་ཐ་དད་དོན་མེད་དུ་ཐལ་བ་སྤང་བ་ལ་གཉིས་ལས།",
    "སྒྲ་གཉིས་མི་དགོས་པར་ཐལ་ཏེ་བརྗོད་བྱ་གཅིག་ལས་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "གང་གི་ཞེ་ན་སྒྲ་དེ་གཉིས་ཀྱི་བརྡའི་བྱེ་བྲག་སྟེ་ཐ་དད་དུ་འཇོག་པའི་འོ།",
    "ཅི་ཞེ་ན་འགྲེལ་རིགས་དེ་དང་ལྡན་པའི་རྫས་སྒྲས་བརྒྱུད་ནས་བརྗོད་པར་འདོད་པའི་ཕྱོགས་ལ་བརྗོད་པའི་སྐྱོན་གསུམ་མོ།",
    "དེ་གཉིས་ཐ་དད་ན་ཉེས་པ་གསུམ་དུ་འགྱུར་ཏེ་འདི་ལྟར་བ་ལང་གི་སྒྲས་བ་ལང་གི་སྤྱི་གོ་ལ་དེས་བརྒྱུད་ནས་གསལ་བའང་གོ་སྟེ་དེ་གཉིས་འབྲེལ་བའི་ཕྱིར་རོ་ཞེས་སོ།",
    "སྒྲ་འཇུག་པའི་ཡུལ་སྤྱི་ཡིན་པའི་ཕྱིར་གསལ་བ་ལ་ཡོད་པའི་ཁྱད་པར་དུ་མ་མ་བརྗོད་པར་འགྱུར་ལ་འདོད་ན་གཞི་མཐུན་མི་སྲིད་པར་ཐལ་བ་དང་།",
    "གང་ཞེ་ན་དངོས་པོ་ཐ་དད་མེད་པ་ལ་དྲུག་པའི་སྒྲ་སྦྱར་དུ་མི་རུང་བར་ཐལ་བ་དང་ཚིག་དབྱེ་བ་དང་སོགས་པ་སྟེ་དེའི་དངོས་པོ་དེ་ཉིད་ཅེས་པ་དེ་ལ་ཕན་པའི་རྐྱེན་སྦྱར་དུ་མི་རུང་བར་འགྱུར་ཏེ་མེ་དུ་བཞིན་དུ་དེ་དག་དངོས་པོ་ཐ་དད་ཁོ་ན་དང་འབྲེལ་བའི་ཕྱིར་རོ་ཞེས་པའོ།",
    "གཞན་ཡང་འོག་ཏུ་བཙུན་མོ་གཅིག་དང་སོགས་ཀྱིས་བསྡུས་པ་ཕྱི་མ་གཅིག་ལ་རྣམས་ཞེས་ཐ་དད་དེ་མང་པོའི་སྒྲར་བཞག་པ་ལ་རྒྱུ་ཅི་ཡོད་ཅེས་སྦྱར་རོ།",
    "དོན་ནི་དེ་ལ་མང་པོའི་སྒྲ་སྦྱར་དུ་སོ་གསུམ་མི་རུང་བར་ཐལ་ཞེས་པའོ།",
    "གལ་ཏེ་བུད་མེད་གཅིག་ལ་བུ་དང་དགའ་བ་བསྐྱེད་པ་ལ་སོགས་པ་ནུས་པ་དུ་མ་ཡོད་པས་ཞེ་ན།",
    "འོ་ན་གཅིག་གི་ཚིག་མི་སྲིད་པར་འགྱུར་ཏེ་དངོས་པོ་གཅིག་ཀྱང་རྐྱེན་ལ་ལྟོས་ནས་ནུས་པ་དུ་མར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཡང་གྲོང་དྲུག་ལ་ཁང་བཟངས་ཀྱི་ཕྲེང་ཞེས་དང་མེ་ཏོག་མང་པོ་ལ་དེའི་ཕྲེང་ཞེས་པ་ལ་སོགས་པ་ཐ་དད་ཡིན་པར་བཞག་པ་ལ་རྒྱུ་ཅི་ཡོད་ཅེས་པ་དེ་དག་ལ་གཅིག་གི་སྒྲ་སྦྱར་མི་རུང་བར་ཐལ་ཞེས་པའོ།",
    "ཅེས་པ་འདི་ལ་ཁ་ཅིག་ན་རེ་ནམ་མཁའི་རང་བཞིན་དང་ནམ་མཁའ་མ་ཉིད་ལ་ཐ་དད་མེད་པས་དེའི་དངོས་པོ་དེ་ཉིད་དོ་ཞེས་པ་ལྟར་དེ་ཕན་གྱི་རྐྱེན་ཡིན་ཞེས་ཟེར་རོ།",
    "འུ་ཡུག་ཡང་ཁ་ཅིག་ན་རེ་ནམ་མཁའི་ཞེས་པ་ལ་དེའི་རང་བཞིན་དང་དེའི་མཁའ་ཉིད་སྦྱར་བས་དྲུག་པའི་སྒྲ་ལན་གཉིས་བསྟན་པ་ཡིན་ཅེས་ཟེར་བ་ཡང་མིན་ཏེ་དེ་ལན་གཉིས་བསྟན་པ་ལ་དགོས་པ་མེད་པའི་ཕྱིར་རོ།",
    "གང་གིས་ཞེ་ན་བཙུན་མོ་རྣམས་ཞེས་པ་ལ་སོགས་པ་ཚིག་གང་སྨྲ་བ་སྟེ་བརྡ་འདོགས་པ་པོས་དོན་དེའི་རྗོད་བྱེད་ཉིད་དུ་ངེས་པར་བྱེད་ཅིང་བརྡ་སྦྱར་བ་དེས་སོ།",
    "སྒྲ་རྟོག་གི།",
    "གང་གིས་སྒྲིབ་ཅེ་ན་སྒྲིབ་བྱེད་ཀུན་རྫོབ་དེས་སོ།",
    "དེས་ཇི་ལྟར་སྒྲིབ་ཅེ་ན་རྣམ་པ་གཅིག་ཏུ་སྣང་བའི་བློ་གང་གིས་རང་གི་ངོ་བོ་སྐྱེས་པ་ཙམ་ཁོ་ན་ཡིས་གཞན་ཏེ་ཐ་དད་པ་སྒྲིབ་པར་བྱེད་དེ་མུན་པ་བཞིན་ནོ།",
    "དོན་བུམ་པ་ལ་སོགས་པའི་སྤྱི་མིན་པར་ཐལ་ཏེ།",
    "གང་གི་ཞེ་ན་འཁྲུལ་པ་འདིའི་འོ།",
    "ཐ་དད་དུ་འདྲ་ཡང་ཞོ་དང་རྒྱལ་མོ་ག་འུ་ཡུག་གོན་ལ་སོགས་པ་གཞན་གྱིས་མ་ཡིན་པ་བཞིན་ནོ།",
    "གཉིས་པ་སྒྲ་རྟོག་གི་འཇུག་ཚུལ་རྒྱས་པར་བསྟན་པ་ལ་གསུམ་སྟེ།",
    "འཇུག་ཚུལ་སྤྱིར་བསྟན་པ་རིགས་དང་བྱེ་བྲག་ཏུ་རྗེས་དཔག་གི་འཇུག་ཚུལ་ལ་རྩོད་པ་སྤང་བ་དང་།",
    "དེ་དག་གི་དོན་བསྡུ་བའོ།",
    "སྒྲ་རྟོག་གི་རང་བཞིན་དང་།",
    "དེ་དག་གི་དོན་བསྡུ་བའོ།",
    "ཤེས་ལ་ཞེས་པ་ནི་རྟོག་པའི་ཤེས་པ་ལ་ཡོད་པ་སྟེ་སྣང་བའི་དོན་བུམ་པའི་རྣམ་པ་དེ་རྣམས་ནི་ཐ་དད་ཡིན་པའི་སྤྱི་ལྟ་བུར་སྣང་བ་ཡིན་ཏེ་རིགས་མི་མཐུན་ལས་ལྡོག་པའི་ངོ་བོ་ཅན་དུ་སྣང་བ་དེས་ན་སྟེ་དེའི་ཕྱིར་འུ་ཡུག་རོ་། དེ་དག་ལོག་པར་བདེན་པ་ནི་མ་ཡིན་ཏེ་ཡིན་ན་དེ་བུམ་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "ཇི་ལྟ་བུ་ཞེ་ན་ནོར་བའི་དོན་ཅན་ཏེ་གཅིག་ལ་དུ་མ་དང་དུ་མ་ལ་གཅིག་དང་ཐ་དད་མེད་པ་ལ་ཐ་དད་དུ་འཛིན་པའི་ཕྱིར་རིགས་རོ་། གང་གིས་ཞེ་ན་ཤེས་པ་དང་བརྗོད་པ་ཡིས་ཞེས་སོ།",
    "ཤེས་བརྗོད་ཉིད་ཐ་སྙད་ཡིན་ཡང་དེའི་རྒྱས་བྱེད་དུ་བརྗོད་པ་ནི་དེ་དག་གི་ནུས་པ་བསྟན་པ་ཡིན་ཏེ།",
    "གང་གི་ལྡོག་པ་ཞེ་ན་བུམ་པ་ལ་སོགས་པའི་དངོས་པོ་རྣམས་ཀྱིའོ།",
    "གཉིས་པ་བསླུ་བར་བསྟན་པ་སོ་ནི་རྟག་འཛིན་དང་མི་རྟག་པར་འཛིན་པ་གཉིས་རང་གི་སྣང་བ་དོན་མ་ཡིན་པ་ལ་དོན་དུ་ཞེན་པའི་ཆ་ནས་འཁྲུལ་པར་འདྲ་ཡང་གཞན་རྟག་འཛིན་ལས་དེ་ཐོབ་པ་མིན་ཏེ་དེ་དངོས་པོ་ཙམ་དང་འབྲེལ་ཡང་རྟག་པ་དང་མ་འབྲེལ་བའི་ཕྱིར་རོ།",
    "གང་གིས་ཞེ་ན་བརྗོད་དང་ཤེས་པས་སོ།",
    "དངོས་པོ་ལ་མི་སྲིད་དེ་ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རིགས་རོ།",
    "འདི་དག་ལ་སྤྱི་གཅིག་གི་ཐ་སྙད་མི་སྲིད་དེ་རང་བཞིན་གྱིས་གཅིག་ཏུ་འདྲེས་པ་མེད་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་རྗེས་དཔག་གི་འཇུག་པ་ལ་རྩོད་པ་སྤང་བ་ལ་གཉིས་ལས་དང་པོ་རིགས་པ་དང་འགལ་བ་སྤང་འུ་ཡུག་བ་ནི།",
    "དུ་བ་ནི་སྒྲུབ་བྱེད་དོ་ཞེས་རྟོག་པའི་ཚེ་པའི་རྣམ་ན་ལའི་དངོས་པོ་མིག་གིས་མཐོང་བ་ཉམས་ནས་མེད་པའི་ཕྱིར་ལ་རང་མཚན་དང་བཅས་པ་བསྒྲུབ་བྱ་མིན་ནོ།",
    "ཁྱད་པར་ཞེས་པ་ལན་ཏེ་རྗེས་དཔག་གིས་ཁྱད་པར་སྤྱི་དང་འདྲེས་པ་ཞེས་པའི་ཚིག་འདི་ལ་ཁྱད་པར་གྱི་སྒྲ་དེ་རང་མཚན་དུ་བཟུང་བར་བྱ་བ་མིན་ནོ།",
    "འོ་ན་དེ་དག་གིས་གང་རྟོགས་ཞེ་ན་སྒྲ་རྟོག་གཉིས་པོ་སྤྱི་ཉིད་ལ་འཇུག་པའོ།",
    "བརྡ་དེ་ནི་ཕྱིས་ཐ་སྙད་ཀྱི་དུས་སུ་སྐྱེས་བུ་གཞན་གྱི་སྒྲ་ལ་བརྟེན་ནས་འཇུག་ལྡོག་གི་ཡུལ་རྟོགས་པའི་ཆེད་དུ་བྱས་པའོ།",
    "ཀྱང་གི་སྒྲ་ནི་དགོས་པ་སྔ་མ་བསྡུ་བའམ་ཡང་ན་ཁོ་ནར་བསྒྱུར་ལ་སྤངས་ཞེས་པའི་འོག་ཏུ་གཞུག་སྟེ་སྤངས་པ་ཁོ་ནས་ཞེས་བྱའོ།",
    "ཇི་ལྟར་ཞེས་པ་སྦྱར་བ་དོན་མེད་དུ་ཐལ་ཏེ་བུམ་སྒྲ་དེས་བུམ་མ་ཡིན་དེ་དག་རྣམས་ལས་བུམ་པ་འདི་མི་གཅོད་ཅེས་པ་ནི་བུམ་པ་ལ་ཡོད་པའི་གཞན་སེལ་མི་བརྗོད་པའི་ཕྱིར་ཞེས་པའོ།",
    "རང་གི་ངོ་བོའང་མེད་པར་འགྱུར་བ་དང་།",
    "གཅིག་གི་སྒྲ་བློ་འཇུག་པའི་ཕྱིར་རོ།",
    "སྔར་གྱི་བུམ་པ་དེ་ཉིད་འདི་ཡིན་ནོ་སྙམ་པའི་ངོ་ཤེས་པའི་བློ་མི་སྐྱེ་བར་ཐལ་ཏེ་གསལ་བ་རྣམས་ནི་ཐ་དད་ལ་སྤྱི་གཅིག་ཀྱང་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "གང་གིས་གཅིག་ཏུ་འཛིན་ཅེ་ན།",
    "ཞེས་པ་ནི་སྒྲ་ཀུན་ནས་སློང་བར་བྱེད་པའི་ཕྱིར་སྒྲ་སྟེ་ནང་གི་བརྗོད་པ་རྟོགས་པས་སོ།",
    "དེ་གང་གི་ཡུལ་ཅན་ཞེ་ན་དེ་ལས་ཞེས་པའོ།",
    "ཐལ་བ་དགོད་པ་དང་།",
    "ཉེས་སྤོང་གི་ལན་དགག་པའོ།",
    "གལ་ཏེ་སྐྱེ་ན་བློ་དེས་དུས་རྟག་ཏུ་སྤྱི་དེ་ཙམ་ཁོ་ན་ཤེས་པར་ཐལ་ཏེ།",
    "དེ་ཡང་འདོད་ན་དེ་ལ་ཇི་ལྟར་ཐ་སྙད་འདོགས་ཞེས་པ་གསལ་བ་དེ་ལ་རིགས་ལྡན་གྱི་ཐ་སྙད་མི་འཇུག་པར་ཐལ་ཞེས་པའོ།",
    "ཕན་འདོགས་པའི་སྤྱི་བཅས་དང་ཕན་མི་འདོགས་པའི་སྤྱི་བཅས་ཀྱིས་གཅིག་གི་བློ་སྐྱེད་པ་དགག་པའོ།",
    "གལ་ཏེ་སྤྱི་དངོས་པོ་གཅིག་གིས་ཕན་འདོགས་པའི་སྒོ་ནས་གྲོགས་བྱེད་པའི་གསལ་བ་རྣམས་གཅིག་ཏུ་འཛིན་པའི་ཤེས་པའི་རྒྱུ་ཡིན་ཞེ་ཞེ་ན་གཉིས་པ་ལན་ནི།",
    "འོ་ན་སྤྱི་དངོས་པོ་གཅིག་པོ་དེས་གསལ་བ་དེ་དག་གི་ཐ་དད་པ་ཉིད་སེལ་ཏམ་ཅི་ཞེས་པ་སེལ་ལམ་འོན་ཏེ་མི་སེལ།",
    "གཅིག་ཏུ་འཛིན་པའི་བློ་སྐྱེད་པ་ལ་ནུས་མེད་དུ་ཐལ་ཏེ།",
    "སྤྱི་གཅིག་གིས་བསྐྱེད་པར་བྱ་བའི་འབྲས་བུར་ཐལ་ཏེ་དེ་ཡོད་མེད་ཀྱི་རྗེས་སུ་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་གཅིག་ཏུ་འཛིན་པའི་བློ་དེ་གསལ་བ་ལས་མི་སྐྱེ་བ་དང་སྤྱི་ལས་སྐྱེ་བར་ཐལ་བ་གཉིས་ཡིན་ནོ།",
    "འོ་ན་སྔོན་པོ་ལ་སོགས་པའང་མིག་ཤེས་སྐྱེད་པ་ལ་ནུས་མེད་དུ་འགྱུར་ཏེ་རྐྱང་པ་དང་ཚོགས་པ་གཉིས་ཀ་འུ་ཡུག་ལ་ནུས་པ་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་སྔོན་པོ་མེད་ཀྱང་སེར་པོ་ལས་ཁ་དོག་འཛིན་པ་སྐྱེ་བའི་ཕྱིར་དང་ཁ་དོག་མང་པོ་ཡུལ་དུས་གཅིག་ཏུ་ཚོགས་པའི་ནང་ནས་གང་རུང་རེ་མེད་ཀྱང་ཚོགས་པ་ལྷག་མ་ལ་དམིགས་པའི་ཤེས་པ་སྐྱེ་བའི་ཕྱིར་ཞེ་ན་མིན་ཏེ་སྔོ་པའི་རྣམ་སོགས་ཞེས་པ་སྟེ་མཐོང་ཞེས་དྲང་ངོ།",
    "གང་གི་ཞེ་ན་མིག་གི་རྣམ་པར་ཤེས་པ་བསྐྱེད་པ་ལའོ།",
    "དེའི་ཕྱིར་ཁ་དོག་གི་ཚོགས་པ་ལའང་དེ་འཛིན་པའི་ཤེས་པ་བསྐྱེད་པའི་ནུས་པ་འགྲུབ་སྟེ་ཚོགས་པ་མེད་ན་དེ་འཛིན་པ་མི་སྐྱེ་བའི་ཕྱིར་རོ།",
    "འོ་ན་སྔོན་པོ་མེད་ཀྱང་སེར་པོ་ལ་སོགས་པ་དང་ཚོགས་པ་འཛིན་པ་མཐོང་ཞེ་ན།",
    "གསལ་བ་ལ་རྐྱང་པ་དང་ཚོགས་པ་ཇི་ལྟར་ཡང་རུང་སྟེ།",
    "སྔོན་པོ་ལ་སོགས་པའི་རྐྱང་པ་དང་ཚོགས་པས་ཤེས་པ་སྐྱེད་པ་དེ་ལྟར་གྲུབ་པ་མིན་ནོ།",
    "འདི་ལྟར་སྤྱི་མེད་ན་གསལ་བ་དུ་མས་ཀྱང་སྤྱི་འཛིན་པ་མཛོད་སྐྱེད་མི་ནུས་ལ་ཡོད་ན་གཅིག་གི་ཀྱང་ནུས་པའི་ཕྱིར་དང་།",
    "གསལ་བ་དུ་མའམ་གང་རུང་གིས་བསྐྱེད་པའི་སྤྱི་འཛིན་ཐ་དད་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་གསལ་བ་དེ་དག་གང་རུང་ཅུང་ཟད་ཅིག་ལ་ལྟོས་ནས་སྤྱི་དེས་སྤྱི་འཛིན་བསྐྱེད་པར་ནུས་ཀྱི་གསལ་བ་ཐམས་ཅད་དང་བྲལ་བའི་སྤྱི་འབའ་ཞིག་གིས་མིན་ཞེ་ན།",
    "གསལ་བས་བློ་གཅིག་ལའང་ཕན་འདོགས་པར་ཐལ་བ་དང་།",
    "དེ་དེའི་འབྲས་བུར་ཐལ་བ་དང་།",
    "ཉེས་སྤོང་གི་ལན་དགག་པའོ།",
    "དེ་ལའང་ནུས་པར་ཐལ་ཏེ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྐྱེ་ན་ཐ་དད་དུ་སྣང་བར་ཐལ་ཏེ་སྔོ་སེར་འཛིན་པ་བཞིན་ཞེ་ན།",
    "དེ་དག་ཅེས་པ་སྟེ་གསལ་བ་ཐ་དད་རྣམས་འབྲས་བུ་གཅིག་ཏུ་མི་འགྲུབ་སྟེ་བུམ་པ་དེ་དག་གི་འབྲས་བུ་ནི་བློ་བུམ་འཛིན་ཡིན་ལ་དེ་རིགས་ཡང་ཐ་དད་པའི་ཕྱིར་རོ།",
    "བུམ་འཛིན་གྱི་བློ་རིགས་གཅིག་གི་རྒྱུའི་དངོས་པོ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྒྲ་ནི་དོན་ལ་བསླུ་བར་ཐལ་ཏེ་སྒྲའི་དོན་ནི་རྟོག་པའི་ཡུལ་ཡིན་ལ་དེ་ནི་དངོས་པོར་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "སྒྲ་རྟོག་གཞན་དོན་མེད་པར་ཐལ་བ་སྤང་བ་དང་།",
    "གཞི་མཐུན་མི་སྲིད་པར་ཐལ་བ་སྤང་བའོ།",
    "རྟོག་པ་ཕན་ཚུན་བརྟེན་པར་ཐལ་ཏེ་ཤིང་མ་ཡིན་ལས་ལོག་པ་ཡིས་ཤིང་གི་དོན་འཛིན་ལ་ཤིང་ལས་ལོག་པས་ཤིང་མ་ཡིན་གྱི་དོན་འཛིན་དགོས་པའི་ཕྱིར་རོ།",
    "འདོད་ན་དེ་དག་གང་རུང་ཞེ་ལྔ་ཞིག་སྔོན་དུ་འཛིན་པ་མེད་པར་ཐལ་ལོ།",
    "དེ་དག་ཅེས་པ་སྤྱི་དངོས་པོར་གྱུར་པ་གཅིག་ལ་བརྡ་འདོགས་པར་འདོད་པ་དེ་དག་གི་ལྟར་ན་ཤིང་གི་བརྡ་འདོགས་པའི་ཚེ་ཤིང་མིན་རྣམས་པར་གཅོད་དམ་མི་གཅོད།",
    "གལ་ཏེ་ཤིང་མིན་རྣམ་པར་གཅོད་ཅེ་ན་ཤིང་འཛིན་པའི་གོང་དུ་ཤི་མིན་དེ་ཇི་ལྟར་ཤེས་ཏེ་མི་ཤེས་པར་ཐལ་ཏེ་དེའི་ཚེ་ཤིང་གི་དོན་འཛིན་པ་མེད་པའི་ཕྱིར་རོ།",
    "དོན་ནི་འདི་ལྟར་ཡིན་ཏེ་ཤིང་གི་དོན་འཛིན་པ་ལ་ཤིང་མ་ཡིན་སེལ་དགོས་ལ་དེ་ལ་ཤིང་མ་ཡིན་ཤེས་པས་ཁྱབ་བོ།",
    "བརྡ་འདོགས་པའི་ཚེ་ཤིང་མིན་དེ་དག་མི་སེལ་བར་ཤ་པ་ལ་སོགས་པ་ལ་སྤྱིར་ཤིང་གི་བརྡ་འདོགས་ཞེ་ན།",
    "འོ་ན་ཕྱིས་ཤིང་གི་ཐ་སྙད་འདོགས་པར་བྱེད་པའི་སྐྱེས་བུ་རྣམས་བུམ་པའི་རྣམ་སོགས་དེ་ཡོངས་སུ་སྤངས་ནས་ཡལ་འདབ་ཅན་ཁོ་ན་ལ་འཇུག་པར་མི་འགྱུར་རོ།",
    "བརྡའི་དུས་སུ་ཤིང་གི་ཁྱད་པར་དཔལ་སོགས་པ་མ་བསལ་བས་དེ་དག་ལ་འཇུག་པ་བཞིན་ནོ།",
    "ནིའདི་ཡང་ཞེས་པ་ནི་སྤྱི་གཅིག་ལ་བརྡ་སྦྱོར་བའི་ཚེ་འདིའང་ཤིང་ཡིན་ཞེས་པའམ་འདི་ཁོ་ན་ལ་ཤིང་ཡིན་ཞེས་སྦྱོར་ཞེས་བརྟག་དང་པོ་ལྟར་ན་དེ་ཡོངས་སྤངས་ནས་འཇུག་པར་ནི་མི་འགྱུར་ཞེས་པའི་ཐལ་བ་ལྡོག་པ་མེད།",
    "དེས་ན་ཤིང་གི་ཐ་སྙད་ནི་བརྡ་ལས་རྟོག་ལ་ཤིང་མིན་གྱི་ཐ་སྙད་ནི་སྒྲ་ལ་མ་ལྟོས་པར་རྟོག་པ་རང་ཉིད་ཀྱིས་ངེས་པས་སྔར་གྱི་ཉེས་པ་མེད་དོ་ཞེ་ན།",
    "གང་གི་རྒྱུ་ཞེ་ན་དེ་དང་ཞེས་པ་རིགས་མཐུན་པ་རྣམས་གཅིག་ཏུ་རྟོག་པའི་ཤེས་པའོ།",
    "གང་ཟག་གང་གི་ས་ཞེ་ན་བློ་དེ་དག་དང་ལྡན་པའི་རྟོག་པ་པོས་སོ།",
    "བློ་གང་གིས་ཞེ་ན་མ་སྒྲ་ལ་མ་ལྟོས་པར་རྟོག་པའི་བདག་ཉིད་ཀྱིས་སོ།",
    "འདི་དག་གིས་དོན་ཐ་དད་ལས་དེ་དག་མྱོང་བའི་ཤེས་པ་སྐྱེ་ལ་དེ་ལས་དེ་དག་ཐ་དད་དུ་འབྱེད་པའི་རྟོག་པ་སྐྱེའོ་ཞེས་བསྟན་ཏོ།",
    "གང་གི་ཚེ་ཞེ་ན་ཐ་སྙད་ཀྱི་དུས་སོ།",
    "གང་གིས་ཞེ་ན་གཅིག་ཏུ་འཛིན་པའི་བློ་འཁྲུལ་པས་སོ།",
    "གང་ཞེ་ན་མིང་གི་སྒྲའོ།",
    "གང་གིས་ཞེ་ན་བརྡ་བྱེད་པ་པོ་རྟོག་ལྡན་གྱིས་སོ།",
    "བུམ་པར་ཆུ་འོན་ཅིག་ཅེས་པའི་ཚིག་གིས་བུམ་པ་དང་ཆུ་དང་ཁྱེར་འོང་བ་གསུམ་ངེས་པར་མ་བཟུང་ན་དེ་མ་དག་དོན་མེད་དུ་འགྱུར་བ་བཞིན་ནོ།",
    "ཁ་ཅིག་ན་རེ་སྒྲས་སེལ་བ་བརྗོད་ན་དེ་སྒྲུབ་པའམ་སེལ་བའི་ངོ་བོར་སྟོན།",
    "བརྗོད་བྱ་དངོས་པོར་ཐལ་བ་སྤང་།",
    "གང་ཞེ་ན་ཤིང་གི་ཁྱད་པར་རྣམས་སོ།",
    "གང་གིས་ཞེ་ན་ཤིང་མིན་དེ་དག་ལས་ཐ་དད་པར་རོ།",
    "གང་གིས་ཞེ་ན་གཞན་ལས་ལྡོག་པ་ཡིས་དངོས་པོ་དེའི་ཆ་འགའ་ཞིག་རྟོགས་པར་འགྱུར་རོ་ཞེས་པའི་ཚིག་གིས་སོ།",
    "གང་གིས་ཞེ་ན་སྔོན་པོ་ལ་སོགས་པའི་སྒྲ་རྣམས་ཀྱིས་སོ།",
    "སྒྲ་གཉིས་ཞེས་པ་སྟེ་ཁ་ཅིག་ན་རེ་ཐམས་ཅད་དུ་སྒྲ་གཉིས་བརྗོད་དགོས་པར་ཐལ་ཏེ་སྒྲ་གཅིག་གིས་བྱ་བ་གཉིས་མི་ནུས་པའི་ཕྱིར་ཏེ་འཁར་བ་ཐོགས་པ་ཞེས་པའི་སྒྲ་བཞིན་ཞེ་ན།",
    "དེ་ཉིད་ཀྱང་དེ་གཉིས་ཕན་ཚུན་གཅིག་ལ་གཅིག་གི་རང་བཞིན་ཡོད་པ་མིན་པའི་ཕྱིར་རོ།",
    "ནིའདི་ཞེས་པ་སྟེ་སྒྲ་དོན་དངོས་པོར་ཐལ་ཏེ་དོན་བྱེད་པ་དོན་དུ་གཉེར་བའི་གང་ཟག་འཆད་ཉན་བྱེད་པ་གཉིས་ཀྱིས་བརྗོད་བྱ་དང་རྟོགས་བྱ་ཡིན་པས་ཞེ་ཞེ་དགུ་ན་སྒྲ་དོན་འདི་དངོས་པོར་མེད་དེ་གནོད་པ་ཅན་ཡོད་པས་སོ།",
    "གཞན་དུ་ཞེས་པ་སྟེ་འདིར་ཤིང་དང་ཤིང་མིན་དུ་འཇོག་པ་ནི་མུ་སྟེགས་པ་ཤིང་གི་སྤྱི་དངོས་པོར་གྱུར་པ་གཅིག་ཡོད་མེད་ཀྱིས་འཇོག་ལ་འདིར་ནི་གཞན་སེལ་གྱི་སྤྱི་གཅིག་ཡོད་མེད་ཀྱིས་འཇོག་གོ།",
    "དེ་ཡང་དོན་ལ་ཤིང་ཐམས་ཅད་ལ་ཤིང་མིན་དང་བྲལ་བ་རྗེས་སུ་འགྲོ་བ་དེ་ཡིན་ལ་བློ་ལ་སྒྲོ་བཏགས་པའི་སྒོ་ནས་རྟོག་པ་ལ་ཤིང་གི་སྤྱི་གཅིག་ཏུ་འཛིན་པའི་རྒྱུ་གཞན་དང་བྲལ་བར་སྣང་བ་དེ་ཡིན་ནོ།",
    "དེ་ལས་གཞན་པ་ཡིན་ན་ཡང་ཐལ་བ་དེ་བཞིན་དུ་སྦྱར་རོ།",
    "གཞན་ཡང་ཤ་པ་ལ་སོགས་པ་དང་རིགས་ཤིང་གི་ལྡོག་པ་འབྲེལ་མེད་དུའང་འགྱུར་ལ་འབྲེལ་པ་ཡོད་ན་འབྲས་བུར་འགྱུར་རོ།",
    "བཞི་པ་སྒྲ་རྟོག་གཞན་དོན་མེད་དུ་ཐལ་བ་སྤང་བ་ནི།",
    "གང་གིས་ཞེ་ན་སྒྲའམ་ལྔ་བཅུ་ཐམ་རྟགས་གཅིག་གིས་བྱ་བྱེད་ཅེས་པ་སྒྲ་རྟགས་གཅིག་གིས་སྒྲོ་འདོགས་ཐམས་ཅད་མི་གཅོད་ཅིང་ཐམས་ཅད་ཀྱིས་ཀྱང་གཅིག་མི་གཅོད་དེ་བརྡའི་ཡུལ་དང་རྟགས་ཀྱི་ནུས་པ་སོ་སོར་ངེས་པའི་ཕྱིར་རོ།",
    "དེས་ན་སྒྲ་གཅིག་གིས་ཐམས་ཅད་བརྗོད་པར་འགྱུར་རོ་ཞེ་ན་མ་ཡིན་ཏེ་བཅད་པ་ཡི་ཞེས་པ་སྒྲས་རྣམ་པར་བཅད་པ་དངོས་སུ་བརྗོད་པའི་དངོས་པོའི་བརྗོད་བྱ་ཅི་ཡང་བློ་ཡུལ་དུ་འཕངས་པ་མེད་པའི་ཕྱིར་རོ།",
    "གང་ལས་ཞེ་ན་སྐད་ཅིག་གི་དངོས་པོ་གང་གིས་རྗོད་པར་བྱེད་པ་མི་རྟག་པ་ཞེས་པའི་སྒྲ་ལས་སོ།",
    "རྣམ་གཅོད་ཅེས་པ་སྟེ་གང་གི་ཚེ་མེ་ཏོག་ལ་རྣམ་གཅོད་དུ་མ་ཡོད་པའི་ནང་ནས་སྔོ་མིན་ལས་ཐ་དད་པའི་རྣམ་གཅོད་གཅིག་ཅིག་སྔོན་པོ་ཞེས་པའི་སྒྲས་སྟོན་རིགས་པ་ན་རྣམ་གཅོད་གཞན་ཨུཏྤལ་མ་ཡིན་པ་མི་སྤོང་ཞིང་མི་སྒྲུབ་པར་གནས་ཞེས་པ་དང་།",
    "སྤྱི་དངོས་པོ་གཅིག་ནི་སྒྲས་རྗོད་པར་བྱེད་པར་འདོད་ན་མིན་ཞེས་པ་དངོས་པོ་ལ་རེག་པ་མིན་ཏེ་སྤྱི་གཅིག་མེད་ཅིང་གཞན་མ་བརྗོད་པའི་ཕྱིར་རོ།",
    "གང་གིས་ཞེ་ན་ཕྱོགས་གླང་གིས་ཏེ།",
    "སྒྲ་རྣམས་དང་ནི་རྟགས་དག་གིས།",
    "དེ་ཉིད་ཀྱང་སྒྲས་དངོས་པོ་བརྗོད་ན་ཐམས་ཅད་ཅིག་ཅར་རྟོགས་པར་ཐལ་བ་དང་གཞི་མཐུན་མི་སྲིད་པ་ལ་སོགས་པའི་སྐྱོན་ཡོད་པ་དེའི་ཕྱིར་རོ།",
    "གཉིས་པ་དེ་གཉིས་ངོ་བོ་རྣམ་འགྲེལ་གཅིག་ན་ཧ་ཅང་ཐལ་བ་ནི།",
    "ཡང་ཁྲ་བོའི་ངོ་བོར་འདོད་པའི་ཁྱད་པར་གཅིག་ནི་ནག་རྒུར་ལས་ལྡོག་པ་ནི་དངོས་པོའི་དོན་གཅིག་གི་སྤྱོད་ཡུལ་མ་ཡིན་ཞེས་པ་ནི་རིགས་དངོས་པོ་གཅིག་ལ་རྗེས་སུ་འགྲོ་མི་འགྲོ་འགལ་བའི་ཕྱིར་ཞེས་པའོ།",
    "གང་གི་ཞེ་ན་དབྱེར་མེད་པའི་ཐ་སྙད་དག་ཀྱང་ཞེས་པ་ཨུཏྤལ་དང་སྔོན་པོ་གཉིས་དབྱེར་མེད་དུ་འཛིན་པས་སོ།",
    "མཛོད་གང་གི་ཚེ་ཞེ་ན་སྤྱི་དང་གསལ་བ་ཐ་དད་དུ་འདོད་པར་འགྱུར་པའི་དུས་ནའོ།",
    "དེས་ན་སྤྱི་དངོས་པོར་སྨྲ་བ་ལ་སྤྱི་མི་སྲིད་དེ་འདི་ལྟར་བུམ་པའི་སྤྱི་བུམ་པ་ལས་ཐ་དད་ན་དེ་དེའི་སྤྱིར་མི་རུང་སྟེ་ཧ་ཅང་ཐལ་བའི་ཕྱིར་རོ།",
    "གཞན་སེལ་སྤྱིར་འདོད་པ་ལ་སྤྱི་དང་གཞི་མཐུན་ལལ་སོགས་པ་མེད་པར་ཐལ་བའི་ཉེས་པ་དེ་དག་མེད་དོ།",
    "ཅི་སྟེ་ཞེ་ན་རིགས་མི་མཐུན་ཤིང་མ་ཡིན་ལས་ལྡོག་པ་ནི་ཤིང་གི་གསལ་བ་ཀུན་ལ་ཡོད་པའི་ཕྱིར་དང་རིགས་མཐུན་ནང་ལས་ལོག་པའང་ཤིང་ཀུན་ལ་ཡོད་པའི་ཕྱིར་རོ།",
    "གང་གིས་ཞེ་ན་སྔོན་གྱི་བརྡ་ཤེས་པའི་རྒན་པོས་སོ།",
    "དེ་འབྲས་ཞེས་པ་སྟེ་བ་ལང་གི་འབྲས་བུ་ནི་བཞོ་བ་དང་ཁལ་དགལ་བ་ལ་སོགས་པའོ།",
    "གང་གི་ཚེ་ཞེ་ན་དེ་དག་གི་ནུས་པ་འཇུག་པའི་དུས་ནའོ།",
    "དགོས་པ་གང་གི་ཕྱིར་ཞེ་ན་ཐ་སྙད་ཚོགས་ཆུང་བའི་དོན་དུའོ།",
    "དེ་ཡང་ཚོགས་པའི་སྒྲ་དང་རྒྱུད་ཀྱི་སྒྲ་དང་།",
    "ས་བོན་ལས་མྱུ་གུ་དང་སྡོང་བུ་དང་ཚིགས་ལ་སོགས་པ་དངོས་དང་བརྒྱུད་པའི་འབྲས་བུ་དུ་མ་ཡོད་ཀྱང་ས་བོན་གྱི་འབྲས་བུ་ཞེས་འབྲས་བུའི་སྒོ་ནས་ཚིག་གཅིག་གིས་སྟོན་པ་དང་།",
    "མེ་ཏོག་ལ་དངོས་དང་བརྒྱུད་པའི་རྒྱུའི་རྒྱུན་དུ་མ་ཡོད་ཀྱང་མེ་ཏོག་གི་རྒྱུ་ཞེས་རྒྱུའི་སྒོ་འུ་ཡུག་ནས་ཚིག་གཅིག་གིས་སྟོན་པ་དང་།",
    "སྐྱེས་བུ་ལ་བུ་ཆུང་ལ་སོགས་པའི་གནས་སྐབས་དུ་མ་ཡོད་ཀྱང་མི་ཞེས་པའི་ཚིག་གཅིག་གིས་སྟོན་པ་ལྟ་བུའོ།",
    "ཡང་རྒྱུའི་སྒོ་ནས་འབྲས་བུ་དུ་མའང་གཅིག་ཏུ་སྟོན་ཏེ་བ་ཁྲ་མོའི་བུ་ཞེས་པའམ།",
    "དགག་པའི་སྒོ་ནས་སྟོན་པ་ལའང་འབྲས་བུ་དགག་པའི་སྒོ་ནས་སྟོན་པ་ནི་སྒྲ་ནི་མིག་གིས་གཟུང་བར་རིགས་བྱ་བ་མ་ཡིན་པ་དང་མི་རྟག་པ་དང་བདག་མེད་པ་ཞེས་པ་ལྟ་བུའོ།",
    "དེ་མ་མཐོང་ན་གཅིག་གི་སྒྲ་བློ་མི་འཇུག་སྟེ་དེ་དག་དེ་མཐོང་བ་ལས་འཇུག་པས་སོ།",
    "དང་པོ་ང་བཞི་གནས་པ་ཞེས་པ་སྟེ་དུ་མས་གཅིག་གི་རྟེན་བྱེད་པས་སམ།",
    "འདོད་ན་དེ་ལ་གཅིག་གི་བློ་མི་སྐྱེ་བར་འགྱུར་ཏེ་གསལ་བ་བཞིན་ནོ།",
    "དེ་དག་ཀྱང་ཕན་མི་པའི་འདོགས་ན་རྟེན་དང་བརྟེན་པར་མི་རུང་སྟེ་ཧ་ཅང་ཐལ་བའི་ཕྱིར་རོ།",
    "འོ་ན་འཁར་གཞོང་རྒྱ་ཤུག་གི་རྟེན་དུ་མི་འགྱུར་ཏེ་དེས་དེ་ལ་ཕན་མི་འདོགས་པས་ཞེ་ན།",
    "གང་གིས་ཞེ་ན་འཁར་གཞོང་ལ་སོགས་པས་སོ།",
    "མི་གནས་ན་སྤྱི་དེ་དུ་མར་ཐལ་བ་དང་གསལ་བ་གཅིག་ག།",
    "མིན་ཏེ་རྒྱ་ཤུག་རང་གི་རྒྱུ་ལས་གྲུབ་པའི་ཕྱིར་རོ།"
  ]
}