    "དེ་གའི་ཏུའུ་ཏུའུ་ཡི་ཐབས་ཡོད་པ་ཞུས་ཅིན་མཱིན་བྱ་བས་དང་ཐོག་གནས་ཚུལ་དེ་མ་ཤེས་པར།",
    "བྷོད་དམག་དང་ཐུག་སྟེ་ཡུན་རང་པར་འཐབ་མཐར།",
    "ཧྲི་ཞིན་ས་ཆ་ཡང་བགོ་སྐལ་དུ་སྟེར་དགོས་ཞེས་ཞུས་པས་ཝུའུ་ཙེ་ཐེན་འདུམ་བྱེད་པར་མ་འཐད།",
    "ཧྲིན་ལི་ཡི་ཁྲི་ལོ་གཉིས་པར།",
    "བཙན་པོས་རུ་དྭགས་རྔོན་པར་ལྗགས་གཡར་ཏེ་དམག་བསྡུས་ཤིང་།",
    "ཝེའུ་ཙེ་ཐེན་གྱིས་སྐུ་སྲུང་ཆིབས་དམག་མཁར་གྱི་ཕྱི་རོལ་ཏུ་མངགས་ཏེ་བསུ་བ་བྱས།",
    "མ་འགྱངས་པར་བཙན་བྲོད་གྲོངས།",
    "ཡིན་ཞིའི་ཏ་ཏུའུ་ཏུའུ་བྱ་བའི་ཆོ་ལོ་གནང་།",
    "ཁྲང་ཨན་གྱི་ཁྲི་ལོ་གཉིས་པར།",
    "ཝུའུ་ཙེ་ཐེན་ནས་ཀྱང་དེ་ལྟར་བྱེད་དུ་གནང་།",
    "ད་ལྟ་ཡང་མཉན་པར་སྤྲོ་བའི་རོལ་ཆས་ལ་ལྟ་རུ་འགྲོ་བའི་བསྐལ་བ་བྱུང་།",
    "ཝུའུ་ཙེ་ཐེན་ནས་ཀྱང་གནང་ངོ།",
    "བཙན་པོས་རུ་སྣ་དྲངས་ཏེ་དམག་བྱས།",
    "ཉིན་གཅིག་ལ་སྲིད་ཁྲིར་ཡོང་མ་བཞུགས།",
    "དོན་གྱི་འབྲས་བུ་རྣམ་པར་སྨིན།",
    "དེ་རྣམས་རྒྱལ་སྲིད་སྐྱོང་བའི་ཐབས་དམ་པར་གནས་ཤིང་།",
    "གཏན་དུ་བདེ་བ་ཐོབ་པའི་ཐབས་ནི་བགྱིད་པར་བྱའོ།",
    "བྷོད་ཀྱི་ཚོ་བ་ཁག་རྣམས་ཀྱང་དམག་བྱས་པས་རྒུད་པར་སྐད།",
    "གལ་སྲིད་བྷོད་ཀྱིས་འདུམ་བྱེད་པར་སེམས་ན།",
    "མཛའ་མཐུན་གྱི་འབྲེལ་བ་སྔར་བས་དམ་པར་འགྱུར་ལ།",
    "པེ་ཆེན་པོ་བྱ་བའི་མཚེའུའི་འགྲམ་དུ་གོང་མའི་བཞུགས་གུར་ཕེབས་ཏེ།",
    "བྷོད་ཀྱི་ཕོ་ཉ་བ་རྣམས་ནས་གསོལ་སྟོན་བཞེས།",
    "གོང་མས་བྷོད་ཀྱི་ཕོ་ཉ་བ་སྐུ་མདུན་དུ་བོས་ནས་ཀོང་ཇོ་ལོ་ན་གཞོན་པ་དང་།",
    "གོང་མ་རང་ཡང་སྤྱན་ཆབ་བསིལ་ཞིང་དབུགས་རིང་བཏང་སྟེ་རིང་ཞིག་བཤུམས་ཤིང་བཞུགས།",
    "མི་སེར་གྱིས་ལོ་གཅིག་ལ་ཁྲལ་འཇལ་མི་དགོས་པར་བྱས།",
    "ཞལ་བྲལ་གནང་ས་དེ་ཡང་སྦྱིན་ཁྲི་ཞང་ཆང་པེ་ལི་ཞེས་པར་བཅོས།",
    "བྷོད་ནས་སྐུ་མཁར་བརྩིགས་ཏེ་བཞུགས་སུ་འཚལ་ལོ།",
    "གོང་མ་རོས་ཙུང་རྒྱལ་སར་བཞུགས།",
    "མན་པའི་ཚོ་དཔོན་པར་མཱིན་བྱ་བས་བྷོད་དམག་དྲངས་འོངས་ཏེ་ལི་ཀྲི་ཀུའུ་དང་གཡུལ་སྤྲད་པས་ལི་ཀྲི་ཀུའུ་བསད་ཅིང་།",
    "བྷོད་ལའང་ཐག་ཉེ་བས་ཕན་ཚུན་འཕྲོག་རྩོད་བྱས་པས།",
    "བྷོད་ནས་ཕོ་ཉ་བ་མངགས་ཏེ་དབྱང་ཅུ་སྐྱེས་ཀྱིས་ཚིམས་པར་བྱས་ཤིང་།",
    "གོང་མས་བཀྱོན་ཕབ་པར་འཇིགས་ཏེ་དུག་བཏུང་སྟེ་ཤི།",
    "མ་འགྱངས་པར་ཝང་ཅུན་སོགས་སྦེ་ཡོན་གྱི་ཝུའུ་ཅེ་ཡུ་ནས་བྷོད་དམག་དང་ཐུག་དཔུང་མགོ་མ་ཝང་ཧེ་པིན་གཡུལ་དུ་ཤི།",
    "ཐང་ལ་འདུམ་ཞུས་ཀྱང་གོང་མས་གསན་དུ་མ་གནང་།",
    "དམག་བྱས་ན་ནི་རྒྱལ་ཁབ་ལའང་གྱོང་རྒུད་ཆེ།",
    "ད་ནི་བྷོད་པ་རྣམས་འདུམ་བྱེད་པར་འཐད་ཟེར་བའི་གཏམ་ཐོས་པས།",
    "ཁོ་བོས་ཝང་ཅུན་ཕྲོ་དང་གྲོས་ཤིག་བྱེད་ཅེས་གསུངས།",
    "མ་འགྱངས་པར།",
    "ཝང་ཅུན་ཕྲོ་ཡིས་དམག་མི་བཏང་ནས་དེ་རྣམས་བཟུང་སྟེ་ཕྱིར་ལོག་ལོ་དེའི་ཟླ་དགུ་པར།",
    "བཙན་པོས་སྟག་སྒྲ་ཁོང་ལོད་སྐུ་མདུན་དུ་བོས་ཤིང་།",
    "ཀྲུང་ཧྲིག་ཀོས་བྱ་བས་དམག་བྱས་ཏེ་ཕྱིར་བཟློགས།",
    "བྷོད་དམག་ཆིག་སྟོང་ལྷག་གསོན་འཛིན་བྱས་ཤིང་།",
    "ཁོ་བོས་ས་ཁྲ་ལ་བལྟས་ནས་གནས་ཚུལ་ཞིབ་པར་རྟོག་དེ་ནས་ཁྱེད་དམག་དཔོན་རྣམས་ལ་བཀའ་འབེབས་རྒྱུ་ཡིན་པས།",
    "ད་ལན་ཅིས་ཀྱང་རྒྱལ་ཁ་ལོན་པར་བྱེད་དགོས་ཞེས་གསུངས།",
    "ཁེ་ཡོན་གྱི་ཁྲི་ལོ་བཅུ་བདུན་པར།",
    "ཉིས་བརྒྱ་ལྷག་གསོན་འཛིན་བྱས།",
    "ཁོ་བོས་དམག་བྱེད་དུ་འདོད་པས་འདུམ་ཇི་ལྟར་འོང་ཞེས་གསུངས།",
    "དེ་ནི་ས་མཚམས་ཀྱི་དམག་དཔོན་ཚོས་གཡུལ་གྱི་བྱས་རྗེས་འདོད་དེ་ཡི་གེ་བཅོས་མ་བསྐུར་ནས་གོང་མའི་ཐུགས་དཀྲུགས་པར་གདོན་མི་ཟ།",
    "རྒྱལ་ཁབ་གཉིས་པོ་དམག་བྱས་ན།",
    "དམག་དཔོན་དེ་ཚོས་གླགས་བཙལ་ནས་བྱ་བ་ངན་རྒྱུ་བྱས་པ་དང་།",
    "ལག་རྗེས་རྫུན་མར་བརྟེན་ནས་ཐོབ་དང་གོ་ས་ལེན་ཐབས་བྱས།",
    "བཙན་པོ་སོགས་ཀྱང་ཤིན་ཏུ་མཉེས་ཏེ་འདུམ་བྱེད་པར་འཆམས་ལ།",
    "ངེད་ནི་ཞང་གོང་མ་སྔ་མའི་ཉེ་ཚན་དུ་གཏོགས་པར་མ་ཟད།",
    "སྐབས་ཤིག་ལ་ཀྲང་ཞོན་པིའོ་དང་ལི་ཀྲི་ཀུའུ་ལ་སོགས་པས་ཤར་དང་ནུབ་ཕྱོགས་ནས་དམག་དྲངས་ཏེ་བྷོད་ལ་བཙན་འཛུལ་བྱས་པས།",
    "དབོན་ཞང་མཆོག་དམན་གྱི་ཁྱད་པར་ཡང་ཤེས་པས་གུས་མེད་ལུགས་མེད་བྱེད་དུ་མི་ཕོད།",
    "དེར་གོང་མ་ཞང་ནས་ཀྱང་བཀའ་བཀྱོན་གནང་བྱུང་།",
    "དེང་ནི་གོང་མས་ཕོ་ཉ་བ་མངགས་ཏེ་ཀོང་ཇོ་ལ་བལྟ་རུ་ཕེབས་པས།",
    "ཁེ་ཡོན་གྱི་ཁྲི་ལོ་བཅོ་བརྒྱུད་པའི་ཟླ་བཅུ་པར།",
    "གསེར་ཉའི་ཐོབ་རྟགས་བཅས་གནང་ཞིང་།",
    "སྣེ་ལེན་ཁང་དུ་བཞུགས་སུ་བཅུག་སྟེ་སྐྱེམས་སོགས་ཚིམས་པར་སྦྱར།",
    "གསེར་ཉའི་ཐོབ་རྟགས་ལེན་དུ་མ་གནང་བར།",
    "གོང་མས་དྲུང་ཡིག་ལ་བུ་ཡིག་ཏུ་འབྲི་རུ་བཅུག་སྟེ་གནང་།",
    "ཕས་རྒོལ་པའི་ཧམ་སེམས་འགོག་པར་འདོད་ན་ཟོན་བྱེད་རྒྱུ་དེ་གལ་ཆེ།",
    "ཧན་རྒྱལ་རབས་ཀྱི་གོང་མས་ཀྱང་མ་གནང་།",
    "གོང་མས་གཡུལ་གྱི་བྱ་བར་འཇུག་ཚུལ་གྱི་དཔེ་དེབ་དེ་དག་གནང་དུ་མ་བཞེད།",
    "དེབ་ཐེར་སོགས་གནང་བར་མི་འོས།",
