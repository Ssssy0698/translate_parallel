    "སེན་མོ་དང་།",
    "ནང་ཐ་དད་པ་བརྒྱ་སྟོང་གི་ཚང་ངོ་སྙམ་དུ་ལུས་དྲན་པ་ཉེ་བར་འཇོག་གོ་ཞེས་འབྱུང་ངོ།",
    "དེ་བཞིན་དུ་ཡིད་བདེ་བའི་གནས་རྣམས་ལ་མིག་དག་གིས་གཟུགས་སྣ་ཚོགས་མཐོང་ནས་ཆགས་པ་སྐྱེ་བར་འགྱུར་རོ།",
    "ཡིད་མི་བདེ་བའི་གནས་རྣམས་ལ་མིག་དག་གིས་གཟུགས་རྣམས་སུ་མཐོང་ནས་ཞེ་སྡང་སྐྱེ་བར་འགྱུར་རོ།",
    "བཏང་སྙོམས་ཀྱི་གནས་རྣམས་ལ་མིག་དག་གིས་གཟུགས་རྣམས་མཐོང་ནས་གཏི་མུག་སྐྱེ་བར་འགྱུར།",
    "ཤིན་ཏུ་ཡང་མིག་གི་སྐྱེ་མཆེད་ཀྱི་རང་བཞིན་གྱིས་སྟོང་ངོ།",
    "ཡུལ་རྣམས་ནི་རྨི་ལམ་ལྟ་བུ་གང་གི་ཡིན་པ་དེ་ལ་ཇི་ལྟར་འདོད་ཆགས་ལ་སོགས་པ་སྐྱེ་བར་འགྱུར་རོ།",
    "འདི་ཡང་རྨི་ལམ་ན་མཐོང་བའི་ཡུལ་གྱི་བཟང་མོ་ལ་སོགས་པ་བཅོམ་ལྡན་འདས་ཀྱིས་དཔེ་གསུངས་པ་ཉེ་བར་བསྟན་པར་བྱའོ།",
    "ལུས་མེད་ན་ཡང་བུད་མེད་ལ་སོགས་པ་རྟོགས་པས་ཀྱང་ཆགས་པར་རིགས་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "ཀྱང་གི་སྒྲས་ནི་གཏན་ཚིགས་སྡུད་པའོ།",
    "གང་གི་ཕྱིར་བུད་མེད་ལ་སོགས་པ་བརྟགས་པས་ཆགས་པར་མི་འགྱུར་རོ།",
    "གང་གི་ཚེ་ལུས་འདི་ལྟར་བརྗོད་པའི་རིགས་པས་མེད་དེ།",
    "རང་བཞིན་མེད་པ་དེའི་ཚེ་ལུས་མེད་པའི་ཕྱིར་བུད་མེད་གང་ཞིག་ཡིན་ཏེ།",
    "ཆགས་པ་པོ་གང་ཞིག་དགའ་བར་བྱ་བ་ཉིད་ཀྱི་བུད་མེད་ལ་ཆགས་པར་འགྱུར།",
    "བུད་མེད་ཀྱང་བདག་ཉིད་ལ་བུད་མེད་ཅེས་བརྟགས་ནས་ཕ་རོལ་གྱི་སྐྱེས་བུ་ལ་སྐྱེས་བུ་ཞེས་ཆགས་པ་སྐྱེད་པར་བྱེད་དོ།",
    "བུད་མེད་ལ་བུད་མེད་ཅེས་བརྟགས་ནས་ཆགས་པ་སྐྱེད་དོ།",
    "ལུས་མེད་ན་ཡང་བུད་མེད་ལ་བུད་མེད་ཅེས་ཡོད་པ་མ་ཡིན་ནོ།",
    "བུད་མེད་ཡོད་པ་མ་ཡིན་ཞིང་སྐྱེས་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ཞེ་སྡང་དང་གཏི་མུག་གི་ཡུལ་ཡང་ངོ།",
    "རེག་པའི་སྐྱེ་མཆེད་དྲུག་པ།",
    "སྐྱེས་བུ་འདི་ནི་རེག་པའི་སྐྱེ་མཆེད་དྲུག་པའོ་ཞེས་གང་སྨྲ་བ་དེ་ཅི་ལ་བརྟེན་ཏེ་སྨྲ་ཞེ་ན།",
    "རྒྱལ་པོ་ཆེན་པོ་རེག་པའི་སྐྱེ་མཆེད་དྲུག་ནི་འདི་དག་སྟེ།",
    "གཟུགས་རྣམས་ལ་བལྟ་བའི་ཕྱིར་མིག་གི་རེག་པའི་སྐྱེ་མཆེད་དང་།",
    "སྒྲ་རྣམས་ལ་ཉན་པའི་ཕྱིར་རྣ་བའི་རེག་པའི་སྐྱེ་མཆེད་དང་།",
    "དྲི་རྣམས་ལ་སྣོམ་པའི་ཕྱིར་སྣའི་རེག་པའི་སྐྱེ་མཆེད་དང་།",
    "རོ་རྣམས་ལ་མྱང་བའི་ཕྱིར་ལྕེའི་རེག་པའི་སྐྱེ་མཆེད་དང་།",
    "རེག་བྱ་རྣམས་ལ་རེག་པའི་ཕྱིར་ལུས་རེག་པའི་སྐྱེ་མཆེད་དང་།",
    "རྒྱལ་པོ་ཆེན་པོ་དེ་དག་ནི་རེག་པའི་སྐྱེ་མཆེད་དྲུག་སྟེ།",
    "སྐྱེས་པ་འདི་ནི་རེག་པའི་སྐྱེ་མཆེད་དྲུག་པའོ་ཞེས་གང་སྨྲས་པ་དེ་ནི་དེ་ལ་བརྟེན་ཏེ་སྨྲས་སོ།",
    "འདི་ལ་མིག་གིས་གཟུགས་མཐོང་བ་ན་ཡིད་བདེ་བ་དང་།",
    "རྒྱལ་པོ་ཆེན་པོ་གང་གི་སའི་ཁམས་གང་ཞེ་ན།",
    "ལུས་འདི་ལ་ནང་གི་ཁང་ན་སྲ་བ་དང་།",
    "སེན་མོ་དང་།",
    "རྒྱལ་པོ་ཆེན་པོ་བུད་མེད་ནང་དུ་བདག་ནི་བུད་མེད་དོ་ཞེས་རྟོག་ཅིང་།",
    "དེ་ནང་དུ་བུད་མེད་ཅེས་བརྟགས་ནས་ཕྱི་རོལ་དུ་སྐྱེས་པ་ཞེས་རྟོག་གོ།",
    "ཕྱི་རོལ་དུ་བུད་མེད་ལ་བུད་མེད་ཅེས་རྟོག་གོ།",
    "ཕྱི་རོལ་དུ་བུད་མེད་ལ་བུད་མེད་ཅེས་བརྟགས་ནས་ཆགས་པར་འགྱུར་ཏེ།",
    "ཕྱི་རོལ་གྱི་བུད་མེད་དང་ཕྲད་པར་འདོད་དོ།",
    "བུད་མེད་ལ་ནི་བུད་མེད་མེད་དོ།",
    "རྒྱལ་པོ་ཆེན་པོ་ནང་གི་སའི་ཁམས་ནི་དེ་ལྟར་བལྟའོ།",
    "ཐ་སྙད་དེ་ཡང་བུད་མེད་མ་ཡིན།",
    "ཞིམ་པ་ལ་སོགས་པ་ནི་རོ་མཆོག་གི་བཟའ་བ་དང་བཏུང་བ་ལ་སོགས་པའོ།",
    "ཇི་ལྟར་ཏེ་རྣམ་པ་གང་གིས་སོ།",
    "གང་གིས་ཉམས་སུ་མྱོང་བའི་རང་བཞིན་མ་ཡིན་ནའོ།",
    "དེའི་ཚེ་ཅུང་ཟད་ཀྱང་མྱོང་བ་མ་ཡིན་པ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "ཕྲ་མོ་ཉིད་དེ་ཉེ་བར་མཚོན་པ་ཉིད་ཀྱིས་སོ།",
    "ཀྱེ་གལ་ཏེ་ཁྱོད་དེ་ལྟར་འདོད་ན།",
    "འགལ་བའི་རྐྱེན་གང་གི་ཡིན་པ་ཞེས་པའོ།",
    "ཅི་སྟེ་གང་དེ་ཉིད་ནི་ཁོ་བོ་ཅག་གིས་བརྗོད་པ་དེ་ཉིད་ད་ལྟར་གྲུབ་ཅིང་འོངས་པ་ཡིན་ཏེ།",
    "གཞན་དུ་ན་ཇི་ལྟར་གང་ཉིད་གཞན་སྡུག་བསྔལ་གྱིས་སྒྲུབ་པར་བྱེད་པ་དེ་ཉིད་གཞན་བདེ་འགའ་ཞིག་གིས་སྒྲུབ་པར་བྱེད་པར་འགྱུར།",
    "ཚོར་བས་ངོ་མོའི་ཁ་ཡི་ཟུག་རྔུ་ནི།",
    "འདི་ནི་གང་གི་ཕྱིར་ཏེ།",
    "རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་ཡིན་ལ།",
    "རེག་པ་དྲུག་འདུས་པ་ལས་བྱུང་ཞེས་པའི་ཚིག་ལས་སོ།",
    "གསུམ་འདུས་པ་ལས་བྱུང་བའི་རེག་པ་ཉིད་དེ་ཡང་རིགས་པ་མ་ཡིན་ལ།",
    "འདུས་ཤིང་ཚོགས་པ་གང་ལས་འགྱུར།",
    "རེག་པ་ཡང་འདུས་པ་ལ་བརྗོད་ལ་བར་ཆོད་པ་ཡིན་ན་ཡང་དེར་ཇི་ལྟར་འགྱུར་ཞེས་དགོངས་པ་ཡིན་ནོ།",
    "ཆ་ཆུང་ཞིག་གིས་ཀྱང་གལ་ཏེ་ཆོད་པ་མ་ཡིན་ན་དེ་ལྟ་ན་ཡང་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་བར་མེད་པར་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་རྡུལ་ཕྲ་རབ་གཅིག་ཀྱང་རྡུལ་ཕྲ་རབ་གཞན་ལ་འཇུག་པ་མེད་དེ།",
    "དེ་ནི་གང་གི་ཕྱིར་ཏེ།",
    "དེ་ལྟར་ཡིན་ན་ཡང་རྡུལ་ཕྲ་རབ་རྡུལ་ཕྲ་རབ་ལ་འཇུག་པར་མ་གྱུར་མོད།",
    "གཞན་དུ་ན་ཆ་ཤས་དང་བཅས་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "མ་འདྲེས་པ་ལ་སྟེ་འདྲེས་པ་མེད་པ་ལ་ཕྲད་ཅིང་ཚོགས་པ་མ་ཡིན་ནོ།",
