    "ང་ཕྱི་ལ་འགྲོ་དགོས་པ་ཤེས་ནས་ངའི་གམ་དུ་བརྒྱུགས་འོངས་ནས་མགོ་བོ་དུད་ཅིང་འདུགཁོ་སྒ་སྲབ་མཐུར་གསུམ་གྱིས་ཡོངས་སུ་སྤྲས་པ་ན།",
    "ང་ལ་མགོ་བོས་འཕུར་འཕུར་བྱེད་བཞིན་ཁ་རོག་གེར་འདུག་ངའི་སྨིན་མའི་མདུད་པ་རིམ་གྱིས་བཀྲོལ་ནས་དབུགས་དབྱུང་བའི་ཚེ།",
    "ནུ་བོས་བལྟས་ཚེ་ང་ད་དུང་གཉིད་འདུག་པ་མཐོང་།",
    "འོན་ཀྱང་སེམས་སུ་ནམ་ཡིན་ཡང་རྟ་ཕོ་དེ་དྲན་གྱིན་འདུག་རྟ་ཞིག་མཐོང་ཚེ་ངའི་རྟ་ཕོ་དང་བསྡུར་ནས་དཔྱད་པ་གཏོང་བར་དགའ།",
    "ཕྱོགས་བཞི་ཐམས་ཅད་ལྗང་འཐིབས་སེ་འདུག་ཅིང་།",
    "སྡུག་དུས་འགབ་ནས་འདེགས་ཤིང་ན་དུས་རྒྱབ་ནས་བསྐྱོར་བའི་རྗེས་འཛིན་གྱི་བརྩེ་ཞགས་ནམ་ཡང་ལྷོད་མི་སྲིད་པས།",
    "བྱེས་ཀྱི་བསུ་སྐྱེལ་ཡང་གཞན་སུ་ཞིག་ཀྱང་མ་ཡིན་པར་གྲོགས་ཁོ་རང་ཡིན་ནོ།",
    "ཕུགས་ཀྱི་བསམ་དོན་རང་ག་བ་ཞིག་ལས་མི་འདུག་པ་འདྲ་ཡང་།",
    "ཚུར་ལ་གྲོགས་བསྒྲིགས་པའང་རང་དོན་གྱི་ཆེད་དེ།",
    "སྡུག་དུས་འཇའ་བཞིན་ཡལ་ནས་འགྲོ།",
    "དེ་ལ་བསམ་བློ་མི་འཁོར་རྒྱུ་ཅི་ཡང་མི་འདུག་ཕ་རྒན་གྱིས་ཁོའི་སེམས་གསོ་ཞོར།",
    "གཞན་ལ་སེམས་ཁུར་དང་རོགས་སྐྱོར་བྱེད་སྙམ་པའི་ང་རྒྱལ་དང་ཁེངས་དྲེགས་ཤིག་དུས་དང་དུས་སུ་མིག་མདངས་ལས་ཤོར་འགྲོ་ཡི་འདུག་ཡིན་ན་ཡང་།",
    "ངེད་ཅག་སེམས་པ་སྡུག་དུས་ཀྱི་སྐྱོ་རོགས།",
    "ཁོ་རང་ཉལ་ནས་བསྡད་དེ།",
    "གཟུགས་སྟོབས་ཆེ་བ་ཞིག་ཏུ་འདུག་བོད་ལྭ་ཅི་ཞིག་གོན་ཡང་སྐ་རགས་ལྷུག་ལྷུག་འཇོལ་འཇོལ་དུ་བཅིངས་པས།",
    "དོགས་ཟོན་མི་དགོས་པ་ནི་སྐྱིད་ཅིག་ལོས་ཡིན།",
    "བྱེ་བྲག་ནམ་གྱི་ལོ་ཡིན་པ་ཡིད་ལ་དྲན་གྱིན་མི་འདུག་འོན་ཀྱང་ངས་དོན་དེ་ཕ་མར་འདྲི་འདོད་མ་བྱུང་།",
    "སྐྱེ་འཆི་ཟེར་བ་འདི་མ་གཞི་ནས་རང་ཉིད་གཅིག་པུའི་དོན་ཞིག་ཏུ་ལུས་འདུག་ཨང་།",
    "རྣ་འགྲམ་གྱི་ལན་བུ་འགའ་ཡང་ས་རློན་གྱིས་གཞི་གཅིག་ཏུ་བསྲེས་འདུགཡིན་ན་ཡང་།",
    "ལམ་གྱི་གྲུ་ག་དང་དཀྱོགས་མཚམས་དག་ནི་རྡེའུ་ཕུང་དང་བྱེ་ཟེགས་ཀྱིས་ཁེབས་འདུག་པས།",
    "ཕྱི་མི་ནང་ལ་འོང་དུ་མི་འཇུག་པའི་རྫིག་ཉམས་ཤིག་ཐོན་འདུག་པས་ཡུན་རིང་ལ་མིའི་གྲིབ་གཟུགས་མ་འཕོས་པའི་སྣང་བ་སྟེར།",
    "སྔར་རིག་མ་མྱོང་བའི་དེང་རབས་མཛེས་རྩལ་གྱིས་བརྒྱན་པའི་ཐོག་ཁང་མང་བོ་ཕྱི་བརྩེགས་ནང་བརྩེགས་ཀྱིས་གྲལ་བསྒྲིགས་འདུག་པ་མཐོང་ལ།",
    "ང་རང་ནི་ཁོ་ཚོའི་ལྷམ་སྐོར་གྱི་སྐད་ཆ་དེ་ཚོར་དགའ་པོ་དེ་ཙམ་མེད་ལ།",
    "ཡིན་ནའང་ཁོ་ཚོའི་ལྷམ་སྐོར་གྱི་གཏམ་གླེང་དེ་ལས་ང་རང་ཆུང་དུས་ལྷམ་ཟོམ་པ་གྱོན་པའི་ལོ་ཟླ་དེ་ཚོ་དྲན་དུ་བཅུག་བྱུང་།",
    "དེ་དུས་ང་རང་ལ་པཱ་ལགས་ཀྱིས་བཙེམས་པའི་ཟོམ་པ་གསར་བ་ཞིག་གྱོན་རྒྱུ་ཡོད་སྟབས་དགུན་ཁ་ཧྲིལ་བོ་ཞོགས་པ་སྔ་པོ་ཇི་ཙམ་ལངས་ཀྱང་རྐང་པ་འཁྱགས་དོགས་ལ་སེམས་ཁྲལ་མེད་ཅིང་།",
    "ཅིག་བསྐུར་འདུག་པ་དེའི་ནང་སློབ་སྦྱོང་ཡག་པོ་གྱིས་ལ་གཟུགས་པོར་བདག་གཅེས་གྱིས།",
    "དེ་ནས་ལོ་ཤས་རྗེས་སུ་ང་རང་ལྷ་སར་ལས་ཀར་ཞུགས་པ་དང་།",
    "བདེ་བ་ཞིག་ཏུ་འདུག་ལ།",
    "བདག་ནི་དེ་མ་ཐག་ལམ་ལ་ཆས་ནས་ཟ་ཁང་དུ་སླེབས་དུས་ཁོ་ཚོ་ཚང་མ་སླེབས་འདུག་ལ།",
    "ང་རང་ཧ་ཅང་དོགས་མི་བདེ་བའི་ངང་དེར་བསྡད་རྗེས།",
    "ཚལ་རིགས་དག་བཟའ་བའི་ཞོར་ལ་ཆང་འཐུང་བ་ནི་གོམས་སྲོལ་ཆེན་པོ་ཞིག་ཏུ་འདུག་པས།",
    "ཁོ་བོས་འདི་ནི་ཚད་ལས་བརྒལ་བའི་བྱ་སྤྱོད་ཅིག་ཏུ་འདུག་སྙམ་ནའང་།",
    "རི་ཀླུང་འདིར་མེས་པོ་ཚོའི་གཏམ་རྒྱུད་གང་སར་ཁྱབ་འདུག་བཙན་པོའི་དུས་སུ་བློན་ཆེན་མགར་སྟོང་བཙན་སོགས་ཀྱིས་ཡུལ་གྲུ་འདི་བདག་ཏུ་བཟུང་ཞིང་།",
    "ཤུལ་དུ་ལུས་འདུག་པའི་བོད་ཀྱི་ས་མིང་འདི་དག་ཀྱང་ད་ལྟ་གསར་དུ་བཏགས་པའི་མིང་གསར་བས་སྣུབ་བཞིན་ཡོད་པས།",
    "ངས་ཞོགས་པའི་ཉི་ཟེར་དང་རང་བྱུང་སྙན་དབྱངས་འབྲུག་ཡུལ་དུ་བབས་པ་ཐེངས་གང་མང་ལ་རྨིས་མྱོང་།",
    "འབྲུག་ཡུལ་གྱི་གམ་དུ་ཁོའི་གཅུང་བོ་སྟེ་འབྲས་ལྗོངས་ལངས་འདུགའབྲས་ལྗོངས་ཀྱི་མཆོད་རྟེན་གྱིས་བྱམས་བརྩེའི་སྤྱན་ཟུང་ཕྱེ་ཡོད་ཅིང་།",
    "སློབ་དཔོན་ཆེན་པོ་ཨུ་རྒྱན་པད་མ་འབྱུང་གནས་ཀྱི་སྐུ་ལུས་རི་རྒྱལ་ལྷུན་པོའི་ཞལ་གྱི་དཀྱིལ་འཁོར་དུའང་བྱམས་བརྩེའི་མིག་ཟུང་ཕྱེ་འདུག་སྟེ།",
    "ཐང་མར་གདལ་འདྲའི་སྤང་གཤོང་དུ་གང་ཞིག་ལ་མིག་ཆུ་གཏོང་དགོས་ཤེས་ཀྱིན་མི་འདུག་གོ།",
    "དར་མ་ཡིན་ཚེ་ཅོག་ལགས་ཨ་ཇོ་ལགས་དང་ཨ་ཅག་ལགས་ཞེས་འབོད་དགོས།",
    "ཞེ་སའི་སྤྱོད་གོ་གཙོ་བོ་ནི་མི་ལ་གུས་ཞབས་མཚོན་པར་བྱ་ཆེད་ཡིན་ནའང་སྐབས་འགར་དེ་ཡང་རང་ཉིད་ཀྱི་སྐྱེ་ཁུངས་དང་ཡ་རབས་ཀྱི་སྤྱོད་ལམ་ངོམ་སོ་བྱ་སྤྱད་དུ་གྱུར་འདུག་པས་ཡུལ་དུས་གང་དུའང་ཞེ་ས་སྤྱོད་གང་ཐུབ་བྱེད་པ་དང་།",
    "བློ་མཐུན་དང་སློབ་གྲོགས་འཛོམས་སར་ཚད་ལས་འདས་པའི་ཞེ་ས་སྤྱད་ཚེ་ཕན་ཚུན་ག་དུས་ཡིན་ནའང་འཆམ་མཐུན་དང་འདྲིས་བདེ་གཤིབ་བདེའི་སྣང་བ་ཡོང་ཐུབ་ཀྱི་མེད་པས།",
    "མར་མེས་ང་རང་ལ་བག་ཆགས་གཏིང་ཟབ་ཤོས་བཞག་པ་ནི་བྱ་དངོས་ཚང་མར་ཡ་མཚན་གྱི་མིག་མདངས་འཕངས་པའི་ཆུང་བྱིས་པའི་དུས་སུ་ཡིན།",
    "སྣུམ་བཞུའི་ནང་ནས་བཟོ་དབྱིབས་ཁག་གཉིས་བརྗེད་དཀའ་ཙམ་འདུག་པ་སྟེ།",
    "དེའི་ངོས་ནས་བརྗོད་ན་སྦར་ཏི་བཞུ་མར་གྱིས་ང་རང་ལ་ཕན་པ་ཆེས་ཆེར་སྟེར་མྱོང་།",
    "ངལ་རྩོལ་ལ་གཅེས་སྤྲས་ཀྱི་བསམ་པ་ལྡན་པས་དཀར་ཡོལ་ཞིག་བཅག་པ་ལའང་ང་རང་ཕངས་སེམས་སྐྱེས་མྱོང་།",
    "གཅིགང་རང་ལོ་གསུམ་ཙམ་ལ་སླེབས་དུས།",
    "དེ་དུས་ང་རང་ལོ་དྲུག་ཙམ་ལ་སླེབས་ཟིན།",
    "ཡིན་ནའང་ཞིབ་ཕྲའི་ལག་རྩལ་མི་འདྲ་ལ་རང་རང་སོ་སོའི་ཁྱད་འཕགས་ཀྱི་ལག་རྩལ་གཞན་ལ་གསང་བ་བྱེད་པས།",
    "ལམ་བར་ཟས་གོས་ཤིན་ཏུ་ཞན་པའི་ཉམ་ཐག་རྒན་འཁོགས་དང་མུ་ཏོ་བ་དེ་འདྲར་ཐུག་དུས།",
    "དགུན་ཨ་རང་ད་རང་སྐབས་སུའང་རང་ཉིད་ཀྱི་ཟས་ཙམ་མ་ཟད་ལུས་ལ་གྱོན་ནས་ཡོད་པའི་གྱོན་གོས་ཕུད་དེ་ཁོ་ཚོར་གནང་བ་ནི་ཐེངས་གཅིག་གཉིས་གཏན་ནས་མ་ཡིན།",
