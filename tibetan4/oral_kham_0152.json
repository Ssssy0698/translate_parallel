    "ངག་སྒྲུབ་ར་འདོད་པའི་སེམས་བྱུང་ན་གང་ཟག་དུས་ནི་ཤིང་བཞིན་དུ་གནས་པར་བྱའོ།",
    "ལེགས་པར་ཁ་གདངས་ནས་ནི་བཟའ་བར་མི་བྱའོ་། ཁྲི་ལ་སོགས་པ་ལ་འཇུག་པ་ན་རྐང་པ་གཉིས་ས་ལ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "དེ་ཁོན་ཉིད་རྟོགས་དགོས་ཀྱང་རང་རྒྱུད་ཀྱི་སྡུག་པ་སྔལ་ཞིབ་ཡད་ཁོན་ཉིད་རྟོགས་ཅི་དགོས་སྙམན།",
    "དེ་བྱོན་དུ་འགྱུར་ན་ཁྱེད་རང་ལ་ཡང་མཚུངས་པའི་ཕྱིར་དང་།",
    "རྒྱུ་ལྡན་ཏེ་ཆགལོག་དུས་ན་འབྲས་བུ་མྱོང་བ་དང་བཅས་ཞེས་མཐོང་བ་འདི་ནི་སྲིད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེས་གང་བྲགཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པའོ།",
    "ཕྱོགས་ཀྱི་ང་དབྱེ་ག་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དེ་རང་བཞིན་གྱིས་གྲུབ་པའིཆ་ཤས་དང་བྲལ་བའི་ཕྱིར་དཔེར་ན་ནམ་མཁའ་བཞིན་ནོ།",
    "དེས་ན་རྔུལ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དེ་ཡོད་ན་རྡུལ་ཕྲན་ཆ་མེད་ཁས་ལེན་དགོས་པར་འགྱུར་ལ་དེལ་ནི།",
    "ལུས་བཞིན་དུ་ཚོར་བ་ཡང་རང་བཞིན་མེད་པར་བསྟན་པ་ནི།",
    "དེ་ན་གཉིས་མི་འདུག་པའི་ཕྱིར།",
    "དེ་ཡང་རང་བཞིན་གྱིས་མྱ་ངན་འདས་པར་བརྗོད་ལ།",
    "འགགས་པའི་ཚེ་གཞན་དུ་འགྲོ་དགོས་ན་གང་ནས་འོངས་པར་འགྱུར་ཞིང་གང་དུ་འགྲོ་བའང་རྟག་པར་གྱིས་ཏེ་འགྲོ་འོང་རང་བཞིན་མེད་པ།",
    "བདེ་བར་འདུག་པ་རིགས་མ་བཞི།",
    "མི་གཙང་རང་བཞིན་གཞན་གྱི་ལུས།",
    "ལུང་གཞན་ལ་ཡང་རང་གཞན་ད།",
    "དོན་ནི་མལ་ན་འདུག་ཀྱང་རུང་ལུས་ཀྱིས་འགྲོ་འའི་བྱ་བས་མ་ཟིན་པའི་འགྲེ་བར་བྱའོ་སྙམ་པའི་ཡུལ་དེར་འགྲོ་བར་འདོད་པའི་བློ་དང་།",
    "འདུག་པའི་སྤྲིན་ཚོགས་རྣམས་ཀྱང་དེ་ལ་འབུལ།",
    "དེར་སྐྱེསན་སྡུག་བསྔལ་ཤུགས་དྲག་ལ་རྒྱུན་རིང་བ་བཟོད་དཀའ་བར་འདུག་སྙམ་དུབསམས་ནས་འཇིགས་ཤིང་སྒྲུབ་པ་དང་།",
    "འདི་ལ་སྐུ་དང་འོད་ཟེར་དང་མཚན་ཙམ་ཡང་མཐོང་ཐོས་དྲན་ཏུ་གྱུར་པ་ཐམས་ཅད་སྨིན་གྲོལ་ཀྱི་ལམ་ལ་འགོད་ནུས་པའི་ནུས་པ་འདུག་པས།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེདན།",
    "དེ་དག་ཀི་བར་ན་འང་གནས་པ་མིན་ལ་དེ་ལས་གཞན་ན་འང་གཞས་པ་མིན་ན་ལན་ཅིག་རྩ་བ་ནས་ཕྱུང་བ་དང་རང་བཞིན་གྱིས་གྲུབ་པ་འདི་དག།",
    "གཞན་གྱིས་རང་ལས་གཞན་པའི་བཤེས་གཉེན་དང་གྲགས་དང་རང་ལས་བསླབ་པ་གཞོན་པ་སོགས་ཀྱི་ཡོན་ཏན་བརྗོད་ན་དེ་བཞིན་ནོ་ཞེས་རྗེས་སུ་མཐུན་པའི་ཚིག་བརྗོད་པར་བྱའོ།",
    "དང་ལ་བརྒྱང་སྟེ་མི་འདུག་ཅིང་།",
    "ཁྲི་ལ་སོགས་པ་ལ་འདུག་ན་རྐང་༥ གཉིས་ས་ལ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "བདག་ཉིད་ཀྱང་ནི་ཇི་ལྟར་འདུག།",
    "དགའ་ཞིང་ཆགས་པར་བྱ་བའི་གནས་འདུག་གམ།",
    "འདུག་ཉིད་ལ་ནི་འབབ་པར་གྱིས།",
    "གཅིག་ལྟོས་སཐ་དད་ལ་ལྟོས་ནས་པདང་བུར་འཛེག་པ་བཞིན་དུ་རྣམ་འགྱུར་དང་རང་བཞིན་ལ་ལྟོས་ནས་གཟུགས་འཛིན་པའི་སྒྲའི་རྣམ་པར་འགྱུར་བམེད་ཀྱང་སྒྲའིརང་བཞིན་ཡོད་དེགཟུགས་སྒྲ་གཉིས་རང་བཞིན་གཅིག་པའི་ཕྱིར།",
    "གའ་ཏེ་སྒྲ་འཛན་པས་ཚུལ་གཞན་གཟུགས་འཛིན་དེ་ཉིད་སྒྲ་འཛིན་དང་རང་བཞིན་གཅིག་ཡིནཔས་སྐྱོནམེད་དོ་ཞེན།",
    "ཕྱོགས་ཀྱི་ཆར་དབྱེ་བ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དེ་རང་བཞིན་གྱིས་ཀྲུབ་པའི་ཆ་ཤསདངབྲལ་བའི་ཕྱིརདཔེརན་ནམ་མཁའ་བཞིན་ནོ།",
    "དེ་ལྟར་ལུས་བཞིན་དུ་ཚོར་བ་ཡང་རང་བཞིན་མེད་པར་བསྟན་བནི།",
    "གཞུང་རྐང་པ་བཞི་བོ་འདིས་མུ་གསུམ་ལས་སྐྱེ་བ་བཀག་པའི་མཇུག་སྡུད་ལ་སྦྱར་ཡང་རུང་ཞིང་རང་གཞན་གཉིས་ཀ་ལས་སྐྱེ་བ་འགོག་པའི་དཀྵི་པ་ལ་ཡང་།",
    "དེ་ཁོ་ན་ཉིད་འ་དཔྱོད་པའི་རིགས་པས་རྣམ་པར་དཔྱདན་ལྟར་སྣང་ཡང་རང་དཞིན་གྱིས་གྲུབ་པའི་སྙིད་པོ་ཅུད་ཟད་ཀྱང་མེད་པའི་ཕྱིར།",
    "འདུག་ཀྱང་འཇམ་ངབྱངས་བཀའ་དྲིན་གྱིས།",
    "འོན་ཀྱང་རང་ཉིད་ཚེ་རབས་ཐམས་ཅད་དུ།",
    "དུམ་བུ་སྟོང་དུ་གཏུབས་ཀྱང་རང་བདེའི་དཔལ།",
    "བར་ཆད་གཅིག་པར་སྐྱེས་ནས་དང་བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "མཚན་འཛིན་དང་རང་དོན་ཡིད་བྱེད་ཀྱིས་བསྐྱོད་མི་ནུས་པས་མི་གཡོ་བ།",
    "ཤེས་བྱ་རང་རྒྱལ་གྱི་ལམ་དང་རང་རྒྱལ་གྱི་རྟོགས་རིགས་གཉིས་དོན་གཅིག་ཏུ་བྱས་ནས།",
    "བཟོད་པ་ཐོབ་ནས་ཀྱང་རང་རྒྱལ་གྱི་ལམ་དུ་འཇུག་པར་བཞེད་དེ་མཛོད་ལས།",
    "ཕྱིར་མི་འོང་ཐོབ་ནས་ཀྱང་རང་རྒྱལ་ལམ་དུ་འཇུག་པ་ཡོད་དེ།",
    "ཚེ་འདིའི་བདག་ཕུང་རང་བཞིན་སྔ་ནས་ཡོད་ཅིང་།",
    "ཕྱི་མའི་བདག་ཕུང་རང་བཞིན་རྟག་ཅིང་།",
    "བྱམས་པ་འདི་མངོན་སུམ་དུ་འདུག་ན།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་འགོག་བྱེད་ཀྱི་རིག་པ་དེས།",
    "འདུ་བྱེད་མིན་པར་འདའ་བ་དང་འོག་མིན་འགྲོ་ལ་དབྱེན་འཕར་བ་གསུམ་དང་།",
    "དཔེ་དང་རང་ལྡོག་ངོས་བཟུང་བ་དང་།",
    "འཁྲུལ་སྣང་རང་སར་གྲོལ་བར་ཐེ་ཚོམ་མེད",
    "མི་མིན་འགྲོ་བ་གནོད་སེམས་ལྡན་རྣམས་ཀྱིས།",
    "གནས་འདིར་མ་འདུག་རིང་དུ་འགྲོ་བར་གྱིས།",
    "མིའུ་ཐུང་གེལ་པའི་འདུག་སྟངས་ཀྱི་རོའི་སྟེང་ན་བཞུགས་པ།",
    "དམའ་བ་དམྱལ་ཁམས་ཡན་ཆད་གང་ན་འདུག་ཀྱང་།",
    "བྱད་མ་བསྲུང་སྐྱོབས་བྱེད་པའི་འཇིག་རྟེན་པ་ཐམས་ཅད་དཔག་ཚད་རྒྱའི་བར་དུ་བསྐྲད་པས་མགོན་སྐྱབས་དང་བྲལ་བ་མིག་རིག་རིག་འདར་ཡེད་ཡེད་འདུག་པར་བསམ།"
  ]
}