    "དུ་བ་མཐོང་བ་ལས་ཕ་རོལ་གྱི་ལ་ལ་དུ་བ་འདུག་པས་མེ་ཡོད་སྙམ་དུ་བསམས་ནས་ཐག་བཅད་པ་ཡིན་པས་རྗེས་དཔག་དེ་ལ་མེ་སྣང་ཚུལ་དེ་ཇི་ལྟར་སྣང་བ་ལྟར་མི་བདེན་པར་འཁྲུལ་པ་ཡིན་ན་ཡང་།",
    "གང་རང་ངོས་ནས་ང་ཡིན་པ་དེ་རང་ལ་འདི་གང་ཟག་ཅེས་ཐད་ཀར་གདགས་པར་བྱ་རིགས་པས་སོ།",
    "མ་རྙེད་པས་བདག་རང་ངོས་ནས་ཡོད་པའི་སྟོང་པ་ཉིད་ལ་བདེ་བླག་ཏུ་འཇུག་པར་འགྱུར་བ་གསུངས་པ་ལྟར་ཐོག་མར་ཐོས་བསམ་གྱི་དུས་སུ་ངར་འཛིན་ལྷན་སྐྱེས་ཀྱིས་ང་རང་ངོས་ནས་ཡོད་པར་འཛིན་པའི་ཡུལ་དེ་ཉིད་དོན་དམ་ལ་དཔྱོད་པའི་རིགས་པས་སུན་ཕྱུང་ཏེ་བདག་རང་ངོས་ནས་མེད་པའམ།",
    "གཉིས་སྣང་ཕྲ་བ་ཡོད་ཀྱང་རང་ཉིད་རྒྱུད་ལྡན་གྱི་བྱང་སེམས་ལ་གཉིས་སྣང་ནུབ་པ་ལྟར་སྣང་ནས་དེས་གཉིས་སྣང་ཡོད་པ་ཤེས་མི་ནུས་ཤིང་།",
    "མཚན་གཞི་ལ་འཛིན་རྣམ་ཡན་གར་བ་མི་སྲིད་བར་ཡང་གསུངས་འདུག་པས།",
    "སྣང་བ་དང་རང་སྣང་བའོ།",
    "ནང་མངོན་ཕྱོགས་འཛིན་པའི་རྣམ་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་ནང་རང་རིག་པའི་ངོ་བོ་ཉིད་དུ་རུང་བ་ཉིད་ཀྱི་མཚན་ཉིད་དུ་ཡིན་གྱི།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "དེ་ལྟར་ན་རྟོག་པའི་བདག་ཉིད་དུ་གྱུར་པའི་ཤེས་པ་ནི་རྟོག་པ་དང་བྲལ་བ་མི་འཐད་པས་རྟོག་མྱོང་རང་རིག་མངོན་སུམ་རྟོག་བྲལ་མ་ཡིན་པར་གྱུར་ལ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རྟོག་བཅས་ཀྱི་ཤེས་པའང་ཕྱི་རོལ་ཡུལ་ལ་བལྟོས་ཏེ་རྟོག་བཅས་ཡིན་ཀྱང་ནང་རང་རིག་པའི་ཆ་ནས་རྟོག་མེད་ཡིན་པ་འགལ་བ་མེད་དོ།",
    "ནང་རང་རིག་པའི་ཆ་ནས་རྟོག་མེད་ཡིན་པ་ལ་འགལ་བ་མེད་དོ་ཞེས་གསུངས་སོ།",
    "ཞྭ་སེར་བསྟན་པའི་སྒོ་རུ་ཞུགས་ཀྱང་རང་ལུགས་བསྐྱངས་པའི་དཔའ་བོར་མ་གྱུར།",
    "ལྕགས་སླང་ནང་དུ་ལིངྒ་ཕུར་བ་བཏབ་པ་མང་པོ་འདུག་ཡབ་ཀྱིས་ཐོ་ཅོ་བྱས་པའི་སྒྲུབ་ཁུང་ཚང་མ་ཁ་ཕྱེས།",
    "དལ་བོས་མ་གཏོགས་ལྷ་ལམ་དུ་འགྲོ་མི་ཐུབ་པར་འདུག་ཅེས་དངོས་མིང་ནས་མི་གསུངས་པར་ཆུ་དང་ཤིང་།",
    "སེམས་ལ་མི་བདེ་བ་ཞིག་ཡོང་རྒྱུ་འདུག་ཀྱང་།",
    "དེང་སང་ཕལ་ཆེས་སྙན་ངག་འཁྲིད་ཟེར་བ་རྩོམ་བརྒྱབ་རྒྱུ་ཁོ་ན་ལ་ངོས་འཛིན་བྱེད་འདུག་སྟེ་དེ་འདྲ་ག་ན་ཡིན།",
    "འབྲི་དུས་ཀྱང་སྲོད་ལ་བྱེད་དགོས་འདུག་པས།",
    "སྔ་མའི་ཁང་ཁྱིམ་སོགས་ངེས་གསལ་ཐག་ཆོད་འཛིན་རྒྱུ་འདུག་པ་སོགས་གསུངས་ཤིང་།",
    "ང་རང་བདག་འགོག་དམ་བཅར་འགྲོ་མྱོང་སྟབས་མི་ཉག་སྐྱོར་དཔོན་གྱི་རྩོད་པ་དེ་ལ་ལན་འདེབས་རྒྱུ་ཁག་པོ་མ་བྱུང་ཡང་།",
    "ཇ་ཞིག་བཞེས་ན་དྲག་མི་འདུག་གམ་ཟེར་བ་པར།",
    "ལྷ་འདྲེ་མི་གསུམ་སུས་ང་རང་ལ་མཐུ་གཏོང་ཡང་།",
    "ཁོང་ལ་དངུལ་ཀྱང་མང་པོ་འདུག་ཅིང་།",
    "ལན་གཅིག་ཁོ་ལ་སྡོད་ཁང་མེད་པར་བྷ་བུ་ནས་ཁང་པ་གཅིག་གཡར་འདུག་པས།",
    "ངས་ད་ཡག་པོ་བྱུང་འདུག་བྱས་པར།",
    "བྷ་བུས་གཡར་རྩིས་འདུག་ཀྱང་།",
    "ཟླ་བོ་དེས་མི་འདོད་རྣམ་འགྱུར་ལྟར་འདུག་པར།",
    "ཆེ་ཟེར་ཞིང་མནའ་ཡང་བསྐྱལ་རྒྱུ་འདུག་ཁོ་ལ་རིག་པ་ཡང་ཡོད།",
    "ཁོ་ལ་མཆོག་དམན་སུའི་སྐོར་གསུངས་ན་ཡང་རིག་པ་འདུག་ཅེས་གསུངས།",
    "རྒྱ་གར་བ་མཁས་པ་ཁ་ཤས་ཀྱིས་པཎྜི་ཏ་རཱ་ཧུ་ལ་ལ་ཕྲག་དོག་དང་འགྲན་སེམས་བྱེད་པ་ཡང་འདུག་པས།",
    "འདོད་པ་ལ་བསྐམ་ཆགས་པ་ཚིམ་པ་མེད་པ་འདིས་ལན་འདུག་ཅིང་།",
    "ཅི་ཡང་མེད་ལ་ཚང་མ་གཉིད་ཀྱིས་མྱོས་ནས་འདུག་ཅེས་ཨུ་ཚུགས་ཆེན་པོ་བྱེད་ཀྱི་འདུག་ཟེར་བའང་ཐོས་གསུངས།",
    "ཁྱིམ་པ་ཕལ་པ་གཞན་ལས་མཐོང་ཆེ་བ་བྱེད་འདུག་པ་མ་ཟད།",
    "དེ་མ་ཡིན་པའི་མཚོ་དཀྱིལ་བྲག་རྡོག་ཆེ་ཆུང་སྣ་ཚོགས་ཀྱི་སྟེང་དུ་བསྐྲུན་པའི་བསིལ་ཁང་ཧ་ཅང་ཉམས་དགའ་བ་བོད་ཀྱི་རི་ཁྲོད་ལྟ་བུ་མང་པོ་ཡོད་འདུག་ཅེས་དང་།",
    "སྣང་ཡུལ་གང་ལ་བལྟས་ཀྱང་སྐྱོ་ཉམས་ཤིག་འདུག་པ།",
    "སྡུག་བསྔལ་ཕུང་པོ་འདི་ཡི་བཅུ་ཆ་ལས་མི་འདུག།",
    "ཁོའི་མ་རྒན་ཡང་འདུག་ང་ལ་དངུལ་ཕྲན་བུ་ཞིག་བྱིན་བྱུང་།",
    "ལོ་ཙཱ་བ་ཟེར་བ་དེ་ལ་རིག་པ་དང་གསེར་ཏོག་ཙམ་ཞིག་ཡོད་ན་དེ་གས་འགྲིག་བསམ་པ་འདུག་དེ་འདྲ་ག་ན་ཡིན།",
    "དད་པ་ཟེར་བ་མིག་ཆུ་འཁོར་ཙམ་དེ་ལ་ཡིད་རྟེན་མི་འདུག་རྒྱ་གར་ནས་ངས་ཐེངས་ཁ་ཤས་ཤིག་ལ།",
    "བཀའ་ཤག་ནས་ད་ལྟ་ཡི་གེ་ཞིག་བྱུང་སྟེཁྱེད་རང་བསྐྱར་དུ་བཙོན་ལ་འཇོག་དགོས་པས།",
    "ཕྱི་ལ་མ་ཤོར་བ་གྱིས་ཞེས་བཀའ་ཕེབས་ཀྱིན་འདུག་ཅེས།",
    "ཆུ་ཚོད་ཁ་ཤས་མཚམས་ཁོ་རང་བགད་བཞིན་ཡོང་ནས།",
    "སྒྲོལ་མའི་སྐུ་དངོས་ཡིན་སྙམ་པའི་ཡིད་ཆེས་སྐྱེས་རྒྱུ་འདུག་སྔོན་རྒྱ་གར་སོགས་གཅིག་པུར་ཡུན་རིང་འཁྱམས་ཚེ་སྟོན་པའི་སྐུ་དེ་མཉམ་དུ་ཡོད་དུས་རོགས་ཞིག་དང་ཁྱད་མེད་པའི་སྣང་བ་ཤར།",
    "དེ་ལ་སུས་ཀྱང་བཟློག་ཏུ་མེད་ཅེས་སྟོན་པས་གསུངས་དེ་བདེན་པ་འདུག་མིན་ཡང་ཚེ་འདིར་བསམ་ན།",
    "ཕྱི་བའི་བསྟན་བཅོས་ཤོག་གྱུར་གཅིག་ཀྱང་བོད་དུ་གཏོང་མི་ཆོག་པ་དམ་ཚིག་ལ་བཀར་བཏགས་འདུག་པས།",
    "ཉམ་ཆུང་རང་སར་ཞོགས་གསུངས་ནས་ལན་གང་ཡང་མ་གནང་།",
    "ཟླ་བཟང་ལ་འདུག་བསྔགས་བརྗོད་ཀྱི་མེ་ཏོག་འཐོར་བའི་གནས་སུ་གྱུར་ཏེ།",
    "དེ་ལ་ཡིད་བརྟན་མེད་པའི་ཕྱིར་སྙམ་པ་ཡོད་འདུག་ཀྱང་བརྟག་པར་བྱ་སྟེ།",
    "དགོས་པའི་འཁྲུལ་སྣང་ནི་བདེན་བཞི་ལམ་ལྔ་སོགས་བཞག་འདུག་པས་དེ་ནི་བྱམས་མགོན་གྱིས་ཀྱང་།",
    "ཞེས་གསུངས་པ་སོགས་དང་མཚུངས་པ་བཞག་འདུག།",
    "གདའ་འདུག་བདའ་འདེད་བརྡ་གོ་བྱེད།",
    "གཞན་ཡང་ལྷས་བྱིན་མ་ཤི་པ་ཁྱིམ་ན་མེད་དོ་ཞེས་ཤི་བ་དང་ཁྱིམ་ན་འདུག་པ་བཀག་པས་གཞན་ན་ཡོད་པ་སྒྲུབ་པ་དང་།",
    "སྒྲ་གང་རང་ལ་དོན་མེད་ཅིང་།",
    "དེ་དག་དོན་ལ་འདུག་ན་དོན་གྱི་རྒྱན་དང་།",
    "གཉི་ཀ་ལ་འདུག་ན་ཚིག་དོན་ཕུན་སུམ་ཚོགས་པ་ཡིན་ནོ།",
    "ཡང་བརྟག་པ་ཕྱི་མ་ལྟར་ན་རྒོལ་བ་བྱ་དང་རྒོལ་བས་སྒྲུབ་བྱེད་སྨྲས་པའི་དེ་མ་ཐག་དུ་ལན་སུན་འབྱིན་མ་བསྟན་པ་བྱ་དང་རང་ལུགས་ཀྱི་སྤོབས་པ་མེད་པའམ་ཡང་ན་དོན་གཞན་ལ་འགྲོ་བར་འདུས་པར་འགྱུར་རོ།",
    "རུས་ན་ཚིཊ་ན་བརྐྱང་བསྐུམ་འགྲོ་འདུག་དཀའ།",
    "འདིར་ནི་རང་རང་ཡུལ་གྱི་རྒྱལ་བསེན་། དང་།",
    "རང་རང་སྤྱོད་། པ་ལུས་ཀྱི་རྣམ་འགྱུར་དང་།",
    "རང་རང་བཟའ་བཏུང་ལ་དགའ་གཅེར་བུར་སྡོད།",
    "བྱིན་བརླབས་རང་རང་མིང་ལ་བ་ལིང་ཏ།",
    "ཐོག་མར་སྒྲུབ་དུས་ཀྱི་ཞག་འགའ་ལ་རྨི་ལམ་དུ་ཁྱུང་ཕྲུག་དམར་རྗེན་རྨི་བར་འདུག་ཟེར།",
    "ཞེས་པར་ཡང་གོ་བ་ཅུང་གཏིང་ཟབ་པ་ཞིག་ལེན་ཐུབ་པར་མི་འདུག་གམ།",
    "དེ་རྗེས་རྒྱལ་པོའི་ཞལ་ནས་འདི་ནི་བཏུང་བའི་མཆོག་ཏུ་འདུག་པས་འདི་འཐུང་བའི་སྣོད།",
    "ཞིག་བཟོས་པ་གོར་མ་ཆག་པར་འདུག་སྙམ།",
    "དཀར་གོང་སྲིན་མེད་པ་དྲི་ཆུར་བཅུག་པ་འཇའ་ཚོན་ལྟ་བུར་འདུག་ན་དུག་མིན།",
    "བེ་སྔོན་ལས་ཅུང་བསྡུས་འབྲི་བྱས་འདུག་ཀྱང་།",
    "འཇའ་ཚོན་ལྟ་བུར་འདུག་ན་དུག་མིན།",
    "དུག་ཅེས་པའི་སྤྱིའི་མིང་ཚིག་ཅིག་ལས་གླེང་མི་འདུག་ནའང་།",
    "མཛུབ་དཀྲིས་དེས་ནི་ཁོ་རང་ཁོང་ཁྲོ་ལངས་ནས་ཅོག་ཙེར་ཁུ་ཚུར་རྡེག་དུས་ན་ཟུག་ལྡང་བར་བྱེད།",
    "དེ་ལྟར་དུས་ཡུན་རིང་བོ་ཞིག་འདས་ཙ་ན།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན་བློན་ཏ་ར་ཀླུ་གོང་དང་རྒྱལ་པོ་རིམས་འགོག་བདེ་སྲུང་།",
    "ངོ་ཤེས་པ་ཨེ་འདུག་ཚེ་ཕྲུག་ལགས།",
    "ཞེས་བཀོད་འདུག་པ་ལྟར་རོ།",
    "རྒྱ་གར་དུ་སྦྲུལ་གྱིས་སོ་བཏབ་པའི་རྨ་ཁར་མཆིལ་མ་བཀོལ་བར་འདུག་སྟེ།",
    "གསོ་དཔྱད་ཀྱི་དཔྱད་གཞིར་རམ་འདེགས་དང་མི་རིགས་གཞན་གྱིས་བལྟས་ཚེ་ངོ་མཚར་གྱི་ཉམས་མྱོང་དུ་འདུག་པར་སྙམ་ནས།",
    "ད་དུང་གཞན་གྱིས་མེ་མདའ་རྒྱག་དུས་ཕྱིང་ལྭ་གྱོན་ན་ཕན་ཟེར་ལ།",
    "གནས་ཚུལ་དེ་ལས་ཀྱང་ཛ་དྲག་ཏུ་གྱུར་འདུག་པ་ཤེས།",
    "ཉེས་པ་གསུམ་ལ་གནོད་པར་འདུག།",
    "ཕྱུར་ཁུ་ལྗང་ཏིག་གེར་འདུག་པ་དེ་བོངས་མང་དུ་བསྟེན་དུ་བཅུག་ནས་དུག་ཁོང་ནས་འཁྲུ་བར་བྱེད་པ་དང་།",
    "མ་མཐའ་ཡང་འབྲུ་རིགས་གཡོས་སྦྱོར་གྱི་ཟས་སྣ་བཅུ་བདུན་ཙམ་ཁ་སྣོན་བྱེད་དགོས་པར་འདུག་པས།",
    "ཕྱི་མ་ཕྱི་མ་དམན་པར་གསུངས་འདུག་པ་ལྟར་ཡིན་ལ།",
    "སློབ་ཚན་འདིར་དེ་འདྲའི་གདེང་འཇོག་བྱེད་མི་དགོས་པར་འདུག་སྙམ།",
    "དེ་ལ་གཟབ་ནན་ཆེར་བྱེད་དོན་མི་འདུག་པས།",
    "ཞེས་པ་མ་གཏོགས་གཞན་རྣམས་ནི་བོད་ཟས་ཤ་སྟག་ཏུ་འདུག་པ་དང་།",
    "འབུས་ཟོས་པའི་རྨ་ཤུལ་ཡང་འདུག་པ་དང་ཤུན་པགས་ཀྱང་ཅུང་མཐུག་པའི་སྣང་བ་སྟེར།",
    "བྱིས་པ་བཞི་བོ་མགྱོགས་ཐུག་ལ་ཤིན་ཏུ་དགའ་བར་འདུག་པས་དགོང་ཟས་སོགས་བྱེད་པ་མ་ཟད།",
    "ང་རང་ཉིད་ལ་མཚོན་ན་ཡང་།",
    "འཚོ་བ་དངོས་ཀྱི་མཐོང་ཐོས་མྱོང་གསུམ་དང་རང་ཉིད་ཀྱི་དཔྱད་པ་བཅས་ཀྱིས།",
    "དེ་ལའང་དོགས་ཟོན་མ་བྱས་ཚེ་འཚོ་བཅུད་ཞན་པ་ལས་གཞན་ཟས་དུག་ཕོག་པའི་ཉེན་ཁ་ཆེན་པོ་འདུག་སྟེ།",
    "ཅེས་བསྟན་འདུག་ལ།",
    "ཤྭ་ཕོའི་ཕོ་མཚན་ལ་རོ་ཙའི་ནུས་པ་ཆེ་བས་རིན་གོང་མཐོན་པོས་ཁ་ཆེ་ཚོང་བ་སོགས་དང་ས་གནས་ཀྱི་ཕྱུག་པོ་རྣམས་ཀྱིས་ཉོ་ཚོང་བྱེད་ཀྱིན་འདུག་ལ།",
    "དེའང་ཟོས་ན་ལུས་ལ་དྲོད་ཚད་སྐྱེ་བ་ཞིག་འདུག་ལ།",
    "གཞུང་རྟ་མ་ཚོས་ཁ་ཐོག་མ་རྩམ་གཟན་ཚོ་ཞེས་ལྐོག་ཏུ་འཕྱ་སྨོད་བྱེད་ཀྱིན་འདུག་ཟེར་བ་ལྟ་བཟའ་བཏུང་རིག་པ།",
    "རྣམས་ནི་བོད་ཟས་ཤ་སྟག་ཏུ་འདུག་པ་དང་།",
    "ཅོང་ཞི་ཞེས་པ་ཅོང་ཞིའི་ཕྱེ་མ་ཡིན་པ་རྒྱུད་འགྲེལ་གཞན་དུ་གསལ་བོར་སྨྲས་འདུག་སྟེ།",
    "ཞེས་པ་ལྟར་མངོན་སུམ་དུ་འདུག་གོ།",
    "ང་རང་ལ་མཚོན་ན་ཡང་།",
    "ཤེལ་གོང་ཤེལ་ཕྲེང་སོགས་དང་བསྡུར་ཏེ་ཕན་ཚུན་དཔྱད་པ་བཏང་ཙ་ན།",
    "ཞེས་གསུངས་ཡོད་པའི་ཚིག་རྐང་རྗེས་མའི་དོན་ལྷུག་པོར་བཀྲལ་འདུགབཞི།",
    "སྙན་པའི་རང་རང་བྱ་སྐད་སྒྲོག།",
    "དམན་པ་ཚབ་གཉིས་བཅས་གསུངས་ཡོད་པའི་དགོངས་དོན་དང་མི་མཐུན་པར་འདུག་ཅེ་ན།",
    "དེ་ནི་སྨྱུག་ཆས་ས་འོག་ནས་དུས་ཡུན་རིང་པོ་འགོར་ཙ་ན་རྡོ་ཆས་དང་རུས་ཆས་ལྟར་དུས་ཡུན་མི་རིང་བར་རུལ་འགྲོ་བ་ལས་སྨྱུག་མའི་དཔྱད་ཆས་མེད་པ་ག་ལ་ཡིན།",
    "ཞེས་བྱུང་བར་ཞིབ་ཏུ་དཔྱད་རྒྱུ་འདུག་ལ།",
