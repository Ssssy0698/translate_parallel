    "ཇེ་ཁི་ཡིས་གནས་འདིའི་ཆ་རྐྱེན་བཟང་པོ་འདུག་ཅེས་བཤད།",
    "རྒྱ་མར་ལྟ་བའི་རྒན་པོ་ཚོ་སྟུག་དེས་རྒྱ་མ་བརྒྱ་དང་བཞི་བཅུ་ཞེ་གསུམ་འདུག་ཅེས་བཤད།",
    "ཁོའི་ལུས་ཀྱི་ལྭ་བ་ཡང་རློན་པར་གྱུར་འདུགཇེ་ཁིས་ཕྱི་རོལ་ཏུ་ཆར་བ་འབབ་ཀྱིན་ཡོད་དམ་ཞེས་ཁོ་ལ་དྲིས།",
    "ཡོ་ཧན་གྱིས་ཕྱི་རོལ་ན་ཆར་བ་ཆེན་པོ་འབབ་ཀྱིན་འདུག་སྤྱིར་ན་ང་རླ་བྱེད་རླངས་འཁོར་གྱི་ནང་དུ་ཡོང་བ་ཡིན།",
    "ང་རང་རླངས་འཁོར་ལས་བབ་སྟེ་རྐང་པ་བརྒྱབ་ནས་ཡོབ་བ་ཡིན་ཞེས་བཤད།",
    "སྐབས་དེར་ཇེ་ཁིས་སེམས་པ་ཧ་ཅང་སྐྱིད་ཀྱིན་འདུག་ཡོ་ཧན་གྱིས་ཁུག་མ་ཞིག་ཁྱེར་ནས་ཡོང་ཞིང་།",
    "དེ་ནས་ལག་པ་གཉིས་གཞི་གཅིག་ཏུ་སྒྲིལ་བ་ན་ལག་པ་ཤུགས་དང་རྩལ་གྱིས་ཁེངས་འདུག་ངས་ཁོའི་ལག་པ་རས་ཀྱིས་ཡག་པོ་ཞིག་བཏུམས་ཤིང་།",
    "དུས་མཚུངས་སུ་ཁོ་རང་བར་ཐག་ཉེ་བའི་སྐབས་ཀྱི་འགྲན་ཐབས་དེར་ཧ་ཅང་ཆ་རྒྱུས་ཡོད་ལ།",
    "ཁོ་རྒྱུན་ལྡན་གྱི་གནས་ཚུལ་ལས་ཚབ་ཆེན་དུ་འགྱུར་གྱིན་མི་འདུག་ཁོས་ཚིག་ཐག་ཆོད་པའི་སྒོ་ནས་ཁོ་དང་འགྲན་སྡུར་བྱེད་མྱོང་བའི་མི་དག་ལ་དེ་བས་ཀྱང་འགྲན་སྡུར་ལ་སྡང་སེམས་སྐྱེ་རུ་འཇུག་འདོད་ཀྱིན་ཡོད།",
    "ཇེ་ཁི་ཡིས་ངས་ལག་པ་གཡོན་པའི་ཚོར་བ་ཇེ་ཞན་དུ་གྱུར་འདུག་ཅེས་བཤད།",
    "དེ་ནས་ཁོ་རང་འགུལ་གྱིས་ཨོའེར་ཁི་ཐི་ཡི་ལག་ཏུ་ལྷུང་ཞིང་།",
    "ངས་རྐང་བ་གཉིས་པོར་ཚོར་བ་མི་འདུག་ཅེས་བཤད།",
    "ཁ་ནས་ཀྱང་ངར་སྒྲ་ཞིག་གྲགས་ཀྱིན་འདུག་དུས་ད་ལྟ་ནས་བཟུང་ཨོའེར་ཁི་ཐི་ཡི་གང་ལ་གཡུག་ན་དེར་ཕོག་པའི་མགོ་བརྩམས་ཤིང་།",
    "སྐད་ཅོ་རྒྱབ་པ་ཡང་མཚམས་མི་ཆད་པར་གྲགས་ཀྱིན་འདུག་ཁོ་གཉིས་ངའི་མདུན་ཕྱོགས་སུ་ཡོད་ཅིང་།",
    "ཨོའེར་ཁི་ཐི་མི་གཉིས་ཀྱིས་སྐྱོར་ནས་འགྲོ་དགོས་པའི་གནས་སུ་ལྷུང་འདུག་མི་མང་པོ་ཞིག་ཁོ་གཉོར་སྐྱོང་བྱེད་པར་བྲེལ་བ་ལངས་ནས་ཡོད་ལ།",
    "ཇེ་ཁིས་སྐྱོན་མི་འདུག་ཅེས་བཤད།",
    "ཉི་མ་ཧ་ཅང་མཐོ་བའི་ནམ་མཁའ་ནས་འཆར་འདུག་ལ།",
    "ཧྲོ་ཞོ་ནང་ན་གཉིད་འདུག་ཅེས་བཤད།",
    "སྐུ་བཅར་དམག་དཔོན་གྱིས་མགོ་བོ་བཏེགས་ནས་ཁོ་ལ་ལྟ་འདུག་ཅིང་།",
    "ཕེའུ་ཏིན་གྱི་ངོ་གདོང་ཡོངས་སུ་དམར་པོར་གྱུར་འདུག་ཁོ་ལམ་ནས་འགྲོ་ཚུལ་དང་ཁང་བའི་ནང་ནས་དངངས་སྐྲག་ངང་འདུག་ཚུལ་གཉིས་གཞི་ནས་མི་འདྲ།",
    "སྐུ་བཅར་དམག་དཔོན་གྱིས་ཁོ་འགྲོ་ཚུལ་ལ་བལྟས་ནས་དགོད་ཀྱིན་འདུག་ཕེའུ་ཏིན་གྱིས་ཡང་བསྐྱར་ཐབ་ཁའི་ནང་དུ་མེ་བུས་པ་ན།",
    "ཧྲོ་ཞོ་མལ་ཁྲིའི་ཐོག་ཏུ་ཉལ་ནས་རས་ཀྱིས་བཟོས་པའི་ཁུག་མ་དང་གྱང་ངོས་སུ་བཀལ་ཡོད་པའི་གངས་ཤེལ་བ་བལྟས་ནས་འདུག་པའི་སྐབས་སུ།",
    "ཇ་ནེའུ་དང་ཁོའི་ཆུང་མ་གཉིས་མདུན་ཕྱོགས་ཀྱི་འདུག་སར་དམ་པོར་འཇུས་ནས་བསྡད་ཡོད་ལ།",
    "དབྱིན་ཏི་ཨན་གྱི་མི་ཚང་མ་གྲོང་རྡལ་ན་བཟི་ནས་འདུག་མི་སུ་ཡང་མ་མཐོང་བ་ཡིན་ནམ།",
    "རླངས་འཁོར་གྱི་ཕྱི་ངོས་ཡོངས་རྫོགས་ལ་ཆག་གྲུམ་ཤོར་འདུགངས་ལྟོས་དང་།",
    "རླངས་འཁོར་གྱི་དོན་རྐྱེན་བྱུང་འདུག་ཅེས་བཤད།",
    "ང་རང་རྒྱུན་དུ་འདི་ལྟ་བུའི་དོན་རྐྱེན་གང་མང་ཞིག་ལ་འཇིགས་སུ་རུང་བའི་ཚོར་བ་སྐྱེས་ཤིང་།",
    "ངའི་ཁ་ནང་ལའང་ཐོག་མཐའ་བར་གསུམ་དུ་གནས་དེ་ནས་གངས་ཆུ་འཐུང་བའི་དྲི་མ་དེ་འཐུལ་བཞིན་འདུག་ལ།",
    "ང་རང་ཧ་ཅང་སྤྲོ་སྐྱིད་དང་བཅས་ཏེ་གངས་ཤུད་བྱེད་པ་ལས་ད་དུང་དོན་དག་གཞན་ཡང་བསྒྲུབ་རྒྱུ་ཡོད།",
    "ང་རང་རི་མགོ་ལས་མར་འབབ་ཐུབ་པར་ཧ་ཅང་དགའ་བཞིན་ཡོད།",
    "དུས་ཚིགས་འདིའི་ཉི་མ་དྲོ་ཚད་ལས་བརྒལ་འདུག་འོ་ལེ།",
    "དེ་དུང་ཁྭ་ཏ་གཅིག་སྡོང་བོའི་སྟེང་དུ་ཙོག་པུར་བབས་ནས་གང་སར་ལྟ་བཞིན་འདུགསྒོ་མཆོར་གྱི་ཕྱི་རོལ་དུ་ཇ་མ་རྐུབ་སྟེགས་ཀྱི་སྟེང་དུ་ཡར་ལངས་ནས་བསྡད་ཡོད་ལ།",
    "ཁྱེད་ཚོས་ཟ་མ་ཟ་རན་གྱིན་འདུག་གམ།",
    "དེ་ན་ཆང་འཐུང་བཞིན་འདུག་ལེའུ་བཅུ་བ།",
    "རྒྱུན་དུ་ཁོས་མཚན་གང་བོར་གློག་བསྒྲོན་ནས་འདུག་སྲིད།",
    "ཁོས་ང་རང་ངོ་གདོང་དུ་ཉལ་ཁེབས་འཐེན་ནས་བསྡད་ཡོད་པའི་ཚོར་བ་དེར་ཧ་ཅང་དགའ་ཞེས་བཤད།",
    "དེ་ལ་འབྲས་བུ་མི་དམན་པ་ཞིག་འདུག་ཅེས་ཁོ་ལ་བཤད།",
    "ཁོ་རང་ཝེ་ལན་གྱི་ཚབ་ཏུ་སེམས་ཁྲལ་ལངས་ཀྱིན་ཡོད་ལ།",
    "ཡིན་ནའང་ང་རང་རྒྱུན་དུ་གནས་དེ་ལས་ཐར་མི་ཐུབ་ཅེས་བཤད།",
    "ང་རང་གསར་དུ་ཉལ་ཁེབས་ལ་དགའ་བ་ཡིན་ཞེས་བཤད།",
    "ང་རང་ཚེ་ཐོག་འདིར་འདི་འདྲ་ཞིག་དངོས་གནས་སྐྱིད་མ་མྱོང་།",
    "ཆང་འདི་ཧ་ཅང་ཡག་པོ་འདུག་ཟེར།",
    "ཁོ་རང་ཅིའི་ཕྱིར་རྒྱ་གྲམ་གྱི་སྟེང་ནས་མར་མི་ཡོང་བ་ཡིན་ནམ།",
    "ཚཱ་ཏྲིའི་སེམས་སུ་ཁོ་རང་རྒྱ་གྲམ་གྱི་སྟེང་ནས་མར་ཡོང་ན་འདོད་ཀྱིན་ཡོད་དམ།",
    "ང་རང་དོན་དག་འདིའི་རིགས་ལ་སྤྲོ་བ་ཅུང་ཙམ་ཡང་མི་འདུག་དམག་མི་ཀ་པས།",
    "ཕར་བལྟས་ཚོད་ཀྱིས་ཁོ་ལ་འཚུབ་ཆ་ཅུང་ལངས་ཀྱིན་འདུག་ཧྲོ་བེ།",
    "དོ་ནུབ་ང་ལ་སྔོན་ཆད་བྱུང་མ་མྱོང་བའི་སུན་སྣང་ཞིག་སྐྱེས་ཀྱིན་འདུག་དམག་མི་ཁ་པས།",
    "ཁོ་རང་ཡི་གེ་འབྲི་སའི་ཅོག་ཙེའི་འགྲམ་ནས་ཡར་ལངས་པ་དང་།",
    "དེ་བས་ཀྱང་ཁ་ཐག་རིང་བའི་མེའུ་སོ་པོའུ་ཏཱ་མེ་ཡཱ་རུ་དབྱིན་ཁྲི་ཉེར་གཅིག་ཅན་གྱི་ཁ་བ་ཆེན་པོ་ཞིག་འབབ་འདུག་སའི་གོ་ལའི་ཁ་གཏད་དུ་ཡོད་པ་ནི་ས་ཐག་ཧ་ཅང་རིང་བའི་ཨོ་སི་ཁྲི་ལི་ཡ་ཡིན་ལ།",
    "གླང་འཐབ་འགྲན་སྡུར་བ་བརྒྱ་དང་བཞི་བཅུ་ཞེ་བདུན་གྱིས་ཁོ་རང་འདས་མཆོད་བསྒྲུབས་སར་སྐྱེལ་མ་བྱས་ལ།",
    "ང་རང་མ་གཞི་ནས་གཉིད་ན་འདོད་ཀྱིན་མེད་ལ།",
    "ང་རང་ཉལ་ནས་གཉིད་མི་ཁུག་པའི་སྐབས་སུ་དུས་ཚོད་སྐྱེལ་བའི་ཐབས་བཀོད་སྣ་ཚོགས་ཡོད་ལ།",
    "དེ་ནི་ང་ལ་མཚོན་ན་ང་རང་སྐྱེ་སའི་ཁང་བ་དེ་ནས་ད་ལྟའི་བར་གྱི་དོན་དག་རྣམ་དྲན་དགོས་པ་དང་གཉིས་སུ་མ་མཆིས།",
    "དེ་དག་ཁོ་རང་ཤིང་རྟ་ལས་མར་འབབ་སྐབས་ནས་དེར་གཡུག་ནས་ཡོད།",
    "ཁོས་མདའ་གཞིའི་མགོ་ཆེས་བཟང་བ་དེ་དག་རྡུལ་དུ་བརླགས་འདུག་ཅེས་བཤད།",
    "ཉི་འོད་ཀྱིས་གང་སར་ཁྱབ་པའི་དུས་སྐབས་ཤིག་ལ་ང་རང་གཉིད་ལོག་ཀྱང་གང་ལའང་སྐྲག་མི་སྲིད།",
    "ཡིན་ནའང་ངའི་ཚོར་ཤེས་ཀྱི་རིག་པ་རྣོ་བའི་སྐབས་སུ་ང་རང་ཅུང་ཙམ་ཡང་གཉིད་མ་མྱོང་།",
    "ཡིན་ནའང་གཉིད་ཁུག་གྱིན་མི་འདུག་ངས་ཁ་བརྡ་ཐུང་ངུ་ཞིག་བྱས་ན་འདོད་དམ་ཞེས་ཁོ་ལ་དྲིས།",
    "ཁོ་ཡང་བསྐྱར་ང་རང་འཚུབ་ཆ་ལངས་ཀྱིན་འདུག་ཅེས་བཤད།",
    "ང་རང་མ་གཞི་ནས་དམག་འཁྲུག་དེའི་ནང་དུ་ཞུགས་མེད་ན་འདོད་ཀྱིན་ཡོད།",
    "ངའི་སེམས་སུ་ནམ་རྒྱུན་འཚུབ་ཆ་ཆེན་པོ་ལངས་ཀྱིན་འདུག་ཅེས་བཤད།",
    "ང་རང་གསར་རུ་དེ་ལ་ཐེངས་གཅིག་འཕྲད་ན་འདོད་ཀྱིན་ཡོད།",
    "ང་རང་གནས་འདི་ནས་གཉིད་ཡོང་མི་སྲིད།",
    "ང་རང་དག་པའི་ཞིང་ཁམས་གང་རུང་ཞིག་ཏུ་སྐྱེ་ན།"
  ]
}