    "འདི་གཉིས་གཅིག་ལ་གཅིག་ཆགས་ནས་ནམ་ལངས་པ་ཡང་མི་ཚོར་བར་འདུག་སྙམ་ནས་སྨྲས་པ།",
    "སེམས་སྐྱོ་བ་ཡིན་པར་འདུག་སྙམ་ནས།",
    "རིངས་པར་གྱུར་ཀྱང་དེ་ཡི་འདུན་དུ་འདུག།",
    "རྒྱལ་པོ་ཡབ་ཡུམ་སྲས་དང་གཡོག་དང་བཅས་པས་སྙན་ངགས་མཁན་ཤིང་རྟའི་སྟེང་ན་འདུག་བཞིན་པ་བསྐོར་ནས་མྱུར་བར་ཕྱིན་པ་ན།",
    "ཆུ་དབུས་འདུག་ནས་རི་དྭགས་ལྔ་བརྒྱའི་ཚོགས།",
    "གཞན་ནི་རྐུ་སྤོང་རང་དོན་ཏེ།",
    "གཞན་ནི་འཁྲིག་སྤོང་རང་དོན་ཏེ།",
    "གཞན་ནི་རྫུན་སྤོང་རང་དོན་ཏེ།",
    "གཞན་ནི་ཕྲག་སྤོང་རང་དོན་ཏེ།",
    "གཞན་ནི་ཀྱལ་སློང་རང་དོན་ཏེ།",
    "སྡུག་དུས་ལན་འགའ་མ་ལགས་པ།",
    "འོན་ཀྱང་རང་གཞན་སྲོག་ལ་སོགས།",
    "ཁྱེད་རང་ལྟ་བུར་མཛོད་ཅིག་མ་ཕམ་པ།",
    "ཅུང་ཟད་ཙོག་པུ་ཆགས་པའི་འདུག་སྟངས་ཅན།",
    "པི་ཝང་གླིང་བུ་འཁར་རྔ་ཟངས་དུང་རང་ཕྱོགས་གཙོ་བོའི་ཞལ་ལྡན་མ།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་རྣམས་ཀྱི་གནས་དང་ཉེ་གནས་ཞིང་དང་ཉེ་ཞིང་མདུན་རྟོག་ཉེ་རྟོག་འདུས་དང་ཉེ་འདུས་དུར་ཁྲོད་ཉེ་ཁྲོད་རྣམས་སུ་ཕྱོགས་མཚམས་གཡོན་གཡས་བསྐོར་པས་བཞུགས་ཤིང་མི་བསྐྱོད་སྣང་མཐའ་སྣང་མཛད་དབུ་རྒྱན་འཛིན་ལ་རང་རང་མིང་ཅན་ཕྱག་མཚན་འཛིན།",
    "རོལ་པའི་སྟབས་དང་དཀྱིལ་ཀྲུང་ཕྱེད་པ་ཙོག་པུའི་འདུག་སྟངས་དཀྱིལ་ཀྲུང་མཛད།",
    "གསུམ་པར་རང་རང་གདན་ལ་ནི།",
    "རང་རང་རིགས་ཀྱི་བདག་པོ་དང་།",
    "ཕྱག་དྲུག་འདུག་སྟངས་ཞི་བ་ཅན།",
    "རང་རང་ཡབ་རྣམས་ནུ་མ་འཛིན་པས་འཁྱུད།",
    "ལྷ་རྣམས་རང་རང་ཕྱག་མཚན་ཐུགས་ཀར་འཛིན།",
    "ཁུ་ཚུར་མ་བཞི་རང་རང་དམ་ཚིག་གོ།",
    "ཟླུམ་སྐོར་གསུམ་པར་རྡོ་རྗེ་སེམས་དཔའི་ཁྲོ་བོ་ལ་སོགས་རང་རང་རིག་མ་བཅུ་དྲུག་བཅས།",
    "བཞི་བར་ཉན་ཐོས་རྣམས་དང་རང་རྒྱལ་དང་།",
    "རབ་ཏུ་ཁྲོས་བཅས་བྲག་རིའི་གདན་ལ་འདུག།",
    "གཙོ་བོ་ལ་ཕྱོགས་བཀའ་ལུང་ནོད་པར་འདུག།",
    "དེ་ཀུན་རང་རང་གྲགས་པའི་ཞོན་པ་ཅན།",
    "ནང་ཚན་འཁོར་རྣམས་རང་རང་གཙོ་ལ་བལྟ།",
    "བེ་རོ་ཙ་ནས་དབུ་བརྒྱན་ཅིང་།",
    "རྔ་ཡབ་འཛིན་ཅིང་རང་རང་ཞོན་པ་ཅན།",
    "མཐིང་ནག་དུས་མཐའི་སྤྲིན་ཆེན་ལྟ་བུར་འཇིགས།",
    "ལྟ་བས་མི་ངོམས་རོལ་པའི་འདུག་སྟངས་ཅན།",
    "བདག་ཅག་ས་ལ་འདུག་པ་འདི་ཤེས་ནས།",
    "ཕུར་བུ་སོགས་ཀྱི་ཡིད་ཀྱི་ཁྱིམ་རྣམས་མུན་ཁུང་ནང་དུ་འདུག་པ་ཡི།",
    "༧རྒྱལ་བ་གཉིས་པ་སྲས་ཀྱི་ཐུ་བོ་དང་བཅས་པའི་འཕྲིན་ལས་ཀྱི་ཞབས་འདེགས་སུ་འགྱུར་བ་བྱུང་འདུག་པས་བཀའ་དྲིན་རྨད་དུ་གྱུར།",
    "བདེན་པ་༢ལྟ་བུ་གསལ་ལ་མི་གསལ་མང་པོ་བྲིས་འདུག་དེ་དག་ལ་ཞིབ་ཏུ་བལྟས་པས་སྔ་མ་ནི།",
    "ཉན་ཐོས་ཚེ་དེ་ལ་དེ་ལྟར་ཡིན་ཡང་རང་རྒྱལ་ལ་དེ་མེད་པས་དེ་མི་འཐད་པའི་ཕྱིར་ཟེར་ན།",
    "དེས་ན་འདི་དག་དང་རང་རྒྱལ་གྱི་ཐད་དུའང་།",
    "བདག་མེད་ཡིན་ན་རང་རང་ལས་མ་སྐྱེས་པའི་ཁྱབ་པའི་ཕྱིར།",
    "རྒྱལ་བ་ཤཱཀྱ་ཐུབ་པའི་གསུང་རང་རྒྱུར་གྱུར་པ་ལས་སྐྱེས་པའི་ཕྱིར་ན།",
    "དེ་སྐྱེ་བ་ལ་བཅོས་མིན་གྱི་མྱོང་བ་འགྲོ་འདུག་དང་བསྲེས་ཐུབ་ཀྱི་བར་དུ་བསྒོམ་དགོས་པའི་ཕྱིར་ནའང་མ་ཁྱབ།",
    "སྐད་ཅིག་མ་དང་རང་བཞིན་མེད་པ་གཉིས་རྣམ་པའི་ཡུལ་དུ་འདོད་ན།",
    "ས་དང་པོ་བ་འདིས་ཀྱང་རང་དང་མཐུན་པའི་སྐྱོན་ཟད་ཅིང་ཡོན་ཏན་ཁྱད་པར་ཅན་འཐོབ་ལ།",
    "བདུན་པའི་ཡེ་ཤེས་དེ་བརྒྱད་པར་མངོན་དུ་ཕྱོགས་འདུག་པས་བློས་ཟིལ་གྱིས་དེ་དག་གནོན་ཟེར་བ་ནི།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "ཁ་ཅིག་དུས་མཐའི་སྐད་ཅིག་མ་ཆ་མེད་ཡིན་ཟེར་ན།",
    "འདིའི་ཕྱོགས་སྔ་སྨྲ་བ་པོ་སེམས་ཙམ་དང་རང་རྒྱུད་པ་ཡིན་ཏེ།",
    "ལུས་གཅིག་ནི་བདེ་བ་ཅན་དུ་འདུག་ལུས་གཅིག་ནི་སྤྲུལ་ཏེ་དགའ་ལྡན་དུ།",
    "ཉེས་པ་རྣམས་ཀྱི་ཐོག་མའི་མཐའཡང་རང་བཞིན་གྱིས་དབེན་པར་ཤེས་ཏེ།",
    "རང་རྒྱུད་པའི་གཞུང་ནའང་རང་བཞིན་མེད་པ་ཞེས་པ་མང་བའི་ཕྱིར་ཟེར་ན།",
    "ཚོར་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཕྱིར་ཟེར་བ་ལ།",
    "སྒྲུབ་བྱེད་ཚོར་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་དང་།",
    "བསྒྲུབ་བྱ་གཟུགས་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་ལ་བསྒྲུབ་དཀའ་སླ་མཚུངས་པའི་ཕྱིར།",
    "རང་བཞིན་གྱིས་གྲུབ་པའི་གཅིག་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་དུ་མ་གང་རུང་དུ་མེད་པའི་ཕྱིར།",
    "དེ་གདགས་གཞི་ཕུང་བོ་མ་ཡིན་ཞིང་ཕུང་བོ་དང་རང་བཞིན་གྱིས་གཅིག་མ་ཡིན།",
    "ལྷས་བྱིན་བ་ལང་ངམ་རྣ་བ་དང་ལྡན་པ་ལྟར་བདག་ཕུང་བོ་དང་རང་བཞིན་གྱིས་ལྡན་པ་དང་།",
    "གཏན་ནས་མེད་པའང་རང་བཞིན་གྱིས་མི་སྐྱེ་བའི་ཕྱིར།",
    "གཉིས་ཀ་མིན་པའི་ཕུང་གསུམ་པ་གང་ཡང་རང་བཞིན་གྱིས་མི་སྐྱེ་བའི་ཕྱིར།",
    "སྐྱེ་བ་ལ་རང་སྐྱེ་གཞན་སྐྱེ་གཉིས་སུ་ཁ་ཚོན་ཆོད་པས་རང་དང་མཐུན་པར་གཞན་སྐྱེ་དེས་ཀྱང་ཁས་ལེན་པ་དང་རང་རྒྱུད་ཀྱང་བཞེད་པར་བསམ་ཞིང་།",
    "གཞན་ཡང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་ལ་གཞན་གྱི་ཉེས་པ་མ་བསལ་བའི་ཆ་ནས་ཀྱང་སྐྱོན་མེད་དེ།",
    "བདེན་པ་གཉིས་ཆར་དུའང་རང་བཞིན་གྱིས་སྐྱེ་བ་བཀག་པའི་ཡོན་ཏན་བསྟན་པའོ།",
