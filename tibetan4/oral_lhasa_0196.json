    "དེ་ནི་རྣམ་པར་ཤེས་པའི་ཁམས་ཡིན་ནོ།",
    "བདེན་པ་མ་མཐོང་བས་ནི་རྣམ་པར་ཤེས་པ་འདི་མི་མཐོང་སྟེ།",
    "འོན་ཀྱང་བྱིས་པ་རྣམས་ཀྱིས་མི་ཤེས་པའི་ཕྱིར་རྣམ་པར་ཤེས་པའི་ཁམས་འདི་དཔེས་བསྟན་ཏོ།",
    "ལྷའི་གདོན་གྱིས་ཟིན་པར་གྱུར་ན་བཟང་སྐྱོང་འདི་ཇི་སྙམ་དུ་སེམས།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་མ་ལགས་སོ།",
    "གདོན་དེ་དག་ནི་གཟུགས་མ་མཆིས་པ་ལགས་སོ།",
    "བཟང་སྐྱོང་དཔེར་ན་སྲུལ་པོའི་གདོན་མི་སྡུག་ཅིང་གཟུགས་མི་སྣང་བ་མིའི་ལུས་ལ་གནས་ཏེ་མི་གཙང་བ་དང་རུལ་པ་དང་།",
    "འདི་ནི་ཕན་ཚུན་གྱི་རྐྱེན་གྱིས་འདོད་པ་ལེན་པར་བྱེད་དེ།",
    "གཟུགས་ལ་སོགས་པའི་འདོད་པ་འགྲུབ་པར་འགྱུར་རོ།",
    "དཔེར་ན་མེ་ཏོག་ལས་འབྲས་བུ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "༢༣པར་ཤེས་པ་འབྱུང་སྟེ།",
    "འོན་ཀྱང་ལུས་དེ་ལ་ཡང་རྣམ་པར་ཤེས་པ་མི་སྣང་ལ་རྣམ་པར་ཤེས་པ་ལྡོག་པས་ཀྱང་ལུས་ཀྱི་རུས་ིཔ་དང་།",
    "མི་གཙང་བ་རྣམས་རྣམ་པར་འཇིག་པར་འགྱུར་རོ།",
    "ཡང་གཅིག་ལ་གཅིག་འདོད་ཆགས་དང་བྲལ་བར་འགྱུར་བ་དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པའི་ཁམས་འདིས་ལུས་དང་ཕྲད་པ་རྙེད་ནས་དགའ་བ་སྐྱེད་ནས་ིཆགས་པ་འཕེལ་བར་བྱེད་དོ།",
    "ཡང་ཕྲད་པ་ལས་བྲལ་ན་ཕྱིར་ལྡོག་པར་འགྱུར་བ་དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པའི་ཁམས་འདིས་ལུས་ཡོངས་སུ་བླངས་ནས་ཡང་བོར་ཏེ་གཞན་དུ་འགྱུར་བ་མེད་པར་འགྱུར་རོ།",
    "ལས་ལིདམིགས་པའི་དངོས་པོ་ལས་རྣམ་པར་ཤེས་པས་ལུས་འགྲུབ་ིཔར་བྱེད་དེ།",
    "མ་བྱིན་པར་ལེན་པ་དང་།",
    "འདོད་པ་ལ་ལོག་པར་གཡེམ་པ་དང་།",
    "སྦྱར་བའི་ཆང་མྱོས་པར་བྱེད་པ་བག་མེད་པའི་གནས་སྤོང་བའོ།",
    "ཕུང་པོ་རྣམས་ཀྱི་ས་བོན་ཡང་རླན་པར་བྱེད་དོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་ཤེས་པ་འདིས་ཇི་ལྟར་ལྷའི་ནང་དུ་ལུས་ཡོངས་སུ་ལེན་པ་ལགས།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་ཤེས་པ་ཁོག་པ་དེ་ལ་ཆགས་ན་ཅིའི་སླད་དུ་མི་གནས།",
    "སྐྲ་འདི་དག་ནི་དྲི་ཞིམ་ཞིང་གནག་པ་ཡིན་གྱི་འདི་དག་ནི་ཕྱིར་ཡང་མགོ་ལ་བསྐྱེད་པར་བྱའོ་སྙམ་ན།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་མ་ལགས་སོ།",
    "༢ ༣ ༣ཡང་ཇི་ལྟར་འཛིན་པར་བགྱིད།",
    "སྦྲང་བུའི་ཡང་རྣམ་པར་ཤེས་པ་དེ་ཉིད་ཡིན་ནོ།",
    "བཅོམ་ལྡན་འདས་ཅི་ལགས།",
    "དེ་གཟུགས་ཅན་ཞིག་ལགས་སམ།",
    "འོན་ཏེ་གཟུགས་མ་མཆིས་པ་ཞིག་ལགས།",
    "རང་བཞིན་ནི་ཇི་ལྟ་བུ་ལགས།",
    "ལས་དེ་ཡ་ཡང་གཟུགས་ཅན་མ་ཡིན་ལ་རྣམ་པར་སྨིན་པ་ཡང་གཟུགས་ཅན་མ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་ལས་འདི་དག་ནི་རྣམ་པར་ཤེས་པའི་རྗེས་སུ་འབྲང་ངོ།",
    "ལུས་ཆེན་པོ་ཡང་ཇི་ལྟར་ཡོངས་སུ་འཛིན་པར་བགྱིད།",
    "རི་རབ་དང་ཡུངས་འབྲུ་བཞིན་ལགས་སོ།",
    "ཧ་ལ་ཧ་ལའི་དུག་ནི་དེ་ལྟ་མ་ལགས་སོ།",
    "ཆ་༢༣༨ཆུང་ཞིང་མི་གསལ་ལ་གཟུགས་ཅན་མ་ཡིན་པར་བལྟ་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཡུངས་འབྲུའི་ནང་དང་བར་སྣང་བཞིན་ཏེ་ཁྱད་ཆེ་ལགས་སོ།",
    "ལུས་ལ་ཡང་རྣམ་པར་ཤེས་པ་མི་དམིགས་ལ་རྣམ་པར་ཤེས་པ་མེད་ན་ཡང་ལུས་སྐྱེ་བ་མི་དམིགས་སོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་ཤེས་པའི་ཁམས་ཞན་པ་དེས་ཇི་ལྟར་གཟུགས་མཁྲང་ཞིང་སྲ་བ་ཕྱེ་སྟེ་འཕོ་ཞིང་མཆི།",
    "བཅོམ་ལྡན་འདས་རི་ནི་རང་བཞིན་གྱིས་མཁྲང་ལ་རྡོ་རྗེ་ལྟར་བརྟན་ཞིང་སྲ་བ་ལགས་ལ།",
    "དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་རང་བཞིན་གྱིས་ཞན་པས་ལུས་ཆེན་པོ་དག་ཕྱེ་སྟེ་འགྲོ་བར་འགྱུར་རོ།",
    "རྟག་ཏུ་མེ་ཏོག་རྒྱས་ཤིང་རྣམ་པར་བཀྲ་བར་བྱས་པའི་ལྷའི་ལོངས་སྤྱོད་སྡུག་གུས་མཛེས་པར་བྱས་པ་དང་།",
    "དེ་དེར་ཀུན་ཏུ་ཆགས་པས་དགའ་བ་ཐོབ་པར་འགྱུར་རོ།",
    "དེའི་ཁ་ཡང་མནམ་པར་མི་འགྱུར་རོ།",
    "དེའི་ཁྲག་ཀྱང་ཟག་པར་མི་འགྱུར།",
    "རྐང་ལག་ཀྱང་གཡོབ་ིཔར་མི་འགྱུར།",
    "དཔུང་རྒྱན་གྱིས་མཛེས་པར་བྱས་ཤིང་ལུས་བརྒྱན་པ་དག་ཀྱང་མཐོང་ངོ།",
    "དེའི་གཉེན་སྡུག་པ་རྣམས་ཀྱང་སྨྲེ་སྔགས་ཆེན་པོ་འདོན་པར་མི་བྱེད་དོ།",
    "ཕྱོགས་ཀྱང་མུན་པར་སྣང་བར་མི་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་མཐོང་ན་ཡིད་ཆེས་ཤིང་དང་བ་སྐྱེ་བར་འགྱུར།",
    "འདི་སྐད་དུ་སྲིད་པར་སྐྱེས་པ་ཐམས་ཅད་ཀྱི་ཚུལ་ནི་འདི་ཡིན་གྱིས།",
    "ད་ང་དང་བྲལ་བའི་ཕྱིར་གདུང་བར་ིམ་བྱེད་པར་ཐོང་ཤིག་ཅེས་དེས་གཉེན་དེ་དག་ཡང་དག་པར་དབུགས་འབྱིན་པར་བྱེད་དོ།",
    "རྣམ་པར་ཤེས་པ་ཡང་ལུས་ཀྱི་ནང་ན་མི་དམིགས་ལ་ལུས་མེད་པར་ཡང་རྣམ་པར་ཤེས་པ་མི་འབྱུང་ངོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་ཤེས་པའི་རྟགས་ཇི་ལྟར་བལྟ་བར་བགྱི།",
    "ཡིད་མི་བདེ་བ་ནི་རྣམ་པར་ཤེས་པའི་རྟགས་སུ་བལྟའོ།",
    "བཅོམ་ལྡན་འདས་ཇི་ལྟར་རྣམ་པར་ཤེས་པ་ལུས་ལས་བྱུང་སྟེ་མྱུར་དུ་སྐྱེ་བ་ཡོངས་སུ་ལེན་པ་ལགས།",
    "རྣམ་པར་ཤེས་པ་ལུས་ལས་བྱུང་ནས་མ་སྐྱེས་ཤིང་ཡོངས་སུ་མ་བཟུང་བ་དེས་ཇི་ལྟར་ལུས་གཞན་ལ་གནས་པར་བགྱིད།",
    "རྣམ་པར་ཤེས་པ་འདི་ནི་ཇི་ལྟར་བལྟ་བར་བགྱི།",
