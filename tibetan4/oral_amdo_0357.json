    "སྦས་པ་དག་གིས་དེ་ཆུད་ཟབར་འགྱུར་ཏེ།",
    "སྣག་གི་གཉེན་མཚམས་དང་།",
    "ལ་ཁ་མཉམ་བར་སྐྱེས་ནས་གལ་ཏེ་བུད་མེད་དུ་གྱུརན་ཡང་འགྲན་ཟླ་དང་བཅས་པའི་བྱོ་རྙེད་པར་འགྱུར་རོ།",
    "བག་མེད་པར་ཤིན་ཏུ་བུད་མེད་དོན་ངུ་གཉེར་བ་དང་།",
    "ཉེ་དུ་དང་སྣག་གི་གཉེན་མཚམས་དང་མཛའ་བཤེས་དང་བློན་པོ་དག་གི་ས་སྤོང་བརའགྱུར་བ་དང་།",
    "ད་མང་པོ་དག་གི་ཡིད་དུ་མི་འོང་བར་འགྱུར་བ་དང་།",
    "བདག་གི་ཚེ་སྐྱབས་དགའབ་ཇི་ལྟ་བར།",
    "རང་གི་ཆུང་མ་རྙེད་པས་ཆོག་པར་བྱོས།",
    "རང་གི་དོན་དང་གཞན་གྱི་དོན་ཆེད་དུ།",
    "བརྟགས་ཏེའཇམ་པོའིཚིག་གིས་སྨྲ་བར་གྱིས།",
    "ཁྱོད་ཀྱིས་འཁར་གསིལ་འདི་ཡོངས་སུ་བཅང་བར་བྱ་སྟེ།",
    "གོས་ཚགས་བཅོས་ནས་ཟླ་གོས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ཏེ་ཐལ་མོ་སྦྱར་ནས་པུས་མོ་ས་ལ་བཙུགས་ཏེ།",
    "ཁམས་གསུམ་གྱི་ཉོན་མོངས་པའི་ཀུན་ནས་དཀྲིས་པར་ཁོང་དུ་ཆུད་པ་དང་།",
    "འོད་སྲུང་འཁར་གསིལ་ཞེས་བྱ་བའི་ཡི་གེའི་དོན་རྒྱ་ཆེ་ཞིང་མང་བས་ཡོངས་སུ་རྫོགས་པར་རྗེད་མིནུས་ཀྱང་ཁྱེང་ཀྱིས་རེ་ཞིག་དེ་བཞིན་དུ་ཡོངས་སུ་གཟུང་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ལའོད་སྲུང་གིས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འཁརགསིལའདི་ཡོངས་སུ་འདི་འཛིན་པ་གང་ཡིན་པ་དེ་དག་ནི་གང་གི་སྤྱོད་པ་རྣམ་པ་བཅུ་དྲུག་པོའདི་ལྟ་སྟེ།",
    "གང་ཟག་དེའཕགས་པ་ཡིན་པར་མཚོན་པ་ཉིད་ཀྱིས་གུས་བསྐྱེད་པར་འགྱུར་བའི་ཕྱིར་འཕགས་པའི་གང་ཟག་གི་རྟགས་ཞེས་བྱའོ།",
    "ནཔ་དྲུག་གི་གནས་གསུམ་ཐོབ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ལའོད་སྲུང་གིས་གསོལ་པ།",
    "བ་ཅིག་འཁར་བ་མཚུངས་ཀྱང་སྤྱོད་པ་མི་མཚུངས་པས་ཁ་ཅིག་གི་ཚན་ནི་བཞི་སྒྲིལ་དུ་བྱས་བའོ།",
    "གཉིས་སྒྲིལ་དུ་བྱས་པ་ནི་དེ་བཞིན་གཤེགས་པ་འོད་སྲུང་གིས་རྣམ་པར་གཞག་པ་ཡིན་ཏེ།",
    "བཙུན་པཞིག་གི་དྲུང་དུ་པུས་མོ་བཙུགས་ཏེ་འདི་སྐད་དུ་བྱའོ།",
    "ཡོན་བདག་གི་ཁྱིམ་དུ་ཕྱིནན་འཁར་གསིལ་ལུས་དང་ཕྲལ་བར་མི་བྱ་བ་དང་།",
    "ཡོན་བདག་གི་སྒོར་ཕྱིན་པ་དང་ལན་གསུམ་གྱི་བར་དུ་དཀྲོལ་༴",
    "གནས་ཁང་ན་གཞག་པའི་ཚེས་ལརེག་པར་མི་བྱབ་དང་།",
    "བདག་གི་དྲུང་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར་ག་ཞནལ་རག་ཅིངས་ལ་རི་མོ་བྲི་བར་བྱའོ།",
    "འདི་ནི་སྡུག་བསྔལ་འགོག་བར་འགྲོ་བའི་ལམ་མོ་ཞེས་ཚུལ་བཞིན་ཡིདལ་བྱེད་པ་ན་མིག་སྐྱེས་སོ།"
  ]
}