    "ཉིན་ཞག་གཅིག་ལ་ཆ་དགུ་བརྒྱར་བགོས་པའི་ཆ་གཅིག་ནི་བདུན་སྟོང་ཉིས་བརྒྱར་གསིལ་པའི་ཆ་གཅིག་དུས་ཀྱི་ཐུང་མཐའ་ཡིན་ལ།",
    "དེས་ན་རྟེན་འབྱུང་དང་རང་བཞིན་གྱིས་གྲུབ་པས་སྟོང་པ་གཉིས་ཀ་མིན་པའི་ཤེས་བྱ་མི་སྲིད་དེ།",
    "དེ་ལ་ངེས་པ་དེ་མ་ཤོར་བའི་ངང་ནས་ང་རང་ངོས་ནས་དེ་ལྟར་དུ་གྲུབ་པ་མེད་མེད་སྙམ་དུ་རྩ་བའི་དམ་བཅའ་ཡང་ཡང་ཡིད་ལ་བྱེད་པའམ།",
    "ང་རང་འཛིན་གྱིས་འཛིན་ཚུལ་དང་རང་ལའང་ང་ད་ལྟར་སྣང་ཚུལ་འདི་ཉིད་ངར་འཛིན་ལ་སྣང་ཚུལ་ལྟར་ཡིན་པས།",
    "སོ་སྐྱེའི་ཡིད་ཤེས་རྟོག་པ་དེའི་ངེས་ངོར་ང་རང་བཞིན་གྱིས་མེད་པར་ངེས་པའི་ས་ངེས་ཤེས་དམ་སྦྲེང་ངེ་བ་དང་།",
    "བདེ་བའི་སྟན་ལ་འདུག་ནས་ནི།",
    "ཞེས་རྡོ་རྗེ་འཆང་རང་ཉིད་ཀྱིས་དང་དེ་བཞིན་དུ་རྣམ་སྣང་ལྔས་དངོས་ཀྱང་སོ་སོར་གསུངས་པ་རྣམས་ལ།",
    "རྒོལ་ཕྱི་རྒོལ་གྱི་རྒྱུད་ཀྱི་མ་དཔྱད་པའི་བློའི་འཇུག་ཚུལ་ལ་ཇི་ལྟར་འདུག་བལྟས་པས་ཆོག་པ་ཡིན་ནོ།",
    "མིང་དེ་ཡང་རང་ངོས་ནས་མེད་པའི་མིང་རྐྱང་ཙམ་ཡིན་ཏེ།",
    "བདགས་གཞི་དེ་ཕྱིར་བཏགས་པའི་མིང་ཙམ་ཉིད་ཀྱང་རང་ངོས་ནས་གྲུབ་ལྟ་ག་ལ་ཡོད་དེ་མེད།",
    "དེ་བཞིན་དུ་འགགས་ཤིང་རང་བཞིན་གྱིས་ཡོད་མིན་པའི།",
    "ཇི་ལྟར་མི་དག་གངས་རིའི་ཁྲོད་འདུག་ནས།",
    "ཉིན་ཧྲིལ་བོ་དང་མཚན་གྱི་ཆ་སྟོད་སྲོད་དང་ཆ་སྨད་ཐོ་རངས་གཉིས་ལའང་ཐུན་དངོས་ལ་བརྩོན་པའི་ཐུན་བར་རྣམས་སུ་ཡང་འཆག་པ་དང་འདུག་ནས་སྒྲིབ་པ་ལྔ་ལས་སེམས་སྦྱང་བར་བྱ་བའི་སྒོ་ནས་ཐུན་བར་གྱི་བྱ་བའང་དོན་ལྡན་དུ་བྱ་སྟེ།",
    "མཐུན་པར་བྱ་ཚུལ་རྒྱུད་རང་རང་ལས་འབྱུང་ལྟར་བྱེད་དགོས་སོ།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "དེང་སང་མཁས་པ་དུ་མས་བདེ་མཆོག་འཇིགས་བྱེད་སོགས་ལ་བརྟེན་པའི་ལྷོ་སྒོའི་ཆོ་གར་དེ་ལྟར་མཛད་འདུག་གོ།",
    "དེ་མེད་ན་དེའི་རུས་པ་མིང་བྱང་གོས་སོགས་གང་ཡང་རུང་བ་འཇོག་ཅིང་ཉེ་འབྲེལ་བྲན་སོགས་གང་འོས་ཀྱང་དེའི་ལོགས་སུ་འདུག་བཅུག་ལ།",
    "རྡོ་རྗེ་སེམས་དཔའི་གནས་འདུག་ནས།",
    "ཉམས་པའི་རྒྱུ་ཡང་སློབ་དཔོན་གསང་ཞིང་རང་ཆེ་འཕྱིན་པ།",
    "དེ་རྣམས་ཡིད་བརྟན་ཏུ་མི་རུང་བར་གདའོ།",
    "གལ་ཏེ་དེ་ལ་ཐེ་ཚོམ་ཟ་བ་གདའ་ན།",
    "སེམས་ཙམ་དུ་བཀྲལ་འདུག་སྙམ་པའི་ལོག་རྟོག་གདའ་ན།",
    "གལ་ཏེ་བདེན་སྙམ་པ་གདའ་ན།",
    "ཞེས་ཞུས་པ་བསྟན་དུ་གདའ་ན་ཡི་གེར་ཡང་བྲིས་མཛོད།",
    "གལ་ཏེ་བདེན་སྙམ་པ་གདའ་ན།",
    "ཞེས་གྲགས་པ་འདི་ཡང་དོན་ལ་མི་བདེན་པར་གདའ་ཞིང་།",
    "གལ་ཏེ་བདེན་སྙམ་པ་གདའ་ན།",
    "ཉི་ཁྲི་ལེ་མང་དང་ལེ་བརྒྱད་མ་ལེའུ་མང་ཉུང་མ་གཏོགས་པ་གཅིག་རང་ཡིན་ཞེས་གྲགས་པ་འདི་ཡང་དོན་ལ་མི་བདེན་པར་གདའོ།",
    "གལ་ཏེ་བདེན་སྙམ་པ་གདའ་ན།",
    "ལན་གསུང་རྒྱུ་གདའ་ན་ཡི་གེར་བྲིས་མཛོད།",
    "དེའི་གཞུང་འགྲེལ་སེམས་ཙམ་གྱི་གཞུང་དུ་གྲགས་པ་འདི་ཡང་དོན་ལ་གཏན་ནས་མི་བདེན་པར་གདའ།",
    "འཕགས་པ་ཕྱོགས་ཀྱི་གླང་པོས་ཀྱང་ཤེར་ཕྱིན་སེམས་ཙམ་དུ་བཀྲོལ་ཞེས་གྲགས་པ་དེ་ཡང་དོན་ལ་མི་བདེན་པར་གདའ་སྟེ།",
    "དོན་ལ་ཤེས་བྱེད་ཡང་དག་ཏུ་མི་རུང་བར་གདའ་བས།",
    "སྟོང་པ་ཡིན་པ་དེ་བཞིན་དུ་དངོས་པོ་ཐམས་ཅད་ཀྱང་རང་བཞིན་མེད་པ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "འདིར་ནི་ཚིག་རང་བཞིན་མེད་པ་ཉིད་ཀྱི་དངོས་པོ་རྣམས་ཀྱང་རང་བཞིན་འགོག་པར་བྱེད་དོ།",
    "འོ་ན་ནི་ད་གཉེན་པོར་གྱུར་པ་མུན་པ་ཡང་རང་དང་གཞན་གྱི་བདག་ཉིད་གཉིས་བསྒྲིབ་པར་འགྱུར་བ་ཞིག་ན།",
    "དེའི་ཕྱིར་མིང་དེ་ཡང་རང་བཞིན་ཡོད་པ་མ་ཡིན་པར་བྱ་དགོས་ཏེ།",
    "འོན་ཀྱང་རང་བཞིན་མེད་པ་ལ་དངོས་པོ་རྣམས་རང་བཞིན་མེད་པའོ་ཞེས་གོ་བར་བྱེད་པ་ཡིན་ནོ།",
    "ལ་ལ་ནི་བདེ་མཆོག་སྒྱུ་མ་ལྟ་བུས་འདོད་ཆགས་ཀྱི་རྒྱུད་ཀྱི་ངོ་བོ་ཉིད་ཀྱིས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་ལ།",
    "གཞན་མ་གཉིས་ནི་རང་རང་ངོ།",
    "ཁྱེད་རང་ཀྱང་དེ་བཞིན་དུ་འདོད་པ་ལ་རྒྱུད་གསུམ་པོ་འདིའི་དགོངས་པ་མཐར་ཐུག་རྣམ་རིག་ཏུ་གནས་པའི་ཕྱིར་ན།",
    "དེ་དག་དུས་གཅིག་ཆར་དུ་འཇུག་པ་ནི།",
    "གཞི་དང་རང་བཞིན་འབྲས་བུ་དང་།",
    "ལམ་ཤེསཀུན་རྫོབ་ཤེས་དང་རང་དང་ལྔ།",
    "རང་རང་ཤེས་དང་ཟད་དང་མི་སྐྱེས་ཤེས།",
    "ཕྱི་མ་གསུམ་ནི་རིམ་བཞིན་རང་རང་དང་།",
    "ཟག་བཅས་ལེནཀྱང་རང་དམིགས་སྒོས་ཟག་མེད།",
    "རྙེད་སྲིད་སྤྲུལ་སེམས་གཉིས་དང་རང་ཉིད་དོ།",
    "རང་རང་ཟླ་བསྟུན་གསོ་སྦྱོང་དེར་མཐུན་ནོ།",
    "བདེན་བ་གཞན་གསུམ་གོང་དང་རང་ཁོ་ན།",
    "ངེས་ལྡན་གསུམ་དང་རང་ཉིད་བསྟན་པའི་བཞི་དང་ངེས་པར་ལྡན་པའི་ཕྱིར།",
    "ཁམས་གསུམ་པོ་གང་རུང་དེར་གཏོགས་པ་རྣམས་ཀྱི་ཐོབ་པ་ཡང་རང་ཁམས་གསུམ།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་འདུག་དང་།",
    "བོར་ནས་དེ་ཚེ་འདུག་པ་ནི།",
    "དབྱར་དགུན་གྱི་ཉིམ་ལྡོག་དུས་ཇི་ལྟ་བུཞེན།",
    "དུས་ཀྱ་ཐུངབ་མཐར་ཐུག་དུས་མཐའི་སྐད་ཅིག་མ་ཡིན།",
    "ཞིག་ནས་འདུག་པའི་བསྐལ་པ།",
    "མཛེས་པ་ཁ་དག་བཟང་ཞིང་རང་ལུས་ཀྱི་འོད་ཀྱིས་སྣང་བའི་བྱ་བ་བྱེད་པ།",
    "བེ་རོ་ཙ་ན་ནས་ལོ་ཆེན་རིན་ཆེན་བཟང་པོའི་སྐབས།",
    "སྟོན་པ་དེའི་གསུང་ལས་སྤྲུལ་པའི་དྲང་སྲོང་ཡིད་ལས་སྐྱེས་ཞེས་བྱ་བ་ཞིག་བྱུང་སྟེ་སྟོན་པ་ལ་སྤྲུལ་པ་དང་བཅས་པ་ཕྱག་དང་སྐོར་བ་བྱས་ནས་སེང་གེའི་ལྟ་སྟངས་ཀྱིས་སྟོན་པའི་མདུན་དུ་འདུག་སྟེ་འཁོར་གྱི་དྲང་སྲོང་རྣམས་དང་སྐྱེ་འགྲོ་ཐམས་ཅད་ཀྱི་དོན་དུ་ཞུ་བའི་ཚིག་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འཛམ་གླིང་རང་ལུས་འདོམ་གང་གྲུ་བཞི་སྟེ།",
    "ཞེ་སྡང་འདམ་རིང་རང་བཞིན་ངང་རྒྱུད་བཟང་།",
    "གཅེར་བུར་འདུག་དང་སྐྲ་དང་ཁ་སྤུ་བྲེགས།",
    "འབྱུང་འགྱུར་མ་འོང་བའི་དུས་སྐལ་བ་འཇིག་དུས་ཀྱི་རི་རབ་འཇིག་པ་དང་མཚུངས་སོ།",
    "ཉེས་གསུམ་རང་རང་གནས་སུ་འཕེལ་ཞིང་གསོག་པར་བྱེད་ལ།",
    "ཚུལ་ཕྱེད་པ་དང་དཀྱེལ་དུ་གྱུར་པ་བཞི་ལས་དེའང་རྒྱུ་ནི་རང་རང་སྐྱེད་པའི་རྐྱེན་ཡིན་ཏེ།",
    "སྐད་ཅིག་དུས་མཐའི་སྐད་ཅིག་མ་བརྒྱ་ཉི་ཤུ་ལ་བྱ་རྫོགས་མ་སྐད་ཅིག་གཅིག་ལ་སོགས་དེ་དྲུག་ཅུ་ལ་ཐང་ཅིག་དི་སུམ་ཅུ་ལ་ཡུད་ཙམ་ལ།",
    "གསུམ་ནི་དབྱར་ཉི་བློག་བབས་དུས་གསུམ་ལལྷོ་དང་དགུན་ཉི་ལྡོག་དུས་གསུམ་ལ་བྱང་དུ་འགྲོ་ཞེས་བྱ།",
    "གོས་བགོ་ཁང་པ་ལ་དྲི་བཟང་ཆུས་ཆག་ཆག་བཏབ་པར་འདུག།",
    "མུ་ཟི་སེར་པོ་བཅོས་མ་དང་རང་བྱུང་གཉིས་གདོན་འཇོམས་རྣག་ཁྲག་སྐེམ།",
    "ཁ་རུ་ཚ་བཅོས་མ་དང་རང་བྱུང་གཉིས་ཏེ་དང་ཙབས་རུ་ཚ་གཉིས་ཀྱིས།",
    "སྤྱོད་ལམ་གཉིད་ལོག་པ་དང་དལ་པར་འདུག་པ་དང་སེམས་དགའ་བ་སྐྱེད་པ་ལ་བརྟ།",
    "ཕ་མེས་ཀྱི་གདུང་བཙུན་ཞིང་རང་ཉིད་བློ་དང་ལྡན་ཞིང་དམ་ཚིག་ལ་གནས།",
    "ཡིད་འོང་སྙན་ཚིག་བསིལ་གནས་དལ་དེ་བར་འདུག།",
    "ཀ་ར་སྦྱར་༤ ༩༡བཏང་རང་རང་རྩ་ལ་གཏར།",
    "ས་ཁ་གཡོ་སྐྲངས་ཤིང་སོབ་པ་ཞིང་བརྐྱང་བསྐུམ་འགྲོ་འདུག་གྱོང་།",
    "འོན་ཀྱང་རང་བཞིན་རྒྱུ་ཡིས་འདུས་པ་དང་།",
    "དང་པོ་འཇུག་དུས་ཆུ་ཚན་ཆུ་སྐྱུར་སྐྱུག།",
    "ཅོང་ཞི་སྲས་ལ་བློན་པོ་གཉེན་པོ་མ་ནུ་མ་ནུའི་ཚབ་ལ་བསེ་ཡབ་བྱས་པའང་འདུག་འུ་སུ་སྟར་བུ་གསུམ།",
    "མེ་ཏོག་དང་པོ་ཆུ་སྐྱུར་སྐྱུག་དུས་སུ།",
    "རྒྱུ་བཤལ་སྐྱུག་དུས་ཙནྡན་གུར་གུམ་དང་།",
    "ཁྲག་རུལ་དུད་ཁུ་སྐྱུག་དུས་སེ་འབྲུ་དང་།",
    "དོན་ལྔ་རང་རང་རྩ་ལ་གཏར་བ་སྟེ།",
    "དལ་བར་འདུག་དང་མྱ་ངན་སེམས་ལས་དུབ།",
    "དཔེ་ལ་ལར་ཆུ་རྟ་བཞེད་པ་དངུལ་ཆུར་བཞེད་པ་དང་སྟག་ཤར་བཞེད་པ་སོགས་འདུག་ཀྱང་ཡོངས་གྲགས་འདི་ལྟར་རུ་རྟ་ཡིན་ཤིང་མངར་བུལ་ཏོག་སྦྲང་སྦྱར་བཏང་།",
    "དྲོ་བའི་གནས་འདུག་མི་རྔུལ་བག་ཙམ་བཅག།",
    "འཇིག་ཟས་ཉ་ཕག་རུལ་སུངས་སྒོ་ང་ཆང་སྐྱུར་སོགས་རྟ་ཞོན་ཉལ་པོ་འགྲོ་འདུག་དང་།",
    "སྤྱོད་ལམ་འདུག་རྗེས་དྲག་པོའི་ལས་བྱས་ཤིང་།",
    "རང་རྒྱུད་ཅན་དེ་ཁོ་རང་རྐྱང་བ་རྗེས་འདེད་ཚུལ་དུ་བཅོས།",
    "རླན་སྟེང་ཁ་ཡེད་ཡེང་མ་ཡིན་དབེན་པར་འདུག།",
    "རུས་བཅུད་གསུམ་སྲེ་ལོང་སོགཡུ་གཞུག་ཆུང་དང་གོ་སྟོད་སྒ་ཛཱ་ཏི་སྟེ་ཛཱ་ཏིའི་ཚབ་བུ་རམ་ཡང་འདུག་གསུམ་པའི་ཐང་།",
    "རྒྱུ་དང་རྐྱེན་དང་ཡུལ་དང་དུས་དང་རང་བཞིན་དང་ན་ཚོད་དང་།",
    "དེ་ལ་སོགས་པ་རྣམས་ཀྱིརིགས་ལ་ཚད་པའི་གཉའ་ཆག་དུས་སུ།",
    "ཚ་བ་ཆེ་བས་ཉལ་དང་སྙེས་དང་ཙོག་པུར་འདུག་ལ་སོགས།",
    "ནིའུ་ནེའུ་གསིང་ས་གཙང་ཟླ་འོད་བསིལ་གནས་འདུག།",
    "འགྲོ་འདུག་ལྡང་ཉལ་ལུས་ངག་རྩོལ་བ་སྤང་།",
    "ཆང་འཐུངས་འགྲོ་འདུག་རྗེས་ལ་རྐང་པ་ལྕི།",
    "དང་པོརྩ་རྒྱུད་མ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "སྤྱོད་ལམ་བསིལ་གནས་དལ་འདུག་གཉིད་མི་ལོག།",
    "༥ ༧ཀ་གང་ལ་བབས་པའི་རང་རང་སྒོས་རྩ་གཏར།",
    "དེའི་ལྔ་བརྒྱ་པ་ཕྲག་གཅིག་ནི་དུས་ཀྱི་ཐ་མ་སྟེ་སྙིགས་མ་ལྔ་བདོ་བའི་དུས་ཡིན་ང་སན་དུས་ཀྱི་ཐ་མར་གྱུར་ཙ་ན།",
    "གཉིད་ལོག་དུས་ན་ཟ་ཟི་བླ་འཚོལ་འབྱུང་།",
    "ཉིན་གཅིག་མི་གཏར་བཞི་པོ་རང་རང་རྩྭ།",
    "གསང་རྟགས་ནག་པོ་མུ་ཟི་འདི་གུ་གུལ་བྱས་པའང་འདུག་ཤུ་དག་གླ་རྩི་གསུམ་བཏང་བས་དངངས་པ་དང་འདར་ན་ཡིན།",
    "ཆམ་རིམས་སྨྱུང་བར་འདུག་ལ་ཆུ་སྐོལ་བཏུང་།",
    "ཏ་ཙ་གསེར་རྡོ་ཡིན་ཟེར་བ་དང་ལྷ་སྐུ་ཡིན་ཟེར་བའང་འདུག་ཤིང་མངར་ལྕགས་ཕྱེ་ཀ་ར་སྲུང་།",
    "མ་སྨིན་པར་འདུག་ན་གནོད་པའི་ཟས་ཀྱིས་སྨིན་པར་བྱ།",
    "ཙོག་པུར་འདུག་ན་ཐུར་ལ་འཐེན་པ་འདྲ།",
    "རློན་ལ་འདུག་དང་ཆུ་ཡི་ལས་བྱས་འབྱུང་།",
    "བཞི་པ་མཁལ་ཚད་ཆང་འཐུངས་འགྲོ་འདུག་བྱས་ཚེ་ན།",
    "བདུན་པ་མཁལ་གྲུམ་སྔོན་བུ་ཨ་རུ་རྒུན་འབྲུམ་ཟངས་རྩིའི་བཤལ་བཏང་རང་བྱུང་ཆུ་ཚན་གྱིས་ཆུ་ལུམས་བྱ།",
    "གཉིས་པའི་དང་པོ་ཕྲན་ཚེགས་འགྲངས་ངོམས་འདུག་རྗེས་དྲག་ཤུལ་འབྱུང་།",
    "དོན་ལ་ཐུག་དུས་ཚ་གྲང་གཉིས་སུ་ཁོང་དུ་བསྡུས་ཉུང་དུ་བསྡུས་ལ་ལག་ལེན་ང་དེ་བཞིན་གཉིས་སུ་གཉེན་པོ་རྣམས་སྤོས་དྲིལ།",
    "རའམ་ཤ་བའི་ཤ་སྣ་ཤེལ་སྣ་རྗེའི་དཔེ་རྙིང་རྣམས་སུ་འདུག་པ་ཞེས་ངོས་འཛིན་མ་མཐོང་བསྐོལ་ཁུར་སོ་ཆ་པི་པི་ལིང་།",
    "གཉིས་པ་དཔྱད་ཀྱིས་དབྱུང་བ་རྗེ་ཕྲིན་ལམ་ནས་དྲིལཝང་ཕུག་ནས་ཕྱིར་ཐོན་ནས་ལམ་དུ་འཁྱགས་ནས་འགགས་ན་གར་འདུག་པ་དེའི་སྤུབ་ཀྱི་གཡོན་དུ་རྡེའུ་ལ་བརྟེན་པ་བྱས་ལ་བཙག་ས་གཙང་།",
    "ཉིན་པར་གཉིད་ལོག་སྐྱིད་པར་འདུག་པ་དང་།་",
    "ཚིགས་དམིགས་ན་ཞིང་བརྐྱང་བསྐུམ་འགྲོ་འདུག་དཀའ།",
    "གཟེར་བ་བདེར་གནས་གོང་བུར་འདུག།",
    "སྤྱི་དོན་དང་པོ་རྒྱུ་ནི་སྟན་སྲབ་ཙོག་པུར་འདུག་པ་དང་།",
    "བཞོན་སྟན་རླན་སྟེང་ཡུན་རིང་འདུག་ཡན་ལག་བརྒྱད་པར།",
    "ཀ་ར་སྦྱར་བཏང་ས་བཅད་གསུམ་པ་གཏར་ག་འོག་ཏུ་འདུག་པ་འདི་ལྟར་ལ་སྐྱེད་ཆུང་ཨ་རུ་ར།",
    "བུ་སྣོད་འཇུག་པའི་ལག་ལེན་ཨི་ཏི་ཞེས་སོབསྟོད་ཉལ་ཏེ་འགྲོ་འདུག་ལངས་པ་སྤང་།",
    "འབྱུང་པོའི་གཟུགས་དང་རང་བཞིན་དང་།",
    "ལྷ་མིན་ཡོན་པོར་བལྟ་ཞིང་རང་བཞིན་ངན།",
    "བྱད་སྟེམས་ཤིང་ཤིང་དང་བོང་པ་སོགས་ཐོག་ཤིང་ཞེས་སོའཛིན་གཅེར་རྒྱུག་གནས་སྟོང་འདུག།",
    "ཁྱད་པར་རང་རང་འཛིན་པའི་དུས་སུ་བསྟེན་ན་། མན་ངག་རྒྱུད་ཀྱི་དཀའ་མཆན།",
    "དེའི་རྗེས་བསྡིགས་པས་སྐྲགས་ཏེ་ཡིད་ལམ་ལོག་པ་ནས་ཐོན་ཏེ་རང་གནས་སུ་འདུག་པསྲིད་དེ།",
    "ལུས་ལ་འབྱར་དང་གསེབ་ན་འདུག་པ་དང་།",
    "དང་པོ་གསོ་དཀའ་བ་ལ་གནས་དང་རང་བཞིན་རྐྱེན།",
    "གསུམ་པ་རྐྱེན་ནི་སྣུམ་དྲགས་ཟས་དམན་སྨྱུང་བར་འདུག།",
    "མཚོན་ཕོག་དུས་ན་འགྱེལ་བུབ་ཟ་ཟི་མེད།",
    "ཤིན་ཏུ་སྐྱོན་ཆེ་རྡོ་ཡི་རྒྱལ་པོ་སྦལ་རྒྱབ་དཀར་སྨུག་གཉིས་ཆིག་ཐུབ་དཀར་སྨུག་གཉིས་ཡིན་ཆིག་ཐུབ་འདི་མདུང་རྩེ་དཀར་སྨུག་བྱས་པའང་འདུག་བཞི།",
    "ལོ་མ་མེ་ཏོག་དུས་སུ་བཏུ།",
    "ཀླད་རྒྱའི་དར་ཐོག་ཏུ་རྣག་ཤོར་འདུག་པར་འགྱོངས་པའི་ལོང་མེད་པས།",
    "ཞག་གཅིག་བཞག་ལ་ནང་པར་བསལ་ལ་རུས་སྐྱོན་གང་འདུག་བརྟག།",
    "དེ་དུས་ཁྲག་རོ་ལུག་ཤིག་ཙམ་ཆོལ་ལེ་འདུག་ན་ལྷ་བས་བ་ནི་བྱེར་བའི་མནའ་བསྐྱལ་བ་ཡིན་པ་ས་ཕྱིར་མི་ལྡོག།",
    "ཁད་ལུས་སེར་འཁྲུལ་བའི་ཕྱིར་སྙམ་པའི་སྟན་ལ་ལུས་བསྲང་སྐྱིལ་ཀྲུང་འདུག།",
    "འདུག་སར་མི་ཚུགས་ཞག་དགུ་ཡི་དུས་ན་འཆི།",
    "ཚབས་ཆེ་ཁྲག་ཏུ་འཁྲུ་ལྕུག་ཕོག་དུས་འཆི།",
    "ཕྱེ་མས་བསད་པ་ཁྲག་དུས་སྐེམས་དང་འདྲ་སྟེ་འོག་ཏུ་སྟོན་ནོ།",
    "དང་པོ་ཁྲག་དུས་ཟུག་གཟེར་བཅག་པ་དང་།",
    "ཉི་མ་ལྔ་བསྐལ་པ་འཇིག་དུས་ད་ལྟའི་ཉི་མ་ལྔ་འགྱུར་གྱིས་ཚ་བ་ཤར་བས་རྒྱ་མཚོ་སྐེམ་པའི་དཔེ་དང་སྦྱར་ཡིས་རྒྱ་མཚོ་སྐེམས་པ་ལྟར།",
    "ཁད་མཉམ་སྟན་ལ་ལུས་བསྲིང་སྐྱིལ་ཀྲུང་འདུག།",
    "ཁྲག་དུས་ཆུ་སིར་དུས་དང་བ་ཆུ་དང་རྣག་དུས་སུ་ཆང་བསིངས་རྟ་ཡིས་བསྒྱུར།",
    "དེ་སྟེང་མཁན་པ་སྦང་མ་ལྕམ་དཔེ་རྙིང་ལས་ལྟ་བ་ཞེས་པ་འདུག་འབྲུ་གཡེར་མ་ཕབས་འཇིབས་སུ་གཞུག།",
    "གཞུག་དུས་དབྲལ་དུས་དམ་དང་ལྷོད་པའི་སྐྱོན།",
    "ཤ་ཡི་སྟེང་འཕྱང་རང་སར་སྡོམ་པའི་ཁྲེསྔ་མ་དང་འདྲ་སྟེ་སྒོ་གཅིག་ཏུ་སྟག་མགོ་ཅན་ནོ།",
    "བཞི་པ་གཞུག་དུས་རྨ་ཡི་སྐྲངས་དང་ཚ་བ་ཆོགས།",
    "གཉིས་པ་བཙལ་བའི་ཐབས་ལ་རྨ་གསར་བ་མདའ་ཕོག་དུས་ཀྱི་སྡོད་ལུགས་གང་ཡོད་ལྟར་བརྡུང་།",
    "ཁྲག་དུས་བྲགསྐུ་ཧ་བོ་ཧོང་ལེན་ཨ་བྱག་དང་།",
    "རྣག་དུས་བསེ་རུ་བྲག་སྤོས་ཅོང་ཞི་དང་།",
    "གསུམ་པ་ཁྲུས་ནི་དང་པོ་རྣག་དུས་བུལ་ཏོག་ཆུ་ཡིས་བཀྲུ།",
    "གར་འདུག་དེ་ཡི་སྟེང་དུ་མེ་ཏོག་སྣ་ཚོགས་ཀྱི་ལུམས་བྱ་ཞིང་།",
    "རྔ་དང་རང་འཐག་ལ།",
    "རྩ་རྒྱུད་མ་ངེས་ཇི་ལྟར་འདུག་གྱུར་ཀྱང་།",
    "མེ་ཉི་བསིལ་གྲིབ་སྙེག་ཅིང་དེ་རྣམས་སུ་ཡུན་རིང་འདུག་མི་ཚུགས།",
    "རང་བབས་ཀྱི་བཤལ་དང་རང་བབ་ཀྱི་ཇུལ་བྱུང་ན་སྦྱང་མི་དགོས།",
    "གཅིག་ཉི་ཕྱེད་ཆབ་ཚས་དབུལ་རྔུལ་དབྱུང་བར་བྱའོ་རྒྱུསུ་སྣེ་ལ་འདོད་ལུགས་འགའ་ཞིག་ཡོད་ཀྱང་རང་ལུགས་སྒེའུ་སྒོ་བཟང་ཞིང་ལོ་མ་རྒྱ་ཆེ་ལ་རྒྱ་སྣེ་དང་།",
    "ཉ་དང་སྒོ་ང་འབྲུ་མར་སོ་འོ་མ་ཟེར་བའང་འདུག་མ་འམ།",
    "ཟླུམ་པོར་འདུག་པ་ལུས་འཁྱིལ་ཞིང་།",
    "བི་རོ་རྣམ་པར་སྣང་མཛད་ཙ་ན་ཨོག་བཛྲས་རྡོ་རྗེ་སེམས་དཔའ་ཏཱ་ཧཱུཾ།",
    "སྐམ་རློན་སྙོམས་ཤིང་ཚ་བསིལ་ཡིད་དང་མཐུན་པ་བདེར་བར་གྱུར་པས་རོ་ཙ་ནུས།",
    "མ་དང་རང་རྩ་དར་ན་རབ་ཏུ་བཟང་།",
    "དེ་དག་གང་ཡང་རང་རྩ་དར་དུས་སུ།",
    "ཡང་ན་མ་དང་རང་རྩ་གཞི་ལ་གནས།",
    "རང་རང་ཡུལ་ལུགས་དང་སྦྱར་ཏེ་གང་ལ་གང་འཚམ་པས་བཅོསས།",
    "གཉིས་ཀ་འཁྱིག་ཅིང་མི་འཕར་པ་སྡོད་ན་རང་ཉིད་མི་ཐེངས་གཅིག་ཙམ་མི་འཕར་སྡོད་ན་གོད་ཀ་ཁ་དང་རང་ལ་ཁ་སྨྲས་ཁ་མཆུ་ལྟེབ་གྲི་རུ་འཆི།",
    "ལྡོག་དུས་བསྟན་པ་ནི་ལྡོག་དུས་རླངས་མ་ཡལ་བར་ལྡོག་པ་ནི་ཚབ་ཡིན།",
    "སྟག་ཟིལ་ལ་དཀོན་པོ་འདུག་མདངས་སེར་སུལ་མང་ཕོ་ཅོང་འདྲ།",
    "ཡང་ན་ཛཏེ་རྒྱུད་སྔོན་གནོད་སྦྱིན་གྱི་རིགས་ཀྱི་བུ་རྟ་རྒོད་མའི་གདོང་པ་ཅན་ཞིག་སྐྱེས་པ་དེས་ཁ་ཟས་ཅི་ཟོས་ཀྱང་མི་ཞུ་བ་མེད་པ་ཞིག་བྱུང་བ་དེ་དང་མཚུངས་པར་འདུག་གོསྦྱིན་རྒོད་མ་ཁལྟ་བུའི་སྦྱོར་བ་ནི།",
    "ཕྱི་མ་རྒྱུད་ཀྱི་དཀའ་མཆན་གསུམ་ག་བསྲེག་དུས་གར་སླ་གཟུགས་བཏུབ་ཙམ་འཕང་ལོ་བྱ།",
    "ཞག་དུས་སུ་བསྲོས་ཀྱིན་ཞག་གསུམ་བར་དུ་ངཞག།",
    "ཞེས་གསུངས་སོཅན་འབིགས་བྱེད་བསིལ་དྲོད་རང་རང་པ་དེ་གནས་སུ་སྐྱེས་པའི་ཕྱིར།",
    "བཅུ་པའི་ཁཎྜ་ཞེས་སྔོན་གྱི་མལས་པ་རྣམས་བརྡ་ཆད་མཛད་འདུག་ཁཎྜ་ལེགས་པོ་ནི་སྦྱོང་རྣོ་ལ་ལུས་ཟུངས་ལ་མི་གནོད་པར་འཇམ།",
    "མི་སྨྲཞིང་མི་འགུལ་པར་ཙོག་པུར་འདུག་པ་དང་།",
    "གཏོང་དུས་མི་སྨྲ་ལུས་མི་གྲངས་བར་གོས་དྲོ་བར་གྱོན་ཙོག་པུར་འདུག་པར་བྱ།",
    "པོ་ཊ་ལའི་པར་མ་འདི་ཉིད་ཀུན་གྱིས་ཡིད་རྟོན་པའི་གནས་སུ་རུང་བར་འདུག་པ་ལྟར།",
    "རང་རང་དགའ་སའི་ཁ་ཕྱོགས་འཚོལ་སྟངས་ཀྱི་།",
    "ཉེར་གཅིག་དུས་ཀྱི་འགྲོས་དང་བསྟུན་ཏེ་མང་གཙོའི་གསོལ་རས་དམངས་ལ་བསྩལ་།",
    "བཞུགས་ཁྲིའི་མདུན་ཐང་རང་ཕྱག་གསུམ་འཚལ་བའི།",
    "དམར་དམར་གྱི་ཐུ་སྣེ་བཟེད་དགོས་མི་འདུག།",
    "ཡིད་འོང་བཞིན་རས་ལ་འཛུམ་གྱིས་འཁྱུད་འདུག།",
    "ཐམས་ཅད་ཤིང་སྡོང་བཞིན་དྲན་མེད་བརྒྱལ་འདུག།",
    "ངོ་གདོང་ནག་པོའི་འཇིགས་རྔམ་ཁྲོད་ནས་གོམ་པའི་འདེགས་འཇོག་རྒྱབ་ལ་ཕྱོགས་འདུག།",
    "མཉམ་འགྲོ་མཉམ་སྡོད་བྱུང་བ་དྲན་ན་བདེ་སྐྱིད་ཡིན་འགྲོ།",
    "ཁེར་རྐྱང་གཅིག་པུ་རང་ལྷག་འདུག།",
    "ད་ནི་ནུབ་ནས་ནུབ་ཏུ་བཞུད་རན་མིན་འགྲོ།",
    "ད་ལྟ་ཉེར་གཅིག་དུས་ཀྱི་རྐང་རྗེས་ཟིན་ན།",
    "འཕྲིན་གྱི་རྒྱབ་རྩར་འགྲེང་ནས་འདུག་ས་བཙལ།",
    "ག་ས་གང་ནས་འབད་པ་མེད་ན་གདོང་དམར་བོད་པ་ཚར་རན་འདུག།་",
    "ཡོད་ཚད་གངས་རིའི་ངོགས་ན་འདར་སིག་རྒྱག་དུས།",
    "རྔམ་སྟོན་ཁྲོམ་སྐོར་གསེབ་ན་མེ་ལྕེ་ལྷབ་ལྷབབཙན་པོའི་བརྟུལ་ཕོད་བསྙེགས་པའི་འདུན་མ་ལོས་ཡིན།",
    "སྡུག་དང་སྐྱོ་བ་འདྲེས་རུང་བཟོད་བསྲན་བྱས་འདུག།",
    "དེ་དག་ད་དུང་ཡང་རང་སར་བཞག་སྐད།",
    "མ་འདུག་མ་འདུག་མགོན་དང་སྐྱབས་མཛོད་ཅིག།",
    "འགྲུལ་བཞུད་ཐེངས་གཅིག་ཙམ་གྱི་མཐོང་སྣང་རང་ཙམ་ལས།",
    "དམར་ནག་རྒྱ་ཡིས་ཧམ་ཟས་བྱེད་དོན་ངོ་མ་དེ་ནས་བྱུང་བར་གདའ།",
    "འགྲོ་སྟངས་འདུག་སྟངས་ལ་ཟུར་བལྟས་བྱེད་ཚེ།",
    "ཁྱེད་ཀྱི་ཞལ་རས་ལ་ཁྲོ་ཉམས་བབས་འདུག།",
    "མཇུག་མ་དེ་འདྲ་ཞིག་ནས་ཟད་ཚོད་གདའ།",
    "ཉིན་མཚན་ཀུན་ཏུ་ལས་ལ་བརྩོན་ཡང་རང་དོན་སྒྲུབ་པའི་མཐུན་འགྱུར་ཞིག།",
    "ཉེར་གཅིག་དུས་ཀྱི་འཚོ་བ་སྐྱེལ་སྟངས་འདི་ཨེ་ཡོང་།",
    "དགྲ་གཉེན་དང་རང་གཞན་སོ་སོར་མེད་པའི།",
    "ཆེ་ཆེ་རྫིག་རྫིག་བྱས་ནས་འདུག་བཟོད་ཅིག་ཨེ་ཡོང་།",
    "རྙིང་ཞེན་ཕྱོགས་ལྷུང་ཆེ་བའི་ཨུ་ཚུགས་འདི་རླག་དུས་།",
    "ད་ལྟ་བསམ་ན་སྒྱུ་རྩལ་རྩོམ་རིག་ལ་རྩོམ་ལུས་ཀྱི་རྣམ་དབྱེ་མང་དུ་ཕྱེས་འདུག་ཀྱང་ཡར་དེད་ན་སྙན་ངག་ཙམ་ལ་ཐུག་འགྲོ་ཞིང་།",
    "ང་རང་བཞུད་འགྲོང་རང་བཞུད་འགྲོ།",
