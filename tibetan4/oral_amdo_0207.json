    "བདག་གིས་ཤིན་དུ་ལས་ངན་བགྱིས་པས་ན།",
    "དེད་དཔོན་སྟོབས་བཅུ་ཉོན་མོངས་མེད་པ་རྣམས།",
    "ཉོན་མོངས་འཇོམས་པའི་ཤེས་རབ་གང་བསྟེན་པ།",
    "ཁྱུ་མཆོག་གྱུར་ཅིང་འཇིག་རྟེན་རི་མོར་བྱས།",
    "དག་ཅིང་རབ་རིབ་མེད་པའི་མིག་གིས་བལྟ།",
    "ཁྱོད་ལ་རྣམ་པ་མང་པོས་བསྒོ་བར་བགྱིས།",
    "ཁྱོད་ཀྱི་སྲོག་གི་བར་ཆད་འབྱུང་ཏ་རེ།",
    "ཁྱོད་ནི་གང་གི་དོན་དུ་བྱོན་པ་ཡི།",
    "བགྱི་བ་གང་ཕྱིར་ཁྱོད་ནི་འདིར་བྱོན་པ།",
    "བདག་ནི་མགོན་མེད་ཁྱོད་ལ་སྐྱབས་སུ་མཆི།",
    "རང་གི་སྲོག་ཀྱང་བཏང་སྟེ་འདིར་བྱོན་ན།",
    "བདག་གིས་དཔའ་བོ་དུམ་བུ་དུམ་བུར་བཅད།",
    "བདག་ནི་འཇིགས་སྐྲག་ཁྱོད་ལ་ཅི་གསོལ་པ།",
    "བུ་དང་བཙུན་མོ།",
    "དྲང་སྲོང་མཆོག་ལུས་བུད་ཤིང་བསྲེགས་གྱུར་ཚེ།",
    "ཤིང་གི་གྲིབ་བསིལ་ལྡན་བའི་དྲུང་དུ་ནི།",
    "ལྷག་པར་གཅིག་གིས་གཅིག་ལ་འགྲན་པ་བཞིན།",
    "དེ་རེ་ཞིག་ན་རི་དགས་གཤོར་བའི་ཕྱིར།",
    "དེ་ཡང་གོ་མཚོན་འོད་འབར་བ་ཐོགས་པའི་དམག་གིས་ནི་བསྐོར་རལ་གྲི་དང་འཕྱར་བ་དག་ནི་སྔོན་བཞིན་དུ་འགྲོ།",
    "སྒྲ་སྙན་ཅིང་ཆེ་བའི་རོལ་མོ་མང་པོ་ནི་བརྡུང་།",
    "ཉམ་ཏོ་ཆོརི་དགས་བལྟ་བའི་ཕྱིར་ཕྱོགས་ཀུན་ཏུ་མིག་གིས་བལྟས།",
    "རྒྱལ་པོས་དེ་དག་ག་ལ་བ་དེར་སོང་ནས་རབ་ཏུ་དགའ་བར་གྱུར་ཏེ་འདུག་གོ།",
    "དེར་རྒྱལ་པོས་ཀྱང་དགེ་སློང་དག་གི་སྤྱོད་ལམ་ལ་བལྟས་ཏེ།",
    "རྒྱལ་པོ་ཡང་འདི་ལྟར་སྙམ་མོ།",
    "གལ་ཏེ་བསད་ནའང་ཇི་ལྟར་འགྱུར་མི་ཤེས་སོ་སྙམ་མོ།",
    "བསམས་པ་ངེས་པར་མ་བསད་ན་གནོད་པར་འགྱུར་སྲིད་པས་འདི་དག་གིས་སྨྲས་པ་ལ་ཉན་ནོ་ཞེས་ངེས་པར་ཡིད་ལ་བྱས་སོ།",
    "དེའི་ཚེ་རྒྱལ་པོ་དེའི་ཕྱི་བཞིན་འབྲང་བའི་ལྷ་མོ་ཞིག་ཚེ་རབས་མང་པོ་ནས་ལྷན་ཅིག་ཏུ་སྤྱོད་པ་སྤྱད་ཅིང་།",
    "འདི་དག་གིས་སྨྲས་ཕྱིན་ཅི་ལོག་པ་སྟེ།",
    "དེར་རྒྱལ་པོས་ལྷ་མོ་དེས་ལེགས་པར་སྨྲས་པ་ཐོས་ནས་སེམས་ལོག་པ་ལས་སླར་ལོག་ཏེ་རྒྱལ་བའི་བསྟན་པ་གཏོང་བར་མ་གྱུར་ཏོ།",
    "རྒྱལ་པོའི་ནུའོ་མ་རུངས་པ་ཉེ་འཁོར་གྱི་རྒྱལ་པོ་བྱེད་པ་ཞིག་ལ་ཕྲ་མའི་ཚིག་གིས་སྦད་དེ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
