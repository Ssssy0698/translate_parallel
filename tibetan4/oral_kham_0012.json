    "དེ་ན་ངས་མི་རྒྱབ་ནག་པོར་འདུག་པ་ཞིག་མཐོང་སྟེ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་དགེ་སློང་དེས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འདུག་པ་དང་།",
    "ཆ་གཉིས་ཀྱི་བར་དུ་ནི་རང་ཉིད་འདུག་གོ།",
    "དེ་གཉིས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་ལས།",
    "ཇི་ཙམ་ན་ཝ་བཞིན་རྒྱས་ཞེས་བྱ་བ་དེ་གཉིས་ཀྱི་དྲུང་དུ་འོངས་ནས་དེས་སྨྲས་པ་ཚ་བོ་དག་ཅི་སྟེ་སེམས་ཁོང་དུ་ིཆུད་ཅིང་འདུག།",
    "དེ་དང་ཧ་ཅང་ཡང་མི་རིང་བ་ཞིག་ན་བྲམ་ཟེ་རྒན་པོ་ཞིག་ཡོད་པ་དེས་ཐོས་ནས་དེ་རྒན་པའི་མཐར་འདུག་སྟེ།",
    "དམ་མ་བཅས་པའི་དགེ་སློང་རྣམས་ཟན་བྱིན་ནས་རྒན་པའི་མཐར་འདུག་ལ།",
    "གུམ་པ་དེའི་ཡོ་བྱད་གདའ་བ་དང་མི་གདའ་བ་མཆིས་པ་འདི་ལགས་ཏེ།",
    "ཇི་ཙམ་ན་ཝ་ཞིག་དུས་ཀྱི་ཞགས་པས་བཅིངས་ནས་ཕྱོགས་དེར་འོངས་ནས་དེས་རོ་དེ་དག་ཐམས་ཅད་མཐོང་ངོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཉིད་ཀྱིས་ཕྱེ་བ་དང་སྦྲུལ་ཞིག་མགོའི་གདེངས་ཀ་ཆེར་བྱས་ནས་འདུག་གོ།",
    "༢ ༥ ༣ཆེན་པོ་མ་དྲོས་པ་ནས་ཡན་ལག་བརྒྱད་དང་ལྡན་པའི་ཆུས་གསེར་གྱི་རིལ་བ་བཀང་སྟེ་རི་སྤོས་ཀྱི་ངད་ལྡང་ལས་ས་བླངས་ནས་མྱུར་བ་མྱུར་བར་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འོངས་ཏེ་འདུག་ནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཡུམ་བདག་དུས་འདི་སྲིད་ཀྱི་བར་དུ་སྔོན་སུ་ལ་ཡང་འགའ་ལ་ཁྲོས་པ་མཆིས་སམ།",
    "༢ ༦༣ཞིང་འདུག་པ་ལས་རྒྱལ་པོས་ཕུ་བོ་ཞ་བ་དེ་མཐོང་ངོ།",
    "སླར་ཡང་མཚམས་ན་འདུག་པ་རྣམས་དང་ལྷན་ཅིག་བགོ་བར་བྱ་སྟེ།",
    "སླར་ཡང་མཚམས་ན་འདུག་པ་རྣམས་དང་ལྷན་ཅིག་བགོ་བར་བྱ་སྟེ།",
    "སླར་ཡང་མཚམས་ན་འདུག་པ་རྣམས་དང་ལྷན་ཅིག་བགོ་བར་བྱ་སྟེ།",
    "སླར་ཡང་མཚམས་ིན་འདུག་པ་རྣམས་དང་ལྷན་ཅིག་བགོ་བར་བྱ་སྟེ།",
    "དེ་ནས་རྒན་པའི་མཐར་འདུག་ནས་ས་བརྐྱང་བླངས་ཏེ།",
    "དགེ་སྐོས་ིལ་ཁྲུས་ཀྱི་བུམ་པ་སྟོང་པར་འདུག་གོ་ཞེས་བསྒོ་བར་ིབྱའོ།",
    "དགེ་སྐོས་ལ་ཚེ་དང་ལྡན་པ་ཁྲུས་ཀྱི་བུམ་པ་སྟོང་པར་འདུག་གོ་ཞེས་བསྒོ་བར་བྱའོ།",
    "དེས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་ག་སོལ་ཏོ།",
    "ཅང་མི་སྨྲ་བར་འདུག་པར་བྱ་བ་གང་ཡིན་པ་དེས་སླར་སྨྲའམ་ཞེས་དེ་རྣམས་ཀྱིས་དེ་ཐག་བཅུག་ནས་ཅང་མི་སྨྲ་བར་ིའདུག་གོ།",
    "མཚམས་ཀྱི་ནང་དུ་འདུག་སྟེ་བསླང་བ་ིམི་གསོལ་བ་དང་།",
    "མཚམས་ཀྱི་ནང་དུ་འདུག་སྟེ་བསླང་བ་གསོལ་བ་དང་།",
    "མཚམས་ཀྱི་ིནང་དུ་འདུག་ནས་བསླང་བར་གསོལ་ཏེ།",
    "མཚམས་ཀྱི་ནང་དུ་འདུག་ནས་བསླང་བ་ེགསོལ་པ་དང་།",
    "སྟན་གཅིག་ལ་ཡང་ལྷན་ཅིག་འདུག་པར་བྱེད།",
    "དེ་ིསྐད་ཅེས་སྨྲས་པ་དང་རི་ནག་པོའི་བྲམ་ཟེ་དང་ཁྱིམ་བདག་རྣམས་མིག་གནམ་དུ་བལྟས་ནས་འདུག་གོ།",
    "དགེ་སློང་གནས་བརྟན་རྣམས་དང་ལྷན་ཅིག་ཏུ་ལམ་ཀར་འདུག་ལ་གླེང་བར་བྱེད་པའི་དགེ་སློང་བསྐོ་བར་བྱ་སྟེ།",
    "ཤེས་ལྡན་དག་ཅི་སྟེ་སྟན་ཡང་མི་འདིངས་ཁ་ཟས་ཀྱང་མི་གཡོ་བར་སེམས་ལས་ཆུང་ངུར་འདུག།",
    "མཚམས་ཀྱི་ནང་དུ་འདུག་ནས་བསླང་བ་གསོལ་བར་བྱེད་དེ།",
    "སྟན་ཆེས་དམའ་བ་བླངས་ཏེ་འདུག་པར་བྱའོ།",
    "བསྙེན་པར་མ་རྫོགས་པ་རྣམས་ཀྱི་གོང་དུ་སྤྱོད་ལམ་ཞི་བས་འདུག་སྟེ།",
    "སྤོས་པ་གཉིས་དང་རང་བཞིན་དུ་གནས་པ་གཉིས་ཀྱིས་༡མ་ཡིན།",
    "སྤོས་པ་གཅིག་དང་རང་བཞིན་དུ་གནས་པ་གསུམ་གྱིས་མ་ཡིན་ཏེ།",
    "སྤོས་པ་བཅུ་བརྒྱད་དང་རང་བཞིན་དུ་གནས་པ་གཉིས་ཀྱིས་མ་ཡིན་པ་ནས།",
    "སྤོས་པ་གསུམ་དང་རང་བཞིན་དུ་གནས་པ་གཅིག་ལ་མ་ཡིན།",
    "སྤོས་པ་གཉིས་དང་རང་བཞིན་དུ་གནས་པ་གཉིས་ལ་མ་ཡིན།",
    "སྤོས་པ་གཅིག་དང་རང་བཞིན་དུ་གནས་པ་གསུམ་ལ་མ་ཡིན་ཏེ།",
    "དེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དེ་གླེང་བའི་སྐབས་ལ་བབ་པ་ཡིན་ཞིང་དགེ་སློང་དེ་རྣམས་ཀྱང་དེ་བཞིན་དུ་འདུག་བཞིན་ལ།",
    "དགེ་སློང་དེ་རྣམས་ཀྱང་དེ་བཞིན་དུ་འདུག་བཞིན་ལ།",
    "དགེ་སློང་དེ་རྣམས་ཀྱང་དེ་བཞིན་དུ་འདུག་བཞིན་ལ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་དགེ་སློང་རབ་ཏུ་མང་པོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དགེ་སློང་དག་དུས་ཚིགས་ནི་ལྔ་པོ་འདི་དག་ཡིན་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "དེ་དུས་གཞན་ཞིག་ན་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་ནས་མ་མའི་པང་ན་འདུག་སྟེ་ཕྱིར་བྱུང་བ་དང་།",
    "བདུན་པ་ལེགས་སྐྱེས་ཞེས་ིབྱ་བ་དེའི་ཆུང་མ་རིགས་མཉམ་པ་ལས་ཆུང་མ་བཙལ་ན་མ་རྙེད་ནས་དེ་འགྲམ་པ་ལ་ལག་པ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "སེམས་ལས་ཆུང་ངུར་འདུག་ཤིག་དང་།",
    "༤༦༩བདག་ཕྱུག་པ་ནོར་མང་བ་ལོངས་སྤྱོད་ཆེ་བ་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་དང་མཚུངས་པ་གཞན་ཞིག་གནས་པ་དེའི་ཁྱིམ་དུ་ཞུགས་ནས་སྒོ་ཁང་དུ་འདུག་སྟེ་སྨྲས་པ་བཀྲ་ཤིས་པར་གྱུར་ཅིག།",
    "དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ས་ཕྱོགས་འགའ་ཞིག་མ་ཡོག་པས་མ་བཀྲམ་པ་ཉིད་དུ་འདུག་གོ།",
    "དེ་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་དོན་དེ་སེམས་ཤིང་ཡུད་ཙམ་ཉིཅང་མི་སྨྲ་བར་འདུག་སྟེ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "སྤྱོད་ལམ་ཞི་བས་སེང་གེའི་ཁྲི་ལ་འཛེགས་ནས་འདུག་པ་དང་།",
    "འཁོར་ཐམས་ཅད་སེམས་མི་གཡེང་བར་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་ལ་རྟོག་ཅིང་འདུག་གོ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་དེ་རྣམས་ཀྱི་གདུལ་ིབའི་དུས་ཤེས་ནས་དེ་དང་ཉེ་བའི་ཤིང་དྲུང་ཞིག་ན་འཆག་ཅིང་འདུག་པ་ལས་དེ་རྣམས་ཀྱིས་དེ་མཐོང་ནས་དེ་རྣམས་ཀྱིས་བསམས་པ།",
    "དབེན་པ་ན་འདུག་པས་འདི་གསད་པའི་དུས་ནི་འདི་ཡིན་ནོ་སྙམ་ནས།",
    "དེ་རྣམས་ཀྱིས་དེའི་དྲུང་དུ་དོང་ནས་བསྐོར་ཏེ་འདུག་གོ།",
    "ཕྱོགས་གཞན་ཞིག་ཏུ་འདུག་ལ་སྦྲེངས་ཤིག།",
    "དེས་ཕྱོགས་གཞན་ཞིག་ཏུ་འདུག་སྟེ་སྦྲེངས་པ་དང་།",
    "དེའི་ཚེ་བྲམ་ཟེའི་ཁྱེའུ་ཕྱུགས་སྟེན་ཞེས་བྱ་བ་འཁོར་དེ་ཉིད་དུ་ཚོགས་ཤིང་འདུག་པར་གྱུར་ནས་དེས་སྨྲས་པ།",
    "འདུག་པ་ལ་བརྟག་པ་ལྷུར་ལེན་ཅིང་རྗེས་བཞིན་འབྲང་ངོ།",
    "ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་མཐོང་བཞིན་དུ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ལ་ལར་ནི་སྔ་དྲོ་འདུག་པར་བྱའོ།",
    "གཙུག་ལག་ཁང་འདིར་འདུག་ལ་རྙེད་པ་གང་ཡིན་པ་དེ་ནི་ཁོ་བོའི་ཡིན་ནོ།",
    "དེ་སྟོང་པ་ཉིད་དུ་འདུག་པ་ཇི་ིཙམ་ན་ཁྱིམ་བདག་དེས་མཐོང་ནས་དེས་གཙུག་ལག་ཁང་དུ་འོངས་ནས་སྨྲས་པ།",
    "དེ་ནི་སྟོང་པར་འདུག་གོ།",
    "སྐལ་བའི་གཙུག་ལག་ཁང་འདིར་འདུག་གོ།",
    "དེ་སྐྱེངས་ནས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ཤིང་དང་གསིང་མ་འདུག་གནས་དང་།",
    "ཚེ་དང་ལྡན་པ་ཉེ་དགའས་མཇལ་ཏོ་ཞེས་བྱས་ནས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ཇི་ཙམ་ན་ཞག་དྲུག་གམ་བདུན་ན་གནས་མལ་འགྱེད་པར་གྱུར་པ་ིན་རྐང་པ་རྨ་བྱུང་བ་ལྟར་བྱས་ཏེ་གོས་ཀྱིས་དཀྲིས་ནས་འདུག་པ་དང་།",
    "དེ་གནས་མལ་བསྐོས་ཟིན་ནས་རྨའི་གཡོགས་མ་བོར་ཏེ་འདུག་གོ།",
    "དགེ་སྦྱོང་དང་བྲམ་ཟེ་གཞན་རྣམས་ཀྱི་སྤྱི་བོ་ན་འདུག་པ་ཡིན།",
