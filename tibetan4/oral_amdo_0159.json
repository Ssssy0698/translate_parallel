    "ཡུམ་གཅིག་གིས་ཞལ་ཟས་ཀྱི་རྣམ་པ་ཅིག་ཞིག་འདྲེན་གིན་གྱིས་འདུག་པས།",
    "གཞན་གྱི་སྤང་བྱ་ཁྱོད་ཀྱིས་ལོངས།",
    "དེ་ཉིད་དུ་གཉིད་སད་དེ་བདག་གི་ལུས་ཉམས་སྦྲུལ་གྱི་ལྤགས་པགས་པ་བུད་པ་བཞིན་དུ་སོང་ནས་འཇའ་ལུས་སུ་སོང་བ་སྙམ་བྱེད་པ་བྱུང་སྟེ།",
    "ད་ཁྱོད་དང་མི་འགྲན་ཟེར་ནས་ཁོ་ཉན་དུ་མ་འདོད་གསུངས།",
    "ང་ལ་མོས་གུས་གྱིས།",
    "ཐམས་ཅད་ཀྱིས་དབྱུག་པ་རེ་ཟུང་།",
    "དེ་ནས་ཁྲུལ་པ་དང་མི་ལིག་གི་སྣང་ངོར་རྒྱལ་པོ་གཅིག་འོང་པའི་སྣང་བ་བྱུང་སྟེ།",
    "ངེད་ཀྱི་བོད་ལ་གནོད་པ་མ་བྱེད་ཟེར་ནས་མ་ཧཱ་བོ་དྷིའི་དྲུང་དུ་སོང་།",
    "དཀོན་གཉེར་ཀུན་ན་རེ།",
    "ཡང་ཉིན་གཅིག་གི་ཚེ་ཤམྦྷ་ལ་ལྟ་བར་འདོད་ནས།",
    "དེར་འདི་པ་སྤྲུལ་པ་ཡིན་ཡོད་པར་འདུག་སྙམ་ནས་མོས་གུས་བྱས།",
    "སྔར་ཐོས་མ་མྱོང་པའི་བའི་རོལ་མོའི་སྒྲ་དཔག་ཏུ་མེད་པ་ཅིག་ཞིག་གྲགས་པས།",
    "སྔར་ཡང་འདི་བཞིན་བྱས་པས་ཡོང་གིན་ཡོད་པས་དེ་འདྲོགས་ལ་གཉིད་བསྒུགས།",
    "ཁོ་ཅི་ཟེར་ལྟོས་ཅིག་ཤིག་གསུངས་ནས།",
    "གཟིགས་སྟངས་ཅུང་ཟད་ཅིག་མཛད་ཀྱིན་འདུག་ཙ་ན།",
    "ཁོ་རང་གི་ལས་དང་བག་ཆགས་ཀྱི་རང་གཟུགས་ལ་ཡང་འོང་།",
    "མཚན་མོ་འོད་གསལ་གྱི་ངང་ལ་འདུག་པ་ན་བུད་མེད་མཚར་སྡུག་འོད་དུ་ཆགས་པ།",
    "དེར་ཁོང་གཉིས་ཀྱིས་རྒྱ་གར་བའི་འདོ་ལི་ལ་བཏེག་པ་སྙམ་བྱེད་པ་ཞིག་གི་ཁ་ལ་བསིལ་བ་ཚལ་དུ་སླེབས་བྱུང་པས་བས།",
    "དེར་ཕྱོགས་བཞི་ན་མཁའ་འགྲོ་མའི་གཙོ་མོ་བཞི་སྐུ་ལ་རྟེན་པ་ལྟར་དུ་བཞུགས་འདུག།",
    "དེའི་སྟེང་དུ་སྟག་གི་ལྤགས་པ་གཅིག་བཏིང་ནས་དེའི་སྟེང་དུ་ང་བཞག།",
    "ལུས་ཟག་མེད་ཀྱི་བདེ་བའི་བས་གང་བ་ལྟར་སོང་།",
    "སླར་ངན་སོང་དུ་འཇུག་པ་ལ་ཚེགས་མེད།",
    "དགྲ་འཆི་བདག་གི་ཕོ་ཉས་བཟུང་དུས་ན།",
    "འཁོར་གཡོག་གིས་སྨྲེ་ངག་འདོན།",
    "སྤྱོད་པ་བུ་ཆུང་གི་བསམ་པ་བཞིན་དུ་ཞེན་མེད་ཅིག་དགོས་པ་ལགས།",
    "དེ་ལྟར་བྱས་པས་འབྲས་བུ་རེ་དོག་དོགས་ཐམས་ཅད་དང་བྲལ་བ་མངོན་དུ་འགྱུར་བ་ལགས།",
    "དེ་རང་གི་སྟེང་དུ་གློད་བཞག་པས།",
    "རྐྱེན་སྣང་དྲག་པོས་ལྟེམས་པའི་དུས་སུ་འགལ་རྐྱེན་དེ་མི་སྤོང་བར་ཁོ་རང་གི་སྟེངས་སུ་མ་ཡེངས་པའི་ངང་དུ་མ་སྒོམ་བསྒོམས་པར་རི་བཙུགས་པ་བཞིན་ལྟག་ཚན་བསྐྱེད་ནས་སྡོད་དགོས་པ་ལགས།",
    "དེ་རང་གི་ངོ་ཐོག་དུ་ཏུ་གློད་དེ་ཟུང་འཇུག་གི་ངོ་བོ་རང་རིག་རང་གསལ་གྱི་ངང་ལ་འཇོག་པ་ལགས་གསུངས།",
    "ཁོང་གྲོངས་པ་དང་ཁོང་རང་གི་སྲས་པོ་སློབ་དཔོན་རིན་དཔལ་གྱི་ཕྱག་ན་ཡོད་པ།",
    "གཞོན་པ་ཐལ་ཐོལ་དུ་སོང་ནས་དྲུང་དུ་འགྲོ་བ་མ་བྱུང་།",
    "ད་རྗེ་ཨུ་རྒྱན་པའི་དོད་པོ་ཁྱོད་ལ་རེ་བ་ཡིན་པས།",
    "ཁོང་གི་ཕྱག་ན་འདུག་པ་རྣམས་ཀྱང་ངེད་ལ་གཏད་པ་ལགས།",
    "དེ་ནས་ཟླ་བ་སེང་གེ་ཞེས་བྱ་བ་བདག་གིས་གསུང་སྒྲོས་སིལ་བུ་རྣམས་དཀྱུས་གཅིག་ཏུ་བསྒྲིགས་པ་ལགས་སོ།",
    "འཕགས་པའི་གང་ཟག་གིས་ཀྱང་རྟོགས་པར་དཀའ་ཞིང་།",
    "ཐུགས་དམ་གྱི་ལྷ་མང་པོ་ཞལ་གཟིགས་ཤིང་དངོས་གྲུབ་བརྙེས་པ་ཞིག་ལགས་སྐད།",
    "ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མ་ཡིན་ཞེས་གྲགས་པ་དེ་གཉིས་ཀྱི་སྲས་སུ་ལྕགས་ཕོ་སྟག་གི་ལོ་ལ་སྐུ་འཁྲུངས་སོ།",
    "དག་པའི་ལྷ་ཚོགས་ཀྱི་ཞལ་གཟིགས་པ་ཡང་།",
    "བཅོམ་ལྡན་འདས་བདེ་མཆོག་ལྷ་དྲུག་བཅུ་རྩ་གཉིས་ཀྱི་དཀྱིལ་འཁོར་ཞལ་གཟིགས་པའི་ཚུལ་དང་།",
    "ཡང་སྐྱི་རོང་ཤེལ་རི་ན་བཞུགས་པའི་དུས་སུ་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་རྣལ་འབྱོར་མ་ཞལ་གཟིགས་ཤིང་ལུང་བསྟན་པ་དང་།",
    "ཡང་དུས་གཅིག་ན་འཇམ་དཔལ་ཨ་ར་པ་ཙ་ནའི་ཞལ་གཟིགས་པ་ལ།",
    "རྗེ་ཉིད་ཀྱིས་འཇའི་ནང་དུ་སྤྱན་རས་གཟིགས་ཀྱི་ཞལ་གཟིགས་པ་དང་།",
    "གཙོ་བོའི་ཕྱག་གི་པདྨ་ལ་སོགས་པའི་རྣམ་པ་ཐམས་ཅད་གསལ་བར་ཉམས་སྣང་ལ་གཟིགས་པ་དང་།",
    "འདི་དག་གི་ཡང་ཚུལ་རྒྱས་པར་གཞན་དུ་ཤེས་སོ།",
    "དཔལ་ལྡན་ལྷ་མོ་ལ་སོགས་པ་རྣམས་ཀྱིས།",
    "ལྷ་འདྲེ་གདུག་པ་ཅན་གཞན་གང་གིས་ཀྱང་མ་ཐུལ་བ་རྣམས་དམ་ལ་བཏགས་ཤིང་།",
    "སྐུ་ལུས་ལ་གཟིགས་པ་མི་མངའ་བར་ས་ལ་བརྡབ་ཅིང་།",
    "གཙུག་ལག་ཁང་གི་ཞབས་ཐོག་མཛད་པ་ནི་མྱ་ངན་ལས་མ་འདས་ཀྱི་བར་དུ་མཛད་དེ།",
    "དེ་དག་གི་ཞབས་ཐོག་ལ་དམིགས་པའི་ཕྱག་རྫས་ཀྱི་དངོས་པོ་རྒྱ་ཆེན་པོ་གནང་བ་ནི་ཕྱོགས་མེད་དུ་མཛད་པ་དང་།",
    "དེ་ཡང་ཕ་རོལ་གྱི་སྔོན་གྱི་སྐྱེ་བ་མཁྱེན་པའམ་གཟིགས་པ་ནི།",
    "མཇལ་བ་རང་གིས་ཀྱང་ཤིན་ཏུ་དད་པར་གྱུར་ཏེ།",
    "སླར་ཡང་མོས་གུས་ཐུན་མོང་མ་ཡིན་པ་དང་།",
    "དེ་རང་དུ་རོ་གཅིག་གི་རྟོགས་པ་ཐུན་མོང་མ་ཡིན་པ་རྒྱུད་ལ་སྐྱེས་ཏེ།",
    "གཅེན་པོ་ལ་ཁྱོད་ཀྱིས་ས་གཙང་ས་ཅིག་ཞིག་ཏུ་རི་ཁྲོད་ཅིག་ཐོབ་དང་།",
    "ཁྱོད་ཀྱིས་འཐུངས་འདུག་པ་གསུངས་པས།",
    "དང་པོ་ཞལ་མཇལ་བ་རང་གིས་དད་པ་ཙམ་མ་བྱུང་བ་ལ།",
    "དེ་ནུབ་རང་ལ་གཉིད་འོད་གསལ་དུ་སོང་ཞིང་།",
    "གསུང་གི་རྣམ་འགྱུར།",
    "འདི་དག་གི་ཡང་ཚུལ་རྒྱས་པར་གཞན་དུ་ཤེས་སོ།",
    "དེ་དག་གི་འཁོར་ན་གནས་པའི་དཔོན་མོ་དང་།",
    "བྱམས་པ་སྔོན་དུ་འགྲོ་བའི་ཟང་ཟིང་གི་སྦྱིན་པ་དང་།",
    "དམག་གི་རྩོམ་པ་བཤོལ་བ་ལྟ་བུ་དང་།",
    "ཅི་དང་ཅི་ཡི་སྒོ་ནས་སྲོག་གི་འཇིགས་པར་འགྱུར་བ་སྲོག་ལས་སྐྱོབ་པར་མཛད་པ་སྟེ།",
    "ལྷ་འདྲེ་གདུག་པ་ཅན་གྱིས་མི་ནོར་ལ་འཚེ་བ་ཡང་ཞི་དྲག་གི་སྒོ་ནས་གནོད་པ་ལས་གྲོལ་བར་མཛད་པ་དེ་སྟེ།",
    "ཁྱོད་ཀྱིས་མདང་ཞག་གང་དུ་སྡོད་བསྡད་གསུངས་པས།",
    "ཁྱོད་ལ་འཇིགས་སྐྲག་གི་སྣང་བ་མ་བྱུང་ངམ་གསུངས་པས།",
    "བདེ་བ་ཅན་གྱི་ཞིང་གི་ཡོན་ཏན་གསུངས་ནས།",
    "དེ་མ་ཐག་དྲུང་དུ་ཡོད་པ་ཐམས་ཅད་ཀྱི་སེམས་རྟོག་མེད་དུ་སོང་བ་བྱུང་སྐད།",
    "འདི་ལ་ཁྱོད་ཀྱི་བུ་བྱེད་པ་ཡིན་ནོ་གསུངས་པས།",
    "ཕྱིས་མོ་ལ་བུ་སྐྱེས་པ་བེ་རིའི་སྐྱེ་བ་ཡིན་པར་ཤེས་པ་སྟེ།",
    "ཡང་གར་ཤ་བ་དར་མ་འོད་རྒྱལ་ཁམས་སུ་ཤི་ཟེར་བས་སྡུག་གེ་ཁོ་ལ་རེ་ས་གཞན་མེད།",
    "བུ་མོས་དྲི་གོས་དེ་ངན་པས་ངོ་ཚ་ནས།",
    "གཟིམས་ཁང་གི་མདུན་གྱི་ཟམ་ཆུང་འོག་ཏུ་སྦས་ནས།",
    "རང་གི་གོས་ཅིག་ཤིག་དྲི་གོས་བྱས་པས།",
    "དགུག་གིས་མི་ལང་འདུག་གསུང་།",
    "ཇོ་མོ་བྱད་བཞིན་སྐྱ་ཁོ་རེ་བ།",
    "ཡང་རིན་རྡོར་གྱི་མ་རྒན་མོ་ས་སྐྱ་ནས་ཡར་འོངས་པའི་ལམ་དུ་ཤི་ནས་བདུན་ཚིགས་ཞུ་རུ་བྱུང་བས།",
    "རྒན་མོ་གོས་དམར་པོ་གྱོན་པའི་སྡུག་སྡུག་འདྲ་ཅིག་ཞིག་འདུག་གསུང་སྟེ།",
    "དེ་ལྟ་བུ་སྔ་མའི་བག་ཆགས་ཀྱི་ལུས་ཇི་ལྟར་ཡོད་པ་མངོན་སུམ་དུ་གཟིགས་པ་དང་།",
    "བྱང་བུ་བྲིས་པ་ལ་སྐུད་པ་སྔོན་པོ་ཞིག་གིས་བཏགས་ཏེ།",
    "གཤིན་པོ་གཞན་ཞིག་གི་ཆོ་ག་ཞོར་ལ་གཏོང་བར་ཞུས་པས།",
    "མིང་བྱང་བྲིས་མ་ཐག་སྦྱིན་བསྲེག་གི་མེ་ཐབ་ཏུ་བསྐྱུར་བས།",
    "གཤིན་པོ་དེ་མི་དཀར་པོ་ཅིག་ཞིག་གིས་ཁྲིད་སོང་།",
    "ཡང་བསྐྱར་ཏེ་མིང་བྱང་སྦྱིན་བསྲེག་གི་མེ་ཐབ་ཏུ་བསྐྱུར་རོ།",
    "དེ་ལྟར་གཤེད་པོའི་འཚེ་བ་ཇི་ལྟར་ཡོད་མངོན་སུམ་དུ་གཟིགས་པ་སྟེ།",
    "ཁྱོད་ཀྱང་རོ་སྙོམས་ཀྱིས་གསུངས་པས།",
    "དེ་མ་ཐག་ཁྱིམ་བྱ་དེ་སྦྱིན་བསྲེག་མཛད་པའི་མེ་དམར་ཧུར་རེ་བ་ན་ཞུགས་ནས།",
    "མེ་ཚུབས་ཁྱེ་རེ་འདུག།",
    "ན་བཟའི་ཁུད་དུ་འོངས་ནས་ཏིང་ངེ་འཛིན་ལ་སོང་འདུག།",
    "ཕྱག་གིས་བྱིལ་མཛད་ནས་ཐུགས་གཏད་པས།",
    "སྒོམ་དུ་སོང་ནས་ཡུན་རིང་འདུག་སྐད།",
