    "ལིག་ཅུན་ས་ཆའི་མི་ཆེན་གྱི་སྐྱེས་བུ་རྣམས་ཁྲིད་དེ་ལྕེ་ཧི་གཙང་པོའི་ནུབ་ཕྱོགས་སུ་སོང་ལ།",
    "གཡུལ་དུ་མཁོ་ཆ་རྣམས་མཛོད་དུ་མངའ་བས་དེ་ནས་ལོངས་ཤིག་ཁྱོད་ཅག་ཞི་དྲག་དཔོན་བློན་རྣམས་གཡུལ་ལས་རྒྱལ་བར་འདོད་ན་བསམ་པ་གཅིག་མཐུན་གྱིས་ཤིག་དམག་ལ་མཁས་ན་ཇུས་དང་བསྟུན་པས་ཆོག་ཁྱོད་ཚོས་རང་རང་གི་ས་ཆ་སྲུང་ལ་ས་བཙན་སར་སྒར་ཐོབས།",
    "མྱུལ་རྟོག་གི་བྱ་བ་རྣམས་ལེགས་པར་གྱིས་ལ་ཕན་ཚུན་ལ་གཞོགས་འདེགས་བྱོས།",
    "གནག་ལུག་གོ་ཆ་སོགས་བགྲང་གིས་མི་ལངས་པ་ཐོབ།",
    "ཏང་ཞང་གི་རྟ་ལུག་དེད་དེ་ལོག་ཟླ་བཅུ་པར།",
    "ཡུག་ཀྲིག་གི་དམག་མི་སྟོང་ལྔ་འཐབ་ཏུ་བཏང་བ་ལ།",
    "ཅན་ཀྲུང་གི་ཁྲི་ལོ་དང་པོའི་ཟླ་བཞི་པར།",
    "བྷོད་དམག་གི་དཔུང་ཆེན་ཞིག་ཁག་གསུམ་དུ་བགོས་ནས་རྒོལ་དུ་བྱུང་།",
    "བྷོད་ཀྱི་བཟུང་དམག་ལྔ་བརྒྱ་ལྷག་ལ་མི་རེར་གྱོན་ཆས་ཆ་ཚང་རེ་སྤྲད་དེ་ཁྲེ་ལུན་གྱིས་བྷོད་དུ་བསྐྱལ།",
    "ཐང་གིས་བྷོད་དམག་ཕྱིར་སྤྲོད་པ་ལ་དང་ཐོག་བྷོད་པ་རྣམས་ཡིད་མ་ཆེས།",
    "བྷོད་པ་རྣམས་ཀྱང་ཐང་གི་ཟིལ་ལ་འཇིགས་ཤིང་དྲིན་ཀྱང་ཆེ་བར་སྙམ།",
    "ཁྱོད་ཕེབས་རྒྱུ་ཡིན་པ་ངས་མ་ཚོར།",
    "དེར་བཙན་པོ་ན་རེ།",
    "སི་ཁྲོན་གྱི་དམག་གིས་བྷོད་ཀྱི་བཟུང་དམག་གོང་མར་རྩིས་སྤྲད།",
    "གོང་མ་ན་རེ།",
    "དེར་བཟུང་དམག་རྣམས་ལ་གོས་དར་ཡུག་གཉིས་རེ་དང་གོན་རྒྱུ་ཆ་ཚང་རེ་སྤྲད་དེ་ཕྱིར་བཏང་།",
    "མགྲོན་ཁང་དུ་བཞུགས་སུ་གསོལ་ཅིང་རོལ་མོ་སོགས་ཀྱིས་ཚིམས་པར་བྱས།",
    "ཅན་ཀྲུང་གི་ཁྲི་ལོ་གཉིས་པའི་ཟླ་བཅུ་གཉིས་པར།",
    "བྷོད་དུ་སོང་བའི་ཕན་ཀོན་གྱི་ཐབས་ཡོད་པ་ཁྲང་ལུའུ་བྱ་བ་དང་བྷོད་ཀྱི་ཕོ་ཉ་བ་བློན་སྟག་སྒྲ་སོགས་སྟོད་ནས་ཐང་གི་ཁབ་ཏུ་འབྱོར།",
    "ངེད་ནས་ཀྱང་དབོན་ཁྱོད་ལ་སྐྱེས་ཤིག་གནང་ཡོད་པས།",
    "རྩིས་ལེན་གྱིས་ཤིག་ཞེས་བྲིས་འདུག་ངེད་བྷོད་ཆེན་པོའི་རྒྱལ་ཁབ་དང་ཁྱོད་ཐང་གི་རྒྱལ་ཁབ་ནི་དབོན་ཞང་གི་ཁབ་གཉིས་སུ་མཆིས་པ་ལ།",
    "ཁྱོད་ཚོས་ངེད་ཅག་འབངས་ལ་རྩིས་ནས་བཀའ་འབེབས་དོན་ཅི་ཡིན།",
    "ང་ཚོའི་བར་གྱི་མཚམས་ནི།",
    "ཐང་གི་ཕོ་ཉ་བ་བྷོད་དུ་ཡོང་ན།",
    "བཙན་པོ་དབོན་དང་ཐང་གི་ཕོ་ཉ་བས་མཇལ་དུམ་བྱེད་ཅིང་།",
    "ཅན་ཀྲུང་གི་ཁྲི་ལོ་གསུམ་པའི་ཟླ་བཞི་པར།",
    "བྷོད་ཀྱིས་ཐང་གི་བཟུང་དམག་དང་།",
    "ཐང་གིས་བྷོད་ཀྱི་བཟུང་དམག་བཏང་བར་ལན་མཇལ།",
    "བྷོད་དུ་མངགས་པའི་ཕོ་ཉ་བ་ཏེན་ཀྲུང་ཧྲའོ་ཅན་དང་ཡུས་ཧྲི་ཀྲུང་ཁྲིན་གཅིག་ལྕོགས་ཚོས་ཧན་ཧིན་བྱ་བ་བྷོད་ཀྱི་ཕོ་ཉ་བ་ཁྲི་དགྲ་བཙན་དང་ལྷན་དུ་ཐང་གི་ཁབ་ཏུ་འབྱོར།",
    "དེ་དུས་བྷོད་ཀྱི་བློན་ཆེན་ཞང་རྒྱལ་གཟིགས་བྱ་བ་གཏུམ་ལ་སྲོག་གཅོད་པར་དགའ་བ་ཞིག་ཡོད་པ་དེས་སྔར་ཅན་ནན་ནས་དམག་ཕམ་པའི་དགྲ་ཤ་ལེན་དུ་འདོད་ནས་ཐང་དང་འདུམ་བྱེད་པར་མ་འཐད།",
    "ཞང་རྗེ་བཙན་བྱ་བ་ཞང་རྒྱལ་གཟིགས་ཀྱི་ཚབ་ཏུ་བློན་ཆེན་པོར་བཅུག་ཐང་དང་འདུམ་བྱེད་རྒྱུའི་ཐག་བཅད་ཅིང་།",
    "ཏུའུ་ཀོན་ཡོན་ཕྲེ་ལང་གི་ཐབས་ཡོད་པ་ཧྲུན་ཙེ་བྱ་བར་ཡུས་ཧྲི་ཀྲུང་ཁྲིན་དང་།",
    "ལུང་ཡུག་གི་ཅེ་ཏུའུ་ཧྲིའི་ཐབས་ཡོད་པ་ཀྲང་དབྱི་བྱ་བ་ཡང་མཇལ་དུམ་དུ་མངགས།",
    "ཞང་རྗེ་བཙན་དང་མཇལ་ཏེ་ཕྱི་ལོའི་ཟླ་དང་པོའི་ཚེས་བཅོ་ལྔ་ཉིན་ཆིན་ཧྲིས་ནུབ་ཕྱོགས་སུ་མཇལ་དུམ་བྱ་རྒྱུའི་ཆད་བྱས་ཅན་ཀྲུང་གི་ཁྲི་ལོ་བཞི་པའི་ཟླ་དང་པོར།",
    "ཕྱོགས་གཉིས་ཀས་མི་ཉིས་སྟོང་རེ་མཇལ་དུམ་དུ་མངགས་རྒྱུ་དང་།",
    "གོ་མཚོན་ཐོགས་པའི་དམག་མི་ཆིག་སྟོང་རེ་ཡོང་ཆོག་ཀྱང་།",
    "དེ་བཞིན་མཇལ་དུམ་དུ་ཞུགས་པའི་ཐང་གི་དཔོན་རིགས་ཚོས་ཧན་ཧིན་དང་།",
    "ཐང་གི་མཇལ་དུམ་གྱི་བཀའ་གཙིགས་ནང་འཁོད་དོན།",
    "ཐང་གི་གོང་མ་དང་བྷོད་ཀྱི་བཙན་པོ་གཉིས་ལོ་རབས་མང་པོར་གཉེན་གྱི་འབྲེལ་ཡང་བཟང་།",
    "དབོན་ཞང་གི་ཁབ་ཏུ་ཆགས་ནས་ལོ་ངོ་ཉིས་བརྒྱ་ཙམ་འདས།",
    "དེའི་རིང་ལ་གྱོད་གཞི་ཆུང་བ་རེ་བྱུང་སྟེ།",
    "གཉེན་གྱི་མཛའ་བ་དོར་ནས་རེ་ཞིག་དགྲ་ཡི་ཟླ་བོར་གྱུར།",
    "ཕན་ཚུན་གྱི་ཕོ་ཉ་འགྲོ་འོང་གིས་འདུམ་པའི་མཐུན་རྐྱེན་སྦྱར་བས།",
    "དེང་ཡང་འུ་ཅག་གིས་དེ་ལྟར་བགྱིད།",
    "ངེད་ཐང་གིས་ས་མཚམས་ཀྱི་འབངས་ལ་བདེ་བ་ཐོབ་ཏུ་རེ་ནས་སྔོན་གྱི་ས་ཆ་རྣམས་ཀྱང་མ་བརྩད།",
    "དེང་ངེད་ཐང་གི་ས་མཚམས་ནི།",
    "ལུང་ཀྲིག་གི་ནུབ་ཕྱོགས་ནས་ཆིན་གྲོས་ཞན་བར།",
    "ཧྲིན་ཀྲིག་གི་ནུབ་ཕྱོགས་ནས་ཐུང་ཀུའུ་ཞན་བར།",
    "ཅན་ནན་ནུབ་མཐའི་མོ་ཞེ་ཡུལ་གྱི་མན་པ་རྣམས་དང་།",
    "དང་མའི་ཞིན་ཆོན་ཅུན་ནས་བྱུང་གི་མྱ་ངམ་ཐང་བར་དང་།",
    "རོལ་མོས་རམ་འདེགས་མི་བྱེད་ཅིང་།",
    "དེ་ནས་རང་རང་གི་དངོས་རྫས་ཕུལ་ཏེ་ལྷ་ལ་མཆོད་བསྟོད་བྱས།",
    "དེར་གོང་མས་སླར་ཡང་ཚོས་ཧན་ཧིན་བྱ་བ་བྷོད་ཀྱི་བཙན་པོའི་དྲུང་དུ་བརྫངས་པ་ཡིན་ནོ།",
    "མཇལ་དུམ་མ་བྱས་གོང་གི་ཉིན་གཉིས་པར།",
    "ཀོན་པོ་བྱ་བས་པུས་མོ་ས་ལ་བཙུགས་ཏེ་བཀའ་གཙིགས་ཀྱི་ཡི་གེ་བཀླགས།",
    "ཡུག་སན་ཆི་ཁྲང་ཧྲི་དང་ཡུས་ཧྲི་ཏ་ཧྲུའུ་གཅིག་ལྕོགས་ཡུས་ཆི་བྱ་བ་ཅིན་ཀྲིག་གི་ནུབ་ཕྱོགས་སུ་བྷོད་ལ་ཁ་ཏ་བྱེད་དུ་མངགས།",
    "དེ་དུས་བྷོད་ནས་དམག་མི་མངགས་ཏེ་ཐང་གི་གྲོགས་ཏན་བྱེད་ཟེར་བས།",
    "ཧུང་ཇན་དང་བྷོད་ཀྱི་བློན་མང་ལོད་བྱ་བ་གཉིས་ཀྱིས་འཁོར་རྣམས་ཁྲིད་དེ་ཝུའུ་ཀུང་གི་ཝུའུ་བྷིན་ཁྲོན་ཞེས་པའི་ས་ཆར།",
    "ཅེ་ཏུའུ་ཧྲི་སོ་སོ་དང་ཅུན་དང་ཀྲིག་གི་དམག་དཔུང་རྣམས་ཀྱིས་མཁར་སྒོ་བརྒྱབ་ནས་སྲུང་བ་ལས་རྒོལ་ལན་སྤྲོད་མ་ཐུབ།",
    "ད་དུང་ཧི་ཀྲུང་གི་ཅེ་ཏུའུ་ལོ་ཡོན་ཀོང་བྱ་བར་ཞན་དབྱང་དུ་ཡོང་ནས་ཁོ་ཚོར་གྲོགས་ཏན་བྱེད་དགོས་པའི་བཀའ་ཕབ།",
    "ས་མཚམས་གཏན་འཁེལ་བྱེད་དགོས་ཞེས་ཞུས་པས་གོང་མས་ཁང་ཁྲིན་བྱ་བ་བྷོད་དུ་མངགས་པ་རེད།",
    "སྦྱིན་ཞང་ཅེ་ཏུའུ་ཧྲིའི་ཐབས་ཡོད་པ་ལིས་ཁྲིན་བྱ་བས་ལག་འོག་གི་དམག་དཔོན་ཝང་པིས་བྱ་བ་མངགས་ཏེ་མཚན་མོ་ཞིག་ལ་བྷོད་ཀྱི་སྒར་ཐོག་ཏུ་བརྒྱུགས་པ་དང་།",
    "བྷོད་ཀྱི་དཔུང་ཆེན་ཁྱོད་ཀྱི་མཁར་བརྒྱུད་ནས་འགྲོ་བ་ཡིན་པས།",
    "ཁྱོད་ཀྱིས་སྔ་གཞུག་གཉིས་ལ་མ་རྒོལ།",
    "གྱོང་ཆེན་པོ་རག་ངེས་རེད།",
    "དེ་བས་བྷོད་དམག་གི་དཔུང་སྔ་མ་བཤར་ཚར་རྗེས།",
    "སྟག་དང་གཟིག་ལྤགས་གྱོན་པ་མཐོང་ཚེ།",
    "ལིས་ཁྲིན་གྱིས་འཁོར་རྣམས་ཁྲིད་དེ་རྒོལ་དུ་སོང་སྟེ་ཞག་གང་བོར་འཐབ་མཐར་བྷོད་དམག་ཕྱིར་ལོག་ཟླ་བཅུ་པར།",
    "ཡན་ཀྲིག་གི་ཚི་ཧྲིའི་ཐབས་ཡོད་པ་ཏུའུ་ཡན་ཀོང་བྱ་བས་གཡག་དེད་ཆང་ཁྱེར་ནས་བསུ་བ་བྱས།",
    "བྷོད་དམག་ན་རེ།",
    "ངེད་ཅག་ཁྱོད་ཚོའི་མཁར་དུ་སྡོད་རྒྱུ་ཡིན་པས།",
    "མཁར་གྱི་མི་རྣམས་རང་མོས་སར་སོང་ཞིག་ཟེར་བ་ལ།",
    "ཏུའུ་ཡན་ཀོང་གིས་འཁོར་རྣམས་ཁྲིད་དེ་ཧྥུའུ་ཀྲིག་ལ་སོང་།",
    "དེ་གའི་ཚི་ཧྲིའི་ཐབས་ཡོད་པ་ཐོ་པ་ཆན་ཧོས་བྱ་བས་མཁར་གྱི་མི་རྣམས་ཁྲིད་དེ་གཞན་དུ་སོང་བས་མཁར་དེའང་བྷོད་དམག་གིས་བཟུང་།",
    "སོ་སོར་དམག་མི་ཆིག་སྟོང་ལྷག་རེ་མཁར་སྲུང་དུ་བཞག་ཞང་རྗེ་བཙན་རང་ཉིད་ཀྱིས་དཔུང་ཆེན་ཁྲིད་དེ་མཱིན་ཧྲ་ཡུལ་དུ་སྒར་བཏབ།",
    "དམག་ཁག་གཅིག་མངགས་ཏེ་རྨ་ཆུའི་ཕར་ཚུར་དུ་ལོ་ཡོན་ཀོང་གི་དམག་དང་གཞོགས་འདེགས་བྱས་ཏེ།",
    "བྷོད་ཀྱི་གཡོ་གཏམ་ལ་ཡིད་ཆེས་ཏེ་བློན་དགྲ་བཞེར་དང་བསྡོངས་ནས་གོང་མའི་དྲུང་དུ་སོང་།",
    "མ་སོས་གོང་མའི་དྲུང་དུ་སོང་རྗེས།",
    "ཐང་གི་དམག་ཁག་རྣམས་མཁར་དུ་བསྡད་ནས་དམག་མ་བྱས།",
    "ཚོས་ཧན་བྱ་བ་མཱིན་ཧྲི་ནས་ཕྱིར་ལོག་དང་ཐོག་ཚོས་ཧན་བྱ་བ་མཱིན་ཧྲ་ལ་སོང་ནས་ཞང་རྗེ་བཙན་ལ་མཇལ་བ་ན།",
    "ཞང་རྗེ་བཙན་ན་རེ།",
    "ཝུའུ་ཀུང་དུ་ངེད་ཀྱི་དམག་གིས་ཀྲུའུ་ཚི་ཡི་དམག་དཔུང་ཕམ་པར་བྱས་ཀྱང་སྐྱེས་མ་ཐོབ་པས་དེ་ལེན་དུ་འོངས་པ་ཡིན།",
    "ཐང་གིས་ཁང་ཁྲིན་དང་ཝང་ཀྲིན་གཉིས་མངགས་ན་ཡང་།",
    "ངས་ཐང་གི་བློན་ཆེན་ཞིག་འོངས་ཚེ་གནས་ཚུལ་རྣམས་གསལ་བོར་བརྗོད་ཆོག་བསམ་མོད།",
    "ཁྱོད་ཚོའི་བློན་ཆེན་གཅིག་ཀྱང་མ་འོངས་པས།",
    "གལ་ཏེ་ང་ཚོ་སླར་ཡང་མཇལ་དུམ་བྱེད་ཟེར་ན།",
    "མཇལ་དུམ་གྱི་ཉི་མ་དང་ས་ཆ་ནི་ཁྱོད་ཚོ་གང་དགའ་བྱས་ཆོག་ཁྱོད་ཕྱིར་ལོག་རྗེས་གོང་མ་ལ་ཞུས་ནས་ཐག་བཅད་ན།",
    "ངེད་ཀྱིས་ཡན་ཀྲིག་དང་ཞ་ཀྲིག་གཉིས་ཀྱང་ཁྱོད་ཚོར་ཕྱིར་སྤྲད་ཆོག་ཅེས་ཟེར་བ་དང་།",
    "ད་ལྟ་ངེད་བྷོད་ཀྱི་བློན་ཆེན་དང་དམག་དཔོན་སོགས་མི་ཉེར་གཅིག་མཇལ་དུམ་དུ་འོངས་ཆོག་ཁྱོད་ཚོའི་ལིན་ཀྲིག་གི་ཅེ་ཏུའུ་ཧྲིའི་ཐབས་ཡོད་པ་ཏུའུ་ཞི་ཆོན་བྱ་བ་དེ་ངང་རྒྱུད་འཇམ་ཞིང་གཞུང་རྒྱུད་དྲང་བ་ཞིག་ཡིན་ཚུལ་ངེད་ཀྱིས་ཀྱང་ཤེས།",
    "ཁྱོད་ཚོས་ཁོང་མཇལ་དུམ་གྱི་གཙིགས་འཛིན་པར་གཏོང་རོགས་གནང་།",
    "ཅིན་ཀྲིག་གི་ཙེ་ཏུའུ་ཧྲིའི་ཐབས་ཡོད་པ་ལི་ཀོན་བྱ་བའང་གཙིགས་འཛིན་པར་ཤོག་ཅེས་ཟེར།",
    "ཚོས་ཧན་བྱ་བས་བྷོད་དམག་ཁ་ཤས་སླུ་བྲིད་བྱས་ཏེ་སྟོད་དམག་གི་གནས་ཚུལ་དྲིས་པ་ན།",
    "རང་གི་གོ་གནས་དང་བྲལ་མི་རུང་།",
    "ངེད་ཀྱིས་སི་ཀྲུང་གི་ཐབས་ཡོད་པ་ཧུང་ཇན་བྱ་བ་མཇལ་དུམ་གྱི་ཕོ་ཉར་མངགས་པ་ཡིན་ཞེས་བཤད།",
    "དེ་ནི་གོང་མ་བྷོད་ཀྱི་སྐད་ཆ་དེར་སྐྱོན་ཡོད་པར་དོགས་ནས་ཀྲིག་དེ་གཉིས་ཕྱིར་སྤྲོད་མིན་ལ་བརྟག་པ་རེད།",
    "སི་ཞུན་ཡོན་ལྔ་ལང་གི་ཐབས་ཡོད་པ་ཀྲིན་ཧུའུ་ཅུས་བྱ་བ་ཕན་ཀོན་དུ་མངགས།",
    "ཡོན་ཀྲིག་གི་ཐུའུ་ལིས་ཧྲུའུ་བྱ་བའི་ས་དེར་མཇལ་དུམ་བྱས་ན་དགའ་ཞེས་ཟེར་ཞིང་།",
    "སྔོན་ལ་ཙོ་ཧྲིན་ཚེ་དམག་དཔོན་མ་ཡུག་ལིན་བྱ་བ་ཞིག་ཡོད་པ་དེ་ན་རེ།",
    "ཐུའུ་ལིས་ཧྲུའུ་ས་བཙན་པས་བྷོད་དམག་ཡིབ་ཡོད་ན་ང་ཚོར་གྱོང་རག་ངེས་རེད།",
    "སྐབས་དེར་བྷོད་ཀྱི་ཕོ་ཉ་བ་བློན་ཁྲི་བཙུན་བྱ་བ་བྷོད་ལ་འཕྲིན་གསོལ་དུ་སོང་ཚར་ཡང་།",
    "དང་ཐོག་དུང་ཇག་དང་ཞང་རྗེ་བཙན་གཉིས་ཀྱིས་དམག་མི་སུམ་སྟོང་རེ་མངགས་ཏེ་མཇལ་དུམ་གྱི་སྟེགས་བུའི་ཤར་ནུབ་ཏུ་སྡོད་རྒྱུ་དང་།",
    "དམག་མི་མ་ཡིན་པ་བཞི་བརྒྱ་རེ་མཇལ་དུམ་སྟེགས་བུའི་གཤམ་དུ་འཇོག་རྒྱུའི་གྲོས་བྱས།",
    "བྷོད་ཀྱི་བྱ་ར་བ་རྣམས་ཀྱིས་ཐང་གི་དམག་དཔུང་ལ་མྱུལ་རྟོག་བྱས།",
    "ཁྱོད་ཚོས་གོས་ལྭ་སོགས་བརྗེས་ལ་འདིར་ཅུང་ཟད་ངལ་གསོས་ཞེས་ཟེར།",
    "འཛིན་གཟུང་བྱེད་བདེ་བའི་ཆེད་དུ་རེད།",
    "ཧུང་ཇན་དང་ཚོས་ཧན་ཧིན།",
    "ཧུང་ཇན་གུར་གྱི་ཕྱི་ལོགས་སུ་སོང་བ་ན།",
    "ཅུང་མ་འགོར་བར་བྷོད་དམག་གིས་མཐའ་བཞི་ནས་བསྐོར།",
    "ཞིན་རོང་གི་དམག་ཤུགས་ཟད་པས་མགོ་འཛུལ།",
    "སུང་ཧྲུན་ཁྲའོ་དང་ཧུང་ཇན་ལག་འོག་གི་ཕན་ཀོན་གྱི་ཐབས་ཡོད་པ་ཧན་ཡན་བྱ་བ་གཉིས་ཀྱང་དམག་ཏུ་བཀྲོངས།",
    "ཚོས་ཧན་ཧིན་གྱི་ལག་འོག་གི་ཕན་ཀོན་གྱི་ཐབས་ཡོད་པ་ཀྲིན་ཧྲུའུ་ཅུ་དང་།",
    "ཧི་ཏུང་བཅས་ཀྱི་དམག་དཔོན་མོན་རི་ཧཱ།",
    "དང་ཐོག་བྷོད་དམག་གིས་ཚོས་ཧན་ཧིན་ལ་གྲིས་རྒྱག་དུས།",
    "ཁོ་བོ་ནི་ཐང་གི་ཕོ་ཉ་བ་ཚོས་ཧྲང་ཧུའུ་བྱ་བ་ཡིན།",
    "གལ་སྲིད་ཁྱོད་ཚོས་ང་བསད་ན།",
    "མི་རེའི་རྒྱབ་ལ་ཤིང་ཐུར་རིང་པོ་རེ་བཙུགས་ཏེ་བལ་ཐག་གིས་དཀྱུས་གསུམ་བརྒྱབ་ནས་བཀྱིགས།",
    "སླར་ཡང་ཐག་སྣེ་སྐྲ་ལ་མདུད་དེ་ཁྲིད་ནས་སོང་།",
    "མཚན་མོ་བཟུང་དམག་རྣམས་ས་ལ་ཉལ་དུ་བཅུག་ཅིང་།",
    "སྲུང་མཁན་རྣམས་དེའི་ཐོག་ཏུ་ཉལ་ཏེ་འབྲོ་རུ་མ་བཅུག་སྔོན་མའི་ཡོན་ཀྲིག་གི་ས་ཆར་སླེབས་པ་ན།",
    "ཐང་གི་ཁབ་ལ་ཁ་མཚོན་བཏབ་ཅིང་།",
    "ཧུང་ཇན་ལ་སྡིག་མོ་བྱས་ནས་ན་རེ།",
    "ཁྱོད་ཚོས་ཅིན་ཀྲིག་དང་ལིན་ཀྲིག་ང་ཚོར་སྟེར་རྒྱུ་བྱས་ཡོད་ཀྱང་།",
    "རང་མནའ་རང་གིས་ཟོས་ཏེ་ཁྲེལ་མེད་བྱས།",
    "ད་ནི་ཁོ་བྲོས་ཀྱང་ཁྱོད་ཚོ་ལག་ཏུ་ཟིན།",
    "ཡིན་ན་ཡང་ངས་ཁྱོད་གསུམ་པོ་ཕྱིར་བཏང་ཆོག་ཅེས་ཟེར།",
    "ལོས་ཝུན་བྱ་བའང་རྨས་ཡོད་བཞིན་དུ་བཟུང་ནས་སོང་།",
    "ཧུང་ཇན་ལག་འོག་གི་དམག་དཔོན་མ་ཉིན།",
    "མ་སོས་བྱ་བའི་ལག་འོག་གི་དམག་དཔོན་མ་ཡིན་བྱ་བ་གསུམ་ཐང་ལ་ཕྱིར་བཏང་།",
    "རྗེས་སུ་ཧྲག་དམག་ཁྲང་ཨན་མཁར་དུ་འདྲེན་དགོས་བསམས་མོད།",
    "ཡང་ཉུང་ཇན་བཟུང་སྟེ་ཐང་ལ་དམག་བྱེད་བསམས་པ་རེད།",
    "བྷོད་དམག་གིས་འགྲོ་རུ་མ་བཅུག་པས་ཁོ་ཕྱིར་ལོག་དང་ཐོག་ཧུང་ཇན་དང་ལོ་ཡོན་ཀོང་བྱ་བ་གཉིས་ཅིན་ཀྲིག་ནས་ཆས་དུས།",
    "ཁྱོད་ལ་གྲོགས་ཏན་བྱེད་རྒྱུའི་ལུང་གནང་།",
    "དེ་བས་ང་རང་ཁྱོད་དང་ཐག་ཉེ་སར་སྒར་བཏབ་སྟེ་བྷོད་ཀྱི་གནས་ཚུལ་ལ་བལྟ་ཞེས་ཟེར།",
    "ལོ་ཡོན་ཀོང་གི་སྒར་ནི་དེའི་ཤར་ཕྱོགས་སུ་མཆིས།",
    "ཧུང་ཇན་གཅིག་པུ་རྟ་ཞོན་ནས་བྲོས་ཏེ་ཁོ་རང་གི་སྒར་དུ་མ་སླེབས་གོང་།",
    "སྒར་སྲུང་དམག་དཔོན་ལི་ཁྲའོ་ཚེ་བྱ་བས་དམག་གི་རྟིང་མ་ནོན་པར་སོ་སོར་འཐོར་བས།",
    "དམག་སྒར་སྟོང་བར་ལུས་ཤིང་གོ་ཆ་དང་དམག་རྒྱུགས་རྣམས་གང་སར་གཡུགས་འདུག་ལོ་ཡོན་ཀོང་གི་འཁོར་རྣམས་ཀྱིས་རང་གི་སྒར་དུ་གཡུལ་བཤམས་འདུག་པ་ལ།",
    "བྷོད་ཀྱི་ར་མདའ་པའང་ཕྱིར་ལོག་དེར་ལོ་ཡོན་ཀོང་གིས་དམག་མི་མངགས་ཏེ་ཧུང་ཇན་གྱི་སྒར་ནང་གི་དངོས་པོ་ཚུར་བསྐྱལ།",
    "དེ་ནས་ཧུང་ཇན་དང་ལྷན་དུ་དམག་དཔུང་ཧྲག་བསྒྲིག་བྱས་ཏེ་ཕྱིར་ལོག་ཧུང་ཇན་སླར་ཡང་ཧྲིན་བྷིན་དུ་སོང་།",
    "ཡན་ཀྲིག་དང་ཞ་ཀྲིག་གཉིས་ཀྱི་མཁར་སྒོ་དང་ཁང་བ་རྣམས་བྷོད་དམག་གིས་བསྲེགས།",
    "བྷོད་དམག་གིས་གཡོ་བྱས་ཏེ་མཇལ་དུམ་བྱེད་སར་འཁྲུག་ཟིང་བསླངས།",
    "བྷོད་ཀྱིས་གཏུམ་སྤྱོད་གཡོ་སྦྱོར་གྱི་དཔུང་ཚོགས་དྲངས་ཏེ་ངེད་ཀྱི་ཞི་དྲག་དཔོན་བློན་རྣམས་ལ་རྒོལ་དུ་བྱུང་བས།",
    "ཁོ་བོའི་ཆབ་འབངས་དང་རྒྱལ་ཕྲན་རྣམས་ཀྱི་མདུན་དུ་ངོ་གནོང་དགོས་པ་ཞིག་ཀྱང་རེད།",
    "སི་ཞུན་ཡོན་ལེ་ལང་གི་ཐབས་ཡོད་པ་ཀྲིན་ཧུའུ་ཅུས་དང་།",
    "ཅན་ཅོ་ཧུའུ་པུའུ་ལང་ཀྲུང་གི་ཐབས་ཡོད་པ་ལུའུ་པིས།",
    "དེ་བཞིན་དམག་དཔོན་མོན་རི་ཧྭ་དང་།",
    "ཆོན་ཅའོ་ཁྲིན་སོགས་ཀྱི་བུ་རེར་དཔོན་གནས་རིམ་པ་བརྒྱུད་པ་རེའི་ཆོ་ལོ་སྦྱར་བ་ཡིན།",
    "པཱིན་མ་ཧྲི་གཞོན་པའི་མན་ཆད་ཀྱི་དཔོན་རིགས་དག་གི་བུ་རེར་དཔོན་གནས་རིམ་པ་དགུ་བའི་ཆོ་ལོ་སྦྱར་བ་ཡིན།",
    "ཚོས་ཧན་ཉིན་སོགས་ཀྱི་གོ་གནས་རང་སོར་བཞག་དམག་དཔོན་གཞན་རྣམས་ཀྱི་བུ་རེར་གོ་གནས་རེ་སྤྲོད་རྒྱུ་ཡིན་པས།",
    "ཧྲིན་ཚེ་དམག་དཔོན་མོན་རི་ཧཱ།",
    "བྷོད་དམག་གིས་ཕན་ཁུག་གི་ཤར་ཕྱོགས་ནས་དམག་ཁག་གསུམ་དུ་བགོས་ཏེ་ཁག་གཅིག་ལུང་ཀྲིག་ཏུ་དྲངས་པ་དང་།",
    "ཁག་གཅིག་ཆན་དབྱང་གི་ཤར་ཕྱོགས་སུ་བཏེགས།",
    "ལེ་དབར་བཅུ་ཕྲག་འགའི་སར་དམག་སྒར་གྱིས་ཁེངས་སོང་།",
    "ཁྲང་ཨན་མཁར་གྱི་མི་རྣམས་འཇིགས་ཤིང་ཞེད་དེ་འབངས་རྣམས་བྲོས་བྱོལ་དུ་སོང་།",
    "བྷོད་ནས་འཇང་བ་དང་འ་ཞའི་དཔུང་མངགས་པ་དེ་རྣམས་ཀྱིས་ཐང་གི་དམག་ཆས་སྤྲས་ཏེ།",
    "ང་ཚོ་ཞིན་ཅུན་ཡ་ཡི་དམག་དཔུང་ཡིན་ཟེར་ནས་བརྫུན་ལབ་ཅིང་།",
    "བྷོད་དམག་གིས་བསྲེགས་སོ།",
    "བྷོད་དམག་གིས་ཆན་དབྱུང་དང་།",
    "ཧཱ་བྷིན་ལ་སོགས་པའི་ས་ཆའི་མི་སེར་ཕོ་མོ་ཆིག་ཁྲི་ལྷག་བཟུང་སྟེ།",
    "ཨན་ཧྭ་འགཀ་གི་ནུབ་ཕྱོགས་སུ་ཁྲིད་ནས་འཇང་བ་དང་འ་ཞ་སོགས་ལ་བགོ་རྩིས་བྱས།",
    "ཁྱོད་ཚོས་ཁ་ཤར་ཕྱོགས་སུ་འཁོར་ནས་རང་གི་ཕ་ཡུལ་དང་ཁ་གྱེས་ཤིག་ཅེས་ཟེར་བ་ལ།",
    "དེ་རྣམས་ངུ་དིར་རེར་སོང་ཞིང་།",
    "ཧུང་ཇན་གྱིས་རིན་མོང་ཀྲུའུ་བྱ་བ་དམག་སུམ་སྟོང་དང་བཅས་ཏེ་ཧོ་ཧྲི་སྲུང་དུ་མངགས།",
    "བྷོད་རྣམས་འཇིགས་ཡེ་རེར་སོང་།",
    "བྷོད་ཀྱིས་ཧཱ་བྷིན་དམག་གིས་བསྐོར་རྗེས།",
    "ཐོག་མར་ཆུ་ལམ་བཀག་མཁར་སྲུང་དམག་དཔོན་ཝང་ཞན་ཧི་དང་དམག་མི་མི་སེར་བཅས་བསྡོམས་པས་སུམ་སྟོང་མཁར་ནང་དུ་བཅུག་ཝང་ཞན་ཧི་བྱ་བས་མི་མངགས་ཏེ་རྐང་ལམ་དེད་ནས་ལུང་ཀྲིག་ཏུ་དམག་གི་སྣོན་མ་འབོད་དུ་སོང་།",
    "སོ་མྱུལ་པ་བརྒྱ་ལྷག་བྷོད་དམག་གིས་ཕམ་པར་བྱས།",
    "ཉིན་རེ་བཞིན་བྷོད་ཀྱི་རྟ་དམག་ཆིག་སྟོང་ལྷག་རེ་ལུང་ཀྲིག་ཏུ་འོངས།",
    "ལུང་ཀྲིག་གི་དམག་མི་ཚོས་འཐབ་ཏུ་མ་ཕོད།",
    "དམག་གི་སྣོན་མའང་མ་སླེབས།",
    "དེར་བྷོད་དམག་གིས་མཁར་འགྲམ་དུ་བུད་ཤིང་མང་པོ་སྤུངས་ཏེ་སྲེག་རྩིས་བྱས་པ་ལ།",
    "བྷོད་དམག་གིས་དེ་གའི་ཁང་བ་མེར་བསྲེགས།",
    "བྷོད་དམག་གིས་བྱང་ཕྱོགས་སུ་རྡོ་སྦྱོགས་འཕེན་ས་བདུན་བརྩིགས་ཏེ་མཁར་ནང་དུ་སྐྱོགས་རྡོ་འཕངས།",
    "མཁར་སྲུང་དམག་དཔོན་ཀྲང་མཱིན་སོས་དང་ཁོའི་འཁོར་ཕོ་མོ་ཆིག་སྟོང་ལྷག་ཁ་ཤར་ཕྱོགས་སུ་གཏད་དེ་ངུས་ཤིང་།",
    "ཅིན་ཀྲིག་གི་ནུབ་ཕྱོགས་སུ།",
    "ལེན་ཡུན་པའོ་ཁོ་ན་ནས་ད་གཟོད་བྷོད་དམག་གི་གནས་ཚུལ་རྒྱུན་པར་ཤེས་ཐུབ་པ་ལ།",
    "ད་ནི་མཁར་དེའང་སྟོད་ལ་ཤོར་བས་ཅིན་ཀྲིག་གི་ནུབ་སྒོའང་ཕྱེ་མ་ཕོད།",
    "ནུབ་སྒོའི་ཕྱི་རོལ་ནི་བྷོད་ཀྱིས་བདག་གིར་བཟུང་བས།",
    "བུད་ཤིང་བཏུ་བར་ཡང་འགྲོ་མི་ཐུབ།",
    "ཅིན་ཀྲིག་གི་མི་རྣམས་ལ་བཀྲེས་ལྟོགས་བྱུང་།",
    "བྷོད་དམག་གིས་ལེན་ཡུན་པའོ་དང་།",
    "པཱིན་ཀྲིག་ཅིན་ཀྲིག་གི་རི་ལ་བྲོས་པའི་མི་རྣམས་དང་གནག་ཕྱུགས་བཅས་ཁྲི་ཕྲག་ཙམ་བཟུང་སྟེ་ཐན་ཀྲིན་ཞ་འགག་ལ་ཁྲིད།",
    "ཧན་ཆོན་དབྱི་བྱ་བས་དམག་དཔུང་ཁྲིད་དེ་རྒོལ་དུ་སོང་།",
    "ཧན་ཡུག་ཧེད་ཀྱི་ལག་འོག་གི་དམག་དཔོན་ཞིག་གིས་དམག་མི་ཁྲིད་དེ་གྲོགས་ཏན་བྱེད་དུ་འགྲོ་ཞེས་ཞུས་པ་ལ།",
    "ཧན་ཡུག་ཧེད་ནས་འགྲོ་རུ་མ་བཅུག་མཚན་མོ་ཞིག་བྷོད་དམག་ཕྱིར་ལོག་ཧན་ཆོན་དབྱི་ཡིས་ཀྱང་དམག་ཁྲིད་དེ་ཕྱིར་ལོག་སྟེ་འོངས།",
    "ཉིན་ཉི་ཤུ་ལྷག་འགོར་རྗེས་གཟོད་ཕྱིར་ལོག་ཁྲིན་ཞུས་ཀྱི་ཞིན་ཡིན་དམག་དཔོན་ཧན་ཆོན་དབྱི་བྱ་བ་འཁོར་དང་བཅས་པ་ཁྲང་ཝུའུ་མཁར་ནས་བྷོད་དམག་ལ་འཐབ་ཏུ་སོང་ཡང་།",
    "རྩེ་ཏུའུ་ཧྲིའི་ཐབས་ཡོད་པ་ཀྲང་ཞན་ཧྲུའུ་བྱ་བ་འཁོར་དང་བཅས་པ་འཐབ་ཏུ་སོང་སྟེ།",
    "ཅན་ནན་གྱི་རེ་ཏུའུ་ཧྲིའི་ཐབས་ཡོད་པ་ཝེ་ཀོ་བྱ་བས་དམག་དཔོན་ཝང་ཡུག་ཏའོ་སོགས་མངགས་ཏེ་ཏུན་མན་ལེང་ལིན་གྱི་རྩ་ན་ཧྲི་དང་།",
    "ཁ་ཅིག་གིས་ཞང་རྗེ་བཙན་གྱི་བུ་ཡིན་ཟེར།",
    "བྷོད་དམག་གིས་མཚམས་མི་བྱེད་པར་དམག་བརྒྱབ།",
    "པེ་བྷིན་གྱི་རེ་ཏུའུ་ཧྲིའི་ཐབས་ཡོད་པ་དབྱང་ཞི་ཀུའུ་བྱ་བས་འཁོར་ཉིས་སྟོང་ལྷག་ཁྲིད་དེ་ཞིས་ཀྲིག་ཏུ་སོང་།",
    "རེ་ཀན་ཅུ་ཧྲི་བྱ་བས་རྒྱལ་ཁ་མ་ལོན་པར་ཕྱིར་ལོག་ཀྲིན་ཡོན་གྱི་ཁྲི་ལོ་བདུན་པའི་སྟོན་ཀར།",
    "དུས་དེ་ནས་བཟུང་མན་ཞི་དང་ཐང་གི་འགྲིམ་འགྲུལ་མཚམས་ཆད།",
    "ཨན་ཞི་ཐང་གི་ཁོངས་སུ་ངེས་མིན་ཀྱང་མ་ཤེས།",
    "ཞི་ཀྲིག་ཁོ་ནས་ད་དུང་རང་གི་ས་ཆ་སྲུང་ཞིང་གདའ།",
    "དེ་ནས་ཀྲིག་མཁར་དུ་དྲངས་ཏེ་བྲོས་ཁུག་གི་ཆུ་མཛོད་དང་ཆུ་རྐ་རྣམས་བཀག་སྟེ་སོ་ནམ་བྱེད་དུ་མ་བཅུག་གོང་མས་ཧི་ཏུང་དང་ཀྲིན་ཝུའུ་ནས་དམག་གི་སྣོན་མ་མངགས་དགོས་པའི་བཀའ་བསྩལ།",
    "མཁར་དེ་སྔོན་ཆད་བྷོད་དམག་གིས་བཤིགས།",
    "བྷོད་དམག་གིས་ནུབ་ཏུ་ཧྥུའུ་ཀྲིག་དང་ཧྥང་ཀྲིག་གཉིས་ལ་འཇིགས་བསྐུལ་ཞིང་།",
    "ཅན་ཡུས་ཧྲི་ཀྲུང་ཁྲིན་གྱི་ཐབས་ཡོད་པ་ཏུའུ་ཡན་ཀོང་གི་དམག་དང་བཅས་ཏེ་ཡན་ཀྲིག་སྲུང་དུ་མངགས།",
    "བྷོད་དམག་གིས་སྟོབས་ཤུགས་ཉམས་དམས་སུ་བཏང་།",
    "ནན་ཀྲའོ་མན་པའི་རྗེ་བོ་མོང་དབྱི་མུའུ་ཞུན་བྱ་བས་ཧྲིན་ཁྲོན་དུ་བྷོད་དམག་ཕམ་པར་བྱས།",
    "བྷོད་ཀྱི་ཚོ་དཔོན་བློན་ཁྲི་རན་སྟངས་མོ་གཙང་བཞེར་བྱ་བས་ནང་མི་རྣམས་ཁྲིད་དེ་ཐང་ལ་མགོ་འདོགས་པར་འོངས།",
    "ཞིན་ཅུན་ཡ་བྱ་བས་གོང་མ་ལ་ཞུས་ཏེ་ལུང་ཀྲིག་གི་ནུབ་ཕྱོགས་ནས་ལེ་དབར་བདུན་ཅུ་ཡོད་པའི་སར་མཁར་ཞིག་བརྩིགས་ཏེ་བྷོད་དམག་བཀག་མཁར་དེའི་མིང་ལ་ཡུན་ཞིན་ཁྲིན་ཞེས་བྱ།",
    "བྷོད་དམག་གིས་རི་བོ་ཅན་ནན་དང་རི་བོ་མ་ལིན་ནས་ལམ་གསུམ་བཤགས་ཏེ།",
    "སོས་ཀྲིག་གི་ཚི་ཧྲིའི་ཐབས་ཡོད་པ་ཚའོ་ཀོ་རིན་བྱ་བས་དམག་ཁག་རྣམས་དང་།",
    "ཞོགས་སྔ་མོ་ནས་ཉིན་གུང་བར་དམག་བྱས་ཏེ་བྷོད་དམག་ལ་ཕམ་ཉེས་ཚབས་ཆེན་བྱིན།",
    "གྲི་དང་མདའ་ཕོག་པའི་རྨས་མ་བགྲང་གིས་མི་ལོངས།",
    "ཞ་ཀྲིག་གི་ཅེ་ཏུའུ་ཧྲིའི་ཐབས་ཡོད་པ་ཧན་ཆོན་དབྱི་བྱ་བས་ཡན་ཀྲིག་གི་ནུབ་བྱང་དུ་བྷོད་དམག་ཕམ་པར་བྱས།",
    "ཡན་ཀྲིག་གི་དམག་དཔུང་གིས་ཝུའུ་ལན་ཆའོ་བྱ་བའི་ས་ཆར་བྷོད་དམག་ཕམ་པར་བཏང་།",
    "ཏང་ཞང་གི་ཚོ་བའི་མི་རྣམས་བཟུང་སྟེ་ཁྲིད།",
    "བྷོད་ཀྱི་དམག་དཔོན་ཆུང་བ་མོ་ལི་བྱ་བས་ཡན་སུའུ་ཁྲིད་དེ་ཞུས་ཧྲེ་རིན་གྱི་གུར་དུ་སོང་།",
    "སྨ་ར་དམར་ལ་མིག་ཆེན་པོ་ཞིག་འདུག་དེ་ནི་ཞུས་ཧྥེ་རིན་བྱ་བ་དེ་རེད།",
    "གུར་དུ་བོས་ཏེ་ན་རེ།",
    "ཁྱོད་ཅག་སྐྲག་མི་དགོས།",
    "ཝུའུ་ཧིག་གིས་རྒྱལ་རྒྱུད་ཆད་པར་བྱས་ཏེ་གོང་མ་གོ་ཙུའུ་ཡི་འཕྲིན་ལས་ལ་བར་ཆད་བྱས།",
    "རིགས་རུས་ཆོ་འབྲང་དང་རང་གི་ཕ་ཡུལ་ནི་བརྗེད་མེད།",
    "འདི་ནི་བྷོད་དང་ཐང་གི་ས་མཚམས་ཏེ།",
    "འདི་ནས་ནུབ་ཕྱོགས་སུ་ལེ་དབར་དགུ་བཅུ་སོང་ན་ཨན་ལོ་ཀྲིག་ཏུ་སླེབས་པ་ཡིན།",
    "དེར་ཡན་སུའུ་ན་རེ།",
    "ཞུས་ཧྲེ་རིན་ན་རེ།",
    "དམག་རྒྱགས་སྒྲུབ་ཆེད་ཐང་གི་ས་མཚམས་འདིར་སླེབས།",
    "དེ་ལྟར་ཡར་རྒྱུག་མར་རྒྱུག་གིས་ལཱིན་ཀྲིག་ཏུ་སླེབས།",
    "མཁར་དེར་དམག་གི་གྲབས་འདྲ་མེད་ཅིང་།",
    "དམག་འཁྲུགས་དུས་གཡུལ་དུ་གྲོངས་སོང་ཞེས་ཟེར།",
    "བང་ཆེན་ཞེས་པ་ནི་ཐང་གི་འཕྲིན་སྐྱེལ་མཁན་དང་མཚུངས།",
    "དེར་བྷོད་ཀྱི་བང་ཆེན་པ་ན་རེ།",
    "བྱང་ཕྱོགས་ས་མཚམས་ཀྱི་བྷོད་དམག་གི་ཤུགས་ཉམས་དམས་སུ་གཏོང་ཆེད་ལེ་ཀོ་ལ་རྐང་སྐྱ་དམག་ཉིས་ཁྲི་གཏོང་དུ་བཅུག་སྟེ།",
    "ཝེས་ཀྲིག་པའོ་ཀྲིག་སུང་ཀྲིག་སོགས་ཀྱི་མཁར་ལ་རྒོལ་དུ་སོང་།",
    "བྷོད་ཀྱིས་དམག་བྱེད་ཐེངས་རེར།",
    "མ་ཏིན་ཏེ་བྱ་བ་ཕྱོགས་ཕྱོགས་སུ་སོང་ནས་ཐབས་འདོམས་པ་ཡིན།",
    "འདི་དུས་ཐང་ལ་དམག་བྱས་ཏེ་རྒྱལ་ཁ་མ་ལོན་པས་བྷོད་ལ་ཕོག་ཐུག་གཏོང་ཡོང་སྙམ་སྟེ་ཐང་ལ་མགོ་འཛུལ་བ་རེད།",
    "བྷོད་ཀྱི་ཁུན་མིན་མཁར་ལ་གཏོགས་པའི་མོ་ཞེ་མན་པ་དུད་ཁྱིམ་ཆིག་སྟོང་ལྷག་ཀྱང་ཐང་ལ་མགོ་འཛུལ་དུ་འོངས།",
    "བྷོད་དམག་གི་དཔུང་འཐོར་བས།",
    "པེ་ལུའུ་པིན་མ་ཧྲིའི་ཐབས་ཡོད་པ་ཞིན་ཚི་བྱ་བ་དང་ཀྲིག་གཞན་དག་གི་ཚེ་ཧྲིའི་ཐབས་ཡོད་པ་ཏུང་ཧེད་ཨི་བྱ་བ་དམག་མི་བཞི་སྟོང་ཁྲིད་ནས་ཞི་ཅི་དང་ལོ་ཝུན་སོགས་ཀྱི་མཁར་དུ་དྲངས།",
    "ཏུའུ་ཅང་གི་ཐབས་ཡོད་པ་ཀའོ་ཐེས་དང་ཝང་དབྱིན་ཅུན་བྱ་བས་དམག་མི་ཉིས་ཁྲི་ཁྲིད་དེ་སུང་ཀྲིག་ལ་དྲུངས།་",
    "ཆུན་ཀྲིག་གི་ཀྲིན་ནན་ཅུན་ཧྲི་དང་།",
    "ཡ་ཀྲིག་ཅིན་ལོས་ཧྲིའི་ཐབས་ཡོད་པ་ལུའུ་ཝེ་མཱིན་དང་ཚོ་བ་གསུམ་གྱི་ཚོ་དཔོན་འབྲོ་རི་ཅིན་བྱ་བ་སོགས་ཀྱིས་དམག་མི་སུམ་སྟོང་ཁྲིད་དེ་ཕུའུ་ཙུའུ་དང་།",
    "སོས་ཀྲིག་གི་ཅིན་ལོས་ཧྲིའི་ཐབས་ཡོད་པ་ཁྲིན་ཞའོ་དབྱང་བྱ་བ་དང་།",
    "མོ་ཞེ་མན་པའི་ཚོ་བ་གསུམ་གྱི་ཚོ་དཔོན་ཅུས་ན་ཧྲི་བྱ་བ་སོགས་ཀྱིས་དམག་མི་བཞི་སྟོང་ཁྲིད་དེ་ཁུན་མཱིན་དང་ནོ་ཅིའི་མཁར་ལ་དྲངས།",
    "ཝེས་ཀྲིག་ཀྱང་ཐང་དམག་གིས་བསྐོར།",
    "ལེ་དབར་སྟོང་ཕྲག་ལྷག་གི་སར་དམག་བྱས་ཏེ་བྷོད་དམག་བསྟུད་མར་ཕམ།",
    "ཏུའུ་ཐུང་ཆུན་མུའུ་ཏ་ཧྲིའི་ཆོ་ལོ་སྦྱར་ཏེ་དམག་ཁྲི་ཚོ་བཅུ་དྲུངས་ནས་ཝེ་ཀྲིག་ཐང་དམག་གིས་བསྐོར་བའི་ཉེན་བཟློག་ཏུ་འོངས།",
    "བློན་མང་བཞེར་གྱིས་ཐང་གི་དམག་གྲངས་ཉུང་བ་མཐོང་ནས་ར་མདར་བརྒྱུགས།",
    "ཐང་གི་དམག་མི་རྣམས་ཀྱིས་ཕྱོགས་བཞི་ནས་ཕར་རྒོལ་བྱས།",
    "བྷོད་ཀྱི་ཕོ་ཉ་བ་བློན་རྒྱ་བཞེར་བྱ་བ་ཐང་གི་ཁབ་ཏུ་འབྱོར།",
    "གོང་མས་ཡུག་ལུང་ཝུའུ་དམག་དཔོན་ཆེན་མོ་ཞོལ་ཕེ་བྱ་བར་ཡུས་ཧྲི་ཏ་ཧྲུའུ་ཡི་ཆོ་ལོ་གནང་སྟེ་བྷོད་དུ་མངགས།",
    "གོང་མས་ཀུང་པུའུ་སི་ལང་གི་ཐབས་ཡོད་པ་ཀྲུང་ཅན་བྱ་བ་བཙན་པོའི་འདས་མཆོད་དུ་བྷོད་ལ་མངགས།",
    "བཙན་པོ་ནི་ཀྲིན་ཡོན་གྱི་ཁྲི་ལོ་བཅུ་གསུམ་པའི་ཟླ་བཅུ་པར་བཀྲོངས་པ་རེད།",
    "དཔོན་གནས་རིམ་པ་གསུམ་པའི་ཡན་གྱི་དཔོན་རིགས་རྣམས་བྷོད་ཀྱི་ཕོ་ཉ་བའི་དྲུང་དུ་སོང་ནས་སྲས་ཆེ་བར་མྱ་ངན་ཞུས།",
    "གོང་མ་ཧྲུན་ཙུང་གིས་ཙོ་ཅིན་ཧྲུའུ་ཝེ་དམག་དཔོན་དང་ཡུས་ཧྲི་ཀྲུང་ཁྲིན་གྱི་ཐབས་ཡོད་པ་གཅིག་ལྕོགས་ཐེན་ཅིན་ཏུའུ་བྱ་བ་གོང་མའི་བཀའ་རྟགས་དང་བཅས་ཏེ་གོང་མ་ཡབ་འདས་པའི་གནས་ཚུལ་ཞུ་བར་མངགས།",
    "གོང་མ་ཏེ་ཙུང་གི་བང་སོར་གསེར་དངུལ་དང་མནབས་བཟའ།",
    "བྷོད་ཀྱི་ཕོ་ཉ་བ་བློན་གཟིགས་བཞེར་བྱ་བ་སྐྱེས་འབུལ་དུ་འོངས་ལ།",
    "ཀྲིན་ཧྲུའུ་ཅུ་དང་ལུའུ་པིས་གཉིས་ཕྲིན་ལེང་དུ་མཇལ་དུམ་བྱེད་སྐབས་བྷོད་དམག་གིས་བཟུང་བ་ཡིན།",
    "བྷོད་དམག་གིས་ཡུག་ཀྲིག་དང་།",
