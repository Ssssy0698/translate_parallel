    "མིར་གྱུར་པ་དག་གིས་ཀྱང་གྲུབ་པ་འདི་ཐོབ་བོ་ཞེས་གདུལ་བྱ་རྣམས་སྤྲོ་བ་བསྐྱེད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་གཞན་མུ་སྟེགས་ཅན་ན་རེ་བསྐལ་པ་བརྒྱར་འདས་ནས་སྒྱུ་མ་མཁན་འདི་ལྟ་བུ་ཞིག་འཇིག་རྟེན་དུ་བྱུང་ནས་སྒྱུ་མས་འཇིག་རྟེན་ཟའོ་ཞེས་ཁ་ཟེར་བ་ལྟར་འདི་སུ་ཞིག་ཡིན།",
    "གཞན་དག་ན་རེ་གང་དག་ལ་མི་རྣམས་དང་།",
    "སྟོང་ཕྲག་གིས་མཐོ་རིས་དང་བྱང་གྲོལ་འཐོབ་པ་རིང་བསྲེལ་སྐུ་གདུང་རྣམས་བཞག་པའི་ཕྱིར་ཏེ།",
    "རེ་ཞིག་རིགས་པ་ལ་བརྟེན་ནས།",
    "གཟུགས་བརྙན་ཞེས་བྱ་བ་ཁ་དོག་གི་ཁྱད་པར་གཞན་ཁོ་ན་ཞིག་འབྱུང་ངོ་ཞེས་བྱ་བ་དེ་ནི་མ་གྲུབ་བོ།",
    "རེ་ཞིག་ཇི་ལྟར་མ་གྲུབ་ཅེ་ན།",
    "དེ་བཞིན་དུ་ཕྱོགས་ཐ་དད་པ་ན་གནས་པ་རྣམས་ཀྱི་མཚེའུའི་ཆུ་ཡུལ་གཅིག་ན་རང་གི་མདུན་རོལ་གྱི་ཡུལ་ན་གནས་པའི་གཟུགས་རྣམས་ཀྱི་གཟུགས་བརྙན་ཕན་ཚུན་དམིགས་ཏེ།",
    "ཟླ་བའི་གཟུགས་བརྙན་ནང་དུ་སོང་བ་ཡང་ཁྲོན་པའི་ཆུ་བཞིན་དུ་གཞན་ཁོ་ན་ན་སྣང་ངོ།",
    "རེ་ཞིག་མ་གྲུབ་པའི་ཕྱིར་ནི་དེ་ལྟ་བུ་ཡིན་ནོ།",
    "ཁྱོད་ཀྱི་དྲི་ཟ་ཉེ་བར་གནས་པ་གང་ཡིན་པ་འདི་རྒྱལ་རིགས་སམ།",
    "ཁ་ཅིག་ན་རེ་བར་མ་དོར་ཞེས་བྱ་བའི་ལྷ་དག་ཅིག་ཡོད་དོ་ཞེས་ཟེར་རོ།",
    "དེ་ལྟ་ན་སྐྱེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡང་ལྷ་དག་ཅིག་ཡིན་པར་ཐལ་བར་འགྱུར་རོ།",
    "གཞན་དག་ན་རེ་གང་ཞིག་ཚེའི་ཚད་ཀྱི་བར་དུའམ།",
    "ལྷ་དང་ཉེ་བའི་བར་དུ་ཉོན་མོངས་པ་རྣམས་སྤོང་བར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་བར་མ་དོར་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བ་ཡིན་ཏེ།",
    "བསམ་གཏན་དག་གི་བཅུ་ཚན་བཞི།",
    "གཟུགས་མེད་དག་གི་བདུན་ཚན་གསུམ།",
    "བར་ན་ཁྱོད་ཀྱི་གནས་ཀྱང་ཡོད་མིན་ཞིང་།",
    "ཁྱོད་ཀྱི་ལམ་བརྒྱགས་ཀྱང་ནི་ཡོད་མ་ཡིན།",
    "འདིར་ཡང་དགོངས་པ་ནི་མི་དག་གི་ནང་ན་གནས་སུ་མེད་དོ་སྙམ་པ་ཡིན་ནོ།",
    "འདི་ལ་འདི་ནི་དགོངས་པ་ཡིན་གྱི་འདི་ནི་དགོངས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ག་ལས་བརྟགས་པ་འདི་ནི་ཁྱོད་ལ་ཡང་མཚུངས་ཏེ།",
    "ལས་གང་གིས་འགྲོ་བ་འཕེན་པ་དེ་ཉིད་ཀྱི་དེར་ཕྱིན་པར་བྱ་བའི་ཕྱིར་སྲེད་པ་བར་མ་ཡང་འཕེན་ཏེ།",
    "ཡང་ན་འབར་དུ་ཆུག་ན་ཡང་དེ་ནི་ལུས་ཤིན་ཏུ་དྭང་བའི་ཕྱིར་ཇི་ལྟ་བ་བལྟར་མི་ནུས་པ་དེ་ལྟར་རེག་པ་ཡང་མི་ནུས་པས་འདི་ནི་ཀླན་ཀར་མི་རུང་ངོ།",
    "སྲིད་པ་བར་མ་རྣམས་ཀྱང་མངལ་ན་ཕན་ཚུན་མི་རེག་པའི་ཕྱིར་དང་།",
    "འཐབ་མོ་ཞེས་བྱ་བ་རྨི་ལམ་བཅུ་མཐོང་བ་ལྟ་བུའོ།",
    "འོན་ཏེ་གདོན་མི་ཟ་བར་དྲང་བར་བྱའོ་ཞེ་ན་ཡང་ཇི་ལྟར་ཡུམ་གྱི་རྨི་ལམ་ན་དེ་ཞུགས་པར་གཟིགས་པ་ལྟར་དེས་ཀྱང་ཚིགས་སུ་བཅད་པ་འདི་ལྟར་བྱས་སོ་ཞེས་དེ་ལྟར་དྲང་བར་བྱའོ།",
    "གཟུགས་ན་སྤྱོད་པའི་སྲིད་པ་བར་མ་ཡང་བོང་ཚོད་རྫོགས་པ་དང་།",
    "དགེ་སློང་མ་དཀར་མོའི་ཡང་གོས་དང་བཅས་པ་ཡིན་ཏེ།",
    "སྲིད་པ་བར་མ་རིས་མཐུན་པ་དག་གིས་མཐོང་ངོ།",
    "གཞན་དག་ན་རེ་ལྷའི་སྲིད་པ་བར་མ་པས་ནི་ཐམས་ཅད་མཐོང་ངོ།",
    "བཙུན་པ་ན་རེ་ངེས་པ་མེད་དེ།",
    "དེ་ལྟ་མ་ཡིན་ན་དེའི་ཚེ་ཟད་པས་འཆི་བའི་སྲིད་པར་ཡང་ཐལ་བར་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "དེ་ཅི་དེ་དག་གི་སྲིད་པ་བར་མ་རྣམས་དེར་སྡོད་པ་ཁོ་ནར་གྱུར་ཏམ།",
    "ཚེ་ལོ་ཆེས་མང་བ་ན་འཁོར་ལོས་སྒྱུར་བ་འབྱུང་གི་གཞན་དུ་མ་ཡིན་པ་ལྟ་བུའོ།",
    "བཙུན་པ་དབྱིག་བཤེས་ན་རེ་ཞག་བདུན་དུ་གནས་སོ།",
    "གཞན་དག་ན་རེ་ཞག་བདུན་ཕྲག་བདུན་དུའོ་ཞེས་ཟེར་རོ།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ན་རེ་དེ་ནི་སྲིད་པ་ཚོལ་བ་ཡིན་པའི་ཕྱིར་མྱུར་བ་ཁོ་ནས་སོང་སྟེ་ཉིང་མཚམས་སྦྱོར་བས་ན་དུས་ཐུང་ངུར་གནས་སོ།",
    "གང་གི་ཚེ་རྐྱེན་ཚོགས་པ་ཡང་མ་ཡིན་ལ་འདི་ངེས་པར་ཡུལ་དེར་སྐྱེ་བར་འགྱུར་པ་ཡང་ཡིན་ནོ་དེའི་ཚེ་ལས་རྣམས་ཁོ་ནས་རྐྱེན་དག་ཚོགས་པ་འདྲེན་པར་བྱེད་དོ།",
    "དྲེད་མོ་རྣམས་ལ་ནི་དུས་མེད་པས་དུས་གཞན་པ་བ་ལང་རྣམས་ཀྱི་ནང་དུ་སྐྱེ་བར་འགྱུར་བ་གང་ཡིན་པ་དེ་ནི་བ་མེན་རྣམས་ཀྱི་ནང་དུ་སྐྱེའོ།",
    "དོམ་རྣམས་ཀྱི་ནང་དུ་གང་ཡིན་པ་དེ་ནི་དྲེད་མོ་རྣམས་ཀྱི་ནང་དུ་སྐྱེ་བར་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "ད་ནི་ལས་ཀྱི་མཐུ་ལས་བྱུང་བའི་མིག་གིས་རང་གི་སྐྱེ་བའི་ཡུལ་ཐག་རིང་པོ་ན་འདུག་ཀྱང་མཐོང་ངོ།",
    "མོ་ཞིག་ཡིན་ན་ནི་ཕལ་མོའི་འདོད་ཆགས་སྐྱེའོ།",
    "དགའ་བར་འདོད་པའི་གནས་སྐབས་དེར་བདག་ཉིད་མོས་སོ།",
    "གལ་ཏེ་མོ་ཞིག་ཡིན་ན་ནི་དེ་མའི་ལྟོའི་གཡོན་ཕྱོགས་སུ་སྙེས་ནས་ལྟོའི་མདུན་རོལ་དུ་བལྟའོ།",
    "དེའི་ཕྱིར་མོར་གྱུར་པ་དང་།",
    "ཁ་ཅིག་ན་རེ་དེ་དག་ཁོ་ན་ཡིན་ཏེ།",
    "རེ་ཞིག་སྒོ་ང་ལས་སྐྱེ་བ་དང་།",
    "སྔོན་གྱི་སློབ་དཔོན་དག་ན་རེ་བདག་ཉིད་གནས་སྐབས་གང་གིས་དེར་སྐྱེ་བར་འགྱུར་བའི་ལས་བྱས་པའི་གནས་སྐབས་དེ་ཡིན་པ་དང་།",
