    "སྤངས་པ་སླར་ལྡོག་པར་འགྱུར་ཏེ།",
    "སྦྱིན་སོགས་ལ་ངར་འཛིན་མེད་པར་རང་གཞན་སྤྱོད་པ་ཉིད་གཉེན་པོའི་གཙོ་བོར་ཤེས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "འདིར་ཁ་ཅིག་གཟུགས་སོགས་མ་སྨོས་པར་གཞི་ལ་མཚན་འཛིན་གྱི་གཉེན་པོ་དངོས་སུ་བསྟན་པར་འཆད་པ་ནི།",
    "གཞུང་འདི་ནས་རྟོགས་པར་དཀའ་བ་ཡིན་ཞེས་པའི་བར་འཆད་པ་ལ།",
    "ཟབ་པར་སྒྲུབ་པ་དང་།",
    "ཡང་དེ་ལྟར་རྟོགས་པར་དཀའ་ཞེས་སོགས་སོ།",
    "རྟོགས་པར་དཀའ་བའི་སྒྲུབ་བྱེད་མཐོང་བ་སོགས་བཀག་པ་བརྗོད་ཟིན་པས་དེ་ལས་རྣམ་གྲངས་གཞན་ཡང་དེ་ལྟར་རྟོགས་པར་དཀའ་བ་ཉིད་ཡིན་ཞེས་སྦྱར་བྱར་མཐོང་བའི་ཕྱིར་རོ།",
    "མཐོང་བ་བཀག་པས་རྟོགས་པར་དཀའ་བ་བསྒྲུབས་ཟིན་པ་གཟུགས་ལ་སོགས་པ་ཞེས་སོགས་འདིར་ཡང་སྒྲུབ་མི་དགོས་པའི་ཕྱིར་དང་།",
    "ཁྱད་པར་དུ་དཔྱད་པའོ།",
    "སེམས་བསྐྱེད་ནས་མཐོང་ལམ་སྒོམ་དགོས་པས་སེམས་བསྐྱེད་སྦྱོར་ལམ་ཁོ་ན་ན་ཡོད་པར་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་དུ་མཉམ་ཉིད་ནི་དེའི་མཉམ་ཉིད་དོ་ཞེས་སྦྱོར་བའི་འཛིན་སྟངས་ཡིན་པས་ས་མཚམས་སོ་སོར་མི་རིགས་པའི་ཕྱིར་རོ།",
    "རགས་པར་ན་སློབ་དཔོན་ལྟར་ན།",
    "རང་རྒྱུད་ཀྱི་ལམ་གྱི་རྟོགས་པའི་རློམ་པ་མི་འཛིན་པར་གཞན་ཡང་བསྡུས་ནས་ལམ་སྤྱིའི་རློམ་པ་འཛིན་པར་རིགས་པས་ཚོགས་ལམ་དང་།",
    "མི་སློབ་ལམ་གྱི་རློམ་པ་ཡང་འཛིན་པར་འགྱུར་བ་ལས་མི་བཟུང་བའི་ཕྱིར་རོ།",
    "བསྡུས་ན་སྒོམ་རིམ་རྒྱས་པར་མི་རྟོགས་ཤིང་།",
    "གསལ་བའི་དབྱེ་བ་མཐའ་མེད་དུ་འགྱུར་བས་དམིགས་རྣམས་ཀྱི་ཁྱད་པར་འདི་ཙམ་ལ་དོགས་པ་བཅད་དགོས་པའི་གདུལ་བྱ་ཉེ་བ་ལ་བལྟོས་ཏེ་བཅུར་ཕྱེ་བ་ཡིན་ནོ།",
    "ཅིག་ཅར་སྐྱེས་ན་ཅིག་ཅར་སྒོམ་ཞེས་གསུངས་སོ།",
    "གཟུགས་ཀུན་བཏགས་ཞེས་སོགས་བདེན་པར་འཛིན་པ་སྐྱེས་པའི་ཚེ་གཟུགས་བདེན་འཛིན་དང་།",
    "མི་རྟག་པར་བདེན་འཛིན་ལྟ་བུ་ཅིག་ཅར་སྐྱེས་ཞེས་བརྗོད་དེདེ་ལྟར་རྟོག་པ་གཉིས་ཀ་གཞི་མཐུན་པའི་ཚུལ་གྱིས་ལྷན་ཅིག་སྐྱེས་པའི་ཕྱིར་དང་།",
    "སྦྱོར་བ་རྣམ་པ་བཅུ་མཚན་ཉིད་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེས་ན་ལུགས་སྔ་མ་ལེགས་པར་གནས་པ་ཡིན་ནོ།",
    "ཡུལ་གྱི་སྒོ་ནས་དབྱེ་བ་བྱས་པ་དང་པོ་བཞི།",
    "བྱ་བའམ་ལྡོག་པའི་སྒོ་ནས་དབྱེ་བ་བྱས་པ་དེ་ནས་གཅིག།",
    "སྣང་བ་རྣམ་བདུན་གྱི་སྦྱོར་བ་ནི་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "ལུགས་འདི་ནི་རྗེ་བཙུན་གྱི་དགོངས་པར་གདོན་མི་ཟའོ།",
    "གྲུབ་པའི་ཡོངས་སུ་ཤེས་པ་བསལ་བའི་སྒོ་ནས་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "ཁྱད་པར་དུ་དཔྱད་པ་ལ་མ་རྫོགས་པ་དང་།",
    "དོན་ལ་མ་གྲུབ་པར་རྟོག་པས་སྒྲོ་བཏགས་པ་ཙམ་དུ་ཟད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་འདི་སྒྱུ་མ་བྱས་པ་དང་འདྲ་ཞེ་ན།",
    "རྣམ་པར་ཤེས་པ་རང་ཉིད་གསལ་བ་རྣམས་ནི་སྒྱུ་མའི་གཞི་ཤིང་དུམ་ལ་སོགས་པ་དང་འདྲ་སྟེའཁྲུལ་གཞི་ཡིན་པའི་ཕྱིར་རོ།",
    "འཛིན་པར་སྣང་བ་ནི།",
    "གསེར་གྱི་སེར་པོ་ལྟར་རྒྱུན་མི་འཆད་པར་དེའི་མ་བཅོས་པའི་རང་བཞིན་དུ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དྲི་མ་མེད་པའི་རྣམ་པར་དག་པ་དང་།",
    "དམིགས་པའི་རྣམ་པར་དག་པ་དང་།",
    "འདུས་མ་བྱས་པ་ལ་སོགས་པར་གསུངས་སོ།",
    "གཅིག་དང་དུ་བྲལ་ལ་སོགས་པའི་རིགས་པས་སེམས་ཀྱི་རྣམ་པ་ཡང་དོན་དམ་པར་བདེན་པར་མ་གྲུབ་པས་བདེན་པར་བཏགས་པ་ནི་ཀུན་བཏགས་ཡིན་པའི་ཕྱིར་རོ་ ཡོངས་སུ་གྲུབ་ལ་མི་སྲིད་པའི་སྐྱོན་གནས་ཏེ།",
    "གང་འདུས་བྱས་ཡིན་པ་དེ་ནི་མི་འགྱུར་བའི་ཡོངས་གྲུབ་མིན་ཏེ།",
    "དེ་ནི་བརྡ་དང་ཐ་སྙད་ཀྱི་རྣམ་པར་རྟོག་པ་ལ་ངོ་བོ་དང་ཁྱད་པར་ལ་སོགས་པར་སྣང་བའི་གཟུགས་བརྙན་གང་ཡིན་པ་སྟེ།",
    "གཏན་ལ་དབབ་པ་དང་བཞིས་རིག་པར་བྱའོ།",
    "བདེ་འགྲོ་སོགས་སུ་སྣང་བའི་རྣམ་པར་རིག་པའོ།",
    "རྣམ་པར་རིག་པ་འདི་རྣམས་ཀྱང་བག་ཆགས་གསུམ་ལས་བྱུང་སྟེ།",
    "དེ་དག་ཀྱང་རྒྱས་པར་ཕྱེ་ན་ལུས་དང་ལུས་ཅན་གྱི་རྣམ་པར་རིག་པ་ལ་སོགས་པ་དགུ་ཡིན་ལ།",
    "སྣང་བའི་རྣམ་པར་ཤེས་པ་ནི།",
    "ཅིའི་ཕྱིར་རྟོག་བྱེད་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡིན་ཞེ་ན།",
    "རྟག་ཏུ་མེད་པར་གྱུར་པ་གང་།",
    "རྣམ་པར་དག་པའི་ཡོངས་གྲུབ་བོ།",
    "དེ་ལ་རྒྱུ་ནི་རྣམ་པར་དག་པ་ཡོངས་གྲུབ་དེ་ཉིད་ཐོབ་པར་བྱེད་པའི་ལམ་གྱི་ས་བོན་རང་བཞིན་དུ་གནས་པ་དང་།",
    "ཡང་དག་པར་གྲུབ་པ་གཉིས་སུ་གནས་སོ།",
    "དེ་དག་རྣམ་པར་བྱང་བའི་ཐབས་ཡིན་པའི་ཕྱིར་ཀུན་བཏགས་མ་ཡིན་ལ།",
    "རྣམ་པར་དག་པའི་དམིགས་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "རྣམ་པར་བྱང་བའི་ཚུལ་དང་།",
    "རྣམ་པར་རྟོག་པ་གསུམ་ཤེས་པར་བྱ།",
    "རྣམ་པ་བདག་ཉིད་ལ་ཡིད་ཀྱིས་ཀུན་ཏུ་བཏགས་པ་ཐ་སྙད་བརྗོད་པར་བྱེད་པའི་ཚོགས་ཐམས་ཅད་དེ།",
    "འདི་ནི་སྔོན་པོ་ཞེས་སོགས་ངོ་བོ་དང་ཁྱད་པར་དུ་ཐ་སྙད་འདོགས་པར་བྱེད་པ་ཕྱི་རྗོདབྱེད་དང་།",
    "ནང་བློའི་རྣམ་པ་དེ་ཉིད་ལ་འདི་གཟུགས་འཛིན་ནོ་ཞེས་སོགས་ངོ་བོ་དང་ཁྱད་པར་དུ་ཐ་སྙད་འདོགས་པ་ནང་རྗོད་བྱེད་དོ།",
    "ཁམས་གསུམ་པའི་སེམས་དང་སེམས་ལས་བྱུང་བ་བརྗོད་བྱ་རྗོད་བྱེད་འདྲེ་བའི་གཞི་འདྲེ་རུང་དུ་འཛིན་པར་བྱེད་པ་ཐམས་ཅད་དེ།",
    "དེ་ལྟར་རྒྱ་ཆེར་དཔྱོད་པར་བྱའོ།",
    "རྣམ་རྟོག་དང་བྲལ་བའི་མཚན་མ་རྣམས་རྣམ་པར་རྟོག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ད་ནི་སྐབས་སུ་བབས་པ་བརྗོད་པར་བྱ་སྟེ།",
    "འདིར་ཀུན་ཏུ་རྟོག་པ་ནི་གཉིས་སུ་སྣང་བ་ཙམ་གྱི་རྣམ་པར་རྟོག་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་སྒོ་ལྔ་སྟེ།",
    "སྣང་བར་གྱུར་མ་ཐག་ལྷག་པར་ཞེན་པ་དང་།",
    "སྣང་བར་གྱུར་མ་ཐག་ཞེན་ཏེ་ཅུང་ཞིག་ནས་ལྷག་པར་ཞེན་པ་དང་།",
    "མིང་དང་མཚན་མ་ལས་སྔར་ལྟར་ཞེན་ཅིང་སྲིད་པར་བྱེད་དོ།",
    "རྣམ་རིག་ཏུ་སྣང་བའི་ཀུན་གཞིས་དེ་མ་ཐག་རྐྱེན་བྱས་ཏེ།",
    "དེས་ན་སྤྲོས་པ་ཉེ་བར་ཞི་བར་འདོད་པས་བག་ཆགས་ངན་པ་རྣམས་དགག་པར་བྱའོ།",
    "ཡུལ་ཅན་དེ་དགག་བར་འདོད་པས་ཡུལ་མཚན་མ་དགག་པར་བྱའོ།",
    "མཚན་མ་དགག་པར་འདོད་པས་མིང་དུ་འདོགས་པ་དགག་པར་བྱའོ།",
    "དེ་ལྟར་རྗོད་བྱེད་མིང་མེད་པར་ཤེས་པས་བརྗོད་བྱ་མཚན་མ་མེད་པར་ཤེས་སོ།",
    "བྱིས་པ་རྣམས་བདེན་པའི་དངོས་པོ་ལ་སྤྱོད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདི་ནི་མི་རིགས་ཏེ་དོན་བྱེད་ནུས་པ་ལ་རྫས་སུ་བྱེད་ན་ཕྱིན་ཅི་ལོག་པའི་ཡོངས་གྲུབ་བཀག་པར་འགྱུར་ལ།",
    "རང་སྐྱ་ཐུབ་པ་ལ་རྫས་སུ་བྱེད་ན་འགྱུར་མེད་ཡོངས་གྲུབ་བཀག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེའི་རིགས་པས་དཔྱད་བཟོད་བརྟན་པ་ལ་རྫས་སུ་བྱེད་པའི་ཕྱོགས་ལའང་ཇི་རིགས་སུ་ཤེས་པར་བྱའོ།",
    "ཀུན་བཏགས་གཞན་གཉིས་ལས་རྫས་དེ་ཉིད་དང་གཞན་དུ་བརྗོད་པར་མི་བྱ་སྟེ།",
    "འགྱུར་མེད་ནི་ཅི་རིགས་པར་ཤེས་པར་བྱའོ།",
    "དོན་དམ་པར་གཏན་མ་གྲུབ་པའི་སྟོང་པ་ནི་རྟོག་གེ་བ་ཚིག་ལ་རྟོག་པ་རྣམས་ཀྱི་ལུགས་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "བདེན་པར་བཏགས་བྱ་ཀུན་བཏགས་ཉིད།",
    "ལེགས་པར་གྲུབ་ཕྱིར་ཡོངས་གྲུབ་བོ།",
    "དེ་བཞིན་གཟུགས་ཀྱང་རབ་ཏུ་གསུངས།",
    "སེམས་ཙམ་གསུངས་པ་ཡིན་ན་ནི།",
    "བྱེད་པོ་ཟ་པོ་དགག་ཕྱིར་དུ་ལས་ཙམ་ཞེས་ཀྱང་ཅིས་མི་གསུངས།",
    "དོན་ཙམ་ཉིད་ཅེས་ཅིས་མི་གསུངས།",
    "དེ་གསུམ་ངོ་བོ་མེད་པར་བསྟན།",
    "དེ་ལྟ་བུའི་ངོ་བོ་ཉིད་གསུམ་པོ་དེ་ཡང་ཐ་སྙད་ཐམས་ཅད་དུ་རྣམ་པརགཞག་པ་ཡིན་གྱི།",
    "དོན་དམ་པར་གང་ཡང་བདེན་པ་མེད་དེ།",
    "བློ་ཡིས་ཇི་ལྟར་རྣམ་པར་བརྟག།",
    "ཅེས་གསུངས་པ་ཡིན་ནོ།",
    "ཡེ་ཤེས་ཡང་དག་པར་འགྲུབ་པ་མ་ཡིན་ལ།",
    "ཡོངས་གྲུབ་ཡོད་ན་ནི་ཀུན་བཏགས་ཀྱི་མཚན་ཉིད་ཀྱང་ཤེས་པར་འགྱུར་ན།",
    "དཔག་ཏུ་མེད་པ་ཐམས་ཅད་ཡོངས་སུ་ཉམས་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་ཇི་ལྟར་ཞེ་ན།",
    "ཇི་ལྟར་ན་མཁྱེན་གསུམ་གྱི་སྦྱོར་བ་འཆད་དེ།",
    "རྣམ་ཀུན་གྱི་སྦྱོར་བ་སོགས་དང་ཟློས་པར་འགྱུར་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "འདིར་ནི་གཞི་ཤེས་ཀྱི་ནང་དུ་ལམ་ཤེས་དང་རྣམ་མཁྱེན་ཡང་འདུས་པ་ལྟར།",
    "རྣམ་མཁྱེན་ནི་ནམ་མཁའ་ལྟ་བུ་ཡིན་པའི་ཕྱིར་དང་།",
    "གཟུགས་ཀྱི་རློམ་སེམས་སུ་མི་བྱེད་ཅེས་པས་ཁྱད་པར་གྱིས་མི་རློམ་པ་བསྟན་ཏེ།",
    "གཟུགས་ཀྱི་ཁྱད་པར་སྔོན་པོ་ལ་སོགས་པས་མཛེས་པ་སོགས་སུ་རློམ་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་གཞི་ཤེས་ནི་ཉན་ཐོས་ཀྱི་ལམ་ཤེས་པར་བྱ་བའི་ཕྱིར་དུ་ཡིན་པས་ཉན་ཐོས་ཀྱི་སྒོམ་ལམ་ཤུགས་ལས་ཤེས་པར་བྱ་བའི་ཕྱིར་བསྟན་དགོས་སྙམ་ན་ཡང་མ་ཡིན་ཏེ།",
    "མཐོང་ལམ་བསྟན་པས་དེ་རྒྱུན་དུ་གོམས་པ་སྒོམ་ལམ་ཡིན་པར་ཤེས་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "དེ་ནི་ཉན་ཐོས་ཀྱི་མཐོང་ལམ་ཤུགས་ལ་ཤེས་པར་བྱ་བའི་ཕྱིར་བསྟན་ནོ།",
    "དང་པོ་ནི་མཐོང་ལམ་ཡང་བསྟན་མི་དགོས་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་མཐོང་ལམ་ནི་ཉན་ཐོས་ཀྱི་མཐོང་ལམ་ཤུགས་ལ་ཤེས་པར་བྱ་བའི་ཕྱིར་བསྟན་དགོས་སོ་ཞེ་ན།",
    "འདིར་དེའི་དོན་དུ་བསྟན་མི་དགོས་པར་འགྱུར་རོ་ གཉིས་པ་ནི་གཉེན་པོ་གཞི་ཤེས་སྐབས་འདིའི་བརྗོད་བྱའི་གཙོ་བོ་མ་ཡིན་པར་འགྱུར་ཏེའདིའི་ལམ་གྱི་རང་བཞིན་ནི་མཐོང་ལམ་དག་ནི་ཉན་ཐོས་ཀྱིཐོང་ལམ་ཤེས་པར་བྱ་བ་ཙམ་གྱི་དོན་དུ་བསྟན་གྱི།",
    "ཞེས་སོགས་ཀྱི་སྐབས་སུ་མི་མཐུན་ཕྱོགས་ཤུགས་ལས་གསུངས་ནས།",
    "དེའི་ཚེ་ཞི་བ་ལ་དགའ་བས་གཞན་དོན་རྒྱུན་ཆད་པར་འགྱུར་རོ།",
    "ལམ་ཤེས་པ་ཉིད་བཞིན་དུ་ཐམས་ཅད་ཤེས་པ་དང་མཐོང་བའི་བལྟས་ནས་འདའོ་ཞེས་གསུངས་པས་ན་འདི་ནི་གཞན་དོན་གཙོ་བོར་བྱེད་པའི་ཕྱིར་རོ།",
    "འགྲེལ་ཆེན་ལས་ཀྱང་དོགས་པ་དེ་ལྟར་བཀོད་ནས་ལན་འདི་བཞིན་དུ་གསུངས་པའི་ཕྱིར་རོ།",
    "མཐོང་ལམ་ལ་སོགས་པ་ཡང་མེད་པར་མཚུངས་པས་ཉན་ཐོས་ཀྱི་ལམ་མེད་པར་འགྱུར་ལ།",
    "ཉན་ཐོས་ལམ་འདི་ཤེས་པར་བྱ།",
    "ཉན་ཐོས་ཀྱི་ལམ་གྱི་རྣམ་པ་མི་དམིགས་པར་ཤེས་པའི་དོན་དུ་གཞི་ཤེས་བསྟན་པར་གསུངས་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "སྐབས་དྲུག་པ་ནི་འབྲས་བུ་ཐོབ་པར་བྱ་བ་ལ་རབ་ཏུ་འདྲིས་པར་བྱེད་པས་ལམ་སྤྱིར་སྦྱར་ཏེ།",
    "དེ་ལྟར་ན་ཁ་ཅིག་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་རྒྱུའོ།",
    "ཁ་ཅིག་ནི་འབྲས་བུ་གཞན་ལས་ཁྱད་པར་དུ་བསྟན་ཏེ།",
    "དེའི་ཕྱིར་རྣམ་མཁྱེན་གྱི་སྐབས་ཁོ་ནར་སྐབས་ཐམས་ཅད་འདུ་བས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་ཉིད་ལམ།",
    "ཞེས་ལམ་གཅིག་པུ་ཁོ་ན་འབྲས་བུ་དང་བཅས་པར་བསྟན་ནོ།",
    "འདི་ནི་རྣམ་མཁྱེན་གྱི་སྐབས་སུ་སྐབས་ཐམས་ཅད་འདུ་བའི་ཚུལ་ལོ།",
    "ཉན་རང་དེ་ཞི་བའི་དབྱིངས་ལས་ལངས་ཏེ་ལམ་མཆོག་ཤེས་པར་བྱེད་པ་ནི་སྐབས་དང་པོ་ནས་བསྟན་པའི་སེམས་བསྐྱེད་སྔ་མ་གསུམབསྐྱེད་དེ།",
    "སྐབས་ལྔ་པ་ལས་ཇི་ལྟར་བསྟན་པའི་རྣམ་པར་རྟོག་པ་རྣམས་སྤངས་ཏེ།",
    "ཐམས་ཅད་ཅེས་པ་ལས་སྐབས་བཞི་པའི་བྱང་ཕྱོགས་སོ་བདུན་འདི་ཉིད་གཞིར་བྱས་ནས།",
    "ཞེས་སོགས་ཀྱི་སྦྱོར་ལམ་གསུངས་ཤིང་།",
    "མཐོང་བའི་ལམ་ཁྱད་པར་དང་བཅས་པ་བསྟན་ལ།",
    "སྐབས་ལྔ་པ་སྡུད་ཚུལ་འཆད་པར་འགྱུར་བ་དང་།",
    "དེ་བཞིན་དུ་མཁྱེན་པ་གཞན་གཉིས་ཀྱི་སྡུད་ཚུལ་ལ་ཡང་འགལ་བའི་ཁུར་དུ་མ་ཞིག་མཐོང་བའི་ཕྱིར་རོ།",
    "བརྗོད་བྱ་སྐབས་དང་པོ་གསུམ་གྱིས་རྗོད་བྱེད་སྐབས་བརྒྱད་བསྡུས་ཏེ་བརྗོད་བྱ་མཁྱེན་གསུམ་གྱིས་མངོན་རྟོགས་བརྒྱད་ཀྱི་དོན་མཐའ་དག་སྡུད་པར་བྱེད་པའི་ཕྱིར་ཏེ།",
    "སློབ་དཔོན་ལྟར་ན་མཁྱེན་པ་གསུམ་པོ་འདི་ནི་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དང་པོས་གཞི་ཤེས་ཀྱི་སྐབས་རྫོགས་པར་བསྟན་པ་ཡིན་ཏེདེ་ནི་གཞི་ཐམས་ཅད་པ་ཉིད་ཀྱིས་ཟླ་བ་དང་ལྡན་པ་དང་།",
    "ལྡོག་པའི་ཟླ་བ་དང་ལྡན་པའི་རྣམ་པ་ཅན་གྱི་རྣམ་པར་རྟོག་པ་བཀག་པའི་ཕྱིར་རོ་གཉིས་པས་ལམ་ཤེས་བསྟན་ཏེ།",
    "གསུམ་པས་ནི་རྣམ་མཁྱེན་བསྟན་ཏེ།",
    "ཤེས་རབ་ཀྱིས་དེ་ལ་གནས་པར་བྱེད་པ་མ་ཡིན་ཞེས་སོགས་དོན་གྱིས་བསྟན་པའི་ཕྱིར་དང་།",
    "གཞི་ཤེས་ཀྱི་སྐབས་སུ་ཡང་བསྟན་ཅིང་གཞིས་མ་བསྡུས་པའི་ལམ་དང་རྣམ་པ་ཡང་མེད་པས་སྐབས་སྔ་མ་ལས་འདི་ལོགས་སུ་བསྟན་པ་དོན་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་སྨྲའོ།",
    "ཞེས་འདོན་པར་བྱེད་དོ།",
    "ཁྱད་པར་དུ་སློབ་དཔོན་གྱིས་ཡེ་ཤེས་ཀྱི་བྱེ་བྲག་རྣམས་རྣམ་པ་ཉིད་དུ་རྣམ་པར་གཞག་པ་ནི་རྣམ་པ་སྤྱིའི་མཚན་ཉིད་དུ་བཞག་ལ།",
    "དངོས་པོར་རྣམ་པར་གནས་པའི་དམིགས་པ་ཡང་།",
    "དོན་བསྡུ་ཐམས་ཅད་དུ་མཁྱེན་གསུམ་གྱི་ཡེ་ཤེས་ཀྱི་བྱེ་བྲག་ཉིད་སྐབས་སུ་བབ་པའི་རྣམ་པར་སྒྲུབ་པ་ཡིན་ནོ།",
    "རྣམ་མཁྱེན་གྱི་རྣམ་པའོ།",
    "བཏགས་པའི་དགོས་པ་ནི་རྣམ་པ་སོ་སོའི་དམིགས་པའི་བྱེ་བྲག་རྟོགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "ས་མཚམས་ནི་མཁྱེན་པ་གསུམ་དང་འདྲའོ།",
    "བསྡུས་ན་སྒོམ་རིམ་རྒྱས་པར་མི་རྟོགས་ཤིང་གསལ་བའི་དབྱེ་བ་ཧ་ཅང་ཕྱེ་ན་མཐའ་མེད་དུ་འགྱུར་བས་གདུལ་བྱ་ཉེ་བའི་བསམ་པ་ལ་བལྟོས་ཏེ་མཁྱེན་པ་གསུམ་གྱི་རྣམ་པ་རྣམས་གོང་ནས་གོང་དུ་ལྷག་པར་བསྟན་པའི་ཕྱིར་འདི་ལྟར་ཕྱེ་བ་ཡིན་ནོ།",
    "བདེན་བཞིའི་ཤེས་རྣམ་ནི་སྡུག་ཀུན་འགོག་པའི་མཚན་ཉིད་ཡིན་པར་འགལ་བའི་ཕྱིར་དང་།",
    "ཡུལ་གྱི་དབྱེ་བས་ཡུལ་ཅན་ལ་དབྱེ་གྲངས་བྱས་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "དོན་རྣམ་གཉེན་པོར་འགལ་ན་སྔ་རབས་པ་ལ་ལམ་བདེན་དུ་གྱུར་པའི་དོན་རྣམ་མེད་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "འདིར་དོན་རྣམ་ནི་དམིགས་པའི་ཁྱད་པར་རམ་གཞིའི་ཁྱད་པར་ལ་འདོད་ལ།",
    "ནམ་མཁའ་མེད་པའི་ཕྱིར་རོ་ཞེས་སོགས་ཀྱིས་ནི་རྟག་པར་མེད་པ་སོགས་ཀྱི་དོན་རྣམ་ཤས་ཆེ་བར་བསྟན་པའི་ཕྱིར་རོ།",
    "རྣམ་མཁྱེན་དུ་ཤེས་རྣམ་ཉིད་བསྟན་ཏེ།",
    "དམིགས་བྱེད་རྣམ་མཁྱེན་གྱིས་རྣམ་པའི་ཆ་ནས་བསྟན་པའི་ཕྱིར་རོ།",
    "ལམ་བདེན་མཐའ་དག་མེད་པར་རྟོགས་པ་ལ་འགལ་བ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་རྣམ་པ་གཉིས་པ་འཆད་པའི་སྐབས་སུ་ཡང་ལམ་གྱི་རྣམ་པ་བདུན་རྣམས་ཐེག་ཆེན་གྱི་ལམ་དུ་བྱས་ཏེ།",
    "ལམ་ཤེས་ཀྱིས་བསྡུས་པར་འཆད་པ་ཡང་ནོར་བ་ཡིན་ལ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཉོན་སྒྲིབ་ཀྱང་ཟད་པར་མི་སྤོང་བར་འགྱུར་བའི་ཕྱིར་དང་།",
    "གཞི་ཤེས་ཀྱི་དམིགས་པ་ཡིན་ནོ་ཅོག་གཞི་ཤེས་ཀྱིས་བསྡུས་པར་མི་བཞེད་ཀྱི།",
    "ཁྱེད་ནི་མེད་པ་ལ་སོགས་པའི་རྣམ་པ་འདི་ཀུན་གཞི་ཤེས་ཀྱི་རང་བཞིན་གཞི་ཤེས་རྣམས་ཁོ་ནར་འདོད་པས་གཞི་ཤེས་ཀྱི་དམིགས་པ་འཆད་པའི་སྐབས་ཡིན་པ་མ་གྲུབ་ཅེས་ལན་འདེབས་པར་རིགས་པའི་ཕྱིར་དང་།",
    "དེའི་དམིགས་པ་ཡང་ཡིན་ལམ་ཡང་ཡིན་པ་ཞིག་དེས་བསྡུས་སོ་ཞེས་ཟེར་བ་ནི་གཞན་གྱི་ལྟར་ན་དམིགས་པ་འཆད་པའི་སྐབས་སུ་རྣམ་པས་དམིགས་པ་སྡུད་མི་ནུས་བཞིན་དུ་སྡུད་པར་བརྗོད་པ་འབྲེལ་མེད་ཡིན་པའི་ཕྱིར་དང་།",
    "གཙོ་བོར་བདེན་བཞི་ཤེས་པ་ལ་སོགས་པ་སྟོན་པར་རིགས་པ་ལ།",
    "ལམ་མི་དམིགས་པར་ཤེས་པ་ཙམ་གྱིས་ཆ་ནས་སྟོན་པ་མ་འབྲེལ་བའི་ཕྱིར་རོ།",
    "སློབ་དཔོན་བདག་ཉིད་ཆེན་པོ་ལ་ནི་རྩོད་པ་དེ་གསུམ་གྱི་གོ་སྐབས་མེད་དེའདིར་ནི་མཁྱེན་གསུམ་གྱི་རྣམ་པ་གཙོ་བོར་འཆད་པའི་སྐབས་ཡིན་གྱི།",
    "དེ་ཉིད་ཀྱིས་ན་ཞར་ལ་འོངས་པ་དོན་རྣམ་ཡང་བསྟན་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "དེ་ཡང་ས་མཚམས་གང་ནས་ཡོད་པ་ཤེས་པར་བྱ་བའི་ཕྱིར་སོ་སྐྱེའི་ལམ་ནས་སྦྱོར་བ་ཡིན་པའི་ཕྱིར་རོ་ དེའི་ཕྱིར་འཇིགས་མེད་བཟང་པོའི་དགོངས་པ་མི་ཤེས་བཞིན་དུ་སྨོད་པར་བྱེད་པནི་རང་ཉིད་ཕྱུགས་པས་ཀྱང་ཕྱུགས་སུ་གསལ་བར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ནི་རྣམ་པར་འཁྱམས་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་དེ་དག་དོན་རྣམ་དུ་བྱེད་ན་ལམ་གྱི་དོན་རྣམ་དང་ཟློས་པར་འགྱུར་བས་ཀུན་འབྱུང་ལ་སོགས་པར་གྱུར་པའི་རྣམ་པ་འཆད་པར་རིགས་སོ་ཞེ་ནམ་ཡིན་ཏེ།",
    "ལམ་ཤེས་ཀྱི་སྐབས་འདིར་ནི་ལམ་ཤེས་ཀྱི་དམིགས་པར་གྱུར་པའི་བདེན་བཞི་རྟོགས་པའི་རྣམ་པ་སོ་དྲུག་ཉིད་དོན་རྣམ་དུ་རིགས་པ་ཡིན་ཏེ།",
    "དེ་ལྟ་ནའང་ཤེས་པའི་རྣམ་པ་བསྟན་པའི་དོན་མེད་པར་མི་བསམ་སྟེ།",
    "གོམས་པ་ལས་ཕུལ་དུ་བྱུང་བའི་ཁྱད་པར་སྐྱེད་བྱེད་དུ་ཡོད་པའི་ཕྱིར་ཞེས་ཟེར་རོ།",
    "རྣལ་འབྱོར་བཀག་པའི་སྦྱོར་བས་བློ་མ་དམིགས་པར་བསྒོམས་པས་ཤེས་རྣམ་བསྒོམ་བྱར་གྲུབ་བོ།",
    "འོན་ཀྱང་གཙོ་བོར་ནི་ཤེས་རྣམ་བསྒོམ་བྱ་ཡིན་ཏེགོམས་པ་ལས་ཁྱད་པར་དུ་འགྱུར་བའི་ཕྱིར་དང་།",
    "དེའི་ནང་ནས་སྒོམ་ལམ་དུ་ལམ་ཤེས་དང་རྣམ་མཁྱེན་གྱི་རྣམ་པ་ཐེག་ཆེན་གྱི་ཕྱེ་བ་ཉིད་གཙོ་བོར་བསྒོམ་བྱ་ཡིན་ཏེ།",
    "ཅེས་མི་རྟག་པའི་རྟོག་པ་ལ་མི་རྟག་པར་བཏགས་ནས་མི་རྟག་པ་སྒོམ་ཞེས་བྱ་བར་མཚུངས་པས་དེ་ནི་གྱི་ནའོ།",
    "ཤེས་རབ་འབྱུང་གནས་ཀྱིས་རྣམ་པ་རྣམས་ནི་དེ་བཞིན་དུ་ཕན་ཚུན་བསྡུས་པ་མ་ཡིན་ཏེའདིར་དེ་རྣམས་ཉིད་བསྡུས་པར་འདོད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་དང་།",
    "དམིགས་པ་སེམས་ཙམ་དུ་བྱེད་ནའང་སྣང་བ་ཐམས་ཅད་དམིགས་པར་འཆད་པར་རིགས་ཀྱི།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་རྣམ་པ་ཙམ་ཡིན་ཞེས་དང་།",
    "ཡང་རྣམ་མཁྱེན་གྱིས་མཁྱེན་པ་གཉིས་བསྡུས་ཀྱི།",
    "སྔ་རབས་པ་ནི་དོན་རྣམ་གཙོ་བོར་བྱས་ནས་དེ་ཉིད་དམིགས་པའི་ཆ་ནས་འཆད་པའི་ཕྱིར་དང་།",
    "མཁྱེན་གསུམ་གྱི་སྦྱོར་བའི་དམིགས་པའི་རྟོག་པ་རིམ་པ་ལྟར་གཞི་ལམ་རྣམ་པ་ཡིན་ནོ་ཞེས་འཆད་པར་རིགས་པ་ལ།",
    "ལམ་བདེན་ཙམ་གྱི་ནང་ཚན་ཡེ་ཤེས་ཀྱི་བྱེ་བྲག་ཉི་ཚེ་ཉིད་དམིགས་པ་ཡིན་ནོ་ཞེས་དམིགས་པའི་ཆ་ནས་འཆད་པར་མི་རིགས་པའི་ཕྱིར་དང་།",
    "དམིགས་པར་སྲིད་པ་ཙམ་གྱི་དམིགས་པའི་ཆ་ནས་སྟོན་ན་རང་ཉིད་ཀྱང་སྦྱོར་བའི་དམིགས་པའི་ཆ་ནས་སྟོན་པར་རིགས་པའི་ཕྱིར་དང་།",
    "སྦྱོར་བའང་སྦྱོར་བའི་དམིགས་པར་བྱས་པའི་ཆ་ནས་སྒྲོ་འདོགས་གཅད་བྱ་ཡིན་པས་དོན་རྣམ་དུ་འགྱུར་བ་ཡིན་གྱི།",
    "ཤེས་རྣམ་དུ་བྱས་ནས་དེའི་ཆ་ནས་དམིགས་པར་བྱེད་པ་ནི་ཤིན་ཏུབཞད་གད་ཡིན་པའི་ཕྱིར་རོ།",
    "ལམ་བདེན་གྱི་དོན་རྣམ་དང་ཤེས་རྣམ་གྱི་ཆ་ལ་ཁྱད་པར་མེད་པར་འགྱུར་བ་དང་།",
    "ཡང་ན་ལམ་བདེན་གྱི་དོན་རྣམ་མི་སྲིད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེས་ན་ཤེས་རྣམ་དམིགས་པའི་སྒོ་ནས་བསྟན་པར་འདོད་པ་ནི་དོན་རྣམ་ཁོ་ནར་འདོད་པ་ཡིན་ལ།",
    "དེ་ཡང་ལམ་བདེན་གྱི་རང་བཞིན་གྱི་དོན་རྣམ་གྱི་བྱེ་བྲག་ཉི་ཚེ་ཙམ་བསྟན་པར་འདོད་པ་ཡིན་པས་འདི་ནི་རྣམ་པ་དང་རྣམ་པ་སྒོམ་ཚུལ་གྱི་ཕྱོགས་ལ་དུད་འགྲོ་ལྟར་གྱུར་པ་ཡིན་ནོ་ དེའི་ཕྱིར་རྣམ་པའི་སྒོམ་ཚུལ་མ་ཤེས་པ་ན་སྦྱོར་བའི་སྒོམ་རིམ་མི་ཤེས་ཤིང་།",
    "དེ་མ་ཤེས་ན་མཁྱེན་གསུམ་རྒྱུད་ལ་སྒྲུབ་པའི་ཚུལ་མི་ཤེས་ལ།",
    "དེ་ནི་རགས་པར་ན་ཤིན་ཏུ་ལེགས་པས་བློ་གྲོས་ཡོད་པའི་རྣམ་འགྱུར་དུ་མཐོང་སྟེ།",
    "མཁྱེན་གསུམ་གྱི་བྱེ་བྲག་མ་ལུས་པ་རྒྱུད་ལ་སྦྱར་དགོས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་རྒྱུ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་སློབ་དཔོན་གྱིས་འཇུག་པའི་ཡུལ་གྱི་རྒྱུ་ཡིན་ནོ་ཞེས་འཆད་པར་མཛད་དོ།",
    "གཞན་དུ་བྱང་སེམས་ཀྱིས་འབྲས་བུ་རྣམ་མཁྱེན་ཐོབ་པ་མི་སྲིད་པའི་ཕྱིར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ད་ནི་བྱེ་བྲག་ཏུ་དཔྱད་པར་བྱ་སྟེ།",
    "གཉེན་པོ་གཞི་ཤེས་ལས་རྫས་ལོགས་སུ་ཅུང་ཟད་ཀྱང་མེད་དོ་ཞེས་ཤེས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་ཁོ་བོ་ནི་དངོས་བསྟན་གཉེན་པོ་གཞི་ཤེས་ཀྱི་རྣམ་པ་གཉིས་ཀ་འཛིན་པར་སྨྲ་སྟེ།",
    "སྒྲས་བརྗོད་དུ་མེད་པར་མྱོང་བ་སྐྱེ་བ་དང་།",
    "ལམ་བདེན་གྱི་སྐབས་འདིར་གཞི་ཤེས་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "ཟག་ཅས་ཟག་མེད་ཁྱད་པར་དུ་དཔྱད་པའོ།",
    "ཤེས་སྒྲིབ་ཀྱང་རྗེ་ཐོབ་ཀྱིས་གཙོ་བོར་སྤང་བས་དེའི་གཉེན་པོ་ཟག་བཅས་གཅིག་པུ་འཆད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འོ་ན་ནི་ཉོན་སྒྲིབ་ཀྱི་གཉེན་པོར་ཡང་མཉམ་རྗེས་ཀྱི་རང་བཞིན་གྱི་ཟག་བཅས་དང་ཟག་མེད་གཉིས་འབྱེད་པར་མཚུངས་སོ་ཞེ་ན།",
    "འགྲེལ་ཆེན་ཡང་འདི་དང་འགལ་བས་མི་འཐད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་འགྲེལ་པ་འདི་གཉིས་ཐམས་ཅད་དུ་མཐུན་པར་མ་ངེས་ཏེ།",
    "འདི་ནི་སློབ་དཔོན་བློ་གྲོས་ཡོངས་སུ་རྫོགས་ནས་བྱས་པ་ཡིན་པས་འགྲེལ་ཆེན་ལས་ཕུལ་དུ་བྱུང་བའི་ཕྱིར་རོ།",
    "དེའི་ཟག་མེད་ཟག་པ་རྒྱས་པར་མི་འགྱུར་བ་ལ་འཇོག་པར་གང་ལས་ཤེས་ན།",
    "ཟག་རྣམས་ཀུན་ཏུ་རྒྱས་པར་འགྱུར།",
    "རྗེས་ཐོབ་ན་སྤྲོས་པ་ཡོད་པས་སྒྲུབ་པའི་ཚུལ་དུ་གསུངས་པ་ཡིན་གྱིསྒྲ་ཇི་ལྟ་བར་གཟུང་བར་མི་བྱ་སྟེ།",
    "རང་བཞིན་གྱིས་སྟོང་པས་དུས་གསུམ་མི་དམིགས་པར་རྟོགས་ཞེས་ཟེར་བ་ནི་མི་རིགས་ཏེ།",
    "ཞེས་སོགས་ཀྱི་སྐབས་འདིར་གལ་ཏེ་རང་རྒྱལ་གྱིས་ཀུན་བྱང་སོགས་རང་བཞིན་མེད་པར་རྟོགས་ན་འཛིན་མེད་རྟོགས་པར་འགྱུར་རོ་ཞེ་ན།",
    "སློབ་པ་ལ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ངེས་འབྱུང་གང་ཡིན་པ་ཞེས་སྨོས་ནས་གཞན་རྣམས་ལ་ཇི་ལྟར་ཞི་བ་ཞེས་སོགས་ཀྱི་ཁྱད་པར་སྨོས་པ་ནི་དོན་མ་གོ་བར་ཟད་པའི་ཕྱིར་དང་།",
    "དེ་རྣམས་འགོག་བདེན་གྱི་རྣམ་པ་ལ་སྦྱར་བྱ་མ་ཡིནའགོག་བདེན་རང་ཉིད་ལ་ཡིན་ན་གཞན་རྣམས་ལའང་ཞི་བ་གང་ཡིན་པ་ཞེས་སོགས་སུ་མཚུངས་པས་ཁྱད་པར་དོན་མེད་པའི་ཕྱིར་རོ།",
    "བདེན་བཞི་ཤེས་པའི་ལམ་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་བྱེ་བྲག་སོ་དྲུག་ཉིད་ལམ་ཤེས་ཀྱི་རྣམ་པ་ཡིན་གྱིརང་རིག་སོ་དྲུག་ཤུགས་ཀྱིས་འཕེན་པར་འཆད་པ་རྣམས་ནི་མི་འཐད་དོ་ཞེས་ཟེར་རོ།",
    "ཡུམ་འདི་ནི་ཞེས་པས་རྣལ་འབྱོར་པ་རང་རྒྱུད་ཀྱི་ལམ་ཤེས་གསལ་བར་བྱས་ཏེ།",
    "རྣམ་མཁྱེན་གྱི་སྐབས་སུ་རྣམ་མཁྱེན་གྱིས་འཕགས་པའི་གང་ཟག་ཐམས་ཅད་བསྡུས་ཞེས་བྱ་བ་འདིར།",
    "དེ་ནི་རྟེན་དང་དམིགས་རྣམ་གྱི་ཁྱད་པར་གྱིས་ལོགས་སུ་ཕྱེ་བ་ཡིན་ལ།",
    "དེ་གཉིས་ཀྱི་སྐབས་སུ་གསུམ་དུ་མ་ཕྱེ་བར་འདིར་ཕྱེ་བ་ནི་མཁྱེན་པ་དང་པོ་གཉིས་ཡིན་ཀྱང་།",
