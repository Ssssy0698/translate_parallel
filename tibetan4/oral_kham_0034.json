    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྔར་གྱི་སྙན་སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ལ་ལའི་ཐོག་མཚར་གཏམ་ཞེས་བཀོད་གནང་མཛད་འདུག་པས་གོང་གསལ་ཐ་སྙད་དེ་གཉིས་ཕན་ཚུན་ཡིན་ཁྱབ་མཉམ་འདྲ་ཤས་ཆེ།",
    "གོན་ནས་རྐང་པའི་རླངས་པ་མི་ཤོར་བ་བྱེད་ཀྱི་འདུག་པས་ངས་ཀྱང་འགྱིག་ཤོག་གོན་ནས་རྐང་པའི་རླངས་པ་མི་ཤོར་བ་བྱེད་ཀྱི་ཡོད་ཅེས་ལན་བཏབ་ཅེས་པ་ལྟ་བུ་དང་།",
    "ལྷ་བུས་ཀྱང་དབུ་ཆེན་ལ་བཟོ་བསླབ་འདུག་ཅེས་དང་།",
    "པའི་ཁོ་བོའི་བསམ་པར་སྒྲུང་ཐུང་འགྱུར་ཁུག་མང་བའི་མཛའ་གླུ་ཞེས་ངརྩོམ་འགོ་འཛུགས་སྟངས་དང་རྩོམ་མཇུག་བསྡུ་སྟངས་ཧ་ཅང་ཡག་པོ་བྱུང་འདུག་སྙམ།",
    "ཞེས་ལྷ་བུ་དམག་དུས་འཐིམ་སྟེ་དམག་ཁོངས་ནས་ཕྱིར་ལོག་བྱས་པ་དེ་ནས་རྩོམ་འགོ་བཙུགས་ཡོད་པ་དང་།",
    "ལྷ་བུས་ཀྱང་དབུ་ཆེན་ལ་བཟོ་བསླབ་འདུག་ཅེས་འཕྱ་སྨོད་ཟུར་ཟ་བྱས་པ་དང་།",
    "རིམ་པ་གསུམ་པའི་བྱས་རྗེས་འཇོག་ཐུབ་ནའང་དམག་དུས་ཐིམ་རྗེས་ལམ་སེང་རྒྱལ་ཁབ་ཀྱི་ལས་བཟོ་གང་རུང་ཞིག་ལ་ལས་བགོས་བྱེད་དང་བྱེད་མུས་ཡིན།",
    "སྔོན་ཆད་ལུང་པ་འདི་ནས་ཉིན་བཅུ་ལས་རིང་བ་ཁ་གྱེས་མ་མྱོང་བས་ང་ཕ་ཡུལ་དྲན་པ་འདུག་ཟེར།",
    "ཡང་ཉིན་དགུང་ང་གཉིས་རྩྭ་ཐང་དུ་ཚ་འབོག་རྒྱག་དུས་ཁོས་གྲོགས་པོ་བསྟན་པ་ཡར་རྒྱས།",
    "སྒྲུང་ཐུང་དེའི་བརྗོད་དོན་གཙོ་བོ་ནི་བྱང་པ་ཚོས་དཀའ་སྤྱད་འབད་བརྩོན་གྱིས་ཚྭ་ལེན་པར་ཕྱིན་པའི་སྐོར་གློག་བརྙན་ནང་ནས་བསྟན་པ་བཞིན་ཤིན་ཏུ་གསལ་བར་བཀོད་འདུག་ལ་རྗོད་བྱེད་ཚིག་ཀྱང་གོ་བདེ་ཞིང་།",
    "ལེགས་ཉེས་སོགས་ཀྱི་སློབ་ཚན་ཞིབ་ཕྲ་ཞིག་འཁྲིད་གནང་མཛད་འདུག་གོ།",
    "དེ་ཡང་རང་ཅག་གངས་ཅན་ལྗོངས་ཀྱི་སྟོད་མངའ་རིས་བསྐོར་གསུམ་དང་།",
    "རྣ་བར་གསེཪ་གྱི་རྣ་ལོང་བོད་གཡུ་གྲུ་དམཪ་འབུར་དུ་ཐོན་པ་ཞིག་སྤྲད་པ་བཅས་བཏགས་འདུག་ལྟ་བུའི་མི་སྣའི་འཁྲབ་ཆས་ཞིབ་འབྲི་གནང་བ་མི་ཉུང་བ་ཞིག་ཡོད་པ་དེས་བརྩམས་སྒྲུང་ཧྲིལ་པོ་ལེགས་གྲུབ་ཡོང་རྒྱུར་གལ་ཆེའི་ནུས་པ་ཐོན་འདུགལྔ།",
    "ཅོག་ཙེ་གཅིག་དེ་མིན་ཐབས་ཆས་སྟབས་བདེ་ཞིག་ལས་གཞན་གང་ཡང་མི་འདུག་ཁང་པའི་ནང་གད་བདར་གཙང་དཔྱད་བརྗོད་བུང་བ་མྱོས་གླུ།",
    "སྒྱུ་རྩལ་ལ་དཔྱད་པ་ཞིབ་ཕྲ་གནང་འདུག་པ་དེ་ནི་ཕལ་ཆེར་བོད་ཡིག་ཐོག་ནས་གཞོན་ནུ་ཟླ་མེད་ཀྱི་གཏམ་རྒྱུད་ལ་བྲིས་པའི་དཔྱད་རྩོམ་དང་པོ་དེ་ཡིན་པ་འདྲ།",
    "འཛིན་པ་རྣམས་ལ་གྲགས་ཅན་གྱི་གནའ་རྩོམ་ཁག་ལ་དཔྱད་པ་བྱེད་པའི་མིག་དཔེ་བཟང་པོ་ཞིག་བསྟན་གནང་མཛད་འདུག་སྙམ།",
    "༥ སྐལ་བཟང་ཡེ་ཤེས་ལགས་ཀྱིས་གཞོན་ནུ་ཟླ་མེད་ཀྱི་གཏམ་རྒྱུད་ཀྱི་རྩོམ་རིག་སྒྱུ་རྩལ་ཐད་ཀྱི་ཁྱད་འཕགས་རང་བཞིན་ལའང་ཞིབ་འཇུག་ནན་པོ་གནང་ནས་བསྔགས་བརྗོད་ཆེ་ཆེར་གནང་འདུག་པ་ནི།",
    "དོན་གང་ཞིག་བསྡུས་པ་འབྲི་དགོས་པས་བསྡུས་བྲིས་བྱས་ཡོད་མིན་ཡང་གསལ་པོར་གསུངས་འདུག་པ་ནི་ཧ་ཅང་དོན་ལ་གནས་པའི་དཔྱད་པ་ཞིག་ཡིན་དཔྱད་རྩོམ་བུང་བའི་མགྲིན་གླུ།",
    "ཅེས་དེ་དག་ནི་བརྗོད་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགདོན་མཚོན་སྟངས་ཀྱི་རྣམ་པའི་ཐད་འོ་ཆུ་འདྲེས་པ་ལྟར་འབྲེལ་བ་དམ་ཟབ་ཡོད་པའི་ངོས་འཛིན་གནང་འདུག་༣དཔྱད་རྩོམ་ནང་སྤྱིར་སྟོན་པ་ཤཱཀྱ་ཐུབ་པ་དང་།",
    "ལྟ་བ་ཡང་དག་ཡིན་པའི་གྲུབ་བྱེད་མང་པོ་ཞིག་གསུངས་འདུག་པ་ནས་འདིར་འགའ་ཞིག་དཔེ་མཚོན་དུ་དྲངས་ན་འདི་ལྟ་སྟེ།",
    "དེ་ལ་ཡིག་ལ་བསྐོར་བའི་རྗེས་ཁྲིད་ཡིན་མིན་ཞིབ་ཏུ་བརྟག་དགོས་པ་འདུག་སྙམ།",
    "སྙན་ངག་ཤོ་ལོ་ཀ་དེ་གཉིས་སྙན་ངག་རྩོམ་ཧྲིལ་པོ་ཁྲི་འཕང་མཐོན་པོར་འཛེགས་པར་སྐས་ཀྱི་གདང་བུ་འཕར་མ་ཞིག་བསྣན་པ་ལྟ་བུའི་ནུས་པ་ཐོན་འདུག་གོ།",
    "གཞན་ཡང་སྙན་རྩོམ་འདིའི་ནང་སྙན་གཞུང་ནང་གསལ་རྒྱན་ཡང་ཧ་ཅང་མང་པོ་ཞིག་སྦྱར་གནང་མཛད་འདུག་པ།",
    "རྒྱན་སྦྱར་སྟངས་སོགས་ལ་དཔྱད་པ་ཞིབ་ཕྲ་མ་གནང་བའང་ཡང་ན་དཔྱད་པ་གནང་མི་འདུག་ཁོ་བོའི་བསམ་པར་རྟོགས་བརྗོད་འདིའི་ཚིག་སྦྱོར་དང་།",
    "ང་རང་རང་ཉིད་ནས་ཀྱང་བློ་ཁོག་ཆེན་པོས་གཏམ་བརྗོད་ཟློས་གར་དང་།",
    "སྒྱུ་རྩལ་ལ་བརྟེན་ནས་བཞད་གད་སློང་ཐབས་མང་པོ་གནང་འདུག་པ་ནི།",
    "ཐའོ་ཡན་ཡ་མ་རྒྱང་མཁན་ཞིག་འདུགཁ་པ།",
    "ཡང་དགོད་བྲོའི་གཏམ་གླེང་ང་ཆེན་པོ་ཆགས་འདུག་གམ་ཞེས་པ་ལས།",
    "བློ་དང་སྤོབས་པའི་སྟོབས་ལ་འཇུས་ནས་གྱི་ནར་མ་འདུག་ལྡང་ཞིག་ཅེས།",
    "ད་ནི་རྗེས་མའི་ལོ་སྟེ་དུས་སང་ནས་རྒྱ་ལྕང་འདེབས་བློ་མི་འདུག་ཅེས་གསུངས་སོ།",
    "དེ་ཡང་ད་ཕན་འབྲས་དཀར་ཞེས་པར་འབྲི་ཚུལ་ཁ་ཤས་འདུག་པ་ནི།",
    "སྐྱེས་མཆོག་ཡིད་བཞིན་གྱི་ནོར་བུ་དེ་ཕེབས་དུས་ཙ་ན།",
    "ལེགས་པོ་འདུག་གོ་གསུངས་ཀྱིས།",
    "ཡག་པོ་འདུག་གོ་གསུངས་ཀྱིས།",
    "སྙན་པོ་འདུག་གོ་གསུངས་ཀྱིས།",
    "དཔྱིད་དུས་དང་དབྱཪ་དུས་སྟོན་དུས་བཅས་ལ་མེ་ཏོག་དུས་དང་ཆར་ལྡན་དུས་འབྲས་བུའི་དུས།",
    "མེ་ཏོག་དུས་དང་ཆར་ལྡན་འབྲས་བུའི་དུད།",
    "རྩེན་འདོད་གསེར་ཉའི་ཚོགས་རྣམས་འདིར་བྱོན་ཅིགདེ་ཡང་རང་ཅག་བོད་ཀྱི་གཏམ་དཔེ་ནི་རྒྱ་ཆེའི་མི་དམངས་མངཚོགས་ཀྱིས་ཡུན་རིང་འཚོ་བའི་ནང་གསར་རྩོམ་བྱས་པའི་དམངས་ཁྲོད་ཀྱི་རྩོམ་རིག་ཕུལ་དུ་བྱུང་བ་ཞིག་ཡིན་པས་བོད་མི་དམངས་ཀྱི་འཚོ་བའི་ཞིང་ས་ཡངས་པོའི་སྟེང་རིང་ནས་རྩ་བ་བརྟན་པོ་ཚུགས་ཡོད་སྟབས་ས་མཐོའི་ཐུན་མིན་ཡུལ་སྲོལ་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིགགོམས་གཤིས་དང་།",
    "རྡོ་བཟོ་མཁས་ཀྱང་རང་མིག་ལོང་།",
    "ཤིང་བཟོ་སྡུག་ཀྱང་རང་ཐུག་འཁོལ།",
    "རང་རང་གཙང་བ་དགོས།",
    "ཁོང་རང་ཉིད་ནི་གཞན་གྱི་དཔུང་ཁག་ནང་རྩ་བ་ནས་ཞུགས་ཀྱི་མེད།",
    "དགའ་ཚོར་ལྡན་པ་ཞིག་འདུག་ཁོང་དགའ་སྤྲོ་རབ་ཏུ་སྐྱེས་ཏེ་ལག་གཉིས་བསྒྲེངས་ནས་སྐད་གསང་སྒྲོག་བཞིན་གནས།",
    "དེ་བཞིན་ཁོང་རང་ཉིད་སྤྲོ་འཆམ་ལ་དགའ་བ་དང་།",
    "ཁྱེད་རང་ལ་འཕྲད་པའི་མི་ཐམས་ཅད་ལ་རྩད་འདྲི་གྱིས་དང་།",
    "གཤིས་བརྒྱུད་ངན་པ་ཞིག་ཡིན་པས་དེ་དག་ཚང་མ་ན་ལའི་ལུས་ཐོག་ཏུ་འགོས་འདུག་ཅེས་སྐྱོན་འཛུགས་བྱས་པ་མ་ཟད།",
    "ཕྲུ་གུ་ཡང་ངན་པ་བཟོ་ཉེན་འདུག་ཅེས་བཤད།",
    "ལོར་དབྱིན་ཇིའི་རང་བཙན་ཟློས་གར་ཁང་དུའང་འཁྲབ་གཞུང་དེ་འཁྲབ་སྟོན་བྱས་པར་རྒྱན་གོས་གཟབ་མཆོར་སྤྲས་པའི་དབྱིན་ཇིའི་ཝེ་ཏུའོ་ལི་ཡའི་མི་དྲག་ཚོས་འགྲིག་འདུག་བསམ་པ་བྱེད་ཀྱི་མེད།",
    "ཉུང་ཤས་དེ་ག་དུས་ཡིན་རུང་རྗེས་སུ་ལུས་པའི་ཉུང་ཤས་ཤིག་ཡིན་ཞེས་བརྗོད།",
    "ཁོ་པ་ནི་ཐབས་ངན་གང་ཡོད་སྤྱོད་མཁན་ཞིག་དང་རང་ཕན་གཞན་གནོད་བྱེད་མཁན་གྱི་རྫུ་བཟང་ཞིག་ཡིན་ཞིང་།",
    "པོ་ཉི་ཁོ་རང་ཉིད་ནི་བརྗིད་ཉམས་ཆེན་པོས་རང་གནས་སུ་བསྡད་པ་མ་ཟད།",
    "ཉམས་ཞན་གྱིས་གཉའ་གནོན་བཤུ་གཞོག་མྱོང་རྒྱུ་ནི་ལོས་ཡིན་པ།",
    "བྱེད་ཐུབ་རོགས་བྱས་ན་རང་ནི་ཨིབ་སེན་བྱེད་འདོད་འདུག་ཅེས་གསུངས།",
    "ཟླ་པཏེན་མག་དང་ཕུའུ་ལུའུ་ཧྲི་དམག་པའི་ནང་རང་ཉིད་བརྒྱབ་པ།",
    "བསྲུང་སྤེལ་བྱུང་ན་ཅི་མ་རུང་སྙམ་པའི་བློ་ཞིག་འདུག།",
    "དེའི་སྟེང་རང་ཉིད་དང་མ་བྱན་བཅས་བདུན་ཡོད།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའི་ཚེ།",
    "བསྟན་བཅོས་འདིར་ཉན་ང་རང་རྒྱུད་པའི་ལམ་བསྟན་ནོ།",
    "གཟུགས་ལ་སོགས་པ་སྔ་མ་བཞིན་དུ་ང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར་གཟུགས་སོགས་སུ་མི་དམིགས་པ་དང་།",
    "སྐུ་བསེ་རུ་ལྟར་གཅིག་པུར་འདུག་པ།",
    "༡༣འདུ་ཤེས་པས་ནང་རང་ལ་གཟུགས་ཅན་མ་ཡིན་པ་མིང་དུ་འདུ་ཤེས་པས་ཕྱི་རོལ་གྱི་གཟུགས་ལ་སྔར་བཞིན་ལྟ་བའོ།",
    "སྣང་ཡང་རང་བཞིན་མེད་པ་སྒྱུ་མ་ལྟ་བུ་དང་།",
    "རྣམ་པའང་རང་བཞིན་སྤྲོས་པ་མ་ལུས་པ་རང་བཞིན་གྱིས་ཞི་བ་ཉིད་དོ།",
    "འདུག་པ་ལྟར་མི་གཡོ་བ་དང་།",
    "དེ་དག་ཉན་རང་རང་དོན་དུ་སྒོམ་ཞིང་རང་ལ་སྒྲུབ་བོ།",
    "བྱང་སེམས་གཞན་དོན་དུ་ཡིད་ལ་བྱེད་ཅིང་རང་གཞན་གཉིས་ཀ་ལ་སྒྲུབ་བོ།",
    "རིང་ན་འདུག་ཀྱང་དེ་དང་དེར།",
    "ལ་སོགས་པ་འདུག་གནས་སོགས་ལྷག་པར་བྱིན་པས་གཙུག་གཏོར་དང་ལྡན་པ་དང་།",
    "རང་ཉིད་གདན་དེ་ལ་འཚམ་ཞིང་རྐྱེན་དུ་བབ་པར་འདུག་ལ་འཁོར་གྱི་པདྨ་ལ་ས་དགུ་པ་མན་ཆད་ཀྱི་བྱང་སེམས་བཞུགས་པས་བསྐོར་ཏེ་འདུད་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་བུ་སྟོན་ཆེན་པོའི་འགྲེལ་པ་བཞུགས།",
    "དེ་བཞིན་དུ་ཕུང་པོ་ལྷག་མ་རྣམས་ཀྱང་རང་བཞིན་མེད་པར་བསྟན་ནས་བདེ་བ་དང་འཕྲད་པའི་སྲེད་པ་དང་།",
    "དེས་ན་འདི་དག་ནི་སེམས་དང་དེ་ཁོ་ན་ཉིད་དོན་ལ་ཐ་དད་དུ་ཡོད་པས་དེ་གཉིས་རོ་གཅིག་ཏུ་འདྲེས་པའི་བློ་དེ་གནས་ཚུལ་ལ་མ་ཞུགས་ཐ་དད་དུ་ཤེས་པའི་བློ་དེ་གནས་ཚུལ་ལ་ཞུགས་པར་དོན་གྱིས་ཁས་བླངས་འདུག་གོ།",
    "པྲེ་ཥོ་ད་ར་ཞེས་པའང་དོན་མ་རྟོགས་པར་ཡི་གེ་མ་དག་པ་བྲིས་འདུག་པའི་ཕྱིར་དང་།",
    "ཁྱེད་རང་ལ་ཁས་བླངས་འགལ་ཏེ།",
    "དྲུག་པ་ནི་གཞན་དོན་རྗེས་དཔག་ཐམས་ཅད་ཀྱང་རང་རྒྱུད་པས་རང་རྒྱུད་ཀྱི་སྦྱོར་ངག་ཏུ་འདོད་ལ།",
    "དུས་ཐ་དད་ལ་གཞན་ཉིད་མེད་པས་གཞན་སྐྱེ་དགག་དུས་མཉམ་པ་ལ་སྐྱེ་བ་མེད་པས་གཞན་སྐྱེ་དགག་པའོ།",
    "གཞན་ཡང་རང་རང་ངོ་བོས་སྟོང་པར་སྒྲུབ་པ་ལ་༩༥",
    "བདེན་གཉིས་ཐ་སྙད་དུ་རང་རང་ངོ་བོས་མི་སྟོང་པའི་ཕྱིར།",
