    "འཕགས་པ་བདག་གི་ཁྱིམ་ཐབ་སེར་སྣ་ཅན།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀ་ཕྱི་དེ་ཉིན་པར་བདག་ཉིད་དང་གཉིས་དེར་སོང་བ་དང་།",
    "དེ་བཞིན་དུ་བདག་ཉིད་དང་དྲུག་བཅུའི་བར་དུ་ཉིན་རེ་ལན་རེ་སོང་སྟེ་བྲམ་ཟེའི་ཁྱིམ་དེར་བསོད་སྙོམས་ཟོས་པ་དང་།",
    "བྲམ་ཟེ་དེས་ལག་པས་བཅལ་བ་བརྒྱ་དག་གིས་ལོངས་སྤྱོད་དག་བསྒྲུབས་ན།",
    "དེ་དག་བྲམ་ཟེ་མོ་དེས་ཤཱཀྱའི་བུའི་དགེ་སྦྱོང་དག་དང་ལྷན་ཅིག་ཟ་བར་བྱེད་དོ་ཞེས་སྨོད་པར་བྱེད།",
    "བྲམ་ཟེའི་ཁྱེའུ་ཞིག་བྱ་བ་འགའ་ཞིག་ལ་མཉན་ཡོད་ནས་རི་བྲགས་དེར་སོང་བ་དང་།",
    "བྲམ་ཟེའི་ཁྱེའུ་ཁྱོད་ག་ལས་འདིར་འོངས།",
    "ཁྱོད་ཀྱིས་ཁོ་བོའི་ཁྱིམ་གྱི་གཏམ་ཐོས་སམ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཁྱིམ་ནི་ཤཱཀྱའི་བུའི་དགེ་སྦྱོང་དག་གི་ཁྱིམ་དང་པོ་ལགས་སོ།",
    "ཤཱཀྱའི་བུའི་དགེ་སྦྱོང་དྲུག་བཅུ་ཉིན་རེ་ལན་རེ་མཆིས་ཏེ་བསོད་སྙོམས་འཚལ་ལོ།",
    "དེ་ལམ་གར་སོང་སྟེ་བསྡད་པ་དང་།",
    "ཇི་ཙམ་ན་བྲམ་ཟེའི་ཁྱེའུ་གཞན་ཞིག་བྱ་བ་འགའ་ཞིག་ལ་མཉན་ཡོད་ནས་རི་བྲགས་དེར་སོང་བ་དང་།",
    "བྲམ་ཟེའི་ཁྱེའུ་ཁྱོད་ག་ལས་འདིར་འོངས།",
    "ཁྱོད་ཀྱིས་ཁོ་བོའི་ཁྱིམ་གྱི་གཏམ་ཐོས་སམ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཁྱིམ་ནི་ཤཱཀྱའི་བུའི་དགེ་སྦྱོང་དག་གི་ཁྱིམ་དང་པོ་ལགས་སོ།",
    "ཤཱཀྱའི་བུའི་དགེ་སྦྱོང་དྲུག་བཅུ་ཉིན་རེ་ལན་རེ་མཆིས་ཏེ།",
    "དེ་དང་འདི་མཐུན་པས་དེ་ལྟར་གྱུར་གྱིས་བྲམ་ཟེ་མོ་དེས་ལོངས་སྤྱོད་དག་ཟོས་པར་གྱུར་ན་མི་རུང་གིས་འགྲོའོ་སྙམ་མོ།",
    "དེ་ནས་བྲམ་ཟེ་དེ་ཕྱིར་འོངས་ཏེ་བྲམ་ཟེ་མོ་དེ་ལ་སྨྲས་པ།",
    "བྲམ་ཟེ་མོ་ངན་པ་ཁོ་བོས་ལག་པས་གཞལ་བ་བརྒྱ་དག་གིས་ལོངས་སྤྱོད་དག་བསྒྲུབས་ན།",
    "ཁྱོད་དེ་དག་ཤཱཀྱའི་བུའི་དགེ་སྦྱོང་དག་དང་ལྷན་ཅིག་ཟ་བར་བྱེད་དམ།",
    "ཁྱོད་ཀྱིས་བྲམ་ཟེ་རིག་བྱེད་གསུམ་དང་ལྡན་པ་དག་མ་མཐོང་ངམ་ཅི་ན།",
    "དགེ་སྦྱོང་མགོ་རེག་དེ་དག་ལ་སྦྱིན་པར་བྱེད་ཅེས་དེས་དེ་བརྡེག་པར་བརྩམས་པ་དང་།",
    "བྲམ་ཟེ་ཁྱོད་ཀྱིས་ཁོ་མོ་ལ་གཏད་པའི་བང་བ་དག་ཁོ་མོས་རྒྱ་ཉམས་པར་བྱས་སམ།",
    "ཁྱོད་ཀྱིས་ཟས་དེ་སྙེད་ག་ལས་རྙེད།",
    "བདག་གི་ཕྲུ་བ་འདིར་འབྲས་ཆན་དང་།",
    "བདག་གིས་ཁྱོད་ཀྱི་མངོན་སུམ་དུ་འགྱུར་བར་བྱའོ་ཞེས་དེས་ཕྱི་དེ་ཉིན་པར་ཚེ་དང་ལྡན་པ་འཆར་ཀ་བདག་ཉིད་དང་དྲུག་བཅུ་དེར་འོངས་པ་ལ་དེ་བཞིན་དུ་བསོད་སྙོམས་ཕུལ་ནས་དེས་སྨྲས་པ།",
    "བྲམ་ཟེ་ཁྱོད་ཀྱིས་མཐོང་ངམ།",
    "བཙུན་པ་འཆར་ཀས་སང་བདག་གི་སྡུམ་པར་གདུགས་ཚོད་གསོལ་བར་ཅི་གནང་།",
    "ཚེ་དང་ལྡན་པ་འཆར་ཀས་བྲམ་ཟེ་དེ་ལ་ཅང་མི་སྨྲ་བས་དང་དུ་བླངས་ཏེ་སོང་ངོ།",
    "དེ་ཉིད་ཀྱི་མཚན་མོ་བཅའ་བ་དང་བཟའ་བ་གཙང་ཞིང་བསོད་པ་དག་སྟ་གོན་བྱས་སོ།",
    "བྲམ་ཟེའི་ཁྱིམ་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་སྟན་བཤམས་པ་ཉིད་ལ་འདུག་གོ།",
    "དེ་ནས་བྲམ་ཟེ་དེས་ཚེ་དང་ལྡན་པ་འཆར་ཀ་བདེ་བར་འདུག་པར་རིག་ནས་བཅའ་བ་དང་བཟའ་བ་གཙང་ཞིང་བསོད་པས་རང་གི་ལག་ནས་ཚིམ་པར་བྱེད།",
    "རྣམ་གྲངས་དུ་མར་བཅའ་བ་དང་བཟའ་བ་གཙང་ཞིང་བསོད་པས་རང་གི་ལག་ནས་ཚིམ་པར་བྱས་ཤིང་བསྟབས་ནས།",
    "སྔོན་གྱི་ཕ་མེས་དག་གིས་ཀྱང་མ་བགྱིས།",
    "དགེ་སྦྱོང་དང་བྲམ་ཟེ་དག་གིས་ཀྱང་མ་བགྱིས།",
    "བྱམས་པ་དང་མཛའ་བཤེས་དང་རྩ་ལག་གི་ཚོགས་ཀྱིས་ཀྱང་མ་བགྱིས་ཏེ།",
    "ངན་སོང་གི་སྒོ་དག་ནི་བཀུམ།",
    "ཐོག་མ་མ་མཆིས་པའི་དུས་ནས་བསགས་པའི་འཇིག་ཚོགས་ལ་ལྟ་བའི་རིའི་རྩེ་མོ་ཉི་ཤུ་མཐོ་བ་ཡེ་ཤེས་ཀྱི་རྡོ་རྗེས་བཅོམ་སྟེ་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ནི་ཐོབ་སྟེ།",
    "བཙུན་པ་འཆར་ཀས་ཇི་སྲིད་འཚོའི་བར་དུ་བདག་གི་བསོད་སྙོམས་དང་།",
    "དེའི་མིང་གཏུམ་མོ་གཏུམ་མོ་ཞེས་བྱ་བར་གྱུར་ཏོ།",
    "བུ་ཁྱོད་ཀྱི་མ་འདི་གཏུམ་པས་གཞན་དག་དང་ལྷན་ཅིག་འཐབ་ཀྲོལ་བྱེད་པས།",
    "བདག་ཅག་ཁྲི་མོན་དུ་བཅུག་པས་འཆི་བར་བྱ་དགོས་པ་གང་ཡིན་པ་དེ་ལྟ་བུའི་གནས་ཡོད་པར་འགྱུར་གྱིས།",
    "རེ་ཞིག་དུས་སྟོན་ཐལ་གྱི་བར་དུ་རི་བྲགས་གཞན་དུ་འདོང་ཞིང་འཁོད་ལ།",
    "ཁྱོད་སོང་ལ་མ་ལ་དྲིས་ཤིག།",
    "ཡུམ་བདག་བགྱི་བ་ཆུང་ཞིག་གི་སླད་དུ་རི་བྲགས་ག་གེ་མོ་ཞིག་ཏུ་མཆིའོ།",
    "གཏུམ་མོས་སྨྲས་པ།",
    "གང་དུ་ཁོ་མོའི་དང་པོའི་གོས་སོང་བ་དེར་སོང་ཤིག།",
    "གཏུམ་མོས་སྨྲས་པ།",
    "གང་ནས་ཡང་ཕྱིར་མི་འོང་བ་དེར་སོང་ཤིག།",
    "གཏུམ་མོས་བུ་མོ་མངག་གཞུག་མ་ལ་སྨྲས་པ།",
    "བུ་མོ་ཁུར་སླང་ཚུགས་ཤིག་དང་།",
    "གཏུམ་མོ་དེ་གདུལ་བའི་དུས་ཡིན་ནོ་སྙམ་ནས་དེ་སྔ་དྲོ་ཤམ་ཐབས་བགོས།",
    "དེ་མཐར་གྱིས་བསོད་སྙོམས་ལ་རྒྱུ་བ་ན་གཏུམ་མོའི་ཁྱིམ་དུ་འཇུག་པར་བརྩམས་པ་དང་།",
    "དེ་འཇུག་པ་གཏུམ་མོས་མཐོང་ནས་དེས་བུ་མོ་མངག་གཞུག་མ་ལ་སྨྲས་པ།",
    "བུ་མོ་དགེ་སྦྱོང་འདི་སྐྲོད་ཅིག།",
