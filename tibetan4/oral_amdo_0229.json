    "འཆི་བའི་དུས་བྱེདཔར་ཡད་ཉེ་བར་འདིདི་ག་ཐམས་ཅད་ཀྱང་བདག་གིས་བརྩེན་དུ་བཅུག་དགའ་བར་བྱས་བདེ་བར་གསོས་ན།",
    "མ་ཕམ་པ་ཁྱོད་མོས་པར་བྱ་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "བདག་གི་ཁྱིམ་ནས་བྱུང་སྟེ།",
    "གཙུག་ལག་ཁང་ངུ་སོང་ལ།",
    "དེ་ཚ་ནྡས་ནས་ལུས་ཕྱི་མ་དང་བ་དག་གི་ངོ་བོ་བྱམ་ཐོབ་པ་ལ་གླང་གི་ཤིང་རྟ་འཐོབ་པར་འགྱུར་རོ།",
    "རྟའི་ཤིང་རྟ་དང་གླང་པོ་ཆེའི་ཤིང་རྟ་དང་ཁྱོགས་ཀྱི་བཞོན་པ་དང་གྲུའི་བཞོན་པ་དང་ཁྱུ་མཆོག་གི་བཞོན་པ་དང་ལྷའི་གཞལ་མེང་ཁང་ཐོབ་པར་འགྱུར་རོ།",
    "མ་ཕམ་པ་གལ་ཏེ་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོལས་མི་གཞན་ཞིག་ལ་འདི་སྐད་ཏུ།",
    "ཀྱེ་མི་ཁྱོདཚུར་ཤོག།",
    "དེ་དག་རྒལ་ཉེར་གནས་ངེས་མཐོང་ནས། ། ཀྱེ་མ་སོམསཅ་ན་ཉོན་མོངས་འདི་དག་ཀུན།",
    "དཀར་པོའི་ལས་རྣམས་བྱས་པ་དེ་དག་གིས།",
    "ད་དག་གི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ཤེས་སོ།",
    "དོ་ཡི་ཤ་ཡི་མིག་གི་ཡུལ།",
    "སྲིད་པའི་རྩེ་མོ་ལ་ཐུག་པ་མནཆད།",
    "ས་མསཅན་དེ་དང་དེ་དག་གི་སྐད་ལ་རྣམ་པརརྟོག་གོ་རྣམ་པར་འབྱེད་དོ།",
    "སྐྱེས་པ་བུད་མེད་དག་གི་སྒྲ་རྣམས་དང་།",
    "ཁྱེའུ་དང་བུམོའི་སྒྲ་ཡར་དེ་བཞིན་ཐོས།",
    "ཟས་ཀྱི་སྡུག་བསྔལ་དག་གིས་ཉེན་པ་ཡི།",
    "རེ་ཤག་ལྷ་ཡི་ལ་ནི་འབད་མི་བྱེད།",
    "ཨུང་པ་ལ་དད་པད་མ་དང་ཀུ་མུ་ཏ་དད་པད་མ་དཀར་པོ་རྣམས་ཀྱི་དྲི་དག་ཀྱང་ཚོར་རོ།",
    "གླང་བོཆེ་དང་རྟ་དངབ་ལང་དངར་ལུག་དང་ཕྱུགས་ཀྱི་དྲི་རྣམས་ཀྱང་ཚོར་རོ།",
    "དུད་འགྲོའི་སྐྱགནས་སུ་སོང་བའི་། སྲོག་ཆགསརྣམ་པ་མད་པོའི་ལུས་ཀྱི་དྲི་རྣམས་ཀྱང་ཚོར་རོ།",
    "དྲི་ཡང་དག་པར་ཚོར་ཏོ་དྲི་ཡང་དག་པར་ཤེས་མོད་ཀྱི།",
    "དྲི་དེ་དག་གིས་མི་འཕྲོགས།",
    "དེ་དག་གིས་མོས་པར་མི་འགྱུར་རོ།",
    "མེ་ཏོག་མན་དཱ་ར་དང་མན་དཱ་རཆེ་ན་པོ་དང་མཉྫུ་ཀ་དད་མ་ཀ་ཆེན་པོ་རྣམས་ཀྱི་ལྷའི་དྲི་རྣམས་ཀྱང་ཚོར་རོ།",
    "ལྷའི་ས་ག་རུའི་པུ་མ་དཙན་དན་གྱི་ཕྱེ་མ་དག་གི་དྲི་རྣམས་ཀྱང་ཚོར་རོ།",
    "ལྷའི་མ་ཏོག་རྣམ་པ་ཐ་དད་པ་བརྒྱ་སྟོདགི་དྲི་དག་ཀྱང་ཚོར་རོ།",
    "དེ་དག་གི་མིང་རྣམས་ཀྱངཤེས་སོ།",
    "ལྷང་བུ་མོརྣམས་དང་ལྷའི་ཆུང་མ་རྣམས་ཀྱི་ལུས་ཀྱི་དྲི་རྣམས་ཀྱང་ཆོར་རོ།",
    "ལྷ་གཞོནནུ་མ་རྣམས་ཀྱི་ལུས་ཀྱི་དྲི་རྣམས་ཀྱང་ཚེ་རེངོ།",
    "དྲི་དེ་དག་གིས་ཀྱང་མི་འཕྲོགས་ཤིང་མྱོས་པར་ཡང་མི་འགྱུར་རོ།",
    "ཚངས་པ་ཆེན་པོ་རྣམས་ཀྱི་ལུས་ཀྱི་དྲིརྣམས་ཀྱང་ཚོར་རོ།",
    "ཉན་ཐོས་དད་རད་སདས་རྒྱས་དང་བྱད་ཆུབ་སེམས་དཔའ་དང་དེ་བཞིན་གཤེགས་པ་དག་གི་སྐུའི་དྲི་རྣམས་ཀྱད་ཚོར་རོ།",
    "དེ་བཞིན་ཁྱེའུ་དང་བུ་མོ་དེ་དག་དང་།",
    "འདུག་བཞིན་དུ་ནི་ཅི་གཅར་ཤེས་ཤིང་ཚོར།",
    "བུད་མདགང་དག་སྦྲུམ་པར་གྱུར་པ་དང་།",
    "ཁྱེའུ་འམ་འོན་ཏེ་བུ་མོ་གང་ཡིན་པ།",
    "དབཞིན་སྟེང་གི་ལྷ་ཡི་མེ་ཏོག་རྣམས།",
    "མེ་ཏོག་མང་རྒྱན་ལྷ་ཡི་བུ་མོ་གང་།",
    "སྟང་དུ་སྲིད་པའི་རྩེ་མོའི་བར་གྱི་ལྷ།",
    "ལུང་ནོད་ཁ་དོན་མོས་པའི་གི་སློང་རྣམས།",
    "སྟོབས་ཀྱི་འཁོར་ལོ་སྒྱུར་བའི་རྒྱལ་པོ་དངའཁོར་ལོ་སྒྱུརབའི་རྒྱལ་པོར་ནི་པོ་ཆེ་སྣ་བརུན་དང་ལྡན་པ་བུ་དང་བཅས་པ་བློན་པོ་དང་བཅས་པ་བཙུན་མོའི་འཁོར་དང་གཡོགའཁོར་དང་བཅས་པ་ཡར་བཀུརབསྟི་བྱ་བའི་། ཕྱིར་ལྟ་འདོད་པར་འགྱུར་རོ།",
    "རེག་མ་ཐག་ཏུ་ལྷཡི་ངོ་བོར་འགྱུར།",
    "ཤ་ཟ་ཕོ་དང་ཤཟ་མོ་རྣམས་ཀྱིས།",
    "ལྷ་ཡི་བུ་མོ་མར་པོ་དྲུང་དུ་འགྲོ།",
    "ཀླུ་དང་ངུད་འགྲོའི་སྐྱེ་གནས་གརསོང་དང་།",
    "སྔོན་གྱི་འཇིག་རྟེན་དག་གི་སློབ་དཔོན་གྱིས།",
    "རྣམ་པར་དག་པ་དེ་དག་ཐོབ་མ་ཐག་ཏུ་ཕྱིར་ཡང་ལེ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་ཕྲག་ཉི་ཤུར་བདག་གི་སྲོག་གི་འདུ་བྱེད་བྱིན་གྱིས་བརླབས་ཏེ།",
    "སྔོན་ཁྱོདལ་ཁོ་བོས་བརྙས་པར་མི་བྱེདདོ།",
    "མཐར་གྱིས་བསོད་ན་མས་བྱས་པ་དེདག་གིས།",
    "བཅོམ་ལྡནའ་དས་ཀྱི་སྤྱན་སྔར་ཐལ་མེ་སྦྱར་ནས་བཅོམ་ལྡན་འདས་ལ་འདིཞིདཅེས་གསོལ་ཏོ།",
    "ཁྱོད་ཀྱིས་དེ་ལྟར་གྱིས་ཤིག།",
    "འཇིག་རྟེན་གྱི་ཁམས་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོད་དདག་ཐམསཅད་ཀྱི་སྣང་གི་ནམ་མཁའ་བར་སྣང་ལ་མ་ཏོག་གི་བླ་ར་ཆེ་ན་པོས་ཀུན་དུ་ཁེབས་པ་ར་གྱུར་ཏོ།",
    "ད་དག་གི་ནི་ཡོན་ཏན་མཐའ་ཡས་ཏེ།",
    "བླ་གོས་ཕྲག་པ་གཅྀག་ཏུ་གཟར་ནས་པུསམོ་གཡས་པའི་ལྷུ་ངས་ལ་བཙུགསཏེ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལེགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ།",
    "འཛིན་པའིརིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་བདག་གིས་བསྲུང་བ་དང་བསླབ་པ་དད་སྦབའི་སྤྲད་དུ་གཟུངས་སྔགས་ཀྱི་ཚིག་རྣམས་སྩལ་བར་བགྱིའོ།",
    "བུད་དྷ་བི་ལོ་ཀི་ཏེ།",
    "བུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་གཙུགས་ནས་བཅོམ་ལྡན་འདས་ག་ལབ་དལོགས་སུ་ཐལ་མོ་སྦར་བ་བཏུད་ད་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "སྲིན་མོ་ངོ་དག་ཐམསཅད་ཀྱིས་སྒྲ་སྐད་གཅིག་ཏུ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅས་གསོལ་ཏོ།",
    "ཐ་ན་རྨི་ལམ་ན་ཡང་བུད་མེད་ཀྱི་གཟུགས་སམ་སྐྱེས་པའི་གཟུགས་སམ་ཁྱེའུའི་གཟུགས་སམབུམོའི་གཟུགས་ཀྱིསམཐོ་འཚམ་པར་འགྱུར་། བ་དེ་ནི་གནས་མ་མཆིས་སོ།",
    "དེ་ནས་སྲིན་མོ་དེ་དག་གིས་སྐྲ་སྐད་གཅིག་ཚིག་འཁྲུན་པརབཅོ་མ་ལྡན་འདས་ལཚིགས་སུ་བཅད་པ་འདི་དག་གསོལ་ཏོ།",
    "གང་གིས་གསད་སྔགས་འདི་ཐོས་ནས།",
    "ཏལ་འཆིར་དག་གི་འགྲོ་གང་དང་།",
    "མདུད་ཅཞ་ལསོགས་པ་སྲིན་མོ་དེ་དག་གིས་བཙོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོ་མ་ལྡན་འདས་ཀྱིས་སྲི་ནམོ་དེ་དག་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེའི་བསྟན་པ་ལ་བུད་མེད་མེད་པར་གྱུར་ཏོ།",
    "ལངས་ནས་འདི་ལམ་རུ་སམ་སཏ་ནྟྲ་ལྟར་ལུས་ཡོངས་སུ་བཏང་བ་ལྟར་ན་རྫུ་འཕྲུལ་གྱི་ཆོ་འཕྲུལ་དག་གིས།",
    "ཨ་ག་རུ་དད་དུ་རུས་ཀ་དང་བོག་གི་ཁུ་བ་ཟ་ཞིང་ཙམ་པ་ཀའི་མར་ཡང་འཐུང་ངོ།",
    "བདག་གིས་བྱིན་ཀྱི་བརླབས་བྱས་ནས།",
    "དེའི་ཚེརང་གི་པ་མ་ལཆིགས་སུ་བཅད་དེ་སྨྲས་པ།",
    "ར་དགི་ཕ་མ་ལ་འདི་སྐད་ཅེས།",
    "ཡབ་ཡུམ་བཅོམ་ལྡན་འདས་གང་ལ་བདག་གིས་མཆོད་ནས།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལམོ་སྦྱར་བ་བཏུདནས།",
    "བདེགཤོགསཁྱོདལ་བདག་གིས་མཆོད་མཆོག་བགྱིས།",
    "བཅོམ་ལྡན་འ་དག་ཁྱོད་ད་དུང་བཞུགས་སམ།",
    "དེའི་ནུབ་མོ་ནམ་གྱི་ཆ་སྨད་ལ་ཕུད་པོ་ལྷག་མ་མེད་པའི་མྱ་དན་ལསའདས་པའི་དབྱིངས་སུ་ཡོངས་སུ་མ་དནལས་འདས་སོ།",
    "བདག་གིས་བཅོམ་ལྡན་འདས་ཉི་ཟླ་དྲི་མ་མེད་པའི་འོད་དཔལ།",
    "ཉན་ཐོས་ཆེན་པོ་དེ་དག་གིས།",
    "དངག་གི་སྤྱན་སྔར་བདེན་པའི་བྱིན་གྱིས་བརླབས་སོ།",
    "བདག་གི་ལག་པ་འདི་སྔོན་གྱི་བཞིན་དུ་གྱུར་ཅིག།",
    "ལག་པའི་སོར་མོ་འམ་རྐད་པའི་སོར་མོ་གཅིག་གམ་ཡནལག་གཅིག་གམ་ལག་པ་འབར་བར་བྱའོ།",
    "རིགསཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་ད་ནི་རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུ་མོ་གངགིས།",
    "དེ་ཉིད་བུད་མེད་ཀྱི་ལུས་ཀྱི་མཐའ་མར་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདུད་ཕྱིར་རྒོལ་བ་ངབ་བཅོམ་མོ།",
    "བདུད་སྡིགཅན་གྱིས་གླགས་མི་རྙེདཔ་དད་བདུད་ཀྱི་རིས་ཀྱི་ལྷ་དང་ཀླུ་དད་གནོད་སྦྱིན་དད་དྲི་ཟ་དང་གྲུལ་བུམ་རྣམས་ཀྱིས་གླགས་མི་རྙེད་པར་བྱབའི་ཕྱིར་དས་ཁྱོདལ་ཡོངས་སུགཏད་དོ།",
    "ཁྱད་ཆུབ་སེམས་དཔའ་བརྒྱད་ཁྲི་བཞི་སྟོང་གིས།",
    "རྒྱལ་མཚན་གྱི་རྩེ་མོའི་དཔུང་རྒྱན་གྱི་ཏིང་ངེ་འཛིན་ཐོབ།",
    "ཏིང་དེ་འཛིན་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོད་ཕྲག་གད་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱི་བད་དུ་ཐོབ་པར་འདུག་སྟེ།",
    "རིགས་ཀྱི་བུ་ཁྱོདའཇིག་རྟེན་གྱི་ཁམས་མི་མཇེད་དེར་སོང་སྟེ་བྱནེ་ནས།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་ཏིང་འཛིན་གཉིསདེ་ལ་སྤྱད་པར་བགྱི་འོ།",
    "བཅོམ་ལྡན་འདས་བརྡ་ལྟས་གང་གིས་བསྐུལ་མ་ཐག་ཏུ།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་ཀྱང་།",
    "ལལར་ནི་དམག་དཔོན་གྱི་གཟུགས་ཀྱིས་ལར་ནི་མཆོག་གི་གཟུགས་ཀྱིས།",
    "ལ་ལར་ནི་ཁྱིམ་བདག་གི་གཟུགས་ཀྱིས།",
    "ལ་ལང་ན་དགེ་སློང་གི་གཟུགས་ཀྱིས།",
    "ལལར་ནི་ཁྱིམ་བདག་གི་ཆུང་མའི་གཟུགས་ཀྱིས།",
    "ལ་ལང་ནི་བུ་མོའི་གཟུགས་ཀྱིས།",
    "ཁ་ཅིག་ལ་ནམ་མཁའ་ལྡིང་གི་གཟུགས་ཀྱིས།",
    "བཅོམ་འདུནལྡན་འདས་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའི་སངས་རྒྱ་ས་ནི་ཆེན་མང་གི་རིང་བསྲེལ་གྱི་མཆོད་རྟེན་ཡང་མཐོང་ཕྱག་ཀྱ་ང་བགྱིས་སོ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་བཙོ་མ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་དག་ཐམས་ཅད་སྲནམོའི་གླིང་དེ་ནས་ཐར་བར་འགྱུར་རོ།",
    "སེམསཅནཀང་དག་ཞེ་སྡང་སྤྱོད་པ་དེ་དག་གིས།",
    "སེམསཅནགངདགགཏི་མུག་སྤྱོད་པ་དེ་དག་གིས།",
    "གཟུགས་བཟང་བ་མཛེས་པ་བལྟ་ན་སྡུག་པ་འུ་མོའིམཚན་དདལྡན་པ།",
    "ཡང་གང་འགི་གྲོསེངས་སྐྱ་ས་བཅོ་མ་ལྡན་འདས་གང་གཱའི་ཀླུང་དྲུག་བཅུ་རྩ་གཉིས་ཀྱི་བྱེ་མ་སྙེདབཞུགས་ཏེ།",
    "སྦྱན་རས་གཟིགས་ཀྱི།",
    "སྤྱན་རས་གཟིགས་ཀྱི་དབད་པོ་དྲན་ན་ནི།",
    "སྤྱན་རས་གཟིགས་ཀྱི་དབད་པེ་དྲན་ན་ནི།",
    "སྤྱན་རས་གཟིགས་ཀྱི་དབད་པོ་དྲན་ན་ནི།",
    "ཐབ་མོདང་ནི་རྩོད་ཅིང་འགྱོད་པ་ཡི།",
    "འབྲུག་གི་སྒྲ་དང་ཚངས་པའི་དབྱངས་སྙན་པ།",
    "བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་གཟརནས་པུས་མོ་གཡས་པའི་ལྷ་ངས་ལ་བཙུགས་ཏེ།",
    "འཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལེགས་སུ་ཐལ་མོསྐྱར་བ་བདུད་ནས།",
    "གཅིག་གི་མིང་ནི་དྲི་མ་མེད་པའི་སྟོད་པོ།",
    "གཟི་བརྗིད་ཆེན་པོའ་ཏིང་དེ་འཛིན་གྱི་ཕ་རོལ་ཏུསོང་བར་གྱུར་ཏོ།",
    "རིགས་ཀྱི་བུ་དག་དེ་ནས་ཁྱེའུ་དྲི་མ་མད་པའི་སྙིད་པོ་དང་ཁྱེའུ་དྲི་མ་མེད་པའི་ཆུཡྀག་གིས་སོར་མོ་འཅུའི་ཐལ་མོ་སྦྱར་ནས།",
    "སོར་མོ་བཅུའི་ཐལ་མོ་སྦྱར་ཏེ།",
    "བདག་ཅག་སྐྱིད་པའི་མ་ག་ལ་བ་དེར་སོང་སྟེ།",
    "ཕྱིན་ནས་སོར་མོ་བཅུ་ཐལ་མོ་སྦྱར་ཏེ།",
    "རབ་ཏུ་འབྱུང་གིས་གཏང་དུ་གསོལ།",
    "རིགས་ཀྱི་བུ་དག་ཁྱེའུ་ང་ངག་གིས་ཚིགས་སུ་བཅད་པ་འདི་དག་སྣུས་ནས།",
    "བདག་གི་ཕ་དང་མ་ལ་འདི་སྐད་ཅེས་སྣུམ་སོ།",
    "སྲོག་ཆགས་བཞི་ཁྲི་ཉིས་སྟོར་དང་བཙུན་མོའི་འཁོརདང་བཅས་བློན་པོ་དངབཅས་ཏེཐམས་ཅང་འགྲོགསནས་ལྷན་ཅིག་ཏུ།",
    "བཅོམ་ལྡན་འདས་བདག་གི་བུ་འདི་གཉིས་སྟོན་པ་ལགས་ཏེ།",
    "བུའི་གཟུགས་ཀྱིས་བདག་གི་ཁྱིམ་དུ་སྐྱས་སོ།",
    "སོར་མོ་བཅུའི་ཐལམོ་སྦྱར་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་དགྲ་བཅོམ་པ་ཡད་དག་པར་རྫོགསཔའི་སངས་རྒྱ་ས་འབྲུག་སྒྲ་དབྱངས་སྙན་སྐར་མའི་རྒྱལ་བོ་མ་ཏོག་ཀུན་ངུ་རྒྱས་པ་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡད་དག་པར་རྫོགས་པའི་སདས་རྒྱས་གད་གི་སླད་དུ།",
    "ཡོན་ཏན་བྱེབཐའཁྲིག་བརྒྱ་སྟོང་གཞན་དག་གིས་ཀྱང་བཅོམ་ལྡན་འདས་ད་ལ་བསྟོད་དོ།",
    "མཱུ་ཏིག་གི་རྒྱན་ཕྲང་དེ་གཏོར་མ་ཐག་ཏུ་བཅོམ་ལྡན་འདས་ཀྱི་སྟེང་ན།",
    "བུད་ཆུབ་སེམས་དཔའི་རྫུ་འཕྲུལ་ཆན་པོ་དང་།",
    "བདུད་སྡིག་ཅན་དད་བདུད་ཀྱི་བུ་རྣམས་དངབདུད་ཀྱི་གོང་རིས་ཀྱི་ལྷའི་བུ་རྣམས་དད་བདུད་ཀྱི་བུ་མོ་རྣམས་དང་བདུད་ཀྱི་འཁོར་གླགས་ལྟ་བ་དང་།",
    "འཆི་བའི་ཚེ་ཡདས་དས་རྒྱས་སྟོད་གི་ཞལ་མཐོང་བར་འགྱུར་རོ།"
  ]
}