    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུའི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུའི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "གཡུང་དྲུང་གི་ཡན་ལག་དགུའི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "གཡུང་དྲུང་གི་ཡན་ལག་དགུའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
