    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་གང་དང་ཡང་བྲལ་བར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་གང་ཡང་མི་གཏོང་བར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུའི་རང་བཞིན་གང་དང་ཡང་བྲལ་བར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུའི་རང་བཞིན་གང་ཡང་མི་གཏོང་བར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "གཡུང་དྲུང་གི་བོན་ཕྱེ་བ་མེད་པ་ལ་མ་འདྲེས་པ་དགུའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "གཡུང་དྲུང་གི་ཡན་ལག་དགུའི་རང་བཞིན་གང་དང་ཡང་བྲལ་བར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "གཡུང་དྲུང་གི་ཡན་ལག་དགུའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "གཡུང་དྲུང་གི་ཡན་ལག་དགུའི་རང་བཞིན་གང་ཡང་མི་གཏོང་བར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "གཡུང་དྲུང་གི་ཡན་ལག་དགུའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "བསྲུང་དུ་མེད་པའི་དམ་ཚིག་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་གང་དང་ཡང་བྲལ་བར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "བསྲུང་དུ་མེད་པའི་དམ་ཚིག་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "བསྲུང་དུ་མེད་པའི་དམ་ཚིག་གི་རང་བཞིན་གང་ཡང་མི་གཏོང་བར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "བསྲུང་དུ་མེད་པའི་དམ་ཚིག་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "རང་བཞིན་མེད་པའི་གསུང་གི་རང་བཞིན་གང་དང་ཡང་བྲལ་བར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "རང་བཞིན་མེད་པའི་གསུང་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་མེད་པའི་གསུང་གི་རང་བཞིན་གང་ཡང་མི་གཏོང་བར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "རང་བཞིན་མེད་པའི་གསུང་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་མཚན་མ་གང་དང་ཡང་བྲལ་བས།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཡོངས་སུ་གཏང་བྲལ་མེད་ཅིང་གང་ཡང་མི་གཏོང་བས།",
    "དེ་ནས་ཀླུ་མོ་མ་མ་དེས་གསོལ་པ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་པས་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "མིག་གི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "མིག་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "མིག་གི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "མིག་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "རེག་གི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "རེག་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "རེག་གི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "རེག་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "མིག་གི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "མིག་གི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "མིག་གི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "མིག་གི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "སྣའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་ཤེས་པའི་རྐྱེན་གྱིས་ཚོར་བའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "སྐྱེ་མཆེད་དྲུག་གི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "སྐྱེ་མཆེད་དྲུག་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "སྐྱེ་མཆེད་དྲུག་གི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "སྐྱེ་མཆེད་དྲུག་གི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "རེག་པའི་རང་བཞིན་དམིགས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "རེག་པའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "རེག་པའི་རང་བཞིན་བཅོས་སུ་མ་མཆིས་པར་འཚལ་བ་ལགས་སོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "རེག་པའི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་བཅོས་ཤིང་བསླད་དུ་མེད་པའི་ཕྱིར།",
    "ཀླུ་མོ་དེ་ནི་བོན་ཐམས་ཅད་ཀྱི་རང་བཞིན་ནམ་མཁའ་ལྟ་བུ་དམིགས་པའི་ཡུལ་ལས་འདས་ཤིང་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཕྱིར།",
