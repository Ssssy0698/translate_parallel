    "འོ་ན་ལྷོ་ཁ་ནས་ཡིན་པ་དེ་གང་གི་ཤེས་ཞེ་ན།",
    "སླར་རིག་འཛིན་ཉིད་ལ་གཟིགས་སུ་ཕུལ་ཞིང་ཞལ་གྱི་སྐུ་བགད་གཏོང་ཏེ་ལེགས་འདུག་གསུངས་ནས།",
    "རིག་འཛིན་ཉིད་ལ་གཟིགས་སུ་ཕུལ་ཞེས་གཏེར་སྟོན་དེ་ཉིད་འབུམ་པར་བཞུགས་པའི་དུས་ཡིན་པ་དངོས་སུ་རྟོགས་ཐུབ།",
    "ཌཱ་ཀྐི་དབྱིངས་ཕྱུག་དཀར་མོ་ཡི།",
    "ན་མོ་གུ་རུ་བཛྲ་དྷ་ར་ཡ།",
    "མི་བརྗེད་ཞིང་གི་འདྲེན་པ་ཟས་གཙང་སྲས།",
    "ཟབ་མོ་ལྟ་རྒྱུད་སོ་ཐར་སྡོམ་རྒྱུད་དང་།",
    "དེ་ཡང་འགྲོ་བའི་འདྲེན་པ་འགྲོ་མགོན་བཀའ་བརྒྱུད་པའི་བསྟན་པ་ཉིན་མོ་ལྟར་གསལ་བ།",
    "སྔ་སོར་བཀའ་གདམས་གསར་རྙིང་གི་རིང་ལུགས་འཛིན་པ་དེང་སང་འབྲི་གུང་པར་འགྱུར་ནས་བླ་རབས་སོགས་མ་སྨོས།",
    "དེ་སྐབས་ནགས་ཤོད་འགོམ་བ་ལག་དགོན་ཞེས་འདི་ཉིད་ཤིན་ཏུ་རྒྱ་ཁྱོན་ཆེ་བས།",
    "མ་ཉམས་གྲ་རྒྱས་སྐབས་ཀྱི་རྒྱ་ཁྱོན་ཙམ་ཞིག་ཡོད་པར་གསུངས།",
    "བ་ལག་ཐང་ནས་ཁང་པའི་རྩིག་རྨང་དང་མི་བསྡད་ཤུལ་ཐལ་བ་དང་སོལ་བ་སོགས་ཐོན་པ་དངོས་སུ་མཐོང་པས།",
    "དུས་སྐབས་གང་ཞིག་གི་དུས་སུ་འགྲོ་བ་མིའི་རིགས་འཕེལ་རྒྱས་དང་ཉམས་གུད་ཕྱིན་མིན་བརྗོད་དཀའ་བར་གྱུར་པས།",
    "ནུབ་ངོས་སུ་འབུམ་པའི་སྐུ་མདུན་རྡོ་རྗེ་ཕག་མོའི་སྐོར་དང་།",
    "རྡོ་རྗེ་ཕག་མོའི་ལྷ་ཁང་གི་ཐོག་དེར་ཡིན་ཞིང་།",
    "ལུང་དཀར་ལྕོག་གུ་མདུན་བྲག་སྒོ་ཆུང་དབྱིབས་ཅན་དེ་རྒྱལ་བུ་བདེ་སྤྱོད་བཟང་པོའི་རོ་སྒྲུང་ནང་གི་བྲག་ཁུང་དེ་ཡིན་པ་དང་།",
    "རྗེ་ཕག་མོ་གྲུ་པས་མཛད་པ་ཇོ་བོ་དཀར་ཆག་ཞེས་པ་པོད་ཆུང་ཞིག་ཡོད་པ་རྒན་ཐུབ་བསྟན་བསྟན་འཛིན་ནས་མཇལ་བར་གསུངས་ཀྱང་རིག་གསར་སྐབས་མི་དམིགས་པར་གྱུར་པས་གསལ་བར་བརྗོད་མ་ནུས།",
    "ཞེས་སྨྲེ་ངག་དང་བཅས་སྤྱང་ཀི་དེ་ཤར་རེར་དབུར་སྟོད་འབྲི་གུང་དུ་ཕྱིན།",
    "དར་གོས་ལྔ་རྩེག་གི་ཞལ་ཁེབས་ཅན་བཅས་བཞུགས་པ་དང་།",
    "བྱང་ནམ་ར་དང་ནགས་ཤོད་རྒྱ་མཚོ་བར་པ་ཞང་དྲུང་གི་ས་ཆ་རྣམས་ཡོན་བདག་ཏུ་ཆོད་པས།",
    "ཡུལ་ཕུད་དུ་སྨི་ཏི་ལྷ་ཡི་ལུང་མོ་ཆེ་ཕུལ།",
    "དཔལ་ཕག་མོ་གྲུ་པ་ལ་སླེབས་པའི་བུ་སློབ།",
    "ཞེས་ཞུས་མ་ཐག་ཅུང་ཟད་ཐུགས་འུར་བའི་རྣམ་པས་སྤྱན་ནམ་མཁར་སྡང་མིག་དུ་གཟིགས་ཤིང་སྡིག་འཛུབས་དང་བཅས་པའི་ཕྱག་གིས་ཉི་མ་གཡོ་འགུལ་མེད་པར་མཛད་པས།",
    "ཐམས་ཅད་སོ་སོའི་རེ་འདོད་ལྟར་བྱ་བ་རྣམས་ཡོངས་སུ་ཟིན་ནས།",
    "ར་སའི་སྒྲོལ་མ་ལྷ་ཁང་གི་སྒོ་ལྡེབས་སུ་ཕྱག་རྗེས་དང་ཞབས་རྗེས།",
    "འབྲི་གུང་གདན་རབས་བཅུ་གསུམ་པ་བདག་པོ་ཝང་ནི་ཝང་གི་ལས་ཀ་བྱུང་།",
    "དུད་འགྲོའི་རྩོ་ཕུང་ལ་ཉི་འོད་ཕོག་ནས་ས་གཞིར་འོད་ཀྱིས་གང་བར་གཟིགས་ནས།",
    "དེ་གའི་མོད་ལ་ནགས་ཤོད་ལུང་པ་རུ།",
    "ཡི་གེའི་འདུ་བྱེད་བསྒྱུར་བ་གང་གི་ནུས།",
    "རང་རེ་ནགས་ཤོད་པ་རྣམས་ཀྱིས་ཟང་ཟིང་གི་འབུལ་བ་ནི།",
    "ལྷག་ཏུ་འདུ་ཁང་གི་གཙོ་བོ་རྡོ་རྗེ་ཕག་མོའི་ལྷ་ཁང་ཐོག་གི་གནས་མལ་དེ་ཆུ་ལོག་གིས་ཁག་གཉིས་སུ་དབྱེ་བས་ད་ལྟ་ཆུ་མགོའི་འགག་ཞེས་གྲོང་པའི་ཁང་ས་དབོར་ཡུལ་འདི་ཡིན།",
    "དགོན་གནས་འདི་ཉིད་དུ་འདུ་ཁང་ཆུང་ཆུང་གསུམ་ཡོད་པ་གཉིས་གྲྭ་ཤགཅི་གི་ནང་དང་།",
    "གཅིག་འདུ་ཁང་གི་མལ་འདིར་ཡིན་པར་ཤོད་སྲོལ་མཆིས།",
    "ལྷོ་ནས་བལྟས་ན་དུང་དཀར་མོའི་རང་སྒྲ་སྒྲོག་འདྲ།",
    "བྱང་ནས་བལྟས་ན་ནོར་བདག་གི་ནེའུ་ལེའི་ཁ་ནས་ནོར་བུ་སྐྱུག་འདྲ།",
    "ལྷོ་ཆུ་གཡུ་འབྲུག་སྔོན་མོ་སྟེ།",
    "བྱང་གི་རྫ་ཤུར་ཝ་ཝོང་བྲག་བྱང་སྲུང་རུས་སྦལ་རྒྱ་བོ་སྟེ།"
  ]
}