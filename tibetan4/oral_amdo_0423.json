    "ལྗང་གི་ཐོག་མདའ་ནག་པོ་དེ་བཏེགས།",
    "ཕུ་གསུམ་ཐམས་ཅད་ལ་ཡངས་པས་གཙང་པོའི་གཡས་གཡོན་ནས་ལུང་ལག་དཔག་བསམ་ཤིང་གི་ལོ་མ་རྒྱས་པ་ལྟར་འབྲོག་ས་བཟང་ཞིང་རྟ་ནོར་ལུག་གིས་རྩ་ཐང་གང་།",
    "ཉེ་རབས་སུ་རིག་གསར་གཡས་གཡོན་དུ་ཚོད་འཛིན་མེད་པར་ལོ་ངོ་སྟོང་ཕྲག་གི་སྔོན་ནས་བསྲུང་སྐྱོབ་བྱས་པའི་གདོད་མའི་ནགས་ཚལ་རྣམས་ལ་གཏོར་སྐྱོན་ཚབས་ཆེན་བཏང་ནས་ཤིང་ནགས་ཀྱི་ཤུལ་ཙམ་མེད་པ།",
    "ཡུལ་རེར་ཆུ་རེ་མིང་དུ་བཏགས་ཞེས་པ་དང་།",
    "སྒང་དྲུག་གི་ས་ཆ་མང་ཆེ་བ་སྔར་སུམ་པའི་རྒྱལ་ཕྲན་གྱི་མངའ་རིས་ཡིན་ཞིང་།",
    "རྒྱ་བཟའ་ཀོང་ཇོ་བོད་དུ་ཕེབས་སྐབས་ས་རོང་ཙུབ་པས་ངུ་ཤོར་བས་རྒྱ་མོ་ངུ་ཆུའམ་རྔུལ་ཆུ་ཞེས་པའི་ཤོད་སྲོལ་ཡང་ཡོད།",
    "རྫ་ཡི་རྒྱལ་པོ་གོ་བོ་ཁྱུང་ཕུག་གི་རི་རྒྱུད་ཀྱི་ཆུ་ཡིན་པས་ན་རྫ་ཆུ་ཞེས་འབོད།",
    "རྒྱ་མོ་དངུལ་ཆུ་དང་ཀོང་ཡུལ་བྲེ་སྣའི་རི་རྒྱུད་གཉིས་ཀྱི་བར་འདི་ཡིན།",
    "སྒང་གཉིས་པ་རྔུལ་རྫ་སྒང་ནི་དངུལ་ཆུ་དང་རྫ་ཆུ་གཉིས་ཀྱི་བར་དེར་གནས་པ་དེ་ལ་དངུལ་རྫ་ཟིལ་མོ་སྒང་ཞེས་འབོད།",
    "སྒང་ལྔ་པ་མེ་ཉག་རབ་སྒང་ནི་ལྷོ་བྱང་དུ་ལྡོག་པའི་རྨ་ཆུའི་ཁུག་སོ་ཆེན་མོ་ནས་རྒྱ་བོད་ས་མཚམས་བར།",
    "རི་ཚོགས་མང་ཆེ་བ་རྩེ་མོ་གངས་དཀར་གྱིས་བརྗིད་ཅིང་རི་ཞོལ་རྣམས་སུ་རྫ་བྲག་དང་ཤིང་སྤང་གིས་རྒྱན་ལ་ན་བུན་གྱིས་བཀླུབས་པ།",
    "ཁ་ཅིག་གིས་ནགས་སོག་རྒྱལ་གསུམ་ནི་བྱང་ཐང་གི་ལུང་ཚན་ཞིག་ཡིན་པར་སྨྲ་བ་ནི་ས་རྒྱུས་མེད་པའི་རང་རྟགས་ཡིན།",
    "ཚ་བ་སྒང་གི་ནུབ་ཕྱོགས་ན།",
    "བོད་ཡུལ་སྲིན་མོ་གན་རྐྱལ་དུ་ལོག་པ་ལྟ་བུའི་དཔུང་འགོ་གཡས་པ་དང་།",
    "ཆུ་བོ་རྒྱལ་མོ་དངུལ་ཆུའི་གཡས་གཡོན་གྱི་ལུང་ཚན་ཆེ་བ་ཤོད་མིང་ཐོབ་པ་རྣམས་ཡིན་ཏེ།",
    "མོ་བཙུན་སུམ་ཅུ་རྣམས་ཀྱིས་མི་རེས་འབུལ་བ་རེ་དང་ཞུ་བ་རེ་བྱས་སྐབས།",
    "ས་བབས་ཤིན་ཏུ་བཟང་བས་ཐན་སྐྱོན་དང་ཆུ་ལོག་གི་འཇིག་པ་མེད་པར་སའི་བཅུད་ཕུན་སུམ་ཚོགས་པས་ཕུ་ལ་འབྲོག་ས་བཟང་ཞིང་།",
    "རྩེ་མོ་ཐམས་ཅད་གངས་རི་དང་རྫ་རི།",
    "དེ་མིན་ཁོང་གི་ཕེབས་ཤུལ་སོགས་རླངས་ཀྱི་པོ་ཏི་སེའུ་རུ་ལས་དཔྱད་པ་བྱ་ཡུལ་མང་པོར་སྣང་བས་ཀུན་གྱི་ཐུགས་ལ་འཛིན་པར་ཞུ།",
    "བྱང་གི་ཕྱོགས་དང་དབུས་ཁམས་བཅས་ཀྱི་ས་མཚམསཡར་ཆབ་གཙང་པོ་ལྷོ་ནས་ནུབ་ཏུ་འབབ་པའི་འགོ།",
    "འབྲི་ཆུ་སྔོན་མོ་ནུབ་ནས་ཤར་དུ་འབབ་པའི་གཡས་ཕྱོགས།",
    "རྒྱལ་མོ་དངུལ་ཆུ་ནུབ་ནས་ཤར་དུ་འབབ་པའི་འགོ་མ།",
    "བོད་ཁམས་སྲིན་མོ་གན་རྐྱལ་དུ་ལོག་པའི་དཔུང་མགོ་གཡས་པ་རུ་ཕེབས་པ་ལ།",
    "ལྷ་ཆེན་ནགས་ལྷ་ནམ་མཁར་བྱོན་ནས་མདུང་རྩེ་སྟེང་དུ་བཏད་པས་སྟེང་གི་ལྷ་དམག་འདུལ།",
    "ནེ་ཁྱིམ་མཆེད་བདུན་བཙུན་མོ་བྱ་བར་ཞུས།",
    "ཆུ་ཐལ་ཁམས་པ།",
    "དམོད་པའི་སྲས་རྒོད་བཙན་པོ་བཅས་བཞི་མདུང་འཛིན་བྱ་བར་ཞུས།",
    "རྒྱབ་ཏུ་མེ་མོ་རག་ཁྲོམ་བཅས་བཞི་རུ་འདྲེན་བྱ་བར་ཞུས།",
    "ཆགས་རི་ཕུག་དཀར་སེར་དམར་སྔོ་ནག་ཕག་མོ་རིགས་ལྔའི་གནས།",
    "ཁུ་རུ་འཕྲང་ཐུབ་པ་རིགས་དྲུག་གི་གནས།",
    "ནགས་ལྷ་ཞེས་པ་དེ་ནག་ཕྱོགས་པའི་ལྷ་ཞིག་རེད།",
    "ཆུ་བོ་རྒྱལ་མོ་དངུལ་ཆུའི་འགོ་མ།",
    "དཔེར་ན་ཡུལ་ཡར་ཀླུང་གི་ལྷ་ལ་ཡར་ལྷ་དང་།",
    "ས་ཐོབ་སེམས་དཔའ་ཞིག་གི་ཐུགས་རྒྱུད།",
    "སྟོན་པས་གང་ཟག་གི་རྒྱུན་གང་ཟག་གི་མི་ལོན་པ་ཡིན་གསུངས་པས།",
    "ཡང་ཁ་གཅིག་གིས།",
    "ཀོང་བཙུན་དེ་མོ་ལ་སོགས་པ།",
    "བཞག་ཁྲ་ཕྱུག་མོ་ལ་སོགས་པ།",
    "དངོས་ཡོད་རང་གི་འགོ་དཔོན་སུ་ཡིན་དང་།",
    "བདག་ཅག་རྣམས་ལྟ་བུ་སོ་སྐྱེ་ཕལ་བ་ཞིག་གིས་འདི་དང་འདི་ཡིན་བྱ་བར་ཐག་གཅོད་ག་ལ་ཐོབ།",
    "ཁྱབ་བདག་སྟག་ཕུ་པདྨ་བཛྲ་མཆོག་གིས།",
    "པ་ཧྲོང་ཐང་གི་དགོན་ཤུལ་དང་།",
    "ཨོ་ཀེ་བྲག་ལ་མཚམས་ཁང་གི་ཤུལ་ཡོད་པས་དེ་རྣམས་གནའ་རབས་ཀྱི་མཁར་ཤུལ་རེད།",
    "ལྷ་མཁར་དུ་ཚོ་ཤོག་ནས་འབུལ་བ་གཡག་ཁམས་པ་བཅོ་བརྒྱད་ཚེ་ཐར་རམ་ནགས་ལྷར་སྤྱན་གཟིགས་སུ་ཕུལ་བས་དེ་རྣམས་དགྲ་ཇག་གཅན་གཟན་གྱི་འཚེ་བ་མེད་པར་གཞི་བདག་གིས་འཚོ་སྐྱོང་བྱ་བ་དང་།",
    "ལྷ་མཁར་འདི་གནས་མཆོག་ལྕང་ལོ་ཅན་དང་དབྱེར་མེད་པས་ཕྱིས་སུ་སྐྱེས་བུ་འགྲོ་དོན་ཅན་ཞིག་གིས་བཞེངས་པར་ལུང་བསྟན་པར་བཤད།",
    "ལྷ་རྟ་དང་ལྷ་གཡག་སོགས་སྤྱན་གཟིགས་སུ་བཙན་པ་གནང་།",
    "ལོ་གསུམ་རེའི་རྩིས་སྤྲོད་སྐབས་སུ་འགོམ་ལྡིང་དཔོན་དང་།",
    "དེ་རྗེས་ལྟ་སྨོན་གྲྭ་བསྟན་འཛིན་འཇམ་དཔལ་བཞུགས་སྐབས་རིག་གསར་ཚེས་ནས་ཚ་ལ་བརྐོ་རུ་སོང་བས།",
    "དད་ལྡན་མང་ཚོགས་ཡོངས་ཀྱི་རྒྱབ་སྐྱོར་འོག་མགོན་ཁང་ཀ་བ་བཞི།",
    "ནང་དུ་སྤྱན་རས་གཟིགས་དང་རྣམ་སྲས།",
    "ཕ་མ་དང་སློབ་དཔོན་ལ་རང་གི་སྲོག་ལྟར་བརྩེ་ཞིང་།",
    "ཕན་ཚུན་གླེང་མོལ་བྱེད་སྐབས་བརྡ་རྙིང་དང་བོད་སྔ་མའི་སྐད་བརྡ་མང་ཞིང་བརྡ་སྤྲོད་རིག་པ་དང་མཐུན་པ།",
    "དམ་པའི་སྐྱེས་བུ་མཁས་གྲུབ་མང་པོ་བྱུང་ཡང་བྱ་བྲལ་ཁེངས་སྐྱུང་གིས་རང་བསྟོད་དང་རྫུན་བྲིས་ཉུང་བ།",
    "ཕྱི་ཡི་བཙན་འཛུལ་མེད་པ་དུས་བདེ་བ་རྒན་མོ་གསེར་འཁུར་གྱི་ལུང་ཞེས་འབོད།",
    "མདུང་གི་ཚར་ལོ་དམར་པོ།",
    "བུད་མེད་རྣམས་གོས་སྣ་རིང་ཞིང་།",
    "མི་རྣམས་རང་གི་རུས་ལ་ལྷག་པར་བརྩི་ཞིང་རུས་དང་མིང་མཉམ་དུ་འབོད།",
    "དགོང་ལྟར་རེ་བཞིན་དགོང་འདོན་ཞེས་སྒྲོལ་མ་ལ་སོགས་ཆག་མེད་གསུང་།",
    "ཞེས་རྒྱ་མོ་བཟའ་དང་ཇོ་བོ་ཤཱཀྱ་མུ་རྣ་བཅས་གནས་འདི་ནས་ཕེབས།",
    "ཀོང་ཇོས་ཕྱག་གིས་རྡོ་ཕ་ཝང་ཐོག་ཡི་གེ་དྲུག་མ་བྲིས་གནང་ཤིང་།",
    "དབྱངས་སུ་དྲངས་པས་ད་ལྟ་དབྱངས་མོ་ཁུག་ཞེས་མིང་ཐོག་རང་བྱུང་ལྟ་བུའི་ཕྱག་བྲིས་ད་ལྟ་བཞུགས་ཡོད་ཀྱང་།",
    "སློབ་དཔོན་ཆེན་པོ་པདྨ་འབྱུང་གནས་མཆོག་གིས།",
    "སྤྱི་ལོའི་དུས་རབས་བཅུ་གཉིས་པའི་ནང་དུ་ཕག་མོ་གྲུ་པ་རྡོ་རྗེ་རྒྱལ་པོ་མཆོག་གིས་ནགས་ཤོད་ཤུག་ལྡིང་དགོན་ཕྱག་བཏབ་པ་ནས་བཟུང་རིམ་པར་དར་བ་དང་།",
    "དེ་ནི་ད་ལྟ་སྦྱིན་ཆེན་དང་སྦྱིན་ཆུང་གི་བར་ན་དགོན་ཆེན་ཞིག་ཉམས་པའི་ཤུལ་དང་།",
    "རྡོ་རྗེ་འཆང་དང་སྒྲོལ་མ་སོགས་ཞལ་གཟིགས།",
    "དཀར་པོ་རིན་བཟང་གིས་ཀརྨ་པ་མཐོང་བ་དོན་ལྡན་ཁམས་ལ་ཕེབས་སྐབས་ནགས་ཤོད་དུ་གདན་དྲངས་ནས་གྲིབ་གདོང་དང་།",
    "ཁོང་ནི་མཁས་པའི་སྙན་པ་འཛིན་མའི་ཁྱོན་དུ་ཁྱབ་པ་དང་།",
    "བོད་གཞུང་གི་བཀའ་ལྟར་གནམ་མཚོར་ཕེབས་ནས་མཚོའི་ཞལ་ཁ་ཕྱེ་བས།",
    "དགའ་ལྡན་ཕྱག་རྒྱ་ཆེན་མོའི་དྲིས་ལན།",
    "མོ་བ་རས་པ་བཅས་བཙུགས་པས་ད་ལྟ་སྟེང་དཀར་རས་པ་གཅིག་པུར་བསྡད་ཡོད་པས།",
    "ད་ལྟ་བོད་དུ་མཚན་སྙན་འཛམ་གླིང་ལ་སྐད་གྲགས་ཡོད་པའི་གཏམ་བརྗོད་ཟློས་གར་དགོད་བྲོའི་གཏམ་གླེང་ཞེས་པ་འདི་ལོ་རབས་ཉི་ཤུའི་སྨད་དུ་བོད་ལ་དར་བ་ཡིན་ཞེས་མིག་དམར་ལགས་དང་ཐུབ་བསྟན་ལགས་གཉིས་ཀྱིས་གཙོས་ཕྱག་ལས་གནང་གི་ཡོད།",
    "སྲིད་པའི་ཕ་མ་རྒན་ཁོག་དྲང་སྲོང་ལྷ་མོ།",
    "ནགས་ཤོད་པའི་གར་དང་སྟག་ཕུའི་ཨར་གཞས་གཙོས་པའི་དམངས་ཁྲོད་ཀྱི་ཞབས་གཞས་ཁག་གཅིག་དང་རྭ་ཁྱིམ་གྲོང་གི་བོད་ཤོག་བཟོ་སྐྲུན་ལག་རྩལ་བཅས་གཞན་དང་མཚུངས་པར་བོད་ཀྱི་སྒྱུ་རྩལ་སྲུང་སྐྱོབ་ཁང་དུ་ཚུད་པར་བྱ་དགོས།",
    "རྗེ་འབངས་ཉེར་ལྔའི་ཞལ་གཟིགས།",
    "སྙན་ངག་ར་མ་ཎིའི་གཏམ་རྒྱུད་ལས་བརྩམས་པའི་སྙན་ངག་གི་བསྟན་བཅོས་དྲི་ཟའི་བུ་མོའི་རྒྱུད་མང་གི་སྒྲ་སྤྱི་ལོ་༡༤༢༩ལོར་བརྩམས་པའི་བོད་ཀྱི་ར་མ་ཎིའི་གཏམ་རྒྱུད་བོད་རང་གི་སྐད་དུ་ཕབ་པ་དང་པོ་དེ་ཡིན།",
    "མར་ལུགས་ཕག་མོ་གསང་ཆེན་རྒྱ་མཚོ།",
    "བོད་ཁམས་སྤྱི་དང་རང་ལུང་པའི་ས་བབས་དང་ཡུལ་དུས་དང་བསྟུན་ནས་རྗེ་གོང་མ་རིམ་བྱོན་གྱིས་མི་རབས་མང་པོའི་མྱོང་བའི་ཐོག་ནས་ལོ་ལྟར་ལོ་ཐོ་བཟོས་ནས་རྒྱ་ཆེའི་མང་ཚོགས་ལ་ཕན་པ་བསྐྲུན་པ་དང་།",
    "གསུང་གིས་འགྲོ་བ་རྣམས་ལ་འགྲོ་དོན་རྒྱ་ཆེན་པོ་མཛད་པ་དང་མཛད་བཞིན་པ་ཞིག་ཡོད་ཐུབ།",
    "ཕྱི་ལྷ་ཁང་གི་བཀོད་པ་གཞན་ལས་མཚར་བས་བྱུང་བ་ཞིག་དེ་བས་མ་ཡིན།",
    "ཉེ་ཆར་རང་རེ་རྣམས་ལ་རྨོངས་དད་པ་དང་།",
    "རང་རེ་རྒྱུད་འཛིན་རྣམས་ཐོས་བསམ་སྒོམ་གསུམ་ཡ་བྲལ་སྤྱོད་པས་ལན་པ་ཡིན།",
    "དུད་ཚང་ཞིག་གམ་ཚོགས་པ་ཆེ་ཆུང་གང་འདྲ་ཞིག་ཞུགས་ཀྱང་སྔོན་རྗེས་ལ་སེམས་འཕྲལ་དང་མནོ་བསམ་མེད་པར་འདི་ཡིན་བྱ་བ་མི་སྒྲུབ་པ་དེ་རྣམས་ཡང་ན་རེ་དོག་བྲལ་བའི་བྱ་བྲལ་གྱི་འཁྲུལ་ཞིག་ཆེན་པོ་ཞིག་དང་།",
    "བོད་སིལ་བུའི་མཇུག་གི་ནགས་ཤོད།",
    "ལུང་ཆུང་རེ་ལ་ཚོ་རྒན་རེ།",
    "ནགས་སོག་ཤག་གིས་བཅས་པ།",
    "ས་ཕུད་ནགས་ཤོད་ཀྱི་ས་ཆ་སྨྲེ་ཏི་ལྷ་ཡི་ལུང་མོ་ཆེ་བཅས་ཕག་གྲུའི་གདན་སར་ཕུལ།",
    "འཁོར་འབངས་ཞིག་གིས་སོག་པོའི་གསེར་ཡིག་བརྐུས་པས་ངན་ཁག་ཁྱུང་པོ་ལ་ཕོག་ནས་ཁ་འཐོར་དུ་སོང་།",
    "ཁོང་གི་ཞལ་ཆེམས་ལྟར་གཅུང་ཨ་བླ་གདན་དྲངས་ནས།",
    "སྤུན་འབྲིང་བའི་རྒྱུད་ཁྱུང་པོ་སེར་ཚ་ནས་མི་རབས་འགའ་སོང་མཚམས་སུ་ཁྱུང་པོ་འབུམ་རྗེ་གྲགས་པའི་དུས་སུ་མ་ཡིག་གཡུ་མགོའི་ནང་གསལ་ལྟར།",
    "ཤག་གི་སྦང་ངུ་ཟམ་སོ་ན།",
    "ཡུན་དེ་ཙམ་མ་སོང་བར་ཁྱུང་པོས་ནགས་ཤོད་ལ་དོ་དམ་མ་ཐུབ།",
    "བོད་སྤུར་རྒྱལ་བཙན་པོའི་རྒྱལ་རབས་བརྒྱད་པ་གྲི་གུམ་བཙན་པོའི་སྲས་ཉ་ཁྲི་སོག་ཡུལ་དུ་ཕེབས་ནས་ཚོ་ཆུང་ཞིག་གི་དཔོན་བྱས་པ་ནི།",
    "སྲས་ཐ་ཆུང་སོག་སྐད་དུ་བོར་ཏ་ཟེ་ཞེས་པ་ཀོང་པོ་ནས་བཙུན་མོ་གཱ་མ་རལ་ཞེས་པ་བླངས་ཤིང་ཁྲིད་ནས་སོག་ཡུལ་དུ་བྱོན་ཏེ་བི་གཱ་ལ་ཞེས་པའི་ཆུ་འགྲམ་གྱི་རི་བུར་ཧནགལ་ཏུན་ཞེས་པར་འབྱོར་ནས།",
    "རྒྱལ་པོ་དཀར་པོ་འབྲི་གུང་རྒྱ་མ་ཁྲི་ཁང་ཧོར་ཁང་གི་སྲས་མི་རབས་ཐོག་མ་ཡིན་ཞེས་དང་།",
    "རྒྱལ་པོ་ནག་པོ་འཇང་ཡུལ་དུ་སོང་ནས་འཇང་གི་ས་སྒོ་གོང་མ་བླངས།",
    "རྒྱལ་རབས་ལྔ་པ་ཕག་མོ།",
