    "མཆོག་གི་དངོས་གྲུབ་སྒྲུབ་འདོད་པས།",
    "གོང་གི་དཀྱིལ་འཁོར་ལེགས་བྱས་ཏེ།",
    "བརྒྱ་འམ་སྟོང་ཕྲག་རེ་རེ་བྱ།",
    "བདག་གིས་སྒྲུབ་ཐབས་འདི་བརྩམས་པས།",
    "བསྡུར་འབྲས་རེའུ་མིགརྒྱུད།",
    "ཕྱག་དང་པོ་གཉིས་ཐུགས་ཀར་ཐལ་མོ་སྦྱར་བ།",
    "རང་གིས་ཟློས་པའི་ཚེ་དེ་ཐམས་ཅད་ཀྱིས་ཡི་གེ་དྲུག་པ་དི་རི་རི་ཟློས་པར་བསྒོམ་ཞིང་དག་པར་བཟླས་སོ།",
    "༡༡ གི་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་མཛད་པ།",
    "རེ་ཞིག་དང་པོར་ཏིང་ངེ་འཛིན་དང་རྗེས་སུ་མཐུན་པའི་ས་ཕྱོགས་སུ་ཞུགས་ནས།",
    "ཐལ་མོ་སྦྱར་ལ་སྤྱི་བོར་བཞག་ནས་ཤར་ཕྱོགས་སུ།",
    "ཨོཾ་ཨ་མྲྀ་ཏ་ཧ་ན་ཧ་ན་སརྦ་བིདྡྷཾ་ིད་ཧ་ད་ཧ།",
    "ཅེས་བྱ་བ་བརྗོད་ལ་ཐལ་མོ་སྦྱར་ནས།",
    "ཐལ་མོ་དེ་ལས་ཕྱོགས་བཅུར་འབར་བའི་རྡོ་རྗེ་འཕྲོ་བར་བསམས་ནས།",
    "ཨོཾ་ཨ་མྲྀ་ཏ་ཧ་ན་ཧ་ན་སརྦ་བིགྷཱན་ད་ཧ་ད་ཧ།",
    "ཅེས་བྱ་བ་འདི་ལན་བདུན་བརྗོད་ལ་ཐལ་མོ་ལན་གསུམ་བརྡབས་ནས་སེ་གོལ་ཡང་ལན་གསུམ་བརྡབ་པར་བྱའོ།",
    "དེའི་སྟེང་དུ་རེ་ཕ་ལས་མེ་འབར་བའི་རྣམ་པ་བསམས་ལ།་",
    "རྒྱུད། ནུ་༧༣ ཡང་སྤྱི་བོའི་ཟླ་བའི་བདུད་རྩི་འབབ་པར་བསམ་མོ།",
    "དེའི་རྗེས་ལ་རྡོ་རྗེ་ཐལ་མོ་བཅིངས་ལ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་ནམ་མཁའ་ཡོངས་སུ་གང་བར་ལྷག་པར་མོས་ལ་དེ་རྣམས་ཡིད་ཀྱིས་མཆོད་ནས་གསུམ་ལ་སྐྱབས་སུ་འགྲོ་བ་ལ་སོགས་པ་བྱའོ།་",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཕྱག་གཡས་པའི་དང་པོ་ནི་བ་དན་གསུམ་པའི་ཕྱག་རྒྱ་དེའི་རྩེ་མོ་ལ་ཅུང་ཟད་དབུ་འདུད་པའོ།",
    "གསུམ་པ་ལ་རིལ་བ་སྤྱི་བླུགས་བསྣམས་པའོ་། དེའི་གཡོན་གྱི་པདྨ་ལ་བཅོམ་ལྡན་འདས་པདྨ་སྒྲོལ་མ་ཨོ་པདྨ་ཏཱ་རི་ཧཱུྃ་ཞེས་བྱ་བ་འདིས་དེའི་རྣམ་པར་བསམ་མོ།",
    "མེའི་ཕྱོགས་སུ་ཨོ་བཛྲ་ཏཱ་རེ་ཧཱུྃ།",
    "བདེན་བྲལ་གྱི་ཕྱོགས་སུ་ཨོ་རཏྣ་ཏཱ་རེ་ཧཱུྃ།་",
    "བརྒྱད་པོ་འདི་དག་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་བཞུགས་པར་བསམ་མོ།",
    "མིའུ་ཐུང་གི་རྣམ་པ་ལ་ཞལ་རྣམ་པར་འགྱུར་བ།",
    "འོད་འབར་བའི་དབུས་སུ་གནས་པར་བསྒོམ་མོ།",
    "མེ་ཏོག་གི་སྔགས་སོ།",
    "ལངས་ལ་རང་གི་ལྷའི་ང་རྒྱལ་གྱིས་གནས་པར་བྱའོ།",
    "༢ པེ་ཏ་རེ།་",
    "དག་དུས་ག་ལ་ངག་བསྡུར་འབྲས་རེའུ་མིགརྒྱུད།",
    "ཐལ་མོ་ལན་གསུམ་བརྡབས་ལ་ཚིག་འདི་ལན་གསུམ་བརྗོད་དོ།",
    "ཚིག་གི་དོན་དང་བཅས་པར་བསམས་ནས།",
    "ཞབས་གཡོན་པ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་ལ་གཡས་པ་ཅུང་ཟད་བརྐྱང་བ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་གཡས་ན་ནོར་བཟངས་ཐལ་མོ་སྦྱར་ནས་བཞུགས་པ་དེ་ལྟར་བསམ་མོ།",
    "ཨོ་ཁྱོད་ཀྱིས་འགྲོ་བའི་དོན་ཀུན་མཛོད།",
    "མགོན་པོ་ཁྱོད་ནི་བཟོད་པ་བཞེས།",
    "ན་བསྡུར་འབྲས་རེའུ་མིག་དང་ཁེལ་ཤེས་རྒྱུད།",
    "དང་པོར་རེ་ཞིག་སྔགས་པས་གདོང་བཀྲུས་ནས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "ཁྱོདགཟུགས་ཅན་མ་ཡིན་པའམ།",
    "གཞན་གཉིས་ཀྱིས་ཐུགས་ཀར་ཐལ་མོ་སྦྱར་བའོ།",
    "གཡོན་དུ་འབྲུ་དྲུག་པའི་རིག་པ་ཆེན་མོ་ཕྱག་བཞི་པ་སྟོན་ཀའི་སྤྲིན་ལྟ་བུའོ།",
    "ས་གསུམ་བདག་གིར་གཟིགས་མཛད་པའོ།",
    "བསྡུར་འབྲས་རེའུ་མིགརྒྱུད།",
    "བསྡུར་འབྲས་རེའུ་མིགརྒྱུད།",
    "དེ་ཞབས་པདྨོ་ལ་རེག་པས།",
    "པེ་སྣར་སྤྱན་རས་གཟིགས་ཁ་སརྦ་ཎིའི་སྒྲུབ་ཐབས་བཞུགས་སོ།",
    "༧༢བསྡུར་འབྲས་རེའུ་མིགརྒྱུད།",
    "སྐྱེ་བོ་ཉོན་མོངས་སྒྲིབ་ཚོགས་སྤྲིན་གྱི་ཕུང་པོ་ཤིན་ཏུ་མཐུག་པོས་གཏུམས་གྱུར་པ།",
    "པའི་བསྡུར་འབྲས་རེའུ་མིག་སྟེ།",
    "དང་པོར་རེ་ཞིག་སྔགས་པས་ཁ་བཤལ་བ་ལ་སོགས་པ་བྱས་ཏེ།",
    "རྒྱལ་པོ་ཆེན་པོའི་འགྱིང་བག་གིས་བཞུགས་པ།",
    "ན་མོ་རཏྣ་ཏྲ་ཡཱ་ཡ།",
    "དེ་དྲོའ་བསྡུར་འབྲས་རེའུ་མིགགར།",
    "གང་གིས་ཁམས་གསུམ་འདི་དག་སེང་གེའི་སྒྲ་ཆེན་མཆོག་གིས་གསལ་བར་གང་གྱུར་པས།",
    "སྡུག་བསྔལ་ཅན་དག་བསྐྱབ་ཕྱིར་ཐུགས་རྗེའི་སྤྱན་དང་སེང་གེ་སྒྲ་ལྡན་ཁྱོད་ལ་བསྟོད།",
    "བདག་གི་ཐུབ་པ་སེང་གེ་སྒྲ་དེ་ལ་ནི་རྟག་ཏུ་ཕྱག་ལ་བགྱིའོ་།",
    "ཁྱོད་ལ་གོས་པ་མེད་ཀྱང་དེ་དག་སྤང་ཕྱིར་ཁྱེད་ཀྱིས་ནི།",
    "གཡོན་པའི་ཕྱག་གིས་རལ་གྲི་དམ་རྫས་དང་བཅས་པདྨ་བསྣམས།",
    "རྒྱལ་བའི་སྲས་པོ་ཁྱོད་ལ་རྟག་ཏུ་བདག་ཉིད་སྐྱབས་སུ་མཆི།",
    "ཇི་ལྟ་ཇི་ལྟར་དག་པའི་ཐབས་ལ་མཁས་པ་དག་གིས་མཛད་པ་རྣམས།",
    "མཁས་པ་རྣམས་ཀྱིས་གང་ལ་ཚིག་གི་གོ་སྐབས་མེད་པ་ནི།",
    "ཐོས་པ་ལ་སོགས་བྲལ་བས་ཁྱོད་ལ་མོས་དང་གུས་པ་མེད།",
    "ཐུབ་པ་སེང་གེ་སྒྲ་ཁྱོད་ལ་ནི་དེ་ཉིད་དེ་ལ་༧ སྐྱབས་སུ་མཆི།",
    "བརྩོན་འགྲུས་བརྟན་པར་རབ་བརྩམས་ཁྱོད་ལ་ཀུན་ནས་འདུད།",
    "མང་དུ་བརྗོད་པས་ཅི་ཞིག་ཁྱོད་ཀྱི་མཚན་དང་སྐུ་དག་དང་།",
    "ཇི་ལྟར་བདག་འདྲས་འཁྲུལ་ིཀྱང་གུས་བྱས་འདི་དག་བཟོད་པར་གསོལ་། འཇིག་རྟེན་གསུམ་པོའི་སྡུག་བསྔལ་འཕྲོག་བྱེད་མཆོག་གི་དགེས་བྱེད་ཅན།",
    "ཆེ་གེ་མོ་སརྦ་ཀ་ཏེ་རཀྵ་ཀུ་རུ་ཤཱནྟི་པུཊྚི་ཀུ་རུ་སྭཱ་ཧཱ།",
