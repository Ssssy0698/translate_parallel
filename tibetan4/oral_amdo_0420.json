    "སྟོབས་ཤུགས་ཡོངས་རྫོགས་བཀོལ་ནས་ཏང་གིས་རང་ལ་བཀོད་པའི་འགན་ཁུར་འགྲུབ་པར་བྱེད་ཁོང་གིས་ང་ཚོ་ལ་དེ་ལྟར་གདམས་པ་ཡིན་དགོས་པ་རེད་གསུངས།",
    "དཔེ་ཚད་ལྡན་པའི་སྒོ་ནས་གུང་ཁྲན་ཏང་ཡོན་གྱི་ལས་འགན་ལེགས་བསྒྲུབ་བྱས་པ་རེད།",
    "གལ་ཏེ་ད་ལྟ་ང་རང་བདེན་དོན་དང་སྡུག་ལན་ཆགས་མྱོང་བའི་མང་ཚོགས་རྒྱ་ཆེན་པོའི་དོན་དུ་འཆི་ནུས་ན།",
    "གསར་བརྗེའི་མེ་དཔུང་བཅིལ་བར་ནུས་སྙམ་དུ་མ་སེམས་ཤིག་དེ་ནི་བླུན་པོའི་སྟོང་པས་མ་ཙམ་རེད།",
    "དེ་ལ་མི་ཁྲི་ཕྲག་སྟོང་ཕྲག་གིས་རྒྱབ་རྟེན་བྱས་ཡོད་པས།",
    "ཅེས་ཡོངས་བསྒྲགས་བྱས་པ་རེད།",
    "མི་ཞིག་གིས་རང་ཉིད་ཀྱི་ཚེ་སྲོག་དེ་རྒྱལ་ཁབ་དང་མི་རིགས་ཀྱི་ཁེ་ཕན་དང་།",
    "དེ་འདྲའི་མི་ལ་ཅི་ནས་ཀྱང་འགན་ཁུར་གལ་ཆེན་བཅོལ་མི་རུང་བ་རེད་ཅེས་དང་།",
    "ཧོང་ཕིང་གིས་ངོ་ལོག་བྱས་པར་སུན་འབྱིན་བྱས་པའི་རྗེས་སུ།",
    "ཁོང་གིས་གུང་ཁྲན་ཏང་ཡོན་གྱིས་ངེས་པར་དུ་འབྱོར་མེད་གྲལ་རིམ་གྱི་འཇིག་རྟེན་ལྟ་ཚུལ་འཛུགས་པ་དང་།",
    "ངེས་པར་ཆབ་སྲིད་དང་གཞུང་ལུགས་སློབ་སྦྱོང་ལ་ཤུགས་སྣོན་བྱས་ནས་ཏང་ཡོན་དང་མང་ཚོགས་ཀྱི་བསམ་པ་ལ་དྲག་ཆས་སྤྲས་དགོས་པར་ནན་ཏན་མཛད་པ་རེད།",
    "ཁོང་གིས་རྒྱུན་པར་གསུང་རྒྱུར།",
    "གུང་ཁྲན་ཏང་ཡོན་གྱིས་ཏང་གི་ཁེ་ཕན་གྱི་ཚེད་དུ།",
    "ཁོང་གིས་སླར་ཡང་གསུང་རྒྱུར།",
    "ང་ཚོ་སླར་ཡང་དེའི་དུས་སོས་ཡོན་གྱི་ཕྱོགས་སོ་སོའི་མི་སྣ་དང་འཕྲད་སྐབས།",
    "ཚང་མས་རྒྱུན་ཆད་མེད་པར་ཁོང་གི་དཔའ་བོའི་སྤྱོད་སྟངས་ལ་བསྔགས་བརྗོད་བྱས་པ་དང་།",
    "ང་ཚོས་ད་གཟོད་སྐད་ཆ་དེ་དག་གི་དོན་ཡོངས་རྫོགས་ཤེས་པ་ཡིན།",
    "ང་ཚོས་ཀྱང་དུས་སྐབས་འདི་རྒྱ་ཡན་དུ་གཏོང་མི་རུང་གསུངས།",
    "ང་ཚོར་རོགས་རམ་བྱས་ནས།",
    "ང་ཚོ་མུན་ནག་ཉི་འོད་མེད་པའི་བཙོན་རར་གནས་པའི་སྐབས་སུ།",
    "དཔའ་ཞུམ་པ་དེ་བས་ཀྱང་བྱེད་མི་རུང་བ་རེད།",
    "མུན་འཐོམ་གྱིས་སྨྱོ་ལྡིང་བྱེད་མི་རུང་བ་སྨོས་མ་དགོས་པ་རེད་གསུངས།",
    "ང་ཚོར་རྒྱུན་པར་བློ་སྒོ་འབྱེད་བཞིན་ཡོད།",
    "ཁོང་གིས་གསུང་རྒྱུར།",
    "མིག་སྔར་ང་ཚོས་དགྲ་ཟླ་དང་རྣོན་པོ་གྲི་འཛིངས་དང་དཔའ་བོ་ཐོང་འཛིན་བྱེད་བཞིན་ཡོད་པ་དང་།",
    "ང་ཚོའི་ཞན་ས་ལ་ལྟ་བཞིན་ཡོད་སྟབས།",
    "ང་ཚོས་ལུས་ངག་གི་བྱ་སྤྱོད་རེ་རེས་ཀྱང་།",
    "ཐེངས་ཤིག་བཙོན་ལས་པ་ཞིག་གིས་ཁོང་ལ་ཟུར་ཟ་བྱས་ནས་འདྲི་རྒྱུར།",
    "ཁྱོད་ལ་ལྕགས་སྒྲོག་བརྒྱབ་ནས།",
    "སྡུག་ལན་ཆགས་མྱངས་པའི་མང་ཚོགས་རྒྱ་ཆེན་པོའི་ཆེད་དུ་གནོད་པ་དང་འཚེ་བ་སེལ་བ་དང་།",
    "ངོ་ཚ་ནས་གདོང་དམར་པོར་གྱུར་པ་རེད།",
    "གསར་བརྗེའི་ལས་དོན་ལ་རྒྱལ་ཁ་ལོན་པར་ཁོང་ལ་ཡིད་ཆེས་ལྡོག་ཏུ་མེད་པ་ཡོད་པ་རེད།",
    "ཁོང་གིས་བརྩོན་པ་དྲག་པོས་སློབ་སྦྱོང་དང་།",
    "འཛིངས་སྟོབས་དང་ལྡན་པ་ཞིག་བྱེད་པའི་དོན་དུ་རེད།",
    "དཀའ་ངལ་ལས་རྒྱལ་ན་གསར་བརྗེ་སྔོན་བསྐུལ་བྱེད་ཐུབ་ཀྱི་རེད།",
    "སྐུད་པ་དམར་པོས་རྒྱ་ཡིག་ཐོན་ཞེས་པའི་ཡི་གེ་ཞིག་བཟོས་པ་རེད།་",
    "ངས་བྱེད་འོས་པ་ཞིག་རེད།",
