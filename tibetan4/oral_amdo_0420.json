    "དེ་རེད་དེ་རེད་ཅེས་གཞན་པ་གཉིས་ནས་མགོ་གུག་གུག་བྱས་ནས་འཐད་པ་བསྟན་པ་རེད།",
    "ཉིན་དེའི་དགོང་མོ།",
    "མི་འགྱང་པར་བཙོན་ནས་འབུད་ཆོག་པ་རེད།",
    "དེ་ནི་ཆབ་སྲིད་ཉེས་ཅན་སོ་སོར་འབྱེད་པའི་གོ་སྐབས་ཡག་པོ་རེད་སྙམ་སྟབས།",
    "ཇ་ཁང་དུ་བྱ་སྒོང་སྦྱར་བའི་ཕྱེ་ཐུག་བྲོ་བ་ཅན་ཞིག་བསྐོལ་ནས་མལ་ཁྲིའི་མདུན་དུ་བསྐྱལ་ནས་ཁོ་ལ་ཐུག་པ་འཐུང་བར་ནན་ཏན་བྱས་པ་རེད།",
    "པས་དེ་མ་ཐག་གོ་སྐབས་དེར་བརྟེན་ནས་སྒྲོ་འདོགས་དང་གཏོར་བརླག་བྱེད་ཆོག་སྙམ་གྱིན་ཡོད་པ་རེད།",
    "དེ་ཡིན་ཡང་དགྲ་ཟླའི་གཡོ་ཐབས་དེ་ཕམ་སོང་བ་རེད།",
    "བློ་མཐུན་རུའོ་ཧྥེས་ཀྱང་གཏམ་དེ་ཐོས་ནས་དེར་སླེབས་པ་རེད།",
    "འཐབ་རྩོད་ནི་དཀའ་སྡུག་ཆེ་བ་རེད།",
    "རྒྱུན་འཁྱོངས་དང་།",
    "མ་མགལ་སོ་བཅིངས་བྱས་ན་རྒྱལ་ཁ་ངེས་པར་ལོན་པ་རེད་ཅེས་གསུངས་པས།",
    "མྱུར་མོར་ཁྱོད་ཁང་བ་གཞན་ཞིག་ལ་སྤོར་ནས།",
    "ཇ་ཁང་ནང་ནས་ཁྱོད་ལ་ཐུག་པ་གྲ་སྒྲིག་བྱེད་ཆོག་ཅེས་ཟེར་གྱིན་འདུག་བློ་མཐུན་རླིས་ཨན་ཞིན་གྱིས་མི་ངན་དེ་ལ་སྡང་མིག་ཅིག་བལྟས་ནས།",
    "འཇབ་འཇབ་ཀྱིས་ཁམས་འདྲི་ལ་ལྟ་བར་འོངས་པའི་བཙོན་མ་དཀྱུས་མ་ཇེ་མང་ལ་སོང་ཞིང་།",
    "ཉིན་ལྔ་དང་མཚན་ལྔ་ལ་བཀྲེས་ལྟོགས་ཀྱི་མནར་གཅོད་མྱངས་སྟབསཡར་འགྲེང་ཐུབ་པ་གཅིག་ཀྱང་མེད་པ་རེད།",
    "ང་ཚོས་ཨུ་ཚུགས་བྱས་ནས་གཅིག་གིས་གཅིག་ལ་བལྟས་ན་འགྲམ་པ་ཡང་མར་རྡིབ་སོང་བ་དང་།",
    "མིག་མདངས་ཅུང་སྐྱ་བོར་སོང་འདུག་ང་ཚོས་ཕན་ཚུན་མིག་བརྡ་བསྟན་ཏེ།",
    "ངེས་པར་རྒྱུན་འཁྱོངས་བྱེད་པར་བསྐུལ་སློང་བྱས་པ་ཡིན།",
    "ཉིན་རེ་བཞིན་བཙོན་མ་དཀྱུས་མ་ཚོ་ད་དུང་འཛེམ་དོགས་སྤུ་ཙམ་མེད་པར་སྐོར་སྐོར་བྱས་ནས་ཁམས་འདྲི་ལ་འོངས་པས།",
    "དགྲ་ཟླའི་ཞེད་སྣང་ལྷག་པར་ཇེ་མང་ལ་བཏང་བ་རེད།",
    "ལྷག་པར་ཞེད་སྣང་གིས་རྣལ་དུ་མི་འབབ་པར་གྱུར་པ་རེད།",
    "སྣང་ཚུལ་འདི་འདྲའི་འོག་ན་འགས་གཏོར་རང་བཞིན་ཞིག་གྲུབ་ཡོད་པ་ཁོ་རང་གིས་གཏིང་ཟབ་ཏུ་ཤེས་ཡོད་པ་རེད།",
    "ཁྱོད་རང་གིས་ཇི་ལྟར་ལན་འདེ་བས་རྩིས་ཡིན་ཞེས་དྲིས་པར།",
    "འགྲིག་པ་རེད།",
    "ང་ཚོའི་ཆ་རྐྱེན་ཡང་ཁོས་སྔ་ས་ནས་ཤེས་ཡོད།་",
    "བློ་མཐུན་ཞིག་གིས་བསམ་བཞིན་འདྲི་རྒྱུར།",
    "ང་ཚོས་ཐུག་པ་འདི་འདྲ་གང་ལ་ཟ་ཐུབ་ཀྱི་རེད་ཅེས་དང་།",
    "མ་འཐབ་ན་གང་ཡང་ཡོང་གི་མ་རེད།",
    "ཆབ་སྲིད་ཉེས་ཅན་ཚོ་ངོ་མ་བུ་རབ་མིག་ལྟོས་བྱེད་ས་རེད་ཨ་ཞེས་ཟེར།",
    "ད་རེབ་ཚང་མས་གསལ་བར་མཐོང་བ་དེ་རེད།",
    "དགྲ་ཟླ་རེ་རེ་བཞིན་རུས་པ་སྙི་མོ་རེད་ཅེས་གསུངས།་",
    "ཁོང་གི་སྐད་ཆ་དེ།",
    "ཚང་མས་ཐོས་ནས་འུར་ལངས་པ་རེད།",
    "ང་ཚོས་ཀུ་རེ་རྩེ་ནས་གད་མོ་དགོད་པར་བཟོད་བསྲན་བྱས་པ་རེད།",
    "ང་ཚོ་དང་བཙོན་མ་དཀྱུས་མ་ཚོའི་བར་ཀྱི་ཕར་འགྲོ་ཚུར་ཡོང་ལྷག་པར་ཇེ་མང་ལ་སོང་།",
    "འབྲེལ་བ་ལྷག་པར་ཇེ་དམ་ལ་སོང་བ་ཡིན།",
    "བློ་མཐུན་རུའོ་ཧྥེས་ང་ཚོའི་འཐབ་རྩོད་ལ་སྤྱི་སྡོམ་མཛད་དེ།",
    "ཁོང་གིས་གསུང་རྒྱུར།",
    "བཙོན་མ་དཀྱུས་མ་ཚོས་ང་ཚོར་རྒྱབ་སྐྱོར་བྱས་པ་ནི།",
    "ང་ཚོས་བཏོན་པའི་ཟས་ཐེབས་ཇེ་ལེགས་སུ་གཏོང་བ་དང་།",
    "ང་ཚོ་གསར་བརྗེ་མཁན་གྱིས།",
    "རྒྱུན་པར་མང་ཚོགས་ཀྱི་ཁེ་ཕན་ལ་སེམས་ཁུར་བྱེད་པ་དང་།",
    "མང་ཚོགས་དང་མཉམ་ལས་བྱེད་ཐུབ་ན་རྒྱལ་ཁ་མི་ལོན་པ་གཅིག་ཀྱང་ཡོད་པ་མ་རེད་ཅེས་གསུངས།",
    "ང་ཚོར་ཞི་ཨན་དུས་འགྱུར།",
    "ལོའི་ཟླ་པའི་ཚེས་ཉིན་གྱི་སྔ་དྲོ་ཟ་མ་ཟོས་ཚར་མོད།",
    "ང་ཚོས་ལྟ་སྲུང་པར་སྦྲན་ནས་དྲིས་ཚེ།",
    "ང་ཚོར་མི་སྤྲོད་ཐབས་མེད་བྱུང་བ་རེད།",
    "བཀྲེས་ལྟོགས་མྱངས་པ་བརྗེད་སོང་ལ།",
    "ལྕགས་སྒྲོག་བརྒྱབ་ཡོད་པ་ཡང་བརྗེད་སོང་།",
    "མི་རེ་རེའི་བཞིན་ལ་དགའ་བའི་འཛུམ་མདངས་རྒྱས་པ་བྱུང་།",
    "ཁོ་ཚོ་ཧ་ལས་ནས་ང་ཚོར་བལྟས་ཏེ་ཆབ་སྲིད་ཉེས་ཅན་དག་དགའ་སྤྲོ་ལིང་ལོང་བྱེད་དོན་ཅི་ཡིན་མ་ཤེས་པ་རེད།",
    "གསར་བརྗེའི་ལོག་སྤྱོད་ཁག་གི་འགོ་བ་ཅང་ཅེ་ཧྲི་བཟུང་འགོག་བྱས་པས།",
    "ཚུབ་ལོང་ཆེ་ཞིང་དགའ་སྤྲོ་འཕེལ་བའི་ཉིན་མོ་དེར།",
    "མང་ཚོགས་ཀྱིས་ཁོ་པ་ལ་རྡེག་མ་དགོས་པར།",
    "མཆིལ་མ་བཏབ་ན་ཡང་བསྣུབས་ནས་འཆི་རྒྱུ་རེད།",
    "མི་རྣམས་ཀྱིས་ལྟད་མོ་བལྟས་ན།་",
    "བློ་མཐུན་ཞིག་གིས་གྲོས་མགོ་འདོན་རྒྱུར།",
    "ད་དུང་ང་ཚོ་ཕྱིར་བུད་ན་ཅི་བྱེད་བསམ་གཞིག་བྱེད་དགོས།",
    "ཧུར་ཐག་གིས་འགུལ་སྐྱོད་བྱས་ནས་སྐྱོབ་ཐབས་བཙལ་བ་དང་།",
    "སྨྲེ་ངག་འདོན་བཞིན་སུང་ཙོ་ཝུན་རོགས་ལ་ཁྲིད་ནས་ཞི་ཨན་དུ་སླེབས་པ་རེད།",
    "དེའི་དུས་ང་ཚོར་རྩ་འཛུགས་ཀྱི་མཛུབ་སྟོན་ཐོབ་མི་ཐུབ་པས།",
    "གནས་ཚུལ་གྱི་འཕེལ་རྒྱས་ལ་མགོ་མཇུག་འཁྱོལ་བ་ཞིག་དཔྱད་མི་བཟོད་སྟབས།",
    "ང་ཚོར་ངོས་ཟིན་གསལ་བོ་ཐོབ་ཏུ་བཅུག་པ་ཡིན།",
    "ད་རེབ་དཀའ་ལས་བརྒྱབ་ནས་ཅང་ཅེ་ཧྲི་བཟུང་ཟིན་པས།",
    "ཀྲང་ཞོ་ལེང་གིས་ཅང་ཅེ་ཧྲི་ནན་ཅིན་ལ་སླར་བསྐྱལ་བ་ཞེས་འཁོད་ཡོད་པ་མཐོང་བས།",
    "ཅང་ཅེ་ཧྲི་དེ་ཤ་དུམ་བུ་དང་ཁྲག་དུམ་བུ་མི་བྱེད་དོན་ཅི་རེད།",
    "ཁོ་པ་གཏོང་དོན་ཅི་རེད་ཅེས་དང་།",
    "ཅང་ཅེ་ཧྲིའི་ཉེས་སྤྱོད་དེ་ཡང་མཇུག་རྫོགས་པའི་དུས་ལ་སླེབས་ཆོག་ཀྱི་རེད་དང་།",
    "ད་དུང་ཁོ་པར་རྒྱལ་ཁབ་ལ་གཙེས་ཤིང་མི་དམངས་ལ་གནོད་པ་བྱེད་དུ་བཅུག་ནས་ནམ་ཞིག་ལ་ཚར་རྒྱུ་རེད་ཅེས་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་དྲི་བ་དེ་དག་གིས།",
    "ཅང་ཅེ་ཧྲི་བཏང་བ་ལ་དོགས་པ་སྐྱེས་ཡོད་པར་བསྟན་པ་རེད།",
    "བློ་མཐུན་རུའོ་ཧྥེས་ཡུན་རིང་ལ་བསམ་བློ་ཟབ་མོ་བཏང་ནས།"
  ]
}