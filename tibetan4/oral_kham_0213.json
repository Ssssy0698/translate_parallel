    "ཉམ་ཆུང་བའི་འགྲོ་བ་བདག་ཉིད་ཀྱིས་བཟོད་པའི་སྐབས་ཅུང་ཟད་ཀྱང་མི་གདའ་བས།",
    "གནང་དངོས་གཞི་འབུལ་བར་བྱེད་པ་ལ་ནུས་པ་དང་ལྡན་པར་བྱ་བའི་ཕྱིར་ཐོག་མར་ཁྱེད་རང་རྣམས་ལྷར་བསྐྱེད་པར་བྱེད་པ་ཡིན་པས་ཁོ་བོའི་ཆོ་གའི་ཚིག་འགྲོས་དང་མཐུན་པར་སྤྱན་དམིགས་གསལ་ལམ་གྱིས་འདེབས་པར་མཛོད།",
    "སྒྲུབ་པ་པོ་སྟག་ལྤགས་ཀྱི་སྟན་ལ་འདུག་ནས་གསེར་སྐྱེམས་ལག་ཏུ་ཐོགས་ནས་དབྱངས་དང་བཅས་པས།",
    "འཇིག་དུས་བསྐལ་པའི་འོད་ཀྱི་གཟི་མངའ་ཞིང་།",
    "རང་ཁ་རི་རབ་ལ་ཕྱོགས་ནས་འདུག་པར་བསྒོམས་དེའི་སྟེང་དུ་འཐབ་བྲལ་དང་སུམ་ཅུ་རྩ་གསུམ་གཉིས་བསྒོམས།",
    "དེའི་ནང་ནས་ཀྱང་རང་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་ལམ་རིམ་གཉིས་ཀྱི་ཁྲིད་ཡིག་བསྡུས་སྐུ་གསུམ་ཐེམ་སྐས་ཞེས་བྱ་བ།",
    "དེར་སྒྲུབ་པ་པོ་རང་ཉིད་ཇི་ལྟར་འདུག་ཚུལ་ཡང་།",
    "སྐྲ་སིལ་ཞིང་ཁ་ལྷོར་བལྟས་ལ་འདུག་ཅིང་།",
    "དེའང་རང་ཉིད་འཇིགས་བྱེད་ཞལ་གཅིག་ཕྱག་གཉིས་པར་གསལ་བའི་ཞེས་པ་ནས།",
    "དེ་ལྟར་རགས་པ་དྲན་པ་གཅིག་པའི་རྣལ་འབྱོར་དང་ཕྲ་བ་རྟོག་པའི་རྣལ་འབྱོར་གང་ལ་སློབ་ཀྱང་རང་ཐ་མལ་གྱི་སྣང་ཞེན་ཅུང་ཟད་ཀྱང་མེད་པར་འབྲས་དུས་ཀྱི་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཆེན་པོ་དེ་ངའོ་སྙམ་པའི་ང་རྒྱལ་བཟུང་པཎ་ཆེན་སྐུ་ཕྲེང་རིམ་བྱོན་གྱི་གསུང་འབུམ།",
    "དེ་ཡང་རང་དང་རྟོགས་པ་མཉམ་པ་ཞིག་དགོས་སོ།",
    "བ་ལ་སོགས་པ་མིག་ལ་གནོད་པའི་རྐྱེན་དང་བྲལ་ཞིང་འོད་ཀྱི་ཁྱད་པར་ཁབ་རྩེ་ཙམ་ཡང་མི་འཕྲོ་བའི་མུན་ཁང་དུ་ལུས་ཀྱི་བྱེད་བཅིང་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་བརླ་གཉིས་མནན་སྒལ་ཚིགས་དྲང་པོར་བསྲངས་པའི་འདུག་སྟངས་སམ།",
    "ཡང་རངཉིད་དུས་ཀྱི་འཁོར་ལོ་རྩ་གསུམ་འཁོར་ལོ་དྲུག་དང་བཅས་པར་གསལ་བའི་ངང་ནས་སྟོང་གཟུགས་ཀྱི་སྐུ་དེ་རྡོ་རྗེའི་བཟླས་པས་ལྟེ་བར་དྲངས་ཏེ།",
    "ཡང་དུས་དེ་རིང་ས་ཆ་འདི་ལ་དྲི་ཞིམ་པོ་ཞིག་ཨེ་འདུག།",
    "ཆོ་འཕྲུལ་གྱི་བཀོད་པ་འདུག་ཅེས་ཕེབས་ཏེ།",
    "ལན་ཅིག་ཕྱི་དྲོའི་དུས་སུ་ཏིང་ཏིང་ཟེར་བ་ཞིག་འདུག་ཕེབས་པར།",
    "ཆགས་ཡུལ་གྱི་དོན་དང་འཕྲོད་པ་འདུ་བ་དང་ལ་སོགས་པས་སྐྱེས་བུ་དང་རང་བཞིན་གཅིག་ཏུ་བཟུང་བ་མེད་ན་ཡང་རང་དང་ཕན་གདགས་བྱ་འདོགས་བྱེད་ཉིད་དུ་ནི་བཟུང་བའི་ལོངས་སྤྱོད་ཀྱི་ཡན་ལག་ཕྱི་རོལ་གྱི་དོན་ཀུན་ལ་ཡོད་པའི་ཕྱིར་རོ།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རང་རང་མཚན་ཉིད་ཀྱིས་གནོད་ཕྱིར།",
    "དེ་ཡང་རང་རིག་ཡིན་པས་ན།",
    "རང་ཉིད་གཞན་སྐད་ལ་འཁོས་ཀ་དམན་ཞིང་རང་སྐད་ལ་བྱང་ཆ་མེད་པའི་གནས་བབ་སྡུག་པོ་ལ་ངོ་གནོང་བྱུང་བ་དང་སྦྲགས།",
    "དེང་རབས་ཅན་གྱི་ལག་ཆ་སྤྱད་ནས་རང་མཁོ་རང་སྒྲུབ་བྱའོ་ཞེས་ཞུ།",
    "ཡིན་ནའང་སང་ཉིན་ང་རང་འཆི་ལམ་སྙེག་དགོས་ཤིང་།",
    "ང་རང་སྲོག་ཆགས་ལ་ཤིན་ཏུ་དགའ་པོ་ཡོད་པ་དང་ཕ་མ་གཉིས་ཀྱིས་ཀྱང་བག་མེད་ལང་ཤོར་དུ་བཏང་ནས་ང་ལ་སྲོག་ཆགས་ཆུང་ངུའི་རིགས་རྣམ་པ་སྣ་ཚོགས་སྟེར་མྱོང་།",
    "ང་རང་ལོ་གཞོན་པའི་དུས་ནས་ཆང་ས་བརྒྱབ་ཅིང་ཆུང་མའང་ང་རང་ཉིད་ཀྱི་ཁམས་དང་ཤིན་ཏུ་མཐུན་པ་ཞིག་རྙེད་པས་དགའ་པོ་བྱུང་།",
    "ཐ་ན་ང་རང་སྲང་ལམ་ལ་འགྲོ་དུས་ཀྱང་དེས་རྗེས་འབྲངས་ཡོང་ནས་འགོག་ཁག་པོ་ཆགས་ཡོད།",
    "བྱི་ལ་དེས་ང་ལ་གཡོལ་གྱི་འདུག་སྙམ་པའི་འཁྲུལ་སྣང་ཞིག་བྱུང་བ་དང་ཧོབ་ཀྱིས་བསྙབས་ནས་བཟུང་།",
    "ང་རང་ལྡོག་ཐབས་ཅི་ཡང་མེད་པའི་མཐའ་མའི་ཉེས་སྤྱོད་ཀྱི་ཕྱོགས་སུ་ཁྲིད།",
    "ཁང་པ་ཧྲིལ་པོ་མེ་རུ་འབར་བཞིན་འདུག་ངའི་ཆུང་མ་དང་གཡོག་པོ་ཞིག་བཅས་ངེད་གསུམ་མེ་བོ་ཆེའི་ཀློང་ནས་ཕྱི་ལ་ཐར་དཀའ་ཙམ་བྱུང་།",
    "ཁོས་དེ་ལྟར་བྱེད་དོན་ནི་ཧ་ལམ་ང་རང་གཉིད་ལས་སློང་སྙམ་པ་ཡིན་སྲིད།",
    "ང་རང་ཉིད་ལ་མཚོན་ན་མི་འགྱང་བར་བྱི་ལ་དེ་ལ་མི་དགའ་བར་གྱུར།",
    "དེ་ནི་ངའི་ཚོད་དཔག་དང་ཕྱིན་ཅི་ལོག་པར་འདུག་ཅིང་།",
    "ང་རང་བྱི་ལ་དེ་ལ་གཡོལ་གང་ཐུབ་བྱས།",
    "ང་རང་དུད་འགྲོ་དེར་སྡང་སེམས་སྐྱེ་ས་གཞན་ཞིག་ཡོད་པ་ནི།",
    "ང་རང་ཡར་ལངས་ནས་གོམ་པ་རྒྱག་པའི་ཚེ་དེ་ངའི་རྐང་པའི་བར་ལ་འཛུལ་ཡོང་སྟེ་ང་རང་ཐོགས་ནས་ས་རུ་བསྒྱེལ་ལ་ཁད་བྱེད།",
    "ངའི་ཆུང་མས་ཐེངས་གཅིག་མིན་གཉིས་མིན་དུ་ང་རང་དེའི་སྤུ་ཁ་དཀར་ཐིག་ཅན་གྱི་རྟགས་དེ་ལ་ཞིབ་ལྟ་བྱེད་པར་བསྐུལ།",
    "ད་ནི་ང་རང་ཉིད་ཀྱིས་ཀྱང་རང་ཉིད་བག་མེད་དམུས་ལོང་དུ་དོར་བ་ཡིན།",
    "ལས་ཀ་གྲུབ་ནས་ཐམས་ཅད་ལམ་ལྷོང་བྱུང་བ་དང་ང་རང་གཞི་ནས་ཡིད་ཚིམ་པ་ཞིག་བྱུང་།",
    "དེ་ལྟར་ན་དེ་བས་ཀྱང་ང་རང་ཉེས་མེད་ཡིན་པར་ཁོ་ཚོ་ལྡབ་འགྱུར་གྱིས་ཡིད་ཆེས་འཕེར་དུ་འཇུག་ཐུབ་སྙམ།",
    "སྐྱི་གཡའ་བར་བྱེད་པའི་དུད་འགྲོ་དེ་བསྡད་འདུག་དེ་ཡི་བསླུ་བྲིད་ཀྱི་རྐྱེན་གྱིས་ང་ཡིས་མི་གསོད་ཁྲག་སྦྱོར་གྱི་ནག་ཉེས་བརྩམས་ཤིང་།",
    "དེན་ང་རང་འཚབ་འཚུབ་ཆེ་འཚབ་འཚུབ་ཧ་ཅང་ཧ་ཅང་ཆེ་བ་འཇིགས་སུ་རུང་བ་ཞིག་ཡིན།",
    "ང་རང་རྒད་པོ་ཞིག་ལ་དགའ།",
    "ད་ནི་རྒད་པོ་དེ་ཁོའི་མལ་ཁྲིའི་སྒང་དུ་ཉལ་འདུག་པ་མཐོང་བྱུང་།",
