    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ནི་འཁྲུག་པ་མེད་པའི་མཚན་ཉིད།",
    "རྣམ་པར་ཐར་། པའི་སྒོ་མཚན་མ་མེད་པ་ནི་ཞི་བའི་མཚན་ཉིད།",
    "རྣམ་པར་གྲོལ་བ་ནི་རྣམ་པར་འགྲེལ་བའི་མཚན་ཉིད།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ནི་མི་ཆོད་པའི་མཚན་ཉིད།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ནི་མངོན་སུམ་གྱི་མཚན་ཉིད་དེ།",
    "དངོས་པོ་མེད་པ་ཞེས་བྱ་བ་ནི་འདུས་མ་བྱས་ཏེ།",
    "འདུས་མ་བྱས་དེའང་འདུས་མ་བྱས་ཀྱིས་སྟོང་པས།",
    "དེ་ལ་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ནི་ཤེས་པས་མ་བྱས།",
    "མཐོང་བས་མ་བྱས་ཏེ།",
    "སེང་གེ་རྣམ་པར་རྩེ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "སྤྱི་གཙུག་རྣམ་པར་ལྟ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "དཔུང་རྣམ་པར་བཀོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཡང་དག་པར་འཕགས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཚིག་བླ་དྭགས་ལ་ཡང་དག་པར་འཇུག་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཕྱོགས་རྣམ་པར་ལྟ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ནམ་མཁའ་རྒྱས་པར་འགེངས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "སེང་གེ་རྣམ་པར་བསྒྱིངས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "སེང་གེ་རྣམ་པར་སྐྱོང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "སེང་གེ་རྣམ་པར་གླལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "རྣམ་པར་འཐོར་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "རྣམ་པར་ངེས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "དྲི་མ་མེད་པར་སྤྱོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཡི་གེ་མཉམ་པར་འགོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་ཡི་གེ་དང་བྲལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "མིང་ངེས་པར་འཇུག་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "གནས་མེད་པར་སྤྱོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "སེམས་མེད་པར་གནས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ངེས་པར་གནས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ནེམ་ནུར་རྣམ་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཡང་དག་པ་དང་ལོག་པ་ཐམས་ཅད་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "འགལ་བ་དང་འགོག་པ་ཐམས་ཅད་ཡང་དག་པར་ཞི་བར་བྱེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཟླ་བ་དྲི་མ་མེད་པར་རྒྱས་པའི་འོད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "སྒོ་རྣམ་པར་འབྱེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ལུས་ཀྱི་སྐྱོན་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ཡིད་ཀྱི་སྐྱོན་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ནམ་མཁའ་ལྟར་ཆགས་པ་མེད་པས་རྣམ་པར་གྲོལ་ཞིང་གོས་པ་མེད་པ་ཞེས་བྱ་བའི་། ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་སེང་གེ་རྣམ་པར་རྩེ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་རྣམ་པར་རྩེ་བ་སྟེ།",
    "འདི་ནི་སེང་གེ་རྣམ་པར་རྩེ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་སྤྱི་གཙུག་རྣམ་པར་ལྟ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་སྤྱི་གཙུག་རྣམ་པར་ལྟ་བ་སྟེ།",
    "འདི་ནི་སྤྱི་གཙུག་རྣམ་པར་ལྟ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ནོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་རྒྱལ་མཚན་ངེས་པར་འཛིན་པ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་འཇིག་པར་མི་འགྱུར་བ་སྟེ།",
    "སྙོམས་པར་འཇུག་པ་ཐམས་ཅད་ཀྱི་སྤྱོད་ཡུལ་དང་།",
    "སྤྱོད་པ་ཐམས་ཅད་རྗེས་སུ་དྲན་ཞིང་ཉམས་པར་མི་བྱེད་པ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་བརྩོན་པའི་མཐུ་བསྐྱེད་པར་བྱེད་པ་སྟེ།",
    "དེ་ལ་དཔུང་རྣམ་པར་བཀོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་སྟོབས་རྣམ་པར་བཀོད་པ་སྟེ།",
    "འདི་ནི་དཔུང་རྣམ་པར་བཀོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ཡང་དག་པར་འཕགས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཡང་དག་པར་འཕགས་པར་འགྱུར་བ་སྟེ།",
    "འདི་ནི་ཡང་དག་པར་འཕགས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ཚིག་བླ་དྭགས་ལ་ཡང་དག་པར་འཇུག་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་ཚིག་བླ་དགས་ལ་ཡང་དག་པར་འཇུག་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ཕྱོགས་རྣམ་པར་ལྟ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་ཕྱོགས་རྣམ་པར་ལྟ་བ་སྟེ།",
    "འདི་ནི་ཕྱོགས་རྣམ་པར་ལྟ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཉམས་པར་མི་འགྱུར་བ་སྟེ་འདི་ནི་ཉམས་པ་མེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དོན་ཐམས་ཅད་ངེས་པར་བསྒྲུབ་པ་ལ་ཇི་ལྟར་རྒྱལ་པོའི་ཕྱག་རྒྱས་འདོད་པ་ཐམས་ཅད་འགྲུབ་པར་བྱེད་པ་ལྟ་བུ་སྟེ་ཏོ།",
    "དེ་ལ་ནམ་མཁའ་རྒྱས་པར་འགེངས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱིས་ནམ་མཁའ་རྒྱས་པར་འགེངས་པ་སྟེ།",
    "འདི་ནི་ནམ་མཁའ་རྒྱས་པར་འགེངས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "རྒྱུན་གྱི་རྗེས་སུ་མ་ལོག་པར་ཡང་དག་པར་ཞུགས་པ་སྟེ།",
    "དེ་ལ་སེང་གེ་རྣམ་པར་བསྒྱིངས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན་ཏིང་ངེ་འཛིན་དེ་ལ་གནས་ཤིང་།",
    "འདི་ནི་སེང་གེ་རྣམ་པར་བསྒྱིངས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་སེང་གེ་རྣམ་པར་སྐྱོང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་སེང་གེ་རྣམ་པར་སྐྱོང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་སེང་གེ་རྣམ་པར་གླལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་སེང་གེ་རྣམ་པར་གླལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་རྣམ་པར་སྣང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་རྣམ་པར་སྣང་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་སྒྲོན་མ་དྲི་མ་མེད་པར་བྱེད་པ་སྟེ།",
    "འོད་མཐའ་ཡས་པར་བྱེད་པ་སྟེ་འདི་ནི་འོད་མཐའ་ཡས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ཟད་མི་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཟད་མི་ཤེས་པར་རྗེས་སུ་མཐོང་ནས།",
    "རྡུལ་ཙམ་ཡང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་དེ་ལྟར་འདི་ནི་ཟད་པ་དང་བྲལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "མཉམ་པར་བཞག་པ་རྣམས་རབ་ཏུ་ཞི་བར་འགྱུར་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་འཇིག་པར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་མུན་པ་མེད་པར་བྱེད་པ་སྟེ།",
    "མིག་ལྔ་ཡོངས་སུ་དག་པར་བྱེད་པ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་རབ་ཏུ་འཐོབ་པ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་ཡེ་ཤེས་དཔལ་ཡང་དག་པར་རྗེས་སུ་མཐོང་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་ཏིང་ངེ་འཛིན་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བར་ཁོང་དུ་ཆུད་པར་བྱེད་པ་སྟེ།",
    "སེམས་མི་གཡོ་རྣམ་པར་མི་གཡོ་རྣམ་པར་མི་ལྡོག་ཡོངས་སུ་ཡི་ཆད་པར་མི་འགྱུར།",
    "ཐམས་ཅད་སྣང་བར་ཡང་དག་པར་རྗེས་སུ་མཐོང་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་དེ་ལ་གནས་ཤིང་ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་རབ་ཏུ་གནས་པར་འགྱུར་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཕྱག་རྒྱ་མེད་པའི་མཐས་ཕྱག་རྒྱས་བཏབ་པ་ཉེ་བར་བཟུང་བས་ཕྱག་རྒྱས་བཏབ་པར་འགྱུར་བ་སྟེ།",
    "དེ་ལ་རྣམ་པར་འཐོར་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན་ཏིང་ངེ་འཛིན་དེ་ལ་གནས་ཤིང་།",
    "འདི་ནི་རྣམ་པར་འཐོར་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་རྣམ་པར་ངེས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་རྣམ་པར་ངེས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་དྲི་མ་མེད་པར་སྤྱོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་སྤྱོད་པ་མཐའ་ཡས་པ་རྣམ་པར་དག་པར་བསྐྱེད་པ་སྟེ།",
    "འདི་ནི་དྲི་མ་མེད་པར་སྤྱོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ཡི་གེ་མཉམ་པར་འགོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་ཡི་གེ་མཉམ་པ་ཉིད་རབ་ཏུ་འཐོབ་པ་སྟེ་འདི་ནི་ཡི་གེ་མཉམ་པར་འགོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་དམིགས་པ་ཆད་པར་འགྱུར་བ་སྟེ།",
    "དེ་ལ་མིང་ངེས་པར་འཇུག་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་མིང་ངེས་པར་འཇུག་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་གནས་མེད་པར་སྤྱོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་གནས་མེད་པར་སྤྱོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་སྤྱོད་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་གཡོ་བ་མེད་པར་ཡང་དག་པར་རྗེས་སུ་མཐོང་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་ཡུལ་ལས་ཡང་དག་པར་འདའ་བ་སྟེ།",
    "དེ་ལ་སེམས་མེད་པར་གནས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་སེམས་མེད་པར་གནས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ངེས་པར་གནས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ལ་སེམས་ངེས་པར་གནས་ཀྱང་།",
    "དེའི་མཚན་ཉིད་དམིགས་སུ་མེད་པར་རྟོགས་པ་སྟེ།",
    "འདི་ནི་ངེས་པར་གནས་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ནེམ་ནུར་རྣམ་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་ནེམ་ནུར་རྣམ་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་གཅིག་ཏུ་རྣམ་པར་བཀོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་གཅིག་ཏུ་རྣམ་པར་བཀོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་རྣམ་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་གཉིས་སུ་མེད་པར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་དེ་ལ་གནས་ཤིང་སྙོམས་པར་འཇུག་པ་དེ་ལས་སྤྱོད་པ་དམ་པ་སྣ་ཚོགས་སྟོན་ཀྱང་གང་ལ་ཡང་འཛིན་པ་མེད་པ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་རྟོགས་པར་བྱེད་པའི་ཡེ་ཤེས་ལ་ཞུགས་ནས།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་མཚན་ཉིད་ཡོངས་སུ་དག་པར་འགྱུར་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་དེ་ལ་གནས་ཤིང་ཏིང་ངེ་འཛིན་ཐམས་ཅད་རྣམ་པའི་མཆོག་ཐམས་ཅད་དང་ལྡན་པར་འགྱུར་པ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་བདེ་བ་དང་སྡུག་བསྔལ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་སྟེ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཟད་པར་རུང་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་སྟེ།",
    "དེ་ལ་ཡང་དག་པ་དང་ལོག་པ་ཐམས་ཅད་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ལོག་པར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་སྟེ།",
    "ལོག་པ་ཐམས་ཅད་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་འགལ་བ་དང་འགོག་པ་ཐམས་ཅད་ཡང་དག་པར་ཞི་བར་བྱེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་འགལ་བ་དང་འགོག་པ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་སྟེ།",
    "འདི་ནི་འགལ་བ་དང་འགོག་པ་ཐམས་ཅད་ཡང་དག་པར་ཞི་བར་བྱེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་མཐུན་པ་དང་འགལ་བ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་སྟེ།",
    "དེ་ལ་ཟླ་བ་དྲི་མ་མེད་པར་རྒྱས་པའི་འོད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "དཔེར་ན་ཟླ་བ་ཉ་བའི་དཀྱིལ་འཁོར་ལྟར་ཡོངས་སུ་རྒྱས་པར་འགྱུར་བ་སྟེ།",
    "འདི་ནི་ཟླ་བ་དྲི་མ་མེད་པར་རྒྱས་པའི་འོད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་རྒྱན་ཆེན་པོ་དང་ལྡན་པར་འགྱུར་པ་སྟེ།",
    "མཉམ་པར་བཞག་པའི་མཐུས་ཡོན་ཏན་མང་པོ་བསྐྱེད་དེ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་མྱུར་དུ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་སྟེ།",
    "དེ་ལ་སྒོ་རྣམ་པར་འབྱེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་སྒོ་རྣམ་པར་འབྱེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ལུས་ཀྱི་སྐྱོན་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་ལུས་ཀྱི་སྐྱོན་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ཡིད་ཀྱི་སྐྱོན་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་ཡིད་ཀྱི་སྐྱོན་ཡང་དག་པར་སེལ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "དེ་ལ་ནམ་མཁའ་ལྟར་ཆགས་པ་མེད་པས་རྣམ་པར་གྲོལ་ཞིང་གོས་པ་མེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་ནམ་མཁའ་ལྟར་ཆགས་པ་མེད་པས་རྣམ་པར་གྲོལ་ཞིང་གོས་པ་མེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་རྣམ་པར་སྤྱོད་ཀྱང་ལུས་དང་ལྡན་པའི་རྣམ་པར་རྟོག་པ་རྣམས་ལ་རྣམ་པར་མི་རྟོག་གོ་ཕྱིའི་ལུས་ལ་དེ་མི་དམིགས་པའི་ཚུལ་གྱིས་ལུས་ཀྱི་རྗེས་སུ་ལྟ་ཞིང་།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་།",
    "ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་རྣམ་པར་སྤྱོད་ཀྱང་།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་རྣམ་པར་སྤྱོད་ཀྱང་།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་།",
    "རྣམ་པར་སྤྱོད་ཀྱང་སེམས་དང་ལྡན་པའི་རྣམ་པར་རྟོག་པ་རྣམས་ལ་རྣམ་པར་མི་རྟོག་གོ་ཕྱིའི་སེམས་ལ་དེ་མི་དམིགས་པའི་ཚུལ་གྱིས་སེམས་ཀྱི་རྗེས་སུ་ལྟ་། ཞིང་།",
    "དྲན་པ་དང་ལྡན་པས་འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་རྣམ་པར་སྤྱོད་ཀྱང་།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་།",
    "དྲན་པ་དང་འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་རྣམ་པར་སྤྱོད་ཀྱང་།",
    "རྣམ་པར་སྤྱོད་པ་ཡིན་ཞེ་ན།",
    "དེ་ལྟ་དེ་ལྟར་ངེས་པར་རབ་ཏུ་ཤེས་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་རྣམ་པར་སྤྱོད་དོ།",
    "ལྟ་འམ་རྣམ་པར་ལྟའང་ཤེས་བཞིན་དུ་སྤྱོད་པ་ཡིན།",
    "ནང་དུ་ཡང་དག་པར་འཇོག་པ་ལའང་ཤེས་བཞིན་དུ་སྤྱོད་པ་ཡིན་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་རྣམ་པར་སྤྱོད་དོ།",
    "དྲན་པར་དབུགས་ནང་དུ་བརྒྱུས་སོ་ཞེས་བྱ་བར་རབ་ཏུ་ཤེས་སོ།",
    "དྲན་པར་དབུགས་ཕྱིར་བརྒྱུས་ནའང་།",
    "དྲན་པར་དབུགས་ཕྱིར་བརྒྱུས་སོ་ཞེས་བྱ་བར་རབ་ཏུ་ཤེས་སོ།",
    "འཇིག་རྟེན་གྱི་ཆགས་སེམས་དང་ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་རྣམ་པར་སྤྱོད་དོ།",
    "བ་ལང་བསད་ཅིང་བག་བཞིར་གཤགས་ཏེ།",
    "ཡིད་མི་བདེ་བ་རྣམ་པར་བསལ་ཅིང་རྣམ་པར་སྤྱོད་དོ།",
