    "རྒྱུ་ནོར་གཞུང་བཞེས།",
    "ཡིན་ནའང་ལས་འཛོལ་གྱི་བྱས་ཉེས་ཤོར་རིགས་དེའི་ཁོངས་སུ་མི་གཏོགས།",
    "ཐེར་འདོན་བྱས་ཡོད་པ་དེ་ཞིབ་བཤེར་གྱིས་འཛོལ་མེད་ར་འཕྲོད་བྱུང་བའམ་ཡང་ན་ཁུངས་སྣེ་གལ་ཆེན་པོ་འདོན་སྤྲོད་བྱས་ཡོད་པ་དེ་ལ་བརྟེན་ནས་གྱོད་དོན་གཞན་དག་མྱུལ་ཞིབ་བྱས་ཏེ་རྩད་ཆོད་བྱུང་བ་སོགས་ཀྱི་བྱས་རྗེས་བཞག་པའི་བྱ་སྤྱོད་ཡོད་ན།",
    "གཏན་ཁེལ་བྱས་པའི་ཉིན་ནས་བརྩི་རྒྱུ།",
    "གཅིག་མི་གཞན་གྱིས་བྱས་ཉེས་ཚབས་ཆེན་གསོག་པར་བཀག་འགོག་བྱས་པ་དང་།",
    "གསར་གཏོད་དམ་ཡང་ན་ལག་རྩལ་གསར་བཅོས་གལ་ཆེན་པོ་བྱས་ཡོད་པ།",
    "ཞུ་སྦྱོར་བྱས་འཐུས་ཀྱི་ཡུན་ཚད།",
    "བྱས་ཉེས་གསོག་པའི་སྤྱོད་ངན་གཅིག་རྗེས་གཉིས་མཐུད་དམ་འཕྲོ་མཐུད་དུ་སྤེལ་བའི་གནས་ཚུལ་ཡོད་ན།",
    "གཏན་ཁེལ་བྱས་པའི་སྲིད་འཛིན་བྱེད་ཐབས།",
    "ཉོ་ཚོང་བྱས་པ།",
    "དབོར་འདྲེན་བྱས་པ།",
    "འབར་རྫས་བཅས་རྐུ་འཁྱེར་དང་བཙན་འཕྲོག་བྱས་རིགས་སམ་ཡང་ན་དུག་གནོད་རང་བཞིན་ལྡན་པ་དང་།",
    "ཚོང་ཟོག་རྫུན་མ་དང་སྤུས་ཞན་ཐོན་སྐྱེད་དང་ཕྱིར་འཚོང་བྱེད་པའི་བྱས་ཉེས།",
    "ཐོན་སྐྱེད་བྱེད་མཁན་དང་ཕྱིར་འཚོང་བྱེད་མཁན་གྱིས་ཐོན་རྫས་ཀྱི་ནང་དུ་འདྲ་མ་འདྲེས་པ་དང་རྫུན་མ་བསྲེས་ནས་རྫུན་བཟོས་བདེན་བརྫུས་བྱས་པ་དང་།",
    "རྫས་ལུད་རྫུན་མ་ཐོན་སྐྱེད་བྱས་པ་དང་།",
    "གཉིས་མན་བར་གྱི་དངུལ་ཆད་ཆབས་སྦྲགས་སུ་གཅོད་རྒྱུའམ་རྒྱུ་ནོར་གཞུང་བཞེས་གཏོང་རྒྱུ།",
    "ལྐོག་འདྲེན་གྱི་བྱས་ཉེས།",
    "རྒྱལ་ཁབ་ནས་ཕྱིར་གཏོང་བྱས་མི་ཆོག་པའི་རིག་དངོས་དང་།",
    "གཅིག་འགག་སྒོའི་ཆོག་མཆན་མ་ཐོབ་པ་མ་ཟད་འཇལ་དགོས་པའི་ཁྲལ་དངུལ་གསབ་འཇལ་མ་བྱས་པར།",
    "ཆོག་མཆན་ཐོབ་ནས་ནང་འདྲེན་བྱས་པའི་ལག་འབྱོར་རྒྱུ་ཆ་ལས་སྣོན་དང་།",
    "འགག་སྒོའི་ཆོག་མཆན་ཐོབ་མེད་པ་མ་ཟད་འཇལ་དགོས་པའི་ཁྲལ་དངུལ་གསབ་འཇལ་མ་བྱས་པར།",
    "དམིགས་འཛུགས་ཀྱིས་དཔྱ་ཁྲལ་ཆག་ཡང་དང་རྩ་ཆག་བཏང་བའི་ནང་འདྲེན་ཚོང་ཟོག་དང་དངོས་རྫས་རྣམས་རང་མཚམས་ཀྱིས་མངའ་ཁོངས་སུ་བྲིན་འཚོང་བྱས་ནས་ཕན་ཁེ་གཉེར་རིགས།",
    "གཤམ་གསལ་གྱི་བྱ་སྤྱོད་རྣམས་ལྐོག་འདྲེན་གྱི་ཉེས་པར་བརྩིས་ནས།",
    "ལྐོག་འདྲེན་བྱེད་མཁན་ཉེས་ཅན་དང་ངན་འབྲེལ་བྱས་ཏེ་དེ་དག་ལ་དངུལ་བུན་དང་།",
    "འཛིན་ཤོག་དཔང་ཡིག་བཅས་མཁོ་སྤྲོད་བྱས་པའམ་དེ་དག་ལ་སྐྱེལ་འདྲེན་དང་།",
    "རྒྱལ་ཁབ་ནང་ལོགས་ཀྱི་མཚོ་དང་མངའ་ཁོངས་རྒྱ་མཚོར་རྒྱལ་ཁབ་ནས་ཕྱིར་གཏོང་ནང་འདྲེན་བྱས་མི་ཆོག་པའི་དངོས་རྫས་སྐྱེལ་འདྲེན་དང་།",
    "འགག་སྒོའི་ལྟ་སྲུང་དོ་དམ་ལས་གཡོལ་ཐབས་བྱས་ཏེ་ཕྱི་ཁོངས་ཀྱི་སྲ་གཟུགས་བེད་མེད་དངོས་རོ་མངའ་ཁོངས་སུ་སྐྱེལ་འདྲེན་བྱས་རིགས་བཅས་ཡིན།",
    "ཀུང་སི་དང་ཁེ་ལས་ཀྱི་དོ་དམ་སྒྲིག་ལམ་ལ་གནོད་རྐྱེན་བཟོ་བའི་བྱས་ཉེས།",
    "དངུལ་རྩ་དོ་དམ་གྱི་སྒྲིག་ལམ་གཏོར་བཤིག་གཏོང་བའི་བྱས་ཉེས།",
    "དངུལ་ལོར་རྫུན་བཟོ་བྱས་པའི་གྲངས་འབོར་ཧ་ཅང་མང་རིགས།",
    "བྱས་ཉེས་ལྷག་པར་ཚབས་ཆེན་གཞན་དག་ཡོད་རིགས་བཅས་ཡིན།",
    "གཞུང་བཞེས་ཀྱི་ཆད་པ་ཆབས་སྦྲགས་སུ་གཅོད་རྒྱུ།",
    "རྫུན་བཟོས་བྱས་པའི་དངུལ་ལོར་ཡིན་པ་ཤེས་བཞིན་དུ་ཉར་འཛིན་དང་བེད་སྤྱོད་བྱས་ཤིང་།",
    "སྒོར་ཁྲི་ལྔ་ཡན་ནས་སྒོར་འབུམ་ལྔ་མན་བར་གྱི་དངུལ་ཆད་དམ་རྒྱུ་ནོར་གཞུང་བཞེས་ཀྱི་ཆད་པ་ཆབས་སྦྲགས་སུ་གཅོད་རྒྱུ།",
    "སྒོར་ཁྲི་ལྔ་ཡན་ནས་སྒོར་འབུམ་ལྔ་མན་བར་གྱི་དངུལ་ཆད་དམ་རྒྱུ་ནོར་གཞུང་བཞེས་ཀྱི་ཆད་པ་ཆབས་སྦྲགས་སུ་གཅོད་རྒྱུ་སྟེ།",
    "དཔང་ཡིག་རྫུན་མ་བདེ་སྤྱོད་བྱས་རིགས།",
    "སྒོར་ལྔ་ཁྲི་ཡན་ནས་ལྔ་འབུམ་མན་གྱི་དངུལ་ཆད་གཅོད་རྒྱུའམ་རྒྱུ་ནོར་ཆབས་སྦྲགས་སུ་གཞུང་བཞེས་གཏོང་རྒྱུ་སྟེ།",
    "གྲངས་འབོར་ལྷག་པར་ཚེ་བའམ་ཡང་ན་ཉེས་ཚབས་ལྷག་པར་ཆེ་བའི་གནས་ཚུལ་གཞན་དག་ཡོད་རིགས་ལ།",
    "དུས་བཙོན་ལོ་བཅུ་ཡན་གཅོད་རྒྱུ་དང་སྒོར་ཁྲི་གཉིས་ཡན་ནས་སྒོར་འབུམ་གཉིས་མན་བར་གྱི་དངུལ་ཆད་དམ་རྒྱུ་ནོར་གཞུང་བཞེས་ཀྱི་ཆད་པ་ཆབས་སྦྲགས་སུ་གཅོད་རྒྱུ་སྟེ།",
    "གཅིག་ཉེན་འགོག་འགན་ལེན་གྱི་ཁོངས་སུ་ཞུགས་མཁན་གྱིས་ཉེན་འགོག་འགན་ལེན་གྱི་དངུལ་ཚད་རྐང་བཙུགས་ནས་བརྫུས་བཟོ་བྱས་ནས་ཉེན་འགོག་འགན་ལེན་གྱི་གྲོན་དངུལ་གཡོ་ལེན་བྱས་རིགས་དང་།",
    "ཉེན་འགོག་འགན་ལེན་བྱ་ཡུལ་གྱི་མིའམ་ཕན་ཆ་ཐོབ་མཁན་གྱིས་བྱུང་མེད་པའི་ཉེན་འགོག་འགན་ལེན་གྱི་བྱུར་རྐྱེན་རྫུན་བཟོ་བྱས་ཏེ་ཉེན་འགོག་འགན་ལེན་གྱི་གྲོན་དངུལ་གཡོ་ལེན་བྱས་རིགས།",
    "འགན་ལེན་བྱ་ཡུལ་གྱི་མིས་བསམ་བཞིན་དུ་རྒྱུ་ནོར་ལ་གྱོང་གུན་ཐེབས་སུ་བཅུག་པའི་ཉེན་འགོག་འགན་ལེན་གྱི་བྱུར་རྐྱེན་བཟོས་ནས་ཉེན་འགོག་འགན་ལེན་གྱི་གྲོན་དངུལ་གཡོ་ལེན་བྱས་རིགས།",
    "མི་གཞན་གྱི་མིང་ཐོ་རྫུན་འགོད་བྱས་པའི་མཛེས་རྩལ་རྩོམ་རིགས་བཟོ་བ་དང་ཕྱིར་འཚོང་བྱས་རིགས་བཅས་ཡིན།",
    "ཚོང་རའི་སྒྲིག་ལམ་དཀྲུགས་པའི་བྱས་ཉེས།",
