    "རྡོ་རྗེ་མཚན་གྱི་རྡོ་རྗེ་རྩེ་གསུམ་པ་བསམས་ནས་ཕྱག་རྒྱ་བཅིངས་ཤིང་བཟླས་པས་ལྷ་ཆེན་པོ་མེའི་གདོན་གྱིས་མི་ཚུགས་པར་བདེན་པའོ།",
    "༡ ༥ ༡པར་བྱེད་པའོ།",
    "སྲིན་པོ་རྣམས་གནོན་པར་བྱེད་པའོ།",
    "ལོ་འབྱུང་པོ་རྣམས་འགུགས་པར་བྱེད་པའོ།",
    "འཁོར་ལོ་ནི་ནོར་ལྷ་སྟེ་མ་གྲུབ་པ་རྣམས་གྲུབ་པར་བྱེད་པའོ།",
    "རྡོ་རྗེ་མཱ་མ་ཀཱིས་ནི་འདོད་པ་ཐམས་ཅད་རབ་ཏུ་སྦྱིན་པར་བྱེད་པའོ།",
    "ཤར་ཕྱོགས་སུ་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་བཅིངས་ནས།",
    "ལྷོ་ཕྱོགས་སུ་རིན་ཆེན་རིགས་ཀྱི་རྣམ་པར་རྒྱལ་བའི་རིན་ཆེན་ཧཱུྃ་མཛད་ཀྱི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "བསྒྲུབ་པའི་ལྷ་ནི་ཡི་གེ་ཧཱུྃ་ལས་གཙོ་བོ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་རྡོ་རྗེ་དང་སྡིགས་མཛུབ་བསྣམས་པ་བསྐྱེད་ལ་དེའི་ཐུགས་ཀའི་ཧཱུྃ་ལས་ཁྲོ་བོ་བཅུ་གཉིས་སྤྲུལ་ནས།",
    "དེ་དང་ཡེ་ཤེས་སེམས་དཔའ་ཐ་མི་དད་པར་གྱུར་པ་ལས།་",
    "༧༣རྣམས་ཀྱི་འཆད་པར་གྱུར་ཅིང་སྔགས་དང་ཕྱག་རྒྱས་བསྐུལ་བ་ལ་བཞུགས་སུ་གསོལ་བར་བྱའོ།",
    "ཕྱིས་འཆད་པར་འགྱུར་བའི་སྔགས་དང་ཕྱག་རྒྱ་བཅིང་ཞིང་བསྒྲུབ་པར་བྱའོ།",
    "གཞི་ནས་བཟླས་བརྗོད་བརྩམས་ན་བཟླས་བརྗོད་ཀྱི་བགེགས་དང་བར་གཅོད་ཐམས་ཅད་བཟློག་ཅིང་ཟིལ་གྱིས་མནན་པར་འགྱུར་རོ།",
    "མེ་ཏོག་ལ་སོགས་པའི་རྙིང་པ་རྣམས་དུས་གསུམ་དུ་ཕྱག་པར་བྱའོ།",
    "མཆོད་རྟེན་དང་དཀྱིལ་འཁོར་དུས་གསུམ་དུ་བྱས་ན་བར་ཆད་རྣམས་ཕྱིར་བཟློག་པར་འགྱུར་རོ།",
    "མ་བསྡམས་པའམ་མི་གཙང་བས་བཟླས་བརྗོད་བྱས་ན་བཟླས་པ་ིགྲངས་སུ་མི་གཏོགས་ཏེ།",
    "མཉམ་པར་མ་གཞག་པའི་བཟླས་བརྗོད་དང་།",
    "སྦྱིན་སྲེག་བྱས་པ་དང་།",
    "ས་གཞི་བྱི་དོར་ཆེས་ཁྱད་པར་གྱུར་པ་བྱས་པས་ཀྱང་ཕྱིར་བཟློག་པར་འགྱུར་རོ།",
    "ཡོན་ཏན་ལྷུར་ལེན་པར་འགྱུར་རོ།",
    "མི་གཙང་བ་དང་།",
    "ཌལེ་ལོ་དང་འདོད་ཆགས་དང་གཡེང་བ་དང་བཅས་པའི་ཚེ་ཏིལ་ནག་དང་ཡུངས་ཀར་གྱིས་སྦྱིན་སྲེག་བྱས་ན་ཕྱིར་བཟློག་པར་འགྱུར་རོ།",
    "སྦྱིན་སྲེག་བྱས་ནས།",
    "རྨི་ལམ་དུ་ཚང་བར་སྟོན་པར་འགྱུར་རོ་ལ་ལ།་",
    "ཉིས་ལྡབ་བམ་སུམ་ལྡབ་ཏུ་བསྐྱར་སྦྱིན་ལྷ་མཉེས་པར་འགྱུར་རོ།",
    "བསྙེན་པའི་ལྷ་ཚིམ་པར་བྱེད་པ་བསྟན་ནས་དཀྱིལ་འཁོར་གྱི་ཚེ་བཟླས་བརྗོད་དང་།",
    "ན་མསརྦ་ཏ་ཐཱ་ག་ཏ་ནཾ་ཨོཾ་སརྦ་བི་ཤུདྡྷ་བཛྲ་ཧཱུྃ་ཞེས་བྱ་བས་སྣོད་བཅུད་ཐམས་ཅད་སྟོང་པ་ཉིད་དུ་བསམ་པར་བྱའོ།",
    "དོན་དམ་པའི་ལྷ་སྟེ་དང་པོའོ།",
    "དེ་ནས་རྟོག་པ་དང་བཅས་པའི་ཤེས་པས་ཡི་གེ་ཧཱུྃ་ཧྥི་བསམས་པ་ནི་ཡིག་འབྲུའི་ལྷ་སྟེ་གསུམ་པའོ།",
    "ཏྲི་ལོ་ཀྱ་བི་ཛ་ཡ་ཧཱུྃ་ཞེས་བྱ་བ་ཁྲོ་བོ་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བ་ཞལ་གཅིག་པ་ཕྱག་གཉིས་པ་གནོད་མཛེས་ཀྱི་ཕྱག་རྒྱས་རྡོ་རྗེ་དྲིལ་བུ་བསྣམས་པ།",
    "སྨིན་མཚམས་ཀྱི་མཛོད་སྤུ་བསྐྱེད་པར་བྱའོ།་།",
    "ལྐོག་མར་སྔགས་དང་ཕྱག་རྒྱས་ིཚངས་པའི་གསུང་དབྱངས་བསྐྱེད་པར་བྱའོ།",
    "སྤྱི་གཙུག་ཏུ་བཞག་ནས་དབུའི་གཙུག་ཏོར་བསྐྱེད་པར་བྱའོ།",
    "རྐང་པ་དང་ལག་པའི་མཐིལ་དུ་འཁོར་ལོ་རྩིབས་སྟོང་དང་ལྡན་པ་བསྐྱེད་པར་བྱའོ།",
    "སྐུ་ཕྱག་རྒྱ་ཆེན་པོའི་ལྷ་སྟེ་ལྔ་པའོ།",
    "སྣ་ཚོགས་རབ་ཏུ་གྲུབ་པའི་རྒྱུད་ལས་གསུངས་པ་རྣམས་ཀྱིས་བསྐུལ་བའི་སྔགས་དང་སྤེལ་ནས་བཟླས་པ་བྱ་སྟེ་བསྙེན་པ་དང་པོའོ།",
    "རས་རིས་སམ་སྐུ་གཟུགས་བཞག་ནས་སྔགས་དང་ཕྱག་རྒྱ་ཟློས་པ་སྟེ་བསྙེན་པ་བཞི་པའོ།",
    "ནོར་འཕེལ་བར་བྱ་བའི་ཕྱིར་དེའི་གཟུགས་བརྙན་བྱས་ལ་སྔགས་དང་ཕྱག་རྒྱ་བཅིང་བ་དང་།",
    "ཀླུ་དང་ལྷ་མ་ཡིན་གྱི་གཟུགས་བརྙན་བྱས་ལ་སྔགས་དང་།",
    "ཤིས་པར་བརྗོད་པ་དང་།",
    "བཟོད་པར་གསོལ་བ་དང་།",
    "རྡོ་རྗེ་འབྲུ་ཡང་ལག་པ་གཡོན་པར་བཅངས་ལ་བསྲུང་བར་བྱའོ།",
    "རས་རིས་སམ་སྐུ་གཟུགས་མདུན་དུ་བཞག་ལ་ཉེ་བའི་བསྙེན་པ་ཞག་བདུན་ནམ་གསུམ་བྱའོ་ཞེས་གསུངས་སོ།",
    "འཁོར་ལ་གཏོར་མ་སྦྱིན་པར་བྱའོ།",
    "བདུད་རྩི་འཁྱིལ་པའི་སྔགས་རིངས་ཀྱིས་བགེགས་བསྐྲད་པར་བྱའོ།",
    "༡༦༣ཁྱད་པར་དུ་བདུད་རྩི་ཐབ་སྦྱོར་གྱིས་ས་གཟུང་ངོ།",
    "དུར་ཁྲོད་ལ་སོགས་པར་འཇིག་རྟེན་པའི་དངོས་གྲུབ་འཐོབ་པོ།",
    "ཨོཾ་པྲ་ཏི་ས་ས་པི་པ་ཡ་ཏྲ་སནྣི་ཧི་ཏོ་བྷ་བ་ཞེས་བརྗོད་ཅིང་བཞུགས་སུ་གསོལ་ལོ།",
    "སྤྱོད་པའི་ཚུལ་དང་ཁྱད་པར་གྱི།",
    "༧༣དེ་ནས་སྟ་གོན་གྱི་བགེགས་ཉེ་བར་ཞི་བའི་ཆོ་ག་བྱས་ཏེ་མ་དང་ཊ་ལས་མིག་གཉིས་སུ་ཉི་མ་དང་ཟླ་བ་བསྐྱེད་ལ།",
    "མིག་འབྲས་ཧཱུཾ་ལས་རྡོ་རྗེ་བསྐྱེད་པར་བྱའོ་། རྐང་མཐིལ་དུ་ཧཱུྃ་ལས་སྣ་ཚོགས་རྡོ་རྗེ་བསྐྱེད་ལ་ཁྲོ་བོའི་སྐུར་བསྒོམས་ལ།",
