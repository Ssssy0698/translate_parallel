    "བལ་ཀ་ལོ་ཀྱི་གླུ་བ་ཁོ་༡༧༡༧ངས་ལེན་དུ་འགའ། ། རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་ཁྲུས་ཀྱི་ཆོ་གའི་འགྲེལ་པ། ། རྒྱ་གར་སྐད་དུ།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་ཁྲུས་ཀྱི་ཆོ་གའི་འགྲེལ་པ།",
    "དཔལ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ཁྲུས་ཀྱི་ཆོ་གས་གྲོལ་བར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་དེ་དག་རྣམ་པར་དབྱེ་བའི་རིམ་པ་བརྩམ་པར་བྱའོ།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་ཁྲུས་ཀྱི་ཆོ་གའི་འགྲེལ་པ།",
    "ཕྱི་དང་ནང་ནས་བགེགས་དང་ལོག་འདྲེན་རྣམ་པར་ལྡང་བའི་རྒྱུ།",
    "རྨུགས་པར་བྱེད་པ་ཞེས་བྱ་བའི་བར་དུ་ཆོ་གའི་དོན་རྣམ་པ་བཅོ་ལྔས་བསྟན་ཏེ།",
    "ཅི་རིགས་པར་ནི་སྦྱར་བར་བྱའོ།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱའོ།",
    "དེ་ནས་གསང་སྔགས་ཀྱི་ཚིག་གང་དག་གསུངས་པ་ཅི་དེ་དག་ཀྱང་།",
    "ཐོགས་པ་མེད་པའི་རྡོ་རྗེའི་ཚིག་ཏུ་རིག་པར་བྱའོ།",
    "ཚེདེས་ནི་རབ་ཁྲུས་གཙང་མ་ཡིན།",
    "གཙང་མའི་གོས་ཀྱིས་རབ་བརྒྱན་ཏེ།",
    "གོས་གཙང་མ་བགོ་བ་ནི་ཕྱིའི་གཙང་སྦྲའོ།",
    "རིག་སྔགས་དེ་རྣམས་༧ ཡེ་ཤེས་ལས་བྱུང་བར་རིག་པར་བྱའོ།",
    "དེ་དག་དུ་མ་བསྟན་པ་དེ་གཉིས་ཀ་ལྟར་ན་ཡང་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་ཁྲུས་ཀྱི་ཆོ་གའི་འགྲེལ་པ།",
    "ཞེས་གསུངས་པ་ལ་རིག་པར་བྱའོ།",
    "རྣམ་པར་མ་ཕྱེ་བའི་པདྨ་རཱ་ག་དང་།་",
    "མེ་ཏོག་རྣམས་གཞུག་པར་བྱའོ།",
    "རྒྱུད་དག་ལས་རིག་པར་བྱའོ།",
    "མགུལ་ཆིངས་གཙང་མའི་གོས་ཞེས་བྱ་བ་མ་སྤྱད་པ་མ་ཉམས་པའི་རས་དཀར་པོ་ཁ་ཚར་དང་བཅས་པའོ།",
    "མཚམས་བཅད་པ་དག་བྱས་ནས།",
    "རིམ་པ་གསུམ་པར་ཐིག་གདབ་པར་བྱའོ།",
    "༡༡༢ ༣བབས་ཀྱིས་མཛེས་པར་བྱའོ།",
    "ལྷག་མ་རྣམས་རྡོ་རྗེ་རྩེ་གསུམ་པའི་ཚུལ་དུ་བྱས་ཏེ།",
    "བཞིན་ཁྲོ་གཉེར་ཅན་ཕྱག་གཡས་ན་རྡོ་རྗེ་རྩེ་ལྔ་གདེངས་པར་བྱས་པ་ཐོགས་པར་བསམས་ཏེ།",
    "རྣམ་རྒྱལ་ལ་སོགས་པ་བཀྲ་ཤིས་ཀྱི་ལྷ་བརྒྱད་ཀྱི་ཕྱག་མཚན་རྣམས་དགོད་པར་བྱ་བའི་ཕྱིར།་",
    "ཅེས་བྱ་བས་གྲངས་ངེས་པར་གསུངས་པ་ལ།",
    "སྡུག་བསྔལ་སེལ་བར་བྱེད་པ་དང་བདེ་བ་སྐྱེད་པར་བྱེད་པའོ།",
    "སྡུག་བསྔལ་ཐམས་ཅད་མེད་པར་བྱེད།",
    "དཔལ་ཀུན་གྱིས་ནི་ལེགས་པར་བརྒྱན།",
    "ཆུ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་ཁྲུས་ཀྱི་ཆོ་གའི་འགྲེལ་པ།",
    "དུག་དང་མཚོན་ལ་སོགས་པའི་འཇིགས་པ་ཐམས་ཅད་ལས་སྒྲོལ་བར་རིག་པར་བྱའོ།",
    "བཀའ་ན་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ཁྲུས་ཀྱི་ཆོ་གའི་འགྲེལ་པ་སློབ་དཔོན་རྡོ་རྗེ་གོ་ཆས་མ་བསཔབའི་།",
    "པེ་། རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་ཁྲུས་ཀྱི་ཆོ་གའི་འགྲེལ་པ་བཞུགས་སོ།",
    "སྣར་པར།",
    "མན་ངག་བཞུགས།"
  ]
}