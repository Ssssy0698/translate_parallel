    "ཐུར་དུ་གྲོལ་བ་གཅེར་བུ་ལང་ཚོ་དང་ལྡན་པ་ཡིད་ནོར་གཡས་པ་རྡོ་རྗེ་སྡིག་མཛུབ་བྱེད་པ།",
    "གཡོན་པ་ཀ་པཱ་ལ་ཁྲག་གིས་བཀང་བ་ཡབ་ལ་སྟོབ་པ།",
    "དཔའ་མོ་རྣམས་ཀྱི་ཡང་དག་པར་འཁྱུད་ཅིང་བདེ་བ་ཆེན་པོའི་ཉམས་དང་ལྡན་པ།",
    "ཁ་ལ་ལྕེའི་ལྐོག་ཏུ་ཁ་གདོང་མ་སྔོན་མོ།",
    "མཚན་མའི་རྩེར་ཁྱི་གདོང་མ་དམར་མོ།",
    "དེ་ཡང་ལྷ་མངོན་རྟོགས་དེ་དག་གི་རང་བཞིན་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཐམས་ཅད་འོད་གསལ་ཕྱག་རྒྱ་ཆེན་པོ་ལྷན་གྱིས་གྲུབ་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད།",
    "རང་བཞིན་སྤྲོས་བྲལ་བདེ་སྟོང་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ཀུན་རྫོབ་ཏུ་སྣང་བའི་ཆ་མ་སྤངས་ལ་སྟོང་པའི་ཆ་མ་དོར་བའི་སྣང་སྟོང་ཟུང་དུ་འཇུག་པའི་ངོ་བོར་མོས་པར་བྱའོ།",
    "ཡུམ་རྣམས་ཀྱི་ལྟེ་བར་ཨོ་བོ་ལས་ཕག་མོ་དམར་མོ་དང་།",
    "མགྲིན་པར་ཧྲི་མོ་ལས་རྨོངས་བྱེད་མ་ལྗང་། ཁུ་དང་།",
    "མགོ་ལ་ཧཱུྃ་ཧཱུྃ་ལས་བསྐྱོད་བྱེད་མ་སེར་མོ།",
    "དཔྲལ་བར་ཕཊ་ཕཊ་ལས་གཏུམ་མོ་དུད་ཁ་སྟེ།",
    "ཡོ་ག་ཤུདྡྷོཉཧཾ་གི་སྔགས་བརྗོད་པ་དང་།",
    "རང་གིས་ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཨ་བྷི་ཥིཉྩ་ཏུ་མཾ།",
    "དེ་ཉིད་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་བདེ་སྟོང་གི་དོན་ཉམས་སུ་མྱོང་བ་སྤྲོས་བྲལ་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པའི་དོན་བསྒོམས་པའོ།",
    "ཐུན་༢ མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་དངོས་གྲུབ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་བཟླས་པ་བྱའོ།",
    "དེ་དག་ནི་ངག་གི་སྒྲ་སྤངས་པས་ཡིད་རྡོ་རྗེའི་བཟླས་པའོ།",
    "པདྨའི་ཐིག་ལེ་དམར་པོ་གཏུམ་མོ་དྲོད་ཀྱི་རང་བཞིན་ཅན་དེ་ལས་མེ་བྱུང་བས།",
    "བའོ་། དེ་ལ་དམ་ཚིག་གི་བཟླས་པ་བྱ་སྟེ།",
    "ཁམས་གསུམ་བརྟན་གཡོ་ཐམས་ཅད་རང་གི་དཀྱིལ་འཁོར་དུར་ཁྲོད་དང་བཅས་པ་ལ་ཐིམ་སྟེ་ཐམས་ཅད་བདེ་བ་ཆེན་པོར་ལྷང་ལྷང་བསྒོམ།",
    "ལྷ་མོ་བཅུ་གཉིས་དབུས་ཀྱི་གཙོ་བོ་ལ་ཐིམ།",
    "དེ་ཁོ་ན་བཞིན་དུ་བསྒོམ་ན་གནས་སྐབས་མཐར་ཐུག་གི་རྟགས་དང་ཡོན་ཏན་དངོས་གྲུབ་གཉིས་དང་བཅས་པ་ཐོབ་ཅིང་།",
    "སྐད་ཅིག་གཅིག་གིས་སྦྱོར་བ་ཡིས།",
    "བག་ཆགས་སྲེག་པའི་མེ་དཔུང་གིས།",
    "བ་༥ ། བློན་པོ་རིགས་གསུམ་ལས་བྱེད་དང་སྔོན་མོ་སོགས་གསུང་ལས་བྱེད་དང་།",
    "། ན་མོ་གུ་རུ།",
    "ཐུན་མོང་ཡིད་བཞིན་ནོར་བུ།",
    "མཐར་སྐད་ཅིག་མས་སྒྱུ་ལུས་ལྷའི་སྐུ་འོད་གསལ་གྱི་ངོ་བོ་སྟོང་པ་ཟུང་འཇུག་གི་བདག་ཉིད་ལས་སྤྱོད་ལམ་བྱའོ།",
    "དེར་སྣ་ཚོགས་པདྨ་།་། ཉི་མའི་གདན་ལ་ཧེ་རུ་ཀ་རྡོ་རྗེ་འཆང་གི་རང་བཞིན་ལ།",
    "དེ་ནས་ཎྞཾཧེ་རུ་ཀའི་ཡི་གེ་བརྒྱ་པ་བཟླས་པས་ཡབ་ཡུམ་སྙོམས་པར་ཞུགས་ཏེ་བདུད་རྩི་བབས་པས་ཕྱི་ནང་གི་སྡིག་སྒྲིབ་ཐམས་ཅད་དག་པར་བྱས་ནས་མཐར་ལྷ་དང་བདག་ཀྱང་སྟོང་པའི་ངང་དུ་བྱས་ལ།",
    "སྨད་དཀྲིས་སྟག་གི་ལྤགས་པར་དྲན་རྗེ་བཙུན་མ་གཙོ་བོར་སྒོམ་ན་གོས་རྒྱན་ཕྱག་རྒྱ་ལྔར་བྱིན་གྱིས་བརླབ་བོ་པར་བྱའོ།",
    "མོས་བུམ་པས་ཆུ་བླུག་ཅིང་བཀྲུ་བར་བྱའོ།",
    "རང་གི་ལྟེ་བ་སྤྲུལ་པའི་འཁོར་ལོ་རྩ་འདབ་དམར་པོ་ལ་ཡིག་འབྲུ་དཀར་པོ་དབུས་ན་ཨཱ་རྩ་འདབ་བརྒྱད་ལ་གཡོན་བསྐོར་དུ་རིམ་བཞིན་དུ།",
    "བདག་ལ་ཐུགས་རྗེས་གཟིགས་སུ་གསོལ།",
    "ཨཱཞེས་བརྗོད་པས་ཟས་ཧཱུཾབདུད་རྩིའི་རང་བཞིན་དུ་གྱུར་པ་ལ་མི་གཙང་བ་དང་མ་དག་པ་ཐམས་ཅད་ཁོལ་བས་ཕྱིར་ལུད་ནས་འོ་མའི་རྣམ་པ་ལྟ་བུ་དེ་གསལ་བས་རང་གི་ཡང་ཧཱུྃ་ཞེས་བརྗོད་པས་ཐུགས་ཀ་ན་བདེ་མཆོག་ཡབ་ཡུམ་བཞུགས་པ་ལས།",
    "སྤྱི་བོའི་ཧཾ་ལས་བྱང་སེམས་ཕབ་ནས་ཕྱག་གཡོན་གྱི་ཐོད་པར་བྱ་བས་གསོལ་བར་བསམ་མོ།",
    "དེ་དག་ཀྱང་བདེ་སྟོང་དུ་ཕྲིལ་གྱིས་སོང་བས་གསོལ་བའོ།",
    "འབྲིང་སྒྱུ་ལུས་རྟོགས་པའི་ངང་ལས་རང་གི་རིག་པ་ལམ་དུ་ཁྱེར་ནས་འགྲོ།",
    "བྱ་འོས་རང་གི་མགོན་ལ་བཏུད་། དེ་ཁོ་ན་ཡང་སྔོན་དུ་བྱས།",
    "དཔའ་བོ་ཡི་གེ་དྲུག་གིས་སྦར།",
    "རྡོ་རྗེ་ལྷ་མོ་བཀུག་ལ་ཐིམ།",
    "རྩེ་གཅིག་ཞལ་གྱི་ཕྱོགས་བཅུར་གཟིགས་པར་མཛད།",
    "བདེ་ཆེན་གསུང་གི་རིན་ཆེན་ཆོངས།",
    "བདག་ལྟའི་བུད་ཤིང་བསྲེགས་ནས་ནི།",
    "འབད་མེད་རྣམ་པ་ངང་གིས་གསལ།",
    "མཆོག་གིས་སྣོད་དུ་བྱིན་གྱིས་བརླབ།",
    "སྐུ་གསུམ་དབྱེར་མེད་མཆོག་གི་དོན།",
    "བཛྲ་ཡོ་གི་ནི་ས་དྷ་ནཱ་མ།",
    "དར་དཔྱངས་དག་གིས་ཡང་དག་སྒྲུབ་ཐབས་མཛེས་། བཅུ་དྲུག་ལོན་པའི་ན་ཚོད་ལྟར།",
    "དཔའ་མོ་དྲུག་ནི་རིམ་བཞིན་བསྐོར།",
    "རང་གི་ལྟེ་བའི་དབུས་ཉིད་དུ།",
    "རང་གི་ཐུགས་ཀར་པད་ཉིའི་སྟེང་།",
    "ཨོཾ་བཾ་ཧུཾ་ཡཾ་ཧཱུཾམོ་ཧྲེ་ཧྲི་ཧཱུྃ་ཧཱུྃ་ཛྭཊ་ཕཊ།",
    "བཛྲ་ཡོ་གི་ནཱི་སཱ་དྷ་ན།",
    "དེར་ཨོཾ་སརྦ་བུདྡྷ་ཌཱ་ནཱི་ཡེ་བཛྲ་ཝརྞ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "པཉྩཱཡིད་དང་ངག་གི་དབྱེ་བས་བཟླས་པར་བྱའོ།",
    "དེ་ནས་བཾ་ཡིག་གི་འོད་ཟེར་གྱིས་ས་གསུམ་དང་།",
    "ཇི་ལྟར་རྙེད་པའི་དམ་ཚིག་གི་རྫས་དང་བཅས་པའི་གཏོར་མ་བཤམ་སྟེ།",
    "ཇོ་མོ་ལྷན་ཅིག་སྐྱེས་མའི་གཏོར་མའི་ཆོ་ག་ཉིས་བྱོནརྫོགས་སོ།",
    "། ན་མོ་གུ་རུ་དེ་བ་ཌཱ་ཀི་ནཱི།",
