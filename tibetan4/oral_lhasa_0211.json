    "དོན་ཟབ་རྣམ་པར་དག་པ་བློ་ཡིས་གཞལ་བྱ་མིན་པ་བཞིན།",
    "དད་ལྡན་རྣམས་ཀྱི་མགྲིན་པའི་བརྒྱན་དུ་མཛེས་པར་བྱོས།",
    "བར་ཆད་སྐད་ཅིག་ཙམ་ཡང་མེད་པར་ཤོག།",
    "སྐྱེ་བས་ཐོབ་པའི་མཁྱེན་རབ་ཕུལ་བྱུང་ལྡོག་པ་མེད་པའི་བརྩོན་འགྲུས་ཕུན་ཚོགས་པས།",
    "ཡོན་ཏན་ཐམས་ཅད་ལ་གོང་ནས་གོང་དུ་འགྱུར་ལེགས་པར་ཐོན་པ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་གསང་སྔགས་ཀྱི་ཕྱོགས་ལ་པོ་ཏི་འདི་ཙམ་ཞིག་མཁྱེན་པ་ཡིན་ཟེར་བའི་ཚད་སུས་ཀྱང་བཟུང་བར་མི་ནུས་པ།",
    "དམན་པ་རྣམས་ལའང་བརྙས་པར་མི་མཛད་པ།",
    "སྐུའི་སྤྱོད་པ་རྣམས་ཤིན་དུ་གཙང་བ།",
    "བསམ་གྱིས་མི་ཁྱབ་བའི་མཁྱེན་པ་མངའ་ཡང་ཐ་མལ་པ་ལྟར་མཛད་པ།",
    "སྙན་པའི་གྲགས་པས་ཕྱོགས་ཀུན་དུ་ཁྱབ་པས་ཆེ་དགུ་ཐམས་ཅད་ཀྱིས་ཞབས་ཀྱི་པདྨར་ཕྱག་བྱས་པ།",
    "མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་སྒྱུ་མ་ལྟ་བུ་དང་རྗེས་སུ་མཐུན་པའི་ཏིང་ངེ་འཛིན་གྱིས་བཟློག་པར་ནུས་པ།",
    "བྱེ་བྲག་ཏུ་འགྱུར་དང་ཡིག་འཇོག་མང་དུ་གནང་བས་བསྟན་པ་གསལ་བར་མཛད་པ།",
    "གསོལ་བ་ཇི་ལྟར་བཏབ་པ་བཞིན་དུ་ཡུན་དུ་བཞུགས་པར་བཞེད་པའི་ཐུགས་རྗེ་ཆེན་པོ་མངའ་བ།",
    "མནལ་ལམ་གྱི་འཇུག་པ་ཡང་སྒྱུ་མའི་རྣམ་འཕྲུལ་ལྟར་སྤྱོད་པར་ནུས་པ།",
    "གཙུག་ལག་ཁང་དེར་ཕེབས་ནས་བཞུགས་པས་དེའི་ཐོ་སྐོར་གྱི་སྐྱེ་བོ་རྣམས་ཀྱི་ཙམ་པ་དང་དར་བ་ལ་སོགས་མང་དུ་ཁྱེར་ནས་འབུལ་དུ་བྱུང་།",
    "དེར་ཕེབས་མ་ཐག་ནས་དེ་རྣམས་སུ་ཤིན་ཏུ་བག་ཕེབས་པ་དང་ཡུལ་ཡིན་པ་སྙམ་བྱེད་པ་དང་།",
    "གཙུག་ལག་ཁང་དེའི་ནང་དུ་ཕེབས་པ་ཙམ་གྱིས་སྔར་འདྲིས་རྒྱུས་ཡོད་པ་སྙམ་བྱེད་པ་དང་།",
    "བྲག་རམ་དེར་ཡང་ངེས་པར་སྐྱེས་པ་འདྲ་གསུང་།",
    "ལོ་ཙཱ་བྱང་བ་དང་དེའི་རྩོམ་པ་རྣམས་ལའང་དགྱེས་པར་སྣང་བས།",
    "མཁྱེན་པ་དང་མཛད་པའི་ཚུལ་གང་ལ་བརྟགས་ཀྱང་སྐུའི་སྐྱེ་བ་སྔ་མ་མང་པོར་ངེས་པར་སྦྱངས་པ་ཆེན་པོ་མངའ་བ་ཞིག་སྟེ།",
    "སྐུ་ཡོན་ཏན་ངས་དཔག་པར་ག་ལ་ནུས།",
    "སློབ་དཔོན་སང་གྲགས་པ་ནི་ཡབ་ལ་ལོངས་སྤྱོད་མེད་པར་སྐྱེ་གཅིག་དང་ཕོར་པ་གཅིག་བསྣམས་ནས་སྤྱན་གཡས་སུ་བྱོན།",
    "རིང་པོ་མ་ལོན་པར་ཡབ་ཀྱིས་ན་བཟས་བཏུམས་ནས་ཁུརཏེ་སྤྱན་གཡས་སུ་བྱོན་པའི་ལམ་རྩིག་ཁ་ཅིག་ཏུ་བཞུགས་སུ་བཅུག་ནས་ཡབ་ཀྱིས་ཁམས་བསང་བ་ཐུགས་ཀྱིས་དྲན།",
    "ཉིན་ཅིག་ཁང་པའི་ཐོག་ན་བཞུགས་ལ་ཡུམ་གྱིས་ཕྱི་རོལ་ནས་རྩ་དུམ་ཅིག་ཁུར་ནས་ནང་དུ་བྱོན་པ་ལ་དགྱེས་ཆེས་ཏེ་རྒྱུགས་པས་ཁང་པའི་རྒྱ་མཐོངས་སུམ་བརྩིགས་ལ་སྦབ་ཏུ་ལྷུང་བ་ཡུམ་གྱིས་བར་སྣང་ནས་བཟུང་བས་ཅི་ཡང་མ་ཉེས།",
    "ཁྱད་པར་ངའི་མས་ངེད་རྣམས་བསྐྱངས།",
    "ཡུལ་ཞལ་ཚ་བའི་སྟོབས་ཀྱིས་འཐབ་ཀྱིས་དོགས་ནས་སང་ཞོགས་ནང་དུ་འཚོལ་བ་སྐད་བྱས་པ།",
    "རྒྱལ་སྲས་ཐོག་མེད་པ་ལ་སོགས་པའི་སྐྱེས་བུ་དམ་པ་མང་པོའི་ཞབས་ལ་གུས་པར་གཏུགས་པ།",
    "དེ་དུས་བཙུན་པའི་མཐར་ཐུག་པ་བཙན་ཐང་པ་ཚུལ་ཡེས་ལ་སོགས་པས་ལས་ཀྱི་ཁ་བསྐང་སྟེ་སློབ་དཔོན་བསམ་བཟང་པ་དང་དཔོན་སློབ་གཉིས་ཀྱིས་བསྙེན་པར་རྫོགས་པ་མཛད་དེ།",
    "ལ་འཇུག་པ་ལ་ཐུགས་ལེགས་པར་སྦྱངས།",
    "སྐུ་ཉམས་སུ་བཞེས་པ་དེ་ལའང་སྤྱོད་འཇུག་གསན།",
    "ཡུམ་གྱི་ཉེ་བའི་ཕྱོགས་དེད་ནས་སློབ་དཔོན་བསམ་གྲུབ་བཟང་པོ་བའི་སར་བཞུགས།",
    "དེའི་སོས་དེ་སྐྱིད་ཤོད་ཕྱོགས་སུ་གྲྭ་སྐོར་ལ་ཕེབས་པར་དགོངས་པ་ལ།",
    "དེའི་དབྱར་དེ་གྲ་སྐོར་ལ་སྐྱིད་ཤོད་དུ་ཕེབས།",
    "དེའི་ཟླ་ལ་རྗེས་གནང་གཉིས་པོ་ཞུས་གསུང་།",
    "གྲ་སྐོར་ཚར་ནས་སྤྱན་གཡས་སུ་ཕེབས་པས་སློབ་དཔོན་ཤེས་རབ་དར་བས་གསོལ་ཇ་ལེགས་པར་གནང་།",
    "ནན་གྱི་ཞུས་པས་འོ་ན་རྒྱུགས་ཤོག་གུ་གཉིས་མ་ཁྱེར་ཤོག་གསུངས་པས་ལེགས་པར་སྤྲད།",
    "སློབ་དཔོན་པས་ཁྲིད་ཞུ་བའི་སྙན་བཞུགས་ཕུལ་བས་ཞལ་གྱིས་བཞེས།",
    "དེ་ནས་སྒོ་ལའི་ལ་ཁར་ཕེབས་རྩ་ན་སྔག་པ་བྱུང་པ་ལ་བྲོས་པས་ཐར།",
    "དེ་ནས་ཐང་སག་ཏུ་ཕེབས།",
    "ཁྱད་པར་འཇུག་པ་འགྲེལ་པ་དང་བཅས་པ།",
    "ཐང་སག་པའི་ལུགས་ཀྱི་གསུང་སྒྲོས་རྣམས་ལ་ལེགས་པར་སྦྱངས།",
    "འཇུག་པ་རང་འགྲེལ་དང་བཅས་པ་ཐུགས་ལ་བཙུད་པས་ལེགས་པར་ཟིན།",
    "དེར་བཞུགས་རིང་ལ་སློབ་དཔོན་ཡེ་རྒྱལ་བས་འཚོ་བའང་སྦྱར།",
    "ཕེབས་རིན་ཆོག་པ་མེད་ཟེར་ཁོང་ལ་མངོན་བར་ཤེས་པ་ཡོད་པ་འདྲ་གསུང་།",
    "དེ་ནས་སྟོན་མཇུག་སྤོ་ཏོར་བཞུགས་ཐོག་ཏུ་ཡུལ་ནས་ཕྱེ་རྐྱལ་དཀར་པོ་གྲོགས་མཆེད་གཉིས་ལ་འཇམ་པོ་དཀར་པོ་གཅིག་བསྐུར་ནས་སྤྱན་འདྲེན་དུ་བྱུང་པས་སྣམ་བུ་དེ་སློབ་དཔོན་ལ་ཕུལ་ནས་ཡུལ་དུ་ཕེབས།",
    "དེ་ནས་སློབ་དཔོན་བསམ་བཟང་པའི་སར་ཕེབས་པས་ཁྱེད་འཕན་ཡུལ་ལ་གྲོས་མེད་དུ་འགྲོ་བ་ཅི་ཡིན་གསུང་།",
    "དེའི་ཞོར་ལ་ཇོ་ནང་ཀུན་མཁྱེན་ཆེན་པོའི་ཊིཀའི་ལུང་ཡང་གསན།",
    "སློབ་དཔོན་པའི་གདམས་པ་དེ་ཐུགས་ལ་འདོགས་པར་ཞུ་ཞུས་པས།",
    "སློབ་དཔོན་པ་ཡང་ཐུགས་མཐོང་ལྷགས་པར་ཆེར་བར་མཛད།",
    "ཁོང་ཡོན་ཏན་ཅན་རང་ལགས་ཞུས་པས།",
