    "ཤེས་རབ་སྐྱེད་པའི་ལྷ་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "ཞེས་གསུངས་འདུག་པ་ནས་ཀྱང་།",
    "བསྙེན་པར་རྫོགས་པ་ནས་བློ་བཟང་གྲགས་པའི་དཔལ་ཞེས་གསོལ་བ་ཡིན་འདུག་རྗེ་མཁས་གྲུབ་པས།",
    "ཞེས་འཐོན་འོས་པ་ལ་མ་ཐོན་འདུག་པ་དང་།",
    "བསྙེན་རྫོགས་ལ་མིང་སྔ་མའི་རྗེས་ལ་སྣོན་པ་ཞིག་ངེས་ཅན་དགོས་པའི་སྲོལ་ག་དུས་ད་ལྟའི་བར་ཡོད་ཆེ་བ་བཅས་ནས་སྔ་མ་ཉིད་འཐད་དོ།",
    "ཅེས་པ་འདིས་རབ་ཏུ་བྱུང་བའི་དུས་ཚེས་དེ་དགུང་ལོ་བདུན་པའི་ལོ་སྨད་ལ་ཁེལ་འདུག་པ་དཔོག་ཐུབ་པ་དང་།",
    "དབུས་གཙང་ནས་ཕྱིར་ཕེབས་དང་པོ་འདིས་ཁ་གྲགས་འདུག་གོ།",
    "ངམ་རིང་ཤོད་ན་མཁན་ཆེན་རྒྱལ་བ་དཔོན་སློབ་བདུན་བརྒྱ་ཙམ་འཆད་ཉན་མཛད་ཀྱིན་འདུག་པས།",
    "དུས་ཕྱིས་ཁོང་བདུན་བརྒྱ་བོས་བློ་བཟང་གྲགས་པ་གཅིག་བུ་ལ་ཡང་མི་དོ་བར་འདུག་གསུངས།",
    "དེ་ལྟར་ན་དབུས་ལམ་ལ་མ་ཐ་ཡང་ལམ་ཞུགས་ཟླ་ངོ་བདུན་ཞིག་ཐོགས་འདུག་ཅིང་།",
    "ཡང་དག་པའི་ལྟ་བ་བཅས་ལམ་གྱི་གཙོ་བོ་རྣམ་གསུམ་དུ་ཞུ་བ་ཆེད་དུ་ཐོན་འདུག་པས་ཀྱང་ཕྱིས་སུ་རྗེ་བཙུན་དང་ཞལ་མཇལ་བ་ནས་ཡིན་པ་གོ་དགོས།",
    "རྗེའི་བུ་ཆེན་ལས་རྒྱུས་དང་གསལ་ཆེ་བ་མི་འདུག་པས་དེས་འཐུས་པ་གྱིས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་དང་།",
    "ཞེས་གསུང་འདུག་པས་བཀའ་གདམས་གསར་མའི་ཕྱོགས་ལ་འདི་རྩོད་པ་ཅན་དུ་སྣང་བས་མི་འཐད་དོ།",
    "ཁྱེད་ལ་མཛུབ་ཁྲིད་བྱེད་པ་ལ་ལེགས་པར་བསྒྲིམ་དགོས་པ་འདུག་ཅེས་གསུངས་ཏེ།",
    "ཕྱིས་སུ་གོ་ཤཱཀ་རོང་གསུམ་སོགས་ཀྱིས་ཀྱང་དེར་ཅི་ཡང་ལབ་མི་འདུག་པས་ཤེས་ཤིང་།",
    "བདེ་བ་ཅན་ན་ཁ་མཆུ་དང་འཁྲུག་ལོང་མང་དུ་འདུག་པས་ཀྱང་ཐུགས་སྐྱོ་བར་གྱུར་ཏེ།",
    "ཡང་དེར་སྔོན་དུས་མཆིམས་རྣམས་ཀྱི་ཕྱག་དཔེ་ཡིན་ཟེར་བ་པོད་ལྔ་བརྒྱ་ལས་ལྷག་ཙམ་འདུག་རྡོ་རྗེ་གདན་གྱི་མཆོད་རྟེན་སོགས་དགོན་གནས་ཡོངས་རྫོགས་ཀྱི་བཀོད་པ།",
    "དེ་དུས་ཀྱི་གྲྭ་ས་རྣམས་ན་པོ་ཏི་གཞན་རྣམས་ཀྱི་གྲྭ་སྐོར་བྱེད་པའི་ལུགས་མ་དར་འདུག་པས་མ་བྱས་གསུངས་པ་དང་།",
    "ཕྱི་མ་གཉིས་བསྙེན་རྫོགས་རྗེས་མཛད་པ་མཛད་བྱང་ན་འདུག།",
    "བདག་སྔགས་ཀྱི་ཕྱོགས་ལ་འདུན་པ་དྲག་པོ་བདོག་པས་སྔོན་ལ་སྔགས་ཕྱོགས་ཀྱི་རྩད་གཅོད་བགྱིད་པ་ལགས་ཞེས་དགོངས་པ་ཞུས་འདུག་པས།",
    "ཁོང་རང་གཉིས་ཀྱིས་ཉང་སྟོད་སྨད་ཀྱི་མཚམས་འཁྲིས་རྩྭ་ཁང་ཞེས་པར་བཞུགས།",
    "སྐབས་སུ་བབས་པ་ན་ངས་ད་ལྟ་ས་བོན་བཏབ་པ་འདི་རྣམས་ཀྱིས་ཀྱང་རྐྱེན་བྱས་ནས་ལེགས་པར་གོ་བ་ཞིག་མྱུར་དུ་འོང་བར་འདུག་ཅེ་གསུང་ངོ།",
    "དེ་དུས་འབར་འཛག་གཉིས་གྲགས་པ་ཆེ་བར་འདུག་པས།",
    "ཁོང་སྐྱོ་ཤས་ཅན་ཅིག་འདུག་པས་དེའི་སྟོབས་ཀྱིས་ངེས་འབྱུང་དང་སྐྱོ་ཤས་དྲག་པོ་སྐྱེས།",
    "ནང་ཐུགས་ཀྱི་སྲས་པོ་འདི་ལས་ཁོངས་བཙན་པ་མི་འདུག་པས་འཁོར་དག་པ་རྣམ་བརྒྱད་བཅས་པའི་དཔོན་སློབ་དགུས་དབུས་ཀྱི་གཞུང་ཆུ་ལ་ཀོ་གྲུ་མཛད་ནས་བྱ་བྲལ་ལ་འོལ་ཁར་ཕེབས་ཐོན་གནང་ཞིང་།",
    "སྐབས་སུ་བབས་པ་ན་ངས་ད་ལྟ་ས་བོན་བཏབ་པ་འདི་རྣམས་ཀྱིས་ཀྱང་རྐྱེན་བྱས་ནས་ལེགས་པར་གོ་བ་ཞིག་མྱུར་དུ་འོང་བར་འདུག་ཅེས་གསུངས་ཞེས་དང་།",
    "དེ་དུས་ཀྱི་གྲྭ་ས་རྣམས་ན་པོ་ཏི་གཞན་རྣམས་ཀྱི་གྲྭ་སྐོར་བྱེད་པའི་ལུགས་མ་དར་འདུག་པས་མ་བྱས་གསུང་ངོ།",
    "ཨ་ལགས་ཚེ་བརྟན་ཞབས་དྲུང་བཅས་མང་བོ་ཞིག་ལ་འཁྲུལ་བ་ཞུགས་འདུག་པས་བསྐྱར་ཞིབ་བགྱིས་པ་ཡིན།",
    "དགུང་ལོ་ཉེར་དྲུག་པར་གཞི་ཆེ་བའི་འཆད་ཉན་གྱི་དབུ་ཚུགས་པའི་ཕྱི་ལོ་དེར་ཁེལ་འདུག་པ་བཅས་ནས།",
    "སྔ་ཕྱིའི་གྲྭ་སྐོར་གྱི་དུས་ཚུགས་ཚང་མ་སོས་དང་དབྱར་ལ་ཁེལ་འདུག་གོ།",
    "བྱང་ཙོང་ཁ་བ་དཀའ་བཞི་འཛིན་པ་བློ་བཟང་གྲགས་པ་ལ་སོགས་པས་ཞེས་བྲིས་གནང་འདུག་པས།",
    "བྱང་ཙོང་ཁ་བ་དཀའ་བཞི་འཛིན་པ་བློ་བཟང་གྲགས་པ་ལ་སོགས་པས་ཞེས་བྲིས་གནང་འདུག་པས།",
    "བདེ་བ་ཅན་ན་ཁ་མཆུ་དང་འཁྲུག་ལོང་མང་དུ་འདུག་པས་ཀྱང་ཐུགས་སྐྱོ་བར་གྱུར་ཏེ།",
    "ཁྱེད་ཀྱི་འཁོར་འདི་རྣམས་ཚོགས་ལམ་དང་སྦྱོར་ལམ་ཆེན་པོ་ལ་གནས་པ་ཤ་སྟག་འདུག་པས།",
    "འདི་རྣམས་ཀྱི་ཚེའི་བར་ཆད་དུ་འགྱུར་བ་འདུག་ཅིང་།",
    "དགུང་ལོ་བཞི་བཅུ་རྩ་ལྔ་ལ་སྐུ་ཚེའི་བར་ཆད་ཡོང་ཉེན་འདུག་པས།",
    "མེད་ན་མེད་ཐབས་མེད་པ་དེ་འདྲ་རང་ཞིག་འདུག་གོ།",
    "ཁུངས་རྗེ་མཁས་གྲུབ་པར་རྩ་འཛིན་བགྱིས་པའི་རྒྱས་ཙམ་འདུག་ཀྱང་།",
    "གཟི་བརྗིད་ཀྱི་ཟིལ་ཤིན་ཏུ་ཆེ་བར་ཡོང་བ་ཡིན་པར་འདུག་ཅེས་པ་དང་།",
    "བསྟན་བཅོས་ཀྱི་ལུས་ཡོངས་སུ་རྫོགས་པའི་དོན་གྱི་ཁོག་ལེགས་པར་བསྒྲིགས་ནས་འགངས་འཆུན་པའི་གོ་བ་བོགས་ཆོད་དུ་སྟེར་ནུས་པ་ཞིག་འདུག་པས་དད་པ་ཆེན་པོ་འཁྲུངས།",
    "ཁྱེད་ལ་མཛུབ་ཁྲིད་བྱེད་པ་ལ་ལེགས་པར་བསྒྲིམ་དགོས་པ་འདུག་ཅེས་གསུངས་པ་དང་།",
    "སྣ་བོ་ཆེ་ལ་གོ་དོན་གཞན་འདུག་ཀྱང་།",
