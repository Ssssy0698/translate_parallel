    "གོས་དཀར་ཅན་གྱི་རིག་སྔགས་ཀྱི་ཆོ་ག་ལ་གཞེན་འདེབས་ཤིང་སྒྲུབ་པར་བྱེད་པའི་གསང་སྔགས་ཆེན་པོ་ཡང་ངས་སྦྱིན་པར་བྱའོ།",
    "དེའི་གཡོན་རོལ་དུ་ནི་གོས་དཀར་ཅན་གཞག་པར་བྱའོ།",
    "དེ་ནས་གོས་དཀར་ཅན་འགྲུབ་པར་འགྱར་རོ།",
    "སྟོན་ཟླ་ར་བ་ཚེས་བརྒྱད་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ།",
    "མངགས་མ་ཐག་ཏུ་ཡིད་ཅི་སེམས་པ་འགྲུབ་པར་འགྱུར་རོ།",
    "ལན་བདུན་བཟླས་བརྗོད་བྱས་པའི་ཡུངས་ཀུར་གྱིས་བྱའོ།",
    "གདོན་ལ་བསྟན་ན་གདོན་གྱི་ལུས་ཚ་བས་འདེབས་པར་འགྱུར་རོ།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ།",
    "ལས་དེ་གྲུབ་པས་ཆོ་ག་རྒྱས་པར་༡་ཚོགཞན་དག་བདེ་བླག་ཏུ་འགྲུབ་པར་འགྱུར་རོ།",
    "རིག་སྔགས་འཆང་རིག་སྔགས་སྒྲུབ་པ་ན་གཞོན་ནུའི་གསང་སྔགས་དྲན་པར་བྱས་ཏེཉན།",
    "འོངས་ནས་དངོས་གྲུབ་སྦྱིན་པར་བྱའོ་ལྷ།",
    "ཞག་གསུམ་སྨྱུང་བ་བྱས་ཏེ་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ལྷ་ཆེན་པོའི་གནས་སམ།",
    "རྐང་པ་གཡས་པ་བྱུག་པར་༡བྱའོ།",
    "རིག་སྔགས་ཀྱང་ལན་བརྒྱད་༢སྟོང་བཟླས་བརྗོད་བྱས་ཏེ།",
    "དེས་ཀྱང་འདོད་པ་ཐམས་ཅད་སྦྱིན་པར་གྱིས་ཤིག་ཅེས་སྨྲོས་ཤིག།",
    "དེ་ནས་ཡིད་ལ་གང་བསམས་པ་དེ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་ཏེ་ཚེ་ལོ་སྟོང་ཉིས་བརྒྱ་ཐུབ་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་རྡོ་རྗེའི་རིགས་བསྒྲུབ་པར་འདོད་ན།",
    "སྲས་གཏུམ་པོ་དྲན་པར་བྱའོ།",
    "དེ་ནས་གཞོན་ནུ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "བགེགས་མེད་པ་བདེ་བླག་ཏུ་ཆོ་ག་རྒྱས་པ་འགྲུབ་པར་འགྱུར་རོ།",
    "ལེགས་པ་རུ་ནི་དྲན་པར་བྱེད།",
    "དངོས་གྲུབ་ཀྱང་ནི་སྦྱིན་པར་བྱ།",
    "རྡོ་རྗེ་འབར་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ།",
    "བཅོམ་ལྡན་འདས་ལག་ན་རྡོ་རྗེས་རྡོ་རྗེ་༡༡འབར་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་༡༢མ་ཐག་ཏུ་ལྷ་ཐམས་ཅད་སེམས་འཇིགས་༡་པར་འགྱུར་ཏེ།",
    "མ་གྲུབ་པ་རྣམས་གྲུབ་པར་བྱེད་པ།",
    "དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་འཇུག་པར་བྱེད་པ།",
    "ལྷ་ཐམས་ཅད་བསྐྱེད་པར་འགྱུར་བ་དང་།",
    "ས་གཞི་དེ་དག་བརྟག་ལབྱས་ལ།",
    "ས་དེ་ལྟ་བུ་མཐོང་ནས་སྨྱུང་བ་བྱས་ཏེ་གསོ་སྦྱོང་དང་ལྡན་པས་དུ་གུ་ལའི་རས་དཀར་པོ་བགོས་ལ།",
    "ཡང་ན་ཙནྡན་གྱི་ཕྱེ་མས་བྲིས་ན་ནི་དཔལ་ཐོབ་པར་འགྱུར་རོ།",
    "ཡང་ན་འབྲས་ཕྱེ་དཀར་པོས་བྲིས་ན་ནི་དཔལ་ཐོབ་པར་འགྱུར་རོ།",
    "རིག་སྔགས་འཆང་བདག་ཉིད་དག་པར་བྱ་སྟེ།",
    "རྒྱུ་སྐར་དང་མཐུན་༤པའི་དུས་སུ་སྨྱུང་བ་བྱས་ལ།",
    "བཏབ་ན་ནི་རིག་སྔགས་འཆང་རྣམས་ཕན་ཚུན་མི་མཐུན་༩པར་འགྱུར་རོ།",
    "ཅི་སྟེ་ཐོག་མར་ཚོན་དཀར་པོ་བཀྱེ་ན་ནི་རྒྱལ་པོ་རྒྱལ་བར་འགྱུར་ཞིང་རིག་སྔགས་འཆང་རྣམས་ཀྱི་ལས་འགྲུབ་པར་འགྱུར་རོ།",
    "ཡང་ན་པཱ་ཎ་༩བརྒྱས་རྡོ་རྗེ་བྱས་ཏེ་བཞག་ལ་དེའི་སྟེང་དུ་སྤྱན་གྱིས་བཟླས་བརྗོད་བྱས་པའི་བུམ་པ་མི་གནག་༧ཅིང་རྩ་བ་མེད་ལ་མགྲིན་བཅིངས་དང་བཅས་པ་གཞག་པར་བྱ་སྟེ།",
    "གྲྭ་༡༢བཞིར་ཡང་བུམ་པ་བཞི་གཞག་པར་བྱ་སྟེ།",
    "གོས་གཙང་མ་བགོས་པ།",
    "དཀྱིལ་འཁོར་དུ་གཞུག་པར་བྱའོ།",
    "མགོ་བོར་བསང་གཏོར་བྱས་ཏེ་གཞུག་གོ།",
    "འགྲོན་ཅབུ་དེ་ཡང་ལོ་མས་དཀྲིས་སྙེན་ནི་རིག་སྔགས་འགྲུབ་པར་འགྱུར་རོ།་།",
    "རིག་སྔགས་འཆང་དེ་དག་ལ་ལྷ་རྣམས་ཀྱང་བསྟན་རིན་པར་བྱའོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་བ་སྤུ་ལྡང་བར་འགྱུར་ཞིང་བསྟོད་པའི་གླུའི་གེསྒྲ་ཡང་ཐོས་པར་འགྱུར་ཏེའི།་",
    "དར་བར་གྱུར་ཅིག་ཅེས་བརྗོད་པར་འགྱུར་རོ།",
    "རྒྱལ་པོའི་དཔལ་ཉམས་པ་སླར་གྲོན་པར་འདོད་ན་རིག་སྔགས་འཆང་དེས་ཞག་གསུམ་སྨྱུང་བ་བྱས་ཏེ་༡།",
    "བྱང་དང་ནུབ་དང་ལྷོར་ཡང་དེ་བཞིན་དུ་དགོད་པར་བྱའོ།་།",
    "ཡང་ན་པདྨ་བརྒྱད་འིསྟོང་སྨྱུགས་༩ཏེ་སྦྱིན་སྲེག་བྱས་ལ་མར་གྱི་མར་མེ་བརྒྱད་སྟོང་སྦར་ཏེ་དེ་ནས་ལས་བྱའོ།",
    "ཕལ་པ་གང་ལ་ལས་ཁྲུས་བྱས་ན་དེའི་ལོངས་སྤྱོད་ཀྱི་གཞི་འགྲུབ་པར་འགྱུར་ཏེ།",
    "གང་དང་གང་འདོད་པའི་ཕྱིར་བྱས་ན་༥༧ཡང་འདོད་པ་དེ་དང་དེ་ཐོབ་པར་འགྱུར་ཏེ།",
    "འདི་ནི་སྐྱེ་བོ་གནས་པ་དང་འགྲོ་བ་འཇིག་༡༢པར་བྱེད་པ་ལགས་ཀྱིས་༡སྙེ།",
    "འཇིག་རྟེན་ན་སྡང་བ་གང་ཇི་སྙེད་ཡོད་པ་དེ་དག་གཞིག་པར་བྱའོ།",
    "འཇིགས་པའི་སྒྲ་ཡང་འབྱིན་པར་བྱེད།",
    "ལོ་དགུ་པ་ལ་མ་འཇུག་པར།",
    "མུན་པ་མི་བཟད་གནས་པར་འགྱུར།",
    "འདི་ཡང་ལྷ་རྣམས་མཉན་པར་གྱིས།",
    "རིག་སྔགས་ཀྱི་རྒྱལ་པོ་ཆེན་པོ་དྲན་པར་གྱིས་ཤིག།",
    "བཅོམ་ལྡན་འདས་ཤཱཀྱ་འཐུབ་པ་དེ་བཞིན་གཤེགས་པ་དྲན་པར་གྱིས་ཤིག་དང་།",
    "དེས་ན་ཚའཇིགས་པར་མི་འགྱུར་རོ།་།",
    "སྐལ་ཚབ་ཆེན་པོ་ལྡོག་པར་གྱིས་ཤིག།",
    "བྱིས་པ་གང་ནམ་གྲུའི་ཆོ་འབྲང་དང་མཚན་ཉིད་སྣོད་དུ་བཅུག་སྟེ་འཆང་བ་དེ་ལ་ནི་གདོན་ཐམས་ཅད་ཀྱིས་འཇིགས་པར་མི་འགྱུར་རོ།",
    "ལྷ་རྣམས་ངའི་བཀའ་གཅོག་པ་དེ་ནི་ངས་རྡོ་རྗེ་འབར་བ་ཀུན་ཏུ་རབ་ཏུ་འབར་བར་སྤྱི་བོ་གཤེག་པར་བྱའོ།",
    "ཏིལ་ཕྱེ་ལས་བྱས་འཁུར་༡་བ་དང་།",
    "ལྷ་ཐམས་ཅད་ལ་ཡང་བཤོས་སྣ་ཚོགས་དབུལ་བར་བྱ་ཞིང་དེར་ཤིན་ཏུ་བཀྲ་ཤིས་པའི་ཚིགས་སུ་བཅད་པ་ཡང་བཀླག་༡༡པར་བྱའོ།",
    "མཚན་ཉིད་ཀྱང་བཀླག་༧པར་བྱ་སྟེ།",
    "རྐང་པ་གཡས་པ་དེ་ཡང་འདེགས་ཉྩཔར་བྱ་སྟེ།",
    "ཅི་སྟེ་སྔོ་བསངས་མཐོང་ན་ནི་མཚོན་ཆ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "ཚོགས་སྟོབས་པོ་ཆེ་བརྒྱད་པོ་རྣམས་འགྲུབ་པར་འགྱུར་ཏེ་ཞག་གསུམ་ན་ཕོ་ཉ་མའི་༡་ཚོགས་རྣམས་ཡོངས་སུ་མགུ་བར་གྱུར་པས་གློ་དབུར་དུ་སྐྱེས་པ་དང་།",
    "ཚོགས་སྟོབས་པོ་ཆེ་བརྒྱད་པོ་རྣམས་ལས་སྣ་ཚོགས་ཀྱིས་བསྒྲུབ་པར་བྱའོ།",
    "མེ་ལྕེ་མའི་ལས་འདི་རྣམས་བསྲུང་བ་ནི་ལན་བདུན་བཟླས་བརྗོད་བྱས་པའི་སྐུད་པས་༧༥བྱའོ།",
    "གཞོན་ནུའི་གདོན་ལ་ནི་རྣ་བར་བཤིབས་རི་ཏེ་བཟླས་བརྗོད་བྱས་པས་ཡིགཏོང་བར་བྱེད་དེ་༡།",
    "དབབ་པ་ནི་གུ་གུལ་གྱིས་བདུག་༡་པར་བྱའོ།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ།་",
    "ཤེཞེས་བྱ་བའི་སྒྲ་ཐོས་པར་འགྱུར་ཏེ།",
    "འོངས་ནས་རྨུགས་བྱེད་ཀྱིས་ལྡོང་རོས་སྦྱིན་པར་བྱེད་དེ།",
    "ཁ་དོག་མཚུངས་ལ་བསྐལ་པར་གནས་པར་འགྱུར་རོ།",
    "དེ་ཐོགས་པས་སྟོབས་དང་ཕ་རོལ་གནོན་པ་དཔག་ཏུ་མེད་ཅིང་བསྐལ་པར་གནས་པར་འགྱུར་རོ།",
    "འཕགས་པ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ལན་འབུམ་བཟླས་བརྗོད་བྱས་ན་དེ་ཐོགས་པས་ཡིད་ལ་གང་བསམས་པ་དེ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "མལ་སྟན་རྣམས་ཡིད་ལ་བསམས་པས་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བུའི་ཤིང་བུ་ཆུ་ཀླུང་ཆེན་པོར་བོར་ཏེ་དེ་ནས་ཉི་མ་ལ་བལྟས་ལ་ཆུ་ངོགས་ཐོསུ་བཟླས་བརྗོད་བྱས་ན་ཡིད་ལ་གང་བསམས་པ་དེ་དག་ཐམས་ཅད་འགྲུབ་ཅིང་ཚེ་ལོ་ཁྲི་ཐུབ་པར་འགྱུར་ཏེ།",
    "དབབ་པ་ནི་ལན་བདུན་བཟླས་བརྗོད་བྱས་པའི་ཆུས་བྱའོ།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ་དུར་ཁྲོད་ཀྱི་གསེག་༥༥མ་བླངས་ནས་རི་འཕགས་པ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ལན་བརྒྱད་སྟོང་བཟླས་བརྗོད་བྱས་ན་གསེག་༥མ་དེ་ཐོགས་པས་གང་ལ་བསྡིགས་པ་དེ་རྒྱས་བཏབ་པར་འགྱུར་ལ།",
    "མི་རོ་ལ་བལྟས་ཏེ་ལོངས་ཞེས་སྨྲས་ན་ལྡང་བར་འགྱུར་ཏེ་དོན་དུ་གཉེར་བའི་མཆོག་སྟོན་པར་འགྱུར་རོ།",
    "འབྲུ་མ་རུང་བར་༡༡བྱ་བར་འདོད་ན་མིའི་རུས་པའི་ཕུར་བུ་ལ་ལན་སྟོང་བཟླས་བརྗོད་བྱས་ཏེ་བཙུགས་ན་༡༢མ་རུངས་པར་འགྱུར་རོ།",
    "འོངས་ནས་གཏེར་སྦྱིན་པར་བྱེད་ལ་དེ་ཡང་མི་ཟད་པར་འགྱུར་རོ།",
    "རིག་སྔགས་ཀྱང་ལན་བརྒྱད་སྟོང་བཟླས་བརྗོད་བྱས་ལ་ཆུ་དེས་རྒྱལ་པོའམ།",
    "རྒྱལ་པོའི་བུ་ཁྲུས་བྱེད་དུ་བཅུག་ན་ཡུལ་དེ་ཅདཔལ་དང་ལྡན་པར་འགྱུར་རོ།",
    "ལན་སྟོང་བཟླས་བརྗོད་བྱས་ན་ཟླ་བ་དྲུག་ལོན་པ་ན་གནོད་སྦྱིན་གྱི་བདག་པོ་འོང་བར་འགྱུར་ཏེ།་",
    "ཡིད་ལ་ཅི་༩བསམས་པ་དེ་ཐམས་ཅད་བྱེད་ཅིང་དུས་མ་ཡིན་པར་རྩ་བ་དང་།",
    "ཏི་ན་ར་གང་འདོད་པ་རྣམས་སྦྱིན་པར་བྱེད་དོ།",
    "དབབ་པ་ནི་གུ་གུལ་ཁོགྱིས་བདུག་པར་བྱའོ།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཞག་གསུམ་ལ་༡༡སྒྱུང་བ་བྱས་ལ་གུ་གུལ་སྣ་དང་།",
    "བིལ་བ་ལྷན་ཅིག་ཏུ་སྦྱར་ཏེ་ལན་སྟོང་བཟླས་བརྗོད་བྱས་ན་ཏི་ན་ར་སྟོང་ཐོབ་པར་འགྱུར་རོ།",
    "ཟིན་པའི་འོག་ཏུ་རིག་སྔགས་བཟླས་བརྗོད་བྱེད་བཞིན་དུ་འཐུངས་ཏེ་སླར་ཐོད་པའི་ནང་དུ་སྐྱུག་ཚཔར་བྱའོ།",
    "རིག་སྔགས་བཟླས་བརྗོད་བྱས་ན་འདོད་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
    "དབབ་པ་ནི་གུ་གུལ་གྱིས་༧བདུག་པར་བྱའོ།",
    "སས་༧ནི་འབྲས་དང་ཕོལ་མིག་རྣམས་མེད་པར་འགྱུར་རོ།",
    "རྣ་བར་བཤིབས་སཏེ་བཟླས་བརྗོད་བྱས་ན་གདོན་ཐམས་ཅད་ཀྱིས་གཏོང་བར་འགྱུར་ཏེ།",
    "འོངས་ནས་རྨུགས་བྱེད་ཀྱིས་ལྡོང་རོས་སྦྱིན་པར་བྱེད་དོ།",
    "དེ་ནས་འདོད་དགུར་༥སྒྱུར་བའི་གཟུགས་ཅན་དུ་འགྱུར་ཞིང་ལྕགས་ཅན་དང་མཐུ་སྟོབས་མཉམ་ལ་བསྐལ་པར་གནས་པར་འགྱུར་རོ།",
    "ལུས་གཙང་བར་བྱས་ཏེ་༡",
    "ལན་འབུམ་བཟླས་བརྗོད་བྱས་ན་བ་ལང་བརྒྱ་ཐོབ་པར་འགྱུར་རོ།",
    "༡སྟོང་བཟླས་བརྗོད་བྱས་ན་གཏོང་བར་འགྱུར་རོ།",
    "ཞག་བཅུ་བཞི་ལ་ཞག་གསུམ་སྨྱུང་བ་ལོབྱས་ཏེ།",
    "དེ་ཐོགས་པས་ཕ་རོལ་གྱི་ཡུལ་འཁོར་འབྱེད་པར་བྱེད་ཅིང་གདོན་ཐམས་ཅད་འཇོམས་པར་བྱེད་པར་འགྱུར་ཏེ།",
    "བུམ་པ་ལ་དབབ་པ་ཡང་ནུས་པར་འགྱུར་རོ།",
    "དབྱེ་བར་བྱ་ན་ཞག་གསུམ་གྱི་བར་དུ་ཕུབ་ཚོའེམའི་སྦྱིན་སྲེག་ལན་སྟོང་རྩ་བརྒྱད་བརྒྱད་བྱས་ན་འབྱེ་ཚབར་འགྱུར་རོ།",
    "དེ་ཡང་འདོད་པ་ཐམས་ཅད་སྦྱིན་པར་བྱེད་དོ།",
    "དེ་ནས་བདག་ཉིད་ཀྱི་ཆེའི་ཚད་ཤེས་པར་འདོད་ན་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ།",
    "དེ་ཉིད་དུ་རིག་སྔགས་བཟླས་བརྗོད་བྱས་ཏེ་དེ་ཉིད་དུ་ཉལ་ན་འཇིག་རྟེན་གསུམ་ན་ཡོད་པའི་དོན་རྨི་ལམ་དུ་སྟོན་པར་འགྱུར་རོ།",
    "ཞེས་སྨྲ་ཞིང་ནམ་འཆི་བའང་༡་སྟོན་པར་བྱེད་དེ་༡།",
    "མིག་ལ་བསྔགས་༡ན་གང་བལྟས་པ་དེ་ཐོབ་པར་འགྱུར་རོ།",
    "རིག་སྔགས་བཟླས་བརྗོད་བྱས་ན་དངོས་གྲུབ་རྣམ་པ་གསུམ་དུ་འགྱུར་ཏེ།",
    "ལེགས་ལྡན་ལྷ་ཆེན་པོ་དེ་དག་ཀྱང་འབྲས་བུ་ཐོབ་པ་༨སྦྱིན་པར་བྱེད་དོ།",
    "དེ་དང་ལྷན་ཅིག་ཏུ་དེ་བཞིན་གཤེགས་པ་མཐོང་ཞིང་བསྙེན་བཀུར་༡་བྱེད་པར་འགྱུར་ཏེ།",
    "དེ་ནས་ལྷའི་གསང་བ་མངོན་སུམ་དུ་མཐོང་བར་འདོད་ན་ཞག་གསུམ་སྨྱུང་བ་བྱས་ཏེ།",
    "ཆོ་ག་འདི་ནི་བསྟེན་ཚོསྟེནས་ལོ་གཅིག་མ་ལོན་པར་ལ་སྦྱིན་པར་མི་བྱའོ།",
    "སྟོང་རྙེད་མ་བྱིན་པ་ལ་ཡང་སྦྱིན་པར་མི་བྱ་སྟེ།",
    "མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ་གནས་དབེན་པའམ།",
    "ལག་པ་གཡོན་པ་ན་རྡོ་རྗེ་ཐོགས་ལ་ལག་པ་གཡས་པ་མཆོག་སྦྱིན་པར་བྱའོ།",
    "དེའི་མདུན་དུ་བུམ་པ་མི་གནག་མིཅིང་རྩ་བ་མེད་ལ་མགྲིན་ཆིངས་ཚདང་བཅས་པ་ས་བོན་ཐམས་ཅད་ཀྱིས་གང་བར་བྱས་ཏེ་༡།",
    "བུམ་པ་དེ་ཡང་གསེར་ལས་བྱས་ལ་འགྲོན་༧༥བུ་བཀྲམ་པ་ལས་བྱས་པའི་རྡོ་རྗེའི་སྟེང་དུ་རས་དཀར་པོ་བཞག་སྟེ།",
    "དེའི་དབུས་སུ་བུམ་པ་གཞག་པར་བྱའོ།",
    "དེ་ནས་ནང་པར་བུམ་པ་དེས་བདག་ཉིད་ཁྲུས་བྱའོ།",
    "འགྲོན་བུ་ལས་བྱས་པའི་རྡོ་རྗེ་དང་གོས་དེ་ཡང་འཕགས་པ་ལག་ན་རྡོ་རྗེ་ལ་ཕུལ་ནས།",
    "ལས་འདིས་དཀྱིལ་འཁོར་གྱི་ནང་དུ་གཏོགས་པའི་རིག་སྔགས་རྣམས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "བསད་༧པར་ཡང་ནུས་པར་འགྱུར་རོ།",
    "ལྷ་རྣམས་བཅོམ་ལྡན་འདས་མ་ཡུམ་གང་སྤྱི་བོར་བཀུར་ནས་རྡོ་རྗེ་འབར་བའི་ཏིང་ངེ་འཛིན་ཐོབ་པར་གྱུར་པ་དང་།",
    "དམ་ཚིག་མི་ཤེས་པ་ལ་ནི་ཕྱག་རྒྱ་བསྟན་པར་མི་བྱའོ།",
    "དེའི་ཚེ་བཅོམ་ལྡན་འདས་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་འགྲོན་བུ་བརྒྱད་བརྒྱས་རྡོ་རྗེ་བྱས་ལ་དེའི་མདུན་དུ་ཕྱག་རྒྱ་བསྟན་པར་བྱའོ།",
    "དེ་ཡང་འབྲས་ཆན་༩བུ་རམ་དང་སྦྱར་བའི་མཆོད་ཡོན་རྡོ་རྗེ་ལ་ཕུལ་ནས་ཕྱག་རྒྱ་བསྟན་པར་བྱའོ།",
    "ངའི་གསང་བའི་ཕྱག་རྒྱའི་ཚོགས་འདི་ནི་གཙང་ཞིང་དབེན་པར་བྱས་པས་བལྟ་བར་བྱའོ།",
    "དེ་ལྟར་བྱས་ན་ལག་ན་རྡོ་རྗེས་བྱིན་པ་ཡིན་ཏེ།",
    "ཆོ་ག་རྒྱས་པ་ཡང་འགྲུབ་༥པར་འགྱུར་རོ།",
    "ཕྱག་རྒྱ་མཐོང་བ་གང་ཡིན་པ་དེ་དག་ནི་ཕྱིར་མི་ལྡོག་པ་ཡིན་པར་བལྟ་༦བར་བྱ་སྟེ།",
    "ང་མཐོང་བས་དེ་དག་ངེས་པར་ཕྱིར་ནམི་ལྡོག་པའི་འབྲས་བུ་དང་ལྡན་པར་འགྱུར་ཞིང་ལུས་དང་བྲལ་བ་ན་ལག་ན་རྡོ་རྗེའི་གནས་ཡིད་དུ་འོང་བའམབདེ་བ་ཅན་དུ་སྐྱེ་བར་འགྱུར་རོ།",
    "ཕྱག་རྒྱའི་རྣམ་པ་ལག་པའི་ཚུལ་གྱིས་བསྟན་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་གྱི་རྣམ་པ་བྲིས་པ་མཐོང་ནས་ཕྱག་རྒྱ་ཆེན་པོ་རྣམ་པ་སྣ་ཚོགས་དགོད་པར་བྱའོ།",
    "ལན་བདུན་བསྒྲུབས་པའི་ཐ་མ་ལ་མཚམས་མེད་པ་ལྔ་བྱེད་བྱེད་པས་ཀྱང་འགྲུབ་པར་འགྱུར་རོ།",
    "ཉི་མ་སྤྱང་ཀྱིས་ཟིན་པའི་ཚེ་གཏོར་མའི་ཆོ་ག་བྱས་ཏེ་སྨྱོ།",
    "དེ་ནས་མིག་རྩི་བསྒྲུབ་པར་འདོད་ན་ལིག་བུ་མིག་དང་།",
    "དེ་ནས་རལ་གྲི་བསྒྲུབ་༡པར་འདོད་ན་རལ་གྲི་འཕན་མེད་པ་བླངས་ལ།་",
    "ལག་པ་གཡས་པས་རལ་གྲི་བཟུང་སྟེ་འགུལ་བར་གྱུར་ན་གྱི་བར་དུ་རིབཟླས་བརྗོད་བྱས་ནས་འགུལ་བར་གྱུར་ཅན་ནི་གཅིག་པུ་༥གནས་པའི་རིག་སྔགས་འཆང་དུ་འགྱུར་རོ།",
    "འབར་ན་ནི་འཁོར་ནེདང་བཅས་པར་འགྱུར་ཏེ་རིག་སྔགས་འཆང་ཐམས་ཅད་ཀྱི་རྒྱལ་པོ་༧སྟོབས་དང་ཕ་རོལ་གནོན་པ་ཐོགས་པ་མེད་པར་གྱུར་པ་ནས་གཡས་པས་རལ་གྲི་བཟུང་སྟེ།",
    "འགུལ་བར་གྱུར་གྱི་བར་དུ་བཟླས་བརྗོད་བྱས་ནས་འཕགས་པར་འགྱུར་རོ།"
  ]
}