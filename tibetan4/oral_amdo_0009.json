    "དར་རྒྱས་སྐབས་སུ་གནམ་འོག་གི་མི་དང་མཉམ་དུ་ཕུན་སུམ་ཚོགས་པར་བསྐྱོད་དོ།",
    "ཀྲོའུ་ཝུན་ཝང་འབྱོན་པར་སྒུག་ནས་ད་གཟོད་ཧུར་བརྩོན་བྱེད་པ་རྣམས་ནི་མི་སེར་ཕལ་བ་རེད་ལ།",
    "ཀྲོའུ་ཝུན་ཝང་མ་འབྱོན་ཡང་ཧུར་བརྩོན་ལྷོད་མེད་བྱེད་པ་རྣམས་ནི་དཔའ་ཐུལ་ནུས་ལྡན་རྣམས་རེད་དོ།",
    "ཧན་དང་ཝེ་ཞེས་པའི་ཏ་ཧྥུ་གཉིས་ཀྱི་ཁྱིམ་གྱི་རྒྱུ་ནོར་དེ་ལ་སྦྱིན་ནའང་གལ་ཏེ་ཡིད་མི་ཚིམ་པ་ཡིན་ན་དེ་ནི་མི་ཕལ་བ་ལས་བརྒལ་སོང་བ་རེད་དོ།",
    "མནོ་བསམ་གཏོང་མི་དགོས་པར་རྟོགས་པ་ལ་སྐྱེས་ཐོབ་ཀྱི་ཤེས་རབ་རེད་དོ།",
    "དེ་དང་རི་ཀླུང་ནང་གི་མི་དཀྱུས་མ་རྣམས་དང་ཧ་ལམ་མཚུངས་སོ།",
    "པའོ་དབྱི་ཡིས་ཧྲང་ཀྲོའུ་ལ་གཡོལ་ནས་བྱང་མཚོའི་མཚོ་འགྲམ་དུ་བསྡད་ཅིང་ཀྲོའུ་ཝུན་ཝང་གིས་ཧུར་བརྩོན་ཆེད་བསྐྱེད་སྒོས་བྱས་རྗེས་བཞག་པ་ཐོས་རྗེས་སུ་ཧུར་སྐྱེད་སྒོས་སྨྲས་པ།",
    "ཅང་ཐའེ་ཀུང་གིས་ཧྲང་ཀྲོའུ་ལ་གཡོལ་ནས་ཤར་མཚོའི་འགྲམ་དུ་བསྡད་དོཀྲོའུ་ཝུན་ཝང་གིས་ཧུར་བརྩོན་ཆེར་བསྐྱེད་སྒོས་བྱས་རྗེས་བཞག་པ་ཐོས་རྗེས་སུ་ཧུར་སྐྱེད་སྒོས་སྨྲས་པ།",
    "ཆུ་ལ་ལྟད་མོ་བལྟས་ན་དེ་ལ་ཁྱད་པར་གྱི་བྱེད་ཐབས་ཡོད་དེ།",
    "ཉི་མ་དང་ཟླ་བའི་འོད་ཀྱིས་དེའི་བར་སྟོང་རེ་རེ་ལ་འཕྲོའོ།",
    "སྒྱུཙྪཱཙྪནྟི་࿄ ༧ ཡྻོ་ཨུཙྪཱཙྪཱ་༡༣༢༥ མེང་ཙིན་རེ།",
    "དབྱི་དབྱིན་ལྟ་བུའི་སེམས་མེད་ན་ནི་གོང་མའི་གོ་གནས་གཡོ་འཕྲོག་བྱས་པ་རེད་བསྡུས་དོན།",
    "རང་གི་འདུན་མ་མཐོ་རུ་གཏོང་ངོ།",
    "གང་གི་། མེང་ཅི་ཕྱོགས་སུ་འགྲོ་ཞེ་ན།",
    "གནམ་འོག་གི་ཆེས་རྒྱ་ཆེ་བའི་སྡོད་གནས་སུ་བསྡད་ལ་དེ་ལའང་རེད་དོ།",
    "གུས་བཀུར་གྱི་རྣམ་པ་ཡོད་ལ་ནང་གི་བསམ་པ་མེད་ན་སྐྱེས་བུ་དགོས་སོ།",
    "༡༣༣༨ མེང་ན་རེ།",
    "བདག་གིས་ལན་འདེབས་མི་འདོད་པ་ནི་གོ་གནས་མཐོ་བ་ལ་རྟེན་ནས་འདྲི་བ་དང་།",
    "སྐད་ཆ་འདིའི་དོན་ཅི་རེད་དམ།",
    "ལིའང་ཧུའེ་ཝང་གིས་ས་ཆ་འཕྲོག་རྩོད་བྱེད་པའི་ཆེད་དུ་མི་སེར་དེད་དེ་འཁྲུགས་པ་བྱས་པས་ཤི་རྨས་ཆེན་པོ་ཐེབས་ནས་ཕམ་ཁ་ཆེན་པོ་ཉོས་རུང་སླར་ཡང་འཁྲུག་འདོད་ལ།",
    "མེང་ཚིས་ལིའང་ཧུའེ་ཝང་གིས་ས་ཆ་འཕྲོག་རྩོད་བྱེད་ཆེད་འཁྲུག་པ་ལ་དགའ་བར་དགག་པ་མཛད་དེ་སྐབས་དེའི་རྒྱལ་ཕྲན་རྒྱལ་བོ་ལ་བྱམས་སྤྱོད་ལྡན་དགོས་པར་སྐུལ་མ་མཛད་དོ།",
    "མི་ཞིག་གིས་སྨྲས་པ།",
    "དེ་ནི་ཉེས་པ་ཆེན་པོ་ཞིག་རེད།",
    "བདག་གིས་ད་ལྟར་མི་བསད་པའི་ཚབས་ཆེན་གྱི་རང་བཞིན་ཤེས་སོ།",
    "མེང་ཅིས་ཉིན་རེ་བཞིན་བློ་སྤྱོང་བྱེད་དགོས་པའི་གལ་ཆེན་རང་བཞིན་སྨྲས་པའོ།",
    "དེ་དག་གིས་མི་རབས་མང་པོའི་སྡུན་ནས་འབད་འབུངས་ཆེན་པོས་ལས་དོན་གཉེར་བ།",
    "མི་རབས་མང་པོའི་རྗེས་སུ་དེ་དག་གི་བྱས་རྗེས་བཞག་པ་ཐོས་པའི་མི་ལ་བློ་སྐྱེད་མི་སྐྱེས་པ་མེད་དོ།",
    "སྐབས་དེའི་མྱོང་ཚོར་ཡོད་པའི་མི་ལ་སྨྲོས་ཅི་དགོས།",
    "བྱམས་སྤྱོད་ཅེས་པ་ནི་མི་ལ་སྨྲས་པ་རེད་དོ།",
    "དེ་ནི་མེས་རྒྱལ་དང་བྲལ་བའི་རྣམ་འགྱུར་རེད་ལ།",
    "སེམས་སུ་སྐྱོ་གདུང་གིས་གང་ལ་སྐྱེས་བུ་དམ་པ་ཚོ་ལ་སུན་སྣང་སྐྱེས་སོ།",
    "སླར་ཡང་སྙན་ངག་ཏུ་གཞན་གྱི་འཁང་ར་མ་ཞུ་བ་དང་རང་གི་གྲགས་པ་ལའང་མི་གནོད་ཅེས་པ་ནི་ཀྲོའུ་ཝུན་ཝང་ལ་སྨྲས་པ་རེད་དོ།",
    "རེ་ཞིག་ལ་རྒྱུ་བ་ཆད་ན་རྩྭ་ལྡུམ་གྱིས་གང་ངོ།",
    "ད་ལྟ་རྩྭ་ལྡུམ་གྱིས་ཁྱོད་ཀྱི་སེམས་བཀང་ངོ།",
    "མཁར་སྒོའི་ཤིང་རྟའི་རྗེས་ཤིན་ཏུ་ཟབ་པ་ནི་རྟ་ཁ་ཤས་སོང་བ་ལས་བྱུང་ངམ།",
    "དེ་ལྟར་བྱས་ཚེ་ཧྥེང་ཧྥུ་མ་རེད་དམ།",
    "ཧྥེང་ཧྥུ་ཞེས་པའི་མི་ཞིག་ཡོད་ལ་དེ་ནི་སྟག་བསད་པར་དགའ་མཁན་ཞིག་རེད།",
    "ཐང་སྟོང་དུ་མི་མང་པོས་སྟག་ཅིག་གི་རྗེས་སྙེག་ནས་རི་རྩ་ཞིག་ཏུ་བཅར་ནས་དེ་ལ་འཛིང་ཕོད་མཁན་མེད་དེ་བསྡད།",
    "མི་རྣམས་ཀྱིས་ཐག་རིང་ནས་ཧྥེང་ཧྥུ་མཐོང་ནས་མགྱོགས་པར་མདུན་དུ་སོང་ནས་དེ་བསུ་བ་བྱས་སོ།",
    "ཁ་ཡིས་རོ་མྱོང་བ་དང་མིག་གིས་གཟུགས་མཐོང་བ།",
    "ཡུའེ་ཀྲེང་ཙིཞེས་པ་མི་ཅི་འདྲ་ཞིག་རེད་དམ།",
    "དེ་ལས་འོད་སྟོང་འཕྲོ་ལ་དེ་མང་ཚོགས་ལ་སེམས་འགུལ་ཐེབས་པའི་སྟོབས་ཤུགས་སུ་གྱུར་ན་འཕགས་ཞེས་སྨྲ་བ་དང་།",
    "ཁོ་ལ་འཇོན་ཐང་ཅུང་ཟད་ལྡན་ནའང་སྐྱེས་བུ་དམ་པའི་མི་བྱེད་ལུགས་ཀྱི་གནས་ལུགས་མི་རྟོགས་པས་དེས་དེ་གསོད་པའི་ཆག་སྒོ་འདྲེན་ངེས་རེད་ཅེས་སོ།",
    "མི་ཞིག་གིས་མེང་ཙིར་འདྲི་རྒྱུར།",
    "ཁྱོད་ཀྱིས་མི་འདི་རྣམས་རྩྭ་ལྷམ་རྐུ་བའི་ཆེད་དུ་འོང་བ་རེད་བསམ་མམ།",
    "མི་རེ་རེ་ལའང་བསྒྲུབ་མི་འདོད་པའི་བྱ་བ་ཡོད་ལ།",
    "ས་ཞིང་རྨོ་རོགས་བྱེད་པ་དང་གཞན་ལ་རེ་བ་ཧ་ཅང་ལྕིད་ལ་རང་གི་འགན་ཁུར་ཧ་ཅང་ཡང་མོ་བྱེད་པའོ།",
