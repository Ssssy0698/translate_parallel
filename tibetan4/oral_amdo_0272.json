    "མཐའ་གཉིས་དང་བཞི་དང་བརྒྱད་དང་སྒྲོ་འདོགས་སོ་གཉིས་རྣམས་ཟུང་དུ་སྦྱར་ཏེ་དེ་དག་གི་འཛིན་སྟངས་ཐམས་ཅད་བཀག་པ་ལྟར་མི་བྱེད་པར་དེ་དག་གི་སྟེང་གི་བདེན་གྲུབ་འགོག་པའི་ཚུལ་དུ་གོ་དགོས་ན་བདེན་མེད་དུ་འཛིན་པ་དེ་གཅིག་པུས་སྤོས་མཐའ་དེ་ཐམས་ཅད་ཁེགས་ནས་དབུས་ལ་གནས་པར་འཐད་དགོས་ན་ཡང་།",
    "དེ་གཉིས་མཐའ་ཡིན་པར་ཁྱེད་རང་གིས་ཀྱང་ཁས་བླངས་ཏེ།",
    "མ་བླངས་ན་དེ་དག་ཉིད་ལ་གནས་པས་ཆོག་གི་དེ་གཉིས་ཀྱི་དབུས་ལ་གནས་པར་ཡང་ཅི་ཞིག་དགོས།",
    "སྙད་དུ་ཡོད་དོ་དོན་དམ་དུ་མེད་དོ་སྙམ་པ་ནི་དབུས་ལ་གནས་པར་འགྱུར་བར་ཐལ་ལོ།",
    "ཐལ་རང་སུའི་ལུགས་ལའང་དེ་ལྟར་ཡིན་པར་བོད་སྔ་རབས་པ་དག་འདོད་པས་མངོན་རྟོགས་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "སྒྲ་ཕྱིར་འབྲངས་ཏེ་ཅི་ཡང་མེད་པ་ཞེས་པའི་ཟོང་དེ་བྱིན་ཅིག་ཟེར་བ་ལྟར་བདག་ཅག་གིས་ཕྱིན་ཅི་ལོག་ཏུ་མི་འཛིན་ལ།",
    "ཡང་ཁྱོད་ཀྱིས་རང་རྒྱུད་པས་རྣམ་གྲངས་ཙམ་དང་ཐལ་འགྱུར་པས་རྣམ་གྲངས་མིན་པ་ཙམ་འདོད་ཟེར་པས་དེ་ལྟ་ན་དོན་དམ་སྔ་མ་ཕྱི་མར་འཇུག་པའི་སྒོ་ཡིནཞེས་ཀྱང་བྲིས་པས་དེ་ལྟར་གཉིས་སུ་དབྱེ་ཞིང་སོགས་གོང་དུ་སྨྲས་པ་དེ་ལ་ལན་བརྗོད་པ།",
    "ཐལ་རང་སུའི་ལུགས་ལའང་ཇི་ལྟར་སྣང་བའི་དངོས་པོ་རྣམས་ལ་མཐའ་བཞི་སྐྱེ་འགོག་དང་གཅིག་དུ་བྲལ་ལ་སོགས་པའི་རིགས་པའི་སྒོ་ནས་དམིགས་པ་རྣམས་རེ་རེ་ནས་འགོག་པ་ལ་སྤྲོས་བྲལ་གྱི་དོན་ཅིག་ཆར་སྒྲུབ་མ་ནུས་པས་ཐད་ཀར་བལྟས་ན་ཡུལ་བཀག་ཚུལ་ཁྱད་མེད་པ་ལྟ་བུར་སྣང་ཡང་།",
    "ཀྱང་སྒྲ་རྟོག་གི་བློ་ལ་མ་བརྟེན་པ་མེད་ལ།",
    "དེ་ལྟ་བུའི་ཚུལ་གྱིས་དམིགས་པའི་སྤྱོད་ཡུལ་ཐམས་ཅད་དམིགས་སུ་མེད་པར་བསྟན་པའི་སྒོ་ནས་མཐར་གྱིས་སྤྲོས་པ་མེད་པའི་དོན་གཏན་ལ་ཕབ་པ་ལ་ཐལ་རང་གཉིས་ཀ་མཚུངས་ཏེ།",
    "མ་ཕེབས་ན་ཐལ་འགྱུར་པ་ཡིན་ནོ་ཞེས་བརྗོད་ཀྱང་ལང་གཤེགས་ལས།",
    "ཐ་སྙད་དུ་ཡོད་པ་གཉིས་འདུ་འབྲལ་མེད་པར་བཟུང་ནས་རྣམ་པ་ཀུན་ཏུ་ཁས་ལེན་དང་བཅས་པ་རྩལ་དུ་བཏོན་ནས་བསྒྲུབ་མོད་ཀྱི་རྣམ་གྲངས་པའི་དོན་དམ་ཁས་རིགས་ལམ་རབ་གསལ་དེ་ཉིད་སྣང་བྱེད།",
    "ལེན་དང་བཅས་པ་དེ་མཐར་ཐུག་གི་གནས་ལུགས་སུ་མ་བཟུང་བར་མཐར་ཐུག་སྤྲོས་མེད་དུ་བཞེད་ཀྱང་།",
    "ཁྱོད་ཀྱིས་འོག་ཏུ།",
    "ཡུལ་ཅན་ལ་གཉིས་སྣང་ལོག་མ་ལོག་གི་རྣམ་གྲངས་ཡིན་མིན་ཀྱང་འཐད་དེ།",
    "ཁབ་ཀྱི་མིག་ལྟར་དོག་པའི་བློས་གཞུང་ཆེན་ནམ་མཁའ་འཇལ་བར་རེ་བ་ནི་ཆེས་འཁྲུལ་ལོ་ཞེས་སྐྱོན་བརྗོད་པ་ལྟར་ཁབ་མིག་ལྟ་བུའི་བློས་གཞུང་ཆེན་འཇལ་བར་མི་ནུས་པ་བདེན་ནོ།",
    "ཞེས་བདག་གིས་སྨྲ་སྟེ།",
    "རྣམ་གྲངས་དང་རྣམ་གྲངས་མིན་པའི་དོན་དམ་གཉིས་གཅིག་ཁས་བླངས་ན་གཅིག་འདོར་དགོས་པའི་དེ་གཉིས་ལ་འགལ་འདུ་ཅི་ཞིག་ཁྱོད་ཀྱིས་མཐོང་།",
    "བདག་ཅག་གིས་དེ་གཉིས་འགལ་བ་མེད་པར་མ་ཟད།",
    "མཐོང་ཀྱང་སྣང་ལ་མ་ངེས་པར་སོང་བའི་ཚིག་རང་ལ་རང་གིས་ཅོ་འདྲི་བར་སོང་ལ།",
    "རང་རྒྱུད་པས་ཕྱི་མ་འདོད་པ་ཁྱོད་ཀྱིས་རྒྱན་གྱི་ལུང་དྲངས་པས་ཁས་བླངས་མོད་ཅེས་པ་དང་།",
    "སྣང་ཚུལ་ཐ་སྙད་ལ་ཀུན་རྫོབ་ཀྱི་མིང་གིས་བསྟན་པ་དེ་ཡིན་ལ།",
    "ཐལ་འགྱུར་པའི་གཞུང་དུ་ནི།",
    "དོན་དམ་གཏན་ལ་འབེབས་བྱེད་མཐའ་བཞིའི་སྐྱེ་བ་འགོགས་པའི་རིགས་པ་གསུངས་པ་ངེས་ཀྱང་རང་རྒྱུད་པ་ལྟར་དོན་དམ་པར་སྐྱེ་བ་བཀག་ནས་ཐ་སྙད་དུ་སྐྱེ་བ་ཡོད་པར་འདོད་ན་ཐལ་རང་གི་ཁྱད་པར་ཕྱེ་བ་མེད་པར་འགྱུར་རོ།",
    "དེ་ཉིད་སྐབས་སུ་རིགས་པ་གང་ཞིག་གིས།",
    "ཁྱོད་ཀྱི་སྐྱེ་བ་གང་གི་ཡིན་པར་འགྱུར།",
    "དེའི་ཕྱིར་རང་གི་མཚན་ཉིད་ཀྱི་སྐྱེ་བ་ནི་བདེན་པ་གཉིས་ཆར་དུ་ཡང་ཡོད་པ་མ་ཡིན་ན་ ཞེས་མི་འདོད་བཞིན་དུ་ཡང་གདོན་མི་ཟ་བར་ཁས་བླང་བར་བྱའོ་ཞེས་གསུངས་པ་འདིས།",
    "ཐ་སྙད་དུ་སྐྱེ་བ་ཞེས་པ་རང་གི་ངོ་བོ་ཉིད་དམ་རང་མཚན་གྱིས་གྲུབ་པ་དེ་ནི་དོན་དམ་དཔྱོད་པས་དཔྱད་ཀྱང་མ་བཀག་པར་ཁས་བླང་བ་དེ།",
    "སྙད་དུ་ཡང་མེད་པར་གཏན་ལ་ཕབ་པའི་རིགས་པ་དེས་འདི་ལྟར་རྟེན་འབྱུང་གི་སྣང་བ་བསླ་མེད་དུ་ཡོད་པ་འདི་རྣམས་ཡེ་ནས་སྐྱེ་བ་དང་འགག་པ་མེད་པའི་རང་བཞིན་དུ་གཏན་ལ་ཕབ་པ་ཡིན་པས།",
    "ཐ་སྙད་དུ་སྐྱེ་བ་ཞེས་བྱ་བ་དོན་དམ་དཔྱོད་བྱེད་ཀྱིས་མ་ཁེགས་པ་ཞིག་ཡོད་ན་དོན་དམ་པའི་སྐྱེ་བ་མི་ཁེགས་པར་ཐལ་བ་དང་།",
    "ཐ་སྙད་བདེན་པ་རིགས་པས་དཔྱད་བཟོད་དུ་ཐལ་བ་དང་།",
    "འཕགས་པའི་མཉམ་བཞག་དངོས་པོའི་འཇིག་རྒྱུར་ཐལ་བ་གསུམ་བསྟན་ཏེ།",
    "རིགས་པ་དེ་དག་གིས་གདོད་ནས་མ་སྐྱེས་པའི་དོན་བསྟན་པ་ཡིན་ལ་གལ་ཏེ་ཐ་སྙད་དུ་ཡང་སྐྱེ་བ་མེད་ན་ཐ་སྙད་ལ་སྐུར་བ་བཏབ་པར་མི་འགྱུར་རམ་སྙམ་ན།",
    "བྲེད་ཤ་ཐོན་པ་ཐ་སྙད་ཀྱི་བདེན་པ་ལ་འདི་གང་ཞིག་ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བའི་རྒྱུར་གྱུར་པ་རྫས་ཀྱི་བདག་ཉིད་འབའ་ཞིག་སྐྱེ་བར་འགྱུར་བར་བྱ་དགོས་སོ་ཞེས་སྨྲ་ན།",
    "གཉིས་ཆར་དུ་ཡང་རང་གི་མཚན་ཉིད་ཀྱིས་སྐྱེ་བ་ཡོད་པ་མ་ཡིན་ན།",
    "དེ་དག་གི་རང་གི་ངོ་བོ་འཇིག་རྟེན་དུ་དམིགས་པར་འགྱུར་ཞེ་ན།",
    "གང་སྟོང་པ་དེ་ཐ་སྙད་དུ་ཡོད་མི་ཤེས་པ་ལྟ་བུར་སོང་ངོ།",
    "དེ་ཇི་ལྟ་བ་བཞིན་རེ་ཞིག་རྟོགས་མ་ནུས་པའི་ངོར།",
    "དེས་ན་རང་འགྲེལ་ལས་དོན་དམ་པར་སྐྱེ་བ་མེད་པས་བདག་དང་གཞན་ལས་སྐྱེས་པ་དགག་ལ་རག་མོད།",
    "གཟུགས་དང་ཚོར་བ་ལ་སོགས་པ་གང་དག་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་གིས་དམིགས་པ་དེ་དག་གི་རང་བཞིན་ནི་གདོན་མི་ཟ་བར་གཞན་ལས་སྐྱེ་བར་འགྱུར་རོ།",
    "འདི་བདེན་མོད་ཀྱི།",
    "སྟེ་ དེ་གཉིས་རྣམ་དབྱེ་གང་གིས་མི་ཤེས་པ།",
    "མོ་གཤམ་བུ་ལ་རང་གི་བདག་ཉིད་ཀྱིས།",
    "མོ་གཤམ་བུ་དང་མཚུངས་པར་ཐལ་མི་འགྱུར།",
    "དེས་ན་ཐལ་འགྱུར་པའི་ལུགས་ལ་སྤྲོས་བྲལ་མི་འདོད་པར་ད་དུང་རང་རྒྱུད་པ་ལྟར་སྐྱེ་མེད་འབའ་ཞིག་ཁས་ལེན་པའི་ཁས་ལེན་ཡོད་ན།",
    "ཐལ་རང་གི་དགག་བྱ་ལ་ཕྲ་རགས་ཕྱེས་པའང་དོན་མེད་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་ཁྱོད་ལ་འཇིག་རྟེན་མི་གནོད་ན།",
    "དེ་ལྟར་ན་ཐལ་རང་གཉིས་ཁྱད་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཐལ་འགྱུར་པས་དོན་དམ་དཔྱོད་པས་དཔྱད་ན་དཔྱད་བཟོད་དུ་ཡོད་པ་གང་ཡང་མེད་དོ།",
    "ཡོད་ན་བདེན་གྲུབ་ཏུ་འགྱུར་བས་བདེན་པ་གཉིས་ཆར་དུ་སྐྱེ་བ་མེད་ཀྱང་དེ་འདྲའི་སྐྱེ་མེད་དང་འདུ་འབྲལ་མེད་པའི་རྟེན་འབྱུང་གི་སྣང་བ་བསླུ་མེད་ཉིད་ཐ་སྙད་བདེན་པ་ཡིན་པས་ཐ་སྙད་ཀྱི་རྣམ་བཞག་ཤིན་ཏུ་ཡང་རུང་བར་མཐོང་བ་ནི།",
    "འོ་ན་ཐལ་འགྱུར་པའི་ལུགས་ལ་ཐ་སྙད་ཚད་གྲུབ་གཏན་མེད་པར་ཞལ་གྱིས་བཞེས་སམ་ཞེ་ན་འདི་ལ་སྔ་རབས་པ་ཕལམོ་ཆེས་མགྲིན་གཅིག་ཏུ་བཞེས་སོ།",
    "ཐལ་འགྱུར་པའི་ལུགས་ལ་ཐ་སྙད་ཚད་གྲུབ་འདོད་པ་ཤིན་ཏུ་མི་རིགས་ཞེས་དགག་པ་མཛད་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "ཕྱིས་ཀྱི་ཐལ་འགྱུར་པའི་མཁས་པ་དག་གིས་ཐ་སྙད་ཚད་གྲུབ་འབའ་ཞིག་ཏུ་བཞེད་མོད།",
    "སྔར་གྱི་མཁས་པ་དག་ཐལ་འགྱུར་པ་ལ་མཐའ་གཅིག་ཏུ་ཁས་ལེན་མེད་པ་དང་ཡོད་པའི་ཕྱོགས་རེ་རེ་འཛིན་པ་མཐོང་ཡང་།",
    "མཐའ་གཅིག་ཏུ་གང་རུང་རེར་བཟུང་ན་སྐྱོན་ཡོད་པས།",
    "ཞེས་ཟེར་བ་མི་འཐད་པར་ཐལ།",
    "དེ་གཉིས་མཐར་ཐུག་གི་དོན་ལ་དགོངས་པ་གཅིག་པར་འདོད་དེ།",
    "རང་རྒྱུད་པས་བདེན་མེད་མ་རྟོགས་ན་དེ་དག་གིས་ཇི་ལྟར་འདོད་པ་ལྟར་དགག་བྱ་ལ་དོན་དམ་གྱི་ཁྱད་པར་སྦྱར་ནས།",
    "ཁྱད་པར་སྦྱར་དགོས་པར་འདོད་པ་དེ་དག་གིས་བྱིས་པ་འདྲིད་པ་ལ་ཞུགས་པ་ལྟར་གྱུར་ཅེས་སྨྲ་རིགས་ཀྱི།",
    "ཁྱེད་ཅག་གིས་རང་གི་ཞེ་འདོད་ཀྱང་ལེགས་པར་བརྡའ་སྤྲོད་པར་མ་ནུས་ཏེ།",
    "ཁྱེད་ཅག་རང་གི་ཞེ་འདོད་ལེགས་པར་བརྡའ་སྤྲོད་པར་མ་ནུས་ཏེ།",
    "སྔ་མ་རྣམ་རྟོག་གི་ཕྱི་མ་མི་རྟོག་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་ཅན་ཡིན་པའི་ཁྱད་པར་གནམ་ས་ལྟར་ཆེ་བ་དེས་ཆོག་གོ།",
    "འོན་ཀྱང་དེ་གཉིས་རེ་རེས་རྟག་ཆད་མི་ཁེགས་པར་ཁས་བླངས་པ་འདིས་ཆོག་འདུག་གི་ཙམ་སྒྲ་སྦྱར་རུང་མ་སྦྱར་རུང་སྐབས་དོན་དཔྱད་བྱ་ལེགས་པར་གྲུབ་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "གང་གིས་རྟེན་ཅིང་འབྲེལ་བར་འབྱུང་།",
    "ཁྱོད་ཀྱི་རྣལ་འབྱོར་བདག་མེད་མཐོང་བ་ཡིས།",
    "ཞེས་སོགས་གསུངས་པ་མི་འཐད་པར་ཐལ།",
    "རང་གི་བདག་མེད་མཐོང་བས་ཀྱང་གནས་ལུགས་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "མཁས་པའི་ཟོབ་ཀྱི་ནང་ཆ་སྟོན་པའི་ཚིག་གི་ཕོ་ཉ་འདི་ཅི་ཕྱིར་མངགས།",
    "མཁས་པའི་ཟོབ་ཀྱི་ནང་ཆ་སྟོན་པའི་ཚིག་གི་ཕོ་ཉ་འདི་ཡང་མངགས་མི་རིགས་སོ།",
    "དེར་མ་ཟད་མཐའ་བཞིའི་སྐྱེ་བ་རིམ་ཅན་དུ་ཚིག་གི་ལམ་ནས་བཀག་ཀྱང་མཐའ་བཞིའི་སྐྱེ་མེད་གྲུབ་པ་དང་།",
    "དེ་དང་དེའི་སྐབས་སུ་མེད་དགག་གི་ཚུལ་དུ་བསྟན་པས་མཐར་ཐུག་མེད་དགག་ཁོ་ན་ཁས་ལེན་དགོས་པ་མ་ཡིན་ལ།",
    "རྣམ་གྲངས་མིན་པའི་དོན་དམ་ཉིད་དེ་དག་གིས་གཏན་ལ་དབབ་པའི་འབྲས་བུ་ཡིན་ཏེ།",
    "སྟོང་པ་ཉིད་སོགས་༡ཀྱི་མིང་གིས་བསྟན་པ་དེ་དག་ལ་རེ་རེ་བཞིན་དུ་ཆ་གཉིས་སུ་ཕྱེ་རྒྱུ་ཡོད་པ་ནི།",
    "ཡུལ་གང་དང་གང་ལ་བདག་གམ་རང་གི་ངོ་བོ་མེད་པར་མཐོང་ན་དེ་དང་དེར་ཞེན་པ་ལྡོག་གམ་མི་ལྡོག་ལྡོག་ན་བདེན་མེད་ལའང་རང་གི་ངོ་བོ་ཉིད་མེད་པས་དེར་ཞེན་ལྡོག་རིགས་ལ།",
    "ཁྱོད་ཀྱིས་དེ་ལྷག་པར་འགལ་འདུ་སྨྲ་བའི་བླུན་པོ་ཡ་མཚན་ཅན་ཞིག་ཡིན་ཞེས་ཕྱོགས་སྔར་འཚང་ཀ་མ་བྱས་སམ།",
    "ཅག་གི་མན་ངག་དེ་ནི།",
