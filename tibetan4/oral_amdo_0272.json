    "སླར་ས་ཡང་རྩོད་ཡིག་ལས་གོང་གི་འཕྲོས་སུ།",
    "གཞན་དག་བྱམས་པའི་ཐུགས་ཀྱིས་མ་བཏང་བ་དགེ་སྦྱོང་གི་ཚུལ་དང་མཐུན་ཞིང་མང་ཐོས་བསླབ་ལྡན་དག་གི་སྨོན་པའང་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "དེའི་རྗེས་སུ་ཤིས་པ་བརྗོད་པའི་མེ་ཏོག་གི་བླ་རེ་ཕྱོགས་ཀུན་ཏུ་བྲེས་པའི་ཚིགས་སུ་བཅད་པ་རྣམས་ནི་ཚིག་དང་དོན་གྱི་ཉམས་འགྱུར་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པས་བློ་ལྡན་དགའ་བ་འཕེལ་བའི་ངང་ཚུལ་ཅན་དུ་གྱུར་ཀྱང་།",
    "འདིར་ཡི་གེ་མང་དོགས་པས་མ་བྲིས་ལ་བལྟ་བར་འདོད་པ་དག་གིས་འཇམ་པའི་དབྱངས་ཀྱི་དགོངས་རྒྱན་ཉིད་དུ་ཤེས་པར་བྱའོ།",
    "བྱང་ཕྱོགས་མཁས་པའི་ཁྱུ་མཆོག་རྣམ་མང་གི།",
    "རབ་འབྱམས་གཞུང་ལུགས་སྟོང་གི་ཆུ་བོ་ཡང་།",
    "ཅིར་ཡང་བསྟན་པ་ཡོངས་ཀྱི་བཤེས་གཉེན་ཁྱོད།",
    "དམར་སེར་ཉི་གཞོན་འཆར་ཀའི་ལང་ཚོ་ཅན།",
    "དེ་ཡིས་དགེ་ལེགས་ཉིན་མོར་བྱེད་པར་མཛོད།",
    "རབ་བྱུང་བཅོ་ལྔ་པའི་ནང་ཚན་མཛེས་བྱེད་ཆུ་མོ་ཡོས་ཀྱི་གནམ་ལོ་ཤར་བའི་ས་ག་ཟླ་བའི་དམར་ཕྱོགས་ཀྱི་ཚེས་ལྔ་ནས་མགོ་བཟུང་སྟེ།",
    "འདུ་ལོང་དང་ལུས་ཁམས་རྙོགས་པ་སོགས་ཀྱི་རྐྱེན་ལས་ཚ་དྲག་གིས་བྲི་བ་མ་བྱུང་ཡང་།",
    "ཞག་བཅོ་བརྒྱད་ཀྱི་བར་དུ་ཉིན་རེའི་ཐུན་ཚོད་ཀྱི་ཆ་ལ་ཅུང་ཟད་རེ་ནར་མར་བྲིས་ནས།",
    "ཀུན་རྟོག་རྩ་སྦུར་མཆེད་པའི་མེ་སྟག་གིས།",
    "དྲི་མེད་ལྷ་རྫས་སྤྲིན་དཀར་བླ་རེ་འདི།",
    "ན་མོ་མཉྫུ་ཤྲཱི་ཡེ།",
    "གཞན་ཆུང་བ་ལྟར་གསུངས་པ་ལྟར་ཡུལ་དུས་རེ་འགར་ངེས་ཀྱང་།",
    "ཐམས་ཅད་དུ་དེ་ལྟར་ངེས་པ་མེད་མོད།",
    "ཀློང་ཆེན་པའི་གསུངས་ཚིགས་བཅད་དེའི་དོན་ཕྱོགས་མ་གོ་ཡང་དེ་ལྟར་ཡིན་མི་འདུག་པས་དགག་པ་མཛད་ཅུང་སྔ་སོང་ཡང་ཤེས་རབ་མྱུར་བའི་མངོན་རྟགས་ཙམ་ལས་སྐྱོན་ག་ལ་མངའ།",
    "གྲི་གུག་གིས་བཅད་པ་ལ་གྲི་གུར་བཅད་ཅེས་པ་ལ་སོགས་པ་བཞིན་ནོ།",
    "ཨ་ཀྱང་དོན་གོ་ན་ཚིག་གི་བརྗོད་ཚུལ་ཙམ་ལ་འཆེལ་བས་ཅི་བྱ།",
    "ཙམ་སྒྲ་ལས་འཕྲོས་ནས་རྫོགས་ལྡན་གྱི་དུས་དེ་རྟགས་ཙམ་འཛིན་པའི་དུས་སུ་ཐལ་བ་འཕང་བའི་ངག་འདིར་རྟགས་ཁྱབ་གྲུབ་ཚུལ་གསུངས་རུང་།",
    "དེ་གཟིགས་ངོར་བདེན་གཉིས་ཐ་དད་སྲད་བུ་དཀར་ནག་བསྒྲིལ་བ་ལྟ་བུའི་ཟུང་ཚོགས་སུ་ཇི་ལྟར་སྣང་།",
    "སོ་སོ་རང་གིས་རིག་པར་བྱ་བའི་དབྱིངས་སྤྲོས་བྲལ་འབའ་ཞིག་དེ་གཟིགས་པ་ལ་དོན་དམ་གཟིགས་པའི་ཐ་སྙད་སྐྱོན་མེད་ཐོབ།",
    "བདེན་གཉིས་ཐ་དད་དུ་ཞེན་པའི་དྲི་མ་སྤངས་པས་བདེན་གཉིས་ངོ་བོ་དབྱེར་མེད་དུ་གཟིགས་ཞེས་ཞལ་བཞེས་མཛད་པ་ལ་འཐད་པ་སྒྲུབ་ཏུ་མེད་ཅིང་།",
    "དོན་དམ་གཉིས་སྣང་མེད་པ་ཟུང་ཚོགས་དང་།",
    "ཁྱེད་ནི་ཚིག་གི་རྟོག་ཆེན་མཛད་པ་འདི་འདྲའི་ཐུགས་དམ་ལ་སྐུ་ཚེ་རིལ་པོར་བརྩོན་པ་མི་ལྷོད་པའི་ཀློག་པ་པ་ཡ་མཚན་ཅན་ཞིག་ལེགས་པས།",
    "ངའི་མ་མོ་གཤམ་ཡིན་ཞེས་པ་མཚུངས་པར་རང་ཚིག་གིས་བསལ།",
    "བུ་རམ་དང་ལན་ཚྭའི་རོ་མྱོང་བ་སོགས་དེ་འདྲ་ཐམས་ཅད་ལ་ཐལ་ཆེས།",
    "ཐམས་ཅད་ཤེས་རབ་དང་ལྡན་པའི་ཚིག་པྲ་བཟང་བར་གསུངས་པ་ཙམ་མོ།",
    "རྒྱང་འཕེན་པས་ལྐོག་གྱུར་རྗེས་དཔག་གིས་གཞལ་བྱར་ཡིན་པ་སྤྱིར་ངེས་ནུས་པ་དཀའ་སྟེ།",
    "ཨ་མཚར་རྩེད་མོ་ལགས་ཏེ།",
    "ཐབ་ཀར་ཐོ་བས་བརྡུང་བའི་འོ་བརྒྱལ་མཛད་ཞོར་འདི་ལ་མཁྱེན་པའི་སྤྱན་ཟུར་ཙམ་གཟིགས་རྒྱུ་བྱུང་ན་ལེགས།",
    "ཨ་མཚར་ཞུ་བ་དེ་ཙམ་སྟེ།",
    "མཁྱེན་བཟང་ཁྱོད་ཀྱི་གསུང་ཟེར་བློ་སྣང་གསལ།",
    "གཏུན་བརྡུང་མཆོག་ཏུ་ཁྱོད་གྱུར་ཅིག།",
    "ཀུན་རྨོངས་སྒྲིབ་པའི་བུད་ཤིང་ཀུན།",
    "སྲེག་བྱེད་མཆོག་ཏུ་ཁྱོད་གྱུར་ཅིག།",
    "སྒྲུབ་བརྩོན་མཆོག་ཏུ་ཁྱོད་གྱུར་ཅིག།",
    "ཐ་སྙད་ཚིག་གི་བརྗོད་ཚུལ་སྣ་ཚོགས་ཀྱང་།",
    "ཕན་བདེའི་དུས་ཀྱི་རླབས་ཕྲེང་གིས་མཛེས་ཤིང་།",
    "མང་ཐོས་ལུང་གི་གཟི་འོད་འབར་བ་དང་།",
    "འཁྲུལ་རྟོག་མཚན་མོའི་མུན་པར་སྤྱོད་པ་ཡི།",
    "རྒྱལ་བསྟན་དཔྱིད་ཀྱི་དཔལ་མོ་འཛིན་མའི་ཁྱོན།",
    "༥ རྡོ་རྗེ་འཇིགས་རྒྱུད་ལས་རྟོག་པ་ལྔ་པ་བྲིས་སྐུའི་ཆོ་ག་༦ རྡོ་རྗེ་འཇིགས་རྒྱུད་ལས་རྟོག་པ་དྲུག་པ་སྦྱིན་སྲེག་གི་ལས་ཀྱི་ཆོ་ག་༧ རྡོ་རྗེ་འཇིགས་རྒྱུད་ལས་རྟོག་པ་བདུན་པ་བསམ་གཏན་གྱིས་ལས་སྒྲུབ་པ།",
    "༢༩ ལས་རྒྱལ་མཆོག་གི་ཏིང་ངེ་འཛིན་བསྒོམ་ཚུལ།",
    "༡༢ གཏུམ་མོ་བསྒོམ་ཚུལ།",
    "༡༨ དམ་ཚིག་གི་རྣལ་འབྱོར་གྱི་རྣལ་འབྱོར།",
    "། ཁྲོ་བོ་རེག་ཚིག་གི་བསྒྲུབས་པའི་ཐབས་ཞེས་བྱ་བ། ། ཁྲོ་བོ་རེག་ཚིག་གི་བསྒྲུབ་ཐབས་རྣམས་བཞུགས། ། རྒྱ་གར་སྐད་དུ།",
    "ཕྱག་གི་ཡུལ་གཏུམ་ཆེན་རབ་འབར་གདུག་པ་འཇོམས།",
    "དམོད་པའི་སྦྱོར་བ་བྱེད་པ་ལ།",
    "འཁོར་ལོ་སྟེང་དུ་ཅུང་ཟད་མ་རེག་པར།",
    "མཆེ་བརྩིགས་ལྗགས་སྒྲིལ་གད་མོས་འདེབས།",
    "སྟག་གི་ཤམ་ཐབས་རློན་པ་སྦྲུལ་གྱིས་ཡན་ལག་བརྒྱན།",
    "ཁྲོ་བོའི་ཡེ་ཤེས་ཀྱི་ངོ་བོ་ཡི་གེ་ཧཱུཾ་གིས་མཚན་པ་ལ།",
    "ཧཱུཾ་གི་མཐའ་མར་རྩ་སྔགས་ཀྱིས་བསྐོར་བར་བསམ།",
    "རང་གི་མཐེའུ་ཆུང་གི་ཁྲུ་གང་ཚད་ལྡན་མཆོད་རྟེན་བྱ།",
