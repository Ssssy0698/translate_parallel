    "དོན་དམ་བདེན་མེད་སྤྲོས་བྲལ་དེ་སྐྱེ་འཕགས་གཉིས་ཀའི་བློའི་ཡུལ་དུ་བདག་ཅག་གིས་ཁས་བླངས་ཏེ།",
    "དེས་ན་འོག་གི་ཁས་ལེན་དྲངས་པ་ཐམས་ཅད་ལ་ལན་བཏབ་མ་དགོས་སོ།",
    "ཁྱོད་ཀྱིས་བརྩད་པ་འདི་ནི་ཁོ་བོའི་ཤེར་འགྲེལ་དུ།",
    "བདག་མེད་གཉིས་རྟོགས་ཀྱི་ཡེ་ཤེས་དེ་ཡང་རྒྱུ་ཚོགས་གཉིས་སྔོན་སོང་ལས་བྱུང་བར་འདོད་དེ།",
    "ཡེ་ཤེས་དེ་ཐབས་ཀྱི་ལྷན་ཅིག་བྱེད་རྐྱེན་དང་ཚོགས་ནས་སྔ་མ་ལས་འཕགས་པའི་ཡེ་ཤེས་ཁྱད་པར་ཅན་དུ་གྱུར་པས་ས་གོང་མ་གོང་མའི་ངོས་སྐལ་གྱི་སྤང་བྱ་སྤོང་བ་ཡིན་པས།",
    "ཉན་རང་ལ་བསྐལ་པ་གྲངས་མེད་གཅིག་གི་ཚོགས་བསགས་པ་སྔོན་དུ་སོང་བ་མེད་ཀྱང་།",
    "ཀུན་རྫོབ་བཀག་པར་གོ་བ་དེ་ནི་རིང་ནས་ཞེན་པའི་སྨྱོ་ཚབ་ཆེན་པོ་རེ་ཞིག་སངས་ངོ་མི་འཆར་བ་ཞེས་གསུངས་པ་དེར་ཤིན་ཏུ་ངེས་ཏེ།",
    "དེས་དོན་དམ་གཟིགས་པའི་ཆ་ནས་ཇི་ལྟ་བ་མཁྱེན་པ་དང་།",
    "ཀུན་རྫོབ་གཟིགས་པའི་ཆ་ནས་ཇི་སྙེད་པ་མཁྱེན་པར་འཇོག་སྟེ་ངོ་བོ་ལ་གཉིས་སུ་མེད་དོ།",
    "གནས་ལུགས་རྟོགས་པའི་བློ་དེ་ཇེ་བཟང་དུ་སོང་ཞེས་དང་།",
    "ཁོ་ན་རེ་སྒྲ་དང་བློས་བརྟག་ན་ཞེས་སྨྲས་ཤིང་།",
    "ཀྱེ་མ་རྒན་བུ་ལྔ་པའི་ལམ་དུ་བཏང་ན་དགེ་སྦྱོང་གི་ཚུལ་འཇིག་མོད།",
    "ད་རེས་འཛམ་གླིང་གི་མཁས་མི་མཁས་བགྲང་ཡས་པས་སྡིག་ཆེན་ཁུར་དུ་འཁྱེར་བའི་གྲོགས་དན་བྱེད་པར་འདུག་པས་མི་སྐྱོན་སྙམ་ནས་སེམས་དཔའ་བསྐྱེད་དེ་སྨྲས་པ།",
    "ཁྱོད་ཀྱི་འདོད་ཕུག་ད་ལྟ་ཉིད་དུ་བུག་པར་འགྱུར་རོ།",
    "ཡང་ཞི་བ་ལྷ་སོགས་ཀྱིས་དེ་ཉིད་རྩལ་དུ་འདོན་ཟེར་བ་གང་དུ་སོང་།",
    "ཞེས་པ་ངེས་མོད།",
    "ཁྱེད་ལ་དེ་བས་ཀྱང་ལྷག་པས་འདི་ལྟར་འདོན་ཏེ་གནོད་བྱེད་རིགས་པའི་ཚོགས་འཕེལ་མོ་འདྲེ་ཞིག།",
    "འོ་འོ་ཇི་སྐད་བརྗོད་པ་དེ་ནི་བདག་ཅག་གིས་ཐོས་ན་དགའ་བ་ཇི་ལྟར་རྨ་བྱས་དབྱར་རྔ་བཞིན་ནོ།",
    "སེམས་འཚུབས་ཤིང་བཞིན་རས་སྔར་ལས་ངན་ཞེས་རང་བློའི་རྣམ་རྟོག་གིས་བཏགས་པ་འབྲེལ་མེད་དེ།",
    "སྤྲོས་བྲལ་ཁས་ལེན་མེད་པ་རྟོགས་པའི་བློ་དེའི་སྤྱོད་ཡུལ་ལ་སྒྲ་དང་ཚིག་གིས་སྒྲོ་བཏགས་ནས་ཡོད་མེད་སོགས་སུ་དཔྱད་པའི་ཡུལ་མ་ཡིན་ཏེ།",
    "ནམ་མཁའ་མཚོན་གྱིས་མི་ཆོད་པ་ལྟར་སོང་བས་རྣམ་པར་རྟོག་པས་སྒོ་བཏགས་ནས་བཀལ་བའི་ཁུར་དེ་དག་ཅི་ཙམ་ཡོད་ཀྱང་སླར་བསྣམས་པར་མཛོད་ཅིག་གནས་ལུགས་བརྗོད་བྲལ་ལ་སྟོང་མི་སྟོང་སོགས་ཐ་སྙད་ཀྱིས་སྒྲོ་འདོགས་པ་མེད་དེ།",
    "ཞེས་གསུངས་པ་ལྟར་གནས་ལུགས་ནི་དམིགས་པ་ཅན་དང་ཁས་ལེན་ཅན་དག་གི་སྤོད་ཡུལ་མ་ཡིན་ཞིང་འཕགས་པ་རྣམས་ཀྱི་མཉམ་བཞག་གི་ཡུལ་སོ་སོ་རང་གིས་རིག་པར་བྱ་བ་ལ་སྟོང་མི་སྟོང་སོགས་ཁྱད་པར་དཔྱད་དུ་མེད་པར་འཇུག་འགྲེལ་ལས་གསུངས་པ་དྲངས་ཟིན་པ་བཞིན་ནོ།",
    "འོན་ཀྱང་དེ་ལྟ་བུའི་དོན་བདག་ཅག་གིས་འདི་ཞེས་ངེས་པ་མི་རྙེད་པས་མེད་དོ་ཞེས་བསམ་པར་མི་བྱ་སྟེ།",
    "འོ་ན་ཁྱོད་ལྟ་བུ་སོ་སྐྱེ་ཐ་མལ་པས་དེ་ལྟ་བུ་ཁོང་དུ་ཆུད་པ་ལའང་སུ་ཞིག་གིས་ཡིད་རྟོན་སྙམ་ན།",
    "དེ་བདེན་མོད་ཟླ་བ་གྲགས་པས་ཀྱང་སྐྱེ་མེད་ཀྱི་གནས་ལུགས་བསམ་གྱིས་མི་ཁྱབ་པ་འཕགས་པ་རྣམས་ཀྱི་མངོན་སུམ་གྱི་ཡུལ་ཡིན་ཀྱང་རིགས་པའི་ལམ་གྱི་རྗེས་སུ་འབྲངས་ནས་དེའི་ཚུལ་རྗེས་སུ་དཔག་པར་གསུངས་པ་ལྟར།",
    "རེད་མདའ་བར་ཕུལ་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "དེའི་ཕྱིར་ཐལ་འགྱུར་པའི་འཕགས་པ་ཆེན་པོ་རྣམས་ལ་མཉམ་བཞག་ན་ཁས་ལེན་ཐམས་ཅད་ཞིག་པས་རྣམ་གྲངས་མིན་པའི་དོན་དམ་དང་མཉམ་བཞག་ཁྱད་མེད།",
    "དེ་ལྟར་ཁས་བླངས་ཀྱང་རེ་ཞིག་ལ་སྐྱོན་དུ་མི་འགྱུར་ཞེས་གསུངས་ཤིང་།",
    "རེ་ཞིག་སྤྲོས་བྲལ་དུ་མ་སོང་ཡང་དངོས་པོའི་གནས་ལུགས་བདེན་གཉིས་ཟུང་འཇུག་ཡིན་པས་འགལ་བ་མེད་ཚུལ་གསུངས་པ་འདི་ནི་དེ་ཁོ་ན་ལྟར་ངེས་ཤིང་།",
    "གསུང་གཞན་རྩ་འཇུག་གི་ཊཱི་ཀ་སོགས་སུ་ཡང་རང་བཞིན་མེད་པ་དང་།",
    "ཚུལ་དེས་གནས་ལུགས་མེད་དགག་འབའ་ཞིག་ཏུ་གོ་བ་གཏན་ནས་ཁེགས་པར་སོང་ངོ།",
    "ཡ་གྱལ་གཅིག་ཏུ་བཟུང་བས་ནམ་ཡང་མེད་དགག་གི་སྤྲོས་པ་མི་ཞིག་པར་མཐོང་ངོ།",
    "ཅན་དག་གིས་དེ་ཁོ་ན་ཉིད་ཚོལ་བའི་འབེལ་གཏམ་མཛད་པ་ནི།",
    "ཁྱོད་ཀྱི་འདོད་ཕུག་ད་ལྟ་ཉིད་དུ་བུག་པར་འགྱུར་རོ་ཞེས་སྨྲས་པ་ལ།",
    "ངེད་ཀྱིས་སྨྲ་གོས་པ་མི་སྲིད་མོད་ཀྱི།",
    "དེ་འདྲའི་སྟོང་པ་དང་སྣང་བ་གཉིས་ཐ་དད་ཡ་བྲལ་དུ་མ་སོང་བར་སྣང་བ་ཉིད་སྟོང་པ།",
    "སྟོང་ཞེས་དེ་འཛིན་པའི་བློ་རེས་འཇོག་གཉིས་ཀྱིས་སོ་སོར་འཛིན་མ་དགོས་པར་སྣང་སྟོང་དབྱེར་མེད་ཀྱི་དོན་ལ་ངེས་པ་སྐྱེས་ཏེ།",
    "སྣང་བ་དང་སྟོང་པ་སོགས་ཕྱོགས་རེ་བའི་དམིགས་པ་དང་ཁས་ལེན་ཐམས་ཅད་དང་བྲལ་ཏེ།",
    "ཁས་ལེན་མེད་ཀྱང་དངོས་པོའི་གནས་ལུགས་ལ་དེ་ལས་གཞན་དུ་མི་འདུག་གོ་སྙམ་པའི་ངེས་ཤེས་ཁྱད་པར་ཅན་སྐྱེ་རྒྱུ་ཡོད་པ་འདི་ཙམ་ཞིག་མྱོང་བ་དེ་ཚིག་གི་ལམ་ནས་མཚོན་ནུས་ཀྱི།",
    "སྤྲོས་བྲལ་རྗེས་མཐུན་པ་མྱོང་ཚུལ་ནི་ཚིག་གིས་མཚོན་ནས་བསྟན་མི་ནུས་ཏེ།",
    "ཐབས་ཀྱིས་དཔེ་དོན་གྱི་ཡེ་ཤེས་དྲངས་པ་རྣམས་ལས་བདག་ལྟ་བུ་ཚིག་གི་ལམ་ལ་བརྟེན་ནས་རྗེས་དཔག་གིས་དཔྱད་པ་གཙོ་བོར་བྱེད་པ་རྣམས་ཀྱི་ཡུལ་མ་ཡིན་ནོ།",
    "བདག་ཅག་གིས་ནི་ཚུལ་འདི་རྗེ་ཙོང་ཁ་པ་ཆེན་པོའི་དགོངས་པ་མཐར་ཐུག་ཏུ་གོ་སྟེ།",
    "ནམ་ཞིག་རེས་འཇོག་མེད་པར་ཅིག་ཆར་དུ།",
    "ནམ་ཞིག་སྣང་སྟོང་རེས་འཇོག་གི་ཚུལ་དུ་འཛིན་མ་དགོས་པར།",
    "དེ་བས་ལྷག་པོར་དཔྱད་དུ་མེད་དེ་གནས་ལུགས་ཟུང་འཇུག་གི་དོན་གོ་བ་ཡིན་པས།",
    "གཞན་དག་ཕྱིའི་གཉེར་ཁ་བ་ཙམ་དུ་སོང་ཀྱང་དེ་ལྟར་ཤེས་མཁན་སུ་ཞིག་ཡོད།",
    "རེ་ཞིག་ཅེས་པའི་རྣམ་བཅད་ཀྱང་དོན་ཡོད་པ་དང་།",
    "རྣམ་གྲངས་མིན་པའི་དོན་དམ་གྱི་རང་མཚན་འཕགས་པ་ཁོ་ནའི་ཡུལ་དུ་གསུངས་པ་སོགས་ཀྱིས་ཤེས་ནུས་མོད་ཀྱང་དམ་པ་མཆོག་དེའི་གསུང་གི་ལུང་རྣམས་མང་དུ་མ་སྤྲོས་ཏེ།",
    "གསུངས་མོད་དེ་ནི་དེ་བཞིན་དུ་བདག་ཅག་གིས་ཀྱང་འདོད་དེ།",
    "ནམ་མཁའི་ཡིད་ཅན་ཐལ་བས་བྱུགས་པར་རུང་།",
    "ཅི་ཡང་མི་འཛིན་པ་དེ་ལས་གཞན་སྦྱིན་སོགས་ལམ་གྱི་རྣམ་པ་ཀུན་མི་དགོས་པར་འདོད་པ་དེའི་ཆ་ནས་ཆད་ལྟར་བཏགས་པ་ཡིན་ཀྱང་དེང་སང་འཛིན་མེད་ལ་ཆད་ལྟར་བརྗོད་པ་དེ་དག་གིས་ནི་ཆད་ལྟ་ཁོ་རང་ཡང་ངོས་ཟིན་མི་སྣང་ན།",
    "ཕྱིས་ཀྱི་མཁས་པ་དག་གིས་བདེན་མེད་འབའ་ཞིག་ཏུ་འཛིན་པ་ལ་ཆད་ལྟ་ཞེས་རྒོལ་ཀྱང་།",
    "ཐ་སྙད་དཔྱད་བཟོད་མེད་པ་ལ་བདེན་སྟོང་དུ་མ་གོ་བར་དགག་བྱ་ཡན་གར་བ་བཀག་པའི་བདེན་མེད་དང་དེ་ལ་གནས་ལུགས་མཐར་ཐུག་ཏུ་བཟུང་ན་གནས་ལུགས་ནི་སྟོང་རྐྱང་འབའ་ཞིག་ཏུ་སོང་བས་ཀུན་རྫོབ་ཀྱི་ཕྱོགས་སྤང་བའི་ཆད་ལྟར་འགྱུར་རོ།",
    "དམིགས་པ་ཐེག་ཆེན་ནས་བསྟན་པའི་དོན་ལ་མོས་ཤིང་།",
    "སྤངས་པའི་རང་གི་མཚན་ཉིད་དོ།",
    "མཐར་ཐུག་གི་འབྲས་བུ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གཏོད་པར་བྱེད་པ་ལྔར་གསུངས་སོ།",
    "བ་སྤུའི་རྩེ་མོ་གཡོ་བ་ཙམ་གྱི་སོམ་ཉི་ཡང་བསྐྱེད་པར་མི་ནུས་ཏེ།",
    "མེད་དགག་གི་སྟེང་ནས་སྤྲོས་བྲལ་ལ་ཡང་འཇུག་པ་ཡོད་ཀྱི།",
    "ཟེར་བ་གང་དུ་སོང་ཞེས་ཟེར་བ་གང་དུའང་མ་སོང་སྟེ།",
    "གཞན་ལ་འདི་སོམས་ཤིག་ཅེས་གདམས་པ་དེ་ནི་ཉིད་རང་གིས་ཐུགས་བསམ་ཡང་ཡང་མཛད་པར་རིགས་སོ་ཞེས་སླར་འབུལ་ན་དགྱེས་པར་བཞེས་སུ་གསོལ་ལོ་གཞན་ཡང་འདི་སྐད་དུ།",
    "ཟག་མེད་བདེ་བའི་ལང་ཚོ་བགྲེས་རྒུད་དང་།",
    "ཕྱོགས་སྔ་ཕྱི་གཉིས་ཀས་བདེན་པ་ཅི་རིགས་མཐོང་ནས་གྲོལ་བར་གསུངས་མོད།",
    "འགལ་འཁྲུལ་མཐའ་ཡས་པ་སུ་ཞིག་གིས་འགོད་པར་ནུས་ཏེ་དོར་བར་བྱ་བ་ཁོ་ནའོ།",
    "རྣམ་དཔྱོད་པིར་གྱིས་རྨོངས་འཁྲུལ་རི་མོ་བྲིས།",
    "མོ་གཤམ་བུ་ཡི་ལྕམ་དུ་དེང་སྦྲེལ་ལོ།",
    "ཞེས་པ་བདག་ཅག་གི་ལུགས་ལ་བསྒྱུར་དགོས་པ་གང་ཡང་མི་འདུག་སྟེ།",
    "བདག་ཅག་གི་གཞུང་གང་དུའང་བདེན་གྲུབ་སོགས་ཀྱི་ཁྱད་པར་མ་སྦྱར་རུང་།",
    "ཁྱེད་ཀྱི་སུན་འབྱིན་དེ་དག་ནི་ཁྱོད་རང་གི་ཚིགས་བཅད་ཀྱི་དོན་ལྟར།",
    "མོ་གཤམ་གྱི་བུ་ཡོད་མ་མྱོང་ན་དེའི་ལྕམ་ཞིག་གསར་དུ་བསྐྲུན་པའི་བཟོ་བོ་ཞིག་ཡོད་པ་མི་སྲིད་པའི་དཔེ་ལྟར་སུན་འབྱིན་དེས་ཀྱང་ཅུང་ཟད་གནོད་པ་མ་བྱས་པར་གསལ་ལོ།",
    "རྩ་བ་བཟང་པོ་ལས་སྐྱེས་མེ་ཏོག་གི།",
    "དམ་པ་ཞེས་པ་མི་རིགས་པར་ཐལ།",
    "སྣ་ཚོགས་འདི་གསུངས་པ་ཞེས་པའང་མི་འཐད་པར་ཐལ།",
    "ཟབ་མོ་ཕྲ་མོའི་ཚུལ་བསྟན་པ།",
    "འཇུག་པ་རྣམ་པ་དྲུག་གིས་ཏེ།",
    "ཚིག་བྲལ་ངག་གི་ལམ་གྱིས་མ་གོས་པ།",
    "གང་གིས་རྒྱུ་དང་བྱ་བ་བཟང་ཤེས་པ།",
    "ཞེས་གསུངས་པས་དམིགས་པ་ཅན་ཞིག་རྟོག་གེའི་ཡུལ་དུ་གྱུར་པ་ལ་ཟབ་མོ་དཔག་པར་དཀའ་བ་ཞེས་ཅི་ཡང་མི་འདུག་པས་རྟོག་གེ་ཀུན་ལས་འདས་པ་ཞེས་གསུངས་སོ།",
    "ཞེས་གསུངས་པ་འདི་རྣམས་ཁྱོད་ཀྱི་གོང་འོག་ཏུ་སྨོས་པའི་སུན་འབྱིན་དེ་དག་གི་ཕྱོགས་སྔར་བྱས་པའི་ཕྱིར་ན།",
    "སྣང་བརྟག་གཅིག་ཏུ་བསྲེས་ནས་མིང་དང་ཚིག་གི་སྒོ་ནས་བརྗོད་བྱའི་དོན་ཐམས་ཅད་བརྗོད་ཅིང་རྟོགས་སུ་རུང་བ་ཐ་སྙད་སྤྱི་ཡི་འགྲོ་ལུགས་ཡིན་པ་མ་ཤེས་པར་སྒྲས་དངོས་སུ་བརྗོད་མི་ནུས་པ་ལ་བསམ་ན།",
    "དེ་བས་ན་ཁྱོད་ཀྱིས་ཁ་ནས་ཚིག་ཏུ་བརྗོད་རྒྱུ་ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུང་།",
    "དོན་དམ་ལ་དམིགས་པ་ཅན་གྱི་སྤྱོད་ཡུལ་འདི་དང་འདི་ལྟ་བུའོ་ཞེས་བརྗོད་དུ་ཡོད་མེད་ནོར་ནས་གཞན་ལ་བརྒལ་བ་ནི་གཞན་ལུགས་ལ་གནོད་པ་ཅུང་ཟད་མ་ནུས་པའི་སྟེང་དུ་ཁྱེད་རང་གི་བློ་གྲོས་ཀྱི་རང་མཚང་བསྟན་པ་དགོད་བྲོ་བའི་ཚུལ་དུ་སོང་ངོ།",
    "ཚིག་དེ་དག་གིས་བསྟན་དོན་གོ་བ་ག་ལ་སྲིད་དེ།",
    "སོར་མོའི་རྩེ་མོས་ཟླ་བ་བསྟན་པ་ན་ཟླ་བ་ལ་མི་ལྟ་བར་སོར་རྩེ་ལ་བལྟ་བ་ལྟར་གྱུར་པའི་ཕྱིར་ན།",
