    "འོ་ན་ཅི་ཞེ་ན་འདི་ལ་ཡང་ངོ་ཞེས་པ་ཡང་གི་སྒྲའི་དོན་ཏོ།",
    "དེ་ལས་ཀྱང་གཅིག་ཁོ་ན་དཔེ་གཉིས་ཀ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་ཐལ་བར་འགྱུར་བས་ཅི་ཡིན་ཞེ་ན།",
    "གང་གི་ཕྱིར་འདི་ལྟར་ཞེས་པ་ལ་སོགས་པས།",
    "དེ་མེད་ན་དཔེ་ལ་གོ་བར་བྱེད་པ་ཉིད་མེད་དོ་ཞེས་པ་ངག་གི་དོན་ཏོ།",
    "དེ་ཡང་ཡན་ལག་ཐམས་ཅད་ཀྱི་ཐུན་མོང་བའོ་ཞེས་པས།",
    "གང་གི་ཕྱིར་ཡན་ལག་ཐམས་ཅད་ཅེས་པ་ལ་སོགས་པས་དེའི་རྣམ་གྲངས་ཉིད་སྟོན་པར་བྱེད་དོ།",
    "ཡན་ལག་གི་སྒྲ་ནི་ཡན་ལག་ཐམས་ཅད་ཀྱི་རྣམ་གྲངས་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་འདི་འཐོབ་པར་ནུས་པ་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "སྤྱི་དང་འདུ་བ་དག་གི་ཡང་མ་ཡིན་ཏེ།",
    "གང་དུ་བྱས་པ་ཉིད་ལ་སོགས་པ་ནང་དུ་འདུས་པར་འགྱུར་བ་ཚིག་གི་དོན་དྲུག་ལས་གཞན་པའི་དངོས་པོ་ཡོད་པ་ཡང་མ་ཡིན་ནོ།",
    "གཞན་རྣམས་ནི་ཞེས་པ་ཟླ་བའི་རི་མོ་པ་རྣམས་སོ།",
    "ངག་གི་ཡན་ལག་ཉིད་ཉམས་པར་འགྱུར་རོ་ཞེས་བསམས་ནས།",
    "འདི་ལ་ཡང་ཞེས་པའི་ཡང་གི་སྒྲ་དེ་ནི།",
    "དཔེ་བརྗོད་ནི་ངག་གི་ཡན་ལག་སྟེ།",
    "དེ་ལྟར་འགྱུར་མོད་ཀྱི།",
    "ཕྱིའི་དོན་ཉེ་བར་སྡུད་པ་ལ་ནི་ཐལ་བར་འགྱུར་བ་འདི་མེད་དེ།",
    "རང་གི་རྟེན་ལ་ངེས་པའོ།",
    "སྤྱི་ཡང་གཏན་ཚིགས་ཉིད་ཀྱིས་བརྗོད་དོ་ཞེས་བརྗོད་པར་བྱ་ཞེས་པ་ནི་ཀྱང་གི་སྒྲ་ལས་སོ་ཞེས་པའོ།",
    "གཞན་རྣམས་ནི་དང་གི་སྒྲ་འདིར་རྣམ་པར་བརྟག་པའི་དོན་ཏོ་ཞེས་སྨྲའོ།",
    "གང་གི་གང་ན་འགལ་བ་ཡོད་པ་ན་དེ་ན་སྲིད་པ་མ་ཡིན་ཏེ།",
    "དཔེར་ན་མེ་ལ་གྲང་བའི་རེག་པ་བཞིན་སྒྲ་ལ་ཡང་མ་བྱས་པ་ཉིད་དང་འགལ་བ་བྱས་པ་ཉིད་ཡོད་དོ་ཞེས་པ་རང་བཞིན་འགལ་བའོ།",
    "ཞེས་པ་ཐུན་མོང་མ་ཡིན་པས་ཀྱང་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "རྩོལ་མ་ཐག་ཏུ་བྱུང་བ་ཉིད་ཀྱི་ཕྱིར་མི་རྟག་པའོ་ཞེས་པའི་སྦྱོར་བ་འདི་ལ་ཡང་རྟག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་རྟག་པ་ལ་མ་བྱས་པ་ཉིད་ཁོ་ན་གཅིག་པུ་གཏན་ཚིགས་སུ་འགྱུར་ན་དེ་མེད་པ་ན་མེད་པར་འགྱུར་མོད།",
    "དེ་ཡང་མེད་དེ་གང་གི་ཕྱིར་སྐྱེ་བ་དང་ལྡན་པ་ཉིད་མ་ཡིན་པ་ལ་སོགས་པ་རྣམས་ཀྱང་རྟག་པ་ཉིད་ཀྱི་གཏན་ཚིགས་འདོད་པས་སོ།",
    "གང་གི་ཕྱིར་ཞེས་པ་ལ་སོགས་པའོ།",
    "འདིས་ནི་རང་གི་ཚིག་ཁོ་ནས་མཇུག་སྡུད་ཡན་ལག་གཞན་ཉིད་བསལ་ལོ་ཞེས་སྟོན་ཏོ།",
    "ལན་ཅིག་མ་ཡིན་པར་བརྗོད་པ་ནི་ཡིན་ལ་མཐའ་ཡས་པར་འགྱུར་རོ།",
    "བུམ་པ་བཞིན་ཞེས་པའི་དཔེ་འདི་མངོན་སུམ་མོ།",
    "གལ་ཏེ་རྣམ་པ་གཞན་དུ་རྟོགས་པ་མི་འབྱུང་ན་ཐམས་ཅད་ལེགས་མོད།",
    "དེ་ལྟར་དམ་བཅའ་བ་ལ་སོགས་པ་རྣམས་ཁོ་ན་རེ་ཞིག་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་འཐད་པ་མ་ཡིན་ན།",
    "ནམ་མཁའ་དཔེར་ན་ཐལ་བའམ།",
    "ངག་གི་ཕྱོགས་གཅིག་ཉིད་ཀྱང་མིན།",
    "ངག་གི་ཡན་ལག་ཉིད་མི་རིགས་སོ་ཞེས་པ།",
    "བསྒྲུབ་པར་བྱ་བ་སྒྲུབ་པར་བྱེད་པའི་ནུས་པའི་རང་གི་ངོ་བོར་བརྗོད་པར་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བ་སྒྲུབ་པར་བྱེད་པར་ནུས་པའི་རང་གི་ངོ་བོ་དག་མི་སྲིད་པ་དག་ཅེས་པའི་དོན་ཏོ།",
    "དོན་གྱི་གོ་བ་ལ་སོགས་པ་རྣམས་འབའ་ཞིག་ཏུ་མ་ཟད་དོ་ཞེས་པ་ཡང་གི་སྒྲའི་དོན་ཏོ།",
    "ཇི་ལྟར་བྱིས་པ་ཉིད་ལ་སོགས་པའི་རྟགས་ནི་ཚུལ་གསུམ་དང་ལྡན་པ་ལས་རང་གི་དོན་གསལ་བར་བྱེད་པ་དེ་བཞིན་སྒྲ་ཡང་ངོ་ཞེས་པའི་དོན་ཏོ།",
    "དེའི་ཡན་ལག་གང་གིས་ཞེས་པ།",
    "བྱས་པ་ཉིད་ལ་སོགས་པའི་རྟགས་ནི་དོན་གཞན་རྣམ་པར་གཅོད་པས་རང་གི་དོན་རྟོགས་པར་བྱེད་དོ་ཞེས་སྔར་འདི་བསྒྲུབས་ཟིན་ཏོ།",
    "བྱས་པ་ཉིད་ལ་སོགས་པའི་རྟགས་ནི་དོན་གཞན་ལས་ལྡོག་པས་རང་གི་དོན་རྟོགས་པར་བྱེད་ཅིང་།",
    "སླར་ཡང་སྐབས་གཞན་གྱིས་འདིའི་དོགས་པ་བསལ་བར་བྱེད་པར་འགྱུར་རོ་ཞེས་རེ་ཞིག་གཞག་གོ།",
    "རེ་ཞིག་སྤྱི་ལ་མ་ཡིན་ཏེ་དེ་ལས་ཐ་སྙད་དུ་མི་རིགས་པའི་ཕྱིར་རོ།",
    "འདི་དག་གིས་དོན་ཡོངས་སུ་བཅད་ནས་འཇུག་པ་ན་དོན་བྱ་བ་ལ་སླུ་བ་མེད་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པའི་ཕྱིར་རོ།",
    "དཔའ་བ་ཉིད་ལ་སོགས་པའི་ཡོན་ཏན་གྱི་ཁྱད་པར་ནི་སེང་གེ་དང་བྲམ་ཟེའི་ཁྱེའུ་དག་གི་ཐ་དད་མེད་པར་ཉེ་བར་གདགས་པའི་རྒྱུར་འགྱུར་ཞིང་ཐ་སྙད་ཀྱི་རྒྱུར་འགྱུར་ཏེ།",
    "རང་གི་ཁྱད་པར་རྣམས་ཤེས་པ་རང་གི་སྟེ་རིགས་ཀྱི་ཁྱད་པར་རྣམས་ཏེ།",
    "རིགས་གང་གིས་སྒྲ་གང་གི་ཐ་སྙད་དུ་སྟོན་པའི་རྒྱུ་ཡིན་པ་དེ་ནི་དེའི་རང་གི་བར་འགྱུར་རོ།",
    "གལ་ཏེ་རིགས་ཀྱི་སྒྲས་རང་གི་ཁྱད་པར་མ་ལུས་པ་བརྗོད་ན།",
    "དོགས་པ་དང་བཅས་པ་ཉིད་ཀྱི་ཕྱིར་ཡོངས་སུ་མ་རྫོགས་པའི་ངག་ཅེས་པས་ན་འཆད་པར་འགྱུར་བའི་ཚིག་གིས་དོགས་པ་རྣམ་པར་གཅོད་པར་སྟོན་ཏོ།",
    "དཔེར་ན་མཐོ་རིས་སུ་སོང་བའི་ནག་པ་ལ་སོགས་པ་རྣམས་བཞིན།",
    "རང་གི་ངོ་བོ་ཙམ་རྟོགས་པའི་ཕྱིར་རོ་ཞེས་པ་དཔེ་གསལ་བར་བྱེད་པ་སྟེ།",
    "ཀླ་ཀློའི་སྒྲ་ལ་ནི་སྒྲའི་རང་གི་ངོ་བོ་ཙམ་ཁོ་ན་རྟོགས་ཀྱི་དོན་ནི་མ་ཡིན་པས་སོ།",
    "འདི་ལྟ་སྟེ་གཞལ་བྱ་ཉིད་རྟག་པ་དང་མི་རྟག་པ་དག་གི་བཞིན་རིགས་ཀྱི་སྒྲ་ཡང་ཁྱད་པར་རྣམས་ལ་དེ་ལྟ་བུའོ་ཞེས་རང་བཞིན་འགལ་བ་གསུངས་སོ།",
    "འོ་ན་རིགས་ཀྱི་སྒྲ་ལས་རང་གི་ཁྱད་པར་ཐམས་ཅད་རྟོགས་པ་མ་ཡིན་ནམ།",
    "རང་གི་ཁྱད་པར་ཐམས་ཅད་མེད་པ་ན་ནམ་ཡང་།",
    "རིགས་ཀྱི་སྒྲས་ཁྱད་པར་དང་ཁྱད་པར་མེད་པའི་ངོ་བོ་ལ་རེག་པས་རྟོགས་པར་བྱ་བ་ནི་མ་ཡིན་ཞིང་།",
    "གང་སྒྲས་བརྗོད་པར་བྱ་བ་ཁྱད་པར་མཐའ་དག་གི་ངོ་བོ་ཞེས་བྱ་བ་དེ་རྣམས་ཀྱི་སྤྱི་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེ་རྣམས་ཁོ་ནའི་རིགས་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འབྲེལ་པ་རང་གི་རྟེན་ལ་འཕྲོད་པ་འདུ་བ་ཡང་འཁྲུལ་པ་ཡང་མེད་པ་ཁོ་ནའོ།",
    "ཐ་དད་པའི་དོན་ཅན་གྱི་བྱེ་བྲག་གི་སྒྲ་རྣམས་སོ།",
    "ཡང་ན་གང་གིས་ཐ་དད་པའི་དོན་ཅན་རྣམས་དང་གཞི་མཐུན་པ་ཉིད་ཡིན་པ་དེ་ནི་རིགས་དང་སྦྱོར་བ་བརྗོད་པ་མ་ཡིན་ཏེ།",
    "འོ་ན་གང་གི་ཚེ་ཡོད་པ་ཉིད་ཙམ་བརྗོད་པར་འདོད་པ་ཉིད་ཀྱི་ཕྱིར་ལྡན་པའི་དོན་ཅན་མི་འཐད་པ་དེའི་ཚེ་འཐོབ་པ་མ་ཡིན་ནོ།",
    "འབྲེལ་པའི་སྒྲས་ཀྱང་རེ་ཞིག་འབྲེལ་པ་ཡོད་པ་བརྗོད་པར་བྱ་བ་མ་ཡིན་ན།",
    "དེ་ལྟར་ཞེས་པ་ལ་སོགས་པ་འདིར་སྒྲའི་དོན་འགའ་ཞིག་སྒྲ་འགའ་ཞིག་གིས་བརྗོད་པར་བྱ་བཞིན་པ་ནི་འབྲེལ་པ་ཅན་གཞན་ལ་དོགས་པ་ཉེ་བར་སྐྱེ་བའི་རྒྱུ་སྟེ།",
    "རྟའི་འམ་བ་ལང་གི་རིགས་སོ་ཞེས་པའོ་ཞེ་ན།",
    "འབྲེལ་པ་ནི་འབྲེལ་པ་ཅན་ཉིད་ཡིན་ན་རང་གི་ངོ་བོ་ཉམས་པ་ཁོ་ནའོ་འབྲེལ་པ་གཞན་མེད་ན།",
    "དེ་ལྟ་ན་ཡང་ཐུག་པ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཡོད་པའི་སྒྲས་ཀྱང་འབྲེལ་པ་ཅན་ཉིད་དུ་བརྗོད་པར་བྱའོ་ཞེས་རེས་འགའ་ཕ་རོལ་པོས་ཁས་ལེན་པ་ན་བྱེད་པས་ན་དོགས་པར་བྱས་ནས་དགག་པར་བརྗོད་དོ་ཞེས་སྟོན་ཏོ།",
    "རང་གི་ངོ་བོས་ནི་འབྲེལ་པ་རྗོད་པར་བྱེད་པའི་སྒྲ་མེད་དོ་ཞེས་པའོ།",
    "འདི་སྟེ་ཞེས་པ་བསྙེགས་པར་རུང་བའི་ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པ་མ་ཡིན་པར་གྱུར་པ་ཉིད་ཀྱི་ཕྱིར་རང་གི་ངོ་བོ་བརྗོད་པའི་ངོར་དོགས་པ་མེད་པ་ཁོ་ན་སྟེ།",
    "བྱེ་བྲག་གི་སྒྲ་རྣམས་ཀྱིས་ཞེས་པ་ལ་སོགས་པས་སྐྱོན་སྔ་མ་མེད་པ་ལས་ཕྱོགས་གཞན་དགོད་པའོ།",
    "རྫས་ལ་སོགས་པ་རྣམས་ནི་བྱེ་བྲག་གི་སྒྲ་རྣམས་སོ།",
    "རིགས་དང་རང་གི་ངོ་བོ་ཡང་ཞེས་ཟླས་དབྱེ་བའོ།",
    "རང་གི་ངོ་བོའི་སྒྲས་སྒྲའི་རང་གི་ངོ་བོ་གསུངས་སོ།",
    "ཡང་ཅི་ལྟར་ན་རང་གི་ངོ་བོ་རྫས་ཀྱི་ཞར་ལ་བྱུང་བ་ཡིན།",
    "སྒྲ་ནི་རང་གི་ངོ་བོས་ཁྱད་པར་དུ་བྱས་པའི་རིགས་བརྗོད་ཅིང་།",
    "དེ་ལ་ཕྱིས་ཀྱི་དུས་སུ་སྒྲའི་རང་གི་ངོ་བོས་ཁྱད་པར་དུ་བྱས་པའི་རྫས་སོ་ཞེ་ན།",
    "ཕན་འདོགས་པ་དང་ཕན་འདོགས་པ་ཅན་རྣམས་ནི་ཕན་འདོགས་པ་ཅན་རང་གི་ཁྱད་པར་དུ་བྱེད་པ་ལ་ལྟོས་པ་ཅན་གྱིར་འགྱུར་ཏེ།",
    "དཔེར་ན་རབ་ཏུ་མྱོས་མ་ནི་རང་གི་འགྲམ་པ་བྱུག་པ་ལ་སོགས་པའི་འདུ་བྱ་བ་སྔོན་དུ་སྒྲུབ་ཅིང་།",
    "དེ་བཞིན་དུ་འདིར་ཡང་ཐལ་བར་འགྱུར་རོ་ཞེས་པ་བསྒྲུབ་པར་བྱ་བ་ལ་དཔེ་ལ་བསྒྲུབ་པའི་དོན་ཉེ་བར་སྦྱོར་བར་བྱེད་དེ།",
    "དེ་བཞིན་དུ་གང་རྣམས་གང་གིས་བརྗོད་པར་བྱ་བའི་ཁྱད་པར་རྗོད་པར་བྱེད་པ་རྣམས་སུ་མི་འགྱུར་བ་དེ་རྣམས་དང་དེ་གཞི་མཐུན་པ་ཉིད་དུ་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "རང་གི་ངོ་བོ་ཞེས་པ་གང་རྣམས་སྒྲའི་རང་གི་ངོ་བོ་བརྗོད་པར་བྱ་བར་འདོད་པ་དེའི་ལུགས་ཀྱིས་སོ།",
    "རང་གི་ངོ་བོ་ནི་མ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོ་བརྗོད་པར་བྱ་བར་སྨྲ་བ་རྣམས་ཀྱི་ནི་རིགས་ལ་ཡང་ཉེ་བར་བཏགས་པའོ།",
    "འོ་ན་ཕ་རོལ་ལ་ཡང་དེའི་ཁྱད་པར་དུ་བྱེད་པའི་རང་གི་ངོ་བོ་དོན་དམ་པར་མེད་པ་ཁོ་ན་མ་ཡིན་ནམ།",
    "བརྗོད་པར་བྱ་བའི་ངོ་བོ་གཞན་མེད་པའི་ཕྱིར་བརྗེད་པར་བྱ་བ་མེད་པར་ཐལ་བ་ལ།",
    "རིགས་ལ་སོགས་པ་རྣམས་ཀྱི་ངོ་བོ་རང་གི་རྟེན་དང་མཚན་ཉིད་མི་མཐུན་པ་ཅུང་ཟད་ཀྱང་ཉེ་བར་དམིགས་པ་མ་ཡིན་པ་སྟེ།",
    "དེའི་ཕྱིར་དེ་དག་གི་འདྲེ་བ་གྲུབ་པ་ཁོ་ན་འདྲེ་བ་ཉིད་དོ་ཞེས་སེམས་པར་འགྱུར་བས་འདྲི་སྟེ།",
    "དངོས་དང་ཉེ་བར་བཏགས་པའི་སྒྲ་གཅིག་གི་བརྗོད་པར་བྱ་བའི་ཕྱིར་རོ་ཞེས་བྱའོ།",
    "ཡང་ཅི་ལྟར་རྗེ་བོ་དང་འབངས་དག་དངོས་དང་བཏགས་པའི་སྒྲ་གཅིག་གི་བརྗོད་པར་བྱ་བ་ཉིད་ཡིན།",
    "བྲམ་ཟེའི་ཁྱེའུ་གཅིག་མ་ཡིན་པའི་ཚིག་གི་རྟོགས་པར་བྱ་བ་ཉིད་ན་ནི།",
    "དེ་ལྟར་འགྱུར་མོད་ཀྱི་ཡོད་པ་ཉིད་ནི་ཐ་མི་དད་པའི་ངོ་བོ་ཉིད་ཀྱི་ཕྱིར་དེ་ཁོ་ན་ལ་ཐ་མི་དད་པའི་ཡོད་པའི་སྒྲ་རིགས་ཀྱི།",
    "གཉིས་ཀ་ལ་འབྲས་བུར་ཐལ་བར་འགྱུར་ཏེ།",
    "དེ་དང་ལྡན་པ་ཡོན་ཏན་གྱི་རང་གི་ངོ་བོར་འགྱུར་ན།",
    "ཉེ་བ་མ་ཡིན་པའི་དངོས་པོའི་རང་གི་ངོ་བོ་ལས་ཤེས་པ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "ཡང་ཅིའི་ཕྱིར་ཡོན་ཏན་རབ་ཏུ་གྱུར་པ་ལ་ལྟོས་པ་མེད་པར་རྫས་ལ་རབ་ཏུ་བྱུང་བའི་བློར་ཐལ་བར་འགྱུར་ཞེ་ན་གསུངས་པ།",
    "རང་གི་ངོ་བོ་ཙམ་གྱིས་སྨྲ་བར་རམ་རྟོགས་པར་ནུས་པ་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར།",
    "གཞན་དུ་ན་གལ་ཏེ་རང་གི་རྟེན་ལ་མ་བཟུང་བའི་ཡང་བ་ལང་ཉིད་ལ་སོགས་པའི་རིགས་ཀྱིས་བ་ལང་ལ་སོགས་པ་རྟོགས་པར་བྱེད་ན་གང་གི་ཚེ་འདི་ནི་རྫས་ཅི་ཞིག་གོ་ཞེས་རྫས་ཙམ་ཉེ་བར་དམིགས་པ་ན་བ་ལང་ཉིད་ལ་སོགས་པ་རྣམས་གཟུང་བྱ་མ་ཡིན་པ་དེའི་ཚེ་ཡང་བ་ལང་ལ་སོགས་པ་ངེས་པར་འགྱུར་ན་འགྱུར་བ་ཡང་མ་ཡིན་ནོ།",
    "ལོག་པའི་ཤེས་པར་ཐལ་བར་འགྱུར།",
    "དེ་འདིས་ནི་གང་ཞིག་དོན་ཇི་ལྟ་བ་བཞིན་པའི་རྟོགས་པའི་ཡུལ་དེ་ནི་ཁྱད་པར་དུ་བྱེད་པའི་རང་གི་ངོ་བོ་མ་ཡིན་ཏེ།",
    "ཁྱབ་པ་མེད་པར་འདི་ལ་དོགས་པར་བྱ་བ་མ་ཡིན་ཞིང་དོན་ཇི་ལྟ་བ་བཞིན་མ་ཡིན་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བ་ནི་མི་འདོད་པ་ཉིད་དོ།",
    "གང་གི་ཚེ་དུས་གཅིག་ཏུ་རྟོགས་པ་པོ་མང་པོ་རྣམས་ཁྱད་པར་ཐ་དད་པ་རྣམས་ཀྱི་དོན་གཅིག་རྟོགས་པར་བྱེད་པ་དེའི་ཚེ།",
    "དེ་ལ་རེ་ཞིག་རེ་རེ་ཁོ་ནའི་མ་ཡིན་ཏེ།",
    "རྟོགས་པ་པོ་གཅིག་གི་ངོར་ཁྱད་པར་གཅིག་ཁོ་ནའི་ངོ་བོའི་རྗེས་སུ་བྱེད་པ་མ་ཡིན་ནོ།",
    "ཕྱོགས་གཅིག་གི་ཡོན་ཏན་གྱི་ངོ་བོ་ཉམས་སུ་མྱོང་བར་ནུས་པ་ཡང་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་ཕྱོགས་གཅིག་གི་ཁྱད་པར་གྱི་ངོ་བོ་རྟོགས་པར་གྱུར་ན།",
    "སྒྲའི་རང་གི་ངོ་བོ་ནི་རིགས་ལ་དང་།",
    "སྒྲའི་རང་གི་ངོ་བོ་དང་ལྡན་པའི་རིགས་ཀྱི་ངོ་བོ་ནི་འབྲེལ་པ་ལའོ།",
    "འབྲེལ་པ་ཅན་གྱི་ངོ་བོས་དབེན་པའི་དོན་གྱི་བདག་ཉིད་ནི་ཚིག་གི་ཡུལ་དུ་བྱ་བར་མི་ནུས་པ་ཉིད་ཀྱི་ཕྱིར་གདོན་མི་ཟ་བར་ཞེས་གསུངས་སོ།",
    "ཐ་དད་མེད་པར་གདགས་པ་མེད་ནའང་ཅི་ལས་སྔར་བརྗོད་པའི་སྐྱོན་དུ་ཐལ་བར་འགྱུར་ཅི་སྟེ་ཡོད་པ་ཉིད་དང་ཐ་མི་དད་པ་ཉེ་བར་གདགས་པས་དེ་བརྗོད་པར་བྱ་ན།",
    "རིགས་ལྡན་དེ་རྣམས་ཀྱི་གང་བྱེ་བྲག་མེད་པའི་ངོ་བོ་ཡོད་པ་ཉིད་དུ་སྒྲོ་བཏགས་པ་དེ་ཁོ་ན་ཁྱད་པར་གྱི་ངོ་བོ་ལ་མ་རེག་པར་བརྗོད་པར་བྱ་བའོ།",
    "རིགས་དང་སྦྱོར་བའི་ཕྱོགས་དག་གི་ནང་དུ་འདི་འདུས་པའི་ཕྱིར་ཕྱོགས་གཞན་ཉིད་འགེགས་པར་བྱེད་དོ།",
    "སྤྱི་ཐམས་ཅད་ཀྱི་རྗེས་སུ་སོང་བའི་ངོ་བོ་སྒྲའི་དོན་བརྗོད་པར་འགྱུར་རོ།",
    "འདི་ལུང་གིས་བསྟན་པའི་ཆེད་དུ་གསུངས་པ།",
    "རྒྱལ་པོའི་སྐྱེས་བུ་ཉིད་འཚེད་པར་བྱེད་པ་ཉིད་ཉེ་བའི་བ་ལང་གི་བུ་ཉིད་ཅེས་པའོ།",
    "ཚིག་གི་དོན་ནི་ཡོད་པ་ཉིད་ལ་འཁྲུལ་པ་ནི་མ་ཡིན་ནོ་ཞེས་པ་སྟེ།",
    "རང་གི་མཚན་ཉིད་བཞིན་དེ་དང་ལྡན་པ་ཡང་དེ་ལྟ་བུའོ།",
    "གང་གི་ཕྱིར་ཞེས་པ་ལ་སོགས་པ་གྲུབ་པ་བསྒྲུབ་བྱ་ཉིད་ཀྱི་ལན་འདེབས་སོ།",
    "གང་གི་ཕྱིར་ཞེས་པ་ལ་སོགས་པའོ།",
    "དེ་དང་ལྡན་པ་འགའ་ཞིག་གིས་ཀྱང་མ་ཡིན་ཞེས་བརྗོད་པར་བྱེད་པ་མཚུངས་པ་ཁོ་ནས་འདི་རྣམས་མཚུངས་ཏེ།",
    "བརྗོད་པར་བྱ་བ་དེ་ལྡན་གྱི་དངོས་པོའི་ངོ་བོ་འབའ་ཞིག་གིས་ནི་མ་ཡིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "འོ་ན་ཡོད་པ་ཉིད་ཀྱི་སྒྲའི་རང་གི་ངོ་བོས་དེ་ལྡན་བརྗོད་པར་བྱ་སྟེ།",
    "ཞེས་པ་གལ་ཏེ་གཅིག་ལ་སྟེ་ཐུན་མོང་མ་ཡིན་པའི་ངོ་བོའི་རིགས་དང་ལྡན་པའི་རྫས་ལ་ཐུན་མོང་བ་ཡོད་པ་ཉིད་འཇུག་གོ་ཞེས་པ།",
    "དོན་གྱིས་འཕངས་པ་ནི་ཞེས་པ་ལ་སོགས་པས་དོན་གྱིས་འཕེན་པའི་རང་གི་ངོ་བོ་གསུངས་ཤིང་།",
    "འདི་ལྟ་སྟེ་ཉིན་པར་མི་ཟའོ་ཞེས་པ་འདིར་མཚན་མོ་ཟ་བ་ལའོ།",
    "འོ་ན་ཅི་ཞེ་ན་ཐེ་ཚོམ་མོ་ཞེས་པ་རང་བཞིན་འགལ་བའོ།",
    "སྤྱིའི་སྒྲས་ཀྱང་རང་གི་ཁྱད་པར་མི་འཕེན་པར་འགྱུར་ཏེ།",
    "རང་གི་སྤྱི་ཡི་འདོར་མ་ཡིན།",
    "དེ་ལ་གལ་ཏེ་འོ་ན་གང་དུ་ཐེ་ཚོམ་ཟ་བ་དེར་མི་འཕེན་པ་ཞེས་པ་ལ་སོགས་པ་གང་བརྗོད་པ་དེ་རེ་ཞིག་བསམ་པར་བྱ་སྟེ།",
    "རང་གི་ཁྱད་པར་འཕེན་པ་མི་གཏོང་བའི་མཚན་ཉིད་ཅན་དུ་མི་འགྱུར་རོ་ཞེས་པ་ཅིས་ན་ཅིར་ཐལ་བར་འགྱུར།",
    "ཅི་ལྟར་དོན་འཕངས་པའི་བུམ་པ་ལ་སོགས་པ་རྣམས་ལ་བྱེ་བྲག་རེ་བར་འགྱུར་རོ་ཞེས་པ་འདི་བརྗོད་དེ།",
    "རེ་བ་ཞེས་བྱ་བ་ནི་དེ་རྣམས་ལ་ཐེ་ཚོམ་ཟ་བའི་ངེས་པ་དོན་དུ་གཉེར་བ་ཡིན་ནོ་ཞེ་ན།",
    "གང་ཞིག་དོན་འཕངས་པ་འདོད་པ་དེ་ནི་རྣམ་པ་འདི་ལྟ་བུའི་རེ་བ་འདོད་པ་མ་ཡིན་གྱི།",
    "འོ་ན་ཕ་རོལ་པོའི་ཕྱོགས་བཀག་པས་རང་གི་ཕྱོགས་འགྲུབ་པ་མི་འཐོབ་སྟེ།",
    "འཆད་པར་འགྱུར་བའི་རང་གི་ཕྱོགས་སྒྲུབ་པར་བྱེད་པ་ཐུགས་ལ་བྱས་ནས་ཀྱང་འདི་སྐད་གསུངས་སོ།",
    "རང་གི་དོན་ལས་ཐ་དད་པར་གཞན་སེལ་བ་བརྟེན་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་གཞན་སེལ་བར་བྱེད་དོ་ཞེས་པ་ནི་རྗོད་པར་བྱེད་དོ་ཞེས་པའི་དོན་ཏེ།",
    "ཇི་ལྟར་དགག་ཚིག་གིས་འགོག་པར་བྱེད་དོ་ཞེས་པ་འདི་ལ་བཞན་ནོ།",
    "དེའི་ཕྱིར་དེ་ལྡན་གྱི་ཕྱོགས་ལ་བརྗོད་པའི་སྐྱོན་རྣམས་འདི་ལ་ཡང་ཐལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "གང་གི་ཕྱིར་གང་འདི་རང་གི་དོན་ཡིན་པ་དེ་ཁོ་ན་གཞན་སེལ་བྱེད་ཅེས་འདིར་གཞན་སེལ་གྱི་སྒྲས་བརྗོད་པས་སོ།",
    "རང་གི་དོན་རྟོགས་པར་བྱེད་པ་ནི་རྗེས་སུ་འགྲོ་བ་ཡིན་ཞིང་འདི་ནི་ལྡོག་པ་མེད་པར་སྲིད་པ་ཡང་མ་ཡིན་ནོ།",
    "རང་གི་དོན་ལས་དོན་གཞན་རྣམ་པར་གཅོད་པ་ནི་ལྡོག་པ་སྟེ།",
    "གང་གི་དོན་བརྗོད་པའི་བྱ་བ་གཉིས་ནི་མེད་དེ།",
    "རང་གི་དོན་ནི་ཐ་དད་པའི་ངོ་བོ་ཉིད་ཀྱི་ཕྱིར་ན།",
    "དེ་དགག་པ་ཁོ་ན་དོན་སྤྱད་ཟིན་པ་ཅན་ཉིད་ཀྱི་ཕྱིར་རང་གི་དོན་རྟོགས་པའི་ཆེད་དུ་སྒྲ་གཞན་བཙལ་བར་བྱའོ་ཞེས་བརྗོད་པ་དེ་ཡང་མི་འཐད་དེ།",
    "གང་གི་ཕྱིར་སྒྲ་ནི་རང་གི་དོན་ཁོ་ན་རྟོགས་པར་བྱེད་ཅིང་།",
    "དེ་རྣམས་ངོ་བོ་ཐ་མི་དད་པ་བཞིན་དུ་རྣམ་པ་འགའ་ཞིག་གིས་སྟོན་ཏོ།",
    "དེས་ན་ཕྱི་རོལ་གྱི་རང་གི་མཚན་ཉིད་ཀྱི་བདག་ཉིད་ཅི་ལྟར་གཞན་སེལ་བ་ཤེས་པའི་རྣམ་པའི་རང་བཞིན་དུ་འགྱུར་ཞེ་ན་སྐྱོན་མེད་དེ།",
    "ཤིང་ཉིད་ལ་ཤིང་ཤ་པ་ལ་སོགས་པ་ཁྱད་པར་རྣམ་པར་མ་བཅད་པར་བརྡར་བྱས་པའི་ཤིང་གི་སྒྲ་ནི་དེ་ཡོངས་སུ་སྤངས་པས་འཇུག་པ་མ་ཡིན་པ་བཞིན།",
    "ཤིང་གི་སྒྲ་ཡང་ཤིང་ཉིད་ལ་ཤིང་མིན་རྣམ་པར་མ་བཅད་པས་བརྡར་བྱས་པའོ།",
    "དེ་ལྟར་འགྱུར་མོད།",
    "འདི་ཤིང་ཡིན་ཞེས་བརྡར་བྱེད་ལ་དེ་ལྟར་བརྡའི་དུས་སུ་མཐོང་བ་ཁོ་ནའི་སྤྱིའམ་དེ་དང་འབྲེལ་པ་ཅན་ནི་ཐ་སྙད་ཀྱི་དུས་སུ་ཡང་རྟོགས་སོ་ཞེས་པས་ཐལ་བར་འགྱུར་བ་མཚུངས་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "མི་མཚུངས་པ་མ་ཡིན་ཏེ་གང་གི་ཕྱིར་གཅིག་རབ་ཏུ་བསྟན་ནས་འདི་ཤིང་ངོ་ཞེས་སྨྲ་བ་ཡང་།",
    "རྟོགས་པ་ཡོད་ན་ཡང་བརྡའི་དུས་སུ་གཟུང་བའི་ཤིང་གི་གསལ་བ་ནི་གསལ་བ་གཞན་ལ་ཡང་དེ་ཁོ་ན་འདིའོ་ཞེས་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་དངོས་པོ་འདི་རྣམས་ཐ་དད་ཀྱང་འགའ་ཞིག་རྣམས་ནི་ངོ་ཤེས་ལ་སོགས་པའི་འབྲས་བུ་གཅིག་རང་བཞིན་གྱིས་བྱེད་ཀྱི་གཞན་རྣམས་ནི་མ་ཡིན་ཏེ།",
    "རྗེས་སུ་འགྲོ་བ་ཅན་གྱི་ངོ་བོ་འགའ་ཞིག་གི་རྗེས་སུ་སོང་བ་བཞིན་དུ་སོ་སོར་སྣང་ངོ།",
    "རྟོགས་པ་པོའི་རྣམ་པར་རྟོག་པ་རྣམས་ལ་ཐ་མི་དད་པར་རབ་ཏུ་སྣང་བ་རྣམས་རབ་རིབ་ཅན་གྱིས་ཟླ་བ་གཉིས་མཐོང་བ་བཞིན་དུ་རང་རང་གི་སྣང་བ་ཉམས་སུ་མྱོང་ན་ཡང་གཅིག་ཉིད་དུ་ལྷག་པར་ཞེན་པའི་ཕྱིར།",
    "དེ་ལ་ཐ་དད་པ་མཐོང་ཡང་གང་ཞིག་མཐོང་བ་དང་མ་མཐོང་བ་དག་གིས་འདི་ཤིང་དང་ཤིང་མིན་པ་རྣམ་པར་འབྱེད་པར་བྱེད་པ་དངོས་པོ་ཐ་མི་དད་པ་བལྟར་རུང་བ་གཅིག་ནི་མེད་དེ།",
    "གང་གི་དོན་ནི་འདའ་མིན་པ།",
    "དེ་ལྟར་ནི་དེ་རྣམས་ནི་ཤིང་གི་དོན་མེད་ཀྱང་རོ་ལ་སོགས་པ་རྣམས་ལ་མཐོང་གི།",
    "ཤིང་གི་སྒྲ་ཉིད་ལ་སོགས་པའི་སྤྱི་ནི་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཐ་དད་ཅེས་པ་ལ་སོགས་པ་སྟེ།",
    "གང་གི་ཕྱིར།",
    "རང་གི་དོན་ནི་སྤྱི་སྟེ།",
    "ཨུཏྤ་ལའི་སྒྲ་ནི་ཨུཏྤལ་ཙམ་མོ།",
    "འདིས་ནི་སོ་སོར་རང་གི་དོན་གྱི་ཁྱད་པར་ལ་ཐེ་ཚོམ་གྱི་རྒྱུ་ཉིད་དེ།",
    "གང་གི་ཕྱིར་འདི་ལྟར་ཨུཏྤལ་སྔོན་པོ་ལ་སོགས་པའི་སྒྲ་རྣམས་ཕན་ཚུན་གྱི་དོན་ལ་རང་གི་དོན་གྱི་བྱེ་བྲག་ལ་སོ་སོར་ཐེ་ཚོམ་གྱི་རྒྱུ་ཉིད་དེ།",
    "ཨུཏྤ་ལའི་སྒྲ་རང་གི་དོན་གྱི་ཁྱད་པར་ལ་ཐེ་ཚོམ་གྱི་རྒྱུས།",
    "རང་གི་དོན་སྤྱི་བློས་སྒྲོ་བཏགས་པ་ལ།",
    "དམར་པོ་ནི་མ་ཡིན་ནོ་ཞེས་དེ་ལ་རང་གི་དོན་ཉེ་བར་སྡུད་ཅིང་ཨུཏྤ་ལའི་དོན་ཁྱད་པར་དུ་བྱེད་དོ་ཞེས་པས་ཁྱད་པར་དང་ཁྱད་པར་དུ་བྱ་བའི་དངོས་པོར་འགྱུར་རོ།",
