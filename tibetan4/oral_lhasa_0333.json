    "ཟླ་བ་གཅིག་ཟས་སུ་ཆུ་གྲོག་༡༩འཚལ་ཞིང་མར་གྱི་ངོ་ཞག་བརྒྱད་ནས་ཞག་གསུམ་སྨྱུང་བ་བྱས་༢་ཏེ།",
    "ལོ་བདུན་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "༩བཙུགས་ན་ན་དགུང་གསུམ་གྱིས་འབྲོས་པར་འགྱུར་རོ།",
    "མེ་ཁ་ལའི་ལས་རྣམས་ལགས་ཏེ།",
    "ཀུན་དགའི་ར་བར་མཆིས་ལ་གང་དུ་བཟླས་བརྗོད་བགྱིས་པ་དེ་ནས་འབྱུང་པོ་དང་གདོན་ཐམས་ཅད་འབྲོས་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་ལོག་འདྲེན་རྣམས་ཀྱི་རིགས་བསྒྲུབ་པར་འཚལ་ན།",
    "རྣམ་པར་འཇོམས་པའི་རིགས་དང་།",
    "རྣམ་པར་འཇོམས་པའི་རིགས་ལ་ནི་འཇིག་རྟེན་སྐྱོང་བའི་གཡོག་འཁོར་མྱ་ངན་མེད་པ་༡༢ལ་སོགས་པ་ལོག་འདྲེན་དྲུག་ཁྲི་མཆིས་ཏེ།",
    "རིག་པ་ཡང་འཇོམས་པར་བགྱིད་དོ།",
    "ལག་ན་རྡོ་རྗེའི་གཟུགས་འགུལ་ཏེ་དེ་ནས་༡༢གྲུབ་༡་པར་འགྱུར་རོ།",
    "རྣམ་པར་འཇོམས་པའི་རིགས་ཀྱི་༡་སྒྲུབ་པ་ནི་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་བགྱིས་ཏེ།",
    "དེས་ལོ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "ཟས་སུ་འོ་ཐུག་འཚལ་ཞིང་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ལན་འབུམ་བཟླས་༡་བརྗོད་བགྱིས་ན་མེ་ཁ་ལ་གྲུབ་སཔར་འགྱུར་ཏེང་།་",
    "དེ་ནས་ཅ་ཅོའི་སྒྲ་ཆེན་པོ་གྲག་པར་འགྱུར་ཏེ།",
    "དེ་ལ་ཡང་༡མི་འཇིགས་པར་བགྱིའོ།",
    "དེ་ལ་ཡང་མི་འཇིགས་པར་བགྱིའོ།",
    "རྡོ་རྗེ་བཞད་མའི་བཟླས་བརྗོད་བགྱིས་ལ་དེ་ལ་འདི་སྐད་ཅེས་ལག་ན་རྡོ་རྗེའི་གནང་ཆེན་མ།",
    "བཅོམ་ལྡན་འདས་མ་ལོ་ལྔ་སྟོང་ཐུབ་པར་འཚལ་ལོ་ཞེས་བརྗོད་པར་བགྱི་སྟེ།་",
    "མ་བསྒྲུབས་པར་ལས་རྣམས་འགྲུབ་པར་འགྱུར་རོ།",
    "དབབ་པར་༢༢བགྱི་ན་གདོན་གྱིས་ཟིན་པའི་རྐང་པ་ལ་རྐང་པས་མནན་ཏེ་དབབ་པར་བགྱིའོ།",
    "གདོན་འཁུམས་པར་བགྱི་ན་ཡིད་ཀྱིས་བཟླས་བརྗོད་བགྱིས་པས་བགྱིའོ།",
    "དགྲ་བསྐྲད་པར་འཚལ་ན་བྱ་ནག་བཀྲའི་འདབ་༡་མ་བླངས་ཏེ།",
    "དུར་ཁྲོད་ཀྱི་སོལ་བས་ས་ལ་གཟུགས་བྲིས་ལ་དེའི་ལག་པའམ་མགུལ་༦པར་ལག་ན་རྡོ་རྗེ་བྲིས་ཏེ་མནན་ན་གཏོང་བར་འགྱུར་རོ།",
    "ཕྱུང་ན་སོས་པར་ཡང་འགྱུར་རོ།",
    "ནག་སེར་གྱི་ལས་རྣམས་ལགས་ཏེ།",
    "རྒྱ་མཚོར་འབབ་པའི་ཆུ་ཀླུང་དུ་ཞུགས་ལ་རིག་པ་ལན་བརྒྱ་སྟོང་བཟླས་བརྗོད་བགྱིས་ན་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལ་འདི་སྐད་དུ་སའི་བདག་པོར་གྱུར་པ་སྩོལ་ཅིག་ཅེས་བརྗོད་པར་བགྱིའོ།",
    "རྡོ་རྗེ་སེང་གེའི་ཁྲིའི་ལས་རྣམས་ལགས་ཏེ།",
    "གདོན་འབྲོས་པར་བགྱི་ན་སོལ་བས་གཟུགས་བྲིས་ལ་ལྕུག་མས་༢བསྣུན་ན་གཏོང་བར་འགྱུར་རོ།",
    "གདོན་གཅོད་༦ན་མཚོན་རྣོན་པོས་རྩྭ་ཀུ་ཤ་བཅད་ན་གདོན་བཅད་པར་འགྱུར་རོ།",
    "བྱིས་པ་གདོན་གྱིས་ཟིན་པ་རྣམས་ལ་ཡལ་གས་བྱབ་པར་བགྱིའོ།",
    "མཚོན་གྱིས་མི་ཚུགས་པར་བགྱི་ན་ཡིད་ཀྱིས་བགྱིའོ།",
    "བསྐལ་པར་གནས་པར་ཡང་འགྱུར་རོ།",
    "རིག་པའི་རྒྱལ་པོས་བསྣུན་པར་བགྱིའོ།",
    "བླངས་མ་ཐག་ཏུ་མདུང་རྩེ་གསུམ་པར་འགྱུར་ཏེ་རིག་སྔགས་ཐམས་ཅད་ཀྱི་སྤྱོད་ཡུལ་དུ་མི་འགྱུར་༥།",
    "ལོ་དགུ་སྟོང་ཐུབ་པར་འགྱུར་རོ།་།",
    "རྡོ་རྗེ་ལྡན་མའི་ལས་རྣམས་ལགས་ཏེ།",
    "སྦྲང་རྩི་ཚམར་ལ་སྨྱུགས་པ་༧བརྒྱ་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་དེ་ནས་རྡོ་རྗེ་འགུལ་ནས་གྲུབ་པར་འགྱུར་ཏེ།",
    "དེ་བཞིན་དུ་དགོད་པར་བགྱིའོ།",
    "ཟས་སྩལ་ན་ཀ་ར་བཱི་༡་རའི་མེ་ཏོག་ལ་ལན་བདུན་བཟླས་བརྗོད་བགྱིས་པར་བགྱིའོ།",
    "བརྡེག་ན་སེ་གོལ་གཏོགས་པར་བགྱིའོ།",
    "ཚར་བཅད་༢༡ན་རྩྭ་༡ལ་ལན་བདུན་སྔགས་ཀྱིས་བཏབ་ལ་མགོ་ལ་བཞག་ན་མྱོས་པར་འགྱུར་ཏེ་གདོན་འབྲོས་སོ།",
    "གདོན་འབྲོས་པར་བགྱི་ན་གདོན་གྱི་མདུན་དུ་ལན་བརྒྱ་རྩ་བརྒྱད་སྦྱིན་སྲེག་བགྱིས་ན་གདོན་ངུ་ཞིང་འབྲོས་སོ།",
    "ཆང་མ་རུང་བར་བགྱི་ན་གསེག་མ་ལ་ལན་བདུན་བཟླས་བརྗོད་བགྱིས་ལ་ཁང་སྟེངས་སུ་རི་བོར་ན་ཆང་མ་རུང་བར་༡་བགྱིས་པར་འགྱུར་རོ།",
    "གདོན་གྱིས་བཏབ་པར་བགྱི་ན་ཡིད་ཀྱིས་བགྱིའོ།་།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་སྐྱེས་པའི་སྐྲ་ལས་ལན་བརྒྱ་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་དབྱེ་བ་བགྱིས་པར་འགྱུར་རོ།",
    "རོ་ལངས་ན་སྒྲུབ་པར་འཚལ་བས་ཚེས་གྲངས་དང་སྐར་མ་འདམ་༡མི་འཚལ།",
    "མངལ་བླངས་ནས་ཀྱང་ཡུངས་ཤར་གྱིས་བསྣུན་ན་དུམ་བུ་བརྒྱར་འགྱུར་ཏེ་ཕྲུ་མའི་ནང་དུ་སྩལ་ལ་མི་ཐོད་གསུམ་གྱི་སྟེང་དུ་༦མཆིས་ལ་ཡོངས་སུ་སྨིན་པར་འགྱུར་གྱི་བར་དུ་རྡོ་རྗེ་བཞད་མ་བཟླས་བརྗོད་བགྱིས་ལ་བླངས་ཏེ་གྲོགས་རྣམས་ལ་ཡང་༧སྩལ་ཅིང་འཚལ་ན་སྐྲ་ལྕང་ལོ་༨འཁྱིལ་བར་འགྱུར།",
    "དཔག་ཚད་སྟོང་གྱེན་དུ་འཕག་༡༡པར་འགྱུར།",
    "དཔག་ཚད་སྟོང་ཚུན་ཆད་ཀྱིས་ཐོས་པར་འགྱུར།",
    "ལོ་བརྒྱད་ཁྲི་ཐུབ་པར་འགྱུར།",
    "མཚོན་ཆས་ལུས་ལ་མི་ཚུགས་པར་འགྱུར།",
    "དེ་གྱིས་ཤིག་ཅེས་བརྗོད་པར་བགྱིའོ་༩།་།",
    "སྒྲུབ་པ་མ་ལགས་པའི་རིག་པ་ཡང་སྒྲུབ་པར་བགྱིད་དོ།",
    "ལ་གང་འདོད་པ་བྲིས་ཏེ་བསྐུར་ན་སོས་པར་འགྱུར་རོ།",
    "མེ་ཏོག་པདྨའི་དབུས་སུ་ལྷ་དེ་གཞག་པར་བགྱིའོ།",
    "དུས་གསུམ་དུ་བདུག་པས་ཀྱང་བདུག་པར་བགྱི་སྟེ།",
    "ཤིང་ཤ་ཨ་༡་མྲའི་༧མེ་ཏོག་དང་དེ་རྣམས་བསྲེས་པའི་བདུག་པས་བདུག་པར་བགྱིའོ།",
    "དེ་ནས་གཟུགས་དེ་འོ་མའི་ནང་དུ་སྩལ་ཏེ་སཞིག་པར་མ་གྱུར་གྱི་བར་དུ་བཞག་ལ་ཞིག་ནས་འོ་མ་རྒྱ་མཚོར་འབབ་པའི་ཆབ་ཀྱི་ནང་དུ་༤༥༥་ལཏོ།",
    "བཅོམ་ལྡན་འདས་འདི་ནི་རིག་པའི་རིགས་ཐམས་ཅད་ཀྱི་༡་གསང་བ་ལགས་ཏེ་འདིས་ལྷ་ཐམས་ཅད་འགྲུབ་༡༩པར་འགྱུར་རོ།",
    "ཟླ་མ་མཆིས་པ་ལགས་སོ།་།",
    "གསོལ་པ་བཅོམ་ལྡན་འདས་མཐོང་ལགས་སོ།",
    "བདེ་བར་གཤེགས་པ་མཐོང་ལགས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་སྟོང་ཕྲག་དགུ་ལ་ཕྱག་བྱས་པར་འགྱུར་རོ།",
    "བསྲུང་བའི་དུས་ན་ཏིལ་ནག་པོས་སྦྱིན་སྲེག་བརྒྱ་སྟོང་བགྱིས་ན་༢༥བགེགས་ཐམས་ཅད་བཅོམ་པར་འགྱུར་རོ།",
    "སྤོས་དང་མེ་ཏོག་དང་བདུག་པས་མཆོད་ལ་རིག་པ་ལན་བརྒྱ་སྟོང་བཟླས་༢༡བརྗོད་བགྱིས་ན་སྒྲུབ་པའི་ཚེ་ར་བྱིན་གྱིས་རློབ་པར་བགྱིད་ཅིང་དངོས་གྲུབ་ཏུ་འགྱུར་རོ།",
    "ཀླུ་དཀྲུགས་ལྷཔར་བགྱི་ན་རྡོ་རྗེའི་ཕྱག་རྒྱ་རིཏིབགྱིས་ལ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་བཟླས་བརྗོད་ལན་བརྒྱད་བརྒྱ་བགྱིས་ཏེ།",
    "གང་ན་ཀླུ་གནས་པའི་མཚོ་དེར་བོར་ན་ཀླུ་ཐམས་ཅད་སྐྲག་པར་འགྱུར་རོ།",
    "དྲི་ཟ་རྣམས་གཡོས་པར་བགྱི་ན་མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་བགྱིས་ཏེ།་",
    "དེ་འཚལ་ན་ཐོས་པ་འཛིན་པར་འགྱུར།",
    "གནོད་སྦྱིན་རྣམས་བརླག་༢པར་བགྱི་ན་ཕྱོགས་གང་ན་གནོད་སྦྱིན་ནམ།",
    "ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་བརྗོད་བགྱིས་ཏེ་བཙུགས་ན་གནོད་སྦྱིན་འབྲོས་རི་པར་འགྱུར་རོ།་།",
    "བདག་བཅིངས་ན་རིག་སྔགས་༥འཆང་བ་༦དེ་ལ་སུ་ཡང་བགེགས་བགྱིད་པར་མི་འགྱུར་རོ།",
    "ལག་པ་གཡོན་ན་མདུང་རྩེ་གསུམ་པ་ཐོགས་པར་བགྱིའོ།་།",
    "དངོས་གྲུབ་སྩལ་གྱི་བར་དུ་གཞག་པར་བགྱིའོ།",
    "མུ་དྷ་ད་༡ཀའི་བསྒྲུབ་པ་ལགས་ཏེ།",
    "བྱིས་པ་གདོན་སྐེམ་༡བྱེད་ཀྱིས་ཟིན་པ་རྣམས་ནི་ཆབ་ལ་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་བརྗོད་བགྱིས་ཏེ་བཀྲུས་ན་སོས་པར་འགྱུར་རོ།",
    "འདི་ནི་༦ཁོ་བོས་བརྗོད་པར་བགྱིའོ།",
    "རིག་པ་འདི་བཏོན་པ་ཙམ་གྱིས་བགེགས་ཐམས་ཅད་བཅོམ་པར་འགྱུར་རོ།",
    "གཞན་བསྲུང་ན་སྤྱི་བོར་ལན་གསུམ་བཟླས་བརྗོད་བགྱིས་ཏེ་སྐྲ་མདུད་སྐཔར་བགྱིའོ།",
    "མ་རུངས་པར་ཉིཉབགྱི་འཚལ་ན་མི་རུས་༡ཀྱི་ཕུར་བུ་བླངས་ལ་ལན་བརྒྱ་སྟོང་སྔགས་ཀྱིས་བཏབ་སྟེ་༡།",
    "དགྲའི་ཁྱིམ་དུ་བཙུགས་ན་དགྲ་མ་རུངས་པར་༢འགྱུར་རོ།",
    "སྐམ་པར་འདོད་ཅན་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ཆབ་ལྟེ་བ་ནུབ་ཙམ་དུ་ཞུགས་ལ་དགྲའི་སྲོག་བསྐམས་༧༥ཀྱི་བར་དུ་བཟླས་བརྗོད་བགྱིའོ།",
    "འབར་ན་ནི་ལོ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "ལོ་དགུ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "ཁྲག་དང་བསྲེས་ལ་ལན་བརྒྱ་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་ཡུལ་འཁོར་མ་རུངས་པར་༥འགྱུར་རོ།",
    "ཤགས་ནསའགྱེད་ན་རིག་པ་བཟླས་བརྗོད་བགྱིས་ལ་གདོང་ལ་བྱུགས་རིན་རྒྱལ་བར་འགྱུར་རོ།",
    "བཟླས་བརྗོད་བགྱིས་ན་གང་འདོད་པ་དེ་རྙེད་པར་འགྱུར་རོ།",
    "རྒྱལ་པོ་དང་ཆོམ་རྐུན་གྱི་ནང་དུ་ཆུད་ན་བསམ་པར་བྱའོ།",
    "ཁ་དོག་སྔོ་བསངས་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པར་༡༧བྲིའོ།",
    "འོད་ཟེར་དེ་དེ་བཞིན་གཤེགས་པའི་ཞབས་ཀྱི་མཐེ་བོར་མིནུབ་པར་འགྱུར་རོ།",
    "ཆོ་ག་རྒྱས་པ་ཆེན་པོ་གཞན་དག་ཀྱང་འགྲུབ་༨པར་འགྱུར་བའི་གསང་སྔགས་ཀྱི་ཛོ་༩་ཆོ་ག་རྒྱས་པ་འདིར་སྦྱིན་པར་བགྱིའོ།",
    "ལག་ན་རྡོ་རྗེ་ལ་ནུབ་ན་གྲུབ་༩༡༧པར་འགྱུར་རོ།",
    "རྒྱལ་པོ་ཉིད་དམ་རིག་སྔགས་འཆང་ཉིད་དེ་དམ་པ་གཉིས་སྦྱིན་པར་བྱེད་དོ་༡༢།",
    "ལོ་ཁྲི་བཞི་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ།",
    "རིག་པ་ལན་བརྒྱ་སྟོང་བཟླས་བརྗོད་བྱས་ན་དེ་ནས་དངོས་གྲུབ་ཏུ་འགྱུར་རོ།",
    "བཅུ་བཞི་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ།",
    "རིག་སྔགས་འཆང་ཐམས་ཅད་ཀྱིས་མི་སོད་༧པར་འགྱུར་རོ།",
    "ལོ་དགུ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "ནམ་འགུལ་བར་གྱུར་གྱི་བར་དུ་རིག་སྔགས་ལན་འབུམ་བཟླས་བརྗོད་བྱས་ན་ལོངས་སྤྱོད་སྟེར་རོ།",
    "འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་བྱུང་བ་རྣམས་སྟོན་པར་འགྱུར་རོཪྴ།",
    "ལོ་ལྔ་བརྒྱ་ཐུབ་པར་འགྱུར་ཇོམ།",
    "ཟས་སུ་འོ་སྐྱོ་འཐུང་ཞིང་ལག་ལན་རྡོ་རྗེའི་མདུན་དུ་ལན་འབུམ་བཟླས་བརྗོད་བྱས་ན་ལོངས་སྤྱོད་སྟེར་ཏེ་༨།",
    "ལོ་ལྔ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "ལིག་བུ་མིག་བླངས་ལ་ལན་བརྒྱ་སྟོང་བཟླས་བརྗོད་བྱས་ནས་སྦྱང་བར་༡་བྱ་སྟེ།",
    "སོལ་བ་ཡང་བསྒྲུབ་པར་བྱ་སྟེ།"
  ]
}