    "སྒྲུབ་པའི་རིག་སྔགས་འཆང་དེའི་བརྩོན་པ་བསྐྱེད་པར་བགྱིའོ།",
    "དེ་ནས་རིག་པའི་རྒྱལ་པོའི་ལས་ནི་འདི་ལགས་ཏེ་།",
    "པར་གྱུར་ན་རྩྭ་༡་ཀུ་ཤས་བྱབ་པར་བྱ་སྟེ་རྫོགས་པར་འགྱུར་རོ།",
    "དབབ་པར་བགྱི་ན་རྣ་བར་བཟླས་བརྗོད་བགྱིའོ།",
    "མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ནས་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ཞག་གསུམ་སྨྱུང་བར་བྱས་ལ་ལན་༥བརྒྱད་སྟོང་༦",
    "ཚོ་རྟེཐུབ་པར་རིག་སྔགས་ཐམས་ཅད་མ་རུངས་པར་འགྱུར་རོ།",
    "རིག་སྔགས་གཅད་པར་བགྱིད་༤འཚལ་ན།",
    "དེས་༡༢བཅོམ་ལྡན་འདས་ལས་ཐམས་ཅད་མཛད་དུ་གསོལ་ཞེས་བརྗོད་པར་༡༨བགྱིའོ།",
    "གསེག་མ་ལ་ལན་བདུན་བསྔགས་ཏེ་མཚོར་བོར་ན་མཚོ་སྐམ་པར་འགྱུར་རོ།",
    "འབབ་ཆུ་ཆེན་པོར་བོར་ན་འབབ་ཆུ་ཆེན་པོ་སྐམ་པར་འགྱུར་རོ།",
    "གང་དུ་བོར་བ་དེ་སྐམ་པར་འགྱུར་རོ།",
    "ཐིག་ལེའི་སྙི་མ་བཞིན་དུ་འགས་པར་འགྱུར་རོ།",
    "བའི་ལོ་མ་ཅན་ཁོབརྒྱད་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་ཏི་ན་ར་ཚགཅིག་རྙེད་པར་འགྱུར་རོ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་སྲད་བུ་ལ་རིག་པའི་མཆོག་བརྒྱད་སྟོང་བཟླས་བརྗོད་བགྱིས་ཏེ་ལག་པ་ལ་བཏགས་ཚུཉེནས་གཡུལ་ངོར་ཞུགས་ན་ཕ་རོལ་གྱིས་མི་ཐུབ་༥༨པར་འགྱུར་རོ།",
    "གཡས་ཕྱོགས་སུ་ལག་ན་རྡོ་རྗེ་སྟན་ནང་ཚངས་ཅན་གྱི་སྟེང་ན་དུསམཆིས་པར་བྲིའོ།",
    "རིག་པའི་རྒྱལ་པོ་ཡང་སྔོ་བསངས་ཏེ་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་ལ་སྟན་གོར་བུའི་སྟེང་ན་མཆིས་པར་བྲིའོ།",
    "རྡོ་རྗེ་ལྡན་མས་བགེགས་གཞོམ་པར་བགྱིའོ།",
    "ཞག་བདུན་ན་ཏི་ན་ར་བརྒྱ་རྙེད་པར་འགྱུར་རོ།",
    "འབར་ན་བསྐལ་པར་གནས་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་འོ་མས་བཀྲུས་ལ་རིག་སྔགས་ལན་བརྒྱད་སྟོང་བཟླས་པ་བགྱིས་ན་སོས་པར་འགྱུར་རོ།",
    "ཕྱུང་ན་སྔ་མ་ཁོ་ན་བཞིན་༡རྟག་པར་འགྱུར་རོ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་མར་དང་བསྲེས་༤༥པའི་སྐེ་ཚེའི་འབྲུ་ལ་ནེལན་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་བརྟས་པར་འགྱུར་རོ།",
    "གཟུགས་སྣ་ཚོགས་སྟོན་པར་འགྱུར་རོ།",
    "པ་གཡས་པས་དམ་པ་སྦྱིན་པར་བྲིའོ་སྙེ།",
    "གང་དགུག་པར་འདོད་པ་དེ་བཀུག་བོསྟེ།",
    "འོག་ཏུ་སྒྲུབ་པ་པོ་ལག་ན་པོག་པོར་༡༨ཐོགས་པར་བགྱིའོ།",
    "དེ་ནས་ལྕགས་ཀྱུ་བསྒྲུབས་ན་སྔར་འཆི་སྤྱད་པར་༩༥བགྱི་སྟེ།",
    "ལག་ན་ལྕགས་ཀྱུ་ཐོགས་ན་སུམ་ཅུ་༡༡རྩ་གསུམ་པས་ཀྱང་ཟིལ་གྱིས་མནན་པར་མི་ནུས་སོ།",
    "དངོས་གྲུབ་རྣམ་པ་གསུམ་ལ་བསྐལ་པར་གནས་པར་འགྱུར་རོ།",
    "མཉེས་པར་བགྱིས་པ་ལགས་སོ།",
    "རིག་པའི་རྒྱལ་པོ་འདི་འགུག་༤ཀྱིཔ་འདིས་བཀུག་ནས་ཕྱིས་རྒྱལ་བའི་བློ་གྲོས་ཀྱིས་དགུག་པར་བགྱིའོ།",
    "ཅི་སྟེ་ཚེས་སྐབརྒྱད་ལ་བསྒྲུབ་པར་འཚལ་ན་ཚེས་བདུན་གྱི་ཕྱི་དྲོ་༡༥གུ་གུལ་གྱིས་བདུགས་ཚལ་གསང་སྔགས་ལན་བརྒྱ་རྩ་བརྒྱད་བརྗོད་དོ།",
    "རྒྱལ་བའི་བློ་གྲོས་འདིས་དགུག་པར་བགྱིའོ།",
    "བགྱིས་ན་བཅིངས་པར་འགྱུར་རོ།",
    "ལས་ཐམས་ཅད་དུ་རྩྭ་༥ལྷཀུ་ཤ་སྤམས་པ་ལ་སྔགས་ཀྱིས་བཏབ་སྟེ་བདུག་པར་བགྱིའོ།",
    "མར་གྱི་ངོ་ཚེས་བཅྭ་༨༥ལྔ་ལ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་བསྐུ་༥༩རིལའི་མེ་ཏོག་དག་ལས་ལན་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་རིག་སྔགས་འཆང་ཐམས་ཅད་ཀྱི་རིག་སྔགས་གཅད་མིཔར་འགྱུར་རོ།",
    "ལག་ན་རྡོ་རྗེ་ཡིད་ལ་བགྱིད་༦༦པས་ལོག་འདྲེན་རྣམས་སྐྲག་ཅིང་ཉམས་ཏེ་ཉམ་༢་རྨེཐག་ནས་འབྲོས་པར་འགྱུར་རོ།",
    "དེས་ན་དེ་ལ་བགེགས་སུ་མི་འགྱུར་ཏེ་བདེ་བར་ལས་རྣམས་འགྲུབ་པར་བྱེད་དོ།",
    "ཁུ་ཚུར་བཅངས་ཏེ་བསྒྲུབ་པར་བགྱིའོ།",
    "སྐྲ་ལྕང་ལོ་འཁྱིལ་པར་འགྱུར་རོ།",
    "ཇི་༤སྟེ་དགྲ་གསད་༥༥པར་འཚལ་ན་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ཉིན་ཞག་༤༦གཅིག་སྨྱུང་བ་བགྱིས་ཏེ།",
    "ས་ཕྱོགས་གཙང་མར་གཟུགས་བགྱིས་ལ་ཅི་ནུས་ཀྱིས་མཆོད་དེ་ཞག་གཅིག་སྨྱུང་བ་བགྱིས་ལ་ཤིང་བིལ་བའི་༡༥ལོ་མ་བསྲེགས་ཤིང་ཞོ་དང་སྦྲང་རྩི་དང་མར་ལ་སྨྱུགས་ཏེ་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་དཔྲལ་བ་ལས་འོད་ཟེར་འབྱུང་ངོ་།་།",
    "གསེག་༡༨མ་ལ་ལན་བརྒྱ་༡༩སྟོང་བཟླས་ཏེ་དུར་ཁྲོད་དུ་བོར་ན་ཡི་དགས་༢་ཐམས་ཅད་གླུ་ལེན་ཅིང་གར་བྱེད་པར་འགྱུར་རོ།",
    "དེའི་རྐེད་པར་ཤིང་ཨ་ཤྭཏྠའི་ཀྱི་ལོ་མ་བདུན་བཞག་ལ་དེའི་སྟེང་དུ་ལྡོང་རོས་བཞག་སྟེ་ཅི་སྲིད་ཀྱིས་དངོས་གྲུབ་གསུམ་དུ་གྱུར་པ་དེ་སྲིད་དུ་བཟླས་བརྗོད་བགྱིའོ།",
    "ལུས་མཛེས་པར་བགྱིས་ལ་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ཉིན་ཞག།",
    "ལོ་ལྔ་བརྒྱ་ཐུབ་པར་འགྱུར་རོ།",
    "དེ་དག་ཀྱང་སྟོབས་མཉམ་པར་འགྱུར་རོ།",
    "མདུང་རྩེ་གསུམ་པ་ལག་པ་གཡས་པར་ཐོགས་ལ།",
    "ཕྱུང་ན་ཐམས་ཅད་མེད་པར་འགྱུར་རོལ།",
    "ཆོ་ག་གང་ལ་བླངས་པའི་ཆོ་ག་དེ་ཉིད་ལ་བསྒྲུབ་པར་བགྱིའོ།",
    "བྱེད་ཀྱིས་ཟིན་པར་འགྱུར་རོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་ཉི་མའི་གུང་ཚིགས་ལ་མི་རོའི་མགོ་ཤར་ཕྱོགས་སུ་བསྟན་ཏེ་ཕྱོགས་བཞིར་བསྙེན་བཀུར་བགྱིད་པ་བཞི་བཞག་སཔར་བགྱིའོ།",
    "གཞན་བསྐྲད་པར་འཚལ་ན་བྱ་ཁྭའི་གཤོག་༦པ་ཡུངས་ཀུར་གྱི་འབྲུ་མར་ལ་སྨྱུགས་རྩོདཔ་བརྒྱད་སྟོང་ཞག་བདུན་དུས་གསུམ་དུ་སྦྱིན་སྲེག་བགྱིའོ།",
    "གལ་ཏེ་དེས་ལས་གྲུབ་པར་མ་གྱུར་ན་དེའི་འོག་ཏུ་ལས་འདི་སྒྲུབ་ན་དངོས་གྲུབ་ཀྱི་མཆོག་ཏུ་འགྱུར་རོ།",
    "ཡིད་གཞུངས་ཙོ་པར་བགྱི་ན་བྲ་མའི་ཁུ་བ་མར་དང་ཆ་བསྙམས་ལ་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་བགྱིས་ཏེ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ལན་བརྒྱད་སྟོང་བཟླས་བརྗོད་བགྱིས་པ་འཐུངས་ན་ཐོས་པ་འཛིན་པར་འགྱུར་རོ།",
    "ཡར་གྱི་ངོ་ཚེས་ཞག་གཅིག་ནས་བརྩམས་ཏེ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་མར་དང་འོ་མ་བསྲེས་ན་པ་ལས་དལན་བརྒྱ་ལམ་བརྒྱད་བཟླས་བརྗོད་བགྱིས་པ་འཐུངས་ཤིང་ཞག་བདུན་བགྱིས་ན་ཐོས་པ་འཛིན་པར་འགྱུར་རོ།",
    "ཡར་གྱི་ངོ་ཉ་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་བགྱིས་༥ཏེ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ཨང་གོ་ཏའི་ཚོ་མེ་ཏོག་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་༧ཉི་མ་གསུམ་པ་ལ་ཐོས་པ་འཛིན་པར་འགྱུར་རོ།",
    "ཞག་བདུན་ན་ལག་ན་རྡོ་རྗེའི་ཁ་ནས་འོད་ཟེར་འབྱུང་སྟེ་རིག་སྔགས་འཆང་ལ་བསྐོར་བ་བྱས་ནས་གྱེན་དུ་འགྲོ་བར་འགྱུར་རོ།",
    "ལོ་སུམ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "མར་གྱི་ངོ་ཞག་བཅུ་ལ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་སྣ་མའི་མེ་ཏོག་བརྒྱད་སྟོང་ཕུལ་ན་གནས་སྟོན་པར་འགྱུར་རོ།",
    "ལྷ་མ་ཡིན་གྱི་བུ་རྣམས་ནི་མཆིས་ཏེ་ལྷ་མ་ཡིན་གྱི་བུ་༤རྣམས་ཀྱང་ཡོངས་སུ་སྤྱད་པར་འགྱུར་རོ།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཉིན་ཞག་གཅིག་སྨྱུང་བ་བགྱིས་ཏེ་བའི་ལྕི་བ་ས་ལ་མ་ལྷུང་བ་བླངས་ཏེ་སྐམ་༡༢ས་གཙང་མའི་ཕྱོགས་སུ་གནོད་སྦྱིན་གྱི་གཟུགས་བགྱིས་ཏེ།",
    "བཅོམ་ལྡན་འདས་རིག་པའི་རྒྱལ་པོ་ཡི་གེ་བཞི་པ་ནི་བསྐལ་པ་བཞིར་གནས་པ་ལགས་སོ།",
    "གཏུམ་པ་དྲག་པོ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་མིང་བརྗོད་པས་བདག་ལ་གནོད་པ་ལགས་སོ།",
    "ངེས་པར་རྡོ་རྗེའི་རིགས་སུ་སྐྱེ་བར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་དྲི་མ་མེད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་གཞག་༥སྟེ།",
    "དེ་བཞིན་དུ་ལོག་པར་དད་སེལ་དང་།་",
    "ལོ་ཁྲི་ཉིས་སྟོང་ཐུབ་པར་འགྱུར་རོ་༡།",
    "དེ་བཞིན་དུ་གྲོགས་༡རྣམས་ཀྱང་དཔག་ཚད་སྟོང་དུ་གྱེན་དུ་འཕགས་པར་འགྱུར་རོ།",
    "ལོ་ཁྲི་ཉིས་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "རིག་སྔགས་འཆང་ཐམས་ཅད་སྐྲག་པར་འགྱུར་རོ།",
    "རིག་སྔགས་འཆང་གཞན་བརྒྱ་ཡང་འབྱུང་སྟེ་བསྙེན་བཀུར་རི་བགྱིད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་ནི་ཁྲུ་བརྒྱད་པརི་རི།",
    "ལྷ་རྣམས་ཀྱང་མཚོན་ཆ་དང་བཅས་པར་བགྱིས་ཏེཚ།",
    "གཏོར་མ་བཙལ་ནས་ལྷ་སྤྱན་དྲང་ན།",
    "གཙང་མའི་གོས་ནི་བགོ་ཅབར་བགྱི།",
    "སུ་ཞིག་གཞན་དུ་བགྱིད་ན་དེའི་རྡོ་རྗེ་ཉིད་ཀྱིས་མཐར་བགྱིད་༡་པར་འགྱུར་རོ།",
    "ཐོགས་ན་འཁོར་ལོས་སྒྱུར་བ་མ་གཏོགས་པར་རིག་སྔགས་འཆང་ཐམས་ཅད་ཀྱིས་མི་སོད་དོ།",
    "ལྷུང་ནས་དེ་ལས་འབབ་༡༥པར་བྱའོ།",
    "ལེ་ལོ་ཅན་དང་བྱས་པ་མི་གཟོ་༢་བ་རྣམས་ཀྱིས་ལས་འདི་མི་བྱའོ།",
    "གང་ནུས་པ་བརྟན་ཞིང་མཐུ་སྟོབས་དང་ལྡན་པ་རྩོལ་བ་རིངེས་པར་བྱས་པས་ལས་འདི་བརྩམ་པར་བྱ་སྟེ།",
    "ཚངས་པར་སྤྱོད་པར་བྱ་ཞིང་ཉ་དང་ཤ་ཡོངས་སུ་སྤང་བར་བྱའོ།",
    "ཟངས་པོ་ཆེ་བཙུགས་ལ་འབྲུ་མར་བླུགས་ཏེ་བསྐོལ་ལ་རིག་པའི་རྒྱལ་པོ་བཟླས་བརྗོད་བྱས་ན་ཚན་རིག་སྔགས་འཆང་གྲུབ་པ་ཡང་རུང་།",
    "གཞན་དུ་ན་མ་རུངས་པར་༦འགྱུར་རོ།",
    "ཡན་ལག་དང་ཉིང་ལག་གཏུབས་༩པས་འོང་ཞིང་རྫས་ཀྱང་སྦྱིན་པར་བྱེད་དོ།",
    "གང་དག་རིག་པ་མཆོག་རྡོ་རྗེའི་རིག་སྔགས་དང་བཅས་གསང་ཆེན་དང་བཅས་པར་འཛིན་པ་དེ་དག་ལ་གླགས་མ་ཚོལ་༧ཅིག།",
    "བའི་རྣམ་ལྔས་ལུས་སྦྱང་བ་བྱས་ལ།",
    "དེ་ལ་ཡང་འཇིགས་པར་མི་བྱའོ།",
    "ཡང་ལན་བརྒྱ་སྟོང་སྦྱིན་སྲེག་བྱས་ན་དེ་ནས་མི་མི་སྡུག་པ་ཞིག་འོང་སྟེ་༡༢།",
    "དེ་ལ་ཡང་འཇིགས་པར་མི་བྱའོ།",
    "དེས་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་གང་སྨྲས་པ་དེ་དྲན་པར་བགྱིས་ལ་དེ་བཞིན་གྱིས་ཤིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེའི་འོག་ཏུ་རིག་སྔགས་སྒྲུབ་པ་ལ་ལོག་འདྲེན་དེ་དག་དངོས་གྲུབ་སྦྱིན་པར་འགྱུར།",
    "ཉིན་གཅིག་བཞིན་ཀཱར་ཥཱ་པ་ཎ་༡་ཉི་ཤུ་སྦྱིན་པར་འགྱུར།",
    "ཡིད་ལ་གང་ཅི་བསམས་པ་དེ་ཐམས་ཅད་བྱེད་པར་ཡང་ལའགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་གཞན་ཡང་བརྗོད་པར་བགྱིའོ།",
    "གང་གླགས་རྣམ་པར་ཚོལ་བ་དེའི་མགོ་ཚལ་པ་བརྒྱར་འགས་སོ།",
    "མེ་ཏོག་དང་བདུག་ཙི་པས་བརྒྱན་སྒྱུ་རིཔ་བགྱིས་ལ་རིག་པ་དཔག་ཏུ་མ་མཆིས་པར་བཟླས་བརྗོད་བགྱིས་ན་དགུང་ཕྱེད་ཀྱི་དུས་ན་ལོག་འདྲེན་རྣམས་མཆི་སྟེ།",
    "བགེགས་བརྒྱད་ཁྲི་གཙུག་ཕུད་འཕྱང་བ་ཞེས་༡བགྱི་བའི་བགེགས་དེ་༢སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ན་བགེགས་བགྱིད་པ་ལགས་ཏེ།",
    "དེའི་བར་དུ་བསྒྲུབ་པར་བགྱིའོ།",
    "དེ་ནས་༡བཅོམ་ལྡན་འདས་ཡིད་ཀྱིས་གང་བསམས་པ་དེ་ཐོབ་པར་མཛད་དུ་གསོལ།",
    "བྱིས་པ་ལོག་འདྲེན་གྱིས་ཟིན་ན་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་བརྗོད་བྱས་༢པའི་སྤོས་ཆུས་བཀྲུས་ན་གཏོང་ངོ།",
    "མཚན་གཅིག་མཆིས་པར་རིམཆིས་ལ་ཅི་འབྱོར་པས་མཆོད་དེ།",
    "ལོག་འདྲེན་རྣམས་སྙོངག་ཉན་པར་ཡང་འགྱུར་རོ།",
    "ཡར་གྱི་ངོ་༩ཚེས་བརྒྱད་ནས་བརྩམས་ལ་འཕགས་པ་ལག་ན་༡་རྡོ་རྗེའི་མདུན་དུ་ནང་པར་རིག་པ་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་བརྗོད་བགྱིའོ།",
    "ཡོན་ཏན་བསམ་གྱིས་མི་ཁྱབ་པའི་ཁེལས་བརྗོད་པར་བགྱིའོ།",
    "དགུང་གསུམ་དུ་སྨྱུང་བ་བགྱིས་ལ་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ནྱ་གྲོ་དྷའི་ཤིང་གཅིག་པུ་མཆིས་པར་མཆིས་ལ།",
    "དྲི་དང་མེ་ཏོག་དང་བདུག་པས་བརྒྱན་ཚཔར་བགྱིའོ།་།",
    "དེས་རིག་སྔགས་འཆང་ལ་བསྐོར་བ་བགྱིས་ནས་སྤྱི་བོར་ནུབ་པར་འགྱུར་རོ།",
    "བསམས་པ་ཙམ་གྱིས་ལྷའི་རིགས་ཐམས་ཅད་འགུགས་དཔར་བགྱིད་དོ་༥༤།",
    "ལོ་ཁྲི་བདུན་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "དེའི་བསམས་པ་དང་དགོས་པ་ཐམས་ཅད་འབྱོར་པར་འགྱུར་རོ།",
    "དངོས་གྲུབ་འདིས་༦ལྷ་ཐམས་ཅད་དང་རིག་སྔགས་འཆང་ཐམས་ཅད་མདུན་དུ་༧གནས་པར་འགྱུར་རོ།",
    "མཚན་གཅིག་མཆིས་པར་མཆིས་ལ་ཤམ་༡༡ཐབས་སེར་པོ་བགོ་ཞིང་བསྒྲུབ་པར་བགྱིའོ།་།",
    "དེས་རིག་སྔགས་འཆང་ལ་༡བསྐོར་བ་བགྱིས་ནས་མགོ་བོར་ནུབ་པར་འགྱུར་ནཏེ།་",
    "ལོ་དགུ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "ལོག་འདྲེན་ཐམས་ཅད་ཀྱིས་མི་ཚུགས་པ་ལགས་ཏེ།་",
    "དེའི་འོག་ཏུ་སྒྲུབ་པ་པོ་ལག་ན་པོག་པོར་༡༥ཐོགས་པར་བྲིའོ།",
    "དེས་ཡིད་ཀྱིས་གང་བསམས་པ་དེ་འབྱོར་པར་འགྱུར་ཏེ་།",
    "མ་བསྒྲུབས་ཀྱང་༢ལས་རྣམས་སུ་འགྱུར་བ་ལགས་ཏེ།",
    "སྩལ་ན་ཆབ་ལ་ནི་༡་མི་འབྱིང་བ་བགྱིས་པར་འགྱུར་རོ།",
    "ཞེས་བགྱིས་ཏེ་ཛོ་སྐུཆབ་ཏུ་དོར་ན་གྲུ་མི་འགུལ་བར་༥བགྱིས་པར་འགྱུར་རོ།",
    "མར་གྱི་ངོ་ཞག་བཞི་ལ་ཉིན་༦ཞག་གཅིག་སྨྱུང་བ་བགྱིས་ཏེ་མཚན་གཅིག་མཆིས་པར་༧རིམཆིས་ལ།",
    "ཤུ་དག་ལ་ལན་ཉི་ཤུ་རྩ་གཅིག་བཟླས་བརྗོད་བགྱིས་ཏེ་སོ་ཕྲག་ཏུ་སྩལ་ན་ཤགས་འགྱེད་པའི་ཚེ་གཞན་གྱིས་ལན་མི་ཐེབས་པར་སྨྲ་བར་འགྱུར་རོ།་།",
    "ཟ་གཅིག་པར་བགྱིའོ།",
    "ལོ་བདུན་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "བདག་མི་སྡུག་པར་ཡང་སྟོན་ཏོ།",
    "ཚེ་ལོ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "ལོ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "དཔག་ཚད་སྟོང་ཚུན་ཆད་མཐོང་ཞིང་སྒྲ་ཡང་ཐོས་སོལོ་ཁྲི་ཉིས་༥སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "ལག་ན་རྡོ་རྗེ་གྲུབ་པར་འགྱུར་རོ།",
    "ལོ་དགུ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "གང་རིག་པའི་རྒྱལ་པོ་བསྒྲུབ་པར་འཚལ་བ་དེས་མར་གྱི་༡༡ངོ་ཞག་བརྒྱད་ནས་གཟུང་༡༢སྟེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རིག་པའི་མཆོག་འགྲུབ་པར་འགྱུར་ཏེ།",
    "དེ་༡་གྲུབ་པས་ཆོ་ག་རྒྱས་པ་ཐམས་ཅད་གྲུབ་པར་འགྱུར་རོ།་།",
    "ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་གྱིས་འགལ་བར་བགྱི་བ་མ་ལགས་པ།",
    "དེ་ནས་ལག་ན་རྡོ་རྗེས་ཐམས་ཅད་དང་ལྡན་པའི་འཁོར་འདུས་པ་ལ་རྣམ་པར་བལྟས་ནས་ལྷ་དེ་དག་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "གྲོགས་པོ་ཁྱེད་ལོངས་ཤིག་ངའི་དམ་ཚིག་ལ་ཡང་དག་པར་ལགནས་པར་གྱིས་ཤིག།",
    "བཅོམ་ལྡན་འདས་ལག་ན་རྡོ་རྗེ་འདི་ནི་མཆོག་ཏུ་མི་བཟད་པ་ལགས་སོ།",
    "ལོག་འདྲེན་རྣམས་ངེས་པར་བརླག་པར་བགྱིད་པ།་",
    "རྡོ་རྗེའི་རིགས་ཐམས་ཅད་སྐྲག་པར་བགྱིད་པ།",
    "བཅོམ་ལྡན་འདས་འགུམ་པར་ལབགྱིད་པ།",
    "ཆད་པས་གཅོད་པ་ལགས་སོ།",
    "གནོད་པར་བགྱིད་པ་དང་།",
    "ཕུར་བུས་གདབ་པར་བགྱིད་པར་འཚལ་བས་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ཞག་གསུམ་སྨྱུང་བ་བགྱིས་ཏེ།",
    "ལྷ་རྣམས་ཀྱང་གཡོས་པར་བགྱིད་པར་འགྱུར་རོ།",
    "གནོད་སྦྱིན་རྣམས་ཀྱང་ཕུང་བར་བགྱིད་པར་འཚལ་བས་གང་ནས་༧གནོད་སྦྱིན་ནམར།",
    "བདེ་བར་གྱུར་ཅིག་ཅེས་བརྗོད་པར་བགྱིའོ།",
    "སྦེད་པར་༢བགྱིད་དོ།",
    "དེ་ནས་རྨི་ལམ་དུ་ལོག་འདྲེན་རྣམས་བྱེད་ཅིང་༥ཅི་བྱ་གཏོལ་མེད་པར་མཐོང་ངོ།",
    "དེའི་ནང་ནས་མི་ཅིག་ཅའདི་སྐད་ཅེས་ཀྱེ་རིག་སྔགས་འཆང་བདག་ཅག་ལ་གནོད་པ་མ་༥མཛད་པར་འདི་སྣོམས་ཤིག་ཅེས་སྨྲའོ།",
    "དེ་ནས་ནང་པར་ཏི་ན་ར་ཅིག་སྩལ་༦ལོ།",
    "བསྒྲུབ་པའི་དུས་ན་ཡང་བདུག་པ་འདི་ཉིད་ཀྱིས་བདག་ལ་བདུགས་ན་ལོག་འདྲེན་ཐམས་ཅད་ཉམས་པར་འགྱུར་རོ།",
    "རྡོ་རྗེའི་རིགས་སྐྲག་པར་བགྱི་ན་ལྕེ་འབབ་པས་བཅག་པའི་ཤིང་བླངས་ལ་མར་གྱི་ངོ་ཞག་གཅིག་སྨྱུང་བ་བགྱིས་ཏེ།",
    "དེ་ལྟར་ཆོ་ག་རྒྱས་པ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "བརྒྱས་ཚར་གཅོད་པར་འགྱུར་རོ།",
    "སུམ་བརྒྱས་སྐམ་༥པར་འགྱུར་རོ།",
    "བཞི་བརྒྱ་པའི་ཚེ་ལག་ན་རྡོ་རྗེ་ལ་ཕུར་བུས་བཏབ་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་ཀྱང་ཕུར་བུས་བཏབ་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ཆོ་ག་རྒྱས་པའི་༦དངོས་གྲུབ་བདག་ལ་སྩལ་དུ་སྩོལ་༥༧ཞེས་བརྗོད་པར་བྱའོ།",
    "དེ་ནས་སོས་པར་འགྱུར་རོ།",
