    "རྒྱ་རུས་རྭ་དུག་མངལ་འགགས་འབྱིན་པར་བྱེད།",
    "དུང་མཁན་ལྕེ་ཡིས་འཁྲུ་བ་གཅོད་པར་བྱེད།",
    "གྲེ་བ་སོགས་ལ་ཉ་རུས་ཟུག་པར་ཕན།",
    "མ་ཞུ་འཇུ་དང་ཁྱད་པར་ཤ་འཇུ་བྱེད།",
    "མགུལ་བའི་ལྦ་བ་འཇོམས་པར་བྱེད་པ་ཡིན།",
    "གླང་མཁྲིས་སྦྱར་དུག་མིག་ལ་ཕོག་པར་ཕན།",
    "བྱི་ལའི་རུས་པས་མཚན་པར་རྡོལ་བ་སེལ།",
    "རྩ་སྡོམ་རྨ་གསོ་ཤའུ་སྐྱེད་པར་བྱེད།",
    "བྱི་བའི་པགས་རློན་རྣག་སྣ་འདྲེན་པར་བྱེད།",
    "མགོ་དང་ལུས་ཀྱི་གཟེར་ཀུན་འཇོམས་པར་བྱེད།",
    "མུར་འགྲམ་སྐྲ་ཡིས་སྦྱར་དུག་རྟོགས་པར་བྱེད།",
    "གཞོབ་ཀྱིས་སྐྲངས་པ་རྣག་ཏུ་འགུགས་པར་བྱེད།",
    "གོ་སྒྲོས་གདོན་འཇོམས་ཆུ་རྣམས་སྐེམ་པར་བྱེད།",
    "སྐྲན་བཤིག་ལྷེན་དང་ལྕགས་དྲེག་འགོག་པར་བྱེད།",
    "སྐྲངས་པ་འཇོམས་དང་རྣག་ཏུ་འགུགས་པར་བྱེད།",
    "བོང་ནག་སྦངས་ཀྱིས་རྨ་ལ་ཕན་པར་བྱེད།",
    "ནས་ཟན་བྲུན་གྱིས་སྐྱིགས་བུ་འཇོམས་པར་བྱེད།",
    "བྱང་ཁོག་རྨ་ལ་ཕན་པར་བྱེད་པ་ཡིན།",
    "མཛེ་དང་སྐྱ་རྦབ་མགོ་འཁོར་སྐྱེད་པར་བྱེད།",
    "ཡོན་ཏན་གོང་མཚུངས་ཁྱད་པར་རྟུག་སྐམ་སླ།",
    "དྲོད་སྐྱེད་ཟས་འཇུ་ཡི་ག་འབྱེད་པར་བྱེད།",
    "བུ་དང་ཟུག་རྔུ་འབྱིན་པར་བྱེད་པ་ཡིན།",
    "བལ་སྲན་དུག་འབྱིན་ཆུ་འབེབས་འཇིག་པར་བྱེད།",
    "སྐྱོ་མས་འབྱར་བྱས་སྐྲངས་པ་རྣག་ཏུ་འགུགས།",
    "ཆམ་པ་རིམས་གསར་འཕྲལ་དུ་ལྡོག་པར་བྱེད།",
    "ནངས་པར་འཐུངས་པ་བཅོས་པའི་དུག་ཆུ་སྟེ།",
    "གདོན་ལ་ཕན་གསུངས་དཀར་བོས་བས་ལྡག་དང་།",
    "ལ་ཕན་སྔོན་པོས་ལྷག་པར་མཛེ་དུག་འཇོམས།",
    "ལྷག་པར་རྙིང་བའི་ཚད་པ་གཏིང་ནས་འདོན།",
    "ལྷེན་སྐྲན་དང་ནི་ལྕགས་དྲེག་གཅོད་པར་བྱེད།",
    "རྨ་དང་འབྲུམ་པའི་རྣག་ཆུ་སྐེམ་པར་བྱེད།",
    "བུ་འཛིན་ཚི་གུ་སྦྱར་བ་བསྟེན་བྱས་ན།",
    "འབམ་པོའི་ཁཎྜས་ཁོང་སྐྲན་བཤིག་པར་བྱེད།",
    "ནུས་པ་བསྟན་འདི་ངེས་པར་བློར་ལོན་ཅིང་།",
    "འཚོ་མཛད་མཁས་པའི་གྲལ་དུ་ཆུད་པར་འགྱུར།",
    "ཁྱད་པར་མན་ངག་ཁ་ཚར་གྱིས།",
    "ཐང་དུ་གསུངས་ཀྱང་ཕྱེ་རིལ་ཆུ་སྐོལ་དབུལ།",
    "སྐྱ་རྦབ་ས་ཆུ་མི་ཐུབ་པར།",
    "དེ་རྣམས་རང་བཞིན་དྭངས་པར་འགྱུར་བ་ཡིན།",
    "ལྕེ་འབམ་འཇོམས་ཤིང་ཁྱད་པར་དུ།",
    "༢༨ སྐྱེར་བའི་ཁཎྜ་ཆུ་གཙང་སྦྱར་བླུག་པས།",
    "ཁྱད་པར་བད་ཚད་སེལ་བར་འདི་རང་བསྔགས།",
    "བྱིས་པའི་དུས་སུ་གསུངས་ཀྱང་ཀུན་ལ་བསྔགས།",
    "ཁྱད་པར་ས་བོན་འཛག་པ་གཅོད་པ་སྟེ།",
    "ཁྱད་པར་ཐིག་ནག་འབམ་དང་གྲུམ་བུ་འཇོམས།",
    "ཁྱད་པར་བཙས་རྗེས་སྲིན་གླང་འགྲིལ་རོ་ལ།",
    "བཏབ་པས་རྨ་རིགས་འཕྲལ་དུ་གསོས་པར་འགྱུར།",
    "ཁྱད་པར་མགོ་ཡི་རུས་སྐྱོན་ཆེ་འབྲིང་ཆུང་།",
    "ཁྱད་པར་དང་ག་འབྱེད་ལ་མེ་དྲོད་སྐྱེད།",
    "མཆིན་ཆུ་བླུགས་ཤིང་སྒྲེག་པར་བཅས།",
    "གྲངས་འདས་གསུངས་ཀྱང་རྩ་ཆུ་འགགས་པ་ལ།",
    "ཁྱད་པར་དུ་ཡང་འདི་ཉིད་བསྟེན་པར་བྱ།",
    "རིམ་པས་གསང་བའི་ལམ་ནས་འདྲོངས་པར་ངེས།",
    "ཁྱད་པར་ཚད་པ་གཉན་བསྡོངས་སྨིན་མ་སྨིན།",
    "བསྟེན་ན་མྱོང་བས་གྲུབ་པ་ཁྱད་པར་འཕགས།",
    "བསྟེན་ན་ལྦ་བ་རྩད་ནས་འབྱིན་པར་བྱེད།",
    "ཚད་པ་གསར་རྙིང་མ་ལུས་འཇོམས་པར་ངེས།",
    "ཁྱད་པར་ཚད་རྙིང་བྱེར་བ་གཏིང་ནས་འདོན།",
    "འཁྲུ་བ་གསར་རྙིང་མ་ལུས་གཅོད་པར་བྱེད།",
    "བྱིས་པ་རྒན་པོ་ཟུངས་ཟད་མ་གཏོགས་པར།",
    "འཁྲུགས་རིམས་གཉན་ཚད་སྤྱི་དང་ཁྱད་པར་དུ།",
    "གསར་རྙིང་མ་ལུས་སེལ་ཞིང་སྨིན་པར་བྱེད།",
    "༡༢༢མ་ནུ་བཞི་ཐང་རིམས་ཚད་སྨིན་པར་བྱེད།",
    "དུག་འདོན་འཇམ་བཙལ་འཕྲོད་པར་སྦྱར་བའོ།",
    "སྐྱེ་ས་ས་གཙང་ཉམས་དགའ་ས་གཞི་གཤིན།",
    "ལུས་ཟུངས་རྒྱས་པར་བྱེད་ལ་ཨ་རུ་ར།",
    "ཚ་སེལ་གྲང་སེལ་གཉིས་སུ་ཤེས་པར་བྱ།",
    "བློན་འབངས་དམག་དཔོན་དམག་མི་ཆིབས་པར་བཅས།",
    "ཆུ་འཐུང་ཚད་པ་གཅོག་པར་བྱེད་པ་ཡིན།",
    "ཕྱེ་མའི་སྐབས་ལས་ཅུང་ཉུང་བ་བྱས་ཏེ་གཟན་ཆས་དང་སྦྱོར་ནས་ཡང་ཡང་ཉུང་ངུར་བསྟེན་པ་དང་།",
    "ཆུ་ཅུང་ཟད་བླུག་ཆུ་མ་དགོས་པར་ལ་ཁུ་བྱུག་རྒྱུ་བྱུང་ན་ལེགས།",
    "སྐ་རྩ་ཞོ་ཙམ་བྱས་ནས་མེའི་ཐོག་ཏུ་དྲོད་བརྒྱབ་ནས།",
    "གཟེར་གང་ཡོད་ལ་ཁྱབ་པར་བྱུགས།",
    "ཅིས་ཀྱང་གཏར་རྒྱུ་བྱས་ན་དཀར་ཡོལ་ལམ་ཕོར་བ་འབྲིང་ཚད་ཀྱི་ཕྱེད་ཐུན་ཙམ་ལས་གཏར་མི་ཉན།",
    "མེ་གཏར་རྒྱུ་ཅི་བྱས་ཀྱང་ལུམས་དང་།",
    "ཚ་ཉལ་སོགས་བྱས་ན་ཕན་ཆེ།",
    "དེའི་གཟེར་ཆགས་ནས་ལ་བཅོས་བྱས་པས་འཐུས།",
    "དོན་མེད་པར་སེམས་སྡུག་དེ་ལ་གདོན་ཅན་དང་།",
    "འོན་ཀྱང་འདི་ལ་དྲོད་ཆེ་རིགས་ནི་མི་འཕྲོད་པར་ཤེས་དགོས།",
    "ནོར་གྱི་སྲེ་ལོང་གསར་བ་ལྤགས་ཕུད་པ་དུམ་བུ་བདུན་བྱས་པའི་དུམ་གཉིས་ཙམ་ཞག་བཅད་ནས་ཉིན་གསུམ་བཏང་།",
    "རྒས་པོ་སོགས་ལ་ཆུ་དྭངས་ཡང་ལ་ཕུག་ལེགས་པར་བཏང་དགོས།",
    "ཁྱུང་ལྔ་བཟང་བོ་སོ་བར་བཟུང་བ་སོགས་ཡིན་ལགས།",
    "མཛོ་གཅིན་ལྕི་བ་སོགས་ཀྱིས་འབྱར་བྱས་པས་ཞི།",
    "དམར་བོ་སྤྱི་འཇོམས་བཟི་མེད་ཀྱིས་སྦྱངས་ཀྱང་ཟབ་ལགས།",
    "བཅད་སྔ་བྱས་ན་གཟེར་ཆེ་འོང་བས་མཚམས་ཤེས་དགོས།",
    "དང་བོ་གདལ་མེ་བཞག་པས་འཐུས་པ་ལགས།",
    "སྐར་གསུམ་ཡིན་པས་ཤེས་པར་བྱའོ།",
    "ལུས་སྤྱིའི་འདུ་བ་སྙོམས་པར་བྱེད།",
