    "ཞིང་རྣམས་རྒྱ་མཚོ་རྣམ་པར་དག་བྱེད་ཅིང་།",
    "ཡེ་ཤེས་རྒྱ་མཚོ་རབ་ཏུ་རྟོགས་པར་བྱེད།",
    "སྤྱོད་པ་རྒྱ་མཚོ་རྣམ་པར་དག་བྱེད་ཅིང་།",
    "བསྐལ་པ་རྒྱ་མཚོར་མི་སྐྱོ་སྤྱད་པར་བགྱི།",
    "མཁས་པ་དེ་དང་མཚུངས་པར་སྤྱད་པའི་ཕྱིར།",
    "དེ་འདྲར་བདག་ཀྱང་དེ་དང་མཚུངས་པར་ཤོག།",
    "དེ་ཡི་བྱ་བ་མ་ལུས་རྫོགས་པར་བགྱི།",
    "ཡོན་ཏན་རྣམས་ཀྱང་ཚད་གཟུང་མེད་པར་ཤོག།",
    "ནམ་མཁའི་མཐར་ཐུག་གྱུར་པ་ཇི་ཙམ་པར།",
    "མི་ཚེ་འདིར་ཡང་དེ་དག་ལེགས་པར་འོང་།",
    "རིགས་དང་ཁ་དོག་རྣམས་དང་ལྡན་པར་འགྱུར།",
    "འཇམ་དཔལ་ཇི་ལྟར་མཁྱེན་ཅིང་དཔའ་བ་དང་།",
    "ཐམས་ཅད་མ་ལུས་མངོན་དུ་གྱུར་པར་ཤོག།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་ལ།",
    "ཐ་དད་པ་ཡང་དག་པར་ཤེས་པ་དང་།",
    "བཅོམ་ལྡན་འདས་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བ་ན་བཞུགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ད་ལྟར་འཇིག་རྟེན་ན་རྣམ་པ་གཅིག་ཏུ་མིར་སྐྱེས་པར་མཚུངས་པ་ལ།",
    "སྒྲ་དབྱངས་མི་མཚུངས་ཤིང་སྐད་ཐ་དད་པར་གྱུར་པ་དང་།",
    "ཁ་ཅིག་ནི་དཔའ་ཞིང་དམན་པར་གྱུར་ལ།",
    "ཁ་ཅིག་ནི་ཡུས་མ་མཆིས་བཞིན་དུ་ཡང་ནོངས་པ་མ་མཆིས་པར་ནན་གྱིས་གོ་རར་སྩལ་བ་དང་།",
    "ཁ་ཅིག་ནི་ཕུ་བོ་ནུ་བོ་སོ་སོར་ཕྱེ་ནས་འཐབ་ཅིང་རྩོད་པར་བགྱིད་པ་དང་།",
    "ཁ་ཅིག་ནི་ཅི་ཡང་མ་བགྱིས་པར་བདེ་བའི་རྣམ་པར་སྨིན་པ་མྱོང་བར་འགྱུར་ལ།",
    "ཁ་ཅིག་ནི་བཙལ་ན་གདོད་ཐོབ་པར་འགྱུར་ལ།",
    "ཁ་ཅིག་ནི་མ་བཙལ་བར་ཡང་རྙེད་པར་འགྱུར་བ་དང་།",
    "ཁ་ཅིག་ནི་སྲོག་ཆགས་དཔག་ཏུ་མ་མཆིས་པ་དག་གསོད་པར་བགྱིད་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་མྱོང་བར་མི་མཚུངས་པར་གྱུར་པ་དེ་དག་ཐམས་ཅད་ནི་ཚེ་རབས་སྔ་མ་དག།",
    "མིར་གྱུར་ཀྱང་དབུལ་པོར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་སེར་སྣ་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "ཡ་རབས་མཐོན་པོར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་གཞན་དག་ལ་གུས་པར་ཕྱག་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མ་རབས་སུ་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་ང་རྒྱལ་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་ལུས་རིང་ཞིང་བོང་ཆེ་བ་གང་ཡིན་པ་དེ་ནི་གུས་པས་བཀུར་སྟི་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་བཀའ་བློ་མི་བདེ་བ་གང་ཡིན་པ་དེ་ནི་སྔོན་ལུག་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་མིག་དམར་བ་གང་ཡིན་པ་དེ་ནི་མེའི་སེར་སྣ་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་ལུས་ཀྱི་ཤ་བྲུར་ལྟ་བུར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་གོས་ཡང་ཞིང་སྲབ་པ་དག་བགོས་ནས་དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་ཀྱི་སྤྱན་སྔར་འོངས་པ་ལས་གྱུར་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་སྒུར་པོར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་གོས་ཡང་ཞིང་སྲབ་པ་དག་བགོས་ནས་ཕན་ཚུན་དུ་འགྲོ་བའི་ཚེ་དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་ལ་རྒྱབ་ཀྱིས་ཕྱོགས་པ་ལས་གྱུར་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་མི་བརྟན་ཞིང་ཡང་བ་གང་ཡིན་པ་དེ་ནི་སྔོན་སྤྲེའུ་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་གཙང་སྦྲ་མེད་པ་གང་ཡིན་པ་དེ་ནི་ཕག་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་འདོད་ཆེན་ཆེ་བ་གང་ཡིན་པ་དེ་ནི་ཁྱི་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "གོས་རིང་པོ་གྱོན་པར་དགའ་བ་དེ་ནི།",
    "ཤི་འཕོས་ནས་སྲིན་བུ་མཇུག་རིངས་བྱེད་པར་འགྱུར་རོ།",
    "ཉེས་པ་མེད་པར་དགྲ་ལ་རྣམ་པར་འཚེ་བ་གང་ཡིན་པ་དེ་ནི་ཤི་འཕོས་ནས་སྲིན་བུ་འཁོན་དུ་འཛིན་པའི་སེམས་དང་བཅས་པ་དག་ཏུ་སྐྱེ་བར་འགྱུར་རོ།",
    "གཞན་གྱི་དབྱེན་བྱེད་པར་དགའ་བ་གང་ཡིན་པ་དེ་ནི་ཤི་འཕོས་ནས་སྲིན་བྱ་དག་ཏུ་སྐྱེ་བར་འགྱུར་རོ།",
    "རུས་པ་དག་ཐོགས་ནས་གཙུག་ལག་ཁང་དུ་འཇུག་པར་བྱེད་ན་བྱ་མཆུ་རིངས་སུ་སྐྱེ་བར་འགྱུར་རོ།",
    "དམར་རྩི་དང་དཀར་རྩི་དག་མཆུ་ལ་བསྐུས་ནས་གཙུག་ལག་ཁང་དུ་འཇུག་པར་བྱེད་ན་བྱ་མཆུ་དམར་བ་དག་ཏུ་སྐྱེ་བར་འགྱུར་རོ།",
    "ལྷམ་བགོས་ཏེ་དེ་བཞིན་གཤེགས་པའི་དྲི་གཙང་ཁང་དུ་འགྲོ་བར་བྱེད་ན་སྦལ་པར་སྐྱེ་བར་འགྱུར་རོ།",
    "སྡོམ་པ་ཡང་དག་པར་བླངས་ནས་ཉེས་པ་འཆགས་པར་བྱེད་པ་དང་།",
    "རལ་གྲི་ལྟ་བུའི་རི་ལོ་མ་ཅན་གྱི་ལྗོན་ཤིང་ལ་འཛེག་པ་ལ་སོགས་པའི་སྡུག་བསྔལ་གང་ཡང་མི་མྱོང་བ་མེད་པར་འགྱུར་ཏེ།",
    "ནུར་བའི་སེམས་སྐྱེ་བ་མེད་པར་དེ་བཞིན་གཤེགས་པའི་བཀའ་སྩལ་པ་བཞིན་བྱེད་ན།",
    "གཞན་ཡང་དར་གྱི་སྲིན་བུར་སྐྱེས་ནས་འཚེད་པར་འགྱུར་རོ།",
    "ཚེ་འདི་ལ་མང་དུ་འདོད་པས་ལོག་པར་གཡེམ་པ་གང་ཡིན་པ་དེ་ནི་ཤི་འཕོས་ནས་ཟངས་ཀྱི་ཀ་བ་རབ་ཏུ་འབར་བ་ལ་འཇུ་བ་དང་།",
    "ཤ་རྣམས་མ་ལུས་པར་ཟོས་ནས་རུས་པ་དང་རྒྱུས་པ་རྣམས་ཀྱང་འཐོག་པར་བྱེད་པས་སྡུག་བསྔལ་དཔག་ཏུ་མེད་པ་དག་མྱོང་བར་འགྱུར་རོ།",
    "ཉམ་ང་བ་དག་ལ་འབྱོལ་བ་མེད་པ་གང་ཡིན་པ་དེ་ནི་སྔོན་རྟ་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "ཚ་བ་དག་བཟོད་ཅིང་སེམས་ལ་འཛིན་པ་མེད་པ་གང་ཡིན་པ་དེ་ནི་སྔོན་གླང་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "གྲང་བ་མང་ཞིང་ལེགས་ཉེས་ཀྱི་བྱེ་བྲག་མི་ཕྱེད་པ་གང་ཡིན་པ་དེ་ནི་སྔོན་བོང་བུ་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་རྟག་པར་ཤ་ལ་བརྐམ་ཞིང་བྱ་བ་དག་ལ་འཇིགས་པ་མེད་པ་གང་ཡིན་པ་དེ་ནི་སྔོན་སེང་གེ་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "བུ་དང་ཆུང་མ་ལ་སྡང་བ་གང་ཡིན་པ་དེ་ནི་སྔོན་སྟག་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "འདོད་ཆགས་ཆུང་ཞིང་ཆུང་མ་ལ་སྲེད་པ་མེད་པ་གང་ཡིན་པ་དེ་ནི་སྔོན་སྤྱང་ཀི་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མ་ཡིན་པ་བྱས་པ་དག་ལ་རྟོག་པ་དང་།",
    "གཉིད་ཆུང་ཞིང་ཞེ་སྡང་མང་བ་གང་ཡིན་པ་དེ་ནི་སྔོན་ཁྱི་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "སྨྲ་བའི་ཚེ་ལྦུ་བ་འབྱུང་ཞིང་ཉལ་ན་གོས་ཀྱིས་ལུས་དཀྲི་བར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་སྔོན་སྦྲུལ་དང་རྩངས་པ་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "མིར་གྱུར་ཀྱང་གཅིག་པུ་དབེན་པར་གནས་ཤིང་ཟས་ལ་བརྐམ་པ་དང་།",
    "རི་དགས་ཀྱི་ལུས་ལེན་པར་འགྱུར་རོ།",
    "བརྒྱ་ལམ་ན་མིའི་ལུས་ཐོབ་པར་གྱུར་ན་ཡང་མ་ནིང་དང་།",
    "བརྒྱ་ལ་བརྒྱ་ལམ་ན་མིའི་ལུས་ཐོབ་པར་གྱུར་ན་ཡང་ཁྱིམ་བྱ་དང་།",
    "གྲོག་མ་ལ་སོགས་པའི་ལུས་ལེན་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་མིའི་ལུས་ཐོབ་པར་གྱུར་ན་ཡང་འོན་པ་དང་།",
    "མིར་གྱུར་ཀྱང་ཁེངས་ཤིང་ང་རྒྱལ་ཆེ་བ་གང་ཡིན་པ་དེ་ནི་ཤི་འཕོས་ནས་མི་གཙང་བའི་གནས་ཀྱི་སྲིན་བུ་དང་།",
    "བཏུང་བ་མང་པོ་ཐོབ་པར་མི་འགྱུར་རོ།",
    "ཕྱག་བྱས་པ་གང་ཡིན་པ་དེ་ནི་རྟག་པར་ཆོ་རིགས་བཙུན་པར་འགྱུར་ཞིང་རྒྱུན་དུ་བདེ་བ་མྱོང་བར་འགྱུར་རོ།",
    "ཚེ་འདི་ལ་ཁྲོ་སྐྱེན་ཞིང་ལྟོ་ལ་འཁོང་བ་གང་ཡིན་པ་དེ་ནི་སྔོན་སྨྱོན་པ་བྱས་པ་ལས་འོངས་པ་ཡིན་ནོ།",
    "བརྒྱ་ལ་མིའི་ནང་དུ་སྐྱེས་པར་གྱུར་ན་ཡང་ལུས་སྐྲང་ཞིང་དབུགས་ཐུང་བས་འཆི་བའི་དུས་བྱེད་པར་འགྱུར་རོ།",
    "འབྲིང་གང་ཡིན་པ་དེ་ནི་དུད་འགྲོའི་སྐྱེ་གནས་ཀྱི་རྒྱུ་དང་རྐྱེན་བྱེད་པར་འགྱུར་རོ།",
    "ཐ་མ་གང་ཡིན་པ་དེ་ནི་ཡི་དགས་ཀྱི་རྒྱུ་དང་རྐྱེན་བྱེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་མིར་སྐྱེས་པར་གྱུར་ན་ཡང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་རྣམ་པ་གཉིས་འཐོབ་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་མིར་སྐྱེས་པར་གྱུར་ན་ཡང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་རྣམ་པ་གཉིས་འཐོབ་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་མིར་སྐྱེས་པར་གྱུར་ན་ཡང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་རྣམ་པ་གཉིས་འཐོབ་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་མིར་སྐྱེས་པར་གྱུར་ན་ཡང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་རྣམ་པ་གཉིས་འཐོབ་པར་འགྱུར་ཏེ།",
    "རྟག་པར་གཞན་གྱིས་མང་དུ་བསླུས་པར་འགྱུར་བ་གང་ཡིན་པའོ།",
    "གལ་ཏེ་མིར་སྐྱེས་པར་གྱུར་ན་ཡང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་རྣམ་པ་གཉིས་འཐོབ་པར་འགྱུར་ཏེ།",
    "རྟག་པར་སྒྲ་མི་སྙན་པ་ཐོས་པར་འགྱུར་བ་དང་།",
    "གལ་ཏེ་མིར་སྐྱེས་པར་གྱུར་ན་ཡང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་རྣམ་པ་གཉིས་འཐོབ་པར་འགྱུར་ཏེ།",
    "བདེན་པ་ཞིག་སྨྲས་ན་ཡང་གཞན་དག་ཡིད་ཆེས་པར་མི་འགྱུར་བ་དང་།",
    "གལ་ཏེ་མིར་སྐྱེས་ན་ཡང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་རྣམ་པ་གཉིས་འཐོབ་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་མིར་སྐྱེས་པར་གྱུར་ན་ཡང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་རྣམ་པ་གཉིས་མྱོང་བར་འགྱུར་ཏེ།",
    "རྟག་པར་གཞན་གྱིས་གླགས་ཚོལ་བར་འགྱུར་བ་དང་།",
    "རྟག་པར་གཞན་གྱིས་གནོད་པ་བྱེད་པར་འགྱུར་བ་གང་ཡིན་པའོ།",
    "གལ་ཏེ་མིར་སྐྱེས་པར་གྱུར་ན་ཡང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་རྣམ་པ་གཉིས་འཐོབ་པར་འགྱུར་ཏེ།",
    "རྟག་པར་ལོག་པར་ལྟ་བའི་ཁྱིམ་དག་ཏུ་སྐྱེ་བར་འགྱུར་བ་དང་།",
    "སེམས་གཡོ་སྒྱུ་དང་བཅས་པར་འགྱུར་བ་གང་ཡིན་པའོ།",
    "དེ་བཞིན་གཤེགས་པའི་མཆོད་རྟེན་དང་དྲི་གཙང་ཁང་དང་།",
    "ཕྱོགས་བཅུ་པོ་དག་ཏུ་དོན་གཉེར་བ་རྣམས་ཀྱང་འགྲུབ་པར་འགྱུར་རོ།",
    "འདོད་ཆེན་པ་དག་ལ་སྦྱིན་པ་ཡོངས་སུ་བཏང་ན་རྣམ་པར་སྨིན་པ་སྟོང་འགྱུར་སྙེད་འཐོབ་པར་འགྱུར་རོ།",
    "གཞན་ཡང་གང་ཟག་རྣམ་པ་གསུམ་ལ་སྦྱིན་པ་ཡོངས་སུ་བཏང་ན་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་ཡོངས་སུ་གཏུགས་པར་མི་འགྱུར་ཏེ།",
    "རྟག་པར་ཡོངས་སུ་བཏང་བས་ཡོངས་སུ་གཏུགས་པར་མི་འགྱུར་བ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "རྟག་པར་མིའི་ནང་ན་མཆོག་དམ་པ་གཙོ་བོ་བྱེད་པར་འགྱུར་རོ།",
    "རིམ་གྲོ་བྱེད་པར་འགྱུར་རོ།",
    "གཟུགས་སོགས་སྐྱེ་མཆེད་ཡོད་པར་ནི།",
    "གཟུགས་ལ་སོགས་པའི་དོན་ནི་མེད་ན་གཟུགས་ལ་སོགས་པའི་སྐྱེ་མཆེད་ཡོད་པར་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་གསུང་བར་མི་འགྱུར་རོ་ཞེ་ན།",
    "གཟུགས་སོགས་སྐྱེ་མཆེད་ཡོད་པར་ནི།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དཔེར་ན་འདུས་མ་བྱས་ཀྱི་ནམ་མ།",
    "གཉིས་ཀས་འབྲེལ་བ་སྟོན་པར་ཁྱད་པར་མེད་ཀྱང་།",
    "སྒྲུབ་དག་ལ་བརྟེན་ནས་མཐའ་གཉིས་སུ་དོགས་པའི་ཐེ་ཚོམ་གཅོད་པར་བྱེད་དོ།",
    "ཞེས་གསུངས།"
