    "འོད་ཟེར་འོད་བྱེད་རབ་ཏུ་དགྱེ་བྱས་ཤིང་།",
    "རྒྱལ་བ་མཆོད་ཕྱིར་མྱེ་མར་བཟུང་བྱས་པས།",
    "སྟེགས་དང་ཟམ་པ་གཅིག་སྨིན་བྱས་པ་དང་།",
    "འདུས་བྱས་སུན་ཕྱུང་ཞི་བ་བསྔགས་པས་ན།",
    "འཇིག་རྟེན་སྲེད་པའི་སྐོམ་པ་རྣམ་པར་སེལ།",
    "ཐུགས་རྗེ་མངའ་རྣམས་སྐུ་གཟུགས་མཚན་བརྒྱན་པ།",
    "སྡིག་སེམས་ལྡན་ལ་ཉེས་པ་བཟོད་བྱས་ཏེ།",
    "བཟོད་པའི་ཡོན་ཏན་རྟག་ཏུ་བརྗོད་བྱས་པས།",
    "སྦྱོར་བ་སྐྱོ་བ་མེད་པས་མཆོད་བྱས་ནས།",
    "འདུ་འཛི་ཡོངས་སུ་རྣམ་པར་སྤངས་བྱས་ཏེ།",
    "དེ་དག་རིམ་གྲོར་རབ་ཏུ་བརྗོད་བྱས་པས།",
    "འཇིགས་པས་སྐྱབས་ཚོལ་རྣམས་ལ་བསྐྱབས་བྱས་པས།",
    "དགའ་འགྱུར་རྒྱལ་བའི་སྐུ་གཟུགས་བསྟེན་བྱས་ཤིང་།",
    "འདུས་བྱས་རྟག་ཏུ་བདེ་བ་མེད་པ་སྟེ།",
    "འོད་ཟེར་ཁྱད་པར་ལྡན་པ་རབ་བཀྱེ་ཞིང་།",
    "ཤེས་རབ་ཁྱད་པར་རྒྱལ་བ་རྣམས་ལས་ཉན།",
    "དེས་ནི་འོད་ཟེར་ཁྱད་པར་ལྡན་པ་ཐོབ།",
    "རིན་ཆེན་རྣམ་པར་བརྒྱན་པའི་འོད་ཟེར་གྲུབ།",
    "སྤོས་ཀྱིས་རྒྱལ་བའི་སྐུ་གཟུགས་མཆོད་རྟེན་དག།",
    "བྱས་པས་འོད་ཟེར་སྤོས་མཆོག་སྣང་བ་གྲུབ།",
    "ས་རྣམས་ལག་མཐིལ་བཞིན་དུ་གནས་པར་བྱེད།",
    "མཆོད་རྟེན་དྲང་སྲོང་གནས་རྣམས་སྦྱངས་བྱས་པས།",
    "གོས་མེད་གོས་ཡོད་རྒྱན་དང་ལྡན་པར་འགྱུར།",
    "བཀྲེས་པ་ཁ་ཟས་བྲོ་མཆོག་ཐོབ་པར་འགྱུར།",
    "འོད་ཟེར་ནོར་སྟོན་རབ་ཏུ་དགྱེ་བྱས་ཤིང་།",
    "ཕོངས་པ་རིན་ཆེན་གཏེར་རྣམས་ཐོབ་པར་འགྱུར།",
    "འོད་ཟེར་མིག་སྦྱོང་རབ་ཏུ་དགྱེ་བྱས་ཤིང་།",
    "རྣ་བ་ཉམས་པ་སྒྲ་མང་ཐོས་པར་འགྱུར།",
    "འོད་ཟེར་སྣ་སྦྱོང་རབ་ཏུ་དགྱེ་བྱས་ཤིང་།",
    "འོད་ཟེར་ལྕེ་སྦྱོང་རབ་ཏུ་དགྱེ་བྱས་ཤིང་།",
    "འཇམ་པར་སྨྲ་བས་ལྕེ་སྦྱོང་འོད་ཟེར་གྲུབ།",
    "འོད་ཟེར་ལུས་སྦྱོང་རབ་ཏུ་བཀྱེ་བྱས་ཤིང་།",
    "འོད་ཟེར་སེམས་སྦྱོང་རབ་ཏུ་བཀྱེ་བྱས་ཤིང་།",
    "ཏིང་འཛིན་རྗེས་སུ་སེམས་འགྲོར་རབ་བྱས་པས།",
    "འོད་ཟེར་གཟུགས་སྦྱོང་རབ་ཏུ་དགྱེ་བྱས་ཤིང་།",
    "མཆོད་རྟེན་རྒྱས་བྱས་གཟུགས་སྦྱོང་ཐོབ་པར་འགྱུར།",
    "འོད་ཟེར་སྒྲ་སྦྱོང་རབ་ཏུ་བཀྱེ་བྱས་ཤིང་།",
    "སྒྲ་ནི་སྒྲ་མིན་སྟོང་པར་རབ་ཏུ་ཤེས།",
    "འོད་ཟེར་དྲི་སྦྱོང་རབ་ཏུ་དགྱེ་བྱས་ཤིང་།",
    "འོད་ཟེར་བྲོ་མཆོག་རབ་ཏུ་དགྱེ་བྱས་ཤིང་།",
    "ཡོན་ཏན་དེ་ལ་བསྟང་གྲོགས་སུས་བྱས་པ།",
    "འོད་ཀྱི་རྣམ་བརྒྱན་བྱིན་གྱིས་བརླབས་བྱས་ཤིང་།",
    "ཡོངས་སུ་རྒྱས་སྟོན་ཏིང་འཛིན་རྣམ་པར་འཕྲུལ།",
    "འཁོར་དང་བཅས་པ་བྱིན་གྱིས་བརླབས་བྱས་ཤིང་།",
    "དེ་དག་ཏིང་འཛིན་ཏིང་འཛིན་མེད་པར་སྤྱོད།",
    "དྲང་སྲོང་དེས་ནི་ཡོངས་སུ་སྨིན་བྱས་ཏེ།",
    "ལ་ལ་མཉམ་བཞག་ལ་ལ་ནམ་ལངས་པར།",
    "ཕྱོགས་རྣམས་གཞན་ཏུ་མཉམ་པར་བཞག་བྱས་ཤིང་།",
    "ཞི་བར་རྣམ་པར་སྤྱོད་པ་དེ་དག་སྣང་།",
    "ཞི་བར་རྣམ་པར་སྤྱོད་པ་དེ་དག་སྣང་།",
    "ལ་ལ་མཉམ་བཞག་ལ་ལ་རྣམ་པར་ལོངས།",
    "བསམ་གྱིས་མི་ཁྱབ་གཟུགས་ཀྱང་སྟོན་པར་བྱེད།",
    "གཟུགས་ཀྱི་ལམ་ལ་མཉམ་པར་བཞག་བྱས་ཤིང་།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་སྟོན་པར་བྱེད།",
    "སྒྲ་ཡི་ལམ་ལ་མཉམ་པར་བཞག་བྱས་ཤིང་།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་སྟོན་པར་བྱེད།",
    "དྲི་རབ་མཆོག་ལ་འཇུག་པར་རབ་ཏུ་ཞུགས།",
    "དྲི་ཡི་ལམ་ལ་མཉམ་པར་བཞག་བྱས་ཤིང་།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་སྟོན་པར་བྱེད།",
    "བྲོ་བའི་མཆོག་ལ་མཉམ་པར་བཞག་བྱས་ཤིང་།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་སྟོན་པར་བྱེད།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་སྟོན་པ་བྱེད།",
    "སྟོང་པ་བྱེད་པ་མེད་པར་སྟོན་པ་བྱེད།",
    "གཞོན་ནུ་དར་ལ་བབ་པར་མཉམ་བཞག་ཅིང་།",
    "རྒན་ཞིང་འཁོག་པའི་ལུས་སུ་རྣམ་པར་ལྡང་།",
    "དགེ་སློང་མ་ཡི་ལུས་སུ་རྣམ་པར་ལྡང་།",
    "སློབ་དང་མི་སློབ་ལུས་སུ་རྣམ་པར་ལྡང་།",
    "རང་རྒྱལ་ལུས་ལས་དེ་དག་རྣམ་པར་ལྡང་།",
    "ལྷ་ཡི་ལུས་སུ་དེ་དག་རྣམ་པར་ལྡང་།",
    "འཕྲུལ་ཆེན་ཀླུ་ཡི་ལུས་སུ་རྣམ་པར་ལྡང་།",
    "འཕྲུལ་ཆེན་གནོད་སྦྱིན་ལུས་སུ་རྣམ་པར་ལྡང་།",
    "འབྱུང་པོ་ཀུན་གྱི་ལུས་སུ་རྣམ་པར་ལྡང་།",
    "སྤུ་རྩེ་ཀུན་གྱི་སྒོ་ནས་རྣམ་པར་ལྡང་།",
    "སྐྲ་རྩེ་ཀུན་གྱི་སྒོ་ནས་རྣམ་པར་ལྡང་།",
    "རྡུལ་ཕྲན་གཅིག་ལས་དེ་དག་རྣམ་པར་ལྡང་།",
    "རྡུལ་ཕྲན་མ་ལུས་ཀུན་ལས་རྣམ་པར་ལྡང་།",
    "རྒྱ་མཚོ་རྡོ་རྗེའི་གཞི་ལས་རྣམ་པར་ལྡང་།",
    "རྒྱལ་བའི་འོད་ཟེར་སྒོར་ནི་རྣམ་པར་ལྡང་།",
    "ས་ཡི་གཞི་ལ་མཉམ་པར་བཞག་བྱས་ཤིང་།",
    "ལྷ་ཡི་གཞལ་མེད་ཁང་ནས་རྣམ་པར་ལྡང་།",
    "བསྟན་པར་མཛད་ཀྱང་ཟད་པར་མྱི་རུང་ངོ།",
    "རྒྱལ་བ་ཀུན་གྱིས་དེ་སྐད་མ་གསུངས་མྱིན།",
    "དེ་དག་ཀུན་ལའང་དཔེ་བསྟན་བརྗོད་པར་བྱ།",
    "བསྟན་ན་མྱུར་དུ་རྣམ་པར་དོན་ཤེས་འགྱུར།",
    "ཉི་ཟླ་མཁའ་ལས་རྣམ་པར་རྒྱུ་འདོད་ཞིང་།",
    "འཇིག་རྟེན་ཡིད་འོང་སྒྲས་ཀྱང་ཚིམ་པར་བྱེད།",
    "ལྷ་རྒྱལ་དོན་དུ་རྣམ་པར་འཕྲུལ་བྱེད་ན།",
    "ལྷ་ཡི་ལས་རྣམས་རྣམ་པར་སྨིན་པས་བྱུང་།",
    "ལྷ་རྣམས་བག་མེད་སྤྱོད་པར་ཤེས་གྱུར་ནས།",
    "ཇི་སྙེད་བག་མེད་རྣམ་པར་སྤྱོད་པ་རྣམས།",
    "བརྒྱ་བྱིན་ལྷར་བཅས་རྔ་ཡིས་བསྐུལ་བྱས་ནས།",
    "ལྷ་དང་ལྷ་མིན་འཐབ་པར་གྱུར་པའི་ཚེ།",
    "འཇིགས་མེད་སྟོབས་དང་ཤིན་ཏུ་ལྡན་པར་འགྱུར།",
    "ཐམས་ཅད་སྐད་བཞིན་འགྲོ་ལ་རྣམ་པར་སྒྲོག།",
    "འགྲོ་བ་ཀུན་ཏུ་སྒྲ་བརྙན་བརྗོད་བྱས་ཤིང་།",
    "རྒྱ་མཚོའི་ཀླུ་ནི་རྣམ་པར་རྩེ་བྱེད་ན།",
    "གླིང་བཞི་བཅས་པར་སྤྲིན་ཆེན་རྒྱས་པར་འགེངས།",
    "མི་ཡི་གནས་སུ་སྤོས་མཆོག་འདྲེས་པར་ཏེ།",
    "སྤོས་ཆུའི་རྒྱན་དང་མེ་ཏོག་འདྲེས་པར་འབེབས།",
    "མེ་ཏོག་པར་ཤི་མ་ལའི་ཕྱེ་མ་སྤོས།",
    "པི་ཝང་རྔ་དང་གླིང་བུ་སྙན་པར་རོ།",
    "མེ་ཏོག་པར་ཤི་མ་ལི་ཙམ་པ་ཀའི།",
    "ཁྱིམ་ནས་མི་གཡོ་རྣམ་པར་རྟོག་པ་མེད།",
    "སྐྱེས་བུ་དེ་དག་བརྗོད་བྱས་ཡངས་པ་སྟེ།",
    "དཔའ་བོ་དེ་དག་དཔེ་དང་རྣམ་པར་བྲལ།",
    "ཡེ་ཤེས་མཆོག་དང་ཁྱད་པར་བློ་ལྡན་པའི།",
    "བསྐལ་པར་འཛིན་ཅིང་མགོ་ལ་ཁྱེར་བྱེད་ནའང་།",
    "བདེ་བ་ཀུན་གྱིས་བསྐལ་པར་བསྙེན་བཀུར་ནའང་།",
