    "བདག་ཉིད་གཞན་གྱི་དྲིང་ལ་འཇོག་པར་མི་བྱ་བའི་ཕྱིར་ཏེ།",
    "བདག་ཉིད་གཞན་གྱི་དྲིང་མྱི་འཇོག་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "དེའི་བསམ་པ་དེ་བས་ཀྱང་ཤས་ཆེར་མི་འཕྲོགས་པ་ལ་རྣམ་པར་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "བདག་ཉིད་གཞན་གྱི་དྲིང་འཛོག་པར་མི་འགྱུར་བར་བྱ་བའི་ཕྱིར་ཏེ།",
    "འདི་ལྟ་སྟེ་གཅིག་ལས་རྣམ་པ་ཐ་དད་པར་འགྱུར་བ་བརྗོད་པར་བྱའོ།",
    "མང་པོ་ལས་ཐ་མི་དད་པར་བརྗོད་པར་བྱའོ།",
    "དོན་དང་མཐུན་པའི་ཡི་གེ་བརྗོད་པར་བྱའོ།",
    "ཡི་གེ་དང་མཐུན་པའི་དོན་བརྗོད་པར་བྱའོ།",
    "དངོས་པོ་ཡོད་པ་དང་མཉམ་པ་ཉིད་དུ་བརྗོད་པར་བྱའོ།",
    "དངོས་པོ་ཡོད་པ་མེད་པ་དང་མཉམ་པ་ཉིད་དུ་བརྗོད་པར་བྱའོ།",
    "མཚན་མ་མྱེད་པ་མཚན་མ་དང་མཉམ་པ་ཉིད་དུ་བརྗོད་པར་བྱའོ།",
    "མཚན་མ་མཚན་མ་མྱེད་པ་དང་མཉམ་པ་ཉིད་དུ་བརྗོད་པར་བྱའོ།",
    "མཚན་ཉིད་མྱེད་པ་མཚན་ཉིད་དང་མཉམ་པ་ཉིད་དུ་བརྗོད་པར་བྱའོ།",
    "མཉམ་པ་ཉིད་དུ་བརྗོད་པར་བྱའོ།",
    "བདག་ཉིད་གཞན་གྱི་དྲིང་མི་འཇོག་པར་འགྱུར་བར་བྱ་བའི་ཕྱིར་ཏེ།",
    "འཇིག་རྟེན་གྱི་ཁམས་གྲངས་མེད་པར་འགྲོ་བ་བརྗོད་པར་བྱའོ།",
    "དབྱངས་ཀྱི་སྦྱོར་བ་རབ་ཏུ་དགྱེ་བ་བརྗོད་པར་བྱའོ།",
    "བདག་ཉིད་གཞན་གྱི་དྲིང་འཇོག་པར་མི་འགྱུར་བར་བྱ་བའི་ཕྱིར་ཏེ།",
    "བག་ཆགས་ཀྱི་མཚམས་འབྲེལ་བ་རྟོགས་པར་བྱ་བ་ལ་མཁས་པ་ཡིན།",
    "སྤྱོད་ཡུལ་རྟོགས་པར་བྱ་བ་ལ་མཁས་པ་ཡིན།",
    "སྤྱད་པ་རྟོགས་པར་བྱ་བ་ལ་མཁས་པ་ཡིན།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྣམ་པར་ཕྱེ་བ་རྟོགས་པར་བྱ་བ་ལ་མཁས་པ་ཡིན།",
    "སྔོན་གྱི་མཐའ་དང་ཕྱི་མའི་མཐའ་ཤེས་པར་རྟོགས་པར་བྱ་བ་ལ་མཁས་པ་ཡིན།",
    "འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་བརྟག་པ་རྟོགས་པར་བྱ་བ་ལ་མཁས་པ་ཡིན།",
    "དོན་དམ་པའི་བདེན་པ་བརྟག་པ་རྟོགས་པར་བྱ་བ་ལ་མཁས་པ་ཡིན།",
    "རྒྱལ་པོའི་གནས་ལ་མཁས་པ་བརྗོད་པར་བྱའོ།",
    "རྒྱལ་པོའི་གནས་ཀྱི་ཚུལ་བརྗོད་པར་བྱའོ།",
    "རྒྱལ་པོའི་གནས་སུ་གནས་པ་བརྗོད་པར་བྱའོ།",
    "རྒྱལ་པོའི་གནས་སུ་འགྲོ་བ་བརྗོད་པར་བྱའོ།",
    "རྒྱལ་པོའི་གནས་སུ་སྤྱོད་པ་བརྗོད་པར་བྱའོ།",
    "བདག་ཉིད་གཞན་གྱི་དྲིང་འཇོག་པར་མི་བྱ་བའི་ཕྱིར་ཏེ།",
    "རྫུ་འཕྲུལཤེས་པར་མྱི་ནུས་སོ།",
    "རྫུ་འཕྲུལ་གྱི་རྣམ་པར་འཕྲུལ་པ་ཤེས་པར་མྱི་ནུས་སོ།",
    "འདས་པ་ལྟ་བ་འམ་ཤེས་པར་མི་ནུས་སོ།",
    "མ་འོངས་པ་ལྟ་བ་འམ་ཤེས་པར་མི་ནུས་སོ།",
    "ད་ལྟར་བྱུང་བ་ལྟ་བ་འམ་ཤེས་པར་མི་ནུས་སོ།",
    "སེམས་ཀྱི་ཡུལ་ཤེས་པར་མི་ནུས་སོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་རྒྱས་པར་དགང་བ་བརྗོད་པ་མཛད་དོ།",
    "དེ་ཅི་ནས་ཀྱང་དེའི་སེམས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་དེ་བས་ཀྱང་ཤས་ཆེར་གནས་པར་བྱ་བ་དང་།",
    "ལྷ་རྫས་ཀྱི་ང་རོ་ཤིན་ཏུ་གྲགས་པར་གྱུར་ཏོ།",
    "ཕྱོགས་བཅུ་རྒྱས་པར་བཀང་ནས་འདི་སྐད་ཅེས་འཛེར་ཏོ།",
    "རྣམ་བྱང་རྣམ་པར་ཁོང་དུ་ཆུད་བྱའི་ཕྱིར།",
    "ཁམས་ཀྱི་རང་བཞིན་རྟོགས་པར་བྱ་བའི་ཕྱིར།",
    "མ་ནོར་རང་བཞིན་རྟོགས་པར་བྱ་བའི་ཕྱིར།",
    "ཆགས་མེད་མིག་ནི་རྣམ་པར་དག་བྱའི་ཕྱིར།",
    "གནོད་པ་མྱེད་པར་སྐྲ་རྩེར་གཞོག་བྱེད་པར།",
    "སྐྲའི་ཉག་མས་བཅིངས་ཤིང་ཚད་གདབ་པར།",
    "ལྕེ་ཡངས་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར།",
    "ཕྱོགས་ཀུན་སྤྱོད་ཚེ་ཆགས་པར་མྱི་འགྱུར་བར།",
    "དེ་དག་དེ་ལ་ཡོངས་སུ་བརྗོད་པར་བྱ།",
    "དེ་ལ་གནས་པར་རྒྱལ་སྲས་དེ་བརྗོད་དེ།",
    "ཇི་ལྟར་འགྲོགས་པར་འགྱུར་བ་ཐམས་ཅད་ཀྱང་།",
    "དེ་དག་གདམས་ངག་ཇི་སྙེད་མ་ལུས་པར།",
    "འཇིག་རྟེན་ཀུན་གྱི་ཆགས་པར་མི་འགྱུར་བ།",
    "རྣམ་པ་འདི་འདྲས་རྒྱལ་སྲས་དང་པོ་དེ།",
    "དེ་ལྟར་གདམས་ངག་རྗེས་སུ་བསྟན་པར་བྱ།",
    "འདི་ནི་རྒྱལ་བ་རྣམས་ཀྱི་རྣམ་པར་བཀོད་པའོ།",
    "ངང་ཚུལ་བདེ་བས་དུས་ཚུལ་ཤེས་པར་བྱ།",
    "མི་འཇིགས་གྱུར་ནས་དོན་ལ་བརྩོན་པར་བྱ།",
    "རྒྱལ་སྲས་དེ་ནི་རྣམ་པར་གནས་པར་བྱ།",
    "ཆེད་དུ་སྤྱོད་མེད་དེ་བཞིན་རྟོག་མྱེད་པར།",
    "བརྟག་པར་བྱ་ལ་ཡོངས་སུ་བསྐུལ་བར་བྱ།",
    "བརྟག་པར་བྱ་ལ་ཡོངས་སུ་བསྐུལ་བར་བྱ།",
    "དེ་ལྟར་དེ་དག་འགྲུབ་པར་འགྱུར་བ་དང་།",
    "དུས་གསུམ་ཀུན་ལ་ཐ་དད་མྱེད་པར་འཇུག།",
    "དེ་ལྟར་འདི་ལ་ནན་ཏན་བསྒྲུབས་བྱས་ཤིང་།",
    "དྲན་ཞིང་དེ་བཞིན་དད་པར་བྱ་བ་དང་།",
    "སྤྱོད་པ་བསྔགས་སམ་རྣམ་པར་སྨད་ཀྱང་རུང་།",
    "ཐོས་པར་གྱུར་ཀྱང་བསམ་པ་ཞུམ་མྱི་འགྱུར།",
    "ཀུན་ནས་འགྲུབ་འགྱུར་རྣམ་པར་འཇིག་ཅེ་འམ།",
    "ངེས་པར་རྟོགས་བྱེད་ཐམས་ཅད་རྣམ་རྟོག་ཅིང་།",
    "སྤྱོད་པ་ཡོད་མྱེད་རྟག་ཏུ་རྣམ་པར་བསྒོམ།",
    "ཐོས་ནས་འདི་ལ་མཐར་ཐུག་འཇུག་པར་བྱེད།",
    "གྲངས་མེད་ཀུན་ཏུ་འགྲོ་བ་བརྗོད་པར་བྱ།",
    "མ་ལུས་རྟོགས་པར་བྱ་ལ་མཁས་པ་ཡིན།",
    "དེའི་རྒྱལ་པོའི་གནས་ལ་མཁས་པར་བསྐུལ།",
    "འགྲོ་བར་བྱ་དང་གནས་པར་བྱ་བ་དང་།",
    "བརྗོད་པར་བྱ་སྟེ་རྒྱལ་ཚབ་དེ་འདྲ་ཡིན།",
    "ཐུ་བོ་མཆོག་དང་དམ་པར་གྱུར་པ་ནི།",
    "གྲངས་མེད་འཇིག་རྟེན་ཤེས་པར་བྱ་བ་དང་།",
    "ཐམས་ཅད་མཁྱེན་པའི་སེམས་ཀྱང་ཤིན་ཏུ་མང་།",
    "ཞིང་མང་བརྗོད་དུ་མྱེད་པར་འགྲོ་བྱས་ཤིང་།",
    "རྫུ་འཕྲུལ་བསྟན་པའང་ཤེས་པར་མི་ནུས་ཏེ།",
    "རྒྱས་པར་འགེངས་པར་བདེ་གཤེགས་བརྗོད་པར་མཛད།",
    "ཅི་ནས་འཇིག་རྟེན་ཁམས་ཀུན་མ་ལུས་པར།",
    "རྣམ་པར་དགོད་ལ་གནས་པ་དེ་དག་ཀུན།",
    "འཇིག་རྟེན་ལྷར་བཅས་ཀུན་གྱིས་ཤེས་པར་དཀའ།",
    "ཕྱོགས་བཅུ་མ་ལུས་ཐམས་ཅད་རྒྱས་པར་བྱ།",
    "སེམས་ཀྱི་སྐད་ཅིག་གཅིག་ལ་བསྒྲུབ་པར་བྱེད།",
    "བསླབ་པ་ཡང་དག་པར་བླང་བ་དག་སྟེ།",
    "ཚངས་པའི་སྤྱོད་པ་མྱི་གཙང་བར་འགྱུར།",
    "ཚངས་པའི་སྤྱོད་པ་འཁྲུགས་པར་འགྱུར།",
    "ཚངས་པའི་སྤྱོད་པ་གཙང་བ་མ་ཡིན་པར་འགྱུར།",
    "ཚངས་པའི་སྤྱོད་པ་སྨད་པར་འགྱུར།",
    "ཚངས་པའི་སྤྱོད་པ་མི་མཐུན་པར་འགྱུར།",
    "ཉལ་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "འགྲེང་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "འགྲོ་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "བལྟས་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "རྣམ་པར་བལྟས་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "བསྐུམ་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "བརྐྱང་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "འགྲེས་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར་རོ།",
    "དབྱངས་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ངག་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "བརྗོད་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "སྨྲ་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "སྨོས་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ཐོང་ཁ་ནས་རྩོལ་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ལྕེ་བསྒྱུར་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "མཆུ་སྦྱར་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ཚིག་སྦྱར་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར་རོ།",
    "བརྗོད་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "བརྡར་བྱ་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ཤིན་ཏུ་བསྟན་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "བསྟན་པས་རྣམ་པར་བསྟན་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ལེགས་པ་བརྗོད་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ངན་དུ་བརྗོད་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "རྣམ་པར་གདགས་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "རྣམ་པར་སྤྱོད་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ཡོངས་སུ་སྨོས་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "དཔྱོད་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "རྣམ་པར་དཔྱོད་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "རྟོག་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "རྣམ་པར་རྟོག་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "དྲན་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ཕྱིར་དྲན་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "སེམས་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "རྣམ་པར་སེམས་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "སྒྱུ་མ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "རྨི་ལམ་ཚངས་པའི་སྤྱོད་པར་འགྱུར་རོ།",
    "འདུ་ཤེས་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ཡིད་ལ་བྱེད་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "གྲང་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "དྲོ་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "བདེ་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "སྡུག་བསྔལ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "བཀྲེས་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "བསྐོམ་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "དགའ་བ་ཚངས་པའི་སྤྱོད་པར་འགྱུར།",
    "ཞུམ་པ་ཚངས་པའི་སྤྱོད་པར་འགྱུར་རོ།",
    "འོན་ཏམ་ཁོང་དུ་ཆུད་པར་ནན་ཏན་དུ་བྱེད་པ་ཚངས་པའི་སྤྱོད་པ།",
    "དེ་སྟེ་བསླབ་པ་ཡང་དག་པར་བླང་བ་ཚངས་པའི་སྤྱོད་པ་ཡིན་ན་ནི།",
    "ཐ་དད་དུ་གནས་པ་བསླབ་པ་ཡང་དག་པར་བླང་བའམ།",
    "ཡོངས་སུ་དག་པ་བསླབ་པ་ཡང་དག་པར་བླང་བའམ།",
    "སློབ་དཔོན་གྱི་ཚིག་བསླབ་པ་ཡང་དག་པར་བླང་བའམ།",
    "ལན་གསུམ་དུ་བཟླས་པ་བསླབ་པ་ཡང་དག་པར་བླང་བའམ།",
    "རྣམ་པར་སྨིན་པ་ལ་ཚོར་བ་མྱེད་པ་དང་།",
    "དེ་སུས་བྱས།"
  ]
}