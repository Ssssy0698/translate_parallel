    "ཨ་མུ་ཀ་སྱ་དཱ་ན་པ་ཏེ།",
    "ར་བྷེ་སཾ་བོ་དྷ་པ་རི་པཱུརྞཱ་རྠ་སརྦ་སཏྭཱ་ནུཏྟ་ར་ཛྙཱ་ན་ལ་བྡྷ་ཧེ་ཏོ་ཤྲཱི་ཨ་མུ་ཀ་མཎྜ་ལ་མ་ལེ་ཁི་ཏ་བྱཾ།",
    "ཏ་སྱཱ་ཧཾ་ནེ་ན་པྲ་ཛྭ་ལ་ཏེ་ན་ཧཱུཾ་ཀ་རེ་ཎ།",
    "ཨ་ཉཾ་བཛྲ་དྷ་རེ།",
    "ཨ་མུ་ཀ་ནཱ་མ་ནཱཾ་མཎྜལ་རྨ་ཡི་ཤྱཱ་མི།",
    "ཨ་མུ་ཀ་ཤི་ཥྱ་སྱཱ་བྷི་སཾ་བོ་དྷི་པ་རི་པཱུ་ར་ཎཱརྠི།",
    "ཡོ་ན་པྲ་ཀྲ་མེཏྟ་སྱ་བཛྲ་པཱ་ཎི་ར་ཛྭ་ལི་ཏ་ཀི་ར་ཎ་བཛྲ་ཎ་མུདྷི་ཤ་ཏ་བི་ཀེ་རེ་ཏ།",
    "དེ་ལ་སློབ་དཔོན་གཙོ་བོས་རྡོ་རྗེའི་གར་སྔོན་དུ་འགྲོ་བས་ཤར་ལ་སོགས་པའི་ཕྱོགས་སུ་རྡོ་རྗེ་ལྕགས་ཀྱུའི་ཁྲོ་བོའི་ང་རྒྱལ་གྱིས་ཧཱུཾ་ཡིག་གིས་གདངས་བརྗོད་ནས།",
    "དེ་བཞིན་དུ་གཤིན་རྗེར་རྡོ་རྗེ་ཞགས་པའི་ང་རྒྱལ་གྱིས་དེའི་ཕྱག་རྒྱ་དང་ལྡན་པས་བྱིན་པ་གཡས་བསྐུམ་སྟེ་བྱིན་པ་གཡོན་མཐོ་ལྔའི་བར་དུ་རབ་ཏུ་བརྐྱང་སྟེ་ཧཱུཾ་ཡིག་གིས་གདངས་བརྗོད་ནས་རབ་ཏུ་བརྐྱང་བར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་ལུས་ངན་དུ་རྡོ་རྗེ་འབེབས་པའི་ང་རྒྱལ་གྱིས་བྱིན་པ་གཉིས་ཀུན་ནས་བཀུག་སྟེ་པུས་མོ་གཉིས་ངང་པའི་གཤོག་པ་ལྟར་སྨད་ནས་དྲིལ་བུ་དཀྲོལ་ཞིང་ཡོངས་སུ་བསྐོར་བར་བྱའོ།",
    "དེ་བཞིན་དུ་འོག་ཏུ་རྡོ་རྗེ་ས་འོག་གི་ང་རྒྱལ་གྱིས་འོག་ཏུ་བཅིང་བར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་སྟེང་དུ་གཙུག་ཏོར་འཁོར་ལོས་སྒྱུར་བའི་ང་རྒྱལ་གྱིས་སྤྱི་བོར་ཐལ་མོ་སྦྱར་ནས་རྐང་པ་གཡོན་སོར་བཞག་ནས་རྐང་པ་གཡས་པ་བརླ་གཡོན་པའི་སྟེང་དུ་ཡོངས་སུ་བསྐོར་བར་བྱའོ།",
    "རྐང་གཅིག་གི་རྐང་སྟབས་ཞེས་བྱ་བའི་གནས་སུ་འགྱུར་རོ།",
    "བུད་མེད་སྒྱུ་མ་བྱེད་པ་དང་།",
    "རྐང་གཅིག་གི་སྟབས་ལ་ཚུལ་གཉིས་ཏེ།",
    "དེ་ལ་རེ་རེ་ཞིང་སོ་སོར་རྣམ་པར་དབྱེ་བར་བྱའོ།",
    "མཐེའུ་གཉིས་ལྕགས་སྒྲོག་གི་རྣམ་པར་ཡང་དག་པར་སྦྱར་ཏེ།",
    "མཛུབ་མོ་གཉིས་རྩེ་མོར་བྱས་ནས་ཕྱིར་བཟློག་སྟེ་གདོང་གི་མདུན་དུ་གཟུང་བར་བྱའོ།",
    "རྐང་པ་གཅིག་གི་སྟབས་ཀྱིས་ཁྲོ་བོ་སྒེག་པའི་ང་རྒྱལ་གྱིས་ལག་པ་གཉིས་གར་བྱེད་ཅིང་པདྨའི་ཐལ་མོ་སྦྱར་ནས་སོར་མོ་ཐམས་ཅད་ཀྱིས་རིགས་ངེས་པར་གྲོལ་བ་ནི་སྙེམས་པ་དང་སྒེག་པའི་ཚུལ་ལོ།",
    "སླར་ཡང་རྐང་པ་གཅིག་པའི་སྟབས་ཀྱིས་རྣམ་པར་སྣང་མཛད་ཆེན་པོའི་ང་རྒྱལ་གྱིས་སོར་མོ་ཐམས་ཅད་ངེས་པར་གྲོལ་བ་ལས་ལག་པ་གཉིས་ཀུན་དུ་རབ་ཏུ་བརྐྱང་སྟེ།",
    "གཡས་བརྐྱང་གི་སྟབས་ཀྱིས་གཤིན་རྗེ་གཤེད་ཀྱི་ང་རྒྱལ་གྱིས།",
    "རང་གི་ཁ་གདངས་ཤིང་ལག་པ་གཡོན་པ་གདོང་དུ་རབ་ཏུ་བརྐྱང་ནས་ལག་པ་གཡས་པ་རྒྱབ་ཀྱི་སྟེང་དུ་རབ་ཏུ་ཕྱར་བར་བྱའོ།",
    "སླར་ཡང་གཡས་བརྐྱང་གི་སྟབས་ཀྱིས་འདོད་པའི་རྒྱལ་པོའི་ང་རྒྱལ་གྱིས་དེ་ལྟ་བུ་ཉིད་ཀྱི་ཚུལ་གྱིས་ལྗགས་བསྐྱོད་པ་དང་བཅས་པས་རྒྱབ་ཀྱི་ཕྱོགས་ཐམས་ཅད་དུ་ཀུན་དུ་བལྟ་བར་བྱའོ།",
    "སེང་གེའི་གཡལ་འཛུམ་མོ།",
    "གཡོན་བརྐྱང་གི་སྟབས་ཀྱིས་ཕྱག་ན་རྡོ་རྗེའི་ང་རྒྱལ་གྱིས་རྡོ་རྗེ་རྩེ་ལྔ་པས་འདོད་ཆགས་ཆེན་པོའི་ཆགས་པའི་མཚོན་འཕང་བར་བྱའོ།",
    "གཡོན་བརྐྱང་གི་སྟབས་ཀྱིས་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་ང་རྒྱལ་གྱིས་གདོང་གི་སྟེང་དང་འོག་ཏུ་ལག་པ་གཉིས་རབ་ཏུ་བརྐྱང་སྟེ།",
    "གཡས་བརྐྱང་གི་སྟབས་ཀྱིས་གཤིན་རྗེ་གཤེད་ཀྱི་ང་རྒྱལ་གྱིས་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་རྡོ་རྗེའི་ཕུར་བུ་བཟུང་ནས་བགེགས་ཀྱི་ཚོགས་རྣམས་ལ་བཀོད་དེ་ལགས་པ་གཡས་པའི་ཁུ་ཚུར་གྱིས་རྡོ་རྗེ་ཐོ་བ་བཟུང་ནས་བརྡུང་བར་བྱའོ།",
    "ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏ་ཀུཎྜ་ལི་ཨ་བྷི་ན་ཡ་བཛྲ་མ་ཧཱ་ཀྲོ་དྷ་གྲྀཧྞ་བནྡྷ་ད་ཧ་པ་ཙ་བི་དྷྭཾ་ས་ཡ་བཛྲ་ཎ་སརྦ་ན་སྤོ་ཊ་ཡ་ཧྲྀ་ད་ཡ་ཧཱུཾ་ཕཊ།",
    "གཡས་བརྐྱང་གི་སྟབས་ཀྱིས་རྡོ་རྗེ་སྒེག་མོའི་ང་རྒྱལ་གྱིས་རྡོ་རྗེ་གར་སྔོན་དུ་འགྲོ་བས་ལྟོ་གཉིས་དང་བཅས་པས་རྡོ་རྗེ་སྒེག་མོའི་ཕྱག་རྒྱས་མགོ་གཡོན་དུ་སྨད་པར་བྱའོ།",
    "གཡས་བརྐྱང་གི་སྟབས་ཀྱིས་རྡོ་རྗེ་རྒྱས་པའི་ང་རྒྱལ་གྱིས་ལག་པ་གཡོན་ན་གནས་པའི་རྡོ་རྗེ་ཁྲོ་བོ་ལ་གདུག་པ་ཅན་ཐམས་ཅད་ནང་དུ་བསྒོམས་ཏེ་ལག་པ་གཡས་པའི་རྡོ་རྗེ་ཁྲོ་བོས་བསྣུན་པར་བྱའོ།",
    "འཆི་བདག་གི་བདུད་བཟའ་བའི་ཕྱིར་རྡོ་རྗེ་མཆེ་བའོ།",
    "གཡོན་བརྐྱང་གི་སྟབས་ཀྱིས་རྡོ་རྗེ་བཞད་པའི་ཁྲོ་བོའི་ང་རྒྱལ་གྱིས།",
    "ཨོཾ་བཛྲཱཊྚ་ཧ་ས་བྷི་ན་ཡ་བཛྲ་མ་ཧཱ་ཀྲོ་དྷ་མོ་ཧཱ་ཡ་ཧ་ཧ་ཧ་ཧ་ཧཱུཾ་སརྦ་ཀིན་ན་དཱིན་ཧཱུཾ་ཕཊ།",
    "གཡས་བརྐྱང་གི་རྐང་སྟབས་ཀྱིས་རྣོན་པོའི་ཁྲོ་བོའི་ང་རྒྱལ་གྱིས་ལག་པ་གཡོན་པའི་ཁུ་ཚུར་གྱིས་ཤུགས་འདྲེན་ཅིང་ལག་པ་གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་རལ་གྲི་འདྲེན་པའོ།",
    "ཉོན་མོངས་པ་དང་ཉེ་བའི་ཉོན་མོངས་པ་གཅོད་པ་ལ་རལ་གྲི་དང་།",
    "གཡོན་བརྐྱང་གི་སྟབས་ཀྱིས་རྡོ་རྗེ་རྒྱལ་པོའི་ཁྲོ་བོའི་ང་རྒྱལ་གྱིས་ལག་པ་གཡས་པས་ཏྲི་ཤཱུ་ལའི་རྡོ་རྗེ་འཕང་བར་བྱའོ།",
    "སོར་མོ་ལྷག་མ་རྣམས་ཀྱིས་མཐེབ་ཆེན་སྦ་བར་བྱའོ།",
    "ཉོན་མོངས་པ་དགུ་བཅུ་རྩ་བརྒྱད་གཅོད་པའི་ཕྱིར།",
    "མཉམ་པོའི་རྐང་སྟབས་ཀྱིས་རྡོ་རྗེ་ས་འོག་གི་ང་རྒྱལ་གྱིས་ལག་པ་གཉིས་བཅིངས་ནས་གཏུན་ཤིང་འཛིན་པའི་ཚུལ་གྱིས་བརྡུང་བར་བྱའོ།",
    "གདུག་པ་ཐམས་ཅད་བརྡུང་བའི་ཕྱིར་གཏུན་ཤིང་གི་ཚུལ་ལོ།",
    "སླར་ཡང་མཉམ་པོའི་རྐང་སྟབས་ཀྱིས་རྡོ་རྗེ་ཏོག་གི་ཁྲོ་བོའི་ང་རྒྱལ་གྱིས་ལག་པ་གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་གུང་མོ་དང་མཛུབ་མོ་བསླང་ནས་འགྱིང་བ་དང་བཅས་པར་རབ་ཏུ་བརྐྱང་སྟེ་སྟེང་དུ་གཟུང་བར་བྱའོ།",
    "ཟླུམ་པོའི་རྐང་སྟབས་ཀྱིས་རྡོ་རྗེ་ཅན་གྱི་ཁྲོ་བོའི་ང་རྒྱལ་གྱིས་ཐལ་མོ་ཡང་དག་པར་སྦྱར་ཏེ།",
    "གཡོན་བརྐྱང་གི་རྐང་སྟབས་ཀྱིས་དབྱུག་པ་སྔོན་པོ་ཅན་གྱི་ང་རྒྱལ་གྱིས་ལག་པ་གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་དབྱུག་པ་འཕེན་ཞིང་འཛིན་པའི་ཚུལ་བྱས་ནས་མཚོན་ཆ་འཕང་བར་བྱའོ།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་རིའི་རྩེ་མོ་ཉི་ཤུ་མཐོ་བ་རྣམ་པར་གཞོམ་པའི་ཕྱིར་དབྱུག་པ་འཛིན་པའི་ཚུལ་ལོ།",
    "གཡས་བརྐྱང་གི་རྐང་སྟབས་ཀྱིས་རྡོ་རྗེ་ལྕགས་ཀྱུའི་ང་རྒྱལ་གྱིས་ལག་པ་གཡས་པའི་མཛུབ་མོ་ལྕགས་ཀྱུའི་རྣམ་པའི་ཚུལ་དུ་བྱའོ།",
    "ཨོཾ་ཨཾ་ཀུ་ཤ་བི་ན་ཡ་བཛྲ་མ་ཧཱ་ཀྲོ་དྷ་ཨཱ་ཀཪྵ་ཡ་ཨཱ་ཀཪྵ་ཡ་སརྦ་བུདྡྷཱ་བོ་དྷི་སཏྭཱ་ན་ཧཱུཾ་ཕཊ།",
    "གཡས་བརྐྱང་གི་རྐང་སྟབས་ཀྱིས་རྡོ་རྗེ་གདུལ་དཀའི་ཁྲོ་བོའི་ང་རྒྱལ་གྱིས་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱིས་མདུང་གི་མཚོན་ཆ་འཕེན་པའི་ཚུལ་བྱའོ།",
    "མ་རིག་པ་ལ་སོགས་པའི་ལྟ་བ་གཞོམ་པའི་ཕྱིར་མདུང་གི་ཚུལ་ལོ་ཞེས་པའི་ཚུལ་དགུ་པོ་ནི་ནུབ་ཕྱོགས་ན་གནས་པའི་སློབ་དཔོན་གྱིའོ།",
    "གཡས་བརྐྱང་གི་རྐང་སྟབས་ཀྱིས་རྡོ་རྗེ་ཆགས་པའི་ཁྲོ་བོའི་ང་རྒྱལ་གྱིས་ལག་པ་གཡོན་པས་གཞུ་བླངས་ཏེ་ལག་པ་གཡས་པ་རྒྱུད་བཟུང་སྟེ་ཕྱོགས་གཡོན་དུ་གཟུང་བར་བྱའོ།",
    "ཟླུམ་པོའི་རྐང་སྟབས་ཀྱིས་རྡོ་རྗེ་མདའི་ཁྲོ་བོའི་ང་རྒྱལ་གྱིས་ལག་པ་གཡས་པའི་མཛུབ་མོ་དང་གུང་མོ་གཉིས་ཀྱིས་མདའ་འདྲེན་པའི་ཚུལ་བྱའོ།",
    "སླར་ཡང་གཡོན་བརྐྱང་གི་རྐང་སྟབས་ཀྱིས་རྟ་མགྲིན་གྱི་ང་རྒྱལ་གྱིས་ལག་པ་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་ཀ་ན་ཡའི་ཐག་པ་བཟུང་ནས་ལག་པ་གཡས་པས་ཀ་ན་ཡ་སྤྱི་བོའི་སྟེང་དུ་ཡོངས་སུ་བསྐོར་ནས་རབ་ཏུ་འཕང་བར་བྱའོ།",
    "ཨོཾ་ཨཱ་བུདྡྷ་བ་ལ་བཛྲ་མ་ཧཱ་ཀྲོ་དྷ་ཨཱཀྵེ་པ་ཡ་ཨཱཀྵེ་པ་ཡ་སརྦ་མ་རཱ་ན་ཧཱུཾ་ཕཊ།",
    "དེ་ནས་པུས་མོ་གཡས་པ་བསྐུམ་སྟེ་དབྱུག་པའི་ཕྱག་རྒྱས་འཕང་བར་བྱ་སྟེ།",
    "གཡོན་པ་རྡོ་རྗེ་རྐང་སྟབས་བྱས་ལ་པུས་མོ་གཡས་པ་བསྐུམ་སྟེ་ཁྲོ་བོ་དང་བཅས་པའི་རྐང་པ་འཕང་བར་བྱའོ།",
    "པུས་མོ་གཡོན་པ་བསྐུམ་སྟེ་གཡས་པ་རྡོ་རྗེའི་རྐང་སྟབས་བྱས་ནས་གཡོན་དུ་འཕང་ཞིང་དེ་ཉིད་དང་བཅས་པ་གཡས་པས་བསྐོར་བར་བྱའོ།",
    "ཨོཾ་ཨཱ་ཧཱུཾ་ལཾ་ཨ་ཧི་ཨ་ཧི་གྲ་ས་གྲ་ས་ཀ་རཱ་ལ་བ་ད་ན་མ་ཧཱ་ཀྲོ་དྷ་བི་མོ་ཧ་ཡ་བི་མོ་ཧ་ཡ་སརྦ་དུཥྚ་བིགྷྣན་ཧཱུཾ་ཙྪ།",
    "པུས་མོ་གཡས་པ་ཅུང་ཟད་བསྐུམ་ནས་པུས་མོ་གཡོན་པ་དམད་པར་བྱའོ།",
    "གང་གི་ཚེ་དབྱུག་པ་གནས་པ་ལ་བལྟ་བ་ན་རང་གི་འཕྲག་པ་གཡས་ཕྱོགས་དང་རང་གི་རྒྱབ་ཏུ་ཁྱེར་བར་བྱའོ།",
    "དེ་ལ་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་གིས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ཕྱག་རྒྱ་བཅིང་བར་བྱ་སྟེ།",
    "རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་ངོ།",
    "པདྨའི་གདན་གྱི་སྒེག་མོ་ལ་སོགས་པ་བརྒྱད་ཀྱི་ཕྱག་རྒྱ་བཅིང་བར་བྱའོ།",
    "བྱིན་པ་གཡས་པས་བྱིན་པ་གཡོན་པ་མནན་པར་བྱས་ནས་པུས་མོ་གཉིས་དམད་པར་བྱས་པ་ནི་པདྨའི་གདན་ནོ།",
    "སེམས་དཔའི་སྐྱིལ་ཀྲུང་གིས་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་བཅུ་དྲུག་གི་ཕྱག་རྒྱ་བཅིང་བར་བྱའོ།",
    "བཟང་པོའི་གདན་གྱིས་བྱམས་པ་ལ་སོགས་པ་བཅུ་དྲུག་གི་ཕྱག་རྒྱ་བཅིང་བར་བྱའོ།",
    "ཨོཾ་ཨ་མོ་གྷཱ་དཪྵ་ཨ་བྷི་ན་ཡ་བཛྲ་མ་ཧཱ་ཀྲོ་དྷ་སརྦ་སཏྭཱ་ནཱཾ་སརྦ་ཀླེ་ཤ་ཀ་ཋི་ནྱཾ་བི་ཥ་མ་ཡ་བི་ཥ་མ་ཡ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་སརྦ་ཤོ་ཀ་ཏ་མོ་ནིར་གྷཱ་ཏ་ན་བཛྲ་མ་ཧཱ་ཀྲོ་དྷ་སརྦ་ཤོ་ཥ་པ་རི་དེ་བ་ནཱ་ནི་དུ་ཁཾ་ནིར་གྷཱ་ཏ་ཡ་ནིར་གྷཱ་ཏ་ཡ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་ཨ་མྲྀ་ཏ་པྲ་བྷཱ་བྷི་ན་ཡ་བཛྲ་མ་ཧཱ་ཀྲོ་དྷ་ཨ་ནན་ཏ་ཛྙཱ་ན་ར་སྨིན་ཨ་བ་བྷཱ་ས་ཡ་ཨ་བ་བྷཱ་ས་ཡ་ཧཱུཾ་ཕཊ།",
    "རྐང་པ་གཡོན་པའི་སྐྱིལ་ཀྲུང་ཕྱེད་པ་བཅིངས་ནས་དེ་དང་ཉེ་བའི་བར་གཡས་པའི་པུས་མོ་དྲང་པོར་དགོད་པར་བྱ་བ་ནི་དཔའ་བོའི་གདན་ནོ།",
    "ཨོཾ་བཛྲ་ཨཾ་ཀུ་ཤཱ་བྷི་ན་ཡ་བཛྲ་མ་ཧཱ་ཀྲོ་དྷ་པོ་དྷི་ཙིཏྟ་ཨཾ་ཀུ་ཤ་ན་མ་ཧཱ་ཀྲོ་དྷ་པུ་རེ་སརྦ་སཏྭཱ་ན་ཨཱ་ཀཪྵ་ཡ་ཨཱ་ཧཱུཾ་ཕཊ།",
    "ཙོག་པུའི་གདན་གྱིས་ཕོ་ཉ་དང་ཕོ་ཉ་མོ་དང་བྲན་མོ་བཅུ་དྲུག་གི་ཕྱག་རྒྱ་བཅིང་བར་བྱའོ།",
    "རྡོ་རྗེ་ཀླུང་གི་མཐེ་བོང་གཡོན་པ་གནས་པ་ལ་མེ་ཏོག་འཆིང་བ་རབ་ཏུ་སྦྱོར་བས་སོ།",
    "རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་གཡས་པས་དོན་སྟེར་བ་དང་རལ་གྲིའི་ཕྱག་རྒྱའི་རྩེ་མོར་ཁུ་ཚུར་སོན་པའོ།",
    "རྡོ་རྗེ་གཏུན་ཤིང་གི་གཡས་ཀྱི་རྩེ་མོར་དེ་བཞིན་དུ་གཏུན་ཤིང་རབ་ཏུ་བརྐྱང་སྟེ་ལག་པ་གཡོན་པ་ཡང་དེ་བཞིན་ནོ།",
    "ཕོ་ཉའི་རང་གི་དམ་ཚིག་ནི་ལས་ཀྱི་ཕྱག་རྒྱའོ།",
    "གཏུན་ཤིང་གིས་གདུག་པ་འཇོམས་པའི་ཕྱིར་དར་སྐུད་ཀྱི་རང་བཞིན་ནོ།",
    "འབར་བའི་རྩེ་མོས་གདུག་པ་ཅན་རྣམས་འདུལ་པ་སྟེ་གནོད་སྦྱིན་མོ་དང་གཟའ་རྣམས་ཉམས་པར་བྱེད་པའོ།",
    "ཕོ་ཉ་མོའི་རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ཁེངས་པ་དང་བཅས་པས་གདོང་གི་མཆེ་བའི་མདུན་དུ་དབྱུག་པ་གདབ་ཅིང་རབ་ཏུ་ལྷུང་བར་བྱའོ།",
    "དཔུང་པ་བསྐུམ་ནས་ཚིག་གིས་གཡོན་དང་གཡས་སུ་འདིར་འཕྲོག་པའོ་ཞེས་སོ།",
    "བྲན་གྱི་རང་གི་ལས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེའི་མཆེ་བས་ཟ་བར་བྱེད་པ་དང་གསོད་པར་བྱེད་པ་དང་བགེགས་དང་བགེགས་ཀྱི་ཚོགས་ཐམས་ཅད་གྲི་གུག་གིས་འཕྲོག་པར་བྱེད་པས་ཐམས་ཅད་འཕྲོག་པ་ཞེས་པ་ནི།",
    "ཨེ་ཧྱེ་ཧི་གྲྀ་ཧྞ་གྲྀཧྞ་བྷ་ཀྵ་ཡ་བྷ་ཀྵ་ཡ་བཛྲ་ཌཱ་ཀི་ནྱ་བཛྲ་ས་ཀ་ལེ་སརྦ་དེ་བ་ན་མཱ་ཧྲི་བྷུ་ཊེ་ཧ་ར་ཧ་ར་པྲ་ཎཱཾ་ཨ་མུ་ཀ་སྱ་ཀ་པཱ་ལ་མཱ་ལཱ་ལཾ་ཀྲ་ཏ་སརྦ་ཀཱ་དྷྱ་ཀིཉྩ་ཏྟ་ཡ་སི་བཛྲ་ཁ་ཊྭཱཾ་ག་པྲེ་ཏ་མཱ་ནུ་ཥྱ་ཤ་རཱི་རེ་ཤཱི་གྷྲ་མ་བེ་ཤ་ཡ་བནྡྷ་ཡ་མ་ར་ཡ་བཛྲ་རཱ་ཀྵ་སི་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཨོཾ་བཛྲ་མ་ཧཱ་ཀ་རེ་གྲ་ས་གྲ་ས་ཤཱི་གྷྲཾ་ཤཱི་གྷྲཾ་པྲ་བེ་ཤ་ཡ་པཱ་ཏ་ལཾ་བྷཀྵ་ཡ་བཛྲ་མ་ཀ་ར་དྷ་ར་ཎི་ཧཱུཾ་ཕཊ།",
    "བྲན་མོ་རང་གི་དམ་ཚིག་གི་ལས་ཀྱི་ཕྱག་རྒྱའོ།",
    "རྐང་པ་གཡས་པ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཀོད་ནས་གཡོན་འགྱིང་བ་དང་བཅས་པས་རབ་ཏུ་བརྐྱང་བར་བྱའོ།",
    "གཡོན་པའི་ཁུ་ཚུར་རྐེད་པར་བཞག་ནས་ཁུ་ཚུར་གཡས་པའི་མཛུབ་མོ་དང་གུང་མོའི་ཚིགས་གསུམ་པ་བཀུག་སྟེ་མཛུབ་མོ་མིག་གི་རྣམ་པར་དཔྲལ་བའི་ལོགས་སུ་གཟུང་བར་བྱའོ།",
    "དེ་ཉིད་བཞིན་དུ་གཡོན་པ་བྱས་ནས་ལག་པ་གཡས་པ་རབ་ཏུ་བརྐྱང་སྟེ་མཛུབ་མོ་དང་མཐེ་བོང་བསྐམ་པར་བྱས་ཏེ།",
    "འདི་ནི་ཆུ་བདག་གིའོ།",
    "གཡོན་པ་སྡིགས་མཛུབ་བཀོད་པ་བསྐྱེད་པར་བྱས་ནས་ལག་པ་གཡས་པའི་ཁུ་ཚུར་གྱི་མཛུབ་མོ་དང་གུང་མོ་བ་དན་གྱི་རྣམ་པར་བྱའོ།",
    "ལག་པ་གཡོན་པ་དང་གཡས་པ་དག་གི་ས་ན་ཀུ་ལི་དང་པཱི་ཛ་པཱུ་ར་ཀའི་ཚུལ་དུ་བྱའོ།",
    "ཁུ་ཚུར་གཡོན་པ་རྐེད་པར་བཞག་ནས་ལག་པ་གཡས་པ་རབ་ཏུ་བརྐྱང་སྟེ་མཐེའུ་ཆུང་དང་མཐེ་བོ་དག་རྩེ་མོ་ཡང་དག་པར་སྦྱར་ཏེ།",
    "ལག་པ་གཡས་པ་བགྲང་ཕྲེང་གི་ཚུལ་དུ་བྱས་པ་ནི་ཚངས་པའི་ལས་ཀྱི་ཕྱག་རྒྱའོ།",
    "ཨོཾ་ཨ་སུ་རེ་བྷྱ་སྭཱ་ཧཱ།",
    "འདི་ནི་འོག་གི་ཀླུའི་ལས་ཀྱི་ཕྱག་རྒྱའོ།",
    "ཨོཾ་མཎྜལ་ཧཱུཾ་ཛ་ཞེས་པས་རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཛུབ་མོ་དང་མཐེ་བོའི་རྡོ་རྗེས་དཀྱིལ་འཁོར་ཐམས་ཅད་གདན་འདྲེན་པའི་ཕྱག་རྒྱའོ།",
    "དེ་ནས་སེང་ལྡེང་གི་རྡོ་རྗེ་ཕུར་བུ་རྣམས་ཤིན་ཏུ་མཁྲེགས་པའི་ཤིང་གི་རང་བཞིན་རྣམས་མ་རུལ་པའི་རང་བཞིན་རྣམས་ཀྱང་སྲིད་དུ་སོར་བཅོ་བརྒྱད་དམ་སོར་བཅུ་གཉིས་སམ་སོར་བརྒྱད་པ་རྣམས་གོ་རིམས་ཇི་ལྟ་བ་བཞིན་དུ་སྦོམས་སུ་སོར་མོ་དྲུག་དང་བཞི་དང་ཕྱེད་དང་བཅས་པའི་སོར་གཉིས་པའི་ཕུར་བུ་བཞི་དཀྱིལ་འཁོར་གྱི་ཕྱིའི་མཚམས་བཞི་ལ་ཕུར་བུས་གདབ་པར་བྱ་སྟེ།",
    "དེ་རྣམས་སྒྲུབ་པ་པོ་ཕྱི་མ་ལ་གཏད་པར་བྱ་སྟེ་སྒྲུབ་པ་པོ་གཅིག་གི་ཕྱོགས་ལའོ།",
    "སྒྲུབ་པ་པོ་ཕྱི་མ་བཞིའི་ཕྱོགས་ལ་གོ་རིམས་ཇི་ལྟ་བ་བཞིན་དུ་རེ་རེ་གཏད་པར་བྱའོ།",
    "ལག་པ་གཡས་པས་རྡོ་རྗེའི་ཐོ་བ་རྩེ་མོ་གསུམ་པས་བརྡུང་བར་བྱའོ།",
    "དེ་ནས་རྡོ་རྗེ་ཁུ་ཚུར་བཅིངས་ནས་གུང་མོའི་རྩེ་མོ་དང་མཛུབ་མོ་དག་བསྐུམ་ནས་མཐེ་བོ་སྟེང་དུ་དགོད་པར་བྱའོ་ཞེས་སོ།",
    "སྔོན་དུ་གསུངས་པའི་སྔགས་དང་ཕྱག་རྒྱ་དག་གིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ་ཞེས་པ་ནི་གོ་རིམས་ཀྱི་ཆོ་གའོ།",
    "ཞེས་ལན་གསུམ་བརྗོད་ཅིང་འབབ་པ་སྔོན་དུ་འགྲོ་བའི་མི་བསྐྱོད་པའི་ཕྱག་རྒྱས་ས་ལ་རེག་ནས་བསླང་བར་བྱའོ།",
    "ལྷ་མོ་ཁྱོད་ནི་དཔང་དུ་གྱུར།",
    "ཞེས་པའི་ཚིགས་སུ་བཅད་པ་ལན་གསུམ་བརྗོད་ནས་སའི་ལྷ་མོ་ལྷག་པར་གནས་པར་བྱའོ།",
    "དང་པོར་རེ་ཞིག་མཉམས་པའི་ཀླུའི་ཕྱོགས་མཚོན་པར་བྱས་ནས་ཚངས་པའི་ཐིག་གདབ་པར་བྱས་ལ།",
    "དེ་ནས་གཤིན་རྗེ་དང་ལུས་ངན་གྱི་ཕྱོགས་མཚོན་པར་བྱས་ནས་ཉའི་མཇུག་མ་དག་གི་དབུས་སུ་ཐིག་སྐུད་བཟུང་ནས་ཚངས་ཐིག་གཉིས་པ་གདབ་པར་བྱའོ།",
    "དེའི་ཕྱི་རོལ་དུ་ཆ་གཅིག་གིས་བར་རྩ་བའི་ཐིག་བཞི་གདབ་པར་བྱའོ།",
    "རྩ་བའི་ཐིག་གཉིས་ཀྱི་བར་དུ་བརྒྱད་ཆའི་ཆ་གཅིག་གིས་སྒོའི་ཚད་དེའི་ཕྱེད་དུ་ཐིག་བཞི་གདབ་པར་བྱའོ།",
    "སྒོའི་བཞི་ཆ་གཅིག་གིས་ཆ་ཆུང་གི་ཚད་དོ།",
    "སྒོའི་ཐིག་ལས་ཕྱི་རོལ་དུ་ལོགས་དག་ཏུ་སོ་སོར་ཆ་ཆུང་རེ་རེའི་བར་དུ་ཐིག་གསུམ་གདབ་པར་བྱའོ།",
    "དེའི་ཕྱི་རོལ་དུ་ཆ་ཆུང་ལྔའི་བར་དུ་ཐིག་རེ་རེ་གདབ་པར་བྱའོ།",
    "ཕྱོགས་ཀྱི་ཐིག་གི་ནང་དུ་ཐིག་ཟླུམ་པོ་གཅིག་གདབ་པར་བྱའོ།",
    "ཐམས་ཅད་ཀྱི་ནང་དུ་ཆ་ཆུང་བཅུ་པ་གཙོ་བོའི་གནས་ལ་ཟླུམ་པོའི་ཐིག་གཅིག་གདབ་པར་བྱའོ་ཞེས་པ་ནི་ནང་གི་དཀྱིལ་འཁོར་ལ་སྟེགས་བུ་དང་བྲལ་བར་འགྱུར་རོ།",
    "སྟེགས་བུ་དང་བཅས་པའི་ཚངས་ཐིག་དང་ཟུར་ཐིག་གི་ནང་ལ་རྩ་བའི་ཐིག་བཞི་གདབ་པར་བྱའོ།",
    "རྩ་བའི་ཐིག་གཉིས་ནང་གི་བརྒྱད་ཆ་གཅིག་གིས་སྒོའི་ཚད་དོ།",
    "སྒོའི་བཞི་ཆ་གཅིག་ནི་ཆ་ཆུང་གི་ཚད་དོ།",
    "སྒོའི་ཐིག་ལས་ཕྱི་རོལ་གྱི་ལོགས་གཉིས་སུ་སོ་སོར་རེ་རེ་ཞིང་ཆ་ཆུང་རེ་སྤངས་པར་ཐིག་དྲུག་དྲུག་གདབ་པར་བྱའོ།",
    "འདི་ནི་ནང་གི་དཀྱིལ་འཁོར་སྟེགས་བུ་དང་བཅས་པར་གྱུར་པས་ཐིག་བདུན་ཅུར་འགྱུར་རོ།",
    "དེ་ཡོངས་སུ་བཅད་པའི་འཁོར་ལོའི་བརྒྱད་ཆའི་ཆ་གཅིག་གིས་སྒོའི་ཚད་དོ།",
    "དེའི་ཕྱི་རོལ་དུ་ལོགས་གཉིས་དག་ཏུ་སོ་སོར་རེ་རེ་ཞིང་ཆ་ཆུང་རེ་རེ་སྤངས་པར་ཐིག་དྲུག་དྲུག་གདབ་པར་བྱའོ།",
    "དེའི་ཕྱི་རོལ་དུ་ཆ་ཆུང་གཅིག་གིས་རིན་ཆེན་ཤར་བུའི་ས་གཞིའི་ཐིག་བཞི་གདབ་པར་བྱའོ།",
    "དེའི་སྟེང་དུ་ཆ་ཆུང་གཅིག་གི་རྩེ་མོའོ།",
    "དེའི་རྩེ་མོར་ཟླུམ་པོའི་ཐིག་གོ།",
    "དེའི་ཕྱི་རོལ་དུ་ཆ་ཆུང་གཅིག་གིས་གེ་སར་གྱི་ཐིག་ཟླུམ་པོའོ།",
    "དེའི་སུམ་ཆའི་ཆ་གཅིག་གི་ཡོན་ཏན་དོ་ཤལ་ལོ།",
    "དེ་དག་གི་བར་ཇི་ལྟ་བར་མཛེས་པར་བྱའོ།",
    "དེའི་ཕྱི་རོལ་དུ་ཆ་ཆུང་དྲུག་པའི་འཇིག་རྟེན་སྐྱོང་བའི་སྣམ་བུའི་ཐིག་བཞི་གདབ་པར་བྱའོ་ཞེས་པ་ནི་ཐིག་གི་ཆོ་གའོ།",
    "དེའི་མདུན་དུ་འདབ་མ་རང་རང་གི་ཁ་དོག་གིས་མཚན་པའོ།",
    "བྱང་གི་འདབ་མ་ལ་དྲིལ་བུ་གཞག་པར་བྱའོ།",
    "དེ་ལ་རང་རང་གི་སྔགས་ཀྱིས་ལྷག་པར་གནས་པར་བྱའོ།",
    "ཞེས་པའི་སྔགས་འདི་དག་གིས་སོ་སོ་ལ་ལན་བརྒྱ་རྩ་བརྒྱད་ཡོངས་སུ་བཟླས་ནས་བུམ་པ་ལྷག་པར་གནས་པར་བྱའོ།",
    "དེ་ནས་ཧཱུཾ་ཏྲཱཾ་ཧྲཱི་ཨཱ་ཨ་ཞེས་པ་འདི་རྣམས་ཀྱི་རང་རང་གི་ས་བོན་རྣམས་ཀྱིས་མི་བསྐྱོད་པ་ལ་སོགས་པའི་ཐིག་སྐུད་རྣམས་ལ་དགོད་དོ།",
    "སྒེག་མོ་ལ་སོགས་པ་རྣམས་ཀྱིས་ཀྱང་ཡང་དག་པར་མཆོད་ནས་དྲིལ་བུ་དཀྲོལ་བར་བྱའོ།",
    "སྔགས་འདི་དག་གིས་སོ་སོ་རེ་རེ་ཞིང་ལན་བརྒྱ་རྩ་བརྒྱད་བརྗོད་ནས་རྡོ་རྗེ་ལྷག་པར་གནས་པར་བྱའོ།",
    "ཨོཾ་དྷརྨྨ་བཛྲ་ཧྲཱི་སྔགས་འདི་དག་གི་ལན་བརྒྱ་རྩ་བརྒྱད་ཀྱིས་ལྷག་པར་གནས་པར་བྱའོ།",
    "རེ་རེ་ཞིང་དཀར་པོ་དང་ནག་པོ་དང་སེར་པོ་དང་དམར་པོ་དང་ལྗང་གུའི་ཚོགས་རྣམས་ལ་བཾ་ཡཾ་ལཾ་རཾ་ཧཾ་ཞེས་པའི་ས་བོན་རྫོགས་པ་ལས་བྷྲཱུཾ་ཧཱུཾ་ཨཱཾ་ཛྲཱྀཾ་ཁཾ་རྣམས་ལས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་སྐུའི་ངོ་བོར་བསྒོམས་ནས་བྲུཾ་ཡིག་ལ་སོགས་པ་གྲུབ་པའི་ཡེ་ཤེས་ཀྱི་ཚོན་ལ་ནམ་མཁའ་ལས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཐུགས་ཀར་བཞུགས་ཏེ་རོ་གཅིག་ཏུ་གྱུར་པར་རྣམ་པར་བསྒོམ་མོ།",
    "རྡོ་རྗེ་ཉི་མའི་ཁྲོ་བོའི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་མཐིལ་ལས་ཡང་ཧྲི་ཡིག་ལས་ཀྱང་སོ་སོ་རེ་རེ་ཞིང་རྡུལ་ཚོན་འབར་བར་བྱས་ཏེ།",
    "ལག་པ་གཉིས་རབ་ཏུ་བརྐྱང་ནས་མཐེ་བོ་གཉིས་སྐྱིལ་ཀྲུང་བྱས་ནས་མཛུབ་མོ་གཉིས་ཁ་མཚམས་སྦྱར་ནས་ལྷག་མ་རྣམས་འབར་བའི་རྣམ་པས་ཉི་མའི་དཀྱིལ་འཁོར་དུ་བྱའོ།",
    "རྡོ་རྗེ་ཉི་མ་ཁྲོ་བོའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "དེའི་རྗེས་ལ་སྒྲུབ་པ་པོ་ཕྱི་མ་དཀྱིལ་འཁོར་གྱི་ཁང་པའི་ཕྱི་རོལ་གྱི་ཕྱོགས་ཀྱི་རང་གི་མཚམས་སུ་གནས་ནས་ལྷ་ལ་སོགས་པ་རྣམས་ལ་གཏོར་མ་ཆེན་པོ་དབུལ་བར་བྱའོ།",
    "བྷྲཱུཾ་ཧཱུཾ་ཨཱཾ་ཛྲཱྀཾ་ཁཾ་ལཱཾ་མཱཾ་པཱཾ་ཏཱཾ་གི་ཡི་གེ་རྣམས་ལས་བྱུང་བའི་སྒྲོན་མ་ལྔའི་གཟུགས་རབ་ཏུ་འབར་བའི་བདུད་རྩི་ལྔར་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "དེ་ནས་ཟླ་བའི་དཀྱིལ་འཁོར་ལས་བྱུང་བའི་ཡི་གེ་གསུམ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱོགས་བཅུར་སོང་སྟེ་ལྷ་དང་ལྷ་མོ་རྣམས་གདན་དྲངས་ཏེ་འོ་མའི་རྒྱ་མཚོ་བདུན་ལས་བདུད་རྩི་རྣམས་བླངས་ཏེ་དེ་ལ་དེ་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ།",
    "དེ་བཞིན་དུ་འདོད་ཆགས་ལ་སོགས་པའི་སེམས་སུ་འགྱུར་བའི་ལྷ་རྣམས་ཚིམ་པར་བྱ་བའི་ཕྱིར་ཁྲག་གི་རྒྱུན་ནོ།",
    "དུང་དང་རྔ་ལ་སོགས་པའི་རོལ་མོའི་སྒྲ་སྔོན་དུ་འགྲོ་བས་གཡས་སྐོར་དུ་རིམ་གྱིས་གཏོར་མ་ཆེན་པོ་རབ་ཏུ་དབུལ་བར་བྱའོ་ཞེས་པ་ནི་གཏོར་མའི་ཆོ་གའོ།",
    "རང་རང་གི་སྔགས་ཀྱིས་ལན་བདུན་ཡོངས་སུ་བཟླས་པའི་མེ་ཏོག་རྣམས་ཀྱིས་ཡང་དག་པར་མཆོད་ཅིང་ཉེར་སྤྱོད་ལྔས་ཀྱང་ཡང་དག་པར་མཆོད་ནས་བསྟོད་པ་སྔོན་དུ་འགྲོ་བས་དྲིལ་བུ་དཀྲོལ་བར་བྱ་སྟེ།",
    "རིགས་པའི་རྒྱལ་པོ་ཁྱོད་ལ་འདུད།",
    "འགྲོ་རྣམས་དག་ཕྱིར་བདག་གིས་བྲི།",
    "དྲི་དང་མེ་ཏོག་བདུག་སྤོས་དང་མཆོད་ཡོན་ལ་སོགས་པ་རྣམས་ཀྱིས་ཡང་དག་པར་མཆོད་ནས་སྒེག་མོ་ལ་སོགས་པ་རྣམས་ཀྱིས་ཀྱང་ངོ།",
    "བྷྲཱུཾ་ཧཱུཾ་ཨཱཾ་ཧྲཱི་ཁཾ་ཞེས་པའི་ཡི་གེ་རྣམས་ལས་བྱུང་བའི་དེ་བཞིན་གཤེགས་པ་རྣམས་བསྐྱེད་ནས་ནམ་མཁའ་ལས་བྱོན་ཞིང་རང་རང་གི་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་རྣམས་འདུས་པར་གྱུར་ནས།",
    "ཞེས་བརྗོད་ནས་མྱུར་དུ་རབ་ཏུ་བསྐྱོད་པའི་མིག་གི་རྫི་མས་སྤྱན་མ་ལ་སོགས་པ་རྣམས་ལྕགས་ཀྱུས་བཀུག་ཅིང་།",
    "མཆོད་ཡོན་ཕུལ་ནས་མེ་ཏོག་ལ་སོགས་པ་རྣམས་དང་སྒེག་མོ་ལ་སོགས་པ་རྣམས་ཀྱིས་ཡང་དག་པར་མཆོད་ནས་ཕྱག་བཙལ་བར་བྱའོ།",
    "དེའི་རྗེས་སུ་ལངས་ནས་ཡིད་ཀྱིས་དེ་ཉིད་རྡོ་རྗེའི་དབྱིངས་སོ་ཞེས་ཚིག་ཏུ་བརྗོད་ནས་བདག་ཉིད་རྣམ་པར་སྣང་མཛད་དུ་གྱུར་པར་བསམ་མོ།",
    "རྡོ་རྗེ་དང་བཅས་པའི་ལག་པ་གཡས་པའི་མཐེ་བོ་དང་མཛུབ་མོ་དག་གིས་ཐིག་སྐུད་བཟུང་ནས་སེ་གོལ་གྱི་སྒྲ་བྱའོ།",
    "ཐིག་གི་སྒྲ་དེས་ཀྱང་ནམ་མཁའ་ཐམས་ཅད་ཁྱབ་ནས་དེ་བཞིན་གཤེགས་པ་རྣམས་ཡང་དག་པར་བསྐུལ་བར་བྱའོ།",
    "དེ་རྣམས་ཀྱང་བྱོན་ནས་ཐིག་སྐུད་ཀྱི་ནང་དུ་ཐིམ་པར་བསམ་མོ།",
    "ཐམས་ཅད་དུ་ཡང་སློབ་དཔོན་དང་སྒྲུབ་པ་པོའི་ཕྱི་མ་ཡང་གཡས་སྐོར་དུ་འགྲོ་བར་བྱ་ཞིང་ཕྱོགས་ཐམས་ཅད་མཉམ་པ་ཉིད་དུ་མོས་པར་བྱའོ།",
    "སླར་ཡང་དེ་ལ་ནུབ་ཏུ་གནས་ནས་ཞལ་ཤར་དུ་ཕྱོགས་པས་བྱང་གི་ལོགས་ཐིག་གོ།",
    "དེ་ཉིད་ལ་གནས་ནས་བྱང་གི་ཐིག་གོ།",
    "ཨོཾ་ཨཱ་ཧཱུཾ་བཛྲ་མུ་ཞེས་པས་ཡེ་ཤེས་ཀྱི་ཐིག་གཤེགས་པར་བྱ་སྟེ་ནམ་མཁའ་ལ་བཞུགས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་ཐུགས་ཀར་བཞུགས་ཤིང་ཚོན་སྐུད་སྣ་ལྔ་པ་གནས་ཇི་ལྟ་བར་གཞག་པར་བྱའོ་ཞེས་པ་ནི་ཐིག་གདབ་པའི་ཆོ་གའོ།",
    "དེ་ནས་ལྟེ་བའི་གནས་ཀྱི་ཕུར་བུ་ཧཱུཾ་ཡིག་བཞིས་བཏོན་ཏེ་རང་གི་ལག་པར་གནས་པའི་རྡོ་རྗེའི་ནང་དུ་བསྒོམས་ཏེ་ཁུང་བུ་ཚོན་སྣ་ལྔས་དགང་བར་བྱའོ།",
    "སྒོ་བཞི་རྣམས་སུ་སོ་སོར་སྒོའི་དབུས་སུ་གནས་པའི་རེ་ཁཱ་བཞི་རྣམས་དབྱིའོ།",
    "དེ་བཞིན་དུ་སོ་སོར་སྒོ་ཁྱུད་ཀྱི་ནང་དུ་གནས་པའི་རེ་ཁཱ་བཞི་རྣམས་དབྱིའོ།",
    "དེ་བཞིན་དུ་སོ་སོར་འགྲམ་ལ་གནས་པའི་རེ་ཁཱ་བཞི་རྣམས་དབྱིའོ།",
    "དེ་བཞིན་དུ་སོ་སོར་རྡུལ་ཚོན་གྱི་སར་གནས་པའི་རེ་ཁཱ་ཉི་ཤུ་རྩ་བརྒྱད་རྣམས་དབྱིའོ།",
    "དཀྱིལ་འཁོར་རྣམས་སོ་སོར་རེ་ཁཱ་དྲུག་དྲུག་དང་གཙོ་བོའི་གནས་ལ་རེ་ཁཱ་བཅུ་གཉིས་རྣམས་དབྱིའོ།",
    "འདིར་ཡང་སྒོ་བཞི་རྣམས་སུ་སོ་སོར་སྒོའི་དབུས་སུ་གནས་པའི་རེ་ཁཱ་བཞི་བཞི་རྣམས་དབྱིའོ།",
    "དེ་བཞིན་དུ་སོ་སོར་སྒོ་ཁྱུད་ཀྱི་ནང་དུ་གནས་པའི་རེ་ཁཱ་བཞི་རྣམས་དབྱིའོ།",
    "དེ་བཞིན་དུ་སོ་སོར་འགྲམ་དག་ལ་གནས་པའི་རེ་ཁཱ་གཉིས་པ་དག་དབྱིའོ།",
    "དེ་བཞིན་དུ་སོ་སོར་རྡུལ་ཚོན་གྱི་སར་གནས་པའི་སུམ་ཅུ་སོ་བཞི་སུམ་ཅུ་སོ་བཞིའི་རེ་ཁཱ་རྣམས་དབྱིའོ།",
    "དེ་བཞིན་དུ་ལོགས་ཀྱི་ཀ་བ་དག་གི་བར་དུ་གནས་པའི་སོ་སོར་ཐིག་ལྔ་ལྔ་དབྱི་བར་བྱའོ།",
    "དེ་བཞིན་དུ་རིན་ཆེན་ཤར་བུའི་ས་གཞི་ལ་གནས་པའི་སོ་སོར་རེ་ཁཱ་ལྔ་ལྔ་རྣམས་དབྱིའོ།",
    "དེ་བཞིན་དུ་མདའ་ཡབ་ཀྱིས་གཞིལ་གནས་པའི་སོ་སོར་རེ་ཁཱ་དྲུག་དྲུག་རྣམས་དབྱིའོ།",
    "ནང་གི་དཀྱིལ་འཁོར་དུ་གནས་པས་རྡོ་རྗེས་མཚན་པའི་ལག་པ་གཡས་དང་གཡོན་གྱི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས།",
    "ཕྲ་མོས་ནོར་རྣམས་རྣམ་པར་ཉམས།",
    "གང་གི་ཚེ་མི་བསྐྱོད་པས་གཙོ་བོ་བྱེད་པ་དེའི་ཚེ་དཀར་པོ་དང་སེར་པོ་དང་དམར་པོ་དང་ལྗང་གུ་དང་ནག་པོ་རྣམས་སོ།",
    "ཡིད་ཀྱིས་རེ་ཁཱ་ཡོངས་སུ་གདབ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་གཡོན་དུ་ལས་ཀྱི་རྡོ་རྗེ་མའི་རྩེ་མོ་བཅུ་གཉིས་པ་ཁ་དོག་ལྔ་པའི་སྣ་ཚོགས་རྡོ་རྗེའིའོ།",
    "རྡོ་རྗེ་ཏོག་གི་ཡིད་བཞིན་གྱི་ནོར་བུའི་རྒྱལ་མཚན་ནོ།",
    "བྱང་གི་དཀྱིལ་འཁོར་ལ་དོན་ཡོད་གྲུབ་པའི་སྣ་ཚོགས་རྡོ་རྗེའོ།",
    "རྡོ་རྗེ་འཆིང་བའི་རྡོ་རྗེ་ཁུ་ཚུར་དག་གིས་བཟུང་བའི་རྡོ་རྗེ་རྩེ་ལྔ་པ་སེར་པོའོ།",
    "མེ་ལ་སོགས་པའི་མཚམས་རྣམས་ལ་རྡོ་རྗེ་སྒེག་མོའི་རྡོ་རྗེ་གཉིས་སོ།",
    "རྡོ་རྗེ་གར་མའི་རྡོ་རྗེ་རྩེ་གསུམ་པས་མཚན་པའི་ལག་པ་གཉིས་སོ་ཞེས་པ་ནི་ནང་གི་དཀྱིལ་འཁོར་ལའོ།",
    "རྡོ་རྗེ་མེ་ཏོག་མའི་མེ་ཏོག་གི་ཟ་མ་ཏོག་གོ།",
    "ཤར་ལ་སོགས་པའི་སྒོའི་ལོགས་གཉིས་སུ་བྱམས་པའི་ཡལ་ག་དང་བཅས་པའི་ཀླུ་ཤིང་གི་མེ་ཏོག་གོ།",
    "ངན་སོང་ཀུན་འཇོམས་ཀྱི་ལྕགས་ཀྱུའོ།",
    "ཡེ་ཤེས་ཏོག་གི་ཡིད་བཞིན་གྱི་ནོར་བུའི་རྒྱལ་མཚན་ནོ།",
    "རྡོ་རྗེ་རྩེ་མོ་ཡོངས་སུ་བཟླས་པའི་བའི་རྣམ་ལྔ་དང་།",
    "དམ་ཚིག་གི་འཁོར་ལོ་རབ་ཏུ་བཞུགས་པར་བསམ་མོ།",
    "དེ་ལས་གཞན་དཀྱིལ་འཁོར་ལ་སོ་སོའི་རྣམས་ཀྱིས་ལན་ཉི་ཤུ་རྩ་གཅིག་གིས་བྱིན་གྱིས་བརླབས་ཏེ།",
    "ཡི་གེ་བརྒྱ་པ་ཡང་བརྗོད་ནས་ཉེར་སྤྱོད་ལྔ་ལ་སོགས་པ་རྣམས་ཀྱིས་མཆོད་ནས་སྒེག་མོ་ལ་སོགས་པ་བརྒྱད་ཀྱི་ཆོ་གས་ཀྱང་གཏོར་མ་དང་ཞལ་ཟས་དབུལ་ཞིང་དཀྱིལ་འཁོར་ལྷག་པར་གནས་པར་བྱའོ།",
    "མཚན་མོ་ཚོགས་ཀྱི་འཁོར་ལོ་བྱའོ།",
    "དེའི་པུས་མོའི་ནང་དུ་ལག་པ་དག་བྱས་ཏེ་ཙོག་པུར་འདུག་ནས་མི་སྨྲ་བས་ལག་པའི་མཐིལ་གྱི་ཆ་ཡིས་ཁ་ལ་མིག་ཏུ་ཡོངས་སུ་རེག་ཅིང་ལན་གཉིས་སམ་གསུམ་དུ་རྣ་བའི་བུག་དང་མིག་དང་ཁ་དང་ལག་པ་དག་དང་ལྟེ་བ་དང་མགོ་བོ་རྣམས་ལ་ཡང་ལས་ཐམས་ཅད་པའི་བུམ་པའི་ཆུས་རེག་ཅིང་ཉེ་རེག་ཀྱང་ཉི་མ་སོ་སོ་ལ་བྱའོ།",
    "དགའ་ཆེན་སྟོན་པ་ཁྱོད་གཅིག་པོ།",
    "ཁྱོད་ལ་ཡང་དག་བསྟན་པར་བྱ།",
    "ཁྱོད་ནི་ཚུལ་ཆེན་སྣོད་ཡིན་གྱིས།",
    "གང་གི་ཤཱཀྱ་སེང་གེ་སོགས།",
    "དེའི་རྗེས་ལ་སོར་བཅུ་གཉིས་པའི་ཚད་ཀྱིས་འོ་མ་ཅན་གྱི་ཤིང་དྲིའི་ཆུས་བཀྲུས་ལ་རྩེ་མོ་ལ་མེ་ཏོག་བཅིངས་ལ།",
    "འོག་ཏུ་ཕྱོགས་ན་འོག་གི་དངོས་གྲུབ་པོ།",
    "བདག་གིས་ཁྱེད་རྣམས་རྒྱལ་བ་ཀུན།",
    "ཟབ་མོ་རྟོག་པ་ཐམས་ཅད་ཀྱིས།",
    "གང་གི་ཚེ་ན་འབྱུང་འགྱུར་བ།",
    "བརྒྱ་ལམ་ན་ནི་རེས་འགའ་འབྱུང་།",
    "གང་གིས་བྱེད་ནུས་མྱ་ངན་འདའ།",
    "གདན་གྱི་སྟེང་དུ་ཀུ་ཤ་ཧ་ཡིག་གིས་བོན་ལས་བསྐྱེད་པའི་ཀུ་ཤ་ལ་ཨོཾ་བཛྲ་རཀྵ་ཧཱུཾ་ཞེས་པའི་སྔགས་འདིས་ལན་བདུན་བཟླས་ནས་གདན་གྱི་དོན་དུ་སྦྱིན་པར་བྱའོ།",
    "མེ་ཏོག་གི་སྙིམ་པ་ཐལ་མོ་སྦྱར་ནས་གསོལ་བ་གདབ་པར་བྱ་སྟེ།",
    "དགའ་ཆེན་སྟོན་པ་ཁྱོད་གཅིག་པོ།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་སུ་ཞུགས་ཀྱིས།",
    "དེ་ནས་ངས་ཁྱེད་ལ་རྡོ་རྗེ་ཡེ་ཤེས་བསྐྱེད་པར་བྱ་ཡིས་ཡེ་ཤེས་གང་གིས་ཁྱོད་ཀྱི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དངོས་གྲུབ་ཀྱང་ཐོབ་པར་འགྱུར་ན་དངོས་གྲུབ་གཞན་རྣམས་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "ཁྱོད་ཀྱིས་འདིར་དཀྱིལ་འཁོར་མ་མཐོང་བ་རྣམས་ཀྱི་མདུན་དུ་སྨྲ་བར་མི་བྱ་སྟེ།",
    "ཁྱོད་དམ་ཚིག་ཉམས་པར་གྱུར་ཏ་རེ་ཞེས་བརྗོད་ནས་དེ་ནས་རྡོ་རྗེ་སློབ་དཔོན་རང་ཉིད་སེམས་དཔའ་རྡོ་རྗེ་ཅན་གྱི་ཕྱག་རྒྱ་ཉིད་སྟེང་དུ་གདོང་ཕྱོགས་པས་བཅིངས་ཏེ།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་འགའ་ཞིག་ལ།",
    "ང་ཡིས་འདི་གྱིས་ཤིག་ཅེས་གང་བསྒོ་བ་དེ་ཁྱོད་ཀྱིས་བྱ་དགོས་སོ།",
    "ཁྱོད་ཀྱིས་ང་ལ་བརྙས་པར་ཡང་མི་བྱ་སྟེ།",
    "དེ་རིང་ནས་བརྩམས་ཏེ་ཁྱེད་ཀྱི་ཕྱག་ན་རྡོ་རྗེ་ང་ཡིན་གྱིས་ངས་འདི་གྱིས་ཤིག་ཅེས་གང་བསྒོ་བ་དེ་ཁྱོད་ཀྱིས་བྱ་དགོས་སོ།",
    "ཁྱོད་ཀྱིས་ང་ལ་བརྙས་པར་ཡང་མི་བྱ་སྟེ།",
    "འདི་ཁྱོད་དམ་ཚིག་རྡོ་རྗེ་སྟེ།",
    "དེ་ནས་རྡོ་རྗེ་སློབ་དཔོན་གྱིས་རྡོ་རྗེ་སེམས་དཔའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ།",
    "རིགས་ནི་གང་གི་སྣོད་དུ་རུང་།",
    "དེ་ནས་ཁྱོད་ཀྱི་མིག་སྔར་ཇི་ལྟར་སྣང་ཞེས་དྲི་བར་བྱའོ།",
    "དེ་ནས་ཤར་གྱི་སྒོར་རང་གི་ཐུགས་ཀར་མེ་ཏོག་གི་སྙིམ་པ་སྦྱར་ལ་ལུས་ཀྱིས་ཕྱག་བཙལ་བར་བྱ་སྟེ།",
    "དེ་ནས་རྡོ་རྗེའི་ཐལ་མོ་སྤྱི་བོར་བཟུང་ནས་ཞལ་ས་ལ་བཏུད་དེ་ནུབ་ཀྱི་སྒོ་ནས།",
    "ཁྱོད་ཀྱི་དངོས་གྲུབ་སྦྱོར་ཉིད་ཀྱང་།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "བདག་གིས་སོ་སོར་བརྟན་པར་གཟུང་།",
    "དེང་ནས་བརྩམས་ཏེ་བདག་གིས་གཟུང་།",
    "དེ་ཉིད་བདག་གིས་སོ་སོར་གཟུང་།",
    "སློབ་དཔོན་དག་ཀྱང་བདག་གིས་གཟུང་།",
    "ཉིན་རེ་ཉིན་རེར་དུས་དྲུག་ཏུ།",
    "སྦྱིན་པ་རྣམ་བཞི་བདག་གིས་སྦྱིན།",
    "དེ་ཉིད་སོ་སོར་བདག་གིས་གཟུང་།",
    "དམ་པ་བདག་གིས་བསྐྱེད་བགྱི་ཞིང་།",
    "མ་བརྒལ་བ་རྣམས་བདག་གིས་བསྒྲལ།",
    "མ་གྲོལ་བ་རྣམས་བདག་གིས་དགྲོལ།",
    "མགོན་པོ་འཁོར་ལོ་ལྷ་དག་གིས།",
    "ཨོཾ་སརྦ་བུདྡྷ་ཙཱུ་ཌ་མ་ཎི་མ་ཧཱ་མུ་ཀུ་ཊ་ཏྲཱཾ།",
    "ཀྱེ་དཔལ་རྡོ་རྗེ་ཆེ་གེ་མོ་ཞེས་བྱ་བའི་དེ་བཞིན་གཤེགས་པ་ས་འོག་ས་སྟེངས་མཐོ་རིས་རྣམས་སོ།",
    "ཐམས་ཅད་དུ་རྡོ་རྗེ་སེམས་མ་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་ཀྱི་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་གིས་བདག་ནི་ཁྱོད་དྲིན་ལས།",
    "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་ཟུངས།",
    "བཅོམ་ལྡན་འདས་དང་པོའི་མཆོག་གི་སྐྱེས་བུའོ།",
    "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་ཟུངས།",
    "བདག་གིས་ཁྱེད་འདིར་ལུང་བསྟན་བགྱི།",
    "ཀྱེའི་རྡོ་རྗེ་ཆེ་གེ་མོ་ཞེས་བྱ་བའི་དེ་བཞིན་གཤེགས་པས་ཁྱོད་ཀྱི་དམ་ཚིག་འགྲུབ་སྟེ།",
    "འདི་ལྟར་འདི་ཉིད་ལས་བྱུང་བའི་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་ཏུ་གསང་བ་མཆོག་གི་དངོས་གྲུབ་ཀྱི་གནས་འདི་ཡང་སྔགས་ཀྱི་སྟོབས་ཀྱིས་ཞེས་དེ་དད་པར་བྱའོ་ཞེས་པ་ནི་ལུང་བསྟན་པའོ།",
    "གང་གིས་བསྐྱེད་པ་ཙམ་གྱིས་ནི།",
    "རང་གི་བདག་ཉིད་མནར་གྱུར་པའི།",
    "ད་ནི་སྔགས་དང་རྒྱུད་དག་གིས།",
    "ཁྱོད་ཀྱི་དཀྱིལ་འཁོར་སློབ་དཔོན་གཟུང་།",
    "ཁྱོད་ཀྱི་དཀྱིལ་འཁོར་ཆོ་ག་བཞིན།",
    "དེའི་ངོ་བོ་ཁྲིའི་སྟེང་དུ་སྣ་ཚོགས་པདྨ་འདབ་མ་བརྒྱད་པ་ལ་གནས་ནས་རང་གི་ཡི་དམ་གྱི་ལྷའི་རྣལ་འབྱོར་གྱིས་ཡང་དག་པར་བཀོད་དེ་དམ་ཚིག་སེམས་དཔའི་ཐུགས་ཀའི་སྟེང་ནས་འོད་ཟེར་བྱུང་ནས་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའི་རྣམ་པས་ནམ་མཁའ་ཁྱབ་པས་བུམ་པ་དང་།"
  ]
}