    "ཁང་པར་གནས་པ་ལ་སོགས་པ་ཁོམ་ལྡན་ཡོད་ཅིང་འཁོར་དང་ཡོ་བྱད་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པ་ལ་ནི་ཕན་པར་གྱུར་པ་ཡིན་ལ།",
    "ཇི་ལྟར་དམ་པ་བྱས་གཟོ་བ།",
    "ཨ་རུ་ར་མར་གྱི་ནང་དུ་བསྲོས་ཏེ་བཟའ་བ་དང་བསྲོས་པའི་མར་དེ་འཐུངས་པར་གྱུར་ན་ལུས་རྒས་སྲ་བ་ལ་སོགས་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་བྱས་པ་གཟོ་བའི་མི་ལ་ཕན་བཏགས་ན་དེའི་མི་བརྗེད་པར་སེམས་ལ་འཇོག་པ་དང་འདྲའོ།",
    "ཁ་ར་མར་དང་ལྡེ་གུར་བྱས།",
    "སྐྱུ་རུ་རའི་ཁུ་བ་དང་སྦྲང་རྩི་དང་མར་དང་ཁ་ར་ལྡེ་གུར་བྱས་པ་ཟས་ཤིང་ཁ་ཟས་འཕྲོད་པ་ལ་བསྟེན་པའི་མི་རྒས་པའི་གནོད་པ་གང་ཡིན་པར་དེ་འཇིག་པར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་བསྟན་བཅོས་རྒྱ་ཆེན་པོ་ལེགས་པར་བཟུང་ནས་བརྗེད་དུ་མི་རུང་བར་འགྱུར་བ་དང་མཚུངས་སོ།",
    "སྐྱུ་རུ་ར་ལ་སོགས་པ་ཇི་སྐད་སྨོས་པ་བཞིན་བསྟེན་ཡང་ན་ཚོད་མཛེས་པ་ལ་སོགས་པར་འགྱུར་རོ།",
    "ལྕགས་ནག་པོའི་ཕྱི་མ་ལ་སོགས་པ་ཇི་སྐད་སྨོས་པ་བཞིན་དུ་བསྟེན་ན་ཡང་ཚེ་རིང་ཞིང་སྐྲ་གནག་པར་འགྱུར་རོ།",
    "མི་གང་བྱི་དང་ག་ལ་སོགས་པའི་ལྡེ་གུ་ཟོས་བ་དེ་ནི་ན་ཚོད་དར་ལ་བབ་པ་དང་ལྡན་པར་འགྱུར་ཞིང་།",
    "རྒས་པའི་ཆུ་བོའི་རྦ་རླབས་ལས་ངེས་པར་རྒལ་བར་འགྱུར་རོ།",
    "སེང་ལྡེང་ལ་སོགས་པའི་ལྡེ་གུ་བསྟེན་ན་ཡང་ངེས་པར་ཚེ་རིང་བར་འགྱུར་བ་ཡིན་ནོ།",
    "སྐྱེས་བུ་དམ་པས་བསྟེན་པར་གྱུར་ན་ནི།",
    "ཛི་བ་ཀ་ཞེས་བྱ་བ་ཨ་ས་ནའི་ཁུ་བ་ལ་སོགས་པའི་ལྡེ་གུ་བསྟེན་ན་ཡང་རྒས་པ་ལ་སོགས་པའི་འཚེ་བ་མེད་པར་འགྱུར་རོ།",
    "རྒས་ཤིང་རྙིང་པའང་སླར་ནི་གཞོན་པར་འགྱུར།",
    "འཆི་བའི་བར་དུ་སོན་ནི་བརྟན་པར་འགྱུར།",
    "ཡིད་དུ་འོང་བའི་བདེ་བ་འཐོབ་པར་འགྱུར།",
    "སྐྱེས་བུ་གང་ཏིལ་དང་ལྷན་ཅིག་ཏུ་སྐྱུ་རུ་ར་ལ་སོགས་པ་བརྡུངས་པ་བཅས་ཏེ་ཟོས་ན་ཡང་མི་དེ་ཇི་སྐད་སྨོས་པའི་མདངས་དང་ལྡན་པར་འགྱུར་ལ།",
    "དེ་བཞིན་དུ་བྲག་ཞུན་ལ་སོགས་པ་ཟོས་ན་ཡང་ལུས་ཟུངས་ཟླ་བ་ཡར་གྱི་ངོ་ལྟར་རྒྱས་པར་འགྱུར་རོ།",
    "ལོ་བརྒྱར་འཚོ་བ་དག་ཀྱང་ཐོབ་པར་འགྱུར།",
    "གཞོན་ཞིང་མདངས་ལྡན་ཡོན་ཏན་ལྡན་པར་འགྱུར།",
    "རི་ལུ་སུམ་བརྒྱ་བྱས་ནས་རི་ལུ་དེ།",
    "གྲིབ་མར་བསྐམས་ཏེ་རིམ་གྱིས་མ་ལུས་པར།",
    "འདིར་ནི་རྣམ་པ་ཐམས་ཅད་དུ་མ་ཞུ་བའི་བག་སྤང་པར་བྱའོ།",
    "ལྕགས་ཀྱི་ཕྱེ་མ་ཞིབ་པར་བྱས་ཏེ་བསྐོལ།",
    "དེ་བཞིན་མར་དང་བསྲེས་པར་གྱུར་པ་དང་།",
    "དེ་བཞིན་མར་དང་བསྲེས་པར་གྱུར་པ་དང་།",
    "སེང་ལྡེང་ལ་སོགས་པ་ཆ་མཉམ་པར་བྱས་ཏེ་བཏགས་ལ།",
    "དེ་བཙགས་ནས་ཆ་གཅིག་ཏུ་བྱས་པ་དང་།",
    "ཟླ་གཅིག་བར་དུ་བསྟེན་པར་གྱུར་ན་ནི།",
    "ཏིལ་མར་བསྟེན་པར་བྱེད་པ་དག།",
    "འོན་ཀྱང་ཁྱད་པར་ནི་ཏིལ་མར་གྱི་སྦྱོར་བས་ལུས་ནག་པོ་ཉིད་དུ་འགྱུར་རོ།",
    "བཅུད་ཀྱིས་ལེན་གྱི་ཆོ་ག་བསྟན་པ་ལས་ལེགས་པར་མ་སྤྱད་པ་ཉམས་པར་གྱུར་ཏེ།",
    "བདེན་པར་སྨྲ་ཞིང་ཁྲོ་བ་མེད།",
    "མི་རྟག་པར་བདེན་པར་སྨྲ་བ་དང་།",
    "དམ་པའི་སྤྱོད་ལམ་ལ་དགའ་བ་རྣམས་ནི་རྟག་ཏུ་བཅུད་གྱིས་ལེན་ཡིན་པར་ཤེས་བར་བྱའོ།",
    "བདེན་པར་སྨྲ་བ་ལ་སོགས་པའི་ཡོན་ཏན་འདི་དག་དང་ལྡན་པས།",
    "མི་གང་ཞིག་བཅུད་ཀྱིས་ལེན་བསྟེན་ཞིང་སྤྱོད་པར་བྱེད་པ་དེ་དག་ནི་བདེ་ཞིང་དགའ་བ་དང་ཚེ་རིང་བ་དང་།",
    "འཇིག་རྟེན་འདི་དང་འཇིག་རྟེན་གཞན་དག་ཏུ་བདེ་བ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "གང་ན་ཉེ་འཁོར་དུ་གནས་པའི་གྲོགས་ཀྱི་སེམས་དང་རྗེས་སུ་མཐུན་པར་འཇུག་པ་དང་།",
    "དེ་བཞིན་དུ་གཟུགས་དང་སྒྲ་ལ་སོགས་པའི་དོན་ལ་བློ་མ་འཁྲུགས་པར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་བཅུད་ཀྱིས་ལེན་ཡོངས་སུ་རྫོགས་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ཕྱི་མའི་གནས་ཀྱི་ལེའུ་སུམ་ཅུ་རྩ་དགུ་པའི་རྣམ་པར་འགྲེལ་པའོ།",
    "བཅུད་ཀྱིས་ལེན་གང་བུ་ཚའི་རྒྱུད་ནི་སྐྱེད་ཅིང་མི་རབས་གནས་པར་བྱེད་པ་དང་།",
    "ཚངས་པར་སྤྱོད་ལ་བདག་ཡི་རང་།",
    "འཇིག་རྟེན་འདི་དང་ཕྱི་མར་བཅུད་ཀྱིས་ལེན་དུ་གྱུར་པའི་ཚངས་པར་སྤྱོད་པ་ལ་གནས་པ་ལ་བདག་ཤིན་ཏུ་ཡི་རང་ངོ།",
    "དེ་ནས་སྣུམ་འགྱུར་སྦྱང་བྱས་པ།",
    "འབྲས་བུ་མེད་པར་གྱུར་པའི་ཤིང་།",
    "ལུས་སྦྱང་བྱས་ཏེ་ཅི་ནུས་པར།",
    "རོ་ཙའི་སྦྱོར་བ་བརྩམ་པར་བྱ།",
    "དེའི་འོག་ཏུ་ནུས་པ་དང་ལྕོགས་པ་ཅི་ཡོད་པས་རོ་ཙ་བའི་སྦྱོར་བ་བརྩམ་པར་བྱའོ།",
    "ཤིང་མངར་ས་ལ་པརྞི་རྣམས།",
    "བྲེ་ནི་བཞི་བཞི་གཞུག་པར་བྱེ།",
    "དེའི་ཁུ་བ་བཞི་ཆ་ལུས་པར་མ་རལ་སོགས་པའི་ཁུ་བ་བཞི་པོ་བྲེ་བཞི་བཞི་བཅུག་ལ་འོ་མ་བྲེ་བཅུ་དྲུག་བཅུག་སྟེ།",
    "དུབ་པ་མེད་པར་ཉལ་པོ་སྤྱོད།",
    "དེའི་འོག་ཏུ་བ་སར་པ་བེའུ་ལན་ཅིག་བཙས་པའི་འོ་མ་འཐུངས་ན་མཚན་རངས་བུ་མེད་ལ་ཉལ་པོ་སྤྱོད་ཀྱང་ངལ་བ་མེད་པར་འགྱུར་རོ།",
    "སྐྱེས་བུ་གང་ཤིང་མངར་བཏགས་པའི་ཕྱེ་མ་ཞོ་གཉིས་མར་དང་སྦྲང་རྩི་དེ་དང་མཉམ་པར་སྦྱར་བ་ཟོས་ལ་དེའི་འོག་ཏུ་འོ་མ་འཐུངས་ན་ཡང་རྟག་ཏུ་ཆགས་པ་སྤྱོད་ནུས་པར་འགྱུར་རོ།",
    "ལུང་བོང་ལྟ་བུར་སྤྱོད་པར་ནུས།",
    "འབྲས་དྲུག་ཅུ་པའི་ཆན་དང་ཁ་རར་བཅས་པ་ཟོས་ན་ཡང་རྒན་པོ་ཞིག་ཡིན་ཡང་དར་ལ་བབ་པ་བཞིན་དུ་འདོད་པ་སྤྱོད་པར་ནུས་སོ།",
    "མཐོང་ན་ངོམས་པར་འགྱུར་བ་མེད་པ་དང་།",
    "དགའ་བའི་ཕྱིར་ནི་ངོ་ཚ་དབེན་པར་སྦྱོད།",
    "ཚིག་སྙན་སྨྲ་ཞིང་མཚུངས་པར་མངོན་དགའ་བཅས།",
    "འདོད་པའི་སྤྱོད་པ་མ་ལུས་སྤྱད་པར་བྱ།",
    "ཡུལ་དང་དུས་དང་ཉམས་སྟོབས་ཀྱི་རྗེས་སུ་མཐུན་པར་སྤྱོད་པ་དང་།",
    "སྦྲང་མ་བྱ་དང་བཅས་པར་གྱུར་པ་ནི།",
    "ཆུང་མའི་ཁ་ཨུཏྤ་ལ་ལྟར་ཤིན་དུ་དྲི་ཞིམ་པར་བྱེད་པ་དང་།",
    "པི་ཝང་སྙན་པའི་སྒྲ་ཉན་པར་བྱེད་པ་དང་།",
    "༧ ༡༩ལ་འོང་བ་ཡང་འདོད་པའི་དོན་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ཡིན་ནོ།",
