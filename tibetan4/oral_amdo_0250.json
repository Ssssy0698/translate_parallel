    "བཙུན་པ་བདག་གི་ཀུན་ཏུ་སྤྱོད་པ་ནི་དགེ་སློང་ངམ་དགེ་སློང་མ་མཐོང་ན་གླང་པོ་ཆེ་ལ་བབས་ནས་དེའི་རྐང་པ་ལ་ཕྱག་བགྱིད་པ་ལགས་པས།",
    "དགེ་སློང་དག་འཚོ་བ་པ་གང་གིས་བདེན་པ་མཐོང་བ་ལས་ཕྱག་བདག་གིར་བྱས་པ་ནི་ེཉམས་ཏེ་མ་རུང་ངོ།",
    "ཀུན་དགའ་བོ་ཁྱོད་ཀྱིས་ལུས་འཕགས་ཀྱི་རི་བོ་མཐོང་ངམ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་རྒྱལ་པོའི་ཁབ་ནས་མི་སྣང་བར་མཛད་པས་དེ་ཉིད་ནས་རྫུ་འཕྲུལ་གྱིས་སྟེང་གི་ནམ་མཁའ་ལས་གཤེགས་ནས་ལུས་འཕགས་ཀྱི་རི་བོ་ལ་བཞུགས་སོ།",
    "དེའི་ཚེ་མ་ག་དྷཱའི་མི་རྣམས་ཀྱི་ཞིང་མཉམ་ཞིང་ཉེ་འཁོར་མཉམ་པ་རྣང་གི་ཁྱད་པར་སྣ་ཚོགས་དག་སྣང་སྒལ་གྱིས་འབྲེལ་ཅིང་མཛེས་པ་དག་གཟིགས་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་བཀའ་སྩལ་པ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་༧བཀའ་མ་སྩལ་མོད་ཀྱི།",
    "ངས་གང་གི་ཕྱིར་བཀའ་སྩལ་པ།",
    "དེ་ཁྱོད་ཀྱིས་ཤེས་ཏེ།",
    "དེ་ལ་དྲུག་གི་མིང་ནི་ཅི་དགའ་བར་བཏགས་སོ།",
    "ཇི་ཙམ་ན་རི་དགས་འཛིན་གྱི་ཆུང་མ་ཤི་ནས་དེས་བུ་དྲུག་གི་ཁྱིམ་ཕུབ་པ་དང་དེ་རྣམས་རང་རང་གི་ཆུང་མ་རྣམས་དང་ལྷན་ཅིག་བྱི་དོར་ལྷུར་ལེན་ཅིང་ཁྱིམ་གྱི་འཚོ་ནམ་མི་སེམས་པར་འདུག་གོ།",
    "བདག་གི་བུ་འདི་དག་རང་རང་གི་ཆུང་མ་དང་ལྷན་ཅིག་བྱི་དོར་ལྷུར་ལེན་ཅིང་ཁྱིམ་གྱི་འཚོ་ནམ་མི་སེམས་པར་འདུག་པས་ཁྱིམ་ཞིག་པར་འགྱུར་རོ།",
    "གལ་ཏེ་ཁྱོད་དད་ན་བུ་མོ་ཞིག་བཙལ་ལོ།",
    "དེའི་བུ་མོ་ས་ག་མ་ཞེས་བྱ་བ་གཟུགས་བཟང་བ།",
    "གཡེར་བ་ཞིག་ཡོད་པ་དེ་བུ་མོ་ཡིད་འཕྲོག་མ་གང་འདོད་པ་རྣམས་དང་ལྷན་ཅིག་ཏུ་སྐྱེད་མོས་ཚལ་གྱི་གཞིར་ཆས་པ་དང་བྲམ་ཟེ་དེ་ཡང་ཕྱོགས་དེར་ཕྱིན་ཏེ།",
    "དེས་བུ་མོ་རྣམས་མཐོང་ནས་དེས་བསམས་པ།",
    "འདི་རྣམས་ཁོ་ན་ལ་རེ་ཞིག་བརྟག་པར་བྱའོ་སྙམ་ནས་དེ་བརྟག་པ་ལྷུར་ལེན་ཅིང་དལ་བུས་འཇབ་ཅིང་དེ་རྣམས་ཀྱི་ཕྱི་བཞིན་དུ་སོང་ངོ།",
    "བུད་མེད་ནི་ཕལ་ཆེར་ཡང་བའི་རང་བཞིན་ཅན་ཡིན་པས་དེ་རྣམས་ལས་ཁ་ཅིག་ནི་བང་རྒྱུག།",
    "ཇི་ཙམ་ན་སྐྱེད་མོས་ཚལ་དུ་ཕྱིན་པ་དང་བུ་མོ་དེ་རྣམས་ནི་རྫིང་གི་འགྲམ་དུ་གོས་རྣམས་བཞག་ནས་མོད་ལ་ཞུགས་ཏེ་རྩེ་བར་བརྩམས་ིསོ།",
    "བུ་མོ་དེ་རྣམས་ནི་ཐོག་མར་རང་ཟས་ཟོས་ནས་དེའི་འོག་ཏུ་འཁོར་གྱི་སྐྱེ་བོ་ལ་སྦྱིན་པར་རྩོམ་མོ།",
    "དེ་ནི་འཁོར་གྱི་སྐྱེ་བོ་ལ་སྔར་བྱིན་ནས་དེའི་འོག་ཏུ་རང་ཟ་བར་རྩོམ་མོ།",
    "དེ་ནས་ཟོས་ཤིང་འཐུངས་ནས་སྐྱེད་མོས་ཚལ་གྱི་བདེ་བ་ཉམས་སུ་མྱོང་བར་བྱས་ནས་དོང་ངོ།",
    "ཇི་ཙམ་ན་ལམ་ཀར་ཆུ་རྒལ་བར་བྱེད་པ་ན་བུ་མོ་དེ་རྣམས་ནི་མཆིལ་ལྷམ་ཕུད་ནས་རྒལ་ལོ།",
    "༣བུ་མོ་༡༢ཐོགས་ཏེ་ཨ་མྲའི་ཚལ་ནས་བྱུང་ངོ།",
    "བྲམ་ཟེ་དེ་ཡང་དེའི་རྗེས་བཞིན་དུ་སོང་བ་ལས་དེས་དེའི་མཚན་ཉིད་དང་སྤྱོད་ཚུལ་དེ་ལྟ་བུ་མཐོང་ནས་དེ་ནས་ངོ་མཚར་སྐྱེས་ཏེ་བུ་མོ་དེ་ལ་དྲི་བར་བརྩམས་པ།",
    "ཁྱོད་སུའི་སྟོབས་ཀྱི་ིབཤེས་གཉེན་གྱི་བུ་མོའོ།",
    "བུ་མོ་ཁྱོད་ལ་ཅུང་ཟད་ཅིག་དྲིས་མ་ཁྲོ་ཞིག།",
    "བུ་མོ་འདི་དག་ཐམས་ཅད་ནི་རྒྱུག་པ་དང་།",
    "ཁྱོད་ནི་ཚུལ་དང་དུལ་བ་ཕུན་སུམ་ཚོགས་པས་དལ་བུས་རྒྱུ་ཞིང་དེ་རྣམས་དང་ལྷན་ཅིག་སྐྱེད་མོས་ཚལ་དུ་འགྲོ་བར་བྱེད་དོ།",
    "དེས་སྨྲས་པ་བུ་མོ་ཐམས་ཅད་ནི་ཕ་དང་མས་བཙོང་བའི་རྫས་ཡིན་ནི།",
    "གལ་ཏེ་བདག་གིས་མཆོངས་སམ་འགྲེས་ནས་རྐང་པའམ་ལག་པ་ཆག་པར་གྱུར་ན།",
    "བུ་མོ་ལེགས་ཏེ།",
    "བུ་མོ་འདི་དག་ནི་གོས་རྣམས་མཐའ་གཅིག་ཏུ་བཞག་ནས་གོས་གཅིག་ཀྱང་མེད་པར་མོད་ལ་ཞུགས་ནས་རྩེ་བར་རྩོམ་ིལ།",
    "ཁྱོད་ནི་ཇི་ཙམ་ཇི་ཙམ་དུ་ཆུར་ནུབ་པ་དེ་ཙམ་དེ་ཙམ་དུ་གོས་རྗེ་བར་བྱེད་དོ།",
    "ཁུ་གུ་བུད་མེད་ནི་ངོ་ཚ་ཤེས་པ་དང་ཁྲེལ་ཡོད་པ་དང་ལྡན་པར་བྱ་དགོས་པས་གལ་ཏེ་བདག་གི་གོས་ཕུད་པ་འགའ་ཞིག་གིས་མཐོང་ན།",
    "བུ་མོ་ཁྱོད་ལ་དེ་ན་སུ་ཞིག་ལྟ།",
    "༡ ༧ ༣ཁུ་གུ་རེ་ཞིག་ཁྱོད་ཁོ་ནས་ཀྱང་བདག་མཐོང་བར་འགྱུར་རོ།",
    "བུ་མོ་ལེགས་ཏེ།",
    "བུ་མོ་འདི་དག་ནི་རང་སྔར་ཟོས་ནས་དེའི་འོག་ཏུ་འཁོར་གྱི་སྐྱེ་བོ་ལ་ཟན་སྦྱིན་པར་བྱེད་ལ།",
    "ཁྱོད་ནི་འཁོར་གྱི་སྐྱེ་བོ་ལ་སྔར་ཟན་བྱིན་ནས་དེའི་འོག་ཏུ་རང་ཟ་བར་བྱེད་དོ།",
    "བུ་མོ་ལེགས་ཏེ་དེ་ཡང་ཁོང་དུ་ཆུད་དོ།",
    "འཇིག་རྟེན་ཐམས་ཅད་ནི་སྐམ་ལ་མཆིལ་ལྷམ་གྱོན་ལ་ཁྱོད་ནི་ཆུ་ལ་གྱོན་པ་དེ་ཅི།",
    "ཁུ་གུ་འཇིག་རྟེན་བླུན་མོད།",
    "སྲིན་ཀོག་གི་དུམ་བུ་རྣམས་མངོན་ལ།",
    "བུ་མོ་ལེགས་ཏེ་དེ་ཡང་ཁོང་དུ་ཆུད་དོ།",
    "བུ་མོ་དེ་དག་ནི་ཉི་མ་ལ་གདུགས་ཐོགས་ནི།",
    "ཁྱོད་ནི་ཀུན་དགའི་ར་བའི་ཤིང་གི་གྲིབ་མ་ལ་ཐོགས་པར་བྱེད་ན།",
    "ཁུ་གུ་འཇིག་རྟེན་བླུན་མོད་ཀུན་དགའ་ར་བ་ཁོ་ནར་གདུགས་བཅང་འཚལ་ཏེ།",
    "བརྒྱ་༤ ལ་མཆིས་ན་ཡང་དེ་རེས་འགའ་ཞིག་འབབ་པར་བས་ཏེ།",
    "བུ་མོ་ལེགས་ཏེ་དེ་ཡང་ཁོང་དུ་ཆུད་དོ།",
    "བུ་མོ་འདི་ལ་རིགས་པ་ཅི་ཡོད།",
