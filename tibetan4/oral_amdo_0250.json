    "དེ་དེ་ནས་གོས་ཀྱིས་མགོ་བསྒྱུར་ཏེ་ཕའི་དྲུང་དུ་སོང་ནས་མིག་མཆི་ིམས་གང་བས་སྨྲས་པ།",
    "བུ་གལ་ཏེ་དེ་ལྟ་ན་ཐབས་ཤིག་བཤམ་པར་ིབྱས་ལ་དེ་རྣམས་མཐར་གྱིས་ཁ་གདག་གིས་ིམྱ་ངན་མ་བྱེད་ཅིག།",
    "༣དེ་བཞིན་དུ་ལན་བདུན་གྱི་བར་དུ་དམག་ཁ་ཆེན་པོ་བཀྱེ་བ་ལས་རྡུགས་ིརབ་ཏུ་རྡུགས་ཏེ་སླར་ལོག་ནས་རྒྱལ་པོ་རང་ཉིད་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་དང་བྱུང་བ་དང་ས་ག་མའི་བུ་ནང་དུ་འཇུག་པ་དེ་རྣམས་ཀྱིས་དེ་མཐོང་ནས་སྨྲས་པ།",
    "དེས་དེ་རྣམས་ལ་དཔུང་གི་ཚོགསཡན་ལག་བཞི་པ་གཏད་ནས་དེ་རྣམས་དོང་སྟེ་རི་འོར་བ་རྣམས་ཕབ་ནས་གཏེའུ་བཟུང་དཔྱ་བླངས་ཏེ།",
    "རེ་ཞིག་ལྷའི་དཀའ་བས་བསྒྲུབ་པ་གང་ལགས་པ་དེ་ནི་འདི་དག་གིས་འབྲིང་གིས་བསྒྲུབས་ཀྱིས་ལྷས་འདི་ལ་དགོངས་ཤིག།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "གདོན་མི་ཟ་བར་ལྷས་སྲིང་མོའི་བུ་རྣམས་ལ་བགོ་བ་ཞིག་བསྐུར་བ་ཡིན་གྱིས།",
    "དེ་ནས་ཀོ་ས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་ལུས་རྡུལ་གྱིས་ཡོག་ཅིང་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཆེན་པོ་ཁྱོད་ལུས་རྡུལ་གྱིས་ཡོག་ཅིང་གང་ནས་འདིར་འོངས།",
    "རྒྱལ་པོའི་སྒྲུབ་པ་ཐ་དད་པ་གང་དག་ལགས་པ་དེ་དག་བདག་གིས་བགྱིས་ཏེ།",
    "རྒྱལ་པོ་ཆེན་པོ་དེའི་ཕྱིར་ཁྱོད་ཉིད་ལ་དྲི་བར་བྱས།",
    "ཁྱོད་ཀྱིས་ཇི་ལྟར་བཟོད་པ་དེ་ལན་ཐོབ་ཅིག།",
    "རྒྱལ་པོ་ཆེན་པོ་དཔེར་ན་ཁྱོད་ལ་འདིར་ཤར་ཕྱོགས་ནས་མི་ཡིད་ཆེས་པ་ཡིད་བརྟན་དུ་རུང་བ།",
    "དེ་ནས་བདག་གིས་རི་བྲག་ཆེན་པོ་མ་ཆག་པ།",
    "འདབ་ིམ་ཇི་སྙེད་པ་ཐམས་ཅད་ཕྱེ་མར་རློག་ཅིང་མཆི་བ་མཐོང་གིས་ིལྷ་ཁྱོད་ཀྱི་ིབགྱི་བའམ།",
    "ཁྱོད་ཀྱིས་ཅི་ཞིག་བྱ།",
    "རྒྱལ་པོ་ཆེན་པོ་དེ་ལྟར་རྒ་བ་དང་འཆི་བས་འཇོམས་པ་ན་སྐྱེས་པ་ིགང་དག་གིས་དོན་སྤྱད་པ་དང་ཞེས་བྱ་བ་ནས།",
    "ལང་ཚོ་ཉིད་དང་རྒན་པོ་དང་།",
    "བདག་གི་དོན་ལ་བལྟ་བ་ཡིས།",
    "ལུས་དང་ངག་དང་ཡིད་དག་གིས།",
    "མཐོ་རིས་སོང་ནས་དགའ་བར་འགྱུར།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་སྟན་ལས་ལངས་ནས་སོང་ངོ།",
    "བུ་དག་གལ་ཏེ་དེ་ལྟར་ན་ཁྱེད་ཅག་གི་ིམར་བདག་ཁོ་ན་གྱུར་ཅིག།",
    "རེ་ཞིག་བུད་མེད་དེ་ལན་གཅིག་བཙའ་ིན་ཡང་སྡུག་བསྔལ་གྱི་ཚོར་བས་ཉེན་ནས་དེ་ལྟར་དུ་ན།",
    "དེའི་ཚེ་དེའི་དུས་ཀྱི་བུད་མེད་རྒན་མོ་གང་ཡིན་པ་དེ་ནི་ིས་ག་མ་འདི་ཉིད་ཡིན་ནོ།",
    "ཆོམ་རྐུན་པ་རབ་ཏུ་མང་པོ་ཆང་ཚོལ་ཞིང་དེའི་དྲུང་དུ་འོངས་ནས་དྲིས་པ།",
    "ཆང་འཚོང་གི་ཆུང་མས་སྨྲས་པ།",
    "དེ་གསོད་༧ པ་ན་སེམས་ལ་བདག་གསོད་པ་གང་ཡིན་པ་འདི་དག་ཐམས་ཅད་ནི་ཆང་འཚོང་གི་ཆུང་མ་འདི་ཡིན་གྱིསོ།",
    "དེའི་ཚེ་དེའི་དུས་ཀྱི་ཆང་འཚོང་གི་ཆུང་མ་གང་ཡིན་པ་དེ་ནི་ས་ག་མ་འདི་ཉིད་ཡིན་ནོ་ཞེས་རྒྱས་པར་བྱའོ།",
    "ཇི་ཙམ་ན་བདག་གི་ཡིན་པར་མཐོང་ནས་དེས་དེ་བསྟི་གནས་སུ་བཞག་སྟེ་བསྣུན་བསྟོད་བསྐྱེད་ནས་དེའི་མགོ་རི་དགས་ཀྱི་འདྲ་ིབས་རི་དགས་མགོ་རི་དགས་མགོ་ཞེས་བྱ་བར་གྲགས་སོ།",
    "གལ་ཏེ་རེ་ཞིག་སྒྲ་དྲག་པོར་གྱུར་ན་གྱེན་དུ་འགྲོ་བ་ལྷར་སྐྱེ་བར་འགྱུར་བར་ལུང་སྟོན་པར་བྱེད་དོ།",
    "ཀུན་དགའ་བོ་སོང་ལ་རྒྱུན་དུ་ཞུགས་པ་དང་།",
    "བཙུན་པ་བཀའ་བཞིན་འཚལ་ཞེས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་བཅོམ་ལྡན་འདས་ལས་མཉན་ནས་མགོ་བཞི་ཁྱེར་ཏེ་དྲང་སྲོང་དེའི་དྲུང་དུ་སོང་ནས་ཁྱོད་ཀྱིས་ལུང་སྟོན་ཅིག།",
    "ཁྱོད་ཀྱིས་རིག་པ་ཀུན་ལེགས་གོམས་ིམ་བྱས།",
    "རེ་ཞིག་རིག་པ་མཐའ་དག་རྟོགས་བྱོས་ལ།",
    "ཁྱོད་ཀྱིས་ཕྱི་ནས་འཇིག་རྟེན་ལུང་སྟོན་ཅིག།",
    "ཁྱོད་ཀྱིས་རིག་པ་ཐམས་ཅད་ལ་བྱང་བ་འགའ་མཐོང་ངམ་མཐོང་བ་ཡོད་དམ།",
    "དེ་ནས་རི་དགས་མགོ་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་ནས་ཕྱིན་པ་དང་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་བླ་གབ་མེད་པ་ན་འཆག་ཅིང་རྒྱུ་སྐར་རྣམས་གྱུར་པ་གཟིགས་སོ།",
    "གཟིགས་ནས་ཚེ་དང་ལྡན་པ་རི་དགས་མགོ་ལ་བཀའ་སྩལ་པ།",
    "ཐོས་ནས་ཀྱང་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "༢ ༣འདས་ལ་བུ་མོ་མངག་གཞུག་ིམ་དུས་ཚོད་གསོལ་བ་དུས་ཚོད་གསོལ་དུ་བཅུག་གོ།",
    "ཇི་ཙམ་ན་བུ་མོ་མངག་གཞུག་ིམ་དེ་སྔོན་གྱི་ཀུན་དགའ་ར་བར་སོང་ནས་སྒོ་གསེབ་ནས་བལྟས་ན་དགེ་སློང་རྣམས་སྒྲེན་མོར་ཁྲུས་བྱེད་པ་མཐོང་ངོ།",
    "འཚོ་བ་པ་ནལ་ཕྲུག་འདི་དག་གིས་གཙུག་ལག་ཁང་འདིར་བཏབ་བོ་སྙམ་ནས།",
    "ཇོ་མོ་མཁྱེན་པར་མཛོད་ཅིག།",
    "གདོན་མི་ཟ་བར་འདིས་དགེ་སློང་སྒྲེན་མོ་རྣམས་མཐོང་ངོ་སྙམ་ནས།",
    "ལམ་སྲང་མི་མཁས་པ་ལགས་པས་དེས་བདག་གི་བསོད་སྙོམས་ལ་ལོངས་སྤྱད་ན་སྤྱོད་ཡུལ་ལ་མཁས་པ་དང་།",
    "བཙུན་པ་དགེ་སློང་མཆི་བར་ཆས་པ་བསོད་སྙོམས་ཚོལ་དུ་མཆིས་ེན་འགྲོན་པ་༢རྣམས་དང་བྲལ་བར་འགྱུར་ཞིང་ཚོགས་དང་བྲལ་ན་ཕོངས་པར་འགྱུར་བས་དེས་བདག་གི་བསོད་སྙོམས་ལ་ལོངས་སྤྱད་ན་ཚོགས་དང་འབྲལ་བར་མི་འགྱུར་ལགས་སོ།",
    "བཙུན་པ་དགེ་སློང་བྲོ་གཡོག་བགྱིད་པ་རང་གི་ཆེད་དུ་བསོད་སྙོམས་ཚོལ་དུ་མཆིས་ན་བྲོ་འཚལ་བའི་བགྱི་བ་ཉམས་པར་འགྱུར་བས་དེས་བདག་གི་བསོད་སྙོམས་ལ་ལོངས་སྤྱད་ིན་འགྲུབ་པར་འགྱུར་ལགས་སོ།",
    "དེ་ལ་རེ་ཞིག་དྲོད་ཆུང་བ་གང་ལགས་པ་དེ་རྣམས་ནི་ནས་ཐུག་འཚལ་ན་དྲོད་སྐྱེ་བར་འགྱུར་ལ།",
    "བཙུན་པ་དེ་རིང་ཁོ་ན་བདག་གིས་བུ་མོ་མངག་གཞུག་ིབགྱིད་པ་དུས་ཚོད་གསོལ་བར་བཏང་བ་ལས།",
    "དེས་དགེ་སློང་རྣམས་སྒྲེན་མོར་ཁྲུས་བྱས་པ་མཐོང་ནས།",
    "དེ་དག་གིས་ཉེ་བར་བསྟན་པ་རྣམས་བག་འཁུམས་པར་གྱུར་པས་དེ་རྣམས་བདག་གི་ཁྲུས་རས་ཀྱིས་བཀབ་ནས་ཁྲུས་བགྱིད་པར་འགྱུར་ལགས་སོ།",
    "རེ་ལྟར་ཐོགས་ན་སྲིད་པ་ལན་བདུན་པར་འགྱུར་ཏེ།",
    "དེ་མཉན་ཡོད་དུ་རེས་འགའ་མཆི་ཞིང་སླར་ཡང་མཆི་བར་འགྱུར་ལ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་ཆེ་གེ་མོ་དེ་དགེ་སློང་འདི་ནི་ཀུན་ཏུ་སྦྱོར་བ་གསུམ་སྤངས་ནས་འདོད་ཆགས་དང་།",
    "གཏི་མུག་བསྲབས་པའི་ཕྱིར་ལན་གཅིག་ཕྱིར་འོང་བར་འགྱུར་ཏེ་འཇིག་རྟེན་འདིར་ལན་གཅིག་འོངས་ནས་སྡུག་བསྔལ་གྱི་མཐར་བྱེད་པར་འགྱུར་རོ་ཞེས་ལུང་བསྟན་༧ པ་དེ་ཡང་མཉན་ཡོད་དུ་རེས་འགའ་མཆི་ཞིང་སླར་མཆི་ལ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་ཆེ་གེ་མོ་དེ་དགེ་སློང་འདི་ནི་ཐ་མའི་ཆ་དང་མཐུན་པའི་ཀུན་ཏུ་སྦྱོར་བ་ལྔ་སྤངས་པས་ཕྱིར་མི་འོང་བར་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་འདིར་ཕྱིར་མི་འོང་བར་འགྱུར་རོ་ཞེས་ལུང་བསྟན་པ་དེ་ཡང་རེས་འགའ་མཉན་ཡོད་དུ་མཆི་ཞིང་སླར་མཆི་ལ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་ཆེ་གེ་མོ་དེ་དགེ་སློང་འདི་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ཏེ་དགྲ་བཅོམ་པ་མངོན་སུམ་དུ་བྱས་ནས་ཕུང་པོ་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་སུ་འཇུག་པར་འགྱུར་རོ་ཞེས་ལུང་བསྟན་པ་དེ་ཡང་རེས་འགའ་མཉན་ཡོད་དུ་མཆི་ཞིང་སླར་ཡང་མཆི་སྐྱེལ།",
    "རིམ་གྱིས་རྒྱུ་ཞིང་གཤེགས་པ་ན་ཡངས་པ་ཅན་དུ་བྱོན་ནས་ཡངས་པ་ཅན་གྱི་སྤྲེའུ་རྫིང་གི་འགྲམ་གྱི་ཁང་པ་བརྩེགས་པ་ན་བཞུགས་སོ།",
    "འདིངས་པར་བྱེད་པ་གཟིགས་སོ།",
    "གཟིགས་ནས་ཀྱང་ཡང་འདི་སྙམ་དུ་དགོངས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་མི་རྒྱབ་ནག་པོར་གྱུར་པ་ཞིག་རྒྱང་རིང་པོ་ཁོ་ན་ནས་གཟིགས་སོ།",
    "གཟིགས་ནས་ཀྱང་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་བཀའ་སྩལ་པ།",
    "ཀུན་དགའ་བོ་ཁྱོད་ཀྱིས་མི་རྒྱབ་ནག་པོ་ཕ་བི་མཐོང་ངམ།",
    "སྡུག་ན་ནི་རིམ་གཅིག་གིས་སོ།",
    "ཤིང་དྲུང་གི་གནས་རྣམས་ན་དྲི་མི་ཞིམ་པ་དང་།",
    "དགེ་སློང་ཞིག་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཡང་དགེ་སློང་ཞིག་གིས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་གཅེར་བུ་མི་བྱའོ།",
    "བཙུན་པ་དགེ་སློང་འདི་གཅེར་བུ་མ་གནང་བ་དང་བསླབ་པ་རྣམས་སྤངས་ཏེ་ཉམས་པར་གྱུར་པ་ལ་གཟིགས།",
    "དེའི་བུ་མོ་རང་ཁྱིམ་ཐབ་ིཚོལ་ལོ་ཞེས་ཡུལ་ཕྱོགས་སྣ་ཚོགས་ན་གནས་པའི་བྱ་རྣམས་ཀྱིས་ཐོས་ནས་འདུས་པར་གྱུར་ཏེ་སོ་སོ་ནས་བསམས་པ།",
    "དེའི་ཁྱིམ་ཐབ་ཏུ་བདག་འགྱུར་རོ་སྙམ་མོ།",
    "འདི་ནི་བདག་གི་ཁྱིམ་ཐབ་ཏུ་འགྱུར་རོ།",
    "དེ་ལ་གཞན་དག་གིས་འདིས་ཁྱོད་ཁྱིམ་ཐབ་ཏུ་བདམས་སོ་ཞེས་སྨྲས་པ་དང་།",
    "དེས་མཇུག་ེམ་བསྒྲེངས་ིནས་གར་བྱེད་པར་བརྩམས་པ་དེ་ཡུལ་འཁོར་སྐྱོང་གིས་མཐོང་ནས་སྨྲས་པ།",
    "འདི་ཅི་ཞིག་གི་ཕྱིར་གར་བྱེད།",
    "ཁྱོད་ཀྱི་བུ་མོའི་ཁྱིམ་ཐབ་ཏུ་གྱུར་པས་སོ།",
    "ཚ་དང་ཁྲེལ་དང་མི་ལྡན་པས་ིའདི་ལ་བདག་གི་བུ་མོ་མི་སྦྱིན་ནོ་ཞེས་པ་རྨ་བྱ་དེས་ཐོས་ནས་ཡུལ་འཁོར་སྐྱོང་གི་དྲུང་དུ་སོང་སྟེ་ཚིགས་སུ་བཅད་པས་སྨྲས་པ།",
    "ཅི་སླད་ཁྱོད་ཀྱི་སྲས་མོ་བདག་མི་སྩལ།",
    "ཡུལ་འཁོར་སྐྱོང་གིས་སྨྲས་པ།",
    "འཛེམ་མེད་སྐྱོན་གྱིས་ཁྱོད་ལ་མི་སྦྱིན་ནོ།",
    "ད་ལྟར་ཡང་འདིས་གཅེར་བུ་མ་གནང་ནས་སྡུག་བསྔལ་ཞིང་ཡིད་མི་བདེ་བས་དགེ་སློང་གི་ཚོགས་ཀྱི་ནང་ནས་བྱུང་ངོ།",
    "ཡང་དགེ་སློང་ཞིག་གིས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ངས་འདྲེག་པ་ངས་འདྲེག་པར་རྗེས་སུ་གནང་ན་ཅིའི་ཕྱིར་ཁྱོད་སྐྲ་འབལ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་སྐྲ་འབལ་བར་མི་བྱའོ།",
    "ཡང་དགེ་སློང་ཞིག་གིས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཡང་དགེ་སློང་ཞིག་གིས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཡང་དགེ་སློང་ཞིག་གིས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
