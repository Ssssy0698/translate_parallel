    "ཞེས་པ་བྲིས་ལ་དུར་ཁྲོད་ཀྱི་ཐལ་བས་བཀང་སྟེ།",
    "ཁམ་ཕོར་གྱི་སྔགས་དེ་ཉིད་བརྒྱའམ་སྟོང་རྩ་བརྒྱད་བཟླས་ན་བསྒྲུབ་བྱ་རེངས་པར་འགྱུར་རོ།",
    "ཡང་ཨཱི་ལས་ཆུ་མ་སྔོན་མོ་ཐོད་པ་དང་སྡིགས་མཛུབ་མཛད་པ་འོད་དཔག་མེད་ཀྱི་ཅོད་པན་ཅན་གྱི་ཐུགས་ཀར་ཁྃ་སྔོན་པོ་བསམས་ལ་སྔགས་འབུམ་བཟླས་ཏེ།",
    "བསྒྲུབ་བྱ་གཅེར་བུ་སྐྲ་གྲོལ་བ་སྔོན་པོ་རྔ་མོ་སྔོན་པོ་ལ་ཞོན་པ་རང་ལས་སྤྲོས་པའི་ཁྲོ་བོའི་ཚོགས་ཀྱིས་དབྱུག་པས་བརྡུངས་པས་ཁ་ལྷོར་གཏད་ནས་འབྲོས་པར་བསྒོམས་ལ།",
    "ཨོཾ་ཁྃ་བ་རི་ཡོ་གི་ནི་ཆེ་གེ་མོ་ཨུ་ཙ་ཊ་ཁྃ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་ཛྲིཾ་བཛྲ་ཌཱ་ཀི་ནི་ཆེ་གེ་མོ་དང་ཆེ་གེ་མོ་དག་པི་དྭེ་ཁྃ་ཀུ་རུ་ཛྲིཾ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཡང་ཨ་ལས་བདག་མེད་མ་སྔོན་མོ་གྲི་གུག་དང་ཐོད་པ་ཁ་ཊཱཾ་བསྣམས་པ་མི་བསྐྱོད་པའི་ཅོད་པན་ཅན་གྱི་ཐུགས་ཀར་བུྃ་སྔོན་པོ་བསམས་ལ་སྔགས་འབུམ་བཟླས་ཏེ།",
    "བྲམ་ཟེའི་ཐོད་པ་ལ་དུག་དང་སྐེ་ཚེ་དང་ལན་ཚྭ་དང་སྡིགས་མཛུབ་ཀྱི་ཁྲག་གིས་འཁོར་ལོ་ཟུར་དྲུག་པའི་ཟུར་རྣམས་སུ་ཧཱུྃ་དང་།",
    "དབུས་སུ་ཨོཾ་བུྃ་ནེ་རཱཏྱ་ཆེ་གེ་མོ་ཛ་མ་ར་ཡ་བུྃ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཅེས་པའམ་དམོད་བཅོལ་གཞན་ཡང་བྲིས་ནས་བཟླ་ཞིང་།",
    "ཡང་ཨྃ་ལས་མཁའ་སྤྱོད་མ་དཀར་མོ་ལྟ་བུ་འོད་དཔག་མེད་ཀྱི་ཅོད་པན་ཅན་གྱི་ཐུགས་ཀར་ཧཱུྃ་དམར་པོ་བསམས་ལ་སྔགས་འབུམ་བཟླས་ཏེ།",
    "ཨོཾ་ཧུྃ་ཁེ་ཙ་རི་ཆེ་གེ་མོ་ཨ་ཀརྵ་ཡ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཡང་ཨོ་ལས་ས་སྦྱོང་མ་བདག་མེད་མ་ལྟ་བུ་རྣམ་སྣང་གི་ཅོད་པན་ཅན་གྱི་ཐུགས་ཀར་གྷུ་སྔོན་པོ་བསམས་ལ་སྔགས་འབུམ་བཟླས་ཏེ།",
    "ཨོ་གྷུ་བྷཱུ་ཙ་རི་ཆེ་གེ་མོ་མཱ་ར་ཡ་གྷུ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "བདེ་སྟོང་གི་ཡེ་ཤེས་འགུགས་པར་བྱེད་པ་དང་།",
    "དེས་ཉོན་མོངས་འཇོམས་པ་གསོད་པར་བྱེད་པ་དང་།",
    "རེངས་པ་ལ་སོགས་ལས་རྣམས་ནི།",
    "སྒྲུབ་པ་མཆོག་གིས་བསྒྲུབ་པར་བྱ།",
    "ཨ་ཕུ་འི་རྣམ་པས་མཐའ་ཡས་ཀྱི་གཟུགས་བརྙན་བྱས་ལ།",
    "གཞོན་ནུ་མ་ནག་མོས་བཀལ་པའི་སྐུད་པས་ནི་དཀྲི།",
    "དུར་ཁྲོད་ཀྱི་སོ་ཕག་གིས་ནི་རྡུལ་ཚོན་དམར་པོ།",
    "ཀུན་མའི་ལོ་མ་དང་སྐྱེས་པའི་རུས་པའི་ཕྱེ་མ་དག་གིས་ནི་རྡུལ་ཚོན་ལྗང་གུ་སྟེ།",
    "ཕྱག་བཅུ་དྲུག་གིས་བརྒྱན་པ།",
    "དེ་ནས་སློབ་དཔོན་གྱིས་ནང་གི་མ་རུངས་པའི་སེམས་ཀྱིས་དབེན་པའི་གནས་སུ་སྔགས་བཟླ་སྟེ།",
    "དེ་ལ་ཕྱག་བཅུ་དྲུག་པའི་བསྙེན་པ་སྔོན་དུ་སོང་བས་འདི་ཉིད་ཀྱི་སྔགས་ཀྱང་འབུམ་མམ་ཁྲི་བཟླས་ཏེ།",
    "ཨོཾ་ཨ་ཕུ་སྭཱ་ཧཱ་བརྒྱ་རྩ་སྔགས་ཏེ།",
    "ཁམ་ཕོར་ཁ་སྦྱར་རྒྱུའི་ནང་དུ་ནི་བཞག་བ་ནག་མོའི་འོ་མས་ནི་གཟུགས་སྣོད་དང་བཅས་པ་དགང་།",
    "དུར་ཁྲོད་ཀྱི་སོ་ཕག་གིས་ནི་རྡུལ་ཚོན་དམར་པོ་དང་།",
    "ཀུན་མའི་འོ་མ་དང་སྐྱེས་པའི་ཕྱེ་མ་བསྲེས་པ་དག་གིས་ནི་རྡུལ་ཚོན་ལྗང་གུ་སྟེ།",
    "ཕྱག་བཅུ་དྲུག་གིས་བརྒྱན་པ།",
    "སྒོ་མཚམས་སམ་པདྨའི་འདབ་མ་བརྒྱད་ལ་ཀླུ་བརྒྱད་མནན་པའི་ལྷ་མོ་བརྒྱད་ཀྱང་བྲིའོ།",
    "ཏིང་ངེ་འཛིན་གྱིས་མཐའ་ཡས་གཟིར་ལ་ཆར་དབབ་པོ་སྙམ་པ་ནང་གི་མ་རུངས་པ་སྟེ་ཁྲོས་པའི་སེམས་ཀྱིས་ཐུགས་ཀའི་ས་བོན་གྱི་འོད་ཀྱིས་མཐའ་ཡས་བསྐུལ།",
    "གོང་གི་སྔགས་འདི་ཉིད་འབྲུ་རེ་རེ་ནས་བཟློག་ལ་བཟླ་སྟེ་དེས་ཆར་འབབ་བོ།",
    "བཞི་པ་ཐུན་མོང་བའི་ལས་བརྒྱད་",
    "རྡོ་རྗེ་གྲི་གུག་གི་ཆོ་ག་ལྷ་དགས་པའི།",
    "དང་པོ་རྡོ་རྗེ་གྲི་གུག་གི་ཆོ་ག་",
    "རྡོ་རྗེ་གྲི་གུག་གི་ཆོ་གའོ།",
    "འདི་དག་ལ་ཧེ་རུ་ཀ་བཞི་དང་བདག་མེད་མ་གང་རུང་གི་བསྙེན་པ་སྔོན་དུ་འགྲོ་བས།",
    "ཁ་ཊི་ཀ་སྟེ་རྡོ་རྒྱུས་དང་ནང་གི་བདུད་རྩི་ལྔ་དང་ཀུ་ཋཱ་ར་ཙྪིནྣ་ཏེ་རྩ་ལོང་རྡོལ་བ་དང་ལྷན་ཅིག་བཏགས་ལ་རི་ལུ་མིག་འབྲས་ཙམ་བྱ་སྟེ།",
    "རིལ་བ་སྤྱི་བླུགས་ཀྱི་མགྲིན་པ་རི་ལུ་དེས་རིམ་པ་གཉིས་སུ་བསྐོར་ཞིང་བསྐོར་ནས་རི་མོ་བྱས་པས་བསྒྲུབ་བྱའི་མགྲིན་པ་ལ་རི་མོ་སྣང་བར་འགྱུར་ལ།",
    "སྤྱི་བླུགས་ཀྱི་མགྲིན་པར་རི་མོའི་བར་ནས་བཅག་ན་དགྲ་ཐམས་ཅད་ཀྱི་མགོ་མེད་པར་འགྱུར་རོ།",
    "རྡོ་རྗེའི་གྲི་གུག་གིས་གང་ལ་བཏབ་པ་དེ་གཅོད་པ་ལྟར་དགྲའི་མགོ་བོ་གཅོད་པའི་ཆོ་གའོ།",
    "ནང་དུ་བདེ་སྟོང་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱིས་རྣམ་རྟོག་གམ་ཉོན་མོངས་ཀྱི་ཚོགས་གཅོད་པ་ངེས་དོན་ནོ།",
    "དེ་བརྡར་ལ་རང་གི་དཔྲལ་བར་དགྲ་སྟ་ལྟ་བུའི་ཐིག་ལེ་བྱས་ཏེ་ཕྱག་བྱས་ན།",
    "ཨརྐའི་སྟེ་ཉི་མའི་ཤིང་གི་ལོ་མ་ལ་དུག་དང་སྐེ་ཚེ་དང་ཙི་ཏྲ་ཀའི་སྟེ་རྒྱ་སྐྱེགས་ཀྱི་ཁུ་བས་དགྲའི་གཟུགས་མིང་སྤེལ་ཚིག་དང་བཅས་པ་བྲི་ཞིང་དགུག་གཞུག་སོགས་བྱས་པ།",
