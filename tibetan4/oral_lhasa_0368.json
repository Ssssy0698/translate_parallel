    "ནག་པོ་ཆེན་པོ་སྒྲུབ་པར་འདོད་པས་ཞེས་ཡོད་པའི་སློབ་དཔོན་བྲམ་ཟེ་མཆོག་སྲེད་ཀྱི་མན་ངག་བསད་པའི་ལས་སྦྱོར་རོའི་མཐའ་ཅན།",
    "པ་ས་པཎ་གྱི་དངོས་སློབ་ཧོར་དམག་བཟློག་མཁན་དུ་གྲགས་པ་འོད་ལྡན་དཔལ་གྱིས་མཛད་པ་ཤིན་ཏུ་དག་པར་བྲིས་པ་ཡིན་པ་ཤེས་པར་བྱའོ་ས་མཱ་མི་ཐིའི་མཐའ་མསམས་སམབ་ས་ག་ས་༣ ཅན།",
    "དེས་མཛད་པའི་རྟེན་གྱི་དཀྱིལ་འཁོར་དང་བསྐྱེད་པ་རྟེན་གྱི་འཁོར་ ལོ་མི་དགོས་པར་བསད་མཆོད་རྟེན་མུ་རྡོ་རྗེ་",
    "རྒྱལ་ཚ་ལུང་མང་པོ་ཁུ་དབོན་གྱི་མན་ངག་མ་སྦས་པར་ཤིང་ཕོ་སྟག་ལོ་ཟླ་བ་བཅུ་གཉིས་པའི་ཚེས་བརྒྱད་ལ་ཡར་ཀླུངས་པ་སེངྒེ་རྒྱལ་བསམ་ས་ས་སམ།",
    "མཛད་པའི་དོན་ཊི་ཀ་གསལ་བར་བྱས་པའི་སྒྲུབ་ཐབས་ཤིན་ཏུ་རྒྱས་པ།",
    "གཏོར་མ་མེད་པར་ཁ་ཟས་ལ་བརྟེན་ནས་དགྲ་བསད་པ།",
    "ལྷ་རྣམས་མཉེས་པར་འདོད་པས་མགོན་པོའི་རྟེན་གཏོར་གྱི་མན་མཆོད་རྟེན་ཨེ་མུ་རྡོ་རྗེ་",
    "དཀར་ཆག་ན་གཉིས་ཡོད་སོམས་ལགས་གསུངས་ཀྱང་གཅིག་མ་རྙེད།",
    "ཀུན་མཁྱེན་རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་མགོན་པོ་རང་ལོག་ན།",
    "པ་གསང་བར་བྱས་ནས་སྤྱད་པར་བྱ་འོའི་མཐའ་ཅན།",
    "པའི་འགོར་མགོན་པོའི་སྐུ་བཞེངས་པ་ལ་ཐོག་མར་ཤིང་ལས་བྱས་པའི་རུ་ཤིང་ཞེས་ཡོད་པའི་ལྡེར་སྐུ་བཞེང་ཐབས།",
    "བསྟེན་ཞེས་ཡོད་པའི་རུ་མཚོན་འཛུགས་ན་སས་ས་པ་ཁག་མ་དཔའི་ཆོ་གའི་ཡིག་རྙིང་ཡར་ཀླུངས་པས་ཞུས་དག་མཛད་པ་གཏོར་མ་གདབ་པར་བྱའོའི་མཐའ་ཅན།",
    "རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་རྟེན་གསུམ་རུ་མཚོན་འཛུགས་པ་ཞེས་སྣང་ཞིང་གྱི་ལྗང་པོ་ཏིར་ཡང་བཞུགས།",
    "དེས་མཛད་པའི་བཤགས་པ་མཆོད་རྟེན་མུ་",
    "སྤྲོ་ལུང་ཀུན་སྨོན་གྱིས་མཛད་པའི་བཤགས་པ་མཆོད་རྟེན་",
    "ནག་པོ་ལྕམ་དྲལ་འཁོར་དང་བཅས་པའི་བཤགས་མཆོད་གཏོར་སྒྲུབ་ཞག་སྦྲེལ་མཆོད་རྟེན་",
    "དུ་བྱ་ཚུལ་འདིའི་ནང་དུ་མགོན་པོའི་བཤགས་པ་མལ་གྱི་མངོན་རྟོགས་ནས་བྱུང་བའི་ཡོན་ཏན་ལྷུན་རྫོགས་མུ་",
    "གྲགས་པའི་དཀར་ཆག་ནང་བཞུགས་པའི།",
    "ཞེས་གསུངས་པའི་དོན་དེ་ལྟར་དུ་ངེས་ཀྱང་གཅིག་མ་ཚང་བ་ནི་གཏོར་མའི་ཡི་གེ་གཉིས་སོ་སོར་བགྲང་བ་ཡིན་ནམ་སྙམ།",
    "དེ་ནི་ཞར་ལས་འོངས་པ་འཁོར་ལོའི་དཔེ་རིས་རྣམས་ཞེས་གསུངས་པ་ལ་རགས་རིམ་ཙམ་ལས་མི་གསལ་ཞིང་།",
    "ཆིངས་ཆེན་དྲུག་དང་འཁོར་ལོའི་བྲི་ཡིག་ནས་གསུངས་པའི་བྱད་མ་རང་གཤེད་དབབ་པའི་འཁོར་ལོའམ་བསྲུང་ཟློག་སྦྲགས་མའི་འཁོར་ལོ།",
    "རྗེ་བཙུན་ག་ཡ་དྷ་ར་ནས་བརྒྱུད་པའི་རྗེས་གནང་བྱ་ཚུལ་ནི་ཞེས་ཡོད་པའི་རྗེས་མཆོད་རྟེན་སཏཱ་",
    "སྔར་གསུངས་པ་ཆོ་གས་ཞེས་ཡོད་པའི་སྒྲུབ་ཐབས་ཀྱི་ཁ་མཆོད་རྟེན་ཨེ་",
    "རྒྱ་གཞུང་ཞེས་བྱ་བ་ལ་སོགས་པ་དཔག་ཏུ་མེད་པ་རྟོགས་པར་བྱའོའི་མཐའ་ཅན།",
    "གསེར་པོད་ན་བྲམ་ཟེ་མཆོག་སྲེད་ཀྱིས་མཛད་ཅེས་སྣང་བ་འཐད་པར་སེམས།",
    "རྗེས་གནང་།",
    "གཉིས་པ་རྗེས་གནང་ལ།",
    "མགོན་པོ་ལྕམ་དྲལ་གྱི་རྗེས་གནང་དམ་བཀའ་བསྒོའི་ཡི་གེ་མུ་",
    "རྗེས་གནང་འདི་གཉིས་མུས་སྲད་པའི་གླེགས་བམ་དུ་མེད་ཀྱང་བརྒྱུད་པ་གཅིག་པས་མུའི་རྟགས་ཐོབ་བོ།",
    "ལྕམ་དྲལ་གྱི་རྗེས་གནང་མུ་",
    "ཆོ་ག་མགོན་པོ་རྣམ་པར་རོལ་པ་རྣམས།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ནའང་དེ་ལྟར་སྣང་བ་བརྒྱུད་པ་གཅིག་པར་དགོངས་པ་འདྲ།",
    "རྡོ་རྗེ་ནག་པོ་ཆེན་པོའི་བསྐང་བཤགས་མཆོད་རྟེན་མུ་",
    "བརྩོན་རྣམས་དགའ་ཕྱིར་པར་དུའང་བགྱིས་ཏེ་སྤེལ།",
    "ཐམས་ཅད་མཁྱེན་པ་རྡོ་རྗེ་གདན་པ་ཀུན་དགའ་རྣམ་རྒྱལ་གྱིས་མཛད་པའི་རྡོ་རྗེ་འ་",
    "ལྷ་སྲིན་མ་འདིའི་ནང་ན་ཡོད།",
    "སྐབས་སུ་གནོད་སྦྱིན་ཡབ་ཡུམ་པུ་ཏྲ་མིང་སྲིང་སྒོ་མ་བཞི་རུ་འདྲེན་དང་བཅས་པའི་འཆམས་ཡིག་ལག་ལེན་ལ་འདྲིས་པར་བྱའོའི་མཐའ་ཅན་རྣམས་སོ་། བཅུ་གཅིག་པ་ངོར་ལུགས་ལ།",
    "བཅོལ་བའི་ཕྲིན་ལས་གྲུབ་པར་མཛོད་ཀྱི་མཐའ་ཅན།",
    "ཐེབས་བཟློག་བརྩི་མི་དགོས་ཞེས་ཡོད་པའི་དེའི་ལག་ལེན་གྱི་ཡི་གེ་རྣལ་འབྱོར་སྨྱོན་པའི་མཚོན་ཆར་གནང་བའི་མཐའ་ཅན།",
    "སྔོན་འགྲོ་རྟེན་དང་མཆོད་གཏོར་གྱི་སྐབས་ཉེ་བར་མཁོ་བའི་ཤོག་དྲིལ་བཅུ་པར་གྲགས་པའི་ནང་ཚན།",
    "སྐུ་གཟུགས་བཞེང་ཚུལ་ཡིད་བཞིན་ནོར་བུ་ཞེས་པ་དགོས་འདོད་ཐམས་ཅད་ཀྱི་འབྱུང་ཁུངས་བྲིས་སྐུ་སྒྲུབ་པའི་ཤོག་དྲིལ།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་ཕོ་ཉའི་ལས་སྦྱོར་ཞེས་སྣང་།",
    "དེ་ལྟར་གཏོར་བསྒྲུབ་བྱས་ནས་ཞེས་ཡོད་པའི་གཏོར་མའི་སྒོ་ནས་དགྲ་བགེགས་ཀྱི་སྟོབས་སྲོག་གཞོམ་པའི་ཞལ་ཤེས་བསད་མནན་གཉིས་ཀ་ཚང་བ་ཕྱི་མིག་མི་ལྟ་བར་འོང་བར་བྱའོའི་མཐའ་ཅན།",
    "བྱད་མ་སྲུང་འཁོར་ཅན་གསོད་པའི་གདམས་པ་སྔགས་ནུས་ཅན་ལ་ལྷག་པར་འགྲོ་གསུང་བའི་མཐའ་ཅན།",
    "ན་བོད་འདི་གླེགས་བམ་དུ་བཞུགས་ཀྱང་དཀར་ཆག་ཏུ་མི་གསལ།",
    "དེ་ཉིད་ཀྱིས་མཛད་པ་དངོས་དང་དེའི་གསུང་སྒྲོས་ཟིན་བྲིས་སུ་བྱས་པ་གཉིས།",
    "འདྲེན་མཆོག་དེ་ཡི་དྲིན་ལས་རྙེད་པར་གྱུར།",
    "སྤྱིར་སྙན་བརྒྱུད་ཀྱི་གླེགས་བམ་ཡོངས་རྫོགས་བཀའ་དམ་པར་མ་ཟད།",
    "འདི་ཡང་དུས་གཅིག་ལ་ཆིག་བརྒྱུད་ལས་མི་གནང་།",
    "འདིར་ནི་མ་སྦས་ལག་ལེན་ལྷུག་པར་བྲིས།",
    "ནག་པོ་ཆེན་པོ་ལ་ཀླུ་བརྒྱད་ཀྱིས་བསྐོར་བའི་སྒོ་ནས་ཆར་འབེབས་པའི་ཡི་གེ་ཞག་གསུམ་ཚུན་ལ་འབབ་པར་འགྱུར་རོའི་མཐའ་ཅན།",
    "དམ་ཅན་སྲུང་མ་རྣམས་ལ་ཕྱི་རྟེན་འཛུགས་པའི་ལག་ལེན་གྱི་ཡི་གེ་ནག་པོ་འགྲོ་ཤེས་ཀྱི་ཚུལ་དུ་གཙང་རོང་མཚོ་ལའི་མགུལ་གྱི་རི་ཁྲོད་བསམ་གཏན་རྩེར་སྦྱར་བ།",
    "འདི་འདྲ་ཤེས་པའི་སྔགས་འཆང་ཉིན་སྐར་མསམ་བསམས་པ་ལགས་མ་ག།",
    "དེང་སང་དམར་ནག་འཇིགས་གསུམ་གྱི་ཚབ་ལ་མགོན་པོ་དང་ལས་གཤིན་གྱི་ཚབ་ཏུ་པུ་ཏྲས་བྱས་པའི་མགོན་པོ་དྲུག་ཅུ་པར་གྲགས་པ་སོགས་ནི་ཟུར་ཟ་བའི་ཡུལ་དུ་བྱེད་པའང་ཡོད་དོ་། བསྟོད་བསྐུལ་འོག་མིན་བདེ་ཆེན་མ།",
    "མ་ཧཱ་ཀཱ་ལའི་སྤུ་གྲི་སོ་འདེབས་ཀྱི་མན་ངགཤིན་ཏུ་རྣོ་མྱུར་དུ་བསྒྲུབ་པར་གྲགས་པ།",
    "ཞེས་བཀའ་རྒྱ་དམ་པར་སྣང་ངོ།",
    "སོ་སོའི་ཁྱད་པར་བསྟན་པ་གསུམ་གྱི་ཞལ་ཤེས་སྐལ་བར་ཞལྡན་པ་རྣམས་ཀྱི་དོན་དུ་ལེགས་པར་སྦྱར་བ།",
    "གཞག་བཟོད་པར་གསོལ་བའི་མཐའ་ཅན།",
    "རུ་མཚོན་གྱི་ལས་མཁན་བྲན་བདུད་གཤིན་རྗེ་ནག་པོའི་རྗེས་གནང་བཀའ་གཏད་ཀྱི་ཡི་གེ་སྙན་བརྒྱུད་སྦས་དོན་གསལ་བ་ནག་པོ་འགྲོ་ཤེས་སུ་བཀོད་པ།",
    "ཞེས་གསུངས་པ་རྡོ་རིང་ཀུན་རྒྱན་པ་སོགས་ཀྱིས་མན་ངག་མ་ཚང་བའི་རས་རུལ་བསྡུས་ནས་འཆད་པ་རྣམས་ལ་དགོངས་པ་འདྲའོ།",
    "ཞེས་པ་ཡ་ལ་ས་ཧམ་། ལྟར་རྗེ་བཙུན་ཁའུ་པ་ཡབ་སྲས་ཡན་ལ་ཆིག་བརྒྱུད་ཁོ་ནར་བཞུགས་པས་ཀུན་ལ་མ་གྲགས་ཤིང་།",
    "འདི་གསུམ་རྗེས་གནང་མ་ཐོབ་པར་མི་གནང་བའི་བཀའ་རྒྱ་ཅན་འགོར་ན་མ་ཤྲཱི་གུ་རུ་མ་ཧཱ་ཀཱ་ལཱ་ཡ།",
    "སྟེ་ཞེས་ཡོད་པའི་བསྙེན་པའི་མན་ངག་དཔེ་འདི་མི་ལ་མི་སྟོན་པའི་བཀའ་རྒྱས་བཏབ་ཡོད་ལགས་ཀྱི་མཐའ་ཅན་ཆིག་བརྒྱུད་མའི་གྲས།",
    "མགོན་པོ་ཁྲོ་བཅུའི་བརྒྱུད་འདེབས་བདུད་ལས་རྣམ་པར་རྒྱལ་ཞ་",
    "བདུད་ལས་རྣམ་པར་རྒྱལ་བ་ཞེས་བྱ་བ།",
    "འདི་གཉིས་རྗེས་གནང་མ་ཐོབ་པར་མི་གནང་བའི་བཀའ་རྒྱ་ཅན།",
    "ཡི་གེ་དགེ་སློང་དྷརྨ་གཟི་བརྗིད་ལ་གནང་བ་ལགས་སོའི་མཐའ་ཅན།",
    "འདེབས་ཀྱི་ཡི་གེ་ལས་མགོན་གྱི་རྗེས་གནང་རྫོགས་སོའི་མཐའ་ཅན་རྣམས་སོ།",
    "འདི་མེ་འབར་མར་ཡང་བཞུགས།",
    "འདིའི་སྔགས་བཏུའི་ལེའུའི་འགྱུར་ཁྱད་ཚིགས་བཅད་མ་ལོ་པཎ་གཉིས་ཀྱི་གཡར་དམ་བརྒྱུད་པ་ཞེས་དཀར་ཆག་ཏུ་གསུངས་པ་ལེའུ་བཅུ་གཅིག་པ་འདི་ཁ་ལས་ལོགས་སུ་མ་རྙེད་ཅིང་རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ནའང་མི་སྣང་ངོ།",
    "གྲི་གུག་བརྩེགས་པ་ཐུགས་ཀྱི་རྒྱུད་ཅེས་གསུམ་ཡོད་པ་ལས་གླེགས་བམ་དུ་ཡང་དུར་ཁྲོད་ནག་པོའི་རྒྱུད་ལས་མི་བཞུགས་ཤིང་ཉམས་ལེན་མན་ངག་རྣམས་ཀྱང་འདི་ཁོ་ན་ལ་བརྟེན་པའོ།",
    "ཁོག་ཕུབ་ན་ཕུར་བུའི་སྒྲུབ་སྐོར་རྣམས་ལ་གཞན་ཡང་ཞེས་སྒྲུབ་ཐབས་ཆེ་འབྲིང་ཆུང་གསུམ་དུ་མི་གཏོགས་པའི་ཟུར་པར་མཛད་ནའང་།",
    "བསྟན་པ་གནས་པར་བྱ་བའི་ཕྱིར།",
    "པའི་མགོན་པོ་ཕུར་བུའི་སྒྲུབ་ཐབས་ཀྱི་གསལ་བྱེད་མེ་འབར་མར་ཡང་བཞུགས།",
    "ནང་སྒྲུབ་ཏུ་གྲགས་པ་ནག་པོ་ཆེན་པོའི་ཁྱད་པར་གྱི་ཆོ་ག་བྲམ་ཟེ་མཆོག་སྲེད་ཀྱིས་མཛད་པ་ལ་ལི་ཏ་བཛྲ་དང་གྱི་ལྗང་དབུ་དཀར་གྱིས་བསྒྱུར་བ་འགོར་སློབ་དཔོན་ཆེན་པོ་བྲམ་ཟེ་མཆོག་སྲེད་ཀྱིས་མཛད་པའི་དཔལ་མགོན་པོ་ཆེན་པོའི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་དྲག་བྱེད་ཀྱི་ཚུལ་དུ་ཞེས་ཡོད་རྡོ་རྗེ་",
    "མཆོད་འོས་ཀུན་ལ་བཏུད་བྱས་ཏེ།",
    "པོ་ཆེན་པོའི་མཆོད་ཕྲེང་ལས་ཀྱི་འབྲས་བུ་མཆིས་པར་མཛོད་ཀྱི་མཐའ་ཅན།",
    "མེ་འབར་མར་ཡང་བཞུགས།",
    "འགོར་འདིའི་ལུང་སྦྱིན་པའི་ཚུལ་འདྲི་སྟེ་ཞེས་ཡོད་པའི་རྗེ་ས་ཆེན་གྱིས་དོ་དུ་བས་བབསམ་ཡས་པ་མཁས་པ་གལ་བསམ་པ་སྟོན་ཚུལ་ལ་གནང་བའི་མཆོད་རྟེན་རྡོ་རྗེ་དུང་",
    "མེ་འབར་དུ་ཡང་བཞུགས།",
    "བྲན་བདུད་འདི་ཤིན་ཏུ་བཀའ་གཉན་པས་གསེར་གྱི་མཎྜལ་དང་བཅས་ཆིག་བརྒྱུད་དུ་གནང་བ་ཡང་ཕྱག་ལེན་མའོ།",
    "ནག་པོ་ཆེན་པོའི་རྒྱུད་ལས་རྡོ་རྗེའི་ཚིག་ཏུ་སྦས་ནས་གསུངས་པའི་མན་ངག་རྡོ་རྗེ་མུ་",
    "བརྒྱུད་ཅེས་པ་དྲེགས་བྱེད་ཐམས་ཅད་གནོན་པར་བྱེད་པ།",
    "བགེགས་ཐམས་ཅད་རླག་པར་བྱེད་པ།",
    "དཀར་ཆག་འཇམ་དབྱངས་མཁྱེན་བརྩེས་དཔལ་བདེ་གསལ་གྱི་མགོན་ཁང་དུ་ཞི་",
    "མགོན་པོ་ལྷ་བཅུ་བདུན་མའི་སྒྲུབ་ཡིག་པཎ་ཆེན་བྱམས་པ་གླིང་པས་མཛད་པ་རྣམས་ལེགས་པར་ཐོབ་བོ།",
    "གུར་མགོན་གྱི་སྐབས་མགོན་པོ་ལྕམ་དྲལ་གཉིས་སུ་གྲགས་ནའང་ས་སྐྱ་པའི་ལུགས་ལ་རྗེས་གནང་ཟུར་པ་མེད་ཅིང་སྒྲུབ་ཐབས་ལ་ཚོགས་བདག་བཀའ་སྡོད།",
    "ནང་པ་ལྟར་སྒྲུབ་ཚུལ་ཡོད་ཀྱང་མན་ངག་ཡོངས་སུ་རྫོགས་པ་མེད་པར་བརྟེན།",
    "ཚུལ་དེ་ས་ལུགས་དྭགས་བརྒྱུད་པ་སོགས་གང་དུའང་མ་རྙེད་པར་རིམ་གྱིས་རྩད་གཅོད་གནང་བས་ཆུ་མགོ་གངས་དཀར་གྱི་དཔེ་བཞིན།",
