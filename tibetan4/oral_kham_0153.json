    "ཀྱེ་རྡོར་གྱི་སྒྲུབ་མཆོད་ཚུགས་ཡོད་འདུག་པ་དེར་ཚོགས་སུ་ཞུགས་ཡོད་འདུག་ལ།",
    "ཐུན་མཚམས་རྣམས་སུ་ཞལ་སློབ་ཉུང་ཤོས་ཤིག་ལ་སྣང་གསུམ་གྱི་ཉམས་ཁྲིད་ཅིག་བསྩལ་མཛད་པ་དེ་མཁྱེན་རབ་འོད་ཟེར་ལའང་ཆ་ཚང་ཐོབ་ཡོད་འདུག་པ་མ་ཟད།",
    "ཁྱེད་རང་མྱུར་དུ་དེར་ཕེབས་ན་ངས་ངོ་སྤྲོད་ཡང་གསལ་བྱེད་ཆོག་ཅེས་གསུངས་པ་བཞིན།",
    "སྐུལ་མ་མཛད་ཡོད་འདུག་པ་བཞིན་ཕྱི་མ་རྒྱུད་དང་།",
    "ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མ་སེང་ཧ་མུ་ཁའི་བསྙེན་སྒྲུབ་འདི་གསུམ་ཚད་དང་ལྡན་པ་ཞིག་སྐྱོལ་ཤོག་ཅེས་བཀའ་ལུང་ཕེབས་ཡོད་འདུག་པ་བཞིན།",
    "ཁོང་དེ་འཕྲལ་དབོན་སྟོད་དགོན་དུ་སླར་ལོག་ཡོད་འདུག་པ་དང་།",
    "ང་རང་དཀའ་ལས་ཁེགས་ནས་ཤར་རྒྱག་འགྲོ་ཐུབ་ཀྱི་མི་འདུག་ང་ལ་ངལ་གསོ་ཡུད་ཙམ་ཞིག་རྒྱག་བཅུག་རོགས།",
    "ཁྱེད་རང་ཡོངས་སུ་གྲོལ་བར་འགྱུར་ངེས་པ་ཡིན་ཞེས་ལུང་བསྟན་གནང་བྱུང་བ་བཞིན།",
    "ཚག་ཧྲག་དྲག་པོ་ཞེས་བྱ་བའི་གནས་དེར་གནས་འདུས་ཡོད་འདུག་པ་དང་།",
    "ཁོ་སྐུ་དྲུང་དུ་སླེབས་དུས་ཉེ་སྐོར་དེར་མཆོད་མེ་མང་ཞིག་ཡོད་པ་ཚང་མ་སྦར་ཚར་ནས་ཡོད་འདུག་པ་མཐོང་།",
    "ཅེས་ཟེར་གྱི་འདུག་པས་ངེས་ཤེས་ཐུབ་པ་ཡིན་ནོ།",
    "སྲིད་པ་མི་རབས་མཆེད་དགུ་ནི་མུ་ཏིག་བསྟར་ལ་བརྒྱུས་པ་ལྟ་བུ་ཞིག་ཡིན་པར་འདུག་སྟེ།",
    "ཁྱུང་ནི་བོན་ལུགས་སུ་ཡ་ཐོག་སྲིད་པའི་ལྷ་རབས་ཀྱི་མཆེད་ཁུངས་ཤིན་ཏུ་གལ་ཆེན་པོ་ཞིག་ཏུའང་ངོས་འཛིན་སྲོལ་བྱུང་འདུག་དེའི་སྐོར་ཁ་གསལ་བ་ཞིག་ནི།",
    "དུར་གཤེན་བཞི་པོ་འདི་དག་ལ་གནའ་དུས་སུ་གྲགས་པའི་བོན་སྒོ་བཞི་རུ་ངོས་འཛིན་དགོས་པ་འདྲ་ཞིག་འདུག།",
    "རང་རང་ཡུལ་དུ་སྐད་རིགས་སོ་སོར་བསྒྱུར།",
    "སྨེ་བའི་ཐོག་མ་གཅིག་དཀར་ནས་འགོ་བརྩམས་པའི་ལུགས་དེ་བྱུང་བ་ཡིན་ཞེས་ཤོད་སྲོལ་ཡོད་འདུག་གང་ལྟར་ཡང་།",
    "བོན་གཤེན་ཆེན་པོ་འགའ་ཤས་ཀྱི་བྲིས་ཐང་རྙིང་མ་རྣམས་སུ་གསལ་པོར་མཇལ་དུ་ཡོད་འདུག་པ་དེ་ལ་ཟེར་བ་ཡིན།",
    "ཕྱོགས་མཚམས་བརྒྱད་དུ་སྤར་ཁ་བརྒྱད་བཀོད་དེ་ལོ་ཟླ་ཞག་དུས་དང་།",
    "སུ་ཞིག་སྐྱེ་དུས་ཀྱི་ལོ་ཟླ་ཞག་དུས་ཀྱི་འབྱུང་ཁམས་སོ་སོའི་གནས་ལུགས་དེ་ལ་བརྟེན་ནས་ཚེ་འདིར་ལེགས་ཉེས་ཀྱི་རྐྱེན་ཅི་དང་ཅི་ཞིག་ཡོད་པ་དང་།",
    "ལར་ཡང་གྲོས་དེ་འདྲ་ཞིག་བྱས་པ་གདའ་བས།",
    "ཁྱུང་པོ་བློ་གྲོས་རྒྱལ་མཚན་དུས་རབས་༡༤གྱིས་མཛད་པའི་རྒྱལ་རབས་བོན་གྱི་འབྱུང་གནས་སོགས་ཀྱི་དཔེ་རྣམས་སུ་མི་མཐུན་པ་འགའ་ཞིག་ཡོད་འདུག་ཅིང་།",
    "འོ་ན་ཕྱག་སོར་དང་ལྕེ་ངོ་མཚར་ཆེ་བ་གཅིག་འདུག་པ།",
    "ཤོད་ཚུལ་དེའང་ཕལ་ཆེར་གཉའ་ཁྲིའི་ཚིག་དོན་དང་མཐུན་གྱི་ཡོད་འདུག་གནའ་རབས་སུ།",
    "ལུགས་འདིའི་འབྲི་སྟངས་ཀྱང་མི་ཉུང་བ་ཞིག་ཡོད་འདུག་པ་དེ་ནི།",
    "ཞེས་ལུང་འདྲེན་དྲངས་གནང་འདུག་པ་དེ་རིགས་ཀྱིས་ངེས་ཤེས་རྙེད་ཐུབ་པ་ཡོད།",
    "ཞེས་སོགས་གསལ་རྒྱས་སུ་གསུངས་མཛད་འདུག་པ་དེ་ལའང་དཔྱད་གཞིག་ནན་ཏན་དུ་བྱེད་དགོས་པ་འདུག་སྤུ་དེ་གུང་རྒྱལ་ནི་བོད་ཀྱི་ཐོག་མའི་རྒྱལ་རབས་གནམ་གྱི་ཁྲི་བདུན་དང་བར་གྱི་ལྡིང་གཉིས་ཏེ།",
    "ཁྱེད་རང་ལག་པ་བདེ་པོ་དང་།",
    "ལྷ་བབ་ཡི་གེའི་ཚུགས་སུ་བྲིས་པའི་ཚིག་རྐང་པ་བཞི་ཡོད་འདུག་ངས་ཞིབ་ནན་གྱིས་བལྟས་ཏེ་བཀླགས་པས།"
  ]
}