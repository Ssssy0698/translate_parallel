    "འབྲོང་ཆུང་ཁྱེད་རང་རྒྱལ་བར་སྨོན།",
    "ཁ་ཤས་ཀྱིས་འོས་མིའི་སྐོར་གང་ཡང་ཤེས་ཀྱི་མེད་གསུང་མཁན་ཡང་འདུག་པས།",
    "གུས་པའི་བསམ་པར་སོ་སོས་རྒྱབ་སྐྱོར་བྱེད་སའི་འོས་མིའི་སྐོར་ངེས་པར་དུ་ཤེས་དགོས་ཀྱི་འདུག་བསམ་གྱི་ཡོད།",
    "ཐུགས་སེམས་བཟང་པོ་ཞིག་ཡིན་པ་བརྗོད་བཞིན་འདུག་འདི་དག་ནི་བོད་མིའི་དབུ་ཁྲིད་ཚད་ལྡན་ཞིག་ལ་དགོས་གལ་ཆེ་བ་ཞིག་ཡིན།",
    "གལ་སྲིད་ཁོང་རང་དངོས་གཞིའི་འོས་མིའི་ཁོངས་སུ་ཚུད་ན།",
    "ག་དུས་ཡིན་ཡང་དཀྱེལ་ཡངས་བཟོད་སྒོམ་ཅན།",
    "ཟ་འཐུང་འགྲོ་འདུག་འཚོ་བའི་མཁོ་ཆས་སོགས།",
    "མ་འོངས་པའི་ཆར་ཡིན་ནའང་མ་འོངས་པའི་སྲིད་བྱུས་བསྒྲགས་གཏམ་དེ་ཚོ་ཡོངས་གྲགས་གནང་དང་གནང་བཞིན་པའི་དུས་ཚོད་ཅིག་ཆགས་ཀྱི་འདུག་ཡིན་ནའང་།",
    "འདི་ཞུ་ཐུབ་ཀྱི་མི་འདུག་ཅེས་ཞུ་རྒྱུ་ནི་རྩ་བ་ཉིད་ནས་མ་འགྲིག་པ་འདྲ་པོ་དང་ཞུ་མི་ཤེས་པ་འདྲ་པོ་ཡིན་སྟབས།",
    "དེ་ཚོའི་ཐོག་ལ་ག་དུས་ཡིན་ནའང་ཕྱི་འབྲེལ་ཐོག་ལ་རྒྱུས་ཡོད་པ་གཅིག་དང་།",
    "ལོ་གཞོན་པ་ཡོང་མཁན་ནང་ལ་ངས་དོ་སྣང་བྱེད་སྐབས་ཧ་ལས་པའི་ཡག་པོ་འདུག་གཅིག་ནས་སོ་སོའི་མི་རིགས་ཀྱི་ལྟ་བ་ཤུགས་ཆེན་པོ་ཡོད་པ་དང་།",
    "དེ་འདྲ་ཡིན་དུས་བོད་མིའི་སྒྲིག་འཛུགས་ལ་ཚུར་ནུས་པ་སྤུངས་ནས་མཉམ་ཞུགས་བྱེད་རྒྱུ་དེ་ད་ལྟ་ཡག་པོ་ཞེ་དྲག་འདུག་བསམ་གྱི་འདུག་བོད་མིའི་སྒྲིག་འཛུགས་ཀྱི་ངོས་ནས་གཞོན་སྐྱེས་ཚོར་མཐུན་རྐྱེན་མང་པོ་ཞིག་བསྐྲུན་རྒྱུ་ཡོང་མིན་གང་ལྟར་ཀྱང་།",
    "ལྡི་ལི་སྐུ་ཚབ་དོན་གཅོད་བཀའ་ཟུར་འབྲོང་ཆུང་དངོས་གྲུབ་མཆོག་ད་ལན་སྲིད་སྐྱོང་འོས་གཞིའི་ནང་ལ་ལང་མཁན་འོས་གཞི་ཚང་མ་དཔེ་ཡག་པོ་འདུག་དྲན་གྱི་འདུག་ཉམས་མྱོང་ཡོད་པ།",
    "རྒྱབ་སྐྱོར་བྱེད་རྒྱུར་ཁག་པོ་འདུག་ཅེས་གསུང་མཁན་ཡོད་པ་འདྲ།",
    "གལ་སྲིད་ཁྱེད་རང་སྲིད་སྐྱོང་ལ་བདམས་པ་ཡིན་ན།",
    "ཡིན་ནའང་རྒྱ་ནག་གཞུང་ནས་རང་བཙན་རྩོད་ཀྱི་འདུག་ཅེས་ཡ་ལན་བྱེད་ཀྱི་མེད།",
    "ཁྱེད་རང་སྲིད་སྐྱོང་ལ་ཐོབ་པ་ཡིན་ན།",
    "གལ་སྲིད་ཁྱེད་རང་སྲིད་སྐྱོང་ཆགས་པ་ཡིན་ན།",
    "བཀའ་ལན་ཁག་དུས་ཐོག་ཏུ་གནང་མཁན་གྱི་དབུ་ཁྲིད་ཅིག་ཡིན་པ་ཤེས་རྟོགས་བྱུང་།",
