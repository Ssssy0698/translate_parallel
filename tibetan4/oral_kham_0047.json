    "ད་ལྟ་བ་ལ་བཟོ་བཅོས་མེད་པ་སྟོང་པ་ཞིག་འདུག་ཅེས་ཞུ་ཤེས་ནས་ད་དེ་ལྟར་རྒྱུན་བསྐྱང་རྒྱུ་ཡིན་པར་བྱེད།",
    "དེ་ནམ་བྱུང་མ་ཚོར་བ་མུག་གེ་འདུག་ན་རྨུགས་པ་སོགས་ཡིན་རྒྱ་བྱེད།",
    "གང་བྲིས་ཐམས་ཅད་དཀའ་སླ་མཉམ་འདུག་སྐད།",
    "དེང་དུས་ཡོངས་གྲགས་སུ་རྒྱ་གར་གྱི་སྐད་དུ་འདོད་པ་ཡོད་འདུག་ཀྱང་།",
    "རྟགས་ལ་ཡང་རང་དོན་སྐབས་ཀྱི་རྟགས་དང་།",
    "བར་དུ་འདུག་ས་ཐ་དད་མེད།",
    "གོང་དུ་ཕྱོགས་སྔའི་འདོད་པ་དུ་མ་ཞིག་བཀོད་དེ་དགག་པ་བྱས་པ་འདུག་ན།",
    "དེ་ཡི་གནས་སྐབས་ཀྱི་ལུས་སེམས་གཉིས་ཀར་འགྱུར་བ་འདུག་པ་མངོན་དུ་གསལ་བའི་ཕྱིར་རོ།",
    "དེ་ཡང་རང་བཞིན་རྟག་ལ་གནས་སྐབས་འགྱུར་བ་ཡང་ཡོད་དེ།",
    "དེ་དག་དུས་གསུམ་ལ་སྦྱར་བས།",
    "གཉིད་ལོག་དུས་ན་བག་ཆགས་དེ་གསལ་བཞིན།",
    "སོ་སོ་རང་རང་སྒྲ་སྐད་ཇི་བཞིན་དུ།",
    "རྨི་ལམ་བག་ཆགས་རྒྱུན་གཡེང་རང་བཞིན་ཅན།",
    "ཚུལ་དང་རང་བཞིན་འདི་འདྲ་ལ་བརྟེན་ནས་སྒྱུ་མའི་རང་བཞིན་ནམ་ཡིན་ལུགས་རྟོགས་སོ།",
    "དེ་ལྟར་ཚོར་ཕུང་རང་གྲོལ་གྱི་རང་བཞིན་རྟོགས་ཤིང་།",
    "དེ་ཡང་རང་ཡུལ་དང་འཛིན་སྟངས་རྒྱ་ཆེ་ཆུང་དཔག་མེད་སོགས་ལ་ལྟོས་ཏེ་འདུ་ཤེས་ཀྱི་ཕུང་པོ་ཡང་།",
    "འདས་པའི་རང་འབྱུང་རང་གྲོལ་གྱི་ངོ་བོའམ་གནས་ལུགས་དེ་རྟོགས་ཤིང་དེ་ཡི་ངང་ལས་གཡོ་མེད་དུ་གནས་པ་དེ།",
    "རྐྱེན་རྣམས་ཀྱང་རང་འབྲས་ཀྱི་རྒྱུའོ།",
    "འགྲེལ་ལས་གསུངས་པའི་ཐེག་དམན་གྱི་དོན་ཡང་རང་གཞུང་དང་མཐུན་པའི་མཚན་གཞི་ཡང་ཤེས་པ་གལ་ཆེའོ།",
    "སྤང་བྱ་ནི་སྤྱིར་ན་རང་རང་དང་མི་མཐུན་པའི་ཕྱོགས་དང་།",
    "སྙམ་ན་སེམས་ཉིད་དང་རང་བཞིན་གཅིག་པའི་སྒྲིབ་པ་སོགས་སྤང་བར་འདོད་ན།",
    "སེམས་ཉིད་དང་རང་ངོས་ནས་གཅིག་པའི་སྒྲིབ་པ་གཉེན་པོས་སྤོང་བར་འདོད་ན།",
    "སྐྱེ་བོ་ཕལ་པ་ལུང་མ་བསྟན་པར་འདུག་པ་དང་མཚུངས་སོ་ཞེ་ན།",
    "སྣོད་བཅུད་ལྷ་རུ་སྣང་བས་འཁྲུལ་སྣང་རང་བཞིན་མེད།",
    "༧ དུག་སྦྲུལ་ནག་པོ་སྟེ་ཞེ་སྡང་རང་གྲོལ་དུ་བཏང་ན་སྡང་སེམས་ཀྱི་མེ་ལྟ་བུས་གཞན་ལ་འཚེ་བ་མི་བྱེད་ཅེས་སོ།",
    "འགྲོ་བ་གཞན་ཡང་ཡི་དྭགས་མང་པོར་འདུག་པ་དང་།",
    "རྨི་ཉམས་སུ་ཡང་རང་འཕུར་བ་ལ་སོགས་པ་འབྱུང་།",
    "སེར་སྣ་མེད་དང་རང་བཞིན་བཟང་།",
    "ཙ་ན་ཀ་ཡི་རུས་རྣམས་གཟུགས།",
    "ཤྭ་པ་ཙ་ན་མདའ་རུ་བཤད།",
    "ཅ་༡ ཡུལ་གསུམ་པོ་འདི་ལའང་རང་ལུགས་བཞག་པ་ཅ་༢ གཞན་ལུགས་དགག་པ།",
    "གཅིག་མ་རྙེད་ཙ་ན་དེ་བསགས་ཀྱི་དུ་མ་ཡང་མེད་དེ།",
    "མེ་ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་དད་པ་དུ་མ་ལ་དོན་སྤྱི་གཅིག་ཤར་བས་རྗེས་འགྲོས་སྟོང་པ་དང་ཡང་མི་མཐུན་ནོ།",
    "དངོས་པོ་ལ་ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་དད་པ་ལ་བློས་མེ་ཙམ་དུ་ཞེན་ནས་མེ་མེད་ཀྱི་སྒྲོ་འདོགས་གཅིག་སེལ་བས་རྗེས་འགྲོས་སྟོང་པ་དང་ཡང་མི་མཐུན་ནོ།",
    "འབྲས་རྟགས་དང་རང་བཞིན་གྱི་རྟགས་དང་མི་དམིགས་པའི་རྟགས་ལ་རྟེན་པའི་རྗེས་དཔག་ཐམས་ཅད་ཀྱིས་ཀྱང་རིམ་པ་བཞིན་དུ་བ་ལ་མེ་ལྡན་གྱི་ཚོགས་དོན་དང་།",
    "རྗེས་འགྲོས་སྟོང་པ་དང་ཡང་མཐུན་ཏེ་ཡུལ་ཐ་དད་དུ་སྣང་བ་དང་རང་བཞིན་ཐ་དད་དུ་སྣང་བ་དང་འདས་པ་འགག་ནས་མེད་པ་དང་མ་འོངས་པ་མ་སྐྱེས་ནས་མེད་པའི་ཕྱིར་དུས་ཐ་དད་དུའང་སྣང་བས་སོ།",
    "འགལ་མི་འགལ་བརྟག་པ་ནི་དོན་རིག་གསུམ་དང་རང་རིག་གསུམ་སྟེ་དྲུག་དང་།",
    "དངོས་པོའམ་ཤེས་བྱ་ལ་ལྟོས་ནས་བཅད་པའི་ཡུལ་ཅན་དང་རང་རིག་གསུམ་སྟེ་དྲུག་དང་མི་འགལ་ལ་གཞན་དྲུག་དང་འགལ་ལོ།",
    "ཐེ་ཚོམ་ནི་དེ་ཉིད་དང་རྟོག་བཅས་ལོག་ཤེས་དང་རང་རིག་གསུམ་སྟེ་ལྔ་དང་མི་འགལ་ལ་བདུན་དང་འགལ་ལོ།",
    "ཡིད་དཔྱོད་དང་རྟོག་པ་བཅད་པའི་ཡུལ་ཅན་དང་རང་རིག་གསུམ་སྟེ་བརྒྱད་དང་མི་འགལ་ལ་བཞི་དང་འགལ་ལོ།",
    "དེ་ལྟ་ན་སྐྱོན་ཅན་ཁོ་རང་ལ་མཚན་ཉིད་དབྱེར་མེད་ཀྱི་ལྡོག་པ་ཐ་དད་དུ་མི་གནས་པས་ཁྱབ་བམ་མ་ཁྱབ་ཞེས་བརྗོད་དོ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "དེ་ལྟ་མ་ཡིན་ན་ཁྱེད་རང་ལ་ཡང་མྱོང་བྱ་མྱོང་བྱེད་གཉིས་ཡོད་དམ་མེད་ཅེས་དྲི་བར་བྱའོ།",
    "ཡང་རང་རིག་མངོན་སུམ་གྱིས་གྲུབ་བོ།",
    "གཅིག་དང་དུ་མ་བཀག་པ་གཅིག་དང་དུ་བྲལ་གྱི་རྟགས་སུ་འདུག་སྟེ་དོན་དམ་པའི་དངོས་པོ་བཀག་པ་དོན་དམ་པའི་དངོས་པོས་སྟོང་པ་ཡིན་ཞིང་།",
    "འདིར་ཡང་རིམ་དང་ཅིག་ཅར་གྱིས་དོན་བྱེད་པ་བཀག་པ་རིམ་དང་ཅིག་ཅར་གྱིས་དོན་བྱེད་པས་སྟོང་པའི་རྟགས་སུ་འདུག་སྟེ།",
    "དང་པོ་ལྟར་ནའང་ལས་སུ་བྱ་བར་འདོད་པའམ་ལས་སུ་བྱ་བར་འདུག་པ་ལ་ཟེར།",
    "བདག་གཅིག་པའི་འབྲེལ་བ་མེད་ཀྱང་རང་བཞིན་གྱི་རྟགས་སུ་རློམ་པས་རང་བཞིན་གྱི་རྟགས་ཡིན་ནོ།",
    "མེད་དགག་བསྒྲུབ་པ་ལ་ཚུལ་གསུམ་ཚང་ཡང་རང་བཞིན་གྱི་རྟགས་ཡིན་ནོ་ཞེ་ན།",
    "ཁྱབ་བྱེད་མ་དམིགས་པའི་བསྒྲུབ་བྱ་ཡོད་པས་སྟོང་པ་དང་རང་བཞིན་གྱི་རྟགས་ཡོད་པ་གཉིས་ཀྱང་གཞི་གཅིག་ལ་བསྡུས་པས་དོན་ཕན་ཚུན་སྤངས་འགལ་གཞི་རྟག་པའི་ཤ་བུམ་གཅིག་ལ་བསྡུས་པར་འགྱུར་རོ།",
    "དེ་ལ་དེ་ལྟར་སའི་མཚན་ཉིད་རིག་པའི་སྔགས་པས་ལུས་བཀྲུ་ཞིང་དྲི་ཞིམ་པས་ཇི་ལྟར་རྙེད་པས་གོས་དང་རྒྱན་དང་ཅོད་པན་དང་བདེ་བའི་སྟན་མཐོན་པོ་ལ་འདུག་སྟེ།",
    "དེ་ནས་ལེགས་པར་བརྟགས་ཤིང་ཤིན་ཏུ་མཉམ་པའི་སའི་ཆར་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ནས་རས་རིས་ལ་སོགས་པ་བརྩམ་པར་འདོད་པའི་སྔགས་པས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ནས་སྔགས་པས་ཡོངས་སུ་བརྟགས་ཤིང་ཤིན་ཏུ་འཇམ་པའི་ས་ཕྱོགས་སུ་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དུས་སྦྱོར་བཟང་པོ་འཛོམ་པའི་ཉིན་ཞག་བཟང་པོ་ལ་ཁྲུས་དང་གཙང་སྦྲ་བྱས་ཏེ་གོས་དང་རྒྱན་བཟང་པོ་དབུ་རྒྱན་མེ་ཏོག་དང་བཅས་པས་གྲོགས་བཟང་པོ་དང་ལག་པ་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པས་སྟན་ཐོག་མཐོན་པོ་འཇམ་པ་ལ་འདུག་སྟེ།",
    "ཞེས་བྱ་བས་བྱིན་གྱིས་བརླབས་པ་སྟེགས་བུའི་སྟེང་དུ་འདུག་སྟན་གཙང་མ་ལ་བཞག་ནས་དྲི་མ་སེལ་བ་རྣམས་ཀྱིས་དྲི་མ་བསལ་བར་བྱའོ།",
    "དེ་ནས་གོ་རོ་ཙ་ནའི་ཐིག་ལེ་བྱས་ཏེ་མེ་ཏོག་དང་བདུག་སྤོས་དང་།",
    "འདུག་ནས་གཏོར་མ་ཡང་དག་སྦྱིན།",
    "གོས་སོགས་རང་རང་སྔགས་ཀྱིས་ནི།",
    "དགང་གཟར་སྦྱིན་སྲེག་ཤིང་རང་བཞིན།",
    "རང་རང་ཕྱོགས་སུ་ལེགས་པར་བཞུགས་ནས་ཀྱང་།",
    "ཤྲཱི་སརྦ་དུརྒ་ཏི་པ་རི་ཤོ་དྷ་ན་ཏནྟྲཱ་ཏ་ཨུད་ཌྷིཏྱ་ལོ་ཙ་ནཱ་ཡཱ་དུརྒ་ཏི་ཤོ་དྷ་ན་བི་དྷི།",
    "འཇམ་ཞིང་མཐོ་བའི་སྟན་འདུག་ལ།",
    "དེ་རྗེས་འདུག་པ་ལངས་ནས་ནི།",
    "རྒྱ་ཆེན་མཐོན་པོ་བདེ་བའི་སྟན་ལ་འདུག།",
    "དེ་རྗེས་ལངས་ནས་འདུག་པ་བལྟ་བར་བྱ།",
    "གཞན་གྱི་ཆེད་དུ་གླེང་བ་ནི་སྤྱན་སྔར་འདུག་ནས་བརྗོད་པ།",
    "ད་ནི་གཞན་སྤྲོ་བའི་ཕྱིར་ཙ་ནའི་འབྲུ་ཙམ་ནི་སྲན་ཙ་ན་ཀའོ།",
    "རང་རང་གཙོ་བོར་གྱུར་པའི་གནས་སུ་བསྒོམས་ན།",
    "གཞི་དང་ཐབས་དང་རང་བཞིན་གསུམ།",
    "ཨོཾ་རུ་རུ་ཞེས་པ་ལ་སོགས་པ་ལོ་ཙ་ན་ལ་སོགས་པ་རིམ་པའི་སྔགས་གསུངས་པ་རྗེས་སུ་དྲན་ཞེས་ཏེ།",
    "དེའི་ཡང་དབུས་ན་དུག་འདུག་པར་བསམས་ཏེ།",
    "སྤྲེའུའམ་ཉ་ཁྱི་བ་དང་ཁྱི་གུ་ལ་སོགས་པ་བྱུང་ནས་འདུག་པ་དེ་བརླག་པར་བྱའོ།",
    "དེས་གང་དགུག་པ་རྒྱན་རྣམས་རྫོགས་ཤིང་སེར་ལ་འགྱིང་བག་ཏུ་འདུག་པ་རལ་པའི་དབུ་རྒྱན་ཅན་དགུག་པའི་ཆོ་གས་སོ།",
    "འདུག་གོ་ཞེས་པའི་བར་རྣམས་ནི་ཡོངས་སུ་གཏང་བ་སྟེ།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནས་བསྒྱུར་ཅིང་གཏན་ལ་ཕབ་པ།",
    "དེ་ལ་སེམས་ནི་དངོས་པོ་ཐམས་ཅད་དང་རང་བཞིན་གྱིས་བྲལ་བར་ཡང་མཁྱེན་ལ།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་རིམ་གྱིས་བསྟན་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་ཕྲག་དོག་ཀྱང་རང་བཞིན་མེད་དོ།",
    "འཇམ་པའི་སྟན་ལ་འདུག་ནས་ནི།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་ལ་འདུག་ནས།",
    "རང་རང་དག་ནས་གནས་ཕྱིར་རོ།",
    "རང་རང་ལྷ་དག་རང་བཞིན་སྐྱེ།",
    "རྟ་ཤ་ནི་རཏྣ་ལོ་ཙ་ན་དང་རིན་ཆེན་འབྱུང་ལྡན་གྱི་ཚུལ་དུ་སྤྱད།",
    "ཡང་ན་ཡན་ལག་མི་གཉིས་ཞེས་བ་ནི་གཟུངས་མ་དང་གཉིས་སུ་མེད་པའི་ཚུལ་དུ་འདུག་ནས་བཟླ་བའི་དོན་ཏོ།",
    "འདུག་ནས་ཞེས་པ་ནི་སྟན་དེ་གསུམ་གྱི་སྟེང་དུ་བདག་གོང་དུ་བསྟན་པའི་ཚུལ་དུ་འདུག་པའོ།",
    "དང་བ་ནི་ཤེལ་ལྟ་བུར་འདུག་ཅིང་འོད་གསལ་བའོ།",
    "དབུས་སུ་གནས་པ་ནི་རྣལ་འབྱོར་པ་དེའི་དཀྱིལ་དུ་འདུག་པའོ།",
    "ཡང་ན་གསང་བ་ནི་ལོ་ཙ་ན་ལ་སོགས་པ་ཡུམ་གྱི་རང་བཞིན་དུ་གནས་པ་རྣམས་སོ།",
    "སེམས་དཔའི་སྐྱིལ་ཀྲུང་ནི་འདུག་སྟངས་སོ།",
    "ཞེས་པ་ནི་དབུ་སྐྲ་རལ་པར་འདུག་ཉིད་ཅོད་པན་དུ་བྱས་པ་འམ།",
    "ཞེས་པ་ལ་དེ་ལ་ཕྱག་གཡས་ཀྱི་དང་པོ་ཡེ་ཤེས་ལྔའི་རང་བཞིན་རྡོ་རྗེ་རྩེ་ལྔ་པ་ཁ་དོག་ཨིནྡྲ་ནཱི་ལ་ལྟར་འདུག་པ་ཕྱག་ཏུ་བསྒོམ་ཞེས་པ་དང་འབྲེལ་ཏོ།",
    "ཟླ་བ་རྩིབས་བརྒྱད་ལྟ་བུས་ནི་དབྱིབས་དང་ཁ་དོག་བསྟན་ཏེ་འཁོར་ལོ་དེ་རྩིབས་བརྒྱད་ལྡན་ཞིང་ཟླ་བ་བཞིན་དུ་དཀར་ལ་ཟླུམ་པོར་འདུག་པའོ།",
    "ཨུཏྤལ་སྔོན་པོའི་ལོ་མ་བཞིན་དུ་ཞེས་པ་ནི་ཕྱག་ཐ་མ་ན་རལ་གྲིའི་ཁ་དོག་ཨུཏྤལའི་འདབ་མ་བཞིན་དུ་འདུག་པ་རྣམས་ལའོ།",
    "ཞེས་པ་ནི་སྒྲུབ་པ་པོ་བདག་ཀྱང་དེ་དང་ལྷན་ཅིག་དཀྱིལ་འཁོར་གྱི་དཀྱིལ་དུ་འདུག་ལ་བདག་ཉིད་དད་པའི་ལྷ་གང་ཡང་རུང་བ་ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་བསྒོམ་ཞེས་པའི་དོན་ཏོ།",
    "ཅེས་པ་ནི་སྒྲུབ་པ་ཆེན་པོ་བྱེད་པའི་འདུག་ཐབས་བསྟན་ཏེ།",
    "ཞེས་པ་ནི་དེ་ལྟར་འདུག་ནས་ཐབས་དང་ཤེས་རབ་ཀྱི་ཕྱག་རྒྱ་གཉིས་གོང་དུ་བསྟན་པའི་ཏིང་ངེ་འཛིན་གསལ་བར་དམིགས་ལ་སྦྱོར་ཞེས་པའོ།",
    "འོད་ཟེར་སྣ་ཚོགས་པས་བརྒྱན་ཞེས་པ་ནི་སྐུ་ལས་དཀར་པོ་ལ་སོགས་པའི་འོད་ཟེར་སྣ་ཚོགས་དཀྲིགས་ཤིང་བསྐོར་བའི་ཚུལ་དུ་འདུག་པའོ།",
    "འབར་བའི་དབུ་ནི་གྱེན་དུ་བཅིངས་པ་ནི་དབུ་སྐྲ་སེར་སྐྱར་འདུག་པ་འབར་ཞིང་གྱེན་དུ་འཁྱིལ་པས་ཐོར་ཅོག་དུ་འདུག་པའོ།",
    "ཞབས་གཡས་བརྐྱང་བར་གནས་པ་ནི་འདུག་སྟངས་ཡིན་ཏེ།",
    "གཡས་བརྐྱང་འགྱིང་བའི་ཚུལ་དུ་གནས་པ་ནི་འདུག་སྟངས་སོ།",
    "ཅེས་པ་ནི་ཤིན་ཏུ་འཇིགས་པར་བྱེད་པའི་ཁྲོ་བོའི་ཆ་ལུགས་ཞལ་གསུམ་ཁྲོ་གཉེར་རིམ་པ་མང་བ་ལྗགས་ཀློག་བཞིན་བསྐྱོད་ཅིང་ཤིན་ཏུ་རྣོ་བའི་མཆེ་བ་གཙིགས་པར་འདུག་པ།",
    "ཞེས་པས་ནི་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་འདུག་པ་བསྟན་ཏེ།",
    "ལོ་ཙ་ན་དང་།",
    "སེམས་ཚིག་བརྗོད་པ་ལྟ་ཞེས་པ་ནི་སེམས་ཙམ་དེ་ཡང་རང་བཞིན་མེད་དོ་ཞེས་པ་སྟེ།",
    "ནམ་མཁའ་ལྟ་བུར་སྦྱར་ནས་ཤེས་པ་སྐྱེད་ཅིག་ཅེས་བཀའ་སྩལ་བ་དེ་རང་རང་དང་རྡོ་རྗེ་འཆང་བ་གཉིས་སུ་མེད་པར་སྦྱར་བས་བཀའ་མཉན་ཏེ་ཞེས་པའི་དོན་ཏོ།",
    "ཞེས་པ་ཡང་རང་བཞིན་མེད་པ་སྟེ་དེ་ལས་བྱུང་བའི་དོན་ཏོ།",
    "ཡང་ན་གཟུང་བ་ལ་སོགས་པའི་རིམ་པས་སའི་དབུས་ན་འདུག་པའི་སློབ་དཔོན་ལ་གྲགས་པོས་གསོལ་བ་བཏབ་པའི་དེ་མ་ཐག་ཏུ་ཐིག་ལ་སོགས་པའི་ལས་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "ཙ་ན་ཀ་ཞེས་པ་ནི་སྣང་བ་མཐའ་ཡས་ཀྱི་ཡིན་ནོ།",
    "ཀུན་དུ་སྤྱོད་པའི་ངོ་བོ་གང་ཡུལ་རྣམས་འདོད་པའི་ངོ་བོ་ལྟར་རང་རང་གནས་པས་ཕྱི་རོལ་གྱི་ངོ་བོ་སྤོང་བ་སྟེ།",
    "འབྲུ་ཙ་ན་ཀའི་ཐིག་ལེའི་འབྲས་བུ་ཞེས་སོ།",
    "ཞེས་པ་ནི་ཡིག་འབྲུ་དེ་དག་ཙ་ན་ཀའི་ཚད་ཀྱི་ཐིག་ལེའི་དབུས་སུ་གནས་པའོ།",
    "ཡིག་འབྲུའི་ཚད་ཙ་ན་ཀའི་ཚད་ཙམ་ཐིག་ལེའི་དབུས་སུ་གནས་པ་ལས།",
    "རྒྱུན་ཕྱོགས་འཇུག་ཅིང་རང་བཞིན་རྟག།",
    "ལྷུང་བཟེད་སྟོང་པར་སླར་གཤེགས་པ་ལ་སོགས་པ་ལས་ཀྱི་སྒྲིབ་པ་དག་གདའ་ན།",
    "རང་རང་གནས་སམ་གཞན་དུ་ད་དེངས་ཤིག་གལ་ཏེ་མི་འགྲོ་འདི་རུ་འཚེ་བྱེད་ན།",
    "སྲུང་དུས་ནང་བལྟ་ཟློག་དུས་ཕྱིར།",
    "རང་རང་གཟུགས་ལ་བསྟིམས་པས་གཉིས་མེད་གྱུར།",
    "རང་རང་རིགས་མཐུན་བརྗིད་རྔམ་རོལ་པ་ལས།",
    "གོས་རྒྱན་རང་རང་ཆས་བརྗིད་འདོད་དགུར་བཅས།",
    "གོ་རོ་ཙ་ན་ལ་ཁཱ་ཧི།",
    "ལྷ་རིས་བས་ཐང་ཁའི་རས་གཞི་བརྒྱངས་པ་ཞིག་བཟུང་འདུག་པར།",
    "ཞལ་ཐང་བཞུགས་པའི་སྒམ་བུ་ལ་ཟླ་བའི་འོད་ཀྱིས་ཁྱབ་འདུག་པ་མངོན་སུམ་མཐོང་ནས་ལངས་ཏེ་རབ་རྒྱས་ལ་ནམ་ལངས་འདུག་པས་འགྲོ་རན་བྱས་པས།",
    "སླར་ང་ལ་ཇི་ལྟར་གསུངས་པ་དེ་ལྟར་བྱས་པས་རྟགས་ཀྱང་དེ་ལྟ་བུ་བྱུང་བས་མཁྱེན་པ་དངོས་སུ་གདའ་ཞེས་ཟེར་གྱིན་མཆིས།",
    "ཁྱེད་ཀྱིས་མཛད་པའི་ཚེམ་བུ་ལུགས་ཀྱི་ཐུགས་རྗེ་ཆེན་པོའི་སྒྲུབ་ཐབས་ཉུང་ངུ་དོན་ཚང་ཞེས་བྱ་བ་དེ་ང་ལ་བསྟན་བྱུང་བ་དང་དེའི་ལུང་ཡང་ཞུས་པ་ཡིན་པས་ཁྱེད་ཉིད་མཁན་ཆེན་ཞི་བ་འཚོས་རྣམ་འཕྲུལ་ཞིག་ཡིན་ངེས་འདུག་པས།",
    "ང་རང་མཇལ་དུ་འོང་བ་ཡིན་ཞེས་གསུང་ཞིང་ཉམས་བཞེས་ཀྱི་རྟོགས་འབུལ་ཞིག་ཀྱང་མཛད་བྱུང་།",
    "དྲག་ཏུ་མི་འདུག་པས་ཁོང་རང་ནས་འཚོ་ཐུབ་མིན་བྱུང་ན་རྗེ་ཤུལ་གྱི་བྱ་བ་འདི་ལྟར་དགོས་ཚུལ་ཟེར་བ།",
    "ཁྱད་པར་རྩིས་སྐོར་ལ་བརྒྱུད་ཐག་ཉེ་བ་ཁུངས་བཙུན་པ་དཔྱོད་ལྡན་མགུ་བ་བསྐྱེད་པའི་མཁས་པ་ཞིག་འདུག་པ་ལས།",
    "གཏོར་མ་ལ་སྤུ་ནག་སྐྱེ་བ་ཅུང་ཟད་སྐྱོན་དུ་འཛིན་མཁན་ཀྱང་ཡོད་འདུག་ཀྱང་།",
    "སྐུ་ཚབ་གཟུངས་སྲུང་ལ་རིགས་སྲས་ཁྱད་འཕགས་ཞིག་སྦྲུམ་འདུག་པར་ངེས་ཀྱང་འགྱུར་ལྟས་ཡིན་ནམ་ཅི་ཡིན་མ་ངེས་པས་རིམ་གྲོ་དགོས་ཚུལ་སོགས་ས་སྐྱོང་ཆེན་པོར་གཏིང་བསྐུལ་ཞུ་བཅུག་པས།",
    "བདག་ལ་བཀའ་ལུང་ཕེབས་ནང་འདི་ལོར་མི་དྭོགས་ཀྱང་སླར་དོན་བརྒྱད་སྟེང་འཚུབས་ཚུལ་དང་རིམ་གྲོ་ཉུང་ཤས་འདུག་པས་ཁོ་བོའི་རྐང་འབམ་ཟླ་ནང་ཅུང་འཕར་བས།",
    "དེ་བས་ཁྱེད་རང་ཅི་སྔ་ཡིད་ལྷུང་ལ་འབྱོན་ཚུར་ལམ་ཁྲོ་སོགས་ནས་འདིར་མི་བཏང་གྱིས་དང་ཆབ་ཚན་ལ་བཏེག་འགབ་མིན་གསལ་འོང་ཚུལ་བཀོད་པ་བགྱིས།",
    "དབུགས་ཁ་རྒོད་པ་སོགས་ཡང་འདུག་པ།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་ཕན་བསྐྱེད་མེད་པའི་ཁམས་ཇི་ལྗི་ལས་མི་འདུག་པས།",
    "རང་རྩར་ཐུག་དུས་རོགས་ཅེས་པའི་དཔེ་ལྟར་གང་གཟན་དགོས་པ་མེད་ཚུལ་དང་།",
    "ཁོང་རང་ནས་ཀྱང་ལམ་འབྲས་དུས་ཐང་བྲི་རྒྱུའི་ཁས་ལེན་བྱེད་འདུག་བྲིས་པ་བུ་ཆུང་ལའང་སྟེར་ཆ་ཕྲན་བུ་ཞིག་དགོས་ཚུལ་སྨྲས།",
    "རང་རང་གནས་དང་སྣ་ལས་འབྱུང་།",
    "གཞན་ཐོ་ཡིག་སོགས་མི་འདུག་པས་རགས་རིམ་དེ་ཙམ་ལས་ཞིབ་བཀོད་རྔོ་མ་ཐོག་ཅིང་།",
    "ཁོང་རང་ལ་དར་ཁ་ཞིག་གནང་བའི་མནལ་ལྟས་བྱུང་འདུག་པ་ཡང་དཔོན་སློབ་དམ་ཚིག་སེལ་མེད་ཀྱིས་དག་པ་ཡེ་ཤེས་ཀྱི་སྐུས་སྐུ་ཞབས་ཀྱི་བར་གཅོད་སོགས་སེལ་བའི་རྟགས་སུ་ངེས་ཤིང་།",
    "ཉེ་གནས་ལྷུན་གྲུབ་ཕུན་ཚོགས་ལ་ཡང་སྔ་ཕྱིར་ཡང་སྲིད་ཀྱི་བརྡ་རྟགས་རྨི་ལམ་ཁ་ཤས་བྱུང་འདུག་པ།",
    "འཕེལ་བ་དག་དུསུ་ལས་དེ་ལྟར་སྔར་བརྗོད་པའི་ཆོ་གས་སྐྱེད་བ་སྟེ།",
    "དེའི་དབུས་སུ་རང་རང་བསམ་པས་མི་བདགུའི་བར་བད་བ་སྟེ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "༨༨སློབ་ད་པོན་བོེ་རོ་ཙ་ན་རཀྱི་ཏས་མཛད།",
    "ཉམ་ཐག་དུས་སུ་རྣམ་པར་ཉམས་པ་ཤེས་ནས་ནི།",
    "རང་གནས་ལངས་དང་འདུག་པ་འམ།",
    "དཀར་ལ་དཀར་མིན་འགྲོས་ཀྱི་འོད་ཟེར་ལུང་༡ལྡན་པ།",
    "དེ་ཡི་ཕྱིར་ཡང་རང་བཞིན་ལ་ནི་ཉེས་པ་དེ།",
    "རྣམ་པར་༢འདུག་པའི་སེང་གེའི་སྒྲ་རྣམས་ནི།",
    "དཀར་མིན་འགྲོས་ལས་ངུ་བ་བཞིན།",
    "ངེས་པར་ལྡོག་པ་བཟའ་བའི་ཆོ་ག་དུས་ཡིན་ན་ནོ།",
    "རབ་མཐོ་བྲག་རིའི་རྩེ་ཡི་ཡུལ་ངོས་རབ་ཞི་བདེ་བའི་ལོངས་སྤྱོད་འདུག་འདུག་པས།",
    "རྟག་ཏུ་མང་པོའི་རྣམ་པས་༡༨རྣམ་པར་གནོད་བྱེད་ཡལ་ག་རི་དྭགས་འདུག་༡༩པ་འཁྲུགས་པས་ནི།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།"
