    "གངས་ཅན་དུ་བསྟན་པ་སྔ་འགྱུར་སྐབས་ལོ་ཙཱ་བེ་རོ་ཙ་ན།",
    "འདི་སྐབས་ཀྱི་ཁ་འཛིན་བྱེད་པའི་ལྷ་སྲུང་ཡང་རང་ཡུལ་བྱ་ཡུལ་གྱི་ཡུལ་ལྷ་བོན་གྱི་རིགས་དཀར་ཕྱོགས་པ་མཐུ་ནུས་ཅན་དེ་ཡིན་ཞིང་།",
    "རང་ཅག་སྔགས་གསར་མ་བ་རྣམས་ཀྱང་གནས་ལུགས་བདེན་སྟོང་ལ་ངེས་པ་དྲངས་ནས་གསང་ཆེན་མངོན་རྟོགས་དང་སྦྲེལ་སྒོམ་བྱེད་པ་ཡིན་ཀྱང་ཚེ་གཅིག་ལ་ཡོན་ཏན་དེ་འདྲ་སྐྱེ་བ་ད་ལྟ་དཀོན་ཙམ་དུ་འདུག་ཚུལ་དང་།",
    "རང་རང་ལ་འཚམས་པའི་སེམས་ཁྲིད་སོགས་ལེགས་གནང་མཛད།",
    "གདུང་ལོ་གྱ་གཅིག་མེ་ཡོས་ལོར་སྦྱོར་དྲུག་པ་གསར་འདུག་མེད་ཅིང་སྐུ་ཚ་མཚན་ལྡན།",
    "ཞེས་ཁྱི་ཕག་ཏུ་གྱུར་པས་མི་གཙང་བ་ཟོས་ཚད་རི་རབ་ལས་ལྷག་པ་དང་སྲིན་བུར་གྱུར་ནས་ས་ལུད་ཟོས་པ་འོ་མའི་རྒྱ་མཚོ་གང་ཐུབ་པའི་ཚོད་དུ་འདུག་ཅིང་།",
    "སྐུ་མདུན་དུ་གང་ཡིན་འགྲོ་འགྲུལ་སྣ་ཚོགས་ལེགས་བསྡམས་བྱ་དགོས་ཚུལ་གྱི་བཀའ་གསུང་བྱུང་བ་ལྟར།",
    "ཇི་ལྟར་བུ་ཆུང་ཚུལ་དུ་འདུག་པ་ཡིས།",
    "སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ།",
    "རང་སེམས་ཉམས་ལེན་འདི་ལས་ལོགས་ན་ཁོ་རང་མེད།",
    "དེ་མ་ཟད་སྤྱིར་ཡང་གང་ཟག་མཆོག་དམན་སུ་ལའང་རང་ལྟ་བུས་ཚོད་བཟུང་ན་ཆེས་ཉམས་ཤིང་ཕུང་བའི་གནས་སུ་ངེས་པར་འགྱུར་ཉེན་ཆེ་བ་སྟེ།",
    "འདི་ལོར་སྦྱོར་དྲུག་པ་གསར་འདུག་མེད་ཀྱང་གང་གའི་གྲགས་རྒྱམ་ལ།",
    "ནོར་མ་རྙེད་ཙ་ན་འདོད་པ་ལ་བློ་ལོག་པ་སྐད།",
    "འདི་སྐབས་སུའང་རང་ཡུལ་གྱི་འགམ་སྟོད་བྲག་སྒོ་ཞེས་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "གཞན་ཡང་ཇོ་ནང་རང་ལུགས་ཀྱི་ཁྲིད་བཀའ་འདོན་ཆ་གང་མང་དང་སྔགས་རྙིང་ཕྱོགས་ཀྱི་ཟབ་བཀའ་མཁོ་ཚོགས་ཡང་མང་པོར་ལེགས་པར་གསན་ནོ།",
    "ལོ་འདིའི་དཔྱིད་དུ་ཨ་ཇོ་ནང་དཔེ་ཚོགས།",
    "ཅེས་གསུངས་ནས་སྡིགས་མཛུབ་མཛད་འདུག་གོ།",
    "གནས་ལུགས་བདེ་སྟོང་ཟུང་འཇུག་དེ་ཉིད་ཀྱང་རང་བཞིན་དག་མཉམ་གྱི་སྟོང་གཟུགས་རིག་པ་ཡེ་ཤེས་ཀྱི་རང་མདངས་མི་འགྱུར་སྐྱབས་མགོན་མ་ཏི་ཀིརྟིའི་གསུང་འབུམ།",
    "གནས་སུ་སྤར་པའི་ཐབས་ཀྱང་མཛད་འདུག་འདི་དུས་སུ་སློབ་བུ་ཞིག་བསམ་གཏན་གྲིབ་གཟུགས་ལ་འདུག་པའི་ཉམས་ཞུས་པས།",
    "སྐར་མ་དབོ་གཉིས་ཡིན་འདུག་དོ་ནུབ་མཚན་ཐུབ་ཅིག་བྱོས་ཤིག་གསུང་ནས།",
    "རྒྱ་ནག་ཏུ་ཉིད་ཀྱིས་རྡོ་རྗེ་སློབ་དཔོན་མཛད་ནས་སཡིགབསམ་ཕུར་སྒྲུབ་བཙུག་དུས་ཕུལ་བའི་སྙན་དར་ཁ་ཡིག་ཡན་གྱི་བརྒྱུད་པ་ནི་རྒྱལ་རབས་དེབ་ཐེར་སོགས་དང་འདྲ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་ཤེས་རབ་རྒྱས་བྱེད།",
    "གཏེར་མང་དུ་འདུག་པ་ལས་སྒྲུབ་ཐབས་ཟབ་པ་འགའ་ཞིག་བཞེས།",
    "ཀརྨའི་ཡང་དགོན་དབེན་པར་འདུག་པའི་ཚེ།",
    "ཁྱེད་རང་མི་ཆེན་བྱ་བྲལ་བའི་ཚུལ་གྱིས་འདིར་འབྱོན་པ་ཅི་ཡིན་ཞེས་དྲིས་པ་ན།",
    "བལྟས་པས་འོད་ཉི་མའི་ཟེར་ལྟར་བལྟ་བར་མི་བཟོད་པ་ཚ་ལམ་ལམ་བྱེད་པ་ཞིག་འདུག།",
    "ཉྫི་བཛྲ་ཀཱ་ར་ཤཱནྟཾག་གཏེར་། ཅི་ཡིན་པ་འདུག་དྲི་ཞིམ་པ་ལ་ཨང་ཟེར།",
    "དཔོན་སློབ་གཉིས་གཞན་ལས་དགྱེས་ཉམས་ཆེ་ཞིང་ན་བཟའ་རྣམས་ཀྱང་རྡུལ་གྱིས་གོས་འདུག་པ་ཅི་ཡིན་ནམ་ཟེར་བར།",
    "སད་ནས་ཀྱང་ཉམས་དགའ་ཡལ་ལེ་བར་འདུག་ཤོག་སེར་འབེབས་པར་གནང་བ་བསྩལ་བར་བསམ་སྟེ།",
    "ངེས་པ་འདྲོངས་པའི་སྙན་འབུལ་ཞུ་འོས་ཞིག་མེད་ཀྱང་སླར་སློབ་སྟོན་ཞུ་དགོས་པར་འདུག་གསོལ་བས་བཞུགས་གྲལ་དེ་གྱེས་པ་ན།",
    "ཁྱེད་རྣམས་གནས་སྐོར་བ་དཀྱུས་མར་མི་འདུག་སུ་འདྲ་ཡིན་ཞེས་རྟོག་པ་ཞུགས་པའི་དྲི་བ་ཞིབ་ཏུ་བྱེད་པ་ན།",
    "གྱེན་དུ་བལྟས་པས་སྔར་གཏེར་ཁུང་དུ་བཞུགས་རྒྱུའི་དཀོར་ཆའི་སྣོད་ཀྱི་དར་དམར་པོ་དེ་བྲག་ངོས་ཀྱི་མཐོ་ས་དེར་དམར་ལྷབ་ཀྱིས་བསྡད་འདུག།",
    "ཕུག་པའི་ཕྱིར་འོངས་ཚེ་ཉི་མ་དམར་ཐག་ཆོད་པ་ཙམ་དུ་འདུག།",
    "དེ་ནུབ་ཕྱོགསན་རྔ་བོ་ཆེ་ཞིག་འདུག་པ་ལ་ཐིམ་པའི་རྐྱེན་གྱིས་བསྐུལ་བའི་སྒྲ་ལས།",
    "དེ་ནས་ཁྲོའི་སྒྲུབ་རིལ་ཆག་གང་ཙམ་པ་ཞིག་བྱུང་བ་གཉིས་ཀ་གཡས་ཤིན་ཏུ་གོས་པའི་རྣམ་པ་ཅན་དུ་འདུག།",
    "དེ་ཡང་རང་ཉིད་བཟང་པོར་མ་གྱུརན།",
    "དེ་ཡང་རང་ཉིད་གཅིག་པུའི་རྐྱེན་སེལ་སོགས།",
    "འདུག་པ་ཐམས་ཅད་བརྗེད།",
    "ཅི་སྨྲས་ང་རང་ཤེས་པ་ཡིན།",
    "ད་ལམ་ཁྱེད་བྱོན་འདུག་ཟེར་བ་ཐོས་པས།",
    "བོད་འབངས་སྤྱིའི་བདེ་ཐབས་དང་རང་ལུགས་ཀྱི་བསྟན་པ་ལ་ཕན་པ་ཡིན་གསུང་བ་དང་།",
    "སྐུ་བརྙན་དཔག་ཏུ་མེད་པ་མཆོད་ཆ་བཟང་པོ་དང་བཅས་ཁྲ་ཆེམ་ཨ་ཆེམ་འདུག་པའི་མཐིལ་ཞལ་ཐམས་ཅད་མི་གཙང་བས་སྦགས་འདུག་པའི་ནང་དུ་མཇལ་རྒྱུའི་ས་དཔྱད་ཀྱིས་ཕྱིན་པས་མཆོད་རྟེན་གྱི་ནང་ཐམས་ཅད་ནི་རིང་བསྲེལ་གྱི་རིགས་མང་པོ་མཇལ་རྒྱུ་ཡོད་པའི་སྣང་བ་བྱུང་།",
    "བཅུ་གསུམ་བཅུ་བཞིའི་དུས་ཙ་ན།",
    "དེའི་གཉེན་པོར་གསང་སྒྲུབ་དྲག་པོའི་སྒྲུབ་པར་འབད་ན་ཐུབ་པར་གདའོ་ཞེས་ཟེར་བ་བྱུང་།",
    "གཞན་རྣམས་ནང་དེར་བྱོན་ཚར་ནས་གྲལ་རིམ་གྱིས་བཞུགས་འདུག།",
    "ཐམས་ཅད་ཀྱང་ཟིལ་ཆེ་ཞིང་བག་དྲོ་བ་ཤ་སྟག་འདུག།",
    "ཕུག་པའི་ཕྱིར་སླེབས་སྐབས་ཉི་མ་དམར་ཐག་ཆོད་པ་ཙམ་ལ་སླེབ་འདུག།",
    "ད་ང་རང་ལ་ལམ་གྲོགས་ཡོང་བ་འདུག་འོན་ཀྱང་མི་རྣམས་སྒྲོ་བསྐུར་བྱེད་དམ་སྙམ་པ་ན་དེའི་སྦུག་ན་རས་དམར་པོས་བཀབ་པའི་དམར་ལྡིར་ལྡིར་ཞིག་འདུག།",
    "རས་བཀབ་པ་དེ་བསལཾནས་བལྟས་པས་གཞོང་པ་ཆེན་པོ་ཞིག་ན་ཨཱ་ཙརྱ་གཅེར་བུ་ཞིག་གཡོ་འགུལ་མེད་པར་མནལ་བའི་བར་རྣམས་སིནྡྷ་ར་ཁྲག་སྦྲང་རས་བལ་སོགས་ཀྱིས་བཀབ་ནས་འདུག།",
    "མེ་ཏོག་དམར་པོའི་རྒྱན་ཅན་ཞིག་འདུག།",
    "དེའི་མཐའ་སྐོར་ན་མི་དང་ལྷ་འདྲེ་མང་པོ་ཡང་འདུག་གོ་ཡང་ཟླ་བ་བདུན་པའི་ཉི་ཤུ་བཞིའི་ནུབ་ཀྱི་རྨི་ལམ་དུ།",
    "རྡོ་རྗེ་ཐིག་ལེ་རྩལ་སོགས་ཐེ་ཚོམ་སེལ་བའི་སྒྲུབ་བྱེད་མང་དུ་བྱེད་འདུག་པར།",
    "བྲག་ཟུར་ཞིག་ན་ཁང་པ་ཞིག་འདུག་པའི་ནང་དུ་ཕྱིན་ཏེ།",
    "སོས་དབྱར་གྱི་དུས་མདུན་གྱི་འདམ་དང་བཅས་སྐྱིད་ཉམས་དོད་པོ་འོང་བ་འདུག་སྙམ་པ་བྱེད།",
    "ད་ཆ་རང་སར་མི་ཤོང་རྒྱུ་ནི་མི་འདུག།",
    "མཆོག་སྤྲུལ་ཕེབས་པའི་ལུང་བསྟན་སོགས་ཀྱང་ཁྱེད་རང་བཙན་པ་རྣ་བའི་བཅུད་ལེན་དུ་འཁོད་འདུག་པ་ལྟར་དང་།",
    "གཟུགས་མེད་ཀྱང་དཀའ་ལས་ཆེ་ཙམ་འདུག།",
    "ཕོར་པ་བཟེད་པས་ཆང་སྐྱུར་པོ་ཞིག་འདུག་པ་དེ་ནས་ཧུབ་གང་ཙམ་བཏུངས་ནས་ལྷག་མ་འབོའམ་སྙམ་པ་ན།",
    "ཁྱེད་སུ་ཡིན་ཞབས་ཕྱི་རྙིང་པའི་གྲས་ནི་མིན་འདུག་ལབས་པར།",
    "པོ་ཏཱ་ལའི་སྤེན་བད་བརྗེ་རྒྱུ་ཡིན་འདུག་ཟེར།",
    "ཤར་ཕྱོགས་ཀྱི་སྤེན་བད་ཐམས་ཅད་ཕབ་ཚར་འདུག་པར།",
