    "དེ་ལྟར་འདུག་པའི་སྐལ་མེད་དང་།",
    "འགོལ་སར་བཞུགས་དུས་བྱ་བྱེའུ་རི་དྭགས་སོགས་འཇིགས་པ་མེད་པར་སྐུ་པང་དང་འཁྲིས་སུ་བག་ཕེབས་པར་འདུག་པ་གཞན་གྱིས་མཐོང་།",
    "པ་ད་མ་པས་རྒྱ་གར་ནས་གདན་དྲངས་པའི་རྣམ་རྒྱལ་རྨི་འི་གཟུངས་ཀྱི་རྡོ་ཡིག་ཕུ་ཟན་ཏེན་གྱི་ནུབ་ཕྱོགས་སུ་སའི་འོག་ཏུ་ནུབ་འདུག་པ་རྣམས་རྒྱའི་ཡིག་ཚང་ལས་མཁྱེན་ནས་རྩད་བཅད་ཅིང་ངོས་འཛིན་མཛད་དེ་མཇལ་བའི་སྲོལ་བསྟོད།",
    "དབུས་ཕེབས་བཤོལ་ཏེ་ཅིས་ཀྱང་རང་ཡུལ་དུ་ཕེབས་དགོས་ཞེས་ཨུ་ཚུགས་བྱས་ཀྱང་བཤོལ་མ་ཐེབས་པར།",
    "ཁྱིའི་ལོར་ཅིས་ཀྱང་རང་དགོན་དུ་སླེབ་པ་བྱེད་ཅེས་དགོངས་གཞི་ཅན་གྱི་ཞལ་བཞེས་གནང་།",
    "དཔའ་ཞིང་བརྟུལ་ཕོད་པ་༥་ག་སེ་རོལ་ཟིལ་གྱིས་གནོན་པ་ལ་དགའ་བྱེད་རཱ་མ་ཎའི་མཆེད་པོར་འོས་པ་ཞིག་སྟེ་ལྷ་འབྲུག་གཡུང་རྒོད་གཉིས་སུ་གྲགས་པའི་ཡང་མེས་གྲགས་པ་ཅན་གཉིས་བྱུང་བའི་སྔ་མའི་རྒྱུད་པ་ཡིན་ཅིང་གདུང་རུས་ཐུ་མེད་ཡིན་ཞེས་རྡོ་རྗེ་འཆང་རང་ཉིད་གསུངས།",
    "དེས་ཡིད་དྲངས་ཏེ་འདི་ལྟ་བུ་ཞིག་བྱས་ནས་འདུག་ཐུབ་ན་སྙམ་པ་རྒྱུན་དུ་འཆར།",
    "བཟང་ངན་གྱི་རིམ་པ་མང་དུ་གདའ།",
    "ཞེས་པ་འདི་གསར་རྩོམ་དང་ལུང་ཡང་སྩལ་འདུག་སྟེ།",
    "ཞལ་ངོ་མ་བཟློག་ཙམ་དུ་ཚིགས་བཅད་ཅིག་བྲི་སླ་ཡང་ཕན་ཐོགས་པ་ཞིག་མི་ཐོན་འདུག་དེས་ན་ཉེར་མཁོ་ཞུ་རྒྱུར།",
    "སྔགས་ལམ་མྱུར་ཡང་རང་ཉིད་དེའི་སྐལ་ལྡན་ཡིན་མིན་ཅི་ཤེས།",
    "ངེས་པར་བཀའ་དྲིན་ཆེ་ཚུལ་དང་ཕྱིན་ཆད་དེ་ལྟར་མཛད་ངེས་ཡིན་ཚུལ་གྱི་ཞུ་ཡིག་ཀྱང་ཕུལ་འདུག་ལ།",
    "ཁྱེད་རྣམ་པ་ཚོ་འང་རི་ཁྲོད་པ་ཤ་སྟག་ཡིན་ཙ་ན་མ་མཐའ་འ།",
    "རྡོ་རྗེ་འཆང་པྲཛྙཱའི་མཚན་ཅན་སྐུ་མཚམས་མཛད་འདུག་པའི་མཚམས་ཁོངས་སུ་མཇལ་བར་གང་ཅིའི་གསུང་གླེང་དམར།",
    "སྐུ་མདུན་དེར་ཁྲི་ཀུའི་ཕྱོགས་ཀྱི་རི་ཁྲོད་པ་མང་དུ་ཕེབས་འདུག་པ་ཚོར་ཉེར་མཁོའི་ལུང་འགའ་ཞིག་ཀྱང་སྩལ།",
    "རི་ཁྲོད་པ་ཉིས་བརྒྱ་ལྷག་དུས་འཁོར་ཚོགས་ཡོངས་བཅས་གཞི་བྱེས་ཀྱི་གསན་མཁན་བཞི་བརྒྱར་ཉེ་བ་ལ།",
    "རི་བོ་རྩེ་ལྔར་ཕེབས་མི་འདོད་དམ་གསུངས་པ་ལ་འདུག་དཀའ་ཚུལ་ཐོས་པས་འགྲོ་མི་འདོད་ཞུས་པས།",
    "ཉིད་ནས་བསྟན་འགྲོའི་དོན་རླབས་ཆེན་མཛད་རྒྱུ་དེ་ཐུགས་ནས་མ་འབོར་གསུངས་འདུག་པ་ལ་དགོངས་གཞི་ཆེ་བར་མངོན།",
    "ཁྱེད་རང་ནས་བསྟན་འགྲོར་ཕན་གདགས་འདོད་དང་།",
    "དགེ་སློང་ཨ་ཙིརྡོ།",
    "ཡིད་ཆེས་ཁེལ་ན་ཆོག་པ་གདའ་སྙམ།",
    "ཞེས་སོགས་གསུངས་འདུག་པར་དཔག་ནའང་གང་ཟག་ཁྱད་པར་བ་ཞིག་ཏུ་ངེས་ལ།",
    "སློབ་དཔོན་ཆེན་པོ་རང་ཉིད་ཀྱི་སྤྲུལ་པར་ཡང་གསལ་བར་ལུང་བསྟན་འདུག་པ་དེ་ཉིད་ཡིན་ལ།",
    "སྐུ་འབུམ་ནས་ཆེ་ཤོས་ཚང་ཕེབས་འདུག་པར་མཇལ་འཛོམ་དང་གང་ཅིའི་གསུང་གླེང་མཛད།",
    "བཅ་བརྒྱད་ལ་བླ་གྲྭ་དུ་མས་ཆིབས་སྐྱེལ་བཅས་ར་ལའི་རི་ཁྲོད་འོག་མར་སྒ་ཚང་ཕེབས་ཏེ་གང་ཅིའི་གྲ་སྒྲིག་མཛད་འདུག་པར་བཞུགས།",
    "དེ་སྔོན་ཨུ་ལན་མུ་རུའི་ཆུ་ཤིན་ཏུ་བྲུབས་ཏེ་རབ་མེད་དུ་གྱུར་པས་ཁོང་རྣམ་པ་ཚོས་འབད་རྩོལ་ཆེན་པོས་གཟིངས་བསྒྲིགས་ཤིང་རོང་ཕྱོགས་ཀྱི་ཆུ་ཤེས་མཁན་མང་བོ་བཙལ་འདུག་ཀྱང་།",
    "དབོན་པའི་གཡོན་ངོས་ཀྱི་སྤང་ལྗོངས་སུ་གཟིམས་གུར་སོགས་བཞུགས་སྒར་གྲ་སྒྲིག་བྱས་འདུག་པར་རྒྱུན་བཞུགས་མཛད།",
    "ང་གྱ་གསུམ་བར་བསྡད་པ་འདི་ལྟས་ངན་ལོས་ཡིན་ཀྱང་།",
    "སྐྱེས་བུ་དམ་པ་ཡིན་ནའང་ཐ་མལ་བའི་ཚུལ་བཟུང་ཙ་ན་བསླབ་སྦྱངས་གལ་ཆེ།",
    "ཁྱེད་སྐྱེས་སྦྱངས་ཀྱི་ཤེས་རབ་ཡག་བོ་འདུག་ད་དུང་དོགས་པ་འདྲ་ཡོད་ན་སང་ཉིན་ཚོ་ཤོག་དང་།",
    "ཆེ་ཤོས་སྒ་ར་བ་ནས་གྲ་སྒྲིག་བྱས་འདུག་པ་བཞིན་ཞག་ཤས་སྤྲོ་སངས་མཛད་དེ།",
    "ང་རང་ལོ་བརྒྱད་ཅུ་གྱ་གཅིག་ཏུ་སླེབས་སྤྲེ།",
    "རིས་མེད་བསྟན་པའི་སྣང་བྱེད་ཀ་རིང་རྟ་མགྲིན་ཚང་དེར་ཕེབས་ནས་སྒུག་སྡོད་བྱས་འདུག་པར་མཇལ་འཛོམ་གནང་ཞིང་གང་ཅིའི་གསུང་གླེང་དམར།",
    "མ་ཟད་ཁོ་རང་བག་ཆགས་སད་པས་ཀྱང་།",
    "འབད་ཀྱང་གདངས་བསྐྱེད་མ་བཞེས་ཕྱོགས་གཅིག་དུས།",
    "གནས་ཆེན་ཁ་བ་དཀར་བོར་ཕེབས་རྒྱུ་སོགས་ཀྱི་དོན་ལ་བརྟག་ཞུའི་ཡི་གེ་བཅས་མི་སྣ་ཆེད་མངགས་མཛད་འདུག་པར་བརྟག་པ་མཛད་དེ་ཞབས་རིམ་གང་དགོས་ཀྱི་ཕྱག་བྲིས་བསྐུར་གནང་མཛད།",
    "མདུན་རི་ཕར་ཁའི་ནགས་དེ་ཡང་ཡག་པོ་འདུགརྒྱབ་རི་ལུང་བའི་ཕུའི་རི་དེ་གདུགས་བསླངས་པ་ལྟ་བུ།",
    "དེ་འཕྲལ་རྗེ་ཉིད་ནས་གཟིམས་ཆུང་རང་དང་ཁྲི་ཀུའི་རི་ཁྲོད་པ་རྣམས་ལ་ཞབས་རིམ་དུ་མའི་ལྗགས་བཀོད་དང་།",
    "གྱི་འདུན་པ་དོན་སྨིན་བྱུགྱི་ཞལ་བཞེས་དགོས་ཚུལ་ཞུས་འདུག་པར།",
    "སྐྱེ་རྒུ་ཡོངས་ཀྱི་ཕན་བདེའི་རྩ་ལག་གཅིག་པུར་འདུག་གཤིས།",
    "ལྔ་བ་ཆེན་པོ་དངོས་སུ་འདུག་གསུ་ངས་ཟེར་ཏེ་གང་ལྟར་དགྱེས་བརྩེའི་ཉམས་ཁྱད་དུ་འཕགས་པ་དང་།",
    "ཞེས་སོགས་གསུངས་འདུག་པ་རྣམས་ཀྱིས་ཤེས་ནུས་སོ།",
    "ཁོ་རང་འཚོ་ཆས་ཕྲན་བུ་ལ་བརྟེན་ནས་དགེ་སྦྱོར་བྱེད་རྩིས་ཀྱིས་རི་ཁྲོད་པའི་གཞུང་ལ་སྲང་བརྒྱ།",
    "བརྒལ་རྗེས་ཡོང་ནས་ཅུང་ཟད་འདུག་རྩིས་བྱེད་ཅེས།་",
