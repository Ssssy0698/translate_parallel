    "ཨོཾ་བེ་རོ་ཙ་ན་ཏ་ཐཱ་ག་ཏ་ཨ་བྷི་ཥེ་ཀ་ས་མ་ཡ་ཤྲི་ཡེ་ཧཱུཾ་ཕཊ་སྭཱ་ཧཱ།",
    "བཛྲ་ཙ་ནྡུ་བཀྲ་བྱ་ཤི་ན་ཞེས་སྔགས་དེས་ལན་བདུན་བཟླས་པ་བྱས་ནས་ལག་པ་གཡས་སུ་བྱིན་ཏེ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེ་ཡི་མདུན་དུ་བདག་ནི་འདུག།",
    "རྒྱལ་བའི་སྐུ་དང་རང་བཞིན་ལྡན།",
    "མི་གནས་ཚུལ་ལ་འདུག་པ་དང་།",
    "འགྲོ་བའི་བདེ་སྐྱིད་རང་རང་ལས་ལ་རག།",
    "སྔོན་འགྲོ་སེམས་བསྐྱེད་དང་རང་ལུས་ལྷ་སྐུར་སྒོམ།",
    "འཇིག་རྟེན་མགོན་པོའི་ཐུགས་དགོངས་ལ་རིན་ཆེན་བཟང་བོ་འདི་ལ་ཕྱོགས་འདིར་ཕན་ཐོགས་ཤིང་ངའི་གདན་ས་འདི་ཡང་ཚུལ་བཞིན་དུ་སྐྱོང་བ་ཞིག་འོང་བར་འདུག་དགོངས་ཤིང་བཞུགས་པ་ན།",
    "འོ་སྐོལ་དེ་རིང་འགྲོ་དགོས་པར་འདུགལམ་སྣ་བ་ཞིག་ཀྱང་འོངས་པར་གདའ་གསུངས་ཏེ་གཉའ་གོང་ནས་ཆས་ཙ་ན།",
    "དེ་ནས་ཀྱང་ཉན་པོ་ཡར་རྩེ་ལ་གཡས་སྐོར་བྱས་ནས་མཐའ་སྨུག་གཞུང་ནས་སྒར་བརྒྱབ་སྟེ་བསྡད་པའི་སྐབས་ཤིག་རྨི་ལམ་དུ་མཐའ་སྨྱུག་ཁ་ལ་བྱ་ཁྱུང་གཡུ་ཡི་གཤོག་པ་ཅན་ཞིག་འདུག་པ་དེས་མི་སྐད་ཀྱིས།",
    "དེ་རྗེས་ཞྭ་ལུར་གྲྭ་སྐོར་ལ་བྱོན་པ་ན་བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པ་ཡང་གདན་སར་ཕེབས་ནས་འདུག་པ་ལ་ཚོགས་སུ་བགྲོ་གླེང་མཛད་པས་ཐུགས་དགྱེས་ཏེ།",
    "དང་བོར་འདུ་ཁང་འདི་ཡིན་འདུགརྟེན་གཙོར་ཁྲི་བཞི་བཅུའི་མཐོ་ཚད་ཅན་གྱི་བྱམས་ཆེན།",
    "བཟང་བོའི་འདུག་སྟངས་དང་སྐྱིལ་ཀྲུང་སོགས་སྐུའི་བཞུགས་སྟངས་ཀྱང་གང་ལྟར་བཅོས་པ་དེ་བཞིན་དུ་བཞུགས་པར་གནང་ལ།",
    "ཏི་བོད་གངས་ཅན་གྱི་སྙན་ངག་པ་ཞེས་གསུངས་འདུག་པ་ནི་ཉི་མ་ལག་པས་སྦེད་མ་ཐུབ་པའི་ཚུལ་ཡིན་ནོ།",
    "བྱང་སེམས་སྦྱོར་ལམ་པ་ལྟ་བུས་ཀྱང་རང་ས་ལམ་གྱི་ཚོད་གང་དུ་ཡོད་མི་ཤེས་པ་ཡོད་པ་འདྲ།",
    "ད་ངེད་ལོ་ལོན་ཚོ་འདུག་དུས་མིན།",
    "མི་ཚོས་རོང་པོའི་དཀའ་བཅུ་ཤི་བའི་ཤུལ་ན་མང་ཇ་བསྐོལ་རྒྱུ་ཡང་མི་འདུག་ཟེར་བ་བྱུང་ན་ངའི་བསམ་པ་རྫོགས་པ་ཡིན།",
    "སོགས་ཀྱི་ལྟ་མགུར་ངོ་མཚར་ཞིག་བསྩལ་འདུགཕྱིར་ཕེབས་པས་ལྷ་སའི་ཁྱམས་རར་ཤུལ་དོད་ཅེས་གྲགས་སོ།",
    "གསེར་ཁྲིར་ནམ་ཕེབས་པ་མི་གསལ་ཞིང་གོ་རིམ་ལྟར་ན་རབ་བྱུང་བཅུ་བཞི་བའི་ས་ཕག་ཡས་མས་ཀྱི་ལོར་ཁེལ་དགོས་འདུག་གོ་། གདན་རབས་སོ་ལྔ་བ།",
    "ཁྱེད་བསྟན་པའི་བདག་པོ་ཡིན་ཙ་ན།",
    "རྒྱུར་ཡང་འགྱུར་བའི་ཚོད་དུ་མི་འདུག་གོ།",
    "ཞེས་གསུངས་འདུག་གོ།",
    "རྟེན་བཟང་བོའི་ངོས་སུ་འཕུར་ཏེ་འབྱར་འདུག་པ་སོགས་མང་བོ་བྱུང་།",
    "ང་རང་རྒས་ནས་གཏུགས་པ་དང་།",
    "རྒྱལ་བོ་ཇུ་ནང་བཅས་ཀྱིས་གནང་བའི་བཀའ་ཤོགཐ་ན་རྒྱལ་བོའི་མཛོད་ནས་བྱུང་བའི་དཀར་ཡོལ་ལྔ་བརྒྱ་ཡོད་པ་ད་ལྟ་གཅིག་ལ་ཤོག་སྒོར་ཆིག་ཁྲི་རི་བའི་རིན་ཐང་ཡོད་འདུག་གཞན་པའི་ཡོ་བྱད་ཀྱང་སྣ་མང་ངོ།",
    "སྤྲུལ་གཞི་བརྟན་པའི་འཁོར་ལོ་ཡིན་པའི་རང་རྟགས་སུ་འདུག་པ་ལས་གཞན་ཅི་སྟེ།",
    "ང་ནི་མི་འདུག་ལྕང་ལོ་ཅན་དུ་འགྲོ།",
    "ན་བཟའ་སྐུ་འབྱར་མའི་སྟེང་དུ་ཨ་ར་པ་ཙ་ནའི་གཟུངས་ཀྱི་ཡིག་འབྲུ་དང་དྷཱིཡིགདམ་པ་གོང་མ་རྣམས་རྒྱལ་བ་སེང་གེ་ང་རོའི་སྐུ་ཡིན་གསུངས་པའི་སྐུ་གཟུགས་རྒྱབ་ཡོལ་གྱི་རྣམ་པ་དང་བཅས་པ་མདུན་རྒྱབ་མེད་པར་ཕྲ་ཆིལ་ལེར་ཁྱབ་པ།",
    "རང་རང་ལྟ་སྒོམ་སྤྱོད་པའི་བཞེད་ཚུལ་དང་།",
    "རྒྱུན་སྐྱོར་ངང་ནས་རང་རང་འགྲེལ་བ་དང་།",
    "ད་མཁའ་འགྲོ་མ་རྣམས་བསུ་མར་འོངས་འདུག་ཁོ་ཚོས་ལོ་སྔ་མ་ནས་གསེར་གྱི་འགྱོགས་བྱམས་འདིར་བཞག་ཡོད་གསུངས་ཤིང་།",
    "དགུང་ལོ་ཉེར་གཅིག་དུས་ཀྱི་དཔྱིད་ཟླར་མཁས་པ་ཆེན་པོ་དཔའ་རིས་རབ་གསལ་དགོན་ཆེན་དུ་དམ་བཅའ་འཇོག་ཏུ་ཕེབས་པར།",
    "མདུན་འདུག་རྣམས་ནས་རང་ཡུལ་དུ་འབྱོན་པར་ནན་སྐུལ་བྱས་ཀྱང་མ་གསན་པར་འདི་རུ་བཞུགས་རྒྱུ་ཡིན་ཞེས་ཐག་བཅད།",
    "ལན་ཅིགའཛམ་གླིང་ཉི་མ་རྒྱང་ནས་ཤར་གྱིན་གདའ།",
    "འགྲོ་བས་ད་ལྟ་སོ་ནམ་བྱེད་ཀྱིན་གདའ།",
    "སྐུ་ཐམས་ཅད་ལས་བདུད་རྩི་བབས་པ་ཡིན་འདུགདེ་དག་ལ་དགོངས་ནས་འཇམ་དཔལ་དབྱངས་དངོས་ཀུན་མཁྱེན་སྨྲ་བའི་ཉི་མ་འཇིགས་མེད་ཞབས་ཀྱིས།",
    "ཕྱིས་སུ་གདུང་སྐལ་གྱིས་འཇམ་པའི་དབྱངས་ཀྱི་སྐུ་བཞེངས་ཏེ་གཟིམ་ཁང་རང་དུ་བཞུགས་སུ་གསོལ།",
    "ཁྱད་པར་རོང་བོ་གདན་ས་གསུམ་ལ་ཕན་པའི་གཟེར་ལྟ་བུར་གསུང་རྒྱུན་འདུག་གོ།",
    "ཀུན་བཟང་རང་གྲོལ།",
    "ཚེ་དཔག་མེད་བཞེངས་ན་ལེགས་ཞེས་པའི་ལྗགས་བཀོད་ཀྱང་སྩལ་འདུག་པས་ངོ་མཚར་ཞིང་དམ་པ་གཉིས་ཀར་མི་ཕྱེད་པའི་དད་གུས་ཐོབ།",
    "ཡང་ཀ་རིང་སྒོམ་སྤྲུལ་བདུད་འདུལ་རྡོ་རྗེའི་ཡང་སྤྲུལ་གྱིས་ཞུས་ངོར་བཀྲ་ཤིས་དར་རྒྱས་གླིང་རང་ནས་མཚན་སྒྲོགས་ཚང་གཙོ་བྱས་པའི་བླ་སྤྲུལ་མང་བོ་དང་།",
    "ཁོ་རང་རི་དྭགས་གཤོར་དུས་ཀྱི་སྡོད་གནས་བྲག་ཁུང་ལེགས་པོ་དེ་ཁྲག་སོགས་རྫོབ་ཀྱིས་སྦགས་པས་སྟོན་མ་ཕོད་པར་དེ་དང་ཉེ་བའི་བྲག་སྐྱིབས་ཤིག་བསྟན།",
    "དེའི་ཕུར་བུ་དེ་ཧོར་འབྲོ་ཚང་ན་ཡོད་པ་དབྱར་སེར་བ་འགོག་དུས་གནམ་ལ་བསྟན་པ་ཙམ་གྱིས་ཆོགདེའི་རྒྱུད་པ་ལས་འབྲོ་ཚང་ལ་གྲུབ་ཆེན་མང་བོ་བྱོན་གསུངས།",
    "མཇལ་བའི་སྐལ་བ་རང་རང་ལས་ཀྱིས་ཤེས།",
    "རང་རང་འདོད་ན་གང་དགོས་ལེན་རྒྱུ་ཡོད།",
    "གནས་སྒོ་གཡོན་ཕྱོགས་རི་ཟུར་གདའ་བའི་གཤམ།",
    "རྗེ་རྡོ་སྦིས་ཤེས་རབ་རྒྱ་མཚོས་མདུན་ན་འདོན་གྱི་དོན་ཏེ་གོང་མའི་མདུན་འདུག་པ་ཡིན་གསུངས་པ་དང་།",
    "དེང་སང་མགོན་ནེ་ཚང་འདི་བཟང་བར་འདུག་ཨང་གསུངས་པ་འདི་ཙམ་གྱིས་ཀྱང་རང་ཉིད་ཀྱི་མངའ་ཐང་གསལ་བར་མཛད་པ་ཡིན་ནོ།",
    "ཆུ་ནག་གད་པ་ཐོད་དམར་ནི་བོད་སོག་ཐུག་དུས་ནང་སོ་མགོན་པོ་རྒྱལ་བསད་པའི་ཁྲག་རྟེན་ཡིན།",
    "དང་ཐམས་ཅད་མཁྱེན་པ་ཁོང་རང་ཉིད་དང་།",
    "བཟོ་བོ་རང་རང་ལ་ལས་ཀའི་ཐོག་མཐའ་བར་གསུམ་གྱི་ཉམས་ལེན་རིམ་པ་སོགས་བཀའ་དྲིན་གྱིས་བསྐྱངས་པ་རྣམས་ད་ལྟ་དད་པའི་རྟེན་ཙམ་དུ་འཁྱེར་ཐུབ་ན་ཡང་རྙེད་པ་ཀུན་གྱི་མཆོག་ཡིན་ནོ།",
    "འདིར་ཁོང་རང་ཉིད་ཀྱིས་ཕྱག་བསྐྱོད་དེ་བཞེངས་པའི་ཚེ་ལྷ་རྣམ་གསུམ་དང་།",
    "བསྐལ་མཆོག་དུས་རིང་འགོ་བའི་སྒྲིབ་ཀུན་ཟད།",
    "ཇི་ལྟར་རུས་སྦལ་དྡེ་ནི་ཆུ་ཡི་ནང་ན་ཀུན་ནས་བསྐུམས་ཤིང་འདུག།",
    "དྡེ་བཞིན་གཡྡེམ་དང་གནས་དང་རང་གཞན་ཕན་བྱ་དོན་བྱྡེད་པའི།",
    "འཇིག་རྟྡེན་བདྡེ་དང་རང་སྲོག་ལ།",
    "བདག་཈ིད་འདུག་པ་གང་ཡིན་པ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "འདུག་དང་ཁྲོ་དང་རྒོད་པ་ན།",
    "ཉན་ཐོས་དང་རང་ས་རྒྱས་ཀྱིས་རྣམ་པར་བཟློག་པའི་ཕྱིར་སེམས་བརྟན་བ་བསྐྱེདཔ་དང་།",
    "དེས་ནི་འགྲོ་འམ་འདུགགམ།",
    "འཇིགས་མཆོག་བྱ་གལལན་བརྒྱ་སྟོང་དུ་མར་བསྐོར་བ་བྱས་ནས་མདུན་དུ་འདུག་སྟེ།",
    "སྨིན་ཚུགས་གཞུ་ལྟར་འདུག་ཅིང་རལ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛསིདྡྷ་ལོ་ཙ་ནི་སརྦ་ཨརྦ་སཱ་དྷ་ནི་སྭཱཧཱ།",
    "ས་བྱ་བ་ཙ་ནེ་ན་ས་དྷུ་བ་ཏི་སྤྱད་དུམ་བད་ཧི་ཏི་ཛ་བ་ཏི།",
    "ཨོཾ་ལོ་ཙ་ནེ་པྲ་བ་རི་བྲཧྥ་རི་ནི་སུམ་བྷ།",
    "ཨེ་ཏེ་ན་སྤྱད་ཏུ་བ་ཙ་ནེ།",
    "བ་ཙ་ནེ་ན་བ་ཙ་ནེ་ན་སཏྟེ་ན་བཛྲ་ཎེ།",
    "ཨོཾ་ཀ་མ་ལ་ལོ་ཙ་ནི་མ་ནུ་རྱ་པཉྩལོ་སརྦ་དུཁ་ནི་ན་ས་ནི་སཱ་དྷ་ཀ་པྲི་ཡེ་ཛ་ཡ་ཛ་ཡ།"
