    "དེ་དུས་གྲོགས་དང་དགའ་ཉེ་མང་པོ་འདུག་ནམ་དུས་དཔྱིད་ཀ་ཡིན་ཀྱང་ཁ་ཤས་ཀྱིས་ཤ་སྐམ་པོ་འཁྱེར།",
    "ང་རང་ནས་ཀྱང་རྭ་སྒྲེང་བླ་བྲང་ལ་སྔ་ཕྱི་བར་གསུམ་ཞབས་ཞུ་བསྒྲུབ་པ་བཅས་ལ་བརྟེན་སླར་ཡང་གྱོད་འགྱངས་ལོ་གཅིག་ཐོབ་བྱུང་།",
    "ཕྱི་ལ་འགྲོ་འདོད་བྱུང་བ་བཅས་ལ་བརྟེན་སླར་ཡང་མགོ་འདྲེན་འགྲོ་ཕྱོགས་བརྒྱུད་ནས་ང་རང་ཚུ་ལེན་པར་འགྲོ་ཆོག་པའི་བཀའ་འཁྲོལ་ཐོབ་པས་གཡག་དེད་ནས་བྱང་དུ་ཚུ་ལེན་པར་བསྐྱོད།",
    "བབས་མ་ཐུབ་ཨ་ཞང་དེ་འདྲའི་སྡུག།",
    "ཁག་གཅིག་མེ་བཏང་ཇ་བསྐོལ་གྱིས་དུ་རླངས་ནམ་མཁར་འཕྱུར་བཞིན་འདུག།",
    "ང་རང་སྐྱེ་ཡུལ་རྭ་སྒྲེང་ས་མ་འབྲོག་ཡིན་ཀྱང་འབྲོག་པའི་གོམས་གཤིས་ཤུགས་ཆེ་བ་དང་།",
    "རྒྱ་བོད་ཟུང་འབྲེལ་ཞེས་པའི་ཡི་གེ་ཆེན་པོ་སྡིང་ཆའི་ཐོད་དུ་བྲིས་འདུག་རྒྱ་མིའི་དཔོན་པོ་དང་།",
    "རྟ་ནག་ཐག་ནག་དྲུད་བསྡད་གདའ།",
    "ཝ་དམར་གྲ་རྩེ་ངོམ་བསྡད་གདའ།",
    "ན་ཆུང་སྐྱེས་གཟུགས་ངོམས་བསྡད་གདའ།",
    "ང་རང་ཕོ་ལོ་༢༣ སླེབས་པའི་ལོ་དེར་གཡག་སུམ་ཅུ་ཙམ་ཞིག་ལ་ཚྭ་དང་།",
    "དབུས་སྐད་རྒྱག་མཁན་འདུག་པ་མ་ཟད།",
    "ད་ཕྱིན་ཆད་ཕྱི་ལ་མ་འགྲོ་རོགས་བྱོས་ཅེས་སྐེ་ལ་འཐམས་ཏེ་ངུ་བཞིན་བརྗོད་ཀྱི་འདུག་ནང་དུ་ངལ་གསོས་ནས་ཉིན་གཉིས་པར་ཙིང་རིའི་སྦ་ཆེན་ཚང་ཞེས་པའི་མི་ཚང་སྐད་གྲགས་ཅན་ཞིག་ཡོད་པ་དེར་བསྟན་སྲུང་དྭང་དམག་མི་རྟ་པ་གང་ཙམ་ཞིག་འབྱོར་འདུག་ཟེར་བ་གོ་ཐོས་བྱུང་།",
    "ཙིང་རིའི་སྦྲ་ཆེན་ཚང་དུ་གོ་ལག་བཟང་བའི་བསྟན་སྲུང་དང་བླངས་དམག་རྟ་པ་དྲུག་ཅུ་སྐོར་ཞིག་འདུག་དེའི་ནང་ཁམས་པ་དང་།",
    "རྒྱང་ཤེལ་བཅས་འཁྱེར་རྒྱུ་འདུག་དམག་སྤྱི་ཛམ་ལྷས་རྒྱ་སྐད་ཐེབས་ཆག་གཅིག་ཤེས་ཀྱི་འདུག་པས་མགོ་བླངས།",
    "རྟ་རྒོད་མ་འདི་ཡང་འཕྲོག་མི་ཡོང་ངམ་བསམ་གྱི་འདུག་ཅེས་སྐད་ཆ་དྲིས་བྱུང་།",
    "སྐུ་མཁྱེན་སྲོག་སྐྱོབ་རོགས་ཅེས་ཞུ་བ་འཐེན་གྱི་འདུག་སེམས་ཀྱིས་མ་བཟོད་པར་བཀྱིགས་ཐག་གློད་པ་ཡིན།",
    "ཚང་མར་གོ་ལག་ཡག་པོ་ཡོད་པ་དང་མེ་མདའ་ཐོལ་པ་རྟ་རྒྱབ་གཅིག་འདུག་པས་གོ་ལག་ཐོག་སེམས་ཁྲལ་མེད།",
    "ཁོ་ཚོ་མི་མང་བ་ཡོད་པས་ཁ་གཏད་བཅག་ན་རང་སྡུག་ཉོ་རྒྱུ་ལས་མི་འདུག་པས་རང་འགར་བཞག་པ་ཡིན།",
    "ང་ལི་ཐང་ཕུན་ཚོགས་ཤོག་ལ་མགོ་འདོགས་སྐབས་དམག་སྒར་དེ་སྒེར་ནང་དུ་སྤོས་ཚར་འདུག་སྒེར་ཞེས་པའི་ས་ཆ་དེ་བཙན་པོ་ཡོད་པས་མདུན་གྱི་ལམ་འཕྲང་བཀག་པ་ཡིན་ན་གཡས་གཡོན་གཡང་གཟར་ཅན་གྱི་བྲག་རི་དང་རྫ་རིས་བསྐོར་ཡོད་པས་མི་གཅིག་ཁྱི་གཅིག་ཐར་ས་མེད།",
    "གླ་རྩི་གོང་ཆེ་བའི་སྐབས་སུ་འཁེལ་འདུག་པས་གོང་ཡག་པོ་རག་བྱུང་།",
    "སྒ་པའི་ཤོག་གཅིག་བཅས་ཤོག་ཁ་ཁ་ཤས་འདུག་ཕུ་མདའ་གཉིས་སུ་སོ་རིང་ཐུང་བཙུགས།",
    "བྱེད་ཐབས་མི་འདུག་ངེད་གཉིས་ནས་མུད་མཐུད་འཛིངས།",
    "ང་ལ་མདེའུ་རྐང་གཅིག་ལས་ལྷག་མི་འདུག་མཐའ་མའི་མདེའུ་དེ་གཟབ་གཟབ་བྱས་ཏེ་ཚུར་བཅར་ཡོང་བའི་རྒྱ་དམག་ནང་དུ་མེ་མདའ་ལན་ཀྲུའུ་འཁྱེར་ནས་བཀོད་འདོམས་བྱེད་མཁན་ཞིག་འདུག་པ་སོ་ཁུང་དུ་བླངས།",
    "ཤོད་དགོས་དོན་ཡང་མི་འདུག།",
    "རྭ་སྒྲེང་སྤྲོ་ཁང་ནང་ཐང་མགོ་ཆུས་བཙུགས་འདུག་ཉི་ཤར་མཚམས་སུ་འབྲས་ཐུག་སླ་པོ་ཞིག་སྟེར་བ་བཏུངས་པ་དང་།",
    "དེ་གར་ཞལ་ངོ་ཟུར་པ་མཚུངས་མེད་པ་བཅུག་འདུག་པ་མ་ཟད།",
    "བསམ་གཏན་སྦྱིན་པ་གཉིས་ཀྱང་བཅུག་འདུག་ཁོ་པ་༤ དུ།",
    "མར་ཁང་སྒོ་འགྲམ་དུ་སྲུང་བྱ་བ་གཅིག་ལས་མེད་པས་ནམ་ཕྱེད་དུ་སྟུག་དྲིའང་ཙེར་སྒྲ་གྲགས་ནས་གཉིད་ཤོར་འདུག་པས་རྐང་ལྕགས་དཀྲོལ་ཐུབ་པ་ཡིན་ན་སྒོའི་ཅིའི་སྡིའི་ག་ལེར་གཏོར་ནས་བཙོན་སྲུང་བ་དེ་བསད་པ་དང་མེ་མདའ་འཕྲོག་ནས་བྲོས་རྒྱུ་རྩིས་ཡིན།",
    "པཱ་ལགས་སྲོག་ཐོག་ཕྱིན་པ་ལས་ང་རང་སྡུག་སྦྱོང་འོག་ཤི་བ་དགའ་བསམ་ནས་ཨུ་ཚུགས་བརྒྱབ་ནས་ངོས་ལེན་གང་ཡང་མ་ཞུས།",
    "བུ་ཡིས་ཕ་བསམ་ནས་མ་ཤི་དམྱལ་ཁམས་ཀྱི་དཀའ་སྡུག་མྱངས་ནའང་པ་ལགས་ནས་ངོས་ལེན་ཞུས་ཚར་སྟབས་ཐབས་ཤེས་མི་འདུག་པཱ་ལགས་འདུ་ཁང་ནང་བཅུག་ཡོད་པ་དང་།",
    "ཡིན་ནའི་སྐབས་དེར་བུ་ཆུང་ཤུགས་ཆེ་བ་ཡོད་འདུག་པས་ལག་ལྕགས་བཀྲོལ་མ་བྱུང་།",
    "ང་རང་དགའ་ཐག་ཆོད་ནས།",
    "ངས་ཟླ་བ་གཅིག་ལ་རྩམ་པ་རྒྱ་མ་༨ བཟའ་ཐུབ་ཀྱི་འདུག་པས་གཟུགས་པོའང་ཡག་པོ་ཆགས་བྱུང་།",
    "ང་རང་ནས་བཙོན་གྲོལ་ཐོབ་མེད་པར་ལས་མི་རུ་ཁག་ཡིན་པ་དང་།",
    "རྫས་མེ་འབར་ཤུལ་དུ་འོབ་དོང་ཐོག་བརྩེགས་ཁ་ཤས་ཙམ་ཆགས་འདུག་པ་མ་ཟད།",
    "ཟླ་བ་༦ རྗེས་སློབ་སྦྱོང་ཚར་བ་ཡིན་ཞེས་རང་གནས་སུ་ལོག་བཅུག་འདུག་ཀྱང་།",
    "སྤྱང་རྒན་ཐང་ནས་འཇུས་པ་གཉིས་ཁྱད་པར་མེད་ཅེས་ངའི་དོན་དུ་པཱ་ལགས་ཐག་པས་བསྡམས་ནས་མནར་གཅོད་མང་པོ་མྱོང་དགོས་བྱུང་འདུག།",
    "གཅུང་པོ་གཉིས་ནས་སོ་སོའི་བརྩེ་བའི་པཱ་ལགས་ཀྱི་སྐུ་ཕུང་གང་ཟབ་ཟབ་བྱས་ནས་གཙང་པོར་བཤམས་འདུག་པས་ཅུང་བློ་བདེ་པོ་བྱུང་།",
    "བཙོན་པ་འདས་གྲོངས་ཕྱིན་པའི་ཅ་དངོས་བསྒྲིལ་ནས་མིང་བྲིས་ཏེ་ནང་མི་མ་སླེབས་བར་ཉར་སྲོལ་འདུག་པ་བཞིན་གདན་ཉལ་ཆས་ཆ་ཚང་སྤྲད་བྱུང་།",
    "ངའི་ཕྲུ་གུར་ཡང་ཁྱིམ་ཐབ་ཟིན་ནས་ཕྲུ་གུའི་ཕ་མར་གྱུར་ཟིན་འདུག་མག་པར་འགྲོ་སའི་ཕ་རྒན་གྱི་བུ་སྤུན་ཇོ་སྟེར་ཟེར་བ་ཞིག་གདམ་གཞུང་སྦ་ག་ཚང་དུ་མག་པར་ཡོད་པས་སྔར་ང་རང་རིན་ཆེན་བྲག་དང་།",
    "པ་ལགས་ནས་བསམ་བློ་དེ་ལྟར་མ་གཏོང་རོགས་ཅེས་བྲིས་འདུག་སྤུན་མཆེད་དང་ཕྲུ་གུ་ཐུག་འཕྲད་བྱས་རྗེས་ལྷ་སར་ཡོང་ནས་དགོངས་པ་ཟླ་བ་གཅིག་ལས་མེད་ཀྱང་ངས་ཟླ་བ་གསུམ་བསྡད་པ་ཡིན།",
    "ང་རང་ངོ་ཚ་ནས་སྐད་ཆ་ཤོད་ཤེས་ཀྱི་མི་འདུག་པས་ཆང་བཏུང་ནས་བསྡད།",
    "ཁྱེད་རང་གྲལ་རིམ་གྱི་བུ་ཕྲུག་ཡིན་སྐོར་མཚམས་ལགས་ནས་གསུངས་བྱུང་།",
    "ཟིན་པར་དཀའ་ལས་འདུག་ཆུ་ཚོད་བདུན་པ་ཏག་ཏག་ལ་ཨ་ནུའུ་ཡོད་སར་འགྲོ་སྐབས་ཨ་ནུའུ་ཡིས་ཁ་ལག་བཟོས་ནས་སྒུག་བསྡད་འདུག།",
    "ཁ་སྟོབ་དང་ཐ་མག་རིགས་ལྷ་ས་ནས་འཁྱེར་འདུག་ལུག་དེ་གཉིས་གསོད་མཁན་མ་རག་པར་དཀའ་ལས་ཆེན་པོ་བྱུང་།",
    "མ་རྩ་རྒྱ་སྒོར་ཁྲི་དྲུག་ནས་ཁྲི་བདུན་བར་དུ་སླེབས་ཀྱི་འདུག་པས་བློ་བདེ་པོ་ཞེ་དྲག་འདུག་༡༩༧༩ ལོ་ཙམ་ནས་རྒྱ་བོད་དབར་ཚོང་བརྒྱབ་པ་ཡིན།",
    "ངོ་ཤེས་ཀྱི་ཡོད་པས་ཅེས་བརྩད་གཅོད་བྱས་འདུག་བསྟན་དར་ནས་ངོ་ཤེས་ཀྱི་མེད།",
    "ཡུན་རིང་ནས་མིག་ཀྱང་སྒྲིབ་འགྲོ་གདའ།",
    "ཡུན་རིང་ནས་སྐད་ཀྱང་འགག་འགྲོ་གདའ།",
    "ང་རང་ཧང་བསངས་ནས་རྨི་ལམ་མིན་ནམ་བསམ་བྱུང་།",
    "རྨས་པ་མང་པོ་བྱུང་ནས་ཞི་རྒོལ་གྱེན་ལངས་ཤུགས་ཆེ་རུ་ཕྱིན་འདུག་ངའི་ལག་པར་རྡོ་ཞིག་བཅང་བཞིན་པར་ས་ལ་འགྱེལ་འདུག་ཅིང་དུས་རྒྱུན་ལུས་ལ་ཕྱུ་པ་དང་།",
    "དུག་ལོག་ལ་བལྟས་ནས་ཁམས་པ་ཞིག་རིལ་འདུག་བསམ་པ་འདྲ།",
    "ན་ཚས་བཟོད་ཐུབ་ཀྱི་མི་འདུག་ཅེས་བཤད།",
    "བསྡད་འདུག་ཟེར་བྱུང་།",
    "སྒོ་རྟགས་ཕྱི་སྒོ་༢༦ ནང་སྒོ་༢༢ ཡིན་པ་བཅས་གསལ་པོ་སྐད་ཆ་དྲིས་འདུག་ཕྱི་ཉིན་དྲན་པ་གསོས་འདུག་ཅིང་ནམ་གསལ་སྐབས་ཨ་ནུའུ་ནས་ཇ་དང་།",
    "ཕུགས་སུ་སྐྱོན་ཡོད་ན་ལས་ད་ལྟ་མདེལ་ལྕགས་ཀྱིས་མ་བདེ་བ་དམིགས་བསལ་མི་འདུག།",
    "ང་རང་རྨས་སྐྱོན་ཅུང་དྲག་བསྐྱེད་བྱུང་ཚར་ཙམ་ཡིན་ནའང་ཁྲོམ་བསྐོར་ནང་ཕྱིན་པ་ཡིན།",
    "ཁོང་གཉིས་བློ་རྩ་བརྟན་ལ་རྒྱལ་ཞེན་གྱི་བསམ་པ་ཆེན་པོ་འདུག་པས་ངེད་རྣམས་ཕན་ཚུན་འབྲེལ་འདྲིས་བརྩེ་བ་ཆེན་པོ་ཡོད།",
    "དེ་འདྲ་ཞིག་ལ་འགུལ་སྐྱོག་བཏང་བྱུང་བས་ཡར་ཙོག་ཙམ་བྱས་ནས་བལྟ་སྐབས་མེ་མདའ་སྔོ་ཁྲིག་ཁྲིག་ཏུ་ཉེན་རྟོག་པ་དང་དམག་མིས་མཐའ་སྐོར་འདུག་ཡཱ་ད་ཚར་དཞག་ལདང་བཤ་བངཔངས།",
    "སྐྱིད་པོ་འདུག་གས་ཞེས་གྲལ་བརྡུང་བཏང་བྱུང་།",
    "དེ་ཚོས་ཡང་རྭ་སྒྲེང་བསྟན་པ་ཁོ་བསྡུ་གསོག་བརྒྱབ་ཚར་འདུག་བསམ་པ་ཡོད།",
    "ཡང་སྨའོ་ཧུའུ་འདི་གར་སླེབས་ཚར་འདུག་གཱཟེར་བྱུང་།",
    "དེ་བར་བཟའ་ཟླས་གང་དུ་ཡོད་མེད་བརྩད་མ་ཆོད་པར་བསྡད་འདུག།",
    "ངའི་རྐུབ་གང་འདྲ་ཆགས་འདུག་གམ་ཞེས་གུ་ཐུང་ཕུད་ནས་རྐུབ་ང་ལ་བསྟན་བྱུང་།",
    "ཕྱུར་བ་བཅས་མང་པོ་འཁྱེར་འདུག་པ་མ་ཟད་ཐ་མག་ཧུང་རྡ་ཧྲང་སྡར་ཚན་གཉིས་འཁྱེར་འདུག་བཟའ་ཟླར་སེམས་ཕྲལ་རྩ་བ་ནས་མ་བྱེད།",
    "དྲི་བ་ལེན་མཁན་ཡག་ཉེས་བཅས་ལ་གཞིགས་པའི་བཙོན་འཇུག་དུས་ཡུན་རིང་ཐུང་ཅི་རིགས་ཡོད།",
    "སྐྱབས་བཅོལ་བའི་གྲས་སུ་རྒྱལ་ཁབ་འདྲ་མིན་གྱི་མི་གྲངས་བརྒྱད་བཅུ་ལྷག་འདུག་ཅིང་ཁ་ལག་དང་།",
    "གལ་སྲིད་སུད་སིར་ལེན་མ་ཐུབ་ན་ང་རང་བལ་ཡུལ་དུ་ཡོང་ནས་ཁྱིམ་གཞིས་ཟིན་རྒྱུར་ཐག་བཅད་དེ་བོད་དུ་ཡོད་པའི་ཁྱིམ་གྱི་ཅ་ལག་དང་།",
    "ལས་འགུལ་དེ་ཡི་ནང་རང་ཉིད་ཀྱིས་ཁྲག་དམར་ཐིམ་ཡོད་སྟབས་ལམ་ཐག་རིང་བ་དང་།",
    "སུད་སི་ནས་བོད་རིགས་བརྒྱ་མ་ཟིན་ཙམ་འདུག་ཅིང་འགྲུལ་སྐྱེལ་སྦ་སི་ཞིག་གླས་ནས་འཇར་མན་ལ་ཐོན།",
    "བློ་ཕམ་དགོས་པ་ཞིག་ལ་སུད་སིར་བོད་མི་སྟོང་ཕྲག་ཁ་ཤས་ཡོད་ཀྱང་གཞོན་ནུའི་ལས་འགུལ་ལ་རྒྱབ་སྐྱོར་གྱིས་ཟས་བཅད་ངོ་རྒོལ་ནང་འཛུལ་ཞུགས་བྱེད་མཁན་ང་གཅིག་པུ་ལས་བྱུང་མི་འདུག་བོད་ཀྱི་གཞོན་ནུ་ལྷན་ཚོགས་ཀྱི་ཚོགས་གཞོན་ཀརྨ་ཡེ་ཤེས།",
    "ང་རང་ནས་ཟས་བཅད་ངོ་རྒོལ་ནང་མཛུལ་ཞུགས་བྱ་དགོས་པའི་དམིགས་ཡུལ་དང་།",
    "དེ་ནས་བཟུང་ཤིང་འབྲས་ཁུ་བར་ནུས་སྟོབས་འདུག་ཅེས་བརྗོད་ཀྱི་ཡོད།",
    "ལྷག་དོན་ང་རང་ལོ་གཅིག་དང་ཟླ་བ་བརྒྱད་རིང་རྒྱ་མིའི་རྐང་ལྕགས་ཀྱིས་བཅིངས་ནས་མུན་ཁང་དུ་བསྡད་ཅིང་།",
