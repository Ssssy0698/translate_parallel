    "ཐོབ་བྱ་སྡོམ་པའི་ངོབུདང་དབྱེ་བ་སྤྱིར་བཤད།",
    "དེ་གསུམནཱིརད་རྒྱུད་ལ་དུང་གིས་དོན་དམ་པའི་དགེ་སློང་སྐྱེས་པས་བསྙེན་པར་རྫོགསཔའོ།",
    "སུ་སྐྱེ་རྒུའི་བདག་མོ་དང་།་",
    "ཤཱཀྱའི་བུ་མོ་ལྔ་བརྒྱས་ལྕི་ཚེས་བརྒྱད་སྤོང་བར་ཁས་བླངས་པས་ཏེ།",
    "སངས་རྒྱུས་སྐྱབས་སུ་སོང་ནས་འཇིག་རྟེན་པའི་ལྷསོགས་སྐྱབས་གནས་གཞན་མི་འཚོལ་བ་དང་།",
    "རང་གི་སྲོག་གི་ཕྱིར་དང་།",
    "གཞན་ལ་བསྙེན་གནས་ཡོད་མོད་ཀྱི།",
    "ན་གོང་མའི་ཡོན་ཏན་གྱི་རྟེན་དུ་གྱུར་པ་སེ་བྷར་ནི་མཚན་ཉིད་དང་ལྡན་པ་རེས་བདུན་ཁོ་ན་ཡིན་པར་ངེས་ཏེ།",
    "དང་པོ་ཉན་ཐོས་བྱེ་བྲག་སྒྲུང་གི་ལུགས་ནི།",
    "རང་གིས་གང་བསྲུང་འདོད་པ་ལྟར་ཁས་ལེན་པའི་གྲངསཇི་ལྟ་བར་སྲོག་གཅོད་པ་ཙམ་སྤོང་བ་ལྟ་བུ་སྣ་གཅིག་སྤྱད་པ་དང་།",
    "དེ་བཞིན་གྱི་གཤེགས་པ་རྣམས་ཀྱིས་བསྔགས་མོད་ཀྱི།",
    "འགྲོ་ལ་ཕན་ཕྱིར་བདག་གིས་རྒྱལ་སྲིད་སྒྲུབ།",
    "ངག་གི་ལས་རྫུན་དོར་བས་ལྷག་མ་ཕམ།",
    "བར་མ་རབ་བྱུང་གི་དུས་སུ་བླང་བ་ལས་འདསཔའིལྕོགས་པ་མཐུན་ནོ།",
    "རྒོད་བག་གིས་རང་གར་དག་ནས་གླུ་ལེན་ཅིང་ལུས་ཀྱིས་གར་བསྒྱུར་བ་རོལ་མཚོའི་རིགས་འབུད་ཅིང་དཀྲོལ་བ་སོགས་རྩེད་མོའི་རིགས་བྱེད་གསུམ་དང་།",
    "འཕྱོར་སྒེག་གི་རྣ་ཆ་གདུ་བུ་ལ་སོགས་རྒྱན་འདོགས་པ་དང་།",
    "རང་གླིང་གི་ཟླཉི་མ་ཕྱེད་ཡོལ་ཟིན་ནས་ཕྱི་དྲོའི་དུསསུ་ཁ་ས་ཟག་དད།",
    "གསོག་འཇོག་ཏུ་སོང་བ་ཟླ་བ་དང་།",
    "ཉམས་གསུམ་པ་འདི་བར་མ་རབ་བྱུང་གི་སྡོམ་པ་གཏོད་བྱེད་དགོས་དང་དགེ་ཚུལ་གྱི་བླངས་འདས་སོ།",
    "གཅིག་འགྲོ་ཆུར་རྐྱལ་སྐྱེས་རེག་ལྷན་གཅིག་འདུག།",
    "སྐྱེས་པའི་ལུས་ལ་རེག་པ་དང་།",
    "དེ་ཡང་མིཚངས་སྤྱོད་ལ་གཞན་གྱི་གཞི་ཡི་ཡན་ལག་འཁྲིག་པའི་ཚོར་བ་སྐྱེད་ནུས་པའི་ལུས་ཕྱེད་དུ་ཚམཛ་ཚ་སས་༧། འདས་པ་ཡན་ཆད་ཡནའ་ག་གི་ཆ་ཤས་ཀུན་བཟུང་བར་འོས་པའམ།",
    "གཞན་ངོར་ལྟོས་པའི་འཇིགས་པ་སྟེ་ཁྲེལ་འཛེམ་མེདཔར་རེག་བདེ་ཉམས་སུ་མྱོང་བར་འདོད་པའི་ཆུགས་སེམས་ཀྱིས།",
    "ལུས་ཀྱི་རྣམ་པ་རིག་བྱེད་ཀྱི་སྦྱོར་བས་དུས་གཅིག་ལ་བརྐུས་པ་མཐར་ཐུག་རང་གིས་བརྐུསསཱམགཞན་ལ་བསྐུར་བཅུག་པའམ།",
    "འདིལ་བརྐུ་རྫས་རིན་ཐང་གི་ཚད་ནིཀ་རི་ཀ་ལྔ་བཅུ་པ་ལས།",
    "༢་དམ་པ་བདག་གིས་འདི་ཉིད་ངེས་པར་བསད་པར་བྱའོ་སྙམ་པའི་གསོད་སེམས་ཀྱིས།",
    "དེར་མ་ཟད་དགེ་སློང་མང་པོས་གོས་བྱས་ནས་གཅིག་གིས་བསད་ཀྱང་ཐམས་ཅད་ལ་ཕམ་པ་འབྱུང་སྟེ།",
    "མཐར་ཐུག་གཞན་གྱིས་རང་གིས་སྨྲས་པའི་རྫུན་ངེས་འདུ་ཤེས་བསྒྱུར་མནུས་ཀྱང་དོན་གོ་བར་གྱུར་ན་དགེ་སློད་རང་གི་སྡོམ་པ་ཉམས་པ་ཡིན་ནོ།",
    "རང་གི་ངག་ཡིན་པ།",
    "ནང་གི་རྐྱེན་བསམ་པ་ཕུན་སུམཚོགས་པ་བླང་དོར་ལ་སྤྲོ་བའི་བརྩོན་འགྲུསའཇུག་ལྡོགགི་གནས་འབཟོད་པའིང་གི་ཡོད།",
    "ཆགས་པས་བུད་མེད་ལུས་ཀྱི་ཆ་ཤས་འཛིན།",
    "འཁྲིག་ཚིག་རྗེན་སྨྲ་བུད་མེད་ཆགས་ཕྱིར་བཀུར།",
    "བརྡ་འཕྲོད་པའི་བུད་མེད་བརྟེན་རུང་ལ་འཁྲིག་པ་སྤྱོད་པའི་དངོས་མིང་ཚིག་ཏུ་རྗེན་པར་སྨྲ་ཞིང་དེས་ཀྱང་དོན་གོ་བ་དང་།",
    "ཡུལ་བུད་མེད་འཆགས་པ་དོན་དུ་གཉེར་བའི་ཕྱིར་བདག་ལྟ་བུའི་དགེ་སློང་ལ་འཁྲིག་པ་སབསྙེན་བཀུར་ན་བསྙེན་བཀུར་ཐམས་ཅད་ལས་མཆོག་གོ་ཞེས་བསྔགས་པའམཾ་ཡུལ་གྱིས་སྨྲས་པདད་དུ་བླངས་ཀྱང་རུང་སྟེ་དེས་བརྡ་འཕྲོད་པ་དང་།",
    "ཞེང་དུ་ཁྲུ་ཕྱེད་དང་བཅུ་གཅིག་གི་ཚུད་ལས་ལྷག་པའི་ཁང་པ་རད་དམ་གཞན་ལ་བསྐོས་ངོས་བརྩིགས་ཀྱང་རུང་སྟེ་ཐོག་ཕུབ་ཟིན་པ་དང་།",
    "གླེང་བའི་སྙད་ཀ་བྱག་ཚུམ་ཡོད་པ་ལ་བརྟེན་ནས་ཡུལ་དགེ་སློང་གཞནཱ་ལཚིག་ཟུར་གྱིས་ཕམ་བཞི་གང་རུང་གི་སྒྲོནས་སྐུར་པ་བཏབ་པ་ཡུལ་གྱིས་གོ་བ་སྟེ་དེ་གཉིས་ནི་གནོད་པ་ལས་གྱུར་པའོ།",
    "རང་གི་གོས་ལྷག་ཞག་བཅུ་འདས་པར་འཆང་།",
    "ཁ་སྐོངགི་རེ་བ་དང་བཅས་པ་ན་འཁོར་གསུམ་ཁེབས་པ་ཡན་གྱིགེས་ལྷག་བྱིན་གྱིས་མ་བརླབས་པར་རང་སྟོབས་སམ་ཤན་སྟོབས་ཀྱིས་ཞག་བཅུ་འདས་པར་འཆུང་ན་འཆད་པའི་སྤང་ལྟུང་དང་།",
    "ཕྱི་མའ་ཞུགས་པས་ཞག་བཅུ་འདུས་ཏེ་བཅུ་གཅིག་པའི་སྐྱ་རེངས་ཤར་བ་ན་གོས་སྔ་མས་རང་སྟོབས་དང་།",
    "འོག་ཏུ་ཡོས་འཆད་པའི་ཟླ་འཕྲོག་གི་གོས་དེས་ཟླ་གཅིག་མ་འདས་པ་ར་སྤང་ལྟུང་མི་བསྐྱེད་ཀྱང་།",
    "དཞག་བཅུ་འདས་པ་ན་ཟླ་འཇོག་གིས་རང་སྟོབས་དང་ཕྱིའན་ཤན་སྟོབས་ཀྱིས་སྤང་ལྟུད་བསྐྱེད།",
    "པའི་སྐྱ་རེངས་ཤར་བ་ན་ཟླ་འབྲོག་གི་སྤང་བ་དང་།",
    "བདུན་བརྒྱུད་ཚུན་གྱི་ཉེ་དུ་མ་ཡིན་པའི་དགེ་སློང་མར་རང་གི་ཚེས་གོས་རྙིང་པ་འཁྲུར་འཇུག་པའི་སྤང་བ་དང་།",
    "གསེར་དངུལ་ལེན་དང་ཚོད་འདུན་མངོན་མཚན་ཅན།",
    "དགེ་སློང་རང་གི་ང་བཟེད་ཚད་ལྡན་བྱིན་གྱིས་མ་བརླབས་པའམ་བརླབས་ཀྱང་ཤན་སྟོབས་ཀྱིས་ཞག་བཅུ་འདུས་པར་འཆད་ནས་བཅུ་གཅིག་པའི་སྐྱ་རེངས་ཤར་བ་དང་།",
    "རྒྱུ་དབྱིབས་ཁ་དོག་གི་རུང་ཞིང་། མཐེ་བོའི་ལྟགང་གིས་ལྷག་མར་ཕུལ་དགུ་ཤོང་བ་ཡནཆད་ཀྱི་ལྷུང་བཟེད་ཡོད་བཞིན་དུ་ཉེ་མིན་ཁྱིམ་པ་ལ་ལྷུང་བཟེད་གཞན་བསླངས་པས་ཐོབན་དེ་དང་ཟུང་འཆུད་བྱ་ཡིན་ཅིང་།",
    "ཕུལརེ་རེ་ལ་ཁྱོར་ད་ཕྱེད་བཞི་རེ་ཡོད་དོ།",
    "བུད་མེད་ཚོས་སྟོན་པ་སེར་པ་ལ་ལྟོས་དང་།",
    "མི་ཚོས་བླུམའི་ཡན་ཏན་ཐོབ་པའི་དགེ་སློང་གིས་ཡུལ་བསྙེན་པར་མ་རྫོགས་པ་ལ་དགོས་པ་ཁྱད་པར་ཅནམེད་བཞིན་དུ་དེ་ཐོབ་བོ་ཞེས་བདེན་པར་སྨྲས་ཊྛཐཔ་ཡུལ་གྱིས་གཔ་དང་།",
    "ལས་ཕྱོགས་བཞི་ནས་མེས་རེག་ཙམ་བྱེད་པ་དང་།",
    "ངག་གིས་ཟིལ་གྱིས་གནོན་པ་དང་།",
    "གཙུག་ལག་ཁང་གི་སྟེང་ཐོག་སྙི་བ་ལམལ་ཁྲི་རྐང་པནོན་པས་བཙུག་ན་ལུས་ལྗིད་ཕབསྟེ་འདུག་པས་དུའུག་པ་དབྱུང་བ་དང་།",
    "དེ་ཡད་དགེ་སློང་མའི་སྟོན་པར་མ་བསྐོས་པའམ་བསྐོས་ཀྱང་མཚན་ཉིད་དང་མི་ལྡན་པའི་དགེ་སློང་གིས་དགེ་སློང་མ་འཚེས་སྟོན་ནས་གོ་བ་དང་།",
    "དེ་བཞིན་དགེ་སློང་མ་དང་ལྷན་ཅིག་གྲུར་ཞུགས་ནས་རྒྱུ་དེ་ཉིད་ཐད་ཀར་མི་འགྲོ་བར་གྱེན་དང་མཐུར་དུ་འགྱེན་སྔར་བཞིན་རྒྱངསཾ་གྲགས་རེ་རེ་འདས་པ་དང་།",
    "ཕྱིན་པ་བཅས་མ་ཡིན་ཞིང་ས་བརྐྱང་མ་བཏིང་བའི་དགེ་སློང་གིས་ཁྱིམ་པ་ཁྱེདུ་མ་ཡིན་པ།",
    "ཉེ་མིན་ཁྱིམ་པས་ཅི་བདེར་སྟོབ་པ་མ་ཡིནཔར་དུས་རུང་གི་ཟསུ་ཆེ་ཚད་ལྷུང་བཟེད་གང་༧ ངམ།",
    "གི་ཟས་ཟོས་ཏེ་བློས་བཅད་ཅིད་ངག་ཏུ་བརྗོད་ནས་དེའི་རྗེས་སུ་བཟའ་བསྩའ་གང་རུང་ལྷག་པ་མ་བྱས་པར་སྔར་གྱི་བཟའ་བཅའ་གང་རུང་ཟླ་བ་དང་།",
    "རང་གིས་རེག་པ་དང་།",
    "དེ་འདྲའི་དངོས་པོ་རྗེནཔར་མཚམས་ཀྱི་ཕྱི་ནང་གང་རུང་དུ་དགེ་སློང་གིས་བཙོས་པའོ།",
    "ཕྱོགས་དང་འདྲིལ་དང་རེག་པ་དང་།",
    "བསྔོས་དང་དགེ་སློང་གི་མིན་གྱུར་དང་།",
    "རྒྱལ་པོས་བོས་པ་སོགས་རྐྱེན་དང་དགོས་པ་མེད་པར་དགེ་སློང་གིས་རང་གི་གནས་ཀྱི་ཉེ་འཁོར་ལས་འདས་ཏེ་དམག་གི་དཔུང་བ་བལྟ་བར་ཕྱིན་པས་མཛྷོད་བ་དང་།",
    "རྐྱེན་དང་དགོས་པམེད་པར་དམག་གི་དཔུང་ཡོད་པའི་སར་ཞག་གཅིག་གམགཉིས་ལས་ལྷག་པར་བསྒྱུད་པ་དང་།",
    "གལ་ཏེ་རྐྱེན་དགོས་ཀྱིས་དམག་གི་ནང་དུ་སྡོད་དགོས་བྱུང་ཡོད་རང་དགར་གོམཚོན་ལ་རེག་པ་དང་།",
    "དམག་དཔུང་གི་རུ་བཤམས་བཀོད་སོགས་བྱེད་པ་དང་།",
    "རིན་ཆེན་དམག་ཆས་རོལ་མོའི་ཆསལ་རེག།",
    "དགེ་སློང་གཞན་ལ་ཁྱིམ་པས་དུས་རུང་གི་བུས་འདྲེན་པན་ངན་སེམས་ཀྱིས་དེ་འགོག་པའི་ཚིག་སྨྲས་ནས་གཙེད་དུ་བཅུག་པ་ཁྱིམ་པས་གོ་བ་དང་།",
    "རྒོདཁག་གི་བསམ་པས་མ་རེག་ལས་ཀ་ས་ལྡན་གྱི་བྱ་བའི་ཆེད་དུ་གནང་བ་ཡིན་སྙམ་པས་དུས་དྲན་བསྟེན་དགོས།",
    "གཞི་མེད་སྐུར་བཏབ་བུད་མེད་ལྷན་ཅིག་ཏུ།",
    "དགེ་སློང་གཞན་༨་སྔར་རང་གིས་གོས་བྱིན་པ་རྐུ་སེམས་དང་ཡིད་བཅུག་མིན་པར་དེསགནང་པའི་གདེངས་མེད་བཞིན་སླར་བླངས་ནས་ཅི་ངགར་ངོས་སྤྱོད་པ་བྱུང་།",
    "མཐོང་བྱེད་དགོས་གསུམ་གྱི་བཞི་མེད་པའི་དགེ་སློང་གཞན་ལ་ལྷག་མ་བཅུ་གསུམ་གང་རུང་གིས་སྐུར་པ་བཏབ་པ་དེས་གོ་བ་དང་།",
    "གལ་ཏེ་བསྐོལ་བས་ཆདགི་རོ་ནུས་ཉམས་པར་བྱས་པ་དང་།",
    "རྒྱལ་། པོ་བཙུན་མོར་རྩེ་བའི་ཁབ་ཏུལ།",
    "འདས་པར་སླེབས་པའམ་ཉིན་མ་ཕྱིན་ནས་མཚན་མོ་ཉལ་བ་དང་།",
    "ལྡངནིདགེསྨྱུང་གིས་ཁྲིའམཁྲིའུའི་རྐང་པ་ཁྲུ་གང་གི་ཚད་ལས་ལྷག་པར་བཟོས་བའམ་འབྲོར་བཅུག་སྟེ་བཟོས་ཟིན་པ་དང་།",
    "གཞན་གྱི་ཁྱིམ་དུ་སྟན་ལ་ཁྱིམ་བདག་གིས་མ་བསྒོས་པར་འདུག་པ་དང་།",
    "ཧོརའདུག་གི་རྣམ་པས་ཁྲི་འོག་ཏུ་རྐང་པ་དགུག་ནས་འདུག་པ་དང་།",
    "ལྷུང་བཟེད་ལ་ཡོད་གཏད་དེ་མི་ལེན་པར་ཟུར་སྨུག་གིས་བལྟ་བ་དང་།",
    "རི་གཟར་པོ་རལ་བར་གཞོལ་བ་བུད་རིམ་ཅན་ཏེ་དེ་བཉྩིར་མི་བཞག་པ་དང་།",
    "ཁྱོགས་དང་བཞོན་མཚིལྷམ་གྱོན་པ་དང་།",
    "ཁྱོགས་ཀྱིས་བཏེགས་པ་དང་།",
    "སྨྱན་བྱས་པ་གཞི་མེད་ནས་བཀའ་བློམི་བདེ་བའི་བར་ཐུན་མོང་བ་བདུན་དང་།",
    "ཤེས་བཞིན་རྫུནསྨྲ་སོགས་ཐུན་མོང་བ་བདུན་ཅུ་རྩ་གཉིས་དང་།",
    "བསླབ་པ་བྲལ་ཏེ་ཁྱིམདུ་འཇུག་པ་ཐུནམོང་བ་གཅིག་དང་།",
    "ཞེ་སྡང་གི་གཉེན་པོར་ངམ།་",
    "ཉོན་མོངས་པ་དང་རྣམ་རྟོག་ཞི་བར་བྱེད།",
    "སྤྱིར་གསོ་སྦྱོང་གི་ཚུལ་ཇི་ལྟར་བྱ་བ་ལ།",
    "གསོལ་བའི་ལས་ཀྱི་ཚེ་ན་ད་རང་གི་དུས་བརྗོད་དགོས་པའི་ཁྱད་པར་ཙམ་མ་གཏོགས་གཞན་ཆོ་ག་ཐམས་ཅད་དུས་ངེས་པའི་གསོ་སྦྱོང་དང་འདྲའོ།",
    "༢པན་ཚུན་གཅིག་གི་མདུན་དུ་གཅིག་འདུག་ནས་བྱིན་གྱིས་བརླབ་ཅིང་།",
    "དེའི་ཕྱི་ཉིན་ཚེས་བཅུ་དྲུག་གནང་པར་གནས་སྟེང་གཡོགས་དང་བཅས་པ་དགེ་སློང་གི་མདུན་དུ་སྔགས་ལན་གསུམ་བརྗོད་པས་ཁས་བླང་ངོ།",
    "འཚོ་བའི་ཡོ་བྱད་གང་རུང་གི་དབྱིབས་སུ་མ་གྲུབ་པའི་གོས་ཁྲུ་གང་ཡན་ཆད་རང་བཞན་གཉིས་ཀའི་མིང་གིས་བྱིན་གྱིསབརླབ་ནས་བཅད་རུང་བ་སྟེ།",
