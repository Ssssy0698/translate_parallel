    "བསླབ་པ་ལས་ཁྱིམ་པར་འབྲེབསཾ་པ་སྐྱོགས་གང་རུང་རེ་རེ་འམ་མང་དུ་བྱས་སམ་བྱེད་དུ་བཅུགན་རྩ་ལྟུང་གསུམ་པ་དགེ་སྦྱོང་ཆད་པས་གཅོད་པ་དང་།",
    "དེ་རྣམས་གང་ཡདེ་རུང་བ་ཀུན་སློང་ཞེ་སྡང་གིས་མེ་ལ་སོགས་པས་འདོམས་པར་བྱེད་པ་སྟེ།",
    "ཐེག་ཆེན་གྱི་ལམ་དུ་ཞུགས་པར་དེར་ཤེས་བཞིན་དུ་ཁྱོད་ཀྱིས་རྒྱུ་ཕྱིན་དྲུག་ལ་སྤྱོད་པ་འདིས་འབྲས་བུ་རྫོགས་བྱང་ཐོབ་པར་མི་ནུས་ཞེས་ཕྱིར་ལྡོག་པར་བྱས་ནས།",
    "ཉོན་མོངས་པ་དང་གཞན་མཐུན་པས།",
    "གཉིས་དང་ཡན་ལག་གི་ཉེས་བྱས་གཞན་དུ་ཞལ་འཕང་བ་ནི།",
    "དེ་ལྟར་བཞི་བཅུ་རེ་རེ་འ་འང་།",
    "དེ་ལས་ལྡོག་པ་འོད་སྲུང་གི་ཞུས་པལས།",
    "ཁྲོ་བས་གཞན་འཚེ་ཤད་སྦྱང་གིས་མི་བཟློག།",
    "བཀྲེན་པ་དང་། མགོན་མེད་པའི་སློང་བ་པོ་ལ་ཁ་ཟས་སོགས་རྒྱུད་བྲིད་ཅུད་ཟད་ཙམ་མམ་ཉན་འདོད་ཀྱི་གང་ཟག་སྣོད་དུ་གྱུར་ཅིང་བྱང་སེམས་རང་ལ་ནུས་པ་ཡོད་ཞོན་དེ་གཉིས་ལ་ནོར་དྭང་ཚོས་མི་སྟེར་བ་ལ་དང་།",
    "ཁྲོ་བ་དྲག་པས་ཀུན་ནས་བསླངས་ཏེ་ཚིག་རྩུབ་སྨྲས་པ་ཙམ་གྱིས་མཚིམ་པར་གཞན་ལ་བརྡེག་བག་སོགས་འཚོ་བར་བྱེདཅིང་ཤད་སྦྱོང་གིས་ཀྱང་མི་བཟློག་པར་འཁོན་དུ་འཛིན་པ་དང་།",
    "དེ་ཡང་ཀུན་སློང་གི་སྒོ་ནས་བཞི་དང་།",
    "མགྲོན་བོས་བདག་གིར་མི་བྱེད་ཅིང་།",
    "ལ་ལས་ཉེས་པ་བྱུངནནི་ཉོན་མོངས་པ་ཅན་གྱི་ཉེས་པ་ལ་འགྱུར་རོ།",
    "གལ་ཏེ་བརྗེད་པས་ཉེས་པ་བྱུངཞནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་ཉེས་པར་འགྱུར་ལ།",
    "རབ་བྱུང་མིན་ཀྱང་རང་སའི་རྩ་ལྟུང་གི་ཕྱོགས་དང་མཐུན་པའི་ཉེས་པ་ཕྲུ་རྣམས་ཉེས་བྱས་སུ་འགྱུར་བས་སོ།",
    "དཀའ་བའི་གཏོང་བ་ལ་རང་གི་མགོ་དང་རྐང་ལག་སོགས་གཏོང་བའོ།",
    "བསམ་པ་མ་དག་ན་རང་གི་ལུས་སྦྱིན་པ་རྣམས་མི་བྱའོ།",
    "མཐར་ཐུག་འབར་བ་དང་ངན་སོང་གི་འཇིགས་པ་ལས་སྐྱོབས་པའོ།",
    "བདག་དང་བདག་གི་ཡིད་དུ་འོང་བའི་གྲོགས་ལ་གཞན་གྱིས་བརྡེག་གཤེ་བྱེ་བམཚང་འབྲུ་བ་སོགས་མི་འདོད་པར་བྱེད་པ་དང་།",
    "ཕུག་གི་བདེ་བ་བླ་ན་མེད་པའི་དོན་དུ་འཕྲལགྱི་སྡུག་བསྔལ་དམཚོས་སྒྲུབ་པའི་དཀའ་སྤྱད་སོགས་ཀྱིས་མི་སྐྱོབས་དང་དུ་བླང་ནས་བབྦོད་པར་བྱུ་བའོ།",
    "ཐོས་བསམ་སྒོམཔའི་ཤེས་རབ་ཟབ་མོ་སྤྱད།",
    "འཕགས་མཆོག་གིས་ཀྱངཛམས་ཅད་མཁྱེན་ཉིད་མི་འགྱུར་ཏེ།",
    "དེནས་བསམ་བྱུང་གི་ཤེས་རབ་བསྐྱེད་པ་ནི།",
    "སནང་དུ་སེམས་པར་འཇུག་པ་ན་བྱེ་བྲག་འབྱེད་པའི་བསམ་ཤེས་ཀྱི་དོན་སྤྱི་ཙམ་དུ་མ་ལུས་པར་རེ་རེ་ནས་ཚིག་དང་དོན་གྱི་རིམ་པ་རྣམས་ནོར་མནོར་བརྟག་ཅིང་དེས་པར་བྱ་སྟེ།",
    "ཁྱད་པར་ལྷག་མཐོང་གི་ཤེས་རབ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཉམས་སུ་ཁྱདང་སྔགས་ཀྱི་རྒྱུ་ལྕེ་ཐམས་ཅད་བཅད་ནས་འཇོག་པར་བྱ་བ་སྟེ།",
    "རྗེས་བསྔོ་བ་སྟེ་ལ་དམཔ་གསུམགྱིས་རྩིས་ཟིན་པའི་སྒོ་ནས་སྤྱད་པར་བྱ་བ་སྟེ་ཤེས་རབ་རྣམ་པ་གསུམམོ།",
    "སྦྱིན་པའི་གཡབ་མོས་ལེགས་བོས་ཏེ།",
    "སྙན་པར་སྨྲ་བའི་ཚིག་གིས་བསུ།",
    "དེ་ལྟར་དཀྲི་བའི་ལ་གདུལ་བྱ་དེ་དག་གི་དོན་ཡང་ཉམས་སུ་ལེན་པའི་སྒྲོནུས་འདྲེན་དགོས་པའི་ཕྱིར་རང་ཡད་དོན་དེ་དག་ལ་མཐུན་པར་སྤྱོད་དགོས་ཏེ།",
    "བྱ་བ་གང་དང་གང་བྱེད་པ་ཐམས་ཅད་དེ་དང་དེའི་རིགས་མཐུན་པར་ཚིག་གི་སྔའགྱུར་བའམ་བ་ལསྒོནས་ཀྱང་སྨོན་འམ་འདེབས་པར་བྱའོ།",
    "རང་གི་བཞེད་པ་འགོད་པ།",
    "གཉིས་པ་རང་གི་བཞེད་པ་འགོད་པ་ནི།",
    "འཕགས་པ་ཐོགས་མེད་ཀྱི་ལུགས་ལྟར་ན་འཇུག་སྡོམ་མ་ཐོབ་པ་ཐོབ་པར་བྱེད་པ་དེའི་རྟེན་གླིང་གསུམགྱི་སྐྱེས་པ་བུད་མེད་མཚན་དོན་བྱེད་ནུས་པ་ཞིག་དགོས་ཏེ།",
    "གངགི་རིགས་དང་མི་རིགས་མ་བརྟགས་པར།",
    "གང་ཟག་གང་གི་དགག་སྒྲུབ་ཀྱི་གནས་ལ་བློ་ནུས་ཅི་ཡོད་ཀྱིས་བརྩམ་པར་རིགས་པ་དང་མི་རིགས་པ་གང་ཡིན་ཐོགམར་བརྟགས་དགོས་པ།",
    "འཇུག་ལྡོག་གི་གནས་ལ་བཏང་སྙོམས་སུ་འཇུག་ཀྱང་རུདྨ་སྟེ།",
    "བུད་མེད་འདོད་པས་གདུང་སྟེ་འཆི་བར་ཉེ་བ་ལ་གནས་སྐབས་དེའི་གདུང་བ་སེལ་ཕྱིར་དང་།",
    "དདཾཐགཉེསཞི་དེ་མ་ཐག་ཏུ་སྡོམ་པ་རྩད་ནསམེད་པར་འགྱུར་བའི་རྒྱུ་དང་རྐྱེན་ཡིན་པའི་ཕྱིར་བཤགས་པ་ཙམ་གྱིས་མི་ཆོག་གིས་སྡོམ་པ་སླར་བླང་དགོས་ལ།",
    "གྲངས་ངེས་པ་ནི་མེད་པ་བཅས་རང་གི་ཁ་ན་མ་ཐོ་བ་སྤྱི་དང་བྱེ་བྲག་ཁྱདསེམས་ཀྱི་བསླབ་པ་ཐམས་ཅད་ལ་སྐྱོན་བྱུང་བའི་གཉེན་པོར་ཡོད་མཆོག་ཏུ་ཟབ་པ་གལ་ཆེ་བ་ཡིན་ཏེ་དེ་རྣམས་ནི་སྒྱུ་ཀྱི་གྲུས་ཡིན་ནོ།",
    "ཀུན་དཀྲིས་འབྲིང་གིས་བསྐྱེད་པའི་མ་འདྲ་རྣམས་ནི་གསུམ་ཡན་ཆད་དང་།",
    "དེ་ཡང་མཐར་ཐུག་གི་འབྲས་བུ་ཐོབ་ཚུལ་ལ།",
    "ཚོགས་སྦྱོར་གཉིས་སུ་གཉིས་རེ།",
    "ཟིགས་པ་ན་ཐག་རིང་བས་ཆ་མ་ཕྱེད་དེ།",
    "དེ་ཉིད་དུ་ཟུང་འཇུག་གི་སྐུ་འགྲུབ་སྟེ།",
    "མིའི་རིག་འཛིན་འཙ་བཱི་དྲི་མ་མེད་པར་གྲགས་པ་སྟེ་དྭམ་ལྔ་པོ་ལངྐའི་ཡུལ་གྱི་རི་མ་ལ་ཡའི་རྩེར་རང་རང་གི་མངོན་ཤེས་དང་རྫུ་འཕྲུལ་གྱིས་འདུས་ཏེ་གདུང་ཚིག་ཉེར་གསུམ་ཟློ།",
    "གསད་བདགམངོན་སུམ་དུ་བྱོན་ནས་རིགས་ཅན་དྲ་མ་ལྔ་སོགས་རིག་འཛིན་འདུས་པ་ཕལ་མོ་ཆེ་སྟོན་འོག་མིན་དད་ངག་ཤད།",
    "ཡིག་རྣམས་མེ་རི་འབར་བའི་རྩེ་མོར།",
    "ཨ་ནུ་ཡོ་ག་རྣམས་ལངྐའི་ཡུལ་དུ་གྲགས་པ་སིངྒ་ལའི་གླིང་གི་ནགས་ཚལ་དུ་བབས་པ་ནས་རྒྱ་བལ་བྲུ་ཤའི་ཨཡུལ་རྣམས་ལ་རིམ་གྱིས་དར་བའས།",
    "ཕྱིས་སུ་ཡུལ་དེ་དག་གི་ལོ་པཎའ་ས་གནུབས་ཆེན་གྱིས་གསན་ཏེ་བོད་དུ་དར་རོ།",
    "ཆེ་མཆོག་གི་བསེ་སྒྲོམ་བི་མ་ལ།",
    "མམོའི་བསེ་སྒྲོམ་དྷ་ན་སཾསྐྲྀ་ཏ།",
    "གང་ལ་ཐུག་གི་བར་དུའོ།",
    "གཉིས་ཀའི་ཐུན་མོང་གི་བརྒྱུད་ཁུངས་རྒྱལ་བ་དགོངས་བརྒྱུད།",
    "ཕྱི་འགྱུར་གསར་མ་པའི་བཞེད་སྲོལ་ལ་ཨོ་རྒྱན་གྱི་རྒྱལ་པོ་ཨིནྡྲ་བྷུ་ཏིས་རྒྱུད་རྣམས་གླེགས་བམ་དུ་བྱས་ཤིད་ཡུལ་དེའི་སྐྱེ་བོ་ཐམས་ཅད་ལ་བསྟན་པས་ཡུལ་དེའི་སྲོགཆགས་ཕྲ་མོ་ཡན་ཆད་ཀྱིས་དངོས་འབྲུ་བརྒྱཚེ་ཀྱིས་ངགཉིས།",
    "གྲུབ་ཐོབ་སྟེ་འཇའ་ལུས་སུ་སོང་།",
    "ཐེག་ཆེན་ལ་མོས་པ།",
    "རང་གི་ལྷ་དུས་དུས་སུ་མཆེད་པ།",
    "རང་གི་སྔགས་རྒྱུད་སྲུང་ཞིང་དེའི་དོན་རྟོགས་པར་བྱེད་པ་རྣམས་ཏེ།",
    "དེའི་ཡན་ལག་སྦོམ་པོའི་བརྒྱད་དང་ནི་རྫོགས་པ་ཆེན་པོའི་སྲོལ་གྱི་རྩ་བ་དང་ཡན་ལག་གི་དམ་ཚིག་རྣམས་ཏེ་རིམ་འ་བཞིན་འཆད་པར་འགྱུར་རོ།",
    "པ་ན་ས་བབ་སོས་ས་པ་ན་མོ་ཝ་ཚེ་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ཉམས་སུ་མྱོང་བ་ནི་བཞི་པའི་རྒྱུད་ཡིན་ལ།",
    "དེ་ལ་ཡང་ཚིག་ཙམ་གྱིས་ཡེ་ཤེས་ངོ་སྤྲོད་པ་ཚིག་གི་དང་།",
    "བདེ་བ་ཆེན་པོའི་ཡེ་ཤེསམཱཆོག་གི་ཏིང་ངེ་འཛིན་རྒྱུད་ལ་སྐྱེས་པ་དོན་གྱི་དང་།",
    "སྙོམས་འཇུག་གི་གནས་སྐབས་བདེ་བའི་ངང་དུ་རྟོག་ཚོགས་ཐམས་ཅད་འགག་པ་སྟེ།",
    "སྟེག་ཤུགམར་སྔགས་ཀྱི་བསླབ་པ་ཐམས་ཅད་ཀྱི་རྟེན་གཞི་རྡོ་རྗེ་སེམས་དཔའི་དམཚིག་གི་ཡན་ལག་བརྟུལ་ཞུགས་ཉེར་ལྔ་པ་དཔལ་ལྡན་དུས་ཀྱི་འཁོར་འལས་གསུངས་པ་ལྟར་ཤེས་པར་བྱའོ།",
    "རང་གིས་བསད་པའི་ཤ་མ་གཏོགས་ལས་ཀྱིས་ཤི་བའི་ཤ་སྔ་འགྱུར་བཀའམ་ར་དགུ་འ",
    "བ་ལང་བྱིས་པ་སྐྱེས་པ་བུདམེད་དང་།",
    "གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱ་ཡུལ་ལྔ་ལ།",
    "དེ་ཡང་གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱ་སྟེ་ཡུལ་ལྗཔ་དེལྟ།",
    "མིག་དང་རྣ་བ་དང་སྣ་དང་ལྕེ་དང་ལུས་ཀྱི་དབུད་པ་སྟེ་ཡུལ་ཅན་དེ་ལ་བརྟེན་པའི་ཤེས་པ་ལྕས་ཞེན་ཅིང་ཆགས་པར་མི་བྱེད་དེ།",
    "ཐུནམོང་གྱུར་པ་རིགས་ལྔའི་སྡོམ་པ་ལྔ།",
    "དེ་ལ་རིགས་བྱེ་བྲག་གི་རྣལ་འབྱོར་བས་ཀྱང་རིགས་ལྡཀའི་སྡོམ་པ་བསྲུང་དགོས་མོད་ཀྱང་།",
    "སྦས་དོན་ལྟར་ན་ནང་གི་རྡོར་དྲིལ་ནཱི།",
    "གསང་བ་ཁམས་དཀར་དམར་གཉིས་འབར་འཛག་གིས་ཟུང་དུ་འཇུག་པ་དང་།",
    "དེའི་རྩ་བ་བྱམས་པ་ཆེན་པོའི་སྦྱིན་པ་བཞིང་ཉིན་རེ་བཞིན་དུས་དྲུག་ཏུ་བྱ་བ་དང་།",
    "མི་འཇིགས་པ་སྦས་དོན་ལྟར་ན་རྗེས་ཆགས་ཀྱི་མེས་བྱང་སེམས་དབབ་ལྡོག་གི་དགའ་བཞིའི་མཀན་འཆམ་ན།",
    "གང་གིས་ཀྱང་ནི་སྦྱིནམ་ལགས།",
    "གསུམ་པ་འདོདཆགསརྣམ་པར་དག་པ་པདྨའི་རིགས་ཀྱི་དམ་ཚིག་ལ་རྟོགས་གོམས་ཀྱི་གདིང་དང་ལྡན་པའི་གང་ཟག་གིས་ས་གཉིས་མེད་དུ་ཤེས་པའི་ལྟ་བ་དང་།",
    "དྲང་དོན་དུ་སྐྱོབ་པའི་སྐྱོན་མེདན་རྩྭད་བཏུང་བ་དད་རིགས་ཀྱིས་དྲེགས་ཤིང་ང་རྒྱལ་དང་གཙང་བློའི་རྟོག་པ་གཞིག་པའི་སླད་དུ་ཡུལ་དབུས་སུ་བཟུའ་བའི་དོན་དུ་གསོད་པར་མི་བྱེད་པའི་ཤལྟ་གནང་བ་ལྟར་རང་གི་ལས་ཀྱིས་ཤི་བའི་ཤརྣམས་དམཚིག་གི་རྫས་སུ་བཟའ་བ་དང་།",
    "ཕྱག་དྲུག་གི་བསམ་པས་སྦྱོར་བ་ལུས་ངག་གིས་བར་པ་དང་།",
    "ངག་གི་ཚིག་རྩུབ་སྐྱོན་བརྗོད་པ་སོགས་ཨ་དེའི་སེམས་སུན་ཕྱུང་ན་ལྟུང་གསུམ་པའོ།",
    "ཉམས་དང་ཟབ་མོས་འཇིགས་ལྔར་གསང་སྒྲོག་བདུན།",
    "དེས་བརྟེན་པ་ཡེ་ཤེས་མངོན་དུ་འགྱུར་བ་ཡིན་པ་དེ་མི་ཤེས་པ་ཀུན་འབྱུང་གི་གཙོ་བོར་བཟུང་སྟེ་ངག་གིས་བརྙས་པ་ཡིས་སྨོད་པ་དང་ཡན་ལག་གཅོད་པ་སོགས་དང་།",
    "སྡུག་བསྔལ་དངོསལ་སྤྱོད་པ་ངན་སོང་གསུམ་གཅིག་ཏུ་བསྡོམས་པས་བཅུ་སྟེ།",
    "བྲོགར་གླུ་ཚིག་སོགས་དམ་ཚིག་གི་སྤྱོད་པ་དུས་ཚོད་དད་ས་བ།",
    "བུད་མེད་ཀྱི་རིགས་འདིའམ་གཡོ་སྒྱུ་ཆེའོ་ཞེས་པ་ལྟ་བུ་སྤྱི་ལ་ལྟོས་ནས་སྨོད་པ་དང་།",
    "སྦྱིན་སྲེག་གི་ལུས་སོགས་སྨྲ་བསམ་པས་འཇུག་པར་རྩོམ་ཞིང་སྦྱར་བས་དངོས་སུ་ལག་ལེན་ལ་ཞུགས་པ་དང་།",
    "སྡོམ་པ་འོག་མགོ་བྱང་གཉིས་ཐོབ་པའི་སྔགས་པས་ཆང་འཐུང་བ་དང་ཕྱི་དྲོའི་ཁ་ཟས་བཟའ་བ་སོགས་སོ་བྱད་གཉིས་ཀྱི་བཅས་པ་ལས་ཚོགས་འཁོར་དང་ནང་གི་སྦྱིན་སྲེག་ས་གོས་དགོས་པ་ཁྱད་པར་ཅན་མེད་བཞིན་དུ་འདའ་བར་བྱེད་པ་བ་ན་༢༩་པ་ས་ས།",
    "དེ་དབྱེན་སྐུ་གསུང་ཐུགས་གསུམ་རེ་རེ་ལ་ཕྱི་ནང་གསང་བ་གསུམཁ་གསུམ་དུ་ཕྱེ་བས་དགུ་དགུར་ཕྱེ་བ་ལས།",
    "རང་ལུས་ལ་བརྡེག་བཙོག་དང་དཀའ་ཐུབ་ཀྱིས་བརྙས་ཤིང་གདུང་བ་རྣམས་སྤང་བ་སྐུའི་ནང་གི་གསུམ་དང་།",
    "རྡོ་རྗེ་ཟླསྤྱནསྲིང་གི་ལུས་ལ་བརྡེག་གམ་བརྡེག་པར་གཟས་ཤིང་རྒྱན་ལ་སྨདང་།",
    "ཚིག་རྩུབ་སྨྲ་བ་རྣམས་སྤོང་བ་གསུང་གི་ཕྱིའི་གསུམ་དང་།",
    "རྡོ་རྗེ་སྤུན་སྲིང་གི་ཚིག།",
    "རང་གི་མ་རིག་རང་བཞིན་ཤེས་པས་སྐྱོ།",
    "ཉོན་མོངས་པ་ལྔ་ཡེ་ནས་རིགས་ལྔ་ཡེ་ཤེས་ལྔའི་རང་བཞིན་ཡིན་པས་ཀྱང་མི་སྤུང་སྟེ།",
    "གནམ་ལྕགས་ངུར་མོའི་མཚོནམི་རྡེག།",
    "ཞེས་བཟླས་བརྗོད་དང་ཆོག་མི་ཚིག་གིས་བར་མི་གཅོད་པ་དང་།",
    "གཙུག་གི་ནོར་བུ་སྨམི་དབབ།",
    "ཐུན་མོང་གི་དམཚིག་ཉི་ཤུ་རྩ་བརྒྱད།",
    "བཅུ་བཞི་པ་ཁྱད་པར་གྱི་རྩ་བའི་དམ་ཚིག་དེ་དག་གི་ཁོངས་སུ་འདུས་པས་འགལ་བ་མེད་དོ།",
    "ཉོན་མོངས་མད་དྭང་མ་གུས་དང་།",
    "ཕྱི་མ་གཉིས་ཀྱི་གཉེན་པོ་གནང་བཀག་གི་མཚམསམི་བརྗེད་པའི་དྲན་པ་དང་།",
    "ཆ་གཉིས་པ་ལྟུངབ་ལྕི་ཡང་གི་ལྡང་ཚད་ནི།",
    "ཡང་ན་ཀུན་སློང་ཉོན་མོངས་དྲག་པོས་བསྲུང་བ་དང་།",
    "ཕྱོགས་མཐུན་གྱི་ཉེས་པ་ཕྲ་མོ་རྣམས་ནི་ཉེས་བྱས་དང་འདྲའོ།",
    "གསང་སྔགས་བཟླ་དད་ཟབ་མོའི་བསམ་གཏན་དང་།",
    "ཐིག་ལེ་ཕྲ་མོའི་རྣལ་འབྱོར་བསྒོམས་པསགསོ།",
    "དེབཞིན་དུ་རྡོ་རྗེ་ཡང་ཏོག་གི་རྒྱུད་ལས།",
    "ཚོགས་འཁོར་རམ་དཔའ་བོ་དཔའམ་སྟན་མོས་མཆོད་ནས་དེ་རྣམས་སུ་ཞུ་ཞིང་བཤགས་པ་རྒྱུད།",
    "རང་གི་ལྷག་པའི་ལྷའི་གསད་སྡུག་བཟླ་བ་དང་།",
    "སྒྲུབ་མེའི་བསམ་གཏན་ཞི་ལྷག་གི་ཏིང་ངེ་འཛིན་བསྒོམས་པ་དང་།",
    "གླང་ཆེན་རབ་འབོག་རྒྱུད་ལས་གསུངས་པ་ཡི། རྣལ་འབྱོར་སྤྱི་ཁྲུས་འགྱོད་ཚངས་དོང་སྤྲུག་གི།",
    "དེ་ཙམ་མ་གྲུབ་ནའང་ཕྱུག་གི་བཀོལ་བྱང་ཙམ་རྒྱུན་དུ་ཡི་དམདུ་བགྱིས་ནས་བཤགས་པས་ཀྱང་ཉམས་ཆག་ཐམས་ཅད་མི་འདག་པ་མེད་པར་གསུངས་པའི་ཕྱིར་ན་ཅི་ནས་འབད་པས་ཉམས་སུ་བླངས་པར་བྱ་སྟེ།",
    "གང་གིས་སྒྱུ་འཕྲུལ་ཞི་ཁྲོ་ཡི།",
    "གང་གིས་དཀྱིལ་འཁོར་གྱི་ལྷ་དེ་རྣམས་ཀྱི་མཚན་རྣལ་འབྱོར་ཕ་མརྣམས་ཀྱིས་ཐོས་པ་ཙམ་གྱིས་རྩ་བ་དད་ཡོན་འགག་དམཚིག་ཉམས་ཆག་ཐམས་ཅད་སྐོངས་ཏེ།",
    "ཉི་ཟླ་ཤར་བ་སོགས་སྡིག་ལྟུང་དག་པའི་རྟགས་མ་བྱུང་གི་བར་དེ་སྲིད་དུ་སྟོབས་བཞི་ཚང་བའི་བཤགས་པ་ལ་འབད་པར་བྱ་ཞིང་།",
    "འབྲས་བུ་མེད་ཅིད་ངན་སོང་ལྟུང་།",
    "རྣལ་འབྱོར་ཉམས་གྱུར་གཅིག་གིས་ནི།",
    "གཞན་ཅི་ཟེར་བརྟག་པའམ་གཞན་གྱི་དོདགར་ཐལ་བའི་ཞོར་ལས་མཁས་གླུ་བརྒྱུད་གོ་མལཉམས་བྱུང་ཡང་དེ་མ་ཐག་མ་བཤགསན་ཉེས་པ་ཆེན་པོར་འགྱུར་ཏེ།",
    "དན་སྨྲས་ཚིག་གི་ཟུར་ཙམ་ཡང་།",
    "སྡུག་བསྔལ་ཆེ་ཆུང་དང་མོན་ཡུན་རིང་ཐུང་གི་ཁྱད་པའོ།",
    "མཆོག་གི་དངོས་གྲུབ་ཁ་སྦྱོར་བདུན་ལྡན་ཐོབ།",
    "བྱས་ཏེ་མི་སློབ་པའི་ཟུང་འཇུགགི་སྐུར་ལྡང་ཞིང་།",
    "ཐུན་མོང་ཞེས་པའི་དོན་ནི་ཡོན་ཏན་འདི་དག་ཕྱི་རོལ་པ་ལའང་ཡོད་པས་འཇིག་རྟེན་པ་དང་འདས་ལམ་གཉིས་ཀའི་ཐུན་མོང་བ་དང་བསྐྱེད་རྫོགས་གཉིས་ཀའི་ཐུན་མོང་གི་ཡོན་ཏན་ཡིན་པས་ཀྱང་དེ་སྐད་ཅེས་བྱའོ།",
    "མཆོག་གི་དངོས་གྲུབ་ནི།",
    "གང་ཟག་གཅིག་གི་རྒྱུད།",
    "གང་གིས་ལེན་པའི་བསམ་པ།",
    "དེ་བགནས་འགྱུར་ཡང་རང་རང་གི་ལྡོག་པ་ལ་གཞིམཐུན་པ་མི་སྲིད་པས་མ་འདྲེས་པར་ཡོད་པ་ཡིན་ཏེ།",
    "དགག་བྱ་ཉོན་མོངས་དགོས་པ་མི་འཆིང་བར།",
    "ཉོན་མོངས་རང་མཚན་སྤྱོད་བར་མཁས་རྣམས་མཐུན།",
    "སྡོམ་པ་གསུམ་ཀས་དགག་བྱ་རང་རྒྱུད་ཀྱི་ཉོན་མོངས་པ་དང་།",
    "ཉན་ཐོས་པས་བདེན་གཉིས་རྫས་ཡོད་དུ་བལྟས་ནས་སོ་ཐར་གྱིས་ཉོན་མོངས་པ་སྤོང་བ་དང་།",
    "སྡུགས་ཀྱིས་བཏབ་སྟེ་བཟའ་བ་གསུམ་ཀླས་ཀྱང་དུག་གིས་མིག་ནོད་པའི་དགོས་པ་སྒྲུབ་པར་གཅིག་པ་བཞིན་ནོ།",
    "འབུམ་ཕྲག་ལྔ་པའི་ལུང་གིས་གསལ་བར་གྲུབ།",
    "གཞན་ཕན་གཞིར་བཅས་སྒྲུབ་པའི་སེམས་པ་གཉིས་སྔགས་སྡོམ་གྱི་ངོ་བོར་གནས་འགྱུར་བ་ཡིན་ནོ་ཞེས་འབུམ་ཕྲག་ལྔ་པའི་ལུང་གིས་གསལ་བུར་གྲུབ་སྟེ།",
    "སྡོམ་པའི་དེ་བཞིརིགས་ལྔ་སྤྱིའི་རྣམ་སྣང་གི་དམ་ཚིག་ཏུ་གནས་འགྱུར་བས་ཐ་དད་པ་མེད་དོ།",
    "གྲྭ་སྔའགྱུར་བཀའ་མ་བསཧེ་ཅན་ནསས་ཀ་ཀ་ཀ་ན་མཐར་ཐུག་ཐིག་ལེ་འཕོས་པས་བདེ་བའི་སིམ་པ་བདག་གིར་བྱེད་པ་དེ་ཆགས་པའི་རོ་ཡེ་ཤེས་སུ་བསྒྱུར་ཞིང་ཐིག་ལེ་འཇིག་མེད་དུ་འཆིང་བའི་ཕྱིར་མཐུར་ཐུག་གི་ཡན་ལག་མཚུར་བྱས་ན།",
    "སྡིག་ཏོ་མེ་དགེའི་ཕྱོགས་དང་ཚོགས་པའི་གསེབ།",
    "ནང་ལྟར་བ་གསང་སྔགས་ཐུན་མོང་ལུགས་སུ་སྤྱད།",
    "སྡོམ་པ་གསུམ་གནངམ་འདོགས་པ་སྟེ་མཐུན་པར་གྱུར་ན་གཞན་མི་དད་པར་གྱུར་པའི་ཆ་ལ་སོགསང་སྤང་བླང་གི་གནས་ཐམས་ཅད་ས་སོར་མ་འདྲེས་པར་ཡོངས་སུ་རྫོགས་པར་བསྲུང་བར་བྱ་ཞིང་།",
    "གཅིག་གི་ངསུང་བྱར་སོང་ནས་འགའ་བར་གྱུར་ན་རད་རྒྱུད་ཀྱི་དགག་བྱ་ཉོན་མོངས་པའི་གཉེན་པོར་འགྲོ་བ་དང་།",
    "དེ་ཡང་སྔགས་སམ་ཏིང་འཛིན་གྱིས་ཆད་གི་རོ་བསྒྱུར་བ་དང་།",
    "བརྟན་པ་ཐོབ་ནས་བློན་འབར་བའི་རིམ་པ་ལྟར་བསྐྱེད་རྫོགས་ཀྱི་རྣལ་འབྱོར་ལ་གནས་པའི་སྒོནས་དམ་རྫས་ཁྱད་པར་ཅན་བརྟེན་པ་གྲྭ་འགྱུར་བའམ་ས་རྒྱསོགས་སྔགས་ནང་རྒྱུད་ཀྱི་སྤྱོད་པ་ཐུན་མོང་བ་དང་།",
    "གངས་ཅན་འདིན་དེ་དག་ཕྱོགས་རེར་འཛིན།",
    "ཆུ་ཙམ་ལ་འབའ་ཞིག་གིས།",
    "ཐང་མར་བརྡལ་འདི་ཁྲི་སྲོང་ཁྱོད་མིན་སུ།",
    "ཁྱོད་ཀྱི་ལམ་བཟང་བྱི་དོར་ཅུད་བགྱིས་པ།",
    "ཚུལ་འདིར་འཆད་ཉན་སྒོམ་སྒྲུབ་ཟབ་མོའི་སྲོག།",
    "འཇིག་རྟེན་ཕན་བདེར་སྤྱོད་པའི་སྐལ་བཟང་གིས།",
    "སྐབས་རེར་འབྲུ་གཉེར་མ་ཐུབ་པ་སོགས་ཁོངས་སྙོམས་པ་ཞིག་བྱུང་མི་འདུག་ཅིང་།",
    "ཕྱིས་སུ་རང་ལྟོས་སློབཚོགས་བླ་སྤྲུལ་ཁ་ཤས་ནས་རང་རེའི་འབྲུ་འགྲེལ་འདི་ལ་བལྟ་བདེ་དོན་ཚང་ཞིག་ངེས་པརོམཐའ་སྐྱོད་ཡོདཔ་ཞེས་ཡང་ཡང་དྲན་བསྐུལ་བྱེདམཁན་ཁ་ཤས་ཤིག་བྱུང་བ་དང་།",
    "ན་མོ་གུ་རུ་པདྨ་མཉྫའི་ཡེ།",
