    "ཁྱོད་རྣམས་རུ་ང་ཕྲག་དོག་མ་བྱེད་པར།",
    "ཕྱིན་ཆད་མཚོ་འདིར་མི་རེ་གསོན་པོ་རུ།",
    "བདག་གིས་གཞན་ཕན་ལྷག་བསམ་དག་པའི་མཐུས།",
    "ཁྱོད་ཉིད་རྒྱ་མཚོའི་གནས་ནས་འདི་རུ་བྱོན་པ་ལེགས་སོ།",
    "བཞེས་ན་སྣོད་གཅིག་གིས་འབྲལ་མི་ཕོད་པར་གྱུར་ཏོ།",
    "དེའི་བར་ལ་བུ་འདི་འཇོག་པ་སེམས་ཀྱིས་མི་ཕོད་འདུགཁྲིད་ན་ནི་རྒྱལ་པོས་གཟིགས་ཏེ་ད་དུང་འཕྲོག་ཉེན་ཡོད་དགོངས་ཙ་ན།",
    "བདག་གི་ཉེར་གནས་ཁྱིའུ་འདི་ཉིད་ནི།",
    "སྤྲང་པོ་དབུལ་པོ་ཞིག་གིས་བདག་ལ་བྱིན།",
    "བདག་གི་བུ་ཆུང་རྒྱལ་སྲས་དོན་གྲུབ་དེ།",
    "རིམ་བཞིན་བདག་གི་ཉེ་གནས་བགྱིས་པ་ཡིན།",
    "རྒྱལ་བུས་དེ་བཟུང་དུ་ཕེབས་པ་དང་དབུ་བརྡབས་ཏེ་འབག་གི་སྒོ་ཁ་ཆད་ནས་ཞལ་མཐོང་།",
    "དེ་མ་ཐག་སྲས་མོ་ལྷ་གཅིག་འོད་ལྡན་རྒྱལ་སྲས་དོན་གྲུབ་ཀྱི་དྲུང་དུ་ཕྱག་ལ་ཕེབས་ཏེ།",
    "སྲས་མོ་ལྷ་གཅིག་བཅས་ཁྲི་སོ་སོར་བཞུགས་བཅའ།",
    "ཁྱེད་རྣམས་རེ་ཞིག་གཞན་དུ་མ་འགྲོ་བར།",
    "དེ་ནས་སྐུ་མཆེད་གཉིས་པོ་ཞལ་མཇལ་བས་ཐུགས་དགའ་སྐྱོ་ཟུང་ད་འབྲེལ་བའི་ངང་རེ་ཞིག་འདིར་ལུས།",
    "སྲས་མོ་ལྷ་གཅིག་འོད་ལྡན་གཙོ་མཛད་མོ་སྐྱེས་མང་པོ་རྒྱན་བཟང་པོ་དང་བཅས་བསུ་བ་དང་།",
    "རོལ་མོ།",
    "དེ་རིང་བདག་གི་ཆམ་ལ་ཕོབས།",
    "དེང་དས་རང་རེ་བཀྲིས་ཕུན་སུམ་ཚོགས།",
    "ད་ནི་རང་རེའི་ཡབ་ཡུམ་བཀྲིན་ཅན།",
    "མཇུག་བྱང་། ། གོང་དུ་བཀོད་པའི་༧རྒྱལ་སྲས་སྐུ་མཆེད་གཉིས་ཀྱི་སྐུའི་སྐྱེ་བ་གཅིག་གི་ཡུན་དུ་རྒྱ་གར་འཕགས་ཡུལ་གྱི་ཁོངས་སུ་གཏོགས་པའི་ཡུལ་གྲུ་ཆེན་པོ་ཟངས་གླིང་ཞེས་བྱ་བ་དེར།",
    "ཕྱི་མ་ངན་འགྲོའི་སྒོ་ཁེགས་པའི་བླང་དོར་གཏིང་ཟབ་མོ་ཡོད་པ་བཅས་ཀྱིས་སྐྱེ་པོ་ཀུན་གྱི་རྒྱུད་ལ་ཞི་བདེ་དང་།",
    "ན་རྒས་སྐྲ་དཀར་དུས་སུ་བུ་མོ་ཞིག་ས་ཕོ་རྟ་ཡི་ལོར་སྐུ་བལྟམས་སོ།",
    "བུ་མོ་དེས་འཁྲུངས་མ་ཐག་ཏུ་ཡུམ་གྱི་ནུ་ཞོའི་ཕུད་ནས་ནམ་མཁའ་ལ་གཏོར་བཞིན་དུ་འདི་སྐད་དུ།",
    "དེ་ནས་མི་འགྱངས་པར་ཇོ་མོ་དེ་ཚེའི་དུས་བྱས་པས།",
    "ཡབ་སྲས་གཉིས་ཀར་བཙུན་མོ་གཅིག་ལེན་དགོས་དགོངས་པའི་སྐབས།",
    "དེའི་དུས་སུ་སྣང་ས་ཡང་ལོ་དུས་ལྟད་མོར་འགྲོ་འདོད་ཡོད་པའི་ཐོག་ཡབ་ཡུམ་གཉིས་ནས་ཀྱང་ཁྲོམ་ཐོག་གཅོད་ཕྱིར་གཏོང་འདོད་མཛད་དེ།",
    "སྣང་ས་ངོ་གཡོག་གཉིས་ལ་རྒྱན་གོས་ཕུན་སུམ་ཚོགས་པས་བརྒྱན་ཏེ་ཟ་ཆས་སོགས་འཛོམས་པ་སྐྱིད་མོ་ལ་བསྐུར་ནས་བརྫངས།",
    "དཔོན་པོ་སྒྲ་ཆེན་གྱིས་བླ་བྲང་རབ་གསལ་ནས་སྣང་ས་གཟིགས་ཤིང་།",
    "ཕྱི་ཡི་ལྕགས་རི་ནང་གི་ནོར་བུ་ཡིན།",
    "བུ་མོ་སྣང་ས་སྐྱེ་འབྲས་ལེགས་ན་ཡང་།",
    "མི་ཆེན་དཔོན་པོའི་བཙུན་མོ་གང་ནས་ཡོང་།",
    "བུ་མོ་སྣང་ས་ཅིས་ཀྱང་གཏོང་རོགས་མཛོད།",
    "དམའ་བ་ས་གཞིའི་སྟེང་གི་པད་མ་གཉིས།",
    "ཕལ་པའི་བུ་མོ་སྣང་ས་འོད་འབུམ་གཉིས།",
    "ཞེས་སྨྲས་ཏེ་བུ་མོ་སྣང་སའི་སྤྱི་གཙུག་ལ་གཙུག་གཡུ་དང་།",
    "ཡབ་ཡུམ་གཉིས་ནས་བུ་མོར་ནོར་སྐལ་དང་།",
    "བྲོ་གཞས་གླུ་གར་ལ་སོགས་དགའ་སྤྲོ་བསམ་གྱིས་མི་ཁྱབ་པས་བསུས་ཏེ་བག་མའི་དགའ་སྟོན་རྒྱ་ཆེར་བཤམས་སོདེ་ལྟར་སྣང་ས་འོད་འབུམ་རི་ནང་པའི་ཁྱིམ་དུ་འབྱོར་ནས་ལོ་ངོ་བདུན་ཙམ་སོང་བའི་དུས་སུ་སྲས་ཤིག་འཁྲུངས་ནས་མཚན་ལ་བུ་ཆུང་པ་ལྷའུ་དར་པོ་ཞེས་གསོལ་ཏེ།",
    "བུ་སྐྱེས་ཀྱི་སྟོན་མོ་ཡང་རྒྱ་ཆེ་བར་བཤམས་གཤིས།",
    "མི་རིང་བར་ནམ་ཟླ་སྟོན་ཁར་སླེབས་པས་དཔོན་མོ་སྣང་ས་ཡང་བཙས་སར་བྱོན་ནས་ལས་མི་ཚོ་དང་མཉམ་དུ་བཙས་མ་རྔ་བཞིན་པའི་དུས་སུ།",
    "ཨ་ནི་སྙིད་མོ་ནི་ཙོ་ནི་བཙས་མི་ཚོའི་ལས་རྒྱབ་ཏུ་ཡོད་སྟབས་འབུལ་མི་ནུས་གཤིས།",
    "ཨ་ནི་སྙེད་མོས་བསོད་སྙོམས་འབུལ་རྒྱུ་ཕ་ལྟར་ཞག་ཁ་བརྡུང་དྲག་པོ་བཏང་ཏེ།",
    "ཨ་ནི་སྙེད་མོ་ཞེ་སྡང་དྲག་པོ་སྐྱེས་ནས་དཔོན་མོ་སྣང་སར་བརྡུང་བརྡེག་བཏང་བ་མ་ཟད།",
    "དེའི་དས་ཕོ་གཞོན་སྤྲང་པོ་སྤྲེལ་འཁྲིད་པ་ཞིག་གིས་དཔོན་མོ་སྣང་སའི་དྲང་ད་བྱོན་ནས་སྤྲེའུ་དེ་རྩེད་མོ་སྣ་ཚོགས་བྱེད་བཅུག་པ་དང་།",
    "གཡུ་སྤུད་ལེགས་པ་གསུམ་སྤྲང་པོ་དེ་ལ་གསོལ་རས་གནང་སྐབས་སུ་དཔོན་པོ་སྒྲ་ཆེན་པས་གཟིགས་པ་དང་ཐུགས་ཀྱི་དགོངས་ལ་ཁ་སང་ཨ་ནི་སྙེ་མོས་བརྗོད་པ་དེ་དག་བདེན་པར་མངོན་ནས་ཡབ་སྲས་གཉིས་ནས་དཔོན་མོ་སྣང་སར་ཉེས་བརྡུང་དྲག་པོ་བཏང་ཅིང་།",
    "ཡབ་ཀྱིས་བུ་ཆུང་ལྷའུ་དར་པོ་ཡང་ཁྱེར་ཏེ་མོ་ཡན་ཞིག་ལ་བཅོལ།",
    "རྩིས་སྐོར་བའི་ནང་དུ་གསལ་བའི་དོན་ལྟར་སྐུ་གདུང་ཤར་ཕྱོགས་རི་སྣའི་རྩེར་བསྐྱལ་ནས་ཞག་བདུན་སོང་བའི་མཚམས་སུ།",
    "སྐུ་གདུང་སྐྱེལ་མི་རྣམས་ནས་དཔོན་མོ་སྣང་ས་རོ་ལངས་མ་ཡིན་པར་འདས་ལོག་ཡིན་པ་ཤེས་ནས་མྱང་སྟོད་རི་ནང་པའི་དཔོན་གཡོག་རྣམས་ཀྱི་དྲུང་དུ་གཏམ་སྙན་ཕུལ་གཤིས།",
    "བུ་ཆུང་ལྷའུ་དར་པོ་ཡང་འཛོམས་པ་སྐྱིད་མོའི་རྒྱབ་ཏུ་འཁྱེར་ནས་ཤར་ཕྱོགས་སྤང་རིའི་རྩེར་བྱོན་པ་ན།",
    "དཔོན་པོ་ཡབ་སྲས་པ་གཉིས་དང་ཨ་ནི་སྙིད་མོ་བཅས་ཀྱི་འགྱོད་བཤགས་ཕུལ་བ་དང་།",
    "ཡང་སྒོས་བུ་ཆུང་ལྷའུ་དར་པོ་དབུས་དཔོན་གཡོག་ཚང་མའི་འདོད་པ་སྐོང་ཕྱིར་རེ་ཞིག་ཁྱིམ་ལ་འབྱོན་པར་ཞལ་བཞེས་པ་ན།",
    "དེའི་ཚེ་དུས་རེ་ཞིག་ནས་འཛོམ་པ་སྐྱིད་མོར་བུ་ཆུང་ལྷའུ་དར་པོ་རྒྱབ་ཏུ་བསྐུར་ཏེ་སྣང་ས་ཡུམ་སྲས་དང་ལྷན་ཅིག་གཞིས་སུ་གཉེན་འཕྲད་དུ་ཕེབས་པ་ན།",
    "གསུངས་ཏེ་གོ་ཐལ་སྦྱར་པ་གང་སྣང་སའི་ཞལ་ལ་གཏོར།",
    "གོ་གཡོག་ཅིག་རྒྱག་ཏུ་བྱུང་བ་ན་གྲོགས་མོ་རྣམས་ཀྱིས་བཀག་ནས་ཞ་བ་ཕུལ་བར་བརྟེན་ཡུམ་གྱིས་སྣང་ས་ཁྱིམ་གྱི་ཕྱིར་ཕུད་པ་དང་།",
    "དེའི་ནུབ་མོ་གནས་ཚང་གཡར་ནས་བཞགས་སྐབས་མི་རྣམས་ཉལ་ནས་གཉིད་དུ་སོང་མ་ཐག་ཕྱི་ནང་གི་མི་སུས་ཀྱང་མ་ཤེས་པ་བྱས་ཏེ།",
    "དེའི་མཚན་མོ་བརྩེ་ཆེན་དགའ་བཞིའི་མདན་རྒྱུད་སེ་ར་གཡའ་ལུང་གི་དགོན་གཤམ་ད་ཕེབས་པ་ན།",
    "མཐར་ཐུག་གི་ཕན་བདེ་ཟད་མི་ཤེས་པའི་དཔལ་ལ་ལོངས་སྤྱོད་པའི་ལེའུ་ལས་རེ་ཞིག་གྲུབ་པ་ལགས་སོ།",
    "དེ་དག་གི་སྔོན་གྱི་འབྱུང་ཁུངས་ཆགས་རབས་སྔ་ཕྱི་དང་།",
    "མཐར་རྒྱལ་པོ་རང་གིས་ཀྱང་ཐུགས་ཀྱིས་མ་བཟོད་པར།",
    "སྔགས་པ་བཅུ་ཕྲག་གཅིག་གིས་དབེན་པའི་གནས་སུ་དྲག་པོའི་བསྙེན་མཚམས་བསྡམས་པའི་མཐར།",
    "ལྷོ་ཕྱོགས་སུ་ཆིབས་སུ་བསྒྱུར་རྒྱུའི་ཞལ་གྱི་བཞེས་ནས་བདུན་ཕྲག་གཅིག་སོང་བ་དང་རྒྱལ་པོའི་བློན་འབངས་དང་བཅས་པར་ཕེབས་བསུ་དང་།",
    "བྲོ་གཞས་སོགས་ཀྱིས་སྤྱན་སྔར་གཟིགས་འབུལ་ལྟར་ནས་སྟོན་མོ་ཟབ་པར་བཤམསདེའི་སང་ཉིན་སྔགས་འཆང་ཆེན་པོ་བསྙེན་མཚམས་སུ་བཞུགས་ནས་མཚམས་ཞགས་ཐིམ་པ་དང་།",
    "ཀླུ་ཡི་རིན་ཆེན་དབྱིག་གི་བརྡར་རྡོ་འདིར།",
    "མཚན་ཆ་གང་བརྡར་རེག་པས་ཟློག་མི་ནུས།",
    "རྫས་སྔགས་སྲུང་བ་གང་གིས་ཐུབ་མི་སྲིད།",
    "ཞེས་བརྗོད་པ་དང་ཆབས་ཅིག་ནོར་བུ་དབྱིག་གི་བརྡར་རྡོ་རྔོན་པའི་བུར་སྤྲད་ནས་མཚོར་ཐིམ།",
    "ཛ་ཏི་དང་སྤོས་དཀར་གྱི་དད་པ་ཡང་ལེགས་པར་སྦྱར་ཏེ་ཞི་བས་ཀླུ་མོ་བཀུགས་ཀྱང་མ་ཁུག་པས་ན།",
    "ཁྱུང་ནག་གི་བསྐྱེད་རིམ་ལ་གནས་པ་དེའི་ཚེ་ན།",
    "ཁོ་རེ་སྟོབས་ལྡན་ཇོན་པ་ཁྱོད་ཀྱིས་བཟོད་པར་འདུག་གམ།",
    "ཞེས་བརྗོད་བཞིན་དུ་རྔས་མགོར་སྐད་གསང་གིས་བོས་པས།",
    "ཟློག་བྱེད་ཀྱི་སྔགས་ཀྱང་བཏབ་པས་མཚོ་མོ་སྔར་བཞིན་གྱུར།",
    "རྔོན་པའི་ཐུགས་ལ་གང་དགྱེས་ཀླུ་མོ་ང་ཡིས་འབུལ།",
    "ས་སྟེང་འཇིག་རྟེན་གྱི་ཡུལ་ཕུན་སུམ་ཚོགས་པ་ཞིག་ཡིན་སྙམ་སྟེ་ཉིན་ཞག་སོང་བ་ཡང་མ་ཚོར་བའི་ངང་ནས་ཟླ་བ་གཅིག་ལྷག་ཙམ་པ་སོང་བའི་ཚེ།",
    "རྔོན་པ་སྐྱིད་པའི་ཉིན་ཞག་མང་དུ་སོང་།",
    "རིན་ཆེན་དབྱིག་གི་བརྡར་རྡོ་ཀླུ་མོར་འབུལ།",
    "དེ་ཡི་དྲུང་དུ་སོང་ལགས་བཟའ་མིའི་ལུང་བསྟན་ཡིན།",
    "ཞེས་བརྗོད་མ་ཐག་རྔོན་པ་ནི་དྲང་སྲོང་གི་མཚན་ཐོས་པ་ཙམ་གྱིས་དགའ་བ་སྐྱེས་ནས་ད་ལྟ་རང་མཇལ་ཨང་བསམ་པ་ཞིག་བྱུང་།",
    "དེ་ཕྲལ་རྔོན་པས་དྲང་སྲོང་གི་དྲུང་དུ་བཅར་ནས་ནོར་བུའི་ནོར་ཉམས་ཁྱེད་ཀྱིས་མཛོད།",
    "ལྷ་བཙན་དྲི་ཟ་དང་བཅས་པའི་མཛེས་མའི་རིགས་ཀྱིས་སྐུ་འཁྲུས་གསོལ་ཞིང་གླུ་གར་ལེན་པར་གཟིགས་པ་ན།",
    "ཡ་མཚན་དགའ་བའི་ལྟད་མོས་ཉི་མ་སོང་བ་ཡང་མ་ཚོར་ཞིང་།",
    "དེ་རིང་ཡ་མཚན་ལྟད་མོ་ཤིན་ཏུ་ཆེ།",
    "དྲང་སྲོང་གིས་འདི་སྐད་དུ།",
    "གཅིག་ཙམ་བཟུང་ཚོད་འདུག་པ་ཐབས་གཞན་བྱེད།",
    "སྔོན་ཆད་ཀླུ་མོས་གནང་བའི་ནོར་བུ་འདི།",
    "བདག་ལ་མི་དགོས་ཀླུ་མོ་རང་ལ་འབུལ།",
    "ཞེས་གསུངས་ཏེ་དེ་ཕྲལ་དོན་ཞགས་རྔོན་པར་གནང་ནས་ཚ་མཚོར་མོར་ཐིམ།",
    "དེ་ནས་རྔོན་པས་ཉིན་མཚན་ལྟོས་མེད་ཕྱིན་པ་ན་ཉིན་ཞག་གཉིས་ལ་སླར་ཀེའུ་རིར་དྲང་སྲོང་གི་དྲུང་དུ་འབྱོར།",
    "རྔོན་པ་སྔོན་མ་ལྟར་མེ་ཏོག་གི་བསེབ་ཏུ་ཡིབ་བཅུག་དྲང་སྲོང་ཆེན་པོས་ལྷ་བཙན་དྲི་ཟ་དང་བཅས་པ་ཁྲུས་ལ་སྤྱན་དྲངས་པས་གོ་རིམ་བཞིན་བྱོན།",
    "དྲང་སྲོང་གིས་ཕྱག་བརྡ་མཛད་པས་མོད་ལ་ན་པས་ཞགས་པ་འཕངས།",
    "ཡིད་འཕྲོག་སྲས་མོར་ཞགས་པ་ཕོག་ཅིང་ཁོན་ཏེ་བྱ་ལ་རྡོ་ཕོགས་པ་བཞིན་ལྷུང་།",
    "དེ་ཚེ་དྲང་སྲོང་གིས་བུ་མོའི་གཙུག་རྒྱན་དོ་ནུབ་རྔོན་པའི་ལག་ཏུ་གནང་།",
    "ནམ་ལངས་པ་དང་དྲང་སྲོང་གིས་རྔོན་པར།",
    "རྒྱལ་པོ་རབ་ཏུ་དགྱེས་ནས་སྒོ་དྲུང་འགག་གི་རྔོན་པ་དང་ན་ཆུང་བཅས་པ་ང་ཡི་མདུན་དུ་ཐོངས་ཤོག་ཅེས་བཀའ་ཕེབས་པ་དང་།",
    "རྔོན་པས་ཡིད་འཕྲོག་གི་ཡོང་རྐྱེན་ཞིབ་ཏུ་གསོལ་ནས་གཙུག་རྒྱན་དང་ཡིད་འཕྲོག་ཕུལ་གཤིས།",
    "ཡིད་འཕྲོག་གཞོན་ནུ་ནོར་བཟང་གི་ཁབ་ཏུ་བཞེས་པའི་དགྱེས་སྟོན་གྱི་མཛད་སྒོ་རྒྱ་ཆེ་བཤམས་སོ།",
    "དེ་ཚེ་སྐྱེ་བོ་ཕོ་མོ་ཀུན་ནས་ཡིད་འཕྲོག་གི་མཛད་བཟང་ཡང་མཛངས་མའི་བྱ་སྤྱོད་ཀུན་ཚང་ཞིང་།",
    "ཡིད་འཕྲོག་མཐོང་བའི་རྗེས་སུ་བཙུན་མོ་ལྔ་བརྒྱ་ཀུན་སྤྲེའུ་ལྟར་སོང་འདུག་ཅེས་ངོ་ལྐོག་ཏུ་གླེང་བའི་རྐྱེན་པས།",
    "་བཙུན་མོ་ལྔ་བརྒྱ་ཁྲོ་ལངས་ཤིང་བློ་ངོར་མི་གཤོང་བའི་ཁོ་རང་ཚོ་ནང་ཚོགས་སུ་ཡིད་འཕྲོག་མི་འདོད་པའི་ལབ་གླེང་སྣ་ཚོགས་བརྗོད།",
    "ཞེས་ཇི་ལྟར་ཞེས་པའི་དོན་རྣམས་ཧ་རི་ནས་ཁས་ལེན་བྱུང་མཚམས་ཕྱིར་ལོགདེའི་ཚེ་ཧ་རིས་གཡོ་འཁྲལ་གཏོར་བཅོས་སྣ་ཚོགས་བྱས་རྐྱེན་ཡབ་ནོར་ཆེན་ལ་རྨི་ལམ་ངན་པ་མང་པོ་བྱུང་བས་ཡབ་ཐུགས་མ་བདེ་བས་མཆོད་གནས་ཧ་རིའི་དྲུང་དུ་མོ་ཆེན་ཞུས་འབྲས་ལ།",
    "མོ་ད་རེས་ལས་ཚུབ་པ་ཡོང་མ་མྱོང་།",
    "གཉའ་རེངས་མི་རྒོད་མང་པོ་ཁ་རྒྱས་པས།",
    "འདི་ལོ་ཕར་འདུལ་དཔུང་གིས་མ་བཅོམ་ན།",
    "ཞེས་གསོལ་བས་ཡབ་ཀྱིས་ན་རེ།",
    "ཧ་རིས་ན་རེ།",
    "རྒྱལ་པོའི་ཆབ་སྲིད་དགྲ་བོས་བཟུང་བ་ལས་འོས་མི་འདུག་ཅེས་བརྗོད་ནས་མོ་ཆས་བསྡུས།",
    "སྔོན་དུ་ང་ལ་རྨི་ལམ་ངན་པ་རིམ་པས་བྱུང་བས་མཆོད་གནས་དྲུང་དུ་མོ་ལུང་ཞས།",
    "མོ་ལུང་ངན་ཞིང་མི་རྒོད་འདལ་སྐལ་ཁྱེད་རང་ལས་གཞན་མེད་གཤིས།",
    "ནོར་བཟང་གིས་ཡབ་ཡུམ་གཉིས་ཀྱི་སྙན་ལམ་དུ།",
    "མི་རྒོད་ཕ་བུ་དཔུང་ཚོགས་དང་བཅས་ནོར་བཟང་གིས་མདན་ད་ཡོང་ནས་གཡུལ་བཤམས།",
    "ནོར་བཟང་གིས་ཡབ་ཀྱི་བཀའ་བཞིན་མི་རྒོད་ཕ་བུ་གསུམ་ཚར་བཅད་དེ།",
    "བྱང་ཕྱོགས་མངའ་ལྡན་དུ་བཙུན་མོ་ལྔ་བརྒྱས་མཆོད་གནས་ཧ་རི་ལ་ནོར་བཟང་མེད་ཤུལ་དུ་ཡིད་འཕྲོག་སྒྲོལ་ཐབས་དགོས་པའི་རྟིང་བསྐུལ་ནན་ཞུས་བྱས་པས་ན།",
    "ལྔ་བརྒྱ་ཁ་སྐྱེངས་ནས་ང་ལན་ཁྱོད་ལན་ཟེར་ནས་ནང་འཐབ་ཀྱི་ཀོ་ཅོས་འགེངས་སོ།",
    "ཡིད་འཕྲོག་མས་ཡར་ལམ་ཀེའུ་རིའི་དྲང་སྲོང་ཆེན་པོའི་སར་བཅརནས་ནོར་བཟང་ལ་ཕྱིར་ལན་དང་བུ་མོའི་སོར་གདུབ་འབུལ་རྒྱུ་བཞགས་ནས་ལྗོན་པའི་ཡུལ་ལ་ཆས་སོསྐབས་དེར་ནོར་བཟང་དཔུང་བཅས་ནི་བྱང་ཕྱོགས་ཡུལ་ངན་དེ་དག་བསྒྲལ་ནས་སྟག་ལ་ལ་ཐོག་ཏུ་འབྱོར་ནས་ལྷ་རྣམས་ལ་གཏང་རག་མངའ་གསོལ་བས་དེའི་ཤར་ཕྱོགས་ནས་མངའ་ལྡན་ལྷ་ཡི་སྤྲུལ་པའི་བྱ་༢རོག་གཉིས་བྱང་།",
    "ཡབ་ཀྱིས་དེ་ཕྲལ་མདའ་ཡིག་ཕྱག་ཏུ་བཞེས་ནས་གཟིགས་པ་ན།",
    "ནོར་བཟང་གི་བཀའ་འཕྲིན་ཡིན་པ་མཁྱེན་ནས་དགྱེས་པར་གྱུར་ཅིང་།",
    "དེ་ནས་ཞག་ཤས་སོང་བའི་ཚེ།",
    "ནོར་བཟང་དཔུང་དང་བཅས་པ་ལ་བཙས་གཉིས་པའི་ཐོག་འབྱོར་ནས་ཡུམ་གྱིས་བསུ་ཆང་མཆོད་ཅིང་གླེང་མོལ་མང་ཙམ་བྱང་།",
    "བདག་གི་བརྩེ་བའི་ཡིད་འཕྲོག་མཐོང་ས་ན་མི་འདུག་ཡབ་ཆེན་བཀྲིན་ཅན་གྱིས་ཡིད་འཕྲོག་སྟོན་རོག་གནང་དང་།",
    "དེ་ཚེ་ཞག་གསུམ་སོང་བའི་ནམ་སེང་ལ་ནོར་བཟང་གིས་ཡིད་འཕྲོག་འཚོལ་ད་ཐག་རིང་ཤལ་ལམ་བརྟོལ་ནས་ཕེབས་པ་ན།",
    "དྲང་སྲོང་ནས་ཀྱང་ཡིད་འཕྲོག་མའི་ཕྱིར་ལན་ཞིབ་ཏུ་གསུངས་ནས་བུ་མོའི་སོར་གདབ་ནོར་བཟང་ལ་གནང་སྟེ་ལམ་དགྲའི་འཇིགས་པ་ལས་ཐར་བའི་སྐྱབས་སྨོན་མཛད་པས།",
    "ལོན་པར་དཀའ་བའི་ལྷ་སྲས་ཡིད་འཕྲོག་བཙུན་མོར་བླངས་ཏེ།",
    "ནོར་བཟང་ནས་སྔ་ཕྱིའི་ཞི་དྲག་གི་མཛད་པ་མཛད་ཚུལ་ཞིབ་པར་བཀའ་བསྩལ་བས་སྐྱེ་བོ་མཆོག་དམན་ཀུན་ཡ་མཚན་ཞིང་ངོ་མཚར་བར་གྱུར་རོ།",
    "མ་གཅིག་ཉོན་དང་བྲམ་ཟེ་གཟུགས་མཛེས་ལགསམུ་སྟེགས་རྒྱལ་པོའི་བཀའ་ལ་འདི་ལྟར་འདགཁྱོད་ཀྱི་ཟླ་གྲོགས་ཚོང་དཔོན་ནོར་བཟང་དེད་ལྟ་རྒྱལ་པོའི་དྲུང་དུ་འཁྲིད་ཤོག་ཅེས་སྨྲས་སོ།",
    "དེ་མ་ཐག་ཡུམ་ལྷ་རིགས་བྲམ་ཟེ་དེ་ཚོང་དཔོན་ནོར་བཟང་གི་དྲུང་དུ་བྱོན་ཏེ་འདི་སྐད་ད།",
    "རང་རེའི་ཁྱིམ་གྱི་སྒོ་དྲུང་སྒང་ཞིག་ལ།",
    "ཚུར་རུ་ཉོན་དང་ཚོང་དཔོན་ནོར་བཟང་ཁྱོད།",
    "ཀྱེ་མ་མུ་སྟེགས་རྒྱལ་པོ་བདག་ལ་གསོནསྔོན་དུས་རྒྱལ་པོའི་ཚོང་པ་རབ་ཀྱི་ཞུསསྟོད་ཐོག་སྨད་དང་སྨད་ཟོག་སྟོད་ལ་བསྐྱལལྷོ་ཚོང་བྱང་དང་བྱང་ཚོང་ལྷོ་རུ་བསྐྱལ།",
    "རྒྱལ་པོ་ནོར་མེད་ནོར་གྱི་ཚེམས་པ་བཟོསད་ནི་ལོ་རྒན་བརྒྱ་དང་བརྒྱད་ཅུའི་སྟེང་ལ་སླེབསརྒྱ་མཚོ་ཅན་ལ་མི་འགྲོ་དགོངས་པ་ནཞེས་ཞུས་པར་མུ་སྟེགས་རྒྱལ་པོ་ཞེ་སྡང་མེ་ལྟར་འབར་ནས་སོང་།",
    "རྦ་རླབས་གྱེན་ལ་ལོག་པའི་དཔེ་མི་སྲིདཁྱོད་རང་རྒྱ་མཚོ་ཅན་ལ་མ་ཕྱིན་ན།",
    "དེར་བརྟེན་ཚོང་དཔོན་ནོར་བཟང་གིས་མཐའ་གླིང་རྒྱ་མཚོ་ཅན་ལ་ནོར་བུ་ལེན་དུ་འགྲོ་རྒྱུ་ཞལ་གྱི་བཞེས་པ་ན་གཟིམ་ཆུང་སྐྱིད་པའི་སྒྲོལ་མ་ལྷ་ཁང་ད་ཕྱག་ཕེབས་ཏེ།",
    "དེ་ནས་ཐུགས་དྲན་གསོས་པ་ན་ནོར་བཟང་གི་ཕྱག་ནས་བཟུང་ཏེ་འདི་སྐད་དུཚོང་དཔོན་རྒྱ་མཚོ་ཅན་ལ་གཏོང་བ་ལས།",
    "ནོར་བཟང་གིས།",
    "ཞག་བདུན་སོང་བའི་ནང་བར་ལྷ་རིགས་བྲམ་ཟེ་ནས་ཚོང་དཔོན་ནོར་བཟང་ལ་སྐྱེལ་ཆང་གི་སྒོ་ནས་འདི་སྐད་སྨྲས་སོ།",
    "ཚེ་དེ་ད་རེས་མཇལ་བ་མ་བྱུང་ཡང་།",
    "ནོར་བཟང་གིས་ཡུམ་ལྷ་རིགས་ལ་སླར་ཡང་ཐུགས་གསོ་མཛད་རྗེས་མུ་སྟེགས་རྒྱལ་པོའི་གམ་ད་ཕེབས་ཤིང་།",
    "རྦ་རླབས་རི་རབས་ཙམ་ཞིག་ལངས་ནས་གྲུ་གཟིངས་དེ་ཐལ་ཐོར་དུ་སོང་བ་མ་ཟད།",
    "རྒྱ་གར་ཤར་གྱི་མ་རྒན་མོ་ལྷ་རིགས་བྲམ་ཟེ་ལས་མྱ་ངན་ཆེ་བ་མེད་པས།",
    "ཉིན་གཅིག་རྒྱ་གར་གྱི་བྱིས་པ་རྣམས་ལུང་པའི་ཕུར་ཤིང་བསྒྲག་པར་འགྲོ་བ་ཁྱེའུས་གཟིགས་པ་ན།",
    "ཤ་ཕོ་ཨ་ཕ་ཡིན་ཟེར་སྔོན་ལ་འགྲོཤ་མོ་ཨ་མ་ཡིན་ཟེར་མཇུག་ལ་འདེད།",
    "དེ་བས་ཚོང་གི་ལས་འགོ་ཞིག་ཨེ་ཤེས་ལྟ་དགོས་དགོངས་ནས་རྒྱ་གར་ཚོང་འདུས་ཧ་ཕྲ་ཞིག་ཡོད་པ་དེར་སྐུད་པ་ཚོང་དུ་བྱོན་པ་དང་།",
    "རྒྱ་གར་ལྷོ་ནས་རྒན་མོ་རྒྱབ་ལ་ཁུར་རྩ་འཁུར་བ་ཕྱག་ཕེབས་པར་ཞུ་ལགས།",
    "ཚུར་ལ་གསོན་དང་རྒན་མོ་བཀའ་དྲིན་ཅན།",
    "འདི་རིང་ཚོང་གི་ལས་འཕྲོ་ཡོད་དམ་གསུངས།",
    "དེ་ནས་རྒན་མོའི་བསམ་པ་ལ།",
    "ཁྱེའུ་ཙན་དན་སྡོང་འོག་ཁྲིད་དེ་སོང་།",
    "ཁྱེའུས་སྐད་པའི་ཡོན་ཏན་གསུངས་པར་རྒན་མོ་མགུ་ནས་མོའི་ཀརཤ་པ་ནི་དོང་རྩེ་འདི།",
    "རྒན་མོའི་ལག་ཏུ་སྐུད་ཆེན་འོད་དང་ལྡན་པ་བཅོ་བརྒྱད་བྱུང་སྟེ་ཚོང་པ་ན།",
    "རྒན་མོས་བྲང་ལ་བརྡུང་བཞིན་འདི་སྐད་ཟེར།",
    "རྒན་མོའི་ཚེ་གང་འདངས་པའི་རྒྱགས་ཆས་དེ།",
    "ང་ལ་མི་དགོས་རྒན་མོ་ཁྱོད་ལ་སྟེར།",
    "དེའི་ཚེ་རྒན་མོ་རྒྱ་གར་ཚོང་འདུས་ཧ་ཕྲའི་ཕྱོགས་སུ་སྐུད་པ་ཚོང་བ་ལས།",
    "འོད་ཆེ་བ་ཉི་ཟླ་ཙམ་ཞིག་ཤར་འདུག་ཆུང་བ་སྐར་ཆེན་ཙམ་ཞིག་གི་འོད་འཕྲོས་པས་མུ་སྟེག་རྒྱལ་པོ་དེའི་གདོང་རྫ་རི་ནག་པོ་ལྟར་གྱུར་སྟེ་འདི་སྐད་དུཚུར་རུ་ཉོན་དང་བློན་པོ་སྡིག་བློན་རྐང་མགྱོགས་པརྒྱ་གར་ཚོང་འདུས་ཧ་ཕྲའི་ཕྱོགས་ལ་ནི།",
    "འོད་ཆེན་ཉི་ཟླ་ཙམ་ཞིག་འཕྲོས་པར་འདུག་ཆུང་བ་སྐར་ཆེན་ཙམ་ཞིག་འཕྲོས་པར་འདུག་མ་གི་ཅི་ཡིན་དྲིས་ལ་བདར་ཤ་བློན་པོས་ཆོད་ཅིག་གསུངས།",
    "ཞེ་སྣང་མེ་ལྟར་འབར་ནས་ཧ་ཕྲའི་ཕྱོགས་ལ་ཕྱག་ཕེབས་པར་ཞུ་ལགསདེ་ནས་བློན་པོ་ཁོས་རྒན་མོ་ཞིག་འདུག་པ་དེ་ཡི་སྐྲ་ལོ་དེ་ལ་ལག་ཐོགས་གསུམ་ཙམ་རྒྱབ་ནས།",
    "ཁྱོད་ཀྱི་མདུན་ན་ཡོད་པའི་སྐུད་པ་འདི།",
    "རྒན་མོའི་ཁ་ནས་འདི་སྐད་ད།",
    "སྐད་པའི་འབྱུང་ཁངས་རྒན་མོས་ལོས་ཀྱང་ཤོད།",
    "པད་མ་འོད་འབར་ཕྱག་གིས་ཤད་སྐུད་ཡིན།",
    "རྒན་མོ་མ་གསོད་ཚེ་ཐར་གཏོང་གྲོགས་མཛོད།",
    "རིགས་ངན་ཕུག་མའི་འོག་ཏུ་སྐྱེས་ནས་འདུག་པད་མ་འོད་འབར་བྱ་བ་སྐྱེས་ནས་འདུག་རྒྱལ་པོ་ཁྱོད་ཀྱི་གོང་ན་ཤོར་བ་འདུག་ང་ནི་རྒྱལ་པོའི་བློན་པོ་མི་བྱེད་ཟེར།",
    "ཚུར་རུ་ཉོན་དང་རྐང་མགྱོགས་བང་ཆེན་ཁྱོད།",
    "བློན་པོ་ཁྱོད་འདི་རུ་མ་སྡོད་པར།",
    "སྒྲོལ་མ་ལྷ་ཁང་ནང་དུ་མགྱོགས་པོ་སོང་།",
    "སྡིག་བློན་རྐང་མགྱོགས་སྒྲོལ་མ་ལྷ་ཁང་གི་ཕྱོགས་སུ་ཕྱག་ཕེབས་པར་ཞ་ལགས།",
    "དེའི་ཚེ་སྒྲོལ་མ་ལྷ་ཁང་གི་སྒོ་ཁྱི་ཐམས་ཅད་ཀྱིས་འུར་འུར་ཆེམ་ཆེམ་བྱེད་པ་ལ།",
    "སྒྲོལ་མ་ལྷ་ཁང་གི་སྐུ་རྟེན་རྣམས་ཀྱི་གསེབ་ཏུ་སྦས་ནས་བཞག་ཡུམ་རང་བློན་པོའི་གམ་དུ་བྱོན་ནས་འདི་སྐད་དུ།",
    "གཏན་བྲལ་གྱུར་ནས་ལོ་ངོ་གསུམ་ཙམ་སོང་།",
    "ཁྱེའུས་གཟིགས་པ་དང་བློན་པོའི་ལག་ནས་ཟིན་ཏེ་འདི་སྐད་དུ།",
    "བདག་གི་ཨ་མ་མ་གསོད་ཚེ་ཐར་ཐོངས།",
    "ཨ་མའི་ཕྱིར་དུ་བདག་རང་གསོད་གྲོགས་མཛོད།"
  ]
}