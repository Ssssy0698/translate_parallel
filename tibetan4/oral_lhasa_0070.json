    "དེ་ཡང་རྫ་མཁན་གྱིས་ནི་དབྱིབས་ཀྱི་བྱེ་བྲག་བྱེད་༢ིཔར་བརྗོད་པ་དེའི་ཚེ་དེ་དག་ཤིན་ཏུ་ཐ་དད་པས་རྒྱུ་དུ་མ་ཉིད་ལས་འབྲས་བུ་དུ་མ་ཉིད་འཐོབ་བོ།",
    "དེའི་ཕྱིར་འཇིམ་པའི་གོང་བུ་ཉེ་བར་ལེན་པ་ཕུལ་དུ་བྱུང་བས་བྱས་པ་དེའི་༐",
    "དེའི་ཉེ་བར་ལེན་པའི་བདག་ཉིད་ཀྱིས་བྱས་པ་དེའི་འབྲས་བུའི་མཚན་ཉིད་ལ་འཇིམ་པའི་གོང་བུ་ནི་༦ལྷན་ཅིག་བྱེད་པ་སོ་སོ་བའམ།",
    "བུམ་པར་གཏོགས་པའི་དབྱིབས་གང་ཡིན་པ་དེ།",
    "དེའི་ཚེ་འཇིམ་པའི་རང་བཞིན་ཁོ་ན་རྣམ་པ་དེ་ལྟ་བུ་དབྱིབས་དང་འབྲེལ་པར་༢༦རུང་བ་ཉིད་དོ་༡༧།",
    "ཚོགས་པ་གཅིག་པར་བསྟན་༡༧པ་ཡུལ་ལ་ལྷན་ཅིག་བྱེད་པ་དུ་མ་ཉིད་ཀྱང་དུ་མ་གཅིག་བྱེད་པ་ལ་འགལ་བ་མེད་པའི་ཕྱིར་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པའི་རྗེས་སུ་བྱེད་པའི་འབྲས་བུ་གཅིག་མཐོང་བའི་ཕྱིར་རང་བཞིན་གཅིག་པ་ཉིད་སྒྲུབ་པར་བྱེད་པའི་རྒྱུ་དེས་ན་ལྷན་ཅིག་བྱེད་པ་ནི་ལྷན་ཅིག་བྱེད་པའི་ངང་ཚུལ་ཅན་ཚོགས་པ་གཅིག་པའི་ནང་དུ་འདུས་པའོ།",
    "དེའི་ཚེ་ཐ་དད་པས་དུ་མའི་མཚན་ཉིད་ལས་འབྲས་བུ་དུ་མའི་མཚན་ཉིད་ཐ་དད་པར་མི་འདོད་པ་ཁོ་ན་སྟེ།",
    "འཇིམ་པ་དང་དབྱིབས་དག་བདག་ཉིད་༢ིགཅིག་པར་བསྟན་པའི་མཇུག་བསྡུ་བ་ནི་འཇིམ་པ་དང་དབྱིབས་ཀྱི་བདག་ཉིད་ཀྱི་འབྲས་བུའི་རང་བཞིན་གཅིག་པ་ཉིད་ཀྱང་དུ་མའི་རང་བཞིན་མ་ཡིན་པ་ཡང་ངོ།",
    "དངོས་སུ་ནི་དོན་དམ་པར་ར་རོ།",
    "རྣམ་པར་རྟོག་པའི་༤བློ་ལ་འཇིམ་པ་དང་དབྱིབས་དག་ཐ་ད་ད་པར་སྣང་བའི་ཕྱིར་རོ།",
    "ཚོགས་པ་གཞན་པའི་ཚོགས་པའི་བྱ་མཚན་ཉིད་ཐ་དད་པའི་རྒྱུ་ལས་འབྲས་བུ་དུ་མ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ཉིད་རྣམ་པར་ད་བྱེ་བ་ནི་དེ་བཞིན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "མིག་དང་ལྷན་ཅིག་པའི་མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་གྱིས་༥ཚོགས་པ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་ཡུལ་ལ་ད་བང་བྱེད་པའོ།",
    "ཚོགས་པ་གཞན་སྐྱེས་པ་རྣམས་ཀྱི་འབྲས་བུའི་ཁྱད་པར་ནི་འབྲས་བུ་ཁྱད་པར་ཅན་ནོ་ཞེས་བྱ་བ་དེས་གང་བརྗོད་པའོ།",
    "གལ་ཏེ་ལྷན་ཅིག་བྱེད་པ་རྣམས་ཐ་དད་ཀྱང་འབྲས་བུ་ཐ་མི་དད་པར་འགྱུར་བ་ནི་ཚོགས་པ་ཐ་དད་ཀྱང་ཐ་མི་དད་པ་ཡོད་པ་ཡིན་ནོ།",
    "འོན་ཏེ་ཚོགས་པ་ཐ་དད་པས་ཐ་དད་པར་འགྱུར་ཏེ།",
    "ལྷན་ཅིག་བྱེད་པ་ཐ་དད་ཀྱང་ཅིས་ན་ཐ་མི་དད་པར་འགྱུར་བ་ཡིན།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "མཚུངས་པ་དེ་མ་ཐག་པའི་འབྲས་བུ་གཞན་སྐྱེད་པར་ནུས་པ་དང་འབྲེལ་པ་རྣམས་ནི་གཞན་པ་ལས་ཡིན་ཏེ།",
    "གང་ལས་ཁྱད་པར་མེད་པ་ཡིན།",
    "དེའི་རྒྱུ་སྔ་མ་ནི་སྐྱེད་པར་བྱེད་པ་ཉིད་འབྲས་བུ་ཕྱི་མའི་རྟེན་ཉིད་དེ་སྐྱེད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་དེ་ནི་ངོ་བོ་ཡིས་སྐྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་དག་མ་ངེས་པའི་གནས་སྐབས་སུ་འགྱུར་ཞེ་ན།",
    "སྐད་ཅིག་མ་འདི་ཟད་པ་ཞལ་གནོད་པ་བྱེད་༨པ་མེད་ལ་༩ཕན་འདོགས་པ་སྤོང་༡བར་བརྗོད་པ་ནི་ཁྱད་པར་དུ་བོགས་དབྱུང་དུ་མེད་པ་དག་ཅེས་བྱ་བ་སྨོས་ཏེ།",
    "འོན་ཏེ་ཁྱད་པར་བོགས་དབྱུང་དུ་མེད་པ་ཉིད་ཀྱིས་༢༢ལྷན་ཅིག་བྱེད་པ་ཉིད་མེད་དོ་ཞེས་བསྟན་པའི་དོན་འདི་ཅི་ཞིག་ཡིན།",
    "ནུས་པ་འགོག་པ་མེད་དོ་ཞེས་བྱ་བའི་ནུས་པ་འགོག་པར་བྱེད་པའི་ལྷན་ཅིག་བྱེད་པར་བརྗོད་པ་མེད་དོ་ཞེ་ན།",
    "པ་དེའི་༡ཕྱིར་ཁྱད་པར་ཕུལ་དུ་བྱུང་བ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "རྒྱུའི་ཚོགས་པ་ནི་རྐྱེན་གྱི་ཚོགས་པའོ་། འདི་དག་ནི་ཉེ་བར་བཏགས་པར་གྱུར་ན་ལྷན་ཅིག་བྱེད་པ་འདི་དག་ཕུལ་དུ་བྱུང་བ་བསྐྱེད་པས་དངོས་པོ་ཡིན་ནོ་ཞེ་ན།",
    "བརྗོད་པར་འདོད་པའི་འབྲས་བུའི་རྒྱུ་ཡིན་པའི་ཕྱིར་ར་རོ།",
    "མཐའ་མའི་༦རྒྱུའི་ཚོགས་པའི་རྣམ་པ་དེ་ལྟ་བུ་ཡིན་པའི་ཕྱིར་དཔེར་ན་ཐ་མའི་དོན་གཅིག་པའི་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཡིན་པ་དེ་བཞིན་དུ་སྔ་མའི་ཚོགས་པ་ལས་ཕྱི་མ་ཕྱི་མའི་སྐད་ཅིག་མ་ཁྱད་པར་ཅན་ཐ་དད་པར་ངེས་ཏེ་ཐ་མ་ཉིད་དཔེར་བསྟན་པའི་ཕྱིར་རོ།",
    "ཐམས་ཅད་དུ་དོན་གཅིག་བྱེད་པའི་འབྲས་བུ་འཕེལ་པ་དང་འགྲིབ་པའི་རྒྱུ་ནི་ལྷན་ཅིག་བྱེད་པའི་རྒྱུའི་ཚོགས་པ་ཉིད་དུ་ཁྱད་པར་དུ་སྐྱེད་པ་༡ཡིན་ནོ་ཞེས་བྱའོ།",
    "འདི་དག་དོན་གཅིག་བྱེད་པ་ཡང་དེ་ལ་ལྷན་ཅིག་བྱེད་པ་ཡོད་ན་ཁྱད་པར་དུ་སྐྱེད་པ་མཚན་ཉིད་ཡིན་ནོ་ཞེ་ན།",
    "ཐ་མའི་བྱེ་བྲག་ཏུ་བྱེད་པར་མི་ནུས་པ་ཉིད་ན་ལྷན་ཅིག་བྱེད་པས་ཀྱང་ཁྱད་པར་དུ་བྱེད་པ་མ་ཡིན་ན་ནོ།",
    "གང་ལས་ཁྱད་པར་དུ་བྱེད་པར་མི་ནུས་ཤེ་ན།",
    "ངོ་བོ་ཉིད་གཅིག་ལ་ཆ་ཤས་དབྱེར་མེད་པ་དེ་ལ་འདི་ཁྱད་པར་དུ་མི་བྱེད་པ་ནི་ཆར་མི་བྱེད་པའོ།",
    "ཆ་མེད་པ་ག་ལ་ཡིན་ངོ་བོ་ཉིད་གཞན་རྣམ་༢པར་འཇོག་པ་ན་བདག་ཉིད་ལས་གཞན་པའི་ཁྱད་པར་ཡོད་པ་ཡིན་ནོ་ཞེ་ན།",
    "འོ་ན་ནི་ལྷན་ཅིག་བྱེད་པ་རྣམས་ཁྱད་པར་དུ་སྐྱེད་པ་མི་བདེན་ན་འབྲས་བུ་སྐྱེད་པ་འི་ནུས་པ་དེ་དག་མི་རིགས་སོ་ཞེ་ན།",
    "རྣམ་པ་དེ་ལྟ་བུ་རྣམས་ལ་བྱ་བ་གཅིག་པ་ཁོ་ནའི་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཡིན་གྱི་ཁྱད་པར་དུ་སྐྱེད་པའི་མཚན་ཉིད་མ་ཡིན་ཏེ།",
    "ངོ་བོ་ཉིད་ཀྱིས་ནུས་པའི་དངོས་པོ་ད་ང་ཕན་ཚུན་འགལ་བས་ནུས་པ་ལས་སྐྱེད་པར་ཁས་ལེན་པར་རིགས་༢པ་མ་ཡིན་ནོ་སྙམ་དུ་གཞན་དག་སེམས་ནས།",
    "དོན་གཅིག་བྱེད་པར་ངེས་པའི་སྐད་ཅིག་མ་ནི་མི་རིགས་ཏེ།",
    "དེས་ན་འབའ་ཞིག་ཁོ་ན་ཞེས་བྱ་བ་སྨོས་ཏེ་གཅིག་ཀྱང་སྐྱེད་པར་བྱེད་པ་སྲིད་པས་དུ་མ་ཉི་ཚེ་ནི་༢མ་ཡིན་ན་ནོ།",
    "གང་ཅུང་ཟད་ཅིག་ཞིང་ད་ང་ས་བོན་ལ་སོགས་མྱུ་གུ་ལ་སོགས་པ་འབྲས་བུ་འགའ་ཞིག་དེས་སྐྱེད་པར་ནུས་ཀྱི།",
    "རྟེན་ད་ང་རྒྱུ་དང་རྐྱེན་གྱི་ཁྱད་པར་ལ་༢དངོས་སུ་བྱེད་པའི་རྐྱེན་ལས་ཐ་དད་པའི་རྣམ་པར་ཤེས་པ་དེ་སྐྱེད་པར་ནུས་པའི་རྒྱུ་ནི་དེ་ཡོད་ན་ཡོད་པ་ཉིད་དུ་མཐོང་བ་ཉིད་དོ།",
    "བར་དུ་ཆོད་པ་སྤང་བའི་རྒྱུ་གང་ཡིན་པ་དེ་ནི་རྣམ་པར་ཤེས་པ་སྐྱེད་པར་ནུས་པའོ།",
    "ཐམས་ཅད་ལ་ཞེས་བྱ་བ་བརྗོད་པས་སྐད་ཅིག་མ་མ་༡ཡིན་པ་རྣམས་ལ་སོ་སོར་ངེས་པར་མ་གྱུར་ཅིག་སྙམ་ན།",
    "གཅིག་པུ་སྨོས་པ་ནི་སྐད་ཅིག་མ་གཅིག་ཡོད་པའི་ཕྱིར་བརྟན་པར་འཛིན་ཏོ།",
    "དེའི་ཕྱིར་བསྟན་པའི་དོན་༤ནི་གལ་ཏེ་འབྲས་བུ་སྐྱེད་པར་ནུས་པའི་རང་བཞིན་ཡིན་པ་དེ་བས་ན་མི་བྱེད་པར་མི་འཐད་དེ།",
    "ཐམས་ཅད་དུ་བྱེད་པར་འགྱུར་ར་རོ།",
    "ནུས་ན་ཅིའི་ཕྱིར་མི་བྱེད་ནུས་ན་མི་བྱེད་པ་ནི་ལྷན་ཅིག་པའི་གནས་སྐབས་ཀྱིས་སྦྱོར་རོ་ཞེས་བྱ་བ་ལྷན་ཅིག་པ་ཁོ་ན་བྱེད་པར་འདོད་ཀྱི་འབའ་ཞིག་པ་ནུས་པ་མེད་པའི་ངོ་བོ་ཡིན་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "སྐྱིད་དེ་བར་སྐྱེས་པ་ནི་བསྟན་བཅོས་ལ་མི་སྦྱོར་བའོ་། མི་སྦྱོར་བའི་བློ་ངན་པ་གང་ཡིན་པ་དེ་ནི་བྱས་ཀྱང་དངོས་པོ་བརྗེད་པའི་བྱ་ཏྲ་ངང་ཚུལ་ཅན་ཡང་བྱེད་པའོ།",
    "བྱས་པ་ནི་རབ་ཏུ་བརྩམས་པའོ།",
    "གང་ལ་སླར་ཡང་རྩོམ་པར་བྱེད་ཅེ་ན།",
    "འདི་ཉིད་སྐད་ཅིག་མ་མེད་པའི་ནུས་པའི་ངོ་བོ་ཉིད་ལ་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཀྱིས་འབྲས་བུ་གཅིག་བྱེད་པའི་ངོ་བོ་འགལ་བས་འགའ་༡ཞིག་བྱེད་པར་འཐད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་མཇུག་བསྡུ་བ་ནི་དེ་ལྟ་བས་ན་ཞེས་བྱ་བ་སྨོས་ཏེ་༢ི།",
    "ངོ་བོ་གཅིག་པའི་ནུས་པ་ཉིད་སྔར་མེད་པས་སྐྱེད་པར་མི་ནུས་ཞེས་པ་༧མི་རིགས་ཏེ།",
    "གལ་ཏེ་ནུས་པ་དང་ལྡན་པ་སྐྱེད་པ་དང་མི་སྐྱེད་པ་༡ངོ་བོ་ཉིད་གཅིག་པར་རྟོགས་པ་ཁོ་ན་ཇི་ལྟར་སྤོང་བར་ནུས་པ་ཡིན་ནོ་ཞེ་ན།",
    "སྐྱེད་པ་༤ཕན་ཚུན་འགལ་བས་གནོད་པར་ཅིས་ན་མི་འདོད།",
    "སྐད་ཅིག་མ་ཉིད་དོན་གཅིག་བྱེད་པར་ངེས་པའི་མཚན་ཉིད་ལ་ལྷན་ཅིག་བྱེད་པ་ཉིད་འདོད་པར་ཁས་བླངས་ས་སོ།",
    "དེ་ཉིད་བསྟན་༢པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་སྔོན་ཡང་བྱེད་པར་འགྱུར་བ་དེས་ན་དོན་གཅིག་བྱེད་པར་སོ་སོར་ངེས་པའི་དངོས་པོར་ག་ལ་འགྱུར།",
    "སྐད་ཅིག་མ་མེད་པར་ཁས་ལེན་པ་ལ་དོན་གཅིག་བྱེད་པར་མ་གྲུབ་པའི་ཕྱིར་ར་རོ།",
    "ཁོ་བོ་ཅག་རིགས་པ་ལ་རྗེས་སུ་ཆགས་པ་རིགས་པར་བརྗོད་པ་ལ་ཅིས་ན་༦བཏང་སྙོམས་སུ་བྱེད་པ་འདིར་",
    "ཡང་ཁྱེད་ཀྱིས་ཐམས་ཅད་ཀྱི་ཚེ་རིགས་པ་བརྗོད་པ་སྤངས་པ་ཡང་རས་༡འགའ་ཞིག་རིགས་པ་དང་ལྡན་པར་སྨྲ་བ་ལ་དགའ་བ་སྐྱེ་སྟེ།",
    "གལ་ཏེ་དེའི་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་དང་སྐྱེད་པར་མི་བྱེད་པས་ཐ་དད་པ་ཡིན་ཏེ།",
    "འབྲས་དང་༨ནས་ཀྱི་ས་བོན་བཞིན་དུ་ཇི་ལྟར་དངོས་པོ་ཐ་དད་པར་མི་འགྱུར་ཏེ།",
    "འོ་ན་ནི་བདག་ཉིད་སྐྱེད་པར་བྱེད་པ་དང་སྐྱེད་པར་མི་བྱེད་པའི་ངོ་བོ་སྤངས་པའི་ཕྱིར་རྐྱེན་གཞན་པའི་ངོ་བོ་ལ་ལྟོས་༩པའི་ཕྱིར་སྐྱེད་པར་བྱེད་པ་དང་།",
    "དེའི་ཕྱིར་ཕན་མི་འདོགས་པའི་དངོས་པོ་ལ་འབྲས་བུ་ལྟོས་༦པར་མི་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་སྐད་ཅིག་མ་རྣམས་དོན་གཅིག་༡༧བྱེད་པར་ངེས་པའི་མཚན་ཉིད་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཡིན་ནོ་ཞེས་པར་༡༧ངེས་ས་སོ།",
    "ལྷན་ཅིག་བྱེད་པ་རྣམས་ཀྱིས་ཐ་མི་དད་པར་སྐྱེད་པར་བྱེད་པས་མཐའ་མའི་རྐྱེན་གྱི་ངོ་བོས་ནུས་པ་ཉིད་དོ།",
    "ཐ་དད་པ་དེ་ཡང་ཐ་མི་དད་པར་བརྗོད་པར་འདོད་པ་ན་གཅིག་པ་ཉིད་དུ་བརྗོད་༨ལ།",
    "གཞན་ཡང་དེ་ལྟ་མ་ཡིན་པ་བརྟན་༢པའི་ངོ་བོ་རྣམས་ལ་དོན་གཅིག་བྱེད་པར་ངེས་པར་བརྟགས་པའམ་དངོས་པོ་ཉེ་བར་དགོད་པ་ནི་གང་ཞིག་དེའི་ངོ་བོ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གང་གཞན་ལྷན་ཅིག་པ་དང་གཞན་འབའ་ཞིག་པ་ནི་བྱེད་པ་པོ་མ་ཡིན་པ་ཐ་དད་པར་འགྱུར་ར་རོ།",
    "གང་དེ་ལ་འབའ་ཞིག་སྐྱེད་པར་བྱེད་པར་གནས་སུ་ཟིན་ཀྱང་རྐྱེན་གཞན་ལ་ལྟོས་༨པའི་ཕྱིར་ར་རོ།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བས་སྔ་མའི་སྐྱོན་ལས་མ་འདས་པར་བསྟན་པ་ནི་དེ་ལྟ་ན་ཡང་ཞེས་པ་༩སྨོས་ཏེ།",
    "མི་ཐོགས་པ་ལས་འབྲས་བུ་མཐོང་བས་ཐོགས་པ་མེད་པར་སྐྱེད་པའི་ངོ་བོར་ཁོང་དུ་ཆུད་པར་བྱའི་གཞན་དུ་ནི་མ་ཡིན་ནོ་སྙམ་པའི་གཞན་༐",
    "ཁོ་བོ་ནི་འབའ་ཞིག་བྱེད་དོ་ཞེས་མི་༢སྨྲ་སྟེ་འོན་ཀྱང་མི་སྡོད་པར་སྐྱེད་པའི་ངོ་བོ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་བྱེད་པ་ཉིད་ཀྱང་མི་འདོད་ན་ཇི་ལྟར་མི་སྡོད་པར་སྐྱེད་པའི་ངོ་བོ་ཡིན་པར་བརྗོད།",
    "དེའི་ཚེ་འདི་སྐད་དུ་བརྫོད་པ་འདིས་ཡོངས་སུ་བསྟན་པར་བྱས་པ་མ་ཡིན་ནམ་ཅི་ཞིག་དེ་སྐྱེད་པ་ཡིན་སྙམ་ན།",
    "གང་༧འབྲས་བུ་འདི་ཉིད་གཞན་ལ་རག་ལས་པས་སྐྱེད་པར་བྱེད་པར་གནས་པ་དེ་ཡང་རྐྱེན་གཞན་ལ་རག་ལས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ནི་རིགས།",
    "རྐྱེན་གཞན་ལ་མི་འཆོལ་བར་ནི་མ་སྤངས་པར་བྱའོ།",
    "དེའི་འབྲས་བུའི་སྟོབས་ཀྱིས་སྐྱེད་པར་འགྱུར་ར་རོ།",
    "དེའི་ཕྱིར་འབྲས་བུ་རྐྱེན་གཞན་ལ་ལྟོས་༦པ་ཡིན་ནོ་༧ཞེས་བྱ་བ་ནི་མི་རིགས་པར་བརྗོད་ད་དོ།",
    "འབྲས་བུ་གཞན་ལ་ལྟོས་༡༧པར་བརྗོད་པ་འབའ་ཞིག་པའི་རྒྱུས་མི་སྐྱེད་དོ་ཞེས་གདོན་མི་ཟ་བར་སྨྲས་པ་ཡིན་ནོ།",
    "འདིས་ཀྱང་གཅིག་ཁོ་ནའི་འབྲས་བུ་ཡིན་པ་དེའི་ཕྱིར་གཅིག་ལ་སྐྱེད་པ་དང་མི་སྐྱེད་པ་ཕན་ཚུན་འགལ་བས་ཇི་ལྟར་འབྲས་བུ་གཅིག་པར་བཤད།",
    "ཕྱིར་སེམས་ནི་༡བདེ་ཞིང་བསྐྱེད་༢པར་འདོད་པ་མི་གུས་པས་དེའི་སྐྱོན་བརྗོད་པ་ན་མྱུར་དུ་སྡུག་བསྔལ་བསྐྱེད་པས་རྨ་ལ་བ་ཚ་བཏབ་པ་དང་མཚུངས་པའི་ཕྱིར།",
    "དོན་གཅིག་བྱེད་པའི་༥མཚན་ཉིད་ཀྱི་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཐམས་ཅད་དུ་ཕུལ་དུ་བྱུང་བ་སྐྱེད་པ་ནི་མི་སྲིད་དེ་གང་ལ་རྐྱེན་གྱིས་ཕན་འདོགས་པ་སྔ་མ་སྔ་མའི་རྐྱེན་རྣམས་ལས་སྐད་ཅིག་མ་ཕྱི་མ་ཕྱི་མའི་ཁྱད་པར་ཅན་དང་ཁྱད་པར་ཅན་དུ་སྐྱེད་པ་ཡོད་དེ་ལྷན་ཅིག་བྱེད་པར་བརྗོད་པར་འདོད་པ་འབྲས་བུའི་རྒྱུ་ཡིན་པར་བསྟན་ཏེ།",
    "སྐད་ཅིག་མའི་རྫས་ལ་ཁྱད་པར་ལས་བྱུང་བ་སྐྱེད་པ་མེད་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་དེ་ནི་དེ་མ་ཐག་པའི་དངོས་པོ་སྐད་ཅིག་མའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་རོ་། གལ་ཏེ་དེ་ལྟ་ན་འབྲས་ཐུག་པོ་ཆེ་ལ་སོགས་པའི་རྫས་སྐད་ཅིག་མ་ལ་ཁྱད་པར་དུ་མི་སྐྱེའོ།",
    "དེ་མ་ཐག་པ་ལས་ཀྱང་འདིར་མི་འགྱུར་བ་དེའི་ཕྱིར་ཇི་ལྟ་བའི་ཕན་ཚུན་ཁྱད་པར་ཅན་དུ་སྒྲུབ་པ་ཡང་སྐད་ཅིག་མ་དང་ལྷན་ཅིག་པ་ཁོ་ནས་བྱེད་ཀྱི་སྐད་ཅིག་མ་མ་ཡིན་པ་འབའ་༧ཞིག་པ་ལས་ནི་མ་༢ཡིན་ནོ།",
    "གང་དང་གང་སྔར་བྱེད་པ་པོ་མ་ཡིན་པ་དེ་ནི་ཕྱིས་ཀྱང་མ་ཡིན་ནོ་ཞེས་བརྗོད་པར་མི་ནུས་ས་སོ།",
    "དོན་སྣང་བ་ནི་མེད་པར་འགྱུར།",
    "ཉེ་བ་དང་མི་ཉེ་བ་ཡང་མཚུངས་པའི་ཕྱིར་ཁྱད་པར་དུ་མི་སྐྱེད་ད་དེ།",
    "གང་ལ་ཉེ་བ་ཙམ་གྱིས་མི་ཐོགས་པར་ལྷན་ཅིག་བྱེད་པས་འབྲས་བུ་བྱེད་པ་ཡིན་ན་ནོ།",
    "འོན་ཏེ་ཁྱད་པར་དུ་སྐྱེས་པའི་མཚན་ཉིད་ལ་ལྷན་ཅིག་བྱེད་པ་ཉིད་ཇི་ལྟར་རྣམ་པར་མི་གཞག་༦།",
    "དེ་ཡང་འཇིག་རྟེན་ལ་གྲགས་པའི་ཕྱིར་རྣམ་པར་གཞག་པར་བྱའོ་ཞེ་ན།",
    "དོན་དམ་པར་ན་དེ་ལ་ཡང་༥སྔ་མ་སྔ་མའི་ཚོགས་པ་ལ་ཕྱི་མ་ཕྱི་མའི་འབྲས་བུ་སྐྱེད་པར་ནུས་པ་ཁྱད་པར་ཅན་གྱི་མཚན་ཉིད་སྐད་ཅིག་མ་སོ་སོར་ངེས་སོ་ཞེས་བྱ་བའི་དོན་གཅིག་བྱེད་པའི་མཚན་ཉིད་ནི་ལྷན་ཅིག་བྱེད་པ་ཉིད་ནི་༦རྗེས་སུ་འབྱུང་ངོ།",
    "རིམ་གྱིས་༨འབྲས་བུ་ལྡོག་པར་བྱེད་པ་ཡིན་ཞེ་ན།",
    "འབྲས་བུ་སྐྱེད་པར་ནུས་པའི་ཁྱད་པར་གྱིས་ཁྱད་པར་ཅན་དུ་༡༧བསྐྱེད་ད་དོ།",
    "སྐད་ཅིག་མ་གསུམ་པས་དེ་དག་ཀྱང་ནུས་པ་ཁྱད་པར་ཅན་དང་ལྡན་པའི་མཆོག་དང་།",
    "སྐད་ཅིག་མ་བཞི་པས་དེ་དག་ཀྱང་ནུས་པའི་ཁྱད་པར་ཆེས་མཆོག་དང་ལྡན་པ་དེ་བཞིན་དུ་མཐའ་མའི་བར་དུ་ཕུལ་བྱུང་བ་དང་ལྡན་པའོ།",
    "དེ་ལྟར་ལྷན་ཅིག་པ་རྣམས་ཀྱིས་༡༧བྱ་ངོ་བོ་གཞན་ཐོབ་པ་མི་ཐོགས་པར་འབྲས་བུ་སྐྱེད་པ་འདིར་གཞན་དག་རྩོད་པ་ནི་ལྷན་ཅིག་བྱེད་པ་ལས་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཁྱད་པར་ལ་སོགས་པའི་འབྲས་བུ་འདི་སྐྱེད་པའི་ནུས་པ་གང་རིམ་གྱིས་འཕེལ་བའི་འབྲས་བུ་སྐྱེད་པར་༡འདོད་པས་དེ་སྐྱེད་པར་ནི་མི་འགྱུར་རོ།",
    "སྐད་ཅིག་མ་དང་པོ་དང་ཉེ་བར་ཕྲད་པ་རྣམས་བརྒྱུད་པས་ཁྱད་པར་སྐྱེད་པའི་ཕྱིར་དང་སྐད་ཅིག་མ་རྣམས་དབྱེ་བ་མེད་པར་ཁས་༢བླངས་པའི་ཕྱིར་རོ།",
    "ཕན་ཚུན་ཁྱད་པར་མ་ཐོབ་པ་ཉིད་འབྲས་བུ་སྐྱེད་པར་ནུས་པས་༢ིཁྱད་པར་རྩོམ་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཕན་ཚུན་འབྲས་བུ་སྐྱེད་པའི་ནུས་པས་སྐྱེད་པར་འདོད་ན་ནི་མྱུ་གུ་ལ་སོགས་པ་འབྲས་བུ་གང་ཡང་ཁྱད་པར་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བར་བསམས་ནས་དེས་ཀྱང་ཕན་ཚུན་ཁྱད་པར་དུ་སྐྱེད་པ་ན་ལྷན་ཅིག་བྱེད་པ་ལ་མི་ལྟོས་པར་འབྲས་བུ་སྐྱེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་ལྟར་གྱུར་༥ན་ཅི་ཞིག་འགྲུབ་པར་འགྱུར་ཞེ་ན།",
    "ལྟོས་༧པར་བྱ་བ་རྣམས་ལ་ངོ་བོ་ཉིད་ཁྱད་པར་དུ་སྐྱེད་པར་མི་འགྱུར་ར་རོ།",
    "གང་ཕྱིར་སུ་ལ་མཛེས་པར་འགྱུར།",
    "ཁྱད་པར་གྱི་ནི་རྒྱུ་འདི་དི་དག།",
    "ལྷན་ཅིག་བྱེད་པའི་འབྲས་བུ་སྐྱེད་པ་ནི་ནུས་པའི་ཁྱད་པར་གྱིས་སྐྱེད་པའོ།",
    "བྱས་པའི་ཁྱད་པར་ཁོ་ན་ནི་སྲེད་༥པའི་དུས་སུའོ།",
    "ཉེ་བར་གནས་པར་གྱུར་པ་དེ་ལྟ་ན་ནི་ཐུག་པ་མེད་པར་འགྱུར་ར་རོ།",
    "འདི་ལྟར་༦དེ་ཁྱད་པར་དུ་སྐྱེད་ན་ཡང་ལྷན་ཅིག་བྱེད་པའི་བྱེ་བྲག་གཞན་གྱིས་བྱས་པར་ཁས་བླང་བར་བྱ་སྟེ།",
    "ལྷན་ཅིག་བྱེད་པ་རྣམས་ནི་ཞིང་དང་ས་བོན་ལ་སོགས་པ་ཕན་ཚུན་འབྲས་བུ་སྐྱེད་པ་རྗེས་སུ་འབྲང་༨བའི་ཁྱད་པར་དེ་ལས་སྐྱེད་པར་རུང་བར་རྟག་ཏུ་གནས་པ་མ་ཡིན་ཏེ།",
    "དེ་དག་ཞིང་དང་ས་བོན་ལ་སོགས་པ་རྣམས་ཡོད་པར་རུང་བའི་ཡུལ་དང་ཉེ་བར་ཕྲད་པའོ།",
    "འབྲས་བུ་གསལ་བར་མཐོང་བའི་ཕྱིར་ནི་འབྲས་བུ་སྐྱེད་པར་མཐོང་བས་ས་སོ།",
    "གལ་ཏེ་འབྲས་བུ་སྐྱེད་པར་ནུས་པའི་ཁྱད་པར་དུ་སྐྱེད་པ་ནི་ཐམས་ཅད་ཀྱི་ཚེ་རིང་བར་གནས་པར་འགྱུར་བས་དེའི་ཚེ་ཡང་ཐམས་ཅད་ཀྱི་ཚེ་ཁྱད་པར་དུ་འགྱུར་རོ།",
    "དེ་ཡང་དེ་བརྒྱུད་པས་འབྲས་བུ་འབྱུང་ངོ་སྙམ་ན་དེ་ཡོད་པ་དང་མེད་པ་དག་འབྲས་བུ་སྐྱེད་པ་དང་མི་སྐྱེད་པར་མི་འགྱུར་ར་རོ།",
    "དེའི་ཕྱིར་ལྷན་ཅིག་བྱེད་པའི་འབྲས་བུ་སྐྱེད་པ་ནི་ནུས་པའི་ཁྱད་པར་ལས་རུང་བའི་གནས་སྐབས་ན་སྐྱེའི་ཐམས་ཅད་དུ་མ་ཡིན་ན་ནོ།",
    "པ་ལས་༥ཚོགས་པའི་གནས་སྐབས་ན་སྐྱེད་པའི་ཕྱིར་དཔེར་ན་སྐད་ཅིག་མ་རྣམས་དོན་གཅིག་པར་བྱེད་པ་སོ་སོར་ངེས་པའི་མཚན་ཉིད་ཀྱི་ལྷན་ཅིག་བྱ་ཏྲ་བྱེད་པ་དེ་བཞིན་དུ་བརྟན་པའི་རང་བཞིན་ཡང་འགྱུར་ཏེ་ཐབས་ཐམས་ཅད་ཟབ་༡པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཡང་དང་ཡང་བརྗོད་ཀྱང་འཇིག་རྟེན་གྱི་རིགས་༢ིརྟོགས་པར་འགྱུར་ན་བརྒྱ་ཕྲག་༤སྨྲས་པས་ཅི་ཞིག་བྱ།",
    "ལན་གཉིས་དང་གསུམ་གཞན་གྱི་དོན་ལ་མི་འཇུག་པ་ལ་ཁོ་བོ་ཅག་ཡང་དང་ཡང་དུ་རྗོད་༢པར་བྱེད་པ་ལ་ཅུང་ཟད་ཀྱང་ཡིད་སྐྱོ་བར་མི་འགྱུར་རོ།",
    "མཐུན་པའི་༧ཁྱད་པར་དུ་བྱེད་པའི་ལྷན་ཅིག་བྱེད་པ་སྤངས་པར་འགྱུར་རོ།",
    "དེ་ཡང་ཐོག་མར་ཕྲད་པ་ལ་རྟེན་པ་ཡོད་པ་ཉིད་ཡིན་ན་ཅིས་ན་ལྷན་ཅིག་བྱེད་པར་མི་འགྱུར།",
    "གཞན་གྱིས་སྨྲས་པ་དོན་གཅིག་བྱེད་པར་ཁས་བླངས་ན་དེའི་༐",
    "ཚེ་སོ་སོའི་༢གནས་སྐབས་དེ་ན་༩སྐྱེད་པར་ནུས་པར་ཁས་བླངས་པས་དེའི་གནས་སྐབས་ལྟ་བུར་སོ་སོ་བ་༡༧ལ་ཡང་འགྱུར་རོ།"
  ]
}