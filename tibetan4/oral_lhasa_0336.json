    "སྐྲག་པས་དངོས་གྲུབ་སྦྱིན་པར་བྱེད་དོ།",
    "ཀྱིས་བསྟན་པར་མི་བྱའོ།་།",
    "མཱ་མ་ཏཱི་ནི་ལས་ཐམས་ཅད་ལ་ཡང་བསྟན་པར་བྱའོ།",
    "གང་ན་མཱ་མ་ཏཱི་གནས་པ་དེ་ན་ལག་པས་ཇི་ལྟར་བསྟན་པར་བྱ་བ་དེ་བཞིན་དུ་ས་ལ་ཡང་བྲིའོ།",
    "མཐུ་སྟོབས་ཆེན་པོ་སྣ་ཚོགས་རྣམས་བསྟན་༡པར་བྱའོ།",
    "ཕྱག་རྒྱའི་ཚོགས་ཀྱིས་བསྐོར་བའི་མཱ་མ་ཁྲིའི་ཕྱག་རྒྱས་བཀོད་ལ་མཱ་མ་ཁྲིའི་གཟུགས་ཀྱང་གཞག་པར་བྱ་སྟེ།",
    "མཱ་མ་ཁྲིའི་མདུན་དུ་བཟླས་བརྗོད་བྱས་པ་དེས་བསྲུང་བར་བྱའོ།",
    "མཆོད་རྟེན་གྱི་དྲུང་ངམ་སྐུ་གཟུགས་ཀྱི་གནས་སུ་ཕྱག་རྒྱའི་ཚོགས་དགོད་པར་བྱའོ།",
    "གཞན་དུ་བཞག་ན་བརྟག་པའམ་གནོད་པ་༦དབྱེད་པར་འགྱུར་རོ།",
    "མཱ་མ་ཁྲིའི་ཕྱག་རྒྱའི་ཚོགས་ཀྱིས་བསྐོར་བ་ཡང་གཞག་པར་བྱ་༩སྟེ་གཟུགས་སུ་གཞག་པར་བྱའོ།",
    "ཟུག་རྔུ་ཡོད་པའི་སར་བྲིས་ན་ནི་གནོད་པ་བྱེད་པར་འགྱུར་ཏེ།",
    "ཞག་གཅིག་སྨྱུང་བར་བྱས་པའི་ཉི་མ་བཟང་བ་ལ་རིག་པའི་རྒྱལ་པོས་བསྲུང་བའི་ཆོ་ག་བྱས་ཏེ།",
    "ཀཱརྶཱ་པ་ཎ་༦བརྒྱ་རྩ་བརྒྱད་ཀྱིས་རྡོ་རྗེ་རྫོགས་པར་བྱས་ཏེ།",
    "ཤིན་ཏུ་མཉམ་པར་བཞག་པས་ཙནྡན་དམར་པོའི་ཆུས་བསང་༥༧གཏོར་བྱས་ལ་ལག་པས་མནན་ནས།",
    "དེ་ནས་མཱ་མ་ཁྲིའི་གཟུགས་སུ་བྱས་ལ།",
    "མཱ་མ་ཁྲིའི་རིག་སྔགས་ཀྱིས་བརྗོད་པར་བྱའོ།",
    "གཏོར་མའི་ཆོ་ག་ཡང་རྒྱས་པར་བྱའོ།་།",
    "རིག་སྔགས་ཀྱི་རྒྱལ་པོ་ཡང་མཱ་མ་ཁྲིའི་དྲུང་དུ་གཞག་པར་བྱའོ།",
    "དེ་ནས་རིག་སྔགས་ཀྱི་རྒྱལ་པོ་བཟླས་བརྗོད་བྱེད་བཞིན་དུ་དངོས་གྲུབ་གསོལ་དུ་བཅུག་༦ན་ཆོ་ག་རྒྱས་པའི་དངོས་གྲུབ་སྦྱིན་པར་བྱེད་དམ།",
    "མཐོང་ན་ཇི་སྐད་སྨྲས་པ་དེ་དེ་ལ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ཅི་སྟེ་ཁྲོ་བའི་སེམས་ཀྱིས་སྨྲས་ན་ནི་ལས་དྲག་པོར་འགྲུབ་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་དགའ་བའི་སེམས་ཀྱིས་སྨྲས་ཚོ་ན་ནི་དངོས་གྲུབ་མཆོག་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ལག་ཏུ་ཐོབ་ན་མཱ་མ་ཏཱིའི་ཆོ་ག་རྒྱས་པའི་དངོས་གྲུབ་བདེ་བླག་ཏུ་འགྲུབ་པར་འགྱུར་རོ།",
    "བསྒྲུབ་པའི་ཚེ་སྤྱན་གྱིས་མཱ་མ་ཏཱི་གཞག་པར་བྱའོ།",
    "ཨུཏྤ་ལ་དང་ལྡན་པས་ཀྱང་མཱ་མ་གཱི་གཞག་པར་བྱའོ།",
    "དེ་ནས་ཆོ་ག་རྒྱས་པ་༨འགྲུབ་པར་འགྱུར་ཏེ།",
    "ཆོད་པ་བྱས་ནས་དངོས་གྲུབ་གསོལ་དུ་གཞུག་གོ།",
    "དངོས་གྲུབ་བྱིན་ནས་ཀྱང་ཞག་བདུན་པའི་ཉིན་པར་གློ་༧བུར་དུ་མི་ནག་པོ་མཐོང་བར་འགྱུར་ཏེ།",
    "མཐོང་ན་ཆོ་ག་རྒྱས་པ་༡༧འགྲུབ་པར་ཤེས་པར་བྱའོ།",
    "ཚོགས་རྣམས་ལ་ཡང་གཏོར་མ་སྦྱིན་པར་བྱའོ།",
    "ཕོ་ཉ་མ་དརྣམས་ཀྱི་ལས་རྣམས་ལ་ནི་ལན་འབུམ་བཟླས་བརྗོད་བྱས་ན་འགྲུབ་པར་འགྱུར་རོ།",
    "ལག་པ་གཡོན་པ་ལ་རྡོ་རྗེ་འབར་བ་ཐོགས་པར་བྲིའོ།",
    "དེའི་གཡོན་ལོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་པ་དབྱུག་པ་ལ་བཙུགས་༢པར་བྲིའོ།",
    "རྣམ་པར་རྒྱལ་བའི་ནི་དེ་ཉིད་ལས་དབུས་ནས་འབྲས་བུ་རི་བྱས་ལ་གཡས་ཕྱོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཅིག་པ་མེ་ལྕེ་འབར་བ་གསུམ་དང་ལྡན་པ་དབྱུག་པ་༩ལ་བཙུགས་པ་ཡིན་ནོ།",
    "རྡོ་རྗེ་མཚན་གྱི་ནི་སྟེགས་བུའི་སྟེང་ཚདུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་༡༡དབུས་དྲང་པོར་བྱས་པའོ།",
    "མདུང་རྩེ་གསུམ་པ་ནི་སྟེགས་བུའི་སྟེང་དུ་མདུང་རྩེ་གསུམ་པ་ཁ་གཉིས་པ་དབུས་དྲང་པོར་བྱས་ལ།",
    "སྙེ་མ་ལྔ་པོ་ཡོད་པར་བྲིས་ལ།",
    "རྣམ་པར་རྒྱལ་བའི་ནི་ཚངས་པའིའོ།",
    "འདི་རྣམས་གཞག་པར་བྱའོ།",
    "མཱ་མ་གཱི་ཡང་མཚན་ཉིད་ཇི་ལྟ་བ་བཞིན་གཞག་པར་བྱ་སྟེ།",
    "མཱ་མ་གཱིའི་མདུན་དུ་རྣམ་པར་རྒྱལ་བའི་རྒྱུད་ཆེན་པོ་ལས་ཉི་མ་དང་ཟླ་བ་སྟོབས་དང་ཕ་རོལ་གནོན་པ་གཞན་གྱིས་མི་ཐུབ་པ་དང་།",
    "འདི་དག་ཐམས་ཅད་ཀྱང་གཟུགས་སུ་གཞག་པར་བྱའོ།",
    "དེ་ནས་བཟླས་བརྗོད་བྱས་ན་ལས་གྲུབ་༢པར་འགྱུར་རོ།",
    "དེ་ནས་ཞི་བའི་ལས་བྱེད་ན་རྣམ་པར་རྒྱལ་བ་དང་།",
    "དབྱུག་པ་རྣམས་མཱ་མ་ཏཱི་དང་ལྷན་ཅིག་ཏུ་གཞག་པར་བྱ་སྟེ།",
    "མཱ་མ་ཏཱི་ཡང་མཚན་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་གཞག་པར་བྱའོ།",
    "དེ་ནས་ལས་བརྩམ་པར་བྱའོ།",
    "དེ་ནས་བཟླས་བརྗོད་བྱས་ན་ལས་འགྲུབ་པར་འགྱུར་རོ།",
    "དེའི་མདུན་དུ་གཏོར་མའི་ཆོ་ག་བྱས་ཏེ་དེ་ནས་ལས་བརྩམ་ཚོ་པར་བྱའོ།་།",
    "རྣམ་པར་རྒྱལ་བ་ལ་ནི་མར་དང་འབྲས་ཀྱིའོ།",
    "ཡང་ན་ཚོགས་ཀྱི་ཕྱག་རྒྱ་རྣམས་བཀོད་ལ་བསྒྲུབ་པར་བྱའོ།",
    "ཡིད་ལ་སྨོན་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་དོ།",
    "ཅི་འདོད་པ་བཞིན་དུ་ལྷ་དེས་ནསབྱེད་པར་འགྱུར་རོ།",
    "ཕྱག་རྒྱ་དེ་དག་ལས་གང་ཡང་རུང་བ་བཞག་ནས་བསྙེན་བཀུར་དབྱས་ན་ཕྱག་རྒྱ་རྣམས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "དེ་ཕྱིན་ཆད་ལས་ཐམས་ཅད་ལ་ཕྱག་རྒྱ་བཞག་ནས་ལས་༤༤བསྒྲུབ་པར་བྱའོ།",
    "ཁང་པ་སྟོང་པར་རིག་སྔགས་ཀྱི་རྒྱལ་པོས་མཱ་མ་ཏཱི་དང་།",
    "མཇུག་ཞག་གསུམ་གྱི་བར་དུ་སྨྱུང་བར་༩བྱས་ནས།",
    "གདོང་དམར་གྱི་གཟུགས་ཙནྡན་དཀར་པོའི་ཕྱེ་མ་ལས་བྱས་ཏེ་༡་གཡས་ཕྱོགས་སུ་གཞག་གོ།་",
    "ལྷ་བཤོས་གཙང་ཚམ་སྣ་ཚོགས་ཅི་འདོད་པ་ཡང་དབུལ་ལོ།",
    "དེ་ནས་ཡིད་ལ་ཅི་བསམས་པ་དེ་ལྷ་དེས་བྱེད་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་ལས་འདི་བྱས་ཀྱང་མ་འོངས་ན་མཱ་མ་ཁྲིའི་ཕྱག་རྒྱ་རྣམས་ཀྱི་༡སྦྱིན་སྲེག་ལན་བརྒྱ་བྱས་ན་ལྷ་དེ་གཅིཚིག་བཞིན་དུ་དེ་ཉིད་དུ་འོང་བར་འགྱུར་རོ།",
    "དེའི་མགོ་བོ་ངས་སརྡོ་རྗེ་ཀུན་ཏུ་འབར་ཞིང་རབ་ཏུ་འབར་བས་གཞོམ་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱང་མངོན་དུ་ཕྱོགས་པར་འགྱུར་ཏེ་།",
    "རྨི་ལམ་དུའང་སྟོན་པར་༢༡མཛད་དོ།",
    "རྡོ་རྗེའི་རིགས་ཀྱང་རྟག་ཏུ་ཝ་སྟོན་པར་བྱེད་དོ།",
    "དེ་ནས་ནང་པར་ལངས་ཏེ་༡༨ཁྲུས་བྱས་ལ་གཙོ་བོ་ལག་ན་རྡོ་རྗེ་དང་།",
    "བདག་དང་མི་གསུམ་ལ་མཆོད་སྟོན་བྱས་ཏེ་༥༡།",
    "མར་ལ་སོགས་པ་དང་ལྡན་པའི་ཟས་གནང་བ་གང་ཡིན་པ་རྣམས་བཟའ་བར་བྱ་སྟེ།",
    "དེ་ནས་ཆོ་ག་རྒྱས་པའི་ལྷ་ཐམས་ཅད་རྡོ་རྗེ་རིགས་དང་བཅས་པ་རྣམས་གྲུབ་པར་འགྱུར་ཏེ།",
    "ནང་པར་ལངས་ནས་ཚོགས་རྣམས་དང་།་",
    "མཱ་མ་ཏཱི་དང་བཅས་པའི་མིང་ཡང་དག་པར་དྲན་པར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་མཚམས་མེད་པའང་འགྲོལ་བར་འགྱུར་ཏེ།",
    "དེ་ནས་མཱ་མ་གཱི་བསྒྲུབ་པར་བྱ་སྟེ།",
    "ཐོག་མར་གཟུགས་བཟང་མས་ལས་བྱས་ལ་དེ་ནས་མཱ་མ་ཏཱི་བཟླས་བརྗོད་བྱ་སྟེ།",
    "ལྷ་རྣམས་ངས་ཀྱང་མཱ་མ་ཏཱི་བླངས་ནས་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ཡོངས་སུ་རྫོགས་པར་བྱས་སོ།",
    "རིག་སྔགས་འཆང་མཱ་མ་ཏཱི་མཆོད་དམ་འཆང་༡བར་བྱེད་པ་གང་ཡིན་པ་དེ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་མངོན་དུ་ཕྱོགས་པར་འགྱུར་རོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་མངོན་དུ་ཕྱོགས་པར་འགྱུར་བས་ནརིག་སྔགས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ངན་འགྲོའི་འཇིགས་པ་ཡང་མེད་པར་འགྱུར་རོ།",
    "རིག་སྔགས་འཆང་དེ་ལ་གཡས་ཕྱོགས་སུ་བསྐོར་ནས་རྣ་བ་གཡས་པའི་ནང་དུ་འཇུག་པར་འགྱུར་རོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ལག་ན་རྡོ་རྗེས་༦རིག་སྔགས་དེ་༧བླངས་ནས་དགའ་ལྡན་གྱི་གནས་སུ་འཇོག་པར་བྱེད་དོ།",
    "འཕགས་པ་བྱམས་པ་དང་ལྷན་ཅིག་ཏུ་གནས་པར་འགྱུར་རོ།",
    "བསྒྲུབ་པ་ཐམས་ཅད་ལ་ཕྱག་རྒྱ་གཅིག་གཞག་པར་བྱའོ།",
    "དམ་ཚིག་མི་ཤེས་པ་ལ་ནི་ཕྱག་རྒྱ་༩༡རིབསྟན་པར་མི་བྱའོ།",
    "སྡིག་༥པ་བྱེད་པ་རྣམས་ལ་བསྟན་པར་མི་བྱའོ།",
    "ངའི་ཕྱག་རྒྱའི་ཚོགས་གསང་བ་འདི་ནི་གཙང་བ་དང་།",
    "དབེན་པར་བལྟ་བར་བྱ་སྟེ།",
    "དེ་ལྟར་བྱས་ན་༡་བཅོམ་ལྡན་འདས་ལག་ན་རྡོ་རྗེས་བྱིན་པ་༡༡ཡིན་ཏེ་ཆོ་ག་རྒྱས་པ་ཡང་འགྲུབ་པར་འགྱུར་རོ།",
    "ང་མཐོང་བས་དེ་དག་ངེས་པར་ཕྱིར་མི་ལྡོག་པའི་འབྲས་བུ་དང་ལྡན་པར་འགྱུར་རོ།",
    "དེ་མཐོང་ནས་ཆོ་ག་བཞིན་དུ་ཕྱག་རྒྱ་ཆེན་པོ་བསྒྲུབ་པར་བྱའོ།",
    "གང་ཐོས་ན་ཚངས་པར་མ་༦སྤྱད་པ་ཡང་ཚངས་པར་སྤྱོད་པར་༧འགྱུར་བ་དང་།",
    "ཐུབ་པར་མ་བྱས་པ་ཡང་ཐུབ་པར་བྱས་པར་འགྱུར་བ་དང་།",
    "གང་ལགས་པ་ནི་བདག་ལགས་ཏེ་བཅོམ་ལྡན་འདས་དེ་དེ་ལེགས་༡་སོ།",
    "བཀླགས་ན་བསྟོད་པར་འགྱུར་ཏེ།",
    "བདུད་བཞི་ལས་རྣམ་པར་རྒྱལ་བར་འགྱུར་རོ།",
    "དཀྱིལ་འཁོར་དུ་མ་ཞུགས་པས་ཀྱང་དེ་ལྟར་བྱས་ན་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་༡་ཞུགས་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་མ་བྱས་ན་ཤ་བསྟེན་༡པས་ལོག་འདྲེན་རྣམས་ཀྱིས་ཚུགས་པར་འགྱུར་ཏེ་ལོག་འདྲེན་རྣམས་ཀྱིས་གཙེས་པ་ལ་ནི་རིག་པ་མཆོག་འགྲུབ།",
    "པར་མི་འགྱུར་རོ།",
    "བགེགས་རྣམས་ཀྱང་འཇིགས་པར་བྱེད་པ་དང་༡།",
    "ལྷ་རྣམས་ཀྱང་འགྲུབ་པར་བྱེད་པ།",
    "ཀླུ་རྣམས་ཀྱང་འདྲེན་པར་བྱེད་པ།",
    "འབྱུང་པོ་ཝ་རྣམས་ཀྱང་སྐྱོད་པར་བྱེད་པ་དང་།",
    "འཁྲུལ་འཁོར་གཞོམ་པར་བསྟན་པ་ལ།",
    "མྱུར་དུ་ལས་རྣམས་ངེས་པར་བྱེད།",
    "རྡོ་རྗེ་འཛིན་པས་གསད་པར་༥༨",
    "རྒྱལ་བ་དང་ནི་རྣམ་པར་རྒྱལ།",
    "ལས་རྣམས་ཀྱང་ནི་བསྟན་པར་བྱ།",
    "མཐེ་བོང་གཉིས་ཀྱི་ཕྱི་རོལ་དུ་བཞག་པ་ནི་རིག་སྔགས་ཀྱི་རྒྱལ་པོ་རབ་ཏུ་གྲུབ་པར་བྱེད་པའི་རྩ་བའི་ཕྱག་རྒྱའོ།",
    "ཁྲོ་བོ་རྣམ་པར་མི་བཟད་པའི་ཕྱག་རྒྱ་ཡང་དེ་ཉིད་ཡིན་ནོ།",
    "གདོན་ཐམས་ཅད་འཇིགས་པར་བྱེད་པ་༧འབྱུང་སྟེ།",
    "དེ་ལྟར་དེ་ལྟ་བུའི་ཚུལ་གྱིས་ཕྱག་རྒྱ་གྲངས་མེད་པར་འབྱུང་ངོ།",
    "དེ་ལྟར་དེ་ལྟ་བུའི་ཚུལ་དུ་ཕྱག་རྒྱ་གྲངས་མེད་པར་འབྱུང་ངོ།",
    "སྙིམ་པ་བཀན་ལ་མཐེའུ་ཆུང་གཤིབས་ནས་དེའི་རྒྱབ་ནས་སྲིན་ལག་གཤིབས་པར་བྱ།",
    "དེ་ལྟར་དེ་ལྟ་བུའི་ཚུལ་གྱིས་ཕྱག་རྒྱ་གྲངས་མེད་པར་འབྱུང་ངོ།",
    "མཐེ་བོ་༡གེགཉིས་བསྟོད་དེ་རྩེ་གཅིག་པའི་ཚུལ་དུ་བྱས་པ་ནི་གདོན་ཐམས་ཅད་སྐྲག་པར་བྱ་བའི་ཕྱག་རྒྱའོ།",
    "སྟེང་ནས་གདུ་བུ་ལྟར་བྱས་པ་ནི་རྡོ་རྗེ་ལྕགས་ཀྱུ་མའི་ཕྱག་རྒྱའོ།",
    "དེ་ཉིད་ལས་མཐེ་བོང་རྩེ་གཅིག་པའི་ཚུལ་དུ་བཞག་པ་ནི་གདོན་བསྐྲད་པར་བྱ་བ་ཡིན་ནོ།",
    "དེ་ལྟར་དེ་ལྟ་བུའི་ཚུལ་གྱིས་ཕྱག་རྒྱ་གྲངས་མེད་པར་འབྱུང་ངོ།",
