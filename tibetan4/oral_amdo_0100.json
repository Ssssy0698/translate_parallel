    "ཞེས་རང་གིས་ཉམས་སུ་མྱོང་པས་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་གསང་བ་འདུས་པ་སོགས་ལས་མཚན་མོའི་རྣལ་འབྱོར་གྱི་རྟགས་རྣམས་གསུངས་ལ།",
    "ཉིན་མོའི་རྣལ་འབྱོར་གྱི་རྟགས་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཉིན་མོའི་རྣལ་འབྱོར་གྱིས།",
    "གཟི་བརྗིད་ཆེན་པོ་འོད་གསལ་བ་ནི་གློག་སྟེ་མཆོག་གི་ཆའོ།",
    "དེ་ལྟར་མཚན་མ་རྣམ་པ་བཅུ་སྟེ་འདུས་པ་ལ་སོགས་པ་ལས་མཚན་མོའི་རྣལ་འབྱོར་དང་མཚན་ཡང་དག་པར་བརྗོད་པ་ལས་ཉིན་མོའི་རྣལ་འབྱོར་གྱིས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "ཡེ་ཤེས་ཀྱི་སྐུ་དེ་སེར་པོ་འབར་བ་ལ་སོགས་པ་ཉིན་རྟགས་དྲུག་གི་རྣམ་པར་བཞུགས་པར་གསུངས་པའི་ཕྱིར།",
    "རྣམ་པ་གཉིས་སུ་འགྱུར་བ་སྟེ་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དེ་དག་ལས་མངོན་སུམ་གང་ཡིན་པ་དག་ནི་དེ་ཉིད་སྦྱོར་བས་མཁའ་ལ་སྐར་མ་བཞིན་དུ་འགྱུར་ཏེ་སྐར་མའི་ཚོགས་བཞིན་དུ་དུ་མ་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ཞེས་པ་ནི་ཤ་ལ་སོགས་པའི་མིག་གིས་གཟུང་བར་བྱ་བ་སྲིད་པ་གསུམ་དང་དུས་གསུམ་རྨི་ལམ་དང་སྒྱུ་མ་དང་མཚུངས་པའོ།",
    "འདིར་གང་གི་ཚེ་སོ་སོར་སྡུད་པས་གཟུགས་བརྟན་པར་གྱུར་པའི་རྣལ་འབྱོར་པ་རྣམ་པར་དག་པར་གྱུར་པ་དེའི་ཚེ་སྔགས་རྣམས་ཀུན་གྱིས་བྱིན་གྱིས་རློབ་པར་འགྱུར་ཏེ་ཚིག་གིས་མཆོག་སྦྱིན་པ་ལ་སོགས་པ་སྦྱིན་པར་འགྱུར་རོ།",
    "ངག་གི་བདེན་པའི་ལས་རྣམས་འགྲུབ་པ་ནི།",
    "མཐར་ཐུག་གི་འབྲས་བུ་རྣལ་འབྱོར་བའི་སྒྲིབ་བཅས་ཀྱི་ཡེ་ཤེས་ཀྱི་ཕུང་པོ་དང་།",
    "ལྟ་སྟངས་མིག་གི་ཕྱེད་འོག་མ་དཀར་པོའི་ཆས་བཀབ་པ་དང་ཕྱེད་གོང་མ་དཀར་པོས་མ་བཀབ་པ་ནག་ཧྲིག་གེ་བ་གནས་པ་མིག་དག་གིས།",
    "ལག་པ་མཉམ་བཞག་གི་ཕྱག་རྒྱ་བྱ་བར་སྙན་བརྒྱུད་ལས་འབྱུང་ངོ།",
    "དཔྱོད་པ་ཞེས་པ་ནི་དེའི་དོན་ཕྲ་མོ་ཞིབ་ཏུ་ངེས་པར་བྱེད་པའོ།",
    "ཉིན་མོ་བསྒོམ་ཚུལ་གྱི་ཡན་ལག་སྣ་ཚོགས་ལ་བསླབ་པ་དང་།",
    "མཚན་མོ་གཉིད་ཀྱི་འོད་གསལ་བཟུང་བ་དང་ཐུན་བསྒོམ་གྱིས་མཉམ་རྗེས་བསྲེ་བ་དང་གསུམ་མོ།",
    "ཉིན་མོའི་རྣལ་འབྱོར་གྱིས་ཕྱི་རོལ་ལས་ཀྱི་སྣང་བའི་སྟེང་དུ་འོད་གསལ་ལ་སེམས་གཟུང་བཟུང་སྟེ།",
    "དེ་ཡང་ནམ་མཁའ་ལ་ལྟ་སྟངས་གཏོད་བསྟོད་དེ་བསྒོམས་པས་སྟོང་གཟུགས་དང་པོ་གང་གསལ་བ་ནས་ཇེ་དམའ་དང་ཇེ་ཉེར་ཕབ་སྟེ་ལས་སྣང་གང་ཡང་རུང་བ་ཅིག་གི་སྟེང་དུ་སྟོང་གཟུགས་ལ་སེམས་གཟུང་པས་ཕྲ་བའི་འོད་སྟོང་གཟུགས་ལ་བརྟེན་ནས།",
    "ཡང་མིག་བཙུམ་པ་ཉིད་ལ་སྟོང་གཟུགས་གསལ་ན་རྩ་གསུམ་ཁོག་གཅིག་ཏུ་འབྲེལ་བའི་གནས་ལྟེ་བའི་གནས་སུ་ཨ་བ་དྷཱུ་ཏཱིའི་ནང་དུ་སེམས་གཏད་དེ་འོད་གསལ་བཟུང་བས་སེམས་རྟོག་མེད་གསལ་སྟོང་གི་དེ་ཉིད་ཤེས་ཤིང་།",
    "གྲིབ་གཟུགས་ལ་གཏེར་རྟོག་ན་ཉི་མ་ལས་ནི་གདོང་གཞན་དུ་ཕྱོགས་ཏེ་མདུན་དུ་ཉི་འོད་ལ་གནས་པའི་རང་གི་གྲིབ་མ་བརྟན་ཅིང་མི་འགྱུར་པ་པའི་མིག་གིས་ཡུན་རིང་དུ་བལྟ་བར་བྱ་སྟེ།",
    "དེ་ལྟར་ཟླ་བ་དྲུག་ཏུ་གོམས་པའི་སྦྱོར་བ་དག་ལས་ས་ལ་གནས་པའི་གཏེར་ནི་ས་ཡི་བུ་གར་མཐོང་པར་འགྱུར་རོ་ཡང་ན་ཤིང་གི་དྲུང་དུ་བསྡད་ནས་ཤིང་གི་གྲིབ་མར་མིག་མི་འགྱུར་བར་རྩེ་གཅིག་ཏུ་རབ་ཏུ་ཞུགས་ཏེ་བལྟས་ན་ཕྱི་ནས་ནམ་མཁའི་མཐིལ་དུ་གྲིབ་མའི་གཟུགས་བརྙན་གྱི་བར་བར་གྱི་ཐིག་ལེའི་ཕྲེང་པ་ལྟ་བུར་སྣང་པ་ཟླ་དྲུག་ཏུ་གོམས་པ་ར་གྱུར་པས་སོ་ས་ལ་གནས་པའི་གཏེར་མཐོང་ངོ།",
    "ཡང་ན་ལྗོན་ཤིང་གི་དྲུང་དུ་བསྡད་ནས་ཤིང་གི་གྲིབ་མ་ལ་ལྟ་སྟངས་གཡོ་བ་མེད་པར་བལྟ་ཞིང་བསམ་གཏན་ཡུན་རིང་དུ་བསྒོམ་མོ།",
    "དེ་ལྟ་བུ་ཟླ་བ་དྲུག་གི་བར་དུ་བསྒོམས་ནས་ས་འོག་ན་ཡོད་པའི་གཏེར་མཐོང་པར་འགྱུར་རོ།",
    "མཚན་མོ་གཉིད་ཀྱི་འོད་གསལ་བཟུང་བ་ནི།",
    "སྣང་པ་ཡང་སྟོན་ཁའི་ནམ་མཁའ་དྭངས་པ་ལ་ཟླ་བའི་འོད་ཤར་བ་ལྟ་བུ་གསལ་སྟོང་གི་ཉམས་ཤས་ཆེ་བ་ལ་སྔར་མཐོང་བའི་སྟོང་གཟུགས་རྣམས་ཀྱང་སལ་ལེ་སྣང་བ་འབྱུང་།",
    "གཉིད་སྲབ་ན་གཉིད་སྲབ་མོའི་འོད་གསལ་ཟིན་པའི་རྟགས་བསྒོམ་ཁང་སྐྱ་སེང་ངེ་བ་འོད་གསལ་ལམ་མེ་བ་གཉིད་དུ་མ་སོང་ངམ་སྙམ་པ་ལ་གཉིད་སད་རྒྱུ་ཡང་ཡོད་པ་གཉིད་དུས་སུ་མཐོང་བའི་སྟོང་གཟུགས་རྣམས་ཀྱང་སྔར་བས་ཀྱང་གསལ་བར་སྣང་བ་འབྱུང་ངོ།",
    "རེ་དོགས་དང་དགག་སྒྲུབ་ལ་སོགས་པའི་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བའི་ངང་ནས་གང་ཤར་ལ་རྩེ་གཅིག་ཏུ་ལྟ་ཞིང་བསམ་གཏན་གྱི་ཡན་ལག་གིས་བརྟན་པའི་ངང་ལ་ལྷན་གྱིས་བཞག་པས་ཉིན་ཞག་གསུམ་བཞིའམ་དྲུག་བདུན་ཙམ་གྱི་བར་དུ་རིག་པ་འོད་གསལ་གྱི་དབྱིངས་སུ་བརྒྱལ་བ་བཞིན་དུ་གནས་ཤིང་།",
    "གལ་ཏེ་སྐལ་བ་དམན་པས་མཆོག་གི་དངོས་གྲུབ་མ་ཐོབ་ན་རིག་པ་འཛིན་པའི་གོ་འཕང་ཐོབ་པར་འགྱུར་ཏེ།",
    "ཤུགས་ཆད་པའི་ཉམས་ལ་སོགས་པ་ལ་སྦྱར་སྦྱང་ཞིང་བསྒོམ་མོ།",
    "ནང་དུ་ལུས་སེམས་ལ་བདེ་སྡུག་གི་སྣང་བ་ལ་སོགས་རྐྱེན་གང་བྱུང་ཡང་དེ་ཉིད་ཀྱི་སྟེང་དུ།",
    "རྗེས་ཐོབ་ཐམས་ཅད་དུ་མཉམ་བཞག་གིས་ཟིན་པར་བསྒོམས་པས་རིམ་གྱིས་མཉམ་རྗེས་འདྲེས་པར་འགྱུར་རོ།",
    "མིག་འཕྲུལ་མཚུངས་པར་གང་གིས་མཐོང་།",
    "མཐོང་བ་དང་ནི་རེག་པ་ཉིད།",
    "ལྷ་མོས་བསྐུལ་ལ་ལུང་བསྟན་ཐོབ།",
    "དག་བྱེད་ལ་དབྱེ་ན་ཤེས་རབ་ལ་སོགས་པ་བསམ་གཏན་གྱི་ཡན་ལག་ལྔ་པོ་རང་རང་གི་ཡུལ་ལྔ་དང་བཅས་པ་རྣམ་པ་བཅུ་སྟེ།",
    "མཐར་ཐུག་གི་འབྲས་བུ་རྣལ་འབྱོར་བའི་སྒྲིབ་བཅས་ཀྱི་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་དང་།",
    "ཕྱག་ན་རྡོ་རྗེའི་བདེ་མཆོག་སྟོད་འགྲེལ་ལས་གསུངས་པ་ལྟར་སྐུའི་ཐིག་ལེའི་དམ་ཚིག་དང་གསུང་གི་ཐིག་ལེའི་དམ་ཚིག་དང་།",
    "ཐུགས་ཀྱི་ཐིག་ལེའི་དམ་ཚིག་དང་ཡེ་ཤེས་ཀྱི་ཐིག་ལེའི་དམ་ཚིག་སྟེ་དམ་ཚིག་བཞི་པོ་རེ་རེ་ཡང་དགའ་བ་དང་མཆོག་དགའ་དང་ཁྱད་པར་གྱི་དགའ་བ་དང་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བ་སྟེ་བཞི་བཞིས་ཕྱེ་པའི་ངེས་དོན་གྱི་དམ་ཚིག་བཅུ་དྲུག་བསྲུང་བར་བྱ་སྟེ།",
    "འཚེ་དང་མི་བདེན་གཞན་གྱི་བུད་མེད་སྤང་བྱ་གཞན་གྱི་ནོར་དང་ཆང་གི་བཏུང་བ་དེ་བཞིན་ཉིད།",
    "སྣ་ཚོགས་གཙོ་བོའི་བཀའ་འདི་སྲིད་པའི་འཇིགས་པ་འཇོམས་པ་དག་སྟེ་ཁྱོད་ཀྱིས་ཀྱང་ནི་བརྐྱང་པར་བྱ།",
    "ལམ་བཟང་ལ་གེགས་བྱེད་པའི་བདུད་ཀྱི་བར་ཆད་ཤེས་པར་བྱ་བ་དང་གསུམ་མོ།",
    "སྲོག་གཅོད་མ་བྱིན་གཞན་གྱི་བུད་མེད་དང་།",
    "ཡན་ལག་དྲུག་གི་ལམ་འདི་རིན་ཐང་ཆེན་པོར་འགྱུར་རམ་ཤེས་ཆེད་དུ།",
    "དེ་ཡི་ཚིག་གིས་ཡན་ལག་དྲུག་གི་ལམ་བཟང་རིན་ཆེན་འདོར་བར་བྱེད།",
    "དེ་དག་རྣམས་ཀྱི་རྣམ་དག་ཚིག་གིས་ནི།",
    "རང་གི་རིན་ཆེན་རྣམ་པར་ཤེས་པར་བྱ།",
    "ཕ་དང་མ་དང་བུ་མོ་སྲིང་མོ་དང་།",
    "རིགས་དྲུག་གི་དམ་ཚིག་གི་སྤྱོད་པ།",
    "རིན་ཆེན་ལ་ནི་གཞན་ནོར་དབྲོག་བྱ་མཆོག་གི་པད་མའི་རིགས་ཉིད་ལ་ཡང་གཞན་གྱི་བུད་མེད་དབྲོག།",
    "གཡུང་མོ་ལ་སོགས་མཐའ་དག་བུད་མེད་རྣམས་ནི་གྲི་གུག་ལ་ཡང་མཁའ་ཡི་པད་མར་སྨད་མི་བྱ།",
    "འདི་དག་གི་ངེས་པའི་དོན་ནི་རྡོ་རྗེའི་རིགས་ཏེ་མི་བསྐྱོད་པའི་རིགས་ཀྱི་དམ་ཚིག་སྲོག་གཅོད་པ་ནི།",
    "རྣལ་འབྱོར་པའི་རང་གི་ལུས་ལ་དབུགས་ཉི་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱའི་རྒྱུ་བ་འགོག་པ་དང་།",
    "གཞན་གྱི་བུད་མེད་ནི་ཕྱག་རྒྱ་ཆེན་མོ་སྟེ་དེ་འཕྲོག་པ་དང་།",
    "ཁྱོད་ཀྱིས་མ་བྱིན་པར་ཡང་ཧཾ་ལས་ཐིག་ལེ་ལོང་།",
    "ཕ་རོལ་རྡོ་རྗེ་སེམས་དཔའི་བུད་མེད་ཕྱག་རྒྱ་ཆེན་མོ་བསྟེན་པར་གྱིས།",
    "ངེས་དོན་གྱི་དམ་ཚིག་བཞི་ལས་ཆང་སྟེན་པ་ནི་ཉིན་དང་མཚན་མོར་གཏུམ་མོའི་མེས་ཕྱི་བོའི་ཐིག་ལེ་བཞུ་བ་དག་ལས་ཟླ་བ་དཀར་པོའི་རྒྱུན་འབབ་པ་གང་ཞིག་བདེ་བས་མྱོས་པར་བྱེད་པའི་ཕྱིར་མཱ་མ་ཀཱི་དེ་ཆང་ཡིན་གྱི་མྱོས་བྱེད་ཕྱི་རོལ་གྱི་ཆང་འཐུང་པ་ནི་མ་ཡིན།",
    "བདུད་རྩི་བསྟེན་པ་ནི་རང་རང་གི་རིགས་ཀྱི་ས་ལ་འཛག་མེད་དུ་གནས་པའི་ལྷ་རྣམ་སྣང་ལ་སོགས་པ་རྣམས་དག་གིས་དག་པའི་ལུས་ལ་བདུད་རྩི་ལྔ་རྣམས་བསྙེན་པ་སྟེ་མི་གཙང་པ་ཟ་བ་ནི་མ་ཡིན་ཏེ།"
  ]
}