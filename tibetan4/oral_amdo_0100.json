    "ཕ་མ་བྱས་རེས་བཞིན་ཕན་པ་འབའ་ཞིག་བྱས་པས་དྲིན་ཅན་ཡིན་པར་བསམས་ནས།",
    "རང་གི་སྤྱི་བོའི་སྟེང་དུ་པཾ་ལས་པད་མ་དཀར་པོ་འདབ་མ་བརྒྱད་པ་དང་དེའི་ལྟེ་བར་ཨཱ་ཡིག་ཡོངས་སུ་གྱུར་པ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་ཉ་གང་པ་དང་།",
    "རྡོ་རྗེ་དཀར་པོ་རྩེ་ལྔ་པ་ལྟེ་བ་ལ་ཧཱུཾ་གིས་མཚན་པ།",
    "ཞབས་རྡོ་རྗེ་དཀྱིལ་ཀྲུང་གིས་བཞུགས་ཤིང་།",
    "ཡུམ་རྡོ་རྗེ་སྙེམས་མ་ནི་ཤེས་རབ་རྣམ་ཀུན་མཆོག་ལྡན་གྱི་སྟོང་པ་ཉིད་དེ་ཐབས་དང་ཤེས་རབ་དབྱེར་མེད་ཟུང་འཇུག་གི་ངོ་བོར་བསམ་མོ།",
    "ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་པས་དགུག་གཞུག་བཅིང་མཉེས་པར་བསམ་མོ།",
    "རྐང་མཐིལ་གཉིས་ཀྱི་སོར་མོ་དང་ཕྲ་བ་ཐམས་ཅད་བ་སྤུའི་བུ་ག་ནས་འཐོན་པས་ལུས་ཤེལ་གོང་དག་པ་ལྟར་ཡོངས་སུ་དག་ཅིང་ཡེ་ཤེས་ཀྱི་བདུད་རྩིའི་རྒྱུན་དཀར་པོས་གང་པར་བསམ་ཞིང་།",
    "ཤིན་ཏུ་རྒྱས་པར་བདག་ལ་མཛོད་ཅིག་སརྦ་སིདྷི་མེ་པྲ་ཡཙྪ་དངོས་གྲུབ་ཐམས་ཅད་བདག་ལ་སྩོལ་ཅིག་སརྦ་ཀརྨ་སུ་ཙ་མེ་ཙིཏྟཾ་ཤྲི་ཡཾ་ལས་ཐམས་ཅད་ལ་ཡང་བདག་གི་སེམས་དགེ་ལེགས་སུ་ཀུ་རུ་མཛོད་ཅིག་ཧཱུྃ།",
    "བདག་གི་གིས་ཐོག་མ་མེད་པ་ནས་བསགས་པའི་སྡིག་སྒྲིབ་དང་ཉེས་ལྟུང་གི་དྲི་མ་ཐམས་ཅད་བྱང་ཞིང་དག་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ་ཞེས་བརྗོད་པས།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱི་སྡིག་སྒྲིབ་ཉིས་སྟོང་གི་དྲི་མ་ཐམས་ཅད་བྱང་ཞིང་དག་གོ་གསུང་ཞིང་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་ཡབ་ཡུམ་ཟླ་བ་ཞུ་བ་ལྟ་བུར་གྱུར་པ་བདག་གི་སྤྱི་གཙུག་ནས་ཐིམ་པས་བདག་ཉིད་རྡོ་རྗེ་སེམས་དཔའི་ངོ་བོར་གྱུར་པར་བསྒོམས་ལ།",
    "གང་གི་དྲིན་གྱིས་གྱི་བདེ་ཆེན་ཉིད།",
    "གང་གི་བཀའ་དྲིན་འོད་ཀྱིས་གསལ་བྱས་བདག་ཉིད་ཀྱི།",
    "ཁྱོད་ནི་འབའ་ཞིག་སྟེ་ཁོ་ན་སྐྱབས་ཀྱི་གནས་དང་ཁྱོད་ནི་བྲལ་བ་དང་སྨིན་པའི་ཡོན་ཏན་མཆོག་གི་གནས་ཏེ་སྲིད་ཞིའི་སྐྱོན་རྣམས་གཏན་ནས་བཅོམ་པ་ཁྱོད་ཉིད་དོ།",
    "ཨོཾ་བཛྲ་རེ་ཁེ་ཨཱ་ཧཱུྃ་གིས་མཐའ་ལྕགས་རི་ནག་པོས་བསྐོར་བར་བསམས་པའི་དབུས་སུ་མེ་ཏོག་གི་ཚོམ་བུ་བཀོད་པ་རིའི་རྒྱལ་པོ་རི་རབ།",
    "མེ་ཏོག་གི་ཚོམ་བུ་རིམ་པ་ལྟར་དགོད་ཅིང་།",
    "མཆོག་དང་ཐུན་མོང་གི་དངོས་གྲུབ་ཀྱི་དོན་ལ་གདུང་བ་ཆེན་པོས་གསོལ་བ་དྲག་ཏུ་གདབ་པར་བྱ་སྟེ།",
    "རྩེ་གཅིག་གི་སྒྲུབ་པ་ནུས་པར་༴",
    "ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་ཚེ་འདི་ཉིད་ལ་ཐོབ་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཨོཾ་ལས་འོད་ཟེར་དཀར་པོ་འཕྲོས་པས་རང་གི་དཔྲལ་བ་ནས་ཞུགས་པས་ལུས་ཀྱི་ནང་ཡོངས་སུ་གང་ཞིང་།",
    "ཨཱ་ཡིག་ལས་འོད་ཟེར་དམར་པོ་འཕྲོས་པ་རང་གི་མགྲིན་པ་ནས་ཞུགས་པས་ལུས་ཀྱི་ནང་ཡོངས་སུ་གང་ཞིང་།",
    "ཧོ་ཡིག་ལས་འོད་ཟེར་སེར་པོ་འཕྲོས་པ་རང་གི་ལྟེ་བ་ནས་ཞུགས་པས།",
    "རང་གི་སྤྱི་བོ་ནས་ཐིམ་ཞིང་།",
    "ལག་པ་མཉམ་བཞག་གི་ཕྱག་རྒྱ་བཅས་ཏེ་སྒལ་ཚིགས་དྲང་པོར་བསྲང་སྟེ།",
    "རྣམ་རྟོག་རྒྱ་རུ་ཆུད་ཚུད་པ་ཡི་ འགྲོ་བ་གསུམ་པོ་རྣམ་གཟིགས་ནས།",
    "སྟག་གི་ལྤགས་པའི་ཤམ་ཐབས་ཅན།",
    "རལ་པའི་ཅོད་པན་གྱི་རྩེ་མོར་རྡོ་རྗེ་ནོར་བུ་དང་།",
    "གཡོན་པ་ཐོད་པ་ཁྲག་གིས་གང་བ་འཛིན་པས་ཡབ་ཀྱི་མགུལ་པར་འཁྱུད་པ།",
    "གཡོན་རྐྱང་བརྐྱང་གི་སྟབས་ཀྱིས་ཡབ་ཀྱི་ཞབས་དང་མཉམ་པར་གནས་པ།",
    "རང་གི་ངོ་བོའི།",
    "རྒྱལ་མཚན་རྩེ་མོ།",
    "སྒོ་འཁྱོག་རིམ་པ་གསུམ་པའམ་འཛུལ་སྒོ་ཅན་ཡང་ན་སྒོ་གླེགས་དང་བཅས་ཤིང་ཕྱི་ནང་གཉིས་ནས་ཡོལ་བ་དང་བཅས་པ།",
    "ནང་དུ་ས་དུག་དང་དྲི་ང་བ་ལ་སོགས་པ་མེད་ཅིང་ཁམས་བདེ་བའི་མུན་ཁང་སྒོ་ཚགས་ལེགས་པར་བསྡམས་པའི་ནང་དུ་བསྒོམ་མོ།",
    "དེ་ལྟ་བུ་མ་འབྱོར་བའི་ཀུན་སྤངས་ཀྱི་གནས་ནི་ས་ཕུག་གམ་བྲག་ཕུག་རང་བཞིན་གྱིས་མུན་པ་ནག་པ་ས་རླན་མེད་ཅིང་སྒོའི་ཚགས་ལེགས་པར་བྱས་པའི་ནང་དུ་བསྒོམ་མོ།",
    "ལས་དང་པོ་ཡི་གང་ཟག་གིས།",
    "དུས་ཐོག་མ་མེད་པའི་དུས་ནས་ལུས་སྣ་ཚོགས་པ་གཅིག་བླངས་ནས་བྱ་བྱེད་སྣ་ཚོགས་པ་གཅིག་བྱས་ཏེ་དེ་ཐམས་ཅད་སྡུག་བསྔལ་གྱི་རྒྱུ་འབའ་ཞིག་ཏུ་སོང་བས།",
    "ད་ནི་མཉམ་བཞག་གི་དུས་སུ་ལུས་ཀྱི་ཉམས་ལེན་དུ་ལུས་དབེན་པར་གནས་པ་ལ་བསླབ་པར་བྱ་སྟེ།",
    "ཐོག་མ་མེད་པའི་དུས་ནས་ངག་གི་སྨྲ་བརྗོད་སྣ་ཚོགས་བྱས་པ་ཐམས་ཅད་སྡུག་བསྔལ་གྱི་རྒྱུ་འབའ་ཞིག་ཏུ་སོང་བས།",
    "ད་ནི་མཉམ་བཞག་གི་དུས་སུ་ངག་དབེན་པར་གནས་པ་ལ་བསླབ་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་སེམས་དབེན་པར་གནས་པས་སེམས་སྦྱང་བ་ནི་ཐོག་མ་མེད་པའི་དུས་ནས་སེམས་རྣམ་པར་རྟོག་པའི་སྤྲོ་བསྡུ་སྣ་ཚོགས་པ་ཅིག་རྟག་ཏུ་བྱས་པ་ཐམས་ཅད་སྡུག་བསྔལ་གྱི་རྒྱུ་འབའ་ཞིག་ཏུ་སོང་བས།",
    "ད་ནི་མཉམ་བཞག་གི་དུས་སུ་སེམས་དབེན་པར་གནས་པ་ལ་བསླབ་པར་བྱ་སྟེ།",
    "སེམས་ངལ་མ་སོས་པར་རྣམ་རྟོག་གི་འཕྲོ་འདུར་ཤོར་ན་རྣམ་པར་མི་རྟོག་པའི་ཏིང་ངེ་འཛིན་མི་སྐྱེ་བས་སོ།",
    "གལ་ཏེ་དེ་བཅའ་བར་མི་ནུས་ན་དཀྱིལ་དཀྲུང་ཕལ་པ་བཅས་ཏེ་ལག་པའི་བདེ་བར་ཕྱག་རྒྱ་ནི་དཀྱིལ་དཀྲུང་གི་སྟེང་དུ་གཡོན་པ་གན་རྐྱལ་དུ་བྱས་པའི་སྟེང་དུ་གཡས་པ་གན་རྐྱལ་དུ་བཞག་ནས་མཐེ་བོང་ལྟོ་སྤྲད་པ་མཉམ་བཞག་གི་ཕྱག་རྒྱའམ།",
    "ལག་པ་གཉིས་པུས་མོ་ལ་བཀབ་པའམ།",
    "དེ་རྣམས་ལས་སྔ་མ་དག་ནི་འཆུན་ཆུང་པས་ཕྱི་མ་རྡོ་རྗེ་ཁུར་ཚུར་མཐེ་བོ་བསྡམས་པ་བརླའི་སྟེང་དུ་མནན་པ་ལ་ལག་པའི་གྲུ་མོ་གཉིས་དྲང་པོར་བརྐྱང་པ་རྩིབས་ལོགས་ལ་སྦྱར་བའམ།",
    "ལག་པའི་མཐིལ་བརླའི་སྟེང་དུ་མནན་པ་ལ་གྲུ་མོ་དྲང་པོར་བསྲང་ནས་རྩིབས་ལོགས་ལ་སྦྱར་ཏེ་དཔུང་མགོ་གཉིས་རྒྱབ་ཏུ་ཅུང་ཟད་དགྱེ་བར་བྱའོ།",
    "ལྟ་སྟངས་མུན་ནག་གི་ནམ་མཁའ་ལ་སྨིན་མཚམས་ཀྱི་ཐད་ཀྱི་ནམ་མཁའ་ལ་སྤ་བ།",
    "སོ་ནས་མདུན་དུ་སོར་བཅུ་དྲུག་ཙམ་གྱི་བར་སོང་བའི་སྟེང་གི་ཕྱོགས་སུ་མིག་འབྱེད་འཛུམ་དང་གཡོ་བ་མེད་པར་ས་གཅིག་ཏུ་ཧྲིག་གེ་བལྟ་ཞིང་།",
    "མིག་གི་བལྟ་ས་དེ་ཉིད་དུ་ཅིར་ཡང་མི་རྟོག་ཅིང་ཡིད་ལ་མི་བྱེད་པའི་ཚུལ་གྱིས་ས་ལེ་ཧྲིག་གེ་བ་ལ་བཞག་གོ།",
    "གསང་བ་ཡེ་ཤེས་སྔོན་སོང་བས།",
    "མི་བསྔོ་མི་བགྲང་པར་ལྟ་སྟངས་ཀྱིས་རིག་པ་གཅུན་ནས་རེ་དོགས་དང་དགག་སྒྲུབ་ཐམས་ཅད་དང་བྲལ་བའི་ངང་དུ་ཡེངས་པ་སྐད་གཅིག་ཀྱང་མེད་པར་འཇོག་པ་ལ་བསླབ་པར་བྱ་སྟེ།",
    "བསྒོམ་དུ་མེད་པར་བསྟན་མོད་ཀྱང་།",
    "དེ་ལྟར་སྦྱངས་པ་རྣམ་པ་གསུམ་ཞག་གྲངས་བདུན་ཙམ་ལ་སོགས་པར་འབྱོང་པའི་ཉམས་རྟགས་མ་བྱུང་གི་བར་དུ་མཚམས་ཤིན་ཏུ་དམ་པར་བཅད་ནས་བསྒོམ་དུ་གཞུག་གོ།",
    "རེས་འགའ་ལུས་ཤིན་ཏུ་ཡང་བ་སྙམ་བྱེད་པ་དང་།",
    "རེ་འགའ་ལུས་ཤིན་ཏུ་ལྕི་བ་སྙམ་བྱེད་པ་དང་།",
    "རེས་འགའ་དྲོ་ཞིང་རྔུལ་བ་དང་།",
    "རེས་འགའ་སེམས་སྤུན་ཞིང་ཚིག་པ་ཟ་བ་སྙམ་བྱེད་པ་དང་།",
    "གཞན་ཡང་བསྒོམ་ཁང་གི་ནང་མུན་པའི་རྣམ་པ་མེད་པར་ནམ་ལངས་པའི་རྣམ་པ་ལྟ་བུར་སྐྱ་འོད་པར་སྣང་བ་དང་།",
    "གཟའ་སྐར་དང་འཇའ་འོད་ལ་སོགས་པ་མཐོང་སྣང་གི་རྣམ་པ་ཅི་རིགས་པ་ཡང་འཆར་བར་འགྱུར་ཏེ།",
    "རེག་པའི་ཟས་གོས་ཡང་ལ་དྲོ་བ་གྱོན་ནས།",
    "གཉིད་ཀྱི་ཟས་ཉིན་མཚན་གོ་མ་ལོག་པར་ཉིན་མོ་གཉིད་སྤངས་ལ།",
    "མཚན་མོ་གཉིད་ཆགས་པའི་སྐྱོན་མེད་པ་ཙམ་དུ་ཚིམས་པར་ལོག་ཅིང་།",
    "ཉམས་རྟོགས་ཇི་ལྟར་བྱུང་གི་འདྲི་ཚུལ་བྱ་མ་ཤོར་བས་ཐབས་མཁས་པོས་འདྲི་བ་དང་།",
    "ཁ་ཅིག་ལ་ཉམས་མྱོང་འུར་ལངས་པ་སྐྱེས་ནས་བློ་ལས་སུ་སོང་རུང་བ་བྱུང་ན་སྐྱོན་མེད་དུ་ངོ་སྤྲད་པ་ཙམ་ལ་སོགས་པ་བྱས་ནས་ལེགས་པར་བསྐྱང་བར་བྱའོ།",
    "ཟབ་ལམ་གྱི་ཐུན་མོང་མ་ཡིན་པའི་སྔོན་འགྲོའི་ཁྲིད།",
    "འབྲིང་གིས་སྲོག་རྩོལ་ལ་སོགས་ཡིན།",
    "ཡན་ལག་དྲུག་པོ་རེ་རེ་ལ་བསྡུས་པའི་དོན་དྲུག་དྲུག་ཏུ་མཛད་པས།",
    "རང་རང་གི་ཡུལ་ལ་འཇུག་གནས་གཟུགས་སོགས་ཡུལ་ལྔ་པོ་ཐམས་ཅད་ལ།",
    "མཚན་མོ་དུ་བ་ལ་སོགས་རྣལ་འབྱོར་སླར་ཡང་ཉིན་མོ་ནམ་མཁའ་ལ་ནི་འབར་བ་ལ་སོགས་ཀྱང་།",
    "བཙུམ་པའི་རྣམ་པར་ཡང་མ་སོང་པ་ཕྱེད་འོག་མ་དཀར་པོས་བཀབ་པ་ལྟ་བུ་དང་ཕྱེད་སྟེང་མ་ནག་ཧྲིག་གེ་བའི་རྣམ་པས་ཅུང་ཟད་སྟེང་ཕྱོགས་ཀྱི་ནམ་མཁའ་ལ་གཡོ་བ་མེད་པར་བལྟ་བར་བྱ་སྟེ།",
    "སྟེང་སྒོ་རང་ལུགས་སུ་བཞག་ཅིང་འོག་གི་བྱེད་པ་བཅིང་ངོ།",
    "གནས་ལུགས་ཡང་དག་པའི་དོན་སྤྲོས་པའི་མཐའ་ཐམས་ཅད་དང་བྲལ་བ་ཡིན་པས་རྣལ་འབྱོར་པའི་སེམས་རིག་པ་ཡང་རྣམ་རྟོག་གི་སྤྲོས་པའི་མཚན་མ་ཐམས་ཅད་དང་བྲལ་བའི་ངང་དུ་མཉམ་པར་བཞག་པར་བྱ་སྟེ།",
    "ལས་སྣང་གི་དངོས་པོ་མིན་པའི་སྟོང་གཟུགས་དངོས་པོར་བསྟེན་པ་སྟེ་རྩེ་གཅིག་ཏུ་བལྟ་ནས་སུ།",
    "དངོས་པོ་ལས་སྣང་གི་དངོས་པོ་མིན་པར་ཏེ་མི་སྣང་པར་བྱ་ གཟུང་འཛིན་གྱི་སེམས་ནི་སེམས་མིན་པ་སྟེ་མི་རྒྱུ་བར་བྱས་ནས་སུ།",
    "དེ་ནི་ཤེས་པ་ཅི་ཡང་མི་བསམ་པར་བཞག་པ་ལྷ་ཁང་གི་ལྡེར་སོ་ལྟ་བུའི་མན་ངག་གོ།",
    "ཕྱོགས་བཅུའི་འཇིག་རྟེན་དག་ནི་ཡིན་ནམ་སྙམ།",
    "མཛའ་མོ་ཞེས་བདག་ཉིད་དམ་ཕྱག་རྒྱ་ལ་བོད་པའོ།",
    "བདག་གིས་རྔ་མོ་མཐོང་།",
    "དེ་ནི་སེམས་གློད་ན་རང་གྲོལ་དུ་གནས་པ་རྔ་མོ་བཀྲོལ་བ་ལྟ་བུའི་མན་ངག་གོ།",
    "སེམས་ཡེངས་པས་ནི་བདག་གི་དོན་ཀྱང་མི་ནུས་ན་གཞན་གྱི་དོན་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "དེ་ལྟར་ཡང་དང་ཡང་དུ་བྱས་ཏེ་ལྟ་སྟངས་གཏོད་བསྟོད་ལ་བསྒོམ་མོ།",
    "གལ་ཏེ་རྒོད་ན་རང་སྐད་ཅིག་གིས་ཡི་དམ་གྱི་ལྷར་བསྐྱེད་ལ།",
    "འོད་ཚུར་འདུས་རང་ལ་ཐིམ་པས་རང་ཡང་འོད་དུ་གྱུར་ཏེ་ཇེ་ཆུང་ཇེ་ཆུང་ལ་རིམ་གྱིས་བསྡུས་ནས་སྟོང་པར་བསམ་སྟེ་ལྟ་སྟངས་ཅུང་ཟད་སྨད་ལ་བསྒོམ་མོ།",
    "དེ་ལྟར་རྩེ་གཅིག་ཏུ་བསྒོམས་པས་རང་གི་སེམས་ཀྱི་རང་བཞིན་འོད་གསལ་གྱི་སྣང་བ་དུ་བ་ལྟ་བུ་དང་།",
    "གཞོམ་མེད་ཀྱི་སྒྲ་དང་དྲི་དང་རོ་དང་རེག་བྱའི་རྣམ་པ་དུ་མ་ཉམས་མྱོང་ལ་འཆར་བར་འགྱུར་ཏེ་དེ་རྣམས་ལ་དྲི་བརྟགས་ལེགས་པར་བྱས་ལ་ཉམས་མྱོང་རིམ་ཅན་དང་རིམ་མེད་གང་སྐྱེས་ཐམས་ཅད་ལ་དངོས་པོའི་མཚན་མར་མི་འཛིན་པ་དང་སྐྱོན་མེད་དུ་ངོ་སྤྲད་ནས་སྣང་བ་གང་ཤར་ལ་དགག་སྒྲུབ་མེད་པར་ལྟར་བཞུག་པར་བྱ་སྟེ།",
    "རེག་བྱ།",
    "བུད་མེད།",
    "འབྲིང་གི་རྗེས་ཐོབ་སྟོང་པར་བལྟ།",
    "སེམས་རྣམ་རྟོག་གི་སྤྲོ་བསྡུས་དབེན་པར་གནས་ཏེ།",
    "རིའི་རྩེ་མོའམ་ཐང་ཡངས་པོ་མིག་སྔར་གངས་དང་ཆུ་ལ་སོགས་པ་འོད་འཚེར་བ་མེད་པའི་གནས་སུ་རང་གི་ལུས་ཕྱི་ནས་མི་མཐོང་ཙམ་དུ་རྩིག་པས་སྐྱོར་བར་བྱས་པར་རམ།",
    "ཁང་པའི་ཡང་ཐོག་གི་གཡབ་འོག་ལྟ་བུར་སྤྲིན་དང་སེར་བུ་མེད་པའི་དུས་སུ་བསྒོམ།",
