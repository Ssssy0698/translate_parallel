    "གང་དགེ་སྦྱོང་མ་ཡིན་པ་ལ་དགེ་སྦྱོང་དུ་ཁས་འཆེ་ཞིང་བུད་མེད་ཀྱི་གླུ་དང་གར་དང་རྒྱན་རྣམས་ཀྱི་སྒྲ་ཐོས་པ་དང་དགོད་པ་དང་འཇོ་བ་དང་རྩེ་བ་རྣམས་ཐོས་ནས།",
    "དེ་དེ་ལྟར་ལྷའི་བུ་མོ་འདོད་པའི་ཕྱིར་ཚངས་པར་སྤྱོད་པ་ཡོངས་སུ་བསྔོ་བས་ན།",
    "དེ་བཞིན་དུ་བྱིས་པ་རྣམས་ལ་ལོག་པར་འཇུག་པ་ཡང་ཚ་སྒོ་ཅན་གྱི་ཆུས་ཁྱེར་བའི་ཁྱེའུ་དག་མཐོང་ནས་དེ་དག་གིས་དེ་ལ་བོས་པ་དང་།",
    "བ་དང་རྟ་རྒོད་མ་དང་མོ་དང་ལུག་མོ་ལ་སོགས་པ་ལ་ཡང་དེ་བཞིན་ཏེ།",
    "རང་གི་ཆུང་མ་ལ་སྐྱེ་གནས་ཀྱི་ལམ་མ་ཡིན་པར་བྱས་པ་ཡང་དེ་བཞིན་ནོ།",
    "བྲམ་ཟེ་འདི་ལ་ཁ་ཅིག་བདག་ཚངས་པར་སྤྱོད་པར་ཁས་འཆེ་ཞིང་དེ་བུད་མེད་དང་གཉིས་ཀྱིས་གཉིས་མི་སྦྱོར་ཡང་བུད་མེད་ལ་མིག་གིས་གཟུགས་ལ་ངེས་པར་སེམས་ཤིང་བལྟ་སྟེ།",
    "དེ་བཞིན་དུ་བུད་མེད་དང་ལྷན་ཅིག་རྩེ་བ་དང་ཅ་ཅོ་འདོན་པ་ཉམས་སུ་ལེན་པ་ཡང་ཚངས་པར་སྤྱོད་པ་ཡོངས་སུ་མ་དག་པའོ་ཞེས་གསུངས་པ་དང་།",
    "བུད་མེད་ཀྱིས་བསྙེན་བཀུར་བྱས་པ་ཉམས་སུ་ལེན་པ་ཡང་དེ་བཞིན་ནོ།",
    "རྩིག་པས་ཆོད་པའམ་ཡོལ་བས་ཆོད་པའི་བུད་མེད་ཀྱི་རྒྱན་དང་གླུ་དང་གར་ལ་སོགས་པའི་སྒྲ་ཉམས་སུ་ལེན་པའང་དེ་བཞིན་དུ་འཁྲིག་པ་དང་ལྡན་པ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "ཁྱོད་འདི་ལྟར་འདོད་པ་རྣམས་ནི་རོ་མྱང་བ་ཆུང་བ་སྟེ།",
    "དགེ་སློང་ཁྱོད་ཀྱིས་འདོད་པ་དག་ཡོད་པ་གང་ཡིན།",
    "ཁྱོད་གང་ལ་རབ་ཏུ་ཆགས།",
    "ཁྱོད་ཇི་ལྟར་བཅིངས་ཤིང་བརྒྱལ་ཏེ་ཞེན་ཅིང་ལྷག་པར་ཞེན་པར་གྱུར།",
    "དགེ་སློང་ཆོག་གི་འདོད་པ་རྣམས་ལས་སེམས་ཟློག་ཤིག།",
    "བདག་གི་ཆུང་མས་ཆོག་པར་འཛིན་པ་དང་།",
    "མ་ཆགས་པའི་མིག་གིས་བལྟ་བ་དང་ཡིད་བྱུང་བའི་ཡིད་དང་འདོད་པ་དག་ནི་ཤིན་ཏུ་སྡུག་བསྔལ་བའོ་སྙམ་དུ་མ་ཆགས་པའི་ཡིད་ལ་བྱེད་པ་ལ་བརྩོན་པར་བྱའོ།",
    "དེས་རང་གི་ཆུང་མ་ལ་མི་སྡུག་པར་རྗེས་སུ་ལྟ་བ་དང་།",
    "བདག་གིས་དེ་ལྟར་བྱའོ་སྙམ་མོ་ཞེས་གསུངས་པ་དང་།",
    "དེ་ནས་བུ་མོ་ཟླ་མཆོག་གིས་སྐྱེ་བོ་ཕལ་པོ་ཆེ་བརྒྱུག་པ་དེ་མཐོང་མ་ཐག་ཏུ།",
    "ཆགས་པའི་སེམས་དང་ལྡན་ལ་ཡོད་རེ་སྐན།",
    "མ་དང་སྲིང་མོའི་འདུ་ཤེས་སྐྱེད་བྱེད་པ།",
    "བདག་གིས་འདོད་ཆགས་སེམས་ཀྱིས་དེ་མ་བསྒྲུབས།",
    "ཁྱོད་ནི་སྔོན་ཆད་བདག་གི་ཕར་གྱུར་ཅིང་།",
    "བདག་གིས་སྔོན་ཆད་ཁྱེད་རྣམས་ཐམས་ཅད་བསད།",
    "འོན་པ་གླེན་པ་ཕག་དང་རྔ་མོ་དང་།",
    "མི་མཁས་བུད་མེད་དགའ་བ་དེ་བཞིན་བརྒྱུག།",
    "བུད་མེད་ཆགས་པ་དེ་བཞིན་རྨོངས།",
    "ངན་སྐྱུགས་བུམ་པ་རི་མོ་ཅན།",
    "ཀླད་རྒྱས་རུས་པ་རྐང་གིས་གང་།",
    "གང་གིས་ངན་འགྲོར་འགྲོ་བ་ཡི།",
    "ཤེས་རབ་འཆལ་པ་མནར་མེད་སོང་།",
    "བུད་མེད་དམན་པ་རྣམས་དང་འདྲེ།",
    "བུད་མེད་ཀྱི་ཐུལ་འོག་ཏུ་ཆུད་ལ་བུད་མེད་ཀྱིས་ཚར་ཆོད་པ་བུད་མེད་ཀྱིས་འཁོལ་བ་རྣམས་ནི།",
    "དེ་དེ་ལ་ཆགས་པས་བུད་མེད་ཀྱིས་སྤྱོ་བའང་བཟོད་བསྡིགས་ཤིང་ལྟ་བ་དང་བརྒྱད་པའང་བཟོད་དོ།",
    "རབ་ཏུ་རྨོངས་ནས་བུད་མེད་དང་།",
    "དེ་ཡི་སེམས་ནི་མོ་ཕྱིར་སོང་།",
    "གང་གིས་ངན་འགྲོར་འགྲོ་བ་ཡི།",
    "རིགས་ནས་བུད་མེད་རྣམས་ལ་བག་བྱེད་པ།",
    "དམུས་ལོང་གིས་འཇིགས་པ་དང་།",
    "མགོ་རྣམས་རེ་རེ་དག་ལ་ཡང་།",
    "འཇམ་དཔལ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་གིས་མཆོད་རྟེན་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་བཤིག་པ་དང་བསྲེགས་པ་བས།",
    "བསྐལ་པ་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དུ་ཉིན་གཅིག་བཞིན་ལྷའི་ཟས་རོ་བརྒྱ་དང་ལྡན་པ་བྱིན་པ་དང་དེ་བཞིན་དུ་ལྷའི་གོས་རྣམས་སྦྱིན་པ་བྱིན་པ་བས་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གཞན་གང་ཞིག་གིས་དགེ་སློང་གཅིག་ལ་ཉིན་གཅིག་ཟན་ཅིག་བྱིན་ན།",
    "ཉན་ཐོས་སྣོད་དུ་གྱུར་པ་དང་སྣོད་དུ་མ་གྱུར་པ་ཡང་རུང་སྐྲ་བྲེགས་ནས་གོས་ངུར་སྨྲིག་གི་ཚལ་བུ་བགོས་པ་ཡོངས་སུ་སྲུང་བ་དང་།",
    "མི་འཚེ་བ་ནས་རང་གི་ཡུལ་འཁོར་དང་གཞན་གྱི་ཡུལ་འཁོར་གྱི་བར་དུ་འཕེལ་བར་བྱེད་པ་དང་།",
    "ངན་སོང་ཟད་པར་བྱེད་པ་དང་།",
    "རང་གི་ཉོན་མོངས་པ་དང་གཞན་གྱི་ཉོན་མོངས་པ་རྣམས་སེལ་བ་དང་།",
    "ངན་སོང་ཐམས་ཅད་རྣམ་པར་སྤོང་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅུ་པོ་དེ་དག་གིས་བསྲུང་བར་བགྱིའོ།",
    "དེ་དག་ལས་དེ་དག་གི་སྐྱོན་ཐོས་ནས་སྐྱེ་བོ་མང་པོ་མ་དད་པར་བྱེད་དོ།",
    "འདི་དག་ནི་ཆུ་ཕོར་གང་གི་འོས་ཀྱང་མ་ཡིན་ནོ་སྙམ་དུ་བདག་ལ་བསྟོད་དེ།",
    "གང་ཟག་གིས་གང་ཟག་ལ་དྲོད་མི་གཟུང་ངོ།",
    "བྱིས་པས་རྩེད་མོར་དེ་དང་དེ་དག་ཏུ།",
    "གང་གིས་རྒྱལ་བ་དེ་ཕྱིར་མཆོད་རྟེན་དག།",
    "གང་གིས་རྩིག་ངོས་གཟུགས་ཀྱི་རི་མོ་དག།",
    "བདག་གིས་བྲིས་སམ་འདྲི་རུ་བཅུག་ཀྱང་རུང་།",
    "རྩེད་མོ་དགའ་དང་བསང་བ་བྱེད་པ་ན།",
    "རྩིག་ངོས་སེན་མོ་ཤིང་བུས་གཟུགས་བྲིས་པ།",
    "ཆུ་ལ་བརྡབས་དང་ཐལ་མོས་བརྡབས་པ་དང་།",
    "མཆོད་རྟེན་དེ་ལ་གང་གིས་ཐལ་མོ་སྦྱར།",
    "ཡོངས་སུ་ཚངས་པའམ་ཐལ་མོ་ཡ་གཅིག་གམ།",
    "གང་གིས་རིང་བསྲེལ་གནས་པ་དེ་དག་ལ།",
    "ཀ་ཤིའི་རྒྱལ་པོར་གྱུར་པས་ཕུག་རོན་གྱི་ཕྱིར་ཁྲ་ལ་རང་གི་ཤ་བྱིན་པ་དེ་འཆལ་པའི་ཤེས་རབ་ཅན་ཡིན་ནམ།",
    "མ་ཕམ་པ་ཁྱོད་ཀྱིས་བསྐལ་པ་དྲུག་ཅུར་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་བསྒྲུབས།",
    "དེ་དག་གིས་ནི་འདི་སྐད་ཅེས་བཅོམ་ལྡན་འདས་དེང་སླན་ཆད་བདག་ཅག་དེ་བཞིན་གཤེགས་པའི་སྤྱན་སྔར་ཡི་དམ་འདི་ལྟ་བུར་བཅའ་བར་བགྱིའོ།",
    "བདག་ཅག་གིས་དེ་བཞིན་གཤེགས་པ་ལ་བསླུས་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་གལ་ཏེ་བདག་ཅག་གིས་དེང་སླན་ཆད་མཛའ་བཤེས་ཀྱི་ཁྱིམ་མམ།",
    "སེམས་ལ་གནོད་པ་བགྱིས་ན་བདག་ཅག་གིས་དེ་བཞིན་གཤེགས་པ་ལ་བསླུས་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་གལ་ཏེ་བདག་ཅག་གིས་དེང་སླན་ཆད་བརྟུལ་ཞུགས་དེ་ཡང་དག་པར་བླང་བའི་སླད་དུ་རྒྱལ་སྲིད་ཐོབ་པའམ་ནོར་ཐོབ་པའམ་ལུས་དང་སྲོག་ཀྱང་ཡོངས་སུ་མ་བཏང་ན་བདག་ཅག་གིས་དེ་བཞིན་གཤེགས་པ་ལ་བསླུས་པར་འགྱུར་རོ།",
    "དེ་དག་ནི་དེ་ལྟ་མ་ཡིན་ནོ་སྙམ་ན་བདག་ཅག་གིས་དེ་བཞིན་གཤེགས་པ་ལ་བསླུས་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་གལ་ཏེ་བདག་ཅག་གིས་དེང་སླན་ཆད་དམའ་བའི་སེམས་དང་གདོལ་བའི་སེམས་དང་ཁྱིའི་སེམས་ལྟ་བུར་གནས་པར་མ་བགྱིས་ན་བདག་ཅག་གིས་དེ་བཞིན་གཤེགས་པ་ལ་བསླུས་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་གལ་ཏེ་བདག་ཅག་གིས་དེང་སླན་ཆད་བདག་ལ་བསྟོད་ཅིང་གཞན་ལ་སྨད་ན་བདག་ཅག་གིས་དེ་བཞིན་གཤེགས་པ་ལ་བསླུས་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་གལ་ཏེ་བདག་ཅག་གིས་དེང་སླན་ཆད་གནོད་སེམས་དང་།",
    "རྩོད་པའི་འཇིགས་པས་བསྐུལ་མ་ཐག་ཏུ་དཔག་ཚད་དམ་དཔག་ཚད་བརྒྱར་མ་བྱོལ་ན་བདག་ཅག་གིས་དེ་བཞིན་གཤེགས་པ་ལ་བསླུས་པར་འགྱུར་རོ།",
    "སྦྱངས་པའི་ཡོན་ཏན་དང་ལྡན་པའམ་ཡོན་ཏན་གང་ཡང་རུང་བ་ཞིག་གིས་བདག་བརྗོད་ན་བདག་ཅག་གིས་དེ་བཞིན་གཤེགས་པ་ལ་བསླུས་པར་འགྱུར་རོ།",
    "བྱམས་པ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལས་ཀྱི་སྒྲིབ་པ་སྤང་བར་འདོད་པས།",
    "ཇི་ལྟར་རིགས་ཀྱི་བུ་འདི་དག་གིས་བྱས་པ་དེ་བཞིན་དུ་ཡི་དམ་དུ་བཅའོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཉིན་དང་མཚན་མོ་དེ་བཞིན་ལན་གསུམ་དུ།",
    "དེ་ལ་དེ་དག་རེ་ཞིག་རེག་སྙམ་བསམ།",
    "རྒྱལ་བར་འགྱུར་གྱི་ཐང་ཅིག་གིས་མི་འགྱུར།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "གྲོང་གི་གཙོ་བོའི་གནས་སུ་མ་གྱུར་ཅིག།",
    "དགེ་སྦྱོང་གི་གཙོ་བོའི་གནས་སུ་མ་གྱུར་ཅིག།",
    "ཁྱིམ་བདག་གི་གཙོ་བོའི་གནས་སུ་མ་གྱུར་ཅིག།",
    "ཁྱོད་ནི་སྟེན་པར་མ་བྱེད་ཅིག།",
    "དེ་དག་ལ་ནི་རི་མོར་གྱིས།",
