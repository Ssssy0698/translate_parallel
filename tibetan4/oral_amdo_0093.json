    "ཞི་བ་རིན་ཆེན་མཆོག་གི་གླིང་སྐྱེལ་བ།",
    "འདི་ནི་བདུད་ཀྱི་དཀྲུགས་མ་ཉོན་མོངས་འཇོམས།",
    "བདག་གི་འཁྲུལ་པ་ལ་སོ་སོར་རྟོག་པ་དང་།",
    "མཛའ་བཤེས་ཀྱི་ཁྱིམ་དང་སློང་མོ་སྟེར་བའི་ཁྱིམ་ལ་མི་ལྟ་བ་དང་།",
    "རྙེད་པ་དང་བཀུར་སྟི་ནི་བདག་གི་དོན་སྒྲུབ་པས་ཁྱིམ་ལ་སེར་སྣ་བྱེད་པ་དང་ཆགས་པ་བྱེད་པར་བརྟག་པར་བྱའོ།",
    "མཛའ་བཤེས་ཀྱི་ཁྱིམ་དང་སློང་མོ་སྟེར་བའི་ཁྱིམ་ལ་ལྟ་བ་དང་ཡིད་མི་བདེ་བ་བསྐྱེད་པ་དང་།",
    "བྱིས་པ་དེ་དག་མཆོག་གི་གཏམ་ལས་ཉམས།",
    "རང་གི་ཡན་ལག་ལན་སྟོང་སྙེད་དུ་བཏང་།",
    "ཕ་རོལ་དག་གི་སྐྱོན་ལ་བརྟག་མི་བྱ།",
    "ནང་གི་སེམས་ལས་ཤིན་དུ་རིང་བར་འགྱུར།",
    "མཁས་པ་དེ་དག་གིས་ནི་སྤྱོ་བར་འགྱུར།",
    "གར་མཁན་ལྟད་མོའི་ཁྲོམ་ནང་འདུག་པ་ཞིག།",
    "དེ་ནི་གཡོ་ལྡན་ཡང་ཞིང་རེ་བྲལ་འགྱུར།",
    "མཐུ་ཆུང་བསྟི་སྟང་གིས་ནི་དགར་འགྱུར་ཏེ།",
    "ངན་སོང་ཡོངས་སྤོངས་རྩ་བར་གྱུར་པ་དང་།",
    "ཉིན་དང་མཚན་མོ་སེམས་གཞན་མེད་པར་ནི།",
    "བྱམས་པ་ཁྱོད་ལ་བསྟན་ཏོ།",
    "ཁྱོད་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "གང་ན་ཉོན་མོངས་ཡོད་པ་དེ་དག་ཏུ།",
    "ཁྱེད་ལ་ཆུང་མ་བུ་དང་བུ་མོ་མེད།",
    "བདག་གི་འཁྲུལ་པ་ལ་བལྟ་བ་དང་།",
    "བུད་མེད་དང་སྐྱེས་པ་དང་ཁྱེའུ་དང་བུ་མོ་ཀྱལ་ཀ་བྱ་བའི་བསམ་པ་ཅན་དག་ཡོད་པའམ་སྨད་པའི་གནས་དེ་དག་ཐམས་ཅད་ནས་ཐམས་ཅད་ཡོངས་སུ་སྤོང་ཞེས་བྱ་བ་སྟེ།",
    "དེ་ཀུན་གང་གིས་འཐོབ་ཅེ་ན།",
    "གཞན་དོགས་པར་འགྱུར་བའི་ཉེས་པ་བྱུང་ཞིང་མ་བསླབས་པའི་སྐྱེ་བོ་དང་ཕྲད་དེ་ཉམ་ང་བ་ན་རང་གི་སེམས་དང་བར་བྱ་བ་དེ་ལ་བསྒྲིམ་པའི་དྲན་པ་དང་།",
    "དེ་ལྟར་དྲན་པ་དེ་དག་གིས་འབྲས་བུ་མེད་པའི་སྤྱོད་པ་རྣམ་པར་སྤང་བ་འགྲུབ་པོ།",
    "ཞི་བའི་ཆེ་བ་ཉིད་འདི་དག་དང་གཞན་ངན་སོང་ལ་སོགས་པའི་སྡུག་བསྔལ་མཐའ་ཡས་པ་ལས་ཡང་དག་པར་འདའ་བ་དང་འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པའི་བདེ་བ་ཕུན་སུམ་ཚོགས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་བདག་ཉིད་འདི་རྟོགས་ནས།",
    "དྲན་པ་གང་གིས་བདུད་ཀྱི་ལས་ཐམས་ཅད་ཀྱི་གོ་སྐབས་མི་འབྱེད་པ་དང་།",
    "དྲན་པ་གང་གིས་ལམ་གོལ་བ་དང་ལམ་ངན་པར་མི་འགྲོ་བ་དང་།",
    "ཉོན་མོངས་མེད་པའི་ཏིང་འཛིན་མྱུར་ཐོབ་སྟེ།",
    "དེ་ལྟ་བས་ན་བདག་གིས་རང་གི་སེམས་ཤིན་ཏུ་གཟུང་བ་དང་།",
    "བརྩོན་འགྲུས་ཀྱིས་རང་གི་སེམས་བརྟན་པར་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་བརྗོད་པ་ཡིན་ནོ།",
    "འཕགས་པ་ནོར་བཟངས་ལྷ་མོ་སྒྱུ་མ་མཐོང་བས་བརྐམ་པར་གྱུར་པ་ལ།",
    "གྲོང་གི་ལྷ་མོ་རིན་ཆེན་མིག་གིས་དེ་མཐོང་བའི་དོན་དུ་འདི་སྐད་ཅེས་རྗེས་སུ་བསྟན་ཏེ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཏིང་ངེ་འཛིན་དང་སྙོམས་པར་འཇུག་པ་དང་བསམ་གཏན་དང་།",
    "ཐལ་བས་གཡོགས་པའི་མེ་བཞིན་དུ།",
    "གང་གི་ཕྱིར་དེ་ཉིད་ལ་བརྙས་པ་དེ་ཉིད་གནོད་པ་ཡིན་ཏེ།",
    "ཚུལ་འདིས་ནི་དོགས་པར་འགྱུར་བའི་བུད་མེད་དང་ལྷན་ཅིག་ཏུ་དབེན་པའི་གནས་ལ་སོགས་པར་གནས་པར་མི་བྱའོ་ཞེས་འཇིག་རྟེན་བསྲུང་བ་མཛད་པར་གྱུར་ཏོ།",
    "དེ་ལ་རེ་ཞིག།",
    "དེ་བཞིན་དུ་རང་གིས་ཀྱང་བརྟགས་པ་དང་།",
    "གར་གྱི་ལྟད་མོ་ལྟ་བའི་ཚིག་མེད་པ་ཡིན།",
    "ཉོན་མོངས་པའམ།",
    "རང་གི་ཕྱོགས་བསྟོད་པའི་ཚིག་གམ།",
    "བདག་གི་རྒྱུད་དང་གཞན་གྱི་རྒྱུད་མ་རུང་བར་བྱེད་པའི་ཚིག་གི་རྣམ་པ་དེ་ལྟ་བུ་སྤངས་ཏེ།",
    "ཡིད་ཚིམ་པར་བྱེད་པས་བདག་གི་རྒྱུད་དང་གཞན་གྱི་རྒྱུད་དང་བར་བྱེད་པ་དང་།",
    "ཚིག་གིས་གཞན་རྣམ་པར་གཡེང་བ་ལྟ་ཅི་སྨོས་ཞེས་བྱ་བའི་བར་དུ་གསུངས་སོ།",
    "གང་གིས་གཞན་ལ་གདུང་བར་འགྱུར་བའི་ཚིག་དེ་སྨྲ་བར་མི་བགྱིའོ།",
    "ཅི་ནས་གཞན་དག་གིས་མ་རུང་བར་མི་འགྱུར་བ་དང་ཅི་ནས་གཞན་དག་རུང་བར་མི་འགྱུར་བའོ།"
  ]
