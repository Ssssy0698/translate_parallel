    "ལུང་དུ་མ་བསྟན་པའི་ལས་མི་རྙེད་པར་འགྱུར་མོད་ཀྱང་།",
    "ཞེས་པ་བྱེ་བྲག་གི་ལས་ནི།",
    "ལུས་ཀྱིས་རེག་བྱ་འཛིན་པར་བྱེད་དེ།",
    "རྟེན་གྱི་དབྱེ་བ་ཕོ་མོ་མ་ནིང་གསུམ་ཞེས་པས།",
    "རྟེན་གྱི་དབྱེ་བ་ནི་ཕོ་དང་མོ་དེ་གཉིས་ཀ་མ་ཡིན་པའི་མ་ནིང་དང་གསུམ།",
    "མ་ནིང་ལ་ཡང་ཟླ་སྟོད་ཕོ་རུ་བྱེད་ཟླ་སྨད་མོ་རུ་བྱེད་པའི་འགྱུར་བ་ཅན་གྱི་མ་ནིང་དང་།",
    "གླུ་དང་དགོད་པ་དང་འཐབ་མོ་དང་རྟ་ཞོན་པ་ལ་དགའ།",
    "དབྱིབས་དགྱེ་བཀྲེས་སྐོམ་ཉོན་མོངས་པ་དང་།",
    "སེང་གེ་དང་ཁྱུ་མཆོག་གི་མཚན་ཉིད་ལྡན་པ་ཡིན་ནོ།",
    "བྱི་ལ་དང་སྤྲེའུ་དང་སྲམ་དང་སྦྲུལ་རྣམས་ཀྱིས་ལམ་འཕྲེད་དུ་བཅད་ཅིང་སོང་བ་དང་།",
    "རོ་ལ་ཞོན་པ་རྨིས་པ་ནི་འཆི་བདག་གིས་ཟིན་པའི་རྟགས་སོ།",
    "མ་ཧེ་དང་རྟ་དང་བོང་བུ་དང་རྔ་མོང་རྣམས་ལ་གཅེར་བུར་ཞོན་ནས་ལྷོ་ཕྱོགས་གཤིན་རྗེ་གནས་པའི་སར་འགྲོ་བ་རྨིས་ན་འཆིའོ།",
    "བྱ་རོག་དང་ཡི་དྭགས་དང་རྨེ་ཤ་ཅན་མ་མོས་བསྐོར་ར་བ་བ་དང་རྐང་དང་པགས་པ་ལྷུང་བ་དང་།",
    "སླར་ཚོང་དང་འཐབ་མོ་ཕམ་པ་དང་།",
    "གོས་དཀར་པོ་གྱོན་པ་དང་འཕན་དང་གདུགས་དང་ཤིང་གི་འབྲས་བུ་རྙེད་པ་དང་།",
    "ཡང་ན་ཁུང་དུ་བྲོས་སམ་རྒྱལ་མོའི་མདངས་ཉམས་ན་འཆི་བ་སྟེ།",
    "གྱེན་དུ་དབུགས་གཅིག་གི་རྗེས་སུ་གཅིག་བརྩེགས་པ་ལྟར་ཕྱིར་དོན་ཞིང་སྡུད་མི་ཤེས་པ་དང་ལུས་ཀྱི་དྲོད་ཡལ་བ་ནི་ངེས་པར་འཆི་བ་ཡིན་ནོ།",
    "ཆུ་ནུས་བརླན་གཤེར་དང་བསིལ་བ་སོགས་མེ་ལ་ཐིམ་པས་ཕྱི་ནང་གི་བུ་ག་བསྐམས་སོ།",
    "མིག་གི་ཞེས་པ་ནས་རེག་མི་ཚོར་ཞེས་པའི་བར་ཏེ།",
    "ཕྱི་དང་ནང་དང་སྲོག་གི་ཟུངས་ནི་རིམ་པ་ལྟར་ཕྱིའི་ཟུངས་ཤ་ནང་གི་ཟུངས་ཟས།",
    "སྲོག་གི་ཟུངས་རྩ་དང་གསུམ་མོ།",
    "གཞུང་གི་འབྲུ་མནན་པའོ།",
    "རྒྱ་ཆེན་འཆད་པའི་སྤོབས་པ་མ་མཆིས་མོད།",
    "ཅུང་ཟད་བརྗོད་འདི་རང་གི་ཡིད་ཀྱི་སྐྱེས།",
    "གཉིས་པ་གཞུང་གི་དོན་ལ་གཉིས།",
    "དེ་ནི་ཉོན་མོངས་ཐམས་ཅད་ཀྱི་རྟེན་ཉེས་པ་ཐམས་ཅད་ཀྱི་རྒྱུ་སྡུག་བསྔལ་ཐམས་ཅད་དང་མི་འབྲལ་བའི་རྩ་བ་ཡིན་ཏེ།",
    "དཔེར་ན་བྱ་ནི་མཁའ་ལ་ལྡིང་གྱུར་ཀྱང་རང་གི་གྲིབ་མ་དེ་དང་ནམ་ཡང་མི་འབྲལ་བ་བཞིན་དུ།",
    "གཏི་མུག་གིས་དུད་འགྲོ་སོགས་སུ་འགྱུར་ལ།",
    "འདི་དག་ཐལ་བར་བསྲེག་པ་མ་ཡིན་ཀྱང་།",
    "ཅི་ཕྱིར་མ་རིག་མེད་ན་ཉོན་མོངས་མེད།",
    "ཉོན་མོངས་མེད་པར་ཞེ་སྡང་མི་འབྱུང་སྟེ།",
    "དེ་མ་ཐག་རྐྱེན་སློང་རྐྱེན་དང་རྣམ་པ་གསུམ་མོ།",
    "གྲོ་བཞིན་དང་ཁྲུམས་སྟོད་དང་ཐ་སྐར་དང་སྨིན་དྲུག་གི་ཟླ་བ་བཞི་ནི་ཆར་འབབ་པའི་དུས་ཏེ་དེ་ལྟར་དུས་གསུམ་མོ།",
    "དེ་ལྔའི་ཡུལ་གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱ་ལྔ་ལ་ཆུང་ཞེས་པ་ཤས་ཆུང་ངུ་སྟེ་བག་ཙམ་གཏད་པའི་དོན་ཏེ།",
    "འདིར་སྤྱོད་ལམ་གྱི་ཁོངས་སུ་བསྡུས་ནས་རེ་ཞིག་རྐྱེན་དུ་བཞག་གོ།",
    "སྤྱི་ཡི་དོན་དང་ཚིག་གི་དོན་ནོ།",
    "ཉེས་པཔ་གསུམ་རང་གི་མཚན་ཉིད་རྐྱང་པ་གང་དུ་འཕེལ་བ་དེར་རང་གི་གནས་སུ་བཞག་ལ།",
    "དེ་དག་གི་མཚན་ཉིད་ལྷག་པ་བྲི།",
    "གཉིས་པ་ཚིག་གི་དོན་ལ།",
    "གསོག་ལྡང་ཞི་བ་གསུམ་གའི་རྒྱུ་ནི་ཉེས་པ་གསུམ་རང་གི་མཚན་ཉིད་ཐ་མལ་དུ་གནས་པ་དེ་ལས་རྐྱེན་དུས་གདོན་ཟས་སྤྱོད་ཀྱི་མཚན་ཉིད་དང་ཕྲད་པ་ལས་འབྱུང་སྟེ།",
    "འཇུག་སྒོ་དྲུག་གང་རུང་ལ་བབས་ནས་ཉེས་པའི་མཚན་ཉིད་འཕེལ་ཟད་འཁྲུགས་པ་རང་གི་རྟགས་སྟོན་པར་བྱེད་པ་སྟེ།",
    "ལོ་གཅིག་ནང་གི་ཚིགས་ཚིགས་ཡོངས་སུ་འགྱུར།",
    "དེ་ནས་སྨིན་དྲུག་གི་བཅོ་ལྔའི་བར་སྟོན་གྱི་དུས་སོ།",
    "ཁྱད་པར་སློང་རྐྱེན་ཐུན་མོང་ཁྱད་པར་གཉིས།",
    "ལྟོ་ཆག་པ་དང་གཉིད་ཆག་པ་དང་ལྟོ་སྟོང་དུ་ལུས་དང་ངག་གི་བྱ་བ་དྲག་ཅིང་ནན་གྱིས་འཇུག་པའི་དྲག་ཤུལ་བྱས་པ་དང་།",
    "གཞུ་སྲན་ནམ་སྲ་མོ་བཀང་བ་དང་འཛིང་ཁ་བཀྱེ་བ་དང་།",
    "ཧ་ཅང་ཚོ་ཆེ་བའི་ཚིལ་བུ་དང་འབྲུའི་མར་དང་རྩི་མར་རུལ་བ་དང་ལོ་ཤུར་ཞེས་པ་ཡུང་མ་དང་ལ་ཕུག་གི་ལོ་མ་བཙོས་པ་བམ་པ་དང་།",
    "ཇི་ལྟར་འཇུག་པའི་ཚུལ་དང་ཞུགས་པའི་ལམ་མོ།",
    "དོན་ནི་འབྱུང་པ་ཆེན་པོའི་ཡོན་ཏན་སྒྲ་དང་རེག་བྱ་དང་གཟུགས་དང་དྲི་དང་རོའོ།",
    "དུས་དང་གདོན་དང་ཟས་དང་སྤྱོད་ལམ་མོ།",
    "གསང་བའི་ཕྱི་རོལ་བཅུ་དྲུག་གིས།",
    "རེག་བྱ་ཞེས་པ་བ་སྤུ་དང་།",
    "བསིལ་བ་དང་འབྱར་བག་གི་མཆིལ་མ་དང་།",
    "དྭངས་མ་ཞེས་པ་ནས་བུད་མེད་དད་ཅེས་པའི་བར་ཏེ།",
    "ཁྲག་མཁྲིས་སྐྱེད་པའི་རེས་མོའི་རང་བཞིན་ཅན་སྐྱུར་བ་ལ་དད་ཅིང་འདོད་དོ།",
    "སོ་དང་སེན་མོ་ཕྱི་རུ་འབྱུང་ཞིང་གོག་པར་འགྱུར་རོ།",
    "མིག་གི་སྟོབས་བསྐྱེད་པའི་རྟེན་བྲི་བས་མིག་གི་མཐོང་བྱེད་འགྲིབ་པར་འགྱུར་རོ།",
    "གསུམ་པ་འཁྲུགས་པའི་རྟགས་ལ་སྤྱི་དོན་དང་ཚིག་གི་དོན་གཉིས་སོ།",
    "རྣ་བ་འུར་ཞིང་འཁྲོག་ཁྲག་གིས་དྲོད་བུས་པས།",
    "རེས་རུས་རྐང་ཆག་པ་སྙམ་བྱེད།",
    "རེས་མིག་སོགས་ཕྱིར་འབྱིན་པ་སྙམ་བྱེད་པ་དང་རེས་འགའ་ཐག་པ་དཀྲིས་པ་སྙམ་བྱེད་ཅིང་རྒྱུན་མི་བརྟན་པའོ།",
