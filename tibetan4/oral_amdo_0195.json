    "བཅུ་དྲུག་ནས་གནམ་གང་གི་བར་ནག་ཕྱོགས་སོ།",
    "དེ་ནས་ནག་པོའི་ཚེས་གཅིག་ནས་གནམ་གང་གི་བར་གཡོན་ཕྱོགས་སུ་རྐང་པའི་མཐེ་བོང་བར་འགྲོ་བ་ཤེས་པའི་ཆེད་དུ་སྟེ།",
    "ནག་པོའི་ཕྱོགས་མཐའ་སོར་མོར་སླར་ཡང་སྤྱི་གཙུག་ནས་ནི་འགྲོ་བར་འགྱུར་ཞེས་པས་སོ།",
    "ཉི་མའི་སྣང་བ་མངོན་མ་ཐག་ནི་ནམ་ལངས་མཚམས་དེ་ནས་བཟུའཐད་དམ་སྙམ་མོ།",
    "ཞེས་སོགས་དང་སྒྲིག་མ་བདེ་བས་རེ་ཞིག་དངོས་བསྟན་ལྟར་བཟུང་ན་འཐད་པར་སེམས་སོ།",
    "ཚེས་ཞག་སུམ་བརྒྱ་དོན་གཅིག་ཉིན་ཞག་སུམ་བརྒྱ་རེ་ལྔ།",
    "དེས་ན་ཉིན་ཞག་དང་ཚེས་ཞག་གི་བར་ཁྱད་ལ་དྲུག་དང་།",
    "དུས་དྲུག་གི་བྱེ་བྲག་ཕྱེས་ཏེ་བསྟན་པའོ།",
    "དེ་དག་གི་རིམ་པ་ནི་དགུན་ཟླ་ར་བ་དང་སོགས་པའི་སྒྲས་དགུན་ཟླ་འབྲིང་པོ་དང་དགུན་ཟླ་ཐ་ཆུང་གསུམ་དེ་བཞིན་དུ་དཔྱིད་ཟླ་གསུམ་དབྱར་ཟླ་གསུམ་སྟོན་ཟླ་གསུམ་བཅུ་གཉིས་ཡོད་པ་ལས།",
    "དགུན་ཟླ་ཐ་ཆུང་གི་བཅོ་ལྔ་ཡན་དང་འབྲིང་པོའི་བཅུ་དྲུག་གི་བར་བར་ལ།",
    "དགུན་ཟླ་ར་བ་ཞེས་སྨོས་པ་ནི་ཟླ་བའི་ར་བ་འབྲིང་པོ་སོགས་ཀྱི་དུས་བཞི་ལ་དགོངས་པ་སྟེ་འདིར་དུས་དྲུག་གི་དང་པོར་བཟུང་བར་མི་བྱ་ལ་ཡང་ཡར་ངོ་སྔོན་འགྲོ་ལྟར་བྱེད་པའི་ལུགས་ལ་ནི་མགོ་ཟླའི་ཚེས་གཅིག་ནས་དགུན་ཟླ་ར་བ་དེ་དང་པོར་བྱེད་པའང་སྣང་།",
    "དེས་ན་སྨིན་དྲུག་གི་མར་ངོའི་བཅུ་དྲུག་ནས་ཟླ་བ་གཉིས་གཉིས་རིམ་པ་བཞིན་དུ་རྒྱལ་གྱི་བཅོ་ལྔའི་བར་དུ་དགུན་སྟོད་དེ་ནས་དབོའི་བཅོ་ལྔའི་བར་དུ་དགུན་སྨད།",
    "དེ་ནས་སྨིན་དྲུག་གི་བཅོ་ལྔའི་བར་སྟོན་གྱི་དུས་སོ།",
    "སྟོན་དཔྱིད་ཉིན་མཚན་མཉམ་པའི་དུས་སུ་ཡུད་ཙམ་བཅོ་ལྔ་རུ་མཉམ་མོ།",
    "ཟླ་བ་གསུམ་ལ་ཡུད་ཙམ་གསུམ་ལྷག་པས་ཉིན་མོ་ཡུད་ཙམ་བཅོ་བརྒྱད།",
    "མཚན་མོ་དེ་བཞིན་དུ་ཟད་པས་ཡུད་ཙམ་བཅུ་གཉིས་སོ།",
    "དེར་ཉི་མ་རིང་བའི་མཐར་ཐུག་པས་དབྱར་ཉི་ལྡོག་དེ་ནས་དགུན་ཉི་ལྡོག་པར་ཐུག་གི་བར་དུ་ཞག་རེ་བཞིན་མཚན་མོ་ཐང་རེ་འཕེལ།",
    "ཉིན་མོ་ཐང་རེ་ཟད་པར་ཤེས་པར་བྱའོ།",
    "ནམ་དང་ཉི་མ་ནི་ལྷོ་བྱང་གི་བགྲོད་པ་མཐར་ཐུག་པ་ལ་ཟླ་བ་དྲུག་ཡོད་པ་ལས་གསུམ་སོང་བའི་ཕྱེད་མཚམས་འདི་ན་མཉམ་པ་ཡིན་ཏེ།",
    "ཉིན་མཚན་མཉམ་མོ།",
    "ཉི་མ་ལྡོག་ནས་ཞག་བརྒྱ་ཐམ་པ་དང་བཅུ་སོང་བའི་དུས་ན།",
    "དེ་ནས་ཟླ་བ་གསུམ་ཞག་མི་ཐུབ་ཀྱི་ཆ་ཅི་ཞག་ཞག་ལྔ་སོང་བའི་ཆུ་སྟོད་ཀྱི་ཟླ་བའི་བཅུ་དྲུག་ནས་དབྱར་འབྲིང་དུ་བཞག་པའི་ཉེར་གསུམ་ལ་བྱང་བགྲོད་མཐར་ཐུག་པ་དབྱར་ཉི་ལྡོག་དེ་ནས་ཟླ་བ་གསུམ་ལྷོ་ལ་ཇེ་ཉེར་སོང་བའི་ཐ་སྐར་ཟླ་བའི་ཉེར་གསུམ་གྱི་ཞག་ལ་ལྷོ་བགྲོད་ཀྱི་ཕྱེད་དུ་སླེབས་པ་སྟོན་ཉིན་མཚན་མཉམ།",
    "དེ་ནས་ཟླ་བ་གསུམ་དང་ཞག་ལྔ་སོང་བའི་རྒྱལ་ཟླའི་ཉེར་བརྒྱད་ལ་དགུན་ཉི་ལྡོག་གོ།",
    "ཡང་རྒྱལ་ཟླའི་ཚེས་བཅོ་བརྒྱད་ལ་དགུན་ཉི་ལྡོག་ནས་ཞག་བརྒྱ་ཐམ་པ་དང་བཅུ་སོང་བའི་ས་གའི་ཟླ་བའི་ཚེས་བརྒྱད་ལ་འབྲུག་གི་སྒྲ་དང་པོ་སྒྲོག་ཀྱི་ཉེར་གསུམ་ལ་དབྱར་ཉི་ལྡོག་པའི་ཞག་བརྒྱ་དང་བཅུ་སོང་བའི་སྨིན་དྲུག་གི་ཟླ་བའི་ཚེས་བཅུ་གསུམ་ནས་འབྲུག་གི་སྒྲ་ཆད་པར་འགྱུར་རོ།",
    "དེ་ལ་ཞེས་པ་ནས་ཉིན་རེ་འཕྲོག་ཅེས་པའི་བར།",
    "གཞན་ལྕི་བརྟན་རྟུལ་འཇམ་སྣུམ་འཇམ་སླ་གཉེན་གྱི་ནུས་པའི་སྟོབས་བྲི་ནས་དེ་དག་གི་ཡོན་ཏན་ལུས་འཕེལ་བ་དང་འཚོ་བ་སོགས་ཟད་པར་བྱེད་པས་བྱང་བགྲོད་ཀྱི་ཟླ་བ་དྲུག་པོ་འདི་ཡི་དུས་སུ་ནི་རྣོ་ཚ་རྩུབ་པ་སོགས་ཀྱི་ངོ་བོའམ་རྟེན་ཁ་བ་བསྐ་བ་ཚ་བའི་རོ་གསུམ་གའི་ནུས་སྟོབས་ཇེ་ཆེར་སྐྱེད་མོད་ཀྱི།",
    "མི་ཕྱུགས་སྲོག་ཆགས་རྣམས་ཀྱིས་ནི་རྒྱུ་ལུས་ཟུངས་འགྲིབ་པས་འབྲས་བུ་མཐུ་དང་སྟོབས་ཉིན་རེ་བཞིན་འཕྲོག་ཅིང་ལུས་ཟུངས་ཟད་པ་དགུན་སྨད་དཔྱིད་དབྱར་རྣམས་སུ་རིད་པ་དང་སྐེམ་པ་དང་མཐུ་སྟོབས་ཆུང་ངོ།",
    "དབྱར་ཉི་ལྡོག་ནས་ཆར་འབབ་པའི་དུས་ཉི་མ་ལྷོའི་ཕྱོགས་སུ་ཇེ་ཉེར་འགྲོ་བའི་གཤོལ་ཆ་དང་བཅས་པའི་ཟླ་བ་དྲུག་གི་ཚེ།",
    "ལྷོ་བགྲོད་ཀྱི་དུས་སུ་སྐྱུར་བ་དང་ལན་ཚ་བ་དང་མངར་བའི་རོ་གསུམ་གའི་སྟོབས་སྐྱེད་མོད་ཀྱི་བྱེ་བྲག་ཏུ།",
    "གསུམ་པ་དུས་དྲུག་གི་བྱ་བ་བྱེ་བྲག་ཏུ་བསྟན་པ་ལ་གསུམ།",
    "གོང་དུ་བསྟན་པ་དེ་ལྟར་ཉི་མ་བྱང་དང་ལྷོ་རུ་བགྲོད་པའི་དུས་རྣམས་ཀྱི་འཕེལ་འགྲིབ་བསྟན་ནས་ནི་ནམ་ཟླའི་དུས་དྲུག་གི་སྤྱོད་པ་བསྟན་པ་ལ།",
    "དེའི་ཚེ་མཚན་མོ་རིང་བས་བཀྲེས་པར་འགྱུར་ཏེ་ལུས་ཀྱི་སྣུམ་བཅུད་མེ་དྲོད་ཀྱི་ཟད་པས་སྐྱ་བ་དང་།",
    "སྦྱང་བའི་སྒོ་ནས་ཕྱིར་འབྱིན་པའི་སྤྱོད་ལམ་མོ།",
    "གཉའ་བ་རེངས་པ་དང་ཁ་ཡོ་སྟེ་འགྲམ་པ་ཆག་པ་ལྟ་བུར་འགྱུར།",
    "ཟི་ར་དབྱི་མོང་ཙི་ཏྲ་ཀ་ཆ་གཉིས།",
    "པོ་སོ་ཆ་དང་དུད་པ་ཚ་སྦྱར་བའི་རེང་བུ་མས་བཏང་བ་དང་མར་གྱི་འཇམ་རྩི་དང་།",
    "ཅེས་པ་འཕྲོད་དམ་སྙམ་མོ།",
    "སྤྱི་དོན་དང་གཞུང་གི་དོན་ནོ།",
    "སྲོག་ཆགས་ལས་བྱུང་བའི་བསྐྱེད་བྱ་སྐྱེད་བྱེད་མཐུན་པར་ཁྲག་གིས་ཁྲག་སྐྱེད་དོ།",
    "ནམ་མཁའི་ཡོན་ཏན་ནི་ཐུན་མོང་དུ་གོ་འབྱེད་ཅིང་སྟོང་པའི་ཆའོ།",
    "ཙོ་ཙ་དང་མོ་ཙ་དང་ཁ་རྫུ་ར་ལ་སོགས་པ་སའི་ཁམས་ཅན་གྱི་རྫས་སུ་བསྟན་དུ་ཟིན་ཀྱང་།",
    "ལ་སོགས་པའི་སྒྲས་དེ་དག་གི་རིགས་མཆོག་དམན་དང་།",
    "ནུས་པ་ཡང་དེ་མཐུན་གྱི་ས་ཆུའི་རང་བཞིན་ཅན་གྱི་དྭངས་མ་ནས་ཁུ་བའི་བར་གྱི་ལུས་ཟུངས་འཕེལ་བས་རོ་ཙ་བ་བུད་མེད་ལ་ཕོད་པ་དང་།",
    "ཉེས་པ་གསུམ་ནི་གཅིག་གི་འོག་ཏུ་གཅིག་མི་འདུ་ཞིང་།",
    "གང་བུ་ཅན་གྱི་འབྲུ་སྲན་མ་དང་མོན་སྤུན་གཉིས་ནི།",
    "སྲན་ཆུང་ལེབ་མོ་ནི་རོ་བསྐ་མངར་ནུས་པ་བསིལ་ཞིང་རྩུབ་པ་སོགས་ཀྱི་ལུས་ཀྱི་ཁམས་ཟད་པར་བྱེད་པས་ཉེས་པ་གསུམ་ཀ་སྐྱེད་ཅིང་།",
    "སྐམ་གཤེར་གཉིས་ཀ་ཐུན་མོང་དུ་གནས་པ་གསུམ་མོ།",
    "མཛོ་དང་གཡག་དང་རྔ་མོང་དང་རྟ་དང་བོང་བུ་དང་བ་གླང་དང་སྐོམ་པོ་མཛོ་མོ་ལས་སྐྱེས་པའི་རྟོལ་དང་།",
    "མིའི་བདག་བྱེད་པ་རྣམས་ནི་སྐམ་གཤེར་གཉིས་ཀར་ཐུན་མོང་དུ་གནས་པ་སྟེ།",
    "ཐུན་མོང་དུ་གནས་པ་ནི་སྐམ་གཤེར་གཉིས་ཀའི་ནུས་པ་ཚ་གྲང་གཉིས་ལྡན་ནོ།",
    "ཕག་གི་ཤ་ནི་བསིལ་ལ་ཡང་བས་རྨ་འཇིག་གམ་བཤིག་སྨུག་པོ་རྒྱས་པ་སེལ་ལོ།",
    "རི་བོང་གི་ཤ་ནི་རྩུབ་ཅིང་དྲོད་སྐྱེད་འཁྲུ་བ་གཅོད་དོ།",
    "ཤ་ཀུན་ལ་ཕོ་དང་མོའི་སྟོད་སྨད་དུ་ཕྱེད་མར་བྱས་པའི་ལྕི་ཡང་ཡོད་པ་སྟེ།",
    "མོའི་སྨད་ལྕི་ལ་སྟོད་ཡང་ངོ།",
    "ཞུན་མར་རང་གིས་ཕན་པའི་ལས་སྟོང་སྐྱེད་བྱེད་དེ།",
    "ཆ་ཤས་ཆེ་ཆུང་ལས་བསིལ་དྲོད་ལྕི་ཡང་གི་བྱེ་བྲག་རྗེས་སུ་དཔག་པར་བྱ་དགོས་སོ།",
    "ཐིག་པཎ་ཞེས་མིང་གི་རྣམ་གྲངས་སོ།",
    "རྩམ་པ་རང་འགམས་པ་དང་ཆུ་གྲང་མོ་བསྲེས་པའི་ཟན་ནི་ལུས་ཀྱི་སྟོབས་སྐྱེད་ཅིང་ལྕི་བ་ཡིན་ནོ།",
    "ཡུངས་མ་དང་ལ་ཕུག་གི་མྱུ་གུ་བཙོས་ཏེ་སྲན་ཕྱེ་དང་སྦྱར་བ་བསྙལ་ནས་ལངས་པའི་སྐྱུར་པོ་ནི་ཟས་ཡི་གར་ལེན་ཉེས་པ་གསུམ་ཀ་སེལ་ལ།",
    "མོན་སྣེའུ་དམར་པོ་ནི་ཉེས་པ་གསུམ་སེལ་ཏེ།",
    "བུད་མེད་ལ་ཕོད།",
    "སྐྱབས་ལ་དཀར་ནག་གཉིས་ལས་དཀར་པོ་ཁྲབ་མོ་དང་།",
    "དཀར་པོ་རྡོག་ཆེ་བ་ལ་རྫས་ཀྱི་ཁྲོ་རྒྱལ་ཤ་རི་རམ་ནག་པོ་དཔལ་སྒང་ངམ་དཔལ་མོ།",
    "ལ་ཕུག་གི་ཚ་བའམ་ཚོད་མས་ནི་དྲོད་སྐྱེད་འཁྲུ་བ་གཅོད།",
    "དུད་འགྲོ་རྩྭ་གཙང་མ་ཟོས་ཤིང་དྲག་དལ་དུ་མ་སོང་བའི་འོ་མ་གཞིར་བཅས་ལ།",
    "འོ་མ་རློན་པའམ་གྲང་མོ་ནི་ལྕི་ཞིང་བསིལ།",
    "བཞོས་མ་ཐག་པའི་འོ་མ་དྲོན་མོ་ནི་བདུད་རྩིར་མཚུངས་ཏེ་ཕན་ཞིང་དགེའོ།",
    "སྟོན་འབྲིང་ཐ་སྐར་སྲང་གི་ཁྱིམ་དུ་ཉི་མ་གནས་པའི་དུས་དང་།",
    "ཤིང་གི་གྲིབ་མ་ཕོག་པས་ཉི་ཟླ་མི་མཐོང་བ་དང་།",
    "ཐལ་དྲགས་པའི་སྐྱོན་བསྟན་པ།",
    "གསུམ་པ་ནི་ཐལ་དྲགས་ཞེས་པ་ནས་མུན་པའི་གནས་སུ་འགྱུར་ཞེས་པའི་བར་ཏེ།",
    "ཆང་གིས་སེམས་སྒྱུར་བ་ནི་གང་།",
    "ཀུན་ཏུ་རྟོགས་ཤིང་ཡུལ་ཡུལ་ཅན་དུ་འཛིན་པ་འདི་ཉིད་རྐྱེན་གྱིས་ཅིར་ཡང་བསྒྱུར་བ་ལྟར་སྣང་བ་དེ་ལ་ལུགས་གཉིས་ཀྱི་ཚུལ་ལས་བྱུང་བ་ལྟར་མི་རིགས་པ་དང་རིགས་པའི་གནས་ལ་འདོར་ལེན་བྱེད་པའི་དཔྱད་ཤེས་ཀྱི་སེམས་དེ་ཆང་གིས་བག་མེད་པར་སྒྱུར་བའོ།",
    "ཆང་གི་ནུས་པ་རྣོ་དྲོ་རྩུབ་ཕྲ་སོགས་ཀྱིས་འཁྲུགས་ཤིང་འཇོམས་པར་བྱེད་ཅིང་།",
    "ཆང་གི་མཐུ་ནི་རྣོ་བ་དང་དྲོད་ཆེ་བ་སོགས་ཡིན་ནོ།",
    "ཆང་གི་ཡོན་ཏན་བཅུ་བོས་མདངས་ཀྱི་ཡོན་ཏན་བཅུ་བོ་འཁྲུགས་པར་བྱས་ནས་སེམས་བསྒྱུར་ཏེ་ཁྲིད་པ་ནི་ར་རོ་བ་ཞེས་བྱའོ།",
    "གང་གིས་བསྒྱུར་ན་ཆང་གིས་སོ།",
    "དེས་ན་ཆང་ཧ་ཅང་ཐལ་དྲགས་ན་ལེགས་ཉེས་བརྟག་པའི་སེམས་ལོག་པར་བསྒྱུར་ནས་ཚུལ་མ་ཡིན་པ་ལ་འཇུག་པ་བག་མེད་པར་གྱུར་ནས་ངོ་ཚ་འཇིག་པར་བྱེད་དོ།",
    "སེམས་མེད་ཅིང་ཚོར་བ་མེད་པའི་རོ་ལྟར་འགྱེལ་ནས་ཉལ།",
    "ངོ་གནོང་བའི་བག་དག་གིས་མིག་མི་ལ་མི་ཆགས་པར་གཡས་གཡོན་གྱི་ཕྱོགས་སུ་ལྟ་བར་བྱེད་དོ།",
    "ཤ་མོ་སེར་ཤ་ཡུངས་དཀར་མར་ལ་བརྔོས་པ་དང་།",
    "ཅོང་ཞི་ཟོས་པའི་རྗེས་ལ་ཤ་མོ་དང་འཁུར་བ་སྣུམ་འཁུར་རམ་བྲ་འཁུར་ཟ་བ་དང་།",
    "ཞུན་མར་ཟོས་པའི་རྗེས་ལ་ཆུ་གྲང་མོ་འཐུངས་པ་དང་།",
    "དེ་ནས་ཉིན་རེ་བཞིན་འཕྲོད་པ་བཞི་ཆ་རེ་རེ་ཕྲི་ཞིང་མི་འཕྲོད་པ་བཞི་ཆ་རེ་རེ་སྐྱེད་ནས་ཟོས་ན་མཐར་མི་འཕྲོད་པ་རྐྱང་པར་ཟོས་ཀྱང་འཕྲོད་པར་འགྱུར་ཏེ།",
    "ལྕི་ཡང་གི་བསྟེན་ཚུལ་སྤྱིར་བསྟན་པ།",
    "ལྕི་ཡང་གི་བྱེ་བྲག་འབྱེད་པའི་ཚད་ལ་སྲང་ཚད་ཅེས་པ་ལྟར།",
    "ཞོ་དང་ཆང་དང་དུག་གིས་སྦགས་པའི་ཟས་དང་།",
    "སྤྱིའི་གོ་དོན་བསྟན་པ་དང་གཞུང་གི་ཚིག་དོན་བསྟན་པའོ།",
    "དེ་ནས་ཇི་ལྟར་ནང་གི་ལུས།",
    "ཁམས་གསུམ་ནང་གི་བདག་ཉིད་དེ།",
    "རྐྱང་པ་ལྡན་དང་ཚོགས་པ་སོགས།",
    "ཁ་ཚ་བསྐ་གསུམ་ཁ་བར་ཞུ་སྟེ་ཉེས་པ་གསུམ་གཉིས་གཉིས་རེ་རེས་སེལ་བའི་དོན་གྱིས་སོ།",
    "ཐ་མལ་པར་གནས་པ་ལ་ཕན་པ་ནི་གནོད་པ་ནས་དྲི་མའི་མཐར་ཐུག་གི་བར་དུ་རང་གི་ཚད་དང་ལྡན་པར་གནས་པ་ནི་མཉམ་པར་འཇུག་ཅིང་ཐ་མལ་པར་གནས་པ་གནས་པ་སྟེ།",
    "བ་ཞུང་གི་དོན་ལ་གཉིས་བསླབ་པར་ཞུས་པ་དང་དེའི་ལན་ནོ།",
    "ཡང་མངར་བ་དང་ཁ་བ་ལ་སོགས་པའི་རོ་དྲུག་ཆར་གྱི་ཆ་ཤས་ནི་ཡོད་མོད་ཀྱི།",
    "དེ་དྲུག་གི་ལས་ཀྱི་མཚན་ཉིད་ནི།",
    "དེ་དག་གི་རང་བཞིན་དང་མཚན་ཉིད་སྣུམ་ལྕི་འཇམ་བརྟན་སླ་བསིལ་རྟུལ་མཉེན་དང་ལྡན་ཞིང་།",
    "དེ་ལས་གྱེས་པས་མངར་བའི་མངར་བ་སྐྱུར་བ་མངར་བའི་སྐྱུར་བ་ལན་ཚྭ་བ་མངར་བའི་སྐྱུར་བ་ཁ་བ་མངར་བའི་སྐྱུར་བ་ཚ་བ་མངར་བའི་སྐྱུར་བ་བསྐ་བ་སྟེ་དེ་དྲུག་སོ་སོ་ག་པོ་རེ་རེ་ལ་སྦྱར་བས་ཉིས་བརྒྱ་དང་བཅུ་དྲུག་དེ་ལས་གྱེས་པ་མངར་བའི་མངར་བ་སྐྱུར་བ་ལན་ཚྭ་བ་མངར་བའི་སྐྱུར་བ་ལན་ཚྭ་བ་ཁ་བ།",
    "མངར་བའི་སྐྱུར་བ་ལན་ཚྭ་བ་ཚ་བ་མངར་བའི་སྐྱུར་བ་ལན་ཚྭ་བ་བསྐ་བ་སོགས་གོང་གི་ཉིས་བརྒྱ་བཅུ་དྲུག་པོ་རེ་རེ་ལ་སྦྱར་བས་སྟོང་དང་ཉིས་བརྒྱ་དགུ་ཅུ་རྩ་དྲུག་གོ།",
    "མངར་བའི་སྐྱུར་བ་ལན་ཚྭ་བ་ཁ་བ་བསྐ་བ་མངར་བའི་ལན་ཚྭ་བ་ཁ་བ་ཚ་བ་བསྐ་བ་སོགས་དྲུག་པོ་སྟོང་ཉིས་བརྒྱ་སོ་དྲུག་པོ་རེ་རེ་ལ་སྦྱར་བས་བདུན་སྟོང་བདུན་བརྒྱ་བདུན་ཅུ་རྩ་དྲུག་ཏུ་འགྱུར་རོ།",
    "ལན་ཚྭ་བའི་ཚ་བ་ཁ་བ་བསྐ་བ་མངར་བ་སྐྱུར་བ་ཁ་བའི་ཚ་བ་བསྐ་བ་མངར་བ་སྐྱུར་བ་ལན་ཚྭ་བ་ཚ་བའི་བསྐ་བ་མངར་བ་སྐྱུར་བ་ལན་ཚྭ་བ་ཁ་བ་བསྐ་བའི་མངར་བ་སྐྱུར་བ་ལན་ཚྭ་བ་ཁ་བ་ཚ་བ་དྲུག་པོ་གོང་གི་བདུན་སྟོང་བརྒྱ་བདུན་ཅུ་རྩ་དྲུག་པོ་གོང་གི་བདུན་སྟོང་བདུན་བརྒྱ་བདུན་ཅུ་རྩ་དྲུག་པོ་རེ་རེ་ལ་སྦྱར་བས།",
    "དེ་ལས་གྱེས་པ་ནི་བགྲང་བ་ལས་འངའདས་པར་འགྱུར་བ་དེ་དག་གི་རྟེན་འབྱུང་པའི་མཚན་ཉིད་ཀྱང་ཆེས་བགྲང་བ་ལས་འདས་པར་འགྱུར་མོད།",
    "སྲོག་གི་རྟེན་ལུས་ཀྱི་ཟུངས་རྣམས་ནི།",
    "ལན་ཚྭ་བས་ནི་གང་དུ་རེག་པ་དེ་ན་ཚ་ཞིང་མཆིལ་མ་འདུའོ།",
    "དེ་རྣམས་ནི་དྲུག་པོ་དེ་དག་གི་མཚན་ཉིད།"
  ]
}