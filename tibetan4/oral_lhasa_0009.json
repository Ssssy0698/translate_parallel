    "གང་རྟོག་པའི་རྒྱལ་པོ་འདིར་སྒྲུབ་པར་འགྱུར་བ་དང་།",
    "སྲུང་བར་བྱེད་པར་འགྱུར་རོ།",
    "ས་ཕྱོགས་དེ་གང་ཉིད་ཀྱིས་ལག་མཐིལ་དུ་ཕྱིན་པར་འགྱུར་རོ།",
    "འདིའང་གཙང་མའི་ཕྱོགས་སུ་ཐམས་ཅད་ཀྱིས་རབ་ཏུ་སྤྱོད་པར་འགྱུར་གྱི།",
    "ལྷག་མ་མེད་པའང་རུང་སྟེ་གཙང་སྦྲ་བྱས་པས་སྲུང་བའི་དོན་དུ་རིག་པའི་རྒྱལ་པོའི་སྔགས་སུ་འགྱུར་བ་ནི།",
    "ཁྱད་པར་དུ་ཡོན་དང་བཅས་པའོ།",
    "དེ་ནས་འདི་རྫོགས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་བྱ་སྟེ་རྟོག་པའི་རྒྱལ་པོ་ཇི་ལྟ་བ་བཞིན་དུ་རྟོག་བའི་རྒྱལ་པོའི་རིག་པའི་གསང་སྔགས་བཀླག་པར་བྱ་སྟེ་དེ་བཞིན་དུ་དམན་པར་མི་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པས་རྗེས་སུ་གནང་བ་དང་།",
    "རལ་པ་གྱེན་བརྫེས་སུ་ཇི་སྐད་གསུངས་པའི་དཀྱིལ་འཁོར་མཐོང་ཞིང་དམ་ཚིག་དང་།",
    "སློབ་དཔོན་གྱིས་རྗེས་སུ་གནང་བ་དང་།",
    "སྐུ་གཟུགས་ཀྱི་དྲུང་དུ་སླར་ཡང་སྒྲོལ་མ་གང་ཡང་རུང་བའི་རིག་པ་བླང་བར་བྱས་ནས་དཀར་པོའི་ཚེས་གཅིག་ནས་བརྩམས་ཏེ་འབུམ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་རིག་པ་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ནས་དཀར་པོར་རྣམ་པར་བརྟག་པ་ལེགས་པར་བཀྲུས་ཤིང་དྲི་ཞིམ་པོའི་གོས་སྐྲ་དང་བྲལ་བའི་སྦྱིན་སྲེག་བརྒྱད་བརྒྱ་བྱའོ།",
    "ག་བུར་རྣམས་གཅིག་ཏུ་བྱས་ནས་མར་གྱིས་བཏགས་པའི་སྲེག་བླུགས་བདུན་དབུལ་བར་བྱའོ།",
    "དེ་ནས་གཞོན་ནུ་མས་བཀལ་བའི་སྐུད་པ་ཆ་དང་བཅས་པར་བྱས་པ་ལ་མར་གྱིས་བཏགས་པའི་སྲེག་བླུགས་བདུན་སྦྱིན་སྲེག་བྱའོ།",
    "དངོས་གྲུབ་ཀྱི་རྗེས་སུ་གནང་བའང་ཞུ་བར་བྱའོ།",
    "དེ་ལྟར་ཡང་རིག་པ་རབ་ཏུ་སྦྱར་བ་དེ་ལྟ་དེ་ལྟར་ལེགས་པར་རབ་ཏུ་སྦྱར་བར་འགྱུར་རོ།",
    "ཇི་ལྟར་ཡང་སྒྲུབ་པར་བྱེད་པ་དེ་ལྟར་སྒྲུབ་པར་བྱེད་དེ་ལས་དེ་དང་།",
    "འདི་ཁོ་ནའི་ལག་མཐིལ་དུ་དངོས་གྲུབ་སོ་སོར་གནས་པར་རྗེས་སུ་རྟོགས་པར་བྱའོ།",
    "ལས་འདིའང་གསོ་སྦྱོང་ཅན་གྱི་སྔོན་འདས་པ་བྱས་པ་དག་འཕགས་པ་ཇི་ལྟ་བ་བཞིན་དུ་རྟོགས་པར་བྱའོ།",
    "མེ་ཏོག་ལ་སོགས་པ་ཕུལ་ཏེ་སྟོང་ཕྲག་བརྒྱད་དུ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་རིག་པར་གྲུབ་པར་འགྱུར་རོ།",
    "ཆོ་ག་གཞན་ནི་ཆུ་བོའི་འགྲམ་དུ་ཆོ་གས་འབུམ་བཟླས་པར་བྱ་སྟེ་འགྲུབ་པར་འགྱུར་རོ།",
    "འདི་ནི་ཆོ་ག་གཞན་ཏེ་མར་གྱི་སྲེག་བླུགས་ཀྱིས་སྦྱིན་སྲེག་འབུམ་བྱ་སྟེ་འགྲུབ་པར་འགྱུར་རོ།",
    "མར་གྱིས་བཏགས་པའི་སྦྱིན་སྲེག་འབུམ་བྱ་སྟེ་འགྲུབ་པར་འགྱུར་རོ།",
    "འདི་ནི་ཆོ་ག་གཞན་ཏེ་ཐང་ཆུ་ཐམས་ཅད་ཀྱི་སྦྱིན་སྲེག་འབུམ་བྱ་སྟེ་འགྲུབ་པར་འགྱུར་རོ།",
    "ཡུངས་གར་དཀར་པོའི་སྦྱིན་སྲེག་རྒྱས་པར་འགྱུར་རོ།",
    "འཁོར་ལོས་བསྒྱུར་བ་ལ་ཡང་ལན་ཚྭ་སྲང་བཅོ་བརྒྱད་ཀྱིས་གཟུགས་བྱས་ནས་རྒྱལ་པོའི་མེ་ལ་དེའི་རྐང་པ་གཡོན་པ་ནས་བརྩམས་ནས་རལ་གྲི་རྣོན་པོས་གཏུབ་ཅིང་སྦྱིན་སྲེག་བྱའོ།",
    "ལན་ཚྭ་ཕན་ཚུན་བསྲེས་ཏེ་བཏགས་ནས་སྲང་བརྒྱད་ཀྱི་གཟུགས་བརྙན་བྱས་ནས་རྐང་པ་གཡས་པ་ནས་བརྩམས་ནས་རལ་གྲི་རྣོན་པོས་གཏུབ་ཅིང་གཏུབ་ཅིང་སྦྱིན་སྲེག་བྱའོ།",
    "དེ་ནས་གཟུགས་བརྙན་གཅིག་ནི་རྒྱལ་པོའི་འབངས་བཞིན་དུ་ཀུན་ཏུ་སྤྱོད་པར་བྱེད་དོ།",
    "རྒྱལ་པོ་གླང་པོ་བཞིན་དུ་བཀའ་བསྒོ་བ་བྱེད་པར་འགྱུར་རོ།",
    "དེ་ནས་མགོ་བོ་ནས་བརྩམས་ཏེ་སླར་ཡང་སྦྱིན་སྲེག་ཟླ་བ་གཅིག་ཏུ་ཉི་མ་སོ་སོར་བྱས་ན་རྒྱལ་པོ་ཅི་བགྱི་དང་མཚུངས་པར་འགྱུར་རོ།",
    "ཟླ་བ་གཅིག་ཙམ་ལ་རྒྱལ་པོ་འབངས་བཞིན་དུ་བཀའ་བསྒོ་བ་བྱེད་པར་འགྱུར་རོ།",
    "ཆོ་ག་གཞན་ནི་ས་ལ་མ་ལྷུང་བའི་བ་བྱུང་ཚྭ་དང་ཡང་དག་པར་བསྲེས་ནས་བཏགས་པར་བྱའོ།",
    "ལས་ལྷག་མ་འདི་ནི་དང་པོ་དང་མཚུངས་པར་དེའང་ཟླ་བ་ཙམ་ལ་རྒྱལ་པོ་བཀའ་བསྒོ་བ་རྗེས་སུ་སྒྲུབ་པར་བྱེད་པ་ཅི་བགྱིད་འགྱུར་རོ།",
    "དགུན་གྱི་དུས་ཚོད་ལའང་རབ་ཏུ་སྦྱར་ན་མཚུངས་པ་མེད་པའི་ནོར་ཆེན་པོ་འདི་རྣམས་རྟག་ཏུ་ངེས་པར་ཐོབ་བོ།",
    "མར་ལྷན་ཅིག་པ་ཀ་ར་བཱི་རའི་མེ་ཏོག་དང་གཅིག་ཏུ་བྱས་ཏེ་བཏགས་ནས་སྲང་སུམ་ཅུའི་ཚད་ཀྱི་གཟུགས་བརྙན་བྱས་ནས་ཉི་མ་སྔ་དྲོའམ།",
    "གུར་གུམ་བསྲེས་ཏེ་ལེགས་པར་བཏགས་ལ་སྲད་བུ་བཅུ་པ་བྱས་ནས་འདི་འདིའི་ལྷག་མ་སྔར་བཞིན་ནོ།",
    "ལན་ཚྭ་དང་གཟུགས་བརྙན་གཅིག་ཏུ་བྱས་པ་ལ་ནམ་མཁའི་ཆུས་བཏགས་ནས་སྲང་ཉི་ཤུ་རྩ་ལྔས་རྒྱལ་པོའི་གཟུགས་བརྙན་བྱས་ནས་གཡས་པ་ནས་བརྩམས་ཏེ་ལག་པ་གཡས་པས་རལ་གྲི་རྣོན་པོས་གཏུབ་ཅིང་གཏུབ་ཅིང་པ་ལཱ་ཤའི་མེ་ལ་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱད་བྱའོ།",
    "འགྱུར་བྱེད་རྣམས་གཅིག་ཏུ་བྱས་ཏེ་ནམ་མཁའི་ཆུས་བཏགས་ནས་སྲང་སུམ་ཅུ་པའི་རྒྱལ་པོའི་གཟུགས་བརྙན་བྱ་སྟེ།",
    "འདི་ནི་ངེས་པར་མངག་གཞུག་པ་བཞིན་དུ་ཀུན་ཏུ་སྤྱོད་དོ།",
    "ཡང་འདིར་གཞན་འབྱུང་སྟེ་དགུན་སྨད་ཀྱི་དུས་ཀྱི་སྒྲུབ་པ་ནི་གང་དུ་དུས་གཅིག་ཏུ་སྒྲུབ་པར་བྱེད་དེ།",
    "ཡུངས་ཀར་དཀར་པོ་གཅིག་ཏུ་བྱས་ཏེ་ཡང་དག་པར་བཏགས་པ་སྲང་སུམ་ཅུས་རྒྱལ་པོའི་གཟུགས་བརྙན་བྱས་ཏེ་མགོ་བོ་ནུབ་ཏུའོ།",
