    "ཆུ་ཀླུང་རྒྱས་པར་འཛགས་པར་བཟླས་ན་ཐང་དུ་འགྱུར་རོ།",
    "གཙང་མའི་དོན་དུ་བའི་མར་བླངས་ཏེ་ཟླ་བ་གཟས་བཟུང་བའམ།",
    "ཉི་མ་གཟས་བཟུང་བའི་དུས་སུ་ཟངས་ཀྱི་སྣོད་དུ་བཅུག་ནས་ཇི་སྲིད་དངོས་གྲུབ་རྣམ་གསུམ་དུ་གྱུར་པ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "འགྲོ་བཞིན་པ་ལ་ཐོས་པ་འཛིན་པར་འགྱུར་རོ།",
    "སྐྱེ་བ་དྲན་པར་འགྱུར་རོ།",
    "ཨརྒའི་མེ་ཏོག་འབུམ་གྱིས་སྤྱིན་སྲེག་བྱས་ན་དོང་ཚེ་འབུམ་སྦྱིན་པར་བྱེད་དོ།",
    "སྐུ་གཟུགས་ཀྱི་སྤྱན་སྔར་མེ་ཏོག་སྟོང་ཕྲག་བརྒྱད་དབུལ་བར་བྱ་སྟེ་དོང་ཚེ་བརྒྱད་རྙེད་དོ།",
    "འབྲས་ཐུག་པོ་ཆེ་ལ་མར་གྱིས་བཏགས་པའི་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱད་བྱས་ན་དོང་ཚེ་ལྔ་བརྒྱ་རྙེད་དོ།",
    "སྔོན་སྤྱད་པ་བྱས་པས་རས་རིས་ཀྱི་སྤྱན་སྔར་ཞོ་དང་།",
    "དོང་ཚེ་བརྒྱ་ལྷག་པར་རྙེད་དོ།",
    "སྐུ་གཟུགས་ཀྱི་སྤྱན་སྔར་ཟླ་བ་གཅིག་ཏུ་ཀུན་ཏུ་རུའི་བདུག་པའི་སྦྱིན་སྲེག་སྟོང་བྱའོ།",
    "ནས་ཟན་བཟའ་ཞིང་འབུམ་བཟླས་པར་བྱའོ།",
    "སྔོན་སྤྱད་པ་བྱས་པས་ནག་པོའི་བརྒྱད་པའམ།",
    "ནག་པོའི་བཅུ་གཅིག་བར་སྐྱེས་བུའི་རོ་མ་ཉམས་པ་བླངས་ནས་བཀྲུས་ཏེ་རྒྱན་གྱིས་བརྒྱན་པ་བག་མར་བླངས་པའི་གདོད་མའི་གཟུགས་ཀྱི་ཆ་བྱད་འཛིན་པ་བྱས་ནས་དྲི་དང་།",
    "ད་ལྟར་བྱུང་བ་སྟོན་པར་བྱེད་དོ།",
    "དེ་ནས་རྒྱལ་གྱི་ལྕགས་ལས་བྱུང་བའི་རལ་གྲིས་བསྣུན་པར་བྱའོ།",
    "དེ་ནས་མི་འདོད་དོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "དེ་ནས་ཡིད་བཞིན་གྱི་ནོར་བུ་སྐྱུག་པར་བྱེད་དོ།",
    "དེ་བླངས་ནས་ཡིད་བཞིན་གྱི་ནོར་བུའི་རིག་པ་འཛིན་པར་འགྱུར་ཏེ་ཡིད་ལྟར་མགྱོགས་པའི་བར་གྱི་བསྐལ་པའི་བར་དུ་གནས་སོ།",
    "མཱ་ཥའི་ཚད་ཀྱི་སྣ་མའི་མེ་ཏོག་འབུམ་རབ་ཏུ་འབབ་པར་བྱ་སྟེ་ཡུལ་གྲུ་བཅུ་རྙེད་དོ།",
    "སྔོན་སྤྱང་པ་བྱས་པ་དེ་ཉིད་ཆུ་ཀླུང་དུ་ཞུགས་ནས་སྣ་མའི་མེ་ཏོག་འབུམ་དབུལ་བར་བྱའོ།",
    "མར་གྱིས་བཏགས་པ་འབུམ་སྦྱིན་སྲེག་བྱས་ན་གང་ཅུང་ཟད་ཚོལ་བ་དེ་རྙེད་དོ།",
    "རས་རིས་ཀྱི་སྤྱན་སྔར་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "ཡུལ་གྱི་དཔོན་པོ་བྱེད་པར་འདོད་པས་དོང་ཀའི་མེ་ཏོག་ལ་ཞོ་དང་།",
    "མར་གྱིས་བཏགས་པའི་སྦྱིན་སྲེག་འབུམ་ཕྲག་གསུམ་བྱས་ཏེ་ཅོད་པན་གསུམ་བཅིངས་པར་འགྱུར་རོ།",
    "ཆོ་ག་འདི་ཉིད་ཁོ་ནས་ལྕགས་ལས་བྱུང་བའི་ཕྱེ་མའི་སྦྱིན་སྲེག་བྱ་སྟེ་ལོ་གསུམ་གྱིས་མཚོན་ཆ་བཅིངས་པར་འགྱུར་རོ།",
    "ཨ་ག་རུའི་ཡམ་ཤིང་ལ་མར་གྱིས་བཏགས་པ་འབུམ་སྦྱིན་སྲེག་བྱ་སྟེ་ཐོས་པ་འཛིན་པར་འགྱུར་རོ།",
    "མཆོག་ཏུ་ཡིད་གཞུངས་པར་འགྱུར་རོ།",
    "ཡིད་གཞུངས་པར་འགྱུར་རོ།",
    "དགྲ་ལ་བལྟས་ནས་བཟླས་པས་འཇིགས་པར་འགྱུར་རོ།",
    "ཅོད་པན་གསུམ་བཅིངས་པར་འགྱུར་རོ།",
    "གཏོར་མའི་ཆོ་ག་བྱས་ནས་མདུན་དུ་བཞག་སྟེ་ཇི་སྲིད་ཁ་ཊ་ཁ་ཊ་ཞེས་སྒྲ་སྒྲོགས་པ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "གཞན་རྣམས་གཡོག་པོ་རྣམས་ལ་སྦྱིན་པར་བྱའོ།",
    "མཆོག་སྒྲོགས་པར་བལྟ་བར་བྱའོ།",
    "གཟུགས་བརྙན་གྱི་མདུན་དུ་ཟངས་ཀྱི་སྣོད་དུ་མར་བཞག་ན་ཉི་ཟླ་གཟས་བཟུང་བའི་དུས་སུ་གཏོར་མའི་ཆོ་ག་བྱས་ནས་བཟླས་པར་བྱའོ།",
    "མར་ཡང་གྲུབ་པར་འགྱུར་རོ།",
    "འཐུངས་ཤིག་ཡིད་གཞུངས་པར་འགྱུར་རོ།",
    "དེ་ནས་གཟས་ཟིན་པའི་དུས་སུ་བསྒྲུབ་པར་བྱ་སྟེ་གྲུབ་པར་འགྱུར་རོ།",
    "མཆོང་པ་ལ་སོགས་པ་ནུས་པར་འགྱུར་རོ།",
    "པདྨའི་རྩ་བ་ཟ་བར་བྱེད་ཅིང་གཟུགས་བརྙན་གྱི་མདུན་དུ་ལྡོང་རོས་བླངས་ནས་ལག་པ་ཁ་སྦྱར་བཞག་ནས་ཇི་སྲིད་གཟའ་ལས་གྲོལ་བ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "དེས་ཐིག་ལེ་བྱས་པས་སྲོག་ཆགས་ཐམས་ཅད་དགའ་བར་འགྱུར་རོ།",
    "ཆོ་ག་འདི་ཉིད་ཀྱིས་མ་ཤ་གཅིག་ཁར་བཅུག་སྟེ་ཇི་སྲིད་མྱུ་གུ་བྱུང་བ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "ཕ་རོལ་འགུགས་པ་ལ་མྱུ་གུས་རྣམ་པར་སྟང་བར་བྱེད་དོ།",
    "ལྡོང་རོས་སྒྲུབ་པར་འདོད་པས་གཟུགས་བརྙན་གྱི་མདུན་དུ་ཨ་ཤྭཏྠའི་འདབ་མར་བཞག་ནས་འབུམ་ཡོངས་སུ་བཟླས་པར་བྱའོ།",
    "ཉི་ཟླ་གཟས་བཟུང་བ་ན་ཆོ་གས་བསྒྲུབ་པར་བྱ།",
    "གྲུབ་པ་ལ་ཐིག་ལེ་བྱས་ན་མི་སྣང་བར་འགྱུར་རོ།",
    "དེ་ནས་རིག་པ་དང་བཅས་པ་ཚིམ་པར་འགྱུར་རོ།",
    "ནས་ཟན་བཟའ་ཞིང་རིང་བསྲེལ་དང་བཅས་པའི་མཆོད་རྟེན་རས་རིས་བཞུགས་སུ་གསོལ་ནས་ལོ་གཅིག་བཟླས་སོ།",
    "ཟོས་ན་ཚེ་བསྐལ་པར་འགྱུར་རོ།",
    "དེ་ནས་དེ་ལ་བསྲུང་བ་བྱས་ནས་ཡང་དག་པའི་ཆོ་གས་བཏགས་པར་བྱའོ།",
    "རས་རིས་ཀྱི་སྤྱན་སྔར་ལག་པ་གཡོན་པ་ཁུ་ཚུར་བཅངས་ནས་འབུམ་ཟློས་ཤིག་དེ་ནས་གྲུབ་པར་འགྱུར་རོ།",
    "མཱ་ཥས་དེ་བཞིན་དུ་མཆོག་སྩོལ་པར་བྱེད་དོ།",
    "དོང་ཙེ་ཡང་དག་པར་རྙེད་དོ།",
    "ལན་ཚྭ་ལས་བྱུང་བའི་གཟུགས་བརྙན་བྱས་ནས་གཏུབ་ཅིང་གཏུབ་ཅིང་སྦྱིན་སྲེག་བྱའོ།",
    "ཆུར་རྐང་པ་གཅིག་བཅུག་ནས་དེ་བཞིན་དུ་ཐང་ལ་སྟེ་ཇི་སྲིད་དུ་ཆུར་གནས་པའི་རྐང་པ་ཡང་བར་གྱུར་པ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "ཟླ་བ་གཉིས་ཀྱིས་སྦྱོར་བས་ཐོས་པ་འཛིན་པར་འགྱུར་རོ།",
    "གཟུགས་བརྙན་གྱི་སྤྱན་སྔར་སྟོང་ཕྲག་བརྒྱད་བྱས་ནས་ཕྱིས་ཀློག་པར་བྱེད་དོ།",
    "དེ་བཞིན་དུ་ཉི་མ་སོ་སོ་ལ་མི་སྨྲ་བར་བཟླས་པར་བྱའོ།",
    "ཡིད་གཞུངས་པར་འགྱུར་རོ།",
    "འགགས་པར་ཡང་རུང་སྟེ་བཟླས་པ་ཙམ་ཉིད་ཀྱིས་གྲོལ་ལོ།",
    "ཉི་མ་བདུན་གྱིས་ཡིད་གཞུངས་པར་འགྱུར་རོ།",
    "སྔོན་གྱི་ཚིག་བླ་དྭགས་ཉམས་པར་བྱེད་དོ།",
    "ཡིད་གཞུངས་པར་འགྱུར་ཞིང་ལྔ་བརྒྱ་འཛིན་པར་བྱེད་པ་དང་།",
    "གུ་གུལ་གྱི་བདུག་པས་སྟོན་པར་བྱེད་དོ།",
    "ལན་བདུན་བཟླས་པའི་ཡལ་འདབ་ཀྱིས་གདོན་འཇོམས་པར་བྱེད་དོ།",
    "ཀུན་ཏུ་རུ་སྐའི་བདུག་པ་སྲེག་ཅིང་བཟླས་པར་བྱའོ།",
    "རྨུགས་པར་བྱེད་པ་དང་།",
    "རྨོངས་པར་བྱེད་པ་ལ་སོགས་པའི་ལས་རྣམས་ནུས་པར་འགྱུར་རོ།",
    "ལྡོང་རོས་ལ་སོགས་པས་སྒྲུབ་པ་རྣམས་ནུས་པར་འགྱུར་རོ།",
    "ལོག་པར་འདྲེན་པ་ཐམས་ཅད་ལས་གྲོལ་ལོ།",
    "འདིའི་ཁ་ནས་ལྕེ་ངེས་པར་འབྱུང་སྟེ་རལ་གྲི་རྣོན་པོས་བཅད་ནས་ཨུཏྤ་ལ་སྔོན་པོ་དང་མཚུངས་པའི་རལ་གྲིར་འགྱུར་རོ།",
    "ལྕགས་ལས་བྱུང་བའི་དཔྲལ་རིས་པུབ་པ་མཚན་ཉིད་དང་ལྡན་པ་བྱས་ནས་རས་རིས་ཀྱི་སྤྱན་སྔར་འབུམ་བཟླས་པར་བྱའོ།",
    "རས་རིས་ཀྱི་སྤྱན་སྔར་ཡུངས་ཀར་གྱི་ཕུང་པོ་བྱས་ནས་དེ་ལ་གོང་ནས་གོང་དུ་བཟླས་པ་དབུལ་བར་བྱའོ།",
    "མཚོན་ཆ་ཐམས་ཅད་གནོན་པར་འགྱུར་རོ།",
    "འགྱེད་པ་རྣམས་རྣམ་པར་གནོན་པར་འགྱུར་རོ།",
    "སྔགས་རྣམས་ལ་ཆུ་ལ་ལན་བདུན་བཟླས་པ་སྦྱིན་སྲེག་བྱ་སྟེ་དུག་མེད་པར་འགྱུར་རོ།",
    "ནོར་འདོད་པ་གཙང་མས་གོས་གཙང་མ་བགོས་ཏེ་ཉིན་མཚན་དུ་སྨྱུང་བར་གནས་པས་རས་རིས་ཀྱི་སྤྱན་སྔར་ཀུན་ཏུ་རུའི་བདུག་སྤོས་དབུལ་བར་བྱའོ།",
    "སྟོང་ཕྲག་བདུན་བཟླས་པས་དངུལ་སྦྱིན་པར་བྱེད་དོ།",
    "ལྟེང་ཀར་གཙང་མའི་ཕྱོགས་སུ་རས་རིས་བཞུགས་སུ་གསོལ་ནས་བཟླས་པ་དང་།",
    "སྦྱིན་སྲེག་བརྩམ་པར་བྱའོ།",
    "དེ་ནས་འདོད་པ་ཐམས་ཅད་ཐོབ་པར་འགྱུར་རོ།",
    "དུར་བྷ་ལ་མར་གྱིས་བཏགས་པ་འབུམ་བསྲེག་པར་བྱའོ།",
    "ཉི་མ་བདུན་གྱིས་རྒྱས་པར་འགྱུར་རོ།",
    "བྱད་སྟེམས་ཐམས་ཅད་མེད་པར་འགྱུར་རོ།"
  ]
