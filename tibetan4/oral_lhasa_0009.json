    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་མཐའ་ཡས་བ་ཅན་དུ་སྐྱེད་པ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་ཁྱིམ་གྱི་འབྱོར་བ་མཐའ་ཡས་པར་འགྱུར་རོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་རིག་པ་གྲུབ་པ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་ལྷའི་འགྲོ་བ་ཐོབ་པར་བྱེད་དོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་གྲུབ་པ་མྱུར་མ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་བ་ལང་ཡང་དག་པར་འབྱོར་པར་འགྱུར་རོ།",
    "བློན་པོ་གཉིས་སུ་མེད་པར་འགྱུར་རོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་བཟོད་པ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་རྒྱལ་པོའི་གནང་ཆེན་དུ་འགྱུར་རོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་བཟོད་པ་ངེས་པར་འབྱུང་མ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་ནོར་ཐམས་ཅད་འཛིན་པར་བྱེད་དོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་སྐྱབས་མྱུར་མ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་ཐམས་ཅད་དུ་ལེགས་པར་འོང་བར་བརྗོད་པ་སོ་སོར་རྙེད་དོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་བརྟན་པར་འགྲོ་མ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་ཚེར་འགྱུར་ཏེ་མཆོད་རྟེན་གྱི་ལས་ལ་སོགས་པས་ཚེ་འཕེལ་ལོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་བདུད་རྩི་ལེགས་པར་སྦྱར་བ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་འཆིང་བ་རྣམས་གྲོལ་བར་བྱེད་དོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་འདུས་བྱས་པ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་མཁའ་འགྲོ་མས་ཟིན་པ་རྣམས་ལ་བལྟས་པས་གྲོལ་བར་བྱེད་དོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་ངེས་པར་ཤེས་པ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་ཡུལ་གྱི་བདག་པོར་འགྱུར་རོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་འཆི་བ་འཇོམས་པ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་རྫུ་འཕྲུལ་འགྲུབ་པར་འགྱུར་རོ།",
    "འཆི་བའི་དུས་མངོན་སུམ་དུ་ཤེས་པར་བྱེད་དོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་བདེ་བ་བསམ་གྱིས་མི་ཁྱབ་པ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་རང་འཆི་བར་ཤེས་པར་བྱེད་དོ།",
    "ནོར་ཡང་ཐོབ་པར་བྱེད་དོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་འཆི་མེད་མ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་ཕྱིར་ལྡོག་པར་མི་འགྱུར་རོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་འཇིགས་པ་ལས་གྲོལ་བ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་སྐྱེ་བ་དྲན་པར་འགྱུར་རོ།",
    "འདི་ནི་འཕགས་མ་སྒྲོལ་མ་གཡུལ་ལས་བརྒལ་བ་ཞེས་བྱ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་གཡུལ་དུ་གཞན་གྱིས་མི་ཐུབ་པར་འགྱུར་རོ།",
    "འདི་ནི་རྩ་བའི་རིག་པ་སྟེ་རྟག་ཏུ་བཟླས་པས་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་དོ།",
    "དེ་ནི་འདིའི་སྒྲུབ་ཐབས་ཀྱི་ཆོ་གའི་རིག་པར་འགྱུར་རོ།",
    "འཕགས་མ་སྒྲོལ་མས་བསྟན་པ་རྣམས་ལ་རྟག་ཏུ་བཟླས་པའི་སྦྱོར་བས་ཡུལ་སྦྱིན་པར་བྱེད་དོ།",
    "འཕགས་མ་སྒྲོལ་མ་རྣམ་པར་རྟོག་པ་མེད་པ་ཞེས་བྱ་བའོ།",
    "འཕགས་མ་སྒྲོལ་མ་རང་ཐམས་ཅད་ངེས་པར་འབྱུང་མ་ཞེས་བྱ་བའོ།",
    "དོན་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་པ།",
    "ཉེ་བར་འཚེ་བ་ཐམས་ཅད་ལས་ཕྲན་ཚེགས་ཐམས་ཅད་ཇི་ལྟར་ཇི་ལྟར་རབ་ཏུ་སྦྱར་བ་དེ་ལྟ་དེ་ལྟར་སྒྲུབ་པར་བྱེད་དོ།",
    "འདི་རྣམས་ཀྱི་ཆོ་ག་ཕྱོགས་ཙམ་སྟོན་པར་འགྱུར་ཏེ་དཀར་པོའི་ཕྱོགས་ཀྱི་ཚེས་གཅིག་ནས་བརྩམས་ཏེ་གསོ་སྦྱོང་ལ་གནས་པའམ།",
    "གཞན་གྱི་ཚད་དད་མར་བསྲེས་ནས་སྦྱིན་པར་བྱའོ།",
    "དེ་ནས་རྒྱུད་མཚུངས་པའི་བ་སེར་སྐྱའི་འོ་མ་ལ་གཞོན་ནུ་མས་བསྲུབས་པའི་མར་དུ་བྱས་ནས་མར་དེ་ལ་གདབ་པར་བྱའོ།",
    "འབར་བར་གྱུར་པ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "ནམ་མཁའ་ལ་ཉེ་བར་འཁྲིད་པར་བྱེད་དོ།",
    "དབུར་ནམ་མཁའི་ཆུས་བཏགས་ནས་པདྨར་བཅུག་སྟེ་དེ་ནས་དཀར་པོའི་བརྒྱད་པ་ལ་གསོ་སྦྱོང་ཅན་དུས་གསུམ་དུ་ཁྲུས་བྱས་ནས་གོས་གཙང་མ་བགོས་ཏེ་རིང་བསྲེལ་དང་བཅས་པའི་མཆོད་རྟེན་ནམ།",
    "དེ་ནས་བླངས་པ་དེས་རིག་པ་འཛིན་པར་འགྱུར་ཏེ་ལོ་སྟོང་ཕྲག་བཅུར་འཚོ་བར་བྱེད་དོ།",
    "དེ་ནས་གྲུབ་པར་འགྱུར་རོ།",
    "སྐྱེས་བུའི་ཤ་ནི་སྐྲོད་པར་བྱེད་པ་ལས་སོ།",
    "སྐྲོད་པར་བྱེད་པ་ལ་སྦྲུལ་གྱི་ཤུན་ལྤགས་དང་།",
    "སྐྱེས་བུ་མ་ཡིན་པར་བྱེད་པ་ལ་གོ་མ་ཨིནྡྲ་འོ།",
    "མ་གྲུབ་པ་སྒྲུབ་པར་བྱེད་དོ།",
    "གཞན་གྱི་བསྒྲུབས་པ་རྣམ་པར་འཇིག་པར་བྱེད་པ་ལ་མ་ནུ་ལ་འཆིང་བ་འཛིན་པར་བྱེད་དོ།",
    "ཁྱིམ་རབ་ཏུ་གཡོ་པར་འདོད་པས་མིའི་རུས་པ་བླངས་ནས་སོར་བརྒྱད་པའི་ཚད་ཀྱི་ཕུར་བུ་བྱས་ནས་ཁྱིམ་དུ་གདབ་པར་བྱའོ།",
    "གཡུལ་དུ་རྣམ་པར་རྒྱལ་བར་བྱེད་པ་ལ་རྒྱལ་མཚན་ལ་སྟོང་ཕྲག་བརྒྱད་ཡོངས་སུ་བཟླས་ནས་དྲི་དང་།",
    "པདྨ་རྩ་བ་ནག་པོ་མེད་པའི་བུམ་པར་བཅུག་ནས་སྟོང་བཟླས་པར་བྱའོ།",
    "བིལ་བའི་དབུས་སུ་སྦྲང་རྩི་དང་ཡང་དག་པར་ལྡན་པ་རྣམས་ཀྱིས་དུ་བ་དང་།",
    "སྐུ་གཟུགས་སམ།",
    "མར་གྱིས་བཏགས་པའི་པདྨ་ཁ་རྒྱས་པར་བྱེ་བའི་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱད་བྱ།",
    "ནས་ཟན་ཟ་པས་པདྨ་དཀར་པོ་ཁ་རྣམ་པར་རྒྱལ་བའི་སྦྱིན་སྲེག་བྱས་ན་གཏེར་ཆེན་པོ་འམ།",
    "དེ་བཞིན་དུ་སྟོང་ཕྲག་བདུན་བརྒྱས་མཚམས་མེད་པ་བྱས་པས་ཀྱང་འགྲུབ་པར་འགྱུར་རོ།",
    "མར་གྱིས་བཏགས་པའི་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱ་བྱས་ན་གསེར་བྱེ་བ་འབྱུང་ངོ།",
    "སྔ་བར་ལངས་ནས་ཁྲུས་སྔོན་དུ་འགྲོ་བས་ཚངས་པར་སྤྱོད་ཅིང་མེ་རབ་ཏུ་སྦར་ནས་ནཱ་ག་གེ་སར་དང་།",
    "པྲི་ཡང་ཀུའི་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱད་བྱ་སྟེ་ཟླ་བ་གསུམ་གྱི་ནང་དུ་ཁྱད་པར་དུ་འཕགས་པའི་དངོས་གྲུབ་ཉམས་སུ་མྱོང་བར་འགྱུར་ཞིང་རྫས་མང་པོ་ཡང་ངོ།",
    "གཙང་མར་གྱུར་པས་ཟས་བཞིར་སྨྱུང་བར་གནས་ཏེ་སྟོང་ཕྲག་བཅུར་སྦྱིན་སྲེག་བྱའོ།",
    "རས་རིས་ཀྱི་སྤྱན་སྔར་སྦྱིན་སྲེག་སྟོང་བྱས་ན་གཏེར་མཐོང་ངོ།",
    "ནས་ཟན་ཟ་བས་ཕྱོགས་གཙང་མར་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱ་བྱས་ན་གསེར་བརྒྱ་རྙེད་དོ།",
    "གང་ཡིད་ལ་སེམས་པར་བྱེད་པ་དེ་སྟེར་བར་བྱེད་དེ།",
    "བླ་གོས་དཀར་པོ་མནབས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "པདྨ་ཁ་བྱེ་བ་ཕྱག་ན་བསྣམས་པ་འབྱོན་པར་འགྱུར་རོ།",
    "ནས་ཟན་ཟ་བས་བསྒྲུབ་པར་བྱའོ།",
    "བདུག་པ་ལ་ལན་སྟོང་ཕྲག་བརྒྱ་བཟླས་ནས་གཙང་མས་གོས་གཙང་མ་གོན་ཏེ་འོ་མ་དང་།",
    "ནས་ཟན་ཟ་ཞིང་རྟག་ཏུ་བཟླས་པས་འདོད་ཅིང་འདོད་པ་རྣམས་ཀུན་ཏུ་ཐོབ་སྟེ་འདོད་པ་ཐམས་ཅད་སྦྱིན་པར་བྱེད་དོ།",
    "འོ་མ་འཐུངས་པས་སྟོང་ཕྲག་བརྒྱར་བཟླས་པར་བྱའོ།",
    "མར་གྱིས་བཏགས་པའི་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱད་བྱས་པས་དེ་བཞིན་དུ་འདིའི་ནོར་ཐམས་ཅད་རྙེད་པར་འགྱུར་རོ།",
    "ཏུ་རུ་ཀ་འབུམ་ཕྲག་གཅིག་སྦྱིན་སྲེག་བྱ་སྟེ་དེ་བཞིན་དུའང་འགྲུབ་པར་འགྱུར་རོ།",
    "ཞོགས་མ་དང་བསྲེས་པའི་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱད་བྱ་སྟེ་གྲུབ་པར་འགྱུར་རོ།",
    "མར་གྱིས་བཏགས་པའི་སྦྱིན་སྲེག་འབུམ་བྱས་ཏེ་གྲུབ་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་འགྲུབ་པར་འགྱུར་རོ།",
    "ནས་ཟན་ཟ་ཞིང་གོས་གཙང་མ་བགོས་ཏེ་གང་བླངས་པ་དེ་སྟེར་བར་བྱེད་དོ།",
    "བླངས་པ་དེས་རིག་པ་འཛིན་པར་འགྱུར་ཏེ་ལྷ་ཐམས་ཅད་ཐོགས་པ་མེད་པ་དང་།",
    "ནས་ཟན་ཟ་བས་སྔོན་དུ་སྟོང་ཕྲག་བརྒྱ་བཟླས་པར་བྱའོ།",
    "ཉེ་བར་སྤྱོད་པ་ལ་སོགས་པ་ཅན་ཏེ་དེས་ཐིག་ལེ་བྱས་ནས་རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པའི་ལུས་འདོད་པའི་གཟུགས་ཅན་གྱི་རིག་པ་འཛིན་པར་འགྱུར་ཏེ་ལོ་སྟོང་དུ་འཚོ་བར་བྱེད་དོ།",
    "སྐད་ཅིག་ལ་བཅུག་པ་ཙམ་གྱིས་རྣམ་པར་ཞིག་པར་འགྱུར་རོ།",
    "རྟོག་པ་གཞན་ལས་གསུངས་པའི་ཆོ་གས་ཀྱང་རུང་སྟེ་རིག་པ་འདི་རྣམས་ཀྱི་མིང་གསུམ་གསུམ་བརྗོད་པའི་རས་རིས་ཀྱི་ཆོ་ག་དེ་འམ།",
    "རིང་བསྲེལ་དང་བཅས་པའི་མཆོད་རྟེན་གྱི་དྲུང་དུ་ཕྱོགས་གཙང་མར་འོ་མ་དང་།",
    "མར་གྱི་བཟའ་བས་ཀྱང་རུང་སྟེ་ཡང་ན་མི་སྨྲ་བའི་བརྟུལ་ཞུགས་སྤྱད་པར་བྱའོ།",
    "དེ་ནས་གྲུབ་པར་འགྱུར་ཏེ་བཅོ་ལྔ་ལ་ཕྱོགས་བཞིར་ས་ལས་བྱུང་བའི་བུམ་པ་བཞི་ཆུ་དང་བཅས་པ།",
    "ནག་པོ་མེད་པ་གཞག་པར་བྱའོ།",
    "རྣམ་པར་རྒྱལ་བཞེས་བྱ་བའི་བུམ་པ་དབུས་སུ་བཞག་པར་བྱའོ།",
    "དེ་ལྟ་བུ་ལ་སོགས་པ་བུམ་པ་རྣམས་ཀྱི་མིང་སྨོས་ཏེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བཞིན་གཞུག་པར་བྱའོ།",
    "འོ་མས་བཀང་བའི་ཁམ་ཕོར་ཉི་ཤུ་ཕྱོགས་བཞིར་བཞག་པར་བྱའོ།",
    "ཇི་ལྟར་མཚུངས་པའི་ཁམ་ཕོར་རྣམས་ཕྱོགས་བཞིར་བཞག་པར་བྱའོ།",
    "ཤྲི་བཱ་ས་ཅན་གྱི་བདུག་པའི་ཁམ་ཕོར་ཕྱོགས་བཞིར་བཞག་པར་བྱའོ།",
    "དེ་ནས་སྲོད་ལ་ལས་བརྩམས་པར་བྱས་ཏེ་ཉིན་མཚན་དུ་སྨྱུང་བར་གནས་པས་ཨརྒའི་ཡམ་ཤིང་ངམ།",
    "ས་ལས་བྱུང་བར་མཆོད་ཡོན་ཕུལ་ནས་དེ་ནས་ཨ་ག་རུ་ནག་པོའི་ཡམ་ཤིང་ཇི་སྐད་གསུངས་པའི་ཚད་གཞན་གསུངས་པ་ལ་ཏིལ་མར་གྱིས་བཏགས་པ་རྣམས་ཟླ་བ་གཟས་བཟུང་བའམ།",
    "རལ་པའི་ཅོད་པན་འཕྱང་བ་འབྱོན་པར་འགྱུར་རོ།",
    "དེ་ནས་ཇི་སྐད་གསུངས་པའི་སྣོད་དུ་དྲི་ཞིམ་པོའི་མེ་ཏོག་དཀར་པོ་རྣམས་སྙིམ་པས་བླངས་ནས་ཆུའི་མཆོད་ཡོན་དབུལ་བར་བྱའོ།",
    "གང་བླངས་པའི་མཆོག་དེ་སྦྱིན་པར་མཛད་དོ།",
    "ཚེ་བསྐལ་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་མ་འཕགས་མ་སྒྲོལ་མའི་སྒྲུབ་པོས་ཀུ་ཤའི་ཁྲེས་ཡོད་པས་ཨུ་དུམ་བཱ་རའི་ཆོ་ག་ཤེས་པར་བྱ་སྟེ།",
    "འཇིགས་པ་ཐམས་ཅད་འཇོམས་པར་བྱེད་དོ།",
    "འབུམ་ཕྲག་ཉི་ཤུ་རྩ་གཅིག་ཏུ་ཟློས་པར་བྱེད་པ་ནི་ནམ་མཁའ་ལ་འགྲོ་བར་བྱེད་པའོ།",
    "དེ་མཐོང་ན་གང་བརྩམས་པ་དེ་འགྲུབ་པར་བྱེད་དོ།",
    "འབུམ་ཕྲག་བདུན་བདུན་བཟླས་པར་བྱ་སྟེ་མི་སྣང་བར་འགྱུར་རོ།",
    "འབུམ་ཕྲག་བཅུ་གཉིས་བཟླས་པར་བྱ་སྟེ་བཅུད་ལེན་དང་།",
    "སྐྲ་དཀར་སྤངས་པར་འགྱུར་རོ།",
    "ལྕགས་བསྲེགས་ནས་ལན་གསུམ་བཟླས་པའི་ཏིལ་མར་གྱིས་རྐང་བ་གཡས་པ་ལ་བསྐུས་ནས་ལྕགས་དེས་རྐང་པ་ལ་གདུང་པར་བྱ་ཞིང་གྲི་དྷ་ཤཱི་ཆོད་ཅིག་ཅེས་བརྗོད་པར་བྱའོ།",
