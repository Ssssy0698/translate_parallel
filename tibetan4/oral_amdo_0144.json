    "གང་གིས་སྟོང་པ་ཉིད་དེ་ཡང་མི་འདོད་པ་འདི་ལྟ་བུ་འདི་ནི་སྟོང་པ་ཉིད་ལོག་པར་ཟིན་པ་ཞེས་བྱའོ།",
    "གང་གིས་སྟོང་པ་དེ་ནི་མེད་པ་ཡིན་ལ།",
    "གང་གིས་སྟོང་པར་འགྱུར་ཏེ།",
    "དེ་སྐད་ཅེས་དྲིས་པ་ན་གལ་ཏེ་འདི་སྐད་ཅེས་ཕྱིན་ཅི་ལོག་གི་དངོས་པོ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་ལན་འདེབས་པར་འགྱུར་ན་དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་མེད་ན་ནི་དེས་ན་ཕྱིན་ཅི་ལོག་གི་དངོས་པོ་ཡིན་པའི་ཕྱིར།",
    "སྟོང་པ་ཉིད་ལ་ལོག་པར་བཟུང་བའི་བདག་གིས་ཡང་དག་པ་མ་ཡིན་པས་ལོག་པར་ལྟ་བ་བསྐྱེད་ནས་ཉེས་པར་སྤྱོད་པ་བྱས་པ་རྣམས་ཀྱི་སྟོང་པ་ཉིད་དང་།",
    "ཚིག་གིས་དཔག་པར་མི་ནུས་ཏེ།",
    "རྣམ་པར་རྟོག་པའི་སྤྲོས་པ་དག་གིས་འཐོབ་པར་མི་ནུས་པས་སོ།",
    "དེ་དག་གི་ལྟར་ན་འདོགས་པའི་གཞིའི་དངོས་པོ་ཤེཙམ་ཡང་མེད་པས་འདོགས་པ་དེ་ཉིད་ཀྱང་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་མེད་པར་འགྱུར་ན་བརྟགས་པ་ཙམ་གྱི་ཁོ་ན་ལྟ་ཡོད་པར་ག་ལ་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་རྣམ་གྲངས་དེས་ན་དེ་དག་གིས་དེ་ཁོ་ན་དང་།",
    "གཞན་ཡང་ཤེས་རབ་ཞན་པ་དག་གི་མདུན་དུ་སྟོང་པ་ཉིད་དང་།",
    "བདག་གིར་ལྟ་བ་དེ་ཡང་བདག་ཏུ་འཛིན་པ་དང་བཅས་པ་དང་།",
    "དེའི་ཕྱིར་བདག་ཏུ་འཛིན་པ་ཞེས་བྱ་བའི་ཚིག་གིས་ལྟ་བ་དེ་ཡང་བསྡུས་སོ།",
    "བདག་ཏུ་འཛིན་པ་ཡང་དག་པའི་རིགས་པ་དང་རྗེས་སུ་མཐུན་པ་མ་ཡིན་མོད་ཀྱི།",
    "སྟོང་པ་ཉིད་དང་བདག་མེད་པར་ལྟ་བ་ནི་ཡང་དག་པའི་རིགས་པ་དང་རྗེས་སུ་མཐུན་པ་ཡིན་མོད་ཀྱི།",
    "འོན་ཀྱང་དེ་དག་གིས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཁོང་དུ་མི་ཆུད་དེ།",
    "བདག་མེད་པའི་དོན་ནི་གཡང་སའི་འགྲོ་བ་དང་ཉེ་བར་གྱུར་པས་འཕགས་པ་དག་གིས་ཉུབསྟན་པའི་མི་རིགས་སོ་ཞེ་ན།",
    "ཐབས་ཀྱིས་མོས་པ་ཟློག་པར་བྱེད་ཀྱང་།",
    "སློབ་དཔོན་རྟ་སྐད་ཀྱིས་མོས་པ་བསྐྱེད་པའི་བསྟན་བཅོས་མཛད་པ་ལས་ཀྱང་།",
    "གཉིས་པ་ནི་འཕགས་པ་བྱམས་པའི་གཞུང་གིས་བསྟན་པ་སྟེ།",
    "དོན་མ་ཡིན་པ་ལ་དོན་དུ་ཐོས་ནས་དེ་དག་གི་ལྟ་བའི་རྗེས་སུ་འབྲང་བར་བྱེད་ན།",
    "དེ་དག་གི་ལྟ་བའི་རྗེས་སུ་འབྲང་བར་མི་བྱེད་ཅིང་།",
    "རང་བཞིན་ཀྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པའོ་ཞེས་ཐོས་ན་སྐྲག་ཅིང་དངང་ལ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་དེ་དག་གི་ལྟ་བའི་རྗེས་སུ་འབྲང་བར་མི་བྱེད་ཅིང་།",
    "སེམས་ཤིན་ཏུ་དམན་པར་གྱུར་ནས་ཤིན་ཏུ་རྒྱས་པ་ཟབ་པ་དག་ལ་མོས་པར་མི་འགྱུར་བ་དེའི་ཕྱིར་སྐྲག་པར་འགྱུར་བ་ཡིན།",
    "དེ་ལ་མོས་པར་མི་འགྱུར་བས་དེའི་ཕྱིར་ཡང་སྐྲག་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ཕྲག་དོག་གིས་བདག་ལ་བསྟོད་ཅིང་གཞན་ལ་སྨོད་པ་སྟེ།",
    "ལས་ཀྱི་སྒྲིབ་པ་ཆེན་པོས་ཀྱང་རེག་པར་འགྱུར་བའོ།་།",
    "དྲང་པོ་མ་ཡིན་ཞིང་དྲང་པོའི་རང་བཞིན་ཅན་མ་ཡིན་པ་དག་ནི་རྟོག་པ་སེལ་ནུས་པའི་མཐུ་དང་ལྡན་ཡང་རང་གི་ལྟ་བ་མཆོག་ཏུ་འཛིན་པ་ལ་གནས་པས་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་བཞི་པ་དངོས་པོ་ལྔ་ཡང་གཏན་མེད་ལ།",
    "ལུས་ལ་མེད་པའི་གྲངས་གཅིག་གིས་མགོ་བཙུགས་ཏེ།",
    "ཁྲི་ཕྲག་བཅུ་ལ་འབུམ་མོ།",
    "དུང་ཕྱུར་ཕྲག་བཅུ་ལ་ཐེར་འབུམ་མོ།",
    "ཕྱི་ཡང་གང་གིས་མཚན་ཉིད་གདགས་པར་སླའི།",
    "ཚིགས་སུ་བཅད་པ་མོས་ནས་ཡང་དག་པར་སྟོན་པར་མཛད་པ་སྟེ།",
    "ཚིགས་སུ་བཅད་པ་འོག་མ་གཅིག་གིས་ནི་ངོ་བོ་ཉིད་མེད་པ་རྣམ་པ་གསུམ་ལས་བརྩམས་ནས་དགོངས་པ་ཡང་དག་པར་བསྟན་པ་ཡིན་ཏེ།",
    "རིགས་ངེས་པའི་གང་ཟག་དེ་དག་གིས་ཐོབ་པར་འགྱུར་བ་ནི་ཤིན་ཏུ་དཀོན་རྗོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཐམས་ཅད་དོན་འགྲུབ་ཉོན་མོངས་སྦུག་བསྔལ་སྤོང་།",
    "དེ་བཞིན་ཉིད་ལ་བརྟེན་ཏེ་ཉོན་མོངས་པ་སྤངས་ནས།",
    "ཉོན་མོངས་པ་དང་།",
    "སྡུག་བསྔལ་ཀྱི་རྟེན་དུ་གྱུར་པའི་ལུས་སྒོང་བ་དག་མི་མཚུངས་པས་ལྷག་མ་དང་བཅས་པ་ནི་ཉོན་མོངས་པ་ཉི་ཚེ་སྤང་བ་ཡིན་ནོ།",
    "འདི་ལྟར་ཉོན་མོངས་པ་དང་བྲལ་བའི་ཕྱིར་ནི་བརྟན་པ་ཞེས་གསུངས་ལ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་དང་།",
    "འདི་ལྟར་བདག་གིས་ཞེས་རྔུ་བྱ་བ་མན་ཆད་ཀྱིས་བདག་ཉིད་ཀྱིས་ཁོང་དུ་ཆུད་པར་གྱུར་པར་བསྟན་པ་དང་།",
    "འདི་ལྟར་བདག་གིས་དེང་འདིར་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྤྲུལ་པའི་དོན་འཚལ་བ་ལྟར་ན་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་བདག་ཉིད་ཀྱིས་ཁོང་དུ་ཆུད་པར་གྱུར་པ་སྟོན་ཏོ།",
    "བྱེ་བྲག་གི་མཚན་ཉིད་དུ་མིང་དང་བརྡར་རྣམ་པར་གཞག་པ་དང་།",
    "ཁ་ཅིག་ན་རེ་འདུ་བྱེད་ནི་ལྟ་བའི་རྣམ་པ་སྟེ།",
    "ཁ་ཅིག་ན་རེ་འདུ་བྱེད་ཀྱི་མཚན་མ་ཞེས་བྱ་བ་ནི་འདུས་བྱས་ཀྱི་རྣམ་པ་སྟེ།",
    "གཟུགས་ཀྱི་ཕུང་པོའི་སྟིངོ་བོ་ཉིད་དང་བྱེ་བྲག་གི་མཚན་ཉིད་དུ་མིང་དང་བརྡར་རྣམ་པར་གཞག་པ་ཞེས་བྱ་བ་ནི་མཚན་ཉིད་ཀྱི་བདག་ཉིད་སྤྱིར་བསྟན་པ་ལ་ངོ་བོ་ཉིད་ཅེས་བྱ་སྟེ།",
    "རང་གི་ངོ་བོ་ཉིད་དེ་ཉིད་ལ་ཟག་པ་དང་བཅས་པ་དང་ཟག་པ་མེད་པ་དང་།་",
    "ཐང་ཅིག་ཙམ་དུ་གནས་པ་ལ་སོགས་པ་ནི་བྱེ་བྲག་གི་མཚན་ཉིད་ཅེས་བྱའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་གཟུགས་ཀྱི་ཕུང་པོ་གང་ཡིན་པ་དེ་ནི་གཏན་དུ་སྤང་བར་བྱའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་མ་ཡིན་པའི་གཟུགས་ཀྱི་ཕུང་པོ་གང་ཡིན་པ་དེ་ནི་ཡོངས་སུ་ཤེས་པར་བྱ་བའོ།",
    "ཡོངས་སུ་ཤེས་པ་དེ་ཡང་གཏན་དུ་སྤང་བ་སྤྱིར་བསྟན་པ་གང་ཡིན་པ་དེ་ནི་གཏན་དུ་སྤང་བའི་རང་གི་ངོ་བོ་ཉིད་ཅེས་བྱའོ།",
    "གཟུགས་ཀྱི་རང་གི་ངོ་བོ་ཉིད་སྤྱིར་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་ཡོངས་སུ་ཤེས་པའི་རང་གི་ངོ་བོ་ཉིད་ཅེས་བྱའོ།",
    "ངོ་བོ་ཉིད་ཀྱི་མཚན་ཉིད་དང་བྱེ་བྲག་གི་མཚན་ཉིད་དོ།",
    "སྨྲས་པ་གཏན་དུ་སྤང་བ་ནི་ཀུན་འབྱུང་གི་བདེན་པ་ཡིན།",
    "འདི་ལྟར་བདག་གིས་དེང་འདིར་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་པ་བའི་དོན་འཚལ་བ་ལྟར་ན་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་ངོ་བོ་ཉིད་གསུམ་པ་ཁོང་དུ་ཆུད་པར་གྱུར་པ་བསྟན་པའོ།",
    "འདི་ལྟར་བདག་གིས་དེང་འདིར་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་བའི་དོན་འཚལ་བ་ལྟར་ན་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་གཉིས་པ་བདེན་པ་ལ་སོགས་པའི་སྒོ་གཉིས་པོ་དག་ཐུགས་སུ་ཆུད་པར་གྱུར་ནས་ངོ་བོ་ཉིད་མེད་པ་རྣམ་པ་གསུམ་གསུངས་པར་བསྟན་པའོ།",
    "དངོས་པོ་དེ་དག་ལ་ཡང་རང་གི་ངོ་བོ་ཉིད་དང་།",
    "བྱེ་བྲག་གི་མཚན་ཉིད་ཡོད་པས་རབ་ཏུ་གནོད་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ནི་སྡུག་བསྔལ་གྱི་བདེན་པའི་རང་གི་ངོ་བོ་ཉིད་ཀྱི་མཚན་ཉིད་ཅེས་བྱའོ།",
    "སྡུག་བསྔལ་གསུམ་དང་བརྒྱད་ལ་སོགས་པ་ནི་སྡུག་བསྔལ་གྱི་བདེན་པའི་བྱེ་བྲག་གི་མཚན་ཉིད་ཅེས་བྱའོ།",
    "སྙུག་བསྔལ་གྱི་བདེན་པའི་རང་གི་མཚན་ཉིད་གང་ཡིན་པ་དེ་ནི་ཡོངས་སུ་ཤེས་པའི་བྱེ་བྲག་གི་མཚན་ཉིད་ཅེས་བྱའོ།",
    "འདི་ལྟར་བདག་གིས་དེང་འདིར་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་བ་ལྟར་ན་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་གཉིས་པ་ཡོངས་སུ་གྲུབ་པ་ཉིད་ལ་བརྟེན་ནས་དོན་དམ་པ་ངོ་བོ་ཉིད་ལས་ཕྱོགས་གཅིག་རྣམ་པར་གཞག་པ་བསྟན་པའོ།",
    "ངོ་བོ་ཉིད་རྣམ་པ་གསུམ་པོ་དེ་དག་ལ་བརྟེན་ནས་ངོ་བོ་ཉིད་མེད་པ་རྣམ་པ་གསུམ་རྣམ་པར་གཞག་པ་ཡིན་པས་དེའི་ཕྱིར་སྡུག་བསྔལ་ཀྱི་བདེན་པ་ལ་ཇི་ལྟ་བ་བཞིན་དུ་བདེན་པ་ལྷག་མ་རེ་རེ་ལ་ཡང་ངོ་བོ་ཉིད་རྣམ་པ་གསུམ་དང་ལྡན་པར་སྦྱར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཀུན་འབྱུང་གི་བདེན་པ་ལས་བརྩམས་ནས་ནི་གཏན་དུ་སྤང་བ་ཞེས་བསྟན་ཏོ།",
    "འདི་ལྟར་བདག་གིས་དེང་འདིར་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་སྤུའཕགས་པའི་ལམ་གྱི་ཡན་ལག་བརྒྱད་པ་ཡང་དག་པའི་ཏིང་ངེ་འཛིན་ལ་བརྟེན་ཧྥུནས་ཁོང་དུ་ཆུད་པར་གྱུར་པ་བསྟན་པའོ།",
    "འདི་ལྟར་བདག་གིས་དེང་འདིར་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་བའི་དོན་བསྟན་པ་ལྟར་ན་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་འཕགས་པའི་ལམ་གྱི་ཡན་ལག་བརྒྱད་པ་ཡང་དག་པའི་ཏིང་ངེ་འཛིན་ལ་བརྟེན་ནས་ཁོང་དུ་ཆུད་པར་བསྟན་པ་སྟོན་ཏོ།",
    "དང་པོ་ནི་ཡང་དག་པའི་ཏིང་ངེ་འཛིན་གྱི་རང་གི་ངོ་བོ་དང་བྱེ་བྲག་རྣམ་པར་གཞག་པ་འདི་ལྟ་སྟེ།",
    "རང་གི་ངོ་བོ་ཉིད་དང་བྱེ་བྲག་གི་མཚན་ཉིད་ནི་གོང་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "གོང་དུ་བསྟན་པའི་སྒོ་ལྔ་པོ་དེ་དག་རེ་རེ་ལ་ཡང་རང་གི་ངོ་བོ་ཉིད་དང་བྱེ་བྲག་གི་མཚན་ཉིད་ཡོད་པས་བརྟགས་ན་ཤེས་པར་འགྱུར་ཏེ།",
    "འདི་ལྟར་བདག་གིས་དེང་འདིར་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པའི་དོན་འཚལ་བ་ལྟར་ན་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་གཉིས་པ་ཡོངས་སུ་གྲུབ་པ་ལས་བརྩམས་ནས་དོན་དམ་པ་ངོ་བོ་ཉིད་མེད་པ་ཉིད་ཞུལས་ཕྱོགས་གཅིག་བསྟན་པའོ།",
    "བཅོམ་ལྡན་འདས་དཔེར་བགྱི་ན་རི་མོ་བྲི་བའི་གཞི་ནི་སྔོན་པོའམ།",
    "དམར་པོའམ་དཀར་པོའམ་རི་མོར་བགྱི་བ་ཐམས་ཅད་དུ་ཁྱབ་པས་རོ་གཅིག་པ་ལགས་ཤིང་།",
    "རི་མོར་བྲིས་པ་དེ་ཡང་ཤིན་ཏུ་གསལ་བར་བགྱིད་པ་ལགས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་རི་མོའི་གཞི་དཔེས་བསྟན་པའོ།",
    "དཔེར་ན་རི་མོ་སྔོན་པོ་དང་།",
    "ཞི་ནི་རི་མོ་རྣམ་པ་སྣ་ཚོགས་ཀྱི་བྱ་བ་ཐམས་ཅད་ཀུན་དུ་ཁྱབ་ཅིང་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པ་དང་མཚུངས་པ་ཉིད་དུ་རོ་གཅིག་པར་བྱེད་ལ།",
    "རི་མོ་བྲི་བ་དེ་དག་ཐམས་ཅད་ཀྱང་ཤིན་ཏུ་གསལ་བར་བྱེད་པས་སོ།",
    "དོན་ཟབ་མོ་ཁོང་དུ་ཆུད་པར་གྱུར་པར་བསྔགས་པ་དང་།",
    "བཅའ་སྒ་དང་རི་མོ་ཟ་བའི་གཞི་དང་།",
    "ཐ་དད་དུ་གྱུར་པ་གཞན་ཅི་ཡང་མེད་པས་དེ་དེ་བཞིན་དུ་ཁྱོད་ཀྱིས་ཟུང་ཤིག་ཅེས་བྱ་བ་ནི་བཞི་པ་མཆོག་ལ་བསླབ་པར་བསྐུལ་བའོ།",
    "གང་གི་ཆེད་དུ་བསྟན་པ་གསུངས་པ་དང་།",
    "ཤིང་གི་ཡལ་ག་རྣམས་ཀུན་ཁྱབ་པར་གཡོགས་པས་དཔྱིད་ནི་ཚ་བའི་སྐྱབས་བྱེད།",
    "རེས་འགའ་སྟེང་དུ་འབྱུང་ཡང་མི་དག་གིས་བླང་དུ་མེད་ཀྱི།",
    "རི་དྭགས་ཀྱི་རྒྱལ་པོས་ཉིན་གཅིག་ལ་རེ་རེ་ཞིག་བསད་ན་ཡུན་རིང་དུ་ཐུབ་པར་འགྱུར་རོ་ཞེས་སྨྲས་སོ།",
    "དེ་ནས་དུས་གཞན་ཞིག་ན་ཤ་བ་སྦྲུམ་མ་ཞིག་ལ་རེས་བབ་པ་དང་།",
    "མེས་རང་གི་ཕུང་པོ་བསྲེགས་ནས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ཀྱི་ཤཱ་རིའི་བུ་འབའ་ཞིག་ནམ་མཁའ་ལས་བབས་ཀྱེཔས།",
    "འདི་ནི་ཆུ་ཀླུང་གི་མིང་ཡིན་ཏེ།",
    "གནས་པ་དང་གནས་པར་འགྱུར་བའི་ཕྱིར་དྲང་སྲོང་གི་གནས་ཞེས་བྱའོ།",
    "ཁ་ཅིག་ན་རེ་དྲང་སྲོང་ལྷུང་བའི་གནས་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་དེ་ཉིད་ལས་དོན་གང་གི་ཕྱིར་གནས་མཆོག་སྐྱེ་བོ་མང་པོའི་གནས་སྤངས་ནས།",
    "དྲིས་ལན་དག་གིས་རྣམ་པར་དབྱེ་བ་དང་།",
    "རྫོགས་བྱེད་ལ་སོགས་པ་སྟོན་པ་དྲུག་གི་ལོག་པའི་ཡན་ལག་བརྒྱད་པའི་འཁོར་ལོ་བསྐོར་བ་གང་ཡིན་པའོ་ཞེའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གལ་ཏེ་ཚིག་གིས་བསྟན་ཅིང་བསྐོར་བར་མ་གྱུར་ན།",
    "ཐམས་ཅད་ཡོད་པར་སྨྲ་བའི་གཞུང་གིས་འདོད་པའི་དོན་ཡང་གོང་དུ་བསྟན་པ་ཡིན་ནོ།",
    "འཕགས་པའི་བསྟན་པ་དང་འཕགས་པའི་ལམ་མོ།",
    "ཕྱེད་འོག་མས་ནི་བཙུན་པ་རབ་དབྱངས་ཀྱིས་རྣམ་པར་གཞག་པའི་གཞུང་གི་དོན་བསྟན་ཏོ་ཞེས་འབྱུང་སྟེ།",
    "རྣམ་པ་གསུམ་དུ་བསྐོར་བ་དེ་དག་གིས་ནི་རིམ་བཞིན་དུ་མཐོང་བའི་ལམ་དང་།",
    "ཐབས་གང་གིས་བརྙེས་པ་དང་།",
    "དེས་ན་མངོན་སུམ་གྱི་འཕགས་པའི་ཡེ་ཤེས་ཡོད་པ་གང་གིས་མཐོང་བས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པ་རྣམས་སྤངས་པ་གང་ཡིན་པ་དེ་ལ་དེའི་ཚེ།",
    "དེ་ཡང་འདས་པ་དང་ད་ལྟར་དང་མ་འོངས་པའི་བྱེ་བྲག་གི་ཕྱིར་གོ་རིམས་བཞིན་དུ་མིག་དང་རིག་པ་དང་བློ་ཞེས་བྱའོ།",
    "མི་སྐྱེ་བ་ཤེས་པ་བརྙེས་པའི་ཕྱིར་བདག་གིས་བྱ་བ་བྱས་ཟིན་ཏོ་སྙམ་པ་སྟེ།",
    "དྲིས་ན་ཡང་བདག་གིས་ཀུན་འཚལ་ཏོ་ཞེས་སྨྲས་པ་དང་།",
    "དེའི་འོག་ཏུ་ཡང་སྔ་མ་བཞིན་དུ་མཐར་ཐུག་པའི་རྣམ་པ་དག་གི་ལྔ་ཆར་གྱིས་དགྲ་བཅོམ་པ་ཉིད་ཐོབ་སྟེ།",
    "འདི་ལྟར་སེམས་ཀྱི་སྐད་ཅིག་མ་བཅུ་དྲུག་པོ་དག་སོ་སོ་ནས་སྐད་ཅིག་མ་རེ་རེ་ཡིན་པའི་ཕྱིར་ནི་མྱུར་བ་ཞེས་བྱའོ།",
    "ཁ་ཅིག་ན་རེ་མཐོང་བའི་ལམ་ནི་རྩིབས་དང་མུ་ཁྱུད་དང་།",
    "ཁ་ཅིག་ན་རེ་ཡང་དག་པའི་ལྟ་བ་དང་།",
    "རང་གི་རྒྱུད་ལ་བསྐོར་བ་དང་།",
    "བཙུན་པ་དེ་དེ་སྐད་དུ་ཟེར་མོད་ཀྱི།",
    "བདེན་པ་རེ་རེ་ལ་ལན་གསུམ་དུ་བསྐོར་བ་དང་།",
    "རྣམ་པའི་མཚན་ཉིད་བཅུ་གཉིས་ཡོད་པར་ལྟ་མོད་ཀྱི།",
    "ཇི་ལྟར་རྒྱུན་ཏུ་ཞུགས་པ་དག་གི་རེ་ལྟར་ཐོགས་ན་སྲིད་པ་ལན་བདུན་པ་དང་མཁས་པའི་གནས་བདུན་དང་།",
    "རྣམ་པའི་མཚན་ཉིད་བཞི་བཅུ་རྩ་བརྒྱད་ནི་ཇི་ལྟར་སྡུག་བསྔལ་གྱི་བདེན་པ་ལ་བཟླས་པ་གསུམ་ཡོད་པས་བཟླས་པ་རེ་རེ་ལ་ཡང་མིག་དང་།",
    "ཇི་སྐད་དུ་རྒྱུན་དུ་ཞུགས་པ་རྣམས་ནི་རེ་ལྟར་ཐོགས་ན་སྲིད་པ་ལན་བདུན་པ་ཞེས་གསུངས་ལ།",
    "གཞན་དག་གིས།",
    "གང་གི་ཆེད་དུ་གསུངས་པ་བསྟན་པ་དང་།",
    "སློབ་དཔོན་ཁྱན་ཙང་གིས་རྒྱ་གར་གྱི་དཔེ་ལས་ཤུ་ལོག་འབུམ་བསྒྱུར་བ་དེ་ཡང་གནས་བཞིར་འདུས་པ་བཅུ་དྲུག་ཏུ་གསུངས་པར་འབྱུང་སྟེ།",
    "གསུམ་པ་འདིར་ནི་གོང་མའི་ཚིག་རེ་རེ་ལ་ཡང་ངོ་བོ་ཉིད་མེད་པ་ཉིད་ཅེས་བརྗོད་པར་བྱ་སྟེ།",
    "མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བ་ནས་རྒྱང་གྲགས་གཅིག་ཙམ་ན་རྫིང་ཞིག་ཡོད་པ་གང་གིས་དེར་ཆུ་འཐུངས་སམ་ཁྲུས་བྱས་ན་ཤེས་རབ་འཕེལ་བར་འགྱུར་བས་ཀུན་གྱིས་རྔུཤེས་རབ་སྦྱིན་པའི་རྫིང་ཞེས་བརྗོད་དོ།",
    "ལྷའི་བུ་མོའི་གནས་ཡིན་པས་སོ།",
    "དང་པོ་ནི་ཉན་ཐོས་བསྒྲུབ་པའི་གང་ཟག་གི་ཆེད་དུའོ།",
    "དང་པོ་ནི་ཉན་ཐོས་ཀྱི་གང་ཟག་གི་ཆེད་དུའོ།",
    "དགོངས་པ་ཟབ་མོ་རྣམ་པར་འགྲེལ་པ་དང་།",
    "བྱང་གི་རི་ལ་གནས་པ་དང་།",
    "བཞི་པ་ནི་ལས་དང་ཉོན་མོངས་པའི་ཀུན་ནས་ཉོན་མོངས་པ་བསྟན་པ་གང་ཡིན་པ་དེ་དག་ནི་དྲང་བའི་དོན་ཅེས་བྱའོ།",
    "ལས་དང་ཉོན་མོངས་པ་ཟད་པར་བསྟན་པ་གང་ཡིན་པ་དེ་དག་ནི་ངེས་པའི་དོན་ཅེས་བྱའོ།",
    "ཚིག་འབྲུ་དང་སེམས་ཐལ་བ་ལྟ་བུར་སྟོན་པ་གང་ཡིན་པ་དེ་དག་ནི་ངེས་པའི་དོན་ཅེས་བྱའོ།",
    "གཞན་ཡང་ཚོར་བའི་ཕུང་པོ་རྣམ་པ་སྣ་ཚོགས་ཡོད་པར་རྣམ་པར་འཇོག་ལ།",
    "རྣམ་པར་མི་རྟོག་པ་ཞེས་བྱ་བ་ནི་ལོ་ཙཱ་བ་དག་གིས་ནོར་བར་བསྒྱུར་ཏེ།",
    "ངེས་པ་མ་ཡིན་པའི་དོན་རྣམ་པ་སྣ་ཚོགས་མི་མཐུན་པའི་ཕྱིར་ངེས་པ་དང་ངེས་པ་མ་ཡིན་པའི་ཚིག་གིས་བསྟན་པ་རྣམས་ལ་ཟབ་པ་དང་ཟབ་པ་མ་ཡིན་པ་ཞེས་བཅད་དུ་མི་རུང་ངོ།",
    "དེ་ལ་གསུམ་པ་བརྗོད་པར་བྱ་བའི་གཞུང་གིས་ཀྱིདོན་ཟབ་པ་དང་ཟབ་པ་མ་ཡིན་པའི་ཙོ།་",
    "དགོངས་པ་ཟབ་མོ་ངེས་པར་འགྲེལ་པ་ལ་སོགས་པ་ནི་གཉིས་པ་ཡིན་ཏེ།",
    "ཁ་ཅིག་ན་རེ་ངོ་བོ་ཉིད་གསུམ་པོ་དག་ཡོངས་སུ་རྫོགས་པར་སེལ་ཏོ་ཞེས་ཟེར་ཏེ།",
    "ཉན་ཐོས་དང་བྷུ་ཐུན་མོང་དུ་གསུངས་པ་དང་གནས་པ་བཅུ་ལས།",
