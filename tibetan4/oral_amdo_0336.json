    "རྒྱ་གཞོམ་པ་ནི་སོ་ཕག་གིས་བྱའོ།",
    "དེ་ནས་རྨ་བྱ་སྒྲུབ་པར་འདོད་ན་ཞག་གསུམ་སྨྱུང་༧བ་བྱས་ཏེ་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་གཞོན་ནུའི་གནས་སུ་སོང་ལ་ཚོན།",
    "རྨ་བྱའི་སྒྲོ་དེ་ཡང་དུད་པ་བཀག་སྟེ་བསྲེགས་ལ་དེས་མིག་བསྐུས་ན་ཕྱེ་མ་རེད་ལུས་མི་སྣང་བར་འགྱུར་ཏེ་ཡིད་ལ་གང་བསམས་པའི་དོན་དེ་བྱེད་ནུས་པར་འགྱུར་རོ།",
    "འབྲུའི་ཞིང་གི་སྟེང་དུ་སོང་ལ་ལན་སྟོང་བཟླས་བརྗོད་བྱས་ན་འབྲུ་རྣམས་རྒྱས་པར་འགྱུར་རོ།",
    "ཟླ་བ་གཅིག་གི་བར་དུ་དུས་གསུམ་དུ་ཁྲུས་བྱས་ཏེ་དུས་གསུམ་དུ་ལན་སྟོང་རྩ་བརྒྱད་བཟླས་བརྗོད་བྱས་ན་ཟླ་བ་གཅིག་ལོན་ནས་བཅོམ་ལྡན་འདས་ལག་ན་རྡོ་རྗེ་མཐོང་བར་འགྱུར་ཏེ་བསམས་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་བྱེད་ཅིང་ཚེ་ལོ་ལྔ་བརྒྱ་ཐུབ་པར་འགྱུར་རོ།",
    "དེ་ན་རེ་བདག་ཅག་གིས་ཅི་ཞིག་བྱ།",
    "དེ་ན་རེ་དེ་ལྟར་བྱའོ་ཞེས་སྨྲས་ནས་མི་སྣང་བར་འགྱུར་ཏེ།",
    "ཟླ་བ་ཉའི་ནུབ་མོ་ཨ་ག་ལ་རུ་དང་།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ་དུར་ཁྲོད་དུ་སོང་ནས་མིའི་ཐོད་པ་བླངས་ལ་རའི་འོ་མས་བཀང་སྟེ་རི།",
    "དེ་ནས་ཡི་དགས་ལའོང་བར་འགྱུར་ཏེ་ཡི་དགས་ན་རེ་རིག་སྔགས་འཆང་ང་ལ་འོ་ཐུག་བྱིན་ཅིག་ཅེས་ཟེར་བ་དང་།",
    "དེ་ནས་རིག་སྔགས་འཆང་གིས་རིག་སྔགས་ཐམས་ཅད་ཀྱི་རྒྱལ་པོ་བཟླས་བརྗོད་བྱེད་བཞིན་དུ་ཡི་དགས་དེ་ལ་སྦྱིན་པར་བྱའོ།",
    "རིག་སྔགས་འཆང་གིས་ཟླ་བ་གཅིག་གི་བར་དུ་སློང་གུམོའི་ཟས་ཟ་ཞིང་།",
    "ཀུན་དགའ་ར་བར་རི་༤ཟླ་བ་གཅིག་གི་བར་དུ་སློང་༥མོའི་ཟས་ཟ་ཞིང་ལན་འབུམ་བཟླས་བརྗོད་བྱས་པའི་མཇུག་༦༧ཏུ་ཞག་གསུམ་སྨྱུང་བ་བྱས་ཏེ།",
    "མཚན་རངས་པར་རི་བཟླས་བརྗོད་བྱས་ན་དེ་ནས་ཤིང་གི་ལྷས་གཟུགས་སྟོན་པར་བྱེད་དེ།",
    "མཚམས་བཅད་༡༧པ་ནི་སོ་ཕག་གིས་བྱའོ།་།",
    "ཟླ་བ་གཅིག་གི་བར་དུ་མེ་ཏོག་དཀར་པོ་ལ་ལན་བདུན་བསྔགས་༧ཏེ་ཕྱེ་མ་རེད་བྱང་ཕྱོགས་སུ་བོར་ནས་ཟླ་བ་གཅིག་ལོན་པ་ན་བཅོམ་ལྡན་འདས་མ་འགྲུབ་པར་འགྱུར་ཏེ་བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་འགྱུར་ཞིང་ལོ་ལྔ་བརྒྱ་ཐུབ་པར་འགྱུར་རོ།",
    "མར་གྱི་ངོ་ཞག་༡་བརྒྱད་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ་འཕགས་པ་ལག་ན་རྡོ་རྗེ་ལ་མེ་ཏོག་དཀར་པོ་སྟོང་གིས་བསྣུན་༡ན་ལོངས་སྤྱོད་ཀྱི་གཞི་སྦྱིན་པར་འགྱུར་རོ།",
    "ཟླ་བ་གཅིག་གི་བར་དུ་སློང་ཚོན་",
    "ཡར་གྱི་ངོ་ཟླ་བ་ཉ་ལ་བརྩམས་ཏེ་སློང་༦མོའི་ཟས་བཟའ་ཞིང་འཕགས་པ་ལག་ན་རྡོ་རྗེའི་ཞབས་དྲུང་དུ་ལན་འབུམ་བཟླས་བརྗོད་བྱས་ན་དཔལ་ཐོབ་པར་འགྱུར་རོ།",
    "མཚམས་བཅད་༧པ་ནི་སོ་ཕག་གིས་བྱའོ།",
    "དུར་ཁྲོད་ཀྱི་ཐལ་བ་བླངས་ཏེ་མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ནས་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ལན་སྟོང་༨བཟླས་བརྗོད་བྱས་ན་ཐལ་བ་དེས་གང་ལ་རེག་པར་བྱས་པ་༩དེ་གདོན་གྱིས་འདེབས་པར་འགྱུར་ཞིང་།",
    "ཚིག་གིས་བསྒོ་བས་གཏོང་བར་འགྱུར་རོ།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ་སཕགས་པ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་དུར་ཁྲོད་ཀྱི་ཤིང་གིས་མེ་སྦར་ནས་དུར་ཁྲོད་ཀྱི་ཡམ་སྲེག་ཤིང་སྐུད་པ་དམར་པོས་དཀྲིས་༦༧པ་བརྒྱད་ཚོ་སྟོང་སྦྱིན་སྲེག་བྱས་ན་དེ་ནས་རྨི་ལམ་དུ་ཚོགས་༨ཆེན་པོ་ལྕགས་ཅན་སྟོན་པར་བྱེད་དེ་དེ་ནས་འགྲུབ་པར་འགྱུར་རོ།",
    "ཆུ་ཁྱོར་༩གང་ལ་ལན་བདུན་བསྔགས་ཛིནས་གང་ལ་བལྟས་ཏེ་གཏོར་བ་དེ་གདོན་གྱིས་ཐེབས་པར་འགྱུར་ལ།",
    "ཆུ་ཀླུང་གི་ནང་དུ་ཞུགས་ཏེ་ལན་བརྒྱད།",
    "མཚམས་བཅད་རིནཔ་ནི་ཐལ་བས་བྱའོ།",
    "མི་རྣམས་ཀྱིས་མི་སོད་ལ་བདག་གི་ཚེའི་ཚད་ཀྱང་ཤེས་པར་འགྱུར་རོ།",
    "ཟླ་བ་གཅིག་གི་བར་དུ་སློང་གེམོའི་ཟས་བཟའ་ཞིང་དེ་ནས་མར་གྱི་ངོ་ཞག་བརྒྱད་དམ།",
    "ཀླུ་མོའམ།",
    "སློང་༥མོའི་ཟས་ཟ་༦ཞིང་ཆོ་ག་འདི་བཞིན་དུ་འཁོར་ལོ་བསྒྲུབས་ན་རིག་སྔགས་འཆང་གི་འཁོར་ལོས་སྒྱུར་ཛོ་བའི་རྒྱལ་པོར་འགྱུར་ཏེ།",
    "སྨིན་དྲུག་གི་བུའི་ཆོ་ག་རྫོགས་སོ།",
    "བསྲུང་བ་ནི་ཐལ་བས་བྱའོ།",
    "མཚམས་བཅད་ཉིདཔ་ནི་སོ་ཕག་གིས་བྱའོ།",
    "གཞོན་ནུ་སྨིན་དྲུག་གི་བུ་དང་།",
    "ལྷ་མོ་དྲུག་མ་ཚོན་རྩི་སྣ་གསུམ་གྱིས་བྲིས་ལ་རིག་སྔགས་འཆང་ཟས་སུ་འོ་མ་དང་ཕྱེའི་འདག་གུ་ཟ་ཞིང་ལན་འབུམ་བཟླས་བརྗོད་བྱས་ན་ལྷ་༤མོ་མཐོང་བར་འགྱུར་ཏེ།་",
    "ཁྱོད་ཀྱི་༡༡ཚེ་འདི་སྲིད་དུ་ཐུབ་པར་འགྱུར་རོ།",
    "ག་གེ་མོ་ཞིག་ཏུ་ཆེ་གེ་མོ་ཞིག་གི་ཚེ་སྲོག་འདོར་རོ་ཞེས་སྟོན་པར་འགྱུར་ཏེ།",
    "མ་འོངས་པའི་ལམ་ཤེས་པར་འདོད་ན་སློང་སམོའི་ཟས་ཟ་ཞིང་འཕགས་པ་ལག་ན་རྡོ་རྗེའི་ཞབས་དྲུང་དུ་ཟླ་བ་གཅིག་གི་བར་དུ་བཟླས་བརྗོད་བྱས་ན་དེ་ནས་བུང་བ་འོང་བར་འགྱུར་ཏེ།",
    "གཞན་ཡང་རུང་སྟེ་དུ་གུ་ལའི་རས་དཀར་པོ་བགོས་ཏེ་དེ་ནས་ཨ་ག་རུ་བསྲེག་ཅིང་རྒྱལ་པོ་དང་གཉིས་ཀ་ཀྱི་ཐད་ཀུར་འདུག་སྟེ་མིག་མི་འཛུམས་པར་སྟབཟླས་བརྗོད་བྱས་ན་མིག་སྔ་ན་འདུག་པའི་ལྷས་གང་གི་དོན་བསྟན་པ་དེ་རྒྱལ་པོས་ཀྱང་ཇི་ཚོ་༨",
    "ན་མོ་བཛྲ་པཱ་ཎི་སུ།",
    "གང་གིས་དཀྱིལ་འཁོར་གྱི་ནང་དུ་གཏོགས་པའི་ལྷ་རྣམས་འགྲུབ་པར་བྱེད་པ་དང་།",
    "དེ་ནས་རིག་སྔགས་འཆང་གིས་དཔལ་གྱི་ཅལྷ་མོའི་རིག་སྔགས་ལན་བརྒྱད་བརྒྱ་བཟླས་སྒྲུབརྗོད་བྱས་ནས་དེའི་འོག་ཏུ་རྡོ་རྗེ་འབར་བ་ཁྲོ་བོ་ཆེན་པོ་ལན་བརྒྱ་སྟོང་བཟླས་བརྗོད་བྱའོ།",
    "རིག་སྔགས་འཆང་གི་རིགས་དང་ལྡན་པ་གང་ཡིན་པ་དེ་དག་གིས་མཐོང་བར་འགྱུར་རོ།",
    "དེ་ནས་རིག་སྔགས་ཀྱི་རྒྱལ་པོ་ལག་ན་རྡོ་རྗེས་རང་གི་རིག་སྔགས་ཀྱི་༧༧ཚོགས་རྣམས་ལ་གླང་པོ་ཆེའི་ལྟ་ནསྟངས་ཀྱིས་བལྟས་སོ།",
    "མུན་པ་དང་རབ་རིབ་དང་ལིང་ཏོག་གི་མུན་ནག་ཐམས་ཅད་མེད་པར་གྱུར་ཏོ།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་གིས་ཀྱང་ཡུམ་འཆང་བའི་རིག་སྔགས་འཆང་དེ་ལ་ཡོངས་སུ་དགའ་ནས་མྱུར་དུ་དངོས་གྲུབ་སྦྱིན་ཞིང་བསྲུང་བ་དང་བསྐྱབ་པར་བགྱིའོ།",
    "གང་གི་ཚེ་རིག་སྔགས་འཆང་གིས་རིག་སྔགས་འཆང་བ་༨ལ་ཕྱག་རྒྱ་སྟོན་པ་ན།",
    "གང་གིས་ཕྱག་རྒྱའི་ཚོགས་མཐོང་བ་དེ་ལ་ནི་རིག་པ་མཆོག་གི་ཆོ་ག་རྒྱས་པ་གསང་བ་དང་བཅས།",
    "དེ་བཞིན་གཤེགས་པའི་གནས་སམ་སྐུ་གདུང་གི་གནས་སུ་ཕྱག་རྒྱའི་ཚོགས་གཞག་པར་བྱའོ།",
    "སློང་ཛོ་མོའི་ཟས་ཟ་ཞིང་ལན་འབུམ་བཟླས་བརྗོད་བྱས་ན་སྔར་བསྙེན་པ་བྱས་པར་འགྱུར་རོ།",
    "དེ་ནས་སྐུ་གདུང་དང་ལྡན་པའི་མཆོད་རྟེན་གྱི་དྲུང་དུ་རི་མོའི་གཟུགས་བཀྲམ་ལ་ཡར་ངོའི་ཚེས་ཞག་གཅིག་ནས་བརྩམས་ཏེ་ཉའི་བར་དུ་བཟླས་བརྗོད་བྱས་པའི་མཇུག་ཏུ་ཞག་གསུམ་སྨྱུང་བར་༧བྱས་ལ་མཆོད་ཉུ་པ་སྣ་ཚོགས་རྒྱས་པར་བྱ་སྣ་སྟེ།",
    "འོ་མ་ཡོད་པའི་ཤིང་གི་༡༩མེ་སྦར་ལ་དུད་པ་མེད་པའི་མདག་ན་མ་ལ་ཨ་ག་༡རུ་ནག་པོའི་ཡམ་སྲེག་ཤིང་དུ་རུསྐའི་རིནམར་གྱི་ནང་དུ་སྨྱུགས་༢དཔ་བརྒྱ་སྟོང་ཕྲག་གསུམ་སྦྱིན་སྲེག་བྱའོ།་།",
    "ཡང་ན་ལྷ་མོ་འོང་བར་འགྱུར་ཏེ་ཕྱག་བྱས་ལ་དམ་པ་རྣམ་པ་བརྒྱད་ལ་༢༥དམ་པ་རྣམ་པ་རིན་གཅིག་བླང་༢་བར་བྱ་སྟེ།",
    "ཉི་མ་ཤར་ཀུའི་གཟི་བྱིན་དང་སལྡན་ཞིང་རིག་སྔགས་འཆང་གི་རྒྱལ་པོར་འགྱུར་ལ།",
    "བསྐལ་པ་༡༢ཆེན་པོ་གཅིག་གི་བར་དུ་འཚོ་བར་འགྱུར་རོ།་",
    "གི་ཝང་ནི་དང་བ་བླ་༢་ལ་སོགས་པའི་རྫས་རྣམས་ཀྱང་དེ་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ།",
    "ཙནྡན་རྣམས་ལྷན་ཅིག་སྦྱར་ཏེ་ཟངས་ཀྱི་སྣོད་དུ་བཅུག་ལ་༢༧ཟླ་བ་སྤྱང་ཀྱིས་༢་ཟིན་པའི་ཚེ་དུད་པ་བྱུང་གི་བར་དུ་བཟླས་བརྗོད་བྱས་ནས་དེས་མིག་བསྐུས་ན་ལུས་མི་སྣང་བར་འགྱུར་ཞིང་འདོད་དགུར་ན་སྒྱུར་༢་བའི་གཟུགས་ཅན་དུ་འགྱུར་ལ་ལུས་མི་སྣང་བར་འགྱུར་བ་ཐམས་ཅད་ཀྱི་རྒྱལ་པོར་འགྱུར་རོ།",
    "སློང་སམོའི་ཟས་ཟ་ཞིང་ལན་འབུམ་བཟླས་བརྗོད་བྱས་པའི་མཇུག་༡་ཏུ་ཞག་གསུམ་སྨྱུང་བ་བྱས་ཏེ།",
    "ཕ་རོལ་གྱི་དཔུང་རེངས་པར་བྱས་༡ན་ལྕགས་ཀྱི་ཕྱེ་མ་ཏིལ་མར་དང་སྦྱར་བས་ལན་སུམ་༥སྟོང་སྦྱིན་སྲེག་བྱའོ།",
    "རྒྱལ་མཚན་དང་དུང་ལ་སོགས་པ་ལ་བསྔགས་རིན་ཡང་དེ་མཐོང་ཞིང་ཐོས་པས་ཕ་རོལ་གྱི་དཔུང་རེངས་པར་འགྱུར་རོ།་།",
    "བྱིས་པ་རྣམས་གདོན་ནོ་ཅོག་གིས་ཟིན་པ་ཁྲུས་བྱེད་དུ་བཅུག་ན་གཏོང་བར་འགྱུར་རོ།",
    "རྨ་བྱའི་མཇུག་མ་ལ་ལན་བརྒྱད་སྟོང་གིས་བསྔགས་༩༥པ་ནི་དུག་གོ་ཅོག་སེལ་བར་བྱེད་དེ་ཤི་ཟིན་པ་ལྷོ་ཡང་འཚོ་༡༡བར་བྱེད་དོ།",
    "སེང་ལྡེང་གི་ཡམ་སྲོག་ཤིང་ཞོ་དང་སྦྲང་།",
    "རྒྱ་མཚོར་འབབ་པའི་ཆུ་ཀླུང་གི་ནང་དུ་ཞུགས་ཏེ།",
    "གནོད་སྦྱིན་མོ་རྣམས་ལ་ནི་ཨ་ཤོ་ཀུའི་༥ཡམ་སྲེག་ཤིང་གིས་བྱའོ།",
    "ཀླུ་རྣམས་ལ་ནི་ཀླུ་ཤིང་གི་མེ་ཏོག་གིས་བྱའོ།",
    "རིག་སྔགས་འཆང་རྣམས་ལ་མཁན་༩པའི་ཡམ་སྲེག་ཤིང་གིས་བྱའོ།",
    "མི་འམ་ཅི་རྣམས་ལ་ནི་པོག་གི་སྦྱིན་སྲེག་གིས་བྱའོ།",
    "ཡི་དགས་རྣམས་ལ་ནི་སྲ་རྩི་པོག་གི་སྦྱིན་སྲེག་གིས་བྱའོ།",
    "ལོག་འདྲེན་རྣམས་ལ་ནི་ཏིལ་གྱི་ཚིགས་མའི་སྦྱིན་སྲེག་པོའོ་གིས་བྱའོ།",
    "འབྱུང་པོ་རྣམས་ལ་ནི་འབྱུང་པོའི་ཟས་ཀྱིས་༧སྦྱིན་སྲེག་ལན་བརྒྱད་བརྒྱ་ཞག་བདུན་ནམ་ཞག་ཉི་ཤུ་རྩ་གཅིག་གི་བར་དུ་བྱའོ།",
    "མིའི་གཙོ་བོའི་བུ་མོ་ལ་ནི་སྐེ་ཆེའི་སྲེག་བླུགས་ཀྱིས་བྱའོ།",
    "བུ་མོ་རྣམས་ལ་ནི་སྣ་མའི་མེ་ཏོག་གིས་བྱའོ།",
    "བུད་མེད་ཐམས་ཅད་ལ་ནི་ལན་ཚྭའི་སྲེག་བླུགས་ཀྱིས་བྱའོ།",
    "རྗེའུ་རིགས་ལ་ནི་ཁའབྲས་ཀྱི་སྦྱར་ཐུག་གི་སྲེག་བླུགས་ཀྱིས་བྱའོ།",
    "དམངས་རིགས་ལ་ནི་མོན་སྲན་གྲེའུའི་སསྲེག་བླུགས་ཀྱི་སྦྱིན་སྲེག་གིས་བྱའོ།",
    "གི་༡་ཝང་གིས་བཅོམ་ལྡན་འདས་མའི་གསང་སྔགས་གང་འདོད་པ་བར་ཐག་ཡངས་པར་ཡི་གེ་བྲིས་ཏེ་༡༥།",
    "བཅོམ་ལྡན་འདས་མ་མཱ་མ་ཏཱི་༡འདི་ནི་རིག་སྔགས་ཀྱི་རྒྱལ་པོ་རིག་པ་མཆོག་གི་ལས་གང་ཡིན་པ་རྣམས་དང་༥།",
    "ཡུངས་ཀུར་ཚེག་ཚེག་ཟེར་གྱི་བར་དུ་བཟླས་བརྗོད་བྱས་ན་རྡོ་རྗེ་འགྲུབ་པར་འགྱུར་ཏེ་རྡོ་རྗེ་དེས་ལས་ཐམས་ཅད་བྱེད་ལ་བྲག་གི་རྩེ་མོ་ཕྱེ་མར་རློག་༥༩ཅིང་རྙིལ་༧བར་བྱེད་དོ།",
    "སྲོག་ཆགས་རྣམས་རེངས་༥པར་བྱེད་དོ།",
    "ཤིང་རྟ་ལ་སོགས་པ་རེངས་པར་བྱེད་ཅིང་ཕྱེ་མར་ཡང་རློག་༡༩སྟེ།",
    "རིའི་རྩེ་མོར་སོང་སྟེ་ལྕགས་ཞུན་༢༢མ་ལས་བྱས་པའི་རྡོ་རྗེ་ཐོགས་ལ་ལག་པ་གཡོན་པས་བཟུང་ལ་དལན་དྲུག་འབུམ་བཟླས་བརྗོད་བྱས་ན་དེ་ནས་རི་འགུལ་བར་འགྱུར་ཏེ་ལྷ།",
    "སློང་ཛིམོའི་ཟས་ཟ་ཞིང་རིའི་རྩེ་མོར་བྱེ་བ་གཅིག་བཟླས་བརྗོད་བྱས་ན་ཡིད་ལ་གང་འདོད་པ་དེ་ཐམས་ཅད་དེས་ཐོབ་པར་འགྱུར་རོ།",
    "ན་མོ་བཛྲ་པཱ་ཎི་༣",
    "ཁྱོད་ལ་དེ་བཞིན་གཤེགས་པས་གནང་བར་མཛད་ཀྱིས་ཚོ།",
    "ན་མོ་རཏྣ་༥ཏྲ་ཡ་༥སུ།",
    "ན་མོ་བཛྲ་པཱ་ཎི་ཅསུ།",
    "བིལ་བའི་ཤིང་གིས་མེ་སྦར་ཏེ་འབྲས་ཡོས་སམ།",
    "གི་༢༢ཝང་ཡང་ཆོ་ག་དེ་དང་འདྲའོ།",
    "གྲུབ་པར་མ་གྱུར་ན་ལས་འདི་དག་བྱས་ཏེ་བིལ་བའི་ཤིང་གིས་མེ་སྦར་ཏེ་ཏིལ་ནག་པོ་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བྱས་ན་འགྲུབ་པར་འགྱུར་རོ།",
    "བསྐྲད་པར་བྱས་༡་ན་ཨརྐའི་༡་ཤིང་གི་ལོམེ་སྦར་ལ་ལུང་ཏང་གི་མེ་ཏོག་གིས་ལན་བརྒྱ་སྟོང་སྦྱིན་སྲེག་བྱས་ན་ཞག་བདུན་གྱིས་འབྲོས་པར་འགྱུར་རོལ།",
    "གཞིག་པར་བྱ་ན་དུར་ཁྲོད་ནས་མེ་བླངས་པའི་ནང་དུ་དུར་ཁྲོད་ཀྱི་ཐལ་བས་༡༩སྦྱིན་སྲེག་བྱས་ན་འཇིག་༢་པར་འགྱུར་རོ།",
    "ར་གན་གཅིག་ཏུ་སྦྱར་བས་གཡོགས་ལ་གོ་ཕྱེའི་༥ཤིང་གི་གབ་ཚེར་བཅུག་སྟེཚེ།",
    "རིའི་རྩེ་མོར་སོང་སྟེ་ལན་འབུམ་བཟླས་བརྗོད་བྱས་ན་ལྷ་མ་ཡིན་གྱི་ཕུག་གི་འཁྲུལ་ཚོགེའཁོར་ཐམས་ཅད་ཧཱུཾ་ཞེས་བྱ་བའམ་ཚོ།",
    "ཁྲག་དང་སྦྱར་བས་ལན་བརྒྱ་ད་སྟོང་སྦྱིན་སྲེག་བྱས་པས་ལྷ་མ་ཡིན་གྱི་བུ་མོ་གཅིག་བཞིན་ཕྱིར་རི་བྱུང་ནས་སྒྲུབ་པ་པོ་ནང་དུ་ཁྲིད་པར་འགྱུར་རོ།",
    "ལིག་བུ་མིག་གི་གེརྒྱུད་མ་ཆད་པར་ལན་སྟོང་༢༤སྦྱིན་སྲེག་བྱས་ལ་ཟླ་བ་སྤྱང་ཀྱིས་ཟིན་པའི་ཚེ་ཟླ་བ་མ་བཏང་གི་བར་དུ་བཟླས་བརྗོད་བྱས་ཏེ་དེས་མིག་བསྐུས་༢༨ན་ལུས་མི་སྣང་བར་འགྱུར་ཞིང་ཚེ་ལོ་སྟོང་ཐུབ་པར་འགྱུར་རོ།",
    "ལིག་བུ་མིག་དང་གི་༨༧ཝང་དང་དགའ་བྱེད་ཀྱི་སྲད་༩བུ་དང་།་",
    "རྟོབཞི་གང་ཡང་རུང་བའི་ཕྱེ་ཝ་མ་རེད་ཨརྐའི་༡ཤིང་གིས་མེ་སྦར་ལ་ཡུངས་ཀུར་གྱི་ནལན་བརྒྱད་དསསྟོང་སྦྱིན་སྲེག་བྱས་ན་མིང་ནས་གང་སྨོས་པ་ཁུགས་པར་འགྱུར་ཏེ།",
    "རིག་སྔགས་འཆང་གི་འཁོར་ལོས་སྒྱུར་༡་བར་འགྱུར་ཞིང་བསྐལ་པར་གནས་ཤིང་ལག་ན་རྡོ་རྗེ་དང་མཐུ་སྟོབས་མཉམ་པར་འགྱུར་རོ།",
    "རི་མོའི་གཟུགས་དེ་ཉིད་ཀྱི་མདུན་དུ་ཡར་གྱི་ངོ་ལས་བརྩམས་ཏེ་དུས་གསུམ་དུ་ལན་བརྒྱ་སྟོང་བཟླས་བརྗོད་བྱས་ནས་དེའི་མདུན་དུ་ཞག་གསུམ་སྨྱུང་བ་༡༨བྱས་ལ།",
    "དེ་ནས་ཡར་གྱི་ངོ་ཚེས་བཅྭ་༩ལྔ་ལ་ཟླ་བ་སྤྱང་ཀྱིས་༩ཟིན་པའི་ཚེ་ཁར་བཅུག་སྟེ་༡༡ཟླ་བ་མ་བཏང་གི་བར་དུ་བཟླས་བརྗོད་བྱས་ཏེ་དེས་མིག་ལ་༡༢བསྐུས་པས་ལུས་མི་སྣང་བར་འགྱུར་རོ།",
    "ཡང་ན་བུད་མེད་གང་སྐྱེས་པ་དང་མ་ཕྲད་པར་ཤི་བ་དེའི་མོ་མཚན་དུ་མར་གྱི་ངོ་ཞག་བཅུ་བཞི་ལ་ཡིག་བུ་མིག་དང་སྡོང་རོས་བཅུག་སྟེ་༡།",
    "ལྡོང་རོས་ཕྲོགས་འོཔར་གྱུར་ན་ཞག་གསུམ་སྨྱུང་བར་བྱས་ལ་ལན་སུམ་འབུམ་བཟླས་བརྗོད་བྱས་ནས་བ་ལང་གི་ལྕི་བ་ས་ལ་མ་ལྷུང་བ་ལས་རིག་སྔགས་འཆང་གི་གཟུགས་བྱས་ཏེ་ཁྲག་གིས་བསྐུས་ལ།",
    "ཀ་ར་བཱི་རའི་མེ་ཏོག་གིས་མཆོད་ནས་ལྕགས་ཞུན་མའི་མཚོན་གྱིས་བཅད་ན།",
    "རིག་སྔགས་འཆང་གིས་ལིག་བུ་མིག་གམ།",
    "དབྱེ་བར་བྱ་འདོད་ན་གཉིས་ཀུའི་སེན་མོ་བཅད་པ་བླངས་ལ་ཏིལ་ནག་པོ་དང་བསྲེས་ཏེ་ཚ་བ་གསུམ་དང་ཡུངས་ཀུར་མར་དང་སྦྱར་བས་ཞག་བདུན་གྱི་བར་དུ་དུས་གསུམ་དུ་ལན་བརྒྱ་རྩ་བརྒྱད་སྦྱིན་སྲེག་བྱས་ན་དབྱེ་བར་འགྱུར་རོ།",
    "དེ་ནས་གདོན་གྱིས་ཟིན་པར་བྱ་བར་འདོད་དམ་ཡང་ན་གང་ལ་རིམས་ཀྱིས་འདེབས་པར་འདོད་ན་ཞག་བདུན་གྱི་བར་དུ་དུས་གསུམ་དུ་ཨརྐའི་༥ཤིང་གིས་མེ་སྦར་ལ་མི་རིམས་ཀྱིས་བཏབ་པ་གང་ཡིན་པ་དེའི་རྐང་རྗེས་ཀྱི་རྡུལ་བླངས་ཏེ།",
    "བ་ལང་གི་ལྕི་བ་ས་ལ་མ་ལྷུང་བ་ལས་གཟུགས་བྱས་ཏེ་སེང་ལྡེང་གི་ཕུར་བུ་ལ་ལན་བརྒྱད་༩སྟོང་བསྔགས་པས་བཙུགས་ཞུཉན་ཟག་པར་འགྱུར་རོ།",
    "བུད་མེད་ཀྱི་མཚན་ཟག་པར་འདོད་ན་ཞག་གཅིག་སྨྱུང་བར་༢༤བྱས་ཏེ་ཕག་ཤ་ལས་མོ་མཚན་གྱི་གཟུགས་བྱས་ལ།",
    "ཞག་དྲུག་གི་བར་དུ་ནི་ཕྱིར་གསོར་རུང་ངོ།",
    "བ་རུ་༧རའི་ཤིང་གིས་མེ་སྦར་བའི་ནང་དུ་མཚོན་ཆ་ཕྱེ་མར་བྱས་པ་ཁྲག་དང་སྦྱར་བས་ལན་བརྒྱ་སྟོང་སྦྱིན་སྲེག་བྱས་ལ་དེའི་ཐལ་བས་༨བདག་གི་དམག་དང་དམག་དཔོན་རྣམས་ལ་ཐིག་ལེ་བྱས་ནས་༩།",
    "རྒྱལ་མཚན་གྱི་རྩེ་མོ་ལ་ཡང་བྱུགས་ཏེ་བསྟན་ན་མཐོང་བ་ཙམ་གྱིས་ཕ་རོལ་གྱི་སྐདམག་ཚོགས་དང་དམག་དཔོན་དེ་དག་ཕམ་པར་འགྱུར་རོ།",
    "ཡུངས་ཀུར་དམར་པོ་བླངས་ཏེ་ལན་བརྒྱ་སྟོང་བསྔགས་༡ལྷཔས་བདག་གི་དམག་འཁོད་པའི་ངས་ལ་གཏོགས་པའི་ས་གཏོར་སཏེ་མགོ་ལ་ཡང་གཏོར་ན་བདག་གི་ཚདམག་དང་དམག་དཔོན་རྣམས་མཐོང་བ་ཙམ་གྱིས་ཕ་རོལ་གྱི་དམག་ཕམ་པར་འགྱུར་ཏེ།",
    "ནམ་ཡང་ཕ་རོལ་གྱི་དམག་གིས་ནོན་པར་མི་འགྱུར་རོ།་།",
    "ཡང་ན་བདག་གི་ནང་དུ་འདུག་སྟེ་༡་བཟླས་བརྗོད་བྱས་ན་ཕ་རོལ་གྱི་དམག་ཕམ་པར་འགྱུར་རོ།",
    "དེ་ནས་རྒྱལ་སྲིད་སྒྲུབ་པར་འདོད་ན་རིའི་རྩེ་མོར་སོང་ལ་སློང་༡་མོའི་ཟས་ཟ་ཞིང་ལན་བྱེ་བར་བཟླས་བརྗོད་བྱས་ན་༡༩བཟླས་བརྗོད་ཟིན་པའི་འོག་ཏུ་རྡོ་རྗེ་ཁྲོ་བོ་འོང་སྟེ་རང་གི་གཟུགས་བསྟན་ནས་དམ་པ་སྦྱིན་པར་བྱེད་དེ།",
    "སློང་༧མོའི་ཟས་ཟ་ཞིང་ལན་འབུམ་བཟླས་བརྗོད་བྱས་ཏེ།",
    "ཞིང་༡་གི་དབུས་སུ་བཟླས་བརྗོད་བྱས་ན་རྒྱས་པར་བྱ་བའམ།",
    "གྲོང་བཤིག་མུཔར་འདོད་ན་གྲོང་གི་དབུས་སུ་ཞག་གཅིག་སྨྱུང་བ་བྱས་ཏེ།",
    "གོས་འདོད་ན་ཉི་མ་ཤར་བར་རས་ཀྱི་ཁ་ཚར་རེ་རེ་ལ་བཟླས་བརྗོད་ལན་རེ་རེ་བྱས་པ་བརྒྱད་སྟོང་སྦྱིན་སྲེག་བྱས་ན་གོས་ཐོབ་པར་འགྱུར་རོ།",
    "ཕུབ་མའི་སྦྱིན་སྲེག་གིས་ནི་དགྲ་མ་རུངས་པར་རྩོ་འགྱུར་རོ།",
    "ཏིལ་བཏགས་པའི་སྦྱིན་སྲེག་གིས་ནི་ལོག་འདྲེན་གྱིས་ཟིན་པར་འགྱུར་རོ།",
    "ཞག་བདུན་གྱི་ཉིན་པར་ལྕགས་ཞུན་མའི་མཚོན་གྱིས་བཅད་༡༧ཅིང་སྦྱིན་སྲེག་བྱས་ན་ཞག་གཅིག་གིས་རིག་སྔགས་བཅད་པར་འགྱུར་རོ།",
    "གླང་པོ་ཆེའི་མགོ་ཅན་གྱི་གཟུགས་སྔ་ནས་ཡོད་པ་དེར་སོང་ལ།",
    "ཕ་རོལ་གྱི་དམག་རེངས་པར་བྱ་ན་མདའ་ལ་ལན་བརྒྱད་སྟོང་བཟླས་བརྗོད་བྱས་ཏེ་འཕངས་༩༥སྨིན་རེངས་པར་འགྱུར་ཏེ་མཚོན་འདེབས་ཤིང་འཕེན་མི་ནུས་པར་འགྱུར་རོ།",
    "ཆོམ་རྐུན་རེངས་པར་བྱ་ན་ཡིད་ལ་བཟླས་བརྗོད་བྱས་ན་རེངས་པར་འགྱུར་རོ།",
    "མི་མ་ཡིན་པ་རེངས་པར་བྱ་ན་དུར་ཁྲོད་ཀྱི་ལྕགས་ཀྱི་ཕུར་བུ་ལ་བསྔགས་ཏེ།",
    "བཙུགས་ན་བཅིངས་པ་དང་རེངས་པར་འགྱུར་ལ་ཕྱུང་བ་༤རིན་གྲོལ་བར་འགྱུར་རོ།",
    "མཚམས་བཅད་པ་ནི་ཡུངས་མར་རམ་ཐལ་བའམ་ཆུས་བྱའོ།",
    "དེ་ནས་སྐྱབས་མ་རྙེད་༧པའི་གནོད་སྦྱིན་དེ་དག་ལག་ན་རྡོ་རྗེ་ལ་སྐྱབས་སུ་སོང་སྟེ།",
    "སྟོབས་པོ་ཆེ་ཕ་རོལ་གནོན་པ་༥༩ཁྱོད་ཀྱིས་ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་གྱི་དོན་གྱི་ཕྱིར་གང་གིས་ལྷ་ཐམས་ཅད་རྒྱལ་བར་འགྱུར་ལ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ལག་ན་རྡོ་རྗེ་དང་སྤྱན་ལ་ཕྱག་བྱས་ནས་ལྷ་མ་ཡིན་རྣམས་དང་ཟས་སུ་ཁྲག་འཐུང་བའི་གདོན་རྣམས་གཞིག་པའི་ཕྱིར་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་རིག་སྔགས་ཆེན་མོ་བརྗོད་དོ།",
    "དེ་ནས་ལྷ་མ་ཡིན་དེ་དག་གི་ཁུ་ཚུར་གྱི་མིང་ཐོས་ནས་བྲག་ལ་གནམ་ལྕགས་ཀྱིས་ཕོག་པ་བཞིན་དུ་མ་རུང་བར་འགྱུར་རོཚ།",
    "ན་མོ་རཏྣ་ཏྲ་ཡ་༩༧སུ།",
    "ལག་ན་རྡོ་རྗེའི་སྐྱབས་སུ་སོང་།",
    "རིག་སྔགས་ཀྱི་རྒྱལ་པོ་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་རིག་སྔགས་ཆེན་མོའི་ལས་རྣམས་ཤོད་ཅིག་ཤོད་༥ཅིག་ཅེས་སྨྲས་ནས།",
    "ཆུ་ཀླུང་གི་འགྲམ་མམ་ཛཱི།",
    "ཟ་གཅིག་པ་དང་སློང་མོའི་ཟས་ཟ་ཞིང་མི་སྨྲ་བར་ལན་སུམ་འབུམ་མམ་ནལྔ་འབུམ་བཟླས་བརྗོད་༢༩བྱའོ།",
    "པདྨའི་རྫིང་བུར་མེ་ཏོག་ལ་ལན་རེ་རེ་བཟླས་བརྗོད་བྱས་ཏེ་དོར་བར་བྱའོ།",
    "ལས་འདི་དག་བྱས་ན་ལྷ་ཉིད་རང་གི་ཆ་ལུགས་ཀྱིས་འོང་བར་བྱེད་དེ་འགོག་པར་བྱེད་དོ།",
    "ཕྱིས་སར་པས་རི་མོ་མཁན་གཙང་མ་གསོ་སྦྱོང་གི་ཡན་ལག་བརྒྱད་དང་ལྡན་པ་བཅོམ་ལྡན་འདས་ཀྱི་སྐུ་གཟུགས་འདྲིར་གཞུག་༤གོ།",
    "སྒྲུབ་པ་པོ་ཡང་འོག་ལོགས་སུ་པུས་༡་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ཏེ་ལག་པ་གཡས་པ་ན་པོག་ཕོར་ཐོགས།",
    "ལག་པ་གཡོན་པ་ན་མེ་ཏོག་གི་ཟ་མ་ཏོག་ཐོགས་པར་བྲིའོ།",
    "མཚན་མོ་ནི་སྦྱིན་སྲེག་བྱ།",
    "ཉིན་མོ་ནི་བཟླས་བརྗོད་བྱ་སྟེ།",
    "འཇིགས་པ་ཐམས་ཅད་ལ་ནི་བིལ་༨བའི་ཡམ་སྲེག་ཤིང་གིས་བྱའོ།",
    "ཕྱོགས་བཞིར་ཡང་འཇིག་རྟེན་སྐྱོང་བ་རྣམས་ལས་འབྱུང་པོའི་ཟས་ཀྱི་གཏོར་མ་ཤ་དང་ཆང་དང་བཅས་པར་ནུབ་༡་མོ་སྦྱིན་པར་བྱའོ།",
    "ལོ་༡༡ཏོག་རྒྱས་པར་བྱ་༡༢ན་ནས་དང་ཨུ་དུམ་བཱ་རའི་༡་ཡམ་སྲེག་ཤིང་གིས་བྱའོ།",
    "མ་ད་ནའི་ཚེར་༡་མའི་ཡམ་སྲེག་ཤིང་གིས་བྱའོ།",
    "ལན་ཚྭ་ལས་གཟུགས་བྱས་ཏེ་བུད་མེད་ལ་༡ནི་རྐང་པ་གཡོན་པ་ནས།",
    "སྐྱེས་པ་ལ་ནི་རྐང་པ་གཡས་པ་ཉསྟནས་བརྩམ་མོ།",
    "ལག་པ་གཡས་པའི་མཛུབ་མོ་ནི་བསྡིགས་པའི་ཚུལ་དུ་བྱ་སྟེ།",
    "གཡས་ཕྱོགས་སུ་སྒྲུབ་པ་པོ་ལག་ན་རྡོ་རྗེའི་ཞལ་དུ་བལྟ་རི་ནོཞིང་པུས་རི་རིམོ་གཉིས་ས་ལ་བཙུགས་ཏེ་རྡོ་རྗེ་འཛིན་ལ་སྙིམ་པར་མེ་ཏོག་འཐོར་བར་བྱ།",
