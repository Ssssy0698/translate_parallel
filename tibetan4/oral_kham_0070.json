    "སྦ་རི་བོ་ཆོན་ཐག་བརྒྱས་ནི་གདའ།",
    "བྱ་འུག་པ་བྲག་ལ་ཞུགས་ནས་གདའ།",
    "བྱ་ཕོ་རོག་ཅིག་ཚང་ནས་ཉལ་ནི་གདའ།",
    "རྩི་དཀར་དམར་གྱིས་མེ་ཏོག་འཁྲུང་ནི་གདའ།",
    "གསལ་བའི་སྒྲོན་མེ་ཅིག་ཀྱང་ནི་གདའ།",
    "ཡིད་བཞིན་ནོར་བུ་ཅིག་བཞག་ནི་གདའ།",
    "བྱ་གོ་སྐྱ་ཅིག་གཟན་ལ་འཇུམ་ནི་གདའ།",
    "གསུང་བསྙན་ཁུ་བྱུག་ཅིག་བབ་ནི་གདའ།",
    "རྩིས་མཁས་པས་རྩིས་གཞི་བཏིང་ནས་གདའ།",
    "བྲག་ལ་གསེར་འཛིན་ཅིག་བརྒྱབ་ནས་གདའ།",
    "རྩི་ཤིང་ཅིག་མཐའ་ནས་རྒྱས་ན་གདའ།",
    "མཚོན་ངར་མ་ལ་སྙི་འཛེར་བརྒྱབ་ན་གདའ།",
    "གཅན་གཡུ་འབྲུག་ཟེ་བ་རྒྱས་ནི་གདའ།",
    "ཁྱུང་ཆེན་གྱིས་གཤོག་པ་རྒྱང་ན་གདའ།",
    "སྤྱི་ཚེ་ཁྱུང་གཤོག་ལྡེམ་པ་གདའ།",
    "འབྲོང་གར་མ་ཅིག་རྫ་ལ་འགྱིང་ནི་གདའ།",
    "རྒོད་ངང་མས་བྱ་མཁར་བརྩིག་ནས་གདའ།",
    "སྟག་ངར་མ་ཅིག་ཚང་ནས་ལོང་ནི་གདའ།",
    "རྒོད་ངང་མ་ཅིག་གདོས་ལ་ཐོག་ནས་གདའ།",
    "ཆབ་རྩང་པོ་ཅིག་ཕུགས་ནས་འབྲུག་ན་གདའ།",
    "སྤྱང་ཐོང་ཅིག་ལུག་ལ་འཇབ་ནས་གདའ།",
    "ཕོ་དཔའ་བོ་གཉིས་ཀྱི་རལ་ཁ་འགྱེད་ཞིང་གདའ།"
  ]
}