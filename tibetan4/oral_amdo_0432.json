    "སྲིད་གསུམ་རེ་བ་རྫོགས་པར་ཤོག།",
    "༤༤༤༡ པེ་སྣར་གིས་ལུས་བསྐྱེད།",
    "༣ པེ་གིས་ངག་སྐྱེས།",
    "སྣར་གིས་གང་སྐྱེས།",
    "པེ་སྣར་གི།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "བྱམས་མགོན་ཐུགས་རྗེའི་ལྷ་ཁྱོད་བདག་ལ་དགོངས།",
    "མོས་པའི་དད་པས་འཕགས་མཆོག་མི་འདོར་ན།",
    "སྐྱེས་པས་འགྱོད་དེ་ལས་ལ་ཡི་རེ་ཆད།",
    "རྒྱུད། ནུ་༧༣ཚོ་བློ་བྷཐོག་མ་མེད་ནས་མ་རིག་ལིང་ཐོག་གིས།་།",
    "ལྡོངས་པའི་ཆུ་བུར་མིག་གིས་མ་མཐོང་ན་། འགྲོ་བའི་མགོན་ཁྱོད་ད་ལྟ་ག་ན་བཞུགས།",
    "བྱས་པའི་ལས་རྣམས་དོན་མེད་ཆུད་རེ་ཟོས།",
    "སྐྱེ་བ་གཅིག་གིས་ཁོ་ན་ཙམ་གྱི་ལས།",
    "དེ་ཙམ་བྱས་པའི་ལས་ལའང་དོན་རེ་ཡོད།",
    "ཉེས་བྱས་ཐམས་ཅད་རང་གི་ལས་ལས་བྱུང་།",
    "རྗེ་ཆེན་པོས་ངན་སོང་རྒྱུན་གཅད་དེ།",
    "ཡེ་ཤེས་སྒྲོན་མེའི་ཟེར་གྱིས་མི་གཟིགས་སམ།",
    "ཐུགས་རྗེ་ཅན་ཁྱོད་ཕྲིན་ལས་མི་མཛད་དམ།",
    "ཕྱིན་ཅི་ལོག་གི་གཡང་སར་ལྷུང་ལགས་ན།",
    "ཐུགས་རྗེས་མྱུར་མགྱོགས་ཕྱག་གིས་མི་འཛིན་ནམ།",
