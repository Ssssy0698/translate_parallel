    "ཉེས་པ་ཐམས་ཅད་རང་གི་ལས་ལས་བྱུང་།",
    "ཉོན་མོངས་ལས་ཀྱི་རྒྱུན་ནི་བཟློག་ཏུ་གསོལ།",
    "ཕྱིན་ཅི་ལོག་གི་གཡང་སར་ལྷུང་ལགས་ན།",
    "མྱུར་མགྱོགས་ཐུགས་རྗེའི་ཕྱག་གིས་གཟུང་དུ་གསོལ།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "མཆོག་གི་དངོས་གྲུབ་མ་ལུས་སྩལ་དུ་གསོལ།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས།་།",
    "བདག་གིས་འབད་ཀྱང་འབྲས་བུ་མ་མཆིས་ན།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "དེ་སྲིད་བདག་གི་ལུས་སྐྱེད་པས།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "དེ་སྲིད་བདག་གི་ངག་སྐྱེད་པས།",
    "ངག་གིས་མགོན་པོའི་མཚན་བརྗོད་ཅིང་།",
    "ངག་གི་ཚོགས་ནི་རྫོགས་པར་ཤོག།",
