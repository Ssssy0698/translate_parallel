    "ཉི་ཟླ་སོགས་གཟའ་རྣམས་ཀྱང་ཁྱིམ་སྟེང་ཤོད་ལ་ཁང་པའི་སྟེང་འོག་ཏུ་བགྲོད་པ་ན་འབབ་འཛེག་བྱས་ནས་རྒྱུ་བ་ལྟ་བུར་འདོད་དོ།",
    "ལྷོ་བྱང་དུ་མེད་པས་རི་རབ་དང་མེ་རིའི་དབུས་དྲང་པོའི་རི་རབ་ཀྱི་ཁ་ཁྱེར་ནས་དཔག་ཚད་སྟོང་ཕྲག་ཕྱེད་བཅས་སོ་བདུན་གྱི་མཚམས་དུས་ཐམས་ཅད་དུ་ཉི་མའི་རྒྱུ་ལམ་ཡིན་པ་ལ་ཁྱད་པར་མེད་ཀྱང་།",
    "ཁྱིམ་དེ་གཉིས་ཀྱི་རྒྱུ་ལམ་ཡང་གཅིག་ཁྱིམ་དེ་གཉིས་ཀྱི་ཕྱི་རོལ་དུ་མེ་རི་ལ་ཉེ་བ་མཐར་ཐུག་པར་གཞུ་དང་ཆུ་སྲིན་ལ་ཉི་མ་བགྲོད་པ་ན་དགུན་འབྲིང་འབྱུང་ལ།",
    "ལོ་ཆེན་དྷརྨ་ཤྲཱིས་འདི་ནི་འཕན་ཡུལ་གྲོ་སའི་འདུལ་འཛིན་ཆེན་པོ་དམར་སྟོན་སོགས་ཀྱི་བཞེད་པ་ཡིན་པར་ཡང་གསུངས་སོ།",
    "ལྷོ་བྱང་དུ་དགུན་ཡོད་པར་བཞེད།",
    "དེ་དང་མཐུན་པར་མཆིམས་ནམ་མཁའ་གྲགས་ཀྱིས་ཀྱང་བཞེད།",
    "ཕྱི་མའི་དུས་ཟི་ལུང་ཤཱཀ་མཆོག་ཆེན་པོས་ཀྱང་དེ་དང་ཕྱོགས་མཐུན་དུ་སྨྲ་བར་སྣང་ཞེས་ཀརྨ་མི་བསྐྱོད་རྡོ་རྗེས་གསུངས་སོ།",
    "རྗེས་སོར་ལུགས་འདིའི་རྗེས་འབྲང་མཁས་པ་ཕལ་ཆེར་གྱིས་གནམ་སའི་གོ་ལ་གཉིས་ཀ་གཡས་བསྐོར་དུ་འདོད་པའི་ལུགས་འདི་ཁོན་ན་བཞེད་པར་སྣང་ངོ།",
    "གོ་ལ་བཅུ་གཉིས་པོ་ནང་ནས་ཕྱིར་མུ་ཁྱུད་བཞིན་དུ་རིམ་པར་ཡོད་པའམ་སྟེང་ནས་སྟེང་དུ་རྨོག་བརྩེགས་པ་ལྟ་བུ་མ་ཡིན་པར།",
    "དྲུ་གུ་འཛིངས་པ་བཞིན་དུ་ཁྱིམ་བཅུ་གཉིས་པོ་སོ་སོ་ནས་ལྷས་མ་ལྟ་བུར་ཕན་ཚུན་སྟེང་འོག་ཏུ་འཛིང་བར་ཡོད་པར་འདོད་པས་ན་དྲུ་འཛིངས་མའི་ལུགས་ཞེས་བརྗོད་དོ།",
    "དེ་ལྟར་ཁྱིམ་ཟླུམ་སྐོར་བཅུ་གཉིས་པོ་སོ་སོ་ནས་དྲུ་གུ་འཛིངས་པ་ལྟར་གནས་ཤིང་རྟག་པར་གཡས་སུ་འཁོར་ཡང་།",
    "དུ་བྱས་པའི་རི་རབ་ཀྱི་ཤར་ལྷོའི་ཟུར་ན་གནས་པ་ལྷོ་གླིང་ཤར་མ་ལ་དབྱརསྣྲོན་གྱི་ཟླ་བ་འཆར།",
    "སྤྱི་ནོར་བཅས་ལ་གོམས་འདྲེས་ཆེར་མེད་ན་རྩིས་ཀྱི་གོ་བ་རྙེད་དཀའ་བས་ཚུལ་འདིའང་འབད་པར་བའོ།",
    "ངན་པ་དགུ་འཛོམས་ཀྱི་ཚེས་རྣམས་ངེས་པར་དུ་ཆད་དགོས་པར་འགྲོའོ།",
    "འགྲོགས་པའི་ཚེས་དེ་ལྷག་པར་བཏགས།",
    "དེ་ཡང་ཅུང་ཟད་རྒྱས་པར་བཀྲོལ་ན།",
    "ཡང་ཚེས་གང་ཡང་རུང་བའི་རྩིས་བྱས་པ་ན་སྔ་ཚེས་ཀྱི་གཟའ་ལས་གཟའ་གཅིག་བརྒལ་ནས་ལོངས་སྤྱོད་མེད་པའམ་ཉུང་ངུར་གྱུར་པའི་ཚེ།",
    "ཚེས་ཞག་འོག་མའི་ཡང་ངོ་མཐོང་བ་ནམ་བྱུང་བའི་ཚེ་ཆད་པར་སྣང་བ་འབྱུང་ལ།",
    "ཚེས་གཉིས་ཀྱི་རྩིས་བྱས་པས་གཟའ་གཅིག་དང་ཆུ་ཚོད་ང་དགུ་ལྟ་བུ་བྱུང་བ་ན།",
    "ཟླ་བཤོལ་དེ་ཇི་ལྟར་འདོན་པ་ལ་ལག་ལེན་གྱི་ཕྱག་བཞེས་སུ་མདའ་རོའི་ལྷག་མ་འཕར་བའི་ཚེ་ཟླ་བཤོལ་འདོན་པ་དང་།",
    "དེ་ཡང་ཞིབ་པར་རྣམ་འགྲེལ་གསེར་ཤིང་ལས།",
    "ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "། འབྱུང་རྩིས་མན་ངག་ཟླ་བའི་འོད་ཟེར་ལས་ལེའུ་དང་པོ་ཟུར་དུ་བཀོལ་བ་བཞུགས་སོ།",
    "མཁྱེན་བརྩེའི་ཆུ་སྐྱེས་ཀེ་ས་རར།",
    "ཁྱུང་ཕུག་བརྒྱུད་པར་བཅས་ཀུན་རྒྱལ།",
    "མཐའ་དབུས་མེད་ཅིང་འདུས་མ་བྱས།",
    "འབྱུང་རྩིས་ཐོག་མར་གསུངས་པའི་ཚེ།",
    "བརྒྱད་དགུ་བུ་རུ་ཤེས་པར་བྱ།",
    "སྐོར་འགོ་བྱས་ནས་གྱེན་ཐུར་བརྩི།",
    "བདུན་པ་བདུན་ཟུར་ཤེས་པར་བྱ།",
    "སྐྱེས་སྨེ་དབུས་བྱས་བྱ་འཕུར་ལྟར།",
    "རིམ་པར་དེད་པས་ཚེས་ལ་འཁོར།",
    "འབྲས་བུའི་སྐབས་སུ་ཤེས་པར་འགྱུར།",
    "ཞིབ་པར་སྒང་བཤོལ་ཚིགས་དང་སྦྱོར།",
    "རིམ་པར་སྦྱར་བས་ཆད་ལྷག་མེད།",
    "ཉིན་དྲུག་མཚན་དྲུག་རྣམ་པར་བཞག།",
    "ཞག་དང་དུས་ཚོད་རྐྱང་པར་འདེད།",
    "ཟླ་བ་དེ་ཉིད་གཞིར་བྱས་ཏེ།",
    "གཡས་བསྐོར་རིམ་པར་བགྲངས་བྱས་ནས།",
    "སྐབས་དང་སྦྱར་ཏེ་བཞག་པར་བྱ།",
    "ཁྱད་པར་གནམ་ལོའི་མདུན་རྒྱབ་ཏུ།",
    "མར་གྱི་ལྔ་མཐུན་ལོ་པར་འབྱུང་།",
    "གཤེད་དུར་ཆེ་ཆུང་རིམ་པར་སྦྱར།",
    "བརྩི་བྱའི་ལོ་གྲངས་དག་ལས་ཁམས་ལོ་བདེ་བླག་ཏུ་བརྩི་བའི་མན་ངག་འཕྲུལ་གྱི་ལྡེ་མིག་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "མ་ནོར་སོ་སོར་ངེས་བྱས་ནས། ། ཐོག་མར་སྤྱི་ལོའི་ལོ་གྲངས་ལས།",
    "ལོ་ཡི་འགྲོས་ཀྱང་རྟོགས་པར་འགྱུར།",
    "ལྕགས་སྤྲེལ་དེ་ནས་བརྩམ་པར་བྱ།",
    "ལོ་ཡི་འགྲོས་ཀྱང་རྟོགས་པར་འགྱུར།",
    "རྟོགས་པར་འདོད་ན་གཤམ་དུ་གསལ།",
    "སྐོར་མགོ་གང་ཡིན་ངེས་བྱས་ཏེ།",
    "ལོ་ཡི་འགྲོས་ཀྱང་རྟོགས་པར་འགྱུར།",
    "རིགས་འགྲེའི་རིག་མདས་བསྣུན་པར་བྱ།",
    "དེ་ནས་མི་རྣམས་ཀྱིས་རིམ་གྱིས་ཟླ་བའི་འཕེལ་འགྲིབ་ལ་ཉམས་རྟོགས་བྱས།",
    "དེ་ནས་རིམ་གྱིས་རང་བྱུང་ཁམས་ཀྱི་འགྱུར་ལྡོག་ལ་རྟོག་ཞིབ་བྱས་པར།",
    "རྩི་སྲོལ་ཡང་ཤིན་ཏུ་རགས་པ་མ་གཏོགས་མེད་པར་མངོན་ནོ།",
    "དེ་ནས་རིམ་གྱིས་སྤྱི་ལོའི་སྔོན་གྱི་དུས་རབས་བཅུ་དགུ་པར་སླེབས་དུས་པ་པི་ལོན་ཞེས་པའི་རྒྱལ་ཁབ་བཙུགས་པ་དང་།",
    "ཁྱད་པར་དུ་ཨེ་ཇིའི་རྒྱལ་རབས་གསུམ་པ་ནས་དྲུག་པའི་བར་སྟེ་སྤྱི་ལོའི་སྔོན་གྱི་དུས་རབས་༢༧ནས་༢༢བར་གྱི་དུས་ཡུན་ནང་གནམ་རིག་ཆེས་ཆེར་དར་ཡོད།",
    "སྐད་གྲགས་ཅན་གྱི་ཅིན་ཙི་མཆོད་རྟེན་བཞེངས་བསྐྲུན་བྱས་པ་དང་།",
