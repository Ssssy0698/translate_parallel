    "གནོད་སྦྱིན་སྲིན་པོ་དག་ཀྱང་ཕན་པར་བྱེད།",
    "བདེ་ལམ་བརྟེན་པའི་ཚེ་རིང་ཐོབ་པར་འགྱུར།",
    "འདོད་པ་རྣམས་ལ་ལོག་པར་སྤྱོད་སྤངས་པས།",
    "དེ་ཡི་མཁའ་ལ་གནས་འཆའ་རྟེན་པར་འགྱུར།",
    "རིགས་དང་མི་རིགས་རྣམ་པར་ཤེས་གྱུར་པས།",
    "མཁས་པ་རྣམས་ལ་ཤིན་ཏུ་དབེན་པར་འགྲོ།",
    "ལུས་ངག་ཡིད་ཀྱི་ལས་ཀྱང་ཤིན་ཏུ་གཙང་།",
    "བྱམས་པའི་རོ་བདེ་ཁྱད་པར་ཐོབ་པས་ན།",
    "སྟོན་དུས་གསལ་བར་དངས་པར་བྱ་བ་བཞིན།",
    "དེ་བས་བསྒྲུབ་པའི་གྲོགས་དང་ཕྲད་པར་འགྱུར།",
    "དེ་ཕྱིར་དེ་ནི་ཁྱད་པར་འགྲོ་བ་འཐོབ།",
    "ས་དང་མཐོ་རིས་ཆགས་པ་མེད་པར་འགྲོ།",
    "རང་རྒྱལ་ལ་སོགས་ཐོབ་པར་མ་གྱུར་པའང་།",
    "དེ་ཕྱིར་གཞན་དོན་ལེགས་པར་བརྩོན་པ་ཡིས།",
    "འདི་ལ་རིམ་གྲོ་གློད་པར་རིགས་པ་མིན།",
    "སྤང་འོས་ཆུང་ཡང་རྣམ་པར་སྤང་བར་གྱིས།",
    "སྐབས་ཀྱི་ཉེས་པས་ཤག་ཤིག་ཚུལ་མི་བཅང་།",
    "རིགས་པས་འཐོབ་པས་ཆོ་ག་བསམ་བྱས་ཤིང་།",
    "ཡེ་ཤེས་གཙང་མ་ལུས་ཀྱི་རང་བཞིན་ཏེ།",
    "མི་ཡི་ནང་ན་དེ་ནི་འཕགས་པར་འགྱུར།",
    "ཕན་ཞིང་དབེན་པ་གང་ཡང་མ་བྱས་ཤིང་།",
    "ཚུལ་གྱི་དམ་པ་བཟོད་པ་ཡིན་ཞེས་གསུངས།",
    "ཡེ་ཤེས་ཟླ་བ་བཞིན་དུ་སིམ་པར་བྱེད།",
    "འཇིག་རྟེན་གཞན་དུ་ཕན་དགེ་རྫོགས་པར་བསྒྲུབ།",
    "ཁྲོ་བ་ལོག་པ་རྣམ་པར་རྟོག་ལས་བྱུང་།",
    "བཟོད་པའི་རྣམ་པ་མཉམ་པར་གཞོག་པར་བྱེད།",
    "འཕགས་པས་རྟག་ཏུ་སྐབས་མེད་འཕགས་པར་བྱ།",
    "བཟོད་པའི་ཡང་དག་ཉིད་མཁྱེན་དེ་དག་གསུངས།",
    "བཟོད་པའི་མཆོག་ཏུ་དེ་ཡང་གསུངས་པ་མིན།",
    "མི་རྟག་སྡུག་བསྔལ་མི་གཙང་བདག་མེད་པ།",
    "དེ་ཕྱིར་གཞན་ལ་གནོད་པར་དགའོ་ཞེས།",
    "གཉིས་མེད་ལམ་ལ་སྤྱོད་པ་དེ་དག་གསུངས།",
    "དངོས་པོ་གང་ཡང་འཇིག་པར་འགྱུར་བ་མེད།",
    "དེས་ཀྱང་ཐུབ་རྒྱལ་ངེས་པར་འགྱུར་ཞེས་གསུངས།",
    "ལྷའམ་བདུད་རྣམས་ལས་ཀྱང་འཕགས་པར་འགྲོ།",
    "གཞན་དོན་ཁུར་ཆེན་སྐྱོ་བ་མེད་པར་འཁྱེར།",
    "ཡང་དག་བླངས་པ་དང་པོ་ཡིན་པར་བརྗོད།",
    "ཡང་དག་ལེན་པའི་མཆོག་ཅེས་ཐུབ་པས་གསུངས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པར་བསྒྲུབ་བྱ་ཞེས།",
    "བསྐལ་པ་དུ་མར་དེ་བཞིན་བསྒྲལ་བྱས་ཀྱང་།",
    "བརྩོན་འགྲུས་ཕུལ་བྱུང་ཤིན་ཏུ་རྣམ་པར་མཛེས།",
    "འཇུག་དང་གནས་དང་མཉམ་པར་བཞག་པ་ཡི།",
    "བསམ་གཏན་བཞི་པོར་མཉམ་པར་གཞོག་པ་དང་།",
    "བདག་མེད་ངེས་པར་རྟོགས་པའི་སེམས་ལྡན་དང་།",
    "ཐོས་པ་མང་པོས་ངོམ་པར་མི་འགྱུར་ཞིང་།",
    "རིགས་པར་འཇུག་ཅིང་དེ་ལ་རྟོག་པ་དང་།",
    "གཟུད་ཅིང་དགོད་པའི་ཁྱད་པར་འཕགས་པ་ཅན།",
    "བརྩོན་འགྲུས་ཆེ་ཡང་འདུས་བྱས་མེད་མི་ལྟུང་།",
    "མི་མིན་ཀུན་ཀྱང་དེ་ལ་ཕན་པར་དགའ།",
    "ཏིང་འཛིན་རྣམ་པ་ཀུན་ཀྱང་ཐོབ་པར་འགྱུར།",
    "ཉིན་མཚན་དུས་རྣམས་འབྲས་བུ་ཡོད་པར་ཟླ།",
    "མེ་ཏོག་ཨུཏྤལ་བཞིན་རྣམ་པར་འཕེལ།",
    "གྲགས་པ་ཡང་དང་བདེ་བ་ཐོབ་པར་འགྱུར།",
    "བསམ་གཏན་ཚུལ་ལ་བརྩོན་པར་བྱ།",
    "དགེ་ཕན་གྲོགས་དང་བརྟེན་བྱས་ཏེ།",
    "ཆེད་དུ་མ་བྱས་མདངས་དགའ་བའི།",
    "དྲང་པོའི་ལུས་ནི་བསྲང་བྱས་ཤིང་།",
    "ཤེས་པར་རབ་ཤེས་བྱ་བའི་དུས།",
    "བསམ་གཏན་བསྒྲུབ་ལ་བརྩོན་པར་བྱ།",
    "ཁྱད་པར་མ་ཐོབ་གཏོང་མི་བྱ།",
    "ཡིད་ཀྱི་བསམ་པ་བརྟན་པར་བྱ།",
    "ཞུམ་པར་གྱུར་ན་གཟེངས་ཡང་བསྟོད།",
    "རྒོད་པར་གང་ཚེ་གྱུར་པའི་ཡིད།",
    "ཞི་གནས་ཚུལ་གྱིས་བཟློག་པར་བྱ།",
    "དེ་ལ་ཆགས་པར་ཡོད་མི་བྱ།",
    "བརྩོན་འགྲུས་ལྷོད་པར་དེས་མི་བྱ།",
    "མཚན་མའི་རྣམ་པ་ཤེས་བྱས་ཤིང་།",
    "ཡིད་ནི་མཉམ་པར་གཞག་པའི་ཕྱིར།",
    "ལྕགས་ཀྱུས་བཟློག་པར་བྱ་བ་བཞིན།",
    "ལོག་པའི་ཕྱོགས་ལས་བཟློག་པར་བྱ།",
    "རྨི་ལམ་བཞིན་དུ་དོན་མེད་པར།",
    "ཡོན་ཏན་ཚོགས་ཀྱིས་བསྒྲུབ་བྱས་ཤིང་།",
    "བདག་འདོད་དོན་ལ་བརྩོན་པར་བྱ།",
    "བསམ་གཏན་གསུམ་པ་ཐོབ་པར་འགྱུར།",
    "བསམ་གཏན་བཞི་པ་འཐོབ་པར་འགྱུར།",
    "དེ་བཞིན་གཤེགས་པ་མང་བཞུགས་དང་།",
    "བརྩོན་འགྲུས་མཆོག་ནི་རྩོམ་པར་བྱེད།",
    "སྣོད་བཞིན་སྟོན་པར་བྱེད་པས་ན།",
    "ཡིད་ལ་ཁྱབ་པར་སིམ་བྱེད་པས།",
    "བསྒྲུབ་ཕྱིར་འཆི་མེད་སྟོན་པར་བྱེད།",
    "སྤྱོད་པ་རྣམ་པར་སྤྱོད་བྱེད་ཅིང་།",
    "ཁྱད་པར་ཕུན་སུམ་ཚོགས་ཐོབ་པས།",
    "ཁྱད་པར་གོང་ནས་གོང་བརྩོན་བྱ།",
    "དེ་ལས་བཟློག་པ་དམན་པར་འགྲོ།",
    "རྣམ་པར་རྒྱལ་བ་འདོད་རྣམས་ཀྱིས།"
  ]
}