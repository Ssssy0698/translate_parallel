    "དེ་ལྟ་བུའི་བློ་སྦྱོང་གི་གདམས་པ་ནི་ཇི་སྐད་དུ།",
    "རྡོ་རྗེའི་ཆ་ཤས་ཕྲ་མོས་ཀྱང་གསེར་ལ་སོགས་པའི་རིན་ཐང་ཆེན་པོ་ཅན་གྱི་རྒྱན་ལ་སྤྲས་ཤིང་དེ་དག་ཟིལ་གྱིས་གནོན་པ་དང་།",
    "རྡོ་རྗེའི་མིང་ཡང་མི་འདོར་ཞིང་དབུལ་བ་ཡང་ཟློག་པ་བཞིན་ཐེག་ཆེན་བློ་སྦྱོང་གི་གདམས་ངག་ཉམས་སུ་བླངས་ནས་དེའི་ལམ་བློ་སྦྱོང་ཐུན་བརྒྱད་མའི་སྔོན་གླེང་ཡོངས་རྫོགས་རྒྱུད་ལ་སྐྱེས་ན་རང་གཞན་གྱི་འདོད་དོན་ཐམས་ཅད་འགྲུབ་པ་ལྟ་ཅི་སྨོས།",
    "འགྲོ་བའི་ཉོན་མོངས་གདུང་སེལ་བའི།",
    "ངུར་སྨྲིག་གི་རྒྱལ་མཚན་ཐོགས་བཞིན་ཆང་དང་བུད་མེད་ལ་ཁྱི་ཡིས་ཤ་བཞིན་སྤྱོད།",
    "རབ་བྱུང་གིས་ཁྱིམ་སྐྱོང་ཞིང་བུ་ཚ་མིང་སྲིང་དགའ་ཉེ་བློ་རག་རྡོ་བློ་བཟང་བསྟན་འཛིན་གྱི་དཔྱད་རྩོམ་ཐོར་བུ།",
    "ཞིང་འདེབས་ཕྱུག་སྐྱོང་སོགས་ཀྱི་ལམ་སྟོན་ཅིང་རང་གིས་ཀྱང་ཤ་ཐང་ཐང་དུ་བྱེད།",
    "སྡུག་བསྔལ་དང་རྐྱེན་ངན་གང་གིས་ཀྱང་གཡོ་བར་བློ་སྦྱོང་ཐུན་བརྒྱད་མའི་སྔོན་གླེང་།",
    "གང་གིས་བསྐལ་བ་བྱེ་བ་བརྒྱ་རྣམས་སུ།",
    "མན་ངག་འདི་ལ་བརྟེན་ནས་རྒྱལ་བའི་བཀའ་དང་དགོངས་འགྲེལ་ཆེན་མོ་རྣམས་ལ་ངེས་པ་ལྷག་པར་འདྲེན་ཅིང་གདམས་ངག་ཏུ་འཆར་ནུས་པ་ཡིན་ནོ།",
    "དེས་ཇོ་བོ་ལ་དགྱེས་བཞིན་གནང་ནས་ཟབ་མོ་ལྟ་རྒྱུད་ཀྱི་གདམས་པའི་བཀའ་བབས།",
    "གཞན་ཡང་རང་གི་སྐུ་ཤ་བཅད་དེ་གཞན་ལ་སྟེར་བའི་སེམས་དཔའ་ཆེན་པོ་དྷརྨརཀྵི་ཏ་དང་།",
    "ཐུན་མོང་མ་ཡིན་སེམས་བསྐྱེད་སྦྱིན་མཛད་པའི།",
    "ཟབ་མོ་ལྟ་བརྒྱུད།",
    "༣ ལུས་གྲངས་མེད་དུ་སྤྲུལ་ནས་རིགས་དྲུག་གི་སྡུག་བསྔལ་དང་ལེན་བྱེད་པ།",
    "ཐ་ན་རྒྱུན་དུ་རང་གི་སྲོག་འཚོ་བའི་ཐབས་ཟས་ལ་ཟ་བ་དང་།",
    "ང་རེས་འགའ་ཟ་ཞིང་ཟ་ཞིང་སྒོམ།",
    "བཟའ་བཏུང་ཚོགས་འཁོར་དུ་ཤེས་པའི་གདམས་ངག་ཡོད།",
    "གཞན་གྱི་ནོར་བགྲང་བ་ལྟར་མ་སོང་བར་རྒྱུད་ལ་བཀལ་ནས་མྱོང་བ་ཐོན་པར་བསྒོམ།",
    "བློ་སྦྱོང་གི་ཚད་དང་།",
    "ཕྱོགས་ཐ་དད་ནས་མཇལ་མི་བྱུང་བ་ན་ཁོང་གིས།",
    "ཁྱོད་ཀྱི་ཡུལ་ལ་མི་རྒན་མེད་དམ་གསུངས་པས།",
    "རེག་ཐམས་ཅད་དོན་ལྡན་དུ་འགྱུར་ངེས་ཀྱི་སྐྱེས་བུ་ཆེན་པོ་དེ་ཉིད་དགུང་གྲངས་གོ་གཅིག་བར་སྒྲུབ་པའི་རྒྱལ་མཚན་བཙུགས་ཏེ་ཤིང་ལུག་ལོར་རྟ་ཟླའི་ཚེས་བཅུ་བཞིར་ཞིང་ཁམས་གཞན་གྱི་གདུལ་བྱའི་དོན་དུ་གཤེགས།",
    "མཛད་པ་ཀུན་ལས་གསུང་གི་མཛད་པ་མཆོག་ཏུ་བསྔགས་པ་བཞིན་དོན་ལ་གནས་པ་ལགས་སོ།",
    "ཐུབ་བསྟན་ཉི་མ་ནུབ་རིའི་རྩེ་མོར་འཛེགས།",
    "ཡང་དག་ལྟ་སྤྱོད་མིག་གི་འདབ་བརྒྱ་ཟུམ།",
    "སྙིགས་དུས་འགྲོ་བའི་ཉོན་མོངས་མི་གཙང་ལུད།",
    "བྱང་ཆེན་སྤྱོད་པའི་ཞིང་གི་བཅུད་གྱུར་ནས།",
    "ནམོགུརུཝགེཤྭརཡ།",
    "གྲངས་མེད་ཞིང་དུ་རྟེན་འབྱུང་ཟབ་མོའི་གཏམ།",
    "དེ་ལྟར་མོད་ཀྱང་སྣ་ཚོགས་འབྲས་བུ་ཀུན།",
    "ཕྱུགས་ལས་ལྷག་པའི་རྟེན་ཞིག་བརྙེད་པའི་དུས་འདིར་རང་གི་བླང་དོར་བྱ་བའི་གནས་ལ་ཕན་དང་མི་ཕན་རྣམ་པར་དཔྱོད་ཅིང་འཇུག་ལྡོག་བྱ་དགོས་པ་ལས་མ་དཔྱད་པར་འཇུག་པ་ནི་ལས་སུ་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་ཡུལ་ཅན་བློའི་གནས་ཚུལ་ཤེས་པ་ཤིན་ཏུ་གལ་ཆེ་བ་ཡིན་ཏེ།",
    "ཅེས་གསུངས་པ་བཞིན་ཡིན་པས་རྣམ་དཔྱོད་ལྡན་པ་དག་གིས་འཁོར་འདས་ཀྱི་གནས་ལུས་ལོངས་སྤྱོད་ཐམས་ཅད་ནང་སེམས་ཀྱི་ཐོག་ནས་ཡུལ་དང་ཡུལ་ཅན་གྱི་བག་ཆགས་སད་ནས་གྲུབ་པས་ན་འདི་དག་སེམས་ཀྱི་རང་བཞིན་ཡིན་པར་རྟོགས་པ་དང་།",
    "རང་གིས་རྟོགས་པ་བཞིན་ཉན་པ་པོ་བློ་གྲོས་གསལ་བ་དག་ལ་ཡིད་ཆེས་པའི་ལུང་དང་།",
    "སེམས་ནི་གཡོ་ཞིང་འཁྱོག་པ་དང་།",
    "མདའ་མཁན་མདའ་མོ་བྱེད་པ་བཞིན།",
    "དེ་དག་གི་བྱེད་ལས་རྣམས་མ་འདྲེས་པ་སོ་སོར་འབྱེད་ཤེས་པ་དགོས་ཤིང་།",
    "དེང་སང་གི་སེམས་ཁམས་སྨྲ་བ་རྣམས་ལ་ཆེས་མང་མོད།",
    "བློ་སོ་སོའི་ངོ་བོ་དང་བྱེད་ལས་ཐུན་མོང་མ་ཡིན་པ་དང་།",
    "རང་གི་སྣང་བ་ལ་མངོན་སུམ་ཉིད་དུ་གྲུབ་པ་ན་གསལ་བ་ཞེས་བྱ་སྟེ།",
    "གཟུགས་ཅན་གཞན་གྱིས་གོ་ས་མི་འགགས་ཤིང་ཐོགས་རེག་དང་བྲལ་བ་དང་།",
    "རང་གི་ངོ་བོར་ཆགས་སོགས་ཉེས་སྐྱོན་གྱི་རྡུལ་གྱིས་མ་གོས་ཤིང་།",
    "དེ་ལ་རང་གི་མངོན་འདོད་སྒྲུབ་པ་ལ།",
    "ཕྱོགས་གླང་གིས།",
    "ཁྱོད་ཀྱི་ཞབས་ཀྱི་པད་མོ་རྣམ་མཛེས་ཤིང་།",
    "འདི་དག་གིས་ཡོངས་སུ་བཅད་དེ་འཇུག་པ་ན་བྱ་བ་ལ་བསླུ་བ་མེད་པའི་ཕྱིར་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "བསམ་བྱུང་གིས་དྲངས་པ་དང་།",
    "རང་གི་ངོ་བོའི་སྒོ་ནས་དབྱེ་ན་ཡིད་ཆེས་རྗེས་དཔག་དངོས་སྟོབས་རྗེས་དཔག་གྲགས་པའི་རྗེས་དཔག་དང་གསུམ་མོ།",
    "རང་གི་རྟེན་དུ་གྱུར་པའི་ཡིད་ཆེས་ཀྱི་རྟགས་ཡང་དག་ལ་བརྟེན་ནས་རང་གི་གཞལ་བྱ་ཤིན་ཏུ་ལྐོག་གྱུར་ལ་མི་བསླུ་བའི་ཞེན་རིག་ཡིད་ཆེས་རྗེས་དཔག་གི་མཚན་ཉིད།",
    "ཞེས་པ་ལྟ་བུ་དཔྱད་གསུམ་དག་པའི་ལུང་གི་རྟགས་ལ་བརྟེན་ནས་རང་གིས་བསྟན་བྱའི་དོན་ལ་མི་བསླུ་བར་རྟོགས་པའི་རྗེས་དཔག་ལྟ་བུ།",
    "རང་གི་རྟེན་དུ་གྱུར་བའི་དངོས་སྟོབས་ཀྱི་རྟགས་ཡང་དག་ལ་བརྟེན་ནས་སྐྱེས་པའི་རང་གི་གཞལ་བྱ་ཅུང་ཟད་ལྐོག་གྱུར་ལ་མི་བསླུ་བའི་ཞེན་རིག་དངོས་སྟོབས་རྗེས་དཔག་གི་མཚན་ཉིད།",
    "རང་གི་རྟེན་དུ་གྱུར་པའི་རྟགས་ཡང་དག་ལ་བརྟེན་ནས་སྐྱེས་ཡུལ་ཅན་སེམས་ཀྱི་རྣམ་བཞག་པའི་རང་གི་གཞལ་བྱ་སྒྲ་བྱུང་གྲགས་པ་ལ་མི་བསླུ་བའི་ཞེན་རིག་གྲགས་པའི་རྗེས་དཔག་གི་མཚན་ཉིད།",
    "དེ་དག་གི་མཚན་ཉིད་དང་དབྱེ་བ་ཤེས་བྱེད་ཀྱི་རིགས་པ་ཤིན་ཏུ་མང་བས་རེ་ཞིག་འཇོག་གོ།",
    "རང་གི་སྣང་ཡུལ་ལ་མ་འཁྲུལ་བའི་རིག་པ་མ་འཁྲུལ་བའི་ཤེས་པའི་མཚན་ཉིད་དང་།",
    "རང་གི་སྣང་ཡུལ་ལ་འཁྲུལ་བ་འཁྲུལ་ཤེས་ཀྱི་མཚན་ཉིད།",
    "ཐུན་མོང་མིན་པའི་རྒྱུ་ཡི་ཕྱིར།",
    "དེ་ཕྱིར་ཉོན་མོངས་ཐམས་ཅད་ཀྱང་།",
    "དེའང་ལུང་འདི་ནི་ཆགས་སོགས་ཉོན་མོངས་ཐམས་ཅད་གཟུགས་སོགས་ཀྱི་ཡུལ་དང་ཚུལ་མིན་ཡིད་བྱེད་ལས་སོ་སོར་སྐྱེ་མོད་ཀྱང་།",
    "དེ་དག་གི་དྲངས་པའི་ལུས་སེམས་ཤིན་སྦྱངས་ཀྱི་བདེ་བ་དང་།",
    "རང་གིས་ཤེས་པ་རྣམས་མཐའ་གཅིག་འཛིན་དོར་པའི་རྣམ་དཔྱོད་དང་།",
    "དེ་དག་གི་དཔྱད་དོན་རིམ་བཞིན་ཡར་རྒྱས་སུ་ཕྱིན་ནས་མཐར་ཡུལ་ཅན་བློའི་རྣམ་བཞག་གམ་གནས་ལུགས་ཀྱང་རིམ་བཞིན་རྟོགས་ཐུབ་རྒྱུར་གདོན་མི་ཟ་བ་ཡིན་ནོ།",
    "རང་གི་ཐུན་མོང་མིན་པའི་བདག་རྐྱེན་དང་།",
    "དེ་ལྟར་ཤེས་པ་དག་སྐྱེ་བ་ལ་ཐུན་མོང་དང་ཐུན་མོང་མིན་པའི་བདག་རྐྱེན་གཉིས་རེ་ཡོད་དེ།",
    "ཞེས་པ་ལྟར་ཐུན་མོང་པའི་རྒྱུ་ཡི་དྭགས་ཀྱིས་ཆུ་ཀླུང་རྣག་ཁྲག་ཏུ་སྣང་བ་སོགས་ཉོན་མོངས་ཀྱི་རྐྱེན་སོགས་སྣ་ཚོགས་པར་སྣང་ཞིང་།",
    "དེ་དག་གི་ཡུལ།",
    "དེ་ཡང་སེམས་གསལ་རིག་གི་ངོ་བོར་སྐྱེ་བར་གཙོ་སེམས་ཀྱི་འཁོར་དུ་མ་མཐའ་སེམས་བྱུང་ཀུན་འགྲོ་ལྔ་ངེས་པར་དུ་ཚང་དགོས་ཤིང་དེ་དག་ལས་གཅིག་མ་ཚོགས་ཀྱང་གསལ་རིག་གི་ངོ་བོར་མི་འགྲུབ་ཅིང་།",
    "དེའི་ཐོག་སེམས་ཇི་ཙམ་རྒྱ་ཆེ་རུ་སོང་བ་བཞིན་སེམས་བྱུང་ཡང་མང་དུ་ཕྱིན་ཏེ་དཔེར་ན་མ་རིག་པ་སོགས་ཉོན་མོངས་ཀྱི་སེམས་དང་།",
    "དད་པ་དང་བརྩོན་འགྲུས་སོགས་དགེ་སེམས་གང་ཡང་ཚོར་བ་དང་།",
    "རེག་པ་དང་།",
    "དེ་ལ་སྤྱིར་ཐ་མལ་བའི་འགྲོ་བ་རྣམས་ལ་ཁྲོམས་ཚོགས་ལ་ལྟ་བའི་མིག་ཤེས་བཞིན་དུ་ཤེས་པ་ཕྲ་རགས་དུ་མ་ཞིག་རིམ་དང་ཅིག་ཅར་སྣ་ཚོགས་པར་སྐྱེ་ཡུལ་ཅན་སེམས་ཀྱི་རྣམ་བཞག་བ་བརྗོད་ཀྱིས་མི་ལོང་པའི་ཕྱིར་བྱེ་བྲག་འདི་དང་འདི་འདྲ་སྐྱེའོ་ཞེས་རྟོགས་ཤིང་སྨྲ་བར་མི་ནུས་མོད།",
    "འོན་ཀྱང་ལུས་ངག་གི་ལས་དངོས་སུ་བསྐུལ་བའི་ཤེས་པ་རགས་པ་དུ་མ་སྐྱེ་བ་ནི་དངོས་སུ་གྲུབ་པའི་ཕྱིར་ཤེས་པ་མེད་པར་འཛིན་པ་ནི་མངོན་སུམ་ལ་བསྙོན་པས་ན་ཤེས་པ་ཡོད་པར་སྒྲུབ་མི་དགོས་ཀྱང་ཤེས་པ་སྐྱེ་ཚུལ་ལ་འདོད་ཚུལ་འགའ་ཞིག་སྣང་སྟེ།",
    "རྩིག་པ་ལ་བྲིས་པའི་རི་མོ་དང་།",
    "འདིར་ཡིད་ཤེས་སྐྱེ་ཚུལ་ལ་ཀུན་ནས་ཉོན་མོངས་པའི་ཕྱོགས་དང་།",
    "ཉོན་མོངས་པ་སྐྱེ་བའི་རྒྱུ་ནི།",
    "ཉོན་མོངས་པ་བག་ལ་ཉལ་རྒྱུན་དུ་གནས་པ་ཉོན་མོངས་སྐྱེ་བའི་རྟེན།",
    "ཉོན་མོངས་གང་དུ་ཡུལ་ཅན་སེམས་ཀྱི་རྣམ་བཞག་སྐྱེ་བ་དང་མཐུན་པའི་ཡུལ་གྱི་སྣང་བ་འཆར་བ་ཉོན་མོངས་པའི་དམིགས་པ།",
    "ཉོན་མོངས་པ་འདྲིས་པའི་སྟོབས་སྐྱེད་པ་གོམས་པ།",
    "སྡུག་མི་སྡུག་གི་མཚན་མ་སྒྲོ་འདོག་པ་དང་།",
    "གཙང་བདེ་བདག་རྟག་སོགས་ཚུལ་བཞིན་མིན་པ་ཡིད་ལ་བྱེད་པ་དང་དྲུག་ལས་ཉོན་མོངས་པ་རྣམས་སྐྱེ་བར་བྱེད་དོ།",
    "ཉོན་མོངས་རྒྱུ་ནི་ཚང་བ་ཡིན།",
    "འདི་དག་དཔེ་མཚོན་ཙམ་མོ།",
    "སེལ་འཇུག་གི་སྒྲ་དང་།",
    "སེལ་འཇུག་གི་བློ་དང་རྟོག་པ་དོན་གཅིག་དེ་ལའང་བློ་དོན་མཐུན་དང་།",
    "མིང་དོན་སྦྱར་བ་ལ་མིང་བརྡ་སྦྱར་བ་ཟེར་མོད།",
    "ཤར་ནུབ་དང་ཕྱི་ནང་སོགས་རང་གི་གོ་ས་མནན་ནས་ཡོད་པ་དང་།",
    "ཡུལ་ཅན་གྱི་གཙོ་བོ་སེམས་ཡིན་པས་འདི་ཡང་སེམས་བྱུང་ཚོར་བ་དང་།",
    "འདུ་ཤེས་སེམས་པ་རེག་པ་ཡིད་ལ་བྱེད་པ་ལྔ་པོ་ཚོགས་ན་བྱུང་ཞིང་།",
    "དེ་དག་སོ་སོའི་བྱེད་ལས་ཐུན་མོང་མིན་པ་རྣམས་བྱེད་པ་ལས་རང་གི་ངོ་བོར་གནས་པ་དང་།",
    "དེ་རྣམས་རྣམ་པར་འགྱུར་བ་ལས་རྫས་དེའི་ངོ་བོའང་གཞན་དུ་འགྱུར་བ་བཞིན་དུ་སེམས་ཇི་ཙམ་ཞིབ་ཀྱང་ཚོར་བ་སོགས་ཀུན་འགྲོ་ལྔས་བྱེད་ལས་སོ་སོར་བྱེད་པ་ལས་སེམས་རང་གི་ངོ་བོ་གསལ་རིག་གི་རྣམ་པར་གནས་ལ།",
    "དེས་ན་སེམས་ཡུལ་ལ་འཇུག་པའང་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "རྣམ་བྱང་གི་ཕྱོགས་གཉིས་སུ་འགྱུར་ཞིང་།",
    "གླུད་ནུབ་སྒོར་གཏོང་བ་དོན་རེ་ཆུང་།",
    "༡སེམས་སེམས་བྱུང་གི་ཁྱད་པར།",
    "དེའང་སེམས་དང་སེམས་བྱུང་གི་ཁྱད་པར་ནི།",
