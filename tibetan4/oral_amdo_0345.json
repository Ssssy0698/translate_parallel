    "སྣག་ཚའི་རྒྱུ་སྒྲོན་དྲེག་གི་ཐོན་ཁུངས་ནི།",
    "ཤིང་གི་ཡི་གེ་དང་པར་ཡིག་ཞུས་དག་སྐབས་སྤྱོད་རྒྱུའི་གཟུགས་མཐོང་ཤེལ་སྒོ་བཅས་དགོས་ཀྱི་ཡོད།",
    "རྒྱུ་ཆ་དེ་དག་མང་ཉུང་ཇི་ཙམ་དགོས་པའི་སྐོར་གཤམ་གསལ་གྱི་རེའུ་མིག་ལ་གཟིགས།",
    "བཟའ་བྱའི་རྩམ་པ་རྩམ་པ་ཁལ་གཉིས་ཪེཪ་འབྲུ་ཁལ་གསུམ་རེ་རྩིས་བཅས་ཁག་བཞི་ལ་འབྲུ་ཁལ་ལྔ་འབུམ་དྲུག་ཁྲི་བཞི་སྟོང་ཉིས་བརྒྱ་བདུན་ཅུ་དོན་གསུམ་དང་བྲེ་བཅུ་གཅིག་ཕུལ་བཞི་ཁྱོར་བ་གཉིས་ལྷག་ཙམ་སོང་བ་དེང་སང་གི་རྒྱ་མར་ཕབ་ན་རྒྱ་མ་བྱེ་བ་གཅིག་དང་ས་ཡ་ལྔ་བདུན་འབུམ་དགུ་ཁྲི་དགུ་སྟོང་དྲུག་བརྒྱ་དྲུག་ཅུ་ཐམ་པ་དང་སྲང་བཞི་ཞོ་དྲུག་ཡིན་པསདེང་སང་ལྷ་སར་འབྲུ་ཁལ་རེར་མི་དམངས་ཤོག་སྒོར་བཅུ་བཞི་རེ་བྱེད་པའི་ཡུལ་ཐང་དུ་བརྩིས་ན་སྒོར་ས་ཡ་བདུན་དང་བརྒྱད་འབུམ་དགུ་ཁྲི་དགུ་སྟོང་བརྒྱད་བརྒྱ་སུམ་ཅུ་ཐམ་པ་དང་སྒོར་ཟུར་གཉིས་སྐར་དྲུག་ཙམ་ཐོབ།",
    "མཪ་ཁལ་ཉིས་སྟོང་དགུ་བརྒྱ་དྲུག་ཅུ་རེ་གཉིས་སོང་བ་དེང་སང་མར་ཁལ་རེཪ་རྒྱ་མ་བདུན་རེ་བརྩིས་པ་ལྟར་ན།",
    "མར་རྒྱ་མ་ཉིས་ཁྲི་སྟོང་མེད་བདུན་བརྒྱ་སུམ་ཅུ་སོ་བཞི་ལ་དེང་སྐབས་ལྷ་སར་མར་རྒྱ་མ་རེར་མི་དམངས་ཤོག་སྒོར་བདུན་རེ་བྱེད་པའི་ཡུལ་ཐང་ལྟར་བརྩིས་པས་སྒོར་ཆིག་འབུམ་བཞི་ཁྲི་ལྔ་སྟོང་བརྒྱ་དང་སུམ་ཅུ་སོ་བརྒྱད་ཐོབ།",
    "དཀར་ཆག་གི་ནང་རགས་བསྡུས་ཙམ་ལས་ཞིབ་ཆ་མི་གསལ་ཡང་ཤོག་བུ་དང་།",
    "ལས་རིགས་ཁག་གི་མི་ཚང་མར་ལྟོ་ཆས་ནར་གཏོང་དང་།",
    "འཛུགས་སྒང་གྲོལ་གསུམ་གྱི་སྟོན་མོ།",
    "དེ་འབྲུ་ལ་ཕབ་ན་འབྲུ་ཁལ་ཆིག་སྟོང་བཞི་བརྒྱ་བརྒྱད་ཅུ་རེ་ཐོབ་ཀྱི་ཡོད།",
    "འཛུགས་སྒང་གྲོལ་གསུམ་གྱི་སྟོན་མོ།",
    "དེ་དེང་སང་གི་རྒྱ་མར་ཕབ་ན་རྒྱ་མ་བྱེ་བ་བཞི་དང་ས་ཡ་མེད་བརྒྱད་འབུམ་ཁྲི་མེད་སུམ་སྟོང་ཡིན།",
    "༢༢༢༣པར་ཤིང་བཅུ་དྲུག་རེར་རིན་འབྲུ་ཁལ་ལྔ་རེ་ནས་ཁལ།",
    "༣༡༢༣༡༦༨ ༤ནར་གཏོང་འཚོ་ཆས་སུ་སོང་བ།",
    "དེའི་རིན་ཐང་ཐད་དེང་སང་ལྷ་སར་འབྲུ་ཁལ་རེཪ་སྒོར་བཅུ་བཞི་རེ་བྱེད་པའི་ཐང་གཞིར་བརྩིས་ན་སྒོར་ས་ཡ་དྲུག་དང་ཉིས་འབུམ་ཁྲི་མེད་དྲུག་སྟོང་དྲུག་བརྒྱ་བཞི་བཅུ་ཞེ་བརྒྱད་ཡིན་ཞིང་།",
    "མི་དམངས་ཤོག་སྒོར་ལ་བརྩིས་ན་པོད་རེར་མ་གནས་སྒོར་ཉིས་ཁྲི་དགུ་སྟོང་བརྒྱ་དང་སུམ་ཅུ་སོ་དགུ་དང་སྒོར་ཟུར་གཅིག་སྐར་དགུ་ཡིན།",
    "པར་ཁང་གི་སྒྲིག་སྲོལ་ལམ་ལུགས་སྐོར།",
    "དེང་སང་གི་དུས་སྐབས་གང་ཡིན་རུང་པར་གཞི་གསར་སྐྲུན་གྱི་མ་གནས་ནི་ཧ་ཅང་མཐོ་པོ་ཡིན་པས།",
    "པར་ཁང་དོ་དམ་པར་གླ་མང་བ་སྤྲོད་ལེན་གྱི་རིགས་བྱེད་མི་ཆོག་འོན་ཀྱང་དོ་དམ་པར་ལོ་གཅིག་གི་འཚོ་བ་ལྡང་ངེས་ཀྱི་འབྲུ་དངུལ་ཤ་མར་སོགས་ཕོགས་ཐོབ་ཟུར་དུ་སྤྲོད་ཀྱི་ཡོད།",
    "དེང་སྐབས་ཀྱི་རང་འགུལ་འཕྲུལ་པར་ནི་པར་གཞི་སྒྲིག་སྦྱོར་ཐེངས་གཅིག་གིས་དཔེ་དེབ་ཆ་ཚང་ཁྲི་ཁ་ཤས་པར་འདེབས་བྱེད་ཆོག་གི་ཡོད་པས་པར་གྲངས་ཇི་ཙམ་མང་བ་དེ་ཙམ་གྱིས་མ་གནས་ཆུང་ཞིང་།",
    "པར་འདེབས་མ་བྱས་གོང་སྔོན་ཚུད་ནས་འབྲེལ་ཡོད་ཚན་པ་དང་སྒེར་ཁག་ལ་དྲིལ་བསྒྲགས་བྱས་ཏེ་གདེང་ཚོད་ཡོད་པའི་གྲངས་ཀ་ངེས་ཅན་ཞིག་བྱུང་མཚམས་གཞི་ནས་པར་འདེབས་བྱེད་དགོས་ཀྱི་ཡོད་པ་རེད།",
    "སྐབས་འདིར་པར་ཁང་ཆེ་བ་ཁག་གི་སྒྲིག་སྲོལ་ལམ་ལུགས་ངོ་སྤྲོད་ཞུ་ཐུབ་ན་བསམ་རུང་།",
    "བོད་ཀྱི་ལྗིད་ཚད་སྲང་གང་ལ་དེང་སང་གི་ལྗིད་ཚད་སྲང་མེད་ཆ་ཤས་བརྒྱད་དང་ཡང་ཆ་བདུན་ཅུ་དོན་ལྔ་ཡོད།",
    "རྒྱ་སྐྱེགས་རྒྱ་མ་གསུམ་བོད་ཀྱི་ཤོང་ཚད་རྒྱ་མ་གང་ལ་དེང་སང་གི་ཤོང་ཚད་རྒྱ་མ་དོ་དང་སྲང་ལྔ་ཡོད་བཅས་ཡིན།",
    "དེང་སྐབས་ལྷ་སར་འབྲུ་ཁལ་རེར་སྒོར་བཅུ་བཞི་རེ་བྱེད་པའི་ཡུལ་ཐང་ལྟར་བརྩིས་ན་སྒོར་བཞི་ཁྲི་བཞི་སྟོང་བདུན་བརྒྱ་ལྔ་བཅུ་ང་བཞི་དང་སྒོར་ཟུར་ལྔ་ཡིན་པས།",
    "བཟའ་ཚས་དངོས་ཟོག་བཅས་ཀྱི་རིན་ཐང་ལོ་རེ་བཞིན་ལྡབ་འཕར་འགྲོ་བ་དང་།",
    "སྣག་ཤོག་གི་རིན་བཅས་ལ་ཤ་ཁུ་རང་ཐིམ་ལྟར་གཙང་དག་གིས་གཏོང་ཡོང་འགོ་ཐུག་ཙམ་ལས་ཁེ་བཟང་གང་ཡང་མེད་ཚོད་རེད།",
    "འབྱུང་འགྱུར་ད་དུང་ལོ་ངོ་བཅུ་ལྷག་པར་འདེབས་མུ་མཐུད་བྱེད་ཐུབ་པའི་གདེང་ཚོད་ཡོད་པ་དེར་བརྟག་ན།",
    "ལོ་རེར་པར་འདེབས་བྱ་རྒྱུའི་གྲངས་ཚད་དེ་ལོ་རེའི་དགོས་མཁོ་དང་བསྟུན་ནས་ཚོད་འཛིན་བྱེད་བདེ་བ།",
    "༣པར་ཤིང་ཐོག་པར་འདེབས་བྱེད་ཐུབ་པའི་ནུས་པ་དེ་ལོ་ཉིས་བརྒྱ་ལྷག་ཙམ་བར་རྒྱུན་འཁྱོངས་བྱེད་ཐུབ་པ།",
    "དེང་སྐབས་བོད་ཡིག་གི་དེབ་གཟུགས་དཔེ་སྐྲུན་གྱི་མགྱོགས་ཚད་ལེགས་པོ་དེ་དང་།",
    "དེབ་གཟུགས་དཔེ་སྐྲུན་གྱི་སྤུས་ཚད་ཞན་པའི་གནས་ཚུལ་ལེགས་བཅོས་ཡོང་རྒྱུར་སྐུལ་མ་གཏོང་ཐུབ་ཀྱི་རེད།",
    "རྒྱ་གཟིགས་པ་པོ་རྣམས་ཀྱིས་ང་ཚོའི་ནོར་འཁྲུལ་གྱི་རིགས་ལ་སྐྱོན་བརྗོད་དང་སླད་ཀྱི་ལས་དོན་ཐད་རིན་ཐང་བྲལ་བའི་དགོངས་འཆར་ཐད་ཀའམ།",
    "དེ་མིན་ཡིག་ཐོག་གང་རུང་གིས་ལྷུག་པོར་གནང་སྐྱོང་ཡོད་པ་ཞུ་རྒྱུ།",
    "༣ རྡོ་རིང་འདི་དག་བཙུགས་པ་ནས་བཟུང་ད་བར་ལོ་ཆིག་སྟོང་ཉིས་བརྒྱ་ལྷག་ཙམ་སོང་ཡོད་ཀྱང་དེང་སང་བོད་ཡིག་གི་ཆུ་ཚད་ངེས་ཅན་ཡོད་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "གཅིག་རྡོ་རིང་ཡི་གེའི་ནང་གི་གཉིས་པ་དང་།",
    "༣རྒྱ་བཟའ་འུན་ཁྲིན་ཀོང་ཇོ་དང་ཅིན་ཁྲིན་ཀོང་ཇོ་བོད་དུ་རྒྱལ་པོའི་བཙུན་མོར་བརྫངས་པའི་ལོ་གསལ་པོར་འཁོད་པ།",
    "༣བློན་པོ་འབལ་ལྡོང་ཚབ་དང་ལང་མེས་གཟིགས་གཉིས་ཀྱིས་རྒྱལ་པོ་ཁྲི་ལྡེ་གཙུག་བཙན་བཀྲོངས་པ་དང་།",
    "རྩིས་བྱས་པའི་གནས་ཚུལ་བློན་པོ་སྟག་སྒྲ་ཀླུ་གོང་གིས་ཤེས་ནས་རྒྱལ་པོ་ལ་ཞུས་རྗེས་བློན་པོ་གཉིས་སྲོག་ཐོག་ཏུ་བཏང་བ།",
    "༤བློན་པོ་སྟག་སྒྲ་ཀླུ་གོང་གིས་དམག་དཔོན་བྱས་ཏེ་ཐང་རྒྱལ་རབས་ཀྱི་མངའ་ཁོངས་སུ་དམག་དྲངས་པ་དང་།",
    "ཁོང་གི་གཅེན་པོ་ནི་མུ་རུག་བཙན་པོ་ཡིན་པ་དང་།",
    "ཁོང་གི་ཡབ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་དུས་སུ་བྲག་དམར་གྱི་བསམ་ཡས་གཙུག་ལག་ཁང་བཞེངས་པ།",
    "སྲས་མོ་གསུམ་ཡོད་རྡོ་རྗེ་སྐྱིད།",
    "ཚོགས་དྲུག་གི་སྐོར།",
    "དགུང་ལོ་ཉེར་བཞི་ས་ལུག་གི་ལོ་ལ་འོན་བཀྲ་ཤིས་དོ་ཁར་རྗེ་ཙོང་ཁ་པ་མཇལ་བར་བྱོན་ཏེ་བཀའ་གདམས་ལམ་རིམ་དང་།",
    "རྔོག་གི་གདུང་རྒྱུད་ཐུབ་པ་དཔལ་བ།",
    "གསུང་རྩོམ་ཁྱོན་པོད་བཅུ་ཙམ་ཡོད་པ་ལས་གྲགས་ཆེ་བ་ནི།",
    "དུས་འཁོར་རྒྱུད་འགྲེལ་ཆེན་མོ་དགུང་ལོ་ང་གཅིག་པ་ཆུ་ཁྱི་ལོར་བརྩམས།",
    "དེབ་ཐེར་འདི་མཛད་ནས་ལོ་ངོ་བཞི་སོང་བ་རབ་བྱུང་བརྒྱད་པའི་ལྕགས་གླང་།",
    "མང་ཆེ་བ་མ་ཉམས་པར་བསྡད་ཡོད་པ་རེད།",
    "བཙན་མེད་པའི་རིགས་རྣམས་གཞན་གྱི་ཟེར་ཚོད་ཙམ་བྲིས་པ་མ་གཏོགས་རིགས་པས་བསྒྲུབ་ཐུབ་པ་མི་སྣང་ཞེས་གསལ་བར་གསུང་ཡོད་པ་བཅས་རེད།",
    "ང་ཚོས་ངེས་པར་དུ་ཤེས་དགོས་པ་ནི།",
    "སྐབས་དེར་འགོས་ལོ་རང་ཉིད་ཀྱིས་གཟིགས་མྱོང་བའི་དེབ་ཐེར་དམར་པོ་དཔེ་མ་དག་པ་ཞིག་གི་མཆན་བུ་ཡིན་པ་ལས།",
    "བསྟན་པ་བསྣུབས་པའི་ལྕགས་བྱ་༩༡ནས་ལོ་བདུན་ཅུ་རྩ་བདུན་པ་འདི་མེ་མོ་གླང་གི་ལོ་༩༧༧ཡིན།",
    "ལོ་དེ་དག་གི་ཁོངས་སུ་དབུས་གཙང་མི་དྲུག་གིས་རབ་ཏུ་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "ཞེས་གསལ་བར་གསུངས་པ་རྣམས་ཞིབ་བསྡུར་གྱིས་ཡར་སློག་གི་རྩིས་བྱས་ཚེ་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོའི་འཁྲུངས་ལོའི་ཐད་འགོས་ལོ་རང་ཉིད་ཀྱི་བཞེད་པར་རང་ཚིག་སྔ་ཕྱི་འགལ་བའི་སྐྱོན་ནམ་ཡང་མི་འཇུག་པས།",
    "དགུང་ལོ་བཅུ་དྲུག་གི་སྐབས་སུ་ལྷ་སར་ཕེབས་ཏེ་དགུང་ལོ་ཉི་ཤུ་རྩ་བདུན་བར་ལོ་བཅུ་གཉིས་རིང་སེ་ར་ཐེག་ཆེན་གླིང་དུ་བཞུགས།",
    "དགུང་ལོ་སོ་བཞི་པ་ལྕགས་ལུག་ལོར་རྒྱུད་སྟོད་གྲྭ་ཚང་གི་སློབ་དཔོན་གྱི་ཁྲིར་ཕེབས་ནས་ལོ་བཅུ་བཞིའི་རིང་རྒྱུད་ཀྱི་འཆད་ཉན་གནང་།",
    "དེབ་ཐེར་དམར་པོ་གསར་མ་འདི་ཡང་དགུང་ལོ་དྲུག་ཅུ་རེ་གཅིག་པ་ས་ཁྱི་སྤྱི་ལོ་༡༥༣༨ལོར་བརྩམས།",
    "གང་གསན་པ་དེ་དག་ཀྱང་ཚིག་ཙམ་དུ་མ་སོང་བར་ལག་ལེན་ཐོག་འཁྱོལ་བའི་གདེང་ཚོད་ཡོད་པར་མཛད།",
    "གཟིགས་པ་པོ་རྣམས་ཀྱིས་གཟིགས་བདེ་བའི་ཆེད་དུ་དཀར་ཆག་ཀྱང་བཀོད་ཅིང་།",
    "རྒྱ་ཆེའི་གཟིགས་པ་པོ་རྣམས་ཀྱི་རིན་ཐང་བྲལ་བའི་དགོངས་ཆར་ཐད་ཀའམ་ཡང་ན་ཡིག་ཐོག་གང་རུང་ནས་ལྷུག་པོར་གནང་སྐྱོང་ཡོད་པ་ཞུ་རྒྱུ།",
    "འཇིག་རྟེན་ཐོག་གི་བྱ་དངོས་ཚང་མའི་འགྱུར་ལྡོག་དེ་ཡང་ཐོག་མར་ཆ་ཤས་དང་གྲངས་འབོར་ཐོག་གི་འགྱུར་ལྡོག་བྱུང་བ་བརྒྱུད་ནས་མཐར་ངོ་བོའི་འགྱུར་ལྡོག་ཡོང་གི་ཡོད་པ་ལྟར།",
    "འགྱུར་ལྡོག་གི་གནས་ཚུལ་ལ་ཐོག་མརཾ་ལྟ་ཙམ་ཞིག་བྱེད་དོ།",
    "རྒྱལ་རབས་བརྒྱད་པ་རྒྱལ་པོ་གྲི་གུམ་བཙན་པོའི་དུས་སུ་མངའ་རིས་ཞང་ཞུང་གི་ཡུལ་དུ་གཤེན་འདིའི་ཤཱཀྱའི་འདས་ལོ་ནི་ཁ་ཆེ་པཎ་ཆེན་ཤཱཀྱ་ཤྲི་རིའི་ལུགས་གཞིར་བཟུང་བ་ཡིན།",
    "འདྲེ་ནི་མི་དེ་གསོན་པོར་སྡོད་སྐབས་སྲོག་གི་བདག་པོ་བྱེད་པ་མ་ཟད།",
    "གནོད་པའི་འདྲེ་དེ་མེད་པ་བཟོ་དགོས་ཞེས་ཟེར་གྱི་ཡོད་པ་རེད།",
    "དགུན་ཀའི་དུས་སུ་བོན་ལྷ་དམར་མཆོད་ཅེས་གཡག་ལུག་ར་སོགས་ཕོ་ཕྱུགས་སྟོང་ཕྲག་གསུམ་རེ་ལོངས་པའི་སྐེ་དུས་གཅིག་ཏུ་བཅད་ནས་བསད་པ་དང་།",
    "ཐང་ཐའི་ཙུང་གི་ཁྲིན་ཀོན་ཁྲི་ལོ་བཅུ་དྲུག་སྤྱི་ལོ་༦༤༢ལོར་རྒྱ་གར་ནུབ་ཕྱོགས་ཀྱི་ཏཱ་སིག་ཨ་ལ་པོས་དབྱི་ལང་ལ་དམག་དྲངས་ཏེ་དབྱི་ལང་ཨ་ལ་པོའི་འོག་ཏུ་ཤོར་ཞིང་དེ་ནས་ཡོན་རྒྱལ་རབས་ཀྱིས་དབྱི་ལང་ལ་དམག་མ་དྲངས་བར་དབྱི་ལང་དེ་ཏཱ་སིག་ཨ་ལ་པོའི་རྒྱལ་ཁབ་ཀྱི་མངའ་འོག་ཏུ་བསྡད་པ་རེད།",
    "ཕྲག་གཅིག་རེ་ལོངས་པའི་ཡན་ལག་རྣམས་གསོན་པོར་ལྷུ་ལག་ཕྲལ་ནས་བསད་པའི་ཤ་ཁྲག་གི་དམར་མཆོད།",
    "དཔྱིད་ཀའི་དུས་སུ་ཡུ་མོའི་བྱིན་འབྲེག་ཟེར་བ་ཤྭ་བ་ཡུ་མོ་བཞིའི་རྐང་ལག་ལྷུ་ལག་ཕྲལ་ནས་བསད་པའི་ཤ་ཁྲག་གི་དམར་མཆོད།",
    "མོ་ཕྱུགས་སྟོང་ཕྲག་གསུམ་ནས་མ་ཐ་རེ་རེ་ལས་མ་བྱུང་ཡང་བསད་ནས་དམར་མཆོད་འབུལ་གྱི་ཡོད་པ་དང་།",
    "མོ་རྒྱབ་པ།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡ ༡༦༢ས་སྟག་སྤྱི་ལོ་༦༡༨ལོར།",
    "དེ་རྗེས་ཁོ་པའི་བུ་ཐང་ཐའི་ཙུང་ལི་ཧྲི་མིང་གི་སྐབས་སུ་སླེབས་དུས་ཐང་རྒྱལ་རབས་དེ།",
    "དེ་ནི་བོད་ཀྱི་རུས་རྒྱུད་ཚོ་པ་ཁག་གཅིག་གྱུར་བྱུང་ནས་མི་རིགས་སུ་འགྱུར་བའི་ཐོག་མའི་སྣང་ཚུལ་ཞིག་ཀྱང་རེད།",
    "འཕེལ་རྒྱས་བཅས་ཡོང་ཐུབ་ཀྱི་མ་རེད།",
    "རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོས་ཐོག་མར་ལོ་ཙཱ་བ་ཐོན་མི་སམ་བྷོ་ཊ་ལ་དེང་སྐབས་ང་ཚོས་བེད་སྤྱོད་བྱས་པའི་བོད་ཡིག་འདི་གསར་གཏོད་བྱེད་དུ་བཅུག་རྗེས།",
    "རིམ་པ་དམའ་བ་བློ་མི་ཕམ་པའི་ཐག་གཅོད་བྱེད་དགོས་པ་སོགས་གྲལ་རིམ་གྱི་དབྱེ་བ་ཧ་ཅང་གསལ་པོ་ཡོད་པ་རེད།",
    "འབངས་རྣམས་ཀྱིས་རྒྱལ་པོའི་སྐུ་སྲུང་ཞིང་བསམ་པ་རྣམ་དག་གིས་སྟོབས་ཤུགས་ཡོད་ཚད་འབུལ་དགོས་པ་དང་།",
    "མོ་བཙུན་བཀའ་ལ་མི་གདགས་ཟེར་བ།",
    "བུད་མེད་རྣམས་གྲོས་ཚོགས་ཀྱི་ཚོགས་མིའི་གྲས་སུ་ཞུགས་མི་ཆོག་པ་བཅས་གསལ་པོར་འཁོད་ཡོད་པ་དང་།",
    "མྱང་མང་པོ་རྗེས་ཞང་སྣང་གིས་སུམ་ཁམས་ཐམས་ཅད་མཛངས་ཀྱི་སྒོ་ནས་མི་རྟ་གཉིས་ལ་ཚེགས་མ་བྱུང་བར་འབངས་རྣལ་མར་བཀུག་ཏེ་དཔྱ་ཕབ།",
    "ཞེས་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོའི་དུས་སུ་བློན་པོ་མྱང་མང་པོ་རྗེ་ཞང་སྣང་གིས་མི་རྟ་གཉིས་ལ་ཟད་གྲོན་མ་བྱུང་བའི་ཐོག་ནས།",
    "ཞེས་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོས་སུམ་པའི་ཡུལ་མངའ་འོག་ཏུ་བཅུག་པའི་རྗེས་སུ་བཙན་པོ་ངོ་མ་བྱང་ཕྱོགས་བརྒྱུད་དུ་སོང་ནས།",
    "རྒྱལ་པོས་རང་གི་མངའ་འོག་མི་སེར་གྱི་ས་ནས་དཔྱ་ཁྲལ་བསྡུས་པ་དེ་ནི།",
    "དེ་སྐབས་ཀྱི་ཚན་རིག་མཁས་པ་མང་པོ་ཞིག་དགོངས་པ་གཅིག་མཐུན་བྱུང་ཡོད་པ་རེད།",
    "དེ་ཉིད་དར་སྤེལ་གཏོང་བའི་ཆ་རྐྱེན་ཡང་འཛོམས་ཡོད་པ་རེད།",
    "ཀྲའོ་ཤར་མའི་རྒྱལ་རབས་ཀྱི་རྒྱལ་པོ་ཀྲའོ་ཡོན་ཝང་གི་ཁྲི་ལོ་དང་པོ་མེ་སྟག་སྤྱི་ལོའི་སྔོན་གྱི་ལོ་༤༧༥ལོར་གཤེགས་ཤིང་།",
    "མཆིམས་ཕུ་སྣ་རལམ་ས་གོང་གི་ལྷ་ཁང་བཅས་ལྔ་བཞེངས།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱ་ཀྱའི་འདས་ལོ་༡༢༩༨ཤིང་རྟ་ཐང་ཞོན་ཙུང་ལི་ལོང་ཅིས་ཀྱི་ཐིའན་པའོ་ཁྲི་ལོ་བཅུ་གསུམ་པ་སྤྱི་ལོ་༧༥༤ལོ་ལ།",
    "རྒྱལ་པོ་ཁྲི་ལྡེ་གཙུག་བརྟན་ནི་བློན་པོ་འབལ་ལྡོང་ཚབ་དང་ལང་མེས་གཟིགས་གཉིས་ཀྱིས་བཀྲོངས་ཞེས་གསལ།",
    "ལྷ་ས་མཁར་བྲག་གི་ལྷ་ཁང་དང་བྲག་དམར་མགྲིན་བཟང་གི་ལྷ་ཁང་གཉིས་བཤིག་རྭ་མོ་ཆེའི་ཇོ་བོ་མི་བསྐྱོད་རྡོ་རྗེ་མི་སུམ་བརྒྱས་དྲུད་ནས་སྒུལ་མ་ཐུབ་པར་བྱེ་མའི་འོག་ཏུ་སྦས།",
    "སླར་ཡང་གཙུག་ལག་ཁང་དང་རྭ་མོ་ཆེའི་ཇོ་བོ་གཉིས་མངའ་རིས་སྐྱིད་གྲོང་བར་དུ་བསྐྱལ།",
    "རྭ་མོ་ཆེ་དང་གཙུག་ལག་ཁང་གཉིས་སུ་བཟོ་གྲྭ་དང་བཤས་ར་བྱས་ཏེ།",
    "གོང་གསལ་བློན་པོ་གཉིས་ཀྱིས་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་ཕ་ཁྲི་ལྡེ་གཙུག་བཙན་བཀྲོངས་པ་དང་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་ཡངབཀྲོངས་རྒྱུའི་གྲ་སྒྲིགས་བྱས་པའི་གནས་ཚུལ་བློན་པོ་སྟག་སྒྲ་ཀླུ་གོང་གིས་ཤེས་ནས་རྒྱལ་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "དེ་ནས་རྒྱལ་པོས་བློན་པོ་སང་ཤི་བློན་པོ་གསལ་སྣང་གི་གྲོགས་བྱེད་པར་མངའ་རིས་མང་ཡུལ་དུ་བཏང་།",
    "མོ་རྒྱག་མཁན།",
    "བློན་པོ་མ་ཞང་ཕྲག་དོག་གིས་ངར་ལངས་ནས་རྒྱལ་པོའི་བློན་པོའི་ནང་གཙོ་ཆེ་བ་ང་རང་ཡིན་པས་ང་ཡང་ནང་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "དུ་གསོན་པོར་འགྲོ་གི་ཡིན་ཟེར་ནས་ཁས་ལེན་བྱེད་དགོས་བྱུང་བ་རེད།",
    "དེ་ནས་ཉིན་གཅིག་བློན་པོ་མ་ཞང་དང་འགོས་ཁྲི་བཟང་སྟོད་ལུང་ནང་དུ་དུར་དོང་ཡོད་སར་སོང་ནས་དོང་ནང་དུ་གསོན་པོར་འཛུལ་ཏེ་དོང་གི་ཁ་བཀག་རན་པ་དང་།",
    "ཨ་ཏི་ཤ་དང་རུས་རྒྱུད་གཅིག་རེད།",
    "རྒྱ་བྱིའུ་རི་མོ་ཡོད་པའི་གསེར་ཤོག་སྲང་བརྒྱ་ཐམ་པ།",
    "ཨོ་རྒྱན་ནི་དེང་སང་གི་ཨ་ཧྥུ་ཧན་རེད།",
    "གསེར་དངུལ་འདྲེས་མས་བཟོས་པའི་ཞྭ་མོ།",
    "དེ་མཚུངས་མི་གཞན་དག་ལ་ཡང་བྱ་དགའི་དངོས་པོ་ཕུན་སུམ་ཚོགས་པ་སྤྲད་དེ་བོད་དུ་འབྱོར་ནས་གོང་མས་བསྐུར་བའི་བཀའ་ཤོག་གི་སྒྲོམ་བུ་༣ དང་།",
    "ལྷག་པར་དུ་སློབ་དཔོན་པདྨས་ཕ་མ་གཉིས་འཛོམས་ཀྱི་བུ་དང་བུ་མོ་ཁག་གཅིག་ལ་པྲ་འབེབས་པ་ཟེར་བ་མི་ལ་ལྷ་འདྲེ་ཁོག་ཞུགས་བྱས་པའི་ལུགས་སྲོལ་ཐོག་མར་བཙུགས་ཤིང་།",
    "དེང་སང་ལྷ་ཕེབས་ཟེར་བ་དེ་སྐབས་ཐོག་མར་བྱུང་བ་རེད།",
    "དེ་ནས་བསམ་ཡས་ཀྱི་གཙུག་ལག་ཁང་རྩིགས་རྒྱུའི་གྲ་སྒྲིགས་བྱས་སྐབས་བློན་པོ་སྟག་སྒྲ་ཀླུ་གོང་སོགས་བོན་ལ་དགའ་བའི་བློན་པོ་ཁག་གཅིག་གིས་ངོ་རྒོལ་བྱས་པར་མ་ཟད།",
    "རྒྱལ་པོའི་བཙུན་མོ་ཅོག་རོ་བཟའ་སོགས་དང་།",
    "དེ་ནས་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༣༣ ས་ཕག་ཐང་སུད་ཙུང་ལི་ཤིའང་གི་ཆེན་ཡོན་ཁྲི་ལོ་གཉིས་པ་སྤྱི་ལོ་༧༥༩ལོར།",
    "རྒྱལ་པོ་བོན་པོ་རྣམས་སྟོད་མངའ་རིས་ཞང་ཞུང་གི་ཡུལ་དུ་མཐར་སྐྲོད་བཏང་ཞིང་།",
    "བཀའ་གཙིགས་དང་པོ་དང་གཉིས་པ་ཚང་མ་བསམ་ཡས་གཙུག་ལག་ཁང་བཞེངས་ཚར་བའི་རྗེས་ཀྱི་ལུག་གི་ལོ་བོད་ཟླ་བཞི་པའི་ཚེས་བཅུ་བདུན་གྱི་ཉིན་བཀོད་པ་དང་།",
    "འཐབ་རྩོད་ཀྱི་དགོས་མཁོ་དང་བསྟུན་ནས་རྗེས་སུ་གཉིས་ཀས་ཁ་གཏད་ཕྱོགས་ནས་དགོས་མཁོ་ཡོད་པ་རྣམས་བླངས་ཏེ་ནང་དོན་བསྒྱུར་ནས་རྣམ་པ་རང་སོར་བཞག་པ་ཞིག་རེད།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༣༦ཆུ་སྟག་ཐང་ཏའི་ཙུང་ལི་ཡུའུ་གི་པའོ་དབྱིང་ཁྲི་ལོ་དང་པོ་སྤྱི་ལོ་༧༦༢ལོར་བསམ་ཡས་གཙུག་ལག་ཁང་བཞེངས་འགོ་ཚུགས་ཏེ་ལོ་བཞི་ལ་གྲུབ།",
    "དེའི་ཕྱི་ལོ་མེ་ལུག་ཐང་ཏའི་ཙུང་ལི་ཡུའུ་གི་ཏ་ཀླིས་ཁྲི་ལོ་གཉིས་པ་སྤྱི་ལོ་༧༦༧ལོར།",
    "རྒྱལ་པོས་བློན་པོའི་གྲོས་མོལ་ལ་བསྟུན་ནས་བཀའ་གཏོང་བ་མ་གཏོགས་རྒྱལ་པོས་རང་ཤེད་བྱེད་མི་ཆོག་པའི་ལམ་ལུགས་དམ་པོ་ཡོད་པ་བཅས་ཀྱི་གནས་ཚུལ་སྐོར་རྦ་བཞེད་ཀྱི་ནང་།",
    "སློབ་དཔོན་པདྨ་ཕྱིར་འབུད་བྱས་པ།",
    "བསམ་ཡས་གཙུག་ལག་ཁང་རྩིགས་རྒྱུའི་གྲོས་མོལ་བྱས་པའི་སྐོར་བཅས་ཀྱི་ཐད་ལ་གསལ་པོར་འཁོད་ཡོད་པ་རེད།",
    "ལམ་ལུགས་དེ་བོད་ལ་ཐོག་མར་འཛུགས་མཁན་ནི་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོ་རེད།",
    "གཏན་ཁེལ་བྱས་པའི་འཚོ་བའི་རྟེན་གང་ཡང་མེད་པའི་ཕོགས་གཟན་པ་ཤ་སྟག་རེད།",
    "ད་ལྟ་ང་རང་འཚོ་སྡོད་སྐབས་བསམ་ཡས་སོགས་ལྷ་ཁང་ཁག་གི་མཆོད་རྒྱུན་དང་།",
    "གཙུག་ལག་ཁང་གི་མཆོད་རྒྱུ་ལ་འབངས་མི་ཁྱིམ་ཉིས་བརྒྱ་དང་།",
    "རྒྱལ་པོས་ལྷ་ཁང་དང་གཙུག་ལག་ཁང་གི་མཆོད་རྒྱུན་ལ་འབངས་མི་ཁྱིམ་བརྒྱ་དང་ལྔ་བཅུ།",
    "གྲྭ་གྲངས་སུམ་བརྒྱ་དང་ལྔའི་བྲན་གཡོག་བཅས་བསྡོམས་པའི་ལྷ་འབངས་བྲན་གཡོག་ཐེམ་དུད་ཆིག་སྟོང་བརྒྱ་མེད་དྲུག་ཅུ་རེ་ལྔ་དང་།",
    "དེར་ཆ་སྙོམས་ཀྱི་མི་གྲངས་བཞི་རེ་བརྩིས་ཁྱོནབསྡོམས་མི་གྲངས་བཞི་སྟོང་ཉིས་བརྒྱ་དྲུག་ཅུ་ཡོད་པ་དེ་ཚོ་ཚང་མས་རྒྱལ་པོ་ལ་དཔྱ་ཁྲལ་དང་དམག་ཁྲལ་འཇལ་མི་དགོས་པ་རེད།",
    "ལོ་གཅིག་ལ་ཁལ་དགུ་བརྒྱ་རེདལོ་རེ་ལ་མར་སྲང་ཆིག་སྟོང་བརྒྱ་ཐམ་པ།",
    "༧ ཟླ་བ་རེ་ལ་མར་ཁལ་གཅིག་དང་ཉག་ཕྱེད་དང་གསུམ།",
    "ལོ་རེ་གོས་ཆ་ཚང་རེ།",
    "བསམ་ཡས་མཆིམས་ཕུར་ཡོད་པའི་སྒོམ་ཆེན་ཉི་ཤུ་རྩ་ལྔ་ལ་ལོ་རེར་ནས་ཁལ་ལྔ་བཅུ་ང་ལྔ།",
    "ལོ་རེར་མར་སྲང་བརྒྱད་བརྒྱ།",
    "རྟ་རེ།",
    "གོས་སྣེ་ཁ་དྲུག་རེ།",
    "གོས་སྣེ་ཁ་གསུམ་རེ།",
    "ཟླ་བ་རེ་ལ་བྲེ་བཅུ་གསུམ་དང་ཕུལ་ལྔ།",
    "བྲེ་ཉི་ཤུ་ལ་ཁལ་གཅིག་བརྩིས་པ་སྐབས་དེའི་འཇལ་གཤོར་གི་ཚད་ཡིན།",
    "ནས་འབྲུ་དྲུག་གི་ལྗིད་ཚད་ལ་སེ་བ་གང་།",
    "ཟླ་བ་རེར་ནས་ཁལ་བཞི་དང་བྲེ་བཅུ་གཉིས་ཕུལ་གང་།",
    "ཟླ་བ་རེར་མར་ཉག་དྲུག་དང་སྲང་དོ།",
    "ཟླ་བ་རེར་ཁལ་གཉིས་ལྷག་ཙམ།",
    "ཁོ་ཚོར་རང་བདག་གི་ས་ཞིང་དང་།",
    "ཞིང་པ་མི་གྲངས་ལྔ་བརྒྱ་བཞི་བཅུ་ཞེ་གཉིས་ཀྱིས་ལོ་གཅིག་ལྡང་བའི་ཟ་འབྲུའི་འབོར་གྲངས་དང་མཉམ་གྱི་ཡོད་པ་རེད།",
    "ཚང་མ་བྲན་གཡོག་དེ་གི་བདག་པོ་ཤ་སྟག་ཡིན་པ་དང་།",
    "རྒྱལ་པོའི་བློན་པོ་ཞང་ཚེ་སྤོང་སྟོ་རེ་ཟེར་བས་སྟོད་ལུང་ལྕང་ཕུར་དགེ་སློང་བཞི་ཡོད་པའི་གཙུག་ལག་ཁང་ཞིག་བཞེངས་པ་དེའི་མདུན་གྱི་རྡོ་རིང་ཡི་གེའི་ནང་འཁོད་དོན།",
    "མཛུབ་བརྡ་བྱས་ན་མཛུབ་མོ་གཅོད་པ།",
    "དེ་ནས་རྒྱལ་པོའི་བཙུན་མོ་ངང་ཚུལ་མ་དང་།",
    "དེ་ནས་བློན་པོ་སྦས་སྟག་སྣ་ཅན་གྱིས་མངའ་འོག་ཏུ་ཡོད་པའི་མོ་རྒྱག་མཁན་དང་།",
    "དེ་རྗེས་རྒྱལ་པོའི་བཙུན་མོ་ངང་ཚུལ་མ་དང་།",
    "དཔལ་ཡོན་གཉིས་ལྐོག་ཏུ་ལུས་འབྲེལ་བྱས་སོང་ཟེར་བའི་ཕྲ་མ་རྒྱལ་པོར་ཞུས་པ་ལྟར་རྒྱལ་པོས་ཁོ་གཉིས་གསོད་དགོས་པར་བཀའ་ཕབས་ཏེ།",
    "བཙུན་མོ་ངང་ཚུལ་མ་རང་སྲོག་བཅད་དེ་ཤི།",
    "སྦས་སྟག་སྣས་བློན་པོ་བྱས་པ་རེད།",
    "སྐབས་དེར་བེད་སྤྱོད་བྱ་རྒྱུའི་མང་ཚོགས་ཀྱི་བསམ་བློའི་རྨང་གཞི་མེད་ན།",
    "བོད་ཀྱི་ཆབ་སྲིད་རྒྱ་ནག་གིས་འཕྲོག་འདོད་པ་རེད།",
    "ཐང་གི་དམག་དཔོན་ཨན་ལུའུ་ཧྲན་དང་།",
    "དེ་ནས་བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱ་འདས་ལོ་༡༤༣ས་ཡོས་ཐང་ཞུན་ཙུང་ལི་ཁྲེན་གྱི་ཏ་ཀྲུང་ཁྲི་ལོ་བཅུ་གསུམ་པ་སྤྱི་ལོ་༨༥༩ལོར།",
    "ཇེ་ཆུང་ཇེ་ཆུང་དུ་སོང་བར་བརྟེན།",
    "བོད་ཀྱི་རབ་བྱུང་གོང་གི་ཤཱཀྱའི་འདས་ལོ་༡༤༥ ༡མེ་ཡོས་ཐང་ཨེ་རྡིས་ལི་ཀྲུའུ་གི་ཐིའན་ཡོའུ་ཁྲི་ལོ་བཞི་པ་སྤྱི་ལོ་༩༧ལོར།",
