    "རྩིབས་གཅིག་ལ་ཨ་མུ་ཀཾ་མཱ་ར་ཡ་ཕཊ།་",
    "ལན་མ་སནྟ་བཛཱ་ཎཾ་སརྦ་ིབ་ལཾ་ཨཱ་བརྟ་ཡ་མ་ཧཱ་བ་ལེ་ཆེ་གེ་མོ་མཱ་ར་ཡ་རྦད་ཅེས་བྲི་ཞིང་མུ་ཁྱུད་ལ་ཡང་སྔགས་དེ་དག་ཉིད་དོ།",
    "ས་ཡི་གེ་ཡཾ་གི་སྟེང་ན་ཚྭ་༦ སྔོ་ནག་ཏུ་གནས་པ་བཀུག་ནས་འཁོར་ལོའི་ལྟེ་བར་ཚུད་པར་བསམས་ལ།",
    "དེ་ཡང་འདར་ཞིང་འཕར་ལ་མི་བཟོད་བཞིན་དུ་གནས་པར་བསམ་མོ།",
    "འཁོར་ལོའི་རྩིབས་ཀྱི་རྩེ་མོ་ལ་ཡང་གཟུགས་བརྙན་བྲི་བའམ་བསམ་པར་བྱའོ།",
    "རབ་ཏུ་བསྒྲིམ་པར་བྱའི་༧ གཞན་དུ་ན་རང་གི་སྲོག་ཀྱང་གཡོ་བར་འགྱུར་ན་དགྲ་བགེགས་ལྟ་ཅི་སྨོས།",
    "མདུད་པ་རེ་རེའི་ནང་དུ་ཕ་རོལ་གྱིས་རྦད་པའི་མི་མ་ཡིན་པ་དང་དེ་རྗོད་ིཔར་བྱེད་པ་པོའི་དངོས་པོ་རྣམས་ཆུད་ཅིང་རབ་ཏུ་བསྡམས་ནས་སྔགས་བཟླས་པས་དེ་ལྟར་གྱུར་ཏེ་དེ་མགུལ་དུ་གདགས་སོ།",
    "གང་གི་ཚེ་མི་དགོས་པའི་ཚེ་མདུད་པ་དགྲོལ་བར་བྱའོ།",
    "ཆེ་གེ་མོ་འདི་ཞེས་བྱ་བའི་ངག་རེངས་པར་གྱིས་ཤིག་ཅེས་སྤེལ་ཏེ་བྲིའོ།",
    "རེངས་པར་བྱེད་པ་སྟེ་ལས་དྲུག་བྱེད་པའོ།",
    "ཨོ་ཙྪིནྡ་ཆེ་གེ་མོ་ཙྪིནྡ་བྷིནྡ་ཆེ་གེ་མོ་བྷིནྡ་མ་ཧཱ་ཀཱི་ལི་ཀཱི་ལཱ་ཡ་ཆེ་གེ་མོ་མཱ་ར་ཡ་ཕཊ་ཅེས་བྲིའོ།",
    "ཡང་གསོལ་བ་བཏབ་པ་ལ་སོགས་པ་བྱས་ལ་རང་ཉིད་ཆུའི་ཟླ་བ་ལྟ་བུའི་རྣམ་པར་འཇོམས་མཛད་དུ་སྐུ་ཆེ་ལ་ཡན་ལག་རགས་པར་བསྒོམ་མོ།",
    "པེ་སྣར་གིས་༧ སྣར་བས།",
    "དེ་ན་བསྡུར་འབྲས་རེའུ་མིག་འདི་དག་ལ་འདུག་འི་ག་ག།",
    "སྔགས་ལ་ཡང་རྡོ་རྗེ་འཆང་གིས་བཀའ་སྩལ་པ་རྒྱུད་དང་།",
    "རེ་ཤིག་སྤྱིར་རྒྱུད་ཀྱི་རྣམ་པར་བཞག་པ་ནི།",
    "ལེ་ལག་གི་རྒྱུད་དམ་མན་ངག་གི་རྒྱུད་ཅེས་ཀྱང་བྱའོ།",
    "ཁ་ག་ཎ་ཌོ་ཀ་བ་ད་ནི་གཞུང་གི་དོན་ལ་འཇུག་པར་བྱ་སྟེ།",
    "གདམ་ངག་གི་དོན་ཕྱི་དང་ནང་དང་གསང་བ་དེ་ཁོ་ན་ཉིད་ཀྱི་དབྱེ་བའི་ཁྲུས་བཞི་བསྟན་པའོ།",
    "དེ་ལས་རེ་ཤིག་ཡི་གེའི་དོན་བརྗོད་པར་བྱ་སྟེ།",
    "གང་གིས་དེ་ལྟར་རྟོགས་པའི་དོན་དེ་ལ་ནི་གྲུབ་པའི་མཐའ་ཞེའམ།",
    "རང་གི་ཉམས་སུ་མྱོང་བ་ལ་གནོད་པའི་ལས་མི་བྱེད་པ་ནི་སྤྱོད་པ་ཞེས་བྱའོ།་།",
    "ན་བ་ནི་བདེ་བས་ཕོངས་ཤིང་ཉོན་མོངས་པས་ན་ཉོན་མོངས་པའི་བདུད་དོ།",
    "འཆི་བ་ནི་ཉིང་འཚམས་སྦྱོར་བར་འགྱུར་བ་སྟེ་འཆི་བདག་གི་བདུད་དོ་། བདུད་དེ་རྣམས་གང་ལས་བྱུང་ཞེ་ན།",
    "རྒྱུད་འགྲེལ། ནུ་༧༣དྷ་མོ་འོལས་བྱུང་བའོ།",
    "འི་བདག་དང་གཞན་ལ་ཕན་པ་དང་བདེ་བ་ཐམས་ཅད་ཀྱང་སེམས་དེ་ལས་བྱུང་བས་དེའི་ཕྱིར་རྒྱུད་དོ་ཅོག་གི་རྩ་བ་སྟེ་ཞེས་བྱའོ།",
    "རྒྱུད་ཐམས་ཅད་དུ་སང་དོན་འདི་རྟོགས་པའི་ཐབས་གཞན་དང་གཞན་གསུངས་པར་ཟད་ཀྱི་དོན་གྱི་རྩ་བ་ཡང་འདི་ཉིད་ཡིན་པའི་ཕྱིར་ཡང་རྒྱུད་དོ་ཅོག་གི་རྩ་བ་སྟེ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་བས་ན་གཞོམ་ཞིང་གདུལ་བར་བྱ་བ་ནི་རང་གི་སེམས་ཡིན་ཏེ།",
    "མ་བཅོམ་ན་ཉེས་པའི་ས་རྒྱུད་དོ་ཅོག་ཡིན་ལ་བཅོམ་པས་ནི་ལེགས་པའི་དཔལ་ཀུན་ཐོབ་པར་བྱེད་པའི་ཕྱིར་རོ་། འོ་ན་གང་གིས་གཞོམ་ཞེ་ན།",
    "གང་གིས་བཅོམ་པའོ།",
    "གང་བཅོམ་པ་ནི་བདུད་བཞི་ལ་སོགས་པའི་རྒྱུད་དོ་ཅོག་གི་རྩ་བའོ།",
    "དེ་གང་གིས་བཅོམ་པ་ལ་རྣམ་པར་རྟོག་པ་མེད་ཅིང་གང་ལ་ཡང་མི་གནས་པ་ཞེས་བྱའོ།",
    "ཎལག་ན་རྡོ་རྗེ་ཡང་ནང་གི་སྟོང་པའི་ངང་ལ་མི་ཡེངས་པའི་བརྗེད་བྱང་དུ་རྡོ་རྗེ་ལག་ཏུ་ཐོགས་པས་ལག་ན་རྡོ་རྗེའོ།",
    "རིག་སྔགས་སུ་ཟློས་པ་ནང་གི་ཁྲུས་དང་།",
    "ཞ་ནང་གི་ཁྲུས་ཀྱིས་ནི་ངག་དག་པར་བྱེད་ཅིང་།",
    "གསུང་གི་རྟགས་སུ་སྤོས་ལྔ་དང་།",
    "རང་ཉིད་ཡུད་ཙམ་གྱིས་ལག་ན་རྡོ་རྗེར་མོས་པ་བྱའོ།",
    "དེའི་ཐུགས་ཁར་གཟུངས་ཐག་གི་སྣ་ཟུག་པར་བསམ་ལ་སྔགས་ཀྱི་སྒྲ་འབྲུག་སྒྲ་ལྟ་བུར་སྟོང་གསུམ་གང་བར་གྲགས་པར་བསམ་ཞིང་ངག་ཏུ་གདོན་པར་བྱའོ།",
    "གྲངས་ནི་ཐུན་རེ་རེ་ལ་ཡང་བརྒྱ་རྩ་བརྒྱད་ལ་སོགས་པ་ཅི་ནུས་སུ་བཟླས་ནས་དེའི་རྗེས་ལ་བསྟོད་པ་ཡང་བྱ་སྟེ།",
    "ཐུགས་རྗེའི་ཡེ་ཤེས་ཉོན་མོངས་འཇོམས་པའི་སྐུ།",
    "བུམ་པ་ནི་རང་གི་ལུས་ཏེ་ཁམས་གསུམ་རྣམ་པར་དག་པའི་གཞལ་ཡས་ཁང་ངོ།",
    "མོས་པ་བྱས་ལ།",
    "སེམས་དེའི་རང་བཞིན་ནི་འོད་གསལ་བ་ཡིན་མོད་ཀྱི་གནས་སྐབས་ཉོན་མོངས་པས་བསྒྲིབས་པ་དེ་བསལ་བའི་དོན་དུ་སེམས་དེ་ལུས་ངག་ཡིད་གསུམ་གྱི་རྣམ་པ་ཡི་གེ་ཨོཾ་ཨཱ་ཧཱུྃ་གསུམ་དུ་བསམས་ལ་ཡི་གེ་གསུམ་ལས་སྔགས་ཀྱང་གསང་སྔགས་ཀྱི་ཚུལ་དུ་ལན་བདུན་ཡིད་ཀྱིས་བརྗོད་དེ་ཡི་གེ་གསུམ་པོ་རིམ་གྱིས་ཨོ་དང་ཨཱཧཱུྃ་ལས་འདུས་ཏེ་ཧཱུཾ་དེ་ཡང་ན་དའི་བར་དུ་ཐིམ་ཏེ།",
    "ལྡང་བར་འདོད་ན་ལུས་ངག་ཡིད་གསུམ་སྐུ་གསུང་ཐུགས་ཀྱི་རང་བཞིན་དུ་དབྱེར་མེད་པར་མོས་པ་ལ་སྤྱོད་ལམ་བྱའོ།",
