    "ལུང་རྣམ་དག་གི་བརྗོད་དོན་རྗེ་བཀའ་དྲིན་ཅན་གྱི་ཞལ་སྐྱིན་གྱིས་བཀྲལ་བ་ན།",
    "ལམ་སྐོར་འདི་ལས་འཕྲོས་པའི་དོགས་གནས་ཤིན་ཏུ་ཆེས་མང་པོ་ལ་དྲི་རྟོག་དང་འབེལ་གཏམ་རྒྱ་ཆེར་ད་དུང་བྱར་ཡོད་མོད་ཀྱིས་དྲི་བ་རྒྱ་ཆེ་ན་ལན་འདེབས་དཀྱིལ་སྟོང་པའི་དཔེ་ཡོད་པར་བསམ་ནས།",
    "ད་ལམ་ཁྲིད་ཡིག་གི་ཚིག་རིས་འབའ་ཞིག་ལ་དཀྲིས་ནས་དོག་གཅོད་ཞུས་པ་ལགས།",
    "མ་འབྲེལ་བ་སོགས་སྐྱོན་དྲིས་རེག་པའི་གོ་སྐབས་རྣམ་པ་ཐམས་ཅད་དུ་ག་ལ་ཡོད།",
    "འདི་ནི་བླུན་པོ་གྱི་ནར་འཁྱམས་པའི་ཀུན་ཏུ་རྒྱུ་དག་གི་སྤྱོད་ཡུལ་ལོ་ཞེས་རིང་ལུགས་གཞན་འཛིན་པ་དག་གིས་ཀྱང་བརྙས་ཤིང་མི་བཀུར།",
    "འགའ་ཞིག་ནི་དེ་ལྟར་དུ་མ་འབད་ཀྱང་ཤེས་བྱ་ཐམས་ཅད་ཀྱི་རང་དང་སྤྱིའི་མཚན་ཉིད་སེམས་ཐོག་ཏུ་རྫོགས་པར་གཟིགས་པ་གཉིས་པོ་དེ་ནི་ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་གྱིས་ཕྱག་བྱ་བའི་འོས་ཡིན་གྱི།",
    "ད་གཟོད་ཚིག་གི་མེ་ཏོག་ལས་དོན་གྱི་འབྲས་བུ་བདེ་བླག་ཏུ་སྨིན་པར་འགྱུར་བ་ནི།",
    "དེའི་ཆེད་དུ་འབྲི་ཀློག་ནས་བརྩམ་བསླབ་སྦྱངས་ཕྲ་མོ་མཛད་པར་བསྐུལ་བ་ནི་དགོས་པ་ལྔ་པའོ། གཞན་འཇམ་དབྱངས་ས་སྐྱ་པཎ་ཆེན་གྱིས།",
    "གཟུ་པོའི་ཐུགས་མངའ་གང་གང་གི།",
    "བློ་ངན་འཁྱོག་པོར་བགྲོད་པ་འགས།",
    "ཐུན་གཅིག་སླར་ཡང་སྦྱིན་ལ་རེག།",
    "ཅེས་པ་འདི་ནི་ཐ་སྙད་ལ་ཞེན་པའི་བྷི་ཀྵུ་བུདྡྷའི་མིང་ཅན་དེས་ཕུལ་བ་དགེའོ།",
    "པོད་ཆེན་དྲུག་གི་རྩ་བ།",
    "རང་བཞིན་གྲུབ་ན་རྟེན་འབྱུང་གི།",
    "རྒྱུན་ཆད་པར་ཡང་ཐལ་བར་འགྱུར།",
    "ཚོར་དང་ཚོར་བ་པོ་སོགས་དང་།",
    "ཉོན་མོངས་འདུ་བྱེད་ལས་བདག་ཉིད།",
    "རང་གི་རང་བཞིན་ལ་འཛིན་འགྱུར།",
    "སྐད་ཅིག་སྐད་ཅིག་གིས་མི་འཛིན།",
    "དེ་ནི་གཞན་བདག་གིས་ཀྱང་སྟོང་།",
    "གང་ཚེ་གཅིག་རེག་ལྷན་ཅིག་འགྱུར།",
    "དེ་བདག་ཉིད་ཀྱིས་རེག་མེད་པས།",
    "སྒྲུབ་ཐབས་ཟབ་མོ་སློབ་བུས་བསྐུལ་བའི་ངོར།",
    "སྤྱན་རས་གཟིགས་ཕྱག་སྟོང་སྤྱན་སྟོང་དུ་གསལ་བ་ལ་མ་ཎི་སྟོང་ངམ་བརྒྱ།",
    "སྒོ་ཚུན་གྱི་སྤྱིལ་པོའི་རྒྱ་དེ་སྤྱན་རས་གཟིགས་ཞལ་གཅིག་ཕྱག་བཞི་པར་བསྒོམ་ལ་མ་ཎི་སྟོང་ངམ་བརྒྱ།",
    "སྐུ་དེ་གསུམ་ཀའང་གཅིག་གི་ཐུགས་ཀར་གཅིག་བཞུགས་པ་ཁ་སར་པ་ཎིའི་ཐུགས་ཀར་རང་ཡོད་པའི་མདུན་དུ་ཞིང་ཁམས་གསེར་གྱི་ས་གཞི་ལག་མཐིལ་ལྟར་འཁོད་སྙོམས་པའི་དབུས་སུ་བཾ་ལས་བདུད་རྩིའི་རྒྱ་མཚོ།",
    "དེའི་དབུས་སུ་པཾ་ལས་དཔག་བསམ་ཤིང་གི་སྡོང་པོ་རྩ་བ་གཅིག་ལ་ཡལ་ག་དུ་མར་གྱེས་པའི་སྟེང་དུ་འདབ་དྲུག་བརྩེགས་ལྷའི་གོས་གྱིས་ཀླུབས་པའི་ཁར།",
    "གོང་གི་སྐྱབས་ཡུལ་སླར་ཡང་གསལ་བར་དམིགས་ལ།",
    "གསུང་གི་ལོངས་སྐུ་འགྲུབ་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཞེས་པ་སྟོང་ཕྲག་གཅིག་སོང་བ་དང་།",
    "རང་གི་གསང་གནས་ཀྱི་དོན་གྲུབ་ཡབ་ཡུམ་ལ་ཐིམ་པས།",
    "འདུ་བྱེད་གྱི་ཕུང་པོ་སྦྱངས་ཕྲག་དོག་གི་དྲི་མ་དག།",
    "རང་གི་ལྟེ་བའི་རིན་ཆེན་འབྱུང་གནས་ཡབ་ཡུམ་རྣམས་ལ་ཐིམ།",
    "རིན་འབྱུང་གི་གོ་འཕང་མངོན་དུ་བྱ།",
    "ཞེ་སྡང་གི་དྲི་མ་དག།",
    "རང་གི་མགྲིན་པའི་འོད་དཔག་མེད་ཡབ་ཡུམ་ལ་ཐིམ།",
    "རང་གི་སྤྱི་བོའི་རྣམ་པར་སྣང་མཛད་ཡབ་ཡུམ་ལ་ཐིམ།",
    "གཏི་མུག་གི་དྲི་མ་དག།",
