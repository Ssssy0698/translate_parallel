    "མཁའ་དབྱིངས་རྒྱས་པར་གཏམས་པ་གང་།",
    "དྭང་བའི་ཡིད་ཀྱིས་འབུལ་ལོ་དགྱེས་བཞེས་ནས།",
    "འདོད་དོན་ཕྲིན་ལས་མ་ལུས་འགྲུབ་པར་མཛོད།",
    "ཀུན་ལ་དྭང་བའི་ཡིད་ཀྱིས་བསྟོད་པར་བགྱི།",
    "ཁྱད་པར་གནས་སྲུང་ཆེན་པོ་སོགས།",
    "བརྒྱུད་པར་བཅས་པས་གཉེར་གཏད་པའི།",
    "ནོངས་པར་གྱུར་གང་འགྱོད་བཤགས་དག་ཚངས་སྩོལ།",
    "ཅེས་བསྟོད་པ་ཕྲིན་བཅོལ་ནོངས་པ་བཤགས།",
    "ཐརཝ་བཙནམ་ཝས་སྨཙཔར་སྨ་སྨ་ཝརྨ་ས་ཚན་དྷཱིརྡོ་རྗེ་སློབ་དཔོན་པདྨ་ཐོད་ཕྲེང་དང་།",
    "ཚུར་གཤེགས་ཚུར་བྱོན་དགྱེས་པས་གདན་ལ་བཞུགས།",
    "དག་གཙང་རྒྱ་ཆེན་ཟད་མེད་འདི་བཞེས་ཤིག།",
    "ལྷ་སྲུང་གཉན་པོ་འཁོར་དང་བཅས་ལ་བསྟོད།",
    "སྟོང་པའི་ངང་ལས་འབྲུ་གསུམ་འོད་དུ་ཞུ་བ་ལས་བྱུང་བའི་གཙང་བྱེད་བདུག་པའི་སྤྲིན་ཕུང་འདོད་ཡོན་ལྔའི་འོད་ཟེར་འཕྲོ་བ་དང་།",
    "ཁྱད་པར་གནས་འདིའི་སྲུང་མ་མཆོག།",
