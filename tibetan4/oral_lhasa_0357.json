    "ཚིམ་པར་བཞེས་ལ་ཡུལ་ཕྱོགས་འདི་དག་ཏུ།",
    "འགྱུར་མེད་རྣམ་པར་རྒྱལ་བ་ཡབ་སྲས་ཀྱི།",
    "རྨེག་མེད་རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་མཛོད།",
    "རིགས་རྒྱུད་འཁོར་གཡོག་ལྟོས་པར་བཅས་པ་ཀུན།",
    "ཕྲིན་ལས་རྣམ་བཞི་འགྲུབ་པར་མཛོད།",
    "ཀོ་ལོང་མེད་པར་མཐུན་པའི་སྡོང་གྲོགས་མཛོད།",
    "འདིར་བྱོན་དམ་རྫས་གཏོར་མཆོད་འདི་བཞེས་ལ།",
    "བསངས་དུད་དང་འོལ་སྐོམ་སོགས་མཆོད་རྫས་འདུ་བྱས་ལ།",
    "པདྨ་ཉི་ཟླ་རྣམ་བཀོད་པར།",
    "དགྱེས་པ་དང་བཅས་རབ་བཞུགས་ནས།",
    "བཞུགས་པའི་སྲེད་སྤོང་ཆེན་པོ་ནི།",
    "དྲི་མེད་དར་ཞིང་རྒྱས་པར་མཛོད།",
    "དགྱེས་བཞིན་གདན་ལ་བཞུགས་སུ་གསོལ།",
    "དོན་གྲུབ་རྒྱལ་ཁ་ཐོབ་པར་མཛོད།",
    "ཁྱད་པར་སྡང་བའི་དགྲ་དཔུང་རྣམས།",
    "མིང་ཡང་མེད་པར་རྡུལ་དུ་རློག།",
    "འདིར་རྡོ་སྨད་ཀྱི་གཞི་བདག་གཉན་པོ་སྐུ་ལྷ་ལྕགས་རྩེའི་བསངས་མཆོད་བྱ་བར་འདོད་པས་མཆོད་རྫས་རྣམས་འདུ་བྱས་ཏེ་བདག་ཉིད་ཡི་དམ་གྱི་ང་རྒྱལ་ལ་གནས་པས།",
