    "དེ་ཡང་རྣམ་པར་རྟོག་པ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་སྟོན་པར་བྱེད་པ།",
    "དེ་ལ་རྣམ་པར་གཅོད་པ་ག་ལས་ཞེས་པ་སྟེ།",
    "མང་པོ་ཅན་ཉིད་ལ་སོགས་པ་རྣམས་ཀྱིས་ཀྱང་འཛིན་པར་འགྱུར་རོ།",
    "ཆ་ཤས་གང་ལ་ནུས་པ་དེ་ཁོ་ན་འཛིན་པར་འགྱུར་རོ་ཞེ་ན་གསུངས་པ།",
    "དེ་ལས་ཀྱང་དེའི་ཁྱད་པར་རྣམས་དོན་ལས་ཐ་མི་དད་པ་ཉིད་ཀྱི་ཕྱིར་དོན་ལྟ་བུར་དེ་རྣམས་ལ་ཡང་འཛིན་པ་སྐྱེད་པར་ནུས་པར་འགྱུར་རོ།",
    "འོ་ན་གང་ཁོ་ན་འཛིན་པར་འདོད་པའི་ཆ་ཤས་དེ་ཁོ་ན་གཟུང་བར་བྱ་བ་མ་ཡིན་ནམ་ཞེ་ན་གསུངས་པ།",
    "ཕྲད་པ་སྨྲ་བ་ལ་ཡང་སྐྱོན་འདི་བརྗོད་པར་བྱས་པས་འདི་ནི་དོན་གྱིས་ཤེས་པ་སྨྲ་བ་ལ་ཡང་བརྗོད་པ་ཁོ་ནར་འགྱུར་རོ།",
    "དེ་ལྟར་ནི་ཕྲད་པ་དོན་འཛིན་པའི་རྒྱུའོ་ཞེས་པ་ལ་སྐྱོན་འདི་བརྗོད་པར་བྱ་བ་ཡིན་ཞིང་།",
    "དེ་ལྟར་ནི་སྐྱོན་འདི་ཁོ་ན་རྗེས་སུ་དཔག་པར་འཆད་པར་འགྱུར་རོ།",
    "གང་དེ་ངེས་པར་འབྱེད་པའོ།",
    "ཡང་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་བཟུང་ན་ཡང་དེ་ལྟར་ངེས་པར་མི་འགྱུར་བ་ཅི་ཞེ་ན།",
    "ཉམས་སུ་མྱོང་བ་ནི་རྣམ་པར་རྟོག་པ་གོམས་པ་ཇི་ལྟ་བར་ངེས་པ་རྣམས་སྐྱེད་པར་བྱེད་དེ།",
    "དཔེར་ན་གཟུགས་མཐོང་བ་ལ་ཁྱད་པར་མེད་ཀྱང་།",
    "རོ་དང་འདོད་ལྡན་མ་དང་བཟའ་བར་བྱ་བའི་རྣམ་པར་རྟོག་པ་རྣམས་ལྟ་བུའོ།",
    "དཔེར་ན་སྐྱེད་པར་བྱེད་པ་དང་ཀློག་ཏུ་འཇུག་པར་བྱེད་པ་པོ་ཉིད་དུ་ཁྱད་པར་མེད་ཀྱང་པ་འོང་བ་མཐོང་ནས།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཕ་རོལ་པོས་མངོན་སུམ་རྟོག་པ་དང་བཅས་པར་འདོད་ན།",
    "མངོན་སུམ་དང་གཏན་ལ་ཕེབས་པར་མཚུངས་པར་སྐྱེ་བའོ་ཞེས་པ་འདི་ཅི་ལྟར་རིགས་ཏེ།",
    "དེ་ཁོ་ན་དང་དེ་མཚུངས་པར་སྐྱེའོ་ཞེས་ཁས་བླངས་པར་རིགས་པ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "ཡུལ་ཐ་དད་པ་ལ་སྐྱོན་ཅི་ཡོད་ཅེ་ན་གསུངས་པ།",
    "གཞན་ཡང་ཞེས་པ་ལ་སོགས་པས་ཁས་བླངས་པས་གནོད་པ་གསུངས་ཏེ།",
    "བསྟན་བཅོས་སུ་བརྗོད་པ་ནི་སྤྱི་དང་ཁྱད་པར་ལ་ལྟོས་པ་ནི་རྫས་དང་ཡོན་ཏན་དང་ལས་རྣམས་ལ་མངོན་སུམ་སྟེ།",
    "ཁྱད་པར་སྨོས་པས་རྫས་ཉིད་ལ་སོགས་པ་སྤྱི་ལྷག་མ་རྣམས་ཏེ།",
    "སྤྱི་དང་ཁྱད་པར་ཞེས་པ་འདི་ཡང་ལྟོས་ནས་བྱས་པ་སྟེ།",
    "དེའི་ཕྱིར་སྤྱི་འདི་རྣམས་ནི་ཁྱད་པར་གྱི་སྒྲས་བརྗོད་པར་བྱ་བ་རྣམས་སོ།",
    "ཡོད་པ་ཉིད་ནི་སྤྱི་ལོ་ན་སྟེ་ཁྱད་པར་མ་ཡིན་ལ།",
    "ལྷག་མ་རྣམས་ནི་སྤྱི་རྣམས་དང་ཁྱད་པར་རྣམས་སུ་ཡང་ལྟོས་ནས་འགྱུར་རོ།",
    "དེ་ལ་སྤྱི་ལ་ལ་ལྟོས་པ་ནི་རྫས་ལ་ཡོད་པ་ནི་རྫས་སོ་ཞེས་པའོ་ཁྱད་པར་ལ་ལྟོས་པ་ནི་རྫས་ནི་སའོ་བུམ་པའོ་ཞེས་པ་ལ་སོགས་པའོ།",
    "ཅིའི་ཕྱིར་སྦྱར་བར་མི་བྱ་ཞེ་ན་གསུངས་པ།",
    "ཞེས་པ་འདི་ནི་རྣམ་པར་འགྲེལ་ལོ།",
    "ངེས་པར་ཞེས་པ་ནི་རྣམ་པ་གཞན་དུ་ན།",
    "གང་ཡང་ཁྱད་པར་དུ་བྱེད་པ་དང་ཁྱད་པར་དུ་བྱ་བ་ཡང་འཛིན་པ་མ་ཡིན་ཞིང་དེ་དག་སྦྱོར་བར་ཡང་མི་བྱེད་པ་དེ་ཡང་དེ་ལྟར་འཛིན་པར་འགྱུར་རོ་ཞེས་དགོངས་པའོ།",
    "ལྡན་པ་ཕྱིས་པ་ལས་སམ་ཐ་མི་དད་པར་ཉེ་བར་བཏགས་པ་ལས་ཞེས་ཇི་ལྟར་སྲིད་པར་བལྟ་བར་བྱའོ།",
    "ཐ་དད་པ་མེད་པར་ཉེ་བར་བཏགས་པ་ཡང་ཐམས་ཅད་དུ་མ་ཡིན་པས་སོ།",
    "ལྡན་པའི་རྐྱེན་གྱི་དོན་ནི་གང་དུ་རྟོགས་པར་བྱ་བ་དེ་ཁོ་ན་ལྡན་པ་ཕྱིས་པས་ཀྱང་མཚོན་པར་བྱའོ།",
    "སྔར་ཁྱད་པར་དང་ཁྱད་པར་དུ་བྱ་བའང་གཟུང་ནས་འཇིག་རྟེན་གྱི་རྣམ་པར་གཞག་པ་ཡང་རྗེས་སུ་དྲན་པར་བྱས་ཏེ།",
    "རྣམ་པ་གཞན་དུ་ནི་ཞེས་པ་གལ་ཏེ་ཁྱད་པར་ནི་དྲན་པས་དྲངས་པ་ཉིད་དུ་འདོད་པ་མ་ཡིན་ནའོ།",
    "དེ་འདིས་གང་ཁྱད་པར་ལ་ལྟོས་པའི་ཤེས་པ་དེ་མངོན་སུམ་མ་ཡིན་པའམ།",
    "ཁྱབ་པར་བྱེད་པ་དང་འགལ་བ་དང་བསྒྲུབ་པར་བྱ་བ་གཉིས་པ་ལ་ལྟོས་པས་ནི་རང་བཞིན་གསུངས་ཤིང་།",
    "རིགས་པ་ཡང་མ་ཡིན་ཏེ་ཞེས་པ་དཔེ་ལ་བསྒྲུབ་པར་བྱ་བ་མ་ཚང་བའི་དོགས་པ་སེལ་བར་བྱེད་དོ།",
    "དེས་ན་ཅིའི་ཕྱིར་དེ་ལ་མངོན་སུམ་དུ་འགྱུར་ཞེས་རྫས་རྣམ་པར་བརྟག་པ་རྩོམ་པ།",
    "འཛིན་བྱེད་ཐ་དད་པ་ལ་གཟུགས་ལ་སོགས་པ་རྣམས་ཀྱི་གཅིག་མ་ཡིན་པ་ཉིད་དུ་རྣམ་པར་གཞག་གོ་ཞེ་ན།",
    "གདོན་མི་ཟ་བར་འཛིན་བྱེད་ཐ་དད་པར་འགྱུར་བར་འོས་སོ།",
    "རྫས་དེ་ཁོ་ན་རྣམ་པར་དཔྱད་པར་བྱ་བཞིན་པ་ཉིད་ཀྱི་ཕྱིར་དང་།",
    "དེས་ན་ཅི་ལྟར་དེ་རྗེས་སུ་དཔག་པས་རྣམ་པ་གཞན་དུ་བྱ་བར་ནུས་ཞེས་སྟོན་པར་བྱེད་དོ།",
    "དེ་ནུས་པར་འགྱུར་བ་ཁོ་ནའོ་ཞེས་པས་ལན་མ་ཡིན་ནོ།",
    "གྲངས་ལ་སོགས་པ་ཐ་དད་པས་ཀྱང་ཞེས་པ་གྲངས་དང་ཚད་རྣམས་དང་ཐ་དད་པ་ཉིད་དང་ལྡན་པ་དང་རྣམ་པར་དབྱེ་བ་དག་དང་གཞན་ཉིད་དང་གཞན་མ་ཡིན་པ་ཉིད་དག་དང་ལས་ཏེ།",
    "དེ་ལྟ་ན་འོ་ན་ཞེས་པ་རྣམ་པ་གཞན་དུ་ངེས་པར་བྱེད་པ་ཉིད་སྨྲས་སོ།",
    "ཕྱོགས་འདི་ལ་དེ་མ་ཐག་པར་བརྗོད་པའི་སྐྱོན་འཇུག་པ་མེད་དོ་ཞེས་སྟོན་པར་བྱེད་དོ།",
    "ཁྱབ་པར་བྱེད་པ་དང་འགལ་བའོ།",
