    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དང་།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པའོ།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་འདི་ཅི་ཞེ་ན།",
    "འདུ་ཤེས་མེད་པ་རྣམས་ཀྱི་སྙོམས་པར་འཇུག་པའམ་འདུ་ཤེས་མེད་པ་ཅན་ཡིན་པས་འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་སྟེ།",
    "དེ་བཞིན་ཞེས་བྱ་བའི་སྒྲས་ནི་དེ་ཙམ་ཞིག་མཐུན་པར་འདོན་ཏོ།",
    "སྙོམས་པར་འཇུག་པ་དེ་ནི་བསམ་གཏན་ཐ་མར།",
    "ཅིའི་ཕྱིར་འདི་ལ་སྙོམས་པར་འཇུག་ཅེ་ན།",
    "འདུ་ཤེས་མེད་པ་པ་ནི་རྣམ་པར་སྨིན་པ་ཡིན་པའི་ཕྱིར་ལུང་དུ་མ་བསྟན་པ་ཞེས་བྱ་བར་གྲུབ་བོ།",
    "དེ་ཡང་སོ་སོའི་སྐྱེ་བོ་ཁོ་ནའི་ཡིན་པར་འདོད་ཀྱི།",
    "སྐད་ཅིག་མ་གཉིས་པ་ལ་སོགས་པར་ནི་ཇི་སྲིད་མི་གཏོང་བ་དེ་སྲིད་དུ་ཐོབ་པ་འདས་པ་དང་ཡང་ལྡན་པ་ཡིན་ནོ།",
    "ད་ནི་འགོག་པའི་སྙོམས་པར་འཇུག་པ་གང་ཞེ་ན།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ཇི་ལྟ་བུར།",
    "འདིའི་ཁྱད་པར་ནི་འདི་ཡིན་ཏེ།",
    "རྣམ་པར་སྨིན་པའི་ཕྱིར་མ་ངེས་པ་ཡང་ཡིན་ཏེ།",
    "གལ་ཏེ་འདིར་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་བྱེད་ན་ནམ་ཡང་རྣམ་པར་མི་སྨིན་པ་ཁོ་ནར་འགྱུར་རོ།",
    "དེ་ཡང་གཅིག་ཏུ་འཕགས་པའི་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱིས་ནི་འགོག་པའི་སྙོམས་པར་འཇུག་པ་སྐྱེད་མི་ནུས་ཏེ།",
    "འཕགས་པའི་ཡང་འདི་ནི་འདོད་ཆགས་དང་བྲལ་བས་ཐོབ་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "འདི་ནི་སྦྱོར་བས་འཐོབ་པར་བྱ་བ་ཁོ་ན་ཡིན་པས།",
    "ད་ནི་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་འགོག་པའི་སྙོམས་པར་འཇུག་པ་མ་བསྐྱེད་ན་ཟད་པ་མཁྱེན་པའི་དུས་སུ་གཉི་གའི་ཆ་ལས་རྣམ་པར་གྲོལ་བར་ཇི་ལྟར་འགྲུབ་ཅེ་ན།",
    "དེ་ལྟར་ན་གནས་བརྟན་ཉེ་བསྲུངས་ཀྱི་ལུགས་ཀྱི་ཚིག་ནི་དེ་བཞིན་གཤེགས་པ་ནི་འགོག་པའི་སྙོམས་པར་འཇུག་པ་བསྐྱེད་ནས་ཟད་པ་མཁྱེན་པ་སྐྱེད་པར་མཛད་དོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "འདུ་ཤེས་མེད་པ་དང་འགོག་པའི་སྙོམས་པར་འཇུག་པ་འདི་གཉི་ག་ཡང་འདོད་པའི་ཁམས་དང་གཟུགས་ཀྱི་ཁམས་སུ་སྐྱེད་དོ།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དང་།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ལ་སྙོམས་པར་ཞུགས་པ་རྣམས་དང་།",
    "དེ་ལ་ཡང་ཁྱད་པར་ནི་འདི་ཡོད་དོ།",
    "དེར་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་ཡིད་ལས་བྱུང་བའི་ལུས་ཅན་གྱི་ལྷ་ནི་གཟུགས་ན་སྤྱོད་པ་ཡིན་པར་གསུངས་ལ།",
    "གལ་ཏེ་དེ་ངེས་པ་ཡིན་ན་ཇི་ལྟར་ཐོད་རྒལ་དུ་སྙོམས་པར་འཇུག་པ་དག་ཡིན་ཞེ་ན།",
    "དེ་ལྟར་ན་སྙོམས་པར་འཇུག་པ་འདི་གཉིས་ནི་ས་ལས་ཀྱང་ཁྱད་པར་ཡོད་དེ།",
    "ཡང་ཅིའི་ཕྱིར་འདི་དག་སེམས་དང་སེམས་ལས་བྱུང་བ་འགོག་པའི་རང་བཞིན་ཡིན་ན་འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དང་།",
    "དེ་དག་དང་མི་མཐུན་པས་དེ་དག་ལ་སྙོམས་པར་འཇུག་པར་སྦྱོར་བའི་ཕྱིར་ཏེ།",
    "ཁྱད་པར་དུ་བྱས་པའི་ཕྱིར་དེ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་བས་ན་བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ནི་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ནི་སེམས་མེད་པ་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ཇི་ལྟར་ན་སེམས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ཉིད་ཡིན་ཞེ་ན།",
    "ཡང་ན་སྙོམས་པར་འཇུག་པའི་སེམས་ཀྱིས་དེ་ལ་སྙོམས་པར་འཇུག་ཅིང་འཐོབ་པར་འགྱུར་བས་ན་སྙོམས་པར་འཇུག་པ་ཡིན་ནོ།",
    "ཡང་ཅི་སྙོམས་པར་འཇུག་པ་འདི་དག་རྫས་སུ་ཡོད་དམ་འོན་ཏེ་བཏགས་པར་ཡོད་ཅེ་ན།",
    "སྙོམས་པར་འཇུག་པའི་སེམས་ཁོ་ན་དེ་ལ་བགེགས་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་སྙོམས་པར་འཇུག་པ་ཞེས་གདགས་སོ།",
    "མི་འཇུག་པ་ཙམ་སྟེ་ཡང་སྔོན་མ་བྱུང་བ་དང་ཕྱིས་ལངས་པ་ལ་མེད་པ་ཡིན་པས་སྙོམས་པར་འཇུག་པ་འདི་ནི་འདུས་བྱས་སུ་བཏགས་སོ།",
    "ཡང་ན་རྟེན་ཉིད་དེ་ལྟར་མཉམ་པར་བསྒྲུབས་པས་ན་སྙོམས་པར་འཇུག་པ་ཡིན་ནོ།",
    "མི་འཇུག་པ་ཙམ་དེ་ཡང་འདུ་ཤེས་མེད་པ་པར་གདགས་སོ།",
    "ཞེས་གསུངས་ཏེ།",
    "དྲོད་དང་རྣམ་པར་ཤེས་པ་དེ་དག་ཉིད་ཡིན་ནོ།",
    "མ་ཤི་བའི་བར་དུ་རྣམ་པར་ཤེས་པ་ཐམས་ཅད་རྣམ་པར་སྨིན་པར་འགྱུར་དུ་འོང་ངོ།",
    "འོ་ན་ནི་དྲོད་ཀྱི་རྟེན་དུ་གྱུར་པ་ལས་ཡིན་པར་འགྱུར་ལ།",
    "དྲོད་ཀྱང་རྣམ་པར་ཤེས་པའི་རྟེན་དུ་གྱུར་པ་ཡིན་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ནི་གཟུགས་མེད་པ་དག་ན་དྲོད་མེད་པའི་ཕྱིར་རྣམ་པར་ཤེས་པ་རྟེན་མེད་པར་འགྱུར་རོ།",
    "དེའི་རྟེན་ནི་ལས་ཡིན་པར་འགྱུར་རོ།",
    "གང་ལ་ལར་ནི་རྣམ་པར་ཤེས་པའི་རྟེན་དྲོད་ཁོ་ན་ཡིན་པར་འགྱུར་རོ།",
    "དུས་འདི་སྲིད་ཅིག་ཏུ་གནས་པར་བྱའོ་ཞེས་ཇི་སྲིད་དུ་ལས་ཀྱི་རིས་མཐུན་པ་འཕངས་པ་དེ་སྲིད་དུ་དེ་གནས་པ་དེ་ལ་ཚེ་ཞེས་བྱ་སྟེ།",
    "གང་ཞིག་འདུ་བྱེད་ཅེས་བྱ་བ་ཡོན་ཏན་གྱི་ཁྱད་པར་འགའ་མདའ་ལ་སྐྱེ་སྟེ།",
    "མུ་དང་པོ་ནི་ཚེ་རྣམ་པར་སྨིན་པ་ཅན་གྱི་ལས་ཡོངས་སུ་གཏུགས་པ་ལས་སོ།",
    "གཉིས་པ་ནི་ལོངས་སྤྱོད་རྣམ་པར་སྨིན་པ་ཅན་གྱི་ལས་ཡོངས་སུ་གཏུགས་པ་ལས་སོ།",
    "ཚེ་བཏང་བ་ལས་ཀྱང་བརྗོད་པར་བྱའོ།",
    "ཚེ་རྒྱུད་ལ་རག་ལུས་ཏེ་འཇུག་པ་ཞེས་བརྗོད་པར་བྱའམ།",
    "ལན་ཅིག་སྐྱེས་ནས་གནས་པ་ཞེས་བརྗོད་པར་བྱ།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ལ་སྙོམས་པར་མ་ཞུགས་པ་རྣམས་ཀྱི་ནི་རྒྱུད་ལ་རག་ལུས་ཏེ།",
