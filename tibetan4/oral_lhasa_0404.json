    "དེ་ལྟ་བས་ན་རྒྱུན་ལ་འདུས་བྱས་ཀྱི་མཚན་ཉིད་འདི་དག་གསུངས་པ་ཡིན་ཏེ།",
    "གཞན་ཡང་གལ་ཏེ་མ་འོངས་པའི་སྐྱེ་བ་བསྐྱེད་པར་བྱ་བ་སྐྱེད་པར་བྱེད་པ་ཡིན་ནམ་འོངས་པ་ཐམས་ཅད་ཅིག་ཅར་ཅིའི་ཕྱིར་མི་བསྐྱེད།",
    "རྒྱུ་དང་རྐྱེན་དག་མེད་པར་ནི།",
    "རྒྱུ་དང་རྐྱེན་ཚོགས་པ་མེད་པར་ནི་སྐྱེ་བས་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་མི་རྟག་པ་ཉིད་ཀྱི་བར་དུ་ཅི་རིགས་པར་བརྗོད་པར་བྱའོ།",
    "འོ་ན་ནི་དེས་ན་བདག་མེད་པའི་བློ་འགྲུབ་པར་བྱ་བའི་ཕྱིར་བདག་མེད་པ་ཉིད་ཅིག་ཀྱང་འདོད་པར་བྱས་ལ།",
    "རྣམ་པར་ཕྱེ་བ་དང་།",
    "ཡོད་པ་ལ་སོགས་པའི་བློ་འགྲུབ་པར་བྱ་བའི་ཕྱིར་དང་།",
    "དྲུག་པར་བྱ་བའི་ཕྱིར་མུ་སྟེགས་བྱེད་ཀྱིས་ཡོངས་སུ་བརྟག་པ་གྲངས་དང་།",
    "རྣམ་པར་དབྱེ་བ་དང་།",
    "གཟུགས་ཀྱི་རང་བཞིན་ཞེས་བྱ་བ་དྲུག་པ་འདི་ཡང་ཇི་ལྟར་བརྟག་དེ་ལྟ་བས་ན་སྐྱེ་བ་ཞེས་བྱ་བ་འདི་ནི་མ་བྱུང་བ་ལས་བྱུང་བ་ཁོ་ནར་ཤེས་པར་བྱ་བའི་དོན་དུ་བརྟགས་པ་ཙམ་མཛད་པ་ཡིན་ནོ།",
    "མ་བྱུང་བ་ལས་བྱུང་བའི་མཚན་ཉིད་ཀྱི་སྐྱེ་བ་དེ་ཡང་རྣམ་པ་མང་དུ་ཡོད་པས་དེ་བྱེ་བྲག་ཏུ་བྱ་བའི་ཕྱིར་གཟུགས་ཀྱི་སྐྱེ་བ་ཞེས་དྲུག་པར་མཛད་དེ།",
    "ཅི་ནས་ཀྱང་གཟུགས་ཞེས་བྱ་བ་ཁོ་ན་སྐྱེ་བར་ཤེས་པར་བྱའི་གཞན་དུ་ནི་ཤེས་པར་མི་འགྱུར་བར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་གནས་པ་ལ་སོགས་པ་ལ་ཡང་ཅི་རིགས་པར་བྱའོ།",
    "གལ་ཏེ་སྐྱེ་བ་མེད་པར་སྐྱེ་ན་ནམ་མཁའ་ལ་སོགས་པའི་དུས་མ་བྱས་ཀྱང་ཅིའི་ཕྱིར་མི་སྐྱེ་ཞེ་ན།",
    "ཡང་ན་ཇི་ལྟར་སྐྱེ་བ་དང་ལྡན་པར་མཚུངས་པ་ལས་དེ་དག་ལས་གཞན་པའི་རྐྱེན་རྣམས་ཀྱིས་དེ་དག་ལས་གཞན་པ་བསྐྱེད་པར་ནུས་པ་མ་ཡིན་པ་དེ་བཞིན་དུ་ཐམས་ཅད་ཀྱིས་ཀྱང་འདུས་མ་བྱས་བསྐྱེད་པར་མི་ནུས་པར་འགྱུར་རོ།",
    "རི་དྭགས་དག་ཡོད་ཅེས་ཏེ་ནས་མི་རྨོ་བ་མ་ཡིན་པ་དང་སྦྲང་བུ་དག་ཡོད་ཅེས་ཏེ་ལ་དུ་མི་བཟའ་བ་མ་ཡིན་པ་ལྟར་སུན་འབྱིན་པ་དག་ཡོད་ཅེས་ཏེ་ལུང་དོར་དུ་མི་རུང་བས་དེ་ལྟ་བས་ན་སྐྱོན་རྣམས་ལ་ཡང་ལན་གདབ་པར་བྱ་ལ།",
    "ཡི་གེ་འབྲུའི་ཡན་ལག་རྣམས་གོ་བར་བྱ་བའི་ཕྱིར་ཡི་གེ་རྣམས་བྱས་པ་ནི་མ་ཡིན་གྱི།",
    "ཇི་ལྟར་ན་མིང་ཐོས་པ་བྲིས་པས་གོ་བར་འགྱུར་ཞེས་ཡི་གེ་རྣམས་གོ་བར་བྱ་བའི་ཕྱིར་ནི་ཡི་གེའི་འབྲུ་རྣམས་བྱས་པ་ཡིན་པས།",
    "འོན་ཏེ་སྒྲའི་ཁྱད་པར་དེ་ལྟ་བུ་ཞིག་མིང་སྐྱེད་པར་བྱེད་པ་ཡིན་པར་འདོད་ན་ནི་དེ་ཉིད་དོན་རྗོད་པར་བྱེད་པ་ཡིན་པར་འགྱུར་རོ།",
    "འོན་ཏེ་སྒྲའི་ཁྱད་པར་དེ་ལྟ་བུ་ཞིག་གསལ་བར་བྱེད་པ་ཡིན་པར་འདོད་ན་ནི་དེ་ཉིད་དོན་གསལ་བར་བྱེད་པ་ཡིན་པར་འགྱུར་རོ།",
    "ཡི་གེས་ནི་མིང་སྐྱེད་པར་བྱེད་དོ་སྙམ་དུ་རྟོག་པར་བྱེད་ན།",
    "ཡི་གེ་ཡང་ངག་ལས་ཁྱད་པར་དུ་ཡོད་པར་ཤེས་རབ་དང་ལྡན་པར་ཡིད་བརྟན་པས་ཀྱང་མཚན་ཉིད་ཀྱི་སྒོ་ནས་ཡོངས་སུ་བཅད་པར་མི་ནུས་པས་ངག་ནི་ཡི་གེ་སྐྱེད་པར་བྱེད་པ་ཡིན་པར་ཡང་མི་རུང་ལ།",
    "གསལ་བར་བྱེད་པ་ཡིན་པར་ཡང་མི་རུང་ངོ།",
    "སྐྱེ་པ་ལ་སོགས་པ་བཞིན་ནོ་ཞེས་བྱ་བར་འདོད་ན་ནི་དེ་ལྟ་ན་དོན་འདས་པ་དང་མ་འོངས་པའི་མིང་ད་ལྟ་བ་ཡིན་པར་མི་འགྱུར་རོ།",
    "ཞེས་གསུངས་པ་དེང་ཡང་དོན་རྣམས་ལ་མཚམས་བཅད་པའི་སྒྲ་ནི་མིང་ཡིན་ལ།",
    "མིང་རྣམས་བཀོད་པའི་ཁྱད་པར་ཡང་ཚིགས་སུ་བཅད་པ་ཡིན་པས་མིང་ལ་བརྟེན་པ་ཡིན་ནོ།",
    "རྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པའམ།",
    "ལུང་དུ་མ་བསྟན་པ་དག་ཅིག་ཅེས་བརྗོད་པར་བྱ་ཞེ་ན།",
    "འདི་དག་ནི་འདོད་པར་གཏོགས་པ་དང་།",
    "གང་ཞིག་རྗོད་པར་བྱེད་པ་དེ་དག་དང་ལྡན་གྱི་བརྗོད་པར་བྱ་བ་གང་ཡིན་པ་དང་ནི་མ་ཡིན་ནོ།",
    "རྣམ་པར་སྨིན་པའང་ཡིན།",
    "རྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པ་དག་ཡིན་ནོ།",
    "རྒྱུ་དང་རྐྱེན་དག་མེད་པར་ནི།",
    "སྐལ་མཉམ་མཚུངས་པར་ལྡན་པ་དང་།",
    "མཚུངས་པར་ལྡན་པའི་རྒྱུ་དང་།",
    "རྣམ་པར་སྨིན་པའི་རྒྱུའོ།",
    "ཟག་པ་གང་དག་མི་ཤེས་པ་དེ་ལ་སྐྱེ་བ་དེ་དག་ཤེས་པ་དེ་ལ་མི་སྐྱེའོ་ཞེས་གསུངས་པས་དེ་དག་སྐྱེ་བ་ལ་ཡང་ཤེས་པ་གེགས་བྱེད་ལ།",
    "སྐྱེ་བ་ལ་བགེགས་མི་བྱེད་པའི་ངོ་བོར་གནས་པའི་ཕྱིར་ཤེས་པར་བྱའོ།",
    "དེ་དག་མེད་དུ་ཟིན་ཀྱང་དེ་ཁོ་ན་བཞིན་དུ་བགེགས་བྱེད་མི་ནུས་པར་འགྱུར་ཏེ།",
    "སྤྱོད་པར་བྱེད་པར་མི་ནུས་བཞིན་དུ་ཡང་དེ་སྐད་དུ་འཛེར་བ་ཡོད་པས་འདིར་དཔེ་ནི་དེ་ཉིད་ཡིན་ནོ།",
    "སྲོག་གཅོད་པ་ལ་སོགས་པ་ལ་ཡང་གཤེད་མ་པ་བཞིན་དུ་ཐམས་ཅད་དེ་བསྟེན་པར་མི་འགྱུར་ཞེས་རྒོལ་བར་བྱེད་པ་དེའི་དེ་ནི་ཀླན་ཀར་མི་རུང་སྟེ།",
    "དེ་བཞིན་དུ་གཞན་ལ་ཡང་རྟོགས་པར་བྱ་སྟེ།",
    "སེམས་དང་མཚུངས་པར་ལྡན་པ་ཐམས་ཅད་དང་།",
    "འབྲས་བུ་ལ་སོགས་པས་ནི་འབྲས་བུ་དང་རྣམ་པར་སྨིན་པ་དང་།",
    "གཅིག་ཅེས་བྱ་བའི་སྒྲ་སྔ་མ་ནི་ལྷན་ཅིག་པའི་དོན་དུ་རིག་པར་བྱའོ།",
    "རྒྱུར་བྱས་པའི་གཟུགས་ཐོགས་པ་དང་བཅས་པ་ཕན་ཚུན་དང་།",
    "འོན་ཏེ་ཚོགས་པ་སྔར་བྱུང་བ་ཁོ་ན་མར་མེ་འོད་དང་བཅས་པ་སྐྱེ་བའི་རྒྱུ་ཡིན་ཞེས་བྱ་བ་འདི་དཔྱད་པར་བྱའོ།",
    "གང་ཞིག་ཡོད་དམ་མེད་ན་གང་ཞིག་ངེས་པར་ཡོད་དམ་མེད་པ་དེ་ནི་རྒྱུ་ཡིན་ཞིང་ཅིག་ཤོས་ནི་རྒྱུ་དང་ལྡན་པ་ཡིན་ལ།",
    "དེ་ལ་གཞན་ཡང་སྲིད་བུའམ་གཟེར་བུའམ་རྟེན་པར་བྱེད་པས་ཡང་ཅུང་ཟད་ཡོད་དོ།",
    "སཱ་ལུ་ནི་སཱ་ལུའི་ཡིན་ནོ་ཞེས་བྱ་བ་རྒྱས་པར་སྦྱར་བར་བྱའོ།",
    "འདས་པ་དང་ད་ལྟར་བྱུང་བ་རྣམས་ནི་མ་འོངས་པ་རྣམས་ཀྱི་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "དེར་ཇི་ལྟ་བ་དེ་བཞིན་འདིར་ཡང་བརྗོད་པར་བྱ་ལ།",
    "འདིར་ཇི་ལྟ་བ་དེ་བཞིན་དེར་ཡང་བརྗོད་པར་བྱའོ་ཞེས་སྒོ་གཉིས་སུ་བསྟན་པར་བྱ་བའི་བར་རོ།",
    "དེ་ལྟ་ཡིན་ན་ཡོན་ཏན་ཅི་ཞིག་འཐོབ་པར་འགྱུར་ཏེ།",
    "དེ་ལྟ་ན་འདིར་བསྟན་བཅོས་བྱེད་པ་མི་མཁས་པ་ཁོ་ནར་ཡིད་ཆེས་པར་འགྱུར་རོ།",
    "མ་གཏོགས་པ་གང་ཡིན་པ་དེ་ནི་འཇིག་ཚོགས་ལ་ལྟ་བའི་རྒྱུ་ལས་བྱུང་བ་ཡང་ཡིན་ལ་འཇིག་ཚོགས་ལ་ལྟ་བའི་རྒྱུ་ཡང་ཡིན་ནོ་ཞེས་གསུངས་སོ་ཞེ་ན།",
    "དེ་ནི་འདི་སྐད་དུ་འཇིག་ཚོགས་ལ་ལྟ་བ་མ་འོངས་པ་དང་མཚུངས་པར་ལྡན་པའི་སྡུག་བསྔལ་གྱི་བདེན་པ་མ་གཏོགས་པ་ཞེས་བརྗོད་པར་བྱ་བའམ།",
    "རྟེན་དང་དམིགས་པར་ངེས་སོ་ཞེས་བྱ་བ་འདི་ཇི་ལྟར་དང་།",
    "གལ་ཏེ་རྣམ་པར་སྨིན་པའི་རྒྱུ་བཞིན་དུ་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡང་མ་འོངས་པ་ཡིན་ན་ཅིར་འགྱུར་ཞེ་ན།",
    "བསྟན་བཅོས་ལས་དེ་སྨོས་པར་འགྱུར་རོ།",
    "འབྲས་བུ་འབྱིན་པ་དང་འཛིན་པར་བྱེད་ནུས་པ་གང་ཡིན་པ་དེ་ཁོ་ན་སྨོས་པའི་ཕྱིར་ཉེས་པ་མེད་དོ་ཞེ་ན།",
    "དེ་ལྟ་ན་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཡང་མ་འོངས་པ་ཡིན་པར་མི་འགྱུར་ཏེ།",
    "རྣམ་པར་སྨིན་པའི་འབྲས་བུ་སྔ་བ་དང་ལྷན་ཅིག་པ་མི་རུང་བའི་ཕྱིར་ལ།",
    "དེ་ལྟ་བས་ན་སྐལ་བ་མཉམ་པའི་རྒྱུ་ནི་གནས་སྐབས་ལས་རྣམ་པར་གནས་པ་ཁོ་ན་ཡིན་ལ།",
    "རྣམ་པར་སྨིན་པའི་རྒྱུ་ནི་མཚན་ཉིད་ལས་རྣམ་པར་གནས་པ་ཡིན་པས་མ་འོངས་པ་ཡང་མི་བཟློག་གོ།",
    "མི་ལྕོགས་པ་མེད་པ་དང་བསམ་གཏན་ཁྱད་པར་ཅན་དང་།",
    "མཉམ་དང་ཁྱད་པར་ཅན་གྱི་ཡིན།",
    "མི་སྐྱེ་བ་ཤེས་པ་ནི་ཁྱད་པར་ཅན་གཞན་མེད་པའི་ཕྱིར་མི་སྐྱེ་བ་ཤེས་པ་ཁོ་ནའི་ཡིན་ནོ།",
    "ཡང་ཇི་ལྟར་ས་གོང་མ་པས་འོག་མ་པའི་ལམ་དང་མཉམ་པའམ་ཁྱད་པར་ཅན་ཡིན་ཞེ་ན།",
    "དེ་ལ་རྒྱུས་ཤིན་ཏུ་རྒྱས་པར་བྱས་པ་ནི་མཐོང་བའི་ལམ་ལ་སོགས་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པ་དང་།",
    "ཁྱད་པར་ཅན་ཐམས་ཅད་དམན་པའི་ལྟ་བུའོ།",
    "དམན་པའི་ཕྱིར་རོ་ཞེས་གསུངས་སོ།",
    "གང་དག་ལ་རྟེན་མཚུངས་པ་ཡོད་པའི་སེམས་དང་སེམས་ལས་བྱུང་བ་དེ་དག་ནི་ཕན་ཚུན་དུ་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཡིན་ནོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་དེ་དང་མཚུངས་པར་ལྡན་པ་རྣམས་ཀྱི་ཡིད་ཀྱི་སྐད་ཅིག་མ་ཡིན་པའི་བར་དུ་ཡང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "མཚུངས་པ་ལྔས་མཚུངས་པར་ལྡན་པའི་དོན་གྱིས་ན་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཡིན་ཏེ།",
    "རྣམ་པར་སྨིན་པའི་རྒྱུ་གང་ཞེ་ན།",
    "འདི་ཇི་ལྟར་ཤེས་པར་བྱ།",
    "རྣམ་པར་སྨིན་པའི་རྒྱུ་ཞིག་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཡིན་ནམ།",
    "འོན་ཏེ་རྣམ་པར་སྨིན་པ་ཉིད་རྒྱུ་ཡིན་པས་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཡིན།",
    "ལས་ལས་སྐྱེས་པའི་ཕྱིར་ལ་ལས་ཀྱང་རྣམ་པར་སྨིན་པའི་རང་བཞིན་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་རྣམ་པར་སྨིན་པ་ཉིད་རྒྱུ་ཡིན་པས་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཡིན་ན་ནི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ཞེས་བྱ་བ་དེར་མི་འགྱུར་རོ།",
    "རྣམ་པར་སྨིན་པ་ནི་རྒྱུ་ཡིན་པའི་ཕྱིར་ལ་རྣམ་པར་སྨིན་པ་ཡང་ལས་ཀྱི་རང་བཞིན་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡང་རྣམ་པར་སྨིན་པ་ཞེས་བྱ་བའི་དོན་ཅི་ཞེ་ན།",
    "གཟུགས་ཀྱི་ཁམས་ན་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཕུང་པོ་གཅིག་ལ་རྣམ་པར་སྨིན་པ་གཅིག་པ་ཅན་ནི་ཐོབ་པ་དང་།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་སྐྱེ་བ་ལ་སོགས་པ་དང་བཅས་པའོ།",
    "ཕུང་པོ་གཉིས་པ་ནི་བསམ་གཏན་དང་པོའི་རྣམ་པར་རིག་བྱེད་སྐྱེ་བ་ལ་སོགས་པ་དང་བཅས་པའོ།",
    "ཕུང་པོ་ལྔ་པ་ནི་མཉམ་པར་བཞག་པ་ནའོ།",
    "གཟུགས་མེད་པའི་ཁམས་ན་རྣམ་པར་སྨིན་པའི་རྒྱུས་ཕུང་པོ་གཅིག་ལ་འབྲས་བུ་གཅིག་པ་ཅན་ནི་ཐོབ་པ་དང་འགོག་པའི་སྙོམས་པར་འཇུག་པ་སྐྱེ་བ་ལ་སོགས་པ་དང་བཅས་པའོ།",
    "བཅུ་གཅིག་སྨིན་པར་འགྱུར་བའི་ལས་དེ་ཡང་ཡོད་དེ།",
    "ལས་དུས་གཅིག་པའི་རྣམ་པར་སྨིན་པ་དུས་གསུམ་པ་རྣམ་པར་སྨིན་པ་ནི་མི་འགྱུར་གྱི་ལས་དུས་གཉིས་པའི་ཡང་དུས་གཅིག་པ་ནི་མ་ཡིན་ཏེ།",
    "རྣམ་པར་སྨིན་པ་ནི་ལས་དང་ལྷན་ཅིག་ཏུ་རྣམ་པར་སྨིན་པ་ཡང་མ་ཡིན་ལ་མཇུག་ཐོགས་སུ་ཡང་མ་ཡིན་ཏེ།",
