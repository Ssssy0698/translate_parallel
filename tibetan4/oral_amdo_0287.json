    "གང་གིས་ལྟ་བ་ཐམས་ཅད་མ་ལུས་ཤིང་།",
    "གང་གིས་དུས་གསུམ་འཇིག་རྟེན་སྐྱེས་པ་ཡི།",
    "བདག་གི་ལུས་དང་སྲོག་ཡོངས་སུ་བཏང་སྟེ།",
    "རང་གི་ལུས་ཀྱང་དྲལ་ཅིང་སློང་བ་ལ་ཁྲག་ཡོངས་སུ་གཏོང་བ་འམ།",
    "རང་གི་ལུས་ལས་ཡན་ལག་དང་།",
    "རྐ་ལག་ལས་སོར་མོ་ཡོངས་སུ་གཏོང་བ་འམ།",
    "ཡི་གེ་འབྲུ་གཅིག་གི་ཕྱིར་ཡང་རྒྱ་མཚོའི་མཐར་ཐུག་པའི་ས་ཆེན་པོ་ཡོངས་སུ་གཏོང་བ་འམ།",
    "རང་གི་ལུས་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ལ་རིམ་གྲོ་བྱེད་པ་འམ།",
    "སློང་བ་ལ་བུ་དང་བུ་མོ་དང་ཆུང་མ་དག་ཡོངས་སུ་གཏོང་བ་འམ།",
    "བཟའ་ཤིང་གི་ར་བ་སྦྱིན་པ་འམ།",
    "བསྐ་བ་སྣ་ཚོགས་ཀྱི་རོ་མཆོག་དང་ལྡན་པ་ཤིན་ཏུ་འཇམ་པའི་རོ་མཆོག་གི་རྣམ་པ་དང་ལྡན་པ།",
    "སེམས་དགའ་བ་དད་ཅིང་མོས་པ་དང་།",
    "ཡེ་ཤེས་མཆོག་གི་རོ་ལ་སེམས་རྣམ་པར་གཞོག་པར་གྱུར་ཅིག།",
    "ལུས་ཀྱིས་ཁྱུད་ན་ལུས་ལ་བདེ་བར་རེག་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཕ་དང་མ་རྣམས་ལ་སྦྱིན་པ་བྱེད་པའི་ཚེ་ཆུང་ངུ་ན་བདག་གི་ལུས་དང་དེ་མ་ཡིན་པའི་གཞན་བཀྲེན་པ་ཕོངས་པ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་རྟེན་ལ་སྤྱོད་པ་དང་།",
    "མོས་པ་རྣམ་པར་དག་པར་འགྱུར་བ་དང་།",
    "འཕགས་པའི་སྐྱེ་བོ་ལ་ཤིན་ཏུ་མོས་པའི་སེམས་ཀྱིས་གང་ཟག་གི་རྣམ་པ་ཉན་ཐོས་དང་།",
    "མེ་ཏོག་གི་རྒྱན་ཐམས་ཅད་ཀྱིས་ཆལ་པར་བཀང་བ།",
    "ཁྱུ་མཆོག་གི་མཐུ་འབྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐོབ་པར་གྱུར་ཅིག།",
    "རྫུ་འཕྲུལ་ཆེན་པོའི་ཁྱུ་མཆོག་གི་མཐུ་ཕྱུང་བའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐོབ་པར་གྱུར་ཅིག།",
    "སེམས་བསྐྱེད་པས་མོས་ཤིང་བསྟབས་པ་ཐམས་ཅད་གཏོང་བས་ཤིན་ཏུ་རེ་བའི་ཡིད་ཅན་དེ་དག་འོངས་པ་མཐོང་ནས།",
    "འདི་ལྟར་བདག་ཉིད་ཕྱོགས་དེ་དག་ཏུ་ཁྱོད་ཀྱི་དྲུང་དུ་སོང་སྟེ་རིམ་གྲོ་བྱ་བ་ཞིག་ན།",
    "དེ་འདི་ལྟར་ཁྱོད་འདིར་ཕྱིན་ཏེ་ཤིན་ཏུ་ངལ་བར་གྱུར་ཏོ།",
    "ངལ་བ་བསྟིས་ནས་ཅི་འདོད་པ་སྦྱིན་པ་དེ་དག་གིས་ཤིན་ཏུ་རིམ་གྲོར་བྱེད་དེ།",
    "འདི་ལྟ་སྟེ་བེ་ཌཱུརྱའི་ཤིང་རྟ་ཆུང་མའི་འཁོར་གླུ་དང་རོལ་མོ་བརྡུང་ཞིང་དཀྲོལ་བ་དང་ལྡན་པས་ཡོངས་སུ་བཀང་བ་དང་།",
    "འདི་ལྟ་སྟེ་དངུལ་གྱི་ཤིང་རྟ་ཤིན་ཏུ་མཛེས་པ་བུད་མྱེད་གཞོན་ནུ་ལྷའི་བུ་མོ་ལྟ་བུས་ཡོངས་སུ་གང་བ་དང་།",
    "འདི་ལྟ་སྟེ་ཤེལ་གྱི་ཤིང་རྟ་བུད་མྱེད་བཟང་མོ་བཞིན་བཟང་བ་ཆ་བྱད་སྡུག་གུ་ཤིན་ཏུ་བརྒྱན་པ་གཟུགས་མཛེས་པ་ལྟ་ན་སྡུག་ཅིང་མྱི་མཐུན་པ་མེད་པས།",
    "འདི་ལྟ་སྟེ་སྤོས་དམ་པའི་ཤིང་རྟ་བུ་དང་བུ་མོས་ཡོངས་སུ་བཀང་བ་དང་།",
    "དེ་རྣམ་པ་འདི་ལྟ་བུའི་ཤིང་རྟ་གྲངས་མྱེད་པ་རྣམ་པ་སྣ་ཚོགས་སློང་མོ་བ་ཐམས་ཅད་ལ་སྦྱིན་ཞིང་ཡོངས་སུ་གཏོང་བས་སློང་བ་འདོད་པར་བྱ་བའི་དངོས་པོ་རབ་ཏུ་ཐོབ་པས་ཡིད་ལ་བསམ་པ་ཤིན་ཏུ་རྫོགས་ནས་སློང་བ་དེ་དག་ཐམས་ཅད་སྦྱིན་པ་ཐམས་ཅད་སྦྱིན་པའི་ཚུལ་གྱིས་ཡང་དག་པར་བཟུང་སྟེ།",
    "ཁ་དོག་པད་མོ་ལྟ་བུ་གདོང་རྣམ་པར་དག་པ།",
    "གསེར་ལྟར་བལྟ་ན་མཛེས་པ་དཔག་ཚད་སྟོང་གི་ཁྱོན་དུ་ངལ་བ་མྱེད་པར་འགྲོ་བ་སྦྱིན་ཞིང་གཏོང་བ་འམ།",
    "སྟན་རེག་ན་བདེ་བ་གྲངས་མྱེད་པ་དུ་མ་བཏིང་བ།",
    "དེ་དང་དེ་དག་གི་རྒྱལ་པོ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་གྲངས་མེད་པ་ལ་ཁྲི་སྟན་བཟང་པོའི་རྣམ་པ།",
    "ཁྱུ་མཆོག་གི་མཐུ་ཕྱུང་བ་ཡང་དག་པར་སྟོན་པའི་ཕྱིར།",
    "ཉེ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་ལས་ཡོངས་སུ་འདས་ཏེ།",
    "གདུགས་གཅིག་གིས་ནམ་མཁའ་ཐམས་ཅད་ཀྱི་དབྱིངས་ཀྱིས་ཀླས་པ།",
    "འགྲོ་བ་ཐམས་ཅད་ཀྱིས་ཡེ་ཤེས་མཆོག་གི་གདུགས་རབ་ཏུ་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ཁ་དོག་དང་ཚོན་སྣ་ཚོགས་ཀྱིས་སྣམ་བུས་བརྒྱན་ཅིང་བསྒྲེང་བ།",
    "རྒྱལ་མཚན་གྱི་རྩེ་མོ་ཟླ་ཁམ་གྱིས་མཛེས་པར་བརྒྱན་པ།",
    "རྒྱལ་མཚན་གྱི་རྒྱན་རྣམ་པ་དུ་མ་འོད་དང་ལྡན་པས་རབ་ཏུ་བརྒྱན་པའི་རྒྱལ་མཚན་རྣམ་པ་སྣ་ཚོགས་བསྒྲེང་བའི་རྒྱན་དེ་ལྟ་བུ་དག་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ཀྱི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ལ་མོས་པའི་རྒྱལ་མཚན་གྱི་རྒྱན་གྱིས་ཀུན་ཏུ་ཁྱབ་པར་བྱ་བ་དང་།",
    "ཡངས་པ་ཀུན་ཏུ་རྒྱལ་མཚན་གྱི་སྦྱིན་པ་ཡོངས་སུ་གཏོང་བར་མོས་པས་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་རྒྱས་པར་བྱ་བ་དང་།",
    "གང་ཟག་གི་རྣམ་པ་གཞན་སུ་འང་རུང་སྟེ།",
    "ཟབ་མོ་ཐམས་ཅད་དང་ལྡན་པར་བྱ་བའི་ཕྱིར་ཡོངས་སུ་བསྔོའོ།",
    "ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་གྱི་རྒྱན་དུ་རེད་པར་གྱུར་ཅིག།",
    "མྱི་ཟད་པའི་མཛོད་དང་ལྡན་ཞིང་ཚིག་གི་རྒྱན་གྱིས་ཤིན་ཏུ་བརྒྱན་པར་གྱུར་ཅིག།",
    "ལྟུང་གི་བཅིང་བས་བཅིངས་པ།",
    "ལུས་ལྕགས་ཐག་གིས་བཏགས་པ།",
    "བརླ་ལྕགས་སྒྲོག་གིས་བསྒྲོགས་པ་དེ་ལྟ་བུ་དག་མཐོང་ནས།",
    "སྐྱེ་བོ་བརྒྱ་ཕྲག་སྟོང་གིས་ཀུན་ནས་བསྐོར་ཅིང་འཛམ་བུའི་གླིང་དུ་གཏོགས་པ་སྣ་ཚོགས་ནས།",
    "ལུས་འདི་ཡོངས་སུ་གཏོང་གིས་ངའི་སྲོག་གཅད་པར་གྱིས་ཤིག།"
  ]
}