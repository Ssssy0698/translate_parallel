    "དེ་དག་ཀྱང་བདག་གི་ལུས་འདི་བདེ་བས་ནི་བདེ་བར་འགྱུར།",
    "བདག་གི་ལུས་འདི་སྡུག་བསྔལ་བས་ནི་སྡུག་བསྔལ་བར་འགྱུར་རོ།",
    "ད་ནི་བདག་གིས་ལུས་ལ་ཆགས་པ་ལས་རྣམ་པར་འདའ་བར་བྱའོ།",
    "བདག་གིས་འཐོབ་པར་བྱ་བ་ལེགས་པར་ཐོབ་པོ།",
    "བདག་གིས་འདི་དག་ཀྱང་ཟད་ཀྱང་རུང་།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་ལུས་ལས་ལག་པ་འམ།",
    "ཅེས་རྒྱལ་པོ་ལ་ཐག་ཐོགས་མེད་པར་རང་གི་ལུས་བདག་ཅག་བྱིན་ན།",
    "དེ་ལ་སེམས་བསྐྱེད་པ་འགའ་ཙམ་ཡང་འགྱོད་པར་འགྱུར་བ་མེད་པ་འདི་ནི་ནང་གི་གཏོང་བ་ཞེས་བྱའོ།",
    "ཁྱོད་ནི་བདེ་བའི་ཡོ་བྱད་ཐམས་ཅད་དང་ལྡན་ན།",
    "འདི་སྐད་དུ་ཁྱོད་ཀྱིས་ནི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་སྔོན་ཆད་ཀྱང་མྱོང་།",
    "བྱམ་བུ་འཁོར་ལོ་སྒྱུར་བའི་སྲིད་བདག་ཅག་བྱིན་ལ་ཁྱོད་ཀྱིས་བདག་ཅག་རིམ་གྲོར་བྱ་བ་དང་།",
    "འདི་སྐད་དུ་བདག་ཅག་ནི་ཁྱོད་ཀྱི་ལེགས་པ་དང་ཡོན་ཏན་སྙན་པ་ཐོས་ནས།",
    "ཁྱོད་ནི་གདོན་མི་ཟ་བར་བདག་ཅག་གི་བསམ་པ་ཡོངས་སུ་ཚིམ་པར་བྱེད་པར་འགྱུར་སྙམ་སྟེ།",
    "འདིར་ཕྱིན་ན་བྱམ་བུ་ཁྱོད་ཀྱིས་བདག་ཅག་གི་བསམ་པ་ཡོངས་སུ་རྫོགས་པར་གྱིས་ཤིག་ཅེས་ནས།",
    "ནུབ་བྱང་གི་ཕྱོགས་མཚམས་དང་།",
    "འོག་དང་སྟེང་གི་ཕྱོགས་སུ་རྗེས་སུ་མི་མཐོང་སྟེ།",
    "ངན་སོང་གི་ལམ་ཉེ་བར་གནས་པ་བཟློག་པར་བྱ་བ་དང་།",
    "ལུས་དང་མི་ལྡན་པ་གྲངས་མེད་པ་ཞིག་གིས་འདི་སྐད་དུ་བདག་ཅག་ལ་ཅི་མེད་པ་དེ་ཁྱོད་ཀྱིས་བྱིན་ལ།",
    "ཁྱོད་ནི་བསྐལ་པ་གྲངས་མེད་པར་མི་ལྡན་པར་འདུག་ཅིག་ཅེས་ཟེར་ན།",
    "རུས་པ་སྩོགས་པ་ཤ་དང་ཁྲག་གིས་གཡོགས་པ།",
    "སེམས་བསྐྱེད་པ་གཅིག་གིས་ཀྱང་ཆགས་པ་མི་བསྐྱེད་དོ།",
    "མི་ཟད་པ་ཤིན་ཏུ་བསྟན་པ་བཅུ་པོ་དེ་དག་གིས་ཤེས་རབ་ཀྱི་གཏེར་ཏེ་མི་ཟད་པ་ཡིན་ནོ།",
    "ཉོན་མོངས་པ་སྣ་ཚོགས་གཅིག་ནས་ཉོན་མོངས་པ་སྣ་ཚོགས་བརྗོད་དུ་མེད་པའི་ཡང་བརྗོད་དུ་མེད་པའི་བར་དང་།",
    "ཕས་ཀྱི་རྒོལ་བ་ཐམས་ཅད་ཀྱིས་ཉེ་བར་ཉོན་མོངས་པར་མི་ནུས་པ་ཡིན།",
    "ཉོན་མོངས་པ་སྣ་ཚོགས་གཅིག་ཀྱང་ཡོངས་སུ་འཛིན་ཏོ།",
    "ཉོན་མོངས་པ་སྣ་ཚོགས་བརྗོད་དུ་མེད་པའི་ཡང་བརྗོད་དུ་མེད་པའི་བར་དུ་ཡང་ཡོངས་སུ་འཛིན་ཏོ།",
    "ཉོན་མོངས་པ་སྣ་ཚོགས་གཅིག་དང་།",
    "ཡི་གེ་ཐམས་ཅད་ཀྱི་སྤོབས་པས་སྟོན་པའི་རྗེས་སུ་སོང་བ་དང་།",
    "མི་ཟད་པའི་རྣམ་པ་བཅུ་པོ་འདི་དག་གིས།",
    "ནུབ་བྱང་གི་ཕྱོགས་མཚམས་དང་།",
    "འོག་དང་སྟེང་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ན་ཡང་གླིང་བཞི་པ་འདི་ལ་སྩོགས་པ་གླིང་རེ་རེ་ན་ཡང་།",
    "པོག་རེ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་བརྒྱན་པ།",
    "མེ་ཏོག་གི་བླ་རེ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་ཀུན་ནས་བྲེས་པ།",
    "སྤོས་ཀྱི་བླ་རེ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་སྤོས་ཀུན་ཏུ་འཐུལ་བར་སྦྱར་བ།",
    "མེ་ཏོག་གི་གདུགས་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་ཀུན་ནས་བསྒྲེང་བ།",
    "གོས་ཁ་དོག་མཐའ་ཡས་པའི་བླ་རེ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་སྣ་ཚོགས་སུ་སྣང་བར་བཀབ་པ།",
    "གདུགས་ཀྱི་བླ་རེ་ཁ་དོག་རྣམ་པ་སྣ་ཚོགས་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་རབ་ཏུ་གཡོགས་ཤིང་རྣམ་པ་སྣ་ཚོགས་སུ་སྣང་བ།",
    "གསེར་གྱི་བླ་རེ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་ཡིད་དུ་འོང་བར་བཀབ་ཅིང་རྣམ་པར་དག་པར་བྱས་པ།",
    "བེ་ཌཱུརྱའི་བླ་རེ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་ལྷ་རྫས་དྲི་མ་མེད་ཅིང་ཤིན་ཏུ་དག་པར་བྱས་པ།",
    "ལྷ་རྫས་ཀྱི་མེ་ཏོག་གི་རྒྱལ་མཚན་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུ་མེ་ཏོག་ཐམས་ཅད་ཀྱི་ཆར་དུ་འབབ་པ།",
    "ལྷ་རྫས་ཀྱི་སིལ་སྙན་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུ་གླུ་དང་རོལ་མོར་སྦྱར་བ་དང་ལྡན་པ།",
    "སྤྲུལ་པའི་རོལ་མོ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་སྒྲ་བརྙན་གྱི་ཚོགས་ལྟ་བུར་ཤེས་པར་བྱས་པ།",
    "ཡིད་ཀྱི་རང་བཞིན་གྱི་ལྷ་རྫས་ཀྱི་རོལ་མོ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་རོལ་མོའི་སྒྲ་ཡིད་དུ་འོང་བ་དང་།",
    "ལྷ་རྫས་ཀྱི་རོལ་མོར་གཏོགས་པ་སྣ་ཚོགས་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་ཡིད་དགའ་བ་དང་ཞི་བའི་སྒྲ་ཕྱུང་བ།",
    "ཟབ་མོར་བསྟོད་པ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་ཤིན་ཏུ་བསྒོམས་ཤིང་བསྟོད་པ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གསུང་གི་ལྡེམ་པོ་དག་རབ་ཏུ་རྟོགས་པར་རྣམ་པར་བསྟོད་པ།",
    "རོལ་མོ་དང་སིལ་སྙན་གྱི་སྒྲ་ཕྱུང་བ་དང་ལྡན་པ།",
    "རྣམ་པར་འཕྲུལ་པ་བྱེ་བ་བརྒྱ་སྟོང་ཕྲག་བཅུས་རྗེས་སུ་སོང་བ།",
    "མོས་པ་འདི་ལྟ་བུ་དང་།",
    "ལྷའི་བུ་མཐའ་ཡས་པས་ཀྱང་རང་རང་གི་ལུས་ཀྱི་སྤྲིན་ནི་ཤིན་ཏུ་བཀྱེ།",
    "ལྷའི་བུ་མོ་གྲངས་མེད་པ་དག་ཀྱང་དགའ་ཞིང་མོས་པའི་སེམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་རབ་ཏུ་སེམས་སོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཆོ་འཕྲུལ་བསམ་གྱིས་མི་ཁྱབ་པས་རོལ་མོ་བཀྲོལ་བ་དང་།",
    "ལྷའི་བུ་མོ་རྣམས་ཀྱང་བཅོམ་ལྡན་འདས་ལ་ནི་ལྟ།",
