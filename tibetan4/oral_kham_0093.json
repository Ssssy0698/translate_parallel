    "དཔེ་མི་སྲིད་པ་བཞིན་དུ་ཅི་ཙམ་སྨད།",
    "གཞན་ཡང་རང་མཚན་གཅིག་པའི་གཉེན་ཚན་སོགས།",
    "འདི་ལྟར་ཙ་ནས་འའི་བར་གྱི་དཀྱུས་གཅིག་ཏུ་ཡོད་པའི་ཡི་གེ་བདུན་ཀ་ཙ་ཚ་ཛ་ཝ་ཞ་ཟ་འ་བདུན་ལ་ཙ་རྟགས་ཡོད་ཐུ་མིས་གསར་དུ་བསྣན་པ་ཡིན་ཅིང་།",
    "ངེད་ཀྱི་སེམས་ལ་ནི་ལྷ་ས་བྱ་བ་ཡང་རྒྱལ་རབས་དང་དཔེ་རྙིང་རྣམས་ལ་ར་ས་བྱ་བ་ལས་ལྷ་ས་བྱ་བ་ཡེ་མི་འདུག་ཅིང་།",
    "རྭ་བ་གོང་འོག་རྭ་ཆེ་ཆུང་སོགས་སྔོན་གྱི་མིང་འདོགས་ཚུལ་ཅི་བས་མང་བ་ཞིག་གོདེའི་ཕྱིར་རྭ་ཞེས་པ་ཁྱིམ་དང་ཁང་བའི་མིང་དུ་བྱེད་པ་འདུག་ལ།",
    "རྒྱ་ནག་ནི་ས་གཤིན་ཅིང་དྲོ་བའི་རྒྱ་གར་གྱི་མེ་ཏོག་ལྗོན་པ་སོགས་རང་སྐད་དུ་བསྒྱུར་ནས་ཡུལ་གྱི་མི་ལ་ངོ་སྤྲོད་ཐུབ་པས་བཙུན་པ་ཐང་ཟན་ཙང་སོགས་ཀྱིས་ཚིག་ཐམས་ཅད་ཁ་ཐད་དུ་བསྒྱུར་བ་ཡོད་འདུག་པས།",
    "ལས་བགོས་གྱིས་རང་རང་ས་ནས་ཁ་སྣོན་ཇེ་རྒྱས་སུ་བཏང་།",
    "ཞེས་ཕལ་ཆེར་ཁུ་ཚུར་གནམ་ལ་སྒྲེང་ནས་ཁྲོམ་སྐོར་ལ་ཕེབས་ཉེ་འདུག་ཀྱང་།",
    "སྒྲ་ཟུང་ལྡན་དང་རང་བྱུང་དབྱངས་ཀྱི་འགྱུར་ཁུགས་སོགས་ལ་ཚོད་འཛིན་བྱས་པས།",
    "བོད་ཀྱི་རྩོམ་དངོས་མ་ནི་འདི་ཚོ་ཡིན་འདུག་སྟེ།",
    "ཚིག་གསལ་ཆེ་བར་བྲིས་ཚེ་ཀུན་གྱིས་གྲོང་ཚིག་ཅེས་སྨྲ་བ་ཡིན་གདའ་སྟེ།",
    "ངེས་པར་ལྷའི་ཡུལ་དང་རྨི་ལམ་གྱི་ཞིང་ལྟ་བུ་ཞིག་ཏུ་གྲུབ་འདུག་སྟེ།",
    "ཨ་ཙི་གཞན་ཚོ་ཚིག་པ་ཟ་ལས་ཚེ།",
    "ལག་ཆ་ཞིག་ལ་ངོས་འཛིན་བྱེད་བགྱི་འདུག་ཀྱང་།",
    "བྱ་བའི་དཔེ་ཡང་འདུག་ཅེས་བྱུང་།",
    "ལོ་པཎ་གཉིས་འདུག་པར་ཕྱག་ལས་མཉམ་དུ་གནང་བ་ཡིན་གསུངས་པ་འདི་ཙམ་ལ་ཡང་དཔྱད་ན།",
    "སྐད་བརྡའི་ཐད་གསར་རྩོམ་གྱི་རྣམ་པ་དང་ལོ་ཙཱ་བའི་ལྟ་བ་ཤུགས་ཆེ་བས་སྙན་ངག་ཤིན་ཏུ་མཛེས་ཤིང་རང་མི་རིགས་ཀྱིས་དང་ལེན་བྱེད་སླ་བ་ཡིན།",
    "སྒྲོལ་མ་ལ་གསོལ་བ་བཏབ་རྒྱུ་ཡོད་སྙམ་པ་ཡོང་རྒྱུ་འདུག་ང་བཙོན་དུ་སྡོད་པའི་རིང་ལ་སྒྲོལ་མ་འབུམ་གཅིག་བསགས་ཐུབ་བྱུང་ཞེས་གསུངས་བྱུང་།",
    "ལྷའི་རྣམ་པ་སོགས་མང་པོ་ཟེར་ཀྱང་ཡིན་ངེས་པ་བྱང་སེམས་ཁྱིམ་པའི་རྣམ་པར་འདུག་སྙམ།",
    "ཞལ་རས་མིའི་རྣམ་པ་ཆེར་གསལ་བ་དག་འདུག་སྐུ་བརྙན་དེ་དག་ཀྱང་ད་ལྟ་གསུང་འབྱོན་ནམ་སྙམ་པ་ལྟ་བུ་མཆིས།",
    "དེས་ན་ཕལ་ཆེར་ད་ལྟའི་ཡོ་རོབ་པའི་རིགས་དང་འདྲ་པོ་ཞིག་ཡིན་འདུག་གོ་ཞེས་བྱུང་།",
    "བདེ་བ་ཅན་གྱི་ཞིང་བཀོད་ཀྱང་རྒྱུའི་བྲིས་ཆ་རྒྱ་ནག་ནས་ཡིན་འདུག་པ་ལྷམ་ཡུ་རིང་དང་།",
    "མེས་དབོན་གྱི་ལྷ་ཁང་རྣམས་ན་ཡང་ཁྲོ་བའི་གཟུགས་རྣམས་དེ་ཁོ་ནར་འདུག་པས།",
    "ཕལ་ཆེར་འབྲོག་ཁྱིམ་གྱི་རྣམ་པར་ཆགས་ཡོད་ཚོད་དུ་འདུག་འདྲེ་ལ་སོགས་པ་ལ་དཔྲལ་བ་ན་མིག་གཅིག་དང་།",
    "བོད་སྐྲ་བཞར་ཞེས་པའི་གཏམ་དཔེ་ཡང་འདུག་འབྲུག་པ་རྣམས་ཀྱང་ཐམས་ཅད་སྐྲ་ཧྲིལ་པོར་བྲེགས་པ་ཡིན།",
    "གླུ་ཁོ་རང་ཡང་།",
    "དབུས་གཙང་དུ་ལྷ་པ་རྣམས་ཀྱིས་གྱོན་རྒྱུ་བཙན་ཞྭ་བྱ་བའི་ཞྭ་ཁུག་མའི་དབྱིབས་སམ་མདའ་ཤུབས་ལྟ་བུའི་རིང་པོ་ཞིག་འདུག་ཅིང་།",
    "དགོད་བྲོ་བའི་ཡ་མཚན་པ་ཞིག་འདུག་གོ།",
    "ཕལ་ཆེར་འབྲོག་ཁྱིམ་གྱི་རྣམ་པར་ཆགས་ཡོད་ཚོད་དུ་འདུག་ཞེས་བོད་པའི་གནས་སྟངས་དང་བསམ་བློ།",
    "ཕྲན་གྱི་ལས་བསྐོས་ནི་འདི་ག་རང་དུ་འདུག་པས།",
    "གཞན་གཅན་གཟན་འདུག་པ་དུག་སྦྲུལ་དང་།",
    "སོགས་བོན་རྒན་རྣམས་ཀྱི་གསུང་རིས་འཁྲུལ་མེད་ཅིག་འདུག་གོ།",
    "བྱ་བའི་ཚིག་སྡུད་ཡིན་པར་བྱས་ན་གངས་སེང་བྱ་བའི་ཐ་སྙད་ཀྱང་རང་སོར་བཞག་ཆོག་པས་ཁྱེད་རྣམས་ལ་གནོད་བསྐྱལ་བ་ཅི་ཡང་མེད་དོ།",
    "ཡང་ན་གོམ་གསུམ་བོར་ནས་འགྱེལ་བ་ཤ་སྟག་ཏུ་འདུག་ཅེས་སྨྲས་པ་ཡིན།",
    "གསན་ནས་ཏིང་ངེ་འཛིན་དེ་ལས་བཞེངས་ཏེ་འདུན་ཁང་ག་ལ་འདུག་པར་གཤེགས་སོ།",
    "ཀྱེ་མ་བདག་སེང་གེའི་ཁྲི་ལ་འདུག་ཅིང་སྟེང་དུ་གདུགས་དཀར་པོ་ཐོགས་ལ་རྔ་ཡབ་ནོར་བུའི་ཡུ་བ་ཅན་ཡང་ཐོགས་ན་ཅི་མ་རུང་སྙམ་སྟེ།",
    "དེ་ལས་ལྷའི་སེང་གེའི་ཁྲི་གང་ལ་འདུག་ན།",
    "ཚམ་ཚོམ་མེད་པར་སེང་གེའི་ཁྲི་ལ་འཛེགས་ནས་འདུག་གོ།",
    "སེང་གེའི་ཁྲི་ཡངས་ལས་མི་བདུན་གྱི་སྲིད་ཙམ་དུ་ནམ་མཁའ་ལ་འཕགས་ཏེ་འདུག་གོ།",
    "བདག་སྔོན་ཤིན་ཏུ་དབུལ་ཞིང་འདུག་འདུག་པ་ལས།",
    "བདག་ཉིད་པད་མའི་སྟེང་ན་འདུག་པ་ཡང་རྨིས་སོ།",
    "མ་ཧེ་དང་ལྡན་པར་འདུག་སྟེ།",
    "འདུག་ནས་ཕུ་བོ་དེ་དག་ལ་སྔོན་བྱུང་བའི་གཏམ་གྱི་ཡང་དག་པར་གློད་པ་ངེས་པར་བྱེད་པས་ཕྱིར་མགུ་བར་བྱས་ཏེ།",
    "མ་ཧེ་དང་ལྡན་པར་འདུག་སྟེ།",
    "དུང་སྒྲིལ་མ་བུས་ནས་དགེ་སློང་ཞིག་འཁོར་ཕལ་པོ་ཆེའི་ནང་ན་འདུག་ཅིང་།",
    "གདུགས་དང་མཆིལ་ལྷམ་ཟུང་ཅིག་དང་པ་ཎ་ལྔའི་འགྲོན་བུ་རྣམས་མ་གཏོགས་པར་ཅི་བདོག་པ་ཁྱིམ་ན་འདུག་པ་དང་།",
    "ཕྱི་རོལ་ན་འདུག་པ་ཐམས་ཅད་རྒྱན་སྐུགས་སུ་ཡལ་ནས་སྡུག་བསྔལ་དང་ཡིད་མི་བདེ་བ་མི་བཟད་པས་གདུངས་ཏེ།",
    "དབུགས་ཚ་བ་རྒྱུན་རིངས་པོའི་ཤུགས་ཕྱུང་སྟེ་ཅང་མི་ཟེར་བར་འདུག་གོ།",
    "རྒྱལ་པོའི་རྐང་པ་ལ་གཏུགས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "སེམས་ནི་ཀུན་ནས་དཀྲིས་ཤིང་འདུག།",
    "མིག་མི་ཉམས་པར་དེ་བཞིན་དུ་འདུག་པ་དང་།",
    "ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "འབྲས་བུ་མེད་པར་འགྱུར་སྙམ་ནས་བདག་ཉིད་སྨོད་བཞིན་དུ་རྒྱལ་པོའི་མདུན་ན་དམན་པའི་བཞིན་གྱིས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ལ་ལ་ནི་མི་རྟག་པ་ཉིད་ཀྱི་སྟོབས་དང་ལྡན་ཞེས་སེམས་སྡུག་བསྔལ་དང་བཅས་ཤིང་ཡིད་མི་བདེ་བ་དང་ལྡན་པས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "སེར་སྣའི་སེམས་ཀྱི་དྲི་མ་སྐྱེས་པས་ཀུན་ནས་དཀྲིས་ཏེ་མ་འདུག་ཅིག།",
    "སེར་སྣའི་སེམས་ཀྱི་དྲི་མ་སྐྱེས་པས་ཀུན་ནས་དཀྲིས་ཏེ་འདུག་གོ།",
    "དགའ་བ་དང་བདེ་བ་དང་དྲན་པ་མངོན་དུ་བཞག་ནས་འདུག་གོ།",
    "སེར་སྣའི་སེམས་ཀྱི་དྲི་མ་སྐྱེས་པ་ཀུན་ནས་དཀྲིས་ཏེ་འདུག་པར་མི་བྱའོ།",
    "སེར་སྣའི་སེམས་ཀྱི་དྲི་མ་སྐྱེས་པས་ཀུན་ནས་དཀྲིས་ཏེ་འདུག་པར་མི་བྱའོ།",
    "ནུ་ཞོ་ཡང་རང་བྱུང་བས་རྒྱལ་བུའི་མཚན་ཡང་དོན་གྲུབ་ཅེས་བཏགས་སོ།",
    "མྱ་ངན་ཆེན་པོས་ནོན་ནས་མི་དགའ་ཞིང་འདུག་པ་ལ།",
    "དྲུང་ན་འདུག་པའི་གཡོག་ལ་བལ་གྱི་གླང་པོ་ཆེ་ལ་གསེར་དངུལ་གྱི་སྒ་བསྟད་དེ་མྱུར་དུ་ཁྲིད་དེ་ཤོག་ཅིག་ཅེས་བསྒོ་བ་དང་།",
    "གནས་སུ་ནི་གུར་དང་ཡོལ་བས་བསྐོར་བ་ན་འདུག།",
    "ཡུམ་གྱིས་རྒྱལ་བུ་འགྲོའོ་ཞེས་མཆི་ཕྱག་བྱས་པ་མཐོང་ནས་ལྷག་པར་མྱ་ངན་གྱིས་གདུངས་ཏེ་དྲུང་ན་འདུག་པ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ད་འདིར་འདུག་པར་གྱུར་ན་རྒྱལ་པོའི་བཀའ་དང་འགལ་ཏེ།",
    "རི་དེ་རད་རོད་དང་ཟད་ཟེད་དུ་འདུག་ལ་ཤིང་མང་པོ་རབ་ཏུ་རྒྱས་ཤིང་བྱ་སྣ་ཚོགས་ཀྱང་སྙན་པའི་སྒྲ་འབྱིན།",
    "ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "རྒྱལ་བུ་ཁྲིད་དེ་འདུག་པའི་གནས་བསྟན་ཏོ།",
    "བདག་འདུག་པའི་རྩྭའི་སྤྱིལ་པོ་ཆུང་ངུ་མ་གཅིག་བྱས།",
    "རྒྱལ་པོ་ཡབ་རྒྱལ་བུ་མཐོང་བར་དགའ་བས་བདག་འདིར་རྒྱལ་བུ་ཕྱིར་འགུགས་སུ་འོངས་སོ་ཞེས་སྨྲས་མ་ཐག་ཏུ་རྔོན་པས་ཀྱང་བཀྲོལ་ཏེ་བཏང་ནས་སྔར་མ་རྟོགས་ཏེ་རྒྱུས་མ་ཤེས་སོ་ཞེས་བཟོད་པ་གསོལ་ནས་རྒྱལ་བུ་གང་ན་འདུག་པའི་གནས་བསྟན་ཏོ།",
    "རྒྱལ་བུས་ནང་དུ་ཁྲིད་ནས་སྟན་ལ་འདུག་ཏུ་བཅུག་སྟེ།",
    "ལམ་ཀར་སྐྱེད་ཤིང་ཞིག་ཡོད་པ་ལ་བུ་གཉིས་བཏགས་ཏེ་འདུག་གོ།",
    "བུའི་མ་རི་ལ་འདུག་པའི་རྐང་པ་གཡོན་པའི་རྐང་མཐིལ་གཡའ་ཞིང་གཡོ་བ་དང་མིག་གཡོན་པ་ཡང་འགུལ་ནུ་མ་གཉིས་ནས་ནུ་ཞོ་ཡང་རང་ཟག་པར་གྱུར་ནས།",
    "བདག་ཉིད་འདུག་པའི་སྤྱིལ་བུར་བལྟས་ན་ཡང་བུ་མ་མཐོང་།",
    "བུ་གཉིས་འདུག་པའི་སྤྱིལ་པོར་བལྟས་ན་ཡང་བུ་མ་མཐོང་སྟེ།",
    "བདག་འདུག་པ་ན་གཉིས་ཀ་གཡས་གཡོན་ན་འདུག་ཅིང་།",
    "སྔོན་རྒྱ་ལས་འགྱུར་བའི་བརྡ་རྙིང་པར་འདུག། ། རྒྱ་གར་སྐད་དུ།",
    "དེ་ལྟར་བདག་དང་འཇིག་རྟེན་རྟག་པ་ནི་མི་འགྲོ་བ་འགྲོ་བ་མེད་པ་བསྒྱུར་དུ་མི་རུང་བ་ཐེར་ཟུག་ཏུ་གནས་པ་ལྕགས་ཀྱི་སྡོང་པོ་ལྟར་འདུག་པ་སྟེ།",
    "དེའི་ཚེ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་བཅོམ་ལྡན་འདས་ཀྱི་སྣམ་ལོགས་ན་འདུག་ཅིང་བསིལ་ཡབ་ཐོགས་ནས།",
    "བཀྲ་མི་ཤིས་པའི་མཚན་མ་དག་གདའ་བ་འདི་ཅི་ལགས་བསྟན་དུ་གསོལ།",
    "ཁྲོན་པ་འདི་ནི་སྦྲུལ་གདུག་པ་འདུག་པའི་ཁྲོན་པ་ཡིན་ནོ།",
    "དེའི་དྲུང་དུ་ཕྱིན་ནས་ལུས་ཀྱི་རྒྱན་ཐམས་ཅད་ཀྱང་བཀྲོལ་ནས་གོས་ཀྱང་ཕུད་ནས་ཕྱོགས་གཅིག་ཏུ་བཞག་ནས་ལུས་དྲང་པོར་བསྲང་སྟེ་འདུག་གོ།",
    "འདུག་མ་ཐག་ཏུ་རྒྱལ་ཕྲན་རྣམས་དང་།",
    "རབ་ཏུ་མི་དགའ་བའི་མྱ་ངན་གྱིས་གདུངས་ནས་སྟོན་པ་དྲུག་འཁོར་དང་བཅས་པ་ལྷན་ཅིག་ཏུ་འདུག་སྟེ་འདི་སྐད་ཅེས་བགྲོས་སོ།",
    "དེ་ལྟ་བུ་ཡིན་ཡང་སླ་འདི་ལྟར་གང་ན་འདུག་སྟོན་ཅིག།",
    "ད་ལྟར་སྤྱིལ་པོའི་ནང་ན་འདུག་གོ་ཞེས་སྨྲས་སོ།",
    "དེར་འདུག་ཤིག་དང་།",
    "དེ་དག་མཐོང་ནས་མི་འདི་དག་ཅི་བྱེད་ཅེས་གཡོག་པོ་གཡས་གཡོན་ན་འདུག་པ་ལ་དྲིས་སོ།",
    "རྒྱལ་པོ་དང་ཕྲད་འདོད་པས་ད་ལྟར་སྒོ་ན་འདུག་གོ་ཞེས་ཕྲིན་གྱིས་ཤིག་ཅེས་བསྒོའོ།",
    "དེ་ནས་ཀླུའི་རྒྱལ་པོ་རབ་ཏུ་དགའ་ཞིང་རངས་པར་གྱུར་ཏེ།",
    "བདག་དུར་ཁྲོད་ཅིག་ན་འདུག་པར་ཕྱིན་པ་ན།",
    "དེའི་ཚེ་ན་རྒྱལ་བུ་དགེ་དོན་ལམ་ཀ་ཞིག་ན་འདུག་པ་ལས་རྫིའུ་དེས་གནག་ཕལ་པོ་ཆེ་དེད་ནས་དེར་ཕྱིན་པ་དང་།",
    "འདུག་པ་དང་།",
    "གདོད་སའི་འོག་ན་སྦས་ཤིང་འདུག་གོ་ཞེས་སྨྲས་སོ།",
    "དེའི་ཚེ་ཀུན་དགའ་བོ་འབའ་ཞིག་དེ་བཞིན་གཤེགས་པ་དང་མ་བྲལ་ཏེ་འདུག་གོ།",
    "བདག་ཀྱང་ཁྱེད་དང་ལྷན་ཅིག་ཏུ་འདུག་གོ་ཞེས་སྨྲས་ནས་དེ་ན་ལྷན་ཅིག་ཏུ་འདུག་གོ།",
    "དེ་ནས་དེ་བཞིན་གཤེགས་པས་ཐུགས་རྗེའི་ཤུགས་ཀྱིས་ཤཱ་རིའི་བུར་སྤྲུལ་ནས་འཁོར་གྱི་ནང་ན་འདུག་པར་བྱས་ནས་འཁོར་མང་པོ་དེ་དག་ཤཱ་རིའི་བུ་དེ་མཐོང་ནས་མི་དགའ་བའི་སྡུག་བསྔལ་ཞི་ནས་ཕྱིར་རབ་ཏུ་དགའ་བར་གྱུར་ཏོ།",
    "གདན་ལ་འདུག་ནས་བདག་སྐྱིད་དོ་ལེགས་སོ་ཞེས་སྨྲས་སོ།",
    "དེ་ནས་བྲམ་ཟེ་ཞིག་འདུག་པས་ཤཱག་རིགས་རྣམས་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "བདག་ཅག་རྣམས་བྲམ་ཟེ་འདི་དང་ལྷན་ཅིག་འདུག་ཅིང་འགྲོགས་པའི་མི་རིགས་སོ་སྙམ་བསམས་ནས་ཤཱག་རིགས་རྣམས་འདུས་ནས་བྲམ་ཟེ་ཡུལ་དེ་ནས་བསྐྲད་དོ།",
    "ཆུ་འགྲམ་ན་འདུག་འདུག་པ་ལས་ཕྱིས་ཆུ་བྲུག་པ་བྲི་ནས་བུ་ཆེན་པོ་ཚུ་རོལ་དུ་བཞག།",
    "བདག་བུ་བཙའ་ཞིང་འདུག་པས་སྒོ་འབྱེད་མ་ནུས་སོ།",
    "ཁྱིམ་པར་འདུག་ཀྱང་སྐྱབས་སུ་འགྲོ་བ་གསུམ་དང་།",
    "མི་རྒོད་ཁྱེད་རྣམས་འདི་ན་འདུག་པར་སྔ་ནས་ཤེས་ཀྱང་བདག་ཀྱང་མ་སྨྲས་ཏེ།",
    "བདག་རྒྱུད་ཀྱིས་རྔོན་པ་བྱེད་བྱེད་དེ་གནས་ན་གཅན་གཟན་ལ་སྤུ་གསེར་དུ་འདུག་པ་ཡང་མ་ཐོས་ན་མཐོང་བ་ལྟ་ཅི་སྨོས་ཏེ།"
  ]
}