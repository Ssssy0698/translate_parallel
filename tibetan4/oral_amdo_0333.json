    "རྒྱ་རྒྱད་ལ་སོགས་པའི་མིང་གི་རྣམ་གྲངས་མཐའ་ཡས་པས་བསྟན་ནོ།",
    "སད་བྱེད་ཀྱི་རྐྱེན་བཟང་པོས་རང་བཞིན་དུ་གནས་པའི་རིགས་སད་པའི་ཁམས་ཀྱི་ནུས་པ་རྒྱས་འགྱུར་གྱི་རིགས་ཀྱི་ས་བོན་ལྟ་བུར་སོང་བའི་ཕྱིར་རོ།",
    "དེ་རྣམ་པ་གང་ཡང་རུང་བ་ཞིག་གི་ལྷའི།",
    "གང་གིས་ཕྱིས་ལྷའི་རྣམ་པ་བདག་དང་བཅས་པ་དེ་དག་ང་ད་ཅིང་མ་སྐྱེས་ཁ།",
    "དྷོ་ཧཾ་ཞེས་པའི་ཨ་ཧཾ་གི་དོན་ནི།",
    "ཁོགས་འདོན་སྤྱོད་པ་ལ་སོགས་པ་ཐམས་ཅད་ཡེ་ཤེས་གཅིག་གི་རྣམ་རོལ་དུ་ཁྱེར་བའི་ཐབས་མཁས་ཀྱི་ཁྱད་པར་དང་ལྡན་པའི་ཕྱིར།",
    "ཡན་ལག་ཁྲོ་བོ་ཁྲོ་མོ་སྟེ་རྡུལ་དུ་གསིལ་ནས་བསྒོམས་པས་རིལ་པོར་འཛིན་པ་བཟློག།",
    "དེས་ལུས་དབེན་དུ་སོངལ་གང་ཟག་གི་བདག་བཟློག་པས་ཤེས་བྱ་ཉན་ཐོས་དང་ཐུན་མོང་བ་ཞེས་བྱ།",
    "དོན་དམ་པའི་འོད་གསལ་ལ་ཟབ་མོ་ཞེས་བསྙད་པ་ཡིན་ནོ།",
    "དེ་ཉིད་བཅུ་དྲུག་རིག་པའི་ས་མོས་སྤྱོད་ལ་བྱེ་པ་ཞིག་གསུངས་པ་བཞིན་ནོ།",
    "སྟོང་འོག་གི་དབྱེ་བ་ཡོད་པའི་གནས་མ་ཡིན་ཏེ།",
    "སེམས་ནི་བདག་གི་རྣམ་རྟོག་གི།",
    "གངཤེས་རབ་ཀྱི་མགོ་གིས་རཔྱད་པས་མ་རྙེད་པའི་སྟོང་པ་ཉིད་མངོན་སུམ་དུ་རྟོགས་པ་དང་།",
    "དེ་འོག་མ་མོའི་འོད་སྣང་འགྱུར།",
    "དེ་ནི་རང་བཞིན་རྣམ་དག་གི་ཆ་ནས་བལྟོ་དགོས་པང་བཞག་པ་མ་ཡིན་གྱི།",
    "རང་གི་མཚན་ཉིད་པ་པོ་རང་གིས་རིག་པར་བྱ་བས་ཐ་དད་དུར་བྱེད་མི་ཤེས་པ་ཟུང་འཇུག་སྟེ་གཞན་རྐྱེན་གྱིས་རྟོགས་པར་བྱེ་དམི་ནུས་པའི་གཤིས་དེ་ནི་རང་བཞིན་དག་ས་ལ་དང་།",
    "དེ་ལྟ་ནརང་བཞིན་གྱིས་འོད་གསལ་བར་མ་སོང་བས་རང་བཞིན་འོདགས་ལ་ཡིན་པའི་ཕྱིར་གསལ་བྱེད་གཞན་ལ་མི་བལྟོས་སོ།",
    "དེ་བས་ན་རང་བ་ཞིན་རྣམ་དག་གི་ཆ་ཡ་བ་ལྟོས་ནས་བལྟོས་མི་དགོས་པ་དང་།",
    "ཕྱི་རོལ་བས་འདོད་པའི་བདག་གི་རྣམ་གྲངས་སྣ་ཚོགས་སུ་ཁས་ལེན་པ་དེ་དག་ནི་ཀུན་རྫོབ་ཙམ་དུ་ཡང་ཡོད་པུམ་ཡིན་པའི་ཕྱིར།",
    "དེ་དག་གི་བླང་དོར་ཚུལ་བཞིན་དུ་འཇུག་པ་ལོ་བའི་ཕྱིར།",
    "ཐེག་མཆོག་ལ་མོས་ས་བོན་ཤེས་རབ་ནི།",
    "རྣམ་པར་ཤེས་པའི་རྐྱེན་དེས་འཕྱང་བ་བཤི་རླངས་པས་ཉོན་མོངས་བའི་ཡིད་ཅེས་བྱ་བའི་མིང་ཐོབ་ལ།",
    "དེ་གང་གིས་སྟོ་བཔའི་དགག་བྱ་ནི་ཀུན་བཏགས།",
    "ཐལ་མོ་བརྡེབ་པ་ཙམ་ལ་བདག་དང་གཞན་དུ་རྟོག་པའི་སྣང་བ་གཡོའོ།",
    "བྲངས་ཅིག་བུད་ཙམ་ཕྲ་ལ་མོ་བརྡེབ་པ་ཙམ་ལ་རང་བཞིན་རྣམས་རྗེས་སུ་མྱོང་བར་འགྱུར་རོ།",
    "དེ་དག་གི་ཚོགས་པ་མི་ཤིགས་པརི་ཆ་ནས་མི་ཤིགས་པའི་ཐིག་ལེ་ཞེས་གྲགས་ཤིང་།",
    "འགྲོ་བ་རྣམས་ཤི་བ་མི་སྲིད་པར་ཐལ་བ་དང་།",
    "གང་ཟག་གི་བདག་ཡོད་པར་བྲལ་བ་དང་།",
    "གང་ཟག་གི་མཚན་གཞི་རྫས་པ་ར་ཐལ་བ་དང་།",
    "བདག་ཡིནན་ལྡན་པ་མ་ཡིན་པའི་འདུ་བྱེད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "ཁྱོད་དེལབལྟོས་པའི་གང་ཟག་གི་མཚན་གཞི་ཡིན།",
    "རྣམ་པར་ཤེས་པ་ལ་བདག་གི་སྒྲ་དངོས་སུ་སྦྱོར་ཏེ།",
    "སློདཔོན་འདིའི་བཞེད་ཀྱིས་གང་ཟག་གི་མཚན་གཞི་ནི།",
    "ཡོད་པའིཆ་ཅུང་ཟད་རེ་ཡང་མི་རྙེད་ཅིང་ཡོད་པར་པས་མི་ལེན་ནོ།",
    "ལས་དང་འབྲས་བུལ་སོགས་ཊ་སྦ་མས་ཅད་ཁ་དག་རྟག་པ་མེད་ཀྱང་ཕུང་པོ་སྐད་ཅིག་གིས་འཇིག་པའི་རྒྱུན་དེ་ཉིད་ལས་འབྲས་ཀྱི་རྟེན་དུ་གསལ་བར་གསུངས་ལ།",
    "སྐབས་འདིར་རང་རེའི་རྒྱུད་པ་ཞེས་པ་ནས།",
    "འོན་ཀྱང་ཁྱོད་ཀྱིས་བྱས་པའི་ཆོག་ཁྲིགས་དེར།",
    "གི་ལུགས་ལ་ཡང་།",
    "ཡང་དག་ཀུན་རྫོབ་ཀྱི་མཚན་གཞི་གཞན་མེད་དུ་ཐལ་ཏེ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཞེས་གནས་ཚུལ་དོན་དམ་པར་ཁྱོད་དུ་བྱེད་པའི་གང་ཟག་ཡིན་དགོས་པའི་ཕྱིར།",
    "དེ་བས་ན་བདག་གི་དོན་སྤྱི་ཕུགས་ཀྱི་འཁྲུལ་རྒྱུས་བསླད་པའི་ཕྱི་རོབཡང་དག་ཀུན་རྫོབ་དང་།",
    "ཁྱོད་ལྟར་ན་མ་རིག་པ་ལྷན་སྐྱེས་དེ་གནས་ཚུལ་ལ་ཞུགས་པ་དང་འཕགས་པའི་ཡེ་ཤེས།",
    "སེ་རཔོ་དེ་དུང་གི་གཤེས་སམ་དུང་གི་མདངས་ལ་མ་གྲུབ་པ་དང་།",
    "གལ་ཏེ་སེར་པོ་དུང་གི་གཤིས་སམ་གདངས་ཀ་ལ་ཡོད་ནའང་།",
    "རྡོ་རྗེ་རྩེ་མོ་ལས།",
    "ཀུན་ནས་ཉོན་མོ་ངས་འཕེལ་བའི་དམིགས་པར་གྱུར་པ་དེ་ཀུན་རྫོབ་བདེན་པའི་མཚན་ཉིད་དུ་བཞག་ནས།",
    "གཟུང་འཛིན་ག་ཉིས་སྟོང་གི་དེ་ཁོ་ན་ཉིད་ལྟ་བུ་ལ་ངོས་འཛིན་པ་འོ།",
    "དངོས་པོའི་གནས་ཚུལ་ཡིན་པས་དབྱེ་བ་མེད་མོད་ཀྱིཀྱི།",
    "སེམས་ཉིད་ཀུན་ཆུ་སོང་པའོ།",
    "དེའི་གཟིགས་ཕུལ་མི་བསླུ་བ་ཡིན་པས་བདེན་པའོ།",
    "འདིས་གཟིགས་ཚུལ་ཡང་།",
    "ཞེས་སྨྲ་རྟོག་གི་ཡུལ་ལས་འདས་པ་དང་།",
    "མགོན་པོ་དེ་ནི་ཡིན་པར་བ་ཤད།",
    "དེབས་ན་མཐར་ཐུག་གི་གནས་ཚུལ་དེར་ན་ཀུན་རྫོབ་ཀྱི་བདེན་པ་པ་ནག་ཏུ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གདུལ་བྱ་གཞན་སྣང་གིས་བསྡུས་པའི་སྐུ་གཉིས་ཀུན་རྫོ་བཏུ་བཞག་པ་ཤིན་ཏུ་སྤྲོས་པས་ཆོག་གོ།",
    "སྒྲུབ་མཐའ་སྨྲ་བ་བཞི་ཀས་གང་ཟག་གི་བདག་ཅེས་བྱ་བ་རང་ལུགས་ལ་ཅུང་ཟད་ཀྱང་ཁས་མི་ལེན་བྱས་པ་ལ།",
