    "མི་རྟག་པ་ཉིད་ལ་ཞུགས་ནས་སྲེད་པ་དང་ལྟ་བའི་ཀུན་ནས་ཉོན་མོངས་པ་ལས་སེམས་རྣམ་པར་སྦྱངས་ཏེ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བའི་ཕྱོགས་དང་མཐུན་པ་རྣམས་སོ།",
    "དེ་ལ་ཀུན་ནས་ཉོན་མོངས་པའི་ཕྱོགས་དང་མཐུན་པ་གང་ཡིན་པ་དེ་དག་ནི་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པ་ལས་འབྱུང་ངོ།",
    "གང་གི་ཕྱིར་དགེ་སློང་སྔོན་ཐོས་པ་དང་བསམས་པ་ལས་བྱུང་བའི་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པས་ལུས་ལ་སོགས་པ་ལ་ལུས་ལ་སོགས་པ་ཙམ་དུ་ལྟ་བ་དྲན་པ་ཉེ་བར་གཞག་སྟེ།",
    "གང་གི་ཕྱིར་དགེ་སློང་ནི་གཉེན་པོ་རྣམ་པ་གསུམ་ལ་ཇི་ལྟར་འདོད་པ་བཞིན་ཐོབ་པ་དང་།",
    "ཕྱི་མ་ལ་ངན་སོང་གི་སྡུག་བསྔལ་ལ་གནས་པར་འགྱུར་བའི་ཕྱིར་ཉེས་པར་སྤྱོད་པའི་རྩ་བ་དང་།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ལ་བརྩོན་པའི་དགེ་སློང་ནི་འཇིག་རྟེན་པའི་ལམ་གྱིས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འདོད་པ་རྣམས་ལས་དབེན་པ་ཞེས་བྱ་བ་ནས་རྒྱས་པར་སྲིད་པའི་རྩེ་མོའི་སྙོམས་པར་འཇུག་པའི་བར་དུ་བསྒྲུབས་ཏེ་གནས་སོ།",
    "འདི་ལ་དགེ་སློང་ལུས་ལ་སོགས་པ་ལ་ལུས་ཀྱི་རྗེས་སུ་ལྟ་ཞིང་གནས་པ་ནི་ནང་དུ་སེམས་གནས་པ་རྣམ་པ་དགུས་སེམས་རྣམ་པར་སྡུད་པར་བྱེད་མོད་ཀྱི།",
    "གལ་ཏེ་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ལ་སེམས་ཤིན་ཏུ་བརྟན་པར་གནས་པས་ཉེ་བའི་ཉོན་མོངས་པ་སྐྱས་པར་རིག་ནས།",
    "རྒྱས་པར་རབ་ཏུ་འཛིན་པའི་སྒོ་ནས་དེ་ལ་དམིགས་པའི་སེམས་མཉམ་པར་འཇོག་ལ་ཉེ་བའི་ཉོན་མོངས་པ་ཞི་གནས་ཀྱི་མི་མཐུན་པའི་ཕྱོགས་དེ་ལས་ཀྱང་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ།",
    "དེ་ནས་ཉེ་བའི་ཉོན་མོངས་པ་དེ་ལས་སེམས་རྣམ་པར་གྲོལ་བར་རིག་ནས།",
    "གང་གི་དོན་དུ་ཕྱི་རོལ་དུ་ཆེད་དུ་གཏད་པའི་དོན་དེ་ཐོབ་པས་ན།",
    "ཕྱིས་ཉེ་བའི་ཉོན་མོངས་པ་དེས་ཉེ་བར་ཉོན་མོངས་པར་མི་འགྱུར་རོ།",
    "འབད་པ་དང་བཅས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ནང་གི་ཞི་གནས་ལ་རང་གི་སེམས་གཏད་པ་ལས་མཚན་མ་འདི་ལྟར་གཟུང་བར་བྱ་སྟེ།",
    "བདག་གིས་ཅི་ཞིག་ཡིད་ལ་བྱས་ཤིང་།",
    "བདག་གིས་ཇི་ལྟར་ཡིད་ལ་བྱས་ན་སེམས་ཞི་གནས་ལ་གཏད་པ་ན།",
    "ཞི་གནས་ཀྱི་ཕྱོགས་ཀྱི་ལུས་དང་སེམས་ཀྱི་རྨུགས་པ་དང་ཞུམ་པས་ཉེ་བར་ཉོན་མོངས་པར་འགྱུར་ལ།",
    "ཅི་ཞིག་ཇི་ལྟར་ཡིད་ལ་བྱས་ན་ནི་ཉེ་བར་ཉོན་མོངས་པར་མི་འགྱུར་སྙམ་དུ་མཚན་མ་གཟུང་བར་བྱའོ།",
    "གལ་ཏེ་དགེ་སློང་དེས་དེ་ལྟར་རང་གི་སེམས་ལ་མཚན་མ་མ་བཟུང་ནས་ནི་ཀུན་ནས་ཉོན་མོངས་པ་དེས་སེམས་དེ་ཉེ་བར་ཉོན་མོངས་པར་འགྱུར་བར་རིག་ནས།",
    "དེའི་རྒྱུས་རེ་ཞིག་དེས་ཉེ་བའི་ཉོན་མོངས་འབྱུང་ཞིང་མངོན་སུམ་དུ་གྱུར་བ་དེ་སྤོང་མོད་ཀྱི།",
    "འདི་ལྟར་སྔར་རང་གིས་སེམས་ལ་མཚན་མ་མ་བཟུང་བའི་ཕྱིར་དང་།",
    "དེ་རྒྱུ་དེ་དང་ཉེ་བའི་ཉོན་མོངས་པ་དེས་ཕྱིར་ཞིང་བཅོམ་པར་འགྱུར་ཏེ།",
    "ཤིན་ཏུ་ཡུན་རིང་པོར་ཡང་ནང་གི་སེམས་ཀྱི་ཞི་གནས་དེ་ཐོབ་པར་མི་འགྱུར་རོ།",
    "ནང་གི་སེམས་ཀྱི་ཞི་གནས་མ་ཐོབ་པས་ནི་ལྷག་པའི་སེམས་ལས་བྱུང་བ་ཚེ་འདི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཟས་དང་གོས་རྒྱ་ཆེན་པོ་ལྟ་བུ་ནི་ནང་གི་སེམས་ཀྱི་ཞི་གནས་ལ་སོགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་དེ་ལ་ཉེས་དམིགས་སུ་ལྟ་བས་ཀུན་ནས་དཀྲིས་པ་དེ་བག་ལ་ཉལ་དང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རིགས་ཀྱི་བུ་བདག་ལ་ཕན་པར་འདོད་པ་ཞིག་དེར་རྐྱེན་དང་ཕྲད་ནས་རབ་ཏུ་བྱུང་བ་ལ་འདི་སྐད་དུ་ཁྱོད་ཚུར་ངའི་ཡོ་བྱད་ཐམས་ཅད་ལ་ཐུན་མོང་དུ་ལོངས་སྤྱོད་ཅིང་འདུག་ལ།",
    "ཁྱོད་ཀྱིས་ངའི་བསྔགས་པ་ཡང་གཞན་དག་ལ་བརྗོད་ཅིག།",
    "ངས་ཀྱང་ཁྱོད་ལ་དེ་བཞིན་དུ་བྱའོ།",
    "བདག་ཅག་གཉིས་གཅིག་གིས་གཅིག་བསྲུང་ན།",
    "དེ་བས་ན་ཁྱོད་དང་བདག་གིས་ཀྱང་བདག་ཉིད་དེ་མ་ཡིན་པ་ཞིག་གིས་བསྲུང་དགོས་སོ།",
    "དེ་མ་ཡིན་པ་བདག་གིས་ཁྱོད་བསྲུངས་སམ་ཁྱོད་ཀྱིས་བདག་བསྲུངས་ན་ནི་བསྲུང་བར་མི་འགྱུར་རོ་ཞེས་སྨྲས་ན།",
    "ཚེ་ཕྱི་མ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཉོན་མོངས་པ་དང་ཡང་བཅས་པས་ན།",
    "དེས་ན་ཉོན་མོངས་པ་དང་བཅས་པའི་ཕྱིར་བདག་ཉིད་ཀྱང་བསྲུང་བ་མ་ཡིན་ལ།",
    "བདག་བསྲུང་བའི་ཕྱིར་ཉོན་མོངས་པ་སྤང་བར་བྱའོ།",
    "སློབ་པའི་སའི་ཕྱིར་མི་འོང་བ་རྣམས་ལ་ནི་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིན་ལ་བྱེད་པ་དང་ལྡན་པའི་སེམས་སྤྲེའུ་ལྟ་བུ་གཅིག་གི་གནས་ནི་ཡོད་ལ།",
    "འཆི་བདག་གི་གནས་ཞེས་བྱ་བ་ནི་སྲིད་པའི་རྩེ་མོ་མན་ཆད་དེ་གང་ལས་དགྲ་བཅོམ་པ་འདས་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ལོངས་སྤྱོད་པ་ཕུན་སུམ་ཚོགས་པ་ནི་ལུས་གང་གི་གོས་ཙམ་དང་།",
    "ལྟོ་གང་གི་ཟས་ཙམ་གྱིས་ཆོག་པར་འཛིན་པ་དང་།",
    "སྟོབས་བཞི་པས་ནི་ཏིང་ངེ་འཛིན་གྱི་མི་མཐུན་པའི་ཕྱོགས་ཀྱི་ཉོན་མོངས་པ་རྣམས་སྤངས་པ་དང་མ་སྤངས་པར་སྤྱོད་ཅིང་རབ་ཏུ་ཤེས་ལ་ཏིང་ངེ་འཛིན་ལ་གནས་པ་དང་ལྡན་པའི་མཚན་མ་རྣམས་རབ་ཏུ་ཤེས་ཤིང་རྟོགས་སོ།",
    "ཞི་གནས་དང་ལྷག་མཐོང་གི་ཉེ་བའི་ཉོན་མོངས་པ་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པའི་གཉེན་པོ་ཡང་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་རབ་ཏུ་ཤེས་ཏེ།",
