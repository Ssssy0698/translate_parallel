    "སྟོང་པ་ཉིད་སོ་སོར་བརྟག་པའི་འདུ་ཤེས་ཀྱི་བར་དུ་བསྒོམ་མོ།",
    "དེ་ལ་རྣམ་པར་བསྔོས་པ་ལ་སོགས་པ་ནས་བམ་པ་ལ་ཐུག་པ་རྣམས་ནི་ཁ་དོག་གི་འདོད་ཆགས་ཀྱི་གཉེན་པོའོ།",
    "རུས་པ་དང་ཀེང་རུས་ཀྱི་འདུ་ཤེས་ནི་རེག་པའི་འདོད་ཆགས་ཀྱི་གཉེན་པོའོ།",
    "དགེ་སྦྱོང་གི་ནི་ཚུལ་རྣམས་དང་།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་སྐྱེ་བ་ལ་ནི་ཕྱི་ནང་གི་སྟོབས་ཐམས་ཅད་ཀྱི་ནང་ན་སྟོབས་གཉིས་ཀུན་གྱི་མཆོག་ཡིན་ནོ།",
    "ནང་གི་རྣམས་ཀྱི་ནང་ན་ནི་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པ་དང་མཚུངས་པར་ལྡན་པའི་ཤེས་རབ་མ་གཏོགས་པར་དེ་མ་ཡིན་པའི་སྤོང་བའི་ཡན་ལག་རྣམས་ནི་ནང་གི་སྟོབས་རྣམས་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཉོན་མོངས་པ་དེས་ཀུན་ནས་བསླང་བའི་ཡང་སྲིད་པར་སྐྱེ་བའི་ལས་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པ་དང་བྲལ་བས་ན་ཉེ་བའི་ཉོན་མོངས་པ་དང་བྲལ་བ་ཞེས་བྱའོ།",
    "ཉོན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ངན་སོང་དུ་འགྲོ་བར་འགྱུར་བས་ན་གནོད་པའོ།",
    "ཡང་དག་པའི་དགེ་སྦྱོང་གི་ཚུལ་གྱི་སྒོ་ནས་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་དགེ་སྦྱོང་གི་ཚུལ་གྱི་དོན་གྱིས་རྣམ་པར་གཞག་སྟེ།",
    "དགེ་སྦྱོང་གི་ཚུལ་དེ་ཡང་དག་པར་ལེན་ཏོ།",
    "ཡང་དག་པའི་དགེ་སྦྱོང་གི་ཚུལ་དེ་དང་ལྡན་པ་གང་ཡིན་པ་དེ་ཡང་ཡང་དག་པའི་དགེ་སྦྱོང་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་བས་ན་དེ་ལ་དགེ་སྦྱོང་གི་ཚུལ་གྱི་དོན་ཞེས་བྱའོ།",
    "དགེ་སྦྱོང་གི་ཚུལ་གྱི་དོན་དེ་ཡང་རྣམ་པ་གཉིས་སུ་རིག་པར་བྱ་སྟེ།",
    "འབྲས་བུ་ལ་གནས་པའི་བྱེ་བྲག་གིས་རྣམ་པར་གཞག་པའོ།",
    "དགེ་སྦྱོང་གི་ཚུལ་དང་།",
    "དགེ་སྦྱོང་གི་ཚུལ་གྱི་དོན་དང་།",
    "དགེ་སྦྱོང་གི་འབྲས་བུའོ།",
    "གེགས་དང་ཉེ་བའི་ཉོན་མོངས་དང་།",
    "རྟོག་དང་འབྲས་བུ་གོང་ན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཞི་གནས་ཀྱི་ཕྱོགས་དང་མཐུན་པའི་ཉེ་བའི་ཉོན་མོངས་པ་ཅན་དུ་འགྱུར་བའི་ལུས་རྨུགས་པ་དང་།",
    "ལྷག་མཐོང་གི་ཕྱོགས་དང་མཐུན་པའི་ཉེ་བའི་ཉོན་མོངས་པ་འདི་ལྟ་སྟེ།",
    "མ་རིག་པའི་ཆ་དང་མཐུན་པའི་རྟོག་པ་ཀུན་ནས་སློང་བ་རྣམས་ཀྱིས་ཉེ་བའི་ཉོན་མོངས་པ་ཅན་དུ་གྱུར་པ་ན་དབུགས་རྔུབ་པ་དང་།",
    "གལ་ཏེ་བདག་གིས་དབུགས་རྔུབས་ནས་ཕྱི་མ་བྱུང་ངམ།",
    "ཡང་ན་ཕྱིར་བྱུང་ནས་ནང་དུ་མ་བརྔུབས་སུ་ཟིན་ན་ནི་བདག་གི་སྲོག་འགག་པ་ཁོ་ནར་འགྱུར་རོ་སྙམ་མོ།",
    "ལུས་དང་སེམས་ཤིན་ཏུ་སྦྱངས་པ་རྒྱ་ཆེན་པོས་བྱེད་པས་ན་སྐྱོ་བར་བྱ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཞི་གནས་ཀྱི་ཕྱོགས་དང་མཐུན་པའི་ཉེ་བའི་ཉོན་མོངས་པ་བསལ་བའི་ཕྱིར་རོ།",
    "ལྷག་མཐོང་གི་ཕྱོགས་དང་མཐུན་པའི་ཉེ་བའི་ཉོན་མོངས་པ་བསལ་པའི་ཕྱིར་རོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་ཅན་དུ་གནས་པ་མ་ཡིན་པའི་ཕྱིར་ཡོངས་སུ་ཡི་འཆད་པ་མེད་དོ།",
    "སློབ་པ་ནི་ཀུན་དུ་སྤྱོད་པའི་སྒོ་ནས་སེམས་སྒྲིབ་པ་མེད་པར་དེ་བཞིན་གཤེགས་པ་དང་མཚུངས་མོད་ཀྱི་བག་ལ་ཉལ་མ་སྤངས་པའི་ཕྱིར་ཡང་དང་ཡང་དུ་སེམས་ཀྱི་རྒྱུད་སྒྲིབ་པ་རྣམས་ཀྱིས་འདྲེ་བར་འགྱུར་ཏེ།",
    "དྲན་པ་ཉེ་བར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ནང་གི་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པ་མ་སྤངས་པར་ཡོད་པ་ལ་ཡང་ཚུལ་བཞིན་མ་ཡིན་པར་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ།",
    "བྱང་གི་ཕྱོགས་ནས་འོངས་པའི་ཁྱོགས་དང་།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འོན་ཀྱང་གང་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སྦྱོང་གི་འབྲས་བུ་ཐོབ་པར་བྱ་བ་ལ་སྐལ་བ་མེད་པར་མ་གསུངས་པའི་ཉེས་པ་ཕྲན་ཚེགས་ཀུན་དུ་སྤྱོད་པའི་སྐབས་ནི་ཡོད་པ་ལྟ་བུའོ།",
    "དེ་ནི་དགེ་སྦྱོང་གི་འབྲས་བུ་ཐོབ་པ་ཉིད་ཡིན་པས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཤེས་རབ་ཀྱི་ཤས་ཆེ་བར་རྣམ་པར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པས་ན་ཁ་ན་མ་ཐོ་བ་མེད་པའོ།",
    "དགེ་སྦྱོང་གི་ཚུལ་གྱི་དོན་དང་མཐུན་པ་ཡིན་པས་ན་མཐུན་པ་ཅན་ཡིན་ནོ།",
    "གཟུགས་མེད་པ་བཞི་ནི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཀུན་ནས་ཉོན་མོངས་པ་མེད་པར་རེག་པར་གནས་པར་འགྱུར་རོ།",
    "བཞི་གང་ཞེ་ན་ཡིད་བདེ་བའི་གནས་ཀྱི་ཡུལ་གྱི་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་བདེ་བ་ལས་སེམས་བཏང་སྙོམས་སུ་བྱེད་པ་དང་།",
    "ཡིད་མི་བདེ་བའི་གནས་ཀྱི་ཡུལ་གྱི་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་མི་བདེ་བ་ལས་སེམས་བཏང་སྙོམས་སུ་བྱེད་པ་དང་།",
    "དགེ་སྦྱོང་གི་ཚུལ་གྱི་དོན་སྟོན་པ་པོ་དང་།",
    "དེ་དང་བར་གྱུར་པས་གཏན་ཁོ་ནར་ཚེ་རབས་གཞན་དག་ཏུ་ཡང་ཡོངས་སུ་མྱ་ངན་ལས་མ་འདས་པའི་བར་དུ་ངན་སོང་དུ་འགྲོ་བར་མི་འགྱུར་རོ།",
    "ཉོན་མོངས་པའི་ལྷག་མ་སྤོང་བ་འདྲེན་པར་བྱེད་པས་ན་བདེ་བའི་གཞི་ཞེས་བྱའོ།",
    "ངན་སོང་རྣམས་ཀྱི་ནི་མ་ཡིན་ནོ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
