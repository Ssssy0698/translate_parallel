    "ཤིང་གི་རྩེ་མོ་མེ་ཏོག་རབ་ཏུ་འཕྱང་བའི་གཙུག་ཕུད་དང་།",
    "འདི་ལྟར་མཚན་མོའི་ལྷ་དཔལ་དྲི་མ་མྱེད་ཅིང་ཀུན་ནས་ཟབ་པའི་འོད་དང་།",
    "རབ་ཏུ་དགའ་བའི་མིག་གིས་འགྲོ་བ་ལ་རྣམ་པར་ལྟ་བ་དང་།",
    "ཉིན་མོའི་ལྷ་གཞལ་དུ་མེད་པ་དག་དང་ཡང་ཐབས་གཅིག་སྟེ།",
    "འདི་ལྟར་ཉིན་མོའི་ལྷ་ཁྱིམ་དང་།",
    "གཞལ་མེད་ཁང་གི་གཟུགས་ཤིན་ཏུ་སྟོན་པ་དང་།",
    "ང་རྒྱལ་དང་ཀུན་ནས་ཉོན་མོངས་པ་རབ་ཏུ་ཞི་བར་བྱ་བ་ལ་བརྩོན་པ་ཤ་སྟག་དང་ཐབས་གཅིག་གོ།",
    "དྲི་ཟའི་རྒྱལ་པོ་རྡོ་རྗེའི་ཤིང་གི་ཡལ་གའི་རྒྱལ་མཚན་དང་།",
    "མོས་པ་དང་དགའ་བ་ཆེན་པོ་ལ་རབ་ཏུ་བརྩོན་པ་ཤ་སྟག་དང་ཐབས་གཅིག་གོ།",
    "ཡོན་ཏན་མཆོག་གི་རྒྱལ་མཚན་དང་།",
    "འཁོར་ལོའི་རི་མོ་བཟང་པོའི་རྒྱལ་མཚན་དང་།",
    "དབྱངས་ཟབ་མོའི་འོད་དང་།",
    "ཤེས་རབ་མཆོག་གི་འོད་དང་།",
    "དགའ་བའི་གཙུག་གི་བློ་གྲོས་དང་།",
    "ཉོན་མོངས་པའི་བག་ཆགས་དང་།",
    "དེ་བཞིན་གཤེགས་པ་དེ་དང་དེ་དག་གི་དྲུང་དུ་བཞུད་པའི་ཚེ།",
    "དེ་དག་ནི་མོས་པའི་སྟོབས་གཞན་དང་གཞན་གྱིས་དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་རྒྱ་མཚོ་ལ་འཇུག་གོ།",
    "རང་གི་གཞལ་མེད་ཁང་དང་།",
    "ཤིན་ཏུ་དྲི་མེད་མིག་གིས་འདི་འདྲ་མཐོང་།",
    "མཐོང་བ་ཙམ་གྱིས་ཉོན་མོངས་ཞི་བར་འགྱུར།",
    "ཤེས་རབ་མཆོག་གི་འོད་ནི་འདི་སྒོམ་མོ།",
    "དགའ་བའི་གཙུག་གི་བློ་གྲོས་སྤྱོད་ཡུལ་ལོ།",
    "དེ་ལ་མོས་པའི་དཀྱིལ་འཁོར་རབ་ཏུ་བསྐྱེད།",
    "དྲན་ནས་བདག་གི་དགའ་བ་རབ་སྐྱེས་ཏེ།",
    "འགྲོ་བ་རྣམས་ནི་ཉོན་མོངས་རྒྱ་མཚོ་ལ།",
    "སྔོན་གྱི་རྒྱལ་བའི་སྤྱོད་པ་བདག་གིས་དྲན།",
    "དེ་ནི་རྒྱལ་བའི་མཐུ་ཡིས་བདག་གིས་མཐོང་།",
    "ཞིང་གི་དབྱིངས་སུ་ཡངས་པ་ཤིན་ཏུ་བསྟན།",
    "སྔོན་གྱི་རྒྱལ་བའི་གསུང་གི་ཡན་ལག་ཀྱང་།",
    "ཞི་བ་ཟབ་མོའི་མིག་ནི་འདི་ལ་འཇུག།",
    "བདེ་གཤེགས་བ་སྤུ་གཅིག་གི་དཔེར་མི་རུང་།",
    "ཡིད་འོང་འོད་ཀྱི་གཙུག་གིས་དེ་མཐོང་ངོ།",
    "འགྲོ་བ་ཉོན་མོངས་ལས་ཀྱི་མུན་པས་བསྒྲིབས།",
    "དགའ་བ་བཟང་པོའི་མིག་གིས་དགའ་བར་མཐོང་།",
    "དེ་ཡི་ཚུལ་ལ་རྩེ་མོའི་ཟླ་བ་འཇུག།",
    "འགྲོ་བའི་ཉོན་མོངས་རྒྱ་མཚོ་ཡོངས་སྦྱངས་པའི།",
    "དྲི་མེད་མིག་གི་གཙུག་ཕུད་འདི་མཐོང་ངོ།",
    "བདག་གི་དགའ་བ་ཡང་དག་འབྱུང་སྐྱེས་ཏེ།",
    "འབྱམ་ཀླས་ཞིང་གི་རྡུལ་ལ་ཀུན་ཀྱང་བསྟན།",
    "ཇི་བཞིན་ཡངས་པ་སྤུ་ཡི་རྩེ་མོ་ལ།",
    "དེ་ལ་ངན་སོང་ཀུན་གྱི་འཇིགས་པ་མེད།",
    "རྒྱལ་བ་དེ་ལྟར་སྣང་བའི་གཙུག་གིས་མཐོང་།",
    "ཤིང་གི་མིག་གི་འོད་ཀྱིས་འདི་མཐོང་ངོ།",
    "ཉི་མའི་གཞལ་མེད་ཁང་གིས་ཕྱོགས་སུ་འཇུག་པ་དང་།",
    "མོས་པ་རྒྱ་ཆེན་ཡངས་པ་རབ་ཏུ་བསྐྱེད།",
    "ལམ་ངན་སོང་ལ་ལམ་རྣམས་མངོན་དུ་སྟོན།",
    "འགྲོ་བའི་ལྟ་བ་དང་ཉོན་མོངས་པ་ཐམས་ཅད་རྣམ་པར་འཇིལ་བ་ཞེས་བྱའོ།",
    "ཡིད་འོང་ཤིང་གི་འོད་ནི་འདི་སྟོན་ཏོ།",
    "ཕྱོགས་རྣམས་རྒྱ་མཚོ་མཐའ་ཡས་ཞིང་གི་རྣམས།",
    "མེ་ཏོག་ཤིང་གི་གཙུག་ཕུད་ཅོད་པན་ཚུལ།",
    "རྡོ་རྗེ་ཤིང་གི་རྒྱལ་མཚན་རྣམ་པར་སེམས།",
    "སྐད་ཅིག་གཅིག་གིས་བསྐལ་པ་བརྒྱ་མང་བ།",
    "སྤྱད་དེ་ཐབས་མང་ཚོགས་པས་ཕན་བསྐྱེད་ནས།",
    "རང་བྱུང་གསུང་གི་ཡན་ལག་ཐམས་ཅད་ཀྱི།",
    "ཉོན་མོངས་ལས་ཀྱིས་འཁོར་ཞིང་མགོན་མེད་པ།",
    "འཕགས་པའི་ཡོན་ཏན་གྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་ཀྱི་རྗེས་སུ་མཐོང་བ་ལ་རྣམ་པར་བལྟ་བས་དགའ་བ་དང་མོས་པར་སྤྱོད་པ་ཞེས་བྱའོ།",
    "ཁྱུ་མཆོག་གི་མཐུ་ཕྱུང་བའི་རྒྱན་ཐམས་ཅད་ཀྱིས་མདངས་རབ་ཏུ་སྐྱེད་པའི་རང་བཞིན་གྱིས་དགའ་བའི་འོད་ཅེས་བྱའོ།",
    "རྒྱལ་བའི་རྣམ་པར་འཕྲུལ་པ་བདག་གིས་མཐོང་།",
    "ཤིང་གི་འོད་ཀྱི་མི་འམ་ཅི་ཡིས་མཐོང་།",
    "དགའ་བདེ་མོས་པར་བྱེད་པས་འདི་མཐོང་དོན།",
    "བམ་པོ་གསུམ་མོ།",
    "ཉོན་མོངས་ལས་ཀྱི་སྒྲིབ་པས་སྟུག་བསྒྲིབས་ཤིང་།",
    "འཇིག་རྟེན་མགོན་པོ་རྒྱ་ཆེན་སྤྱན་གྱིས་གཟིགས།",
    "དེ་ནི་རྒྱན་བཟང་ནམ་མཁའ་ལྡིང་གིས་མཐོང་།",
    "སྐད་ཅིག་སེམས་ཀྱིས་བསྐལ་པ་བརྒྱ་མང་གི།",
    "རྣམ་ཕྱེ་རྒྱ་ཆེན་ཚིག་གིས་རྒྱལ་བ་གསུང་།",
    "འཕགས་པའི་དཔལ་གྱི་ཉིན་མོའི་ལྷ་ཡིས་མཐོང་།",
    "འགྲོ་བ་འདི་དག་ཉོན་མོངས་ལས་བསྒྲིབས་པར།",
    "ཡིད་དུ་འོང་བའི་སྒྲ་ཟབ་མོས་རྣམ་པར་འཕྲུལ་པ་ལ་འཇུག་པ་ཞེས་བྱའོ།",
    "དེ་ནས་མཚན་མོའི་ལྷ་དཔལ་དྲི་མ་མེད་ཅིང་ཀུན་ནས་ཟབ་པའི་འོད་ཀྱིས།",
    "ཞིང་དབྱངས་མཚན་མོའི་ལྷས་ནི་འདི་མཐོང་ངོ།",
    "མཚན་མོའི་ལྷ་ནི་དཔལ་གྱིས་འདི་མཐོང་ངོ།",
    "གཏུམ་སེམས་འཁོན་འཛིན་དམ་པོས་བསྒྲིབས་གཟིགས་ཤིང་།",
    "འཁོན་འཛིན་ཞི་བ་མཚན་མོའི་ལྷ་དགའ་འོ།",
    "འགྲོ་བ་ཐམས་ཅད་མིང་གི་ཕྱོགས་ཀྱི་འཁོར་ལོ་ལ་རྣམ་པར་ལྟ་བའི་འོད་ཅེས་བྱའོ།",
    "འགྲོ་བའི་མིང་གི་འཁོར་ལོ་ཇི་སྙེད་པ།",
    "འགྲོ་བའི་ཉོན་མོངས་ཐམས་ཅད་རབ་ཏུ་འཇིལ།",
    "ཇི་ལྟར་བྱུང་བ་དེ་དག་བདག་གིས་མཐོང་།",
    "ཉོན་མོངས་པའི་རྡུལ་གྱིས་གཡོགས་པ་རྣམ་པར་སེལ་བ་ཞེས་བྱའོ།",
    "ཉོན་མོངས་དབའ་རླབས་ལྡན་པའི་འགྲོ་བ་རྣམས།",
    "ཉོན་མོངས་མེ་ནི་མགོན་པོས་ཞི་བར་མཛད།",
    "རྒྱལ་བའི་སྤྱོད་ཡུལ་རྒྱ་ཆེན་བདག་གིས་མཐོང་།",
    "རྒྱལ་བའི་མཚན་རྣམས་རེ་རེ་ཐམས་ཅད་ཀྱང་།",
    "འགྲོ་བ་ཐམས་ཅད་ཀྱི་ངན་སོང་དང་ངན་འགྲོའི་ལམ་རྣམ་པར་ཟློག་པ་ཞེས་བྱའོ།",
    "འབྱམ་ཀླས་ཐུགས་ཀྱི་སྐད་ཅིག་གཅིག་གིས་བརྟུལ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྤང་བ་ལ་ཡང་དག་པར་འཇུག་པ་ཞེས་བྱའོ།",
    "ཆུ་ཀླུང་གི་ལྷའི་འཁོར་གྱི་དཀྱིལ་འཁོར་ཡོད་པ་ཐམས་ཅད་ལ་རྣམ་པར་བལྟས་ཏེ།",
    "འཇིག་རྟེན་བཀང་ཞིང་ཉོན་མོངས་གདུངས་པའི་རྣམས།",
    "དེ་ལ་དྲི་མེད་མིག་གི་ལྷ་ཡང་མོས།",
    "སྒྲིབ་པའི་ཀློང་དང་འགྲོ་བའི་ཉོན་མོངས་དྲི།",
    "ལོ་ཏོག་གི་ལྷ་ཁ་དོག་རྣམ་པར་དག་ཅིང་།",
    "འགྲོ་བ་ཀུན་གྱི་ཉོན་མོངས་དག་པར་མཛད།",
    "འགྲོ་བ་འདི་ན་མོས་ཡངས་གང་ཡོད་པ།",
    "འཇིག་རྟེན་ཉོན་མོངས་མ་ལུས་ཞི་བར་མཛད།",
    "སྡུག་བསྔལ་ལས་དང་ཉོན་མོངས་སྣ་ཚོགས་པས།",
    "མོས་པ་སྣ་ཚོགས་ཀྱི་མྱུ་གུ་རྣམ་པར་འཕེལ་བ་དང་།",
    "མོས་པ་རྒྱ་མཚོ་རྣམ་པར་དག་པར་འགྱུར།",
    "ཕྱོགས་བཅུའི་ཞིང་གི་དབྱིངས་རྣམས་རྒྱས་བྱས་ཤིང་།",
    "གཞན་ནི་བདེ་གཤེགས་སྐད་ཅིག་གཅིག་གིས་ལྟ།",
    "ཚུལ་མངོན་མིག་གི་ལྷ་ཡིས་དེ་ཐོས་སོ།",
    "འདི་ནི་སྣ་ཚོགས་ཤིང་གི་ཟེ་བའི་ས་ཡིན་ནོ།",
    "གསེར་འོད་མིག་གི་དཔལ་ནི་རབ་དགའ་བ།",
    "ཉོན་མོངས་ཡོངས་སུ་སྦྱང་བ་འདི་ལ་དགའ།",
    "རྩེ་མོའི་འོད་ཀྱི་ལྷ་ནི་འདི་ལ་འཇུག།",
    "དེ་ལ་མེ་ཏོག་མིག་གི་ལྷ་དགའ་འོ།",
    "ཇི་ལྟར་མོས་པར་ནེམ་ནུར་རྣམ་པར་སེལ།",
    "མཐའ་ཡས་ཤིང་གི་རྣམ་པ་སྣ་ཚོགས་གཟུགས།",
    "རྐང་གིས་འགྲོ་བའི་ལྷའི་འཁོར་གྱི་དཀྱིལ་འཁོར་ཡོད་པ་ཐམས་ཅད་ལ་རྣམ་པར་བལྟས་ནས།",
    "ཕྱོགས་བཅུའི་ཞིང་གི་དབྱིངས་རྣམས་མ་ལུས་པ།",
    "འཇིག་རྟེན་མགོན་པོ་རྣམ་འཕྲུལ་རྣམ་མང་གིས།",
    "མེ་ཏོག་གཙུག་གིས་ཇི་བཞིན་ཉིད་དུ་མཐོང་།",
    "འགྲོ་བ་ཀུན་གྱི་ཉོན་མོངས་ཞི་བར་འགྱུར།",
    "ཉོན་མོངས་ཤིན་ཏུ་སྡུག་བསྔལ་གཟིར་བ་རྣམས།",
    "མགུ་བར་མཛད་ཅིང་ཉོན་མོངས་ཐམས་ཅད་བསལ།",
    "ཀུན་སྒོའི་མིག་གི་དཔལ་གྱི་སྤྱོད་ཡུལ་ལོ།",
    "ཤིང་གི་ལྷ་ཐམས་ཅད་འདྲེན་པའི་རྒྱན་ཡིད་དུ་འོང་བས་བརྒྱན་པ་ཞེས་བྱའོ།",
    "གཞན་དང་གཞན་གྱི་ཚུལ་དག་གིས།",
    "འགྲོ་བ་ཐམས་ཅད་རེ་རེའི་སྒོ་དག་ནས།",
    "མོས་པ་རྒྱ་མཚོའི་འོད་ཅེས་བྱའོ།",
    "པད་མོའི་ཟེ་བའི་དྲི་ཐམས་ཅད་དང་།",
    "མེ་ཏོག་གི་ཟེ་བའི་དྲི་ཐམས་ཅད་དང་།",
    "ནོར་བུ་སྣ་ཚོགས་ཀྱི་ཤིང་གི་ཡལ་ག་ལས་མེ་ཏོག་གི་དོག་པ་ནི་རྣམ་པར་སྤྱོད།",
    "སྐྱིལ་མོ་ཀྲུང་བཅས་ཏེ་འཁོད་པར་གྱུར་ཏོ།",
    "ཤིང་གི་རྒྱལ་པོ་ཀུན་གྱི་དྲུང་ན་བཞུགས།",
    "དེ་བཞིན་གཤེགས་པའི་རྫུ་འཕྲུལ་སྟོབས་དག་གིས།"
  ]
}