    "ཐེ་ཚོམ་གསུམ་ཁོ་ན་གསུངས་ཤེ་ན།",
    "གཞན་ཡང་མཐར་འཛིན་པར་ལྟ་བ་ནི་འཇིག་ཚོགས་ལ་ལྟ་བས་རབ་ཏུ་བཅུག་ལ།",
    "ཡུལ་གཞན་དུ་བགྲོད་པར་བྱ་བ་ལ་བར་ཆད་བྱེད་པ་ནི་གསུམ་ཡོད་དོ།",
    "དེ་དག་མ་སྤངས་པར་ཁམས་གོང་མ་ལས་མི་འདའ་བའི་ཕྱིར་རོ།",
    "བདེ་བའི་ཚོ་བ་ལ་ནི་འདོད་ཆགས་དམིགས་པ་དང་མཚུངས་པར་ལྡན་པའི་སྒོ་ནས་རྒྱས་པར་འགྱུར་ལ།",
    "རྒོད་པ་ནི་སེམས་རྣམ་པར་མ་ཞི་བའོ།",
    "རྣམ་པར་འཚེ་བ་ནི་རྣམ་པ་ཐོ་འཚམས་པ་སྟེ།",
    "གང་ཞིག་གང་མཐོང་བས་སྤང་བར་བྱ་བ་དང་མཚུངས་པར་ལྡན་པ་དེ་ནི་དེ་མཐོང་བས་སྤང་བར་བྱ་བ་ཡིན་ནོ།",
    "མ་རིག་པ་ཙམ་དང་མཚུངས་པར་ལྡན་པའི་ཕྱིར་རོ།",
    "དེ་དག་ལས་དུ་ཞིག་གང་ན་ཡོད་པར་རིག་པར་བྱ་ཞེ་ན།",
    "ཚངས་པ་ཆེན་པོ་དེ་ནི་བདག་ཉིད་ལོག་པར་ཀུན་དུ་སྟོན་པས་ཚེ་དང་ལྡན་པ་རྟ་ཐུལ་ལ་འདྲེད་པར་ཞུགས་སོ།",
    "འདོད་ཆགས་ནི་བདེ་བ་དང་ཡིད་བདེ་བ་དག་དང་མཚུངས་པར་ལྡན་ནོ།",
    "སྡུག་བསྔལ་དང་ཡིད་མི་བདེ་བ་དང་མཚུངས་པར་ལྡན་ཏེ།",
    "འདོད་ཆགས་དང་ཞེ་སྡང་དག་ནི་དགའ་བ་དང་སྐྱོ་བའི་རྣམ་པར་འཇུག་པའི་ཕྱིར་དང་།",
    "ལོག་པར་ལྟ་བ་ནི་དེ་དག་དེ་དང་མཚུངས་པར་ལྡན་ཏེ།",
    "ཕྲ་རྒྱས་གཞན་དག་ནི་ཡིད་བདེ་བ་ཁོ་ན་དང་མཚུངས་པར་ལྡན་ནོ།",
    "དགའ་བའི་རྣམ་པར་འཇུག་པའི་ཕྱིར་རོ།",
    "དེ་ན་ཡང་ཅི་རིགས་པར་རྣམ་པར་ཤེས་པའི་ཚོགས་བཞི་པ་རྣམས་ནི་རྣམ་པར་ཤེས་པའི་ཚོགས་བཞི་པ་རྣམས་དང་མཚུངས་པར་ལྡན་ལ་ཡིད་ཀྱི་ས་པ་རྣམས་ནི་ཡིད་ཀྱི་ས་པ་རྣམས་ཁོ་ན་དང་མཚུངས་པར་ལྡན་ནོ།",
    "མཚུངས་པར་ལྡན་པ་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "འདི་དག་ནི་སྐྱོ་བའི་རྣམ་པར་འཇུག་པའི་ཕྱིར་དང་ཡིད་ཀྱི་ས་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "ཡིད་བདེ་བ་དང་མཚུངས་པར་ལྡན་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཆགས་པའི་རྒྱུ་ལས་བྱུང་བ་དགའ་བའི་རྣམ་པར་འཇུག་པའི་ཕྱིར་རོ།",
    "ཡིད་བདེ་བ་དང་ཡིད་མི་བདེ་བ་དག་དང་མཚུངས་པར་ལྡན་ཏེ།",
    "བསམ་གཏན་གསུམ་པ་ན་ནི་བདེ་བ་དང་མཚུངས་པར་ལྡན་ནོ།",
    "མན་ཆད་ན་ནི་ཡིད་བདེ་བ་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ཡན་ཆད་ན་ནི་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ཐམས་ཅད་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ཏེ།",
    "ཐེ་ཚོམ་དང་སྒྲིབ་པ་ལྔ་གསུངས་པ་གང་དག་ཡིན་པ་དེ་ལ་ཅི་རྨུགས་པ་དང་།",
    "འོན་ཏེ་འདོད་པ་དང་མཚུངས་པར་ལྡན་པ་དག་ཁོ་ན་གཟུང་ཞེ་ན།",
    "གཉིས་གཅིག་གཉིས་གཅིག་ཏུ་བྱས་པ་ནི་གཉིས་གཅིག་གོ།",
    "འདི་གཉི་གས་ཀྱང་སེམས་ཞུམ་པར་བྱེད་དོ།",
    "ཉེ་དུའི་རྣམ་པར་རྟོག་པ་དང་།",
    "ཡུལ་གྱི་རྣམ་པར་རྟོག་པ་དང་།",
    "མི་འཆི་བའི་རྣམ་པར་རྟོག་པ་དང་།",
    "འདི་གཉི་གས་ཀྱང་སེམས་རྣམ་པར་མ་ཞི་བར་བྱེད་དོ།",
    "རྨུགས་པ་དང་གཉིད་ཀྱིས་ནི་ཤེས་རབ་ཀྱི་ཕུང་པོ་ལ་གནོད་པར་བྱེད་དོ།",
    "རྒོད་པ་དང་འགྱོད་པས་ནི་ཏིང་ངེ་འཛིན་གྱི་ཕུང་པོ་ལ་གནོད་པར་བྱེད་དོ།",
    "དེའི་ཕྱིར་གྲངས་བཞིན་དུ་འདི་གཉིས་ཀྱི་ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་ཀྱི་ཕུང་པོ་ལ་གནོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "རྒྱུ་བར་གྱུར་པས་གཟུགས་སྡུག་པ་དང་མི་སྡུག་པའི་ཡུལ་དག་ལ་མཚན་མར་གཟུང་བའི་ཕྱིར་གནས་པར་གྱུར་པའི་ཏིང་ངེ་འཛིན་དུ་འཇུག་པ་ལ།",
    "དེའི་འོག་ཏུ་ཏིང་ངེ་འཛིན་དུ་ཞུགས་པས་རིགས་པ་མ་ཡིན་པར་ཞི་གནས་ལྷག་མཐོང་བསྟན་པའི་ཕྱིར་གོ་རིམ་བཞིན་དུ་རྨུགས་པ་དང་།",
    "འདི་དཔྱད་པར་བྱ་སྟེ།",
    "དེ་ལ་དམིགས་པ་ཡང་དག་པར།",
    "འགོག་པ་དང་ལམ་མཐོང་བས་སྤང་བར་བྱ་བ་ཟག་པ་མེད་པ་ལ་དམིགས་པ་རྣམས་ཟད་པར་འགྱུར་རོ།",
    "དེ་ལ་དམིགས་པ་ཡང་དག་པར་ཟད་པས་ནི་སྐལ་བ་མི་མཉམ་པའི་ཁམས་ཀུན་དུ་འགྲོ་བ་རྣམས་ཟད་པར་འགྱུར་ཏེ།",
    "དམིགས་པ་སྤངས་པས་ནི་འགོག་པ་དང་ལམ་མཐོང་བས་སྤང་བར་བྱ་བ་ཟག་པ་དང་བཅས་པ་ལ་དམིགས་པ་རྣམས་ཟད་པར་འགྱུར་ཏེ།",
    "གཞི་དང་སྲིད་ཉིད་རྣམ་པར་ནི།",
    "ཐག་བསྲིང་བའི་ངོ་བོའི་གཉེན་པོ་ནི་རྣམ་པར་གྲོལ་བའི་ལམ་ཡན་ཆད་ཀྱི་ལམ་གང་ཡིན་པ་སྟེ།",
    "དེ་ལྟ་བས་ན་འདི་བརྗོད་པར་བྱ་དགོས་སོ།",
    "ཡུལ་གྱིས་རིང་བ་ཉིད་ནི་དཔེར་ན་བསྐལ་པའི་ཡུལ་རྣམ་པར་ཆད་པས་ཏེ།",
    "འདུས་མ་བྱས་ཇི་ལྟར་ན་ཉེ་བ་ཉིད་དུ་འགྲུབ།",
    "འདུས་མ་བྱས་ཀྱང་ཆོད་པ་མེད་པའི་ཕྱིར་ཉེ་བ་ཡིན་ནོ།",
    "འདས་པ་ནི་ཞིག་པའི་ཕྱིར་རིང་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རིགས་པར་འགྱུར་རོ།",
    "འདི་ནི་གཉེན་པོའི་རྣམ་པར་གྲོལ་བའི་ལམ་མིན་པར་བསམས་པའོ།",
    "བསམ་གཏན་ཁྱད་པར་ཅན་ཡང་བསམ་གཏན་བཞིན་དུ་བལྟ་བར་བྱའོ།",
    "སྲིད་རྩེ་ཉམས་པར་བྱས་པ་དང་།",
    "ཡོངས་ཤེས་སུ་རྣམ་པར་གཞག་གོ།",
    "དེ་ནི་རྒྱུ་གཉི་ག་ཡང་དག་པར་བཅོམ་པ་དང་།",
    "ཁམས་ལས་ཡང་དག་པར་འདས་པ་ལས་གཞན་མ་ཡིན་པར་མི་བརྗོད་དོ།",
    "གཅིག་ཏུ་རྣམ་པར་འཇོག་པ་ནི།",
    "ཟག་པ་དང་བཅས་པ་ཞེས་བརྗོད་པར་བྱ་ཞེ་ན།",
    "དེ་ལྟ་མ་ཡིན་ན་རྒྱུ་ནི་སྔར་བསྟན་ལ་འབྲས་བུ་ནི་ཕྱིས་བསྟན་པར་འགྱུར་རོ།",
    "ཁ་ཅིག་ནི་རབ་ཏུ་བརྟག་པ་དང་མཐུན་པར་བསྟན་ཏེ།",
    "དཔེར་ན་ཡང་དག་པར་སྤོང་བ་རྣམས་ལྟ་བུ་སྟེ།",
    "དཀྱུས་ས་བསྟན་པའི་རྟ་ཐགས་ཐོགས་མེད་པར་རྒྱུག་པ་བཞིན་ནོ།",
    "དེ་ནི་མྱ་ངན་ལས་འདས་པ་ལ་མངོན་དུ་ཕྱོགས་པར་ཡང་དག་པར་རྟོག་པ་སྟེ།",
    "འཕགས་པས་བདེ་བར་གང་གསུངས་པ།",
    "འགྱུར་བ་ན་སྡུག་བསྔལ་ལོ་ཞེས་གསུངས་སོ།",
    "གནས་པ་ན་ཡང་སྡུག་བསྔལ་ལོ་ཞེས་གསུངས་སོ།",
    "མཁས་པ་སུ་ཞིག་ཆུས་བཏབ་པའི་བདེ་བ་ཆུང་ངུས་འབྲས་བུ་བདེ་བ་ཡིན་ནོ་སྙམ་དུ་སེམས་པར་འགྱུར།",
    "གལ་ཏེ་མི་རྟག་པའི་ཕྱིར་སྡུག་བསྔལ་ཉིད་དུ་ལྟ་ན་འོ་ན་མི་རྟག་པ་དང་སྡུག་བསྔལ་གྱི་རྣམ་པ་དག་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད།",
    "མི་རྟག་པར་མཐོང་ན་མི་མཐུན་པར་འགྱུར་བས་མི་རྟག་པའི་རྣམ་པས་སྡུག་བསྔལ་གྱི་རྣམ་པ་འདྲེན་པར་བྱེད་དོ།",
    "སྡུག་བསྔལ་ལ་བདེ་བའོ་སྙམ་དུ་འདུ་ཤེས་ཕྱིན་ཅི་ལོག་གོ་ཞེས་གསུངས་ཏེ།",
    "བདེ་བའི་རྒྱུ་རྣམ་པར་མི་གནས་པའི་ཕྱིར་ཏེ།",
    "ཁ་ཅིག་བདེ་བའི་རྒྱུ་བཏུང་བ་དང་བཟའ་བ་དང་གྲང་བ་དང་དྲོ་བ་ལ་སོགས་པར་འདོད་པ་གང་དག་ཡིན་པ་དེ་དག་ཁོ་ན་ཧ་ཅང་སྤྱད་པ་དང་།",
    "དུས་མ་ཡིན་པར་སྤྱད་པ་རྣམས་ཀྱང་སྡུག་བསྔལ་གྱི་རྒྱུ་དག་ཏུ་འགྱུར་རོ།",
    "བདེ་བའི་རྒྱུ་འཕེལ་བའམ་མཉམ་པས་ནི་དུས་གཞན་ན་སྡུག་བསྔལ་སྐྱེད་པར་རིགས་པ་མ་ཡིན་པས་དེ་དག་ནི་དང་པོ་ཁོ་ན་ནས་སྡུག་བསྔལ་གྱི་རྒྱུ་དག་ཡིན་ཞིང་བདེ་བའི་རྒྱུ་ནི་མ་ཡིན་ལ།",
    "སྤྱོད་ལམ་གྱི་བྱེ་བྲག་ལ་ཡང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "ཇི་སྲིད་དུ་བཀྲེས་པ་དང་སྐོམ་པ་དང་གྲང་བ་དང་ཚ་བ་དང་ངལ་བ་དང་འདོད་པའི་འདོད་ཆགས་ལས་སྐྱེས་པའི་སྡུག་བསྔལ་གཞན་གྱིས་གཙེས་པར་མ་གྱུར་པ་དེ་སྲིད་དུ་བདེ་བའོ་སྙམ་དུ་ཚོར་བ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "བྱིས་པ་རྣམས་ནི་སྡུག་བསྔལ་གྱི་བྱེ་བྲག་ལ་ཡང་བདེ་བའི་བློ་སྐྱེད་པར་བྱེད་དེ།",
    "དཔེར་ན་ཕྲག་པ་ནས་ཕྲག་པར་ཁུར་ཡོད་པར་བྱེད་པ་ལྟ་བུའོ།",
    "ཇི་ལྟར་བྱས་པས་ཤེ་ན།",
    "གལ་ཏེ་གནོད་པའི་བདག་ཉིད་གང་ཡིན་པའོ་ཞེས་ཟེར་ན་ནི་ཇི་ལྟ་བུ་ཡིན་ཞེས་བརྗོད་པར་བྱའོ།",
    "གལ་ཏེ་གནོད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་ཟེར་ན་ནི་ཕན་པར་བྱེད་པ་བདེ་བ་ཡིན་ནོ་ཞེས་བྱ་བར་གྲུབ་བོ།",
    "རྣམ་པར་འགྱུར་བ་ཅན་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གང་ཅི་ཚོར་ཡང་རུང་དེ་ནི་འདིར་སྡུག་བསྔལ་ལོ་ཞེས་གསུངས་པ་གང་ཡིན་པ་དེ་ནི་བཅོམ་ལྡན་འདས་ཁོ་ནས་ཀུན་དགའ་བོ་གང་ཅི་ཚོར་ཡང་རུང་དེ་ནི་འདིར་སྡུག་བསྔལ་ལོ་ཞེས་བྱ་བ་ནི་ངས་འདུ་བྱེད་མི་རྟག་པ་ཉིད་དང་།",
    "འདུ་བྱེད་རྣམ་པར་འགྱུར་བ་ཉིད་ལ་དགོངས་ནས་གསུངས་སོ་ཞེས་དོན་ངེས་པར་མཛད་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་འདི་ནི་སྡུག་བསྔལ་གྱི་སྡུག་བསྔལ་ཉིད་ལས་དགོངས་ཏེ་གསུངས་པ་མ་ཡིན་པར་གྲུབ་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཚོར་བ་ཐམས་ཅད་རང་བཞིན་གྱིས་སྡུག་བསྔལ་བ་ཞིག་ཡིན་པར་གྱུར་ན་ནི་ཅིའི་ཕྱིར་འཕགས་པ་ཀུན་དགའ་བོས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་དུ་བཅོམ་ལྡན་འདས་ཀྱིས་བདེ་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གང་ཅི་ཚོར་ཡང་རུང་དེ་ནི་འདིར་སྡུག་བསྔལ་ལོ་ཞེས་ཀྱང་གསུངས་ན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཅི་ལས་དགོངས་ནས་གང་ཅི་ཚོར་ཡང་རུང་དེ་ནི་འདིར་སྡུག་བསྔལ་ལོ་ཞེས་བཀའ་སྩལ་ཞེས་ཞུས་པར་གྱུར་ཏེ།",
    "གང་ཡང་བདེ་བའི་ཚོར་བ་ནི་སྡུག་བསྔལ་དུ་བལྟ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡང་དེ་ལ་གཉི་ག་ཡོད་དོ།",
    "རྣམ་པར་འགྱུར་བ་ཉིད་མཁྱེན་ནས།",
    "ཚོར་བ་སྡུག་བསྔལ་བར་གསུངས་སོ།",
    "གང་ཡང་སྡུག་བསྔལ་ལ་བདེ་བའོ་སྙམ་དུ་འདུ་ཤེས་ཕྱིན་ཅི་ལོག་གོ་ཞེས་གསུངས་པ་ཡང་བསྟན་པ་འདི་ནི་དགོངས་པ་ཅན་ཡིན་ཏེ།",
    "དེ་ལྟ་བས་ན་བདེ་བའི་ཚོར་བ་མེད་པར་མི་འགྲུབ་བོ།",
    "གལ་ཏེ་འཇིག་རྟེན་དང་མཐུན་པར་གསུངས་པ་ཡིན་ནོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "ཚོར་བ་ཐམས་ཅད་སྡུག་བསྔལ་བ་ཉིད་ནི་ངས་དགོངས་ནས་གསུངས་སོ་ཞེས་བཀའ་སྩལ་པའི་ཕྱིར་རོ།",
    "ཡང་དག་པར་ཇི་ལྟ་བ་བཞིན་ཞེས་གསུངས་པའི་ཡང་ཕྱིར་ཏེ།",
    "དེའི་ཀུན་དུ་སྦྱོར་བ་གསུམ་ཡང་སྤངས་པ་ཡིན་ཞེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པ་གསུངས་སོ།",
    "འཇིག་རྟེན་ཡང་ཇི་ལྟར་ན་སྡུག་བསྔལ་གྱི་ཚོར་བ་ལ་རྣམ་པ་གསུམ་དུ་རྟོག་པར་འགྱུར་གལ་ཏེ་ཆུང་ངུ་དང་ཆེན་པོ་དང་འབྲིང་དག་ལ་གོ་རིམ་བཞིན་དུ་བདེ་བ་ལ་སོགས་པའི་བློ་སྐྱེའོ་ཞེ་ན་ནི་བདེ་བ་ལ་ཡང་རྣམ་པ་གསུམ་ཡོད་པས་སྡུག་བསྔལ་ཆུང་ངུ་ལ་སོགས་པ་ལ་བདེ་བ་ཆེན་པོ་ལ་སོགས་པའི་བློ་སྐྱེ་བར་འགྱུར་རོ།",
    "འདོད་པའི་བདེ་བ་མངོན་སུམ་དུ་གྱུར་པ་ལ་ཡང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟ་བས་ན་སྡུག་བསྔལ་ཆུང་ངུ་ལ་སོགས་པ་ལ་བདེ་བ་ལ་སོགས་པའི་ཚོར་བ་རྣམ་པར་གཞག་ཏུ་མི་རུང་ངོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་མིང་ཆེན་གལ་ཏེ་གཟུགས་གཅིག་ཏུ་སྡུག་བསྔལ་བ་ཞིག་ཡིན་པར་གྱུར་ན་ནི་བདེ་བ་ཡང་མེད།",
    "བདེ་བ་དང་རྗེས་སུ་འབྲེལ་བ་ཡང་མེད་ཅེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པ་གསུངས་པས་དེའི་ཕྱིར་ཡང་བདེ་བ་ཅུང་ཟད་ཅིག་ཡོད་དེ།",
    "གང་ཡང་བདེ་བའི་རྒྱུ་རྣམ་པར་མི་གནས་པའི་ཕྱིར་རོ་ཞེས་སྨྲས་པ།",
    "རྟེན་གྱི་ཁྱད་པར་ལ་ལྟོས་པའི་ཡུལ་བདེ་བའི་རྒྱུའམ།",
    "དེ་ལུས་ཀྱི་གནས་སྐབས་གང་ཞིག་དང་ཕྲད་ན་བདེ་བའི་རྒྱུ་ཡིན་པ་དེ་ནི་དེ་དང་ཕྲད་ན་མ་ཡིན་པ་ནི་ནམ་ཡང་མ་ཡིན་པས་བདེ་བའི་རྒྱུ་རྣམ་པར་གནས་པ་ཁོ་ན་ཡིན་ཏེ།",
    "བསམ་གཏན་དག་ན་ཡང་བདེ་བའི་རྒྱུ་ཇི་ལྟར་རྣམ་པར་མི་གནས་པ་ཡིན།",
    "ཁུར་སྦེད་པ་ལ་ཡང་ཇི་སྲིད་དུ་ལུས་ཀྱི་གནས་སྐབས་དེ་ལྟ་བུ་མེད་པར་མ་གྱུར་གྱི་བར་དུ་གནས་སྐབས་གཞན་ལས་སྐྱེས་པའི་བདེ་བ་ཁོ་ན་སྐྱེ་བར་འགྱུར་རོ།",
    "ངལ་བའི་སྤྱོད་ལམ་གྱི་རྣམ་པ་དག་ལ་ཡང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ལུས་ཡོངས་སུ་འགྱུར་བའི་ཁྱད་པར་ལས་ཏེ།",
    "འདི་ཇི་ལྟར་ཁོང་དུ་ཆུད་པར་བྱ་ཞེ་ན།",
    "གཞན་ལས་གཞན་ཡང་ཡིན་པར་གསུངས་པའི་ཕྱིར་ཏེ།",
    "ཞེས་གསུངས་ལ་ཡང་ས་བོན་གྱི་རྣམ་པ་ལྔ་ཞེས་བྱ་བ།",
    "འདི་ནི་ཉེ་བར་ལེན་པ་དང་བཅས་པའི་རྣམ་པར་ཤེས་པའི་ཚིག་བླ་དགས་ཡིན་ནོ།",
    "སའི་ཁམས་ཞེས་བྱ་བ་འདི་ནི་རྣམ་པར་ཤེས་པ་གནས་པ་བཞིའི་ཚིག་བླ་དགས་ཡིན་ནོ་ཞེས་ཀྱང་གསུངས་ཏེ།",
    "རྒྱུ་དང་བཅས་པར་བཀའ་སྩོལ་བ་ན་ནི་ཚིགས་སུ་བཅད་པ་ལས།",
    "ལས་དང་སྲེད་པ་དང་མ་རིག་པ་ཡིན་པར་གསུངས་ཏེ།",
    "ཆུ་ནི་བྱེ་བྲག་མེད་པར་མྱུ་གུ་ཐམས་ཅད་སྐྱེ་བ་ཙམ་གྱི་རྒྱུ་ཡིན་པ་ལྟ་བུ་སྟེ་འདི་ནི་དཔེ་ཡིན་ནོ།",
    "དོན་དམ་པའི་བདེན་པ་དང་བདེན་པ་གཉིས་ཞེས་ཀྱང་གསུངས་ལ།",
    "དེ་ནི་དོན་དམ་པར་ཡོད་པའི་ཕྱིར་དོན་དམ་པའི་བདེན་པ་ཞེས་བྱའོ།",
    "ཇི་ལྟར་ན་དེ་དག་མཐོང་བར་འགྱུར་བ་བརྗོད་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་དང་པོ་འཇུག་པ་ལས་བརྩམས་ཏེ་བརྗོད་པར་བྱའོ།",
    "དོན་ཉན་པར་བྱེད་དོ།",
    "ཐོས་ནས་ཕྱིན་ཅི་མ་ལོག་པར་སེམས་པར་བྱེད་དོ།",
    "དེ་ནི་ཡི་གེ་ལ་མི་ལྟོས་པར་དོན་ལ་འཇུག་གོ།",
    "དཔེར་ན་སྟོང་རྐྱལ་ལེགས་པར་མ་ལོབས་པ་ཆུའི་ནང་དུ་འཇུ་བར་བྱ་བ་མི་གཏོང་བ་ཁོ་ན་ཡིན་ལ།",
    "ལེགས་པར་ལོབས་པ་ནི་འཇུ་བར་བྱ་བ་ལ་མི་ལྟོས་པར་རྒལ་བ་ལྟ་བུ་སྟེ་འདི་ནི་དཔེ་ཡིན་ནོ་ཞེས་ཟེར་རོ་ཞེས་གྲག་གོ།",
    "བསམ་པ་ལས་བྱུང་བ་ནི་རིགས་པས་ངེས་པར་བརྟགས་པ་ལ་སྐྱེས་པ་ཡིན་ནོ།",
    "འདི་གཉིས་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད་དེ་འདི་ནི་བརྗོད་པར་བྱ་དགོས་སོ།",
    "འདོད་ཆེན་ཆུང་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདི་དག་ལ་འདོད་ཆགས་དང་རྣམ་པར་རྟོག་པ་ལྷག་པ་ཡོད་པས།",
    "འདི་དག་ནི་འདོད་ཆགས་དང་རྣམ་པར་རྟོག་པ་ལྷག་པ་དག་སྟེ།",
    "མི་སྡུག་པ་ནི་ཁ་དོག་དང་དབྱིབས་ཀྱི་བྱེ་བྲག་ལ་དམིགས་པའི་ཕྱིར་རྣམ་པར་རྟོག་པ་འདྲེན་པར་བྱེད་དོ་ཞེས་ཟེར་རོ།",
    "དང་པོའི་གཉེན་པོར་ནི་རྣམ་པར་བསྔོས་པ་ལ་སོགས་པ་ལ་དམིགས་པའི་མི་སྡུག་པ་རྗོད་པར་བྱེད་དོ།",
    "གཉིས་པའི་ནི་རྣམ་པར་ཟོས་པ་དང་།",
    "རྣམ་པར་འཐོར་བ་ལ་དམིགས་པའོ།",
    "གསུམ་པའི་ནི་རྣམ་པར་འབུས་གཞིགས་པ་དང་།",
    "བྱེ་བྲག་མེད་པར་ནི།",
    "ཡོངས་སུ་སྦྱང་བ་བྱས་པ་དང་།",
    "ཡང་ན་དེ་གར་དགའ་བར་སེམས་གཏོད་པར་བྱེད་ཅིང་།",
    "བཏང་བས་སྦྱང་བ་བྱས་པར་བཤད།",
    "དེ་སེམས་བསྡུ་བ་ཁྱད་པར་ཅན་དུ་བྱ་བའི་ཕྱིར་རུས་པའི་ཀེང་རུས་དེ་ལས་རྐང་པའི་རུས་པ་རྣམས་བོར་ནས་ལྷག་མ་ཡིད་ལ་བྱེད་ཅིང་།",
    "དེ་བཞིན་དུ་ཐོད་པའི་ཕྱེད་བོར་ནས་ཐོད་པ་ཕྱེད་ཀྱི་བར་ཡིད་ལ་བྱེད་པ་འདི་ནི་ཡོངས་སུ་སྦྱང་བ་བྱས་པ་ཡིན་ནོ།",
    "དེ་ཐོད་པའི་ཕྱེད་ཀྱང་བོར་ནས་སྨིན་མ་གཉིས་ཀྱི་བར་དུ་སེམས་འཛིན་པར་བྱེད་པ་འདི་ནི་མི་སྡུག་པ་ཡིད་ལ་བྱེད་པ་རྫོགས་པའི་རྣལ་འབྱོར་སྤྱོད་པ་ཡིན་ནོ་ཞེས་གྲག་གོ།",
    "ཡིད་ལ་བྱེད་པ་སྦྱང་བ་བྱས་པ་དང་།",
    "སྦྱང་བ་མ་བྱས་པ་དག་དང་།",
    "ཡིད་ལ་བྱེད་པ་སྦྱང་བ་མ་བྱས་པ་དང་།",
    "གང་དུ་སྐྱེད་པར་བྱེད་ཅེ་ན།",
    "བསམ་གཏན་བཞི་ཉེར་བསྡོགས་དང་བསམ་གཏན་ཁྱད་པར་ཅན་དང་བཅས་པ་དང་།",
    "བསམ་གཏན་ཁྱད་པར་ཅན་དང་།",
    "བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་པའི་ཕྱིར་རོ།",
    "བདེ་བ་དང་སྡུག་བསྔལ་དག་ནི་རྣམ་པར་རྟོག་པ་དང་མཐུན་པའི་ཕྱིར་དེའི་གཉེན་པོ་ནི་དེ་དག་དང་མཚུངས་པར་མི་ལྡན་ནོ།",
    "གལ་ཏེ་གཅིག་ལ་གཉིས་སུ་འཛིན་ན་ལྷག་པར་བགྲང་བའི་སྐྱོན་ནོ།",
    "གལ་ཏེ་དབུགས་རྔུབ་པ་ལ་དབུགས་འབྱིན་པར་འཛིན་ཏམ།",
    "དབུགས་འབྱིན་པ་ལ་དབུགས་རྔུབ་པར་འཛིན་ན་འཆོལ་བར་བགྲང་བའི་སྐྱོན་ནོ།",
    "བར་སྐབས་སུ་སེམས་རྣམ་པར་གཡེང་ན་ཡང་མགོ་ནས་ཇི་སྲིད་དུ་ཏིང་ངེ་འཛིན་མ་ཐོབ་ཀྱི་བར་དུ་བགྲང་བར་བྱའོ།",
    "བྱིན་པར་འཇུག་པའི་རིམ་གྱིས་རྐང་པ་གཉིས་ཀྱི་བར་དུ་རྗེས་སུ་འགྲོ་ལ།",
    "ཅི་འདི་དག་ཕན་འདོགས་པར་བྱེད་པ་ཞིག་གམ།",
    "གནོད་པར་བྱེད་པ་ཞིག་གམ།",
    "དེ་དག་ལ་བརྟེན་པ་སེམས་དང་སེམས་ལས་བྱུང་བ་རྣམས་ཀྱང་ཡོད་དོ་ཞེས་ཕུང་པོ་ལྔ་ལ་ཉེ་བར་རྟོག་པར་བྱེད་པའོ།",
    "རྣམ་པར་དག་པ་ནི་ཟད་པ་ཤེས་པ་ལ་སོགས་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "འདི་གཉིས་ནི་ལུས་ཀྱི་ཕྱོགས་གཅིག་ཡིན་པའི་ཕྱིར་ལུས་ས་པ་གང་ཡིན་པ་དེའི་ས་པ་དག་ཡིན་པར་རིག་པར་བྱའོ།",
    "ནུར་ནུར་པོ་ལ་སོགས་པར་གྱུར་པ་རྣམས་ཀྱང་།",
    "བསམ་གཏན་བཞི་པ་ལ་སྙོམས་པར་ཞུགས་པ་རྣམས་ལ་མེད་པའི་ཕྱིར་ལུས་དང་སེམས་ཁྱད་པར་ཅན་ལ་བརྟེན་ནས་འཇུག་པ་ཡིན་ཏེ།",
    "བསམ་གཏན་བཞི་པ་ལ་སྙོམས་པར་འཇུག་པ་ལ་ནི་འབྱུང་ངོ།",
    "ལུས་རྒྱས་པས་འགྲིབ་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "རྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པ་ནི་མ་ཡིན་ཏེ།",
    "རྣམ་པར་སྨིན་པའི་གཟུགས་ལ་ནི་དེ་ལྟ་བུ་མེད་དོ།",
    "ལྷག་མཐོང་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "ཞི་གནས་གྲུབ་པར་གྱུར་པ་ཡིས།",
    "སྤྱིའི་མཚན་ཉིད་ནི་འདུས་བྱས་རྣམས་ནི་མི་རྟག་པ་ཉིད་དང་།",
    "མཉམ་པར་གཞག་པས་ལུས་ལ་རྡུལ་ཕྲ་རབ་དང་སྐད་ཅིག་མར་མཐོང་བས་ལུས་དྲན་པ་ཉེ་བར་གཞག་པ་གྲུབ་པ་ཡིན་ནོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་ལུས་ལ་ལུས་ཀྱི་རྗེས་སུ་ལྟ་ཞིང་གནས་པ་དེའི་དྲན་པ་ཉེ་བར་གནས་ཤིང་ཀུན་ཏུ་མི་རྨོངས་པ་ཡིན་ཞེས་གསུངས་སོ།",
    "ཟས་འགགས་པས་ནི་ལུས་ནུབ་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་དེ་ལས་ནི་དམིགས་པ་ཁོ་ན་དྲན་པ་ཉེ་བར་གཞག་པར་གསུངས་པ་ཡིན་ཏེ།",
    "གཙང་བ་དང་བདེ་བ་དང་རྟག་པ་དང་བདག་ཏུ་ཕྱིན་ཅི་ལོག་རྣམ་པ་བཞིའི་གཉེན་པོར་དྲན་པ་ཉེ་བར་གཞག་པ་བཞི་གོ་རིམ་བཞིན་དུ་བསྟན་ཏེ་མི་མང་མི་ཉུང་ངོ།",
    "དེ་ལྟར་ལུས་ལ་སོགས་པ་ལ་དམིགས་པའི་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་གོམས་པར་བྱས་ནས།",
    "སྡུག་བསྔལ་སྟོང་བདག་མེད་པར་ལྟ།",
    "རྣམ་པར་འཕེལ་བར་བྱེད་པ་ན་སྔོན་ཐོབ་པ་རྣམས་མངོན་སུམ་དུ་མི་བྱེད་དེ།",
    "རྣམ་པར་འཕེལ་བ་ལ་ནི་ཁྱད་པར་འདི་ཡོད་དེ།",
    "རྣམ་པར་འཕེལ་བ་ལ་ནི་བཞི་ལས་གང་ཡང་རུང་བ་ཞིག་ཡིན་ལ་མ་འོངས་པ་ནི་བཞི་ཆར་རོ།",
    "བདེན་པ་གསུམ་ལ་དམིགས་པ་རྣམ་པར་འཕེལ་བ་ལ་ནི་བཞི་ལས་གང་ཡང་རུང་བ་ཞིག་ཡིན་ལ་མ་འོངས་པ་ནི་བཞི་ཆར་རོ།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྣམས་ཞེས་བྱ་བའི་དོན་ཅི་ཞེ་ན།",
    "ངེས་པར་འབྱེད་པས་ན་ངེས་པར་འབྱེད་པ་སྟེ།",
    "དེ་འདྲེན་པར་བྱེད་པ་ཉིད་ཀྱིས་ཕན་འདོགས་པའི་ཕྱིར་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྣམས་སོ།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ནི་རྣམ་པ་འདི་བཞི་ཆར་ཡང་།",
    "ཁྱད་པར་བསམ་གཏན་ས་པའོ།",
    "བསམ་གཏན་ཁྱད་པར་ཅན་དང་།",
    "དེ་ཡང་སྔར་ཡོངས་སུ་ཤེས་པར་བྱ་ཞིང་སྤང་བར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་དག་ཁོ་ན་ཡིན་གྱི་འཕེན་པར་བྱེད་པ་དག་ནི་མ་ཡིན་ཏེ།",
    "བཙུན་པ་དབྱངས་སྒྲོགས་ཀྱི་ལྟར་ན་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་དང་པོ་གཉིས་ས་བདུན་པ་ཡིན་ཏེ།",
    "གླིང་གསུམ་དུ་སྐྱེད་པར་བྱེད་དོ།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྣམས་ཇི་ལྟར་སྟོང་ཞེ་ན།",
    "གང་ཞིག་བསམ་གཏན་དངོས་གཞིའི་ས་པའི་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྣམས་སྐྱེད་པར་བྱེད་པ་དེས་ནི་ཚེ་འདི་ཉིད་ལ་གདོན་མི་ཟ་བར་བདེན་པ་རྣམས་མཐོང་བར་འགྱུར་ཏེ།",
    "རྣམ་པར་ཉམས་ན་དངོས་མེད་འཐོབ།",
    "མཚམས་སྟོན་པར་བྱེད་པ་ཞིག་ཡོད་ན་ནི་གོང་མ་སྐྱེད་པར་བྱེད་དོ།",
    "མེད་ན་ནི་གཞི་ཁོ་ནས་སྐྱེད་པར་བྱེད་དོ།",
    "ཡོངས་སུ་ཉམས་པ་ནི་ཉེས་པས་བྱས་པ་ཡིན་གྱི་རྣམ་པར་ཉམས་པ་ནི་གདོན་མི་ཟ་བ་ཡིན་ནོ།",
    "དེ་དག་ནི་ཅི་རིགས་པར་ཏེ།",
    "ཉན་ཐོས་ལ་སོགས་པའི་རིགས་ཐ་དད་པའི་ཕྱིར་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྣམས་རིགས་གསུམ་ཡིན་ཏེ།",
    "གསལ་བའི་ཕྱིར་བསམ་གཏན་བཞི་པ་ཁོ་ན་ལ་བརྟེན་ཏེ་སྟན་གཅིག་ཁོ་ན་ལ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྣམས་ནས་བཟུང་སྟེ།",
    "ཅི་ཚེ་དང་པོ་ཁོ་ན་ལ་སྦྱོར་བ་བྱས་ཏེ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྣམས་སྐྱེད་པར་བྱེད་དམ་ཞེ་ན།",
    "གཉིས་པ་ལ་ནི་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྣམས་སྐྱེད་པར་བྱེད་དོ།"
  ]
}