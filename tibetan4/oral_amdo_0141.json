    "དེ་ལ་དང་པོ་ཡང་དག་པའི་བསྟན་པ་ལ་བརྟེན་ནས་རང་གི་ངོ་བོ་ཁོ་ན་སྟེ།",
    "རང་གི་ངོ་བོ་ནི་དེ་བཞིན་གཤེགས་པ་ཉིད་ཀྱིས་རྣམ་པར་རིག་པ་ལས་རྣམ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཡང་དག་པ་དང་གཉི་ག་ལ་བརྟེན་ནས་རང་གི་ངོ་བོ་དང་གཟུགས་བརྙན་ཡོད་པར་བསྟན་པ་དེ་ཇི་ལྟར་ཤེས་པར་བྱ་ཞེ་ན།",
    "དེ་ལྟར་མུ་ཐ་དད་པ་མང་པོ་ཡོད་མོད་ཀྱི།",
    "དེ་ལ་དང་པོ་ནི་དེ་བཞིན་ཉིད་ཚིག་གི་བརྗོད་པ་ལ་སོགས་པ་མཚན་མ་སྣ་ཚོགས་པ་དང་བྲལ་བ་ལ་དགོངས་པའི་ཕྱིར་མ་གསུངས་སོ་ཞེས་རྗོགསུངས་ཏེ།",
    "གང་གི་ནུབ་མོ་མྱ་ངན་འདས།",
    "སྤྲུལ་པའི་སྐུའི་དེ་བཞིན་གཤེགས་པ་ནི་དེ་བཞིན་ཉིད་ལས་གུད་ན་རང་གི་མཚན་ཉིད་གཞན་མེད་དེ།",
    "རི་བོང་གི་རྭ་ལ་སོགས་པའོ།",
    "བློ་གྲོས་ཆེན་པོ་རི་བོང་གི་རྭ་ནི་ཡོད་པ་ཡང་མ་ཡིན་མེད་པ་ཡང་མ་ཡིན་ཡང་བརྗོད་པ་ནི་ཡོད་པའི་ཕྱིར་རོ།",
    "ཁྱོད་ཀྱིས་སྨྲས་པའི་དོན་དེ་ནི་ཉམས་པར་འགྱུར་རོ།",
    "ཁ་ཅིག་ན་རེ་དུས་བརྒྱད་ནི་བསྒྱུར་བའི་སྒྲ་བརྒྱད་ཉིད་དེ་འདི་ལྟར་བསྒྱུར་བའི་སྒྲ་བདུན་གྱི་སྟེང་དུ་འབོད་པའི་སྒྲས་བསྣན་པ་སྟེ།",
    "ཉིན་དང་མཚན་རེ་རེ་ལ་དུས་བཞི་བཞི་ཡོད་པས་གཅིག་ཏུ་བསྡུས་ན།",
    "རྣལ་འབྱོར་སྤྱོད་པའི་ས་དང་སྦྱར་ན་རེ་ཞིག་རྣམ་པར་ཤེས་པའི་ཚོགས་དྲུག་ལ་བརྟེན་ནས་སེམས་རྣམ་པ་ལྔ་རྣམ་པར་འབྱེད་པར་བྱེད་དེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་བྱུང་བ་ན་ཉེ་བར་གནས་པ་ལས་བྱུང་བ་དང་།",
    "དེ་ལ་དང་པོ་ནི་མིག་གི་རྣམ་པར་ཤེས་པ་ཉིད་དོ།",
    "དེ་ལ་ངེས་པའི་སེམས་ཕན་ཆད་ནས་ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བར་འགྱུར་བར་བལྟའོ།",
    "ཉོན་མོངས་པ་ཅན་དུ་རྒྱུན་མི་འཆད་པར་འཇུག་པར་འགྱུར་རོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་བྱུང་བ་ན་ཇི་ལྟ་བ་བཞིན་དུ་ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་བར་དུ་ཡང་དེ་བཞིན་ཉིད་དུ་རིག་པར་བྱའོ་ཞེས་འབྱུང་སྟེ།",
    "རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་པོ་དག་གི་མཇུག་ཐོགས་སུ་བྱུང་བའི་ཡིད་ཚོལ་བ་པའམསྣེ།",
    "དེ་ལ་ཁ་ཅིག་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་རང་གི་ངང་གིས་རྗོའཇུག་ཅིང་སེམས་དང་པོ་གསུམ་གྱི་གོ་རིམས་ལ་མི་བརྟེན་པ་ནི་རྣམ་པར་གཡེང་བ་ཞེས་བྱ་བའོ།",
    "འདིར་རེ་ཞིག་སེམས་རྣམ་པ་ལྔ་དང་སྦྱར་ནས།",
    "དེ་ལ་རེ་ཞིག་ཚིག་དང་པོ་ལ་བརྟེན་ནས་བསགས་པ་རྣམ་པར་དབྱེ་བར་བྱ་སྟེ།",
    "འདི་ལྟར་ཡི་གེ་བཞི་པོ་དེ་དག་རེ་རེ་ཡང་སེམས་རྣམ་པ་བཞི་དང་ལྡན་ཏེ།",
    "གལ་ཏེ་རྣམ་པར་གཡེངས་པར་མ་གྱུར་ན་ནི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "དེ་ཡན་ཛེེཆད་དུ་ནི་རེ་ཞིག་གནས་མ་གྱུར་པའི་གནས་སྐབས་ལ་བརྟེན་ནས་ཉེ་བར་གནས་པ་ལས་བྱུང་བའི་སེམས་ལ་སོགས་པའི་བསགས་པ་རབ་ཏུ་ཕྱེ་བ་བསྟན་ཏོ།",
    "མོས་པའི་སེམས་བསྐྱེད་པའི་ཕྱིར་ཏེ།",
    "ཇི་སྐད་དུ་བཅོམ་ལྡན་འདས་ཀྱིས་དུས་གཅིག་གི་ཚེ་ལྷའི་རྒྱལ་པོ་བཞི་ལ།",
    "རྒྱལ་པོ་གཉིས་ལས་གཅིག་གིས་ནི་གོ་བར་གྱུར་ལ།",
    "གཅིག་གིས་ནི་གོ་བར་མ་གྱུར་ཏོ།",
    "མིག་གིས་སྒྲ་ལ་སོགས་པ་ཐོས་པ་ལ་སོགས་པར་མི་ནུས་པ་བཞིན་ནོ།",
    "ཡུལ་གཞན་དག་གིས་ཡང་དེ་བཞིན་ནོ་ཞེས་བྱ་བའི་བར་དུ་སྟེ།",
    "ལྷའི་རྒྱལ་པོ་བཞི་པོ་དེ་དག་མོས་པ་ཐ་དད་པས་དེ་དག་གི་རེ་བ་ཡོངས་སུ་སྐོང་བའི་ཕྱིར།",
    "འདི་ལྟར་ཁ་ཅིག་བཅོམ་ལྡན་འདས་ནི་འཕགས་པའི་སྐད་འབའ་ཞིག་གིས་སྟོན་པར་མཛད་ཀྱི།",
    "སྒྲ་སྐད་ཐམས་ཅད་ལ་མངའ་བརྙེས་པ་ནི་མ་ཡིན་ནོ་སྙམ་དུ་ཐེ་ཚོམ་ཟ་བ་དག་གི་ཐེ་ཚོམ་བཅད་པའི་ཕྱིར།",
    "ཚིག་གི་སྐྱོན་ཡོད་པར་བདེན་པའི་ཕྱིར་རོ།་།",
    "དང་པོ་ནི་དེ་དག་གི་རེ་བ་ཡོངས་སུ་རྫོགས་པར་མཛད་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་ནི་དེ་དག་གི་ཐེ་ཚོམ་ཡོངས་སུ་བསལ་བའི་ཕྱིར་རོ།",
    "གསུང་སྒྲ་གཅིག་གིས་སྒྲ་སྐད་མང་པོ་དང་མཐུན་པར་མཛད་དོ།",
    "བྱ་བ་སྒྲུབ་པའི་ཡེ་ཤེས་ཀྱི་མོས་པ་ཅན་རྣམས་ཀྱི་མོས་པའི་ཁྱད་པར་ཇི་ལྟ་བ་བཞིན་དུ་གསུང་སྤྲུལ་པའི་ཕྲིན་ལས་དེས་དོན་རྣམ་པ་སྣ་ཚོགས་བསྟན་པས་ཐེ་ཚོམ་རྣམས་གཅོད་པར་མཛད་དོ་ཞེས་འབྱུང་ངོ།",
    "ཇི་ལྟར་དབུས་ཀྱི་ཡུལ་གཅིག་གི་སྐད་བརྗོད་པའི་ཚེ།",
    "དེ་བཞིན་གཤེགས་པས་གསུང་གཅིག་ཏུ་གསུང་བ་འདི་རང་གི་ངོ་བོ་ཡིན་ནམ་འོན་ཏེ་གཟུགས་བརྙན་ཉིད་ཡིན།",
    "གཟུགས་སུ་མཚུངས་པ་ཐ་དད་པར་མཐོང་གི།",
    "དེ་དག་ཀྱང་མང་མོད་ཀྱི།",
    "དེ་དག་གི་འཛིན་པ་དེ་ཡང་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་དག་གི་འཛིན་པ་དེ་ཡང་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་དག་གི་འཛིན་པ་དེ་ཡང་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་དག་གི་འཛིན་པ་དེ་ཡང་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་དྲི་མ་མེད་པ་བསྡུས་པ་ལས་གཞན་ཡང་འཇིག་རྟེན་ན་བདུད་བཞི་དང་ཉོན་མོངས་པའི་སྒོ་བརྒྱད་ཁྲི་བཞི་སྟོང་ཡོད་པས།",
    "འདི་ལྟར་དེ་དག་རེ་རེ་ལ་ཚིགས་སུ་བཅད་པ་སྟོང་ཕྲག་དྲུག་ཡོད་པས་སོ་ཞེས་ཟེར་རོ།",
    "སྒོ་སུམ་བརྒྱ་ལྔ་བཅུ་རེ་རེ་ལ་ཡང་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ཡོད་པ་དེས་ན།",
    "སུམ་བརྒྱ་ལྔ་བཅུ་པོ་རེ་རེ་ཡང་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་དང་ལྡན་ཏེ།",
    "ཇི་ལྟར་སྐྱེས་བུ་བུད་མེད་ཅིག་ལ་བུའདོད་ཆགས་སྤྱོད་པའི་ཚེ།",
    "ཇི་ལྟར་ཤོད་ཅིག་བསྐྱོད་ནས་གྲངས་གཅིག་གི་གནས་སུ་བཞག་པའི་ཚེ་ནི་གཅིག་ཅེས་བྱ་བ་དང་།",
    "སྟོང་གི་ཆེའི་སྟེང་དུ་བཞག་པའི་ཚེ་ནི་སྟོང་ཞེས་བརྗོད་པ་བཞིན་ནོ་ཞེའོ།",
    "ཇི་ལྟར་བུད་མེད་གཅིག་ལ་མ་ཞེས་ཀྱང་བྱ།",
    "བུ་མོ་ཞེས་ཀྱང་བྱ་ཞེས་བརྗོད་དོ་ཞེའོ།",
    "གང་གི་ཚེ་བྱེད་པ་དེའི་ཚེ་ནི་ད་ལྟར་བྱུང་བ་ཞེས་བྱའོ།",
    "གང་གི་ཚེ་བྱས་ནས་འགགས་པ་དེའི་ཚེ་ནི་འདས་པ་ཞེས་བྱ་སྟེ།",
    "དེ་ལ་དང་པོ་ནི་སློབ་དཔོན་ཡང་དག་བདེན་པ་ན་རེ།",
    "བརྗོད་པར་བྱ་བ་དེ་དག་གིས་ངོ་བོ་ཉིད་ཀྱི་སྟོང་པ་དང་།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "བདག་གིས་སྨྲས་པ་འདི་རིགས་པ་དང་ཤིན་ཏུ་མཐུན་ཏེ།",
    "གང་གིས་དེ་ལྟར་རབ་ཤེས་ན།",
    "རི་བོང་གི་རྭ་མངོན་སུམ་དུ་རྟོགས་པ་དང་།",
    "དེའི་ཕྱིར་སློབ་དཔོན་ཉེ་བའི་འོད་ན་རེ།",
    "དེ་ལ་གསུམ་པ་གནས་དང་གང་གི་ཆེད་དུ་གསུངས་པ་བསྟན་པ་ཞེས་བྱ་བ་ཡང་རྣམ་པ་གཉིས་ཏེ།",
    "བསྟན་པ་གང་གི་ཕྱིར་གསུངས་པ་བསྟན་པའོ།",
    "མ་མོ་ཞེས་ཀྱང་བྱ་སྟེ།",
    "དེ་ལ་བསྟན་པ་གང་གི་ཕྱིར་གསུངས་པ་བསྟན་པ་ཞེས་བྱ་བ་ཡང་རྣམ་པ་གཉིས་ཏེ།",
    "རིགས་མ་ངེས་པ་དག་གི་ཕྱིར་གསུངས་པ་ཡིན་ཏེ།",
    "བཞི་པ་ནི་རྒྱ་རྗེ་ཐང་གི་ཚེ།",
    "དོན་དམ་པའི་བདེན་པ་བསྟན་པའི་ལེའུ་ཉི་ཚེ་འབྱུང་གི།",
    "ཐུན་མོང་གི་གླེང་གཞི་དང་མཐུན་པ་ཡིན་པའི་གླེང་གཞི་ཞེས་ཀྱང་བྱ་སྟེ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་ཀྱང་བྱ་བ་ལ་སོགས་པ་བསྟན་པས།",
    "ཐུན་མོང་གི་གླེང་གཞི་ཞེས་བྱའོ།",
    "བདག་གིས་ཞེས་བྱ་བ་ནི་དོན་ངེས་པར་ནུས་པའི་གང་ཟག་བསྟན་པ་དང་།",
    "དེའི་འོག་མ་དག་གིས་ཐོས་པ་ཞེས་བྱ་བ་ནི་ཐོས་པར་ནུས་པའི་གང་ཟག་རྣམ་པར་འབྱེད་དོ།",
    "སན་དྷི་རྗོནིར་མོ་ཙ་ན་ཞེས་བྱ་བ་ལ།",
    "གསུམ་པ་ནི་ལམ་ཟབ་མོ་ལ་ཡང་སན་དྷི་ཞེས་ཟེར་བས།",
    "དེ་ནས་ལོ་ཙཱ་བ་རྣམས་སོ་སོ་ནས་དོན་རེ་རེ་ལ་བརྟེན་ནས་བསྒྱུར་བ་ཡིན་ཏེ།",
    "ནིར་མོ་ཙ་ན་ཞེས་བྱ་བ་ནི་རྣམ་པར་འགྲེལ་པ་ལ་བྱ་སྟེ།",
    "ཟབ་མོ་རྣམ་པར་དགྲོལ་བ་ཞེས་བྱ་བ་ཡང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཇེ་ཚོམ་ཟ་བ་གསུམ་བཅད་པར་དགོངས་པའི་ཕྱིར་འདི་སྐད་བདག་གིས་ཐོས་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་གསུངས་ཏེ།",
    "སྟོན་པ་ནི་གང་གིས་བགྱི།",
    "མོས་པ་ཅན་དཀའ་བློ་ཕྱེམི་བདེ་བ་དང་ཇི་ལྟར་གནས་པར་བགྱི།",
    "དགེ་སློང་མོས་པ་ཅན་ནི་ཚངས་པའི་སྨྲ་བ་ལྟ་བུས་ཆད་པས་གཅད་དོ།",
    "གང་ཟག་གཉིས་ཀས་ཀྱང་བཅོལ་བས་སོ་སོ་ནས་དོན་རེ་རེ་ལ་བརྟེན་པའི་ཕྱིར་ཕན་ཚུན་འགལ་བ་མེད་དོ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་མོས་པ་ཇི་ལྟ་བ་བཞིན་དུ་མཛད་པས་རྗེས་སུ་མཐུན་པར་གྱུར་པ་ཡིན་ཏེ།",
    "ཁ་ཅིག་ན་རེ་འདི་སྐད་ཅེས་བྱ་བ་ནི་གསུང་འདི་ལྟ་བུ་འདི་ནི་དེ་བཞིན་གཤེགས་པས་གསུངས་སོ་ཞེས་བསྟན་པའི་ཕྱིར་འདི་སྐད་ཅེས་བྱ་བ་གསུངས་སོ་ཞེའོ།",
    "དང་པོ་ནི་སློབ་དཔོན་བོ་དེ་ལེའུ་ཅིས་སློབ་དཔོན་རྡོ་རྗེ་དྲང་སྲོང་གིས་བྱས་པ་རྡོ་རྗེ་གཅོད་པའི་འགྲེལ་པའི་བརྗེད་བྱང་བྱས་པ་ལསསྐེ།",
    "རྣམ་པར་ངེས་པ་དེ་བཞིན་པ་ནི་བདག་གིས་འདི་བཞིན་དུ་མཐོང་ངོ་ཐོས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལྟ་བུའོ།",
    "གཞན་ཡང་མངོན་སུམ་དུ་ཐོས་པ་ལ་ནི་འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་བྱ་ལ།",
    "མངོན་སུམ་དུ་ཐོས་པ་ལ་ནི་བདག་གིས་ཐོས་པ་ཞེས་བརྗོད་ལ།",
    "འཁོར་རྣམས་ལ་འདི་བཞིན་དུ་བདག་གིས་སྔོན་ཐོས་པ་རྣམས་ཉོན་ཅིག་ཅེས་བྱ་བ་ལྟ་བུའོ།",
    "དེའི་ཕྱིར་ལན་དུ་འདི་བཞིན་དུ་བདག་གིས་ཐོས་སོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "ཚིག་གི་ལན་ནི་འདི་ལྟ་སྟེ།",
    "ཇི་ལྟར་བདག་གིས་ཐོས་པ་བཞིན་ནོ་ཞེས་བྱ་བའོ།",
    "གང་ཟག་གི་སེམས་ཀྱི་སྤྱོད་པ་སོ་སོར་བརྟགས་ནས།",
    "རེས་འགའ་བདག་མེད་པར་ཡང་གསུངས།",
    "ཐམས་ཅད་ཡོད་པར་སྨྲ་བའི་གཞུང་གིས་ནི་རྣ་བས་ཐོས་པ་ཡིན་གྱིས།",
    "མིག་གིས་གཟུགས་མཐོང་བ་ཡང་མ་ཡིན།",
    "ཉན་པ་པོའི་རྣམ་པར་རིག་པའི་སེམས་ཀྱིས་བླངས་ནས་ཐོབ་པ་མ་ཡིན་མོད་ཀྱི།",
    "བདག་གིས་ཐོས་པ་ཞེས་གསུངས་སོ་ཞེའོ།",
    "ཅིའི་ཕྱིར་བདག་གིས་ཐོས་ཞེས་བརྗོད།",
    "ཐ་མ་ཤིང་སཱ་ལ་ཟུང་ཅིག་གི་དྲུང་དུ་མྱ་ངན་ལས་འདས་པའི་བར་དུ་གསུང་རྣམ་པ་གཉིས་སུ་གསུངས་པས་ཡོངས་སུ་མ་རྫོགས་པ་དང་ཡོངས་སུ་རྫོགས་པ་གཉིས་ཀ་ཡང་གསུངས་ཏེ།",
    "ཆུང་ངུའི་ཕྱོགས་ཅན་གཟིགས་པ་ལ་ནི་ཡོངས་སུ་མ་རྫོགས་པའི་གསུང་གི་དུས་ཞེས་བྱའོ།",
    "ཡོངས་སུ་རྫོགས་པའི་ཕྱོགས་ཅན་གཟིགས་པ་ལ་ནི་ཡོངས་སུ་རྫོགས་པའི་གསུང་གི་དུས་ཞེས་བྱའོ།"
  ]
}