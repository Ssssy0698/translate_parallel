    "ཀུན་ནས་ཉོན་མོངས་རྣམ་པར་བྱང་།",
    "དེ་ལྟར་རྒྱུ་དེ་དང་རྐྱེན་དེས་ལོག་པར་མོས་པ་དང་།",
    "དེ་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་མོས་པ་སྣ་ཚོགས་མཁྱེན་པའི་སྟོབས་དང་།",
    "ཁམས་སྣ་ཚོགས་མཁྱེན་པའི་སྟོབས་ཀྱི་སྒོ་ནས་སྔོན་གྱི་མོས་པ་ཡང་བརྟགས་ནས།",
    "ཕྱི་མའི་ཁམས་ཀྱང་ཅི་རིགས་པར་ལོག་པར་མོས་པའི་ཁམས་གདུལ་བའི་ཕྱིར་བསྟན་པ་རྣམ་པ་བཞི་ཕལ་ཆེར་འཇུག་པར་མཛད་དོ།",
    "ཤེས་པ་ཡོངས་སུ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྨིན་པ་རྣམས་ཉོན་མོངས་པ་ལས་རྣམ་པར་ཐར་བར་བྱ་བའི་བསྟན་པ་འཇུག་པར་མཛད་དོ།",
    "དེ་ལ་ལོག་པའི་ཁམས་དང་པོ་དང་ལྡན་པ་རྣམས་ལ་ནི་ལོག་པར་མོས་པའི་ཁམས་དེ་གདུལ་བའི་ཕྱིར་རྒྱུ་འགགས་པས་འདུ་བྱེད་འགག་གོ་ཞེས་འདུ་བྱེད་འཇིག་པའི་སྒོ་ནས་མི་རྟག་པ་སྟོན་ཏོ།",
    "ན་ནི་དེ་རྣམ་པ་གཉིས་སུ་རང་གི་ཤེས་རབ་ཀྱིས་སོ་སོར་རིག་པར་འགྱུར་ཏེ།",
    "དེ་ཟད་པར་བྱེད་པའི་ལམ་ཡང་གཏན་དུ་ཡོངས་སུ་ཉམས་པར་མི་འགྱུར་བར་བདག་གིས་བསྟེན་ཏོ་སྙམ་མོ།",
    "བདག་གིས་ཉོན་མོངས་པ་མ་ལུས་པར་སྤང་བའི་ཕྱིར་བསླབ་པར་བྱ་བ་ཐམས་ཅད་བྱས་ཟིན་ཏོ།",
    "བདག་གི་སྐྱེ་བ་གཅིག་ཀྱང་མ་ལུས་ན་གཉིས་སམ་བདུན་ལྟ་ག་ལ་ཡོད་སྙམ་པ་སྟེ།",
    "ཉོན་མོངས་པ་ལྷག་མ་སྤོང་བ་རྣམས་ཀྱི་སྔོན་དུ་འགྲོ་བའོ།",
    "དེའི་བདག་ལ་ཉལ་ལས་ཡང་དག་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཉོན་མོངས་པ་སྤོང་བའི་འབྲས་བུ་རྣམ་པ་གཉིས་ཏེ།",
    "སྲིད་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འཕགས་པ་ཉན་ཐོས་ཞི་བ་མཐོང་བ་ནི་ངན་སོང་གི་སྡུག་བསྔལ་གྱི་འཇིགས་པ་ལས་འདས་པ་ཡིན་མོད་ཀྱི་འོན་ཀྱང་དེའི་ཀུན་ཏུ་སྦྱོར་བ་ཡོངས་སུ་མ་ཟད་པའི་ཕྱིར་ཕྱི་མ་ལ་སོ་སོའི་སྐྱེ་བོ་དང་ཐུན་མོངས་དུ་གྱུར་པའི་སྐྱེ་བ་དང་རྒ་ཤིའི་འཇིགས་པ་གང་སྤང་བར་བྱ་བའི་ཕྱིར་དེས་འདུན་པ་དྲག་པོ་ནས་དྲན་པ་དང་བག་ཡོད་པའི་བར་དུ་བརྩོན་པར་བྱ་བ་ཡང་ཡོད་དོ།",
    "མེད་པ་སྔོན་དུ་འགྲོ་བའི་ཡོད་པ་མ་ཡིན་ན་ནི་དེ་དག་མི་རྟག་པར་ངེས་པ་མ་ཡིན་པ་ཞིག་ན་གང་གི་ཕྱིར་དེ་དག་སྔ་མ་ནི་མེད་ལ་ཕྱིས་ནི་མེད་པ་སྔོན་དུ་འགྲོ་བའི་ཡོད་པར་འགྱུར་བར་སྣང་བས་ན་དེའི་ཕྱིར་དེ་དག་མི་རྟག་པར་ངེས་སོ།",
    "གལ་ཏེ་ད་ལྟར་བྱུང་བའི་འདུ་བྱེད་སྐྱེས་པ་རྣམས་ཡོད་པ་ཁོ་ན་ཡིན་ཏེ་ཡོད་པ་སྔོན་དུ་འགྲོ་བའི་མེད་པ་ཁོ་ན་མ་ཡིན་ན་ནི་འདི་དག་མི་རྟག་པར་ངེས་པ་མ་ཡིན་པ་ཞིག་ན་གང་གི་ཕྱིར་འདི་དག་སྔ་ན་ནི་ཡོད་ལ་ཕྱིས་ནི་ཡོད་པ་སྔོན་དུ་འགྲོ་བའི་མེད་པ་ཁོ་ནར་འགྱུར་བར་སྣང་བས་ན་དེའི་ཕྱིར་འདི་དག་མི་རྟག་པར་ངེས་སོ།",
    "གལ་ཏེ་འདས་པའི་འདུ་བྱེད་རྣམས་ཀྱི་སྐྱེ་བ་དང་འཇིག་པ་མི་སྣང་ན་ནི་དེ་དག་མི་རྟག་པར་ངེས་པ་མ་ཡིན་པ་ཞིག་ན་གང་གི་ཕྱིར་དེ་དག་སྐྱེས་པ་དང་ཞིག་པར་གྱུར་བས་ན་དེའི་ཕྱིར་དེ་དག་མི་རྟག་པར་ངེས་ཏེ།",
    "དེ་ལྟར་མི་རྟག་པ་དང་སྡུག་བསྔལ་བའི་འདུ་བྱེད་རྣམས་ཚོགས་པ་དེ་དང་དེ་ལ་བརྟེན་ནས་རྒྱུ་དང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བྱེད་པ་མེད་པའི་འདུ་བྱེད་རྣམས་འཇུག་པ་ཡོད་ལ་བྱེད་པ་པོ་དང་ཚོར་བ་པོ་མེད་ཅིང་།",
    "བདག་དང་བདག་གི་དང་བྲལ་བ་འདི་ནི་འདུ་བྱེད་ཐམས་ཅད་ཀྱི་བདག་མེད་པ་ཞེས་བྱའོ།",
    "གཏན་མེད་པའི་སྟོང་པ་ནི་འདི་ལྟ་སྟེ་འདུ་བྱེད་རྣམས་བདག་དང་བདག་གིས་སྟོང་པའོ།",
    "ཕྱིས་བྲལ་བའི་སྟོང་པ་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་པའི་སེམས་འདི་ལྟ་སྟེ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱིས་སྟོང་ཞིང་རྣམ་པར་གྲོལ་བའོ།",
    "འགོག་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བདག་གིར་འཛིན་པ་དང་།",
    "ཐོག་མ་ཁོ་ནར་འདུ་བྱེད་རྣམས་ལ་སྐྱེ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གཉེན་པོ་མངོན་དུ་གྱུར་བ་ན་མི་མཐུན་པའི་འདུ་ཤེས་ཀྱིས་ཉོན་མོངས་པ་ཀུན་ཏུ་མི་སྤྱོད་པ་གང་ཡིན་པའོ།",
    "འདི་ནི་རེ་ཞིག་སྐྱོ་བ་དང་།",
    "ཆགས་པ་དང་བྲལ་བ་ནི་འདོད་ཆགས་དང་བྲལ་བའི་གནས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་དེ་ལྟར་ཉོན་མོངས་པའི་ཀུན་ནས་ཉོན་མོངས་པ་ལས་ཀྱང་རྣམ་པར་གྲོལ་ལ།",
    "སྐྱེ་བ་ལ་སོགས་པ་སྡུག་བསྔལ་གྱི་ཀུན་ནས་ཉོན་མོངས་པ་ལས་ཀྱང་ཡོངས་སུ་གྲོལ་བ་འདི་ཡོངས་སུ་གྲོལ་བ་ཞེས་བྱའོ།",
    "རང་གི་ཉེས་པར་བཟུང་བ་དང་།",
    "བདག་གིར་འཛིན་པ་གང་ཡིན་པའོ།",
    "དེ་ལ་རང་གི་ཉེས་པར་བཟུང་བ་ནི་གཅིག་པུའི་རྟོག་པ་ངན་པ་ལ་བརྟེན་པ་འདི་ནི་བདག་ཡིན་ནོ་སྙམ་སྟེ་ལྟ་བ་ཉེས་པར་བཟུང་བའམ།",
    "འདི་ནི་བདག་གི་བདག་ཡིན་ནོ་སྙམ་དུ་རྣམ་པ་དེ་ལྟ་བུ་ལ་ཞུགས་པ་གང་ཡིན་པའོ།",
    "ཡང་འདི་ནི་བདག་གི་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་བདག་ཏུ་ཉེས་པར་བཟུང་བ་ཡང་ཡིན།",
    "རང་གི་ཉེས་པར་བཟུང་བ་ཡང་ཡིན།",
    "གཞན་དག་གི་ཚིག་ལས་ཉེས་པར་བཟུང་བ་ཡང་ཡིན་ཏེ།",
    "འཛིན་པ་དེ་དག་ཐམས་ཅད་སྤོང་བ་གང་ཡིན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
