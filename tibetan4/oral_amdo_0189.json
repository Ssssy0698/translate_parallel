    "དེ་ཉིད་ཉོན་མོངས་བྲལ་གྱུར་ན།",
    "སྔོན་ཐ་མལ་འཆིང་བ་ཀུན་ལྡན་དུ་གྱུར་པའི་གང་ཟག་གི་རྒྱུད་ལས་ཕྱིས་མངོན་དུ་གྱུར་པ་ཡོད་པའི་ཕྱིར་དང་།",
    "ཉོན་མོངས་འབའ་ཞིག་སྐྱེ་བར་ཟད།",
    "དེ་བཞིན་ཉོན་མོངས་ཀྱིས་བསྒྲིབས་པའི།",
    "ཡོད་ན་ཡོད་མོད་ཀྱི་དེ་ཉིད་མངོན་དུ་མི་འགྱུར་ཏེ།",
    "མོས་པ་དང་ནི་བཟོད་པ་དང་།",
    "དེ་བཞིན་ཉོན་མོངས་བུམ་ནང་ན།",
    "སྤྱན་རས་གཟིགས་ཀྱིས་གསོལ་པ།",
    "དེ་རྣམས་ཀྱང་བློ་སྟོབས་ཆེ་ཆུང་གིས་རིམ་བཞིན་བསྐལ་པ་གྲངས་མེད་གསུམ་དང་།",
    "རེ་རེ་གཅིག་ནས་དྲུག་བར་གཉིས་གཉིས་ཏེ།",
    "ཚོགས་སྦྱོར་མོས་པས་སྤྱོད་པའི་སེམས་བསྐྱེད་དང་།",
    "སྲོལ་གཉིས་རེ་རེ་ལའང་དབྱེ་ན་གཅིག་ནས་དྲུག་ཚན་གྱི་བར་དང་།",
    "དེ་དག་རེ་ལའང་དབྱེ་གཞི་ལ་ལྟོས་ནས་སམ་སྨོན་འཇུག་གི་དབྱེ་བས་གཉིས་གཉིས་སུ་འགྱུར་རོ།",
    "པདྨའི་ལམ་རིམ་ཆེན་མོའི་འགྲེལ་པར་ཡང་།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ལ་དངོས་སུ་སྦྱོར་པའི་ཞི་ལྷག་གི་སྦྱོར་བ་དང་ལྡན་པའི་སེམས་བསྐྱེད་ནི་མེ་ལྟ་བུ་ཡིན་ཏེ་སྒྲིབ་པའི་བུད་ཤིང་བསྲེག་པ་ལ་མྱུར་བས་སོ།",
