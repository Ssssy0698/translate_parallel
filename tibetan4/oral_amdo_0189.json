    "བདག་གིས་བྱས་པའི་ལས་གཞན་ལ་མི་སྨིན།",
    "དཀར་ནག་གི་ལས་མི་འཆོལ་བར་ཤིན་ཏུ་ཕྲ་བ་ནས་འདོར་ལེན་བྱའོ།",
    "ཞེས་རྗེས་སུ་གདམས་པ་བཞིན་བདག་ལེགས་སུ་འདོད་པ་དག་གིས་འཇུག་ལྡོག་ལག་ལེན་དུ་ཐེབ་པར་བྱ་བ་གལ་ཆེའོ།",
    "རང་གིས་བྱས་པ་གཞན་ལ་མི་འཕོ།",
    "ཕན་ཚུན་གཅིག་ཏུ་མི་འདྲེ་བས་ཟ་འོག་གི་བེར་ཁྱིམ་ལྟ་བུ།",
    "གང་ཅི་བསགས་པ་དེ་དང་མཐུན་པའི་འབྲས་བུ་རེ་འབྱིན་པར་བྱེད་པའི་ཕྱིར་བདག་གིས་ཐམས་ཅད་ལས་སུ་ཤེས་པར་བྱས་ལ་བླང་དོར་བརྩོན་པར་བྱ་དགོས་སྙམ་དུ་སྦྱོར་དངོས་རྗེས་གསུམ་ཚང་བས་ཉམས་སུ་བླང་ངོ།",
    "འདི་ནི་ཇི་སྙེད་ཇི་བཞིན་གཟིགས་པའི་ཡུལ།",
    "མེ་སྟག་ཆུང་ངུ་དག་གིས་ཀྱང་།",
    "བཅོམ་ལྡན་ཁྱོད་ཀྱིས་གང་གསུངས་པ།",
    "ཁོང་གིས་རང་ཉིད་ཀྱི་རྒྱུད་ལ་བརྟག་སྟེ།",
    "དགེ་སེམས་སྐྱེས་པ་ན་རྡེའུ་དཀར་པོ་རེ།",
    "ཡན་ལག་གི་སྡུག་བསྔལ་དྲུག་ནི་རྒྱ་མཚོའི་ཇ་",
    "རླབས་དང་འདྲ་སྟེ་བུད་པ་དང་སངས་པ་མེད།",
    "ཡི་གཉེར་མ་དང་འདྲ་སྟེ་བུད་པ་དང་སངས་པ་མེད།",
    "ཚེ་འདིའི་སྣང་བ་ལ་རང་གཞན་ཆགས་ཤིང་སྐྱིད་པར་སྣང་ཡང་ངང་ཚུལ་དེ་ལས་མ་འདས་པའི་ཕྱིར་གང་གིས་ཀྱང་ཅི་བྱ།",
    "འདོད་པའི་ཕྱིར་མགོ་དང་མིག་དང་ཡན་ལག་དང་ཉིང་ལག་བཅད་པའང་གངྒཱའི་ཀླུང་གི་བྱེ་མ་ཇ་",
    "ཁྱོད་ཀྱིས་ཇི་སྙེད་གཉེན་བཤེས་རྣམས།",
    "གང་ཉིད་ཁྱོད་ཀྱིས་རབ་བསྒྲིམས་ཏེ།",
    "རང་གི་བཞོས་པའི་ནུ་མ་ཡང་།",
    "ཁྱོད་ཀྱིས་འཐུང་བ་སྲིད་གཞན་ན།",
    "རེ་ཞིག་གཅིག་ན་དགྲ་ཡང་མཛའ་བོར་འགྱུར།",
    "སྔོན་ཆད་མཐོ་རིས་དང་ངན་སོང་གི་བདེ་སྡུག་ཇི་ཙམ་མྱོང་ཡང་ངོམས་པ་དང་སྐྱོ་སུན་མེད་པའི་ཉེས་པའང་།",
    "འགྲོ་བར་གང་གིས་ཚིམས་གྱུར་འདོད་པ་དེ་དག་མེད།",
    "འདོད་པ་ཐམས་ཅད་མི་གཅིག་གིས་ཐོབ་ཀྱང་།",
    "དེས་ཀྱང་ཆོག་པ་མེད་ཅིང་ད་དུང་ཚོལ།",
    "རེག་པས་གླང་པོ་རླག་པར་བྱེད།",
    "འདི་དག་རྒྱུ་ནི་རེ་རེས་སོ།",
    "རེ་རེའི་བདག་ཉིད་རུས་པའི་ཕུང་པོ་ནི།",
    "གང་ཁྱོད་འདི་ལྟར་འཁོར་གྱུར་ཏེ།",
    "དེ་ཉིད་བྲན་གྱུར་ཁྱོད་ཡིན་ཏེ།",
    "ཤི་ནས་ངན་སོང་སྡུག་བསྔལ་ནི།",
    "འཕགས་པ་རྣམས་ཀྱིས་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་འདི་གཟིགས་ཏེ།",
    "དེ་ནི་མིག་ཏུ་སོང་བ་ན།",
    "འདུ་བྱེད་ལ་ནི་སྡུག་བསྔལ་གཟིགས།",
    "དེ་ཡང་གཙོ་བོར་ངན་སོང་གསུམ་ལ་སྡུག་བསྔལ་གྱི་སྡུག་བསྔལ་དང་།",
    "དམྱལ་སྲུང་གཤེད་མ་རྣམས་ཀྱིས་ལུས་སྤྱི་གཙུག་ནས་རྐང་སེན་གྱི་བར་ཐིག་ནག་པོ་བཞིའམ་བརྒྱད་ལ་སོགས་པ་དུ་མ་བཏབ་སྟེ་རལ་གྲི་དང་སོག་ལེ་དང་སྟ་རེ་མེ་འབར་བས་གཤོག་པ་དང་ཡང་འབྱར་ཡང་གཅོད་པས་སྡུག་བསྔལ་ཏེ།",
    "སྟ་རེ་མི་བཟད་སོ་རྣོན་རྣམས་ཀྱིས་གཤགས།",
    "ཕྱེ་མ་ཞིབ་མོ་བཞིན་དུ་འཐག་པར་བགྱིད།",
    "མདུང་གིས་འབིགས་པ་དང་།",
    "ལྕགས་སྲེག་གི་ས་གཞིར་གན་རྐྱལ་དུ་བསྒྱེལ་ནས་ཐོ་བ་མེ་འབར་བས་རྡུང་བར་བྱེད་དེ།",
    "ཚ་བ་ལྕགས་ཁང་ནང་གཞུག་མདུང་ཐུང་གིས།",
    "ལྕགས་ཟངས་ཆེན་མོར་ཁྲོ་ཆུ་ཁོལ་མར་འཚོད་པས་སྡུག་བསྔལ་ཏེ།",
    "ལྕགས་ཁང་མེ་འབར་བ་འཁོར་ལྷགས་པ་བཅུ་དྲུག་གིས་བསྐོར་བའི་ནང་དུ་སྔར་གྱི་སྡུག་བསྔལ་ཐམས་ཅད་མྱོང་ཞིང་།",
    "སྲོག་གི་ཟུངས་ཙམ་མེ་ནང་དབུས་གནས་པ།",
    "གོང་མ་གོང་མ་ལས་འོག་མ་འོག་མ་རྣམས་མེ་སོགས་བདུན་འགྱུར་གྱིས་ཚ་ཞིང་ཚོར་བའང་བདུན་འགྱུར་གྱིས་རགས་པས་སྡུག་བསྔལ་བདུན་འགྱུར་གྱིས་ཆེ་སྟེ།",
    "དེ་དག་གི་ཁོངས་སུ་གཏོགས་པའི་ཉི་ཚེ་བ་ནི།",
    "འཚེད་པ་ལ་སོགས་པའི་སྡུག་བསྔལ་གང་རུང་རེ་རེ་ནི་བཟོད་གླགས་མེད་པས་ཉིན་མཚན་ཕྱེད་པའམ།",
    "ལྗོན་ཤིང་ལྟ་བུ་རབ་ཏུ་མང་པོ་སྡུག་བསྔལ་གྱི་གདུང་བར་གཟིགས་པར་གསུངས་པ་ལྟ་བུ་སྟེ།",
    "དེར་ནི་སྡུག་བསྔལ་གང་རུང་རེ་རེས་གདུང་།",
    "དེའི་ཕྱོགས་བཞི་རེ་རེ་ན་མེ་མར་མུར་གྱི་འོབས།",
    "ཐལ་ཚན་གྱི་ཆུ་བོ་རབ་མེད་དེ་བཞི་རེ་གནས་པས་བཞི་བཞི་བཅུ་དྲུག་དང་།",
    "མདག་མེ་འབར་བར་པུས་མོ་ནུབ་བརྒལ་བས།",
    "དེ་ལས་ཐོན་ནས་ཐང་ཉམས་དགའ་བ་མཐོང་ནས་དེར་ཕྱིན་པ་ལས་ཐང་ཐམས་ཅད་སྤུ་གྲིར་སོང་སྟེ་རྐང་པ་བཞག་ན་དུམ་བུར་གཤོག་བཏེགས་ན་སོས་པས་སྡུག་བསྔལ་ཞིང་།",
    "སྔར་གྱི་ཡུལ་དེ་ལ་འཁྱུད་པས་ལྕགས་ཀྱི་སྐྱེས་པའམ་བུད་མེད་མེ་འབར་བར་སོང་སྟེ་རབ་ཏུ་འཁྱུད་ཅིང་བསྲེགས་ལ་ཟ་བར་བྱེད་པས་སྡུག་བསྔལ་ཏེ།",
    "ཐང་མཚམས་སྐྱེས་པ་བུད་མེད་མཆེ་རྣོན་ཅན།",
    "དེ་ནས་སོང་བ་ན་ཆུ་ཀླུང་བཟང་པོ་རྒྱང་མ་ནས་འབབ་པར་མཐོང་སྟེ།",
    "འབོག་མ་ཐག་ཐལ་ཚན་སྐེད་ནུབ་ཙམ་དུ་ཚུད་དེ་ཤ་རུས་ཚིག་ནས་ཕྱིར་བྲོས་པ་ལས།",
    "དགའ་བས་སོང་སྟེ་ཞེ་ཆེན་རྒྱལ་ཚབ་འགྱུར་མེད་པདྨ་རྣམ་རྒྱལ་གྱི་གསུང་འབུམ།",
    "རབ་ཏུ་འབོག་མ་ཐག་ཐལ་ཚན་སྐེད་ནུབ་ཤ་རུས་ཚིག་གྱུར་ཅིང་།",
    "མོ་ཚོགས་དེ་དག་ཅི་ལས་བྱུང་།",
