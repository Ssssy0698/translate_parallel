    "དེ་ཡང་བཀའ་འཁོར་རྣམ་གསུམ་གཅིག་གི་ཁོངས་སུ་གཅིག་འདུ་ཚུལ་ནི་བཀའ་འཁོར་དང་པོའི་ཁོངས་སུ་བཀའ་འཁོར་ཕྱི་མ་གཉིས་འདུ་ལ།",
    "དེ་ནས་སྤྱི་ལོའི་དུས་རབས་བརྒྱད་པའི་ནང་བོད་རྒྱལ་ཁྲི་སྲོང་ལྡེའུ་བཙན་གྱིས་བོན་བསྣུབས་ནས་བོན་བསྟན་ཡང་བསྐྱར་གཏེར་དུ་གཤེགས་ནས་མཐར་སྤྱི་ལོ་༡༡༧ལོར་བོན་གྱི་གྲུབ་ཐོབ་གཤེན་ཆེན་ཀླུ་དགའ་ཞེས་པ་ཞིག་གིས་སྟོད་འབྲིག་མཚམས་ནས་བོན་གཏེར་བཞེས་ནས་བོན་ཤུགས་ཆེན་སྤེལ་བར་བསྟན་པ་ཕྱི་དར་ཟེར།་",
    "དེ་དག་གིས་ཐོག་མར་སོ་སོའི་གདུང་རྒྱུད་ཀྱི་མཚན་ཐོབ་པའི་བོན་གྱི་གདན་ས་རེ་བཞེངས་པ་ཡོད་པ་དཔེར་ན།",
    "དེ་ཚོའི་ནང་ནས་བྲུ་ཡི་གདུང་རྒྱུད་འདི་རིམ་བཞིན་ཉམས་གུད་དུ་སོང་སྟེ་མཐར་དུས་རབས་བཅོ་ལྔ་པའི་དུས་འགོར་བྲུ་ཡི་གདན་ས་དབེན་ས་ཁ་རྩ་སྟོང་དུ་ཕྱིན།",
    "ད་ཕན་ང་ཚོར་དངོས་སུ་མཐོང་རྒྱུ་ཡོད་པའི་མ་དཔེ་ཁག་བཞི་བྱུང་བ་སྟེ།",
    "དྲན་པ་བདག་གིས་ཡི་གེར་བཏབ་པའོ།",
    "དྲན་པ་བདག་གིས་ཡི་གེར་བཀོད།",
    "མ་དཔེ་གཉིས་པ་དེ་ནོར་ཝེ་རྒྱལ་ཁབ་ཀྱི་རྒྱལ་ས་ཨོ་སི་ལོད་ཀྱི་སློབ་གླིང་ཆེན་མོའི་དཔེ་མཛོད་ཁང་དུ་ཡོད་པས་དེ་ལ་ཨོ་སི་ལོད་མ་དཔེ་ཞེས་མིང་བཏགས་རྒྱུ་ཡིན།",
    "དཔེ་བཤུས་དང་ལུང་འདྲེན་སྐབས་སུ་ཆད་ལྷག་དང་ནོར་འཛོལ་ཅི་རིགས་ཡོང་རྒྱུ་ནི་ཟློག་ཐབས་བྲལ་བ་ཞིག་རེད།",
    "དེར་མ་ཟད་བཤུ་བ་པོ་དང་ལུང་འདྲེན་པའི་སྐབས་སྐབས་ཕྲལ་གྱི་གནས་བབས་དང་དགོས་མཁོ་དང་དེ་བཞིན་ཁོང་ཚོའི་ཤེས་ཚད་ལ་དཔག་པས་མ་དཔེ་འཕྲི་བསྣོན་གང་རུང་ཡང་འབྱུང་སྲིད་པ་ནི་མ་དཔེ་བཞི་དཔྱད་བསྡུར་བྱས་པ་ལས་རྟོགས་ཐུབ།་",
    "ད་དུང་སྟོན་པ་གཤེན་རབ་ཀྱིས་ལྷོ་འཛམ་བུ་གླིང་ན་སྐད་རིགས་མི་མཐུན་པ་སུམ་བརྒྱ་དྲུག་ཅུའི་ཡུལ་དུ་བོན་རང་འགྱུར་གྱི་བསྟན་པ་རེ་རེ་བཞག་པའི་རེའུ་མིག་གཤམ་གསལ།",
    "སྟག་གཟིག་སྟག་གཟིག།",
    "སྟག་གཟིག་སྟག་གཟིག་ཁྲོམ།",
    "གོང་གསལ་གྱི་རེའུ་མིག་ལས་ང་ཚོས་མཐོང་ཐུབ་པ་ནི་ནག་ཆུའི་མ་དཔེའི་ནང་དུ་ཡུལ་མིང་བཞི་གཡུང་དྲུང་བོན་དང་འབྲེལ་བའི་ལོ་དེབ་མུ་ཁྲི་བཙན་པོའི་དཔྱད་རྩོམ་བདམས་བསྒྲིགས།",
    "ཟས་སུ་ལྡུམ་ལྡུམ་ཤ་མོང་ཟ།",
    "བྲག་ཕུག་ཅིག་ཁ་ལྷོ་ནུབ་ན་ལྟས་པ་ཡོད་པ་དེར་སོང་ནས།",
    "འོན་ཡང་བྱ་བ་གང་ཡིན་རུང་ཚང་མར་གཅིག་ནས་གཉིས་སུ་གྱེས་པའི་ལྟ་བས་དབྱེ་ཞིབ་བྱས་ན་གཞི་ནས་བྱ་བའི་ངོ་བོ་དངོས་དེ་རྟོགས་ཐུབ་པའི་རེ་བ་ཡོད་པ་བཞིན།",
    "མ་དཔེ་དེ་དག་གི་ནང་ནས་ནག་ཆུའི་མ་དཔེ་དེ་གཞན་དག་ལས་ཅུང་གྲ་རྒྱས་པ་ཡོད་པས་མ་དཔེ་རྙིང་པ་ཞིག་ལ་ལས་གཡུང་དྲུང་བོན་དང་འབྲེལ་བའི་ལོ་དེབ་མུ་ཁྲི་བཙན་པོའི་དཔྱད་རྩོམ་བདམས་བསྒྲིགས།",
    "ཕུག་ལུགས་ཀྱི་སྟོན་པ་ཤཱཀྱ་ཐུབ་པའི་འདས་ལོ་༡༩༨༢དང་འཁེལ་བའི་ལྕགས་མོ་བྱ་ཡི་༦༡ལོ་ཡིན་ནོ།",
    "གཡུང་དྲུང་བོན་མཉམ་འབྲེལ་ལྷན་ཚོགས་ཀྱི་དྲུང་ཡིག་རེབ་གོང་བོན་མང་ཕུར་ཐོགས་སྟོང་དང་དགུ་བརྒྱའི་དྲུང་ཆེ།",
    "ཁོང་རང་གི་དབོན་པོ་སྤ་སྟོན་དེར་མ་དཔལ་དང་བཞིའོ།",
    "སྤ་སྟོན་དཔལ་མཆོག་དང་འབྲེལ་བ་ཟབ་མོ་ཡོད་པས་དེ་ལྟར་བྱེད་གསུངས་ནས།",
    "ཕྱིས་སྲས་གསུམ་འཁྲུངས་ནས་གཤེན་ཚང་གི་ས་བཟུང་ངོ།",
    "གཡུང་དྲུང་བོན་གྱི་བསྟན་པའི་སྲོག་ཤིང་གདུང་རྒྱུད་རྒྱལ་པོ་དྲུག་གི་ནང་ཚན།",
    "མཆོད་རྟེན་རེ་བཞེངས་ཞག་རེར་རྗེ་འབྲུག་གིས།",
    "ཁོང་གིས་ཞྭ་མོ་རྔོག་མ་མེད་པ་དང་།",
    "ཞྭ་མོ་རྔོག་མེད་མངའ་རིས་སྐོར་གསུམ་ན།",
    "ཁྱོད་ལ་འགྲོ་དོན་གདུལ་བྱ་མེད་པར་རིགས།",
    "སྤ་སྟོན་དཔལ་མཆོག་དང་འབྲེལ་བ་ཟབ་མོ་ཡོད་པས་དེ་ལྟར་བྱེད།",
    "དེ་དག་ལ་མ་འོངས་ལུང་བསྟན་གྱི་ལྟ་དགོངས་དང་མཛད་སྤྱོད་ཁྱད་པར་ཅན་གྱི་ཕ་དམ་པར་དེ་བས་ཀྱང་མཐོང་ཆེན་དང་གཙིགས་འཛིན་བྱས་ནས་ཁོང་ཚོ་དམ་པའི་མདུན་དུ་མངགས་པ་རེད།་",
    "བོད་རང་ས་ནས་དར་བའི་གཡུང་དྲུང་གི་བོན།",
    "གཞན་ཡང་ཇོ་ནང་བ་སོགས་ཀྱང་ནང་དུ་འདུས་ཡོད་པ་རེད།",
    "ལྔ་བརྒྱའི་ཐ་མ་ལ་ལ་ལས་གཡུང་དྲུང་གི་བོན་མི་བདེན་ཟེར།",
    "ཕྱོགས་འཛིན་ངོ་བོ་འདོད་ཆགས་ཞེ་སྡང་རེད།",
    "གྲུབ་པ་མིན་པ་ཉོན་མོངས་ཆེ་བས་གསལ།",
    "མཁས་མིན་བླུན་པོའི་ཁྱད་པར་གང་གིས་འབྱེད།",
    "མཁས་པ་ཉོན་མོངས་ཆེ་བ་ཆེས་མི་ལེགས།",
    "པཎ་ཆེན་སྐུ་འཕྲེང་ལྔ་བ་བློ་བཟང་ཡེ་ཤེས་མཆོག་གིས།",
    "བན་བོན་གཉིས་ཀའི་གཞུང་གི་བསྟན་དོན།",
    "ཞེས་གསུངས་ཤིང་མིང་གི་འདོགས་ལུགས་ཙམ་ལས་ཁྱད་པར་མེད་དེ།",
    "གཡུང་དྲུང་གི་བོན་ལྟར་ན།",
    "དེ་བཞིན་དུ་ཡུལ་གྱི་སྒོ་ནས་འོལ་མོ་ལུང་རིང་དང་ཤམ་བྷ་ལ་གཉིས་ངོ་བོ་གཅིག་ལ་མིང་ཐ་དད།",
    "གཤེན་ལྷ་འོད་དཀར་དང་སྤྱན་རས་གཟིགས་གཉིས་ངོ་བོ་གཅིག་ལ་མིང་ཐ་དད།",
    "ནག་མོ་དང་ལྷ་མོ།",
    "དེ་དག་གི་བཅའ་ག་ཕྱག་ལེན་གྱི་གོ་རིམ།",
    "འོན་ཡང་བསྟན་པའི་རྗེས་འཇུག་གི་ཐད་ནས་གླེང་ན།",
    "ད་ལྟའི་བོད་པ་སུ་དང་གང་ཞིག་ཡིན་རུང་དུས་རྒྱུན་གྱི་འཚོ་བའི་གོ་རིམ་ཁྲོད་ནས་བོན་ལུགས་དང་འབྲེལ་བའི་ཆོ་ག་རྒྱས་བསྡུས་ཅི་རིགས་ལ་བརྟེན་ནས་འཇིག་རྟེན་འདིའམ་ཚེ་འདིའི་ཕན་བདེ་སྣ་ཚོགས་སྒྲུབ་བཞིན་པ་ནི་དཔེར་ན་སྔ་ལྟས་མོ་དང་སྣང་མཐོང་རྩིས།",
    "གཡག་ཞར་རྩྭ་ཟན་འདི་རེ་སྡུག།",
    "སྐུར་བ་འདེབས་པ་འདི་རེ་སྡུག།",
    "དེས་ནས་ཁོ་མོས་རང་གི་ཤེས་རྟོགས་ཕྲན་བུ་ཙམ་ལ་གཞིགས་ནས་འོལ་མོ་ལུང་རིང་ཞེས་པའི་ཐ་སྙད་དེའི་སྐོར་ཅུང་ཟད་གླེང་རྒྱུ་ཡིན།",
    "སྟག་གཟིག་འོལ་མོ་ལུང་རིང་།",
    "ཀ་སྟག་གཟིག་ཅེས་པར་ངོས་འཛིན་ཚུལ།",
    "དེང་གི་ཆར་དེ་ཉིད་མགྲིན་དབྱངས་གཅིག་པའི་ཐོག་དབྱི་ལང་ཞེས་པའི་རྒྱལ་ཁབ་ལ་ངོས་འཛིན་གྱི་ཡོད།",
    "སྟོན་པ་གཤེན་རབ་ཀྱི་འཁྲུངས་ཡུལ་འོལ་མོ་གླིང་ངམ་འོལ་མོ་ལུང་རིང་བྱ་བ་དེ་གོང་ལྟར་དབྱི་ལང་ལ་ངོས་འཛིན་ཚེ་ལུང་རིགས་གང་རུང་དང་འགལ་བ་དུ་མ་ཞིག་ཡོང་ངེས།",
    "ཉམས་དགའ་བག་རེ་བྲོ།",
    "བཞུགས་གནས་ངོ་རེ་མཚར།",
    "གཤེན་ཡུལ་འོལ་མོ་ལུང་རིང་ནི་དཔག་ཚད་ལྔ་བཅུ་ཆུ་ཞེངས་མཉམ།",
    "འཛམ་གླིང་སྤྲིན་ཤད་ཤིང་གི་རྩ།",
    "དེར་བརྟེན་སྟག་གཟིག་འོལ་མོ་ལུང་རིང་གི་སྟག་གཟིག་ནི་གངས་ཏི་སེ་དང་མཚོ་མ་ཕམ་གྱི་འགྲམ།",
    "གོང་དུ་གླེང་བ་བཞིན་སྟག་གཟིག་འོལ་མོ་ལུང་རིང་གི་སྟག་གཟིག་དེ་དེང་སྐབས་ཀྱི་དབྱི་ལང་ལ་ངོས་བཟུང་ཚེ་ལུང་རིགས་གང་རུང་དང་རྒྱབ་འགལ་དུ་འགྲོ་བར་སྨྲོས་ཟིན་ཕྱིར།",
    "འོ་ན་སྟག་གཟིག་འོལ་མོ་ལུང་རིང་ངམ་སྟག་གཟིག་འོལ་མོ་གླིང་མདུན་དུ་སྟག་གཟིག་ཅེས་པའི་ཐ་སྙད་བྱུང་དོན་ཅི་ཞེ་ན།",
    "ཕྱིས་བྱུང་བོན་པོ་རྣམས་ཀྱིས་གཤེན་ཡུལ་འོལ་མོ་ལུང་རིང་ཞེས་པ་དེ་སྟག་གཟིག་ཡུལ་དུ་ཡོད་པའི་སྲོལ་གསར་དུ་གཏོད་པ་དེ་ལའང་།",
    "འོལ་མོ་ལུང་གཡུང་དྲུང་བོན་དང་འབྲེལ་བའི་ལོ་དེབ་མུ་ཁྲི་བཙན་པོའི་དཔྱད་རྩོམ་བདམས་བསྒྲིགས།",
    "ཞེས་པ་བཞིན་ཆེ་བསྟོད་ཀྱི་ཆ་ནས་འོལ་མོ་ལུང་རིང་གི་ཁུངས་བཅོལ་ཡུལ་དུ་བཞག་པ་ཞིག་ཡིན་པ་ལས་དངོས་སུ་ཡུལ་དེ་ཉིད་དུ་ཡོད་པར་བརྗོད་པ་མ་ལགས།",
    "གཞན་ད་དུང་སྟག་གཟིག་འོལ་མོ་ལུང་རིང་ངམ་སྟག་གཟིག་འོལ་མོ་གླིང་ཉིད་གཤེན་རབ་ཀྱི་དག་པའི་ཞིང་ཁམས་སུ་ངོས་འཛིན་སྲོལ་ཡོད་དེ།",
    "ཞང་ཞུང་གི་མི་རྣམས་ཀྱིས་སྟག་གཟིག་ཁྲོམ་གྱི་ཡུལ།",
    "བོད་ཀྱི་མི་རྣམས་ཀྱིས་རྟག་གཟིགས་ཀྱི་ཡུལ་འོལ་མོ་ལུང་རིང་།",
    "འོལ་མོ་ལུང་རིང་གནས་སུ་སྐྱེ་བར་ཤོག།",
    "དེ་ལྟར་སྟག་གཟིག་འོལ་མོ་ལུང་རིང་ངམ་སྟག་གཟིག་འོལ་མོ་གླིང་གང་ཉིད་དག་པའི་ཞིང་ཁམས་སུ་ངོས་འཛིན་དོན་ནི་གཙོ་བོ་དག་པའི་ཞིང་ཁམས་ཀྱི་ཡོན་ཏན་གྱི་ཆ་ནས་གླེང་བ་ཡིན་ཏེ།",
    "སྤྱིར་ང་ཚོས་དག་པའི་ཞིང་ཁམས་ན་བདེ་ཞིང་སྐྱིད་པ།",
    "སྟག་གཟིག་ཅེས་པ་ཡང་དེ་ལྟ་བུའི་ཡོན་ཏན་གྱི་ཆ་ནས་གླེང་བར་མ་ཟད།",
    "སྟག་གཟིག་འོལ་མོ་ལུང་རིང་ངམ་སྟག་གཟིག་འོལ་མོ་གླིང་དེ་གཤེན་རབ་ཀྱི་དག་ཞིང་དུ་ངོས་བཟུང་ཚེ།",
    "དེ་ལྟར་དུ་ཞང་ཞུང་གི་ཞང་ཡང་ཨ་ཞང་གི་དོན་ཡིན་ཏེ།",
    "ཞང་ཞུང་གི་ཞུང་ཞེས་པའི་ཐ་སྙད་དེ་ནི་གཙོ་བོ་ཞང་ཞུང་གི་སྐད་ཡིན།",
    "སྤྱིར་ཁྱུང་ནི་ཞང་ཞུང་གི་མི་རྒྱུད་ལས་མཆེད་པའི་རུས་རྒྱུད་གཙོ་བོ་ཞིག་ཡིན།",
    "སྲོང་བཙན་གྱི་སྐབས་སུ་བློན་པོ་སོ་སོར་བཀའ་བསྐོས་ཏེ་བོད་ཀྱི་ཁོས་དཔོན་མོག་ར་སྟོང་བཙན་དང་།",
    "ཞང་ཞུང་གི་ཁོས་དཔོན་ཁྱུང་པོ་པུན་ཟུང་ཙེ།",
    "ཞེས་པ་སོགས་ལས་གསལ་བ་བཞིན་ཞང་ཞུང་གི་མི་རྒྱུད་གཙོ་ཆེར་ཁྱུང་གི་རུས་ཆེན་ལས་གྱེས་པ་ཡིན་སྟབས།",
    "སྤྱིར་གོང་གི་ནང་ཚན་དུ་གླེང་བ་བཞིན།",
    "སྟོན་པ་གཤེན་རབ་ཀྱི་འཁྲུངས་ཡུལ་དང་ཁོང་གིས་བོན་བསྟན་པའི་གཡུང་དྲུང་བོན་དང་འབྲེལ་བའི་ལོ་དེབ་མུ་ཁྲི་བཙན་པོའི་དཔྱད་རྩོམ་བདམས་བསྒྲིགས།",
    "ཞང་ཞུང་སྒོ་ཕུག་བར་གསུམ་ལའང་གསུམ་གསུམ་མོ།",
    "སྒོ་ཐང་ལྷ་དང་གནམ་མཚོ་ཕྱུག་མོ་དང་གསུམ་མོ།",
    "བོད་ཀྱི་ཆུ་བོ་བཞི་འདུས་འགོ་སྟག་གཟིག་གམ་ཞང་ཞུང་ཕུག་པ།",
    "སྟོན་པ་བོན་བསྟན་པའི་གནས་བཅས་མཚུངས་པའི་ཆ་ནས་ཞང་ཞུང་འོལ་མོ་ལུང་རིང་བྱ་བ་གཙོ་བོ་སྟོན་པས་བོན་བསྟན་པའི་ས་ཚིགས་ལ་བརྗོད་པར་མ་ཟད།",
    "དེང་གི་དུས་འཛམ་གླིང་ས་གཞིའི་ཁྱོན་འདིར་མི་རིགས་ཀྱི་དབྱེ་མཚམས་མེད་པར།",
    "འགའ་ཞིག་གིས་བཀའ་རང་ཡིན་ཞེས་ཨུ་ཚུགས་འབའ་ཞིག་བྱེད་ཅིང་།",
    "འགའ་ཞིག་གིས་བསྟན་བཅོས་རང་ཡིན་ཞེས་གླེང་ཡང་ལུང་རིགས་གང་ནས་ཀྱང་མ་འབྲེལ་བའི་ཨུ་ཚུགས་འབའ་ཞིག་བྱེད་ཀྱི་ཡོད་འདུག་པས།",
    "ཡང་ཁོང་གིས།",
    "མཁས་པ་རྣམས་ཀྱིས་གཟིགས་ན་དགོངས་པ་བདེ་ཞིང་།",
    "ལྷག་པར་ཉེ་བའི་ལོ་རབས་ནང་མཁས་བརྒྱ་འགྲན་གླེང་དང་མེ་ཏོག་མཉམ་བཞད་ཀྱི་དུས་བཟང་ཚེས་པས་དེ་བས་ཀྱང་དེའི་སྐོར་ལྟ་ཚུལ་གླེང་མཁན་དང་དོགས་པ་གནང་མཁན་མང་དུ་སོང་ཡོད་པར་མ་ཟད་བོན་ཕྱོགས་སུ་ཡོད་པའི་ལྟ་ཚུལ་གླེང་རྒྱུའི་བགོ་སྐལ་ཡང་ལྷན་དུ་སྨིན་ཐུབ་པ་བྱུང་།",
    "སྤྱི་ལོའི་དུས་རབས་བཅུ་བདུན་པའི་ཡར་སྔོན་དུ་གཡུ་ཐོག་རྙིང་མ་ཞེས་པའི་མཚན་ཙམ་ཡང་མེད་སྟབས་དེའི་གོང་གི་མཁས་པ་རྣམས་ལ་གཡུ་ཐོག་གསར་རྙིང་སྐོར་གྱི་གསུང་གླེང་གང་ཡང་མེད།",
    "གནས་ལུགས་ཟབ་མོ་མཆོག་ཏུ་བརྩི་བ།",
    "སྦྱིན་པ་སོགས་ལྟ་གྲུབ་མང་པོ་ཞིག་གི་འབྱུང་ཁུངས་ནི་གངས་ཏི་སེ་ཡིན་པས།",
    "རྗེ་དགུང་ལོ་བཅུ་བཞེས་པའི་ནུབ་ཅིག་མནལ་ལམ་དུ་གྲུབ་པའི་ལྷ་མོ་ཡིན་ཟེར་བའི་བུད་མེད་དར་སྔོན་གྱི་གོས་གྱོན་པ་ལག་ན་བདུད་རྩི་བུམ་པ་གང་བ་ཞིག་ན་རེ།",
    "དེ་དག་གི་བརྗོད་བྱ་དང་ཚིག་སྦྱོར་གང་ཅིའི་ཐད་ནས་དཔྱད་ན།",
    "དཔྱད་བུ་ཁྲི་ཤེས་དག་གིས་བསྡུས།",
    "དེས་འཛམ་གླིང་མཁས་པའི་རྒྱན་དྲུག་གི་ནང་ཚན་ཏ་ཟིག་མཁས་པ་དམུ་ཙ་ཏྲ་ཧེ་ལ་གནང་།",
    "གཙང་གི་གཤེན་པོ་བུ་འཚོ་སྲིད་པའི་རྒྱལ་པོས་གཏེར་ཞལ་ཕྱེས་ནས།",
    "བར་ཁྲི་སྲོང་གི་དུས་སོགས་ལ་གཏེར་དུ་སྦས་དགོས་པའི་ངལ་བ་དུ་མར་འཕྲད་པར་གྱུར་པ་དང་།",
    "པདྨ་བཀའ་ཐང་གི་ལེའུ་གྱ་བཞི་པ་ལས།",
    "རེག་པ་རྩ་དང་མཐོང་བ་ཆུ་ལ་བརྟག་པའི་ཐབས་འདི་ནི།",
    "སྐྱིད་ཤོད་སྟག་མོ་རི་ལ་གཉན་འདུག་པ་གཟིགས་པས་སྟག་རི་གཉན་གཟིགས་སུ་གྲགས།",
    "བསྟོད་དུས་སྲོང་བཙན་སྒམ་པོ་སྤྱན་རས་གཟིགས་ཀྱི་རྣམ་སྤྲུལ་དུ་སེམས་ནས་དབུ་ཐོག་དབུ་བརྩེགས་ཀྱི་རྣམ་པ་ཅན་དུ་འཛིན་པ་དང་།",
    "གཏིང་ཟབ་པ་དཔག་གིས་མི་དཔོག་པར་བསྟན་པའི་ནང་ཚན།",
    "༣ དྲུག་ཁྲིར་ཀུན་ཤེས་ཉོན་མོངས་དུག་བསྲེགས།",
    "༥ ཉིས་ཁྲིར་སྙོམས་པ་ཐམས་ཅད་མཁྱེན་གཟིགས།",
    "༧ སྟོང་གི་དུས་སུ་དག་པ་གཏོ་རྒྱལ་ཡེ་མཁྱེན།",
    "༩ བཅུ་པར་ཤེས་པ་ཐང་མ་མེ་སྒྲོན་རྣམས་ཡིན་ཞིང་དེ་སྔོན་འདས་ཟིན་པར་རྣམ་འདྲེན་སྟོན་པ་རབ་བདུན་གྱི་བསྟན་པ་རིམ་བཞིན་འགྲོ་བའི་དོན་རེ་ཞིག་རྫོགས་ནས།",
    "ཉོན་མོངས་ཀྱི་སྙིགས་མ་དུག་ལྔ་ཁ་རགས།",
    "དེ་ནས་རི་རབ་ཀྱི་ཁ་ཁྱེར་ལྷོ་ཕྱོགས་རྒྱལ་པོ་འཕགས་སྐྱེས་པོའི་རྒྱལ་ས་གོང་མ་ཛ་ལན་དྷ་རའི་རྩེ་མོར་བྱོན་ནས་གཟིགས་ཚད་ལྔ་དང་དགོངས་ཚད་ལྔ་ཐུགས་ལ་བཀྲམ་སྟེ་གཟིགས་ཚད་ལྔ་ནི།",
    "རིགས་རྒྱལ་རིགས་དམུ་ལ་གཟིགས་པ་དང་ལྔའོ།",
    "ཡུལ་འོལ་མོ་ལུང་རིང་།",
    "ངོ་མཚར་ཆེ་བའི་ཡོན་ཏན་འབུམ་གྱིས་བརྒྱན་པའི་རྟག་གཟིགས་འོལ་མོ་ལུང་རིང་གི་ཞིང་ཁམས་རྒྱལ་ས་མཁར་བར་པོ་སོ་བརྒྱད་དུ།",
    "ཟླ་བའི་དང་པོ་དཔྱིད་ཟླ་ར་བ་མེ་སྟག་གི་ཟླ་བ།",
    "སྐར་མ་རྒྱལ་གྱི་རུ་གོང་ལ་སྟོན་པ་མཆོག་གི་གསང་གསུམ་ཡིད་བཞིན་ནོར་བུའི་དཀྱིལ་འཁོར་གྱི་མཚན་དཔེ་མཁའ་མཉམ་བསྟན་འགྲོ་ཡོངས་ཀྱི་དཔལ་དུ་སྐུ་འཁྲུངས།",
    "པོ་ཏི་བཅུ་གཉིས་ལ་ལེའུ་དྲུག་ཅུ་རེ་གཅིག་པ་དང་།",
    "ཉོན་མོངས་པ་གཉིས་ཡོད་པའི་ལས་ནི།",
    "ཉོན་མོངས་ནི།",
    "ལས་འབྲས་དང་བླང་དོར་ལ་རྨོངས་པའི་ཉོན་མོངས་ཐམས་ཅད་ཀྱི་རྩ་བ་ནི་མ་རིག་པ་དང་།",
    "དེ་ལས་གྱེས་པའི་ཉོན་མོངས་དུག་གསུམ་དང་དུག་ལྔ་ཉོན་མོངས་ཐམས་ཅད་ཀྱི་གཙོ་བོ་རྩ་ཉོན་དྲུག་དེ་ལས་གྱེས་པའི་ཉེ་ཉོན་ཉི་ཤུ།",
    "ཉོན་མོངས་བརྒྱད་ཁྲི་བཞི་སྟོང་བཅས་སོ།",
    "ལས་ཉོན་ཀུན་ཟད་ནས་མཐར་ཐུག་གི་བདེ་བ་ཆེན་པོ་ཐོབ་པ་ལ།",
    "དེ་ལས་ལྡོག་པ་བསམ་པ་ནག་པོས་ཀུན་ནས་བསླང་སྟེ་སེམས་ལས་སུ་མ་རུང་ན་ལུས་ངག་གི་ལས་སྤྱོད་ལས་སུ་མི་རུང་ཞིང་།",
    "རང་གི་སེམས་ནི་རང་གིས་གདུལ།",
    "ཉོན་མོངས་རྗེས་སུ་སེམས་མ་གཏོང་།",
    "ཉོན་མོངས་རྗེས་སུ་སེམས་མ་གཏོང་གསུངས་པ་དེ་དོན་གྱི་འགག་རྩ་གཙོ་བོ་རང་སེམས་ཚོད་ཟིན་མིན་ལ་ཐུག་ཡོད།",
    "རང་སེམས་རང་གིས་ཚོད་མ་ཟིན་ཕྱིན་ཆད།",
    "རང་སེམས་རང་གིས་ཚོད་བཟུང་བའམ་ཆོག་ཤེས་ཡག་པོ་ཞིག་དགོས་པ།",
    "འཇིག་རྟེན་གསེར་དུ་སོང་ཡང་ངོམས་དུས་མེད།",
    "བརྟུལ་ནི་རང་གི་རིག་པ་བརྟུལ།",
    "ཞེས་པ་ལྟར་ཀུན་རྫོབ་ཏུ་རྗོད་བྱེད་ཚིག་གི་སྒོ་ནས་སྤྱིར་སྟོན་པས་གསུངས་པའི་བོན་ཡོད་དོ་ཅོག་དོན་དམ་པར་ནང་སེམས་ཀྱི་རང་བཞིན་དང་།",
    "སེམས་ལ་ཕན་ཐོག་ཆེ་ཤོས་སོང་སྟབས།",
    "དེ་དག་ཐམས་ཅད་སེམས་དོན་སྟོན་པའི་ལུང་ཁོ་ནར་ངེས་པའི་ཚུལ་ནི་ཁྲོ་རྒྱུད་དབལ་མོ་ལས་ཐིག་ལས།",
    "ཞེས་པའི་ཚིག་དོན་འདི་དག་ལ་བློ་གྲོས་ཞིབ་མོས་བརྟག་དཔྱད་ཇི་ཙམ་བྱས་པས།",
    "བསམ་བཟང་དྲི་མེད་གང་གིས་འགྱུར་ལྡོག་མེད་པ་གསེར་གྱི་བྲག་ཆེན་ལྟ་བུའི་སེམས་པ་བརྟན་པོར་དགོས་ཏེ།",
    "གང་གིས་བཅོས་བསླད་བསྒྱུར་དུ་མེད་པའོ།",
    "གཞན་ཡང་རང་རྒྱུད་ཀྱི་ཉོན་མོངས་ཞི་ཐབས་བསྟན་པའི་ཚུལ་ཡང་སྤང་བྱ་ཉོན་མོངས་ཀྱི་རྣམ་གྲངས་ལ་ལྟོས་ཏེ།",
    "ཉོན་མོངས་བརྒྱད་ཁྲི་བཞི་སྟོང་ལ་ལྟོས་ཏེ་བོན་སྒོ་བརྒྱད་ཁྲི་བཞི་སྟོང་དང་།",
    "གལ་༣ཀྱི་ནང་ནས་གསུམ་པ་འགྲོ་འདུལ་ནས་བརྒྱད་པ་བསྟན་པ་རྗེས་བཞག་གི་བར་རོ།",
    "ལུགས་ལ་བཙན་དུག་ཧ་ལ་ནག་པོ་སྲོག་གི་གཤེད་མ་འཆི་བའི་དུག་དེ་མཐོང་ན་མེ་ལ་བསྲེགས་པ་དང་།",
    "ཉོན་མོངས་སྤང་བསྒྱུར་གང་ཡང་མི་བྱེད་པ་མ་བཅོས་རང་བབས་སུ་བཞག་ན་རང་ཞི་རང་གྲོལ་དུ་འགྲོ་བ་སྤང་བླང་གཉིས་མེད་ཞིག་ཏུ་འདོད་དོ།",
    "ཉོན་མོངས་བརྒྱད་ཁྲི་བཞི་སྟོང་རྒྱས།",
    "སེམས་ཕྱོགས་ཀྱིས་ཉོན་མོངས་མ་བཅོས་རང་བབས་སུ་བཞག་ན་རང་ཞི་རང་གྲོལ་དུ་འགྲོ་བ་ལས།",
    "དཔེར་ན་རྨ་བྱས་བཙན་དུག་ཟ་བ་ལ་སྤང་བསྒྱུར་གང་ཡང་མི་དགོས་ཤིང་སྐྱོན་མེད་རང་སྟོབས་སུ་འཇུ་བ་ལྟར་རམ་རང་མདུད་རང་བཀྲོལ་སྤྲུལ་གྱི་མདུད་པ་བཞིན་ཉོན་མོངས་གྲོལ་ལམ་དུ་བྱེད་པའོ།་",
    "ཐལ་གནང་སྟངས་རགས་ཙམ་ཞིག་ལ།",
    "སེམས་ཕྱོགས་ལ་གཞི་རང་འབྱུང་ཡེ་ཤེས་སོགས་གདུལ་བྱ་བཀྲི་དྲང་གི་ཆེད་དུ་ཐེག་སྒོ་ཐ་དད་ཀྱི་གཞིའི་ཐ་སྙད་མང་དུ་བཞེད་ཀྱང་།",
    "གཞི་ཆུ་གཅིག་ལ་རིགས་དྲུག་གི་འཛིན་སྟངས་ཐ་དད་དྲུག་ཤར་བ་ལྟར།",
    "གཞི་ཡི་ཡིན་ལུགས་རྟོགས་ཀྱང་བཅོས་བསྒྱུར་དུ་སོང་བ་སྔགས་དང་།",
    "སྔགས་ཀྱིས་བསྒྱུར་བྱ་ཉོན་མོངས་དང་།",
    "འབྱུང་དུག་གི་ཕུང་པོ་དེ་རང་ལུས་རྒྱལ་བའི་དཀྱིལ་འཁོར་འགྲུབ་བྱེད་ཀྱི་རྒྱུ་ས་བོན་དང་ཡིག་འབྲུ་སོགས་ལ་བརྟེན་ནས།"
  ]
}