    "ཡུལ་དང་དུས་དང་རང་བཞིན་དག།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་མི་དད་པའི་ཕྱིར།",
    "བུམ་པ་ལས་གཟུགས་ལ་སོགས་པ་དག་ཡུལ་དུས་རང་བཞིན་ཐ་མི་དད་དེ་བུམ་པའི་ཡུལ་དང་རང་བཞིན་གང་ཡིན་དེ་ཉིད་གཟུགས་སོགས་ཀྱི་ཡང་ཡིན་པས་སོ།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུངས་པ།",
    "ཉན་ཐོས་པ་དང་རང་རྒྱལ་འདིར།",
    "གནས་མ་བུ་བས་གང་ཟག་དེ་ཕུང་པོ་དང་གཅིག་ཐ་དད་རྟག་མི་རྟག་སོགས་གང་དུ་ཡང་བརྗོད་དུ་མེད་ཀྱང་རང་སྐྱ་ཐུབ་པའི་རྫས་ཡོད་དུ་འདོད་དེ།",
    "འཁྲུལ་ཞིང་རང་མཚན་མངོན་སུམ་དུ་སྒྲིབ་པའི་དོན་གྱིས་དེ་ལྟར་བརྗོད་དེ།",
    "དངོས་པོ་ཡིན་ན་གཟུགས་ཡིན་ནམ་ཤེས་པ་ཡིན་ཞེས་བཙལ་འདུག་པའང་བླུན་པོའི་འཚོལ་ལུགས་ཡིན་པས་དོར་ཞིག།",
    "པཎ་ཆེན་བཟང་བཀྲས་སོགས་སུས་ཀྱང་མ་ཐོན་འདུག་པས་ཅུང་ཟད་བཀྲལ་བ་འདི་དཔྱོད་ལྡན་རྣམས་ཀྱིས་དགའ་བའི་ཡུལ་དུ་མཛད་པར་ཞུ།",
    "མངོན་སུམ་ལ་ཡུལ་རིག་ཚུལ་གྱི་སྒོས་གཞན་རིག་དང་རང་རིག་གཉིས།",
    "གཟོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཉིད་ལས་བརྩམས་ནས།",
    "བར་གྱི་བསྐལ་བ་ཉི་ཤུར་ཞིག་ནས་འདུག་གོ།",
    "བར་གྱི་བསྐལ་བ་ཉི་ཤུར་འཇིག་རྟེན་ཆགས་ནས་འདུག་གོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཁ་ཅིག་ས་ལྟ་བུར་འདུག་གོ།",
    "ཁ་ཅིག་སྣ་ཚོགས་པདྨའི་དབྱིབས་སུ་འདུག་གོ།",
    "ཁ་ཅིག་ཤིང་རྟའི་དབྱིབས་སུ་འདུག་གོ།",
    "དབྱིབས་གཞན་དང་གཞན་དུ་འདུག་པ།",
    "རྫས་གཞན་དང་རང་བཞིན་ཐ་དད་ལ་ལྷན་ཅིག་དམིགས་ངེས་མེད་པའི་ཕྱིར།",
    "རྟོག་པ་ཡང་རང་མྱོང་བའི་ངོ་བོ་ཅན་ཡིན་པས་རྟོག་པ་ལས་དོན་དམ་པར་ཐ་དད་མི་སྣང་བ་དང་།",
    "ཏིང་འཛིན་སྒྲུབ་ཚུལ་སྐྱོན་མེད་ཙམ་ཡང་སྒོམ་ཚུལ་དེ་ལ་མ་མཐོང་ལ་ཨིནྡྷ་བོ་དྷཱིས་རྒྱས་པར་བཀག་འདུག་པས་བློ་ལྡན་རྣམས་ཀྱིས་བག་བྱ་བའི་གནས་སུསྣང་ངོ།",
    "ཚོར་བ་དེ་ཡང་རང་བཞིན་གྱིས།",
    "དཔེར་ན་གངས་རི་སྔོར་སྣང་ཅན་གྱིས་དེ་སྔོན་པོར་སྣང་བ་མེད་པ་ལ་སྣང་ཚུལ་བརྗོད་པ་ན་དེ་ལའང་དེའི་རྣམ་པ་སྣང་བ་འཆར་ཡང་རང་ལ་གངས་རི་སྔོན་པོར་ེད་པ་བཞིན་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་ལྟར་སེམས་འགག་ན་བྱ་བ་མི་འཐད་པར་བརྩད་པའི་ལན་དུ་ཡང་རང་འགྲེལ་ལས།",
    "སྭ་བྷ་ཝ་ཏཱ་ངོ་བོ་ཉིད་དང་རང་བཞིན་གཉིས་ཀར་འཇུག་པས་འགྱུར་ཁྱད་ཡིན་ལ།",
    "ཁོ་རང་ལུགས་ལ་མ་བརྟགས་གཏན་ཚིགས་བཀོད་པས་རང་གཞན་ལ།",
    "གལ་ཏེ་ཡང་རང་དང་སྤྱིའི་མཚན་ཉིད་དག་ཐ་དད་པར་ཁས་བླངས་པའི་ཕྱིར།",
    "འཁོར་གསུམ་གང་ལ་ལན་བཏབ་ཀྱང་རང་ཚིག་དང་འགལ་ལོ།",
    "སྭེ་རཱི་ཞེས་དང་རང་འདོད་ལ།",
    "འོན་ཀྱང་རང་བཞིན་མེད་པ་ཡིན་ནོ་ཞེས་འདོད་དོ།",
    "རིང་ན་འདུག་ཀྱང་དེ་དང་དེ།",
    "བྱང་སེམས་དང་རང་རྒྱལ་དང་།",
    "རང་མཚན་གྱིས་གྲུབ་པ་དང་རང་ངོས་ནས་གྲུབ་པ་དང་།",
    "ཞེས་པ་ནི་དངོས་པོ་ག་ཡང་རང་བཞིན་གྱིས་སྐྱེ་འགག་གནས་གསུམ་དང་གཞན་ལས་སྐྱེ་བ་གང་ཡང་མེད་དེ།",
    "སློབ་དཔོན་གྱིས་ཀྱང་ཀུན་རྫོབ་ཏུ་རྒྱུ་དང་འབྲས་བུའི་ངོ་བོར་འདུག་པ་ལ་ཐ་སྙད་དུ་གཅིག་ལས་དུ་མ་སྐྱེ་བ་དང་།",
    "ཡོད་ན་ལྟོས་གྲུབ་དང་རང་བཞིན་མེད་པ་གཉིས་ཀ་ཡིན་དགོས་པའི་ཕྱིར་ཏེ།",
    "ང་རང་ངོས་ནས་གྲུབ་པར་སྣང་བ་ངའི་དོན་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "སྟག་ཚང་པས་རང་རྒྱུད་ཐ་སྙད་དུ་འདོད་ཟེར་བ་ནི་གཞན་གྲགས་ཀྱི་རྟགས་དང་རང་རྒྱུད་གཅིག་པར་འཁྲུལ་བ་ཆེ་ཤོས་སྔར་ལྟར་ཡིན་ཏེ།",
    "བརྩོན་པ་དེ་ཡང་རང་རྒྱལ་གྱི།",
    "ཞེས་བསྐུལ་མ་ཞིག་བྱས་ཡོད་ཀྱང་བྱེ་བཙིར་བ་ལ་མར་ནག་ཡོང་རིགས་སུ་མི་འདུག་པས།",
    "ཡིན་ཕྱིར་འཁྲུལ་དང་རང་བཟོས་མ་བསླད་པས།",
    "སྣང་སྟོང་རང་ས་ནས་གྲོལ་བར་འདོད་པ་དང་",
    "དེ་ཡང་རང་བཞིན་གྱིས་བརྟགས་པས་འཆར་བྱེད་སྣ་ཚོགས་པར་འཆར་བར་བྱེད་པས་ཏྲ་ཞེས་བྱའོ",
    "སྔོན་དུ་ལུས་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་དུ་སྔ་འགྱུར་བཀའ་མ་ཨེ་བརྒྱད་འདུག་པ་ཞག་གསུམ་དུ་དུར་ཁྲོད་དུ་སྦྱངས",
    "ལུས་ཀྱི་སྒྲ་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་དུ་འདུག་པས",
    "བརྟགས་པ་ལ་ཡང་རང་བཞིན་མེད་ལ",
    "གནས་ཀྱང་རང་བྱུང་རིག་པའི་ཡེ་ཤེས",
    "དུས་ཀྱང་རང་བྱུང་རིག་པའི་ཡེ་ཤེས་སམ་རིག་པ་རྡོ་རྗེ་ལུ་གུ་རྒྱུད་ཀྱི་སྐུ་ལས་གཞན་པ་ནི་མ་ཡིན་ནོ",
    "ཐོག་མར་བྱུང་ཡང་རང་བྱུང་དུ་བྱུང་བའི་རིག་པ་ཉིད་སུས་ཀྱང་བཅོས་པ་མེད་པའི་སྟོན་པར་བཞུགས་པ་དེ",
    "འདུག་ན་ཡང་ནམ་མཁའ་ལ་འཁོད་དོ",
    "སྦུབས་ཕྱི་ནང་༧ དུ་རྒྱུ་བ་ལ་བརྟེན་པའི་འགྲོ་འོང་ཀྱང་རང་བཞིན་གྱིས་ཟད་པས་ཚེ་ལོ་ཡང་དཔག་ཏུ་མེད་པ་ཐུབ་བོ",
    "བསྐྱོད་ཅིང་རྒྱུགས་པའི་རྣམ་པ་རྣམས་ལ་ཡང་བར་སྣང་ཉིད་ལས་ཀ་གཞན་པའི་འགྲོ་འདུག་ཅི་ཡང་མིན་ནོ",
