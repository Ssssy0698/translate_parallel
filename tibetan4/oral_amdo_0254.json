    "ཨོཾ་བཛྲ་མཧཱ་ཀཱ་ལ་ས་པཱ་རི་ཝ་ར་ཨ་མྲི་ཏ་པཱུ་ཛ་ནས་སུ་ར་ཏེ་སྟྭཾ་གྱིས་མཆོད།",
    "གཏོར་མ་ཨོཾ་ཨཱ་ཧཱུཾ་གིས་སྦྱངས་རྟོགས་སྦར།",
    "མཆོད་སྦྱིན་འདི་འབུལ་སྤྱི་དང་བྱེ་བྲག་གི།",
    "ཁྱོད་ཀྱི་ཐུགས་ཀྱི་གསང་བ་ནམ་མཁའི་མཛོད།",
    "དཔལ་མཆོག་དང་པོའི་སྐྱེས་བུ་ཁྱོད་ལ་བསྟོད།",
    "སྔོན་ཆད་ཁྱོད་དང་རང་སེམས་གཉིས་མེད་དུ།",
    "དམར་མོ་འབར་གདོང་ཙནྜི་ཀ་དང་ནི།",
    "འབྲས་བུའི་ཞལ་ཟས་རྫོགས་པའི་རོལ་མོ་འབུལ།",
    "ཤེས་པས་བསྟོད་བྲལ་ཁྱོད་ལ་བསྟོད་བགྱིས་ན།",
    "ཉོན་མོངས་རང་རིག་ཀློང་དུ་ཞི་བ་དང་།",
    "ཕྲིན་ལས་ཁྱེད་ལ་རེའོ་མྱུར་དུ་མཛོད། ། དཔལ་ཡེ་ཤེས་ཀྱི་མགོན་ལྷ་མོ་དུད་སོལ་མའི་གཏོར་བསྔོ་བསྡུས་པ་བཞུགས་སོ།",
    "མཆེ་གཙིགས་ལྗགས་འདྲིལ་མི་རོ་རེངས་པ་གསོལ།",
    "དམར་བའི་སྤྱན་གསུམ་བཟློག་གཟིགས་ཟུར་ཕུད་ཅན།",
    "བ་གླང་ཀོ་རློན་རེ་ལྡེས་སྨད་དཀྲིས་ནས།",
    "དུར་ཁྲོད་ཆས་རྒྱན་ཨོཾ་ཨཱ་ཧཱུཾ་གིས་མཚན།",
    "སུམ་ཅུ་རྩ་བདུན་གནས་ཀྱི་ཕོ་ཉ་མོའི།",
    "དྷུ་ཡིག་གིས་བརྗོད་བདག་ཉིད་ཐབས་ཀྱི་ལྷས།",
    "མོད་ལ་བརྗོད་འདི་འོལ་ཕྱིར་མི་སྤོབས་མཐུ།",
    "ནང་གི་ལྷ་མོ་ཁྱོད་མཉེས་ཉམས་བརྒྱའི་གར།",
    "ཟོས་དུས་གསང་བའི་མ་མོ་ཁྱོད་ཞབས་དྲན།",
    "རྀ་ཡིག་སྒྱུ་མའི་ཁམས་བཞི་ལྷ་མོའི་གླུས།",
    "མི་ཕྱེད་འདོད་པས་དངོས་གྲུབ་སྦྱིན་ཁྱོད་ཀྱིས།",
    "པད་དཀར་བཞེད་པའི་དྲི་བསུང་གིས་སིམ་པའི།",
    "མདུན་དུ་འཆི་མེད་ལྷ་ཡི་སྐྱེད་མོས་ཚལ།",
    "བཙུན་མོ་ནང་མི་མངག་གཞུག་རྒྱ་མཚོ་དང་།",
    "དེང་འདིར་བདག་གིས་དད་པས་སྤྱན་འདྲེན་གྱིས།",
    "བེ་གསེར་རི་འབུམ་གྱི་ལང་ཚོ་ཆགས་པའི་སྐུ།",
    "དེ་ལྟར་བསྟོད་ནས་རྣམ་ཀུན་བདག་ཅག་གི།",
    "ཡིད་ལ་ཅི་འདོད་བསམ་པའི་མོད་ཉིད་དུ།",
    "རང་རིག་བསམ་འཕེལ་མཆོག་གི་དངོས་གྲུབ་སྩོལ།",
    "དཀར་མོ་ཕྱག་གཉིས་རྡོ་རྗེ་ཚེ་བུམ་བསྣམས།",
    "ཤར་དུ་རྒྱང་བུར་མཐིང་གི་ཞལ་བཟང་མ།",
    "ལྷོ་རུ་སྟག་མོར་མི་གཡོ་གླང་བཟང་མ།",
    "སེར་མོ་ཕྱག་གཉིས་ཟས་ཀྱི་གཞོང་པ་འཛིན།",
    "དམར་མོ་ཕྱག་གཉིས་གཏེར་སྒྲོམ་ནོར་བུ་འཛིན།",
    "བྱང་དུ་འབྲུག་མོར་གཏལ་དཀར་འགྲོ་བཟང་མ།",
    "ལྗང་མོ་ཕྱག་གཉིས་རྩྭ་དང་སྦྲུལ་ཞགས་འཛིན།",
    "ཀུན་ཀྱང་བཅུ་དྲུག་ལང་ཚོ་རྒྱས་པ་ལ།",
    "བཀྲ་ཤིས་མཐོན་མཐིང་རི་ཡི་རྒྱལ་མོ་ནས།",
    "བདུག་སྤོས་སྤྲིན་གསེབ་མར་མེ་ཉིན་མོར་བྱེད།",
    "ལྷ་ཡི་རོལ་མོ་ལ་སོགས་རྫོགས་པར་འབུལ།",
    "ཕྱོགས་བཞིར་མཆེད་འཁོར་མཐིང་གི་ཞལ་བཟང་མ།",
    "མཐར་ཐུག་བདེ་ཆེན་མཆོག་གི་དངོས་གྲུབ་སྩོལ། ། རྡོ་རྗེ་གཡུ་སྒྲོལ་མའི་གསོལ་མཆོད་བསྡུས་པ་བཞུགས་སོ།",
    "བོད་སྐྱོངས་བརྟན་མའི་གཙོ་མོ་གཡུ་སྒྲོལ་མ།",
    "ལང་ཚོ་ལ་གནས་དར་དང་རིན་ཆེན་སྤུད།",
    "གཙོ་མོའི་ཐུགས་ཀའི་ཧྲཱི་ལས་འོད་འཕྲོས་པས།",
    "ཨོཾ་བཛྲ་པྲ་མོ་ཧ་པཱུ་ཛ་བ་ལིངྟ་ཁ་ཁ་ཁཱ་ཧི་ཁཱ་ཧི་ས་གཏོར་མ་ཕུལ།",
    "གཉིས་འཛིན་རེ་དོགས་བསྒྲལ་བའི་གྲོགས་མཛོད་ཅིག།",
    "སྒོ་མོ་གསོལ་བསྡུས་བཞུགས།",
    "ཅེས་པ་རྣམ་སྲས་མན་ཆད་ཀྱི་གསོལ་བསྡུས་རྣམས་དགེ་རིན་པས་རང་གི་ངག་འདོན་གྱི་ཆེད་དུ་བྲིས་པའོ།",
    "སྒྲུབ་གནས་མཆོག་ཏུ་བསྔགས་པ་སྟག་ཚང་གི།",
    "བཟང་དགུའི་མཆོད་གཏོར་བདག་གིས་འབུལ་ལགས་ཀྱིས།",
    "དགྱེས་དགུས་བཞེས་ལ་གང་བཅོལ་ཁྱོད་ཀྱིས་སྒྲུབས།",
    "བདག་གི་རིགས་རུས་ལྷུན་པོའི་ཕྲག་པ་ནས།",
    "དཔལ་འབྲུག་བསྟན་པ་ཉམས་པའི་ཚུལ་ལ་གཟིགས།",
    "དཀར་ཕྱོགས་ཉིན་མོར་བྱེད་པའི་སྣང་བ་ཡིས།",
    "གང་བསམ་མོད་ལ་འགྲུབ་པའི་ཕྲིན་ལས་མཛོད།",
    "མཐོང་ནས་རྣལ་འབྱོར་བདག་གི་བསམ་པའི་རྩེ།",
    "ཁྱོད་ལ་གཏད་དོ་རེ་བ་དོན་ལྡན་མཛོད།",
    "ཐུགས་དམ་གཉེན་པོ་བདག་གིས་བསྐང་བ་ནི།",
    "སྟོང་གྲོགས་དམ་པ་མཛོད་ཅིག་མཐུ་མ་ཆུང་། ། མགོན་པོ་དང་ལྷ་མོའི་གཉེན་གསོལ་ནས།",
    "རྣལ་འབྱོར་བདག་གི་དཔུང་གཉེན་མངོན་ཤེས་རྫུ་འཕྲུལ་གྱི་མཐུ་དང་ལྡན་པ་ཐམས་ཅད་བདག་ལ་དགོངས་སུ་གསོལ།",
    "ཅིའི་ཕྱིར་གནས་བཅུ་པོ་འདི་དག་གི་གོ་རིམས་ཉུའདི་ལྟར་བསྟན་ཞེ་ན།",
    "གནས་བཅུ་པོ་དེ་དག་གི་གོ་རིམས་ནི་དེ་ལྟར་བསྟན་ཏོ།",
    "དེ་ལ་རེ་ཞིག་ཐོག་མ་ཁོ་ནར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ནི་ཤེས་བྱའི་གནས་སོ་ཞེས་བརྗོད་པ་བཅོམ་ལྡན་འདས་ཀྱིས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཞེས་བསྟན་པས།་",
    "འདི་ནི་རེ་ཞིག་ལུང་ངོ།",
    "གཉིས་པ་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་ཉོན་མོངས་པ་བཞི་པོ་འཇིག་ཚོགས་ལ་ལྟ་བ་དང་།",
    "དེ་ནི་རྣམ་པར་ཤེས་པ་ཀུན་ནས་ཉོན་མོངས་པའི་གནས་སོ།",
    "གཉིས་པས་ནི་ཉོན་མོངས་པ་ཅན་དུ་བྱས་པ་སྟེ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་དེ་ཡོད་པར་ཅི་མངོན་ཞེ་ན།",
    "འདི་ལྟར་འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ནི་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་ཀྱིས་རབ་ཏུ་ཕྱེ་བ་ཡིན་གྱིབྱེ།",
    "ངའོ་རྩིསྙམ་པའི་ང་རྒྱལ་མེད་ན་འདུ་ཤེས་མེད་པར་སྐྱེ་བ་ཐོག་ཐག་ཏུ་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་སྐྱོན་དུ་ཡང་འགྱུར་རོ།",
    "ཉོན་མོངས་ཅན་གྱི་ཡིད་མེད་ན།",
    "ཡིད་ནི་ཉོན་མོངས་པ་ཅན་ཡིན་པའི་ཕྱིར་བསྒྲིབས་ལ་ལུང་དུ་མ་བསྟན་པ་སྟེ།",
    "གཟུགས་དང་གཟུགས་མེད་པ་ན་དེསྤྱོད་པའི་ཉོན་མོངས་པ་བཞིན་དུ་འདི་ནི་བསྒྲིབས་ལ་ལུང་དུ་མ་བསྟན་པ་ཉིད་དོ།",
    "ཤེས་བྱ་ཕྲ་མོ་བསྡུ་བའི་ཕྱིར་ཏེ།",
    "ལ་ལར་རེས་འགའ་གཟུགས་དང་སེམས་རྒྱུན་ཆད་པར་སྣང་ཡང་ཧཱུཾཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་དེའི་ས་བོན་ནི་རྒྱུན་མི་འཆད་པའི་ཕྱིར་རོ།",
    "ཉན་ཐོས་ཀྱི་ཇེག་པར་རྣམ་པར་གཞག་འུཔའི་ཚུལ་དུ་ན་ཡང་དེ་དག་གི་རྣམ་པར་གཞག་༧པ་དེ་མི་རུང་བ་མེད་མོད་ཀྱི།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ནང་གི་བདག་གི་དངོས་པོར་ཁས་བླངས་པ་ནི་ཤིན་ཏུ་སྦུག་བསྔལ་བའི་འགྲོ་བ་རྣམས་སུ་སྐྱེས་པ་སྙུག་བསྔལ་གྱི་ཕུང་པོ་རྣམ་པར་ཞིག་པར་༥འདོད་ཀྱང་།",
    "ལ་བདག་གི་དངོས་པོར་ཆགས་པའི་རྗེས་སུ་འབྱེལ་པ་ནི་ཡོད་པ་ཉིད་དོ།",
    "འདི་ནི་རེ་ཞིག་ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་རྣམ་གྲངས་རྣམ་པར་གཞག་པའོ།",
    "རང་གི་མཚན་ཉིད་རྣམ་པར་གཞག་པ་དང་།",
    "དེ་ལ་ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་རང་གི་མཚན་ཉིད་ནི།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ཀུན་ནས་ཉོན་མོངས་ང་།",
    "ཐ་མི་དད་པ་ཡང་མ་ཡིན་མོད་ཀྱི།",
    "མདུང་༤ཁྱེམ་ཡང་དུས་མཉམ་དུ་གཅིག་ལ་གཅིག་བརྟེན་ནས་མི་འགྱེལ་བ་དེ་༥བཞིན་དུ་འདིར་ཡང་གཅིག་གི་རྒྱུ་ཉིད་དུ་གཅིག་འགྱུར་བར་བལྟའོ།་།",
    "དཔེར་ན་ཚི་༨གུའི་རྩི་སྣ་ཚོགས་ཀྱིས་༩བསྒྱུར་བའི་རས་སྣ་ཚོགས་སུ་མི་སྣང་བ་གང་གི་ཚེ་ཚོན་ཀྱི་སྣོད་དུ་བཅུག་པ་དེའི་ཚེ་རས་ལ་ཚོན་རྣམས་ཀྱི་དབྱེ་བ་ཐ་དད་པ་རྣམ་པ་སྣ་ཚོགས་དུ་མ་སྟོན་ང་།་",
    "ཁ་ཅིག་ནི་བདག་གི་རྒྱུ་ལས་བྱུང་བ་ཉིད་དུ་རྟོག་༩།",
    "དེ་དག་ལ་ལ་ལ་༡ཞིག་གིས་གླང་པོ་ཆེ་བསྟན་ལ།",
    "དེ་དག་ལས་ཁ་ཅིག་གིས་ནི་གླང་པོ་ཆེ་དེའི་སྣ་ལ་རེག།",
    "ཁ་ཅིག་གིས་ནི་མཆེ་བ་ལ་རེག།",
    "ཁ་ཅིག་གིས་ནི་རྣ་བ་ལ་རེག།",
    "ཁ་ཅིག་གིས་ནི་རྐང་པ་ལ་རེག།",
    "ཁ་ཅིག་གིས་ནི་མཇུག་མ་ལ་རེག།",
    "ཁ་ཅིག་གིས་ནི་སྒལ་ཚིགས་ལ་རེག་ལ་༡དེ་དག་ལ་གླང་པོ་ཆེ་ཅི་འདྲ་ཞེས་དྲིས་པ་དང་།",
    "ཁ་ཅིག་ན་རེ་གཤོལ་མདའ་ལྟ་བུ་ཞིག་ཉོ་ཞེས་ཟེར།",
    "ཁ་ཅིག་ན་རེ་གཏུན་ཤིང་ལྟ་བུ་ཞིག་གོ་ཞེས་ཟེར།",
    "ཁ་ཅིག་ན་རེ་ཞིབ་མ་ལྟ་བུ་ཞིག་གོ་ཞེས་ཟེར།",
    "ཁ་ཅིག་ན་རེ་གཏུན་གྱི་གཞི་ལྟ་བུ་ཞིག་གོ་ཞེས་ཟེར།",
    "ཁ་ཅིག་ན་རེ་ཕྱགས་མ་ལྟ་བུ་ཞིག་གོ་ཞེས་ཟེར།",
    "ཁ་ཅིག་ན་རེ་ཕ་བོང་ལྟ་བུ་ཞིག་གོ་ཞེས་ཟེར་བ་དེ་བཞིན་དུ།",
    "རང་གི་འབྲས་བུས་བསྒྲུབས་པ་འོ།",
    "རིགས་ལ་བྱ་ན་གཞན་དུ་ཐལ།",
    "ཕྱི་དང་ནང་གི་ས་བོན་དེ།",
    "ཕྱི་རོལ་གྱི་ས་བོན་ཇི་ལྟ་བ་བཞིན་དུ་ནང་གི་རྣམས་ཀྱི་ས་བོན་ཉིད་ནི་ལྔདེ་ལྟ་མ་ཡིན་པའི་ཚིགས་སུ་བཅད་པ།",
    "ནང་གི་འདོད་པ་མ་ཡིན་ཏེ།",
    "རྣམ་པར་ཤེས་པ་དེ་གཉིས་ནི་གཅིག་གི་རྐྱེན་གཅིག་ཡིན་ཏེ།",
    "ཡང་རྣམ་པར་ཤེས་པ་དྲུག་པོ་དག་རྐྱེན་དུ་ཞིག་གིས་ཏྲེསྐྱེ་ཞེ་ན།",
    "ཇི་ལྟར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉིད་རྣམ་གྲངས་འདི་དག་གིས་བསྟན་པ་དང་།",
    "འདི་ལྟར་ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་མི་རུང་སྟེ།",
    "ཉོན་མོངས་པའི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ལས་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "སྐྱེ་བའི་ཀུན་ནས་ཉོན་མོངས་པ་ཡང་མི་རུང་ངོ།",
    "ཉོན་མོངས་པའི་ཀུན་ནས་ཉོན་མོངས་པ་ཇི་ལྟར་མི་རུང་ཞེ་ན།",
    "འདི་ལྟར་ཉོན་མོངས་པ་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པས་བག་ཆགས་ས་བོན་ཉིད་དུ་བྱས་པ་ནི་རྣམ་པར་ཤེས་པའི་ཚོགས་དྲུག་པོ་དག་ལ་མི་རུང་སྟེ།",
    "འདི་ལྟར་མིག་གི་རྣམ་པར་ཤེས་པ་གང་འདོད་ཆགས་ལ་སོགས་ང་།་",
    "ཉོན་མོངས་པ་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པ་གང་དག་དང་ལྷན་ཅིག་སྐྱེས་ཤིང་འགགས་པ་དེ་ཉིད་ལ་དེ་དག་གི་ས་བོན་གྱི་དངོས་པོར་བག་ཆགས་བསྒོས་པར་འགྱུར་གྱི་གཞན་ལ་ནི་མ་ཡིན་ནོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་འགགས་པ་རྣམ་པར་ཤེས་ང་།་"
