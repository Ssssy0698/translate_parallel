    "དེ་ནས་དགེ་སློང་ཞིགའདུག་པ་དེས་སྙས་པ།",
    "དགེ་སློང་དག་སྔོན་བྱུང་བརི་བྲགསཤིག་ན་ཁྱིམ་བ་དགཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱོ་ད།",
    "ཡད་དག་སློང་གང་དག་སློད་མཉེ་དུམ་ཡིན་པ་ལམ་པོ་ཆེན་འདུག་པ་བསོད་སྙོམས་ཀྱི་ཕྱིར་གྲོང་དུ་འགྲོ་བ་ལས་བཅ་འ་བ་དང་།",
    "ལམ་པོ་ཆེན་འདུག་པ་ཞེས་བྱ་བ་ནི་སྲང་དུ་སོད་བའོ།",
    "མཔོཆེ་ན་འདུག་པ་བསོད་སྙོམས་ཀྱི་ཕྱིར་གྲོང་དུ་འགྲོ་བ་ལས་ཉདུ་མ་ཡིན་པར་འདུ་ཤེས་པས་བཅའ་པ་དད།",
    "བཟའ་བས་གང་བ་ཤིང་ཏའི་བད་འདང་བྲལ་བ་དག་འདུག་པ་དང་།",
    "འཕྱ་དང་ལྷུད་བཟེད་འདུག་པ་དང་།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་གཙད་སྤྲ་འདོད་པ་ཞིག་འདུག་པ་དེས་སྒོ་ཁད་རུ་མལ་བཤམས་ནས།",
    "མ་བསྒོ་བར་ཁྱིམ་གཞན་དུ་སྟནལ་མི་འདུག་པར་བསླབ་པར་བྱའོ།",
    "སྟན་ལ་མ་རྔགས་པར་ཁྱི་མ་གཞན་དུ་སྟན་ལ་འདུག་པར་མི་བྱ་བར་བསླབ་པར་བྱའོ།",
    "དེ་ཅང་མི་ཟེརབར་འདུག་གོ།",
    "རྐད་པ་མི་བསྣོལ་བར་ཁྱམགཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "བརྙ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུསྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "ལོང་བུའི་སྟེང་ངུལང་བུམ་གཞག་པར་ཁྱིམ་གཞན་ངུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "རྐང་པ་མ་དགུག་པར་ཁྱམ་གཞན་དུ་སྟནལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "རྐད་པ་མིགདེང་བར་ཁྱིམ་གཞན་ངུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱདས་ཏེ་ཅདམི་སྨྲ་བར་འདུག་པའི་གོངསྐབས་དེདགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་བ་དང་།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲས་པར་ཆུ་ཟས་དང་འབགས་པབརྒྱ་ཁྱིམ་གཞན་དུམི་དབོ་བར་བསླབ་པར་བྱའོ།",
    "དྲུང་ན་འདུག་བའི་དགེ་སློད་ལ་ཟས་དང་འབགས་པའི་ཆུས་མ་གཏོར་བར་བསླབ་པར་བྱ།",
    "མི་ན་བར་ཉལ་བལ་འདུག་སྟ།",
    "མི་ན་བར་སྟན་མཐོན་པོ་ལ་འདུག་པ་ལ་སྟན་མ་ལ་འདུག་སྟེ་ཆོམམི་བཤདཔར་བསླབ་པར་བྱའོ།",
    "ཉན་ཐོས་དོ་ཚོ་དར་ཁྲལ་མེད་པ་འདི་འགྲེད་བཞིན་དུ་གཤར་གཅི་བགྱིད་པ་ག་ལ་གདའ་ཞེས་ཟེར་བའི་སྐབས་དེ་དགེ་སློད་རྣམས་ཀྱིསབཅོ་མ་ལྡན་འདས་ལ་གསོལ་པ་དད།",
    "ད་ན་མ་གཙད་བའི་དྲིབྲོ་ནས་དེ་ལག་པ་འགྲམ་པ་ལ་གཏད་དེ་སེམས་ཁོད་དུ་ཆུད་ཅིང་འདུག་པ་དང་།",
    "འདི་ཇི་ལྟར་འོད་བའིའདུལ་སྟངས་ལས་ན་འདིས་བདག་ཟན་གཅོད་པར་བྱེད་དེ་སྙོམ་དུ་རིག་ནས་དེ་ཤིང་ལྗོན་པ་དེ་ལས་བབས་ཏེ་འདུག་གོ།",
    "དགེ་སློང་དེ་ཤིང་ལྗོན་པ་ལ་མི་གངཙམ་དུ་འཛེགས་ཏེ་འདུག་པ་དང་།",
    "གཞན་ཡང་མ་ཕྱི་ནང་མི་གསལ་བ་དང་དོགས་ཅན་ཁ་ཤས་སྣང་ཡང་རང་སར་བཞག་པ་ལས་ཕྲི་བསྣན་རྔོ་མི་ཐོགས།",
    "བྱ་ཚིག་དང་བྱེད་ཚིག་གང་ལྟར་རུང་རིགས་མ་ཕྱི་ལྟར་རང་སར་བཞག་༣ནས་ཎས་ན་ཟླན་ཏས་ང་རངས་ཁ་ནས་ནས་ནགས་ནསན་ས་འདཀ་ཀྱི་མདུན་དུ་མཐོལ་བཤགས་བཟོད་གསོལ་ཞུ།",
    "ད་ནས་ཁྱེད་རང་འདིར་སྡོད་དགོས་མེད།",
    "མ་བསྡུས་པར་ཡང་རང་ཉིད་འདུ།",
    "ས་སན་འ་ས་ས་མ་ས་ལ་ས་མ་ས་ལ་ས་མ་མས་རབ་ཙ་ན་ས་སྲོག་བཅད་པའི་ཉེས་དམིགས་དང་།",
    "རྒྱལ་པོ་དེ་མགུ་ཞིང་རངས་ཏེ།",
    "རྒྱལ་བུ་དེ་ཡང་པདྨའི་སྟེང་དུ་འདུག་པར་གྱུར་ནས།",
    "ད་བདག་དུས་མཁྱེན་གྱིས་གང་དུ་འགྲན་པའི་གནས་ཡངས་པ་ཞིག་ཏུ་བྱི་དོར་གྱིས་ཤིག་དེར་རྒྱལ་པོས་གནས་ཡངས་པར་ཕྱག་དར་དང་།",
    "གལ་ཏེ་མ་རྙེད་ན་ནི་རྔོན་པ་དེ་དག་གཉེན་ཚན་དང་བཅས་པ་གྱོད་ལ་ཐོགས་པར་འགྱུར་སྙམ་དུ་སེམས་མི་དགའ་ཞིང་འདུག་པ་ན།",
    "ཨུ་པཱ་ལི་དང་མ་འགགས་པ་སོགས་དགྲ་བཅོམ་པ་གཞན་རྣམས་ལ་ཞུས་ཀྱང་མ་གནང་བས་འོད་མའི་ཚལ་ནས་ཕྱིར་བྱུང་སྟེ་སྒོ་ཐེམ་ལ་འདུག་ནས་སྐད་ཆེན་པོས་སྨྲེ་སྔགས་ཕྱུང་བ་ན།",
    "མིའི་ལུས་ལ་གཅན་གཟན་གྱི་མགོ་ཅན་དུ་འདུག་པའི་ཡི་དྭགས་མང་པོས་མི་ཞིག་བསྐོར་ཏེ།",
    "རྒྱལ་ཐབས་བཏང་སྟེ་རི་ལ་བདག་སྲུང་ཞིང་འདུག་པ་ལས་ཚེ་འཕོས་ནས་ཆུ་སྲིན་དུ་སྐྱེས་ཏེ་དེ་ཡང་གང་དག་རྒྱལ་པོའམ་བློན་པོ་མཐུ་རྩལ་ཅན་དུ་སྐྱེས་ཏེ།",
    "ཕྱིར་ལོག་སྟེ་འོང་ཙ་ན་བུ་ཆུང་བ་དེ་ཡང་སྤྱང་ཀིས་ཟོས་ནས་ཁྲག་ཅུང་ཟད་ཙམ་སྣང་བས་བརྒྱལ་ཞིང་འགྱེལ་ལོ།",
    "དེའི་རུས་བུ་སྦས་པའི་སྟེང་ན་མྱ་ངན་གྱིས་ངུ་ཞིང་འདུག་པ་དང་འཕྲད་ནས།",
    "བདག་འདུག་སའི་གནས་འདིར་གསེར་བུམ་པ་གང་ཡོད་ཀྱིས་ཕྱིར་ལོག་པའི་ལམ་དུ་ཁྱེར་ཅིག་ཅེས་བསྒོའོ།",
    "ཀླུ་ཞིག་རིན་ཆེན་སྣ་བདུན་གྱི་གཞལ་མེད་ཁང་ན་འདུག་པ་མཐོང་ངོ།",
    "གསེར་གྱི་མཁར་ན་འདུག་པའི་ཀླུ་ནི་ཀུན་དགའ་བོ་དང་།",
    "སྟན་ལ་འདུག་པ་གནས་༢ ཟས། ཉ་",
    "ཤིང་དེའི་དྲུང་དུ་ཆུ་མིག་བཟང་པོ་ཞིག་ཀྱང་འདུག་པས་དེ་ལ་འཐུང་ཞིང་ཁྲུས་བྱས་པ་ན།",
    "དགེ་དོན་སྒྲ་འཛིངས་ཤིང་གདོང་མཆི་མས་གང་བ་དང་གོས་ངན་པ་གྱོན་ཏེ་ཤིང་དྲུང་ན་འདུག་པ་དེ་མཐོང་ནས།",
    "དེར་རྒྱལ་པོ་བལྟར་ཕྱིན་པ་དང་རྒྱལ་བུ་དངོས་སུ་འདུག་པས།",
    "ད་ལྟ་གནས་ཁང་ན་འདུག་གོ།",
    "རྒྱལ་པོ་གཅིག་པུ་ནགས་ཚལ་འཐུག་པོར་ཕྱིན་ནས་རྟ་ལས་བབ་སྟེ་འདུག་པ་ན།",
    "སུ་ཏ་སོ་མ་ཕྱིར་ཁྱིམ་དུ་ཕྱིན་ཙ་ན།",
    "བྲམ་ཟེ་དེ་ཡང་འདུག་པས་རབ་ཏུ་དགའ་ནས་སྦྱིན་པ་བྱིན་ནོ་ བྲམ་ཟེ་དེས་ཀྱང་སུ་ཏ་སོ་མ་རིང་པོར་མི་ཐོགས་པར་སྲོག་དང་བྲལ་བར་འགྲོ་བས་ཕྱིར་ཡུལ་ལ་ཆགས་ན་མི་དགའ་བར་ཤེས་ནས།",
    "ང་སྔོན་རི་ལ་འདུག་སྟེ་འཇིག་རྟེན་ན་མི་དགའ་བ་ལས་ནན་གྱིས་རྒྱལ་པོར་བཅུག་སྟེ།",
    "བདག་ཤིང་གཞན་གྱི་སྟེང་ན་འདུག་ཚེ་སྐད་མི་སྙན་ལ།",
    "གྱོས་པོའི་ཁྱིམ་ན་འདུག་པའི་ཚེ་ཕ་མའི་ཁྱིམ་འདོད་ན་དེ་ཅིའི་ཕྱིར་ཞུས་ཤིག་ཅེས་སྨྲས་སོ།",
    "རྒྱལ་པོའི་ན་བཟའ་ལ་དུད་པའི་དྲི་མ་འདུག་པས་དེས་མཆི་མ་ཤོར་རོ་ཟེར།",
    "གསེར་གྱི་གླང་པོ་ཆེ་དེ་ཡང་རྟག་ཏུ་དྲུང་ན་འདུག་གོ།",
    "འདྲེན་མ་ནུས་པར་འདུག་པ་ན།",
    "དེ་དག་གཅིག་ལ་གཅིག་དགའ་བས་འགྲོ་ན་ཡང་ལྷན་ཅིག་ཏུ་འགྲོ་འདུག་ན་ཡང་ལྷན་ཅིག་ཏུ་འདུག་སྟེ་ཡུལ་མི་རྣམས་ཀྱང་དགའ་ནས་རྗེས་སུ་ཡི་རང་ངོ།",
    "སུ་ནི་ཕོངས་ཤིང་འདུག་སུ་ནི་ཉམ་ང་བར་གྱུར།",
    "དགེ་སློང་རང་ཉིད་ཀྱི་སྔོན་གྱི་གནས་རྗེས་སུ་རྟོགས་པར་བྱས་པས།",
    "དད་པས་ཁྲི་ལས་ལྡང་བར་བརྩམས་པ་དང་སྒྱུར་བ་དེ་ཡང་རང་སངས་ཏེ་ལུས་སྔ་མ་ཁོ་ན་བཞིན་དུ་གྱུར་ནས་སྟོན་པའི་སྤྱན་སྔར་འདུག་པ་དང་།",
    "དོམ་དེ་ཕུག་ན་འདུག་པ་བསྟན་པས་དེ་གཉིས་ཀྱིས་དུག་མདས་བསྣུན་ཏེ་བསད་ཅིང་དེའི་ཚེ་དོམ་གྱིས།",
    "དེ་ན་འདུག་ཀྱང་ཁ་ཅིག་ནི་འཐོབ་ལ་ཁ་ཅིག་ནི་མི་འཐོབ་བོ།",
    "བདག་ཐོངས་ཤིག་དང་ཕྱིན་ཆད་སུ་ལའང་སྦྱིན་པར་མི་བྱེད་ལ་ཕྱིན་ཆད་ཁྱིམ་འདིར་ཡང་མི་འདུག་གོ་ཞེས་སྨྲས་ཀྱང་མ་ཉན་པར།",
    "ཡི་དྭགས་ལུས་ཆེ་ལ་རོ་སྨད་ནི་ཐ་མལ་པར་འདུག་པ་ལ་རྐེད་པ་ཡན་ཆད་ནི་ལུས་གཉིས་སུ་གྱུར་ཏེ།",
    "དེའི་ཚེ་བུ་དེས་པའི་རུས་བུ་དེ་བྱ་རྒོད་ཕུང་པོའི་རི་ལས་ཐག་མི་རིང་བ་ཞིག་ཏུ་ཕྱུང་སྟེ་བསྲེགས་ནས་དུར་ཁྲོད་དེ་ཉིད་དུ་འདུག་ཅིང་མྱ་ངན་གྱིས་བྲང་རྡུང་ཞིང་ཆོ་ངེས་འདེབས་པར་བྱེད་དོ།",
    "དེ་ཐོས་པ་དང་རབ་ཏུ་དགའ་ནས་དེར་ཕྱིན་ཏེ་ཞབས་ལ་ཕྱག་བྱས་ནས་འདུག་པ་དང་།",
    "དེ་དག་སེར་སྣ་སྐྱེས་ནས་ཀྱང་ སེམས་ནི་ཀུན་ནས་དཀྲིས་ཤིང་འདུག།",
    "དེ་དག་སྐྲག་སྟེ་རང་རང་འདོད་པའི་ལྷ་ལ་གསོལ་བ་བཏབ་པ་ན།",
    "དེ་གཉིད་སད་པ་དང་རང་གྱིས་སྲོག་ལ་རྒོལ་བ་ན།",
    "སེམས་དད་པར་བྱས་ཏེ་སྤྱན་སྔར་འདུག་གོ།",
    "ནམ་ཞིག་བྲམ་ཟེ་དེ་ཁང་སྟེང་དུ་འདུག་པ་ན།",
    "དེ་ནས་གདོལ་པའི་ཁྱེའུ་དེས་འཕགས་པ་ལ་ཕྱག་བྱས་ནས་འདུག་པ་ན།",
    "དེས་ཡིད་བྱེད་ཀྱི་ལུང་ཕོག་པས་ནག་པོས་ཀྱང་བསམ་གཏན་བཞི་དང་མངོན་ཤེས་ལྔ་ཐོབ་སྟེ་དྲང་སྲོང་རྒན་པོ་ཤི་བའི་འོག་ཏུ་གནས་དེར་འདུག་པར་བྱེད་དོ།",
    "དེ་ནས་གནོད་སྦྱིན་དེ་རང་གནས་སུ་ཕྱིན་ཏེ་འདུག་པ་ན་དྲང་སྲོང་ནག་པོ་དེ་ཞག་བདུན་ན་འཆི་བར་མཐོང་ནས།",
    "ད་དུང་འདིར་འདྲ་ཁ་ཤས་སྣང་ཡང་རང་སར་བཞག་ཡོད།",
    "ནམ་ཞིག་ན་རྒྱལ་པོ་ཚངས་བྱིན་གཡུལ་ཕམ་ནས་གཅིག་པུར་བྲོས་པས་ཐར་ནས་ནགས་ཁྲོད་གཅིག་ཏུ་ཞུགས་ཏེ་རྟ་ལས་བབ་སྟེ་འདུག་པ་ན།",
    "དེ་དང་ཐག་མི་འདུག་གོ།",
    "སྟན་བྱེད་འདི་ལ་འདུག་ཅིག་ཅེས་སོགས་གསུངས་ཏེ་སྟན་གྱི་ཕྱེད་བསྟབས་པས་ཐམས་ཅད་འགྱོད་ཅིང་ངོ་མཚར་དུ་གྱུར་ཏོ།",
    "འབབ་ཆུ་དྲག་པོ་ཞིག་ཡོད་པའི་ནང་དུ་ཁྱུ་མཆོག་རང་ཉིད་འདུག་སྟེ་ཟམ་པ་བྱས་ནས་དེའི་སྟེང་དུ་ཐམས་ཅད་བྲོས་སུ་བཅུག་པས།",
    "མཉན་ཡོད་ན་གནས་པའི་སྐྱེ་བོ་མང་པོ་དག་དུས་དུས་སུ་དེ་ལ་བལྟར་འགྲོ་ཞིང་།",
    "ངས་ནི་འཕྱེ་བོ་ཁྲི་ལ་འདུག་པ་ཁྱེད་རྣམས་ལ་ཅི་རྙེད་པ་བསྒྲུབས་ཏེ་བྱིན་ན་ཁྱེད་ཀྱིས་བདག་གཅིག་པུ་ལ་མི་ཟེར་བར་མང་པོའི་ནང་དུ་དམའ་ཕབ་བོ་ཞེས་བྱས་སོ།",
    "བདག་ནི་གཅེར་བུར་འདུག་པས་དེ་དག་དང་མངོན་སུམ་དུ་ཕྲད་པར་འགྲོ་མི་ནུས་སོ་སྙམ་སྟེ།",
    "སྲོག་ཕངས་པ་སྦྱིན་པར་མཛད་དུ་གསོལ་ཞེས་ཟེར་ཞིང་འདུག་པ་ན་རྨི་ལམ་སད་པར་མཛད་པས།",
    "ཁྱེད་ཀྱང་དེའི་འདབས་སུ་འདུག་སྟེ།",
    "བདག་གཉིས་ནི་འདི་ན་འདུག་བཞིན་དུ།",
    "རང་རང་གང་ལ་དགའ་བ་དེའི་བསྔགས་པ་བརྗོད་པར་བྱེད་པ་ལས།",
    "གཙུག་ལག་ཁང་དུ་འདུག་བཞིན་དུ་དེས་རྒྱུན་ཞུགས་ཀྱི་འབྲས་བུ་ཐོབ་ཅིང་།",
    "ཕ་ཕ་ཞེས་བརྗོད་ཅིང་ཞབས་ལ་ཕྱག་བྱས་ཏེ་སྐུའི་དྲུང་ན་འདུག་གོ།",
    "དེས་ཀྱང་ཡུལ་དེ་ཆམ་ལ་ཕབ་སྟེ་འདུག་པ་ན།",
    "འདུག་པ་དང་།",
    "ས་ཆེན་པོ་འདི་ཆ་བདུན་དུ་བགོས་པའི་ཆ་དྲུག་པོ་རྒྱལ་རིགས་གཞོན་ནུ་དྲུག་པོ་དེ་ལ་བྱིན་ཅིང་རང་རྒྱལ་སྲིད་ལ་བཀོད་ནས་ཆ་གཅིག་པོ་དེ་རྒྱལ་པོ་རྡུལ་རང་ཉིད་ཀྱིས་བཟུང་ངོ།",
    "དེ་གཉིས་རང་རང་འདོད་ཕྱོགས་ལྟར་གྱིས་ཆེ་བ་བརྗོད་ནས་བདོག་པ་མི་མཐུན་པར་གྱུར་ནས།",
    "བྱེ་སྟོངས་ཤིག་ཏུ་ཕྱིན་ཏེ་དེ་དག་རྒྱགས་ཟད་ཅིང་ངལ་ཞིང་དུབ་སྟེ་ཉི་ཚན་གྱིས་གདུང་ནས་ཉ་བྱེ་ཚན་དུ་བོར་བ་ལྟར་གྱུར་ཏེ་ཤིན་ཏུ་སྡུག་བསྔལ་ཞིང་ཉམ་ཐག་པས་གུ་ལང་ལ་སོགས་པ་རང་རང་འདོད་པའི་ལྷ་རྣམས་ལ་བོས་ཀྱང་ཅུང་ཟད་ཀྱང་སྐྱོབ་པར་བྱེད་པ་མ་བྱུང་བས།",
    "སྐྱེ་དགུ་ལ་བྱམས་པ་ཞིག་སྟེ་དེས་རྒྱལ་ས་ལ་འདུག་ན་ཉེས་པ་མང་བར་མཐོང་ནས་རྒྱལ་པོ་ལ་གསོལ་ཏེ།",
    "ད་ས་བོན་དེ་སྨྱུང་བར་འདུག་ཀྱང་འགྱོད་པ་མེད་པར་མཐོང་ནས།",
    "ངོ་ཚ་ཞིང་གདོང་སྨད་དེ་གནས་དེར་འདུག་པ་ན།",
    "དེ་ལྟ་བུའི་སྡུག་བསྔལ་མི་བཟད་པ་མྱོང་ཞིང་འདུག་གོ་གསུངས་སོ། ཡང་བཅོམ་ལྡན་འདས་འོད་མའི་ཚལ་ན་བཞུགས་པའི་ཚེ།",
    "ནི་གཅེར་བུར་འདུག་པས་ངོ་ཚ་སྟེ་མི་ནུས་སོ།",
    "རུས་པ་པགས་པ་སྐྱེ་རྣམས་ད་དུང་འདུག།",
    "ཡི་དྭགས་དེས་དེ་ལྟར་གཤེགས་པ་མཐོང་ནས་བཅོམ་ལྡན་འདས་ལ་སེམས་དགའ་བ་སྐྱེས་ཤིང་རང་ཉིད་ངོ་ཚ་བར་ཡང་གྱུར་ཏོ།",
    "དུར་ཁྲོད་ན་འདུག་བཞིན་དུ་ཀེང་རུས་ཀྱིས་བསྐོར་བ་ཉིན་མཚན་དུ་བུ་ལྔ་ལྔ་འབྱུང་ཞིང་དེ་དག་ལ་བྱམས་བཞིན་དུ་བཀྲེས་པས་ཉེན་ནས་ཟོས་ཀྱང་མ་འགྲངས་ཏེ་སྡུག་བསྔལ་བར་མཐོང་ནས་བཅོམ་ལྡན་འདས་ལ་གསོལ་ནས།",
    "རང་རང་འདོད་པའི་ལྷ་ལ་འབོད་པར་བྱས་ཀྱང་སྐྱབས་བྱེད་པ་ནི་སུ་ཡང་མ་བྱུང་ངོ།",
    "གནས་གང་དང་གང་དུ་ཡང་བདེ་བར་འདུག་ཏུ་ཡོད་དོ་ཞེས་དགའ་བའི་ཚིག་ལན་གསུམ་དུ་བརྗོད་པར་བྱེད་དོ།",
    "གཅིག་པུར་འདུག་པ་ནི་དགའ་བར་བྱ་དཀའོ།",
    "སོ་སོའི་སྐྱེ་བོར་འདུག་བཞིན་དུ།",
    "དེའི་དུས་ཀྱི་དགེ་སློང་གཞོན་ནུར་གྱུར་པ་དེ་ནི་དགེ་སློང་རྒན་པོ་འདི་ཡིན་ཏེ་ལས་དེས་ལོ་དྲུག་ཅུའི་བར་དུ་མའི་ལྟོ་ན་འདུག་གོ།",
    "ཞེས་སྨྲས་ནས་ཅང་མི་ཟེར་བར་འདུག་གོ།",
    "གནས་གཞི་དང་ལྡན་པ་ཞིག་འདུག་པར་གྱུར་ཏོ།",
    "གང་ལའང་ལོག་པར་མི་འཇུག་འདུག་གོ།",
    "མེ་ཏོག་ཀུན་ད་ལྟར་འདུག་པ་དང་།",
    "ཚེ་འདི་ལ་མིག་ཡོན་པོར་འདུག་པ་ནི་སྔོན་ལོག་པའི་སེམས་ཀྱིས་གཞན་གྱི་ཆུང་མ་ལ་བལྟས་པ་ལས་འོངས་སོ།",
    "འདུག་ཀྱང་རུང་།",
    "འགྲོ་བ་དང་ནི་འདུག་པ་ན།",
    "བཟོ་དང་ཡི་གེའི་གཟུགས་སུ་འདུག།",
    "འཆག་དང་འདུག་དང་འགྲེང་དང་ཉལ་བ་དང་།",
    "ལང་རང་ས་ནས་། རྒྱ་གར་སྐད་དུ།",
    "མེད་ན་ཡུད་ཙམ་ཞིག་ཙོག་པུར་འདུག་ལ་ཁྲུས་རས་ཀྱིས་ཕྱི་བར་བྱའོ།",
    "མདུན་དུ་འདུག་སྟེ་མེ་མི་འདེའོ།་",
    "ཟུང་ང་དང་གོས་ཀྱི་གདང་མཐོན་༤པོ་ལ་འདུག་པའི་དངོས་པོ་དབབ་པ་ལ་སོགས་པས་སོ།",
    "གནས་པར་འོས་པ་ས་ཡོངས་སུ་ཚོལ་པ་ལ་ཞུགས་པ་ནི་མེད་ན་མི་གནས་པར་འདུག་པ་ལ་ཉེས་པ་མེད་དོ།",
    "འདུག་པ་དང་ཕྱི་རོལ་ཏུ་ཡང་སོ་སོར་བརྟག་༧པར་བྱའོ།",
    "འདུག་པར་མི་བྱའོ།",
    "ནི་མ་ཚོར་བ་དང་རང་བཞིན་རྒྱུས་ཉམས་པའི་གནས་སྐབས་དང་མི་འདོད་བཞིན་དུ་བཅུག་པ་ཉིད་ས་ནའོ།",
    "དུག་དང་ཕྱེ་མ་དང་དོང་དང་ཤིང་དང་རང་བཞིན་ཉམས་པ་གཏོང་བ་དང་བྲང་དུ་འདེབས་པ་དང་འཕྲུལ་འཁོར་དང་སྒྱུ་ཐབས་དང་རོ་ལངས་དང་རྗེས་སུ་སྦྱོར་བ་རྣམས་སོ།",
    "དབེན་པ་ན་འདུག་པ་དང་འགྲེང་བ་གཉིས་ཀྱིའོ།",
    "ས་རྒྱལ་བོ་དང་ལྷའི་གནས་དང་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་ལ་བསྟེན་པ་ཉིད་དང་།་",
    "སརྩིག་པས་བསྐོར་བའི་གྲོང་ལ་ནི་ཇི་ཙམ་དུ་བ་ལང་དྲུག་དང་ལྡན་ཐ་པའི་ཤིང་རྟ་སྨུག་མ་ཅན་གྱིའམ་བྱ་གག་སྤར་ནས་འདུག་པའི་ལམ་གྱིས་ཁྱབ་པའོ།",
    "ཁྱིམ་པ་འདུག་འདུག་པའི་སྟན་མ་བརྟུལ་བ་མཐོང་ན་བརྟུལ་བར་བྱ་བ་ཉིད་དོ།",
    "འདུག་སྟེའོ།",
    "འདུག་པ་ལའོ།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་དང་མི་འཐོབ་པའི་ཕྱོགས་དང་མདུན་མ་ཡིན་པ་ན་འདུག་པ་ལས་ལྷག་པོར་བྱ་བ་མི་འབྱུང་ངོ།",
    "འདུག་པའི་འགྲུབ་པ་དཉིད་སྐྱེ་བ་ལ་རག་ལས་པ་ནི་མ་ལོན་པ་ཉིད་མ་ཡིན་ནོ།",
    "སྣོད་ཕྱོགས་ན་འདུག་ན་དེས་ཀྱང་ས་དེར་བཙོས་པ་ཉིད་ཡིན་ནོ།",
    "འཚོད་པར་བྱེད་པ་དེ་ན་འདུག་པ་ཉིད་ཀྱིས་ནི་མི་འགྱུར་རོ།",
    "ན་བཙོས་པ་དེ་དག་དུས་ཀྱི་ཕྱིར་དགག་པ་མཛད་པར་འཚོ་བའི་བར་དུ་བ་བཅང་བ་དག་ནི་མ་བསྡུས་པ་ཉིད་ཡིན་ནོ།",
    "མི་འཐོབ་པ་ཐོབ་ན་དྲུང་ན་འདུག་པས་སོ་།",
    "དེ་ནི་ངོས་གཉིས་ནས་བཏགས་ན་ཡང་འདུག་ཏུ་བཏུབ་པོ།",
    "༣མ་ཕྱུང་སྟེ་བཞིན་བཟངས་མིག་ལམ་ན་མ་འདུག་ཅིག་ཅེས་བརྗོད་པར་ས་བྱའོ།",
    "ན་མི་འདུག་ན་དབྱུག་གུ་སྐམ་ཁས་དལ་བུས་རྫ་མའམ་བུམ་ས་པར་བཅུག་སྟེ་ཁ་བཅད་ནས་བུ་གུ་དག་བཏོད་དེ་བསལ་བར་བྱའོ།",
    "མངོན་སུམ་དུ་བརྣག་པས་འདུག་ནའོ།",
    "དེ་དག་མེད་པར་དེར་ཉིན་མཚན་གཉིས་ལས་ལྷག་པར་འདུག་ནའོ།",
    "འདུག་པའི་ཕྱིར་མལ་ཆ་དང་སྟན་ལ་ཡང་ངོ།",
    "དེ་བྱེད་པ་ལ་ཉེ་བར་བསྐོར་ཏེ་འདུག་པར་མི་བྱའོ།",
    "མལ་ས་མཁས་པ་ས་མ་ཡ་ས་སྟན་མཐོན་པོ་དང་མལ་སྟན་ཆེན་པོ་ལ་འདུག་པ་དང་ཉལ་བར་མི་བྱའོ།",
    "ཁྲི་རྩེག་མའི་སྟེང་དུ་འདུག་པར་མི་བྱའོ།",
    "དགེ་སློང་མ་ལས་ཟས་ལེན་པའི་སོ་སོར་བཤགས་པར་བྱ་བ་སྟེ་དང་བོའོ་དེའམ་དགེ་སློང་གཞན་ལ་འདི་ལ་བཅའ་བའམ་བཏུང་ལ་བའམ་སྲན་ཚོད་དམ་བཟའ་བའམ་ཡང་བྱིན་ཅིག་ཅེས་བྱ་བ་ལ་སཔསོགས་པས་བསྐོ་བཤམ་བྱེད་པ་ལ་ཞུགས་པའི་དགེ་སློང་མ་འདུག་པ་ནི་བྱེད་པ་བོ་ཡིན་ནོ་ན།",
    "ནམཚོ་ས་ཤམ་ཐབས་ཅི་ནས་ཀྱང་ཟླུམ་པོར་འདུག་པར་འགྱུར་བ་དེ།",
    "ཕུར་མ་ལྟར་འདུག་པ་མ་ཡིན་པར་རོ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་༡་མི་གཏོར་རོ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པ་དེར་ཁྱིམ་དུ་མི་གནས་ཡཁ་༧ཟླ་གསལ་༣",
    "མ་བསྐོས་པ་ལ་སོགས་པ་བཅུ་བདང་སྐྲོད་པ་དང་ཡང་ཡང་ཟ་བ་དང་ཟས་བསོད་པ་སློང་བ་དང་འདུག་པ་དང་འགྲེང་བ་དང་ཕྱིར་མ་བླངས་པ་སྤྱོད་པ་དང་མ་ལོན་པ་དང་དབྱར་གྱི་རས་ཆེན་ལས་གྱུར་པ་ནི་མ་གཏོགས་སོ།",
    "ཁྱིམ་གཞན་དུ་མ་བསྒོ་བར་སྟན་ལ་འདུག་པ་ལའོ།",
    "འདུག་པས་དེ་འགྲེང་བས་ཧ་ཅང་ཡུན་རིང་དུ་འདལ་ས་ལ་བབ་བར་བྱེད་ན་སྟན་ལ་འདུག་ཏུ་གཞུག་གོ།",
    "མི་བྱེད་ན་འདུག་པའི་ཕྱིར་ཞུས་ཏེ་དེ་ལ་འདུག་པར་བྱའོ།",
    "འདུག་པའི་ཆེད་དུ་སའི་སྟེགས་བུ་དག་དང་ཁྲིའུ་ཡང་ངོ།",
    "ནམ་མཁའ་ལ་འདུག་པར་མི་བྱའོ།",
    "ཤེས་པ་ཕྱིར་བཅོས་ཏེ་ཐམས་ཅད་དུ་འདུག་པར་བྱའོ།",
    "འབའ་ཞིག་ན་འདུག་སྟེའོ།",
    "འདུག་སྟེའོ།",
    "ཚེ་དང་ལྡན་པ་ཁོ་བོ་ཅག་ནི་ཚེ་དང་ལྡན་པས་ཅི་ནས་ཀྱང་གཞི་འཇོག་པར་བྱེད་ཅིང་གང་ཟག་འཇོག་ས་པར་མེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱི།",
    "༢ ཐ་དུ་མ་གཟེབ་ཀྱི་སྒྲོག་མར་ལྷན་ཅིག་བཞག་པ་ཐོགས་ཏེ་རྒན་རིམས་སུ་འདུག་པས་གདིང་བ་བསྒྲུབ་པར་བྱའོ།",
    "བླ་གབ་མེད་པར་འདུག་པར་མི་བྱའོ།",
    "དེའི་ཕྱིར་འདུན་པ་མ་ཕུལ་བ་ནི་༣༥འདུག་ཏུ་ཟིན་ཀྱང་གཉིད་ལོག་གམ་སྙོམས་པར་ཞུགས་ན་མ་ཐོས་ཀྱི་བར་དུ་བཏིང་བ་དང་ཕྱུང་བ་མི་འབྱུང་ངོ།",
    "གང་ན་བ་སསས་བྱིན་གྱིས་བརླབ་པར་བྱ་བ་འདུག་པ་དེའི་མཚམས་སུ་གཏོགས་པ་པ་རྣམས་བྱིན་གྱིས་རློབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "སས་ང་རང་ར་ས་དབྱིག་དང་གསེར་དང་གཞན་བྱས་པ་དང་མ་བྱས་པ་རྣམས་ནི་ཟ་ཀ",
    "མི་བཤེས་པ་དང་མི་དྲན་པ་དང་རང་བཞིན་དུ་གནས་པ་མ་ཡིན་པ་དག་ལ་ཡང་ངོ།",
    "དེ་ལ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་མ་དྲིས་པདེས་གྲོང་དང་ཁྱིམ་གཞན་དག་ཏུ་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཡང་དེ་བཞིན་ནོ།",
    "འཁོད་ན་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "ཁྱིམ་གཞན་དུ་གཞན་མེད་ན་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོ།",
    "ཤིང་ཀཱན་ཙ་ན་དང་ཀ་པི་ཏ་ལ་དང་ཨ་ཤཱཏྨ་དང་ཨུ་དུམ་ཝཱ་ར་དང་རྒྱ་གྲོ་དྷ་རྣམས་ཀྱིའོ།",
    "པ་རྩ་བམ་ལ་འདུག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་འདུག་པར་བྱའོ།",
    "ཏ་གཞན་གྱིས་མགྲོན་དུ་བོས་པ་ན་འདུག་པ་ལ་དེས་གནང་ན་གཞན་གྱིས་བྱིན་པ་ནི་དེའི་ཁོངས་སུ་གཏོགས་པ་དང་འདྲའོ།",
    "ཟན་གྱི་ཕྱིར་འདུག་པས་འདིའམ་སའདི་ནས་བྱིན་ཅིག་ཅེས་འདྲིམ་མཁན་ལ་བསྒོ་བར་མི་བྱའོཔ།",
    "དཀྱིལ་ས་ཆ་རྐང་རྟེན་གཉིས་ལ་མི་གོས་པར་ཁད་ཀྱིས་དུ་འདུག་པར་བྱའོབྱའོ།",
    "དེ་དང་འབྲེལ་བའི་དོན་ལས་གཞན་པས་དེའི་དྲུང་དུ་རྐང་བ་བཀྲུ་བ་དང་འཐོར་འཐུང་བྱ་བ་དག་འདུག་པར་མི་བྱའོ།",
    "ལྟོ་འཛག་པས་ནི་ཐ་མའི་མདུན་དག་ཏུ་ཕྱི་བ་ཙམ་བྱས་ཏེ་འདུག་པ་ལ་ཉེས་པ་མེད་དོ།་",
    "དེ་ལས་གཞན་པས་ནི་ཆུ་ཡོད་ན་འཐོར་འཐུང་མ་བྱས་པར་༤འདུག་པར་མི་བྱའོ།",
    "མི་འདུག་པར་འགྲེང་བ་ནི་ཁ་སྐོང་བ་ཉིད་མ་ཡིན་ནོ།",
    "ལྷག་པོར་ཡང་མདུན་དུ་ཙོག་བུར་འདུག་སྟེའོ།",
    "སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "རྒྱུསྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་པས་འདུག་པར་ཡང་ངོ།",
    "ལྷན་ཅིག་འགྲེང་བ་དང་འདུག་པ་དང་ལྷན་ཅིག་འཆགས་སར་འཚག་པ་དང་གཏམ་འདྲེ་བ་དང་ཕེབས་པར་སྨྲ་ནུབ་སབ་ཡང་ངོ།",
    "འདུག་པ་དང་ཉལ་བ་ན་འདུག་པའིའོ།",
    "ཐོས་པའི་ཉེན་ཀོར་མ་གཏོགས་པ་སྣང་བའི་ཉེན་ས་ཀོར་དུ་འདུག་སྟེ་ཁ་ཏོན་བྱའོ།",
    "ལོ་གསུམ་ལས་ལྷག་པས་བར་དུ་ཆོད་ས་པ་དང་ལྷན་ཅིག་སྟན་ལ་འདུག་པར་མི་བྱའོ་།",
    "བྱུག་༢ ས་རིས་མ་ཡིན་པར་འདུག་པར་མི་བྱའོ།",
    "མི་གཙང་བའི་སྐྱབས་དང་ཉེ་བར་འདུག་པར་མི་བྱའོ།",
    "དེས་དེའི་ཕྱི་སྒོར་ཚ་མཁས་བ་འདུག་པར་མི་བྱའོ།",
    "འདུག་ཀྱང་རུང་།",
    "གང་དུ་ཇི་སྲིད་འདུག་འདོད་པ་དེ་སྲིད་དུ་གནས་ཤིང་།",
    "གཞན་གྱིགས་ཉིད་དུ་ནི་བདག་འདུག་པར་བྱས་ནས།",
    "དེ་ལྟ་བསནརྣམ་པར་རྟོག་པ་ཐམསཅད་དང་བྲལ་བའི་ཕྱིར་གཞན་གྱི་ཀུནརྫོབ་ཀྱིས་དམིགསན་ཡང་རང་ཉིད་འདིར་དོན་དམ་པར་མྱ་ངན་ལས་འདས་པ་ཉིད་ཡིན་ནོ།",
    "སྒོམ་སྒྲུབ་སྦུངས་ཆུང་རང་སེམས་རྟིང་རྡོར་བཏགས།",
    "སྟོང་ཞིང་རང་གསལ་ཆད་པ་རང་སར་གྲོལ།",
    "བོན་སྒོ་དང་ཐེག་རྒྱུད་རང་རང་ཆེ་བའི་ས་ལ་གནས་པ་ལ།",
    "རང་རང་ལྟ་བ་ཤུགས་ཀྱི་རྟ་ལ་ཞོན།",
    "ཆགས་འཇིག་དུས་མཐའ་དོན་དམ་དམིགས་པ་མེད།",
    "རང་རང་བྱེ་བྲག་འཛབ་ལ་ཡང་།"
