    "ཁོ་གཉིས་ལ་མགོ་ནས་མཇུག་བར་ཞིབ་པར་ལྟ་དུས་ཕ་རྒན་གྱི་ཕྱུ་པ་ནི་ལྷན་པས་ཁེངས་ཤིང་རྐང་པའི་པུས་མོ་གཉིས་དོར་མའི་ཕྱི་ལ་ཕྱུང་།",
    "ལྷམ་མཐིལ་ཟད་ནས་རྐང་མཐིལ་ས་ལ་རེག་བུ་ཐ་ན་དོར་མའང་མེད་པར་རས་གོས་ཐུང་ཐུང་ཟད་ཧྲུལ་ཞིག་གོན།",
    "སྣ་ཁུང་གཉིས་ནས་སྣ་ལུད་བག་ཙམ་རེ་དབུགས་ཀྱི་གཏོང་འཐེན་དང་བསྟུན་ཏེ་ཁ་དང་སྣའི་བར་ཡར་རྒྱུག་མར་རྒྱུག་བྱེད་བཞིན་འདུག་བདོག་དངོས་ཀྱི་ཆ་ནས་མཚོན་ན་ཕ་རྒན་གྱི་ཨམ་ཕྲག་ཏུ་ཕོར་པ་གཅིག་དང་རྩམ་པ་ཕྲན་ཙམ་ཡོད་པའི་སྤགས་ཐང་གཅིག་བུའི་ཨམ་ཕ་རྒན་གྱི་ཕྱུ་པའི་གོང་བར་ལྕགས་ཁབ་གཉིས་དང་།",
    "ཁོང་གི་བསམ་པར་འདི་ནས་ལྷ་སར་ཕྱིན་ཏེ་ཇོ་བོའི་ཞལ་མཇལ་ཞུ་བར་ཞོགས་ལས་གཅིག་གི་དུས་ཚོད་ལས་མི་འགོར་ཡང་ང་ནི་ད་བར་མཆོད་མཇལ་ཐེངས་གཉིས་ལས་ཞུ་མ་མྱོང་།",
    "དེའི་དགོང་མོ་ཕ་བུ་གཉིས་ཁ་ངོམས།",
    "འོན་ཀྱང་ཕ་རྒན་ཕུན་ཚོགས་ནི་རང་གི་ཚེ་གཅིག་གི་འདུན་པ་སྟེ་ཇོ་བོ་ཤཱཀྱ་མུ་ནེའི་ཞལ་མཇལ་རྒྱུའི་ཉིན་མོ་དེ་ནི་ཁ་འགྲམ་དུ་བཅར་བའི་དགའ་ཚོར་གྱིས་གཉིད་ནི་ག་ལ་ཁུག་རིམ་བཞིན་རང་གི་བཟའ་ཟླའི་གདོང་ཡང་མིག་གི་མདུན་དུ་ཁྲ་ལྷེམ་ལྷེམ་དུ་འཁོར་ནས་འདི་སྙམ་དུ་བསམས་སོ།",
    "ལས་ཁག་པ་ཡོད་ན་རང་གིས་བྱེད།",
    "ཨ་ཕོ་ཕུན་ཚོགས།",
    "འཛོམས་པའི་མི་ཚེ་ཧྲིལ་པོར་རང་སྒེར་གྱི་འདོད་རེ་གང་ཡང་འདོན་མ་མྱོང་རུང་འཆི་ཁར་བུའི་འགྲམ་པར་བྱིལ་བྱིལ་བྱས་ནས་ཁ་ཆེམས་སུ་ང་གཉིས་ཀྱི་བུ་གཅིག་པོ་དཔལ་ལྡན་འདི་ཁྲིད་ནས་ལྷ་སའི་ཇོ་བོ་ཐེངས་གཅིག་མཇལ་བ་བྱེད་རོགས་ཟེར་བཞིན་དུ་རང་གི་སྤྱི་གཙུག་ནས་གཙུག་གཡུ་གཅིག་རང་ཡོད་པ་དེ་དཀྲོལ་ནས་ངའི་ལག་ཏུ་བླུགས་ཤིང་།",
    "མིག་ནས་མཆི་མ་རྡོག་ཁ་ཤས་ཤིག་བཏང་སྟེ་ཨ་ཕོ་ཕུན་ཚོགས།",
    "ད་ནི་སང་ཉིན་ཇོ་བོ་མཇལ་ཐུབ་ལ་རང་གི་བཟའ་ཟླ་འདས་པོ་འཛོམས་པའི་བསམ་འདུན་ཡང་འགྲུབ་ཐུབ་ངེས་རེད་བསམས་ཏེ་དགའ་ཚོར་ཆེན་པོ་སྐྱེས།",
    "གནས་མོ་ནི་ཡར་ལངས་ཟིན་ཅིང་མདང་ནུབ་ཀྱི་ཐུག་ལྷག་དེ་ཐབ་ལ་བཀབ།",
    "གནས་མོས་འཕྲལ་དུ་མེ་ཁོག་གཅིག་ཁྱེར་ནས་ཕུན་ཚོགས་ཀྱི་མདུན་དུ་རྩམ་གསུར་བདུགས་པ་དང་།",
    "ད་ལྟ་བྱ་སྐད་གཉིས་པ་རྒྱག་རྒྱུ་རེད།",
    "ཁྱོད་གཉིས་ཐོན་ན་ཉི་མ་ཤར་མཚམས་སུ་ཇོ་བོ་མཇལ་ཐུབ་ཅེས་ལབས་པས་ཨ་ཕ་ཕུན་ཚོགས་ཀྱིས་གནས་མོ་ཐུགས་རྗེ་ཆེ།",
    "ཤོན་ཁའི་གྲུ་ཁར་སླེབས་ནས་ཀོ་བའི་ནང་དུ་འཛུལ་སྐབས་ལྷ་སར་གང་མགྱོགས་འབྱོར་ན་སྙམ་པའི་དངངས་སྐྲག་གིས་རྐང་པ་འདེགས་ཤུགས་ཆེ་དྲགས་སྟབས་ལམ་བར་རྐང་པ་གཡས་པའི་ཉ་རིལ་ལ་འབྲོག་པའི་ཁྱིས་རྨུགས་པའི་རྨ་དེའི་རྨ་ཁ་བྱེ་སྟེ།",
    "གུ་ཐུང་རྡོལ་པའི་ཁུང་བུ་ནས་ཁྲག་རྣག་འཛགས་པ་བུ་དཔལ་ལྡན་གྱིས་ཟླ་བའི་འོད་ཀྱི་མདངས་ལ་མཐོང་བས་ཨ་ཕ།",
    "རྐང་པ་ནས་ཁྲག་དོན་གྱི་འདུག་ཟེར་བས་ཕས་དཔལ་ལྡན་ལ་ཁྱོད་སེམས་ཁྲལ་མ་བྱེད།",
    "འགྲམ་དུ་ཕྱིན་ནས་ལྟ་དུས་ལ་ལས་མ་ཎི་དང་ཁ་ཏོན་འདོན་བཞིན་མདུན་དུ་རས་ལྷེ་པ་གཅིག་བཏིངས་ནས་སྦྱིན་པའི་རེ་སྒུག་བྱེད།",
    "ལ་ལས་ལག་གཡས་པས་མ་ཎི་ལག་སྐོར་བསྐོར་ཞིང་གཡོན་མས་མཐེ་བོང་བསྟན་ཏེ་སློང་མོའི་རེ་འབོད་བྱེད་པ།",
    "གང་ལྟར་མིག་གིས་མ་ཟིན་པའི་སའི་བར་སློང་མཁན་གྱིས་ཁེངས།",
    "འགའ་རེ་མགོ་ལ་སྐལ་བསང་བསིལ་གཡབ་གོན།",
    "ཕལ་ཆེར་གླིང་སྐོར་གསུམ་རྒྱག་རྒྱུའི་སེམས་ཐག་བཅད་ཟིན་པ་ཡིན་འདུག་འགའ་རེས་ནི་མཇུག་ཏུ་ལུག་གཉིས་རེ་གསུམ་རེ་ཙམ་འཁྲིད་འགྲོ་བ།",
    "སྐྱེ་བོ་མང་པོ་ཞིག་གིས་ནི་ཆེད་མངགས་སྤྲང་པོར་སྦྱིན་པ་གཏོང་བར་ཡོང་ནས་གཅིག་རྗེས་གཉིས་མཐུད་ཀྱིས་རྐྱལ་པ་སོགས་སྣོད་འདྲ་མིན་གྱི་ནང་ནས་སྤྲང་པོ་མི་རེ་ངོ་རེར་དངུལ་ལམ་རྩམ་པ་སོགས་སྟེར་བཞིན་དུ་གླིང་སྐོར་སྐོར་བར་བྱེད།",
    "ཨ་ཕ་ཕུན་ཚོགས་དང་བུ་དཔལ་ལྡན་གཉིས་ཧ་ལས་ཧོན་ཐོར་གྱིས་ཡུད་ཙམ་ལྟད་མོར་མགོ་འཁོར།",
    "མཆོད་མཇལ་ཞུ་མིའི་གྲལ་སྟར་ནི་ཇོ་བོ་དབུ་སྐྲའི་འོག་བར་འདུག་གྲལ་སྟར་གྱི་མཇུག་མཐར་ཕ་བུ་གཉིས་ལངས་ནས་ཕྲེང་རྒྱུད་ལྟ་བུའི་རུ་སྒྲིག་གི་དལ་བུའི་གོམ་བགྲོད་དང་ལྷན་དུ་ཁོ་གཉིས་ཀྱང་ངང་གིས་མདུན་དུ་བསྐྱོད་དོ།",
    "དེ་ནས་གཙུག་ལག་ཁང་གི་ནང་དུ་སླེབས་ནས་ཕ་བུ་གཉིས་ཇོ་བོ་བཞུགས་ས་དང་ཇེ་ཉེར་སོང་བས་ཨ་ཕ་ཕུན་ཚོགས་ཀྱི་སྐད་གདངས་ཀྱང་ཇེ་ཆེར་སོང་སྟེ་ལ་སྦར་བཙིར་རྒྱག་ཙམ་རྒྱག་ཙམ་ཡང་ཡང་བྱེད་པ།",
    "མཚམས་རེ་དཔལ་ལྡན་གྱི་མ་ཎི་འདོན་པ་མ་ཟད།",
    "ཡང་སྐབས་རེ་བྲང་ཁོག་སྒང་གི་ཕྱུ་པའི་ལྷན་པ་ཞིག་མགོ་ལ་བྱིལ་བྱིལ་བྱེད་བཞིན་དུ་མིག་ནས་མཆི་མ་གཏོང་བ་སོགས་འཚབ་འཚུབ་ཀྱི་རྣམ་འགྱུར་འདྲ་མིན་སྟོན་པ་མཐོང་བས།",
    "ལྷ་ཁང་གང་འདྲ་ཞིག་གི་ནང་དུ་སླེབས་ཀྱང་ཨ་ཕ་ཕུན་ཚོགས་ཀྱིས་གཡས་གཡོན་གྱི་མི་ལ་འདི་ཇོ་བོ་རེད་དམ།",
    "འདི་ཇོ་བོ་རེད་དམ་ཞེས་འདྲི་བར་བྱེད།",
    "དེ་ལྟར་ལྷ་ཁང་ཁ་ཤས་ཞིག་བརྒྱུད་རྗེས་མཇལ་དམངས་ཀྱི་རུ་སྟར་དེ་རྡོ་བཀྱག་སྐས་གཅིག་འཛེགས་ཏེ་སྡིངས་ཆ་ཞིག་གི་ཐོག་ཏུ་སླེབས་པ་ན།",
    "གསེར་ཏིང་གི་ནང་དུ་ཡོན་ཆབ།",
    "ཨ་ཕ་ཕུན་ཚོགས་ཀྱིས་ཇོ་བོ་ཡིད་བཞིན་ནོར་བུ་ཡིན་པ་ཤེས་འཕྲལ་ལམ་སེང་བྲང་ཁོག་སྒང་གི་ཕྱུ་པའི་ལྷན་པ་ཞིག་ཡོད་པ་དེ་ཕྲལ།",
    "དེའི་ནང་ནས་གཡུ་དྲུག་དམར་འགྲན་ཟླ་བྲལ་བ་ཞིག་བཏོན་ཏེ་བུ་དཔལ་ལྡན་ལ་ལྟོས་དང་འདི་ནི་ཨ་མ་འཆི་ཁར་ང་གཉིས་ལ་བཞག་པའི་གཙུག་གཡུ་དེ་རེད།",
    "དེ་རིང་ང་གཉིས་ཀྱིས་གཡུ་འདི་ཇོ་བོར་ཕུལ་ཏེ་ཨ་མའི་བསམ་འདུན་འགྲུབ་པ་བྱེད་དགོས།",
    "གཙུག་གཡུ་འདི་ནི་བདག་གི་བཟའ་ཟླ་འཛོམས་པ་འདས་པོ་དེའི་ཁ་ཆེམས་སུ་བཞག་པའི་འབུལ་བ་ཡིན་པས།",
    "ཇོ་བོ་ཁྱེད་ཀྱི་ཐུགས་རྗེའི་ལྕགས་ཀྱུས་རྗེས་སུ་བཟུང་ནས་འཛོམས་པ་དེ་བདེ་བ་ཅན་གྱི་ཞིང་ཁམས་སུ་སྐྱེ་བར་ཤོག་ང་ནི་ཕ་ཡུལ་ནས་ཐོན་པའི་ཉིན་མོ་དེ་རང་ནས་ཕྱིར་ལོག་ཐུབ་རྒྱུའི་རེ་བ་དོར་ནས་ཡོང་བ་ཡིན།",
    "ངའི་སྒྱུ་ལུས་འདི་ཡང་ཁྱེད་ཀྱི་བཞུགས་གནས་ལྷ་ས་རང་དུ་འཇོག་རྒྱུའི་སེམས་ཐག་བཅད་དེ་ཁྱེད་མྱུར་དུ་མཇལ་རྒྱུའི་རེ་སྨོན་གྱིས་ལམ་བུར་འབད་པས་ཞུགས་པ་ལས།",
    "ང་ལ་རེ་བ་གཅིག་རང་ཞུ་རྒྱུ་ཡོད་པ་ནི་ང་ཤི་བའི་རྗེས་སུ།",
    "བྱེའུ་ཕྲུག་ཐང་ལ་ལུས་པ་བཞིན་དུ་མ་བོར་མཐུ་མེད་རེད་ན།",
    "ད་ནི་ནང་གི་ནོར་བུ་དང་ཕྱི་ཡི་ལྕགས་རི་གང་ཟེར་ཡང་བུ་འདི་རང་ལས་མེད་པས།",
    "བདག་གི་བཟའ་ཟླ་འདས་པོ་འཛོམས་པ་བདེ་བ་ཅན་གྱི་ཞིང་ཁམས་སུ་སྐྱེ་བར་ཤོག་ཟེར་བཞིན་ཨ་ཕ་ཕུན་ཚོགས་ཀྱིས་གཙུག་གཡུ་དེ་ཇོ་བོའི་སྐུ་པང་དུ་ཕུལ།",
    "མཇུག་ཏུ་ཇོ་བོའི་ཞལ་ལ་མིག་གཉིས་ཅེ་རེར་ལྟ་ཞིང་ཁ་ནས་ཤབ་ཤུབ་ཏུ་གོ་ལ་མ་གོའི་ངག་རྒྱུན་བར་མ་ཆད་པར་ཟློ་བཞིན་དུ་བསྡད།",
    "ཇོ་བོར་སྐོར་བ་ཞིག་བརྒྱབ་ནས་སྐུ་གཉེར་གྱིས་གནང་བའི་ཁྲུས་ཆབ་འཐུང་བཞིན་དུ་ཇོ་ཁང་གི་སྒོ་འགྲམ་དུ་ཐོན།",
    "དེ་ནས་ཇོ་བོའི་ཞལ་སྤྲོད་དུ་ལངས་ཏེ་སླར་ཡང་ཐལ་མོ་སྦྱར་ནས་ཁ་འདོན་བྱེད་པ་དང་།",
    "དཔལ་ལྡན་གྱིས་ཀྱང་པ་ཕའི་རྗེས་མཐུན་གྱིས་ཐལ་མོ་སྦྱར་ནས་མ་ཎི་འདྲེན་པར་བྱེད།",
    "ན་གི་འདུག་གམ།",
    "ག་རེ་བྱེད་ཀྱི་འདུག་གམ་ཞེས་ཨ་ཕའི་གཟུགས་པོ་སྤྲུག་སྤྲུག་བཏང་ནས་སྐད་ཆ་དྲིས།",
    "ཨ་ཕ་ཕུན་ཚོགས་ཀྱིས་དལ་བུར་མིག་གདངས་ཏེ་བུ་ལ་བལྟས་ནས་ལག་པ་གཡས་པས་དཔལ་ལྡན་གྱི་མགོ་ལ་བྱིལ་བྱིལ་བྱས་ཏེ་དཔལ་ལྡན་སེམས་ཁྲལ་མ་བྱེད།",
    "བྱམས་བརྩེའི་འོད་ཟེར་འཕྲོ་བའི་སྤྱན་གཉིས་བུ་དཔལ་ལྡན་ལ་གཟིགས་ནས་འཕྲལ་དུ་གསུང་བྱོན་མི་ཡོང་ངམ་སྙམ་པའི་སྣང་ཚུལ་འཆར་བས།",
    "དེས་ན་སྐུ་གཉེར་གྱིས་ཨ་ཕ་ཕུན་ཚོགས་ཀྱི་ཁ་ལ་ཆུ་དང་བྱིན་རྟེན་སོགས་བླུགས་ནས་སྐྱོབ་ཐབས་བྱས་ཀྱང་མ་གསོས་སྟབས།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་ཨ་ཕ་ཕུན་ཚོགས་མཆོད་འཇལ་ཞུ་སྐབས་ཇོ་བོའི་སྐུ་མདུན་དུ་འགྱེལ་བའི་གནས་ལུགས་རྣམས་གཅིག་ལ་གཅིག་བརྒྱུད་ཀྱིས་གཡས་གཡོན་དུ་གྱར་བས།",
    "སེམས་པ་བཟང་བའི་གྲོང་པའི་ཨ་མ་འགའ་ཞིག་གིས་ཕུན་ཚོགས་ལ་རྩམ་གསུར་བདུག་པ་དང་།",
    "ལ་ལས་ཇ་ཚ་པོ་སྟེར་བ་སོགས་བྱས་ནས་ཉིན་དགུང་ཙམ་ལ་སླེབས་དུས་གཞི་ནས་ཨ་ཕ་ཕུན་ཚོགས་དྲན་པ་གསོས་ཏེ་མིག་གདངས་ཐུབ་པ་བྱུང་།",
    "བུ་དཔལ་ལྡན་ནི་རང་གི་ཨ་ཕ་འཆི་བའི་ཉེན་ཁ་ལས་ཐར་བའི་དགའ་ཚོར་གྱིས་ཨ་ཕའི་སྐེ་ལ་འཐམས་པ་དང་།",
    "བདེ་སྐྱིད་ཕུན་སུམ་ཚོགས་པའི་མི་ཚེ་ཞིག་སྐྱེལ་རྒྱུ་ཡོང་གི་རེད་བསམས་ནས་དགའ་ཚོར་གྱིས་དབུགས་རིང་ཞིག་བཏང་སྟེ་བློ་བདེ་བག་ཕེབས་བྱུང་བ་དང་།",
    "ཡང་དཔལ་ལྡན་གྱི་སེམས་ལ་གཅིག་བྱས་ན་ད་ལྟ་ནས་ཨ་ཕའི་རྐང་པའི་རྨ་དེ་དྲག་མེད་དམ་བསམས་པའི་རེ་བས་ཕའི་གུ་ཐུང་ཡར་བརྫེས་ནས་ལྟ་དུས་རྨ་ཁ་ནས་ད་དུང་བར་མ་ཆད་པར་ཁྲག་དང་རྣག་འཛག་བཞིན་འདུག་ཚུལ་འདིར་བུ་དཔལ་ལྡན་བསམ་བརྗོད་ལས་འདས་ཏེ་ཨ་ཕ།",
    "ག་དུས་དྲག་གི་རེད་དམ་ཞེས་ལབས་མ་ཐག་ཏུ་ཨ་ཕ་ཕུན་ཚོགས་ཀྱི་སེམས་ལ་རྣམ་ཀུན་དཔལ་ལྡན་སྐད་ཆ་ཉུང་ཡང་།",
    "ངའི་བུ་ནོར་བུ་འདིས་ཕྱི་མ་ངན་སོང་དུ་ལྷུང་བའི་ཉེས་དམིགས་བསགས་ན་མི་ལེགས་བསམས་ནས།་",
    "ཇོ་བོའི་གཞལ་མཇལ་ཐུབ་པ་དང་གཙུག་གཡུ་འབུལ་ཐུབ་པ་དེས་ང་གཉིས་ཀྱི་བསམ་འདུན་ཏན་ཏན་འགྲུབ་ཐུབ་ཀྱི་རེད།",
    "དེ་ལ་དོགས་པ་བྱས་ན་ཉེས་དམིགས་བསམ་གྱིས་མི་ཁྱབ་གསོག་གི་རེད།",
    "བུ་དཔལ་ལྡན་ནི་རང་གི་སྐད་ཆས་ཨ་ཕར་སེམས་ཁྲལ་བཟོས་པ་མཐོང་བས་འགྱོད་པ་ཆེན་པོ་སྐྱེས་ཏེ་ཕའི་སེམས་པ་གསོ་ཕྱིར་ཨ་ཕ།",
    "ཨ་ཕ་རང་གིས་ག་རེ་གྱིས་ཟེར་ཡང་དེ་ལྟར་བྱེད་ཀྱི་ཡིན་ཞེས་ཨ་ཕའི་ལག་པ་ནས་བཟུང་སྟེ་ལབས་པས་ཨ་ཕ་ཕུན་ཚོགས་ཅུང་བློ་བདེ་བར་གྱུར།",
    "དེ་ནས་བཟུང་ཨ་ཕ་ཕུན་ཚོགས་ཀྱིས་དཔལ་ལྡན་ཁྲིད་དེ་ཞོགས་པ་གཙུག་ལག་ཁང་ལ་མཆོད་མཇལ་ཪེ་ཞུས་རྗེས་གླིང་སྐོར་ཐེངས་རེ་བསྐོར་བ་དང་།",
    "དགོང་དྲོ་བར་སྐོར་གསུམ་རེ་བསྐོར་བ་ཕུད།",
    "དེ་མིན་ཉིན་གང་ལྷ་སའི་སྲང་ལམ་གང་ས་གང་དུ་ཐེམ་རེ་སྒོ་རེ་བཞིན་ལྟོ་སློང་ནས་འགྲང་ཕྱེད་ལྟོགས་ཕྱེད་ཀྱིས་དུས་འདའ་བར་བྱས་སོ།",
    "ཉིན་ཞིག་ཕ་བུ་གཉིས་བར་སྐོར་ཤར་ངོས་ཀྱི་ཚོང་ཁང་ཞིག་གི་སྒོ་འགྲམ་དུ་མཐེ་བོང་གཉིས་ཀ་བསྟན་ནས་སྦྱིན་བདག་ཐུགས་རྗེ་ཆེན་པོ།",
    "ཚོང་ཁང་དེའི་ནང་དུ་གསེར་གྱི་ཨ་ལོང་ཆེན་པོ་ཞིག་བཏགས་ནས་ཁྲིའུ་ཤིང་སྟེང་དུ་འགྱིང་ངེར་བསྡད་དེ་སྨ་ར་བྱིལ་བྱིལ་བྱེད་ཅིང་ཕྱི་ངོས་ཀྱི་ཁྲོམ་ལམ་ཐོག་ཕར་འགྲོ་ཚུར་འགྲོའི་མི་རྣམས་ལ་ལྟད་མོ་ལྟ་བཞིན་ཡོད་པའི་ཚོང་དཔོན་རྒྱགས་པ་ལོ་བཞི་བཅུ་ཞེ་ལྔ་ཙམ་ལ་སླེབས་པ་ཞིག་ཡོད་པ་དེས།",
    "ཨ་ཕ་ཕུན་ཚོགས་ཀྱི་གདོང་ལ་ཞིབ་མོར་བལྟས་ནས་ཨ་ཕ།",
    "ཁྱོད་ཀྱི་མིང་ལ་ཕུན་ཚོགས་ཟེར་རམ་ཞེས་དྲིས།",
    "ཨ་ཕ་ཕུན་ཚོགས་ཀྱིས་ཡ་མཚན་སྐྱེ་བཞིན་དུ་ཚོང་དཔོན་གྱི་གདོང་ལ་ཡུད་ཙམ་ཞིག་བལྟས་ཏེ་སྦྱིན་བདག་དེ་རང་ཡིན།",
    "ཨ་ཕ་ཕུན་ཚོགས་རང་རེད།",
    "མགྲོན་པོ་གཉིས་ལ་ཇ་བླུགས་དང་ཞེས་འབོད་འཕྲལ་ཚུར་ཡོང་སྟེ་གདན་ཐོག་ཏུ་བསྡད་དེ་ཨ་ཕ་ཕུན་ཚོགས།",
    "ཆས་གོས་དྭངས་གཙང་ལྡན་པ་ཞིག་གིས་ལག་པ་གཡས་པར་ཁོག་ལྡིར་གཅིག་དང་།",
    "གཡོན་མར་དཀར་ཡོལ་གཉིས་ཁུར་ནས་བུ་མོ་ལོ་བཅོ་ལྔ་ཙམ་ལ་སོན་པ་ཞིག་དང་མཉམ་དུ་འཛུལ་ཡོང་།",
    "ཚོང་དཔོན་གྱིས་ཨ་ཅག་དེར་གསལ་སྒྲོན་ལགས་གཟིགས་དང་།",
    "འདི་ནི་ངས་ཁྱེད་ལ་ཤོད་མྱོང་བའི་ཨ་ཕ་ཕུན་ཚོགས་རེད།",
    "དེ་གར་ལམ་ཟུར་གྱི་བྲག་རྡོ་ཞིག་ལ་མགོ་བརྡབས་ནས་དྲན་མེད་དུ་བརྒྱལ་འདུག་མི་རིང་བར་ཨ་ཕ་ཕུན་ཚོགས་ཁྱི་ར་རྒྱག་པར་འགྲོ་བའི་ལམ་བར་ང་ས་ཐོག་ཏུ་འགྱེལ་ཡོད་པ་མཐོང་སྟེ་ཁྱི་ར་ལའང་མ་སོང་བར་ང་རྟ་ལ་བསྐྱོན་ཏེ་ཁྱིམ་དུ་འཁྲིད།",
    "དེ་ནས་ཟླ་བ་གཉིས་ཙམ་གྱི་རིང་ལ་ཨ་ཕ་ཕུན་ཚོགས་དང་།",
    "གལ་ཏེ་ཨ་ཕ་ཕུན་ཚོགས་མེད་ན་ང་ནི་མི་མེད་ཀྱི་འཕྲང་ལམ་དུ་ཤི་ཚར་བ་རེད།",
    "གསལ་སྒྲོན་ལགས་རང་དང་བུ་མོ་ཡེ་ཤེས་མཁའ་འགྲོར་ཡང་སྐྱིད་སྡུག་ཇི་ཡོང་སུས་ཤེས་ཟེར་ནས་དགྲ་ལྷ་རང་གིས་ཁོ་གཉིས་ལ་ཇ་བླུགས།",
    "དེ་ནས་ཨ་ཕ་ཕུན་ཚོགས་ཀྱིས་ཚོང་དཔོན་དགྲ་ལྷ་དང་།",
    "བུ་མོ་ཡེ་ཤེས་མཁའ་འགྲོ་བཅས་གསུམ་ལ་ལོ་བཅུ་གྲངས་རིང་གི་སྐྱིད་སྡུག་དང་།",
    "ཚོང་དཔོན་དགྲ་ལྷས་ཨ་ཕ་ཕུན་ཚོགས།",
    "དེ་ནས་གཟུགས་པོ་ཨའུ་ཙམ་བྱུང་ན་བསམ་ཡས་གཙུག་ལག་ཁང་དང་ལྷོ་གནས་ཁག་ལ་ལྟོ་སྐོར་གནས་སྐོར་ལ་འགྲོ་ཐུབ་པའི་རེ་བ་ཡོད་ཅེས་ལབས།",
    "ཁྱོད་ང་ལ་བཀའ་དྲིན་ཆེན་པོ་ཡིན།",
    "ཁྱོད་ཕ་བུ་གཉིས་དེར་སྡོད།",
    "ལྟོ་གོས་ཐོག་ལ་ངས་རོགས་རམ་གང་ཐུབ་བྱས་ཆོག་དེ་སྔ་ང་ཚོར་གཡོག་མོ་གཡུ་སྒྲོན་ཟེར་བ་ཞིག་ཡོད་ཀྱང་རྗེས་སུ་སྨྱོ་ནས་སྐད་ཆ་གང་བྱུང་མང་བྱུང་ཤོད་པ་དང་།",
    "བུ་དཔལ་ལྡན་གྱིས་ནང་གི་གད་ཕྱིས་བྱེད་པ་དང་ཆུ་ལེན་རོགས་བྱས་ན་འགྲིག་གི་རེད།",
    "ཁྱེད་རང་བུ་ཁྲིད་ནས་སྤྲང་འཁྱམས་རྒྱག་པ་ལས་ཞེ་དྲག་ཡག་གི་མ་རེད་དམ་ཞེས་གྲོས་དྲིས་པས།",
    "ཨ་ཕ་ཕུན་ཚོགས་ཀྱི་མིག་གཉིས་མཆི་ཞག་གིས་ཁེངས་ནས་ཚོང་དཔོན་དགྲ་ལྷ་ལགས།",
    "ཚོང་དཔོན་ཁྱོད་བྱ་བ་ལམ་འགྲོ་ཡོང་བ་དང་སྐུ་ཚེ་རིང་པོ་ཡོང་བ་ཤོག་ཅེས་སྨྲས།",
    "བུ་མོ་ཡེ་ཤེས་མཁའ་འགྲོ་ནི་ཨ་ཕ་ཕུན་ཚོགས་ཕ་བུ་གཉིས་ནང་ལ་ཉར་རྒྱུ་བྱས་པ་དེ་ལ་དགའ་ཐག་ཆོད་དེ་པཱ་ལགས།",
    "བུ་དཔལ་ལྡན་ཕྱིར་སྐད་བཏང་སྟེ་རས་གོས་ཟད་ཧྲུལ་དེ་ཕུད་བཅུག་ནས་རང་གི་ཕྱུ་པ་དེ་གཡོགས་ཏེ་སྐ་རགས་བཅིངས།",
    "སྣང་ཚུལ་དེ་མཐོང་འཕྲལ་བུ་མོར་མིག་ལོག་ཅིག་བལྟས་ཏེ་ག་རེ་བྱས་པའི་ཡག་པོ།",
    "པཱ་ལགས་ཀྱི་འཁྲིས་ལ་སྡོད་ཤོག་ཅེས་བུ་མོར་གཤེ་གཤེ་བཏང་བ་དང་།",
    "ཡེ་ཤེས་མཁའ་འགྲོ་པ་ཕའི་འགྲམ་དུ་སླེབས་མ་ཐག་ཨ་མ་ནི་རྡོག་སྒྲ་དང་བཅས་ཏེ་ལྷགས་ནས་ད་ཡིན་ན་པ་ཕ་དང་བུ་མོ་གཉིས་འདྲ་པོ་ཞིག་འདུག་པ་ཕས་སྤྲང་པོ་སྒོ་འགྲམ་ལ་ལྟོ་སློང་བར་ཡོང་མཁན་ནང་ལ་བསྐོངས་ནས་གསོལ་བ་ཞབས་ཏོག་བྱས།",
    "བུ་མོས་རང་གི་ཕྱུ་པའང་སྟེར།",
    "དེ་སྔ་ཁྱེད་རང་ལ་རོགས་བྱེད་མྱོང་ཡོད་ན་དངུལ་དང་རྩམ་པ་ཕྲན་ཙམ་སྤྲད་དེ་བཏང་ན་མ་འགྲིག་པ་ག་རེ་ཡོད་དམ་ཞེས་ངར་ངར་ཤོར་ཤོར་གྱིས་སྨྲས།",
    "བཀའ་མོལ་འདི་འདྲ་མ་གསུངས།",
    "ཕུན་ཚོགས་ཀྱིས་ངའི་སྲོག་བསྐྱབས་མྱོང་བ་རེད།",
    "མི་གཞན་དག་གིས་ཤེས་ན་ག་རེ་ཟེར་གྱི་རེད་དམ།",
    "ཁོ་གཉིས་ཀྱིས་ལྟོ་ཟ་བ་དེ་ཁོ་ན་མཐོང་བ་མ་གཏོགས་ལས་ཀ་བྱེད་ཐུབ་པ་དེ་མ་མཐོང་བ་ག་རེ་བྱས་པ་རེད་དམ།",
    "ཕ་རྒན་ཕུན་ཚོགས་ནི་སང་འགྲོ་གནངས་འགྲོའི་མི་རེད།",
    "ཉིན་ཤས་ནས་ཕུན་ཚོགས་ཤི་བའི་རྗེས་སུ་བུ་དཔལ་ལྡན་དེ་གཡོག་པོར་ཉར་ན་གླ་ཕོགས་སྤྲོད་མི་དགོས་པའི་གཡོག་པོ་ཞིག་ཡོང་གི་རེད་བསམས་ནས་ཚོང་དཔོན་ཁྱེད་ཀྱིས་གསུངས་པ་དེ་དངོས་གནས་རེད།",
    "ལས་འབྲས་དཔང་བཞག་གི་ལས་ཀ་བྱེད་དགོས་ཀྱི་རེད།",
    "སྐས་ཀའི་འོག་གི་འཕྱིང་གདན་རྡོལ་པ་དེ་ཁོ་གཉིས་ལ་སྐྱོལ་ཤོག་རང་གི་ལྷམ་རྙིང་པ་དེ་དཔལ་ལྡན་ལ་གཡོགས་ཤིག་ཅེས་བསྐུལ་བས།",
    "དེ་ནས་ལྷམ་དེ་དཔལ་ལྡན་ལ་གྱོན་དུ་བཅུག་པས་ཕ་བུ་གཉིས་སེམས་རབ་ཏུ་གཡོ་བས་བུ་དཔལ་ལྡན་གྱིས་ཡེ་ཤེས་མཁའ་འགྲོ་ལ་མིག་ཅེ་རེར་བལྟས་ནས་ཨ་ཅག་དྲིན་ཆེན་སྐུ་ཚེ་རིང་།",
    "སྒོ་རྭའི་ནང་གི་ཁྲོན་པ་ནས་ཆུ་ལེན་རྒྱུ།",
    "དེ་བཞིན་འཁྲུ་འཁྲུ་བཤལ་བཤལ་བཅས་ཕྱི་ནང་གི་ལས་ཀ་ཚང་མ་བྱེད་དགོས་པས་ཉིན་གང་བྲེལ་བ་འཚུབ་འཚུབ་ཀྱིས་ལས་ཀར་མགོ་འཁོར།",
    "ནང་ལ་མགྲོན་པོ་སུ་སླེབས་ཀྱང་དེ་ལ་ཨ་ཕ་ཕུན་ཚོགས་ཀྱིས་ཚོང་དཔོན་དགྲ་ལྷའི་སྲོག་བསྐྱབས་པ་དང་།",
    "ཨ་ཅག་གསལ་སྒྲོན་ལགས་ཁོ་རང་གིས་མགོ་འདོན་འཚོ་སྐྱོང་བྱེད་ཀྱི་ཡོད་པ་བཅས་ཀྱི་གནས་ཚུལ་ཆ་ཚང་རེ་བགྲངས་བ་མ་ཟད།",
    "ལྟོ་གོས་རང་གིས་བཙལ་ཡོད།",
    "ཟད་འབྲས་ལུས་ལ་ཐོན་སོང་།",
    "སེམས་ལ་སྡུག་བསྔལ་ཞུགས་སོང་།",
    "ཞེས་སྙན་འཇེབས་གདངས་ཀྱིས་དྲངས་བའི་སྐྱོ་གླུ་ཞིག་ལེན་བཞིན་དུ་ཨ་ཕ་ཕུན་ཚོགས་ཀྱི་སྡོད་ཁང་ཁ་སྤྲོད་ཀྱི་ཁང་ཆུང་ཞིག་ནས་བུ་མོ་ལོ་བཅོ་ལྔ་བཅུ་དྲུག་ཙམ་བྱས་པ་ཞིག་གིས་ཆུ་བན་ཁ་ཆག་ཅིག་སྒལ་པར་ཁུར་ནས་ཆུ་ལེན་པར་ཡོང་གི་ཡོད་པ་རེད།",
    "པིར་གྱིས་བྲིས་པ་ལྟ་བུའི་སྨིན་མ་འཁྱོག་པོའི་འོག་ཏུ་ཟིམ་པོར་གཡོ་བའི་རྫི་མས་བརྒྱན་པའི་མིག་གཉིས་ནི་ཆུ་མིག་བཞིན་དུ་དྭངས་ཤིང་གསལ་བ།",
    "བུ་མོས་འཛུམ་འཚེར་འཚེར་གྱིས་གཞས་འདི་ནི་ང་ཚོའི་ནང་ལ་མི་ཐོག་མང་པོའི་རིང་ལ་ཚང་མས་དགའ་པོ་བྱེད་པའི་ཤཞས་རེད།",
    "ང་ལ་ཨ་མ་གཤེགས་མཁན་དེས་བསླབས་བྱུང་།",
    "ཨ་ཅག་གསལ་སྒྲོན་ལགས་ཀྱིས་བུ་དཔལ་ལྡན་ཟེར་བ་ཞིག་ཡོད་གསུང་གི་འདུག་དེ་ཁྱེད་རང་ཡིན་ནམ་ཞེས་དྲིས་པའི་ལན་དུ་དཔལ་ལྡན་གྱིས་དེ་ག་རང་ཡིན།",
    "བུ་མོ་བདེ་སྐྱིད་ཀྱིས་ཆུ་བན་སྒལ་པར་ཁུར་རྗེས་དཔལ་ལྡན་ལ་འཛུམ་མདངས་ཤིག་བསྟན་ཏེ་ནང་ལ་ལོག་དཔལ་ལྡན་དང་བདེ་སྐྱིད་གཉིས་ཕན་ཚུན་ངོ་ཤེས་པ་ནས་བཟུང་མཚམས་རེ་དཔལ་ལྡན་གྱིས་བདེ་སྐྱིད་ལ་ཆུ་ལེན་རོགས་བྱེད་པ་དང་།",
    "མཚམས་རེ་བདེ་སྐྱིད་ཀྱིས་དཔལ་ལྡན་ལ་འཁྲུ་འཁྲུ་བཤལ་བཤལ་བྱེད་རོགས་བྱེད་པ་སོགས་གཅིག་ཕན་གཅིག་རོགས་བྱེད།",
    "ཡང་སྐབས་རེ་དགོང་དྲོ་ལས་ཀ་ཚང་མ་ཚར་རྗེས་སུ་སྒོ་རྭའི་ནང་ལ་མཉམ་དུ་རྩེད་མོ་བརྩེས་ནས་སྡོད་ཀྱི་ཡོད།",
    "ཉིན་ཞིག་ཚོང་དཔོན་དགྲ་ལྷའི་ནང་ལ་མའ་ཅང་རྒྱག་མཁན་སྐུ་དྲག་དང་ཚོང་པ་ཁ་ཤས་སླེབས་ནས་ནམ་ཕྱེད་ཙམ་མགོ་འཁོར་ནས་སྡོད་སྐབས་དཔལ་ལྡན་དང་བདེ་སྐྱིད།",
    "དེ་བཞིན་ཡེ་ཤེས་མཁའ་འགྲོ་གསུམ་སྒོ་རྭའི་ནང་ཕན་ཚུན་གཞས་ཤགས་རྒྱག་རེས་བྱས་ནས་བསྡད་ཡོད།",
    "སྐབས་དེར་བདེ་སྐྱིད་ཀྱིས་ལྷ་སའི་ཞབས་བྲོ་བརྒྱབ་ནས་དཔལ་ལྡན་དང་ཡེ་ཤེས་མཁའ་འགྲོ་གཉིས་ལྟད་མོ་ཆེན་པོ་བྱུང་བར་བརྟེན།",
    "དེ་མཚམས་སུ་ཨ་ཅག་གསལ་སྒྲོན་ལགས་ཁོ་ཚོའི་མདུན་དུ་ཡོང་ནས་ད་ཡིན་ན་ཏག་ཏག་རེད།",
    "ང་ཚོའི་བུ་མོར་གྲིབ་ཤོར་གྱི་རེད།",
    "དཔལ་ལྡན་དང་བདེ་སྐྱིད་གཉིས་ཕན་ཚུན་ལྟ་རེས་ཤིག་བྱས་ཏེ་གཉིས་ཀ་གདོང་པ་གློད་བཞིན་རང་རང་སོ་སོའི་ནང་ལ་ལོག་འགྲོ་སྐབས་གཉིས་ཀར་བསམ་བློ་འདི་འདྲ་ཞིག་འཁོར།",
    "ཡེ་ཤེས་མཁའ་འགྲོ་ང་ཚོ་དང་མཉམ་དུ་ཏོག་ཙམ་བསྡད་པར་ཡང་གྲིབ་ཤོར་གྱི་རེད་ཟེར་བ་ནི་ང་ཚོ་ཧ་ཅང་གི་བཙོག་པ་ཞིག་ཏུ་རྩི་བ་ནི་སྨོས་མི་དགོས་པ་རེད།",
    "དེའི་ཚེ་ཕ་རྒན་ཕུན་ཚོགས་ནི་གཟུགས་གཞི་ཇེ་ཞན་དུ་སོང་ནས་སྐབས་རེ་ཅུང་བདེ་བའི་མཚམས་སུ་གླིང་སྐོར་ལ་འགྲོ་བ་མ་གཏོགས་དུས་ཚོད་མང་ཆེ་བ་ནང་ལ་ཁ་འདོན་བྱས་ཏེ་སྡོད་པ་དང་།",
    "བུ་དཔལ་ལྡན་ནི་དགྲ་ལྷའི་ནང་གི་གཡོག་པོ་རྒྱུག་དགོས་པ་མ་ཟད།",
    "དགྲ་ལྷའི་གཟིམ་ཆུང་དང་པ་ཕའི་སྡོད་གནས་གཟན་ཁང་བར་ལ་ཐེངས་མང་ཡར་རྒྱུག་མར་རྒྱུག་བྱེད་དགོས་པའི་དཀའ་ངལ་ཆེ་བའི་ཚུལ་རྣམས་གྲོང་པའི་བུ་མོ་བདེ་སྐྱིད་དང་ཕ་བཀྲ་ཤིས་གཉིས་ཀྱིས་མཐོང་ནས་རྟག་ཏུ་བུ་དཔལ་ལྡན་ལ་ལས་ཀ་བྱེད་རོགས་བྱེད་ཅིང་།"
  ]
}