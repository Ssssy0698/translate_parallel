    "དཀར་ཆག་འགོད་པ་དང་དཔེ་མཛོད་ཁང་གསར་དུ་འཛུགས་སྐབས་ཐག་གཅོད་པར་དཀའ་ངལ་ཆེ་ཤོས་གྲས་ཤིག་ཡིན།",
    "དཔེ་སྐྲུན་བྱས་ནས་ཟུར་འདོན་བྱེད་ཐུབ་ན་ལེགས་པོ་ཡོད།",
    "བལྟ་ཀློག་བྱེད་རྒྱུ་དང་ཞིབ་བཤེར་རྩིས་ལེན་བྱ་དགོས་བྱུང་ན་དཀར་ཆག་རྒྱས་པར་ལྟ་དགོས་ཤིང་།",
    "བཅོ་བརྒྱད་པ་བཅས་ངེས་པར་དུ་འབྲི་བོད་ཀྱི་དཀར་ཆག་རིག་པ།",
    "གསུམ་པ་ཟུར་བཀོལ་བྱས་ཆོག་པའི་རིགས།",
    "རྒྱལ་བོ་དེའི་ཅིང་ཡིའུ་ཀིང་ཁྲི་ལོ་བཞི་བར་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བའི་གླེགས་བམ་བརྒྱ་དང་བཞི་བཅུ་ཞེ་བརྒྱད་གསར་དུ་བསྣན་པའི་དཀར་ཆག་ཅིང་ཡིའུ་ལུ་ཞེས་པ་ཞིག་བརྩམས།",
    "དོགས་པ་ཡོད་པའི་རིགས་དཔྱད་གཞིར་བཞག་སྟེ་གླེགས་བམ་བདུན་བརྒྱ་བཅུ་མེད་བཞིར་བྱས་པའི་དཀར་ཆག་ཏཱ་ཡོན་ཧཱུ་བོའུ་ཥན་ཐུང་ལུ་ཞེས་པ་ཞིག་བརྩམས།",
    "དེང་སང་ཟི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་ནས་ལྕགས་དཔར་དུ་བསྐྲུན་ཡོད།",
    "ཞིབ་འཇུག་མཛད་པོ་རྣམས་ལ་ཕན་ཐོགས་ཆེན་པོ་ཡོང་ངེས་ཡིན་ཀྱང་།",
    "འཇར་མན་ནུབ་མ་བཅས་ནས་པར་དུ་བསྐྲུན་ཡོད།",
    "དབྱི་ཏ་ལི་སོགས་སུ་ཉར་ཚགས་བྱས་ཡོད་ཅིང་།",
    "ཐེངས་འདིར་ཆེད་རྩོམ་དེའི་ཁ་སྐོང་ཞབས་འདེགས་ཀྱི་ཚུལ་དུ་བོད་ཡིག་དཔེ་རྙིང་པར་སྐྲུན་གྱི་དགེ་མཚན་དང་ཉམས་མྱོང་།",
    "པར་ཤིང་བེད་སྤྱོད་ཀྱི་དུས་ཡུན།",
    "དཔེ་རྙིང་པར་སྐྲུན་བྱེད་པའི་དགེ་མཚན་དང་ཉམས་མྱོང་།",
    "དེ་སྔོན་བོད་ལ་པར་སྐྲུན་ལག་རྩལ་མ་དར་གོང་སྟེ་༡༤༢༥ལོ་ཕན་ཆད་ནི་དཔེ་རྙིང་ཚང་མ་བྲིས་མ་ཡིན་པ་དང་།",
    "དེ་ཡང་གཅིག་ལ་གཅིག་བརྒྱུད་ཀྱིས་བཤུ་འབྲི་བྱས་རྗེས་ཞུས་དག་ནན་པོ་མ་བྱུང་བས་ཡིག་ནོར་མང་བ།",
    "པར་སྐྲུན་བྱས་ན་ཞུས་དག་རིམ་པ་བཞི་སྨར་ཞུས།",
    "མཁོ་འདོན་རྐྱང་པའི་རིགས་དེ་ལས་ལྡབ་གཅིག་ཙམ་མང་བ་པར་འདེབས་ཐུབ་ཀྱི་ཡོད།",
    "མ་དཔེ་གཅིག་ལས་མེད་པའི་རིགས་པར་སྐྲུན་མ་བྱས་ན་གཅིག་པུ་དེ་ཡང་སྲུང་སྐྱོབ་བྱེད་རྒྱུ་ཧ་ཅང་དཀའ།",
    "པར་ཐེངས་གཉིས་པའི་གྲས་ཀརྨ་པ་དང་།",
    "པར་སྐྲུན་དར་འགོ་ཚུགས་པའི་དུས་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "པར་སྐྲུན་གྱི་ལས་རིགས་རྣམ་གྲངས།",
    "པར་ཤིང་ཐོག་པར་རྐོའི་ལས་གྲྭ་ཚུགས་སྐབས་འགོ་བྱེད་པ་དང་བདག་གཉེར་མི་སྣར་ཕུད་པའི་ལས་རིགས་རྣམ་གྲངས་བཅུ་གཉིས་ཡོད་དེ།",
    "པར་རྐོ་བ།",
    "བརྟེན་དུས་སྐབས་དེའི་རིང་པར་རྐོ་བ་ཙམ་མ་ཟད།",
    "དཔར་ཡིག་འབྲི་སྐབས་མ་དཔེ་དང་པར་ཡིག་གཉིས་བར་ཡིག་འབྲུ་དང་།",
    "པར་ཡིག་བྲིས་ཟིན་པ་རྣམས་ཡང་བསྐྱར་མ་དཔེ་དང་ཞིབ་བསྡུར་ཐེངས་གཅིག་བྱ་དགོས་པ།",
    "པར་ཡིག་འབྲི་གཞིའི་ཤོག་བུ་ལེགས་གྲས་དང་།",
    "པར་ཤིང་ལས་སྣོན་བྱེད་རྒྱུ་དང་།",
    "པར་ཤིང་འཇོག་སའི་ཀུན་དགའ་ར་བ་བཟོ་རྒྱུ་བཅས་ཡིན།",
    "པར་ཡིག་གཞིར་བཟུང་ཤིང་པར་བརྐོ་རྒྱུ་དང་།",
    "པར་རྐོའི་ལག་ཆའི་གྲས་གསར་བཟོ་དང་ལས་སྣོན་བྱེད་རྒྱུ་སྟེ།",
    "རྒྱུག་ལེན་བཅས་བྱས་ཏེ་ཚད་གཞི་ལོན་པ་རྣམས་སོ་སོའི་ལས་གནས་ཀྱི་ལས་གྲྭར་འཇུག་རྒྱུའི་འགན་ཁུར་དགོས།",
    "པར་སྐྲུན་ལས་གྲྭ་འགོ་ཚུགས་པ་ནས་མཇུག་མ་སྒྲིལ་བར་དུ་གྲ་སྒྲིག་དང་།",
    "པར་ཡིག་འབྲི་བྱེད་ཤོག་བུ་དང་སྣག་ཚ་གསོག་འཇོག་ལས་སྣོན་བྱེད་རྒྱུ།",
    "པར་ཤིང་གསོག་འཇོག་དང་ལས་སྣོན་བྱེད་རྒྱུ།",
    "པར་ཤིང་འཇོག་ཁྲི་བཟོ་རྒྱུ།",
    "པར་རྐོ་བའི་ལག་ཆ་ཁག་གསར་བཟོ་བྱེད་རྒྱུ།",
    "སྨར་ཞུས་གྲུབ་རྗེས་ཞུས་མཆན་བཀོད་ནས་ཡང་ཞུས་པར་འབུལ་རྒྱུ་དགོས་ཤིང་།",
    "ཡང་ཞུས་གྲུབ་རྗེས་ཞུས་མཆན་བཀོད་ནས་བསྐྱར་ཞུས་པར་འབུལ་རྒྱུ་དང་།",
    "བསྐྱར་ཞུས་གྲུབ་རྗེས་ཞུས་མཆན་བཀོད་ནས་ཞུས་ཆེན་པར་འབུལ་དགོས་པ་དང་།",
    "ཞུས་ཆེན་པས་ཞུས་དག་གྲུབ་རྗེས་པར་ཐོའི་ནང་བཀོད་ནས་པར་ཤིང་དོ་དམ་པར་རྩིས་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "དེས་རྩིས་བླངས་རྗེས་དེ་སྔོན་གྲ་སྒྲིག་ཟིན་པའི་པར་ཤུབས་ནང་བཅུག་ནས་པར་ཤིང་འཇོག་སྒྲོམ་ཐོག་གོ་རིམ་ལྟར་བསྒྲིགས་ཏེ་པར་ཐོའི་ནང་བཀོད་པ་ལྟར་འཚོལ་བདེ་བའི་ཁ་བྱང་འགོད་དགོས་པ་བཅས་ཡིན།",
    "དེ་སྔོན་པར་ཤིང་ཐོག་པར་འདེབས་བྱས་པའི་སྡོམ་འབོར་དེ་ལོ་ཉིས་བརྒྱའི་ནང་གཞི་ནས་ངོ་གྲངས་ཁྲི་གསུམ་ལོན་ཐུབ་ཙམ་ཞིག་ཡིན་པ་ནས་དེང་སང་ལོ་གཅིག་ནང་ཁྲི་གསུམ་པར་འདེབས་བྱེད་དགོས་ཀྱང་བྱེད་ཐུབ་པར་གྱུར་ཡོད།",
    "ལྷག་པར་དུ་ཉེ་བའི་ལོ་ཤས་ནང་ཚན་རིག་ལག་རྩལ་བྱ་འཕུར་བ་ལྟར་འཕེལ་རྒྱས་འགྲོ་མགྱོགས་པས་གློག་རྡུལ་རྩིས་རྒྱག་འཕྲུལ་འཁོར་ལ་བརྟེན་ནས་མ་ཡིག་བཤུ་བ་དང་།",
    "པར་སྐྲུན་ལས་ཀའི་ལག་རྩལ་སྐོར།",
    "རྟོགས་ལྡན་འཇམ་དཔལ་རྒྱ་མཚོ་སོགས་ཀྱིས་བཀའ་གནང་བ་ལྟར་རྗེ་ཙོང་ཁ་པའི་གསུང་འབུམ་ཆ་ཚང་པར་སྐྲུན་བྱས་པ་དེའི་གྲས་དེ་སྔོན་རྩེ་པོ་ཏཱ་ལ་དང་།",
    "སྐུ་གཟུགས་ཀྱི་དཔུང་ཞེང་ཆེ་ལ་སྐུ་སྐེད་ཕྲ་བ་ཞལ་རས་ཀྱང་དེ་ཙམ་ལེགས་པོ་མེད་པ་ཞིག་ཡོད།",
    "དེང་སྐབས་པར་ཤིང་དེ་བཞུགས་མེད་ཀྱང་།",
    "པར་རྐོ་བའི་སྐབས་ཀྱི་ལག་རྩལ་ཉམས་མྱོང་ཧ་ཅང་མང་པོ་ཞིག་ཡོད་ཀྱང་།",
    "ལག་ཤེས་བཟོ་ལས་པའི་གླ་ཕོགས་ཀྱི་གནས་ཚུལ་བཅས་ཕན་ཚུན་ཟུང་འབྲེལ་བྱས་ནས་ཞིབ་འཇུག་མང་པོ་བྱ་རྒྱུ་ཡོད་པ་ཞིག་ཡིན་པས།",
    "འདིར་པར་སྐྲུན་གྱི་འབྲེལ་ཡོད་ལག་རྩལ་བཟོ་པའི་གླ་ཕོགས་དང་བྱ་དགའི་སྐོར་ཙམ་གླེང་རྒྱུ་ཡིན།",
    "མར་དང་ཇ་སོགས་ལྗིད་ཚད་ཀྱིས་འདེགས་དགོས་རིགས་རྣམས་སྲང་བརྒྱད་ཅུ་ཐམ་པར་ཁལ་གཅིག་ཏུ་རྩི་སྲོལ་ཡོད་པ་བཅས་ཞིབ་པར་བོད་གནའ་རབས་ཀྱི་འཇལ་བཤོར་འདེགས་གསུམ་གྱི་ཚད་གཞིའི་སྐོར་ཟུར་དུ་བཀོད་པ་ལས་གསལ་བས་འདིར་མ་སྨྲོས།",
    "སློབ་ཕྲུག་པར་ཡིག་འབྲི་མཁན།",
    "པར་རྐོ་བ།",
    "པར་སྐྲུན་སོགས་སྤྱི་སྒེར་གྱི་ལས་གྲྭ་ཆེ་གྲས་གང་ཡིན་ལ་ཐོག་མར་འགོ་འཛུགས་སྐབས་འཛུགས་སྟོན་དང་།",
    "སྤྱི་པར་རྒྱན་ཆའི་དོད་གསེར་སྲང་གསུམ།",
    "འབྲུ་ཁལ་ཉི་ཤུ་ཐམ་པར་ཇ་འཁོར་དྲུག་གཅིག་དེ་ལ་སྦག་ཆེན་བཞི་ཡོད།",
    "༡༣པར་བརྐོས་པ་བྱིངས།",
    "པར་ཞུས་པ།",
    "༡༢པར་ཡིག་པ།",
    "༢༢པར་བརྐོས་པ།",
    "༡༢༢པར་ཞུས་པ།",
    "མ་ལྡང་བ་རྣམས་ཕོ་ལྷ་བ་རང་ཉིད་སྒེར་གྱིས་ཁ་གསབ་བྱས་ཡོད།",
    "པར་ཡིག་འབྲི་གཞིའི་ཤོག་བུའི་ཐོན་ཁུངས་ནི།",
    "དེ་ལ་ཡངང་དུག་ཤོག་དང་ཤིང་ཤོག་རིགས་གཉིས་ཡོད་པའི་ནང་ནས་དུག་ཤོག་ལ་ཡི་གེ་བྲིས་ན་མིག་ལ་གནོད་པར་བརྟེན།",
    "པར་ཡིག་འབྲི་གཞིའི་ཤོག་བུ་ནི་དུག་ཤོག་མ་འདྲེས་པའི་ཤིང་ཤོག་གཙང་མ་སྲབ་མཐུག་སྙོམས་ལ་འཇམ་པོ་ཡོད་པ་ཞིག་དགོས་ཤིང་དེ་ལྟར་བྱུང་ན་པར་ཡིག་འབྲི་མཁན་གྱི་མིག་ལ་མི་གནོད་པ་དང་།",
    "པར་ཡིག་འབྲི་བྱེད་སྣག་ཚ་ནི།",
    "གཞན་ཡང་སྣག་ཚའི་རྒྱུ་དང་པར་ཤིང་གས་སྡོམ་ལ་དགོས་པའི་ཀོ་སྤྱིན།",
    "པར་ཤིང་འདུལ་སྦྱོང་སྐབས་པར་ཤིང་ལ་བྱུགས་རྒྱུའི་སྣུམ།",
    "པར་ཡིག་འབྲི་བྱེད་ཤོག་བུ།",
    "༦༡༡པར་རྐོའི་ལག་ཆ་བཟོ་བྱེད་ལྕགས།",
    "༤༨༩༩པར་ཤིང་སྟག་སྤང་སྤུས་ལེགས།",
    "པར་ཤིང་བཅས་རིན་སྤྲད་ནས་ཉོས་པ་དང་།",
    "པར་ཡིག་འབྲི་བྱེད་ཤོག་བུ།",
    "༡༡པར་རྐོའི་ལ་ཆ་བཟོ་བྱེད་ལྕགས།",
    "༡༤༥༣༩ ༨པར་ཤིང་སྟག་སྤང་སྤུས་ལེགས།",
    "༤༡པར་ཤུབས་བཟོ་བྱེད་སྣམ་བུ་དཀར་པོ།",
    "གོང་གསལ་པར་སྐྲུན་གྱི་རྒྱུ་ཆ་ཁག་ཕུད་པའི་ལས་བཟོའི་གླ་ཕོགས་དང་།",
    "དེང་སང་ལྷ་སར་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "ཞུ་དག་པ་རིམ་པ་གསུམ་དང་པར་ཞུས་པའི་གླ་༩༥༦ནས་ཁལབསྡོམས།",
    "པར་ཡིག་འབྲི་མིའི་གླ་བསྡོམས།",
    "༣༤༢༤༡པར་བརྐོས་པའི་གླ་བསྡོམས།",
    "པར་གཞི་གསར་སྐྲུན་བྱས་རྗེས་ཚོང་ལས་བྱེད་རྒྱུའི་བསམ་བློ་བཏང་ཚེ།",
    "པར་སྐྲུན་བྱེད་སྐབས་ཀྱི་མ་གནས་ལས་མཐོ་བའི་རིན་གོང་མ་བླངས་ན་ཁེ་བཟང་ཡོང་ཐབས་མེད་ཅིང་།",
    "པར་གཞི་གསར་སྐྲུན་གྱི་སྦྱིན་བདག་མང་ཆེ་བ་ནི་སྒེར་པ་འབྱོར་ལྡན་ཁག་ཡིན་པས།",
    "བརྔན་པ་སོགས་རང་ཉིད་དང་ཉེ་འབྲེལ་སྤུན་མཆེད་བུ་ཕྲུག་བཅས་ཀྱི་ལྟོ་གོས་སྡོད་གནས་སོགས་ཀྱི་ཆེད་དུ་བེད་སྤྱོད་བཏང་ན་ཉེས་དམིགས་ཤིན་ཏུ་ཆེ་བར་གསུངས་ཡོད་པར་བརྟེན།",
    "པར་འདེབས་ལས་བཟོ་ཚོའི་གླ་འབབ་ཇི་ཐོབ་པར་ཁང་དེའི་ལས་བྱེད་མཐོ་དམན་ཚང་མར་ཆ་སྙོམས་ཀྱིས་བགོ་བ་ལས།",
    "པར་པ་ལས་བཟོ་ཚོས་ལས་གྲྭ་ཚུགས་རིང་རྒྱགས་རང་འཁུར་བྱས་ཏེ་ཡོང་རྒྱུ་ཡིན་སྟབས་པར་གླ་ལེན་སྐབས་གླ་ལྟོ་ཆབས་སྒྲིལ་གྱིས་རྩིས་རྒྱག་སྤྲོད་ལེན་བྱེད་པ་དེ་ཚོ་ནི་པར་པ་ཚོའི་ཡོང་འབབ་ཡིན།",
    "པར་གྲངས་ཇི་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "པར་འདེབས་འགྲེམ་ཚོང་བྱས་པའི་རིན་འབབ་དེང་སང་སྒོར་བརྒྱད་སྟོང་ལྷག་ཙམ་ཟིན་གྱི་ཡོད་པ་དེ་རྣམས་ཀྱང་ལས་བཟོའི་གླ་ཕོགས་དང་།",
    "གཞན་ཡང་དེ་སྔ་ཤོག་ངོས་རྒྱབ་མདུན་གཉིས་ཀར་ཤོག་རོ་མེད་ཅིང་འཇམ་ཤ་དོད་པའི་པར་ཤོག་བེད་སྤྱོད་གཏོང་དགོས་པ་ལས།",
    "ཤོག་རོ་མང་པོ་འབྱར་བའི་བོད་ཤོག་དཀྱུས་མས་པར་འདེབས་བྱས་ན་པར་ཤིང་ཟད་གྲོན་ཆེ་སྟབས།",
    "པར་འདེབས་སྣག་ཚ་ནི་བོད་ནས་ཐོན་པའི་སྒྲོན་དྲེག་བཏུལ་མའི་སྣག་ཚ་དང་།",
    "པར་ཤིང་བེད་སྤྱོད་གཏོང་བའི་དུས་ཡུན་རིང་ཐུང་སྐོར།",
    "ངོ་གྲངས་ཉིས་ཁྲི་བདུན་སྟོང་བདུན་བརྒྱ་ལྔ་བཅུ་པར་འདེབས་བྱས་ཡོད་པ་མ་ཟད།",
    "ད་ཕན་ལོ་ངོ་བཅུའི་རིང་ལ་ཡང་མུ་མཐུད་པར་འདེབས་བྱས་ཡོད་པ་དང་།",
    "གོང་གསལ་གྱི་གནས་ཚུལ་དེའི་ཐོག་ནས་པར་ཤིང་ཐོག་པར་རྐོ་བྱེད་པའི་དཔེ་སྐྲུན་བྱ་གཞག་དེར་རྗེས་ལུས་ཀྱི་ཕྱོགས་དང་སྐྱོན་ཆ་མི་ཉུང་བ་ཞིག་ལྡན་པ་སྨོས་མེད་ཀྱང་དེ་ནི་ལས་དོན་དངོས་ཀྱི་ནང་ལེགས་བཅོས་གཏོང་ཐུབ་པ་ཞིག་ཡིན་པ་མ་ཟད།",
    "༤པར་འདེབས་བྱེད་པའི་ཁ་གྲངས་ཉུང་མཐར་ཁྲི་གསུམ་ལོན་ཐུབ་པ་བཅས་ཡིན།",
    "དཔེ་གཟུགས་ལ་དགའ་བ་རྣམས་ཀྱིས་དཔེ་གཟུགས་གང་འདོད་ལྟར་ཉོས་ཆོག་པས་པར་ཁང་ཕན་ཚུན་བར་དུ་གཞོགས་འདེགས་ཀྱི་མཉམ་ལས་ཡག་པོ་ཡོང་ཐུབ་པ་མ་ཟད།",
    "དཔེ་གཟུགས་དཔེ་སྐྲུན་གྱི་སྤུས་ཚད་ལེགས་པོ་གཉིས་ཕན་ཚུན་འགྲན་སྡུར་བྱས་པ་བརྒྱུད།",
    "མ་བོད་ཀྱི་རྡོ་རིང་ཡི་གེ་དང་དྲིལ་བུའི་ཁ་བྱང་གཅེས་བསྡུས་དཔེ་སྐྲུན་བྱས་པའི་གླེང་གཞི།",
    "རྒྱལ་པོ་ཁྲི་གཙུག་ལྡེ་བཙན་གྱི་སྲིད་རྡོ་རིང་ཡི་གེ་དང་དྲིལ་བུའི་ཁ་བྱང་གཅེས་བསྡུས་དཔེ་སྐྲུན་བྱས་པའི་གླེང་གཞི།",
    "༧བྱས་རྗེས་ཡོད་པའི་བློན་པོ་ལ་ས་ཞིང་དང་།",
    "བྲན་གཡོག་བཅས་མི་རབས་ནས་མི་རབས་བར་བརྒྱུད་འཛིན་བྱས་ཆོག་པའི་བྱ་དགའ་སྤྲོད་པ་དང་།",
    "རབས་ཆད་ན་མུ་མཐུད་ནས་གཉེན་འབྲེལ་གཞན་དག་ལ་གནང་བ།",
    "སྐབས་དེར་བཀའ་གཙིགས་བཅས་པར་མཉམ་དུ་ཡོད་པ།",
    "གཅེན་པོ་གཉིས་རྒྱུན་རིང་པོའི་བར་མ་མཐུན་པ་བྱུང་བ་བློན་པོ་མྱང་ཏིང་འཛིན་བཟང་པོས་ཞི་འཇགས་མཐུན་འགྲིགས་བྱས་པ།",
    "༤བློན་པོ་མྱང་ཏིང་འཛིན་བཟང་པོའི་མི་རབས་གོང་མ་རྣམས་ལ་བྱ་དགར་སྤྲད་པའི་ཞིང་འབྲོག་བྲན་གཡོག་རྣམས་མུ་མཐུད་བརྒྱུད་འཛིན་བྱས་ཆོག་པ་དང་།",
    "རྡོ་རིང་ཡི་གེ་དང་དྲིལ་བུའི་ཁ་བྱང་གཅེས་བསྡུས་དཔེ་སྐྲུན་བྱས་པའི་གླེང་གཞི།",
    "ཡང་རྡོ་རིང་ཡི་གེ་དང་དྲིལ་བུའི་ཁ་བྱང་གཅེས་བསྡུས་དཔེ་སྐྲུན་བྱས་པའི་གླེང་གཞི།",
    "སྤྱི་ལོ་༡༤༨ ༡ལོའི་བར་དགུང་ལོ་དགུ་བཅུར་བཞུགས།",
    "རབ་བྱུང་བདུན་པར་རྒྱ་གར་གྱི་པཎྚི་ཏ་ཆེན་པོ་ནགས་ཀྱི་རིན་ཆེན་བོད་དུ་ཕེབས་ཐེངས་དང་པོར་ལོ་ངོ་བཅུ་གཉིས་ཙམ་བཞུགས་སྐབས་འགོས་ལོ་དགུང་ལོ་ཞེ་གཉིས་པ།",
    "རྒྱ་གར་དང་བལ་ཡུལ་སོགས་སུ་ཕེབས་མ་མྱོང་ཡང་།",
    "སྤྱི་ལོ་༡༤༧༦ལོར་མགོ་བརྩམས་ཏེ་ས་ཁྱི་སྤྱི་ལོ་༡༤༧༨ལོའི་ལོ་མཇུག་ཏུ་མཇུག་རྫོགས་པར་མཛད།",
    "འགོས་ལོ་རང་ཉིད་ཀྱིས་བཅུག་པ་གནང་བའི་མཆན་བུ་ནི་གཏན་ནས་མིན་ཏེ།",
    "ཆུ་ཕོ་སྟག་ལོ་༨༨༢ལ་ལྷ་སའི་རྡོ་རིང་བཙུགས།",
    "ལོ་དེ་ཉིད་ནས་ལྕགས་བྱའི་༩༡བར་དར་མས་རྒྱལ་པོ་བྱས།",
    "ཐམས་ཅད་མཁྱེན་པ་བློ་བཟང་གྲགས་པའི་དཔལ་ཞེས་བྱ་བ་འཇིག་རྟེན་དུ་བྱུང་སྟེ།",
    "དེབ་ཐེར་འདི་རྩོམ་པར་མཛད་སྐབས་དགའ་ལྡན་ཁྲི་ཐོག་བདུན་པ་དྭགས་པོ་བློ་གྲོས་བརྟན་པ་དགའ་ལྡན་ཁྲི་ཐོག་ཏུ་བཞུགས་པའི་སྐབས་ཡིན་པར་གསལ་བར་གསུངས།",
    "གསུང་རྩོམ་གལ་ཆེན་མང་པོ་ཞིག་གནང་རྒྱུ་ཡོད་པདེས་གོ་སྐབས་འཕྲོག་ནས་དགུང་ལོ་མཐོན་པོ་མ་ཕེབས་བར་དུ་རྩོམ་འབྲི་གནང་མ་ཐུབ་པར་ལུས་ཤིང་།",
    "བོད་ཀྱི་རབ་བྱུང་བརྒྱད་པའི་ས་ཁྱི་སྤྱི་ལོ་༡༤༧༨ནས་རབ་བྱུང་དགུ་པའི་ཤིང་སྟག་སྤྱི་ལོ་༡༥༥༤ལོ་བར་དགུང་ལོ་བདུན་ཅུ་དོན་བདུན་བཞུགས།",
    "ཀུན་མཁྱེན་དོན་ཡོད་དཔལ་ལྡན་དང་།",
    "དགུང་ལོ་སོ་དྲུག་པར་གསང་བ་འདུས་པའི་བསྐྱེད་རྫོགས་ཀྱི་ཁྲིད་ཡིག་གཉིས་ཀྱང་བརྩམས།",
    "རབ་བྱུང་བཅུ་བཞི་པའི་དཀྱིལ་ཙམ་དུ་འཁྲུངས་པར་ངེས།",
    "དགའ་ལྡན་ཁྲི་ཐོག་ཏུ་ཕེབས་ཉེའི་མཚམས་སུ་དགོངས་པ་རྫོགས་སྟབས་དགུང་ལོ་དྲུག་ཅུ་ཡས་མས་ཤིག་འཚོ་བཞུགས་གནང་ཡོད་པ་ཚོད་དཔག་ཐུབ།",
    "པར་དུ་འཁོད་པ་དང་མ་འཁོད་པ་བསྡོམས་པའི་པོད་གཉིས་བརྩམ་ཡོད་ཅིང་།",
    "དེ་རྗེས་དུས་ཚོད་རིང་པོ་མ་ཕྱིན་པར་རིམ་པ་གོང་མས་བཀོད་སྒྲིགས་གནང་དོན་ལྟར།",
    "སྔ་རྗེས་སུ་ལེགས་བཅོས་ཐེངས་བཞི་བྱས་པ་ཡིན།",
    "ལྷ་འདྲེ་ཤི་ནས་མི་ལ་སྐྱེས་པའང་ཡོད་པས་སྐྱེ་བ་སྔ་ཕྱི་ཡོད་པར་ཁས་ལེན་གྱི་ཡོད།",
    "ལྷ་འདྲེ་ཡོད་པར་ཁས་ལེན་གྱི་ཡོད།",
    "གསོན་པོ་དང་གཤིན་པོའི་རྩིས་རྒྱབ་པ་སོགས་བྱེད་ཀྱི་ཡོད་པར་བརྟེན།",
    "དམག་དོན་བཅས་གང་ཅིའི་ཐད་ནས་སྐབས་དེའི་འཛམ་གླིང་ཐོག་སྙན་གྲགས་དང་སྟོབས་ཤུགས་ཆེ་བའི་གོ་གནས་བཟུང་ཡོད་པར་བརྟེན།",
    "ཉང་པོ་ཀུན་ངོ་ལོག་ཡབ་གནམ་རི་སློན་བཙན་ལ་དུག་བོར་ནས་བཀྲོངས་སོ་ཞེས་གཙང་དང་།",
    "རླབས་ཆེན་གྱི་གསར་བརྗེའི་སློབ་དཔོན་ཨེན་ཀེ་སིས་གསུངས་དོན།",
    "ལྷག་པར་དུ་གསལ་པོར་མཐོང་ཐུབ་པ་ཞིག་ལ།",
    "སུམ་པའི་ཡུལ་ཚང་མ་མངའ་འོག་ཏུ་བཅུག་སྟེ་དཔྱ་ཁྲལ་བསྡུས་པར་གསལ་ཞིང་།",
    "ཚུར་དམག་མ་བྱུང་ཞིང་ཕར་དམག་དྲངས་མ་དགོས་པར་རྒྱ་གྲུ་གུ་དང་འ་ཞ་ནས་དཔྱ་ཁྲལ་བསྡུས་པ་བཅས་གསལ་པ་ལ་ཞིབ་ཏུ་བརྟགས་སྐབས།",
    "སྐབས་དེའི་རྒྱལ་པོ་དེ་བྲན་གཡོག་བདག་པོ་མིན་པར་ཞིང་བདག་ཡིན་པར་མཚོན་པ་དང་།",
    "སྐབས་དེའི་རྒྱལ་པོ་དེ་དཔྱ་ཁྲལ་བསྡུ་མཁན་གྱི་ཞིང་བདག་ཡིན་མིན་ལ་ལྟ་དགོས་པར་མའོ་ཀྲུའུ་ཞི་དང་།",
