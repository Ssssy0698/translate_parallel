    "ཉིད་བཅས་ཆ་ཚང་བའི་སྒོ་ནས་ཤེས་རྟོགས་བྱས་པའི་རྨང་གཞིའི་ཐོག་རྒྱུན་འཛིན་དང་དར་སྤེལ་གཏོང་དགོས་པ་གང་དང་གང་ཡོད།",
    "གསར་གཏོད་བྱས་ཟིན་པ་དང་བྱ་དགོས་པ་གང་དང་གང་ཡོད་བཅས་གསལ་པོར་ཤེས་པ་བྱ་དགོས།",
    "ཁས་ལེན་ཤོར་ན་ཚ་ཕུལ་བ་ངོ་ཚ་ཟེར་བའི་དོན་ཡིན་སོགས་ཀྱི་བགྲོ་གླེང་གཏོང་ཐབས་གསར་གཏོད་གནང་ཞིང་།",
    "དབུས་གཙང་ཁམས་གསུམ།",
    "ཨང་རིམ་བསྒྲིགས་ཏེ་བྱ་དགའ་འབུལ་བའི་སྲོལ་གསར་གཏོད་གནང་ཡོད།",
    "སྐབས་དེར་པར་སྐྲུན་གནང་བའི་པར་ཡིག་མང་ཆེ་བའི་ཞུས་དག་པ་ཡང་ཁོང་གཉིས་ལ་གནང་དུ་བཅུག་པ་ཡིན་ཚུལ་རང་རྣམ་དུ་གསལ།",
    "དེ་ནས་རྒྱས་པའང་མཉན་བྱས་ཏེ།",
    "དབུས་གཙང་གདན་ས་ཆེན་པོ་བཞི་དང་།",
    "འདིར་ཕྱོགས་སྟོན་ཙམ་ལས་ཞིབ་ཕྲ་འགོད་པའི་ངལ་བ་མ་བྱས་སོ།",
    "དཔར་ཆས།",
    "པར་འདེབས་ཡོ་བྱད་ལ་མཚོན་ན་རང་འགུལ་ཅན་གྱི་པར་འདེབས་འཕྲུལ་འཁོར་དང་པར་སློག་འཕྲུལ་འཁོར་འདྲ་མིན་སྣ་ཚོགས་ཡོད་པ་དང་།",
    "ཡིག་འབྲིའི་ཡོ་བྱད་ལ་མཚོན་ན་ཡིག་འབྲུ་བསྒྲིགས་པའི་ལྕགས་པར་འཕྲུལ་འཁོར་དང་།",
    "ཀུན་གཞི་བཅས་ཟུར་འདོན་བྱས་པ།",
    "ཀུན་མཁྱེན་མཚོ་སྣ་བ།",
    "འགའ་ཞིག་ཕྱོགས་བསྡུས་ཀྱིས་འདེམ་སྒྲིག་བྱས་པ་ཞིག་སྟེ།",
    "དེ་ནི་གཞན་དོན་སྒྲུབ་རྒྱུར་རང་དོན་ལས་ལྷག་པར་དགའ་ཞེན་ཡོད་པ་ལ་ཟེར།",
    "བྱུལ་བྱས་པ་ལྟ་བུའི་བྱམས་བརྩེ་ལ་མི་ཟེར་བར་སྐྱོན་བརྗོད་དང་བསྟོད་བསྔགས་གང་ལ་གང་འོས་བྱས་ཏེ་དཀའ་ངལ་ཕྲད་སྐབས་དུས་ཐོག་ཏུ་སེལ་ཐུབ་པའི་ཕ་མ་བཟང་པོ་ལྟ་བུ་ཞིག་དགོས་པར་གསུངས།",
    "བསྟོད་བསྔགས་བཅས་གང་གནང་ཡང་དུས་ཐོག་ཏུ་གནང་བ་ལས་དུས་ལ་མ་བབས་པའམ།",
    "དུས་ལས་ཡོལ་ན་མི་གནང་བ་དེ་ལ་ཟེར།",
    "གོང་གསལ་བོད་ཀྱི་སྔོན་བྱོན་མཁས་པ་ཚོས་སློབ་དཔོན་ལ་ངེས་པར་དུ་ཚང་དགོས་པའི་ཡོན་ཏན་བཅུ་གཅིག་དང་།",
    "སློབ་སྦྱོང་རྨང་གཞིའི་རྩ་ཚིག་རྣམས་བློ་འཛིན་བྱས་ཡོད་པ།",
    "སྒྲོ་འདོགས་གཅོད་པའི་ཐད་དམིགས་སུ་བཀར་ནས་དམ་འཛིན་གནང་བ་ཡིན་ཅིང་།",
    "དེའི་ཚད་གཞི་ནི་དྲི་བ་བཏོན་པར་ལན་ཡོངས་རྫོགས་འདེབས་ཐུབ་ན་ཨང་དང་པོ།",
    "ཨང་གསུམ་པར་གཞན་དག་གོང་མཚུངས་ལ་དངུལ་སྲང་བཅོ་ལྔ།",
    "ཨང་བཞི་པར་ཁ་བཏགས་ནང་མཛོད་སྤུས་ལེགས་གཅིག་ལས་གཞན་མེད།",
    "ཨང་བདུན་པར་རྣམ་གྲངས་གོང་ལྟར་ལ་སྤུས་ཀ་ཞན་པ་དང་།",
    "དགོངས་ཞུ་མ་བྱས་པར་རང་མཚམས་ཀྱིས་གནས་གཞན་དུ་འགྲོ་བ།",
    "བདུད་རྩི་བུམ་པ་རྩ་འགྲེལ་དང་བཅས་པར་སློབ་སྦྱོང་ཐོན་པ་རྣམས་ཡིན།",
    "གྱོན་གོས་དང་མལ་ཆས་ཀྱང་ནམ་དུས་བཞི་ཀར་རྒྱུན་ལྡན་དེ་རང་མ་གཏོགས་བརྗེ་ལེན་མེད་པར་སྡོད་དགོས་པ་སོགས་འཚོ་བའི་ཆ་རྐྱེན་དཀའ་ངལ་ཧ་ཅང་ཆེ་བ་ཡོད།",
    "ཅེས་གསུངས་པ་དེ་བདེན་དོན་མི་འགྱུར་བ་ཞིག་ཡིན་པར་ར་འཕྲོད་གསལ་པོར་བྱུང་ཡོད།",
    "དེ་བྱིངས་རང་ཉིད་ཀྱིས་དང་བླངས་ཐོག་ཕྱི་རྒྱལ་དུ་ཕེབས་པ་ཤ་སྟག་ཡིན་ཅིང་།",
    "སློབ་ཁང་ནང་དུ་ངེས་པར་འཁྲིད་དགོས་པའི་སློབ་ཚན་དང་།",
    "གང་ལགས་ཟེར་ན།",
    "མིང་ཚིག་གཉིས་ཀྱི་རྩོམ་གཞི་ཡིན་པའི་སྐད་ཀྱི་སྒྲ་གདངས་དེ་མི་ཡི་རིགས་ཀྱི་བསམ་བློ་མཚོན་བྱེད་ཀྱི་བརྡ་རྟགས་ཡིན་པར་བརྟེན་དེ་ལ་ཡི་གེ་ཞེས་ཟེར་ཆོག་པ་དང་།",
    "༥མཚོན་བྱེད་ཀྱི་བརྡ་རྟགས་ཟེར་བའི་སྐད་ཆ་དང་བསམ་བློ་གཉིས་ནི་མཚོན་པར་བྱ་རྒྱུའི་དོན་ངོ་མ་དེ་ཡིན་པ་དང་།",
    "མཚོན་བྱེད་དཔེའི་གར་མཁན་གཉིས་བར་གྱི་འབྲེལ་བ་ལྟ་བུ་ཡིན་པར་ཁས་ལེན་བྱ་དགོས་ཤིང་།",
    "ཐོན་མིས་རྒྱ་གར་གྱི་ཡི་གེ་ལ་དཔེ་བྱས་ནས་བོད་ཡིག་བཟོས་པ་ཡིན་ཟེར་བའི་གོ་དོན་མིན།",
    "དེར་བརྟེན་ངས་བསམ་པར།",
    "ཁྱིམ་མཚེས་རྒྱལ་ཁབ་བར་མཛའ་གྲོགས་ཀྱི་འགྲོ་འོང་བྱས་པ་བརྒྱུད་སྔར་ཡོད་བོད་ཡིག་རྙིང་པ་དེ་ལས་ཆ་ཚང་ཞིང་བརྡ་སྤྲོད་རིགས་པའི་གཞུང་ལུགས་ཡོད་པའི་བོད་ཡིག་གསར་པ་ཞིག་དགོས་མཁོ་བྱུང་བར་བརྟེན།",
    "རྡ་སྤྲོད་རིག་པ་གཏན་ཁེལ་བྱས་པ་ཞིག་ཡིན་སྟབས་རྩ་བའི་ཡི་གེ་དབྱངས་བཞི་དང་།",
    "སྒྲ་གདངས་ཐོན་པར་བྱེད་པའི་རྐྱེན།",
    "དབུགས་ཀྱི་རྩོལ་བ་དྲག་ཞན་གྱི་ཁྱད་པར་བཅས་སྒྲ་སྦྱོར་རིག་པའི་གཞུང་ལུགས་ཆ་ཚང་བ་ཞིག་ཡོད་པ་ལས་འདིར་མཁས་པ་སྔོན་མའི་གསུང་རྩོམ་འགའ་ཞིག་བཀོད་ན།",
    "དེ་སྔོན་དུས་རབས་བཅུ་གསུམ་པའི་མགོར་འབྲི་གུང་དུ་སྐྱོབ་པ་འཇིག་རྟེན་མགོན་པོ་སྐུ་འཚོ་བཞུགས་སྐབས་དང་།",
    "བརྡ་སྤྲོད་རིག་པ་གཏན་ཁེལ་བྱས་པ་ཞིག་ཡིན་སྟབས་དུས་རབས་བདུན་པའི་དཀྱིལ་དུ་ད་ལྟའི་བོད་ཡིག་འདི་གསར་དུ་བཟོས་པ་ནས་ད་བར་ལོ་ཆིག་སྟོང་སུམ་བརྒྱ་ཉི་ཤུ་རྩ་བརྒྱད་ཙམ་ཕྱིན་ཡོད་རུང་།",
    "ལྷ་ས་པོ་ཏཱ་ལའི་མདུན་གྱི་རྡོ་རིང་ཕྱི་མ་དང་།",
    "༣བོད་རིགས་འདུས་སྡོད་ཀྱི་ས་གནས་སྤྱིའི་ཕལ་སྐད་གཞིར་བཟུང་ནས་ཡི་གེ་བཟོ་གནང་མཛད་པ་ཡིན་སྟབས་ཁྱབ་ཆེ་བ།",
    "༦ཡིག་པར་འཕྲུལ་འཁོར་དང་།",
    "བོད་ཡིག་ནི་ཡིག་པར་འཕྲུལ་འཁོར་ཐོག་སྤྱད་ན་ཨང་གྲངས་དང་མཚོན་རྟགས་ཕུད་ཨང་གྲངས་དང་མཚོན་རྟགས་ནི་མི་རིགས་ཚང་མའི་ཡི་གེར་དགོས།",
    "གཏན་ཁེལ་གྱི་ཚད་གཞི་ཡོད་པའི་ཐིག་རིས་གཉིས་ཟུང་འབྲེལ་ཡག་པོ་བྱས་པས།",
    "སྐབས་དེར་བཅོས་བསྒྱུར་དེ་ལྟར་བྱས་ཀྱང་ལག་ལེན་དངོས་ཀྱི་ཐོག་བཀས་བཅད་ཐེངས་གཉིས་པ་ལྟར་གནས་པ་མང་ཞེས་གསལ།",
    "༡༩གོང་གསལ་གྱི་བཅོས་བསྒྱུར་ཐེངས་གསུམ་པོ་དེ་ནི་སྔར་ཡོད་སུམ་རྟགས་ཀྱི་རིགས་པའི་གཞུང་ལུགས་རྒྱུན་འཛིན་བྱས་ཐོག་ཡི་གེའི་དག་ཆའི་ཐད་སྐབས་དེའི་ཕལ་སྐད་དང་བསྟུན་ནས་བཅོས་བསྒྱུར་བྱས་པ་ཞིག་ཡིན་པ་ལས་རྩ་བའི་བརྡ་སྤྲོད་རིག་པ་ཡིན་པའི་སུམ་རྟགས་ཀྱི་གཞུང་རྩ་གཏོར་བཏང་ནས།",
    "རླབས་ཆེན་སློབ་དཔོན་མར་ཁེ་སིས་ས་ཕྱོགས་དང་གོམས་སྐད་ཞེས་པའི་གསུང་རྩོམ་ནང་མི་རིགས་ཀྱི་སྐད་རྣམས་གཅིག་གྱུར་ཆགས་པའི་འགྲོ་ལམ་སྐོར་གསུང་སྐབས་གསུངས་དོན།",
    "ད་དུང་གཙང་པའི་སྐད་དང་།",
    "ཡི་གེའི་དག་ཆ་དེ་ལྷ་སའི་ཁ་སྐད་རྐྱང་པའི་ཐོག་ལ་བསྒྱུར་རྒྱུའི་ཨུ་ཚུགས་བྱས་པ་ཡིན་ན།",
