    "དེ་ནི་ལེན་པའི་རྣམ་པར་ཤེས་པ་ཞེས་ཀྱང་བྱ་སྟེ།",
    "བདག་ཏུ་རྟོག་པར་གྱུར་ན་མི་རུང་ཞེས།",
    "ཞེས་ཇི་སྐད་གསུངས་པ་ལྟ་བུའོ།",
    "ཅིའི་ཕྱིར་ལེན་པའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་ཞེ་ན།",
    "དེ་ལྟ་བས་ན་༨དེ་ལེན་པའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱའོ།",
    "ཡིད་དང་རྣམ་པར་ཤེས་པ་ཞེས་ཇི་སྐད་གསུངས་པ་ལྟ་བུའོ།",
    "རྣམ་པར་ཤེས་པ་འགགས་མ་ཐག་པའི་ཡིད་ཅེས་བྱ་བ་རྣམ་པར་ཤེས་པ་སྐྱེ་བའི་གནས་དང་ཀྱེ།",
    "མ་རིག་པ་དང་རྟག་ཏུ་མཚུངས་པར་ལྡན་པ་སྟེ།",
    "རྣམ་པར་ཤེས་པ་ནི་གང་གནས་གཅིག་པོས་ནི་བསྐྱེད་ལ།",
    "ཡུལ་ལ་རྣམ་པར་རིག་པའི་ཕྱིར་རྣམ་པར་ཤེས་པའོ།",
    "འགོག་པའི་སྟོམས་པར་འཇུག་པ་བྱེ་བྲག་མེད་པའི་སྐྱོན་དུ་ཡང་འགྱུར་ཏེ།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ནི་མ་ཡིན་ཏེ།",
    "སྟོམས་པར་འཇུག་པའི་བྱེ་བྲག་དང་།",
    "ངར་འཛིན་པ་དང་ལྡན་པར་ནི།",
    "ཀུན་ན་ཡོད་པར་མི་འགྱུར་རོ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་མ་གཏོགས་པར་སེམས་ཀྱི་ལུས་གསུམ་པ་མི་དམིགས་ཏེ།",
    "དེ་ལྟ་བས་ན་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ནི་༧སེམས་ཉིད་ཡིན་པར་གྲུབ་བོ།",
    "ས་བོན་ཐམས་ཅད་པ་དེ་ལས་ཡིད་དང་རྣམ་པར་ཤེས་པ་འབྱུང་ངོ།",
    "ཅིའི་ཕྱིར་ཉན་ཐོས་ཀྱི་ཇེག་པར་སེམས་དེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རམ།",
    "ཉན་ཐོས་རྣམས་ནི་ཤེས་བྱ་ཐམས་ཅད་ལྷག་པར་ཐུཤེས་པ་ལ་གཏོགས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་དེ་དག་ནི་དེ་བསྟན་པ་མེད་པར་ཡང་ཤེས་པར་རབ་ཏུ་གྲུབ་པས་རྣམ་ང་།",
    "དེ་ཤེས་པ་མེད་པར་ནི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཐོབ་པར་སླ་བ་མ་ཡིན་ནོ།",
    "ཡང་རྣམ་གྲངས་ཀྱིས་ཀུན་གཞི་རྣམ་པར་ཤེས་ང་།་",
    "རྣམ་གྲངས་འདིས་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉན་ཐོས་ཀྱི་ཐེག་ང་།",
    "བདུན་པ་འཇུག་པར་བྱེད་པ་ཡིན།",
    "དེའི་ཕྱིར་གང་ཤེས་བྱའི་གནས་ལ་ལེན་པའི་རྣམ་པར་ཤེས་པ་ཉིད་དང་།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉིད་དང་།",
    "སྲིད་པའི་ཡན་ལག་ཏུ་བསྟན་པ་དེ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་སྟེ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་ལམ་ཆེན་པོ་བཏོད་སྙེཔ་ཁོ་ན་ཡིན་ནོ།",
    "ཁ་ཅིག་འདི་སྙམ་དུ་སེམས་དང་༤ཡིད་དང་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ནི་དོན་གཅིག་ཁོ་ན་སྟེ།",
    "ཡིད་དང་རྣམ་པར་ཤེས་པ་གཉིས་དོན་ཐ་དད་པར་དམིགས་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་སེམས་ཀྱང་དོན་ཐ་དད་པར་འགྱུར་རོ་། ཡང་ཁ་ཅིག་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་སྐྱེ་དགུ་ཀུན་གཞི་ལ་ཀུན་ཏུ་དགའ་བ་ཞེས་རྒྱ་ཆེར་གང་གསུངས་པ་དེ་ལ་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་དེ་༥དག་ནི་ཀུན་གཞི་ཞེས་བྱའོ་སྙམ་དུ་སེམས་སོ།",
    "དེ་དག་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་རྨོངས་ནས་ལུང་དང་རྟོགས་པས་དེ་སྙམ་དུ་སེམས་སོ།",
    "དེ་ལ་མ་རྨོངས་པ་རྣམས་ཀྱིས་ཀུན་གཞི་རྣམ་པར་གཞག་པ་དེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཡིན་པར་ཡོངས་སུ་བཟུང་ཤེནས་རྣམ་པར་འཇོག་པ་ནི་ཆེས་བཟང་ངོ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་བདག་ཏུ་ཆགས་པས་བཅིངས་པ་རྣམས་དེ་རྣམ་པར་ཞིག་པར་འདོད་ང་།",
    "བསམ་གཏན་བཞི་པ་ཡན་ཆད་གོང་མར་སྐྱེས་པ་རྣམས་འདོད་ཆགས་དང་བཅས་པའི་བདེ་བ་དང་མི་མཐུན་དུ་ཟིན་ཀྱང་ཀུན་གཞི་རྣམ་པར་ཤེས་ང་།་",
    "དེ་ལྟ་བས་ན་ཀུན་གཞི་རྣམ་པར་ཤེས་ང་།་",
    "དེ་ནས་འདིའི་མཚན་ཉིད་རྣམ་པར་གཞག་པ་ཇི་ལྟར་བལྟ་༡ཞེ་ན།",
    "རྒྱུ་ཉིད་དུ་རྣམ་པར་གཞག་པ་དང་།",
    "འབྲས་བུ་ཉིད་དུ་རྣམ་པར་གཞག་པའོ།",
    "དེ་ལ་འབྲས་བུ་ཉིད་དུ་རྣམ་པར་གཞག་པ་ཉིད་ནི།",
    "བག་ཆགས་ཞེས་བརྗོད་པ་འདིའི་བརྗོད་པར་བྱ་བ་ནི་ཅི་ཞེ་ན།",
    "བག་ཆགས་དེས་ཡོངས་སུ་ཟིན་པར་༡ཚོས་འཛིན་པ་ཞེས་བྱ་བ་ལྟར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ཡང་ཚུལ་དེ་བཞིན་དུ་བལྟ་བར་བྱའོ།",
    "འོན་ཏེ་ཐ་དད་པ་མ་ཡིན་པར་གནས་ཤེ་ན།",
    "ར་ཅན་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དེ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་།",
    "སྡུག་པ་དང་མི་སྡུག་པ་རྣམ་པར་འབྱེད་པ་ཅན་ནོ།",
    "ངོ་བོ་ཉིད་སྣ་ཚོགས་རྣམ་པར་འབྱེད་ཟིཔའི་རྐྱེན་ཀྱི་དངོས་པོར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བདེ་འགྲོ་དང་ངན་འགྲོ་དག་ཏུ་སྙུག་པ་དང་མི་སྡུག་པའི་ལུས་རྣམ་པར་དབྱེ་བ་སྣ་ཚོགས་ཀྱི་རྐྱེན་གྱི་དངོས་པོར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཁ་ཅིག་ནི་སྔོན་བྱས་པ་ཉིད་ཀྱི་༧རྒྱུ་ལས་བྱུང་བ་ཉིད་དུ་རྟོག།",
    "གླང་པོ་ཆེ་ལྟ་བུའི་ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་ངོ་བོ་ཉིད་དང་།",
    "ཁ་ཅིག་ནི་སྔོན་བྱས་པའི་རྒྱུ་ལས་བྱུང་བར་སེམས།",
    "ཁ་ཅིག་ནི་བདག་ཡོད་པར་སེམས།",
    "བྱས་དང་མ་བྱས་འཇིགས་༥དང་ཕྲད་། ཉེས་པར་འགྱུར་བས་འགལ་ཕྱིར་རོ།",
    "ཡང་འཇུག་པའི་རྣམ་པར་ཤེས་པ་གཞན་གང་ཡིན་པ་དེ་ནི་ལུས་དང་འགྲོ་བ་ཐམས་ཅད་དུ་ཉེ་བར་སྤྱོད་པ་ཅན་དུ་བལྟ་སྟེ།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་ཚིགས་སུ་བཅད་པ་ལས།",
    "ཞེས་ཇི་སྐད་གསུངས་པ་ལྟ་བུའོ།",
    "ཞེས་ཚིགས་སུ་བཅད་པ་གསུངས་སོ།",
    "འདི་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་རྣམ་གྲངས་དང་མཚན་ཉིད་ཀྱིས་རྣམ་པར་གཞག་པའོ།",
    "དེ་བཞིན་དུ་མཚན་ཉིད་ཀྱང་བསྟན་པ་ལྟར་འཇུག་པའི་རྣམ་པར་ཤེས་པ་ནི་མ་ཡིན་པར་དེ་ཅིས་བྷུ་མངོན་ཞེ་ན།",
    "དེ་ལྟར་རྣམ་པར་གཞག་པའི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་མེད་པར།",
    "འཇིག་རྟེན་ལས་འདས་པའི་རྣམ་པར་བྱང་བ་ཡང་མི་རུང་ངོ།",
    "རྣམ་པར་ཤེས་པ་གཞན་དག་ལ་ཡང་མ་ཡིན་ཏེ།",
    "རྣམ་པར་ཤེས་པ་རྣམས་ཀྱི་གནས་ཐ་དད་པའི་ཕྱིར་དང་།",
    "རྣམ་པར་ཤེས་པ་དེ་ལ་རྣམ་པར་ཤེས་པས་བསྒོས་པར་ཡང་མི་རུང་སྟེ་༦།",
    "བས་ཆགས་དེ་གནས་དང་བཅས་པར་འདས་པས་མེད་པའི་ཕྱིར་རོ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་མེད་ན།",
    "འདུ་བྱེད་ཀྱི་རྐྱེན་གྱིས་རྣམ་པར་ཤེས་པ་མི་རུང་བའི་ཕྱིར་རོ།",
    "མཉམ་པར་མ་བཞག་པའི་ས་ནས་ཤི་འཕོས་པའི་ཡིད་བར་མ་དོའི་སྲིད་པ་ན་གནས་པའི་ཚེ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་ང་།་",
    "རྣམ་པར་ཤེས་པ་ཡང་མའི་མངལ་དུ་ནུར་ནུར་པོ་ཉིད་དུ་བརྒྱལ་ལོ།",
    "གལ་ཏེ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དེ་ཉིད་བརྒྱལ་ན་ནི་བརྒྱལ་བ་དེ་ལ་ཧཱུཾབརྟེན་ནས་ཡིད་ཀྱི་བྱེརྣམ་པར་ཤེས་པ་མའི་མངལ་དུ་འཇུག་པར་འགྱུར་ཏེ།",
    "དེས་ན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་ང་།་",
    "གཉིས་ལྷན་ཅིག་ཏུ་མའི་མངལ་དུ་འཇུག་པར་འགྱུར་རོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་བརྒྱལ་བ་དེ་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཉིད་དུ་མི་རིགས་ཏེ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་དམིགས་པ་ལ་མི་དམིགས་པའི་ཕྱིར་རོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དེ་བརྒྱལ་བ་ཡིན་དུ་ཆུག་ན་ཡང་ཅི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་བརྒྱལ་བ་དེ་ས་བོན་ཐམས་ཅད་པ་ཡིན་ནམ།",
    "དེས་ན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱི་རྣམ་གྲངས་ཀྱི་མིང་དུ་གཞག་རྔོ་པ་ཡིན་ནོ་༡།",
    "དེས་ན་གང་གནས་ཀྱི་དངོས་པོས་རྒྱུར་གྱུར་པའི་རྣམ་པར་ཤེས་པ་དེ་ཡང་ས་བོན་ཐམས་ཅད་པ་མ་ཡིན་ན།",
    "དེའི་ཕྱིར་རྣམ་པར་ཤེས་པ་བརྒྱལ་བ་གང་ཡིན་པ་དེ་ནི་༤ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མ་ཡིན་གྱི།",
    "དེ་ནི་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་སྟེ་དེ་ཡེས་བོན་ཐམས་ཅད་པའོ་ཞེས་བྱ་བ་དེར་གྲུབ་བོ།",
    "དེ་མ་ཡིན་པའི་རྣམ་པར་ཤེས་པ་གཞན་རྣམས་ནི་གནས་སོ་སོར་ངེས་པ་དང་མི་བརྟན་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་ཤེས་པ་དང་།",
    "རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་མེད་ན་མི་རུང་ངོ།",
    "རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་མེད་ན།",
    "རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་དྲུག་པོ་རྣམས་ལས་གང་ཡང་རུང་བས།",
    "འདི་ནས་ཤི་འཕོས་ཏེ་མཉམ་པར་གཞག་པའི་སར་སྐྱེ་བ་ན།",
    "ས་བོན་ཐམས་ཅད་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་མེད་ན།",
    "ས་བོན་མེད་ཅིང་གཞི་མེད་པར་འགྱུར་རོ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་རྣམ་པར་ཤེས་པ་དེའི་གནས་ནི།",
    "ལེགས་པར་བྱ་བ་བྱེད་པའམ།",
    "ཇི་ལྟར་ན་འཇིག་རྟེན་པའི་རྣམ་པར་བྱང་བ་ཡང་མི་རུང་ཞེ་ན།",
    "གཟུགས་ན་སྤྱོད་པའི་སེམས་འདས་པ་ཚེ་རབས་དུ་མར་སེམས་གཞན་གྱིས་བར་དུ་༥བཅད་པ་དེ་ཡང་མེད་པའི་ཕྱིར་མཉམ་པར་གཞག་པའི་སེམས་དེའི་ས་བོན་ཉིད་དུ་མི་རུང་ངོ།",
    "གང་ས་བོན་ཐམས་ཅད་པ་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་དེ་འོངས་པ་དེ་ནི་གཟུགས་ན་སྤྱོད་པའི་མཉམ་པར་གཞག་པའི་སེམས་དེའི་རྒྱུའི་རྐྱེན་ཡིན་ལ།",
    "དེ་བཞིན་དུ་འཇིག་རྟེན་ལས་འདས་པའི་རྣམ་པར་བྱང་བ་ཡང་ས་བོན་ཐམས་ཅད་པ་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་མེད་ན་མི་རུང་སྟེ།",
    "ཇི་ལྟར་ན་འཇིག་རྟེན་ལས་འདས་པའི་རྣམ་པར་བྱང་བ་མི་རུང་ཞེ་ན།",
    "གཞན་གྱི་སྒྲ་ལས་ཡིད་ལ་བྱེད་པ་དེས་རྣ་བའི་རྣམ་པར་ཤེས་པའམ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའམ།",
    "དེ་གཉི་ག་ལ་བག་ཆགས་སུ་བསྒོས་པར་འགྱུར་གྲང་ན།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་དེ་ལས་གཞན་པའི་རྣམ་པར་ཤེས་པ་རྣམ་པར་གཡེང་བས་བར་དུ་ཆོད་ལ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཐོས་པའི་བག་ཆགས་བསྒོས་པ་དེ་ནི་བག་ཆགས་དང་བཅས་ཏེ་འགགས་ཤིང་འདས་ནས་ཡུན་རིང་དུ་ལོན་ཏེ་མེད་ན།",
    "གང་ཡང་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པ་དང་མཚུངས་པར་ལྡན་པའི་འཇིག་རྟེན་པའི་སེམས་དེ་ནི།",
    "ཡང་དག་པའི་ལྟ་བ་དང་མཚུངས་པར་ལྡན་པའི་རྨྱེའཇིག་རྟེན་ལས་འདས་པའི་སེམས་དང་ནམ་ཡང་ལྷན་ཅིག་ཏུ་སྐྱེས་པ་དང་འགག་བྱེ་པ་མེད་དེ།",
    "དེ་ལྟ་བས་ན་འཇིག་རྟེན་ལས་འདས་པའི་རྣམ་པར་བྱང་བ་ཡང་ས་བོན་ཐམས་ཅད་པ་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་མེད་ན་མི་རུང་སྟེ།",
    "དེ་ལ་ཐོས་པའི་བག་ཆགས་ཀྱིས་ནི་དེའི་ས་བོན་ཡོངས་སུ་འཛིན་པར་མི་རིགས་པའི་ཕྱིར་རོ།",
    "ཐོས་པའི་བག་ཆགས་གང་ཡིན་པ་དེ་ཡང་ཅི་ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་ངོ་བོ་ཉིད་ཡིན་ནམ།",
    "གལ་ཏེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་ངོ་བོ་ཉིད་ཡིན་ན་ནི།",
    "ཇི་སྟེ་དེའི་ངོ་བོ་ཉིད་མ་ཡིན་ན་ནི་དེས་ན་ཅེཐོས་པའི་བག་ཆགས་ཀྱི་ས་བོན་དེའི་གནས་ཅི་ཞིག་ཡིན་པར་བལྟ་ཞེ་ན།",
    "དེ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་མ་ཡིན་ཏེ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་གཉེན་པོ་ཡིན་པས་ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་ངོ་བོ་ཉིད་མ་ཡིན་པ་དང་།",
    "ཉེས་པར་བྱས་པ་ཐམས་ཅད་དེ་ངེས་པར་བྱེད་པའི་གཉེན་པོ་ཡིན་ནོ།",
    "ཆུང་ངུ་དང་འབྲིང་པོ་དང་ཆེན་པོ་ཇི་ལྟ་ཇི་ལྟ་བུར་རིམ་གྱིས་འཕེལ་བ་དེ་ལྟ་དེ་ལྟ་བུར་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་ཡང་འབྲི་འུཞིང་གནས་ཀྱང་འགྱུར་རོ།",
    "གནས་རྣམ་པ་ཐམས་ཅད་དུ་གྱུར་ན་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་ས་བོན་ཐམས་ཅད་པ་ཡང་ས་བོན་མེད་པར་གྱུར་པ་དང་རྣམ་པ་ཐམས་ཅད་དུ་སྤངས་པ་ཡང་ཡིན་ནོ།",
    "ཇི་ལྟར་ན་ཡང་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་མ་ཡིན་པ་ཆུ་དང་འོ་མ་བཞིན་དུ་ལྷན་ཅིག་ཏུ་སྤུགནས་པ་རྣམས་རྣམ་པ་ཐམས་ཅད་དུ་འགྲིབ་པར་འགྱུར་ཞེ་ན།",
    "མཉམ་པར་གཞག་པ་མ་ཡིན་པའི་སའི་བག་ཆགས་འགྲིབ་སྟེ།",
    "མཉམ་པར་གཞག་པའི་སའི་བག་ཆགས་འཕེལ་ནས་གནས་གྱུར་པ་བཞིན་ནོ།",
    "འགོག་པ་ལ་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་རྣམ་པར་ཤེས་པ་དང་མི་འབྲལ་ལོ་ཞེས་གསུངས་པའི་ཡང་ཕྱིར་དེ་ནི་རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་དང་མ་བྲལ་བར་རིགས་ཏེ།",
    "དེའི་གཉེན་པོར་འགོག་པའི་སྙོམས་པར་འཇུག་པ་སྐྱེ་བ་ནི་མ་ཡིན་ནོ།",
    "གང་ཡང་འགོག་པའི་སྟོམས་པར་འཇུག་པ་ལ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡོད་པས་སེམས་དང་བཅས་པ་སྙམ་དུ་སེམས་པ་དེའི་ལྟར་ན་ཡང་སེམས་དེ་མི་རུང་སྟེ།",
    "སྙོམས་པར་འཇུག་ང་མི་རུང་བའི་ཕྱིར་དང་།",
    "འདུ་ཤེས་རྒྱུན་ཆད་པ་ཙམ་དུ་འགྱུར་བས་དེའི་མཐུས་མཉམ་པར་གཞག་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ལས་ལངས་པའི་དེ་ཡང་མི་རུང་ངོ།",
    "དེ་མ་ཐག་པའི་རྐྱེན་ཉིད་ཚོདུ་རུང་བ་མ་གཏོགས་པར་དགྲ་བཅོམ་པའི་ཐ་མའི་སེམས་ཀྱང་མི་རུང་བར་འགྱུར་རོ།",
    "རྣམ་པར་ཤེས་པ་ལྔ་སྤངས་པ།",
    "རྒྱུ་འབྲས་ཐ་དད་མེད་པར་འགྱུར།",
    "དངོས་པོ་མེད་པར་འགྱུར་འདོད་ན།",
    "དེ་མེད་པར་ནི་གཉིས་མེད་དེ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་འདིའི་རབ་ཏུ་དབྱེ་བ་གང་ཞེ་ན།",
    "རྣམ་པར་སྨིན་པས་རབ་ཏུ་དབྱེ་བ་དང་།",
    "དེ་མེད་དུ་ཟིན་ན་འདུ་བྱེད་ཀྱི་རྐྱེན་གྱིས་རྣམ་པར་ཤེས་པ་དང་།",
    "དེ་ལ་རྣམ་པར་སྨིན་པས་རབ་ཏུ་དབྱེ་བ་ནི་གང་འདུ་བྱེད་དང་སྲིད་པའི་རྐྱེན་གྱིས་འགྲོ་བ་རྣམས་སུ་རྣམ་པར་སྨིན་པ་སྟེ།"
  ]
