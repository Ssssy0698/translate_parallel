    "མཆོད་སྦྱིན་གྱི་བྱ་བ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་ཞིང་།",
    "རིག་པར་བྱེད་པའི་རྒྱལ་པོ་ཐམས་ཅད་ཀྱང་ས་སྲུང་བར་བྱེད་པར་འགྱུར་བ་དང་།",
    "འབྲས་བུ་སྨིན་པར་བྱེད་པ་དང་།",
    "སྤྲིན་རྣམས་དོན་མེད་པར་མ་ཡིན་ཏེ།",
    "ས་གཞིར་ཆར་པ་ལེགས་པར་འབབ་པར་འགྱུར་བ་དང་།",
    "མི་རྣམས་ཀྱི་བྱ་བ་ཇི་ལྟར་བརྩམས་པ་རྣམས་ཀྱང་ཕལ་ཆེར་གྲུབ་པར་འགྱུར་ཞིང་ལུས་ཅན་རྣམས་ལ་ཡང་གནོད་པ་བྱེད་པ་རྣམས་དང་།",
    "བ་ལ་སོགས་པ་རྣམས་ཀྱང་ཡང་དག་པར་འཇིག་པར་འགྱུར་རོ།",
    "བློ་ངོར་ག་པར་ཡལ་ག་ན་སྐར་མདའི་ལྟས་ལ་སྐར་མདའ་འདི་དག་ནི་དེ་དག་ནི་མཚན་མ་བསྟན་ལ་ཆ་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "༩༨ ༥པའོ་། འཇིག་རྟེན་དག་ན་རྟགས་སྟོན་པར་བྱེད་པ་སྟེ།",
    "རྩུབ་པ་ནི་འཇིགས་པར་བྱེད་པ་སྟེ་མིའི་རྒྱལ་པོ་རྣམས་དང་།",
    "ས་སྟེངས་སུ་ལྷུང་ཞིང་བཟློག་ཕྱོགས་སུ་འགྲོ་བར་འགྱུར་ན་ཡུལ་དེར་ཞི་བ་མ་ཡིན་པར་འགྱུར་རོ།",
    "གནོད་པར་གྱུར་པའི་ཡུལ་དག་ཏུ་དམག་འགྱེད་དུ་འཇུག་པ་ཡང་བྱེད་པར་འགྱུར་རོ།",
    "དེའི་འོག་ཏུ་རང་བཞིན་གྱིས་དམག་ཁོ་ནས་འཇིག་རྟེན་རྣམས་འཆི་བར་བྱེད་པར་འགྱུར་རོ།",
    "དེ་དག་ལྷུང་ིབ་དག་རྗེས་སུ་མཚན་ཉིད་ཡང་དག་པར་རབ་ཏུ་བརྗོད་པར་བྱ་སྟེ།",
    "ཁོ་༢༡༨ ཀ་བཏའཐུལ་བ་དག་ཏུ་ལྷུང་བ་དེར་ནི་རྒྱལ་པོ་ལ་གནོད་པར་འགྱུར་རོ།",
    "གང་དུ་སྐར་མདའ་ཉི་མ་ལ་མངོན་དུ་ཕྱོགས་ཏེ་ལྷུང་བ་ནི་ཤིན་ཏུ་འཇིགས་པར་བྱེད་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་རྒྱལ་པོ་ལ་ཡང་གནོད་པར་འགྱུར་རོ།",
    "གང་དུ་སྐར་མདར་ལྷུང་ཞིང་གཟའ་མིག་དམར་ལ་གནོད་པ་བྱེད་པ་དེར་ནི་དམག་དཔོན་གསོད་པར་འགྱུར་ཞིང་།",
    "གལ་ཏེ་སྐར་མདའ་འབབ་པ་ཉི་མའི་བུ་སྤེན་པ་ལ་གནོད་པར་བྱེད་པ་དེར་ནི་སྣ་བོའི་གཙོ་བོ་དང་།",
    "མཚོན་གྱིས་འཚེ་བ་ཡང་རབ་ཏུ་ཟད་པར་བྱེད་པར་འགྱུར།",
    "སྐར་མདའ་རྟའི་དབྱིབས་ལྟ་བུ་ནི་རྒྱལ་པོའི་དམག་ལ་གནོད་པར་འགྱུར་རོ།",
    "ཁ་ཊཾ་གའི་དབྱིབས་ལྟ་བུ་ནི་ཡུལ་དང་རྒྱལ་པོར་བཅས་པ་ལ་གནོད་པར་འགྱུར་རོ།",
    "ཤིང་རྟའི་རྣམ་པ་དག་ཏུ་ས་ལ་ལྟུང་ིབ་ནི་ཞག་བདུན་གྱི་དམག་དང་རྒྱལ་པོར་བཅས་པ་ལ་གནོད་པར་འགྱུར་རོ།",
    "རྒྱལ་པོ་དང་བཅས་པ་ལ་གནོད་པར་འགྱུར་རོ།",
    "སྣ་ཚོགས། རི་༢༡༨ ཀྱི་རྒྱལ་པོ་གསོད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་མཆོད་སྦྱིན་གྱི་ལས་རྣམས་འཇིགས་པར་འགྱུར་རོ།",
    "ཟླ་བའི་འོད་ཟེར་ལྟར་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "ཤེལ་ལྟ་བུར་གྱུར་ན་ནི་ལོ་ལེགས་པར་འགྱུར་རོ།",
    "གསེར་གྱི་འོད་ལྟ་བུར་གྱུར་ན་ནི་མེས་འཁྲུག་པར་འགྱུར་རོ།",
    "འདི་སྐད་དུ་གང་བསྟན་པ་ནི་ཟླ་བ་གཉིས་མ་ལུས་པར་དེའི་རྣམ་པར་སྨིན་པར་འགྱུར་བར་བརྗོད་དོ།",
    "མུ་གེ་ཡང་སྟོན་པར་བྱེད་དོ།",
    "ནམ་མཁའ་ལ་སྤྲིན་མེད་པར་འབྲུག་ཟེར་བ་ོ་དང་།",
    "སྐར་མདའ་དག་ཀྱང་ལྷུང་བར་གྱུར་ོན་དེར་ལོ་གཅིག་ཚུན་ཆད་དུ་འཇིག་རྟེན་ཀུན་དུ་ཟད་པར་འགྱུར་བར་རིག་པར་བྱ་ཞིང་།",
    "རྟ་བྲེས་དང་གླང་པོ་ཆེའི་བྲེས་སུ་བབ་ན་དེའི་སྲུང་མ་ངེས་པར་འཇིགས་པར་འགྱུར་རོ།",
    "ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "ཡུལ་འཁོར་དང་བཅས་པ་འཇིགས་མི་པར་བྱེད་པའོ།",
    "ཡུལ་འཁོར་འཇིག་པར་འགྱུར་བར་༧རིག་པར་བྱའོ།",
    "ཆར་པ་འབབ་པར་འགྱུར་ཞིང་ལོ་ལེགས་པ་དང་།",
    "དེ་བཞིན་དུ་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "ཟ་འཇིག་རྟེན་ལ་གནོད་པར་བྱེད་པ་སྤྱང་ཀི་དང་།",
    "བྱི་བ་དང་བྱེ་བ་ལ་སོགས་པ་དག་ཀྱང་ཀུན་ནས་འབབ་པར་འགྱུར་རོ།་།",
    "འབྲུག་སྒྲ་ཡང་གྲག་པ་དེའི་ཚེ་ནི་ཆར་པ་ཆེན་པོ་འབབ་པར་འགྱུར་ཞིང་།",
    "རྒྱལ་པོ་རྣམ་པར་རྒྱལ་བ་དང་།",
    "གྱིས་ཉམས་པའི་སྒྲ་གནམ་ལྟ་བུ་དང་བཅས་པ་གྲག་པ་དེར་ནི་ལུས་ཅན་རྣམས་ལ་ཤིན་ཏུ་དམན་པར་འགྱུར་བར་བསྟན་པའོ།་",
    "ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "དེ་བཞིན་དུ་བ་ལང་རྫིའི་གནས་དེར་རབ་ཏུ་འཇིག་པར་འགྱུར་རོ།",
    "སྐྲ་ཤད་ལ་སོགས་པས་མངོན་དུ་གང་བ་དེ་དག་ཏུ་ནི་ངེས་པར་ཉེ་འཁོར་གྱི་སྐྱེ་བོའི་སྐལ་བ་ཟད་པའི་ལྟས་སུ་བསྟན་པ་ཡིན་ནོ།",
    "རྒྱལ་པོ་རྣམས་རྣམ་པར་རྒྱལ་བར་འགྱུར་ཏེ།",
    "འབྲས་བུ་ཟླ་བ་དྲུག་ན་སྟོན་པར་བརྗོད་དོ།",
    "སྤྲིན་དང་སྒྲ་མཉམ་པར་འགྱུར་ཞིང་།",
    "ཕྱོགས་ཐམས་ཅད་ཀུན་དུ་ཁེབས་པར་གྱུར་པས་ནི་རྒྱལ་པོ་འཆི་བར་འགྱུར་ཞིང་སྐྱེ་བོ་རྣམས་ཀྱང་འཆི་བར་འགྱུར་བ་ཡིན་ནོ།",
    "གནོད་པར་ཡང་འགྱུར་ཞིང་།",
    "འཇིག་རྟེན་ཡང་ཟད་པར་འགྱུར།",
    "གེལ་པ་དག་ལས་དུས་དང་མི་ལྡན་པར་འབྲས་བུ་འབྱུང་ིན་རྒྱལ་པོའི་ཡུལ་ཕྱོགས་སུ་གཏོགས་པ་གསོད་པར་འགྱུར་རོ།",
    "ལྷ་རྟེན་བྱས་པ་དང་།",
    "མཚོ་ལ་སོགས་པ་ིསྲོག་ཆགས་ཆུ་ན་རྒྱུ་བ་རྣམས་གང་དུ་སྐམ་༧ པ་དེར་ནི་རིང་པོར་མི་ཐོགས་པར་སྐྱེ་བོ་འཇིགས་པར་འགྱུར་ཞེས་བསྟན་ཏོ།",
    "རྫིང་རྣམས་ཀྱི་ཆུ་དག་ཀུན་འཁྲུག་པར་འགྱུར་ཅིབ་གང་ཡིན་པ་དེར་ནི་རྒྱལ་པོ་དང་།",
    "སྒོ་གང་དག་ཏུ་སེར་བ་འབབ་ཅིང་མེ་མེད་པར་ཡང་མེ་མདག་ལྟུང་ཀྱི་བར་འགྱུར་རོ།",
    "གཞུ་མ་བདུངས་པ་བདུངས་པར་གྱུར་ན་དེ་ནི་ངེས་པར་དམག་མི་བཟད་པ་འབྱུང་ིབར་སྟོན་ཏོ།",
    "སྐྱེ་བོ་ངས་པར་འགྱུར་རོ།",
    "ནམ་མཁའ་སྤྲིན་གྱིས་ཀུན་དུ་ཁེབས་པ་ན་ཕྱོགས་ཚ་བར་གྱུར་པ་དེའི་ཚེ་ནི་རྒྱལ་པོ་གསོད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དགུན་ནི་དྲོ་བར་གྱུར་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "འཇིགས་པར་བྱེད་པའི་ཆོམ་རྐུན་རྣམས་ཀྱིས་ཀྱང་ལོ་ཏོག་ཆུད་གསོན་པར་འགྱུར་རོ།",
    "ཡུལ་རྟག་ཏུ་འཇིག་པར་བསྟན་པ་ཡིན་ནོ།",
    "ཁུང་ན་ཉལ་བ་རྣམས་ལོག་པར་འཁྲིག་པ་དང་ལྡན་པར་སྨྲ་བ་དེ་ནི་རྒྱལ་པོ་འཆི་བར་འགྱུར་རོ།",
    "ཝ་ངལ་མི་སོས་པར་བརྒྱལ་བར་འགྱུར་བ་དེར་ནི་ཡུལ་གྱི་བདག་པོ་དང་ཅི།",
    "ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "བ་ལང་རྫིའི་གནས་འཇིག་པར་འགྱུར་བར་བརྗོད་པར་བྱའོ།",
    "གང་དུ་ཝ་ཉིན་པར་ཉི་མ་ལ་ཁ་ལྟ་ཞིང་ཡང་དང་ཡང་ིསྐད་དྲག་པོ་འབྱིན་པ་དང་།",
    "རིང་ཞིང་བརྟན་པའི་སྒྲས་འབྲུག་ཟེར་བ་དེའི་ཚེ་ཡང་གཅིག་པ་ཆུ་དང་ལྡན་པར་འགྱུར་རོ།",
    "གཟའ་ཐམས་ཅད་འབྱུང་ཞིང་འདུ་བའི་སྤྲིན་དེ་དག་ནི་ཆར་པ་བབ་པར་བྱེད་དེ།",
    "དགུན་ཟླ་ཐ་ཆུངས་ལ་སྤྲིན་བརྩེགས་པའི་སྤྲིན་རུམ་འདུས་པ་གློག་དང་བཅས་པ་ནི་དབྱར་ཟླ་འབྲིང་པོར་ཡང་དག་པར་གྱུར་ནས་ཆུ་མང་དུ་རྣམ་པར་གཏོང་བར་འགྱུར་རོ།་།",
    "དཔྱིད་ཟླ་ར་བ་ལ་སྤྲིན་རུམ་དུ་གྱུར་པས་ནི་དབྱར་ཟླ་ཐ་ཆུངས་ལ་ཆར་པ་འབབ་པར་བསྟན་པར་བྱའོ།",
    "སྔོ་བསངས་སུ་བྱེད་པ་དེའི་ཚེ་ནི་ཆུ་ཆེར་འབབ་པར་འགྱུར་རོ།",
    "མི་གཞན་ཞིག་ལག་ན་གདུགས་ཐོགས་ནས་ཆར་པའི་མཚན་མ་དྲིས་ིསམ་ཁྱིམ་འགེངས་བཞིན་དུ་དྲིས་ན་དེའི་ཚེ་རྟག་ཏུ་ཆར་པ་འབབ་པར་འགྱུར་རོ།",
    "ཡུར་བ་འགེངས་པར་བྱེད་ན་ཕྲལ་ིདུ་ཆར་པ་འབབ་པའི་རྒྱུ་ཡིན་ཏེ།",
    "ལུས་ཅན་གྲང་བར་བྱེད་པ་ནི་དེར་འཕྲལ་དུ་ངེས་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "༡༥པར་ཆར་པ་འབབ་པར་བྱེད་པའོ།",
    "ས་ན་དུས་ཚིགས་ཀྱི་འོད་ཆགས་པའི་ལྟས་ལ་བྲམ་ཟེ་རིག་པ་ཅན་གྱིས་དུས་ཚིགས་ཀྱི་འོད་ཆགས་པ་བསྒྲིམས་ཏེ་བརྟགས་ནས་དུས་བསྟན་པར་བྱ་སྟེ།",
    "དུས་ཚིགས་ཀྱི་ཆགས་པ་ཤིན་ཏུ་དམར་བ་ནི་ཉིན་གསུམ་དུ་ཆར་པ་འབབ་པར་བསྟན་ཏོ།",
    "ཡང་ན་མཚོན་གྱིས་འདེབས་པ་མཚོན་གྱིས་འཚོ་བའི་སྐྱེ་བོ་ཟད་པར་ཡང་འགྱུར་རོ།",
    "གལ་ཏེ་དུས་ཚིགས་ཀྱི་ཆགས་པ་ཡང་དང་ཡང་དུ་བྱིས་པ་དག་དམག་འགྱེད་པ་ན་རྣམ་པར་སྐྲག་པར་འགྱུར་ཞིང་རབ་ཏུ་རྒྱུག་པར་བྱེད་པ་དེར་ནི་ཡུལ་འཁོར་འཇིག་པར་འགྱུར་རོ།",
    "གསོད་པར་ཡང་བསྟན་པར་བྱའོ།",
    "ཡང་ན་ངེས་པར་བདག་པོ་འཆི་བར་བསྟན་པ་ཡིན་ནོ།",
    "གས་པར་གྱུར་པ་དང་།",
    "རིང་པོ་མི་ཐོགས་པར་ཡུལ་འཇིག་པར་འགྱུར་རོ།",
    "གོམ་པ་འདོར་བས་ནི་ཡུལ་བོར་ཏེ་འདོང་པར་འགྱུར་རོ།",
    "གླུ་ལེན་པས་ནི་ཡུལ་འཇིག་པར་འགྱུར་རོ།",
    "ཡང་གང་དུ་རྒྱལ་པོ་རྟག་ཏུ་ཕན་ཚུན་འཁྱམ་པར་བྱེད་པ་དང་།",
    "འཇིགས་པ་མེད་པར་ཡང་འཇིགས་པས་སྐྲག་པ་དང་།",
    "གང་དུ་བསྟན་པ་མེད་པར་བྱིས་པ་གླུ་དང་སྤེལ་ཏེ།",
    "མི་མཐུན་པའི་དོན་བརྗོད་པ་དེར་ནི་རྒྱལ་པོ་འཆི་བར་རྗོད་པར་བྱེད་དོ།",
    "དེ་དག་དགོས་པ་ཡང་དག་པར་མི་འགྲུབ་པ་ཙམ་དུ་མ་ཟད་ཀྱི་ལུས་འཇིག་པར་འགྱུར་རོ།",
    "ཆུ་སྦྱིན་པར་བྱེད་པའི་འབྲུག་མི་གསལ་བ་འབྱིན་པ་དག་ནི་འཇིགས་པ་བདེན་པར་རིག་པར་བྱེད་པ་ཡིན་ནོ།",
    "པ་བ་སངས་ནི་ཟླ་བ་དྲུག་ཚུན་ཆད་ཀྱིས་སྨིན་པར་འགྱུར་བར་བསྟན་པར་བྱའོ།",
    "གཟའ་རྣམས་འཁྱམས་པ་ནི་ཞག་གསུམ་ཚུན་ཆད་ཀྱིས་སྨིན་པར་འགྱུར་རོ།",
    "ཉི་ཟླའི་ཡང་འཕྲལ་དུ་འབྲས་བུར་འགྱུར་བར་བསྟན་པར་བྱའོ།",
    "དུས་མ་ཡིན་པར་ལོ་ཏོག་འབྲས་བུ་ཆགས་པ་ཐམས་ཅད་ཀྱི་ཡང་ཟླ་བ་དྲུག་པར་བརྗོད་དོ།",
    "དེ་བཞིན་དུ་སྦྲང་བུ་མང་པོའི་ལྟས་བསྟན་པ་ལས་ནི་ཟླ་བ་གཅིག་ཏུ་ཤེས་པར་བྱའོ།",
    "རྣམ་པར་དག་པ་ལ་རྟེན་པ་དག་དང་།",
    "བཟླས་བརྗོད་ལ་བརྩོན་པར་བྱ་བ་དང་།",
    "ཡུལ་འཁོར་དེ་དག་རྒྱུག་ཅིང་རྣམ་པར་འཇིག་པ་ཡང་ཡུན་རིང་དུ་གནས་པ་ཙམ་དུ་འགྱུར་བར་བསྟན་ཏོ།",
    "གནོད་པར་གྱུར་པའི་ལྟས་འབྱུང་ལ།",
    "ཕན་པར་འགྱུར་བའི་ཆོ་ག་གང་།",
    "གོ་ཏ་མས་ིཉན་པར་གྱིས།",
    "གཙོ་བོ་དག་ལ་ཅི་རིགས་པར།",
    "ཞག་བདུན་སྨྱུང་བ་བྱས་གྱུར་པས།",
