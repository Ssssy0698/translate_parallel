    "བདག་གིས་ཀྱང་ཡོ་བྱད་བྱིན་ཏེ།",
    "ཁང་པ་གཅིག་གི་ཚད་འདི་ལས་འདར་མི་གནང་དུ་ཟད་ཀྱི།",
    "ཁང་པ་གནམ་འཕང་གི་རྩེག་མར་ནི་ལྔ་རྩེག་མན་ཆད་གནང་།",
    "དགེ་སློང་གིས་བདག་པོ་ཡོད་པ་དང་།",
    "ཁྲིད་པའི་དགེ་སློང་དག་གིས་ཀྱང་གཞི་མི་རུང་བ་དང་ཧུརྟེ་རྩོད་པ་དང་ཡངས་པར་རྟོགས་ཤིག།",
    "དགེ་སློང་དེ་གཉིས་ཚེ་སྔ་མའི་ལས་ཀྱིས་གྲོང་དབུལ་པོར་བབ་ནས་རབ་ཏུ་འཁྲུགས་ཏེ་ཁྲོས་པས་འཁོན་དུ་བཟུང་ནས་དགེ་སློང་དེ་གཉིས་ཀྱིས་སྲིང་མོ་དགེ་སློང་མ་གྲོགས་མོ་ཞེས་བྱ་བ་བསླུས་ཏེ།",
    "མ་ཉེས་པ་ནི་ཉེས་པ་མེད་པའི་དོན་སྐུར་པའི་ཚིག་གིས་རྩ་བ་མེད་པ་རྣམ་པ་གསུམ་སྟེ།",
    "སྐུར་པའི་ཚིག་ནི་གཞན་ལ་བརྗོད་དགུར་ལྷག་མ་རེ་རེ།",
    "ཡན་ལག་གི་ཚངས་པར་སྤྱོད་པ་དང་དབྲལ་བར་བྱ་བ་དང་།",
    "སྟོན་པའི་བསྟན་པ་གསལ་བར་བྱེད་ན་བདེ་བ་ལ་རེག་པར་གནས་པར་འགྱུར་གྱེ།",
    "ཤཱཀྱའི་བུ་དང་མོད་གལ་གྱི་བུ་ཚངས་པར་སྤྱོད་པའི་ཚོགས་ལ་ཡང་འཁོར་རྣམ་པ་བཞི་མི་གཏད་ན།",
