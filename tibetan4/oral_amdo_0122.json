    "དགེ་སློང་མས་ཀྱང་འདོད་ཆགས་ལངས་པ་ཁྱེཤེས་ནས་བྲོས་པ་དང་ཕྱི་བཞིན་དུ་བསྙགས་ནས་ལམ་དུ་ཁུ་བ་སྟོར་བ་ཤམ་ཐབས་ལ་རེག་པ་དེ་འདོད་ཆགས་ཞི་བའི་འོག་ཏུ་དགེ་སློང་མ་སྦེད་མ་ལ་འཁྲུར་བཅུག་ནས་སྦེད་མས་ཁུ་བ་སྐམ་པོ་བཏོགས་ཏེ་མངལ་གྱེ་སྒོར་བླུགས་པ་ལས་བུར་ཆགས་པ་ལས་བཅས།",
    "གོས་རྙིང་པར་ཙོ་ཆུད་པ་ནི་ལོ་གཅིག་ལ་དུས་བཞིར་བཅས་པའི་དུས་གཅིག་གི་བྱེབར་དུ་བགོས་པ་ནི་རྙིང་པའོ།",
    "ཉོན་མོངས་པ་ནི་འདོད་ཆགས།",
    "དགེ་སློང་ཕའི་མདུན་དུ་གོས་བསྐུར་ཇེནས་སོང་ན་འདི་རྣམས་ནི་བླང་དུ་རུང་།",
    "ཡང་དགེ་སློང་གང་ཁྱེམ་བདག་གི་བྱེ་ཆུང་མ་ཉེ་དུ་མ་ཡིན་པའི་གན་དུ་སོང་སྟེ།",
    "ཁྱིམ་བདག་གིས་ཀྱང་མ་དད་པ་བཞིན་མུཕུལ་ནས།",
    "ཉེ་དགའ་བོ་ཁྱོད་ནི་ཁྱེམ་བདག།་",
    "ཁྱིམ་བདག་ཕོ་ལས་བཅས་མོད་ཀྱི་ཁྱེམ་བདག་མོ་ཡང་རུང་སྟེ།",
    "ཉོན་མོངས་པ་ནི་འདོད་ཆེན།",
    "ཆུས་ཁྱེར་ན་ཁྱིམ་བདག་གམ་ཁྱེམ་བདག་གི་ཆུང་མ་ཉེ་དུ་མ་ཡིན་པའི་གན་དུ་སོང་ལ་གོས་སློངས་ཤིག།",
    "གལ་ཏེ་དེ་ལ་བྲམ་ཟེའམ་ཁྱིམ་བདག་དད་པ་ཞིག་གིས་དུས་ཀྱིས།",
    "དད་པ་ཆེན་པོ་ཞིག་གིས་དུས་ཀྱིས་འབུལ་ན་རས་འདི་གཉིས་བླང་དུ་རུང་།",
    "ཉོན་མོངས་པ་ནི་འདོད་ཆེན།",
    "ཁྱིམ་བདག་ཁྱོ་ཤུག་གཉིས་ཀྱིས་དགེ་སློང་དེ་ལ་གོས་རྒྱུའི་རིན་རས་ཡུག་གཅིག་སྦྱིན་པར་བགྲོས་པ་ལས་ཁྱིམ་བདག་གི་ཞུབྲན་མོས་ཉེ་དགའ་བོ་ལ་ཐུསྦྲན་པ་དང་།",
    "ཉེ་དགའ་བོའང་ཁྱིམ་བདག་གི་ཚིགན་དུ་སོང་ནས་ཁྱེད་ཀྱིས་གོས་སྦྱིན་པར་བྱས་པ་ག་རེ་ཞེས་བྱས་པ་ལྔོདང་རས་ཡུག་གཅིག་ཕྱུང་སྟེ་ཕུལ་ནས།",
    "ངས་སྤྱད་པར་ནི་མི་ཆོག་གིས་བཟང་པོ་ཅིག་ཤེབྱིན་ཅིག་ཅེས་སྨྲས་ནས་ཁྱིམ་བདག་དེ་ཉིད་ལ་ནི་རས་བཟང་པོ་མེད་དེ།",
    "རྣམ་པར་རྟོག་པ་འགའ་ཞིག་འབྱུང་ཞེས་བྱ་བ་༤རྟཁྱིམ་བདག་གི་བྲན་མོས་སྦྲན་པའི་དོན་ཏོ།",
    "ཉོན་མོངས་པ་ནི་འདོད་ཆེན།",
    "དགེ་སློང་གི་ཕྱིར་ཁུཁྱིམ་བདག་གི་རྔུཆུང་མ་ཉེ་དུ་མ་ཡིན་པ་སོ་སོ་ནས་གོས་ཀྱི་རིན་ཅིག་སྤགས་ཏེ།",
    "གོས་ཀྱི་རིན་ཞིག་སྤགས་པས་གོས་རེ་རེ་ཞིག་ཉོས་ཏེ།",
    "ཉེ་དགའ་བོ་ལ་སྦྱིན་པར་བྱས་པ་ལས་ཁྱེམ་བདག་གི་ཅེབྲན་མོས་སྦྲན་ནས།",
    "ཉེ་དགའ་བོ་ཁྱིམ་བདག་གི་གན་དུ་སོང་ཏེཐུ།",
    "བདག་གི་ཕྱིར་ཁྱེད་གཉིས་ཀྱིས་གོས་ཀྱི་རིན་སོ་སོ་ནས་སྤགས་ཏེ།",
    "བཟང་པོ་ཚོལ་བའི་ཕྱིར་ཉོན་མོངས་པ་ལས་བཅས།",
    "དགེ་སློང་གི་ཕྱིར་རྒྱལ་པོའམ།",
    "དེ་ནས་ཕོ་ཉ་དེ་ཡང་གོས་ཀྱི་རིན་ཁྱེར་ནས་དགེ་སློང་དེ་དག་ལ་དེར་སོང་སྟེ་ཕྱིན་ནས་དགེ་སློང་དེ་ལ་འཕགས་པ་མཁྱེན་པར་མཛོད་ཅིག་གོས་ཀྱི་རིན་འདི་དག་ནི་ཁྱོད་ལ་རྒྱལ་པོའམ་བློན་པོའམ་བྲམ་ཟེའམ་ཁྱིམ་བདག་གམ་གྲོང་རྡལ་གྱི་མིའམ་ལྗོངས་ཀྱི་མིའམ་ནོར་ཅན་ནམ་ཚོང་དཔོན་ནམ།",
    "ཞལ་ཏ་བགྱིད་པའི་འཕགས་པ་རྣམས་ཀྱི་ཞལ་ཏ་པ་འགའ་མཆིས་སམ་ཞེས་དེ་སྐད་ཟེར་བ་དང་གོས་འདོད་པ་གེདགེ་སློང་གིས་ཕོ་ཉ་འདི་ནི་དགེ་སློང་རྣམས་ཀྱི་གྱེཞལ་ཏ་བྱེད་པ་སྟེ།",
    "དེ་ནས་ཕོ་ཉ་དེས་གོས་ཀྱི་རིན་དེ་དག་ཁྱེར་ནས་ཞལ་ཏ་བྱེད་པ་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་ཞལ་ཏ་བྱེད་པ་དེ་ལ་ཚེ་དང་ལྡན་པ་ཞལ་ཏ་བྱེད་པ་ཤེས་པར་གྱིས་ཤིག།",
    "དེ་ནས་ཕོ་ཉ་དེས་ཞལ་ཏ་བྱེད་པ་དེ་ལ་ཤིན་དུ་ལེགས་པར་བསྒོ་ཞིང་བསྟན་ནས་དགེ་སློང་དེ་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་དགེ་སློང་དེ་ལ་འཕགས་པའི་ཞལ་ཏ་བགྱེད་པ་གང་ལགས་པ་བསྟན་པ་དེ་ལ་བདག་གིས་ལེགས་པར་བསྟན་གྱིས་དེའི་གན་དུ་བཞུད་ཅིག་དང་ཁྱེད་ལ་གོས་རུང་བ་དུས་སུ་བསྐོན་ནོ།",
    "གོས་འདོད་པའི་དགེ་སློང་དེས་ཞལ་ཏ་བྱེད་པའི་གན་ཙོརྟེདུ་སོང་ལ།",
    "ཚེ་དང་ལྡན་པ་ཁྱོད་ཀྱིས་དགེ་སློང་མིང་འདི་ཞེས་བྱ་བའི་ཕྱིར་གང་གོས་ཀྱི་རིན་བསྐུར་བ་དེ་དག་ནི་དགེ་སློང་དགོས་པ་ཅིར་ཡང་མ་གྲུབ་ཀྱིས་ཤེས་པར་གྱིས་ཤིག།",
    "ཚེ་དང་ལྡན་པ་དག་རང་གི་ནོར་དེ་ཆུད་མ་གསན་ཅིག།",
    "ཉེ་དགའ་བོ་མཉན་དུ་ཡོད་པར་སོང་ནས།",
    "ཉེ་དགའ་བོ་ཚོང་དུས་༩སྣཀྱི་དབུས་ན་འདུག་པའི་གན་དུ་ཕོ་ཉས་དོང་ཙེ་བསྐྱལ་ནས་དགེ་སློང་གསེར་དངུལ་ལ་མི་རེག་པའི་ཕྱིར་ཉེ་དགའ་བོས་སྤོས་འཚོང་པའི་བྱིས་པ་ཞིག་ལ་བཞག་གོ།",
    "དེས་སྨྲས་པ་བདག་ཚོང་འདུས་པའི་འདུན་མ་ལ་སྔར་མ་མཆིས་ན་ཆད་པ་འབྱུང་གིརྨྱེ།",
    "ཉེ་དགའ་བོས་ཚར་བཅད་ནས་དོང་ཙེ་འབྱིན་པ་ལ་རིང་མོ་ཞིག་ཐོགས་ནས།",
    "གལ་ཏེ་སྤྲིང་བ་དེའི་འོག་ཏུ་ནོར་བདག་དེ་མི་འཁྲུག་པར་བདག་གིས་བྱས་གོས་འདི་ལོང་ཤིག་ཅེས་ཟེར་ན་བླང་དུ་རུང་།",
    "དྲུག་གི་བར་དང་མཐོ་གང་ལམ།",
    "པུས་མོ་ཡན་ཆད་ལྟེ་བའི་་༡ཁུང་མན་ཆད།",
    "དགེ་སློང་རྣམས་ལུག་སྐྱེབལ་ནག་པོ་འབའ་ཞིག་གིས་སྟན་སར་པ་བྱེད་པ་ལ་ཞུགས་པས་རིན་ཆེ་ཞིང་རྙེད་དཀའ་བའི་ཕྱིར་སེམས་ལས་གྱུར་པ་དང་།",
    "ས་ནག་གིས་བཙོས་པ་སྟེ།",
    "ཉོན་མོངས་པ་ནི་གཞན་མ་དད་པ་དང་།",
    "གལ་ཏེ་དགེ་སློང་གིས་ཕྱེད་ལུག་བལ་ནག་པོ་འབའ་ཞིག་ལས་མ་བཅུག་གམ།",
    "དེ་དག་གིས་དཀར་པོ་དང་འཁོབ་བལ་ཅུང་ཟད་ཙམ་གྱིས་བསྲེས་ཏེ་༡་སྟན་སར་པ་བྱས་ནས་དོན་ཉུང་བའི་དགེ་སློང་གིས་ཀྱང་དཔྱས་པ་ལས་བཅས།",
    "འདིའི་ཉོན་མོངས་པའང་མ་དད་པ་དང་འདས་པ་དང་བཅས་པའོ།",
    "དགེ་སློང་གིས་སྟན་སར་པ་བྱས་ན་མི་འདོད་བཞིན་དུ་ལོ་དྲུག་ཏུ་བྱས་པ་ཆོང་ཤིག།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དེ་ནས་དགེ་སློང་གི་གདིང་བའི་དབུས་རྡོལ་བ་སྤྱོམཐོང་སྟེ་དྲིས་པ་དང་།",
    "དགེ་སློང་ལམ་དུ་ཞུགས་པས་ལུག་གི་བལ་ཞིག་རྙེད་ལ་འདོད་ན་དགེ་སློང་དེས་ལོང་ཤིག།",
    "བླངས་ནས་ཁྱེར་བ་མེད་ན་དཔག་ཚད་གསུམ་གྱི་བར་དུ་ནི་བདག་གིར་ཐུཁྱེར་ཅིག།",
    "དེ་དག་གིས་གླང་པོ་ཆེ་དང་བཅས་པའི་དགྲའི་དཔུང་འོང་བར་མཐོང་ནས་བྲོས་པ་དང་བལ་མང་པོ་བཙལ་བ་ལས།",
    "དོན་ཉུང་བའི་དགེ་སློང་དག་གིས་དཔྱས་པ་ལས་བཅས།",
    "དགེ་སློང་གིས་དཔག་ཚད་གསུམ་ལས་འདས་པར་ལུག་བལ་ཁུར་དུ་ཁྱེར་ན་རྔུརྒྱང་གྲགས་ཕྱེད་ལ་ཉེས་བྱས།",
    "རྒྱང་གྲགས་རེ་རེ་ལ་སྤང་བའི་ཐོང་བ་རེ་རེའོ།",
    "ཡང་དགེ་སློང་གང་རང་གི་༩ལག་གིས་ས་ལེ་སྦྲམ་ལེན་པ་དང་།",
    "ཟངས་དང་ལྕགས་དང་རོ་ཉེ་དང་ཚོན་མོ་སྟེང་ལ་རེག་ན་ཉེས་པ་མེད།",
    "བྱང་ཕྱོགས་ནས་ཚོང་པ་འོངས་པས་གཅིག་པུ་ཐུཔའི་མོ་བོན་པ་ལ་ཤིང་ཐོག་འཁར་གཞོང་གང་དང་།",
    "སྒྲེན་མོར་རྒྱུ་བ་སྤྱོད་ཅིག་ཅེས་འབྱུང་ན།",
    "མཚན་མ་བཏབ་པ་ནི་གསེར་དངུལ་ལྟ་བུ་ལས་སྣདོང་ཙེར་བྱས་ཏེ་རི་མོའི་མཚན་མ་བཏབ་པ་ལ་བྱ་སྟེ།",
    "ཟོང་གི་རིན་ཐང་ཁེ་ཕྱིན་ཕྱི་སྤུཔ་གཉིས་དབྱེར་མི་ཕྱེད་ན་བཅས་སུ་སྤང་བའོ།",
    "དགེ་སློང་གིས་ལྷུང་བཟེད་ལྷག་པ་ཞག་བཅུའི་བར་དུ་ཆོང་ཏུ།",
    "སྙུན་ཟན་པ་དྲུག་ཅུ་སྐྱེད་མོས་ཚལ་ཤུརྟེདུ་སོང་བའི་གན་དུ་སོན་ནས་སྡུན་ཟན་པ་གཅིག་ལ་ཉེ་དགའ་བོས་སྦྱིན་པའི་ཡོན་ཏན་བརྗོད་ནས།",
    "ཉེ་དགའ་བོས་རང་གི་ལྷུང་བཟེད་མཚན་ནས་ཕྱུང་སྟེ་བསྐུར་བ་དང་།",
    "དེ་བཞིན་དུ་སྙུན་ཟན་པ་དྲུག་ཅུ་ཀུན་གྱི་ཐད་དུ་ལན་རེ་སོང་ནས་ལྷུང་བཟེད་རེ་རེའི་རིན་བླངས་པའི་འོག་ཏུ་སྡུན་ཟན་པ་རྣམས་འདུས་ཏེ་གཏམ་བྱས་ན་ཉེ་དགའ་བོས་ལྷུང་བཟེད་དྲུག་ཅུའི་རིན་བླངས་པར་གྱུར་པ་ལས་བཅས།",
    "དགེ་སློང་དེས་ལྷུང་བཟེད་དེ་དགེ་སློང་གི་རྒེའཁོར་ལ་འབུལ་བ་བྱས་ཏེ།",
    "དགེ་སློང་གི་འཁོར་དེ་ལས་ལྷུང་བཟེད་གང་ཐ་མར་གྱུར་པ་དེ་ཁྱེལ་བྱིན་ཏེ།",
    "དགེ་སློང་ཁྱོད་ཀྱིས་ཁྲུང་བཟེད་འདི་བྱིན་གྱིས་མ་བརླབས་མ་བསྐུར།",
    "གཞན་ཧཱུཾམ་བྱིན་པར་ཐ་མར་ཆག་ལ་ཐུག་གི་བར་དུ་བགས་ཀྱིས་དལ་བུས་སྤྱོད་ཅིག་ཅེས་ཟུ་བྱིན་ཅིག།",
    "སྤོས་འཚོང་གི་ཁྱེའུ་ཞིག་ལ་ལྷུང་བཟེད་བཟང་པོ་ཞིག་བདོག་པ་དེ་དགེ་སློང་བསོད་སྟོམས་པ་ལ་ཕུལ་ནས་དགེ་སློང་༩མ་བླངས་པའི་གཏམ་དགེ་སློང་ཧཱུཾ་འཁོར་དུ་བྱས་པ་དང་ཉེ་དགའ་བོས་གོམ་པ་བསྐྱེད་དེ་སྤོས་འཚོང་བའི་གན་དུ་བརྒྱུགས་སོ།",
    "དེ་ནས་སྤོས་འཚོང་གིས་དགེ་སློང་འཆར་སྐྱེབ་ཞིག་འོངས་པར་མཐོང་ནས་ལྷུང་བཟེད་ཕྲོགས་ཀྱིས་དོགས་ཏེ་སྦས་པ་དང་།",
    "དེ་ནས་སྤོས་འཚོང་གིས་ཀྱང་མ་སྟེར་ཏེ་རྩོད་ཅིང་འདུག་པའི་གན་དུ་ཁྱིམ་བདག་ཅིག་འོངས་ནས།",
    "ཉེ་དགའ་བོ་ལ་ཕྱག་བྱས་ནས་ཁྱོད་ཀྱིས་ཕྱག་ཁོངས་པ་འདིས་ཅི་ཞིག་བྱ་ཞེས་སྨྲས་པ་དང་།",
    "དེས་ལྷུང་བཟེད་འདི་ཁྱོས་ལ་ང་ལ་བྱིན་ཅིག་ཅེས་བྱས་སོ།",
    "དེ་ནས་ཁྱིམ་བདག་གིས་ལྷུང་བཟེད་ཉོས་ཏེ་ཉེ་དགའ་བོ་ལ་བྱིན་པས།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དགེ་སློང་ཉེ་དགའ་བོས་སྐྱེད་མོས་ཚལ་ན།",
    "ཡུགས་ས་མོ་ལྔ་བརྒྱས་རས་སྐུད་འཁལ་ཞིང་འདུག་པ་མཐོང་ནས་སྦྱིན་པའི་ཡོན་ཏན་བརྗོད་དེ་སྐུད་པ་བླངས་སོ།",
    "དེ་ནས་ཡུགས་ས་མ་དེ་དག་གིས་སྒུད་པ་སྲང་རེ་རེ་ཐུབྱིན་ནས་ཐ་ག་པ་སྤྱི་ཅེར་ལ་ཡུག་གཅིག་འཐག་ཏུ་བཅོལ་ལོ།་",
    "ཐ་ག་པ་རབ་ཏུ་ཉོན་མོངས་པས་དཔྱས་པ་ལས་བཅས།",
    "བདག་གིས་བཏགས་སམ་གཉེན་ལ་འཐག་ཏུ་བཅོལ་ན་ཉེས་བྱས།",
    "དགེ་སློང་གི་ཕྱིར་ཁྱེམ་བདག་གམ་ཁྱིམ་བདག་གི་ཆུང་མ་ཉེ་དུ་མ་ཡིན་པ་ཞིག་གིས་ཐ་ག་པ་ཉེ་དུ་མ་ཡིན་པ་ལ་གོས་འཐག་ཏུ་བཅུག་པ་ལས།",
    "ཐ་ག་པ་ཉེ་དུ་མ་ཡིན་པའི་གན་དུ་སོང་སྟེ།",
    "གོས་འདི་བདག་གི་ཕྱིར་བཏགས་གིས།་",
    "དེ་ནས་ཁྱེམ་བདག་དེའི་བྲན་མོ་ཞིག་གིས་ཐོས་ནས་ཉེ་དགའ་བོ་ལ་བསྙད་པ་དང་ཉེ་དགའ་བོ་ཐ་ག་པའི་གན་དུ་སོང་སྟེ།",
    "གོས་འདི་བདག་གི་ཕྱིར་འཐག་པ་ཡིན་གྱིས་ཡུག་ཁྱིམ་ཆེ་ཞིང་འཇུར་སྐྱོམདུད་མེད་པར་གྱིས་ཤིག་ཅེས་བསྒོ་ནས་རྔན་པར་ཁ་དའི་ཉུ་ལ་དུ་བྱིན་སྐྲེནོ།",
    "དེ་ནས་ཐ་ག་པས་ཁྱིམ་བདག་ལ་རྒྱུ་སྣོན་ཡང་དང་ཡང་བཀུག་པས་ཁྱིམ་བདག་གིས་སྣམ་བུ་བལྟས་དྐུནས་རས་ཆེ་ལ་བཟང་རབ་ཅིག་བཏགས་ཟིན་ནས།",
    "ཁྱིམ་བདག་གིས་ཐོག་མ་ཐ་ག་པ་ལ།",
    "ཡང་དགེ་སློང་གིས་དགེ་སློང་ལ་གོས་བྱིན་ནས།",
    "དགེ་སློང་ཁྱོད་ལ་འདི་མི་བྱིན་བྱིས་སླར་བྱིན་ཅིག་ཅེས་དེ་སྐད་ཀྱང་སྨྲས་ན།",
    "དགེ་སློང་གིས་སྟོན་ཟླ་ཐ་ཆུངས་ཉར་ཞག་བཅུས་མ་ཚང་བ་ཚུན་ཆད་དུ་གཏད་པའི་གོས་ཤིག་རྙེད་ལ་འདོད་ན་དགེ་སློང་གིས་ལོང་ཤིག།",
    "སྦྱིན་བདག་གིས་རེ་ཞིག་འདིར་ཇེ་ཞོག་ལ་གོས་འགྱེད་པའི་དུས་སུ་བདག་འོངས་ཏེ་དབུལ་ལོ་ཞེས་མཆི་བ་དང་གོས་སྦེད་པ་བསྒོ་ན་དབྱར་ཅི་རྙེད་༦པ་བླང་དུ་རུང་ངོ།",
    "གང་ཟག་གི་རྙེད་པ་ནི་ཞག་བཅུ་མ་འདས་པར་སྤྱིའི་སྔགས་ཀྱིས་བཏབ་ན་འཆང་དུ་རུང་ངོ།",
    "དེ་ནས་དགེ་སློང་དག་གིས་དོན་མ་གོ་སྟེ།",
    "དོགས་པ་དང་བཅས་ཞེས་བྱ་བ་ནི་རྐུན་མོས་སོ།",
    "འཇིགས་པ་དང་བཅས་ཞེས་བྱ་བ་ནི་སྟག་གཟིག་གིས་འཇིགས་པའོ།",
    "དགེ་སློང་གིས་དཔྱིད་ཟླ་བ་གཅིག་ལུས་ན་དབྱར་གྱི་རས་ཆེན་ཚོལ་ཅིག་།",
    "དེ་དག་འདོད་ན་དགེ་སློང་ན་བས་ཞག་བདུན་གྱི་བར་དུ་རང་གིས་བྱེན་གྱེས་རློབས་ལ་གཞག་་པར་བྱ་བའི་བཟའ་བར་བྱའོ།་།",
    "བར་དུ་བཞག་ལ་རང་གི་རྒྱུད་ཀྱིས་མྱོང་༤་བར་བྱེད་དུས་མ་ཡིན་པར་ཟ་བར་བྱེད་པས་དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "སྤང་བ་བྱུང་ནས་དངོས་པོ་མ་སྤངས་ཀྱི་བར་དུ་ན་ཉུལྔཕྱི་མ་རྙེད་པ་དང་དགེ་སྤྱོང་གིས་ཙོརྟཡོ་བྱད་རྙེད་པ་ཐམས་ཅད་ཀྱང་ཐུ་སྤང་བར་འགྱུར་རོ།",
    "ཞག་བདུན་ལ་ཐུག་གི་བར་དུ་བརྗོད་པར་བྱའོ།",
    "དེ་ལ་བདག་གིས་ཚེ་དང་ལྡན་པ་དག་རྨྱེལ་ཅི་འདི་ན་ཡོངས་སུ་དག་པར་གནས་སམ་ཞེས་དྲིའོ།",
    "འདི་ན་ཚེ་དང་ལྡན་པ་དག་ཡོངས་སུ་དག་ན་གང་གི་སྣཕྱིར་ཅང་མི་སྨྲ་བས་དེ་དེ་བཞིན་དུ་འཛིན་ཏོ།",
    "དགེ་སློང་གིས་མནའ་བོར་ན་ཉེས་བྱས་སུ་འགྱུར།་",
    "བརྫུན་ཀྱི་ཉོན་མོངས་པ་ནི་གང་བདེན་པའི་དངོས་པོ་བཅབས་པའོ།",
    "དགེ་སློང་གིས་༩་ཁྱིམ་པའི་སྐྱོན་བརྗོད་ན་སྟེཉེས་བྱས་སུ་འགྱུར།",
    "ཆོ་རིགས་བཙུན་པ་ཞིག་གི་བྱུརུས་བརྗོད་པ་དང་།",
    "དགེ་སྦྱོང་གིས་ཁྱིམ་པའི་ཕྲ་མ་བྱས་ན་ཉེས་བྱས།",
    "བརྫུན་དང་ཕྲ་མ་གཉིས་ཀྱིས་ཉོན་མོངས་པ་ནི་མི་བཟོད་པ་ལས་གྱུར་པའོ།",
    "སྒྱུག་མོ་ལ་ནི་ཁྱོད་ཀྱི་མནའ་མ་མི་སྲུན་པ་དེ་ལུས་འདི་ལྟ་བུ་ཞིག་ན་སྨེ་བའི་ཤ་མཚན་འདི་ལྟ་བུ་ཞིག་ཡོད་པས་མ་རུང་ངོ་ཀྱེ།",
    "དེ་ནས་བུད་མེད་ཀྱིས་ཀྱང་བསོད་སྙོམས།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "བདག་ཁྱེགིས་ཀྱང་གནས་བརྟན་དེ་ལྟ་བུའང་དེ་ལྟར་བྱེད་ན་གསར་བུ་ལྟ་གདོན་མི་ཟའོ་ཞེས་དཔྱས་པ་ལས་བཅས།",
    "དགེ་སློང་ཕོ་མོ་འདི་གཉིས་ཇི་ལྟར་མི་རིགས་པར་ཟད་ཀྱི་གཞན་དེ་དང་མི་འདྲའོ་ཞེས་སྒྲོག་ཏུ་བཅུག་པ་ལས་བཅས།",
    "དགེ་སློང་མུ་དེ་དག་གིས་སྨྲས་པ།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "གཙུག་ལག་ཁང་རྩིག་༤པར་བྱས་པ་ལས་ཤིང་གི་བདག་པོ་ལྷ་ཞིག་གནས་པ་དེས།",
    "དགེ་སློང་གིས་ཤིང་མ་བཅད་ཅིག་ཅེས་བྱུང་བ་ལས།",
    "རྩྭ་དང་ཤིང་སྔོན་པོ་བདག་གིས་བརྔས་སམ་གཞན་རྔར་བཅུག་ཀྱང་རུང་སྟེ།",
    "ཉག་མ་རེ་རེ་ལས་བཅད་ན་ཉེས་བྱས་རེ་རེ་དང་ང་བ་རེ་རེར་འགྱུར།",
    "ལྷ་འདྲེ་མི་གསུམ་བྱེཔའི་ཤིང་གཅོད་པ་ནི་སྟ་ཐབས་རེ་རེ་ཞིང་ཉེས་བྱས་རེ་རེ།",
    "ཤ་མོ་དང་ཕ་བ་དགོ་དགོ་དང་།",
    "གཙུག་ལག་ཁང་གི་ཤིང་ཞིག་མི་བཅད་དུ་མི་རུང་ན།",
    "ཉེ་དགའ་བོ་ཁྱོད་ཀྱང་དགེ་སྐོས་༡༢སུ་བཅུག་ན་བདག་ཅག་ལ་མནར་བར་གྱུར་པ་ནི་གྱད་བུ་ནོར་བཞིན་ནོ་བྱས་ནས།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "གང་ཟག་གི་ཧཱུཾལས་ལམ་གཏོགས་པ་འཕྱའམ་གཞོགས་འཕྱས་བྱེད་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཆར་དབབ་པའི་འོག་ཏུ་དགེ་སློང་དག་ལ་སྦྱིན་བདག་དད་པས་བྱིན་པའི་མལ་སྟན་འདི་དག་སྤྱོད་པ་ཡང་ཚོད་ཟུང་ལ་རིམ་གྲོ་ཤཱ་༥གྱེས་ཤིག་ཅེས་བཀའ་སྩལ་པ་ལས་བཅས།",
    "གང་ཟག་གི་ཁྲི་སྟན་ལ་གོང་མ་ལྟ་བུར་གྱུར་ན་ཉེས་བྱས།",
    "ཁྱོན་མོངས་པ་ནི་མ་གུས་པའོ།",
    "བརྟུལ་དུ་མ་བཅོལ་བར་དེ་ནས་སོང་སྟེ།",
    "དགེ་སློང་རྒས་དུ་པོ་ལ་ནི་མལ་སྟན་བྱིན་གསར་བུ་གཞོན་ནུ་རྣམས་ལ་མ་བྱིན་ནས་གཞོན་ནུ་དེས་རྩྭ་བརྔས་ཏེ་པུས་མོ་ནུབ་ཙམ་དུ་བཏིང་ནས་ཉལ་ལོ།",
    "དགེ་སློང་གིས་རྩྭ་དང་ལོ་མ་ལ་སོགས་པ་མལ་དུ་བཏིང་བ་ལས་མ་བརྟུལ་ཏམ་གཞན་ལ་བརྟུལ་དུ་མ་བཅོལ་བར་གུད་དུ་སོང་ན་ཐོང་བར་འགྱུར།",
    "ཉོན་མོངས་པ་ནི་མ་གུས་པའོ།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དེ་དག་གིས་ཇི་ལྟར་ཉོན་མོངས་པའི་གཏམ་བྱས་པ་ལས།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "ལྷག་མ་དང་འདི་གཉིས་ཀྱི་ཁྱེ་ཉོན་མོངས་པ་ནི་མི་བཟོད་པའོ།",
    "དེས་ཉེ་དགའ་བོའི་ཙམལ་སྟན་ཀྱང་མནོས་ནས་ཡང་ཏོག་ཨྱོགི་ཁང་བུར་ཞུགས་ཏེ་ཉལ་བ་དང་ཉེ་དགའ་བོ་འོངས་ནས་སྒོ་ཕྱེ་ཞེས་བྱས་པ་དང་།",
    "སྟེང་གི་ཡང་ཏོག་ཤཱ་གི་སྟེང་དུ་སོང་ནས་སྔ་མ་ཉལ་བའི་ཐད་ཀར་བུ་གུ་ཡོད་པའི་ནང་དུ་ཁྲིའི་རྐང་པ་གཟེར་མེད་པ་གན་ཐུ་དུ་བཙུགས་ནས་སྟེང་དུ་དྲག་ཏུ་འདུག་པ་དང་།",
    "དགེ་སློང་མོས་པ་ཅན་གྱིས་ཤེས་བཞིན་སྲོག་ཆགས་ཡོད་པའི་ཆུས་རྩྭ་དང་ཕྱི་བ་དང་།",
    "ས་ལ་ཆག་ཆག་འདེབས་ཤིང་འདེབས་སུ་བཅུག་པ་ལས་ཕན་པར་འདོད་པའི་དགེ་སློང་དག་གིས་དེ་ལྟར་མ་བྱེད་ཅིག་ཅེས་བསྒོ་ནསཁྱེ།",
    "མོས་པ་ཅན་གྱིས་སྨྲས་པ།",
    "སྲིན་བུ་དུ་ཤི་བའི་ཕྱེརེ་རེར་འགྱུར།",
    "དེ་དག་གིས་ཤཱནགཙུག་ལག་ཁང་དེ་ལ་དཔྱས་མང་དུ་བཏགས་ནས་དགེ་སློང་གཞན་དག་གིས་སྨྲས་པ།",
    "དེའི་ནང་ནས་མོས་པ་སྐྲུཅན་གྱིས་གཙུག་ལག་ཁང་ཞིག་བརྩིགས་མུཔར་ཁས་བླངས་སོ།",
    "གཙུག་ལག་ཁང་སུམ་བརྩེགས་གཅིག་ཉིན་གཅིག་གིས་ཟིན་པར་བྱས་སོ།",
    "དེས་ཆུ་ཁུང་མ་བཏོད་སྐར་ཁུང་མ་ཕྱེས་གཏན་པའི་གནས་མ་བཅས་པ་ཟླུམ་པོ་ཞིག་བྱས་ནས་དེའི་ནུབ་མོ་ཆར་མོ་ཆེ་བབ་པས་ཕ་གུ་བངས་ཏེ།",
    "སྦྱིན་བདག་དང་དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "རྡོའམ་ཕ་གུ་བསྲེགས་པའམ་ཤིང་ལ་བརྩིགས་པའི་ཕ་གུ་སྐམ་པོ་ལྟ་བུ་བརྩིགས་པའི་མོད་ལ་ཆུས་གཤེར་ནའང་མི་འགྱེལ་བ་ལྟ་བུ་ནི་རིམ་པ་དུ་བརྩིགས་ཀྱང་ཉེས་པ་མེད།",
    "ཤིང་དྲུང་གི་ཉལ་མལ་འགོད་པའི་སྒྲ་ཆེས་པས་སྟོན་ཟླ་ཐ་ཆུངས་ཀྱི་ཙུགཡོན་ཅན་གྱེས་ཐོས་ཏེ་གཞོམ་པར་བྱས་པ་ལས།",
    "དབྱར་མོ་ཐང་དུ་སོང་བ་བྲམ་ཟེས་མཐོང་ནས་ཤཱཀྱའི་བུ་དག་འདྲེན་མར་སྤྱོད་དོ་ཞེས་དཔྱས་པ་ལས་བཅས།",
    "ཟང་ཟིང་གི་སྦྱིན་པ་བྱོས་ཤིག་སྣེཅེས་བཀའ་སྩལ་ནས།",
    "དགེ་སློང་མ་དེ་དག་དགའ་བྱེད་ལ་རྟག་ཏུ་སྤྱན་གཟིགས་འབུལ་ལོ།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དེའི་ཉོན་མོངས་པ་ནི་མི་བཟད་པའོ།",
    "རྒས་ནས་ཁྱོ་ཤུག་གཉིས་ཀ་རབ་ཏུ་བྱུང་སྟེ།",
    "དེ་ཉོན་མོངས་པ་ནི་བག་མེད་པའོ།",
    "དེ་དགེ་སློང་མ་དག་གིས་མཐོང་ནས་དཔྱས་པ་ལས་བཅས།",
    "དེའི་ཉོན་མོངས་པ་ནི་མི་མཛེས་པའོ།་",
    "དེ་ནས་འགྲོན་པོ་མང་པོའི་ནང་ནས་བྲམ་ཟེ་ཞིག་ཡོད་པ་དེས་འདི་ནི་དགེ་སྤྱོང་གི་ཆུང་མའོ།",
    "འདི་ཙོ་༢མནའ་མའོ་ཞེས་སྨྲས་པ་ཐུབསོད་སྟོམས་པས་ཐོས་ནས་དེས་བསམས་པ་བདག་ཅག་གཉིས་ནི་ཤི་བླའི་གནས་ངན་ལེན་ཀུན་སྤྱོད་པ་འདི་དག་དང་འགྲོག་ཐུམི་ཕོད་དོ་སྙམ་ནས་དེས་སླར་ལོག་སྟེ་གཏམ་བྱས་པ་ལས་དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དགེ་སློང་དང་བཅས་པའི་འགྲོན་པོ་སྟིམང་པོ་མཐོང་ནས་དེ་དག་གིས་དགེ་སློང་དང་འགྲོགས་སུ་མི་རུང་སྙམ་ནས་མགོ་སྲི་ཞིང་དོང་བ་ལས་ཆོམ་པོས་བཅོམ་ནས་དགེ་སློང་དང་འགྲོགས་སུ་གནང་བ་ཡིན་ཏེ།",
    "དཔུང་གིས་མི་ཐུབ་ན་འཇིགས་པའི་རྐྱེན་ཀྱིས་དགེ་སློང་མ་དང་འཐམས་ཏེ་འགྲོགས་ཀྱང་ཉེས་པ་མེད།",
    "འདི་ནི་དགེ་སློང་གི་ཆུང་མའོ།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "ཆུ་འབྱམ་དུ་སོང་ན་རྒྱང་གྲགས་ཕྱེད་ཅིང་ཉེས་བྱས།",
    "ཡང་དགེ་སློང་གང་བུད་མེད་དང་གཉིས་སུ་སྤུདབེན་པ་སྐྱབས་ཡོད་པ་ན་འདུག་ན་ཐོང་བའོ།",
    "རྒན་མོ་དེས་སྨྲས་པ།",
    "འཆར་བའི་གྲུཆུང་མ་སྦེད་མ་རབ་ཏུ་བྱུང་ནས་ཁང་སྐྱོང་གི་རེས་བབ་སྟེ།",
    "གཙུག་ལག་ཁང་ཕྱག་དར་བྱེད་པའི་གན་དུ་དགེ་སློང་འཆར་བ་སོང་ནས།",
    "དགེ་སློང་མ་དག་གིས་དཔྱས་པ་ལས་བཅས།",
    "ཁྱེམ་བདག་དང་བྲམ་ཟེ་དག་གིས་གནས་བརྟན་ཀོཎྜི་༢ནྱ་ལ་སོགས་པའི་བསོད་སྙོམས་རྟག་ཏུ་སྦྱོར་བ་ལས།",
    "དེ་ནས་དགེ་སློང་མ་སྦོམ་དགའ་མོ་རྨྱེཁྱིམ་བདག་ག་ལ་བ་དེར་སོང་ནས་ཅང་ཤེས་ཀོཎྜི་ནྱའི་བསོད་སྙོམས་སྦྱོར་བ་དེར་སོང་ནས།",
    "དེས་ཟོས་པ་དང་དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "ཐ་ན་རེ་ལྡེ་ཙམ་ཕྱགས་ནས་གྱེཔའི་གནས་མལ་ཙམ་སྐྱང་ནུལ་བྱས་པ་དང་ལམ་གྱི་དུས་ན་དཔག་ཚད་གཅིག་ཏུ་སོང་སྔངམ།",
    "ངེད་ཀྱིས་མུར་འདུག་པ་བཅོམ་མོ་ཞེས་སྤྱོམས་པ་ལས་བཅས།",
    "ཐུན་མོང་ཙུ་གི་གནས་ན་གནས་པའི་ཚེ་ན་ཉེས་བྱས།",
    "འདིའི་ཉོན་མོངས་པ་ནི་མ་དད་པའོ།",
    "དགེ་སློང་མང་པོ་ཁྱིམ་རྣམས་སུ་དོང་བ་ལས་གལ་ཏེ་དེ་དག་ལ་བྲམ་ཟེའམ་ཁྱིམ་བདག་དད་པ་དག་གིས་ཕྱེའམ་ཁུར་བ་དུས་ཀྱི་བདར་བ་གེའདོད་ན།",
    "དགེ་སློང་དག་གིས་ལྷུང་བཟེད་གང་བ་གཉིས་སམ་གསུམ་ལོང་ཤིག།",
    "ཁྱེམ་བདག་ལ་བུ་མོ་ཞར་མ་ཞིག་ཡོད་པ་དེས།",
    "དར་ལ་བབ་ཀྱི་བར་དུ་སུས་ཀྱང་མ་འདོད་ནས་གུད་ཀྱི་ཁྱེམ་བདག་གཅིག་གི་རྟཆུང་མ་བདུན་རིམ་གྱིས་བླངས་པ་ལས་དུས་ལས་འདས་པར་གྱུར་ནས་དེ་ཕྱིན་ཆད་ཡུགས་ས་མོ་ཡན་ཆད་སུའང་དེའི་གན་དུ་འདུག་པར་མ་དད་ནས་བུ་མོ་ཞར་མ་དེ་བླང་བར་བྱས་སོ།",
    "རྒན་མོ་ལག་མོ་ཆེ་དེས་ཀྱང་ལྷུང་བཟེད་རྣམས་ཁུར་བས་བཀང་སྟེ་བྱིན་པས་གཉེ་བོ་ཟན་ཆད་ནས་ཁྲོས་ཏེ།",
    "ཞར་མ་བོར་ནས་ཁྱིམ་བདག་དང་རྒན་མོ་མ་དད་པར་གྱུར་པ་ལས་བཅས།",
    "ཚོད་མ་དང་སྲན་ཚོད་དང་བཅས་པ་ཕྱབླུགས་ན་ཁ་རན་ལ་མཐེ་བོའི་ཁྱོན་ཁྱེགང་མ་ཐུག་ཀྱེཔའོ།་།",
    "ཆུང་ངུ་ནི་འབྲས་སྐམ་དྲུས་པ་ཀྱེཕུལ་གང་གི་ཐུཆན་དང་།",
    "གྲལ་ནས་མ་ལངས་པ་གཅིག་གི་མདུན་དུ་སོང་ལ་ཙོག་པུར་འདུག་སྟེ།",
    "དགོངས་ཤིག་ཚེ་དང་ལྡན་པ་བདག་མིང་ཞེས་བགྱི་བ་ཟས་ཟོས་ནས་སྤང་བར་བགྱིས་ན་འགྲངས་པར་འགྱུར་རྟེམོད་ཀྱི།",
    "ད་འདི་ནི་ཁྱོད་ཀྱི་ཡིན་གྱིས་ཟོས་རྔུཤིག་ཅེས་བྱའོ།",
    "ཟན་ཟ་ཞིང་འདུག་པའི་འཕྲོ་ལས་ལངས་པ་ནི་ཟན་ལ་སྐྱེ་བོས་མ་རེག་ན་བྱིན་ལེན་ཞིག་པར་མི་འགྱུར་ཏེ།",
    "ཡང་དགེ་སློང་གང་གིས་དགེ་སློང་གང་གི་དགེ་སློང་ཟས་ཟོས་ནས་སྤང་བར་ཤེས་པ་ཀླན་ཀ་བཙལ་ཏེ།",
    "དེ་ནས་ཁྱེམ་བདག་གིས་བཟའ་བ་དང་བཅའ་བ་བྱིན་ནས་དེ་གཉིས་ཕྱིར་ལོག་སྟེ།",
    "དགེ་སློང་དེ་དག་གིས་ཏུསྟེདེར་ལྷག་མ་བྱེད་དུ་བཅུག་པ་ལས་དེས་བདག་གིས་སྐལ་བ་ནི་ལྷག་མར་བྱས།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དགེ་སྤྱོང་གི་ཟས་དུས་ཏེ།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "ཡོན་བདག་གཅིག་གིས་བྱན་ཚང་གཅིག་ནས་སྦྱར་བ་ནི་འདུས་ཤིང་ཟོས་ཀྱང་ཉེས་པ་མེད།",
    "ལམ་དུ་སྐྱེནི་དཔག་ཚད་ཕྱེད་དུ་སོང་བ་ཕན་ཆད་དོ།",
    "གྲུར་ཞུགས་པ་ཡང་དཔག་ཚད་ཕྱེད་དུ་སོང་བ་ཕན་ཆད་དོ།",
    "མྱུ་སྟེགས་ཀྱི་དགེ་སློང་གིས་ཟས་བྱིན་པ་ལྟ་བུ་ནི་འདུས་ཤིང་ཟོས་ཀྱང་ཉེས་པ་མེད།",
    "བུད་མེད་སྲེད་པ་ཅན་དག་གིས་མཐོང་ནས་བྲང་བརྡུངས་ཏེ།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དབེེས་པ་ལས་བཅས།",
    "ལས་བྱས་སམ་ལམ་རིང་པོར་སོང་ན་བུ་རམ་དང་བཅས་པ་ཕྱལ་སོགས་པ་བཟར་རུང་།",
    "དགེ་སློང་གི་ཁ་ཟས་བྱིན་ལེན་བྱས་ནས།",
    "དགེ་སློང་གིས་བཙོས་པ་དང་།",
    "དགེ་སློང་གིས་རེག་པའི་ཁ་ཟས་དང་འདི་བཞིན་དུ་༡༡ཉེས་བྱས་སུ་འགྱུར།",
    "རོ་གཅིག་གི་ཟླ་ལ་ཟན་ཆ་ལྔ་ཐུབསྐྱལ་བ་ཚིདགེ་སློང་དེས་ཟ་ཞིང་འདུག་གོ།",
    "དེ་ནས་བྲམ་ཟེའི་བུ་དག་ཁ་ཅིག་གིས་བགྲོས་ཏེ།",
    "གྲོགས་པོ་དག་གིས་ཀྱང་གྲོགས་དང་ར་མདའ་བྱས་སོ།་།",
    "བར་མཛུབ་མོས་གཙུགས་ཙོ་ཏེ་ཁ་ཟས་བླུགས་པ་དང་འདི་རྣམས་ནི་བྱིན་ལེན་ཤཱ་༡དུ་མི་འགྱུར་རོ།",
    "ཡང་དགེ་སློང་གིས་ཁ་ཟས་བྱིན་ལེན་བྱས་ནས་གུད་དུ་སོང་བའི་འོག་ཏུ་གཞན་གྱིས་དེར་ཁ་ཟས་བླུགས་པར་གྱུར་ཏེ་ཕྱིས་བྱིན་ལེན་བྱ་བའི་མི་མེད་པ་དང་།",
    "སྨོད་པ་ཞེས་བྱ་བའི་ཡུལ་ན་ཁ་ཟས་ལག་པར་བྱིན་པ་ལས་ཉེས་དམིགས་མེད་པར་རྩི་བའི་ཡུལ་ན་ནི་བྱང་གི་སྒྲ་མི་སྙན་གྱི་འདུ་ཤེས་བཞག་སྟེ།",
    "ཕྱི་དེའི་ཉིན་པར་སྟག་གི་སྤར་མོ་གང་བཟའ།",
    "ཁ་ཟས་བརྟག་པ་ནི་མེ་དང་མཚོན་དང་སེན་མོ་ལ་སོགས་པས་བརྟགས་ཏེ།",
    "འབྲུའམ་ཤིང་ཏོག་གི་ཕུང་པོ་ལྟ་བུ་ལ་གཉིས་སམ་གསུམ་དུ་མེས་རེག་པར་བྱའོ།",
    "གལ་ཏེ་མཚོན་དང་སེན་མོས་བརྟགས་ན་ནི་འབྲུ་རེ་རེ་གེནས་གདབ་པར་བྱགེ།",
    "ཤིང་ཏོག་ལྟ་བུ་བྱིན་ལེན་བྱས་པ་ལས་བྲུལ་ནས་སྐྱིལ་མོ་ཀྲུང་བཅས་ཏེ་བསྙབ་ཏུ་སླེབས་པ་ཚུན་ཆད་རང་གིས་བླངསསྣེ།",
    "ཡང་དགེ་སློང་དག་གིས་བདག་གི་ཕྱིར་ཟས་བཟང་པོ་འདི་ལྟ་བུ་གཞན་གྱི་ཁྱིམ་དག་ནས་བླངས་ཏེ།",
    "འོ་མ་དང་ཞོ་མར་ཤ་ལ་སོགས་པ་བསླངས་ཏེ་ཤོག་ཅིག་ཅེས་བྱས་ནས་བླངས་ཏེ་ཟོས་པ་ལས་ཁྱིམ་བདག་དང་དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དགེ་སློང་མོས་པ་༥སྲོག་ཆགས་དང་བཅས་པའི་ཆུ་ཤེས་བཞིན་དུ་སྤྱོད་པ་ལས་ཕན་འདོགས་པའི་དགེ་སློང་གིས་༦བསྒོ་ན།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དེ་ནས་སྤོས་འཚོང་གི་ཁྱེའུ་ཞིག་ཆུང་མ་བླངས་རེནས་རིང་པོ་མ་ལོན་པ་དེས་ཉིན་པར་ཆུང་མ་ལ་སྤྱད་པར་བྱས་པ་དགེ་སློང་འཆར་བས་ཙུ་ཚོར་ནས་དེའི་ཆུང་མའི་གན་དུ་སོང་སྟེ།",
    "བྱོལ་སོང་གི་སྨྱུན་ངན་པ་ལྟ་ན་ཉེས་བྱས།",
    "སྤོས་འཚོང་གི་ཁྱེའུ་ཞིག་ཆུང་མ་བླངས་ནས་རིང་པོར་མ་ལོན་པའི།",
    "ཟུཉིན་མོ་ཆུང་མ་དང་སྤྱད་པར་འདོད་པ་དང་དགེ་སློང་འཆར་བས་རིག་ནས་འཆར་བ་དེའི་སྒོ་འཕར་གྱི་སྒོག་ཏུ་ཞུགས་ཏེ་འགྲེང་ངོ།",
    "དེ་ནས་ཁྱོ་ཤུག་༤མི་ཚངས་པར་སྤྱོད་པའི་ཚེ།",
    "བཙུན་པ་འཆར་བ་ནི་སྒོའི་སྒོག་ན་ཞུགས་སོ་ཞེས་བྱས་ནས་སྤོས་འཚོང་གི་ཁྱེའུ་དེ་དང་དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "མུ་སྟེགས་སྐྱེགཅེར་བུ་མ་དག་གིས་དགའ་བོ་ལ་ཟན་བླངས་ཏེ།",
    "དགའ་བོས་ལེགས་པར་མ་བསམས་པར་གཅེར་བུ་མ་རྒན་མོ་ལ་ནི་ཁུར་བ་གཅིག་བྱིན་གཅེར་བུ་མ་གཞོན་ནུ་ལ་ནི་གཉིས་བྱིན་ནས་རྒན་མོས་གཞོན་ནུ་ལ་སྨྲས་པ།",
    "རྒྱལ་པོའི་བུ་འདིས་ཀྱང་ཁྱོད་བཞམས་སྐྱོསོ་ཞེས་བྱས་ནས།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "རྟ་དང་ཤིང་རྟ་བལ་གླང་རྐང་ཐང་གི་ཚོགས་དམག་རྣམས་རབ་ཏུ་དཔྱས་སོ།",
    "དེ་ནས་དམག་མི་ཕྱི་མ་རྣམས་དགེ་སློང་དེ་བདག་གི་ཕྱེཁས་འཇིགས་ནས་ལམ་ལོག་པར་དོང་ངོ།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "དམག་མི་གཙུག་ལག་ཁང་གི་སྒོར་རྒྱུ་བ་དང་རྒྱལ་པོ་དང་བློན་པོ་ལ་སོགས་པས་ཀྱང་བོས་ཏེ་སོང་བ་ལ་ཉེས་པ་མེད་དོ།",
    "དེ་ནས་བློན་པོ་དག་གིས་གསོལ་པ།",
    "རྒྱལ་པོས་ཀྱང་མགོན་མེད་ཟས་སྦྱིན་ལ་ང་ཁྱོད་དང་ཕྲད་པར་འདོད་དོ་ཞེས་ཡི་གེ་སྤྲིང་ངོ།",
    "རྐང་ཐང་གི་ཚོགས་ལ་ཡང་རྩྭ་༤མི་འདྲའོ་ཞེས་བྱས་ནས་གཉའ་ནས་བཟུང་སྟེ་ཕྱོགས་གཅིག་ཏུ་བོར་རོ།",
    "རྒྱལ་པོས་མ་བཏང་ངམ་བཙུན་མོ་དང་སྲས་དང་བློན་པོ་དང་དམག་དཔོན་གྱིས་མ་བཏང་ན་ཉེས་པ་མེད།",
    "ཞག་གཉིས་དམག་དེའི་ནང་ན་གནས་པའི་ཚེའང་གལ་ཏེ་དགེ་སློང་གིས་བཤམས་པ་དཀྲུགས་སམ།",
    "རྒྱལ་མཚན་དང་དཔུང་གི་ཕྱོགས་ཀྱི་སྐྱེ།",
    "མི་དང་བྱོལ་སོང་འཐབ་རྔུ་པ་ལ་བལྟས་ན་ཉེས་བྱས།",
    "ཁྱུ་མཆོག་གི་རྒྱལ་མཚན་གང་ཡང་རུང་བའོ།་།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "ལུས་ལ་མ་ཕོག་ན་ཉེས་བྱས་རེ་རེ།",
    "དགེ་སྤྱོང་དང་སྐྱེ་བོ་ལ་བརྡེགས་ན་ཉེས་བྱས་རེ་རེ།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "བྱོལ་སོང་ལ་བརྡེགས་པ་དང་གཟས་པ་ལ་ཡང་ཉེས་བྱས་སུ་འགྱུར།",
    "བུ་མོ་བགད་ནས་ཉེ་དགའ་བོ་འདོད་ཆགས་ལངས་ཏེ།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དེས་དེ་ལ་སྦྱིན་དུ་མ་བཅུག་གི།",
    "དེའི་འོག་ཏུ་ཚེ་དང་ལྡན་པ་དག་ཁྱོད་སོང་ཞིག།",
    "ཁྱོད་དང་ལྷན་ཅིག་འདུག་གམ།",
    "དེ་ནས་ཟན་བཟའ་རན་ནས་གྲོང་དུ་ཁྲིད་དེ་སྦྱིན་བདག་གི་སྒོར་ཁྲིད་ནས་ཉེ་དགའ་བོས་སྨྲས་པ།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དགེ་སློང་གིས་དགོན་གནས་མལ་བགོས་ནས།",
    "རྔེར་སྐྲའམ་སྤུའམ་སེན་མོ་བོར་ན་ཉེས་བྱས་སུ་འགྱུར།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དགེ་སློང་གཞན་གྱིས་སྒོ་༤ནས་དེས་སྨྲས་པ་ཅི་ངས་ཆང་འཐུངས་སམ་སྒོག་པ་ཟོས་ཞེས་བྱས་པ་ལ་དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བསྙེན་པར་མ་རྫོགས་པ་དང་ལྷན་ཅིག་མ་ཉལ་ཅིག་པར་བཅས།",
    "དེ་ནས་ནམ་ལངས་པ་དང་དགེ་སྦྱོང་གི་༨ཕ་མའི་སྒོ་ནས་དགེ་སློང་ཡིན་གྱེས་ཞག་གཉིས་ཚུན་ཆད་ཉལ་དུ་རུང་ངོ་ཞེས་བྱུང་བ་ལས་བཅས།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།་",
    "འཇུག་དགུར་ཉེས་བྱས་རེ་རེར་འགྱུར།",
    "དགེ་སློང་ཨ་རི་ཏ་སྤང་བའི་ལས་བྱས་པ་དེ་ངུ་ཞིང་ཉེ་དགའ་བོའི་དྲུང་དུ་སོང་བ་དང་།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "སྐྱེས་བུ་བླུན་པོ་ཁྱོད་མིག་ལམ་ན་མི་སྣང་བར་བྱས་ཀྱིས་ཕར་སོང་ཤིག་ཛྭཅེས་བསྒོ་ཤིག།",
    "ཤོག་བུར་གཞག་པ་དེ་གཉིས་ངུ་ཞིང་ཉེ་དགའ་བོའི་གན་དུ་སོང་ནས།",
    "དགེ་སློང་གིས་གོ་གསར་༡པ་ཞིག་རྙེད་ན་སྔོན་པོའམ་དམར་པོའམ་ངུར་སྨིག་གམ་ཁ་དོག་རྣམ་པ་གསུམ་ལས་གང་ཡང་རུང་བ་ཅིག་ཏུ་བསྒྱུར་ཅིག།",
    "གལ་ཏེ་དགེ་སློང་གིས་སྔོན་པོའམ།",
    "མང་པོ་འདུས་པའི་དྲུང་དུ་རོལ་མོ་སྣ་ཚོགས་བྱས་པ་དང་།",
    "དེ་དག་མཁས་ཁྱད་ལྷའི་གར་ཐབས་དང་རོལ་མོ་བཞིན་པས་འགྲོ་བ་མང་པོ་ཡང་དེར་འདུས་ཏེ་མཚར་དུ་འཛིན་ཏོ།",
    "སྒོར་བྱུང་བའི་ཁ་གདོང་ཚོན་གྱིས་ཞུ་ཟིས་པ་མ་བྱིད་པ།",
    "རོལ་མོ་མཁན་སྔ་མ་དག་གིས་མཐོང་ནས་དེ་དག་གིས་སྨྲས་པ།་",
    "བདག་ཅག་གིས་ཀྱེའཚོ་བ་ནི་རོལ་མོ་མཁན་ལ་ལྟོས་པ་ཡིན་ན་འཕགས་པ་བཟོད་པ་བཞེས་ཙ།",
    "གདོད་བཟོད་པར་བྱའོ་ཞེས་བྱས་ནས་ཤཱཀྱའི་བུས་ཅི་ཉུ་༡རོལ་མོ་མཁན་ལ་ཡང་ནོར་འབེེབས་པར་འགྱུར་རོ་ཞེས་དཔྱས་པར་གྱུར་པ་ལས་བཅས།",
    "ཚོན་མ་བརྟགས་པ་ལྟ་བུར་གྱོན་དགུར་ཉེས་བྱས་རེ་རེར་འགྱུར།",
    "ཀུན་དགའ་ར་བའི་ནང་ན་འདུག་པའམ་གནས་ཁང་གི་ནང་ན་འདུག་པ་ནི་མ་གཏོགས་སོ།",
    "དགེ་སློང་འཆར་བ་ཙབསོད་སྙོམས་ལ་ཞུགས་པས་བྲམ་ཟེའི་བུ་རྩལ་སློབ་པ་མཐོང་ནས་དེ་དག་གི་ཐད་དུ་སོང་ནས།",
    "དེ་ནས་ཁྱིམ་བདག་གིས་ཤཱཀྱའི་བུ་དགེ་སློང་གིས་༨རྩལ་དང་རོལ་མོ་སློབ་པ་ལ་ཡང་དགའ་འབེབས་སོ་ཞེས་དཔྱས་ཟེར་བ་ལ་བཅས།",
    "མཚོན་ཆ་དང་རོལ་མོའི་ཆ་བྱད་སྤྱད་དུ་རུང་བ་ལ་རེག་ན་ལྟུང་།",
    "སྤྱད་དུ་མི་རུང་བ་ལ་རེག་ན་ཉེས་བྱས་སུ་འགྱུར།",
    "སོང་བའི་འོག་ཏུ་ཀུན་དགའ་བོས་རྒྱན་དེ་དག་མཐོང་ནས་སྟོར་གྱིས་དོགས་ནས་སྦས་ཏེ།",
    "མ་སྦྱངས་པ་ལ་རེག་ན་ཉེས་བྱས།",
    "གཅིག་ཏུ་ནི་བཙུན་མོ།",
    "ལས་དུས་ནི་ཆུང་ངུ་ཕྱག་དར་རེ་ལྡེ་ཙམ་ཡན་ཆད་དོ།",
    "བྱོལ་སོང་འགྱོད་པ་མཛུབ་མོ་དང་།",
    "ཡང་དགེ་སློང་གིས་ཆེད་དུ་བསམས་ཏེ།",
    "དགེ་སློང་འཆར་བ་ཡུལ་རྒྱུར་སོང་ཏེ་ཀྱེའཕོང་སློབ་པའི་སར་ཕྱིན་ནས་བྱིས་པ་རྣམས་ཀྱིས་འཕངས་པ་ལ་མ་མགུ་སྟེ།",
    "དེ་ནས་དེའི་ནུབ་མོ་བྱིས་པས་སློབ་དཔོན་གྱེ་རྨྱེམདུན་དུ་གཏམ་བྱས་ནས་སློབ་དཔོན་གྱིས་བསྟན་ཏེ།",
    "བྱ་རོག་གི་རོ་འོད་མ་རིང་པོའི་ཁར་བཏགས་ནས་དགེ་སློང་འཆར་བ་བསོད་སྙོམས་ལེན་དགུར་འཆར་བས་དེ་ལྟ་བུས་སྐྱེབསྒྲུབས་སོ་ཞེས་བྱས་ཏེ།",
    "ཆེད་དུ་བསམས་ཏེ་བྱོལ་སོང་བསད་ན།",
    "ཡང་དགེ་སློང་གང་གིས་ཆེད་དུ་བསམས་ཏེ།",
    "དེའི་འཁོན་བྱེགྱིས་ཁྱེད་ལོ་ཉི་ཤུ་མ་ལོན་པར་བསྙེན་པར་རྫོགས་པས་དགེ་སློང་གི་དངོས་པོ་མེད་དོ་ཞེས་བྱས་ནས།",
    "བདག་གི་ཧཱུཾ་འགྱོད་པ་དང་མི་དགའ་བ་སྐྱེས་ནས།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དགེ་སློང་ཙགིས་འགྱོད་པ་སྐྱེས་ན་ཉེས་བྱས།",
    "དེའི་ཉོན་མོངས་པ་ནི་ཉེ་བར་མ་ཞི་བའོ།",
    "དེ་མི་དགར་དོགས་ཏེ་གཞན་རྣམས་བཟོད་པར་གསོལ་བ་དེའི་ཐད་དུ་སོང་ནས།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "རྨ་དང་མཛེར་བ་དང་སྨེ་བ་ལྟ་བུ་བསྟན་པའི་ཕྱིར་རེག་ན་ཉེས་པ་མེད།",
    "དེའི་ཉོན་མོངས་པ་ནི་ཉེ་བར་མ་ཞི་བའོ།་།",
    "ཡང་ཐོག་གི་སྟེང་ན་འདུག་པས་མཐོང་ནས་རྒྱལ་པོས་བཙུན་མོ་ལ་ཁྱོད་ཀྱི་སྦྱིན་གནས་༤ཀྱི་མཛེས་པ་ལ་ལྟོས་༡ཤཱཞེས་བྱས་པ་དང་།",
    "བཙུན་མོས་སྨྲས་པ།",
    "དེ་དག་གཞོན་ནུ་ལང་ཚོལ་༢བབ་པའི་ཚེ།",
    "བཙུན་མོས་རྒྱལ་པོ་སྦྲན་ཏེ་གྱོད་བཏབ་པོ།",
    "ཁ་ཟས་བྱེད་ཀྱི་ཁུ་བའམ་ཟས་ཀྱི་ཁུ་བ་ཐུག་པ་ལྟ་བུ་ལ་རི་མོ་བྲིས་སམ།",
    "སོར་མོ་ལྔ་ཐབས་བྱས་ན་ཉེས་བྱས་སུ་འགྱུར།",
    "དེའི་ཉོན་མོངས་པ་ནི་ཉེ་བར་མ་ཞི་བའོ།",
    "དེ་ནས་རི་བྲགས་ཀྱི་གྲོང་ཞིག་ན་བུད་མེད་ཡུགས་ས་མོ་སྦྱར་མ་ཞིག་འདུག་པའི་ཐད་དུ་ཕྱིན་ནས།་",
    "ནམ་སྲོས་ཏེ་དེར་ཞག་ལོན་ན་ནམ་ཕྱེད་ཙམ་ལ་འགགས་པའི་རུམ་དུ་བུད་མེད་སྦྱར་མ་དེ་ཞུགས་པ་དང་།",
    "དེའི་དུས་ཐུབུད་མེད་དེའི་མིང་པོ་མི་གཞན་དང་འཐབ་མོ་བྱས་ནས་དེ་དག་གིས་ཁྱོད་ཀྱི་སྲིང་མོ་ལ་ལྟོས་༧ཤཱཀྱའི་བུ་དགེ་སྦྱོང་ཡང་མ་ཤོར་ཏོ་ཞེས་བྱས་པ་དང་།",
    "དེ་གཉིས་ཀྱིས་བདག་ཅག་མིས་བརྙས་པ་ནི་བླུ་སྲིང་མོ་འདིས་ལན་དེ་བསད་དོ་སྙམ་ནས་རལ་གྲི་ཐོགས་ཏེ་ཁྱེམ་དེར་བརྒྱུགས་པ་དང་།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "སྒོ་གཏན་ནས་བཅུག་པར་དགེ་སློང་ནང་དུ་ཉལ་ལ་བུད་མེད་ལྔ་གང་གི་ནང་དུ་ཉལ་ན་ཡང་སྐྱ་རེངས་མ་ཤར་བར་ཉེས་བྱས།",
    "བུད་མེད་དང་ཁྱོ་དང་ཕ་མིང་གིས་སྲུང་ཞིང་འདུག་པ་དང་ལྷན་ཅིག་ལ་ནི་ཉེས་པ་མེད།",
    "སྐྱེས་པ་དགེ་སློང་གི་ཟིནང་ན་བུད་མེད་ཡོད་པ་དང་ལྷན་ཅིག་ཏུ་ཉལ་ན་ཉེས་པ་མེད།",
    "བྱ་གག་ཡན་ཆད་བྱོལ་སོང་མོ་དང་ཁྱིམ་གཅིག་གི་ནང་དུ་ཉལ་ན་ཉེས་བྱས།",
    "དེའི་ཉོན་མོངས་པ་ནི་མ་དད་པའོ།",
    "ལོགས་ཤིག་ཏུ་ཁ་ཏོན་སློབ་ཏུ་སོང་བ་དང་།",
    "འཆར་བས་༨ནུབ་མོ་ལ་བ་བཟློག་སྟེ།",
    "ཌདོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།་",
    "ལུས་ཀྱི་ཡན་ལག་གིས་བསྡིགས་ཀྱང་རུང་།་",
    "ཉོན་མོངས་པ་ནི་མ་དད་པའོ།",
    "ཡང་དགེ་སློང་༤གིས་དགེ་སློང་ངམ།",
    "དེའི་འོག་ཏུ་ཤཱ་རིའི་བུ་དང་མོད་གལ་གྱི་བུ་ཁྱདེར་འོངས་པ་མཐོང་ནས་ཤཱ་རིའི་བུས་སྨྲས་པ།",
    "གོས་གར་སྦས་པ་མོད་གལ་གྱི་བུའི་རྫུ་འཕྲུལ་གྱི་མིག་གིས་བལྟས་ནས་བླངས་ཏེ་བསྐོན་ནོ།",
    "དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།",
    "དེའི་ཉོན་མོངས་པ་ནི་མ་དད་པའོ།",
    "ཉོན་མོངས་པ་ནི་མ་དད་པའོ།",
    "ལུས་རེག་པའི་ལྷག་མ་བྱུང་ཡང་དགེ་སློང་གང་རང་གི་ལག་གིས་ས་རྐོའམ་རྐོར་འཇུག་དུན་རྩང་བའོ།",
    "ས་རྩིག་གི་ངོས་ལ་དོན་མེད་པར་བྲུད་༡ཟིདམ་རི་མོ་བྲིས་ན་ཉེས་བྱས།",
    "ཟླ་བ་བཞིར་མགྲོན་དུ་བྱས་ན་དགེ་སློང་བདག་གིར་ཛུ་གྱིས་ཤིག།",
    "ཁུ་ཤ་བྱེད་དུ་བཅུག་པ་ལས་བྱན་པོས་མ་སྟེར་ནས་སྔོན་ཡོ་བྱད་སྦྱར་བ་རྣམས་ཀྱང་རྣམ་པར་སྨད་ཅིང་སྤྱོས་པ་ལས་དོན་ཉུང་བའི་དགེ་སློང་གིས་དཔྱས་པ་ལས་བཅས།་",
    "ཀུན་ཤེས་པར་འདོད་པའི་དགེ་སློང་གིས་ཀྱང་བསླབ་པ་འདི་ལ་སློབས་ཤིག།",
    "མ་མོ་འཛིན་པ་ཡང་དྲིས་ཤིག།",
    "མི་སློབ་པོ་ཞེས་པའི་བར་གྱི་ཚིག་གིས་སྤྱོས་ནས།"
  ]
