    "བཀའི་ཅོད་པན་བདེ་ཆེན་འཁོར་ལོའི་རྒྱན་དུ་ཆད་པ་མེད་པར་སྩོལ་བ་མཁྱེན་མཁྱེན།",
    "སུ་ཝརྞ་སྲང་འཁོར་གསུམ་བཅས་དབེན་གནས་ལྷ་སྟེང་ནས་གུས་པས་ཕུལ་བའི་ཞུ་ཡིག།",
    "དེང་ལེགས་བྱས་མུ་མཐའ་མེད་པའི་དཔལ་ལས་གྲུབ་པའི་མཛེས་སྐུ་རིས་མེད་བསྟན་འགྲོའི་དཔུང་གཉེན་དོམ་པར་མི་ནུབ་པའི་ཉི་མ་དང་མི་འགྲིབ་པའི་ཟླ་ལྟར་འཚོ་ཞིང་གཞེས་པའི།",
    "སླད་མར་གང་སྐུ་གཞོམ་བྲལ་གཡུང་དྲུང་ངོ་བོར་བརྟན་ཅིང་མི་མཐུན་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྲིན་ལས་ཀྱི་འོད་སྣང་ཕྱོགས་བརྒྱར་སྤྲོ་བས་བསྟན་འགྲོའི་རྒུད་པ་མཐའ་དག་སེལ་བར་རྩེ་གཅིག་ཏུ་སྨོན་པ་ལགས་པས།",
    "ཚེ་རབས་སུ་གཞལ་བར་དཀའ་བའི་བཀའ་དྲིན་གྱིས་ལྕི་བར་གྱུར་ལགས།",
    "། ལེགས་བྱས་རྒྱ་མཚོའི་རིན་ཆེན་རྡུལ།",
    "གཙང་ཞིང་བགྲོད་བྱ་དཔལ་གྱུར་པའི།",
    "འཛིན་ཞེས་སྙན་པར་སྨྲ་བ་ཡང་།",
    "གཞན་དུ་རྣམ་པར་འཁྱམས་པ་ཡི།",
    "འདུ་འགོད་མཛད་པར་མི་འགྱུར་སྙམ།",
    "རྒྱས་པར་འགེངས་ནུས་ཞེས་ཀྱང་གསོལ།",
    "ཁམས་འདྲི་གནང་བ།",
    "ད་ལན་བདག་བྲོ་འཚལ་བ་མེད་པར་བདེ་སྐབས་ལགས་པ་དང་།",
    "མེ་སྲུང་འཁོར་ལོ་ཁར་ཉིན་འཇོག་ལུགས་བཅས་ཕུལ་བ་དེ་ལགས་པ་དགོངས་པར་བཞུགས་པར་མཁྱེན།",
    "སློང་རྣམས་སྣུམ་པར་འཇུག་པ་ཅན།",
    "རྟག་པར་མཛེས་པ་འདི་རྨད་བྱུང་།",
    "དམར་པོས་སྟོད་གཡོགས་བྱས་པའི་ཆུ་ལྡན་མ།",
    "བཀའི་གླེགས་བུ་གནང་སྐྱེས་བཟང་པོས་བཅིབས་པ་སྤྱི་བོའི་རྒྱན་དུ་ཐོབ་པས་གུས་པའི་ཡིད་མཁར་རང་དགའི་ཟླ་བ་ཅིའང་བཞད་པར་གྱུར་ལགས། ། ཚོགས་གསུམ་རྒྱ་མཚོའི་དཔལ་ལས་མངོན་འཁྲུངས་པའི།",
    "ཞུ་མཆིང་དབྱར་རྔ་འཁྲོལ་བ་འདི་ལྟར་ལགས།",
    "ཞལ་འཆེས་དེ་ལྟ་མིན་གསུངས་པ།",
    "དེ་ནི་དུས་འདིར་བདེན་པར་མཐོང་།",
    "སྐད་ཅིག་གཉིས་པར་ཚངས་གནས་སུ།",
    "ངེས་པར་སྦྱིན་པ་ཞིག་ཡོད་ཅེས།",
    "ཕུང་པོ་གཞལ་དུ་མེད་པར་རྟོགས།",
    "དལ་བ་མེད་པར་གཡོ་བཞིན་ལགས།",
    "ཅིས་ཀྱང་མཆི་བས་གེགས་མེད་པར་ཡང་འདོད་པ་འགྲུབ་པར་མཛོད་ཅིག་གུ།",
    "ལྷག་པར་ད་ལན་ཆེད་གཉེར་གྱིས།",
    "ཞབས་པད་དུ་བཅར་དགོས་པའི་བཀའ་ཤོག་ལམ་ཡིག་བཅས་ཐུགས་རྗེ་ཆེན་པོས་བསྐྱངས་པ་ལྟར་བསྒྲུབ་རྩིས་ཁ་ཞེ་མེད་པར་ཞུ་རྒྱུ་ལགས་ཀྱང་།",
    "གངས་ཅན་བསྟན་འགྲོ་ཡོངས་ཀྱི་ཕན་བདེའི་དཔལ་གཅིག་པུ་པར་ལྷམ་མེ་ལྷན་ནེ་ལྷང་ངེར་ཐུགས་རྗེ་དང་ཐབས་མཁས་པའི་ཕྲིན་ལས་ཀྱི་སྒོ་དུ་མས་ཀུན་ནས་འབར་བཞིན་པར་བཞུགས་པ་ནི་བསྟན་འགྲོ་ཡོངས་དང་།",
    "ཁྱད་པར་བདག་ཅག་ལྟོས་བཅས་རྣམས་ལ་གཞལ་དུ་མེད་པའི་བཀའ་དྲིན་དུ་གྱུར།",
    "གང་ཞིག་དེ་ན་རྣམ་པར་དཀར་བའི་འབྲས།",
    "ཀུན་རྟོགས་པར་གྱིས་ཡང་ཡང་འདུ་བྱས་པའི།",
    "ཆགས་པའི་མཆོལ་མ་བཞིན་དུ་བཅིངས་པར་གྱུར།",
    "རྒྱུན་ཕྱོགས་ཟློག་པར་ནུས་པ་སུ་ཞིག་ཡོད།",
    "ཧ་ཅང་བསྡིང་བར་དཀའ་བ་མ་ལགས་གྲང་།",
    "རིན་ཆེན་ཕལ་པའི་སྐྱེས་ལས་ཁྱད་པར་དུ།",
    "དགྱེས་པ་སྐྱེད་ཅེས་རིགས་པར་གསུངས་པ་གང་།",
    "དེས་ནི་སླར་ཡང་ཁྱེད་ཉིད་དམ་པར་མཚོན།",
    "བུས་ཡང་ནས་ཡང་དུ་ལན་བརྒྱར་དབུགས་དབྱུང་ཤིང་གཟེངས་བསྟོད་པ་གནང་བས་བཀའ་དག་ལས་བདེ་བར་ཐར་ཞིང་།",
    "རིན་ཆེན་ཟེག་མ་ཕུལ་འདི་དགྱེས་པར་གཞན་ཡང་བཀའ་ཡི་ཉེ་བར་བསྐུལ་བའི་དོན།",
    "ངེས་ལེགས་བསྟན་མི་ཟད་པར།",
    "ཆགས་པ་ཤེས་ཤིག་མཆིས་པའང་འབུལ་བ་ལགས།",
    "བཀྲ་ཤིས་པའི་ལྷ་རྫས་རབ་དཀར་སྲིང་རིང་སོགས་དགྱེས་པ་ཆེན་པོས་བཞེས་པ་ནས།",
    "འདིར་ཡང་ཐུགས་རྗེ་ཆེན་པོས་མི་འདོར་བའི་བཀའ་ཕེབ་ཚོགས་ལྷ་ཆུའི་རྒྱུན་བཞིན་ཆད་པ་མེད་པར་སྩོལ་བ་མཁྱེན།",
    "སྐྱེ་དགུའི་བློའི་རྙོག་པ་ཐམས་ཅད་རིང་དུ་སེལ་བའི་ཕྲིན་ལས་ཀྱི་འཇུག་པས་འབྲེལ་ཚད་དོན་ལྡན་དུ་སྦྱོར་བཞིན་པར་བཞུགས་པ་ནི་བཀའ་དྲིན་གྱི་ཕུང་པོ་གཞལ་དུ་མེད་པས་ཁྱབ་པར་གྱུར་ལགས།",
    "ད་ལྟ་ཕྱོགས་མཐའི་འཕྲད་མཁན་སོགས་ནི་བཅད་རྒྱུའི་སྟབས་ཆེར་མེད་པའི་གཡེང་བ་ཆུང་ཞིང་དགེ་སྦྱོར་འཕེལ་བའི་སྐབས་སུ་ལགས།",
    "གཞན་གསོལ་འོས་འགའ་ཞིག་ཟུར་དུ་འབུལ་བ་ལྟར་ལགས།",
    "མི་རིང་བར་བོད་ཆེན་ལྗོངས་སུ་ཆབས་ཀྱི་ཁ་ལོ་སྐྱོད་ཅིང་ངོས་སུ་མཇལ་བར་ཡང་རྩེ་གཅིག་ཏུ་སྨོན་པ་ལགས་པས་ཇི་བཞིན་འགྲུབ་པར་ཐུགས་རྗེས་གཟུང་དུ་གསོལ།",
    "དེ་སྲིད་དུའང་བཀའི་ཉེ་བར་འདོམས་པའི་ཕེབས་ཚོགས་ཀྱི་རིམ་པའང་ཆད་པ་མེད་པར་སྤྱི་བོར་སྩོལ་བ་མཁྱེན་མཁྱེན།",
    "སྲིད་གསུམ་བསྟན་པའི་ཉི་མ་སི་ཏུ་ཐམས་ཅད་མཁྱེན་པའི་ཞབས་པད་དུ།",
    "ཏི་ཐོ་ཛྷཱ་ན་ཡ་ས་མུ་དྲ་ཛ་ཡཱ་ཉི་མ་འབུམ་གྱི་གཟི་བརྗིད་ལྟ་བུའི་མཁྱེན་པའི་རྒྱ་མཚོ།",
    "རྒྱལ་བའི་བསྟན་པ་ནམ་མཁའ་ལྟར་རྒྱས་པར་མཛད་ཅིང་འགྲོ་བ་མ་ལུས་ཛི་ན་མརྒ་ས་ཀ་ལ་བྷེ་ནོ་པུཎྜི་ཡཱ།",
    "སྨིན་གྲོལ་གྱི་ས་ལམ་ལ་འགོད་པའི་དབྱིངས་ལ་བཞུགས་པ་ནི་བཀའ་དྲིན་ཆེ།",
    "མངྒ་ལཾ། ། མཉམ་པི་པྲྀཏྟ་ལས་རྨ་བྱ་མྱོས་བཞེས་བྱ་བའི་པྲ་སྟ་རའོ།",
    "ལན་བརྒྱུད་འདུད་བྱས་རྣམ་འདྲེན་མཆོག་གང་རྟག་ཏུ་རྒྱལ་གྱུར་ཅིག།",
    "སྟོན་པར་མཛད་འདིར་མི་གུས་ཡིད་ཅན་སུ།",
    "འདྲེན་པར་རྡོ་རྗེའི་ལྗགས་ཀྱིས་དམ་བཅས་པ།",
