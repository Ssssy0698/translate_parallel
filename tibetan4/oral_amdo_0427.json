    "ཟེར་བའི་ལྷ་རེགས་དང་ཞུ་རྟེན་ཕྱག་ཡ་ཐོག་ཞང་བོད་ཁྱད་ནོར་དཔེ་ཚོགས།",
    "བདག་གི་ལགས་སོ་ཁས་མེད་པའི་རྗེས་སུ་གསུང་གྲོས་ཡོང་ཞུས་པའི།",
    "ཤིན་ཏུ་བར་ཆོད་ཡོད་པའི་བདག་གི་བྱིན་གྱིས་རློབས།",
    "རིག་འཛིན་གསུམ་ནི་གཞའ་ཡལ་སོང་།",
    "ཐང་ཅིག་མི་གཉིས་ཨ་བསྭེ་དང་རྒྱལ་པོ་ཡིན་ཟེར་བ་གཉིས་སླེབ་པ་ཁྱོད་ཀྱི་མིང་ཡིག་རྟགས་དྲིལ་ནས་ཐོན་པའི།",
    "སྐུ་གཟུགས་ཁྲུ་གང་ཙམ་བར་སྣང་ལ་འཕགས་པའི་ས་ལ་མ་རེགས་པ་དང་།",
    "ལས་སྐལ་འགའ་རེ་མཐོང་སྣང་ལ།",
    "མཁྱེན་ཀློང་ཡེ་ཤེས་སྤྱན་གྱིས་གཟིགས་པའི་གདོན་མི་ཟའོ།",
    "ལྷ་སྲུང་ཚོགས་བརྒྱ་བསྐང་བརྒྱ།",
    "དུས་བཞི་རྒྱལ་མོ་ཆ་སྙོམས་པ་རྒྱལ་ཕུར་འགྲུབ་སྦྱོར།",
    "ཉོན་མོངས་དུག་ལྔས་རྨས་པའི་ལུས་ཅན་ཀུན།",
    "མདུན་དུ་གཤེན་རབ་རེ་བཞུགས་གསུང་པ་བཞིན།",
    "འོན་ཏེ་སྙིགས་དུས་ཉོན་མོངས་ཆ་ཡ་ཐོག་ཞང་བོད་ཁྱད་ནོར་དཔེ་ཚོགས།",
    "སྟག་གཟིག་འོལ་མོའི་གླིང་ཆེན་དུ་གདུང་རྒྱུད་ཀྱི་རྒྱལ་པོ་དྲུག་གི་ནང་།",
    "སྦྱིན་བདག་ཨ་མིང་ཞབས་ནས་འདེགས།",
    "དྲི་མེད་ཤེལ་གྱི་མི་ཆུང་གིས།",
    "གཅེན་པོ་ནམ་མཁའ་སྒྲོན་གསལ་ཁྱོད།",
    "གཅུང་པོ་གཡུང་དྲུང་མཐོང་གྲོལ་ཁྱོད།",
    "གནས་ཆེན་ཕྱུག་མོ་དཔལ་རི་གསང་བའི་ཕུག་པ་རུ།",
    "མཆོག་གི་དགོངས་པ་མངོན་དུ་གྱུར།",
    "གསང་མཆོག་མཐར་ཐུག་གི་སྒྲུབ་གནས།",
    "གསང་མཆོག་མཐར་ཐུག་གི་ཞལ་གཟིགས་ཤིང་གཞི་ལམ་འབྲས་ཡི་དོན་རྟོགས་འཆི་མེད་ཡབ་སྲས་གསུམ་ལས་སོགས་གསང་བའི་རིག་འཛིན་མཁའ་འགྲོ་རྣམས་དང་ཞལ་མཇལ་ཞིང་གསུང་གླེང་འགྲོས།",
    "དར་རོག་གི་མཚོ་ལ་ཕེབས་ནས་འཁྱག་པ་ཞུ་བའི་དུས་ཆུ་ལ་བྱིང་བ་མེད་པར་དར་གདང་བ་ཙམ་ཞིག་གི་སྟེང་ལ་གྲྭ་དཔོན་གཉིས་བྱོན་པ་དང་།",
    "སྒྲིབ་སྦྱོངས་དང་ཚོགས་རྫོགས་ཕྱག་བསྐོར་ཁ་འདོན་ལས་སོགས་གཡེང་བ་མེད་པ་དགེ་སེམས་དང་ལྡན་པ།",
    "མ་ཡུམ་བློན་ཟ་ཀླུ་མོ་སྐྱིད་ཅེས་བྱ་ཡ་ཐོག་ཞང་བོད་ཁྱད་ནོར་དཔེ་ཚོགས།",
    "བུད་མེད་ཀྱི་ཡོན་ཏན་ཚང་བ།",
    "དད་པ་མོས་གུས་ཆེ་བ།",
    "བསླུ་རུ་ལྷའི་བུ་མོས་ཀྱང་མི་ཁུགས་གསུང་པ་ལྟར་ཡིན་ཅིང་།",
    "བར་སྐབས་རེར་མགུར་འཐེན་ནས་ལས་སོགས་མཛད་དོ།",
    "རང་གི་ཁུ་བོ་རིན་ཆེན་རྒྱལ་མཚན་ལ།",
    "དགུང་ལོ་བཅུ་དྲུག་གི་དུས་ནས་རྐྱང་སྤྲུལ་ནམ་མཁའ་རྒྱལ་མཚན་དང་མཇལ།",
    "ཁོང་གི་ཞལ་ནས།",
    "ཞལ་མཇལ་བ་དང་འབྲེལ་ཐོག་འགའ་རེ་ནི་སྐྱེ་བ་ངན་པའི་འཕྲོ་ཆད་ནས་ཕན་ཡང་དག་པར་ཐོག་པའི་རྟགས་བྱུང་བ་དང་།",
    "ཁྱུང་པོ་རི་རྩེ་དྲུག་གི་གསང་བའི་ཕུག་པ་རུ་བཞུགས་དུས་བདེ་གསལ་མི་རྟོག་པའི་ཉམས་ལ་མཁའ་ཀློང་དབྱིངས་གསུམ་གྱི་ལྟ་བ་ལ་རང་བྱན་ཆུད་ཅིང་།",
    "མ་པང་མཚོ་སོགས་བསྐོར་ཞིང་ཚོགས་འཁོར་ཕུལ་གནས་བདག་དང་བརྟན་མའི་ཚོགས་ཀྱིས་བསུ་བསྐྱལ་དང་དྲི་ལན་མང་དུ་བྱུང་།",
    "དགའ་སྟོན་གྱི་རོལ་མོ་དཔག་དུ་མེད་པ་མཛད་དོ།",
    "ཡི་དམ་ཆེ་མཆོག་དབལ་གསས་རྔམ་པ་དབལ་བོན་སྟག་ལྷ་མེ་འབར་དབལ་ཕུར་འབྲུག་གསས་ཆེམ་པ་ལ་སོགས་གསང་སྔགས་གསང་བའི་ལྷ་ཞལ་དུ་མར་གཟིགས།",
    "བསུ་མ་བྱེད་ཅིང་རང་རང་གི་ཁས་བླང་དམ་བཅས།",
    "ཁྲི་སྨོན་དགོན་ལ་བཞུགས་དུས་པེ་ནག་གི་ཆོ་འཕྲུལ་བྱི་ལ་ནག་པོ་གཡག་ཙམ་གཅིག་ཏུ་སྤྲུལ་ནས།",
    "ཉིད་དགོངས་པ་མི་གཡོ་ཀློང་ཆེན་ཀ་དག་གི་ངང་ལ་བཞུགས་པའི།",
    "ཡང་རེས་ཤིག་ན་གཟའ་བདུད་ཀྱི་ཆོ་འཕྲུལ་བསྟན་ནས་མགོ་དགུ་སྦྲུལ་མཇུག་དང་བཅས་པ་གདུག་པའི་དབལ་ཟེར་ཚ་ཚ་ཁྲ་ལམ་དུ་འཕྲོ་བ་ཞིག་བྱུང་ཡང་།",
    "ཉིད་མི་གཡོ་ཀློང་ཆེན་གྱི་ངང་ལ་བཞུགས་པའི་གདུག་པའི་ཆོ་འཕྲུལ་གྱིས་མ་ཚུགས་པར་དངོས་མེད་སྟོང་བར་འཇའ་ཡལ་བ་ལྟར་སོང་ངོ།",
    "དེ་སྔོན་ཞབས་ཅུང་ཟད་སྐྱུངས་ཏེ་དེ་ལ་སྐུ་ཡི་ཞབས་བརྟན་མང་པོ་བསྒྲུབས་ནས་གཟིམ་ཁང་གི་ལྷ་ཁང་ལ་སྐུ་གསུང་ཐུགས་རྟེན་ཀུན་ཀྱི་ཕྱི་རིམ་དུ་ནང་བསྐོར་མཛད་པ་བྱས་ཏེ།",
    "ལུག་ལོའི་ཟླ་བ་བཅུ་གཅིག་གི་བཅོ་ལྔའི་དུས་ཆེན་ཉི་མ་དྲོས་སུ་ཕྱིན་པའི་དུས་སུ།",
    "ཆ་ལུགས་ལྔ་ལྡན་གྱི་ཕྱག་རྒྱ་མཛད་ནས་མི་གཡོ་དགོངས་པའི་ངང་ལ་བཞུགས་ཏེ་སྐད་ཅིག་བོན་དབྱིངས་སུ་ཐིམ་མོ།",
    "གཟུགས་སྐུ་འོད་ལས་གྲུབ་པ་ལྟ་བུ་དཀར་གསལ་དུང་གི་མདངས་ལྟར་མཛེས་ཤིང་།",
    "སྐུ་སྨད་སྟག་ཤམ་དང་སྐུ་སྟོད་རྒོད་ཀྱི་གར་ག་ཤོག་གི་རིས།",
    "སྐུ་ཁྲུས་གསོལ་བའི་ཚེ་ན་དྲི་བཟང་གི་ངད་པ་གཟིམ་ཁང་གི་སྟེང་འོག་མེད་པར་ཀུན་ལ་ཁྱབ།",
    "སྤུར་ཁང་ལ་བཞག་དུས་ནམ་མཁའ་གཡའ་དག་ཅིང་སྐབས་སུ་མེ་ཏོག་གི་ཆར་བ་བབ།",
    "བྱ་རྒོད་མང་པོ་བྱུང་ནས་སྤུར་ཁང་སྟེང་གི་ནམ་མཁའ་རུ་བོན་བསྐོར་གྱི་ཚུལ་བྱེད་དོ།",
    "ཁྲི་འཛིན་ཉིད་ལ་ཕུལ་བས་ཁྱོད་རང་གི་དད་རྟེན་ལ་གནང་གསུངས་པའི།",
    "དེ་ལྟར་བློ་ཆུང་ཀུན་ཀྱི་ཡིད་ཆེས་པར་དཀའ་བས་ངོ་མཚར་གྱི་གྲུབ་རྟགས་སྔར་བྱོན་དང་ཕྱིར་འབྱོན་གྱི་སྐྱེས་བུ་དམ་པ་ཀུན་ཀྱི་ཡི་རང་གིས་གནས་སུ་གྱུར་པ།",
    "འོད་ལ་འཐུང་མིན་རང་གི་ལས་ལ་རགས།",
    "མཛད་པའི་འཕྲིན་ལས་རྣམ་དཀར་པད་མོའི་ཚལ།",
    "ཅུང་ཟད་བྱ་བ་ཚིག་གི་མེ་ཏོག་འཐོར།",
    "སྐུ་གསུམ་གྱི་ཀློང་ནས་འགྲོ་བའི་དོན་དུ་ཡུལ་དང་ཡུལ་ཆེན་རྒྱ་གར་ནག་ཞང་ཞུང་བོད་སོགས་རང་རང་གི་བློ་དང་བསྟུན་པའི་འདྲེན་སྟོན་སྤྱོན་པའོ།",
    "རྟག་གཟིགས་ལི་མུར་གཙུག་ཕུད།",
    "རྒྱལ་བའི་རྣམ་སྤྲུལ་བྱོན་པ་རིག་འཛིན་དམ་པའི་ལུང་གིས་བསྔགས་པ་ནི།",
    "ནམ་མཁའ་བློ་གྲོས་མཚན་འཆང་གིས།",
    "གང་མཇལ་ངན་སོང་གཏོང་མི་སྲིད་ཅེས་དང་།",
    "དེ་དུས་གཡུང་དྲུང་བསྟན་པའི་ཉི་མའི་ཐུགས་དགོངས་ཉེ་བར་གཟིགས་པའི་སྦྱིན་པ་བྱམས་མའི་སྒྲུབ་པ་ཞིག་མཛད་དེ།",
    "དེ་ཡང་ལུང་གིས་ཟིན་ཚུལ་དང་སྔ་རྟགས་བྱུང་པའོ།",
    "བཀྲ་ཤིས་ཀྱི་ས་རྟགས་རྨ་བྱའི་རི་མོ་བཀྲ་བ་ལྷ་ཀླུ་མི་ཡི་གར་བསྒྱུར་བའི་ས་གནས་ཡ་ཐོག་ཞང་བོད་ཁྱད་ནོར་དཔེ་ཚོགས།",
    "ལས་ཀྱི་འབྲེལ་བའི་བརྩེ་ལྡན་བུ་མོ་ལ།",
    "༧ དེ་བཞིན་ཡབ་སྐལ་བཟང་ཕུན་ཚོགས་ཀྱི་མཚན་ལམ་དུ་རང་གི་གོས་དཀར་པོ་གྱོན་པ་དང་།",
    "ལག་གིས་ཀྱང་མེ་ཏོག་དཀར་པོ་ལྷ་ལ་འབུལ་བ་སོགས་རྨིས།",
    "དེ་ནས་རབ་བྱུང་བཅོ་ལྔའི་བོང་བུ་ཞེས་པ་ལྕགས་མོ་ཡོས་ཀྱི་ལོར་ཟླ་ཚེས་བཟང་བོར་མངལ་གྱི་དྲི་མས་མ་གོས་ཕྱིར་སྐུ་མཆོག་སྒོང་སྐྱེས་དང་།",
    "མི་རྒྱབ་ཁང་ཁྱིམ་དུ་དྲི་བཟང་གིས་ཁྱབ་པ།",
    "དེ་ནི་མི་སྐྱོན་སྲུང་མ་རེད་གསུངས།",
    "གཙང་པོར་བྱེད་དགོས་པ་རེད་གསུངས།",
    "གསུང་ཚངས་པའི་བརྡ་རྟགས་རྐེད་པར་འཕྲུལ་གྱི་ཡི་གེའི་རི་མོ་བཀྲ་བ།",
    "དེ་ཡང་མི་རྒྱབ་ཚང་ལ་དུས་རྒྱུན་དུ་འདུག་རྒན་མོ་ཞིག་ཡོད་པས་ཀྱང་།",
    "ཁོ་མོ་ཚེ་སྟོད་ནས་ད་བར་དུ་སྣང་ཞིག་ཚང་ལ་བསྡད་ཀྱང་།",
    "མཚན་མོ་གཟིམ་པའི་ཚེ་དྲི་བཟང་གིས་ཁྱབ་པ།",
    "སྲས་དམ་པས་ཁོང་རྣམ་པ་གཉིས་ལ་གཟིགས་ཚེ་ཞལ་འཛུམ་མདངས་དང་ཕྱག་གཉིས་གར་སྟབས་བྱེད་པ་ལ།",
    "ལ་ལུང་རིགས་རྩོད་པའི་དབུ་འཛིན་པའི་བརྡའ་རེད་ཧ་ཧ་ཞེས་བཞད་པར་འདུག་དེ་ནས་གཡུང་དྲུང་བསྟན་པའི་ཉི་མས་གསུངས་པ།",
    "མཁའ་འགྱིང་ཁྱུང་གི་གདུང་རྒྱུད།",
    "ཁྱིམ་པ་བུད་མེད་རྣམས་ཀྱིས་ལས་དཀའ་བྱས་པ་ལ་བལྟས་ནས་གསུངས་པ།",
    "དེ་ནས་དགུང་ལོ་དྲུག་གི་ཐོག་གཡུང་དྲུང་བསྟན་པའི་ཉི་མའི་བཀའ་གསུང་དང་བླ་གྲྭ་ཡོངས་ཀྱིས་བཀའ་གྲོས་མཛད་ནས་མི་འགྱུར་གདོང་ལྔས་བཏེགས་པའི་ཁྲི་ལ་མངའ་གསོལ་བ་དང་།",
    "ཚ་བུ་བདག་གི་ལུས་སེམས་ཤེད་མ་རྒྱས།",
    "བསྟན་དང་འགྲོ་བའི་དོན་ནི་རེ་ཞིག་ཙམ།",
    "ཚ་སྲས་ཁྱོད་ལ་མི་བརྩེ་བ་མིན་ཡང་།",
    "ཕྱག་སོར་རྣམས་སེར་ཀ་ཅན་དུ་སོང་བ་མ་ཡུམ་གྱིས་གཟིགས་པར།",
    "མས་བུ་ལ་གཟིགས་ནས་སྤྱན་ཆབ་ཤོར་བར།",
    "གདུང་སེམས་ཀྱིས་མི་ཐུབ་ན་ཁྲིད་ལ་སོང་ཞེས་བཀས་བཀྱོན་པས།",
    "དེ་ནས་དགུང་ལོ་བཅུ་གཉིས་ཐོག་ཡུམ་སྐུ་བསྙུང་གིས་ཟིན་ནས་སྲས་ལ་གསུངས་པ།",
    "དེ་ནས་ཡུམ་གྱི་དགེ་རྫོགས་ཀྱང་སྣང་ཞིག་གི་ལུགས་སྲོལ་ཇི་བཞིན་མཛད་པ།",
    "གསང་བ་ཡང་གསང་གི་ཨ་རྫོགས་སྙན་གསུམ་ཆ་ལག་བཅས་གསན་པའི་མཚན་ཟུར་བཀོད་ལྟར་འདིར་མ་སྤྲོས།",
    "བཞུགས་པའི་ས་གནས་རེ་ལ་རྡོ་འབུམ་རྡོ་རྐོས་མཆོད་རྟེན་སོགས་བཀྲ་ཤིས་པའི་རྟགས་རེ་བཞག་ས་གནས་སོ་སོའི་གཞི་བདག་དང་ལྷ་སྲིན་ཕོ་མོ་བཀའ་དམ་བཅས།",
    "ཐུན་མཚམས་དེ་གྲོལ་བའི་རྗེ་ཉིད་གར་སོང་བླ་སློབ་ཀུན་ཀྱིས་མ་མཐོང་།",
    "རྗེ་ཉིད་ཀྱི་མཛད་སྤྱོད་འུ་ཅག་གིས་གཞལ་དུ་མེད།",
    "སྔོན་ཆད་ཆ་རྒྱུས་ཡོད་པའི་ཚ་ཁོ་སྦྱིན་བདག་རེ་དང་འཕྲད་པ་གསུང་ཚིག་མང་དུ་བཤད།",
    "གནས་དེ་ནས་དམ་རྟགས་རྡོ་རིང་གཅིག་སྐུ་གཟན་གྱིས་རྒྱབ་ཏུ་ཁུར་ནས་དགོང་མོ་བྱོན་པ།",
    "ཨ་ཞང་མོ་བ་ཚང་བརླགས་གཏོར་བྱས་པས་ཚེ།",
    "ཚ་བུ་བདག་གིས་དམ་བཅའ་མཛད།",
    "དགུང་ལོ་བཅུ་བདུན་ཐོག་ཏུ་སྨྲ་སེང་གི་སྒྲུབ་པ་མཛད་སྐབས།",
    "ཕྱག་གཡས་ཤེས་རབ་རལ་གྲི་དང་ཕྱག་གཡོན་པད་སྡོང་སྟེང་དུ་པོ་ཏི་བསྣམས་པ་གཅིག་ལྷ་ཞལ་གཟིགས་པ།",
    "ཅེས་གསུངས་པས་ཉམས་དང་རྟོགས་པ་ཐུན་མོང་མ་ཡིན་པ་ཤར་གསུངས།",
    "ཁྱད་པར་རྒྱལ་ཆེན་གྲགས་པ་སེང་གེའི་ཞལ་གཟིགས་པ།",
    "རྒྱལ་པོ་ཤེལ་ཁྲབ་ཅན་གྱི་ཞལ་གཟིགས་ཏེ་ཁྱེད་ཀྱི་བསྟན་པའི་ཞབས་འདེགས་བྱེད་ཅེས་དམ་བཅའ་ཕུལ།",
    "ལྷག་པའི་ལྷ་མཆོག་སྨྲ་བའི་སེང་གེའི་ལྷ་ཞལ་གཟིགས་པ་དང་།",
    "དེ་རྗེས་ལོ་རེ་བཞིན་ཆོ་འཕྲུལ་བསྟན་སྐབས།",
    "དེ་དུས་སྲོག་བདག་གིས་ཁོང་གི་མདུན་དུ་མཐུ་རྩལ་འགྱིང་དཀར་རྡོ་གཅིག་གི་སྟེང་དུ་བཙུགས་ཏེ་ཐུང་བར་བྱས་པས།",
    "མི་འགྱུར་བའི་བཀའ་རྟགས་རྡོ་དཀར་གྱི་གཡུང་དྲུང་རི་མོ་བཀྲ།",
    "བསྐལ་བ་ཕྱི་ནས་གླང་གི་ལོར་བསྟན་པའི་སྲུང་མ་བླ་གྲྭ་ཡོངས་ལ་སྤེལ་ཅིག་ཅེས་གསུང་གནང་པའོ།",
    "རང་རེའི་བླ་བྲང་ནང་ཆེན་སོ་སོ་དང་།",
    "དེ་ལོར་ཟླ་བ་བདུན་པའི་ནང་དུ་རྔ་ཡུལ་དུས་འཁྲུག་གིས་ཡུལ་ཕུད་བཏང་ཚེ་ཀུན་ཀྱིས་ཡིད་ཆེས་དད་པ་སྐྱེས།",
    "ཅེས་པའི་རེ་བ་དམ་པོ་ཡང་ཡང་བཅོལ།",
    "དེ་ཡང་འཁོར་འགའ་རེ་ནས་རྒྱལ་པོ་གང་ཡོད་པར་དམག་འོང་པའི།",
    "དཔོན་གཡོག་ལྷན་ཅིག་འགྲོ་བ་ད་རེས་ཙམ།",
    "ཁྱོད་རྒྱལ་བོ་སྤྲང་བོ་ས་མཐའ་འཁྱམས།",
    "དེའི་ནུབ་མོད་བླ་བྲང་མཛོད་ཁང་ནང་དུ་སྲོག་བདག་སྐུ་གཟུགས་མདུན་དུ།",
    "དེ་ལ་ལྟ་རུ་སོང་ཞེས་པ་ཀུན་གྱིས་ཡིད་ཆེས་པའི་ཐབས་སུ་བསྟན་པའོ།",
    "༧ དེ་ཡང་བསྐལ་བ་གླང་གི་ལོའི་འབྲུག་ཟླའི་ཚེས་བཅུ་གསུམ་ཉིན།",
    "དེ་ནས་བཟུང་སྣང་དགོན་བཀྲ་ཤིས་གཡུང་དྲུང་གླིང་གི་བླ་གྲྭ་ཀུན་ཡར་ངོས་ཟླ་བཞིན་རྒྱས་པའོ།",
    "དམ་པ་ཉིད་ཀྱི་གུར་ཐོག་ཏུ་སྤྲིན་བྱིས་རི་མོ་བཀྲ་བ་ཁོང་གི་ཕྱག་སིལ་སྒྲ་ལྷང་ལྷང་སྒྲོགས་པ།",
    "མདང་དགོང་འགྲུལ་བ་ལྷ་སའི་གནས་སྐྱོང་ཡིན་ཟེར་སྲོག་བདག་གི་ཁྲིད་ནས་ཡོང་།",
    "བུད་མེད་རལ་བ་ཅན་ལྔ་སྟོང་ལྔ་བརྒྱ་གཙོ་འཁོར་འདི་འདྲ་ཡོད་ཅེས་སྨྲས།",
    "གཟིམ་ཁང་གི་སྒོ་རུ་སྟག་གི་རྗེས་ཡོད་པ་མཚལ་བ་འདུག་དེ་ལ་རྒྱལ་པོ་ཡུམ་འཁོར་དམ་པ་ཉིད་ལ་ཞུས་པ།",
    "ཕ་རོལ་བྱད་ཁ་ཟློག་པའི་རྟགས་རེ་ཞེས་གསུངས་སོ།",
    "དེ་ཕྱིན་ལོ་བཅུ་ཙམ་ནས་མཆོག་རྩེ་རྒྱལ་བདག་མོ་སྐུ་གཤེགས་སོ།",
    "༧ དེ་ནས་རབ་བྱུང་བཅུ་དྲུག་པ་ཤིང་མོ་བྱ་ལོར་སྐུའི་ཚ་བུ་བསྟན་པའི་རྒྱལ་མཚན་རྒྱ་ནག་ཟུང་ཆུའི་ཕྱོགས་སུ་འགྲོ་དོན་ཕེབས་ནས་ལོ་གཅིག་ཙམ་དུ་བཞུགས་ནས་ཡོད་སྐབས།",
    "ང་ལ་མཇལ་སེམས་གང་ཡོད་རེ་འདོད་སྐོངས།",
    "གྲྭ་ཚང་སེར་ཕྲེང་རོལ་མོ་ལེགས་པའི་བསུ་བར་མཛོད།",
    "དམ་པ་ཉིད་ཀྱི་གྲྭ་ཚང་ལ་ཞལ་གཟིགས་པ་དང་།",
    "རྒྱལ་བསྟན་སྐྱོང་བར་ཞལ་བཞེས་བོན་སྐྱོང་ཚོགས།",
    "ཕྱོགས་འདིར་མུན་ནག་རེ་ལྟོས་སྒྲོན་མེ་ནུབ།",
    "མྱུར་བར་རྒྱལ་ཁང་ནས་ཨ་མཆོད་རྟེན་མདུང་གདན་དྲངས་ཤོག་གསུངས།",
    "ཉོན་ཅིག་ཤ་ཟ་ཧོར་མོ་ཁྱོད།",
    "དམ་རྟགས་གཡུང་དྲུང་སྤྱི་བོར་རི་མོ་བཀོད།",
    "མཚན་ཡང་སྟོང་གསུམ་སྲོག་བདག་ཤ་ཟན་རྒྱལ་མོ་སྟག་རི་རོང་གསོལ།",
    "ཁྱེད་རྣམས་ཟུང་གི་སྐུ་རྐྱེན་ངེས་བཟློག་ལགས།",
    "དམ་པ་ཉིད་ནས་ཡ་ཡ་ཁྱེད་རྣམས་གཅིག་མེད་གཉིས་མེད་བྱ་བ་མི་དགའ་མོ།"
  ]
}