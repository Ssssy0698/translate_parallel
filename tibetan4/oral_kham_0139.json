    "ཁྱད་པར་ཚེ་འདི་ལ་སྒྲུབ་པ་ཁོ་ན་བྱེད་དགོས་པར་འདུག།",
    "དཔོན་བཙུན་དངོས་གྲུབ་དཔལ་འབར་ཡིན་པ་འདུག་ཅེས་སྙན་པའི་སྒྲ་སྒྲོགས་པར་བྱེད་དོ།",
    "ད་ལན་མ་མཇལ་ན་ཕྱིས་མཇལ་བ་དཀའ་བ་འདུག་གསུང་ཐུགས་ཐག་ཅད་ནས་བྱོན།",
    "སླར་ལོག་སྟེ་སྔར་ཤུལ་ན་བཞུགས་འདུག་ལགས་ཞུས་པས།",
    "སྐུ་ཡོན་རྒྱ་ཆེ་ཆུང་ལ་རྩོད་པ་མི་འདུག།",
    "བྱམས་ཆེན་རབ་འབྱམ་པ་མྱ་ངན་ལས་འདའ་ཚུལ་བསྟན་པའི་ལྟས་ཡིན་པ་འདུག་ངོ་མཚར་ཆེ་ཟེར།",
    "དེ་དུས་མགོན་པོ་ཁྲོ་བཅུའི་སྲུང་འཁོར་འདི་ཆེར་བྱས་པས་བར་ཆད་ཀྱི་མཚན་མ་ལས་གྲོལ་བ་ཡིན་པར་འདུག་ཅེས་གསུང་ཞིང་།",
    "འགའ་ཞིག་ལ་རྗེ་འདི་ཉིད་ཤམྦྷ་ལར་སྤྱན་འདྲེན་པ་ཡིན་ཟེར་བའི་སྣང་བ་ཤར་འདུག།",
    "ཚེ་རིང་མ་འདི་བསུ་བ་ལ་ཡོང་བ་དང་ཕྲིན་ལས་སྒྲུབ་པ་ཅིག་འདུག་གསུང་།",
    "དྲུང་འབྱོར་བས་ཀྱང་སྐུ་ཁམས་ཇི་འདྲ་ཡོད་མི་ཤེས་པ་འདུག་པས།",
    "ཐུགས་རྗེས་བཟུང་ཞེས་ཞུ་ཞིང་འདུག་ཟེར་བ་དང་།",
    "བར་ལམ་རྣམས་སུ་མཆོད་འབུལ་གྱི་ཕྱག་རྒྱ་བསམ་གྱིས་མི་ཁྱབ་པ་མཛད་ཀྱིན་འདུག་ཟེར།",
    "ནམ་མཁའི་ཁམས་ཐམས་ཅད་མཁའ་འགྲོ་མ་རིགས་ལྔ་རྒྱན་ཆ་ལུགས་ཕུན་སུམ་ཚོགས་པའི་སྤྲས་པས་གང་འདུག།",
    "གསུང་བཅད་འདུག་ནའང་།",
    "གཟིམ་མལ་ན་འོད་ཀྱི་གུང་བུ་ཞིག་འདུག་པ་མཐོང་བ་དང་།",
    "ཕྱག་ཕྱི་བ་དེ་ཕྱར་བ་ཞིག་གྱོན་ནས་ཉལ་འདུག།",
    "གཞན་ཡང་གཞི་བདག་དེ་ཤིན་དུ་དགའ་བའི་ལྟས་སྟོན་གྱི་འདུག།",
    "མི་སྐྱོན་པར་འདུག་ལགས་ཞུས་ནས་བྱོན་པས།",
    "ཁྱེད་རང་དཔོན་སློབ་གསུམ་གཡོན་མ་དེ་ལ་བཞུགས་ཟེར།",
    "ད་ལན་ངའི་ཁམས་འདི་གསོ་ཐུབ་པ་མི་ཡོང་བ་འདུག་གསུང་བའི་བཀའ་ལུང་ཕེབས་པ་དང་།",
    "གསུང་གནང་ལུགས་སོགས་ཁ་སང་སྔ་མ་ལས་ཅུང་ལེགས་པ་ཅིག་འདུག།",
    "གུས་པས་འདུད་པའི་ཚུལ་ལ་སོགས་པ་མཛད་ཅིང་འདུག་ཟེར།",
    "ནམ་མཁའ་ལ་ངོ་མཚར་གྱི་ལྟས་བཀོད་པ་སྔ་མ་ལས་མཆོག་ཏུ་གྱུར་པ་འདུག་པ་དང་བསྟུན་ན།",
    "དབུ་སྐྲའི་རྩེ་ཟིལ་པས་ཁེབས་པ་ཅིག་འདུག།",
    "འགའ་ཞིག་ནི་འགྲོ་བའི་ཚེ་ཡང་རང་ལྟ་བ་དང་གཞན་ལ་སྟོན་པའི་ཕྱིར་ཅ་ཅོའི་སྒྲ་མང་ཞིང་།",
    "མགོ་རྩོམ་པ་འཕྱིས་འདུག་བསམ་ཡོད་དུས་ཏག་ཏག་ཆེས་སྔ་བ་ཡིན།",
    "དུས་ཚོད་ཆུད་ཟ་བ་ནི་དོན་དུ་རང་དམེ་དང་ཁྱད་པར་མི་འདུག་ལེའུ་བརྒྱད་པ།",
    "ཆགགོ་སྐབས་མང་པོ་ནི་འདོར་ལེན་གྱི་སོམ་ཉིའི་ཁྲོད་ནས་འཆོར་གྱིན་གདའ།",
    "མཐར་ཁོ་རང་ཡང་ཤེས་དམན་ཞིག་ཏུ་གྱུར་ཏེ་ཕལ་བའི་མི་ཚེ་བསྐྱལ་དགོས་པ་ཡིན།",
    "ངས་བལྟས་ན་སྒྱིད་ལུག་དང་གོད་ཆག་ལ་ཁྱད་པར་ཆེན་པོ་མི་འདུག་སྟེ།",
    "ཁོ་ལ་རང་རྟོན་གྱི་བསམ་པ་དཀོན་པས་མེ་ཏོག་ལྡུམ་རའི་ཕག་ཏུ་ཡིབ་ནས་ཁ་རོག་གེར་བྱིས་པ་དེ་ཚོར་བལྟས་ནས་མི་འདུག་ཀ་མེད་བྱུང་།",
    "སྐབས་འདིར་ཁོ་རང་དཀའ་ཁག་གཉིས་ཀྱི་མཐའ་ལ་ལྷུང་།",
    "ངས་བསམས་ན་འདི་ནི་རང་རྟོན་ཅན་དང་རང་དམན་ཅན་གྱི་ཧེ་བག་ཡིན་པར་འདོད།",
    "ད་བར་དུ་ང་རང་ཀོར་ཅིའི་གཏམ་དེར་ཤིན་ཏུ་དགའ་སྟེ།",
    "ཁོ་ཚོའི་བསམ་ང་ར་དོན་དག་མང་པོ་ཞིག་ནི་རང་ཉིད་ལ་ནུས་པ་འཛོམས་ཡང་བསྒྲུབ་ཐུབ་པའི་དཔེ་མི་སྲིད་སྙམ།",
    "དོན་དག་ཐག་གཅོད་ཀྱི་ཐད་ནས་ཀྱང་རང་ཉིད་ལ་མི་དོ།",
    "འདི་ནི་ཨང་ཆེས་མཐའ་མ་བླངས་པ་དང་ཁྱད་པར་གང་ཞིག་འདུག་གམ་ཟེར།",
    "ཁོ་ཚོས་དུས་རྟག་ཏུ་རང་ཉིད་ཀྱི་ཤེས་འཇོན་དང་རང་ཉིད་ཀྱི་དགེ་མཚན་ལ་སོམ་ཉི་བྱེད་པ་ཡིན།",
    "ཨེ་མུ་ཟིན་གྱི་བསམ་པར་ཝེ་ཐྲི་མན་གྱིས་གསར་དུ་བསྣན་པའི་འཁྲིག་སྤྱོད་དང་འབྲེལ་བའི་སྙན་ངག་དེ་དག་གསུབ་དགོས་འདུག་དེ་མིན་དཔར་ཐེངས་གསུམ་པ་བྲིན་བདེ་བོ་མེད་སྙམ།",
    "ལྷག་བསམ་རྣལ་མ་མིན་པའི་ཚེ་སྲོག་དང་གསོབ་གཟུགས་ཀྱི་མི་གཉིས་ལ་ཧེ་བག་ཆེན་པོ་མི་འདུག་པས་ཁ་ཕྱོགས་མེད་པར་དོན་མེད་པའི་ནུས་ཤུགས་ཕུལ་བ་ཙམ་ཡིན།",
    "དེའི་ཕྱིར་ངེས་པ་དོན་གྱི་ལྷག་བསམ་རྣམ་པར་དག་པ་ཟེར་བ་ནི་རང་ཉིད་ཀྱིས་བསླབ་པའི་བསླབ་ཚན་ལ་དགའ་ཞེན་དང་རང་ཉིད་ཀྱིས་སྒྲུབ་ཀྱིན་པའི་བྱ་བར་དགའ་ཞེན་བྱེད་པ་དེ་ཡིན།",
    "སྐབས་ཐོག་དེའི་ཧའོ་ཡིས་ཏག་ཏག་ཧ་ཅང་བྲེལ་མྱུར་ཆེ་བའི་དོན་དག་ཅིག་ཐག་གཅོད་བཞིན་འདུག་པས་ན་གཞོན་འདི་བྱུང་རྒྱལ་གྱིས་གམ་དུ་བཅར་འོངས་པར་ཁྲོ་ལངས་བཞིན་འདུག་དེའི་ཁར་ན་གཞོན་དེའི་རྣམ་འགྱུར་ལ་བལྟས་ན་གདོང་གནག་ཅིང་ཁྲོས་པའི་མདངས་ཤིག་མངོན་འདུག་པས་བལྟས་ཀྱིན་དུ་མིག་ལ་མ་རན།",
    "རྗེས་སུ་ཁོ་རང་དངུལ་ཁང་ཆེ་གྲས་ཤིག་ཏུ་ཞུགས་ནས་རྒྱུ་ནོར་བདག་གཉེར་བློ་འདྲི་བ་བྱས།",
    "གཏོས་ཆེ་བའི་རང་བྱུང་ཁམས་སུ་མིའི་རིགས་ཀྱིས་ལེགས་པའི་དགེ་མཚན་ཆེ་གྲས་ཤིག་བཟུང་མི་འདུག་སྟེ།",
    "དེ་ནི་ཁོ་ཚོར་གྲུབ་འབྲས་ཅུང་ཙམ་ཞིག་ཐོབ་དུས་དགའ་སྤྲོའི་བློ་ཡུལ་ཚིམས་མགོ་ཚུགས་ནས་འཕེལ་མེད་སོར་གནས་སུ་འདུག་པ་ཡིན།",
    "འོ་ན་ང་རང་སང་ཉིན་ལམ་ལ་ཆས་རྒྱུ་བྱ།",
    "འདི་འདྲའི་ན་གཞོན་དག་དུས་རྒྱུན་སུན་སྣང་འཚེར་པོ་ཡོད་ཅིང་ཐག་གཅོད་ཀྱི་བྱ་ཐབས་ཧ་ཅང་ལེགས་པོ་ཡང་མེད།",
    "ཁོ་ཚོའི་གྲངས་ཀ་ཉིན་བཞིན་མང་དུ་འཕེལ་བཞིན་འདུགསླད་ཕྱིན་འཕར་སྣོན་འཕེལ་ཕྱོགས་འདི་སྔར་ལས་མངོན་གསལ་དུ་འགྱུར་སྲིད།",
    "ཀུང་སིས་ཟི་ཐེན་མའེ་ཋི་ཟི་ལགས་ལ་ལས་གླ་འདྲི་དུས་ཁོས་ཨ་སྒོར་༡མཁོ་ཟེར་བས་ཧྥོལ་ཊི་ཀུང་སི་ཧ་ལས་པར་བཏང་སྟེ་རྒྱུ་ནོར་གཡོ་ལེན་བྱེད་ཀྱིན་འདུག་ཟེར།",
    "ཁོ་རང་དེང་རབས་ཚན་རིག་ལ་ཞིང་འཇུག་བྱེད་རྒྱུའི་སྤྲོ་བ་ཤིན་ཏུ་ཆེ།",
    "རིམ་གྱིས་ཁོས་ཕུན་སུམ་ཚོགས་པའི་དངོས་ལུགས་ཤེས་བྱ་གསོག་འཇོག་བྱས་ཤིང་རང་ཉིད་ཀྱི་དྲན་འཛིན་དུའང་བློ་སྤོབས་ཆེ་བའི་དྲན་ཚུལ་ཞིག་ཤར།",
    "འཛམ་གླིང་འཁྲུག་ཆེན་གཉིས་པ་བྱུང་རྗེས་ཁོ་རང་དམག་མི་བྱས་ཏེ་ཨ་རིའི་མཚོ་དམག་སྐམ་འཐབ་རུ་དཔུང་།",
    "གལ་ཏེ་ངེད་གཉིས་ཀྱིས་དུས་ཚོད་ཡོད་ཚད་སྤྱད་དེ་ཆུ་སྦུག་དྲངས་ན་ཉིན་གཅིག་ལ་སྒོར་༤ལས་བཙལ་ཐབས་མི་འདུག་ཟེར།",
    "བསྒྲུབ་དགོས་པའི་དོན་དག་ཡོད་ཚད་འགྲུབ་ཚར་དུས་ངལ་དུབ་ཀྱིས་མནར་བའི་ལུས་སེམས་ལྷོད་ལྷོད་ཅིག་བྱས་ནས་རང་ཉིད་ལ་ངལ་གསོའི་དུས་སྐབས་ཤིག་སྤྲོད་དགོས་པ་དང་རང་ཉིད་ལྷོད་ཡངས་གང་ལེགས་བྱེད་ཐུབ་པའི་ལས་ལ་འཇུག་དགོས།",
    "བསླབ་པ་སློབ་ལ་གཉེར་ནའང་རང་རྟོན་གྱིས་ཁེངས་དགོས།",
    "དེའི་ཕྱིར་ཊར་བེན་གྱིས་ཁོ་རང་ཉིད་ཀྱི་བསམ་པའི་འཆར་སྒོ་དེ་ཐོག་མཐའ་བར་གསུམ་དུ་རྒྱུན་བསྐྱངས་མེད་ཚེ་འཕེལ་འགྱུར་སྨྲ་བ་ཡང་འབྱུང་མི་སྲིད།",
    "ཁོ་རང་དང་ཐོག་ཚོང་བ་ཞིག་མིན་པར་དམག་མི་ཞིག་ཡིན།",
    "ཁོ་རང་མལ་ཁྲིའི་སྟེང་བསྡད་དེ་ཧུར་ཐག་སྒོས་བསམ་བློ་གཏོང་མགོ་ཚུགས།",
    "བློ་ཕམ་བྱུང་ཡང་ཁོ་རང་ཕྱུག་པོར་འགྱུར་འདོད་ཀྱི་བསམ་པ་དོར་མེད།",
    "ཁོ་རང་བཟོ་སྐྲུན་པ་ཞིག་བྱེད་འདོད་ཡོད་ལ་གནའ་གཞུང་རྩོམ་རིག་པ་ཞིག་ཀྱང་བྱེད་འདོད་ཡོད།",
    "རང་ཉིད་ཀྱི་འབད་པས་དོན་དག་རྗེས་མ་དེ་བསྒྲུབ་ཆོག་ཀྱང་ཤོར་ཟིན་པའི་དུས་ཚོད་ནི་སླར་ཡང་འཛིན་ཐབས་མི་འདུག་པས།",
    "སྐབས་དེར་ཁོ་རང་ཁོམ་ལོང་དང་བྲལ་ཡང་རྩོལ་བའི་ངར་ཤུགས་རབ་ཏུ་རྒྱས།",
    "ཅུང་འཕྱི་མི་འདུག་གམ།",
    "མི་དང་བྱ་བར་སྐྱོན་བརྗོད་མཐིལ་ཕྱིན་ཅིག་བྱེད་རྒྱུ་ནི་ཧ་ཅང་དཀའ་བའི་ལས་ཤིག་ཡིན་ཞིང་རང་ཉིད་ལ་སྐྱོན་བརྗོད་མཐིལ་ཕྱིན་ཅིག་བྱེད་རྒྱུ་ནི་དེ་བས་ཀྱང་དཀའ།",
    "བསམ་པ་དེས་གཉིད་འདོད་རྩ་བ་ནས་འཕྲོག་པས་ཁོ་རང་ཡར་ལངས་ནས་གང་སར་ཐ་མག་བཙལ།",
    "ཁོ་རང་འཕྲལ་དུ་མལ་ཁྲི་ལས་ཡར་ལངས་ནས་ཁུག་མའི་ནང་དང་ལྭ་བའི་གློ་ཁུག་ནང་མཚམས་མེད་དུ་བསྔོགས་ཏེ་ཐ་མག་རྐང་གཅིག་ཨེ་རྙེད་ཚོད་བགམ་བྱས།",
    "ཁོ་རང་ལ་ཐ་མག་རྔུབ་འདོད་ཀྱི་བསམ་པ་འགོག་མེད་ཅིག་སྐྱེས་པས་ཚེགས་དང་དཀའ་ལས་མ་བསམས་པར་ཆར་ལྷམ་གྱོན་ཞིང་ཆར་ལྭ་གཡོགས་ཏེ་ཁང་སྒོ་ཕྱེས།",
    "དེ་ནི་ཁོ་རང་ཉིད་བྲེལ་འཚུབ་སྐྱེས་དྲགས་པ་དང་སྐབས་ཤིག་རིང་དངངས་འཚབ་སྐྱེས་ནས་བཟོས་པའི་ནོར་འཁྲུལ་ཡིན།",
    "འཇིག་རྟེན་འདི་དེ་འདྲའི་རྙོག་འཛིང་ཆེ་ཞིང་རང་ཉིད་ལ་བློ་གདེང་སྟེར་ཐུབ་བྲལ་བ་ནི།",
    "ཐེངས་ཤིག་ཁོ་རང་ལ་མཚོན་ན་ཤིན་ཏུ་གལ་ཆེ་བའི་འགྲན་རྒྱུགས་ཤིག་ལ་ཞུགས།",
    "རྗེས་སུ་ཡུན་རིང་མ་འགོར་བར་ཁོ་རང་ཡང་བསྐྱར་རྒྱུགས་འགྲན་ཞིག་ལ་ཞུགས་ཏེ་ཨང་གཉིས་པ་བླངས།",
    "དེ་ཚོར་རྟག་པར་ཕུགས་འདུན་གང་མང་ཞིག་བྱུང་རྒྱལ་དུ་འབྱུང་སྲིད་ཀྱང་རང་ཉིད་ལ་འཛོམས་འོས་པའི་རྩལ་དང་ནུས་པ་མེད།",
    "མཐའ་མཇུག་ཁོ་རང་གཅིག་ལའང་མཐུན་པོ་མ་བྱུང་།",
    "གོ་སྐབས་མང་པོ་ནི་འདོར་ལེན་གྱི་སོམ་ཉིའི་ཁྲོད་ནས་འཆོར་གྱིན་གདའ།",
    "ཁོ་རང་བྱིས་པ་ཞིག་ཡིན་ཡང་།",
    "ལུག་འཚོ་དུས་ཁོ་རང་ཡང་རྗེས་སུ་འབྲངས་ཏེ་ཕྱིན་པ་ཡིན།",
    "ཁོ་རང་ལྡེམ་མྱུར་གྱིས་སེང་གེའི་རྒྱབ་ལ་ཞོན་ཏེ་གཡུ་རལ་ནས་བཟུང་ཞིང་མདའ་མཚོན་གོ་ཆ་གང་ཡང་མ་བཟུང་བར་ལག་སྟོང་མཆན་བཙིར་གྱིས་སེང་གེ་བསད་བྱུང་།",
    "ཁོ་རང་གནས་དེར་ཐོན་དུས་ཀི་སྒྲ་བསྒྲགས་ཤིང་གཡུལ་ཐོག་དགྲ་སྒུག་བྱེད་བཞིན་པ་མཐོང་།",
    "ང་རང་སྐྲག་མི་སྲིད་ཟེར།",
    "ཊེ་ཝེ་ཊེ་ཟའོ་རྒྱལ་པོའི་མདུན་དུ་ཐོན་དུས་རྒྱལ་པོས་ཁོ་རང་བྱིས་པ་ཞིག་ཡིན་པ་མཐོང་ནས་བཀག་འགོག་བྱེད་བསམ་ཡང་ཊེ་ཝེ་ཊེས་རང་ཉིད་ཀྱིས་ལག་སྟོང་མཚོན་མེད་ངང་སེང་གེ་བསད་པའི་གནས་ཚུལ་རྒྱལ་པོར་ཞིབ་བརྗོད་བྱས་པར་ཧཱི་མ་ཟད་འ་ས་སྐལ་གྱིས་ང་རང་སེང་གེ་དེ་ལས་རྒྱལ་དུ་བཅུག་ན་མི་ཆེན་དེ་ལའང་སྐྲག་དགོས་དོན་མེད་ཅེས་ཁས་ལེན་དམ་བཅའ་ཕུལ།",
    "མདུན་མི་ཆེན་གྱིས་ཁོ་རང་བྱིས་པ་ཞིག་ཡིན་པ་ཐོས་འཕྲལ་རྩ་བ་ནས་མིག་ནང་དུ་མ་བཞག་ཕྱོགས་ཀྱི་གཟུགས་སྟོབས་ཆེ་བའི་གྱད་མི་དེ་མཐོང་ནས་ཁོ་རང་ལ་སྐྲག་སྣང་རྩ་བ་ནས་མ་བྱུང་།",
    "ན་གཞོན་ཞིག་དཔའ་འཁུམ་ཞིང་རང་རྟོན་དང་བྲལ།",
    "དེ་ནས་ཁོ་རང་ཕྱོགས་བཞིར་མྱུལ་ཞིང་རྒྱས་སྤྲོས་བག་མེད་བྱས་ཏེ་སློབ་སྦྱོང་ཡང་བྱེད་མཚམས་བཞག་དེ་བཞིན།"
  ]
}