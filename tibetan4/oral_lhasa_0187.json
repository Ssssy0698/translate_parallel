    "དེས་ན་གང་ལས་འགལ་བ་ཉིད་ཡིན་ཞེ་ན་གསུངས་པ།",
    "དྷ་བ་ལ་སོགས་པ་རྣམས་དེ་སྔོན་མ་ཅན་ཉིད་དུ་བསྒྲུབ་པར་ནུས་པ་ཡང་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་འགལ་བ་ཉིད་ཡིན་པ་དེ་ལྟར་བརྗོད་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་རིགས་གཅིག་རྗེས་སུ་འགྲོ་བར་འདོད་པས་དེའི་རྒྱུ་དུ་མ་ཉིད་དུ་ཁས་བླང་པར་བྱའོ་ཞེས་པས་འགལ་བ་ཉིད་དུ་འགྱུར་རོ།",
    "ཁས་བླངས་ནས་ཀྱང་ཞེས་པ་གལ་ཏེ་ཡང་དུམ་བུ་ལ་སོགས་པ་རྣམས་གཅིག་ཉིད་ཀྱི་ཁྱད་པར་ཅན་དང་ཤིང་ལ་སོགས་པ་སྔ་མ་ཅན་ཉིད་ཡིན་པ་དེ་ལྟ་ན་ཡང་གཏན་ཚིགས་མ་ངེས་པ་སྟེ།",
    "དཔེ་ནི་བསྒྲུབ་བྱས་དམན་པ་ཞེས་པ།",
    "ཁྱད་པར་ལ་མི་སྙེགས་པ་ཡིན་ན་གྲུབ་པ་བསྒྲུབ་བྱ་ཉིད་ཁོ་ནར་འགྱུར་གྱི།",
    "དུམ་ཞོགས་ལ་སོགས་པ་རྣམས་ཁྱད་པར་ལས་ཕྱི་རོལ་དུ་གྱུར་པ་མ་ཡིན་པའི་ཕྱིར།",
    "ཁྱད་པར་རྣམས་ཐམས་ཅད་ཀྱང་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཀྱི་ཕྱིར་དཔེ་མེད་དོ།",
    "བསྒྲུབ་པར་བྱ་བ་ཁོ་ན་དཔེར་འཐད་པ་ནི་མ་ཡིན་པས་ཏེ།",
    "སྣ་ཚོགས་པའི་ངོ་བོའི་རྣམ་པར་ལྡན་པ་རྣམས་ལའོ།",
    "སྤྱིའི་མཚན་ཉིད་ཀྱི་ཡུལ་ཅན་མ་ཡིན་པའི་རྗེས་སུ་དཔག་པ་ཡོད་པ་མ་ཡིན་པས་སོ་ཞེས་པ་འདི་ལྟ་བུ་ལ་སོགས་པ་སྔར་གྱི་རྗེས་སུ་འབྲང་བས་གཏན་ཚིགས་དང་དཔེ་དང་ཉེ་བར་བསྡུ་བ་རྣམས་མ་འབྲེལ་བ་ཉིད་དུ་ཇི་ལྟར་རིགས་པར་བརྗོད་པར་བྱའོ།",
    "དེ་ལ་ཚད་ཅན་གྱི་རྣམ་པར་ལྡན་པས་ནི་ཁྱད་པར་རྣམས་རྒྱུ་གཅིག་འདྲེས་པ་སྔོན་མ་ཅན་ཉིད་དུ་བསྒྲུབ་པར་བྱ་སྟེ།",
    "རིགས་ནི་ཁྱད་པར་རྣམས་ལས་གཞན་མ་ཡིན་པ་ཉིད་དུ་ཁས་ལེན་པའི་ཕྱིར་དེ་དང་ལྡན་པ་མཐའ་ཡས་པའི་ཕྱིར་རོ།",
    "ནུས་པའི་འཇུག་པའི་རྣམ་པར་ལྡན་པས་ཁྱད་པར་རྣམས་ནུས་པ་གཅིག་སྔོན་མ་ཅན་ཉིད་དུ་སྒྲུབ་པར་བྱེད་དེ།",
    "འོ་ན་བརྗོད་པར་འདོད་པའི་ཁྱད་པར་ཅན་གྱི་སྤྱི་གྲུབ་པ་ཉིད་མ་ཡིན་ནམ་དེ་གྲུབ་པ་ན་ཁྱད་པར་རྣམ་པར་བརྟག་པས་མ་གྲུབ་པར་རྩོད་པ་ནི་ལྟག་ཆོད་ཀྱི་ལན་ཁོ་ནའོ་ཞེ་ན།",
    "འབྲས་བུ་དང་རྒྱུའི་དངོས་པོས་ཁྱད་པར་རྣམས་བྱེད་པ་པོ་གཅིག་སྔོན་མ་ཅན་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བ་ནི།",
    "འདི་ཡང་དེ་མ་ཐག་ཏུ་བརྗོད་པའི་ཚུལ་གྱིས་མ་གྲུབ་པ་ཉིད་དང་འགལ་བ་ཉིད་བརྗོད་པར་བྱའོ།",
    "སྣ་ཚོགས་པའི་ངོ་བོ་ཉིད་ཀྱི་རྣམ་པར་ལྡན་པས།",
    "ཁྱད་པར་རྣམས་རྒྱུ་གཅིག་པ་རྣམ་པར་དབྱེར་མེད་པ་སྔོན་མ་ཅན་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བ་ནི།",
    "ཇི་ལྟར་ཞོ་དང་སྤྲིས་མ་དང་དར་བ་ལ་སོགས་པ་སྣ་ཚོགས་པའི་ངོ་བོ་རྣམས་ནི་བྱེད་པ་པོ་འོ་མ་གཅིག་ལ་སྔར་མ་བྲལ་བར་གྱུར་པ་རྣམས་ཕྱིས་རྣམ་པར་དབྱེ་བར་འགྱུར་བ་སྟེ།",
    "གང་དུ་འདི་རྣམས་སྔར་རྣམ་པར་དབྱེ་བ་མེད་པར་གྱུར་པ་དེ་གཙོ་བོའོ་ཞེ་ལོ།",
    "སྔ་མའི་རྗེས་སུ་འབྲང་བས་བརྗོད་པར་བྱའོ།",
    "དེའི་ཕྱིར་ཡོངས་སུ་བའི་ལྷག་མ་ལས་འདི་ནི་གཏན་ཚིགས་ཁོ་ནའོ་ཞེས་ངེས་པར་གཟུང་བའི་འབྲས་བུ་གྲུབ་ན་ཡང་སྟོན་པ་དེའི་ཚེ་བསལ་ཏེ་འོངས་པ་ཞེས་པར་འགྱུར་རོ་ཞེས་སོ།",
    "ཅི་ལྟར་མཐོང་བ་མེད་ཅེ་ན་གསུངས་པ།",
    "དེ་ལས་ཀྱང་མི་རྟག་པ་ཉིད་འདུས་བྱས་ཀྱི་མཚན་ཉིད་དུ་མི་འགྱུར་ཏེ།",
    "འདུས་མ་བྱས་རྣམས་ལ་ཡང་ཡོད་པའི་ཕྱིར་རོ།",
    "གནས་སྐབས་དེ་ཡང་དངོས་པོའི་རྐྱེན་གྱིས་བརྗོད་པར་བྱའོ་ཞེས་པས་འགལ་བའོ།",
    "ཆུ་ཀླུང་ཁེངས་པ་ནི་ཆར་བབ་པ་སྔོན་མ་ཅན་ཉིད་གྲུབ་པ་མཐོང་ངོ་ཞེ་ན་གསུངས་པ།",
    "འོ་ན་ཅི་ཞེ་ན་ཁྱད་པར་ཅན་གྱི་ཆུ་ཀླུང་ཁེངས་པ་ལས་ཏེ།",
    "ཁ་བ་ཞུ་བ་ལ་སོགས་པ་བཀག་པས་ཏེ་དཀར་བ་ཉིད་ལ་སོགས་པ་མེད་པས་ཆུ་ཀླུང་ཁེངས་པ་ཁྱད་པར་དུ་བྱའོ།",
    "དེ་ནི་དེའི་ཁྱད་པར་ཅན་ཉིད་དུ་དགག་པས་ཉེ་བར་བསྟན་པར་བྱའོ་ཞེས་པ་འདི་ཙམ་ནི་དགག་པའི་ཉེ་བར་མཁོ་བའོ།",
    "ངེས་པར་གཟུང་བས་ནི་འདིར་དགག་པར་བྱ་སྟེ།",
    "དེ་ལྟར་ནི་གསུངས་པ།",
    "ཁས་བླངས་པ་ཉམས་པའི་ཚིག་དོན་མེད་པར་འགྱུར་ཏེ།",
    "སྐྱེ་གནས་མེད་པ་སྔོན་མ་ཅན་རྣམས་ཐ་དད་པར་དམིགས་ནས་ཏེ།",
    "དཔེར་ན་ནམ་མཁའ་ལ་སོགས་པ་རྟག་པ་རྣམས་མ་བྱས་པ་ཁོ་ནར་ཉེ་བར་དམིགས་ནས།",
    "གལ་ཏེ་སྒྲ་རྟག་པར་ཁས་ལེན་ན་མ་བྱས་པ་ཡང་འཐོབ་པོ་ཞེས་པ་དེ་བཞིན་དུ་འདིར་ཡང་སྐྱེ་གནས་མེད་པ་སྔོན་མ་ཅན་རྣམས་ཐ་དད་པར་ཉེ་བར་དམིགས་ནས།",
    "སྐྱེ་གནས་མེད་པ་སྔོན་མ་ཅན་ཉིད་དུ་ཁས་ལེན་ན་ཐ་དད་དེ་སྤྱི་མེད་པའི་ཁྱད་པར་ཙམ་འཐོབ་པོ་ཞེས་པའོ།",
    "ཇི་ལྟར་རྟག་པ་ནམ་མཁའ་ལ་སོགས་པ་རྣམས་ལ་བྱས་པ་ཉིད་མ་མཐོང་ནས།",
    "དེ་རྣམས་མ་བྱས་པར་འཐོབ་བོ་ཞེས་པ་དེ་ལྟར་འདིར་ཡང་སྐྱེ་གནས་སྔོན་མ་ཅན་མ་ཡིན་པ་རྣམས་རྗེས་སུ་འགྲོ་བ་སྟེ་རིགས་གཅིག་རྗེས་སུ་འབྲང་བར་མ་མཐོང་ནས།",
    "དེ་རྣམས་ཐ་དད་པར་འཐོབ་བོ་ཞེས་པའོ།",
    "འོ་ན་སྐྱེ་གནས་སྔོན་མ་ཅན་མ་ཡིན་པར་སྐྱེས་བུ་རྣམས་འདོད་དེ།",
    "ཞེས་པས་འདི་བརྩད་པར་བྱ་བ་མ་ཡིན་ནོ།",
