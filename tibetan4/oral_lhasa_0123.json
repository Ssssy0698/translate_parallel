    "དེ་ལ་ནི་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཆ་ལུགས་ཉམས་པར་འགྱུར་བ་སྐྲ་ཆན་པས་འདྲེགས་པ་ལ་སོགས་པ་དག་དང་།",
    "རྗེས་སུ་མ་གནང་བའི་ཕྱོགས་ཀྱི་སྤུ་འདྲེག་པ་ལ་སོགས་པ་དག་ནི་རྟགས་བླངས་པ་དེའི་ཕྱོགས་དང་མཐུན་པས་དེ་ལ་བསྡམ་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དེ་ལ་ནི་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཟངས་མ་ལ་སོགས་པའི་རྫས་གཞན་ལས་བྱས་པ་དང་།",
    "སྐྱ་བའི་ལྷུང་བཟེད་འཆང་བ་གང་ཡིན་པ་དེ་ནི་རྟགས་བླངས་པ་དེའི་ཕྱོགས་དང་མཐུན་པ་ཡིན་པས་དེ་ལ་ནི་བསྡམ་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དེ་ལ་ནི་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "བ་སོ་ལ་སོགས་པ་རྗེས་སུ་གནང་བ་མ་ཡིན་པའི་རྫས་གཞན་ལས་བྱས་པའི་ཁབ་རལ་ལ་སོགས་པ་བྱེད་པ་ནི་དེའི་ཕྱོགས་དང་མཐུན་པ་ཡིན་པས་དེ་ལ་ནི་བསྡམ་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དེ་ལ་དུས་མ་ཡིན་པར་ཟ་བ་དང་འབྲུའི་ཆང་དང་བཅོས་པའི་ཆང་མྱོས་པར་འགྱུར་བ་བག་མེད་པའི་གནས་འཐུང་བ་ཞུདེ་དག་སྤོང་བའི་བསླབ་པའི་གཞི་ཡང་དག་པར་བླངས་པ་ལས་འདས་པ་ཉིད་ཡིན་པས་དེ་ལ་ནི་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "སྒོག་སྐྱ་ལ་སོགས་པ་ཟ་བ་ནི་དེའི་ཕྱོགས་དང་མཐུན་པ་ཡིན་པས་དེ་ལ་ནི་བསྡམ་ཐུཔར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "བྱུག་པ་ཐོགས་པ་ལ་སོགས་པ་ནི་དེ་སྤོང་བའི་བསླབ་པའི་གཞི་ཡང་དག་པར་བླངས་པ་ལས་འདས་པ་ཉིད་ཡིན་པས་དེ་ལ་ནི་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "རྒོད་པ་ལ་སོགས་པ་ནི་དེའི་ཕྱོགས་དང་མཐུན་པ་ཡིན་པ་དེ་ལ་ནི་བསྡམ་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དེ་ལ་མི་ཚངས་པར་སྤྱོད་པ་ནི།",
    "བསམས་བཞིན་དུ་ཁུ་བ་འབྱིན་པ་ལ་སོགས་པ་ནི་དེའི་ཕྱོགས་དང་མཐུན་པ་ཡིན་པས་དེ་ལ་ནི་བསྡམ་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "འདི་ལྟར་ཁྱེམ་བྱེད་པ་ནི་ཁྱིམ་ནས་རབ་ཏུ་བྱུང་བ་ཡང་དག་པར་བླངས་པ་ལས་འདས་པ་ཡིན་པས་དེ་ལ་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་བ་ཡང་ཡོད་ལ།",
    "ཁ་ཅིག་དེའི་ཕྱོགས་དང་མཐུན་པ་ཡིན་པས་དེ་ལ་ནི་བསྡམ་པར་བྱ་བའི་ཉེས་བྱས་ཉྫུསུ་འགྱུར་བ་ཡང་ཡོད་དོ།",
    "དེ་ལ་མཚན་མི་མཐུན་པ་དང་ལྷན་ཅིག་ཉལ་བའི་བདག་ཉིད་ཀྱིས་གནས་པ་ནི་ཚངས་པར་སྤྱོད་པ་སྤོང་བའི་བསླབ་པའི་གཞི་ཡང་དག་པར་བླངས་པ་ལས་འདས་པ་ཉིད་ཡིན་པས་དེ་ལ་ནི་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "བསྙེན་པར་མ་རྫོགས་པ་ཁྱིམ་པ་དང་མུ་སྟེགས་ཅན་དང་ལྷན་ཅིག་གནས་པ་དང་།",
    "ལྷན་ཅིག་གནས་པ་དང་འདོད་ཆགས་དང་བྲལ་བའི་མི་མཐུན་པའི་ཕྱོགས་སུ་གྱུར་པ་སྡོམ་པ་ཐམས་ཅད་འཇིག་པའི་ཕྱོགས་དང་མཐུན་པ་ཡིན་པས་དེ་ལ་ནི་བསྡམ་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་གཞན་ལ་མ་གུས་པ་ལ་སོགས་པ་ནི་སྡོམ་པ་ཐམས་ཅད་འཇིག་པའི་ཕྱོགས་དང་མཐུན་པ་ཡིན་པས་དེ་ལ་ནི་བསྡམ་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དེ་ལ་གཞི་དེས་བབེེབ་པའི་གཞི་ཡང་དག་པར་བླངས་པ་འདྲལ་བར་བྱེད་པ་ནི་བབེེབ་པའི་གཞི་ཡང་དག་པར་བླངས་པ་ལས་འདས་པ་ཉིད་ཡིན་པས་དེ་ལ་ནི་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "གསོ་སྦྱོང་ལ་སོགས་པ་ལ་གཡེལ་བ་ནི་བསླབ་པའི་སྡོམ་པ་ཐམས་ཅད་འཇིག་པའི་ཕྱོགས་དང་མཐུན་པ་ཡིན་པས་དེ་ལ་ནི་བསྡམ་པར་བྱ་བའི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དེ་ལྟར་དེ་དག་ནི་བསྙེན་པར་མ་རྫོགས་ཤིང་རབ་ཏུ་བྱུང་བས་བསླབ་པ་བླངས་པ་དེའི་ཕྱོགས་དང་མཐུན་པ་ལས་འདས་ན་ཡིད་ཀྱི་ཉེས་བྱས་སུ་འགྱུར་བ་དག་ཡིན་ནོ།",
    "དེ་ལ་ཕྲ་མ་བྱས་ན་ཡང་དགེ་སློང་ལ་ཕྲ་མ་བྱས་པའི་ཐོང་བྱེད་དུ་མི་འགྱུར་བ་དང་།",
    "བདག་ཉིད་ཀྱིས་སོག་འཇོག་བྱས་པ་དང་།",
    "བསྦབ་པ་བྱིན་པས་སོག་འཇོག་བྱས་པ་དང་།",
    "བདག་ཉིད་ཀྱིས་སོག་འཇོག་བྱས་པ་དང་།",
    "དགེ་སློང་མས་སོག་འཇོག་བྱས་པ་དང་།",
    "དགེ་ཚུལ་དག་ལ་ཡང་དེ་བཞིན་དུ་ཅི་རིགས་པར་སྦྱར་རོ།",
    "ཚིག་ལྐུ་སྔ་མར་སྦྱོར་བ་ལས་ཧཱུཾ་ཡང་ངོ་ཞེས་བྱ་བ་ནི་ཚིག་ཁྱེསྔ་མར་སྦྱོར་བ་བྱས་པ་ལ་ཡང་སྦྱོར་བ་ཉིད་ན་སྨད་པ་ཉིད་དེ།",
    "དགེ་སློང་ཉིད་ཅེས་བྱ་བའི་ཚིག་ཕྱི་མ་དག་ཏུ་དངོས་གཞིའི་ཁ་ན་མ་ཐོ་བ་འགྲུབ་པར་འགྱུར་བའི་ཚིག་སྔ་མར་བྱས་པ་དེ་ནི་ན་སྨད་པ་ཉིད་དེ།",
    "ཕྱི་མ་ལ་ཡང་དེ་དང་ལྡན་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཚིག་ཕྱི་མར་བྱེར་བ་བྱས་པ་ལ་ཡང་ན་སྨད་པ་ཉིད་དེ།",
    "ཁྱེམ་པ་ཉིད་ཀྱི་ཚིག་དག་ཏུ་དངོས་གཞིའི་གནས་སྐབས་སུ་ནི་བསྙེན་པར་མ་རྫོགས་པ་གཉིས་ལ་ནི་ཉེས་བྱས་སོ།",
    "བསྙེན་པར་རྫོགས་པའི་སྦྱོར་བར་གྱུར་པ་ནི་སྦོམ་པོའོ།",
    "ལྷག་མ་རྣམས་ཀྱི་སྦྱོར་བར་གྱུར་པ་ལ་ནི་བསྙེན་པར་སྤུ་མ་རྫོགས་པ་གཉིས་ཀྱི་ནི་ཉེས་བྱས་སོ།",
    "བྱས་པ་ནི་དེ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་མཚན་མ་གྱུར་པ་ན་ཁ་ན་མ་ཐོ་བ་བྱས་པ་ནི་མཚན་གྱུར་པ་ན་ཡང་དེ་ཉིད་ཡིན་ཏེ།",
    "འདི་ལྟར་སྦོམ་པོར་འགྱུར་བའི་སྤྱོར་བ་ཉེས་བྱས་ཡིན་པའི་ཕྱིར་རོ།",
    "དགེ་སློང་མ་ལུས་བཀན་པའི་ཕམ་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ཉིད་བྱེད་བཞིན་དུ་དེ་མཚན་གྱུར་ཅིང་དགེ་སློང་དུ་གྱུར་ན་ལུས་བཀན་པ།",
    "དགེ་སློང་དེ་ལ་མི་ཚངས་པར་སྤྱོད་པར་གཏོགས་པའི་སྦོམ་པོར་འགྱུར་རོ།",
    "དགེ་སློང་མ་འཆབ་པའི་ཕམ་པར་འགྱུར་བ་དེ་གང་ཡིན་པ་དེ་ཉིད་བྱེད་བཞིན་དུ་དེ་མཚན་གྱུར་ཅིང་།",
    "ཞིང་མ་ཡིན་པ་ཉིད་ལ་ནི་ཉམས་སོ་ཞེས་བྱ་བ་ནི་མཚན་གྱུར་པ་ཞིང་མ་ཡིན་པ་ཉིད་ནི་བྱས་པ་ཉམས་ཏེ།",
    "དགེ་སློང་མ་ཉིད་དུ་འགྱུར་ན་དེས་སྤོ་བའི་ལས་ཉིད་སྤྱད་པར་བྱ་མི་དགོས་ཏེ།",
    "མཚན་གྱུར་ན་སྔར་མཚན་མ་གྱུར་པའི་གནས་སྐབས་སུ་ཉེས་པ་ལས་བྱུང་བའི་ཕྱིར་མགུ་བ་སྤྲུད་པར་ཞག་དྲུག་གམ་ཟླ་བ་ཕྱེད་རིལ་གྱིས་སྤྱད་ཀྱང་རུང་དེ་ལས་ཤས་ཀྱིས་པྱ་སྤྱད་ཀྱང་རུང་སྟེ།",
    "གང་གསད་པར་བརྣག་པ་དེར་འདུ་ཤེས་པས་བསད་པའི་དུས་ན་དངོས་གཞི་ལ་ཕམ་པ་ཁོ་ནར་འགྱུར་རོ།",
    "སྦྱོར་བ་ལ་ནི་མིའི་འགྲོ་བར་གཏོགས་པར་འདུ་ཤེས་ན་ནི་སྦོམ་པོའོ།",
    "མི་མ་ཡིན་པ་དང་དུད་འགྲོའི་འགྲོ་བར་གཏོགས་པར་འདུ་ཤེས་ན་ནི་ཉེས་བྱས་སོ།",
    "སྦྱོར་བ་ལ་ནི་མིའི་འགྲོ་བར་གཏོགས་པར་འདུ་ཤེས་ན་ནི་སྦོམ་པོའོ།",
    "མི་མ་ཡིན་པ་དང་དུད་འགྲོའི་འགྲོ་བར་གཏོགས་པར་འདུ་ཤེས་ན་ནི་ཉེས་བྱས་སོ།",
    "དུད་འགྲོའི་འགྲོ་བར་གཏོགས་པར་མི་དང་རྩི་མི་མ་ཡིན་པའི་འགྲོ་བ་གཞན་གྱི་ལུས་ཀྱི་རྣམ་པ་བསྟན་ཌཔ་ཞིག་གསོད་ན་དུད་འགྲོར་འདུ་ཤེས་པས་ཀྱང་རུང་།",
    "མི་མ་ཡིན་པ་དང་དུད་འགྲོའི་འགྲོ་བར་གཏོགས་པར་འདུ་ཤེས་ན་ནི་ཉེས་བྱས་སོ།",
    "འདིར་ལྷ་སྦྱིན་སྐྱེདུ་འདུ་ཤེས་པས་མཆོད་སྦྱིན་བསད་པ་ལ་ཕམ་པར་མི་འགྱུར་བ་ལྟ་བུར་གྱུར་ཏེ།",
    "དེ་གཉིས་ནི་རྒྱུད་ཐ་དད་པའི་ཕྱིར་ལྷ་སྦྱིན་དུ་འདུ་ཤེས་པས་མཆོད་སྦྱིན་གསད་པ་ལ་ཕམ་པར་མི་འགྱུར་བར་རིགས་སོ།",
    "འདིར་ཁུངས་ནི་ཨུ་ཏྲ་ཡ་ནའི་རྟོགས་པ་བརྗོད་པ་དྲན་པར་བྱ་སྟེ།་",
    "མ་བྱིན་པར་ལེན་པ་དང་།",
    "དེས་སྟན་གཞན་ཞིག་བྱེད་ཅིང་དེ་ཟིན་པར་བྱས་ནས་དེའི་འོག་ཏུ་དུས་མ་ཡིན་པ་ཁོ་ནར་སྔར་སྐྱོ་སྟན་བརྩམས་པ་དེ་ཡང་ཟིན་པར་བྱེད་ན་དེའི་ཚེ་རྩོམ་པ་དང་།",
    "ཟིན་པར་བྱེད་པའི་མཚན་ཉིད་སྔ་ཕྱིའི་ཆ་དེ་གཉིས་ཐོང་བ་ཐ་དད་པའི་བྱེད་པ་པོ་ཉིད་ཡིན་ཏེ།",
    "དེ་ལ་སྔར་མ་བབས་པའི་མདུན་རོལ་དུ་དུས་མ་ཡིན་པར་སྟན་གཞན་བརྩམས་པའི་ཆ་སྔ་མ་དེ་ནི་སྦྱོར་བ་ལས་བྱུང་བའི་ཉེས་བྱས་ཀྱི་བྱེད་པ་པོ་ཉིད་ཡིན་ནོ།",
    "ཕྱིས་བསྙེན་པར་རྫོགས་ནས་སྟན་གཞན་ཞིག་བྱེད་ཅིང་དེ་ཟིན་པར་བྱས་པ་དེ་ལ་ནི་ཉེས་པ་མེད་དོ།",
    "དཔེར་ན་ཁང་པའམ་སྟན་བརྩམས་ནས་བཏང་སྟེ་ཡང་བྱེད་ན་སྔར་བརྩམས་པ་དང་ཕྱིས་བྱས་ཟིན་པའི་གནས་སྐབས་དེ་གཉིས་སྤྱོར་བ་དང་།",
    "ཁ་ན་མ་ཐོ་བ་ཡང་ཕྱི་བ་མི་ཚངས་པར་སྤྱོད་པ་ལ་སོགས་པ་དེའི་ཆ་ཞེས་བྱ་བ་བཤན་ནམ་ལྷག་མ་ནི་དེ་དང་རིགས་མཐུན་པའི་ཁ་ན་མ་ཐོ་བ་ཡང་དེར་གཏོགས་ཏེ།",
    "རིགས་མི་མཐུན་པར་ཡང་མ་གཏོགས་ལ།",
    "མ་བསྐོས་པར་སྟོན་པ་ལ་སོགས་པ་བཅུ་དང་།",
    "དུས་མ་ཡིན་པར་གྲོང་དུ་འགྲོ་བ་དང་།",
    "དགེ་སློང་མ་ལས་ཟས་ལེན་པའི་སོ་སོར་བཤགས་པར་བྱ་བ་དང་།",
    "གྲལ་རིམས་སུ་མ་ཕེབས་པར་འདྲིམ་དུ་འཇུག་པ་མ་བཟློག་པར་ཟ་བའི་སོ་སོར་བཤགས་པར་བྱ་བ་དང་།",
    "ཤིན་ཏུ་བསྡམས་ཤིང་ཁྱེམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱ་ཞེས་བྱ་བ་ལ་སོགས་པ་དག་གོ།",
    "མ་བྱིན་པར་ལེན་པའི་ཆ་གང་ཞེ་ན།་",
    "ཕྱིར་མ་བླངས་པར་སྤྱོད་པ་དང་།",
    "སྔངས་པར་བྱེད་པ་དང་།",
    "ཕམ་པར་འགྱུར་བས་སྐུར་པ་འདེབས་པའི་ཆ་གང་ཞེ་ན།",
    "མི་ཚངས་པར་སྤྱོད་པའི་ཆ་ཁུ་བ་འབྱིན་པ་ལ་སོགས་པ་དེ་དག་ནི་མི་ཚངས་པར་སྤྱོད་པའི་ཁ་ན་མ་ཐོ་བ་ཕྱི་བ་དེ་དང་རིས་མཐུན་པའི་ཁ་ན་མ་ཐོ་བ་ཡང་བར་གཏོགས་པ་ཡིན་གྱི་འུརིས་མི་མཐུན་པར་གཏོགས་པ་མ་ཡིན་ལ།",
    "དེས་ན་ཁྱ་བ་འབྱིན་པ་ནི་མི་ཚངས་པར་སྤྱོད་པའི་ཆ་ཡིན་ལ།",
    "ཉེས་བྱས་སུ་མ་གཏོགས་པ་ལྟ་བུའོ།",
    "གཞན་ལ་ཡང་དེ་བཞིན་དུ་ཅི་རིགས་པར་སྦྱར་རོ།",
    "མགོ་བཅད་པའི་ཁ་ལ་སོགས་པ་དག་ཏུ་ཉམས་པར་བྱེད་པ་ནི་སྦོམ་པོར་འགྱུར་ལ།",
    "དཔེར་ན་མི་ཚངས་པར་སྤྱོད་པའི་ཕྱིར་ཁྲི་ལས་ལྡང་བ་དང་ཤམ་ཐབས་གྱོན་པ་ལ་སོགས་པ་མི་ཚངས་པར་སྤྱོད་པའི་སྤོམ་པོར་གྱུར་པ་ནུལྟ་བུའོ།་།",
    "མི་ཚངས་པར་སྤྱོད་པའམ།",
    "ཕམ་པར་འགྱུར་བའི་ཉེས་པ་སྤོམ་པོ་དང་།",
    "དཔེར་ན་ཉུང་ངུ་ཉུང་ངུར་བརྐུས་པ་གཅིག་ཏུ་བསྡོམས་པས་མ་ཤ་ཀ་ལྔ་ལ་སོགས་པའི་ཚད་དུ་ཆོག་པ་གང་ཡིན་པ་དེས་ཕམ་པར་མི་འགྱུར་བ་ལྟ་བུ་དང་།",
    "འཆག་ཏུ་བཅོལ་ན་ཉེས་བྱས་སུ་འགྱུར་བ་ལྟ་བུ་དང་།",
    "རྨེལ་དུ་བཅོལ་ན་ཉེས་བྱས་སུ་འགྱུར་བ་ལ་སོགས་པ་ལྟ་བུའོ།",
