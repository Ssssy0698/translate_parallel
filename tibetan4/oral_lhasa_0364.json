    "ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ་མན་ངག་ལས་ཤེས་པར་བྱའོ།",
    "ཁྱད་པར་དུ་ཡང་ཆང་ཉིད་དོ།",
    "ཁྱད་པར་དུ་ཡང་ཆང་ནི་བཏུང་བར་བྱ་བ་ཉིད་དོ།",
    "ཞེས་དེ་ཉིད་གསུངས་ཟིན་པའི་དོན་ཏོ།",
    "གོང་ཉིད་དུ་ཕྱག་རྒྱའི་ལམ་གསུངས་ཀྱང་།",
    "དེ་མ་ཐག་ཏུ་དེ་དག་སྟོན་པའི་ལེའུ་འདི་འཆད་པར་འབྲེལ་ལོ།",
    "ཞེས་རྗེས་སུ་གནང་བ་སྟེར་བའི་དོན་ཏོ།",
    "ཡབ་ཀྱི་རྡོ་རྗེ་དང་ཡུམ་གྱི་པདྨ་ཕན་ཚུན་བྱིན་གྱིས་རློབ་པར་བྱེད་པའི་སྔགས་ལ།",
    "དེས་རྩ་ཁྱད་པར་ཅན་ཕྲད་པས་གཉིས་ཀའི་བྱང་སེམས་འཆིང་བ་མཚོན།",
    "གཉིས་ཀའི་བུག་པ་ཕཊ་སེར་པོས་མཚན་པ་བསྐྱེད་པར་འཆད་དོ། གསུམ་པ་ལེའུའི་མཚན་བསྟན་པ་ནི།",
    "ཡང་དག་པའི་དོན་བརྟག་པར་བྱེད་པས་ན་བརྟག་པ་སྟེ།",
    "བརྟགས་པས་བརྟག་པ་ཡིན་པར་བཤད།",
    "དེ་ལྟར་སྡོམ་པར་བྱེད་པའི་རྒྱུད་ཐམས་ཅད་ཀྱི་གཙོ་བོར་གྱུར་པས་རྒྱུད་ཀྱི་རྒྱལ་པོ་ཆེན་པོ།",
    "ཞེས་དོན་མ་ཚང་བ་མེད་པར་རྟོགས་པའི་ཕྱིར་བརྗོད་པའོ།",
    "བོད་ཀྱི་ལོཙྪ་འབྲོག་མིའི་རིགས་ལས་འཁྲུངས་པ་དགེ་སློང་ཤཱཀྱ་ཡེ་ཤེས་གཉིས་ཀྱིས་སྒྲ་བསྒྱུར་ཅིང་ཞུས་དག་བྱས་ཏེ།",
    "སླར་འཆད་ཉན་གྱི་སྒོ་ནས་ཀྱང་ལེགས་པར་གཏན་ལ་ཕབ་པས་འགྱུར་ཁྱད་པར་དུ་འཕགས་པའོ།",
    "གཞུང་དོན་དཔྱོད་པའི་བློ་གྲོས་མ་རྙེད་པར།",
    "དེ་ལྟར་བྱས་འདི་མཁས་པའི་གྲགས་འདོད་དང་།",
    "རིང་པོར་མི་ཐོགས་མྱུར་དུ་ཐོབ་པར་ཤོག།",
    "འབྲུག་ལོ་ཟླ་བ་གསུམ་པ་ལ་རྒྱལ་བས་ལུང་བསྟན་པའི་གནས་གདན་ས་ཆེན་པོ་དཔལ་དྭགས་ལྷ་སྒམ་པོ་དང་།",
    "ཤེས་བྱ་མ་ལུས་ས་ལེར་མཁྱེན་པའི་ཐུགས།",
    "རྒྱུད་དོན་འབྱེད་པར་འདོད་རྣམས་བག་ཡོད་བྱོས།",
    "གླེགས་བམ་མང་དུ་སྤེལ་བའི་པར་གྱི་འཕྲུལ།",
    "རྒྱུ་སྦྱོར་དད་བརྩོན་ངལ་བ་ལྷུར་བྱས་ཀྱིས།",
    "དགེ་སྡིག་བླང་དོར་ཚུལ་བཞིན་སྒྲུབ་པར་ཤོག།",
    "ལྕི་བའི་དགའ་སྟོན་ཐོག་མར་ཐོབ་པར་གྱུར།",
    "རང་སྲས་འཕགས་བཞིས་ས་ཆེན་དོག་པོར་བྱས།",
    "བྱིན་གྱིས་བརླབས་དང་རྗེས་སུ་གནང་བ་སོགས།",
    "རྗོད་བྱེད་ཁྱད་པར་བཅུ་གཉིས་ཆ་ཤས་སུ།",
    "བུ་གའི་ཁྱད་པར་དེ་དེ་བཞིན་དུ་འཇུག།",
    "ཐབས་མཁས་དེ་ཡི་བློ་དང་འཚམས་པར་གསུངས།",
    "བསྒྲུབས་ཀྱང་འགྲུབ་པར་ནུས་མིན་ཟུང་འཇུག་སྐུ།",
    "རྟེན་དང་བརྟེན་པར་ཤར་བའི་སྒྱུ་འཕྲུལ་སྐུ།",
    "ཆེ་བའི་ཡོན་ཏན་རྗེས་སུ་བསྔགས་པར་འོས།",
    "ངེས་ལེགས་བདེ་བླག་སྟེར་བའི་ཁྱད་པར་ལྡན།",
    "ཚིག་ཙམ་བཟུང་བས་ཁོང་དུ་ཆུད་མིན་པར།",
    "སོ་སོར་རྟོགས་པས་འོས་པར་བྱ་བ་ཉིད།",
    "བསླངས་ནས་རྫོགས་བྱང་ཉིད་ལ་འགོད་པར་མཛད།",
    "སྡུག་ཀུན་ཀུན་ནས་སྤང་བའི་ཐབས་སུ་གསུངས།",
    "དེ་ལ་འཇུག་པར་བྱ་བ་ཐོག་མར་གཅེས།",
    "རྣམ་གྲོལ་མི་ཤེས་བཞིན་དུ་ཤེས་པར་བརླམས།",
    "སྨྲ་ངན་མུན་པར་འཇུག་སོགས་ཉི་མ་དང་།",
    "ཀུན་རྨོངས་དྲི་མ་འཁྲུད་པར་མི་བྱེད་གང་།",
    "བློ་དང་འཚམས་པར་རིམ་གྱིས་གྲུབ་པའི་མཐའ།",
    "ཞི་བའི་དགའ་སྟོན་དམ་པར་འགོད་པ་ཡི།",
    "ཀུན་མཁྱེན་སྣང་བ་ཀུན་ཀྱང་སྦྱིན་མིན་ནམ།",
    "ཀུན་མཁྱེན་མཁྱེན་བརྩེ་ཐོབ་ཐབས་ཐབས་གཅིག་ཏུ།",
    "ལེགས་གདམས་གདམས་པར་ཤར་ལུས་ལུས་ཅན་རྣམས།",
    "ས་གསུམ་མ་རིག་གཉིད་འཐུག་སངས་པར་མཛད།",
    "ཕང་པར་འགྲོ་རྣམས་ཐོག་མར་བཀྲི་བར་མཛད།",
    "ཇི་བཞིན་རྗེན་པར་གདམས་པའི་སྦས་དོན་དུ།",
    "གཅིག་ལས་དུ་མར་འཆར་བའི་པར་གྱི་འཕྲུལ།",
    "ལྷག་པར་སྙིགས་སྤྱོད་ངན་རྒྱའི་ལྡན་ལྗིན་ཁྲོད།",
    "སྔོན་མེད་པར་གྱི་འཕྲུལ་དུ་བལྟམས་པ་འདི།",
    "འཛད་མེད་པར་དུ་དུ་མའི་འཕྲུལ་སྦྱིན་གང་།",
    "འཆད་ཉན་གྲུ་གཟིངས་ལ་བརྟེན་ལེན་པར་བསྔགས།",
    "ཡངས་པའི་ཁྱིམ་འབྱོར་རྩྭ་ལྟར་དོར་བྱས་ནས།",
    "སྟོན་པར་ཁས་བླངས་ཙམ་གྱིས་བསྙེན་པར་རྫོགས།",
    "འོད་སྲུངས་འདི་ནི་ཤིན་ཏུ་ཁྱད་པར་འཕགས།",
    "འགོད་པར་ནུས་མིན་གནས་བརྟན་ཀུན་དགའ་བོ།",
    "སྲོག་ཆགས་འབུམ་ཕྲག་དུ་མ་འདུས་པར་ནི།",
    "དཀྱིལ་འཁོར་གཅིག་ཏུ་བསྡུས་པར་གསུང་དབྱངས་ཀྱི།",
    "མ་སྐྱེས་དགྲ་ཡང་བསྟན་ལ་ལྷག་པར་དུ།",
    "མཆོད་ཅིང་བཀུར་བའི་བྱ་བ་བྱས་པ་ཡིས།",
    "ངོ་མཚར་མཛད་པའི་ཁྱད་པར་བརྗོད་དུ་མེད།",
    "མཚན་བཟང་ནོར་བུའི་རྒྱན་གྱིས་སྤྲས་མིན་པར།",
    "ཁྱད་པར་ཀུན་མཁྱེན་ཡེ་ཤེས་སྤྱོད་ཡུལ་ཉིད།",
    "རྒྱལ་དང་མཉམ་པ་ཉིད་དུ་སྒྲོན་པར་བྱེད།",
    "སྲིད་གསུམ་མུན་པའི་ཁུང་བུར་འཐུམ་པར་འགྱུར།",
    "བརྗོད་འདོད་སྦྲང་བུའི་འཕུལ་ལྡིང་འདི་བྱས་སོ།",
    "བརྙེས་ནས་ལྗོངས་འདིར་ཡང་ཡང་འབྱོན་པར་གྲགས།",
    "འཚེ་བ་མེད་པར་ལྡོག་པའི་ཆོ་འཕྲུལ་མཚར།",
    "མཁྱེན་བརྩེའི་འོད་ཆགས་གཅིག་ཏུ་འདྲེས་པ་ཡིས།",
    "ངོ་མཚར་བདུན་གྱིས་ཆེ་བའི་རྣམ་པར་ཐར།",
    "ཁྱད་པར་རླབས་ཆེན་སྤྱོད་ལ་འཇུག་པའི་དབྱངས།",
    "མཁའ་དང་མཁྱེན་པ་ཕ་མཐའ་འགྲན་པ་བཞིན།",
    "ཁྲོ་གཉེར་རྣམ་པར་འཚེ་བའི་ཆུ་འཁྲེགས་དགྲས།",
    "ཀུན་ཁྱབ་ཕ་མཐའ་མཉམ་པའི་མཁྱེན་པའི་མཛོད།",
    "སྤེལ་བ་གཅེན་གྱི་དུས་ལས་ལྷག་པར་གྲགས།",
    "མཁྱེན་པའི་བ་གམ་གཅིག་ལས་སྤྲོས་པ་ཡིས།",
    "མཁས་ཤིང་གྲུབ་པའི་ས་ལ་གཤེགས་པར་མཚུངས།",
    "ཁྲི་སྲོང་ལྡེའུ་བཙན་བྱོན་པར་སྐུ་ཚེ་ནི།",
    "བརྒྱ་ཕྲག་དགུ་བར་བྱིན་གྱིས་བརླབས་ཏེ་བཞུགས།",
    "ལུང་རྟོགས་སྒྲོན་མེ་འཛིན་པར་མི་ནུས་པས།",
    "ཐོ་རི་གཉན་བཙན་ཕྱག་ཆར་མཛེས་པར་གྱུར།",
    "སྐལ་བཟང་གངས་ཅན་པ་ལ་ལྷག་པར་བྱིན།",
    "ལོག་པར་འཁུ་བའི་སྦྱིན་སྐྱེས་ས་འོག་བཅིངསབཀའ་ལུང་གསེར་གྱི་མེ་ཏོག་མཐའ་བཞི་ཡི།",
    "ཁྲི་སྲོང་ལྡེའུ་བཙན་ཞེས་བྱའི་རྣམ་པར་རོལ།",
    "ཆུ་ཁུར་ཨརྫ་ནག་པོར་བརྩེགས་བྱས་ཏེ།",
    "བོད་འབངས་བུ་བཞིན་བསྐྱངས་པར་མཛད་པ་ཡི།",
    "གསེར་ཞུན་ཕྲོག་ཞུ་མཛེས་པར་བཅིངས་པ་ཡི།",
    "སྲེག་ཟས་སྐད་ཅིག་རྨེག་མེད་བྱས་འདི་ཅི།",
    "མེ་རྒྱུན་བསྙིལ་བའི་ཐབས་སུ་ལྷག་པར་བྱིན།",
    "རིགས་ཀྱི་ཁྱད་པར་དཔག་བསམ་ཕལ་བའི་ལྗོན།",
    "དུས་ཀྱི་ཆུ་ལྷའི་ཕང་པར་རབ་སྦས་ཏེ།",
    "སླར་ཡང་བསྐལ་བཟང་ཤར་རིའི་ཕྲག་པར་ངོམ།",
    "ལྷག་བསམ་བ་དན་བསྐྱོད་པའི་མཁྱེན་རབ་གཟིངས།",
    "སྤྱོད་པས་རྒྱལ་བསྟན་པད་མཚོ་བརྟོག་བྱས་པ།",
    "ལེགས་གསུང་གདམས་པར་འཁྱེར་བའི་དཔལ་གྱི་གོས།",
    "དོགས་པ་མེད་པར་བཅུག་ཀྱང་མི་ངོམས་པར།"
  ]
}