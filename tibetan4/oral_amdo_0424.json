    "དེ་ལས་ལོག་པའི་གང་ཟག་སྣོད་དང་མི་ལྡན་པ་དགི་སྤང་བར་བྱ་སྟེ།",
    "སྔོན་འགྲོ་དངོས་གཞིས་རྗེས་ཀྱི་བྱ་བ་གསུམ་མོ།",
    "འབུམ་ལས་སྟོན་པ་གཤེན་རབ་མི་བོ་ནི་གསས་མཁར་རི་རབ་དཔེ་བཞག་གི་ནང་ན།",
    "ཚུལ་ནི་མི་དམིགས་པའི་ཤེས་རབ་རྣམ་པར་དག་པས་བསྔོ་ཞིང་ཡུལ་ནི་རང་གཅིག་པུའི་དོན་མ་ཡིན་གྱིས་འགྲོ་བ་མཐའ་དག་གི་དོན་དུ་བསྔོ་བ་སྟེ།",
    "ཡིད་མ་དག་པས་འདིར་བསམ་པ་མི་འགྲུབ་ཅིང་གཞུང་གི་བརྗོད་བྱ་མི་རྟོགས་པ་ལ་སོགས་སུ་གྱུར་ནས།",
    "ཕྱི་མར་ཡང་གླེན་ཞིང་རྨུག་པ་ལ་སོགས་སུ་གྱུར་ནས་མཐར་བྱོལ་སོང་གི་གླིང་དུ་སྐྱེ་བར་འགྱུར་བ་སྟེ།",
    "དེས་ན་བརྗོད་བྱ་དོན་གྱི་གནས་ལུགས་རྟོགས་པར་བྱེད་པ་ལ་བརྗོད་བྱེད་ཚིག་གི་གནས་ལུགས་ལ་བརྟེན་དགོས་པ་སྟེ།",
    "ལུང་དྲུག་ལས་ཐ་སྙད་ཚིག་གིས་དེ་དོན་སྟོན།",
    "ངེས་དོན་གསལ་བར་ཐིག་བཏབ་ན་ས་ཉམས་མྱོང་ཡིད་ཆེས་པར་བྱེད་པ་ནི་མན་ངག་གི་ལས་སོ།",
    "རྟོགས་ཚད་ཐ་དད་ཐེག་སྒོ་བྱེ་བྲག་གི་ལུང་ངོ།",
    "ཉུང་ལ་འདུས་པ་བསྡུས་པ་ངོ་སྤྲོད་ཀྱི་སྐོར་དང་དམར་ལ་འདྲིལ་བ་ལུང་དོན་འབྲིང་པོ་སོར་བཞག་གི་སྐོར་རོ།",
    "༧ སྙན་རྒྱུད་ལྡེ་དམིག་གི་སྐོར་ལ།",
    "དེ་ནས་ཡང་ལས་དང་༧ ཉོན་མོངས་ཀྱི་ཆོ་འཕྲུལ་བག་ལ་ཉལ་བ་རྣམས་ཚར་བཅད་པའི་དོན་དུ་ཀུན་ཏུ་བཟང་པོ་ཉིད་ཐུགས་ཞི་བའི་ངང་ལས་མ་གཡོས་ཀྱང་སྐུ་འབར་བའི་ཁྲོ་བོ་དབལ་གསས་རྔམ་པར་སྤྲུལ་ཏེ་བར་ཆོད་ཐམས་ཅད་བཟློག་པའི་དོན་དུ་མཛད་དོ།",
    "འོ་ན་འདི་མ་ཡིན་པ་གཞན་གྱིས་ཀྱང་བཟློག་མོད་དམ་སྙམ་ན་མ་ཡིན་ཏེ།",
    "ཀུན་རྫོབ་བདེན་སྟོང་སྒྱུ་མ་ལྟ་བུར་བཞེད་མོད་ཀྱིས།",
    "ལྷ་དང་གཞལ་ཡས་ལྷ་དང་ལྷ་མོའི་རང་བཞིན་སྣང་ལ་རང་བཞིན་མེད་པ་གསལ་ལ་རྟོག་པ་མེད་པ་གཞའ་ཚོན་ནམ་ཆུ་ཟླའི་དཀྱིལ་འཁོར་ལྟ་བུ་རོལ་པ་རང་ཤར་འགག་མེད་ཀྱི་རྩལ་དུ་ལྟ་བ་ཡིན་ཏེ།",
    "ཞི་རྒྱུད་ལས་ཐམས་ཅད་ལྷ་དང་ལྷ་མོའི་སྣང་བ་ཤ་སྟག་ཏུ་འགྱུར་ཏེ་སྣང་བས་ཁྱབ་པར་འགྱུར་ཅེས་དང་།",
    "འདི་ལྟར་གྱི་སྣང་བ་ཐམས་ཅད་ཀུན་རྫོབ་ཏུ་ལྷ་དང་ལྷ་མོའི་རང་བཞིན་ལས་དོན་དམ་པར་ཀུན་ཏུ་བཟང་པོ་བདེ་བ་ཆེན་པོ་དེ་ཁོ་ན་ཉིད་དོ་ཞེས་གསུངས་སོ།",
    "དང་པོ་ལ་ཕྱི་སྣོད་ལྷ་ཡི་གཞལ་ཡས་ནང་བཅུད་ལྷ་དང་ལྷ་མོར་གསལ་བ་དང་།",
    "ཟབ་མོའི་དགོངས་པས་ལྷ་མོར་བསྒྱུར་ཅེས་གསུངས་སོ།",
    "གཉིས་པ་ལ་ཐབས་ཀྱི་ལམ་དང་གྲོལ་བའི་ལམ་དང་ཟུང་འཇུག་གི་ལམ་མོ།",
    "གཞུང་གི་དོན་དང་།",
    "དང་པོ་ལ་ཕྱག་གི་ཡུལ་དང་ཡུལ་དེ་ཡོན་ཏན་དུ་དང་ལྡན་པ་དང་།",
    "གཉིས་པ་ནི་ཡུལ་དེ་དག་ཡོན་ཏན་གྱི་ཕུང་པོར་གནས་པས་སྐྱེ་བོས་བརྗོད་པར་མི་ནུས་མོད་ཀྱིས་འོན་ཀྱང་ཕྱོགས་ཙམ་བསྡུས་ན་ཐུགས་རྗེ་ཆེ་བ་ཐབས་མཁས་པ་མཁྱེན་པ་གསུམ་དུ་འདུས་སྟེ།",
    "མོས་པ་ཏིང་འཛིན་གྱི་དང་།",
    "གསུམ་པ་ནི་གང་གིས་བཙལ་ན་ཀུ་བྱི་མང་ཀེ་ལ་སོགས་འོག་མ་རྣམ་ཀྱིས་འཚལ་ལ།",
    "གོང་མའི་སྐྱབས་འོག་ཏུ་ཆུད་པས་ཕྱི་ནངགི་བར་ཆོད་ཞི་བ་དང་།",
    "མོས་པས་བག་ཆགས་སྒྲིབ་པ་བྱང་ནས་དེའི་དོན་ཐོབ་པ་དང་།",
    "སྐྱེ་འགག་མེད་པས་ཟབ་མོ་གནས་ལུགས་ཀྱི་དོན་རྟོགསནས་སྐྱེ་མེད་ཀྱི་བརྩན་ས་ཟིན་པའི་དགོས་པ་ཡོད་དོ།",
    "བསྡུས་དོན་དགོས་དོན་ཚིག་གི་དོན་ནོ།",
    "ད་པེ་དོན་ལ་བཏགས་པ་ལ་སོགས་མང་དུ་ཡོད་མོད་ཀྱིས་འདིར་ནི་བྱེད་པའི་ལས་ལ་བཏགས་ཏེ་ཀུན་བཟང་གིས་ཏིང་ངེ་འཛིན་གྱིས་གསུང་ནས་བར་ཆོད་བཟློག་ལ།",
    "བདག་གཅིག་དེ་བྱུང་གི་འབྲེལ་པ་གང་ཡང་མེད་མོད་ཀྱིས་གནས་སྐབས་ཀྱི་འབྲེལ་པ་བརྗོད་བྱ་བྱེད་བཅུ་གསུམཔའི་ལས་ཀྱིས་བརྗོད་བྱེད་སྟོན་བྱེད་ཀྱི་གཞུང་ལ་བཏགས་པས་བརྗོད་བྱ་བརྗོད་བྱེད་ཀྱི་འབྲེལ་པ་ཡོད་དོ།",
    "གསུམ་པ་ཚིག་ལ་ཉེ་ལོ་ཏིང་ངེ་འཛིན་གྱི་གྱེར་བོན་སྤུངས་སྟོན་པ་ཀུན་ཏུ་བཟང་པོའི་སྐུ་ཏིང་འཛིན་གྱིས་གསུངས་པ་དེ་ལམ་པས་བསྐྱེད་རྫོགས་ཟུང་འཇུག་ཏིང་ངེ་འཛིན་རྒྱུད་ལ་བརྟེན་པས་ཕྱི་ལས་ཀྱི་བར་ཆད་ནང་རྣམ་རྟོག་གི་བར་ཆོད་གསང་བ་མ་རིག་པའི་བར་ཆོད་བཟློག་ནས་ལམ་རྒྱུད་ལ་སྐྱེད་པས་ན་བསྟན་ཅེས་བྱའོ།",
    "ནེ་སུམ་སད་ནེ་གྱེར་ཅིས་པ་འདིས་སྟོན་པ་གང་གིས་མཛད་པ་སྟོན་ཏེ།",
    "ནང་ཉོན་མོངས་པའི་རྣམ་རྟོག་གསང་བ་མ་རིག་པའི་བདུད་བཟློག་པའི་དོན་དུ་མཛད་དོ།",
    "ཅེས་བརྗོད་ལ་དཔོན་གསས་ཀྱི་ཐུགས་ལས་འོད་ཟེར་འཕྲོས་པས་གྲོགས་ཀྱི་ཕུང་པོ་ཁམས་དང་སྐྱེ་མཆེད་ལྷ་དང་ལྷ་མོར་བྱིན་གྱིས་རླབ་བོ།",
    "དེ་ནས་ཕྱི་ནང་གི་བཤགས་པ་བྱ་ཞིང་བར་ཆོད་བསྲུང་བའི་ཕྲིན་ལས་བཅོལ།",
    "ར་དམར་འོད་ཟེར་ཐིག་གིས་སྟོང་གསུམ་ཁྱབ་པར་བསམ་ལ་གདབ་སྟེ།",
    "གདུང་ཐིག་ནང་ངོས་ཚོན་རེ་གཅལ་ལ་རིམ་པ་གསུམ་དུ་བསྐོར་རོ།",
    "དེའི་ཕྱི་རིམ་མཁའ་ཡི་ཡ་༢ གད་ཐོན་ཁ་ལ་སྟག་གཡག་འབྲུག་ཁྱུང་གི་ཡ་གད་གདེངས་པར་བྲི།",
    "དེའི་ཕྱི་རིམ་དབངགི་ཁྲག་མཚོ་དམར་ནག་མ་ཛ་བྷོ་ཉེར་བདུན་ཧ་བཅུ་ཞ་བཞི་དགོད།",
    "སྒོ་བཞི་ལ་ལྕགས་སྒྲོག་གླང་རེ་ཞགས་པ་ལྕགས་ཀྱི་དགོད།",
    "ཁ་གཅིག་གིས་སོ་ཐར་གྱི་སྡོམ་པ་འབོག་གསུང་སྟེ་གསང་སྔགས་ཀྱི་རྟེན་དུ་སོ་ཐར་གྱི་མི་དགོས་མོད་ཀྱིས་འོན་ཀྱང་སྐབས་དང་སྦྱར་བར་བྱའོ།",
    "ཡེ་ཤེས་རོལ་པའི་དབལ་གྱིས་ཉོན་མོངས་ཀྱི་མཚན་མ་སྲེག་པ་དང་།",
    "རྣམ་པར་མི་རྟོག་པའི་དབལ་གྱིས་རྣམ་རྟོག་གི་བག་ཆགས་སྲེག་པ་དང་།",
    "ཡེ་ཤེས་ནི་ཐུགས་ཉིད་ཡེ་ཤེས་ཆེན་པོ་ཁྱབ་གདལ་དུ་གནས་པ་ལ་ཉོན་མོངས་པའི་སྐྱོན་གྱིས་མ་གོས་པ་ཡིན་ལ།",
    "དབལ་མེ་ལ་རེག་པས་མེ་ལྕེས་བསྲེགས་པ་དང་།",
    "དེ་དག་གི་ནང་དུ་འདས་ན་ཐལ་བ་ཙམ་དུ་བརླག་ཅིང་རྡུལ་ཕྲན་ཙམ་དུ་མི་གནས་པར་བྱེད་པས་ན་དེ་དག་གི་ཁོངས་སུ་མ་འདའ་གཅིག་ཅེས་བྱ་ལ།",
    "ཨ་དཀར་ཅེས་པས་བདག་གི་ཐུགས་ལས་ཨ་དཀར་པོ་གཅིག་མདུན་གྱི་བར་སྣང་ལ་འཕྲོས་ས་ལེ་འོད་ཅེས་བརྗོད་པས་ཨ་དེ་ལས་ཨ་ཕྲ་མོ་གྲངས་མེད་པ་འཕྲོས་པས་ཕྱི་ནང་གི་གདོས་པ་དང་སྒྲིབ་པ་སྦྱངས་ཕྱི་སྣོད་ལྷ་ཡི་གཞལ་ཡས་དང་ནང་བཅུད་ལྷ་དང་ལྷ་མོར་གྱུར་ཏེ།",
    "ཞེས་པས་བདག་གི་སྤྱི་གཙུག་ཏུ་ཨ་དཀར་པོ།",
    "ཞེས་བརྗོད་པས་བདག་གི་ཐུགས་ཀ་ནས་གསལ་བ་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་གྲངས་མེད་པ་བོན་ཉིད་ཀྱི་དབྱིངས་སུ་འཕྲོས་པས་ཡེ་ཤེས་ཀྱི་ཆོ་འཕྲུལ་དུ་ཨ་མ་ཟུང་གཅིག་མདུན་གྱི་བར་སྣང་ལ་ཤར་བར་བསམ།",
    "ཨམ་པུར་པ་འདུ་བརྗོད་པས་འོད་ཟེར་ཚུར་འདུས་ཨ་མ་ལ་ཐིམ་དེ་རང་གི་ཐུགས་ཀར་འདུས་ཏེ་འོད་དུ་ཞུ་བ་ལས་ཨ་ལས་རང་གི་ཀུན་གཞིའི་གསལ་ཆ་ལ་དབལ་གསས་རྔམ་པ་དང་མ་ལས་ཀུན་གཞིའི་སྟོང་ཆ་ལ་རྔམམོ་ཡུམ་ཆེན་དུ་བསྐྱེད་དོ།",
    "སྒོ་བཞིར་ཛ་ལ་རྒྱལ་མོ་བཞི་དང་།",
    "ཨུ་ཛ་བྷོ་ཉེར་བདུན་ལ་དབལ་མོ་ཉེར་བདུན་གཙོ་འཁོར་རྗེ་འབངས་ཀྱི་ཚུལ་དུ་བསྐྱེད།",
    "དེ་ཡང་ཐུགས་ཀ་ཤེ་ཐུན་དབུས་མཐིང་གི་རྩ་ལ་དབལ་གསས་ཡབ་ཡུམ་བསྐྱེད།",
    "སད་ས་ལེ་ལྷན་ནེ་འདུ་བརྗོད་པས་ཕྱི་ནང་གི་བཅུད་དང་དུག་ལྔ་ལ་སོགས་བསྡུས་དཔའ་བོ་འབྲུ་ལྔ་ལ་ཐིམ་སྟེ་འོད་དུ་ཞུ་བས་སེང་གླང་རྟ་འབྲུག་ཁྱུང་དུ་གྱུར་པར་བསམ་མོ།",
    "གཉིས་ཐཔ་ནི་བདུད་རྩི་རྒྱུན་སྦྲེང་གི་ཕྱག་རྒྱ་བཅས་ལ་བདག་གི་ཐུགས་ཁ་ནས་ཨ་མ་ཟུང་གཅིག་ཕྱག་མཐིལ་གཡས་གཡོན་དུ་འཕྲོས།",
    "ཨ་མ་ས་ལེ་སང་ངེ་ཉི་རི་བྷ་ར་ཏྲང་བརྗོད་པས་དབལ་གསས་ཡབ་ཡུམ་གྱི་སྐུར་གྱུར།",
    "ཨ་མ་ཨ་ཨོཾ་ཧཱུྃ་གཡུ་འབྲང་བདུད་རྩིར་བསོ་ཐ།",
    "བསོ་ཨོ་བ་བ་དེ་ན་ར་ས་ཡ་ན་གཡུ་འབྲང་བདུད་རྩིར་ཨ་མ་ཨོཾ་ཧཱུྃ་བསོ་ཐ།",
    "གསུམ་པ་ལ་ཨ་ཨོཾ་ཧཱུྃ་བརྗོད་པས་ལྷཡབ་ཡུམ་གྱི་ཐུགས་ཁ་ནས་ཨ་མ་ཟུང་གཅིག་བླངས་ཏེ་བདུད་རྩིའི་རྒྱ་མཚོར་བབས་ཏེ་ཨ་དང་མ་ཡིས་གཡས་ནས་གཡོན་དུ་བསྐོར་ཞིང་སྦྱངས་པས་དྭངས་སྙིག་རྩིགསམ་གསུམ་དུ་གྱུར་ཏེ།",
    "རཱ་ཨ་ཨོ་ཧཱུྃ་བརྗོད་པས་བདག་གི་ཐུགས་ལས་རྭ་རེ་རེ་འཕྲོས་པས་རྣམ་བརྒྱུད་ར་རུ་གྱུར་པ་དེ་ལས་འོད་ཟེར་འཕྲོས་པས་ཕྱི་ནང་གི་ཡུལ་ཤེས་གཟུགས་འཛིན་། རྣམས་བསྡུས་ནས་ར་ལ་ཐིམ།",
    "ཟུར་ནམ་དེ་ཤོ་ཧ་ར་སད་བསྭཱ་ཐ་བརྗོད་པས་དྭངས་མ་ལྷ་མོ་ཁུ་བ་བདུད་རྩི་རྩིགས་མ་འདོད་པའི་ཡོན་ཏན་སྣ་ཚོགས་སུ་གྱུར་པར་བྱིན་གྱིས་བརླབ་བོ།",
    "འདུས་ཨོ་དུ་གྱུར་བདག་གི་ཐུགས་ཀར་འདུས་པར་བསམ་མོ།",
    "དང་པོ་ལ་གཞལ་ཡས་སྐྱེད་པ་ལ་ཚིག་གིས་གསལ་གདབ་སྟེ།",
    "ཨ་མུ་ཡེ་ནམ་མཁའ་སྟེ་བདག་གི་ཐུགས་ལས་འོད་དཀར་པོའི་བཅུད་ལས་ཨ་དཀར་པོར་གྱུར་ཏེ་དཀྱིལ་འཁོར་གྱི་འོག་ཏུ་བབས་ཨམུ་ཡེ་ཨ་དཀར་ཨ་ནི་ཨ་བརྗོད་པས་ནམ་མཁའི་དཀྱིལ་འཁོར་ཁ་ག་ཏིང་དཔག་ཏུ་མེད་པར་བསྐྱེད་དོ།",
    "ཕྱི་རིམ་ཟངས་རི་ལྕགས་རི་ལ་སྐྱིན་འདང་རྨ་འདང་གི་མེ་ཆུ་འཁྲིགས་པ།",
    "དྲེགས་པ་སྟེ་ལྷ་ཡི་བུའི་བདུད་ཐུལ་བའི་རྟགས་སུ་ལྷ་བདུད་ཕོ་མོའི་གདན་དང་།",
    "བྱང་དུ་རྟ་དང་ཉོན་མོངས་ཀྱི་བདུད་གནོད་སྦྱིན་དང་།",
    "ལྷོ་ཤར་ཁྱུང་དང་འཆི་བདག་གི་བདུད་ག་ཤིན་རྗེ་ཕོ་མོ་བསྐྱེད།",
    "ཨུ་དུག་སེང་གེ་ལ་སོགས་ཉོན་མོངས་རྣམས་ལ།",
    "བསྭཱ་ཨཱི་ཨ་ཐུན་ཉེ་ལོ་ཡོ་༧ སྤུངས་སོ་ཐད་དོཨ་མ་མ་ཧ་ལ་རམ་ཛ་སད་དོ་ཐུན་འདུ་བརྗོད་པས་ལྷ་རྣམས་འོད་དུ་ཞུ་སྟེ་བསྐྱེད་པ་རྣམས་ལ་ཐིམ་པས་གཉིས་མེད་ལས་ཀྱི་སེམས་པར་བསམ་མོ།",
    "འདིར་ཀྱང་ཕྱི་ལས་ཀྱི་དགྲ་བགེགས་ནང་རྣམ་རྟོག་གི་བར་ཆོད་གསང་བ་མ་རིག་པའི་བདུད་དུས་ཀྱི་སྐལ་པ་ཆེན་པོའི་མེ་དཔུང་གིས་བསམ་གཏན་དང་པོའི་གནས་མན་ཆད་བསྲེག་པར་འབར་བ་ལྟར།",
    "གསང་བའི་མགྲིན་པའི་གནས་ལས་འབྲུག་གི་ང་རོ་ལྟར་ཟིལ་གྱིས་གནོན་པའི་སྒྲ་སྒྲོགས་ཅེས་བྱའོ།",
    "ནམ་མཁའ་ནི་ཕྱི་ནང་གི་སྣང་སྲིད་བྱུང་གནས་ཐིམ་གསུམ་གྱི་འཛིན་ལ་དེ་ཡང་སེམས་ཉིད་སྐྱེ་མེད་ཀྱི་དབྱིངས་ནས་སྐུ་དང་ཡེ་ཤེས་སྣ་ཚོགས་ཀྱི་མཛོད་འཛིན་པ་སྟེ།",
    "དངོས་པོའི་མཚན་མསྟོང་ཞིང་བོན་དང་གང་ཟག་གི་བདག་མེད་པའི་དོན་རང་རིག་པའི་ཡེ་ཤེས་ཉག་གཅིག་གི་རྟོགས་པས་རྣམ་རྟོག་གི་གྱོང་ཁེངས་འབུགས་པས་རྣོན་པོའི་ཐུགས་དང་།་",
    "སྔར་གྱི་ལྷ་ཚོགས་དེ་རྣམས་བདག་བསྒྲུབ་པ་པོ་ལ་གཟིགས་ལ་ཐུགས་རྗེས་དགོངས་ཤིག་སྒྲུབ་གཤེན་རང་རིག་པའི་ཡེ་ཤེས་ཁྱབ་གདལ་ཆེན་པོར་གནས་པ་ལ་མ་རྟོགས་པ་དེའི་དོན་དང་མ་ལྡན་པས་སྟེ།",
    "ཐུགས་ཉིད་ནི་ཁྱེད་དང་བདག་གི་རིག་པ་སྐྱེ་མེད་སྤྲོས་བྲལ་ལམ་བྱམས་པ་ཆེན་པོ་ལ་སོགས་ལས་མི་འདའ་བར་འཁོར་འདས་སམ་བྱམས་སྡང་ལ་སོགས་དབྱེར་མེད་མཉམ་པ་ཉིད་དུ་གནས་པ་དེའི་དོན་དེ་རྒྱུད་ལ་བསྟེན་ཚུལ་ནི།",
    "སྣང་སྲིད་ན་ཐམས་ཅད་སེམས་རང་འབྱུང་ཡེ་ཤེས་ཀྱི་རོལ་པར་འཁོར་ལོ་བསྒྱུར་བལ་མ་རྟོགས་པས་དབྱར་དཔྱིད་ལ་སོགས་དུས་ལ་བདེན་པར་བཟུང་བས་དུས་རྟགས་སེམས་ཉིད་ཉག་གཅིག་ཏུ་རྟོགས་པའི་རྒྱལ་མོ་བཞི་དང་འགལ་བ་དང་།",
    "དབལ་མོ་ཉེར་བདུན་དང་རྒྱུད་རྒྱལ་པོ་དང་།",
    "ཁྱོད་ཀྱིས་ནི་སྔོན་དབལ་ཆེན་པོའི་སྤྱན་སྔར་ཁས་བླངས་དམ་དུ་བཅས་པ་དང་།",
    "ཨག་ཤོ་ཨུ་དུག་ནི་ངག་གི་སྒྲིབ་པ་དང་།",
    "རེ་ཤག་རོ་སྟེ་གྲོལ་བའི་ལྗགས་ལ་དང་།",
    "དེ་དག་གི་ཕྱག་མཚན་ནི་མར་མེ་སོགས་རིམ་པ་བཞིན་དུ་བསྣམས་ནས་གླུ་དང་དབྱངས་སོགས་མཛད་ཚུལ་དུ་མར་བསྒྱུར་ཞིང་རེ་རེ་ལས་ཀྱང་བྱེ་བ་ས་ཡ་གྲངས་མེད་དུ་སྤྲུལ་ནས་ལྷ་ཡི་དམིགས་སུ་འབུལ་བའོ།",
    "ཀློང་ལྔའི་དྭ་རྩིགས་སྟག་གཡག་འབྲུག་ཁྱུང་གི་ཡ་གད་ལ་ཁྱུང་གུར་ཁྱུང་འགོ་ཏོག་དང་ལྡན་པས་རྒྱས།",
    "ཐུགས་དམ་བསྐུལ་བའི་ཕྱིར་ཕུད་རྒོད་དང་ཉོན་མོངས་རྩད་ནས་གཅོད་ཅིང་མ་ཚོགས་ལས་ལ་མངག་པའི་ཕྱིར་ཁྲག་དང་།",
    "བཞི་བཅུ་རྩ་ལྔ་ལ་ཕྱི་ནང་གསང་གསུམ་ལ་དང་པོ་ནི་འདོད་པའི་ས་རིགས་དྲུག་གཟུགས་ཁམས་གནས་རིས་བཅུ་བདུན་གཟུགས་མེད་སྐྱེ་མཆེད་མུ་བཞི་མོས་སྤྱོད་བཞི།",
    "གཏིམུག་གཟིག་དང་།",
    "བ་སྤུ་ནི་ཉོན་མོངས་དགྲ་བགེགས་དམྱལ་ཐག་གཅོད་པ་དང་།",
    "ཡེ་ཤེས་སྤྱན་ནི་ཡེ་ཇི་བཞིན་མ་དོན་རང་ལ་གནས་པ་དེ་གསལ་བར་གཟིགས་པ་དང་།",
    "ས་བདག་ཀླུ་གཉན་ལ་སོགས་དགྲ་བགེགས་དམྱལ་ཐག་གཅོད་པས་སྐུ་རེགས་དང་།",
    "སྲིད་པ་ཆ་ལ་འབེབས་པས་ཉི་ཟླ་ལ་སོགས་དཀྱུས་བཞིན་ལ་ཡེ་ཤེས་སྤྱན་གྱིས་གདུལ་བྱ་ལ་གཟིགས་པས་རྫུ་འཕྲུལ་ནི་དེའི་དོན་མཛད་པ་དང་།",
    "འཆི་བདག་གི་བདུད་ཐུལ་བས་གཤིན་རྗེ་གནོན་ལ།",
    "ཡེ་ཤེས་ཀྱི་མེ་དཔུང་འབར་བས་དངོས་འཛིན་གདོས་པའི་མཚན་མ་བག་ཆགས་དང་བཅས་པ་རྣམས་བསྲེགས་པར་བསམ་མོ།",
    "ཁང་ནི་ཏིང་མུར་ཤག་ནི་ཆུས་བཀྲུས་པས་སྟེ་གཙོ་མཆོགལྗགས་ལས་ཆུ་བྱུང་ནས་དགྲ་བགེགས་ཀྱི་ཁྲག་དང་འཕྲད་པས་ཡེ་ཤེས་ཀྱི་ཆུར་གྱུར་ནས་བཀྲུས་པར་བསམ་མོ།",
    "མ་རིག་གཏི་མུག་གི་མུན་པ་བཞིས་སེམས་ཉིད་ལ་མི་སྒྲིབ་པ་དང་།",
    "མོས་པར་སྤྱོད་པ་བཞི་དང་།",
    "བདག་ཅག་ཤ་ཁྲག་གི་གདོས་པ་ལ་ཞེན་པ་དང་བཅས་པས་མ་རིག་འཁྲུལ་པའི་མུན་པ་དང་བཅས་པས་མ་རྟོགས་ཏེ།",
    "མུ་ཡེ་ཧ་ར་ནི་དབྱིངས་ཤེས་དབྱེར་མེད་ཀྱིས་འགྲོ་དྲུག་གི་སྡུག་བསྔལ་གྲོལ་བར་བྱེད་པའོ།",
    "དེ་ལྟར་གསང་སྔགས་གསང་བ་ཟབ་མོ་གཉིས་དོན་གྲུབ་པ་ངོ་མཚར་བས་ཨེ་མ་ཧོ་ཅེས་བྱ།",
    "བད་ག་ཅག་ནི་ལམ་རྒྱུད་ལ་བརྟེན་ཅིང་ཉམས་སུ་ལེན་པའི་བསྒྲུབ་པ་པོ་གྲངས་དང་བཅས་པ་རྣམས་ཀྱིས་ལ་གསང་བ་ནི་དམ་མེད་དམ་ལོག་དམ་མ་འདྲེས་པ་ལ་གསང་བ་ཟབ་མོགཉིས་དོན་གྲུབ་པ་ལ་ངོ་མཚར་བས་ཨེ་མ་ཧོ།",
    "ཐལ་བ་ནི་ནམ་མཁའི་ཁྱབ་ཚད་དུ་ཁྱབ་པ་སྟེ།",
    "ཚུལ་ནི་ལྷའི་ངག་ལྟར་སྙན་ཅིང་དགྲ་བགེགས་ཟིལ་གྱིས་གནོན་པས་འཚེར་བའི་གླུ་ལེན་ལ་ཉོན་མོངས་རང་སར་གྲོལ་བའི་བྲོ་བརྡུང་པས་དབྱིངས་ཤེས་དབྱེར་མེད་དུ་བརྡུང་པས་དག་ཅེས་བྱ།",
    "བསོ་ཐོ་ཡེ་ཐུན་ཨ་ཅེས་པས་བདག་གི་ཐུགས་ཁ་ནས་འོད་ཟེར་དལ་བུམ་པའི་ལྷ་ཚོགས་ལ་ཕོག་འོད་དུ་ཞུ་བས་རང་ཁྲིལ་ནས་བདག་གི་ཐུགས་ཀར་ཐིམ་ཚེ་བཀྲག་དང་མདངས་མཆོག་ཐུན་མོང་གི་དངོས་གྲུབ་ཐོབ་རང་གི་ཡིག་འབྲུར་གྱུར།",
    "ཡིག་འབྲུ་དབུས་ཀྱི་ཨ་མ་ལ་འདུས་ཨ་མ་འོད་དཀར་དམར་གྱི་ཉག་ཐག་ཏུ་འ་༧པར་བསམ་གཞལ་ཡས་ཁང་རིམ་བརྩེགས་དང་བཅས་པ་འོད་དུ་ཞུ་སྟེ་ཡིག་འབྲུར་གྱུར།",
    "དད་གུས་མོས་པའི་འདུན་པས་ཡོངས་བསྐུལ་ནས།",
    "མི་རིགས་ལྔ་བཅུ་ང་དྲུག་གི་བདག་ཉིད་ཅན་གྱི་རང་རེའི་ཀྲུང་གོ་རྒྱལ་ཁབ་ལྟ་བུ་ལ་མཚོན་ན།",
    "དུས་རབས་ཉེར་གཅིག་པར་ཕྱིན་པའི་དེང་གི་དུས་སུ།",
    "དབུ་ལ་ཁྲི་གདུགས་ཉི་མ་ཤར་བ་ལྟ་བུའི་དུས་ཀྱི་འགྱུར་བས་བསྐུལ་བའི་གདོང་དམར་བོད་ཀྱི་གཟུར་གནས་མཁས་པ་རྒན་གྲས་དང་གཞོན་སྐྱེས་ཕལ་མོ་ཆེ་ནས་བསམ་བློ་རྙིང་བ་སྟེ།",
    "དགོངས་སྟངས་༣ ཏེ་ལྟ་བ་སྤྱོད་པ་འབྲས་བུའོ་ལྟ་བུ་ཨང་ཀི་ཡིས་གྲངས་གནས་འཐུས་པར་བྱས་པ་ལྟ་བུ་གནའ་ཡིག་གི་ཉམས་མངོན་གསལ་ཡིན་པས་ཞིབ་འཇུག་གི་རིན་ཐང་ཆེ་བ་དང་།",
    "འབའ་ཞིག་ལ་བྷ་ཞིག་ལ་སོགས་ལ་ལས་སོགས་ལྟ་བུ་གནའ་རབས་བོད་ཡིག་དཔེ་རྙིང་དང་རྡོ་རིང་ཡི་གེ་དང་དྲིལ་བུའི་ཁ་བྱང་ལ་སོགས་དང་དེ་བཞིན་ཏུན་ཧོང་ནས་ཐོན་པའི་བོད་ཡིག་གི་འབྲི་སྲོལ་མང་པོ་མངོན་གསལ་དུ་ཐོན་ཡོད་པས་དཔེ་དཀོན་དེ་དག་ཀྱང་རྩོམ་པ་པོའི་འཚོ་གཞེས་ཀྱི་ཚད་ནས་གཞིགས་ཏེ་བརྩིས་ན་ད་ཕན་མི་ལོ་བརྒྱད་བརྒྱ་ཡས་མས་སོང་ཡོད་པ་གྲུབ་བོ།",
    "མེད་ཅེས་པའི་དོད་དུ་ཡིག་འབྲུ་ན་ཕྱི་ལོག་སྟེ་ཎ་ཡིས་མཚོན་པར་བྱས་པ་དང་མཆོག་གསུམ་ལྟ་བུའི་གསུམ་ལ་ཨང་ཀིས་མཚོན་པར་བྱས་པ་ལྟ་བུ་རེ་ཟུང་ཙམ་མིན་པ་དབུ་ནས་ཞབས་སུ་མཐར་ཆགས་སུ་ཡོད་པས་ཡིག་ནོར་གྲས་སུ་བཞག་མི་ཐུབ་པར་སྐབས་དེ་ཤེད་དུ་དེ་ལྟ་བུའི་འབྲི་ཚུལ་ཞིག་དར་ཡོད་པ་གོ་ཐུབ་པ་དང་།",
    "མ་ཡིག་འཕྲི་སྣོན་བཅས་བཅོས་གང་ཡང་བྱས་མེད་པ་དབུ་ཅན་དུ་ཕབ་ཅིང་དཔེ་རྙིང་ཡིན་ངེས་ཅན་དག་ཆབས་ཅིག་ཏུ་མ་ཡིག་གི་ཕྱི་མོ་ཇི་མ་ཇི་བཞིན་དུ་པར་ལོན་ནས་མཇུག་ཏུ་བཀོད་ཡོད།",
    "ཡིག་ནོར་ཡིན་ངེས་ཅན་དང་དོགས་གཞི་ཅན་སྤྱིར་གུག་རྟགས་སྒོར་མོའི་ནང་དུ་བཀོད་དེ་གཞུང་གི་ནང་དུ་འཁོད་ན་ཅུང་སྟབས་བདེར་མཐོང་རུང་།",
    "དེང་གི་དུས་སུའང་ཕྱོགས་འཛིན་གྱི་ལྟ་བ་བྲལ་བའི་བོད་རིག་པའི་ཞིབ་འཇུག་གི་ལམ་ཆེན་དུ།",
    "བདེན་དོན་གྱི་གནས་ལུགས་འཚོལ་མཁན་མང་པོ་ཞིག་གིས་མི་རིགས་ཤིག་གི་བླ་སྲོག་དང་།",
    "དེང་ཆར་དེ་དག་གི་གྲས་ནས་གལ་འགང་ཆེ་ཞིང་དཔེ་རྒྱུན་དཀོན་པ་འགའ་བདམས་ཡ་ཐོག་ཞང་བོད་ཁྱད་ནོར་དཔེ་ཚོགས།",
    "རྒྱ་ཆེ་བའི་གཟིགས་མོ་བ་རྣམས་ལ་སྤྱན་འབུལ་བྱུང་ཐུབ་པ་ལ།",
    "དེ་དག་གི་དར་ཚུལ་ནི་རྟག་གཟིགས་འོལ་མོ་ལུང་རིང་ནས་ཞང་ཞུང་དང་བོད་རྒྱ་གར་སོགས་སུ་རིམ་པར་བརྒྱུད་དེ་དར་བ་ཞིག་ཡིན་ལ།",
    "གསང་སྔགས་བསྒྲག་པ་སྐོར་གསུམ་སོགས་འབྲས་བུའི་བོན་རྣམས་སྤྱི་ལོའི་སྔོན་གྱི་མི་ལོ་ཆིག་སྟོང་ལྷག་གི་གོང་དུ།",
    "ཡིག་རྙིང་གི་རྣམ་པ་ཅན་རྐྱང་རྐྱང་ཡིན།",
    "གནའ་བོའི་ཞང་བོད་ཀྱི་མཁས་གྲུབ་དག་གི་རྣམ་དཔྱོད་ཀྱི་རྩལ་ལས་བཏོན་པའི་བོད་རང་སའི་རིག་གཞུང་རྩ་ཆེན་འདི་དག་པར་སྐྲུན་དང་།",
    "ཡང་ཕྱོགས་གཞན་ཞིག་ནས་དག་སྒྲིག་གི་སྐབས་སུ།",
    "ང་ཚོས་སྡུད་བསྒྲིགས་བྱས་པའི་དཔེ་ཚོགས་ཞུ་དག་བྱེད་སྟངས་ནི།",
    "དཔེ་ཚོགས་འདིའི་ནང་དུ་བཀོད་པའི་གཞུང་ཕལ་ཆེར་གནའ་བོའི་ཡིག་རྙིང་གི་འགྲོས་ལས་མ་འདས་པས།",
    "དེང་དུས་ཀྱི་བརྡ་སྤྲོད་དང་སུམ་དག་རྟགས་གསུམ་གྱི་གཞུང་དང་བསྟུན་ནས་དག་བཅོས་བྱས་ན་གནའ་བོའི་ཡིག་རྙིང་གི་རིན་ཐང་བརླག་འགྲོ་བ་དང་།"
  ]
}