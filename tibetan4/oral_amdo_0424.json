    "ངན་སོང་སྐྱེ་སྒོ་འགོག་པ་དང་རྗེ་ཉིད་ཀྱིས་ཕྱི་རབས་རྣམས་ཡིད་ཆེས་ཕྱིར་ཞབས་ཀྱི་རེ་ཁ་གསལ་བར་དད་རྟེན་དུ་བསྩལ།",
    "སྐྱབས་མགོན་མཆོག་ནས་ཁྱོད་དགོན་འདིའི་སྟོབས་ལྡན་བྱ་བར་གསུངས་ཀྱང་།",
    "སྐྱབས་མགོན་མཆོག་གི་ཞབས་དྲུང་དུ་ཕེབས་ནས་ཁས་ལེན་ཞུས།",
    "གཟའ་སྐར་བཟང་བའི་ཉིན་མོར་རང་དགོན་ནས་དུར་ཁྲོད་ཁ་འབེབ་ཕྱིར།",
    "ནགས་ཤོད་སྟོད་ནས་ལོ་བརྒྱ་ཐོབ་པའི་རྒན་པོ་ཁ་གཅིག་གིས་རྒན་མོ་ཟེར།",
    "ཞིག་གི་སྐུ་ཕུང་འབྱོར་བས།",
    "གཞན་དུ་ཀྭ་འོད་མཆོག་གི་ཟུར་ཙམ་ཡོད་པ་མི་དམིགས་པས་སོ།",
    "ཟངས་རི་ནས་བུད་མེད་གཅིག་ཕྱག་རྒྱར་བསྟེན་པ་མ་ལེགས་པར་དགོངས་ནས།",
    "ཕྱག་རྒྱ་མོ་དེ་རྗེ་ཉིད་འཚོལ་དུ་ཕྱིན་པས་ཟླ་དགོན་དང་ཉེ་བའི་ས་ཞིག་ཏུ་མི་མ་ཡིན་དུ་སྐྱེས།",
    "དུས་ཕྱིས་ཉམས་གུད་དུ་སོང་བས་སྒྲུབ་ཁང་གི་མལ་འདིར་དགོན་ཧྲུལ་དང་།",
    "མཆོག་གི་དངོས་གྲུབ་ཐོབ་པར་འགྱུར།",
    "རྗེ་ཉིད་ཀྱིས་ཟབ་མོ་རིམ་གཉིས་ཀྱི་དུས་འདའ་བ་དང་།",
    "གཡས་རི་སྤྱན་རས་གཟིགས།",
    "དཔལ་ལྡན་ལྷ་མོ་རི་མ་ཏི་མཆེད་ལྔའི་གནས་མཆོག་ཡིན་ཞིང་།",
    "སྒྲུབ་ཕུག་ཏུ་ལྷ་མོའི་ལྷ་མཚོ་ཞེས་སྒྲུབ་ཆུ་དབྱར་མི་ཆེ་ལ།",
    "གཟའ་ཀླུ་རྒྱལ་འགོང་གི་གནོད་ངན།",
    "ཁྱད་པར་དུ་དམ་ཚིག་ཉམས་ཆག་ཉེས་ལྟུང་གི་དྲི་མ་དག་ནས་དངོས་གྲུབ་སྣ་རེ་ཐོབ་པ་དང་།",
    "གནས་མེ་འབར་ཕུག་གི་གཞལ་ཡས་ན།",
    "ཡུམ་མཆོག་དཔལ་ལྡན་ལྷ་མོ་ལ་གསོལ་བ་འདེབས་ཞེས་གསུངས་པ་ལྟར་ཡིན་ལ།",
    "གཡོན་དུ་སྒྲོལ་མ་སྔོན་མོ་རང་བྱོན།",
    "སྒྲུབ་ཕུག་གི་གཡོན་ཟུར་དུ་བྲག་དམར་གྱེན་ལངས་འདིར་གནས་མཆོག་ཤེལ་དཀར་འབུམ་པའི་གནས་སྲུང་།",
    "སྐལ་མེད་ལོག་ལྟ་ཅན་སོགས་གདུག་ཅན་ཐམས་ཅད་སྐད་ཅིག་གིས་བརླག་མཛད།",
    "རང་བྱུང་གི་བཀོད་པ་སོགས་རྒྱས་པར་མཁས་མཆོག་བློ་གྲོས་གཞན་དགའ་མཆོག་གིས་མཛད་པའི་མེ་འབར་གྱི་གནས་ཡིག་ཏུ་གཟིགས་པར་འཚལ།",
    "གུ་རུ་ཕུག་གི་གཏེར་ཁུང་ངམ་ཐོག་ཕུང་ཞེས་པ་ནས་ཞལ་མཐོང་བ་གུ་རུ་སྣང་སྲིད་ཟིལ་གནོན་བཞེངས་པ་དང་།",
    "ཁོང་གི་འབུར་སྐུ་བཞེངས་པའི་ལག་རྒྱུན་ནི་ཞང་པོ་མཐུ་ཆེན་ཡེ་ཤེས་ཡིན་པ་དང་གསང་སྔགས་ཉམས་ལེན་ལ་བརྩོན་བཞིན་པའི་སྐབས་དེར་རིག་གསར་དུས་འགྱུར་བྱུང་ནས།",
    "ཁོང་གིས་ཕྱི་ལོག་ནས་ཞལ་འདེབས་དང་འགན་འཁུར།",
    "རྣམ་སུམ་དད་པའི་མེ་ཏོག་ཚིག་གི་ཕྲེང་།",
    "རྣམ་དག་མོས་གུས་གདུང་བ་བསྐྱེད་པའི་ཕྱིར།",
    "ཞེས་ནགས་ཤོད་འགོམ་སྒྲོ་བ་དཔོན་ཚང་གི་མངའ་ཁོངས་སུ་བཀའ་དགོན་གཉིས་ལས།",
    "ལྷག་ཏུ་ཕུར་པ་འདི་ཉིད་སློབ་དཔོན་པདྨ་ལས་པཎ་ཊི་ཏ་ཕྲ་ལ་རིང་མོས་ཞུས།",
    "འཕྲིན་ལས་ཕུར་པའི་ས་དཔྱད་ཡོངས་སུ་ཚང་བ་དེར་སོང་ལ།",
    "བྱང་མེ་མོ་བྲག་དཀར་གྱི་གནས་བདག་གྱིས་ཞེས།",
    "གནས་བདག་གིས་ཉམས་སད་ཕྱིར་ཞི་མི་སྤྲུལ་ནས་ཚོགས་རྫས་ཁྱེར་བས།",
    "ཕྱི་ལྟར་རི་ཡི་རྒྱལ་པོ་རི་རབ་ལ་གླིང་བཞི་གླིང་གཡོག་གི་ཚུལ་དང་།",
    "དུས་དེ་ནས་བཟུང་མེ་མོའི་གནས་བདག་རྒྱལ་བ་གངས་པ་ཡིན་ཞིང་།",
    "འོག་གི་བློ་འབུར་ལ་མགོན་པོ་ཕྱག་བཞི་ཕྱག་དྲུག་བེང་འཛིན་མ་ནིང་སྟག་ཤམ་ལ་སོགས་ཕོ་རྒྱུད།",
    "ལྷ་མོ་མུ་ཁ་ལི་དང་བསྟན་སྲུང་ཨ་ཕྱི་སོགས་མོ་བརྒྱུད་ཀྱི་ལྷ་ཚོགས་རྣམས་བཞུགས།",
    "གཤིན་རྗེ་ཕོ་གདོང་མོ་གདོང་།",
    "གེ་སར་སྐྱེས་བུའི་གོ་ཁྲབ་དང་འབྲུག་མོའི་སྦྲ་འཐེན་རྣམ་གཉིས།",
    "ཐུར་དུ་སོང་བས་ཕ་བོང་དཀར་པོའི་སྟེང་སློབ་དཔོན་གྱིས་བྱིན་གྱིས་རླབས་པ་རྡོ་ཨ་རིལ་བྱིས་མགོ།",
    "མཚོ་རྒྱལ་ཕུག་ཏུ་མཚོ་རྒྱལ་འཆི་མེད་ལྕགས་སྲོག་སྒྲུབ་པའི་ཕུག་ན་ཚེ་ཡི་ལྷ་མོ་བརྒྱད་དང་ཚེ་བུམ་ཀཱ་པ་ལ་རྣམས་ཡོད།",
    "གོང་གསལ་ཞུས་པའི་རང་བྱོན་གྱི་ལྷ་ཚོགས་རྣམས་དང་རི་ཆུའི་བཀོད་པ་ཕུག་པའི་ནང་གི་རང་བྱོན་འདི་རྣམས།",
    "རྣམ་པ་ཙམ་མ་ཡིན་པར་དཔེར་ན་འཇིམ་བཟོ་ལ་ཅུང་མི་མཁས་པ་ཞིག་གིས་བཞེངས་པ་ལྟ་བུ་ལས་དབྱེ་བ་ཆེར་མེད་ཅིང་ཤིན་ཏུ་ངོ་མཚར་ཆེ།",
    "ཤག་ཝ་ཐང་དགོན་ཡང་དགོན་མིང་བསྒྱུར་བ་བཅས་བྱེད་ནས་དོན་དུ་ཀརྨ་གི་ཚང་གི་རྒྱུད་པ་མེད་པར་བྱེད།",
    "གཞན་ཡང་ཁ་གཅིག་གིས་གངས་པའི་གདུང་རྒྱུད་ལས་ཡབ་རྟ་མགྲིན་རྒྱ་མཚོ་དང་ཡུམ་ག་བཟའ་ཀླུ་མཚོའི་སྲས་སུ་བལྟམས་པར་གསུངས།",
    "ཡུམ་སྟག་དྲུག་ཆིན་ཧུའི་གཡོག་མོ་ཚེ་ཐར་གཉིས་ཀྱི་སྲས་སུ་༡རྡོ་༢༤རབ་བྱུང་བཅུ་བཞིའི་ཤིང་ཕོ་རྟ་ལོར་སྐུ་འཁྲུངས།",
    "ཡུམ་བྲན་མོ་ཡིན་པས་རྨོ་བོ་ཆུང་སྐྱིད་ཀྱིས་སྐུ་བསྐྱེད་བསྲེངས།",
    "རྒྱལ་བ་བཀའ་བརྒྱུད་པ་ལས་གཞན་མི་བསམ་པས་རྡོ་རྗེ་འཆང་གི་སྐུ་མཐོང་བས་མོས་གུས་རྩོལ་མེད་སྐྱེ།",
    "རྗེ་ནོར་བུའི་ཞལ་མཇལ་བས་བཅོས་མིན་གྱི་མོས་གུས་འཁྲུངས།",
    "ཐུགས་བསྐྱེད་ཆེན་མོ།",
    "འདི་སྐབས་ཕྱག་ཆེན་དོ་དྷ་སྐོར་གསུམ་སོགས་གཟིགས་པས་ཏི་ལོ་པ་དང་ཞལ་མཇལ།",
    "སྤྲེལ་ལོ་ལ་རྨོ་བོ་ཕེབས་ནས་རྗེ་ཉིད་མཇལ་བས་སྐུ་ལ་འཆང་ནས་ངུས་སོང་།",
    "ཐུགས་བསྐྱེད་ཆེན་མོ།",
    "མོས་གུས་སྲོག་འཁོར།",
    "མར་ལུགས་ཕག་མོ་གསང་ཆེན་རྒྱ་མཚོ།",
    "མཐར་དགུང་གྲངས་རེ་བདུནསྤྱི་ལོ་༡༩རབ་བྱུང་བཅོ་ལྔ་ལྕགས་བྱ་ལོ་ཟླ་བ་གསུམ་པའི་ཚེས་ཉེར་གཉིས་ཉིན་གཟིམ་སྒོར་ཕེབས་ནས་ཞབས་བཅག་མཛད།",
    "ནང་དུ་ཀུ་རེ་འགའ་གསུངས།",
    "རྒྱས་པར་ཡང་རིའི་སློབ་དཔོན་རིམ་བྱོན་རྟོགས་བརྗོད་ནོར་བུའི་ལྗོན་ཤིང་ལ་གཟིགས་ན་ཤིན་ཏུ་རྒྱས་པར་ཡོད།",
    "བསྟན་དང་འགྲོ་བའི་དོན་དུ་འགྲོ་དོན་མཐའ་ཡས་མཛད་ཀྱང་རེ་ཞིག་དེ་ཙམ་མོ།",
    "ཁོང་གི་གདུང་ལས་རྒྱལ་བ་འབྲོང་ངུར་པའི་གདུང་རབས་མང་དུ་བྱོན།",
    "དེ་སྔོན་སྐུ་ཕྲེང་ག་ཚོད་སོང་མིན་མ་ཤེས་པས་རྗེ་འདི་སྐུ་ཕྲེང་དང་པོ་ཡིན།",
    "ཡུམ་འཕགས་མོ་སྒྲོལ་མ་གཉིས་ཀྱི་སྲས་སུ་སྤྱི་ལོ་༡༩༧རྐྱལྕགས་ཁྱི་ལོར་སྐུ་འཁྲུངས།",
    "གུ་རུ་མཚན་བརྒྱད་གསེར་ཟངས་མི་ཚད་རེ།",
    "འདུ་ཁང་གི་ཀ་འཕན་སོགས་མང་།",
    "མཆོད་རྟེན་ཁང་ཀ་བ་བཞི་བཅས་ཀྱི་རྒྱ་ཁྱོན་ཡོད་པ་མ་ཟད།",
    "ཟླ་བ་བཞི་པའི་ནང་ཚེས་བཅུ་ཆེན་མོ།",
    "ཤག་ཁྲི་དཀར་ལྷས་མོ་ཆེར་མཚན་དཔེའི་བཞད།",
    "ཁོང་གི་བཀའ་ལྟར་རི་དོ་ཕུ་ལྷ་རི་དཀར་པོའི་ནུབ་ངོས།",
    "ཤག་གི་མར་འབབ་ཆུ་བོ་དམར་ནག་རཀྟ་བཤམ་འདྲའི་ས་དེར་གླང་དེལ་དགོན་ཕྱག་བཏབ།",
    "ཁོང་གི་ཕྱག་རྫས་ཟུར་གཅིག་གཏོང་རྩ་བཞག་པས།",
    "སྤྱོད་པ་རྩེང་པས་བག་རྒྱས་སུ་ཞོག་རེ་ལ་འབྲི་གཡག་བཅོ་ལྔ་ཙམ་རེ་ཡང་འགའ་ཡང་ཤོར།",
    "ཡར་ཤོག་གསུངས་ནས་ལུས་སྟངས་སྟབས་དང་བཅས་ཁྱོད་ཅི་མཐོང་གསུངས་པས།",
    "ཕྱག་ན་རྡོ་རྗེ་མཐོང་ཞུས་པས་འོ་ཁྱོད་ང་ལ་བརྟེན་མི་དགོས།",
    "དུང་དང་རྒྱང་གླིང་གི་སྒྲ་བཅས་བྱུང་།",
    "ལོ་རེའི་ནང་ཆགས་རིའི་ཚེས་བཅུ་ཐེངས་རེ་ཙམ་དང་།",
    "སྤྱི་ལོ་༡༩༥༩ས་ཕག་ལོར་ཡ་ང་བའི་དམག་འཁྲུག་གི་སྐབས་སུ་དམག་སར་སོང་བས་རི་ཁྲོད་དེ་ཉིད་མི་དམིགས་པར་གྱུར།",
    "སྐུ་འདི་བཞེངས་སྐབས་དབུ་ཆེན་ཨ་སྲས་ནས་དབུ་ནི་ཞག་གཅིག་གིས་གྲུབ།",
    "དབུ་ཆེན་ནས་མཛོད་སྤུ་སོགས་སྟེང་ནས་ཅུང་ཟད་བརྡུངས་བས་འོག་ནས་གྲུབ་འགྲོ་གི་འདུག་ངས་ནམ་རྒྱུན་དབུ་ལ་ཟླ་བ་རེ་མ་ཟིན་ཙམ་ལས་མི་འགྲུབ་པས་ད་ལྟ་ཞག་གཅིག་གིས་འདི་ལྟར་གྱུར་ཞེས་གསུངས།",
    "སྐྱབས་མགོན་མཆོག་ལ་སྤྱན་གཟིགས་ཕབ་ནས་ལེགས་སོ་སྟེར།",
    "ཆུ་བོ་རྡོ་རྗེ་འཆང་གི་པད་གདན་ཡན་མ་རྒལ་བར་ཆུའི་འཇིག་པ་ལས་སྒྲོལ།",
    "ཤོག་བུ་ཁ་འཐོར་ཡ་འཐོར་དུ་སོང་།",
    "རིམ་པར་དང་པོ་ཀེ་རུ་ཚང་དགོན་སྟོད་མའི་འདུ་ཁང་གི་ཐོག་ཏུ་མཁར་ཆགས།",
    "ཁྱད་པར་དུ་གྲགས་ཆེ་བ་ནགས་ཀྱི་རི་རབ་མཆོད་རྟེན་ནི་རི་ཕུག་གྲོང་གི་ཉེ་འདབས་སུ་གནས་ཡོད།",
    "དེ་རྗེས་ལྷ་ཁང་དང་རྟེན་དང་བརྟེན་པར་བཅས་པ་རྩ་འཐོར་དུ་སོང་།",
    "སྤྱན་རས་གཟིགས་ཕྱག་སྟོང་སྤྱན་སྟོང་ལི་ཁྲ་ཐོག་ཚད།",
    "བསང་དང་ཚེས་བཅུ་བཅས་ཆག་མེད་གནང་གི་ཡོད།",
    "གཡས་སུ་ཕོ་དགོན་དང་གཡོན་དུ་མོ་དགོན་ཞིག་བཅས་གཉིས་ལས་སོག་པོ་ཇུན་གར་བས་མེ་སྐྱོགས་ཀྱིས་གཏོར།",
    "མཇུག་ཏུ་སྐྱབས་རྗེ་མཆོག་གིས་རབ་གནས་མཛད།",
    "གནས་སྲུང་ཨ་ཕྱི་ཆེན་མོ་ཡིན་ཞེས་གནས་འདི་བསྲུང་ན་དངོས་གྲུབ་དང་།",
    "ཉི་ཟེར་འཇའ་འོད་ཆར་སིམ་བབ་སྟེ་མཁའ་ལམ་ལྟས་བཟང་དུ་མའི་ཁྲོད་དུ་གླེང་མོལ་བྱུང་།",
    "དབུ་བསམ་གཏན་གཙོས་པའི་སྦྱིན་བདག་ཁག་གིས་སྨྱུང་གནས་རྟེན་ཟངས་ལུགས་མའི་སྤྱན་རས་གཟིགས་བཅུ་གཅིག་ཞལ་གསེར་སྐུ་བྱིས་ཚད་ཙམ་དང་།",
    "སྤྱི་ལོ་༢རྐྱ་༦ནས་དཔལ་མོ་ལུགས་ཀྱི་སྨྱུང་གནས་ཆག་མེད་བཅས་གནང་།",
    "འགོམ་ལེང་དྲུག་ལས་ཆུ་སྲིབ་མའི་ནང་ཚན་རྒྱས་ཚ་ཆེན་སྟེང་གི་མི་འཁྲུག་པའི་ལྷཁང་འདི།",
    "མི་འཁྲུག་པའི་སྐུ་ས་ཙྪ་སོགས་གང་རུང་གི་སྟོང་སྐུ་བཞེངས་བར་ལུང་བསྟན་ནས།",
    "འདུ་ནག་སྟེང་གི་ལྷ་ཁང་ནི་རབ་བྱུང་བཅུ་གསུམ་སྟོད་ཙམ་དུ་སྐྱི་རུ་རྭ་བཟོ་མཆོག་གིས་ཕྱག་བཏབ།",
    "གྲོང་ཚོའི་དབུ་ཁྲིད་དང་མང་ཚོགས་ཀྱི་འདོད་མོས་ལྟར་མ་ཎི་ལྷ་ཁང་གི་ས་ཆ་ཐུགས་རྟགས་ཞུས་པས་སྔོན་གྱི་སྐྱི་རུའི་མཚམས་ཁང་དུ་གཏན་འཁེལ་གནང་ནས་ལྷ་ཁང་བཞེངས་གྲུབ་ཀྱང་རྗེས་སུ་ཡང་སྔར་ལས་ལྷག་པའི་རྒྱས་བསྐྲུན་གནང་རྒྱུའི་གྲ་སྒྲིག་བཅས་ཡོད།",
    "ལོ་གསུམ་རེའི་བར་སྟག་ཕུ་དང་ཉི་གྲགས་ཀྱི་བཀའ་ལྟར་གུར་དྲག་གི་གཏོར་རྫོགས།",
    "རིག་གསར་སྐབས་ནང་གི་རྟེན་རྣམས་མེད་པར་གྱུར།",
    "གནམ་འཁོར་ལོ་རྩེབས་སྟོང་དང་ལྡན་པའི་དབུས་སུ་རྗེ་བཙུན་སྒྲོལ་མ་སྔོན་མོ་ཁྲི་ལ་བཞུགས་འདྲའི་གནས་རི་འདི།",
    "རྗེ་བཙུན་སྒྲོལ་མའི་ཞབས་ཀྱི་པུས་མོའི་ཚུལ་གྱི་སྟེང་དུ་ཆགས་པ་ནི་གནས་ཤོད་དྭགས་པོ་ལྕགས་ལུང་དགོན་ཡིན་ཏེ།",
    "ཁ་ཅིག་གིས་ལྕགས་ལུང་ཀན་ཞེས་ས་མིང་ལས་དགོན་མིང་དུ་འགྱུར་ཚུལ་དང་།",
    "ཁ་གཅིག་གིས་རང་དགོན་དུ་བཞུགས་པའི་དུང་དཀར་ལྕགས་ལུང་ཅན་དེའི་མིང་ནས་ལྕགས་ལུང་དགོན་ཞེས་ཐོགས་ཟེར།",
    "ད་ལྟ་དགོན་དེའི་ཆགས་ཤུལ་འདུ་ཁང་གི་རྨང་དང་བརྩེགས་པ་བཅས་པ་ཡོད་པ་དང་།",
    "ཐང་དར་གྱི་རྡོ་ཕུང་བཅས་ཡོད་པ་གཡས་གཡོན་དུ་གྲྭ་ཤག་གི་ཤུལ།",
    "བ་རོ་འམ་ག་དོའི་ལྷ་ཁང་འདི་སྔོན་ཨར་རྒོད་པ་སེར་ཞེས་པའི་སྔགས་འཆང་ཞིག་གིས་རབ་བྱུང་བཅོ་ལྔའི་སྨད་དུ་གནས་མལ་འདིར་ལྷ་ཁང་ཐོག་བརྩེགས་ཅན་ཞིག་བསྐྲུན་པས་རིག་གསར་སྐབས་ཉམས་གུད་དུ་ཕྱིན།",
    "སླར་ཡང་སྤྱི་ལོ་༡༩༩རབ་བྱུང་བཅུ་བདུན་ལྕགས་རྟ་ལོ་གྲོང་མི་ཡོངས་ཀྱི་རེ་འདོད་ལྟར།",
    "ས་དམར་གྲོང་གི་ལྷ་ཁང་ནི་ཀ་བ་གཉིས་ཅན་ཞིག་དང་།",
    "ལྡེབས་བྲིས་ཁག་བཅས་ད་ལྟ་ལྷ་ཁང་བསྡད་ཡོད་ཀྱང་ནང་གི་རྟེན་གང་ཡང་ཉམས་གསོ་མ་ཐུབ་པར་ལྷ་ཁང་གཅིག་པུ་ལས་བཞུགས་མེད།",
    "སྔར་ལས་ལྷག་པའི་སྒོ་ནས་བསྐང་བཤག་ཟབ་རྒྱས་ངང་ཉིན་བདུན་དང་དེའི་རིང་ཨ་ཕྱིའི་བསྐང་བ་བརྒྱ་ཚར།",
    "འབུམ་དག་སྒྲོག་དུས་འཁྲུག་གི་སྐབས་སུ་དགྲ་བཅོས་དང་དགྲ་འོབ་བཅས་བྱ།",
    "ནུབ་གྲོགས་གི་ཚ་ཆུ་ཁྲུས་ཀྱི་སྒོ་དང་ཀླུ་ཡི་སྒྱེད་པུ་རང་བྱུང་།",
    "འོམ་ཡག་རི་རྒན་ལ་གཡུ་ཡི་མཚོ་མོ་དང་།",
    "དེ་ལ་གནས་པ་གསེར་ཉ་གཉིས་ཀྱི་མཇུག་མ་ལས་བྱང་ཤག་གི་ཚ་ཆུ།",
    "གནའ་སྔ་མོར་གནས་རི་ཡིན་པར་ཞལ་རྒྱུན་དུ།",
    "ནང་དུ་གཡུ་ཡི་མཚོ་མོ།",
    "སྲས་མོ་ཆུ་གྲོང་དཀར་པོ།",
    "ཆུ་ལེན་ཕ་བོང་སྟེང་དང་ཞོ་འཚེར་དུ་གཡག་གི་རྨིག་རྗེས།",
    "འགོམ་ལེང་དྲུག་ལས་ཉང་ཁུ་གཞུང་རྒན་སྣོ་གྲོང་གི་བསྐང་བཤག་ནི་དང་པོ།",
    "དེ་མིན་དུད་རེ་ནས་ཚར་རུ་སོགས་གང་འབྱོར་རེ་བཅས་ཀྱིས་ཚོགས་གུར་ཉོས།",
    "བསྐང་བཤག་ཚུགས་རིང་ཨ་ཕྱི་བརྒྱ་ཚར་དང་།",
    "ཀནསྣེཙཡོག་ཤག་ཉང་ཁུ་གཞུང་རྒན་སྣེ་ནས་ཡར་ཙམ་ཕྱིན་པས་བྲག་དཀར་གྱི་ལྷུན་པོ་མང་པོ་ཐོ་རེར་མཐོང་།",
