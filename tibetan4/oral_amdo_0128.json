    "ཞལ་ཕྱག་ཡང་བསྐྱེད་བྱེད་ཇི་བཞིན་མཛད་པ་ཡོད་མོད་ཀྱི།",
    "གཡོན་ཐོད་པའི་ནང་དུ་ནང་གི་རྫས་དང་ཕྱིའི་རྫས་སོ་དྲུག་གི་བདུད་རྩིས་བཀང་བར་བྱའོ།",
    "གཅན་གཟན་རི་དྭགས་ཀྱི་ཡན་ལག་ཅན་རྐང་ལག་རེ་རེ་ལ་རྗེ་ངར་དང་རྐང་ཐུང་གཉིས་གཉིས་ཏེ་བརྒྱད་ཡོད་པ་ཡིན་གྱི་རྐང་པ་དངོས་བརྒྱད་པ་ནི་མིན་ནོ།",
    "མིག་སྔོན་ནི་འདྲེ་བྱ་མོའོ།",
    "འགོད་ཚུལ་མཁས་པ་དག་གིས་བྱང་ཤར་གྱི་རབ་གཏུམ་མ་རྣམས་ནས་བརྩམས་ཏེ།",
    "རྡུལ་ཚོན་དཀྱིལ་འཁོར་ལ་འགོད་པའི་རིམ་པ་ཇི་ལྟར་མཛད་པ་དེ་ཉིད་སྒོམ་དོན་དང་ངག་འདོན་ལའང་བྱེད་མོད་ཀྱི།",
    "བྱང་གི་རི་ཐག་འགྱངས་སར་དཔྱིད་སོས་དང་།",
    "སྨིན་དྲུག་ནས་བགྲངས་པའི་བདུན་ཚན་བཞི་ཤར་ལྷོ་ནུབ་བྱང་གི་སྐར་མར།",
    "བྱང་གི་ཕྱེད་ཕྱི་མ་ལ་འཁྲིག་པ་ཞེས་སོགས་ཀྱིས།",
    "གཙོ་བོར་ཉིན་ཞག་གཅིག་གི་དུས་སྦྱོར་བཅུ་གཉིས་པོ་རྡོ་རྗེ་བཞིར་བསྡུས་ཤིང་།",
    "འདི་ལའང་ས་ལྷའི་ས་བོན་སྤྱི་འགྲོ་བཞིན་ཕྱག་མཚན་ལ་ཡོད་པས་བྱས་མོད་ཀྱི།",
    "དྲང་དོན་བསྐྱེད་རིམ་ལ་ཡེ་དམ་ངོ་བོ་ཐ་དད་དུ་འཛིན་པའི་སྣང་ཞེན་ཕྲ་མོ་ཙམ་ཡང་འགོག་ཅིང་།",
    "འོ་ན་འདི་དང་ཡེ་ལེའི་དགུག་གཞུག་གི་ཁྲོ་བོ་ཐོག་མཐའ་རྗེས་པ་ཅི་ཞེ་ན།",
    "ཡོད་པར་འདོད་པ་དག་གིས་ཀྱང་།",
    "ཡེ་ཤེས་དགུག་གཞུག་ཇི་སྙེད་བྱས་ཀྱང་གཞི་དང་འབྲས་བུའི་ང་གཉིས་ངོ་བོ་ཤིན་ཏུ་འཐད་པར་འཛིན་པའི་ལྷན་སྐྱེས་འཁྲུལ་པ་ལ་ལྟོས་ཏེ་རོ་མཉམ་ཤིན་ཏུ་རྒྱས་པར་གསུངས་མོད་ཀྱི།",
    "དེ་དག་ཀྱང་ལས་ཡེ་གང་རུང་གི་ཕྱག་རྒྱའི་ནུ་མ་ལ་རེག་པ་དང་།",
    "དེ་དང་སྙོམས་པར་ཞུགས་པའི་བདེ་སྟོང་གི་ཡེ་ཤེས་དང་།",
    "མི་འགྱུར་བའི་བདེ་ཆེན་དང་སྟོང་གཟུགས་ཀྱི་མཐར་ཐུག་ཐུགས་སྐུ་ཟུང་གི་དོན་གོ་བ་རྣམས་ནི་སྨིན་བྱེད་དང་སོར་བསམས།",
    "ཀུན་ཏུ་འོད་མ་མཐར་བྱས་པའི་སྔགས་ཀྱི་ཐུན་མོང་མིན་པའི་ས་བཅུ་གཉིས་ཀྱི་སྤངས་རྟོགས་ཡོངས་སུ་རྫོགས་པར་བྱེད་དེ།",
    "དང་པོ་ལ་སོ་སོ་བ་དང་ཐུན་མོང་བའོ།",
    "རིགས་དྲུག་གི་དང་།",
    "ཕྱག་རྒྱ་བཞིའི་རྒྱས་གདབ་སོགས་ནི་དེ་ལྟར་ཡིན་མོད།",
    "དེ་ཡང་རིགས་བདག་དང་དེའི་རིགས་ཅན་གཉིས་སུ་གནས་པའི་འཁོར་རམ་རིགས་ཅན་རྣམས་ནི་རང་རང་གིས་རིགས་བདག་གཙོ་བོས་རྒྱས་འདེབས་ལ།",
    "དགོས་པ་རྒྱས་འདེབས་སོ་སོར་ངེས་པ་མི་ནུས་པའི་གང་ཟག་གི་ངོ་བོར་རམ།",
    "ཡིན་མོད་ཀྱི་དེ་ལའང་འདིས་འདེབས་པས་གཉིས་ཀའང་རྒྱལ་བ་ཐམས་ཅད་ཀྱི་སྐྱེད་མཛད་དུ་རིག་པར་བྱའོ།",
    "རྣམ་སྣང་གིས་སྣང་མཐའ་ལ་རྒྱས་བཏབ་པ་ནི།",
    "རིགས་སོ་སོ་ལ་རང་རང་གི་རིགས་བདག་གམ་སྐྱེད་བྱེད་ཀྱིས་རྒྱས་བཏབ་པའོ།",
    "གཞན་ཡང་ནང་གི་རྩ་དང་བསྟུན་ན།",
    "སྐུའི་རྒྱས་གདབ་ཐུན་མོང་བ་ནི།",
    "རྡོ་རྗེ་ནོར་བུའི་རྩེ་མོར་ཨོཾ་ཞེས་སོགས་གསུང་རྒྱུན་ལ་འབྱུང་ཡང་།",
    "ཨ་ནི་ཡིག་འབྲུ་ཀུན་གྱི་མཆོགཨ་ཀ་རོའི་དོན་ཅན་ཨ་ཐུན་མོང་ངོ།",
    "འདི་རྣམས་སྐུ་སོགས་བཞིར་གང་གིས་བཞག་ཅེ་ན།",
    "ཡི་གེ་ལྔ་ངག་གི་གནས་ལྔས་ཕྱེ་བས་ངག་དང་།",
    "ཐིག་ལེ་བཞི་གནས་སྐབས་བཞིའི་རྣམ་རྟོག་གིས་ཕྱེ་བས་སེམས་དང་།",
    "གསང་གནས་ཆགས་པའི་གནས་ཡིན་པས་ཡེ་ཤེས་སོགས་ཞེས་གསུང་མོད།",
    "ཐུན་མོང་གི་རྣམ་དག་ནི།",
    "ནང་ལེའི་མངལ་དང་བཅས་པ་སོ་སོ་དང་ཐུན་མོང་ལ་སྦྱར་བའི་སྐུ་བཞི་དང་རྣམ་དག་སྦྱར་བ་རྣམས་ཀྱང་ལུགས་གཞན་གྱིས་སྐབས་འདིར་སྦྱར་མོད་ཀྱི་རྒྱུད་འགྲེལ་ཉིད་ནས་འདིར་བསྟན་གྱི་རྒྱུད་ཚིག་རྣམ་དག་ཉིད་དུ་གསུངས་པས་ན།",
    "གཞན་ཕུང་ཁམས་སོགས་ཀྱི་གཙོ་འཁོར་ཐུན་མོང་གི་རྣམ་དག་གོ།",
    "སྐུ་གསུང་ཐུགས་ཡེའི་ཐིག་ལེ་གཞོམ་མེད་བཞིའི་རང་གི་ངོ་བོ་སྐུ་བཞི་རྡོ་རྗེ་བཞིའི་སྒྲུབ་གཞི་ཁྱད་པར་ཅན་ཉེར་ལེན་གྱི་རྒྱུ་ཉིད་དུ་གནས་ཀྱང་།",
    "གཡས་གཡོན་རེ་རེའི་འཕོ་ཆུང་ལྔ་པོ་ནམ་མཁའ་ནས་སའི་བར་རིམ་པ་བཞིན།",
    "དེ་ནས་འཁྲིག་པ་སྤྱོད་པའི་བདེ་བ་རྫོགས་ཤིང་དེ་ལ་དམིགས་པས་ཐིག་ལེ་དང་ཕྲ་མོའི་རྣལ་འབྱོར་དུ་གསུངས་ཀྱི།",
    "དམན་པ་ལ་མོས་པ་ལ་ཆགས་བྲལ་གྱི་དང་།",
    "སྐལ་བཟང་སྐྱེ་བོས་གང་སྣང་ཐམས་ཅད་བདེ་ཆེན་གྱི་བདུད་རྩིར་འཆར་བའི་རྒྱུའི་གཙོ་བོ་ཡིན་པར་ཤེས་ནས་མངོན་གྱུར་རྒྱ་ཆེར་སྤེལ་ཏེ་ཉམས་སུ་མྱོང་བའི་བདེ་ཆེན་སྔགས་ལམ་གྱི་རང་བཞིན་ནི་ཡིན་པའི་ཕྱིར་རོ།",
    "བུད་མེད་ཕྱག་རྒྱ་སྒྱུ་མ་ནི།",
    "ཕྱག་རྒྱ་ཆེན་མོའི་དངོས་གྲུབ་ཅེས་ཕྱག་རྒྱ་གསུམ་ཉིད་དུ་བསྡུས་པ་མང་།",
    "སྐྲ་དང་ལན་བུ་སོགས་དང་ལྡན་པའི་ཕྱི་རོལ་གྱི་བུ་མོ་དང་།",
    "གསུམ་པ་ནང་གི་གཏུམ་མོ།",
