    "ཡོངས་སུ་མཁྱེན་པའི་བདེ་བའོ་ཞེས་གསུངས་ཏེ།",
    "དེ་ལ་དཔེར་ན་སྐྱེས་བུ་གང་ཟག་ཅེས་བྱ་བ་ལ་སོགས་པ་ནི་ཇི་ལྟར་གང་ཟག་གང་ལ་ལ་ཚེ་གཅིག་ཏུ་རྟག་པར་ཁ་བའི་རོ་ལ་བརྟེན་པ་རྣམས་སྤྲང་རྩིའི་རོ་ཁོང་དུ་ཆུད་པ་དང་།",
    "སྡུག་བསྔལ་རགས་པའི་རོ་ལ་བརྟེན་པས་རབ་ཏུ་བྱུང་བའི་བདེ་བ་ཚངས་པར་སྤྱོད་པ་རྔུཤིན་ཏུ་གྱ་ནོམ་པའི་རོ་ཁོང་དུ་ཆུད་པའམ།",
    "གལ་ཏེ་ཁྱིམ་ན་གནས་པར་གྱུར་ན་ནམ་འཚོའི་བར་དུ་ཚངས་པར་སྤྱོད་པ་རྗོཡོངས་སུ་དག་པ་སྤྱད་པར་མི་ནུས་པས།་",
    "ཆུང་མ་ཡོད་པར་སྟོན་ཀྱང་རྟག་པར་ཤིན་ཏུ་རྣམ་པར་དག་པའི་སྤྱད་པ་སྤྱོད་དོ་ཞེས་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྙེན་པར་རྫོགས་པའོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "དཔེ་འདི་གསུངས་པའི་དོན་ནི་འདི་ལྟར་འཇིག་རྟེན་པའི་ཁོང་དུ་ཆུད་པ་དང་།",
    "གཞན་ཡང་དེ་ཉིད་ལས་ཉ་པ་ཏུ་པ་ཀ་ཞེས་བྱ་བ་ཞིག་འདོད་པ་ཡོངས་སུ་བཙལ་བས་བསམ་་པ་བཞིན་དུ་མ་གྲུབ་པས་ཤིན་ཏུ་མྱ་ངན་གྱིས་ནོན་ཅིང་ཡིད་ལ་གཅགས་པར་གྱུར་ཏེ།",
    "དེའི་ཕྱིར་འདོད་པའི་མེའི་གདུང་བ་ཞེས་གསུངས་ཏེ།",
    "ཕྱི་རོལ་གྱི་རྣམ་པ་གཡེང་བ་ལས་རྣམ་པར་དབྱེ་བའི་ཕྱིར་ནང་ཞེས་བྱའོ།",
    "འདོད་པའི་ཁམས་ཀྱི་ཡུལ་ལྔ་པོ་དག་ལ་འདོད་ཆགས་པ་ཡོངས་སུ་སྤོངས་པས་ལུས་ཀུན་དུ་ཁྱབ་པར་ཀུན་དུ་བདེ་བར་གྱུར་པའི་ཕྱིར།",
    "དང་པོ་སྨོས་པ་ཉིད་ཀྱིས་ཕྱི་མ་ཡང་བསྟན་པར་འགྱུར་བས་སོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་འགྲེལ་པ་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཐམས་ཅད་ཡོད་པར་སྨྲ་བའི་གཞུང་དང་སྦྱར་ན།",
    "བསམ་གཏན་དང་པོའི་བདེ་བ་མི་ཐོབ་པ་དེ་བཞིན་དུ་གང་རྟོག་པ་དང་དཔྱོད་པ་དང་བཅས་པ་དེ་དག་ཀྱང་གཟུགས་ལ་སོགས་པའི་མཚན་ཉིད་དང་བྲལ་བ་མཚན་མ་མེད་པའི་དེ་བཞིན་ཉིད་ཁོང་དུ་ཆུད་པར་མི་ནུས་སོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "འགོག་པ་ལ་སྙོམས་པར་ཞུགས་པ་ན་སེམས་ཀྱི་འདུ་བྱེད་འགོག་པར་བྱེད་དོ།",
    "ངག་སློང་བར་མི་བྱེད་ལ་ངག་མི་སློང་བའི་ཕྱིར་རབ་ཏུ་དབེན་པ་འཕགས་པའི་མི་སྨྲ་བའི་བདེ་བ་ཞེས་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ཏེ་དེ་ནི་འདི་སྐད་དུ།",
    "བསམ་གཏན་གཉིས་པ་ཡན་ཆད་ཀྱི་འཕགས་པའི་མི་སྨྲ་བའི་བདེ་བ་ཁོང་དུ་ཆུད་པར་ནུས་པ་དེ་བཞིན་དུ།",
    "ཐ་སྙད་ཐམས་ཅད་ཡང་དག་པར་ཆད་པ།",
    "མ་འོངས་པ་ན་དོན་དམ་པར་སྡུག་བསྔལ་འདི་གཏན་དུ་ཞི་བའི་ཕྱིར་དང་།",
    "རྣམ་པར་ཤེས་པའི་ཐ་སྙད་བཞི་པོ་དག་ཉིད་དོ།",
    "ཕྱིས་འོག་ནས་རྣམ་པར་འབྱེད་དོ།",
    "གང་རྟོག་ཀྱེཔ་དང་དཔྱོད་པ་དང་བཅས་པ་དེ་དག་ཀྱང་ཐ་སྙད་ཀྱི་སྤྱོད་ཡུལ་ལ་སྤྱོད་པས་དོན་དམ་པའི་མཚན་ཉིད་ཐ་སྙད་ཡང་དག་པར་ཆད་པའི་ཡུལ་ཁོང་དུ་ཆུད་པར་མི་ནུས་སོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "དཔེ་དང་དོན་སྦྱར་བ་ནི་གོང་དུ་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "འདི་ཡང་རྣམ་པ་གཉིས་སུ་དབྱེ་སྟེ་ཚིགས་སུ་བཅད་པ་གསུངས་པའི་དགོངས་པ་བསྟན་པ་དང་།",
    "དང་པོ་ཚིག་གསུམ་གྱིས་ནི་མཚན་ཉིད་ལྔ་རྣམ་པར་ཕྱེ་སྟེ་བསྟན་ཏོ།",
    "དོན་དམ་བདེན་ཞེས་བྱ་བ་ལ་སོགས་པས་མཚན་ཉིད་རྣམ་པ་ལྔ་སྤྱིར་བྷུབསྟན་པའི་དོན་ནི་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "བཅོམ་ལྡན་འདས་ངོ་མཚར་ལགས་སོ།",
    "དེ་ནས་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་དེ་བཞིན་གཤེགས་པས་ལན་ཡང་དག་པར་གསུངས་པ་བསྟན་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ལེགས་པར་གསུངས་པ་ཡིན་པར་བསྔགས་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ལེགས་པར་གསུངས་པ་ཡིན་པར་བསྔགས་པ་ཡང་།",
    "ལེགས་པར་གསུངས་པ་ཡིན་པར་བསྔགས་པ་དང་།",
    "གཞན་ཡང་ཤིན་ཏུ་རྣམ་པར་དག་པའི་བློ་དང་ལྡན་ཞིང་།",
    "དེ་ཡང་བདག་ལ་ཕན་འདོགས་པའི་བསྔགས་པ་བརྗོད་པའི་ཕྱིར་ནི་བཅོམ་ལྡན་འདས་ངོ་མཚར་ལགས་སོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གཞན་ལ་ཕན་འདོགས་པའི་བསྔགས་པ་བརྗོད་པའི་ཕྱིར་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་ལེགས་པར་གསུངས་པ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "མཆོག་ཏུ་རྟོགས་པར་དཀའ་བ་དེ་ཁོ་ནའི་དོན་ཁོང་དུ་ཆུད་པས་དེའི་རྗེས་སུ་འཇུག་པ་དང་།",
    "བཏགས་པ་ཁོང་དུ་ཆུད་པར་འགྱུར་རོ།་།",
    "དེ་ལ་ལེགས་པར་གསུངས་ཞེས་བྱ་བ་ནི།",
    "གཞན་ཡང་དེ་ཉིད་ལས་ལེགས་པར་གསུངས་པ་ཞེས་བྱ་བ་ནི་རིགས་པ་དང་མཐུན་པར་གྱུར་པ་ཉིད་ཀྱི་ཕྱིར་དང་།",
    "དེ་བཞིན་གཤེགས་པས་གསུངས་པའི་བསྟན་པ་རྣམས་ནོ་ལེགས་པར་གསུངས་པ་ཞེས་བྱའོ་ཞེས་འབྱུང་སྟེ།",
    "རྟོགས་པར་དཀའ་བ་ཡིན་ནོ་ཞེས་བཀའ་སྤྲུལ་ཏོ་ཞེས་བྱ་བའི་བར་དུ་གསུངས་པས་སོ།",
    "ཐེག་རྔུཔ་གཉིས་ཀྱིས་ཤེས་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་ཤིན་ཏུ་ཟབ་པ་ཞེས་བྱའོ།",
    "གཅིག་པ་དང་ཐ་དད་པ་གཉིས་ཀར་རྟོགས་པའི་ཕྱིར་རྟོགས་པར་དཀའ་བའོ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་ཡུལ་ཡིན་པས་ཤེས་རབ་རྣམ་པ་གསུམ་གྱི་ཡུལ་མ་ཡིན་ཏེ།",
    "ཐ་དད་པ་ཉིད་བསམ་ཞིང་སྤྱོད་པ་དག་མཐོང་ལགས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་རྩོད་པ་མང་པོ་བསྟན་པ་ཞེས་བྱ་བ་སྟོན་ཏོ།",
    "གཅིག་ཏུ་འདུས་རྗོནས་རྩོད་པར་གྱུར་པ་སྤྱིར་བསྟན་པ་དང་།",
    "བརྟག་པ་རྣམ་པ་གསུམ་རྣམ་པར་ཕྱེ་སྟེ་བསྟན་པ་ལས།",
    "བསྐལ་པ་གྲངས་མེད་པ་དང་པོས་བསྒོམས་པ་ཡོངས་སུ་སྡོགས་པར་འགྱུར་རོ་ཞེས་འབྱུང་ངོ།",
    "ས་འདི་ལ་ད་དུང་དེ་བཞིན་ཉིད་མངོན་སུམ་དུ་མ་བྱས་པས་རྩོད་པ་འདི་ལྟ་བུ་ཡོད་པར་གྱུར་ཏོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདུ་བྱེད་རྣམས་ཀྱི་མཚན་ཉིད་ཐ་དད་པ་མ་མཆིས་སོ་ཞེས་མཆི་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་བརྟགས་པ་རྣམ་པ་གསུམ་རྣམ་པར་འབྱེད་དེ་བསྟན་པ་སྟོན་ཏོ།",
    "འདུ་བྱེད་རྣམས་ཀྱི་མཚན་ཉིད་ཐ་དད་པ་མ་མཆིས་པ་མ་ལགས་ཀྱི།",
    "གང་ནི་ཤོ་བེ་མཆི་བ་ལགས།",
    "གང་ནི་ཚུལ་བཞིན་དུ་སྤྱོད་པ་ལགས།",
    "གང་ནི་ཚུལ་བཞིན་དུ་མི་བགྱིད་པ་ལགས་ཞེས་མཆི་བ་དང་།",
    "ཟླས་ཁོང་དུ་ཆུད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདིར་གསུངས་པའི་གཅིག་པ་དང་།",
    "ཐ་དད་པར་འཛིན་པ་གཉིས་པོ་འདི་ནི་རྣམ་པར་གཡེང་བ་བཅུ་ལས་གཅིག་པ་དང་ཐ་དད་པར་འཛིན་པ་ཞེས་བྱ་བ་ཉིད་དོ།"
  ]
