    "རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པའི་བསྟན་བཅོས་ལས་ཇི་སྐད་དུ།",
    "ཞིབ་པར་འཇུག་པའི་ངོ་བོ་ཉིད་དོ།",
    "རྒྱ་ཆེར་ནི་རྣམ་པར་འབྱེད་པ་ནི་རྣལ་འབྱོར་སྤྱོད་པའི་ས་དང་།",
    "རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པའི་བསྟན་བཅོས་ལ་སོགས་པ་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "གཉིས་པ་ནི་འདིར་གསུངས་པའི་རྟོག་དཔྱོད་ཉིད་དེ།",
    "ཁམས་གསུམ་པའི་ཟག་པ་དང་བཅས་པའི་སེམས་ལ་སོགས་པ་ལ་བྱ་བས་དེའི་ཕྱིར་རྟོག་དཔྱོད་ཅེས་གསུངས་པ་ཡིན་ནོ་ཞེའོ།",
    "དཔྱོད་པ་ཐམས་ཅད་ཀྱི་སྤྱོད་ཡུལ་གྱི་མཚན་ཉིད་ཐམས་ཅད་ལས་ཡང་དག་པར་འདས་པ་ཡིན་པར་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་མཇུག་བསྡུ་བ་སྟེ་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "གཞན་ཡང་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་དངོས་པོ་ལྔ་པོ་དེ་དག་ལས་རྣམ་པ་དུ་ཞིག་ནི་འཛིན་པའི་སྤྱོད་ཡུལ་ཀྱི་དོན་ཡིན་པར་བལྟ་བབར་བྱ་ཞེ་ན།",
    "དེ་ལ་དང་པོ་ནི་ཐ་སྙད་སད་པར་བྱེད་པ་དང་བཅས་པའོ།་།",
    "འོག་ནས་ངོ་བོ་ཉིད་མེད་པ་བསྟན་པའི་ལེའུ་ལས་རྒྱ་ཆེར་རྣམ་པར་འབྱེད་དོ།",
    "རྟོག་པ་དང་དཔྱོད་པ་ནི་རྣམ་པར་རྟོག་པའི་ངོ་བོ་ཉིད་ཡིན་པས་དེའི་མཚན་མ་མེད་པའི་དེ་བཞིན་ཉིད་ཁོང་དུ་མི་ཆུད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དོན་དམ་པ་ནི་རྟོག་པ་དང་དཔྱོད་པའི་སྤྱོད་ཡུལ་གྱི་མཚན་ཉིད་ལས་ཡང་དག་པར་འདས་པ་ཡིན་པར་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་མཇུག་བསྲུ་བ་སྟེ་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "འདི་ལྟར་དེ་བཞིན་ཉིད་ཀྱི་དོན་དམ་པ་ནི་འདུས་བྱས་དང་།",
    "འདུས་མ་བྱས་ལ་སོགས་པ་ཡོངས་སུ་སྤང་བའི་པེཕྱིར་རོ།",
    "དུས་གསུམ་དང་འདུས་མ་བྱས་དང་བརྗོད་དུརྔེད་པ་དང་།",
    "མེ་ཞེས་བརྗོད་པ་ན་ལྕེ་ཚིག་པར་འགྱུར་བ་དང་།",
    "ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་དག་འདོད་པ་དང་མཐུན་ནོ།",
    "གང་བྱས་པ་དེ་དག་ནི་མི་རྟག་པར་སྣང་སྟེ།",
    "རྟག་པ་གང་ཡིན་པ་དེ་དག་ནི་བྱས་པ་མ་ཡིན་པར་སྣང་སྟེ།",
    "དེ་ལ་འདི་ལྟར་རྟག་འུཔ་ཞེས་བྱ་བ་དེས་ནི་མི་རྟག་པ་མ་ཡིན་པར་སྟོན་ཏོ།",
    "བྱས་པ་མ་ཡིན་ཞེས་བྱ་བ་དེས་ནི་བྱེད་པ་མེད་པར་བསྟན་ཏེ།",
    "དེའི་ཕྱིར་མི་མཚུངས་པའི་དཔེ་རྣམས་ནི་བརྗོད་པ་དགག་པར་བྱ་བ་ཡིན་པར་རིག་པར་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "གཞན་ཡང་དེ་ཉིད་ལས་གཞན་ཡང་བརྗོད་པ་དགག་པའི་ཚིག་ནི་དགག་པར་བྱ་བ་བཀག་པས་མཆོག་ཏུ་གྱུར་པ་ཡིན་ཏེ།",
    "སྐྱེ་བ་མེད་པ་ནི་དགག་པར་འགྱུར་བ་མ་ཡིན་པས།",
    "ཆད་པ་དང་རྟག་པ་མ་ཡིན་པ་ལ་སོགས་པ་དེ་ཡང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "མིང་ངེས་པ་མེད་པས་བདག་ཉིད་འདྲེས་པར་འགལ་བའི་ཕྱིར་རོ་ཞེས་འབྱུང་སྟེ།",
    "རྒྱ་ཆེར་རྣམ་པར་འབྱེད་པ་རྒོ་སློབ་དཔོན་དབྱིག་གཉེན་དང་།",
    "རྣམ་པར་རྟོག་པ་ཡོངས་སུ་ཆད་པར་གྱུར་ན།",
    "དྲི་མ་མེད་པར་སགྲགས་པ་ཅང་མི་སྨྲ་བར་གྱུར་ཏོ་ཞེས་གསུངས་ཏེ།",
    "ངོ་བོ་ཉིད་དང་བྱེ་བྲག་ཏུ་གདགས་པ་གནང་བའི་དངོས་པོར་ཡོད་པ་ནི་མ་ཡིན་ནོ།",
    "སྨྲས་པ་བརྗོད་དུ་མེད་པ་དེ་བརྗོད་དུ་མེད་དོ་ཞེས་དམ་བཅས་པའི་ཚེ་ཁོ་ན་དགག་པ་ཤིབྱས་ཟིན་པས་དེའི་ཉེས་པ་མེད་དེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་༧གཞན་དག་ལ་ཇི་ལྟར་སྟོན་པར་མཛད་ཅེ་ན།",
    "སློབ་དཔོན་ཉེ་བའི་འོད་ནི་ས་བརྒྱད་པ་ཡན་ཆད་རྟོག་དཔྱོད་ལ་མི་བརྟེན་པར་བརྗོད་པ་འབྱུང་སྟེ།",
    "དོན་དེ་ནི་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "རྟོག་པ་དང་དཔྱོད་པ་ནི་ཐ་སྙད་ཀྱི་སྤྱོད་ཡུལ་ལ་སྤྱོད་པས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་བཞི་པ་དངོས་པོ་ཐམས་ཅད་ཡང་དག་པར་ཆད་པ་ཞེས་བྱ་བ་སྟོན་ཏོ།",
    "འདིས་ནི་དོན་དམ་པ་ནི་མིང་ལ་སོགས་པ་དང་བྲལ་བའི་ཕྱིར་མཐོང་བ་ལ་སོགས་པའི་སྤྱོད་ཡུལ་རྣམ་པ་བཞིས་བསྟན་པར་བྱ་བ་མ་ཡིན་པར་བསྟན་ཏེ།",
    "མཐོང་བ་ལ་སོགས་པ་བསྟན་པར་བྱ་བའི་ཡུལ་མ་ཡིན་པས།",
    "ཚིག་ལེའུར་བྱས་པ་ལས།",
    "གཞན་ཡང་རྣམ་པར་ཤེས་པ་གསུངས།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པས་མྱོང་བ་གང་ཡིན་པ་དེ་ནི་ཐོས་པའོ།",
    "རྣམ་པར་ཤེས་པ་གསུམ་གྱིས་མྱོང་བ་གང་ཡིན་པ་དེ་ནི་བྱེ་བྲག་ཕྱེད་པའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་མྱོང་བ་གང་ཡིན་པ་དེ་ནི་རྣམ་པར་ཤེས་པའོ་ཞེས་འབྱུང་ངོ།",
    "བསྟན་བཅོས་སེམས་སྣ་ཚོགས་བསྟན་པའི་ཚིག་ལེའུར་བྱས་པ་ལས།",
    "ཤེས་པ་ཉིད་དུ་ཡང་དག་པར་འགྲུབ་པ་ཉིད་དུ་འགྱུར་བས་སོ།",
    "གལ་ཏེ་དེ་ལྟར་ཞུམ་ཡིན་ན་དགྲ་བཅོམ་པ་ཐ་མའི་དྲན་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཉིད་དུ་གྲུབ་པར་མི་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "ཡིད་ཀྱི་ཁམས་ཀྱི་རྗེས་སུ་སྐྱེས་པའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ཡང་།",
    "རྣམ་པར་ཤེས་པ་ལ་བྱེ་བྲག་ཅི་ཡོད་ཅེ་ན།",
    "རྣམ་པར་ཤེས་པ་ནི་རྗེས་སུ་དཔག་པའི་ཤེས་པ་གང་ཡིན་པའོ།",
    "བྱེ་བྲག་ཕྱེད་པ་ནི་རྣམ་པར་རྟོག་པ་གང་ཡིན་པའོ།",
    "ཡུལ་ལ་མི་བརྟེན་པར་ལུང་ལ་བརྟེན་ནས་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་ཐོས་པ་ཞེས་བྱ་བས།",
    "སེམས་སྔ་མའི་གསུམ་པའི་རྗེས་ལ་ཡང་ནས་ཡང་དུ་རྣམ་པར་རྟོག་པའི་སེམས་གང་ཡིན་པ་དེ་ནི་བྱེ་བྲག་ཕྱེད་པ་ཞེས་བྱའོ།",
    "དེ་ཡང་ཇི་ལྟར་རྣམ་པར་རྟོག་ཅེ་ན།",
