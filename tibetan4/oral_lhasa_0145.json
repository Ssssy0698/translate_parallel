    "ཞིབ་ཏུ་རྣམ་པར་དབྱེ་བ་ནི་སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དྲི་བ་ཡང་དག་པར་དྲིས་པའོ།",
    "བཏགས་དུཔའི་མིང་དང་འདུ་ཤེས་ཀྱི་འདུས་བྱས་ཞེས་བྱ་བ་དང་།",
    "འདུས་མ་བྱས་ཞེས་བྱ་བར་བརྗོད་པར་གྱུར་པ་ཡིན་ཞེས་བྱ་བ་ནི་གཉིས་པ་དྲི་བ་ཡང་དག་པར་དྲིས་པ་ཞེས་བྱ་བ་སྟོན་ཏོ།",
    "དེའི་ཕྱིར་སྟོན་པས་བརྗོད་དུ་མེད་པ་ལ་བཏགས་པ་ཙམ་དུ་འདུས་བྱས་ཞེས་གསུངས་སོ།",
    "ཡང་དག་པ་མ་ཡིན་པའི་ཕྱིར་འདུས་བྱས་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདུས་བྱས་ཀྱང་མ་ཡིན་ནོ་ཞེས་བསྟན་ཏོ།",
    "རིགས་ཀྱི་བུ་འདུས་མ་བྱས་ཞེས་བྱ་བ་དེ་ཡང་ཐ་སྙད་ཀྱི་ཁོངས་སུ་གཏོགས་པ་ཡིན་ལ་ཞེས་བྱ་བ་ནི།",
    "གཉིས་པ་འདུས་མ་བྱས་དགག་པ་ཞེས་བྱ་བ་སྟོན་ཏོ།",
    "འདུས་མ་བྱས་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།་",
    "དུས་གསུམ་གྱི་འདུས་མ་བྱས་དང་།",
    "བརྗོད་དུ་མེད་པའི་འདུས་བྱས་ཀྱི་དུས་གསུམ་དང་།",
    "འདུས་མ་བྱས་དུས་གསུམ་དུ་གཏོགས་པ་མ་ཡིན་པའོ།",
    "དེའི་ཕྱིར་འདུས་བྱས་ཀྱང་མ་ཡིན་འདུས་མ་བྱས་ཀྱང་མ་ཡིན་པ་ཞེས་བྱ་བ་སྟེ།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་མ་གཏོགས་པ་གང་ཅི་བརྗོད་ཀྱང་རུང་བའི་བདག་རྟག་པར་གནས་པར་འདོད་པ་དེའི་མཚན་ཉིད་ཀྱང་མིང་དང་།",
    "ཡི་གེའི་གྲངས་སུ་ལྷུང་བའི་ཕྱིར་རྫས་སུ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདུས་མ་བྱས་ཀྱང་མ་ཡིན།",
    "དེ་བཞིན་གཤེགས་པས་འདུས་བྱས་དང་།",
    "འདུས་མ་བྱས་ཞེས་གསུངས་པ་འདི་ལ་ཡང་དངོས་པོ་མེད་པར་འགྱུར་རོ་ཞེས་ཐེ་ཚོམ་ཟ་ནས་རྒོལ་བའོ།",
    "སྟོན་པས་བསྟན་པ་གསུངས་པ་ལ་ཅི་དོན་མེད་དམ་ཞེས་འབྱུང་ངོ།",
    "འདི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་འདུས་བྱས་དང་།",
    "བརྗོད་པ་ཡོད་པར་གྱུར་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དངོས་པོ་མེད་པ་ལས་བརྗོད་པ་ཡོད་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "ཟག་པ་མེད་པ་འཕགས་པའི་ལམ་དང་ཡང་དག་པར་ལྡན་པས།",
    "མྱ་ངན་ལས་འདས་པར་ཕྱིན་པའི་ཕྱིརཛེེ།",
    "ཤེས་པ་དང་མཐོང་བ་རྣམ་པ་གཉིས་གཅིག་ཏུ་བསྡུས་ཏེ་གསུངས་པའི་དགོངས་པ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་འགྲེལ་པ་ལས་རྣམ་པར་གྲོལ་བའི་ཤེས་པ་དང་།",
    "ཇི་ལྟར་ཐག་པ་གཉིས་གཅིག་ཏུ་བྱས་ནས།",
    "ཤེས་པ་འདིས་ཤེས་པར་འགྱུར་རོ།",
    "མཐོང་བ་ཞེས་བྱ་བས་ནི་རྗེས་སུ་དཔག་པའི་ཤེས་པ་ལས་རྣམ་པར་འབྱེད་པས།",
    "སྟོན་པས་གསུངས་པ་ཐམས་ཅད་ཀྱང་དོན་མེད་པ་ཞིག་ཏུ་མི་འགྱུར་རམ་ཞེ་ན།",
    "སྨྲས་པ་ངོ་བོ་ཉིད་ཡང་དག་པར་ཡོད་དོ་ཞེས་བརྗོད་དུ་མེད་པ་དང་།",
    "དང་པོ་ནི་དེ་ཁོ་ནའི་རྣལ་འབྱོར་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ལ་གནས་པ་ན།",
    "དེའི་ཚེ་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར་བརྗོད་དུ་མེད་པའོ།",
    "གསུམ་པ་ནི་གལ་ཏེ་ཐ་སྙད་ངེས་པར་གྱུར་ན།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་དང་བྲལ་བར་མི་འགྱུར་ལ།",
    "གལ་ཏེ་སྔ་ན་འདུས་བྱས་དང་འདུས་མ་བྱས་མ་ཡིན་ན།",
    "ཅིའི་ཕྱིར་འདུས་བྱས་དང་འདུས་མ་བྱས་ཞེས་བརྗོད་ཅེས་ཐེ་ཚོམ་ཟ་བ་དང་།",
    "གལ་ཏེ་འདུས་བྱས་དང་འདུས་མ་བྱས་ཡོད་པ་མ་ཡིན་ནམ།",
    "གཞན་དག་རྟོགས་པར་བྱ་བའི་ཆེད་དུ་ཐ་སྙད་བླང་བའི་དངོས་པོའོ།",
    "འདི་ལྟ་སྟེ་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་སྒྱུ་མའི་དངོས་པོ་རྣམ་པར་ཕྱེ་སྟེ་བསྟན་པའོ།",
    "གཉིས་སུ་མེད་པའི་དེ་བཞིན་ཉིད་ཁོང་དུ་མ་ཆུད་ནས་ཡང་དག་པར་ཡོད་པ་ཉིད་དུ་འཛིན་གྱིས།",
    "འཕགས་པ་རྣམས་ནི་འདི་ཡང་དག་པར་ཡོད་པ་མ་ཡིན་པར་གསལ་བར་ཁོང་དུ་ཆུད་པ་དཔེ་བསྟན་པ་ཡིན་ཏེ།",
    "གཞན་ཡང་སློབ་དཔོན་ཡང་དག་བདེན་པས་འཕགས་པ་གསེར་འོད་དམ་པའི་བརྗེད་བྱང་བྱས་པ་ལསདེ་ལ་སྒྱུ་མ་མཁན་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་དཔེ་སྟེ།",
    "རྟེན་བསྟན་ཏེ་འདི་ལྟར་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་ས་བོན་རྣམས་བསགས་པ་གནས་པའི་དཔེ་བསྟན་པའོ།",
    "དེ་ནི་རྣམ་པར་ཤེས་པ་བརྒྱད་པོ་དག་གོ།",
    "གཉིས་པ་ནི་ལས་དང་པོ་པས་རྣམ་པར་བརྟག་པར་བྱ་བའི་ལམ་སྟེ།",
    "དེ་ནི་རྣམ་པར་ཤེས་པའི་གནས་བཞིའོ།",
    "དེ་དག་ལ་ཡང་དག་པར་བསྐུལ་བའོ།",
    "མུ་སྟེགས་ཅན་ལྟ་བ་བསྐྱེད་པར་ནུས་པ་རྣམས་སོ་ཞེས་འབྱུང་ངོ།",
    "སྤྲུལ་པ་དང་སྒྱུ་མའི་དངོས་པོ་དག་ནི་ལས་ཀྱི་རྣམ་པར་སྨིན་པའི་དཔེ་བསྟན་པའོ།",
    "ཡང་ན་རྣམ་པར་ཤེས་པ་ལས་གྱུར་པའི་དངོས་པོ་རྣམ་པ་སྣ་ཚོགས་ཀྱིའོ།",
    "གླང་པོ་ཆེའི་ཚོགས་སྣང་བ་གང་ཡིན་པ་འདི་ནི་ཡང་དག་པར་ཡོད་དོ།",
    "ཕྱིས་སྒྱུ་མ་དེ་དག་རྔེད་པར་གྱུར་ན་ཡང་ལེགས་པར་བརྟགས་ནས་བྲགདོད་ཡང་དག་པ་མ་ཡིན་པར་ཤེས་པར་འགྱུར་བའོ།",
    "འདི་ཡང་རྣམ་པ་ལྔར་དབྱེ་བས་གོང་མ་ལས་བཟློག་པ་ལས་རིག་པར་བྱ་སྟེ།",
    "ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཡུལ་བསྟན་པ་དང་།",
    "ཁོང་དུ་ཆུད་པ་ཉིད་ཡང་དག་པར་བསྟན་པ་དང་།",
    "ཡང་བརྟག་མི་དགོས་པར་བསྐུལ་བའོ།་",
    "སྤྲུལ་པའི་དངོས་པོ་དག་ཅེས་བྱ་བས་ནི་གཉིས་པ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཡུལ་བསྟན་ཏེ།",
    "གླང་པོ་ཆེའི་ཚོགས་སྣ་ཚོགས་གང་ཡིན་པ་འདི་ནི་ཡང་དག་པར་མེད་དོ།",
