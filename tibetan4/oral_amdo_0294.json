    "བུ་མོ་དཔལ་གྱི་བློ་གྲོས་མ་ཞེས་བྱ་བ་གཉིས་ཤིག་འཁོད་ཀྱིས་དེའི་གན་དུ་སོང་ལ།",
    "བྲམ་ཟེ་ཞི་འཛིན་མཆོག་གི་དྲུང་ནས་སོང་ངོ།",
    "མདུན་དུ་འདུག་ནས་ཐལ་མོ་སྦྱར་ཏེ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཞེས་བདག་གིས་ཐོས་ན།",
    "ཇི་ལྟར་ནན་ཏན་དུ་བགྱི་བ་འཕགས་པ་དག་གིས་བདག་ལ་བཀའ་སྩལ་དུ་གསོལ།",
    "བུ་མོ་དཔལ་གྱི་བློ་གྲོས་མས་ཚོང་དཔོན་གྱི་བུ་ནོར་བཟངས་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ལས་དང་ཉོན་མོངས་པ་སྒྱུ་མར་ཤེས་པས།",
    "ཕྱིན་ཅི་ལོག་གི་སྒྱུ་མ་ལས་བྱུང་བས་ཁམས་གསུམ་ཐམས་ཅད་ཀྱང་སྒྱུ་མའི་རྣམ་པར་མཐོང་ངོ།",
    "འདུ་ཤེས་དང་སེམས་དང་ལྟ་བ་ཕྱིན་ཅི་ལོག་གི་རྒྱུ་ལས་དངོས་པོ་མྱེད་པའི་འདུ་ཤེས་ཀྱིས་རྨོངས་ཏེ།",
    "ཡོན་ཏན་བརྗོད་པར་ནུས་རེ་སྐན།",
    "སོང་རིགས་ཀྱི་བུ་ལྷོ་ཕྱོགས་ཀྱི་རྒྱུད་འདི་ཉིད་ཀྱི་ཕྱོགས་ཀྱི་སྒོའི་གནས་རྒྱ་མཚོའི་འགྲམ་ཞེས་བྱ་བ་དེ་ན་བཟའ་ཤིང་གི་ར་བ་རྒྱན་ཆེན་པོ་ཞེས་བྱ་བ་ཡོད་དེ།",
    "ལུང་བསྟན་པ་གཅིག་གིས་མཐར་ཐུག་པས་རྒྱུན་གཅད་པར་མ་བྱེད་ཅིག།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ཞི་བར་བྱེད་པའོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ཀྱིས་མི་སྐྱོ་བའི་ཕྱིར་མ་མ་ལྟ་བུའི་སེམས་དང་།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདག་ལ་ནི་དྲོན་པོའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདག་ལ་ནི་ཕ་རོལ་ཏུ་འགྲོ་བའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདག་ལ་ནི་ཞིང་པའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདག་ལ་ནི་དབུལ་པོའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདག་ལ་ནི་འཇིགས་པའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདག་ལ་ནི་ཚོང་བའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདག་ལ་ནི་བུ་དམ་པའི་འདུ་ཤེས་བསྐྱེད་པརབྱའོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་བདག་ལ་ནི་རྒྱལ་པོ་གཞོན་ནུའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་དེ་ལྟ་བུའི་འདུ་ཤེས་ཡིད་ལ་བྱ་བ་ཡོངས་སུ་སྒོམ་སྟེ།",
    "བུ་མོ་དཔལ་གྱི་བློ་གྲོས་མ་གཉིས་ལ་ལན་བརྒྱ་སྟོང་དུ་མར་གཡས་ཕྱོགས་སུ་བསྐོར་བ་བྱས་ནས།",
    "བུ་མོ་དཔལ་གྱི་བློ་གྲོས་མའི་དྲུང་ནས་སོང་ངོ།",
    "སྔོན་གྱི་མཐའི་མུར་ཐུག་པའི་ཡོངས་སུ་རྟོག་པ་ཡང་དག་པ་མ་ཡིན་པར་རྣམ་པར་བརྟགས་པ་ལས་བྱུང་བ་ཕྱིན་ཅི་ལོག་གིས་ཡིད་ལ་བྱ་བ་ཀུན་ནས་གླགས་པ་ལ་བསམ་པས་ནི།",
    "འདས་པའི་ལུས་ཀྱིས་བདག་གི་དོན་གྱི་སྦྱོར་བ་ལ་རྩོམ་རྩོམ་པའི་ཡུལ་ལ་ཡོངས་སུ་བསམ་པས་ནི།",
    "སྔོན་གྱི་མཐའི་མུར་ཐུག་པའི་འགྲོ་བ་ལྔའི་རྒྱུད་ཀྱི་ངན་སོང་དུ་བདག་དང་གཞན་བོར་བ་ལ་བརྟག་པས་ལུས་འཚོ་བ་མེད་པ་ཡོངས་སུ་གཟུང་བ་ལ་ཡང་དག་པར་བསམ་པས་ནི།",
    "འདུ་ཤེས་ཀྱི་རྗེས་སུ་སོང་བ་དེ་ལྟ་བུའི་ཡིད་དང་ལྡན་པ་དང་།",
    "མངོན་སུམ་དུ་གནས་པ་རྒྱུན་མི་འཆད་པར་ཡེ་ཤེས་ཀྱི་ལུས་ཐ་མི་དད་པའི་ཚུལ་ལ་འཇུག་པ་ཐམས་ཅད་ཀྱི་རྗེས་སུ་སོང་བ་དང་།",
    "ཡང་དག་པའི་མཐའ་ཐམས་ཅད་ཀྱི་རྗེས་སུ་སོང་བ་དང་།",
    "རྐྱེན་དང་རྟེན་པའི་རྒྱུད་དངོས་པོ་མེད་པའི་རང་བཞིན་དང་མཉམ་པའི་མཉམ་པ་ཉིད་ཀྱིས་ལས་ཇི་ལྟ་བ་བཞིན་དུ་ཡོངས་སུ་བྱུང་བའི་རྣམ་པར་སྨིན་པ་ལ་ནི་མོས་པར་བྱེད།",
    "རྒྱུ་ཇི་ལྟ་བ་བཞིན་དུ་ཡོངས་སུ་བྱུང་བའི་འབྲས་བུ་ལ་ནི་མོས་པར་བྱེད།",
    "བསྩགས་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཡོངས་སུ་བྱུང་བའི་བྱ་བ་ཐམས་ཅད་ལ་ནི་མོས་པར་བྱེད།",
    "དང་བ་ལས་ཡོངས་སུ་བྱུང་བའི་དེ་བཞིན་གཤེགས་པ་བྱུང་བ་ཐམས་ཅད་ལ་ནི་མོས་པར་བྱེད།",
    "རིམ་གྲོ་ལས་བྱུང་བའི་དེ་བཞིན་གཤེགས་པའི་སྤྲུལ་པ་ཐམས་ཅད་ལ་ནི་མོས་པར་བྱེད།",
    "ཤེས་རབ་དང་ཐབས་ལས་ཡོངས་སུ་བྱུང་བའི་རྒྱན་ཡིད་ཀྱི་རང་བཞིན་ཏུ་བསྒྲུབས་པ་ཐམས་ཅད་ལ་ནི་མོས་པར་བྱེད།",
    "ཕྱིན་ཅི་ལོག་མེད་པའི་ཡེ་ཤེས་ཕྱིན་ཅི་ལོག་གི་ལྟ་བ་དང་བྲལ་བ་དང་།",
    "ཐལ་མོ་སྦྱར་ཏེ་ལན་བརྒྱ་སྟོང་དུ་མར་གཡས་ཕྱོགས་སུ་བསྐོར་བ་བྱས་ནས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་ལ་འཇུག་པའི་གནས་ལ་རྣམ་པར་སྤྱོད་པ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ཞི་ཞིང་ཉེ་བར་ཞི་བའི་གནས་ལ་རྣམ་པར་སྤྱོད་པ།",
    "གང་དེ་དག་དུས་ཐམས་ཅད་ལ་སྐད་ཅིག་གཅིག་གིས་འཇུག་པའི་གནས་ལ་རྣམ་པར་སྤྱོད་པ།",
    "གང་དེ་དག་སེམས་བསྐྱེད་པ་གཅིག་གིས་ཞིང་ཐམས་ཅད་དུ་འགྲོ་བའི་གནས་ལ་རྣམ་པར་སྤྱོད་པ།",
    "གང་དེ་དག་ཐོབ་པར་བྱ་བ་ཐམས་ཅད་རང་ལ་རག་ལས་པའི་གནས་ལ་རྣམ་པར་སྤྱོད་པ་དེ་དག་གི་གནས་སོ།",
    "གང་དེ་དག་སྐྲའི་རྩེ་མོ་གཅིག་ནས་མི་གཡོ་ཡང་།",
    "འདི་ནི་ཟབ་མོའི་གནས་ལ་རྣམ་པར་སྤྱོད་པ་མི་གཉིས་པའི་གནས་ལ་རྣམ་པར་སྤྱོད་པ།",
    "གང་དེ་དག་བྱམས་པའི་གནས་ལ་རྣམ་པར་སྤྱོད་ཀྱང་ཞེ་སྡང་གི་དྲི་མའི་རྗེས་སུ་སོང་བའི་སེམས་མེད་པ་དང་།",
    "བདག་གིས་རིག་པའི་རྣམ་པར་གྲོལ་བ་མངོན་ཏུ་མི་བྱེད་པ་དང་།",
    "གང་རྣམས་ངན་སོང་རྒྱུད་དུ་འགྲོ་བ་སོང་གྱུར་ཏེ།",
    "བྱམས་པའི་འོད་ཀྱིས་ངན་སོང་ཐམས་ཅད་ཞི་མཛད་པ།",
    "འཇིག་རྟེན་གཟིགས་ཤིང་ཐར་ལམ་རབ་ལ་འགོད་མཛད་པ།",
    "འགྲོ་བ་བདུད་ཀྱི་ཞགས་པས་ཡོངས་སུ་བཅིངས་གཟིགས་ཤིང་།",
    "གང་གིས་འགྲོ་མང་སྡུག་བསྔལ་མགོན་མེད་གྱུར་པ་རྣམས།",
    "ཉོན་མོངས་གཏོས་སུ་ལྷུང་སྟེ་ཚམ་གྱི་མཚོར་ལྷུང་བ།",
    "གང་གིས་ཉོན་མོངས་རྒྱ་མཚོ་སྤྱོད་པའི་འགྲོ་གཟིགས་ཤིང་།",
    "བརྗོད་དུ་མེད་པ་སྐད་ཅིག་རེ་རེ་རྟོགས་བྱས་ཤིང་།",
    "བསྐལ་པར་སེམས་རྒྱུད་གཅིག་གིས་རབ་ཏུ་འཇུག་པ་བྱེད།",
    "མ་གཡོས་ལུས་ཀྱིས་སྐྱིལ་མོ་ཀྲུང་དུ་འཁོད་བཞིན་དུ།",
    "དེ་དག་སྐད་ཅིག་གཅིག་གིས་ཀྱང་།",
    "བདག་གིས་བརྗོད་པར་མི་ནུས་ཏེ།"
  ]
}