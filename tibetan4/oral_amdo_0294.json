    "ཁྱོད་ནི་དགའ་བ་མཆོག་དང་ལྡན་འགྱུར་རམ།",
    "སྐྱེ་བོ་ཉོན་མོངས་རྣམས་ཀྱིས་འཁོལ་གྱུར་ལ།",
    "དེ་ནས་བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པའི་མ་སྤྲུལ་འཚོང་མའི་གཙོ་མོ་བལྟ་ན་སྡུག་པས་རྒྱལ་བུ་གཞོན་ནུ་གཟི་བརྗིད་ཀྱི་བདག་པོ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "གཞོན་ནུ་བདག་གི་བུ་མོ་འདི་ནི་རྫུས་ཏེ་བྱུང་བ།",
    "པད་མོའི་ནང་ནས་སྐྱེས་པ་སྟེ།",
    "བུ་མོ་འདི་ལ་ཁྱོད་ཀྱིས་གང་སྨྲས་པ།",
    "དེ་ནི་བདག་གིས་རིམ་པས་ཁྱོད་ལ་བརྗོད།",
    "ཇི་ལྟར་བུ་མོ་འདི་སྐྱེས་བསྐྱེད་བསྐྱེད་པ།",
    "བདག་གིས་ཁྱོད་ལ་གསོལ་གྱིས་གསན་དུ་གསོལ།",
    "གང་ཚེ་དགུང་སངས་ཁྱོད་ནི་བལྟམ་གྱུར་པ།",
    "དེ་ཚེ་བདག་གི་བུ་མོ་འདི་སྐྱེས་ཏེ།",
    "རོལ་མོ་གླུ་ལ་ཤིན་ཏུ་བསླབས་པ་ཡི།",
    "བུ་མོ་བརྒྱ་ཕྲག་བརྒྱད་དང་བདག་ཀྱང་ལྡན།",
    "ས་ཕྱོགས་དེ་ན་བུད་མྱེད་མང་པོ་དང་།",
    "ཆབ་དབུས་དེ་ནས་རིན་ཆེན་པད་མོའི་མཆོག།",
    "དགུང་སངས་གྱུར་ནས་པད་མོ་ཆེན་པོ་དེ།",
    "བུད་མྱེད་རིན་ཆེན་འདི་འདྲ་འཇིག་རྟེན་དུ།",
    "དཔལ་ལྟར་དྲི་མྱེད་པད་མོའི་མཆོག་ལས་སྐྱེས།",
    "བུད་མེད་རིན་ཆེན་འཇིག་རྟེན་འདིར་བྱུང་སྟེ།",
    "ཁྱོད་མ་གཏོགས་པར་མི་ཡི་འཇིག་རྟེན་ན།",
    "ཁྱོད་ཀྱི་ཞལ་སྔར་བུ་མོ་འདི་བཞེས་གསོལ།",
    "ཡན་ལག་སྐྱོན་བྲལ་འདི་ནི་ཁྱོད་ལ་འོས།",
    "འཕོང་གི་ཆོ་ག་རྣམ་པར་ངེས་པར་རྟོགས།",
    "འདི་ནི་ཁྱོད་ཀྱི་ཕྱག་རྗེད་ཁྱོད་ལ་འོས།",
    "རོལ་མོ་སིལ་སྙན་དག་གི་ཐབས་རྣམས་དང་།",
    "བཞད་གད་རོལ་མོའི་ཚུལ་ལ་རྣམ་པར་མཁས།",
    "འཇིག་རྟེན་བུད་མེད་སྒྲ་རྣམས་ཇི་སྙེད་པ།",
    "བུད་མྱེད་སྐྱེ་བོའི་སྐྱོན་དུ་བགྱི་བ་རྣམས།",
    "ཁྱོད་ཀྱི་དགོངས་པ་ཡོངས་སུ་རྫོགས་པར་བགྱིད།",
    "ཁྱོད་ཀྱི་སྤྱོད་མཐུན་རྗེས་སྙེགས་ཚུལ་དང་མཐུན།",
    "རྒྱལ་སྲས་ཁྱོད་ལ་འདི་ནི་ཚུལ་དང་འཐུན།",
    "བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པའི་མ་སྤྲུལ་འཚོང་མའི་གཙོ་མོ་བལྟ་ན་སྡུག་པའི་མདུན་དུ།",
    "བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཕྱི་ནང་གི་དངོས་པོ་གང་ཅི་རུང་སྟེ།",
    "ཡོངས་སུ་མི་གཏང་བ་དེ་ལྟ་བུ་མེད་པས་དེ་ལྟར་ངས་བུ་དང་བུ་མོ་དང་།",
    "དེའི་ཚེ་ཁྱོད་གཞན་བྱིན་ན།",
    "ངའི་ཡན་ལག་དང་ཉིང་ལག་གཏུབས་ཤིང་སློངས་མོ་པ་རྣམས་ལ་གཏོང་བའི་ཚེ།",
    "དེའི་ཚེའང་ཁྱོད་ཡིད་མི་དགའ་བར་འགྱུར་རོ།",
    "བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པ་ལ་ཚིགས་སུ་བཅད་དེ་སྨྲས་པ།",
    "ཀུན་ནས་ཉོན་མོངས་རྣམ་པར་སྦྱང་བར་བྱ།",
    "ངན་སོང་ཀུན་ཀྱང་རྣམ་པར་བཟློག་དགོས་སོ།",
    "ཉོན་མོངས་བསྒྲིབས་ཤིང་གཏི་མུག་མུན་འཐོམས་པའི།",
    "དེ་ཚེ་ཁྱོད་ནི་ང་སེམས་མི་འཐུན་ཏེ།",
    "དེ་ཚེ་ཁྱོད་ནི་སྡུག་བསྔལ་བ་གདུངས་གྱུར་གྱིས།",
    "ཁྱོད་ནི་མི་དགའ་དེ་ཚེ་སློང་བ་ལ།",
    "བུད་མྱེད་ངང་གིས་ཚིག་དྲག་མི་བཟོད་སྨྲ།",
    "ཁྱོད་ཀྱང་སློང་བའི་ཚོགས་ལ་སྦྱིན་དགོས་ཀྱིས།",
    "ཁྱོད་དགའ་ཐམས་ཅད་དེ་བཞིན་བྱ་ལ་རག།",
    "བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པས།",
    "བདག་ནི་ཁྱོད་ཅི་དགྱེས་པ་དང་།",
    "ཞེས་ནས་བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པས།",
    "ཁྱོད་སྤྱོད་སྐལ་བ་མཉམ་པའི་ཕྱག་རྗེད་དུ།",
    "ཚེ་རབས་རྒྱ་མཚོར་བདག་གི་སྤྲོ་བར་བགྱི།",
    "ཚེ་རབས་མཐའ་ཡས་སྐྱེས་པ་རེ་རེ་ཞིང་།",
    "བདག་གི་ལས་ནི་ཤིན་ཏུ་གཏུབས་གཤགས་ཀྱང་།",
    "དད་དགེ་ཁྱོད་ཀྱིས་བདག་གི་ཁྱིམ་ཐབ་མཛོད།",
    "བདག་གི་མགོ་ནི་ཡོངས་སུ་བཏགས་གྱུར་ཀྱང་།",
    "ཁྱོད་ཀྱིས་རྟག་པར་བདག་གི་ཁྱིམ་ཐབ་མཛོད།",
    "ཁྱོད་ཀྱིས་ཚེ་རབས་གྲངས་མེད་ཐམས་ཅད་དུ།",
    "བདག་གི་ལས་ནི་སླད་ན་མ་ལས་པར།",
    "སྐྱེས་བུ་ལྷ་ཡི་སྲས་པོ་ཁྱོད་ལ་དབུལ།",
    "ཁྱོད་དང་སྦྱོང་པ་འཐུན་པར་སྤྱད་སླད་དུའོ།",
    "ཁྱོད་ནི་འཇིག་རྟེན་གཟིགས་པ་ཅི་ཚུལ་ལགས།",
    "ཁྱོད་ཀྱི་ཞབས་ཀྱིས་བཅགས་པའི་ས་རྣམས་ཀྱང་།",
    "བདག་གིས་གཡར་ལམ་མཐོང་བ་དགུང་ཞིག་ལ།",
    "གཡར་ལམ་མཐོང་བར་ཕྱག་གིས་བདག་མགོ་བྱུག།",
    "སྔན་ཆད་གཉེན་བཤེས་གྱུར་པའི་ལྷ་མོ་ཡིས།",
    "སྔོན་ཡང་གཞོན་ནུ་གཟི་བརྗིད་ཁྱོད་བལྟ་ཞེས།",
    "བདག་གི་སེམས་བསྐྱེད་དེ་ལྟར་བསམ་པར་གྱུར།",
    "བདག་གི་བདེ་གཤེགས་གཡར་ལམ་རྨྱིས་པས་མཐོང་།",
    "ཡིད་བཞིན་བསམ་གྲུབ་ཁྱོད་དང་བདག་བཅས་པས།",
    "ཉམས་བདེ་བར་གྱུར་པ་ལྟ་བུའང་མེད་ལ་དགའ་བ་དང་མོས་པར་ཡང་མ་གྱུར་གྱི།",
    "གཞན་དུ་ན་ཐལ་མོ་སྦྱར་ཅིང་མྱིག་མི་འགེབས་པར་གཞོན་ནུ་གཟི་བརྗིད་བདག་གི་གདོང་ལ་བལྟ་ཞིང་གནས་བར་གྱུར་ཏོ།",
    "དེ་ནས་སྦྲུལ་འཚོང་མའི་གཙོ་མོ་བལྟ་ན་སྡུག་པས།",
    "བུ་མོ་འདི་ནི་ཁྱོད་གསལ་བགྱི་སྙམ་ནས།",
    "ཡུན་རིང་སྔ་ནས་བདག་གིས་བསམ་བསམ་སྟེ།",
    "གཟུགས་མཛེས་དེ་ཡང་དེ་རིང་ཁྱོད་ལ་ཕུལ།",
    "འཇིག་རྟེན་ཀུན་གྱི་བུད་མེད་ནང་ན་མཆོག།",
    "པད་མོའི་སྦུབས་ནས་སྐྱེས་པས་རིགས་སྨོས་སུ།",
    "རྟག་པར་ཁྱོད་ཀྱི་སྤྱོད་ཚུལ་མཐུན་པར་འགྱུར།",
    "རེག་ན་བདེ་ལ་ཀུན་ནས་འཕགས་པས་ན།",
    "དེའི་མོད་ལ་བྲོ་དང་བྲལ་བར་འགྱུར།",
    "པད་མོའི་མཆོག་ལྟར་རྣམ་པར་རབ་ཏུ་གསལ།",
    "མི་དགེའི་སུག་ལས་བགྱིད་པར་མོས་མི་འགྱུར།",
    "དེ་ནས་རྒྱལ་པོའི་བུ་གཟི་བརྗིད་ཀྱི་བདག་པོ་བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པ་འཁོར་དང་བཅས་པ་དང་།",
    "བུ་མོ་སྟོང་ཕྲག་ཉི་ཤུ་དང་།",
    "དེ་རྟ་བབས་སའི་བར་དུ་བཞོན་པས་སོང་ནས་བབས་ཏེ་རྐང་པས།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་སྐུ་ཉི་མ་དམ་པའི་དྲུང་དུ་སོང་ངོ།",
    "དེ་ལྟར་མཐོང་ནས་དེའི་སེམས་མངོན་བར་མོས་པར་གྱུར་ཏེ།",
    "མོས་པའི་ཤུགས་ཆེན་པོ་རྣམ་པར་སྤེལ་དེ་དགའ་བ་དང་མོས་པ་དང་།",
    "སྤྲོ་པ་ཆེན་པོས་ཡོངས་སུ་རྒྱས་པའི་སེམས་ཀྱིས་བཅོམ་ལྡན་འདས་དེ་ལ་ལན་བརྒྱ་སྟོང་དུ་མར་གཡས་ཕྱོགས་སུ་བསྐོར་བ་བྱས་ནས་བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པ་ལ་སྩོགས་པ་འཁོར་ཐམས་ཅད་དང་བཅས་པས།",
    "བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པ་དང་།",
    "གཞོན་ནུ་ཁྱོད་ལ་དོན་འདི་ལྷ་འམ་མི་འམ་སུ་ཞིག་གི་སྦྲན།",
    "བདག་ལ་བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པས་སྦྲན་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་མཐོང་བས་ནི་ངན་སོང་གི་གཡང་སའི་འཇིགས་པ་ཐམས་ཅད་ཀྱང་རྣམ་པར་ལྡོག་པར་སེམས།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་སྐུ་ཉི་མ་དམ་པ་གང་ན་བ་དེར་སོང་སྟེ།",
    "བཅོམ་ལྡན་འདས་དེའི་སྤྱན་སྔར་རང་གི་འཁོར་དང་བཅས་ཏེ་འཁོད་དོ།",
    "འཁོར་གྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་ལ་གཟིགས་ནས།",
    "བཅོམ་ལྡན་འདས་བདག་བཅོམ་ལྡན་འདས་ཀྱི་ཞམ་རིང་དུ་རབ་ཏུ་འབྱུང་ཞིང་བསྙེན་པར་རྫོགས་པའི་དགེ་སློང་གི་ཚུལ་ལ་མཆིས་པར་ཅི་གནང་ཞེས་ནས།",
    "ལྷ་རྫས་ཀྱི་འཛམ་བུ་ཆུ་ཀླུང་གི་གསེར་ལས་གྲུབ་པ།",
    "དེ་ས་འཛམ་བུའི་གླིང་དེའི་རྒྱལ་པོའི་གནས་སྟོང་ཕྲག་བརྒྱད་ཅུ་རྩ་བཞི་དག་ཏུ་ཡང་རྒྱལ་པོའི་གནས་རེ་རེར་གཙུག་ལག་ཁང་ལྔ་བརྒྱ་བྱེད་དུ་བཙུད་དེ།",
    "བཟའ་ཤིང་གི་ར་བ་དང་།",
    "གཙུག་ལག་ཁང་རེ་རེ་ཞིང་ཡང་དེ་བཞིན་གཤེགས་པའི་མཆོད་རྟེན་བརྩིགས་པ་ནི་ལྷུན་གྱི་རྒྱ་ཤིན་ཏུ་ཆེ་བར་བྱས་པ་སྟེ།",
    "ཁྱོད་ཀྱིས་དེ་ལྟར་མི་བལྟ་སྟེ།",
    "གཞོན་ནུ་གཟི་བརྗིད་ཀྱི་བདག་པོའི་ཡུམ་དུ་གྱུར་པ་བུད་མེད་སྟོང་ཕྲག་བརྒྱད་ཅུ་རྩ་བཞིའི་གཙོ་མོར་གྱུར་པ་དེ་གཞན་ཞིག་ཡིན་པ་ཙམ་དུ་སེམས་ན་ནི།",
    "དེའི་ཚེ་དེའི་དུས་ན་སྤྲུལ་འཚོང་མའི་གཙོ་མོ་བལྟ་ན་སྡུག་པ་ཞེས་བྱ་བ་བྱུང་བ་དེ་གཞན་ཞིག་ཡིན་པ་ཙམ་དུ་སེམས་ན་ནི་དེ་ལྟར་མི་བལྟ་སྟེ།",
    "ཤཱཀྱ་ལག་ན་ཁར་པའི་ཆུང་མ་ཁོ་མོའི་མ་མིག་མཛེས་ཤེས་བྱ་བ་འདི་ནི་དེའི་ཚེ་དེའི་དུས་ན་སྤྲུལ་འཚོང་མའི་གཙོ་མོ་བལྟ་ན་སྡུག་པ་ཞེས་བྱ་བར་གྱུར་ཏོ།",
    "དེའི་ཚེ་དེའི་དུས་ན་བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པ།",
    "ཁོ་མོ་ནི་དེའི་ཚེ་དེའི་དུས་ན།",
    "སྤྲུལ་འཚོང་མའི་བུ་མོ་དགའ་བའི་འོད་ཀྱི་དཔལ་ཤིན་ཏུ་སྦྱངས་པ་ཞེས་བྱ་བར་གྱུར་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཞལ་མངོན་དུ་མཐོང་བར་རྣམ་པར་དམྱིགས་པའི་མིག་དང་དེ་བཞིན་མིག་དང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གསུང་གི་ཡན་ལག་གི་སྤྲིན་ནམ་མཁའ་དང་མཉམ་པའི་འཁོར་ལོ་རབ་ཏུ་བསྒྲགས་པའི་དབྱངས་རྣམ་པར་དམྱིགས་པའི་རྣ་བ་དང་།",
    "ཁོ་མོས་ནམ་བཞུགས་ཀྱི་བར་དུ་ན་བཟའ་དང་བཤོས་དང་།",
    "དེ་ཡང་ཁོ་མོ་ཅག་གིས་བསྙེན་བཀུར་ཏོ།",
    "དེའི་འོག་ཏུ་དེ་བཞིན་གཤེགས་པ་འཛམ་བུ་ཆུ་ཀླུང་གི་གཟི་བརྗིད་རྒྱལ་པོ་ཞེས་བྱ་བ་བསྙེན་བཀུར་ཏོ།",
    "དེའི་འོག་ཏུ་དེ་བཞིན་གཤེགས་པ་ཤིན་ཏུ་རྣམ་པར་གཟིགས་པའི་ཡེ་ཤེས་དཔལ་ཞེས་བྱ་བ་བསྙེན་བཀུར་ཏོ།",
    "དེའི་འོག་ཏུ་དེ་བཞིན་གཤེགས་པ་ཀུན་ཏུ་རྣམ་པར་གཟིགས་པའི་ཡེ་ཤེས་ཤེས་བྱ་བ་བསྙེན་བཀུར་ཏོ།",
    "དེ་དག་ཐམས་ཅད་ཁོ་མོ་ཅག་གིས་ན་བཟའ་དང་།",
    "དེ་ཐོས་ནས་ཁོ་མོས་ཡེ་ཤེས་ཀྱི་མིག་རབ་ཏུ་ཐོབ་སྟེ།",
    "གསུང་གི་ཕྲིན་ལས་དང་ཐུགས་ཀྱི་ཕྲིན་ལས་ཀྱང་ཁོང་དུ་མ་ཆུད་དོ།",
    "ཡེ་ཤེས་ཀྱི་གཟིགས་པ་དང་།",
    "གཅིག་ཏུ་འདོད་ཆགས་ལ་སྤྱོད་པའི་སྐྱེས་པ་དང་བུད་མེད་ཕན་ཚུན་ནས་ཕྲད་བར་དུས་བྱས་པ་གཉིས་ལ་ནི་སེམས་ཀྱི་རྒྱུད་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པ་ལས་བྱུང་བ་གཙང་བའི་འདུ་ཤེས་དང་།",
    "ཡོངས་སུ་དག་པའི་འོད་དང་སྣང་བ་སྣ་ཚོགས་ཀྱི་རབ་ཏུ་སྣང་བ་མཚན་མ་སྔན་ཆད་མ་མཐོང་བ་དག་སེམས་ཀྱི་སྐད་ཅིག་རེ་རེ་ཞིང་མྱིག་ལམ་དུ་སྣང་ངོ།",
    "བ་སྤུའི་སྒོ་རེ་རེ་ནས་ཀྱང་དུས་གསུམ་རྒྱ་མཚོ་ལ་འཇིག་པའི་ཚུལ་མཐའ་དང་དབུས་མེད་པ་ཞིག་མིག་ལམ་དུ་སྣང་ངོ།",
    "མོས་པའི་སེམས་སམ་ཁོང་ཁྲོ་ལྡན་ཡང་རུང་།",
    "བསྐལ་པ་མང་པོ་ཁོ་མོས་འདི་ནས་དྲན།",
    "གྲོང་མཆོག་བྱེ་བ་སྟོང་གིས་ཀུན་ནས་བསྐོར།",
    "ཁོ་མོ་དེ་ཡི་བུ་མོ་ཡིད་འོང་གྱུར།",
    "དེ་ལ་ཁོ་མོ་མོས་པ་མཆོག་ཅིག་སྐྱེས།",
    "དེ་ནི་ཁོ་མོའི་ཁྱིམ་གྱི་སྒོར་བྱོན་ནས།",
    "རྒྱན་རྣམས་ཀུན་ཀྱང་བཀྲོལ་ཏེ་མོས་སེམས་ཀྱིས།",
    "ཤིན་ཏུ་འདུན་པར་དེ་ལ་བདག་གིས་ཕུལ།",
    "ངན་སོང་གང་དུའང་སོང་བར་མ་གྱུར་ཏོ།",
    "མི་ཡི་ཡུལ་དུ་རྒྱལ་པོའི་སྲས་མོར་གྱུར།",
    "སྤྲུལ་འཚོང་གཙོ་མོ་བལྟ་ན་སྡུག་པ་སྟེ།",
    "མི་འཇིགས་བྱེད་པའི་བུ་མོར་སྐྱེས་པར་གྱུར།",
    "བསྐལ་བ་དེ་ལ་ཁོ་མོས་རིམ་གྲོ་བྱས།",
    "དེ་ཚེ་ཚུན་ཆད་ཁོ་མོས་སྣང་བ་ཐོབ།",
    "སེམས་ཀྱི་སྐད་ཅིག་གཅིག་གིས་རྒྱ་མཚོའི་ཞིང་།",
    "བསམ་ལས་རྣམ་འདས་ཕྱོགས་སུ་ཁོ་མོ་འཇུག།",
    "ཉོན་མོངས་བཅས་ལའང་ཁོང་ཁྲོ་སྡང་བ་མེད།",
    "སེམས་ཀྱི་སྐད་ཅིག་གཅིག་གིས་རྣམ་པར་བལྟ།",
    "ས་ཚུལ་མ་ལུས་ཀུན་ཀྱང་ཁོ་མོས་ཤེས།",
    "སྐད་ཅིག་རེ་རེས་མཐའ་ཡས་ཁོང་དུ་ཆུད།",
    "ནམ་ཡང་མུར་ཕྱིན་བདག་གིས་མ་ནུས་སོ།",
    "དེ་ཡི་བ་སྤུ་གཅིག་གི་རྩེ་ལ་ཡང་།",
