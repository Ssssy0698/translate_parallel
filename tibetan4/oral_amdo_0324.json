    "ནོར་འཛིན་བུ་མོའི་ལྟོ་བ་ཡོངས་སུ་བཀང་།",
    "བོད་གངས་ཅན་གྱི་ལྗོངས་འདིར་ལོ་ཙཱ་བ་ཆེན་པོ་འགོས་ཁུག་པ་ལྷས་བཙས་སོགས་མཁས་གྲུབ་དུ་མའི་སྐྱེ་བ་བཞེས་མོད།",
    "དབེན་ས་བློ་བཟང་དོན་གྲུབ་ཀྱི་སྐྱེ་བ་ཡིན་ཞེས་བདག་གིར་གནང་སྟེ་དབེན་དགོན་དུ་ཁྲིར་བཀོད།",
    "བླ་གྲྭ་ཐམས་ཅད་ཀྱིས་ད་དུང་པཎ་ཆེན་དུ་བཞུགས་དགོས་ཞེས་གསོལ་བ་བཏབ་པ་བཞིན་སྐུ་ཚེ་འདའ་རག་གི་བར་དུ་པཎ་ཆེན་གྱི་གདན་སར་བཞུགས་སོ།",
    "གོ་མིན་ཏང་གི་རིང་ལ་རྒྱ་མི་ཁ་ཤས་ཀྱིས།",
    "བས་རབ་བྱུང་གིས་ཁྱིམ་ཐབ་མི་བསྟེན་པའི་དོན་དུ་དེ་ལྟར་བྱས་པ་རེད་ཅེས་རྫུན་གཏམ་སྨྲས་པ་རེད།",
    "བོད་མི་དག་གིས་ཀྱང་མཐོང་ཆུང་བྱས་སྟབས་གོ་མ་ཆོད་པར་མ་ཟད།",
    "ཅེས་རབ་གསལ་ངག་གི་རོལ་མོ་ཞེས་བྱ་བ་འདི་ནི།",
    "ལས་ཀྱི་སྣེ་མོ་བ་འགའ་ཞིག་གིས་བསྐུལ་ངོརརབ་གནས་ས་སྦྲུལ་ལོའི་ཧོར་ཟླ་པའི་དམར་ཕྱོགས་གྱི་དགའ་བ་གསུམ་པར་གྲུབ་པར་བགྱིས་པའོ།",
    "གདུལ་བྱའི་མོས་པ་རྒྱ་ཆེའི་ཞིང་ས་རུ།",
    "གདུལ་བྱའི་དད་མོས་ཁ་ཞེ་མེད་པའི་མཐུས།",
    "ཉེ་བར་དགོངས་ནས་སླར་ཡང་ཉིན་མོའི་མགོན།",
    "བཤེས་གཉེན་ཉིན་མོའི་མགོན་གྱིས་རྗེས་བཟུང་སྟེ།",
    "ཅེས་པ་འདི་ནི་ཁང་དམར་འདུས་སྤྱི་ཐུན་མོང་གིས་དགེ་སྦྱོང་གི་གོས་དང་ཕྱོགས་ཀྱི་གྲངས་ལྡན་དངུལ་ལོ།",
    "ཐབས་ཚུལ་རིག་པ་སྟོང་ཕྲག་གིས།",
    "གཟུར་གནས་མཁས་དགུས་བསྟོད་བསྔགས་རོལ་མོ་དཀྲོལ།",
    "བསམ་པས་བླང་དོར་གནས་རྣམས་ལྷང་ངེར་གཟིགས།",
    "བདུད་རྩིའི་བགོ་སྐལ་འབྱེད་མཁས་ཁྱོད་ལ་འདུད།",
    "བདེ་སྐྱིད་པད་མོའི་མཛེས་ཞལ་ལྷུག་ལྷུག་རྒོད་ཅིང་།",
    "ཡང་དག་པའི་ལྟ་བ་སོགས་ཐུན་མོང་ལམ་སྦྱོང་སྔོན་དུ་སོང་བའི་སྒོ་ནས།",
    "སྣ་ཚོགས་ལྟད་མོའི་ངོ་མཚར་གྱིས།",
    "ཐུན་མོང་སྣང་བའི་ངོ་མཚར་དང་།",
    "དེ་ལྟའི་རི་བོའི་ངོ་མཚར་ལྟད་མོ་ལ།",
    "ཆུ་བུར་མིག་གིས་ལྟད་མོར་གཡེང་བ་ཙམ་མིན་པར།",
    "ཅེས་འཕྲལ་སྣང་ཤར་ཚུལ་ཙམ་ཞིག་རབ་རྒྱལ་དོན་གྲུབ་ཅེས་པ་ས་ལུག་ལོའི་ས་ག་ཟླ་བའི་ཚེས་བཅོ་ལྔའི་ཉིན་རི་རྩེར་བཞུགས་སྐབས་སྦྱར་བའོདཔྱིད་བསུ་བའི་ཁུ་བྱུག་གི་དབྱངས། ། ཨོཾ་བདེ་ལེགས་སུ་གྱུར་ཅིག་རྣམ་དཀར་མཔཁྱེན་པའི་བདག་རྐྱེན་ལས་འོངས་རབ་དཀར་འཕྲིན་ལས་འོད་དཀར་གྱིས།",
    "བག་ཡངས་འཕུར་ལྡིང་རོལ་བའི་ཟློས་གར་གཟིགས་མོ་དང་།",
    "དེ་ལྟའི་མིག་གིས་རབ་བརྒྱན་པའི།",
    "གངས་ལྗོངས་རྨོངས་པའི་སྨག་ཆེན་བསལརྫོགས་ལྡན་གསར་བའི་པད་མོ་འབུམ།",
    "དགའ་ཚལ་རྒྱས་པའི་ངོ་མཚར་ཤརཙོང་ཁའི་ནོར་འཛིན་སྒེག་མོའི་ལྟོར།",
    "ཕྱོགས་ཀྱི་བུ་མོས་ཡང་ཡང་བརྡུངས།",
    "དཔག་བསམ་ཤིང་གི་ཡལ་ག་དག།",
    "བཟོ་གསོ་ནུ་ཞོ་མངར་མོ་ཡིསསྐལ་ལྡན་སེང་ཕྲུག་ཡོངས་སུ་གསོ།",
    "ཁོང་གི་མུན་པ་ལྷག་མེད་བྱེད།",
    "སྒྲ་དོན་ཚིག་གི་རྒྱན་མང་གིས།",
    "དོན་གྱི་སྒེག་མོ་ཡོངས་སུ་བརྒྱན།",
    "སྔོན་གྱི་རིན་ཆེན་བཙུན་མོ་གཞོན་ནུ་མ།",
    "སྲེག་ཟ་ཤིང་གིས་མི་ངོམས་འཕྱུར།",
    "གློག་གི་ཤུགས་ཀྱི་འཕྲུལ་མེད་ན།",
    "མཁས་པའི་གྲངས་སུ་ལོས་འཇོག་མོད།",
    "རང་གི་ཕ་སྐད་བརྗེད་པ་དེ།",
    "སྐྱེ་འགྲོ་ཡོངས་ཀྱིས་ལོངས་སུ་སྤྱོད་གྱུར་ཅིག་ཅེས་པ་འདི་ནི་ཐག་རིང་ནས་འཕྲིན་ཡིག་གི་ལམ་ནས་བསྐུལ་ངོར་བྲིས་པའོ།",
    "དགེ་མཚན་གཟི་འོད་འབར་བའི་ལྟད་མོ་ལ།",
    "དྷརྨ་ལོ་ཀའི་ཡོངས་འདུ་མཆེད་ཟུང་གི།",
    "ཉིན་མོའི་མགོན་ལ་འགྲན་པའི་གཟི་འོད་དེ།",
    "དགེ་མཚན་ལང་ཚོ་རྒྱས་པའི་གཞོན་ནུ་དེས།",
    "རིག་རྩལ་བུ་མོ་གཞོན་ནུ་གྲོགས་སུ་ཐོབ།",
    "ཅན་བཞིའི་བུ་དང་བུ་མོ་བཞི་བཙས་པ།",
    "དེ་ལྟའི་གཞོན་ནུ་དག་གི་རྩེ་དགའ་ལ།",
    "དགེ་མཚན་བཅུ་ལ་སྤྱོད་པའི་དཔལ་རྒྱས་ནསགཏན་བདེ་མོ་དཔག་བསམ་ལྗོན་པའི་ཁོ་ལག་རྒྱས།",
    "ལྷག་པའི་བསམ་པ་མཆོག་གིས་རང་རྒྱུད་བོར།",
    "ཉོ་བའི་རེ་བ་རྒྱང་ནས་བྱེད།",
    "སྤྱི་སྒེར་གླེང་མོའི་སྐྱེས་དག་ནི།",
    "མྱུར་དུ་ཡོད་པའི་རེ་བ་བྱེད།",
    "དབྱངས་ཀྱི་རྒྱལ་མོའི་རིན་ཆེན་འབུམ།",
    "སྐལ་བཟང་བུང་བས་འཕུར་ལྡིང་གིས།"
  ]
}