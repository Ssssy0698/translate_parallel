    "ཏ་ར་ཡིག་དེའི་མཇུག་ཏུ་པཎ་ཆེན་འོས་སྤྲུལ་གྱི་བྱད་བཞིན་གཟུགས་དབྱིབས་སྐོར་འཁོད་འདུག་ཏར་ཡིག་བལྟས་རྗེས་ཝང་ཧྲུའུ་ཅིས་ང་གཉིས་ལ་སོ་སོའི་བསམ་ཚུལ་ དང་དེ་སྐོར་གང་འགབ་ཅི་ལེགས་བསམ་འཆར་ཤོད་དུ་བཅུག་ཅིང་།",
    "ལན་འདེབས་བྱེད་སྐབས་བག་ཁུམ་འཚེར་སྣང་ཆེ་བ་ཞིག་འདུག་དེའི་མཇུག་ཏུ་རོགས་ཟླ་ལྟ་བུ་མི་གཉིས་ཡོད་པ་ལས་གཅིག་ནི་ལོ་ངོ་ལྔ་བཅུ་ཡས་མས་སོན་པ་དང་།",
    "རྒྱའུ་ཨ་སོབ་ཅན་འགྱུར་བག་ཅུང་ཟད་བརླིང་བ་དེས་གཏམ་ཤོད་པ་དང་ལན་འདེབས་བྱེད་ཀྱི་འདུག་གཞན་གཅིག་ཤོས་ནི་ལོ་ན་བཅུ་བདུན་བཅོ་བརྒྱད་ཙམ་སོན་པའི་བྱིས་རྟགས་དོད་པོ་ཞིག་མཆིས་པ་དེ་ཁ་རོག་བསྡད་དེ་ཅི་ཡང་མི་སྨྲ།",
    "ག་དུས་ཕྱིར་ལོག་རྒྱུ་སོགས་ཚུད་ཡོད།",
    "དགུང་ལོ་བཅུ་དྲུག་ཐོག་ཡུལ་དེར་དམག་ཁྲལ་བྱུང་བས་གཅེན་པོ་གཉིས་འགྲོ་འདོད་མེད་ཀྱང་ཁོང་རང་ཉིད་སྐབས་དེར་དམག་ཁྲལ་དུ་ཕེབས་དགོས་བྱུང་།",
    "དེ་ནས་ཁོང་རང་ཡུལ་ལ་ཕྱིར་ལོག་ཕེབས་རྗེས་ཡབ་ཀྱི་ཐུགས་ཁྲོས་ཀྱང་།",
    "རྒྱགས་ཕྱེ་སོགས་བསྩལ་ཏེ་ཐོག་མའི་ཟམ་པ་ནི་ལྕགས་ཕོ་ཁྱིའི་ལོར་སྤྱི་ལོ་༡༤༣ལོ་བཙུགས་པའི་ཆུ་ཤུར་ལྕགས་ཟམ་ཡིན་འདུག་སྔོན་ལ་ལྕགས་ཕུར་དང་ལྕགས་ཐག་ཀྱང་བྱིས་པ་ལོ་བརྒྱད་སོན་པའི་ལག་ངར་གྱི་སྦོམ་ཕྲ་ཙམ་བྱས་པ་བཟོས་ཏེ་སྣེ་གཅིག་རི་བོའི་ལྷོ་ངོས་དང་སྣེ་གཅིག་བྱང་གྲམ་དུ་ལྕགས་ཕུར་མདའ་གང་མ་གཉིས་བརྒྱབ་སྟེ་ཟམ་སྣེ་བཀལ།",
    "གྱིས་རྔ་སྟབས་དང་བཅས་ནས་འཆམ་གྱིན་འདུག་པས།",
    "ད་དུང་ཞིབ་པར་དབྱེ་འདོད་འདུག་ན་ཟློས་གར་དང་།",
    "ནོར་བུའི་རིགས་ནི་གང་ལ་གང་དགོས་འདུག།",
    "དེ་ཕྱིར་ང་རང་སེམས་འཁྲལ་ཤིན་ཏུ་ཆེ།",
    "པས་འབྲས་དཀཪ་ཨ་ཇོ་བསམ་པའི་དོན་གྲུབ་དང་འབྲས་ཕྲུག་ཡེ་ཤེས་ཕུན་ཚོགས་རྣམ་གཉིས་ཀྱི་དཀར་པོ་རྣམ་གསུམ་འཛོམས་པའི་འབྲས་དཀར་དང་བསམ་དོན་ཡིད་བཞིན་གྲུབ་པའི་འབྲས་དཀར་ཡིན།",
    "གཟེ་མ་ར་མགོའི་གཏམ་དེ་བདེན་པ་འདུག།",
    "སྨད་ཀྱི་ཚ་བའི་ཚ་ཟུག་ག་འདྲ་འདུག།",
    "སྲོག་དང་བྲལ་བ་མིན་འདུག་པས།",
    "འདི་རུ་བསྡད་ན་དུག་སྦྲུལ་ཁ་རླངས་ཕོགས་ཉེན་འདུག་དེ་ནས་ལྷ་སྲས་ལྕམ་སྲིང་གཉིས་ནགས་ཁྲོད་ནས་རིམ་བཞིན་ཕེབས།",
    "ད་ཨ་ཇོ་ལགས་ཁྱེད་རང་གསོད་ཕོད་ན་མ་གཏོགས་ང་གསོད་ཕོད་པ་མིན་འདུག།",
    "ང་རང་གཅིག་པུ་བསྡད་ཀྱང་སེམས་པ་སྐྱོ་རོགས་ལས་རང་ཤི་བརྒྱབ་ན་དགོངས།",
    "ལྷ་གཅིག་ཀུན་བཟང་རང་ཤི་བསྐྱོན་དུ་ཕྱག་ཕེབས་ཤིག།",
    "དེ་ནས་ལྷ་གཅིག་ཀུན་བཟང་རང་སྲོག་མ་གཅོད་པར་མར་ཕེབས།",
    "སླར་ཡང་སྲས་ཤིག་འཁྲུངས་འདུག།",
    "རྒྱལ་སྲིད་ཨ་ཇོ་དོན་གྲུབ་ཀྱིས་བྱེད་པ་ལས།",
    "མི་མིན་བདུད་ཀྱི་སྤྲུལ་པ་ཡིན་པར་འདུག།",
    "ཁྱེད་རང་ཨ་ཇོ་བདག་ལ་མ་བལྟས་པར།",
    "ཨ་ཇོ་མི་མེད་མཐའ་འཁོབ་ལྷ་འདྲེའི་ཡུལ།",
    "ཨ་ཇོ་མེད་པར་བདག་ཅག་རྒྱལ་སྲིད་འདི།",
    "ཨ་ཇོ་མཐའ་འཁོབ་ཡུལ་དུ་འགྲོ་བ་ལ།",
    "ཁྱེད་རང་རྒྱལ་སྲིད་བཟུང་ལ་ནོར་གྱི་བདག།",
    "འཁྲིད་རང་འཁྲིད་ན་ཡ་ཡང་ང་བ་འདུག།",
    "གཅན་གཟན་རྣམས་ཀྱིས་ངར་སྐད་སྒྲོག་ནས་འདུག།",
    "གཅུང་པོས་འབྱོན་མ་ཐུབ་ཀྱང་ཨ་ཇོས་སྐུ་རྒྱབ་ཏུ་བསྣམས་ནས་རྒྱང་ཕྲག་བདུན་གྱི་བར་དུ་བྱོན་ཀྱང་ཆུ་མ་བྱུང་།",
    "དེ་ཕྱིར་བདག་ཅག་ཨ་ཇོས་བསྐྱུར་བ་འདྲ།",
    "ཞེས་གསུངས་པས་ལན་དུ་ཨ་ཇོས་གསུངས་པ།",
    "དེ་ཕྱིར་ཨ་ཇོས་ཆུ་ཞིག་འཚོལ་དུ་འགྲོ།",
    "དབུགས་མ་ཆད་ཙམ་དུ་འདུག་པའི་དེར་ཨ་ཇོས་པང་དུ་བླངས་ཏེ་སྐེ་རགས་བཀྲོལ་ནས་ཤ་ལ་སྦྱར།",
    "ཨ་ཇོས་གཅུང་པོའི་དབུ་ནས་བཟུང་སྟེ་བཤུམས་ཤིང་།",
    "ད་དུང་སྲོག་དང་བྲལ་བ་མི་འདུག་པས།",
    "བཀའ་དྲིན་ཅན་གྱི་ཨ་ཇོས་བཞེས་པར་མཛོད།",
    "ཡོད་པར་འདུག་པས་རྒྱལ་བློན་ཐུགས་ལ་འཇོག།",
    "དགེ་སློང་ཁྱེད་ལ་བུ་ཞིག་ཡོད་འདུག་པས།",
    "རྒྱལ་པོ་དོན་གྲུབ་དང་ལྷ་གཅིག་གཅུང་པོའི་སྐུ་གདུང་བཞུགས་གནས་དུ་ཕྱག་ཕེབས་ཤིག་ཐག་རིང་ནས་ཨ་ཇོ་ཞེས་པའི་སྒྲ་ཐོས།",
    "ཨ་ཇོ་དོན་གྲུབ་ད་ལྟ་འདི་ན་ཡོད།",
    "ཨ་ཇོའི་རྗེས་སུ་སླེབས་བྱུང་།",
    "འབྲས་དཀར་ང་རའི་ནང་ལ་ཐུག་ཁོག་གང་དང་མགོ་ཐུག་ཡིན་ཞུས་པས་འབྲས་དཀཪ་ཨ་ཇོ་བསམ་པའི་དོན་གྲུབ་དང་འབྲས་ཕྲུག་ཡེ་ཤེས་ཕུན་ཚོགས་རྣམ་གཉིས་ཀྱི་དཀར་པོ་རྣམ་གསུམ་འཛོམས་པའི་འབྲས་དཀར་དང་བསམ་དོན་ཡིད་བཞིན་གྲུབ་པའི་འབྲས་དཀར་ཡིན།",
    "གཡོན་ན་ནོར་བུའི་དོ་ཤལ་ཁྱེར་འདུག་ཞུ་རོགས་གྱིས་ཅེས་ཞུས།",
    "ད་ནི་འདི་རུ་མི་རྒོད་ཕ་བུ་སླེབས་པ་འདུག།",
    "སྔོན་མེད་སྐྱེས་པ་ཡ་མཚན་ཅན་ཞིག་འདུག།",
    "མཐོང་འཕྲལ་འཇིགས་ཤིང་སྐྲག་པའི་མི་ཞིག་འདུག།",
    "ཞིབ་པར་བལྟས་ན་ཡིད་ཀྱང་སྤྲོ་བར་འདུག།",
    "ད་ལྟ་རིན་ཆེན་སྤུངས་འདྲའི་ཁ་ན་འདུག།",
    "ལྡེམ་ལྡེམ་སྐུ་ཡི་རྣམ་འགྱུར་དར་དཀར་ཡོལ་བས་སྒྲིབ་འདུག།",
    "ཆང་འཐུང་ན་ད་དེ་འདྲའི་ཞིམ་པ་འདུག།",
    "ཁོ་པའི་བསམ་པ་ལ་རི་ཕག་འདི་བསད་ན་ཤ་རྐྱང་ལས་མི་འདུག་དེ་བས་གླ་བ་འདི་བསད་ན་ཤ་དང་པགས་པ་གཉིས་ཀ་འོང་བར་འདུག་བསམས་ནས།",
    "དེ་བས་ཤྭ་བ་འདི་བསད་ན་ཤ་དང་པགས་པ་རྭ་ཅོ་གསུམ་གྱི་ཕན་ཐོགས་པ་འདུག་སྙམ་སྟེ།",
