    "ལན་ཅིག་ཤོད་དེ་ནས་སྲོད་ལོང་བ་བོས་ནས་ལྷ་ཁ་འབེབས་ཤིང་འདུག་པས།",
    "ད་ལྟ་བར་ཁོང་ཐོག་ན་བསྐོར་བ་བྱེད་ཅིང་འདུག་པས་མ་འོངས་པ་ཡིན་ཟེར།",
    "ཁོང་ལ་ནུས་མཐུ་ཆེན་པོ་འདུག་གམ་བྱས་པས་ཡོད་པར་ནི་རློམ་གྱི་འདུག་ཟེར།",
    "དཔོན་ཀུན་རྒྱལ་དང་ཁྱེད་རྣམ་གཉིས་ཀྱང་འདུག་པས་ངས་སྤྱན་འདྲེན་རྣམས་བསྐྲད།",
    "ང་རྒྱ་བོ་འདིའི་དུར་ཡིན་པས་རྒྱ་དུར་ཟེར་བར་འདུག་གསུང་།",
    "སྐུ་དྲིན་ལ་གསུང་ནས་སྤྱན་ཆབ་མང་དུ་འབྱོན་གྱི་འདུག་གསུང་།",
    "དེ་སྒྲོན་གསལ་གྱི་སྦྱོར་དྲུག་ལོགས་སུ་ཕྱུང་བ་ལྟ་བུར་འདུག་གསུང་།",
    "འདི་ཁྱེད་རང་ལ་གནོད་པ་དེའི་མགོར་འདུག་ཟེར།",
    "འདིར་རྒྱུན་ཏུ་སྐུ་མདུན་ཁོ་ནར་སྡོད་དགོས་པ་འདི་ཡང་མདུན་མའི་ཕུགས་བཟང་པོ་ཅིག་མི་འདུག་བསམ་ནས་མདུན་མ་བསྒྱུར་འདོད་ཆེན་པོ་བྱུང་བ་ཡིན་གསུང་།",
    "བདག་ཙ་རི་ཕྱོགས་ལ་འགྲོ་འདོད་པ་ཐོན་པར་འདུག་ལགས་སམ་ཞེས་ཞུས་པས་ཕྱི་ཤོལ་ཆེན་པོ་རང་འདུག་ནའང་ཐོན་པར་འདུག་བའི་ལུང་བསྟན་བཟང་པོ་བྱུང་།",
    "ཟླ་བ་བདུན་པའི་ནང་དུ་ཀོང་པོར་འགྲོ་བའི་འགྲུལ་པ་མང་དུ་འདུག་པས་དེའི་ཟླ་ལ་ཕེབས་པར་ཐག་བཅད་ཡོད་པའི་ཞུ་བ་བཏང་བས།",
    "སྐུ་རྡོ་རྗེར་འཇོག་པ་འདུག་གསུང་པས།",
    "དཀའ་གནས་ལམ་རིམ་གྱིས་མི་ཤོད་པ་མང་དུ་འདུག་ཐོག་མར།",
    "དེ་མི་ལེན་ཟེར་བའི་ཨུ་ཚུགས་དེས་མི་ཡོང་དེ་བླངས་པས་ཕམ་པ་འོང་བར་གསུངས་འདུགཔ།",
    "ད་འོ་ན་ཁྱེད་རང་ཇི་ལྟར་མཛད་གསུང་།",
    "གང་སྐྱལ་རྣམས་ལ་འཛད་རྒྱུའང་མི་འདུག་སྲིས་སྨེ་བ་དངོས་གྲུབ་ཏུ་འདུག་ཙ་རི་དེ་ཉིན་རི་དང་ཤིང་ཐམས་ཅད་སེམས་ལྡན་ཡིན་པ་སྙམ་བྱེད།",
    "རྗེས་ཀྱི་མི་རྣམས་ལ་དད་པ་མི་འདུག་པ་གསུང་།",
    "ཙ་རི་སྒྲ་བརྙན་སྣཚོགས་ཐོས་པའི་གནས་ཡིན་ཟེར་བ་བདེན་པར་འདུག་གསུང་།",
    "འཛུམ་མི་སྟོན་པ་རྣམས་ཀྱང་འཛུམ་སྟོན་གྱི་འདུག་གསུང་།",
    "སྟག་ལུང་པ་མཁའ་སྤྱོད་པའི་སྐུ་སྐྱེ་ཅིག་ཡིན་ཟེར་བ་བདེན་པར་འདུག་བསམ།",
    "ནང་སྤྱད་ཀྱི་དངོས་པོ་ས་ཞིང་དང་བཅས་པ་ཁོང་རང་ལ་བསྒྱུར་ནས།",
    "ཁྱད་པར་ཁོང་རང་དུས་འཁོར་ལ་ཤིན་དུ་མཁལ་པས་སྤྱིར་དུས་འཁོར་སྐོར་དང་།",
    "དབྱིབས་སུའམ་ཞེས་བརྟག་པར་གསུངས་འདུག་པ་གསུངས་པས།",
    "འདི་མ་གོ་བས་འདི་ཞུ་དགོངས་ནས་སྤྱན་སྔར་ཕེབས་པའི་ཚེ་སྐུ་མདུན་དུ་མ་ཕེབས་ཙམ་ལ་ཕལ་ཆེར་གོ་ཡོད་པར་འདུག་བྱིན་བརླབས་ཤིན་དུ་ཆེ་བ་ཞིག་ཡོད།",
    "ཁོང་ཁ་ཧྲད་བྱེད་ཀྱིས་འདུག་པས་བཞག་བཏང་ཟེར།",
    "འགྲོ་བ་ཟས་ཀྱི་གནས་པར་བྱ་ཞེས་བྱ་བར་འདུག་རྗེ་སྒམ་པོ་པས་ཀྱང་འབལ་ལེ་ཟོས་ནས་འབོལ་ལེ་བསྒོམས་བྱ་བ་གསུང་།",
    "འདིར་སྦྱིན་བདག་རྣམ་པ་ཡང་ཤིན་དུ་གུས་པར་འདུག་པས་ངེད་ཀྱིས་གཞིས་ཀྱང་ཞུས་ནས་འབུལ།",
    "དེ་གཉིས་ཀྱང་རྗེ་བཙུན་གཙང་བར་འདུག་རྗེ་བཙུན་གྲགས་པ་རྒྱལ་མཚན་པའི་ཤུལ་ནས་ན་བཟའ་དང་གསོལ་ཞལ་ཆ་གཅིག་བྱུང་།",
    "རས་ཕྱམ་དང་ཞྭ་ཐེབ་གྱོན་ནས་འདུག་པ་ལ།",
    "གཞན་འདི་ཡིན་མི་གསལ་བའི་ནག་ནོག་མང་དུ་འདུག་པ་རྣམས་ལ།",
    "ཟླ་བ་དགུ་པའི་ཚེས་བཅུ་བདུན་ཙ་ན་སྐུ་གྲིབ་ཀྱིས་རྐྱེན་བྱས་ནས་སྐུ་ཁམས་ཤིན་དུ་བསྙེལ།",
    "ད་ལན་ཁྱེད་རང་ཡང་འགོག་པ་ལ་སྙོམས་པར་ཞུགས་དགོས་པ་ཡིན་ཟེར་བ་དང་།",
    "ལར་བབས་ལྕི་བར་འདུག་གསུངས།",
    "གླང་པོ་ཆེ་དེའང་མེད་པས་གཅིག་པུར་འདུག་ནས་ནམ་མཁའ་ལ་འཕུར་ཕྱིན་པས་ནགས་ཚལ་དང་རྩི་ཤིང་མང་དུ་སྐྱེས་པ་དང་།",
    "སྐུ་སྐྱེ་དེ་ལ་རྒྱག་རྒྱ་ཆེན་པོའི་རྟོགས་པ་འཆར་བར་འདུག་གམ་ཞུས་པས།",
    "དེར་མི་གཡོ་བའི་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་ཤཱཀྱ་ཐུབ་པས་བྱས་པ་ཅིག་འདུག་པས།",
    "གཡས་ན་གཏོར་མ་ཅིག་ལ་ཕུར་པ་ཅིག་བཙུགས་འདུག་པའི་ཞལ་འོག་མ་བཞི་ནག་པོར་ཡོད་པ།",
    "འདི་ངན་བྱེད་གཅིག་ཏུ་འདུག་དགོངས་ནས།",
    "མཐུ་པ་ཅིག་ཏུ་འདུག་པས་ཐམས་ཅད་ཀྱིས་རྡོ་རྒྱབ་གསུངས་པས་ཐམས་ཅད་ཀྱིས་རྡོ་འཕངས་ནས་ཁོ་འབྲོས་དགོས་པ་ཞིག་བྱུང་།",
    "རིངས་པར་ཕེབས་པ་ན་དེ་ཡང་མྱུར་བར་འོང་བ་འདུག་པས་མྱུར་བ་མྱུར་བར་བཞུད་དེ།",
    "ད་ནི་བྲོས་པས་མི་ཐར་བ་འདུག་དགོངས་ནས་ནམ་མཁའ་ལ་འཕུར་ཏེ་གཤེགས་པས།",
    "རིངས་པར་བྲོས་པ་དང་དེ་རྣམས་ཀྱང་མྱུར་བར་བྱུང་བས་ནམ་མཁའ་ལ་འཕུར་ཏེ་ལུང་པའི་གཞུང་དེ་ན་མར་ཕེབས་པས་སྒང་སྟོད་ཀྱི་ཐད་དེ་ན་མཁར་རིང་པོ་ཞིག་འདུག་པས་དེའི་ཁར་བབས་ནས་སྐུ་ངལ་གསོས་པས་དེའི་ཕ་ཟད་ན་གཡམ་པའི་སྒོ་ཡོད་པ་ཞིག་འདུག་དེ་ན་སུ་ཡོད་པ་ཡིན་གསུངས་པས།",
    "དེར་བྱེད་ཀྱི་མཚན་པར་འདུག་པས་དེ་རྣམས་ཀྱི་ཁྲོད་དུ་མ་ལྷུང་བ་ཞིག་བྱའོ།",
    "ད་དེ་ད་ལྟ་ཟིན་ཡོང་བར་འདུག་ཟེར་ནས་དགའ་སྤྲོ་ཆེན་པོ་བྱེད་ཅིང་འདུག་གསུང་ངོ།",
    "ན་བཟའ་སྤུ་བོ་ཆེ་སྔོན་པོ་ཅིག་མནབས་ནས་འདུག་པ་ལ་བྱིན་བརླབས་ཞུས་པས་སྟེགས་དེ་ལ་གཅིག་ཀྱང་མ་སྙོགས་པ་ཅིག་བྱུང་བས།",
    "པས་དེ་ཁ་འདུག་ཟེར།",
    "ན་བཟའ་སྤུ་བོ་ཆེ་སྔོན་པོ་ཅིག་མནབ་ཡོད་པར་འདུག་གསུངས་པས་དེ་ཁ་འདུག་ཟེར་ནས་ཁོ་ངོ་མཚར་དུ་གྱུར་བྱུང་།",
    "བདག་པོ་འདིའི་རིང་ལ་མི་སངས་པར་འདུག་ནུ་བོ་འདིའི་རིང་ལ་ཇི་ལྟར་འོང་ཡིན་ཞེས་ལུང་སྟོན་པ་བྱུང་།",
    "འཕན་ཡུལ་ན་བཞུགས་པ་སྙམ་བྱེད་པ་ཞིག་ལ་འཕན་ཡུལ་གྱི་ལུང་པ་དེའི་རི་ཐམས་ཅད་ནགས་ཚལ་ཤིན་དུ་བཟང་བས་ཁེབས་འདུག་ཤིང་དེ་རྣམས་ཀྱི་སྟེང་ན་བྱ་རོག་དཔག་ཏུ་མེད་པ་འདུག་པ་རྣམས་ཕུ་མདའ་ཐམས་ཅད་ནས་འདུས་ཏེ།",
    "ཟེར་བ་ཡོད་པ་དེ་དྲན་ནས་དེའི་དོན་དུ་བསམས་པའི་ལུགས་བྱེད་ཅིང་འདུག་མནལ་སད་ནས་ཐུགས་བསམ་བཏང་བས།",
    "ཚིག་དེའི་དོན་ནི་དེ་མིན་པར་འདུག་གསུང་།",
    "དེ་ནས་ཉི་མ་མ་ནུབ་ཙ་ན་ཡབ་ཀྱི་ཕུའི་རྫ་སྟོངས་ཆེ་བ་མཚོ་ཆེན་པོ་གཉིས་ཀྱི་བར་ན་ཕར་ལམ་ཡོད་པ་ཞིག་ཏུ་ཕེབས།",
    "ལུང་པ་རལ་གསུམ་འདུག་པའི་དབུས་མ་དེ་སྐུ་ལུས་སུ་གྱུར།",
    "རྡོ་ལ་འབུར་དུ་དོད་པ་སྙམ་བྱེད་པའི་པཎྜི་ཏ་འཁོར་དང་བཅས་པ་ཧ་ཅང་ཁ་དོག་མཚར་བ་མིན་ཙམ་ཞིག་འདུག་བི་རཱུ་པ་དེས་དེའི་བསྲུངས་མ་བྱེད་པ་ཡིན་ཟེར་བ་ཞིག་བྱུང་།",
    "ད་དེ་དཔོན་སློབ་ཀྱང་སྔར་བཞིན་མི་འོང་བར་འདུག་ཟེར་བས།",
    "ཕ་ཟད་ནས་དངོས་སུ་བཞུགས་འདུག་དགོངས་པ་བྱུང་།",
    "ཞལ་སྔ་ནས་དབོན་པོ་ཁྱེད་ཀྱིས་ངའི་ཡོན་ཏན་ལ་པོ་ཏི་འདི་ཙམ་ཞིག་ཤེས་པར་འདུག་ཟེར་བའི་ཚད་ཅིག་ཞོག་གསུང་པས།",
    "ཁྱད་པར་རྣམ་འགྲེལ་ལ་མཁས་པ་ཡིན་ཞུ་བར་གདའ་ཞུས་པས།",
    "ཅེས་བྱ་བའི་དུས་ལ་ཁོ་བོ་བབ་འདུག་འགྱོད་པར་བྱས་པ་གཞོན་དུས་སྒལ་ཚིགས་མ་སྲང་བ་དེ་ཡོད།",
    "དག་པ་འདུལ་གོ་བ་མི་འོང་བར་འདུག་གསུང་།",
    "དེ་རིང་འདི་ཙམ་ཞིག་གསུང་ངོ་དགོངས་ཏེ་ཐུགས་ཀྱིས་ལེགས་པར་དཔྱད་པ་རྣམས་ཉན་པ་པོས་སླེབ་པའི་ཚེ་ཁོ་རང་དང་འཚམ་པ་ཞིག་མ་གཏོགས་མི་འཆར་བར་འདུག་གསུངས།",
    "སྦྱོར་གྱིས་ལྷ་ཁང་སྟེང་པ་ཐམས་ཅད་དམ་ཚིག་རྣམ་པར་དག་དེའི་དོན་གྱིས་ད་ལྟ་ཡིད་ལ་བྱས་དུས་སུ་ཡང་སྐྱིད་སྣང་ཆེ་བར་འདུག་གསུངས།",
    "རི་ཅིག་ནས་ཆུ་བོ་ཧ་ཅང་ཆེ་བ་མ་ཡིན་ཆུང་ངུ་ཡང་མིན་པ་ཞིག་བབ་ནས་དེའི་རྒྱུན་མ་ཆད་པར་ཕྱིའི་རྒྱ་མཚོ་ཆེན་པོར་འདྲེས་འགྲོ་བའི་མནལ་ལམ་ཅིག་ཀྱང་བྱུང་བས་དེ་འཕྲིན་ལས་ཀྱི་རྟགས་སུ་འདུག་གསུངས།",
    "ལྷ་ལ་ཡེ་ཤེས་པ་ཐུགས་ཀྱི་སྟོབས་བསྐྱེད་ནས་འབེབས་ཤིང་འདུག་པས།",
    "ལས་སྒྲིབ་ཆེ་བ་ཡིན་པར་འདུག་ངས་མི་མཐོང་ཟེར།",
    "དེ་ནས་ཞིབ་ཏུ་ལྟས་དུས་ལྷ་བཟོ་འབྲིང་ཙམ་དུ་འདུག་གསུང་།",
    "སྐུ་མདུན་དུ་ཕྱིན་པའི་ཚེ་བྱིན་བརླབས་ཀྱང་གཞན་དང་མི་མཉམ་པ་ཅིག་འདུག་ཅེས་ཡང་དང་ཡང་དུ་སྒྲོགས་པར་མཛད་དོ།",
    "བཞེད་པ་དང་མི་འབྱོར་བ་མི་འདུག་ན་དུས་ཚིགས་ཐག་ཆོད་ལ་ཤོག་བདག་ལ་འཐོག་ཅི་ཡང་མེད།",
    "སླར་སྐུ་མདུན་དུ་འོངས་ཏེ་སང་རང་ལ་དུས་གནང་ཡོད་ཞུས་པས་དགྱེས་ཆེས་ཏེ།",
    "གཞན་སུས་ཀྱང་མ་ཚོར་བར་འདུག་ཟླ་བ་བཞི་པ་ལ་ཟུག་ནས་བརྒྱད་པའི་ཚེས་བཅོ་ལྔ་ལ་ལེགས་པར་གྲུབ།",
    "དེ་ཁྱེད་རང་རྣམ་གཉིས་ཀྱི་བྱིན་བརླབས་སུ་འདུག་གསུང་།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "ཚོགས་ཞིང་རང་ལ་ཐིམ་པར་གྱུར།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "འཇམ་པའི་སྟན་ལ་ཉེར་འདུག་ནས།",
    "ད་ལྟའི་དུས་ངན་བརྟན་པ་འཇིག་དུས་སུ།",
    "ས་འདིར་མ་འདུག་གཞན་ཏུ་དེངས།",
    "ཅི་སྐད་གསུངས་པའི་འདུག་སྟངས་དང་།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་སྭཱ་ཧཱ།",
    "གཡོན་པའི་མཐེབ་སྲིན་གྱིས་ནང་མཆོད་ནས་ཕྱོགས་བཞི་དང་རང་ལ་འཐོར་ཞིང་།",
    "འདུག་པ་ལྟ་ཀློབ་བརྩོན་པས་མི་དོར་རོ།",
    "རྡོ་རྗེའི་ར་གུར་འཇིག་དུས་ཀྱི་མེ་ལྟར་འབར་བའི་མེ་རིས་བསྐོར་བ་གསལ་བའི་ཕྱི་རོལ་དུ་ཤར་ནས་གཡོན་སྐོར་གྱིས།",
    "ༀབཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུྃ་ཕཊ།",
    "ནཱ་ད་ཡང་མི་དམིགས་པའི་ངང་ནས་སླར་ཡང་རང་ཉིད་ལྷན་སྐྱེས་དཔའ་བོ་གཅིག་པའི་རྣམ་པར་གསལ་བར་གྱུར།",
    "སློབ་དཔོན་དབུས་སུ་འདུག་ལ།",
    "བསྐལ་པ་འཇིག་དུས་མེ་དང་མཚུངས་པ་ཡི།",
    "ཁྱེད་རང་རྣམས་པདྨ་དང་ཉི་མའི་གདན་ལ།",
    "ཁྱེད་རང་རྣམས་སྔར་ལྟར་རྣམ་སྣང་དཀར་པོ་ནས་གནས་པར་གསལ་བའི།",
    "ཧེ་རུ་ཀ་དང་རང་རིགས་ཀྱི་ཡུམ་དང་།",
    "རྡོ་རྗེའི་ར་གུར་འཇིག་དུས་ཀྱི་མེ་ལྟར་འབར་བའི་མེ་རིས་བསྐོར་བ་གསལ་བའི་ཕྱི་རོལ་ཏུ་ཤར་ནས་གཡོན་བསྐོར་གྱིས།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ།",
    "ༀབཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "སླར་ཡང་རང་ཉིད་ལྷན་སྐྱེས་དཔའ་བོ་གཅིག་པའི་རྣམ་པར་གསལ་བར་གྱུར།",
    "སློབ་དཔོན་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་སྟེ།",
    "བསང་སྦྱང་རང་དང་དྲིལ་བུ་པད་ཉིའི་སྟེང་དུ།",
    "བསང་སྦྱང་རང་ཉིད་པད་ཉིའི་སྟེང་དུ་ཧཱུཾ་ལས་འཁོར་ལོ་བུམ་གྱིས་མཚན་པ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནི།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་སྭཱ་ཧཱ།",
    "ཡང་རང་ཉིད་དཔལ་ཧེ་རུ་ཀར་གསལ་པ་ལ།",
    "ཁྱེད་རང་ཡང་ནི་དེ་ཡི་ཕ།",
    "རྒྱས་པ་ལ་བྱང་དུ་ཕྱོགས་ཏེ་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་འཁོད།",
