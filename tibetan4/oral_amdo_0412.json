    "སྲོག་གི་བར་ཆད་དུ་མི་འགྱུར་གྱི་མ་འཇིགས་ཤིག།",
    "རྒྱལ་པོ་ཆེན་པོ་གང་ཁྱོད་ཀྱིས་གླང་པོ་ཆེ་སྐར་ཁུང་ནས་བྱུང་བ་ལ་མཇུག་མ་ཐོགས་པ་མཐོང་བ་དེ་ཅིའི་སྔ་ལྟས་ཤེ་ན།",
    "དེའི་ཉན་ཐོས་དག་རང་གི་སྐྱེ་བོ་གཉེན་བཤེས་རྒྱ་ཆེན་པོ་སྤངས་ནས་རབ་ཏུ་བྱུང་སྟེ།",
    "དེ་ནས་སེར་སྣ་ཀུན་དུ་བསྟེན་ཅིང་ལན་མང་དུ་བྱས་པས་ལུས་ཞིག་སྟེ་ཤི་བའི་འོག་ཏུ་ངན་སོང་ངན་འགྲོ་རྣམས་སུ་ལྟུང་ཞིང་སྐྱེ་བར་འགྱུར་བ་དེའི་སྔ་ལྟས་ཡིན་ནོ།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ཀྱིས་སྐོམ་པ་མ་ཡིན་པ་རྣམས་ཀྱི་ཕྱི་བཞིན་དུ་ཁྲོན་པ་གདའ་བ་རྨི་ལམ་དུ་མཐོང་བ་དེ་ཅིའི་སྔ་ལྟས་ཤེ་ན།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ཀྱིས་ཕྱེ་བྲེ་གང་དང་མུ་ཏིག་བྲེ་གང་བརྗེ་བ་རྨི་ལམ་དུ་མཐོང་བ་དེ་ཅིའི་སྔ་ལྟས་ཤེ་ན།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ཀྱིས་ཙན་དན་ཤིང་ཐ་མལ་པར་འཚོང་བ་རྨི་ལམ་དུ་མཐོང་བ་དེ་ཅིའི་སྔ་ལྟས་ཤེ་ན།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ཀྱིས་ཀུན་དགའ་ར་བ་མེ་ཏོག་དང་འབྲས་བུ་ཕུན་སུམ་ཚོགས་པ་དག་མ་བྱིན་པར་ལེན་པས་ཕྲོགས་པ་རྨི་ལམ་དུ་མཐོང་བ་དེ་ཅིའི་སྔ་ལྟས་ཤེ་ན།",
    "རྒྱལ་པོ་ཆེན་པོ་གང་ཁྱོད་ཀྱིས་གླང་པོ་ཆུང་ངུས་སྤོས་ཀྱི་གླང་པོ་ཆེན་པོ་སྐྲག་པར་བྱེད་པ་དེ་རྨི་ལམ་དུ་མཐོང་བ་དེ་ཅིའི་སྔ་ལྟས་ཤེ་ན།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ཀྱིས་སྤྲེའུ་མི་གཙང་བས་འབགས་པ་གཞན་ལ་སྐུད་པ་རྨིས་པ་དེ་ཅིའི་སྔ་ལྟས་ཤེ་ན།",
    "རྒྱལ་པོ་ཆེན་པོ་ཁྱོད་ཀྱིས་སྣམ་བུ་གཅིག་མི་བཅོ་བརྒྱད་ཀྱིས་བགོས་ལ་སྣམ་བུ་ཡང་དེ་བཞིན་དུ་གནས་པ་རྨི་ལམ་དུ་མཐོང་བ་དེ་ཅིའི་སྔ་ལྟས་ཤེ་ན།",
    "དེའི་ཕྱིར་ཁྱོད་རྒྱལ་སྲིད་ཉམས་པའམ།",
    "སྲོག་གི་བར་ཆད་དུ་མི་འགྱུར་གྱི་རྒྱལ་པོ་ཆེན་པོ་མ་འཇིགས་ཤིག།",
    "དགེ་སློང་མ་དཀར་མོ་ཡང་གོས་དང་བཅས་པར་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ།",
    "ཡོངས་སུ་སྤྱོད་པར་བྱེད་པ་ལས་བུ་ཡང་མེད་བུ་མོ་ཡང་མེད་ཅེས་བྱ་བའི་བར་དུའོ།",
    "བཟང་མོ་གལ་ཏེ་བུ་ཕོ་སྐྱེས་ན་དེ་ལྟ་ན་ལེགས།",
    "འདི་ལྟར་བུ་མོ་སྐྱེས་ན་ལྷན་ཅིག་བསྐྲད་པར་བྱའོ།",
    "ཇི་ཙམ་ན་ཟླ་བ་དགུ་འདས་པའི་འོག་ཏུ་དེའི་ཆུང་མ་ལ་བུ་མོ་གཟུགས་བཟང་ལ་མཛེས་ཤིང་བལྟ་ན་སྡུག་པ་མིའི་ཁ་དོག་ལས་འདས་པ་ལྷའི་ཁ་དོག་ཐོབ་པ་གོས་དཀར་པོས་གཡོགས་པ།",
    "ཇི་ཙམ་ན་ཆུང་མ་ལ་བུ་མོ་བཙས་པ་ཐོས་ནས་ཁྲོ་བ་དང་བཅས་པས་ནང་དུ་ཞུགས་པ་དང་།",
    "རྐེད་པ་ལྷའི་གོས་ཀྱིས་དཀྲིས་པའི་བུ་མོ་དེ་བྱིན་པ་དང་།",
    "ཤཱཀྱས་བུ་མོ་དེ་མཐོང་ནས་ངོ་མཚར་སྐྱེས་པར་གྱུར་ཏོ།",
    "ཀྱེ་ཤེས་ལྡན་དག་བུ་མོ་འདིའི་མིང་ཅི་གདགས།",
    "གཉེན་རྣམས་ཀྱིས་སྨྲས་པ་གང་གི་ཕྱིར་བུ་མོ་ནི་གོས་དཀར་པོ་དང་བཅས་པར་སྐྱེས་པ་དེའི་ཕྱིར་བུ་མོ་འདིའི་མིང་དཀར་མོ་ཞེས་གདགས་སོ།",
    "བུ་མོ་དཀར་མོ་ཇི་ལྟ་ཇི་ལྟར་ཆེས་དེ་ལྟ་དེ་ལྟར་གོས་ཀྱང་སྐྱེ་ཞིང་དྲི་མ་དང་བྲལ་བར་གྱུར་ཏོ།",
    "གང་གི་ཚེ་བུ་མོ་དཀར་མོ་རིམ་གྱིས་ཆེན་པོར་གྱུར་པ་དེའི་ཚེ།",
    "ཕྱུག་པོའི་བུ་དག་གིས་སློང་དུ་འོངས་ཤིང་དེ་དག་གིས་གཙེས་པ་དང་།",
    "ཇི་ཙམ་ན་བུ་མོས་ཕ་སེམས་ཤིང་འདུག་པ་མཐོང་ནས།",
    "བུ་མོས་སྨྲས་པ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་བསྟན་པ་ལ་རབ་ཏུ་འབྱུང་གིས་ཕ་མཁྱེན་པར་མཛོད་ཅིག།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ཤིང་ཁམས་གསུམ་ལས་འདོད་ཆགས་དང་བྲལ་བ་གསེར་དང་བོང་བ།",
    "བཙུན་པ་དཀར་མོས་ལས་ཅི་ཞིག་བྱས་ནས་གང་གིས་ན་ཕྱུག་པོའི་རིགས་སུ་སྐྱེས་ཤིང་གཟུགས་བཟང་ཞིང་མཛེས་པ་དང་བལྟ་ན་སྡུག་པར་གྱུར།",
    "དགེ་སློང་དག་དཀར་མོ་ཉིད་ཀྱིས་སྐྱེ་བ་སྔ་མ་ལ་ལས་བྱས་ཤིང་བསགས་ལ་སོ་སོར་ཐོབ་པར་བྱས་པ་ཆུ་བོ་བཞིན་དུ་ཉེ་བར་གནས་པ་སྟེ།",
    "གཞན་གྱིས་བྱས་ཤིང་བསགས་པ་གཞན་སུ་ཞིག་གིས་ཉམས་སུ་མྱོང་བར་འགྱུར།",
    "ལུས་ཅན་དག་གི་ལས་རྣམས་ནི།",
    "བྱ་བ་འགའ་ཞིག་གི་ཕྱིར་དྲང་སྲོང་སྨྲ་བ་རི་དགས་ཀྱི་ནགས་སུ་འོངས་སོ།",
    "ཕྱུག་པོའི་ཆུང་མ་དེ་ཉིད་དགེ་སློང་མ་དཀར་མོ་ཡིན་ནོ།",
    "དུག་དྲག་པ་བཞི་སྒྲོམ་ཅིག་གི་ནང་དུ་བཅུག་པར་གྱུར་ཅིང་།",
    "དེ་ལ་གཞན་ཁ་ཅིག་གིས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཀྱེ་སྐྱེས་བུ་སྦྲུལ་གདུག་པ་གཟི་བརྗིད་དྲག་ཅིང་དུག་དྲག་པ་བཞི་སྒྲོམ་ཅིག་གི་ནང་དུ་བཅུག་ཅིང་ཁྱོད་ཀྱིས་དེ་ལ་དུས་དུས་སུ་བྱུག་པར་བྱ།",
    "ཀྱེ་སྐྱེས་བུ་གང་གི་ཚེ་སྦྲུལ་གདུག་པ་གཟི་བརྗིད་དྲག་ཅིང་དུག་དྲག་པ་བཞི་པོ་འདི་དག་ལས་གང་ཡང་རུང་བ་ཞིག་ཁྲོས་པར་གྱུར་ན་དེའི་རྒྱུས་ཁྱོད་འཆི་བའམ་འཆི་བ་ལ་ཐུག་པ་ཙམ་གྱི་སྡུག་བསྔལ་ཉམས་སུ་མྱོང་བར་འགྱུར་རོ།",
