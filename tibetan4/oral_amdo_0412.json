    "བཅོམ་ལྡན་འདས་ཡངས་པ་ཅན་སྤྲེའུའི་རྫིང་གི་འགྲམ་གྱི་གཙུག་ལག་ཁང་ན་བཞུགས་ཏེ།",
    "དཔག་ཚད་སྟོང་ཕྲག་དྲུག་དང་ལྔ་དང་བཞི་དང་གསུམ་དང་གཉིས་དང་གཅིག་གི་ཆུ་ལས་པར་འགྱུར་ཏེ།",
    "དགེ་སློང་དག་ཉི་མ་ལྔ་འཇིག་རྟེན་འདི་ན་ཤར་བ་ན་རྒྱ་མཚོ་ཆེན་པོ་ལས་དཔག་ཚད་བདུན་གྱི་ཆུ་ལས་པར་འགྱུར་ཞིང་དྲུག་དང་ལྔ་དང་བཞི་དང་གསུམ་དང་དཔག་ཚད་གཉིས་དང་གཅིག་གི་ཆུ་ལས་པར་འགྱུར་རོ།",
    "དགེ་སློང་དག་ཉི་མ་ལྔ་པ་འཇིག་རྟེན་འདིར་ཤར་བ་ན་རྒྱ་མཚོ་ཆེན་པོ་བདུན་ལས་རྒྱང་གྲགས་བདུན་གྱི་ཆུ་ལས་པར་འགྱུར་ཞིང་དྲུག་དང་ལྔ་དང་བཞི་དང་གསུམ་དང་གཉིས་དང་རྒྱང་གྲགས་གཅིག་གི་ཆུ་ལས་པར་འགྱུར་རོ།",
    "སོར་མོའི་རྩེ་མོ་ནུབ་པ་ཙམ་དུ་འགྱུར་ཏེ།",
    "འདི་ལྟ་སྟེ་ཤིང་གི་ཁུར་པོ་བཅུ་དང་།",
    "ཤིང་གི་ཁུར་པོ་བརྒྱ་སྟོང་ཕྲག་དུ་མ་དང་།",
    "ཤིང་གི་ཁུར་པོ་གཞན་བརྒྱ་སྟོང་ཕྲག་དུ་མ་དང་།",
    "ཤིང་གི་ཁུར་པོ་སྟོང་ཕྲག་དུ་མ་དང་།",
    "ཤིང་གི་ཁུར་པོ་གཞན་བརྒྱ་སྟོང་ཕྲག་དུ་མ་ལས་བྱུང་བའི་མེའི་ཕུང་པོ་ཆེན་པོ་སྲེག་པར་བྱེད་པ་དེ་བཞིན་དུ་དགེ་སློང་དག་འཇིག་རྟེན་འདིར་ཉི་མ་བདུན་ཤར་བ་ནས་ཆེན་པོ་རིའི་རྒྱལ་པོ་རི་རབ་དང་བཅས་པ་འབར་ཞིང་རབ་ཏུ་འབར་ཏེ་ཀུན་དུ་འབར་ཞིང་མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ཅིང་སྲེག་པར་བྱེད་དོ།",
    "དགེ་སློང་དག་ས་ཆེན་པོ་དང་རིའི་རྒྱལ་པོ་རི་རབ་ཚིག་ཅིང་བསྲེགས་པ་ན་ཐལ་བ་ཙམ་གྱི་ལྷག་མ་ཡང་མ་ལུས་པར་འགྱུར་རོ།",
    "དེ་ནས་སྟོན་པ་མིག་བཟངས་འདི་སྙམ་དུ་བདག་ཉན་ཐོས་རྣམས་དང་ལྷན་ཅིག་འགྲོ་བ་དང་སྙོམས་པར་འཇུག་པ་ནི་ཚུལ་དང་མཐུན་པ་མ་ཡིན་གྱིས་བདག་གོང་མ་བསམ་གཏན་གཉིས་པ་བསྒོམས་ནས་འོད་གསལ་གྱི་ལྷ་རྣམས་དང་སྐལ་བ་མཉམ་པར་སྐྱེ་བར་བྱའོ་སྙམ་མོ།",
    "དགེ་སློང་དག་ཁྱོད་ཅག་དེའི་ཚེ་དེའི་དུས་ན་སྟོན་པ་མིག་བཟངས་ཞེས་བྱ་བ་ཕྱི་རོལ་མུ་སྟེགས་ཅན་རྫུ་འཕྲུལ་དང་ལྡན་པ་འདོད་པ་ལས་འདོད་ཆགས་དང་བྲལ་བ་བྱུང་བར་གྱུར་ཅིང་།",
    "གང་གི་རྣམ་པ་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་མ་ཡིན་པ་དེ་དག་ལས་ཁ་ཅིག་ནི་འོག་མའི་ཆ་དང་མཐུན་པ་ཀུན་དུ་སྦྱོར་བ་ལྔ་སྤངས་ཏེ།",
    "གང་གི་རྣམ་པ་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་མ་ཡིན་པ་དེ་དག་ལས་ཁ་ཅིག་ནི་ཀུན་དུ་སྦྱོར་བ་གསུམ་པོ་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་བསྲབས་ཏེ་ལན་ཅིག་ཕྱིར་འོང་བ་འཇིག་རྟེན་འདིར་ལན་ཅིག་ཕྱིར་འོངས་ནས་སྡུག་བསྔལ་མཐར་བྱེད་པར་འགྱུར་རོ།",
    "གཉིས་པ་ནི་རེག་པའོ།",
    "གཞན་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་རྣམ་པར་ཤེས་པའི་གནས་བཞི་ནི་ཞིང་གི་ངོ་བོར་བསྟན་ལ།",
    "དེ་བྱ་རྒོད་ཕུང་པོའི་རིའི་དྲུང་དུ་སོང་ནས་ཡི་དགས་མོས་གཤིན་རྗེ་སྲིན་མོ་ལྟ་བུར་ཁྲག་གི་ཐིགས་པས་འབགས་པ།",
    "ཡི་དགས་མོས་སྨྲས་པ།",
    "བདག་ཅག་གིས་ལས་ཇི་ལྟ་བུ་བསགས་པ་སྟོན་པར་འགྱུར་རོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་ཉེ་བར་སོང་ངོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ལ་བོས་ཏེ།",
    "མོད་གལ་གྱི་བུ་ད་ལྟར་གང་ནས་འོངས།",
    "མོད་གལ་གྱི་བུས་སྨྲས་པ།",
    "དེར་བདག་གིས་ཡི་དགས་མོ་གཤིན་རྗེ་སྲིན་མོ་ལྟ་བུ་ཁྲག་གི་ཐིགས་པས་འབགས་པ།",
    "བདག་གི་ཉིན་མོ་བུ་ལྔ་དང་།",
    "དེ་བཞིན་མཚན་མོ་བུ་ལྔ་དག།",
    "སྐྱེས་ནས་དེ་དག་ཟ་མོད་ཀྱི།",
    "ཡོངས་སུ་སྤྱོད་པར་བྱེད་པ་ལས་བུ་ཕོ་ཡང་མེད་བུ་མོ་ཡང་མེད་དོ།",
    "བདག་གི་ཁྱིམ་ན་ནོར་མང་པོ་ཡོད་ཅིང་བུ་ཕོ་ཡང་མེད་བུ་མོ་ཡང་མེད་པས་བདག་གི་ནོར་ཐམས་ཅད་བུད་མེད་ཅེས་རྒྱལ་པོས་ཁྱེར་བར་འགྱུར་རོ་ཞེས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "དེ་བུ་དང་བུ་མོ་འདོད་པའི་ཕྱིར་ཞི་བ་དང་།",
    "འཇིག་རྟེན་ན་གསོལ་བ་འདེབས་པའི་རྒྱུས་བུ་དང་བུ་མོ་སྐྱེའོ་ཞེས་གྲགས་པ་ཡོད་མོད་ཀྱི།",
    "གལ་ཏེ་དེ་ལྟར་གྱུར་ན་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་བཞིན་དུ་རེ་རེའང་བུ་སྟོང་སྟོང་ལྡན་པར་འགྱུར་རོ།",
    "འོན་ཀྱང་གནས་གསུམ་མངོན་དུ་གྱུར་ན་བུ་ཕོ་དང་བུ་མོ་དག་སྐྱེ་བར་འགྱུར་ཏེ།",
    "གནས་གསུམ་མངོན་དུ་གྱུར་ན་བུ་ཕོ་དང་བུ་མོ་དག་སྐྱེ་བར་འགྱུར་གྱི།",
    "ལྷ་ལ་གསོལ་བ་འདེབས་པས་བུ་དང་བུ་མོ་དག་སྐྱེ་བ་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་བདག་གིས་དཀུ་གཡས་པར་རྟེན་ཅིང་གནས་པས་ན་ངེས་པར་ཁྱེའུར་འགྱུར་རོ།",
    "སྟེང་གི་ཁང་བཟངས་ཀྱི་གཞི་དང་ལྡན་པར་བཞག་སྟེ།",
    "ལྷ་མོ་དགའ་བའི་ཚལ་ན་རྒྱུ་བ་བཞིན་དུ་ཁྲི་ནས་ཁྲི་དང་།",
    "ཁྲིའུ་ནས་ཁྲིའུར་འོག་གིས་གཞི་ལ་མི་འབབ་ཅིང་སྒྲ་མི་སྙན་པ་ཅུང་ཟད་ཀྱང་མི་ཐོས་པར་ཇི་སྲིད་དུ་མངལ་ཡོངས་སུ་སྨིན་པར་བྱེད་དོ།",
    "དེ་ནས་དེའི་ཚེ་ཆེན་མས་དེའི་རིམ་གྲོ་དེ་དག་མཐོང་ནས་ཕྲག་དོག་གི་སེམས་སྐྱེས་ཏེ།",
    "གལ་ཏེ་ངས་ཁྱོད་ཀྱི་མངལ་རླུགས་པར་བྱས་ན་ང་ཡི་དགས་སུ་གྱུར་ཅིག།",
    "མོད་གལ་གྱི་བུ་ཇི་སྙམ་དུ་སེམས།",
    "ཕྱུག་པོའི་ཆུང་མ་དེ་ནི་ཡི་དགས་མོ་འདི་ཉིད་ཡིན་ཏེ།",
