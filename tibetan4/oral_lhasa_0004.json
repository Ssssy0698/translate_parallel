    "སྐུ་འབུམ་ཞེས་པའི་མིང་འདི་མཆོད་རྟེན་གྱི་ནང་རྟེན་དུ་བཞུགས་པའི་རྒྱལ་བ་སེང་གེའི་ང་རོའི་སྐུ་དཔར་མ་ས་འབུམ་བཞུགས་པ་ཙམ་གྱིས་སྐུ་འབུམ་ཞེས་མཚན་བཏགས་པ་མ་ཡིན་པར།",
    "འདབ་མ་འབུམ་ལ་དེ་བཞིན་གཤེགས་པ་སེང་གེའི་ང་རོའི་སྐུ་འབུམ་ཕྲག་དངོས་སུ་བཞུགས་པ་དེ་ལ་བརྟེན་ནས་སྐུ་འབུམ་ཞེས་ཐོགས་སོ།",
    "དེས་ན་རྗེ་བློ་བཟང་གྲགས་པའི་མཚན་ལ་ཙོང་ཁ་པ་ཞེས་ཐོགས་དོན་ཅི་ཡིན་ཞེ་ན་རགས་ཙམ་བརྗོད་པར་བྱ་ལ།",
    "རྗེ་ཙོང་ཁ་པ་དགུང་ལོ་ལྔ་བཅུ་ང་གསུམ་བཞེས་པའི་ཚེ།",
    "བླ་ཆེན་དགོངས་པ་རབ་གསལ་གྱིས་ཀླུ་མེས་བོད་དུ་འབྱོན་ཁར་དབུ་ཞྭ་སེར་པོ་བཞེས་འཕྲོ་ཞིག་གནང་ནས་འདི་གྱོན་ལ་ང་རྗེས་སུ་དྲན་པར་གྱིས་གསུངས་པར་བརྟེན་སྔོན་གྱི་འདུལ་འཛིན་པ་ཆེན་པོ་རྣམས་ཀྱིས་དབུ་ཞྭ་སེར་པོ་ནབ་པ་ཡིན་པས།",
    "སྔ་མའི་བཞེད་ཚུལ་དེ་ཁུངས་བཙུན་ཞིང་འཁྲུལ་བ་མེད་པ་ཞིག་མིན་པར་བསམས།",
    "བསླུ་མེད་སྐྱོན་དང་བྲལ་བ་ཞིག་ཡིན་པར་སེམས་སོ།",
    "བགྲང་བྱ་སྟོང་ཕྲག་དུ་མར་སྡོམ་རྒྱས་དམ་པོར་འཆིང་བའི་འཛིན་མ་རྣམ་པར་གྲོལ་ནས།",
    "བདེ་སྐྱིད་ཀྱི་འདབ་བརྒྱ་མ་ལུས་ས་ཕྱོགས་ཀུན་ཏུ་ལྷུག་པར་བཞད་ཅིང་།",
    "ཆེན་ལ་སོགས་པར་བརླག་སྐྱོན་ཚབས་ཆེན་མ་ཐེབས་པ་ལགས་སོ།",
    "ཞྭ་སེར་རི་བོ་དགེ་ལུགས་པའི་སྲོལ་འབྱེད་གནང་སྟེ།",
    "ལོ་དེར་རྒྱལ་བས་ལུང་བསྟན་པ་ལྟར་འབྲོག་རི་ཆེན་པོ་དགའ་ལྡན་རྣམ་པར་རྒྱལ་བའི་གླིང་བཏབ་སྟེ།",
    "ཁྱེད་ཀྱིས་པོ་ཏི་བརྒྱ་བློ་ཐོག་ནས་ཤོད་གསུངས་པས།",
    "བརྒྱ་དང་བརྒྱད་ཀྱི་ཚིག་དོན་མཐའ་དག་ཐུགས་ལ་བཟུང་ནས་འཆད་པར་མཛད།",
    "ཤག་སྐོར་ཐོས་བསམ་གླིང་ངམ་རྒྱལ་བ།",
    "མི་རིགས་གཞན་པ་སྟེ་རྒྱ་རིགས་དང་སོག་རིགས་བཅས་ལ་ཡང་དར་བ་ཧ་ཅང་སྔ་བ་ལགས།",
    "རྗེས་ལུས་ནས་སྔོན་ཐོན་ཕྱོགས་སུ་གོམ་ཁ་སྤོས་པའི་རྐྱེན་གྱིས་གཡུལ་འགྱེད་སྐབས་སུ་མདའ་མདུང་གྲི་གསུམ་ཀྱི་བཀོལ་རྒྱ་ཡང་ཇེ་ཆུང་དུ་གྱུར་པར་བརྟེན།",
    "མི་རྣམས་ཀྱིས་རང་ཤུགས་སུ་མདའ་རྩེད་ཅེས་པའི་མིང་ཚིག་འདི་གསར་བཟོ་བགྱིས་པ་ལགས།",
    "ཐེངས་འདིའི་མདའ་དཔོན་དང་གཞུག་མའང་ཐག་གཅོད་དགོས་པ་ལགས།",
    "ལུགས་སྲོལ་ལྟར་ན་མ་བུ་ཁྲིད་མཁན་དེར་ངེས་པར་དུ་རང་ལ་མ་ཡོད་དགོས་པ་དང་བུ་ཁྲིད་མཁན་དེར་ངེས་པར་དུ་རང་ལ་བུ་ཡོད་དགོས་པ་ཡིན།",
    "མདའ་དཔོན་དང་གཞུག་མ་ནི་མདའ་བ་བྱིངས་རྣམས་ཀྱིས་འདེམས་བསྐོ་བྱས་པས་ཆོག་གཞུག་མ་ཟེར་བ་ལ་མདའ་གཞུག་ཀྱང་ཟེར།",
    "ཐམས་ཅད་ཀྱིས་ཀི་བསྭོ་བསྭོ་ལྷ་རྒྱལ་ལོ་ཞེས་ལན་མང་པོ་སྒྲོག་ཅིང་ཕྱིར་མདའ་འཕེན་སར་ལོག་པ་ལགས་སོ།",
    "མ་ལོངས་རྗེས་བུ་ཁྲིད་པའི་འགོ་བརྩམས་པ་ལགས།",
    "གཞན་ཡང་ཕན་ཚུན་ལ་གྲོས་སྡུར་ཅི་ཡང་མེད་པར་མདའ་རྒྱུག་ཏུ་འགྲོ་བའི་སྲོལ་ཡང་ཡོད།",
    "གལ་ཏེ་ཕམ་པར་གཏོང་མ་ཐུབ་ན་སྒོ་མི་འབྱེད།",
    "གྲལ་ཉིས་བསྒྲིགས་བྱས་ནས་སྐུ་མགྲོན་རྣམས་དེའི་དཀྱིལ་དུ་འགྲོ་བའི་སྐབས་སུ་ཆང་འདྲེན་ཅི་ཐུབ་བྱེད་པ་དང་།",
    "ལར་ཆབ་འགག་ཡུལ་གྱི་རྒྱ་ར་གཙོ་བྱས་པའི་རྐ་གསར།",
    "ས་དེ་ཡང་ཆབ་འགག་ཅེས་པའི་ཡུལ་གྲུ་འདི་ནི་སྟོད་ན་རི་རབ་ཀྱི་དབུ་འཕང་རྣམ་པར་མཐོ་བའི་དཀར་ཕྱོགས་སྐྱོང་བའི་བློན་པོ་གསེར་ཆེན་ལྷུན་ཞིང་ཟླ་བརྗིད་པར་ཆགས་ཤིང་།",
    "དེ་ཡང་སྔོན་མཁས་ཆེན་དམ་པ་རྣམས་ཡུལ་འདི་རུ་ཕེབས་པའམ་བརྒྱུད་ནས་འགྲོ་བའི་སྐབས་སུ།",
    "གནའ་ནས་ད་ལྟའི་བར་རྒྱུན་མ་ཆད་པ་དང་མ་ཉམས་པར་རྒྱུན་སྐྱོང་བཞིན་པའི་ཆབ་འགག་ཡུལ་གྱི་ལབ་རྩེ་ཆབ་རིལ་ལྟ་བུ་ནི་ཉུང་ཙམ་ལགས་སོ།",
    "བདེ་ཞིང་ཁོད་སྙོམས་པའི་ལབ་རྩེ་ཆབ་རིལ་ཐང་ཞེས་པའི་མེ་ཏོག་སྣ་བརྒྱ་རྣམ་པར་བཞད་ཅིང་།",
    "དེ་ཡང་ཐོག་མར་ལབ་རྩེ་ཆབ་རིལ་ཞེས་པའི་མིང་འདིའི་འབྱུང་ཁུངས་གསལ་བོར་མ་བརྗོད་ན་མི་ཆོག་པར་བརྟེན།",
    "ཞོར་དུ་ལྷ་སར་འགྲོ་བའི་ལམ་ཁར་ལབ་རྩེ་བརྒྱ་དང་བརྒྱད་བསྟོད་རྒྱུའི་འཆར་གཞི་འཐེན་ནས་ལམ་ལ་ཆས།",
    "ཕྱིས་སུ་སྐྱབས་མགོན་ཚོགས་དྲུག་རང་གྲོལ་གྱི་སྐུ་རིང་ཞིག་གནས་འདིར་ཕེབས་ཏེ།",
    "ཞོར་དུ་གླུ་ལེན་གར་རྩེད་ཀྱི་སྲོལ་ཆགས་པར་གྲགས།",
    "ཅུང་ཐག་རིང་བར་ཡོད་པའི་མི་རྣམས་རྟ་དྲེལ་སོགས་ལ་ཞོན་པ་ལགས་ཅནས་ཡོང་བ་ཡིན།",
    "དེའི་འཕྲོར་མདའ་འཕེན་པ་ལགས།",
    "འབའ་ཞིག་ཏུ་མི་བསམ་པར།",
    "ཚེས་བཅོ་བརྒྱད་དང་བཅུ་དགུར་ཡང་མུ་མཐུད་དུ་འཕངས་ཆོག་པ་ལགས།",
    "བསྟོད་པའི་བསྔགས་བརྗོད་ཡང་ཡང་བྱེད་པར་མ་ཟད།",
    "རིམ་གྱིས་གླུ་ཤགས་རྩེད་རིག་སོགས་ཕན་ཚུན་བླངས་ཤིང་འཁྲབ་ནས་དུས་ཚོད་གཅིག་ཡས་མས་ཀྱི་སྐབས་སུ།",
    "ཁྱད་པར་དུ་སྐད་ངག་ལྡན་པའི་གླུ་བ་གླུ་མས་བླངས་པའི་ལ་གཞས་ལ་ཉན་འདོད་དེ་ལས་ཀྱང་ཆེ།",
    "གཞར་ཡང་ཉམས་པ་མེད་པར་གནས་གྱུར་ཅིང་ལབ་རྩེ་སྔར་ལས་བརྗིད་ཉམས་ཆེ་བ་དང་།",
    "བར་དབུས་གཙང་རུ་བཞི།",
    "མཚོ་སྔོན་པོའི་འགྲམ་རྒྱུད་དུ་འཚོ་གཞེས་གནང་བཞིན་པའི་འབྲོག་པ་རྣམས་ཀྱི་གཉེན་སྒྲིག་ལ།",
