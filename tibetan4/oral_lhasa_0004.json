    "བློ་སྤོབས་དེ་ངེས་པར་དུ་ལག་ལེན་ཐོག་ཏུ་ནན་ཏན་བྱེད་པ་ལས་སྔོན་དཔག་གྲུབ་འབྲས་ལ་དེ་ལྟར་མ་ཡིན་ནོ།",
    "པའོ་དབྱི་དབྱིན་སོགས་ཇི་ལྟར་ལགས།",
    "ཁུང་ཙིའི་མི་འདྲ་ས་གང་ལགས།",
    "དྲག་ཤུགས་ལ་བརྟེན་ནས་མི་ཡིས་བཀའ་བརྩི་སྲུང་དང་ལེན་བྱེད་པ་ནི་སེམས་སྟེང་ནས་དེ་ལྟར་མ་ལགས་ཏེ་སྟོབས་ཤུགས་ཀྱིས་མ་འདང་བས་སོ།",
    "བྱམས་བརྩེ་བྱས་ཚེ་གཟི་བརྗིད་དང་བྱམས་བརྩེ་མ་བྱས་ཚེ་ངོ་ཚའི་གནས་སོ།",
    "དོན་དག་འདི་ལྔ་བོ་ལེགས་པར་བསྒྲུབ་ཐུབ་ཚེ་ཁྱིམ་མཚེས་རྒྱལ་ཁབ་ཀྱི་མི་སེར་གྱི་རང་ལ་ཕ་མ་ཡོད་བཞིན་ཡིད་སྨོན་བྱའོ།",
    "དེར་རྟེན་གནམ་འོག་ཏུ་འགྲན་ཟླ་མེད་པར་གྱུར་ཏོ།",
    "བྱམས་སྲིད་ཀྱིས་མི་སེམས་འགུག་ཐུབ་པས་མེང་ཅིས་རྒྱལ་བོས་བྱམས་སྤྱོད་ལ་ནན་ཏན་བྱས་ཚེ་མི་དམངས་ཀྱི་སེམས་རང་འགུལ་གྱིས་འགུག་པར་སེམས་སོ།",
    "དེ་མིན་བྱིས་པའི་ངུ་སྐད་ཐོས་མི་འདོད་པར་དེ་ལྟར་གྱུར་བ་བཅས་མིན་ནོ།",
    "ཁྲབ་རྨོག་བཟོ་མཁན་གྱིས་མདའ་མི་ཁོག་པར་སྐྲག་གོ།",
    "དེ་ལྟ་བུའི་མི་ངན་ལ་སུན་སྣང་སྐྱེས་པའི་བསམ་པ་ཁྱབ་སྤེལ་བྱས་ན་དེའི་བསམ་པ་ལ།",
    "ཡང་བདག་ལ་ཅི་ཞིག་གནོད་པར་འགྱུར།",
    "རྒྱལ་ཁབ་སྲུང་སྐྱོབ་བྱེད་པར་རི་ཀློང་དཀན་གཟར་ལ་རྟེན་མི་དགོས་ཞིང་སྙན་གྲགས་གནམ་འོག་ཏུ་རྒྱས་དགོས་ན་མཚོན་ཆ་རྣོན་པོ་ལ་རྟེན་མི་དགོས་སོ།",
    "མེང་ཙིས་གནམ་འོག་ཐོབ་དགོས་ན་ཐོག་མར་མི་སེམས་ཐོབ་དགོས་པར་བཞེད་དོ།",
    "རྒྱལ་བོས་བློན་པོ་འབོད་ན་ཤིང་རྟ་སྟ་གོན་བྱས་ཡོད་མེད་ལ་མི་ལྟོས་པར་སྔོན་དུ་འགྲོའོ་ཞེས་སོཁྱེད་དང་པོར་རྒྱལ་བོ་མཇལ་བར་འགྲོ་གྲབས་ཡོད་ལ།",
    "མེང་ཙིས་འཇོན་ཐང་ལྡན་པའི་མི་ལ་མཐོང་ཆེན་དང་བྱམས་སྤྱོད་ལྡན་པར་གུས་བཀུར་བྱེད་པ་ནི་རྒྱལ་ཁབ་འཕེལ་རྒྱས་འགྲོ་བའི་གཞི་རྩ་ཡིན་པར་དགོངས།",
    "སྐྱེས་བུ་དམ་པས་དོན་བྱ་བསྒྲུབ་པ་ལ་རྒྱུན་དུ་གནས་ལུགས་དང་མཐུན་པ་ལས་རང་དགར་གཞན་གྱི་དངུལ་ལེན་པར་མི་བྱའོ།",
    "ཁྲི་ཝས་རྒྱལ་བོ་ལ་དྲན་འཆར་གླེང་ནའང་དེས་དང་ལེན་མ་བྱས་པས་ལས་ཁུར་རྩ་དགོངས་ཞུས།",
    "བསྡད་ན།",
    "རྒྱུ་ནོར་གྱིས་པུར་སྒམ་བཟོ་བ་མི་འདང་ཚེའང་ཡིད་ཚིམ་པར་ག་ལ་འོང་།",
    "མི་དེས་ཀྱང་རྒྱལ་པོའི་བཀའ་མེད་པར་ལྐོག་ཏུ་བླངས་ན་ཆོག་གམ།",
    "མི་དེ་མངགས་དུས་ཟིང་འཁྲུག་བསླང་རྒྱུ་ཡིན་པ་ཤེས་པར་མངགས་ན་དེ་ལ་བྱམས་བརྩེ་མེད་པ་དང་།",
    "ཆུ་༤ ༡ མེང་ཙིས་དཔོན་པོ་ཕྱི་མའི་གོ་གནས་རྩ་དགོངས་ཞུས་ནས་ཕྱིར་རང་ཡུལ་དུ་ལོག་པའི་སྟ་གོན་བྱས་སོ།",
    "སྐྱེས་བུ་ཐ་ཤལ་བ་ཞིག་ཡོད་པ་དེས་ས་མཐོན་པོ་ཞིག་བཙལ་ནས་དེར་འགོས་ཏེ་གཡས་གཡོན་ལ་བལྟས་ནས་ཚོང་རའི་ཁེ་ཕན་བསྡུ་རུབ་བྱེད་པར་འདོད།",
    "མེང་ས་རང་ཉིད་འགྲོ་བ་དང་སྡོད་པ་ནི་རྒྱལ་བོའི་ལུགས་ལྟར་བྱམས་སྲིད་སྐྱོང་ཐུབ་མིན་ལ་རག་ལས་པ་ལས་ཁེ་ཕན་ལ་ཐུག་པ་མིན་པར་འདོད།",
    "སྐད་ཆ་དེ་དག་ད་དུང་བརྗེད་མེད་པར་སེམས་སུ་གནས་ཡོད།",
    "མྱ་ངན་གོས་གྱོན་པའི་ལོ་གསུམ་རིང་དུ་རས་རྩུབ་པོས་མཐའ་ཤན་བྱས་པའི་སྡུག་གོས་གྱོན་ལ།",
    "དཔོན་རིགས་དང་ཉེ་འབྲེལ་ཚོ་ལ་ཡིད་འཐད་བྱུང་ནས་ཚང་མས་རྒྱལ་སྲས་ཀྱིས་གུས་ལུགས་ཤེས་པར་སེམས་སོ།",
    "དེར་བརྟེན་མཁས་མཛངས་ལྡན་པའི་རྗེ་བོ་ཡིས་ངེས་པར་གུས་ཞུམ་བཀོལ་མཁས་དང་།",
    "ཁུང་ཙི་སྐུ་གཤེགས་རྗེས་སུ་བུ་སློབ་ཚོས་སྐུ་གདུང་ལོ་གསུམ་ལ་སྲུང་ནས་ཅ་ལག་བསྡུ་གསོག་བྱས་ཏེ་ཕྱིར་ལོག་པའི་སྟ་གོན་བྱས་སོ།",
    "ཙིཀུང་ཕྱིར་དུར་སར་ལོག་ནས་སླར་སྤྱིལ་བུ་བཟོས་ནས་གཅིག་པུར་ལོ་གསུམ་ལ་བསྡད་རྗེས་ད་གཟོད་ཕྱིར་ལོག་པའོ།",
    "རང་དང་ཏའེ་ཟེར་བའི་མཐའ་འཁོབ་པར་རྡུང་རྡེག་བྱེད་དགོས་ལ།",
    "གཏམ་འདིའི་ནང་དོན་གང་ལགས་ཞེ་ན།",
    "དེས་གུས་ལུགས་ལྟར་བཀའ་དང་དུ་མི་ལེན་པར་མདུན་དུ་མི་འགྲོ་བ་དེའོ།",
    "ཐག་བཅད་ལས་བརྒལ་ནས་ཁ་ལོ་བ་བྱས་ན་སྔ་དྲོ་གཅིག་ལ་བྱ་བཅུ་སོད་དོ།",
    "ཁ་ལོ་བས་མདའ་འཕེན་མཁན་ལ་ཅུང་ཟད་འོས་མེད་བསྟུན་ཐབས་བྱས་ཚེ་དེ་ལས་བྱ་དང་རི་དྭགས་མང་པོ་སོད་པ་དང་སྤུངས་ན་རི་ལྟར་གྱུར་ནའང་དེས་དེ་ལྟར་ག་ལ་བསྒྲུབ།",
    "དེ་ལྟར་ལགས་ན་འཚམས་འདྲི་བྱེད་མི་དགོས་སམ།",
    "པར་འབྲུ་རིགས་ལྷག་མ་ཡོད་པ་དང་།",
    "ཀུན་སློང་ལ་བལྟས་ཏེ་སྟེར་བ་ལགས།",
    "དེ་ལྟར་ལགས་ན།",
    "གལ་ཏེ་རྒྱལ་བོའི་ཁབ་ཏུ་ལོ་ན་ཆེ་ཆུང་དང་དཔོན་གནས་མཐོ་དམན་མེད་པར་ཚང་མ་ཞུའེ་ཅུས་ཀྲོའུ་མི་འདྲ་ན།",
    "སུང་རྗེ་ཡི་ཡོ་བ་སྲོང་བ་ལ་མཛངས་བློན་མང་པོ་དགོས་པར་བཞེད་དོ།",
    "གལ་ཏེ་ཨུ་ཚུགས་བྱས་ཏེ་མཇལ་དགོས་ཞེ་ན་དེའང་མཇལ་ཐུབ་བོ།",
    "དེ་ལྟར་ལགས་ནའང་དེ་ལ་སྤྱོད་གཙང་ཞེས་སྨྲ་ཆོག་གམ།",
    "འདི་ལྟ་བུའི་སྤྱོད་གཙང་ནི་ཇི་ལྟར་ཁྱབ་གདལ་དུ་གཏོང་ངམ།",
    "གནའ་དུས་སུ་ཐོས་ཤུགས་འགྲན་ཟླ་དང་བྲལ་བའི་མི་ཞིག་། མེང་ཙི་བསྟར་མ་བྱས་པས་ལན་ནོ།",
