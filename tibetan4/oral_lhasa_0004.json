    "དེའི་བསམ་པར།",
    "གོ་གནས་མཐོ་བས་གོ་གནས་དམའ་བ་ལ་བརྩི་བཀུར་བྱེད་པ་ནི་སྤྱོད་ཡོན་གཉིས་ལྡན་གྱི་མི་ལ་བརྩི་མཐོང་བྱས་པ་ཟེར་རོ།",
    "ཝེ་ཞའོ་ཀུང་ལ་ནི་དེས་རྗེ་བོས་སྤྱོད་ཡོན་ལྡན་པར་བསྙེན་བཀུར་བྱས་པས་དཔོན་པོར་བསྡད་དོ།",
    "གལ་ཏེ་རྒྱལ་བོས་དེ་ལ་གནང་བའི་འབྲུ་རིགས་ཡིན་ན་བླངས་ཆོག་གམ།",
    "དེ་ལ་གོ་གནས་སྤྲད་དེ་བཀོལ་སྤྱོད་མི་བྱེད་པ་དང་ཡང་ན་འོས་འཚམས་ཀྱིས་བཀུར་བསྟི་ཙམ་ཀྱང་མི་བྱེད་ན་དེ་ལ་སྤྱོད་ཡོན་ལྡན་པར་གཅེས་སྐྱོང་བྱས་ཞེས་སྨྲའམ།",
    "ནོར་ལུག་དང་འབྲུ་རིགས་སྟ་གོན་གང་ལེགས་བྱས་ཏེ།",
    "ས་ཞིང་དང་རི་ཐང་དུ་དེ་ལ་བཀུར་བསྟི་བྱས་ནས་མཐར་ཁྲི་ལ་འཁོད་པར་བྱས་སོ།",
    "རྒྱལ་བོས་ཀྱང་གོ་གནས་ལྟར་དེ་ལ་མཇལ་ཁ་གནང་བས་སོ།",
    "ཡར་ཐོན་གྱི་རྗེས་བསྙེག་པ་ནི་འཛད་མཐའ་མེད་པར་བཞེད་དོ།",
    "གལ་ཏེ་དེ་ཡི་རང་བཞིན་ལ་གནོད་པ་བྱས་ནས་བཏུང་སྣོད་སླེས་པ་ཡིན་ན།",
    "མི་གཤིས་ལ་བྱམས་དང་མི་བྱམས་པའི་ཁྱད་པར་མེད་པ་ནི་ཆུ་རྒྱུན་ལ་ཤར་ནུབ་ཀྱི་ཁྱད་པར་མེད་པ་བཞིན་ནོ།",
    "གལ་ཏེ་མཉམ་དུ་ཨ་རག་བཞེས་ན་ཐོག་མར་སུ་ལ་ཆང་འདྲེན།",
    "ནུ་བོས་མཆོད་རྫས་ཀྱི་ཚབ་བྱས་ཡོད་ན་སུ་ལ་བརྩི་བཀུར་བྱེད།",
    "ནུ་བོ་ནི་མཆོད་རྫས་ཀྱི་ཚབ་བྱས་པའི་གནས་སུ་ཡོད་པས་སོ།",
    "མེང་ཚིས་མི་གཤིས་བྱམས་ལྡན་གྱི་ལྟ་ཚུལ་གྱིས་མི་རྣམས་ཀྱིས་རང་རྟོགས་ཀྱིས་བྱམས་པའི་ནུས་པ་འདོན་སྤེལ་བྱེད་པར་སྐུལ་ལོ།",
    "ལོ་ལེགས་བྱུང་བའི་དུས་སུ་ན་གཞོན་དང་བྱིས་པར་སྒྱིད་ལུག་ཆེ་ལ།",
    "རྣ་བའང་དེ་ལྟར་ལགས་སོ།",
    "མིག་ཀྱང་དེ་ལྟར་ལགས་སོ།",
    "མི་རྣམས་ཀྱིས་དེ་ནི་དུད་འགྲོ་དང་མཚུངས་པར་མཐོང་ན་དེ་ལ་མི་ཡི་རང་གཤིས་ལྡན་མེད་པར་འདོད་དོ།",
    "གལ་ཏེ་མི་རྣམས་ལ་དགོས་པར་འདོད་པ་དེ་འཚོ་གནས་ལས་བརྒལ་མེད་ན་འཚོ་གནས་ཐུབ་པའི་ཐབས་ཤེས་ཐམས་ཅད་གང་དག་བེད་སྤྱོད་མི་བྱེད་དམ།",
    "ཕུང་པོ་ལ་མཆོག་དང་དམན་པའི་ཁྱད་པར་ཡོད་ལ་རྩག་རྩིག་དང་རྩ་ཆེན་གྱི་ཁྱད་པར་ཡོད་དོ།",
    "བསམ་གཞིག་མ་བྱས་ཚེ་རྟོགས་ཐབས་མེད་དོ།",
    "གལ་ཏེ་སྐྱེས་ནས་སྨིན་པར་གྱུར་མེད་ཚེ་ད་དུང་འཇག་མ་རྩྭ་ལྗིད་ཀྱང་འགྲན་མི་ནུས་སོ།",
    "མེང་ས་བྱམས་སྤྱོད་གཉེར་བའི་བགྲོད་ལམ་དུ་མི་མཐུད་དུ་ཧུར་བརྩོན་དགོས་པར་བཞེད་དོ།",
    "སློབ་སྤྱོང་བྱེད་མཁན་གྱིས་ཀྱང་ངེས་པར་གཞི་འགེང་དགོས་བའི་བླང་བྱ་བཏོན་ཏོ།",
    "དེ་ལྟ་ནའང་ངེས་པར་དུ་གུས་ལུགས་མཛད་སྒོ་ལྟར་བྱེད་དགོས་སམ།",
    "གཉེན་བསུ་བའི་གུས་ལུགས་བརྩི་སྲུང་བྱས་ན་ཆུང་མ་ཁབ་ཏུ་བཞེས་མི་ཐུབ་ལ།",
    "གཉེན་བསུ་བའི་གུས་ལུགས་ལ་བརྩི་སྲུང་མ་བྱས་ཚེ་ཆུང་མ་ཁབ་ཏུ་བཞེས་ཐུབ་ན།",
    "ད་དུང་ངེས་པར་དུ་གཉེན་བསུ་བའི་གུས་ལུགས་ལ་བརྩི་སྲུང་བྱེད་དགོས་སམ།",
    "འདི་ལ་ལན་འདེབས་པར་དཀའ་བ་ཅི་ཡོད།",
    "རྨང་གཞིའི་མཐོ་དམན་ལ་མི་གཞལ་བར་ཕན་ཚུན་གྱི་མཇུག་ལ་བསྡུར་བ་བྱས་ཚེ།",
    "མེང་ཙིས་གུས་ལུགས་ཀྱི་མཛད་སྒོ་དང་ཟས་ཟ་བ་དང་གཉེན་བསུ་བའི་ཐད་ལ་གྲོས་བསྡུར་གནང་བའོ།",
    "ཡའོ་དང་ཧྲུན་གྱི་ལམ་ནི་སྲི་ཞུ་དང་གུས་བཀུར་ལགས་སོ།",
    "མེང་ཙིས་ཚའོ་ཅའོ་ལ་གནས་ལུགས་འཚོལ་བ་ལ་ཐོག་མར་རྨང་གཞིའི་སྲི་ཞུ་དང་གུས་བཀུར་ནས་བརྩམས་དགོས་པར་གདམས་པའོ།",
    "སྐུ་ཞབས་གང་དུ་ཕེབས་རྒྱུ།",
    "དེ་བས་ཅིའི་ཕྱིར་ཕན་ཁེ་གླེང་བ་ལགས།",
    "ཆི་ཞེས་པའི་ཆུ་བོའི་འགྲམ་དུ་བསྡད་པ་ལ་ཆུ་བོའི་ནུབ་ཀྱི་མི་རྣམས་དེས་རྐྱེན་གྱི་གླུ་ལེན་པར་མཁས་པར་གྱུར་ཏོ།",
    "དཔོན་ངན་ཟ་རྔམ་ཅན་སྟེགས་བུའི་སྟེང་དུ་ཡོད་ན་དེ་ལ་ཆད་པ་གཅོད་དོརྒྱལ་ཕྲན་རྒྱལ་བོ་ཐེངས་གཅིག་ལ་གནམ་སྲས་མཇལ་བར་མ་འོང་ན་གོ་ཐེངས་གཉིས་པར་མཇལ་བར་མ་འོང་ན་ས་ཆ་ཉུང་གནས་འཐེན་པ་དང་།",
    "ཐེངས་གསུམ་པར་མཇལ་བར་མ་འོང་ན་དེ་ལ་དམག་དཔུང་དུ་གཏོང་བ།",
    "རྒན་པར་བཀུར་བསྟི་དང་ཆུང་བར་གཅེས་སྤྲས།",
    "ཁོ་ནི་སྐད་ཆ་ལེགས་པ་ལ་ཉན་པར་སྤྲོ་བས་སོ།",
    "སྐད་ཆ་ལེགས་པ་ལ་ཉན་པར་སྤྲོ་བ་ཁོ་ནས་ཆོག་གམ།",
    "གལ་ཏེ་བསམ་དོན་མི་འགྲུབ་པའི་ཚེ་རང་དོར་གཞན་བསྟུན་བྱེད་ཆོག་པར་བཞེད་དོ།",
    "ཧྥུ་ཡུའེ་ནི་མཁར་གྱང་བཟོ་བའི་ལས་ཀའི་ཁྲོད་ནས་ཡར་འཐེན་བྱས་པ་དང་།",
    "ཅའོ་ཀོ་ནི་ཉ་དང་ཚྭ་བཙོང་བའི་ཁྲོད་ནས་ཡར་འཐེན་བྱས།",
    "སུན་ཧྲུའུ་ཨའོ་ནི་མཚོ་འགྲམ་ནས་གནས་སྤར་བྱས་པ་དང་།",
    "རའི་ཁྲོད་ནས་ཡར་འཐེན་བྱས་སོ།",
    "དེའི་སེམས་ཀྱི་རང་བཞིན་སྔ་མ་ཇི་བཞིན་ཉར་ཚགས་བྱས་ཚེ་དེའི་རང་གཤིས་གསོ་ཐུབ་པ།",
    "བྱམས་སྤྱོད་བཅས་ཐད་ལ་བློ་ནུས་གང་ཡོད་འདོན་དགོས་པར་བཞེད་དོ།",
    "གཞན་ལས་ཞན་པར་གྱུར་ན་ངོ་ཚར་མི་འཛིན་པ་ལ་གཞན་ལ་འགྲན་ཐུབ་པ་ཅི་ཞིག་ཡོད།",
    "ཇི་ལྟར་བྱས་ཚེ་ད་གཟོད་སེམས་ལྷོད་བག་གཡེང་དུ་གྱུར་རམ།",
    "འཕགས་རྒྱལ་གྱི་མི་སེར་རྣམས་བློ་བདེ་བག་ཕེབས་ངང་འཚོའོ།",
    "སྐྱེས་བུ་དམ་པ་ངོ་མ་ཞིག་ཡིན་ཕྱིན་དེ་སླེབས་ཟིན་པའི་ས་ཆའི་མི་སེར་རྣམས་བློ་འགུག་པར་བྱེད་ལ།",
    "དེ་ཉམས་རྒུད་བྱུང་ནས་དབེན་པ་བསྟེན་རུང་བྲི་བ་མེད་པ་ནི་རང་སྐལ་གྱིས་ཐག་བཅད་བྱས་པས་སོ།",
    "ངེས་པར་དུ་རྦ་རླབས་ཀྱི་འབྱུང་རིམ་ལ་བལྟའོ།",
    "བྱས་རྗེས་འཇོག་ཐུབ་པའི་མི་ནི་ཁྲོན་པ་རྐོ་བ་དང་འདྲ་ལ་འདོམ་པ་དྲུག་བདུན་ཙམ་ལ་བརྐོས་ནས་ཆུ་མ་ཐོན་ཚེ་ཁྲོན་པ་དེ་ནི་བེད་མེད་ཀྱི་ཁྲོན་པར་གྱུར་ཏོ།",
    "དེས་གཞན་གྱིས་མི་གོ་བར་ཕ་རྒན་ཁུར་ནས་བྲོས་ཏེ་མཚོ་འགྲམ་དུ་བསྡད་ནས་མི་ཚེ་གང་པོར་དགའ་དགའ་སྤྲོ་སྤྲོའི་ངང་ནས་གནམ་འོག་ཀྱང་བརྗེད་དོ།",
    "ཡིན་ནའང་དེས་དྲིས་པའི་སྐད་ཆ་ལ་ཉིད་ཀྱིས་ལན་མི་འདེབས་པ་ཅི་ལགས།",
    "མ་བྱས་ཚེ།",
    "དམངས་སེམས་ཤོར་རྗེས་ངེས་པར་དུ་རྩ་མེད་དུ་འགྲོ་བར་བཞེད་དོ།",
    "མེང་ཙིས་འཕགས་པ་ནི་དོན་དག་གང་ཞིག་ཕྲད་རུང་བློ་སེམས་བདེ་འབེལ་ལེ་བ་ལས་ཕྱི་རོལ་གྱི་དངོས་པོ་འགྱུར་ལྡོག་བྱུང་བ་ལས་རང་སེམས་འགྱུར་ལྡོག་མེད་པར་བཞེད་དོ།",
    "རྒྱལ་ཕྲན་རྒྱལ་བོས་མཐོང་ཆེན་བྱས་ཚེ་ཏ་ཧྥུ་ཞེས་པའི་དཔོན་གནས་སྤྲད་ཆོག་གོ།",
    "ཞིང་ས་གཤིན་པོ་དང་འབྲུ་རིགས་གཙང་མ་བློས་བཏང་བ་དང་།",
    "མི་རབས་མང་པོའི་རྗེས་ཀྱི་མི་དེ་ལྟར་ལགས་ན།",
    "སོས་དལ་བྱས་ཏེ་འགྲོའོ།",
    "མེང་ཅིས་མི་ཡིས་རང་ལ་བླང་བྱ་མཐོན་པོ་དགོས་པར་སྐུལ་བའོ།",
    "རྣམས་ཀྱིས་ཤེས་མི་ཐུབ་པར་གྱུར་ན་ལྷ་ཞེས་བརྗོད་དོ།",
    "དུས་མཚུངས་སུ་དེ་ཡི་ཆུ་ཚད་གང་དུ་སླེབས་པ་དབྱེ་ཞིབ་བྱས་སོ།",
    "མེང་ཙིས་རྒྱལ་ཕྲན་ལ་རྒྱལ་ཁབ་དང་མི་དམངས་ལ་མཐོང་ཆེན་དགོས་པར་གདམས་པའོ།",
    "གལ་ཏེ་མི་ཞིག་ལ་འདོད་པ་ཤིན་ཏུ་ཆེ་ན་སེམས་ནང་དུ་ཉར་ཚགས་བྱས་པ་ཡོད་ཀྱང་ཧ་ཅང་ཉུང་ངོ།",
    "བྱ་བ་བསྒྲུབ་ན་གཤོགས་ཆེ་ལ་དྭངས་གཙང་།",
    "ཁུང་ཙིས་འདི་ལྟར་གསུངས་སོ།",
    "ཁ་པར་ཨང་གྲངས།",
    "པར་འདེབས་མཁན།"
  ]
