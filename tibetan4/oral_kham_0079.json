    "དེ་ལས་བྱུང་བའི་རབ་དགེ་དྲི་མེད་སྐལ་ལྡན་ཤིང་རྟའི་རྒྱུན་བཟང་རང་བཞིན་འོོད་ག་སལ་ཟག་པ་མེད་དབྱིངས་བྱང་ཆེན་ཟླ་བའི་མ་མ་རུ།",
    "མ་སྐྱེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད།",
    "དེ་བཞིན་གཤེགས་པ་ལ་འང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་མྱི་དམྱིགས་སོ།",
    "ན་མ་ཨརྻ་ཛྙཱ་ན་ས་ག་ར་བེ་རོ་ཙ་ན་བྷུ་ཧ་ར་ཛཱ་ཡ།",
    "འབྲས་སེར་གཉིས་ཀའི་གདན་ས་སླར་ཡང་རང་འཇགས་ཚགས་ཚུད་ཐུབ་པ་བྱུང་ཡང་།",
    "དགེན་གནས་འདི་ལ་དར་རྒུད་ཅུང་ཟད་འོང་བར་འདུག།",
    "གལ་ཏྲེ་གཏྟོད་ན་དྲེའི་ཚེ་དངྟོས་པྟོ་མྲེད་པའི་རྣམ་པ་དང་རྲེས་སུ་འབྲེལ་པའི་རྣམ་པར་ཤྲེས་པ་དངྟོས་པྟོའི་རང་བཞིན་དུ་མི་འཐད་པས་དྲེ་འདི་དག་ནི་འགའ་ལ་འགལ་བའི་དངྟོས་པྟོ་དང་དངྟོས་པྟོ་མྲེད་པ་དག་དུས་གཅིག་ལ་གཅིག་ཏུ་མྲེད་པའི་ཕྱིར་རྟོ།",
    "དྲེ་ཡང་རང་བཞིན་ནི་དངྟོས་པྟོའི་ངྟོ་བྟོའི་ཕྱིར་དང་།",
    "འདུས་བས་ལ་ཡང་རང་བཞིན་མི་འཐད་དྲེ།",
    "འྟོན་ཀང་གཟུགས་ལ་སྟོགས་པའི་ཕུང་པྟོ་ལྔ་ཆར་ཡང་རང་བཞིན་མྲེད་པར་བསྒྲུབ་པའི་དྟོན་དུའྟོ།",
    "དྲེ་སྤྟོང་བའི་ཐབས་ཀང་རང་བཞིན་ཁས་མ་བླངས་པ་ཡིན་ནྟོ་ཞྲེས་བ་སྲེ།",
    "གང་མི་རག་པ་དྲེ་ཡང་རང་བཞིན་མྲེད་པའྟོ་ཞྲེས་གསུངས་པར་འགྱུར་ཏྲེ།",
    "དྲེ་ནི་མི་རག་པ་དང་རང་བཞིན་ཡྟོད་པ་འགལ་བའི་ཕྱིར་རྟོ།",
    "བདག་ཏུ་འཛིན་པའི་མིང་ཅན་དྲེ་ཡང་རང་བཞིན་མྲེད་པའི་ལས་ཀིས་བསྲེད་པའི་ཕྱིར་རང་བཞིན་མྲེད་པའྟོ་ཞྲེས་གསལ་བར་ཁྟོང་དུ་ཆུད་པར་བའྟོ།",
    "རང་བཞིན་མྲེད་པའི་ལས་ཀིས་བསྲེད་པའི་ཕྱིར་རྟོ་ཞྲེས་ཡིན་དུ་ཆུག་ན་ཡང་གང་ཡང་བདག་ཏུ་འཛིན་པ་དང་འཛིན་པའི་མཚན་཈ིད་ཅན་འདི་ཡང་རང་བཞིན་མྲེད་པའི་ལས་ཀིས་བསྲེད་པའི་ཕྱིར་རང་བཞིན་དང་བཅས་པར་འགྱུར་རྟོ་ཞྲེ་ན།",
    "གང་ཡང་རང་བཞིན་དང་འབལ་བའི་ཕྱིར་ལས་སྟོང་པའྟོ་ཞྲེས་ཁྟོང་དུ་ཆུད་པ་དྲེ་ནི།",
    "དྲེས་ན་དྲེས་སྐུར་པ་བཏབ་ནས་ལྟོག་ལྟ་ཐྟོབ་པ་མ་ཡིན་ལས་ཀང་རང་བཞིན་མྲེད་པར་རྟོག་པས་འདི་དག་བདྲེན་པར་མངྟོན་པར་ཞྲེན་པ་སྤྟོང་ལ།",
    "དྲེ་ལྟ་ན་ཡང་རང་བཞིན་མྲེད་པ་ཡང་རང་བཞིན་མྲེད་པའི་འབས་བུ་རྟོགས་པར་བྲེད་པ་པྟོ་཈ིད་དུ་གསལ་བར་བྲེད་པ་ཤིན་ཏུ་གསལ་བར་དཔྲེར་཈ྲེ་བར་བསན་པས་གསུངས་པ།",
    "དྲེ་ཡང་གང་རང་བཞིན་མྲེད་པ་མཐྟོང་བ་དྲེ་ནི་དྟོན་དམ་པ་མཐྟོང་ལ་ངྟོ་བྟོ་མི་དམིགས་པས་ཀང་དྲེ་ལ་མི་བདྲེན་པ་ལས་སྲེས་པ་ལ།",
    "དྲེ་ཡང་རང་བཞིན་མྲེད་པ་཈ིད་དུ་ཡྟོད་པས།",
    "གང་ཡང་རང་བཞིན་མྲེད་པ་སྲེ་དྲེ་བཞིན་གཤྲེགས་པའི་སྤྲུལ་པ་བཞིན་དུ་རྟོག་པ་མྲེད་པ།",
    "སར་ཡང་ཅིའི་ཕྱིར་ན་འདི་དག་ཀང་རང་བཞིན་མྲེད་པ་དང་རྟོག་པ་ཙམ་དུ་ཡྟོད་པ་ག་཈ིས་ཁས་ལྲེན་པར་བྲེད།",
    "གལ་ཏྲེ་སར་ཡང་རང་བཞིན་ཡྟོད་པ་཈ིད་པས།",
    "གཟུགས་ནི་ཤིན་ཏུ་ཡང་རང་བཞིན་མྲེད་དྟོ།",
    "དྲེ་ཡང་རང་བཞིན་དུ་སྟོ་འདྟོགས་པ་ལ་ཞུགས་པའི་ཕྱིར་དང་།",
    "འདུག་ས་འདི་ཉིད་དུ་བྱན་༴",
    "དེའི་ལམ་རྒྱ་ཡོད་ཟེར་བའི་གཡེར་ཆེན་པོ་འདུག་པ་དང་།",
    "རིན་ཆེནཔོའི་ནུབ་ཕྱོགས་སྤྲིན་ནག་པོའི་འོག་ཏུ་ཞིབ་པོར་ལྟོས་དང་རྒྱགས་ཡོད་ཟེར་བ་ཞིག་འདུག་པ་ལ།",
    "གཡུང་སྟོན་དྲུང་དུ་སླེབ་ཙ་ན།",
    "གཡུང་སྟོན་པ་གཡུང་སྟོན་པ་གསུངས་ནས་བཤུམ་བཞིན་འདུག་པས།",
    "བར་འདི་ན་ཡང་མི་མང་པོ་ཤི་ཞིང་འདུག་གསུངས་སོ།",
    "བོན་པོ་ཡང་ངུ་བཞིན་འདུག་པས།",
    "སྒོམ་བཞིན་ཡོད་ཙ་ན།",
    "ལར་ཡང་དད་པ་ཅན་ཞིག་འདུག་དགོངས་ཏེ།",
    "སྤྱོད་སྤྱོད་པ་ལ་ཡང་ཐབས་ནག་དགུ་རྡུགས་ངཞིག་འདུག་པས།",
    "ང་རང་ཡང་ཡིད་ཆེས་རྒྱུ་ཞིག་མ་བྱུང་བས།",
    "ཆུ་ཁ་ཞིག་ཏུ་ལྷམ་ཕུད་ནས་ཡིད་ལ་མེད་པར་པོ་ཏིའི་སྟེང་དུ་བཞག་ནས་འགྲོ་བཞིན་ཡོད་ཙ་ན།",
    "ལམ་དུ་བུ་ཚ་འགའ་དང་འཕྲད་ཙ་ན།",
    "ཧ་ཧ་སུ་ཡིན་ཟེར་བཞིན་འདུག་ཙ་ན།",
    "དེ་ནུབ་ཙ་ན་ཐོན་ནས་བྱུང་སྟེ།",
    "སྔགས་པ་དེས་ངའི་ཕྱག་རྟེན་རྒྱུའི་གསེར་ཞིག་ཡོང་ཡོད་པ་དེ་དུམ་པ་ཅིག་སྒུག་ན་བྱས་ཙ་ན།",
    "ཁོང་སྐྱེངས་པ་ཞིག་བྱུང་བས་ཚོམ་མེ་ལུས་ཙ་ན།",
    "འགྲོ་དགོས་པར་འདུག་བསམ་པ་བྱུང་བས།",
    "འདིས་ལས་དང་མཐུ་དང་འོ་སྐོལ་ལ་ཕན་འདི་ཙམ་བཏགས་ཙ་ན།",
    "གྲོ་ཕྱེ་གྲོ་མིག་དང་བཅས་པས་བཏང་ཙ་ན།",
    "ཁ་བ་འདོམ་པ་གང་བབ་ནས་འདུག་པས།",
    "འོ་སྐོལ་བློས་མ་ཐོང་བ་མ་ཡིན་ཁོ་རང་བློས་མ་ཐོང་པ་ཡིན།",
    "བག་མ་བྱུང་བར་འདུག་གོ།",
    "ཨེ་དེ་ན་མི་འོང་བར་འདུག།",
    "ང་རང་མར་པ་ལོ་ཙཱ་ལ།",
    "མྱུར་ཏུ་སླེབ་པར་བྱས་ཙ་ན།",
    "འདིས་ཁྱེར་བ་འདུག་དགོངས།",
    "གྲུབ་ཐོབ་ཅིག་འདི་ལ་ཡོང་བར་འདུག་དགོངས་སོ།",
    "སྤྲང་པོའི་སྐྱིད་སྡུག་ཁྱེད་རང་ཤེས།",
    "འདི་ནས་དགའ་ལ་ངེས་པ་མེད་པར་གདའ།",
    "དགོས་པ་མེད་པར་འདུག་བསམ་པའི་སྣང་བ་མཐོ་ཏིང་ངེ་བ་ཞིག་རྒྱུན་དུ་བྱུང་ངོ།",
    "ཕའི་རུས་པ་ལ་བཙའ་ཞེན་ནས་ཁང་པའི་ཕུག་ཏུ་འདུག།",
    "མའི་རུས་པ་ཁང་པའི་སྒོ་ཐེམ་ན་སྐྱ་ཁྲོ་ལེ་འདུག།"
  ]
}