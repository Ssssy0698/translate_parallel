    "ད་དུང་མི་འཆི་སྙམ་པ་འདི་ལ་ཐུག་འདུག་པས་ན།",
    "འཕྲོ་ནས་ཞུས་ཙ་ན་འཕྲོ་ཡེ་མ་ཐོད་པ།",
    "དེ་ཡང་བུ་ལོན་དང་བཅོལ་བ་ལ་གཡོ་བྱས་པ་དང་གཡོ་ཐབས་གཞན་གྱིས་ཀྱང་མ་བྱིན་པར་ལེན་པ་དང་རང་ངམ་གཞན་དོན་ནམ་ཕ་རོལ་ལ་གནོད་པ་སོགས་ཀྱི་ཕྱིར་བྱེད་ནའང་མ་བྱིན་ལེན་ནོ།",
    "ཁྲོས་ཏེ་བྱང་སེམས་ལ་རྒྱབ་ཀྱིས་ཕྱོགས་ཏེ་འདུག་ནས་མ་རུངས་པ་འདི་མི་བལྟའོ།",
    "དེ་བཞིན་དུ་ཐོབ་བྱ་མཆོག་དམན་དང་རང་གཞན་གྱི་དོན་ལ་དམིགས་པ་སོགས་བསམ་པའི་ཁྱད་པར་དང་།",
    "འགྲོ་འདུག་ཉལ་བ་དང་བཟའ་བཏུང་དང་ཉི་མ་དང་གྲིབ་མ་བསྟེན་པ་སོགས་ཀྱང་ཇི་ཙམ་རིང་དུ་བསྟེན་པ་དེ་ཙམ་དུ་བདེ་བ་ཇེ་འཕེལ་དུ་འགྲོ་དགོས་པ་ལ།",
    "ཆགས་སྡང་ལ་སོགས་པ་གང་རུང་རྒྱུད་ལ་སྐྱེས་ཙ་ན་འདི་དེ་ཡིན་ཨང་།",
    "སྔར་དེ་ཙམ་ཞིག་འཁྱམས་པ་ལ་རང་ལོག་མ་བྱུང་ཙ་ན་ད་ཡང་རང་ལོག་མི་འོང་བས་བཟློག་དགོས།",
    "བཟློག་དུས་ཀྱང་དལ་འབྱོར་ཐོབ་པའི་དུས་འདིར་ཡིན་གསུང་ངོ།",
    "མུ་གེ་བྱུང་ཙ་ན་ཐམས་ཅད་ནས་ཀྱི་སྟེང་དུ་འོང་།",
    "ཤིན་ཏུ་རྙེད་སླའི་རྩྭ་ཁམ་འགའ་ལྟ་ཕྱུགས་ཀྱང་རང་ཉིད་ཟ།",
    "རང་གཅེས་འཛིན་དང་གཞན་ཡལ་བར་འདོར་བའི་བློ་གཉིས་གོ་ས་བརྗེས་ཏེ་གཞན་ལ་རང་ལྟར་གཅེས་པར་འཛིན་ཞིང་རང་ལ་གཞན་ལྟར་ཡལ་བར་འདོར་བའི་བློ་སྐྱེད་པའོ།",
    "རང་ཕུན་ཚོགས་ཤིག་བྱེད་པར་འདོད་ཀྱང་རང་དོན་གཙོ་བོར་བཟུང་སྟེ་ཐབས་མ་ཡིན་པ་ལ་ཞུགས་པས།",
    "དེ་ཡང་རང་ངོས་ནས་གདུལ་བྱ་དེ་ལ་སྦྱར་བ་དགོས་ཀྱི།",
    "ཞིག་པོ་དང་རང་གྲོལ་སོགས་ཀྱི་དོན་ཡང་ལེགས་པར་དཔྱད་པར་བྱའོ།",
    "སྡུག་བསྔལ་བྱུང་བ་དེ་སླར་བཅོས་སུ་འདུག་ན་ནི།",
    "དེ་འདུག་མ་ཐག་ཏུ་སེམས་འཇོག་སྟེ་སེམས་རྣམ་པར་འབྱེད་པར་མི་བྱེད་དོ།",
    "ལུས་ནི་ཧ་ཅང་དགྱེ་བ་དང་དགུ་བ་མིན་པར་དྲང་པོར་བསྲངས་ལ་དྲན་པ་ནང་དུ་བཞག་སྟེ་འདུག་པར་བྱའོ།",
    "འདི་ཙམ་ཞིག་ལ་བཞག་ན་བྱིང་བ་སྐྱེ་སླ་བར་འདུག་སྙམ་པའི་ཚད་དེ་ལས་ཀྱང་འཕང་མཐོ་བའི་འཇོག་ཚུལ་ལ་བྱའོ།",
    "ཐུན་གཅིག་གམ་ཇི་སྲིད་ནུས་པ་དེ་སྲིད་དུ་འདུག་པར་བྱའོ།",
    "སེམས་མུན་པ་ལྟར་འདུག་པ་དང་།",
    "གང་ཚེ་ཐ་མལ་འདུག་པ་ཡང་།",
    "ང་རང་བཞིན་མེད་པར་གཏན་ལ་དབབ་པ་དང་།",
    "དེར་མ་ལྷུང་བར་བྱེད་པ་ལ་ནི་སྐྱེ་བ་དྲན་པའི་དུས་སུ་ཡུལ་དང་དུས་དང་རང་བཞིན་བྱེ་བྲག་པས་ཁྱད་པར་དུ་མ་བྱས་པར་སྤྱིར་ང་ཞེས་དྲན་པའི་དྲན་ཚུལ་ཁྱད་པར་བ་ལེགས་པར་ཤེས་དགོས་སོ།",
    "གང་ཟག་ལ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་རྡུལ་ཙམ་མེད་ཀྱང་ལས་གསོག་པ་པོ་དང་འབྲས་བུ་མྱོང་བ་པོ་དང་སྔོན་གྱི་ལས་ཉོན་སོགས་ལ་བརྟེན་ནས་སྐྱེ་བ་ཡང་མི་འགལ་ལོ་སྙམ་དུ་སྦྱང་བར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་ཡོད་པར་དམིགས་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་དོ།",
    "ཀུན་རྫོབ་དེས་གང་ཞིག་བདེན་པར་སྣང་ཞིང་རང་བཞིན་མེད་བཞིན་དུ་རང་བཞིན་དུ་སོ་སོར་སྣང་བ་དེ་ནི་འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་ཀུན་རྫོབ་ཏུ་བདེན་པས་འཇིག་རྟེན་གྱི་ཀུན་རྫོབ་བདེན་པ་སྟེ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "བདག་མེད་པ་དང་རང་བཞིན་མེད་པའི་ངེས་པའི་རྒྱུན་བསྐྱང་བར་བྱའོ།",
    "འོ་སྐོལ་འཛམ་གླིང་པའི་ཚེ་ལ་ངེས་པ་མེད་ཅིང་དེང་སང་ལྔ་བཅུ་ཁ་རལ་གྱི་སྐབས་སུ་འདུག།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "བདག་ནི་མལ་དུ་འདུག་བཞིན་དུ།",
    "ལག་མཐིལ་སྤུ་ཉག་གཅིག་འདུག་པ།",
    "དེའི་མདུན་དུ་ཅུང་ཟད་དམའ་བའི་སྟན་ལ་རང་ཉིད་འདུག་སྟེ་ལག་པ་གཡོན་མཎྜལ་དང་གཡས་སུ་ཚོམ་བུ་ཐོགས་ལ་ཡིག་བརྒྱ་ཚར་གཅིག་འདོན་པ་དང་སྦྲགས་ནས་གོང་བཞིན་མཎྜལ་གྱི་རྡུལ་གཙང་ཞིང་དག་པར་ཕྱི་བ་དང་སྦྲགས་གཟུང་འཛིན་གྱིས་བསྡུས་པའི་རང་གཞན་གྱི་རྒྱུད་ཀྱི་སྡིག་སྒྲིབ་ཐམས་ཅད་སངས་ཀྱིས་དག་པར་བསམ།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་སྟེ།",
    "ཞེས་སོགས་མཐའ་ཡས་པར་གསུངས་པས་རྟེན་ལུས་འཁྲུལ་འཁོར་གྱིས་བཅིངས་ཙ་ན་བརྟེན་པ་སེམས་ལ་རྣམ་རྟོག་མི་འགྱུ་དགུ་འགྱུ་རང་འགགས་སུ་འགྲོ་སྟེ།",
    "དེ་ནས་ཞེ་སྡང་རང་རྒྱུད་པ་འབྱུང་ཞིང་གདོན་རྒྱལ་པོ་སོགས་གནོད་པའི་ཉེན་ཡོད།",
    "དེ་ལ་འདས་པའི་རྗེས་མི་བཅད་ཟེར་ཙ་ན་འོ་སྐོལ་གྱི་བློ་རྣམ་རྟོག་སྔ་མའི་ཕྱིར་མི་འབྲང་བ་ཡིན།",
    "མ་འོངས་པའི་མདུན་མི་བསུ་ཟེར་ཙ་ན་འོ་སྐོལ་གྱི་བློས་རྣམ་རྟོག་ཕྱི་མའི་མདུན་མི་བསུ་བ་ཡིན།",
    "ད་ལྟར་གྱི་ཤེས་པ་རྣལ་མར་ཙེན་གྱིས་ཞོག་ཟེར་ཙ་ན་ད་ལྟར་གང་དུའང་མི་དམིགས་པ་ལ་ཟེར་བ་ཡིན།",
    "ད་ལྟ་རང་ཉིད་རྣམ་རྟོག་ཅི་འདྲ་ཞིག་འགྱུ་ཡིན་འདུག་སྙམ་དུ་ད་ལྟར་གྱི་རྟོག་པ་སྐད་ཅིག་མ་འདི་ཉིད་ལ་ཅེར་གྱིས་བལྟས་པས་རྟོག་པའི་རྒྱུ་འགྲུལ་རྦད་ཀྱི་ཆད་ནས་མ་ཡེངས་བར་དུ་རྟོག་པ་མི་འོང་ནམ་ཡེངས་པ་དང་རྟོག་པ་ཡེར་གྱི་ཡོང་སྟེ།",
    "དེ་ལྟར་བྱུང་ཙ་ན་སེམས་ཟིན་པར་ངོ་ཤེས་པའོ།",
    "སྒོམ་དགོས་པར་འདུག་ཅིས་ཀྱང་མི་ཕན་འཆི་བར་འདུག་སྙམ་པ་འོང་།",
    "བཏང་ན་འགྲོ་ས་མེད་པ་ཞིག་ཏུ་གདའ།",
    "རང་བྱུང་རང་ཞི་ཆུ་ཡི་པ་ཏྲ་འདྲ།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པ་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "དེ་ཡུན་རིང་བ་ལ་ཡོན་ཏན་དུ་མི་ལྟ་ཡུན་ཐུང་བ་ལ་སྐྱོན་དུ་མི་ལྟ་བར་སྐད་ཅིག་ཙམ་དུ་འཁྱེར་ཞིང་བསྒོམས་པས་དུས་ཅི་ཞིག་ཙ་ན་རྟོག་པའི་རང་བཞིན་ཤེས་ཏེ་རྣམ་རྟོག་འོད་གསལ་དུ་ཤར་ནས་རྒྱུན་ཆད་མེད་པར་ཕྲིལ་གྱིས་འཆར་བར་ཐེ་ཚོམ་མེད་དོ།",
    "སེམས་གང་ལྟར་འདུག་པ་དེ་ཀ་ལྟར་བཞག་གོ།",
    "ངོས་བཟུང་མཐའ་དག་དང་བྲལ་བར་འདུག་བྱ་བ་ཡིན།",
    "ཁོ་རང་ཐོག་ཏུ་གློད་ལ་ཞོག།",
    "ཐུན་བསྟུང་མ་དགོས་པར་རིག་པ་སྤུན་སི་ལི་ལིར་འགྲོ་བ་འདྲ་ཞིག་འདུག་ཀྱང་སྒོམ་གྱི་རྒྱུན་དེ་མ་ཆད་པར་བྱུང་ན་གནས་པ་དང་པོ་རི་གཟར་གྱི་ཁ་ནས་ཆུ་འབབ་པ་འདྲ་ཟེར་བ་ཡིན།",
    "དེ་ལ་གལ་མེད་དུ་ལྟ་བ་འདྲ་ཞིག་འདུག་ན་ཡིན།",
    "དེའང་རང་ཐག་རིང་པོ་ཞིག་ཏུ་འདུག་ནས་དེའི་འབབ་ལུགས་ལེགས་པོ་མི་མཐོང་བ་འདྲ་ན་མིན།",
    "རྩར་འདུག་ནས་མཐོང་བ་འདྲ་ན་ཡིན།",
    "གནས་པ་གསུམ་པོ་དེ་གང་སྐྱེས་འདུག་ཙ་ན་ངོ་སྤྲད་པས་རང་ངོ་ཤེས།",
    "དམིགས་པ་སོ་གཅིག་པའོ། སེམས་འཛིན་གྱི་སྐབས་ཐམས་ཅད་དུ་དྲན་པའི་སོ་པ་བཀོད་དེ་བྱིང་རྨུགས་ལ་སོགས་པའི་སྐྱོན་འདུག་གམ་མི་འདུག་ལྟ་ཞིང་མི་འདུག་ན་དེ་ཀར་འཇོག་པ་དང་།",
    "བྱིང་ན་འདུག་ས་བསེང་བར་བྱ།",
    "རང་རང་གཞུང་དང་གྲུབ་པའི་མཐའ་ཡིས་ནི།",
    "ཁོ་རང་མ་ཡེངས་པར་ཡོད་སྙམ།",
    "དེ་ལ་རབ་རྟོག་པ་དེ་ཚོར་མ་ཐག་ང་ཡེངས་འདུག་སྙམ་པའི་སེམས་དེ་ཀ་ལ་ལྟོས།",
    "དངོས་པོར་འདུག་གམ་དངོས་མེད་དུ་འདུག།",
    "དམིགས་པ་སོ་གསུམ་པའོ། དེ་ལ་གནས་པའི་ངང་ནས་སེམས་ཀྱི་ངོ་བོ་དེ་ཅི་ལྟ་བུ་ཞིག་འདུག་དྲིས་ལ།",
    "འོ་ན་ཤེས་པ་དེ་ལུང་མ་བསྟན་གྱི་ཤེས་པ་ཚོམ་མུན་ནེ་བ་ཞིག་འདུག་གམ།",
    "གསལ་ཧྲིག་གེ་བ་ལ་རྗེན་ནེ་བ་ཞིག་འདུག་དྲིས་པས།",
    "རྟིང་མ་ལྟར་འདུག་ཟེར་ན་སེམས་ངོ་མཐོང་བ་ཡིན།",
    "སྔ་མ་ལྟར་འདུག་ཟེར་ན་སླར་སྐྱོང་འཇུག།",
    "སྦྲང་མ་གར་སྤྱིན་ལ་འབྱར་བ་ལྟ་བུ་རིག་པ་མི་གསལ་བའི་ངང་དུ་གནས་པ་ཞིག་འདུག་ལ།",
    "ད་ལན་སེམས་གནས་པ་དེ་གསལ་དྭངས་སིང་ངེ་བ་ངོས་བཟུང་དང་བྲལ་བ་ཞིག་འདུག་ཟེར་ན།",
    "དེ་སྔར་དང་ཁྱད་མི་འདུག་ཟེར་ན།",
    "དེ་ལྟར་བཙལ་བའི་ཚེ་མ་རྙེད་ན་ཚོལ་མཁན་དེ་ཀའང་ཇི་ལྟར་འདུག།",
    "སྔར་རང་ལུགས་སུ་གློད་པའི་སེམས་དེ་དང་ད་བརྟག་དཔྱད་བྱས་པའི་སེམས་དེ་ལ་ཁྱད་པར་ཇི་ཙམ་འདུག།",
    "སེམས་དེའི་བྱུང་གནས་འགྲོ་གསུམ་ཇི་ལྟར་འདུག་ལེགས་པར་བརྟག་ནས་བཙལ་བར་བྱའོ།",
    "དཔེ་བཟའ་མི་གཉིས་ལ་བུ་གཅིག་ཡོད་པ་དེ་མའི་རྩར་ཡོད་ན་ཕའི་རྩར་མི་ཡོང་ཕའི་རྩར་ཡོད་ན་མའི་རྩར་མི་ཡོང་འཕྲིན་ཕར་སྐྱེལ་ཚུར་སྐྱེལ་བྱེད་པ་བཞིན་སེམས་དེའང་གནས་ཙ་ན་མི་འགྱུ་འགྱུ་ཙ་ན་མི་གནས།",
    "དམིགས་པ་སོ་བདུན་པའོ། འདིའི་སྐབས་སུ་སེམས་དེ་ཅི་འདྲ་ཞིག་འདུག་ཅེས་འདྲི།",
    "ལྷག་མཐོང་མ་ཤར་བས་ད་དུང་ཞག་འགའ་བསྲིང་ཞིང་བལྟར་འཇུག་། ཡང་ཅི་ཡང་ངོས་བཟུང་མེད་པའི་སྟོང་པ་ཅང་མེད་དུ་འདུག་ཟེར་ན།",
    "ཕྱོགས་གཅིག་ཙམ་མཐོང་ཡང་མཐའ་དག་མ་མཐོང་བས་ད་དུང་མ་ཡེངས་པའི་སྒོ་ནས་ཐག་ཆོད་ལ་སྟོང་རྐྱང་ཞིག་འདུག་གམ་སྟོང་ལུགས་ཅི་འདྲ་ཞིག་འདུག་བལྟར་འཇུག།",
    "འདི་ཡིན་སྨྲ་ཡང་མི་ཤེས་པ་ལ་ཐག་ཆོད་པ་ཞིག་འདུག་ཟེར་བ་དང་།",
    "འདི་འདྲ་ཞིག་འདུག་སྙམ་རྒྱུའང་མེད་པ་ལ་སྐྱེ་འགག་མེད་པར་ཤེས་རྒྱུ་ཞིག་ཀྱང་འདུག་ཟེར་ན།",
    "རྟོག་པ་དེ་ལ་བལྟས་པས་རྗེས་མེད་དུ་ཤིག་ཤིག་འགྲོ་ཡིན་འདུག་ཟེར་ན་ཅུང་ཟད་ཤར་བ་ཡིན། རྟོག་པ་ཤར་ཚད་ངོས་གཟུང་མེད་པར་འཆར་གྱིན་འདུག་ཟེར་ན།",
    "དེ་དུས་ངོས་གཟུང་མི་འདུག་སྙམ་པ་ཡོང་མི་ཡོང་དྲི།",
    "འདི་སྙམ་པ་མེད་བཞིན་དུ་གལ་མེད་འཛིན་མེད་དུ་ངོས་བཟུང་མེད་པར་ཤར་གྲོལ་དུས་མཉམ་དུ་འགྲོ་ཡིན་འདུག་ཟེར་ན།",
    "དེར་ལམ་མེར་འདུག་སྙམ་རྒྱུའི་ཀད་དེ་བ་ཞིག་འདུག་གམ་མི་འདུག་དྲི།",
    "འདུག་ཟེར་ན་དེ་སྐད་སྙམ་པ་དེ་བལྟར་གཞུག།",
    "དེ་ལ་བལྟས་པས་ངོས་གཟུང་ཅི་ཡང་མེད་པ་ཞིག་འདུག་ཟེར་ན་ངོ་འཕྲོད་པ་ཡིན།",
    "དེ་ལ་རྩེ་གཅིག་ཏུ་མི་ཡོང་བ་འདུག་ཟེར་ན་གོ་ཡུལ་ཡིན་པས་གོ་ཡུལ་མ་ཡིན་པའི་ཉམས་མྱོང་རྒྱུད་ཐོག་ཏུ་འཕྲོད་པ་ཞིག་དགོས་པས་གཞན་གྱི་གཞིག་འགྲེལ་མང་པོ་མ་བྱེད་པར་ངས་བསྟན་པ་བཞིན་སྒོམས་ལ་ཤོག་བྱས་ཏེ་ཉམས་རྟོགས་གོང་བཞིན་མ་སྐྱེས་ཀྱི་བར་སྒོམ་དུ་གཞུག་ཅིང་སྐྱེས་ནས་ངོ་སྤྲོད་པར་བྱའོ།",
    "སླར་ཡང་འགྱུ་མཁན་གྱི་སེམས་དེ་དང་གནས་པའི་སེམས་དེ་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "འགྱུ་སེམས་དེ་དང་དེ་ལ་ལྟ་བའི་སེམས་དེ་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "དགའ་བར་འགྱུས་པའི་སེམས་དེ་དང་མི་དགའ་བར་འགྱུས་པའི་སེམས་དང་ཐོག་མའི་གནས་པའི་སེམས་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "ཡང་སེམས་སྤྲོ་གང་ཐུབ་ཅིག་དུས་གཅིག་ལ་ཕྱོགས་བཞི་མཚམས་བརྒྱད་དུ་སྤྲོས་ནས་དེ་དང་སྔར་གྱི་གནས་པའི་སེམས་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "དམིགས་པ་སོ་དགུ་པའོ། ཡང་རྣམ་པར་རྟོག་པ་གང་ཤར་བ་དེ་ཀའི་ངོ་བོ་ལ་ཅེར་གྱིས་བལྟས་པས་རྣམ་རྟོག་དེ་ཀ་ངོས་གཟུང་མེད་པར་གསལ་སྟོང་དུ་ཤར་ཙ་ན་རྟོག་པ་ངན་པ་ཞིག་ལོགས་སུ་སྤང་མི་དགོས་གཉེན་པོ་ཞིག་ལོགས་ནས་བཙལ་མི་དགོས་ཏེ།",
    "དེ་ལ་མ་ཡེངས་པར་བཞག་པས་དུག་ལྔ་གཞི་མེད་རྩ་བྲལ་དུ་ཤར་ཙ་ན་འདོད་ཆགས་སོགས་མ་སྤངས་པར་དག་པས་རང་གྲོལ་ཞེས་ཀྱང་བྱ་ལ་དེ་ཀ་ལ་སོར་རྟོག་ཡེ་ཤེས་སོགས་ཡེ་ཤེས་ལྔ་དང་འོད་དཔག་མེད་སོགས་རྒྱལ་བ་རིགས་ལྔ་ཟེར་བ་ཡིན་ནོ།",
    "གཉེན་པོས་བཅོས་སུ་མེད་པར་གདའ།",
    "རིག་པ་གསལ་བའི་ངང་དུ་གདའ།",
    "དེའང་སེམས་འདི་འགྲོའམ་སྡོད་དམ་ལས་བྱེད་དམ་ཅི་འདྲ་འདུག་ལྟོས་ལ་འདུག་ཚུལ་ཁྱེར་ཤོག་བྱས་ཞག་འགའ་བརྟག་འཇུག།",
    "དེ་ནས་དྲིས་པས་སེམས་དེ་གང་ཡང་མི་བྱེད་པར་སྡོད་འདུག་ཟེར་ན།",
    "དེ་ལྟར་མི་འདུག་ཟེར་ན།",
    "རྣམ་རྟོག་མི་འཕྲོ་དགུ་འཕྲོ་མི་བྱེད་དགུ་བྱེད་བྱེད་ཀྱིན་གདའ་ཟེར་ན།",
    "མུ་སྟེགས་པ་དང་འཇིག་རྟེན་གྱི་གཏམ་རྒྱུད་རྫུན་མ་ཐོས་འདུག་པ་དེ་ལ་ཏིག་ཏིག་མེད་ད་དུང་བརྟག་གཞིག་ཐོང་བྱ། ཡང་དྲིས་པས་བྱེད་མཁན་ཐམས་ཅད་སེམས་སུ་འདུག།",
    "སེམས་བསྡད་ཙ་ན་གང་ཡང་མི་འདུག་སེམས་འཕྲོ་ཙ་ན་ཐམས་ཅད་བྱེད་འདུག་ཟེར་ན།",
    "སེམས་བྱེད་པ་པོ་དེ་དང་དེའི་བྱ་བ་བྱས་པ་གཉིས་གཅིག་ཏུ་འདུག་གམ་ཐ་དད་དུ་འདུག་བྱས་པས།",
    "ཐ་དད་དུ་འདུག་ཟེར་ན།",
    "ཀ་བ་སྙམ་པའི་དུས་སུ་ཀ་བ་སྙམ་པ་དེ་ནི་སེམས་ཡིན་ལ་དེ་དང་དུས་མཉམ་དུ་དེ་མ་གཏོགས་པའི་ཀ་བ་ཞིག་ལོགས་སུ་འདུག་གམ་དྲིས་པས།",
    "ལྟ་མཁན་སེམས་དེ་ནང་ན་ཡོད་པ་དེར་འདུག་ཟེར་ན་སེམས་དེ་ཕྱི་ནང་བར་གསུམ་གང་ན་འདུག་གང་ཕན་གཟུགས་ཡིན་གང་ཚུན་སེམས་ཡིན།",
    "ད་དུང་དམིགས་རྟེན་ལ་སེམས་མ་ཟིན་པར་འདུག་པས་སེམས་ལ་གཟུགས་དེ་སྣང་ལུགས་དང་ཁ་དོག་དབྱིབས་ཇི་ལྟར་འདུག་ལྟར་འཇུག།",
    "གལ་ཏེ་སྣང་བ་སེམས་སུ་འདུག་ཟེར་ན།",
    "ཡང་སེམས་ནང་དུ་བཀུག་སྟེ་ལུས་སེམས་ཐ་དད་དུ་འདུག་གམ་གཅིག་ཏུ་འདུག་དྲི།",
    "ཐ་དད་ཟེར་ན་ལུས་སེམས་ཁང་པ་དང་མི་བཞིན་དུ་འདུག་གམ་ལུས་དང་གོས་བཞིན་དུ་འདུག།",
    "དེར་མ་ཟད་སྣང་བ་སེམས་སུ་འདུག་ཟེར་བྱུང་བ་ཐག་རིང་པོའི་སྣང་བ་རྣམས་སེམས་སུ་འདུག་ན་ཉེ་བ་ལུས་སེམས་སུ་མེད་པ་གར་སྲིད་པས་ལུས་སྣང་གཉིས་སེམས་ཡིན་ན་ཡིན་མཉམ་དང་མིན་ན་མིན་མཉམ་ལས་འོས་མེད་པའི་ཕྱིར་ད་དུང་ལེགས་པར་བརྟག་གཞིག་གྱིས་ཤིག་ཅེས་བསྒོ།",
    "ཤི་བའི་སྐབས་ཀྱི་ཕུང་པོ་དེའང་དེ་མཐོང་མཁན་གྱི་གང་ཟག་རྣམས་ཀྱི་སེམས་སྣང་ཡིན་གྱི་དེ་ལས་ལོགས་སུ་གྲུབ་པ་མི་འདུག་ཟེར་ན།",
    "ད་ངོ་འཕྲོད་འདུག་པས་གཟུང་འཛིན་ཐམས་ཅད་རང་སེམས་སུ་ཐག་བཅད་ཅིང་དགེ་མི་དགེ་ལུང་མ་བསྟན་སོགས་ཀྱི་འཁྲུལ་རྟོག་ཐམས་ཅད་ངོ་ཤེས་པར་བྱས་ཏེ་གཞི་མེད་རྩ་བྲལ་དུ་འཇོག་པར་བྱོས་ཤིག།",
    "འཛིན་མེད་ལ་གནས་ཀྱིན་འདུག་ན་དེ་ཀ་ཕྱག་རྒྱ་ཆེན་པོ་ཡིན།",
    "དེ་ཅི་སྟེ་ན་རྐྱེན་སྣང་ཁོ་རང་རང་སེམས་ཡིན་པའི་ཕྱིར་རོ།",
    "སེམས་ཉིད་དེའང་རང་བཞིན་གྱིས་འོད་གསལ་བ་ཞེས་ཐ་སྙད་ཇི་ལྟར་བཏགས་ཀྱང་གཟུགས་ཁ་དོག་དབྱིབས་ལུས་ཀྱི་ཕྱི་ནང་རྣམ་པ་སོགས་འདི་འདྲར་གྲུབ་ཅེས་སྨྲ་བསམ་གྱི་ཡུལ་ལས་འདས་པ་སྟེ་དཔེར་ན་ནམ་མཁའ་ལྟ་བུའོ།",
    "སྡུག་བསྔལ་མ་མཆིས་སྐྱིད་པར་གདའ།",
    "སེམས་ཁོ་རང་དེའི་ངོ་བོར་ཤར་ན་རྟོགས་པ།",
    "སྒོམ་བདེ་གསལ་མི་རྟོག་སྟོང་པ་རྣམས་ལ་སྒོམ་རྒྱུའམ་མྱོང་རྒྱུ་ཞིག་འདུག་ན་ཉམས།",
    "སྒོམ་མཁན་དང་སྒོམ་གཉིས་སུ་མེད་པ་ཡིད་བཟོ་དང་གོ་བ་ཙམ་མིན་པར་མངོན་སུམ་དུ་ཤེས་ན་རྟོགས་པ་ཡིན་པར་འདུག།",
    "ནན་ལྟར་བསྒོམ་བྱ་སྒོམ་བྱེད་མི་འདུག་སྙམ་པ་ཉམས།",
    "འཛིན་པ་དེའང་ཡུལ་ལ་བརྟེན་ནས་སྐྱེ་བ་ལས་འདིར་གཟུང་ཡུལ་ཐམས་ཅད་གཉུག་མ་རང་གསལ་དུ་ཤར་བས་དེ་མེད་ཙ་ན་འཛིན་བྱེད་ཀྱི་ཤེས་པ་དང་བྲལ།",
    "སྤྲོས་བྲལ་མཐོང་ལམ་ཡིན་ན་ཡོན་ཏན་བརྒྱ་ཕྲག་བཅུ་གཉིས་སོགས་མི་འདུག་པས་འགལ་བ་ལ་སོགས་པ་དེ་རྣམས་ལ་ངེས་པ་ཆེན་པོ་མི་འོང་སྟེ་མཚན་ཉིད་ནས་ཀྱང་མཐོང་ལམ་གྱི་ཡོན་ཏན་བརྒྱ་ཕྲག་བཅུ་གཉིས་པོ་གདུལ་བྱ་དག་མ་དག་ཐམས་ཅད་ལ་སྟོན་ནུས་པ་མ་ཡིན་ལ།",
    "འོ་ན་ཇི་ལྟར་ཡིན་གྱིས་དང་ད་ལྟར་གྱི་ཐ་མལ་གྱི་ཤེས་པ་དངོས་འཛིན་དང་སྟོང་འཛིན་ཡེ་བྲལ་དུ་འདུག་པ་འདི་ལ་ཕྱག་རྒྱ་ཆེན་པོར་མཛུག་གུ་འཛུགས་པ་ཡིན་ཏེ།",
    "གཉེན་པོས་བཅོས་གཅིག་ཀྱང་མ་བྱས་པར་རང་སར་ངོ་ཤེས་ཤིང་རང་གྲོལ་བ་ལ་ཕྱག་རྒྱ་ཆེན་པོ་ཟེར་བ་ལགས་སོ།",
    "ཡང་རང་བྱུང་བས་གསུངས་པ་ལྟར་ན།",
    "ཡང་རང་བཞིན་གྱི་གནས་ལུགས་ལ་དགོངས་ནས་གནས་ལུགས་ཕྱག་ཆེན།",
    "དེ་རང་ཡང་ཐ་དད་འདུག་པ་ལྟ་བུ་མ་ཡིན་ཏེ།",
