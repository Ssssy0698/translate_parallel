    "སྤོང་ཞིང་འཇིག་ན་ཧ་ཅང་ཐལ་བ་སྟེ།",
    "ཀྱང་གི་སྒྲས་ནི་ཁམས་ལས་ཞེས་བྱ་བ་ལ་སོགས་པའི་དོན་ནི།",
    "ད་རེས་འདོད་པའི་ཁམས་ཀྱི་ཆུད་མི་ཟ་བ་འཇིག་པ་ཙམ་ལ་དགོངས་ནས་སྤོང་ཞེས་བརྗོད་དོ།",
    "རྟག་པར་ཐལ་བ་དང་།",
    "འབྲས་བུ་ཡང་ཡང་སྐྱེ་བར་ཐལ་བའོ།",
    "དང་པོ་ནི་ལས་རང་བཞིན་མེད་ཅེས་བྱ་བ་དེ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པས་རྟག་པར་ཐལ་བ་དང་།",
    "རྟག་ན་མ་བྱས་པར་ཐལ་བ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་མ་ཡིན་པར་ཐལ་བ་དང་།",
    "རྣམ་པར་དབྱེ་བ་མི་འཐད་པར་ཐལ་བའོ།",
    "དེའི་དོན་གོ་བར་ཟད་དོ་ ཡང་ཡང་སྨིན་པར་ཐལ་བ་ནི་གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "འདིར་སྨྲས་པ་ལས་དང་ཉོན་མོངས་པ་ཞེས་པ་ནས་ཡིན་ནོ་ལ་ཐུག་པ་དང་།",
    "རྟོག་པ་ལས་བདག་དང་བདག་གིར་འཛིན་པ་འཇིག་ཚོགས་ལ་ལྟ་བ་འབྱུང་ཞིང་།",
    "དེ་ལས་ལས་དང་ཉོན་མོངས་པ་རྣམས་འབྱུང་ལ།",
    "ཕུང་པོ་བདག་ཡིན་ན་ནི་ཕུང་པོ་གྲངས་མང་བ་བཞིན་དུ་བདག་ཀྱང་མང་པོར་ཐལ་བ་དང་།",
    "ཕུང་པོ་རྫས་ཡིན་པ་བཞིན་དུ་བདག་ཀྱང་རྫས་སུ་ཐལ་བ་དང་།",
    "བདག་ལ་འཇུག་པས་ཕྱིན་ཅི་ལོག་མ་ཡིན་པར་ཐལ་བ་དང་།",
    "མྱ་ངན་ལས་འདས་པ་ན་ཕུང་པོ་རྒྱུན་ཆད་པ་ན་ཆད་པར་ཐལ་བ་དང་།",
    "མྱ་ངན་ལས་འདས་པ་ན་ཆད་པ་ཡིན་ན་མྱ་ངན་ལས་འདས་པའི་སྔ་རོལ་ན་སྐད་ཅིག་གི་རང་བཞིན་དུ་འདོད་པར་བྱ་དགོས་ལ།",
    "དེ་ལྟ་ན་སྐྱེ་ཞིང་འཇིག་པར་ཐལ་བར་འགྱུར་རོ།",
    "འདོད་པ་ལ་ཐལ་བ་དགག་པ་གསུམ་སྟེ།",
    "བདག་མེད་ན་བདག་གི་ཉེ་བར་ལེན་པ་ཡང་མེད་དོ།",
    "ཞེས་བསྟན་པའི་ཕྱིར་གང་གི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྤྲོས་སོ།",
    "བདག་དང་བདག་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "བདག་དང་བདག་གི་བ་མེད་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་མ་གྲུབ་སྟེ།",
    "བདག་དང་བདག་གི་བ་ཡོད་དོ་ཞེས་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་རྒོལ་བ་ལ།",
    "དེ་ལྟར་ཡུལ་བདག་དང་བདག་གི་བ་མེད་པས།",
    "དེའི་ཡུལ་ཅན་འཇིག་ཚོགས་ལ་ལྟ་བ་མེད་པའི་ཕྱིར་དེ་ལས་བྱུང་བའི་ལས་དང་ཉོན་མོངས་པ་མེད་ལ།",
    "སྐྱེ་བ་ལ་སོགས་པ་སྡུག་བསྔལ་གྱི་ལས་དང་ཉོན་མོངས་པ་ནི་རྣམ་པར་རྟོག་པ་འཇིག་ཚོགས་ལ་ལྟ་བ་ལས་བྱུང་ལ།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་ནི་སྤྲོས་པ་ཡུལ་བདག་དང་བདག་གི་བ་ལས་བྱུང་ཞིང་།",
    "འདི་ཡང་སྐབས་སུ་བསྟན་པ་ཡིན་མོད་ཀྱི།",
    "དེ་ཁོ་ན་ཉིད་ལ་འཇུག་པའི་རིམ་པའི་མན་ངག་གི་དོན་ཡོངས་སུ་རྫོགས་པར་མི་འགྱུར་བས་འོག་ཏུ་བསྟན་ཏོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་རྒོལ་བ་སྔོན་ཏུ་བཏང་བས་སྟོན་པ་ཡང་བདག་དང་བདག་གི་མེད་པའི་དྲང་བའི་དོན་ཡིན་པས་མི་གནོད་པ་དང་།",
    "ཕན་ཡོན་དང་གསུམ་མོ།",
    "ཁྱོད་དོན་དམ་པ་མེད་པ་ལྟར་ཁོ་བོ་ཅག་ཀྱང་མེད་པར་འདོད་པས་མེད་པའི་དངོས་པོ་མཚུངས་སོ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་འདས་པ་ལ་ལྟོས་མོད་ཡོད་པ་མ་ཡིན་པ་ལ་འགལ་བ་ཅི་ཡོད་ཅེ་ན།",
    "མེད་པའི་ཕྱིར་མི་ལྟོས་པར་ཐལ་ཏེ་ནམ་མཁའི་མེ་ཏོག་ལ་སོགས་པ་ནམ་མཁའ་ལ་མི་ལྟོས་པ་བཞིན་ནོ།",
    "ཚོགས་པ་ཕྱི་མ་ལས་མ་སྐྱེས་པ་ནི་འདིར་ཞེས་བྱ་བ་ལ་སོགས་པས་བྱེ་བྲག་ཏུ་སྨྲ་བ་ན་རེ།",
    "གང་གི་ཚེ་ཞེས་པ་དང་།",
    "ཞེས་མ་ངེས་པར་བརྗོད་པ་ནི་མ་ཡིན་ཏེ་མ་ངེས་ཀྱང་ཁོ་བོ་ཅག་ལ་མི་གནོད་དོ་ཞེས་སྟོན་པ་ནི་མ་ངེས་པར་འགྱུར་མོད་ཅེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དང་པོ་ལྟར་ན་རང་གི་ངོ་བོ་མ་གྲུབ་པའམ།",
    "དཔེར་ན་མོ་གཤམ་གྱི་བུ་སྐྱེད་པའི་སྦྱོར་བ་པོ་མ་ཡིན་པ་བཞིན་ནོ་ཞེས་བྱ་བའོ།",
    "སྦྱོར་བ་པོ་ཡིན་པས་བཀག་པས་འབྲས་བུ་བཀག་པས་འབྲས་བུ་བཀག་མོད་ཀྱི།",
    "ལན་ལ་དོན་དྲུག་གིས་སྟོན་པ་ལས།",
    "དང་པོ་ནི་གང་གི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པས་བརྗོད་དོ།",
    "འདི་དག་གི་དཔྱད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "བདེན་མོད་ཀྱི་འོན་ཀྱང་ཀུན་རྫོབ་ཏུ་འཇིག་པ་ཁས་བླངས་ཤིང་སྐྱེ་བ་ཁས་བླངས་པ་ལ།",
    "ཤེས་པ་ལ་ཤེས་པ་གཞན་མེད་པས་ཡུལ་མི་འཛིན་པར་ཐལ་བར་འགྱུར་རོ་ཞེས་བྱ་བ་སྟེ།",
    "བདག་ནི་མེད་མོད་ཉོན་མོངས་པ་མེད་པར་ཅི་ལྟར་འགྱུར་ཞེས།",
    "འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་སེམས་ལ་ཅི་ལྟར་མེད་པ་དང་།",
    "སེམས་ཅི་ལྟར་ཉོན་མོངས་པ་ལ་ཅི་ལྟར་མེད་པ་གཞན་ལས་གསལ་ལོ།",
    "རྟེན་ཕྱིན་ཅི་ལོག་ཡིན་པ་ནི་གང་གི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རང་བཞིན་མེད་པ་ཡང་ཕྱིན་ཅི་ལོག་གི་ཡུལ་མེད་པ་དང་།",
    "འདིའི་དོན་ནི་རྟག་གོ་སྙམ་པའི་ཤེས་པ་ཤེས་བྱ་རྟག་པ་དང་མ་འབྲེལ་བས་ཕྱིན་ཅི་ལོག་གི་ཤེས་རབ་བཞག་པ་ནི།",
    "མི་རྟག་པ་ལ་སོགས་པའི་ཁྱད་པར་བཀག་མོད་ཀྱི།",
    "ཞེ་སྡང་ཡང་ཡོད་དོ་ཞེས་རྒོལ་བའི་ལན་ཡང་ཉོན་མོངས་པ་ཡོད་པ་མི་སྤོང་བ་དང་།",
    "ཕྱིན་ཅི་ལོག་བརྟག་པ་རྫོགས་སོ། ཧ་ཅང་ཐལ་བ་སྤང་བ་ལ་གཉིས།",
    "དེ་ལྟར་ན་ནི་ཡོངས་སུ་ཤེས་པ་ལ་སོགས་པ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "སོ་སོའི་སྐྱེ་བོ་འཆིང་བ་མཐའ་དག་དང་མ་བྲལ་བ་མཐར་གྱིས་སློབ་པའི་གང་ཟག་འགའ་ཞིག་གིས་འདོད་པའི་ཁམས་ཀྱི་ཕྲ་རྒྱས་སྤོང་བ་བར་ཆད་མེད་པའི་ལམ་གྱིས་བསྡུས་པ་དང་།",
    "བྲལ་བའི་རྫས་རྣམས་བསྡོམས་པ་ལ་རྗེས་སུ་ཤེས་པ་སྐད་ཅིག་མ་བཅུ་དྲུག་གི་བདག་ཉིད་རྣམ་པར་གྲོལ་བའི་ལམ་གྱིས་བསྡུས་པ་ནི་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ལ་གནས་པ་སྟེ།",
    "གཉེན་པོ་བར་ཆད་མེད་པ་དང་རྣམ་པར་གྲོལ་བའི་ལམ་གྱི་སྐད་ཅིག་ཀྱང་དེ་བཞིན་དུ་ཡོད་མོད་ཀྱི།",
