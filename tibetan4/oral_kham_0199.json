    "དེ་ཡང་རང་ས་ལ་དམིགས་པ་ཅན་གྱི་གོང་སར་དམིགས་ན་མི་ཚང་ངོ།",
    "དེ་ཡང་རང་འབྲས་ལས་གཉིས་པ་ཞེས་གོ་དགོས་སོ།",
    "མེ་བདུན་ནི་ཉི་མ་བདུན་གྱིས་རིམ་པས་བསྲེགས་པ་དང་དེ་ཡང་རང་སའི་མེས་ཡིན་གྱི་འདོད་མེས་མི་ནུས་སོ།",
    "མ་རྨོས་པའི་འབྲས་དེ་ནམ་འདོད་དུ་ལེན་ཙ་ན།",
    "ཕྱི་རོལ་པ་ཁ་ཅིག་མི་སྨྲ་བར་འདུག་པ་ལ་ཐུབ་པར་བལྟ་བ་དང་།",
    "བརྣབས་སེམས་ཁོ་རང་ཀུན་སློང་ཡིན་པས་རྩ་བ་གསུམ་ལས་ཇི་ལྟར་སྐྱེ་སྙམ་ན།",
    "དེ་དག་ཀྱང་རང་རྒྱུད་ལ་སྨིན་པ་རྣམ་སྨིན།",
    "དད་པ་དང་གུས་པ་དང་རང་ལ་གནས་དང་།",
    "དམིགས་ཡུལ་ཟག་བཅས་ཟག་མེད་དང་རང་ས་དང་གོང་ས་ལ་ལྟོས་ནས་དམིགས་མཚུངས་ཀྱིས་རྒྱས་པ་གཉིས་ཀ་ཅི་རིགས་དང་།",
    "དེ་གཉིས་ལ་ཚུལ་བརྟུལ་ཡོད་པ་འགལ་ཞེས་སློབ་དཔོན་གསུངས་ཀྱང་རང་བཞེད་རྣལ་འབྱོར་སྤྱོད་པར་གསལ་ལོ།",
    "དངོས་པོ་གཅིག་དུས་རྣམས་སུ་འཕོ་འཇུག་བྱེད་པ་ན།",
    "དངོས་པོ་གཅིག་དུས་རྣམས་སུ་འཇུག་པ་ན།",
    "དངོས་གཅིག་དུས་རྣམས་སུ་འཇུག་པ་ན།",
    "དེ་ཡང་རང་རྒྱུད་ཀྱི་བདེ་སྡུག་ལ་ནི་དམིགས་མཚུངས་གཉིས་ཀས་དང་གཞན་རྒྱུད་ལ་ནི་དམིགས་པའི་སྒོ་ནས་རྒྱས་སོ།",
    "སྤོང་ཚུལ་གསུམ་པོ་དེ་དག་ཀྱང་རང་རྒྱུད་ཀྱི་མཐོང་སྤང་སྤོང་ཚུལ་ཡིན་གྱི་གཞན་རྒྱུད་ཀྱི་མཐོང་སྤང་ཐམས་ཅད་ནི།",
    "ལག་མཐིལ་སྤུ་ཉག་གཅིག་འདུག་པ།",
    "དེ་ལ་བགྲང་བ་ནི་འདུ་བྱ་བ་མེད་པར་ལུས་སེམས་རྣལ་དུ་འདུག་སྟེ་དབུགས་འབྱུང་རྔུབ་ལ་སེམས་གཏད་ནས་གཅིག་ནས་བཅུའི་བར་དུ་ཡིད་ཀྱིས་བགྲང་བའོ།",
    "སྟོན་པ་དང་རང་རྒྱལ་བསེ་རུ་ལྟ་བུ་ནི་དྲོད་ནས་སམ་མི་སྡུག་པ་ནས་བཟུང་སྟེ།",
    "དང་པོ་ལའང་འོག་མིན་འགྲོ་དང་སྲིད་རྩེར་འགྲོ་གཉིས།",
    "དེས་ན་རྒྱུ་བདུན་གྱིས་ཤེས་བཅུར་བཞག་པ་ཡིན་ནོ་ཟེར་ཡང་རང་བཞིན་གཉེན་པོ་ཡུལ་ཤེས་པའི་རྣམ་པ་ལས་སོ།",
    "དང་པོ་ལྟར་ན་ཤེས་རབ་ཉིད་རྣམ་པ་དང་བཅས་པར་མི་འགྱུར་ཏེ་རང་དང་རང་མཚུངས་པར་མི་ལྡན་པས་སོ།",
    "དེ་ཡང་རང་གཞན་གྱི་འདས་འོངས་ཀྱི་སྐྱེ་བ་མཁྱེན་པ་སྟེ།",
    "དེ་འང་རང་མཚན་ལ་དམིགས་ཀྱི།",
    "མངོན་ཤེས་ལྔ་པོ་དེ་ཡང་རང་ས་དང་འོག་སའི་སྤྱོད་ཡུལ་ཅན་ཡིན་གྱི།",
    "ཡང་འདམ་བུའི་ཤོག་གཉིས་གནམ་དུ་བསྒྲེང་སྟེ་ཕན་ཚུན་བརྟེན་ནས་འདུག་པ་དེ།",
    "གསལ་ཞིང་རང་བཞིན་དྲི་མེད་པའོ།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "བསྐལ་མཆོག་དུས་རིང་འགྲོ་བའི་སྒྲིབ་ཀུན་ཟད།",
    "ཇི་ལྟར་ཁྱི་ནི་རྟག་ཏུ་ལྟོགས་ཤིང་སྡུག་བསྔལ་གྱིས་ཉེན་ཆོག་མི་ཤེས་། ཇི་ལྟར་རུས་སྦལ་དེ་ནི་ཆུ་ཡི་ནང་ན་ཀུན་ནས་བསྐུམས་ཤིང་འདུག།",
    "དེ་བཞིན་གཡེམ་དང་གནས་དང་རང་གཞན་ཕན་བྱ་དོན་བྱེད་པའི།",
    "འཇིག་རྟེན་བདེ་དང་རང་སྲོག་ལ།",
    "སྐམ་དང་འཕེལ་དང་རང་བཞིན་གྱིས།",
    "བདག་ཉིད་འདུག་པ་གང་ཡིན་པ།",
    "མགོན་མེད་འདུག་གནས་སུ་ནི་འདུག་གྱུར་ལ།",
    "མི་རྟོག་པ་དང་རང་བཞིན་གྱིས།",
    "རྣམ་པར་རྟོག་དང་རྣལ་འདུག་དང་།",
    "འོ་ན་ཁོ་རང་ལ།",
    "གཞན་ཡང་ཁོ་རང་ལ།",
    "ཉན་ཐོས་པ་དང་རང་རྒྱལ་འདིར།",
    "ན་འདུག་མི་རུང་།",
    "ལངས་འདུག་ཐུབ་མཚམས་ནས་གསེར་མཚོའི་བུལ་ཏོག་ཞུ་མཁན།",
    "མ་འདྲེས་པར་ཕྲོམ་ཕྲོམ་འདུག་ན་འཆི།",
    "གྲིབ་ཕོག་དུས་ཐོག་མར་སྤོས་དཀར་གྱི་ཐང་བཏང་ན་བཅོས་སླ།",
    "རྟ་ནོར་ཆག་དུས་ཀྱང་རྩི་དཀར་དང་སྤེན་མའི་དེབ་ཀྱིས་སྔར་བཞིན་དཀྲི།",
    "མགོ་མ་གཏོགས་སྣོད་བཅས་རས་ཀྱིས་དཀྲིས་ལ་རླངས་མ་ཤོར་བར་བྱས་ནས་མཚན་བརྗོད་ཚར་གཅིག་རིང་འདུག་དེ་ནས་རས་ཕུད་ཆུ་ཕྱར།",
    "འབྲུ་ཆང་ལ་ཆུ་བརྒྱབ་ནས་བཙགས་པའི་ཆང་རང་ནུབ་ཙམ་བླུགས་ནས་བསྐོལ་ལ་ཕོག་སྟེ་ཁ་བཅད་ནས་ཅུང་ཟད་བཞག་དེ་ནས་ཟངས་སྣོད་ཆེ་བར་བླུགས་ལ་སྔོ་ཁུ་དང་ཆུ་ཡིས་བུངས་བསྐྱེད་ལ་བསྐོལ།",
    "བྲང་ཏི་དཔལ་ལྡན་འཚོ་བྱེད་པས་འབིགས་བྱེད་སོགས་རི་བཞི་ཡི་དབུས་སུ་གསུངས་པ་ཚིག་དང་མི་འགལ་བ་འདུག་དེ་བས་གཞན་གྱིས་ལྟ་ན་སྡུག་བཙལ་བ་ནི་ལོང་བས་འཁར་བ་བཙུགས་པ་ལྟར་གར་གཏད་ཆ་མེད་དུ་འདུག་གོ།",
    "ཟུར་མཁར་བློ་གྲོས་རྒྱལ་པོས་ཀྱང་རང་གར་བཞག་པ་དེ་ལྟར་ལས་འཕྲོག་མ་ཡིན་པ་མ་སེམས་སོ།",
    "དེ་ནི་བློ་དམན་གསར་བུ་རྣམས་ཀྱིས་ཉམས་ལེན་དཀའ་བ་ཞིག་ལས་མི་འདུག་པ་དང་།",
    "བའི་འབྲས་བུ་ཐེག་ཆེན་དང་སྦྱར་བ་སོགས་ནི་འཐད་པར་མི་འདུག་ལ།",
    "འབྲས་བུ་གསུམ་ལ་འགའ་ཞིག་ཕྱི་མ་ནི་འབྲས་བུའི་འབྲས་བུ་ཟེར་བ་དེའང་མངོན་སུམ་གྱི་དཔེ་དང་སྦྱར་བ་ལ་འབྲས་བུ་ལ་འབྲས་བུ་སྨི་ན་པ་ཞིག་གང་ལའང་མི་འདུག་པ་དང་།",
