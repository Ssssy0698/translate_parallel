    "འདི་ཡིན་པ་འདྲ་འདིའི་རྩར་ཏིང་ངེ་འཛིན་སྐྱེ་ཡིན་འདུག་ཟེར།",
    "མི་སྨྲ་ནགས་སུ་གཅིག་པུར་འདུག་པར་བྱ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ལ་ཡང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་བལྟའོ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་ཡང་དག་པར་རྗེས་སུ་བལྟ་འོ་ཞེས་པ་སྟེ།",
    "ཅི་ཡང་མེད་པ་ཁ་། དང་རང་དང་བདུན་ལ།",
    "གཏི་མུག་དུས་གསུམ་རྒྱུན་དུ་བ་དང་བདུན་ནོ། དེ་ལ་གཞི་རྟེན་ཅན་གྱི་རྟོག་པ་ཞེས་བྱ་སྟེ།",
    "དེའི་མཛད་པའི་འཕྲིན་ལས་ཀྱང་རང་རྒྱུད་པ་མེད་དོ།",
    "འདུག་མ་མྱོང་བའི་གནས་ཡིན་ནོ།",
    "རྒྱུ་ཆ་མེད་པ་ལ་བཟོ་མི་ཤེས་པར་གདའ་གསུངས་སོ། སྐུ་༡དང་ཡེ་ཤེས་མེད་པས་འབྲས་བུ་སྟོར་བའི་དུས་ནི།",
    "སྐྱེ་འགག་མེད་པའི་ཡུལ་ལ་ལྟོས་དང་གསུངས་སོ། ངོ་བོ་དྲི་མེད་དུ་འདུག་པས།",
    "འདིར་འདུག་མེད་པས་གནས་མ་ཤེས།",
    "སེམས་དེ་ཉིད་མིང་ཙམ་དུ་འདུག་གོ།",
    "ཁོ་རང་ལ་བསྟོད་སྒྲ་ཕུལ་ལ་གཞག།",
    "བཅིངས་གྲོལ་མི་གདའ་གསུངས། མ་ལྡན་མི་འབྲལ་མ་ཤེས་ན།",
    "བཏང་སྙོམས་རྒྱུན་ལ་མི་བལྟོས་པར་སྐད་ཅིག་མའི་ཐོག་ན་རྟོག་པ་ཅི་འདུག་ཏུར་གྱིས་བསྒྲིམས་ནས་རྦད་ཀྱིས་བཅད་པས།",
    "ཁོ་རང་གང་བྱུང་བ་ལ་དགལ་བསྐུར་བས།",
    "རང་དོན་མ་གྲུབ་པར་གཞན་གྱི་ཁོལ་པོ་ལ་དགོས་པ་མི་ཟླགདའ་གསུངས་སོ། དཀའ་ཐུབ་ཀྱི་བསྐུར་ལུགས་གསུམ་གྱིས།",
    "ཚིག་ཚིག་ངོ་བོ་མིང་འདོགས་དང་བྲལ་བ་དེས་ཐ་སྙད་སྟོར་དུ་གཞུག་པའི་ལག་ལེན་ནིབེམས་པོ་ལ་ན་ཚ་མི་འོང་བར་གདའ་གསུངས་སོ། གནས་ལུགས་ཀྱི་དོན་ལ་བརྗོད་མེད་དུ་གཏན་ལ་ཕབས་པས།",
    "དུམ་བུར་འདུག་པའི་ཕྱིར།",
    "ངོ་བོ་སྟོང་པར་འདུག།",
    "འདོད་པས་མི་མྱོང་བར་གདའ་གསུངས་སོ། རང་བཞིན་ལ་རྩལ་རྫོགས་པ་དེས།",
    "དཔེར་ན་མར་མེ་དང་མུན་པ་བཞིན་དུ་ཁོ་རང་ལ་གཅེས་པར་གཏན་ལ་ཕབས་པས།",
    "ནམ་མཁའ་ལ་ཕྱོགས་མཚམས་གདའ་ཡེ་གསུངས་སོ། ངོ་བོས་བྱ་ར་བྱས་ནས་མཉམ་བཞག་རྗེས་ཐོབ་དུ་བསྐྱང་བའི་ལག་ལེན་ནི།",
    "འགྲོ་འདུག་ཟ་ཉལ་སྤྱོད་ལམ་བཞི་ལ་གོམས་པར་བྱ།",
    "གྱད་སྟོབས་པོ་ཆེ་ཡང་སྦྱངས་པ་ལས་བྱུང་འདུག་གསུངས་སོ། རང་བཞིན་མཐའ་བཞི་དང་བྲལ་བ་དེས།",
    "སྨོན་པའི་སེམས་ལ་ཆགས་སྡང་གདའ་ཡེ་གསུངས་སོ། མཚན་ཉིད་རྟོག་པ་དང་བྲལ་བ་དེས།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱིས་འཁྲུལ་རྟོག་མ་དག་པས།",
    "ཟ་མ་མྱོང་བའི་ཟས་ལ་འབྲེན་མི་འོང་བར་གདའ་གསུངས་སོ།",
    "མིང་མེད་པས་འབོད་མི་ཤེས་པར་གདའ་གསུངས་སོ། མཚན་ཉིད་ཡུལ་ལ་ལྡོམ་པ་དེས།",
    "རྩོད་པའི་ཡན་ལག་མི་གདའ་གསུངས་སོ། རང་བཞིན་ལ་བར་ཆད་མེད་དམ་བཅའ་བྱས་ན་དུས་དེར་བར་ཆོད་ཞུགས་པ་ཡིན།",
    "བསྐལ་པ་འཛད་པར་གདའ་འོ་གསུངས་སོ། ངོ་བོ་གཏན་ལ་ཕེབས་པ་དེས།",
    "བག་ཆགས་ཀྱིས་མ་གོས། ཤེལ་སྒོང་ལ་རྡུལ་མི་འགོ་བར་གདའ་གསུངས་སོདེ་ལྟར་རིག་པ་གཅེར་བུར་གཏན་ལ་ཕབས་པས།",
    "དེ་ཡང་བཏུབ་པར་འདུག་ཟེར།",
    "དེ་ནི་རབ་ཏུ་མ་བྱུང་ཙ་ནའི་སྲས་ཡིན་ན་བྱས་པས།",
    "དེ་ཡང་བཏུབ་པར་འདུག་ཟེར་ནས་སྤྱོ་བའི་སེམས་ཞི་འོཔར་བྱེད་པའི་ཚིག་གོགླེང་བསླང་བའི་རྒྱ་ནི།",
    "རྣམ་པ་གཅིག་ཏུ་རི་དེ་དང་དུར་ཁྲོད་བསིལ་བའི་ཚལ་རྒྱུབཞི་འདབ་འབྱར་དུ་འདུག་པས།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ལ་ཡང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ལྟའོ་ཞེས་པ།",
    "དེ་ལས་ཀྱང་རང་རྒྱལ་བའི་བསྒྲུབ་པའི་ལམ་ནི།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བའི་བྱང་བླ་ན་མེད་པ་མཆུབ་ལྟ་བུ་མ་ཡིན་པས།",
    "ཁ་། ཞིག་འདུག་པ་དེ་ཁོ་བོར་ཕུལ་དང་གསུངས།",
    "ཨོཾ་བ་ཤ་མི་ཀི་དུ་རུ་མ་ཤི་ཀི་ཛལ་ཏི་ཨ་ཙི་ཏེ་ཱ་ཧཱ།",
    "ཨོཾ་ཕེ་ལཾ་ཱུྃ་ཨོཾ་ནག་པོ་ཏི་པ་རཱ་ཙ་ནཱ་ག་རཀྴ་ཨོཾ་ཕེ་ལཾ་ཱུྃ་འཇམ་དཔལ་ནཱ་ག་རཀྴ་ཀླུ་བདུད་ནག་པོ་ཏི་པ་ཙ་བསྙོན་ཁའི་རྗེ་བཙུན་ཆེན་པོ་འཁོར་དང་བཅས་པ་བདག་ུབ་པ་པོ་ལ་༴",
    "གཡུ་མིག་མེད་ལ་མཚལ་གྱིས་ཏྲི་བདུན་བྲིས་པ་དང་ལྷན་ཅིག་དར་དམར་པོས་བཏུམས་ལ་ཟངས་ཀྱི་གའུར་བཅུག་ལ་རྟེན་གཏོར་སོགས་དང་ལྷན་ཅིག་བཞག་ུབ་པ་ཚར་ནས་ལུས་ལ་བཅང་ནའང་ཆོག་ཅིང་རང་སྲུང་སེང་ལྡེང་ཕུར་པ་ལ་རྟ་མགྲིན་གྱི་སྔགས་བྲིས་ནས་དར་དམར་གྱིས་དྲིལ་བ་ལུས་ལ་འཆང་བ་རྒྱུད་ལས་གསུངས་སོ།",
    "ཁྲུས་བྱས་གཙང་སྦྲ་དང་ལྡན་པས་སྟན་བདེ་བ་ལ་སེམས་སྐྱིལ་གྱིས་འདུག་ལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "འདུག་དང་བརྩོན་འགྲུས་སེམས་དང་ནི།",
    "དེ་བཞིན་ཉིད་དང་རང་བཞིན་དང་།",
    "དེ་ཡང་རང་སྣང་ཞེས་སུ་བཤད།",
    "ཡུམ་གྱི་སྤྱི་རྒྱ་ཡིན་ཏེ་ལས་མཆོག་དུས་སུ་སྦྱར།",
    "དེ་ཕྱིར་ཐུགས་རྗེ་ཆེན་པོས་འབྲེལ་པའི་འགྲོ་དྲུག་དུས་གནས་མུན་སེལ་སྣང་།",
    "མ་སྐྱེས་སྒྱུ་མ་སྣང་དང་རང་བཞིན་མེད་པར་གཅིག་།",
    "ཅིས་འདུལ་ཐབས་ཀྱི་རང་རང་ལག་ཆ་མ་ངེས་སྣ་ཚོགས་བསྣམས།",
    "གྲོགས་ངན་སྤངས་དང་རང་བཞིན་དབྱེ་བ་དང་།",
    "རང་རང་བདེ་བས་རང་མཆོད་ཚེ།",
    "ཏ་ཀི་ཧཱུྃ་དང་རང་སྔགས་ཀྱིས།",
    "དེའང་འབུ་ཏ་ལོ་ཙ་ནེ་སྭཱ་ཧཱ།",
    "ཕྱོགས་གཞན་དུ་རྡོ་རྗེ་གསུམ་གྱི་སྔགས་འབྱུང་རྔུབ་འདུག་པ་ལ་འབད་པ་དང་།",
    "སྤྱན་ལམ་བར་ཆད་བསྲུང་བའི་ཕྱིར་འདུག་ན་འབྲུ་བཞིས་མཚམས་གཅད་ཅེས་པ།",
