    "ལམ་དེ་གཉིས་རྒྱུད་ལ་བསྐྱེད་པར་བྱའོ་ཞེས་སྟོན་པའོ།",
    "དེ་ཉིད་འདོད་པའི་ཁམས་སུ་ལྷ་དང་མི་ཡི་རིགས་ཞུས་རིགས་སུ་སྐྱེ་བ་གཉིས་པོ་ལ་འབྲས་གནས་ཁྱད་པར་ཐིན་གེ་ཏེ་རྒྱུན་ཞུགས་ལྔའོ།",
    "ཕྱིན་འོང་དེ་འདོད་ཉོན་སྒོམ་སྤང་བདུན་ཞམ་བརྒྱད་སྤངས་ཤིང་གཉེན་པོ་ཟག་མེད་ཐོབ་པ་འདོད་ལྷར་སྐྱེ་བ་གཅིགལུས་པས་ཚེ་གཅིག་བར་ཆད་གཅིག་པ་སྟེ་འབྲས་གནས་ཁྱེད་པར་ཅན་དང་ཕྱིར་འོང་གསུམ།",
    "གཟུགས་ཁམས་སུ་སྐྱེས་ནས་བརྩོན་པའི་འདུ་བྱེད་དང་བཅས་པས་ལམ་མངོན་དུ་བྱས་ནས་སྡུག་བསྔལ་གྱི་ཐ་མར་བྱེད་པ་བྱེད་བཅས་དང་།",
    "གཟུགས་སུ་སྐྱེསནས་འབད་རྩོལ་གྱི་འདུ་བྱེད་མིན་པའ་ལམ་མངོན་དུ་བྱས་ནས་སྡུག་བསྔལ་ལས་འདའ་བ་བྱེད་མིད་དང་།",
    "ཚངས་རིས་ཞས་གཞས་གཙང་འོག་མ་འགའ་ཞིག་དང་།",
    "ཕྱིར་མི་འོང་དེ་ཉིད་སྲིད་རྩེའི་མཐར་ཐུག་པར་འགྲོ་བ་ནི།",
    "མཐོང་ལམ་མངོན་དུ་བྱས་ཏེ་འདས་ལམ་གྱིས།",
    "གཞས་གཙང་མིན་པའི་ཁམས་གོང་མ་གཉིས་ཀྱི་སེམས་རྣམས་ཐོབ་པས་གཟུགས་ཁམས་སུ་སྐྱེས་ཏེ།",
    "ཅེས་སོགས་ཤིན་ཏུ་རྒྱས་པར་གསུངས་སོ།",
    "མི་རྟག་སོགས་ཀྱིས་ཁྱད་པར་དུ་བྱས་པའི་བདེན་བཞི་སྒྱུ་མ་ལྟ་བུ་དམིགས་པ་དང་ནི།",
    "རྒྱ་ཡི་ཁྱད་པར་འདི་འོག་མ་ཐམསཅད་ལ་ཡང་སྦྱར་བར་བྱའོ།",
    "ཞེས་སོགས་གསུངས།",
    "པས་གཟུགས་ལ་གནས་པར་མི་བརྩིས་སོ་སོགས་གནས་མེད་དམིགས་མེད་དཔེས་གསུངས།",
    "མཉམ་པར་འཇོག་པ་དང་།",
    "སྒྱུ་འབྲས་དང་དེ་ཉིད་ལ་རྨོངས་པ་དངོས་པོའི་རང་བཞིན་དང་མི་མཐུན་པར་ཕྱིན་ཅི་ལོག་ཏུ་འཛིན་ཅིང་ཡང་དག་པའི་དོན་ལ་སྒྲིབ་པར་བྱེད་པའི་ཀུན་རྟོག་མ་རིག་པ་དང་།",
    "སྐྱེ་བའི་དོན་གྱི་རྣམ་པར་རྟོག་པ་དང་།",
    "ཁྱད་པར་ལམ་དང་འཕགས་པ་དགྲ་བཅོམ་པའི་གདྭགས་གཞི་མི་སློབ་པའི་ལམ་ལ་དགྲ་བཅོམ་པར་བཏགས་པར་འཛིནཔ་སྟེ་དགུའོ།",
    "སྦྱོར་ལམ་གྱི་རྟོགས་པས་སྤང་བྱ་དེ་དག་མངོན་གྱུར་ཉམས་སྨད་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལྟར་བྱེད་པའི་ཐབས་མཁས་དང་ས་སྟོན་པའི་ཁྱད་པར་ནི།",
    "སེམས་བསྐྱེད་བསྔོ་བ་རྣམས་རང་རྒྱུད་ལ་སྟོན་པར་བྱེད་པ་དང་།",
    "བཞི་པ་གདོམ་དོན་ཕྱིན་ཅི་མ་ལོག་པར་བསྒྲུབ་པ་ལ།",
    "ཐེག་ཆེན་གྱི་རིགས་ལ་འདུས་བྱས་ཀྱི་སེམས་ཟག་མེད་དུ་གནས་འགྱུན་རུང་ལ་ངོས་འཛིན་པ་སེམས་ཙམ་ལུགས།",
    "མི་མཐུན་ཕྱོགས་ཉོན་སྒྲིབ་མ་ལུས་པར་སྤོང་བ་རྣམ་གྲོལ་ལ་མ་དང་།",
    "དགོངས་ལྡེམ་དགོངས་ཀྱི་སྒོ་ནས་གདུལ་བྱ་གཞན་གྱི་བསམ་པ་དང་མཚུངས་པར་དོན་དྷི་གློ་ཟིམ་པཞིན་སྒྲུབ་པ་དང་།",
    "དཔེར་ན་དོ་ཨ་གསུམ་མེད་པར་བསྟན་པ་ལྟ་བུའོ།",
    "ཞེས་གསུངས་པ་ལ་སོགས་པ་ལྟ་བུ་སྟེ།",
    "སྦྱིན་སོགས་ཅུང་ཟད་ཙམ་གྱིས་ཆོག་པར་འཛིན་པ་ལ་སྦྱིན་སོགས་སྨད་པའམ།",
    "ཚོད་དུ་ཁྱུ་བ་འདི་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "རྣམ་མཁྱེན་ལ་སེམས་གཅིག་པ་བསམ་གཏན།",
    "ཐེག་ཆེན་གྱི་ལམ་ལ་རྗེས་ཐོབ་ཏུ་འཁོར་གསུམ་རྣམ་པར་དག་པས་སྒྱུ་མའི་སྐྱེས་བུ་བཞིན་རུ་འཇུག་པ་དང་།",
    "འབྲས་བུ་ཤེས་བྱའི་རྣམ་པ་ཀུན་མཁྱེན་པའི་ཚུལ་ལ་ནི་ད་མིགས་ནས་འཇུག་པའི་སྒྲུབ་པ་གང་ཡིན་པ་དེ་ནི་ཐེག་ཆེན་ལ་བགྲོད་ཅིད་འཛུགས་པ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ་ཡུལ་འདི་དགུ་ཐེག་ཆེན་གྱི་འཇུག་ཡུལ་ཡིན་པས་སོ་། ཞར་ལ་བསམ་གཏན་བཞི་དང་གཟུགས་མེད་བཞི་སྟེ་བརྒྱད་ནི།",
    "བསམ་གཏན་དང་པོ་སོགས་གོང་མ་གོང་མ་དེ་ལས་བཟློག་པར་ལྟ་པའི་ཐོས་བསམ་གྱི་ཤེས་རབ་ཀྱིས་མཚན་ཉིད་རབ་ཏུ་རིག་པའི་ཡིད་བྱེད་དད།",
    "རབ་དབོན་དགའ་སྡུད་སྦྱོཪ་མཐའ་གསུམ་བར་ཆད་མེད་ལམ་དཔྱོད་པ་ཁྱད་པར་ལམ།",
    "གནས་སམ་རྟེན་གྱི་ཡཞལག་སེམས་རྩེ་གཅིག་པ་སྟེ་ཡན་ལག་ལྔ་དང་བསམ་གཏན་གཉིས་པར་གཉེན་པོ་རབ་དང་།",
    "བཞི་པར་དྲནཔ་དང་།",
    "གཟུགསལ་ཆགས་པ་དང་བྲལ་ཏེ་གཟུགས་ཀྱི་འདུ་ཤེས་ནུབ་པ་གཟུགས་མེད་ལ་བྲག་ཏུ་གཟུགས་ཀྱི་འདུ་ཤེས་མེད་པར་ནམ་མཁའ་ཙམ་མཐའ་ཡས་སོ་ཞེས་དེ་ཙམ་ལ་སྙོམས་པར་ཞུགས་པ་ནམ་མཁའ་མཐའ་ཡས་དང་།",
    "ཁྱད་པར་འབྱེད་པའི་སྒོ་ནས་དོན་མ་ནོར་བར་མཐོང་བ་ལྷག་མཐོང་བཅས་པ་དང་།",
    "རྣམ་མཁྱེན་ཡིད་བྱེད་ཀྱིས་གཞན་དོན་གྱི་ཐབས་ལ་མཁས་པ་གང་ཡིན་དང་།",
    "རྒྱུ་རྐྱེན་ལས་སྐྱེས་པ་འདུས་བྱས་དང་།",
    "དེ་ལས་ཀྱང་ཁྱད་པར་དཔའ་བར་འགྲོ་བ་དང་།",
    "དྲན་པ་དང་ཤེས་རང་མཚུངས་པར་ལྡནཔས་ཚིག་དང་དོན་མི་བརྗེད་པར་འཛིན་པ་གཟུངསཏེ།",
    "པར་ནམ་ཡང་མི་བརྗེད་པ་དོན་གྱི་གཟུངས་གཉིས་སམ།",
    "གྲངས་ཀྱི་རྩིམ་པ་བཅུ་བདུན་པོ་འདི་དག་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ཁྱང་ཆེ་ན་ཡང་དག་པར་འགྲུབ་བྱེད་ཀྱི་ངོ་བོ།",
    "སྤྱིར་བདག་མེད་གཉིས་རྟོགས་ཀྱི་མཁྱེན་པས་སྒྲིབ་གཉིས་རིམ་བཞིན་སྦྱོར་བར་བྱེད་པ་དང་།",
    "དེ་ལྟརན་མཉམ་གཞག་དྲེ་ནི་རྗེས་ཀྱི་ངེས་པ་དེ་ལྟ་བུ་འདྲེན་པའི་དོན་དུ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་ཡང་ཐོབ་ཟི་ན་ཁྱད་པར་དུ་བྱེད་པའི་ཡོན་ཏན་བཅུར་འགྱུར་ཏེ།",
    "འདི་དག་དོན་དམ་པར་རང་བཞིན་མི་དམིགས་པས།",
    "ཞིང་དག་པར་བྱེད་པའི་རྒྱུ་ཚོགས་བསགས་པས།",
    "ཕན་ལན་དུ་གནོད་བྱས་ཀྱང་གཞན་དོན་ལ་ར་བྱས་ཡོངས་དང་།",
    "ལོག་པར་ལྟ་བ་སོགས་བློ་གྲོས་ངན་པ་མེད་པ་དིང་ནི།",
    "ཏྲཱའི་སྲས་ཀྱི་ས་ལྔ་པ་ནི་ཡང་དག་པར་འཐོབ་པོ།",
    "བདོག་པ་ཀུན་ལྷག་མ་མ་ལུས་པར་བཏང་ཡང་མི་དགའ་བ་མེད་པ་དང་།",
    "ལམ་བསྐྱེད་པ་དྲུག་དང་ལམ་མིན་སྤོང་པ་དྲུག་སྟེ་བཅུ་གཉིས་ཀྱིས་ས་ནིདྲུག་པ་ཡང་དག་པར་འཐོབ་པར་འགྱུར་རོ།",
    "ཉི་བུ་ཡོ་དེ་ས་བདུན་ཕ་གང་ལ་རྣམ་པར་ཆད་པ་དེ་ཡིས་རྐུན་པོ་བྱུར་བ་དང་སྒོ་གཅོད་པ་ལྟར་ས་ནི་བདུན་པ་འཐོབ་པར་འགྱུར་རོ།",
    "གཟུང་འཛིན་གྱི་རྣམ་པར་རྟོག་པ་ཀྲུ་ན་ཏུ་འཇོམས་པ་དང་།",
    "གཙང་བ་དེ་རྟག་བདག་ཕྱིན་ཅི་ལོག་བཞིའི་འདུ་ཤེས་འཇིག་ཚོགས་ལ་ལྟ་བ་དང་།",
    "ལོག་པར་ལྟ་བ་སོགས་དང་།",
    "ངེས་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པས་ལྷ་ཀླུ་གནོད་སྦྱིན་དྲི་ཐ་ལ་སོགས་པའི་སྐད་མཐའ་ཡས་པཤེས་པ་དང་།",
    "དགྲ་བཅོམ་པ་འབྲས་གནསཞི་བྱ་བ་བྱས་པ་སོགྷ་རབཉན་ཐོས་ཀྱི་ཡོན་ཏན་བཅོ་ལྔ་དང་ལྡན་པས་བྱས་པ་རྟོགས་པའི་སི།",
    "ཐོབ་བྱ་ཐོབ་བྱེད་ཀྱི་འབྲེལ་པ་དོན་དམ་པར་མི་དམིགས་པ་དད་༥༥གཉིས་སོ།",
    "རྣམ་མཁྱེན་ལམ་གྱི་ངེས་འབྱུང་རྣམས་ལེའུ་བཤུ་བཞི་པ་རབ་འབྱོར་གྱི་ལེའུ་ལས་བསྟ་ན་པའི་དོན།",
    "རྣམ་པ་ཐམསཅད་མཁྱེན་པ་ཉིད་ཀྱི་སྐབས་ཏེ།",
    "ཐེག་གསུམ་ཐ་དད་དུ་བཞག་པ་ནི་དྲང་དོན་དགོངས་པརྩན་ཏེ།",
    "ཡང་ཤར་རིག་པར་རྟོགས་པའི་ངོ་བོ་མངོན་དུ་གྱུར་པ་ལ་སྡུག་བསྔལ་གྱི་འཚེ་བ་མེད་པའི་ཕྱིར་དང་།",
    "གཉིས་པ་བརྟེན་པ་ལམ་ཤེས་ཀྱི་ཁྱད་པར་ལ།",
    "འཕགས་པ་ཉན་ཐོས་ཀྱི་ལམ་འདྲི་ཤེས་པར་བྱ་བ་ཡིན་ནོ།",
    "ལྷག་མེད་དུ་འགོག་བྱའི་ངོ་བོས་གསུམ་དུ་རོང་སྟོ་ན་གསུངས་སོ།",
    "སྡུག་བསྔལ་གཏན་དུ་ཟད་པར་བྱེད་པའི་ངེས་འབྱིན་ནོ།",
    "ཕྱི་རིགས་སུ་གཏོགས་པའི་མཐུས་ཡིན་པར་བསྟན་པས་ན་རང་རྒྱལ་གྱི་བདག་མེད་ཕྱེད་གཉིས་ལ་སྔོན་གོམས་པའི་རྒྱུས་སྲིད་པ་ཐ་མཔར་གྱུར་པ་ན།",
    "སྦྱང་ཡུལ་དེ་ངོ་བོས་མ་གྲུབ་ཀྱང་འཛིན་པ་ལ་དེར་སྣང་མི་ཁེགས་པ་ལྟར་ལམ་དངོས་གཟུང་པ་ཕྱི་རོལ་གྱི་དོན་ལཞེན་པའི་རྙོག་པ་རང་བཞིན་མེང་པར་རྟོགས་པས་སྤོང་བའི་ཕྱིར་དང་།",
    "སྦྱིན་པལ་སོགསཔ་དགེ་རྩ་མི་ཟད་པར་འདོད་པས།",
    "འདི་སྐབས་མ་ལས་ཀཱ་ཁོར་ཏ་དང་མེ་ཆུ་སོགས་གསུངས་པའི་ཀཱ་ཁོར་ཏ་ཞི་བྱད་ཀྱི་མིང་ངམ་བྱང་ཤར་ཕྱོགས་ཀྱི་མི་མ་ཡིནཔའི་རིགས་སུ་གསུངས།",
    "རྩ་བའི་དཔྱེ་བ་རྣམ་པ་གསུམ་དུ་ཤེས་པར་བྱ་ཞིང་དེ།",
    "རྒྱལ་བསྲས་བཅསཀྱིས་སྤྲོ་བ་བསྐྱེད་པར་མཛད་དེ།",
    "བསྔོ་བ་འདི་ལ་སློབ་དཔོན་འཕགས་པས་རྐང་པ་དང་པོ་བསྔོ་བའི་ཁྱད་པར།"
  ]
}