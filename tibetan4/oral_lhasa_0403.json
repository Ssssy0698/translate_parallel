    "བཟའ་ཤིང་ར་བའི་རྫིང་དང་ཆུ་བྲན་འབབ་པར་ལྡན།",
    "འགྲོ་བ་རྣམས་ལ་ཕན་པའི་དོན་དུ་རྣམ་པར་སྤྱོད།",
    "ཡོན་ཏན་རྒྱ་ཆེན་ཚུལ་འཇུག་བསྟོད་པར་བྱེད།",
    "གཡས་ཕྱོགས་བསྐོར་བ་བྱས་ཏེ་གུས་པར་སྐུར་སྟོན་ནས།",
    "རིན་ཆེན་རི་ཡི་སུལ་ན་གནས་པར་དེས་ཀྱང་མཐོང་།",
    "འཕགས་པ་ཐུགས་རྗེ་བསྐྱེད་དེ་གདམས་ཤིང་བསླབ་པར་གསོལ།",
    "རྒྱལ་པོ་དག་ལ་ཉེས་པའི་གཡོར་བྱས་བསད་སྤངས་པ།",
    "མདའ་འཕངས་དེ་ཡི་ལུས་ལ་ཕོག་པར་མི་འགྱུར་རོ།",
    "དགྲ་རྣམས་ཀུན་ལས་རྒྱལ་འགྱུར་གྲགས་པ་ཐོབ་པར་འགྱུར།",
    "དགྲ་རྣམས་ཀུན་ལས་རྒྱལ་ཞིང་འཇིགས་པ་མེད་པར་འགྱུར།",
    "གང་རྣམས་ལ་ལས་ང་ཡི་མིང་ཞིག་དྲན་བྱས་ན།",
    "དོན་མེད་ཀུན་དུ་མི་འགྱུར་དོན་རྣམས་གྲུབ་པར་འགྱུར།",
    "ང་ཡི་མིང་ཐོས་དྲན་བྱས་སྙན་པར་བརྗོད་པར་འགྱུར།",
    "དགྲ་རྣམས་རྟག་ཏུ་དེ་ཡིས་ཟིལ་གྱིས་གནོན་པར་འགྱུར།",
    "ང་ཡི་མིང་ནི་སྐད་ཅིག་ཡུད་ཙམ་དྲན་བྱས་ཀྱང་།",
    "འབྲལ་བར་མི་འགྱུར་སྡང་དང་འགྲོགས་པར་དེ་བཞིན་མིན།",
    "དེ་ལྟར་བདག་ལ་ཕན་པ་སྒྲུབ་པ་ཕུན་སུམ་ཚོགས་པས་ཡང་དག་པར་བསྟོད་ནས།",
    "ཡང་བཅོམ་ལྡན་འདས་དེ་ཉིད་ལ་གཞན་ལ་ཕན་པ་སྒྲུབ་པ་ཕུན་སུམ་ཚོགས་པས་ཡང་དག་པར་བསྟོད་པ་ནི།",
    "དོན་ཇི་ལྟ་བ་བཞིན་ཕྱིན་ཅི་མ་ལོག་པར་སྟོན་པས་ན་དོན་བཞིན་སྟོན་པའོ།",
    "དེ་བས་དེ་ཕྱིར་འདི་ནི་སྟོན་པས་གསུངས་སོ་ལོ།",
    "ལམ་མ་གཏོགས་པ་འདུས་བྱས་རྣམས།",
    "ཟག་རྣམས་ཀུན་ཏུ་རྒྱས་པར་འགྱུར།",
    "ཇི་ལྟར་རྒྱས་པར་མི་འགྱུར་བ་དེ་ནི་འོག་ནས་ཕྲ་རྒྱས་བསྟན་པ་ཉིད་དུ་བསྟན་པར་བྱའོ།",
    "འདུས་མ་བྱས་རྣམ་གསུམ་ཡང་སྟེ།",
    "དེ་ལྟར་ནམ་མཁའ་ལ་སོགས་པ་འདུས་མ་བྱས་རྣམ་པ་གསུམ་པོ་དེ་དང་།",
    "དེ་དག་ལ་ཟག་པ་རྒྱས་པར་འགྱུར་བ་མེད་པའི་ཕྱིར་རོ།",
    "འདུས་མ་བྱས་རྣམ་པ་གསུམ་པོ་བསྟན་པ་གང་ཡིན་པ་དེ་ལ་ནམ་མཁའ་མི་སྒྲིབ་པ།",
    "དེས་ཐོབ་པར་བྱ་བའི་འགོག་པ་ནི་སོ་སོར་བརྟགས་པས་འགོག་པའོ།",
    "དེ་དག་ལ་དམིགས་པའི་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་པོ་དག་ནི་ཡང་སྐྱེ་བར་ཡང་མི་ནུས་ཏེ།",
    "ལམ་མ་གཏགས་པ་འདུས་བྱས་རྣམས།",
    "ཟག་བཅས་ཞེས་གང་སྨྲས་པའི་འདུས་བྱས་དེ་དག་གང་ཞེ་ན།",
    "རྐྱེན་རྣམས་འདུས་ཤིང་ཕྲད་ནས་བྱས་པ་དག་ན་འདུས་བྱས་རྣམས་ཏེ།",
    "དོན་དང་བཅས་པའི་གཞི་སྨོས་པའི་ཕྱིར་ན་འདུས་བྱས་ནི་གཏམ་གྱི་གཞི་ཞེས་བྱའོ།",
    "འདུས་བྱས་ཐམས་ཅད་ཀྱི་མྱ་ངན་ལས་འདས་པའོ།",
    "ཡང་འདུས་བྱས་དེ་དག་ཉིད།",
    "ཕུང་པོའང་དེ་དག་འདིས་ཅི་ཞིག་གྲུབ་པར་འགྱུར་ཞེ་ན།",
    "འདི་ལ་ལྟ་བས་རྒྱས་པར་འགྱུར་བའི་སྒོ་ནས་གནས་པས་ན་ལྟ་བའི་གནས་སོ།",
    "རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་སྟེ་དེ་སྙེད་ཅིག་ནི་གཟུགས་ཀྱི་ཕུང་པོའོ།",
    "ལུས་དག་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "ལྷག་མ་ནི་བརྡ་ཕྲད་པར་སླ་བས་རྣམ་པར་མ་ཕྱེ་བའོ།",
    "རིང་པོ་ལ་སོགས་པའི་ཕྱོགས་ལུས་ཀྱི་རྣམ་པར་རིག་བྱེད་ཀྱི་ངོ་བོ་ཉིད་དོ།",
    "སྔོན་པོ་ལ་སོགས་པ་དང་རིང་པོ་ལ་སོགས་པར་ཡོངས་སུ་ཆད་པར་སྣང་བས་ན་ཉི་མ་དང་།",
    "གྲང་བ་ནི་དྲོ་བར་འདོད་པར་བྱེད་པའོ།",
    "བཀྲེས་པ་ནི་ཟས་འདོད་པར་བྱེད་པའོ།",
    "སྐོམ་པ་ནི་སྐོམ་འདོད་པར་བྱེད་པའོ།",
    "གནོད་པར་བྱེད་པའི་གྲང་བ་མེད་ཀྱི་ཕན་པར་བྱེད་པ་ནི་ཡོད་དོ་ལོ།",
    "དཔེར་ན་ཐག་རིང་པོ་ནས་དམག་བཤགས་པའམ།",
    "རྣ་བ་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ཡང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དེ་ལྟ་ན་སྤྱི་ལ་དམིགས་པའི་ཕྱིར་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་པོ་དག་སྤྱིའི་ཡུལ་ཅན་དུ་འགྱུར་གྱི།",
    "འདི་དཔྱད་པར་བྱ་སྟེ།",
    "ཡུལ་མཉམ་པ་དང་ཕྲད་ན་ནི་ལྕེའི་རྣམ་པར་ཤེས་པར་སྔར་སྐྱེ་སྟེ།",
    "ད་ནི་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་བསྙད་པར་བྱ་བ་དེ་བརྗོད་པར་བྱ་སྟེ།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པའང་ཡང་ཡིན་པའོ།",
    "དེ་ནི་ཞེས་བྱ་བའི་སྒྲ་ནི་དེའི་མིང་ཤེས་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "གཟུགས་དང་བྱེད་པའི་རང་བཞིན་ཡིན་ཡང་རྣམ་པར་རིག་བྱེད་བཞིན་དུ་གཞན་དག་ལ་རྣམ་པར་རིག་པར་བྱེད་པ་མ་ཡིན་པས་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའོ།",
    "བརྗེད་ཅེས་བྱ་བ་ནི་སློབ་དཔོན་གྱི་ཚིག་ཡིན་པར་སྟོན་པའོ།",
    "རྒྱས་པར་བྱེད་པ་ནི་འཕེལ་བ་དང་རྒྱས་པར་བྱེད་པར་རིག་པར་བྱ་སྟེ།",
    "ཡང་བ་ཉིད་དོ་ཞེས་གསུངས་ལ།",
    "འདི་ལྟར་ས་སྟོན་པ་ན་ཁ་དོག་དང་དབྱིབས་སྟོན་པར་བྱེད་དོ།",
    "ཅིའི་ཕྱིར་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་བར་འདི་གཟུགས་ཀྱི་ཕུང་པོ་ཞེས་བྱ་ཞེ་ན།",
    "ཟུག་རྔུས་ཟུག་བཞིན་གནོད་པར་འགྱུར།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "འོ་ན་ནི་རྡུལ་ཕྲ་རབ་གཟུགས་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "འོ་ན་ནི་འདས་པ་དང་མ་འོངས་པ་གཟུགས་མ་ཡིན་པར་འགྱུར་རོ།",
    "གཟུགས་སུ་ཡོད་པར་འགྱུར་བ་དང་།",
    "འོ་ན་ནི་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་གཟུགས་མ་ཡིན་པར་འགྱུར་རོ།",
    "དེ་ཡང་རྣམ་པར་རིག་བྱེད་ལ་གཟུགས་སུ་ཡོད་པའི་ཕྱིར་གཟུགས་སུ་ཡོད་པར་འགྱུར་ཏེ།",
