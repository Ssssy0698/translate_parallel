    "བསྟོད་པ་དག་གིས་ནི་མ་ཡིན་ནོ།",
    "གཞན་དུ་ན་དེ་བཞིན་གཤེགས་པ་ནི་བསྟོད་པ་དག་གིས་གཡོ་བར་མཛད་དེ།",
    "ཇི་ལྟ་ཇི་ལྟར་དེ་བཞིན་གཤེགས་པ་ལ་བསྟོད་པ་བྱེད་པ་དེ་ལྟ་དེ་ལྟར་བདག་ཉིད་ལ་ཕན་པ་སྒྲུབ་པར་བྱེད་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་ནི་རྣམ་པ་དྲུག་གིས་བསྡུས་པར་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་ཇི་ལྟར་མཐའ་དག་གིས་ཤེ་ན།",
    "ངག་གི་སྤྱོད་ཡུལ་ལས་ཡང་དག་པར་འདས་པ་ཡིན་པས།",
    "གང་གི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་བསྟོད་པ་ཐམས་ཅད་ལས་ཡང་དག་པར་འདས་པ་དེའི་ཕྱིར་བསྟོད་པར་འོས་པ་ཁོ་ན་ཡིན་ནོ།",
    "འདི་ལྟར་དེ་བཞིན་གཤེགས་པ་ནི་བདག་ལ་གཞན་དག་གིས་འདི་ནི་ཡོན་ཏན་དང་།",
    "ལྡན་པ་ཡིན་ནོ་ཞེས་ཤེས་པར་གྱུར་ན་ཅི་མ་རུང་སྙམ་དུ་ཡོན་ཏན་དག་གིས་གཞན་ལས་ཤེས་ཀྱི་ཁེ་ཚོལ་བར་མི་མཛད་པ་དང་།",
    "ཡོན་ཏན་དེ་དག་གིས་བདག་ཉིད་གཞན་དག་དང་བསྐྲུན་ཅིང་ཡོངས་སུ་འཇལ་བར་མི་མཛད་པ་དང་།",
    "བདག་ཉིད་ཀྱི་ཡོན་ཏན་རྗེས་སུ་གཟིགས་པ་ན་རྒྱགས་པ་དང་།",
    "ཡོན་ཏན་དེ་དག་བག་ཆགས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དང་བཅས་པའི་ཉོན་མོངས་པ་ཐམས་ཅད་ཡང་དག་པར་བཅོམ་པའི་ཕྱིར་ཉོན་མོངས་པའི་བག་ལ་ཉལ་དང་མི་ལྡན་པ་དང་།",
    "ཆོམ་རྐུན་པ་དག་གིས་མི་འཕྲོགས་པའི་ཕྱིར་དང་།",
    "གཞན་གྱི་དོན་ལ་མི་བལྟ་བའི་ཕྱིར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གཞན་གྱི་དོན་ལ་གཟིགས་པའི་ཕྱིར་ཐུགས་རྗེ་དང་བཅས་པ་དང་།",
    "འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་ཕུན་སུམ་ཚོགས་པ་ཐམས་ཅད་ནི་རང་གི་སྐྱེས་བུའི་བྱེད་པ་ལ་རག་ལས་པ་ཡིན་པའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གལ་ཏེ་ལྷ་ཉིད་དུ་འགྱུར་བའི་ལས་ཀྱིས་ཡིན་ན་ནི་དེས་ན་རང་གི་ལས་ཉིད་སྐྱབས་ཀྱི་འོས་ཡིན་གྱི།",
    "མོས་པའི་རྐྱེན་གྱིས་ཕན་བཏགས་པ་དང་།",
    "དེ་ལ་མ་མོས་པ་རྣམས་མོས་པར་བྱེད་པ་དང་།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འགག་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་མ་སྤངས་ཤིང་ཡོངས་སུ་མ་ཤེས་པས་ནི་ཀུན་ནས་ཉོན་མོངས་པ་རབ་ཏུ་ཕྱེ་བ་ཡིན་ལ།",
    "སློང་མོ་པའི་བསམ་པ་ཉིད་ཀྱིས་ཅི་འདོད་པ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "སློང་མོ་པ་ལ་ལྟོས་པ་ཉིད་ཅིག་ཅར་རམ་རིམ་གྱིས་སྦྱིན་པར་བྱེད་པ་དང་།",
    "རང་གི་ཞོ་ཤས་བསྒྲུབས་པ་དག་སྦྱིན་པར་བྱེད་པ་དང་།",
    "རང་གི་ལག་ནས་སྦྱིན་པར་བྱེད་པ་དང་།",
    "དེ་ལ་ལྟ་བ་རྣམ་པར་དག་པ་རྣམ་པ་བཅུ་ནི་འདི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བདག་ནི་སྦྱིན་པར་བྱེད་པའོ་བདག་གི་སྦྱིན་པའོ་སྙམ་དུ་རློམ་སེམས་མེད་པར་སྦྱིན་པར་བྱེད་པ་དང་།",
    "སོགས་འཇོག་གི་དྲི་མ་གཞན་ལ་མི་གཏོང་བས་སེར་སྣའི་དྲི་མ་དང་།",
    "བདག་ཉིད་ཡོངས་སུ་ལོངས་སྤྱོད་པར་མི་བྱེད་པ་ལས་སོགས་འཇོག་གི་དྲི་མར་རིག་པར་བྱ་བའི་དྲི་མ་བསྩལ་བའི་སེམས་ཀྱིས་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "སློང་མོ་འོངས་པ་ན་མཐོང་མ་ཐག་ཏུ་སེམས་རབ་ཏུ་དགའ་བ་དང་།",
    "སློང་མོ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སློང་མོ་པ་རྣམས་ཀྱི་མཇུག་ཐོགས་སུ་སྦྱིན་པར་བྱའོ་སྙམ་དུ་སེམས་ཤིང་སྦྱིན་པར་བྱ་བའི་དངོས་པོས་ཀུན་ཏུ་དགའ་བར་བྱེད་པ་དང་།",
    "ད་ནི་ཁྱོད་ལ་སྦྱིན་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ཚིག་ཀུན་ཏུ་རྗོད་པར་བྱེད་པ་དང་།",
    "སློང་མོ་པ་ལ་མངོན་སུམ་དང་ལྐོག་ནས་མི་སྨོད་མི་སྒྲོགས་པ་དང་།",
    "སློང་མོ་པ་ལ་མངོན་སུམ་དུ་སྨོད་པར་མི་བྱེད།",
    "སློང་མོ་པ་ལ་བརྟེན་པའི་ཤེས་པ་རྣམ་པར་དག་པ་དང་།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཕྱོགས་དྲུག་གིས་བཀབ་པ་ཉིད་ལ་བརྟེན་པའི་ཤེས་པ་རྣམ་པར་དག་པའོ།",
    "སློང་མོ་པའི་འདོད་པ་ཉིད་ཀྱང་ཟུར་ཙམ་གྱིས་ཤེས་པ་དང་།",
    "སློང་མོ་པ་རང་གིས་ཐུག་ཐུབ་དུ་བླངས་པ་ཐམས་ཅད་ལ་ཡང་རྗེས་སུ་གནང་བར་བྱེད་དོ།",
    "གཞན་དག་གིས་བསྒྲུབས་པའི་ལོངས་སྤྱོད་རྣམས་ཀྱིས་ཀྱང་སྦྱིན་པ་སྦྱིན་པར་བྱེད་དེ།",
    "དེ་ལ་བཞི་པས་ནི་ཅི་ནས་ཀྱང་སློང་མོ་པ་ལ་ཡང་ཀུན་ནས་ཉོན་མོངས་པར་མི་འགྱུར་བ་དང་།",
    "བདག་ཉིད་ཀྱང་ཀུན་ནས་ཉོན་མོངས་བ་ཅན་མ་ཡིན་པའི་སེམས་ཀྱིས་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "རང་གི་ཚལ་ཟ་རྣམས་ལ་འདི་ལྟ་སྟེ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སེར་སྣ་མེད་པ་སྦྱིན་པ་བྱེད་འདོད་པ་རྣམས་ལ་ནི་རང་གི་ལོངས་སྤྱོད་ཀྱི་བགོ་བཤའ་མི་བྱེད་པར་དེ་ལ་གྲོགས་བྱེད་དུ་འགྲོ་བ་དང་།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ལ་ཤེས་པ་རྣམ་པར་དག་པ་བཅུ་པས་ནི་ཕྱོགས་དྲུག་གིས་བཀག་ནས་སྦྱིན་པ་སྦྱིན་པར་བྱེད་དེ།",
    "སློང་མོ་པ་རྣམས་ལ་ཞེ་སྡང་གི་དྲི་མ་དང་བྲལ་བའི་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "རྒྱུ་དང་འབྲས་བུ་ལ་གཏི་མུག་གི་དྲི་མ་དང་བྲལ་བའི་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "གགས་བཞི་པོ་དེ་དག་གིས་གགས་ཀྱི་དྲི་མ་དང་བྲལ་བའི་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "དབུལ་པོས་རང་གི་ཚལ་ཟ་རྣམས་དང་།",
    "ལོངས་སྤྱོད་ཆེན་པོས་དེ་དག་དང་དེ་ལས་གཞན་པའི་སློང་མོ་པ་རྣམས་ལ་ཤིན་ཏུ་རྣམ་པ་ཕྱེ་ཞིང་མི་རིགས་པའི་དྲི་མ་དང་བྲལ་བའི་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "བསམ་པ་ཡོངས་སུ་རྫོགས་པ་ལས་ཡོངས་སུ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ནང་གི་དངོས་པོ་ཡང་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པའོ།",
    "དེ་ལ་བསམ་པ་ཡོངས་སུ་རྫོགས་པ་ནི་ནང་གི་ལུས་དང་ལོངས་སྤྱོད་དག་ལ་རང་བཞིན་གྱིས་ཆགས་པ་མེད་པའི་བསམ་པ་ཉིད་ཐོབ་པ་གང་ཡིན་པའོ།",
    "ནག་ནོག་མེད་པ་ལ་སོགས་པ་སའི་དངོས་གཞིར་བསྟན་པ་དག་གིས་ཡོངས་སུ་དག་ཅིང་།",
    "རྒྱུ་ལ་ཕྱིན་ཅི་མ་ལོག་པའི་བསམ་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སློང་མོ་པ་གཏུམ་པ་དང་།",
