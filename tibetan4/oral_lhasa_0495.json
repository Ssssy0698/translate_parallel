    "དེ་ལྟ་བུའི་སྲིད་པ་གསུམ་པོ་མ་ལུས་པ་འདི་ཡང་སྒྲིབ་པ་དང་བྲལ་བས་སྐུ་གསུང་ཐུགས་ཀྱི་རྡོ་རྗེ་རྣམ་པ་གསུམ་དུ་འགྱུར་ཏེ་ཨ་སོགས་ཐབས་དང་ཀ་སོགས་ཤེས་རབ་ཀྱི་རབ་ཏུ་དབྱེ་བས་ཤེས་པར་བྱའོ།",
    "འདིར་འགྲེལ་པ་ལས་བསྐལ་པའི་ཚད་གསུངས་པ།",
    "ཟླ་བ་དེ་བཅུ་གཉིས་ཀྱིས་ལོར་བྱས་པའི་ལོ་བརྒྱ་ལ་བསྐལ་ཆུང་ཞེས་བྱའོ།",
    "དེ་མི་ལོ་བརྒྱས་བསྒྱུར་བ་མི་ལོ་དུ་ཡིན་པ་སོགས་ཀྱང་རྩིས་ལམ་དུ་ཞིབ་པར་ཕབ་ན་ཤེས་པར་འགྱུར་ཏེ་འདིར་ཡི་གེར་འགོད་པ་ལ་དགོས་པ་ཆེར་མི་སྣང་ངོ།",
    "རབ་མཆོག་དུ་གཙང་བའམ་བདེ་བ་ཀུ་ཤ་ཞེས་བྱ་བའི་གླིང་དང་ནི།",
    "འདིར་གླིང་བཞི་པོ་ལ་དཔག་ཚད་སྟོང་ཕྲག་བདུན་དང་བརྒྱད་སོགས་གསུངས་པ་འདིར།",
    "གླིང་ཐམས་ཅད་ཀྱི་རྩ་བ་ཆུ་དཀྱིལ་ལ་ཟུག་པར་མཚུངས་པ་ལས།",
    "ཕལ་ཆེ་བས་ཚད་འདི་དག་ས་ཡི་སྟེང་དུ་གླིང་སོ་སོ་གྱེན་དུ་འཕགས་པའི་ཚད་ལ་བཞེད་པ་དེ་ལྟར་བྱས་ཀྱང་།",
    "འཇིག་རྟེན་གྱི་དཔང་ཚད་བཞི་འབུམ་དུ་གསུངས་པ་ལས་ལྷག་མི་དགོས་པ་འདྲ་སྟེ།",
    "གླིང་སོ་སོའི་ས་ཡི་སྟེང་དུ་རི་རྣམས་གྱེན་དུ་མཐོ་ཡང་དེ་བཞི་འབུམ་ལས་ལྷག་པར་བརྩི་མི་དགོས་པ་བཞིན་དང་།",
    "ཞེས་གསུངས།",
    "ཞེས་གསུངས།",
    "ཁ་ཅིག་འདིར་འཛིན་མ་ལ་འཛིན་པ་ཞེས་ཕོའི་རྟགས་སུ་བྱས་པའོ་ཟེར་ཀྱང་རྒྱ་དཔེའི་སྐྱོན་དེ་དེར་མ་ངེས་སོ་ཞེས་བཤད།",
    "དེ་ལྟར་འཇིག་རྟེན་ཁམས་དེའི་རི་རབ་ཀྱི་གཙུག་ཏོར་གྱི་དབུས་དྲང་པོ་ཚངས་པའི་ཡུལ་སའམ་ཚངས་པའི་གནས་སུ་བཅོམ་ལྡན་འདས་དུས་ཀྱི་འཁོར་ལོ་བཞུགས་ཏེ།",
    "ཞིང་དང་ཉེ་ཞིང་ལ་སོགས་པར་དཔའ་བོ་དང་རྣལ་འབྱོར་མ་རྣམས་བཞུགས་པར་གྱུར་ནའང་འགལ་བ་ག་ལ་ཡོད་དེ།",
    "བྱང་སེམས་དང་ཚངས་པ་ཆེན་པོ་སོགས་ལྷ་ཡི་ཚོགས་ཀྱིས་ཡང་དག་པར་མཆོད་ཅིང་བསྟོད་པ་སྟེ།",
    "དེ་བཞིན་དུ་ཞིང་དང་ཉེ་བའི་ཞིང་ནི་ལན་ཚྭའི་རྒྱ་མཚོའི་ཕྱེད་སྔ་མའི་ཕྱོགས་དང་མཚམས་སུ་ཤེས་པར་བྱའོ།",
    "དྷྲུ་ཞེས་པ་མིའི་དབུགས་སུམ་ཅུ་ལ་དབུགས་གཅིག་ཏུ་བྱས་པའི་མིང་སྟེ།",
    "ནུས་པ་ཞེས་གཟུགས་ཁམས་འོག་མིན་པར་སྐྱེས་པ་རྣམས་ཀྱིའོ།",
    "ཞེས་སྔ་འགྲེལ་རྣམས་སུ་གསུངས་སོ།",
    "ཕྱི་རོལ་དུ་ནི་ལོ་ས་ཡ་བཞི་དང་སུམ་འབུམ་ཉི་ཁྲིའི་གྲངས་དེས་ཕྱི་རོལ་གྱི་དུས་བཞི་ཆེན་པོའི་ཚད་རྫོགས་པར་འགྱུར་རོ།",
    "ཕྱི་རོལ་དུ་ཞག་དང་ཕྱོགས་ལ་སོགས་པ་དུས་བཞིའི་བར་རྫོགས་ཚུལ་སྦྱར་ཏེ་ཤེས་པར་བྱའོ།",
    "དེ་ཡང་པད་དཀར་ཁྲིར་བཞུགས་པ་ནས་ཤིན་ཏུ་བཟང་པོའི་བར་རིགས་ལྡན་བརྒྱད་ཀྱི་ཁྲིར་བཞུགས་ཀྱི་ལོ་བརྒྱད་བརྒྱ་རྫོགས་པ་ནའོ།",
    "སྐྲ་ཅན་གྱི་སྐར་རྩིས་ཀྱི་གྲུབ་པའི་མཐའ་སྟེ་འདི་བཞི་རྣམ་པར་ཉམས་པ་ནི།",
    "གྲུབ་པའི་མཐའ་རྣམས་རྣམ་པར་ཉམས་པ་ཞེས་གསུངས་ཏེ།",
    "དོན་ལ་དུས་ཀྱི་སྦྱོར་བ་ལས་ཞེས་པར་འགྱུར་རོ།",
    "མུ་སྟེགས་རྣམས་ཀྱི་ཉུང་ངུའི་བྱེད་པ་ནི་ཡང་དག་པར་གསལ་བ་མ་ཡིན་ཏེ།",
    "དེ་ཐམས་ཅད་ཉི་མའི་ལོངས་སྤྱོད་ལ་ལྟོས་ནས་དག་པར་བསྒྲུབ་དགོས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་གཟའ་རྣམས་ཀྱི་དབྱངས་ཀྱི་དཀྱིལ་འཁོར་དང་རིགས་དང་ནུས་པ་བྱེད་ལས་ཞི་དྲག་སོགས་དང་དེ་ལ་སྐྱེས་པ་དང་ལས་བརྩམ་པའི་འབྲས་རྩིས་བསྟན་པ་དོན་མེད་པར་འགྱུར་ཏེ་གཟའ་མ་དག་པ་ལ་གཟའ་དེ་དང་དེར་བཟུང་བའི་འབྲས་བུ་འོང་བ་སྲིད་པ་མ་ཡིན་ནོ།",
    "དེ་ཡང་མུ་སྟེགས་རྣམས་ཀྱིས་གཟའི་ལོངས་སྤྱོད་རྣམ་པར་དག་པ་ཉིད་དུ་མི་གསལ་བ་བྱེད་རྩིས་འདི་ཅིའི་ཕྱིར་བཀོད་ཅེ་ན།",
    "མུ་སྟེགས་པའི་བྲམ་ཟེ་གདུག་པ་ཅན་རྣམས་ཀྱི་སྐར་རྩིས་ཀྱི་གྲུབ་པའི་མཐའ་ལས་གཟའ་རྣམས་ཀྱི་བགྲོད་པ་གསལ་བ་འདི་ལེགས་པར་བཀོད་ན།",
    "བདག་ཅག་ལ་གུས་པར་མི་འགྱུར་བས།",
    "རྒྱུད་ཀྱི་བྱེད་པ་ལ་སོགས་པ་བྱའོ་ཞེས་གྲོས་བྱས་ནས་གྲུབ་པའི་མཐའ་རྣམས་སྦས་ཤིང་།",
    "བྱེད་པ་ལ་ཡང་དལ་མྱུར་སོགས་ཀྱི་སྤྲོས་པ་བྱས་སོ།",
    "ཐོག་མར་ལོ་གང་ནས་མགོ་བཟུང་སྟེ་བརྩི་བའི་ལོ་དག་གསུངས་ཏེ།",
    "རྒྱ་མཚོ་རྣམ་རྒྱལ་ཁྲིར་བཞུགས་ཀྱི་ལོ་དེ་རྣམས་ཕྲི་བ་ཡིན་ཏེ་ཅིའི་ཕྱིར་ན་རྒྱ་མཚོ་རྣམ་རྒྱལ་ཁྲིར་ཕེབས་པའི་ལོ་དེ་ལ་ཕྱི་རོལ་བ་ཀླ་ཀློའི་སྟོན་པ་བདུན་པས་བྱེད་པའི་རྩིས་མགོ་ཐོག་མར་ཟུག་པ་ཡིན་པའི་དེ་ནས་མགོ་བརྩམ་སྟེ་སྟོན་པ་ཡིན་ནོ།",
    "རྒྱ་མཚོ་རྣམ་རྒྱལ་ཁྲིར་ཕེབས་པའི་ལོ་དང་པོ་ཕྱི་རོལ་པའི་བྱེད་པའི་རྩིས་མགོ་ཟུག་པ་ནས་བརྩམ་སྟེ།",
    "བྱེད་རྩིས་མགོ་ཟུག་པ་ནས་དེའི་བར་ལ་ལོ་བཞི་བརྒྱ་དང་གསུམ་ཡོད་པས་མེ་མཁའ་རྒྱ་མཚོ་ཞེས་དོན་དུ་རྒྱ་མཚོ་རྣམ་རྒྱལ་དང་རྒྱལ་དཀའི་ཁྲི་བཞུགས་ཀྱི་ལོ་གྲངས་བསྡོམ་པའོ།",
    "དེ་ལ་ད་ལྟའི་ལོ་དེའི་ནག་པ་ལ་སོགས་པ་འདས་པའི་ཟླ་བ་བསྲེས་ཏེ་གནས་སྟེང་འོག་གཉིས་སུ་བྱས་ཏེ་བཞག་ལ།",
    "དེ་ཉིད་མཁའ་མེ་ཟླ་བས་ཏེ་བརྒྱ་དང་སུམ་ཅུས་རྣམ་པར་དབྱེ་བའམ།",
    "གནས་འོག་མ་ལ་དགུ་དང་ཡོན་ཏན་རྣམས་ཀྱིས་ཆ་ཇི་ཐོབ་པར་ཞེས་གནས་འོག་མ་སུམ་ཅུ་རྩ་དགུས་བགོས་ཐོབ་ལ།",
    "སོ་དགུས་ཐོབ་པའི་སྟེང་ནས་གཅིག་ཕབ་དྲུག་ཅུར་བྱས་པ་ལ་སྦྱང་ལྷག་ཆུ་སྲང་།",
    "དེ་ལྷག་བཅུ་གསུམ་གྱིས་བསྒྱུར་སོ་དགུས་ཐོབ་པས་དབུགས་ལས་གཅིག་ཕབ་པ་བཅུ་གསུམ་བྱས་པར་སྦྱང་ལྷག་འདོད་ཆའོ།",
    "སླར་ཡང་རགས་རྩིས་ལས་ཀྱང་རགས་པའི་མགྱོགས་རྩིས་གང་ཞིག་ཟླ་བ་སྔ་མའི་དྷྲུ་པ་ལ་བྱིན་ན་ཕྱི་མའི་དྷྲུ་བ་འཆར་པའི་བྱ་སླ་བྱིས་པ་རྣམས་ཀྱིས་རྟོགས་ཕྱིར་གསུངས་པ།",
    "གཟའ་ལ་སྟེ་གཟའི་གནས་སུ་གཟའ་གཅིག་ནི་རབ་ཏུ་སྦྱིན་པར་བྱའོ།",
    "མི་བདག་ཉིས་འགྱུར་ནི་སོ་གཉིས་ཏེ་དེ་ཆུ་ཚོད་རྣམས་ལ་སྦྱིན་པར་བྱས་ཏེ།",
    "ཉི་མའི་སྐར་མར་གཉིས་དང་ཆུ་ཚོད་དུ་དྲག་པོ་ནོར་དུ་རབ་གསལ་ཏེ་ངེས་པར་ཉི་མའི་ལོངས་སྤྱོད་དག་ལ་རབ་ཏུ་སྦྱིན།",
    "ད་ནི་ཟླ་བའི་ངེས་པ་ལས་ཚེས་ལ་སོགས་པའི་ལྔ་བསྡུས་ཀྱི་རྩིས་གསུངས་པ།",
    "མི་མཉམ་ཐོབ་པ་དག་ལ་རིམ་པ་ལྟར་མཉམ་པར་སྦྱིན་པ་དང་།",
    "མི་མཉམ་པ་ལ་དོར་དགོས་པ་ཡིན་པར་ཤེས་པར་བྱ་ཞིང་སྦྱིན་དོར་བྱ་རྒྱུ་ནི་འཆད་འགྱུར་རྐང་སྡོམ་སོགས་ཡིན་ནོ།",
    "ཞིབ་པར་བརྩིས་ན་གཟའ་ལ་ཚེས་བྱིན་ཆུ་སྲང་ནས་ང་དྲུག་དང་།",
    "ཟླ་བའི་ངེས་པའི་སྐབས་སུ་སྐྱོན་དེ་བཏོན་པས་སོས་པར་འགྱུར་བ་དང་།",
    "བཅུ་གསུམ་ཡོད་ན་ཕྱི་རྐང་དྲུག་པར་ཟིན་པས་སླར་སྤྱོད་རྒྱུ་ལྔ་དང་།",
    "ཟླ་བའི་རྐང་པར་ཞེས་གཅིག་ལྷག་ན་སྔ་རྐང་དང་པོའི་འོག་ཏུ་ཟིན་པས་སྤྱོད་ཟིན་ལྔ་རྐང་བསྡོམ་གྱི་གནས་སུ་བྲི་བར་བྱ་སྟེ།",
    "ལྔ་དང་བུག་པར་ཉི་ཤུ་རྩ་གཉིས།",
    "ལྷག་བདུན་པར་གྱུར་ན་སྔ་ཕྱིའི་རྐང་མཚམས་སུ་ཟིན་པས།",
    "ཟླ་བའི་རྐང་རྩིས་ཀྱིས་དག་པར་བྱས་པའི་ཚེས་ཀྱི་ལོངས་སྤྱོད་དེ་ལ།",
    "སླར་ཡང་འཆད་འགྱུར་ལྟར་ཉི་མའི་རྐང་པ་སྦྱིན་དོར་གྱི་རབ་ཏུ་དབྱེ་བས་གསལ་བར་བྱས་པའི་ཉི་མའི་རྐང་པ་དག་ནི།",
    "ཉི་མ་ལ་སྦྱིན་བྱ་ཡིན་ན་ཚེས་དེ་ལའང་ནོར་དུ་འགྱུར་ཏེ་སྦྱིན་པར་བྱ་བ་དང།",
    "གཞན་ཕྱི་རྐང་ལ་ཡང་དེ་དག་ལྡོག་སྟེ་གཅིག་ནས་ལྔའི་བར་དུ་བཀོད་པར་བྱའོ།",
    "བསྒྱུར་བའི་ཚེས་གྲངས་དེ་གནས་གཉིས་བྱས་པའི་གཅིག་ལ།",
    "གནས་གཅིག་གསུམ་གྱིས་བགོས་པའི་རྙེད་པ་བསྲེས་པར་བྱ་བའོ།",
    "ཉི་མའི་རྟག་ལོངས་ཧཱུྃའདི་ཆུ་ཚོད་བཞི་དང་ཆུ་སྲང་ཉི་ཤུར་བྱས་པ་སྟེ།",
    "དག་པར་བརྩི་ན་ཚེས་གྲངས་གནས་གསུམ་བྱས་པའི་སྟེང་བཞི་དང་བར་མ་ཉེར་གཉིས་ཀྱིས་བསྒྱུར་ཏེ་དབྱུག་སྲང་དུ་བྱིན།",
    "འཁོར་ཕྱེད་དོར་ལྷག་སྐར་གནས་དྲུག་ཅུས་བསྒྱུར་ཆུ་ཚོད་བཅུག་ལ་མདའ་ཡོན་ཟླ་བས་ཐོབ་པས་རྐང་པ་འཛིན་པར་བྱའོ།",
    "གཞན་དུ་དེ་ལྟར་མ་བྱས་ན་རྐང་པའི་ལོངས་སྤྱོད་དག་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "འདིར་བྱེད་པ་ལ་བརྗོད་པའི་སྣོན་འབྲིད་གསུངས་པ།",
    "དེ་རྣམས་ལྷོ་བགྲོད་ཡིན་པས་བུ་ལོན་དུ་བྱས་ཏེ་ཕྲི་བར་བྱའོ།",
    "དེ་ནས་ཆུ་སྲིན་སོགས་དྲུག་ལ་ཡར་བཟློག་ནས་སྦྱིན་པར་བྱ་སྟེ།",
    "འཁྲིག་པའི་སྔ་མར་དྲུག་ཕྱི་མར་གསུམ་བསྣོན་པའི་བར་དུ་ཤེས་པར་བྱ་སྟེ།",
    "དེ་བཞིན་སེང་གེའི་བཞི་ཕྱེད་དུ་བྱས་པ་གཉིས་ལ་སྔ་མའི་དྲུག་བསྣན་པས་བརྒྱད།",
    "དེ་བཞིན་རིམ་པར་བརྩིས་ཏེ།",
    "ཁྲུམས་སྨད་དང་ནམ་གྲུའི་རྐང་པ་བརྒྱད་ཀྱིས་ཉ་ཡི་ཁྱིམ་རྫོགས་པའི་བར་དུ་ཤེས་པར་བྱའོ།",
    "ཞེས་གསུངས་སོ།",
    "ཉི་མའི་རྐང་རྩིས་བྱས་པས་ཉིན་ཞག་སོ་སོའི་ཉི་མ་དག་པ་ཤེས་པའི་ཕྱིར་རོ།",
    "དུས་ཀྱི་འཁོར་ལོ་རྩ་བའི་རྒྱུད་ལས་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་ཉིན་ཞག་དང་ཆུ་ཚོད་དང་ཆུ་སྲང་དང་དབུགས་དང་ཁྱིམ་གྱི་འཁོར་ལོ་ལོངས་སྤྱོད་པའི་མཐར་ཐུག་པར་གསུངས་པ་འདི་ལྟ་སྟེ།",
    "དབུགས་སུ་བྱས་ནས་རྣམ་གསུམ་སླར།",
    "བགྲོད་པར་འགྱུར་གྱི་བར་དུ་སྦྱིན།",
    "དཀྱིལ་འཁོར་གྱི་ནི་རྣམ་པར་དབྱེ།",
    "དེ་ཉིད་སྦྱིན་པ་བྱས་ནས་ནི།",
    "བགྲོད་པས་ཉི་མ་སྦྱང་བྱས་ཏེ།",
    "འདི་ལས་མ་དག་རྣམ་པར་སྤངས།",
    "ད་ནི་ཉིན་མཚན་འཕེལ་འགྲིབ་གསུངས་པ་འདི་ལྟར།",
    "ཀེ་ལ་ཤའི་ལྷོ་ཕྱོགས་ལ་ནི་འཆད་པར་འགྱུར་རོ།",
    "དེ་ནས་སྒྲ་གཅན་རྒྱུ་སྐར་ལ་ལོངས་སྤྱོད་པ་གསུངས་པ།",
    "སྒྲ་གཅན་དེའི་སྐར་གནས་ཀྱིས་ཉེར་བདུན་ལ་ཕྲིས་ནས་ཆུ་ཚོད་ལ་སོགས་པས་སྟེང་ནས་རང་འཁོར་ཕབ་པ་ལ་རིམ་བཞིན་ཕྲི་བར་བྱས་པའོ།",
    "དེ་ལ་བཀྲ་ཤིས་ཀྱི་དཀྱིལ་འཁོར་རི་ཀླུ་དུས་ཀྱིས་ཞེས་ཉིན་ཞག་དྲུག་བརྒྱ་བརྒྱད་ཅུ་རྩ་བདུན་གྱིས་བགོས་པ་ཡི་ཐོབ་པ་ནི་ཞག་འདི་ཙམ་གྱིས་མིག་དམར་གྱིས་རྒྱུ་སྐར་འཁོར་ལོ་ཡོངས་སུ་བསྐོར་བའམ་འཁོར་ཟིན་པ་སྟོན་པ་ཡིན་པར་ཤེས་ནས་ཐོབ་པ་དེ་ཉིད་དོར་བར་བྱའོ།",
    "སྐར་གནས་སུ་འཁོར་ལོ་བསྲེས་ལ་རྣམ་པར་སྦྱང་བར་བྱའོ།",
    "སྦྱང་ལྷག་དེ་འཁོར་ལོ་ཕྱེད་དེ་འདི་ལས་ལྷག་པར་ཏེ་མང་བར་གྱུར་ནའང་འཁོར་ལོ་ཕྱེད་ནི་དོར་བར་བྱ་སྟེ་དོར་བའི་ལྷག་མ་ལ་ནི་རྐང་པ་རིམ་མིན་དུ་འཛིན་དགོས་པར་འགྱུར་ཞིང་།",
    "ཡང་ན་སྔ་རྐང་ལ་ཟོས་པ་དང་ཕྱི་རྐང་ལ་དེ་སྔ་མ་ཟོས་པ་ཚོགས་གཅིག་ཏུ་བསྡོམ་པར་བྱས་ནས།",
    "དེ་ཡང་བཟུང་བྱ་མྱུར་རྐང་ནི་ས་སྐྱེས་མིག་དམར་ལ་ནི་རྐང་པ་རྒྱལ་བ་སྟེ་རྐང་གནས་དང་པོ་ལ་ཉེར་བཞི་སོགས་ཡིན་ཏེ་རབ་གསལ་མ་ནུའི་གནས་ཞེས་རྒྱུ་སྐར་བཅུ་བཞིའི་གནས་ལ་རྐང་པ་དེ་མཐའ་དག་བཞག་པར་བྱའོ།",
    "དེ་ལྟར་གཟའ་རྣམས་ཐམས་ཅད་ཀྱི་ནི་རིམ་པར་རིགས་བསྒྲེས་ཏེ་མྱུར་བའི་ཆོ་ག་ཡོངས་སུ་བརྩི་བ་རིག་པར་བྱའོ།",
    "བཀྲ་ཤིས་ཀྱི་མྱུར་བ་ལ་གཞི་བྱས་ནས་གཟའ་གཞན་གྱི་མྱུར་དག་བྱ་ཚུལ་གསུང་ནས།",
    "དེ་ནས་ཕུར་བུ་གསུངས་པ།",
    "སླར་ཡང་མྱུར་བ་དག་ལ་རྐང་པ་རབ་གསལ་མ་ནུའི་གནས་ལ་ཕྱོགས་ཏེ་བཅུ་དང་པོར་བྱས་པའི་རྐང་པ་ལ་སོགས་པ་དེ་དག་གོ།",
    "པ་སངས་ཀྱི་རྐང་པའི་ལོངས་སྤྱོད་གསུངས་པ།",
    "དཀར་པོའི་སྐྱེས་ཁྱིམ་རྒྱུ་སྐར་དུས་ཏེ་དྲུག་ནི་པ་སངས་ཀྱི་དལ་བ་ཉིད་དུ་མྱུར་བ་ཉི་མ་ཡི་དལ་བ་ལ་སྦྱངས་ནས་མདའ་དུས་རི་བོང་ཅན་ཏེ་རྐང་གནས་དང་པོར་ལྔ་གཉིས་པར་བཞི་གསུམ་པར་གཅིག་སྔ་རྐང་དང་ཕྱི་རྐང་ལ་གསུམ་པོ་བཟློག་སྟེ་བཀོད་པའི་རྐང་གནས་དྲུག་ནི་པ་སངས་ཀྱི་དལ་བའི་ལས་ལ་རྐང་པ་སྟེ།",
    "གཉིས་པར་བརྒྱ་སོ་གཅིག་ལས་མི་སྤྱོད་པས་བཞིས་འབྲིད།",
    "གསུམ་པར་བརྒྱ་སོ་བཞི་ལས་མི་བགྲོད་པས་གཅིག་འབྲིད།",
    "བཞི་པ་ནས་འཕེལ་ཏེ་བཞི་པར་བརྒྱ་སོ་དྲུག་བགྲོད་པས་སྣོན་བྱེད་རྐང་པའི་བཞི་ཆ་གཅིག།",
    "ལྔ་པར་བརྒྱ་སོ་དགུ་སྤྱོད་པས་བཞི་སྣོན།",
    "དྲུག་པར་བརྒྱ་བཞི་བཅུ་སྤྱོད་པས་ལྔ་སྣོན་པའོ།",
    "དྲུག་པར་བརྒྱ་དང་བདུན་བགྲོད་པའི་བར་རོ།",
    "འདི་སྐོར་ལ་ཞེས་བདུན་པའི་དོན་ལ་ལས་ཞེས་ལྔ་པ་བྱས་པ་དུ་མ་ཡོད་པ་ཤེས་པར་བྱའོ།",
    "སྤེན་པའི་དལ་བ་གསུངས་པ།",
    "ཆུ་ཚོད་ཀྱང་སྔར་ལྟར་བྱས་ལ་སྤེན་པ་ཡི་ནི་དོར་བྱ་སྐྱེས་ཁྱིམ་སྦྱང་བ་དག་ཀྱང་སྐར་མ་བཅོ་བརྒྱད་དོ།",
    "གཟའ་རྣམས་ཀྱི་འགྲོས་བཞི་གསུངས་པ།",
    "འདིར་ཉི་མ་ལས་ཤར་ནས་རིམ་པར་བགྲོད་པ་ལ་ཕྱེད་སྔ་མའི་བར་དུ་རྐང་པའི་ནོར་འཕེལ་བས་དལ་བ་ལས་ཆེས་མང་བས་མྱུར་འགྲོས་སོ།",
    "ཕྱེད་ཕྱི་མ་ནས་ཉི་མའི་རྒྱུ་སྐར་ལ་རབ་ཏུ་ཞུགས་ཀྱི་བར་དུ་བུ་ལོན་འགྲིབས་པས་དལ་བ་དང་མཉམ་པར་རྒྱུ་བ་འབྱུང་འགྲོས་སོ།",
    "དེ་ནས་ཉི་མར་ནུབ་སྟེ་སླར་ཡང་འཆར་བའི་རིམ་པ་དེ་ཉིད་ཀྱིས་རིག་པར་བྱའོ།",
    "གཟའ་ལྔའི་འཆར་ནུབ་ནི་བཀྲ་ཤིས་ལ་སོགས་པའི་གཟའ་གང་དག་སུ་ཞིག་ཉི་མའི་ལོངས་སྤྱོད་ལ་ནི་རབ་བཞུགས་གཟའ་དེ་དག་ཀྱང་ངེས་པར་ཉི་མའི་འོད་ཀྱིས་བསྒྲིབ་ནས་ཉི་མ་ལ་ནུབ་པར་འགྱུར་ཏེ་མི་མཐོང་ངོ།",
    "གཟའ་བཀྲ་ཤིས་ལ་སོགས་པ་དེ་ཡི་ལམ་ཡང་ཉི་མས་ལྷོ་དང་བྱང་དུ་བགྲོད་པ་གངས་ཅན་དང་མེ་ཡི་བར་དུ་ཕྱེད་དང་བཅས་པའི་ཉིན་ཞག་གྱ་གཉིས་ཀྱིས་འགྲོ་བའི་རྣམ་པར་དབྱེ་བས་གཉིས་སུ་ཡོད་པ་དེ་བཞིན་དུ་ཤེས་སོ།",
    "གལ་ཏེ་ཞིང་དེ་ལ་དེ་ཡི་དགྲ་དག་འོང་བར་འགྱུར་ན་ངེས་པར་རྩོད་ཅིང་འཐབ་པའོ།",
    "ཕན་ཚུན་འཐབ་པ་སོགས་གཞན་ལའང་གོང་ལྟར་ཤེས་པར་བྱའོ།",
    "ཁྱིམ་དང་སྐར་མ་གཞན་འདིར་ནི་དགྲ་ཟླ་དེ་དག་ཀྱང་ཕན་ཚུན་གཉིས་ཀ་ལྷན་ཅིག་ཏུ་འཐབ་པ་མེད་པར་མཚུངས་པ་དག་ཏུ་ལྡན་པར་འགྱུར་རོ།",
    "ད་ནི་ཉི་ཟླ་ལ་སྒྲ་གཅན་འཇུག་པ་གསུངས་ཏེ།",
    "ཟླ་བའི་གཡོན་ཏེ་བྱང་དུ་སྒྲ་གཅན་རྒྱུ་བའམ་བགྲོད་པ་དག་ལ་ཟླ་བའི་གཡས་མིན་དུ་སྟེ་བྱང་ཕྱོགས་ནས་འཛིན་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་རྣམ་པར་དཔྱད་པར་བྱ་སྟེ།",
    "མུ་སྟེགས་པའི་འདོད་པ་དེ་ལྟར་ན་གཟའ་རྣམས་ཉི་མའི་དཀྱིལ་འཁོར་ལ་འཆར་བ་དང་ནུབ་པ་འདི་ནམ་ཡང་མི་སྲིད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་དོན་དམ་པར་གཟའ་རྣམས་ཀྱི་གནས་ཐ་དད་པ་གཞན་པ་མེད་དོ་ཞེས་པའི་དོན་དམ་ནི་བདེན་གཉིས་སུ་ཕྱེ་བའི་དོན་དམ་ལ་གོ་དོན་ཅི་ཡང་མེད་དེ།",
    "ཡང་དག་པར་ན་གོ་ལ་ཁྱིམ་བཅུ་གཉིས་པོ་འདི་ལ་གཟའ་རྣམས་རང་འགྲོས་ཀྱིས་བགྲོད་པ་ལས་གཟའ་སོ་སོའི་གནས་ཀྱི་གོ་ལ་རི་རབ་ལ་ཉེ་རིང་དུ་གྱུར་པ་གང་ཡང་མེད་དོ་ཞེས་པའོ།",
    "གསུམ་པར་པ་སངས།",
    "བཞི་པར་ཉི་མ།",
    "ལྔ་པར་མིག་དམར།",
    "དྲུག་པར་ཕུར་བུ།",
    "བདུན་པར་སྒྲ་གཅན།",
    "བྱང་བགྲོད་མཐར་ཐུག་པའི་ཁྱིམ་དེ་དབུས་སུ་བྱས་པའི་བྱང་དུ་གནས་པའི་ཁྱིམ་དྲུག་དེ་ནི་བྱང་དུ་བསིལ་བའི་རི་ལ་ཉེ་བ་སྟེ།",
    "དེས་ན་གླིང་འདིར་དགུན་ཉི་ལྡོག་པའི་སྐར་མ་ཡོད་པའི་ཁྱིམ་དེ་ནི་མདུན་གྱི་གླིང་བདུན་པ་བྱང་གླིང་དབུས་མའི་སྟེང་དུ་བསིལ་རི་ལ་ཉེ་བ་པད་འདབ་ཀྱི་རྣམ་པར་དབུས་ཀྱི་ཆར་གནས་སོ།",
    "དེ་ཡི་ཕྱི་ཐིག་བཅུ་གཉིས་ཀྱང་རྒྱ་མཚོའི་བཞི་ཆ་དང་མཉམ་པར་བྱས་པའི་ལན་ཚའི་རྒྱ་མཚོ་དང་མེ་རིའི་མཚམས་སུ་སླེབས་པ་ནི།",
    "ཅེས་གསུངས་པའི་དོན་ཡིན་ལ།",
    "སྐར་མ་ཕལ་པ་མང་པོའི་གནས་ཡུལ་དུ་ཤེས་པར་བྱ་སྟེ།",
    "གོ་ལ་བཅུ་གཉིས་པོ་ནང་ནས་ཕྱིར་མུ་ཁྱུད་བཞིན་དུ་རིམ་པར་ཡོད་པའམ་སྟེང་ནས་སྟེང་དུ་རྨོག་བརྩེགས་པ་ལྟ་བུ་མ་ཡིན་པར།",
    "དེའི་སྔ་མ་དང་ཕྱི་མར་གནས་པའི་སྐར་མ་རྣམས་ཕར་ཕར་མེ་དཀྱིལ་ལ་ཕྱོགས་པར་གནས་པར་འགྱུར་ཏེ།",
    "མཉམ་གཉིས་ཀྱི་སྐར་མ་བཅུ་གཉིས་བཅུ་གཉིས་སུ་ཤེས་པར་བྱའོ།",
    "ཁོ་བོས་བྱས་པའི་གོ་ལ་དྲུ་འཛིང་མའི་ཐིག་རིས་ལ་བལྟས་པས་གསལ་ལོ།",
    "འདིའི་ཐད་ནས་དཔྱིས་ཕྱིན་པར་ཤེས་པ་སྔར་ཡང་དཀོན་པར་སྣང་ངོ།",
    "ད་ནི་དཀྱུས་ཀྱི་ཚིག་དོན་ལ་འཇུག་པར་བྱ་སྟེ།",
    "འཆར་ས་དེ་དང་དེ་ཡིན་པ་ཤེས་པར་བྱེད་དོ།",
    "ཟླུམ་སྐོར་གྱི་དབུས་ཕྱེད་མར་བྱས་པའི་དཀྱིལ་དྲང་པོར་མཉམ་གཉིས་ཀྱི་ཁྱིམ་བཀོད།",
    "ནུབ་ཀྱི་ཕྱེད་ཕྱི་མར་སྲང་ལ་སོགས་པ་རིམ་པར་བཀོད་པ་ལ་བརྟེན་ནས་དུས་ཀྱི་བགྲོད་པ་རྣམས་ཤེས་པར་བྱའོ།",
    "ལུག་ཤར་བ་ན་སྲང་ནུབ་པ་སོགས་ཤར་བ་ནས་བརྩིས་པའི་ཁྱིམ་བདུན་པ་ནུབ་པར་ཤེས་པར་བྱའོ།",
    "ཞེས་གསུངས་སོ།",
    "ཤམ་བྷ་ལའི་བྱང་གངས་ལྡན་ཏེ་དུམ་བུ་དྲུག་པར་ལྔ་ཞེས་བཤད།",
    "ཞེས་མཁས་གྲུབ་རྗེས་གསུངས་པ་ལེགས་ཏེ།",
    "ཞིབ་ཏུ་ས་སོ་སོའི་ལྡོག་གཉིས་སོགས་ཐུར་གྲིབ་ཀྱིས་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་ཕན་ཚུན་ལྟོས་པ་ཤེས་པར་བྱས་ནས།",
    "བདུན་པ་ཕན་ཚུན་མཉམ་པ་དེ་ཡི་ཕྱིར་དུམ་བུ་དང་པོ་གླིང་འདིར་བྱས་ནས་གཡས་སྐོར་གྱིས་བགྲང་བས་དུམ་བུ་གཉིས་པ་ལྷོ་ནུབ་ཀྱི་གླིང་སྟེ་ལྷོའི་གླིང་གཡོག་ནུབ་མ་དང་།",
    "ཉི་མ་སེང་གེ་དང་བུམ་པར་རབ་ཏུ་ཞུགས་པས་སོ།",
    "དེ་བཞིན་དུ་གཡས་བསྐོར་གྱིས་བུམ་པར་ཉི་མས་བགྲོད་ཚེ་སའི་དུམ་བུ་གཉིས་པ་ལ་བྱང་དུ་བགྲོད་པར་བྱེད་དོ།",
    "ཉ་ལ་དུམ་བུ་གསུམ་པར་རོ།",
    "འཁྲིག་པར་ཉི་མ་གནས་པས་ས་ཡི་དུམ་བུ་ནི་དྲུག་པ་དང་།",
    "ས་ཡི་དུམ་བུ་བདུན་པར་ཡང་ཉི་མ་ཀརྐ་ཊ་ལ་གནས་པས་འགྱུར་ཏེ།",
    "སེང་གེ་ལ་གནས་པས་ས་ཡི་དུམ་བུ་བརྒྱད་པར་རོ།",
    "གཞུ་ལ་ཉི་མ་གནས་པས་ལྷོ་གླིང་ཤར་མ་དུམ་བུ་བཅུ་གཉིས་པར་ཉི་མ་བྱང་དུ་བགྲོད་པར་འགྱུར་ཏེ།",
    "ད་ནི་གླིང་བདུན་པ་འཛམ་གླིང་ཆེན་པོའི་ས་ཡི་དཀྱིལ་འཁོར་ལ་ཉི་མ་སྟེང་དུ་འགྲོ་བའི་ཚད་གསུངས་པ།",
    "དེ་ནས་གཡས་ཕྱོགས་སུ་ལྷོར་བགྲོད་པ་ན་ཡང་རིམ་བཞིན་ཟད་པར་འགྱུར་ཏེ་ཇི་ཙམ་ཞེ་ན།",
    "སྟོང་ཕྲག་བཅུ་གཅིག་རིམ་པར་ཟད་ནས་ལྷོ་བགྲོད་མཐར་ཐུག་པ་དེ་དུས་གདུང་བྱེད་ས་ལས་སྟོང་ཕྲག་བདུན་ཅུ་རྩ་ལྔ་མཐོའོ།",
    "ད་ལྟ་ལྷོ་བགྲོད་མཐར་ཐུག་པའི་ཕྱི་རོལ་ན་སྐར་མ་ཡོད་པར་མངོན་སུམ་གྱིས་གྲུབ་པའི་ཕྱིར་རོ།",
    "གཞུ་འདོམ་ནས་རྡུལ་ཕྲ་རབ་ཀྱི་བར་དུ་རིམ་པར་བསྒྱུར་བགོད་བྱའོ།",
    "ཉི་མའི་འོད་ཀྱིས་ཇི་ཙམ་ཁྱབ་པ་གསུངས་པ།",
    "རི་ཡི་རྒྱལ་པོ་རི་རབ་དག་ནི་ས་དུམ་བུ་བཅུ་གཉིས་ལ་གནས་པའི་སྐྱེ་བོ་ཐམས་ཅད་ཀྱི་ཡང་བྱང་ན་གནས་པར་འགྱུར་རོ་མི་ཡི་བདག་པོ་ཟླ་བ་བཟང་པོ་ཞེས་བོད་པའོ།",
    "དེའི་ཕྱིར་ལྷོ་འཛམ་བུ་གླིང་ན་གནས་པ་རྣམས་ཀྱིས་ཤར་ན་ལུས་འཕགས་པོའི་གླིང་ཡོད་པར་བྱེད་དོ།",
    "ནུབ་བ་ལང་སྤྱོད་པ་རྣམས་ཀྱིས་འཛམ་བུ་གླིང་ཤར་ན་ཡོད་པར་བྱེད་དོ།",
    "སྒྲ་མི་སྙན་པས་བ་ལང་སྤྱོད་ཤར་ཕྱོགས་སུ་ཡོད་པར་བྱེད་དོ།",
    "ཡུད་ཙམ་ནི་ཐུན་ཚོད་ཀྱི་ཕྱེད་བཅུ་དྲུག་སླར་ཡང་ཕྱེད་མར་བྱས་པས་སོ་གཉིས་ཀྱིས་ཡུད་ཙམ་སོ་གཉིས་འཁོར་རོ།",
    "དེ་ལྟ་བུར་དུས་སྦྱོར་གྱི་དབྱེ་བས་ཕྱེ་བའི་དུས་དེ་རྣམས་རི་རབ་ལྷུན་པོའི་ཕྱོགས་རྣམས་སུ་ནི་རབ་ཏུ་གསལ་བའམ་ངེས་པར་ཉི་མའི་ཞེས་བཅུ་གཉིས་ཀྱི་ས་ལ་སྟེ།",
    "ཁ་ཤར་དུ་ཕྱོགས་པའི་གཟའ་བརྒྱད་པོ་རྣམས་ནི་རང་འགྲོས་ཀྱིས་རྒྱུ་སྐར་ལ་རིམ་པར་སྤྱོད་པས་རི་རབ་ལ་གཡོན་དུ་བསྐོར་བར་བྱེད་ལ།",
    "ཉ་ལུག་དག་འཆར་ཚད་གཅིག་པར་ཤེས་པར་བྱའོ།",
    "ལྷོ་ཕྱོགས་ཀྱི་དེ་གསུམ་ལ་བགྲོད་པ་གཉིས་མཐར་ཐུག་པའི་ཞག་ནས་ཕར་འགྲོ་ཚུར་འོང་བྱེད་པའི་ཁྱིམ་དེ་རྣམས་ས་དེར་ནམ་མཁའ་ལས་འཆར་བའི་ཚེ་རྒྱུ་སྐར་ཁྱིམ་གྱི་གོ་ལའི་ཆ་དེ་སྣེ་ནས་རིམ་པར་ཡོངས་རྫོགས་སུ་འཆར་བ་དང་།",
    "དེ་ཡང་སྤྱིར་རགས་པར་གླིང་འདིར་ལྷོ་ནས་བྱང་དུ་ཆ་དྲུག་བགོས་པའི་དུམ་བུ་ལ་ལྷོ་ནས་བྱང་དུ་རིམ་བཞིན།",
    "ཞིབ་ཏུ་མཎྜལ་ཁྲུ་གང་བ་སྟེང་མ་ཡོ་བར་བཞི་མཉམ་པའི་དབུས་སུ་ཐུར་ཤིང་མཐོ་གདབ་བཙུགས་ཏེ་ལྷོ་བྱང་དུ་བགྲོད་ཉེ་བའི་ཞག་བཅུའི་སྔ་ལོགས་ནས་བརྟག་པས་ཐུར་གྲིབ་ལོག་པར་གྱུར་པ་ལས་ཉི་མ་ལྷོ་བྱང་དུ་བགྲོད་པའི་ཞག་ངོས་བཟུང་ནས་དེ་ཡི་ཉི་སྐར་སོགས་ངེས་པར་བྱེད་པའི་ཚུལ་འདི་གོ་ལའི་ཐིག་རྣམས་དང་།",
