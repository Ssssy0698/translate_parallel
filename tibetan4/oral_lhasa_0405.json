    "དཔེར་ན་ཁྲུས་བྱས་ཏེ་བཟའོ་ཞེས་བྱ་བ་ལྟ་བུ་ཡིན་ནོ་སྔར་ཕྲད་ནས་ཕྱིས་སྐྱེ་བར་འགྱུར་བ་གང་ཡིན་པ་དེ་ནི་སྐྱེ་བའི་སྔོན་རོལ་ན་འགའ་ཡང་མེད་ལ།",
    "བྱེད་པ་པོ་དང་བྱ་བ་རྣམ་པར་འཇོག་པ་འདི་ཡང་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "གཞན་དག་ནི་ཀླན་ཀ་འདི་ཡོངས་སུ་སྤང་བར་བྱ་བའི་ཕྱིར་དོན་གཞན་དུ་ཡོངས་སུ་རྟོག་པར་བྱེད་དོ།",
    "འདི་སྐྱེ་བས་འདི་སྐྱེའོ་ཞེས་རྣམ་གྲངས་གཉིས་གསུངས་ཤེ་ན།",
    "ངེས་པར་གཟུང་བའི་དོན་ཏེ།",
    "ཡན་ལག་འདི་སྐྱེས་པས་ཡན་ལག་གཞན་སྐྱེའོ་ཞེས་ཡན་ལག་བརྒྱད་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "ད་ལྟར་གྱི་མཐའ་སྐྱེས་པས་ཕྱི་མའི་མཐའ་སྐྱེའོ་ཞེས་ཚེ་བརྒྱུད་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་རྟག་པར་སྨྲ་བ་དགག་པའི་ཕྱིར་རོ་ཞེས་ཟེར་ཏེ།",
    "རྟོག་པ་འདི་ལ་ནི་ཚིག་སྔ་མ་སྨོས་པ་དོན་མེད་པར་འགྱུར་ཏེ།",
    "འོ་ན་ནི་གང་ལགས་བདག་རྟེན་དུ་གྱུར་པ་ཡོད་པས་འདུ་བྱེད་ལ་སོགས་པ་རྣམས་འབྱུང་ངོ།",
    "མ་རིག་པ་མ་སྤངས་ན་འདུ་བྱེད་རྣམས་མི་སྤོང་ལ་དེ་ཉིད་སྐྱེས་པས་སྐྱེ་བར་འགྱུར་རོ་ཞེས་མ་སྤངས་པ་དང་སྐྱེ་བར་འགྱུར་བ་རྒྱས་པར་བསྟན་པའི་ཕྱིར་རོ་ཞེས་ཟེར་རོ།",
    "རྒྱུ་ཉིད་སྐྱེས་པས་འབྲས་བུ་སྐྱེ་བར་འགྱུར་རོ་ཞེས་གནས་པ་དང་སྐྱེ་བ་ཡང་དག་པར་བསྟན་པའི་ཕྱིར་རོ་ཞེས་ཟེར་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་ཅིའི་ཕྱིར་རིམ་པ་མི་མཐུན་པར་སྔར་ནི་གནས་པ་དང་ཕྱིས་ནི་སྐྱེ་བ་གསུངས་པར་འགྱུར།",
    "འབྲེལ་བ་ཙམ་ཞིག་བསྟན་པར་བྱ་སྟེ།",
    "དེ་ནི་འདིའི་འདུ་བྱེད་ཀྱི་རྐྱེན་གྱིས་རྣམ་པར་ཤེས་པ་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་གང་ཞེ་ན།",
    "ཡང་རྣམ་པར་ཤེས་པ་སྔོན་དུ་འགྲོ་བའི་མིང་དང་གཟུགས་ཕུང་པོ་ལྔ་པོ་འགྲོ་བ་དེ་དང་དེར་སྐྱེ་བར་འགྱུར་ཏེ།",
    "རྣམ་པར་འབྱེད་པ་ལས་དེ་སྐད་བསྟན་པའི་ཕྱིར་རོ།",
    "དབྱུ་གུ་གསུམ་དང་སྒྲེ་བོ་ལ་སོགས་པ་ཡང་དག་པར་ལེན་པའོ།",
    "སྲིད་པའི་རྐྱེན་གྱིས་རྣམ་པར་ཤེས་པ་འཇུག་པའི་ཚུལ་དུ་མ་འོངས་པའི་སྐྱེ་བ་ནི་སྐྱེ་བ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་ཅི་ཡང་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "སྦྱོར་བ་ཞེས་བྱའོ་ཞེས་གསུངས་ཏེ།",
    "མེད་པ་ཙམ་ནི་དེ་ལྟ་བུ་ཡིན་པར་འོངས་པ་མ་ཡིན་ལ་མིག་ལ་སོགས་པ་ཡང་མ་ཡིན་ནོ།",
    "འོ་ན་ནི་གང་ལྟ་བའི་རང་བཞིན་མ་ཡིན་པ་དེ་ཡིན་པར་འགྱུར་རོ།",
    "དེ་ཡང་ཡིན་པར་མི་འོས་སོ།",
    "གལ་ཏེ་མ་རིག་པ་ཤེས་རབ་ཡིན་པར་གྱུར་ན་ཤེས་རབ་ཀྱི་རྫས་ཉིད་མཚུངས་པར་མི་ལྡན་པའི་ཕྱིར་ལྟ་བ་དེ་དང་མཚུངས་པར་ལྡན་པར་མི་འགྱུར་རོ།",
    "གང་རྣམ་པར་མི་འགྲོལ་བ་དེ་ནི་འདོད་ཆགས་ཀྱིས་དེ་ལྟར་ཉེ་བར་བཅོམ་པ་ཡིན་ལ།",
    "བག་ཆགས་རྣམ་པར་བཟློག་པ་ནི་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ།",
    "འདི་ལ་དཔྱད་པར་ཆད་ན་བརྗོད་པ་མང་པོར་གྱུར་ཏེ།",
    "ད་ནི་རིག་པ་བརྗོད་པར་བྱ་སྟེ།",
    "འདི་ལ་སློབ་དཔོན་རྣམས་ཀྱི་བློ་ཐ་དད་པར་གྱུར་ཏེ།",
    "རྣམ་པར་ཤེས་པའི་ཚོགས་དྲུག་དང་།",
    "སྲེད་པའི་ཚོགས་དྲུག་གོ་ཞེས་གསུངས་པ་ཡང་ཁྱེར་ཏེ་འོང་བར་བྱེད་དོ།",
    "དེ་ལྟ་བས་ན་གསུམ་བསྟན་ཟིན་པས་ཡང་རིག་པ་སྨོས་པ་ནི་དོན་མེད་པར་འགྱུར་རོ།",
    "དེ་ལྷག་པར་འདིའི་དམིགས་པ་ཡིན་པས།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་ནི་སྔོན་པོ་ཡང་རྣམ་པར་ཤེས་ལ་སྔོན་པོའོ་ཞེས་བྱ་བར་ཡང་རྣམ་པར་ཤེས་སོ་ཞེས་གསུངས་པ་ལྟ་བུ་སྟེ།",
    "གཉིས་པ་ནི་མཚུངས་པར་ལྡན་པས་རབ་ཏུ་ཕྱེ་བ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "རིག་པ་དང་མ་རིག་པ་དང་མཚུངས་པར་ལྡན་པའི་ཕྱིར་རོ།",
    "རྗེས་སུ་ཆགས་པ་དང་མཚུངས་པར་ལྡན་པའི་ཕྱིར་རོ།",
    "ཡིད་སྔ་ལ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཕྱི་བ་ཞེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པའོ།",
    "དེ་ལྟ་ན་ནི་རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ལ་ཚོར་བ་ཡོད་པར་མི་འགྱུར་ལ།",
    "འདི་ནི་རིགས་པ་མ་ཡིན་པར་འགྱུར་རོ།",
    "ཡང་ན་སེམས་གང་དང་མཚུངས་པར་ལྡན་པ་དེ་ལས་གཞན་པ་ལ་དམིགས་པར་འགྱུར།",
    "ལྷན་ཅིག་སྐྱེས་པ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་བས་ན་ཚོར་བ་ལ་སོགས་པ་དག་ཀྱང་མ་འདྲེས་པའི་རྣམ་པར་ཤེས་པ་ནི་མེད་དོ།",
    "གང་མྱོང་བར་བྱེད་པ་དེ་སེམས་པར་བྱེད་དོ།",
    "གང་སེམས་པར་བྱེད་པ་དེ།",
    "འདུས་ཏེ་ཤེས་པར་བྱེད་དོ།",
    "གང་འདུས་ཏེ་ཤེས་པར་བྱེད་པ་དེ་རྣམ་པར་ཤེས་པར་བྱེད་དོ་ཞེས་གསུངས་ན།",
    "འོན་ཏེ་སྐད་ཅིག་མ་ལ་ངེས་པར་གསུངས་པ་དེ་མི་ཤེས་སོ།",
    "ཚེ་དང་དྲོད་དག་ལྷན་ཅིག་པ་ལ་འདྲེས་པ་ཞེས་གསུངས་པའི་ཕྱིར་སྐད་ཅིག་མ་ལ་ངེས་པ་ཡིན་པར་གྲུབ་བོ།",
    "ཡང་སེམས་ལས་བྱུང་བའི་ཚོར་བ་དེ་ཉིད་ཡིད་ཀྱི་ཉེ་བར་རྒྱུ་བ་བཅོ་བརྒྱད་རྣམ་པར་གཞག་པ་ལས་རྣམ་པ་བཅོ་བརྒྱད་དུ་དབྱེའོ།",
    "དེ་དག་ཇི་ལྟར་རྣམ་པར་བཞག་གལ་ཏེ་ངོ་བོ་ཉིད་ལས་ན་ནི་གསུམ་དུ་འགྱུར་ཏེ།",
    "འོན་ཏེ་མཚུངས་པར་ལྡན་པ་ལས་ན་ནི་ཡིད་དང་མཐུན་པར་ལྡན་པའི་ཕྱིར་གཅིག་ཏུ་འགྱུར་རོ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཕྱིར་ཉེ་བར་རྒྱུ་བར་བྱེད་པ་ཡང་མ་ཡིན་པས་མི་རུང་ངོ།",
    "གཞན་དུ་ན་འདོད་པའི་ཁམས་ན་གཟུགས་ཀྱི་ཁམས་ལ་དམིགས་པ་དག་ཀྱང་གཟུགས་ལ་སོགས་པ་ལ་ཉེ་བར་རྒྱུ་བ་ཡིན་པར་མི་འགྱུར་ལ།",
    "དེ་བཞིན་དུ་གཟུགས་མེད་པ་དང་ལྡན་པའི་བར་དུ་བརྗོད་པར་བྱ་ཞེ་ན།",
    "གཟུགས་དང་ལྡན་པ་བརྗོད་པར་བྱ་སྟེ།",
    "བཅུ་གཉིས་པོ་དེ་དག་ཀྱང་འདོད་པར་འགྲོ་བས་ན་འདོད་འགྲོ་རྣམས་ཏེ།",
    "ཡུལ་རྣམ་པར་འཛིན་པའི་དོན་ལ་ཡང་འགྲོ་བ་སྦྱོར་བ་མཐོང་སྟེ།",
    "ད་ནི་གཟུགས་མེད་པ་དང་ལྡན་པ་བརྗོད་པར་བྱ་སྟེ།",
    "སྲོལ་འདིས་ལྷག་མ་ཡང་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "རྗེས་སུ་ཆགས་པར་བྱེད།",
    "དེ་ལྟར་ན་ཚོར་བ་དག་ཅེས་བྱ་བར་སྲིད་པའི་ཡན་ལག་འདིའི་རབ་ཏུ་དབྱེ་བ་ནི་དུ་མ་ཡོད་པར་རིག་པར་བྱའོ།",
    "རྣམ་པར་ཤེས་པ་སོ་སོར་རྣམ་རིག་པ།",
    "འདུ་བྱེད་དང་སྲིད་པ་ནི་ལས་ཀྱི་མཛོད་ཀྱི་གནས་ནས་འཆད་པར་འགྱུར་རོ།",
    "དཔེར་ན་ཀླུ་གནས་པའི་མཚོ་ནི་སྐམ་པར་མི་འགྱུར་བ་ལྟར།",
    "དཔེར་ན་ཤིང་ལྗོན་པ་རྣམས་དུས་དུས་སུ་མེ་ཏོག་དང་འབྲས་བུ་རྣམས་སྐྱེད་པར་བྱེད་པ་དེ་བཞིན་དུ།",
    "ད་ནི་ཤུན་པ་དང་བཅས་པའི་འབྲས་བུ་ལྟ་བུའི་ལས་བརྗོད་པར་བྱའོ།",
    "དཔེར་ན་མེ་ཏོག་འབྲས་བུ་བསྐྱེད་པར་བྱ་བ་ལ་ཉེ་བའི་རྒྱུ་ཡིན་པ་ལྟར་ལས་རྣམས་ཀྱང་རྣམ་པར་སྨིན་པ་བསྐྱེད་པར་བྱ་བ་ལ་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དཔེར་ན་བཟའ་བ་དང་བཏུང་བ་གྲུབ་ཟིན་པ་ཡོངས་སུ་ལོངས་སྤྱད་པར་བྱ་བ་འབའ་ཞིག་ཡིན་གྱི་ཡང་བསྐྱེད་པར་བྱ་བ་མ་ཡིན་པ་ལྟར་རྣམ་པར་སྨིན་པ་ཞེས་བྱ་བའི་གཞི་ཡང་དེ་དང་འདྲ་སྟེ།",
    "རྣམ་པར་སྨིན་པ་ལས་ཚེ་རབས་གཞན་དག་ཏུ་རྣམ་པར་སྨིན་པ་གཞན་དང་འབྲེལ་བ་ནི་མེད་དེ།",
    "རྣམ་པར་ཤེས་པའི་ཟས་ནི་བཞི་པའོ།",
    "ལྕེ་དང་ལུས་ཀྱིས་ཁམ་དུ་བཅད་ནས་ཁམ་དུ་བྱས་ཏེ་མིད་པའི་ཕྱིར་ཐམས་ཅད་ཁམ་གྱི་ཟས་ཁོ་ན་ཡིན་ནོ།",
    "དེ་ཡང་ཁམ་དུ་བྱས་ནས་མིད་པར་ནི་བྱེད་དོ་ཞེ་ན།",
    "རྣམ་པར་ཤེས་པ་ཟག་པ་དང་བཅས་པ་དག་ཁོ་ན་ཟས་ཡིན་ཏེ།",
    "ཕྱིའི་ཁུ་ཆུ་དང་ཁྲག་ལ་སོགས་པས་ཅུང་ཟད་ཀྱང་རྒྱུར་བྱས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དུ་ཞིག་ནི་སྲིད་པ་ཚོལ་བ་རྣམས་ལ་ཕན་འདོགས་པར་བྱེད་པ་ཡིན་ཞེ་ན།",
    "རྒ་ཤིའི་རྐྱེན་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "ཡིད་ལ་སེམས་པ་ཡང་འདིར་གནས་པར་བྱེད་པ་ཡིན་པར་སྣང་སྟེ།",
    "བར་དུ་བུ་གཉིས་ཤིག་ཡིད་ཆེས་པར་བྱས་པ་དང་།",
    "གཞན་གྱི་ཟས་ཀྱིས་ཟས་དང་བཅས་པར་འགྱུར་དུ་འོང་བའི་ཕྱིར་དེ་ནི་མི་བརྗོད་ཀྱི།",
    "དེ་རྒྱས་པར་བྱེད་པ་ནི་ཁམ་གྱི་ཟས་སོ།",
    "ཡིད་ལ་སེམས་པས་ནི་ཡང་སྲིད་པ་འཕེན་པར་བྱེད་དོ།",
    "དེའི་ཕྱིར་བཞིར་གསུངས་སོ།",
    "ཕྱི་མ་གཉིས་ནི་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་མ་ལྟ་བུ་དག་ཡིན་ནོ།",
    "གང་ཞིག་ཟོས་ནས་ཟ་བ་པོ་ལ་གནོད་པར་བྱེད་པ་དེ་ལ་ཡང་དང་པོ་ཕན་འདོགས་པའི་ཕྱིར་ཟས་ཡིན་ནོ།",
    "གལ་ཏེ་གནོད་པར་བྱེད་པ་ཡང་ཟས་ཡིན་ན་ནི་མུ་བཞི་ལ་ཡང་གནོད་པར་འགྱུར་ལ་རབ་ཏུ་བྱེད་པའི་གཞུང་ཁམ་གྱི་ཟས་གང་ཞེ་ན།",
    "རྣམ་པར་ཤེས་པའི་བར་དུ་རྒྱས་པར་གསུངས་པ་ལ་ཡང་གནོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "རྒྱས་པར་འགྱུར་བའི་ཟས་ལ་དགོངས་ཏེ་གསུངས་པའི་ཕྱིར་འགལ་བ་མེད་དོ།",
    "དེས་ཀྱང་བཀྲེས་པ་དང་སྐོམ་པ་དག་འཇོམས་པར་ནུས་པའི་ཕྱིར་རོ།",
    "གཅིག་ཅེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བས་ན་འདི་ནི་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ཐོབ་པ་སོ་སོའི་སྐྱེ་བོ་ཡིན་པར་དགོངས་སོ་ཞེས་ཟེར་རོ།",
    "དེ་ནི་དེ་དག་མཐའ་ཡས་པ་བས་ཀྱང་ཁྱད་པར་དུ་འཕགས་ན།",
    "དེ་ནི་གདོན་མི་ཟ་བར་དེ་ལྟ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "འདི་ལྟར་དེ་མ་གཏོགས་པའི་ཕྱི་རོལ་པ་རྣམས་ལས་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ལ་ཞུགས་པ་ཁྱད་པར་དུ་འཕགས་པར་མཛད་པར་གྱུར་ཏོ།",
    "དེ་ལྟ་མ་ཡིན་ན་འཛམ་བུའི་ཚལ་དུ་གཏོགས་པ་ལས་ཀྱང་ཁྱད་པར་དུ་འཕགས་པ་ཁོ་ནར་འགྱུར་རོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དེ་ལ་ཡང་།",
    "གལ་ཏེ་འདོད་པའི་ཁམས་ན་རྣམ་པར་སྨིན་པའི་བཏང་སྙོམས་ཡོད་ན་རྣམ་པར་སྨིན་པའི་སེམས་ལ་གནས་ནས་སོ།",
    "ཡང་འཆི་བ་ན་ལུས་ཀྱི་ཕྱོགས་གང་དུ་རྣམ་པར་ཤེས་པ་འགག་ཅེ་ན།",
    "ཁྲུས་བྱས་པའི་ཆུའི་ཐིགས་པ་དག་ལུས་ལ་ཆགས་པར་འགྱུར།",
    "གཡོ་བའི་བདག་ཉིད་ཅན་ཡང་བློ་ཡུལ་གཅིག་ལ་གནས་པར་འགྱུར།",
    "མིག་གཉིས་འཛུམས་པ་དང་འབྱེད་པ་དག་སྲིད་པར་འགྱུར་ཏེ།",
    "མེ་ཏོག་ཕྲེང་རྙིང་པར་འགྱུར།",
    "དེ་དག་ནི་ལོག་པ་ཉིད་དུ་ཡང་ངེས་པར་འགྱུར་ལ།",
    "དེ་དག་ཇི་ལྟར་དེ་ལྟར་ཐོགས་ན་སྲིད་པ་ལན་བདུན་པ་ལ་སོགས་པ་ལྟར་དུས་ངེས་པར་ཡང་དག་པ་ཉིད་དུ་ངེས་པ་ཡང་མ་ཡིན་ནོ།",
    "སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ནི་འདི་ལྟར་གནས་པར་འདོད་དེ།",
    "འདི་ལྟར་གང་ཆེན་པོ་ཆེན་པོའི་རྡོ་རྗེས་ཀྱང་གཞིག་པར་མི་ནུས་པར་སྲ་བ་ཡིན་ནོ།",
    "གང་རིགས་ཐ་དད་པའི་འབྲས་བུའི་ཁྱད་པར་བསྐྱེད་པར་བྱ་བ་ལ་མ་ཕྲད་པར་རྐྱེན་དུ་འགྱུར་བ་ཡིན་གྱི།",
    "འཕང་དུ་དཔག་ཚད་སུམ་བརྒྱ་ཕྱེད་དང་བཅུ་གསུམ་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་དུ་ཕྱེད་ཕྱེད་ཀྱིས་དབྲི་བར་རིག་པར་བྱའོ།",
    "དེ་ནི་ལུས་སམ་ས་ཕྱོགས་གཞན་གྱིས་བཟོད་པར་མི་ནུས་སོ།",
    "ཞེས་གསུངས་སོ།",
    "འོག་དང་ཐད་ཀར་འགྲོ་ན་ཡང་གདུ་ཞིང་འཚེད་པར་བྱེད་པའོ།",
    "གང་དག་ལས་རྣམ་པར་བྱེད་པ་དེ་ནི་མ་ཡིན་ནོ།",
    "ད་ནི་ལས་དེ་དག་གང་དུ་རྣམ་པར་སྨིན་ཞེ་ན།",
    "ཅི་རིགས་པར་མིག་དང་།",
    "གནོད་པར་བྱེད་པ་དག་ཡིན་ནོ།",
    "ཟླ་བ་ཡར་གྱི་ངོའི་དང་པོའི་ཟླ་བའི་དཀྱིལ་འཁོར་མ་རངས་པར་སྣང་བ་དེ་ལ་རྒྱུ་ཅི་ཡོད་ཅེ་ན།",
    "དེས་ན་དེའི་ཕྱི་རོལ་གྱི་ངོས་སུ་གྲིབ་མ་བབ་པས་དཀྱིལ་འཁོར་མ་རངས་པར་སྣང་ངོ་ཞེས་བསྟན་ཏོ་ཞེས་གྲག་གོ།",
    "གསེར་གྱི་རང་བཞིན་འདིའི་ས་གཞི་ཚོན་བརྒྱས་བཀྲ་བར་བྱས་ལ།",
    "དེ་ན་རྣམ་པར་རྒྱལ་བྱེད་དོ།",
    "ལོ་མ་ནི་དཔག་ཚད་ལྔ་བཅུར་ཁྱབ་པར་གནས་སོ།",
    "རྫི་ཕྱོགས་མ་ཡིན་པར་ནི་དཔག་ཚད་ལྔ་བཅུར་ལྡང་ངོ།",
    "དེ་རྫི་ཕྱོགས་སུ་མ་ཡིན་པར་འགྲོ་བ་མ་ཡིན་གྱི།",
    "ཆེས་ཤིན་ཏུ་ཆུང་བར་འགྱུར་བའི་ཕྱིར་མྱུར་བ་ཁོ་ནར་ཀུན་དུ་ཆད་པར་འགྱུར་ཏེ།",
    "ཞེས་གང་གསུངས་པ་ཇི་ལྟར་དྲང་ཞེ་ན།",
    "ས་དང་འབྲེལ་པར་གནས་པ་རྒྱལ་ཆེན་བཞི་པ་དང་།",
    "དགའ་ལྡན་པ་རྣམས་ནི་ལག་བཅངས་བྱས་པས་སོ།",
    "འདོད་པའི་ཁམས་སུ་རིག་པར་བྱ་སྟེ།",
    "བསམ་གཏན་ཁྱད་པར་ཅན་དུ་སྐྱེས་པ་ལ་ནི་དགའ་བ་དང་བདེ་བ་མེད་པའི་ཕྱིར་བདེ་བ་སྐྱེ་བ་ཉིད་དཔྱད་པར་བྱའོ།",
    "འཛམ་བུའི་གླིང་ནས་བཟུང་སྟེ་གོང་མའི་གནས་གང་ཡིན་པ་དེ་ནི་དེ་ནས་འོག་མ་འཛམ་བུའི་གླིང་དུ་ཇི་སྲིད་པར་དེ་ནས་གོང་མའི་གནས་གཞན་དུ་ཡང་དེ་སྲིད་དེ།",
    "དེ་ནས་ཀྱང་འོག་མ་འཛམ་བུའི་གླིང་དུ་ཇི་སྲིད་པར་གོང་མ་འཐབ་བྲལ་བ་རྣམས་ཀྱི་གནས་སུ་ཡང་དེ་སྲིད་དོ།",
    "དེ་ནས་ཀྱང་འོག་མ་འཛམ་བུའི་གླིང་དུ་ཇི་སྲིད་པར་གོང་མ་དགའ་ལྡན་པ་རྣམས་ཀྱི་གནས་སུ་ཡང་དེ་སྲིད་དོ།",
    "དེ་བཞིན་དུ་རྒྱས་པར་ཐམས་ཅད་གོ་རིམ་དང་མཐུན་པར་བྱ་སྟེ།",
    "ཤིན་ཏུ་མཐོང་བ་དག་ནས་འོག་མ་འཛམ་བུའི་གླིང་དུ་ཇི་སྲིད་པར་གོང་མ་འོག་མིན་པ་རྣམས་ཀྱི་གནས་སུ་ཡང་དེ་སྲིད་དོ།",
    "ཐོགས་པ་ནི་བསགས་པར་གནས་པའི་གཟུགས་ཏེ།",
    "རྫུ་འཕྲུལ་གཞན་བརྟེན་མ་གཏོགས་པར།",
    "དེ་ན་གནས་པའི་ལྷས་ཁྲིད་པར་གྱུར་ན་སུམ་ཅུ་རྩ་གསུམ་པ་རྣམས་མཐའ་བྲལ་བའི་ནང་དུ་འགྲོ་བར་འགྱུར་ཏེ།",
    "སྟོང་ནི་སྤྱི་ཕུད་ཡིན་པར་འདོད།",
    "ཐ་མ་ཐུང་ངུར་གྱུར་པ་ན་ཚེ་ལོ་བཅུ་པར་འགྱུར་རོ།",
    "ལྷ་རྣམས་ཀྱི་བརྗོད་པར་བྱ་སྟེ།",
    "གཉའ་ཤིང་འཛིན་ཡན་ཆད་ན་ཉི་མ་དང་ཟླ་བ་མེད་པའི་ཕྱིར་ལྷ་རྣམས་ཀྱི་ཉིན་ཞག་རྣམ་པར་གཞག་པ་དང་།",
    "འདིར་བསྐལ་པ་གང་ཞིག་ཡིན་པར་རིག་པར་བྱ།",
    "ལྷའི་རིས་འོད་ཆུང་ནས་བཟུང་བའི་ཚེའི་ཚད་ནི་བསྐལ་པ་ཆེན་པོར་རིག་པར་བྱའོ།",
    "དེའི་འོག་མ་ཚངས་ཆེན་ལ་སོགས་པའི་ཚེའི་ཚད་ནི་བསྐལ་པ་ཆེན་པོ་ཕྱེད་ལ་བསྐལ་པར་བྱས་ནས་རྣམ་པར་བཞག་གོ།",
    "ད་ནི་ངན་འགྲོའི་བརྗོད་པར་བྱ་སྟེ།",
    "བསྐལ་པར་གནས་པ།",
    "ས་འཛིན་པའོ་ཞེས་རྒྱས་པར་གསུངས་སོ།",
    "དགེ་སློང་དག་ཆུ་བུར་ཅན་ཉི་ཤུ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ཆུ་བུར་རྡོལ་པ་གཅིག་ཡིན་ནོ་ཞེས་བྱ་བ་ནས་རྒྱས་པར་ཡང་དགེ་སློང་དག་པདྨ་ལྟར་གས་པ་ཉི་ཤུ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་པདྨ་ལྟར་གས་པ་ཆེན་པོ་གཅིག་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "སྒྲ་མི་སྙན་མ་གཏོགས་པར་འཆི།",
    "དེ་དག་ཐམས་ཅད་ཀྱི་རྣམ་པར་གཞག་པ་ཡང་མིང་ཡིན་པས་དེའི་མཐའ་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "རྡུལ་ཕྲ་རབ་ལ་སོགས་པ་འདི་དག་ནི་གོང་ནས་གོང་དུ་བདུན་འགྱུར་དུ་རིག་པར་བྱ་སྟེ།",
    "ད་ནི་ལོའི་ཚད་བརྗོད་པར་བྱ་སྟེ།",
    "ད་ནི་བསྐལ་པ་བརྗོད་པར་བྱ་སྟེ།",
    "གང་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འཇིག་པར་འགྱུར་བ་དེ་ལ་ནི་ཞུགས་པ་ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "ཡི་དྭགས་མྱོང་བར་འགྱུར་བ་ཡང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "སྣོད་སྟོང་པས་འདི་ཉིད་ནས་ཀུན་ནས་ཉི་མ་བདུན་བྱུང་ནས་རིམ་གྱིས་ས་དང་རི་རབ་ཀྱི་བར་དུ་མ་ལུས་པར་སྲེག་པར་བྱེད་དོ།",
    "མེ་ལྕེ་དེ་དང་དེའི་ས་པ་ཁོ་ནར་རིག་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་འཇིག་པ་གཞན་དག་ལ་ཡང་ཅི་རིགས་པར་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟར་འཇིག་རྟེན་ཞིག་པ་ནི་ནམ་མཁའ་ཙམ་ལུས་པར་ཡུན་རིང་དུ་གནས་སོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འཆགས་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ནི་ཉེ་བར་འོངས་པར་བརྗོད་པར་བྱའོ།",
    "ཡང་མར་འབྲི་བར་འགྱུར་བ་ན་ཚེ་ལོ་བཅུ་པར་འགྱུར་བ་འདི་ནི་བར་གྱི་བསྐལ་པ་གཉིས་པ་ཡིན་ཏེ།",
