    "ཁྱེའུ་དེ་འཁྲུངས་མ་ཐག་ཏུ་དྲིན་ཅན་ཨ་མའི་འོ་མས་མ་སོས་འབྲི་མོར་བསྣུན།",
    "འབྲི་མོས་མ་སོས་རྒོད་མར་བསྣུན།",
    "རྒོད་མས་མ་སོས་ཁྱི་མོར་བསྣུན།",
    "ཁྱི་མོར་བསྣུན་ཏེ་ནར་སོན་པ་ན་མཚན་ལ་མ་བཞིའི་དཔོན་པོ་ཁྲོ་ཐུང་བཏགས།",
    "སྟག་རོང་དཔོན་པོ་ཁྲོ་ཐུང་གིས་དགུང་ལོ་བཅུ་བཞི་མེ་ལུག་ལོར་འདན་ཁ་རག་བཟའ་ཡི་གསེར་མཚོ་ཞེས་འདན་ལྷུན་གྲུབ་རྡོ་རྗེའི་སྲས་མོ་གཟུགས་མཛེས་ཡིད་དུ་འོང་བ་དེ་ཉིད་ཆུང་མར་བླངས་ཤིང་།",
    "ང་རྒྱལ་དང་ཕྲག་དོག་གིས་གཟིར་བ།",
    "མུ་མེན་མཆོང་གི་རབ་གསལ་ཡོད་པ།",
    "ཁོང་ལ་འདན་སྲས་གཡུ་འོད་འབུམ་ཐུབ་དང་འདན་ཕྲུག་ད་ར་ཁ་ཆེ་སོགས་སྲས་རེ་གཉིས་ཡོད་པར་གྲགས།",
    "ཁོང་གིས་གླིང་གེ་སར་རྒྱལ་པོར་ཞབས་ཏོག་ལེགས་པར་བསྒྲུབས་ཏེ།",
    "ཁོང་གི་སྲས་འབྲུ་སྲས་ནམ་མཁའ་ཐོག་རྒྱས་ཡིན་ཞིང་སྟག་གཟིག་དམག་འཐབ་ནང་སྐུ་བཀྲོངས་སོང་།་",
    "སྟག་རོང་ཨ་ནུ་གཟིག་འཕེན་ནི་གླིང་བཀྲ་ཤིས་མགོན་པོ་དང་།",
    "ཡུམ་གཟིག་ལྕམ་གངས་འཚོ་གཉིས་ལས་ཤིང་སྟག་ལོར་འཁྲུངས།",
    "སྟག་རོང་དཔོན་པོ་གཟིག་འཕེན་དགུང་ལོ་བཅུ་གསུམ་ལ་བུད་པ།",
    "ཆུ་སྟག་ལོ་ལ་འབྲོག་བཟའ་འོད་ལྷ་ཁབ་ཏུ་བཞེས་ནས་སྲས་གཉིས་དང་སྲས་མོ་གཅིག་བལྟམས།",
    "ཆུ་ཡོས་ལོར་ཨ་ནུ་གཟིག་འཕེན་གྱིས་སྲིབ་ལུང་ཤོག་ཆེན་དགུ་ཤོང་གི་སྨད་ཕྱོགས་སུ་དབྱིབས་པདྨ་འདབ་བརྒྱད་དང་།",
    "རྔ་ཡབ་ནོར་འཕྲེང་གིས་བསྐོར་བ།",
    "ཁོང་ཉིད་གཡུལ་འཐབ་མང་པོར་ཞུགས་ནས་རྟིང་མ་དགུང་དང་མཉམ་པ་མང་པོ་བླངས་ཡོདཧོར་གླིང་གཡུལ་འགྱེད་སྐབས་སུ་ཧོར་སྟོབས་ཆེན་གླང་བོ་ཁྲ་འབར་གྱི་ཞགས་པས་རྨ་ཆུར་འཕངས་ནས་གཟི་བརྗིད་ལྡན་པའི་ངང་སྐུ་བཀྲོངས་སོང་།",
    "དཔའ་མི་འགྱུར་ཉ་ཚ་ཨ་བརྟན་ནི་ཁྲོ་ཐུང་གི་བུ་ཆེ་བ་ཡིན་ཞིང་དཔའ་རྟ་ཕོའི་མིང་ལ་གངས་རི་ལྡིང་ཤེས་ཟེར་ཞིང་རྩལ་དྲུག་འཛམ་བུ་གླིང་ལ་ཁྱབ།",
    "མདའ་མོ་རྒོད་སྒྲོ་གློག་ལྕེ།",
    "རྒྱ་བཟའ་ལྷ་སྐྱིད་སྒྲོལ་མ་ཁོང་གིས་བཙུན་མོ་སྔ་ཕྱིར་གསུམ་བླངསཡིན།",
    "འགོག་བཟའ་ལྷ་མོ་གེ་སར་གྱི་ཨ་མ།",
    "སྐྱ་ལོའི་སྟོན་པ་རྒྱལ་མཚན་ནི་སྒ་སྐྱ་ལོའི་སེང་ལྕམ་འབྲུག་མོ་དང་སྐྱ་ལོའི་བུ་ཡག་འབྲུག་རྒྱལ་གླིང་དཔའ་རྟུལ་སུམ་ཅུའི་ཡ་གྱལ་གཉིས་ཀྱི་ཡབ་ཡིན།",
    "རྗེས་སུ་བཙན་གྱི་རྩེ་མོ་དགུང་ལ་མཉམ་ཞིང་།",
    "ཧོར་གླིང་གཡུལ་འགྱེད་དུ་ཁྲོ་ཐུང་གིས་གཡོ་སྒྱུ་སྣ་ཚོགས་འཐེན་ནས་དགྲ་ཁར་བརྫངས་ཏེ་ཨ་ལྔ་མཐེབ་དྲུག་གིས་བཀྲོངས་མོད།",
    "འོན་ཀྱང་སྙན་གྲགས་རྡོ་ལ་རི་མོ་བརྐོས་པ་བཞིན་བསྐལ་པ་ནས་བསྐལ་པར་ཁྱབ་འདུག་གོ།",
    "ལ་བྱས་རྗེས་མང་པོ་བཞག་ཡོདའོམ་བུའི་ཨ་ནུ་དཔའ་སེང་ནི་ལྕགས་ཁྱི་ལོར་ཡབ་འོམ་བུ་རྡོ་རྗེ་དང་ཡུམ་གླིང་གི་ཕུ་ནུ་སུམ་ཅུ་ལྷ་སྲས་སྤུན་ཚེ་རིང་སྐྱིད་གཉིས་ཀྱི་སྲས་སུ་སྐུ་འཁྲུངས།",
    "རྒོད་ཟླ་བས་སྐུ་བཀྲོངསརྨུ་སྤྱང་རིན་ཆེན་དར་ལུ་ནི་ཡབ་དར་རྒྱས་དང་ཡུམ་མཚོ་ལྕམ་གཉིས་ཀྱི་ཆུང་དུས་ནས་དཔའ་ངར་རྟུལ་ཕོད་ཆེ་བས་ཁྲ་མོ་གླིང་གི་སྲས་སུ་སྐུ་འཁྲུངས།",
    "གླིང་སེང་ཆེན་རྒྱལ་པོའི་དགྲ་འདུལ་གཉེན་སྐྱོང་གི་དམག་འཐབ་མང་པོར་ཞུགས་ནས་རྟིང་མ་ས་སྟེང་དུ་ཤོང་དཀའ་བ་བླངསའོམ་བུའི་སྤྱང་ཁྲི་རྔམ་ཆེན་ནི་ཤིང་སྦྲུལ་ལོར་འོམ་བུ་ཛམ་དང་བྱང་ཆུང་དུས་ནས་དཔའ་ངར་དང་སྤྱང་བཟའ་གཉིས་ཀྱི་སྲས་སུ་སྐུ་འཁྲུངས།",
    "འོམ་བུའི་སྤྱང་ཁྲི་རྔམ་ཆེན་ཞེས་རྒྱུ་སྐར་ཁྲོད་ན་ཟླ་བ་བཞིན་གླིང་དཔའ་རྟུལ་ནང་གི་ཡང་རྟུལ་གྱི་སྐོར་ཡིན་ནོ།",
    "མོ་མ་ཀུན་ཤེས་ཐིག་པོ་ས་སྤྲེལ་ལོར་ཡབ་རིག་འཛིན་དང་ཡུམ་མཁའ་འགྲོ།",
    "རྣམས་ཀྱིས་གསུངས་པའི་སྒྲུང་དཔེ་བརྒྱ་ཕྲག་དུ་མ་དེ་དག་གནའ་ནས་ད་ལྟའི་བར་དུ་གངས་ཅན་ལྗོངས་ཡོངས་སུ་ས་ཁྱབ་རྡོ་ཁྱབ་ཏུ་འགྲོ་དང་འགྲོ་བཞིན་ད་དུང་རིན་ཐང་བྲལ་བའི་སྒྲུང་དཔེ་དེ་དག་གིས་བོད་མི་རིགས་ཀྱི་རིག་ཡོད།",
    "འདིར་ཡང་དེ་དག་རེ་རེ་ཅུང་ཙམ་རྒྱས་པར་སྤྲོས་ན་གཅིག་དངོས་གཏེར་ལ་གཏོགས་པའི་སྒྲུང་པའི་གོ་དོན་ནི།",
    "ཟབ་མོ་དག་སྣང་མ་ཞེས་བརྒྱུད་པའི་བཀའ་སྲོལ་ཆེན་མོ་གསུམ་དུ་དབྱེ་བར་མཛད་པའི་ལུང་བཞིན།",
    "འདིར་ཡང་ཟབ་མོ་དག་སྣང་གི་སྐོར་རྣམས་གནམ་གཏེར་དང་དགོངས་གཏེར་གང་རུང་ལས་མ་འདས་པས་ཟབ་གཏེར་གྱི་ཕྱོགས་སུ་གཏོགས་ཤིང་།",
    "རང་རེའི་ཞིང་ཁམས་འདི་རུའང་དགོངས་གཏེར་རིགས་ལ་གཏོགས་པའི་སྒྲུང་པ་རྣམས་ཀྱི་དགོངས་པའི་ཀློང་ནས་སྒྲུང་གི་གཏེར་ཁ་བརྡོལ་བ་ལས་བྱུང་བའི་སྒྲུང་དཔེ་ཡིན་ཞེས་པ་ཡོད་པ་ལས་གཞན།",
    "སྒྲུང་དཔེ་མི་གཅིག་པ་བརྒྱ་ཕྲག་ལྷག་འབྲི་ཤེས་པའང་ད་ལྟ་མིག་གིས་མཐོང་རྒྱུ་འདུག་དཔེར་ན་མགོ་ལོག་གི་སྒྲུང་པ་གུ་རུ་རྒྱལ་མཚན་ལྟ་བུར་མཚོན་ན།",
    "སྒྲུང་གཏེར་དང་ས་གཏེར་རྫས་གཏེར་སོགས་ཐོག་མར་འཆད་པའི་སྐབས་སུ་ཐམས་ཅད་གཏེར་གྱི་ཐ་སྙད་ཀྱི་ཁོངས་སུ་གཏོགས་མོད།",
    "ཡིན་ནའང་དེ་དག་གི་བར་ལ་དབྱེ་བ་ཆེན་པོ་མཆིས་ཏེ།",
    "རྫས་གཏེར་འདི་སྦ་བའི་དམིགས་ཡུལ་ནི་རང་རེའི་ཡུལ་ཁམས་འདི་བདེ་ཞིང་སྐྱིད་པ་དང་ལོ་ཡག་བསྐལ་བཟང་ཡོང་བ།",
    "རྫས་གཏེར་སྦེད་མཁན་དང་འདོན་མཁན་ནི་མཆོག་གི་དངོས་གྲུབ་ལ་མངའ་བརྙེས་པའི་སྐྱེས་བུ་ཞིག་ཡིན་དགོས་པ་ནི་ཀུན་གྱིས་གསུང་བཞིན་པ་ལྟར་རོ།",
    "གླིང་གེ་སར་རྒྱལ་པོའི་གཏེར་སྒྲུང་བྱུང་བའི་དུས་སྐབས་ལའང་ད་ལྟ་མཁས་པ་སྐོར་ཞིག་གིས་བཞེད་ཚུལ་མི་མཐུན་པ་མང་པོ་བརྗོད་ཀྱང་ཁོ་བོའི་བསམ་པར་གཏེར་སྒྲུང་འདི་བྱུང་ནས་བགྲང་བྱ་ཆིག་སྟོང་ཡས་མས་ལས་འདས་མེད་པར་འདོད།",
    "རྒྱ་རྩིས་པའི་ས་ཕོ་སྟག་གི་གཏེར་སྒྲུང་རིགས་ཀྱི་གེ་སར་སྒྲུང་པའི་སྐོར་ལ་དཔྱད་པ།",
    "གསང་བ་བདེ་སྐྱོང་གི་འཁོར་ལོ་ནས་གླིང་རྗེ་གེ་སར་རྒྱལ་པོ་སྨུག་པོ་ལྡོང་གི་རྒྱལ་རྒྱུད་དུ་ངོ་མཚར་ཆེ་བའི་ལྟས་དང་བཅས་སྐུ་འཁྲུངས།",
    "གེ་སར་འཁྲུངས་ནས་འདི་ལོའི་ཆུ་བྱ་འི་བར་ལ་ལོ་ཙམ་སོང་ཞེས་བཀོད་འདུག་པ་སོགས་གཞིར་བཟུང་ནས་གླིང་གེ་སར་རྒྱལ་པོའི་འཁྲུངས་འདིས་དང་ཁོང་གི་མཛད་འཕྲིན་ཕལ་མོ་ཆེར་དཔྱད་ན།",
    "གང་ལྟར་ཀྱང་གེ་སར་རྒྱལ་པོའི་སྒྲུང་དཔེ་ཐམས་ཅད་གཏེར་སྒྲུང་ལ་གཏོགས་དང་མི་གཏོགས་པའི་ཁ་ཚོན་གཅོད་དཀའ་མོད།",
    "པ་རྣམ་པའི་བློ་ངོར་སྒྲུང་སྣ་མི་གཅིག་པ་བརྒྱ་དང་ལྔ་བཅུ་དྲུག་ཅུ་ལྷག་ཡོད་པ་འདིར་ལྐོག་གྱུར་གྱི་ཤེས་བྱ་ཟབ་མོ་ཞིག་མཆིས་པ་སུས་ཀྱང་བསྙོན་དུ་མེད།",
    "དེ་ཉིད་སྤྱན་འདྲེན་པ་པོ་ཡང་བོད་གནའ་རབས་དང་དེང་རབས་སྐབས་སུ་མཆོག་གི་དངོས་གྲུབ་བརྙེས་པའི་གཏེར་ཆེན་དང་གཏེར་ཕྲན་གྱི་གཏེར་སྟོན་པ་གྲགས་ཅན་བསམ་གྱིས་མི་ཁྱབ་པ་མང་པོ་བྱོན་པ་དེ་རྣམས་ལགས་པའང་ཀུན་གྱིས་ཤེས་གསལ་ལྟར་རོ།",
    "གཡོག་མི་ཕྱེད་པས་གཡོག་གི་གཏེར་དང་།",
    "ཕུན་སུམ་ཚོགས་པ་དང་ཡིད་འཛིན་གྱི་ནུས་པ་གཞན་དང་མི་མཚུངས་པ་མཆིས་ཕྱག་བྲིས་གནང་བའི་སྒྲུང་དཔེ་རྣམས་ལའང་གཏེར་ཚེག་གིས་ཀུན་ཤིང་།",
    "བཞི་ནི་རང་རང་ལ་ཀྱག་ཀྱོག་གི་བརྒྱུད་རིམ་ངོ་མཚར་བ་ནས་བརྒྱན་ཡོད་པ།",
    "ལོ་ན་གཞོན་པའི་དུས་སུ་རྨི་ལམ་བཟང་བའི་ལྟས་ཤིག་གམ་ཡང་རེ་ཡོད་པ་སྟེ།",
    "གཟུགས་མེད་ཀྱི་གེ་འབྲི་བའི་སྐབས་སུ་སྨྱུ་གུ་ཤོག་ཐོག་ཏུ་བཞག་པས་ནསྟོབས་ཤུགས་ཤིག་གིས་རམ་འདེགས་བགྱིད་པ་ལྟར་ཤར་མར་འབྲི་ཐུབ་པར་མ་༤ ཡི་གེ་བྲིས་བྱུང་བའི་ཡི་གེ་ཡང་དག་ཅིང་འགལ་བ་ཅི་ཡང་མེད་ལཟད།",
    "དཔེར་ན་མགོ་ལོག་གི་སྒྲུང་པ་གྲགས་ཅན་གུ་རུ་རྒྱལ་མཚན་ལ་མཚོན་ན་གཏེར་སྒྲུང་ལ་གཏོགས་པའི་སྒྲུང་པ་ཞིག་ཡིན་ཞིང་།",
    "ས་དགེ་སྡིག་གི་དབྱེ་བ།",
    "གཤིན་པོའི་བསྔོ་བ་སོགས་གསལ་ཞིང་དག་པ་བྲིས་ཡོད་པ་ལྟ་བུ་རེད།",
    "ད་ནི་འདིར་གེ་སར་རྒྱལ་པོས་བསྔོ་བ་གསུང་བའི་ཚན་པ་རེ་བཀོད་ན་འདི་ལྟ་སྟེ།",
    "ཁལ་ལྕི་མོ་བཀལ་བའི་མཛོ་གཡག་བསྔོ།",
    "འཛུམ་རི་མོ་ཅན་གྱི་སྟག་གཟིག་བསྔོ།",
    "མ་ཨ་སྟག་ལྷ་མོ་གཙོ་བྱས་པའི།",
    "གཞན་ཡང་དགོངས་གཏེར་ལས་ཐོན་པའི་སྒྲུང་དཔེ་གླིང་གི་བྲོ་ར་རུ།",
    "འདི་ཡང་གཏེར་སྒྲུང་གི་ཁྱད་དུ་མཚར་བའི་རྟགས་མཚན་གཙོ་བོ་ཞིག་ཡིན་པ་སུས་ཀྱང་བསྙོན་དུ་མེདགཉིས་ནི་ངག་ཐོག་ནས་བརྒྱུད་དེ་ཐོན་པའི་སྒྲུང་དཔེ་དང་དངོས་གཏེར་དང་དགོངས་གཏེར་ལས་ཐོན་པའི་སྒྲུང་དཔེའི་རྗོད་བྱེད་ཀྱི་ཚིག་ལ་ཁྱད་པར་ཆེན་པོ་ཡོད།",
    "ད་དུང་ཚིག་གི་བརྗོད་སྟངས་དང་རྩོམ་ཉམས་ཀྱང་གཞོན་ནུ་ཟླ་མེད་དང་བྱ་མགྲིན་སྔོན་ཟླ་བའི་རྟོགས་བརྗོད་ལྟ་བུར་མཚུངས་པའི་ཆའང་མང་བར་སེམས།",
    "ཡོན་ཏན་ཅན་གྱི་བློ་མིག་འཕྲོག་པའི་ནུས་པ་ལྡན་པ་ཞིག་ཏུ་འདུག་ཡིན་ནའང་ཡི་གེ་མེད་པའི་ཉན་མཁན་ལ་མཚོན་ན་གོ་ཁ་ཅུང་དཀའ་མོ་ཡིན།",
    "གླིང་གི་བྲོ་ར་ལས།",
    "སོ་དུང་ཕྲེང་གི་བུ་མོ་འཛུམ་མདངས་ཤིགས་སེ།",
    "གླིང་ཆེ་རྒྱུད་སྟག་གི་མཆེ་བ།",
    "འབྲིང་རྒྱུད་གཟིག་གི་ཐིག་ལེ།",
    "སྐུ་ལ་བདེ་སྟོང་གི་ལུས་རྩལ་རྫོགས་ནས།",
    "སྙན་ངག་གི་དཔེ་རྒྱན་དང་གཟུགས་རྒྱན་ལ་སྦྱར་བའི་ཚིགས་བཅད་ཀྱང་ཤིན་ཏུ་ཉམས་དགའ་བ་མང་པོ་མཐོང་ཐུབ་པར་མ་ཟད།",
    "ད་དུང་ཅུང་གོ་དཀའ་བའི་མིང་བརྡ་བདེ་སྟོང་གི་ལུས་རྩལ།",
    "རྫ་རྔ་འཁྲོལ་ལྟ་བུའི་བྱ་ཚིག་གི་སྦྱོར་སྟངས་ཀྱང་གང་སར་བཀོད་ཡོད་པ་མཐོང་ཐུབ།",
    "ཁྱད་པར་དུ་གླིང་གི་དཔའ་རྟུལ་སུམ་ཅུ་དང་ཡང་ཚུལ་དམ་པའི་མི་བདུན།",
    "སྨུག་པོ་ལྡོང་གི་རྒྱལ་རབས་སུ།",
    "དེ་ཡང་ཤིང་འབྲུག་གི་ལོར།",
    "ཡུམ་གཟིག་ལྕམ་གངས་མཚོ་གཉིས་ལ་ཤིང་མོ་སྟག་གི་ལོར་གྲུབ་ཆེན་ཀངྐའི་རྣམ་སྤྲུལ་སྟག་རོང་དཔོན་པོ་གཟིག་འཕེན་འཁྲུངས།",
    "དགུང་ལོ་བཅུ་གསུམ་སྟེ་ཆུ་སྟག་ལོར་འབྲོག་བཟའ་འོད་ལྷ་ཁབ་ཏུ་བཞེས་ནས་སྲས་གཉིས་དང་སྲས་མོ་གཅིག་བལྟམས།",
    "ཐ་ན་གེ་སར་རྒྱལ་པོ་དང་དཔའ་རྟུལ་སུམ་ཅུའི་སྐྱེས་རབས་འབྱུང་ཁུངས་གསལ་བོར་བཀོད་ཡོད་པའི་སྒྲུང་དཔེ་ཡང་ཉིན་མོའི་སྐར་མ་བཞིན་དཀོན་པས་སོ།",
    "འདི་ཡང་གཏེར་སྒྲུང་གི་ངོ་མཚར་ལྡན་པའི་གྲུབ་འབྲས་ཤིག་ཡིན་པར་སྙམ།",
    "བཞི་ནི་གཏེར་སྒྲུང་རིགས་ཀྱི་སྒྲུང་གི་གླུ་ཚིག་ཐོག་མ་འགུག་པའི་འགུག་རྟ་ལ་ཡང་ངག་ཐོག་ཏུ་བརྒྱུད་ཡོང་བའི་སྒྲུང་དཔེའི་གླུ་ཚིག་གི་འགུག་ལུགས་དང་ཁྱད་པར་ཆེ།",
    "གླུ་ཚིག་ཡོད་དོ་ཅོག་གི་མགོའི་འགུག་རྟ་ལ།",
    "གླུ་ཨ་ལ་ལ་མོ་ཨ་ལ་ལེན།",
    "གླུ་ཐ་ལ་ལ་མོ་ཐ་ལ་ལེན།",
    "གླུ་རེ་རེའི་མཇུག་ཏུ།",
    "ཅེས་བཀོད་ཡོད་མོད།",
    "འོན་ཏེ་གཏེར་སྒྲུང་རིགས་ཀྱི་གླུ་ཚིག་གི་འགུག་རྟ་དེ་འདྲ་མིན་ཞིང་།",
    "གླུ་རེ་རེའི་མཇུག་ཏུ་ཡང་གཅིག་གྱུར་གྱི་རྗོད་ཚིག་མེད།",
    "གླུ་ཧ་ལ་ཧ་ལ་ཧ་ལ་རེད།",
    "གླུ་དཀར་མོ་དྲུག་འགྱུར་བཀའ་ཡི་གསུང་།",
    "ལྟ་བུ་སྟེ་གླུའི་འགུག་རྟ་གཅིག་གྱུར་མིན་པ་དང་ཀླུ་རེ་རེའི་མགོའི་འགུག་ལུགས་ཀྱི་ནང་དོན་ཀྱང་སོ་སོ་ཡིན།",
    "དམྱལ་གླིང་མུན་པ་རང་གསལ་ལས་ཀྱང་གླུ་ཚིག་རེ་རེའི་མགོའི་འགུག་རྟར་གླུ་ཨ་ལ་དང་ཐ་ལ་ཞེས་པ་གཅིག་ཀྱང་བཀོད་མེད་ཅིང་།",
    "མཇུག་སྡུད་པའི་དུས་སུའང་ཐད་གར་བརྗོད་དོན་གྱི་དགོས་མཁོ་ལྟར་མཇུག་བསྡུས་པ་མ་གཏོགས་གཅིག་གྱུར་གྱི་ཚིག་གིས་བཅིངས་མེད།",
    "ད་ལྟ་སྔོན་བྱོན་སྐྱེས་བུ་དམ་པ་དག་གིས་གཏེར་ལས་བཏོན་པའི་སྒྲུང་དཔེ་མི་ཉུང་བ་གྲངས་ཀ་བརྩི་རྒྱུ་ཡོད་པ་ལས་གཞན་ཏུན་ཧོང་ཡིག་ཚང་ནས་ཐོན་པའི་གཏེར་ཡིག་དེ་དག་ལས་ཀྱང་གེ།",
    "ད་ལྟ་དངོས་སུ་བྲིས་ཡོད་པའི་པའི་སྒྲུང་དཔེ་བརྒྱ་ཕྲག་ལྷག་ལ་སོན་ཡོད་ཅིང་སྒྲུང་དཔེ་ཡང་ཉི་ཤུ་ལྷག་ལ་བུད་ཡོད།",
