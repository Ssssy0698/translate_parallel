    "ལྷའི་བུ་མོ་མི་ཡུལ་འོངས་པ་འདྲ།",
    "ཁྱོད་སེང་ལྕམ་འབྲུག་མོར་ཚང་ནས་ཡོད།",
    "ཁོག་ཡིད་སེམས་དྲང་བ་མདའ་མོ་འདྲ།",
    "ཞེས་པ་སོགས་ཧ་ཅང་ཞིབ་ཚགས་ཀྱི་སྒོ་ནས་བོད་རིགས་བུད་མེད་ཞིག་གི་སྣང་བརྙན་རྩོམ་རིག་སྒྱུ་རྩལ་གྱི་ལམ་ནས་བརྗོད་དེ།",
    "ཁོག་ཡིད་སེམས་དྲང་བ་མདའ་མོ།",
    "གླིང་གེ་སར་མཆོག་གི་ཇ་མ་བྱང་ཨ་སྟག་འཁྱིལ་བའི་ཀླུ་མོའམ་ལྷ་མོ་ནི།",
    "ཇ་མ་མིང་ཆེན་བཅུ་གསུམ་ལས་བྱས་རྗེས་ཆེས་ཆེ་བའི་བུད་མེད་ཅིག་ཡིན་ཞིང་།",
    "ཁོ་མོའི་མི་ཚེ་གང་བོར་མཐའ་གཅིག་ཏུ་གེ་སར་རྒྱལ་པོར་ཞབས་ཏོག་ལེགས་པར་བསྒྲུབས་ཏེ།",
    "ཨ་སྟག་ལྷ་མོ་ནི་བོད་རིགས་དཔའ་མོའི་ཚབ་བྱེད་གཅིག་པུར་གྱུར་པ་དང་།",
    "ནསགཡུལ་འགྱེད་དེ་འདྲ་མང་པོ་ཞིག་གི་ཁྲོད་དུ།",
    "བསྐལ་བརྒྱ་མ་སྟོང་བར་དུ་བག་ཆགས་ཟབ་མོ་བཞག་ཡོད་པ་ཡིན་ནོ།",
    "གུར་ནག་པོ་མུན་པ་འཁྲིགས་འདྲ་ཞིག་གི་ནང་ནས།",
    "དཔའ་ཨ་སྟག་ལྷ་མོ་དེ།",
    "ཁྲབ་དཀར་མོ་བྱང་ཕུད་ཤུལ་ཉུལ།",
    "རྟ་རག་པ་སྟག་ལག་གི་གོང་དུ་ཞོན་ཞིང་།",
    "ནངས་སྔ་དྲོ་ཁྲ་ཡག་རྫ་ལ་སོང་།",
    "དགོང་ཕྱི་དྲོ་འབྲོང་མོ་བསད་བསད་ནས།",
    "རི་ཆེན་པོ་ཁྲག་གིས་དམར་པོ་བྱས།",
    "མ་ཨ་སྟག་ལྷ་མོ་གར་སོང་ན།",
    "ཉིན་གུང་ན་དམར་གཞུང་ལ་སོང་།",
