    "སྐབས་དེ་ནས་བཟུང་གླིང་གི་དཔའ་རྟུལ་ཡིན་ཟེར་བའི་འཇིམ་པའི་མི་ཆུང་མང་པོ་བཟོ་བར་དགའ་བ་དང་།",
    "གླིང་སྒྲུང་གཅེས་བཏུས་དེབ་བཞི་བ་ཧོར་གླིང་གཡུལ་འགྱེད་ལེགས་སྒྲིག་གི་སྐོར་རགས་ཙམ་བརྗོད་པ།",
    "ཆེད་མ་རལས་མཁས་པ་རྣམས་ཀྱིས་བློ་སེམས་རྩེ་གཅིག་གིས་མཐུན་རྐྱེན་གང་ལེགས་བསྒྲིགས་པ་དང་རྩོལ་བ་ལྷོད་མེད་བགྱིས་པར་བརྟེན།",
    "ངེད་ཅག་གིས་རབ་དཀར་ལྷ་རྫས་སོར་བཅུའི་རྩེར་བསྒྲེངས་ཞིག་ཡིན་པས།",
    "ད་ལྟ་གླིང་སྒྲུང་གི་མགོ་སྟེ་ལྷ་གླིང་གབ་ཙེ་དགུ་སྐོར་ནས་མཇུག་སྟེ་ཁམས་གསུམ་བདེ་བཀོད་བར་གྱི་སྒྲུང་དཔེ་ཕལ་ཆེར་ལྷག་དངོས་སུ་ལེགས་སྒྲིག་པར་སྐྲུན་བྱས་ཡོད་ཅིང་།",
    "ད་རེབ་ཡང་བསྐྱར་དུ་ལེགས་སྒྲིག་བགྱིས་པ་ཡིན།",
    "ཡིན་ནའང་གནའ་ནས་ད་ལྟའི་བར་མི་རྣམས་ལ་གེ་སར་སྒྲུང་གི་ནང་དོན་ཡོངས་སུ་འདུས་པའི་ཁ་ཚང་ཞིང་སྤུས་དག་པའི་ལེགས་སྒྲིག་མ་གསར་བ་ཞིག་མཐོང་བའི་སྐལ་བ་མ་བྱུང་བས།",
    "ཡིག་འབྲུ་དང་སྙན་ངག་གི་རྐང་པ་ག།",
    "ཚོགས་ཀྱི་ངག་ཐོག་ནས་བརྒྱུད་ཡོང་བའི་དམངས་ཁྲོད་རྩོམ་རིག་གི་གྲས་ཡིན་སྒྲུང་ཁག་མང་པོའི་ནང་དོན་གྱི་ཆ་དང་མིང་ཚིག་ཐ་སྙད་ཀྱི་ཆ།",
    "ལེའུ་རེའི་མགོར་ཚིགས་བཅད་ཤོ་ལོ་ཀ་གཅིག་རེ་དཔེར་ལེའུ་བགོས་ཡོད་ལ།",
    "ལེགས་སྒྲིག་པར་སྐྲུན་གྱི་ཆུ་ཚད་ཀྱང་ངེས་ཅན་ཞིག་ལ་སླེབས་ཡོད་པ་དེ་རེད།",
    "ཧུའུ་མའི་སྙན་རྩོམ་རིང་མོ་ཡེ་ལེ་ཡཱ་ཐེ་དང་ཨོ་ཏི་ཞིག་ཅི་ལ་མཚོན་ན།",
    "བགྲང་བྱ་ཉིས་སྟོང་གི་སྔོན་ལ་སྐབས་དེའི་རྒྱལ་པོས་དངོས་སུ་དང་ལེན་མཛད་དེ་མཁས་པ་རྩ་འཛུགས་བགྱིས་ནས་ལེགས་སྒྲིག་པར་སྐྲུན་གནང་མྱོང་ལ།",
    "དུས་སྐབས་དེར་ཡོ་རོབ་རྩོམ་རིག་གི་མ་དཔེ་དང་འབྱུང་ཁུངས་ཡིན་པར་བསམས་ཤིང་།",
    "གཞན་ཡང་རྒྱ་གར་གྱི་སྙན་རྩོམ་རིང་མོ་རཱ་མ་ཡ་ཎ་མ་ཧཱ་བྷ་ཧོར་གླིང་གཡུལ་འགྱེད་ལེགས་སྒྲིག་གི་སྐོར་རགས་ཙམ་བརྗོད་པ།",
    "ཡིན་ནའང་རང་རེའི་གླིང་རྗེ་གེ་སར་རྒྱལ་པོའི་སྒྲུང་ལ་མཚོན་ན།",
    "འཛམ་གླིང་སྟེང་གི་ཆེས་རིང་བའི་སྙན་རྩོམ་རིང་མོ་ཡིན་པ་དང་ནང་དོན་ཆེས་ཕུན་སུམ་ཚོགས་པ་ནི་སུས་ཀྱང་ཁས་ལེན་བཞིན་ཡོད་མོད།",
    "མྱུར་བ་མྱུར་བར་རྣམ་པ་དང་ནང་དོན་གཅིག་གྱུར་ཅན་གྱི་གླིང་སྒྲུང་གཅེས་བཏུས་ཁ་ཚང་ཞིག་ལེགས་སྒྲིག་དང་པར་སྐྲུན་བྱ་རྒྱུ་ནི་འཛམ་གླིང་ཐོག་གི་སྔོན་ཐོན་རྩོམ་རིག་གི་རྗེས་སུ་སྙེག་པར་དགོས་གལ་ཧ་ཅང་ཆེ་བ་ཞིག་གོ།",
    "ནུས་པ་ཡང་འདོན་དུ་བཅུག་ཆོག་ཅིའི་ཕྱིར་ཞེ་ན་གླིང་སྒྲུང་གཅེས་བཏུས་ཀྱི་ནང་དུ་གེ་སར་སྒྲུང་གི་བརྗོད་བྱའི་ནང་དོན་ཕལ་ཆེར་ཆ་ཚང་བའི་ཁར།",
    "ངེད་ཅག་གིས་གླིང་སྒྲུང་གཅེས་བཏུས་ལེགས་སྒྲིག་པར་སྐྲུན་གྱི་སྐབས་སུ།",
    "གླིང་སྒྲུང་གཅེས་བཏུས་ལེགས་སྒྲིག་གི་སྐབས་སུ།",
    "ཚན་རིག་གི་རང་བཞིན་དང་ཡོངས་འདུས་ཀྱི་རང་བཞིན།",
    "དེབ་རེར་སྙན་ངག་ཚིག་རྐང་ཁྲི་གཉིས་རེ་ཙམ་དང་།",
    "ཡིག་འབྲུ་འབུམ་བཞི་རེ་ཡིན་དགོས་ལ།",
    "དེ་ཡང་གླིང་སྒྲུང་གཅེས་བཏུས་དེབ་བཞི་བ་ཧོར་གླིང་གཡུལ་འགྱེད་ཧོར་གླིང་གཡུལ་འགྱེད་ལེགས་སྒྲིག་གི་སྐོར་རགས་ཙམ་བརྗོད་པ།",
    "ཤིང་ཕོ་སྟག་གི་ལོ་ལ་ནག་པོ་བདུད་འདུལ་དུ་ཕེབས་ཤུལ་དུ།",
    "ཁྭ་ཏོ་བཅས་བཞི་མངགས་ནས་བཙུན་མོ་འཚོལ་དུ་བཅུག་དེར་བླ་བྱ་ཁྭ་ཏས་གུར་དཀར་རྒྱལ་པོའི་བཀའ་གསུང་དང་དུ་བླངས་ཏེ་སྟོད་མངའ་རིས་སྐོར་གསུམ།",
    "གླིང་སེང་ལྕམ་འབྲུག་མོ་འཕྲོག་དགོས་པའི་བཀའ་བཙན་པོ་བསྒྲགས་པ་ལྟར།",
    "གླིང་གི་ཁྲོ་ཐུང་དཔོན་པོ་ནང་རུལ་བྱས་པས་ཇ་མཁར་རྨང་ནས་བཤིག་ཅིང་།",
    "འབྲུག་མོ་བཙན་གྱིས་ཕྲོགས་པ།",
    "ཁོང་དང་མེ་བཟའ་འབུམ་སྐྱིད་གཉིས་ལྷན་དུ་བཞུགས་ནས་བགྲང་བྱ་མང་པོ་འགོར་འགྱངས་སུ་སོང་བར་བརྟེན།",
    "སེང་ལྕམ་འབྲུག་མོས་སེམས་ཀྱིས་མ་བཟོད་པར་གེ་སར་རྒྱལ་པོར་སྔ་ཕྱིར་ཐེངས་གཉིས་ལ་༡འཕྲིན་ཡིག་བཏང་།",
    "འབྲུག་མོའི་འཕྲིན་ཡིག་སེང་ཆེན་རྒྱལ་པོར་འབྱོར་བ་ལ་བརྟེན་ནས་བདུད་ནས་ཕྱིར་གླིང་དཀར་སྟོད་ལ་ལོག་ཅིང་།",
    "དགྲ་ལ་ཤ་འཁོན་གླན་པ་དང་འབྲུག་མོ་ཕྱིར་བསུ་བའི་སླད་དུ།",
    "འབྲུག་མོ་དང་གླིང་གི་རྟེན་གསུམ་དངོས་རྫས་ཕྲོགས་ཚད་ཀུན་རང་ནོམ་དུ་བླངས་པར་མ་ཟད།",
    "རྗོད་བྱེད་ཚིག་ལ་བོད་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་རྒྱན་སྣ་ཚོགས་ཀྱིས་སྤྲོས་པས་སྙན་ཞིང་བབ་ཆགས་ལ།",
    "ཡོན་ཏན་མཆོག་དམན་གང་གིས་བལྟས་ཀྱང་གོ་སླ་བ།",
    "གླིང་གེ་སར་རྒྱལ་པོའི་སྒྲུང་ཡོད་ཚད་ཀྱི་ནང་ནས་གཙོ་ཆེ་ཤོས་དང་ཏོག་ལྟ་བུར་གྱུར་ཧོར་གླིང་གཡུལ་འགྱེད་ལེགས་སྒྲིག་གི་སྐོར་རགས་ཙམ་བརྗོད་པ།",
    "བདེ་མཁར་དངོས་གྲུབ་བཀྲ་ཤིས་ཀྱིས་གསུང་ནན་མོ་སྩལ་བ་སོགས་ལ་བརྟེན་ནས།",
    "ཤིང་མོ་ཡོས་ཀྱི་རྒྱལ་ཉི་གྲལ་ཚེས་ལ་ལེགས་པར་གྲུབ་བོ།",
    "བརྡ་རྙིང་དང་ཡུལ་སྐད་གྲགས་ཆེ་བ་རེ་གཉིས་ཙམ་མ་གཏོགས།",
    "བཅུ་ལེགས་སྒྲིག་པར་སྐྲུན་བྱེད་རྒྱུ་འདི་ལ་ཕྱིའི་བཟོ་དབྱིབས་དང་ནང་གི་སྒྲིག་སྟངས།",
    "ཁྱད་པར་དུ་ད་རེབ་ལེགས་སྒྲིག་བྱས་པའི་ནང་དོན་གྱི་སྐོར་མཚམས་སྦྱོར་ཞིབ་མོ་བྱས་ཡོད་པར་མ་ཟད།",
    "ཧོར་གླིང་གཡུལ་འགྱེད་སྔོན་མའི་ནང་དུ་གླུ་ཚིག་ཐམས་ཅད་ལྷུག་རྩོམ་ཇི་བཞིན་བསྒྲིགས་ཡོད་པ་ཚང་མ་སྙན་ངག་གི་སྒྲིག་ཚུལ་ལྟར་རྐང་པ་རེ་རེ་འཕྲེད་དུ་བསྒྲིགས་པ་དང་།",
    "ཤོག་ངོས་རེ་རེའི་གཡས་ཀྱི་ཐོད་ལ་ཧོར་གླིང་གཡུལ་འགྱེད་ཅེས་ཡིག་འབྲུ་བཞི་གཅིག་གྱུར་གྱིས་བྲིས་ཡོད་ལ།",
    "དེ་ཡང་ཡིག་འབྲུ་བདུན་རེ་འབྲི་དོན་ཡང་མིག་ལ་མཛེས་ཤིང་བཀླགས་ན་ཁར་བདེ་བ་ཙམ་མིན་པར་དོན་བསྡུས་ཤིང་བརྗོད་བདེ་བའི་ཆེད་དུ་ཡིན།",
    "དམངས་ཚོགས་ཞེས་པ་ཧོར་གླིང་གཡུལ་འགྱེད་ལེགས་སྒྲིག་གི་སྐོར་རགས་ཙམ་བརྗོད་པ།",
    "ཧོར་གླིང་གཡུལ་འགྱེད་སྨད་ཆའི་ལེའུའི་ཚིག་རྐང་གཉིས་རེ་དེ་ཚིག་རྐང་བཞི་རེར་བཅོས་ཡོད་པ་དང་།",
    "སྟོད་སྨད་ཆ་གཉིས་སུ་ཚིགས་བཅད་དང་གླུ་ཚིག་བཅད་ལྷུག་དང་གླུ་གོང་འོག་གི་དོན་བསྐྱར་ཟློས་སུ་གྱུར་པ།",
    "གཞན་ཡང་ཧོར་གླིང་གཡུལ་འགྱེད་ཀྱི་སྨད་ཆའི་མཇུག་ཏུ་མཇུག་བྱང་བྲིས་ཏེ་ལེགས་སྒྲིག་གི་བརྒྱུད་རིམ་དང་།",
    "གླིང་གི་དཔའ་རྟུལ་སུམ་ཅུ།",
    "ཧོར་གླིང་གཡུལ་འགྱེད་ལེགས་སྒྲིག་གི་སྐོར་རགས་ཙམ་བརྗོད་པ།",
    "བདག་ལ་མཚོན་ནའང་འདི་འདྲའི་གཞི་རྒྱ་ཆེ་བའི་ལེགས་སྒྲིག་གི་ལས་དོན་ནང་ཞུགས་པའང་ཐེངས་དང་པོ་ཡིན།",
    "དེ་བས་ན་མྱོང་ཚོར་རམ་ཤེས་རྟོགས་མི་ཉུང་བ་ཞིག་སྐྱེས་པ་ནི་སྨོས་མ་དགོས་སོ།",
    "མདུན་ཤོག་གི་ཇུས་འགོད་དང་ནང་དོན་གྱི་སྒྲིག་སྟངས།",
    "མིང་ཚིག་ཐ་སྙད་ཀྱི་གཅིག་གྱུར་བཅས་པའི་ཐད་དུ་མཁས་པ་བགྲེས་གཞོན་མི་ཉུང་བ་ཞིག་གིས་ནན་ཏན་གྱིས་ཞིབ་འཇུག་དང་སུན་སྣང་མེད་པར་ཞུ་དག་བྱས་ཡོད་ཅིང་།",
    "ཡོད་ཚད་ཡིག་ཐོག་སྙན་ངག་ཏུ་བསྒྱུར་ཏེ་གླིང་སྒྲུང་གི་སྔར་ཡོད་ཀྱི་མང་ཚོགས་ཀྱིས་ཉན་འདོད་པ་དང་གོ་སླ་བའི་ངག་ཐོག་སྙན་ངག་རྣམས་ཀྱི་ཉམས་ཤོར་བར་འཇུག་པ་དང་།",
    "དེ་བས་ཕྱིས་སུ་གེ་སར་ལ་ཆ་རྒྱུས་ཡོད་པ་དང་ལེགས་སྒྲིག་གི་ཉམས་མྱོང་ཡོད་པ་སྐོར་ཞིག་གཏན་ཁེལ་བྱས་ཏེ་བྱ་བ་འདི་དམ་ལྷོད་མེད་པར་འཛིན་རྒྱུ་ནི་གལ་ཆེའོ།",
    "ད་ལྟ་གེ་སར་སྒྲུང་གི་དཔྱད་གཞིའི་ཡིག་རིགས་སྡུད་སྒྲིག་བྱས་གསུམ།",
    "ཧོར་གླིང་གཡུལ་འགྱེད་ལེགས་སྒྲིག་གི་སྐོར་རགས་ཙམ་བརྗོད་པ།",
    "དེར་བརྟེན་གླིང་སྒྲུང་གཅེས་བཏུས་ཀྱི་ལེགས་སྒྲིག་པར་སྐྲུན་བྱ་བ་བདེ་བླག་ངང་འགྲུབ་པར་བྱེད་བསམས་ན་གླིང་སྒྲུང་གི་དཔྱད་གཞིའི་ཡིག་རིགས་ཁང་ལེགས་པོ་ཞིག་བཙུགས་ཏེ་གེ་སར་སྒྲུང་གི་དཔེ་དེབ་ཡོད་ཚད་འཚོལ་སྡུད་བྱེད་པ་དང་།",
    "གླིང་སྒྲུང་གཅེས་བཏུས་གླེགས་བམ་བཞི་བཅུའི་ནང་དུ་གེ་སར་སྒྲུང་ཡོད་ཚད་ཀྱི་བརྗོད་བྱའི་དོན་དང་རྗོད་བྱེད་ཚིག་གི་ཉིང་བཅུད་ཕལ་ཆེར་བསྡུ་དགོས་པ་དང་།",
    "སྒྲུང་དཔེ་རང་སྟེང་གི་ཐུན་མོང་མ་ཡིན་པའི་བརྗོད་སྟངས་ཏེ།",
    "མི་ཚོས་བཏོན་པའི་བསམ་འཆར་དག་ལས་དེར་ཕན་པའི་བསམ་འཆར་ཡིན་ན་ཟུར་ལྟ་བྱས་ཆོག་དེ་ཡང་ཡིག་འབྲུ་འགའ་རེ་དང་ཚིག་འགའ་རེའི་དག་བཅོས་ཀྱི་བསམ་འཆར་ཡིན་ན་གཙོ་སྒྲིག་པས་ཐག་གཅོད་བགྱིས་ནས་དག་བཅོས་བྱས་ཆོག་ལ།",
    "སཾཉྙོབབསྤྱིར་གླིང་སྒྲུང་གཅེས་བཏུས་ཀྱི་དེབ་བཞི་བ་ཧོར་གླིང་གཡུལ་འགྱེད་བ་འདི་སྒྲུང་དཔེ་ཀུན་ལས་ཆེས་ལེགས་པའི་མ་དཔེར་གྱུར་པ་ནི་བདག་དང་ཆབ་འགག་རྟ་མགྲིན་གཉིས་ཀྱི་ལེགས་སྒྲིག་གི་གྲུབ་འབྲས་ཙམ་མིན་པར།",
    "དེ་ཡང་གཙོ་བོ་སྔོན་བྱོན་མཁས་པ་དམ་པས་ལེགས་སྒྲིག་གི་རྨང་གཞི་བཏིངས་པ་བཟང་ཐོག་གཙོ་སྒྲིག་པ་འཇམ་དཔལ་རྒྱ་མཚོ་ལགས་དང་རྡོ་རྗེ་མཁར།",
    "ད་དུང་མི་རིགས་དཔེ་སྐྲུན་ཁང་གི་རྩོམ་སྒྲིག་ས་པ་རྣམས་ཀྱིས་ཀྱང་གང་ནུས་ཀྱིས་རྩོམ་སྒྲིག་ལེགས་པོ་བགྱིས་ཡོད།",
    "འདི་ནི་གླིང་སྒྲུང་འདིར་ཉམས་མེད་གསོན་ཤུགས་ལྡན་ཞིང་མ་འོངས་པར་ཇེ་རྒྱས་ཇེ་ལེགས་སུ་འགྲོ་བའི་རྟགས་མཚན་བཟང་པོ་ཞིག་རེད།",
    "དེ་དག་གི་འབྲི་ཚུལ་དང་འགྲེལ་ཚུལ་སོགས་གཅིག་གྱུར་ཚད་ལྡན་མིན་པ་ལས་གཞན་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་ཀྱང་ཤིན་ཏུ་མང་བར་བརྟེན།",
    "དེའི་ཕྱིར་གེ་སར་སྒྲུང་གི་མིང་བརྡ་ཚད་ལྡན་ཅན་དུ་གཏོང་བ་དང་།",
    "མིང་ཚིག་གི་འགྲེལ་བ་གཅིག་གྱུར་ཡོང་བར་བྱེད་རྒྱུ་ནི་ཤིན་ཏུ་གལ་འགངས་ཆེ་བ་ཞིག་རེད་སྙམ།",
    "བོད་གནའ་རབས་ཀྱི་རྒྱལ་ཕྲན་ཞིག་གི་མིང་ཡིན་ལ།",
    "དེ་ཡང་ཅུང་རྒྱས་པར་བརྗོད་ན་ཁྲ་མོ་གླིང་གི་སྐོར་ལ་ཚད་ལྡན་སྒྲུང་ཡིག་མང་པོ་ལས་འདི་ལྟར་བྲིས་འདུག་པ་སྟེ།",
    "འབྲུ་སྔོན་མོའི་མཎྜལ་སྤུངས་འདྲ།",
    "བོད་མིའུ་གདུང་དྲུག་གི་རུས་མཛོད་མེ་ཏོག་སྐྱེད་ཚལ་ལས།",
    "སྨུག་པོ་ལྡོང་གི་རིགས་ཏེ་བཞི་ཡོད་ལ།",
    "ས་ཡི་ཆ་གླིང་གི་ཡུལ་ཞེས་པ་ནི་སྒང་དྲུག་ལས་ཟལ་མོའི་སྒང་དུ་གྲགས་པ་འདི་ལ་གླིང་ཁྲི་གོང་འོག་བར་གསུམ།",
    "གླིང་ཁྲི་གོང་མའི་ས་ཆ་ནི་ཁམས་སྟོད་འབྲི་ཀླུང་གི་ས་ཆ་རྣམས་དང་།",
    "ཁྲི་དམག་གསུམ་གྱི་དཔུང་གི་བདག་པོ་ཡིན་པས་དེ་ལྟར་གྲགས་སོ།",
    "ཞེས་ཁྲ་མོ་གླིང་གི་རུས་རྒྱུད་དང་གླིང་དཀར་སྟོད་སྨད་བར་གསུམ་གྱི་ས་ཆ་ངོས་འཛིན་བགྱིས་འདུག་པ་དང་།",
    "མིང་ལ་གླེང་རུ་ཞེས་ཐོགས་ནའང་ཕྱིས་སུ་ཡི་གེ་འགྱུར་ནས་གླིང་རུ་ཞེས་གྲགས་པ་བྱུང་ཞེས་ཁྲ་མོ་གླིང་གི་བྱུང་བ་བརྗོད་པའི་ལྟ་བ་ནི་རྣར་འགྲོ་བ་ཞིག་རེད་དོ།",
    "གླིང་གི་ཐོག་མའི་མངའ་ཁོངས་ནི་རྨ་ཆུའི་སྟོད་རྒྱུད་དང་།",
    "དུས་དེར་ས་རྒྱ་ཆུང་ངུ་ཞིག་ལས་མེད་མོད།",
    "འོན་ཀྱང་རྗེས་སུ་གླིང་གེ་སར་གྱིས་རྟ་རྒྱུག་རྒྱལ་འཇོག་གི་རྒྱལ་ཁ་བླངས་ནས་རྒྱལ་པོར་བཞུགས།",
    "འབད་འབུངས་ཀྱིས་རྒྱལ་སྲིད་ཀྱི་བྱ་བར་སྟོབས་ཤུགས་བཏོན་པས་རིམ་གྱིས་གླིང་གི་མངའ་ཐང་དར་ཞིང་མཐར་གླིང་གི་སྟོབས་ཤུགས་ཤིན་ཏུ་རྒྱས་པའི་སྐབས་སུ།",
    "ཤར་ཁྲ་མོ་གླིང་གི་རྒྱལ་པོ་ཡིན་ལ།",
    "ཡབ་སེང་བློན་རྒྱལ་པོ་དང་ཡུམ་འགོག་བཟའ་ལྷ་མོ་གཉིས་ལས་སྐུ་འཁྲུངས་ཞེས་སྒྲུང་རྙིང་མང་པོ་རུ་གསལ་འདུག་ཁོང་གི་ཆུང་མ་སེང་ལྕམ་འབྲུག་མོ་དང་མེ་བཟའ་འབུམ་སྐྱིད་ཟེར་བ་ཆེན་ཆུང་གཉིས་དང་།",
    "མདུང་མོ་ཁམས་གསུམ་དགྲ་འདུལ།",
    "གེ་སར་ཞེས་པའི་གོ་དོན་ལ་དཔྱད་པ་འདྲ་མིན་མང་ཡང་སྒྲུང་ཡིག་ནང་གི་གེ་སར་ཞེས་པ་ནི་གཡུལ་ལས་རྣམ་པར་རྒྱལ་ཞིང་བློ་རིག་གེ་སར་བའམ་དཔའ་ངར་འགྲན་ཟླ་དང་བྲལ་བའི་དོན་ཡིན།",
    "ད་དུང་གེ་སར་དང་རྒྱ་ཚ་ཞལ་དཀར་གཙོ་བྱས་པའི་གླིང་གི་དཔའ་རྟུལ་སུམ་ཅུའི་འབག་སྐུ་དང་།",
    "གླིང་གི་སྐྱ་ལོ་སྟོན་པ་རྒྱལ་མཚན་གྱི་སྲས་སེང་ལྕམ་འབྲུག་མོ་ནི།",
    "མོ་དང་།",
    "གླིང་རྗེ་གེ་སར་རྒྱལ་པོའི་བཙུན་མོ།",
    "ཁོ་མོའི་སྐྱེ་ཡུལ་ནི་འཁྲུངས་གླིང་མེ་ཏོག་ར་བ་ལས།",
    "མཚོ་སྐྱ་རེངས་ཁ་རུ་སྐྱ་ལ་བསྡད།",
    "མཚོ་སྔོ་རེངས་ཁ་རུ་སྔོ་ལོ་བསྡད།",
    "མཚོ་གྲོ་རེངས་ཁ་རུ་གྲོ་ལོ་བསྡད།",
    "ཁོ་མོའི་མཚན་ལ་སེང་ལྕམ་འབྲུག་མོ་ཐོགས་དོན་ཡང་སྒྲུང་དཔེ་རུ་འདི་ཡོད།",
    "ང་སེང་ལྕམ་འབྲུག་མོ་ཐོགས་དོན་དེ།",
    "དོག་མོ་ས་ནས་ལྕམ་གཅིག་སྐྱེས།",
    "སེང་ལྕམ་འབྲུག་མོ་དེ་ནས་ཐོགས།",
    "ཁོ་མོ་སྐྱེས་པ་ནས་གཞུང་རྒྱུད་སྨྱུག་མ་ལྟར་དྲང་ཞིང་།",
    "ལང་ཚོ་དབྱར་གྱི་དཔལ་ལ་འགྲན་ཞིང་གཟུགས་བྱད་རི་མོ་བྲིས་པ་དང་ཁྱད་མ་མཆིས།",
    "ཁྱོད་འདྲའི་ན་ཆུང་མཚར་མོ་ཞིག།",
    "དེ་སྐྱེས་ཀྱང་ཁྱོད་འདྲ་འོང་ལུགས་མེད།",
    "ཁྱོད་སྒྲོལ་མ་དཀར་མོའི་སྐྱེས་མཐའ་ཡིན།",
    "ལྷའི་བུ་མོ་མི་ཡུལ་འོངས་པ་འདྲ།",
    "ཞེས་སེང་ལྕམ་འབྲུག་མོའི་མཛེས་ཤིང་སྡུག་པའི་བཞིན་རས་དང་ཉམས་འགྱུར།",
    "གླིང་གི་ཇ་མཁར་རིང་མོ་ཧོར་ལ་ཤོར་རྗེས་གླིང་གི་འབངས་མི་ཐམས་ཧོར་གླིང་གཡུལ་འགྱེད་ཀྱི་མིང་བརྡ་གཙོ་བོའི་འགྲེལ་བཤད།",
    "ཁོ་མོ་གཅིག་པུ་འཇིགས་སྐྲག་ཅི་ཡང་མེད་པར་ཧོར་གྱི་དམག་སྒར་དུ་སོང་ནས་ཞི་མཐུན་ཡོང་རྒྱུའི་རེ་བ་བཏོན་ཡང་ཕན་རང་ཉིད་ཧོར་ཡུལ་དུ་ཡུན་རིང་འདུག་དགོས་བྱུང་ཡང་གླིང་མ་ནུས་ཤིང་།",
    "གླིང་གི་སྐྱ་ལོ་སྔ་ལོ་གྲོ་ལོ་ཟེར་བའི་སྤུན་གསུམ་ཡོད་པ་ལས་སྔོ་ལོའི་བུ་མོ་ཡིན་ཞིང་།",
    "སྐྱ་ལོའི་འབྲུག་མོ་དང་ནེའུ་ཆུང་གཉིས་ཕ་སྤུན་ཡིན།",
    "བཙུན་མོ་འབྲུག་མོའི་གཡོག་མོ་ཡིན།",
    "ནེའུ་ཆུང་གིས་སྤྱི་དཔོན་རྒྱལ་པོའི་བཀའ་བཞིན་འབྲུག་མོར་བརྫུས་ནས་ཞི་མཐུན་ཡོང་བའི་སླད་དུ།",
    "མོ་ནི་ངང་རྒྱུད་འཇམ་ཞིང་ལྟ་ན་སྡུག་པ་ཞིག་ཡིན་ལ།",
    "ལྡོང་གི་མ་ཡིག་ལས།",
    "གཡས་ནས་ས་ནག་གི་ཆུ་གཉིས་མདུན་དུ་དར་དཀར་གྱི་མདུད་པ་བསྣོལ་བ་ལྟར་གསེར་ལྡན་རྨ་ལུང་ཕྱུག་མོར་མ་འབབ་པ་ལས་རྨ་ས་བཟུང་དར་གྱི་མདུད་པ་ཞེས་བརྗོད་པ་འབྲེལ་ཆགས་ཤིང་དོན་ལ་ཡང་དེ་ལྟར་གནས་སོ།",
    "བྱང་གི་རི་ལ་བལྟས་ན་ཁྲ་ཕྲུག་སྟོང་གི་གཤོག་པ་བརྡབས་འདྲ།",
    "འབྲུག་ཕོ་ཆུང་ཀླད་ནས་སེང་དཀར་མོ་གངས་ནས་འགྱིང་འདྲའི་ཡུལ་འཛོམས་པོ་མཆོག་ཏུ་ལྡིང་འདྲ།",
    "ད་དུང་འོང་བ་ཞིག་མ་བསྒྲིགས་ལྷུན་གྱིས་གྲུབ་པ་ཇི་བཞིན་བཞེངས་སོཐོག་ཁང་སོ་དྲུག་གི་ཀླད་དུ་མཆོད་ཁང་གཞལ་དུ་མེད་པ་ཞིག་བཞེངས་ཡོད་ལདེའི་ནང་དུ་གསེར་འབུམ་ཉི་མ་ཤར་འདྲ།",
    "མཁར་༧༧ སྟེང་གི་ཞེང་ལ་ཕལ་ཆེར་ཕོ་འདོམ་ལྔ་དྲུག་ཙམ་མཆིས།",
    "ད་དུང་ས་དེ་རུ་ཁྲོ་ཐུང་གིས་བཀོལ་མྱོང་བའི་ཁྲོ་ཟངས་ངོ་མ་ཞིག་ཀྱང་མཐོང་རྒྱུ་ཡོད་ཟེར།",
    "རྩྭ་རྩི་ཏོག་གིས་ས་གཞི་ཁེབས་པ་ཞིག་འདུག་ཅེས་ཆགས་སའི་གཞི་གསལ་བོར་ངོས་འཛིན་གནང་ཡོད།",
    "མཁར་གྱི་ཕྱོགས་བཞི་མཚམས་བརྒྱད་དུ་མ་འོངས་ཕྱི་ན་འབྱུང་གི་རྟགས་མཚན་རེ་རེའི་གཟུགས་བརྙན་གསལ་བོར་བཞེངས་ཡོད་གསུངས།",
    "མཁར་གྱི་ནུབ་བྱང་གཉིས་ཀྱི་མཚམས་སུ་སྟག་སྤྱན་གཅིག་ཅན་གྱི་གོང་ན་སེང་གེ་དཀར་མོ་ཞིག་དང་ཁྱུང་ཞིག་གིས་མནན་འདུག་པའི་གཟུགས་བརྙན་ཡོད་པ།",
