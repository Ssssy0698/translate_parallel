    "གཡུང་དྲུང་སེམས་དཔའ་ལྔ་སྟོང་བཞུགས།",
    "ཚོགས་ཀྱི་འདུ་བ་ཆེན་པོ་བཞུགས།",
    "ཁྱད་པར་གནས་འདི་གསོལ་བསྟོད་བྱ།",
    "ཁྱད་པར་སྦས་གནས་རྩེ་དྲུག་ལ།",
    "ཁྱད་པར་ཞིང་སྐྱོང་སེང་གདོང་མ།",
    "བསྟན་འཛིན་འཕྲིན་ལས་རྒྱས་པར་འགྱུར།",
    "བྱད་ཁ་བཟློག་ལ་བརྩོན་པར་མཛོད།",
    "བསྟན་པའི་ཕྲིན་ལས་རྒྱས་པར་འགྱུར།",
    "ཐབས་ཀྱིས་སྤང་བླང་ཤེས་པར་མཛོད།",
    "ཁྱད་པར་འཆི་མེད་ཡབ་སྲས་གསུམ།",
    "ཞལ་གྱིས་བཞེས་བཞིན་བཀའ་གཏད་བཅས།",
    "ལས་འཕྲོ་ཅན་ལ་འཕྲད་པར་ཤོག།",
    "མེ་སྟག་ཧོར་ཟླ་ལྔ་པའི་ཚེས་༢ཉིན་པར།",
    "ཡར་ཕྱིན་གནས་ལ་འགྲོ་གསུངས་ནས།",
    "སྟོན་པ་ཁྲི་གཙུག་རྒྱལ་བ་བཞུགས།",
    "གཡས་གྲལ་རིག་འཛིན་གྲུབ་ཐོབ་བཞུགས།",
    "བདག་ལ་ཚོགས་གཏོར་བདུད་རྩི་གནང་།",
    "དེ་ནས་མཁའ་འགྲོ་དེ་ཡིས་འདི་སྐད་གསུངས།",
    "མཁའ་སྤྱོད་ལམ་སྣ་ཟིན་པར་འགྱུར།",
    "ཞེས་གསུངས་གསལ་སྣང་དབྱིངས་སུ་ཡལ།",
    "གསལ་སྣང་གང་བྱུང་བཅོས་མེད་པར།",
    "བསྟན་པ་རིན་ཆེན་འཛམ་བུ་གླིང་དུ་ཕེབས།",
    "དེ་ལྟར་གླང་གླིང་ཆེན་ཁྱད་པར་ཆེ་བ་ཡི།",
    "བསྟན་པ་གང་ཡང་གནས་མཆོག་ཁྱད་པར་ཆེ།",
    "བསྟན་པ་རིན་ཆེན་ཕེབས་དང་གནས་པ་སོགས།",
    "དེ་ཡང་མ་ཡིན་ཁྱད་པར་དེ་བས་འཕགས།",
    "ཁྱད་པར་གང་གངས་ཅན་རི་བོ་ཉེ་བ་ནི།",
    "གཤེན་རབ་བསྟན་པ་རིན་ཆེན་བྱ་བ་བྱས།",
    "ཟབས་ཟབ་པའི་གདམས་པ་མང་པོ་ངེས་པར་འཐོབ་ཐོབ།",
    "དཀར་ཆགས་ཆག་འདི་ནི་ས་སྟེང་ཐོན་པར་འོང་།",
    "དེ་ལྟར་ཁྱེད་ཁྱད་པར་ཆེ་བའི་མི་འགྱུར་གཟེར།",
    "གང་གངས་ཅན་རི་བོ་སྤུན་བདུན་བཞུགས་པ་ནི།",
    "གཡུང་དྲུང་བོན་གྱི་བླ་རི་ངེས་པར་ཡིན།",
    "དེ་ལྟར་ཁྱད་པར་སྤུ་རྒྱལ་རི་བོ་ནི།",
    "བྱང་འབྲོག་ནམ་མཁའི་དགྲ་ཚོགས་ཕམ་པར་འོང་།",
    "མང་དུ་ཡོད་ཀྱང་ཁྱད་པར་ཏིང་འཛིན་གྱིས།",
    "དེའི་ཆ་ལགས་ལག་ཉེ་བར་རྒྱུད་བརྒྱུད་པ་ནི།",
    "ཐུག་ཐུགས་ཉིད་ཡིད་ཙམ་རྒྱུ་བའི་ཁྱད་པར་ནི།",
    "། རྗེ་བཙུན་ཤེས་རབ་རྒྱ་མཚོའཇམ་དཔལ་དགྱེས་པའི་བློ་གྲོས་ཀྱི་གསུང་རྩོམ་པོད་དང་པོ་བཞུགས་སོ།",
    "མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་། ། རྗེ་བཙུན་ཤེས་རབ་རྒྱ་མཚོ་འཇམ་དཔལ་དགྱེས་པའི་བློ་གྲོས་ཀྱི་གསུང་རྩོམ་པོད་དང་པོ་བཞུགས་སོ།",
    "སྨྲ་བ་ངན་པ་རྣམ་པར་འཐག་པ་མི་ཤིགས་རྡོ་རྗེའི་ཐོག་མདའ།",
    "ཐོག་མའི་བསྐུར་ཡིག་ལོག་པར་སྨྲ་བ་ཚར་གཅོད་པའི་རལ་གྲི་རྣོ་ངར་འབུམ་ལྡན།",
    "ཐམས་ཅད་མཁྱེན་པ་ལྷ་ཡི་ལྷར་གྱུར་ཤཱཀྱ་སེངྒེའི་ཞབས་ཀྱི་པདྨོ་དྲི་མ་མེད་ལ་སྤྱི་བོས་གཏུགས།",
    "རྒྱལ་བའི་བཀའ་སྡུད་རྒྱལ་སྲས་ཀུན་དང་ཀུན་མཁྱེན་གསུང་གསང་བདུད་རྩིའི་མཚོ་ལས་མཛེས་པར་འཁྲུངས།",
    "མགོན་དེའི་གཞུང་ལུགས་རྣམ་ཀུན་མཁྱེན་པའི་དགོངས་བཅུད་འབུམ་ཕྲག་རབ་འཁྱིལ་ཞིང་།",
    "ཤེས་བྱ་མ་ལུས་མཁྱེན་པའི་གྲ་གཅིག་ཏུ།",
    "སྒྲིབ་པའི་འབོད་སྒྲོག་རྣམ་པར་ཕམ་པའི་སྒྲ།",
    "སོ་སོར་ཡང་དག་པར་རིག་པ་བཞིའི་འོད་སྣང་མཆོག་ཏུ་འབར་བས་གདུལ་བྱའི་བློ་གྲོས་ཀྱི་པདྨོ་རྣམ་པར་འབྱེད་པའི་ཉི་མ།",
    "ལྷ་གཞལ་ཡས་ཁང་སོགས་འགྲུབ་པར་འགྱུར།",
    "ཞེས་གསུངས་པའི་ཕྱིར།",
    "ཅེས་གསུངས་ཏེ།",
    "ཞེས་སོགས་རྒྱ་ཆེར་གསུངས་ལ།",
    "ཞེས་སོགས་རྒྱ་ཆེར་གསུངས་པའི་ཕྱིར།",
    "བས་པར་སྨྲ་ལ་སྨྲ་བའི་དམ་པའང་རྟུལ།",
    "མཁྱེན་རབ་རལ་གྲི་ཅན་དེ་སུ་ཞིག་གཞལ།",
    "འཇམ་དབྱངས་རྣམ་བདུན་མཛེས་པར་འགྱུར་རོ་ཞེས།",
    "བློ་གཏེར་སྨྲ་བའི་སེངྒེར་གསལ་བར་བྱས།",
    "དེ་ཡི་ཡེ་ཤེས་སྤེལ་དང་སྐྱེད་པ་ལགས།",
    "དེ་ལ་བསྔགས་པ་མི་ཟད་མཁས་པས་གསུངས།",
    "རྫོགས་སྨིན་སྦྱངས་པའི་ཁྱད་པར་མཐའ་ཡས་པ།",
    "རྫོགས་པར་སྨྲ་བའི་དབྱངས་ཀྱི་ཡན་ལག་གང་།",
    "རྫོགས་པར་གཞལ་དུ་ཡོད་སྙམ་བྱིས་པའི་བློ།",
    "མཚར་སྡུག་འགྲན་པར་རློམ་ཡང་རྨོངས་པས་མིན།",
    "འོད་དང་བཅས་པས་འཁོད་ནས་ལྟ་བཞིན་པར།",
    "བཟང་པོའི་ཡན་ལག་དྲུག་ཅུའི་རྣམ་པར་འཕྲུལ།",
    "གཞི་དང་ཁྱད་པར་མ་འདྲེས་བཀྲ་བ་མཚར།",
    "སྣང་བ་སྟོང་པའི་རྣམ་འགྱུར་མ་ལགས་པར།",
    "དེ་བཞིན་གཤེགས་པའི་འཁོར་མང་མགུ་བར་བྱས།",
    "དེ་རིང་གཡོ་བ་དོན་དང་ལྡན་པར་འཁུམས།",
    "ལ་འུར་སྙོམས་པར་འཇུག་ཅིང་ལྡང་བའི་ཚུལ།",
    "འཇམ་དབྱངས་གཞོན་ནུའི་མཁྱེན་བརྩེའི་ནུས་པ་ཀུན།",
    "ཀུན་མཁྱེན་རྒྱལ་བའི་སྐྱེད་ཡུམ་དབྱངས་ཅན་མ།",
    "དུས་མཁྱེན་འབྲུག་སྒྲའི་དབྱངས་ཀྱི་རྒྱལ་པོ་ལ།",
    "སྲིད་དང་ཞི་བའི་མགོན་པོ་ཐོབ་པར་མཛོད།",
    "ཡིད་སྨོན་མ་ལུས་ལྷུན་གྱིས་འགྲུབ་པར་གསོལ།",
    "སྤྲུལ་པའི་ངོ་མཚར་ཡིད་ལ་བྱས་པའི་དགེས།",
    "སྐྱེ་བ་ཀུན་ཏུ་རྗེ་བཙུན་མཁྱེན་པའི་གཏེར།",
    "སྐྱེ་མེད་བཟོད་པ་ཐོབ་ཕྱིར་འདོམས་པར་ཤོག།",
    "བརྩེ་བའི་རྣམ་པར་ལན་མང་འཛགས་མཛེས་རྒྱལ་བའི་ཉི་མ་དེས།",
    "བློ་གྲོས་སྤོས་ཀྱི་གླང་པོའི་ཕྲག་པར་མཛེས།",
    "བློ་གྲོས་རིན་ཆེན་རྒྱལ་བའི་ཞལ་སྐྱིན་ལགས།",
    "ཟབ་རྒྱས་སྣང་བརྙན་མ་འདྲེས་གཙང་མའི་རིས།",
    "ཐུགས་རྗེའི་ག་བུར་ལྷུག་པར་འཛགས་པའི་རྒྱུན།",
    "རྭ་ཆེན་འཇམ་དཔལ་རྣམ་པར་རོལ་པའི་ལུགས།",
    "སྒྲུབ་གཙང་མའི་ཡོན་ཏན་དེར།",
    "མེ་འབར་གནས་ལ་བཞུགས་པའི་གཏེར་ཕྱེ་ནས།",
    "དུས་གསུམ་ཤེས་བྱའི་རྣམ་པ་མ་ལུས་པར།",
    "ལས་ཀྱི་རྣམ་པར་བརྫུས་པའི་སྙུན་གྱི་གཞིས།",
    "ཇི་ལྟ་ཇི་སྙེད་རྣམ་ཀུན་མཁྱེན་པས་མཁས།",
    "བརྩེ་ཆེན་གྱི་རྫས་འདྲར་གསུངས།",
    "རིགས་ཕུན་སུམ་ཚོགས་པར་སྐྱེ་བ་བཞེས་པའི་ཚུལ།",
    "གནས་འདི་དང་ལྷ་ལྡན་སྐྱིད་ཆུ་ཐོན་པའི་ངེད་ཀྱི་གནས་རྙིང་འདབ་འབྲེལ་ཤར་ཞེས་པ་ལ་དགའ་བ་བརྒྱ་ལྡན་གྱི་དྲུང་འཛིན་ལྕགས་རི་ཤར་ཞེས་པར་འདི་ཚེས་བཅུ་གསུམ་གྱི་ཉིན་དར་འདི་དང་།",
    "དེ་དང་མཐུན་པར་མ་རུངས་རྣམ་གནོན་གནོད་སྦྱིན་ཐོས་སོ།",
    "རྒྱུན་བཞེས་ཕྱག་ཕྲེང་དང་ཕྱག་དྲིལ།",
    "རྒྱལ་བའི་རོལ་པ་ཆེ་བ་དུ་མས་ཁྱད་པར་འཕགས།",
    "ནོར་བུ་གཞོན་ནུའི་རྣམ་པར་འོངས།",
    "སྔོན་སྨྲས་ལས་གཞན་དུ་འགྱུར་བ་མེད་པར་འདྲེ་ངས་ཁས་ལེན་བྱེད།",
    "ངེས་པར་བསམ་གྱིས་མི་ཁྱབ་པའོ།"
  ]
