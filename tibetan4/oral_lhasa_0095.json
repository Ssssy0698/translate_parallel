    "ཁྱད་པར་གྱི་ལམ་གྱི་གནས་སྐབས་ན་ལོག་པར་རྟོག་པ་ཀུན་སྤོང་བས་ལོག་རྟོག་སེལ་བ་བསྟན་ཏོ།",
    "ཐོད་རྒལ་གྱི་སྙོམས་པར་འཇུག་པ་ཚོལ་བ་ཞེས་ཉམས་སུ་བླངས་པའོ།",
    "རྣམ་པར་སྨིན་པ་མ་ཡིན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་དང་།",
    "དེ་ལ་ངོ་བོ་ཉིད་ཀྱི་སྐུ་ནི་རང་བཞིན་རྣམ་པར་དག་པའོ།",
    "ངོ་བོ་ཉིད་ཀྱི་སྐུ་ལ་མཛད་པ་མེད་པས་ན་མཛད་པ་དང་བཅས་པ་ཞེས་བྱ་བར་མི་འཐད་པར་འགྱུར་རོ།",
    "དེས་ན་མཛད་པ་དང་བཅས་པ་ཞེས་གསུངས་པས་སྐུ་ནི་རྣམ་པ་བཞི་ཉིད་དུ་བཞེད་པ་ཡིན་ནོ།",
    "དེ་ལ་བསྟན་པའི་རིམ་པ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་འབྲས་བུར་དང་པོར་བསྟན་ནས་རྒྱུ་ཕྱིས་འཆད་པའོ།",
    "འགྲོ་འགྱུར་ཡུམ་དེར་ཡུན་རིངས་བཏུད་ནས་འཁྲུལ་སྤངས་བློ་ཡིས་དེ་འགྲེལ་རྒྱས་པར་བྱ།",
    "དེ་ཉིད་ཕྱིར་ན་བདག་ཀྱང་འདི་ལ་ངེས་པར་འཇུག་རིགས་ཏེ།",
    "དེ་ནས་ཡང་ཞེས་བྱ་བ་ནི་རྒྱས་པར་བསྟན་པའི་མཇུག་ཐོགས་སུའམ།",
    "དངོས་པོ་ཐམས་ཅད་ཕྱིན་ཅི་མ་ལོག་པར་ཡོངས་སུ་གཅོད་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "བརྩོན་འགྲུས་ཕུན་སུམ་ཚོགས་པ་ནི་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པས་རབ་ཏུ་ཕྱེ་བ་བྱ་བ་སྒྲུབ་པའི་ཡེ་ཤེས་ཡིན་ཏེ།",
    "དེ་ལས་གཞན་པས་བསྟན་ན་ལོག་པར་བསྟན་པར་དོགས་པས་མ་དད་པར་འགྱུར་རོ།",
    "ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་སྟོན་ཞིང་དེའི་ཚེ་ཚིགས་སུ་བཅད་པ་འདི་དག་བཀའ་སྩལ་ཏོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "སྔར་རྒྱས་པར་བསྟན་པ་གང་དག་ཡིན་པ་དེ་དག་ཉིད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་དག་སྟོན་ཅིང་ཞེས་བྱ་བ་ནི་གང་ཟག་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པས་དབེན་པར་སྒྲོགས་ཤིང་ངོ།",
    "དེ་ནི་རྣམ་པར་རྟོག་པ་ལས་འདས་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་དང་ཐོས་མ་ཐག་ཏུ་ཡང་མི་སྐྱེ་བའི་ཕྱིར་རོ།",
    "བདག་མེད་པར་ཡིད་ཆེས་པ་ནི་འཇིག་རྟེན་ལས་འདས་པ་དང་ཅིག་ཤོས་ཀྱི་གནས་སྐབས་དག་ཏུ་ཁྱད་པར་དུ་རྟོག་པ་མེད་པར་སྐྱེ་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བས་ན་རྣམ་པར་རྟོག་པ་དེ་ལྟ་བུ་འཇུག་པ་ལ་ལྟོས་ཏེ་ཐ་སྙད་ཀྱི་སྒོ་ནས་ཤེས་རབ་བླ་ན་མེད་པ་རབ་ཏུ་སྟོན་པ་ལ་འགལ་བ་ཅི་ཡང་མེད་དོ།",
    "སྔོན་གོམས་པ་ཡོངས་སུ་བསྒོམས་པའི་སེམས་དང་ལྡན་པ་རྣམས་ལ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྟན་པ་ཐོས་མ་ཐག་པ་ཁོ་ནར་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་སྐྱེ་བའི་ཕྱིར་དེ་བསྟན་པ་དངོས་སུ་ཡང་མི་འགལ་ཏེ།",
    "ཡང་ཅིའི་ཕྱིར་སྔར་ཡང་རྒྱས་པར་བསྟན་ཟིན་པ་འདི་སྟོན་ཞེ་ན།",
    "མངའ་བ་ཉིད་དུ་རྟོགས་ནས་གུས་པ་དང་བཅས་པའི་སེམས་དང་ལྡན་པ་རྣམས་ཀྱིས་དགའ་བ་གང་ཡིན་པ་དེ་ནི་ཡང་དག་པར་དགའ་བ་ཡིན་ཏེ།",
    "དེ་ལྟ་བས་ན་ཚིག་འདིས་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་བརྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "ཡང་དག་པར་དགའ་བ་བླ་ན་ཡོད་པ་དང་བླ་ན་མེད་པ་ནི་བརྒྱུད་པས་ཡིན་ནོ།",
    "ཡང་འདིར་བརྗོད་པར་བྱ་བ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ཡང་ཇི་ལྟར་ཤེས་ཚིགས་སུ་བཅད་པ་དེ་དག་ཀྱང་གང་ཡིན་ཞེ་ན།",
    "དགའ་དང་གུས་དང་དད་པའི་མཆོག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རབ་ཞི་ཞེས་བྱ་བ་ནི་ཉན་པ་དང་མཐུན་པའི་སྤྱོད་ལམ་ལ་རྣམ་པར་གནས་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྣམ་ཀུན་མཁྱེན་ཉིད་ལམ་ཤེས་ཉིད།",
    "དེ་ལ་ཤེས་རབ་བསྒྲུབ་པའི་དགོས་པ་མཐར་ཐུག་པ་ནི་སེམས་བསྐྱེད་པ་ལ་སོགས་པ་རྒྱུ་དང་འབྲས་བུའི་རྣམ་པ་མཐའ་དག་ཡོངས་སུ་གཅོད་པའི་ངོ་བོ་ཡིན་པས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡིན་ནོ།",
    "ཐུབ་པའི་རྣམ་ཀུན་མཁྱེན་པ་ཉིད།",
    "དེ་ལ་ཉན་པ་པོའི་སྐྱེ་བོ་ཉན་ཐོས་ལ་སོགས་པ་ལས་ཁྱད་པར་དུ་འཕགས་པར་སྟོན་པའི་སྒོ་ནས་སེམས་བསྐྱེད་པ་བསྟན་པའི་ཕྱིར།",
    "འགྲོ་དོན་མངོན་ཞུགས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདི་ལྟར་ཉན་ཐོས་ཀྱི་ས་ལ་སློབ་པར་འདོད་པས་ཀྱང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཉིད་མཉན་པར་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ན་དེ་ཇི་ལྟར་འགྲོ་དོན་མངོན་ཞུགས་ཞེས་བྱ་ཞེ་ན།",
    "དེས་པའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཇི་ཞིག་ནི་ཁྱད་པར་དུ་འཕགས་སྙམ་པ་ལ།",
    "གང་ལ་དཔའ་རྣམས་སྤྱོད་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "སྤྱོད་པ་ཞེས་བྱ་བ་ནི་ས་དང་ཕ་རོལ་ཏུ་ཕྱིན་པ་གོམས་པའི་ཁྱད་པར་གྱིས་འཇུག་པའོ།",
    "དེ་ཉིད་ཀྱི་ནང་དུ་དེ་ལས་གཞན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་འདུས་པའི་ཕྱིར་ཏེ་དེ་བཞིན་དུ་འཆད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ཡིན་ནོ།",
    "དེ་སྤང་བའི་ཕྱིར་འཛམ་བུའི་གླིང་འདིར་ཆུ་ཀླུང་ཇི་སྙེད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མེ་ཏོག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "མཆོག་འཕགས་བདེ་བ་བྱེད་དང་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཇི་སྙེད་འབྲས་བུ་གྲུབ་པ་ཡང་ཞེས་རྣམ་པར་དབྱེ་བས་བསྒྱུར་ནས་སྦྱར་བར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འདི་ལྟར་ཉན་ཐོས་དེ་ཁོ་ན་ཉིད་མ་རྟོགས་པ་རྣམས་ཀྱང་རྒྱལ་བའི་སྲས་ཀྱི་ཚུལ་འབྲས་བུ་དང་བཅས་པ་རབ་ཏུ་སྟོན་པར་བྱེད་པས་བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ཀྱི་བྱིན་གྱི་རླབས་ཀྱི་ཐུགས་ཀྱི་མངའ་བ་འདི་ནི་མཆོག་ཡིན་པར་གསལ་བ་ཁོ་ནར་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ་དེ་ལྟ་བུ་ནི་སྨོན་པ་དང་འཇུག་པའི་བདག་ཉིད་ཀྱི་སེམས་བསྐྱེད་པ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤེས་རབ་ནི་འགྲོ་བ་ཐམས་ཅད་བདག་མེད་པར་རྟོགས་པའི་མཚན་ཉིད་དོ།",
    "ཞེས་གང་གསུངས་པ་ལྟ་བུ་ཡིན་ནོ།",
    "ཕུང་པོ་ལ་སོགས་པ་ཞིག་ཡིན་པར་འགྱུར་གྲང་།",
    "སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་བཞིན་དུ་མིག་ལ་སོགས་པའི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པའི་རྗེས་སུ་མི་བྱེད་པའི་ཕྱིར་དང་ཡོངས་སུ་མི་གསལ་བའི་རྣམ་པ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "འདི་ནི་སྔོན་པོ་མཐོང་བ་ན་སྔོན་པོར་རྟོགས་པའི་བློ་བཞིན་དུ་བདག་གཞན་མཐོང་བའི་རྗེས་སུ་འགྲོ་བ་ཡིན་པའི་ཕྱིར་རྣམ་པར་རྟོག་པའི་བདག་ཉིད་ཀྱི་མངོན་སུམ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་ལས་གཞན་པ་ལས་ཐ་དད་པ་སྔོན་པོ་ལ་སོགས་པ་རྣམ་པ་ཡོངས་སུ་གསལ་བར་མཐོང་བ་ལ་འདི་ནི་སེར་པོ་ལ་སོགས་པ་ལ་ཐ་དད་པའི་ཡོན་ཏན་ཡིན་ནོ་ཞེས་བྱ་བར་ཤེས་པ་ནི་མངོན་སུམ་གྱི་ཐ་སྙད་ཀྱི་ཡུལ་ཅན་ཡིན་པར་འགྱུར་རོ།",
    "ཤེས་པ་ཙམ་མངོན་སུམ་ཉིད་ཡིན་ན་ནི་རྟོག་པ་ཐམས་ཅད་མངོན་སུམ་གྱི་ཐ་སྙད་ཀྱི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་འཁྲུལ་པའམ་མ་འཁྲུལ་བ་ཅུང་ཟད་ཀྱང་མེད་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་ལུས་ལ་སོགས་པ་ཀུན་ཏུ་རིག་པ་ལས་བདག་ཐ་དད་པར་མ་གྲུབ་ན་ཐ་དད་པའི་བློ་འཁྲུལ་པ་ཡིན་ནོ།",
    "དུས་ལ་སོགས་པས་སོ་སོར་ངེས་པར་ཁྱད་པར་དུ་བྱས་པའི་བདེ་བ་ལ་སོགས་པའི་གནས་སྐབས་ལས་མ་གཏོགས་པར་རྗེས་སུ་འགྲོ་བའི་བདག་ཉིད་གཅིག་པོ་མི་སྣང་བའི་ཕྱིར་དང་།",
    "དོན་ལྐོག་ཏུ་གྱུར་པ་ལ་རྟགས་ཀྱིས་སྐྱེད་པའི་ཤེས་པ་ནི་རྗེས་སུ་དཔག་པ་ཡིན་ན་བསྒྲུབ་པར་བྱ་བའི་བདག་ལ་ནི་རྟགས་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "དེ་ལྟ་ན་ནི་སྐད་ཅིག་མ་གཉིས་པ་ལ་སོགས་པ་འདོད་ཆགས་ལ་སོགས་པ་ཉེས་པའི་རྒྱུན་མེད་པས་འགྲོ་བ་མ་ལུས་པ་འབད་མི་དགོས་པར་མྱ་ངན་ལས་འདས་པའི་ཕུན་སུམ་ཚོགས་པ་ཡང་དག་པར་ཐོབ་པར་འགྱུར་ཏེ།",
    "སྔོན་དྲན་པ་ལ་སོགས་པ་སྐྱེད་པར་བྱེད་པའི་དེ་འབྱེད་པ་སྐད་ཅིག་མ་ཕྱིན་ཆད་དེ་མི་བྱེད་པའི་ཕྱིར་རོ།",
    "ཟླ་བ་གཉིས་ལ་སོགས་པར་སྣང་བ་ཕྱི་རོལ་གྱི་གཟུགས་ཉིད་དུ་དོན་བྱེད་པ་དང་བྲལ་བ་དག་དངོས་པོ་ཉིད་དུ་ཡང་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "འདིས་ནི་ཕུང་པོ་ལ་སོགས་པ་ཡང་རྟག་པའི་ཕྱོགས་ཉམས་པའི་ཕྱིར་བདག་ཏུ་ལྟ་བའི་དམིགས་པ་ཉིད་ཡིན་པ་བཀག་པར་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "དེ་སྐྱེ་བ་ལ་ཕུང་པོ་ལ་སོགས་པར་སྣང་བ་མ་བརྟགས་གཅིག་པུ་ན་དགའ་བ་ནི་ཇི་ལྟར་མཐོང་བ་བཞིན་རྒྱུ་ཡིན་པ་ཉིད་དོ།",
    "ངོ་བོ་གཞན་ཡོངས་སུ་འཛིན་པར་ལྷག་པར་ཞེན་པ་ལ་ལྟོས་ནས།",
    "དེ་ལྟ་བས་ན་དེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་བལྟ་བར་བྱ་དགོས་པ་ཁོ་ནའོ་ཞེ་ན།",
    "རྨོངས་པ་ནི་ཡང་དག་པར་མ་རྟོགས་པའོ།",
    "སྐྲག་པ་ནི་འཇིགས་པར་ལྟ་བ་ཉིད་དོ།",
    "དམིགས་པའི་ཁྱད་པར་གྱིས་ནི་དངོས་པོ་ཐམས་ཅད་མི་རྟག་པ་ལ་སོགས་པའི་རྣམ་པར་དམིགས་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ལྷག་མ་རྣམས་ལ་ཡང་ཅི་རིགས་པར་ཁྱད་པར་བཞིས་ཤེས་པར་བྱའོ།",
    "གཟུགས་མེད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡན་ལག་ལས་མ་གཏོགས་པའི་ཡན་ལག་ཅན་ཞིག་རབ་ཏུ་གྲུབ་པར་རྟོག་ན་ནི་དུ་མ་ཉིད་ཉམས་པ་མེད་དོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "དེ་མ་ཡིན་པའི་རྣམ་པར་སྣང་བའི་ཕྱིར་རོ།",
    "ཡན་ལག་ཅན་མངོན་སུམ་མ་ཡིན་པ་དང་འབྲེལ་པ་རབ་ཏུ་གྲུབ་པའི་རྟགས་ཀྱང་ཅུང་ཟད་ཀྱང་མེད་ལ་རྟགས་དང་རྟགས་ཅན་འབྲེལ་པ་རྟོགས་པ་མེད་པར་ཡང་རྗེས་སུ་དཔག་པ་མི་འཇུག་པའི་ཕྱིར་རོ།",
    "སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་ན་ཡན་ལག་མེད་པའི་རྡུལ་ཕྲ་རབ་ཀྱི་གཟུགས་ཅུང་ཟད་ཀྱང་མི་དམིགས་ཏེ།",
    "སྔོན་པོ་ལ་སོགས་པ་རགས་པར་སྣང་བ་ཉིད་དུ་ཤེས་པའི་ཕྱིར་རོ།",
    "རྡུལ་ཕྲ་རབ་གྲུབ་ན་དེ་བསགས་པའི་བདག་ཉིད་རགས་པ་རབ་ཏུ་འགྲུབ་པར་འགྱུར་གྱི་གཞན་དུ་ནི་མ་ཡིན་ནོ།",
    "སྒྲིབ་པ་ལ་སོགས་པའི་དོན་བྱེད་པར་ཡང་རབ་ཏུ་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "འདི་གཉིས་ནི་ཕན་ཚུན་འགལ་བས་རྣམ་པ་གཞན་རྣམ་པར་གཅོད་པའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་གཟུགས་ཀྱི་ཕུང་པོའི་མཚན་ཉིད་དང་མི་ལྡན་ན་དེ་ལ་རྟེན་ཅིང་དམིགས་པ་ཚོར་བ་ལ་སོགས་པ་ཡང་མཚན་ཉིད་དང་བྲལ་བར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་ལྟར་གཟུགས་ལ་སོགས་པའི་བདག་ཉིད་ཀྱི་གནས་བསལ་ནས་འགོག་པའི་བདེན་པར་བསྡུས་པ་དེ་བཞིན་ཉིད་ལ་སོགས་པའི་ངོ་བོ་ཉིད་ཀྱི་གནས་བསལ་བའི་ཕྱིར་དེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་དག་པར་ན་དེ་དག་ཀྱང་གཟུང་བ་མེད་པ་ལ་སོགས་པ་ཉིད་ཀྱིས་སྟོང་པ་ཉིད་ཀྱི་རྣམ་པ་ཡིན་པའི་ཕྱིར།",
    "གནས་པ་མེད་པར་སྤྱོད་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "འདིའི་ཕན་ཡོན་རབ་ཏུ་བསྟན་པ་ནི་ཀུན་རྫོབ་ཏུ་ཡང་དངོས་པོ་མེད་པར་རྟོག་པ་བསལ་བར་ཤེས་པར་བྱ་སྟེ།",
    "ངག་དེ་ལྟ་བུ་ལ་སོགས་པ་རྫོགས་པའི་བར་དུ་གང་ཅུང་ཟད་ཡོད་པར་བསྟན་པ་དེ་ཐམས་ཅད་ནི་འདི་ལྟ་བུར་དགོངས་པ་ཉིད་དུ་རིག་པར་བྱ་སྟེ།",
    "ཕུང་པོ་རྣམ་པར་འཇིག་པ་ནི་ཕུང་པོ་རྣམ་པ་ཐམས་ཅད་དུ་མི་དམིགས་པ་སྟེ།",
    "འཇིག་རྟེན་ལས་འདས་པ་དང་ཅིག་ཤོས་ཀྱི་ལམ་དག་དངོས་པོར་དམིགས་པའི་བདག་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་སྟོན་པར་བྱེད་དོ།",
    "དེ་ཇི་ལྟར་ན་གང་ཟག་ཙམ་མེད་པར་ལྟ་བ་འཇིག་རྟེན་ལས་འདས་པ་ཉིད་མ་ཡིན་ནམ་ཞེ་ན།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ཡོངས་སུ་རྟོག་པ་ཡང་ངོ་བོ་ཉིད་ཀྱི་སྒོ་ནས་ནི་འདི་ནི་གང་ཡིན་ཞེས་གང་གསུངས་པ་ཡིན་ནོ།",
    "གང་ཞེས་བྱ་བའི་སྒྲ་ནི་སྤོང་བ་ཡིན་པར་བལྟ་བར་བྱ་སྟེ།",
    "དེའི་ངོ་བོ་ཉིད་འཛིན་པ་ལ་སོགས་པའི་རྣམ་པར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "འབྲེལ་པའི་སྒོ་ནས་ནི་སུའི་ཡིན་ཞེས་གང་གསུངས་པ་ཡིན་ནོ།",
    "ཅེས་བྱ་བ་གང་གསུངས་པ་ཡིན་ཏེ།",
    "རྟོག་ཅེས་བྱ་བ་ནི་དཔྱོད་པར་བྱེད་པའོ།",
    "ཞུམ་པ་མེད་ཅིང་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་སེམས་ཙམ་དུ་རྟོགས་པའི་ཕྱིར་ཀུན་ཏུ་རྨོངས་པར་མི་འགྱུར་ཞིང་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མི་ཤེས་བཞིན་དུ་ཞེས་བྱ་བ་ནི་གཟོད་མ་ནས་སྐྱེ་བ་མེད་པའི་དོན་ཁོང་དུ་མ་ཆུད་པར་རོ།",
    "རྟོག་ཅེས་བྱ་བ་ནི་གལ་ཏེ་ཕུང་པོ་དག་ལ་སྟོང་པ་ཉིད་དུ་གཟུང་བའི་བདག་ཉིད་དུ་རྟོག་པར་བྱེད་ན་ཡང་ངོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གང་ཞིག་གཟུགས་མིན་ཚོར་མིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "སེམས་པའི་ཚོགས་དྲུག་སྟེ་ཞེས་གང་གསུངས་པ་ཡིན་ནོ།",
    "གནས་པ་མེད་པར་སྤྱོད་ཅེས་བྱ་བ་ནི་རྟེན་པ་མེད་པར་སྤྱོད་པ་སྟེ།",
    "དེ་ནི་སྤྱོད་པ་མེད་ན་དེ་དང་ལྡན་པའི་བྱེད་པ་པོ་ཡང་སྤྱོད་ཅེས་བྱ་བར་མི་དམིགས་པས་སྤྱོད་ཅེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་པར་བྱེད་པ་པོ་མཚན་མ་མི་དམིགས་ཏེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྒྱས་པར་བསྟན་པ་ལས་ཇི་སྐད་དུ་དེ་ལ་དཔའ་བར་འགྲོ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཞེ་ན།",
    "འདི་ནི་དཔའ་བར་འགྲོ་བ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཞེས་བྱའོ་ཞེས་བྱ་བ་རྒྱས་པར་གསུངས་པ་ལྟ་བུ་ཡིན་ནོ།",
    "དེ་ཉིད་བསྟན་པའི་ཕྱིར་བདག་ནི་མཉམ་པར་གཞག་ཅེའམ་ལངས་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "བདག་ཡོད་ན་དེའི་ངར་འཛིན་པ་ཕྱིན་ཅི་མ་ལོག་པའི་བདག་ཉིད་ཀྱིས་རྣམ་པར་གཡེང་བའི་ངོ་བོ་མ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་དེ་ཀུན་ནས་མི་ལྡང་སྙམ་དུ་བསམ་པ་ཡིན་ནོ།",
    "དེ་སྐད་དུ་དེ་ལ་བདག་ཡོད་ན་དེ་ལ་ངར་འཛིན་པ་འམ་དེ་ལ་ཕྱིན་ཅི་མ་ལོག་པར་འགྱུར་བ་ཞིག་ན་དེ་གཉིས་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པའི་གནས་སྐབས་འདི་དག་ནི་རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་ཕྱིར་མཐོང་བས་སྤང་བར་བྱ་བ་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་གཉིས་དང་མཚུངས་པར་ལྡན་པ་ཡིན་ནོ།",
    "འཛིན་པར་རྣམ་པར་རྟོག་པ་ཡང་རྣམ་པ་གཉིས་ཏེ།",
    "འདི་དག་ཀྱང་གོ་རིམས་བཞིན་དུ་ངེས་པར་འབྱེད་པའི་ཆ་བཞི་པོ་དག་ལ་བལྟ་བར་བྱ་སྟེ།",
    "འདི་ནི་རྣམ་པར་བྱང་བའི་དངོས་པོ་ལ་རྣམ་པར་རྟོག་པ་ཡིན་ནོ།",
    "དམིགས་པ་ཞེས་བྱ་བ་ནི་མི་འགྱུར་ཞེས་བྱ་བ་དང་འབྲེལ་བའི་ཕྱིར་དམིགས་པར་མི་འགྱུར་བ་ཉིད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཇི་ལྟར་ན་བདག་ལ་སོགས་པ་མི་དམིགས་པས་རང་དང་གཞན་ཡོངས་སུ་སྨིན་པ་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱི་སྤྱོད་པར་འགྱུར་ཞེ་ན།",
    "སྐྱེ་བ་རྣམ་པར་དག་པར་རྣམ་པར་རྟོག་པ་ཡིན་ནོ།",
    "བྱིས་པས་དམིགས་པའི་སྤྱོད་ཡུལ་ནི་སྒྲོ་བཏགས་པའི་སྤྱོད་ཡུལ་ཡིན་པའི་ཕྱིར་དེས་སྒྲོ་བཏགས་པས་དབེེན་པར་མཚན་ཉིད་གཅིག་པ་ཁོ་ན་དོན་དམ་པའི་ཡོད་པ་ཡིན་ནོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་མེད་པ་ཞེས་བྱ་བའོ་ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "མེད་པར་རྣམ་པར་རྟོག་པ་ཡིན་ནོ།",
    "བཅོམ་ལྡན་འདས་མ་ལས་ཤཱ་རིའི་བུ་གཟུགས་ནི་ནང་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གང་གསུངས་པ་ཡིན་ནོ།",
    "ཕུང་པོ་ལ་སོགས་པ་དམིགས་པར་རྣམ་པར་རྟོག་པ་ཡིན་ཏེ་སྔ་མ་ཁོ་ན་རབ་ཏུ་སྒྲུབ་པ་ལྷུར་ལེན་པ་ཡིན་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "མེད་དང་ཡོད་པར་བྱེད་ཅེས་བྱ་བ་སྨོས་ཏེ།",
    "མཐའ་གཉིས་ལ་ཆགས་པར་རྣམ་པར་རྟོག་པ་ཡིན་ནོ།",
    "འདི་ཉིད་རང་བཞིན་གྱིས་སྐྱོན་ཆགས་པ་ཉིད་ཡིན་པར།",
    "འདི་སྐད་དུ་གཟུགས་ལ་སོགས་པ་ཡང་དག་པར་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་དེ་དག་ལ་སྒྲོ་འདོགས་པ་སྔོན་དུ་འགྲོ་བ་ཡོད་པ་དང་མེད་པར་རྣམ་པར་རྟོག་པ་དག་ཇི་ལྟར་ཕྱིན་ཅི་མ་ལོག་པའི་ངོ་བོར་འགྱུར་ཏེ།",
    "རྣམ་པ་ཐམས་ཅད་དུ་ཡོད་པ་མ་ཡིན་པ་ལ་ནི་ཡུལ་དང་དུས་དང་རྣམ་པ་ལ་ལྟོས་ནས་མེད་པར་རྣམ་པར་རྟོག་པའམ་ཡོད་པར་རྣམ་པར་རྟོག་པ་དོན་དམ་པ་པ་ཡིན་པར་འོས་པ་མ་ཡིན་ནོ།",
    "འཁོར་གསུམ་རྣམ་པར་དག་པ་དང་བྲལ་ན་སྦྱིན་པ་ལ་སོགས་པ་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཐ་སྙད་ལ་བརྟེན་པ་མ་ཡིན་ཏེ།",
    "འདི་ནི་འཕགས་པའི་ལམ་ལ་མི་གནས་པར་རྣམ་པར་རྟོག་པ་ཡིན་ནོ།",
    "གཟུང་བར་རྣམ་པར་རྟོག་པ་དང་པོ་རྣམ་པ་དགུ་ཡིན་ནོ།",
    "འོ་ན་གང་ཞིག་ངེས་པར་འབྱུང་ཞེ་ན།",
    "དེ་ལྟ་བུ་ནི་གཟུང་བར་རྣམ་པར་རྟོག་པ་གཉིས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་གཟུགས་ལ་སོགས་པ་སྣང་བ་ཙམ་དུ་ཟད་ན་དེ་ཇི་ལྟར་ན་དེ་ལ་བདག་ལ་སོགས་པ་འཛིན་པ་ཉིད་དུ་ཤེས་སྙམ་དུ་དོགས་པའི་སྐབས་འཛིན་པར་རྟོག་པ་དང་པོ་རབ་ཏུ་བསྟན་པའི་སྒོ་ནས་བསལ་བའི་ཕྱིར།",
    "ངོ་བོ་ཉིད་མེད་ཤེས་པར་བྱ།",
    "ཞེས་གང་གསུངས་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་གཞན་ལ་ཡང་རིགས་པར་བྱའོ།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པའི་གནས་སྐབས་ཐམས་ཅད་དུ་ཡོངས་སུ་གཟུང་བ་སྨོས་པ་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཀུན་རྫོབ་ཏུ་འཇུག་གོ་ཞེས་བྱ་བ་འབའ་ཞིག་ལྷུར་བྱ་བའི་དོན་ཡིན་པར་ཟད་དེ།",
    "གཟུགས་ལ་སོགས་པ་ཐམས་ཅད་ལ་ཆགས་པ་ཟད་པ་ནི་རྣམ་པར་རྟོག་པ་སྤོང་བའོ།",
    "རྟོགས་པ་ཆེ་བའི་བདག་ཉིད་ནི་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ལ་སོགས་པའི་མཚན་ཉིད་དེ།",
    "དངོས་སུ་མ་གསུངས་ཀྱང་ཤུགས་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "དེ་ལ་གོ་ཆ་ནི་རྣམ་པ་དྲུག་ཏུ་རིག་པར་བྱ་སྟེ།",
    "གཏོང་བ་ཆེ་ཞེས་གང་གསུངས་པ་ཡིན་ཏེ།",
    "རྣམ་པར་གཡེང་བ་ཉིད་དང་།",
    "དེ་ལ་ཞུགས་པ་ནི་དེ་ལ་སྦྱོར་བ་བྱས་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟར་སྦྱོར་བ་བྱས་པ་ནི་ཚོགས་ཡོངས་སུ་རྫོགས་པར་བྱེད་དེ་དེའི་ཕྱིར་ཞི་གནས་ཀྱི་ཚོགས་གོ་ཆ་ཆེན་པོ་བགོས་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "རྣམ་པར་གཡེང་བ་ཐམས་ཅད་ཀྱིས་མི་འཁྲུགས་པའི་བསམ་པ་ཅན་ཡིན་པའི་ཕྱིར་གོ་ཆ་ཆེན་པོ་བགོས་པའོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "རྩེ་གཅིག་པའི་ཡིད་དང་ལྡན་པས་ནི་བདུད་ཐམས་ཅད་ཟིལ་གྱིས་མནན་པར་ནུས་པའི་ཕྱིར་རོ།",
    "དེ་ཇི་ལྟར་ཕྱིན་ཅི་མ་ལོག་པར་འགྱུར་ཞེ་ན།",
    "སྒྱུ་མ་མཁན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དེ་སྤྲུལ་པ་དག་ལ་ཀུན་ཏུ་རྨོངས་པ་མེད་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "གསད་བྱ་དེ་དག་ཅི་འདྲ་ཞེས་བྱ་བ་ནི་སྒྱུ་མ་བྱས་པའི་གསད་པར་བྱ་བ་དེ་དག་ཇི་ལྟ་བར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྐྱིད་པ་ནི་རབ་ཏུ་དགའ་བ་ལ་སོགས་པས་རྣམ་པར་དག་པའི་མཚན་ཉིད་ཡིན་ཏེ།",
    "གལ་ཏེ་འོ་ན་ཇི་ལྟར་མྱ་ངན་ལས་འདས་པར་འགྲོ་བར་ཐ་སྙད་གདགས་ཤེ་ན།",
    "རྣམ་པར་བྱང་བ་ཡང་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་སེམས་བསྐྱེད་པ་ཕྱིན་ཅི་མ་ལོག་པའི་བདག་ཉིད་ཀྱི་རྣམ་པར་བྱང་བ་ཞིག་དེར་འགྲོ་བར་འགྱུར་རོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "མྱ་ངན་ལས་འདས་པ་མ་ཡིན་པའི་བདག་ཉིད་ཡིན་ན་ནི་རྣམ་པར་བྱང་བར་ངོ་བོ་ཉིད་གཅིག་པ་ཡིན་པས་ཅིའི་ཕྱིར་དེར་འགྲོ་བར་འཐད་པ་མ་ཡིན་ནོ།",
    "འགྲོ་བ་པོ་དང་བགྲོད་པར་བྱ་བ་དག་ནི་གཞི་ཐ་དད་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ནི་གཞན་ཉིད་ཡིན་པར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "རྣམ་པ་ཐམས་ཅད་དུ་མི་དམིགས་པ་ཉིད་མྱ་ངན་ལས་འདས་པར་ཐ་སྙད་གདགས་པའི་རྒྱུ་ཡིན་ནོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བུ་ནི་ཐོབ་པར་བྱེད་པ་བཀག་པ་ཡིན་ནོ།",
    "འདུས་མ་བྱས་ཞེས་བྱ་བ་ནི་གོང་ནས་གོང་མའི་གནས་སྐབས་ཀྱི་ངོ་བོ་ཉིད་དུ་མ་བསྒྲུབས་པས་ཏེ།",
    "དེ་ལྟ་བུ་ནི་ཐོབ་པར་བྱ་བ་བཀག་པ་ཡིན་ནོ།",
    "སྤྲོས་མེད་ཅེས་བྱ་བ་ནི་རྣམ་པར་བྱང་བ་ཐོབ་པར་དམིགས་པའི་སྤྲོས་པ་མེད་པའི་ཕྱིར་ཏེ།",
    "མི་དམིགས་པ་ཁོ་ན་ལྷུར་བྱས་ན་ཐབས་དང་བྲལ་བས་ནམ་ཞིག་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཐོབ་པར་འགྱུར་ཞེ་ན།",
    "ཡང་ཅིའི་ཕྱིར་སྐྱེ་བ་ལ་སོགས་པར་རྟོག་པ་ལས་འདས་པ་ཁོ་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡིན་ཞེ་ན།",
    "དེ་ལ་འདིར་སྒྲིབ་པ་མེད་པའི་ཡེ་ཤེས་གང་ཡིན་པ་འདི་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡིན་ནོ།",
    "འདུས་མ་བྱས་ཀྱི་ཁམས་ནི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་སོ།",
    "གནས་ལ་ཞེས་བྱ་བ་ནི་འདུས་བྱས་དང་འདུས་མ་བྱས་ཀྱི་མཚན་ཉིད་ཀྱི་གནས་ལ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདིར་ནི་རྣམ་པར་རྟོག་པའི་ཡུལ་མ་ཡིན་པའི་བརྗོད་དུ་མེད་པ་ཉིད་མི་གནས་པའི་རྒྱུ་ཡིན་པར་རྟོགས་པར་བྱ་སྟེ།",
    "ལྷའི་བུ་དེ་ལྟར་ན་འདི་ལ་ཅུང་ཟད་ཀྱང་སྟོན་པ་མེད་དོ་ཞེས་བྱ་བ་གང་རྒྱས་པར་གསུངས་སོ།",
    "འདིས་ནི་ཉན་ཐོས་ཀྱི་ལམ་ལས་ཁྱད་པར་དུ་འཕགས་པར་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་ནི་གཟུང་བའི་རྣམ་པར་རྟོག་པ་མ་སྤངས་པའི་ཕྱིར་རོ།",
    "ཐམས་ཅད་སྒྱུ་མ་ལྟ་བུ་མེད་པ་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་ཡིན་ནོ།",
    "ཐམས་ཅད་མཁྱེན་ཉིད་ཆེད་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "འོ་ན་ཅི་ཞིག་འཛིན་པར་བྱེད་ཅེ་ན།",
    "སློབ་ཅིང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་ཡོངས་འཛིན་ལ།",
    "ངེས་འབྱུང་གང་ཡིན་ཞེས་བྱ་བ་ནི་འདི་ལྟར་སྐྱེ་བ་ལ་སོགས་པར་མི་ལྟ་བ་ནི་རྟོག་པ་ཐམས་ཅད་ལས་གྲོལ་ལོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་བཞིན་དུ་བདེན་པ་གཞན་དག་ལ་ཡང་བཟོད་པ་དང་ཤེས་པ་རྟོགས་པ་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "དམིགས་པ་ནི་གཟུང་བའི་རྣམ་པར་བགྲང་བ་གཟུགས་ལ་སོགས་པའོ།",
    "འདུ་ཤེས་ནི་འཛིན་པ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་ཡིན་ནོ།",
    "རྣམ་པར་བཤིག་ནས་ཞེས་བྱ་བ་ནི་བོར་ནས་སོ།",
    "ཕ་རོལ་ཞེས་བྱ་བ་ནི་རྣམ་པར་བྱང་བའོ།",
    "འདི་སྐད་དུ་སྡུག་བསྔལ་གྱི་རྒྱུ་ནི་ཕྱིན་ཅི་ལོག་མ་གཏོགས་པ་གཞན་མེད་ལ་དེ་ཡང་གཉེན་པོ་མངོན་དུ་གྱུར་པས་བྲལ་བ་ལ་རྣམ་པར་བྱང་བ་ཞེས་གྲགས་ཏེ།",
    "མཐུན་པར་སྨྲ་འགྱུར་ཞེས་བྱ་བ་ནི་གཞན་དུ་མི་སྨྲ་བའི་ཕྱིར་ཏེ།",
    "རྙེད་མི་འགྱུར་ཞེས་བྱ་བ་ནི་རྙེད་པར་མི་འགྱུར་བ་ཁོ་ནའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བདེ་གཤེགས་ཞེས་བྱ་བ་ལ་སོགས་པ་གང་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནི་རྟེན་གྱི་ཁྱད་པར་སྒྲུབ་པའི་སྒོ་ནས་ནི།",
    "བར་ཆད་མེད་པར་སྦྱོར་བའི་སྒོ་ནས་ནི།",
    "ཡོ་བྱད་ཀྱི་ཁྱད་པར་གྱི་སྒོ་ནས་ནི།",
    "དུས་ཀྱི་ཁྱད་པར་གྱི་སྒོ་ནས་ནི།",
    "གང་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "བསྟི་སྟང་བྱེད་གྱུར་ན་ཞེས་བྱ་བ་ནི་བསྟི་སྟང་བྱེད་པར་གྱུར་ན་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "རིག་སྔགས་ཆེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གང་དག་འདས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "འདུས་བྱས་བདེ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "འདུས་བྱས་ནི་ཟག་པ་དང་བཅས་པའོ།",
    "འདུས་མ་བྱས་ནི་གཞན་ནོ།",
    "རྒྱལ་བས་བརྒྱ་བྱིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེའི་ལན་གདབ་པར་སྐུ་གདུང་མི་གུས་བདག་མ་ལགས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "འཛིན་འཚལ་ཞེས་བྱ་བ་ནི་ཀུན་འཛིན་པར་འཚལ་བའོ།",
    "ཆུད་མི་གཟོན་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་སེར་སྣ་ལ་སོགས་པས་ཟིལ་གྱིས་མི་ནོན་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བརྗོད་པ་མ་གཏོགས་པར་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་ལ་གྲིབ་མ་ཞེས་བྱ་བའི་མིང་དུ་བརྗོད་པ་འབའ་ཞིག་ཏུ་ཟད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྒྱལ་བའི་ཞེས་བྱ་བ་སྨོས་པ་ནི་དེ་དང་འབྲེལ་བའི་སྦྱིན་པ་ལ་སོགས་པ་སྦྱིན་པར་བྱ་བ་ལ་སོགས་པ་མི་དམིགས་པའི་རྣམ་པ་ཉིད་དུ་བསྟན་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་དེ་དག་ལ་ཤེས་རབ་ཅེས་བརྗོད་པར་བསྟན་པའི་ཕྱིར།",
    "ཤེས་རབ་ཕ་རོལ་ཕྱིན་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་ཤེས་རབ་ཀྱི་བདག་ཉིད་ཡིན་པས་གྲོལ་བའི་རྒྱུའི་ངོ་བོ་ཡིན་པར་ཀུན་དུ་བསྟན་ནས།",
    "དེའི་བདག་ཉིད་ཡིན་པར་བསྟན་པའི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལ་ལས་གང་གཱའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "མཆོག་ཅེས་བྱ་བའི་སྒྲ་ནི་དམ་པར་རྗོད་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེའི་ལན་གདབ་པར་སྨྲ་མཆོག་དེ་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "བསླབས་ནས་ཞེས་བྱ་བ་ནི་མཉན་པ་ལ་སོགས་པའི་རིམ་གྱིས་གོམས་པར་བྱས་པས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཉི་མ་ལྟ་བུ་ནི་རྣམ་པར་སྨིན་པའི་སས་བསྡུས་པ་ཡིན་ཏེ།",
    "དེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཡེ་ཤེས་གང་ལས་འབྱུང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ཡང་ཡང་དག་པར་དགའ་བའི་རྒྱུ་ཡིན་པའི་ཕྱིར་མེ་ཏོག་དང་འབྲས་བུ་ལྟ་བུ་ཡིན་ནོ།",
    "བསྟོད་པ་ལ་སོགས་པ་འདི་དག་ནི་རང་དང་གཉི་ག་དང་གཞན་གྱི་དོན་གྱི་སྐབས་ཀྱིས་ཐ་དད་པའི་རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "འཇིག་རྟེན་འདི་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "སྲོག་ཆགས་ནི་སྲིན་བུ་མེ་ཁྱེར་ལ་སོགས་པ་སྟེ་འདི་ནི་ཉེ་བར་མཚོན་པར་ཟད་དོ།",
    "བསམ་པ་དམན་པའི་འབྲས་བུ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ཉན་ཐོས་ཚོགས་རྣམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་དོན་གོ་བར་ཟད་དོ།",
    "འདས་དུས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "ཕ་རོལ་ཕྱིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་ན་ཡང་ཡོངས་སུ་བསྔོས་པར་མི་ཆུད་པས་ན་དམིགས་པ་ཡོད་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "དེ་ཡང་སྐད་ཅིག་མ་ཉིད་དུ་སོ་སོར་རྟོག་པས་བདག་ཏུ་ཕྱིན་ཅི་མ་ལོག་པའི་སྒོ་ནས་ནི་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནི་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་རྒྱལ་བས་མཁྱེན་པ་དེ་ལྟར་རྗེས་སུ་ཡི་རང་བ་དང་ཡོངས་སུ་བསྔོ་བར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་ཡོངས་སུ་མཁྱེན་པ་ཡང་རྣམ་པ་དང་རྒྱུ་དང་མཚན་ཉིད་ཀྱི་སྒོ་ནས་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "རྣམ་པ་གང་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྒྱལ་བས་གསུངས་པ་སྨྲ་ཞེས་བྱ་བ་ནི་དེས་གནང་བའི་ཡོངས་སུ་བསྔོ་བ་དང་ལྡན་པའི་ཕྱིར་རོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "དེ་ནི་དམུས་ལོང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ཡང་མི་དམིགས་པའི་བདག་ཉིད་ཡིན་པས་མི་དམིགས་པའི་རྣམ་པ་བསྒྲུབ་པའི་ཕྱིར་ནི་གང་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གང་གསུངས་པ་ཡིན་ནོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་འདུས་བྱས་ལ་སོགས་པ་ལ་དམིགས་པ་དང་འགལ་བས་རྣམ་པ་ཐམས་ཅད་དུ་དབེེན་པར་སྤྱོད་ཡུལ་གཅིག་པའི་ཕྱིར་རོ།",
    "འདིས་ནི་དག་པ་འཇིག་རྟེན་པ་ལས་ཁྱད་པར་དུ་བསྟན་པ་ཡིན་ནོ།",
    "སྔོན་སྤྱོད་ཚེ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "བསྙེན་བཀུར་བྱས་སུ་ཟིན་ཀྱང་ཞེས་བྱ་བ་ལྷག་མ་ཡིན་ནོ།",
    "དག་པ་ནི་སྒྲོ་བཏགས་པས་དབེན་པའི་སྒོ་ནས་ཡིན་པར་སྦྱར་རོ།",
    "དེ་ལྟར་རོ་གཅིག་པར་རྟོགས་པ་ཉིད་ཤིན་ཏུ་དག་པ་ཡིན་ནོ་སྙམ་དུ་དགོངས་པ་ཡིན་ཏེ།",
    "ཕུང་པོ་ལ་སོགས་པ་ཙམ་ལ་མི་རྟག་པ་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པའི་ཕྱིར་ཏེ།",
    "རྣམ་པར་གྲོལ་བའང་མིན་ཞེས་བྱ་བ་ནི་གཞན་ལ་ཕན་པར་བྱ་བའི་ཕྱིར་སྐྱེ་བ་ལ་སོགས་པ་སྟོན་པའི་ཕྱིར་རོ།",
    "དེ་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་གར་སྤྱོད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་གཉེན་པོ་ཡང་མི་མཐུན་པའི་ཉེས་པ་རྟོགས་པའི་སྒོ་ནས་ནི་འགྲོ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "སྤྱོད་པ་ཡོངས་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་གསལ་བར་བྱ་བའི་ཕྱིར་དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཡང་དག་པར་ན་མེད་པའི་ཕྱིར་རོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "རྟེན་ནི་སྦྱོར་བར་བྱས་པ་དང་།",
    "རྒྱལ་བ་ལ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "ཕུང་པོ་ཁམས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་ཕུང་པོ་ཞེས་བྱ་བ་སྨོས་པ་ནི་ཟག་པ་མེད་པའི་ཕུང་པོ་ཡིན་པར་གཟུང་བའི་ཕྱིར་རོ།",
    "དབུགས་ཕྱིན་ཐོབ་པར་གྱུར་ཅིང་ཞེས་བྱ་བ་ནི་ཤེས་རབ་མཉན་པ་སྲིད་པའི་ཉེས་པའི་གཉེན་པོ་ཡིན་པའི་ཕྱིར་རོ།",
    "རིག་པར་བྱ་ཞེས་བྱ་བ་ནི་ཤེས་པར་འགྱུར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བསྐྲུན་ཞེས་བྱ་བ་ནི་འགྲུབ་པར་འགྱུར་བ་སྟེ།",
    "སྐྱེད་པ་ཞེས་བྱ་བ་ནི་སྐྱེད་པར་བྱེད་པའི་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གང་ཞིག་འདིར་སྤྱོད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "རྣམ་པར་མི་རྟོག་ཅེས་བྱ་བ་ནི་ངོ་བོ་ཉིད་ལ་རྣམ་པར་མི་རྟོག་པའི་ཕྱིར་རོ།",
    "འདིས་ནི་རྣམ་པར་རྟོག་པའི་མཚན་མ་རྣམ་པ་བཞི་དང་བྲལ་བའི་སྦྱོར་བ་བསྟན་པ་ཡིན་ཏེ།",
    "གཉེན་པོ་དང་དེ་ཁོ་ན་ཉིད་དང་ཐོབ་པར་རྟོག་པའི་མཚན་མའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "མཚན་མའི་རབ་ཏུ་དབྱེ་བ་འདི་ནི་རྣམ་པར་མི་རྟོག་པ་ལ་འཇུག་པའི་གཟུངས་བསྟན་པ་ལས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "འདི་ལ་བདུད་ཀྱིས་བར་དུ་གཅོད་པར་འགྱུར་བ་ཡང་གང་དག་ཡིན་ཞེ་ན།",
    "རབ་འབྱོར་གྱིས་ཞུས་པ་ནི་དེས་གདུལ་བའི་འགྲོ་བ་དད་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དེ་ལས་ཞེས་བྱ་བ་ནི་བར་དུ་གཅོད་པར་འགྱུར་བ་དེ་དག་ལས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཅུང་ཟད་ཙམ་ཞིག་ཅེས་བྱ་བ་ནི་བར་དུ་གཅོད་པར་འགྱུར་བ་རྣམ་པ་དགུ་སྟེ།",
    "གླང་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "བཀུར་སྟི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ།",
    "འདྲིས་བྱེད་ཅེས་བྱ་བ་ནི་བཤེས་པར་བྱེད་པའོ།",
    "སྟོན་པར་བྱེད་པ་ལ་དགའ་བ་མེད་པ་ནི།",
    "བར་དུ་གཅོད་པ་མང་བ་ཉིད་དུ་བསྟན་པའི་ཕྱིར་དེའི་ཚེ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "བར་ཆད་བྱེད་པའི་རྒྱུ་བསྟན་པའི་ཕྱིར་རིན་ཆེན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་དེ་ནི་ཞུགས་ནས་རིང་པོ་མ་ལོན་པར་མི་འཐོབ་པས།",
    "དགོངས་པ་མཛད་ཅེས་བྱ་བ་ནི་བགེགས་མེད་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ཁོང་ནས་དྲང་ངོ།",
    "ཁྱད་པར་དང་།",
    "དེ་ལ་ཤེས་པའི་མཚན་ཉིད་ནི་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་གྱི་སྒོ་ནས་རྣམ་པ་བཅུ་སྟེ།",
    "འཇིག་རྟེན་ཞེས་པ་ནི་ཕུང་པོ་ལ་སོགས་པའི་བདག་ཉིད་ཀྱི་འཇིག་རྟེན་རང་དང་སྤྱིའི་མཚན་ཉིད་དུ་ཡོངས་སུ་གཅོད་པའི་ཕྱིར་ཏེ་དེ་སྟོན་པས་འཇིག་རྟེན་སྟོན་པ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དངོས་བྲལ་ཞེས་བྱ་བ་ནི་འཛིན་པ་ལ་སོགས་པར་སྒྲོ་བཏགས་པ་ལོག་པ་ཙམ་གྱི་བདག་ཉིད་ཡིན་པ་འབའ་ཞིག་ཏུ་ཟད་དེ།",
    "མཁྱེན་ཞེས་བྱ་བ་ནི་ཐུགས་སུ་ཆུད་པ་སྟེ་དེ་བཞིན་ཉིད་ཅེས་བྱ་བར་སྦྱར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འཛིན་པའི་རྣམ་པར་འདོད་པ་ཉིད་དགའ་ཚལ་ཡིན་ཏེ་དགའ་བ་རྣམ་པ་དུ་མའི་རྟེན་ཡིན་པའི་ཕྱིར་རོ།",
    "བྱེད་པ་མེད་པ་ཤེས་པ་སྟེ་འགྲོ་བ་ཡོངས་སུ་སྨིན་པར་བྱ་བ་ལ་སོགས་པ་ལ་ཞུགས་ཀྱང་བྱེད་པ་པོ་ལ་སོགས་པ་མི་དམིགས་པའི་ཕྱིར།",
    "ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "སྟོང་པ་ཉིད་སྟོན་པར་བྱེད་པ་ཤེས་པ་དེ་སེང་གེ་བཞིན་དུ་ཤེས་རབ་ཀྱི་རི་དང་།",
    "འཇིགས་པ་མེད་པར་ཞེས་བྱ་བ་ནི་བག་ཚ་བ་མེད་པར་རོ།",
    "ཇི་ལྟར་རྣམ་པར་གྲོལ་བར་བྱེད་ཅེ་ན།",
    "རྣམ་པར་ཤེས་པ་ནི་འཇུག་པའི་རྣམ་པར་ཤེས་པ་དྲུག་གོ།",
    "སེམས་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པའོ།",
    "ཇི་ལྟར་ན་མཐོང་བ་མེད་པ་ཉིད་མཐོང་བ་ཡིན་པར་འགྱུར་ཞེ་ན།",
    "བྱ་བ་ཐམས་ཅད་བསྡུས་པས་ཁྱད་པར་དུ་འཕགས་པ་སྟེ།",
    "ཟིལ་གྱིས་མི་ནོན་ཞེས་བྱ་བ་ནི་སྒྲིབ་པ་ཐམས་ཅད་ཀྱིས་མ་གཙེས་པར་རོ།",
    "དེ་བཞིན་དུ་གཞན་དག་ལ་ཡང་རབ་ཏུ་དབྱེ་བའི་མཚམས་སྦྱར་བ་ནི་ཅི་རིགས་པར་བརྟག་པར་བྱའོ།",
    "དམིགས་པས་ཁྱད་པར་དུ་འཕགས་པ་ནི་གྲུ་ཆག་པའི་མི་རོལ་སོགས་པ་ལ་འཇུ་བ་ཁོ་ན་ལྟར་འགོག་པ་ལ་རྗེས་སུ་ཤེས་པས་སྲིད་པའི་རྒྱ་མཚོའི་ཕ་རོལ་དུ་འགྲོ་བའི་ཕྱིར།",
    "ཕྱིན་པར་འགྱུར་ཞེས་བྱ་བ་ནི་བུམ་པ་ཞེས་བྱ་བར་སྐབས་དང་སྦྱར་རོ།",
    "ཕུན་སུམ་ཚོགས་པས་ཁྱད་པར་དུ་འཕགས་པ་ནི་རྒྱ་མཚོའི་གྲུ་བཅོས་ལེགས་མ་བྱས་པ་དང་།",
    "ཡོངས་སུ་བཟུང་བས་ཁྱད་པར་དུ་འཕགས་པ་ནི་མི་ཉམ་ཆུང་བ་བཞིན་དུ་ལྷན་ཅིག་བྱེད་པ་ཤེས་རབ་དང་ཐབས་ཀྱིས་ཡོངས་སུ་མ་ཟིན་པས་སྲིད་པ་དང་ཞི་བར་ལྷུང་བ་སྲིད་པའི་ཕྱིར།",
    "མི་ཉམས་ཞེས་བྱ་བ་ནི་སྲིད་པ་དང་ཞི་བ་གཅིག་ཏུ་འདྲེས་པར་མི་འགྱུར་རོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "བསྟེན་པར་བྱ་ཞེས་བྱ་བ་ནི་བསྟེན་པར་བྱ་བའོ།",
    "ཤེས་རབ་ཕ་རོལ་ཕྱིན་པ་ཞེས་བྱ་བ་གསུངས་ཏེ་ཤེས་རབ་ལའོ།",
    "སྦྱིན་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་དེ་སྐད་བསྟན་པར་བྱ་ཞེས་བྱ་བ་ནི།",
    "དེ་དག་ལ་དེ་སྐད་བསྟན་པར་བྱ་བའམ།",
    "དེ་ལྟར་སྤྱོད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གང་གསུངས་པ་ཡིན་ཏེ།",
    "དཔུང་གཉེན་ནི་མྱ་ངན་ལས་འདས་པའི་བདེ་བ་ལ་འགོད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "གསལ་བྱེད་ནི་གང་ཟག་ལ་བདག་མེད་པར་རབ་ཏུ་བསྟན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "སྒྲོན་མ་ནི་འགྲོ་བ་དག་མེད་པར་རབ་ཏུ་སྟོན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "སྨྲ་བའི་ཟླ་བ་ཉིད་ཡིན་པར་རབ་ཏུ་བསྟན་པའི་ཕྱིར།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱི་དེ་ཁོ་ན་ཉིད་རབ་ཏུ་སྟོན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "འདིར་ནི་ཕྱི་མ་ཕྱི་མ་སྔ་མ་སྔ་མའི་རྒྱུ་ཡིན་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེ་ལྟར་ན་ཇི་ལྟར་རྨོངས་པར་མི་འགྱུར་ཞེ་ན།",
    "དེ་ཉིད་ཐེ་ཚོམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "མུན་པ་བཞིན་ཞེས་བྱ་བ་ནི་འཛིན་པ་ལ་སོགས་པར་རྟོགས་པས་སོ།",
    "འདི་ལྟར་བྱེ་བྲག་གྱུར་པ་མེད་དེ་ཐམས་ཅད་དུ་དབེན་པར་མཚན་ཉིད་གཅིག་པའི་ཕྱིར་ཏེ།",
    "ཐོབ་འདོད་པ་ཞེས་བྱ་བ་ནི་མི་དམིགས་པའི་ཚུལ་གྱིས་ཐོབ་པར་འདོད་པའོ།",
    "ལུས་དཔག་ཚད་བརྒྱ་ལྔ་བཅུ་པ་ཞེས་སྨོས་པ་ནི་དེ་ལྟ་བུར་ཆེན་པོ་ཡང་འདབ་གཤོག་མེད་ན་ནམ་མཁའ་ལ་འགྲོ་བར་མི་ནུས་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "དངོས་བསྟན་པའི་ཕྱིར་རྒྱལ་བ་རྣམས་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་གྱི་བསམ་པ་དང་བསྟུན་པར་གསུངས་པའི་ཕྱིར་ཉེས་པ་མེད་དོ།",
    "དུས་རིང་བའི་སྒོ་ནས་ནི་བསྐལ་པ་དུ་མར་ཡང་དག་པར་སྒྲུབ་པའི་ཕྱིར་རོ།",
    "ཕྱི་མ་ལ་ཕན་པར་བྱ་བར་སེམས་པའི་ཕྱིར་རོ།",
    "བདེ་བ་ཁ་ན་མ་ཐོབ་པ་མེད་པ་ཉེ་བར་སྒྲུབ་པར་སེམས་པའི་ཕྱིར་རོ།",
    "སྦྱོར་བ་བསྟན་པའི་ཕྱིར་ཚིག་འཇམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ནི་འགྲོ་བ་ལ་ཕན་པའི་ཐབས་ཀྱི་ཁྱད་པར་དུ་བྱས་པ་ཡིན་ཏེ་དེའི་ཕྱིར་ཟློས་པ་ཉིད་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་གཞན་ལ་ཡང་མི་ཟློས་པ་ཉིད་དུ་སྐབས་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "འཐད་པར་སྨྲ་བ་དང་།",
    "སྤྱོད་ལམ་ཐམས་ཅད་དུ་ལེགས་པར་ཤེས་བཞིན་དང་ལྡན་པ་དང་།",
    "ཡོན་ཏན་འདི་དག་ནི་དྲོ་བར་གྱུར་པ་ལ་སོགས་པའི་གནས་སྐབས་སུ་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "བསམ་གཏན་བཞི་ཡིད་ལ་བྱེད་པའི་ཕྱིར་རྣམ་པར་མི་གཡེང་བ་དང་།",
    "ཀུན་ནས་མནར་སེམས་ཀྱི་དངོས་པོ་དག་བདག་མེད་པར་ཁོང་དུ་ཆུད་པའི་ཕྱིར་ཁྲོ་བ་མེད་པ་དང་།",
    "ཤེས་པ་དང་མཐུན་པར་ཅི་རིགས་པར་མི་རྟག་པ་ལ་སོགས་པའི་རྣམ་པའི་སྒོ་ནས་བལྟ་བར་བྱའོ།",
    "དེ་ལྟ་ན་དེ་ཁོ་ན་ཉིད་ནི་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར་གཞལ་དུ་མེད་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཐ་སྙད་ཀྱང་མི་འཇུག་པ་མ་ཡིན་ནམ།",
    "དེ་དག་ཀྱང་སྦྱོར་བའི་དུས་ན་རྣམ་པར་རྟོག་པའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར།",
    "དེའི་ལན་གདབ་པར་ཡོངས་བསྔོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་ལྟར་རློམ་སེམས་ཐམས་ཅད་ལས་འདས་པའི་ཡོངས་སུ་བསྔོ་བ་ཉིད་རྣམ་པར་མི་རྟོག་པའི་གོ་འཕང་རབ་ཏུ་སྐྱེ་བའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "སེམས་དང་པོ་ལ་སོགས་པ་དོན་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་བསྟན་པའི་ཕྱིར་དང་པོའི་སེམས་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ནི་ཚོགས་ཡོངས་སུ་རྫོགས་པར་བྱ་བ་ཉིད་ལ་ཆུ་ལྟ་བུ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་སྤྱོད་པའི་ཞེས་བྱ་བ་ནི་བདག་མེད་པ་ཉིད་དུ་རྣམ་པར་བལྟའོ།",
    "ཡང་དག་པར་ན་མཉམ་པ་ཉིད་དུ་རྟོགས་པ་ཁོ་ན་ཁྱད་པར་མེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "མཉམ་པར་མ་བཞག་ཅེས་བྱ་བ་ནི་མཇུག་དང་སྦྱོར་བའི་གནས་སྐབས་དག་ནའོ།",
    "བརྩོན་བྱས་ཞེས་བྱ་བ་ནི་གོམས་པར་བྱས་པའོ།",
    "ལས་ལ་སྤྱོད་པའི་རྒྱུ་ཞེས་བྱ་བ་ནི་སྣོད་ཀྱི་འཇིག་རྟེན་མེད་པ་ལས་ཀྱི་འབྲས་བུ་ལ་སྤྱད་པར་མི་ནུས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྣམ་དཔྱོད་པ་ནི་ངོ་བོ་ཉིད་མེད་པར་ལྟ་བའོ།",
    "དེ་ཐོབ་མི་བྱེད་པ་ནི་ཚོགས་ཡོངས་སུ་མ་རྫོགས་པས་དེ་མངོན་སུམ་བྱས་ན་ལྷུན་གྱིས་གྲུབ་པར་འགྲོ་བ་ཡོངས་སུ་སྐྱོབ་པ་མེད་པའི་ཕྱིར་རོ།",
    "ལྷུང་བར་མི་འགྱུར་ཞེས་བྱ་བ་ནི་སྣད་པར་མི་འགྱུར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཞེས་བྱ་བ་ནི་བགྲོད་པར་བྱ་བ་ཇི་སྙེད་པ་དེར་བདེ་བླག་ཁོ་ནར་འགྲོ་བར་འགྱུར་རོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "ཆགས་པ་མེད་པའི་ཐབས་ནི་ཚོང་པ་བཞིན་དུ་མཁས་པར་བྱ་བའི་ཕྱིར་ལམ་ལ་སོགས་པས་རབ་ཏུ་ཞུགས་ཀྱང་དེ་ལ་མི་གནས་པའི་ཕྱིར།",
    "བར་གྱི་ཞེས་བྱ་བ་ནི་བགྲོད་པར་བྱ་བའི་ལམ་ཀ་ཡིའོ།",
    "གྲོང་རྡལ་གང་ཡིན་པར་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "རང་རྒྱལ་རྣམས་ཀྱི་ཞེས་བྱ་བ་ནི་རྣམ་པར་གྲོལ་བ་དང་ཤེས་པ་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "བྱམས་པ་ཆེན་པོའི་སྦྱོར་བའི་ཐབས་ནི་འགྲོ་བ་ལ་བྱམས་པ་སྔོན་དུ་འགྲོ་བའི་སྟོང་པ་ཉིད་ལ་སོགས་པ་མངོན་སུམ་དུ་གྱུར་ན་མྱ་ངན་ལས་འདས་པ་དང་འདུས་བྱས་སུ་གདགས་པ་ལས་ཡང་དག་པར་འདས་པའི་ཕྱིར།",
    "དེ་ནི་གནས་མེད་དོ་ཞེས་བྱ་བ་ནི་བྱམས་པའི་སྦྱོར་བ་དང་སྟོང་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་དག་ནི་གོ་རིམས་བཞིན་དུ་མྱ་ངན་ལས་འདས་པ་དང་སྲིད་པར་གདགས་པ་དང་འགལ་བའི་ཕྱིར་རོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "ཕྱིར་མི་ལྡོག་པའི་རྟགས་ཀྱི་ཐབས་ནི་བདག་ཉིད་ཐབས་དང་ཤེས་རབ་ལ་གནས་ཤིང་གཞན་དག་ལ་ཡང་དེ་སྟོན་པས་ཕྱིར་མི་ལྡོག་པ་ཉིད་དུ་ངེས་པར་འཛིན་པ་ཡིན་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་འོག་མ་དག་ལ་ཡང་རབ་ཏུ་དབྱེ་བའི་གོ་རིམས་ནི་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "རྣམ་པར་རྟོག་པ་རྣམ་བཞི་ཡི།",
    "ལོག་པར་སྒྲུབ་དང་བཅས་པ་ནི།",
    "ལུང་བསྟན་ཡིན་པར་རིག་པར་བྱ་ཞེས་བྱ་བ་ནི་ཐབས་དང་ཤེས་རབ་ཕུལ་དུ་བྱུང་བ་ཐོབ་པའི་ཕྱིར་རོ།",
    "བདག་ལུང་བསྟན་སྙམ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "འབྱོར་པས་ཞེས་བྱ་བ་ནི་འགྲུབ་པར་འགྱུར་བ་སྟེ།",
    "དེ་ཉིད་རྒྱས་པར་བསྟན་པའི་ཕྱིར།",
    "གང་ལ་གཞི་མིང་ཁོ་ན་ཡོད་པ་དེ་ནི་དེ་སྐད་ཅེས་བྱ་སྟེ་སྨྲ་ཞེས་བྱ་བ་ཁྱད་པར་ཡིན་ནོ།",
    "འདི་ནི་དབེེན་པར་གསུངས་ཞེས་བྱ་བ་ནི་སྲིད་པ་དང་ཞི་བ་ལ་མ་ཆགས་པས་དབེན་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "བརྙས་པ་བྱེད་པ་ཞེས་བྱ་བ་ནི་ཁྱད་དུ་གསོད་པར་བྱེད་པའོ།",
    "མཚན་ཉིད་དེ་དང་འདྲར་ཤེས་ཞེས་བྱ་བ་ནི་དེ་ཁོ་ན་བཞིན་དུ་འཛིན་པ་ལ་སོགས་པའི་རྣམ་པས་དབེེན་པར་རོ།",
    "ལྐོག་ཏུ་གྱུར་པའི་བདག་ཉིད་དང་ཡུལ་རིག་པར་འབྲེལ་པ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དེ་དག་རྗེས་སུ་འབྲེལ་པ་རྟོགས་པ་མེད་པར་དེ་ལྟ་བུ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "འཛིན་པ་དེའི་ངོ་བོ་སྐྱེད་པར་བྱེད་པ་ཡིན་པ་འབའ་ཞིག་ཏུ་འགྱུར་རོ།",
    "སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་ནི་གཞན་གྱི་བྱེད་པས་དབེེན་པར་སྣང་བའི་ཕྱིར་རོ།",
    "ལྐོག་ཏུ་གྱུར་པ་ཉིད་ནི་རྟོགས་པར་མ་གྱུར་པའི་རྣམ་པ་ཡིན་ལ་གཟུང་བ་ཉིད་ནི་རྟོགས་པར་གྱུར་པའི་རང་བཞིན་ཡིན་པས་དེ་དག་གཅིག་ལ་གཅིག་པར་ཇི་ལྟར་འགྱུར།",
    "བྱེད་པ་མེད་པ་ཉིད་ཀྱིས་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "སྔོན་པོའི་རྣམ་པར་སྣང་བ་ནི་ལྐོག་ཏུ་གྱུར་པ་ཡིན་པར་འོས་པ་མ་ཡིན་ཏེ།",
    "གཞན་དུ་ན་རྟག་ཏུ་རྟོག་པར་གྱུར་པའི་རྣམ་པ་ཉིད་དམ་རྟོགས་པར་མ་གྱུར་པའི་རྣམ་པ་ཉིད་དམ་དེ་གཉི་གའི་ངོ་བོ་ཉིད་དུ་འགྱུར་རོ།",
    "དེ་ལ་ཡང་མཐོང་བར་གྱུར་པའི་རྣམ་པ་ལས་ཐ་དད་པར་མཐོང་བར་གྱུར་པ་སྣང་བའི་ཕྱིར་དེ་ཉིད་རྣམ་པ་གཞན་ཉིད་ནི་མ་ཡིན་ཏེ་མང་དུ་བརྗོད་པས་ཆོག་གོ།",
    "དེ་ལྟ་བས་ན་མ་མཐོང་བ་བརྟགས་པ་ནི་དོན་ཅུང་ཟད་ཀྱང་རྒྱས་པར་མི་འགྱུར་རོ།",
    "ཟས་ནི་གཟུགས་ལ་སོགས་པ་ཡིན་ཏེ་སྤྱད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ནི་དེའི་སྐྱེད་པར་བྱེད་པ་ཉིད་དུ་མི་འཐད་པའི་ཕྱིར་རོ།",
    "ཉམས་སུ་མྱོང་བ་རྣམ་པར་མ་བརྟགས་པའི་ངོ་བོ་ཉིད་མ་གཏོགས་པར་བེེམས་པོའི་བདག་ཉིད་ས་ལ་སོགས་པ་ནི་མེད་པའི་ཕྱིར།",
    "དེའི་ངོ་བོ་ནི་འཛིན་པ་ལ་སོགས་པར་རྣམ་པར་རྟོག་པ་ཡང་རྣམ་པར་བྱང་བར་མཚན་ཉིད་གཅིག་པའི་ཕྱིར།",
    "སྟོང་པར་ཤེས་པ་ཤིན་ཏུ་བརྟན་པ་བསྐྱེད་པའི་ཆེད་དུ་དེ་ལྟར་རྣམ་པར་གཞག་པའི་ཕྱིར་རོ།",
    "འཛམ་བུའི་གླིང་སྨོས་པ་ནི་ཉེ་བར་མཚོན་པར་ཟད་དོ།",
    "དངོས་གཞིའི་ཁྱད་པར་གྱིས་ནི་ལོ་བྱེ་བ་ཕྲག་དུ་མར་ཡང་དག་པར་སྒྲུབ་པའི་ཕྱིར་རོ།",
    "རྗེས་སུ་མཐུན་བྱེད་ན་ཞེས་བྱ་བ་ནི་རབ་ཏུ་སྟོན་པར་བྱེད་ནའོ།",
    "འཇུག་པར་བྱ་ཞེས་བྱ་བ་ནི་རབ་ཏུ་བསྟན་པར་བྱ་བ་སྟེ།",
    "ཤེས་རབ་ཕ་རོལ་ཕྱིན་ལ་ཞེས་བྱ་བ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བརྩོན་པར་ཏེ་དེའི་ཕྱིར་བྱ་དགོས་སོ་ཞེས་བྱ་བ་ལྷག་མ་ཡིན་ནོ།",
    "རབ་ཏུ་བརྩོན་ཞེས་བྱ་བ་ནི་བག་ཡོད་པར་བྱས་ཏེའོ།",
    "ཟུག་རྔུ་ལྡན་པར་གྱུར་ཞེས་བྱ་བ་ནི་མྱ་ངན་ལ་སོགས་པའི་ཟུག་རྔུ་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "མྱ་ངན་ཉམ་ཐག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསམ་པ་རབ་ལྡན་ཞིང་ཞེས་བྱ་བ་ནི་གུས་པར་བྱས་ཏེ་སྦྱོར་བའི་ཕྱིར་རོ།",
    "དེ་གཉིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱིས་ཀྱང་སྡོམ་པར་བྱེད་དེ།",
    "ཡང་དག་པར་ན་རྫས་ལ་མ་གཏོགས་པའི་བྱ་བ་མེད་པའི་ཕྱིར་རོ།",
    "དམིགས་པ་ནི་དམིགས་པར་བྱེད་པ་སྟེ་མེད་ཅེས་བྱ་བར་སྦྱར་རོ།",
    "མི་རྟོག་པ་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་ན་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སློབ་པ་དང་དེའི་མི་མཐུན་པའི་ཕྱོགས་མཚན་ཉིད་ཀྱིས་དབེན་པར་ངོ་བོ་ཐ་མི་དད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བརྙེས་པར་བྱ་ཕྱིར་ཞེས་བྱ་བ་ནི་བརྙེས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "འདིར་ནི་འདུས་པར་འགྱུར་ཞེས་བྱ་བ་ནི་ཤེས་རབ་ནི་དེ་ལས་གཞན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་འགྲུབ་པའི་རྒྱུར་གྱུར་པའི་ཕྱིར་དང་སེར་སྣ་ལ་སོགས་པ་མི་མཐུན་པའི་ཕྱོགས་རྣམ་པ་དྲུག་བཟློག་པའི་ཕྱིར་རོ།",
    "འགག་པར་འགྱུར་ཞེས་བྱ་བ་ནི་འགག་པར་འགྱུར་བ་སྟེ།",
    "དེ་དག་ཀྱང་ཡང་དག་པར་ན་བདག་མེད་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "མི་སྐྱེད་ཅེས་བྱ་བ་ནི་སྐྱེད་པར་མི་བྱེད་པ་སྟེ།",
    "ཚད་གཟུང་རུང་ཞེས་བྱ་བ་ནི་ཚད་ཟིན་པར་འགྱུར་བ་སྟེ།",
    "སྤྲོས་མེད་ཅེས་བྱ་བ་ནི་སྨོན་པའི་སྤྲོས་པ་མེད་པར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་གནས་སྐབས་ན་རྣམ་པར་བྱང་བར་རྣམ་པར་རྟོག་པ་ཡང་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གལ་ཏེ་དེ་བས་ན་དེ་ལྟར་ཤེས་པ་ཡོད་པའི་ཕྱིར་དངོས་པོ་རྣམས་ཐ་མི་དད་པ་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "གལ་ཏེ་དེ་དག་ཉིད་སོ་སོའི་ཁྱད་པར་ལ་བརྟེན་པའི་ནུས་པ་ཐ་དད་པས་ཐ་སྙད་ཐ་དད་པ་ཡོད་དོ་ཞེ་ན།",
    "འཛིན་པར་རྣམ་པར་རྟོག་པ་ཡང་རྣམ་པ་གཉིས་ཡིན་ཏེ།",
    "དེ་དག་མེད་པར་བསྟན་པའི་ཕྱིར།",
    "རྣལ་འབྱོར་པ་དེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣལ་འབྱོར་པ་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་བཏགས་པ་ཙམ་ལ་ཡང་འཛིན་པ་ཉིད་དུ་མི་རྟོག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།"
  ]
}