    "གུས་པ་མཆོག་གིས་མངོན་བཏུད་ནས།",
    "གང་གི་གྲགས་དཀར་སྤྲིང་ཡིག་གིས།",
    "ཁྱོད་ཞབས་ནོར་བུ་རྣམ་བཀོད་པས།",
    "ཕྱོགས་ལྷུང་མེད་པར་གཟིགས་པའི་རིས།",
    "ཁོ་བོའི་གཙུག་གི་པད་མར་འཕོས།",
    "སོར་མོའི་འདབ་མས་རྣམ་སྤྱད་ཅིང་།",
    "ཕུལ་བྱུང་དཔལ་མོའི་འཇོ་སྒེག་ཀྱིས།",
    "འོན་ཀྱང་ལོག་འཚོའི་དུག་གིས་མྱོས།",
    "གང་ཁྱོད་རྒྱལ་ཀུན་སྤྱོད་ཡུལ་དང་།",
    "སླད་མར་གང་གི་ཞལ་བཟང་གདུང་སེལ་ཟླ་བའི་རྗེས་འགྲོ་བ།",
    "ཞེས་པའི་ཞུ་མཆིད་ཀྱི་རེ་ཁཱ་ལ་སྤྱན་རས་རྣམ་པར་གཡོ་བའི་རྟེན་ཙམ་དུ་ལྷ་རྫས་རབ་དཀར།",
    "གང་གི་རྣམ་དཔྱོད་རབ་གསལ་བཀའ་འཕྲིན་གྱི།",
    "ཁྱོད་ཉིད་ཁོ་ན་མཛེས་པའི་ཡ་ལ་ལ་པགོ་ས།",
    "གང་གི་བརྟན་མཁས་ཡོན་ཏན་ཕུན་ཚོགས་པའི།",
    "དོན་བཟང་ལང་ཚོའི་མེ་ཏོག་ཆེས་བདོ་ཞིང་།",
    "སྙན་འགྱུར་ཚིག་གི་ཟུར་མིག་འབུམ་གཡོ་བས།",
    "ཡོན་ཏན་ཟེགས་མ་ཤིན་ཏུ་ཕྲ་གྱུར་མོད།",
    "ཁྱོད་ཀྱི་ཐུགས་མཚོ་རྒྱས་བྱེད་ཟླ་བ་ལྟར།",
    "དེ་སྐད་ཞུ་འཕྲིན་ངང་མོ་དཀར།",
    "མ་གྷ་རྒྱལ་བའི་ཚེས་ལ་སོང་།",
    "འདིར་ཕྲན་ཡང་སྐྱབས་མགོན་དམ་པ་རྣམས་ཀྱི་ཐུགས་རྗེས་འཚོ་བ་དགེ་ཞིང་ད་ལྟ་ཞྭ་དམར་མཆོག་གི་ཞབས་འབྲིང་དུ་ལྷ་སར་གནས་སྐབས་ལགས།",
    "གསུང་གི་བདུད་རྩི་ནོད་པའི་འདུན་པ་རྩེ་གཅིག་ལགས་པ་འདོད་དོན་ཡིད་བཞིན་འགྲུབ་པའི་ཐུགས་དམ་སྐྱབས་འཇུག་དང་།",
    "ལྷ་རྫས་རྣམ་པར་དཀར་ཞིང་བཀྲ་ཤིས་པའི་རེ་ཁས་བརྒྱན་པ།",
    "ཕྲན་ཆུང་ཡང་གང་གི་བཀའ་དྲིན་གྱི་ཞོ་ཤས་འཚོ་བཞིན་པར་སྔ་མཁོ་ལྟར་ལགས།",
    "དེང་གི་དུས་བསྐལ་མང་སྔོན་ནས་བཟང་པོར་སྦྱང་བའི་འབྲས་བུ་དུས་སུ་སྨིན་པའི་མཛེས་སྐུའི་དཀྱིལ་འཁོར་རྡོ་རྗེ་དང་གཡུང་དྲུང་གི་ངོ་བོར་བརྟན་ཅིང་གཙུག་ལག་གཉིས་ཀྱི་ཕྲིན་ལས་ནམ་མཁའི་ཁྱོན་ལྟར་ཡངས་པ་ལ།",
    "གང་གིས་མངོན་བལྟམས་རིན་ཆེན་གྱི།",
    "བུམ་བཟང་ཡ་ཐབས་ཡས་ཁ་ཡ་བྱཡས་ཁམས་ཅེས་ཤིས་པའི་ཚིག་གིས་མདུན་བསུས་ཏེ།",
    "གང་གི་མཁྱེན་བརྩེའི་གཟི་བྱིན་དར་བབ་པས།",
    "མིག་གི་བདུད་རྩིར་བསྟན་པ་ནམ་ཞིག་གུ།",
    "ཡུལ་མཐར་སློང་མོས་དྲེལ་པའི་ལྡོམ་བུ་པ།",
    "དེ་ལྟ་མོད་ཀྱི་ལྷག་བསམ་ཤུགས་བདོ་བས།",
    "ཡ་མཐའ་འཁས་པས་མཁས་པ་མང་བ་བབ་ཆ་གདུང་སེལ་བདུད་རྩི་སྤྲོ་བ་ཁྱོད་ལས་སུ།",
    "སླད་མར་སྒྲུབ་བརྒྱུད་མཆོག་གི་རིང་ལུགས་གང་།",
    "དྲི་བཟང་ཕུར་མ་འཐོར་བཞིན་དེ་རིང་སོང་།",
    "ཏམོ་ཉནྟཀཱརསྱབྷབིགཧཧཱུྃཛཱནཔྲབྷསོཤུརཁཞདྷཱརཾ།",
    "ཅེས་ཤིས་པའི་ཚིག་གི་མེ་ཏོག་སྔོན་དུ་གཏོར་ནས།",
    "གནམ་བསྐོས་འཇམ་དབྱངས་ཆེན་པོའི་ཕྲིན་ལས་ཀྱི་འཁོར་ལོ་མཛེས་པར་བྱེད་པའི་མཁྱེན་རབ་ཀྱི་མཛོད་འཛིན་དམ་པ་གང་གི་དྲུང་དུ།",
    "གསུང་གི་གླེགས་བུ་ལྷ་རྫས་དཀར་པོའི་གོས་ཅན་དང་།",
    "སྐུ་གཟུགས་ཀྱི་ཚད་སྟོན་པའི་བསྟན་བཅོས་ལྗགས་རྩོམ་མ་བཅས་སྩལ་བ་ཕྱག་རྒྱའི་རེ་ཁ་མ་ཉམས་པར་འབྱོར་བས་ཆར་སྤྲིན་མཐོང་བའི་རྨ་བྱ་བཞིན་དུ་བདག་གི་ཀུན་རྟོག་གི་འདུ་བྱེད་མཆོག་ཏུ་སྤྲོ་བའི་གར་གྱིས་དྲེལ་བར་གྱུར་ལགས།",
    "ལྷ་ལྡན་དང་ཐག་ཅུང་ཟད་འགྱངས་པའི་སྟབས་ཀྱིས་ཡི་གེ་ལོ་ལྟར་ཕྱིས་སོང་བ་ཡིན་ནམ།",
    "ཆེད་དུ་གསོལ་འོས་འགའ་ཞིག་ཟུར་དུ་འབུལ་བར་ཡང་གཟིགས་པས་ཁྱབ་པ་ནས།",
    "མ་། མཉྩབྷིམཧོཏྟརསྱཀརྨསུནྡརཾཀརབྷཱཥཎཱབྷཱུཏྲཔཎྜིཏེཤཱརཡསྱཀིནརེ།",
    "ཕན་བདེའི་རྩ་ལག་གཅིག་པུ་ཁྱོད་ལ་སྤྱི་བོས་འདུད།",
    "ཟབ་མོ་བརྒལ་དཀའ་གང་གི་བཀའ་དྲིན་གྲུ་གཟིང་གིས།",
    "བདེ་བར་འདྲེན་མཛད་ཡོངས་འཛིན་དེད་དཔོན་ཁྱོད་ལས་སུ།",
    "མཁས་མཆོག་རྣམ་འདྲེན་བཱ་མ་ན་ཁྱོད་ཀྱིས།",
    "ཤེས་བྱ་མཐའ་དག་གཟིགས་པའི་གོམ་རླབས་ཀྱིས།",
    "དེ་ཕྱིར་ཟླ་མེད་ཡོན་ཏན་འབུམ་ཕྲག་གིས།",
    "གུས་པ་ཕྲན་རྣམས་ཀྱང་གང་གི་བཀའ་དྲིན་གྱི་གདུགས་དཀར་པོའི་གྲིབ་བསིལ་དུ་བདེ་བར་སྤྱོད་པའི་སྐབས་ལགས།",
    "བཞུགས་སྟན་རབ་དཀར་རྡོ་རྗེའི་རེ་ཁ་བཀྲ་བ།",
    "ཞེས་པའི་ཞུ་ཡིག་ལ་སྤྱན་ཟུར་ཡུད་ཙམ་རོལ་བའི་རྟེན་མཚོན་ཙམ་དུ་ལྷ་གོས་རྣམ་པར་དཀར་བས་བཅིབས་ཏེ་སྣོན་ཟླའི་དཀར་ཕྱོགས་གང་བ་དང་པོའི་ཚེས་ལ་ཕྲན་ཞྭ་དམར་བ་དང་སི་ཏུ་དཔོན་སློབ་ཐུན་མོང་ནས་གུས་པ་ཆེན་པོས་ཕྱག་དང་བཅས་ཏེ་ཕུལ་བའི་ཞུ་ཡིག། ། བྲཧྨདི་ལོཀོཏྟརཀིཏྟབྷོཏུ།",
    "གང་དང་གང་གིས་ལེགས་གསོས་འཕགས་པའི་ཚོགས།",
    "ཇི་ཕེབ་ལྟར་ལུང་གི་བསྟན་པ་འཆད་རྩོམ་གྱིས་སྤེལ་བར་བྱེད་པ་ལ་བརྡ་སྤྲོད་ཚིག་རྒྱན་དང་བཅས་པ་ཞིག་ལ་ཐོག་མར་འཇུག་པ་གལ་ཆེ་བ་དགོངས་པར་བཞུགས་པས་རིག་ལམ་དེར་ཐུགས་བརྩོན་གནང་བ་ཤིན་ཏུ་ལེགས་ཤིང་རྗེས་སུ་ཡི་རང་བར་གྱུར་ཅིང་།",
    "བློ་གསལ་གཞན་དང་གཞན་དག་དགའ་བས་ཡིད་དྲངས་ཏེ་པད་རྫིང་ལ་ངང་མོ་བཞིན་དུ་འགྱུར་བ་ལྟ་ཅིར་སྨོས།",
    "སླད་མར་ཡང་མཉེས་གཤིན་པའི་གསུང་གི་བགྲོད་པ་དཔྱིད་ཀྱི་ཕོ་ཉའི་གླུ་དབྱངས་བཞིན་དུས་དུས་སུ་སྩོལ་བ་ཅི་གནང་།",
    "དམ་པ་གང་གི་མཁྱེན་དཔྱོད་ནོར་བུའི་སྒྲོམ་ལས་ཉེ་བར་ཐོན་པའི་ཚིག་རྒྱན་གྱི་དཔེར་བརྗོད་མུ་ཏིག་ཕྲེང་མཛེས་སྩལ་བ་ལ།",
    "སླད་མར་ཡང་མོས་བརྩོན་ཤེས་བཟོད་བཞི་དང་ལྡན་པའི་ཚུལ་གྱིས་བརྩམ་བྱ་དོན་གྱི་གནས་གཙུག་ལག་གཉིས་ལ་གཏན་ཚིག་ཆེན་པོས་ངེས་པར་བྱེད་ཅིང་།",
    "ཉམས་པར་བྱས་མོད་ཆབ་འབངས་སྲོག་གི་ཟུངས།",
    "བདུད་རྩིར་བསྒྱུར་ལ་དགའ་བའི་གད་མོ་ནི།",
    "བྱིས་གཞན་གཡེང་བའི་ལྟད་མོར་མི་ཆེ་བས།",
    "ལེགས་མིན་ཐེ་ཚོམ་དབྱིངས་སུ་འཕྱང་མོ་ཉུག།",
    "ལྷ་རྫས་ཟླ་བའི་སྲིང་མོའི་མཐུན་འགྱུར་ཅན།",
    "དེང་བསྐལ་མང་སྔོན་ནས་བཟང་པོར་སྤྱོད་པའི་འབྲས་བུ་དུས་སུ་སྨིན་པའི་གསང་གསུམ་མི་ཟད་རྒྱན་གྱི་འཁོར་ལོ་བསྟན་འགྲོ་ཡོངས་ཀྱི་སྤྱི་དཔལ་དམ་པར་མི་ཤིགས་རྡོ་རྗེའི་གཡུང་དྲུང་གི་ངོ་བོར་འཚོ་གཞེས་པ་ནི་བཀའ་དྲིན་གྱི་དཔལ་དམ་པར་གྱུར།",
    "དེ་དག་ལ་གེགས་བཟློག་ལེགས་སྤེལ་སོ་སོར་སྤང་བླང་ཇི་ལྟར་བསྒྲུབ་འོས་རྣམས་ཡེ་ཤེས་སྤྱན་གྱི་གཟིགས་པ་རྒྱས་པའི་ཐུགས་རྗེའི་སྤྱན་རས་ཀྱི་བཙའ་བ་ནས་གསུང་གི་བདུད་རྩི་དམན་པ་རྣམས་ཀྱིས་གོ་བདེ་ལྷག་རྩོལ་གྱི་བཀའ་ལན་སྤྱི་བོར་ཕེབ་ཐུབ་པ་ཞིག་མཁྱེན་མཁྱེན།",
    "ཁོ་བོའི་དགའ་བ་བདག་གི་ལམ་དུ་རྒྱུག།",
    "དགྱེས་པའི་སྤྱན་ཟུར་ལྷུང་བའི་རྟེན་དུ་རེ།",
    "དེ་སླད་རེ་བའི་ཁུར་ཆེན་ཐོགས་པ་ནི།",
    "བདག་ལ་ཀུན་རྟོག་ལང་ཚོ་ཡོལ་བའི་དགྲར།"
  ]
}