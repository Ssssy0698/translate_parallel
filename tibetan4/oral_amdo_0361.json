    "རྣམ་དབྱེ་གསུམ་ལྔའི་དཔེར་བརྗོད་བསྟན་ཨ་མ་ལ་ཕ་འམ་འདས་པས་འདས་པ་བས་མ་པའི་ལེའུ་སྟེ་བདུན་པའོ།",
    "ཕྱིས་སུ་དོན་དུ་གཉེར་བའི་དགེ་གྲོགས་འགའ་ཞིག་གིས་ཀྱང་བསྐུལ་བ་ལྟར།",
    "ཞུམ་ཞིང་སྨད་པ་དང་བྲལ་བའི་ཡེ་ཤེས་ཀྱི་འཇུག་པ་ཕྲ་མོས་ཡོངས་སུ་སྙིལ་བར་མཛད་ཅིང་།",
    "དེང་དུས་གང་གི་སྒྱུ་འཕྲུལ་རྡོ་རྗེ་སྐུ་ཡི་སྣང་བརྙན་འཆི་མེད་བདུད་རྩིས་རབ་དགྱེས་ནས།",
    "འདི་ན་གང་གི་བཀའ་དྲིན་ཉི་ཟེར་གྱི།",
    "སླད་མར་ཁྱོད་ཀྱི་མཛད་བཟང་བདུད་རྩི་ལྟ་བུ་གཞན་ཕན་ཁོ་ནའི་རྗེས་སོང་ཕྱིར།",
    "དམུ་རྒོད་སྐྱེ་བོ་ལོག་ལྟའི་དུག་གིས་ཉམས་ཀུན་ཐུགས་རྗེའི་སྟོབས་ཀྱིས་མི་འདོར་བར།",
    "སྲིད་པ་གསུམ་ན་ཟིག་བཅས་ཟག་མེད་ཀྱི།",
    "ས་སྐྱའི་སྨ་ཉིས་གནང་ཚོབ་བ་བཟ་བའི་ཐ་བདསབདུབོདཀྱིལདུ་༧ ། ཨོཾ་སྭསྟི།",
    "གང་གི་ཞབས་མཐིལ་བྱི་རུའི་འདབ་བརྒྱ་ཕན་བདེའི་རྡུལ་ཕྲེང་སྤྲོ་དེའི་དྲུང་།",
    "གང་གི་བཀའ་འབངས་གུས་པའི་བདུད་རྩིའི་ཆུས།",
    "དེང་དུས་གང་གིས་འགྲོ་ཕན་ལྷུར་བཞེས་རྗེས་ཐོབ་སྒྱུ་འཕྲུལ་སྣ་ཚོགས་རླབས།",
    "རྣ་བའི་མགྲོན་དུ་ཡང་ཡང་གཉེར་ཀྱང་རེ་ཞིག་རྐྱེན་འགས་རྒྱང་རིང་བྱས།",
    "དེ་ཚེ་ཁྱོད་ཞལ་ཤིན་ཏུ་ཞི་ཡང་ཀླག་ཅོར་གུས་པའི་གདུང་སྤེལ་ཤིང་།",
    "ཕྱོགས་སུ་མ་ལུས་རྣམ་པར་སྣང་ཡང་བདུད་དཔུང་མོག་པོར་བྱེད་པའི་ཚུལ།",
    "ཁྱད་པར་སྙིགས་དུས་གཏི་མུག་གིས་ནོན་ཞིང་།",
    "གང་གི་ཐུགས་སུ་ཤེས་བྱའི་རྣམ་པ་ཀུན།",
    "ཉོན་མོངས་གྱུར་གང་བ་མོས་རེག་པའི་དགུན་དུས་ཀུ་ལྟ་བུར་མཛོད།",
    "མགོན་ཁྱོད་བདག་སོགས་འཁྲུལ་བཅས་བྱིས་བློའི་ངོར།",
    "བརྒལ་པར་ནུས་པའི་རེ་བ་རྒྱང་བསྲིངས་བའི།",
    "དེང་དུས་གང་གི་གཟུགས་ཀྱི་སྒྱུ་འཕྲུལ་སྐུ།",
    "གང་གིས་ཐུགས་བསྐྱེད་རྒྱ་ཆེན་དགོངས་མཛོད་ལ།",
    "བསྟན་འགྲོའི་ལང་ཚོ་འདི་ལ་གཟིགས་ཤིག་དང་།",
    "ཕྱོགས་སུ་མངོན་མཐོའི་ལང་ཚོ་རྒྱས་པར་མཛོད།",
    "བདག་གི་ལྷག་བསམ་དཀར་བའི་བདེན་ཚིག་གིས།",
    "༣་ན་བསབ་ས་པས་། ཞྭ་དམར་ནག་ལྷན་རྒྱས་སུ་ཕུལ་བའི་ཞུ་ཡིག། ། མཆོག་གི་དངོས་ཀུན་བདེ་བ་ཆེན་པོ་རུ།",
    "དེ་སྐད་བསྔགས་པ་བརྗོད་པས་མདུན་བསུས་ཏེ་རིགས་ཀུན་གྱི་ཁྱབ་བདག་རྣམ་པར་དབྱེ་བ་ལས་འདས་པ་གང་གི་ཞབས་མཐིལ་སྣང་བའི་མུ་ཁྱུད་དགེ་མཚན་འཆར་ཀའི་རེག་བྱས་དམ་དུ་འཁྱུད་པས་ལུས་ཅན་ཕན་བདེའི་སྐྱེད་ཚལ་ཅི་དགར་བཞད་པ་ག་ལ་བར།",
    "སྡང་བའི་ཁྲག་གིས་རྟག་ཏུ་གོས་པའི་ཕས་རྒོལ་ཚོགས་ཀྱི་གདུག་པའི་སེམས།",
    "ཉི་མས་གདུང་བའི་གླང་ཚོགས་ལྷགས་པའི་ཚེ།",
    "གང་གི་ཐུགས་རྗེ་མཁའ་ཁྱབ་ཀྱི།",
    "སྐྱབས་གནས་མཆོག་གི་ཞབས་པད་ལ།",
    "གང་གི་འབངས་ཐ་རྒན་པོ་ཡིས།",
    "གང་ཁྱོད་གདོད་ནས་རྫོགས་བྱང་གི།",
    "སྒྱུ་འཕྲུལ་མཆོག་གིས་སྲིད་མཚོ་འདིར།",
    "བདག་གི་མགོན་དུ་གྲུབ་པ་གང་།",
    "མོས་ལྡན་གདུལ་བྱ་ཐར་གླིང་དུ།",
    "བོང་བ་གསེར་དུ་གཟིགས་པ་ཡི།",
    "གོས་ཡུག་ཟུང་གི་གནང་སྐྱེས་བཅས།",
    "གང་གི་དགྱེས་པ་སྐོང་བྱེད་ཅིང་།",
    "གང་གི་དགྱེས་བསྐང་ཁོ་ན་ལས།",
    "གང་གི་ཞབས་པད་བསྙེན་པར་སོང་།",
    "དངུལ་སྲང་ལྔ་བཅུ། ། ལྷར་བཅས་འགྲོ་བ་ཡོངས་ཀྱི་སྐྱབས་མགོན་རབ་འབྱམས་རྒྱལ་བ་ཀུན་འདུས་མཚུངས་མེད་ཐམས་ཅད་མཁྱེན་གཟིགས་ཆེན་པོའི་ཞབས་སྟེགས་ཀྱི་པདྨ་རྣམ་པར་བཞད་པའི་དྲུང་དུ།",
    "གུས་ཕྲན་གཞོན་ནུ་པས་ཐལ་མོ་སྤྱི་བོར་བཅིངས་ཏེ་གསོལ་བ།",
    "དེང་གང་གི་སྐུ་གསུང་ཐུགས་རྡོ་རྗེ་གསུམ་གྱི་རང་བཞིན་དུས་གསུམ་གྱི་བདེ་བར་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གསང་བའི་མཛོད་དང་གཉིས་སུ་མེད་པར་བདག་སོགས་འགྲོ་བ་ཡོངས་ཀྱི་མགོན་དང་དཔལ་དམ་པར་འཚོ་ཞིང་གཞེས་པ་ནི་གཞལ་དུ་མེད་པའི་བཀའ་དྲིན་གྱི་དཔལ་དམ་པར་གྱུར་ལགས།",
    "སྐྱབས་མགོན་མཆོག་གི་བཀའ་དྲིན་གྱིས་བསྐྱངས་བས་ལམ་བར་སོགས་སུ་བགྲོད་པ་བདེ་ཞིང་རང་གནས་གྲུབ་པའི་གནས་ཆེན་དུ་དམ་པ་རྣམས་དང་མཇལ་བའི་ལེགས་ཚོགས་ཀྱི་སྐལ་བཟང་ཅིའང་ཉམས་སུ་མྱོང་བར་གྱུར་ལགས།",
    "ཞུ་འདེགས་མཚོན་བྱེད་ལྷ་རྫས་རྣམ་པར་དཀར་བ་བཅས་ཟླ་ཚེས་ལ་གུས་པས་ཕུལ་བའི་ཞུ་ཡིག་། པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པར་ཞྭ་དམར་མཆོག་སྤྲུལ་གྱིས་ཕུལ་བའི་ཞུ་ཤོག་། ཕྱོགས་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བ་མི་རྗེ་སའི་ཚངས་པ་ཆེན་པོ་བཀའ་དྲིན་མཚུངས་མེད་ཐུགས་རྗེའི་གཏེར་ཆེན་གང་གི་ཞབས་བརྟན་གསེར་ཁྲིའི་དྲུང་དུ།",
    "ཐོག་མར་རྒུད་པའི་མུན་པ་དྲུངས་ནས་འབྱིན་བྱེད་ཐུགས་རྗེའི་འོད་དཀར་འབུམ་ཕྲག་འགྱེད་པའི་གསེར་ཞལ་ཟླ་བའི་དཀྱིལ་འཁོར་མངོན་སུམ་དུ་མིག་གི་བདུད་རྩིར་བསྟར་བའི་སྐལ་བཟང་ཉམས་འོག་ཏུ་ཆུད་པའི་ལེགས་སྐྱེས་མཆོད་བྱེད་ཙམ་དུ།",
    "རྒྱ་མཚོར་བརྟན་པ་ནས་མི་མཐུན་ཉེས་བརྒྱའི་གཡུལ་ལས་རྣམ་པར་རྒྱལ་ཞིང་གངས་ལྗོངས་བསྟན་འགྲོ་མཐའ་དག་གི་ཕན་བདེའི་དཔལ་ཡོན་རྣམ་པར་སྤེལ་བ་དང་ལྟོས་བཅས་རྣམས་ཀྱང་།",
    "རྣམ་ཀུན་ཐུགས་རྗེ་ཆེན་པོའི་ངོར་ནས་ནམ་ཡང་འདོར་བ་མེད་པའི་བཀའ་དྲིན་མཆོག་བསྐྱངས་བ་བཅས་རེ་བའི་ཤིང་རྟ་ཡིད་བཞིན་དུ་གང་བར་མཛད་དུ་གསོལ།",
    "གུས་ཞབས་པ་ཞྭ་དམར་སྤྲུལ་མིང་གིས་སྐུ་མཆོག་མཚན་དཔེའི་དཀྱིལ་འཁོར་དཔལ་དུ་འབར་བ་ཐོག་མར་མཇལ་ཞིང་གསུང་གསང་གཞོམ་མེད་རྡོ་རྗེའི་སྒྲ་དབྱངས་མཉན་པ་དང་།",
    "གང་ཁྱོད་བསྐལ་པ་རྒྱ་མཚོའི་བར་དག་ཏུ།",
    "བདེ་ལྡན་ཞིང་གི་མགོན་པོ་འོད་མཐའ་ཡས།",
    "གང་གི་ཐུགས་རྗེ་ཆེན་པོའི་རྣམ་རོལ་ལས།",
    "བདག་ཅག་མོས་ལྡན་དད་པའི་ཡིད་མཁའ་རུ།",
    "བཀའ་དྲིན་མཆོག་གིས་རྗེས་སུ་བཟུང་དུ་གསོལ།",
    "། རྒྱལ་ཀུན་འདུས་ཞལ་འཁོར་ལོའི་མགོན་པོ་མཆོག་གི་ཞབས་པད་དུ། ། གུས་པ་ཆེན་པོས་ཞུ་བ།",
    "ད་དུང་ཡང་བྲཧྨའི་ཡུལ་གྱི་དགེ་སློང་སྔགས་རྒྱུད་ཤེས་པ་ཞིག་སྤྱན་འདྲེན་པར་མི་ཁ་ཤས་བཏང་ཡོད་པར་འདོད་དོན་འགྲུབ་པར་ཐུགས་རྗེས་གཟིགས་པ་མཁྱེན་མཁྱེན།",
    "སླད་ནས་ཀྱང་ཞབས་པད་རྡོ་རྗེ་དང་གཡུང་དྲུང་གི་ངོ་བོར་མཆོག་ཏུ་བརྟན་ཅིང་།",
    "ཕྱོགས་བཅུར་རྒྱུ་བའི་སློང་མོ་པ།",
    "གང་ཁྱོད་བརྟུལ་ཞུགས་གྲུབ་པའི་རིགས།",
    "གཟིགས་པ་ཡོན་པར་མ་གྱུར་པ།",
    "གསུང་གི་སྤྲིང་ཡིག་གསར་པ་དག།",
    "དེང་ཚོགས་གཉིས་རྒྱ་མཚོའི་བཅུད་དུ་འཁྲུངས་པའི་གསང་གསུམ་ཉིན་མོར་བྱེད་པའི་དཀྱིལ་འཁོར་གདུལ་བྱའི་མོས་མཁར་ནམ་ཡང་འགོག་པ་མེད་པར་འཚོ་གཞེས་བརྟན་ཅིང་རྣམ་པར་དཀར་བའི་ཕྲིན་ལས་ཀྱི་འོད་སྟོང་ཕྱོགས་བརྒྱར་འགྱེད་པའི་གྲགས་སྙན་སྟེང་འཐུང་དཀར་པོའི་མཛེས་རྒྱན་རྣ་བར་ཐོབ་པས་གུས་སྤྲོའི་ཕུང་པོ་མཆོག་ཏུ་བརྟས་པར་འགྱུར་ལགས།",
    "གསུང་གི་གསང་བ་ཟབ་མོའི་ཅོད་པན་སྤྱི་བོའི་རྒྱན་དུ་ཆད་པ་མེད་པར་སྩོལ་བ་མཁྱེན་མཁྱེན་ལགས།",
    "ཁོང་དཔོན་སློབ་ཚོར་བདེ་མཆོག་བློས་སློང་གི་ལག་ཁྲིད་སྨིན་རྒྱས་འབུལ་བར་སྤྲོ་ཡང་།",
    "འབྲི་གུང་ཞབས་དྲུང་གི་མདུན་དུ།",
    "པ་མ་དེང་རླབས་ཆེན་ཚོགས་གཉིས་ཀྱི་རྒྱ་མཚོ་ལས་ཐོན་པའི་མཛེས་སྐུའི་དཀྱིལ་འཁོར་ཉིན་མོར་བྱེད་པའི་དཔལ་དུ་འབར་ཞིང་།",
    "ཕྲིན་ལས་ཀྱི་འོད་སྟོང་ཕྱོགས་བརྒྱར་སྤྲོ་བས་སྐྱེ་དགུ་ཐ་དག་གི་རྒུད་པ་སེལ་བའི་དཔལ་ཡོན་དམ་པར་འཚོ་ཞིང་གཞེས་པ་ནས་བདག་ཅིག་ལ་རྗེས་སུ་འཛིན་པའི་བཀའ་ཤོག་རྟེན་ལྡན་དང་།",
    "། བཀྲ་ཤིས་རྩེར་ཡབ་ཡུམ་ལ། ། རྒྱལ་བའི་རྣམ་འཕྲུལ་སྐྱེད་མཛད་ནོར་བུའི་ཟ་མ་ཏོག་གྱུར་ཡབ་ཡུམ་ལྷན་རྒྱས་མཆོག་གི་སྐུ་དྲུང་དུ།",
    "དེང་གནའ་ནས་ལེགས་གོམས་ཚོགས་གཉིས་ཀྱི་འབྲས་བུ་གཡུར་དུ་ཟ་བའི་གཟུགས་སྐུ་ཡོངས་འདུའི་ལྗོན་པ་གདུལ་བྱ་མཐོ་རིས་དཔལ་མོའི་རེ་བསྐང་དམ་པར་འཚོ་ཞིང་གཞེས་པ་བཀའ་དྲིན་གྱི་དཔལ་དམ་པར་གྱུར་ལགས།",
    "མགོན་པོ་ཁྱོད་ཀྱི་ཞལ་གྱི་བདུད་རྩི་མིག་དང་ཡིད་ཀྱི་བཅུད་ལེན་དུ་བསྟན་པར་རིང་ཞིག་ནས་བརྣག་ཀྱང་ཡུལ་དུས་ཀྱིས་བསྐལ་ཞིང་།",
    "མི་རིང་བ་ཞལ་གྱི་དཀྱིལ་འཁོར་མཇལ་ཞིང་གསུང་གི་བདུད་རྩི་ནོད་ཆོག་པའི་འདུན་པ་རྩེ་ཡས་མཁས་པ་མཁས་གཅིག་ཞུ་བས་འདོད་དོན་འགྲུབ་པའི་དགོངས་གཏད་དང་།",
    "དཔལ་མོ་གང་དེའི་ཞལ་སྔ་རུ།་",
    "སོར་མོའི་ཡལ་འདབ་ལས་འདིར་ཐོབ།",
    "ཡིད་རབ་སྤྲོ་བའི་མཆིད་ཚིག་གི།",
    "གོས་ཆེན་ཡུག་དང་གཟིགས་ལྤགས་ཡཁམས་པ་ལ་ཨ་ཕས་མ་གཡས་པས་འབར་ཡང་དཔལ་བཅས།",
    "ཉྩཀ་པ་ད་ན་། དགེ་མཚན་འབུམ་ཕྲག་བཞད་པའི་མཆིད་ཚིག་གིས།",
    "སི་ཏུའི་མིང་གི་པུཎྜི་རི་ཀའི་རྒྱན།",
    "དབྱངས་ཅན་ཕྱག་གི་རྒྱུད་མང་ལྟར་སྙན་ཅིང་།",
    "སྤྱི་ཏོར་རྩེ་མོར་ཅིས་ཀྱང་སྣང་བར་མཛོད།",
    "འཆི་མེད་མཆོག་གི་ཀཆུ་ར་ཡིས་དགྱེས་འགྱུར་ཅིག་ཅེས་བདག་ཅག་སྨོན།",
    "གཟིགས་རྟེན་ན་བུན་གོས་གྱོན་ཏེ།",
    "སླད་མར་ཡང་གང་ཁྱེད་དཔག་ཡས་གདུལ་བྱའི་མགོན་སྐྱབས་དཔུང་གཉེན་དམ་པར་མགོན་པོ་ཚེ་མཐའ་ཡས་པའི་ངོ་བོར་ཞབས་པད་བརྟན་པར་རྩེ་གཅིག་ཏུ་གསོལ་བས་རེ་བའི་ཤིང་རྟ་ཕྱུར་བུར་འགེངས་པ་དང་།",
    "བདག་ཅག་རྣམས་ཀྱང་ཐུགས་རྗེ་ཆེན་པོས་སྐད་ཅིག་ཀྱང་མི་འདོར་བའི་བཀའི་ཅོད་པན་ཚངས་གནས་ཀྱི་རྒྱུན་དུ་ཚངས་པའི་རལ་ཀླུང་གི་རྒྱུན་བཞིན་སྩོལ་བ་མཁྱེན་མཁྱེན་ལགས།",
    "གང་གི་ཐུགས་རྗེའི་འོད་ཟེར་གྱིས་བསྐྱངས་པས་བདེ་བར་འཚོ་ཞིང་།",
    "ཞབས་པད་བརྟན་ཅིང་མཚན་དཔེའི་དཀྱིལ་འཁོར་མྱུར་དུ་མཇལ་ཞིང་གསུང་གི་གདམས་པ་ནོད་པའི་སྨོན་འདུན་རྩེ་གཅིག་ཏུ་ཞུ་བས་རེ་བའི་ཤིང་རྟ་ཕྱུར་བུར་འགེངས་པ་དང་།",
    "ཕྲན་ཡངས་མཚུར་སོགས་དཀར་ཨ་མ་མཁའ་ཡསན་ལུགས་པ་ཕྲན་བུ་ཡོད་པ་རྣམས་ལའང་བརྩེ་བས་མ་དོར་བའི་ཕེབ་སློབ་ཡོད་པ་དང་།",
    "ཞུ་འདེགས་མཚོན་བྱེད་ཙམ་དུ་ལྷ་རེག་རབ་དཀར།",
    "འདིར་ཐུན་མོང་ཡང་མཆོག་གསུམ་གྱི་ཐུགས་རྗེས་ཟོ་བདོག་བདེ་ཞིང་དབེན་པ་ཞིག་ཏུ་དགེ་སྦྱོར་བཅད་རྒྱའི་སྐབས་སུ་གནས་ལགས།",
    "དེར་ཞབས་བརྟན་ལྷན་རྒྱས་འཇམ་དབྱངས་བདག་པོ་ཆེན་པོས་གཟིགས་པ་ཟླ་མེད་པས་མངའ་གསོལ་ཞིང་གངས་ལྗོངས་ཕན་བདེའི་བྱེད་པོ་གཅིག་པུ་པར་གྱུར་པས།",
    "ད་དུང་ཡང་སྔར་རྒྱུན་བཟང་པོ་ཆབ་མི་འཚལ་བའི་གཟིགས་པ་མཆོག་ནས་ནམ་ཡང་འདོར་བ་མེད་པ་དང་།",
    "གདུལ་བྱ་ཡོངས་ཀྱི་མགོན་པོ་དམ་པར་རྡོ་རྗེ་གཡུང་དྲུང་གི་ཁྲི་འཕང་མཐོན་པོར་ཞབས་བརྟན་པར་རྩེ་གཅིག་གསོལ་བ་ལགས་པས་དེ་བཞིན་དུ་འགྲུབ་པ་དང་།",
    "དེང་གང་གི་གསང་གསུམ་རྒྱལ་ཀུན་འདུས་ཞལ་པདྨ་ཀ་རའི་ཐུགས་རྗེའི་སྟོབས་ལས་ཉེ་བར་འཁྲུངས་པ་ཡིན་ལ་ཡིན་བཞིན་དུ་སྙིགས་དུས་ཀྱི་རྒུད་པ་མཐའ་དག་ཡོངས་སུ་ཕྲོག་པའི་དཔུང་གཉེན་དམ་པ་འཚོ་གཞེས་བརྟན་ཅིང་།",
    "བསྟན་འགྲོའི་ཕན་བདེ་འཇོམས་བྱེད་ནག་ཕྱོགས་འབྱུང་རིགས་ཀྱི་གཡུལ་ལས་རྣམ་པར་རྒྱལ་བཞིན་པ་ནས་བཀའི་གླེགས་བུ་ཕྱག་རྒྱའི་རེ་ཁཱ་མ་ཉམས་པ་སྤྱི་བོར་ཕེབས་པས་ཚེ་རབས་ཀུན་ཏུ་རྙེད་པར་དཀའ་བའི་བཀའ་དྲིན་མཆོག་གི་དགའ་བས་ཁྱབ་པར་གྱུར་ལགས།",
    "ཞབས་པད་བསྐལ་བརྒྱར་བརྟན་ཅིང་མི་རིང་བར་ངོས་མཇལ་སྐལ་བཟང་གི་དགའ་སྟོན་ལ་སྤྱོད་ཆོག་པའི་དགོངས་གཏད་ཐུགས་རྗེ་ཆེ་བ་མཁྱེན་མཁྱེན།",
