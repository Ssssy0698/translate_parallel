    "སླད་ནས་གང་གི་ཞབས་ཀྱི་དཀྱིལ་འཁོར་ངོམས་པ་མེད་པ་བལྟ་བ་དང་།",
    "གསུང་གི་བདུད་མ་རྩི་སྦྲང་རྩི་ལྟ་བུས་ལུས་སིམ་ཤིན་ཏུ་བརྟས་བྱེད་ཅིང་།",
    "ཁྱད་པར་མགོན་ཁྱོད་དུས་རིང་པོར།",
    "རྒྱལ་བ་མཆོག་གི་སྤྱན་སྔར་སོང་།",
    "མངྒ་ལཾ། ། སྐྱབས་མགོན་མཁྱེན་བརྩེའི་བདག་ཉིད་འཇིག་རྟེན་གསུམ་གྱི་འདྲེན་པ་མཆོག་གི་ཞབས་ཀྱི་པདྨ་དྲི་མ་མེད་པའི་དྲུང་དུ།",
    "དེང་གནའ་ནས་ལེགས་གོམས་དུས་སུ་སྨིན་པའི་གསང་གསུམ་རྡོ་རྗེའི་ལྷུན་པོ་མི་ཤིགས་འཆི་མེད་མཆོག་གི་དཔལ་དུ་འབར་ཞིང་གདུལ་བྱ་མཐའ་དག་སྨིན་གྲོལ་དམ་པས་མཐོང་ཐོས་དོན་ལྡན་དུ་མཛད་པའི་རིང་ནས་བཀའ་གླེགས་རྟེན་ལྡན།",
    "ཞབས་པད་མཆོག་ནས་རྣམ་ཀུན་བདག་ཅག་རྣམས་ལ་གཟིགས་པ་ཆེན་པོས་ཟླ་མེད་པར་བསྐྱངས་ཤིང་།",
    "དེ་སྐད་ཤིས་པའི་ངག་གི་ལམ་མཚོན་ནས།",
    "སྙན་ཚིག་རི་མོར་བསྟར་བའི་སྐྱེས་འདི་འབུལ།",
    "བགྲང་ཡས་སྤེལ་བའི་ཕྱི་མོ་འདུ་མཛད་པ།",
    "དགྱེས་བཞིན་བདེ་དང་རེག་པར་སྤྱོད་ལགས་སམ།",
    "མངོན་དུ་བྱས་མོད་ལས་ཀྱི་ཆུ་ཀླུང་གི།",
    "དེ་ཕྱིར་གང་གི་སྤྲིང་ཡིག་ཟླ་གསར་གྱི།",
    "དངོམས་བྱེད་ངག་གི་གར་མཁན་གླེགས་ཉིས་གཡས་གཡས་བ་འདས་ག་དྲུང་དུ།",
    "ཆེད་དུ་གསོལ་འོས་གང་གི་ཐུགས་རྗེའི་མཐུ་སྟོབས་ཟླ་མེད་པའི་དཔལ་དུ་ཆེ་ལགས།",
    "ད་ལན་བསྟན་འགྲོའི་ཕན་བདེ་འཇོམས་པར་ཆ་བའི་ལོག་སྦྱོར་བདུད་རིགས་ཀྱི་མཚན་མ་མཐའ་དག་ཉི་འོད་ཀྱིས་བ་མོ་ལ་རེག་པ་བཞིན་དུ་རང་བཞིན་གྱིས་རྨེག་མེད་དུ་བཅོམ་ནས་བསྟན་འགྲོ་ཡོངས་ལ་བདེ་སྐྱིད་ཀྱི་ཉི་མ་གསར་དུ་ཤར་བའི་རྫོགས་ལྡན་གྱི་དཔལ་མོ་ཡོངས་སུ་བཞད་པར་གྱུར་པ་བཅས་ཐུན་མོང་དུ་ལེགས་སྐྱེས་ཀྱི་མཚོན་བྱེད་ཙམ་དུ།",
    "གང་གི་ཐུགས་རྗེའི་འོད་ཟེར་གྱིས་བསྐྱངས་པས་བྲོ་མི་འཚལ་བར་དགེ་སྦྱོར་ལ་བརྩོན་བའི་བཅད་རྒྱའི་སྐབས་སུ་གནས་ལགས།",
    "རང་རེའི་དགོན་གནས་ཚོར་ཡང་དཀའ་ཚེགས་སྣ་ཚོགས་བྱུང་ཡོད་འདུག་ཀྱང་།",
    "དེ་ཞབས་མཆོག་གི་ཐུགས་རྗེའི་མཐུ་ཁོ་ནས་ཉམ་ངའི་གནས་སུ་མ་གྱུར་པར་བདེ་བར་འཁོད་ཆོག་པ་༤པའི་ཚེས་༣ལ་ཕུལ་བའི་ཞུ་ཡིག།",
    "མཆོག་གི་ཞབས་པད་དུ།",
    "ཕྱི་ནང་གི་གེགས་སེལ་ལ་དམིགས་པའི་རིམ་གྲོ་སོགས་ནི་རང་ཉིད་ཀྱིས་ནར་མར་སྒྲུབ་པ་དང་གཞན་བསྒྲུབ་ཏུ་འཇུག་པ་སོགས་ནན་ཏན་དུ་བགྱིད་པ་ལགས་ཤིང་།",
    "བི་བ་ཏི་རཱ་ལ་ཨ་མ་ཀ་ན་ཏྲི་ལོ་ཀ་དཱི་པ་ཀོ་ཊི་སྡུལྱཱ་ཡ།",
    "བྷ་བ་ལ་ཐབས་ལས་པས་ས་ལམ་མཁ་ཨ་ཕས་ང་བས་ཁ་ན་ཙྪ་སཾ་བི་རྒྱ་ཀ་མ་ཧཱ་ད་ཡཱ།",
    "མ་ཝབྷཏསཔྲཧྥེཤཱདེརཱདྷཏམཱུརྗེཔདནཁྱོ།",
    "ཕྱོགས་རེའི་འབངས་རྣམས་དྲང་སླད་ཉིད་དུ་འཁུམས།",
    "མཐོང་ཐོས་དྲན་རེག་འབྲེལ་བ་ཐོགས་སོ་ཅོག།",
    "ཁྱོད་སྐུ་མཚན་དཔེ་བྱེ་བའི་དཔལ་འབར་ཞིང་།",
    "ཁྱོད་གསུང་རྡོ་རྗེ་རྣམ་པ་ཐམས་ཅད་པ།",
    "རེ་བའི་ཤིང་རྟ་འདོད་དགུའི་དབྱིག་གིས་འགེངས།",
    "འདྲེལ་ཚད་དོན་ལྡན་ཁྱོད་ལས་སྐྱབས་གཞན་མེད།",
    "རྩ་བ་གསུམ་ཡང་ཁྱོད་ཉིད་ཁོ་ནར་ངེས།",
    "གཏན་གྱི་སྐབས་གཅིག་ཁྱོད་ལ་རྣམ་ཀུན་ཏུ།",
    "དུས་ཕུན་སུམ་ཚོགས་པ་འཕགས་ཡུལ་གྱི་ལུགས་སུ་ལོའི་ཐོག་མར་གྱུར་ཅིང་གནའ་མིའི་བོད་རྣམས་ལ་རྣམ་པར་རྒྱལ་བའི་དགེ་མཚན་ཐོབ་པའི་དུས་ཀྱི་དང་པོར་གྲགས་པ་སྨལ་པོ་ཟླ་བའི་དཀར་ཕྱོགས་གང་བ་དང་པོའི་ཚེས་རེས་གཟའ་འོད་སྟོང་བདག་པོ་ལ་རྒྱུ་སྐར་གྲོ་བཞིན་གྱི་དགའ་མས་རོལ་བའི་ཚེ།",
    "ཐོག་མར་བཞུགས་སྟན་རབ་དཀར་རྡོ་རྗེ་དང་གཡུང་དྲུང་གི་རེ་ཁས་བརྒྱན་པ། ཚན་དང་པོར།",
    "གོས་དམར་ཡུག་ལ་སེར་ཡུག་ཟམ་ལྗང་ནག་ཡུག་རེ་རེ།",
    "མིང་གི་ལྷག་མའི་གནས་ཀྱང་བཏང་སྟེ་ཞི་གྱུར་ཅིག།",
    "ཡིད་ཀྱི་ཤིང་རྟ་འདོད་དགུའི་དབྱིག་གིས་གང་གྱུར་ཅིག།",
    "བཀྲ་ཤིས་མཆོག་གིས་ས་བླ་ས་འོག་ས་སྟེང་དུ།",
    "རྣམ་རོལ་རྒྱལ་བ་མཆོག་གི་ཞབས་རྡུལ་ནི།",
    "མི་ཕྱེད་དད་པའི་གཙུག་གིས་རྟག་ཏུ་བསྟེན།",
    "གང་ཁྱོད་རྩ་གསུམ་གཅིག་ཏུ་འདུས་པའི་དཔལ།",
    "ཞེས་མི་ཟད་པའི་ཡོན་ཏན་གྱི་ཕུང་པོ་ལ་བསྔགས་ཤིང་གསོལ་བ་གདབ་པ་སྔོན་དུ་བཏང་ནས་དུས་གསུམ་གྱི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པ་མཐའ་དག་གཅིག་ཏུ་འདུས་པའི་བདག་ཉིད་སྲིད་ས་ཡས་པས་འབར་བས་བསམ་མ་བ་ས་ལས་ལ་འབད་པས་མཁས་ཞི་ཡོངས་ཀྱི་རྣམ་པར་འདྲེན་པ་ཆེན་པོ་གང་གི་ཞབས་སྟེགས་ཆུ་སྐྱེས་ཀྱི་རྡུལ་ཕྲན་དྲན་པ་ཙམ་གྱིས་ཉེས་པའི་རྙོག་མ་མཐའ་དག་གྲུང་བར་བྱེད་པའི་ནོར་བུ་ཀེ་ཏ་ཀ་ཆེན་པོའི་དྲུང་དུ།",
    "གུས་ཕྲན་སི་ཏུའི་མིང་གིས་ད་ལན་གྱི་སྐབས་འདིར་ཐོག་མར་མཚན་དཔེའི་དཔལ་གྱིས་འབར་བའི་ཞལ་གྱི་དཀྱིལ་འཁོར་མངོན་སུམ་དུ་མཇལ་ཞིང་།",
    "གཟིག་ལྤགས།",
    "རྒྱལ་བས་རྒྱལ་མཛད་ཁྱོད་ཀྱིས་བསྐྱངས་བ་འདིར།",
    "གཙུག་ལག་གཉི་གའི་ཕན་ཡ་ཡ་བདེ་དབྱིག་གི་ཆར།",
    "ཉིན་མོར་བྱེད་པ་ལྟ་བུའི་གསེར་ཞལ་མངོན་སུམ་དུ་མཇལ་བའི་འདུད་ཕྱག་གི་རྟེན་མཚོན་བྱེད་ཙམ་དུ།",
    "ཛཱ་ཏི་ཕྱི་མོ་མཉམ་པ་ཞེས་པའི་ཛཱབྷཱ་བའོ།",
    "ད་ལན་ཉམ་ང་བའི་མུན་པ་དངས་པར་བྱེད་པའི་ཕན་བདེའི་འོད་ཟེར་བྱེ་བ་འཕྲོ་བའི་གསེར་ཞལ་ཉིན་མོར་བྱེད་པའི་དཀྱིལ་འཁོར་ཐོག་མར་མཇའ་བའི་དགེ་མཚན་གྱི་རེ་ཁཱ་མི་ཟུམ་པར་བྱེད་པའི་འབུལ་མཚོན་སྟོང་མིན་ཙམ་དུ།",
    "དྲེའུ་གཉིས་བཅས་ཁྱོན་རྣམ་གྲངས་ཉེར་ལྔ་ཚན་འབུལ་ལམ་ཞུས་པར།",
    "དྲེའུ་གཉིས་བཅས་ཁྱོན་རྣམ་གྲངས་ཉི་ཤུ་རྩ་གསུམ་འབུལ་ལམ་ཞུས་པས་བརྩེ་བ་ཆེན་པོས་བཞེས་ནས།",
    "རྣམ་པ་ཀུན་ཏུ་བཀའ་དྲིན་ཆེན་པོས་རྗེས་སུ་བཟུང་ཞིང་རེ་བའི་ཤིང་རྟ་ཕྱུར་བུར་གང་བར་མཛད་དུ་གསོལ།",
    "གང་ཁྱོད་ཞབས་པད་རྡོ་རྗེ་ལྟར་བརྟན་ཅིང་།",
    "གུང་འབངས་ཐ་ཤལ་བས་ཡན་ལག་མཆོག་གིས་ལན་བརྒྱར་བཏུད་དེ་གསོལ་བ།",
    "དེ་ལྟའི་ངོ་མཚར་གྱི་ཕུང་པོ་གཞལ་བར་དཀའ་བ་ལ་དད་པའི་མིག་གིས་མངོན་དུ་ལྟ་ཞིང་ཞབས་ཀྱི་པདྨོར་ཕྱག་བགྱིད་པ་མཚོན་པའི་རྟེན་ཅིང་འབྲེལ་འབྱུང་མི་འགོག་ཙམ་དུ།",
