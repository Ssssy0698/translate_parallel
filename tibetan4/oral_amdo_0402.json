    "གང་གི་རྣམ་པར་སྨིན་པ་ཡིན་ཞེ་ན།",
    "དཔེར་ན་བྱང་གི་སྨྲ་མི་སྙན་པ་རྣམས་ཀྱི་ལྷར་སྐྱེ་བ་མྱོང་བར་འགྱུར་བ་བཞིན་ནོ།",
    "རེ་ཞིག་གཞན་དག་གིས་ཀྱང་མི་འཐོབ་བོ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "ཉོན་མོངས་པ་ཅན་ཡང་མ་ཡིན་ལ།",
    "དེའི་རྣམ་པར་སྨིན་པ་ནི་སྲིད་པའི་རྩེ་མོའི་ཕུང་པོ་བཞི་ཡིན་ནོ།",
    "དེ་དག་གི་ཡོན་ཏན་འབྱོར་བ་མངོན་སུམ་དུ་འགྱུར་བ་ཐམས་ཅད་ནི་བཞེད་པ་ཙམ་ལ་རག་ལུས་པ་ཡིན་པས་དེ་ལྟ་བས་ན་དེ་དག་གི་ཐམས་ཅད་ནི།",
    "ཁ་ཆེ་བ་རྣམས་ན་རེ་དེ་ལྟར་བསྐྱེད་དུ་མི་རུང་ངོ་ཞེས་ཟེར་རོ།",
    "སྲིད་པའི་རྩེ་མོའི་འདོད་ཆགས་དང་བྲལ་བ་ན་ཉོན་མོངས་པའི་རྣམ་པ་དགུ་སྤོང་བར་བྱེད་པ་ན་བར་ཆད་མེད་པ་དང་རྣམ་པར་གྲོལ་བའི་ལམ་དགུ་དགུ་སྐྱེ་བའི་ཕྱིར་བཅོ་བརྒྱད་དེ།",
    "ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ཀྱི་འདོད་ཆགས་དང་བྲལ་བ་དེ་ངེས་པ་ལ་འཇུག་པའི་ཕྱིར་ས་འོག་མ་པའི་ཉོན་མོངས་པ་རྣམས་ནི་ཡང་སྤང་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "ཉི་འོག་པ་རྣམས་ན་རེ་བསམ་པ་མི་ལྡང་བ་ཅན་ཡིན་པ་བདེན་མོད་ཀྱི།",
    "ཟག་པ་ཟད་པ་མ་ཐོབ་ཀྱི་བར་དུ་རེ་ཞིག་སྐྱིལ་མོ་ཀྲུང་མི་གཞིག་གོ་སྙམ་པའི་བསམ་པ་འདི་མི་ལྡང་བའི་ཕྱིར་ཏེ།",
    "སྙོམས་པར་འཇུག་པ་འདི་གཉིས་ཀྱི་རྣམ་པའི་བྱེ་བྲག་མ་ཡིན་མོད་ཀྱི།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་ནི་དང་པོ་ཉིད་དུ་མི་དག་གི་ནང་དུ་སྐྱེད་དོ།",
    "ཕྱིས་ནི་སྔར་ཡོངས་སུ་ཉམས་པ་དག་གིས་གཟུགས་ཀྱི་ཁམས་སུ་ཡང་སྐྱེད་དོ།",
    "ཤེས་རབ་ཕུན་སུམ་ཚོགས་པ་ཡང་ཡིན་པ་དེ་ནི་ཡང་དང་ཡང་དུ་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ལ་སྙོམས་པར་འཇུག་པ་དང་ལྡང་བའི་གནས་དེ་ཡོད་དོ་ཞེས་བྱ་བར་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་རབ་ཏུ་ཤེས་སོ།",
    "སྙོམས་པར་འཇུག་པ་འདི་ནི་སྲིད་པའི་རྩེ་མོ་པ་ཡིན་ན་དེ་ཇི་ལྟར་དེ་ཐོབ་པ་ཡོངས་སུ་མ་ཉམས་པ་གཟུགས་ཀྱི་ཁམས་སུ་སྐྱེ་བར་འགྱུར།",
    "བསམ་གཏན་བཞི་པ་དང་སྲིད་པའི་རྩེ་མོའི་ས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འབྲས་བུ་ལས་ཀྱང་འདུ་ཤེས་མེད་པ་པ་དང་སྲིད་པའི་རྩེ་མོའི་འབྲས་བུ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདུ་ཤེས་དང་ཚོར་བ་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ཞེས་བྱ་ཞེ་ན།",
    "ཚོར་བ་ལ་སོགས་པ་ཡང་ཤེས་མོད་ཀྱི་གཞན་གྱི་སེམས་ཤེས་པ་ཞེས་བྱ་བ་བཞིན་ནོ།",
    "སྔོན་གྱི་སློབ་དཔོན་གཞན་དག་ན་རེ་ནི་རེ་ཞིག་གཟུགས་མེད་པར་སྐྱེས་པ་རྣམས་ཀྱི་གཟུགས་འགགས་ནས་རིང་དུ་ལོན་ན་ཡང་གཟུགས་ཇི་ལྟར་སྐྱེ་ཞེ་ན།",
    "འདི་ནི་གང་གི་ལྟར་ན་འགོག་པའི་སྙོམས་པར་འཇུག་པ་སེམས་མེད་པ་པ་ཡིན་པ་དེ་ལ་སྐྱོན་དུ་འགྱུར་གྱི་ཁོ་བོ་ནི་འགོག་པའི་སྙོམས་པར་འཇུག་པ་སེམས་དང་བཅས་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "བཙུན་པ་དབྱངས་སྒྲོགས་ན་རེ་དེ་ནི་མི་འཐད་དེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་རྣམ་པར་ཤེས་པ་ཡོད་ན་གསུམ་འདུས་པ་ལས་རེག་པ།",
    "རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དང་འདུ་ཤེས་དང་སེམས་པ་ཞེས་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་འདི་ལ་འདུ་ཤེས་དང་ཚོར་བ་དག་ཀྱང་འགག་པར་མི་འགྱུར་རོ།",
    "འོན་ཏེ་ཚོར་བའི་རྐྱེན་གྱིས་སྲེད་པ་ཞེས་གསུངས་མོད་ཀྱི་དགྲ་བཅོམ་པ་ལ་ཚོར་བ་ཡོད་བཞིན་དུ་སྲེད་པ་མི་སྐྱེ་བ་དེ་བཞིན་དུ་རེག་པ་ཡོད་བཞིན་དུ་ཚོར་བ་ལ་སོགས་པ་མི་འབྱུང་ངོ་ཞེ་ན།",
    "མ་རིག་པའི་འདུས་ཏེ་རེག་ས་ལས་སྐྱེས་པའི་ཚོར་བ་ལ་བརྟེན་ནས་སྲེད་པ་སྐྱེས་སོ་ཞེས་གསུངས་ཀྱི།",
    "ཚོར་བ་སྐྱེས་པ་ལ་རེག་པ་ནི་བྱེ་བྲག་ཏུ་མ་བྱས་པས་འདི་ནི་མི་འདྲའོ།",
    "སྙོམས་པར་འཇུག་པའི་སེམས་ཁོ་ན་དེ་དང་འགལ་བའི་རྟེན་སྐྱེད་པའི་ཕྱིར་གང་གིས་ན་དུས་གཞན་གྱི་བར་དུ་སེམས་མི་འཇུག་པ་ཙམ་དུ་འགྱུར་བ་དེ་ལས་གཞན་པའི་སེམས་དང་འགལ་བར་སྐྱེ་སྟེ།",
    "རྟག་ཏུ་ལྡོག་པ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "དྲོད་དང་རྣམ་པར་ཤེས་པ་དག་གི་རྟེན་དུ་གྱུར་པ་ཡང་ལས་ཁོ་ན་ཡིན་པར་ཅིའི་ཕྱིར་མི་འདོད་དོ།",
    "མེད་དོ་ཞེས་ནི་མི་སྨྲ་མོད་ཀྱི་རྫས་གཞན་ནི་མེད་དོ།",
    "མདའ་འཕངས་པ་དག་གི་གནས་པའི་དུས་ཀྱིས་འཕེན་པ་བཞིན་ནོ།",
    "གང་གི་ལུས་ལ་གནོད་པ་ཉིད་མེད་པ་དེ་ནི་ཇི་ལྟར་སྐྱེས་པ་བཞིན་དུ་གནས་པའི་ཕྱིར་གཉིས་པ་ཡིན་ནོ།",
    "འདོད་པའི་ཁམས་ན་ལྷ་རྩེད་མོས་མྱོས་པ་རྣམས་དང་།",
    "བྱང་གི་སྒྲ་མི་སྙན་པ་རྣམས་དང་།",
    "བསམ་གཏན་དང་གཟུགས་མེད་པ་གཞན་དག་ནི་བདག་ཉིད་འཆི་བ་ནི་རང་གི་ས་པའི་འཕགས་པའི་ལམ་ཡིན་ལ།",
    "ཧ་ཅང་ཐལ་བས་ཆོག་གོ།",
    "རྒ་བ་དང་མི་རྟག་པ་ཉིད་དག་གིས་ནི་ད་ལྟར་བྱུང་བ་ནས་འདས་པར་ཏེ།",
    "དེ་ལས་གཅིག་གིས་ནི་ཐིབས་པོ་ནས་འབྱིན་པར་བྱེད།",
    "འདུས་མ་བྱས་ཀྱང་རང་གི་མཚན་ཉིད་ལ་གནས་པ་ཡོད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་འདུས་བྱས་ཀྱི་མཚན་ཉིད་ནི་བཞི་ཁོ་ནའོ་སྙམ་མོ།",
    "དེ་དག་ལ་ཡང་སྐྱེ་བ་ལ་སོགས་པ་གཞན་དུ་ཐལ་བའི་ཕྱིར་རེ་རེ་ལ་ཡང་མཚན་ཉིད་བཞི་པ་དང་མཐར་ཐུག་པ་མེད་པའི་སྐྱོན་དུ་ཡང་འགྱུར་བ་མ་ཡིན་ནམ་ཞེ་ན།",
    "དཔེར་ན་ཁྱིམ་བྱ་མོ་ལ་ལ་ལས་ནི་ཕྲུ་གུ་མང་དུ་འབྲང་ལ།",
    "དེ་བས་ན་ཐུག་པ་མེད་པར་ཐལ་བར་མི་འགྱུར་རོ་ཞེས་གྲག་གོ།",
    "སྐད་ཅིག་མ་རེ་རེ་ལ་ཡང་རྫས་གཞན་དུ་རྟོགས་པ་མེད་པ་བཞིན་དུ་འདུས་བྱས་ཀྱི་དེ་དག་རུང་སྟེ།",
    "སྐད་ཅིག་མ་རེ་རེ་ལ་མ་བྱུང་བ་ལས་བྱུང་བ་ནི་སྐྱེ་བའོ།",
    "འདིར་སྐྱེ་བ་ལ་སོགས་པ་རྫས་གཞན་དག་གིས་ཅི་ཞིག་བྱ།",
    "རེ་ཞིག་ཇི་ལྟར་ན་སྐྱེས་བུ་ཆེན་པོའི་མཚན་རྣམས་སྐྱེས་བུ་ཆེན་པོ་ལས་མི་གཞན་པ་ཡིན།",
    "གཞན་ཡང་ཇི་ལྟར་གྱེན་དུ་འགྲོ་བ་ལས་ནི་ཐག་རིང་པོ་ནས་དུ་བ་ལ་དུ་བ་ཉིད་དུ་ཤེས་མོད་ཀྱི།",
    "འདུས་བྱས་གཟུགས་ལ་སོགས་པ་རང་གི་ངོ་བོ་བཟུང་ཡང་ཇི་སྲིད་དུ་སྔ་ན་མེད་པ་དང་ཕྱིས་མེད་པ་དང་རྒྱུན་གྱི་བྱེ་བྲག་མི་ཤེས་པ་དེ་སྲིད་དུ་འདུས་བྱས་ཉིད་དུ་མི་ཤེས་ཏེ།",
    "རེ་ཞིག་འདིར་ཅི་མ་འོངས་པ་རྫས་སུ་ཡོད་དམ་མེད་ཅེས་བྱ་བ་འདི་དཔྱད་དགོས་པར་འགྱུར་ཏེ།",
    "འདི་གང་གི་ཚེ་གནས་པས་གནས་པར་བྱེད་པ་དེ་ཉིད་ཀྱི་ཚེ་རྒ་བས་རྒ་བར་བྱེད་ཅིང་མི་རྟག་པ་ཉིད་ཀྱིས་འཇིག་པར་བྱེད་པའི་ཕྱིར་འདི་ཅི་དུས་དེར་གནས་སམ།",
    "འོན་ཏེ་ཇི་སྐད་དུ་ཁོ་བོ་ཅག་གི་སྐད་ཅིག་མ་ནི་ཇི་ཙམ་གྱིས་འདི་ཐམས་ཅད་རྫོགས་པར་འགྱུར་བ་དེ་ཡིན་ནོ་ཞེས་བརྗོད་ན།",
    "ཡང་ན་དེ་དག་གིས་ཅི་ཞིག་བྱ་སྟེ།",
    "སེམས་དང་སེམས་ལས་བྱུང་བ་རྣམས་སྐད་ཅིག་མ་ཉིད་དུ་ཁས་བླངས་པས་དེ་དག་གིས་མི་རྟག་པ་ཉིད་འཇིག་པའི་རྒྱུ་ལ་མི་ལྟོས་པའི་ཕྱིར་གནས་པ་དང་མི་རྟག་པ་ཉིད་དག་དུས་ཐ་མི་དད་པར་བྱ་བ་བྱེད་པར་འགྱུར་བས་ཅིག་ལ་དུས་གཅིག་ཏུ་གནས་པ་དང་འཇིག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ན་རེ་སྐྱེ་བ་ལ་སོགས་པ་རྫས་ཀྱི་དངོས་པོར་གྲུབ་པ་ཉིད་དོ།",
    "མིང་གི་ཚོགས་ལ་སོགས་པ་གང་ཞེ་ན།",
    "མིང་གི་ཚོགས་ལ་སོགས་པ་ནི།",
    "གང་གིས་བྱ་བ་དང་ཡོན་ཏན་དང་དུས་ཀྱི་འབྲེལ་བའི་ཁྱད་པར་རྟོགས་པར་འགྱུར་རོ།",
    "ཡི་གེ་རྣམས་ཀྱང་ཡི་གེ་འབྲུའི་ཡན་ལག་དག་གི་མིང་དག་མ་ཡིན་ནམ་ཞེ་ན།",
    "ཡི་གེ་རྣམས་ནི་དེ་དག་གི་མིང་མ་ཡིན་ནོ།",
    "མིང་ལ་སོགས་པ་དེ་དག་གི་ཚོགས་ནི་མིང་ལ་སོགས་པའི་ཚོགས་དག་ཡིན་ཏེ།",
    "དེ་ལ་མིང་གི་ཚོགས་ནི་དཔེར་ན་གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱ་དག་ཅེས་བྱ་བ་སྟེ།",
    "ཚིག་གི་ཚོགས་ནི་དཔེར་ན་འདུ་བྱེད་ཐམས་ཅད་མི་རྟག་པ་དག་གོ།",
    "དེ་དག་ཀྱང་ངག་གི་རང་བཞིན་ཡིན་པའི་ཕྱིར་སྒྲའི་བདག་ཉིད་ཡིན་པས་གཟུགས་ཀྱི་རང་བཞིན་དག་མ་ཡིན་ནམ་ཅིའི་ཕྱིར་སེམས་དང་ལྡན་པ་མ་ཡིན་པ་རྣམས་ཞེས་བྱ་ཞེ་ན།",
    "དེ་དག་ནི་ངག་གི་རང་བཞིན་མ་ཡིན་ཏེ།",
    "ངག་གི་སྒྲ་ཡིན་ན་སྒྲ་ཙམ་གྱིས་ནི་དོན་གང་དག་གོ་བར་མི་འགྱུར་རོ།",
    "ངག་ནི་མིང་ལ་འཇུག་ལ་མིང་གིས་ནི་དོན་རྗོད་པར་བྱེད་དོ།",
    "སྒྲ་ཙམ་ཁོ་ན་ནི་ངག་མ་ཡིན་གྱི་སྒྲ་གང་གིས་དོན་གོ་བར་འགྱུར་བའི་སྒྲ་དེ་དག་ཡིན་ནོ།",
    "ཡང་སྒྲ་གང་གིས་དོན་གོ་བར་འགྱུར་ཞེ་ན།",
    "གང་གིས་སྨྲ་བ་པོ་རྣམས་ཀྱིས་དོན་དག་ལ་མཚམས་བཅད་པ་སྟེ།",
    "གང་ཡང་མིང་གིས་དོན་རྗོད་པར་བྱེད་དོ་སྙམ་དུ་སེམས་པ་དེས་ཀྱང་གདོན་མི་ཟ་བར་གལ་ཏེ་དོན་གོ་བར་བྱེད་པ་ཡིན་ཞེས་བྱ་བ་འདི་ཁས་བླང་བར་བྱ་དགོས་ཏེ།",
    "ཅི་རེ་ཞིག་སྐྱེད་པར་བྱེད་དམ།",
    "གལ་ཏེ་སྐྱེད་པར་བྱེད་ན་ནི་ངག་གི་སྒྲའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་སྒྲ་ཙམ་ཐམས་ཅད་ཀྱིས་མིང་སྐྱེད་པར་འགྱུར་རོ།",
    "འོན་ཏེ་གསལ་བར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན་ནི་ངག་གི་སྒྲའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་སྒྲ་ཙམ་ཐམས་ཅད་ཀྱི་མིང་གསལ་བར་བྱེད་པར་འགྱུར་རོ།",
    "སྐྱེད་པར་བྱེད་པ་ན་ཇི་ལྟར་ངག་གིས་མིང་སྐྱེད་པར་བྱེད།",
    "རེ་ཞིག་ཇི་ལྟར་ན་འདས་པ་ལ་ལྟོས་པའི་རྣམ་པར་རིག་བྱེད་ཀྱི་སྐད་ཅིག་མ་ཐ་མས་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་སྐྱེད་པར་བྱེད།",
    "དེ་ལྟ་ན་འོ་ན་ནི་སྒྲ་ཐ་མ་ཁོ་ནས་མིང་སྐྱེད་པའི་ཕྱིར་གང་གིས་དེ་གཅིག་ཁོ་ན་ཐོས་པ་དེས་ཀྱང་དོན་གོ་བར་འགྱུར་རོ།",
    "འོན་ཏེ་འདི་སྙམ་དུ་ངག་གིས་ནི་ཡི་གེ་སྐྱེད་པར་བྱེད་ལ།",
    "ཕ་རྣམས་ཀྱིས་བུ་དག་གི་མིང་དགའ་མགུར་འདོགས་ན་མིང་གང་ཞིག་དེ་དང་ལྷན་ཅིག་སྐྱེས་པ་ཡིན་པར་འགྱུར།",
    "ཡི་གེ་ཙམ་ཞིག་རྫས་གཞན་གྱི་དངོས་པོར་ཡོངས་སུ་རྟོག་པ་ཡིན་དུ་ཆུག་ན་ཡང་དེའི་ཚོགས་ཁོ་ན་མིང་གི་ཚོགས་ལ་སོགས་པ་ཡིན་པར་འགྱུར་བས་དེ་དག་ཏུ་རྟོག་པ་དོན་མེད་པ་ཡིན་ནོ།",
    "ཡང་ཅི་མིང་གི་ཚོགས་ལ་སོགས་པ་འདི་དག་ལྡན་པའམ།",
    "གཞན་དག་ན་རེ་གཟུགས་མེད་པར་གཏོགས་པ་ཡང་ཡོད་མོད་ཀྱི་དེ་དག་ནི་བརྗོད་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "འདི་དག་གི་བརྗོད་པར་བྱ་བ་ལྷག་མ་དང་།",
    "རེ་ཞིག་སྐྱེ་བ་ལ་བགེགས་བྱེད་ནུས་པ་རྣམས་ནི་བགེགས་མི་བྱེད་པའི་ཕྱིར་རྒྱུ་ཉིད་དུ་ཡང་འགྱུར་ཏེ།",
    "བྱེད་རྒྱུའི་རྒྱུ་གཙོ་བོ་གང་ཡིན་པ་འདི་ནི་བསྐྱེད་པར་བྱ་བ་ལ་ཡང་ནུས་པ་ཡོད་དེ་དཔེར་ན་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་མིག་དང་གཟུགས་དག་དང་།",
    "གཞན་དག་ན་རེ་ཐམས་ཅད་སྐྱེས་པ་ལ་བྱེད་པའི་རྒྱུ་ཐམས་ཅད་ཀྱང་ནུས་པ་ཡོད་དེ།",
    "འདི་ལྟ་སྟེ་མྱ་ངན་ལས་འདས་པ་ཡང་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་ནུས་པ་ཡོད་པ་ལྟ་བུའོ་ཞེས་ཟེར་རོ།",
    "དེས་རིམ་གྱིས་ཕྱིར་མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེད་པའི་ཕྱིར་རྒྱུ་རྒྱུད་པའི་སྒོ་ནས་དེ་ཡང་རྐྱེན་དུ་གྱུར་པའི་ཕྱིར་ནུས་པ་ཡོད་དོ།",
    "འདུས་བྱས་ཀྱི་མཚན་ཉིད་རྣམས་ནི་མཚན་གཞིའི་ཡིན་ལ་དེ་ཡང་དེ་དག་གི་ཡིན་ཏེ།",
    "སེམས་དང་དེ་དག་གི་མཚན་ཉིད།",
    "རེ་ཞིག་དུས་ལས་ནི་སེམས་དང་ལྷན་ཅིག་སྐྱེ་བ་དང་གནས་པ་དང་འགག་པ་གཅིག་པ་ཉིད་དང་དུས་གཅིག་ཏུ་གཏོགས་པ་ཉིད་ཀྱིས་སོ།",
    "དེ་དག་གི་མཚན་ཉིད་བཞི་བཅུ་དང་།",
    "རང་གི་མཚན་ཉིད་དང་མཐུན་པའི་མཚན་ཉིད་བརྒྱད་ཀྱི་ཡིན་ནོ།",
    "རང་གི་མཐུན་པའི་མཚན་ཉིད་མ་གཏོགས་པ་རྣམས་སོ།",
    "གཞན་དག་ན་རེ་བཅུ་བཞི་ཡིན་ཏེ།",
    "རང་གི་མཚན་ཉིད་དག་ཁོ་ནའོ་ཞེས་ཟེར་རོ།",
    "རེ་ཞིག་ཅི་མར་མེ་འོད་ཀྱི་རྒྱུ་ཡིན་ནམ།",
    "སེམས་ཀྱི་མཐུན་པའི་མཚན་ཉིད་ལ་སོགས་པ་ཡང་སེམས་ལ་སོགས་པ་དང་དེར་ཐལ་བར་འགྱུར་རོ།",
    "ཉོན་མོངས་པ་ཅན་རྣམས་ནི་ཉོན་མོངས་པ་ཅན་རྣམས་ཀྱི་ཡིན་ནོ།",
    "གཞན་དག་ན་རེ་ལུང་དུ་མ་བསྟན་པའི་གཟུགས་ནི་ལྔ་པོ་དག་གི་ཡིན་ལ།",
    "ནུར་ནུར་པོ་ནི་ནུར་ནུར་པོ་ལ་སོགས་པ་གནས་སྐབས་བཅུ་པོ་དག་གི་ཡིན་ནོ།",
    "མེར་མེར་པོ་ལ་སོགས་པ་ནི་རིས་མཐུན་པ་གཅིག་ལ་རེ་རེ་ཕྲི་ནས་མེར་མེར་པོ་ལ་སོགས་པའི་ཡིན་ནོ།",
    "རྣམ་པ་མཐུན་པ་གཞན་དག་ཏུ་ནི་གནས་སྐབས་བཅུ་ཆར་ཡང་བཅུ་པོ་དག་གི་ཡིན་ནོ།",
    "འདི་དག་ལ་རང་གི་རིས་དང་ས་ཡོད་པས་འདི་དག་ནི་རང་གི་རིས་དང་ས་པ་དག་གོ།",
    "དེ་ལ་སྡུག་བསྔལ་མཐོང་བས་སྤང་བར་བྱ་བ་རྣམས་ནི་སྡུག་བསྔལ་མཐོང་བས་སྤང་བར་བྱ་བ་རྣམས་ཀྱི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་གྱི་གཞན་དག་གི་ནི་མ་ཡིན་ནོ།",
    "བསམ་གཏན་དང་པོའི་ས་པ་རྣམས་ཀྱང་བསམ་གཏན་དང་པོའི་ས་པའི་ཡིན་པ་ནས་སྲིད་པའི་རྩེ་མོའི་ས་པའི་བར་དག་ཀྱང་དེའི་ས་པའི་རྣམས་ཁོ་ནའི་ཡིན་གྱི་གཞན་དག་གི་ནི་མ་ཡིན་ནོ།",
    "དེ་དང་མཚུངས་པར་ལྡན་པའི་སྡུག་བསྔལ་གྱི་བདེན་པ་མ་གཏོགས་པ་དེ་ལས་གཞན་པའི་སྡུག་བསྔལ་གྱི་བདེན་པ་གང་ཡིན་པ་དེ་ནི་འཇིག་ཚོགས་ལ་ལྟ་བའི་རྒྱུ་ལས་བྱུང་བ་ནི་ཡིན་ལ།",
    "རྣམ་པར་སྨིན་པའི་རྒྱུ་ནི་སྔ་ཕྱི་མེད་བཞིན་དུ་ཡང་དེ་ལྟར་ཕན་ཚུན་འབྲས་བུ་ཉིད་དུ་ཐལ་བར་མི་འགྱུར་ཏེ།",
    "གཟུགས་མེད་པ་གསུམ་དག་གི་ལམ་གྱི་བདེན་པ་ནི་ཕན་ཚུན་དང་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་ནོ།",
    "ས་དེ་པ་དག་གིས་བདག་གིར་མ་བྱས་པའི་ཕྱིར་ཁམས་དེ་དག་ཏུ་གཏོགས་པ་མ་ཡིན་ཏེ།",
    "འདི་ལྟ་སྟེ་དད་པས་རྗེས་སུ་འབྲང་བ་དང་དད་པས་མོས་པ་དང་དུས་ཀྱིས་རྣམ་པར་གྲོལ་བའི་ལམ་རྣམས་ནི་དྲུག་དང་བཞི་དང་གཉིས་དག་གི་ཡིན་ནོ།",
    "དུས་དང་མི་སྦྱོར་བར་རྣམ་པར་གྲོལ་བའི་ལམ་རྣམས་ནི་གསུམ་དང་གཉིས་དང་གཅིག་གི་ཡིན་ནོ།",
    "ཅི་ལམ་ཁོ་ན་མཉམ་པ་དང་ཁྱད་པར་ཅན་དག་གི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་ནམ་ཞེ་ན་སྨྲས་པ་མ་ཡིན་ཏེ།",
    "མཉམ་པ་དང་ཁྱད་པར་ཅན་དག་གི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་གྱི་དམན་པའི་ནི་མ་ཡིན་ནོ།",
    "ཉོན་མོངས་པ་ཅན་རྣམས་ཀྱང་དེ་དང་འདྲའོ།",
    "གཅིག་དག་གི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ནི་དུས་དང་རྒྱུད་ཐ་དད་པ་ལས་སྐྱེས་པ་རྣམས་ཕན་ཚུན་དུ་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཡང་དེ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཟླ་བ་ཚེས་པ་ལ་སོགས་པ་ལ་ལྟ་བའི་ལྟ་བུར་རྒྱུད་ཐ་དད་པ་ལས་སྐྱེས་པ་རྣམས་ལ་ཡང་ཐལ་བར་འགྱུར་ཏེ།",
    "གང་གིས་ན་མཚུངས་པར་ལྡན་པའི་རྒྱུ་གང་ཡིན་ཞེ་ན།",
    "གཅིག་མེད་ན་ཡང་ཐམས་ཅད་མཚུངས་པར་མི་ལྡན་པས་འདི་ནི་དེ་དག་གི་རྒྱུའི་དངོས་པོ་ཡིན་ནོ།",
    "ཀུན་འགྲོ་ཞེས་བྱ་ཉོན་མོངས་ཅན།",
    "རིས་གཞན་དག་གི་ཡང་རྒྱུ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་དག་གི་མཐུས་ནི་རིས་གཞན་པའི་ཉོན་མོངས་པ་དག་ཀྱང་སྐྱེ་བར་འགྱུར་རོ།",
    "མི་རྟག་པ་ཉིད་དག་མ་གཏོགས་པ་དེ་དག་ལས་གཞན་པ་སྡུག་བསྔལ་གྱི་བདེན་པ་ཉོན་མོངས་པ་ཅན་གང་ཡིན་པའོ་ཞེས་བྱ་བའི་བར་དུ་གསུངས་སོ་ཞེས་ཟེར་རོ།",
    "འཕགས་པའི་གང་ཟག་འདོད་པའི་འདོད་ཆགས་དང་བྲལ་བ་ལས་ཡོངས་སུ་ཉམས་པ་དེ་ལས་དང་པོར་ཉོན་མོངས་པ་ཅན་གྱི་སེམས་པ་མངོན་དུ་བྱེད་པ་གང་ཡིན་པའོ་ཞེས་གསུངས་པ་འདི་ཇི་ལྟར་དྲང་ཞེ་ན།",
    "གལ་ཏེ་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཞིག་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཡིན་ན་ནི་མིག་གི་རྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེར་མི་འགྱུར་རོ།",
    "འདོད་པའི་ཁམས་ན་རྣམ་པར་སྨིན་པའི་རྒྱུ་ཕུང་པོ་གཅིག་ལ་འབྲས་བུ་གཅིག་པ་ཅན་ནི་ཐོབ་པ་རྣམས་དང་དེ་དག་གི་སྐྱེ་བ་ལ་སོགས་པའོ།",
    "ཕུང་པོ་གཉིས་པ་ལ་འབྲས་བུ་གཅིག་པ་ཅན་ནི་ལུས་དང་ངག་གི་ལས་དང་དེ་དག་གི་སྐྱེ་བ་ལ་སོགས་པའོ།",
    "གང་གི་ཡིད་ཀྱི་སྐྱེ་མཆེད་ཡིན་པ་དེའི་ནི་གཉིས་ཏེ།",
    "གང་གི་རེག་བྱའི་སྐྱེ་མཆེད་ཡིན་པ་ཡང་དེ་དང་འདྲའོ།",
    "གང་གི་ལུས་ཀྱི་སྐྱེ་མཆེད་ཡིན་པ་དེའི་ནི་གསུམ་སྟེ།",
    "ལུས་དང་རེག་བྱ་དང་།",
    "གང་གི་གཟུགས་དང་དྲི་དང་རོའི་སྐྱེ་མཆེད་དག་ཡིན་པ་ཡང་དེ་དང་འདྲའོ།",
    "གང་གི་མིག་གི་སྐྱེ་མཆེད་ཡིན་པ་དེའི་ནི་བཞི་སྟེ།",
    "གང་གི་རྣ་བ་དང་།",
    "གང་གི་རྣམ་པར་སྨིན་པ་ལྔ་དང་།",
    "ཤིང་ནྱ་གྲོ་དྷ་ལ་སོགས་པ་དག་གི་ལྟ་བུའོ།",
    "ནས་དང་གྲོ་ལ་སོགས་པ་དག་གི་ལྟ་བུའོ།",
    "དེ་བཞིན་དུ་སྐད་ཅིག་མ་གཅིག་པའི་སྐད་ཅིག་མ་དུ་མ་བ་ནི་ཡིན་གྱི་བཟློག་པ་ནི་མ་ཡིན་ནོ།",
    "ཡང་རྒྱུ་འདི་དག་གི་དུས་ངེས་པ་གང་ཞེ་ན།",
    "རྒྱུ་དེ་དག་གང་གི་ཡིན་པའི་འབྲས་བུ་དེ་དག་གང་ཞེ་ན།",
    "དེ་ལྟ་ན་འོ་ན་ནི་འདུས་མ་བྱས་འབྲས་བུ་ཡིན་པའི་ཕྱིར་དེ་གང་གི་འབྲས་བུ་ཡིན་པའི་རྒྱུར་ཡང་འགྱུར་ལ།",
    "རྒྱུ་ཡིན་པའི་ཕྱིར་དེ་གང་གི་རྒྱུ་ཡིན་པའི་འབྲས་བུར་ཡང་འགྱུར་རོ།",
    "ད་ནི་དེ་གང་གིའམ་ཇི་ལྟར་ན་འབྲས་བུ་ཡིན་ཞེ་ན།",
    "མ་གསུངས་མོད་ཀྱི་བཀག་པ་ནི་མེད་དོ།",
    "དེ་ལྟ་བས་ན་དེའི་རང་གི་ངོ་བོ་གཞན་དུ་བརྗོད་པར་བྱའོ།",
    "དེའི་རང་གི་ངོ་བོ་ནི་འཕགས་པ་རྣམས་ཁོ་ནས་སོ་སོ་རང་གིས་རིག་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་ནི་གཟུགས་དང་ཚོར་བ་ལ་སོགས་པ་བཞིན་དུ་རྫས་གཞན་དུ་ནི་མེད་དོ།",
    "རེག་བྱ་མེད་པ་ཙམ་ནི་ནམ་མཁའ་ཡིན་ཏེ།",
    "གཞན་དག་ན་རེ་སྔར་སྐྱེས་པ་ཕྱིས་མེད་པ་གང་ཡིན་པ་དེ་ཉིད་རང་གི་ངང་གིས་འགག་པའི་ཕྱིར་སོ་སོར་བརྟགས་པ་མ་ཡིན་པས་འགོག་པ་ཡིན་ནོ་ཞེས་ཟེར་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་ལ་དམིགས་པའི་ཉོན་མོངས་པ་སྤངས་པས་སྡུག་བསྔལ་སྤོང་བར་གསུངས་པ་ཡིན་ཏེ།",
    "ཡང་ན་དགོངས་པ་ནི་འདས་པའི་ཉོན་མོངས་པ་ནི་ཚེ་རབས་སྔ་མ་པ་ཡིན་ལ།",
    "ད་ལྟར་བྱུང་བའི་ཉོན་མོངས་པ་ནི་ཚེ་འདི་པ་ཡིན་ཏེ།",
    "ཉོན་མོངས་པ་གཉིས་པོ་འདིས་ཀྱང་རྒྱུད་འདི་ལ་མ་འོངས་པ་བསྐྱེད་པའི་ཕྱིར་ས་བོན་གྱི་དངོས་པོ་བཞག་པ་དེ་སྤངས་པས་དེ་ཡང་སྤངས་པ་ཡིན་ཏེ།",
    "མ་འོངས་པའི་སྡུག་བསྔལ་ལ་ཉོན་མོངས་པ་ནི་ས་བོན་མེད་པའི་ཕྱིར་གཏན་དུ་མི་སྐྱེ་བ་སྤངས་པ་ཡིན་ནོ།",
    "ཕྱིས་མེད་པ་ཡང་ཡོད་ཅེས་བྱ་མོད་ཀྱི་འོན་ཀྱང་མེད་པ་ནི་ཡོད་པར་མི་འགྲུབ་པ་ལྟར་འདུས་མ་བྱས་ཀྱང་དེ་བཞིན་དུ་བལྟ་བར་བྱའོ།",
    "རེ་ཞིག་འགོག་པའི་བདེན་པའི་དོན་འདི་གང་ཡིན།",
    "སྡུག་བསྔལ་མེད་པ་ལ་ཡང་མེད་པ་ཁོ་ནའོ་ཞེས་འདི་གཉི་ག་ཡང་ཕྱིན་ཅི་མ་ལོག་པར་གཟིགས་ན་འདི་འཕགས་པའི་བདེན་པ་ཉིད་ཡིན་པར་འགལ་བ་ཅི་ཞིག་ཡོད།",
    "གཟུགས་དང་ཚོར་བ་ལ་སོགས་པ་བཞིན་དུ་དེའི་རང་གི་ངོ་བོ་ཡང་མི་དམིགས་ལ་མིག་ལ་སོགས་པ་བཞིན་དུ་ལས་ཀྱང་མི་དམིགས་སོ།",
    "དངོས་པོ་ཆེ་གེ་མོ་ཞིག་གི་འགོག་པ་འདི་ཡིན་ནོ་ཞེས་རྣམ་པར་གཞག་པ་ཡང་ཇི་ལྟར་རབ་ཏུ་བརྟགས་ཏེ།",
    "རྒྱུ་དང་འབྲས་བུ་ལ་སོགས་པའི་དངོས་པོ་མི་སྲིད་པའི་ཕྱིར་དེ་ནི་དེ་དང་ལྷན་ཅིག་འབྲེལ་པ་འགའ་ཡང་མེད་ཀྱི་ཆེ་གེ་མོ་ཞིག་མེད་པའོ་ཞེས་འགག་པ་ཙམ་དུ་རུང་ངོ།",
    "དངོས་པོ་གཞན་ཉིད་ཡིན་ན་ཡང་ཉོན་མོངས་པ་གང་གི་ཐོབ་པ་ཆད་ནས་འགོག་པ་གང་ཐོབ་པ་དེ་དེའི་ཡིན་ནོ་ཞེས་ཐ་སྙད་གདགས་སོ།",
    "གཉེན་པོ་ཐོབ་པས་ཉོན་མོངས་པ་དང་།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་རྣམས་ན་རེ་འདིའི་དོན་ནི་འདི་མ་ཡིན་ནོ།",
    "ཡོངས་སུ་གཟུང་བའི་དངོས་པོ་ནི་ཇི་སྐད་དུ་ཞིང་གི་དངོས་པོ་དང་།",
    "རེ་ཞིག་དེ་ནི་རྫོགས་སོ།",
    "ཡང་འབྲས་བུ་འདི་དག་ལས་འབྲས་བུ་གང་ཞིག་རྒྱ་གང་གི་ཡིན་ཞེ་ན།",
    "གཞན་དག་ན་རེ་དེ་ལ་ཡང་སྐྱེས་བུའི་བྱེད་པའི་འབྲས་བུའི་སྐལ་བ་ནི་ཡོད་དོ།",
    "ཐུན་མོང་པའི་ཕྱིར་ཏེ།",
    "རྣམ་པར་སྨིན་པ་ནི་ཐུན་མོང་མ་ཡིན་པའི་སྟེ།",
    "ཐུན་མོང་གི་ལས་ལས་བྱུང་བའི་ཕྱིར་རོ།",
    "འདི་ལྟ་སྟེ་སྐལ་བ་མཉམ་པ་དང་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུ་དག་གི་ལྟ་བུའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གང་ཞིག་གང་གི་སྐལ་བ་མཉམ་པའི་རྒྱུ་ཡིན་པ་དེ་ཀུན་ཏུ་འགྲོ་བའི་རྒྱུ་ཡང་ཡིན་ནམ་ཞེ་ན།",
    "གང་གི་སྟོབས་ཀྱིས་གང་སྐྱེ་བའི།",
    "སོ་སོར་བརྟགས་པས་འགོག་པ་ནི་གང་གི་སྟོབས་ཀྱིས་འཐོབ་པ་ཞེས་བརྗོད་པར་བྱའོ།",
    "གཞན་དག་གི་ནི་བདག་པོའི་འབྲས་བུ་ཁོ་ན་ཡིན་ནོ།",
    "བྱེད་རྒྱུའི་རྒྱུ་ཡང་དེ་དང་དེ་འདྲ་མོད་ཀྱི་དེ་ནི་འབྲས་བུ་དང་བཅས་པར་མ་ངེས་པས་མ་བརྗོད་དོ།",
    "རེ་ཞིག་གང་འདས་པ་དག་ནི་རིགས་ནི་ད་ལྟར་གྱི་དག་གོ།",
    "འདི་སྐད་དུ་དེ་དག་ཉིད་ཀྱིས་ཡོངས་སུ་ཉམས་པའི་ཞེས་བརྗོད་པར་བྱ་བ་ནི་ཡིན་ནོ།",
    "རེ་ཞིག་འབྱིན་པ་གང་ཡིན་པ་ནི་འཛིན་པ་ཡང་ཡིན་ནོ།",
    "དམིགས་པ་དང་བཅས་པའི་ངེས་པས་ནི་སྐད་ཅིག་རེ་རེ་ལ་སྟེ།",
    "མིག་ལ་སོགས་པ་དག་གི་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་དག་ལྟ་བུའོ།",
    "འདི་ཐམས་ཅད་ནི་སྐྱེས་བུ་བྱེད་པ་དང་བདག་པོའི་འབྲས་བུ་དག་གི་ཁོངས་སུ་འདུས་སོ།",
    "དེ་དག་གི་ལྷག་མ་རྣམས་སོ།",
    "ཉོན་མོངས་ཅན་དང་རྣམ་སྨིན་སྐྱེས།",
    "དེ་ལ་ཉོན་མོངས་པ་ཅན་རྣམས་དང་།",
    "འདི་ལྟར་འདོད་པ་ན་སྤྱོད་པའི་གཟུགས་ཀྱི་མཇུག་ཐོགས་སུ་རེས་འགའ་ནི་འདོད་པ་ན་སྤྱོད་པ་དང་།",
    "རེས་འགའ་ནི་གཟུགས་མང་པོ་ལས་ཉུང་ངུ་འབྱུང་སྟེ།",
    "དཔེར་ན་སོག་མའི་ཐལ་བ་ལྟ་བུའོ།",
    "རེས་འགའ་ནི་ཉུང་ངུ་ལས་མང་པོ་འབྱུང་སྟེ།",
    "རིགས་གཞན་ལ་ནི་ཡོད་ཀྱི་རང་གི་རིགས་ལ་ནི་མེད་དེ།",
    "ཡང་ཅི་རང་གི་རིགས་ཁོ་ནའི་མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་ཡིན་ནམ་ཞེ་ན།",
    "འོ་ན་བཅོམ་ལྡན་འདས་ཀྱིས་མ་འོངས་པ་ཆེ་གེ་མོ་ཞིག་གི་མཇུག་ཏུ་མ་འོངས་པ་འདི་འབྱུང་ངོ་ཞེས་བྱ་བར་ཇི་ལྟར་མཁྱེན་ཅེ་ན།",
    "དེ་ལྟ་ན་བཅོམ་ལྡན་འདས་ཀྱིས་སྔོན་གྱི་མཐའ་མ་གཟིགས་པར་ཕྱི་མའི་མཐའ་མི་མཁྱེན་པར་འགྱུར་རོ།",
    "ད་ནི་ཇི་ལྟར་ལྡང་བའི་སེམས་ཡུན་རིང་མོ་ཞིག་ཏུ་ཆད་པ་སྙོམས་པར་འཇུག་པའི་སེམས་ཀྱི་མཚུངས་པ་དེ་མ་ཐག་པ་ཞེས་བྱ་ཞེ་ན།",
    "ཅི་རིགས་པར་མིག་གི་རྣམ་པར་ཤེས་པ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པའི་ནི་གཟུགས་སོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་རེག་བྱའོ།",
    "དཔེར་ན་ཤིང་ལ་སོགས་པ་མི་སྲེག་ཀྱང་དེ་ལྟ་བུའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་བུད་ཤིང་ཞེས་བྱ་བ་བཞིན་ནོ།",
    "གཞན་དག་ན་རེ་འདས་པ་རྣམས་ཀྱང་རྟེན་དང་ལྷན་ཅིག་པ་དག་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "རང་གི་ངོ་བོས་རང་གི་ངོ་བོ་ལྟ་བུའོ།",
    "རེ་ཞིག་རྒྱུའི་རྐྱེན་ནི་དེ་ལྟ་བུ་ཡིན་ནོ།",
    "མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་ནི་སེམས་དང་སེམས་ལས་བྱུང་བ་སྔ་མ་གཞན་དག་གི་བར་དུ་མ་ཆོད་པ་རྣམས་སོ།",
    "སེམས་ཀྱི་མཚུངས་པ་དེ་མ་ཐག་པ་ཅན་དག་ནི་ཡིན་གྱི་སེམས་སྐྱེ་བ་ལ་བགེགས་བྱེད་པའི་ཕྱིར་མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་ནི་མ་ཡིན་ནོ།",
    "གང་ཕྱིར་གདུང་ལྡན་གང་གི་ཕྱིར།",
    "ཡང་འགྲོ་བའི་རྒྱུ་གཅིག་ཏུ་ཡོངས་སུ་བཟུང་བས་དོན་གཞན་དག་གི་སྐྱེས་བུའི་བྱེད་པ་མངོན་སུམ་ནི་བསྙོན་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་འཇིག་རྟེན་གྱི་རྒྱུ་གཅིག་པུ་ནི་མེད་ཀྱི་འདི་ནི་རང་གི་ལས་རྣམས་ཁོ་ནས་སྐྱེ་བ་དེ་དང་དེར་སྐྱེ་བར་བྱེད་དོ།",
    "ཉོན་མོངས་བློ་མ་སྦྱངས་པ་རྣམས་ནི་རང་རང་གི་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་དང་།",
    "རི་མོའི་རྩིག་པ་བཞིན་ནོ།",
    "དེ་ལྟ་བས་ན་དེ་དག་གི་སྐྱེ་བ་དང་།",
    "རྣམ་པར་སྨིན་པའི་རྒྱུ་དག་གིས་སོ།",
    "རྣམ་པར་སྨིན་པའི་རྒྱུ་ནི་ལུས་དང་ངག་གི་ལས་གང་གི་རྣམ་པར་སྨིན་པ་མིག་ལ་སོགས་པ་ཡིན་པའོ།",
    "ལུས་དང་ངག་གི་ལས་གང་གི་རྣམ་པར་སྨིན་པ་རྣམས་ཡིན་པའོ།",
    "རང་གི་ས་པ་བཞི་དང་སློབ་པ་དང་།",
    "གཉེན་པོ་རིང་བ་ཉིད་དག་གིས་སོ།",
    "རང་གི་ས་པ་བཞི་དང་།",
    "རང་གི་ས་པ་དག་ཁོ་ནའོ།",
    "རང་གི་ས་པ་བཞི་དང་།"
  ]
