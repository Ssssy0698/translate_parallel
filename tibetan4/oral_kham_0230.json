    "ཞེས་སོགས་སུ་བསྒྱུར་བ་ནི་རང་བཟོའི་ཡང་རང་བཟོའོ།",
    "ལག་ལེན་པ་ཕྱི་མ་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་དུ་མཛད་ཀྱིན་འདུག་པས།",
    "སླར་ཡང་རང་བཞིན་གྱི་གནས་ནས་ཡེ་ཤེས་པ་དཔག་ཏུ་མེད་པ་སྤྱན་དྲངས།",
    "བོད་ན་དེ་བྱེད་པའི་སྲོལ་མི་འདུག་པས་འབྲང་རྒྱས་འབུལ་བ་ཡིན་ནའང་རུང་ངོ།",
    "དེ་ནས་ཡོན་བདག་རྣམས་བོས་ཏེ་གདན་བཟང་པོ་སེར་པོའི་སྟེང་དུ་འདུག་ཏུ་བཅུག་ལ།",
    "སང་ཐོ་རངས་རྟེན་གྱི་དྲུང་དུ་འདུག་སྟེ།",
    "ཚུལ་བཞིན་རྟོགས་ན་བསྟན་པའི་ཞབས་ཏོག་དང་། འགྲོ་དོན་གཞན་ལས་ཆེ་བ་འདུག་སྙམ་པའི།",
    "འདུག་སྟངས་སྟངས་སྟབས་བཟླས་བརྗོད་དང་།",
    "འདུག་སྟངས་ནི།",
    "ཞེས་ངོར་པའི་ཟིན་བྲིས་འགའ་ཞིག་ཏུ་བྲིས་འདུག་པ་སྔོན་རྗེ་རྡོ་རྗེ་འཆང་དང་།",
    "འཁྱུད་པའི་བདེ་བ་ལམ་དུ་བྱེད་དགོས་ཙ་ན་རང་མདུན་གྱི་ལྷ་དེར་བསྒོམ་དགོས་པར་འགྱུར་ཏེ།",
    "བེ་རོ་ཙ་ན་རཀྵི་ཏས་བྱས།",
    "གཞན་དང་མི་མཐུན་ཚོད་དུ་འདུག་གསུངས།",
    "དེ་ཚོ་སྟོན་བྱེད་ཀྱི་རྒྱུད་ཅིག་དགོས་པ་འདུག་སྙམ་ནས་བརྩམས།",
    "ཁོང་པའང་མདའ་འཕེན་ཞིང་སྤྱོད་པ་མཛད་པ་ཡིན་པ་འདུག་གོ་གསུངས།",
    "མུ་གེ་བྱུང་པ་ཡིན་པ་འདུག་པ་ལ།",
    "ཚུར་ཕེབས་དུས་དེས་རྒྱལ་པོ་ཐོབ་འདུག་གོ།",
    "ད་ལྟ་ཡང་དབུ་དང་སྐུ་ལུས་གཉིས་ཇེ་ཉེ་ཇེ་ཉེར་འགྲོ་ཡི་འདུག་ཅེས་གྲགས་སོ།",
    "དེའང་པཎྜི་ཏ་གཙང་ཧྲིག་པ་ཞིག་ཡིན་པར་འདུག་ལ།",
    "གཞུང་ཕྲན་ཚེགས་མང་པོ་བསླབས་ནས་ཁྱེད་ལ་མ་རྒྱུད་ཀྱི་གདམ་ངག་ཟབ་ལ་མང་བར་སུམ་ཅུ་ཐམ་པ་གདའ་བས་བདག་ལ་གནང་བར་ཞུ་བྱས་པས།",
    "དེ་དུས་ན་མཁས་པ་སྒོ་དྲུག་ནི་གྲོངས་ནས་མི་འདུག་འདུས་པ་སློབ་དགོངས་ནས་སུ་དྲག་དྲིས་པས།",
    "ཁོང་རང་བྱ་སྤྱོད་ལ་ཤིན་ཏུ་མཁས་པ་ཞིག་ཡིན་པར་འདུག་གསུངས།",
    "དེས་བོ་དོང་པ་དགེ་སློང་ནམ་མཁའ་དཔལ་བྱ་བ་གཅིག་ལ་ཞུས་པར་འདུག་དེ་མན་ཙམ་ལས་དེ་ཡན་གསལ་བར་ཟིན་བྲིས་ག་ན་ཡང་མི་འདུག་པས།",
    "རང་རང་བློ་གྲོས་དང་སྦྱར་ཏེ།",
    "གཞན་ཡང་བདེ་ཆེན་རལ་གཅིག་འདི་དོན་ལ་རྙིང་མར་འདུག་ཅིང་འདིའི་ཁ་འཛིན་བྱེད་པའི་ཁྲོ་ཕུ་བས་ནི།",
    "ལྟ་བ་སེམས་ཙམ་དུ་བཀྲལ་ཅིང་ལྷ་ཡང་ཉེར་ལྔ་བྱས་པར་སྣང་བས་འཕགས་ལུགས་དང་ཡེ་ཤེས་ཞབས་ལུགས་གང་ཡང་མིན་པར་འདུག་གོ།",
    "ཤཱཀྱ་བཤེས་གཉེན་དེ་ཀླུ་སྒྲུབ་ཀྱི་མཚན་གྱི་རྣམ་གྲངས་སུ་འདོད་པའི་ནོར་བ་རྒྱ་གར་བ་ལ་ཡང་ས་འདུག་ཅིང་།",
    "གཉིས་མེད་རྣམ་རྒྱལ་གྱི་རྒྱུད་ཀྱི་དུམ་བུར་འདུག་སྟེ།",
    "དེ་ལྟར་དུ་བཀྲལ་པ་དེ་ཡང་རང་བཟོ་མ་ཡིན་གྱི།",
    "སློབ་དཔོན་དེ་ཡང་མཚན་བརྗོད་ཀྱི་འགྲེལ་བྱེད་འཇམ་དཔལ་སེང་ལྡན་གྱི་དཀྱིལ་ཆོག་རྩོམ་པ་པོ་ཡིན་ན་ནི་འཇམ་དབྱངས་ཀྱིས་རྗེས་སུ་བཟུང་ངེས་ཤེས་པ་གཅིག་ཡིན་པར་འདུག་པས།",
    "དཀྱིལ་འཁོར་ཏིང་འཛིན་ཕྱག་རྒྱ་དང་། སྟངས་སྟབས་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "བྱ་སྤྱོད་གཉིས་ངོ་བོ་གཅིག་ཅིང་དེ་གཉིས་ལ་ཟབ་ཁྱད་མི་འདུག་པའི་ཕྱིར་དང་།",
    "གཉིས་ཀ་འཁྱུད་པའི་བདེ་བ་ལམ་དུ་བྱེད་དགོས་ཙ་ན།",
    "བདེ་མཆོག་དུས་འཁོར།",
    "རྒྱུད་འདི་ལ་རྒྱ་འགྲེལ་ནི་མེད་དགྲ་ནག་ལ་མཁས་པ་ཞིག་ཤེས་ན་འཆད་སླ་བ་ནི་འདུག་གོ།",
    "ཁ་ཅིག་ཏུ་བི་རོ་ཙ་ན་རཀྵི་ཏས་མཛད་ཟེར།",
    "ཁོ་རང་ལ་བལྟར་ཕྱིན་ན་གསང་ཞིང་སྦས་པ་ཞིག་འོང་ཐང་པ་ཞིག་འདུག་ཀྱང་།",
    "ཡོན་སག་མསཏན་འབུམ་བྱ་བ་དེ་ཚོ་ལ་མཁས་པ་བྱོན་འདུག་པས་དེའི་རྒྱུན་ཨེ་ཡོད་ཡིན།",
    "མུ་གེ་བྱུང་པ་ཡིན་པར་འདུག་ལ།",
    "ཚུར་ཕེབས་དུས་དེས་རྒྱལ་པོ་ཐོབ་འདུག་གོ།",
    "ད་ལྟ་ཡང་དབུ་དང་ལུས་ཇེ་ཉེར་འགྲོ་ཡི་འདུག་ཟེར་གྲགས་སོ།",
    "མཛད་ངེས་ཤེས་པའི་སྦྱིན་སསྲེག་ཅིག་ཡོད་པར་འདུག་སྟེ་བོད་དུ་མ་འགྱུར་རོ།",
    "དོན་བསྡུས་ཀྱི་འགྲེལ་པ་ལྟ་བུ་བཟང་པོ་ཞིག་འདུག་ཟ་ཧོར་གྱི་སློབ་དཔོན་བི་ཤྭ་མུ་ཁས་བྱས་པའི་འགྲེལ་པ་ལེའུ་བཅུ་བདུན་པ་ལ་ཚན་པ་གཉིས་སུ་བྱས།",
    "ཁྱེད་བས་པ་ཡས་མས་མས་ཕ་ཡམས་ལ་མ་རྒྱུད་ཀྱི་གདམས་ངག་ཟབ་ལ་མང་བར་གདའ་བས་བདག་ལ་གནང་བར་ཞུ་བྱས་པས།",
    "དེ་དུས་མཁས་པ་སྒོ་དྲུག་ནི་གྲོངས་ཚར་ནས་མི་འདུག་པས།",
    "འདི་བྱ་སྤྱོད་ལ་ཤིན་ཏུ་མཁས་པ་ཞིག་ཡིན་པར་འདུག་ཅིང་།",
    "སྒྱུ་ལུས་དང་འོད་གསལ་གསང་འདུས་ནས་ཕར་འབྱོན་པར་གདའ་བས་བསྲེས་པ་རང་ས་བསམམིན་ནམ།",
    "སྐབས་མང་པོར་ནི་མཆན་ཆེན་གྱི་ཡིན་ཚོད་དུ་འདུག་སྟེ་མངོན་ཤེས་ཅན་གཞུང་འདི་དང་འདི་ལ་འདི་ལྟར་འཆད།",
    "རྗེས་ཀྱང་བུ་ཊིཀ་སྟེང་ནས་བསམ་ཚར་གསུམ་གསན་པས་དེའི་འབྲེལ་དང་ཞེན་པར་གདའ།",
    "ཤོག་དྲིལ་གསུམ་དང་མ་མཇལ་ཚོད་དུ་འདུག་སྟེ།",
    "རྡོ་རྗེ་གདན་རྒྱབ་ཀུ་པ་ཙ་ན་ཞེས་བྱ་བ་ཡི་ཚལ།",
    "དེ་ཡང་རང་བཞིན་རྒྱུད་ཀྱི་ཁྱད་པར་དང་།",
    "མཚན་གཞི་ངོས་མ་ཟིན་པར་འདུག་པའི་ཕྱིར།",
    "རྒྱུ་དཔེ་ཡང་གཉིས་ཙམ་འདུག་པ་དང་།",
    "ལ་ལི་ཏ་བཛྲ་གྱིས་མཛད་པའི་རྒྱ་འགྲེལ་ཡང་གཉིས་ཙམ་འདུག་པའི་ཕྱིར།",
    "དེ་ཡང་རང་བཞིན་སྐྱེ་བ་ཀཾམེད་པ་སྤྲོས་པའི་མཐའ་ཐམས་ཅད་དང་བྲལ་བ་ནི་དོན་དམ་འོད་གསལ་གྱི་རྣལ་འབྱོར་ཡིན་ལ།",
    "འོ་ན་ཟུང་འཇུག་དང་སྒྱུ་ལུས་ཀྱི་རྣལ་འབྱོར་གཉིས་ལ་རྡོ་རྗེ་འཆང་དུ་བསྒྱུར་ནུས་པ་ལ་ཁྱད་པར་མི་འདུག་གོ་སྙམ་ན།",
    "ཅི་སྟེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "དེ་བས་རང་རང་གནས་སུ་དེངས།",
    "གནམ་ལོ་ཟླ་བ་ཞག་དུས་སྤར་སྨེ་ཡི།",
    "མཛོད་ཅིག་དུས་ལ་མ་གཡེལ་མཛོད།",
    "བྱིས་པ་འདི་ནི་གཞན་དག་ཀུན་ལས་ཁྱད་དུ་འཕགས་པ་ཞིག་འདུགཅེས་ཡོངས་སུ་གྲགས་པས་མཚན་ལ་ཡང་འཕགས་པ་ཞེས་ཐོགས་པ་ཡིན།",
    "བྱིས་པ་འདི་ཀུན་ལས་ཁྱད་དུ་འཕགས་པ་ཞིག་འདུག་ཅེས་པའི་གཏམ་གྱི་གྲགས་པ་ཆེན་པོ་བྱུང་བས།",
    "རྒྱ་ཆེ་བའི་གཞུང་ལུགས་དུ་མ་ཞིག་མ་བསླབས་པར་ཡང་ཤེས་ཀྱི་འདུག་པ་འདི་ཅི་འདྲ་ཡིན་ནམ།"
  ]
}