    "གཙུག་ལག་ཁང་ན་འདུག་པར་ཤེས་པ་དང་།",
    "ཇི་ལྟར་འདུག་པ་དེ་བཞིན་དུ་ཚེའི་འདུ་བྱེད་འདོར་བར་འགྱུར།",
    "གྲོང་པོ་ཏ་ལ་དང་ཉེ་བ་ཞིག་ན་སྤྱིལ་བུ་ན་འདུག་པ་ལས།",
    "བུ་གཉིས་དེ་ནི་འདུག་པ་ལས་ཕུ་བོ་རྒྱལ་པོར་བཅུག་པ་ལས་རབས་ཆད་དོ།",
    "བོར་ནས་དེ་ཚེ་འདུག་པ་ནི།",
    "མངལ་དང་སྒོ་ང་ན་འདུག་པ་རྣམས་ནི་གཞན་གྱིས་གསོད་པ་ཁོ་ནར་འགྱུར་བ་ཡིན་ནོ།",
    "ཡང་རྒྱུ་འདི་དག་ལས་རྒྱུ་གང་ཞིག་དུས་གང་དུ་འབྲས་བུ་འཛིན་ཏམ་འབྱིན་ཅེ་ན།",
    "བྱས་མ་ཐག་ཏུ་ཡིན་གྱི་དུས་གཞན་གྱི་བར་དུ་གསོན་པོར་འདུག་ནས་ཀྱང་མ་ཡིན་ནོ།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་བྱུང་གཉིས།",
    "འཛམ་བུའི་ཚལ་ན་འདུག་པའི་སོ་སོའི་སྐྱེ་བོ་ཞེས་བྱ་བ་ནི་གང་ཞེ་ན།",
    "མཁས་རྣམས་དྲི་ནི་རྫི་ཕྱོགས་མིན་འགྲོ་སྟེ།",
    "གང་ཡང་ཆགས་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འདུག་པ་དང་།",
    "དེའི་ཚེ་འཇིག་རྟེན་འདི་ཞིག་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འདུག་པ་གང་ཡིན་པ་དེ་ལས་ནི་ངེས་པར་བྱུང་བ་ཞེས་བརྗོད་པར་བྱ་ལ།",
    "ཆགས་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འདུག་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ནི་ཉེ་བར་འོངས་པ་ཡིན་ནོ།",
    "ཉི་ཤུར་ཞིག་ནས་འདུག་གོ།",
    "མུ་གེ་དག་དུས་ཇི་སྲིད་དུ་འདུ་ཞེ་ན།",
    "ནམ་ཞིག་དུས་ཇི་སྲིད་ཅིག་ཏུ་འགྱུར་ཞེ་ན།",
    "དམའ་བར་འདུག་སྨྲས་བཟླས་པ་ཡིས།",
    "བོར་ན་དེ་ཚེ་འདུག་པ་ནི།",
    "བགྲོད་མིན་འགྲོ་བ་འདོད་པ་ཡིས།",
    "བྱེ་ནས་དུས་ཇི་སྲིད་དུ་ཅིག་ཏུ་འདུག་ཅེ་ན།",
    "མ་ཁྲིའུ་འི་འོག་ན་འདུག་པ་བསད་པ་དང་།",
    "ས་ཇི་བཞིན་དུ་རང་རང་དང་།",
    "ལག་མཐིལ་སྤུ་ཉག་གཅིག་འདུག་པ།",
    "དེ་ནི་བསམ་གཏན་སྤེལ་ནས་འོག་མིན་འགྲོ།",
    "དེ་ནི་བསམ་གཏན་སྤེལ་ནས་འོག་མིན་འགྲོ།",
    "དག་དང་རང་ལས་སྐྱེ་བར་འགྱུར་ཏེ།",
    "དེ་ཉིད་མ་མཐོང་རང་དགར་གྱུར་པ་ཡི།",
    "རང་བྱུང་རང་བྱུང་བསྟན་པ་གཅེས་འཛིན་རྣམས།",
    "ཚོགས་ཞིང་རང་ལ་བསྟིམ་པ་རྒྱ་གཞུང་ལྔ་གར་མ་གསུངས་པས་མ་བསྡུས་ཀྱང་ཆོག་ལ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུ་ཕཊ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུ་ཕཊ་སྭཱ་ཧཱ།",
    "བོད་ཀྱི་རྩོམ་རིག་ཀྱང་རང་རྟོགས་སྒོས་དུས་རབས་ཀྱི་རླབས་རྒྱུན་ཁྲོད་ཞུགས་ཤིང་།",
    "སྤྱིའི་ཆ་ནས་བལྟས་ན་ད་དུང་ཐར་ཐོར་སིལ་བུ་ཅན་དང་བཟང་ངན་སྦྲགས་མར་གནས་པའི་ཞན་ཆ་གསལ་བོར་མངོན་འདུག་དེར་བརྟེན།",
    "མི་རིགས་དང་ཡུལ་གྲུ་གཞན་གྱི་འཕེལ་རྒྱས་ཡང་རང་ཉིད་ཀྱི་འབད་བརྩོན་དང་དཀའ་སྤྱད་ལ་རག་ལས་ཡོད་པ་ལས།",
    "དེའི་ཆེད་དུ་ཐོབ་གོ་ས་དང་རྒྱུ་ངོ་ཅན་གྱི་མིའི་ཕོངས་ཤ་ཡང་ལྡག་ཐུབ་པའི་ངོ་ཚ་མེད་པ་དང་རང་གཅེས་བརྩི་འཛིན་གྱི་བློ་དེ་ཡང་མེད་པ།",
    "བསམ་པའི་འཁྱེར་སོ་སོགས་ཀྱི་འཛམ་གླིང་རང་བཞིན་གྱི་ཁ་ཕྱོགས་དང་མཐུན་དགོས་བྱུང་ན་བར་ཐག་ཆེན་པོ་ཡོད་པས།",
    "སྒྲུང་གཏམ་འདིའི་ཟབ་སར་བསྐུངས་འདུག་པའི་སྐྱོ་སེམས་དེ་ཡང་ང་ཡི་འགན་འཁྲིའི་འདུ་ཤེས་ལས་མངོན།",
    "དོན་གྱིས་བདེན་པ་ནི་དངོས་ཡོད་ཀྱི་ཚབ་བྱེད་དུ་གྱུར་འདུག་དེ་བས་མི་རྣམས་ཀྱིས་བདེན་པའི་གལ་ཆེན་རང་བཞིན་ལ་ཤུགས་སྣོན་བྱེད་དུས།",
    "རང་ཉིད་ཀྱི་བསམ་གཞིག་དང་རང་ཉིད་ཀྱི་གསར་མཐོང་།",
    "རང་བྱུང་ལ་ལད་འབྲི་བྱས་པ་ཅི་འདྲའི་བདེན་པ་ལྟར་དུ་འདུག་ཅིང་ཞིབ་ཚགས་ཡིན་ནའང་།",
    "སྙན་ངག་པས་ངེས་གཏན་རང་བཞིན་དང་ངེས་རུང་རང་བཞིན་དང་མཐུན་པའི་བྱུང་རིམ་གསར་གཏོད་བྱས་ནས།",
    "དེའི་ཕྱིར་དོན་གྱིས་དངོས་ཡོད་དགག་སྒྲུབ་རིང་ལུགས་ཀྱི་དགག་སྒྲུབ་ལ་བློ་སྐྱེད་རིང་ལུགས་ཀྱི་བསམ་བློའི་དགོངས་དོན་གྱིས་ཟུར་བརྒྱན་འདུག་བོད་ཀྱི་དངོས་ཡོད་དགག་རྒྱག་རིང་ལུགས་ལ་སྤྱིར་ཆབ་སྲིད་ལམ་ལུགས་སམ་དེང་རབས་ཀྱི་ཆབ་སྲིད་གསར་བརྗེའི་ལས་འགུལ་ལས་བརྩམས་པའི་དངོས་ཡོད་དགག་སྒྲུབ་རིང་ལུགས་གསར་བརྗེའི་དངོས་ཡོད་རིང་ལུགས་དང་།",
    "རྩོམ་མཁན་གྱི་ཡིད་འགྱུ་བཅས་གཞི་གཅིག་ཏུ་འདྲེས་པར་བྱས་ནས་བརྗོད་འདུག་པས་ན།",
    "ཀློག་མཁན་ཚང་མར་མཉམ་འུར་ལངས་པའི་སྔོན་འགྲོའི་ཆ་རྐྱེན་བཟོས་འདུག་དེ་དང་ཆབས་ཅིག་ཏུ་བོད་བཙན་པོའི་བང་སོའི་ཞིང་ཁམས་ཏེ།",
    "དུངས་པ་ངོ་མ་འདིའི་རིགས་ཀྱིས་ལྷུག་རྩོམ་ཧྲིལ་པོར་ཚོན་མདངས་རྣམ་པར་བཀྲ་བའི་ཁ་དོག་ཅིག་བསྣན་འདུག་ཡིན་ནའང་།",
    "རྩོམ་མཁན་གྱི་འགན་ཕལ་ཆེར་གྲུབ་འདུག་ཅེས་བརྗོད་ཀྱང་མི་ཆོག་པ་མེད།",
    "ལྷུག་རྩོམ་གྱི་རི་ཆུའི་སྙན་ལྗོངས་ཀྱི་མཛེས་པ་སྔར་ལས་ཇེ་མཛེས་དང་ཁ་དོག་རྣམ་པར་བཀྲ་བར་བཏང་འདུག་ལྷུག་རྩོམ་དེ་ད་དུང་འདི་ཙམ་གྱིས་མཇུག་རྫོགས་པར་མ་བྱས་པར།",
    "སྨྲེང་བུའི་གནས་རྙིང་རྒྱང་མཇལ་ཀློག་དུས།",
    "བོད་ཀྱི་རྩོམ་པ་པོ་རྣམས་ཀྱིས་ཀྱང་རང་ཉིད་མི་ཞིག་ཡིན་ཚེ་བརྩེ་སེམས་དང་དྲིན་ལན་དྲན་དགོས་པ་དང་།",
    "རྩོམ་པ་པོ་རྣམས་ཀྱང་རང་གཤིས་ཀྱིས་འཚོ་བཞིན་ཕ་མའི་བཀའ་དྲིན་སེམས་སུ་ཉར་ཡོད་དེ།",
    "སྐྲག་དུས་ཀྱི་སྲུང་དམག་ལྟ་བུ་ཡིན་པ།",
    "ལྷུག་རྩོམ་ལ་གཡུ་འབྲུག་བྲིས་རྗེས་སྤྱན་མིག་སྤྲད་པ་ལྟ་བུའི་ནུས་པ་ཐོན་འདུག་པ་དང་།",
    "ཕ་ལོས་རླངས་འཁོར་ས་ཚིགས་སུ་བསྐྱལ་ནས་ཇི་ལྟར་ཐུགས་ཁུར་གནང་ཚུལ་དང་གྱེས་ཁའི་རྣམ་པ་སོགས་བྲིས་འདུག་པ་སྟེ།",
    "ལོའི་བོད་ཀྱི་ལྷུག་རྩོམ་ལ་ཚོན་མདངས་བཀྲ་བའི་ཁ་དོག་གསར་བ་སྣ་ཚོགས་བསྣན་འདུག་ཅེས་པའོ།",
    "ད་སྔའི་གནས་བབ་ཅིག་མཚོན་འདུག་ཟེར་བའི་ལྟ་སྟངས་དེས།",
    "འདིས་བོད་ཀྱི་སྒྲུང་གཏམ་གཞན་དག་ལ་མི་མངའ་བའི་གྲུབ་འབྲས་མངོན་དུ་རི་བ་ཁ་ཤས་བླངས་འདུག་པར་འདོད་ཀྱིན་ཡོད་ལ།",
    "བསྟན་དོན་དེ་ཡོད་པས་སྒྲུང་ཐུང་འདི་གཟུགས་འདས་ཀྱི་མཐོ་ཚད་དུ་ཅུང་ཟད་སླེབས་འདུག་པར་སྙམ་པ་ཡིན།",
    "ཡོངས་ཁྱབ་ཀྱི་སྐྱོ་གར་རང་བཞིན་ཞིག་མངོན་སྣང་བྱས་འདུག་འདི་ནི་ཁོ་བོས་སྒྲུང་ཐུང་འདི་གཟུགས་འདས་ཀྱི་མཐོ་ཚད་དུ་སླེབས་འདུག་སྙམ་པའི་སྒྲུབ་བྱེད་དེ་ཡིན་ཞིང་།",
    "དེའི་དགོངས་པ་དག་བོད་ཀྱི་དེང་རབས་སྒྲུང་གཏམ་གྱིས་ཧ་ལམ་ཟུར་ཙམ་ཡང་མཚོན་ཐུབ་ཀྱིན་མི་འདུག་ལྟ་བ་རྟེན་འབྱུང་དང་སྤྱོད་པ་འཚེ་མེད་ཞི་བའི་དམ་བཅའ་དང་།",
    "འདུག་ཅེས་ལན་ལྡོན་ངེས་ཡིན།",
    "བྱེད་འབྲེལ་དང་ཚིག་ཕྲད་ལ་སོགས་ཀྱིས་མཚོན་པའི་མཚམས་སྦྱོར་གྱི་ཚིག་ཀྱང་མང་བོ་མི་སྣང་བས་ཚོར་མྱོང་ཤུགས་ཆེ་བར་འདུག་ཕྱི་དུམ་ནི་བསམ་ཚོར་གྱི་ཁོངས་སུ་བསྡུས་ཆོག་སྟེ།",
    "གསོན་ཤུགས་རབ་ཏུ་བརྟས་པའི་རིག་ཚན་རྣལ་མ་ཞིག་ཏུ་ཆགས་འདུག་དེ་ཡང་དུས་སྐབས་གསར་བའི་ཚུན་གྱི་བོད་ཀྱི་སྒྲུང་གཏམ་གྱི་ཐད་དུ།",
    "ཕྱོགས་དེ་གཉིས་ཀའི་ཆ་ནས་སྲོལ་རྒྱུན་གྱི་སྲོག་ཆགས་སྒྲུང་གཏམ་དང་གབ་སྒྲུང་ལས་ཐོད་བརྒལ་ཆེས་ཆེར་བྱུང་འདུག་པ་ཚོར་ཐུབ།",
    "སྒྲུང་གཏམ་གྱི་མགོ་ནས་མཇུག་བར་དུ་སིམ་པར་བྱས་ནས་འདུག་སྟེ།",
    "འོན་ཀྱང་རང་ཁྱིམ་གྱི་སྒོ་ཁར་བཏགས་པ་ན།",
    "ཚོར་ཤེས་སྣ་ཚོགས་ཀྱི་འབྲས་བུ་ཅི་ཡང་བསྐྱེད་མི་འདུག་ལ།",
    "མི་སྣའི་མིང་འདོགས་ཀྱི་ཐབས་ཤེས་ལ་ལེགས་གྲུབ་བྱུང་འདུག་པའི་ཆ་འགའ་མཐོང་ལ།",
    "སྒྱུ་རྩལ་གྱི་འགུགས་ཤུགས་དང་མཚོན་ཤུགས་དྲག་པོ་ངང་ངམ་ཤུགས་ཀྱིས་འཛོམས་འདུག་ཁ།",
    "ནང་སེམས་ཀྱི་འགྱུར་བ་དང་རང་གཤིས་ཀྱི་སྒོ་ནས་བཏགས་པ་སྟེ།",
    "རྡོ་ཆག་བཙན་བསྒྲིགས་ཀྱིས་སྦྱར་ན་ལུགས་མཐུན་མིན་པར་བསྟན་འདུག་ཡིན་ནའང་སྟག་འབུམ་རྒྱལ་གྱི་ཁྱིའི་སྒྲུང་གཏམ་མེས་པོ་དང་ཁོས་གསོས་པའི་ཕྲུ་གུ་དག་ཅེས་པར་དེའི་ཐད་དུ་དང་དོད་བྱས་པ་ཤིན་ཏུ་མི་འདང་སྟེ།",
    "མཐོང་སྣེ་སྣ་རྐྱང་ཅན་ལ་ཕྱོགས་པ་དང་རང་སྣང་རང་བཞིན་ཤིན་ཏུ་དྲག་ལ།",
    "ཡར་སྒྱིད་དུ་ཡོད་པའི་ལྷ་ཐར་འབུམ་གྱི་ཆུང་མ་རྟ་མགྲིན་འཚོ་ཡང་ཧ་ལས་པར་གྱུར་ཏེ་ཨ་ཙི།",
    "ཨ་ཙི་ཟེར་བཞིན་ཡར་ལངས་དགོས་བྱུང་།",
    "དེ་ནི་ཁྱིམ་རྒྱུད་འདིར་འགན་མ་ཁུར་བའི་ཉེས་སྐྱོན་ཞིག་ཏུ་བགྲང་བཞིན་འདུག་ལོའི་སྦྲང་ཆར་དེབ་གཉིས་པའི་ཤོག་ངོས་པ་ཚན་པ་འདི་གཉིས་ནི་སོ་སོ་བསྡོམས་པས་ཚེག་ཁྱིམ་བརྒྱ་དང་ལྔ་བཅུར་མི་ལོང་བ་ཙམ་གྱི་རྗོད་པ་ཐུང་ངུ་གཉིས་ཡིན་ལ།",
    "ཧ་ཅང་བག་འཁུམས་ཏེ་ཇ་འཐུང་བའི་འདུན་པ་ཡང་རྩ་བ་ནས་ཤོར་འདུག་ལོའི་སྦྲང་ཆར་དེབ་བཞི་པའི་ཤོག་ངོས་པ་འདིར་ཡང་ཧ་ཅང་ཞེས་པའི་ཡི་གེ་གཉིས་དགོས་མེད་དུ་བསྐྱར་ཟློས་བྱས་ཡོད་པ་དེས།",
    "ཁོའི་སྐད་ཆར་ཉན་ན་ང་ནི་ཁྱིམ་ནང་འདིར་ནུས་པ་ཅི་ཡང་འདོན་མི་ཐུབ་པའི་མི་ལྷག་ཅིག་ཡིན་པའི་ཚིག་ཟུར་འདུག་པས།",
    "མ་གཞི་ཁྱི་རྒན་མ་རུངས་པ་དེ་གཡག་རྒན་དེའི་རྭ་ཅོས་བཏུལ་ཚར་འདུག་སྐྱ་བྷེས་ཧ་ཅང་ལྕི་བའི་དབུགས་རིང་ཞིག་ཕྱུང་སྟེ།",
    "ཁྱི་རྒན་དེ་གཡག་རྒན་གྱི་རྭ་ཅོས་བཏུལ་ཚར་འདུག་པའི་སྐབས་སུ།",
    "གནས་སྐབས་ཀྱི་བརྗོད་བྱ་ལས་རིང་དུ་འགོངས་ཤིང་བརྗོད་དོན་གསལ་བོར་མ་ཟིན་པའི་སྐྱོན་བྱུང་འདུག་གོ།",
    "ཟན་ཆང་ཞིག་བརྫིས་རྫིས་ལ་ཁྱི་གུར་བྱིན་ཅིག་ལྟས་ངན་ཁོར་ལྟོ་འདུན་ཧ་ཅང་ཆེ་བར་འདུག་པས།",
    "ལུས་སྟོད་ལྟག་རྒྱབ་ཏུ་བསྙེས་ཏེ་བསྐྱུར་ཞོག་སེམས་ནས་བཟའ་འདོད་ཡོད་ཀྱང་ལྟོ་བས་མི་འཇུ་བར་འདུག་ཟེར།",
    "མི་སྣ་མང་བོ་ཞིག་ལ་ནང་གནས་གསོན་ཤུགས་ཀྱིས་མི་འདང་བ་དང་རང་ངོས་ཀྱི་བསམ་བློ་སྟོངས་པ།",
    "ཀློག་པ་པོའི་ཡིད་ངོར་གཏིང་ཟབ་པའི་བག་ཆགས་བསྒོ་ཐབས་མི་འདུག་གོ།",
    "གསར་རྩོམ་གྱི་ཐབས་ཤེས་འདི་ནི་ཨ་རིའི་རིགས་འདེད་རྩོམ་པ་པོ་ལེ་མེང་ཏི་ཆན་ཏི་ལེ་ལ་ལད་འབྲི་བྱས་པ་ཞིག་ཏུའང་མཚུངས་པར་འདུག་སྟེ།",
    "གང་ལྟར་མི་སྣ་དེ་གཉིས་ནི་སྒྲུང་གཏམ་གྱི་གཏམ་རྒྱུད་ཇེ་རིང་དུ་གཏོང་ཆེད་གནས་སྐབས་སུ་སློང་སྐྲུན་བྱས་པའི་སྣང་བརྙན་ཞིག་ཡིན་པས་དགོས་གལ་ཆེན་པོ་ཐོན་མི་འདུག་ལ།",
    "དགའ་ཕྱོགས་ཀྱི་ངོས་ནས་དེད་ན་བར་བ་མཁོ་བའི་འགག་རྩ་ཞིག་ལ་གཏན་ནས་ཐུག་མི་འདུག་གོ།",
    "ད་དུང་རང་གཤིས་ཉོག་འཛིང་ཆེ་བའི་མི་སྣ་སོགས་ལ་བརྟེན་ནས།",
    "གལ་ཏེ་དེ་ལས་ལྡོག་སྟེ་སྒྲུང་གཏམ་གྱི་རང་སྣང་རང་བཞིན་དྲག་པོ་ཡིན་ན།",
    "མིག་ཟུང་ལ་གསོན་ཤུགས་ཀྱི་འོད་མདངས་ཡལ་ཏེ་སྐྱ་ལོང་བའི་རྡུལ་ཞིག་འཐིབ་ཀྱིན་རྡེབ་ཙམ་ཡང་མི་བྱེད་པར་ང་ལ་ཅེར་འདུག་པར་བལྟས་ན།",
    "ཁོ་ཚོས་ནམ་ཡང་རང་ཉིད་ཀྱིས་མ་ནུས་པ་དང་འཐུས་ཤོར་བྱུང་བའི་བྱ་བ་ཡོད་ཚད།",
    "རང་ཉིད་གཏམ་རྒྱུད་ཀྱི་བྲན་དུ་གྱུར་འདུག་པ་མ་ཚོར་བར་ཡོད་ལ།",
    "སྡང་སེམས་དང་འཁང་ར་ཆེན་པོའི་རྣམ་འགྱུར་རྩུབ་པོ་ཞིག་འཆང་འདུག་པ་ཤེས་ནུས་ལ།",
    "ཇག་པས་ཉི་མ་གཟའ་ཡིས་བཟུང་བའི་གོ་སྐབས་དང་བསྟུན་ཏེ་འབྲི་གཡག་དེད་པ་དེ་དོན་རྐྱེན་གྱི་མགོ་ཁུངས་སུ་བྱས་ཏེ་ར་མདར་འགྲོ་བ་ནས་མགོ་བརྩམས་འདུག་པས།",
    "ཁོའི་ཉལ་ས་རུ་སྐྲ་གཞུག་དམར་པོ་དེ་དང་རྒྱུན་དུ་སྐྱེད་པར་གཟར་བའི་རྐེད་གྲི་ཕྲ་རིང་དེ་ལས་གཞན་གང་ཡང་མི་འདུག་ཅེས་དང་།",
    "སྐྱེས་པ་ཕོ་ལ་རུས་པ་ཨེ་གདའ།",
    "དངོས་འབྲེལ་ཅི་ཡིན་འདི་ཡིན་མ་ངེས་པར་བསྡད་འདུག་པ་རྣམས་ལ་ཕྱོགས་ཙམ་སྟོན་པའི་སླད་དང་།",
    "ཐར་ལོ་སུ་ཡིན་མ་ངེས་པར་བསྡད་འདུག་པ་རྣམས་ཀྱིས་ཡུན་གྱིས་ཐར་ལོ་སུ་ཡིན་པ་བསམ་གྱིན་རྟོགས་འགྲོ་བས་སོ།",
    "མཐའ་དཔྱོད་མཁན་གྱི་བསམ་བློ་དེར་རང་སྟོབས་དང་རང་འགུལ་གྱི་ཆ་ཞིག་ཀྱང་ངེས་པར་ཡོད་པས།",
    "མི་སེམས་ཀྱི་ཟབ་སར་རྟོག་འཇུག་གནང་བའི་དགེ་མཚན་ཐོན་འདུག་སྙམ།",
    "རྨ་འགྲམ་གྱི་ལྗོན་པ་ཁེར་སྐྱེས་ཞེས་པ་སྒྲུང་གཏམ་གྱི་ཁ་བྱང་དུ་བཏགས་པ་དཔེར་འཚམ་ཞིང་དོན་ལའང་འབྱོར་འདུག་སྙམ།",
    "བརྗེད་དུ་ཕངས་པ་ལྟ་བུ་ཞིག་ཏུ་བཞེངས་འདུག་སྐྱེས་པ་ཕོ་ཡི་སྟོབས་ཤུགས་དེར་ནམ་ཡང་ཡིད་སྨོན་བྱེད་ཅིང་དེ་ཉིད་མཚོན་པར་སྤྲོ་བའི་རྩོམ་པ་པོ་ཁོང་ལ་མཚོན་ན།",
    "དེ་ལས་ས་ས་མལ་དང་རྡོ་རྡོ་མལ་གྱི་གནས་ལུགས་བཙན་པོ་ཞིག་བསྟན་འདུག་ལ།",
    "དུས་ནམ་ཡང་རང་ཉིད་ལེགས་ལམ་དུ་བཀྲི་བའི་ཐབས་ལ་འབད་ཅིང་འབུངས་བཞིན་མཆིས།",
    "དུས་ནམ་ཡང་རང་རྩོམ་གྱི་ཕ་རྒན་དེའི་གོང་དུ་འཕགས་ཅི་ཐུབ་བྱེད་པ་ལས་སོ་ན་གནས་པ་ཅན་ཞིག་གཏན་ནས་བྱར་མི་རུང་ངོ།",
    "འགྲོས་དེ་ཡང་མཐར་གཏུགས་ན་འགྲོ་འདུག་གམ་འགུལ་འཇགས་གཉིས་དང་འབྲེལ་ཆེ་སྟེ།",
    "དེ་ནི་འགྲོ་འདུག་གཉིས་ལས་འདུག་པ་དང་འགུལ་འཇགས་གཉིས་ལས་འཇགས་པའི་ཆ་དེ་ཡིན་ལ།",
    "འདུག་པ་དང་འཇགས་པའི་གནས་སྐབས་དེར།",
    "མ་བསམས་ས་ནས་རྩོམ་པ་པོ་ཁོང་ལའང་རིམ་བཞིན་ཉེ་གཞི་རྩ་ལག་དང་བཅས་པའི་མི་སྣའི་ཐོག་མའི་རྣམ་པ་ཞིག་ཆགས་དང་འཆག་བཞིན་འདུག་པ་སྟེ།",
    "གཉིད་དུ་ཡུར་བའི་ཆུར་ཡང་རང་བཞིན་གྱིས་ཐོན་འདུག་ལ།"
  ]
}