    "ཞེས་གསུངས་པ་ལྟ་བུ་སྟེ།",
    "དེདལ་ཁ་དོག་མི་སྡུག་པར་འགྱུར་བའི་ལས་ཡོད་དེ།",
    "མཆོད་རྟེན་དང་གཙུག་ལག་ཁང་དང་མཆོད་རྟེན་གྱི་ས་གཞི་མི་སྡུག་པར་༢༡༢བྱས་པ་དང་མཆོད་རྟེན་དང་སྐུ་གཟུགས་ཀྱིམར་མ་ཁསད་པ་དང་།",
    "ལས་དེ་ལྟ་བུ་ནི་ཁ་དོག་མི་སྡུག་པར་འགྱུར་བའོ།",
    "དེལ་མཛེས་པར་འགྱུར་བའི་ལས་ཡོད་དེ་དེ་གང་ཞེ་ན།",
    "ཙང་སྦྲ་ཆེ་བ་སྟེ་ལས་དེལྟ་བུ་ནི་མཛེས་པརའགྱུར་བའོ།",
    "དེའི་ཚེ་རིགས་དེ་དག་རིགས་མཐོ་བར་འགྱུར་བའི་ལམ་དུཞུགས་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་ལྟ་བུ་སྟེ།",
    "དནིམ་བྱིན་པར་ལེན་བ་དངམ་བྱིན་པར་ལེན་པར་སྐུལ་བ་དང་མ་བྱིན་པར་ལེན་པའི་ལས་སུ་དགའ་བ་དང་མ་བྱིན་པར་བླངས་པས་དགའ་བ་དང་།",
    "ཡང་དག་པར་ལྟ་བའི་ལེགས་པ་རྗོད་བ་དང་།",
    "ལུས་དང་ངག་དང་ཡིད་ཀྱིས་ཉེས་པ་འབྲིང་དུ་བྱས་པ་དང་།",
    "བྲམ་ཟེ་ཆར་འབེབས་སྦེའུར་སྐྱེས་པར་གྱུར་པ་སྟེ།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་དེའི་རྣམ་པར་སྨིན་པ་ཅིར་འགྱུར་ཞེས་ཞུས་པ་དང་།",
    "ངན་དུ་བརྗོད་པ་དེའི་རྣམ་པར་སྨིན་པས་བྲམ་ཟེ་རྩར་འབེབས་འདི།",
    "དེ་ནས་རྒྱལ་པོ་ཁབ་ཏུ་སྐྱེས་ནས་ཚོ་བ་ཕོས་ཏེ་ཐར་བ་དང་མཐོ་རིས་སུ་སྐྱེ་བར་འགྱུར་རོ་ཞེས་གསུངས་པ་ལྟ་བུ་དང་།",
    "ཞེས་གསུངས་བ་ལྟ་བུ་སྟེ།",
    "སྲོག་གཅོད་པ་དངམ་བྱིན་པར་ལེན་པ་དངའདོད་པས་ལོག་པར་གཡེམ་པ་སྟེ་ལུས་ཀྱིལས་གསུམ་དང་།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་སྟེ།",
    "གཟུགས་ཀྱི་འདུ་ཤེས་རྣམས་ལ་ས་རྣམ་པ་ཐམས་ཅད་དུ་ཡང་དག་པར་འདས་ཏེ།",
    "ཐོགས་པའིའདུ་ཤེས་ཞེས་རྣམས་ཡི་དལ་མི་བྱེད་པས་ནམ་མཁའ་མཐའ་ཡས་སོ་སྙམནས་ནམ་མཁའ་མཐའ་ཡས་སྐྱེ་མཆེད་རྫོགས་པར་བྱས་ཏེ་གནས་པ་དང་།",
    "ཅི་ཡང་མེད་དོ་སྙམ་ནས་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་རྫོགས་བར་བྱས་ཏེ་གནས་པ་དང་།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེདམིན་སྐྱེ་མཆེད་རྫོགས་བར་བྱས་ཏེ་གནས་པ་སྟེ།",
    "དེ་ལ་བྱས་ལ་མ་བསགས་པའི་ལས་ཡོད་དེ་དེ་གངཞེན།",
    "བྱས་ནས་ངོ་ཚ་བར་འཛིན་པ་དང་འགྱོད་པ་དང་སྣོད་པ་དང་འཆགས་བ་དང་མཐོལ་བ་དང་།",
    "ལས་གྲང་ལུས་ཀྱིས་ཡོངས་སུ་རྫོགས་པར་བྱས་པ་དེ།",
    "སེམས་ཀྱིས་ཡོངས་སུ་རྫོགས་པར་བྱས་ཤིང་ཚིག་ཏུ་ཡང་ལས་འདི་བྱའོ་ཞེས་སྨྲསལ་དེམ་བྱས་པ་སྟེ།",
    "ལས་དེ་ལྟ་བུ་ནི་བསགས་ལ་མ་བྱས་པའོ།",
    "དེལ་བྱས་ཀྱང་བྱས་ལ་བསགས་ཀྱང་བས་གས་པའི་ལས་ཡོད་དེ་དེ་གང་ཞེ་ན།",
    "ལས་གང་བྱས་ནས་མི་འཛེམ་པ་དང་མི་ལྡོག་པ་དང་མི་འགྱོད་བ་དང་མི་སྨོད་པ་དང་མི་འཆགས་པ་དང་མིམཐོལ་བ་དང་མི་འདོར་བ་དང་།",
    "མི་སྟོང་བ་དང་ཕྱིན་ཅད་མི་སྡོམ་པར་བྱེད་པ་སྟེ།",
    "དེལ་བྱས་ཀྱངམ་བྱས་ལ་བསགས་ཀྱང་མ་བསགས་པའི་ལས་ཡོད་དདེ་གང་ཞེ་ན།",
    "རྨི་ལམ་ནབྱས་པའམ་བྱེད་དུ་བཅུག་པ་ལྟ་བུ་སྟེ།",
    "དེ་ནི་འདི་ལ་ལ་ལས་སེམས་ནས་འཛོམ་པ་དང་འཆགས་པ་དང་མཐོལ་བ་དང་འདོར་བ་དང་སྤོང་བ་དང་ཕྱིན་ཅད་སྡོམ་པར་བྱེད་པ་སྟེ།",
    "ལས་དེ་བྱས་པས་ངོ་ཚ་བར་འཛིན་ལ་འགྱོད་ཅིང་སྨོད་པ་དང་འཆགས་གངམ་དམི་བྱའོ་ཞེས་སྡོམ་པར་བྱེད་པས།",
    "བདག་ལ་སྨོད་དང་རབ་ཏུ་བཤགས་པ་དང་།",
    "སྡོམ་པར་བྱེད་པས་དེ་དག་སྲབས་འགྱུར་གྱིས།",
    "དེལ་ངེས་པར་སྐྱེ་བརའགྱུར་བའི་ལས་ཡོད་དེ་དེ་གངཞེ་ན།",
    "དེལ་ཡུལ་གཞན་དུ་རྣམ་པར་སྨིན་པར་འགྱུར་བའི་ལས་ཡོད་ད་དགང་ཞེན།",
    "གྲོགས་པོ་རྣམས་ཀྱིས་ངེས་པར་མི་འདོང་དུམི་རུང་ངོ་ཞེས་བསྒོ་ནས།",
    "མས་བདོག་པ་ཐམས་ཅད་བསོགས་ནས་རྐང་པ་ཡ་གཅིག་ནས་བཟུང་སྟེ་མི་འགྲོ་བར་བྱས་པ་ལས།",
    "དེས་མལ་མ་བྱས་པར་༥་ཐམས་ཅད་ཕྱིར་བཏོན་ནས་དེ་ལམ་དུ་འཇུག་པར་བྱས་པ་དང་།",
    "དེའི་མས་སྒོ་ཁར་བསྡད་དེ་རྐང་བ་དང་བུམ་འགྲོ་ཤིག་ཅེས་བྱས་པ།",
    "རྒྱ་མཚོར་འཇུག་པར་ནི་བྱ་ན་འཚོའམ་མི་འཚོར་ཡང་གཏོལ་མེད་ཀྱིས།",
    "རལ་གྲི་འཁོར་ལོ་མགོ་ལ་འཁོར་ཞིང་གཅོད་པ་འདི་ཡིན་ནོཞས་བྱས་པ་དང་།",
    "དགེ་སློང་དག་དེའི་ཚེ་དེའི་དུས་ན་དད་དཔོན་གྱི་བུ་བྱམས་པ་མཆོད་སྦྱིན་ཞེས་བྱབ་དེ་གཞན་ཞིག་ཡིན་པར་སེམས་ན་དེ་ནི་དེ་ལྟར་མི་བལྟ་ང་ཉིད་དེའི་ཚེ་དེའི་དུས་ན་དེད་དཔོན་གྱི་བུ་བྱམས་པ་མཆོད་སྦྱིན་ཞེས་བྱ་བར་གྱུར་ཏོ།",
    "དགེ་སློངདག་བྱེད་ཀྱིས་འདི་ལྟར་ཤེས་པར་བྱ་སྟེ།",
    "དེལ་ཡང་བཅོམ་ལྡན་ཀྱིས་དེ་སྐདཅེས་གསུངས་ཏེ།",
    "ཇི་ལྟར་ན་ཚེ་འདིའདིལ་རྣམ་པར་སྨིན་པ་མཚུངས་ཤིངམཉམ་པ་ཡིན་ཞེ་ན།",
    "རྒྱལ་པོར་འགྱུར་བའི་ལས་ཀྱང་བྱས།",
    "ཚེའདིལ་འབྲས་བུ་རྣམ་པར་སྨིན་པར་འགྱུར་རོཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཇིལྟར་ན་གཅོམ་ལྡནའདས་དྲངཕ་མ་ལ་ཞེ་སྡང་བར་བྱས་པའི་སེམས་ཀྱིས།",
    "འབྲས་བུ་རྣམ་པར་སྨིན་པར་འགྱུར་ཏེ།",
    "ལ་ལ་ལོག་པར་ལྟ་བ་དང་ལྡན་པ་དག་བུ་ལ་འདི་སྐད་ཅེས་ཟེར་ཏེ།",
    "དེ་ལྟ་བས་ན་བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་ཕ་མ་ག་སོད་པ་ནིསཏུ་འབྱུང་པར་མི་བྱ་སྟེ།",
    "དེལྟ་བསན་དེ་དག་སྤང་བར་བྱའོ་ཞེས་གསུངས་སོ།",
    "དེ་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་ཕ་མ་བུལ་བྱམས་པ་ནི་རྐང་དང་རུས་པའི་ཁོང་ནས་བྱམས་སོ་ཞེས་གསུངས་ཏེ།",
    "དེ་ལྟ་བས་ན་ཐམས་མ་གནང་ན་རབ་ཏུ་མི་འབྱུང་ངོ།",
    "སྐྱེས་ནས་རིམ་གྲོར་བྱེད་པར་འགྱུར་རོ།",
    "བདག་ཅག་པ་བསྒྲུབ་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་ཕན་ཚུན་ཕ་མ་དང་བུའི་འདུ་ཤེས་འཇོག་གོ་ཞེས་གསུངས་པ་ལྟ་བུ་སྟེ།",
    "གུས་པར་སྨྲས་པ་དང་བསུ་བ་དང་།",
    "དེའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ།",
    "ལས་དེལྟ་བྱནི་ཡུལ་གཞན་དུ་། རྣམ་པར་སྨིན་པར་འགྱུར་རོ།",
    "ལོངས་སྤྱོད་དེ་དག་ཕྱིས་ཟད་ཅིང་དངས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་བྱིན་པ་ནི་མ་ལེགས་པ་ཞིག་བྱས་སོ་སྙམ་ནས།",
    "འདི་ནི་སྐརམ་སྣུབས་ལས་སྐྱེས་པས་རིགས་ཕུང་བར་བྱེད་པར་འགྱུར་ཏེ།",
    "དེལ་ག་དཟག་ལས་གང་དང་༣ ལྡན་ན་དབུལ་ཞིང་གཏོང་ཕོད་པར་འགྱུར་བའི་ལས་ཡོད་དེ།",
    "དེ་ནམ་མིའི་ནང་དུ་སྐྱེལང་དབུལ་ཞིང་གཏོང་དེ་སྟོན་སྦྱིན་པ་ལ་གོམས་པས་དབུལ་ཡང་གཏོང་ཕོད་པར་འགྱུར་རོ།",
    "འདི་ནི་གང་ཟག་ལས་གང་དང་ལྡན་ན་དབུལ་ཞིང་ག་ཏོང་ཕོད་པར་འགྱུར་བའོ།",
    "ཕྱུག་ཅིང་གཏོང་ཕོད་པར་འགྱུར་བའི་ལས་ཡོད་དེ།",
    "སྟོང་གསུམ་གྱི་སྟོ་འཇིག་རྟེན་གྱི་ཁམས་ཀྱང་མིག་བཙུམས་པ་ཙམ་གྱིས་བསྐོར་བ་ལགས་ན།",
    "བསོད་སྙོམས་མ་གསོལ་བར་སླར་བཏང་བ་ནི་ངོ་མཚར་ཆེའོ་ཞེས་བྱས་པ་དང་།",
    "དེ་ཡང་ལས་དེས་ཆེ་ཕྱིམ་ལ་འཕགས་པར་གྱུར་ཀྱང་སྔ་དྲོ་བསོད་སྙོམས་བསླངས་ན།",
    "ལས་དེ་ཉིད་ཀྱི་རྣམ་པར་སྨིན་པས་ཚེ་ཐུང་བར་འགྱུར་རོ།",
    "ལས་དེ་ཉིད་ཀྱི་རྣམ་པར་སྨིན་པ་ལས་ལོངས་སྤྱོད་འཁྱམ་པར་འགྱུར་རོ།",
    "ལས་དེཉིད་ཀྱི་རྣམ་པར་སྨིན་པས་ལོ་ལེགས་པའི་ཁྱིམན་གནས་པའི་རྟོག་པ་བརྗོད་པ།",
    "པས་ཁ་ན་བ་དང་ལྐོག་མ་ན་བ་དང་ཁ་མནམ་པ་ལ་སོགས་པར་འགྱུར་རོ།",
    "ལས་དེ་ཉིད་ཀྱི་རྣམ་པར་སྨིན་པས།",
    "མི་བདེན་པས་བསླུས་པརའགྱུར་བའོ།",
    "ལས་དེ་ཉིད་ཀྱི་རྣམ་པར་སྨིན་པས།",
    "ལས་དེ་ཉིད་ཀྱི་རྣམ་པར་སྨིན་པས།",
    "ལས་དེ་ཉིད་ཀྱི་རྣམ་པར་སྨིན་པས།",
    "མེད་པར་སྨྲ་བ་དང་ཆད་པར་ལྟ་ཞིང་འཇིག་རྟེན་རྒྱང་བན་པའི་གཙུག་ལག་ལ་སོགས་པ་ལ་དདཔར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་རྣམ་པར་འཇིག་པའི་ཚེ།",
    "སྲོག་གཙོད་པ་སྤངས་པའི་རྣམ་པར་སྨིན་པས་ནི་སའིམཐུ་དང་གཟི་བྱིན་མེད་བར་མི་འགྱུར་རོ།",
    "མ་བྱིན་པར་ལེན་པ་སྤངས་པའི་རྣམ་པར་སྨིན་བས་ནི་སེར་བ་དང་།",
    "འདོད་པ་ལ་ལོག་པར་གཡེམ་པ་སྦངས་པའི་རྣམ་པར་སྨིན་པས་ནི།",
    "ཆར་དྲག་པོ་འབབ་པར་མི་འགྱུར་རོ།",
    "ཕྲ་མ་སྤངས་པའི་རྣམ་པར་སྨིན་པསནི་ངམ་གྲོག་དང་།",
    "ཚིག་ཁྱལ་པ་སྤངས་པའི་རྣམ་པར་སྨིན་བས་ནི་རྩྭཚང་ཚིང་དངནགས་ཐིབས་པོ་དང་།",
    "ལོག་པར་ལྟ་བ་སྤངས་པའིརྣམ་པར་སྨིན་པས་ནི།",
    "དགེ་པ་བཅའི་ལས་ཀྱི་ལམ་བཅུ་པོ་འདི་དག་ཡང་དག་པར་བླངས་པའི་རྒྱུས་ཕྱི་རོལ་གྱི་དངོས་པོ་བཅུ་ཕུན་སུམཚོགས་པར་འགྱུར་རོ།",
    "དོགས་པར་འགྱུར་བ་དང་།",
    "འདོད་པ་ལ་ལོག་པར་གཡེམ་པ་ལ་ཉེས་དམིགས་བཅུར་རིག་པར་བྱ་སྟེ།",
    "དོགས་པར་འགྱུར་བ་དང་།",
    "བྱེད་པ་དང་བཅས་པར་འགྱུར་བའི་ལས་བྱེདཅིང་སོག་པ་དང་།",
    "བརྫུན་དུ་སྒྲབ་ལ་ཉེས་དམིགས་བཅུར་རིག་པར་བྱད།",
    "མི་མ་ཡིན་པ་རྣམས་ཀྱིས་དེ་ལ་གླགས་རྙེད་པར་འགྱུར་བ་དང་།",
    "བདེན་པ་སྨྲས་ཀྱང་དེ་ལ་སུ་ཡང་ཡིད་ཆེས་པར་མི་འགྱུརབ་དང་།",
    "ཡིད་ཆེས་པར་བྱ་བའི་གནས་རྣམས་སུ་མཁས་པ་རྣམས་དེ་ལ་དྲི་བར་བྱ་བར་མི་སེམས་པ་དང་།"
  ]
}