    "འཆར་བས་མ་བརྟགས་པར་འདུག་སྟེ་ཤི་བ་ལས་བཅས།",
    "ཚིག་པ་ཟོས་ནས་ཁྲི་བཅག་སྙམ་སྟེ་ལྗིད་ཀྱིས་མནན་ཅིང་དྲག་ཏུ་འདུག་པ་དང་ནང་དུ་ལྟེམས་ཞེས་བྱིང་ནས་ཕྱེ་དང་ཞོ་ཡང་ཐོང་ཀར་བོའོ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བསླབ་པར་བྱ།",
    "ཁྱིམ་པ་འདུག་པར་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱེམ་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ།",
    "བཞོན་པའི་སྟེང་དུ་འདུག་པ་དང་།",
    "ང་འདུག་པའི་ཚེ་བྱ་བ་དང་མི་བྱ་བར་བསྟན་པ་རྣམས་དེ་དེ་བཞིན་དུ་བྱས་ན་ང་འདུག་པ་དང་འདྲའོ་ཞེས་གསུངས་སོ།",
    "མ་ཐོབ་པ་དང་ལམ་གྱིས་དུབ་པ་དག་སེམས་རྩེ་གཅིག་ཏུ་འདུག་པར་མི་ནུས་ནས་གྲལ་ན་གཅོག་པ་ལྟ་བ་ཉུ་༡དང་།",
    "འཁོར་དེར་ཚེ་དང་ལྡན་པ་བཟང་སྦྱིན་ཡང་འདུས་པར་གྱུར་ཏེ་འདུག་གོ།",
    "གནས་ཁང་དུ་འོངས་ནས་ནང་དུ་ཡང་དག་འཇོག་པའི་ཕྱིར་འདུག་གོ།",
    "དེད་དཔོན་དགའ་བོའི་བུ་དེ་ཤིན་ཏུ་བྱད་བཟང་ཞིང་མཛེས་པ་ཞིག་འདུག་པ་ཡུལ་གཞན་ཞིག་ཏུ་ཚོང་ལ་འགྲོ་བར་ཆས་ཏེ།",
    "ཡོངས་སུ་མྱ་ངན་ལས་མ་འདས་པ་ཡོངས་སུ་མྱ་ངན་ལས་འདའོ་ཞེས་བྱས་ནས་དགེ་སློང་ཅིག་ལུས་མི་གཙང་བས་སྐྱོ་སྟེ་བསྒོམ་ཞིང་འདུག་པ་ལངས་ནས་ཁང་བུ་ནས་བྱུང་སྟེ་དགེ་སློང་སྲུང་བ་ལ་བཞིན་བཟངས་བདག་མ་བསྒྲལ་གྱིས་སྒོལ།",
    "སྟན་ལ་མ་བརྟགས་པར་འདུག་པས།",
    "དེས་བསམས་པ་ཅུང་ཞིག་མ་གྱོབསྡིགས་ན་ཡོ་བྱད་རྣམས་འཕྲོག་ཏུ་འོང་སྙམ་ནས་སྒོའི་སྟེང་དུ་འཛེགས་ཏེ་གཎྜི་ཞིག་ཚོད་ཙམ་དུ་འཕངས་པ་དང་ནང་པར་བལྟས་ནས་གཡོན་ཅན་ཞིག་མགོར་ཕོག་སྟེ་ཤི་ཞིང་འདུག་གོ།",
    "སྟན་ཁྲ་བོ་ལ་དགྲ་བཅོམ་པ་རྣམས་འདུག་སྟེ།",
    "ང་ཡང་འདུག་གོ་ཞེས་ཟེར་ན་ཕས་ཕམ་པར་འགྱུར་རོ།",
    "འདུག་པ་དང་།",
    "དེ་དག་ལ་མི་མགུ་ནས་རབ་ཏུ་སེམས་ཤིང་འདུག་པ་དང་།",
    "གྱོ་ཏ་མ་འདུག་བཞིན་དུ་འཁོར་ཉན་ཐོས་རྣམས་འཁྲུག་པར་བྱའོ།",
    "འཛུམ་སྙེགས་ལུས་ཀྱིས་སྙོགས་ཤིང་སྟན་གཅིག་ལ་འདུག་པའོ།",
    "གང་ཟག་དེའི་ཆད་པ་ནི་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་།",
    "སྟན་གཅིག་ལ་མི་འདུག་ལྷན་ཅིག་མི་འཆག་ཁྱིམ་གཅིག་ན་མི་ཉལ།",
    "ཕྱི་རོལ་ནས་བསྒོ་འམ་ས་ལ་འདུག་སྟེ་ནམ་མཁའ་ལ་འཇུག་པའམསྤྱོ།",
    "དེ་སྟན་བཏིང་བ་ལ་འདུག་པ་དང་།",
    "དགེ་སློང་མཚམས་ཀྱི་ནང་ན་འདུག་གམ།",
    "མི་དག་འདུག་པ་ནི་སྤང་བར་མི་འགྱུར་རོ།",
    "གྲོང་རྩིག་པས་བསྐོར་བའི་འདུག་གནས་ན་ཀུན་དང་ཕྱི་རོལ་འདོམ་གང་ཚུན་ཆད་དམ།",
    "འོབས་ཀྱིས་བསྐོར་བ་ནི་དེ་ཉིད་འདུག་གནས་ཏེ།་",
    "གྲོང་གཅིག་པའི་འདུག་གནས་གཅིག་སྤྱོགང་ཞེ་ན།",
    "སྲུན་མང་པོའི་ཁྱེམ་སྒོ་གཅིག་པ་ཞིག་ན་སྒོ་ཉིད་འདུག་གནས་ཡིན་ཏེ་གྲོང་དུ་གནས་སམ་འདུག་ན་སྤང་བར་མི་འགྱུར་རོ།",
    "བདག་ལ་བསྐོན་ཅིག་ཅེས་བྱ་བ་ནི་གཉི་གས་བདག་དུས་སུ་བྱིན་ཅིག་པའི་དོན་ཏོ།",
    "དགེ་སློང་དེས་ཕོ་ཉ་དེ་ལ་ཚེ་དང་ལྡན་པ་ཕོ་ཉ་དགེ་སློང་རྣམས་ནི་གོས་ཀྱི་རིན་ལེན་དུ་མི་རུང་སྟེ་བདག་ཅག་དུས་སུ་གོས་ཤིག་རྙེད་ན་ནི་ལེན་ཏོ་ཞེས་བྱ་བ་དེ་སྐད་སྨྲོས་ཤིག།",
    "བྱིན་ན་ནི་ལེགས་མ་བྱིན་ན་ལན་ལྔ་དྲུག་ཏུ་སྣང་བའི་ཕྱོགས་སུ་འདུག་ཤིག།",
    "སྭོཉལ་ཞིང་འདུག་པ་གཞན་གྱིས་མཐོང་ནས་ཁྱེད་གཉིས་ཅིའི་ཕྱིར་ཉལ་ཞེས་སྨྲས་ན།",
    "ཕྱག་བྱས་ནས་བསྐོར་ཌཞིང་དད་དད་ལྟར་བྱས་ཏེ་དགེ་སློང་གཞན་ནི་མེད་རྒན་ཞུགས་ཤིག་དེ་ན་འདུག་པ་དེ་ལ་འདི་གཙུག་ལག་ཁང་འབྱོར་པའམ་བྱེལ་བའི་གནས་ཞེས་དྲིས་ན་དགེ་སློང་དེས་ཙོ་མ་གོ་ནས་གཙུག་ལག་ཁང་ནི་འབྱོར་པའོ་ཞེས་སྨྲས་ནས་རྒན་ཞུགས་དེས་འདི་ན་བྱེལ་བ་མ་ཡིན་གྱི་ཧུརྟེཡོ་བྱད་དང་ལྡན་ཞིང་འབྱོར་པའི་གནས་ཡིན་ཏེ།",
    "དེ་ཡང་ཕྱི་རོལ་གྱི་གཞུང་གཞན་ལ་རབ་ཏུ་མཁས་ཤིང་གཞན་དང་རབ་ཏུ་འགྱེད་པ་ལ་བརྩོན་པ་ཞིག་འདུག་གོ།",
    "འདུག་པ་དང་།",
    "འཆར་བ་ནི་ལམ་དུ་ཁྱེམ་པ་དག་དང་གཏམ་བྱེད་ཅིང་འདུག་པ་དང་།",
    "ཁྱེད་མ་འདོང་བར་འདུག་ཤིག་དང་།",
    "དེ་ནས་བསྙེན་དགའ་བོ་ཡང་ལམ་ན་མི་འཕྲད་དོ་ཅོག་དང་གཏམ་ཟླ་ཡོད་ཀྱི་བར་དུ་འཁྱལ་ཞིང་འདུག་གོ།",
    "དེ་ཡང་རྒན་ཞུགས་ལ་གནོད་པར་བསམས་ནས་ཡང་ཐོག་ནས་རྒན་ཞུགས་ལ་བོས་པ་དང་དེ་གང་ན་ཟེར་བའི་ཐད་ཀར་ཁྲིའི་རྩ་བ་གཟེར་བུ་མེད་པ་འབྱུང་སླ་བའི་སྟེང་དུ་ལྕིད་ཀྱིས་དྲག་ཏུ་ཕབ་སྟེ་འདུག་པས་ཁྲིའི་རྩ་བ་ལྟུང་ནས་རྒན་པོའི་འཕྲལ་པ་ལ་ཕོག་སྟེ།",
    "ཁྲི་བཀན་ཏེ་འདུག་པ་ལ་ལྕིད་ཀྱིས་ཕབ་ཀྱང་ཉེས་པ་མེད་དོ།",
    "ཆུང་མ་རྙིང་པ་སྦེད་མའི་ཁྱིམ་དུ་ཕྱིན་ཏེ་དེར་སྟན་བཏིང་བ་ལ་འདུག་ནས་སྔོན་ཇི་ལྟར་བསྙེན་པ་དང་།",
    "སྦེད་མ་འབའ་ཞིག་ལྷ་ཁང་ནས་ཕྱག་ཅིང་འདུག་པའི་གན་དུ་ཚེ་དང་ལྡན་པ་འཆར་བ་འོངས་ནས་ཁོང་གཉིས་སྔོན་ཇི་ལྟར་རྩེ་ཞིང་དགའ་བ་དང་།",
    "དགེ་སློང་རྒན་ཞུགས་དེ་གྲལ་གྱི་ཐ་མ་ན་འདུག་པའི་གམ་དུ་ཁུར་བ་ནུ།",
    "བདག་ནི་ལས་ཆེས་ཏེ་དྲོཉམ་ཆུང་ཞིང་རྔོ་ཉལ་ཞིང་འདུག་གོ།",
    "སྤྱོད་ལམ་ལས་ཉམས་པ་ནི་གང་ལ་སྟན་འདུག་པ་དེ་ལས་ལངས་པ་སྟེ།",
    "ལས་དུས་ནི་དགེ་སློང་དག་ཅིག་ཕྱག་དར་དང་དཀྱིལ་འཁོར་དག་བྱས་པས་ཆད་དེ་ཉལ་ཞིང་འདུག་པ་སྙན་དུ་བདས་ནས་རྗེས་སུ་གནང་སྟེ།",
    "བདག་ཅག་དུས་སུ་ནི་ཟན་མ་རྙེད་དེ།",
    "ཚེདགེ་སློང་སྟེ་ངན་བྱེད་པའི་གནས་སུ་འདུག་ཏུ་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "འཕགས་པ་འཆར་བ་ནི་དེ་ཙམ་རྣམ་པར་གྲོལ་བའི་བསམ་གཏན་བྱེད་ཅིང་འདུག་གོཞུ།",
    "སྤྱད་ཟིན་ནས་བལྟས་ན་འཆར་བ་འདུག་པར་མཐོང་ནས།",
    "སྟེ་ངན་བྱེད་པའི་གནས་སུ་འགྲེང་ཞིང་འདུག་ཏུ་མི་གནང་བའི་བསླབ་པ་བཅས་སོ།",
    "གཙུག་ལག་ཁང་ལམ་ཀ་ན་འདུག་པའི་ལམ་ཀ་ནས་འདོང་བ་དང་།",
    "རི་བྲགས་ཀྱི་གྲོང་དེ་ཉིད་ཀྱང་ད་རུང་མ་ཕེབས་ནས་རྒྱལ་པོ་ཡང་ཕྲུ་མ་དེ་ཉིད་དུ་འདུག་གོ།",
    "རྒྱལ་པོ་དང་བློན་པོས་འདུག་ཤིག་ཅེས་བསྒོ་བའམ།་",
    "དགའ་བོ་གོས་ངན་པ་ཞིག་གྱོན་བཞིན་དུ་འདུག་པ་གནས་བརྟན་གོས་ངན་པ་འདི་ངས་བཀྲུའོ་ཞེས་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྣམ་ཕྱི་ས་ན་འདུག་པ་དང་།",
    "འདུག་ན་ཡང་ངོ།",
    "དགེ་སྤྱོང་སྤངས་པ་དང་ལྷན་ཅིག་བསྟེན་ཅིང་འདུག་ཏུ་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "དེ་གཉིས་ཀྱི་ཁང་པ་བརྩིགས་ཤིག་དུས་དུས་སུ་འོང་ངོ་ཞེས་དུས་བྱས་སོ།",
    "ཛེ་ཏའི་ཚལ་དུ་བསྒུགས་ན་བསྙེན་དགའ་བོའི་གདོང་ལས་ཚོན་ཞིག་འདུག་པ་མཐོང་སྟེ།",
    "གཙུག་ལག་ཁང་དང་ཀུན་དགའི་མཚམས་ཀྱི་ནང་ན་འདུག་པའོ།",
    "མཉན་དུ་ཡོན་པ་ན་འཕོང་ཞྭརྩལ་སློབ་པ་དག་ཅིག་འདུག་པར་མཐོང་སྟེ།",
    "ཚེ་དང་ལྡན་པ་ཨུ་པཱ་ལི་ནི་སྐམ་ལ་འདུག་གོ།",
    "འཕགས་པ་དེ་ཡང་སྒོ་གཅོད་ཅིང་ནང་ན་འདུག་པ་དང་།",
    "ལམ་གྱི་བར་དུ་གང་ན་རྫིང་བུ་ཞིག་ཆུས་གང་ཞིང་འདུག་པའི་གན་དུ་ཕྱིན་པ་དང་།",
    "ཅང་མི་སྨྲ་བར་བཞབས་ཏེ་ཉན་ཅིང་འདུག་ཅེས་བྱ་བ་ནི་ཅང་མི་ཟེར་བར་འཇབ་པའོ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་སྒོ་ཞེས་བྱ་བ་ནི་ཁྱིམ་དེ་ན་ཁྱིམ་པ་གང་འཁོད་པའོ།",
    "རྒྱལ་པོ་གསལ་རྒྱལ་ཀྱང་དེར་འདུས་ཏེ་འདུག་གོ།",
    "ཚེ་དང་ལྡན་པ་སྔོན་འདི་ན་འདུག་ཅེས་བྱ་བ་ནི་དེ་དག་གང་ཡིན་པའོ།",
    "དགེ་སློང་ཁ་ཅིག་ནི་འོག་ཁང་ན་ཟན་ཟ་ཁ་ཅིག་ནི་སྒོ་ཁད་ན་ཟ་ཞིང་འཁོད་པ་ལས་དེ་ན་དགེ་སློང་མ་ཞིག་བསྒོ་ཞིང་འདུག་ན།",
    "གྲོང་དུ་ཇི་ལྟར་འཇུག་ཅིང་ཁྱེམ་དུ་འདུག་པར་བྱ་བ་དང་།",
    "མ་བསྒོ་བར་ཁྱེམ་པའི་སྟན་ལ་མི་འདུག་ཅེས་སྤྱོབྱ་བ་ནི་མཉན་དུ་ཡོད་པ་ན་བྲམ་ཟེ་ཞིག་གཙང་སྦྲ་ལ་དགའ་སྟེ།",
    "བསྙེན་དགའ་བོས་རྐང་པ་དེའི་མལ་གྱི་སྟེང་དུ་བཞག་སྟེ་འདུག་གོ།",
    "ཅིའི་ཕྱིར་ལྷག་མ་སྟིདང་བཅས་པར་ངའི་མལ་ན་འདུག་ཅེས་འཕྱ་ཞིང་སྨོད་པ་ལས་སྙན་དུ་བདས་ཏེ་འཕྱ་བ་ནི་རིགས་པར་འཕྱས་པསལྡུ་།",
    "ད་ཕྱིན་ཆད་ཁྱེམ་པས་མ་བསྒོ་བར་སྟན་ལ་མི་འདུག་པར་བྱའོ་ཞེས་བསླབ་པ་བཅས་སོ།",
    "དེའི་ཚེ་རིང་བར་འདུག་པྱཔའི་ཕྱིར་རས་དཀར་པོས་གཡོགས་ཏེ།",
    "སྟན་ལ་མ་བརྟགས་པར་འདུག་པས་བུ་དེ་དུས་ལས་འདས་སོ།",
    "ཁྱིམ་པའི་སྟན་ལ་མ་བརྟགས་པར་འདུག་ཏུ་མི་གནང་བར་བཅས་སོ།",
    "ཁྲིའུ་དེ་ཆག་གོ་སྙམ་དུ་བསམས་ཏེ་སྟེང་དུ་ལྗིད་ཀྱིས་ཕབ་སྟེ་དྲག་ཏུ་འདུག་པ་དང་།",
    "ཁྱིམ་པའི་ཁྱིམ་དུ་སྟན་ལ་ལྗིད་ཀྱིས་ཕབ་སྟེ་མི་འདུག་པར་བྱའོ་ཞེས་བཅས་སོ།",
    "རྐང་པ་མི་བསྣོལ་བར་འདུག་པར་བྱ་ཞེས་བྱ་བ་ནི།་",
    "གྲོང་དུ་བརླ་བསྣོལ་ཏེ་མི་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅས་སོ།",
    "རྐང་པ་གདངས་ཤིང་བྱེའདུག་པར་མི་བྱའོ་ཞེས་བཅས་སོ།་",
    "དེ་དག་ཅང་མི་སྨྲ་བར་བླའདུག་གོ།",
    "དེ་ལྟར་བྱས་པ་སྙན་དུ་བདས་ཏེ་དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བྱའོ་ཞེས་བསླབ་པ་བཅས་སོ།",
    "མ་དྲིས་ཞེས་བྱ་བ་ནི་ཁྱིམ་པ་འདུག་པས་འདིར་ཕོ་ཤིག་ཅེས་ཟེར་བ་ལ་ཉེས་མེད་དོ།",
    "མི་ན་བར་སྟན་མཐོན་པོ་ལ་འདུག་པ་ལ།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "དེ་ཀོས་བཙུགས་བཅས་ཏེ་རབ་ཏུ་སེམས་ཤིང་འདུག་པ་དང་།",
    "མདུན་ནས་རྒྱབ་ཏུ་འདུག་ལ།",
    "དེ་ནས་མདུན་དུ་འདུག་པ་ལ་བསྔགས་པ་དང་།",
    "རྗོ་པེ་སྐོའར་རིབཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "ཡང་སྲ་བརྐྱང་གོས་ཀྱི་གཏེར་ལྟ་བུར་འདུག་པས་དེ་ལ་བརྟེན་ནས་ཀོ་ལྤགས་ཀྱི་གཞིའོ།་།",
    "འདུག་པ་དང་།",
    "དགེ་སློང་ལ་དབུལ་ན་ནི་དེས་དགེ་སློང་དྲུང་ན་འདུག་པའི་མདུན་དུ་འདུག་སྟེ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདིའི་ལས་ནི་འདུག་པ་ཉིད་ཀྱིས་བྱའོ་ཞེས་གསུངས་པ་དམིགས་ཀྱིས་བསལ་བ་ཡིན་ནོ།",
    "དེའི་འོག་ཏུ་ཕྱོགས་མཚམས་མཐོན་པོར་འདུག་སྟེ་ཕྱོགས་བཞིར་བལྟ་བར་བྱའོ།",
    "གང་ན་དགེ་སློང་གཉིས་འཁོད་པ་དེར་ནི་རིམ་པ་བཞིན་དུ་བྱ་ཞིང་དུས་ཀྱི་བར་དུ་བསྡད་དེ་མ་གྲུབ་ན་ནི་མདུན་དུ་ཙོག་ཙོག་པོར་འདུག་སྟེ།",
