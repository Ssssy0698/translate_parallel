    "བྱང་གི་ངོས་སེང་གེའི་ཁ་ནས་ཆུ་བོ་སི་ཏ་ཁྱེ་བྱུང་ནས་བྱང་ཕྱོགས་ཀྱི་རྒྱ་མཚོར་འབབ་སྟེ།",
    "གང་གཱའི་ཀླུང་གི་ནང་ནས།",
    "བྲམ་ཟེ་ཐེ་ཚོམ་སྐྱེས་ནས་སུ་ཞིག་ཡིད་ཆེས་པར་འགྱུར་རོ་ཞེས་བྲམ་ཟེ་དེ་ཤིང་དྲུང་ཞིག་ཏུ་སོང་ནས་ཤིང་གི་ལོ་མ་ཉུང་ཤས་ཅིག་བླངས་ཏེ་སླར་འོངས་ནས།",
    "གང་གཱའི་ཀླུང་གི་བྱེ་མ་ཞེས་བྱ་བ་ནི་མཚོ་རབ་ཏུ་བསིལ་བ་ནས་འབྱུང་སྟེ།",
    "ནང་གི་སྒྱུར་བ་གང་ཡིན་པ་དེ་ནི་འབྲས་བུ་ཡུན་མི་ཐུང་བས།",
    "གཉིས་པ་མོས་པས་ནི་འདི་ལྟ་སྟེ།",
    "མོས་པ་ནི་འཕགས་པ་གཞན་དག་ཀྱང་གཏོགས་སོ།",
    "ཐག་རིང་བོ་ཐག་ཉེ་བར་བསྒྱུར་ཞིང་མ་སོང་བར་ཕྱིན་པར་འགྱུར་བ་དང་།",
    "སྐད་ཅིག་མ་གཅིག་གིས་ཕྱིན་པར་འགྱུར་བའོ།",
    "ཕྱོགས་བཅུའི་གང་གཱའི་རྔུ་ཀླུང་གི་བྱེ་མ་སྙེད་ལ་སོགས་པའི་འཇིག་རྟེན་ཀྱི་ཁམས་སུ་དུས་ཡུན་ཐུང་ངུས་གནས་མང་པོར་༡རྟེཕྱིན་པར་འགྱུར་བ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "བདག་གི་ཞིང་དེའི་ས་ཕྱོགས་ཞིག་ན་མུ་སྟེགས་ཅན་རང་རང་གི་སྟོན་པ་ལ་སོགས་པ་བདུན་ཁྲི་བདུན་སྟོང་གཅིག་ཏུ་འདུས་ནས་ཞེས་བྱ་བ་ནི་གཉིས་པ་གཅིག་ཏུ་འདུས་པར་མཐོང་བ་བསྟན་པ་སྟེ།",
    "གཞན་དུ་ན་༡རྣམ་པ་སྣ་ཚོགས་ཀྱི་མོས་པ་ཅན་དང་།",
    "ཐ་དད་པའི་མོས་པ་ཅན་དང་།",
    "རྣམ་པར་འགྱུར་བའི་མོས་པ་ཅན་དུ་གྱུར་པས།",
    "གཅིག་ལ་གཅིག་རྒྱབ་ཀྱིས་ཕྱོགས་ཤིང་རྩོད་པའི་སྨྲ་བ་བསྐྱེད་ནས་ཁའི་མདུང་ཐུང་གིས་ཕན་ཚུན་འདེབས་པར་བགྱིད།",
    "རྩོད་པའི་སྨྲ་བ་མན་ཆད་ཀྱིས་ངག་གི་ལས་མི་མཐུན་པར་གྱུར་པར་བསྟན་པ་དང་།",
    "ཡིད་འདི་ལྟར་མུ་སྟེགས་ཅན་རྣམས་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་ཡོངས་སུ་བཙལ་ཀྱང་དེ་ཁོ་ན་ཉིད་ཀྱི་དོན་དམ་པ་ཁོང་དུ་མ་ཆུད་པས་གཞན་དུ་ན་ནོར་བས་མོས་པ་ནི་གསུམ་དུ་འཛིན་པར་གྱུར་ཏེ།",
    "ཐ་དད་པའི་མོས་པ་ཅན་ཧཱུཾརྣམ་པར་འགྱུར་བའི་མོས་པ་ཅན་དུ་གྱུར་པའོ།",
    "རྣམ་པར་འགྱུར་བའི་མོས་པ་ཅན་དུ་གྱུར་ཅེས་ཉུསྐེབྱ་བ་ནི་ཡང་དག་པའི་ཚུལ་དུ་ན་དོན་དམ་པ་ནི་རྣམ་པར་གྱུར་པ་མེད་པ་ཡིན་ན།",
    "རྣམ་པར་འགྱུར་ཞིང་རྟག་པར་གནས་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་བའི་ཕྱིར་རྣམ་པར་འགྱུར་བའི་མོས་པ་ཅན་དུ་གྱུར་པ་ཞེས་བྱའོ་ཞེའོ།",
    "ཁ་ཅིག་ན་རེ་ཚིག་དང་པོ་ནི་སྤྱིའོ།",
    "ཁ་ཅིག་ན་རེ་རྣམ་པ་གསུམ་ཆར་ཡང་དོན་ལ་བྱེ་བྲག་ཏུ་གྱུར་པ་མེད་དེ།",
    "མངོན་སུམ་དུ་བགྱི་བ་མཆིས་པ་ནི་ངོ་མཚར་རྨད་དུ་བྱུང་བ་ལགས་སོ་སྙམ་བཀྱིད་པ་ཤེ་ལགས་སོ་ཞེས་བྱ་བ་ནི་གསུམ་པ་རང་གི་སེམས་ཀྱི་བསམ་པ་ཡང་དག་པར་བསྟན་ཏེ།",
    "ཁྱོད་ཀྱིས་ཇི་སྐད་སྨྲས་པ་དེ་བཞིན་ནོ།",
    "དོན་གང་གི་ཕྱིར་རྟོག་དཔྱོད་ཀྱི་སྤྱོད་ཡུལ་ལས་ཤིན་ཏུ་འདས་པར་གྱུར་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཁ་ཅིག་ན་རེ་རྩ་བ་དང་།",
    "རྗེས་ལས་ཐོབ་པ་ཐམས་ཅད་ཀྱིས་ནང་གི་རིག་པའི་དེ་བཞིན་ཉིད་ཐོབ་པས།",
    "ཁ་ཅིག་ན་རེ་ཡང་དག་པའི་ཡེ་ཤེས་ནི་རང་གི་ངོ་བོ་ཉིད་མངོན་སུམ་དུ་རྟོགས་པས་མ་བསྒྱུར་བར་ཡང་དམིགས་པར་བྱེད་དེ།",
    "ནང་གི་སོ་སོ་རང་གིས་རིག་པར་བྱ་བ་མ་ཡིན་པར་གསུངས་པའི་ཕྱིར་ཕན་ཚུན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "སློབ་དཔོན་ཧྲན་ཙང་གིས་ནི་རྟོག་དཔྱོད་ཅེས་པར་བསྒྱུར་ཏེ།",
    "དེ་ལ་བྱེ་བྲག་ཡོད་པ་ཡང་བསྟན་བཅོས་དེ་ཁོ་ན་ཉིད་གྲུབ་པའི་གཞུང་གིས་ནི་སེམས་ཀྱི་ངོ་བོ་ཉིད་བྱེད་དོ་ཞེས་སྟོན་ལ་ཇེག་པ་ཆེན་པོའི་གཞུང་གིས་ནི་སེམས་པ་དང་།",
    "འདི་གཉིས་ཀ་ཡང་ལུས་དང་སེམས་རེག་པར་གནས་པ་དང་།",
    "རེག་པར་མི་གནས་པའི་རྟེན་བྱེད་པའི་ལས་ཅན་ཏེ།",
    "སེམས་པ་དང་ཤེས་རབ་ཀྱི་ཕྱོགས་གཅིག་གི་ངོ་བོ་ཉིད་དོ།",
    "ས་གསུམ་ཐ་དད་པར་གྱུར་པ་ཡང་སློབ་དཔོན་ཙེན་ཙང་གིས་འདི་སྐད་དུ་བསྟན་བཅོས་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ནི་རང་གི་ངོ་བོ་ཉིད་ཀྱི་༤འདོད་ཆགས་དང་བྲལ་བ་ལ་དགོངས་ནས་ས་གསུམ་རྣམ་པར་གཞག་པ་ཡིན་ཏེ།",
    "ཁམས་བཅོ་བརྒྱད་པའི་མཚན་ཉིད་ཡུལ་དྲུག་གི་སྤྱོད་པ་དང་།",
    "རྣམ་པར་ཤེས་པ་དྲུག་གི་སྐྱེ་མཆེད་དང་།",
    "ཁ་ཅིག་ན་རེ་རྣམ་པར་མི་རྟོག་པའི་ཡུལ་ལ་དམིགས་པས་མཚན་མ་མེད་པ་ཞེས་བྱ་སྟེ་གཟུང་བ་དང་འཛིན་ང་།",
    "ཁ་ཅིག་ན་རེ་མཚན་མ་མེད་པ་ནི་དེ་བཞིན་ཉིད་ཀྱི་མྱ་ངན་ལས་འདས་པ་སྟེ།",
    "ཡུལ་ལྔ་དང་སྐྱེས་པ་དང་བུད་མེད་དང་།",
    "དེ་ལ་དགག་པ་ནི་གཞན་དག་གི་སྐྱེ་བ་དང་འགག་༥པ་ལ་སོགས་པར་འཛིན་པར་དགག་པ་སྟེ་༦།",
    "སྔར་གོང་དུ་བསྟན་པའི་ཚིག་འབྲུ་དག་གིས་ཅི་རིགས་པར་ཀུན་དུ་བརྟགས་པའི་འཛིན་པ་རྣམས་གཞིག་པར་བྱ་སྟེ།",
    "མིང་གི་སྔ་རོལ་ན་བློ་མེད་པས་བདག་ཉིད་དུ་འགལ་བའི་ཕྱིར་དང་།",
    "ཁྱེད་ལ་སོགས་པས་གང་སྨྲས་པ་དེ་དག་ཐམས་ཅད་གཉིས་སུ་མེད་པ་ཡིན་མོད་ཀྱི།",
    "ཇི་ལྟར་བདག་གིས་ཤེས་པ་ལྟར་ཁྱེད་ཀྱིས་གང་སྨྲས་པ་དེ་དག་ནི་ད་དུང་གཉིས་སུ་གྱུར་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་ཅི་དངོས་པོ་ལྔ་པོ་དེ་དག་གིས་ཐམས་ཅད་གསུངས་པ་ཡིན་ནམ།",
    "གང་གི་ཕྱིར་བརྗོད་དུ་མེད་པ་བརྗོད་པ་ཡང་།",
    "རྣམ་པར་ཤེས་པ་དག་ནི་ཟག་པ་དང་བཅས་ཤིང་སྤྲོས་པ་དག་གིས་བཅིངས་པ་ཡིན་ལ།",
    "དེའི་ཕྱིར་མཐོང་བ་ལ་སོགས་པའི་དངོས་པོ་དག་གིས་དོན་དམ་པ་བསྟན་པར་མི་ནུས་སོ།",
    "ཐ་སྙད་དང་བསྟན་པར་བྱ་བ་ལ་བྱེ་བྲག་ཅི་ཡོད་ཅེ་ན་སྨྲས་པ་ཐ་སྙད་དག་གིས་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་དང་།",
    "མིག་གི་རྗེས་སུ་མཐོང་བ་སྐྱེ།",
    "དེ་ལ་མིག་གི་རྣམ་པར་ཤེས་པས་མྱོང་བ་གང་ཡིན་པ་དེ་ནི་མཐོང་བའོ།",
    "དེའི་ཕྱིར་དེ་དག་གི་རྗེས་སུ་སྐྱེས་པ་སོ་སོར་རྣམ་པར་གཞག་པ་ཡིན་ལ།",
    "གཞན་གསུམ་གྱི་རྗེས་སུ་སྐྱེས་པ་དག་ལ་ནི་དེ་དག་གི་མཚན་ཉིད་ཀྱི་རྣམ་པ་མེད་པའི་ཕྱིར་གཅིག་ཏུ་རྣམ་པར་གཞག་པ་ཡིན་ཏེ།",
    "གཞན་ཡང་མཛོད་ཀྱི་བསྟན་བཅོས་ལས་དྲི་དང་རོ་དང་རེག་བྱ་གསུམ་ནི་ལུང་དུ་མི་སྟོན་པའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་དང་།",
    "མཐོང་བ་ལ་ཡིད་ཆེས་པ་གང་ཡིན་པ་དེ་ནི་མངོན་སུམ་མོ།",
    "ཡིད་ཆེས་པའི་ཤེས་རབ་རྣམ་པ་གསུམ་པོ་འདི་ཡང་རེས་འགའ་ནི་ཡང་དག་པ་ཉིད་དུ་འགྱུར་རོ།",
    "རེས་འགའ་ནི་ཕྱིན་ཅི་ལོག་ཏུ་ཡང་འགྱུར་རོ་ཞེས་འབྱུང་སྟེ།",
    "དེ་ལ་རྣམ་པར་ཤེས་པའི་ཚོགས་དྲུག་གིས་སེམས་ཀྱི་ཡུལ་མཐོང་བ་ཐོས་པ་གང་ཡིན་པ་དེ་ནི་མངོན་སུམ་ཡིན་པས་དེའི་ཕྱིར་གང་གིས་མཐོང་ངོ་ཞེས་ཟེར་བ་ལ་ཡིད་ཆེས་པ་གང་ཡིན་པ་དེ་ནི་མངོན་སུམ་གྱི་ཡིད་ཆེས་པ་ཞེས་བྱའོ།",
    "རང་གི་སེམས་བསྐྱོད་དེ་རིགས་པ་རྣམ་པ་སྣ་ཚོགས་ཀྱི་རྗེས་སུ་དཔག་པས་སྣང་བ་གང་ཡིན་པ་དེ་ནི་བྱེ་བྲག་ཕྱེད་པ་ཞེས་བྱའོ།",
    "ཡུལ་ལྔ་པོ་རེ་རེ་ལ་མཐོང་བ་དང་།",
    "མིག་གིས་མངོན་སུམ་དུ་མཐོང་བ་ནི་མཐོང་བ་ཞེས་བྱའོ།",
    "རང་གི་སེམས་བསྐྱོད་ནས་སྣ་ཚོགས་སུ་བསམས་པས་གཞལ་བ་ལནི་བྱེ་བྲག་ཕྱེད་པ་ཞེས་བྱའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པས་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་མཐོང་བ་ཞེས་བྱའོ།",
    "ལྕེ་དང་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་གསུམ་པོ་དག་གིས་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་བྱེ་བྲག་ཕྱེད་པ་ཞེས་བྱའོ།",
    "མིག་གིས་མྱོང་བ་གང་ཡིན་པ་དེ་ནི་མཐོང་བའི་དོན་ཏོ།",
    "བདག་ཉིད་ཀྱི་ནང་གི་པྱོང་བ་གང་ཡིན་པ་དེ་ནི་རྣམ་པར་ཤེས་པའི་དོན་ཏོ་ཞེས་སྟོན་ཏོ།",
    "རྟོགས་པ་དང་རེག་པ་དང་མངོན་སུམ་དུ་བྱས་ནས་དེ་ལ་བརྟེན་ཏེ།",
    "ཁ་ཅིག་ན་རེ་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་མཐོང་བ་ཞེས་བྱ་སྟེ།",
    "མིག་གིས་མྱོང་བ་གང་ཡིན་པ་དེ་ནི་མཐོང་བའི་དོན་ཏོ་ཞེས་བསྟན་པ་ཡང་རྣམ་པར་ཤེས་པ་མིག་ལ་བརྟེན་པའི་ཕྱིར་རོ་ཞེའོ།",
    "མིག་གིས་ཛེེསྩོང་བ་གང་ཡིན་པ་དེ་ནི་མཐོང་བའི་དོན་ཏོ་ཞེས་བསྟན་ཏོ།",
    "མིག་གིས་ཕྱི་རོལ་གྱེ་གཟུགས་མཐོང་བ་ཡང་མ་ཡིན་ལ།",
    "དེ་དག་གི་རྣམ་པར་ཤེས་པ་ཡང་མ་ཡིན་ནོ།",
    "རེག་པ་དང་།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་དེ་ཡང་དག་པའི་ཡེ་ཤེས་དེ་གང་གིས་གཟུགས་ལ་སོགས་པའི་དོན་ལ་མིང་དང་རྣམ་པ་ལ་སོགས་པ་སྤོང་བའོ་ཞེས་བསྟན།",
    "ཁ་ཅིག་ན་རེ་རྣམ་པ་གཉིས་ཡོད་པས།",
    "སློབ་དཔོན་གཉིས་ཀྱི་གཞུང་གི་དོན་སྟིམི་མཐུན་པས་དེའི་ཕྱིར་བརྡ་སྤྲད་མི་དགོས་སོ།",
    "གཟུགས་ཀྱི་ཁམས་ན་ཡང་ཡང་དག་པའི་ཕུང་པོ་དང་སྦྱར་ན་ཀུན་དུ་ཚོལ་ཞིང་གཞལ་བ་ཕྲ་མོ་ཡོད་དེ།",
    "བདག་དང་བདག་གིར་ལྟ་བས་ཕུང་པོ་ལྔ་པོ་དག་ལ་བདག་ཡང་དག་པར་ཡོད་པར་འཛིན་པའོ།",
    "དེ་བཞིན་ཉིད་ནི་བདག་དང་བདག་གིར་འཛིན་པ་དང་བྲལ་བ་བདག་ཏུ་ལྟ་བ་ལ་སོགས་པའི་ཉོན་མོངས་པའི་སྤྱོད་ཡུལ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཉོན་མོངས་པ་ནི་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ཞེས་བྱའོ།",
    "ཉོན་མོངས་པ་ནི་རྩོད་པ་ཞེས་བྱ་སྟེ།",
    "ཉོན་མོངས་པའི་རྩོད་པ་དང་།",
    "ཉོན་མོངས་པའི་རྩོད་པ་ནི་འདི་ལྟ་སྟེ།",
    "ཉོན་མོངས་པ་བརྒྱ་རྩ་བརྒྱད་དོ།",
    "གཉི་མུག་གི་ངོ་བོ་ཉིད་ལ་བརྟེན་ནས་མཚོན་ཆ་ལེན་པ་དང་།",
    "དེའི་ཕྱིར་དེ་ཉིད་ལས་དེ་ཟག་པ་དང་བཅས་པའི་བདག་ཉིད་ཅེས་བྱ་བ་ནི་ཟག་པ་རྣམས་ཀྱི་རང་གི་ངོ་བོ་ཉིད་ཟག་པ་ཉིད་དང་མཐུན་པའི་ཕྱིར་ཟག་པ་དང་བཅས་པ་ཞེས་བྱའོ།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་དང་ཉོན་མོངས་པའི་གནས་ངན་ལེན་དང་རྗེས་སུ་འབྱེལ་པར་གྱུར་ཀྱང་ཟག་པ་མེད་པའི་ངོ་བོ་ཉིད་རྣམ་པར་འཇོག་པས་ཐམས་ཅད་ལ་རྒྱབ་ཀྱིས་རྔོཕྱོགས་ཤིང་དེའི་གཉེན་པོ་དང་རྗེས་སུ་མཐུན་པའི་ཕྱིར་རོ།",
    "དགྲ་བཅོམ་པའི་ཟག་པ་དང་བཅས་པའི་ཕུང་པོ་རྣམས་སྔོན་གྱི་ཉོན་མོངས་པ་ལས་བྱུང་བའི་ཕྱིར་ཉེ་བར་ལེན་པའི་ཕུང་པོར་རྣམ་པར་གཞག་གོ།",
    "དེའི་ཕྱིར་དེ་ཉིད་ལས་ཉོན་མོངས་པ་རྣམས་ཀྱི་རྣམ་གྲངས་གང་ཞེ་ན།",
    "མོས་པར་མི་ནུས་སོ་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་ལྔ་པ་དཔེ་སྨོས་ནས་བཟླས་ཏེ།",
    "མོས་པར་མི་ནུས་ཏེ་དེའི་ཕྱིར་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་ཡང་དག་པའི་དད་པས་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་ན་གཉེན་བཤེས་ཀྱི་ཉོན་མོངས་པའི་བགེགས་དང་།",
    "དགེ་སློང་གི་སྤྱོད་ལམ་དང་ལྡན་ལ་དགེ་སློང་གི་ཡོན་ཏན་མེད་པ་དང་།",
    "དགེ་སློང་གི་སྤྱོད་ལམ་མེད་ལ་དགེ་སློང་གི་ཡོན་ཏན་དང་ཡང་ལྡན་པ་དང་།",
    "དགེ་སློང་གི་སྤྱོད་ལམ་དང་ཡང་ལྡན་ལ་དགེ་སློང་གི་ཡོན་ཏན་དང་ཡང་ལྡན་པ་དང་།",
    "དགེ་སློང་གི་སྤྱོད་ལམ་ཡང་མེད་ལ་དགེ་སློང་གི་ཡོན་ཏན་ཡང་མེད་པའོ་ཞེས་འབྱུང་ངོ།",
    "ཡུན་རིང་པོ་ནས་འདོད་པའི་འདོད་ཆགས་ལ་མོས་པ་དང་།",
    "འདོད་པ་རྣམས་ཀྱིས་ཡོངས་སུ་གདུང་བའི་མེ་དག་གིས་ཡོངས་སུ་གདུང་བས་ནི་ནང་གི་གཟུགས་དང་།",
    "རོ་དང་རེག་བྱའི་མཚན་ཉིད་དང་བྲལ་བ་རབ་ཏུ་དབེེན་པའི་བདེ་བ་བརྟག་པའམ་རྗེས་སུ་དཔག་པའམ།",
    "མོས་པར་མི་ནུས་སོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་འདོད་པའི་ཡོན་ཏན་ལྔའི་བདེ་བ་ཡོངས་སུ་སྤངས་པའི་དཔེ་བསྟན་པའོ།",
    "དཔེ་གཞན་གཉིས་ལས་ཚངས་པ་སྨོས་པ་ནི་ལོ་ཙཱ་བ་དག་གི་བསམ་པ་ཐ་དད་པའི་ཕྱིར་རོ།",
    "འདོད་པའི་འདོད་ཆགས་ཞེས་བྱ་བ་ནི་འདོད་པ་ལ་མོས་པའི་ངོ་བོ་ཉིད་དོ།",
    "མོས་པ་ཞེས་བྱ་བ་ནི་ལྔ་སོ་སོར་ངེས་པ་ལས་མོས་པའི་ངོ་བོ་ཉིད་དོ།",
    "འདིར་འདོད་པ་སྨོས་པ་ནི་དོན་གྱིས་མོས་པ་གཟུང་ངོ།",
    "འདོད་པའི་ཡོངས་སུ་གདུང་བ་དག་གིས་ཡོངས་སུ་གདུང་བ་ཞེས་བྱ་བ་ལ།",
    "ཁ་ཅིག་ན་རེ་འདོད་པ་རྣམས་ཞེས་བྱ་བ་ནི་གཟུགས་ལ་སོགས་པའི་ཡུལ་ལྔ་པོ་རྣམས་སོ།",
    "ཁ་ཅིག་ན་རེ་འདོད་པ་རྣམས་ཞེས་བྱ་བ་ནི་ཡུལ་ལྔ་པོ་དག་ལ་འདོད་ཆགས་པ་ཡིན་པས།",
    "ནང་གི་གཟུགས་ལ་སོགས་པ་ཞེས་བྱ་བ་ལ།",
    "འདི་ནི་ནང་གི་ཏིང་ངེ་འཛིན་ཏེ།",
    "ནང་གི་གཟུགས་དང་སྒྲ་དང་དྲི་དང་རོ་དང་རེག་བྱའི་མཚན་ཉིད་དང་བྲལ་བ་རབ་ཏུ་དབེེན་པའི་བདེ་བ་ཞེས་བྱ་བ་འདིས་ནི་བསམ་གཏན་དང་པོའི་ཏིང་ངེ་འཛིན་དང་མཚུངས་པར་ལྡན་པའི་བདེ་བའི་ཚོར་བ་བསྟན་ཏེ།",
    "ཡང་དག་པའི་དོན་དུ་ན་བསམ་གཏན་དང་པོའི་ཏིང་ངེ་འཛིན་གྱིས་སྒྲིབ་པ་ལྔ་པོ་དག་ཚང་བར་སྤངས་པ་ཡིན་མོད་ཀྱང་།",
    "ཡུན་རིང་པོ་ནས་ཀུན་དུ་སྨྲ་བ་ལ་མོས་པ་དང་།",
    "ནང་གི་རབ་ཏུ་དབེན་པ་འཕགས་པའི་མི་སྨྲ་བའི་བདེ་བ་ལ་བརྟག་པའམ།",
    "མོས་པར་མི་ནུས་སོ་ཞེས་བྱ་བ་ནི་གསུམ་པ་འཕགས་པ་མི་སྨྲ་བའི་རབ་ཏུ་དབེེན་པའི་དཔེ་ཞེས་བྱ་སྟེ།",
    "གཉིས་པ་ངག་གི་འདུ་བྱེད་ནི་འདི་ལྟ་སྟེ།",
    "རྟོག་པ་དང་དཔྱོད་པ་ནི་ངག་གི་འདུ་བྱེད་སློང་བས་ངག་གི་འདུ་བྱེད་ཅེས་བྱ་སྟེ།",
    "རྣམ་པར་ཤེས་པའི་ཐ་སྙད་ལ་མོས་པ་དང་།",
    "རྗེས་སུ་དཔག་པའམ་མོས་པར་མི་ནུས་སོ་ཞེས་བྱ་བ་ནི་བཞི་པ་ཐ་སྙད་རྣམས་དང་བྲལ་བ།",
    "བྱང་གི་སྒྲ་མི་སྙན་དག་གིས་བདག་གིར་འཛིན་པ་མེད་པ་ཉིད་དང་།",
    "དེའི་ཕྱིར་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་ཉོན་མོངས་པ་ཐམས་ཅད་དང་གཏན་དུ་བྲལ་བ་ཡིན་ཏེ།",
    "འདི་ལྟར་རྩོད་པའི་སྨྲ་བ་ལ་མོས་པ་དག་ནི་འཇིག་རྟེན་པའི་བདག་གིར་ཡོངས་སུ་གཟུང་བ་ཕ་མ་དང་།",
    "དེ་བཞིན་དུ་རྟོག་པ་དང་དཔྱོད་པ་དང་བཅས་པ་དག་གིས་ཀྱང་ཉོན་མོངས་པའི་རྩོད་པའི་སྨྲ་བ་ལ་སོགས་པའི་སྤྱོད་ཡུལ་ལ་སྤྱོད་པས།",
    "དོན་དམ་པའི་བདེན་པའི་མཚན་ཉིད་ཉོན་མོངས་པ་ལ་སོགས་པ་མེད་པའི་རྩོད་པའི་ཡུལ་དང་བྲལ་བ་ལ་བརྟག་པར་མི་ནུས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "མོས་པར་མི་ནུས་སོ་ཞེས་བྱ་བ་ནི་དྲུག་པ་དཔེ་དང་དོན་དུ་སྦྱར་བའི་དོན་ཏོ།",
    "འདི་ལྟར་རྟོག་པ་དང་དཔྱོད་པ་དག་གི་མཚན་ཉིད་རྩིང་བའི་ཕྱིར་དོན་དམ་པའི་བདེན་པའི་མཚན་ཉིད་ཁོང་དུ་ཆུད་པར་མི་འགྱུར་ཏེ།",
    "ཐ་མའི་ཚིག་གཅིག་གིས་ནི་མཚན་ཉིད་རྣམ་པ་ལྔ་སྤྱིར་བསྟན་ཏོ།",
    "གཞན་དག་གི་བློ་རྣམ་པར་དག་པ་བསྐྱེད་པའི་ཕྱིར།",
    "འདི་ན་བདག་གིས་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་གྱི་ཁམས་མི་མཇིད་འདིའམ་ཡང་ན་འཛམ་བུའི་གླིང་འདིར་རོ།",
    "མོས་པས་སྤྱོད་པའི་ས་ནི་སའི་མདུན་རོལ་བསྐལ་པ་གྲངས་མེད་པ་དང་པོའི་གནས་སྐབས་ལ་གནས་པ་དག་ཡིན་ཏེ།",
    "མོས་པ་སྤྱོད་པའི་གང་ཟག་ལ་མིང་རྣམ་པ་བཞི་ཡོད་དེ།",
    "འདི་བཞིའི་ས་བོན་གང་ཡིན་པ་དེ་ནི་མོས་པས་སྤྱོད་པའི་ས་ཞེས་བྱ་སྟེ།",
    "དང་པོ་ནི་སྨོན་པས་མོས་པའི་ས་ཞེས་བྱ་སྟེ།",
    "བཞི་པ་ནི་ཡིད་ཀྱིས་མོས་པའི་ས་ཞེས་བྱ་སྟེ།",
    "ཅིའི་ཕྱིར་ས་འདིའི་མིང་གི་རྣམ་གྲངས་མང་པོར་འགྱུར་ཞེ་ན།",
    "དང་པོ་ནི་སྤྱིའི་མིང་ཡིད་ཀྱིས་མོས་པ་ཞེས་བྱ་སྟེ།",
    "དེའི་ཕྱིར་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལ་སོགས་པ་ལས་ཡིད་ཀྱི་མོས་པ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "གཉིས་པ་ནི་བྱེ་བྲག་གི་མིང་སྟེ།",
    "འདི་ཡང་རྣམ་པ་གསུམ་མོ།",
    "དང་པོ་ནི་སྨོན་ཅིང་མོས་པ་སྟེ།",
    "མོས་པ་དང་མཐུན་པའི་རྣམ་གྲངས་སོ།",
    "དེའི་ཕྱིར་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པའི་བསྟན་བཅོས་ལས་མོས་པ་ནི་འདི་ལྟ་སྟེ།",
    "གསུམ་པ་ནི་མོས་པས་སྤྱོད་པ་ཞེས་བྱ་སྟེ།",
    "ལྔ་ཡུལ་སོ་སོར་ངེས་པ་ལས་མོས་པའི་ངོ་བོ་ཉིད་དེ།",
    "གཞན་ཡང་དེ་ཉིད་ལས་དང་པོ་མོས་པ་ཐོབ་པ་ནི་འདི་ལྟ་སྟེ།",
    "རེ་ཞིག་གཅིག་པ་དང་ཐ་དད་པ་གཞིག་པར་བྱ་སྟེ།",
    "ཐ་མི་དད་ན་ནི་འདི་དག་དེ་དག་གི་སྤྱིའི་མཚན་ཉིད་མ་ཡིན་པར་འགྱུར་བའི་རིགས་ཏེ།",
    "ཁྱོད་ཀྱིས་ཇི་སྐད་སྨྲས་པ་དེ་བཞིན་དུ།",
    "མངོན་སུམ་དུ་བྱས་པ་དེ་ཡང་རེ་ཞིག་ཐམས་ཅད་ཡོད་པར་སྨྲ་བའི་གཞུང་དང་སྦྱར་ན།",
    "སྐད་ཅིག་མ་གཅིག་གི་མུ་བཞིའོ།",
    "ཁམས་གོང་མ་གཉིས་ནི་མཐོང་བས་སྤང་བར་བྱའི་ཉོན་མོངས་པ་སྤངས་པས་འཐོབ་པའི་འདུས་མ་བྱས་ཡིན་ཏེ།",
    "ཟག་པ་མེད་པའི་འཕགས་པའི་ལམ་མོ།",
    "ཁ་ཅིག་ན་རེ་ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་དག་ནི་མཚན་མའི་རྣམ་པ་ལ་མཚན་མའི་འཆིང་བ་ཞེས་འབྱུང་ཞེས་ཟེར་ཏེ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་རྣམས་གནས་ངན་ལེན་གྱི་འཆིང་བ་ཞེས་བྱའོ་ཞེས་སྟོན་ཏོ།",
    "དང་པོ་རྣམ་པར་ཤེས་པ་དྲུག་དང་མཚུངས་པར་ལྡན་པའི་ཉོན་མོངས་པ་ནི་གནས་ངན་ལེན་ཞེས་བྱ་སྟེ།",
    "འདིར་ནི་སྔ་མ་གཟུང་གི་ཕྱི་མ་ནི་མ་ཡིན་ནོ་ཞེའོ།",
    "འཆིང་བ་ནི་ཉོན་མོངས་པའི་མཚན་མའི་རྣམ་པའི་ས་བོན་ནོ།",
    "གཞན་ཡང་དེ་ཉིད་ལས་མཚན་མའི་ཉོན་མོངས་པ་དང་གནས་ངན་ལེན་གྱི་ཉོན་མོངས་པ་རྣམ་པར་འབྱེད་པའི་སྐབས་ནས།",
    "ཉོན་མོངས་པ་རྣམ་པ་གཉིས་ཀྱིས་སེམས་བྱེད་ཅན་རྣམས་འཆིང་བར་བྱེད་དེ།",
    "མཚན་མའི་ཉོན་མོངས་པ་དང་གནས་ངན་ལེན་བྱུ་ཉོན་མོངས་པའོ།",
    "དེ་ལ་མཚན་མའི་ཉོན་མོངས་པ་ནི་ཀུན་དུ་རྟོག་པའི་ངོ་བོ་ཉིད་དོ།",
    "རྐྱེན་བྱེད་པའི་ཉོན་མོངས་པ་ཞེས་བྱ་སྟེ།",
    "འདི་ལྟར་རྣམ་པར་ཤེས་པ་དྲུག་པོ་ཐམས་ཅད་ཀྱིས་སེམས་ཀྱིས་དམིགས་པར་བྱ་བའི་ཕྱི་རོལ་གྱི་ཡུལ་རྣམས་ཡོད་པ་ཉིད་དུ་འཛིན་ཅིང་ཐམས་ཅད་རང་གི་སེམས་ཀྱིས་བྱས་པར་ཁོང་དུ་མ་ཆུད་པའི་ཕྱིར།",
    "སློབ་དཔོན་ཡང་དག་བདེན་པའི་བརྗེད་བྱང་ལས་རྣམ་པར་ཤེས་པ་ལྔ་པོ་དག་གི་ཡུལ་གང་ཡིན་པ་དེ་ནི་མཚན་མའི་འཆིང་བ་ཞེས་བྱའོ།",
    "ཀུན་འབྱུང་གི་བདེན་པ་སརྦ་ནི་གནས་ངན་ལེན་གྱི་འཆིང་བ་ཞེས་བྱ་སྟེ།",
    "ཉོན་མོངས་པའི་འཆིང་བ་ཞེས་འབྱུང་སྟེ།",
    "ཇི་ལྟར་འདུ་བྱེད་རྣམས་ཀྱི་མཚན་ཉིད་ཀུན་ནས་ཉོན་མོངས་པའི་མཚན་ཉིད་དུ་གཏོགས་པ་དེ་བཞིན་དུ།",
    "དོན་དམ་པའི་མཚན་ཉིད་འདི་ཡང་ཀུན་ནས་ཉོན་མོངས་པའི་མཚན་ཉིད་དུ་གཏོགས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་རྣམ་གྲངས་རྣམ་པ་གསུམ་ལས་རྣམ་གྲངས་གཉིས་པ་རྣམ་པར་དག་པའི་སྤྱིའི་མཚན་ཉིད་ལ་བརྟེན་ནས་གཅིག་པ་དང་།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་མཚན་ཉིད་དུ་གཏོགས་པ་ལ་བརྟེན་ནས་གཅིག་པ་ཉིད་དུ་འཛིན་པ་རྣམ་པར་གཞིག་པ་དང་།",
    "འདི་ལྟར་དོན་དམ་པའི་བདེན་པ་ཀུན་ནས་ཉོན་མོངས་པ་ཉིད་དུ་ལྟ་བར་འགྱུར་ཏེ།",
    "འདུ་བྱེད་རྣམས་ཀྱི་མཚན་ཉིད་ལས་ཐ་དད་དུ་གྱུར་པ་མེད་པའི་ཕྱིར་ཀུན་ནས་ཉོན་མོངས་པ་བཞིན་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དང་པོ་ནི་རང་གི་མཚན་ཉིད་དེ།",
    "འདི་ལྟར་ཀུན་དུ་ཁྱབ་པ་མ་ཡིན་པའི་ཕྱིར་རང་གི་མཚན་ཉིད་ཅེས་བྱའོ།",
    "བློ་གྲོས་ཤིན་ཏུ་རྣམ་དག་འདིར་དོན་དམ་པའི་མཚན་ཉིད་ཀུན་ནས་ཉོན་མོངས་པའི་མཚན་ཉིད་དུ་གཏོགས་པ་མ་ཡིན་པ་དང་།",
    "མཐོང་བ་ལ་སོགས་པའི་ཡུལ་དེ་དག་ཇི་ལྟར་མཐོང་བ་བཞིན་དུ་དེ་དག་གི་དོན་ཁོང་དུ་ཆུད་ཟིན་པས་ཕྱིས་དོན་དམ་པ་ཡོངས་སུ་ཚོལ་བ་ཛུམི་རིགས་ན།",
    "བྱེ་བྲག་གི་མཚན་ཉིད་གྲུབ་པ་མ་ཡིན་པས་ཐ་དད་པར་འདོད་པ་རྣམ་པར་གཞིག་པའོ།",
    "རང་གི་ངོ་བོ་ཉིད་མེད་པ་ཙམ་ཀྱིས་རབ་ཏུ་ཕྱེ་བ་མ་ཡིན་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གཞན་ཡང་དུས་གཅིག་ཏུ་བྱེ་བྲག་གི་མཚན་ཉིད་གྲུབ་པ་ཉིད་དུ་འགྱུར་ཏེ།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་མཚན་ཉིད་དང་།",
    "རྣམ་པར་བྱང་བའི་མཚན་ཉིད་དོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་བྱེ་བྲག་གི་མཚན་ཉིད་གྲུབ་པ་མ་ཡིན་པས་ཐ་དད་པའི་འདོད་པའི་རྣམ་པར་གཞིག་པའོ།",
    "ཁ་ཅིག་ན་རེ་གཞན་ཡང་དུས་གཅིག་ཏུ་བྱེ་བྲག་གི་མཚན་ཉིད་གྲུབ་པ་ཉིད་དུ་འགྱུར་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་མིང་ལ་སོགས་པའི་དངོས་པོའི་གཟུགས་བརྙན་ཡོངས་སུ་བསལ་བས་མཚན་མ་མེད་པའི་དེ་བཞིན་ཉིད་མངོན་དུ་གྱུར་པ་སྟེ།",
    "ཁ་ཅིག་ན་རེ་གཞན་ཡང་དུས་གཅིག་ཏུ་བྱེ་བྲག་གི་མཚན་ཉིད་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ཟུ་རྣམ་པར་བྱང་བའི་མཆོག་ཏུ་གྱུར་པ་མཐོང་བའི་ཚེ་ཡང་ཀུན་ནས་ཉོན་མོངས་པ་སྤོང་བར་འགྱུར་བའི་མི་རིགས་ལ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་མཐོང་བའི་ཚེ་ཡང་རྣམ་པར་བྱང་བ་ལ་སྒྲིབ་པར་མི་འགྱུར་བའི་རིགས་སོ་ཞེའོ།",
    "ཁ་ཅིག་ན་རེ་དོན་དམ་པ་དང་།",
    "འདི་ནི་དང་པོ་བདག་མེད་པ་ཙམ་གྱིས་རབ་ཏུ་ཕྱེ་བའི་དོན་གྱིས་ཐ་དད་པར་འཛིན་པ་རྣམ་པར་གཞིག་པའོ་། གཞན་ཡང་དུས་གཅིག་ཏུ་ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་གཉིས་ཀྱི་མཚན་ཉིད་ཀྱི་བྱེ་བྲག་གི་མཚན་ཉིད་གྲུབ་པ་མ་ཡིན་པས་ཞེས་བྱ་བ་ནི།",
    "གཉིས་པ་བྱེ་བྲག་གི་མཚན་ཉིད་མ་ཡིན་པ་ལ་བརྟེན་ནས་ཐ་དད་པར་འཛིན་པ་འཇིག་པར་མཛད་པ་སྟེ།",
    "བློ་གྲོས་ཤིན་ཏུ་རྣམ་དག་དཔེར་ན་དུང་གི་དཀར་བ་ཉིད་ནི་དུང་དཀར་བ་གཅིག་པའམ།",
    "འདི་ནི་དང་པོ་དུང་གི་དཀར་བ་གཅིག་པ་དང་།",
    "རྟུལ་པོ་གཉིས་ཀས་འཇུག་པར་འགྱུར་བའི་རྗོཕྱིར་དངོས་པོ་ཟབ་པ་མ་ཡིན་པ་ལ་ལྟོས་ནས་ཚུལ་ཟབ་མོ་མཚོན་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་རེག་བྱའི་བར་དུ་ཡང་དེ་བཞིན་ནོ་ཞེས་འབྱུང་སྟེ།",
    "དུང་གི་དཀར་བ་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་གསེར་གྱི་སེར་པོ་ཉིད་ཀྱང་དེ་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་གཉིས་པ་གསེར་དང་སེར་པོ་ཉིད་གཅིག་པ་ཉིད་དང་ཐ་དད་པའི་དཔེ་སྟེ།",
    "དེ་ལ་འདུ་བྱེད་ཐམས་ཅད་ལ་མི་རྟག་པ་ཉིད་ཅེས་བྱ་བ་ལ་འདུ་བྱེད་ནི་ཟག་པ་དང་བཅས་པ་ཐམས་ཅད་དེ་མཚན་ཉིད་བཞི་པོ་དེ་དག་གིས་རྣམ་པར་འགྱུར་བར་བྱེད་པའི་ཕྱིར་མི་རྟག་པ་ཞེས་བྱ་སྟེ།",
    "འདིར་ནི་སྔ་མ་བསྟན་པ་ཡིན་གྱི་ཕྱི་མ་མ་ཡིན་པས་དེའི་ཕྱིར་གང་ཟག་གི་བདག་མེད་པ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་མཚན་ཉིད་ཀྱང་འདོད་ཆགས་དེ་དང་གཅིག་པའི་མཚན་ཉིད་དམ།",
    "འདོད་ཆགས་ཀྱི་ཇི་ལྟ་བ་བཞིན་དུ་ཞེ་སྡང་དང་གཏི་མུག་གི་ཡང་དེ་ཡང་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་བཅུ་པ་ཉོན་མོངས་པ་ཉིད་དང་མཚན་ཉིད་གཅིག་པ་དང་།",
    "དང་པོ་རང་གི་མཚན་ཉིད་ནི་འདི་ལྟ་སྟེ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་ལ་སོགས་པ་དེ་དག་ཐུན་མོང་དུ་ཡོད་པའི་ཕྱིར་རོ།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་མཚན་ཉིད་ནི་མཚུངས་པར་ལྡན་པ་དང་།",
    "འདི་ལྟར་འདོད་ཆགས་ལ་སོགས་པ་དེ་དག་གི་རྗོངོ་བོ་ཉིད་དང་མཚན་ཉིད་ཐ་དད་པའི་ཕྱིར་གཅིག་ཅེས་བྱར་ཁྱེཡང་མི་རུང་ངོ།",
    "འདོད་ཆགས་དང་ཞེ་སྡང་ལ་སོགས་པ་རེ་རེ་ལ་ཡང་མ་ཞི་བའི་མཚན་ཉིད་ཀུན་ནས་ཉོན་མོངས་པའི་མཚན་ཉིད་ཡོད་དེ།",
    "དེ་ལ་བྱེ་བྲག་ནི་དེ་དག་གཞུང་གིས་བྱས་པ་མ་ཡིན་པ་ནི་གཟུགས་ཀྱང་མ་ཡིན་སེམས་ཀྱང་མ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "དོན་དམ་པ་དེ་ཡང་དད་པ་བཅུའི་མདུན་རོལ་གྱི་ཕྱི་རོལ་པའི་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་སྤྱོད་ཡུལ་ལས་འདས་པས་དེ་དག་གིས་བསྙད་པར་བྱ་བ་མ་ཡིན་པ་དང་།",
    "དེ་དག་གིས་རིག་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་ཕྲ་བ་མཆོག་ཏུ་ཕྲ་བ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཚིག་གིས་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་དང་།",
    "བསམ་པས་རེག་པར་འགྱུར་བ་མ་ཡིན་པའི་ཕྱིར་ཟབ་པ་མཆོག་ཏུ་ཟབ་པ་ཞེས་གསུངས་སོ།",
    "བསམ་པས་རེག་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རྟོགས་པར་དཀའ་བ་མཆོག་ཏུ་རྟོགས་པར་དཀའ་བ་ཞེས་གསུངས་ཏེ།",
    "ཁ་ཅིག་ན་རེ་འདུས་བྱས་ཀྱི་རང་གི་ངོ་བོ་ཉིད་ནི་ཁམས་ཞེས་བྱའོ་ཞེའོ།",
    "ཁ་ཅིག་ན་རེ་འདུ་བྱེད་རྣམས་ནི་དེ་བཞིན་ཉིད་ཀྱིས་ངོ་བོ་ཉིད་བྱེད་པས།",
    "འཆིང་བ་གཉིས་པོ་དག་གིས་བཅིངས་པར་གྱུར་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དེ་ཉིད་ལས་གཞན་ཡང་ཉོན་མོངས་པ་རྣམས་ནི་ཇི་ལྟར་སྤོང་བར་འགྱུར།",
    "ཇི་ཙམ་གྱིས་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་སྤོང་བར་བརྗོད་པར་བྱ་ཞེ་ན།",
    "ལྷག་མཐོང་ལ་གོམས་པར་བྱ་བའི་པེཕྱིར་ཉོན་མོངས་པ་སྤོང་བར་བྱེད་དེ།",
    "གནས་ངན་ལེན་གྱི་འཆིང་བ་ལས་ཀྱང་རྣམ་པར་གྲོལ་བར་འགྱུར་བ་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་པར་བརྗོད་པར་བྱ་སྟེ།",
    "གནས་ངན་ལེན་དག་གིས་ཀྱང་གང་བཅིངས་པ།",
    "རང་གི་དོན་ཡང་དག་པར་རྣམ་པར་གཞག་པའི་དུས་དང་།",
    "ཁ་ཅིག་ན་རེ་འདི་ནི་བྲམ་ཟེའི་བུ་ཡིན་ཏེ་ལྷ་རྣམས་ལ་གསོལ་བ་བཏབ་པས་ཐོབ་པ་ཡིན་ནོ།",
    "རྒྱལ་བྱེད་ཀྱི་ཚལ་དུ་བཅོམ་ལྡན་འདས་སྐྱེལ་དུ་སོང་བ་ལས་དགྲ་བཅོམ་པའི་འབྲས་བུ་ཐོབ་པར་གྱུར་ཏོ་ཞེའོ།",
    "ཁ་ཅིག་ན་རེ་འདི་ནི་རྒྱལ་པོ་ཡོངས་སུ་དག་པའི་དབྱངས་ཞེས་བྱ་བའི་སྲས་ཡིན་ནོ་ཞེའོ།",
    "ཉོན་མོངས་པ་མེད་པའི་ཏིང་ངེ་འཛིན་ལ་རབ་ཏུ་ཞུགས་པའི་ཕྱིར་དང་།",
    "གཞན་ཡང་སྔ་མ་ནི་འབྲས་བུ་མེད་པའི་གང་ཟག་གི་སྤྱོད་པ་སྨྲས་པའོ།",
    "ཕྱི་མ་ནི་འབྲས་བུ་དང་བཅས་པའི་གང་ཟག་གི་སྤྱོད་པ་སྨྲས་པའོ།",
    "ཁ་ཅིག་ན་རེ་སོ་སོའི་སྐྱེ་བོས་ནི་ལྔ་སྐྱེད་རྗོཔར་བྱེད་དེ་འདི་ལྟ་སྟེ།",
    "ཁ་ཅིག་ན་རེ་སོ་སོའི་སྐྱེ་བོས་ནི་དགུ་སྐྱེད་པར་བྱེད་དེ་འདི་ལྟ་སྟེ།",
    "ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་རྣམས་ལ་བདག་གམ་བདག་གིར་ཡང་དག་པར་ལྟ་བའི་སེམས་ཁེངས་པ་གང་ཡིན་པའོ།",
    "གོང་མའི་ཁྱད་པར་ཐོབ་པར་བྱ་བ་མ་ཐོབ་པར་བདག་གིས་ཐོབ་པོ་སྙམ་དུ་སེམས་ཁེངས་པ་གང་ཡིན་པའོ།",
    "ཁྱད་ཆེས་འཕགས་པས་བདག་ཅུང་ཟད་ཅིག་གིས་ཆུང་ངོ་སྙམ་པའི་སེམས་ཁེངས་པ་གང་ཡིན་པའོ།",
    "དེ་ལ་རེ་ཞིག་ང་རྒྱལ་རྣམ་པ་བདུན་ལས་ང་རྒྱལ་དང་ཆེ་བའི་ང་རྒྱལ་དང་ང་རྒྱལ་ལས་ཀྱང་ང་རྒྱལ་དང་ཅུང་ཟད་སྙམ་པའི་ང་རྒྱལ་ནི་ཕྱོགས་རྣམ་པ་གསུམ་ལ་བརྟེན་ནས་འབྱུང་ངོ།",
    "ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་དག་ལ་བདག་དང་བདག་གིར་འཛིན་པ་དེ་ལས་ནི་ངའོ་སྙམ་པའི་ང་རྒྱལ་འབྱུང་ངོ།",
    "ཁྱད་པར་དུ་གྱུར་པའི་ཡུལ་ལ་དུརྟོག་པའི་བྱེ་བྲག་གི་ཕྱིར་ཏེ།",
    "ཆེས་ཁྱད་པར་དུ་འཕགས་པ་ལས་བདག་ཅུང་ཟད་ཅིག་གིས་དམན་ནོ་སྙམ་པ་གང་ཡིན་པ་དེ་ནི་ཅུང་ཟད་སྙམ་པའི་ང་རྒྱལ་ཞེས་བྱའོ།",
    "འདི་ལྟར་དགྲ་བཅོམ་པ་དག་ནི་ཉོན་མོངས་པའི་སྒྲིབ་པ་སྤངས་པའི་ཕྱིར་རོ།",
    "ཉོན་མོངས་པའི་ང་རྒྱལ་མེད་ཀྱང་ཤེས་བྱའི་ང་རྒྱལ་དང་བཅས་པའི་ཕྱིར་རོ་ཞེའོ།",
    "ཁ་ཅིག་ན་རེ་ས་བདུན་པ་མན་ཆད་ལ་བྱུང་ན་ཉེས་པ་མེད་དོ།",
    "ས་རེ་རེ་ལ་ཕན་ཚུན་ལྟོས་ནས་མཆོག་དང་དམན་པ་ཡོད་པའི་ཕྱིར་རོ་ཞེའོ།",
    "སྨྲས་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་ཞེས་བྱ་བ་ཡང་མིང་གིས་ཐམས་ཅད་ཡིན་བྱི་ཡང་དག་པའི་ཐམས་ཅད་ནི་མ་ཡིན་ཏེ།"
  ]
}