    "དེ་ནི་བསམ་གཏན་སྤེལ་ནས་འོག་མིན་འགྲོ་དེ་འཕར་ཕྱེད་འཕར་ཐམས་ཅད་དུ།",
    "དགྲ་བཅོམ་འབྲས་ཞུགས་དོཪ་ནས་འོག་མིན་འགྲོ་འཕཪ་གསུམ་ལས་ཐ་དད་དུ་བགྲངས་པ་མི་འཐད་དེ།",
    "འོག་མིན་འགྲོ་རྣམས་ཐ་དད་དུ་གསུངས་པ་དང་འགལ་ཞེ་ན།",
    "སྟན་གཅིག་ལ་འདུག་པ་དེ་སྲིད་དུ་ཟའི་དེ་ལས་ལངས་ནས་མི་ཟ་བ་དང་།",
    "ཟས་ཀྱི་ཕྱིར་འདུག་ནས་བདག་འཚོ་བ་ཙམ་མ་རྙེད་པར་མི་ཟ་ཞིང་རྙེད་ནས་ཀུན་ཟའི་དེ་ལས་ལྷག་པའི་ཟས་ཀྱི་བྱ་བ་མེད་པ་དང་།",
    "ཁྲིའམ་ཁྲིའུ་རྩ་བཏིང་པའི་སྟེང་དུ་ཙོག་པུར་འདུག་སྟེ་རྒྱབ་བམ་གློས་མི་བརྟེན་པ་དང་།",
    "འདོད་པ་གཟུགས་གཟུགས་མེད་ཀྱི་ཁམས་གསུམ་པོ་ལ་དངོས་པོ་མེད་པས་བདེན་པར་འཛིན་པའི་གནས་པ་དང་རང་བཞིན་མེད་པས་ཆགས་པ་དང་།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའི་ཚེ།",
    "ཐ་མ་འདིར་ཡང་རང་དོན་འགྲུབ་ཀྱི་འགོག་པ་མ་ཡིན་ཏེ་དེ་གཞན་དོན་དང་མི་འགལ་བས་རྫོགས་པས་སོ།",
    "རང་རང་འཁོར་གྱི་ཐོས་སྒྲོགས་དགྲ་བཅོམ་བཅས།",
    "ཕན་ཆ་ཤིན་ཏུ་ཆེ་བར་འདུག་ཅེས་ནན་ཏན་ཆེན་པོས་ཞུ་མཆིད་ཚིགས་བཅད་ཀྱི་ལམ་ནས་སྤེལ་བ་འདི་ལྟར།",
    "སྐབས་འདིར་ཡན་ལག་བདུན་པའི་ཚིགས་སུ་བཅས་པ་མང་ཙམ་འདུག་ཀྱང་ཡི་གེ་མང་བས་མ་བྲིས།",
    "གང་སྣང་ཐམས་ཅད་ཡིག་འབྲུ་ཤིན་ཏུ་ཆེ་བ་མང་པོས་གང་ནས་ཁྲ་ཆེམ་ཆེམ་འདུག་པ་ལ།",
    "ལྡེབ་ཕྲེང་མི་ཚང་བའང་འདུག་པས་དེ་རྣམས་སྟོང་པ་མི་བཞག་ཀ་མེད་བྱུང་བ་བཅས་ལ་བརྟེན་ནས་ད་དུང་ཞུ་བཅོས་མ་ཐུབ་པ་ཤིན་ཏུ་མང་བ་དང་།",
    "ཡིག་ནོར་ཡིན་ངེས་རྣམས་དག་བཅོས་གནང་འདུག།",
    "དོགས་གཞི་ཅན་ནམ་ཐག་མ་ཆོད་པའི་ཚིག་དོན་རྣམས་མ་དཔེ་སོར་བཞག་ལས་བཅོས་མི་འདུག།",
    "ཐམས་ཅད་ཀྱང་རང་རིག་པའི་མངོན་སུམ་དུ་ལྷུན་གྱིས་རྫོགས་པའི་ཕྱིར་རིལ་འབྲས་བུའི་དངོས་གཞི་ལ།",
    "འདིར་ཡང་རང་རྒྱལ་བའི་གོལ་ས་བསྟན་པའི་ཕྱིར།",
    "ཐམས་ཅད་ཀྱང་རང་བྱུང་ཡེ་ཤེས་ཉིད་ཡིན་པས་དུས་གསུམ་རྒྱལ་བ་དང་ཁམས་གསུམ་པ་རིལ་པ་དེ་ཉིད་དུ་འདུས་པས་ལམ་ཆེན་པོར་སྟོན་པའོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བའི་ལྟ་བ་གོལ་བ་བསལ་བའི་ཕྱིར།",
    "རང་རིག་སྤྱོད་ཡུལ་བྲལ་བས་སྐད་ཅིག་མའི་རྒྱུད་དུ་སྐྱེ་བ་མེད་པར་ཅིར་ཡང་རང་གསལ་ལ་ཐུགས་སོ།",
    "ཐོབ་པ་པོའི་དངོས་པོའི་སྤྱོད་ཡུལ་ཞིག་དུས་དང་གནས་རིས་ཐམས་ཅད་དུ་སོ་སོ་ཐ་དད་དུ་མེད་དེ།",
    "རང་བྱུང་ཡེ་ཤེས་སུ་རང་ཤར་བའང་རང་རིག་པ་ཉིད་དེ།",
    "རྐྱེན་མ་ཚང་བས་དམིགས་པ་ཐམས་ཅད་བྲལ་བ་ཞེས་བྱ་བ་ཡང་གོམས་པའི་འདུ་ཤེས་སྒྲས་མུན་པའི་མཐར་འདུག་པས་ཟུག་རྔུར་འགྱུར་བ་ཡང་ལས་དང་འབྲས་བུ་ལ་སོགགས་པ་ཀུན་ཀྱི་མཆོག་ཏུ་གྱུར་པ་ནི།",
    "ཡང་རང་བཞིན་ཆ་འཕྲད་གང་འཛིན་པ།",
    "ཡུལ་དང་རང་རིག་ངོ་བོ་གདོད་ནས་མ་གྲུབ་པས།",
    "ཐམས་ཅད་ཀྱང་རང་རིག་པ་ཉིད་རང་སྣང་བའི་ཕྱིར།",
    "ལྡང་ན་ཡང་ངོ་བོ་ཉིད་དུ་ཤེས་པ་ཐམས་ཅད་ཀྱང་རང་ཉིད་དུ་གསལ་བ་ནི་གསུམ་པའི་བདེ་བ་སྟེ།",
    "གང་ཡང་རང་བཞིན་ཉིད་ལས་མ་ཉམས་པའོ།",
    "ཡེ་ཤེས་ལྔ་དང་རང་བྱུང་ཡེ་ཤེས་ཀྱིས་ཀུན་ལ་རྒྱས་བཏབ་པས་མུ་མཐའ་མི་རྙེད་དེ་སྐུར་ཤར་བའོ།",
    "བདག་ཉིད་མཛད་སྤྱོད་ཅིར་ཡང་རང་སྣང་བར་རྟོགས་པའི་དགོངས་པས་བརྩལ་བ་མེད་པར་དོན་མཛད་པའོ།",
    "ངང་དང་རང་བཞིན་མི་འཐད་པ་སྒྲུབ་པའི་རིགས་པས་ལྟོས་པའི་ཕྱིར་ཕན་ཚུན་རྒྱུ་དང་འབྲས་བུར་གནས་སྐབས་ཀྱིས་གསུངས་ཏེ།",
    "དེ་ཉིད་ཅིར་ཡང་རང་སྣང་བས་དོན་བྱེད་པ་ནི་ཡབ་ཐབས་ཀྱི་ངོ་བོ་ཉིད་དོ།",
    "སུ་ཞིག་དུས་གསུམ་གང་ནས་ཚོལ།",
    "རང་བྱུང་ཡེ་ཤེས་གཏིང་ཕྱིན་པར་མཇལ་བས་འགྲོ་ཉལ་འདུག་སྡོད་ལོངས་སྤྱོད་དུ་སྤྱོད་པ་རིལ་ལ་སྤྱད་ཀྱང་གོལ་བ་མེད་དེ་ཡང་དག་པའི་མཛད་སྤྱོད་ཉིད་དུ་སྨིན་ཟིན་ཏོ།",
    "སྐྱེ་བ་མེད་ཅིང་འགག་མེད་གཡུང་དྲང་རང་བཞིན་གནས།",
    "འོན་ཏེ་ན་འདི་ནི་དལ་བ་སྟེན་ཅིང་རང་ཉམ་དུ་འདུག་གོ་ཞེ་ན།",
    "སྒྲ་སྣ་ཚོགས་ཀྱང་རང་རིག་པའི་ཡེ་ཤེས་རང་སྣང་བའོ།",
    "གང་རང་བཞིན་དང་རྐྱེན་ཀྱིས་ནོར་བ་དང་མ་ནོར་བ་རིལ་ཡང་།",
    "ཡང་དག་པ་ཉིད་མ་ལོག་པ་ཞིག་དུ་ཡང་རང་རྒྱུད་དུ་མེད་དེ་གདོད་ནས་གཉིས་དང་བྲལ་བའོ།",
    "ངང་དང་རང་བཞིན་དང་བདག་ཉིད་ཆེན་པོའི་གཏན་ཚིགས་དང་།",
    "བདེར་འདུག་རིགས་པ་མ་ཡིན་ཕྱིར།",
    "གང་ཐམས་ཅད་ཀྱི་གཞི་དང་རང་བཞིན་ནི།",
    "བློ་ཡང་རབ་ཏུ་གྱུར་པ་རྣམས་དོན་དང་མཐུན་པར་འདུག་པ་ནི་གནས་པ་ཞེས་བྱའོ།",
    "དེའང་རང་བཞིན་ལ་ཅིར་ཡང་དམིགས་སུ་མེད་པའི་ཀློང་ནས་ཤར་བས།",
    "སྐྱེ་བ་མེད་ཅིང་འགག་མེད་གཡུང་དྲུང་རང་བཞིན་གནས།",
    "རང་རིག་ངོ་བོ་བསྟན་ཅིང་ཅིར་ཡང་རང་སྣང་བས།",
    "ཤེས་རབ་གྱི་བློ་ཤིན་ཏུ་མ་སྦྱངས་པ་གང་ཞིག་དུས་ཀྱིས་མནར་བའི་སྐྱེ་བོ་ལྔ་བརྒྱ་ཐ་མ་པ་ལ་སྐྱེས་པ་དག།",
    "གནས་ལ་མཐོ་དམན་འདུག་པར་ཁྱེད་ཀྱི་མཐོང་ངམ་ཅི།",
    "ཡོ་གས་གཞན་ལྟ་ཉམས་པར་བྱེད་ཅིང་རང་འདོད་མེད།",
    "རྣལ་དུ་ཕབ་པ་ཉིད་ལས་ང་རང་ཡིན།",
    "ལྔ་པ་རྫོགས་པ་ཆེན་པོ་ལ་འདོད་རྒྱལ་གྱིས་ངེས་པར་གྲོལ་ཞིང་རང་ལྟའི་ཚིག་ཙམ་དུ་གཏན་ལ་དབབ་པར་བསྟན་པའོ།",
    "རི་དྭགས་འདུག་པའི་སྟངས་སྟབས་ཀྱིས།",
    "རང་རང་གནས་ནས་དབྱུག་པས་དབྱུང་།",
    "སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ་དང་།",
    "རྨི་ལམ་ལ་ཡང་རང་བཞིན་མེད།",
    "འདི་གཉིས་ཁྱད་པར་མི་འདུག་སྙམ།",
    "གཡོན་པར་འཁོར་ལོ་བྲིས་པའང་འདུག།",
    "ཐར་བ་དོན་གཉེར་གྱི་བསམ་པ་མེད་པའི་སྒོ་ནས་རང་ཉིད་ཀྱི་འཚོ་བ་ཅུང་བཟང་བའི་ཆེད་དུ་ཡིན་འདུག་དེ་ལྟ་བུའི་དམིགས་ཡུལ་ཙམ་གྱི་ཆེད་ཡིན་འདུག་དེས་ན་དམིགས་ཡུལ་དེ་ལྟ་བུ་འགྲུབ་བམ་སྙམ་ན།",
    "ཐབས་སྣ་ཚོགས་སྤྱད་ནས་དེ་རུ་འདུག་པར་བྱེད།",
    "མི་ཞིག་གནམ་གྲུར་འདུག་པ་ལ་གནམ་གྲུའི་འཛིན་བྱང་དགོས་ལ།",
    "སྔོན་འགྲོ་ལྔ་ཉམས་སུ་ལེན་དུས་རླངས་འཁོར་དུ་འདུག་པ་དང་།",
    "རང་ཉིད་ཀྱི་དུས་ཚོད་དང་བསྟུན་ཏེ་སྒྲུབ་ཆོག་དུས་ཚོད་གཅིག་དང་ཕྱེད།",
    "སྔ་དྲོའི་དུས་ཚོད་བཅུ་ལྷག་ནས་ཐུན་ལ་འདུག་པར་བྱ།",
    "༢ ལུས་དྲང་བོར་འདུག་པ།",
    "༥ མགོ་བོ་ཅུང་དམའ་བར་འདུག་པ།",
    "ངས་ཉམས་ལེན་བྱས་པ་ཡག་པོ་འདུག་ང་ད་ལྟ་ནས་འདི་ལྟ་བུ་ལ་སླེབས་ནུས་ན།",
    "འདིས་ང་རང་ཁྱད་དུ་འཕགས་པ་མཚོན་མི་ནུས།",
    "དེ་ནས་རང་ཉིད་ཐུན་ལ་འཇུག་དུས་ཀྱི་སྔར་དམ་བཅའ་བྱས་པ་ནང་བཞིན་ཡོང་ཡོད་མེད་ལ་བརྟག་པ་དང་།",
    "འོན་ཀྱང་རང་ཉིད་དང་འཚམས་པའི་ཉམས་ལེན་གྱི་ཐབས་ལ་བརྩོན་ན་ཡང་འབྲས་བུ་ཐོབ་ངེས།",
    "གལ་ཏེ་བློ་ཐབས་མི་སྤྱད་ན་ཅུང་མི་འགོར་བར་ཡང་བསྐྱར་བཙོན་དུ་བཅུགས་ཏེ་དུས་ཡུན་རིང་པོར་འདུག་དགོས།",
    "མི་གྲངས་ཧ་ཅང་མང་པོ་ཡོད་པས་ཀུན་གྱི་བསམ་པར་མི་ལུས་ཐོབ་སླ་བོར་འདུག་སྙམ།",
    "ག་དུས་ཀྱང་རང་ཡལ་དུ་མི་འགྲོ་བས་ངེསཔ་མེད་ཅིང་མི་རྟག་པ་ཡིན།",
    "མི་སུ་ཡིན་ཡང་རང་ཉིད་ནམ་ཞིག་འཆི་དགོས་པ་ཤེས་ལ།",
    "ཁྱིམ་དུ་ལོག་དུས་ང་ཁྱིམ་དུ་ལོག་རྗེས་ཕྱི་རུ་འགྲོ་དུས་མེད་སྙམ་དགོས།",
    "གལ་ཏེ་མི་ཁོ་ནར་སྐྱེས་ཏེ་ད་ལྟ་ལྟ་བུ་ཡིན་ན་དཀའ་ལས་དེ་འདྲའི་ཆེན་པོ་མི་འདུག་སྙམ་ན།",
    "ལྷ་དེ་དག་དུས་ཡུན་རིང་བོའི་བར་དུ་གསོན་ཐུབ་ལ།",
    "ཁོ་རང་གཅིག་པུ་ཁེར་རྐྱང་དུ་ལྷག་ནས་འཆི་བར་སྒུག་དགོས།",
    "འདུག་གནས་ཐམས་ཅད་པོ་འདྲ་མཚུངས་ཡིན།",
    "ཁོས་བསོད་སྙོམས་བྱེད་དུས་གཞན་གྱིས་ཕུལ་བའི་ཟས་ལེགས་པོར་འདུག་ཀྱང་།",
    "སེམས་དད་ལྷོད་པོ་བྱས་ཏེ་དེའི་ངང་དུ་འདུག་གལ་ཏེ་གོང་ནས་བསྒྲུབས་པ་ཕུན་སུམ་ཚོགས་པ་ཡིན་པ་དང་།",
    "མི་ཁ་ཤས་ཀྱི་བསམ་པར་གལ་ཏེ་སྒེར་སེམས་དང་རང་དོན་རྩ་བ་ནས་མེད་པར་བྱས་ན།",
    "ང་རང་དགྲ་ལ་སྡང་བ་དང་།",
    "སྒེར་སེམས་དང་རང་དོན་དོར་ནས་ཕྱོགས་ཞེན་མེད་པའི་སེམས་ཀྱིས་གཞན་ལ་ཕན་འདོགས་པ་ནི་དཀའ་ངལ་ཆེ་བའི་ལས་ཡིན་ཡང་།",
    "སྒེར་སེམས་དང་རང་དོན་དོར་དགོས།",
    "དེའི་ཕྱིར་ན་གཉིས་པ་སྒེར་སེམས་དང་རང་དོན་དོར་བར་བྱ།",
    "གཉིས་པ་སྒེར་སེམས་དང་རང་དོན་དོར་བར་བྱ།",
    "ཕྱིའི་སྔོན་འགྲོའི་དལ་འབྱོར་རྙེད་དཀའ་སོགས་རིམ་གྱིས་ཉམས་སུ་བླངས་རྗེས་ལྟ་ཚུལ་གང་འདྲ་འདུག་གལ་ཏེ་སྔོན་རྗེས་གཉིས་ཁྱད་པར་མེད་ན།",
    "རང་གཅིག་པུ་ཐར་བའི་ཆེད་དང་རང་གཅིག་པུ་ནུབ་ཕྱོགས་བདེ་བ་ཅན་སོགས་སུ་སྐྱེ་ཕྱིར་ཡིན་ན།",
    "སྒེར་སེམས་དང་རང་དོན་སྤང་བར་བྱ།",
    "གདན་མཐོན་པོར་འདུག་པ་སོགས་བྱེད་ན་ལེགས།",
    "འདུག་སྟེགས་ཧ་ཅང་དམའ་བ་སོགས་ཡིན་ན་སྒོམ་བྱེད་དུས་གསལ་བོར་ཤར་ཁག་པོ་ཡོད།",
    "ལས་ངན་པ་བསྒྲུབས་པར་བྱས་པ་དག་དུས་ཡུན་ཇི་ལྟར་འགོར་ན་དེ་ཤེས་རབ་སྒྲོན་མེའི་འོད་སྣང་།",
    "ཆུ་ལྡུག་དུས་ཧ་ཅང་མང་མི་དགོས་ལ་ཉུང་ཡང་མི་དགོས།",
    "མནྜལ་གསོག་དུས་ལག་པ་གཡོན་གྱིས་མནྜལ་བཟུང་།",
    "ཐར་བ་ཐོབ་བྱེད་ཀྱི་ཐབས་རྙེད་ནས་བཟུང་རང་ལ་རག་ལས་པས་ཀུན་གྱིས་ཉམས་ལེན་ལེགས་པོ་བྱེད་རྒྱུ་གལ།",
    "འཇིག་རྟེན་གྱི་འབྱོར་བ་མི་བསམ་པ་དང་རང་ཉིད་གཅིག་པུའི་ཐར་བ་མི་བསམ་པར།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "སེམས་ནཱ་དར་གཏད་ནས་ཅུང་འདུགམཐར་ནཱ་ད་ཡང་ནམ་མཁར་འཇའ་ཚོན་ཡལ་བ་ལྟར་མི་དམིགས་སྤྲོས་པ་དང་བྲལ་བའི་ངང་ལ་དར་ཅིག་ལྷོད་དེ་མཉམ་པར་བཞག་དེ་ནས་ཡང་རྣམ་རྟོག་ཅིག་འཆར་བར་རྩོམ་པ་ན།",
    "སུ་གང་ཡིན་ཡང་རང་གཞན་གཉིས་ཚོགས་རྫོགས་ཕྱིར་དང་།",
    "སྔོན་འགྲོ་ཉམས་སུ་ལེན་སྐབས་སུ་མནྜལ་གྱི་གྲངས་གསོག་དུས།",
    "འདུག་དུས་སྤྱི་གཙུག་ཏུ་བསྒོམ།",
    "འོན་ཀྱང་དེ་ནི་བསྒྱུར་ཉེས་བྱས་འདུག་པས།",
    "འོན་ཀྱང་དེ་ནོར་འདུག་པས་ཀུན་གྱིས་མཁྱེན་པར་མཛོད།",
    "དེར་གྲོས་བགྲོས་པས་འདི་རྫུ་འཕྲུལ་དང་ལྡན་པར་འདུག་པས་ཡེར་པའི་ལྷ་ལུང་དཔལ་རྡོར་ཡིན་ངེས་ཟེར་ནས་བལྟ་བར་བྱས།",
    "དེ་ནས་ལོག་སྟེ་མི་ནག་རྟ་སན་གས་༣ མ་བསྟན་ནས་བཞུགས་འདུག་པ་ལ་མད་འ་སྔ་བསར་གཅིག་དང་ཕྱི་བསར་གཅིག་སྔགས་པ་མཐུ་བྲུབས་པ་ཡིན་ནམ་ཡང་ཟེར།",
    "རྟེན་ཕྱག་གཉིས་པ་བྱེད་ཙ་ན་མདའ་ལྟོང་ཁ་སྦྱར།",
    "རྒྱུན་ས་ན་པ་ཙ་ན་འདྲོངས་པས།",
