    "འདི་ལྟར་ཕྱི་རོལ་གྱི་སྔོན་པོ་ལ་སོགས་པའི་དོན་མེད་པའི་སྟོབས་ཀྱིས་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་ཕུང་པོ་གཟུགས་ཅན་མ་ཡིན་པ་དེ་དག་ཉིད་སྔོན་པོ་ལ་སོགས་པའི་ངོ་བོར་ཁས་བླང་དགོས་སོ།",
    "དེ་བས་ན་སྔོན་པོ་ལ་སོགས་པ་སྣ་ཚོགས་ཀྱི་རྣམ་པར་སྣང་བའི་ཕྱིར་དང་།",
    "གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་སྣང་བའི་ཕྱིར་ངོ་བོ་ཉིད་གཅིག་ཏུ་མི་རུང་སྟེ།",
    "ཇི་སྟེ་གཟུགས་ལ་སོགས་པའི་རྣམ་པ་འདི་དག་བརྫུན་པ་ཉིད་དུ་སྣང་བར་ཁས་ལེན་ན་རྣམ་པར་ཤེས་པའང་མི་བདེན་པར་འགྱུར་ཏེ།",
    "རྣམ་པར་ཤེས་པ་དེའི་ངོ་བོ་ཉིད་དང་ཐ་དད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "བདག་ཉིད་རྟོགས་པའི་ངོ་བོ་ལས་གུད་ན་རྣམ་པར་ཤེས་པའི་ངོ་བོ་མེད་ལ།",
    "རྣམ་པར་ཤེས་པ་ནི་སྒྱུ་མ་དང་འདྲའོ་ཞེས་བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་བཀའ་སྩལ་ཏོ།",
    "དེ་ལྟ་བས་ན་གཅིག་དང་དུ་མའི་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པའི་ཕྱིར་དངོས་པོ་འདི་དག་ཐམས་ཅད་དོན་དམ་པར་བདེན་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ངེས་སོ།",
    "གཅིག་དང་གཞན་རྣམས་རྣམ་སྤངས་པར།",
    "བློ་ཡིས་རྣམ་པར་གཞིགས་ན་གོ།",
    "ངོ་བོ་ཉིད་ཀྱང་མེད་པར་བཤད།",
    "དེ་ལྟར་བསམས་པའི་ཤེས་རབ་ཀྱིས་ཡང་དག་པའི་དོན་བྱེ་བྲག་ཕྱེད་པར་བྱས་ལ་དེ་མངོན་སུམ་བྱ་བའི་ཕྱིར་བསྒོམས་པའི་ཤེས་རབ་བསྐྱེད་དོ།",
    "དེ་ལྟར་བསྒོམས་པའི་འབྲས་བུ་ནི་ཡོངས་སུ་གསལ་བའི་ཤེས་པ་ཡིན་པས་འབྲས་བུ་དང་བཅས་པའི་དོན་ཡིན་པར་བཅོམ་ལྡན་འདས་ཀྱིས་ཏིང་ངེ་འཛིན་གྱིས་རྒྱལ་པོ་ལས་བཀའ་སྩལ་ཏེ།",
    "དེ་ལ་གནས་པའི་རྣམ་པར་རྟོག་པ་དེས།",
    "སེམས་ནི་ཆུ་བཞིན་དུ་གཡོ་བའི་ཕྱིར་ཞི་གནས་ཀྱི་གཞི་མེད་པར་གནས་པ་མེད་དོ།",
    "མཉམ་པར་མ་བཞག་པའི་སེམས་ཀྱིས་ནི་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པར་མི་ནུས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་མཉམ་པར་བཞག་པས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་སོ་ཞེས་བཀའ་སྩལ་ཏོ།",
    "དེ་བས་ན་འཕགས་པ་དགོངས་པ་ངེས་པར་འགྲེལ་པ་ལ་སོགས་པ་ལས་ཀྱང་སྦྱིན་པ་ལ་སོགས་པ་གོང་མའི་ཡང་གོང་མའི་རྒྱུ་ཉིད་ཡིན་པར་བསྟན་ཏོ།",
    "དེ་ཡང་དངོས་པོ་ལ་སྒྲོ་འདོགས་པ་དང་སྐུར་པ་སྤང་བའི་ཕྱིར་ཕུང་པོ་དང་ཁམས་ལ་སོགས་པར་བསྡུས་པའི་སྒོ་ནས་བགྲང་ངོ།",
    "དེ་ནས་དངོས་པོ་ཐམས་ཅད་བསྡུས་པའི་བྱེ་བྲག་ཕྱེད་ནས་དེ་ཉིད་ལ་སེམས་ཡང་དང་ཡང་རྒྱུན་དུ་འཇུག་པར་བྱའོ།",
    "གལ་ཏེ་མཉམ་པར་འཇུག་པ་ལ་རྩོལ་བ་བྱས་ན་སེམས་རྣམ་པར་གཡེང་བར་འགྱུར་རོ།",
    "རྣམ་པར་ཞི་བར་བྱེད་དོ།",
    "མཉམ་པར་འཇོག་གོ་ཞེས་ཚིག་དགུ་སྨོས་སོ།",
    "བླན་ཏེ་འཇོག་ཅེས་བྱ་བ་ནི་རྣམ་པར་གཡེང་བ་ཤེས་ནས་དེ་སྤོང་བའོ།",
    "ཉེ་བར་འཇོག་ཅེས་བྱ་བ་ནི་རྣམ་པར་གཡེང་བ་སྤངས་ནས་ཕྱི་ཕྱིར་བརྟུན་ཏེ་དམིགས་པ་དེ་ཉིད་ལ་འཇོག་པའོ།",
    "ཞི་བར་བྱེད་དོ་ཞེས་བྱ་བ་ནི་རྣམ་པར་གཡེང་བའི་ཉེས་པ་མཐོང་ནས་མི་དགའ་བར་རབ་ཏུ་ཞི་བར་བྱེད་དོ།",
    "རྣམ་པར་ཞི་བར་བྱེད་པ་ནི་རྨུགས་པ་དང་གཉིད་ལ་སོགས་པ་ལངས་པ་རྣམས་སེལ་བའོ།",
    "མཉམ་པར་འཇོག་ཅེས་བྱ་བ་ནི་སེམས་མཉམ་པར་གྱུར་པ་ན་བཏང་སྙོམས་སུ་བྱེད་པ་སྟེ།",
    "མཉམ་པར་འཛིན་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ནས་ལུས་དང་སེམས་ཤིན་ཏུ་སྦྱངས་པར་གྱུར་པས་ལེ་ལོ་ལྡོག་སྟེ།",
    "དེས་བྱིང་བ་དང་རྒོད་པ་ཡང་དག་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "དེས་རྫུ་འཕྲུལ་ལ་སོགས་པ་ཡོན་ཏན་རྣམས་སྒྲུབ་པར་བྱེད་དོ།",
    "སེམས་རྩེ་གཅིག་པ་དེ་ཕྱི་ཕྱིར་ལས་སུ་རུང་བ་ཉིད་དང་ལྡན་ཞིང་དམིགས་པ་ལ་སོགས་པའི་ཡོན་ཏན་གྱི་ཁྱད་པར་ཐོབ་པས་བསམ་གཏན་དང་།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དང་།",
    "དཔྱོད་པ་དང་བཅས་པར་གྱུར་པ་དེའི་ཚེ་མི་ལྕོགས་པ་མེད་པ་ཞེས་བྱ་སྟེ།",
    "བདེ་བ་དང་ལྡན་པར་གྱུར་པ་དེའི་ཚེ་བསམ་གཏན་དང་པོ་ཞེས་བྱའོ།",
    "བསམ་གཏན་དང་པོ་དེ་ཉིད་ལས་རྟོག་པ་ཙམ་མེད་པ་དེ་ནི་བསམ་གཏན་ཁྱད་པར་ཅན་ཞེས་བྱའོ།",
    "ནང་ཡོངས་སུ་དང་བ་དག་དང་ལྡན་པར་གྱུར་པ་དེའི་ཚེ་བསམ་གཏན་གཉིས་པ་ཞེས་བྱའོ།",
    "ཤེས་བཞིན་དག་དང་ལྡན་པར་གྱུར་པ་དེའི་ཚེ་བསམ་གཏན་གསུམ་པ་ཞེས་བྱའོ།",
    "དྲན་པ་དག་དང་ལྡན་པར་གྱུར་པ་དེའི་ཚེ་བསམ་གཏན་བཞི་པ་ཞེས་བྱའོ།",
    "དེ་བཞིན་དུ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དང་།",
    "དེ་ལྟར་དམིགས་པ་དེ་ལ་སེམས་བརྟན་པར་བྱས་ནས་ཤེས་རབ་ཀྱིས་རྣམ་པར་དཔྱད་པར་བྱ་སྟེ།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "འོན་ཏེ་རྣམ་པར་ཤེས་པ་དེ་ཉིད་དེ་ལྟར་སྣང་སྟེ།",
    "རྨི་ལམ་གྱི་གནས་སྐབས་ཇི་ལྟ་བ་བཞིན་ནམ་ཞེས་དཔྱད་པར་བྱའོ།",
    "དེ་ལ་རྣམ་པར་ཤེས་པ་ལས་ཕྱི་རོལ་པ་རྡུལ་ཕྲ་རབ་ཏུ་བཤིག་སྟེ།",
    "དམིགས་སུ་རུང་བའི་མཚན་ཉིད་དུ་གྱུར་པ་དེ་དག་རྣམ་པར་དཔྱད་ན་མི་དམིགས་པའི་ཕྱིར་རོ།",
    "དེ་ལ་སེམས་ཙམ་གང་ཡིན་པ་དེ་ཡང་གཟུང་བ་མེད་ན་འཛིན་པར་མི་རུང་སྟེ།",
    "དེ་ལྟ་བས་ན་སེམས་ནི་གཟུང་བ་དང་འཛིན་པ་ལས་དབེན་ཞིང་གཉིས་སུ་མེད་པ་ཁོ་ན་ཡིན་པར་རྣམ་པར་དཔྱད་ནས་གཉིས་སུ་མེད་པའི་མཚན་ཉིད།",
    "གཉིས་སུ་སྣང་བ་མེད་པ་གཉིས་མེད་པའི་ཤེས་པ་ལ་གནས་པར་བྱ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གཉིས་མེད་པའི་ཤེས་པ་སྣང་བ་མེད་པའི་ཤེས་པ་ཁོ་ན་ལ་གནས་པར་བྱ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལ་གནས་པས་ཡང་དག་པ་ཉིད་ཀྱི་མཆོག་ལ་ཞུགས་པས་རྣམ་པར་མི་རྟོག་པའི་ཏིང་ངེ་འཛིན་ལ་ཞུགས་པ་ཡིན་ནོ།",
    "རྣམ་པར་མི་རྟོག་པ་ལ་འཇུག་པའི་གཟུངས་ལས་ཡིད་ལ་མི་བྱེད་པས་གཟུགས་ལ་སོགས་པའི་མཚན་མ་སྤོང་ངོ་ཞེས་གསུངས་པ་གང་ཡིན་པ་དེ་ཡང་ཤེས་རབ་ཀྱིས་བརྟགས་ན་མི་དམིགས་པ་གང་ཡིན་པ་དེ།",
    "དེར་ཡིད་ལ་མི་བྱེད་པར་དགོངས་ཀྱིས།",
    "མེ་མ་སྤངས་པར་ཚ་བ་སྤང་དུ་མི་རུང་བ་བཞིན་ནོ།",
    "འདི་ལྟར་གཟུགས་ལསོགས་པ་རྣམ་པར་རྟོག་པ་འདི་དག་ཚེར་མ་ལ་སོགས་པ་བཞིན་དུ་སེམས་ལས་ལག་པས་དབྱུང་ཞིང་བསལ་དུ་མི་རུང་སྟེ།",
    "དེའི་ཚེ་ཐེ་ཚོམ་གྱི་ས་བོན་དང་བྲལ་བས་གཟུགས་ལ་སོགས་པའི་མཚན་མ་ཡིད་ལ་བྱེད་པ་སྤོང་ནུས་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་བྱས་ན་རྩ་བ་ནས་ཕྱུང་བའི་ཤིང་དག་ས་ལས་མི་སྐྱེ་བ་བཞིན་དུ་རྩ་བ་མེད་པས་ན་ལོག་པར་རྣམ་པར་རྟོག་པའི་སེམས་ཀྱང་སྐྱེ་བར་མི་འགྱུར་རོ།",
    "དེ་བས་ན་སྒྲིབ་པ་སྤོང་བའི་ཕྱིར་ཞི་གནས་དང་ལྷག་མཐོང་ཟུང་དུ་འབྲེལ་པར་འཇུག་པའི་ལམ་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་ཏེ།",
    "དེ་གཉིས་ནི་ཡང་དག་པའི་ཡེ་ཤེས་རྣམ་པར་མི་རྟོག་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཤེས་རབ་ཀྱིས་ནི་ཡེ་ཤེས་རྣམ་པར་དག་པ་འཐོབ།",
    "དེ་ནི་མཉམ་པར་བཞག་ན་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ་ཞེས་བཀའ་སྩལ་པའི་ཕྱིར་དེ་ཤེས་རབ་དང་ཤིན་ཏུ་མཐུན་པ་ཡིན་གྱི།",
    "ཞི་བ་ནི་ཡོད་པ་དང་མེད་པ་ལ་སོགས་པ་རྣམ་པར་རྟོག་པའི་མཚན་ཉིད་ཀྱི་སྤྲོས་པ་ཐམས་ཅད་ཉེ་བར་ཞི་བའི་ཕྱིར་རོ།",
    "དངོས་པོ་མེད་པ་རྣམ་པར་རྟོག་པ་ཡང་དེ་ལ་མེད་པ་ཉིད་དོ།",
    "གལ་ཏེ་བརྒྱ་ལ་དངོས་པོ་འགའ་ཞིག་མཐོང་བར་གྱུར་ན་ནི་དེ་ལྟ་ན་ནི་བཀག་པས་དངོས་པོ་མེད་པར་རྣམ་པར་རྟོག་པ་འབྱུང་ངོ།",
    "ཡོད་པ་དང་མེད་པ་རྣམ་པར་རྟོག་པ་གཉིས་ཀྱིས་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ལ་ཁྱབ་པའི་ཕྱིར་ཏེ།",
    "ཁྱབ་པར་བྱེད་པ་མེད་པས་ཁྱབ་པར་བྱ་བ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ནི་རྣམ་པར་མི་རྟོག་པའི་རྣལ་འབྱོར་དམ་པ་ཡིན་ཏེ།",
    "དེ་ལ་གནས་པའི་རྣལ་འབྱོར་པ་ནི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ནུབ་པས།",
    "ཇི་སྐད་དུ་ཡང་འཕགས་པ་བདེན་པ་གཉིས་བསྟན་པ་ལས་གསུངས་ཏེ།",
    "དོན་དམ་པར་ཤིན་ཏུ་མ་སྐྱེས་པ་དང་།",
    "རྣམ་པར་རྟོག་པའོ།",
    "རྣམ་པར་རྟོག་པ་དེ་ལས་ཚུལ་བཞིན་མ་ཡིན་པ་ཉིད་ཡིད་ལ་བྱེད་པའོ།",
    "དངོས་པོ་མེད་པར་རབ་ཏུ་ཤེས་པ་གང་ཡིན་པ་དེ་དོན་དམ་པར་ཕྱིན་ཅི་མ་ལོག་པའོ།",
    "གང་དོན་དམ་པར་ཕྱིན་ཅི་མ་ལོག་པ་དེ་མི་རྟོག།",
    "རྣམ་པར་མི་རྟོག་གོ།",
    "གང་མི་རྟོག་རྣམ་པར་མི་རྟོག་པ་དེ་ཚུལ་བཞིན་ལ་ཞུགས་པའོ།",
    "གང་ཚུལ་བཞིན་ལ་ཞུགས་པ་དེ་བདག་ཏུ་སྒྲོ་འདོགས་པར་མི་འགྱུར་རོ།",
    "གང་བདག་ཏུ་སྒྲོ་འདོགས་པར་མི་འགྱུར་བ་དེ་ལྟ་བ་ཀུན་ནས་ལྡང་བར་མི་འགྱུར་ཏེ།",
    "ལྷའི་བུ་དོན་དམ་པར་ཤིན་ཏུ་མ་སྐྱེས་པ་དང་།",
    "དངོས་པོ་ལ་སོགས་པར་ཕྱིན་ཅི་ལོག་པས་ཕྱིན་ཅི་ལོག་པ་མཐའ་དག་ལ་ཁྱབ་པའི་ཕྱིར།",
    "དེ་སྤངས་ན་ཕྱིན་ཅི་ལོག་ཐམས་ཅད་སྤོང་བར་འགྱུར་བའི་ཕྱིར་ཤེས་བྱའི་སྒྲིབ་པ་ཡང་འདིས་ཡང་དག་པར་སྤོང་བར་འགྱུར་ཏེ།",
    "ཤེས་བྱའི་སྒྲིབ་པ་སྤངས་ན་གགས་མེད་པའི་ཕྱིར་ཉི་མའི་འོད་སྤྲིན་དང་བྲལ་བའི་ནམ་མཁའ་ལ་ཐམས་ཅད་དུ་ཐོགས་པ་མེད་པར་སྣང་བ་བཞིན་དུ་ཡེ་ཤེས་ཀྱི་སྣང་བ་འབྱུང་ངོ།",
    "འདི་ལྟར་རྣམ་པར་ཤེས་པ་ནི་དངོས་པོའི་ངོ་བོ་ཉིད་རྟོགས་པ་ཡིན་ན།",
    "གགས་མེད་པར་གྱུར་ན་ནི་མཐུའི་ཁྱད་པར་བསམ་གྱིས་མི་ཁྱབ་པ་ཐོབ་པས་ཅིའི་ཕྱིར་དངོས་པོ་མཐའ་དག་ཇི་ལྟ་བ་བཞིན་དུ་གསལ་བར་མི་འགྱུར།",
    "དེ་བས་ན་ཀུན་རྫོབ་དང་དོན་དམ་པའི་ཚུལ་གྱིས་དངོས་པོ་མཐའ་དག་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པས་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཐོབ་བོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཐོབ་པར་འགྱུར་བའི་ལམ་གྱི་མཆོག་ཡིན་ནོ།",
    "ཉན་ཐོས་ལ་སོགས་པའི་ལམ་གང་ཡིན་པ་དེས་ནི་ཕྱིན་ཅི་ལོག་ཐམས་ཅད་སྤོང་བར་མི་འགྱུར་བའི་ཕྱིར་སྒྲིབ་པ་གཉིས་ལེགས་པར་མ་སྤོངས་སོ།",
    "བློ་གྲོས་ཆེན་པོ་འདི་ལ་ལྟ་བ་ངན་པ་ལས་བཟློག་པའི་ཕྱིར་བརྩོན་པར་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "ཉན་ཐོས་ལ་སོགས་པའི་ལམ་བསྟན་པ་ལས་ནི་གཞུག་པ་ལ་ལྡེམ་པོར་དགོངས་ནས་ཁྱེའུས་ཁྱེའུ་དབྱུང་བ་བཞིན་དུ་བསྟན་པར་ཟད་དོ།",
    "བདག་མེད་པར་བསྒོམས་ནས་ཉན་ཐོས་གང་ཟག་བདག་མེད་པ་ལ་འཇུག་གོ།",
