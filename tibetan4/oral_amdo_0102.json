    "ལུས་ཀྱི་གསུམ་དང་ངག་གི་བཞི་དང་ཡིད་ཀྱི་གསུམ་རྣམས་ནི་བཅུའོ།",
    "བྱེད་མེད་ཡིད་ཀྱང་གང་གིས་ནི།",
    "དེ་བསྐྱེད་ལུས་དང་ངག་གི་ལས།",
    "དེའི་ཚེ་ཡང་དེ་དག་གི་བརྡར་བཏགས་པར་ཤེས་པས་དཔྱོད་ཀྱི་དངོས་པོར་འཛིན་པའི་ཚུལ་གྱིས་ནི་མ་ཡིན་པ་ལ་འགོད་དོ།",
    "ཞེས་བསྟན་པའི་ཆགས་པ་ཕྲ་མོ་ཡང་ས་འདི་ལས་བརྩམས་ནས་ནི་བྲལ་ཏེ།",
    "དེ་ལྟ་བུའི་ས་བཅུའི་བདག་ཉིད་ཀྱི་མཐའི་བྱ་བ་ནི་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་ལ་སོགས་པ་གསུངས་ཏེ་གོ་སླའོ།",
    "བསྐལ་པ་མང་པོ་ཞིག་ཏུ་དཀའ་བ་བྱས་ནས་རང་གི་ཡེ་ཤེས་རྒྱུན་གཅོད་པ་ནི་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡང་ལམ་དེ་ལ་གནས་པ་ནི་བདག་གི་སློབ་པའི་ས་འདི་ཡོངས་སུ་སྤངས་ཏེ།",
    "ཁྱོད་ཀྱི་ཕྲིན་ལས་ཇི་སྙེད་པ།",
    "དེ་དག་གི་ལས་དེ་ལྟར་བསྟན་པས་ཞེས་བྱ་བ་ནི་རང་རང་གི་གནས་སྐབས་ཀྱི་བྱ་བ་དང་ཡོན་ཏན་དང་རང་བཞིན་བསྟན་པའོ།",
    "དེ་ལྟར་ན་སློབ་དཔོན་གྱི་ཞལ་སྔ་ནས་ཅིའི་ཕྱིར་འགྲེལ་པར་དེ་ལྟར་མི་སྟོན་སྙམ་པ་ལ་ཚིག་མང་དུ་དོགས་པས་བདག་གིས་མ་བྲིས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གལ་ཏེ་ངག་རེ་རེ་ལ་སྐབས་ཀྱི་དོན་མཐའ་དག་བཀོད་ན།",
    "དེའི་ཚེ་ཡུམ་འདིས་གདུལ་བྱ་ཕལ་ཆེར་ཁམས་རབ་ཏུ་འཁྲུག་པར་བྱེད་པ་ཉི་ཚེ་བ་ཞིག་གི་ཡན་ལག་ཏུ་འགྱུར་བའི་ཕྱིར་མ་བཀོད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེའི་ཕྱིར་བདག་གིས་ཀྱང་འདིར་དཔྱད་པ་མ་བྱས་སོ།",
    "ཚིག་གི་དོན་ཡང་གོ་བར་སླའོ།",
    "དོན་རྒྱ་ཆེན་པོ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་དུས་ན་ཚིག་གི་ཚོགས་རབ་ཏུ་མང་པོ་བསྟན་པ་ནི་དོན་དེ་ཁོང་དུ་ཆུད་པའི་བར་ཆད་དུ་འགྱུར་བར་སྣང་སྟེ།",
    "དེ་དག་ལས་གནང་བ་མནོས་ཤིང་མན་ངག་གི་ཆ་གནང་ནས་འདི་བྱས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མི་གསལ་ཞིང་ཞེས་བྱ་བ་ནི་རྗེས་སུ་དཔག་པ་ལས་མཇུག་གི་མངོན་སུམ་དུ་ཡུམ་འདིའི་དོན་མ་གྱུར་པར་སྟོན་པ་སྟེ།",
    "དེ་དག་ཀྱང་གང་གི་ནུབ་མོ་ལ་དགྲ་བཅོམ་པ་དེས་པ་དང་།",
    "ཚེའི་དུས་བྱས་པ་དེའི་ནུབ་མོ་ནུབ་པས།",
    "འཕགས་པའི་སྐྱེ་བོ་འཕགས་པ་རྣམ་པར་གྲོལ་བ་ལ་སོགས་པ་དེ་དག་གི་སྤྱོད་ཡུལ་ཡིན་ནོ།",
    "གཞུང་མཆོག་ཚིག་གི་ཆུ་གཏེར་འདི་ལ་འབད་པས་རྒལ་བར་བསམས་པ་དང་།",
    "གང་གིས་གཏིང་ནི་རབ་ཏུ་རྙེད་པར་དཀའ་བས་རབ་ཟབ་ཅེས་བརྗོད་པ།",
    "དེ་ཡི་གཏིང་ཡང་བདག་གིས་དམན་པའི་བློ་ཡིས་བཙལ་བས་འབད་པ་ཡིན།",
    "དཔེར་ན་རིན་ཆེན་མང་པོས་གང་བའི་གླིང་དུ་སོང་བའི་བློ་ཉམས་པའི།",
    "རྣོན་པོ་ལ་ནི་དྲུག་གིས་མཆོག་གོ།",
    "ཁྱད་པར་གྱི་གནས་སྐབས་སུ་རྫོགས་པས་ན་ལམ་དེ་དག་གི་རང་བཞིན་དུ་བརྗོད་དོ།",
    "དོན་བརྒྱད་པོ་དེ་ཡང་རེ་རེ་ནས་བསྟན་པའི་ཕྱིར་དང་པོ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་དོན་བཅུས་བསྟན་ཏོ།",
    "གདམས་ངག་གི་སྒོ་ནས་སེམས་བསྐྱེད་པ་ཅི་ལྟར་འཕེལ་ཞེ་ན།",
    "མཉམ་པར་གྱུར་པའི་གནས་སྐབས་ན་ནི་རྩེ་མོ་ཞེས་བྱའོ།",
    "དེ་ལ་ཟག་པ་དང་བཅས་པ་ནི་སྦྱོར་བ་དང་དངོས་དང་མཇུག་གི་བྱེ་བྲག་གིས་མོས་པ་དང་བསྔོ་བ་དང་རྗེས་སུ་ཡི་རང་བ་གསུམ་ཡིན་ལ།",
    "བསྟོད་པ་དང་བཀུར་བ་དང་བསྔགས་པ་ནི་མོས་པ་རང་དང་གཞན་དང་གཉི་གའི་བྱེ་བྲག་གིས་རྣམ་པ་གསུམ་ལ་གསུམ་དུ་ཡིན་པས་མོས་པ་ནི་གནས་སྐབས་ལོགས་ཤིག་ཏུ་མ་སྨོས་སོ།",
    "ཅི་ལྟར་མོས་པ་རེ་རེ་ལ་ཆུང་ངུ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་རྣམ་པ་ཉི་ཤུ་རྩ་བདུན་དུ་འགྱུར་བ་དེ་བཞིན་དུ་མོས་པ་དགུ་ཚན་གསུམ་ལ་བསྟོད་པ་དང་བཀུར་བ་དང་བསྔགས་པ་དང་།",
    "ལྔ་པོ་དེ་དང་དེ་དག་ཉིད་ས་གང་དང་གང་གིས་བསྡུས་ཤེ་ན།",
    "མོས་པ་ནི་ས་གཉིས་པ་དང་གསུམ་པ་དང་བཞི་པས་བསྡུས་སོ།",
    "ཅིའི་ཕྱིར་མོས་པ་རྣམ་པ་གསུམ་ཞེ་ན།",
    "མོས་པ་དང་བསྔོ་བ་དང་རྗེས་སུ་ཡི་རང་བ་ནི་ལས་དང་པོ་པའི་གནས་སྐབས་ན་ཡང་ཡོད་པ་མ་ཡིན་ནམ།",
    "སྒྲུབ་པ་ཉམས་སུ་ལེན་པའི་བྱེ་བྲག་གིས་ཚོལ་བའི་སྦྱོར་བ་དང་།",
    "བཅུ་ནི་རྩེ་མོས་བསྡུས་སོ།",
    "ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོའི་བྱེ་བྲག་གིས་འདི་དང་འོག་མ་གཉིས་ཏེ་གསུམ་ཀ་ལ་བསྟན་ཏོ།",
    "དེ་ལ་དང་པོར་རྩེ་མོར་ཕྱིན་པའི་རྟགས་བསྟན།",
    "འདི་ནི་རྩེ་མོའི་ངེས་འབྱེད་དོ།",
    "དེ་ལ་འཇུག་པའི་ཕྱོགས་དང་ལྡོག་པའི་ཕྱོགས་ཀྱི་རྟེན་ཅན་གྱི་བྱ་བྲག་གིས་གཟུང་བའི་རྟོག་པ་རྣམ་པ་གཉིས་སོ།",
    "སྐྱེས་བུ་བཏགས་པར་ཡོད་པའི་བྱེ་བྲག་གིས་འཛིན་པའི་རྟོག་པ་ཡང་རྣམ་པ་གཉིས་སོ།",
    "དེ་ལ་འཛིན་པའི་རྟོག་པ་གང་ཟག་རྫས་སུ་ཡོད་པ་ནི་གང་ཟག་གི་རྫས་ཀྱི་བདག་ཏུ་འཛིན་པའོ།",
    "དེ་བཞིན་དུ་གཉེན་པོའི་ཆུང་ངུའི་ཆུང་ངུ་ལ་སོགས་པའི་རིམ་པས་ཉོན་མོངས་པ་ཆེན་པོའི་ཆེན་པོ་ལ་སོགས་པ་རིམ་པས་སྤོང་ངོ།",
    "དེ་ལ་ཉོན་མོངས་པ་ནི་འཇུག་པའི་ཕྱོགས་ཀྱི་རྟེན་ཅན་ལ་སོགས་པ་རེ་རེ་ལ་ཡང་ཆེན་པོའི་ཆེན་པོ་ལ་སོགས་པའི་རིམ་པས་དགུ་དགུ་ཡིན་ལ།",
    "རྩེ་མོ་ཞེས་བྱ་བ་རབ་ཀྱི་སྦྱོར་བ་བསྟན་ནས།",
    "དེ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གིས་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བཅུ་ཀ་བསྡུས་སོ།",
    "དེ་ལ་ས་བདུན་པ་མན་ཆད་དུ་ནི་ཆ་ཡིན་པས་རྩེ་མོ་ཞེས་བཏགས་པར་འདུས་ལ།",
    "དེ་ལ་སྐབས་བརྒྱད་གང་ཟག་གཅིག་གིས་ཉམས་སུ་བླང་བའི་རིམ་པ་ནི་མཁྱེན་པ་གསུམ་ཐོས་པའི་ཤེས་རབ་ཀྱིས་ངེས་པར་བྱས་ནས།",
    "འབྲས་བུ་དམ་པ་དང་ནི་རྒྱུ་དང་དམན་པའི་ཡིད་ཀྱིས་འཇུག་པའི་བྱེ་བྲག་གིས།",
    "རྣམ་པ་ཐམས་ཅད་མཐའ་དག་ལམ་དང་ཤེས་བྱ་ཀུན་ཤེས་གང་གིས་ཕ་རོལ་མཆོག།",
    "བློ་ཅན་རྣམས་ཀྱིས་འབད་པ་སྐྱེད་དེ་འདི་རྒྱན་མཛད་མོད་ཀྱི།",
    "ཚིག་གི་ཕྲད་འདི་ནི་སྤྱིར་ན་དེ་མ་ཐག་བརྗོད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྣམ་པ་གཅིག་ཏུ་ན་ཡང་ཞེས་བྱ་བའི་སྒྲ་ནི་འདིར་ཚིག་གི་རྒྱན་ཡིན་པར་བལྟའོ།",
    "འདི་སྨོས་པ་ཡང་ཚིགས་སུ་བཅད་པ་དག་གིས་ཤེས་རབ་བསྟན་པ་ལ་མ་གུས་པ་དག་ཡོངས་སུ་སྤང་བའི་ཕྱིར་རོ།",
    "མོས་པས་སྤྱོད་པ་ལ་ཡོད་པའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་རྣམ་པར་རྟོག་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་ཚིགས་སུ་བཅད་པ་ཐོས་མ་ཐག་ཏུ་གདུལ་བྱའི་སྐྱེ་བོའི་རྒྱུད་གཞུང་ལུགས་ཀྱིས་འདུ་བྱེད་བསྐྱེད་པ་ཅན་དག་ལ་སྐྱེ་བས་རབ་ཏུ་སྟོན་པ་མ་ཡིན་ནམ།",
    "རྣམ་པ་གཅིག་ཏུ་ན་གང་ཞིག་དེ་ཁོ་ན་ཉིད་གཟིགས་པས་གཞུང་རྒྱས་པ་འདི་སྙེད་ཅིག་གིས་བསྟན་པའི་དོན་གང་ཡིན་པ་དེ་ད་ཚིགས་སུ་བཅད་པ་ཉུང་ངུ་ཞིག་གིས་རབ་ཏུ་བསྟན་ཏོ་ཞེས་བཅོམ་ལྡན་འདས་གསུང་ལ།",
    "འདི་ནི་མོས་པས་སྤྱོད་པའི་ས་ན་ཡོད་པའི་འཇིག་རྟེན་པ་ཡིན་ནོ།",
    "དེ་དག་གི་ཐབས་དང་ཐབས་ཀྱིས་བསྒྲུབ་པར་བྱ་བའི་མཚན་ཉིད་ཀྱི་འབྲེལ་པ་ནི་ཚིགས་སུ་བཅད་པ་ཉེ་བར་ལེན་པ་ལ་ཤུགས་ཀྱིས་བསྟན་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "སྒྲིབ་པ་ཉོན་མོངས་བསལ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྒྲིབ་པ་ཉོན་མོངས་ཞེས་བྱ་བ་ནི་སྒྲིབ་པ་དག་ཉིད་དོན་ཕྱིན་ཅི་ལོག་པར་འཛིན་པའི་གེགས་བྱེད་པ་ཉིད་ཀྱིས་གནོད་པར་བྱེད་པའི་ཕྱིར་འདོད་པའི་འདུན་པ་ལ་སོགས་པའི་སྒྲིབ་པའི་བདག་ཉིད་ཀྱི་ཉོན་མོངས་པ་དག་ཡིན་ཏེ།",
    "དེ་ལྟ་བས་ན་དེ་ལྟ་བུ་དག་གི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མཉན་པར་གྱིས་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "རྩེ་མོར་ཕྱིན་དང་མཐར་གྱིས་པ།",
    "འདི་སྐད་དུ་གང་ལ་བདེ་བར་གཤེགས་པའི་སྲས་རྣམས་འཇུག་པ་དེ་ནི་དེ་དག་གི་ཐུན་མོང་མ་ཡིན་པའི་ལམ་ཡིན་ལ།",
    "དེ་དག་མངོན་སུམ་དུ་བྱས་ནས་ཇི་ལྟར་རྟོགས་པ་བཞིན་གདུལ་བྱ་རྣམས་ལ་རབ་ཏུ་སྟོན་པར་བྱེད་པ་དེའི་ཕྱིར་འདི་བཅོམ་ལྡན་འདས་ཀྱི་མཐུ་ཡིན་གྱི་དེ་དག་གི་བདག་ཉིད་ཀྱི་ནི་མ་ཡིན་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ལུང་མེད་པར་རང་གི་རྣམ་པ་ཐམས་ཅད་ཡོངས་སུ་ཤེས་པ་ཡང་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "དེའི་རང་གི་ངོ་བོ་རྟོགས་པ་ཅུང་ཟད་ཀྱང་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ཁོ་ན་ཉིད་རྟོགས་པ་དང་ཆུད་མི་ཟ་བར་བྱ་བའི་དོན་དུ་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ཚིག་གི་ལྷག་མ་ཡིན་ནོ།",
    "ཏིང་འཛིན་འཇིག་རྟེན་ན་ནི་སྒོམ་མོད་ཀྱི།",
    "དེ་ཡིས་བདག་གི་འཇིག་རྟེན་མི་འཇིག་ན།",
    "དེ་ལ་ཉོན་མོངས་ཡང་རབ་འཁྲུགས་འགྱུར་ཏེ།",
    "དེ་ལ་རེ་ཞིག་འདི་མངོན་སུམ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཤེས་པ་ཐམས་ཅད་མངོན་སུམ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "ལུས་ལ་སོགས་པ་ཀུན་དུ་རིག་པ་ལས་མ་གཏོགས་པར་བདག་གི་རྣམ་པར་མི་རྟོག་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་འདི་ནི་བདག་གི་ལུས་ལ་སོགས་པ་ཡིན་ནོ་ཞེས་ཐ་དད་པར་ཤེས་པའི་ཕྱིར་ཐ་དད་པར་རབ་ཏུ་གྲུབ་པ་ཡོད་དོ་ཞེ་ན།",
    "འདིས་ནི་བདག་གིས་མཐོང་ངོ་ལྟའོ་བལྟ་བར་བྱའོ་སྙམ་དུ་ཤེས་པའི་མངོན་སུམ་དུས་གསུམ་གྱི་རྗེས་སུ་འགྲོ་བ་སྒྲུབ་པར་བྱེད་པ་ཡིན་པ་ཡང་བསལ་བ་ཡིན་ཏེ།",
    "དྲན་པ་ལ་སོགས་པ་དང་གིས་འཇིག་པའི་ངོ་བོ་ཉིད་དུ་གྱུར་པའི་རང་བཞིན་རྣམས་ནི་ངང་གིས་མི་འཇིག་པའི་ངོ་བོ་ཉིད་དུ་ཀུན་བརྟགས་པའི་བདག་དང་དེའི་བདག་ཉིད་དུ་མི་རུང་བའི་ཕྱིར་རོ།",
    "ཕན་ཚུན་འགལ་བའི་བདག་ཉིད་རྣམས་ཀྱང་གཅིག་པ་ཉིད་ཡིན་ན་ནི་ཐ་དད་པ་ཅུང་ཟད་ཀྱང་མེད་པས་འགྲོ་བ་མཐའ་དག་ཐ་དད་པ་དང་ཐ་དད་མ་ཡིན་པའི་ཐ་སྙད་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "དྲན་པ་ལ་སོགས་པ་བདག་གི་འབྲས་བུ་ཡང་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་ནང་གི་བདག་ལྷན་ཅིག་བྱེད་པར་རིམ་པ་དང་ལྡན་པ་ཉེ་བ་ལ་ལྟོས་ནས་རང་གི་འབྲས་བུ་སྐྱེད་པ་ལ་རིམ་པ་ཁོ་ནས་བྱེད་པའི་ཕྱིར་འབྲས་བུ་རིམ་ཅན་ཡིན་ནོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "ཕན་པར་བྱ་བ་ཉིད་ཡིན་ན་ཡང་ཕན་པ་ནི་དེ་དང་ཐ་མི་དད་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་དེ་བྱས་ན་བདག་བྱས་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "ཕན་པ་བདག་དང་ཐ་དད་པ་ཉིད་གཅིག་ཡིན་ན་ནི་དྲན་པ་ལ་སོགས་པ་བཞིན་དུ་འབྲེལ་པ་མི་འཐད་ལ་ཐུག་པ་མེད་པར་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "འདི་ནི་བདག་གིའོ་ཞེས་བྱ་བའི་ཐ་སྙད་འཇུག།",
    "རྣལ་འབྱོར་པ་ཟད་པ་དང་མི་སྐྱེ་བ་ཤེས་པ་ཐོབ་པ་རྣམས་ཀྱིས་བདག་གི་ཟག་པ་ཟད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་བློ་ཡང་ཇི་ལྟར་རབ་ཏུ་འགྲུབ་ཅེ་ན།",
    "དེ་ཉིད་ལ་དགོངས་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་དེ་དང་དེ་ལས་དགེ་སློང་དག་གང་སུ་དག་བདག་གོ་ཞེའམ་བདག་གིའོ་ཞེས་ཡང་དག་པར་རྗེས་སུ་ལྟ་བ་དེ་དག་ནི་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་པོ་འདི་དག་ཁོ་ན་ལ་ཡང་དག་པར་རྗེས་སུ་ལྟའོ་ཞེས་གསུངས་སོ།",
    "རང་གི་ངོ་བོ་ཇི་ལྟ་བ་བཞིན་ཉམས་སུ་མྱོང་བའི་བདག་ཉིད་ཀྱིས་རང་ལ་སྒྲོ་འདོགས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བས་ན་གཉེན་པོ་དེ་ལྟ་བུ་གོམས་པའི་སྒོ་ནས་མཐོང་བའི་ལམ་ཉོན་མོངས་པའི་བག་ཆགས་ཐམས་ཅད་དང་འགལ་བ་འཛིན་པ་ལ་སོགས་པར་རྟོག་པས་དབེེན་པར་མཚན་ཉིད་གཅིག་པ་ཡང་དག་པར་སྐྱེས་ན་གང་ཟག་ལ་སོགས་པར་རྟོག་པའི་རྒྱུན་སྤོང་བར་འགྱུར་རོ་ཞེས་བསྟན་ནས།",
    "བདེ་བར་གཤེགས་པ་ལ་སོགས་པ་ཡོངས་སུ་འཛིན་པ་དང་བྲལ་བ་དང་བདག་ཉིད་ཀྱི་ཉོན་མོངས་པ་ཙམ་གྱི་གཉེན་པོ་ཡིན་པའི་ཕྱིར།",
    "གཟུགས་ལ་སོགས་པ་ནི་སྡུག་བསྔལ་དང་ཀུན་འབྱུང་གི་བདེན་པས་ཡང་དག་པར་བསྡུས་པ་ཡིན་ནོ།",
    "འདི་ལྟར་དེ་དག་ཐོག་མ་དང་དབུས་དང་ཐ་མ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་ཡན་ལག་དུ་མའི་ངོ་བོ་ཉིད་དུ་སྣང་བའི་ཕྱིར་དང་དེ་ལས་མ་གཏོགས་པའི་ཡན་ལག་ཅན་ལ་སོགས་པ་གཅིག་པུ་ཡང་མི་དམིགས་པའི་ཕྱིར་ངོ་བོ་ཉིད་གཅིག་པ་མ་ཡིན་ནོ།",
    "འོན་ཏེ་དམིགས་པ་ན་ནི་ཡན་ལག་དུ་མ་ལས་མ་གཏོགས་པའི་གཅིག་པུ་རང་གི་བདག་ཉིད་ཙམ་དུ་གནས་པའི་ཕྱིར་དུ་མ་ཉིད་ཉམས་པ་མེད་དོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་དང་གཅིག་འགྱུར་ན་ཡང་ཐམས་ཅད་འགྱུར་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་རགས་པ་ནི་ཕྲ་མོ་བསགས་པ་སྔོན་དུ་འགྲོ་བ་ཡིན་པའི་ཕྱིར་དེ་གྲུབ་ན་རྡུལ་ཕྲ་རབ་ཀྱང་གྲུབ་པ་ཡིན་ནོ་ཞེ་ན།",
    "གཅིག་དང་དུ་མ་ལས་མ་གཏོགས་པ་གང་གིས་ན་སྔོན་པོ་ལ་སོགས་པ་དངོས་པོ་ཡོད་པར་འགྱུར་བའི་རྣམ་པ་གཞན་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འདི་ནི་རྩེ་མོར་གྱུར་པ་ཆུང་ངུ་ཡིན་ནོ།",
    "ཤེས་པ་དམིགས་པ་ནི་འཇིག་རྟེན་པའི་རྟོག་པའི་ཤེས་པས་ཕྱི་དང་ནང་ལ་སོགས་པའི་བྱེ་བྲག་གིས་འཛིན་པ་ལ་སོགས་པའི་ངོ་བོ་ཉིད་དུ་ལྷག་པར་ཆགས་པ་སྟེ་དེ་ལྟ་བུར་གྱུར་པ་མེད་པའོ།",
    "དེ་ལྟ་བས་ན་དངོས་པོ་རྣམ་པ་ཐམས་ཅད་དུ་མི་དམིགས་པའི་བདག་ཉིད་ཁོ་ན་འཇིག་རྟེན་ལས་འདས་པའི་ཚུལ་ཡིན་ལ་དེ་ལས་གཞན་པ་ནི་སྒྲོ་བཏགས་པའི་རྣམ་པའི་སྤྱོད་ཡུལ་ཅན་ཡིན་པ་ཉིད་ཀྱིས་ཉོན་མོངས་པའི་བག་ཆགས་མཐའ་དག་གི་གཉེན་པོ་མ་ཡིན་པའི་ཕྱིར་འཇིག་རྟེན་པ་ཡིན་ནོ།",
    "ཉོན་མོངས་པའི་ཚོགས་ཐམས་ཅད་སྤོང་བར་འགྱུར་བ་ཁོ་ན་མ་ཡིན་ནམ།",
    "དེ་ལྟ་མ་ཡིན་ན་མི་སྡུག་པ་ལ་སོགས་པར་མོས་པ་ཡིད་ལ་བྱེད་པ་ཡང་ཉོན་མོངས་པའི་གཉེན་པོར་འགྱུར་བར་ཐལ་བར་འགྱུར་རོ།",
    "ཉན་ཐོས་ཀྱི་མྱ་ངན་ལས་འདས་པ་ལ་ཡང་མི་རེག་ཅིང་ཡུལ་དུ་མི་བྱེད་པ་ཞེས་བྱ་བ་དང་རྣལ་དུ་སྦྱར་ཏེ།",
    "རྩེ་མོར་གྱུར་པ་ཆེན་པོ་བསྟན་པའི་ཕྱིར་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་རིམ་གྱིས་འཕེལ་བའི་རྩེ་མོར་གྱུར་པ་ལས་གཟུང་བ་དང་འཛིན་པ་མེད་པར་རྟོགས་པའི་མཚན་ཉིད་ཀྱི་བཟོད་པ་དེ་ཁོ་ན་ཉིད་ཀྱི་ཕྱོགས་གཅིག་གིས་ཏིང་ངེ་འཛིན་གྱི་བདག་ཉིད་དག་སྐྱེ་བར་འགྱུར་རོ་ཞེས་སྟོན་ཅིང་གཟུགས་ལ་སོགས་པའི་འདུ་ཤེས་ཕྱིན་ཅི་ལོག་གི་ངོ་བོ་ཉིད་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "དེ་ལ་མ་དད་པ་ནི་མ་མོས་པ་སྟེ།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བ་ནི་ལྷག་མ་ཡིན་ནོ།",
    "ཏིང་ངེ་འཛིན་གང་གིས་ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་སྤྱོད་ཡུལ་ཉམས་སུ་མྱོང་བ་སྟེ།",
    "སྔོན་གྱི་དེ་བཞིན་གཤེགས་པ་ཞེས་སྨོས་པ་ནི་དེ་བཞིན་གཤེགས་པ་གཞན་དག་གིས་ཀྱང་དེ་ལུང་བསྟན་པའི་ཕྱིར་ཉེ་བར་མཚོན་པའི་དོན་ཏེ།",
    "དེ་ལ་གཟུང་བར་རྣམ་པར་རྟོག་པ་ནི་རྣམ་པ་གཉིས་ཏེ་དངོས་པོ་ཙམ་ལ་བརྟེན་པ་ནི་གང་གིས་ན་ཕུང་པོ་ལ་སོགས་པ་དངོས་པོ་ཙམ་ལ་བརྗོད་པ་ཙམ་དུ་ཤེས་པའོ།",
    "གཉེན་པོ་ལ་བརྟེན་པ་ནི་གང་གིས་ན་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སོགས་པའི་རྣམ་པ་རྣམ་པར་བྱང་བའི་དངོས་པོ་ཁོ་ན་ལས་སེམས་ཙམ་དུ་རྣམ་པར་འཇོག་པར་བྱེད་པའོ།"
  ]
}