    "ལྷག་མ་འཇུག་པ་ལ་སོགས་པ་ནི་སྒྲུབ་པ་དང་པོའོ་ཞེས་དགོངས་པས་དུས་གཅིག་གི་ཚུལ་གྱིས་སྟོན་པར་མཛད་དོ་ཞེས་བྱའོ།",
    "དྲུག་ཚན་དྲུག་གིས་ཇི་བཞིན་བཤད།",
    "དཔེར་ན་གཟུགས་ཞེས་བསྟན་པའི་ཚེ་རྒྱུ་དང་རྒྱུར་བྱས་པ་དག་གིས་དབྱེ་བས་བསྟན་པ་ལྟ་བུའོ།",
    "དེས་ན་ལས་དང་པོ་པའི་ས་ནས་ཁྱད་པར་གྱི་ལམ་གྱི་བར་དུ་ཚོགས་ཡིན་མོད་ཀྱི།",
    "ས་དེ་དག་གི་རྟགས་དང་།",
    "རང་གི་སེམས་ཀྱང་བསྲུང་བའི་ཕྱིར།",
    "རིང་དུ་སོང་བའི་སར་འདོད་དོ།",
    "གཞན་དག་ན་རེ་དེ་ནི་རིགས་པ་མ་ཡིན་ཏེ།",
    "འཛམ་བུའི་གླིང་གི་རྒྱལ་པོ་དང་།",
    "སྟོང་གི་བདག་པོ་ཚངས་པ་དང་།",
    "ས་འདི་དག་གི་ཡོན་ཏན་དེ་ལྟ་བུ་ལ་སོགས་པ་ཕལ་ཆེར་ནི་འཕགས་པ་ས་བཅུའི་ལེའུར་བལྟ་བར་རིགས་སོ།",
    "དེ་ལ་མི་མཐུན་པའི་ཕྱོགས་ནི་ཐུན་མོང་ཉིད་དུ་གཟུང་བ་དང་།",
    "ངན་སོང་བའི་ཉོན་མོངས་པའི་ཤིན་ཏུ་རྨོངས་པ་དང་།",
    "གསང་བ་ཕྲ་མོ་ལ་འཇུག་པའི་ཤིན་ཏུ་རྨོངས་པ་དང་།",
    "ས་རྣམས་ཀྱི་མི་མཐུན་པའི་ཕྱོགས་བྱེ་བྲག་ཅན་འདི་ནི་བདག་གི་ས་ལ་འཇུག་པ་ལས།",
    "དེ་ལྟར་ན་ཇི་ལྟར་དེ་དག་གི་རྟགས་རྨི་ལམ་དུ་ངེས་པར་འགྱུར་ཞེ་ན།",
    "དེ་ནི་བདེན་མོད་ཀྱི་འོན་ཀྱང་གཉིད་དེ་ནི་རྣམ་པ་གཉིས་ཏེ།",
    "ལུང་གི་ཚིག་འདི་དགོས་པ་མེད་པར་སྒྲ་གཞན་གྱིས་སྟོན་པར་མི་མཛད་དོ།",
    "དེ་ལ་མཚན་མ་རྣམས་ནི་ས་དང་པོ་ལ་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་གཏེར་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་གིས་ཡོངས་སུ་གང་བར་མཐོང་བའོ།",
    "ས་བརྒྱད་པ་ལ་ནི་ཕྲག་པ་གཉིས་ན་རི་དྭགས་ཀྱི་རྒྱལ་པོ་སེང་གེ་རལ་པ་ཅན་ཅོད་པན་ཐོགས་པ་གཅན་གཟན་ཕྲ་མོ་ཐམས་ཅད་སྐྲག་པར་བྱེད་ཅིང་གནས་པར་མཐོང་བའོ།",
    "གང་གིས་གནས་སྐབས་མ་ཡིན་པར་མཚན་མ་འདི་དག་མཐོང་བར་གྱུར་པ་ནི་སྔགས་ཀྱི་མཐུ་འམ།",
    "དེ་དག་རེ་རེ་ཡང་ཐམས་ཅད་དུ་མི་འགྲོ་བ་ནི་མ་ཡིན་པས་ན་ཉེས་པ་མེད་དོ།",
    "ཁ་ཅིག་ནི་བདེན་པ་རྣམ་པ་བཞི་ལ་དམིགས་པའི་ཡེ་ཤེས་སྐད་ཅིག་མ་བཅུ་དྲུག་གིས་བསྡུས་པར་འདོད་དོ།",
    "ཡང་གཞན་དག་ནི་ཉོན་མོངས་པ་དང་།",
    "དེ་ནས་ནི་སྐབས་བཞི་པར་རྣམ་པ་དག་གི་ནང་དུ་སྤོང་བའི་ལམ་སྟེ་མ་ལུས་པར་སྤོང་ཞེས་བྱ་བའི་དོན་བསྡུའོ།",
    "རྣམ་པར་བྱང་དང་ཚོགས་དང་ནི།",
    "མན་ངག་གི་བསྟན་བཅོས་ཞེས་བྱ་བ་ནི་ཤེས་པར་བྱེད་པའི་ཡུལ་མྱུར་དུ་ཁོང་དུ་ཆུད་པར་བྱེད་པའི་གཞུང་ལུགས་སོ།",
    "ཡང་ན་མཆོག་གི་དོན་ཏེ།",
    "རང་གི་ལམ་ལ་དེ་དག་གི་ཡོན་ཏན་རྫོགས་པར་ཤེས་པར་བྱ་བའི་དོན་ཏེ།",
    "ཚིག་ལེའུར་བྱས་པའི་དོན་ཉེ་བར་མཚོན་པ་ལྷུར་ལེན་པའི་གཞུང་གིས་ཞེས་བྱ་བ་ནི་དེ་ལས་དེ་དག་རྣམ་པའོ་ཞེས་མ་སྨོས་ཀྱི།",
    "འདིར་བསྡུས་པའི་དོན་ནི་མོས་པ་དང་བསྔོ་བ་དང་།",
    "དེ་དག་ཇི་ལྟར་ཡང་རུང་སྟེ་ས་རེ་རེ་ལ་ཡང་རྣམ་པ་དགུ་དགུར་ནི་བརྗོད་དོ།",
    "མོས་པ་རྣམ་པ་ཉི་ཤུ་རྩ་བདུན་ནོ་ཞེས་བྱ་བ་ལ་འདིར་མོས་པའི་རྒྱུ་ནི་ལུང་རྣམ་པར་དག་པ་དང་རིགས་པ་ནི་ལྟ་བའོ།",
    "འདི་ལས་ཐེ་ཚོམ་ཟློག་པ་སྟེ་མོས་པ་དང་ལྡན་པ་ནི་རང་གི་གྲུབ་པའི་མཐའ་ལས་གཞན་གྱིས་འཕྲོག་པར་མི་ནུས་པས་སོ།",
    "རང་ཉིད་ཀྱི་དོན་དུ་ཡུམ་ལ་མོས་པ་དང་།",
    "གཉི་གའི་དོན་དུ་ཡུམ་འདི་ལ་རབ་ཏུ་མོས་པ་སྟེ།",
    "རང་གི་ཆེད་དུ་འབད་པ་མེད་པར་འབྱུང་སྟེ།",
    "དེ་ཉིད་གཞན་གྱི་ཕྱིར་སྦྱོར་བར་བྱེད་ལ་དེའི་ཡང་ཕྱི་མའི་སེམས་ལ་ནི་དངོས་པོའི་སྟོབས་ཀྱིས་མགུལ་ནས་སྦྲེལ་བ་ལྟར་རང་དང་གཞན་གཉི་གའི་དོན་འགྲུབ་པར་ཤེས་པ་ངེས་པ་ཅན་སྐྱེའི་སྔ་མ་ལྟར་རེ་རེ་ཞིག་ལ་ཞེན་པ་ནི་མེད་པས་སོ།",
    "ཁ་ཅིག་ནི་འདིར་རང་གི་དོན་དུས་རིང་དུ་སོང་བའི་བར་དུའོ།",
    "འབྲིང་གི་འབྲིང་ནི་དེ་ལྟ་བུས་འཛམ་བུའི་གླིང་བྱུར་བུར་བཀང་བའི་དཔེས་སོ།",
    "འབྲིང་གི་ཆེན་པོ་ནི་དེ་ལྟ་བུས་གླིང་བཞི་པའི་འཇིག་རྟེན་གྱི་ཁམས་བཀང་བའི་དཔེས་སོ།",
    "འབྲིང་གི་ཆེན་པོ་ནི་དེ་ལ་ཕ་མ་དང་འཕགས་པའི་སྐྱེ་བོ་རྣམས་ཀྱིས་ཀྱང་དབེན་ཞིང་ཡིད་དུ་འོང་བར་བྱ་བ་ལ་སོགས་པར་གང་བསྟན་པའོ།",
    "ཆེན་པོའི་ཆེན་པོ་ནི་དེར་ལྷའི་ཚོགས་ཐམས་ཅད་འོངས་པས་མོས་པ་རྒྱ་ཆེན་པོ་དང་ལྡན་པར་འགྱུར་བ་དང་།",
    "ཆུང་ངུའི་འབྲིང་ནི་འཛམ་བུའི་གླིང་དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་གིས་བྱུར་བུར་བཀང་བའི་དཔེས་བསྟན་པས་སོ།",
    "དེ་ལྟར་ན་ས་བརྒྱད་པ་འདི་དག་གིས་འཇིགས་པ་དང་བཅས་པར་བསྟན་པ་ཅི་ཞེ་ན།",
    "མོས་པ་རྣམ་པ་གསུམ་གྱིས་མཚམས་བརྗོད་པ་ཁོ་ནར་ཟད་དོ།",
    "འབྲིང་གི་ཆུང་ངུ་ནི་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་གིས་བྱུར་བུར་བཀང་བའི་དཔེས་བསྟན་ཏོ།",
    "འབྲིང་གི་ཆེན་པོ་ནི་ཡུམ་འདི་ལ་བརྟེན་པ་ནི་རྒྱལ་པོའི་སྐྱེས་བུའི་དཔེ་ཉེ་བར་བཟུང་བས་སོ།",
    "ཆེན་པོའི་ཆུང་ངུ་ནི་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཅིག་དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་གིས་བྱུར་བུར་བཀང་བའི་དཔེས་བསྟན་ཏོ།",
    "མོས་པ་རྣམ་པ་ཉི་ཤུ་རྩ་བདུན་པོ་ཆུང་ངུ་ནས་བརྩམས་པའི་རིམ་པ་འདིས་མི་མཐུན་པའི་ཕྱོགས་ནི་དེ་ལས་བཟློག་སྟེ་ཆེན་པོ་ནས་བགྲང་བར་ཤེས་པར་བྱའོ།",
    "ཅི་འདིར་རང་ཁོ་ནའི་ཕྱིར་མོས་པ་ལ་སོགས་པ་བརྗོད་དམ།",
    "ཡང་ན་རང་གི་ཕྱིར་རྒྱལ་བ་སྐྱེད་མ་ཁོ་ན་ལ་མོས་པ་བརྗོད་ཅེ་ན།",
    "ཕྱོགས་གཉི་ག་ལྟར་མི་བསམ་གྱི་རང་ལ་སོགས་པའི་ཕྱིར་ཡུམ་ཁོ་ན་ལ་མོས་ཞེས་བརྗོད་དོ།",
    "རང་གི་དོན་དུ་མོས་པ་ན་ཡང་གཞན་གྱི་ནི་མེད་པ་ཡང་མ་ཡིན་ལ།",
    "ལྷག་མ་གཞན་གྱི་དོན་དུ་མོས་པ་ན་ཡང་རང་གི་དོན་གྱིས་ག་ལ་ཞིག་དབེན།",
    "ཉི་གའི་ཕྱིར་མོས་པ་ན་ཡང་རེ་རེ་ལ་ཁྱབ་པ་ནི་མི་འདོར་ཏེ།",
    "དེ་དག་ཀྱང་རང་གི་དོན་དུ་མོས་པ་ལ་ནི་བསྟོད་པའོ།",
    "རང་དང་གཞན་གྱི་དོན་དུ་མོས་པ་ལ་ནི་བཀུར་བའོ།",
    "གཞན་གྱི་དོན་དུ་མོས་པ་ནི་བསྔགས་པའོ་ཞེས་སྦྱར་རོ།",
    "དེ་ལ་དགུ་ཚན་དང་པོའི་དང་པོ་ནི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཅིག་དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་གིས་བཀང་བའི་དཔེས་བསྟན་ཏོ།",
    "གཉིས་པ་ནི་ཡུམ་འདི་གཞན་གྱི་ཐད་དུ་སོང་སྟེ་བསྟན་པའི་ཆེ་བ་བརྗོད་པས་སོ།",
    "གང་གི་ཚེ་མི་མཐུན་པའི་ཕྱོགས་ཁོང་དུ་ཆུད་པ་མེད་ན་འདི་གང་གི་གཉེན་པོར་གྱུར་པ་ག་ལ་ཞིག་ཤེས་པར་འགྱུར་ཞེས་དགོངས་པ་སྟེ།",
    "འདི་གང་གིས་སྟོང་ཞེ་ན།",
    "དེ་ལྟར་ན་ཀྱེ་རྒྱལ་བའི་སྲས་དག་ཁམས་གསུམ་པ་འདི་དག་ནི་སེམས་ཙམ་མོ་ཞེས་གསུངས་པ་འདི་ཇི་ལྟར་དྲང་ཞེ་ན།",
    "ལྷག་མ་རྣམས་ཀྱི་དོན་ནི་གོ་བར་སླ་བས་བདག་གིས་རྣམ་པར་མ་ཕྱེའོ།",
    "གཞན་དག་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་གྱི་རེ་རེ་ཡང་རྣམ་པ་ཀུན་ཞེས་ཟེར་བ་ནི་མི་འཐད་དེ་དེ་ནི་དངོས་སུ་མ་བསྟན་པས་སོ།",
    "རྣམ་པ་དེ་དག་གང་གིས་གཞག།",
    "དང་པོར་རེ་ཞིག་སྔར་བསྟན་པ་ལྟར་རྣམ་པ་ཞེས་བྱ་བ་ནི་བྱེ་བྲག་དུ་མ་ལ་བྱའོ་ཞེས་བསྟན་ཅིང་།",
    "ཡང་བདག་གིས་གོ་སླ་བར་བྱ་བའི་ཕྱིར་འདིར་རྣམ་པ་རྣམས་མཚན་ཉིད་དང་མཚན་གཞིར་ཕྱེ་སྟེ་བསྟན་ཀྱང་།",
    "དེ་ལྟར་རང་བཞིན་བསྟན་ནས་ད་ནི་རྣམ་པ་དེ་དག་གང་གིས་བཞག་སྙམ་པ་ལ།",
    "དེ་དག་ཀྱང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་གྱི་བྱེ་བྲག་གིས་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "མི་སྐྱེ་བ་ནི་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་སྐད་ཅིག་རེ་རེ་འཇིག་པའོ།",
    "མི་བརྫི་བ་ནི་བདག་མེད་པའི་ཕྱིར་བདག་གི་མེད་པར་རྟོགས་པས་མི་བརྫི་བ་སྟེ།",
    "ཚིག་གི་དོན་རྣམས་ནི་གོ་སླ་བས་རྣམ་པར་མ་ཕྱེའོ།",
    "ཆད་པར་ལྟ་ལ་ངན་སོང་ལྷུང་འགྱུར་བས།",
    "རང་བྱུང་གི་ཡེ་ཤེས་སོ།",
    "དེ་ཇི་ལྟར་རང་བྱུང་གི་ཡེ་ཤེས་ཡིན་ཞེ་ན།",
    "ཡེ་ཤེས་ཀྱང་གང་གི་ཡུལ་ཡང་མ་ཡིན་ནོ།",
    "དངོས་ཀུན་དངོས་པོ་གཅིག་གི་ངོ་བོ་ཉིད།",
    "གང་གིས་དངོས་གཅིག་དེ་བཞིན་ཉིད་དུ་རྟོགས།",
    "དེ་དག་ནི་ཆེད་དུ་ཉོན་མོངས་པ་མི་སྤོང་གི་ཟིལ་གྱིས་གནོན་པ་ཙམ་ཞིག་བྱེད་པའི་ཕྱིར་རོ།",
    "ཡན་ལག་གི་དོན་ནི་རྒྱུའི་དོན་ཏོ།",
    "ཉེ་བའི་ཉོན་མོངས་པ་དང་།",
    "སྦྱོར་བ་ཁྱད་པར་ཅན་དག་གིས་ཞེས་བྱ་བ་ལ་སྦྱོར་བ་ནི་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་བཞིའོ།",
    "བསྟན་པ་ནི་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་བཞི་ཆར་གྱི་ཐུན་མོང་དུ་སྦྱར་བར་བྱ་བ་ཡིན་པའི་ཕྱིར་ཞེས་ཤེས་པར་བྱའོ།",
    "ཚིག་གི་དོན་ནི་གོ་སླའོ།",
    "ཡོན་ཏན་ཞེས་བྱ་བ་ལ་ཡོན་ཏན་འདི་དག་ནི་ལས་དང་པོ་པའི་ས་ནས་བརྩམས་ཏེ་ལྡན་མོད་ཀྱི་ལེགས་པར་འབྱོར་པ་ནི་དྲོད་ཐོབ་པ་ཡན་ཆད་ལ་སྦྱར་བར་བྱ་སྟེ།",
    "ཚིག་གི་དོན་ནི་གོ་སླ་བས་མ་བྱེའོ།",
    "གླགས་སུ་འགྱུར་བའི་ཕྱིར་ཉོན་མོངས་པའི་བདུད་དང་།",
    "མི་བདེ་བའི་མིག་གིས་ལྟ་བ་ནི་བདུད་ཀྱི་ལས་སོ།",
    "ཟབ་མོའི་གཏམ་འཆབ་ཅིང་སྦེད་པ་དང་།",
    "ཉོན་མོངས་པ་རྣམ་པར་བཟློག་པ་དང་ཞི་བ་འདོད་པ་ནི་བདུད་ཀྱི་བྱིན་གྱི་རླབས་སོ།",
    "ཟབ་མོའི་གཏམ་འཆབ་ཅིང་གཏམ་སྣ་ཚོགས་སུ་སྟོན་པ་ཡང་བདུད་ཀྱི་ལས་སོ།",
    "གང་གི་ཚེ་བརྒྱ་བྱིན་ནམ།",
    "ཁྱིམ་བདག་གི་ལོངས་སྤྱོད་དང་།",
    "རང་གི་གཞུང་གི་ཚིག་གི་དོན་ནི་གོ་སླ་བས་རྣམ་པར་མ་ཕྱེའོ།",
    "རྒྱལ་བའི་ཡུམ་འདིའི་མཚན་ཉིད་ཇི་སྙེད་པ་སྟོན་པར་བྱེད་པའི་ཚིག་ལེའུར་བྱས་པ་རྣམས་དགྲོལ་བའི་ཕྱིར་སྐྱོན་གྱི་འོག་ཏུ་དེ་དག་གི་མཚན་ཉིད་གསུངས་ཏེ་ཞེས་སྦྱར་རོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་གསུམ་པོ་དེ་དག་གིས་ཞེས་བྱའོ།",
    "མཚན་ཉིད་ཅེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་དང་རྣམ་པར་དབྱེ་བའི་མཚན་ཉིད་དོ།",
    "རང་གི་མཚན་ཉིད་ནི་རང་གི་ཐུན་མོང་མ་ཡིན་པའི་ཡན་ལག་མེ་ལ་སོགས་པའི་ཚ་བ་ལ་སོགས་པ་འཇིག་རྟེན་རྣམས་ན་རིགས་པས་མ་བཅོམ་པའི་ཚེ།",
    "ཤེས་པར་བྱེད་པར་མཚུངས་སུ་ཟིན་ཀྱང་དེ་དག་གི་ཁྱད་པར་ནི་འདི་དང་འདི་ལྟ་བུའོ་ཞེས་སྟོན་པར་བྱེད་པ་ནི་ཁྱད་པར་གྱི་མཚན་ཉིད་དོ།",
    "དེའི་ཕྱིར་ལམ་སྤྱི་དང་ཁྱད་པར་དག་གི་མཚམས་སུ་རང་གི་ལམ་མ་ཐོབ་ཀྱང་།",
    "རང་གི་རྟོགས་པ་དང་འཚམ་པར་གཞན་ཡིད་ཆེས་པར་བྱེད་པའི་ཡོན་ཏན་རྣམས་འདི་ལ་མེད་པས་ན་དེའི་ཕྱིར་དང་།",
    "རང་གི་རྒྱུད་ལ་བསྐྱེད་པར་མཁས་པ་ཞེས་བྱ་བ་ནི་གཞན་གྱི་དོན་ལ་དམིགས་པ་རབ་ཏུ་སྲབ་པ་སྟེ།",
    "རེས་འགའ་མི་མཐུན་པའི་ཕྱོགས་མཐུ་ཆེ་བར་གྱུར་པའི་ཕྱིར་རོ།",
    "འདིར་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་འདི་དག་རེ་རེ་ལ་ཡང་ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོ་གསུམ་གསུམ་དུ་དབྱེ་བར་བྱ་སྟེ།",
    "སྤུན་དང་སྲིང་མོའི་སེམས་དང་།",
    "བུ་དང་བུ་མོའི་སེམས་དང་།",
    "གཉེན་དང་སྣག་གི་གཉེན་མཚམས་ཀྱི་སེམས་རྣམས་ནི་ཆེན་པོའོ།",
    "རང་དང་མཐུན་པའི་འབྲས་བུ་ཞེས་བྱ་བ་ལ་རང་ནི་མཉམ་པར་གཞག་པའི་ཡེ་ཤེས་ཏེ་དེ་དང་མཐུན་པའི་འབྲས་བུ་ནི་ཇི་ལྟར་མཉམ་པར་གཞག་པའི་ཚེ་ན་དངོས་པོ་གཉིས་སུ་མི་འཛིན་པས་ན་གཟུང་བ་དང་འཛིན་པར་སྣང་བ་ཉིད་མེད་པ་ལྟར་དེ་ལས་ལངས་པ་ན་ཡང་གཟུང་བ་དང་འཛིན་པར་སྣང་བ་ཙམ་ཞིག་ཡོད་དུ་ཟིན་ཀྱང་གཉིས་སུ་ཞེན་པ་མེད་པའི་ཕྱིར་ན་དེ་རང་གི་རྒྱུད་དང་མཐུན་པའི་འབྲས་བུར་བརྗོད་དོ།",
    "གཞན་དག་ནི་དོན་མཛད་པ་དང་མི་མཛད་པའི་གནས་སྐབས་གཉིས་སུ་ནི་མི་དབྱེའི་དོན་མཛད་པར་སྣང་བའི་ཚེ་ན་ཡང་རྟོགས་པ་དང་མཐུན་པ་ལས་མ་ཉམས་མོད་ཀྱི།",
    "ཡི་གེ་གཅིག་གིས་ཡི་གེ་ཐམས་ཅད་སྟོན་པར་བྱེད་དོ།",
    "དེ་ལྟར་གང་ཡང་རུང་སྟེ་ཕྱོགས་གཉི་ག་ལ་བཏགས་པར་བསྟན་པ་ཡོད་པས་བཏགས་པའི་དགོས་པ་བསྟན་པ་ནི་དེ་ལྟ་མ་ཡིན་ན་རྣལ་འབྱོར་པའི་རྒྱུད་ལ་སོ་སོ་རང་གིས་རིག་པས་སྐད་ཅིག་མ་རྣམས་ཇི་ལྟར་གཞན་ཡིད་ཆེས་པར་བྱེད་པའི་མཚན་ཉིད་དག་ཡིན་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འཇིག་པའི་བྱེད་པ་པོ་མེད་པར་རང་གི་ངང་གིས་འཇིག་པ་ཡིན་ཏེ།",
    "འདིར་སློབ་དཔོན་ཟླ་བ་གྲགས་པའི་ཞལ་སྔ་ནས་ནི་དངོས་པོ་རྣམས་ལ་ནི་སྐད་ཅིག་མའི་མི་རྟག་པ་མེད་མོད་ཀྱི།",
    "རིགས་པ་དང་ལུང་གིས་རབ་ཏུ་བསྟན་པར་རང་གི་འདོད་པ་གྲུབ་པ་ནི་དེ་ནས་ཕར་ཡང་འགྲོར་མེད་པས་ན་མཐའོ།",
    "དགོས་པ་དེ་གཟིགས་ནས་སྔར་བསྟན་ཟིན་པའི་དྲོད་ལ་སོགས་པ་ཡང་རྟགས་ལ་སོགས་པར་བསྙད་པ་སྟེ།",
    "དེའི་ཕྱིར་ན་འདིར་རྩེ་མོ་ཞེས་བྱ་བ་ནི་དང་པོ་རིམ་གྱིས་སྐྱེ་བའི་དུས་དང་།",
    "ཡང་ན་རྩེ་མོ་ནི་སྐབས་འདིར་བསྟན་པའི་དྲོད་ལ་བྱ་སྟེ་འདིར་བསྟན་པའི་དྲོད་ནི་སྔར་བསྟན་པའི་མཐོང་བའི་ལམ་ལ་སོགས་པ་མཆོག་ཏུ་གྱུར་པའི་ཕྱིར་ན་རྩེ་མོའོ།",
    "དེ་ལ་རྟགས་ནི་ཕྱི་དང་ནང་གི་རྟགས་བཅུ་གཉིས་བསྟན་པ་དང་ལྡན་པས་རྟགས་ཏེ།",
    "ཚིག་གི་དོན་ནི་གོ་སླའོ།",
    "ད་ནི་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྣམས་རེ་རེ་ཡང་རྣམ་པར་རྟོག་པ་བཞི་བཞི་དང་ལྡན་པར་བསྟན་པ་དང་།",
    "སྦྱོར་བའི་གནས་སྐབས་ནི་མོས་པ་ཡིད་ལ་བྱེད་པ་ལྟ་བུ་ཡིན་ལ་འཇུག་པའི་གནས་སྐབས་ནི་དེ་ཁོ་ན་ཡིད་ལ་བྱེད་པ་ལྟ་བུའི་ཕྱིར་རོ།",
    "བདེན་པ་མཐོང་བའི་ཡང་སྙོམས་པར་འཇུག་པ་རྒྱུའི་སྒོ་ནས་དེ་དག་ལ་དེ་ལྟར་ལྡན་པར་བསྟན་པས་ཚུལ་སྔ་མས་ཁམས་དེ་དང་དེར་དེ་དག་རང་རང་གིས་ཁམས་ཀྱི་རྣམ་པར་རྟོག་པ་སྤོང་བའི་ཕྱིར་དང་།",
    "འདིར་ཁ་ཅིག་ན་རེ་མཐོང་བའི་ལམ་ནི་སྐད་ཅིག་མ་གཅིག་ཁོ་ནའི་བདག་ཉིད་ཡིན་པས་ན་གཅིག་གི་ཚིག་ཅན་དུ་མཛད་དོ་ཞེས་ཟེར་ཏེ།",
    "ཉོན་མོངས་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་རྟོག་པར་གཅིག་མོད་ཇི་ལྟར་དགུ་ཡིན་སྙམ་པ་ལ།",
    "འདི་དག་ནི་མིང་ཙམ་མོ་ཞེས་གསུངས་པ་རྣམས་སོ།",
    "གང་གི་ཚེ་དེ་དག་གི་ཡུལ་གྱི་དངོས་པོར་གྱུར་པ་གཟུང་བའི་དོན་སོ་སོའི་སྐྱེ་བོ་དང་འཕགས་པའི་གང་ཟག་དེ་དག་བློས་བཏགས་པ་དེ་བཞིན་དུ་གཟུང་བར་བྱ་སྟེ།",
    "དེ་དག་གང་གིས་འཛིན་པར་འདོད།",
    "ཞེས་བྱ་བའི་ཚིག་འདིས་གཟུང་བའི་རྣམ་པར་རྟོག་པ་བཅྭ་བརྒྱད་ནི་ཡུལ་ཡིན་ལ་འཛིན་པའི་རྣམ་པར་རྟོག་པ་བཅྭ་བརྒྱད་ནི་ཡུལ་ཅན་ནོ་ཞེས་རྣམ་པར་རྟོག་པའི་རིགས་གཉིས་ཡུལ་དང་ཡུལ་ཅན་དུ་སྦྱོར་བ་དེ་དག་གིས་ནི་ཅུང་ཟད་ཀྱང་ཁོང་དུ་མ་ཆུད་དེ།",
    "ནི་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་ཞེས་བྱ་བ་འམ་དེ་ཁོ་ན་ཞེས་བྱ་བའི་ཚིག་ཏུ་སྟོན་པའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་སློབ་དཔོན་རྒན་པོ་ཁ་ཅིག་གི་ཞལ་སྔ་ནས།",
    "དེ་བཞིན་ཉིད་ལ་བརྗོད་པར་མི་ནུས་པས་ན་སོ་སོ་རང་གིས་རིག་པར་མི་ནུས་སོ།",
    "སྒྲ་ཇི་ལྟ་བ་བཞིན་དུ་དེ་ནི་མཐོང་བ་སྐྲའི་རྩེ་མོས་གཟུང་བར་བྱ་བ་ཙམ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་པི་ཝང་རྒྱུད་སྦྲེང་བ་ལ་སོགས་པའི་འབད་པ་མེད་པར་ཡང་སྒྲ་མི་འབྱུང་ལ་པི་ཝང་གི་སྦུབས་ལ་སོགས་པ་བཤིག་པ་ལས་ཀྱང་སྒྲའི་དངོས་པོ་མི་རྙེད་ཀྱི་སླར་རྒྱུན་ཆད་པར་འགྱུར་རོ།",
    "འདི་དག་སྤངས་ཏེ་སྣང་བ་མེད་པར་འགྱུར་བ་ཡང་ཞི་བའི་དབྱིངས་ཙམ་ཞིག་ཡིན་པས་རབ་ཏུ་སྤངས་པས་དེའི་ཕྱིར་འདི་དག་གི་རང་བཞིན་འདི་དག་དང་།",
    "རྣམ་པ་སུམ་ཅུ་རྩ་དྲུག་ཅན་ནི་རྟོག་པ་དེ་སྙེད་ཅིག་གི་གཉེན་པོར་གྱུར་པས་སོ།",
    "བག་ཆགས་ཀྱི་ཉོན་མོངས་པ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་དེ་དག་གི་རྒྱུ་སྟེ།",
    "དཔེར་ན་ཤིང་ཏ་ལའི་རྩེ་མོ་བཅད་པའི་མཐུས་རྩ་བའི་ཆ་མྱུར་དུ་སྐམ་པ་ལྟ་བུའོ།",
    "དེ་ལ་དེ་གང་གི་རྟེན་ཡིན་ཞེ་ན།",
    "འབྲས་བུ་མཆོག་གིས་སྤབ་ཡི།",
    "རྣལ་འབྱོར་སྤྱོད་པ་པ་རྣམས་སྨྲ་བ་ལྟར་དང་པོ་ནས་དེ་དག་གི་རིགས་ཅན་ཡིན་ཞེས་ནི་མི་བརྗོད་ཀྱི།",
    "དེ་ནི་རྣལ་འབྱོར་སྤྱོད་པ་པ་དག་གི་ངོར་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་སྲིད་ཡེ་ཤེས་ལུས་གཅིག་གིས།",
    "གཞན་གྱི་དོན་གྱི་གོ་རིམས་དག་གིས་བསྟན་ཏོ།",
    "འདི་དག་དང་གཞན་ཡང་ཡོན་ཏན་ལ་སོགས་པ་མཐའ་དག་གིས་འདིར་གཏན་ལ་དབབ་པར་བྱའོ།",
    "དེ་སྟོང་ལ་ནི་སྟོང་གསུམ་མོ།",
    "རང་གི་རང་བཞིན་བརྗོད་པར་ནི་དེ་སུས་ཀྱང་ནམ་ཡང་མི་ནུས་ཤིང་ཡོད་པ་དང་མེད་པ་ལ་སོགས་པའི་དངོས་པོ་གང་དུ་ཡང་མ་གྲུབ་པས་ན་འཕགས་པ་སོ་སོ་རང་གི་རིག་པའི་སྤྱོད་ཡུལ་ཞེས་བསྒྲགས་པའོ།",
    "ཁ་ཅིག་ཏུ་ནི་རང་གི་རང་བཞིན་ལ་རྣམ་པ་ཞེས་ཟེར་ཏེ།",
    "དེ་དག་ལས་འདིར་ནི་རང་གི་རང་བཞིན་ལ་རྣམ་པ་ཞེས་འདོད་དེ།",
    "འདིའི་རང་བཞིན་ནི་རང་གི་ངོ་བོའི་རྣམ་པར་རྟོག་པ་དང་།",
    "དེ་ལ་སོགས་པས་ནི་བདེན་པ་རེ་རེ་ཞིག་བཟུང་བས་འགལ་བར་འདོད་པ་རྣམས་སེལ་ཏེ་གོ་སླའོ།",
    "བར་ཆད་མེད་པའི་ཏིང་ངེ་འཛིན་བསྐྱེད་པར་བྱའོ་ཞེས་བྱ་བ་ནི་བདེན་པ་གཉིས་སུ་དབྱེར་མེད་པ་ལ་མོས་པ་ཡིད་ལ་བྱེད་པ་དང་།",
    "དེ་ནས་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པའི་ངོ་བོ་དགའ་ལྡན་དུ་སྐྱེས་པ་ནི་གནས་སྐབས་གཉིས་པ་སྟེ།",
    "སོ་སོའི་དོན་རྣམས་ནི་སྐབས་རེ་རེས་ཇི་ལྟར་བསྟན་པ་དང་།",
    "འདི་དག་ནི་གཙོ་བོས་ཡོངས་སུ་དག་པར་མ་བྱས་ན་སྲིད་པའི་བདེ་བ་ཙམ་ལས་བགྲོད་པར་མི་ནུས་པའི་ཕྱིར་རྒྱལ་པོའི་ཕྱག་རྒྱ་དང་བྲལ་བའི་དམག་གི་དཔུང་ལྟ་བུའོ།",
    "དེ་དག་གི་གཙོ་བོ་ནི་གང་གིས་དེ་དག་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བའི་གྲངས་སུ་གཏོགས་པར་བྱེད་པ་ཡུམ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟེ་འདི་ནི་རྒྱལ་པོ་ལྟ་བུའོ།",
    "དེ་ཡང་ས་རེ་རེ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་རེ་རེ་ཞིག་ཤས་ཆེ་བར་ཟད་ཀྱི་དངོས་ཀྱི་ཚུལ་སྤྱད་པའི་ཚེ་ནི་ས་རེ་རེ་ལ་ཡང་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ཅར་སྦྱར་བར་བྱའོ།",
    "དེ་ལྟར་ན་ཇི་ལྟར་སྦྱར་བ་དེ་དག་ནི་གོ་རིམས་བཞིན་དུ་ཚིག་གཞན་དུ་བསྟན་པས་རང་གི་དོན་མིང་གི་རྣམ་གྲངས་ཀྱིས་རྗོད་པར་བྱེད་པ་སྟེ།",
    "གང་གིས་ང་ལ་སྒྲར་ཤེས་ཤིང་།",
    "གང་གིས་ང་ལ་གཟུགས་སུ་མཐོང་།",
    "མཁས་པ་རྣམས་ཀྱི་རང་གིས་རིག་པར་བྱ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་དྲན་པར་བྱའོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་ཡོན་ཏན་རྗེས་སུ་དྲན་པ་ནི་ཕྱིར་མི་ལྡོག་པའི་ས་རབ་ཏུ་བརྙེས་པ།",
    "གཏོང་བ་ནི་སེར་སྣ་སྤངས་པས་སེམས་ལ་ཀུན་ཏུ་འཛིན་པ་མེད་ཅིང་རང་གི་ལུས་དང་སྲོག་ལ་སོགས་པ་རྣམ་པར་འགྱེད་པ་སྟེ།",
    "རྗེ་བཙུན་ལྷ་མོ་སྐུལ་བྱེད་མ་དང་།",
    "དེ་ནས་ཁོ་མོ་སྔོན་ཡོངས་སུ་བསྟེན་པའི་ལྷ་མོ་ཞིག་གིས་བསྐུལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཡོན་ཏན་འཐོབ་པའོ།",
    "ཁོང་དུ་ཆུད་པས་ཞེས་བྱ་བ་ནི་མོས་པ་ཡིད་ལ་བྱེད་པས་སོ།",
    "ད་ནི་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་དང་།",
    "དུས་ལ་མངའ་བརྙེས་པས་སྐད་ཅིག་མ་ཕྱོགས་དང་པོའི་ཡུན་གྱིས་ཀྱང་དེ་བརྙེས་པ་ལ་གནོད་པ་མེད་མོད་ཀྱི།",
    "བར་གྱི་བསྐལ་པ་ལྔ་བཅུར་སྐྱིལ་མོ་ཀྲུང་མ་བཤིག་པར་བཞུགས་པ་ལས།",
    "ཁྱོད་ཀྱི་དང་པོར་ལྷའི་བུ་ཡི།",
    "དེ་ནས་ཉོན་མོངས་བདུད་ཀྱི་ནི།",
    "རིམ་པ་རེ་རེ་ལ་ཡུན་རིང་དུ་མི་གནས་པས་ན་མཐར་གྱིས་པ་སྟེ།",
    "འདིར་ཟག་པ་ནི་རྟོག་པ་དང་ཉོན་མོངས་པ་གཉིས་ཀ་ལ་སྦྱར་རོ།",
    "གང་དག་གིས།",
    "རྣམ་པར་ཤེས་པ་དེ་ནི་ཡུལ་གང་ཞིག་འཛིན་པར་བྱེད་པ་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་དང་ལྷན་ཅིག་ཏུ་ཡང་མ་མཐོང་ལ།",
    "གསང་བ་པའི་བདག་པོ་དེ་དག་བདག་གི་ངོ་བོ་ཉིད་ལ་མ་དཔྱད་པར་བདག་གོ་ཞེས་ངར་འཛིན་པ་ཀུན་ནས་སློང་ངོ།",
    "ནང་གི་བདག་དང་།",
    "བེེམས་པོ་ལ་སོགས་པ་སོ་སོ་རང་གི་མཚན་ཉིད་མ་ལུས་པའོ།",
    "རི་བོང་གི་རྭ་ལྟ་བུ་ནི་མ་ཡིན་ཏེ།",
    "མ་བརྟགས་ན་ཉམས་དགའ་བའི་ངོ་བོ་སྒྱུ་མ་ཙམ་དུ་དེ་དག་རང་རང་གི་མཚན་ཉིད་དུ་ཡོད་པ་ནི་མངོན་སུམ་དུ་གྱུར་པའི་ཕྱིར་རོ།",
    "རང་རང་གི་ཡོད་པའི་མཚན་ཉིད་ལས་ལོག་པ་ཙམ་དུ་གནས་སོ་སྙམ་དུ་རྟོགས་ལ།",
    "གཟུགས་ཀྱི་སྟོང་པ་ཉིད་དང་ཚོར་བ་ལ་སོགས་པའི་སྟོང་པ་ཉིད་གང་དག་ཡིན་པ་དེ་དག་ནི་གཉིས་སུ་མེད་ཅིང་གཉིས་སུ་བྱར་མེད་དེ་སོ་སོ་མ་ཡིན་ཐ་མི་དད་པར་རྟོགས་པར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་དག་ཁྱོད་ལ་མེད་ཀྱིས་དེ་ལ་བརྩོན་འགྲུས་རྩོམས།",
    "ཅི་ཕན་ཁྱོད་ཀྱི་ཉོན་མོངས་འབར་བ་ཀུན་ཞི་ཡང་།",
    "འཇིག་རྟེན་ཉོན་མོངས་མེས་ཚིག་དེ་དག་མི་ལྟ་འམ།",
    "ཡེ་ཤེས་སྒོ་མོ་རྣམ་མང་ཉེ་བར་བསྒྲུབ་པར་མཛད།",
    "ཕྱོགས་རྣམས་ཀུན་ཏུ་སྐད་ཅིག་གཅིག་གིས་རྒྱས་འགེངས་པ།",
    "བདེན་པ་གཉིས་སུ་དབྱེར་མེད་ཅིང་ཕ་རོལ་གྱི་དོན་དང་རྣམ་པར་ཤེས་པ་གཉིས་གང་དུ་ཡང་རྟག་ཏུ་མེད་མོད་ཀྱི།",
    "ཤེས་བྱ་ནང་གི་ཡིན་པ་ཉིད་དུ་བསྒྲུབ་པར་མཛད་ནས།",
    "རྗེས་ལས་ཐོབ་པའི་ཡེ་ཤེས་ཀྱིས་དེ་དག་དབྱེར་མེད་པར་མོས་པ་ཙམ་ཞིག་བྱེད་པ་ནི་སྔར།",
    "དེའི་ཕྱིར་སོ་སོར་འཛིན་པ་ལས་གོ་བཟློག་པའི་ངོ་བོས་ནི་མང་པོ་གཅིག་ཏུ་བསྡུས་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་ཟོ་བའི་དུམ་བུའི་དཔེས་གཅིག་གིས་ཀྱང་མང་པོ་སྡུད་ནུས་པས་ན།",
    "དེ་ལྟར་སྐབས་བདུན་པོ་དེ་དག་གི་རྒྱུའི་གནས་སྐབས་ཡོངས་སུ་རྫོགས་པར་བྱས་ནས།",
    "ཁ་ཅིག་ན་རེ་སློབ་དཔོན་གྱི་ཞལ་སྔ་ནས་ནི་གཞུང་གཞན་དུ་སྐུ་གསུམ་དུ་བསྟན་པས་དེ་ལྟར་བཞེད་མོད་ཀྱི།",
    "ཡང་ན་མཆོག་གི་དོན་གྱི་དངོས་པོ་སྟེ།",
    "དེ་དག་གི་རང་བཞིན་ཞེས་བྱ་བའི་རྣམ་པར་འགྲེལ་པ་ནི་དེ་དག་གི་རང་བཞིན་ནི་ངོ་བོ་ཉིད་དེ་ཞེས་བྱ་བའོ།",
    "མ་བཅོས་པ་ཞེས་བྱ་བ་ནི་མིང་གི་རྣམ་གྲངས་ཏེ།",
    "དེ་དག་གི་རིམ་པར་འབྲེལ་པ་ནི་རྒྱུ་རྣམས་བྱ་བ་བྱེད་པའི་རིགས་པ་ཉིད་ཡིན་པའི་ཕྱིར་དང་།",
    "གཞན་དག་ནི་འདི་ནི་ལུང་གིས་བསྒྲུབ་པ་ཡིན་གྱི་རིགས་པའི་ལམ་གྱིས་བསྒྲུབ་པར་མི་བྱའོ་ཞེས་ཟེར་ཏེ་དེ་དག་གིས་ཀྱང་ལེགས་པར་སྨྲས་སོ།",
    "ཡང་དག་པའི་ཀུན་རྫོབ་ཅེས་བྱ་བ་ནི་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་དེའི་རྗེས་ལས་ཐོབ་པའི་སྣང་བ་ཉིད་ཡིན་གྱི་གཙུག་ལག་ཁ་ཅིག་ལ་བྱིས་པ་རྣམས་ཀྱི་ཐུན་མོང་གི་ཐ་སྙད་ལ་བསྟན་པ་ནི་འདིར་མི་བཟུང་ངོ།",
    "དེ་ནི་མི་རིགས་ཏེ་དེ་དག་གིས་ནི་སྤྲུལ་པའི་སྐུ་ཉིད་ལ་ལོངས་སྤྱོད་རྫོགས་པའོ་ཞེས་མཐོང་བ་བརྩན་པར་བྱས་པའོ།",
    "དེ་དག་གི་ཡུལ་དུ་ནི་སྤྲུལ་པའི་སྐུ་འབའ་ཞིག་སྣང་ངོ།",
    "གང་དུ་ཡང་བདེན་པ་གཉིས་ཕན་ཚུན་འགལ་བས་གཅིག་གིས་གཅིག་སུན་དབྱུང་བར་ནི་མི་བྱའོ།",
    "རང་གི་རྟོག་པས་གཉི་ག་ལས་འགལ་བར་མི་བྱའོ།",
    "རྟོག་པ་དང་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་དང་བྲལ་མོད་ཀྱི།",
    "ཟག་པ་ཞེས་བྱ་བ་ཡང་ཁ་ཅིག་ཏུ་ནི་ཉོན་མོངས་པ་ལ་བྱ་བར་ཡང་མཐོང་སྟེ།",
    "ཡང་ན་བསྐལ་པ་གྲངས་མེད་པ་དུ་མ་ཞིག་གི་བར་དུ་དངོས་པོ་རྣམས་ལ་དོན་དམ་པར་འཛིན་པས་བདེན་པར་འཛིན་པ་སྤང་བ་ལ་རབ་ཏུ་གོམས་པར་མཛད་པས་སྣང་བ་རྣམས་སྒྱུ་མ་ཙམ་དུ་ཡོངས་སུ་མཁྱེན་པའི་ཕྱིར་སྒྱུ་མ་ལྟ་བུའི་རྣམ་པར་རྟོག་པ་མངའ་ཡང་འདི་ལ་ཉེས་པ་མེད་དེ།",
    "དེའི་ཕྱིར་རང་གི་རྣམ་པར་རྟོག་པ་བདེན་པར་འཛིན་པ་ཉིད་བཅོམ་པ་ལ་གཅིག་ཏུ་འབད་པར་བྱའི།",
    "དེའི་མི་མཐུན་པའི་ཕྱོགས་དག་གིས་ཉིད་ཀྱི་རྒྱུད་ལ་ཡོངས་སུ་མི་གོས་པའི་ཕྲིན་ལས་མཛད་དོ།",
    "རྒྱས་པར་སོ་སོའི་ལས་རེ་རེར་ཅི་རིགས་སུ་སྦྱར་ཏེ།",
    "གསུམ་པས་ནི་སྡུག་པར་སྤྲུལ་ནས་ཀུན་ནས་ཉོན་མོངས་པར་མི་འགྱུར་བར་བྱེད་དེ།",
    "ཉོན་མོངས་པ་མེད་པས་ནི་བཀའ་ལུང་གཟུང་བར་བྱ་བར་མཛད་དོ།",
    "ངག་གི་ལས་ཀྱིས་ཀྱང་འདུན་པར་མཛད་དོ།",
    "རང་གིས་བྱས་པ་མ་ཡིན་པ་དང་།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཀྱིས་ནི་ཀུན་ནས་ཉོན་མོངས་པ་མི་མངའ་བར་ཚོགས་ཡོངས་སུ་སྡུད་དོ།",
    "བག་ཆགས་ཡང་དག་པར་བཅོམ་པས་ནི་ཉོན་མོངས་པ་མི་མངའ་བས་ན་ཉོན་མོངས་པ་ལྟ་བུའི་སྤྱོད་པ་མི་སྟོན་ཏོ།",
    "ཐུགས་རྗེ་ཆེན་པོས་ནི་ལྷུན་གྱིས་གྲུབ་པས་རྟག་ཏུ་ཡེ་ཤེས་ཀྱི་སྣང་བས་འཇིག་རྟེན་ལ་གཟིགས་ཏེ།",
    "སྐད་ཅིག་ཙམ་ཡང་མི་གཟིགས་པར་མི་འགྱུར་རོ།",
    "དེ་དག་གིས་ནི།",
    "མཚན་དང་དཔེ་བྱད་བཟང་པོ་འབར་བ་ཞེས་བྱ་བ་ལ་འདི་དག་གིས་སྐྱེས་བུ་ཆེན་པོར་མཚོན་པར་བྱེད་པས་ན་མཚན་དེ་འོག་ནས་འཆད་པའི་སུམ་ཅུ་རྩ་གཉིས་སོ།",
    "འདི་དག་གིས་གཞན་གྱི་རྒྱུད་ལ་རྣམ་པར་སྒོ་བར་བྱེད་པས་ན་དཔེ་བྱད་བཟང་པོ་སྟེ།",
    "དེ་ལ་མཚན་རྣམས་ནི་གཙོ་བོར་གྱུར་པས་རེ་རེ་ཡང་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་དྲུག་གི་རྒྱུ་ལས་བྱུང་བར་བསྟན་ཏེ།",
    "ཇི་སྐད་དུ་སྨིན་མཚམས་ཀྱི་མཛོད་སྤུ་བ་མོ་དང་དུང་དང་མེ་ཏོག་ཀུན་ད་ལྟར་དཀར་བ་ནི་སྦྱིན་པའི་འབྲས་བུའོ།",
    "སེན་མོ་མཐོ་བ་དང་།",
    "སོར་མོ་རྣམས་ཟླུམ་པ་དང་།",
    "སོར་མོ་རྣམས་རྒྱས་པ་དང་།",
    "སོར་མོ་རྣམས་བྱིན་གྱིས་ཕྲ་བ་སྟེ།",
    "དཔེ་བྱད་བཟང་པོ་འདི་དྲུག་ནི་མཚན་ཕྱག་གི་སོར་མོ་རིང་བའི་འཁོར་དུ་གྱུར་པའོ།",
    "སྤུ་རེ་རེ་ནས་གཡས་ཕྱོགས་སུ་འཁྱིལ་བའི་འཁོར་དུ་གྱུར་པའོ།",
    "འབྲུག་གི་སྒྲ་ཉིད་དང་།",
