    "སྔགས་པས་རྟག་ཏུ་ཟློས་བྱེད་དེ་། ཡང་དག་དུས་ནི་ཡིད་ཡིན་ཏེ།",
    "ཞབས་ཀྱིས་མནན་ཅིང་དཔའ་བོའི་འདུག་སྟངས་ཀྱིས་བཞུགས་པ།",
    "དམ་ཚིག་ལ་མི་གནས་པ་རྣམས་ལ་དངོས་གྲུབ་ཆེན་པོར་མི་འགྱུར་ཞེས་དེའི་ཕྱིར་དམ་ཚིག་དང་རང་དད་པའི་ལྷའི་སྦྱོར་བའི་དོན་དུ་དཀྱིལ་འཁོར་སྔོན་དུ་འགྲོ་བའི་གསང་བ་བསྟན་པར་བྱའོ།",
    "རང་རང་དཀྱིལ་འཁོར་ལ་གནས་ཤིང་།",
    "དམ་ཚིག་བཟླས་པའི་མཆོག་དུས་སུ།",
    "ཨོ་ཧི་ལི་ཧི་ལི་བི་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "ཛཱ་ལ་མུ་ཁེ་་པི་ག་ལ་ལོ་ཙ་ནེ།",
    "ༀབཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ།",
    "རོ་ཙ་ན་ནི་གསལ་བའི་ངང་ཚུལ་ཅན་རྟོག་པ་ཐམས་ཅད་རྣམ་པར་འཇོམས་པར་བྱེད་པ་ཁམས་གསུམ་གྱི་སྐུ་གཅིག་པའི་བདག་ཉིད་ཀྱི་ཤེས་རབ་པོ།",
    "རང་རང་ཕྱོགས་ཀྱིས་ཕྱེ་བ་ཡིན།",
    "ང་རང་ལ་བཀོཀ་ན་ཀ་དུས་མ་ཡིན་པར་འཆི་བ་བཟློག་པ་བརྗོད་ནས།",
    "གཉིས་པ་རྡོ་རྗེ་འཇིགས་བྱེད་མ་། གོ་རོ་ཙ་ནི་གསུམ་པ་ཡིན།",
    "ང་རང་ནི།",
    "འཆི་བའི་ཚེ་ན་ཡང་བདག་ཉིད་ཀྱི་མལ་དུ་འདུག་པ་བཞིན་དུ་འམ།",
    "མེད་དོ་ཞེས་བདེ་བར་འདུག་པའི་རིགས་མ་ཡིན།",
    "ཅི་ཕྱིར་བདག་ཉིད་བདེ་བར་འདུག།",
    "འདུག་པར་འགྱུར་ན།",
    "མི་འདུག་གོ་ཞེས་ངེས་པར་བྱས་ནས།",
    "རྐང་པ་རབ་ཏུ་བརྐྱང་བ་ཉིད་ཀྱིས་མི་འདུག་ཅིང་གནས་པར་མི་བྱའོ།",
    "འོན་ཀྱང་རང་ངམ་གཞན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "སྐྱེ་བོ་མིག་རྒྱང་རིང་པོ་དག་དུས་རིང་པོར་མཐོང་བ་ལ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "མི་གཙང་རང་བཞིན་གཞན་གྱི་ལུས།",
    "ལུས་དེ་འདི་ཉིད་ཡིན་ནོ་ཞེས་ཤེས་སུ་ཟིན་ཀྱང་རང་བཞིན་དུ་གནས་པའི་ལུས་ལ་ཡང་།",
    "འདུག་ནས་ཡོངས་འཛིན་སྲུང་བའི་སྡུག་བསྔལ་སྤངས།",
    "ནུས་པའི་དངོས་པོ་བཟང་པོ་གཞན་དག་ལ་འཛིན་པའམ་ཞེན་པར་མི་འགྱུར་ན་ཡང་རང་བཞིན་གྱི་ལུས་ལ་ཡང་ཅིའི་ཕྱིར་མི་འཛིན་ཞེ་ན།",
    "སེམས་ཀྱང་རང་ལ་རང་སྣང་དུ་རུང་བ་ཡིན་ནོ་ཞེ་ན།",
    "ཡང་གྲངས་ཅན་གྱིས་དེ་ཤེས་པ་དང་རང་བཞིན་ནི་ཡོད་པ་ཉིད་དུ་མཉམ་ཞིང་མཚུངས་ཏེ།",
    "གཟུགས་ཅན་གྱི་ལུས་མེད་ཅིང་རང་རིག་པར་འདོད་པ་དེ་ལ་འདུ་བར་མི་འཐད་དོ།",
    "རྣམ་པར་དཔྱོད་པ་ཡང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་ཡིན་ལ།",
    "ནག་ཕྱོགས་མ་རུང་བ་ཚར་གཅོད་བྱེད་མཁན་གྱི་དཔའ་བོ་བློ་རིག་དང་དྲག་རྩལ་ལ་མཁས་པ་ཞིག་ཏུ་བྲིས་འདུགཀླུ་འབུམ་མི་རྒོད་དྭ་ཕྲུག་ཏུ་ལུས་པ་དང་།",
    "ལུས་སུ་རས་ལྭ་དམར་སྨུག་ཚི་སྟུག་ཅན་ཞིག་ཤམ་ཤམ་དུ་གྱོན་ཡོད་པས་ཧ་ལམ་ཁྱིམ་སྔགས་གྲུབ་ཐོབ་ཅིག་ལོས་ཡིན་སྙམ་པའི་སྣང་བ་ཞིག་སྟེར།",
    "རྨི་ལམ་ཡིན་ན་རྨི་ལམ་འདི་མུ་མཐུད་དུ་རྨི་རུ་འཇུག་དགོས་སྙམ་པའི་སྐབས་དེར་རྒད་པོ་དེས་ཁོ་རང་ནགས་ལུང་ཞིག་ཏུ་ཁྱེར་ཅིང་།",
    "རྒད་པོ་དེས་ཨ་ཙི།",
    "ཡུད་ཙམ་འགོར་རྗེས་ཁོ་རང་ཐང་ལ་བཞག་ཡོད་པ་ཤེས་པ་དང་།",
    "འདུག་གྲོགས་རི་དྭགས་གཅན་གཟན་ཡིན་ཞེས་པ་མ་ཐོས་སམ།",
    "ཉིན་བདུན་གྱི་འཕྲོ་ནས་ཁོ་རང་ཡང་རྣལ་སྨྱོན་བཞིན་དུ་སྒོམ་ཐག་ལ་བརྟེན་ནས་སྒྲུབ་པ་རྩེ་གཅིག་ཏུ་མཛད་དོ།",
    "ཕྱི་དྲོ་ཀླུ་འབུམ་གཅིག་པུ་ལ་བསྐྱར་སྦྱངས་བྱེད་དུ་བཅུག་སྟེ་ཁོང་རང་བསོད་སྙོམསལ་འགྲོ་བར་མ་ཟད།",
    "ཆུ་ལེན་ཇ་མ་སོགས་ཀྱི་ལས་ལའང་ཁོང་རང་ཉིད་ཀྱིས་འཇུས་སོ།",
    "དེ་ནས་ཁོ་རང་རིམ་བཞིན་དུ་ནར་སོན་ཏེ་བློ་ཕ་ལ་མི་འདྲི་བ་དང་བྲོ་མ་ལ་མི་སློང་བའི་ཕོ་ལོ་བཅོ་ལྔ་ཅན་གྱི་ན་ཆུང་ཞིག་ཏུ་གྱུར།",
    "བཀྲ་ཤིས་འཁྱིལ་ཁྲོམ་རའི་ཡིན་ནའང་རང་ཉིད་ཀྱི་ལུས་ཟ་ཁང་ཞིག་ནས་ཨ་ལྔ་ལ་བསྒུགས་ནས་བསྡད།",
    "གྲྭ་ཤག་རྣམས་ལས་མཆོད་མེ་ཡི་འོད་ཟེར་གསལ་ལ་མི་གསལ་ཞིག་འཕྲོས་ཡོང་བ་མ་གཏོགས་ཧ་ལམ་མི་མེད་སྒར་སྟོང་ཞིག་ལོས་ཡིན་སྙམ་པའི་ཚོར་སྣང་ཞིག་སྟེར།",
    "ལག་ན་མཚོན་ཆའི་རིགས་མེད་པ་ལ་དཔྱད་ན་ལམ་འགྲོ་བ་ཞིག་ལོས་ཡིན་སྙམ།",
    "ཁྱེད་ཀྱིས་ང་རང་གཡོག་ལ་ཁྲིད་ན་ངའི་སྐྱེ་བ་སྔ་རོལ་གྱི་ཚོགས་བསགས་དང་།",
    "ཁྱི་རྐོ་ལ་ཕ་མས་མིང་ཡག་པ་ཞིག་བཏགས་ཡོད་ཀྱང་རང་ཉིད་ཀྱི་བསམ་དོན་འགྲུབ་ཆེད་ཕོ་སུ་ལ་ཐུག་ཀྱང་འདོད་ཆགས་ཀྱི་ཟུར་མདའ་འཕེན་པ་དང་།",
    "ཀླུ་འབུམ་མི་རྒོད་ཀྱིས་ཁྱེད་རང་ཀླུ་འབུམ་མི་རྒོད་ཡིན་པས།",
    "ཀླུ་འབུམ་གྱིས་མགོ་བོ་ཡར་བཏེགས་ནས་བལྟས་ཙ་ན།",
    "གདོང་ཡོངས་ལ་ཁྲག་མདངས་སྤུ་ཙམ་ཡང་མེད་པར་ཨུཏྤལ་སྔོན་པོ་ལ་བད་ཀྱིས་སྤྱིར་མི་ལས་དགུ་ལས་ཀྱིས་དུག་ལག་བརྒྱབ་པ་བཞིན་སྔོ་ནག་ཏུ་གྱུར་འདུག་དྲུད་པ་དང་མཉམ་དུ་ཕྲག་མགོ་ན་གྲོག་མ་ཞིག་ཡོད་པ་ཇི་བཞིན་ཟ་འཕྲུག་ལངས་པར་བརྟེན།",
    "གང་ལྟར་ཀྱང་རང་སྲོག་བསྐྱབས་པའི་དྲིན་ཆེན་ཡིན་པས་དྲིན་ལན་ཙམ་གཞལ་ཨེ་ཐུབ་བལྟ་སྙམ་ཞིང་།",
    "ཕོ་རྒོད་དེས་དྲག་རྩལ་གྱི་འཇིགས་པ་བསྟན་ཏེ་ཀླུ་འབུམ་ཞེས་མིང་ནས་བཟུང་བ་ལ་ཁོ་རང་སྟབས་སྟབས་པོར་གྱུར་པ་དང་།",
    "ཞལ་གཅིག་ཕྱག་གཉིས་ཅན་གྱི་མི་ལ་མི་སྐྲག་ཀླུ་འབུམ་ཟེར་བ་མི་ཞིག་ལོས་ཡིན།",
    "སྤྱིར་མི་གསོད་དགུ་གསོད་ཀྱིས་ཧབ་ཆ་རྒྱག་དུས་མི་བསད་ན་འདོད་པ་ཡིན་པས།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་ལག་པ་ཚ་ལམ་ལམ་བྱེད་པ་མ་གཏོགས།",
    "བལྟས་ཚོད་ཀྱིས་སྐྱེས་མཆོག་དམ་པ་ཞིག་ལོས་ཡིན་སྙམ་ཞེས་དྲིས།",
    "སྐྱེས་མཆོག་དམ་པ་ཞིག་ལོས་ཡིན།",
    "ང་ཁ་རོག་ལ་ཨེ་འདུག་ལྟོས་ཟེར་བ་དང་།",
    "དཀར་དམར་སེར་གསུམ་གྱི་རུ་དར་ཡང་ལྷབ་ལྷུབ་ཏུ་གཡོ་བཞིན་འདུག་འགྲན་རའི་དཀྱིལ་དབུས་ན་དྲག་རྩལ་འགྲན་སྟེགས་ཏེ་མཐོ་ལ་འདོམ་ཕྱེད་དང་དོ།",
    "ཟི་ལིང་མཁར་དུ་རྩྭ་མི་ཤིང་མི་བཞིན་གཞན་ལ་རྒྱག་ཏུ་བཅུག་ན་ཁྱེད་རང་ངོ་མི་ཚའམ།",
    "ལ་ལས་རྐང་ལྡིག་བྱེད་ཀྱིན་འདུག་པ་ལ་བལྟས་ན་ཧ་ལམ་ཀླུ་འབུམ་ས་སྟེགས་འོག་ལ་རྡོག་ཐོས་གཡུགས་ཀྱང་མ་བསད་པ་ལ་འགྱོད་པའམ་ཀླུ་འབུམ་གྱིས་ངོ་ཡ་མ་བྱེད་པ་ལ་ཡིད་མ་ཚིམས་པ་འདྲ།",
    "བོད་དད་པ་ཅན་ཡིན་པས་འགྱོགས་བྱམས་ལ་མི་འདུག་པ་ཁག་མེད།"
  ]
}