    "རྒྱལ་བློན་རྣམས་ཀྱི་མདུན་དུ་ཉེ་བར་འཁོད་དོ་། གསལ་ལྡན་རྒྱལ་པོརཇི་ལྟར་གླེང་བའི་ཚུལ་གང་དང་གང་ཡིན་པ་ཕེབས་པར་སྨྲས་ཤིང་རང་ཉིད་ཀྱི་ལན་ལྡོག་ཏུ་བྱས་པ་རྣམས་ཀྱང་གསལ་བར་བསྙདཁྱད་པའི་ཚེ།",
    "ཁ་གཅིག་ནི་མི་བདག་གསལ་ལྡན་དེ་ཡང་རང་བཞིན་བཟང་བ།",
    "རང་རང་བསམ་པའི་ཁྱད་པར་མི་མཐུན་པའི།",
    "ཁ་རོག་པར་འདུག་ཅིག་ཅེས་སྤྲོ་བ་དྲག་པོས་ཚར་བཅད་ཅིང་།",
    "སྙོམས་ཆུང་ངུར་འདུག་ཀྱང་བརྙས་བྱེད་པ།",
    "ཐབས་གཡོ་འཕྲུལ་མཁས་ཀྱང་རང་འཕྲུལ་ཡིན།",
    "དཔའ་ཞིང་བརྟུལ་ཕོད་མདུན་ན་འདོན་རྣམས་རང་རང་འདོད་པ་ཐ་དད་སྨྲ།",
    "དེ་ཉིད་ཆབཀྱིས་སྦྲན་པར་བྱས་ལ་དགོས་པ་འགའ་ཡང་འདུག་གམ་སོམས།",
    "བདག་ནི་ཁྱིམ་ན་འདུག་བྱས་ཏེ།",
    "མཚོན་ཆ་བཟུང་བའི་ནུས་པ་འདུག་གམ་སོམས།",
    "བཙན་མཁར་གྱི་རྨང་ན་རྡོ་བ་དེ་ཉིད་འདུག་པ་མཐོང་ནས་རྒྱལ་པོ་ལ་གདས་པར་གསོལ་ལོ།",
    "ཉམས་ཉེས་མི་རུང་རང་སོར་ཞུགས།",
    "མནར་བའི་སྐབས་འདིར་རང་རང་དཔའ་བསྐྱེད་དེ།",
    "རང་རང་ངོ་སྐལ་གྱུར་པའི་ཞི་དྲག་ལས།",
    "སྟན་བདེ་བར་འདུག་ཚེ་འཇིགས་འཇིགས་སྨྲ།",
    "ཁྱིམ་ཕུན་སུམ་ཚོགས་པར་འདུག་པ་དང་།",
    "རང་རང་བགོ་སྐལ་གྱུང་པའི་ལས་སྒྲུབས་ཤིག།",
    "བདག་ནི་ན་ཚོད་ཕྲ་ཞིང་བྱ་བ་དང་བྱ་བ་མ་ཡིན་པའི་གནས་མི་ཤེས་པས་ཁབ་འདིར་འདུག་པ་གནས་མ་ཡིན་པས་གནང་བར་མཛོད་ཅིག།",
    "ཟླ་མེད་སྨྲ་བཅད་གཅིག་པུར་ཇི་ལྟར་འདུག།",
    "རྩ་དང་ཆུ་ཡང་རང་དགར་འདོར་བྱེད་ལ།",
    "རྒྱལ་ཁབ་སྟོང་བའི་གནས་འདིར་ཅི་ཕྱིར་འདུག།",
    "རང་རང་ལོངས་སུ་སྤྱོད་པར་མི་ནུས་ཤིང་༏",
    "གཅན་གཟན་རི་དྭགས་མཉམ་དུ་འདུག་པ་ལྟའི།",
    "བཟློག་སྟེ་ཁོ་རང་ཞག་ཟླ་མ་འགྱངས་པར།",
    "དམ་ཉམས་དགྲ་བོ་ཁོ་རང་ཕྱོགས་རྣམས་ལ།",
    "རང་རང་ཕྱོགས་སུ་སྐུ་ཟུར་ཅིག།",
    "རྐང་པ་གཡས་པ་དྷཱན་གཡོན་པའི་རྩར་གན་རྐྱལ་དུ་བཞག་པ་ནི་དཔའ་བོའི་འདུག་སྟངས་སོ།",
    "རྐང་པ་གཡས་པ་སེམས་དཔའི་སྐྱིལ་ཀྲུང་བཅས་ལ་འབྱིང་བ་དང་བཅས་པས་གཡོན་པ་བརྐྱང་བ་ནིལ་པའི་འདུག་སྟངས་སོ།",
    "རྐང་པ་གཉིས་ཁ་སྦྱར་ལ་འདུག་པནི་བཀྲ་ཤིས་ཅན་ནོ།",
    "ཅོད་པན་གྱིས་བརྒྱན་པ་དཀྱིལ་འཁོར་གྱིས་གཞིའི་དབུསཨུཤར་དུ་ཕྱོགས་པར་འདུག་པ་འམ།",
    "པེ་གུ་ང་རང་ང་དགའ་བའི་མྱུ་གུ་དང་།",
    "བཅོམ་ལྡན་འདས་ལ་ཕྱོགས་པས་དར་སྦྱོར་འདུག་སྟེ།",
    "དེའི་དབུས་སུ་སྣ་ཚོགས་པདྨ་དང་ཉི་མའི་སྙིད་དུ་འཇིགས་བྱེདང་ས་མཚན་གཡོན་བསྐུམགཡས་བརྐྱང་བས་མནན་པའི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པ་རྒྱལ་བའི་བཅོན་ལྡན་འདས་ཁྲོ་བོན་པསལ་པོ་འཇིག་དུས་ཀྱི་མེ་ལྕ་བུའི་འོད་ཟེར་འབར་ཞིང་འགྲོ་བ་མ་ལུས་པའི་བགེགས་ཀྱི་ཚོགས་ཐམས་ཅད་རབ་ཏུ་བཀལ་བར་མཛྷོད་པ་སྐུམེདགེ་སྔོན་པོ་དང་སེར་བོ་དང་ལྗང་ཁུའི་ཞལ་རྩ་བ་དང་གཡས་དང་གཡོན་གྱི་མི་བཙུགས་བ་གདབ་པ།",
    "ལས་དང་རྗེས་འཐུན་པར་འདོད་པོའི་རྣལ་འབྱོར་ཀྱིས་བསྲུང་བའི་ཆོ་ག་དང་བཟླས་པ་བྱ་ཞིང་མི་སྨྲ་བའཇམ་ཞིང་ཤིན་ཅུ་བདེ་ཕོའི་ལྟན་ལཔདྨའི་འདུག་སྟངས་ཀྱིས་འདུག་ལ་སྲིད་ལ་ཁ་ཤར་དུ་ལྟས་ལ་བློསཾ་བྷཱསབ་བྱ་ལ་དམིགས་ནས་དཀར་པོའཚོསགཅིག་ནས་བརྩམས་ཏེ་ཞི་བའི་ཡིད་ཀྱིས་ཞི་བའི་ལས་བྱའོ།",
    "ཚིག་ལྷུག་པའི་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབསོ། མཁས་པ་ཆེན་པོ་ཨ་ཙ་ཡ་ལས་དགེ་སྦྱོར་ཚུལ་བློམས་རྒྱལ་མཚོན་གྱི་ན་བ།",
    "སྤང་པ་ཙ་ན་དྷཱི",
    "ཐམས་ཅད་མཁྱེན་པ་རྡོ་རྗེ་གདན་གྱི་དབེན་གནས་ཡོལ་དཀར་ཞེས་བྱ་བ་ཞིག་ཡོད་པ་དེར་སྐུ་མཚམས་ལ་བཞུགས་ཡོད་པས་ཁྱེད་ལ་སྐུ་མདུན་དུ་ཤོག་ཟེར་བནྡེ་གཞོན་ནུ་ཞིག་བྱུང་སྟེ་དེ་དང་འགྲོགས་ནས་ཡོལ་དཀར་དུ་བྱོན་པས་བུག་སྒོའི་ནང་ན་དབུ་སྐྱ་རིལ་ལེ་བཞུགས་འདུགངེད་ཀྱིས་འདིར་མཚམས་ཤིག་བྱས་པ་ཡིན་ཏེ།",
    "སྐྱེ་བ་དྲན་པའི་ཚིག་ཐོག་མ་དེར་འདུགདེ་དུས་ཡང་ཡུམ་གྱིས།",
    "ཁྱེད་རང་ང་ལ་མ་འཐབ་གསོལ་བ་ཐོབ།",
    "ཁྱེད་རང་ལ་ཡང་ངས་བསྟོད་པ་གཅིག་ཨེ་རྩོམ་སྨྲས་པས།",
    "ཅི་འདུག་གསུང་།",
    "དེའི་ཚེ་རྟ་ནག་ཕུ་ན་ཐམས་ཅད་མཁྱེན་པའི་སྐུ་སྐྱེ་ཡོད་པ་འདུག་ཟེར་བའི་གྲགས་པ་ཆེན་པོ་བྱུང་།",
    "ད་དུང་གནང་བ་ཞུ་ཟེར་བའི་ཞུ་ལན་ཡང་བྱས་འདུགདེའི་ཚེ་གསོལ་དཔོན་སྒྲོལ་མས་སྐད་ཆ་ཚོར་ནས་མཇལ་དུ་འགྲོ་དགོས་སྙམ་ནས།",
    "མཁའ་སྤྱོད་གནས་སུ་ཐེགས་ཙ་ན།",
    "མཁའ་སྤྱོད་གནས་སུ་ཕེབས་ཙ་ན།",
    "ཁྱེད་རང་སྣག་ཤོག་གྲབས་གྱིས་ཟེར་ནས་བྱས་འཕྲལ་དུ།",
    "གཙོ་བོ་འཁོར་ལོ་བདེ་མཆོག་བཞུགས་འདུག་པའི་མདུན་དུ་ཕྱིན་པས།",
    "དེ་ཡན་ཆད་རབ་ཏུ་མ་བྱུང་བའི་བྱིས་པའི་སྐབས་ཀྱི་ཀུན་སྤྱོད་དུ་གདའོ།",
    "ཐུགས་ཅུང་ཟད་མ་མཉེས་པའི་ཚུལ་སྟོན་གྱིན་འདུག་པས་བཀྲ་ཤིས་ལྷུན་པོར་སྡོད་རིང་ལའང་ཐུགས་ལ་ཕོག་དོགས་ཤ་སྟག་བྱསདེ་ནས་སློབ་དཔོན་རྣམ་པས་ཀྱང་བཀའ་བགྲོས།",
    "ད་འགྲོ་དགོས་པ་འདུག་སྙམ་པ་ཤར་ཏེ།",
