    "དེ་ཚོ་ལ་སྡུག་བསྔལ་དང་རློམ་སེམས་རེ་དོགས་སྐྱེས་ན་གེགས་སུ་འགྱུར།",
    "མ་དག་པའི་ལུས་ཀྱི་གནས་ལྔར་ཉོན་མོངས་ལྔ་ཡི་ས་བོན།",
    "གཏུམ་མོ་ཡེ་ཤེས་ཀྱི་མེས་བསྲེགས་པས་གཞན་ལ་མྱོང་འགྱུར་གྱི་འབྲས་བུ་འབྱིན་པའི་ཉོན་མོངས་རྣམ་རྟོག་སློང་བའི་ཚོགས་ལམ་དང་པོ།",
    "བདེ་ཆེན་དང་སྟོང་ཆེན་རེས་འཇོག་ཏུ་འཆར་བའི་སྦྱོར་ལམ་ལྔ་པ་རྣམས་བགྲོད།",
    "དེ་ནས་སྔར་མ་མཐོང་བའི་བདེ་སྟོང་རོ་གཅིག་གི་དོན་དང་པོར་མཐོང་པའི་མཐོང་ལམ་ས་དང་པོ་རབ་ཏུ་དགའ་བ་བགྲོད་དོ།",
    "ཕྲིན་ལས་བཞི་གྲུབ་ཆེན་བརྒྱད་སོགས་ཐུན་མོང་གི་གྲུབ་པ་ཐོབ།",
    "ལམ་ཚད་དུ་བྱིན་པས་མཆོག་གི་དངོས་གྲུབ་བཅུ་གསུམ་རྡོ་རྗེ་འཛིན་པའི་ས་བརྙེས།",
    "སྐྱོབ་པ་འཇིག་རྟེན་མགོན་པོ། ། ན་མོ་རཏྣ་གུ་རུ།",
    "རྒྱལ་བ་མཆོག་གི་ཞལ་ནས་གསུངས་པ་ཡི།",
    "དེ་ཡང་ཚོམས་བདུན་གྱི་ས་གཅོད་ཀྱི་དམིགས་འབྱེད་པ་དང་པོ་ནི་འདི་ཡིན་ཏེ།",
    "༧ འཁོར་ལོ་གསུམ་ནི་གནས་དང་དུས་ལ་སོགས་པའི་ཁྱད་པར་གྱིས་འབྱེད་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "མཚན་ཉིད་མེད་པ་ནི་ངེས་དོན་དུ་སྟོན་པ་མང་མོད་ཀྱི།",
    "༡ བཀའ་ཐམས་ཅད་དྲང་བའི་དོན་དང་ངེས་པའི་དོན་ལ་སོགས་པར་བསྟན་པས་འགའ་ཞིག་དེ་བཞིན་གཤེགས་པས་ཐབས་ཀྱིས་བརྫུན་པར་གསུངས་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡༤ རིམས་ཀྱིས་འཇུག་པ་དང་གཅིག་ཆར་འཇུག་པ་གཉིས་སུ་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡༥ སྒྲིབ་པ་ཐམས་ཅད་ནི་ཐོག་མར་ལས་ཀྱི་སྒྲིབ་པ་དེ་ནས་ཉོན་མོངས་པའི་སྒྲིབ་པ་དང་།",
    "མཐར་ཤེས་བྱའི་སྒྲིབ་པ་སྤོང་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡༩ མུ་སྟེགས་ཀྱི་ལྟ་སྤྱོད་སྒྲུབ་པ་ཐམས་ཅད་སྤང་བྱ་འབའ་ཞིག་ཏུ་འདོད་པ་ཡོད་མོད་ཀྱི།",
    "འདིར་ནི་ཕྱི་ནང་གི་ཁྱད་པར་སྐྱབས་སུ་འགྲོ་བར་བཞེད་དོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ལ་སོགས་པས་ལམ་བགྲོད་པའི་ཁྱད་པར་དུ་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༨ བདེ་སྡུག་ཐམས་ཅད་ནི་སྔོན་གྱི་ལས་ཁོ་ན་ལ་རག་ལས་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༩ འཕེལ་འགྲིབ་ཀྱི་དུས་ནི་རང་བཞིན་གྱིས་བྱུང་བ་ལ་ཐབས་ཀྱིས་མི་ཕན་པར་འདོད་མོད་ཀྱི།",
    "༡༤ བསྟན་པ་དང་ལམ་གྱི་རིམས་པ་༣ཐམས་ཅད་རིམས་ཀྱིས་ཉམས་སུ་བླང་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "འདིར་ནི་ལམ་རིམས་ཐམས་ཅད་ཐུན་གཅིག་གི་ནང་དུ་ཉམས་སུ་བླང་བར་བཞེད་དོ།",
    "འདིར་ནི་དགེ་སྦྱོང་གི་འབྲས་བུ་ཐོབ་པའི་བར་ཆད་ལས་སྡོམ་པ་སྐྱེ་བའི་བར་ཆད་མ་ཡིན་པར་བཞེད་དོ།",
    "༥ སྡོམ་པའི་ངོ་བོ་ནི་སྤོང་བའི་སེམས་པ་ས་བོན་དང་བཅས་པ་ལ་སོགས་པ་འདོད་ལུགས་ལེགས་པར་འདོད་པ་མང་མོད་ཀྱི།",
    "༨ འཆི་འཕོ་ལ་སོགས་པས་སྡོམ་པ་གཏོང་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "འདིར་ནི་གཏོང་བའི་རྒྱུ་དེ་དག་གིས་མི་གཏོང་བ་ཡང་ཡོད་པར་བཞེད་དོ།",
    "དགེ་སྦྱོང་དུ་མི་རུང་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡༡ རང་བཞིན་མི་གནང་བཀག་པ་ཡིན་ཞིང་བཅས་པ་ལ་ནི་གནང་བཀག་གི་སྐབས་ཡོད་པར་འདོད་པ་མང་མོད་ཀྱི།",
    "༡༤ འགྲོ་བ་གཞན་དག་ལ་བཅས་པ་ལ་འདས་ཀྱང་ཉེས་པ་མེད་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "གཞན་ལ་མ་ཡིན་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "འདིར་ནི་འགྲོ་དྲུག་གང་གིས་བསྲུངས་ཀྱང་ཕན་ཡིན་ཆེ་བར་བཞེད་དོ།",
    "༡༦ བཅས་པ་ནི་རྐྱེན་ལས་ལྟོས་པས་དགག་བཅས་ནི་གནང་བའི་ཚེ་ན་ཉེས་མེད་དུ་འགྱུར་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡༧ ཆོ་ག་མེད་པར་བསྲུངས་ཀྱང་ཆོག་པར་འདོད་པ་འགའ་ཞིག་འབྱུང་ངོ་ཞེས་གྲགས་མོད་ཀྱི།",
    "གདོད་ནས་མ་ཐོབ་པ་ནི་ཉེས་པ་མེད་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༣ འཇུག་པའི་སྡོམ་པ་ནི་ས་ཐོབ་ནས་སྐྱེ་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༤ སྡོམ་པ་གསུམ་པོ་མཐའ་དག་མ་ཐུབ་ན་འཇུག་སྡོམ་དུ་མི་འགྱུར་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "ཉོན་མོངས་པ་མ་ཡིན་པ་གཉིས་སུ་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "རང་གཞན་གྱི་སྡུག་བསྔལ་བརྗེ་བར་གསུངས་པ་ཡིན་མོད་ཀྱི།",
    "༡༢ སྒྲིབ་པ་གསུམ་ཐ་དད་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "འདིར་ནི་སྒྲིབ་པ་གསུམ་ཉོན་མོངས་ཀྱི་སྒྲིབ་པ་འབའ་ཞིག་དུ་གཅིག་པར་བཞེད་དོ།",
    "འདིར་ནི་སེམས་ཙམ་པ་ནི་ས་བདུན་གྱིས་མངོན་རྟོགས་རིང་དུ་སོང་བར་བཞེད་དོ།",
    "༡༦ ས་དང་པོ་ནས་བདག་མེད་གཉིས་རྟོགས་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "འདིར་ནི་རྟོགས་པ་གཅིག་གིས་ས་ལམ་མ་ལུས་བགྲོད་པར་བཞེད་དོ།",
    "འདིར་ནི་རྟོགས་པ་གཅིག་གིས་ས་ལམ་མ་ལུས་བགྲོད་པར་བཞེད་དོ།",
    "༥ བསྐྱེད་རིམ་མ་ཡིན་པ་ལ་བརྟགས་པས་ཀུན་བཏགས་སུ་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "འདིར་ནི་ལྷ་ལ་སོགས་པ་མོད་རྒྱུད་དུ་གསུངས་པ་གཙོར་བྱ་དགོས་པར་བཞེད་དོ།",
    "ཆོ་ག་མང་པོ་ནི་ཐ་མ་ཡིན་པས་ཆེད་མི་ཆེ་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡ ཆོ་ག་རྒྱས་པ་ཐམས་ཅད་ནི་དྲང་དོན་དུ་སྤྲོས་པ་ལ་དགའ་བ་ལ་གསུངས་པ་ཡིན་མོད་ཀྱི།",
    "འདིར་ནི་རྡོ་རྗེའི་ལུས་ཀྱི་གནས་ལུགས་ནི་ཟབ་མོའི་འཁོར་ལོར་བཞེད་དོ།",
    "འདིར་ནི་གནས་ལུགས་འགའ་ཞིག་རྡོ་རྗེ་འཆང་གིས་སྦས་པར་བཞེད་དོ།",
    "༡༧ དྲང་དོན་དང་ངེས་དོན་ཐ་དད་དུ་རྟོགས་པས་ཕྱོགས་རེ་རེ་མཐུན་པས་ཆོག་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡༩ སྐུ་གསུམ་གྱི་རྒྱུན་ནི་སྐྱོན་མེད་པའི་ཏིང་ངེ་འཛིན་དུ་འདོད་མོད་ཀྱི།",
    "འདིར་ནི་སྐུ་གསུམ་རེ་རེ་ཡང་སྐུ་གསུམ་ཀའི་བདག་ཉིད་དུ་བཞེད་དོ།",
    "༢༢ གསང་སྔགས་ནི་འདོད་པ་སྤྱོད་པས་གྲུབ་པར་གསུངས་པ་ཡོད་མོད་ཀྱི།",
    "༢༣ གསང་སྔགས་ནི་གཞི་ཉོན་མོངས་པ་དུག་གསུམ་བསྒྱུར་བའི་ལམ་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "འདིར་ནི་ཉོན་མོངས་པ་དག་པའི་འབྲས་བུ་བདེ་བར་གཤེགས་པ་ཡིན་པར་བཞེད་དོ།",
    "༢༨ ནམ་མཁའ་མ་ཞིག་གི་བར་དུ་མི་ཐོན་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "གཏེར་མ་ལ་སོགས་པ་ཟབ་ཅིང་ངོ་མཚར་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "ནང་གི་བློ་དང་མ་འབྲེལ་བར་འདོད་པ་ཡོད་མོད་ཀྱི།",
    "༣ འཁོར་འདས་ཀྱི་རྒྱུ་འབྲས་ཐམས་ཅད་ནི་དུས་ཡུན་རིང་པོ་ལ་ལྟོས་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༤ རང་བཞིན་གཅིག་ཏུ་མ་ངེས་པས་གང་ལྟར་བལྟས་པ་དེ་ལྟར་འགྱུར་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "འདིར་ནི་རྟོགས་པ་སྐྱེ་བར་བྱེད་པའི་ཐབས་མོས་གུས་ཁོ་ནར་ངེས་པར་བཞེད་དོ།",
    "༩ ཐོས་བསམ་སྒོམ་གསུམ་ལས་བྱུང་བའི་རྟོགས་པ་རྣམས་ནི་རྟོགས་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "སྤྱོད་པ་ནི་དགེ་སྡིག་གི་བླང་དོར་དང་བྲལ་བར་འདོད་མོད་ཀྱི།",
    "༡༤ ཕྱག་རྒྱ་ཆེན་པོ་ལ་སྐྱོན་ཡོན་གང་ཡང་མེད་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡༨ རྟོགས་པ་ཡོད་ཕྱིན་ཐབས་ལམ་ལ་སོགས་པ་ལ་དགོས་པ་མེད་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡༩ རྟོགས་པའི་བོག་འདོན་པ་ལ་རིག་པ་བརྟུལ་ཤུགས་ཀྱི་སྤྱོད་པ་སྣ་ཚོགས་པ་རྣལ་འབྱོར་པའི་ཆ་ལུགས་ཀྱིས་དུར་ཁྲོད་དུ་རོལ་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༢ མཉམ་བཞག་ཆེན་པོ་བྷུ་སུ་ཀུ་ནི་མཐར་ཐུག་པའི་སྤྱོད་པ་ཡིན་པར་འདོད་མོད་ཀྱི།",
    "༡༢ སྐུ་གཉིས་དང་ཡེ་ཤེས་ནི་གཞན་སྣང་དུ་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡༤ སྐུ་གསུམ་ནི་གནས་ཐ་དད་ན་འཁོར་ཐ་དད་པར་སྟོན་པ་ཡིན་མོད་ཀྱི།",
    "མ་ཐོས་མི་འཛིན་དེ་ནི་དམོན་པ་ལྟར།",
    "དམན་དང་མཆོག་གི་བྱེ་བྲག་རབ་ཕྱེ་སྟེ།",
    "བན་ལྡོམ་ཤེས་རབ་འབྱུང་གནས་བདག་གིས་བྲིས།",
    "རྫུ་འཕྲུལ་གྱི་བཀོད་པ་རེ་རེ་ཞིང་ཡང་ཤེས་བྱའི་མཐར་ཐུག་པ་བརྙེས་པས་ནམ་མཁའི་མཐའ་དང་མཉམ་པར་དཔེ་ཟླ་ཐམས་ཅད་དང་བྲལ་བ།",
    "འདིར་ནི་བརྒྱད་ཁྲི་བཞི་སྟོང་ཉོན་མོངས་པའི་གཉེན་པོར་བཞེད་དོ།",
    "འདིར་ནི་གཅིག་གི་ནང་དུ་ཡང་བཅུ་གཉིས་པོ་ཐམས་ཅད་ཅི་རིགས་སུ་ཚང་བར་བཞེད་དོ།",
    "༥ ཕུན་སུམ་ཚོགས་པ་ལྔས་ནི་བཀའ་མིན་པ་ལ་མ་ཁྱབ་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "འདིར་ནི་ཕན་ཚུན་འབྲེལ་བ་ཅན་གྱི་ཚུལ་དུ་འདྲེས་ཅན་དུ་གསུངས་ཏེ་རེ་རེའི་ནང་དུ་ཡང་གསུམ་ཀ་ཚང་བར་བཞེད་དོ།",
    "༩ མུ་སྟེགས་དང་བོན་གྱི་སྒོར་ཞུགས་པས་བདེན་པ་མཐོང་བར་འདོད་པ་ཡོད་མོད་ཀྱི།",
    "༡༤ སྡོམ་པ་གསུམ་གོང་ནས་གོང་དུ་ཡངས་སུ་འགྲོ་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༡༦ ཉན་རང་ནི་ཐེག་ཆེན་གྱི་རིགས་ཆད་པས་སངས་མི་རྒྱ་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༢༡ རྨི་ལམ་དུ་ས་བོན་ཉམས་པ་ལ་ཉེས་པ་མེད་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༢༢ ས་དང་པོ་ཐོབ་ནས་ངན་འགྲོའི་འཇིགས་པ་མེད་པར་འདོད་པ་ཡོད་མོད་ཀྱི།",
    "འདིར་ནི་ས་ཐོབ་ཀྱང་ངན་སོང་དུ་སོང་བ་ཡོད་པར་བཞེད་དོ།",
    "༢༧ སྐུ་གསུམ་གྱི་མཛད་པ་གསུམ་དུ་ངེས་པར་འདོད་པ་ཡོད་མོད་ཀྱི།",
    "འདིར་ནི་དེ་ཡང་ཡིན་ཏེ་ལྷ་གཅིག་གིས་ཀྱང་ཕྲིན་ལས་ཐམས་ཅད་འགྲུབ་པར་བཞེད་དོ།",
    "༢༨ ལྷ་རེ་ལ་མཚན་ངེས་པ་ཅན་རེ་རེ་ཡོད་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༢༩ གསང་སྔགས་ནས་དུས་བཞིར་རྩ་བའི་དམ་ཚིག་གནང་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༣ འགའ་ཞིག་ན་རེ་ལྷ་ལ་དང་པོ་ནས་འཇུག་ཏུ་མི་བཏུབ་སྟེ་རིམས་ཀྱིས་འཇུག་པ་ཡིན་ཟེར།",
    "༣༡ བསྐྱེད་རིམ་བརྟན་པར་བྱེད་པ་ལ་བསྙེན་པའི་གྲངས་གཙོ་བར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༣༢ དཀའ་ཐུབ་ལ་སོགས་པ་ནི་ལྷ་ལ་བརྙས་པར་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "༣༥ བསྲུང་བའི་འཁོར་ལོ་ནི་ཁྲོ་བོ་དང་རྡོ་རྗེ་ར་བ་ལ་སོགས་པ་ཟབ་པར་འདོད་པ་ཡོད་མོད་ཀྱི།",
    "༤༢ ཕྱག་རྒྱ་ཆེན་པོ་ལ་དགེ་མི་དགེ་གཉིས་ཀས་སྒྲིབ་པར་འདོད་པ་ཡོད་མོད་ཀྱི།",
    "༤༤ བསྒོམ་བྱ་སྒོམ་བྱེད་གཉིས་མེད་ནམ་མཁའ་གཉིས་འདྲེས་ནི་མཐར་ཐུག་ཏུ་འདོད་པ་ཡིན་མོད་ཀྱི།",
    "དེ་རེ་རེ་ལ་ཡང་བྱེ་བྲག་གི་བཞེད་ལུགས་མཐའ་ཡས་པར་འགྲོ་བས།",
    "བཞེད་པ་འདི་དག་གི་ཕྱག་རྒྱས་ཐེབས་ཤིང་གཞིག་འཁྲུལ་ཚུད་པ་ལ་ཐུབ་པའི་བཀའ་མཐའ་དག་གི་དགོངས་པ་དང་མཐུན་པར་རང་ཉིད་རྒྱུད་ཐོག་ཏུ་སྦྱོར་ཤེས་ཤིང་གོ་བར་གྱུར་བ་དེ་དག་གིས།",
    "ཉོན་མོངས་པའི་སྐྱོན་ཐམས་ཅད་ཀྱིས་གོས་པ་མེད་པ་དང་བཞིའོ།",
    "རེ་རེར་ཡང་བཞི་བཞིར་གྱེས་པ་འདི།",
    "འཁོར་འདས་གཉིས་རང་གི་སེམས་ལ་འདུས།",
    "ཤཱ་མོང་གི་སུལ་བཞིན་མ་འདྲེས་པར་སོ་སོར་ཤན་ཕྱེ།",
    "གདུགས་ཀྱི་ཏོག་གི་ཚུལ་དུ།",
    "མཁྱེན་བཟང་རལ་གྲི་རྣོན་པོས་ཉོན་མོངས་གཅོད།",
    "ཟབ་མོ་སྔགས་ཀྱི་ལམ་བཟང་གསལ་མཛད་པ།",
