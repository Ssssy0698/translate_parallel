    "དེའི་ཁོངས་སུ་དམག་མི་སྟོང་ཕྲག་བཅུ་ཡོད་པས་དོན་དུ་དམག་མི་ཁྲི་གཅིག་གི་དམག་དཔོན་ཡིན།",
    "སྟོང་བུ་ཆུང་གི་རྗེ་ནི།",
    "སྟོང་དཔོན་གྱི་འོག་ཏུ་ཡོད་ཅིང་དམག་མི་སྟོང་ཕྲག་འགའ་ཞིག་གི་དམག་དཔོན་ཡིན།",
    "སྐབས་རེ་ལྔ་བརྒྱ་ཆེན་པོ་བསྐོས་པ་དང་།",
    "སྐབས་རེ་ལྔ་བརྒྱ་ཆེན་པོ་དེ་སྟོང་བུ་རྗེར་བཅོས་ཞེས་འཁོད་འདུགདམག་མིའི་འབོར་གྲངས་ལས་འཕྲོས་ཏེ་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོའི་སྐབས་བོད་ཀྱི་མི་འབོར་ཇི་ཙམ་ཡོད་སྐོར་དཔྱད་གཞིར་གླེང་ན།",
    "ཁྱིམ་ཚང་རེར་མི་གྲངས་གསུམ་རེ་དང་།",
    "དམག་མིར་སོང་བའི་མི་གྲངས་ཁྲི་དྲུག་ཅུ་རེ་གཅིག་པོ་ཕུད་པའི་ལྷག་མ་མི་གྲངས་ཁྲི་བཞི་བརྒྱ་བརྒྱད་ཅུ་གྱ་བརྒྱད་ཡོད་དགོས་པ་རེད།",
    "འབངས་མི་དེའི་ནང་ཚོང་པ་དང་།",
    "ཚང་མའི་བཀོད་འདོམས་སྤྱི་ཁྱབ་པར་མངན་དཔོན་ཁབ་སོ་འོ་ཅོག་གི་བླ་ཞེས་ཟེར།",
    "བཙན་པོའི་རྗེས་སུ་འབྲལ་མེད་འབྲངས་ཏེ་སྐུ་སྲུང་གི་ལས་འགན་སྒྲུབ་མཁན་དཔོན་རིགས་ཤིག་སྟེ།",
    "རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོའི་གོང་གི་རྒྱལ་རབས་ཁ་ཤས་ཀྱི་སྔོན་ལ་དེ་འདྲ་ཡིན་སྲིད་རུང་།",
    "རང་གིས་ས་ཞིང་གསར་དུ་སྦོལ་ནས་བཏབ་པ་རྣམས་ས་ཞིང་གི་ཐོ་ཡིག་ཏུ་བཀོད་དགོས་པ།",
    "ཞིང་པ་ཁྱིམ་མི་རེར་ས་ཞིང་བགོས་པའི་ཚད་གཞི་ནི།",
    "དོར་གཅིག་གི་གོ་དོན་ནི།",
    "རྨོན་མཛོ་ཆ་གཅིག་གིས་ཉིན་གཅིག་རིང་རྨོ་ཐུབ་པའི་ས་ཞིང་གི་རྒྱ་ཁྱོན་ལ་ཟེར་ཞིང་།",
    "དོར་ཕྱེད་ལ་མུའུ་ལྔ་ཡིན་པའི་སྐོར་ལི་ཡུལ་ནས་ཐོན་པའི་ཤ་ཇུའི་ཁྱིམ་མིའི་གྲངས་དང་ས་ཞིང་བགོས་པའི་ཐོ་ཡིག་གི་ནང་ཁྱིམ་དུད་ཉི་ཤུ་ལྷག་ཙམ་གྱི་མི་གྲངས་དང་ཁོ་ཚོར་བགོས་པའི་ས་ཞིང་གི་ཐོ་འགོད་སྐབས་བོད་ཀྱི་ས་ཞིང་བགོས་པའི་ཚད་གཞི་དང་།་",
    "ཚོད་དཔག་བྱས་ན་ཕལ་ཆེར་ས་ཞིང་དོར་གཅིག་གི་ས་ནས་ཐོན་པའི་ཐོན་འབབ་སྤྱིའི་བསྡོམས་གྲངས་ཀྱི་དྲུག་ཆ་གཅིག་ནི་དཔྱ་ཁྲལ་གྱི་ཚད་གཞི་ཡིན་ནམ་སྙམ་ཞིང་།",
    "དེས་མ་ཟད་ལི་ཡུལ་ནས་ཐོན་པའི་ས་ཞིང་གི་ཐོ་ཡིག་ནང་ས་ཞིང་ཐོབ་པའི་ཞིང་པ་རྣམས་ལ་སོན་འབྲུ་ས་ཞིང་གི་བདག་པོས་སྤྲོད་དགོས་ལུགས་གསལ་བ་དེར་བརྟགས་ན་ཡང་ས་ཞིང་གི་ཐོན་འབབ་སྤྱིའི་བསྡོམས་གྲངས་ཀྱི་དྲུག་ཆ་གཅིག་གི་དཔྱ་ཁྲལ་ཕུད།",
    "ཁྲལ་གཞན་དག་གི་སྐོར་གང་ཡང་མི་གསལ་ཞིང་།",
    "ཚད་གཞི་དེ་དངོས་པོ་བརྗེ་ཚོང་གི་སྐབས་རིན་ཐང་གི་ཚད་གཞི་དང་།",
    "ཡི་གེ་ནི་མི་རྣམས་ཀྱི་བསམ་བློ་ཕན་ཚུན་བརྗེ་རེས་བྱེད་རྒྱུ་དང་།",
    "སྲོང་བཙན་སྒམ་པོའི་གོང་དུ་བོད་གནའ་རབས་ཀྱི་ཡི་གེ་ཞིག་ཡོད་པ་དེ་ནི་ཞང་ཞུང་གི་ཡི་གེ་ཡིན་པ་དང་།",
    "སྟག་རི་གཉན་གཟིགས་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "གལ་ཏེ་ཡིག་ཐོག་ཏུ་འཁོད་མེད་པའི་ངག་རྒྱུན་ཙམ་ཞིག་ཡིན་ན་མི་རབས་སུམ་ཅུ་ལྷག་བརྒྱུད་ཐུབ་པ་ལྟ་ཞོག་མི་རབས་ཁ་ཤས་སོང་མཚམས་སུ་ངག་རྒྱུན་ཙམ་ཡང་ལུས་མི་སྲིད་དེ།",
    "ཞུང་གི་སྐད་དུ་ལ་དོན་གྱི་ཕྲད་གུ།",
    "དེ་བཞིན་ཞང་ཞུང་གི་སྐད་དུ་ན་ལ་ལུ་ལེ་བཞི་ཡོད་པ་རྣམས་ཐོན་མིས་ན་ལ་གཉིས་སུ་བསྡུས་པར་མཛད་ཅིང་།",
    "ཞང་ཞུང་གི་སྐད་དུ་འབྲེལ་སྒྲ་ལ་གི།",
    "སི་བཅས་བཅུ་ཡོད་པ་རྣམས་ཐོན་མིས་འབྲེལ་སྒྲ་གི་ཀྱི་གྱི་འི་ཡི་ལྔར་བསྡུས་པར་མཛད་པ་ཡིན་ཞེས་གསུངས་པ་དེར་ང་ཚོས་ངེས་པར་དུ་མཐོང་ཆེན་དང་བརྟག་དཔྱད་ཞིབ་འཇུག་བྱེད་འོས་པ་ཞིག་རེད་སྙམ།",
    "༡དེང་སྐབས་ང་ཚོས་བེད་སྤྱོད་བྱེད་མུས་ཡིན་པའི་བོད་ཡིག་འདི་ཐོག་མར་གསར་གཏོད་མཛད་སྐབས་དུས་སྐབས་དེའི་བོད་ས་གནས་སྤྱིའི་ཐུན་མོང་གི་སྐད་གཞིར་བཟུང་བ་ཡིན་པས་ཁྱབ་ཆེ་བ།",
    "བོད་སིལ་བུའི་དུས་སྐབས་སུ་ལོ་ཙཱ་བ་བརྒྱ་དང་ལྔ་བཅུ་ལྷག་ཙམ་བྱོན་པ་དེ་དག་གིས་རྒྱ་ནག་དང་།",
    "མཚན་ཉིད་རིག་པ་སོགས་ཆ་ཚང་བར་སྟོན་ཐུབ་པ་དང་བོད་སྐད་དུ་བསྒྱུར་ཐུབ་པ་དེ་རེད།",
    "འོ་ན་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོས་རང་གི་མི་རིགས་ཀྱི་རིག་གཞུང་སྔར་ཡོད་རྒྱུན་འཛིན་དང་འཕེལ་རྒྱས་བཏང་ཡོད་ན།",
    "སྙན་ངག་གི་ཉམས་དང་ལྡན་པའི་གླུ་གཞས།",
    "རོལ་མོ།",
    "འགའ་ཞིག་ལ་ཚན་རིག་གི་ཆུ་ཚད་ཅུང་ཟད་མཐོ་ཙམ་ཡོད་པ་བཅས་འདིར་རེ་རེ་ནས་བརྗོད་ཀྱིས་མི་ལངས་ཤིང་།",
    "གཞན་ཡང་ལྡེའུ་དེང་སང་གི་གབ་ཚིག་ཞེས་པའི་རིག་རྩལ་གྱི་དྲི་བ་དང་དྲིས་ལན་འགའ་ཞིག་རི་མོར་བྲིས་པ་དཔེར་ན།",
    "མཆོད་རྟེན་གྱི་གཟུགས་རི་མོར་བྲིས་པ་དང་།",
    "མགར་བ་ཞིག་གིས་ལྕགས་དམར་པོ་སྐམ་པས་བཟུང་ནས་ཐབ་ཀྱི་ནང་དུ་བཅུག་ཅིང་ཕྱིར་འདོན་པ་ཞིག་རི་མོར་བྲིས་པས་མཚོན།",
    "སྔར་ཡོད་རིག་རྩལ་གྱི་ནང་ནས་མི་རྣམས་ཀྱི་བློ་སྒོ་འབྱེད་པར་ཕན་ཐོགས་ཡོད་པ་རྣམས་ཡི་གེ་དང་གཟུགས་སྣང་ཅན་གྱི་རི་མོ་ཟུང་འབྲེལ་བྱས་ཏེ་བཀོད་པ་དེས་གནའ་རབས་ཀྱི་གབ་ཚིག་དང་འབྲེལ་བའི་སྙན་ངག་གི་ཉམས་འགྱུར་མཚོན་པར་བྱས་ཡོད་པ་མ་ཟད།",
    "མོང་བཟའ།",
    "རྒྱ་བཟའ་འུན་ཁྲེན་ཀོང་ཇོ་གཉིས་བཙུན་མོར་བླངས་པའི་དམིགས་ཡུལ་ནི།",
    "དེར་བརྟེན་ཐོག་མར་བལ་པོའི་རྒྱལ་པོ་སོ་མ་འབྲི་ཤོ་སྟེ་འོད་ཟེར་གོ་ཆའི་སྲས་མོ་བལ་བཟའ་ཁྲི་བཙུན་བཙུན་མོར་བླངས་པ་དང་དུས་མཚུངས་ཇོ་བོ་མི་བསྐྱོད་རྡོ་རྗེ་སོགས་སྐུ་རྟེན་མང་པོ་དང་།",
    "ལྷ་ས་གཙུག་ལག་ཁང་གི་སྟེང་ཁང་དང་བར་ཁང་།",
    "ཁོང་རྣམས་བོད་དང་ས་ཐག་ཉེ་བའི་ཐོག་གནམ་གཤིས་ཀྱང་མི་འཕྲོད་པ་མེད་སྟབས་ལྷ་བཟོ་མང་ཆེ་བ་བལ་ཡུལ་ནས་འབོད་འགུགས་བྱས་པ་རེད།",
    "ཕྱོགས་མཚུངས་ཐང་རྒྱལ་རབས་ཀྱི་གོང་མ་ཐང་ཐའི་ཙུང་གི་ཚ་མོ་འུན་ཁྲེན་ཀོང་ཇོ་བཙུན་མོར་ལེན་ཆེད་དྲག་པོའི་དམག་འཐབ་དང་ཞི་བའི་རེ་ཞུ།",
    "སྣ་མང་གི་རྩལ་འགྲན་བཅས་བྱ་ཐབས་མང་པོ་བརྒྱུད་དེ་མཐར་རྒྱ་བཟའ་འུན་ཁྲེན་ཀོང་ཇོ་སྲོང་བཙན་སྒམ་པོའི་བཙུན་མོར་ཐོབ་པ་མ་ཟད།",
    "གཞན་ཡང་རྒྱ་རིགས་ཀྱི་བཟོ་བོ་མཁས་པ་མང་པོ་བོད་དུ་གདན་དྲངས་ཏེ་རྒྱ་སྟག་རྭ་མོ་ཆེའི་གཙུག་ལག་ཁང་བཞེངས་ཤིང་།",
    "ཐང་བོད་དབོན་ཞང་གི་འབྲེལ་བ་ནམ་ཡང་ཆད་མ་མྱོང་བ་སོགས་ལྷ་ས་གཙུག་ལག་ཁང་གི་མདུན་ངོས་སུ་ཡོད་པའི་ཐང་བོད་མཐུན་འབྲེལ་རྡོ་རིང་ཐོག་གསལ་བར་འཁོད་པ་ལྟར་ཡིན་ནོ།",
    "མཐར་རྒྱུ་རྐྱེན་གང་ཞིག་ལ་བརྟེན་ནས་རྩ་འཐོར་སོང་བ་བཅས་ཀྱི་བརྒྱུད་རིམ་དང་།",
    "གཉིས་ཕན་ཚུན་བལྟ་སྡུར་བྱས་ཐོག་སླད་ཕྱིན་རང་རེའི་ལྗོངས་དང་བོད་མི་རིགས་ཀྱི་མདུན་ལམ་གང་འདྲ་ཞིག་ཡིན་པའི་སྐོར་བཅས་གླེང་རྒྱུ་ཡིན།",
    "བྲན་གཡོག་བདག་པོར་རང་གི་བྲན་གཡོག་གཞན་ལ་འཚོང་བ་དང་།",
    "རྒྱལ་པོའི་བློན་པོ་དང་བཙུན་མོ།",
    "བཙན་པོ་འདས་རྗེས་བཙུན་མོ་དང་བློན་པོའི་གཙོ་བོ་འགའ་ཞིག་རང་ཉིད་མ་ཤི་བར་དུ་བཙན་པོའི་བང་སོ་སྲུང་མཁན་དུ་བཞག་པའི་དོན་ཡིན་པ་ལས།"
  ]
}