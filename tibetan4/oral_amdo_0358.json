    "༧༤ གང་གི་ལྷག་བསམ་ལྟར་གསལ་ཉིད།",
    "ཕུན་ཚོགས་དྲི་བསུང་གིས་དྲངས་པའི།",
    "༨༢ རྨིག་པས་བརླངས་པའི་རྡུལ་གྱི་དབུས་ཞུགས་བོང་བུར་གནས་པའི་ཤ་ཟ་མོ།",
    "ཞུགས་ཀྱི་སྲེག་ལྡན་རལ་གྲི་བཟུང་ཞིང་འཁྱོག་པོའི་སྨིན་མ་ཡོངས་བསྡུས་ནས།",
    "དམ་པ་མཆོག་གིས་གཏེར་གྱི་བྱ་བ་ལ།",
    "མཆོག་གི་ལས་ལ་བསྐུལ་བའི།",
    "སྲོག་གི་ཐག་པ་གཅོད་དོ་ཞེས།",
    "སྣང་བའི་རི་མོར་སྤྱོད་པའི་སེམས།",
    "གཞན་ཕན་བརྣག་པའི་རྗེས་སོང་དམ་པའི་སྤྱོད།",
    "༩༧ མི་བཟད་གདུག་པ་འབྱུང་པོའི་དཔུང་ཚོགས་ཀྱིས།",
    "མཆོག་གི་ངོ་མཚར་མྱུ་གུ་འཁྲུངས་པ་བཞིན།",
    "ཁྱོད་ཉིད་རེ་བ་གང་ཕྱིར་གང་དུ་འགྲོ།",
    "ཀུན་དགས་རེ་བའི་ཤིང་རྟ་ཁེངས་མི་འགྱུར།",
    "༡༤ གཟེངས་བསྟོད་མོད་ལ་ཉི་མས་ལམ་དྲངས་ཕྱིར།",
    "གཟིགས་པ་འབྱམས་ཀླས་བཀུར་བསྟི་བྱེད་པ་བཞིན།",
    "བར་མའི་སྒྲོམ་གྱིས་ཕྱག་གི་པདྨ་བརྒྱན།",
    "གད་མོ་སྒྲོག་འདྲ་གཞན་ཡང་དཀར་མིན་སྤྲིན།",
    "༡༨ འཇིགས་བྱེད་ལྟས་མཐོང་དཀུ་བའི་དྲི་བསྣམས་མོད།",
    "ལས་དཀར་རེ་ཁཱ་སྤེལ་བའི་སྒྱུ་མས་ཀྱང་།",
    "སྐལ་བཟང་ལང་ཚོ་བསྐྱེད་པའི་བདུད་རྩི་དེ།",
    "རྣམ་པར་བམས་པའི་མི་རོ་གཟིགས།",
    "རྩུབ་མོའི་ཟུར་ཅན་རྡོ་བའི་ཁྲོད།",
    "བཅད་ནས་རྣམ་གྲོལ་མཆོག་གི་རྩེར།",
    "འགྲོགས་ལྡན་ཟུང་གི་ཙཱ་ར་ཎས།",
    "ལྷན་ཅིག་དགའ་བའི་རྩེ་མོར་འཛེག།",
    "ཟབ་གཏེར་མཆོག་གི་ཕྱོགས་སྐྱེས་ཀྱིས།",
    "རང་གིས་རྣམ་དབྱེ་རབ་གསང་པུ་སྟ་ཀ་ཡི་རིན་ཆེན་བྱུང་།",
    "བསྐྱེད་བྱ་སྨིན་བྱས་རེ་བ་གང་བ་རྩེ་མོའི་བགྲང་བྱར་འཕེལ།",
    "ཚུལ་འདི་གཅིག་མིན་འཇིག་རྟེན་མིག་སྟེ་དབྱིག་གི་ཁུ་བ་ཡང་།",
    "འབྱམས་ཀླས་ཕྱོགས་སུ་བདག་གིས་བཀོད།",
    "༡༣༢ གཏེར་དེའི་དཔྱད་འོས་རྣམ་པར་བརྩམས་པའི་སྐབས་ཀྱི་ངོ་མཚར་གླེང་བ་དྲུག་པའོ། དཔལ་གྱི་བདག་པོ་ས་གསུམ་རྩེ་མོར་བརྗིད།",
    "རང་གིར་མི་རྟོགས་སྒྲིབ་ཞལ་ཅན།",
    "༡༣༨ མཁྲེགས་ལྡན་རིམ་དགུ་བྲག་གི་རྒྱ།",
    "བསྲུབས་པས་པདྨ་བསྐྱེད་རྗེས་སོང་།",
    "གཟིགས་ཚེ་ལྔ་ལྡན་འཇའ་འདིས་ཕྱུར།",
    "ཐལ་མོས་རྡེབ་ཅིང་རྣམ་འགྱུར་མི་བརྟན་པར།",
    "སྒྲོམ་བུ་རང་གིས་བྱེ་བར་གྱུར།",
    "རྣམ་གསལ་སྟག་གི་ཤམ་ཐབས་ཅན།",
    "༡༥༣ གང་གི་སྐུ་གསུང་ཐུགས་རྡོ་རྗེ།",
    "དགེ་སྦྱོང་ཚུལ་ལས་ཉམས་པ་དག་གིས་བཟུང་།",
    "སྲེག་པའི་རེག་བྱར་མ་དེས་ཐེ་ཚོམ་ཅན།",
    "འབྲི་དང་ཟླ་བའི་ཆུ་ཀླུང་དག་གི་ངོགས།",
    "༡༦༣ མ་རུངས་འབྱུང་ཚོགས་དེ་ལ་ཕྲག་དོག་པས།",
    "གློག་གི་སྐུད་པས་དྲངས་པའི་གནམ་ལྕགས་མདའ།",
    "རང་གི་བདག་པོར་བཟུང་བ་འདི་ཁོ་ནས།",
    "འཛུམ་པའི་རྩེད་མོས་འདུལ་ལ་ཐབས་དེ་བསྟན།",
    "གཟིགས་པས་ཐུགས་ལ་ཟུག་རྔུ་ལྡང་བའི་རྩེ།",
    "རབ་འབྱམས་ལྷ་ཡི་ལྟད་མོའི་ཕྲེང་།",
    "བསྙེངས་བྲལ་གད་མོ་སྲིད་རྩེར་བསྒྲགས།",
    "དོན་ཆེན་འབྲས་བུར་གཟིགས་པ་ཡིས།",
    "ལྷོ་ཕྱོགས་ཟླ་བའི་ཆུ་ཀླུང་གི།",
    "༡༧༨ ལྕི་ཞེས་གྲགས་པ་ལྗོངས་འབྲོག་གི།",
    "མི་གཡེལ་གཟིགས་པ་མ་སྦས་པར།",
    "༡༨༡ རེ་ཐག་ཆད་པའི་སེམས་བྱུང་མཐའ།",
    "བརྒྱ་བྱིན་རང་གི་ལག་ཆ་ངོམ།",
    "༡༨༣ དེ་ཡི་དགོངས་པ་ཟབ་མོའི་ཀློང་།",
    "ས་ཡི་ཐིག་ལེ་རེ་རེ་ལ།",
    "མགོན་ལ་འདོད་པའི་རེ་བ་བསྐྱུངས།",
    "༡༨༨ ད་རེས་འདོད་ལ་ཡིད་མི་རྟོན།",
    "མཐའ་དག་རང་གི་གཟུགས་བསྟན་ནས།",
    "༡༩༤ རྩུབ་མོའི་བྱ་བ་བརྟུལ་མཛད་ཅིང་།",
    "ཐལ་བྱུང་ཤིན་ཀུན་ཤེལ་བཟང་འདོག་པ་མང་པོར་བཞིན།",
    "ཡེ་ཤེས་གཟིགས་པ་ཆེན་པོར་གྲགས་པ་དེ་ཙམ་མོ།",
    "རྡོ་རྗེའི་སྲོག་གི་གཟེར་བཟང་གྲུབ་ཁྱོད་མི་གནས་ཕྱིར།",
    "༡༩༩ རོལ་པ་མཆོག་གི་རྡོ་རྗེ་ཅན།",
    "མཛེས་པ་གཟིགས་གྱུར་རིགས་དྲུག་ལྟས།",
    "༢༤ མ་རྨོངས་གཟིགས་པ་དེ་ཡི་ཚེ།",
    "རེ་ཞིག་བར་དུ་ཡི་རངས་མཛད།",
    "༢༧ གཟིགས་པ་ཤིན་ཏུ་རྣམ་དག་ཕྱིར།",
    "མཆོག་གི་ཞིང་དུ་རྣམ་པར་དྲངས།",
    "ད་ལྟའི་བར་དུ་རེ་བའི་མཐའ།",
    "མཆོག་གི་ལུས་སྟོབས་ཆེན་པོར་བསྐྱེད།",
    "༢༡༧ གང་གི་གཅུང་གྱུར་ཨོ་རྒྱན་མཚན།",
    "ཚངས་རིས་དུད་མོས་ཡིན་ནམ་སྙམ།",
    "༢༣༣ རྟག་པའི་མཐའ་མ་རེ་བ་ཡི།",
    "འབྲིང་དང་མཆོག་གི་ཐེག་གསུམ་ལས།",
    "བརྡེག་པར་འདོད་པའི་ཁུ་ཚུར་གྱིས་བསྣུན་མ་ལུས་ཟུག་རྔུ་བྲང་གིས་བཟོད་ནས་སྐྱོབས་པ་བཞིན།",
    "འཁྲིལ་ལྡེམས་གདུང་གི་ཕྱོགས་སུ་གཞོལ་བ་དང་།",
    "ཕྲ་མོའི་སྐེད་སྐབས་གཡོ་བ་མ་མཐོང་ནས།",
    "རང་གི་གདེངས་ཀས་མྱ་ངན་སྐྱོབས་པ་བཞིན།",
    "ས་བོན་ཙམ་འདི་སྙན་དངགས་ལ་དགའ་བསྟན་པའི་ཉིན་བྱེད་བདག་གིས་སོ།",
    "ཚིག་གི་སྲད་བུས་སྦེལ་བ་འདི།",
    "རྩལ་སྦྱོང་སྒྱུ་མར་ངེས་བ་རྙེད་རེ་ནས།",
    "སྟག་སྣར་བདག་གི་རྡོ་རྗེ་སློབ་དཔོན་མཆོག།",
    "ཇོ་ནང་དུ་ཡང་སྐུ་འབུམ་ཆེན་མོ་སོགས།",
    "དེ་ཚེ་རྗེ་བཙུན་མི་ལའི་པུར་ཐལ་ལས།",
    "དེ་ནས་རྔམ་པ་སྒྲ་སྒྲོག་ཤིང་གི་མདུན།",
    "རྨི་ལྟས་ཉིན་མོའང་བག་ཆགས་འཐས་པར་ཞུགས།",
    "མཚན་མོར་རྣལ་འབྱོར་འཛིན་ནུས་གྱུར་ཞེས་སྨྲ།",
    "སད་ཁོར་དབྱངས་ཅན་སྔོན་མོའི་སྐུ་བརྙན་དང་།",
    "སྒྲུབ་ཕུག་འགའ་རེ་མཇལ་ནས་ཡམ་བུ་རུ།",
