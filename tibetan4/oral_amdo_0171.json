    "འོག་གི་ཕྱུགས་རབས།",
    "མི་དང་མི་མ་ཡིན་མཐའ་དག་གིས་ཕལ་ཆེར་གནོད་པ་མེད་ཅིང་།",
    "རེ་རེ་ཙམ་གྱི་གནོད་པ་བགྱིས་པ་རྣམས་ལ་ཕྱི་ལམ་ཁེགས་པའི་ལྟས་དང་ཆོ་འཕྲུལ་གྱི་ཚར་བཅད་པས་ཕྱིསུ་ཇག་པ་དང་ཐུགས་པ་དུ་མ་ལ།",
    "དྲུང་མཁས་པ་སོང་བློ་བ་སོགས་འགའ་ཞིག་གིས་བྱོན་དུས།",
    "ཏི་སེ་སེང་སྡོང་དཀར་མོ་སྐུའི་གནསུ་གཞན་ཕན་གྱི་བསྒྲུབ་པ་ལ་གཞུགས་པའི་སྐོར་ཚོ་སྟེ་བདུན་པའོ།",
    "གཞན་ཕན་གྱི་བསྒྲུབ་པ་བྱེད་པ་ཡིན་མོད་གསུང་།",
    "གཉེར་པ་རྡོ་རྗེ་རྒྱལ་མཚན་རྣམས་ཀྱི་གསོལ་བ་ནན་ཆེར་བཏབ་པྨརྗེ་ཡི་གསུང་གིས་མི་མ་ཡིན་རྣམས་འདིར་གདད་ན་དགའ་བ་འདུག་པ་ཡིན་ཏེ།",
    "ཁང་གི་འོག་ཐུབ་པ་གནས་བཅུས་སྐོར་བའི་སྟེང་ཁང་རྡོ་རྗེ་འཆང་ལ་གྲུབ་ཆེན་རྒྱ་བཅུས་བསྐོར་བ།",
    "འོ་ན་ལྷ་ཁང་འདིའི་གཙོ་བོ་གུང་གི་རྡོ་རྗེ་འཆང་འདིའི།",
    "ཨ་སྐྱང་སྐུ་རེ་བྱས་པ་ཡིན་ཚིག་པ་ཟ་མི་དགོས་གསུང་།",
    "ད་དུས་ཚོད་ཀྱི་ལོང་བས་ལོང་བའི་ལམ་མཁན་བྱེད་པ་རང་མང་འདུག་ཨང་གསུང་དེ་ནས་ཡང་གོས་བྲིས་འདི་དག་གི་བཀོད་པ་བྱེད་མཁན་སུ་ཡིན་གསུང་ཚེ།",
    "གར་ཐིག་དབྱངས་གསུམ་སོགས་གསང་སྔགས་གྱི་ཕྱག་ལེན་དང་གུར་སྟག་སམ་གསུམ་སོགས་རྒྱུད་ལ་རང་རེ་གཉིས་རྩོད་དོ་གསུང་བ་ལ།",
    "དེ་ནས་ལྷའི་ཕྱག་ཚད་གར་ཐིག་སོགས་སྡོམ་འབྱུང་གི་རྒྱུད་དང་།",
    "དེ་དུས་དྲུང་ནས་མོན་རྩེ་བ་འཇལ་དུ་བྱོན་པ་ལ་རྗེའི་ཞལ་ནས་བུ་ཁྱོད་ཀྱི་འཕྲིན་ལས་དང་གདུལ་བྱ་ཡང་སྟོད་ཆེ།",
    "གངས་ཏི་སེ་འདི་ན་རང་རེའི་གྲ་པ་ཁ་རེ་ཙམ་གྱིས་སྡོད་མཁན་དང་།",
    "ཕ་ཡི་བསམ་པ་རྫོགས་ཕྱིར་ཁྱོད་ཀྱིས་འཛིན་དགོས་གསུང་བ་ལ།",
    "དེ་ནས་ལོ་གཉིས་སོང་ཚེ།",
    "ཁྱད་པར་གསུང་མགུར་གཟིགས་པས།",
    "སོ་སོ་སྐྱེ་བོ་ཡེ་ཤེས་རང་གི་བཅིངས།",
    "དེའི་དབྱར་ཅིག་གཟིམས་ཁང་གི་རྒྱབ་རི་དངུར་གདོང་བྲག་རིའི་རྩེ་ནས་བྲག་གཡག་རོ་ཙམ་གསུམ་འུར་ཆོམ་དང་ཐུག་ཆོམ་གནམ་ས་བགྲུབས་འགྲོ་བ་ཙམ་དང་བཅས་ཏེ།",
    "ཉེར་བས་མི་རྣམས་ནི་གཟིམས་ཁང་གི་ཐོག་དུ་རྡོ་འབབ་པ་མཐོང་སྟེ།",
    "རྗེ་དགོངས་པ་ལ་གཞུགས་པས་གཟིམྨ་ཁང་གི་སྟེང་གི་བར་སྣང་དུ་བྲག་ཐམས་ཅད་དུམ་བུར་ཐོར་ནས་གཡས་གཡོན་དུ་བྱེར་ཞིང་།",
    "ཐམས་ཅད་ངོ་མཚར་ཞིང་དགའ་ཆེ་ལ་ངུ་གྲོ་ལ་དད་པ་དང་མོས་གུས་ཀྱི་ངང་ནས།",
    "རྗེ་ཡི་གསུང་གི་འབན་རལ་ཤིའམ་གསུང་།",
    "ཚུར་གཅིག་ལས་མ་ཤི་ཕར་འགའ་རེ་ཤི་ཟེར་བས།",
    "དེ་ནས་དབུས་པའི་གྲ་པ་དྲུག་གིས་རང་རེའི་གྲ་པ་ལྔ་བཅུ་ཙམ་ལ་ཉི་མ་མང་པོ་ཚུར་སྙད་བཙལ་བཟོད་པ་ལན་དུ་མར་སྒོམས་ཤིང་ཡ་མ་བྱས་ཀྱང་།",
    "འཇབ་གྲི་རྒྱབ་ནས་རང་རེའི་གྲ་པ་གཅིག་ཤི་ཟེར་བའི་ངེས་པ་ཅན་གསན་པས།",
    "བུ་མོ་ཞིག་སྐྱེ་བ་འདུག་གསུང་།",
    "དད་ཅན་བུ་མོ་ཐུགས་རྗེ་བཟང་མོ།",
    "རང་ལུས་སྐྱེས་པའི་དྲིན་ཅན་ཨ་མ།",
    "དེ་ཡང་དང་པོ་རྗེ་ཡང་ཐུགས་ཅིས་ཤིན་ཏུ་ཆེ་ཞིང་ཁོང་རང་ཡང་མཆོག་ཏུ་མོས་ཤིང་ཡོངས་གྲགས་ཀྱི་བུ་ཆེན་དུ་ཡང་གྱུར།",
    "སྔགས་པ་དེ་ལ་རོ་སྙོམས་སྐོར་དྲུག་གི་སྤེ་ཆ་ཤིན་ཏུ་སྤུས་དག་པ་གཅིག་ཡོད་པ་རྐུས་ཏེ།",
    "ཁོ་རང་གི་མལ་སྒྲོམ་འོག་དུ་སྦས།",
    "ཁྱོད་ཀྱི་ང་ལ་རྨ་འབེབས་བྱས་པ་ཡིན་ངེས།",
    "ཁྱོད་དཔོན་སློབ་ངའི་སྤེ་རྐུས་པས་མ་ཆོག་ང་ལ་བློ་ཤེད་བྱེད་ན་དེ་ཀ་ཡིན།",
    "དེ་ནས་ཁོང་དཔོན་སློབ་ཀྱི་ཀྱང་གཡུ་མོ་ཆེ་ཤིན་ཏུ་ལེགས་པ་གཅིག་སོགས་འབུལ་བ་སྟོབས་ཆེ་བ་དང་།",
    "ལར་རང་བདུད་ཆེན་པོ་ཅིག་གི་ཟིན་པ་འདྲའ།",
    "དེ་དག་གི་སྐད་ཆ་རྣམས་ཀོང་པོའི་སྔགས་པས་ཐོས་པས།",
    "རྗེ་ལ་གཏིང་ནས་ལོག་ལྟ་སྐྱེས་མི་མཚམ་པའི་སྐུར་པ་ཁ་ན་མ་ཐོ་བ་དུ་མ་ཁོང་རང་གི་དྲུང་དུ་བྱུང་ཚད་ལ་གསུངས།",
    "དེ་ནས་རྗེས་ཁྱོད་བདུད་ཀྱི་བྱིན་ཀྱི་རླབས་པ་ཡིན་གསུང་བ་སོགས་བཀའ་ཅུང་ཟད་སྐྱོན་པས་དེ་བས་ཀྱང་ཆེར་ལོག་པར་ལྟ།",
    "བདུད་ཀྱི་བྱིན་གྱིས་རླབས་པའི་སྟོབས་གྱིས་མོན་རྩེ་རྟོགས་ལ་གནང་སྦྱིན་གུར་དཀར་ནག་ཁལ་མ་སོགས་དེ་ཙམ་མཛད།",
    "རྣམས་རྟོག་ཟོས་ཀྱང་ད་དུང་རྗེ་ལ་ཅུང་མཚོང་གི་བང་ཆེན་གཉིས་སྟང་ཏེ།",
    "ད་ཁྱེད་རང་ཚོར་བ་བདུད་ཀྱི་མ་ཁྱེར་བ་གྱིས་གསུང་ཤིན་ཏུ་ཐུགས་སྐྱོ་བའི་ཚུལ་དུ་མཛད།",
    "ཁྱོད་རང་བསམ་བློ་ཐོང་།",
    "སླར་མི་བཟོད་པར་འདྲེ་ཟློག་པའི་ཟུག་ངུ་སྐད་ངན་སྨྲེ་སྔགས་དང་བཅས་དམ་ཚིག་ལ་སྐྱོན་བྱུང་ནས་ལོ་གཅིག་ལྷག་ཙམ་ལ་སྙུང་གི་ཟིན་ཅིང་།",
    "ཀྱེ་མ་ཀྱི་ཧུད་ཉམས་རེ་ཐག་ཕུན་ཚོགས་ཡོན་ཏན་ལྡན་ལྡན་པ་སྐྱོན་གྱི་ནོངས།",
    "སྐྱོན་ཅན་དུག་གི་གཡོས་སྦྱོར་ཇི་བཞིན་དུ།",
    "རང་གཞན་མཐའ་དག་ཕུང་བྱེད་ཡ་རེ་ང་།",
    "ཐུན་མོང་གི་རྟོགས་ལྡན་བརྒྱད་ཀྱི་ནང་ནས།",
    "ལོ་རེ་བཞིན་ཤིང་ཀུན་སྐོར་བའི་རྣལ་འབྱོར་པ་རྣམས་ལ་ལི་ཡུལ་གྱི་རྒྱལ་པོ་ར་ངན་མ་ལ་དང་།",
    "བལ་བོད་ཀྱི་ལོ་ཙྪ་བ་བ་རོང་སྙི་ཤ་བ་གི་རྒྱལ་པོ་སླ་སྤྱད་པའི་གཙོ་བོ་སློབ་དཔོན་རྗེ་བཙུན་དང་ཁྱི་ཁུ་རྣམས་ཀྱི་ཞུ་ཡིག་རྟེན་དང་བཅས་གསོལ་བ་ཡང་ཡང་བཏབ་རུང་།",
    "རེ་ཞིག་ཞལ་གྱིས་མ་གཞེས།",
    "དད་པ་ཅན་གྱི་ཡོན་བདག་ཕོ་མོ་རྣམས་ལ་རྗེ་ཉིད་ཀྱི་བཀའ་ཤོག་རྟེན་དང་བཅས།",
    "རྗེ་ཡི་གསུང་གི་ལེགས་མདུན་མའི་གཞི་ཚུགས་བྱུང་གསུང་ངོ།",
    "གཟིམས་ཁང་གི་མཁར་ལས་མཛད།",
    "ཆུ་ཁ་དུག་དུ་ཆུ་གཉེར་གྱི་སྒོམ་ཆེན་པ་རེ་གཞག་ནས་མཚན་དུས་རོང་ལ་ཆུ་འབོད་ཅིང་།",
    "ལན་གཅིག་ཆུའི་ཆེ་ཆུང་གི་རྐྱེན་བྱས་རི་ཐེབས་གཉིས་འཁྲུགས་པས།",
    "ལ་ཕྱི་གནས་མ་ལག་གཉའ་ནང་གི་ཡོན་བདག་དང་བཅས་པས་མགོ་གཅིག་བྱས།",
    "འོ་འབྱུང་ཆུ་བར་བ་རང་གིས་བདག་བྱས།",
    "ཆེ་ཞིང་བློན་པོར་སོང་བས་དངོས་སུ་འབུལ་མ་ནུས།",
    "གཟིམས་ཁང་གི་མཁར་ལས་སྣང་ཚེ།",
    "སུས་ངན་སྔགས་བྱས་པ་བྱུང་ཡང་ང་དང་ཁ་ལབ་མེདོ་གསུང་དམ་ལ་གཞགོདེ་དུས་བུ་སློབ་འགའ་ཞིག་གིས་ཞུས་པ།",
    "ཡང་ན་ཁོས་ཞི་བའི་སྒོ་ནས་འབུལ་ནི་མི་འབུལ་བར་འདུག་རང་རེ་དཔོན་སློབ་ལ་མ་ཚུགས་རུང་ཡོན་བདག་རྣམས་སྡུག་ཅིང་།",
    "རབ་ཏུ་རྗེ་རང་གི་རྫུ་འཕྲུལ་འམ་མཐུ་སྟོབས་ཀྱི་ཚར་གཅོད་པ་ཞུ།",
    "དིང་སང་ཁོང་ལ་མི་ཉན་པའི་མི་ཡྀ་འདུག་ཞེས་ཞུ་བ་ནན་ཅན་ཡང་ཡང་ཕུལ་བས། རྗེ་དུས་གསུམ་ཁྱེན་པའི་གསུང་གིས་ཁྱེད་རྣམས་ང་དང་བསྟན་པའི་ཞེན་མ་བཟོད་པ་ཡིན་ནའང་།",
    "ཁྱེད་ཚོའི་ཁ་ལད་མི་ཉན་གསུང་བས་རེས་གཅིག་དེ་ཀའི་ངང་ལ་སོང་།",
    "འོ་འབྱུང་གི་སྐོར་ཕྱིས་ཤིང་ཀུན་གྲུབ་རྗེས།",
    "འོ་འབྱུང་དུ་ཡུམ་ཀུན་ཏུ་བཟང་མོ།",
    "ངེད་རང་གིས་ཀྱང་གྲོགས་སུ་ཅི་འགྱུར་བྱེད་པས།",
    "རྒྱན་བཟང་པོ་དང་ལྡན་ཞིང་ལྷ་དང་ལྷ་མོ་ལྟར་ཡིད་དུ་འོང་ལ་མཛེས་པའི་ཕོ་མོ་ལྔ་བརྒྱན་དང་ལྔ་བཅུ་རྩ་དྲུག་དང་།",
    "རྒྱལ་པོའི་བློན་པོ་ཨ་ཕ་འཛའ་དྲག་གི་ཞུས་པ།",
    "དེ་རིང་གི་བསུ་བའི་རོལ་མོ་བ་རྣམས་དང་།",
    "འབའ་རོ་ཁྲ་ཁུར་མགོ་ཆེ་བའི་བསུ་བ་རྣམས་ལ་འདྲ་མེན་རེ་རེའི་སྣང་སྦྱིན་མཛད་དགོས་ཟེར་བས་རྗེ་ཡི་གསུང་གི་དེ་རིང་བསུ་བ་དེ་རྣམས་རྒྱལ་པོ་དང་ཨ་ཕས་བཏང་བ་ཡིན་ནམ།",
    "ཁོང་རང་རྣམས་ཀྱི་བྱེད་པ་ཡིན་གསུང་བ་ལ་ཨ་ཕ་ན་རེ།",
    "རྒྱལ་པོ་དང་ཨ་ཕས་བྱེད་པ་ཡིན་ཟེར།",
    "ཡང་རྗེ་ཡི་གསུང་གི་འོ་ན་རྒྱལ་པོ་དང་ཨ་ཕ་ནོར་འདོད་ནས་བསུ་བ་བྱེད་པ་ཡིན་ནམ་ཤིན་ཀུན་ཞིག་བསོས་བྱེད་པ་ལ་བསུ་བ་བྱེད་པ་ཡིན་གསུང་།",
