    "ཁྱོད་ཀྱང་དེ་ལྟར་ཉམས་སུ་ལོང་།",
    "བཀའ་སྒོ་མཛད་པ་ནི་དགེ་གཉེན་ཤན་དྷ་སྤུ་གྲི་ཁྱོད་ཀྱིས་མཆོད་རྟེན་མ་གྲུབ་བར་དུ།",
    "ཡང་སྐབས་གཅིག་ཀློ་བོ་སྐུ་སྐྱེ་བའི་ཇོ་མོ་སེང་གེ་རྒྱལ་མོ་བྱ་བ་སྡོད་པའི་ཅོ་པར་ལ་མེ་ཤོར་དུད་པས་ཕྱི་ནང་ཀུན་གང་ཚེ།",
    "ད་ཁྱོད་རང་སོང་ལ་ས་ཞིག་ཐོར་གསུང་།",
    "ལྷའི་བུ་མོ་ལྟར་ཡིད་འཕྲོག་ཅིང་མཐོང་བ་ཙམ་གྱིས་བདེ་བ་དཔག་མེད་གཡོ་ནུས་པ་ལྔ་བརྒྱ་དྲུག་བརྒྱ་ཙམ་དང་།",
    "རྡོ་དང་གྱོ་མོ་དང་ཤིང་དང་ཚེར་མ་དང་།",
    "སྒྲ་དང་རོལ་མོ་ཀུན་གྱི་ཚོར་ཞིང་ཐོས་པ་དང་བཅས།",
    "དེ་ནས་དངོས་གཞིའི་མེ་ཏོག་མཐོར་ཚེ་ཉི་མ་ཤིན་ཏུ་དྲོ་ཞིང་ལྷའི་མེ་ཏོག་གི་ཆར་དང་སྦྲང་ཆར་ཟིན་བུ་འདྲེས་པ་བབ།",
    "ཀློག་དམར་རབ་དུ་འཁྲུག་པའི་ངང་ནས་སེར་བ་བྱ་མོའི་སྒོང་ཙམ་བབ་མ་ཐག་ཆུར་ཞུ་འགྲོ་བ་བབས་ཅིང་།",
    "མཆོག་གི་གདུལ་བྱའི་མཆོད་ཡུལ་འཇིག་མི་སྲིད།",
    "བདག་གིས་ལྷག་བསམ་རྣམ་དག་དེ་མཐུན་གྱི།",
    "ཐུབ་བསྟན་ཕྱི་དར་ཉིན་མོར་བགྱིད་མཛད་པ།",
    "ཚ་ཟུར་གཉིས་ཀྱི་བདག་མོས་གསེར་ཞོ་རེ།",
    "འབྱོར་ལྡན་རྒྱལ་ཆེན་རྩེའི་དཔོན་མོ་ནི།",
    "བུ་འདྲེན་རྒྱལ་མོས་དད་པས་ཀུན་བླངས་ཏེ།",
    "སེང་རྩེའི་བདག་མོ་བསྟན་འཛིན་རྒྱལ་མོས་ཀྱང་།",
    "རེ་ཁ་ནང་སོས་གསེར་སྲང་ཕྱེད་དང་གཉིས།",
    "ཀྱིས་གསེར་སྲང་རེ།",
    "བྱང་གི་འབྲོག་བདེ་གཉག་གི་ཁྲི་དཔོན་བུ།",
    "འབུལ་མི་ཕྲ་མོས་གསེར་ཞོ་གྲངས་པ་དང་།",
    "མཆོད་རྟེན་ཕྱིར་དུ་རྒྱུ་དངོས་སོང་ཚུལ་ལ།",
    "མཆོད་རྟེན་སྐུ་ལ་སོང་བའི་གསེར་ཟངས་དང་།",
    "ཕྱེད་རིན་ཙམ་སོང་རྩིས་བའི་གསེར་ཞོ་ན།",
    "ཉིས་སྟོང་བདུན་རྒྱ་ལྔ་བཅུ་རྩ་གཅིག་སོང་།",
    "ཁོ་བོས་བགྱིས་པའི་ཞིག་བསོས་འདི་གོང་གི།",
    "རྒྱལ་ཕུར་འཛོམ་པའི་གྲུབ་སྦྱོར་ཉིན་མོ་ནས།",
    "འཇིག་རྟེན་མི་ཡི་ལུགས་ལ་ཡོད་མོད་ཀྱི།",
    "མཐོང་ཐོས་དྲན་རེག་སྐྱེས་བུས་ཐོག་དྲངས་ནས།",
    "མཚན་མོ་མེ་ཕུང་འབར་བ་དང་།",
    "ལ་ལས་དཔལ་ཧེ་རུ་ཀ་དངོས་སུ་མཐོང་བ་བྱུང་བས་ཀུན་ཡ་མཚན་ཞིང་བློར་མ་ཆུད་པར་བལ་བོ་རྣམས་ན་རེ།",
    "ཁྱེད་རང་གི་འགུ་རུ་ནི་མིའི་ཟ་མ་ཟ་བ་མ་ཡིན།",
    "གཡོན་མི་རྐང་ལན་གསུམ་འབུད་པ་དང་།",
    "རྗེ་ཡི་ཞལ་ནས་རང་རེ་ཕ་བུ་རྣམས་ཚེ་འཇུག་དབུས་སུ་སློབ་པ་འདུག་གསུང་།",
    "ཕེབས་པའི་ཚེ་བླ་བྱང་པའི་སྐྱེ་བོ་ཕོ་མོ་རྣམས་ཀྱིས་སྐྱེལ་མ་བྱས་པའི་སར།",
    "དེར་ཚོགས་པའི་བལ་བོད་སྙི་ཤར་གི་ཁྲོམ་རྣམས་དགའ་ཆེ་ལ་ངུ་གྲོ་བའི་དད་པས་འཆི་མ་མ་ཤོར་བ་མེད་དེ།",
