    "ཉིན་མཚན་ཐམས་ཅད་དུ་ཐོད་རྒལ་གྱི་སྣང་བ་འཇའ་ཟེར་ཐིག་ལེ་སྐུ་དང་ཞིང་ཁམས་ཀྱི་སྣང་བ་འབའ་ཞིག་འཆར་གྱིན་འདུག་གསུངས།",
    "སླར་ཡང་རང་ཡུལ་རྫ་ཆུ་ཁར་བྱོན་རྫ་སྟོད་སྨད་ཀྱི་གདུལ་བྱ་དཔག་མེད་བསྐྱངས།",
    "འོད་ཀྱི་གུར་ཁྱིམ་དུ་འདུག་པས་འཇིག་རྟེན་ཐམས་ཅད་སྣང་བར་བྱེད་པ་སོགས་ཡ་མཚན་གྱི་རྨི་ལྟས་དུ་མ་རྒྱུན་ཆགས་སུ་རྨིས།",
    "མཐའ་དམག་དུས་འཁྲུགས་ཀྱི་ཉེས་སྐྱོན་བཟློག་པ་སོགས་བོད་ཡུལ་བདེ་བའི་ཞབས་རིམ་མང་དུ་གནང་སྟེ།",
    "དོན་དུ་ལོ་གཉིས་ཀྱི་རིང་རང་བཞིན་རྫོགས་པ་ཆེན་པོའི་ལམ་ནས་རྟོག་མེད་ནམ་མཁའི་རྣལ་འབྱོར་གྱིས་ཉིན་མཚན་འོད་གསལ་གྱི་འཁོར་ལོར་འབྱམས་ཀླས།",
    "དེ་ཙམ་གྱིས་ཐུགས་མ་ཚིམ་པར་འདི་དག་ནི་ཕྱི་ཤུན་ཙམ་དུ་འདུག་ད་ནི་རྫོགས་ཆེན་གྱི་གདམས་པ་ཐུན་མིན་ཞིག་འཚོལ་དགོས་དགོངས་ཏེ་བྱང་རྫ་སྟོད་དུ་ཨ་བུ་དང་།",
    "བདེ་བ་ཆེན་པོ་མེ་རི་འབར་བར་རྡོ་རྗེ་འཆང་རང་ནས་གསན་པའི་སྤྱི་ཏི་དང་ཡང་ཏིའི་རྒྱུད་རྣམས་དང་།",
    "ཀུན་བྱེད་རྒྱལ་པོ་རང་བྱུང་རང་ལ་ཐིམ།",
    "རང་རང་རིགས་ཀྱི་ཡུམ་དང་བཅས་པ་རྣམས།",
    "ཀུན་ལ་རང་རང་སྒོ་བ་བཞི་བཞིར་ལྡན།",
    "བསྡུས་ཕྱིར་བྱེད་སྣང་རང་བཞིན་སྤྲུལ་པ་ཞེས།",
    "དུས་ཀྱང་སོ་སོར་མི་རྟོག་དུས་མེད་དུས།",
    "དུས་ཀྱང་རང་རང་བསྐལ་པའི་རྗེས་འགྲོ་བ།",
    "དམ་པའི་ངང་འདུག་ཅེས་ལན་གཉིས་གསུམ་ཙམ་བསྐྱར་ནས་གསུངས།",
    "ས་གཞིར་མེ་ཏོག་སྟོང་ལྡན་དང་རྒྱུ་སྨིན་གྱི་ཚལ་ཆེན་པོར་འདུག་པ་སོགས་མང་བོ་རྨིས།",
    "ཉིད་ཀྱི་བསྟི་གནས་གསེས་མཁོར་སྒང་ན་ཁང་བཟང་ཁ་དོག་དཀར་པོ་ཞིག་ལྷང་ངེར་འདུག་པ་སོགས་རྨིས།",
    "ཁྱེད་ཀྱིས་རྙེད་བཀུར་སོགས་འདོད་ནས་རི་ཁྲོད་དུ་འདུག་སྙམ་པ་ཡིན་ན།",
    "སྐུ་མདུན་དུ་འདུག་མ་བཅུག་གཉིས་ཀ་བསྡད་རིང་ལ་སྐུ་དྲང་པོར་བསྲངས་པ་ལས་གཡོ་འགུལ་དང་།",
    "དུས་ཚོད་ལྕགས་འབྲུག་དུས་སྤར་ཁོན།",
    "དང་པོ་འཇུག་དུས་ཆུ་ཚན་ཆུ་སྐྱུར་སྐྱུག།",
    "ཙ་ནི་ཁ་བྱིང་གཏིང་ན་ཅུང་ཟད་གྲིམས།",
    "སྣོད་ཀ་རུ་ཐུང་བྱིན་གཞུག་རང་རང་རྩ།",
    "གཉིད་ལོག་དུས་ན་ཟ་ཟི་བླ་འཆོལ་འབྱུང་།",
    "ཉལ་འདུག་མི་ཤེས་ལུས་རྡུལ་མཆིན་རྩ་འབུར།",
    "ཆུ་བཙགས་ས་བོན་འཛག་དུས་ཆུ་ཁ་ཚ།",
    "སྐྱིགས་བུ་ཟས་བྱུང་རང་ཐབས་ཟོས་རྗེས་འབྱུང་།",
    "ཕྲན་ཚེགས་འགྲངས་ངོམས་འདུག་རྗེས་དྲག་ཤུལ་འབྱུང་།",
    "བཅུ་གཅིག་གསུངས་ཀྱང་རང་རང་ལེའུར་གསལ།",
    "དགྱེ་དགུ་འགྲོ་འདུག་ལསོགས་དཀའ་བ་ཡི།",
    "ཕོ་ལོང་སྦོ་འཕྲོག་རང་རང་སྟེང་དུ་སྐྲངས།",
    "ཞུགས་དང་འབྱར་དང་གསེབ་ན་འདུག་པ་དང་།",
    "དོན་ཟིན་ཕོག་དུས་ཤེས་པ་ཟི་ཞིང་འཚུབ།",
    "འདུག་སར་མི་ཚུགས་ཞག་དགུའི་དུས་ན་འཆི།",
    "སྨྲ་འདོད་ཞེ་ས་མཁས་ལ་འགྲོ་འདུག་བྱེད།",
    "ཚབས་ཆེ་ཁྲག་ཏུ་འཁྲུ་སྐྱུག་ཕོག་དུས་འཆི།",
    "ཕུས་འདེབས་ལུས་བགྲད་ཞག་གཅིག་དུས་ན་འཆི།",
    "རྩ་རྣམས་རང་རང་རྟགས་དང་ཁྱད་པར་མེད།",
    "གཞན་ཡང་མ་འགྱུར་ལྡོག་མང་ལ་གདོན་གྱི་རྩ་འདྲ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "མེ་ཉི་བསིལ་གྲིབ་སྙེག་ཅིང་འདུག་མི་ཚུགས།",
    "རྩ་ནི་སྦྱར་དུག་དུས་དང་མཚུངས་པ་ལ།",
    "ཡང་ན་ཁྲག་མེད་སྦུ་གུར་འདུག་པ་དང་།",
    "ཟས་སྐོམ་འཇའ་ཚོན་མཐོང་བ་འདུག་ཡོད་རྟགས།",
    "གྲ་ཧ་ཙ་ནི་འཛིན་པ།",
    "ཁོ་བོས་རྒྱུད་ཀྱི་རྒྱ་དཔེ་ལྔ་དྲུག་ཙམ་མཐོང་བ་ན་ཡང་འདིའི་ཐད་ཨོཾ་མི་འདུག་འགྲེལ་པ་ཀུ་མུ་ཏི་དང་སྒྲུབ་ཐབས་ཡན་ལག་དྲུག་པ་ལས་ཀྱང་ཨོཾ་མེད་པ་འབྱུང་ཞིང་།",
    "ལྷའི་གཟུགས་ནི་འདུག་པ་དང་བཟའ་བ་དང་ཉལ་བ་ལ་སོགས་པ་རྣམས་སུ་ལྷའི་ང་རྒྱལ་གྱིས།",
    "ལག་ཤེས་སྤྲོད་རྒྱུའི་ལས་གཞི་དངོས་སུ་འགོ་འཛུགས་ཟིན་འདུག་པས་ངོས་རང་ཧ་ཅང་དགའ་པོ་བྱུང་།",
    "བར་སྐབས་ནས་དེ་ལྟར་མིན་པར་གློག་བརྙན་འཁྲབ་མཁན་སྐོར་ལ་ཤོད་མཁན་འདུག་ཅེས་བརྗོད་མཁན་བྱུང་བས་དེའི་རིགས་ལ་གཟབ་གཟབ་བྱེད་དགོས།",
    "དེར་བརྟེན་ད་བར་ཚང་མས་ཡག་པོ་གནང་འདུག་ལ་ད་དུང་ཡང་ཧུར་བསྐྱེད་གནང་རོགས་ཞེས་ཞུ་རྒྱུ་ཡིན།",
    "རྭ་སྟོད་གྲྭ་ཚང་ཆུང་ཆུང་ཞིག་ཡིན་ཡང་ཡག་ཐག་ཆོད་འདུག་དེ་བཞིན་སྒོ་མང་གྲྭ་ཚང་དང་།",
    "བློ་གསལ་གླིང་གྲྭ་ཚང་ཡག་ཐག་ཆོད་འདུག་དགོས་དོན་གཙོ་བོ་དེ་ཡིན།",
    "སྐུ་བརྙན་འདི་སྐུ་གཞོན་ནུའི་སྐབས་ཀྱི་ཡིན་པའི་བཟོ་འདྲ་གཞོན་གཞོན་ཞིག་འདུག་འདི་གར་བྱང་གཏེར་གྱི་བསྟན་པ་འཛིན་མཁན་ཞིག་བྱས་ཏེ་གདན་ས་ཆགས་ཡོད།",
    "དེ་དྲན་གྱི་འདུག་གམ།",
    "གཙུག་ལག་ཁང་ལ་ཉམས་ཉེས་འགྲོ་རྒྱུའི་ཉེན་ཁ་འདུག་རྡ་ས་ནས་རབ་གནས་བྱེད་དགོས་ཡོད་ཅེས་གསུངས་བྱུང་།",
    "ཁོང་རང་སྐད་གང་ཙམ་ཡག་པོ་ཡོད།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "དེ་ནས་ལག་མཐིལ་བསྟན་ལ་ཅི་འདུག་བྱ།",
    "དེ་ནས་རྡོ་རྗེ་ཅིག་བཞག་ལ་ཅི་འདུག་བྱ།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ།",
    "དེ་ཡང་ཤིན་ཏུ་ཆེ་བ་ལྟེ་བ་མན་ཆད་འདོད་ཁམས་སུ་འདུག་པ།",
    "སྤྱི་བོ་མན་ཆད་གཟུགས་མེད་ཁམས་སུ་འདུག་པ།",
    "སྐལ་པ་འཇིག་དུས་ཀྱི་མེ་ལྟ་བུ།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུྃ་ཕཊ།",
