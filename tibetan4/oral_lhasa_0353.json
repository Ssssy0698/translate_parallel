    "ཟས་ཆོག་པ་བཉིད་ཡང་དག་པར་ལེན་ཏོ་ཤས་ཡང་དག་པརལེན་ཏོ།",
    "ཀུན་ནས་ལྡང་བ་ཡང་དག་པར་སྟོང་བ་དང་།",
    "གོམས་ལ་ན་ལྟོའི་ཚད་ཀྱང་ཤེས་པར་འགྱུར་རོ།",
    "ཟས་ལྷག་པར་ཟོས་ན་ཕུལ་སྐྱེ་བ་དང་།",
    "ཟས་ཕྱིས་མི་ལེན་པ་ཌིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "ཟས་ལྷག་པར་ཟ་བས་ནི་ཟས་ཕྱིས་མི་ལེན་པ་ཉིད་འཇིག་གོ།",
    "འཛིངས་པར་གནས་པ་ཉིད་ཀྱི་ཉེས་དམིག་ས་ཀྱང་མཐོང་།",
    "གཏམ་གྱི་གཞི་བཅུ་ཡང་དག་པར་སྟོན་པ་དང་།",
    "ཤིང་དྲུང་པ་ཉིད་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཞེན།",
    "གཡོགས་པར་གནས་པ་ཡོངས་སུ་བཟུང་བ་དང་།",
    "དེང་སཱན་ཆད་གཡོགས་པར་གནས་པ་སྤོང་སྟེ།",
    "ཤིང་དྲུང་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "ཤིང་དྲུང་པ་ནིགཡོགས་པར་གནས་པ་སྡོང་བ་ཡིན་ནོ།",
    "གཡོགས་པར་གནས་པས་ནི་ཤིང་དྲུང་པ་འཇིག་གོ།",
    "བླ་ག་ཁ་མེད་པ་ཉིད་ཡང་དག་བར་ལེན་ཏོཤས་ཡངདག་པར་ལེན་ཏོ།",
    "དུར་ཁྲོད་པ་ཉིད་ཇི་ལྟར་ཡང་དག་པར་ཡན་ཞེ་ན།",
    "ཅུར་ཁྲོད་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "འདོད་པའི་འདོདཆགས་རྣམ་པར་གནོན་པ་ཉིད་དང་།",
    "ངུར་ཁྲོད་ཇི་ལྟ་བུར་ནི་གནས་པར་བྱ།",
    "ཐནས་ནི་ངུར་ཁྲོད་གཞན་གང་ཡང་རུང་བར་ཡང་གནས་པར་བྱའོ།",
    "མས་ལྡང་བར་གནས་པརམི་བྱ།",
    "ཁྱམ་འཕྲིག་ཅན་དུ་གནས་པར་མི་བྱ།",
    "ལྷུང་བཟེད་སྦྱིན་པར་མི་བྱ།",
    "བརྐམཆགས་ཀྱི་གནས་མལ་ལ་ཕན་ཚུན་ལྡང་བ་ཕ་རོལ་ལ་གནོད་པར་བྱེད་པའི་ཉེས་དམག་ཨ་ཀྱང་མཐོང་།",
    "གཞི་ཇི་བཞིན་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ཡང་དག་པར་ལེན་ཏོ།",
    "ནང་དུ་ཡང་དག་པར་འཇོག་ལ་བླམར་བཀུར་བ་དང་།",
    "དད་པར་བྱ་བ་ཉིད་དང་།",
    "ཙོག་པུ་པ་ཉིད་ཡང་དག་པར་ལེན་ཏོ་ཞས་ཡང་དག་པར་ལེན་ཏོ།",
    "ལ་བ་དག་བྱིན་པར་གྱུརན་སྐབས་ཕྱེ་བས་བླང་བར་བྱ་སྟེ།",
    "ཕྱག་དར་ཁྲོད་པ་ཉིད་ཉམས་པར་མི་འགྱུར་རོ།",
    "འོན་ཀྱང་ཉེས་དམིགས་སུ་ལྟ་བས་ནི་ཡོངས་སུ་ལོངས་སྤྱད་པར་བྱའོ།",
    "མཐར་ཆགས་སུ་རྒྱུབ་ཉིད་ཉམས་པར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་ལངས་པར་གྱུར་ན་སྐབས་ཕྱེ་བས་ཡང་བཟའ་བར་བྱ་སྟེ།",
    "སྟན་གཅིག་པ་ཉིད་འཇིག་པར་མི་འགྱུར་རོ།",
    "གཞི་ཇི་བཞིན་པ་ཉིད་ཀྱི་སྐབས་ཕྱེ་བས་ནི་རྐྱེན་དེ་ལྟ་བུ་ཡོད་ལ་གཞན་གྱིས་གནས་མལ་རྙེད་ཞུ་རྗེས་སུ་གནང་ངོ།",
    "ཅོག་པུ་པ་ཉིད་ཉམས་པར་མི་འགྱུར་རོཞེས་ཟེར་རོ།",
    "བ་སོད་སྙོམས་པ་ཉིད་དང་གསུམ་གྱིས་རྫོགས་པར་འགྱུར་རོ།",
    "སྦྱངས་པའི་ཡོན་ཏན་ཐམས་ཅད་རྫོགས་པར་འགྱུར་རོ།",
    "ངན་པོན་གྱིས་འཚོ་འདོད་པ་རྣམས་ལ་ནི་ལྟ་བ་མེད་པ་མཐོང་ཞིག་གུ་ཞེས་གསུངས་སོ།",
    "ཞི་སྦྱངས་པའི་ཡོན་ཏན་བསྟན་པར་དགའ།",
    "སྦྱངས་པའི་ཡོན་ཏན་ཅིར་བརྗོད་པར་བྱ་ཞེན།",
    "འདིས་ཆོག་པ་ཉིད་ལ་བརྟེན་ནས་ཕྱག་དར་ཁྲོད་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "རྣམ་པ་གཅིག་ཏུ་ནི་མ་ཆགས་པས་རྗེས་སུ་གནང་བ་འཚམ་པར་བསྟེན་བས་འདོད་པའི་བསོད་སྙོམས་ཀྱི་རྗེས་སུ་བརྩོན་པའི་སླུ་བ་སེལ་ལ།",
    "ཡང་ཅི་སྤྱོད་པའི་གང་ཟག་རྣམས་སྦྱངས་བའི་ཡོན་ཏན་སྟེན་པར་དགའཞེན།",
    "གཏི་མུག་སྤྱོད་པ་སྦྱངས་པའི་ཡོན་ཏན་སྟེན་པར་དགའི།",
    "བསྒྲུབ་དཀའ་བ་ཡིན་པས་འདོད་ཆགས་སྤྱོད་པ་བསྒྲུབ་དཀའ་བ་ལ་བརྟེནནས་འདོད་ཆགས་རྣམ་པར་གནོན་པར་འགྱུརལ།",
    "གཏི་མུག་སྤྱོད་པ་ཡང་སྦྱངས་པའི་ཡོན་ཏན་སྟོན་པ་ཡང་དག་པར་བླངས་པ་ཡོ་བྱད་བསྙུངས་པ་ལ་བརྟེནནས་རྟག་ཏུ་བག་ཡོད་པར་འགྱུར་ཞིང་བག་ཡོད་ནག་ཏི་མུག་རྣམ་པརགནོན་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་ཞེ་སྡང་སྤྱོད་པ་ནི་སྦྱངས་པའི་ཡོན་ཏན་བསྟེན་པརངཀའ་བ་ཡིན་ནོ།",
    "ངུར་བྲོདཔ་ཉིད་ནི་ཟླ་བ་བརྒྱད་ཀྱི་མཐར་ཐུག་པར་བྱ་སྟེ།",
    "དབྱརནིག་ཡོགས་པར་གནས་པར་བཅོམ་ལྡན་འདས་ཀྱིས་གནང་ངོ།",
    "སྦྱངས་པ་སྨྲ་བ་ཡང་ཡིན་པ་ཡང་ཡོད་ཅེས་བྱ་བནི་དགྲ་བཅོམ་པ་སྦྱངས་པའི་ཡོན་ཏན་ཡང་དག་པར་བླངས་པ་དང་ལྡན་པའོ།",
    "སྦྱངས་པ་མ་ཡིན་ལ་སྦྱངས་པ་སླབ་ཡིན་པ་ཡང་ཡོད་ཅེས་བྱབ་ནི་དགྲ་བཅོམ་པ་སྤངས་པའི་ཡོན་ཏན་ཡང་དག་པར་བླངས་པ་དང་མི་ལྡན་པའོ།",
    "སོ་སོའི་སྐྱེ་བོ་སྦྱངས་པའི་ཡོན་ཏན་ཡང་དག་པར་བླངས་པ་དང་ལྡན་པའོ།",
    "སོ་གོའི་སྐྱེ་བོ་སྙུངས་པའི་ཡོན་ཏན་ཡང་དག་པར་བླངས་པ་དང་མི་ལྡན་པའོ།",
    "སྦྱངས་པའི་ཡོན་ཏན་གྱི་ཐོག་མ་ནི་ཡང་དག་པར་ལེན་པའོ།",
    "བཅོམ་ལྡན་འདས་མཉན་ཡོད་ན་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བ་ན་བཞུགས་སོ།",
    "བཅོམ་ལྡན་འདས་དེའི་དུས་ལ་བབ་ལགས་སོ་། པདེ་བར་གཤེགས་པ་དེའི་དུས་ལ་བབ་ལགས་སོ།",
    "མངོན་སུམ་འདི་ལ་བལྟ་བར་བྱས།",
    "བརྡས་ནས་བཙོ་མི་དགོས་པར་ཟ།",
    "རྡུལ་རྣམས་མེད་པར་བྱེད་པ་སྟེ།",
