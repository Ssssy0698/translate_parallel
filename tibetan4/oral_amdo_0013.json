    "བུམ་པ་དེ་རྣམས་ཐམས་ཅད་ཀྱང་མེ་ཏོག་གིས་བརྒྱན་པར་བྱའོ།",
    "དེ་ནས་རི་མོ་མཁན་གྱིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དང་།",
    "དེའི་རྒྱབ་ཏུ་རིག་པའི་ལྷ་མོ་གོས་དཀར་པོ་བགོས་པ།",
    "དེ་ནས་ཐམས་ཅད་ཀྱང་བདེ་བར་གཤེགས་པའི་མཐོ་གང་གི་ཚད་དུ་བྱ་ཞིང་པདྨ་ལ་གནས་ཤིང་སོ་སོར་གནས་པའོ།",
    "དེ་ནས་རིག་པ་འཛིན་པས་རས་རིས་ཀྱི་རྒྱལ་པོའི་མཆོག་དེའི་སྤྱན་སྔར་སློང་མོ་བཟའ་ཞིང་རིག་པ་འབུམ་ཕྲག་བཅུ་གཉིས་སུ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་ཟླ་བ་ཉ་ལ་མཚན་མོ་གསུམ་སྨྱུང་བར་གནས་པར་བྱས་ལ་རས་རིས་ཞལ་ཤར་དུ་ཕྱོགས་པར་བཞུགས་ནས་པདྨའི་གཡས་ཀྱི་ལུས་ལ་བཅོམ་ལྡན་འདས་མའི་ལྷ་ཐམས་ཅད་སྤྱན་དྲངས་བར་བྱའོ།",
    "མ་མོའི་ཚོགས་རྣམས་དང་།",
    "མངར་གསུམ་མོ།",
    "ལྷ་མ་ཡིན་གྱི་བུ་མོ་རྣམས་འདུས་པར་འགྱུར་རོ།",
    "རིག་པའི་རྒྱལ་པོ་ཐམས་ཅད་ཀྱང་མེ་ཏོག་གི་ཆར་རབ་ཏུ་འབེབས་སོ།",
    "རང་གི་འདོད་པས་སྐྱེ་བ་འཛིན་པར་བྱེད་ཅིང་རང་གི་འདོད་པས་འཆི་བར་བྱེད་དོ།",
    "བཅོམ་ལྡན་འདས་མ་རིག་པའི་རྒྱལ་མོ་ཆེན་པོའི་ལེའུ་དང་པོ་རྫོགས་སོ།",
    "རི་མོ་མཁན་གསོ་སྦྱོང་ལ་གནས་པས་བཅོམ་ལྡན་འདས་ཀྱི་གཟུགས་བརྙན་འདྲིར་གཞུག་པར་བྱ་སྟེ་གསེར་ལྟར་སེར་བ།",
    "ཕྱག་ན་ཤིང་གི་དབྱུག་པ་བསྣམས་པའོ།",
    "རྡོ་རྗེ་འཆང་གི་ཉེ་ལོགས་སུ་རྡོ་རྗེ་ལྕགས་ཀྱུ་མ་དང་།",
    "སྟེང་དུ་གནས་གཙང་མའི་ལྷའི་བུ་མེ་ཏོག་གི་ཕུར་མ་ལག་ན་ཐོགས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "ཐམས་ཅད་ཀྱང་མེ་ཏོག་གིས་བརྒྱན་པར་བྱ།",
    "རིག་པ་འཛིན་པ་བཅུ་དྲུག་གིས་ཡོངས་སུ་བསྐོར་བར་འགྱུར་ཏེ་ལོ་སྟོང་ཕྲག་བརྒྱད་ཅུ་འཚོ་བར་འགྱུར་རོ།",
    "གང་གི་ཚེ་འཆི་བ་དེའི་ཚེ་རྡོ་རྗེའི་རིགས་སུ་སྐྱེ་བར་འགྱུར་རོ།",
    "མེ་ཏོག་ལ་སོགས་པས་བརྒྱན་པར་བྱས་ནས་སྒྲུབ་པ་པོ་ཁ་ཤར་དུ་ཕྱོགས་པས་རེ་རེ་ལ་སོ་སོར་བསམ་པའི་ཡིད་ཀྱི་རྒྱུད་མཚུངས་པའི་བའི་མར་གསར་ལ་རིག་པ་བཟླས་པས་རོའི་ཁ་རུ་བླུགས་ནས་ཇི་སྲིད་ཀུན་ཏུ་གཡོ་ཞིང་ལྡང་བ་དེ་སྲིད་དུ་རིག་པ་བཟླས་པར་བྱའོ།",
    "སྒྲུབ་པ་པོ་པུས་མོ་བཙུགས་པ་ལག་ན་སྤོག་ཕོར་ཐོགས་པ་བྱེད་དུ་གཞུག་གོ།",
    "གང་གི་ཚེ་འཆི་བ་དེའི་ཚེ་རྡོ་རྗེའི་རིགས་སུ་སྐྱེ་བར་འགྱུར་རོ།",
    "མ་ཉམས་པའི་རས་ལ་རི་མོ་མཁན་གསོ་སྦྱོང་ཅན་གྱིས་བཅོམ་ལྡན་འདས་མ་ཁྲོ་གཉེར་ཅན་མ་འདྲིར་གཞུག་པར་བྱ་སྟེ་སྔོ་བསངས་སྤྱན་གསུམ་པའི་ལྷ་མོ་ཆ་བྱད་དང་།",
    "དེ་ནས་མཚན་མོ་དུར་ཁྲོད་དུ་སོང་ནས་རས་རིས་ཞལ་ཤར་དུ་ཕྱོགས་པར་བཞག་ནས་དྲི་དང་།",
    "དེ་ནས་རིག་པ་འཛིན་པས་གཙང་མས་གོས་གཙང་མ་བགོས་ཏེ་བ་ལང་གི་ཕགས་པ་ཙམ་གྱི་གཞི་ལ་ཉེ་བར་བྱུག་པ་བྱས་ནས་དེར་འཕགས་པ་བྱག་ན་རྡོ་རྗེའི་གཟུགས་བརྙན་རབ་ཏུ་སོ་སོར་གནས་པ་བྱེད་དུ་གཞུག་གོ།",
    "དེ་ནས་རྡོ་རྗེ་སྒྲུབ་པར་འདོད་ན་རི་མོ་མཁན་གསོ་སྦྱོང་ལ་གནས་པས་མ་འདྲེས་པའི་ཚོན་གྱིས་བཅོམ་ལྡན་འདས་མ་ཁྲོ་གཉེར་ཅན་མ་དང་།",
    "སྦྱིན་སྲེག་ཡོངས་སུ་རྫོགས་ནས་ཀྱང་ཇི་སྲིད་རྡོ་རྗེ་ལ་འོད་ཟེར་འབྱུང་གི་བར་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "གང་གི་ཚེ་འཆི་བ་དེའི་ཚེ་རྡོ་རྗེའི་རིགས་སུ་སྐྱེ་བར་འགྱུར་རོ།",
    "དེ་ནས་རྒྱ་མཚོར་འགྲོ་པའི་ཆུ་ཀླུང་དུ་སོང་ནས་སློང་མོ་ཟ་ཞིང་རྐེད་པ་ཙམ་གྱི་ཆུར་ཞུགས་ནས་འབུམ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་རིག་པ་འཛིན་པས་རྩེ་མོ་མ་བཅད་པའི་ཀུ་ཤ་ལྕགས་ཀྱུ་བྱས་ནས་ལག་པ་གཡས་པས་བླངས་ཏེ་ཇི་སྲིད་ལྕགས་ཀྱུ་ལས་འོད་ཟེར་བྱུང་བ་དེ་སྲིད་དུ་དཔག་ཏུ་མེད་པ་བཟླས་པར་བྱའོ།",
    "ལྕགས་ཀྱུ་ལག་ན་ཐོགས་པས་རིག་པ་འཛིན་པ་སྟོང་ཕྲག་གི་མངའ་བདག་ཏུ་འགྱུར་རོ།",
    "གང་གི་ཚེ་འཆི་བ་དེའི་ཆེ་བདེ་བ་ཅན་དུ་སྐྱེ་བར་འགྱུར་རོ།",
    "བདག་གིས་རིག་པའི་རྒྱལ་མོའི་ཆོ་ག་འཆད་དོ།",
    "བདེ་བའི་ཆེད་དུ་རིག་པའི་རྒྱལ་མོ་ཆེན་མོའི་ཆོ་ག་གསུངས་ཤིག།",
    "གང་ལ་ལ་རིག་པའི་རྒྱལ་མོ་སྨྲ་བར་གྱུར་པའམ།",
    "ཆོམ་རྐུན་གྱི་དབུས་སུ་སོང་བས་ཡིད་ལ་བྱའོ།",
    "འཕགས་པ་སྤྱན་རས་གཟིགས་ཀྱི་ཉེ་ལོགས་ན་བཅོམ་ལྡན་འདས་མ་ཁྲོ་གཉེར་ཅན།",
    "བཅོམ་ལྡན་འདས་མའི་ཉེ་ལོགས་སུ་རིག་པའི་རྒྱལ་མོ་ཆེན་མོར་འདྲིར་གཞུག་པར་བྱའོ།",
    "རིག་པ་འཛིན་པ་རྣམས་ཀྱང་གཡས་པའི་ཕྱག་བརྒྱད་ཀྱིས་རེག་གོ།",
    "དེ་ནས་སློང་མོའི་ཟས་ཟ་ཞིང་ཤི་བའི་རས་བླངས་ནས་རྫས་འདི་རྣམས་ཀྱི་བཀྲུ་བར་བྱ་སྟེ་ཙནྡན་དང་།",
    "དེ་ནས་རིག་པ་འཛིན་པས་བཅོ་ལྔ་ལ་དུར་ཁྲོད་དུ་སོང་ནས་བ་ལང་གི་པགས་པ་ཙམ་གྱི་ཐང་ལ་ཉེ་བར་བྱུགས་ནས་དྲི་དང་།",
    "གང་གི་ཚེ་འཆི་བ་དེའི་ཚེ་བདེ་བ་ཅན་དུ་སྐྱེ་བར་འགྱུར་རོ།",
