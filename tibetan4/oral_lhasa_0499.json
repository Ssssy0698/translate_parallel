    "དེ་ནས་ས་གཞིའི་གནས་དག་ཏུ་ནི་གང་ཞིག་ཞི་བ་ལ་སོགས་ལས་རྣམས་དག་ཀྱང་བསྒྲུབ་པར་བྱ།",
    "དེ་ཕྱིར་བདེ་མཉམ་འབྲས་སྟེར་གཉིས་པོ་བསྒྲུབ་པར་བྱ་སྟེ།",
    "ཞེས་གཙོ་ཉིད་འགྲུབ་ན་འཁོར་རྣམས་ཤུགས་ལས་འགྲུབ་ཅིང་གཙོ་བོས་བྱིན་གྱིས་མ་བརླབས་ན་འཁོར་ཡང་མི་འགྲུབ་པས་ཐོག་མར་གཙོ་བོ་ཉིད་ལ་ཆིག་དྲིལ་བྱ་དགོས་པར་གསུངས་པ་དང་།",
    "ཁྱད་པར་སྒྲུབ་པ་ཆེན་པོའི་གསང་སྒྲུབ་ཀྱི་སྐབས་འདིར་ནི་སྤྱིར་ནས་གཙོ་འཁོར་ཐམས་ཅད་ཡེ་ཤེས་ཀྱི་རོལ་པ་ཉག་གཅིག་ཏུ་ལྟ་བར་མ་ཟད།",
    "བསྒྲུབ་བྱའི་ལྷ་ཡང་ཕྱི་རོལ་ནས་ལོགས་སུ་མི་གསལ་བ་རང་རིག་གཅིག་པུ་སྒྱུ་མ་ཙམ་གྱི་ལྷའི་འཁོར་ལོ་ཐམས་ཅད་པར་ཤར་བར་ལྟ་དགོས་པའི་ཕྱིར་གཙོ་སྔགས་ཁོ་ནས་དོན་འགྲུབ་བོ།",
    "ཕྱི་ནང་གསང་གསུམ་ཀ་ལ་བསྙེན་པ་འཐེམས་རྗེས་ལྷག་ཆད་ཁ་བསྐོངས་ཀྱི་བཅུ་ཆའི་སྦྱིན་སྲེག་བདེ་མཆོག་ལྟ་བུ་སྤྱི་འགྲོས་ཀྱི་ཁ་བསྒྱུར་ཏེ་བསྙེན་པ་འཛིན་པའི་དཀྱུས་དེ་ཉིད་ལའམ་ཡང་ན་རྗེས་སུ་བྱས་ཀྱང་རུང་།",
    "དེ་ལྟར་བསྙེན་སྒྲུབ་ལེགས་པར་ཐེམས་ནས་ལས་ལ་སྦྱར་བའི་ཚུལ་ནི་ལས་མཐའ་བསྟན་དགྲ་འཇོམས་པའི་སྤུ་གྲི་ལས་གསུངས་པ་བཞིན་དྲག་སྔགས་སྤྱི་བསྡོམས།",
    "ལེགས་ཚོགས་གང་ཅི་མཆིས་པས་ཀུན་མཁྱེན་འབྲུག་པའི་བསྟན་པ་ཕྱོགས་དུས་ཀུན་ཏུ་རྒྱས་པའི་རྒྱུར་བསྔོ་བར་བྱ་སྟེ།",
    "དཔལ་ཡེ་ཤེས་ཀྱི་མགོན་པོ་ཕྱག་བཞི་པའི་བསྙེན་ཐབས་དངོས་གྲུབ་ཀྱི་སྙེ་མ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "བསྟོད་རྗེས་བཟླས་པ་མཛད་པ་སོགས་གསུངས་པ་ཕྱི་ལྟར་བསྙེན་པ་ཡིན།",
    "རང་ཡི་དམ་བདག་བསྐྱེད་ཐུགས་ཀ་ནས་ཧཱུྃ་འཕྲོས་པས་རྒྱུ་བྱས་ནས་མདུན་བསྐྱེད་བཟླས་པ་སོགས་ཡིན་ཅིང་།",
    "བསྙེན་པ་ངེས་ཅན་གནང་བ་བཞེད་ཚེ།",
    "མགོན་པོ་ཡི་དམ་དུ་བསྙེན་པ་རང་ལྷག་པས་རྗེ་ཡོངས་འཛིན་དམ་པས་མཛད་པའི་ཉུང་ངུ་དེ་ནས་གནང་བ་ན་འཁྱེར་བདེ་ཞིང་ལེགས།",
    "བདུན་རྣམ་དག་གསུམ་ནས་བཛྲ་མུ་བདག་ཉིད་ལ་ཐིམ་པར་གྱུར།",
    "མགྲིན་པར་ཨཱ་ཐུགས་ཀར་ཧཱུྃ།",
    "ཐུན་མཚམས་སུ་གཏོར་མ་བསྐང་བཤགས་ལྟར་བྱིན་གྱིས་བརླབ།",
    "ཐུགས་ཀའི་འོད་ཟེར་གྱིས་གཏོར་མགྲོན་སྤྱན་དྲངས་པར།",
    "ཐུན་རྗེས་མ་རྒྱུན་གྱི་གཏོར་བསྔོས་རྒྱས་པ་གནང་།",
    "སྡུག་པར་མི་འཛིན་པར་ཡེ་ཤེས་ཀྱི་རོལ་པར་འཁྱེར་ཏེ་ཆུ་བོའི་རྒྱུན་ལྟར་བསྙེན་པར་ཞུ།",
    "ཞི་བར་འོད་ཟེར་དཀར་པོ་འཕྲོ་བ་མགོན་པོའི་ཐུགས་ཀར་འཁོར་དུས་ཞི་བའི་ལས་བསྒྲུབ་པར་བསྐུལ་བས་ཐུགས་ཀ་ནས་ཐོན་པའི་བར་འདིར་ཞི་བའི་ལས་བསྒྲུབ་པར་མི་གཡེལ་བར་བསམ།",
    "རྒྱས་པར་འོད་ཟེར་སེར་པོ་འཕྲོ་ཞིང་།",
    "ཚེ་བསོད་རྒྱས་པར་དམིགས་པ་ལས་གཞན་འདྲ།",
    "ལས་མགོན་ཙམ་བཟླ་བ་གནང་ནས་འཐུས་ཤིང་འགལ་བ་མེད།",
    "སྒེར་གསོལ་མགོན་པོའི་བཟླས་པའི་རྗེས་ལ་གནང་བ་ཞུ།",
    "བཀྲ་ཤིས་པར་གྱུར་ཅིག།",
    "མཆོད་སྦྱིན་གཏོར་མ་འདི་བཞེས་ལ།",
    "བརྟན་བཞུགས།",
    "དེ་ཉིན་གྱི་དགོང་ཆའམ་སྲོད་ནས་ཐུན་མགོ་བརྩམས་པར།",
    "ཕྱོགས་བཅུར་བཞུགས་པའི་སྐྱབས་སེམས།",
    "ཡང་ན་ཡབ་ཀྱི་ཐུགས་ཀའི་སྔགས་འཁོར་ལས་འོད་ཟེར་སྔགས་ཕྲེང་གྱི་རྣམ་པར་ཆད་པ།",
    "ཡུམ་ཆེན་རྣམས་རྒྱུད་གཅིག་པའི་ངེས་པས་སྦྱོར་ཡུམ་བདེ་ཆེན་དགྱེས་མདངས་དབྱིངས་སྒྲོལ་སོགས་ལའང་མཉམ་པར་འཇུག་ཅིང་།",
    "གཙོ་བོ་དགྱེས་སྤེལ་གྱི་བྱེད་པ་གཅིག་ཏུ་འབབ་པར་བསམ་པས།",
    "ནག་པོ་སྤྱི་སྔགས་གྲངས་མང་ན་ཚན་ཆེ་ཞིང་རྣོ་བ་ཡིན་པར་བྱེད།",
    "འོན་ཀྱང་ཅུང་ཟད་རྩུབ་པས་གོལ་ཆ་ཆུང་བ་རྣམས་ཀྱིས་བསྙེན་དུས་ཆིག་དྲིལ་དུ་མི་བྱེད་པར་སྔགས་གཞན་དང་སྤེལ་གྱིན་བཟླས་ན་འཕྲོད་པ་སྲིད།",
    "དེ་ཡང་མི་དམིགས་པར་མཉམ་པར་བཞག་པ་ལས།",
    "གཞན་ཚེར་དེ་ལྟའི་དོན་ཚང་ཚིག་ཉུང་ཙམ་བགྱིས་ན་བཟླས་པ་འགྲོ་ཆེའི་ཁྱད་པར་བཅས།",
    "སླར་མིང་སྨོས་ཙམ་གྱིས་ཆོག་པར་འདོད་གསོལ་རྒྱས་པའི་སྐབས་བཞིན་སོགས་འོས་འཚམས་ཤེས་པར་བྱ།",
    "མདུན་མཁར་བཞུགས་པ་ལ།",
    "བཀྲ་ཤིས་པའི་རྫས་རྟགས་ལ་སོགས་པའི་རྣམ་པར་བདག་ལ་ཐིམ་པས་དངོས་གྲུབ་རྣམ་གཉིས་ཐོབ་པ་དང་།",
    "དེ་ལྟར་ན་མགོན་པོ་ཡི་དམ་དུ་སྒྲུབ་པ་ནང་སྒྲུབ་ཀྱི་ཚུལ་ལགས།",
    "དཔལ་ཡེ་ཤེས་ཀྱི་མགོན་པོའི་ནང་སྒྲུབ་ཀྱི་བསྙེན་ཐབས་ཟིན་བྲིས་ཟུར་འདེབས་བཞུགས་སོ།",
    "དེ་ལྟར་ཐུགས་ཉམས་སུ་བཞེས་པའི་བསྙེན་པའི་མན་ངག་ལ།",
    "དེ་ཁོ་ན་ཉིད་ལ་མཉམ་པར་བཞག་པ།",
    "ཐུགས་ཀའི་ཧཱུྃ་ཡིག་སྔགས་ཕྲེང་དང་བཅས་པ་ལ་ཐིམ་པར་བསམ་ཤིང་།",
    "ལྷན་སྐྱེས་ཀྱི་བདེ་བ་ལ་མཉམ་པར་བཞག་སྟེ་སྔགས་བཟླ།",
    "རབ་ཡི་དམ་གྱི་ཞལ་མངོན་སུམ་དུ་མཐོང་ཞིང་གནང་བ་ཐོབ་པ།",
    "འོད་གསལ་ཕྱག་རྒྱ་ཆེན་པོ་ལ་མཉམ་པར་འཇོག་པའོ།",
    "ལུས་ལྷ་སྐུ་སྣང་ལ་རང་བཞིན་མེད་པ།",
