    "ཤཱཀྱའི་བུའི་དགེ་སྦྱོད་རྣམས་ཀྱི་དགེ་སྦྱོད་གི་ཚུལ་ནི་ཚིག་པའོ།",
    "དེ་ལྟ་མོད་ཀྱི་ཅི་ནས་དང་པདད་ལྡན་པ་རྣམས་ཀྱིས་མཐོད་ལ།",
    "ལུས་ཅ་ན་དག་གི་ལས་རྣམས་ནི།",
    "དེའི་ཚེ་དེའི་དུསན་ཆོ་ལོ་ལ་དོར་སྒྱུ་བྱེད་པ་གད་ཡིན་པ་དེ་ནི་ཉི་མ་འདི་ཉིད་ཡིན་ཏེ། ། དེས་བཅོམ་ལྡན་འདས་རྣམ་བར་གཟིགས་ཀྱི་མཆོད་རྟེནལ་བཀུར་སྟི་བྱས་བདང་།",
    "ཁྱེའུ་འདིའི་མོང་ཇི་སྐད་གདགས་ཞེས་མིང་འདོག་པར་བྱེད་དེ།",
    "ཏེ་ཚེ་མཚོའི་ནང་གི་པད་མ་བཞིན་དུ་སྐྱེ་དྲག་པར་གྱུར་ཏེ།",
    "འོད་འདོམ་གང་གིས་བརྒྱན་པ།",
    "ལྷ་དད་མི་རྣམས་ཀྱི་སྟོན་པ་སངསརྒྱས་བཅོམ་ལྡན་འདས་རྣམ་པར་གཟིགས་ཞེས་བྱ་བ་འཇིག་རྟེན་དུ་ཟུད་སྟེ།",
    "བཅོམ་ལྡན་འདས་རྣམཔར་གཟིགས་ཀྱི་མཆོད་རྟེན་ག་ལབ་དེར་སོང་སྟེ་ཕྱིནནས་བཅོམ་ལྡན་འདས་ཀྱི་ཡོན་བཅོམ་ལྡན་འདས་རྣམ་པར་གཟིགས་ཀྱི་མཆོད་རྟ་ཏན་དྲན་པར་བྱས་ཏེ།",
    "སྟོན་པ་འདི་ལྟ་བུ་བདག་གིས་མཉེས་བར་བྱེད་པར་གྱུར་ཅིག།",
    "བུ་མོ་འདིའི་མི་ངཇི་སྐད་བདགས་ཞེས་མིང་འདོགས་པར་བྱེད་དེ།",
    "དེ་ནས་དེ་དག་གིས་གནོད་པར་ཁུར་ནས།",
    "གལ་ཏ་གཅིག་ལ་བྱ་ནམ་ནི་གཞན་རྣམས་བདག་གི་དགྲར་འགྱུར་སྙམ་ནས།",
    "བདག་གིས་ཁྱེད་ལ་གང་གི་སྒོ་ནས།་",
    "དེ་ཐོས་ནས་བུ་མོ་འོད་བཟད་མས་འཇིག་ཚོགས་ལ་བལྟ་བའི་ཕྱིར་རིའི་རྩ་མོ་མཐོན་པོ་ཉི་ཤུཡེ་ཤེས་རྡོརྗེས་བཙེམནས་རྒྱུ་ན་ཏུ་ཞུགས་པའི་འབྲས་བུ་ཐོབ་སྟེ།",
    "དེ་ནས་བུ་མོ་འོད་བཟང་མ་སྟན་ལས་ལངས་ཏེ་བླ་གོས་ཕྲག་བ་གཅིག་ཏུག་ཟང་ནས་བུས་མོ་གཡས་པའི་ད་ལྷ་ངས་ལ་བཙུགས་ཏེ།",
    "ཁྱོད་འདོད་པ་སྐྱེད་པ་འདི་ནི་མི་སྲིད་དོ་ཞེས་བྱས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེ་སྐྱེ་དགུའི་བདག་མོ་ཆེན་མོ་ལ་གཏང་དེ་དེ་ས་དེང་ཏུ་ཕྱུང་སྟེ་བསྙེནཔར་རྫོགས་པར་བྱ་སོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྦངས་ནས་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བྱས་ཏེ།",
    "བཙུན་པ་འེད་བཟར་གིས་ལས་གང་དག་བགྱིས་ན།",
    "དེའི་ཚེ་དེའི་དུསན་རྒྱལ་པོ་གཉེན་ཡོད་ཀྱི་བཙུན་མོ་རྣམ་པར་གྱུར་པ་གང་ཡིན་པ་དེ་ན་འོད་བཟང་མ་འདི་ཡིན་ཏེ།",
    "དེས་བཅོམ་ལྡན་འདས་རྣམ་པར་གཟིགས་ཀྱིམཆནགས་བ་དེསན་གཟུགསབཟང་ཞིང་བལྟན་སྡུག་ལམཛེས་པ་དང་།",
    "བུ་བྷད་སྟེ་བུ་མོ་གཟུགས་བཟང་ཞིང་བལྟ་ན་སྔག་ལ་མཛེས་པ་ཡན་ལག་དང་ཉིད་ལག་ཐམས་ཅད་དང་ལྡན་པ།",
    "བུ་མོ་འདིའི་མར་ཇི་སྐད་གདགས་ཞེས་མིང་འདོགས་པར་བྱེད།",
    "ཞིང་གི་ཁྱད་པར་གཞི་ལས་འཕེལ་བར་འགྱུར།",
    "སྐྱི་བུང་ཞེས་བྱས་ནས་སྨུས་པ་ཀྱེ་མ་བུ་མོ་འདི་ནི།",
    "ཕྲན་མོ་ཡང་མ་ལགས་ཀྱི།",
    "དེནས་གང་གི་ཚེ་བུ་མོ་དེ་མཐར་གྱིས་ལོ་བདུན་ལེན་པདེའི་ཚེ་ཐམ་ལ་གསོལ་ཏེ།",
    "དེ་ན་སརབ་ཕྱུག་མས་ཐལ་མོ་སྦྱར་ཏེ།",
    "གལ་ཏེ་བསོང་ནམས་དག་གི་རྣམ་པར་སྨིན་མ་ཡོད་ཅེ་ན།",
    "བདག་གི་ལྷུང་བཟེདཔཟའ་བ་དང་བཅའ་པ་ལ་སོགས་པ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་གང་བརདགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བགྱིས་ལགས།",
    "རབ་སྡུག་མ་ཉིད་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་དེ་དག་གཞན་སུ་ཞིག་གིས་ཉམགུ་སྐྱེ་དོབར་འགྱུར་ཏེ།",
    "ལུམ་ཅན་དག་གི་ལས་རྣམས་ནི།",
    "དགེ་སློང་གིཚོགས་ཀྱིས་ཞམ་རིང་བྱས་ཏེ།",
    "དེ་ནས་རེ་ཤིག་ན་དེའི་མངག་གཞུག་མ་བུ་མོ་ཞིགའབྲས་ཆེན་གྱི་གཟེབ་ཁྱེར་ཏེ་ཛོ་བོའི་ཕྱི་བཞིན་ངུ་འགྲོ་བ་ལས་བུ་མོ་མངག་ཞུགམ་དེས།",
    "དེ་ནས་དེ་དགའ་ཞིང་མགུ་ལ་རབ་ཏུདག་འནས་སྨྲས་པ་བུ་མོ་ཁྱེད་དེང་ཕྱིན་ཆད་བྲན་མ་ལས་ཕྱུང་གིས་སོང་ཤིག།",
    "དང་ཚོས་གོ་ས་ཁྱེར་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་བསྟན་པལ་རབ་ཏུ་བྱུང་ནས།",
    "བདག་གིས་དཀའ་བས་བསྒྲུབས་ཏེ།",
    "བཅོམ་ལྡན་དུ་དེ་ནས་དེས་ཐལ་མོ་སྦྱར་ཏེ་ཁྱིམ་བདག་ལ་གསོལ་བ།",
    "དཀར་མོ་ཞེས་བྱ་བ་ནི།",
    "དེནས་དེའི་ཆུང་མས་ལྷའི་གོས་གྱོན་པའི་བུ་མོ་ཐུལ།",
    "མ་མབཅདལ་གཏད་ནས་ད་མ་མ་བརྒྱད་ཀྱི་འོམ་དང་ཞེ་དང་མར་དང་ཞུན་མར་དང་མར་གྱི་ཉིང་ཁུ་དང་གཞན་ཡང་ཡོ་བྱད་ཀྱི་ཁྱད་པར་བཟང་དཙིག་གིས་བསྐྱེད་བསྲིངས་ཏེ།",
    "བཅོམ་ལྡནའདས་ཀྱི་བསྟན་པ་ལ་ནརབ་ཏུ་འབྱུང་གིས།",
    "དེ་ནས་རེ་ཤག་ན་ཕ་མ་གཉིས་ལ་གསོལ་ནས།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྔདས་ཞེས།",
    "བཙུན་པ་དཀར་མོས་ལས་གང་དག་བགྱིས་ན་དེས་ཕྱུག་པོའི་རིག་སུ་སྐྱེས་ཏེ།",
    "དཀར་མོ་དེ་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་དེ་དག་གཞན་སུ་ཞིག་གིས་ཉམསུ་མྱོངོབར་འགྱུར་ཏེ།",
    "ལུས་ཅན་དག་གིས་ལས་རྣམས་ནི་བསྐབབརྒྱར་ཡང་ཆུད་མི་ཟ།",
    "འོད་འདེམ་གང་གིས་བརྒྱན་པ།",
    "འདིལ་རྒྱུ་ཅིཞིག་ཡོདདེདག་གིས་སྨྲས་པ།",
    "འོད་འདོམ་གང་གིས་བརྒྱནཔ།",
    "དེས་བདེནཔ་མཐོངནས་སྐྱེ་དགུའི་བདག་མཆེན་མོའི་ཐང་དུ་རབ་ཏུ་བྱུང་ངོ།",
    "བཅོམ་ལྡནའདས་གལ་བ་དེ་ལེགས་སུ་ཐལ་མོ་སྦྱརབ་བཏུད་ནས་བཅོམ་ལྡན་འདས་ལའདིསྐདཅེས་གསོལཏོ། ། ལན་ཅིག་བཀའ་སྩལ་བས་རག་གིས་བཟུད་བར་འཚལ་ན།",
    "ལུས་ཅན་དག་གི་ལས་རྣམསནི་། བསྐལ་བ་བརྒྱར་ཡང་ཆུད་མི་ཟ།",
    "དེ་ནས་རེ་ཤིག་ན་བྲམ་ཟའི་བུ་མོ་ཞིག་བཅོམ་ལྡན་འདས་ངེ་ད་སྐུད་གི་བ་སྟན་པ་ལ་རབ་ཏུ་བྱུང་ངོ།",
    "དེ་ན་ས་རེ་ཤིག་ན་ལྷོ་ཕྱོགས་ནས་ཟློས་གར་མཁན་གྱི་སློབ་དཔོན་ཞིགའེངས་དེའི་བུ་མོ་ཨུང་པ་ལ་ཞེས་བྱ་བ་གཟུགས་བཟང་ཞིང་བལྟ་ན་སྡུག་ལ་མཛེས་པ་ཡན་ལག་དང་ཉིདལ་ཐས་ཅདདང་ལྡན་པ།",
    "དེར་གང་གི་ཚེ་ངུས་སྟོན་བྱུང་བ་དེའི་ཚེ་རྫོགས་བྱེད་ལ་སོགས་པ་སྟོན་བ་དྲུག་ཀྱང་འོང་ངོ།",
    "ཨུད་པ་ལརྒྱན་ཐམས་ཅད་ཀྱིས་ཀླུབས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་ཐད་དུ་སོང་ངོ།",
    "བུད་མེད་ཀྱི་མཚན་མ་རྣམས་དང་ཆ་བྱད་མེདཀྱི་རྟགས་རྣམས་དང་བུད་སད་ཀྱི་བརྡའ་རྣམས་དང་བུད་མེདཀྱི་རྩེད་མོ་རྣམས་ཀྱང་སྟོན་པར་བྱེད་དོ།",
    "དེ་ཐོས་ནས་ཁ་ཅིག་གིས་ནི་འཇིག་ཚོགས་ལ་ལྟ་བའི་རེའི་རྩ་མོ་མཐོན་པོ་ཉི་ཤུ་ཡ་ཤས་རྡོརྗེས་བཅོམ་ནས་རྒྱུན་ཏུ་ཞུགས་པའི་བྲས།",
    "ཁ་ཅིག་གིས་ནི་ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་མངོན་སུམ་དུ་བྱས་སོ།",
    "ཁ་ཅིག་གིས་ནི་བྱར་མི་འོང་བའི་འབྲས་བུ་མངོན་སུམ་དུ་བྱས་སོ།",
    "ཁ་ཅིག་གིས་ནི་རབ་ཏུ་བྱུང་སྟེཉོན་མོངས་པ་ཐམ་ཟུག་༦༣ཅད་སྤངས་ནས་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བྱས་སོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ནས་དགྲ་འཅོམ།",
    "དེ་ནས་རེ་ཤིག་ན་རྒྱལ་པོ་དོབཙུན་མོདང་ལྷན་ཅིག་ཏུ་རྩེ་ཞིང་དགའལ་དགའ་མགུར་སྤྱོད་དོ།",
    "ཨུདེ་རྩེ་ཞིང་དགའ་ལ་དགའ་མགུར་སྤྱོད་པ་ལས་ཕྱིས་བཙུན་མོལ་བུ་ཆགས་ནས།",
    "དོམ་མ་བརྒྱང་ཀྱིས་འོ་མ་དང་ཞོ་དང་མར་དང་ཞུན་མར་དང་མར་གྱི་ཉིང་ཁུ་དང་གཞན་ཡང་ཡོ་བྱང་ཀྱི་ཁྱདཔར་བཟང་ངོ་ཅོག་གིས་བསྐྱེདབསྲིངས་ཏེ།",
    "གར་བྱེད་ཅིང་གླུ་ལེན་ལ་རོལ་མོ་བྱེད་དོ།",
    "དེཐོས་ནས་མིའམ་ཅིའི་བུ་མོའི་བྱངག་ཟུགས་ཀྱིས་རྒྱགས་པ་མེདཔར་གྱུར་ཏོ།",
    "མིའམ་ཅིའི་བུ་མོ་དེ་ནི་ཨུདཔ་ལ་འདི་ཉིད་ཡིན་ནོ།",
    "ཨུདཔ་ལ་ཉིད་ཆེད་ཀྱིས་ལས་བྱས་ཤིང་བསགས་པ་དེ་དག་གཞན་མུ་ཞིག་གིས་ཉམས་སུ་མྱོང་བར་འགྱུར་ཏེ།",
    "ཆུའི་ཁམ་པདང་མེའི་ཁམས་དང་དྲུང་གི་ཁམས་ལ་རྣམ་པར་སྨིན་པར་མི་འགྱུར་ཏེ།",
    "ལུམ་ཅན་དག་གི་ལས་རྣམས་ནི།",
    "དེ་ནས་རེ་ཤིགན་ལྷོ་ཕྱོགས་ནས་ཟློས་གར་མཁན་གྱི་སློབ་དཔོན་ཞག་འོངས་སོ་ དེར་གད་གི་ཚེ་རྒྱལ་པོ་མ་རྡོས་པ།",
    "དག་སློང་ཁྱོད་ཀྱིས་དལྟར་བསླབ་པར་བྱའོ།",
    "ཡབརྟ་འོག་གི་རྒྱལ་བ་རྣམས་ལ་དསྟེ་ཞག་འདུནན་བུ་མོ་ཀ་ཤི་མཛེས་ལྡན་མ་རང་ཉིད་ཀྱི་ཁྱིམ་ཐབ་འདམ་བར་ཆད་ཀྱིས།",
    "བུ་མོཀ་ཤི་མཛེས་ལྡནམ་ཡང་ཤིང་རྟ་ལ་ཞོན་ཏེ་ཚེས་གོས་ཆེན་ཅན་གྱི་བ་དན་བསྒྲེང་ནས།",
    "དནས་བཅོམ་ལྡན་འདས་ཉིས་ཀྱིས་སྐྱེ་དགུའི་བདག་མོ་ཆེན་མོ་ལ་གཏད་དོ།",
    "ཁྱོད་འདོད་པ་སྤྱོད་པ་འདི་ནི་མི་སྲིད་ཀྱིས་བཟོ་དཔར་མཛོདཅི་གཅེས་བྱས་སོ།",
    "ལུས་ཅ་ན་དག་། གི་ལས་རྣམས་ནི།"
  ]
}