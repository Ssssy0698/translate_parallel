    "༦པོ་རྣམས་དང་བློན་པོ་ཆེན་པོ་རྣམས་དང་ཕྱུག་པོརྣམས་དར་པོ་བྲང་འཁོར་གྱི་མི་རྣམས་དང་ཚོད་དབོན་རྣམས་དང་རེད་དཔོན་རྣམས་དང་ལྷ་རྣམས་དང་ཀླུ་རྣམས་དང་གནོད་སྦྱིན་རྣམས་དང་ལྷ་མ་ཡིན་རྣམས་དང་ནམ་མཁའ་ལྡིང་རྣམསརྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་ཁྱིམ་བདག་མགོན་མེར་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བན་བཞུགས་སོ།",
    "ཡི་དགས་ཀྱི་ཡུལ་དུ་རྒྱ་ཞིང་སོང་བ་ལས།",
    "བཅོམ་ལྡན་འདས་ལ་དོན་འདི་ཞུས་ཤག་དང་དེ་ཁྱོད་ལ་བདག་གི་ལས་ཀྱི་རྣས་པ་ལུང་སྟོན་པར་འགྱུར་ཏེ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་དགའ་བྱེད་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་སོང་ངོ།",
    "ཚོང་དཔོན་གྱི་བུ་མོ་གང་ཡིན་པ་དེ་ནི་ཡིདགས་མོ་འདི་ཡིན་ཏེ།",
    "དགའ་བྱེད་ཁྱོད་ཀྱིས་ད་ལྟར་བསླབ་པར་བྱའོག་ཚེས་ཀྱི་རྣམས་གྲངས་འདི་བསྟན་པན་སྲོག་ཆགས་ས་ཡས་བདེན་པ་མཐོང་བར་གྱུར་ཏོ།",
    "སེར་སྣ་དང་དག་གི་ཉེས་པ་སྤྱོད་པ་སྨད་པའི་ཕྱིར་བརྩོན་པར་བྱ་སྟེ།",
    "འདས་ལ་རྒྱལ་པོ་རྣམས་དང་བློན་པོ་ཆེན་པོ་རྣམས་དང་ཕྱུག་པོ་རྣམས་དང་བེ་བྲང་འཁོར་ཀྱི་མིརྣམས་དང་ཚོང་དཔོན་རྣམས་དང་དེད་དཔོན་རྣམས་རང་ལྷ་རྣམས་དང་ཀླུ་རྣམས་དང་གནོད་སྦྱིན་རྣམས་དང་ལྷ་མ་ཡིན་རྣམས་དང་ནམ་མཁའ་ལྡིང་རྣམས་དང་མི་འམ་ཅིརྣམས་དང་ལྟོ་འཕྱེ་ཆེན་པོ་རྣམས་ཀྱིས་བཀུར་སྟི་བྱས་བླམར་བྱས་རི་མེར་བྱས་མཆོད་ཀྱཱ་བྱས་ཏེ།",
    "འོད་འདོམ་གང་གིས་བརྒྱན་པ།",
    "དེནས་སེར་སྣ་ཀུན་ཏུ་སྟོན་ཅིང་བསྒོམས་ཏེ་མང་དུ་བྱས་པ་དེས་ལྷན་རང་གི་ཡོ་བྱདལ་ལྷག་པར་ཞེན་བཞིན་ངུ་ཤི་ནས་ངང་གི་གནས་ཁང་དུ་ཡི་དགས་སུ་སྐྱེས་སོ།",
    "འོད་འདོམ་གང་གིས་བརྒྱན་པ།",
    "རྨ་སྒྲ་ལྟ་བུའི་གསུང་གིས་ཡི་དགས་དེ་སྐྱེས་ཏེ་བཞིན་བཟངས་ཁྱོད་ཉིད་ཀྱིས་བདག་ཉིད་ཕུར་པའི་ཕྱིར་སོས་དང་སྐུར་བཟེད་འདི་བསྒྲུབས་ཏེ།",
    "དེ་ནི་ཡི་དགས་ཕྱི་བཞིན་སོང་།",
    "དེ་ནས་ཡི་དགས་རྫུ་འཕྲུལ་ཆེན་པོ་རྣ་ཆ་གདུབ་ཀོར་དག་ཅིང་འགུལ་བརྒྱབར་ཐོགས་པ་ལུསདོཤལ་དང་ས་མོ་ངོས་བརྒྱན་པ།",
    "དེ་ཐོས་ནས་དགའ་བ་སྐྱེས་ཏེ་སོང་ངོ།",
    "དེའི་ཆ་དགེ་སློང་སྲོད་དང་ཐོ་རངས་མ་ཉལ་བར་བརྩོན་པ་ལྷུར་བྱེད་པ་ལགོངགནས་པ་དེ་དག་གིས།",
    "ལྷུང་བཟེད་ཐོགསནམ་རྒྱལ་པོའི་ཁབ་ཏུ་བསོད་སྙོམས་ལ་སོང་ངོ།",
    "ཡིང་དགས་ཀྱི་ཡུལ་རྒྱུ་ཞིང་སོང་བ་དང་།",
    "ཉིནམོ་དད་མཚན་མོ་བུ་ལྔ་ལྔ་བཙའ་ཞིང་དེ་ལྟ་བུའི་སྡུག་བསྔལ་མྱོང་ལ།",
    "ཁྱོད་ཀྱིས་སྔོན་ལས་ཅི་ཞིག་བྱས་ན།",
    "ཡི་དགས་མོས་སྨྲས་པ།",
    "དེ་ཁྱོད་ལ་བདག་གི་ལས་ཀྱི་རྣམ་པ་ལུང་སྟོན་པར་འགྱུརརོ།",
    "འདམ་བུ་སྦྱིན་གྱི་བུ་ཚུར་ཤོག་ཁྱོད་འོངས་བ་ལེགས་སོ།",
    "ལུས་ཁྲག་གིས་འགོས་པ།",
    "དེ་ནས་བུད་མེད་དེ་བུ་འདོད་པའི་ཕྱིར་གུ་ལང་དང་ཆུ་ལྷ་དང་ཀུཁེར་དང་བརྒྱ་བྱིན་དང་ཚངས་པ་ལ་འོག་སོགས་པ་དང་།",
    "འཇིག་རྟེན་ན་ཡང་གསོལ་བ་བཏབ་པའི་རྒྱས་བུ་དང་བུ་མོ་སྐྱེ་བར་འགྱུར་རོ་ཞེས་བྱབའིགཏམ་དེ་ཡོདམོད་ཀྱི་དེ་ཡང་དེ་ལ་ནི་མ་ཡིན་ཏེ།",
    "འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་བཞིན་རུ་རེར་ཡང་བྱ་སྟོད་སྟོང་ཡོད་པར་འགྱུར་བར་རིགས་སོ།",
    "ཡེ་ན་གནས་གསུམ་ཚོགས་པ་ལས་བུ་དང་བུ་མོ་སྐྱེའར་འགྱུར་ཏེ།",
    "བདག་གིས་ཡུན་རི་བོ་ནས་སྨོན་སྨོན་པའི་བུ་ངོ་མཐོང་བར་འོང་དོ།",
    "བདག་གི་བྱ་བ་དག་བྱེད་པར་ཤོག་ཅིག།",
    "བདག་གི་རིགས་རྒྱུད་རིང་དུ་གནས་པར་ཤོགཅིག།",
    "ཅི་ནས་དེའི་ཐབས་ཤིག་ཏུ་དགོས་སྙམ་མོ།",
    "ཚོར་དབེན་གྱི་ཆུང་མར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་ཡི་དགས་ཚོ་ནི་ཡིན་ཏེ།",
    "དེས་སྔོན་ཕྲག་དོག་བྱས་པ་དེསན་ཡེ་དགས་མོར་སྐྱེས་ཀོངས་བརྫུན་བྱས་ཏེ་མནའ་བོར་བའི་ལས་ཀྱི་རྣམ་པ་ར་སྨིན་པ་ངས་ཉིན་མོ་དང་མཚན་མབུ་ལྡ་ལྔ་བཙའ་ཞིང་ཟ་བར་གྱུར་ཏོ།",
    "རེ་ཤིག་ན་དེ་ཕན་ཚུན་དུ་ལཁྱམ་པ་ལས་འོད་སྲུང་རྫོགས་བྱེད་ཀྱིས་མཐོང་ནས་དེ་འདི་སྙམ་ཟླདུ་སེམས་ཏེ་འདི་དེ་ལྟ་བུའིགནས་རྣམས་སུ་དགའ་བལས་ན་འདི་ནི་གོར་མ་ཆག་པར་གྲུབ་པའི་སྐྱེས་བུ་ཞིག་ཡིན་གྱིས་བདག་གིས་འདི་རབ་ཏུ་དབྱུང་དོ་སྙམ་མོ།",
    "ཕྱིས་རེ་ཤག་ན་ཁྱའུ་བྱས་ཁུང་དོན་ཞིག་ལ་བྲེལ་ཏེ་ཡངས་པ་ཅན་དུ་སོང་ངོ།",
    "གང་ནས་ཤིའཕོས་གང་དུ་སྐྱེས་ལས་གང་གིས་སྐྱེས་སྙམ་མ།",
    "ལུས་དོ་ཤལ་དང་སེ་མོ་དོས་བརྒྱན་པ།",
    "བཅོམ་ལྡན་འདས་ལ་མེ་ཏོག་གིས་གཏོར་ཏ།",
    "སུ་ནི་ངན་སོང་དུ་གཞོལ་སུ་ནི་ངན་སོང་དུ་འབབ་སུ་ནི་ངན་སེང་ངུ་བབ་སུ་ནི་ངས་ངན་སོང་ནས་ཕྱུར་སྟེ།",
    "སུན་ཡོངས་སུ་སྨིན་ཟན་པ་ལས་རྣམ་པར་གྲོལ་བར་བྱ་སྙམ་དུ་ཡེ་ཤེས་གཟིགས་པ་འཇུག་གོའདིར་སྨྲས་པ།",
    "ལྷུང་བཟེད་བསྣམས་ནས་དགེ་སློང་གི་ཚོགས་ཀྱིས་ཞམ་རིང་བྱས་ཏེ།",
    "རེ་ཤིགན་མཐར་གྱིས་བསོད་སྙོམས་བསྐོར་ཏེ།",
    "སྲིད་པའི་རེད་པ་དང་ཆགས་པ་དང་བཀུར་སྟི་ལ་རྒྱབ་ཀྱིས་ཕྱོགས་པ།",
    "དེའི་དགེ་སློང་ཕྱིས་ཁུང་འདི་ནི་དའིཉན་ཐོས་ཀྱི་དགེ་སློང་ངན་དོན་ལ་མོས་པ་རྣམས་ཀྱི་མཆོག་ཡིན་ནོ།",
    "དགེ་སློང་དག་ཕྱིས་ཁུང་ཉིད་ཀྱིས་སྔོན་ཚེ་རབས་གཞན་དག་ཏུ་ཚོ་གས་རེད་ཅིང་རྐྱེ་ན་གྲུབ་པ་དང་ལྡན་ཏེ།",
