    "རང་གི་ངོ་བོ་དང་རྣམ་པ་གསུམ་སྟེ།",
    "མོད་ལ་ཞེས་བྱ་དེ་མ་ཐགོ།",
    "རྗེས་སུ་ཡི་རང་བའི་མོད་ལ་ཞེས་བྱ་བ་ནི་འདི་ལ་མོད་ཨེལ་ཞེས་བྱ་བའི་སྒྲ་སྨོས་པ་དེ་ནི་འདིར་དེ་མ་ཐག་ཏུ་བྱུང་བ་ལ་བྱ་སྟེ།",
    "ལོརྗེས་སུ་ཡི་རང་བའི་མོད་ལས་སྐྱེས་པ་ནི་ཐོབ་སྟེ།",
    "གང་གི་ཕྱིར་དེས་སྔོན་བསྐལ་པ་གྲངས་མེད་དུ་མར་ཚོགས་བསྒྲུབས་ཏེ།",
    "ཁྱོད་ཀྱིས་མི་འདོད་པའི་ཕྱིར།",
    "ཟླ་བའི་ཏོག་ལ་མར་མེ་མཛད་མ་ཡིན་པར་མི་འགྱུར་ཏེ་ཐལ་ཆེས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་ཀྱང་མར་མེ་མཛད་ཉིད་ཟླ་བའི་ཏོག་ཡིན་པར་མངོན་སུམ་དུ་གཟིགས་སོ།",
    "ལུང་གི་ནི་ཐེ་ཚོམ་སྟེ།",
    "ཤཱ་རིའི་བུ་ཁྱོད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་འདི་ནི་ངེད་ཀྱིས་ཀྱང་ཟླ་བའི་ཏོག་ནི་མར་མེ་མཛད་ཁོ་ན་ཡིན་པར་མངོན་སུམ་དུ་ཡིད་ཆེས་ཀྱིས།",
    "ཁྱོད་ཀྱང་ངེད་ཀྱི་ཚིག་གིས་ཡིད་ཆེས་པར་བྱོས་ལོ་སོམ་ཉི་ལ་སོགས་པ་ལ་གནས་པར་མ་བྱེད་ཅིག་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྤྱིར་བསྟན་པ་ནི་ཡིན་མོད་ཀྱི།",
    "འོན་ཀྱང་བདག་གིས་འབྲས་བུ་བཤད།",
    "དེ་ལྟར་ན་ིསྔ་མའི་སྐབས་སུ་ཟླ་བའི་ཏོག་གི་འབྲས་བུ་བསྟན་པ་ཡང་མཚོན་པའི་ཕྱིར་ཏེ།",
    "ཚིགས་སུ་བཅད་པ་དག་གིས་གསུངས་པའི་དོན་བསྙད་པའོ།་།",
    "གང་གི་ཕྱིར་རྗེས་སུ་ཡི་རང་བ་ཙམ་དང་ལྡན་པ་དེ་རྒྱུར་འགྱུར་བ་དེ་ནི་དེས་ཚེ་གཅིག་༡༤༢།",
    "རྒྱུར་འགྱུར་བས་ན་རྒྱུ་གང་གིས་འགྱུར་བ་དེ་ནི་དེས་བསྐལ་པ་གསུམ་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "ཆེན་པོ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་སོ།",
    "སྟོན་པ་པོ་གཞན་དག་གིས་ནི་བསྟན་ན་ཡང་།",
    "གང་དག་གིས་དོན་ཐོས་ཀྱང་བློ་རྨོངས་པའི་ཕྱིར་ལེགས་པར་ཁོང་དུ་མ་ཆུད་པ་རྣམས་དང་།",
    "ནུ་༧༣ ༡༡ པ་སོ་སོ་ཡང་དག་པར་རིག་པ་ཐོབ་པ་ཡིན་པར་བསྟན་པའི་ཕྱིར་ཡང་དོན་དེ་ཉིད་ཚིགས་སུ་བཅད་པ་དག་གིས་བཟླས་ཏེ་གསུངས་སོ།",
    "ཚིགས་སུ་བཅད་པ་རྣམས་ནི་རྣམ་པ་དྲུག་གིས་བསྟན་ཏེ།",
    "འགག་པ་མེད་པ་ལ་སོགས་པ་སྟོན་པ་དེ་དག་གི་ཚུལ་ནི་ཡང་དག་པའི་ཀུན་རྫོབ་ཉེ་བར་བཟུང་སྟེ་དེ་དག་བསྟན་པ་དང་།",
    "ཐོབ་པ་ཡོངས་སུ་ཉམས་པར་འགྱུར་བའི་ཉམས་པ་ནི་མེད་མོད་ཀྱི།",
    "བདུད་སྨོས་པས་ནི་ཉོན་མོངས་པ་དང་།",
    "འཆི་བདག་གི་བདུད་རྣམས་བསྡུའོ།",
    "ཀླུང་གི་བྱེ་མ་སྙེད་ཅེས་བྱ་བ་ལ་སོགས་པས་བསྟན་ཏེ།",
    "ཡོངས་སུ་བཀང་བའི་བྱེ་བྲག་གིས།",
    "གང་གཱའི་ཀླུང་གི་བྱེ་མ་ིསྙེད་དེ།",
    "ཚིག་གི་གཟི་བརྗིད་གང་ཡིན་པ་དང་།",
    "ལུས་ནི་རྣམ་གསུམ་བྱེ་བྲག་གིས།",
    "བྱེ་བྲག་གིས་ནི་གནོད་པ་གསུམ།",
    "ཡང་ན་གང་གི་ཕྱིར་གནམ་གྱིས་བསྐོས་པ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་གནོད་པ་སྐྱེ་རྣམ་པ་གསུམ་དུ་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་ལས་མ་གཏོགས་པར་འབྲས་བུ་ཅི་ཡང་མེད་པའི་ཕྱིར་ཏེ།",
    "བྱེ་བྲག་གིས་ནི་གཞན་གཉིས་བསྟན།",
    "རང་གི་རྐྱེན་ལས་གྱུར་པ་དང་།",
    "ནང་གི་བྱམས་པ་ལ་སོགས་པས་སེམས་ཀྱིས་ལུས་དཀྲི་བ་སྟེ།",
    "༡༥ ༡གཅིག་གིས་སྤྲོ་བར་བྱ་བ་བསྟན།",
    "འཆག་པར་འགྲོ་བ་ཞེས་བྱ་བའི་ཚིག་གིས་བསྟན་ཏེ།་",
    "དེ་དག་གི་ཏིང་ངེ་འཛིན་སྟོན་པས་ན།",
    "སྟོན་པ་ལ་སོགས་བྱེ་བྲག་གིས།",
    "སྔར་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་གཟུངས་བསྐྱེད་པའི་ཆོ་ག་གསུངས་མོད་ཀྱི།",
    "འདི་ལྟར་དེས་གཟུངས་བདག་གིས་བསྐྱེད་པར་བྱའོ་ཞེས་དམ་བཅས་ན།",
    "འདུ་བའི་བྱེ་བྲག་གིས་རྣམ་པ་གསུམ་དུ་འགྱུར་ཏེ།",
    "ཟང་ཟིང་གི་བགོ་བཤའོ་རྒྱུ།",
    "གཟུངས་དོན་བསྟན་པ་ཡིན་མོད་ཀྱི།",
    "གཟུངས་ཀྱི་དོན་བསྟན་པའི་སྐབས་ཡིན་མོད་ཀྱི་སྤྱིར་བསྟན་ཏེ་གསུངས་པའི་བྱས་པ་གཟོ་བ་ལ་སོགས་པ་གང་ཡིན་པ་དེ་ནི་གཞན་དུ་ཡང་བྱ་དགོས་པའི་ཕྱིར་དོན་དེ་བསྟན་པའི་ཐ་ཚིག་གོ།",
    "ཡང་ན་འདིའི་མིང་ཅི་ལགས་ཞེས་བྱ་བ་ནི་བདག་གི་དོན་དུ་ཞུ་བའོ།",
    "འདི་ལྟར་སྤྱིར་ཞུས་མོད་ཀྱི།",
    "གང་གི་ཕྱིར་འདིའི་མིང་སྒོ་མཐའ་ཡས་པས་བསྒྲུབ་པ་ཞེས་བྱ་བ་དེའི་ཕྱིར།",
    "བདུད་སྨོས་པས་ནི་ཉོན་མོངས་དང་།",
    "གང་གི་ཕྱིར་འདིའི་མིང་བདུད་ཐམས་ཅད་རྣམ་པར་འཇིག་པ་ཞེས་བྱ་བའི་ཕྱིར།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པ་དེའི་ཕྱིར་འབྲས་བུ་གཞན་ཡོད་པས་ན་མི་ཉུང་བ་ཡང་མ་ཡིན་ལ།",
    "ཡེ་ཤེས་ཕུན་སུམ་ཚོགས་པ་ལ་སོགས་པ་ནི་ཡོན་ཏན་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པའི་ཁོངས་སུ་ཡང་འདུས་མོད་ཀྱི་གཙོ་བོར་བསྟན་པའི་ཕྱིར་ལོགས་ཤིག་ཏུ་བསྟན་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བསྟན་པ་འདི་ལྟ་བུར་ཤིན་ཏུ་རྨད་དུ་བྱུང་བ་གང་གིས་ལྷག་པ་མེད་པའི་དོན་འདི་ལྟ་བུ་འཇིག་རྟེན་མ་ལུས་པའི་དོན་བྱེད་ལ།",
    "བསྟན་པ་དེས་ཀྱང་དེ་ཉིད་ཀྱི་མོད་ལ།",
    "གལ་ཏེ་བདག་གིས་ཀྱང་ལྷག་པ་འགའ་ཞིག་ཐོབ་པར་གྱུར་ན་ནི།",
    "དེ་ཡང་བསྟན་པར་འགྱུར་བ་ཞིག་ན་མ་བསྟན་པས་དེའི་ཕྱིར་ཚོགས་ཡོངས་སུ་རྫོགས་པ་དེ་དག་གིས་ནི་ལྷག་པ་འགའ་ཡང་ཐོབ་པ་མེད་དེ།",
