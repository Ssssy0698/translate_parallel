    "སོ་པེ་སྣར་གི།",
    "སྤྱོད་ཡུལ་ཟབ་མོའི་གཟུངས་འདི་ཇི་ག་བདག་འདྲ་ཉོན་མོངས་བློ་ཞན་པ་ཡིས་ག་ལ་ལྕོགས།",
    "དོན་དེ་དག་གི་སྦྱར་བ་ནི་དེ་ལྟ་བུ་ཡིན་ནོ།",
    "བསྒྲུབ་བྱ་སྒྲུབ་པའི་བྱེ་བྲག་གིས།",
    "སྒྲུབ་པ་རྣམ་པ་ལྔར་འདོད་དོ་། འདི་ལྟར་གླེང་བསླང་བ་ནི་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པའི་བྱེ་བྲག་གིས་རྣམ་པ་གཉིས་སུ་འགྱུར་ཏེ།",
    "རང་གི་ངོ་བོ་དང་རྣམ་པ་གསུམ་གྱིས་བསྟན་ཏེ།",
    "རང་གི་ངོ་བོ་ནི་རྣ་བའི་རྣམ་པར་ཤེས་པས་ངེས་པར་འཛིན་པ་སྟེ།",
    "དེ་ཡང་གང་གི་ཚེ་གོང་མ་དང་སྦྱར་ན་དེའི་ཚེ་འཁོར་རྣམས་ཀྱི་ངེས་པ་བསྐྱེད་པའི་ཕྱིར་བདག་ཉིད་མང་དུ་ཐོས་པར་བསྟན་ཏེ།",
    "འདི་ལྟར་བདག་གིས་དུས་གཅིག་ན་འདི་ཐོས་ཀྱི་དུས་གཞན་ན་ཡང་གཞན་དག་ཐོས་སོ།",
    "བདག་གི་ཚིག་ནི་ཡིད་ཆེས་པར་བྱ་བ་ཡིན་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "འདི་ནི་འདི་ལྟ་བུ་ཞིག་གིས་བསྟན་པ་ལས་ནི་ཕྱིན་ཅི་མ་ལོག་པ་ཡིན་ནོ།",
    "ཤིན་ཏུ་ཉེ་བ་དག་གིས་ནི་འཇིག་རྟེན་གྱི་གུས་པའི་ཁྱད་པར་ཆུང་དུ་དང་།",
    "ཉོན་མོངས་པ་སྤངས་པ་ནི་དགེ་སློང་ཞེས་བྱ་བ་སྟེ།",
    "ཉོན་མོངས་པ་བཅོམ་པས་ན་དགེ་སློང་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་དོན་གྱི་བྱེ་བྲག་གིས་དགེ་སློང་ལན་གཉིས་སུ་སྨོས་སོ།",
    "དེ་བས་ན་དེ་དག་གི་བསམ་འཕགས་པ་སྒོ་མཐའ་ཡས་པ་སྒྲུབ་པའི་གཟུངས་ཀྱི་རྒྱ་ཆེར་འགྲེལ་པ།",
    "དེ་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་ཅག་གི་༤ ཕྱིར་སྐུ་ཡོངས་སུ་བཏང་ིབ་ཡང་མཛད་དོ་སྙམ་དུ་འཛིན་པ་རྣམས་བཅོམ་ལྡན་འདས་ལ་གུས་པ་བསྐྱེད་པའི་ཕྱིར་རོ།",
    "ནང་གི་ཁྱད་པར་དུ་འཕགས་པ་དང་།",
    "འདི་དག་ལ་སོགས་ཚིག་གིས་ནི།",
    "གདུལ་བའི་བསམ་པའི་བྱེ་བྲག་གིས་མྱ་ངན་ལས་འདའ་བར་འཇུག་པའི་ཕྱིར།",
    "མ་བསྒྲིམས་པར་བསྡུས་པ་ནི་མོད་གལ་གྱི་བུ་ཆེན་པོས་བྱས་པ་སྟེ།",
    "ཏིང་ངེ་འཛིན་གྱི་བྱེ་བྲག་གིས་བསྐྱེད་པའི་རྟགས་ཀྱིས་བྱེ་བྲག་འགའ་ལ་བལྟས་ཞེས་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གང་གིས་མ་མཛད་པའི་རྣམ་པ་དེ་མེད་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "བཅོམ་ལྡན་འདས་ཉིད་ཀྱི་མཛད་སྤྱོད་མོད་ཀྱི།",
    "དེ་བས་ན་གུས་པ་བསྐྱེད་པའི་ཕྱིར་བཅོམ་ལྡན་འདས་ཀྱིས་མོད་གལ་གྱི་བུ་ཆེན་པོ་ལ་སོགས་པ་ལ་སྡུད་དུ་བཅུག་གོ།",
    "དེ་ཡང་སོང་ལ་ཞེས་འཕགས་པ་སྒོ་མཐའ་ཡས་པ་སྒྲུབ་པའི་གཟུངས་ཀྱི་རྒྱ་ཆེར་འགྲེལ་པ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་མ་ཐག་ཏུ་རི་རབ་ཀྱི་རྩེ་མོ་ལ་འདུག་སྟེ།",
    "སྐད་ཅིག་གིས་གོ་བར་བྱས་པའོ།",
    "རང་གི་རྫུ་འཕྲུལ་གྱི་སྟོབས་སྨོས་པ་ཡང་གཉིས་ཀ་དང་སྦྱར་བར་བྱའོ།",
    "རི་རབ་ཀྱི་རྩེ་མོ་སྨོས་པ་དང་།",
    "འོ་སྟོང་གི་འཇིག་རྟེན་གྱི་ཁམས་སུ་གོ་བར་བྱེད་པ་འདི་གཉིས་ནི་ཆེ་བ་ཉིད་བསྟན་པའི་ཕྱིར་ཏེ།",
    "རྗེས་སུ་ཆགས་པ་ལ་སོགས་པ་མེད་པར་ཤེས་པར་བྱ་བའི་ཕྱིར་མཐའ་དག་གི་དོན་དང་།",
    "ཉོན་མོངས་པ་སྤངས་པ་དང་ལྡན་པ་དང་འདུས་པའོ།",
    "དེ་ནས་གོ་རིམས་བཞིན་བྱས་ནས་གོང་གི་ཕྱིར་ལྷགས་པ་དེའི་ཕྱིར་འཁོད་དོ།",
    "རང་གི་ངོ་བོ་སྟེ།",
    "དེ་དག་རྣམ་པ་བཞི་དག་གིས།",
    "ཡོན་ཏན་བསྒྲུབས་ིཔའི་འབྲས་བུ་ཐོབ་པ་དེས་གང་གིས་མཐོང་བ་དོན་ཡོད་པར་གྱུར་པ་དེ་ལྟ་བུའི་ཡོན་ཏན་བསྒྲུབས་པས་ན་དེའི་ཕྱིར་མཐོང་བ་དོན་ཡོད་ཀྱི་གསུངས་པའོ།",
    "གཙོ་བོའི་བྱ་བའོ་། གཙོ་བོ་མ་ཡིན་པའི་བྱ་བ་ཡང་རང་གི་ངོ་བོ་དང་།",
    "གདུལ་བའི་རང་གི་ངོ་བོ་དང་།",
    "རང་གི་ངོ་བོས་བསྟན་ཏེ།",
    "དེའི་གདུལ་བའི་རང་གི་ངོ་བོ་བསྟན་པ་ནི།",
    "དད་པས་མོས་པ་ནི་མོས་པས་སྤྱོད་པའི་ས་ཐོབ་པ་རྣམས་སོ།",
    "དེའི་གོ་རིམས་ཀྱི་དོན་ནི་ཕལ་ཆེར་གོང་དུ་ཐལ་བས་རྣམ་པར་མི་ཕྱེའོ།",
    "སྐྱོན་དང་ཉོན་མོངས་ཕུང་པོ་བསྩལ།",
    "གང་གི་ཕྱིར་ཕྱིན་ཅི་མ་ལོག་པར་གསུངས་པས་ན་དེ་བཞིན་གཤེགས་པ་སྟེ།",
    "དེ་ཡང་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་སྤངས་པའི་ཕྱིར་རོ།",
    "དེའི་དེ་ཡང་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་སྤངས་པའི་ཕྱིར་རོ།",
    "དད་པས་མོས་པ་ལ་སོགས་པས།",
    "གདུལ་བྱའི་བསམ་པའི་བྱེ་བྲག་གིས།",
    "དེ་རྣམས་ཀྱིས་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་ཉིད་འཐོབ་པ་དང་།",
    "དད་པས་མོས་པ་རྣམས་ཀྱིས་ས་ཐོབ་པར་བསྟན་ཏོ།",
    "སོམ་ཉི་སྤངས་པས་སྡུག་བསྔལ་ལ་སོགས་པའི་བདེན་པ་མཐོང་བས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པའི་ཚོགས་ཀྱང་སྤངས་པར་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "ཆུང་ངུ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་ཐ་དད་པ་བསྡུ་བའི་ཕྱིར་རོ།",
    "སྒྲིབ་པ་མེད་པ་ནི་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་སྤངས་པའི་ཕྱིར་ཏེ།",
    "དེ་ནི་རང་གི་སྟོབས་ཡིན་ནོ།",
    "སྐྱེ་བ་གཅིག་གིས་ཐོགས་རྣམས་ཀྱིསོ།",
    "ཕྱིར་མི་ལྡོག་པ་རྣམས་ཀྱིས་ནི་རྣམ་པ་བཞིས་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པའི་ས་འཐོབ་པར་འགྱུར་ཏེ།",
    "དེས་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པར་འགྱུར་རོ།",
    "གདུལ་བའི་བསམ་པའི་བྱེ་བྲག་གིས་ཅི་འགའ་འགྱུར་ཞིང་ཀུན་དུ་སྟོན་པས་ན་ཞིང་ཡོངས་སུ་དག་པའོ།",
