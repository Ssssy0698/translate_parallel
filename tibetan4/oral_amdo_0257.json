    "དེ་དག་གི་བག་ཆགས་གནས་ངན་ལེན་ནི་རྩ་བའི་ལྟ་བ་དང་།",
    "འགགས་པ་རྣམས་རང་གི་བདག་ཉིད་དུ་མེད་པ་དང་།",
    "སྐྱེས་པ་རྣམས་སྐད་ཅིག་མ་ཡིན་པས་རང་གི་ངོ་བོ་ལ་པམི་གནས་པ་དང་།",
    "ཡང་ཀུན་ཏུ་བརྟགས་པའི་ངོ་བོ་ཉིད་ལ་རང་གི་མཚན་ཉིད་མེད་པས་མཚན་ཉིད་ངོ་བོ་ཉིད་མེད་པ་དང་།",
    "བརྗོད་པ་ཟབ་མོ་ལ་ལྟོས་ཏེ་བསྟན་པ་ནི་པ་དེབ་ལྔ་པ།",
    "རེ་ཞིག་གང་ཟག་གི་འགྲོ་བའི་དབྱེ་བ་ནི་གང་ཟག་རྫས་སུ་མེད་ཀྱང་རྣམ་པ་བཞིས་གང་ཟག་རྣམ་པར་བཞག་སྟེ།",
    "ཉོན་མོངས་པ་ཆ་མཉམ་པ་ལ་སྤྱོད་པ་དང་།",
    "རང་བཞིན་གྱིས་ཉོན་མོངས་པ་ཆུང་བའི་གང་ཟག་གོ།",
    "གང་ཟག་གཞན་གྱི་དྲིང་གིས་འགྲོ་བ་དད་པའི་རྗེས་སུ་འབྲང་བ་དང་།",
    "དད་པ་ལྷག་པར་གྱུར་པ་དེ་འབྲས་བུ་ཐོབ་པ་ན་དད་པས་མོས་པ་དང་།",
    "ཤེས་རབ་ཀྱིས་ཉོན་མོངས་པའི་སྒྲིབ་པ་ལས་རྣམ་པར་གྲོལ་བ་དང་།",
    "ཤེས་རབ་དང་ཏིང་ངེ་འཛིན་གྱིས་ཉོན་མོངས་པ་དང་སྙོམས་འཇུག་གི་སྒྲིབ་པ་གཉི་གའི་ཆ་ལས་རྣམ་པར་གྲོལ་བ་དང་།",
    "རྒྱུན་ཞུགས་འབྲས་གནས་སྒོམ་སྤང་གཅིག་ཀྱང་མ་སྤང་བ་དེ་ནི་རེ་ལྟར་ཐོགས་ན་སྲིད་པ་ལན་བདུན་པ་དང་།",
    "འཆི་འཕོ་གཞན་སྲིད་རྩེ་མོར་འགྲོ།",
    "བྱང་སེམས་ཚོགས་སྦྱོར་བ་མོས་པས་སྤྱོད་པ་ཅན་དང་།",
    "ཉོན་མོངས་པ་ཤས་ཆུང་བ་རྣམ་པར་སྤངས་ནས་མཉམ་པའི་རང་བཞིན་དུ་གནས་པའོ།",
    "དེ་ཡང་དངོས་པོ་ཇི་ལྟ་བ་དང་མཐུན་པར་ཉོན་མོངས་པ་ཀུན་ཏུ་འབྱུང་ཞེས་པའི་དོན་ཏོ།",
    "ཉོན་མོངས་པ་ཆུང་བ་གང་ཞེ་ན།",
    "དམིགས་ནས་མོས་པ་དང་དད་པ་ཆུང་བའི་གང་ཟག་སྟེ།",
    "མོས་པ་ལས་གྱུར་པ་དང་།",
    "དེ་དང་རབ་ཏུ་ལྡན་པའི་བསྟན་པ་ལ་མོས་པ་དང་ལྡན་པ་གང་ཡིན་པ་ནི་མོས་པ་ལས་གྱུར་པའོ།",
    "དད་པས་རྗེས་སུ་འབྲང་བའི་གང་ཟག་གང་ཕྱིས་དགེ་སྦྱོང་གི་ཚུལ་གྱི་འབྲས་བུའི་དུས་ནའོ།",
    "གང་ཤེས་རབ་ཀྱིས་མཐུས་མི་མཐུན་པའི་ཕྱོགས་ཉོན་མོངས་པའི་སྒྲིབ་པའི་ཟག་པ་ཟད་པ་སྟེ།",
    "གང་ཉོན་མོངས་པ་དང་སྙོམས་པར་འཇུག་པའི་སྒྲིབ་པ་གཉིས་ཀའི་ཟག་པ་ཟད་པ་དང་།",
    "འདོད་པའི་སྒོམ་སྤོང་གི་ཉོན་མོངས་པ་དྲུག་པ་སྤངས་ནས་ཕལ་ཆེར་ལ་འདོད་ཆགས་དང་བྲལ་བ་ནི་ཡང་དག་པ་ཉིད་དུ་ངེས་པར་གྱུར་པ་ལ་ཞུགས་ནས།",
    "འདོད་པ་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་དགུ་པོ་རྣམས་ལས་འདོད་ཆགས་དང་བྲལ་བ་ནི་ཡང་དག་པ་ཉིད་དུ་ངེས་པར་གྱུར་པ་ལ་ཞུགས་ནས།",
    "གང་གི་ཚེ་མཐོང་བས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ནས།",
    "གང་སྲིད་པའི་རྩེ་མོ་པའི་ཉོན་མོངས་པ་རྣམས་ཀྱི་རྣམ་པ་བརྒྱད་སྤངས་པའི་ལམ་ལ་གནས་པའི་གང་ཟག་གོ།",
    "གང་སྲིད་པའི་རྩེ་མོ་པའི་ཉོན་མོངས་པའི་རྣམ་པ་དགུ་པ་སྤངས་པའི་ལམ་ལ་གནས་པའི་གང་ཟག་གོ།",
    "གང་གི་ཚེ་ཁམས་གསུམ་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་པས་དགྲ་བཅོམ་པར་འགྱུར་ན།",
    "རེ་ལྟར་ཐོགས་ན་སྲིད་པ་ལན་བདུན་པ་གང་ཞེ་ན།",
    "ལྷ་དང་མི་རྣམས་ཀྱི་ནང་དུ་རིགས་ནས་རིགས་སུ་སོང་ནས་གང་སྡུག་བསྔལ་གྱི་མཐའ་མ་ཐོབ་པ་སྟེ་འདི་ཡང་རྒྱུན་ཏུ་ཞུགས་པའོ།",
    "ལ་ལ་ནི་བསམ་གཏན་སྤེལ་མར་མ་བསྒོམས་པས་གནས་གཙང་མ་རྣམས་བོར་ཏེ་སྲིད་པའི་རྩེ་མོའི་བར་དུ་སོང་ནས་ལམ་མངོན་དུ་བྱས་ཏེ་སྡུག་བསྔལ་གྱི་མཐའ་མ་ཐོབ་པའོ།",
    "མོས་པས་སྤྱོད་པ་ཅན་གང་ཞེ་ན།",
    "ཆེན་པོའི་འབྲིང་པོ་རྩེ་མོ་དང་བཟོད་པའི་སྐབས་དང་།",
    "དེ་རང་གིས་མངོན་དུ་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "བཙུན་པར་སྐྱེ་བའི་ཁྱད་པར་རང་གི་རིགས་ཡང་དག་པར་འཛིན་པ་དང་།",
    "འབྲས་བུའི་ཁྱད་པར་ནི་གནས་གྱུར་པའི་ཁྱད་པར་ཉོན་མོངས་པའི་གནས་ངན་ལེན་ཐམས་ཅད་སྤངས་ཏེ་ཡོན་ཏན་བླ་ན་མེད་པ་ཐམས་ཅད་ཀྱི་གནས་ཉིད་དུ་གྱུར་པ་དང་།",
    "རྣམ་པར་དག་པའི་ཁྱད་པར་ནི་བག་ཆགས་དང་བཅས་པའི་ཉོན་མོངས་པ་སྤོང་བ་དང་།",
    "སྒྲིབ་པ་རྣམ་པར་དག་པའི་ཁྱད་པར་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་ཐམས་ཅད་སྤོང་བར་བྱས་པ་དང་།",
    "ངན་སོང་ལས་སྐྱོབ་པ་ནི་མཐོང་བའི་ལམ་བསྐྱེད་པས་ངན་འགྲོ་ལས་ཐར་བ་དང་།",
    "ཉོན་མོངས་པ་མེད་པ་དང་།",
    "ནང་གི་གཟུགས་མེད་པར་འདུ་ཤེས་པས།",
    "མཐོང་ཞེས་པ་ནི་ལྷག་མཐོང་གི་ལམ་གྱིས་སོ།",
    "དག་གི་འདོད་ཆགས་ལ་སོགས་པ་སེམས་ཀྱི་སྤྱོད་པ་ཐམས་ཅད་ལ་འཇུག་པ་ཡང་དག་པར་འབྱོར་བའི་ཞེས་བྱ་བ་སྔ་མ་བཞིན་ནོ།",
    "བསམ་གཏན་ལ་བརྟེན་ནས་གང་གིས་ཟག་པ་རྣམས་ཡོངས་སུ་ཟད་པ་ཤེས་པ་ཡང་དག་པར་འབྱོར་བའི་ཏིང་ངེ་འཛིན་དང་།",
    "ལས་བདག་གིར་བྱ་བ་མཁྱེན་པའི་སྟོབས་གང་ཞེ་ན།",
    "ལས་བདག་གིར་བྱ་བ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཡང་དག་པར་འབྱོར་བའི་ཞེས་བྱ་བ་སྔ་མ་བཞིན་ནོ།",
    "མོས་པ་སྣ་ཚོགས་པ་མཁྱེན་པའི་སྟོབས་དང་།",
    "ཁྱུ་མཆོག་གི་གནས་རྒྱ་ཆེན་པོར་ཞལ་གྱིས་འཆེའོ།",
    "རང་གི་དོན་ལས་བརྩམས་ཏེ་སྤངས་པའི་ཁྱད་པར་ཟག་པ་ཟད་དོ་ཞེས་ཟག་པའི་རྣམ་པ་བག་ཆགས་དང་བཅས་པ་ཐམས་ཅད་ཟད་པར་ཞལ་གྱིས་འཆེ་བ་འཇོག་པ་ཡང་དག་པར་འབྱོར་བའི་ཞེས་བྱ་བ་སྔ་མ་བཞིན་ནོ།",
    "འདི་ནི་འཕགས་པ་ངེས་པར་འབྱིན་པའི་ལམ་མོ་ཞེས་ངེས་པར་འབྱིན་པའི་ལམ་གྱི་རྣམ་པ་ཐམས་ཅད་སྟོན་པར་ཞལ་གྱིས་འཆེ་བ་འཇོག་པ་ཡང་དག་པར་འབྱོར་བའི་ཞེས་བྱ་བ་སྔ་མ་བཞིན་ནོ་། དྲན་པ་ཉེ་བར་གཞག་པ་གསུམ་གང་ཞེ་ན།",
    "སོ་སོར་མ་བརྟགས་པའི་བཏང་སྙོམས་མི་མངའ་བ་སྟེ་ཕྲིན་ལས་ཐུན་མོང་མ་ཡིན་པ་ཡོངས་སུ་དག་པ་ཡང་དག་པར་འབྱོར་བ་དང་།",
    "ལདྲན་པ་དང་ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་རྣམས་དང་དེ་དག་གི་གནས་འདུན་པ་དང་འབྲས་བུ་རྣམ་པར་གྲོལ་བ་དང་བཅས་པ་རྣམས་མ་ཐོབ་པའི་ཡོངས་སུ་ཉམས་པ་མེད་པ་ཡང་དག་པར་འབྱོར་བ་དང་།",
    "སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་ཕྲིན་ལསཐམས་ཅད་ལ་ཡེ་ཤེས་སྔོན་དུ་འགྲོ་ཞིང་ཡེ་ཤེས་ཀྱི་རྗེས་སུ་འབྲང་བས་ཐུན་མོང་མ་ཡིན་པའི་ཕྲིན་ལས་མཛད་པ་ཡང་དག་པར་འབྱོར་བ་དང་།",
    "འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་བྱུང་བའི་དུས་ལ་མ་ཆགས་མ་ཐོགས་པའི་ཡེ་ཤེས་འཇུག་པ་ཡེ་ཤེས་ལ་གནས་པ་ཐུན་མོང་མ་ཡིན་པ་ཡང་དག་པར་འབྱོར་བའི་ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་འདི་གང་ཡིན་པ་ཞེས་བྱ་བ་སྔ་མ་བཞིན་ནོ།",
    "རང་གི་བྱ་བ་ལ་ཉེ་བར་གནས་པ་དང་།",
    "རང་གི་སྤང་བྱ་མི་མཐུན་པའི་ཕྱོགས་སྤོང་བའི་བྱ་བ་ལ་ཉེ་བར་གནས་པ་གང་ཡིན་པ་དེ་དག་ནི་འཇིག་རྟེན་ལས་འདས་པའི་རྗེས་ལས་ཐོབ་པ་ཀུན་རྫོབ་ཤེས་པའི་རང་བཞིན་དུ་བལྟའོ།",
    "འགོག་པས་མོས་པའི་ཕྱིར་འཕགས་པའི་གནས་པ་མཆོག་ཏུ་ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་དང་བཅས་པ་རབ་ཏུ་ཞི་བའི་གནས་པས་གནས་སོ།",
    "ཉོན་མོངས་པ་མེད་པས་ལས་ཅི་མཛད་ཅེ་ན།",
    "ལྷའི་རྣ་བས་སྒྲའི་རྣམ་པ་ཐམས་ཅད་རྟོགས་ནས་ངག་གི་ལས་ཀྱིས་འདུན་པར་མཛད་དོ།",
    "མོས་པ་སྣ་ཚོགས་པ་མཁྱེན་པའི་སྟོབས་ཀྱིས་བསམ་པའི་བྱེ་བྲག་རྣམས་རྟོགས་པ་དང་།",
    "སྟོབས་བཅུ་པོ་འདི་དག་གིས་ཐམས་ཅད་དུ་དྲི་བ་དྲིས་པ་ཡང་ལུང་སྟོན་ཏོ།",
    "རྗེས་སུ་ཆགས་པ་ལ་སོགས་པ་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པས་ཚོགས་ཡོངས་སུ་སྡུད་དོ།",
    "རང་གི་ཉེས་པ་བརྗོད་དུ་དོགས་ནས་བསྲུང་བ་མེད་པས་རྒྱུན་མི་འཆད་པར་ཚོགས་ལ་གདམས་ངག་འདོམས་སོ།",
    "ཉོན་མོངས་པ་མེད་པས་ཇི་ལྟར་དགེ་སློང་དགྲ་ནབཅོམ་པ་འཁྲུལ་པ་ལ་སོགས་པ་སྟོན་པ་ལྟར་ཉོན་མོངས་པ་ལྟ་བུའི་སྤྱོད་པ་མི་སྟོན་ཏོ།",
    "ཉིན་མཚན་ལན་དྲུག་ཏུ་འཇིག་རྟེན་ལ་སུ་ནི་འཕེལ་པར་འགྱུར་ལ་སོགས་པས་རྣམ་པར་གཟིགས་སོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "མིང་གིས་བརྗོད་པར་བྱ་བའི་ངོ་བོ་ཉིད་དུ་རྣམ་པར་རྟོག་པ་དང་ཚིག་གིས་བརྗོད་པར་བྱ་བའི་ཁྱད་པར་དུ་རྣམ་པར་རྟོག་པ་དང་།",
    "རྣམ་པར་ཞི་བས་ཀྱང་མ་ཡིན་ཏེ་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ཡང་སེམས་དང་སེམས་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པ་རྣམ་པར་ཞི་བའི་ཕྱིར་རོ།",
    "ཡང་ན་རང་གི་མཚན་ཉིད་ཀྱིས་བྱེད་པ་སྟེ་གཟུགས་ནི་གཟུགས་སུ་ཡོད་པའོ་ཞེས་པ་ལ་སོགས་པའོ།",
    "རྗེས་སུ་འཆིང་བ་ལས་གྱུར་པ་ཉོན་མོངས་པའི་ས་བོན་ཡོད་ན་ཀུན་ཏུ་མི་སྤྱོད་ཀྱང་ཉོན་མོངས་པ་དང་ལྡན་པར་འཇོག་པ་དང་།",
    "འབྲེལ་བ་ལས་གྱུར་པ་རང་གི་སྐྱེ་བོ་རྣམས་ཕན་ཚུལ་འབྲེལ་བར་ལྡན་པ་དང་།",
    "མོངས་པ་རྣམས་ནི་ཕྱིན་ཅི་ལོག་གི་འཇུག་པ་དང་།",
    "ཆུད་ཟ་བ་དང་ཆུད་མི་ཟ་བའི་སྒོ་ནི་རབ་ཏུ་ཆུད་ཟ་བ་ཕྱི་དང་ནང་གི་རྫས་ལ་ལྷག་པར་ཆགས་པ་དང་།",
    "དེ་དག་གི་རྣམ་པར་དབྱེ་བའི་མཚན་ཉིད་དང་།",
    "ཉོན་མོངས་པ་ལས་རྣམ་པར་གྲོལ་བ་དང་སྡུག་བསྔལ་ལས་རྣམ་པར་གྲོལ་བའོ།",
    "མོས་པ་ལ་རབ་ཏུ་རྣམ་པར་འབྱེད་པའི་སྟོབས་བསྐྱེད་པ་དང་།",
    "མིག་གི་སྐྱེ་མཆེད་དང་ལྡན་པ་དེ་རྣ་བའི་སྐྱེ་མཆེད་དང་ལྡན་ནམ་ཞེས་པ་ནས་ཡིད་ཀྱི་སྐྱེ་མཆེད་ཀྱིབར་དག་དང་ཅི་རིགས་པར་སྦྱར་རོ།",
    "པལྡན་པ་གང་ཡིན་པ་དེ་མིག་གི་སྐྱེ་མཆེད་དང་ཡང་ལྡན་ནམ་གང་མིག་གི་སྐྱེ་མཆེད་དང་ལྡན་པ་དེ་གཟུགས་ཀྱི་སྐྱེ་མཆེད་དང་ཡང་ལྡན་ནམ་ཞེས་བྱ་བ་ནི་ཚིག་འོག་མ་དང་སྦྱོར་བ་དང་།",
    "ཡང་དཔེར་ན་ཕུང་པོ་མ་གཏོགས་པའི་འདུ་བྱེད་རྣམས་བདེན་པ་གང་གིས་བསྡུས་ཞེས་ཟེར་བ་ལ་ཕུང་པོ་ལ་མ་གཏོགས་པའི་འདུ་བྱེད་གང་ཡང་མེད་དོ་ཞེས་སྤོང་བའོ།",
    "གང་གི་མི་དམིགས་ཤེ་ན།",
    "མོས་པས་སྤྱོད་པ་ནས་ས་བཅུ་པའི་བར་དུའོ།",
    "རྣམ་པ་དུ་ཞིག་གིས་མི་དམིགས་ཤེ་ན།",
    "ཅི་ཞེས་བསྟན་པ་ལ་ཇི་ལྟ་བར་གང་ཞེས་བསྟན་པ་ལ་གང་གིས་མི་དམིགས་པ་དང་།",
    "གང་དང་གང་གིས་དང་།",
    "གང་གི་ཕྱིར་དང་།",
    "གཞན་དག་གི་ཐེ་ཚོམ་མ་ལུས་པ་གཅོད་པར་བྱེད་པ་དང་།",
    "ཐོས་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་ཡིད་ཆེས་པ་མོས་པ་རྣམ་པར་ངེས་པ་དང་།",
    "ངོ་བོ་ཉིད་བསྒྲུབ་པ་ནི་བདག་གི་ངོ་བོ་ཉིད་ཡོད་དོ་ཞེའམ་མེད་དོ་ཞེས་བརྗོད་པ་དང་།",
    "མཐའ་མ་ཐམས་ཅད་དུ་སོང་བ་མ་ཡིན་པ་ལ་སོགས་པ་དང་།",
    "དམ་བཅའ་བ་ནི་བདག་རང་ཉིད་ཀྱི་འདོད་པ་བསྒྲུབ་པའི་ཕྱིར་དོན་དེ་གང་ཟག་གཞན་ལ་ངག་གིས་གོ་བར་བྱེད་དེ་སྟོན་པའོ།",
    "གཏན་ཚིགས་ནི་བསྒྲུབ་བྱ་གང་གི་ངོར་བསྒྲུབ་པ་དེ་ཉིད་ལ་མ་གྲགས་པའི་དོན་གང་ཟག་དེ་དག་ཡིད་ཆེས་པར་བྱེད་པའི་རྒྱུ་བརྗོད་ཚུལ་མངོན་སུམ་དུ་དམིགས་པ་དང་།",
    "གཏམ་རྗེས་གཅད་པ་ནི་བདག་གིས་མ་ལེགས་སོ་ཞེས་རང་གི་སྨྲ་བའི་སྐྱོན་ཁས་བླངས་པ་དང་།",
    "ཁྱོད་ཀྱིས་ལེགས་ཞེས་གཞན་གྱི་སྨྲ་བའི་ཡོན་ཏན་ཁས་བླང་བའོ།",
    "མི་འཇིགས་པ་ནི་གང་གིས་འཁོར་ཐམས་ཅད་དུ་བག་ཚ་བ་མེད་པར་སྨྲ་བར་བྱེད་པའོ།",
    "སྤོབས་པ་ནི་གང་གིས་འཁོར་ཐམས་ཅད་དུ་དྲི་བ་ལན་གདབ་པ་ཤེས་པའོ།",
    "རང་གི་ཡིད་འཁྲུགས་པའི་ཉེས་པ་དང་གང་ཉེས་པ་རྣམ་པ་དྲུག་སྤངས་ཏེ།",
    "རྣམ་པར་གྲོལ་བའི་གནས་རང་གི་ཏིང་ངེ་འཛིན་རྗེས་སུ་བསྲུང་ཞིང་སྨྲ་བ་དཀོན་པ་དང་།"
  ]
}