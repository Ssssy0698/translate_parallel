    "དེ་ནས་དྲང་སྲོང་ཆེན་པོ་རྒྱས་པས་དྲང་སྲོང་ཆེན་པོ་དེ་དག་གི་སེམས་དང་མི་འཇིགས་པ་དམན་ཞིང་ལྟ་བ་དམན་པར་ཁད་ཀྱིས་ཁད་ཀྱིས་བརྟགས་ནས་གུས་པ་སྐྱེས་ཏེ།",
    "རྗེ་ིས་དང་བཅས་པར་དྲང་སྲོང་གི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་ནས་རལ་པ་མང་པོ་བརྗེས་ཏེ།",
    "གཏམ་སྣ་ཚོགས་ཀྱི་གཏན་ཚིགས་དང་ལྡན་པ་དེ་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་དྲང་སྲོང་གི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་བ་གསལ་བ་ཟུར་ཕྱིན་པ།",
    "དཀའ་ཐུབ་དྲག་པོས་ཡོངས་སུ་ཉོན་མོངས་པ་རྙེད་པ་འདིས་ཅི་ཞིག་ཐོབ།",
    "ཅིའི་རྒྱུ་དང་རྐྱེན་གྱི་གཏམ་ཞིག་ཞུ་སྙམ་མོ།",
    "དྲང་སྲོང་ཆེན་པོ་ཁྱོད་ཅི་དང་ཅི་འདོད་པ་དྲིས་ཤིག་དང་།",
    "བཅོམ་ལྡན་འདས་ཁྱོད་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ནས་ཡོངས་སུ་འཛིན་པར་འགྱུར་བ་གང་ལགས།",
    "དྲང་སྲོང་ཆེན་པོ་སེམས་དང་པོ་བསྐྱེད་པའི་གཏམ་ཁྱོད་ཀྱིས་དྲིས་པ་འདི་ནི་རྩིང་ངོ།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་དྲང་སྲོང་ཆེན་པོ་འདི་ལ་སྦྱིན་པའི་འབྲས་བུ་སྦྱིན་པའི་བཀའ་མཆིད་བགྱིའོ།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་དྲང་སྲོང་ཆེན་པོ་རྒྱས་པ་ཅི་དང་ཅི་འཚལ་བ་དྲིས་པའི་ལན་གདབ་པར་བགྱིའོ།",
    "ཤཱ་རིའི་བུ་ཁྱོད་ཀྱང་དེ་སྐད་མི་འཚམ་པར་མ་ཟེར།",
    "སེམས་མ་རངས་ནས་འདི་སྐད་དུ་གང་གི་ཕྱིར་རྒྱས་པས་དྲིས་ཉན་ཐོས་འཆད་དུ་བཅུག་པ་ལས་ན་དེ་བཞིན་གཤེགས་པ་ནི་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་དུ་ངེས་སོ།",
    "གཞན་དུ་སོང་ནས་བྱེད་དུ་བཅུག་པ་དེས་ཀྱང་ནོར་རྣམས་རྣམ་པར་གཏོང་བར་བྱེད་ན་ནོར་གང་གི་ཡིན་པ་དེ་ནི་སྦྱིན་བདག་ཡིན་ནོ།",
    "གང་རང་གི་དངོས་པོ་བདག་ཉིད་ཀྱིས་སྦྱིན་པ་དེ་ནི་གཏོང་བ་པོ་ཡང་ཡིན་ལ་སྦྱིན་བདག་ཀྱང་ཡིན་ནོ།",
    "ཐུན་མོང་མ་ཡིན་པ་ལྔ་བྱིན་ན་སྦྱིན་པ་ཡོངས་སུ་མ་དག་པ་ཡིན་ནོ།",
    "འདི་དག་ནི་བདག་གིར་འགྱུར་ཏེ་བདག་གི་རིམ་གྲོ་དང་།",
    "རྩེད་མོ་དང་།",
    "གང་གི་ཁྱིམ་འམ་ཞིང་ལ་གཞན་གྱི་འབྲུའི་ཕུང་པོ་འམ།",
    "གང་ལང་ཚོ་ལ་བབ་པས་སྦྱིན་པ་བྱིན་པ་དང་།",
    "༤༤མོ་ཞེས་བྱ་བ་ན་བདག་སྦྱིན་བདག་ཏུ་གྲགས་པར་འགྱུར་རོ་སྙམ་སྟེ་གྲག་ིཔའི་རྒྱུར་སྦྱིན་པ་བྱིན་ན་དེ་ཡང་ཡོངས་སུ་མ་དག་པ་ཡིན་ནོ།",
    "བདག་གིས་གང་རིགས་པ་ལ་གཏང་བར་བྱའོ་སྙམ་སྟེ་སྦྱིན་པ་སྦྱིན་ོན་དེ་ཡང་ཡོངས་སུ་མ་དག་པ་ཡིན་ནོ།",
    "དྲང་སྲོང་ཆེན་པོ་དེ་དག་གི་རྣམ་པར་སྨིན་པ་ནི་ཚྭ་སྒོ་ཅན་གྱི་ཞིང་ལ་ས་བོན་ངོན་པ་བཏབ་པའི་མྱུ་གུ་སྐྱེ་བ་ིབཞིན་དུ་བལྟས་སྟེ།",
    "སྦྱིན་པ་དེའི་རྣམ་པར་སྨིན་པ་ནི་མེད་པ་མ་ཡིན་མོད་ཀྱི།",
    "དྲང་སྲོང་ཆེན་པོ་དེ་བཞིན་དུ་སྦྱིན་པ་དེའི་རྣམ་པར་དབྱེ་བ་དེ་ཡང་བསམ་པ་དང་སྦྱོར་བ་ཀུན་ནས་ཉོན་མོངས་པ་ཅན་དུ་གྱུར་པས་འབྲས་བུ་རྣམ་པར་སྨིན་པ་གྲུང་པོར་མི་འགྱུར་རོ།",
    "དེ་ནས་དྲང་སྲོང་ཆེན་པོ་རྒྱས་པས་ཐལ་མོ་སྦྱར་ཏེ།",
    "དྲང་སྲོང་ཆེན་པོ་ཁྱོད་སྦྱིན་པའི་རྣམ་པར་སྨིན་པ་ལ་འཇུག་པ་ཉོན་ཅིག།",
    "དུད་འགྲོའི་སྐྱེ་གནས་སུ་སོང་བ་བྱ་རོག་དང་།",
    "དྲང་སྲོང་ཆེན་པོ་དེ་བཞིན་དུ་གང་དག་གིས་ང་ལ་གཟུགས་ཀྱི་སྐུར་མཐོང་ལ་བསླབ་པ་རྣམས་རྗེས་སུ་མི་སྲུང་བ་དེ་དག་གིས་ཅི་འཐོབ་པར་འགྱུར་ཞེ་ན།",
    "སྦྱིན་པའི་ཚོགས་དེ་ཡང་སྦྱིན་པ་པོ་དེ་ཉིད་ཀྱི་རྒྱུད་ལ་དད་པའི་ཆར་པ་བབ་ན་སྦྱིན་པ་པོ་ཉིད་ཀྱི་རྒྱུད་ལ་སོགས་པར་འགྱུར་མོད་ཀྱི།",
    "ཁུ་བ་དེ་ནི་རྒུན་འབྲུ་རེ་རེ་དང་།",
    "བུ་རམ་ཤིང་གི་དུམ་བུ་རེ་རེའི་ནང་དུ་འདུས་པ་ཡང་མ་ཡིན་ནོ།",
    "དྲང་སྲོང་ཆེན་པོ་དེ་བཞིན་དུ་སྦྱིན་པ་བྱིན་པ་དེ་ཡང་སྦྱིན་པ་པོའི་ལག་པའི་རྩེ་མོ་དང་།",
    "དེའི་ནོར་དེ་ཉུང་ངུ་ལས་མང་པོར་གྱུར་པ་དང་སྦྲང་རྩིའི་སྦྲང་མས་མེ་ཏོག་མ་རུང་བར་བྱས་པ་ལྟར་སྦྱིན་བདག་གི་རྣམ་པར་སྨིན་པ་ཡང་ིཆེར་སོགས་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བདག་གི་སྦྱིན་པའི་རྣམ་པར་སྨིན་པ་ནི་བཀའ་སྩལ་ཏོ།",
    "འཕོང་གི་སློབ་དཔོན་དང་།",
    "གླང་པོ་ཆེ་དང་བལ་ིགླང་མོ་ཆང་གིས་ར་རོ་བར་བྱེད་དོ།",
    "ཕ་རོལ་གྱི་དམག་ཚོགས་ཀྱི་དཔུང་ཐུབ་པར་དཀའ་བ་མི་རྟག་པའི་དམག་དཔག་ཏུ་མེད་པ་འོང་གིས།",
    "རྣམ་པར་ཤེས་པ་འདི་ཉིད་ཀྱིས་བདག་གི་ིལུས་འདི་ཡོངས་སུ་བཏང་ངམ་མ་བཏང་ིསྙམ་དུ་ཇི་ལྟར་རབ་ཏུ་འཚལ་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "ལུས་འདིས་བདག་ངན་སོང་དུ་འགྲོ་བའི་རྒྱ་མཚོ་ལས་རྒལ་ཏེ།",
    "གཟིངས་རུལ་པས་ཉོན་མོངས་ཀྱི་སྟེང་དུ་ལོག་པར་སོང་ནས་མཚོ་ཆེན་པོ་ཆུའི་རླབས་ཀྱིས་དཀྲུགས་པ་སྦྲུལ་གྱིས་གློངས་ིཔར་ཞུགས་སོ་ཞེས་གཟིངས་དེ་ལ་དེ་སྐད་སྨྲའོ།",
    "མཆིལ་པས་ཉ་ཟིན་པ་བཞིན་ནོ་སྙམ་མོ།",
    "བདག་གིས་ལས་འདི་བྱས་སོ་ཞེས་དེ་དྲན་ནས་དེ་ལེགས་པར་བྱས་པའི་ལས་ཀྱིས་དགའ་ས་བཞིན་དུ་འགྲོའོ།",
    "སྐྱེད་མོས་ཚལ་དང་།",
    "འདི་ནི་སྐྱེ་བ་ལྔ་བརྒྱར་བདག་གི་མར་གྱུར་ཏོ་ཞེས་དེ་ལྟར་རབ་ཏུ་ཤེས་ཏེ།",
