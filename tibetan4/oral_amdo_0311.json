    "རྒྱུན་གཅོད་རྒྱལ་བའི་ཉོན་མོངས་མེད།",
    "གཞི་ཕུད་པོ་ཁམས་དང་སྐྱེ་མཆེད་ཐམསཅད་གང་ཟག་གི་བདགགིས་སྟོང་པར་ཤེས་པ་འོ།",
    "སོར་མོ་རིང་དང་རྟིང་ཡངས་སྐུ་ཆེ་དྲང་།",
    "སྤུ་གྱེན་དུ་ཕྱོགས་པ་ནི་བ་སྦུ་ཐམས་ཅད་གཡས་སུ་འཁྱིལ་བའི་རྩེ་མོ་གྱིན་དུཕྱོགསཔའོ།",
    "འདི་ཡི་དཔུང་པའི་མགོ་ཟླུམ་ཐལགོང་རྒྱས།",
    "ཤིང་གི་རྒྱལ་པོན་གྲོཏ་ལྟར་ཆུར་དབུའི་སྤྱི་བོ་ནས་ཞབས་མཐིལ་གྱི་བར་དང་།",
    "སྦྱནནི་མཐོན་མཐིང་སྤྱན་རྫི་བ་མཆོག་གི།",
    "ཞེས་པས་སོར་མོ་རྣམས་བྱིན་གྱིས་ཕྲ་བ་ནི་ཕྱག་སོར་རྣམས་ཚིགས་མདུད་མེད་པརརྩབ་ནས་རིམ་གྱིས་ཕྲ་བའོ།",
    "ཡན་ལག་གི་སྐབས་ཕྱེད་པ་དང་།",
    "གཟིགས་པ་སྒྲིབ་མེད་དེ།",
    "དམར་དང་འབྲུག་གི་སྒྲ་ཉིད་དང་།",
    "དེ་ཡང་མིག་གི་སྟེང་ན་སྐྱེ་བའི་སྤུནི་སྨིན་མ་ཡིན་ལ།",
    "ཞེས་པདྨའདབམ་དད་ཟེའུ་འབྲུ་བཅས་ཁཚང་བར་ཡོད་པ་ལྟར་དཀར་ནག་གི་མཚམས་ཕྱེད་ཅིང་མཛེས་པའོ།",
    "དབྱེས་ཆེ་བཞི་དཔྲལ་བའི་ཁྱོན་ཆེ་བ་དང་།",
    "གང་གིས་སྲིད་པ་ཇི་སྲིད་དུ།",
    "དེ་དགགི་བརྗོད་བྱའི་དོན་རྣམས་ནི།",
    "དེ་རྗེས་བོད་ཀྱི་རྒྱལ་པོ་ལྷ་བཟང་ཁང་གི་དུས་སྟོད་མངའ་རིས་སྐོར་གསུམ་གྱི་འགོ་བྱེད་སྒར་དཔོན་ལས་ཐོག་མཛད་སྐབས་ཇུན་གར་ཚེ་རིང་དོན་གྲུབ་ཀྱི་དམག་བོད་དུ་ལྷགས་ནས་ལྷ་བཟང་ཁང་དཀྲོངས།",
    "དབུས་གཙང་ཇུན་གར་པས་བདག་བཟུང་བྱེད་སྐབས་ཀྱང་མངའ་རིས་སུ་རང་ཚོ་ཟིན་ནས་ཇུན་གར་པར་མགོ་མ་གཏད།",
    "ཇའི་སང་སོགས་དྲག་རིགས་ནས་གཞུང་གི་རིན་ཆེན་རྒྱན་ཆས་གཙོས་སྐུ་ཆས་རྩ་ཆེ་འགའ་ཞིག་དང་རྩེའི་འཕགས་པ་ལོ་ཀི་ཤྭ་ར་སོགས་ནང་རྟེན་ཁ་ཤས་འཁྱེར་ཏེ་མངའ་རིས་བརྒྱུད་ཕྱིར་ལོག་བྱེད་སྐབས་སྒར་དཔོན་ཁང་ཆེན་པས་གཡོ་སྐོར་གྱིས་གུར་ནང་དུ་མགྲོན་འབོད་སྟོན་བཤམས་ཐོག་གུར་རྡིབ་བཏང་བར་བརྟེན།",
    "གུར་ནང་དུ་མེད་པའི་གཡོག་རིགས་རེ་གཉིས་བྲོས་ཐར་སྐད།",
