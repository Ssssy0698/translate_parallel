    "ཡིན་ན་ཡང་ད་ལྟ་ཁོར་རང་ལ་ཡིད་ཆེས་ཇེ་ཡོད་དུ་གྱུར་འདུག་ཁོས་ལྟོས་དང་།",
    "པོ་ལེ་ཐིས་གླང་རྒན་ཁྲི་ཕྲག་ཅིག་འདུག་ཅེས་བཤད།",
    "པོ་ལེ་ཐིས་མིག་སྔའི་འདི་མ་བརྗེད་ན་འགྲིག་འདུག་ཅེས་བཤད།",
    "མེ་ཁིས་ཁོ་ཚོར་ངོ་ཚ་རྒྱུ་ཞིག་མི་འདུག་ང་ངོ་མ་དབྱིན་ཇིའི་རྒན་པོ་དེའི་སྟེང་དུ་སུན་ཞེས་བཤད།",
    "དེ་ན་ཁྱེད་རང་མ་རྩ་སྟོངས་བའི་ཁེ་ལས་པ་ཞིག་ཡིན་ནམ་ཞེས་བཤད།",
    "དེ་ལོས་ཡིན།",
    "ཁོ་ཚོས་ང་ངོ་ཤེས་ཀྱིན་འདུག་པེས་ཨར་གྱིས་ད་ང་བསྲན་ནས་འདུག་མི་ཐུབ་ཅེས་བཤད།",
    "མེ་ཁིས་ང་དཔུང་བ་ནས་སྐྱོར་འདུག་ལ་ང་རང་འདུག་སྟེགས་སྟེང་དུ་བསྡད་འདུག་པ་ངས་ཚོར།",
    "ང་དེ་ལྟར་རང་འགར་གཅར་རྡུང་ཁུར་ནས་འདུག་མཁན་ཞིག་མིན།",
    "ང་ཁོ་ཧྥེ་ཁང་དང་བྲལ་ལ་ཁོ་ཚོ་སྔར་བཞིན་ཅོག་ཙེའི་འགྲམ་དུ་བསྡད་འདུག་ངས་ཁ་ཕྱིར་འཁོར་ནས་ཁོ་གཉིས་དང་འདུག་སྟེགས་སྟོང་བ་དག་ལ་བལྟས་པར།",
    "སྔོན་མར་ང་རང་གྲོང་མཐའ་ནས་རྐང་གྲུག་རྩེས་ཚར་ནས་ཕྱིར་རང་ཁྱིམ་ལ་ལོག་པའི་ཚོར་བ་དང་གཅིག་འདྲ་ཡིན།",
    "ངའི་མགོ་ཧ་ཅང་གཟེར་གྱིན་འདུག་སྟེ།",
    "ངའི་ཚོར་བ་ཞིག་ལ་ངས་ཁུག་མ་དེ་བཟུང་འདུག་པ་དང་འདྲ།",
    "ཁང་བའི་སྒོ་བརྒྱབ་འདུག་པས་ངས་སྒོ་རྡུང་།",
    "ང་སྒོ་འགྲམ་དུ་ཡར་ལངས་བར་ཡོད་ཚད་ཐེངས་དེར་ང་རང་རང་ཁྱིམ་དུ་ལོག་པ་དང་འདྲ།",
    "ཁོ་ངུ་སྐད་མེད་པར་མིག་ཆུ་གཏོང་བཞིན་འདུགངའི་སེམས་ངོ་མ་པོ་ལེ་ཐི་དྲན་པ་ན་ང་བཟོད་བསྲན་བྱེད་མི་ཐུབ།",
    "ང་ཡར་ལངས་ནས་འགྲོ་བསམ་པར་ལྷམ་ཕུད་འདུག་པ་ཚོར།",
    "ང་གཉིད་ལས་སད་སྐབས་ངའི་མགོ་གཟེར་གྱིན་འདུག་སྲང་བར་ནས་རོལ་དབྱངས་རི་ཁག་གྲག་པའི་སྒྲ་མཆེད་ཡོང་།",
    "ཞབས་ཞུ་བས་ཁོ་ཧྥེ་ཁང་གད་བདར་བྱེད་ཀྱིན་ཡོད་དེ་ཅོག་ཙེ་ཕྱིས་ཀྱིན་འདུགཞབས་ཞུ་བ་ཞིག་ཚུར་ཡོང་ནས་ང་ལ་ཅི་མཁོ་དྲིས།",
    "ཁོས་རྫ་མ་གཉིས་ཅོག་ཙེའི་སྟེང་དུ་བཞག་ནས་ཅོག་ཙེའི་འགྲམ་གྱི་འདུག་སྟེགས་ཤིག་ཏུ་བསྡད།",
    "ཉི་ཁྱམས་ཀྱི་སྒེའུ་ཁུང་ཕྱེ་འདུག་ལ།",
    "གོ་ཐོས་ལྟར་ན་སྐབས་དེར་གླང་འཛིང་མཁན་དེ་མལ་ཁྲིའི་ཐོག་ཏུ་བསྡད་འདུག་ཟེར།",
    "ཁི་ཨིན་གྱང་ངོས་སུ་རྒྱབ་ཁེན་ནས་བསྡད་འདུག་དེ་འདྲ་ཟེར་ན་ཁྱེད་ཀྱིས་ང་གཅར་མ་བསམ་པ་ཡིན་ནམ།",
    "ད་དུང་ཁི་ཨིན་དེ་རིང་སྔ་དྲོ་འདི་ནས་ཁ་མི་བྲལ་ན་ཁོས་ཅི་བྱས་ཀྱང་ཁོ་རང་གསད་རྒྱུ་ཡིན་ཟེར།",
    "པེས་ཨར་གྱིས་དེ་འགྲིག་འདུག་ཅེས་བཤད།",
    "ཁོས་སྦུ་རག་འཐུང་ཚར་འདུགཁོས་མགོ་ནང་དུ་སྒུར་ནས་ཁྱེད་ཀྱིས་ཤེས་གསལ་ལྟར།",
    "ལག་པ་འདར་གྱིན་འདུག་ང་ཕྱིར་ཁང་མིག་ཏུ་ལོག་རྒྱུ་ཡིན།",
    "ཉིན་གུང་ཟ་མ་ཟ་སྐབས་ཁྱེད་རང་ཚུར་ཡོང་ངམ།",
    "ཁྱེད་ཀྱིས་ངལ་གསོ་ཡག་པོ་ཞིག་བྱས་ན་འགྲིག་འདུག་ད་ང་གཉིད་རྒྱུ་ཡིན།",
    "ཁོས་ངས་རྣམ་པ་གཉིས་ལ་འདུག་སྟེགས་གྲ་སྒྲིག་བྱས་ཡོད་ཅེས་བཤད།",
    "ཁོ་ཚོ་གླུ་ལེན་པ་དང་ཆང་འཐུང་བ་སོགས་བྱས་ནས་ཁང་བའི་ནང་ཧྲིལ་བོ་དུ་བ་ཡིས་ཁེངས་འདུག་འདི་གའི་ཟ་མ་ཞིམ་པོ་འདུག་ཆང་ཡང་ཞིམ་པོ་འདུག་ངེད་གཉིས་ཀྱིས་ཟ་མ་ཟ་བའི་ཐོག་ལ་ཤིགས་བརྒྱབ་ནས་ཁ་བརྡ་མང་པོ་མ་བྱས།",
    "ཡིན་ན་ཡང་ཁོ་རང་ཡང་བསྐྱར་གླང་འཛིང་འགྲན་སྡུར་དུ་ལོག་པའི་སྐབས་སུ།",
    "དེའི་ཁར་ལུས་སྟེང་ལ་བཟོད་དུ་མེད་པའི་ན་ཟུག་ཡོད་པས་ཁོ་རང་གོམ་པ་སྤོ་ནས་འགྲོ་བ་ཡང་དཀའ་སྔལ་ཞིག་ཏུ་གྱུར།",
    "གཟི་བརྗིད་དེ་སྔར་བཞིན་སྔོན་མའི་གཟི་བརྗིད་ཡིན་ན་ཡང་ཁོ་རང་གླང་འཛིང་ལ་དགའ་བའི་སྤྲོ་བ་ཆེས་ཆེར་འཕེལ་དུ་འཇུག་མ་ཐུབ།",
    "ངས་བསམ་ན་ཁོ་རང་གླང་རྒན་དེ་ཚོར་དགའ་བ་དང་པོ་ལེ་ཐི་ལ་ཡང་དགའ།",
    "དེ་ནི་ཁོ་རང་ཉིད་གཅིག་པུའི་ཆེད་མ་ཡིན་པར་པོ་ལེ་ཐིའི་ཆེད་དུའང་ཡིན།",
    "གླང་རྒན་གྱིས་མི་ཕན་པར་བྱེད་མ་ཐུབ་ལ་འུར་འུར་བྱས་ནས་ངུར་གྱིན་འདུག་ལོ་མེ་ལོའི་གདོང་ལ་འཛིམ་གྱིས་ཁེངས་ཡོད།",
    "གྲི་ཐུང་དེ་གླང་རྒན་གྱི་ལུས་སྟེང་དུ་འཛེར་འདུག་སྐད་ཅིག་མ་དེའི་རིང་དུ་མི་དང་གླང་རྒན་ཚང་མ་ཕོང་བོ་གཅིག་ཏུ་གྱུར།",
    "གླང་རྒན་གྱིས་ཁོ་ལ་ཅེར་འདུག་ལོ་མེ་ལོས་གླང་རྒན་ལ་ཕྱོགས་ནས་ཅི་ཞིག་ཟེར་ནས་འབོད་ཀྱིན་ཡོད་ལ།",
    "ང་ཡང་ཐང་ཆད་འདུག་སྟེ།",
    "ངས་ཁྱེད་རང་ནམ་ཕྱིར་འགྲོ་བསམ་པ་ཡིན་ཞེས་དྲིས་པ་ན།",
    "དུས་སྟོན་གྱི་བྱེད་སྒོ་ད་དུང་སྔར་བཞིན་སྤེལ་གྱིན་འདུག་ང་ཅུང་ཙམ་བཟི་ཡོང་།",
    "ད་དུང་སྐྱིད་པོ་མི་འདུག་ད་རུང་དམ་བེ་གང་འཐུང་དགོས་སམ།",
    "ཆང་བཅུད་ཀྱིས་ང་ལ་ནུས་པ་ཐོན་གྱིན་མི་འདུག་དེ་དཔེ་མི་སྲིད།",
    "ངས་ད་འཐུང་ཐུབ་ཀྱིན་མི་འདུག་ཅེས་ལན་བཏབ་པ་ཡིན།",
    "བྱེད་སྒོ་སྤེལ་ཚར་རྗེས་ཀྱི་སྲང་ལམ་ཀད་བརྡར་བྱེད་ཀྱིན་འདུགང་ལྕུག་ཕྲན་གྱིས་བཟོས་པའི་འདུག་སྟེགས་ཤིག་ཏུ་རྒྱབ་བརྙེས་ལ་ཁེན་ནས་སྐྱིད་པོ་བྱས་ནས་བསྡད།",
    "ཁྱེད་རང་ནམ་ཕྱིར་འགྲོ་རྒྱུ་ཡིན་ཞེས་ཁོ་ལ་དྲིས་པ་ན།",
    "ངས་སྤྲོད་ཐུབ་ཀྱིན་མི་འདུག་ཅེས་བཤད།",
    "ཁྱེད་རང་ངོ་མ་བཟང་།",
    "ཁྱེད་རང་གང་དུ་འགྲོ་འདོད་ཞེས་དྲིས།",
    "པེས་ཨར་གྱིས་ལག་གདུཔ་ཆུ་ཚོད་ལ་བལྟས་པ་ན་ཕྱིར་ལོག་རན་འདུག་ཁོས་རླངས་འཁོར་གྱི་སྒེའུ་ཁུང་རྡུང་ནས་ཁ་ལོ་བ་ལ་ཕྱིར་འགྲོ་བའི་བརྡ་བསྟན།",
    "ངས་ཁོ་རང་མེ་འཁོར་ས་ཚུགས་ཀྱི་སྒོ་ཁར་སྐྱེལ།",
    "ཁོས་ང་རང་ཡང་བསྐྱར་དེ་རུ་ཡོང་བར་དགའ་བསུ་བྱེད་སྲིད།",
    "མི་དེ་ཚོ་ཁ་བརྡའི་གཏིང་དུ་ལྷུང་འདུག་ཡིན་ན་ཡང་།",
    "ཡིན་ན་ཡང་ངས་ཁོ་རང་འདི་ལྟར་སྡུག་གཏོད་པའི་དཔེ་ཡོད་དམ།",
    "ལྷམ་ཕྱི་མཁན་འགའ་སྡོང་བོའི་རྩ་རུ་བསྡད་ནས་དཔུང་བ་གཅིག་མེད་པའི་དམག་མི་ཞིག་དང་ཁ་བརྡ་བྱེད་ཀྱིན་འདུག་མཚོ་རླབས་འཕྱུར་ཡོང་ལ།",
    "ཡིན་ན་ཡང་རྩ་འཁུམ་པར་སྐྲག་ནས་སེམས་ཁུར་འདུགང་ཉི་འོད་འོག་ཏུ་བསྡད་ནས་མཚོ་ནང་དུ་ཆུ་རྐྱལ་བྱེད་བཞིན་པའི་མི་རྣམས་ལ་བལྟས་པར།",
    "འགའ་ཤས་བླངས་ནས་འདུག་སྟེགས་སུ་བསྡད་དེ་ཉི་མར་ལྡེ་བཞིན་བལྟས།",
    "ང་དེ་ན་བསྡད་འདུག་པའི་སྐབས་སུ།",
    "ངོ་མ་ཁྱེད་རང་ཡིན་ནམ་ཞེས་དྲིས་བྱུང་།",
    "ངས་པོ་ལེ་ཐི་མལ་ཁྲིའི་ཐོག་ཏུ་ཉལ་འདུག་པ་མཐོང་།",
    "ངས་ཁོ་རང་འགྲོ་རུ་བཅུག་པ་ཡིན།",
    "དེ་ན་ཁྱེད་ཀྱིས་ཁོ་རང་ཅིའི་ཕྱིར་མི་གཏོང་བ་ཡིན།",
    "ཁོ་མི་སུ་ཞིག་ཡིན་ཡང་ལྷན་དུ་འདུག་ཐབས་མེད།",
    "ལོས་ཡིན།",
    "ཡུན་གྱིས་ཁོ་རང་གོམས་སྲིད།",
    "ད་ངའི་སྣང་བ་སྐྱིད་པོ་འདུག་ཉི་མ་སྔར་བཞིན་འཆར་ངེས།",
    "ཁོ་ལ་དུས་ཚོད་མང་པོ་འདུག་ངས་ཧ་གོ་མི་འདུག་ཁོའི་མིག་ནང་དུ་ང་ལས་གཞན་པ་མེད།",
    "ཧ་ཅང་ཞིམ་པོ་འདུག་ཁྱེད་ཀྱིས་མངར་ཟས་ཤིག་ལེན་དགོས་སམ།",
    "ཁྱེད་རང་བཟི་དགོས་དོན་མེད་ཅེས་བཤད།",
    "གཡོག་པོ་དེའི་ཁོག་སྟོད་རླངས་འཁོར་གྱི་སྒེའུ་ཁུང་ལས་བིད་ནས་བལྟས་འདུག་ངས་ཁོ་ལ་རྔན་པ་བྱིན་པ་དང་ཁ་ལོ་བ་ལ་གང་དུ་འགྲོ་བ་བཤད།",
    "མཐར་རྡོ་རྗེ་སེམས་དཔའ་དང་རང་ཉིད་དབྱེར་མེད་དུ་བསམ།",
    "ཞུ་བ་གླུས་བསྐུལ་བ་སོགས་ཁྱེད་རང་ཡང་མི་འདོད་པའི་ཕྱིར་རོ།",
    "ཡིད་ཡུལ་དུ་ངས་གོ་ནས་འདུག་སྙམ་པ་ཙམ་གྱིས་མི་ཕན་ཏེ།",
    "ཞི་རྒྱས་ལ་སོགས་པའི་གནས་སྐབས་ཀྱི་འཕྲིན་ལས་གང་ཡིན་པ་བསྒྲུབ་ནས་སྔགས་ཕྲེང་རང་ཉིད་ལ་ཐིམ་པར་བསམ་ཞིང་བཟླས་སོ།",
    "གཞན་ཡང་མ་ཕྱི་ནང་མི་གསལ་བ་དང་དོགས་ཅན་ཁ་ཤས་སྣང་ཡང་རང་སར་བཞག་པ་ལས་ཕྲི་བསྣན་རྔོ་མི་ཐོགས།",
    "སྐབས་ཤིག་ཨོ་རྒྱན་གྱི་ཕྲ་མེན་མ་ལྔ་བརྒྱས་བར་ཆད་བརྩམ་པར་འདོད་ནས་བཙལ་བས་སློབ་དཔོན་གྱི་ཤུལ་དུ་ལྭ་བ་གཅིག་ལས་གཞན་མི་འདུག་པས།",
    "བཙད་པོས་བློན་པོ་རྣམས་ལ་ཨཱ་ཙཪྱ་དེ་ཇི་ལྟར་འདུག་ལྟོས་ལ་ཤོག་བཟང་པོ་ཞིག་འདུག་ན་འདིར་ཡང་སྤྱན་འདྲེན་ནོ་གསུངས།",
    "ནམ་ཞིག་རྨ་ཆུ་ཁའི་ཕྱུགས་རྫིས་སྨར་གཡོ་གཙང་གསུམ་དན་ཏིག་ན་བཞུགས་པ་མཐོང་ནས་འདི་ལྟར་འདུག་ཅེས་མི་རྣམས་ལ་སྨྲས་པ་ཐོབ་ནས།",
    "དེ་དང་མི་ལྡན་པའི་སྔགས་སུ་ཁས་བླངས་ནས་སྦྱོར་སྒྲོལ་སོགས་བག་མེད་བྱེད་པ་བཀག་འདུག་འདི་ལན་བཏབ་པའི་གནས་མིན་གདམས་པ་ཡིན།",
    "བལ་པོ་ན་རྒྱ་དཔེ་མང་དུ་འདུག་པ་ལ།",
    "ད་དུང་འགྱུར་མང་དུ་བྱ་རྒྱུ་འདུག་པ་ལ་གསུངས་ཤིང་།",
    "རྙིང་མར་ཁ་ཟེར་བའི་ཐོག་མ་ཡིན་པར་འདུག་ལོ་ཆེན་རིན་བཟང་དང་།",
    "ཡེ་གྲགས་ཡེ་ཤེས་འོད་སོགས་ཀྱིས་སྔགས་འཆལ་ཆེས་བཀག་པའི་བདེན་གསུང་རང་གཞན་སུས་ཀྱང་དེ་ལྟར་ཤེས་དགོས་པ་ཞིག་འདུག་གོ།",
    "མཁས་གྲུབ་ཆེན་པོ་སོག་བཟློག་པས་ཀྱང་ལན་ལེགས་པར་གདབ་པས་ཆོག་པར་གདའ།",
    "ཕྱིས་ཀྱི་ལོ་ཙཱ་མཁས་པས་རྒྱ་དཔེ་བོད་དཔེ་ཀུན་ནས་བརྟག་དུས་ལྷག་པར་ཡིད་ཆེས་སྐྱེ་ཡིས་བཅོས་དགོས་མི་སྣང་བ་ཤ་སྟག་ཡིན་ཏེ།",
    "འཕགས་པ་ཡབ་སྲས་ཀྱི་ལུགས་དང་མི་མཐུན་པའི་འགྱུར་ཉེས་ཡོད་པ་ལྟ་བུར་བསྟན་འདུག་ཀྱང་།",
    "རང་རང་སྐད་གཞན་རྣམས་ཀྱིས་སྲིད་གསུམ་མ་ཚང་མེད་པ་ལམ་ལ་ཡང་དག་འགོད་བྱེད་པ།",
    "རྙིང་མའི་སྔགས་ཕལ་ཆེར་བོད་སྐད་ཡིན་པས་འདི་ལ་ཐེ་ཚོམ་ཟ་འདུག་ཀྱང་།",
    "ཕྱིས་སུ་སུས་ཀྱང་བསྒྱུར་པ་འདུག་གམ།",
    "དེ་དག་དུས་ཀྱི་འཁོར་ལོ་ན་མ་སྦས་ཀྱང་།",
    "མཐར་གཙང་རྒྱ་མ་ཉེ་དུ་ཁའི་ཕུང་པོ་རི་བོ་ཆེ་ལ་ད་ལྟ་འདུག་འཕྲོར་རི་ཟུར་ནས་ཡར་སྐུ་ལུས་སྤྲིན་ཆད་པ་བཞིན་ལྷག་མེད་དུ་གཤེགས།",
    "སྐྱེངས་པའི་རྣམ་རྟོག་ཅིག་ཤར་ཙ་ན།",
    "བྲག་ཕུག་ཅིག་ཏུ་བྱོན་ཙ་ན་ཁང་སྟོང་དེ་འགྱེལ།",
    "ཀརྨའི་ཡང་དགོན་དབེན་པར་འདུག་པའི་ཚེ།",
    "གཏེར་མང་དུ་འདུག་པ་ལས་སྒྲུབ་ཐབས་ཟབ་པ་འགའ་ཞིག་བཞེས།",
    "བེ་རོ་ཙ་ནའི་མན་ངག་རྣམས།",
    "སློབ་དཔོན་རྣམས་ལས་ཀྱང་ང་རང་མཁས་སོ་སྙམ་པའི་རྟོག་པ་ལན་གསུམ་སྐྱེས་པས།",
    "འདི་སྤྲུལ་པའི་སྐུར་འདུག་པས་མཚན་སྤོ་མི་དགོས་གསུངས།",
    "སླར་སངས་ཙ་ན་སློབ་དཔོན་དགོངས་པ་གློད་ནས་ཞལ་འཛུམ་མེར་འདུག་ད་བཞེངས་རྒྱུའི་ལྷ་ཞལ་གསུམ་ཕྱག་དྲུག་གཅིག་བསྟན་པར་ཞུས་པས།",
    "ཁོང་རྣམས་དེ་ལྟར་བྱེད་རིང་ནང་ན་འཕྲོས་དིར་དིར་འདུག་ཁྲུས་དང་སྐོར་བ་ཟིན་ནས་ནང་དུ་ཕྱིན་ཙ་ན།",
    "དཔལ་ཆེན་པོའི་ལྟེ་བ་ཡན་ཆོད་རང་བྱོན་དུ་ཤར་འདུག་པས་བུ་སློབ་དང་བཟོ་བོ་ཀུན་ངོ་མཚར་དཔག་ཏུ་མེད་པ་སྐྱེས།",
    "ཟུར་ཆུང་པ་རིས་མེད་མཉམ་པ་ཆེན་པོའི་གནས་ལ་བྱོན་པས་ལྟ་བ་མཐོ་བ་མཚོན་ཕྱིར་ཤིང་རྟ་གང་ཙམ་འཕགས་ནས་གདའ་སྐད།",
    "དེར་ཉི་མ་ཤར་བ་དང་སྐུ་མདུན་དུ་ཕྱིན་པས་གཟིམས་མལ་ན་སྐུ་ཚགས་མཛད་ཅིང་འདུག་གར་གཤེགས་ཞུས་པས།",
    "ད་ནི་འགྲོ་དོན་བྱས་ཀྱང་འགྲུབ་པར་འདུག་དགོངས་པའི་ཚེ།",
    "ཁོའི་དྲུང་དུ་ཕྱིན་ཙ་ན་བཅོམ་ལྡན་འདས་དཔལ་ཆེན་པོ་ཨམ་དེ་འདི་ཀ་ཡིན་པར་འདུག་སྙམ་པ་ལས་མི་ཡིན་པའི་འདུ་ཤེས་མ་སྐྱེས་གསུངས་སྐད།",
    "སྒྲོ་ཕུག་པས་དམ་པར་མངོན་ཤེས་ཨེ་འདུག་ཉམས་སད་དུ།",
    "ཁོང་རང་ཕྱིན་ཞབས་འབྲིང་ལྟར་བྱས་པས།",
    "གཞུང་འདི་ཙམ་ཤེས་ཀྱང་ཉམས་སུ་ལེན་རྒྱུ་ཞིག་མི་འདུག་ད་ལྟ་ཤི་ན་ཇི་ལྟར་བྱ་དགོངས་ནས་སླར་ལོག་སྟེ་གདམས་ངག་ཞུས་པས།",
    "ཁོང་རང་དགུང་གྲངས་ཉེར་དྲུག་ནས་བརྩམས་སྐབས་གསེང་ཕྲན་བུ་མ་གཏོགས་སྒྲུབ་པ་ཉམས་ལེན་ཁོ་ན་གཙོ་བོར་བཏོན་པས།",
    "དེ་ནས་རོག་ཐམས་ཅད་མཁྱེན་པ་སོགས་རིམ་གྱིས་བརྒྱུད་དེ་སྔར་དར་རྒྱས་སུ་བཞུགས་པར་འདུག་ཀྱང་དེང་སང་མཚན་ཙམ་དུ་གྱུར་ཅིང་།",
    "དེ་ལས་སད་ཙ་ན།",
    "རྫོགས་པ་ཆེན་པོ་ཨ་ཏི་ཡོ་གའི་སྐོར་རྣམས་བེ་རོ་ཙ་ནས་སློབ་དཔོན་ཤྲཱི་སེང་ཧ་ལས་གསན་པ་དང་།",
    "གཉིས་པ་ལོ་ཆེན་བེ་རོ་ཙ་ནས་རྒྱ་གར་གྱི་མཁས་པ་ཉེར་ལྔ་སོགས་བསྟེན་ཅིང་།",
    "ཀུན་ཀྱང་རང་རང་སོ་སོའི་ལས་ལ་འཇུག།",
    "ཕལ་ལ་མི་འཚམ་རང་རང་ལས་ཀྱིས་བསྐལ།",
    "སྒྲུབ་བརྒྱུད་འདྲེན་པའི་ཤིང་རྟ་ཆེན་པོ་བརྒྱད་རྗེས་འབྲང་དང་བཅས་པ་རང་རང་སོ་སོའི་ལྟ་གྲུབ་ཀྱི་ཁས་ལེན།",
    "དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "རང་རང་སྐད་ཀྱི་ཁྱད་པར་རྣམས་ཀྱིས་ནི།",
    "རང་རང་སྐད་གཞན་རྣམས་ཀྱིས་སྲིད་གསུམ་མ་ཚང་མེད་པ་ལམ་ལ་ཡང་དག་འགོད་བྱེད་པ།",
    "ཙོག་པུར་འདུག་དང་གཅིག་པུར་རྒྱུ་བ་དང་།",
    "འགྲོ་དང་འགྲེང་དང་ཉལ་དང་འདུག་པ་དང་།",
    "གར་ལ་བལྟ་བའི་ཁྲོད་དུ་འདུག་པ་ཞིག།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "ཐ་ན་ཁྱིམ་པ་སོགས་གང་ཡང་མི་ཤེས་ཤིང་བསྟན་པའི་གཉེར་མེད་པ་རྣམས་ཀྱང་རང་རང་སོ་སོའི་ཕྱོགས་བཟུང་ནས།",
    "ཡིད་བཞིན་གྱི་ནོར་བུ་ལྟ་བུའི་ཟབ་དོན་ཐང་མར་བརྡལ་ཏེ་རང་རང་གང་འདོད་དུ་སྤྱོད་ཆོག་པར་མཛད་པ་འདི་ལྟ་བུའི་བཀའ་དྲིན་གྱི་ཁྱད་པར་ནི།",
    "རང་རང་འཇུག་ལྡོག་བྱ་བར་བརྩོན་པ་བཞིན།",
    "རྒྱབ་ཏུ་སྒྲོལ་མའི་འདག་སྐུ་གསེར་གྱིས་བྱུགས་པ་ཞིག་འདུག་པ་བླངས་ཏེ",
    "རྒྱབ་ནས་བལྟས་ན་དམར་པོ་རིས་སུ་དོད་པ་སྤུས་བྲིས་པ་ཙམ་འདུག་པ་ལ",
    "དེའི་ནང་དུ་རྩྭའི་པ་ཊ་བྱས་པའི་གོང་བུ་ཕོར་པ་ཙམ་གྱི་ནང་དུ་ཤོག་དྲིལ་ཆེན་པོ་ཞིག་འདུག་པ་བླངས་ཏེ་གཏེར་ཚབས་བཅུག་ནས་སྒོ་སྔར་བཞིན་བསྡམས་ཏེ་བཞག",
    "གླ་བ་ཞིག་རྙིས་ཟིན་འདུག་པ་དེ་ཪྙི་ཐག་གྲིས་བཅད་ནས་བཀྲོལ།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི",
    "སོ་སོ་རང་རང་གནས་སུ་འགྲོ་བར་གྱིས",
    "ཀུན་ཀྱང་རང་རང་རིགས་ཀྱི་དབྱངས་ཅནཡུམ",
    "ཁ་དོག་རང་རང་རིགས་ཀྱི་ཡབ་དང་མཚུངས",
    "དེ་དག་རྣམས་ཀྱང་རང་རང་སྤྲུལ་པའི་གཞི",
    "མ་ལུས་འདུས་ཤིང་རང་དམ་གཉེར་བླངས་པ",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི་དེ་ལྟར་བསྙེན་པའི་དུས་སུ་རང་ཉིད་འཇམ་དཔལ་དམར་སེར་དུ་གསལ་བའི་ཐུགས་ཀར་པདྨ་དང་ཟླ་བ་རྒྱས་པའི་ལྟེ་བར་གསེར་གྱི་རལ་གྲི་སོར་བཞི་པའི་ཡུ་བ་གདན་ལ་བརྟེན་ཅིང་རྩེ་ལ་ཡེ་ཤེས་ཀྱི་ཛ།",
    "རང་བྱུང་རང་ཤར་ཆེན་པོར་བསྒོམ",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི་དེ་ལྟར་སྤྲོ་བསྡུ་ལ་ནན་དུ་འབད་པར་བྱའོ",
    "ཨཾ་ཨ་ར་པ་ཙ་ན་སླར་ཡང་བསྒྲུབ་པ་བྱ་བ་ལ",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི་ཨ་ར་པ་ཙ་མི་དྷཱི་དྷཱི་ད་ཡེ་སྭཱ་ཧཱ",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི་ཨོཾ་ཝ་ཀྱི་དཾ་ན་མ་ཞེས་བརྗོད་ཅིང་ཉིན་གུང་རྒྱས་པའི་ཕྲིན་ལས་བསྒྲུབ་པ་ལ",
    "ཨོྃ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི་ཨོཾ་ཝཱ་གཱི་ཤྭ་རི་མུཾ",
    "ཨཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི་ཨོཾ་དྷཱི་དྷཱི་མ་མི་དྷཱི་བཾ་མཉྫུ་ཤྲི་ཧཱུྃ་ཧྲཱི་པྲཛྙཱ་ཝནྡྷ་ན་ཧྲཱི་དྷཱི་སྭཱ་ཧཱ",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི་ཨོཾ་པྲ་སོད",
    "གནས་གྱུར་གཤིན་རྗེ་ཡ་མ་ར་ཙ་ནི",
    "གཞན་ལ་རྩོད་པ་བྱེད་པའི་དུས་སུ་རང་ཉིད་འཇམ་དཔལ་ནག་པོ་གཡས་པས་རལ་གྲི་མེ་འབར་བ་ཀླད་ལ་བསྐོར་བས་ཕ་རོལ་པོའི་ལྷ་སྲུང་དགྲ་བླ་ཐམས་ཅད་ཀྱི་ནུས་པ་བཅོམ་སྟེ་དཔའ་བཀོང་ནས་རྒོལ་བ་པོ་ཁོ་རང་ལ་རྩོད་པས་རྒོལ་བ་དང་",
    "རང་བྱུང་རང་ཤར་ཆེན་པོར་བསྒོམ",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཞེས་བར་མ་ཆད་པར་ཆུ་བོའི་རྒྱུན་གཞུང་ལྟར་བཟླའོ",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི་པྲཛྙཱ་ཛྙཱ་ན་པུཎྱེ་སརྦ་སིདྡྷི་ཕ་ལ་ཧཱུྃ་ཨ",
    "ༀཨ་ར་པ་ཙ་ན་དྷཱི་ཧྲཱི་ཨོཾ་ཝ་ཀྱེ་དཾ་ན་མ་ཨོཾ་ཝཱ་གཱི་ཤྭ་རི་མུཾཨོཾ་ཧྲཱི་དྷཱི་མ་མེ་དྷཱི་བཾ་མཉྫུ་ཤྲཱི་མཱཾ་ཧྲཱི་པྲཛྙཱ་ཝརྞྞ་ནི་ཧྲཱི་དྷཱི་སྭཱ་ཧཱ",
    "རང་རང་བདེ་བར་འདུག་པའི་དུས་འདི་རུ",
    "བསྲུང་བའི་གུར་ཁང་རང་བཞིན་ལྷུན་གྱིས་གྲུབ",
    "ཧཱུྃ་ཧྲཱི་ཡེ་ནས་མ་བཅོས་རང་བྱུང་རང་རྩལ་ལྷར",
    "རང་བྱུང་རང་མདངས་སྟོང་པའི་མཁའ་དབྱིངས་ལས",
    "རྩལ་སྣང་རང་གྲོལ་རྒྱལ་བའི་དཀྱིལ་འཁོར་ལྷ",
    "རང་རང་དགྱེས་པའི་གདན་ལ་བཞུགས་སུ་གསོལ",
    "རང་རང་ཡུལ་དུ་གཤེགས་ནས་ཀྱང་",
    "རང་བྱུང་རང་ཤར་དཀྱིལ་འཁོར་དུ",
    "ཛ་ཛ་དེ་འོག་དུས་ཚིགས་ཕྱི་མ་ལ",
    "གཞི་སྣང་རང་བྱུང་བདེ་ཆེན་ཞིང་",
    "བེ་རོ་ཙ་ནའི་ཞབས་ལ་གསོལ་བ་འདེབས",
    "ཀུན་ཀྱང་རང་རང་རིགས་ཀྱི་ཡུམ་དང་འཁྲིལ",
    "དེ་འོག་དུས་ཚིགས་གསུམ་པར་བབ་པའི་ཚེ",
    "དེ་འོག་དུས་ཚིགས་བཞི་པའི་ཐ་མ་ལ",
    "རང་བྱས་ལས་ཀྱི་མཐའ་ལ་ཐུག་དུས་མེད",
    "རང་རང་ཡིད་མཐུན་ཟས་ཀྱི་རིགས",
    "ཅིའི་ཕྱིར་རྒྱུ་དང་རང་བཞིན་ལ་རྟོག་ཅེ་ན།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་ཆགས་པ་ཆུང་བ་ནི་ཉེས་པ་རྣམས་ཆ་མཉམ་ནའང་ཤིན་ཏུ་ཆགས་པ་ཅན་མིན་པའི་ཕྱིར་དང་།",
    "བཅས་པ་དང་རང་བཞིན་རྒྱུ་འབྲས་སུ་གཅིག་པ་དང་།",
    "དེ་ལ་བརྙས་པ་དང་རང་བཞིན་རྒྱུ་འབྲས་སུ་གཅིག་པ་ཟེར་བ་ཡིན་ནོ།",
    "མྱ་ངན་མི་སྐྱེ་ཟེར་གྱིན་འདུག་པས་དེ་ལས་ཟབ་བ་མི་འདུག།",
    "ཡིད་ཀྱི་འཕྲུལ་འཁོར་རྣམ་པ་གསུམ་ལ་རྟོན་ནས་ཉམས་སུ་བླངས་ན་མྱུར་དུ་སྐྱེ་བ་ལ་ཚེགས་མི་འདུག།",
    "སྲབ་པའི་བྲག་དེ་གནས་བྱིན་བརླབས་ཅན་ཅིག་འདུག།",
    "ཁྱེད་ལ་དེ་སྐད་ཟེར་མཁན་སུ་ཡང་མི་འདུག།",
    "ལྔས་ན་ཀ་པ་ལི་བདུད་རྩིས་བཀང་ནས་འདུག་པ་དེ་གསོལ་ནས་བཞུགས།",
    "རྩ་མི་གཉིས་ཀས་ལྟར་བྱོན་པས་གྲུབ་པ་ཐོབ་ནས་འདུག་པས།",
    "དེ་ནས་རྣམ་པར་རྟོག་པའི་གེགས་ལ་འདུག་པས།",
    "སྐུ་ཁམས་ཨེན་ཅིག་འཕར་ནས་འདུག་པ་ཏེ་གནས་དུས་སུ།",
    "འདུག་མ་ཟེར།",
    "དེའི་དུས་སུ་དམིགས་པས་མི་ཕན་པར་འདུག་སྙམ་ནས་འཇོག་ཉེན་ཡོད་དེ།",
    "ཟེར་ནས་ཁོ་དགའ་འདུག་པས།",
    "དེ་བཞིན་གཤེགས་པའི་བཀའི་བསྡུ་བ་བྱེད་དགོས་པར་འདུག་སྙམ་ནས་བྱོན་པས།",
    "བ་དམར་གླང་དམར་གྱི་ཀོ་བ་གྱོན་ནས་འདུག་པ་མཐོང་བས།",
    "འཁོར་འདས་ཀྱི་གཟུང་འཛིན་ཐམས་ཅད་སྟོང་པར་འདུག་པས།",
    "ཇ་སིག་མགོ་ཆག་ཙམ་གཅིག་ལ་ཇ་གདུམ་དུ་ཚི་བཏགས་ནས་འདུག་པ་ལ།",
    "མཁའ་འགྲོ་མའི་རྒྱ་འགྲེལ་འདི་གནང་པ་ལགས་པར་གདའ།",
    "ཕྱག་བྲོམ་གསོལ་བའམ་འཐེན་པའི་དུས་སུ་དང་པོ་ཞབས་གཡས་པ་ནས་རྩམ་པར་འདུག།",
    "འབྲུ་གུ་ཐམས་ཅད་སིབ་ཀྱིས་ཕྱིར་ཐོན་ནས་སོ་ང་ཙ་ན་ཕན་པ་ཡིན་པས།",
    "ཅིག་ཡོད་པ་ཡིན་ཏེ་ཟེར་ནས་འགྲོངས་པ་ལགས་པར་གདའ།",
    "དངོས་གཞི་ལུས་ཡི་དམ་གྱི་སྟོང་རང་སྒོམ་ནས།",
    "འདིས་ཀྱང་བདེ་བ་བསྐྱེད་པར་འདུག་སྟེ།",
    "ལུས་བསམ་གཏན་གྱིས་ཡན་ལག་ལྔས་འདུག་གོ།",
    "སློབ་དཔོན་ཆེན་པོ་ཏེ་ལོ་བ་དེ་ན་རོ་བ་ལ་བཞེངས་པར་གདའ་སྐད།",
    "ཐང་དེ་ལ་ཟད་པའི་དུས་མ་བྱུང་བ་ལགས་པར་གདའ།",
    "བགྱི་བ་ཚིག་གཉིས་པོ་འདི་ཡིན་བ་ལགས་པར་གདའ།",
    "བདུད་རྩི་ལྔ་བོ་འདི་དག་ཀྱང་རང་བཞིན་གྱིས་ཡོངས་སུ་དག་པ་ཡིན་པས།",
    "འསྐོམས་པ་མེད་ཀྱང་ཏྲི་ཞིག་ལྟར་ལ་ཤེས་པ་ཁ་ནང་དུ་ལོག་སྟེ་སེམས་ལྷན་ཅིག་སྐྱེས་པའི་དོན་རྟོགས་ནས་རྟོགས་པ་འཆར་འ་ཡང་ཡོད་པར་འདུག་གསུང་།",
    "དེ་ལྟར་གཞག་པས་སེམས་རྣམ་པར་མི་རྟོག་པ་དེའི་ངང་དུ་གནས་ཀྱིན་འདུག་ན།",
    "དེ་ལ་དགོས་པ་ཁྱད་པར་ཅན་ཞིག་ཡོད་པར་འདུག་གསུང་།",
    "བདེ་སེང་ངེ་འདུག་པ་ནི་བདེ་བ་ཡིན།",
    "ད་འདི་ལས་བྱུང་འདུག་སྙམ་པ་ཤེས་པ་དེ་ཉམས་པ་ཡིན་ཞིང་དས་པོ་བསམ་པ་གསུམ་ལས།",
    "སྟན་ལ་འདུག་ཀྱང་རུང་འགྲོ་ཡང་རུང་སྟེ།",
    "འགྲ་ཡར་རུང་སྟན་ལ་འདུག་ཀྱང་རུང་སྟེ།",
    "ལྷ་དང་རང་སེམས་དབྱེར་མེད་པས།",
    "འདི་སྐབས་སུ་བོགས་འདོན་གནང་བར་གདའ།",
    "དེས་སྐྱེ་ཞིང་དུབ་ན་ཚར་གཅད་པ་དང་རྗེས་སུ་བཟུང་བ་དང་རང་སེར་བཞག་བ་དང་གསུམ་བྱས།",
    "འགྲོ་འདུག་ལ་སོགས་པའི་སྤྱོད་ལམ་ཐམས་ཅད་ཀྱང་གོ་ཡེ་དུས་ཏེ།",
    "འདོད་ཆགས་གཞི་མེད་རྩ་བྲལ་དུ་ཤར་ཙ་ན་དེད་འདོད་ཆགས་མ་སྤངས་པར་རང་སར་དག།",
    "གཉིས་ཞེནབར་དུ་ལྷུང་ཉེན་གདའོ་། ཞེས་གསུངས་པས།",
    "ལས་མྱྀ་སྐྱོང་བར་འདུག་གསུང་སྐད།",
    "ཅིག་ཡོད་པ་ཡིན་ཏེ་གསུང་ནས་གྲངས་པ་ལགས་པར་གདའ།",
    "གཉིད་ལོག་དུས་སུ་མཁའ་ལ་རྒྱུ་བའི་ཡི་དྭགས་ལ་སོགས་པའི་གནོད་པ་མི་འབྱུང་།",
    "དེ་ནས་ཐུབ་པ་དེས་འདི་ལྟར་བསམས་ཤིང་འདུག་སྟེ།",
    "དེ་བས་ན་ཁྱེད་གཅིག་པུ་འདུག་པར་འོས་སོ་ཞེས་ཟེར་རོ།",
    "དེས་ཀྱང་གཟུགས་ལྡན་མ་ལ་མཚོན་ཆ་གཏད་ཅིང་འདུག་གོ།",
    "རབ་ཏུ་བརྒྱད་བར་བྱས་པའི་ཆུ་འཛིན་པའི་ཚོགས་ཀྱིས་ཤིན་ཏུ་སྔོ་བའི་བར་སྣང་ལ་འདུག་སྟེ།",
    "འཆི་བ་དང་ཡང་འབྲེལ་པའི་གཏམ་གྱིས་ནང་མིའི་ཚོགས་དང་བཅས་པའི་ཡབ་ཀྱི་ཡིད་སྐྱོ་བ་བསྐྱེད་ཅིང་འདུག་གོ།",
    "ཆང་ནི་བླུགས་ཤིང་འདུག་པ་ཉིད་དུ་གནས་པར་གྱུར།",
    "མལ་དེ་ལ་འབྲེལ་ནས་ཆང་དེ་མྱང་ཞིང་འདུག་པར་གྱུར་ཏོ།",
    "རི་དགས་ཀྱི་ཚོགས་གཉིས་དེ་དབུགས་འབྱིན་ཞིང་གནས་པ་དམག་ཚོགས་ཀྱིས་ཀུན་ནས་བསྐོར་ཞིང་འདུག་གོ།",
    "སྐྱེས་མ་ཐག་ཙམ་འདུག་པ་ནི།",
    "རི་ཤིང་རྣམས་ཀྱང་དེ་ལས་ཟློག་པར་བྱེད་ལྟར་འདུག།",
    "དེ་ནས་རྒྱལ་པོ་དེ་ཡིད་རབ་ཏུ་དགའ་བས་ཚོགས་ཀྱི་བདག་པོ་དེ་སེང་གེའི་ཁྲི་ལ་འདུག་ཏུ་བཅུག་ནས་གུས་པ་དང་བཅས་པས་དམའ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "དེ་རྣམས་ཀྱང་འཆི་བ་ལ་འཇིགས་པས་དེ་ལྟར་བགྱི་ཞེས་ཁས་བླངས་ནས་ཤིན་ཏུ་མཁས་པའི་བྱ་བ་སུ་ཞིག་ལ་དོན་དུ་གཉེར་བར་བྱས་ཏེ་གཏོང་ཞིང་འདུག་གོ།",
    "གྲོགས་པོ་སུ་ཞིག་ལ་གཏམ་དེ་དབེན་པའི་སར་སྨྲ་ཞིང་འདུག་གོ།",
    "འདུག་ཅིང་ལངས་དང་འགྲོ་བའི་རི་དགས་འགའ་ཞིག་ཏུ།",
    "འདུག་ཅིང་སོ་སོར་བརྐྱང་བར་གྱིས།",
    "ཅུང་ཟད་གང་ནས་ཀྱང་མྱང་ཞིང་བདག་ཉིད་ཆོག་ཤེས་པ་ལ་ཞུགས་ཤིང་འདུག་གོ།",
    "དེ་བཞིན་སྐྱེ་བོ་འདིས་ཡང་རང་ཉིད་བྱས་པའི་ལས།",
    "དབུགས་འབྱུང་ཞིང་འདུག་པའི་རི་དགས་ཀྱི་ཚོགས་དང་ལྡན་པ་དང་།",
    "རིང་པོ་ནས་དོར་བའི་དམག་ཚོགས་ལ་སྡོད་ཅིང་འདུག་གོ།",
    "གླང་པོའི་ཕྲུ་གུ་འདུག་པའི་ཚོང་པའི་ཚོགས་ནི་མཐོང་བར་གྱུར།",
    "ལྷ་ལགས་བདག་ཅག་ནི་བྱང་ཕྱོགས་ནས་འོངས་ཞེས་བྱ་བ་སྨྲ་ཞིང་འདུག་གོ།",
    "དེ་ནས་བྱང་ཕྱོགས་ཀྱི་གཏམ་སྐབས་སུ་བབ་པ་ལ་ཚོང་པ་རྣམས་ཀྱི་བདག་པོ་དེ་རྡོ་རྗེ་དབྱུག་པ་ཅན་ཞེས་བྱའི་རྒྱལ་པོ་ལ་ཆེ་བའི་བདག་ཉིད་བརྗོད་ཅིང་འདུག་གོ།",
    "མཆེ་བ་གཉིས་པའི་དཔུང་པར་གླང་པོ་སྐྱོང་བ་འདུག་པ་ལ།",
    "ཡུད་ཙམ་ཡུད་ཙམ་དུ་ནི་ལུས་ནི་བསྐྱོད་ཅིང་འདུག།",
    "ཁྲོས་བྱས་འདུག་སྟེ་སྐད་ཅིག་ཙམ་གྱིས་གཡོ་མེད་མིག་ཅན་ནི།",
    "དེ་ནས་གདུག་པའི་བདག་ཉིད་བློ་གྲོས་ངན་པ་དེ་ཡོངས་ནས་བསྒོ་བ་ཞུས་པའི་ཞུགས་པ་རྗེས་སུ་གནང་བ་སྟན་ཡོངས་སུ་འཛིན་པར་བྱས་པ་དབེན་པར་རྒྱལ་པོ་རི་རབ་ལ་མི་བདེན་པའི་ཚིག་རྣམས་ཀྱིས་སྦྱོར་ཞིང་འདུག་གོ།",
    "ཇི་ལྟར་བུང་བ་མི་སྨྲ་བར་ནི་འདུག་པར་གྱུར།",
    "དེ་ཡིས་སེམས་བཟང་རང་བཞིན་གྱིས།",
    "དེས་ཀྱང་དེ་མནོས་ནས་གུས་པ་དང་བཅས་པར་མགོ་བོ་ལ་བཏགས་ཏེ་འདུག་གོ།"
  ]
}