    "དཀའ་བཞི་བ་དེ་བལྟ་བའི་ཆེད་དུ་ལུང་གིས་བཞག་པ་ལ།",
    "བལྟས་ངོ་མཚར་ཅན་འདི་དག་རི་མོར་བཀོད་དེ།",
    "མགོན་པོ་སྤྱན་རས་གཟིགས་ཀྱིས་སྐུ་ཁམས་བདེ་ཞིང་རྒྱ་ཡུལ་དུ་བཞུགས་པའི་རིང་ལ་བར་ཆོད་མེད་པར་ལུང་བསྟན་པའི་ཚེ།",
    "ད་རེས་ཅང་མི་སྟོ།",
    "དབྱར་བཞུགས་དུས་རེ་ཤིག་བཙུན་མོ་ཆེན་མོ་འདས་པའི་དགོངས་རྫོགས་ཀྱི་སྒྲུབ་མཆོད་མཛད་ཅིང་།",
    "གོང་གི་སྐྱེས་དུས་ཀྱི་ལྟད་མོ་ཡོ་ལང་ཆེན་པོ་སྔར་བཞིན་ལ།",
    "དེ་དག་གི་སྐབས་སུ་ཡང་ཤིས་བརྗོད་མཛད་པ་ཡོད་ཅིང་།",
    "གོང་མའི་ལུང་གིས་གན་མཛོད་མང་པོར་གདན་དྲངས་ཏེ་གཟིགས་ཕུལ་ནས་གང་བཞེད་འབུལ་བར་ཞུས་ཀྱང་།",
    "མུ་ཏིག་གི་མཆོད་རྟེན་སོགས་རྟེན་མང་པོ་དང་།",
    "འཚུར་ཕུའི་གཙུག་ལག་ཁང་གི་སྟེང་དུ་འབིབས་རྒྱུའི་གསེར་ཐོག་སོགས་འབུལ་བ་དཔག་པར་དཀའ་བ་རྣམས་ཕུལ།",
    "རབ་བྱུང་བསྙེན་རྫོགས་ཀྱི་བཀའ་དྲིན་ནོད་པ་མཐའ་ཡས་པ་ཡོད་མོད་ཀྱི།",
    "རེ་རེ་ནས་བརྗོད་པར་མ་ལང་ནས།",
    "རེ་ཤིག་ནུབ་ཕྱོགས་ཀྱི་གདུལ་བྱ་རྣམས་སྨིན་གྲོལ་ལ་བཀོད་ནས།",
    "ཉིན་གཅིག་དཔོན་སློབ་ཁ་གཅིག་སྟག་ཚང་གཟིགས་སུ་བྱོན།",
    "སྟག་ཕྲུག་རྣམས་ཞལ་དུ་བལྟ་ཞིང་བག་ཚ་བ་མེད་པར་ཁོ་རང་ཚོ་རྩེད་མོ་བྱེད་དོ།",
    "མགོན་པོ་འོད་དཔག་ཏུ་མེད་པ་འཁོར་ཚོགས་རྒྱ་མཚོ་དང་བཅས་པའི་བདེ་བ་ཅན་གྱི་ཞིང་གི་བཀོད་པ་གསལ་བར་གཟིགས་ཏེ།",
    "གོང་ནས་ཀྱང་ལོ་རེ་བཞིན་དུ་ལོ་འཁོར་མའི་གསོལ་ཕོགས་ན་བཟའ་ཆ་ཚང་འབུལ་བའི་ཏའི་ཞིང་རྣམས་ཀྱང་རིམ་པས་སླེབས།",
    "ཚང་གསར་བས་ཡང་དང་ཡང་ཞུས་ཏེ་ཁང་པ་བཞི་ཐོག་གི་རྩེར་སྤྱན་དྲངས།",
    "འཚུབ་མ་ཆེན་པོ་གང་ནས་འོངས་པའི་ཕྱོགས་སུ་ཞལ་གཟིགས་ཤིང་།",
    "ཆབ་ལ་ཁར་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་ཞལ་གཟིགས་ཏེ།",
    "ཆུ་བློ་བུར་དུ་ཆུང་དུ་སོང་ཏེ་རྟའི་ཡོབ་ལ་མ་རེག་པར་སྣང་བས་བྱིན་ཡ་མཚན་དུ་གྱུར།",
    "འོད་དཔག་མེད་དང་སྤྱན་རས་གཟིགས་ལ་བསྟོད་པ་ཡང་མཛད།",
    "ལྕགས་མོ་ཡོས་ཀྱི་ལོ་ལ་འདམ་གྱི་ས་ཆར་ཕེབས།",
    "ཁོ་རང་གི་བསམ་པ་མཁྱེན་ནོ་སྙམ་དུ་ཅུང་ཟད་གནོང་བཞིན་དུ་དད་པ་སྐྱེས་སོ།",
    "ཤ་མོང་གི་ཚོད་མ་འདི་ལ་རྒྱ་རྣམས་རྩིས་ཆེ་བ་དང་མཁས་པ་ཡིན་ཞེས་གསུང་ངོ།",
    "ཀོང་དགོན་དུ་བྱོན་པ་ན་འཕགས་པ་སྤྱན་རས་གཟིགས་ལ་ཡི་གེའི་ཕྱི་མོ་དང་སྦྱར་བའི་བསྟོད་པ་མཛད།",
    "གན་ཤོག་གི་གཞི་ལ།",
    "སྣམ་པར་དུ་དགུན་བཞུགས་མཛད་པའི་དུས་གཅིག་ཕག་མོ་དཀར་མོ་གཟིགས་ཤིང་།",
    "ཆུ་མོ་སྦྲུལ་ལོ་ལ་སླར་ཡང་།",
    "ཡུད་ཀྱི་ཕེབས་པའི་རྫུ་འཕྲུལ་ལྟ་བུ་གཟིགས།",
    "རྩེ་བླ་སྒང་གི་གཟིམས་ཁང་ཆེན་མོ་རྒྱ་ཞབས་སུ་ཡོད་པའི་ལས་ཁྲལ་གྱིས་བརྩིག་པའི་བཀའ་བཀོད་དང་།",
    "གསེར་ཐོག་རྒྱུ་ཟངས་ཀྱི་གྱོ་མོ་མང་པོ།",
    "བྲག་ལྷ་ཀླུ་ཕུག་གི་མདུན་དུ་ཕུལ།",
    "རྒྱུསྐྱོང་བེར་ནག་ཅན་སྐུ་ཚད་ཤིན་དུ་ཆེ་བས་ཕྲིན་ལས་བསྒྲུབ་པ་གཟིགས་པ་ལྟར།",
    "མགོན་པོ་ཕྱག་བཞི་པ་དང་ཕྱག་དྲུག་པ་གཟིགས་ཤིང་།",
    "ད་ཁྱེད་རང་ཚོ་སྔོན་ལ་སོང་གསུང་བ་ལ་བརྟེན་ནས་རིངས་པར་འོངས་པས།",
    "ལྷའི་མེ་ཏོག་གི་ཆར་ཐུས་ཆོག་པ་བབ།",
    "ཤིང་མོ་ལུག་གི་ལོ་ལ་སྣམ་བར་དང་འཚུར་ཕུར་ཐོག་རེ་བཞུགས་ནས།",
    "རྒྱ་གར་ཚུན་ཆད་མོན་ཡུལ་སོགས་ཀྱི་མི་ཆེན་ཇོ་བོ་དུ་མས་ཞུ་ཡིག་འབུལ་བ་དང་།",
    "དམན་པ་མ་རུངས་པ་རྒྱུད་ཤིན་དུ་མ་ཞི་བའི་སྐྱེ་བོ་ལ་ལྷག་པར་ཡང་བྱམས་པ་དང་བརྩེ་བའི་ཐུགས་ཕྱིན་ཅི་ལོག་གི་རྐྱེན་གྱིས་འཁྲུགས་པ་དང་གཡོ་བ་མི་མངའ་བ།",
    "རེ་ཤིག་སྐུ་ཚེ་འདི་ཕྲིན་ལས་ཚད་བཟུང་དཀའ་བ་མ་ལུས་པ་ཡོངས་སུ་རྫོགས་པར་བསྟན་པའི་ཆེད་དུ།",
    "ལྷ་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་དང་ཉེ་བའི་སྒར་དུ་ཡུན་རིང་བར་བཞུགས་ཏེ།",
    "ཟླ་བ་བདུན་པའི་ནང་དུ་ཉིན་གཅིག་གི་ཚེ།",
    "སྨྲ་བསམ་བརྗོད་མེད་ཤེས་རབ་ཕ་རོལ་ཕྱིན་ཞེས་སོགས་ཤོ་ལོ་ཀ་གཅིག་པོ་དེ་གསུང་བའི་མོད་ལ།",
    "དེའི་ཉིན་མོ་བར་སྣང་ལ་འསྔའ་ཁ་དོག་སྣ་ཚོགས་པ་འཁྲིགས་ཤིང་།",
    "མེ་ཏོག་གི་ཆར་བབས་པ་དང་།",
    "ཉིན་མོར་བྱེད་པའི་དཀྱིལ་འཁོར་ཡང་འོད་མི་གསལ་བའི་བལྟས་བྱུང་།",
    "མི་དཀར་པོ་ཞིག་གིས་སེང་གེ་ལ་ཞོན་ནས་ནམ་མཁའ་ལ་འགྲོ་བ་མཐོང་།",
    "ནམ་མཁའ་འཇའ་འོད་ཀྱིས་གང་བར་སྣང་བས་ཅུང་ཟད་ཡིད་སྐྱོ་བར་གྱུར་པའི་མོད་ལ།",
    "ལྷའི་མེ་ཏོག་འདབ་མ་བཞི་པ་དང་འདབ་མ་བརྒྱ་པ་དང་འདབ་མ་སྟོང་པ་སོགས་ཉིན་རེ་བཞིན་དུ་བར་སྣང་དང་ས་ལ་ལྡིང་ཞིང་བབ།",
    "འགྱེད་ཟླ་བ་སྦྲེལ་པོའི་བར་ཉིན་རེ་བཞིན་མ་ཆད་པ་བསྒྲུབས།",
    "ཁྲི་རྒྱབ་ཕུལ་མ་ཤེལ་གྱི་ཚེ་དཔག་ཏུ་མེད་སྐུ་སྟོང་གིས་མཛེས་པ་དང་།",
    "ཁ་ཅིག་ན་རེ་འདི་ནི་ཡིན་ནོ།",
    "ཀྱི་བློ་དག་པའི་བློ་སྣང་འཕགས་ཆེན་བླ་ན་མེད་པ་དག་ལ་སྦྱར་བར་མ་བྱེས་ན་མཛེས་མོད་ཀྱི།",
    "གལ་ཏེ་མིན་ན་ཁྱེད་ཅག་མཁྱེན་པ་དང་ལྡན་པ་དག་གིས་སློབ་པར་འཐད་ལ།",
    "དེ་དང་དེ་ལྟ་བུ་རིགས་པ་དང་མི་རིགས་པའི་ཚུལ་མང་དུ་མཐོང་མོད་བརྗོད་པས་ཅི་ཞིག་བྱ།",
