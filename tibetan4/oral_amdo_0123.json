    "ཡོངས་སུ་དག་པ་ཕུལ་བས་ན་བདག་ཉིད་དགསོ་སྤྱོང་གི་སྣོད་དུ་འགྱུར་རོ།",
    "དད་པ་ལེན་པའི་དགེ་སློང་གིས་ཀུན་ཏུ་སྤྱོད་པའི་ནང་དད་པའི་ཚེ་མཚམས་ཀྱི་ཕྱི་རོལ་ནས་ནང་དུ་ཕན་ཚུན་དུ་དབུལ་བར་མི་བྱ་ནམ་མཁའ་ལ་གནས་ཤིང་ས་ལ་དབུལ་བར་མི་བྱ།",
    "བདག་ཅག་ཉིད་ཀྱང་རྒྱལ་པོའི་བུ་ཞིག་པས་ཀ་ཕྱི་པྱེ་ལ་ཞེས་བྱ་བའི་དྲང་སྲོང་གིས་ཀྱང་རིལ་བ་སྤྱི་བླུགས་ཀྱིས་ཡུལ་གྲུ་བཅད་དེ་བྱིན་ནས།",
    "རྟག་པར་ཤིན་ཏུ་བརྟེན་སྙུཔ་ཞེས་བྱ་བ་ནི་ཁྱེཤློ་ཀ་གཅིག་གིས་ནི་ལྟ་བ་ལ་ཆགས་སུ་མི་གཞུག་པ་བསྟན་ཏེ།",
    "ཉོན་མོངས་པའི་གཡུལ་ལ་བརྟེན་ཞིང་འཇུག་ཀྱང་བདག་ཅེས་བྱ་བ་མེད་པས་ན་སེམས་འབའ་ཞིག་གདུལ་བའི་དོན་ཏོ།",
    "དེས་ནི་ཀུན་ནས་ཉོན་མོངས་པ་སྦྱོང་ཞིང་སྤེལ་བར་སྟོན་གྱི།",
    "བདག་རྟག་པ་ཐེར་ཟུག་པ་ནི་རྟག་པར་མི་འགྱུར་བའི་རང་བཞིན་དུ་འདོད་པས་ན་ཀུན་ནས་ཉོན་མོངས་པའང་མེད།",
    "བདག་ལ་གནོད་པའི་དཀའ་ཐུབ་སྤངས་མོད་ཀྱི་སྦྱངས་པའི་ཡོན་ཏན་དང་ཡང་མཐུན་པས་ཧ་ཅང་དོག་པ་ཡང་མ་ཡིན།",
    "འདོད་པའི་བདེ་བ་ཙསྤངས་མོད་ཀྱི་གང་ཟག་མ་རབས་རྣམས་ཀྱི་ཀྱེསྤྱོད་པ་དང་མཐུན་པས་ཧ་ཅང་སྤངས་པ་ཡང་མ་ཡིན་ནོ།",
    "ཆེ་བ་གང་དག་ཅེས་བྱ་བ་ཤློ་ཀ་གཅིག་གིས་ནི་ཡང་དག་པར་འཛིན་པའི་ལེགས་པ་བསྟན་ཏེ།",
    "དེ་ལ་ཆེ་བ་ཞེས་བྱ་བ་ནི་རྣམ་པར་གྲོལ་བའི་འབྲས་བུ་ཐོབ་པ་དག་ལ་ཆེ་ཞེས་གདགས་པ་ཡང་ཡོད་མོད་ཀྱི།",
    "དེ་ཡང་ངག་གིས་རྡུབསྒོ་བ་ཙམ་གྱིས་ལྡོག་པའོ་ཞེའོ།",
    "ངག་གིས་སྨྲས་པ་ཙམ་གྱེས་བྱཉོན་མོངས་པའི་ཕྱོགས་ལས་སྡོག་པའོ།",
    "ཉོན་མོངས་པའི་གཡུལ་ལས་ཐར་ཅེས་པ་ནི་ཇི་ལྟར་ཐབས་དང་ལྡན་པའི་སྐྱེས་བུ་གཡུལ་ངོ་བཟློག་སྟེ།",
    "དེ་ལ་ཁ་ཅིག་ན་རེ་མུ་སྟེགས་ཅན་གཅིག་པུར་མ་ཟད་ཀྱི།",
    "དེ་དག་ཉོན་མོངས་གཡུལ་ལས་ཕམ།",
    "ཞེས་བྱ་བ་ནི་ཉོན་མོངས་པ་ནི་འདོད་ཆགས་དང་ཞེ་སྡང་དང་།",
    "ཉོན་མོངས་པ་ལས་རྔུབདག་ཉིད་ཕམ་པས་ན་ཉོན་མོངས་གཡུལ་ལས་ཕམ་ཞེས་བསྟན་ཏོ།",
    "ཞེས་པ་གང་གིས་གཟུངས་མེད་ཅེ་ན།",
    "བྱོལ་སོང་དང་།",
    "དགེ་སློང་དག་གིས་དྷིམི་ཤེས་པར་གྱུར་ནས་བཅོམ་ལྡན་འདས་ལ་ཞུས་པ་དང་།",
    "དུས་ལ་བབ་ཅེས་བྱ་བ་ནི་གསོ་སྦྱོང་གི་དུས་ལ་བབ་པའོ།",
    "དེ་ཡང་མི་ཤེས་ན་གནས་བརྟན་དང་འོག་གིས་གདོན་ཏོ།",
    "མཐོལ་ཅིག་ཅེས་བྱ་བ་ནི་ལ་ལ་ན་རེ་དེར་འཕྲལ་༦དུ་དྲན་ན།",
    "ཁ་ཅིག་ན་རེ་དེར་ཡིད་ཀྱིས་ལྡུབྱིན་གྱིས་བརླབས་ལ་ཕྱིས་མཐོལ་ཅིག་ཅེའོ།",
    "ཁ་ཅིག་ན་རེ་ཁ་ཏོན་འདོན་པས་ནི་ཡིད་ཀྱིས་བྱིན་གྱིས་བརླབ་པོ།",
    "སོ་སོར་དྲིས་ནས་ལན་བཏབ་པ་དེ་བཞིན་དུ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་མ་ལྷགས་པ་རྣམས་ལ་གནས་སོ་སོར་དྲིས་ན་དེ་དག་གིས་དད་པ་དང་གཙང་མ་ལན་གསུམ་གྱི་བར་དུ་བཟླས་ཏེ།",
    "བརྫུན་ནི་ཚིག་ཡིན་མོད་ཀྱི།",
    "ཚིག་གིས་གོ་བར་བྱའོ།",
    "བདག་ཉིད་ཀྱང་སྦྱངས་པའི་ཡོན་ཏན་ཅན་བསོད་སྟོམས་བླངས་པ་ལས་ནང་ཅིག་བདག་གིས་མའི་སྒོར་འོངས་པ་དང་དེར་མ་ཡང་གྲོང་གཞན་ཞིག་ཏུ་སོང་སྟེ་དེ་ནས་སྦྱིན་པ་ཡང་མ་འཐོབ།",
    "མི་གཅིག་ཀྱང་མི་སྣང་ནས་སླར་མྱུར་དུ་སོང་བ་དང་།",
    "བྲན་མོ་ཅིག་པྱེགིས་མཐོང་ནས་དེས་ཇོ་མོ་ག་ན་བ་དེར་སོང་སྨྲས་ན།",
    "བདག་གི་བུ་དེ་ནི་སླར་ཁྱིམ་པར་དབབ་འདོད་ཡང་དག་སྙམ་ནས་ཕྱི་བཞིན་བརྒྱུགས་ཏེ་བུའི་གན་དུ་འོངས་ནས་བུ་ཁྱོད་དགེ་སྤྱོང་ལ་སྐྱོ་འམ།",
    "ཁྱོད་ཀྱི་ཕའི་ནོར་ལ་ལྟ་ཞིག་ཅི་སྨོས་ཀྱི།",
    "ཁྱོད་ཀྱི་མའི་ནོར་གསེར་དངུལ་སྤུངས་པ་ཡང་ཕ་རོལ་ན་མི་འགྲེང་བས་ཚུལ་རོལ་ན་འགྲེང་བ་མི་མཐོང་།",
    "ཚུ་རོལ་ན་འགྲེང་བས་ཕ་རོལ་ན་འགྲེང་བ་མི་མཐོང་བ་ནི་ཁྱོད་ཀྱི་མའི་ནོར་ཡིན་ན་འདི་རྣམས་སུས་བསྐུར།",
    "མས་བསམས་ལྕོ་པ་ད་བདག་གིས་ཇི་ལྟར་ཉུཟིབྱས་ཀྱང་རུང་བ་ལྟ་མ་ཡིན་སྙམ་ནས་སླར་སོང་སྟེ་ཁྱིམ་དུ་འོངས་ནས་མནའ་མ་ལ་སྨྲས་པ།",
    "ཁྱོད་ཀྱིས་ནོར་ཀུན་སླར་བཞེས་པ་སྐྱེརེས་ཀྱང་བྱ་སྟེ།",
    "ཅི་དང་ཅི་ལ་སྙད་བཏགས་ནས་བུ་མོ་འདི་དུས་ལ་བབ་ཀྱི་ས་བོན་གྱི་ཚུལ་ཅུང་ཟད་ཅིག་བྱིན་ཅིག་བྱས་པ་དང་།",
    "ངན་སོང་མ་མཐོང་བས་ན།",
    "སྤྲ་མོ་སྙེཞིག་ཁ་ཟས་ཀྱིས་བྲིད་ནས་དེ་ལ་མི་ཚངས་པར་སྤྱོད་དོ།",
    "སྤྲ་མོ་དེ་ཡང་དེར་འོངས་ནས་དགེ་སློང་དེའི་མདུན་ན་འདུག་སྟེ་རོ་སྨད་བསྙེན་པ་དང་དགེ་སློང་དེ་གྲོགས་མང་པོ་ལ་རབ་ཏུ་ངོ་ཚ་བར་གྱུར་ནས་ལན་གཉིས་ལན་གསུམ་ཕུལ་ཏེ་བསྐྲད་པ་དང་།",
    "དགེ་སློང་དེའི་གདོང་དུ་སྤྲ་མོས་བཟར་མེཏེ།",
    "སྒྲ་མི་སྙན་པ་འབྱེན་༨ཅིང་སོང་ནས་ཕ་ཟད་ནས་ལྟ་ཞིང་ཙོག་པུར་འདུག་གོ།",
    "ཁྱོད་ཀྱིས་དེ་ལ་ངོ་ཚ་བའི་ཕྱིར་བསྐྲད།",
    "བྱོལ་སོང་ལ་མ་ཡིན་ནོ་ཞེས་སྨྲས་པ་དང་།",
    "དགེ་སློང་དག་གིས་དེ་ལ་བསྔགས་པ་ཡང་མེད།",
    "དོན་དང་ལྡན་པར་དགོངས་ནས་ཚེ་དང་ལྡན་པ་བཟང་སྦྱིན་ཁྱོད་ཀྱིས་དེ་ལྟ་བུ་མི་རིགས་པར་བྱས་པ་བདེན་ནམ་ཞེས་རྨད་༩པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྨད་དེ་དགེ་སློང་གི་བྱ་བ་མ་ཡིན།",
    "ཁྱོད་ཀྱིས་སྦྲུལ་མ་རུངས་པའི་ཁར་ཕོ་མཚན་བཙུག་པ་ནི་བླའི།་",
