    "དེ་དག་ན་གཅིག་པུ་གཉིས་སུ་མེད་པར་ལུས་རབ་ཏུ་དབེན་པར་འདུག་སྟེ།",
    "དེ་དག་དེ་ན་གཅིག་བུ་གཉིས་སུ་མེད་པར་རབ་ཏུ་དབེན་པར་འདུག་སྟེ།",
    "ཇི་ལྟར་འདུག་པ་དེ་བཞིན་དུ་ཚེའི་འདུ་བྱེད་འདོར་བར་འགྱུར་ཞེས་བྱ་བ་ནི་ལུས་ལས་སུ་རུང་བའི་ཕྱིར་ཏེ།",
    "བཅུ་པས་ནི་ཉམ་ཆུང་བ་མེད་པས་འདུག་བཞིན་དུ་ཚོའི་འདུ་བྱེད་དག་འདོར་བའོ།",
    "རང་རང་ལས་དང་གཅིག་ཏུ་གནས་པ་ཡི།",
    "འཁྲུལ་སྣང་རང་བཞིན་མེད་པ་ནི།",
    "ཚེ་འདི་ལས་བློ་ཡེ་མ་ལྡོག་པར་འདུག་པ་སོམས་དང་།",
    "ང་རང་མ་ཡིན་པ་གཞན་གཅིག་ཀྱང་མེད་པ་གཅིག་བྱ་དགོས་སྙམ་ནས།",
    "རང་བསྟོད་དང་རང་སྒྲུབ་འབའ་ཞིག་ཏུ་འདུག་པ།",
    "འཇིག་རྟེན་པ་དང་ཁྱད་མི་འདུག་པ།",
    "གོས་བཟང་པོ་ཡང་སྡུག་བསྔལ་གྱི་རྒྱུར་འགྲོ་བར་གདའ་བ།",
    "དོན་གྲུབ་པ་ཤ་སྟག་བྱོན་ནས་གདའ་བ།",
    "འདིས་ང་ལ་ཅི་སྟེར་རམ་སྙམ་འདུག་པ།",
    "མེ་ཏོག་འདི་ཙམ་འདོད་ཟེར་བར་འདུག་པ།",
    "འོ་སྐོལ་ནི་ཚོང་གཅིག་བྱེད་ཀྱང་རང་རྒྱལ་བར་འདོད།",
    "ཟས་གཅིག་ཟ་ཡང་རང་ཆེ་བ་དང་ཞིམ་པར་ཟ་འདོད།",
    "ཞག་གཅིག་ཉལ་བར་ཡང་རང་སྐྱིད་པར་ཉལ་འདོད།",
    "ཕུགས་ན་འདོད་པ་བཅུག་ནས་གདའ་བ།",
    "གཉེན་པོས་བཅུན་ཡང་མི་ཕན་པར་འདུག་པ་ཆ་མེད་དམ།",
    "ང་རང་སྐྱིད་རུང་སྡུག་རུང་།",
    "འདུག་ས་རི་ཁྲོད་དུ་བགྱིས།",
    "ང་མི་ཆེན་པོ་ལ་བརྙས་པ་བྱེད་པ་ཟེར་ནས་ཀོ་ལོང་དམ་པར་གདའ་བ།",
    "འོ་ན་ང་སླ་སྟེ་ཟེར་བར་གདའ་སྟེ།",
    "ཁོང་ཐམས་ཅད་ངོ་མཚར་ཅན་དུ་འདུག་པ།",
    "དེ་ཤར་བ་དང་སློབ་དཔོན་གྱིས་ཀྱང་ཚིག་ཚོགས་སུན་སུན་མེད་པར་འདི་རྗེན་པར་བསྟན་པས་ཆོག་པར་འདུག་པ་ལ་སྙམ་པ་འབྱུང་།",
    "རྒྱ་གར་གྱིས་གྲུབ་ཐོབ་ཐམས་ཅད་ཀྱིས་ཚོགས་པ་ཆེན་པོ་བསྐྱངས་པ་མི་གདའ་སྟེ།",
    "སྤྲུལ་པ་ལ་སྤྲུལ་པར་མཐོང་བ་དེ་ཚོགས་ལམ་ཆེན་པོའི་གནས་སྐབས་ལགས་པར་གདའ།",
    "དུ་ཁ་སེམས་ཁྲལ་ཆེ་སྙམ་པར་མི་བྱ་བར་གཞན་ལ་ཕན་པར་འདུག་ན་ངའི་སྐྱིད་སྡུག་ཐམས་ཅད་ཡལ་ནས་འགྲོ་བ་ཡིན་གྱི།",
    "ང་རང་གཅིག་པོ་སྐྱིད་པས་མི་ཕན་སྙམ་དུ་བསམས་ལ།",
    "མུན་པ་སངས་པའི་སྟེང་དུ་ཆབ་རོམ་ཡང་མ་ལུས་པར་འཇུ་བ་གདའ་བ།",
    "སྒལ་པ་ལ་འཁྲིལ་ནས་འདུག་ངེད་ཀྱིས་དང་པོ་མི་རོ་བཤས་ནས་ལྟས་གསུངས།",
    "ཡུལ་འདྲེ་བྱ་བ་རང་ལ་ཆགས་ཞེན་དང་ཉེ་རིང་འདོད་བློ་ནང་སྲན་འདུག་ན།",
    "རང་ལ་ནང་ན་གཡོ་ཁྲམ་ཟོལ་ཟོག་ལ་སོགས་པ་མེད་པས་མི་སྡིག་སོག་ཇི་སྐད་ཟེར་བ་ཟེར་དུ་ཆུག་ཀྱག་གཏད་ཡེ་མི་འདུག་པས།",
    "ཁོ་ཐག་ཆོད་མ་ཆོད་དམ་ཞེན་པ་རྫོགས་མ་རྫོགས་སམ་གསལ་མི་གསལ་འདུག་ན་དངོས་སུ་བཤམས་པའི་དངོས་པོ་དེས་ཕུལ་བས་འབྲས་བུ་དང་ཕན་ཡོན་མྱུར་གསུངས།",
    "ཕྱིས་ཀྱང་བུ་སློབ་དམ་ཚིག་ལ་དགར་ནས་ང་ཤི་ཙ་ན་བསྲེགས་ལ་རུས་པ་ཚོ་བརྡུངས་ལ།",
    "སྐུ་བསོད་ཆེའམ་ནོར་ཅི་ཙམ་ཡོད་ཟེར་བ་ལས་མི་འདུག་ད་མི་ཚེ་ལྷག་མ་འདི་ཕྱི་རྒྱབ་ཏུ་ནམ་ཡང་མི་འགྲོ་སྟེ།",
    "སྤྱན་སྔ་ནས་ཆོ་འཕྲུལ་ཇི་འདྲ་གདའ་ཞུས་བས།",
    "འདིར་དང་པོ་རྗེ་མི་ལས་བཞུགས་པར་གདའ།",
    "ཙ་རི་དང་ཛ་ལནྡྷ་ར་བས་ཀྱང་འདི་གཉན་པ་ཅིག་འདུག་པ་ལ།",
    "སྣང་ཆ་མ་འགགས་པ་ལ་འཛིན་ཆ་མི་འདུག་པ་དེ་ཀ་ཡེ་ཤེས་ཡིན་ཏེ།",
    "ཁོང་རྣམས་སྣང་ཆ་ཟད་པས་ཡེ་ཤེས་ཟད་འཛིན་བྱེད་མེད་པས་ཡེ་ཤེས་མེད་པར་བྱེད་པར་འདུག་སྟེ།",
    "ཁོང་བཞིན་བྱས་ན་ངེད་ཀྱི་དེ་གོལ་ས་རུ་བྱེད་པར་གདའ་ཤིན་ཏུ་འགལ།",
    "སྙན་གྲགས་ལ་སོགས་པ་ཆེ་བའི་དུས་དེར་ད་ནི་ང་བཟང་པོར་འདུག་སྙམ་པའི་རློམ་སེམས་སྐྱེས་པ་དེ་ཀ་བར་ཆད་ཡིན་པས་ནག་ཁྲལ་ལ་འགྲོ།",
    "ཡི་དྭགས་རང་རྒྱུད་པར་བསྔོ་རུ་མི་རུང་གསུང་པར་གདའ་ན་དེ་ཇི་ལྟར་དུ་བགྱི་ཞུས་པས།",
    "མཁས་བཙུན་ལ་སོགས་པ་ཡོན་ཏན་དུ་མ་དང་ལྡན་པ་ལ་འགྲོ་དོན་མེད་པའམ་རྒྱ་ཆུང་བའི་རྣམ་པ་ཡང་གདའ།",
    "ལྟར་སྣང་ལ་ཐོས་བསྒོམ་ལ་སོགས་པ་མེད་པ་ལྟ་བུ་འགྲོ་དོན་རྒྱ་ཆེ་བ་འབྱུང་པར་གདའ་ན་དེ་ཇི་ལྟར་མཆི་བ་ལགས་ཞུས་པས།",
    "སྤྱིར་འགྲོ་དོན་ལ་གཞན་སྣང་དང་རང་སྣང་གཉིས་ཡིན།",
    "དང་པོ་བཙུན་པ་ཡིན་པ་ལ་ཕྱིས་རྫོགས་པ་ཆེན་པོ་རྟོགས་ནས་ན་བཟའ་དཀར་པོ་གཅིག་གསོལ་དབུ་སྐྲ་རིང་པོ་འདུག་སྟེ།",
    "གྲུབ་ཐོབ་དང་པཎྜི་ཏའི་ལྡོ་ལི་འདེབས་པ་ལ་རྔན་པ་ལ་གསེར་སྟེར་དགོས་པ་འདུག་རྡོ་རྗེ་གདན་ལ་སོགས་པ་ན་ད་ལྟ་ཧོར་གྱིས་གཟུང་ནས་ཡོད་ཟེར།",
    "དབུས་གཙང་གཉིས་ལས་ལྷག་པ་མི་འདུག་གསུངས།",
    "གཙང་མི་དགའ་ཇོ་བོ་བཟང་བར་འདུག་གསུངས།",
    "དེ་ལ་ཡང་ཇོ་བོ་བཀའ་གདམས་པ་རྣམས་ཀྱི་བཞེད་པ་ནི་མི་ལུས་ཡོན་ཏན་བཅོ་ལྔ་པར་འདོད་པ་ཡང་འདུག་ལུས་ལ་ཡོན་ཏན་དྲུག་ངག་ལ་དྲུག་སེམས་ལ་གསུམ་སྟེ་བཅོ་ལྔ་ཚང་པ་ཅིག་དགོས་གསུངས།",
    "གཉེན་ཞིང་རྩུབ་པར་ཡང་གདའ་བ་ལ།",
    "འོ་ན་ཐུགས་དམ་བཅུ་གཉིས་མཛད་པ་ལ་གང་དཀའ་བར་གདའ་ཞུས་པས།",
    "ཁྲུས་རང་ཡང་དེ་ཀ་ནས་བྱས་པ་ཡིན་ཏེ་ཕན་པར་འདུག་གསུངས།",
