    "ཀོ་མོ་ད་ཀཱི།་",
    "མིང་གི་ཁྱད་པར་གྱི་འགྱུར་བ་ནི་དཔེར་ན།",
    "དེའི་ཁྱད་པར་སྒྲུབ་པ་ལས་ཞེས་པ་ཕོ་མོ་མ་ནིང་དེའི་ཁྱད་པར་ལས་ཉེ་བར་བླངས་པས་འགའ་ཞིག་ཕོ་མོ་མ་ནིང་དུ་ཤེས་པར་བྱ་བ་སྟེ་འགའ་ཞིག་ཅེས་པ་ནི་གང་དུ་གཟུགས་ཀྱི་དབྱེ་བ་མེད་པ་འམ།",
    "བལླ་རི་རྨྨཉྫ་རི་སྟྲི་ཡོ་སྟྲི་ཡ་སུ་མ་ན་ས་པུཥྤཾ་ཁ་ནི་མོ་དང་འབྱུང་ཁུངས་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཀུན་སྡུད་པའི་ཟླས་དབྱེ་ལ་གཟུགས་ཀྱི་དབྱེ་བས་རྟགས་དེའི་སྒྲུབ་པ་གང་གིས་གསལ་བར་བྱེད་ཅེ་ན།",
    "གཅིག་གི་ལྷག་མ་ལ་ཡང་ངེས་པར་ཞུགས་པའི་ཚིག་རྣམས་ལ་རྟགས་ངེས་པར་བྱེད་པ་མེད་དོ།",
    "ལྷ་མོ་དང་ལྷ་ནི་ལྷ་དག་གོ།",
    "བྱ་གག་མོ་དང་བྱ་གག་ནི་བྱ་གག་དག་གོ།",
    "བ་ལང་མོ་དང་བ་ལང་ནི་བ་ལང་དག་གོ་ཞེས་པ་འདི་རྣམས་དང་སྣམ་བུ་དཀར་པོ་དང་།",
    "གྲྀ་ཧ་དང་གེ་ཧ་དག་ཁྱིམ་མོ།",
    "འོ་ན་རྟགས་ཐ་དད་པ་རྣམས་ཀྱང་ཟླས་དབྱེ་དང་གཅིག་གི་ལྷག་མར་བྱས་པ་དཔེར་ན་རིག་འཛིན་ཆུ་སྐྱེས་གནོད་སྦྱིན་དང་།",
    "དེ་ལྟར་སྦྱར་བ་ཉིད་རྟགས་ཀྱི་ཁྱད་པར་དང་བྲལ་བའི་ཕྱིར་གཅིག་གི་ལྷག་མ་ཡོངས་སུ་སྤང་བ་འདི་ནི་པ་ཎི་ནི་ལ་སོགས་པར་སོ་སོར་བལྟ་བར་བྱ་སྟེ།",
    "དེ་རྣམས་སུ་བུད་མེད་དང་སྐྱེས་པ་དང་མ་ནིང་ལ་སོགས་པའི་གཅིག་གི་ལྷག་མའི་མཚན་ཉིད་རབ་ཏུ་གསལ་བའི་ཕྱིར་རོ།",
    "སློབ་དཔོན་ཙནྡྲ་གོ་མིས་གཅིག་གི་ལྷག་མ་མིན་པའི་སྒྲའི་ནུས་པ་བསྟན་པ་ཤེས་པར་བྱེད་པ་ནི།",
    "གང་གི་ཕྱིར་སྒྲའི་ནུས་པ་གཅིག་ཀྱང་དོན་དུ་མ་བརྗོད་པའི་སྒྲར་འགྱུར་ཏེ་དཔེར་ན།",
    "ཇི་ལྟར་རིན་ཆེན་མཛོད་ལ་སོགས་པ་བཞིན་བུད་མེད་ཀྱི་སྐབས་དང་སྐྱེས་པའི་སྐབས་ཀྱི་མིང་རྣམས་ཅི་རིགས་པར་རྣམ་པར་དབྱེ་ནས་སོ།",
    "འདིར་ནི་མཐོ་རིས་དང་ནམ་མཁའ་དང་ཕྱོགས་དང་དུས་ལ་སོགས་པ་ཇི་ལྟ་བའི་གོ་རིམས་ཀྱི་དེ་དང་འབྲེལ་པའི་ལྷ་ལ་སོགས་པའི་དོན་རྣམས་རང་རང་གི་འབྲེལ་པ་དང་བཅས་པ་རྣམས་ཇི་ལྟར་གཙོ་བོའི་རང་བཞིན་གྱིས་བརྗོད་བྱའི་དོན་རྟོགས་པའི་ཕྱིར་ཏེ།",
    "དེ་ལ་གང་གི་རྣམ་གྲངས་རྣམས་དང་འབྲེལ་པ་རྣམས་དང་མིང་རྣམས་དེའི་བརྗོད་བྱའི་གནས་སྐབས་གང་དང་གང་ལ་བརྟེན་པ་དེ་དང་དེའི་གོ་རིམས་རྣམས་བསྟན་པས།",
    "སེང་གེ་དང་འཕྲོག་བྱེད་ལ་སོགས་པའི་སྐབས་སུ་དཔལ་མོ་དང་གོ་རི་ལ་སོགས་པ་བརྗོད་པ་ནི།",
    "གསུམ་རྣམས་དང་རྟགས་རྣམས་ནི་རྟགས་གསུམ་ཅན་ཞེས་ཀུན་སྡུད་པ་སྟེ་རྟགས་གསུམ་མོ་། དེའི་ཡུལ་ལ་གསུམ་རྣམས་ལ་ཞེས་པའི་ཚིག་རིག་པར་བྱའོ།",
    "ཏྲྀ་ཥུ་ནི་གསུམ་མོ།",
    "དེ་ལ་གཉིས་ལ་ནི་འཁྲིག་ཅེས་པ་ཕོ་མོ་དག་གི་ཚིག་སྟེ།",
    "སྦྲང་རྩི་ཅན་ཐམས་ཅད་གཉིས་སུ་མེད་ཅེས་པ་ལ་སོགས་པར་ཡང་ཐུན་མོང་དུ་བལྟས་ཤིང་།",
    "ཨརྡྷ་རཱ་ཏྲ་དང་ནི་ཤི་ཐི་དག་གཉིས་དག་གོ་ཞེས་པ་ལ་སོགས་པ་ནི་གྲངས་ཀྱི་ཁྱད་པར་ཐོས་པར་བྱེད་པ་ཉིད་ཡོད་དོ་ཞེས་པ་ཧ་ཅང་ཐལ་བ་མེད་དོ།",
    "དེ་ནི་མིང་གི་ལྷག་མའི་དོན་དང་ལྷག་མའི་རྟགས་ཡོངས་སུ་ཤེས་པར་བྱའོ།",
    "དྭེ་པ་ནི་གླིང་སྟེ་འདི་མོ་ཡིན་ཞེས་པ་ཨ་སྟྲི་ཡཾ་འོ།",
    "འདིར་མོ་བཀག་པས་ཕོ་དང་མ་ནིང་དུ་ཤེས་པར་བྱ་ཞིང་དེ་བཞིན་དུ་ཕོའི་རྟགས་ལ་སོགས་པ་བཀག་པ་ལས་ཡང་ངོ།",
    "དེ་ལ་མིང་གི་ཚིག་ནི་དཔེར་ན།",
    "བུ་མོ་དང་བྲན་བཟའ་དག་ཅེས་པ་འདིར་ཏུའི་སྒྲ་ནི་དབྱུག་པ་དང་འཁུར་བའི་རིགས་པས་བྱ་བའི་ཚིག་འདྲེན་ཏེ།",
    "དེ་དང་འབྲེལ་བའི་མིང་གི་ཚིག་ཉིད་ཀྱང་འདྲེན་པར་བྱེད་དོ།",
    "ཨ་ཐའི་སྒྲ་ནི་དེ་མ་ཐག་པའི་དོན་ཏེ་རང་གི་རྣམ་གྲངས་ཀྱི་མཚན་ཉིད་ཀྱི་ཕྱིར་ཨ་ཐའི་སྒྲ་དང་པོ་ཅན་ཡང་སྔ་མའི་ཆ་མ་ཡིན་ནོ།",
    "འདིར་བསྟན་། བཅོས་ཀྱི་བརྗོད་པར་བྱ་བ་ནི་ས་གསུམ་མོ།",
    "ཕྱོགས་ཀྱི་གོ་རིམས་དང་ངེས་པར་སྟེང་གི་ཕྱོགས་ནམ་མཁའ་དང་དེའི་བདག་པོ་རྒྱུ་སྐར་གྱི་བདག་པོ་ཟླ་བ་དང་།",
    "གྲོང་གི་གོ་རིམས་ངེས་པར་གྲོང་རྡལ་དང་།",
    "རྔོན་པའི་གནས་ཀྱང་གྲོང་གི་བྱེ་བྲག་ཏེ།",
    "ཡན་ལག་གི་དོན་རྣམས་ཀྱང་རིམ་པས་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་རྣམས་ལ་དའི་ལ་སོགས་པའི་འདུ་བྱེད་ཀྱི་རྒྱུ་ཨི་ཡམ་ཞེས་པས་དོན་གསལ་བར་སྟོན་པར་བྱེད་པ་ནི་བུད་མེད་དོ།",
    "དེ་ལ་འདི་རྣམས་ནི་མ་ནིང་གི་རྟགས་ཏེ།",
    "དེ་རྣམས་ལ་གཅིག་གི་འདུ་བྱེད་པའི་རྒྱུ་ནི་ཤུདྡྷཾ་སྟེ།",
    "མོ་དང་ཕོ་དང་མ་ནིང་གི་རྟགས་སོ། ། གཉིས་ཀྱི་འདུ་བྱེད་ཉེ་བར་སྨོས་པ་ནི་མི་ཤྲཾ་སྟེ།",
    "དེ་ལ་མཚན་མོའི་རྣམ་གྲངས་བརྗོད་པ་ནཀྟཾ་གྱི་སྒྲ་ཡང་སྟེ་འདིར་བརྗོད་པ།",
    "གོ་རོ་ལས་རང་གི་དོན་ལ་ཞེས་པས་གོའི་སྒྲས་ཉེ་བར་མཚོན་པའི་ཕྱིར་དཡོ་ལས་ཀྱང་ཨོ་ཉིད་དོ།",
    "གཞིའི་སྒྲ་ལ་པིཥྚ་ཡ་ཞེས་པ་ཡང་སྐྱེས་པ་དང་མ་ནིང་གི་རྟགས་ཉིད་ཀྱི་ཕྱིར་དྲུག་པའི་བསྡུ་བ་དང་།",
    "འདི་ཉིད་མ་ནིང་གི་ཚིག་ཏུ་ཤེས་པར་བྱེད་པ་ཡང་།",
    "འདི་ལ་སྐྱེ་བ་དང་གནས་པ་དང་འཇིགས་པའི་བདག་ཉིད་ཡོད་པས་སྐབས་གསུམ་མོ།",
    "ལྷ་མོ་དཔལ་མོ་བྱུང་བ་ཁྱབ་འཇུག་གིས་ཁྱེར།",
    "ལྷའི་སོར་མོ་ལ་སོགས་པའི་ཚིགས་རྣམས་མཛེས་པས་ན་ཚིགས་བཟང་ངོ།",
    "རྐང་པ་རྣམས་ལ་བཀྲ་ཤིས་པའི་རི་མོ་ཡོད་པས་ལེགས་བྲིས་སོ།",
    "འདི་རྣམས་ཁྲོས་པའི་དམོད་པའི་མཚན་ཉིད་ཅན་གྱི་ཚིག་ནི་མདའ་སྟེ་མདའི་བྱ་བ་བྱེད་པའི་ཕྱིར་ཚིག་མདའོ།",
    "དེ་འདིའི་ལྷ་ཞེས་པས་ཚིག་ཕྲད་ལས་དེ་བ་ལས་རང་གི་དོན་ལ་ཏ་ལའོ།",
    "ཏལ་ལ་ཨཱི་ཏ་ཨཱུཏ་ལས་ཀྱང་ངོ་ཞེས་པས་བུད་མེད་ཉིད་དོ།",
    "རང་གི་དོན་ཅན་གྱི་རང་བཞིན་ལས་རྟགས་རྣམས་ཨ་བ་ལ་རྗེས་སུ་མི་འཇུག་ཅེས་པས་སྐྱེས་པ་དང་མ་ནིང་ཉིད་དོ།",
    "དེ་ལ་ཉི་མའི་ཉའ་སོ་རང་རང་གི་མིང་རྣམས།་",
    "རབ་ཏུ་བྱེད་པ་མ་ལུས་པ་འགྲེལ་བར་བྱེད་པའི་ཕྱིར་དང་མིང་གི་གཙོ་བོ་གཞན་མ་ཡིན་པའི་ཕྱིར་སརྦ་ལ་སོགས་པའི་བྱ་བ་རྣམས་མི་འགོག་གོ་ཞེས་རྟོག་པར་བྱེད་དོ།",
    "ཕྲེང་ཆེན་ཞེས་པ་འདི་རྣམས་ཀྱི་གྲལ་བསྒྲིགས་པ་སྟེ་ཐུན་མོང་བའི་སྒྲུབ་པ་ལས་མིང་ལ་ཡང་ཡཱ་བ་སོགས་རྣམས་ལས་ཀ་ནའོ།",
    "མཁའ་སྤྱོད་བདེན་དང་ལང་ཚོ་ཅན།",
    "ཆུ་སྐྱེས་ནི་ལྷའི་བཙུན་མོ་སྟེ་ལྷའི་སྨད་འཚོང་ཨུརྦ་ཤི་ལ་སོགས་པའོ།",
    "ཚིགས་སུ་བཅད་པ་གཅིག་གིས་ལྷ་མ་ཡིན་གྱི་མིང་སྟེ།",
    "སྔོན་དྲང་སྲོང་གསལ་བ་ཞེས་བྱ་བ་ལ་མི་སྦྱིན་དང་སྦྱིན་མ་དང་ད་ནུ་ཞེས་བྱ་བ་ལ་སོགས་པ་བུ་མོ་བཅུ་གསུམ་ཡོད་པ་ལས་དི་ཏི་སྟེ།",
    "སྦྱིན་སྐྱེས་དང་སྦྱིན་བྱུང་ཞེས་པ་ལ་སོགས་པའི་ལྷ་མ་ཡིན་གྱི་མིང་གི་དབྱེ་བ་ནི་མིང་ལས་དྲངས་པའི་ཁྱད་པར་ཏེ།",
    "སུ་ལ་སོགས་པ་རྣམས་སརྦ་ནཱ་མའི་གནས་ལ་མ་ཡིན་པས་རང་བཞིན་གྱིས་དེ་རྣམས་ཚིག་གི་མིང་ཅན་ནོ།",
    "དག་གི་དང་པོའི་འོ་ཞེས་ཚིག་དང་པོའི་ཥྚུ་ཉིད་དགག་པ་བྱས་པས་ན་སུ་པ་ཀྱི་པ་ཡིག་ཥྚུ་ཉིད་མི་ཐོབ་ན།",
    "བརྩོན་འགྲུས་ལ་སོགས་པའི་ཡོན་ཏན་རྣམས་ཀྱིས་འཇིག་རྟེན་ལ་ཕན་པའི་རྣམ་པ་དེ་དག་གིས་གཤེགས་པས་ན་དེ་བཞིན་གཤེགས་པའོ།",
    "ཤཱཀཱི་ཤིང་གིས་ཁེབས་པ་ཡི།",
    "དེའི་ཚེ་ཨ་ཏྲི་རྒྱུན་ཤེས་དང་བཧྲྀ་གུ་ངན་སྤོང་ལ་སོགས་པ་མང་པོ་ལ་བུད་མེད་མིན་པ་ལ་འཇིགས།",
    "ཨུཏྤ་སོགས་ལ་ཨ་ཉ་དང་ཨ་ཉ་དང་ཨི་ཉ་རྣམས་མང་པོ་རྣམས་ལ་བུད་མེད་མིན་པ་ལ་ཞེས་པས་འཇིགས་པས་ཞེས་སོ།",
    "ཉི་མའི་གཉེན་དང་ལྷ་མོ་སྒྱུ་འཕྲུལ་སྲས་རྣམས་ཏེ་རྒྱས་པར་ལུང་ལས་ཤེས་པར་བྱའོ།",
    "དེ་ནི་ཚངས་པ་ཞེས་བཏགས་ཏེ་དེའི་ལུས་ཀྱི་ཚད་ཁྱབ་འཇུག་གིས་སྟེང་ནས་མར་བལྟས།",
    "གདོང་བཞི་ནི་ཚངས་པས་ཐིག་ལེ་མཆོག་མ་ཞེས་པའི་བུ་མོ་ཞིག་སྤྲུལ་པས་དེ་ལ་རང་ཉིད་ཆགས་ཏེ།",
    "བུ་མོ་དེ་། གཡས་གཡོན་ལ་སོགས་པའི་ཕྱོགས་བཞིར་སོང་བ་ལ་བལྟས་པ་ས་གདོང་བ་བཞི་བྱུང་ངོ།",
    "སྟེང་གི་ཕྱོགས་སུ་སོང་བ་ལ་བལྟས་པས་སྟེང་གི་གདོང་བ་དང་ལྔ་བྱུང་སྟེ།",
    "ཁྱབ་འཇུག་གི་ལྟེ་བའི་པདྨ་ལས་བྱུང་བའི་ཕྱིར་འདི་ལ་པདྨའི་སྐྱེ་གནས་ཅན་ཞེས་བྱའོ།",
    "ཉེས་ཅན་ནི་རང་གིས་སྤྲུལ་པའི་བུ་མོ་ལ་ཆགས་པས་ན་སྟེང་གི་གདོང་པ་ཡང་བཅད་དེ་དེས་ན་ཉེས་ཅན་ཏེ།",
    "པྲྀ་ཥོ་ད་ར་དྲུ་ཧི་ཌ་ལ་སོགས་པ་ཉིད་ཀྱི་ཕྱིར་ཨ་ཡིག་གི་ཨི་ཉིད་དང་ནུ་མ་ཨཱ་ག་མ་ཡང་ངོ་། བི་རིཉྪ་ཞེས་པ་སྣ་ཚོགས་སྐྱེད་པར་བྱེད་པས་སྣ་ཚོགས་སྒྲུབ་བྱེད་དོ།",
    "ཏྲི་ཙ་ལ་སྲྀ་ཛི་དྲི་ཤ་དག་གི་ཛྷ་ལ་ལ་ཨ་མའོ།",
    "སྣ་ཚོགས་བྱེད་ནི་ལྷ་ཚངས་པས་བསྐལ་པ་འཆགས་པའི་དུས་སུ་སྐྱེ་བོ་གཞན་ཡང་བདག་གིས་བསྐྱེད་པར་བྱའོ་སྙམ་དུ་བསམས་པ་ལས་བྱུང་བའོ།",
    "གང་དག་ནྱངྐུ་ལ་སོགས་པར་སྲྀ་ཛི་མི་འདོད་པ་དེ་དག་གི་ལུགས་ལས་ཥ་ཉིད་དོ།",
    "རྟུལ་མོའི་བུ་ནི་མའི་མིང་ལས་ཏེ་བི་ཀུཎྛ་ཞེས་པའི་མ་ལས་སྐྱེས་པས་ན།",
    "མེ་ཏོག་ལྟོ་ནི་ལྷ་མོ་གྲགས་མ་ཞེས་བྱ་བ་ཁྱབ་འཇུག་གི་ཆུང་མའོ།",
    "སྐྲ་ཅན་གསོད་ནི་ལྷ་མ་ཡིན་སྐྲ་ཅན་ཞེས་བྱ་བ་ཁྱབ་འཇུག་གིས་བསད་དོ་ཞེས་གྲག་གོ།",
    "གང་ཕྱིར་ཁྱོད་ཀྱིས་སྐྲ་ཅན་བསད།",
    "དེ་ཕྱིར་བདག་གིས་བསྟན་པ་ཐོས།",
    "བྱུང་བ་མིང་གི་བསྙད་པ་ཉིད།",
    "སྐྱེ་བོ་། རྣམས་རང་གིས་བསད་ཅིང་འབྱིན་པའི་ཕྱིར་ན་བདག་སྐྱེས་སོ།",
    "ཀླྀ་སྐླྀ་ལས་རང་གི་ཡན་ལག་ལ་ཥ་ཙའོ།",
    "རྭ་གཞུ་ཞེས་པ་ཁྱབ་འཇུག་གི་གཞུ་སྟེ་དེ་དང་ལྡན་པས་ཨི་ནའོ།",
    "བིཥུའི་སྒྲ་ལས་མང་པའི་ཚིག་གི་དོན་རྣམས་རྒྱས་པས་མི་ཟད་པའོ།",
    "ཁྱབ་འཇུག་གི་ལྟེ་བ་ནི་པདྨའི་ལྟེ་བ་སྟེ།",
    "གནས་གང་དང་གང་ཡིན་པ་ཐམས་ཅད་ཁྱབ་འཇུག་གིས་ཁྱབ་པས་འདུག་གནས་ལྷ་སྟེ་མང་པོ་ལ་ཀྲྀ་བཱ།",
    "ལྷ་མ་ཡིན་སྟོབས་ལྡན་ལ་ཁྱབ་འཇུག་གིས་མིའུ་ཐུང་གི་གཟུགས་སུ་བྱས་ཏེ་ས་གཞི་གོམ་པ་རེ་བླངས་པས་གསུམ་ཡང་ཁྱེར་ཟེར་བས་ལུས་བསྐྱེད་དེ་རི་རབ་དང་རྒྱ་མཚོའི་མཐིལ་ལ་རྐང་པ་གཉིས་གཞག་ནས་གཅིག་གིས་ས་མེད་པས་སྟོབས་ལྡན་གྱི་མགོ་ལ་བཞག་གོ།",
    "ལྷ་མོ་དགའ་བྱེད་ཅེས་བྱ་བ་ཁྱབ་འཇུག་གི་མའི་མིང་གིས་བཏགས་ཏེ།",
    "དེ་བི་ཀི་ལྷ་མོ་སྟེ་དེ་དགའ་བར་བྱེད་པ་ནི་དེའི་བུའོ།",
    "དཔའ་བོའི་རྒྱུད་ནི་ཁྱབ་འཇུག་གི་མེས་པོའི་རྒྱུད་ལ་དཔའ་བོ་ཞེས་བྱ་བ་བྱུང་བས་དེའི་བརྒྱུད་པའོ།",
    "སྐྱེས་བུའི་མཆོག་ནི་བདག་ཡིན་ཏེ་དེས་ན་མཆོག་གི་བདག་ཉིད་ཀྱི་ཕྱིར་སྐྱེས་བུ་མཆོག་ཅེས་བྱའོ།",
    "དེ་ལ་དེ་དག་གིས་ཉེ་བར་མཚོན་པ་དང་ཉེ་བར་སྤྱོད་པ་ལས་དཔལ་བེའུ་མཚན་པ་ཞེས་སོགས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "དེ་རྣམས་ཀྱིས་ཁྱབ་འཇུག་གི་མིང་གི་རྣམ་གྲངས་སོ།",
    "ཨཎ་ཀའི་རྔ་ཅན་ནོ་ཞེས་ཕ་རོལ་མོའི་བཟོ་ཁྱད་པར་ཕུལ་དུ་བྱུང་བ་ཤེས་པ་སྟེ།",
    "ཁྱབ་འཇུག་གི་ཕའི་མིང་ངོ།",
    "ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱིས་སྟོབས་བཟང་སྟེ་ཁྱབ་འཇུག་གི་ཕུ་བོ་ཡིན་ནོ།",
    "རེ་བ་ཏཱི་དེས་ཉེ་བར་མཚོན་པ་དང་ཟླ་བ་དང་ལྡན་པའི་དུས་སུ་སྐྱེས་པས་ན་ནམ་གྲུ་སྐྱེས་ཞེས་བྱའོ།",
    "ཏཱ་ལ་ནི་ཤིང་གི་ཁྱད་པར་ཏེ།",
    "མྱོས་བྱེད་ཅེས་པ་ནས་ཚངས་སྤོང་ཞེས་པའི་མཐར་ཐུག་པ་ཁྱབ་འཇུག་གི་བུ་འདོད་པའི་མིང་ངོ།",
    "ཚངས་འཇོམས་ནི་ཚངས་པ་ཡང་ཀུན་ཏུ་རྨོངས་པའི་མཚོན་ཆས་རང་གི་སྤྲུལ་པའི་བུ་མོ་ལ་ཆགས་པར་གྲག་གོ།",
    "ཀ་མི་ཨ་མི་ཙམ་རྣམས་ཀྱི་མ་ཡིན་ནོ་ཞེས་པས་མེད་དོ།",
    "རང་གི་ཡིད་ལ་དྲན་པའི་ཕྱིར།",
    "རལ་གྲིའི་མཚོན་ཆ་ནི་མ་འགགས་པ་སྟེ་དེ་བཞིན་དུ་ཨེ་བརྵྱ་ཀེ་ཏ་ན་ཞེས་པ་ཡང་ལུང་ལས་སོ་ཞེས་པས་རྀ་ཤྱའི་སྒྲའི་རེ་ཕ་དང་པོ་དབྱངས་དང་པོ་ཡང་ངོ།",
    "ཨུཥཱ་ནི་ལྷ་མ་ཡིན་མདའ་ཞེས་བྱ་བའི་བུ་མོའོ།",
    "མཚོན་བྱེད་ཅེས་པ་ནས་འཕྲོག་བྱེད་ཡུམ་ཞེས་པའི་བར་གྱིས་ཁྱབ་འཇུག་གི་ཆུང་མའོ།",
    "ཀྱེ་དཔལ་མོ་ཞེས་བརྗོད་པ་འདི་ནི་འདིར་འགྱུར་ཏེ།",
    "དཔལ་མོའི་བདག་པོའི་དུང་དང་འཁོར་ལོ་དང་བེ་ཅོན་དང་རལ་གྲི་དང་ནོར་བུ་རྣམས་རིམ་པ་ཇི་ལྟ་བར་ལྔ་སྐྱེས་ལ་སོགས་པའི་མིང་ཅན་ནོ།",
    "ཁྱབ་འཇུག་འདིའི་དབྱུག་པ་ནི་སའི་ནང་དུ་ཞུགས་པས་ས་རྣམས་དགའ་བར་བྱེད་པས་ནས་མོས་ཏེ།",
    "ལྷག་མ་ཀོ་མོ་ད་ཀ་ལ།",
    "ཥྚུ་བྷ་རེངས་པ་ལའོ།",
    "ས་རྣམས་རེངས་པར་བྱེད་པས་ན་ས་རེངས་བྱེད་དེ་འཕྲོག་བྱེད་དོ།",
    "དེ་རྣམས་ཁྱབ་འཇུག་གི་རྟགས་རྣམས་སོ།",
    "ཚིགས་སུ་བཅད་པ་གཅིག་གིས་བྱ་ཁྱུང་གི་མིང་ངོ།",
    "དེ་གཉིས་རྒྱལ་བྱས་ཏེ་གང་བདེན་པས་རྒྱལ་པོའི་བཙུན་མོ་བྱེད་པར་བྱས།",
    "མི་བདེན་པས་གཡོག་མོ་བྱེད་པར་བྱས་ནས་བལྟ་བར་བྱའོ།",
    "ཁྱོད་ཀྱིས་ཉི་མའི་རྟ་ནག་པོར་མཐོང་བར་གྱིས་ཤིག་དེ་ལྟར་མ་བྱས་ན་ཁོ་མོ་གཡོག་བྱ་དགོས་པར་ཡོད་དོ་བྱས་པས་དེས་ཁས་བླངས་སོ།",
    "འདིས་ཁྱོད་ལ་ཕན་པར་འགྱུར་གྱི་ཞག་བདུན་མ་བརྟོལ་ཅིག་ཟེར་རོ།",
    "དེ་རིངས་ཏེ་ཉི་མ་གསུམ་། ན་གཅིག་བརྟོལ་བ་ན་གློག་ཏུ་གྱུར་ཏེ་ནམ་མཁའ་ལ་སོང་ངོ།",
    "ཡང་དྲུག་ན་གཅིག་བརྟོལ་བ་དང་སྐར་མ་སྐྱ་རེངས་སུ་སོང་།",
    "བདུན་པ་ན་གཅིག་བརྟོལ་བ་དང་བྱ་ཁྱུང་དུ་སོང་སྟེ་མ་ལ་ཕྱག་བྱས་ཏེ་ཁྱོད་ཀྱི་བྱ་བ་གང་དགོས་པ་བདག་གིས་བྱའོ་ཞེས་ཟེར་རོ།",
    "དེ་ནས་ཀླུ་རྣམས་བྱ་ཁྱུང་གིས་ཟ་བར་བྱེད་དོ།",
    "ཁྱབ་འཇུག་གི་ཤིང་རྟ་ནི་བྱ་ཏྲི་ཏྲིའི་སྒོ་ང་རྒྱ་མཚོའི་འགྲམ་ན་ཡོད་པ་ཆུའི་རླབས་ཀྱིས་མཚོ་ནང་དུ་སོང་ངོ།",
    "དྲང་སྲོང་ཅིག་ན་རེ་དུང་འགྲོ་ནི་མཐུ་ཆུང་བ་ཟེར་བས།"
  ]
}