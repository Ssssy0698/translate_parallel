    "ཁྱད་པར་ལས་ཀྱི་སྦྱིན་སྲེག་ཀྱང་།",
    "ཏ་འབར་བའོ། ། རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་བཞི་སྒྲུབ་པའི་བུམ་པའི་ཆོ་ག་། རྒྱ་གར་སྐད་དུ།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་བཞི་སྒྲུབ་པའི་བུམ་པའི་ཆོ་ག།",
    "ལས་མཐུན་གནས་སུ་བརྩམ་པར་བྱ།",
    "རང་ལྷའི་བསམ་གཏན་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་བཞི་སྒྲུབ་པའི་བུམ་པའི་ཆོ་ག་༡ ༡༧༩ལྡན་པ་ཡིས།",
    "བུམ་པར་ལས་མཐུན་ལྷ་ིབསྐྱེད་དེ།",
    "འོད་ཟེར་བསིལ་བ་རྣམ་པར་སྤྲོ།",
    "དཔལ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་བཞི་སྒྲུབ་པའི་བུམ་པའི་ཆོ་ག།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་བཞི་སྒྲུབ་པའི་འཁོར་ལོའི་ཆོ་ག།",
    "སླར་ཡང་རྩིབས་བརྒྱད་གཉིས་པར་ལྡན།",
    "ཙུ་རུ་ཙུ་རུ་ཙཎྜ་ཀཱི་ལི་ཀཱི་ལཱ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་བཞི་སྒྲུབ་པའི་འཁོར་ལོའི་ཆོ་ག་༡༡༨ ༣ཡ་སྭཱ་ཧཱ།",
    "རིམ་པ་བཞི་པར་བྲི་བའི་སྔགས་རྣམས་སོ།",
    "དེ་ལས་བཟློག་པར་ཤེས་པར་བྱ།",
    "ཞི་ལ་གཙང་མའི་རས་དཀར་རམ།",
    "དེ་ལས་བཟློག་པར་ཤེས་པར་བྱ།",
    "ཨུ་གླུ་ཚོ་ལྷོནག་པོ་རྣམ་པར་ཚར་གཅོད་པའོ།",
    "དཔལ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་བཞིའི་འཁོར་ལོའི་ཆོ་ག།",
    "རྡོརྗེ་རྣམ་པར་འཇོམས་པའི་ལས་བཞི་སྒྲུབ་པའི་འཁོར་ལོའི་ཆོ་ག་༡༡༨ ༥པ་གསལ་བར་བྱ།",
    "ལོ་བར་ལོའི་། རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་སྒྲུབ་པའི་ཐབས་ཀྱི་ཆོ་གཁོད་། རྒྱ་གར་སྐད་དུ།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་སྒྲུབ་པའི་ཐབས་ཀྱི་ཆོ་ག།",
    "རྟོགས་པའི་རིམ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་སྒྲུབ་པའི་ཐབས་ཀྱི་ཆོ་ག་༡ ༡༨ ༧པ་གསལ་བར་བྱ།",
    "དེ་ནས་གཞན་དུ་ལོངས་མ་སྤྱད་པའི་མེ་ཏོག་སྔོན་པོ་དཀར་གསུམ་དང་མངར་གསུམ་གྱིས་རྣམ་པར་སྦགས་ལ།",
    "གང་ལ་བསྙེན་པ་བྱས་པའི་སྔགས་ཀྱིས་ཐབ་ཏུ་དབུལ་ཞིང་བསྲེག་པར་བྱའོ།",
    "རིམ་པ་འདིས་བསྙེན་པ་ཇི་ཙམ་དུ་བྱས་པའི་གྲངས་ཀྱི་བཅུའི་ཆའི་སྦྱིན་སྲེག་ཡོངས་སུ་རྫོགས་པར་བྱས་ན་རིག་སྔགས་ཀྱི་ལས་གང་སྒྲུབ་ཀྱང་མཐུ་ཐོགས་པ་མེད་པར་འགྱུར་རོ།",
    "ཐོགས་པ་མེད་པར་བྱེད་པའོ།",
