    "དཔལ་ལྡན་ཤྲཱི་༩ མཾ་དེ་བཞིན་ངེས་པར་སྦྱར།་།",
    "གྱུར་ལ་སམྦ་ཏི་ཡང་ངེས་པར་བྱ།",
    "རྣལ་འབྱོར་གཙང་སྦྲ་ལྡན་པས་བསྒྲུབས་ན་འགྲུབ།",
    "དེ་མིན་བྱས་ན་ལྷ་ནི་མི་འགྲུབ་པས།",
    "དེ་ཕྱིར་ལུས་ངག་བྱ་བ་དག་ལ་འབད་པར་བྱ།",
    "ཎ་༡༢ ༣ ༥སློབ་དཔོན་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་མན་ངག་ལས་ཀྱི་ཐབས་ཞེས་བྱ་བ།",
    "སྣར་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་ཀྱི་ཐབས་ཞེས་བྱ་བའི་མན་ངག་བཞུགས་སོ།",
    "འཕགས་པ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་ཁྲུས་ཀྱི་ཆོ་ག་དང་།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་རིག་སྔགས་ཀྱི་ཆོ་གས་གྲོལ་བར་གྱུར་ཅིག།",
    "དེའི་ཕྱིར་དེ་དག་རྣམ་པར་དབྱེ་བའི་རིམ་པ་བརྩམ་པར་བྱའོ།",
    "དེའི་ཕྱིར་རྡོ་རྗེའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ་ཞེས་བྱ་བ་ཡང་།",
    "རྩེ་གཅིག་ཏུ་མཉམ་པར་གཞག་པའི་གནས་སྐབས་ལ་བྱ་བར་མངོན་ནོ།",
    "ཕྱི་དང་ནང་ནས་བགེགས་དང་ལོག་འདྲེན་རྣམ་པར་ལྟ་བའི་རྒྱུ་ལས་ཀྱི་བག་ལ་ཉལ་དང་།",
    "རྨུགས་པར་བྱེད་པའི་ཞེས་བྱ་བའི་བར་དུ་ཚིག་དོན་བཅོ་ལྔས་བསྟན་ཏེ།",
    "ཞི་དང་འཕགས་པ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་ཁྲུས་ཀྱི་ཆོ་ག་༡༢ ༣༩རྒྱས་དང་དྲག་སྤྱོད་དང་།",
    "ཅི་རིགས་པར་ནི་སྦྱར་བར་བྱ།",
    "སྤྱི་འཇོམས་པར་མཛད་པའི་ཕྱིར་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱའོ།",
    "དེ་ནས་གསང་སྔགས་ཀྱི་ཚིག་གང་དག་གསུངས་པ་དེ་དག་ཀྱང་ཡེ་ཤེས་དེའི་རྒྱུ་ལས་བྱུང་བའི་ཕྱིར་ཐོགས་པ་མེད་པ་རྡོ་རྗེའི་ཚིག་ཏུ་རིག་པར་བྱའོ།",
    "དེས་ནི་རབ་བཀྲུས་གཙང་མ་ཡིན།",
    "གཙང་མའི་གོས་ཀྱིས་རབ་བརྒྱན་ཏེ།",
    "ཞེས་བྱ་བ་ལ་ཤིན་ཏུ་ཁྲུས་བྱ་བ་དང་གོས་གཙང་མ་གྱོན་པ་ནི་ཕྱིའི་གཙང་སྦྲའོ།",
    "ཞེས་པའི་དོན་ནི་རིག་སྔགས་དེ་དག་ཡེ་ཤེས་ལས་བྱུང་བར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཞེས་གསུངས་པ་ལས་རིག་པར་བྱའོ།",
    "ཚོའཐས་པར་བཅགས་ལ་བའི་རྣམ་པ་ལྔ་དང་སྤོས་ཆུ་གཙང་མས་བྱུག་གོ།",
    "༢་༡ལ་རྩྭ་དྲུར་བ་དང་མེ་ཏོག་རྣམས་གཞུག་པར་བྱའོ།",
    "ལྡུམ་བུས་ཁ་བརྒྱན་རས་ཀྱིས་མགུལ་འཕགས་པ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་ཁྲུས་ཀྱི་ཆོ་ག་༡༢ ༤༡པ་དཀྲི།",
    "མཚན་ཉིད་གཞན་ནི་རྒྱུད་གཞན་དག་ལས་རིག་པར་བྱའོ།",
    "མགུལ་ཆིངས་ནི་གཙང་མའི་གོས་ཞེས་བྱ་བ་མ་སྤྱད་པ་མ་བབ་པའི་རས་དཀར་པོ་ཁ་ཚར་མ་ཉམས་པ་དང་བཅས་པའོ།་",
    "མཚམས་བཅད་པ་དག་བྱས་ནས།",
    "ཐིག་སྐུད་ལག་ཏུ་བླངས་ཏེ་ཕྱོགས་མ་འཁྲུལ་བར་བཅད་ལ་རིམ་པ་གསུམ་པར་ཐིག་གདབ་པོ།",
    "དེའི་ཕྱག་རྒྱ་ནི་ལག་པ་གཉིས་ཁུ་ཚུར་བཅངས་ལ་ཅུང་ཟད་བསྣོལ་བའི་ཚུལ་དུ་བྱས་ལ།",
    "ཡང་ན་དེ་རྣམ་པ་གཉིས་ཀ་གདོན་པར་མི་ནུས་ན་མཇུག་ན།",
    "དེ་ལྟར་བཟླས་བརྗོད་ཟིན་ནས་ཡོན་བདག་གསུམ་ལ་སྐྱབས་སུ་འགྲོ་བ་ོལ་སོགས་པ་བྱས་ཏེ།",
    "བདེ་བ་སྐྱེད་པར་བྱེད་པའོ།",
    "སྡུག་བསྔལ་ཐམས་ཅད་མེད་པར་བྱེད།",
    "བདེ་བ་སྐྱེད་པར་བྱེད་པ་ནི།",
    "དཔལ་ཀུན་གྱིས་ནི་ལེགས་པར་བརྒྱན།",
    "མཚོན་ལ་སོགས་པའི་འཇིགས་པ་ཐམས་ཅད་ལས་སྒྲོལ་བར་རིག་པར་བྱའོ།",
    "ནུའི་༧༣ ༡༡ ཏེ་འཕགས་པ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ཁྲུས་ཀྱི་ཆོ་ག་།",
    "སྣར་འཕགས་པ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ཁྲུས་ཀྱི་ཆོ་ག་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "འ་པེ་སྣར་པར་བྱ།",
    "འཕགས་པ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་ཁྲུས་ཀྱི་ཆོ་ག་༡༢ ༤༧༡༢༤༣༡སྣར་དང་མཐེའུ་ཆུང་གཉིས།",
    "སྣར་པར།",
    "༡ ཁོར་ལ་། ཁྲུས་ཀྱི་ཆོ་གའི་རིམ་པ་བཞུགས།",
    "རྗེས་མཐུན་ཕྲིན་ལས་ཁྱད་པར་གང་བསྒོ་བ།",
    "ཁྲུས་ཀྱི་ཆོ་གའི་རིམ་པ་བཞུགས།",
    "སྣར་ཁྲུས་ཀྱི་ཆོ་གའི་རིམ་པ་བཞུགས།",
    "དང་པེ་པར་བྱེད།་",
    "ཚུལ་ཁྲི་བ་སྤྲོདནས་། རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་མན་ངགདྲ་ཊ་ལོ་ཕྲ་ཏི་ཧ་ཏེ་། ། རྒྱ་གར་སྐད་དུ།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་མན་ངག།",
    "དེ་དག་ཀྱང་ཞི་བ་ལ་སོགས་པ་ཕྲིན་ལས་བཞིས་འགྲུབ་པར་འགྱུར་ལ་ཕྲིན་ལས་ཀྱང་སྒྲུབ་པ་པོ་ཚད་དང་ལྡན་པས་ཡིན་གྱི་གཞན་དུ་ན་དོན་མེད་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་མན་ངག་བར་བྱའོ།",
    "དེ་ཡང་ཞི་བའི་འཁྲུལ་འཁོར་ནི་དཀར་པོའི་ཕྱོགས་ཀྱི་ཚེས་གང་ཡང་རུང་བ་ལ་ིརས་སམ་ཤིང་ཤུན་ལ་སོགས་པ་རས་གཞི་དཀར་པོ་ལ་པདྨ་རྒྱས་པ་ལྟ་བུའི་རྩིབས་བརྒྱད་པའི་འཁོར་ལོ་གུར་གུམ་ལ་སོགས་པས་གཙང་སྦྲ་ལ་གནས་པར་བྲིའོ།",
    "དེ་ལྟར་གསོལ་བ་བཏབ་པས་བདག་དང་བསྒྲུབ་བྱ་ལ་བྱིན་གྱིས་བརླབས་ནས་འདི་ལྟར་འདོད་པ་གྲུབ་པར་བསམས་ཏེ།་",
    "སླར་ཡང་བཅོམ་ལྡན་འདས་འཁྲུལ་འཁོར་གྱི་ལྟེ་བ་ལ་བཞུགས་ཏེ་རྒྱུན་མི་ཆད་པར་བྱིན་གྱིས་བརླབ་པ་མཛད་པར་བསམས་ལ་སྤེལ་བ་དང་བཅས་པའི་བཟླས་པ་བབྱའོ།་",
    "ངདེ་ལ་འགོམ་པར་མི་བྱ་བ་ནི་དམ་ཚིག་གོ།",
    "ལས་གསུམ་དང་འབྲེལ་པའི་ཞི་བའི་འཁྲུལ་འཁོར་གྱི་རྣམ་པར་དབྱེ་བ་རྫོགས་སོ།",
    "དེ་ལ་འདིར་ཁྱད་པར་གྱི་གདམས་ངག་ནི་འདི་ཡིན་ཏེ།",
    "ལ་༡ འདོད་པ་ཐམས་ཅད་རབ་ཏུ་སྦྱིན་པ་ཞེས་པ་གསུངས་པའི་ཕྱིར་ན་ཡོ་བྱད་དོན་དུ་གཉེར་བས་ནོར་གྱི་བདག་པོ་ལ་བསྐུལ་བར་བྱའོ་། དེ་ཡང་འཁྲུལ་འཁོར་གྱི་སྦྱོར་བ་སྤངས་ནས་ཡན་ལག་བརྒྱད་དང་ལྡན་པའི་ཆུ་ལ་སྤོས་ལ་སོགས་པའི་དྲི་སྩལ་ཏེ་དངོས་སུ་འམ་བསམས་པས་རྣལ་འབྱོར་པས་ཡུད་ཙམ་གྱིས་རྣམ་པར་སྣང་མཛད་དུ་བསམས་ལ་མདུན་གྱི་ནམ་མཁའ་ལ་དེ་བཞིན་གཤེགས་པ་བསམ་ཞིང་དེ་བས་དམའ་བར་ཇི་ལྟར་འདོད་པའི་ནོར་གྱི་ལྷ་བསམས་ཏེ།",
    "དཔོན་ལག་ན་རྡོ་རྗེ་ཡིན་པས་འབངས་སམ་འཁོར་ཛམྦྷ་ལ་ལ་བཀའ་སྩལ་པ་ནི་མི་སླུ་བས་ན་སྔགས་པའི་འདོད་པ་ཐམས་ཅད་ཛམྦྷ་ལས་རབ་ཏུ་སྦྱིན་པར་འགྱུར་ཏེ་འདི་ནི་ངེས་པའི་འཁྲུལ་འཁོར་རྒྱས་པ་འདི་ནི་གནས་དབེན་པར་མཆོད་ཅིང་གཞག་པར་བྱའོ།",
    "མ་གྲུབ་པ་རྣམས་གྲུབ་པར་བྱེད་པ་དང་།",
    "གྲུབ་པ་རྣམས་ཆུད་མི་ཟ་བ་སྟེ་ཕྲིན་ལས་རྣམ་པ་བཞི་པོ་དེ་ནི་རྒྱས་པའི་འཁྲུལ་འཁོར་གྱི་ལས་སུ་རིག་པར་བྱ་བ་རྫོགས་སོ།",
    "འདོད་པའི་དོན་གྲུབ་ནས་ཧཱིནི་རང་ལ་བསྡུས་ལ་རང་ཡང་ཞུ་ནས་ཇི་ལྟར་འདོད་པའི་ཚུལ་དུ་གནས་པར་བྱའོ།",
    "སྔགས་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་མན་ངག་༡༢ ༥༧དེ་དག་ནི་མགོ་ནང་དུ་བསྟན་པས་སོ།",
    "ཚེ་བཅོམ་ལྡན་འདས་ནི་ཤིན་ཏུ་ཁྲོ་བར་བཞུགས་པ་ལ་གསོལ་བ་གདབ་པོ།",
    "རིག་སྔགས་གཅོད་པར་བྱེད་པ་ཞེས་བྱ་བའི་སྐབས་སུ་སྐུད་པ་སྔོན་པོ་ལ་སུམ་བསྒྲིལ་བྱས་ནས་སྔགས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ཏེ་རྡོ་རྗེ་ལྟ་བུའི་མདུད་པའམ་ལྕགས་སྒྲོག་གམ་ཞགས་པ་ལྟ་བུའི་མདུད་པ་དོར་ཞིང་།",
    "འདི་ནི་སྔགས་ཀྱི་ནུས་པའམ་ཆོད་གཏོར་ཉེ་བར་ཞི་བར་བྱེད་པ་སྟེ་མངོན་སྤྱོད་ཀྱི་ཁྱད་པར་རོ།",
    "དགྲའི་མངོན་སྤྱོད་ཀྱི་འཁྲུལ་འཁོར་རྣམ་པར་ཕྱེ་བའི་རིམ་པ་རྫོགས་སོ།",
    "རོ་རས་ལ་སོགས་པ་ལ་འཁྲུལ་འཁོར་གྲུ་གསུམ་སུམ་བརྩེགས་སུ་བྱས་ལ་གྲྭ་རྣམས་ལ།",
    "དེ་ནས་རབ་ཏུ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་མན་ངག་༡༢ ༥༩བསྒྲིམས་ནས་སྔགས་རིང་པོ་འབའ་ཞིག་བཟླས་པར་བྱ་སྟེ།",
    "སྔགས་ཀྱི་འོད་ཀྱིས་གང་ལ་བྱ་བའི་ལུས་ལ་ཕོག་པས་རབ་ཏུ་གཟིར་ཞིང་མི་བཟོད་པར་བསམས་ཏེ་དཔེར་ན་ལོ་ཐོག་ལ་སེར་བ་བབ་པ་ལྟ་བུར་དམིགས་ཤིང་ཁྲོས་པས་བཟླའོ་། ཟིན་པ་དང་ལས་ཀྱི་ཞབས་བསྲེག་པ་དང་།",
    "འདིས་གདོན་རླག་པར་བྱེད་པ་དང་།",
    "རྨུགས་པར་བྱེད་པའི་ལས་གཉིས་འགྲུབ་པོ།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་མན་ངག་པཎྜི་ཏ་སྨྲ་ཏི་ཛྙཱ་ན་ཀཱིརྟིས་མཛད་པ་རྫོགས་སོ།",
    "པེ་། རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་གཟུངས་ཀྱི་མན་ངག།",
    "སྣར་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་གཟུངས་ཀྱི་མན་ངག་བཞུགས་སོ།",
    "སྣར་བརླབས། པེ་པར།",
    "༧ པེ་བསྒྲིབ་པར་བྱའོ།",
    "སྣར་བསྒྲིམས་པར་བྱའི།་",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་མན་ངག།",
    "༡༢ ༦ ༡བ་བར་མ་ལ་པེ་སྣར་པར་བྱེད།",
    "༡༢༥༩༡ པེ་བྱས་ཏེ།",
    "པར་༢ ༡༩༩༥༡༩༨༢ བར་༢༡༣༡༣༤པ།",
    "ད་དང་། རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་འགྲེལ་པ་བཞུགས།་",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་འགྲེལ་པ།",
    "རྒྱུད་ལ་རྣམ་པར་གཞག་པ་དང་།",
    "མྱ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་འགྲེལ་པ་བཞུགས།",
    "༡ ༢ ༦༣ངན་འདས་བརྒྱད་ཕྱི་མ་ཞེས་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་དོན་ཡང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དེ་ལྟ་བུའི་རྒྱུད་དེ་ཡང་གདུལ་བྱའི་ཁྱད་པར་དང་།",
    "བརྗོད་བྱ་དོན་གྱི་ཁྱད་པར་གྱིས་རྣམ་པ་བཞིའོ།",
    "དེ་ལྟ་ན་རྒྱུད་ལ་ལ་ནས་རྒྱུད་ཕལ་ཆེར་གྱི་དོན་ཚང་བར་གསུངས་པ་ཡང་ཡོད་པས།་",
    "དེ་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལ་ཡང་དང་པོར་ངེས་པའི་དོན་བརྗོད་པར་བྱའི་ཡི་གེའི་དོན་བརྗོད་པ་ནི་སྒྲ་ཇི་བཞིན་དུ་འོག་ནས་བརྗོད་པར་བྱའོ།",
    "འོ་ན་དེ་བཞིན་ཉིད་ལ་ཁ་དོག་དབྱིབས་ལ་སོགས་པའི་རང་བཞིན་མེད་པས་ཇི་ལྟར་རྟོགས་པར་རུང་སྙམ་པ་ལ།",
    "རིམ་གྱིས་སྦྱངས་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་འགྲེལ་པ་བཞུགས།",
    "༡༢ ༦༥པ་ལས་ནམ་ཞིག་རྟོགས་པར་འགྱུར་བས་ན་དུས་ཅིག་ན་ཞེས་གསུངས་སོ།",
    "དེ་དང་མི་འགལ་བའི་ལས་སྤྱོད་པ་སྟེ་དེ་དག་དང་ལྡན་པ་ནི་བརྩོན་འགྲུས་ཀྱི་ཁྱད་པར་གྱིས་སྐྱེ་བ་གཅིག་གམ་གཉིས་ལ་སོགས་པ་ཅི་རིགས་པར་འདོད་པའི་འབྲས་བུ་ཐོབ་པར་འགྱུར་བས་འབྲས་བུ་བསྟན་པ་ནི་བཅོམ་ལྡན་འདས་ཞེས་གསུངས་ཏེ།",
    "དེ་ནི་ཐོབ་པར་འདོད་པའི་ཕྱིར་འབྲས་བུའོ།",
    "གནས་སྐབས་ཀྱི་འབྲས་བུ་ནི་དྲང་བའི་དོན་འཆད་པའི་སྐབས་སུ་བརྗོད་པར་བྱའོ།",
    "གཞན་ཡང་དེ་ལེགས་པར་རྟོགས་ཤིང་སེམས་དེའི་རང་བཞིན་ཁོང་དུ་ཆུད་པ་གོམས་པས།",
    "དེ་ལྟར་བཅོམ་པས་དཔལ་ཀུན་གྱིས་ནི་ལེགས་པར་བརྒྱན་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་ལ་བཞུགས་ཞེས་བྱ་བ་ནི་སྤངས་པ་དང་ཡེ་ཤེས་ཕུན་སུམ་ཚོགས་པའི་ངོ་བོ་ཉིད་ལས་མི་འགྱུར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "༡༢ ༦༧དབྱིངས་དང་ཡེ་ཤེས་དབྱེར་མེད་པ་ལས་མི་གཡོ་བ་ཚུལ་དུ་དོན་མཛད་ཅིང་བཞུགས་སོ་ཞེས་རིགས་པར་བྱའོ།",
    "རྡོ་རྗེ་ལ་བཞུགས་ཞེས་བྱ་བས་ནི་རྟག་པའི་མཐའ་བསལ་ཏེ།",
    "རྣམ་པར་སྨིན་པ་ལས་གྲུབ་པ་དང་།",
    "ཏིང་ངེ་འཛིན་གྱི་ལུས་ལ་ནི་ལུས་ཐམས་ཅད་ཅེས་གསུངས་སོ།",
    "རྡོ་རྗེའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ་ཞེས་བྱ་བ་ནི་ལག་ན་རྡོ་རྗེས་གདམས་པ་སྟེ་ལྷུར་བླངས་ཏེ།",
    "སྒྲུབ་ཅིང་གནས་པའོ་ཞེས་རིག་པར་བྱའོ།",
    "དེ་ལ་དང་པོ་ཕྱིའི་ཁྲུས་གྱིས་ནི་ལུས་དག་པར་བྱེད་ལ།",
    "གསང་བའི་ཁྲུས་ཀྱིས་ནི་སེམས་དག་པར་བྱེད་ལ།",
    "དེ་བཞིན་ཉིད་ལ་ཉེས་པའི་དྲི་མས་མ་གོས་པའི་རྟགས་སུ་མགུལ་ཆིངས་གོས་གཙང་མས་དགབ་ཅིང་གཞག་སྟེ་དེའི་ནང་དུ་སྐད་ཅིག་མས་སྐྱེད་པའི་ལྷའི་སྐུ་དང་།",
    "ཡོན་ཏན་དང་ས་མཚོན་པའི་ཕྱིར་རྫས་དེ་རྣམས་བུམ་པར་སྩལ་ལོ།",
    "སྔགས་པ་བདག་ཉིད་ཀྱང་ཡོན་ཏན་དེ་དག་ཐོབ་པར་བྱ་བའི་ཕྱིར་རྟག་ཏུ་ཡིད་ལ་དྲན་པའི་གཟུངས་ཐག་གདགས་པར་བྱ་སྟེ།",
    "རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་འགྲེལ་པ་བཞུགས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱི་བདག་ལུས་ཐམས་ཅད་རྡོ་རྗེ་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ་ཞེས་ལན་གསུམ་གསོལ་བ་གདབ་པར་བྱའོ།",
    "གསོལ་བ་བཏབ་པས་ལུས་རྡོ་རྗེར་བྱིན་གྱིས་བརླབས་པས་སྟོང་པ་ཉིད་དུ་གྱུར་པ་ལ་ཅུང་ཟད་སེམས་གནས་པར་བྱའོ།",
    "མདུན་གྱི་ཁམས་གསུམ་རྣམ་པར་དག་པའི་རང་བཞིན་བུམ་པའི་ནང་དུ་ཡང་ཡུད་ཙམ་གྱིས་རང་དང་མཐུན་པའི་སྐུ་བསྐྱེད་ལ།",
    "ཅེས་བསྟོད་པ་ཟིན་པ་དང་ལྷ་འོད་དུ་ཞུ་སྟེ་ཡེ་ཤེས་ཀྱི་བདུད་རྩིར་བསམས་ལ་བདག་དང་གཞན་ལ་ཁྲུས་བྱ་ཞིང་སྔགས་ཀྱི་མཐར་ཕྲིན་ལས་ཀྱི་སྤེལ་བ་དང་བཅས་པར་བཟླས་སོ།",
    "དེ་ནི་ཕྱིའི་ཁྲུས་ཏེ་ལུས་དག་པ་ཕུང་པོ་ལྷག་མ་མེད་པའི་ཉན་ཐོས་ཀྱི་འབྲས་བུ་ཐོབ་པར་འགྱུར་རོ།",
    "རང་ཉིད་ཟས་དཀར་གསུམ་ལ་སོགས་པ་གཙང་མ་ཟས་པ་ནི་ཆུའོ།",
    "གོས་གཙང་མ་བགོས་པ་ནི་མགུལ་ཆིངས་སོ།",
    "སྔགས་ནི་སྒྲ་མི་ཆེ་བར་བཟླས་པར་བྱ་སྟེ་རིག་སྔགས་ཞེས་བྱའོ།",
    "ས་དེ་ནས་གསང་བའི་ཁྲུས་བརྗོད་པར་བྱའོ།"
  ]
}