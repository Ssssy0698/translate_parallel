    "ཉིན་རེ་བཞིན་དུ་ཐོས་འཛིན་རྣ་བར་འཇེབས།",
    "རང་རེའི་རྡོ་སྣུམ་བཟོ་ལས་དཔྱིད་དུས་སུ།",
    "ང་ཚོ་མི་བོ་ཆེ་ཡི་གོམ་སྟབས་ཀྱིས།",
    "ཏང་གིས་ང་ཚོར་འགོ་ཁྲིད་མཛད་ནས་ནི།",
    "ང་ཚོའི་ལས་དོན་གྱི་འགོ་བརྩམས་མ་ཐག།",
    "ང་ཚོར་ལག་བརྡ་བྱེད་པའི་ཚུལ་དང་མཚུངས།",
    "ང་ཚོ་སྣུམ་འདོན་བཟོ་པའི་རྔུལ་ཆུ་དེ།",
    "ཙུང་ལིས་མཆོག་གི་གཟི་བྱིན་འབར་བའི་མི་ཉམས་མཛད་བཟང་གཞལདུ་དཀའ།",
    "གསེར་ལྡན་མ་ཡི་ཕྱོགས་མཚམས་ཀུན་ཏུ་དྲི་མེད་པུར་ཐལ་དྭངས་གཙང་གཏོར།",
    "སྐྱོ་ཞིང་གདུང་བས་མནར་བའི་མོད་ལ་དྭངས་གསལ་དུས་ཆེན་ངང་གིས་སླེབས།",
    "ཇི་སྲིད་བསྐལ་བརྒྱུའི་བར་དུ་གནས་པའི་གང་གི་མཛད་རྗེས་རླབས་པོ་ཆེ།",
    "གང་གི་སྒོ་གསུམ་མཛད་འཕྲིན་ངལ་བརྒྱས་གནག་སྣུམ་དབུ་ལྗོན་དཀར་པོར་གྱུར།",
    "མེས་པོའི་ཁབ་ཀྱི་རྨང་གཞི་སྐྲུན་མཁས་རྗེ་བོ་ཁྱོད་ཉིད་ཡིན་པས་ན།",
    "ཁྱོད་ཀྱི་ཤུལ་རྒྱུན་ཉམས་མེད་འཛིན་བྱེད་མི་རབས་ཕྱི་མ་ཁོ་ནར་ངེས།",
    "ངས་མེ་ཏོག་གསོ་རྒྱུ་དེ་འཚོ་བའི་ནང་གི་དགའ་ཕྱོགས་ཤིག་ཏུ་བརྩི་བཞིན་ཡོད་པས་མེ་ཏོག་ལེགས་ཉེས་ཆེ་ཆུང་སོགས་ལ་མ་ལྟོས་པར་བཞད་ཁ་ཕྱེས་པ་ཙམ་གྱིས་ཡིད་ལ་སྤྲོ་བ་ཆེན་པོ་སྟེར་གྱི་འདུག་ངའི་སྒོ་ར་ཆུང་ཆུང་དེའི་ནང་དུ་ནམ་དུས་དབྱར་ཁ་ཤར་དུས་མེ་ཏོག་གིས་ཁེངས་པས་བྱི་ལ་ཆུང་ཆུང་དེ་ཚོ་སྒོ་རའི་ནང་རྩེད་མོ་རྩེ་ས་མེད་སྟབས་ཐོག་ཁར་མི་འགྲོ་ཀ་མེད་རེད།",
    "མེ་ཏོག་དེ་རིགས་གསོས་ནས་གསོན་པ་ངོ་མ་ཁག་པོ་རེད།",
    "ང་ནི་མིག་ཆུ་ཡང་ཡང་གཏོང་འདོད་མི་འདུག་མེ་ཏོག་གསོ་མཁན་ཞིག་ལ་ཆ་མཚོན་ན་པེ་ཅིང་གི་གནམ་གཤིས་དེ་ཡག་པོ་རང་མ་རེད།",
    "ལ་ལ་སྐམ་པོར་མོས་པས་ཆུ་མང་པོ་རྒྱག་མི་རུང་།",
    "འདི་ནི་དགའ་བ་སྐྱེས་འོས་པ་ཞིག་རེད།",
    "ངས་ལས་དོན་སྒྲུབ་པའི་སྐབས་སུ་རྟག་ཏུ་ཡིག་ཕྲེང་འགའ་བྲིས་རྗེས་སྒོ་རའི་ནང་སོང་ནས་མེ་ཏོག་ལ་ཆུ་རྒྱུག་པ་དང་གནས་ས་སྤོ་བ་སོགས་བྱས་རྗེས་སྐྱར་དུ་ནང་དུ་ལོག་ནས་ཡིག་ཕྲེང་འགའ་བྲིས།",
    "ངལ་རྩོལ་མ་བྱས་ན་མེ་ཏོག་རྐང་གཅིག་ཀྱང་གསོན་པོར་གསོ་ཐུབ་རྒྱུ་ཁག་པོ་རེད།",
    "འོ་མ་སྐྱེལ་མཁན་གྱིས་ངའི་སྒོ་རའི་ནང་དུ་འཛུལ་མ་ཐག་དྲི་བསུང་ཞིམ་པ་ལ་ཞེས་བསྔགས་བརྗོད་བྱེད་ཀྱིན་འདུག་དེ་ནི་ང་ཚོ་ཁྱིམ་ཚང་གང་པོས་སྤོབས་པ་སྐྱེ་འོས་པ་ཞིག་ཡིན།",
    "མེ་ཏོག་ཨུ་དུམ་བཱ་ར་བཞད་པའི་དུས་སུ་གྲོགས་པོ་འགའ་གདན་དྲངས་ནས་བལྟས་ན་མཚན་མོ་སྒྲོན་མེ་ཐོགས་ཏེ་སྤྲོ་འཆམ་ལ་སོང་བའི་ཉམས་ཤིག་ལྷག་པར་མངོན་གྱི་འདུག་མེ་ཏོག་ཨུ་དུམ་བཱ་ར་ནི་ནམ་ཡིན་ཡང་མཚན་དུས་སུ་གེ་སར་ངོམ་གྱིན་ཡོད།",
    "མེ་ཏོག་གི་རྩ་བ་གཏིང་དུ་ཚུགས་ཏེ་སྡོང་རྐང་གཅིག་ནས་མང་པོར་རྒྱས་པའི་སྐབས་སུ་ངས་གྲོགས་པོ་ཚོར་སྡོང་རྐང་འགའ་ཤས་འབུལ་གྱི་ཡོད།",
    "ཁོང་ཚོས་ངའི་ངལ་རྩོལ་གྱི་འབྲས་བུ་འཁྱེར་བ་མཐོང་དུས་སེམས་སུ་དགའ་ཚོར་བརྗོད་ཀྱིས་མི་ལང་བ་ཡོང་གི་འདུག་སེམས་སྐྱོ་བའི་སྐབས་ཀྱང་ལོས་ཡོད།",
    "མེ་ཏོག་ཨུཏྤལའི་སྡོང་སོན་སྣ་ཁ་སུམ་ཅུ་ལྷག་ཙམ་གྱི་སྡོང་རྐང་བརྒྱ་ལྷག་གྱང་རྡིབ་འོག་ཤོར་སོང་བས་ཉིན་ཤས་ནང་མི་ཚང་མའི་ངོ་གདོང་ལ་འཛུམ་མདངས་ཀྱང་མེད་པར་གྱུར།",
    "སྙན་ངག་གི་རྦ་རླབས།",
    "ང་རང་རྩྭ་ཐང་གི་འདྲུད་འཐེན་འཁོར་ལོ་ཀྲན་ལ་འཚམས་འདྲིར་ཆས་རྒྱུ་ཡིན།",
    "སྐད་ཅིག་དེ་ཉིད་ལ་བདག་གི་ཁྲ་ཆུང་མིག་ལམ་དུ་ཤར་བྱུང་།",
    "གཉིད་ལྕོག་ཞིམ་པོ་ནི་བར་མེད་དུ་རྒྱག་པར་བྱེད་མོད་ཀྱི།",
    "དཔྱིད་ཀའི་རྩྭ་ཐང་གི་ཡུལ་ལྗོངས་ལྟ་ན་སྡུག་པ་དེས།",
    "རྩྭ་ཐང་གི་ཕྱོགས་ཀུན་ཏུ་དཔྱིད་དཔལ་གྱི་དགེ་མཚན་གྱིས་ཁྱབ་འདུག་ནམ་མཁའི་དབྱིངས་སུ་སྤྲིན་པ་བྱིའུ་མགོ་ཙམ་ཡང་མི་སྣང་ལ།",
    "བྱིས་པ་དག་གི་མིག་འབྲས་ཇི་བཞིན་གསལ་ཞིང་དྭངས་པའི་སྣང་བའང་བཅོས་མིན་དུ་སྟེར་བར་བྱེད་དོ།",
    "ང་ཁོ་མོའི་གམ་དུ་བཅར་ནས་ལམ་དྲིས་པ་ལ།",
    "ཁོ་མོས་དྲིལ་ཆུང་དཀྲོལ་བ་ལྟ་བུའི་ངག་སྒོ་ཕྱེས་ཏེ་ན་རེ།",
    "འདི་ནས་མཚེའུ་ཞིག་དང་རི་ཆུང་ཆུང་གཉིས་བརྒྱུད་དེ་སོང་ན།",
    "མ་གཞི་དེ་ནི་ང་རང་འགྲོ་ས་དེ་རེད།་",
    "རྩྭ་ཐང་དུ་ངས་ལོ་མང་པོར་འཚོ་བ་རོལ་མྱོང་མོད།",
    "རྩྭ་ཐང་གི་འདྲུད་འཐེན་འཁོར་ལོའི་ཀྲན་ལ་ཆས་པ་ནི་ཐེངས་དང་པོ་ཡིན།",
    "ས་ཆ་མེད་ཅིག་ལ་འགྲོ་ཐེངས་རེར།",
    "དུས་ནམ་ཡིན་ཡང་བདག་གི་སེམས་ལ་ས་དེ་ཅི་ལྟ་བུ་ཞིག་ཡིན་པ་དང་།",
    "སྤྱིར་བཏང་གི་གོམས་སྲོལ་ལྟར་ངས་དཔལ་ཞེས་པའི་ཡིག་འབྲུ་འདིར་དཔགས་ན།",
    "ངས་ཁོ་ནི་ལུས་ཀྱི་སྟོབས་དར་བའི་ལོ་སུམ་ཅུའི་ནང་གི་མི་ཞིག་ཡིན་རྒྱུ་རེད་བསམས།",
    "རྫི་མོ་དེས་བསྟན་པའི་ལམ་ལ་ཞུགས་ནས་ང་རང་འདྲུད་འཐེན་འཁོར་ལོའི་ཀྲན་དུ་སླེབས་པ་དང་།",
    "ས་འདི་ནི་ངོ་མ་རྩྭ་ཐང་གི་ཡུལ་ཁམས་གསར་པ་ཞིག་རེད།",
    "ས་རྡུལ་ཡང་ཉི་ལི་ལི་འཚུབས་ཏེ་དབེན་པའི་རྩྭ་ཐང་གི་འགལ་བའི་ཟླ་ལ་ཞུགས་པ་དང་མཚུངས།",
    "ཀུང་ཧྲེ་དེའི་ཕྱུགས་ཟོག་གི་གཟན་ཆས་ཐག་བཅད་པར་མ་ཟད་ད་དུང་ཧྲེ་ཡོན་གྱི་བཟའ་འབྲུའང་འདང་སོང་ཟེར།",
    "ཕར་སོང་ནས་བལྟས་པ་ལ།",
    "ཡི་གེ་འདི་ཀྲན་ཀྲུང་གིས་བྲིས་པ་ཁོ་ཐག་རེད་སྙམ་ནས་ངའི་སེམས་ལ་ཀྲན་ཀྲང་འདི་ངོ་མ་མི་ལས་ཀ་ཅན་ཞིག་རེད་ཅེས་ཡིད་སྨོན་སྐྱེས་བྱུང་།",
    "ངས་འདྲུད་འཐེན་འཁོར་ལོའི་རྗེས་དེད་ནས་ཞིང་ཁར་སོང་བ་ཡིན།",
    "སོང་གིན་སོང་གིན་དྲི་བསུང་དེའང་ཇེ་ཞིམ་རྗེ་ཞིམ་ཡིན་ལ།",
    "འདྲུད་འཐེན་འཁོར་ལོའི་སྒྲ་སྙན་མོ་འགྲོས་དང་ལྡན་པ་དེའང་ཇེ་ཆེ་ཇེ་ཆེར་གྱུར།",
    "བློ་མཐུན་དེས་མདུན་ཕྱོགས་སུ་བསྡད་ཡོད་པའི་འདྲུད་འཐེན་འཁོར་ལོ་དེར་མཛུབ་མོས་ཀེར་ནས་ཕ་གིའི་འཁོར་ལོ་དེར་སྐྱོན་ཤོར་སོང་བས།",
    "ཀྲན་ཀྲང་གིས་ལས་རོགས་བྱེད་ཀྱིན་ཡོད་ཟེར།་",
    "ང་མདུན་ཕྱོགས་ཀྱི་འདྲུད་འཐེན་འཁོར་ལོ་དེའི་ལོགས་སུ་སོང་ནས་བལྟས་པ་ལ།",
    "ཕོ་མོ་གཉིས་ཀྱིས་སྐེད་པ་སྒུར་ཏེ་འཕྲུལ་འཁོར་ལ་བཟོ་བཅོས་བྱེད་བཞིན་པ་མཐོང་།",
    "བུད་མེད་དེས་སྣུམ་སྡུག་ལ་སོང་བའི་རྫོབ་ལྭ་ཞིག་གོན་ཡོད་པ་དང་།",
    "ལག་འཕྱིད་དཀར་པོ་ཞིག་སྐེ་ལ་དཀྲིས་འདུག་ཕར་བལྟས་ན་མོ་ལོ་ཉི་ཤུར་བུད་མ་བུད་ཙམ་དུ་སྣང་ཞིང་།",
    "བལྟས་ཚོད་ཀྱིས་ལོ་སོ་ལྔ་སོ་དྲུག་ཙམ་དུ་འདུག་ངས་ཁོ་ནི་དཔལ་ཀྲན་ཀྲུང་ཡིན་ཐག་ཆོད་རེད་བསམས་ནས།",
    "ཁྱོད་དཔལ་ཀྲན་ཀྲང་ཡིན་ནམ་ཞེས་འདྲི་ཞོར་དུ་ངས་ཁོ་ལ་ལག་འཇུས་བྱས་པ་ཡིན།",
    "རྗེས་སུ་ལོབས་ཕྱོགས་ཀྱིས་གད་མོ་ཆེ་རུ་བགད་པ་དང་།",
    "ལྷག་པར་དུ་བུད་མེད་བློ་མཐུན་དེ་བགད་བགད་ནས་མིག་ཆུའང་བཞུར་བྱུང་།",
    "བགད་བགད་ནས་ད་གཟོད་སྐྱེས་པ་བློ་མཐུན་དེས་ཁྱོད་ཀྱིས་བལྟས་ན།",
    "བུད་མེད་བློ་མཐུན་དེ་ན་རེ།",
    "ང་ཚོའི་དཔལ་ཀྲན་ཀྲང་ནི་བློ་མཐུན་སྐྱེས་མ་ཞིག་ཡིན་ཟེར།",
    "ད་ཅི་འདས་མ་ཐག་པ་རུ་ཁོ་ཚོ་དགོད་དོན་ངས་གཞི་ནས་ཧ་གོ་སོང་།",
    "སྐྱེས་པ་བློ་མཐུན་དེས་ནན་ཏན་གྱི་སྒོ་ནས་དཔལ་ཀྲན་ཀྲང་འདི་ནས་ཕ་གིའི་འདྲུད་འཐེན་འཁོར་ལོ་གཞུག་མ་དེ་ཡོད་སར་བུད་སོང་།",
    "ཁྱོད་ཕ་གིར་ཁོ་མོ་འཚོལ་དུ་སོང་ཟེར།",
    "ཞིང་ས་སྙི་མོའི་ཐོག་ནས་གཅིག་པུར་འགྲོ་དུས་ངའི་སེམས་ལ་ད་ཅི་བྱུང་བའི་དོན་དེ་ངོ་མ་དགོད་བྲོ་བ་ཞིག་རེད་སྙམ་བྱུང་།",
    "ཀྲན་ཀྲང་ཞེས་གླེང་མ་ཐག་ཏུ་སྐྱེས་པ་ཞིག་ཡིན་རྒྱུ་རེད་བསམ་དོན་ཅི་ཡིན་ནམ།",
    "རང་རེའི་རྒྱལ་ཁབ་ཏུ།",
    "ལོ་ཉི་ཤུའི་ནང་གི་བློ་མཐུན་སྐྱེས་མ་ཚོས་འགོ་ཁྲིད་ཀྱི་བྱ་བ་སྣ་ཚོགས་ཁུར་དུ་བླངས་ཡོད་པ་ནི་ཕྱོགས་ཕྱོགས་སུ་མཐོང་ཐུབ་པ་མ་ཡིན་ནམ།",
    "གནམ་གཤིས་བརྟག་དཔྱད་ཁང་གི་སུའོ་ཀྲང་དང་།",
    "ཚོང་ཁང་གི་དོ་དམ་པ་སོགས་ལྟ་བུ་རེད།",
    "ཡང་ན་དཔའ་བོ་དཔའ་མོར་གུས་སྨོན་སྐྱེས་པའི་བསམ་ཚུལ་དེ་ལྷག་པར་ཇེ་དྲག་ཏུ་གྱུར་པའི་དོན་ཡང་དེ་ཡིན་རྒྱུ་རེད།",
    "དེ་ནས་ངས་གོམ་པ་ཇེ་མགྱོགས་སུ་བཏང་སྟེ་མདུན་ལ་སོང་བ་ཡིན།",
    "དེའང་ཕོ་གཅིག་དང་མོ་གཅིག་རེད།",
    "བུད་མེད་བློ་མཐུན་དེ་ལུས་སྟོབས་དར་ཞིང་།",
    "མོ་སྒོའང་ཡིག་པ་ཞིག་འདུག་ངོ་ལ་བལྟས་ན་ལོ་ཉེར་དྲུག་ཉེར་བདུན་དུ་སྣང་ཞིང་།",
    "ཁོ་མོའི་དམ་པོར་ཟུམ་པའི་མཆུ་ཡི་དམར་མདངས་དང་།",
    "འདི་ནི་ངས་ཀྲན་ཀྲུང་སྐྱེས་མ་དེར་སྔོན་དཔག་བྱས་པའི་ཚུལ་དང་ཡོངས་སུ་མཐུན་མོད།",
    "ཁོ་ནི་ཁོ་མོ་དང་གཏན་ནས་མི་འདྲ།",
    "ལོ་ལྔ་བཅུར་ལོན་མ་ལོན་དུ་སྣང་མོད།",
    "གཞོན་ནུ་མ་དེ་ཡིན་པ་ནི་སྨོས་མ་དགོས་པ་རེད།",
    "ང་ཐད་ཀར་ཁོ་མོའི་གམ་དུ་སོང་ནས།",
    "གང་ལྟར་ཀྱང་ངས་ཁྱོད་བཙལ་ནས་རྙེད་སོང་།",
    "ངས་དགའ་སྤྲོའི་ངང་ནས་ངོ་སྤྲོད་ཡི་གེ་དེ་ཁོ་མོར་སྤྲད་པ་ཡིན།",
    "ཡིན་ནའང་ཁོ་མོས་ངའི་ཡི་གེ་ལེན་དུས་ཐེ་ཚོམ་ངང་ཨེན་ཙམ་ལུས་ཏེ་ན་ཁྱོད་ཀྱིས་སུ་འཚོལ་བ་ཡིན།",
    "ངས་ཁྱོད་རང་འཚོལ་བ་ཡིན།",
    "སྐབས་དེར་ཁོ་མོས་ཁ་ཕུ་ཐུང་གིས་ཟུམ་ནས་གད་མོ་ཤོར་སོང་།",
    "ཁྱོད་ཀྱིས་འཚོལ་བའི་དཔལ་ཀྲན་ཀྲང་ཕ་གི་ན་ཡོད་ཅེས་ཁོ་མོས་འདྲུད་འཐེན་འཁོར་ལོ་སྐོར་བཞིན་པའི་རྒད་པོ་ཞིག་བསྟན་ནས་དཔལ་ཀུན་ཀྱང་།",
    "བློ་མཐུན་འདིས་ཁྱོད་འཚོལ་གྱིན་འདུག་ཅེས་སྐད་བརྒྱབ་ནས་བཤད།",
    "ང་གཞི་ནས་མགོ་འཐོམས་སོང་།",
    "ངས་ཐོག་དང་པོར་ངོ་ཤེས་པའི་བློ་མཐུན་འདི་དག་གིས་བསམ་བཞིན་དུ་བདག་ལ་ཀུ་རེ་རྩེ་བ་མ་ཡིན་ནམ།་",
    "ཀླན་ཀྲང་སྐྱེས་མ་དེ་མིག་བརྡེབ་ཡུན་ཙམ་ལ་གདོང་ཡོངས་གཉེར་མས་ཁེངས་པའི་བགྲེས་མོ་ཞིག་ཏུ་འགྱུར་སྲིད་དམ།",
    "སྐབས་དེར་བློ་མཐུན་བགྲེས་མོ་དེས་འཁོར་ལོ་བསྐོར་མཚམས་བཞག་སྟེ་བདེ་མྱུར་ངང་འདྲུད་འཐེན་འཁོར་ལོའི་སྟེང་ནས་ས་ལ་ལྡིང་ཡོང་བ་དང་འཛུམ་དམུལ་གྱི་ངང་ངའི་ལག་པར་འཇུས་ནས་ན་རེ།",
    "བགྲེས་མོས་བྱམས་ལྡན་མ་ཡུམ་ལྟ་བུའི་ངག་སྒོ་ཕྱེས་བྱུང་།",
    "བགྲེས་མོ་དེས་ཞྭ་ཕུད་དེ་ལག་མཐིལ་ལ་སྤྲུག་སྒྲུག་ལན་གསུམ་བཏང་བ་ལ།",
    "དར་སྐུད་དཀར་པོ་ལྟ་བུའི་དབུ་སྐྲ་ལན་བུ་དེ་མར་དཔྱངས་སོང་།",
    "ཨ་ཙི་ཀྲན་ཀྲང་ནི་མ་གཞིར་བགྲེས་མོ་ཞིག་རེད་ཡ།",
    "ཁོ་མོས་མགོ་ལྕོག་ལྡེམ་ལྡེམ་བྱས་བྱུང་།",
    "ངས་མིག་ཟུང་ཆེ་རུ་ཅེར་ནས་ཁོ་མོའི་བྱམས་བརྩེ་ལྡན་པའི་གདོང་ལ་ལྟ་བཞིན།",
    "ངས་ངོ་སྤྲོད་ཡི་གེ་ཁོ་མོར་སྤྲད་པ་ལ།",
    "ཁོ་མོས་ཡི་གེར་བལྟ་ཞོར་དུ།",
    "ཁྱོད་ཀྱིས་གནས་ཚུལ་གང་དག་རྒྱུས་ལེན་རྩིས་ཡོད་ཟེར།་",
