    "དགྲར་གྱུར་པ་དེ་དག་ཇི་ལྟར་ཤེས་པར་བྱསྣུམ་མོ།",
    "དེ་ནས་བདག་ཤི་འཕོས་ཏེཆེ་གེ་མོ་ཞིག་ཏུ་སྐྱེས་སོ།",
    "དེ་ནས་ཀྱང་ཤི་འཕོསནས་ཆེ་གེ་མོ་ཞིག་ཏུ་སྐྱེས་སོ།",
    "ངག་གི་དང་།",
    "དེནས་བདུད་སྡིག་ཅན་གྱི་ལག་པ་ནས་གཞུ་ཤོར་བ་ནམརང་གི་གནས་སུ་སོང་ས་དབ༵།",
    "དེ་ནས་བདུད་ཀྱི་བུ་མོ་སྲེད་མ་དང་།",
    "ཡབཁྱོད་ཅི་ཕྱིར་ཐུགས་མི་དགྱེས།",
    "གང་གིས་ཁྱོད་ལ་གནོད་བྱེད་པའི།",
    "བངུད་ཀྱི་བུམོ་གསུམ་པོ་སྦྱིན་ལས་བྱུང་བའི་གློག་བཞིན་དུགཟི་བརྗིད་རབ་ཏུའབར་ཞིང་རང་གི་གནས་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེ་ལོགས་སུ་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "རྩེ་དགེ་སྦྱོང་ཁྱོད་ཀྱི་ཞབས་ལ་བསྟན་བཀུར་བགྱིད་ཅིང་བདེ་བར་གཤེགས་པ་ཁྱོད་ཀྱི་རིམ་གྲོ་བ་གྱིད་དོ།",
    "ཁྱེ་དགེ་སྦྱོང་ཁྱོད་ཀྱི་ཞབས་ལ་བསྙེན་བཀུར་གྱིད་ཅིང་བ་དེབ་ར་གཤེགས་པ་ཁྱོད་ཀྱི་རིམ་གྲོ་བགྱིདདོ།",
    "དེ་ནས་འདུད་ཀྱི་བུམོ་གསུམ་ཕྱོགས་གཅིག་ཏུ་སོང་སྟེ་ཕན་ཚུན་སྨྲ་ཞིང་ཀུན་ཏུ་བགྲོས་པ།",
    "ཤེས་ལྡན་སྤུན་ཟླ་དག་སྐྱེས་པ་རྣམས་ཀྱི་བུད་མེད་ལ་སྲེད་པ་ནི་ཐ་དད་པ་ཡིན་པས།",
    "མ་ལ་བདག་ཅག་གིས་གཞོབརྒྱ་ཕྲག་དང་།",
    "ཕྱིན་ནས་ཀྱང་དགེ་སྦྱོང་གོཏམ་ལའདི་སྐ་ཅེས་དགེ་སྦྱོང་ཁྱོད་ཀྱི་ཞབས་ལ་བསྙེན་བཀུར་བྱེད་ཅིང་བདེ་བར་གཤེགས་པ་ཁྱོད་ལ་རིམ་གྲོ་བ་བགྱིད་དོ།",
    "ཀྱེ་དགེ་སྦྱོང་ཁྱོད་ཀྱི་ཞབས་ལ་བསྙེན་བཀུར་བགྱིད་ཅིང་བདེ་བར་གཤེགས་པ་ཁྱོད་ཀྱི་རིམ་གྲོ་བ་བགྱིད་དོ།",
    "ལནགཉིས་ལནགསུམ་དུ་བཅོམ་ལྡནའདས་ལ་བདུད་ཀྱི་བུ་མོ་གསུམ་གྱིས་དེ་སྐ་ད་གསོལ་ཀྱང་།",
    "སེམས་གཏོད་པརམི་བྱེད་ཀྱིས་སྐྱེས་པརྣམས་ཀྱི་བུད་མེད་ལ་སྲེད་པ་ནི་ཐ་དདཔ་ཡིན་གྱིས།",
    "འདི་དག་ནིརང་ཀྱིས་རྒན་མོའི་དངོས་པོར་བྱས་པ་ཡིན་གྱིས་མ་ལ་ངས་ཀྱང་འདི་རྣམས་ཉིད་ཀུན་ཏུ་སྐྱོ་བ་བསྐྱེད་པའི་ཕྱིར་རྒན་པ་འདི་ཉིད་དུ་བྱིན་གྱིས་བརླ་རབྱའོ་སྙམནས་བཅོམ་ལྡནའངས་ཀྱིས་བདུད་ཀྱི་བུ་མོརྒན་མོར་བྱིན་གྱིས་བརླབས་སོ།",
    "སྐུར་པོ་ཕྱམ་དགུ་བོ་ལྟར་ནས་འཁརབ་ལ་རྟེན་ཅིང་ལུས་འདར་བཞིན་དུ་བདུད་སྡིག་ཅན་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བདུད་སྡིག་ཅན་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "བདག་ཅག་གིསཞིམ་བྱས་པའི།",
    "ཟབ་པའིགཏིང་ཚོལ་འདོད་པ་ཡིན།",
    "ཁྱད་རྣམས་ཀྱི་རྒབའི་དངོས་པོ་མི་སྣང་བར་བྱེད་པ་དེ་ནི་། བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་ཡང་དག་པར་རྫོགས་པའིས་ངས་རྒྱས་དེཉིད་ལས་གཞན་དག་གང་ཡངམ་མཐོང་སྟེ་ཁྱེད་ནམས་སོང་ལ་བཅོམ་ལྡན་འདས་དེ་ཉིད་མཉེས་པར་གྱིས་པཤིག།",
    "དེ་ནས་བདུད་ཀྱི་བུ་མོ་གསུམ་བཅོམ་ལྡན་འདས་ག་ལ་བ་༣ལོགས་སུ་སོང་སྟེ་ཕྱིནནས་བཅོམ་ལྡན་འདས་ཀྱིཞབས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་དུག་ནས་བདུད་ཀྱི་བུ་མོ་གསུམ་གྱིས་བཅོམ་ལྡནའདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་བདག་ཅག་གིས་བྱིས་པ་ཇིལྟ་བ་དང་།",
    "དེནས་བདུད་ཀྱི་བུ་མོ་གསུམ་པོརང་གི་གཟུགས་ཉིད་སྟེ་མ་ལྡན་འདས་ཀྱིཞབས་ལམགོ་བོས་ཕྱག་བྱས་ཏེ་བཅོམ་ལྡན་འདས་ལ་དདཔར་གྱུར་པ་དང་དེ་ཉིད་དུ་མི་སྣང་བར་གྱུར་ཏོ།",
    "དེ་ནས་རྒྱལ་པོ་ཟས་གཙང་ལརང་གི་སྐྱེས་བུ་རྣམས་ཀྱིས་ལྷ་དགྱེས་པ་བསྐྱེདདུ་གསོལ།",
    "དེ་ཉིད་ཀྱི་ཉིནམོ་ཟླ་བ་ཡངསྒྲ་གཅན་གྱིས་ཟིན་ཏོ།",
    "དེ་ནས་རྒྱལ་པོ་ཟས་གཙང་གིས་ཕུན་སུམཚོགས་པ་དེམཐོངནས་དགའབ་དང་།",
    "གྱོ་མོ་རྣམས་བསལ་ནས་ཙན་དན་གྱི་ཆུས་ཆག་ཆག་བཏབ།",
    "སློངས་མོ་པ་རྣམས་ལཡང་སྦྱིན་པ་དག་གཏོང་ངོ།",
    "ཉེ་དུ་དག་གིས་སྨྲས་པ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་སྨྲས་པ།",
    "གང་གི་ཚེ་བཅོམ་ལྡན་འདས་ཀྱིས་པདུད་ཀྱིའཁོར་འབྱུང་པོ་བྱེབ་ཕྲག་སུམ་རྩ་དྲུག་བྱམས་པའིམཚོན་གྱིས་མངོནཔལ་ནས་བླ་ནམེད་པའི་ཡེ་ཤེས་བརྙེས་པ་དེའི་ཚེ་སཆེན་པོ་འདི་ཤིན་ཏུ་གཡོས་པར་གྱུརཏོ།",
    "བཟང་པོ་ད་གཉིས་ཀྱི་ཡུན་རིང་པོའི་དོན་དང་ཕན་པ་དང་བདེ་བར་འགྱུར་གྱིས་མ་ལ་བདག་རང་གིས་འདི་ལྟ་སྟེ།",
    "དེ་ལ་ཁྱོད་ཀྱིས་དེར་ཐོག་མར་བསོད་སྙོམས་ཕུལ་ན་དེ་ནི་ཁྱེད་ཀྱི་ཡུན་རིང་པོའི་དོན་དང་ཕན་པ་དང་བདེ་བར་འགྱུར་རོ་ཞེས་སྒྲས་ནས་ལྷ་དེ་དེ་ཉིད་རུ་མི་སྣང་བར་གྱུར་ཏོ།",
    "གང་གི་ཕྱིར་འདི་ལྟརལྟས་ཀྱང་འདི་ལྟ་སྟེ་བཅོམ་ལྡན་འདས་དེ་ལ་བསོད་སྙོམས་དབུལ་བའི་ཕྱིར་བརྩོན་པར་བྱེད་དོ་སྙམ་ནས་ནང་པར་རལངས་ཏེ་སྦྲང་རྩི་དང་འདའགུམ་ང་དུ་ཁྱེར་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་བཙེམ་༣ན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་ཀྱི་ཆེད་དུ་འདིར་བདག་ཅག་གིས་སྦྲང་རྩི་དང་འདའགུམང་དུ་འཚལ་ཏེམཆིས་ཀྱིས་བཅོམ་ལྡན་འདས་ཐུགས་བརྩེ་བ་ཉེ་བར་བཟུང་སྟེ་འདི་བཞེས་སུ་གསོལ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་དགོངས་ཤིང་ཡེ་ཤེས་གཟིགས་པ་བསྐྱེད་ན།",
