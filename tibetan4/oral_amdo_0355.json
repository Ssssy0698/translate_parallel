    "དེ་ནས་གྲོང་པའི་བུ་མོ་དག་འམོ་དང་།",
    "དགའསྟོབས་མས་བཅོམ་ལྡན་འདས་ཅང་མི་གསུང་ཅོམ་ལྡནའདས་བདེ་བར་བཞུགས་པར་རིག་ནས་གཙང་ཞིང་བསོད་པའི་བཟའ་བ་དང་བཅའབ་དག་རང་གི་ལག་ནས་སྟོབས་ཤིང་ཚིམ་པར་བྱེད་དེ་རྣམ་གྲངས་དུམ་རག་ཙང་ཞིང་བསོདཔའི་བཟའ་བ་དང་བཅའ་བ་དག་རང་གི་ལག་ནས་བསྟབས་ཤིངཚིམ་པར་བྱས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་གྲོང་པའི་བུ་མོ་དག་འམོ་དང་།",
    "འོདསྲུང་ཁྱོད་ཀྱིས་རེ་ཞིག་གནང་བར་གྱིས་ཤིག་དངཐོ་འཚམས་པརམི་འགྱུར་རོ།",
    "དེནས་བཅོམ་ལྡན་འདས་ལྟེང་རྒྱས་འོད་སྲུངརལ་པ་ཅན་གྱི་མེ་ཁངགང་ནབ་དེརགཤེགས་ཏབྱོན་ནས་མེ་ཁང་གི་ཕྱི་རོལ་དུ་ཞབས་བསིལ་ནས་ལེ་བངགི་ནང་དུ་ཞུགས་ཏེ།",
    "ཉིདཀྱིས་རྩྭ་རིག་དིངབ་བཤམས་ནས་སྐུ་དྲང་པོ་རབསྲང་སྟེ་སྐྱིལ་མོ་ཀྲུང་བཅས་ནས་དྲན་པ་མངོན་དུ་ཕྱོགས་པར་བཞག་སྟེ་བཞུགསསོ།",
    "ལྷ་རྒྱས་འོད་སྲུང་རལ་བཅན་དེ་ལ་སྦྱིནབ་དེལྟ་བུ་ཞིག་བྱའོ་སྙམ་མོ།",
    "དགེ་སྦྱོང་ཆེན་པོ་ཁྱོད་ཀྱི་ལྷུང་བཟེད་ན་བསྣམས་ཏེབྱོན་པ་ཅི།",
    "དེའི་ཚེ་ལྟེང་རྒྱས་འོད་སྲུངརལ་པ་ཅན་གྱི་བསྟི་གནས་ནབྲམཟེའི་ཁྱེའུ་ལྔ་བརྒྱ་ཙམམེ་ལ་ཡོངས་སུ་སྤྱོད་པ་རེརེའི་མེ་ཐབ་གསུམ་གསུམསྟེ།",
    "དེནསབྲམ་ཟེའི་ཁྱེའུ་དེ་རྣམས་ལྟེ་ང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་གངནབ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "དགེ་སྦྱོང་ཆེན་པོ་བདག་གི་ཉེ་འཁོར་ནགནས་ན་དེའི་མཐུ་ཞིག་མ་བྱུང་གྲང་སྙམ་མོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོད་སྲུང་རལ་བཙན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "འདིར་བདག་གི་བྲམ་ཟེའི་ཁྱེའུ་ལྔ་བརྒྱ་ཙམ་མེལ་ཡོངས་སུ་སྤྱོད་པར་འཚལ་ན།",
    "བདག་གི་ཉེ་ལ་ཁོར་ན་དགེ་སྦྱོང་ཆེན་པོ་བཞུགས་ན་དེའི་མཐུ་ཞིགམ་བྱུང་གྲང་སྙམ་བགྱིད་དེ།",
    "འདི་ལྟ་དགེ་སྦྱོང་ཆེན་པོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་མོད་ཀྱི།",
    "བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོསྙམ་མོ།",
    "བདག་གི་ཉེ་འཁོར་ན་དགེ་སྦྱོང་ཆེན་པོ་བཞུགས་ན་དེའི་མཐུ་ཞིག་མ་བྱུང་གྲང་སྙམ་བགྱིད་དོ།",
    "འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་ནི་རྫུའཕྲུལཆེ་ཞིང་མཐུཆེ་བ་ཡིན་ཏེ་ཡམཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིནནོསྙམམོ།",
    "བདག་ཀྱང་དགྲ་བཅོམ་པཡིནནོ་ཞེས་བྱ་བའི་བར་དུ་གོངམ་བཞིནནོསཱམ་མོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོད་སྲུངརལ་བཅན་བཅོམ་ལྡན་འདས་གངན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡནལ་ས་ལ་འདི་སྐུཅེས་གསོལ་ཏོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་ནང་པར་སྔར་ལངས་ཏེ་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཁས་པཀུནནས་ཉོན་མོངས་ལས།",
    "འདི་ལྟརདགེ་སྦྱོང་ཆེནཔོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙ་མ་མོ།",
    "ལྟེང་རྒྱས་འོད་སྲུང་རལ་པཅན་དེ་ཉིད་ཀྱི་མཚན་མོ་རྒྱ་སྐར་རྣམས་ལ་ལྟ་བ་ན།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོསྙམ་མོ་ཞེས་བྱ་བའི་བར་དུ་གོང་མ་བཞིནནོ།",
    "དེ་ནས་མིམཇེད་ཀྱི་བདག་པོ་ཚངས་པ་ཁ་དོག་འཕགས་པས་མཚན་མོ་ལ་བབ་པ་ན་བཅོམ་ལྡན་འདྲས་གང་ནབ་དེརསངོ་སྟེ་ཕྱིན་ནས།",
    "ཀྱེམ་དགེ་སྦྱོང་ཆེན་པོ་ཞག་བདུན་ཞིག་འདིནས་གཞན་ངུ་སོང་ཡང་ཅི་མ་རུང་སྙམ་མོ།",
    "དེའི་ཚེ་ཞག་བདུན་དུ་ལྟེང་རྒྱས་འོད་སྲུངཅན་ལ་རེད་པ་དང་།",
    "ངའི་ཐུགས་ཀྱིས་ཁྱོད་ཀྱི་སེམས་ཤེསནས་ཞ་གཞན་དུ་སོང་ངོ།",
    "འོད་སྲུང་ཁྱོད་ཀྱི་མཆོད་སྦྱིན་ཞག་བདུན་དུབྱས་ཟིན་ནས་འདི་སྙམ་དུ་བ་དག་ལ་ཞག་བདུན་དུ་རྙེད་པ་དང་།",
    "སྐྱེ་བོའི་ཚིགསཆེན་དཱུར་གྱིས་ཀྱེ་མ་དགེ་སྦྱོང་ཆེན་པོ་འོངས་ཀྱང་ཅི་མ་རུང་བདག་གིས་དེ་ཡང་ད་ལ་ཡོངས་སུ་ལོངས་སྤྱོད་དུ་གཞུག་གོ་སྙམ་ངུ་སེམས་པ་མ་ཡིན་ནམ་དགེ་སྦྱོང་ཆེན་པོ་དེ་ལྟ་ལགས་སོ།",
    "ངའི་ཐུགས་ཀྱིས་ཁྱོད་ཀྱི་སམས་ཤེས་ནས་ང་འོངས་པ་ཡིནནོ།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་ངགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་གྱིས་བཅོམ་ལྡན་འདས་ཀྱི་ཆེད་དུ་རང་ཁོནས་གཡོས་བྱས་ནས་བརྔོན་ལྡནའངས་གང་ནབ་ད་ར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐང་ཅེས་གསོལ་ཏོ།",
    "འོད་སྲུང་དེའི་ཕྱིར་སོང་ཤིག་ང་ཡང་འོང་ངོ།",
    "ལོན་པརམཁྱེནནས་ཇིལྟར་ཤུགས་མཉམ་པར་བཞགན་ཤིང་འཛམབུ་ཞེས་བྱ་བ་གངགིས་འཛམ་བུ་གླིང་དུ་གདགས་པ་དེ་ལས་ཁ་དོག་དང་དྲིདང་རོ་དང་ལྡན་པའི་འཛམ་བུའི་སྙེ་མ་རྣམས་ཀྱིས་ལྷུང་བཟེད་བཀངནས་བསྣམས་ཏེ།",
    "དགེ་སྦྱོད་ཆེན་པོ་ཁྱོད་ཀྱི་ལྷུང་བཟེད་ན་ཅི་མཆིས།",
    "འདིརངས་འོད་སྲུང་ཁྱོད་སོང་ནས་རིང་པོ་མ་ལོན་པར་མཁྱེནནས།",
    "ཇིལྟརཐུགས་པརབཞག་ན་ཤིང་འཛམ་བུ་ཞེས་བྱ་བ་གང་གིས་འཛམ་བུ་གླིང་དུ་གདགས་པ་དེ་ལས་ཁ་དོག་དང་དྲི་དང་རོ་དང་ལྡན་པའི་འཛམ་བུའི་སྙེ་མརྣམས་ཀྱིས་ལྷུང་བཟེད་བ་ཀང་ནས་འདིར་ཕྱིན་པ་དེ་ལྟ་བུའི་ཏིངང་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཀྱིས་གལ་ཏེ་འདོདསྟོད་ཅིག།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "ཤིང་འཛམ་བུ་ཞེས་བྱ་བ་གང་གིས་འཛམ་བུའི་གླིང་དུ་གདགས་པ་དེ་དང་།",
    "དགེསྤྱོདཆེནཔོ་ཁྱོད་ཀྱི་ལྷུང་བཟེད་ན་ཅིམཆིས་འདིརངས་འོང་སྡུཔ་ཁྱོདསོངནས་རིང་པོ་མལོནཔརམ་ཁྱེན་ནས་ཇིལྟ་ཐུགས་མཉམ་ང་གི་སྒྲ་མི་སྙན་གྱི་གླིང་དུ་གཤེགས་ནས་མརྨོསམ་བཏབ་པའི་འབྲས་སཱ་ལུའི་འབྲས་ལྷུང་བཟེདང་ཀང་ནས་འདིར་ཕྱིན་པ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིནལ་སྙོམས་པར་ཞུགས་ཀྱིས་གལ་ཏེ་འདོད་ན་ལོངས་སྤྱོད་ཅིག།",
    "འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེབ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིནནོ་སྙམ་མོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོད་སྲུང་རལ་པཅན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིནནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འོད་སྲུང་འདིར་ཁྱོད་ལས་བསོད་སྙོམས་བཞེས་ནས་ཕྱོགས་འདིར་བཞུགས་ཏེ་ཞལ་ཟས་ཀྱི་བྱ་བ་མཛད་པ་ནང་ལ་ཆུ་ཆུའི་དགོས་པ་ཞིག་བྱུང་ངོ།",
    "ཡ་མཚན་ཆེམོདཀྱིའདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "ཨརྫུནའི་ཡལ་ག་ཆེན་པོ་འདི་ད་སཱུ་ཞིག་གིས་བཏུད་སྙམམོ།",
    "ས་འོད་སྲུང་རལ་པཅན་བཅོམ་ལྡན་འདས་གང་ན་བ་དེརསོང་སྟེ་ཕྱིནནས་བཅོམ་ལྡན་འདས་ལ་འདིས་དཅེས་གསོལ་ཏོ།",
    "ཨརྫུ་ནའི་ཡལ་ག་ཆེན་པོ་འདི་སྔོན་ནི་རུད་པར་མ་གྱུར་ན་ད་སུ་ཞིག་གིས་བཏུང་སྙམ་བགྱིད་དོ།",
    "འོད་སྲུང་འདིར་ཕྱེམ་རེད་ནང་དུ་ཡང་དག་འཇོག་ལས་བཞེངས་ནས།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "དེ་ནས་ལྷ་རྣམས་ཀྱི་དབངཔོ་བརྒྱ་བྱིན་གྱི་སེམས་ཀྱིས་བཅོམ་ལྡན་འདས་ཀྱི་དགོངས་པ་ཤེས་ནས་རིབྲག་ཅིག་ལས་རྡོལ་བརྩེ་ལ་རིང་བ་ཞིག་བླངས་ནས་བཅོམ་ལྡན་འདས་གང་ནབ་དེར་སོང་ཀྱིསྟེ་ཕྱིནནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ག་ངན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་ཕྱག་དར་ཁྲོད་པའི་ཤནའི་རས་དག་བཀྲམ་མོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོད་སྲུང་རལ་བ་ཅན་བཅོམ་ལྡན་ལངས་ག་ངནབ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐ་དཅེས་གསོལ་ཏོ། ། དགེ་སྦྱོང་ཆེན་པོ་མཁྱེན་པར་མཛད་དུ་གསོལ།",
    "རྡོ་ལེབ་ཆེ་ལ་རིངས་འདིདག་ད་སུ་ཞིག་གིས་འཚལ་ཏེ་མཆིས་སྙམ་བགྱིད་དོ།",
    "ངས་དེལ་ཕྱག་དར་ཁྲོད་པའི་ཤནའི་རས་རྣམས་བཀྲམ་མོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོད་སྤྱང་རལ་པ་ཅན་འདི་སྙམ་དུ་སེམས་ཏེ་འདི་ལྟར་དགེ་སྦྱོང་ཆེནཔོརྫུའཕྲུལཆེ་ཞིངམཐུཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོང་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམང་ཡིནནོ་སྙམ་མོ།",
    "མལ་བདག་གིས་དགེ་སྦྱོང་ཆེན་པོ་བཙལ་སྙམ་དུ་བསམགྲུའིནངདུ་ཞུགས་ཏེ།",
    "འདི་ལྟར་དགེ་སྦྱོང་ཆེན་པོ་རྫུའཕྲུལ་ཆེ་ཞིང་མཐུཆེ་བ་ཡིན་ཏེཡ་མཚན་ཆེ་མོད་ཀྱི་བད་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "འོད་སྲུང་རལ་པ་ཅན་ཁྱོད་ནིདགྲ་བཅོམ་པ་མ་ཡིན།",
    "དེ་ནས་ལྕང་རྒྱས་འོད་སྲུང་རལ་པ་དགེ་སྦྱོང་ཆེན་པོ་གོ་ཏམའི་ཐུགས་ཀྱིས་བདག་གི་སེམས་མཁྱེན་ཏོ་སྙམ་རུ་རིགནས་བཅོམ་ལྡན་འདས་ལ་འདིསྐད་ཅེས་གསོལ་ཏེ།",
    "འོད་སྲུང་དེའི་ཕྱིར་། རེ་ཞིག་ལ་ཁོར་ལ་ལྟོས་ཤིག།",
    "འདིར་ཁྱོད་ལྟ་བུའིམིགྲགས་པ་དང་ལྡན་པ་ཤེས་ཉེནཅན་རྣམས་ཀྱིས་ནི་འཁོར་ལ་ལྟ་བ་ལེགས་པ་ཡིནནོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་རང་གི་བསྟི་གནས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་བྲམ་ཟེའི་ཁྱེའུ་རྣམས་ལ་སྤུས་པ།",
    "དེས་དགེ་སློང་གི་དངོས་པོར་གྱུར་ཏོ།",
    "བདག་ཅག་གི་ཚངས་པམཚུངས་པར་སྦྱོད་པ་རྣམས་རྒྱལ་པོ་འམ།",
    "མ་ལ་བདག་གིས་ཚངས་པ་མཚུངས་པ་ར་སྤྱོད་པ་རྣམས་བཙལ་ཡེ་སྙམ་མོ།",
    "གང་གི་ཕྱིར་ད་ལྟར་ལྟེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་བཙས་ནས་ལོ་བརྒྱཉི་ཤུ་ལྷག་ལོན་པ་རྒས་འཁོགས་གཏུགས་པ་མག་དྷཱའིམི་རྣམས་ཀྱིས་བཀུར་སྟིར་བྱས།",
    "ཁྱོད་ཀྱིས་འཁོར་ལ་བལྟས་ཨམ།",
    "འོད་སྲུང་དག་དེའི་ཕྱིར་རེ་ཞིག་ལ་ཁོར་ལ་ལྟོས་ཤིག།",
    "འདི་ལྟར་ཁྱོད་ལྟ་བུའིམི་གྲགས་པ་དང་ལྡན་པ།",
    "ཤེས་ཉེན་ཅན་དག་གིས་ནིའ།",
    "ག་ཡཱ་འོད་སྲུང་སྙུན་རང་གི་བསྟེ་གནས་གངན་བ་དེར་དོར་སྟེ་ཕྱིན་ནས་བྲམ་ཟེའི་ཁྱེའུ་རྣམས་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།"
  ]
}