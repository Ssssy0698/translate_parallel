    "བཙུན་པ་ཚེ་དང་ལྡན་པ་སྙན་བ་བཟང་ལྡན་གྱིས་ལས་ཅི་ཞིག་བགྱིས་ན་ལས་དེའི་རྣམ་པར་སྨིན་པས་བཅོམ་ལྡན་འདས་ཀྱི་བསྟན་པ་ལ་རབ་ཏུ་བྱུང་སྟེ་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་པས་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བགྱིས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་སྐད་ཀྱི་གཏང་རག་སྙན་པ་རྣམས་ཀྱི་མཆོག་ཏུ་བསྟན།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་པས་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བྱས་ཏེ།",
    "དེས་མུ་སྟེགས་ཅན་རྣམས་སྐད་ཀྱི་གཏང་རག་གིས་གཞུང་འདོན་པ་ཐོས་ནས་དེས་བསམས་པ།",
    "བདག་གི་འཕགས་པ་རྣམས་ནི་གཞུང་འདོན་པ་ཉིད་ན་རྒྱ་ཤུག་གི་འབྲས་བུའི་ཚོགས་གཏོར་བ་བཞིན་འདོན་པས་འདི་ཉིད་བདག་གི་བྱ་བ་ཡིན་ནོ་སྙམ་ནས།",
    "དེ་དག་སྐད་ཀྱི་གཏང་རག་གིས་གཞུང་འདོན་པར་བགྱི་ལ།",
    "འཕགས་པ་རྣམས་ནི་གཞུང་འདོན་བ་ཉིད་ན་རྒྱ་ཤུག་གི་འབྲས་བུའི་ཚོགས་གཏོར་བ་བཞིན་འདོན་བས་དེ་ལ་གལ་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་འཕགས་པ་རྣམས་ཀྱང་སྐད་ཀྱི་གཏང་རག་གིས་གཞུང་འདོན་པར་གནང་ན་ལེགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་ནས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔ་ནས་སོང་ངོ།",
    "དགེ་སློང་རྣམས་སྐད་ཀྱི་གཏང་རག་གིས་ལུང་འབོགས་པར་བྱེད།",
    "ཇི་ཙམ་ན་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་རྒྱལ་བྱེད་ཀྱི་ཚལ་དུ་སོང་བ་ན་དེས་ཐོས་ནས་སྨྲས་པ།",
    "འཕགས་པ་དག་ཅི་ཁྱེད་ཀྱི་གཙུག་ལག་ཁང་འདིར་རོལ་མོ་མཁན་གྱི་བྲང་བཏབ་བམ།",
    "དགེ་སློང་གིས་སྐད་ཀྱི་གཏང་རག་གིས་ལུང་དབོག་པར་མི་བྱ་གདོན་པར་མི་བྱ།",
    "རྒྱུད་ཆགས་གསུམ་པ་གདོན་པ་དག་ནི་སྐད་ཀྱི་གཏང་རག་གིས་གདོན་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྐད་ཀྱི་གཏང་རག་གིས་དེ་དག་གདོན་པར་བྱའོ་ཞེས་བཀའ་སྩལ་པ་དང་།",
    "དེས་གཞུང་དག་སྟོན་པ་ཉིད་ན་རྒྱ་ཤུག་གི་འབྲས་བུའི་ཚོགས་གཏོར་བ་བཞིན་སྟོན་པར་གྱུར་ནས།",
    "དགེ་སློང་དག་གིས་སྨྲས་པ།",
    "ཚེ་དང་ལྡན་པ་བཅོམ་ལྡན་འདས་ཀྱིས་སྐད་ཀྱི་གཏང་རག་གནང་གིས་སྐད་ཀྱི་གཏང་རག་གིས་ཐོན་ཅིག།",
    "ཚེ་དང་ལྡན་པ་དག་བདག་གིས་སྐད་ཀྱི་གཏང་རག་མི་ཤེས་སོ།",
    "འཕགས་པ་དག་གཙུག་ལག་ཁང་འདི་རོལ་མོ་མཁན་གྱི་བྲང་ནི་མ་ལགས་ན།",
    "ཁྱེད་ཀྱིས་ད་དུང་ཡང་རོལ་མོ་མཁན་དག་མ་བཏང་ངམ།",
    "དགེ་སློང་དག་གིས་དེལ་སྨྲས་པ།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "ལྷུང་བཟེད་དེ་ཆག་པར་འགྱུར་མོད་གཞན་ཅི་ཉེས་པར་འགྱུར།",
    "དགེ་སློང་གིས་འགྲེང་སྟེ་ལྷུང་བཟེད་དབྱུང་བར་མི་བྱའོ།",
    "གང་གི་ཚེ་རྒྱལ་བུ་གཞོན་ནུ་རྟོགས་ལྡན་གྱིས་ཁང་བཟངས་པད་མ་ཅན།",
    "ཚོན་བརྒྱ་རྩ་གཅིག་གིས་བྲིས་པ་བྱེད་དུ་བཅུག་ཅིང་རས་སར་བ་ཁ་ཚར་རིང་པོ་ཅན་དག་གིས་ཆལ་པར་བཏིང་སྟེ།",
    "ཁྱིམ་བདག་དད་པ་ཅན་དག་གིས་ལམ་ཕྲན་དག་ཏུ་ཡང་རས་སར་པ་ཁ་ཚར་རིང་པོ་ཅན་དག་བཏིང་ཞིང་འཕགས་པ་དག་བདག་ཅག་ལ་ཐུགས་བརྩེ་བའི་སླད་དུ་གཤེགས་སུ་གསོལ་ཞེས་ཟེར་ན།",
    "དགེ་སློང་ཞིག་ལྷུང་བཟེད་ལག་ན་ཐོགས་ཏེ་སོང་བ་དང་།",
    "དེ་ལྟ་བསན་དགེ་སློང་གིས་ལྷུང་བཟེད་ལག་ན་བཀུར་བར་མི་བྱ་བར་ལྷུང་བཟེད་ཀྱི་སྣོད་དུ་བཅུག་སྟེ་བཀུར་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་ལྷུང་བཟེད་ལག་ན་བཀུར་བར་མི་བྱ་བར་ལྷུང་བཟེད་ཀྱི་སྣོད་དུ་བཅུག་སྟེ་བཀུར་བར་བྱའོ་ཞེས་བཀའ་སྩལ་པ་དང་།",
    "ལྷུང་བཟེད་ཀྱི་སྣོད་ལག་ན་བཀུར་བར་མི་བྱ་བར་ལུང་ཐག་བཏགས་ཏེ་མཆན་ཁུང་གིས་བཀུར་བར་བྱའོ།",
    "བྲམ་ཟེ་ཤཱཀྱའི་སྲས་ཀྱི་དགེ་སྦྱོང་འདི་དག་ནི་མཁས་པ་ལགས་པས་འདི་དག་ལ་ཁྱོད་ཀྱིས་བསླངས་ན་འདི་དགའ་མཆིས་པར་འགྱུར་གངའོ།",
    "དེ་དགེ་སློང་རྣམས་ཀྱི་དྲུང་དུ་སོང་སྟེ་དྲིས་པ།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "དགེ་སློག་དག་གིས་དེ་དག་གི་ལུང་ཐག་མཉམ་པར་བཏགས་པས་དེ་དག་གིས་མཆན་ཁུང་རློ་བར་གྱུར་པ་དང་།",
    "དགེ་སློང་དག་གིས་རས་མ་ཕྲ་མོ་དག་བཏགས་པས་དེ་དག་ལ་ན་བར་གྱུར་ནས།",
    "དེ་དག་གིས་ཞེང་ཆེན་པོ་དག་བཏགས་པ་དང་དེ་དག་ཉིད་ཞུམ་ནས།",
    "དགེ་སློང་ཞིག་གིས་ཕྱིང་བཞིག་རྙེད་ནས་དེས་བསམས་པ།",
    "དེ་གྲིའུ་དཔང་བ་དག་ཁྱེར་ནས་ཤིང་ལྗོན་པ་ཞིག་གི་དྲུང་དུ་སོང་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱང་ཕྱོགས་དེར་གཤེགས་ཏེ་གཟིགས་ནས་བཀའ་སྩལ་པ།",
    "དགེ་སློང་ཞིག་བྱ་བ་ཞིག་གི་ཕྱིར་གཙུག་ལག་ཁང་གཞན་དུ་སོང་བ་དང་།",
    "བདག་གིས་གདིང་བ་ཁྱེར་ཏེ་མ་འོངས་སོ།",
    "དེ་གྲང་བའི་སྡུག་བསྔལ་གྱིས་ཉེན་བཞིན་དུ་མཚན་མོ་འདས་ནས་ན་བར་གྱུར་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་གདིང་བ་མེད་པར་འགྲོ་བར་མི་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་གདིང་བ་མེད་པར་འགྲོ་བར་མི་བྱའོ་ཞེས་བཀའ་སྩལ་པ་དང་།",
