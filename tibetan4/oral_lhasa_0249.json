    "ཁྱིམ་བདག་དགེ་སྦྱོང་གོ་ཏ་མ་ཤཱཀྱའི་སྲས་ཤཱཀྱའི་རིགས་ལས་སྐྲ་དང་ཁ་སྤུ་བྲེགས་ཏེ་གོས་ངུར་སྨྲིག་བགོས་ནས་དད་པ་ཡང་དག་པ་ཁོ་ནས་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་ནས།",
    "ཁྱིམ་བདག་རྒྱལ་རིགས་ལས་ཀྱང་རིགས་ཀྱི་བུ་སྐྲ་དང་ཁ་སྤུ་བྲེགས་ཏེ་གོས་ངུར་སྨྲིག་ིབགོས་ནས་དད་པ་ཡང་དག་པ་ཁོ་ནས་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་བཅོམ་ལྡན་འདས་དེ་ཁོ་ན་རབ་ཏུ་བྱུང་བའི་རྗེས་སུ་རབ་ཏུ་བྱུང་བ་དག་ཡོད།",
    "༣ཀྱི་བུ་སྐྲ་དང་ཁ་སྤུ་བྲེགས་ཏེ་གོས་ངུར་སྨྲིག་བགོས་ནས་དད་པ་ཡང་དག་པ་ཁོ་ནས་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་བཅོམ་ལྡན་འདས་དེ་ཁོ་ན་རབ་ཏུ་བྱུང་བའི་རྗེས་སུ་རབ་ཏུ་བྱུང་བ་དག་ཡོད་དེ།",
    "ཁྱིམ་བདག་བཅོམ་ལྡན་འདས་དེ་ད་ལྟ་གང་ན་བཞུགས་རྒྱལ་པོའི་ཁབ་འདི་ཉིད་ཀྱི་དུར་ཁྲོད་ཀྱི་བསིལ་བའི་ཚལ་ན་བཞུགས་སོ།",
    "དེ་བྱུང་མ་ཐག་ཏུ་སྣང་བ་གང་ཡིན་པ་དེ་མེད་ནས་སླར་ནམ་སྲོས་པར་གྱུར་ཏོ།",
    "དེ་ཡང་འཇིགས་པར་གྱུར་བག་ཚ་བར་གྱུར་ཞིང་སྤུ་ཟིང་ཞེས་བྱེད་པར་གྱུར་ནས་བདག་མིའམ་མི་མ་ཡིན་པའམ།",
    "གང་ཡང་ལྷོ་སྒོ་ནས་བསིལ་བའི་ཚལ་གྱི་དུར་ཁྲོད་ཀྱི་བར་སྣང་བ་རྒྱ་ཆེན་པོས་གསལ་བར་བྱས་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "གསེར་དང་ནོར་བུས་བརྒྱན་བྱས་ལ།",
    "དེ་ལ་ད་ལྟར་ལྷ་ཡང་བརྩོན་པར་བྱེད་ཀྱིས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་ཁྲིད་ནས་གཙུག་ལག་ཁང་དུ་ཞུགས་ཏེ་གདན་བཤམས་པ་ཉིད་ལ་བཞུགས་པ་དང་།",
    "ཡང་དག་པར་འཛིན་དུ་འཇུག་པར་མཛད།",
    "ཡང་དག་པར་གཟེངས་སྟོད་པར་མཛད།",
    "ཡང་དག་པར་རབ་ཏུ་དགའ་བར་མཛད་དེ།",
    "རྣམ་པར་བྱང་བ་དང་།",
    "ལམ་རྒྱས་པར་རབ་ཏུ་བསྟན་ཏོ།",
    "དཔེར་ན་གོས་གཙང་མ་ནག་ནོག་མེད་པ་ཚོན་དུ་གཞུག་པར་འོས་པ་ཚོན་གྱི་ནང་དུ་བཅུག་ན་ལེགས་པར་ཚོན་རྩི་འཇེན་དུ་བཏུབ་པ་དེ་བཞིན་དུ།",
    "བཙུན་པ་ཡུལ་ཕྲ་ཙི་ན་ཞེས་བགྱི་བ་ན་ཀོ་ས་ལ་རྣམས་ཀྱི་གྲོང་རྡལ་མཉན་ཡོད་ཅེས་བགྱི་བ་དེ་ན་བདག་མཆིས་ལགས་སོ།",
    "བཙུན་པ་མ་མཆིས་ལགས་སོ།",
    "གནས་པར་སེམས་སོ།",
    "མཆིས་པར་སེམས་པར་འགྱུར་བ་དེ་ལྟར་གཙུག་ལག་ཁང་བརྩིག་ིལགས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཅང་མི་གསུང་བས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་ལ་གནང་ངོ།",
    "ག་༣གསོལ་བདག་དེ་དང་ལྷན་ཅིག་མཉན་ཡོད་དུ་བཅོམ་ལྡན་འདས་ཀྱི་སླད་དུ་གཙུག་ལག་ཁང་བརྩིག་ལགས་སོ།",
    "ཉིན་པར་ལང་ལོང་ཉུང་ཞིང་ཀུ་ཅོ་ཉུང་བ་དང་།",
    "ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་གཞོན་ནུ་རྒྱལ་བྱེད་ཀྱི་ཀུན་དགའ་ར་བ་ནི་མཉན་ཡོད་དང་ཧ་ཅང་ཡང་མི་རིང་ཧ་ཅང་ཡང་མི་ཉེ་ལ་ཉིན་པར་ལང་ལོང་ཉུང་ཞིང་ཀུ་ཅོ་ཉུང་བ་དང་།",
    "མ་བཅད་དོ་ཞེས་རྩོད་པར་གྱུར་ནས་ཞལ་ཆེ་གཅོད་པའི་སྣ་ཆེན་པོ་ལ་གཏོགས་པའི་མི་གང་ན་བ་དེར་དོང་བ་དང་།",
    "ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་འདི་ནི་བཅོམ་ལྡན་འདས་ཀྱི་ཕྱིར་གཙུག་ལག་ཁང་བརྩིག་པར་རྩོམ་གྱིས་དེའི་གྲོགས་བྱའོ་སྙམ་ནས།",
    "ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་ཞལ་ཆེ་གཅོད་པའི་སྣ་ཆེན་པོ་ལ་གཏོགས་པ་རྣམས་ལ་དོན་དེ་རྒྱས་པར་སྨྲས་པ་དང་།",
    "བོང་བུ་རྣམས་ལ་གསེར་མང་པོ་བཀལ་ཏེ་འོངས་ནས་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་ཐམས་ཅད་བྱེ་བས་ག་ཤིབ་ིཔར་བརྩམས་པ་དང་།",
    "དེར་ཁོ་བོས་བཅོམ་ལྡན་འདས་ཀྱི་ཕྱིར་སྒོ་ཁང་བརྩིག་པར་བྱའོ།་།",
    "དེ་ནས་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་བཅོམ་ལྡན་འདས་ཀྱི་ཕྱིར་གཙུག་ལག་ཁང་བརྩིག་པར་བརྩམས་པ་དང་།",
    "དེ་ཡང་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་ཕམ་པར་བྱས་པ་དང་།",
    "གལ་ཏེ་དེའི་ཤགས་ཀྱིས་ཁོ་བོ་ཅག་ཕམ་པར་གྱུར་ན་གཙུག་ལག་ཁང་རྩིགས་ཤིག།",
    "དགེ་སྦྱོང་གོ་ཏ་མའི་ཉན་ཐོས་ཀྱི་མཆོག་འོངས་ནས་གལ་ཏེ་དེའི་ཤགས་ཀྱིས་ཁོ་བོ་ཅག་ཕམ་པར་གྱུར་ན་གཙུག་ལག་ཁང་རྩིགས་ཤིག་ཅེས་མཆི་ན།",
    "དེ་ལ་ཇི་ལྟར་བསྒྲུབ་ིཔར་བགྱི།",
    "༤༨ ༣ལ་རག་ལས་པར་འགྱུར་སྙམ་ན།",
    "བདག་ཁོ་ན་ལ་རག་ལས་པར་མཐོང་ངོ།",
    "དུས་ཇི་སྲིད་ཅིག་ན་ཚོགས་པར་འགྱུར་སྙམ་ན།",
    "འོན་ཀྱང་ཞག་བདུན་པའི་ཉིན་པར་བྱའོ།",
    "འོན་ཀྱང་ཞག་བདུན་པའི་ཉིན་པར་བྱའོ་ཞེས་ཟེར་རོ།",
    "འདི་ལ་ནི་རྒྱུ་གཉིས་ཡོད་པར་གྱུར་ཏེ།",
    "ག་༣མགོན་མེད་ཟས་སྦྱིན་གྱིས་བླ་གབ་མེད་པའི་ས་ཕྱོགས་ཡངས་པར་སྟན་ཤོམ་དུ་བཅུག་གོ།",
    "དེས་དེ་རྩ་བ་ནས་ཕྱུང་ནས་ཕན་ཚུན་དུ་རྣམ་པར་གཏོར་ཏེ་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་ཡུལ་དུ་ཡང་མ་གྱུར་ཏོ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་སྔགས་ཀྱི་ཕུར་པ་བཏབ་པ་ལས་ཉེས་པར་སྤྱད་པའི་རོ་ལངས་ནི་བདག་ཉིད་ལ་གསོད་པར་བྱེད་པས་དེས་དེ་ཉིད་ལ་བསྙགས་པ་དང་།",
    "དེ་ནས་དེ་འཇིགས་སྐྲག་ཕོངས་ཤིང་བ་སྤུ་ཟིང་ཞེས་བྱེད་ནས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུའི་རྐང་པ་གཉིས་ལ་མགོ་བོས་གཏུགས་ནས་འཕགས་པ་སྐྱབས་སུ་མཆི་ལགས་ཀྱིསི།",
    "བདག་འཕགས་པ་ཤཱ་རིའི་བུའི་སྤྱན་སྔར་ཚངས་པར་སྤྱོད་པ་སྤྱད་པར་བགྱིའོ།",
