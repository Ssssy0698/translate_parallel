    "རང་གི་ངོ་བོས་རྗེས་འབྲེལ་ཉིད།",
    "འཇིག་པའི་སྒྲ་དོན་འཇུག་མོད་ཀྱི།",
    "འདི་ཙམ་ཉིད་ཀྱིས་ལྟོས་མེད་འགྲུབ་མོད།",
    "འཇིག་པའི་རྒྱུ་ཐོ་བ་དེས་བུམ་པ་ལས་གཞན་ཐོ་བའམ་གྱོ་མོའམ་དེ་གཉིས་ལས་གཞན་ཞིག་བྱེད་བརྟག་གྲང་།",
    "གྱོ་མོ་བྱས་ན་བུམ་པའི་ཉེར་ལེན་དང་ཐོ་བའི་ལྷན་ཅིག་བྱེད་པ་ལས་གྱོ་མོ་སྐྱེ་བ་ཁོ་བོ་ཡང་འདོད་དོ།",
    "གལ་ཏེ་གྱོ་མོར་བཏང་བ་ཉིད་འཇིག་པ་རྒྱུས་བྱས་པ་ཡིན་ནོ་ཞེ་ན།",
    "གྱོ་མོ་བསྐྱེད་པ་ལ་འཇིག་པ་བསྐྱེད་པར་འདོགས་ན་བླུན་པོ་ལ་བ་ལང་ལྟར་མིང་ལ་མི་བརྩད་དོ།",
    "གལ་ཏེ་སྒྲོན་མ་གཅིག་གིས་སྡོང་བུ་བསྲེག་པ་དང་མུན་པ་སེལ་བའི་འབྲས་བུ་གཉིས་བསྐྱེད་པ་ལྟར་ཐོ་བ་གཅིག་གིས་བུམ་པ་དངོས་མེད་དུ་འཇིག་པ་དང་གྱོ་མོ་དངོས་པོ་གཉིས་ཅིག་ཅར་བསྐྱེད་དོ་ཞེ་ན།",
    "སྒྲོན་མ་གཅིག་ཉིད་ལྷན་ཅིག་བྱེད་པའི་དབྱེ་བས་འབྲས་བུ་དུ་མ་སྐྱེད་ཀྱང་འདིར་འཇིག་པ་དངོས་མེད་དང་གྱོ་མོ་དངོས་པོ་གཉིས་བྱ་བའི་ཡུལ་དུ་མཚུངས་པ་ག་ལ་སྲིད།",
    "ཐོ་བ་དང་གྱོ་མོ་ལས་གཞན་ཞིག་ཐོ་བས་བྱེད་ན།",
    "པ་ཡིན་གྱི་གྱོ་མོ་ནི་མེས་བྱས་པའི་ཐལ་བ་ལྟར་ཤུགས་ལས་བྱུང་བའོ་ཞེ་ན།",
    "དེ་ལྟ་ན་རྫ་མཁན་གྱིས་ཀྱང་འཇིམ་པ་བཤིག་པར་གྱུར་གྱི་བུམ་པ་བྱས་པར་མི་འགྱུར་བ་ལ་སོགས་པ་ཧ་ཅང་ཐལ་ལོ།",
    "འདོད་ན་རྟག་ཏུ་ཤིང་མཐོང་བར་ཐལ་མ་ཞིག་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་གཞན་སྐྱེས་པས་གཞན་འཇིག་ན་ཧ་ཅང་ཐལ་ལོ།",
    "ཤིང་མི་འཚིག་པར་ཐལ།",
    "ཡང་གི་སྒྲས་ནི་དངོས་པོ་མེད་པ་བྱེད་པའི་བྱ་བ་བཀག་པའི་ཡང་ཕྱིར་ཞེས་གསུངས་སོ།",
    "མི་འགྱུར་ན་སྔར་བཞིན་དུ་ངོ་བོ་ལ་ཁྱད་པར་མེད་པའི་ཕྱིར་ཕྱིས་ཀྱང་མི་འཇིག་པར་ཐལ།",
    "དེས་ན་དུས་ལ་ལྟོས་ནས་ཕྱིས་འཇིག་པ་ཉིད་ཀྱིས་དང་པོ་ཉིད་ནས་ལྟོས་པ་མེད་པར་སྐད་ཅིག་གིས་འཇིག་པར་གྲུབ་སྟེ།",
    "ས་དང་ས་བོན་ལ་སོགས་པ་རང་གི་ངོ་བོ་འགྱུར་མེད་ཀྱི་གཅིག་ཡིན་པས་རྒྱུན་འགྱུར་བ་ལ་ལྟོས་པའི་རྟགས་མ་གྲུབ་བོ་སྙམ་ན།",
    "ཚོགས་པ་ཐ་མས་མྱུ་གུ་སྐྱེད་པ་ལྟར་སྔར་ཚོགས་པ་ཙམ་ཉིད་ན་སྐྱེད་པར་ཐལ་ཏེ་ངོ་བོ་གཅིག་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ངོ་བོ་གཅིག་ཀྱང་ཚོགས་པ་དང་པོ་ལ་གགས་སྲིད་པའི་ཕྱིར་སྐྱེད་པར་མ་ངེས་སོ་ཞེ་ན།",
    "ཚོགས་པ་སྔ་ཕྱི་གཉིས་ཐ་དད་དུ་ཐལ་ཏེ་གགས་ཅན་གགས་མེད་ཡིན་པའི་ཕྱིར་རོ།",
    "འོ་ན་བྱས་པའམ་ཡོད་པ་ལའང་སྐད་ཅིག་རེ་རེ་འཇིག་པ་མེད་དོ།",
    "གསུམ་པ་ཧ་ཅང་ཐལ་བ་སྤང་བ་ནི།",
    "ཐལ་བ་གསུམ་གྱིས་འདིར་མི་འགོག།",
    "རིག་བྱེད་པ་ན་རེ།",
