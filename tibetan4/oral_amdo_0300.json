    "སྤྱི་སྔར་བཀག་པས་མེད་མོད་ཀྱི་ཡོད་དུ་ཆུག་ནའང་སྤྱི་མི་གསལ་བ་དོན་བྱེད་མི་ནུས་པ་ལ་བརྡ་བྱས་ཀྱང་གསལ་བ་དོན་བྱེད་ནུས་པའི་བུམ་པ་རང་གི་མཚན་ཉིད་ལ་འབྲེལ་པ་མེད་པའི་ཕྱིར་གོ་བར་མི་ནུས་པས་སྤྱི་རྐྱང་པ་ལ་བརྡ་སྦྱར་བ་དགོས་པ་མེད་དོ།",
    "སྤྱི་རྐྱང་པ་ལ་བརྡ་མི་བྱེད་ཀྱི་འོན་ཀྱང་སྤྱི་དང་འབྲེལ་པའི་རང་གི་མཚན་ཉིད་ལ་བརྡ་བྱེད་དོ་སྙམ་ན།",
    "རང་གི་མཚན་ཉིད་ཉིད་ལ་སྦྱོར།",
    "རེས་འགའ་འཁྲུལ་གྱི་ཀུན་ཏུ་མིན།",
    "བྱིན་དང་མཆོད་སྦྱིན་ལྟ་བུ་ཚེ་མ་ལའང་འཁྲུལ་པས་རེས་འགའ་ལྷས་བྱིན་ལ་འཇུག་རེས་འགའ་མཆོད་སྦྱིན་ལ་འཇུག་པ་ལྟར།",
    "འདིར་ཡང་འཁྲུལ་པས་རེས་འགའ་དོན་རང་མཚན་ལ་འཇུག་རེས་འགའ་མིང་དང་མཚན་མ་ལ་འཇུག་པར་ཐལ་བ་ལས།",
    "འཆད་དང་འཇུག་པའི་གང་ཟག་གི།",
    "འཆད་པའི་ཚེ་སྒྲའི་དངོས་ཀྱི་བརྗོད་བྱ་སྒྲ་དོན་དང་ཞེན་པའི་བརྗོད་བྱ་དོན་རང་མཚན་ཡིན་ལ་དངོས་ཀྱི་རྗོད་བྱེད་སྒྲ་སྤྱི་དང་ཞེན་པའི་རྗོད་བྱེད་སྒྲ་རང་གི་མཚན་ཉིད་ཡིན་ནོ་ཞེས་རྣམ་པར་དབྱེ་བ་ཤེས་ནས་གནས་ལུགས་ལ་མཁས་པར་འགྱུར་རོ།",
    "སྒྲ་འདི་དག་གིས་གང་བརྗོད་པ།",
    "རྟོག་པ་གང་ཇི་སྙེད་པ་ཐམས་ཅད་རང་གི་ཡུལ་ལ་ངོ་བོ་ཉིད་ཀྱིས་སྐྲ་ཤད་དམ་རྨི་ལམ་ལྟར་གཞི་མེད་ལ་འཁྲུལ་པས་སྒྲའི་དོན་ལ་ཕྱི་རོལ་གྱི་དོན་དུ་ཞེན་ནས་བརྡ་སྦྱོར་ལ།",
    "འཆད་པར་བྱེད་པ་རྣམས་དེ་ལྟར་རྣམ་པར་འབྱེད་པར་བྱེད་ཀྱིས་ཐ་སྙད་འདོགས་པར་བྱེད་པ་རྣམས་ནི་མ་ཡིན་ཏེ་དེ་དག་ནི་རང་གི་དམིགས་པ་ཁོ་ན་དོན་བྱེད་པར་རུང་བ་ཡིན་པར་སེམས་ཤིང་སྣང་བ་དང་རྣམ་པར་བརྟག་པར་བྱ་བའི་དོན་དག་གཅིག་ཏུ་བྱས་ནས་འཇུག་གོ།",
    "དེ་བརྗོད་བྱ་ཡིན་ན་རྣམ་རྟོག་གི་གཟུགས་བརྙན་བརྗོད་པ་དང་།",
    "གཞན་ཡང་འདི་དག་གི་དོན་རྒྱས་པར་རྣམ་འགྲེལ་ལས།",
    "ཡལ་ག་ལ་སོགས་པ་དང་ལྡན་པ་གཞན་ཙནྡན་ལ་སོགས་པ་ལ་ལར་ཤིང་གི་སྒྲ་དེ་མཐོང་བས་རིས་མཐུན་པ་ལ་སྒྲ་མཐོང་།",
    "དེས་ན་དོན་རང་གི་མཚན་ཉིད་དང་རིགས་ལ་སོགས་པ་དེ་དག་ལ་སྒྲ་སྦྱོར་མི་སྲིད་ཀྱི།",
    "དེ་ཤེས་པ་ལས་ཐ་མི་དད་པའི་ཕྱིར་ཤེས་པ་རང་གི་མཚན་ཉིད་བརྗོད་བྱར་འདོད་པ་ལ་བརྗོད་པའི་སྐྱོན་འབྱུང་སྟེ།",
    "སྦྱར་བར་བྱ་བའི་ཡུལ་མེད་མོད་ཀྱི་འཇིག་རྟེན་པ་རྣམས་གཞུག་པའི་ཕྱིར་དོན་སྤྱི་ལ་བརྡ་སྦྱར་ཞེས་བརྗོད་པར་ཟད་དེ།",
    "རེག་པ་མེད་ཀྱང་སྒྲ་དེ་དང་།",
    "སྒྲའི་དངོས་ཀྱི་ཞེས་ཚིག་གི་ལྷག་མར་སྦྱོར་རོ།",
    "མི་ལྡན་པའི་འདུ་བྱེད་ལ་བརྗོད་པའི་སྐྱོན་འབྱུང་མོད།",
    "ཁོ་བོ་ཅག་གི་དོན་སྤྱི་རྫས་སུ་མ་གྲུབ་པས་དོན་སྤྱི་བརྗོད་བྱ་ཡིན་པ་དང་།",
    "གལ་ཏེ་དོན་སྤྱི་ཅིའང་མེད་པ་ལ་བརྡ་བྱས་པས་ཀྱང་རང་མཚན་གོ་ན་རི་བོང་གི་རྭ་ལ་བརྡ་བྱས་པས་ཀྱང་བུམ་པ་གོ་བར་འགྱུར་རོ་ཞེ་ན།",
    "མ་ཡིན་ཏེ་དོན་སྤྱི་ལ་རང་མཚན་དུ་འཁྲུལ་ནས་གོ་ལ་རི་བོང་གི་རྭ་ལ་བུམ་པའི་རང་མཚན་དུ་༩༢",
    "བོད་རྣམས་ན་རེ།",
    "དོན་སྤྱི་དང་དོན་རང་མཚན་གཅིག་ཏུ་འཁྲུལ་པ་ལ་བརྡ་བྱེད་ན་ཁོ་བོ་ཅག་གི་འདོད་པ་བསྒྲུབ་པས་གང་ལྟར་ཡང་མ་འཁྲུལ་པའི་ཆད་བྱས་ཀྱིས་འབྲེལ་པ་མུན་སྤྲུལ་ཡིན་ནོ།",
    "བྱེད་མོད་ཀྱི།",
    "འབྲེལ་མེད་ཀྱི་རྟགས་སྲིད་པར་ཐལ་བས་དེས་ན་དངོས་མེད་ལའང་དངོས་འབྲེལ་ཡོད་ལ།",
    "གལ་ཏེ་སྒྲ་དོན་མ་གྲུབ་མོད་མཚན་ཉིད་གྲུབ་བོ་ཞེ་ན།",
    "བྱས་པ་དང་མི་རྟག་པ་གཉིས་སྒྲའི་རྫས་སུ་གཅིག་པར་མི་མཐུན་པ་མེད་མོད།",
    "བྱས་པ་དང་མི་རྟག་པའི་ལྡོག་པ་ནང་འབྲེལ་མེད་ན་བྱས་པས་མི་རྟག་པ་བསྒྲུབ་མི་ནུས་ཤིང་ཡོད་ན་བྱས་ལྡོག་དང་མི་རྟག་པའི་ལྡོག་པ་གཉིས་བདག་གཅིག་ན་རྫས་ཀྱང་གཅིག་ལྡོག་པའང་གཅིག་པས་ཐ་དད་དུ་འདོད་ཀྱང་དོན་ལ་ཁྱད་པར་ཅིའང་མེད་ལ་ཁྱད་པར་མེད་པ་ལ་མིང་དུ་མ་བཏགས་ཀྱང་ཟླ་བ་དང་བསིལ་ཟེར་བྱེད་ལྟར་མིང་གི་རྣམ་གྲངས་སུ་འགྱུར་གྱི་ལྡོག་པ་ཐ་དད་དུ་མ་སོང་ངོ།",
    "མི་རྟག་ན་མི་རྟག་པར་གང་གིས་འགྲུབ།",
    "དེས་ན་སྤྱོད་འཇུག་གི་གྲངས་ཅན་འགོག་པའི་སྐབས་སུ།",
    "བོད་དག་གིས་རྫས་དང་ལྡོག་པ་དོན་གྱི་སྟེང་ན་བདག་གཅིག་པར་འདོད་པ་ནི་མིང་བསྒྱུར་བ་མ་གཏོགས་པ་དོན་ལ་ཁྱད་པར་མེད་དོ།",
    "མུ་སྟེགས་བྱེད་ན་རེ།",
    "རྐྱང་པ་རེ་རེ་མཐོང་བས་ཀྱང་།",
    "རང་གི་མཚན་ཉིད་འབྲེལ་མེད་ཀྱང་།",
    "རྒྱུ་འབྲས་རང་གི་མཚན་ཉིད་ལ་མེད་ཀྱང་རིགས་ལ་འབྲེལ་པ་ཡོད་དོ་ཞེ་ན།",
    "རྒྱུ་འབྲས་རང་གི་མཚན་ཉིད་ལ་ཟེར་ན་རང་མཚན་དུས་གསུམ་དུ་བརྟགས་ནས་བཀག་ཟིན་ལ་དེ་ལས་གཞན་པའི་སྤྱི་རིགས་ནི་སྤྱི་བྱེ་བྲག་ལས་ཐ་དད་ན་བྱེ་བྲག་པ་ལ་བརྗོད་པའི་སྐྱོན་དང་།",
    "འཁར་གཞོང་དང་རྒྱ་ཤུག་ངོ་བོ་ཐ་དད་ཅིང་དེ་ལས་མ་སྐྱེས་པས་བདག་གཅིག་དང་དེ་བྱུང་མེད་མོད་འོན་ཀྱང་རྟེན་དང་བརྟེན་པ་གཉིས་སྦྲེལ་བ་ལྡན་པའི་འབྲེལ་པ་དང་།",
    "མིག་གིས་གཟུགས་ལ་བལྟ་བ་ལ།",
    "གཟུགས་དང་མིག་འདུས་པའམ་དེ་བཞིན་དུ་ལུས་དང་རེག་བྱ་འདུས་ནས་འཛིན་པའི་བར་ཐམས་ཅད་ལ་ཕྲད་པའི་འབྲེལ་པ་དང་།",
    "རྗེ་ཁོལ་ཁྱོ་ཤུག་ལ་སོགས་ཀྱང་།",
    "ངུར་པ་ལ་སོགས་པ་ལ་ཁྱོ་ཤུག་དང་།",
    "གལ་ཏེ་གནོད་པ་མེད་ན་འབྲེལ་པ་བློ་ངོར་གྲུབ་མོད།",
    "འཁར་གཞོང་གིས་རྒྱ་ཤུག་ལ་ཕན་པའི་ཁྱད་པར་མི་བསྐྱེད་ན་རྒྱ་ཤུག་མི་གནས་པར་འགྱུར་ཏེ་ཕན་མ་བཏགས་པའི་ཕྱིར་རོ།",
    "མེ་དུད་ཀྱང་སྐད་ཅིག་གིས་སྔ་བའི་མེ་ལས་དུ་བ་ཕྱིས་སྐྱེས་པས་རྒྱུ་འབྲས་ཡིན་ནོ་༡༤",
    "འདྲ་མོད་འཁར་གཞོང་དང་རྒྱ་ཤུག་དང་ཚོགས་པ་དང་ཚོགས་པ་ཅན་ལ་སོགས་པ་ཐམས་ཅད་ཀྱང་ནུས་ན་ནུས་མཉམ་མི་ནུས་ན་མི་ནུས་མཉམ་མོ།",
    "གལ་ཏེ་མི་ནུས་སུ་ཆུག་ནའང་རྒྱུ་འབྲས་ཡིན་པ་ཅི་འགལ་ཏེ་ཚང་མང་གི་མེ་དུད་བཞིན་ནོ།",
    "ཞེས་ལྕགས་གོང་མེར་སོང་བའམ་རྒྱུ་འབྲས་སུ་བསྒྲུབ་མི་ཤེས་པས་གྲངས་ཅན་ལྟར་འདྲེས་པས་རྣམ་པར་མ་བྱེད་པ་ཉིད་ཁས་ལེན་དགོས་ལ།",
    "ལྷས་བྱིན་འབྲས་ཆེན་འཚེད་པ་ན་ལྷས་བྱིན་དང་འབྲས་ཡོད་པ་ན་བྱ་བ་མ་སྐྱེས་པས་མེད་ལ་བྱ་བ་སྐྱེས་པ་ན་ལྷས་བྱིན་དང་འབྲས་ཆན་འགགས་ནས་མེད་པས་དེ་དག་གི་བར་ན་འབྲེལ་པ་ག་ལ་ཡོད།",
    "དེ་བཞིན་དུ་བྱེད་པ་པོ་མིག་གིས་ལས་གཟུགས་ལ་བྱ་བ་ལྟ་བར་བྱེད་ཅེས་བྱ་བ་དང་།",
    "དེ་བཞིན་དུ་རྗེ་ཁོལ་དང་ཁྱོ་ཤུག་ལ་སོགས་པའང་ཕན་ཚུན་ལུས་དང་སྲོག་གནས་པ་ལ་ཕན་འདོགས་ན་རྒྱུ་འབྲས་ལས་མ་འདས་ལ་ཕན་མི་འདོགས་ན་འབྲེལ་པ་ཉིད་མ་ཡིན་ནོ།",
    "དོན་ཐམས་ཅད་ངོ་བོ་གཅིག་དང་ཐ་དད་དུ་གནས་པས་འབྲེལ་པ་མི་སྲིད་མོད།",
    "རྒྱུ་རྐྱེན་གྱིས་བསྐྱེད་པ་མ་ཡིན་པ་སྤོང་བའི་རྣམ་པ་ཅན་གྱི་སྒྲ་རྟོག་གིས་བུམ་པ་དང་།",
    "སྒྲ་རྟོག་གི་ཡུལ་ཐ་དད་དང་འཇིག་རྟེན་ལ་གྲགས་པའི་ཐ་སྙད་ལ་བརྟེན་ནས་བྱས་པས་མི་འགལ་ཏེ།",
    "སྔ་ཕྱི་གཉིས་ཀའི་དོན་ལ་མི་སྲིད་པས་སྔར་མཐོང་བའི་མེ་དང་ཕྱིས་མཐོང་བའི་དུ་བ་གཉིས་མངོན་སུམ་དང་མི་དམིགས་པ་ཕྲུགས་གསུམ་ལ་སོགས་པས་བློ་ངོར་འབྲེལ་པ་འགྲུབ་མོད།",
    "འབྲེལ་པ་བློས་བྱས་པ་ནི་མེད་པ་ལའང་གང་གིས་འགོག་ཅེས་གསུངས་པ་ལྟར་རོ།",
    "ཙམ་ཡོད་མོད་ཀྱང་།",
    "དེ་དག་གང་གིས་ངེས་པའི་ཚུལ་ལོ།",
    "ནོག་ལྐོག་ཤལ་དང་བ་ལང་གི་ཐ་སྙད་ཀྱི་འབྲེལ་པ་ཡང་ནོག་ལྐོག་ཤལ་དང་ལྡན་པ་འདི་ཉིད་བ་ལང་ངོ་ཞེས་མིང་དོན་གཅིག་ཏུ་འཁྲུལ་པ་ལ་བདག་གཅིག་པའི་བརྡ་ཆད་བྱས་པས་འགྲུབ་ཀྱི།",
    "སྤྱི་དང་བྱེ་བྲག་གི་འབྲེལ་པའང་ལྡོག་པ་གཅིག་རྐྱང་དང་གཉིས་ཚོགས་ཀྱི་ཤིང་དང་ཤ་པ་གཅིག་ཏུ་འཁྲུལ་པ་ལ་བདག་གཅིག་པའི་བརྡ་ཆད་བྱས་པས་འགྲུབ་ཀྱི་དོན་ལ་སྤྱི་དང་བྱེ་བྲག་རྫས་གཅིག་པ་བཀག་ཟིན་ཏོ།",
    "གང་གིས་འགྲུབ་ཅེ་ན།",
    "གཞུང་འདིས་ཡང་དག་གི་སྦྱོར་བ་བཀོད་པ་སྟེ།",
    "གང་ཡོད་པ་དེ་སྐད་ཅིག་གིས་འཇིག་སྟེ་བུམ་པ་བཞིན་སྒྲ་ཡང་ཡོད་དོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་རྟགས་སོ།",
    "ཡོད་པའམ་བྱས་པ་གང་བཀོད་ཀྱང་རུང་མོད།",
    "བྱས་པ་ནི་རྒྱུ་རྐྱེན་གང་གིས་བྱས་ཞེས་༡༡༡",
    "གསུམ་པ་རང་གི་ལུགས་ནི།",
