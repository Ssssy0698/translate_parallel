    "དེ་དག་གི་དོན་དུ་བྱས་པའི་རྩིག་པ་ནི་འརྨི་བའི་དུས་སུ་དྲན་པའི་ཡུལ་དུ་འབྱའོ་ཞེས་བསྟན་ཏོ།",
    "ཚིག་གི་དོནནི་གོ་སླའོ།",
    "འགྲོ་བའི་འཆི་བདགཡེས་བྱ་བ་ཚིག་རྐང་གཉིས་ཀྱིས་ནི་རིགས་དང་ལྡན་པ་དག་གིས་འཆི་བདག་གི་བདུད་སྤོང་བ་བྱེད་པའི་གཉེན་པོ་ཉིད་དུ་བསྟན་ཏོ།",
    "ཡན་ལག་གི་དོན་ནི་གོ་སླའོ།",
    "བག་ལ་ཞ་བ་བཞིན་དུ་གཟིགས།",
    "གང་ཟག་དེ་གདུལ་བར་བྱ་བ་མཐའ་དག་གིས་བད་བར་ཉམས་བར་བྱ་བའི་ར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ་ིན་",
    "འདག་གིས་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེ་ལྟར་བདེནུམང་ལ་ངན་སོང་དུ་སྐྱེས་པའི་དུས་ཀྱི་ཚེ།",
    "༡༤ ལ་ཁྱོན་ཡོངས་བ་སྤང་བར་བསྟན་པལ།",
    "ང་ནི་ཉོན་མོངས་པ་གཞི་ནས་སྤོང་བར་བྱ་བའི་དོན་དུ།",
    "དང་པོ་ཤེས་བཞིན་མ་ཡིན་པའི་ཉེ་བའི་ཉོན་མོངས་པ་རྒྱུད་ལ་འབྱུང་དུ་བསྟན་པ།",
    "སོང་ནའང་ངན་སོང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དྲན་པ་མ་བཏང་བ་དེ་ལྟ་བུ་ཡནང་ཟིན་ཀྱང་གལ་ཏེ་ཉམས་ཏེ་སོང་ན་ཇི་ལྟར་བྱ་སྙམ་ན་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་དག་གི་ཐུགས་ཀྱིས་བས་ར་མ་རུ་ངོ་སྐལ་དུ་བསྡོམས་ནས་བསླབ་པ་མི་ཉམས་པར་བྱ་བའི་དྲན་པ་རྟག་ཏུ་བཞག་གོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཤུགས་སྐྱེས་ནི་ངག་གི་སྤྱོད་ལམབརྟག་པར་བསྟན་པའོ།",
    "བཱ་མོ་གཏམ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "བདག་ལ་བསྟོད་ལུས་དང་ལོངས་སྤྱོད་ལ་ལྷག་པར་ཆགས་པས་ཀུན་ནས་བསླང་བ་ཡིན་པའི་ཕྱུརེ་ལ།",
    "ཟབ་མོའི་དོན་ལ་འཇིགས་པ་ནི་ཤིས་རབ་ཀྱི་ཡའི་ཞིང་།",
    "སྤྱོད་པ་སྤྱི་བརྟོལ་དང་མུ་ཁྱོར་སྨྲ་བ་ནི་བསམ་པ་གཏན་ཡིན་ཏེ།",
    "རང་གི་ལུས་དང་ལོངས་སྤྱོད་དང་།",
    "ལ་བ་འབྱེད་པ་ཤར་ཏུ་རྙེད་པར་དཀའ་བ་ལས་དེ་ཐོབ་པའི་དུས་སུ་དེ་ཐོབ་པཆུང་པོ་ཟ་བར་བྱའོ་མམ་ནས་སེམས་བསྲུང་བ་ཡན་ལག་གི་དོན་ཡིན།",
    "མི་གཙང་བ་ཡིན་པའི་ཕྱིར་རྟེན་དུ་བཟུང་རིནམོ་ཆོག་སྙམ་བསམ་པའོ།",
    "གཉྫིག་ཏུ་འཁྱོད་ཀྱིས་ལས་སྤྱོད་དུ་མི་རུང་བའི་ཕྱིར་བསྲུང་བར་མི་རིགས་ཏེ།",
    "འདི་ལྟར་ཁྱོད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སོས་སུ།",
    "བདུག་འབའ་ཞིག་གིས་བསྟོཔར་བྱའམ་ཞེ་ན།",
    "ཐུགས་རྗེས་ཡང་བའི་རེ་བཞིན་གཤེགས་པ་དོན་རིང་པོ་གཞན་གྱི་དོན་དུ་འགྱུར་བ་ལ་གཟིགས་ནས།",
    "ལྷག་པའི་བསམ་པ་དག་པའི་སོར་རྒྱུད་པ་ལ་ནི་ཉེས་པ་གོང་མོ་རྣམས་ལས་བཟློག་པའི་ཕྱིར་དངོས་སུ་གཏོང་བ་བྱེདཔ་ཁ་ནའོ་ཞེས་བྱ་པའི་ཛིན་ཏོ།",
    "ཡོངསསུ་བསྔོ་བ་དམ་པས་ཡོངས་རྫོགི་པ་བྱའོ།",
    "དེའི་རྗེས་ལ་བསླབ་པ་བུ་པ་གཞན་དག་ཀྱང་ཤེས་པར་བྱ་བའི་སྦྱོརེའཕགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲས་སོ།",
    "བསྟན་བཅོས་ཀྱི་མིང་གི་དོན་སྔ་མ་བཞིན་ནོ།",
    "བདག་གཤེན་ལ་གས་པ་ཉིདཀྱི་ལས་ཀྱིས་ངེས་པར་གཞན་ལ་བྲོ་བ་མྱང་མེདཔ་གང་གིས་གཞན་དག་ཤེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ཁྱོད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྤྲོས་སོ།",
    "ཉོན་མོངས་ཞེས་བྱ་བ་ལསོགས་པ་སྐྱེས་ཏེ།",
    "རེ་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་བ་སྒོསསོ།",
    "བདག་གི་སྲོག་གཅོད་པན་བླར་གྱེས་པ་ལ་ཕྱི་ངོས་ཀྱི་དོན་ཏོ།",
    "ཞུ་བ་ནི་ངང་གི་དོན་ཏོ།",
    "ཉོམོངས་པ་རྣམས་སྤང་བར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱི།",
    "འཇིར་འགྲེལ་པ་བྱེད་པ་གཞན་དག་ན་རེ།",
    "བདག་གིས་དེ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པས་འདོ།",
    "གཞན་གྱི་སྡུག་བསྔལ་བསལ་བའི་དོན་དུ་བདག་གིས་དཀའ་བ་སྤྱད་པའི་སྤྲོས་བདག་ལ་སྦྱོར་ཞེས་བྱའོ།",
    "འོན་ཏེ་གཞན་གྱི་ཉེས་པ་བཞིན་དུ་རང་གི་ཉེས་པ་ཡང་བཙབྷ་པུ་འགཤམཱམལན།",
    "ངན་སོང་དུ་སྐྱེ་དུ་དོན་བྱེད་པར་འདོད་པ་བཙོམཔ་དང་།",
    "ངན་སོང་དུའགྲོ་པའི་ཐབས་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཐོག་མར་ཞི་གནས་བཙལ་བར་བྱ་ཞེས་བྱ་བ་ནི་དུས་གང་གི་ཚོ་བཙལ་བར་བསྟན་ཏོ།",
    "དེ་ཚོ་ཉམས་ལ་ཡང་རེག་བྱའི་སྒོ་ནས་ཅིའི་ཕྱིང་ཆགས་པར་བྱེད་དོ།",
    "ཁྲོདཔ་སྤོང་བ་ནི་པགས་པ་སོས་པ་ཡང་དགཔར་བླང་བའི་ཚིག་ཇི་སྐད་བཤདཔ་བཞིན་དུ་ཡང་དག་པར་བླངས་པས་སྡོམ་པ་ལེགས་པར་མནོས་སམ་སྙམ་པའི་འཁྱོདཔ་ཡང་མ་འབྱུང་ལ།",
    "ལེའུ་དྲུག་པར་ཉེས་པ་བྱུང་བ་རེ་རེའང་།",
    "ལ་མྱ་ངན་ལས་འདས་པ་ཞེས་བྱ་བ་ནི་བདག་གི་དོན་ཏེ།",
    "མོས་པ་སྣ་ཚོགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་རྒྱུ་རྐྱེན་གཅིག་གིས་འབྲས་བུ་མཐའ་དག་སྐྱེད་ནུས་པ་ཡརྦ་ནནི་",
    "སྐྱེ་འགག་གི་མཎྜིན་རྙིང་ཐམས་ཅད་ཀུན་རྫོབ་ཡིན་པར་ང་ངོར་བ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར།",
    "གང་གི་ཚེ་གཉེན་པོ་ཡུམ་སྐྱེས་པས།",
    "དབས་ན་ང་པེ་པ་ཡིད་བཞིན་ཡན་པའི་ངང་ཤེས་པ་རང་གིས་རང་རིག་པ་བྱེད་དོ་ཞེས་བྱ་བའི་ཁྱོད་ཀྱི་གཏན་ཚིགས་འདི་ལ་འགལ་བའི་སྐྱོན་ཆགས་པ་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
