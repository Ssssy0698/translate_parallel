    "ཕྱི་རོལ་གྱི་རྟགས་རྟགས་ཅན་དེ་དེའི་ངོ་བོ་མ་གཟུང་བར་ཡང་རང་ལ་སྣང་བའི་རྣམ་པ་དེ་དག་ཕྱི་རོལ་གྱི་རྟགས་རྟགས་ཅན་དེའི་ངོ་བོས་སྟོང་པ་སྟེ་དེའི་ངོ་བོ་མིན་པ་ལ་དེར་ཞེན་པའི་སྒོ་ནས་ཕྱི་རོལ་དེ་དག་ལ་མི་སླུ་བའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་དངོས་པོ་ཡོད་པས་བསྒྲུབ་པའི་རྟགས་ནི་འབྲས་བུ་དང་རང་བཞིན་རྟགས་གཉིས་ཁོ་ནའོ།",
    "རང་ཡུལ་མཐོང་བ་བར་ཆོད་དང་བཅས་པ་དང་རང་ཡུལ་མཐོང་བ་བར་ཆད་མེད་པ་ཡིན་པའི་ཕྱིར་དེས་རང་བརྒྱུད་འཕེན་ནོ།",
    "གསལ་བའི་དངོས་པོ་རྣམས་ལ་འབྲས་བུ་གཅིག་མི་བྱེད་པ་ལས་ལྡོག་པ་གཅིག་ཡོད་ཅིང་རང་འབྲས་གཅིག་མི་བྱེད་པ་ལས་ལྡོག་པ་གཅིག་ཡོད་ཅིང་རང་འབྲས་གཅིག་མི་བྱེད་པ་ལས་ཐ་དད་དུ་བསྟན་པའི་དོན་དུ་སྒྲ་སྦྱོར་བ་དེའི་ཕྱིར་དངོས་པོ་ལ་རྗོད་བྱེད་ཀྱི་མཉན་པ་དེ་གཞན་སེལ་གྱི་མཐའ་ཅན་ཡིན་ནོ།",
    "བ་ལང་དང་རང་མཚན་མཐོང་བའི་བག་ཆགས་གོམས་པ་ཉིད་ཀྱིས་སྤྲུལ་པ་སྟེ་བསྐྱེད་པའོབཞི་པ་གཞན་སེལ་སྒྲ་དོན་ཡིན་པར་བསྟན་པ་ནི།",
    "གང་རང་རིག་པ་དེ་མངོན་སུམ་ཡིན་ན་རྟོག་པའང་མངོན་སུམ་དུ་འགྱུར་ཞེ་ན།",
    "ཕྱི་རོལ་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་འཐད།",
    "ཕྱི་རོལ་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་བརྗོད་པ་དེའི་ཚེ་བློ་རང་རིག་ནོར་གཅེས་བཏུས་ལས།",
    "དེ་ཡང་རང་མི་འདོད་ཀྱི་གཞན་དགག་པར་བཞེད་ནས་བསྟན་པ་ཡིན་ནོ།",
    "རང་ཉམས་སུ་མྱོང་བ་ལས་ཐ་དད་པ་རང་ལས་རྫ་ས་གཞན་ཅུང་ཟད་ཀྱང་རང་མྱོང་ཤེས་པས་རྟོགས་པ་མེད་པའི་ཕྱིར་ན།",
    "དོན་གྱི་དེ་དོན་མངོན་སུམ་དུ་མ་མཐོང་བ་ལས་གཞན་མཐོང་བ་པོ་དོན་ལ་ལྟ་བ་པོ་ལའང་ཡོད་པས་སོ་ཞེ་ནལྟ་བ་པོ་ལ་ཡང་རང་བློ་རྟོགས་པར་བྱེད་པའི་རྟགས་སུ་འགྱུར།",
    "གསུམ་པ་སྲིད་ཀྱང་རང་བློ་གོ་བྱེད་མིན་པ་ནི།",
    "ཡི་གེའི་ཡུལ་ཅན་ཉན་ཤེས་སྐད་ཅིག་མ་གཅིག་ཡུན་རིང་དུ་ཡི་གེ་གྲུབ་པའི་དུས་ན་གནས་པ་མེད་ཅིང་རང་རིག་མེད་པས་ཡི་གེའི་ཆ་སྔ་ཕྱི་འཛིན་པའི་བློ་རྣམས་ཕྱིས་ལྷན་ཅིག་དྲན་པའང་མིན་ལ་བློ་གཉིས་ཅིག་ཅར་དུའང་མི་འཇུག་པའི་ཕྱིར་རོ།",
    "དེ་ལའང་རང་འཛིན་བློ་ཕྱི་མ་ལ་ཉེར་ལེན་གྱི་སྒོ་ནས་དངོས་སུ་ཕན་འདོགས་པའི་ཤེས་པ་དེ་ཡོད་པའི་ཕྱིར་རོ།",
    "དེ་བཅད་པའི་དོན་དུ་ཡང་རང་ཉིད་ཀྱི་སྒྲ་བྱ་བར་མི་རིགས་ཏེ།",
    "ཀྱི་གསུམ་པ་ནི་འདི་དག་མཚུངས་པའི་རྒྱུ་དེས་ན་ལུང་དང་རང་ཚིག་འགལ་བ་འདི་གཉིས་ལ་དཔེ་བརྗོད་དཀཨདག་ཀྱང་མཚུངས་པ་ཉིད་དུ་སློབ་དཔོན་གྱིས་བསྟན་པ་ཡིན་ཏེ།",
    "གཉིས་པ་གྲགས་པ་སྤོང་ན་དཔེ་མི་སྲིད་པ་ནི།",
    "སོ་སོར་གཞལ་བ་དེ་ལས་ལྷག་པའི་འབྲས་བུའི་རྫས་ཀྱི་ལྗིད་དུ་མ་ཡོད་པའི་ཕྱིར་འདིས་ཀྱང་རང་རྒྱུད་འཕེན་ནོ།",
    "དྲན་པ་ལུས་ཀྱི་ནུས་པ་རྩོལ་བ་དང་བློའི་གཡོ་བ་དང་རང་རིགས་སྔ་མ་རྣམས་ཅི་རིགས་པར་སྐྱེས་པ་ཡིན་ལནི་མྱོང་བ་ལས་དང་དྲན་པ་ལས་ཀྱང་འདོད་པ་དང་རྩོལ་བ་འབྱུང་ངོ།",
    "ལ་མི་འཁྲུལ་བ་དེ་བཞིན་དུ་འབྲས་བུ་གཞན་ཡང་རང་རྒྱུ་ལ་མི་འཁྲུལ་བར་གྲུབ་པར་རྟོགས་པར་བྱའོ།",
    "བུམ་པ་དམིགས་པའི་ཤེས་ཧཱ་པབ་ཝཱརཱཎཔ་དེ་ཡང་རང་རིག་མངོན་སུམ་གྱིས་མ་གྲུབ་པར་བློ་གཞན་གྱིས་བུམ་པ་དམིགས་པའི་ཤེས་པ་དམིགས་པ་མེད་པ་ཉིད་སྒྲུབ་དགོས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "མ་ཞུ་བ་གཉིས་ཀྱི་བར་ན་འདུག་པའམ།",
    "སྟན་གཅིག་པ་ནི་སྟན་གཅིག་ལ་འདུག་ནས་ཅི་ཙམ་ཟ་བར་བྱེད་པ་དེ་ཟ་བ་སྟེ།",
    "ཕྱིས་མི་ལེན་བ་ནི་སྟན་ལ་འདུག་སྟེ་ཅི་ཙམ་ཟ་བར་ནུས་པ་དེ་ཙམ་བྱིན་ལེན་བྱས་ནས་ཟའི་བྱིན་ལེན་མ་བྱས་པར་མི་ཟ་བའོ།",
    "འོ་ན་ཅི་ཡང་མི་སྨྲ་བར་འདུག་ཅིང་ཞེ་ན།",
    "གཞན་ཡང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་ཀྱི་ཕྱོགས་ལ་གལ་ཏེ་གཏན་ཚིགས་དང་།",
    "དཔེ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་ཉིད་ལས་གྲུབ་པས་སོ།",
    "གཞན་ཡང་རང་རིག་དེ་དངོས་པོར་གྱུར་པ་ཞིག་གམ་དངོས་པོ་མ་ཡིན་པ་ཞིག།",
    "གཅིག་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་འཇིག་པ་དང་སྐྱེ་བ་དག་དུས་མཉམ་པའི་ཕྱིར་རོ།",
    "ས་བོན་དང་མྱུ་གུ་དག་ཀྱང་དུས་མཉམ་པར་འགྱུར་ལ་ཞེས་བྱ་བ་ནི་འགག་བཞིན་པའི་ས་བོན་དང་སྐྱེ་བཞིན་པའི་མྱུ་གུ་དག་དུས་མཉམ་པར་འགྱུར་བའོ།",
    "སྐྱེ་བཞིན་པའི་མྱུ་གུ་དག་དུས་མཉམ་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "འགག་བཞིན་པའི་ས་བོན་དག་དུས་མཉམ་པ་ཉིད་རིགས་པ་མ་ཡིན་ཏེ།",
    "མྱུ་གུ་དག་དུས་གཅིག་པ་ཉིད་མ་ཡིན་གྱི།",
    "གཟུང་བར་བྱ་བའི་དོན་མེད་པས་ཤེས་པ་གང་འཛིན་པར་བྱེད་པ་ཉིད་དོན་ཐ་དད་པར་རྟོགས་པའི་མཚན་ཉིད་ཅན་མ་མཐོང་ཞིང་རང་གསལ་བ་ཙམ་དུ་ཁོང་དུ་ཆུད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདུ་བྱེད་ཀྱི་སྐད་ཅིག་དུས་གསུམ་པའི་ཉེ་བར་ལེན་པ་ཅན་ལ་བྱ་བ་ཞེས་བྱ་བ་ནི་འདུ་བྱེད་རྣམས་ཀྱི་འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་བའི་སྐད་ཅིག་མ་གང་ཡིན་པ་དེ་ནི་ཉེ་བར་ལེན་པ་ཅན་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་ཕན་ཚུན་ལྟོས་པ་ཡིན་པས་རིང་པོ་དང་ཐུང་ངུ་དག་བཞིན་དུ་ཤེས་པ་དང་ཤེས་བྱ་དག་ཀྱང་རང་བཞིན་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བཅོམ་ལྡན་འདས་ཁྱེད་ཀྱིས་གསུངས་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "མེ་བཞིན་དུ་ཞེས་བྱ་བ་ནི་ཅི་ལྟར་མེ་དེ་དང་མེ་དེའི་རྒྱུ་ཅན་གྱི་དུ་བ་མངོན་སུམ་གྱིས་གྲུབ་པ་དེ་བཞིན་དུ་གལ་ཏེ་རང་རིག་པ་གྲུབ་པར་གྱུར་ན་དེའི་ཚེ་དེའི་རྒྱུ་ཅན་གྱི་དྲན་པ་འགྲུབ་པར་འགྱུར་བ་ལས་འོན་ཀྱང་རང་རིག་པ་ཉིད་མ་གྲུབ་པས་དེའི་རྒྱུ་ཅན་གྱི་དྲན་པ་ཡང་མ་གྲུབ་པའི་ཕྱིར་དྲན་པའི་སྒོ་ནས་རང་རིག་ཅི་ལྟར་རྗེས་སུ་དཔོག་པར་བྱེད་ཅེས་པའོ།",
    "གལ་ཏེ་ཤེས་པ་རྣམས་སྐད་ཅིག་མ་ཡིན་པ་དང་རང་རིག་མེད་པས་ངས་མཐོང་ངོ་སྙམ་དུ་ཇི་ལྟར་དྲན་ཞེ་ན།",
    "རབ་རིབ་ཅན་ལ་བརྒལ་ཞིང་བརྟག་པ་ལྟ་བུ་འདུག་ཤིག་ཅེས་བྱ་བ་ནི་རབ་རིབ་ཅན་ལ་བརྒལ་ཞིང་བརྟག་པར་མི་བྱའོ་ཞེས་པའོ།",
    "ཀུན་རྫོབ་ཏུ་ཡང་རང་བཞིན་ཡོད་པར་ཁས་མི་ལེན་པས་སོ།",
    "ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པའི་བྱེད་པ་པོ་དེས་ལས་གང་ཅུང་ཟད་བྱེད་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཡིན་ཏེ།",
    "རང་བཞིན་སྐྱེ་བ་ནི་མ་ཡིན་ཏེ་ཕྱོགས་གཉིས་ཆར་ཡང་རང་བཞིན་སྐྱེ་བར་འགེགས་པར་འདོད་པས་སོ།",
    "གང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་དེ་ནི་སྟོང་པ་ཉིད་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ནི་གལ་ཏེ་སྔོན་གྱི་བདག་ལས་བདག་འདི་གཞན་ཉིད་ཡིན་པར་གྱུར་ན་ནི་དེའི་ཚེ་གཞན་ཡིན་པའི་ཕྱིར་བུམ་པ་སྐྱེས་ནས་སྣམ་བུ་མ་ཞིག་པ་བཞིན་དུ་ཕྱིས་ཀྱི་བདག་སྐྱེ་ཙ་ན་སྔར་གྱི་བདག་འགག་པར་ཡང་མི་འགྱུར་ལ།",
    "བྱེད་པ་པོ་དང་རང་བཞིན་དུ་གྱུར་པ་བཀག་པ་ཤེས་པར་བྱ་བའི་ཞེས་བྱ་བ་ནི་བཅོས་མ་མ་ཡིན་པ་གཞན་ལ་མི་ལྟོས་པ་བྱེད་པ་པོ་བཀག་པ་ཡིན་ནོ་ཞེས་པའོ།",
    "རྒྱུ་དང་འབྲས་བུ་དག་ཅེས་བྱ་བ་ལ་སོགས་པ་ནི་གང་ཡང་རང་བཞིན་གྱིས་རྒྱུ་ཉིད་དུ་ཡོད་པའམ་འབྲས་བུ་ཉིད་དུ་ཡོད་པ་ཡིན་ནོ་ཞེས་པའི་རྒྱུ་དང་འབྲས་བུའི་རང་བཞིན་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཡང་རང་རྒྱུད་པ་ལ་སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་མ་སྐྱེས་པའི་སྔ་རོལ་དུ་དངོས་པོ་འགའ་ཞིག་ལ་ཡང་རང་བཞིན་ཡོད་པ་མ་ཡིན་ཏེ།",
    "བྱས་པ་དང་རང་བཞིན་དག་ནི་ཕན་ཚུན་འགལ་བའི་ཕྱིར་མི་རིགས་པ་ཁོ་ན་ཡིན་ནོ།",
    "དེ་ཡང་རང་བཞིན་རྒྱུ་དང་རྐྱེན་དག་ལས།",
    "ཞེས་བྱ་བ་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་བ་དག་ལའོ།",
    "རྩོལ་བ་ཆེ་ལ་ཡོན་ཏན་ཆུང་བ་ཞིག་བྱེད་པར་འདུག་སྟེ།",
    "ཡང་འདི་སྒོམ་ཞེས་བློས་བྱས་ལ་སྒོམ་རྒྱུ་གཅིག་ཀྱང་མི་འདུག་པས་སྒོམ་གྱིས་སྟོང་ལ།",
    "འདི་མི་སྒོམ་ཞེས་སྤང་བྱའམ་དོར་བྱ་མི་འདུག་པས་ཝལ་གྱིས་སྟོང་པ་སྟེ།",
    "རང་སྣང་རང་ངོ་ཤེས་པའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་ལ་འགག་པ་མེད།",
    "རང་སྟོང་ཡེ་སྟོང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "དེ་ཡང་རང་སྟོང་བས་ཡུལ་མེད་སྟོང་བྱ་ཕྱི་རུ་བཞག་ནས་སྟོང་མཁན་ནང་དུ་ལུས་པ་ལྟ་བུ་ཞིག་མ་ཡིན་པས།",
    "དུས་མཆོད་ཀྲི་གེ་མཛད་རྟོགས་པ་ལ་བོགས་མེད་ཙ་ན་གསོལ་བ་འདེབས།",
    "ཉེ་གནས་ཀྱི་ཚ་བ་དྲང་བ་ཕྱག་ཏུ་བཞེས་པ་བྱུང་འདུག་སྟེ།",
    "འདི་ལྟར་ཡིན་བྱ་བ་མི་འདུག་ལམ་དུ་འཁྱེར་ལུགས་གཅིག་ཡོང་ངོ་ཞེས་སྙམ་ནས།",
    "ད་ལྟ་ཡང་སྐུ་ཁམས་ནམ་བཟང་ཙ་ན་འོང་གསུང་།",
    "དེའི་འཕྲོ་ལ་མནལ་སད་ཙ་ན།",
    "དེ་ཡང་རང་དང་ལྷ་འདྲེ་གཉིས་ཀ་ལ་རྟག་བརྟན་ཐེར་ཟུག་མི་འགྱུར་བའི་དངོས་པོ་ཅན་ཞིག་མེད་པས།",
    "སྡུག་བསྔལ་གྱི་རང་བཞིན་དུ་འདུག་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལ་གནས།",
    "དེ་ཡང་རང་ལ་ལྷ་འདྲེའི་གནོད་པ་ཡོད་ན།",
    "དེ་ཉིད་ཀྱི་ངོ་བོ་གསལ་སྟོང་བློ་བྲལ་དུ་རྗེན་ལྷང་ངེ་འདུག་སྟེ།",
    "རང་ཞི་ཙ་ན་བདུད་ཀྱང་ཞི་བ་ཡིན་རང་གནས་ཙ་ན་བདུད་ཀྱང་གནས།",
    "ཞེས་པ་ལ་སོགས་པ་གསལ་བར་འདུག་སྟེ།",
    "ལྷའི་ང་རྒྱལ་བརྟན་པོ་ཡིས་འདུག་སྟེ།",
    "གང་རུང་རུང་ལ་བྱས་ན་རང་ལ་གཟན་པར་འདུག་དམ་སེལ་ལམ་སྡིག་སྒྲིབ་འཆལ་བའི་སྐྱོན་ཡོད་པ་ལ་བྱས་ན།",
    "སྤྱན་སྔ་ནས་ཕྱག་ལེན་འགའ་མཛད་པར་འདུག་པ།",
    "འཛག་པའི་གེགས་འདི་ཡོང་བར་འདུག་སྟེ།",
    "ཉན་ཙ་ན་རྣ་བར་ཉན་པ་དེ་ལ་བསྒོམས་ཙ་ན་གཡུ་ཏོ་མི་འདུག་གསུང་།",
    "མཐོ་གང་ཙམ་ཕྱུར་ཡོད་པ་ལ་རིག་པ་གཏད་དམིགས་པ་འདི་གཉིས་ཀ་འདྲེན་འཕར་ཆེ་བས་ཆུན་ཆེ་བར་འཇུག་འཛག་པ་དྲུག་ཀ་བསྲུང་བར་འདུག་རྨི་ལམ་དུ་འཛག་ན་གཉིད་ལོག་ཁར་ཡང་མང་དུ་བསྒོམ།",
    "གྱད་ཀྱི་འདུག་སྟངས།",
    "ལན་གཉིས་གསུམ་གྱིས་གཟེར་བཏབ་པ་བཞིན་འགྲོ་བ་འདུག་སྟེ།",
    "རྩ་ཁ་ཕྱེས་ཏེ་ཆུ་བཞིན་འཛག་པ་ལའང་འཕྲལ་ལ་ཁེགས་པར་འདུག་ཟླ་བ་ཕྱེད་ཀྱིས་བར་ལ་བསྟེན།",
    "ཁ་ཅིག་ཕྱོགས་རྭ་རྣམས་དབུས་རྭ་ལ་ཕྱོགས་ནས་ཟུག་པའི་དོད་འབྱར་བ་ལྟ་བུར་མཛད་འདུག་ཀྱང་།",
    "རྒྱུན་དོན་རྒྱ་མཚོར་འདུག་པ་རབ་དཀའ་ཡང་།",
