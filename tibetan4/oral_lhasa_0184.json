    "དེས་རྟགས་ཀྱི་ཁྱབ་པ་གང་ཡིན་པ་དེ་ལ་ལྟོས་པར་བྱ་ཞིང་བརྟེན་པར་བྱ་སྟེ།",
    "བྱས་པ་ཉིད་ཀྱི་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "གལ་ཏེ་ཡང་མི་རྟག་པ་ཉིད་མཐའ་དག་ལ་བྱས་པ་ཉིད་ཁྱབ་པ་དེ་ལྟ་ན་ཡང་དེས་ཁྱབ་པ་ཉིད་ཀྱིས་དེའི་གོ་བར་བྱེད་པ་མ་ཡིན་གྱི་འོན་ཀྱང་རྟག་པ་ཉིད་བཀག་པས་སོ།",
    "མི་མཐུན་པའི་ཕྱོགས་ལས་ལྡོག་པ་མེད་པའི་གཏན་ཚིགས་ནི་བསྒྲུབ་པར་བྱ་བ་གོ་བར་བྱེད་པ་མ་ཡིན་པས་ཏེ།",
    "མ་བྱས་པ་ཉིད་བཀག་པ་སྟེ།",
    "མི་མཐུན་པའི་ཕྱོགས་མ་བྱས་པ་ཉིད་ལ་མེད་པས་སོ་ཞེས་པའི་དོན་ཏོ།",
    "རྣམ་པ་གཞན་དུ་མ་ཡིན་པ་དེའི་ཕྱིར་མི་རྟག་པའི་དོན་ལ་བྱས་པ་ཉིད་ཀྱིས་ཁྱབ་པ་ཉིད་གང་ཡིན་པ་དེས་ན་མ་བྱས་པ་ཉིད་ཀྱི་སྐབས་མེད་པའི་ཕྱིར་དང་།",
    "མི་རྟག་པ་ཉིད་ཀྱི་མ་བྱས་པ་ཉིད་ལ་སྐབས་མེད་པའི་ཕྱིར་ཏེ།",
    "མི་རྟག་པ་ཉིད་ཀྱིས་མ་བྱས་པ་ཉིད་དགག་པས་ཏེ་མ་བྱས་པ་བསལ་བས་གོ་བར་བྱ་བ་ཁོ་ནར་འགྱུར་རོ།",
    "མ་བྱས་པ་ཉིད་དགག་པས་ཞེས་པའི་ཚིག་ནི་སྒྲུབ་པའི་སྒོ་ནས་རྟོགས་པ་རྣམ་པར་བཅད་པའི་དོན་དུའོ།",
    "མི་རྟག་པ་ཉིད་ལ་བྱས་པ་ཉིད་ཀྱིས་ཁྱབ་པ་ནི།",
    "དེ་ལྟར་ནི་གང་མི་རྟག་པ་དེ་བྱས་པའོ་ཞེས་ཁྱབ་པ་ཉེ་བར་བསྟན་པ་ན་རྟག་པ་ལས་བྱས་པ་ཉིད་ལྡོག་པར་རྟོགས་པ་མ་ཡིན་གྱི།",
    "མ་བྱས་པའི་ཉིད་ལས་མི་རྟག་པ་ཉིད་ཀྱིའོ།",
    "དེའི་ཕྱིར་མི་རྟག་པ་ཉིད་ཁོ་ན་མ་བྱས་པ་ཉིད་ལ་སྐབས་མེད་པའོ་ཞེས་མ་བྱས་པ་ཉིད་དགག་པས་གོ་བར་བྱ་བ་ཁོ་ནའོ།",
    "བྱས་པ་ཉིད་ཀྱི་མི་རྟག་པ་ཉིད་ལ་སྦྱོར་བ་མ་ཡིན་ལ།",
    "བྱས་པ་ཉིད་ཀྱིས་འཇིག་པ་ལ་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "མི་རྟག་པ་ཉིད་ལ་བྱས་པ་ཉིད་ཀྱིས་ཁྱབ་པ་ལས་མི་རྟག་པ་ཉིད་ཀྱི་ཕྱིར་དེ་མ་བྱས་པ་མ་ཡིན་ནོ་ཞེས་པའི་དོན་འདི་སྐབས་སུ་བབ་པ་མ་ཡིན་པ་ཁོ་ནར་རྟོགས་པར་བྱ་ཞེས་བྱེད་པ་ཕྱིས་པས་ངེས་པར་བསྟན་པའོ།",
    "དེ་ནི་དེས་ཁྱབ་པས་བྱས་པ་ཉིད་ཀྱི་དོན་ལ་མ་བསྟན་ཏོ།",
    "དོན་འདི་ཁོ་ན་བསལ་བར་བྱ་བའི་ཆེད་དུ་ཚིགས་སུ་བཅད་པ་གཉིས་པས་དཔེ་གསུངས་སོ།",
    "འདིས་རྗེས་སུ་དཔག་པར་བྱའོ་ཞེས་བྱས་ནས་སོ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བའི་དོན་ཤེས་པ་ནི་འབྲས་བུའོ།",
    "དེས་ན་གཞན་ཁོ་ན་ཅུང་ཟད་ཅིག་དེ་རིག་པ་བརྗོད་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་པའི་དོན་རྟོགས་པར་འགྱུར་རོ།",
    "ངེས་པར་བསྟན་པ་ནི་ངེས་པར་སྟོན་པ་སྟེ།",
    "རབ་ཏུ་འབྲེལ་པའི་མི་མཐོང་བ་ནི་དབྱི་བའོ་ཞེས་བྱས་ནས་སོ།",
    "དེའི་བརྗོད་པར་བྱ་བ་རྣམ་པ་མང་བ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་བརྗོད་པར་བྱ་བ་མ་ཡིན་ན་ནི་གནས་ངེས་པར་མི་འགྱུར་ལ།",
    "འོ་ན་རྣམ་པར་རྟོག་པ་སྔ་མ་ལ་ཡང་ཅི་ཞིག་ཏུ་མཐོང་བ་ཞེས་བརྗོད་པར་བྱའོ་ཞེས་པ་འདི་བརྩད་པར་རིགས་པ་མ་ཡིན་ནམ།",
    "འདི་ཁོ་ནར་བརྩད་པར་བྱ་བ་ཅི་ཞེ་ན།",
    "གང་མེད་ན་དེ་འགྱུར་བ་མ་ཡིན་པ་དེ་ཁོ་ན་ལ་མཐོང་བའོ་ཞེས་མ་བརྗོད་ཀྱང་རྟོགས་པར་བྱ་བ་ཁོ་ན་སྟེ།",
    "དེའི་ཕྱིར་མཐོང་བའི་ཁྱད་པར་གྱི་དོན་དུ་དེའོ་ཞེས་རྟོགས་པར་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བ་སྐབས་སུ་བབ་པ་ཡང་ཞེས་པ།",
    "རྣམ་པར་དཔྱད་པ་ན།",
    "འདོད་པའི་དོན་ནི་ཕྱོགས་ཞེས་པར་རམ།",
    "ཡང་ན་བསྒྲུབ་པར་བྱ་བ་བརྗོད་པ་དམ་བཅའ་ཞེས་པ་འདིར་རོ།",
    "དེའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་ལ་མཐོང་བའོ་ཞེས་རྟོགས་པར་བྱའོ།",
    "དེ་ལས་ཀྱང་མེ་ལ་སོགས་པ་ལ་དུ་བ་ལ་སོགས་པ་མཐོང་བ་ན་མེ་ལ་སོགས་པ་རྣམས་ངེས་པ་ཁོ་ནར་འགྱུར་རོ་ཞེས་པས་དེ་རིགས་པས་རྗེས་སུ་དཔག་པར་བྱ་བ་གཞན་ཅི་ཞིག་ཡིན།",
    "འདིས་ནི་བསྒྲུབ་པར་བྱ་བ་ལ་མཐོང་བ་ཞེས་གང་བརྗོད་པ་དེ་ཡང་མི་རིགས་པར་གསུངས་སོ།",
    "དེ་ཁོ་ན་དུས་ཕྱིས་རྟགས་ཙམ་མཐོང་བས་རྟགས་ཅན་རྗེས་སུ་དཔག་པར་བྱ་བའོ་ཞེས་པས།",
    "ཇི་ལྟར་འབྲས་བུ་གཅིག་རོའི་སྒོ་ནས་མངོན་སུམ་དུ་བྱས་ནས།",
    "དེ་དང་མཚུངས་པ་ཉིད་ཀྱིས་ཉི་མའང་བགྲོད་པ་སྔོན་མ་ཅན་རི་ལ་རྒས་པ་ཐོབ་པར་རྗེས་སུ་དཔག་པར་བྱ་བ་ལྟ་བུའོ།",
    "རྒྱས་པར་བསྟན་པ་ཁོ་ན་ལས་གསུམ་ཉིད་དུ་གྲུབ་པ་ལ།",
    "རྣམ་པ་གསུམ་ཞེས་སྨོས་པ་ནི་སྔ་མ་དང་ལྡན་པའི་རྗེས་སུ་དཔག་པ་གཅིག་པུ་དུས་གསུམ་གྱི་ཡུལ་ཅན་ཉིད་ཀྱིས་རྣམ་པ་གསུམ་པ་ཉིད་དུ་ཤེས་པར་བྱ་བའི་དོན་དུའོ།",
    "འདིས་ནི་མ་ཁྱབ་པ་ཉིད་གསུངས་སོ།",
    "སྤྱིའི་ངོ་བོ་ཉིད་ཀྱི་ཕྱིར་དེ་ཡང་མངོན་སུམ་མ་ཡིན་པར་བསྒྲུབ་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་ངེས་པར་བསྟན་པ་མེད་པའི་ཕྱིར་རྗེས་སུ་དཔག་པར་ངེས་པར་བསྟན་པ་མ་ཡིན་པ་ཁོ་ནའོ།",
    "དེའི་ཕྱིར་གསུངས་པ།",
    "འོ་ན་ཁྱད་པར་དུ་གྱུར་པའི་གནས་སྐབས་ཐོས་པའི་ས་བོན་ལ་སོགས་པ་ནི་རྒྱུ་དངོས་ཉིད་དེ།",
    "དེ་མཐོང་བ་ལས་འབྲེལ་པ་དྲན་པ་ལ་ལྟོས་པ་ལས་རྗེས་སུ་དཔག་པར་བྱ་བ་རྟོགས་པར་འདོད་པ་ན།",
    "ཞེས་པ་ལ་སོགས་པས་འདི་ལ་ཡང་དེ་མ་ཐག་ཏུ་བརྗོད་པ་ཁོ་ནའི་སྐྱོན་གསུངས་སོ།",
    "དེའི་ཕྱིར་འབྲས་བུའི་ངོ་བོ་ཁོ་ནར་རྟོགས་པ་མེད་པར་གྱུར་པ་ན།",
    "བསྟན་བཅོས་ལ་མཐོང་བའི་འབྲས་བུ་ཉིད་འཛིན་པ་ལས་འདས་པ་འདིར་བརྗོད་པར་འདོད་ཀྱི།",
