    "དཔའ་རྟུལ་ཚོ་འགྲོ་མི་ཕོད་པར་རུ་སྣེ་ཁྲིག་གེར་བསྡད།",
    "ཡང་ཁྲབ་རྨོག་གྱོན་ཏེ་གྲི་ཕྱར་ནས་བཅར་བྱུང་བར་རྒྱལ་པོས་ཀྱང་རལ་གྲི་བཏབ་པས་ཁོས་གྲི་ངོ་མ་ལོན་པར་ཕུགས་སྒོ་ནས་བྲོས།",
    "བདུན་བྱས་ཏེ་གླིང་གེ་སར་རྒྱལ་པོ་ཡང་འུ་ཐུག་ཐབས་ཟད་དུ་གྱུར་པའི་སྣང་ལྷག་པར་དུ་དགྲ་ཕྱོགས་ཀྱིས་འདི་འདྲའི་སྤྲུལ་སྒྱུར་བརྙན་བཀོད་ཡོད་ལ།",
    "ཉག་ཕྲན་སོགས་ཀྱིས་ཀྱང་སྤྲུལ་སྒྱུར་གྱིས་མི་དོན་སྒྲུབ་ཐུབ་པར་མ་ཟད།",
    "དེར་ཤན་པ་འགྱེལ་ནས་ཡོད་པའི་སྤྱི་གཙུག་རྨ་ཁུང་ནས་བལྟས་པ་ན་བྱས།",
    "སྟེང་མ་ལྷ་ཡི་ཡུལ་ནས་སྐུ་རྗེ་སེང་ལགས།",
    "རྟས་མི་སྐད་སྨྲས་ནས་བཀག་པར་མ་ཟད།",
    "བར་དབུས་གཙང་རུ་བཞི།",
    "ཉག་ཕྲན་མདའ་དང་རྣོན་པོ་མཚོན་སོགས་འཁོར་གསུམ་གྱིས་སྤྲུལ་སྒྱུར་བྱས་པའང་སྒྲུང་དཔེའི་ནང་དུ་ཐོག་མཐའ་བར་གསུམ་དུ་མཐོང་ཐུབ།",
    "དུས་བསྐལ་པའི་ཆགས་འཇིག་ངེས་པར་སྟོན།",
    "གེ་སར་གྱིས་ཆིབས་པ་རྐྱང་རྒོད་དེ་ཙན་དན་གྱི་ཤིང་དྲུང་དུ་སྤྲུལ་ནས་ནགས་གསེབ་ཏུ་བཞུགས།",
    "དགྲ་ལྷ་མཆེད་དགུའི་བཞུགས་གནས་ཡིན།",
    "རྒྱ་ཆེའི་བོད་རིགས་ཀློག་པ་པོ་རྣམས་ཀྱིས་ཀྱང་དགའ་བསུ་མི་བྱེད་པར་མ་ཟད།",
    "གླིང་སྒྲུང་དུ་བོད་གདོད་མའི་ལྷ་སྒྲུང་སྐོར་རྒྱུད་འཛིན་བྱས་པ།",
    "གླིང་སྒྲུང་དུ་བོད་གདོད་མའི་ལྷ་སྒྲུང་སྐོར་རྒྱུད་འཛིན་བྱས་པ།",
    "ལྷ་སྒྲུང་ཞེས་པའི་ཐ་སྙད་འདི་བྱུང་བའི་རྨང་གཞིའི་སྟེང་ནས་མིའི་རིགས་ཀྱི་བློ་སྒོ་ཕྱེས་ཤིང་།",
    "འཇིག་རྟེན་ཆགས་རིམ་གྱི་ལྷ་སྒྲུང་།",
    "བ་ལྷའམ་རྗེ་བོ་བྱུང་ཚུལ་གྱི་ལྷ་སྒྲུང་།",
    "ལྷ་རི་རོལ་བའི་རྩེ་ལ་གཤེགས་ནས་ལྷ་སྐས་ལ་བབས་ཏེ་ཞེས་རྗེ་གཉའ་ཁྲི་བཙན་པོའི་བྱུང་བ་བརྗོད་པ་དང་།་",
    "སྲས་ཀྱིས་ཆིབས་ཁ་ཐུབ་པར་གྱུར་པ་ན།",
    "ཀ་ཞེས་པ་ལྟ་བུ་ནི་བོད་རྗེ་བྱོན་ཚུལ་དང་གཤེགས་ཚུལ་གྱི་ལྟ་བ་གཞིར་བཟུང་ནས་རྒྱུན་འཛིན་སོར་བཞག་བྱས་པ་དང་།",
    "དེ་ནི་བོན་གྱི་ལྷ་དང་རྗེ་བོ་གླིང་སྒྲུང་དུ་བོད་གདོད་མའི་ལྷ་སྒྲུང་སྐོར་རྒྱུད་འཛིན་བྱས་པ།",
    "ནམ་འཆི་ལ་མངོན་མཁྱེན་ཡོད་པ།",
    "ཞེས་པ་སོགས་ལས་འདབ་ཆགས་བྱ་དང་ཅང་ཤེས་རྟ་སོགས་ཀྱིས་ཀྱང་མི་སྐད་ཤེས་པར་མ་ཟད།",
    "དེ་དག་ཀྱང་ཏུན་ཧོང་གཏེར་ཡིག་ལས་བྱུང་བའི་རྒྱལ་པོ་གྲི་གུམ་བཙན་པོའི་བློན་པོ་ལོ་ངམ་གླིང་སྒྲུང་དུ་བོད་གདོད་མའི་ལྷ་སྒྲུང་སྐོར་རྒྱུད་འཛིན་བྱས་པ།",
    "ལྷ་སྒྲུང་དང་འདྲེས་པའི་སྒྱུ་རྩལ་ལ་མི་དགའ་མཁན་ཡང་མེད།",
    "གླིང་སྒྲུང་ལས་བྱུང་བའི་ལྷ་སྒྲུང་དེ་ཡང་བུ་དཔེ་ལས་མ་འདས།",
    "བྱ་རྨ་བྱས་སྒྲོ་གུར་ཕུབ་པ་འདྲ།",
    "མར་བསྡད་ན་གུར་ཁང་ཕུབ་པ་འདྲ།",
    "ཉ་སྲམ་མང་པོའི་སྲོག་གཟན་བྱས།",
    "གཡུ་བྱུ་རུ་མུ་མེན་ལ་སོགས་པས་སྐེ་རྒྱན་བྱས།",
    "ཀྱི་དགོས་པ་ཁོ་ན་ཡིན་ཞེས་གསུངས་པ་ལྟར་གླིང་གེ་སར་རྒྱལ་པོ་རྟ་རྒྱུག་ལས།",
    "སྤང་ཡང་མྱེས་མ་ཚིག་ཅེས་རྒས་ནས་རྣ་ལོག་པར་ཐོས་ཏེ།",
    "འོན་ཏང་ཆུ་དགུམ་སྲི་སྤང་ཡང་མྱེས་ཚིག་མཚོ་ཡང་སྐམས་ཤེས་ཐོས་ནསདྲི་གུམ་བཙན་པོར་མཚན་ཐོགས་ཤིག་ཅེས་འཁོད་པར་གཞིགས་དགུམ་གྱིས།",
    "རོང་ཚ་ཁྲ་རྒན་དང་འགོག་བཟའ་ཇོ་རུ་གཉིས་ཀྱི་སྔོན་དུ་ཕའི་རུས་མིན་པར་མ་ཡི་རུས་སྦྱར་ཡོད།",
    "དངུལ་གྱི་བཞོ་ཟུང་སོགས་ཀྱིས་མཛེས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "སྲམ་ཕྲུག་བརྒྱ་ཡིས་སྲུབས་ཟིན་བྱས།",
    "དེ་ནས་རུ་ཁྲ་བཙན་གྱིས་རག་བཟའ་སེམས་སྐྱིད་སྒྲོལ་མ་ཁབ་ཏུ་བཞེས།",
    "དགུང་ལོ་གྱ་གཅིག་པར་སྐུ་མྱ་ངན་ལས་འདས་པའི་ཚུལ་བསྟན་ཏོ།",
    "ཆུ་ཤེལ་ཟླ་བའི་རང་མཛེས་མའི་ཡོན་ཏན་ཐམས་ཅད་འཛོམས་པ་དེ་ཁབ་ཏུ་བཞེས་མདངས་ཅན།",
    "ཕྱིས་སུ་མང་ཤས་ཤིག་གཡུལ་འཁྲུག་ལས་བཀྲོངས་པར་གྲགས་སྐད་དོ་ཅང་རྒྱ་ཚ་ཞལ་དཀར་ནི་གླིང་སེང་བློན་རྒྱལ་པོའི་བུ་ཆེ་བ།",
    "མ་ཡུམ་རྒྱ་བཟའ་ལྷ་སྐྱིད།",
    "མདའ་མི་འགྱུར་གནམ་ལྕགས་ཐོག་མདའ་དགྲ་ལྷ་གཉན་སྟག་དམར་པོས་གནང་བ་ཡིན།",
    "གཡུལ་འཐབ་གང་མང་ཞིག་ཏུ་བྱས་རྗེས་བགྲང་ལས་འདས་པ་བཞག་པ་དང་།",
    "དེར་སེང་བློན་གྱིས་སྙོར་སྐྱོང་ཡག་པོ་བྱས་པ་ན།",
    "མ་འགྱངས་པར་དེ་ཁ་གས་ཏེ་ཁྱེའུ་མཛེས་སྡུག་ལྟ་བས་མཆོག་མི་ཤེས་པ་ཞིག་འཁྲུངས།",
    "རིམ་བཞིན་ནར་སོན་པ་ན་ལྷོ་བཟའ་བེཌཱུརྱ་སྒྲོལ་མ་ཁབ་ཏུ་བཞེས་ནས་སྲས་གཅིག་ཡོད་པར་གྲགས།",
    "དགུང་ལོ་བཅུ་དྲུག་སྟེང་འདན་བཟའ་གངས་དཀར་འཚོ་ཁབ་ཏུ་བཞེས་ནས་རྒྱལ་སྲིད་བསྐྱངས།",
    "སྐུ་ལ་ན་བ་ཆེན་པོ་བྱུང་སྟེ་བཟློག་མ་ནུས་པར་སྐུ་མྱ་ངན་ལས་འདས་པའི་ཚུལ་བསྟན་ཏོ།་",
    "ཉི་འབུམ་གྱིས་དགུང་ལོ་བཅོ་བརྒྱད་ཐོག་གསེར་བཟའ་དམ་ཚིག་སྒྲོལ་མ་ཁབ་ཏུ་བཞེས་ཏེ་སྟོད་གླིང་གསེར་བའི་ཁྲི་དཔོན་མཛད།",
    "གྲུང་འཛོམས་པས་མ་ལུས་ཤེས་བྱའི་གནས་ལ་ཐོགས་པ་མེད་པར་མཁས།",
    "གླིང་སེང་ཆེན་སྐྱེས་བུ་མ་འཁྲུངས་གོང་མི་གདོང་བཙན་དང་རྟ་གཡུ་བྱའི་རྗེས་ལ་ཆོད་མཁན་གཅིག་ཀྱང་མེད་པར་གླེང་ངོ།",
    "བློ་རིག་འཛོམས་པའི་ཁྲི་སྟོང་མང་པོའི་བློ་གྲོས་ཀྱི་རྩལ་ལས་ཐོན་པ་ཡིན་ལསྒྲུང་པ་དེ་དག་ལ་ཤིན་ཏུ་ངོ་མཚར་ཆེ་བའི་བརྒྱུད་རིམ་མཆིས་པ་ལས་གཞན་ཐོག་ནས་ཐོགས་པ་མེད་པར་སྒྲུང་དཔེ་བརྒྱ་ཕྲག་དུ་མ་བློར་ངེས་ཤིང་ངག་ཁོང་རྣམ་པའི་ཁྲོད་དུ་བབས་སྒྲུང་དང་པྲ་སྒྲུང་།",
    "གཤམ་དུ་གཏེར་སྒྲུང་རིགས་ཀྱི་སྒྲུང་པའི་སྐོར་ལ་རགས་ཙམ་དཔྱད་པར་བྱའོ།",
    "ཐོགས་པ་མེད་པར་གྱུར་པའི་སྒྲུང་པའི་རིགས་དེ་ལ་ཟེར་བར་གྲགས་ཤིང་།",
    "སྒྲུང་དཔེ་སྣ་ཚོགས་བརྒྱ་དང་ཉི་ཤུ་ལྷག་འབྲི་ཤེས་པ་ལགས།",
    "ས་འོག་གཏེར་གྱིས་གང་ཟེར་བའི་ས་འོག་ནི་ས་གཏེར་ལ་གོ་དགོས་པ་ལགས།",
    "གཉིས་ནི་སྒྲུང་གཏེར་དང་རྫས་གཏེར་བར་དུའང་ཁྱད་པར་ཆེན་པོ་ཡོད་པ་སྟེ།",
    "ཕྱིར་འདོན་མཁན་ཡང་སྔར་ནས་གཏན་ཁེལ་བྱས་ཡོད།",
    "རྒྱལ་པོ་དམག་བརྒྱ་བ་ཞེས་པའི་རྒྱལ་རྒྱུད་ལས་མཆེད་པ་ཡིན་པར་གསུངས།",
    "ད་དུང་གཏེར་སྦ་བའི་དགོས་པ་བཅས་ཡོད་པར་གསུངས་པ་ལགས།",
    "ང་ནི་ཕྱི་དུས་མྱ་ངན་འདས་བྱས་ནས།",
    "སྐུ་གདུང་ཐམས་ཅད་རྒྱས་པར་བྱས་གྱུར་ཏེ།",
    "བྲིས་ནས་སྒྲོམ་གྱི་ནང་དུ་བཅུག་བྱས་ནས།",
    "བསམ་པ་ཇི་བཞིན་དུ་ནི་བྱེད་པར་འགྱུར།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "བསམ་པ་ཇི་བཞིན་དུ་ནི་བྱེད་པར་འགྱུར་ནི།",
    "གཙུག་ལག་ཁང་སོགས་སུ་མི་འཇིག་པའི་ཕྱག་རྒྱས་བཏབ་སྟེ་སྦ་བར་གནང་བ་དང་།",
    "ཅེས་གསུངས་པ་ལྟར།",
    "བོད་གངས་ཅན་གྱི་མཐའ་དབུས་ཐམས་ཅད་གཏེར་གྱིས་བཀང་བ་དང་གནས་མཆོག་ཡུལ་འདིར་རྒྱུ་བའི་སྐྱེ་དགུ་རྣམས་ཀྱི་ཕན་བདེའི་རྩ་ལག་ནི་དུས་བབ་ཀྱི་ཟབ་གཏེར་ལ་རག་ལས་ཡོད་པར་བསམས་ཤིང་།",
    "ཡི་གེར་བྲིས་ན་ཐོགས་པ་མེད་པར་སྒྲུང་དཔེ་བརྒྱ་ཕྲག་ལྷག་འབྲི་ཤེས་པ་དང་།",
    "འབྲི་བའི་སྐབས་སུའང་སྒྲུང་པ་ལ་ལ་གདན་ལ་བཞུགས་ནས་ཤོག་ཐོག་ལ་འབྲི།",
    "ངས་བསྔོ་བ་བཞིན་དུ་ཐོབ་པར་ཤོག།",
    "གླུ་ཤགས་ལྟ་བུའི་ཚིག་སོགས་ཀྱིས་གོང་འོག་བར་གསུམ་དུ་བཅིངས་ཡོད།",
    "དེར་སེང་བློན་གྱིས་སྐྱོང་སྙོར་ཡག་པོ་གནང་བས་ན།",
    "སེམས་མ་གཡེངས་དལ་ཅིག་མཉམ་པར་ཞོག།",
    "ཁོ་བོའི་བསམ་པར་གཏེར་སྒྲུང་རིགས་ཀྱི་གཏེར་སྒྲུང་རིགས་ཀྱི་གེ་སར་སྒྲུང་པའི་སྐོར་ལ་དཔྱད་པ།",
    "སྒྲུང་པར་གྱུར་པའི་རྒྱུ་རྐྱེན།",
    "དམྱལ་གླིང་མུན་པ་རང་གསལ་མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་ནས་པར་སྐྲུན་བྱས།",
    "འོན་ཀྱང་དྲན་པའི་སྣང་ངོར་བག་ཆགས་ཆེས་ཟབ་པ་ནི་དམྱལ་གླིང་མུན་པ་རང་གསལ་ཞེས་པའི་སྒྲུང་དཔེ་འདི་ཉིད་ལགས་པས།",
    "གེ་སར་རྒྱལ་པོ་རྒྱ་ཡི་ཡུལ་དུ་ཕེབས།",
    "ལྷ་ཡི་དམ་རྡོ་རྗེ་འཇིགས་བྱེད་མཁྱེན།",
    "མི་ཅི་འདྲ་ཞིག་ཡོད་ལྟོས་ལ་ཤོག་ཅེས་གསུངས་པ་ན།",
    "གོང་དུ་རགས་བསྡུས་སུ་ངོ་སྤྲོད་བྱས་པ་འདི་ལས་སྒྲུང་དཔེ་འདིའི་དགོས་པ་དང་ཉིང་དགོས།",
    "དེ་ཡང་དམྱལ་གླིང་མུན་པ་རང་གསལ་ཞེས་པའི་སྒྲུང་དཔེའི་ནང་མི་སྣ་ཞིབ་འབྲི་བྱས་པ་འབུར་དུ་ཐོན་པར་མ་ཟད།",
    "སྤྱན་ཉི་ཟླ་ལྟར་འཁོར་ཞིང་བཞུགས་ལ།",
    "བྱེའུ་རི་བོང་རྒུམ་བུ་འཐུ་འཐུ་བྱས།",
    "ཉ་སྲམ་མང་པོའི་སྲོག་གཟན་བྱས།",
    "ཕྱི་ཇག་དང་རྐུན་མའི་འགོ་པ་བྱས།",
    "དེ་ནས་བཟུང་མ་བུ་གཉིས་ཀ་འབའ་ཞིག་ཤུལ་དུ་ལུས་པས་དཀའ་སྡུག་མང་པོའི་འཚོ་བའི་ཁྲོད་དུ་འཚོ་ཐབས་དང་གསོན་ཐབས་བྱས་པས་སོ།",
    "ཆེད་ལས་མཁས་པ་དག་རྩ་འཛུགས་བྱས་ནས་ཁོས་བྲིས་པའི་སྒྲུང་ལ་དཔྱད་པ་བཏང་རྗེས།",
    "ཁོར་གཟི་བརྗིད་ཀྱི་མཚན་སྙན་དང་བྱ་དགའ་དག་ཐོབ་ཀྱང་ང་རྒྱལ་སྤུ་ཙམ་ཡང་མེད་པར་སྔར་ལས་ལྷག་པའི་སྡུག་རུས་ཀྱིས་སྒྲུང་དཔེ་མུ་མཐུད་དུ་བྲིས་པར་བརྟེན།",
    "ཅཤོག་སྟེང་གཙང་ཞིང་གཞན་གྱི་མ་ཡིག་ལས་སོ་མ་བཤུས་པ་བཞིན་ཡི་གེ་གཅིག་ཀྱང་བསུབས་མེད།",
    "གཏེར་སྒྲུང་ལའང་དངོས་གཏེར་དགོངས་གཏེར་གཉིས་ཡོད་པ་ལས་དགོངས་གཏེར་ལ་གཏོགས་པར་བཤད།",
    "སྐབས་དེར་སྒྲ་འཛིན་རྣ་བས་རྟ་ཕོ་མང་པོའི་འཚེར་རྒྱང་དང་ཁྲབ་རྨོག་དང་མདའ་མདུང་གྲི་གསུམ་གྱི་སིང་སྒྲ་ཐོས་པར་མ་ཟད།",
    "ཕེབས་ཡོང་ནས་འདི་སྐད་དུ།",
    "ད་ལྟ་སྒྲུང་ཁག་སྒྲར་ཕབ་ཟིན་པ་དང་སྒྲུང་ཁག་ཡི་གེར་བཀོད་ནས་དག་སྒྲིག་བྱས་ཟིན།",
    "འཁྲུངས་གླིང་དང་རྟ་རྒྱུག་རྒྱལ་འཇོག་བདུད་གླིང་ཧོར་གླིང་གཡུལ་འགྱེད་སྟོད་སྨད་ཆ་བཅས་བཞི་ནི་ལེགས་སྒྲིག་གནང་ནས་ཡོངས་སུ་གྲུབ་ཅིང་།",
    "ད་ལྟ་མི་རིགས་དཔེ་སྐྲུན་ཁང་ནས་པར་སྐྲུན་བྱེད་པའི་སྐལ་བ་ལྡན་པ་ལགས།",
    "པར་སྐྲུན།",
    "ལས་འགན་འདི་ཕྲག་པང་ ཏུ་བཞག་ན་བློ་ཁེལ་བའམ་ཡིད་ཆེས་བརྟན་པོ་ཡོད་པར་བརྟེན།",
    "འབད་འབུངས་ལྷོད་མེད་ཀྱིས་ལེགས་སྒྲིག་བྱས་ཤིང་།",
    "དེ་དག་ལས་སྒྲུང་དཔེ་ཧོར་གླིང་གཡུལ་འགྱེད་སྟོད་སྨད་ཆ་དང་དམྱལ་གླིང་མུན་པ་རང་གསལ་རྨ་ཤེལ་བྲག་བདུད་འདུལ་འཇང་གླིང་གཡུལ་འགྱེད་བསྡུས་སྒྲུང་སོགས་ལེགས་སྒྲིག་པར་སྐྲུན་གྱི་ཆུ་ཚད་ཅུང་མཐོ་བར་བརྟེན།",
    "ལེགས་སྒྲིག་དང་པར་སྐྲུན་ཡང་བྱེད་བཞིན་པའི་སྒང་ཡིན།",
    "བོད་ལྗོངས་ཀྱིས་པར་སྐྲུན་གནང་བའི་སྒྲུང་དཔེར་ལེའུ་མེད།",
    "མཚོ་སྔོན་དང་པེ་ཅིན་དུ་པར་སྐྲུན་གནང་བའི་སྒྲུང་བཀར་མེད་པ་དང་།",
    "ད་དུང་སི་ཁྲོན་དང་ཀན་སུའུ་སོགས་སུ་པར་སྐྲུན་གནང་བའི་བཞག་ཡོད།",
    "གཅེས་བཏུས་ལེགས་སྒྲིག་བརྒྱུད་དེ་དོན་གྱི་འགལ་བ་དང་མིང་བརྡའི་རྙོག་དྲ་སོགས་སེལ་ནས་གླིང་སྒྲུང་ཐམས་ཅད་གཅིག་གྱུར་ཚད་ལྡན་ཡོང་བར་བྱེད་པར་དགོས་པ་བསམ་གྱིས་མི་ཁྱབ་པ་མཆིས་སོ།་།",
    "ཡོ་རོབ་རྩོམ་རིག་འཕེལ་རྒྱས་སུ་གཏོང་བ་ལ་གྲུབ་འབྲས་མི་དམན་པ་བསྐྲུན་པར་མ་ཟད།",
    "ད་ལྟ་ཡང་འོད་ཟེར་རྣམ་པར་འཕྲོ་བའི་རིན་ཆེན་ནོར་བུ་ཞིག་ཏུ་རྩི་བཞིན་ཡོད།",
    "ཕྱིས་སུ་ཡང་ཆེད་ལས་མཁས་པ་རྣམས་རྩ་འཛུགས་གནང་སྟེ་དེང་རབས་ཀྱི་ཚད་ལྡན་གླེགས་བམ་དུ་པར་སྐྲུན་བགྱིས་ཡོད།",
    "ཧྥིན་ལན་རྒྱལ་ཁབ་ཀྱི་སྐད་གྲགས་ཆེ་བའི་ཁ་ལེ་བ་ལ་ཞེས་པ་ཡང་དེ་བཞིན་དུ་གཙིགས་འཛིན་དང་ལེགས་སྒྲིག་པར་སྐྲུན་བགྱིས་མྱོང་།",
    "བཞིགླིང་སྒྲུང་གཅེས་བཏུས་དེབ་བཞི་བཅུ་ཆ་ཚང་སྤུས་ལེགས་ངང་པར་སྐྲུན་གནང་རྗེས་མི་སྣ་རྩ་འཛུགས་བགྱིས་ཏེ་ཡིག་སྒྱུར་གྱི་འགོ་བརྩམས་ཏེ་རྒྱ་ཡིག་དང་སོག་ཡིག་བཅས་མི་རིགས་གཞན་པའི་ཡི་གེར་བསྒྱུར་ཆོག་པར་མ་ཟད།",
    "རྗོད་བྱེད་ཚིག་དང་མིང་བརྡ་སོགས་གཅིག་གྱུར་ངང་ལེགས་སྒྲིག་བགྱིས་ཡོད་པ་དང་སྒྲུང་དཔེའི་སྲབ་མཐུག་དང་རྒྱབ་ཤོག་བཅས་ཀྱང་གཅིག་གྱུར་བྱས་ཡོད་པས་ངེད་ཅག་རྣམས་ཀྱིས་འདི་ཚད་གཞིར་བཟུང་ནས་ཡིག་སྒྱུར་མཛད་ན།",
    "གླིང་སྒྲུང་གཅེས་བཏུས་ཞེས་པར་བསྡོམས་པས་སྒྲུང་དཔེ་ལེགས་སྒྲིག་པར་སྐྲུན་བྱེད་རྒྱུ་དང་།",
    "གླིང་སྒྲུང་གཅེས་བཏུས་ཀྱི་མིང་ཚིག་ཐ་སྙད་ཡོད་དོ་ཅོག་གཅིག་གྱུར་ཚད་ལྡན་དུ་གཏོང་དགོས་པར་མ་ཟད།",
    "བར་དབུས་གཙང་རུ་བཞི།",
    "མ་འགྱངས་པར་ཧོར་དམག་ཁྲི་ཕྲག་མང་པོ་གླིང་ལ་དྲངས་ཏེ།",
    "ཧོར་གླིང་གཉིས་བགྲང་བྱ་མང་པོའི་རིང་ལ་གཡུལ་འགྱེད་དྲག་པོ་བྱས་ནས།",
    "ཚིག་དོན་མི་འགལ་བར་ཁ་འགེངས་དགོས་པ་རྣམས་ཀྱིས་ལེགས་པར་ཟུར་བརྒྱན་པར་བརྟེན།",
    "ལྕགས་ལོ་བཅས་ལ་དེབ་འདི་ལེགས་སྒྲིག་དང་ཞུ་དག་གནང་དགོས་ཀྱི་སྐུལ་མ་ཞུས་པ་ལྟར།",
    "སྒྲུང་དཔེ་འདྲ་མིན་ལྔ་ཙམ་ལ་ཞིབ་བསྡུར་བྱས་ནས་ལེགས་ཆ་གང་ཡོད་སྡུད་ཅི་ཐུབ་དང་།",
    "སྟོད་ཆ་དེ་སྤྱི་ལོ་ལོར་མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་ནས་དངོས་སུ་པར་སྐྲུན་འགྲེམ་སྤེལ་གནང་བ་དང་།",
    "སྨད་ཆ་དེ་སྤྱི་ལོ་ལོར་པར་སྐྲུན་འགྲེམ་སྤེལ་གནང་བའོ།",
    "གཤམ་དུ་གསར་དུ་ལེགས་སྒྲིག་བྱས་པའི་སྐོར་རགས་ཙམ་ངོ་སྤྲོད་བྱའོ།",
    "གཞན་ཡང་ཧོར་གླིང་གཡུལ་འགྱེད་ཅེས་པ་དང་ཧོར་འདུལ་ཞེས་པའི་སྤྱི་མིང་ལ་ཧོར་གླིང་གཡུལ་ཆེན་ནམ་ཧོར་གླིང་གཡུལ་འགྱེད་སྟོད་སྨད་ཆ་ཞེས་པའི་འདོགས་ལུགས་གཉིས་ཡོད་པ་ལས་ཕྱི་མ་ལེགས་པར་སྙམ་ནས་སོར་བཞག་བྱས་ཡོད།",
    "ལྟ་བུ་སུམ་རྟགས་ཀྱི་ཚིག་ཕྲད་ཀྱི་འཇོག་ཚུལ་དང་མི་མཐུན་པའང་སོར་བཞག་བྱས་ཡོད།",
    "གཞན་ཡང་སྐྱིད་ཏོ་བསམ་མམ་སྡུག་ཏོ་བསམ་ལྟ་བུ་ཡང་རྗེས་འཇུག་ལྟར་དག་སྒྲིག་བྱས་པ་ཡིན་ཡང་སྔར་ཡོད་ཀྱི་ཚིག་ཉམས་མི་ཤོར་བ་རྣམས་དག་བཅོས་བྱས་པ་ལས།",
    "གུར་དཀར་རྒྱལ་པོ་སྤྲེལ་མགྱོགས་བྱས་ཚུལ།",
    "ད་དུང་ལེའུ་དང་ནང་དོན་མི་མཐུན་པའམ་འགལ་བ་ཡོད་པ་དག་མཐུན་པར་བསྒྲིགས་ཏེ་ཚིག་རྒྱན་ཡོད་ཚད་སེལ་ཅི་ཐུབ་བྱས་ཡོད།",
    "པར་གཞིའི་སྒྲིག་སྟངས་ཀྱང་གླིང་སྒྲུང་གཅེས་བཏུས་ཀྱི་སྒྲིག་སྲོལ་ལྟར་གསར་དུ་བཅོས་པ་ཡིན།",
    "སྤང་དོར་བྱས་ཀྱང་དོན་ལ་མི་འགལ་བའི་སྐོར་ཕལ་ཆེར་ཡིག་འབྲུ་ཁྲི་ཕྲག་བཞི་ལྷག་ཉུང་འཕྲི་བྱས་ཡོད།",
    "ལས་དོན་འདིར་རྒྱབ་རོགས་དང་ཐུགས་ཁུར་གནང་བའི་སྐོར།",
    "ཁྱད་པར་དུ་མཁས་པ་རྣམས་ཀྱིས་ཞུ་དག་མཛད་པ་བཅས་གསལ་བོར་བཀོད་ཡོད།",
    "དེའི་ཕྱིར་འདི་ནི་གླིང་སྒྲུང་གཅེས་བཏུས་ཀྱི་སྔོན་ཁྲིད་པ་དང་ཚད་ལྡན་པ་ཡིན་པར་བརྟེན་རྗེས་མའི་སྒྲུང་དཔེ་ཡོད་དོ་ཅོག་དག་སྒྲིག་པར་སྐྲུན་བྱེད་བའི་སྐབས་སུ་བློ་སེམས་འགྱུར་བ་མེད་པར་མ་དཔེར་བཟུང་ནས་ཇི་མ་ཇི་བཞིན་དུ་ལེགས་སྒྲིག་བྱེད་དགོས་པ་ལགས།",
    "འབྲེལ་ཡོད་ཀྱི་ཡིག་རིགས་གལ་ཆེན་སྐོར་ཉར་ཚགས་བྱེད་པ་སོགས་ནན་འཛིན་བྱེད་དགོས་པ་ལགས།",
    "དེ་ཡང་གླིང་རྗེ་གེ་སར་རྒྱལ་པོའི་སྒྲུང་ནི་གངས་ཅན་ལྗོངས་ཡོངས་སུ་མི་རབས་ནས་མི་རབས་བར་དུ་ཁྱབ་དང་ཁྱབ་བཞིན་ཡོད་པར་མ་ཟད།",
    "གལ་སྲིད་ངེད་ཅག་རྣམས་ཀྱིས་མ་སྐུལ་དང་བླངས་སྒོས་བྱ་བ་འདི་གཙིགས་འཛིན་བགྱིས་ནས་མིང་བརྡ་དག་གཙང་མ་མ་གནང་ན།",
    "དེའི་ཕྱིར་རྣམ་དཔྱོད་ཡངས་པའི་མཁས་པ་རྣམ་པས་དགོངས་འཆར་ཅི་མཆིས་དོགས་མེད་ཀྱིས་གནང་བར་མཛོད།",
    "ཁྱད་པར་དུ་བར་ཁམས་ཀྱི་ས་ཆ་འདིར།",
    "ཡབ་བདེ་མཆོག་དཀར་པོ་དང་ཡུམ་བདེ་མཆོག་དམར་པོའི་སྲས་གསུམ་པ་ཡིན་པར་གྲགས་པ་དང་།",
    "གཞན་ཡང་ཁོང་ལ་ལྷ་སྲས་ཐོས་པ་དགའ་དང་།",
    "ཞྭ་ལྷམ་ན་བཟའ་སོགས་དངོས་པོ་མང་པོ་ཡོད་པར་མ་ཟད།",
    "ཡིན་ནའང་ཧོར་དམག་མང་དྲགས་པས་ཁོང་མི་གཅིག་པུས་འགྲན་ཟླ་མ་ནུས་པར་མཐའ་མར་ཚེ་སྲོག་ཤོར།",
    "ཧོར་ལ་མགོ་སྐོར་གཏོང་བའི་མནའ་མ་རྫུན་པར་འགྲོ་མྱོང་།",
    "ཕྱིས་སུ་སྐད་ཟུར་ཆག་སྟེ་སེང་འབྲུག་སྟག་རྩེ་ཞེས་བརྗོད་པ་འདྲ་ཞེས་ཀྱང་གསུངས་སོ།",
    "དེར་སྤྱི་དཔོན་ཁྲ་རྒན་ཉིད་ནར་སོན་ཏེ་དགུང་ལོ་བཅུ་གསུམ་བཞེས་པའི་དུས་སུ།",
    "སྟོད་རྒྱ་གར་དང་བར་དབུས་གཙང་།",
    "བདེ་ཞིང་སྐྱིད་པའི་འཇིག་རྟེན་གསར་བ་ཞིག་བསྐྲུན་རྒྱུ་དེ་ལགས་ཟེར་རོ།་།",
    "སེར་པོ་ཧོར་ཞེས་པའི་ཐ་སྙད་འདིར་སྔོན་བྱོན་བོད་ཀྱི་མཁས་པ་དང་དེང་རབས་ཀྱི་མཁས་པ་བགྲེས་གཞོན་མང་པོས་དཔྱད་པ་གང་མང་བཏང་ཡོད་ཀྱང་ཁོ་བོའི་བསམ་པར་གཤམ་གྱི་མཁས་པ་འགའི་ལྟ་བར་བློ་གཏད་ཆོག་པར་སྙམ།",
    "དུས་རྒྱུན་པར་རྒྱ་མཚོའི་ནང་དུ་ནོར་བུ་ལེན་པར་འགྲོ་བའི་སོག་པོ་སྟེ།",
    "ཞེས་པའི་རིགས་རྒྱུད་ཆེ་བ་དེ་ཡིན་པར་སྙམ།",
    "ཞེས་བཀོད་ཡོད་ལགས།",
    "ཆེ་བ་ནོར་བུ་དགྲ་འདུལ་དེ་ཞིང་ཁམས་དེ་བསྐྱུར་ནས་འགྲོ་མ་འདོད་པར་ལྟ་བ་ལོག་པས་བྱང་ཕྱོགས་ཀླུ་བཙན་རྒྱལ་པོའི་ལུས་བླངས།",
    "ཡིན་ནའང་གུར་དཀར་རྒྱལ་པོ་དེ་བཙན་པོ་སྒེར་གཅོད་དང་ཧམ་སེམས་ཆེན་པོ་ཅན་ཞིག་ཡིན་པར་བརྟེན།",
    "རྐྱེན་དེ་ལ་བརྟེན་ནས་ཕྱིས་སུ་གླིང་རྗེ་གེ་སར་རྒྱལ་པོ་ཧོར་ཡུལ་དུ་ཕེབས།",
    "གུར་དཀར་རྒྱལ་པོ་གསོན་བཟུང་བྱས་ནས་གཉའ་སྒ་བསྟད་དེ་ཧོར་སེར་ཆམ་ལ་ཕབ་ནས།",
    "གུང་རྗེ་གཡུ་ཡགམཆོང་ལྷ་སྨུག་པོ།",
    "ཁྱེད་རྣམ་དཔྱོད་ཀྱི་བློ་གྲོས་མཁའ་ལྟར་ཡངས་པའི་མཁས་པ་རྣམས་ཀྱིས་དགོངས་འཆར་གནང་བར་མཛོད།",
    "གླིང་སྒྲུང་ཐོག་གླིང་གཡུལ་འགྱེད་ནི་མི་རབས་བཞི་ལ་སྒྲུང་དཔེ་ལེགས་སྒྲིག་གནང་མྱོང་བའི་ཁྱིམ་རྒྱུད་ཀྱི་རྒན་པོ་བུ་ཐུབ་དགའ་ཕ་བུ་གཉིས་ཀྱིས་དཀའ་ཚེགས་འོ་བརྒྱལ་ལ་མ་འཛེམས་པར་དག་སྒྲིག་བྱས་ཤིང་།",
    "པོར་པར་སྐྲུན་བགྱིས་པའི་སྒྲུང་དཔེ་ཡིན་པར་བརྟེན།",
    "མི་མིང་ས་མིང་མཚོན་མིང་སོགས་གཅིག་གྱུར་མིན་པ་རྣམས་གཅིག་གྱུར་བྱས་ཏེ།",
    "ཡིག་ནོར་དང་སྦྱོར་བ་མི་བདེ་བ་དག་ལ་འཕྲི་སྣོན་བྱས་ཡོད་ཅིང་།",
    "ཐོག་གླིང་གཡུལ་འགྱེད་ཀྱི་སྐབས་སུ་སེང་ཆེན་རྒྱལ་པོས་སྟ་གྲི་ཧར་གཤགས་ཀྱིས་ལྔ་བའི་ལམ་དུ་བརྫངས་སོ།",
    "ཐོག་གླིང་གཡུལ་འཁྲུག་སྐབས་སུ་ཁོ་ནི་བློ་སེམས་གླིང་ལ་དཀར་བས་ཐོག་རུ་རྒྱལ་པོ་ཕམ་པར་བཟོ་བའི་ཐད་ལ་རོགས་འདེགས་གང་ལེགས་བགྱིས།",
    "ཕ་རོལ་གྱི་དགྲ་ལས་རྣམ་པར་རྒྱལ་བར་འཇུག་པའི་དགྲ་འཐབ་ཀྱི་ལྷ་དེ་ལ་ཟེར་རོ།",
    "སྟ་ཆེན་བྲག་རི་ཧར་གཤགས་ནི།",
    "ཞེས་བྲིས་ཡོད་པ་ལྟར་དང་ཐོག་རུ་ནམ་མཁའ་རྒྱལ་མཚན་ཆམ་ལ་ཕབ་བྱེད་ཀྱི་ལག་ཆའང་སྟ་ཆེན་བྲག་རི་ཧར་གཤགས་འདི་ཡིན་ནོ།",
    "དཔའ་བོ་ངར་འཐབ་ཀྱིས་ཤི་བས་མཐོ་རིས་སུ་བགྲོད་མ་ཐུབ་པར་ཐོག་རུའི་ཡུལ་དུ་སེར་རྒོད་འབུམ་ཐུབ་ཅེས་འགྲན་ཟླ་བྲལ་བའི་བློན་པོ་ཞིག་ཏུ་སྐྱེས།",
    "ཚོང་རྫས་ཡོད་ཚད་ཧབ་ཐོབ་བྱས་པར།",
    "ས་ཁའི་རྩི་ཏོག་ལས་གྲངས་མང་བ་ཞིག་བྱས་ནས་བྱང་བྱེ་རིའི་ཡུལ་དུ་ཆས་ཤིང་།",
    "བྱེ་རིའི་ལས་དམག་མང་པོ་ཆམ་ལ་ཕབ་པ་དེ་བྷེ་ཧར་སོག་ཁ་རྒྱལ་པོས་མཐོང་བས་ལྷ་སྲས་དགྲ་ལྷ་རྩེ་རྒྱལ་ལ་མགོ་འབུལ་བྱས།",
    "ཐོད་དཀར་གླིང་ལ་བརྒྱུགས་ནས་གཡུལ་ཉེས་ཆེ་ཙམ་བཟོས་ཡང་མཇུག་མཐར་འཇང་སྲས་གཡུ་ཁྲིས་ཞགས་པ་འཕངས་ནས་གསོན་བཟུང་བྱས།",
    "སསྒྲུང་ཁག་ལྔའི་ནང་དོན་དང་ལེགས་སྒྲིག་མིང་བརྡའི་སྐོར་གྱི་འགྲེལ་བཤདཆུང་དུས་མཚན་དོན་ཀུན་གྲུབ་པར་གྲགས།",
    "ཡང་དག་པར་འཛིན་པ་སྟེ་བརྟག་པའི་དངོས་པོའམ་དམིགས་པ་ལ་སེམས་རྩེ་གཅིག་སྦྲེང་ཆགས་སུ་འཛིན་པའི་སེམས་བྱུང་ངོ།",
    "རྡོ་ལ་མ་ཎི་ཡིག་དྲུག་རྟེན་བཞེངས་བཤགས་སྦྱངས་སྐོར་བ་སོགས་དང་།",
    "ལེགས་ཆ་ཡོད་ཚད་གང་ནུས་ཀྱིས་བསྡུ་ཅི་ཐུབ་བྱས་ཡོད་པར་མ་ཟད།",
    "ཡུལ་དེ་རུ་གསེར་དངུལ་ཟངས་ལྕགས་ཀྱི་གཏེར་མང་པོ་མཆིས་ས་པར་མ་ཟད།",
    "ལྷོ་ཨ་བསེ་ཡུལ་གྱི་སྲིན་པོ་དང་གླིང་དཔའ་རྟུལ་རྣམས་ཀྱིས་གཡུལ་འགྱེད་དྲག་པོ་བྱས།",
