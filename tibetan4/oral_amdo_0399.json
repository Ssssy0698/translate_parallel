    "འདོད་ཆགས་གཟུགས་མེད་པ་ལས་ཁ་དོག་གི་བྱེ་བྲག་ཏུ་གྱུར་པ་དང་།",
    "སྦྱིན་པ་ལྟ་བུ་གཞན་ལ་བྱས་པ་བདག་གི་ལོངས་སྤྱོད་དུ་འགྱུར་ལ།",
    "དེ་བཞིན་དུ་ནང་གི་ལ་ཡང་འཇིག་རྟེན་འདིའི་ཀུན་ནས་ཉོན་མོངས་པའི་དགའ་བ་དང་།",
    "རེག་དང་།",
    "བྱོལ་སོང་དང་ཡི་དགས་ཀྱི་ནང་དུ་མི་འདོད་པ་དང་།",
    "རི་བོང་གི་རྭ་མེད་པར་རྟོགས་པ་ཡང་གླང་གི་རྭ་ཡོད་པར་རྟོགས་པའི་ཟླ་ལས་བྱུང་ངོ་ཞེས་བྱ་བ་དང་།",
    "དེ་ལ་མིང་གི་ཚོགས་ནི་བརྡ་འདུས་པའོ།",
    "ཚིག་གི་ཚོགས་ནི་ངག་འདུས་པའོ།",
    "དེ་དག་གི་ས་བོན་ལྟ་བུ་བག་ཆགས་དང་ལྡན་པའོ།",
    "དེ་དག་གི་འབྲས་བུ་མངོན་དུ་རྙེད་པ་ཡིན་ཏེ་མྱ་ངན་ལས་འདས་པ་དང་།",
    "གྲེག་པ་ནི་གང་གི་དངོས་པོར་རེད་པ་ལས་ཀྱང་དོན་གྱི་མཐའ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "སྐྱེས་ནས་ཀྱང་ལས་སུ་བྱ་བ་ནི་དངོས་པོར་རེད་པ་དེ་དག་ཇི་སྲིད་དུ་རྒྱུན་ཡོད་པ་དེ་སྲིད་དུ་བྱ་བ་བྱེད་པ་ཡོད་དེ།",
    "མེ་ཏོག་གིས་རྒྱན་གྱི་ལས་བྱེད།",
    "དེ་དག་གི་རྒྱུར་གྱུར་པ་དང་།",
    "གང་གིས་ཡལ་གཟུགས་འཁྲ་བར་བྱ་བ་ཡིན་ཏེ།",
    "ཚད་དང་མ་སྦྱར་བར་ཆེ་གེ་མོ་ཞིག་གི་ཕྱིར་རོ་ཞེའམ།",
    "གང་ཆེ་གེ་མོ་ཞིག་ཏུ་འགྱུར་རོ་ཞེའམ།",
    "ཕྱོགས་རེ་རེ་འཛིན་པ་གཉིས་ཀ་ལ་བསྐྱར་བའི་གཏན་ཚིགས་མེད་ན་ཁ་ཙམ་དུ་དོར་རོ།",
    "དེ་གཉིས་ལས་གང་བསྟན་ན་དད་པ་སྐྱེ་ཞིང་ཡང་དག་པའི་ལམ་རྟོགས་པར་འགྱུར་བ་ཅིག་གིས་བསྟན་པའོ།",
    "མཚན་ཉིད་གང་གི་ཕྱོགས་སུ་བཟུང་བ་དེའི་གྲུབ་པ་ནི་མཐའ་དང་མཐུན་པར་བསྒྲུབ་པའོ།",
    "ཕ་ལོགས་ཀྱི་ཕྱོགས་ལ་སུན་དབྱུང་བ་ཡང་བདག་གི་ཕྱོགས་སུ་བཟུང་བའི་གྲུབ་པའི་མཐའ་དང་མཐུན་པར་སུན་དབྱུང་ངོ།",
    "དེ་ལས་གྲུབ་པའི་མཐའ་གཞན་གྱི་ཕྱོགས་ཀྱིས་བདག་གི་ཕྱོགས་མི་འགྲུབ་བ་ལྟ་ཅི་སྨོས་ཀྱི།",
    "གྲུབ་པའི་མཐའ་གཞན་གྱིས་ཕ་རོལ་གྱི་ལྟ་བ་སུན་ཕྱུང་དུ་ཟིན་ཀྱང་བདག་གི་ལྟ་བའི་ནང་དུ་བསྡུར་མི་ནུས་སོ།",
    "དེ་བས་ན་སུན་དབྱུང་བ་ཡང་བདག་གི་ལྟ་བའི་གྲུབ་པའི་མཐའ་དང་མཐུན་པས་སུན་དབྱུང་སྟེ།",
    "དེ་དག་གི་ཚུལ་གྱིས་ཅི་རིགས་པར་སྒྲུབ་ཅིང་སུན་དབྱུང་བར་བསྟན་པའོ།",
    "ཉོན་མོངས་པ་མེད་པ་ནི་ཇི་ལྟར་ཉོན་མོངས་པ་དང་བཅས་པ་སྐྱེ་བའི་ཚུལ་གྱིས་མི་སྐྱེའོ་ཞེས་བྱ་བ་དང་།",
    "ཤིང་གི་ས་བོན་ཞིག་ས་བོན་གྱི་ཉེས་པ་ཐམས་ཅད་མེད་ན།",
    "དེ་རྣམས་ཀྱི་ཕྱིར་མི་བསྟན་མོད་ཀྱི་དུས་གཞན་དུ་སྣོད་དང་སྦྱར་ཞིང་བསྟན་པ་ཡང་ཡོད་དོ།",
    "གང་གིས་དངོས་པོ་མེད་པ་ལས་ཡོད་པར་འཛིན་ཏོ་ཅོག་ཀྱང་དེ་མ་ཡིན་པའི་དངོས་པོ་གཞན་ཞིག་དང་ནོར་ཏེ་ཡོད་པ་ལས་མེད་པར་ལྟའོ་ཅོག་ཀྱང་བར་དུ་གཅོད་པའི་སྒྲིབ་པ་ཅིག་གིས་བསྒྲིབས་པས་མེད་པར་སྨྲའོ་ཅོག་གག་ཀྱང་རུང་།",
    "ཡོད་པ་ལས་མེད་པར་ལྟ་བ་བཟློག་པར་བྱ་ན་ཡོད་པའི་གཏན་ཚིགས་འབའ་ཞིག་གིས་སྒྲུབ་ཀྱི་དེ་མངོན་སུམ་དུ་དམིགས་པར་བྱ་བ་ལ་བར་དུ་གཅོད་པ་འདིས་བསྒྲིབས་སོ་ཞེས་བྱས་ལ་དངོས་པོ་གང་ཡོད་པ་དང་།",
    "སྐྱི་ད་སྡུག་འཕྲལ་དུ་མྱོང་བ་ལས་གང་གི་རྒྱུ་ལས་བྱུང་བ་མི་དམིགས་པ་ནི་སྒྲིབ་པས་བསྒྲིབས་པས་ལན་ནོ་ཞེས་བྱ་སྟེ།",
    "དོན་ཞེས་བྱ་བ་ནི་དམ་བཅས་པ་ལ་སོགས་པ་གསུམ་པོ་དེ་དག་གི་དོན་ཏོ།",
    "རང་གི་རིགས་ཀྱི་དཔེ་ཉེ་བར་སྦྱར་བའི་མཚན་ཉིད་དང་།",
    "གཏན་ཚིགས་སྒྲུབ་པ་ཡན་ལག་གི་ལེའུ་སྟེ་གསུམ་པའོ།",
    "མངོན་སུམ་ཞེས་བྱ་བ་ནི་རྐྱེན་བཞིས་བསྐྱེད་པའི་རྣམ་པར་ཤེས་པའི་སྒྲིབ་བདག་གིས་མ་བསྒྲིབས་པས་ཡུལ་ལ་མངོན་དུ་དམིགས་པ་ཡིན་ཏེ།",
    "ཡུལ་དེ་སོ་སོའི་རང་གིས་རིག་པ་ནི་མངོན་སུམ་གྱི་མཚན་ཉིད་ཅེས་བྱའོ།",
    "ཡོད་ནི་གང་དང་ཡང་མཉམ་དུ་འཇུག་མོད་ཀྱི་དུས་གཅིག་ཏུ་འཇུག་པ་ནི་རྣམ་པར་ཤེས་པ་ལྔ་པོ་ལས་ཡུལ་གྱི་རྐྱེན་གྱི་མཐུའམ་ཡིད་ལ་བྱེད་པའི་མཐུ་གང་ཆེ་བས་བསྐྱེད་པའི་རྣམ་པར་ཤེས་པ་དང་།",
    "མིག་གི་རྣམ་པར་ཤེས་པའི་རྐྱེན་བཞི་སྟེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ལ་ཇི་ལྟ་བ་བཞིན་དུ་རྣ་བ་དང་སྣ་དང་ལྕེ་དང་ལུས་དང་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའང་དེ་དང་འདྲའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་དང་།",
    "དེ་ལ་རྣམ་པར་ཤེས་པ་དང་བཅས་པའི་མིག་དང་གཟུགས་རྣམས་ལ་བརྟེན་ཅིང་མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་འགྱུར་ཏེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་དེ་དང་ལྷན་ཅིག་རྗེས་སུ་འཇུག་པ་དུས་གཅིག་ལ་སྤྱོད་ཡུལ་མཐུན་པ་རྣམ་པར་རྟོག་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་འབྱུང་ངོ།",
    "རྣམ་པར་ཤེས་བ་དང་བཅས་པའི་ལུས་དང་རེག་བྱ་རྣམས་ལ་བརྟེན་ཅིང་ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་འགྱུར་ཏེ།",
    "གལ་ཏེ་མིག་གི་རྣམ་པར་ཤེས་པ་ཅིག་ཐང་ཅིག་བྱུང་ན།",
    "རྣམ་པར་རྟོག་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མིག་གི་རྣམ་པར་ཤེས་པ་དང་སྤྱོད་ཡུལ་མཐུན་པ་ཅིག་ཀྱང་ཐང་ཅིག་འབྱུང་ངོ།",
    "མང་པོ་ཡང་འབྱུང་མོད་ཀྱི་ཆུའི་རྒྱུན་ཀྱང་མི་འཆད།",
    "དེ་ལ་གསུངས་པའི་བློ་གྲོས་ཆེན་པོ་མིག་གི་རྣམ་པར་ཤེས་པ་ནི་རྒྱུ་བཞི་དག་གིས་འབྱུང་ངོ།",
    "རང་གི་སེམས་སྣང་བ་འཛིན་པ་ལ་ཁོང་དུ་མ་ཆུད་པ་དང་།",
    "བློ་གྲོས་ཆེན་པོ་རྒྱུ་བཞི་པོ་འདི་དག་གིས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཆུ་ཀླུང་ལྟ་བུ་ལས་མིག་གི་རྣམ་པར་ཤེས་པའི་རླབས་འབྱུང་ངོ།",
    "རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་པོ་དེ་དག་དང་ལྷན་ཅིག་ཏུ་རྒྱུ་དང་ཡུལ་བྱེ་བྲག་འབྱེད་པའི་མཚན་ཉིད་ཡོངས་སུ་ཆུད་པར་བྱེད་པ་ཞེས་བྱ་བ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དེ་དག་གི་རྒྱུ་ལས་བྱུང་བའི་བདག་ཉིད་རབ་ཏུ་འཇུག་སྟེ།",
    "དེ་ལ་རང་གི་སྣང་བ་ལ་འཛིན་པར་ཁོང་དུ་མ་ཆུད་པ་ནི་དམིགས་པའོ་ཞེས་གསུངས་པས་ན།",
    "དེ་དག་གི་རྡུལ་ཕྲ་རབ་དང་།",
    "ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་གཅིག་པ་དང་ཐ་དད་པ་མ་ཡིན་པར་འཇིམ་པའི་གོང་བུ་དང་རྡུལ་ཕྲ་མོའི་དཔེས་བསྟན་པ་ལྟ་བུ་ཡིན་ནོ།",
    "དེ་དག་གི་བྱེ་བྲག་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་ཁོང་དུ་ཆུད་པར་ནུས་པས་ན་ཁོང་དུ་ཆུད་པར་བྱེད་པ་ཞེས་བྱའོ།",
    "དེ་དག་གི་རྒྱུ་ལས་བྱུང་བའི་བདག་ཉིད་འཇུག་ཅེས་བྱ་བ་ནི་རྣམ་པར་ཤེས་པ་ལྔ་ཉོན་མོངས་པའི་ཡིད་དུ་གྱུར་པ་ལས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་བསྟན་པའོ།",
    "བག་ཆགས་ཀྱིས་རྒྱས་པར་བྱས་ཤིང་རྣམ་པར་ཤེས་པ་གཞན་སྐྱེ་བ་ལྟ་བུར་རྣམ་པར་ཤེས་པ་གཅིག་གི་རྒྱུར་གཅིག་པར་ཁོང་དུ་མི་ཆུད་པ་ལ་བྱའོ།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་སུ་འགྲོ་བར་འགྱུར་བའམ།",
    "བདུད་སྡིག་ཏོ་ཅན་དག་གིས་མནར་བར་འགྱུར་བའམ།",
    "དེ་དག་གིས་བསྒྲིབ་པར་བྱ་བ་གང་ཞེ་ན།",
    "སྒྲིབ་པ་དེ་དག་གིས་མ་བསྒྲིབས་པའི་མངོན་སུམ་དེའང་རྣམ་པ་གསུམ་སྟེ།",
    "ཡོངས་སུ་རྫོགས་པའི་མངོན་སུམ་མོ།",
    "ཇི་ལྟར་བསྒོམས་པ་བཞིན་དུ་དམིགས་པ་ནི་ཀུན་བརྟགས་པའི་མངོན་སུམ་མོ།",
    "འདུ་བྱེད་ཐམས་ཅད་སྡུག་བསྔལ་བར་དམིགས་པ་ལ་སྐྱེ་བ་ལ་སོགས་པའི་གནོད་པ་ཉམས་ཀྱིས་ཚོར་ཏེ་སོ་སོ་རང་གིས་རིག་པ་ནི་མངོན་སུམ་གྱི་མཚན་ཉིད་དོ།",
    "འདི་ལྟ་བུ་དག་ནི་སོ་སོ་རང་གིས་རིག་པའི་མངོན་སུམ་གྱི་མཚན་ཉིད་དོ།",
    "འདི་ལྟ་བུ་ལ་སོགས་པར་དམིགས་པ་ནི་སོ་སོ་རང་གིས་རིག་པའི་མངོན་སུམ་དུ་དམིགས་པའི་མཚན་ཉིད་ཡིན་ཏེ།",
    "གང་གིས་མངོན་སུམ་དུ་མ་གྱུར་པ་ལ་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་ནོ།",
    "གང་གིས་མངོན་སུམ་དུ་མ་གྱུར་པ་ལ་རྗེས་སུ་དཔག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་སྒྲིབ་པ་དང་བཅས་པའི་སྐྱེས་བུ་ལ་བྱའོ།",
    "རང་གི་རིགས་ཀྱི་དཔེ་དང་སྦྱར་བའི་མཚན་ཉིད་ལ་ནང་དང་ཕྱིའི་འདུ་བྱེད་རྣམས་ཀྱི་འཇིག་པ་དང་།",
    "སོ་སོའི་སྐྱེ་བོ་རྣམས་ལ་ཐུབ་པ་དག་གིས་གཙུག་ལག་ཏུ་བསྟན་པ་ནི།",
    "ཐེ་ཚོམ་སེལ་བའི་གྲོགས་སུ་རང་གི་རིགས་ཀྱི་དཔེས་བསྟན་པར་བྱའོ།",
    "མེའི་རྒྱུན་རང་ལ་གག་པ་ལ་ཡང་མེ་ལྕེ་འགགས་ནས་མདག་མ་ལས་ཐལ་བ་དང་སོལ་བར་འགྱུར་བ་ལྟ་བུའོ།",
    "མི་རྟག་པ་རགས་པ་ལ་སྐད་ཅིག་ལ་ཕྲ་མོའི་ཆ་ཡོད་པའི་དཔེ་ནི།",
    "གཞན་ལ་ཡང་འདི་དག་གི་ཚུལ་གྱིས་ཅི་རིགས་པར་སྦྱར་རོ།",
    "རང་གི་རིགས་ཀྱི་དཔེའི་མཚན་ཉིད་ཀྱི་ལེའུ་སྟེ་དྲུག་པའོ།",
    "རང་གི་རིགས་ཀྱི་དཔེ་ཉེ་བར་སྦྱར་བའི་མཚན་ཉིད་ནི།",
    "རང་གི་རིགས་ཀྱི་དཔེ་ཉེ་བར་སྦྱར་བ་དང་གསུམ་ཚོགས་ན་འགྲུབ་པ་ལ་གཅིག་ཏུ་དེས་པ་འདི་ནི་ཡོངས་སུ་གྲེགས་པའི་མཚན་ཉིད་ཅེས་བྱ་སྟེ།",
    "དེ་བས་ན་མཚན་ཉིད་ལྔ་པོ་འདི་དག་གི་ས་རིགས་པས་བརྟག་པ་ཡོངས་སུ་དག་པ་སྟེ།",
    "རྣམ་པར་རིག་པའི་དེ་བཞིན་ཉིད་ནི་གང་འདུ་བྱེད་རྣམ་པར་རིག་པ་ཙམ་མོ།",
    "བྱེད་པ་གཅིག་གིས་སྐྱེ་བར་འགྱུར་བ་མ་ཡིན།",
    "སྤུའི་ཁུང་བུ་རེ་རེ་ནས་སྐྱེས་པ་དང་།",
    "ཞབས་དང་ཕྱག་གི་སོར་མོ་རིང་བ་དང་།",
    "མ་བཏུད་པར་ཕྱག་པུས་མོའི་ལྷང་ལ་རེག་པ་དང་།",
    "ཞབས་དང་ཕྱག་གི་མཐིལ་ན་འཁོར་ལོའི་མཚན་ཡོད་པ་དང་།",
    "མོས་པ་སྣ་ཚོགས་ཤེས་པའི་སྟོབས་དང་།",
    "ཉོན་མོངས་པ་དང་།",
    "ཟས་ཀྱང་སྲོག་གི་ཟུངས་བྱེད་པ་བཞིན་ནོ།",
    "ལུང་གི་མཚན་ཉིད་གཅིག་ལ་གཅིག་ལྟོས་ནས་དེ་གཉིས་ཀ་ཁོང་དུ་ཆུད་པར་འགྱུར་རོ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་ལུང་གི་མཚན་ཉིད་ཀྱི་ལེའུ་སྟེ་བརྒྱད་པའོ།",
    "མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དེ་གཉིས་ལ་ཐེ་ཚོམ་ཡོད་པ་ནི་རང་གི་རིགས་ཀྱི་དཔེས་གསལ་བར་བྱེད་དོ།",
    "ཤེས་པར་དཀའ་བ་རྣམས་ལ་ནི་མཚན་ཉིད་ལྔ་པོ་རེ་རེ་དང་མཐར་གྱིས་སྦྱར་ཞིང་བརྟག་དགོས་པས་མཚན་ཉིད་ཀྱི་བྱེ་བྲག་གསལ་བར་མངོན་ནོ།",
    "མིག་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ལྔ་པོ་ལས་གཅིག་དང་དེས་དྲངས་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་གཉིས་ཀྱིས་བདག་བདག་གི་ཡུལ་ལ་རྣམ་པ་ཅི་ཡོད་པ་སོ་སོ་རང་གིས་རིག་པར་གྱུར་བ་མངོན་སུམ་གྱི་མཚན་ཉིད་དང་གང་མངོན་སུམ་དུ་དམིགས་པ་དེ་དག་གི་རྟགས་ལ་སོགས་པར་བཅས་པ་མངོན་སུམ་གྱིས་རྗེས་སུ་དཔག་ནས་རྟོགས་པར་ཁོང་དུ་ཆུད་པ་ཉེ་བའི་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་དང་།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་འབའ་ཞིག་གིས།",
    "བྱིན་གྱིས་སྲིད་པ་དང་སྦྱར་ཞིང་མི་རྟག་པར་སྒྲུབ་པ་ནི་རང་གི་རིགས་ཀྱི་དཔེའི་མཚན་ཉིད་དོ།",
    "སོ་སོ་རང་གིས་རིག་པ་ནི་མངོན་སུམ་གྱི་མཚན་ཉིད་དོ།",
    "བྱིན་གྱིས་སྲིད་པ་དང་སྦྱར་བ་ནི་རང་གི་རིགས་ཀྱི་དཔེའི་མཚན་ཉིད་དོ།",
    "ཕུང་པོ་ལྔ་ལ་བདག་གི་མཚན་ཉིད་དང་འབྲེལ་པའི་རྟགས་ལ་སོགས་པ་རྣམ་པ་དྲུག་གོ།",
    "ཤིང་རྟ་སྦྱར་བ་དང་འདྲའོ་ཞེས་བྱ་བའི་དཔེས་བསྟན་ཅིང་བདག་ཡོད་པ་མི་སྲིད་བ་དང་སྦྱར་བ་ནི་རང་གི་རིགས་ཀྱི་དཔེའི་མཚན་ཉིད་དོ།",
    "དམིགས་པས་མངོན་སུམ་མོ།",
    "འདི་ལྟ་བུའི་ཚུལ་ལ་སོགས་པ་རང་གི་མཚན་ཉིད་མ་ཡིན་པའང་རྐྱེན་ལས་གཞན་དང་གཞན་དུ་དམིགས་པ་སྲིད་བ་ནི་རང་གི་རིགས་ཀྱི་དཔེའི་མཚན་ཉིད་དོ།",
    "གང་ལ་གང་རིགས་པའི་རྐྱེན་དང་ཕྲད་པ་དེ་དང་དེས་མ་བསྒྲིབས་ཏེ་མཐོང་པས་ན་མངོན་སུམ་མོ།",
    "སྔོན་སྦྲུལ་དང་སྡིག་སྦྲུལ་དག་གིས་སྔངས་པའི་མིག་སྔར་ཐག་པའི་དུམ་བུ་དང་།",
    "སེམས་ཀྱིས་བརྟགས་པ་ཡོངས་སུ་སྨིན་པ་ཉིད་མཐོང་བ་ན་མངོན་སུམ་མོ།",
    "སྐད་ཅིག་པ་ཕྲ་མོ་ལ་མི་རྟག་པ་རགས་པ་གནས་ཏེ།",
    "མེ་ལྕེ་འབར་བའམ་ས་གཟུག་པོ་ལ་ཆུ་འབབ་པའི་རྒྱུན་མགྱོགས་པ་དམིགས་པ་དང་འདྲའོ་ཞེས་བྱ་བ་ནི་རང་གི་རིགས་ཀྱི་དཔེའི་མཚན་ཉིད་དོ།",
    "སྐད་ཅིག་པ་རེ་རེ་ལ་ཡང་སྐྱེ་བ་ལ་སོགས་པ་འདུས་བྱས་ཀྱི་མཚན་ཉིད་བཞི་དང་།",
    "ཡིད་ཆེས་པའི་ལུང་གི་མཚན་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པ་དང་ལས་གཉིས་ཀ་ལ་ཡང་གཟུགས་མེད་མོད་ཀྱི།",
    "གང་ཚོང་སྐྱོང་ཆེ་ལ་གཟུངས་མི་རུབ་པ་ནི་བརྐམ་རྫས་ཀྱིས་རྒུད་པ་དང་།",
    "ལོག་པའི་སྦྱོར་བ་དེའི་ཡོ་བྱད་ཀྱིས་ཕོངས་པ་དང་འདྲའོ་ཞེས་བྱ་བ་ནི་རང་གི་རིགས་ཀྱི་དཔེའི་མཚན་ཉིད་དོ།",
    "འབྲས་བུའི་མི་མཐུན་པ་གང་ཡང་རུང་བ་ཅིག་གི་མི་མཐུན་པས་ཕན་ཚུན་ངེས་པར་མི་མཐུན་ཞེས་བྱ་བ་འདི་ནི་རྣམ་པ་ཐམས་ཅད་མི་མཐུན་པར་དམིགས་པའི་མཚན་ཉིད་དོ་ཞེས་གསུངས་པ།",
    "རྟགས་ལ་སོགས་པ་དྲུག་པོ་གཅིག་གིས་མི་མཐུན་པ་དེ་ལས་དེའི་རྣམ་པ་གཞན་ཡང་ངེས་པར་མི་མཐུན་ནོ་ཞེས་དཔོག་པས་ན་རྗེས་སུ་དཔག་པ་ཡིན་ཏེ།",
    "རྣམ་པ་ཁ་ཅིག་གིས་མི་མཐུན་པ་ཡང་རྣམ་པ་ཁ་ཅིག་གིས་མཐུན་པ་ལ་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་མི་མཐུན་པར་དཔོག་པ་ནི་མཚན་ཉིད་ཀྱིས་ཡོངས་སུ་མ་དག་སྟེ།",
    "རང་གི་མཚན་ཉིད་དོ།",
    "དེ་དག་གི་བྱེ་བྲག་དཔེས་བསྟན་པ་སའི་རྟགས་ནི་གང་།",
    "རྒྱུ་ནི་རང་གི་ས་བོན་ནོ།",
    "འབྲས་བུ་ནི་རང་གི་ཤིང་ཏོག་གོ།",
    "ལས་ནི་རང་གི་རིགས་ཀྱི་དོན་གཉེར་བའོ།",
    "རྒྱུ་ནི་ལས་དང་ཉོན་མོངས་པའོ།",
    "དེ་ལ་གཅིག་གིས་མི་མཐུན་པས་ཐམས་ཅད་མི་མཐུན་པར་དམིགས་པ་གང་ཞེ་ན།",
    "མི་དང་བྱོལ་སོང་གཉིས་བློ་ལ་སོགས་པའི་ཚུལ་མི་འདྲ་སྟེ།",
    "མི་ལ་ནི་འཇིག་རྟེན་ཕ་རོལ་ཡོད་ཀྱི་བྱོལ་སོང་ལ་ནི་འཇིག་རྟེན་ཕ་རོལ་མེད་དོ་ཞེས་ཟེར་བ་དང་།",
    "འཇིག་རྟེན་ཕ་རོལ་ཡོད་ན་ཡང་རིགས་མཐུན་མཐུན་དུ་འཁོར་གྱི་མི་ལས་བྱོལ་སོང་ལས་མིར་སྐྱེ་བར་མི་འགྱུར་རོ་ཞེས་ཟེར་བ་ཡིན་ཏེ།",
    "ཆུ་གཞན་ལས་འཁྱག་པ་སྣང་བ་གཉིས་རྟགས་མི་མཐུན་ལ་རྟགས་ཅན་གྱི་རང་བཞིན་ཆུར་མཚུངས་པ་དང་སྐྱེས་པ་རང་གི་ཚུལ་དུ་འདུག་པ་དང་།",
    "སྐྱེས་པ་མོ་ཆར་ཞུགས་པ་ལ་སོགས་པ་རྟགས་མི་མཐུན་ཏེ།",
    "སྐྱེས་པ་རང་གི་ཚུལ་དུ་འདུག་པ་དང་།",
    "བུད་མེད་ཕོ་ཆར་ཞུགས་པ་གཉིས་རྟགས་ཅན་གྱི་རང་བཞིན་སྐྱེས་པ་དང་།",
    "བུད་མེད་ཡིན་ཏེ་མི་མཐུན་ལ་རྟགས་ཀྱི་ཚུལ་མཐུན་པ་ལ་སོགས་པ་ཡང་ཡོད།",
    "ཤ་དང་ཚོད་མ་ལ་སོགས་པའི་ཟས་ཐ་དད་པ་ཟོས་པས་འགྲངས་པར་འགྱུར་བ་ཟས་ཀྱི་རྣམ་པ་མི་མཐུན་ལ་འགྲངས་པར་མཐུན་པ་ལ་སོགས་པ་ཡང་ཡོད།",
    "རི་བོང་གི་རྭ་ལ་སོགས་པ་གཞན་མེད་པའི་ཡུལ་དུ་གྲུབ་པ་བཞིན་ནོ་ཞེས་བྱ་བ་ཡང་བུམ་པ་མེད་པའི་ཐང་བུ་མངོན་སུམ་དུ་གྱུར་པ་ལས་བུམ་པ་མེད་པ་ཞེས་བྱ་བ་ཡང་ལོགས་ཤིག་ན་མེད་པས་བསྒྲུབ་པ་དང་།",
    "རྡུལ་ཕྲ་མོ་ཙམ་དུ་དམིགས་པས་ཞེས་ཟེར་བ་ནང་འགལ་བས་མངོན་སུམ་གྱིས་སུན་ཕྱུང་བ་ལ་སོགས་ཏེ།",
    "དཔེར་ན་ཤིང་སྡོང་པོ་ལ་མདའ་དང་མདུང་གི་རང་བཞིན་མེད་ཀྱང་བཟོ་བོའི་རྐྱེན་གྱིས་མདའ་དང་མདུང་དུ་བྱར་རུང་བ་ལྟ་བུ་རང་བཞིན་གྱིས་གྲུབ་པ་མ་ཡིན་པར་སུན་ཕྱུང་བ་ལ་སོགས་པར་རྒྱ་ཆེར་གསུངས་པ་ཡང་།",
    "དེ་ཡང་སྡོང་པོ་ལ་མདའ་མདུང་གི་རང་བཞིན་མེད་པ་ལས་བཟོ་བོའི་རྐྱེན་གྱིས་བྱས་པ་རང་བཞིན་གྱིས་ཡོད་པར་མ་དམིགས་ཏེ།",
    "སྤོང་བ་དེ་དང་ལམ་དེས་ཉོན་མོངས་པ་སྤོང་བར་བྱེད་པ་དང་།",
    "རང་གི་མཚན་ཉིད་ཀྱིས་གྲུབ་པ་མ་ཡིན་པས་ན་གཉིས་སུ་མེད་པའོ།",
    "བདག་གི་རྟོག་པ་འདིར་རིས་སུ་བྲིས་པ་མེད་པ་ཡིན།",
    "དཔལ་གྱི་ཞལ་ནས་གསུངས་པ་ནང་གཅིག་གིས་གཅིག་བཀྲོལ་ཏེ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན་ཞེས་པ་ནི་འདི་ནི་དུས་གཞན་དུ་མ་ཡིན་ཏེ།",
    "དེ་ཡང་ཐུན་མོང་གིས་བཅོམ་པ་ནི་བདུད་བཞི་བཅོམ་ནས་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་དང་ལྡན།",
    "གང་གི་ཡང་ངོ་བོར་མ་གྲུབ་པས་འཁོར་འདས་གཉིས་སུ་སྣང་བའི་ཚིག་གམ་མཐའ་ལས་འདས་པའོ།",
    "ནང་གི་གནས་ནི་འོག་མིན་གྱི་གནས་ཏེ།",
    "གཟུགས་སམ་མཚན་མའམ་འཛིན་པའི་འོག་ཏུ་ཡང་མ་སོང་བའོ།",
    "ཕྱིའི་འཁོར་ནི་འདུན་པ་མོས་པའི་ས་པ་སྟེ།",
    "ནང་གི་དངོས་པོ་མེད་པའོ།",
    "ནང་གིས་བཅུ་ནོན་པ་ཡན་ཆད་དོ།",
    "བདག་དོན་དུ་སྤྱན་རས་གཟིགས་ཏེ་རང་ཉིད་ཀྱིས་དོན་རྟོགས་པར་བྱེད་པ་དང་།",
    "གཞན་དོན་དུ་གཟིགས་ཏེ་གདུལ་བྱ་གང་ལ་གང་མོས་སྟོན་ནུས་པའོ།",
    "ལུང་གི་ཤེས་རབ་ཀྱིས་འཁོར་འདས་སྟོན་ནུས་པ།",
    "ཟབ་མོ་ནི་རང་གི་ངོ་བོ་དངོས་པོར་མི་སྣང་བས་ཟབ་ལ།",
    "དེ་ལྟ་བུའི་དོན་རང་གི་ཁོང་དུ་ཆུད་དེ་སྤྱོད་པའོ།",
    "མོས་པའི་གང་ཟག་གོ།",
    "རིགས་ཀྱི་བུ་གང་ལ་ལ་དག་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་སྤྱད་པ་སྤྱོད་པར་འདོད་པ་དེས་ཇི་ལྟར་བསླབ་པར་བགྱི།",
    "དེ་སྐད་ཅེས་སྨྲས་པ་དང་ཞེས་པས་ནི་སྤྱན་རས་གཟིགས་ལ་ཤཱ་རིའི་བུས་དྲིས་པ་སྟེ།",
    "དམིགས་པ་མེད་པའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོའི་དོན་ལ་སྤྱན་རས་གཟིགས་སྤྱོད་པ་དེ་ལ་གཞན་སྤྱོད་པར་འདོད་ན་བསླབ་པའི་ཐབས་ཅི་ལྟར་བསླབ་ཅེས་དྲིས་པའོ།",
    "ཤཱ་རིའི་བུ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་དག་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་སྤྱོད་པ་སྤྱད་པར་འདོད་པ་དེས།",
    "ཕོའམ་མོའམ་གང་ལ་ལ་དམིགས་པ་མེད་པའི་ཤེས་རབ་ལ་ད་སྤྱོད་བའི་དོན་ལ་ཁྱེད་སྤྱོད་པར་འདོད་ན་འདི་ལྟར་སློབས་ཞེས་པའི་དོན་ཏོ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་རྗེས་སུ་བལྟའོ་ཞེས་པ་ནི་ཐུན་མོང་གི་ཕུང་པོ་ལྔ་ལ་སོགས་པ་དེ་རྣམས་ནི་ཡེ་ནས་སྟོང་པ་ཡིན་པས།",
    "དེ་རྣམས་ལ་མོས་པའི་དོན་གྱིས་བའོ།",
    "གཟུགས་སམ་སྟོང་པའི་མཚན་ཉིད་གང་ཡང་མེད་པ་རྒྱུ་རྐྱེན་གང་གིས་ཀྱང་མ་བསྐྱེད་པ་རང་གི་ངོ་བོའི་ཡོན་ཏན་གང་དུ་ཡང་མ་འགགས་པ།",
    "རྒྱུ་གཞན་ལྟ་གཅིག་གིས་བསྐྱེད་ནས་ཡོན་ཏན་གྱིས་གང་བའི་རྒྱུ་ཡང་མེད་དོ།",
    "དེ་ལས་བྱུང་བའི་ཀུན་ནས་ཉོན་མོངས་པ་མེད་དེ།",
    "རང་གི་དངོས་པོའི་དོན་ཡེ་ནས་རང་ཆས་སུ་ཡོད་པས།",
    "དེའི་ཡོན་ཏན་ཡང་རང་ཉིད་ཀྱིས་རང་རིག་པས་རིག་པ་ཆེན་མོའི་སྔགས་ལ།",
    "དེའི་ཕྱིར་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐམས་ཅད་ཀྱི་སྔགས་སྤྱན་རས་གཟིགས་ཀྱིས་སྨྲས་པ།",
    "པཱ་ར་ག་ཏེ་ནི་བདག་དོན་གྱི་མཆོག་ཏུ་ཕྱིན་ཏེ་གཞན་ལ་རེ་བའི་ཡུལ་མེད་དོ་ཞེས་པའོ།",
    "འཕགས་པ་སྤྱན་རས་གཟིགས་ཁྱོད་ཀྱིས་ཤཱ་རིའི་བུ་ལ་བསྟན་པ་དེ་བཞིན་དུ་གདུལ་བྱ་རྣམས་ཀྱིས་ཡེ་ཤེས་རང་ལ་རང་ཆས་སུ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོད་པས་བསླབ་པར་བྱའོ་ཞེས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་བཀའ་དངོས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱང་རྗེས་སུ་ཡི་རང་ངོ་ཞེས་པས་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའི་བཀའ་དངོས་དང་བྱིན་གྱིས་བརླབས་པའི་བཀའ་སྤྱན་རས་གཟིགས་གཉིས་མཐུན་པས་དེ་བཞིན་གཤེགས་པའི་རིགས་ཐམས་ཅད་ཀྱང་བཀའ་མཐུན་པའི་དོན་དེ་ལ་ཡི་རང་ངོ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ནས།",
    "མངའ་བདག་ཆེན་པོ་ཁྱོད་ཉོན་ཅིག།",
    "ཁྱོད་ལ་བསྟན་དང་མི་དགོས་ཏེ།",
    "སྒྲུབ་ཐབས་རེ་ཡི་སྒོར་ཞུགས་ནས།",
    "རང་གི་ཆེ་བ་འདོན་ཅིང་གཞན་ལ་སྨོད་པའི་དུས་ཤིག་འོང་།",
    "དཔེར་ན་ཆུའི་ནང་གི་ཟླ་བ་ལྟ་བུའོ་ཞེས་སྨྲ།",
    "དེ་ལ་རང་གིས་ཁོང་དུ་ཆུད་པར་བྱས་ལ་གཞན་ཡང་དེ་དང་མཐུན་པར་འཆའ་རུ་གཞུག་གོ།",
    "ཆིག་འཛིན་མིང་གི་ཆིག་འཛིན་ཏེ།",
    "ནང་འཛིན་པའི་སེམས་གཉིས་ཀ་མིང་གི་འདུ་བྱེད་ལས་གྲུབ་པ་སྟེ།",
    "དཔེར་ན་ཆུའི་ནང་གི་ཟླ་བ་ལྟ་བུ་ཞེས་པ་ནི།",
    "དངོས་པོ་མཚན་མར་མ་གྲུབ་རེག་བྱའི་ཐོགས་པ་མེད།",
    "ཞེས་ཤེལ་གྱི་ཁྱེའུ་ཆུང་གི།",
    "ཉིད་ཅེས་བྱ་བ་ནི་རེག་པ་གཟུགས་སུ་མ་གྲུབ་པའོ།",
    "རེག་བྱའི་ཐོགས་པ་རྡུལ་ཀྱང་མེད་པའོ།",
    "ཁོ་དེ་ཅིག་གི་བརྗོད་ལུགས་འདི་ལྟ་སྟེ།",
    "མིང་དེ་སྤོར་བཏུབ་ན་དེ་ཀ་འགྱུར་བ་ཡིན་མོད་ཅེས་ལན་གདབ་བོ།",
