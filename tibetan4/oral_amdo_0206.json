    "བཙུན་པ་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་འབྲིང་བདག་གིས་ལོ་ཉི་ཤུ་ལྷག་ཅིག་གི་བར་དུ་བགྱིས་ཀྱང་།",
    "སྐུའི་ཁ་དོག་གསལ་བ་འདི་ལྟ་བུ་ནི་བདག་གིས་སྔོན་མ་འཚལ་ཏེ།",
    "གང་གི་ནུབ་མོ་ཕུང་པོ་ལྷག་མ་མེད་པའི་དབྱིངས་སུ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བའི་དུས།",
    "གང་གི་ཕྱིར་སྟོན་པས་བསོད་སྙོམས་ཕྱི་མ་གསོལ་ནས།",
    "ཞེས་གསུངས་ནས་ཞབས་སྐྱིལ་མོ་དཀྲུང་བཅས།",
    "དེའི་ཚེ་དགེ་སློང་ཞིག་གིས་ཚིགས་སུ་བཅད་དེ་སྨྲས་པ།",
    "དེང་མཚན་མོའི་གུང་ཐུན་འདི་ལ་ཕུང་པོ་ལྷག་མ་མེད་པའི་དབྱིངས་སུ།",
    "བཅོམ་ལྡན་འདས་ཤིང་སཱ་ལ་ཟུང་གི་བར་དུ།",
    "ཀུན་དགའ་བོ་ཁྱོད་མྱ་ངན་དང་།",
    "ཀུན་དགའ་བོ་ཁྱོད་ཀྱིས་དེ་བཞིན་གཤེགས་པའི་ཉེ་གནས་བྱས་བ་ནི།",
    "དཔེར་ན་ད་ལྷ་ཁྱོད་ཀྱིས་ང་ལ་བྱ་བ་བཞིན་ནོ་ཞེས་དང་།",
    "ཤིང་སཱ་ལ་ཟུང་གི་ཚལ་གྱི་བར་དང་།",
    "དེ་དག་གིས་ཇི་ལྟར་བསྒྲུབ་པར་བགྱིད་ལགས།",
    "ཕུང་པོ་གྱད་རྣམས་ཀྱི་གན་དུ་སོང་ལ།",
    "བདག་ཅག་གིས་དེ་ལ་བལྟ་བ་དང་བསྙེན་བཀུར་བྱ་བའི་ཕྱིར་འགྲོ་མ་ནུས་པར་ཕྱིས་འགྱོད་པ་མ་བྱེད་ཅིག་ཅེས་སྨྲོས་ཤིག།",
    "བུ་མོ་གཉེན་བཤེས་སོགས་དུ་མ་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་ནས་དང་།",
    "བྲན་ཕོ་མོ་དང་།",
    "གལ་ཏེ་རྩྭ་ཅན་གྱི་གྱད་རྣམས་རེ་རེ་བཞིན།",
    "བདག་གི་སྤྱན་སྔར་འདུག་སྟེ།",
    "ཁོ་བོ་ནི་རེ་ཞིག་གླུ་དབྱངས་ལེན་གྱིས།",
    "དེས་སོང་ནས་སྨྲས་པ་ན།",
    "ཅི་ཟེར་ང་ལས་གཞན་པའི་དྲི་ཟ་ཡང་ཡོད་དམ།",
    "སྐྱེས་བུ་ཁྱོད་དྲི་ཟ་ཡིན་ནམ།",
    "དེ་ལྟ་ན་གླུ་དབྱངས་བླང་གི་ཚུར་ཤོག།",
    "བཅོམ་ལྡན་འདས་དྲི་ཟར་སྤྲུལ་པས་པི་ཝང་རྒྱུད་རེ་རེ་ནས་བཅད་ཀྱང་།",
    "སུམ་བཅུ་རྩ་གསུམ་ནས་མི་སྣང་བར་ཐ་མའི་གཟིགས་མལ་དུ་བཞུགས་སོ།",
    "དགེ་སྦྱོང་གོ་ཏ་མ་དེང་གི་ནམ་གྱི་གུང་ཐུན་ལ་ཡོངས་སུ་མྱ་ངན་ལ་འདའ་བར་འགྱུར་ན།",
    "ཤིང་སཱ་ལ་ཟུང་གི་ཚལ་དུ་སོང་བ་དང་།",
    "བདག་གིས་ཀུན་དུ་རྒྱུ་སྤྱོད་པ་ཅན་རྒན་པོ་སློབ་དཔོན་སྔ་རབས་དག་ལས།",
    "བརྒྱ་ལམ་རེས་འགའ་ན་སྟེ།",
    "ཀ་མ་ཏོག་བཅོམ་ལྡན་འདས་གོ་ཏ་མ་དེང་གི་མཚན་མོའི་གུང་ཐུན་ལ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་འགྱུར་ལ།",
    "འོད་སྲུངས་རྫོགས་བྱེད་ལ་སོགས་པ་རྣམས་ཀྱིས་རང་གི་ཁས་འཆེ་ཞིང་སོ་སོ་རིག་པ་དག་གོ།",
    "ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་གང་ན་བ་དེར་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ།",
    "བདག་གིས་ཀྱང་རྙེད་པ་ལེགས་བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པའི་མཛད་པ་ཕྱོགས་ཙམ་སྨོས་པ་སྙན་གྲགས་ལྷའི་རྔ་ཆེན་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "བདག་གིས་སྟོན་པ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བ་བལྟ་བ་ནི་ཆ་མ་ཡིན་པས།",
    "བཙུན་པ་བདག་གིས་རྡོ་ཐོག་མོད་ཀྱི་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་འཚལ་ལོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་ཀྱིས་དགེ་སློང་གི་རྟགས་འཆང་བ་དང་།",
    "མུ་སྟེགས་བྱེད་དག་གིས་སྔར་གྱི་ཆ་ལུགས་སུ་མཐོང་ལ།",
    "ཁྱོགས་མུ་སྟེགས་ཀྱིས་འདེགས་མི་ནུས་པ་དང་།",
    "རབ་བཟངས་ཐ་མའི་གདུལ་བྱར་འགྱུར་བའི་སྔོན་བྱུང་གི་རབས་རྒྱས་པར་བཀའ་སྩལ་ཞིང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་གནས་ལ་མོས་པ་བྱེད་དུ་གཞུག་པའི་ཕན་ཡོན་སོགས་རྒྱས་པར་བསྟན་ནས།",
    "ཁྱོད་ཀྱིས་འདི་ཇི་ལྟར་བདག་ཅག་གིས་སྟོན་པའི་སྤྱན་སྔར།",
    "དགེ་སློང་དག་གིས་དགེ་སློང་དག་ལ།",
    "གྲོགས་དག་གིས་གྲོགས་དག་ལ་སྨྲ་བར་བྱ་ཞིང་།",
    "འདི་ལྟར་བཙུན་པ་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའི་དོན་བདག་གིས་འཚལ་བ་ལྟར་ན།",
    "དགེ་སློང་གི་འཁོར་ཇི་སྙེད་འདུས་ཤིང་མཆིས་པ་རྣམས་ལས།",
    "ཁྱོད་ནི་དད་པས་དེ་སྐད་སྨྲ་མོད་ཀྱི།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཀྱི་གཟིགས་པ་ནི་བླ་ན་མེད་པར་འཇུག་པ་ཡིན་ཏེ།",
    "དགེ་སློང་གི་འཁོར་ཇི་སྙེད་འདུས་ཤིང་འཁོད་པ་རྣམས་ལས།",
    "ལམ་རྣམས་ལ་སོམ་ཉི་དང་ཡིད་གཉིས་མེད་མོད་ཀྱིས།",
    "དགེ་སློང་དག་རེ་ཤིག་ཅང་མ་སྨྲ་ཞིག་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་གསུང་གི་ཐ་མའོ།",
    "འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ལ་སྙོམས་པར་ཞུགས་པའི་ཚེ།",
    "སངསརྒྱས་བཏུམ་ལྡན་འདས་ན་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ལ་སྙོམས་པར་ཞུགས་སོ།",
    "བདག་གིས་བཅོམ་ལྡན་འདས་ལས་མངོན་སུམ་དུ་ཐོས་པ་གཟུང་ངོ་ཞེས་སོ།"
  ]
}