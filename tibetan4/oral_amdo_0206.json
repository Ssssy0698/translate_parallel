    "འོན་ཀྱང་གལ་ཏེ་སྐུའི་ཚད་ལྟ་བར་འདོད་ན་ཁྱོད་ཀྱི་ཁྱིམ་དུ་མེའི་སྦྱིན་སྲེག་བྱེད་པའི་ཐབ་འོག་ན།",
    "འདི་ཡང་ངོ་མཚར་བ་ཞིག་སྟེ་བདག་གི་ལན་འགའ་ཡང་མ་ཐོས་ན་སོང་ལ་བ་ལྟ་བར་བྱའོ་སྙམ་ནས།",
    "དགེ་སྦྱོང་གོ་ཏ་མ་གདོན་མི་ཟ་བར་ཐམས་ཅད་མཁྱེན་པ་ཡིན་གྱིས་སོང་ལ་བསྙེན་བཀུར་བྱའོ་བསམ་ནས།",
    "དེས་བཅོམ་ལྡན་འདས་ལ་ཞུས་ནས་ས་ཕྱོགས་སྐབས་ཡོད་བ་ཅིག་ཏུ་ཙན་དན་ས་མཆོག་གི་མཆོད་སྡོང་བསྒྲེངས་ཏེ་དུས་མཆོད་བཤམས་པས།",
    "གང་གི་ཚེ་སྔོན་མཉན་ཡོད་དུ་བཅོམ་ལྡན་འདས་ཀྱི་ཆོ་འཕྲུལ་ཆེན་པོ་བསྟན་པས།",
    "བདག་རྣམས་ཀྱི་ཁྱིམ་དུ་སོང་སྟེ་སྨྲས་པ།",
    "ཁོ་བོ་ཅག་གིས་ཁྱེད་ཀྱི་ཕུན་སུམ་ཚོགས་པ་མཐོང་གིས།",
    "འཕགས་པ་དག་བདག་ཅག་རྒྱུ་གང་གིས་རྒུད་བ་ལགས།",
    "དེ་རྣམས་ཀྱིས་གང་གི་ཚེ་ཁོ་ན་བཞུགས་ཤིང་གྲོགས་བགྱི་བ་ལ་ཐུག་པ་དེའི་ཚེ་བཞུད་པ་བཟང་པོ་མ་ལགས་ཏེསྨྲས་པ།",
    "ཁྱེད་ཅག་གི་དགྲ་སུ་ཡིན།",
    "རེ་ཧི་ཏ་ཀར་བྱོན་ཞིང་གནོད་སྦྱིན་གླང་ཆེན་སྟོབས་ཀྱི་གནས་སུ་བཞུགས་པ་ལ།",
    "གནོད་སྦྱིན་དེ་མདུན་སར་སོང་བས།",
    "ཞུགས་ལིང་ལྔ་བརྒྱ་རེ་སྤྲུལ་ནས་སང་གདུགས་ཚོད་དྲངས་ཤིང་།",
    "གཙུག་ལག་ཁང་གི་ཕྱི་རོལ་དུ་ཚིགས་སུ་བཅད་པས་བོས་པ།",
    "ཞེས་སོགས་ཀྱིས་བསྐུལ་བས་མོད་དེ་ལ་ཞབས་དྲུང་དུ་འོངས་པས།",
    "རྒྱང་རིང་པོར་ཚལ་སྔོ་ཞིང་སྔོ་བ་སྦྲེང་བ་དག་གཟིགས་ནས།",
    "ཡུལ་དེའི་མི་རྣམས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཞབས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་འཁོད་པ་ལ།",
    "གཞན་དག་གིས་ཀྱང་ཕྱོགས་དེར་མཆོད་རྟེན་བརྩིགས་པ་ལ།",
    "མགོ་རེག་དང་རིལ་བ་སྤྱི་ཇུགས་ཅན་བཏུལ་ཞིང་།",
    "ཁྲོས་འཁྲུགས་ཡི་མ་རང་བས་སྟེང་གི་ནམ་མཁའ་ལ་འཕགས་ཤིང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་དྲུང་འབའ་ཞིག་བསིལ་བར་རིག་ནས་དེར་སོང་སྟེ།",
    "ཁྱོད་ཀྱིས་ང་མིང་ལུས་པ་བྱས་པར་འགྱུར་རོ།",
    "དེའི་སྤྱི་བོ་ལ་རེག་ནས་བཀའ་སྩལ་པ།",
    "བཞིན་བཟང་ཁྱོད་ཀྱིས་བུམ་པ་བཟང་པོ་ལྟ་བུའི་ཉན་ཐོས་ཆེན་པོ་བཞི་ལ་ཟན་བྱིན་ཏེ།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་བགྱི་བ་བཀའ་སྩལ་དུ་གསོལ།",
    "ཡུལ་མ་ག་དྷཱ་ན་གནས་པའི་སྐྱེ་བོའི་ཚོགས་ལ་མི་འཇིགས་པ་བྱིན་ཅིག་དེས་ཀྱང་སྐྱབས་སུ་སོང་ཞིང་བསླབ་པའི་གཞི་གཟུང་སྟེ་མི་འཇིགས་བ་སྩལ་ཏོ།",
    "བུ་མོ་དང་མནའ་མ་རྣམས་ཀྱིས་ཀྱང་སྐྱབས་སུ་འགྲོ་བ་དང་བསླབ་པའི་གཞི་དག་གཟུང་ཞིང་།",
    "སྦྲེངས་པ་གཟིགས་ནས།",
    "དེ་ལས་སྐྱིལ་མོ་དཀྲུང་ཤོང་བའི་ས་བླངས་ཏེ་བསྟན་པ་འཇོག་པ་སོགས་རྒྱ་ཆེར་ལུང་བསྟན་ཞིང་།",
    "ཡུལ་ཀན་ཐར་གནོད་སྦྱིན་མོ་འཁོར་དང་བཅས་པ་བཏུལ་ལོ།",
    "དེས་ཀྱང་ཁྱོད་དང་བདག་མཉམ་མོ་ཞེས་ཟེར་རོ།",
    "ཕྱོགས་དེར་གནོད་སྦྱིན་མོ་སྦུབ་བུ་ཅན་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཀླུ་དང་གནོད་སྦྱིན་མོ་མདུང་ཅན་འདིས་བདག་ཅག་གི་བྱིས་པ་བཙས་གནོད་སྦྱིན་གདུག་པ་དེ་དང་དེ་དག་བཏུལ་ན།",
    "གལ་ཏེ་འདི་དག་བདག་གི་སླད་དུ་གཙུག་ལག་ཁང་རྩིག་པར་བགྱིད་ན་དེ་བཞིན་དུ་བགྱིའོ།",
    "གནོད་སྦྱིན་མོ་འཁོར་དང་བཅས་པ་བཏུལ་ཏེ།",
    "བྱིས་པ་ཆུང་ངུ་དག་རྡུལ་གྱི་མཆོད་རྟེན་ལ་རྩེད་མོ་བྱེད་པ་གཟིགས་ནས་གསང་བའི་བདག་པོ་ལ་བཀའ་སྩལ་པ།",
    "ཚལ་ཞིང་བ་སྦྲེངས་པ་དག་གཟིགས་ནས།",
    "དེར་བཅོམ་བརླག་གི་བྲམ་ཟེ་རྣམས་ཀྱིས།",
    "དེ་འདིར་འདུག་ན་བདག་ཅག་གི་བཀུར་སྟི་དང་རྙེད་པའི་བར་ཆད་དུ་འགྱུར་རོ་བསམ་ཞིང་།",
    "བཀུར་སྟི་མ་ཡིན་པ་བྱས་ན་འདིར་འདུག་པར་མི་འགྱུར་རོ་ཞེས་བགྲོས་ཏེ་བྲམ་ཟེ་སྔོར་གྱུར་ཞེས་བྱ་བ་རིག་བྱེད་དང་རིག་བྱེད་ཀྱི་ཡན་ལག་གི་ཕ་རོལ་དུ་སོན་བར་རང་གི་སྨྲ་བ་གསལ་བྱེད་ཅིང་།",
    "དེ་ལ་ཁྱོད་ཀྱིས་བཀུར་སྟི་མ་ལགས་པའི་ཚིག་གི་རྒྱད་བཀག་གིས་སྤྱི་བར་གསོལ་ཞེས་བསྒོས་པ་དང་།",
    "ཤེས་ལྡན་དག་བདག་གི་ལྕེ་འདི་ནི་བདེན་པའི་རྗེས་སུ་འབྲང་བ་ཡིན་གྱིས།",
    "བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་བ་ན།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་ཕྱོགས་གཅིག་བརྗོད་པར་བགྱི།",
    "གྲོང་དེར་གནས་པའི་ལྷ་མོས་སྒྲེན་མོར་བྱས་ཏེ་འདུག་པ་ལ།",
    "ལྷ་མོ་རེ་ཞིག་བུད་མེད་ཀྱི་ལུས་ནི་ཤིན་དུ་བཀབ་ཀྱང་བཟང་བ་མ་ཡིན་ན།",
    "སྒྲེན་མོ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཤེས་བཀའ་སྩལ་པས།",
    "དེ་སྐྱེངས་ནས་ཕྱོགས་ཤིག་ཏུ་སོང་ངོ།",
    "བཅོམ་བརླག་གི་བྲམ་ཟེ་དང་ཁྱིམ་བདག་དད་པ་ཅན་རྣམས་ཀྱིས་ཐོས་པ་དང་།",
    "གནོད་སྦྱིན་བོང་བུས་བདག་ཅག་གི་བུ་བཙས་ཤིང་།",
    "གནོད་སྦྱིན་མོ་བསླངས་རྙེད་མ་དང་།",
    "བཞོན་པའི་སའི་བར་སོང་ཞིང་བཞོན་པ་ལས་བབས་ཏེ།",
    "ཡུལ་ཐ་དད་པ་ཅན་རང་རང་གི་སྤྱོད་ཡུལ་དང་ཡུལ་ཉམས་སུ་མྱོང་བར་འགྱུར་གྱི།",
    "བདག་གིས་ཤཱཀྱའི་སྲས་ཀྱི་དགེ་སློང་ཇི་སྙེད་ཅིག་བཤོས་བསོལ་བ་འདི་ཐམས་ཅད་བདག་གི་གླང་དུ་གྱུར་ཅིག་སྙམ་པ།",
    "བྲམ་ཟེ་ཁྱོད་ཀྱིས་མི་རུང་བའི་སེམས་བསྐྱེད་པ་འགྲུབ་པར་མི་འགྱུར་ཏེ།",
    "དེའི་མཚན་མོ་འདས་པ་སྔ་དྲོའི་ཚེ།",
    "བྲམ་མོ་རྒན་མོ་ཀ་ཙངྒ་ལ་ཞེས་བྱ་བ་ཆུ་བུམ་ཐོགས་ཏེ་ཁྲོན་པར་ཆུ་འཆུར་སོང་བ་ལ།",
    "ང་ཡི་སྐུ་ལ་རེག་པ་ལས།",
