    "ཀློག་པ་པོ་དག་གིས་གདེང་འཇོག་དང་དགའ་བསུ་མོད་མི་དམའ་བ་ཐོབ།",
    "གནའ་རབས་དང་དེང་རབས་ཀྱི་སྙན་ངག་ཚ་གྲང་ལྟར་འགལ་བར་བཟུང་སྟེ་ཕྱོགས་ལྟུང་གི་རྒྱར་མ་ལྟུང་ཞིང་།",
    "དེ་ཡང་རང་གི་མི་ཚེའི་ཉམས་མྱོང་དང་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་འཚོ་བ་ལས་སྐྱེས་པའི་གོ་རིགས་སམ་འདུ་ཤེས་འཛིན་སྟངས་ཀྱི་ལྟ་བ་ངེས་ཅན་ཞིག་ཡོད་པ་ལ་ལྟོས་ཀྱི།",
    "ཁོང་གི་སྤྱན་རས་ལ་ཕར་བལྟས་ཚོད་ཀྱིས་གྲུང་ཉམས་དེ་ཙམ་ཡོད་པ་མི་གསལ་མོད།",
    "ཁོང་གི་སྙན་རྩོམ་དག་ལ་བལྟས་པ་ཙམ་གྱིས།",
    "ཚིག་གི་སྙན་ཆ་ཁོ་ན་ལྷུར་བྱས་ཏེ་མངོན་བརྗོད་བརྡ་རྙིང་སོགས་ཐོག་མའི་གཏམ་གླེང་།",
    "བཀླགས་པ་ཙམ་གྱིས་དགའ་སྡུག་གི་ཚོར་སྣང་ཅི་རིགས་སྐྱེད་ཐུབ་པ་ཞིག་ཡོད་པ་འདི་ཙམ་གཟུར་གནས་དཔྱོད་ལྡན་དག་གི་ངོར་མཐུན་སྣང་དུ་གྲུབ་བབ་སྙམ།",
    "ད་ལན་ཁོང་གི་སྙན་རྩོམ་ཕྱོགས་བསྡུས་ཐེངས་དང་པོར་དཔར་དུ་སྐྲུན་འཆར་ཡོད་པ་ཐོས་ཤིང་།",
    "ངས་ཆེས་ཡི་རང་དང་སྤྲོ་དགའི་ཚོར་སྣང་གི་གླིང་ག་ནས་བཏུས་པའི་ཤིས་སྨོན་གྱི་མེ་ཏོག་སིལ་མ་འཐོར་བཞིན།",
    "སྙན་དེབ་འདི་འུ་ཅག་ཕ་ཡུལ་གྱི་གདོད་མའི་གཉིད་མོ་ཆེ་དཀྲོགས་པའི་སྐུ་རེངས་དང་།",
    "༤༢ཨ་མའི་བྱམས་བརྩེ་དྲན་པའི་སྐྱོ་དབྱངས།",
    "དཀར་ཆག་༧༣མཚན་མོའི་ལྗོན་པའི་ཁྲོད་ཀྱི་བཟི་གཏམ།",
    "༡༡༤བྱང་ལམ་རིང་མོ་ཉུལ་བའི་ཚོར་སྣང་།",
    "༡༢༣མི་རྐང་གླིང་བུ་ཙེར་འབུད།",
    "༡༢༦ཙོང་ཆུ་སྔོན་མོའི་རླབས་རིས།",
    "༡༤༥གནམ་སྔོན་འོག་གི་དུང་སེམས།",
    "སེང་དཀར་མོ།",
    "༡༩༡སེམས་གཏིང་གི་མེ་དཔུང་།",
    "༢༧མཐའ་མཇུག་གི་གྱེས་ཕྱག་༢༡ས་སྲོད་ཀྱི་རི་སྤྱང་།",
    "༢༡༤སྙན་ངག་གི་ལྷ་མོ།",
    "༢༢༨སྐྱ་རེངས་ངོགས་ཀྱི་འགྲུལ་བཞུད།",
    "རྫ་ཁའི་སྨུག་ལོང་ནང་གི་ཡུ་མོ།",
    "༢༥མཚན་མོའི་དྲན་གདུང་།",
    "༢༧༩སྐྱོ་གླུ་རིང་མོ།",
    "གཉོམ་ཆུང་དུད་འགྲོའི་སྲོག་གི་རིན་ཐང་ལ།",
    "སེམས་ཀྱི་ཁམས་ལ་ཁྱད་པར་མ་མཆིས་མོད།",
    "ཞིབ་མོར་བསམ་ན་རང་ཉིད་བདེ་ཐབས་ཙམ།",
    "གསོན་ཁྲག་དྲོན་མོ་རང་གིས་རྔམ་འཐུང་བྱེད།",
    "གཤིན་རྗེའི་ཕོ་ཉ་སྲོག་གི་གཤེད་མར་བརྩི།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "རང་རང་སྲོག་གིས་འཚོ་བའི་སྲོག་ཆགས་རྣམས།",
    "མགོ་ནག་མི་ཡི་ལག་ན་ཉམ་རེ་ཆུང་།",
    "ལུས་དང་སྲོག་གི་འཇིགས་པ་ཇེ་དྲག་ཡིན།",
    "ཤ་དང་ཁྲག་གི་ཁ་ཟས་འདི་མིན་ན།",
    "མི་དང་བྱོལ་སོང་བར་གྱི་བཙན་གཉོམ་འདིས།",
    "ཀུན་གྱིས་འཛིན་མོད་ཀུན་ཀྱང་སྲོག་ལ་གཅེས།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "བར་དུ་ལུས་ཀྱི་སྟེང་གི་མཁོ་ཚད་བླངས།",
    "ཉི་མ་གཅིག་གི་ལྟ་སྤྱོད་ཡ་མ་བླ།",
    "ཐུགས་རྗེ་ཕྱོགས་པའི་སྤྲུལ་རྫུན་འགའ་ཞིག་གིས།",
    "ཤ་དང་ཁྲག་གི་འཁོར་ལོ་སྐོར་བ་ཡི།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "འདོད་ཆེན་མེ་ཡིས་ཡིད་ཀྱི་བུད་ཤིང་བསྲེགས།",
    "སྐྱ་སེར་གཉིས་ཀས་འུར་ཟིང་བྱེད་མོད་ཀྱང་།",
    "འཕོ་འགྱུར་ཡིད་ལ་རེ་བ་ཁོ་ན་ལས།",
    "ཧི་མ་ལ་ཡི་ནང་གི་ཚན་རིག་ལ།",
    "འདི་གཉིས་རིན་ཐང་དབུལ་བོས་མི་ཤེས་མོད།",
    "འབྱོར་ལྡན་ཕྱུག་པོའི་སེམས་ན་ཁྲིག་ཁྲིག་རེད།",
    "ཉེར་གཅིག་དུས་ཀྱི་སྐྱ་རེངས་ཤར་བའི་ངོགས།",
    "རེ་དོགས་དྲྭ་བ་བཅད་ནས་ཐད་ཀར་བྲིས།",
    "ལ་ཁའི་ཉི་མ་ཕར་ནས་ཕར་ལ་སོང་།",
    "རེ་བའི་མིག་གིས་བལྟ་བའི་བུ་རུལ་ང་།",
    "དཀར་ནག་ལས་ཀྱིས་བྲིས་པའི་རི་མོ་སྟེ།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "ཚངས་དབྱངས་གསུང་གི་བདུད་རྩིའི་སྐལ་བ་རྫོགས།",
    "རེ་བའི་འདུན་མ་ཡང་ཡང་བཅོལ་བ་ལས།",
    "བདེ་སྡུག་ནང་གི་ཚོར་བའི་ཕུང་པོ་སྟེ།",
    "དུས་གསུམ་རྒྱལ་བས་ཕྱག་གིས་མ་ཟིན་ཀྱང་།",
    "ཕ་གཅིག་འགྲོ་བའི་མགོན་པོ་ཁྱོད་ཉིད་ལས།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྤྲུལ་བའི་བརྩེ་གླུ།",
    "ལས་དང་ཉོན་མོངས་འཐབ་པའི་བར་ལག་ནས།",
    "ཚེ་ཡི་ལྷག་མ་འདི་ཡང་ཇི་ལྟར་འཁྱོལ།",
    "བྱམས་པའི་ཕྱག་གིས་མ་གཏོང་སྐུ་དྲིན་ཅན།",
    "རང་བྱུང་སེམས་ཀྱི་རི་མོར་ཁྱོད་འཕོས་ནས།",
    "ཟླ་འོད་འཐུང་བའི་སེམས་འགྱུ། འགྲུལ་བཞུད་ཐེངས་གཅིག་གི་རྟོག་འཆར།",
    "ལང་ཚོ་ཤིན་ཏུ་གཉོམ་པའི་བག་གསར་མ།",
    "བདག་ཅག་རྨི་ལམ་ནང་གི་འདེམས་ཀ་ཡིན།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "འཇའ་ཚོན་རི་མོར་འབྲི་བའི་གྲོགས་གཅིག་པུ།",
    "སྙན་ངག་དགའ་སྡུག་སེམས་ཀྱི་ཚོར་བའི་རླབས་ཕྲེང་རེ།",
    "དྲན་པའི་རྟེན་དུ་འཕྱུར་བའི་སྙན་ངག་གིས།",
    "བྱིས་པ་འགའ་རེ་ཕར་རྒྱུག་ཚུར་རྒྱུག་བྱེད།",
    "དབུགས་རིང་ནར་མའི་བར་ནས་མིག་ཟུང་གིས།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "དགའ་སྡུག་བོད་ཞྭ་ལེབ་མོའི་ཁ་དོག་སྨུག་པོ་དང་།",
    "ཤར་བཞུད་ཁྲུང་ཁྲུང་དཀར་མོའི་གཤོག་བར་ནས།",
    "འཆི་སྒུགསྨྱུག་མའི་གཟེབ་ཏུ་བཙུད་པའི་འཇོལ་མོ་གཅིག།",
    "ལྗོན་པའི་བསིལ་འདབ་འོག་གི་མིག་མངས་གཉིས།",
    "བྱང་གི་རི་རྩེ་སྤྲིན་གྱིས་ནག་ཐིབ་ཐིབ།",
    "བྱང་གི་དེའུ་འབུར་མགོ་ན་བསིལ་ཁང་གསུམ།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྤྲུལ་བའི་བརྩེ་གླུ།",
    "སྙན་ངག་འབྲི་གཞིའི་ཤོག་ངོས་བརླན་སོང་ཡང་།",
    "སེམས་ཀྱི་རེ་བ་དམར་པོ་འབར་འབར་ནས།",
    "དབྱར་གསུམ་མཁའ་དབུགས་དྭངས་མོའི་བང་རིམ་ཉུལ།",
    "སྐྱོ་བའི་ཤུགས་གླུ་རིང་མོས་རྫོགས་ཚིག་འབྲི།",
    "སྙན་ངག་སྟོན་ཟླ་བརྒྱད་པའི་རྒུན་ཆང་གིས།",
    "ཁ་པར་ཨང་གྲངས་མཛུབ་མོས་རེ་རེར་མནན།",
    "མིག་གིས་མི་མཐོང་ལག་པས་མི་ཟིན་མོད།",
    "འགྲོ་ལ་ཚ་བའི་གདུང་བ་ཁྱོད་ཀྱིས་སེལ།",
    "བཞིན་གྱི་ཟླ་བ་ཁ་རླངས་དྲོན་མོས་བརླན།",
    "རྡོ་ཡི་གླེགས་བུར་བྲིས་པའི་མིང་བྱང་རེ།",
    "རྒོད་ཀྱི་གཤོག་པ་མཉེན་མོ་བརྐྱངས་པ་བཞིན།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "བདག་གི་སེམས་པ་གཡོ་བའི་ཉམས་དང་བསྟུན།",
    "མ་མཁའ་འགྲོས་དབྱིངས་ནས་བཀའ་བཀྱོན་རེ་མ་གནང་།",
    "གྲོགས་སྐལ་ལྡན་དག་གིས་འཕྱ་སྨོད་རེ་མ་མཛད།",
    "གཞི་ཡེ་ནས་མ་སྐྱེས་རིག་སྟོང་གི་ཀློང་དུ།",
    "ངོ་མཚར་བའི་ལྟད་མོ་ད་བར་དུ་མ་མཐོང་།",
    "སེམས་འཁྲུལ་བར་སྟོན་པའི་ཡང་གསང་གི་མན་ངག།",
    "སེམས་དགེ་སྡིག་གཉིས་ཀྱི་འདྲ་ཚུལ་དེ་རིག་ཐལ།",
    "བརྒྱ་ཕྲག་སྐྱེ་བོའི་མིག་གི་མཐོང་ཚུལ་བཤད།",
    "བདེན་པ་བདེན་པའི་ལྟད་མོ་ངོ་མཚར་ཞིག།",
    "མི་ལ་ལྷ་ཡི་མིང་གིས་བཏགས་པ་མིན།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྤྲུལ་བའི་བརྩེ་གླུ།",
    "རང་གིས་མ་མཐོང་རང་ཡིད་མི་ཆེས་པའི།",
    "སྐྱེ་བོ་དེ་ཡིས་འདི་ཡང་རྫུན་ཟེར་མོད།",
    "གསེར་ལུང་པད་མོ་འདབ་མ་དྲུག་པའི་གནས།",
    "མི་ཡི་ཁམས་དང་མོས་པ་ཐ་དད་པས།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "དེ་ཕྱིར་བདག་གིས་འདི་ནས་ངོ་མཚར་གཏམ།",
    "དེ་ཡི་རྟགས་མཚན་མཐུན་སྣང་མངོན་གྱུར་རེ།",
    "བསྟོད་དང་སྨད་པའི་ངལ་བ་རེ་ཞིག་སྐྱུར།",
    "ས་ལ་མ་རེག་ཅིག་ཤོས་ཕྱིར་ལ་འཕུར།",
    "ཁྲི་ཕྲག་སྐྱེ་བོའི་མིག་གིས་མངོན་སུམ་མཐོང་།",
    "ཇེ་མཐོ་ཇེ་མཐོར་སོང་ནས་མི་སྣང་གྱུར།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "རང་རང་དགའ་ཕྱོགས་གླེང་རྒྱུ་ཡོད་མོད་ཀྱང་།",
    "གངས་རིའི་ལྷ་གཅིག་འགྲོ་མགོན་སྤྱན་རས་གཟིགས།",
    "བདེན་དོན་མིག་ལ་སྣང་བའི་ལྟད་མོ་འདི།",
    "ཁ་བའི་འདབ་མ་ས་ལ་བབས་སོང་།",
    "སྐྱོ་བའི་སེམས་ཀྱི་འཁྱེར་སོ་ཞིག་གིས།",
    "དད་པའི་བག་ཆགས་གོམས་ཕྱོགས་ཤིག་གིས།",
    "ཐ་མལ་སེམས་ཀྱི་སྣང་ཤས་འགྱུར་སོང་།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "སྙན་པའི་གསུང་གིས་དབུགས་དབྱུང་གནང་བ།",
    "མ་བརྗེད་སེམས་ཀྱི་རི་མོ་ཉག་གཅིག།",
    "ཡུན་ཐུང་མདང་གི་རྨི་ལམ་ཇི་བཞིན།",
    "དེ་རིང་དྲན་པའི་ཕྱི་མིག་ཙམ་རེད།",
    "ཐེངས་གཅིག་བུ་ངའི་སེམས་ཀྱི་རེ་སྨོན།",
    "ཁྱེད་སྐུ་མཇལ་བའི་གོ་སྐབས་ཚར་སོང་།",
    "དཀའ་བའི་ལོ་ཟླ་རིང་མོ་ཞིག་ལ།",
    "འདས་པའི་དོན་རྣམས་རེ་རེ་དྲན་བྱུང་།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "དབེན་གསུམ་རི་ནས་དབྱར་གཞུང་རེ་རེར།",
    "བདེ་ལྡན་ཞིང་གི་སྒོ་འཕར་ཕྱེས་ནས།",
    "སྲིང་ཆུང་ལྷ་ཡི་མེ་ཏོག་བཞུད་སོང་།",
    "ཁས་བླང་གྲུབ་པའི་ཉིན་མོ་སླེབས་བྱུང་།",
    "སང་ཉིན་ཤར་རིའི་རྩེ་ནས་འཆར་མོད།",
    "རྟོགས་པའི་ཁྱུང་ལྡིང་གཅིག་གིས་འཕུར་སོང་།",
    "ལྷོ་ཡི་ཁྲུང་ཁྲུང་ལྷོ་ལ་འཕུར་སོང་།",
    "མོན་གྱི་ཁུ་བྱུག་མོན་ལ་ཆས་སོང་།",
    "སྐྱིད་ལ་སྡུག་པའི་ཕྱིར་དྲན་རེ་རེས།",
    "སྐྱིད་སྡུག་སྤེལ་བ་སྐྱུ་མའི་ལྟད་མོར།",
    "ཟླ་འོད་འཐུང་བའི་སེམས་འགྱུ། ཨ་མའི་བྱམས་བརྩེ་ས་མཐའ་ནས་དྲན་པའི་སྐྱོ་དབྱངས།",
    "བརྩེ་ལྡན་ཨ་མ་ད་རུང་འཆི་ལམ་དུ་མ་མངགས།",
    "ཉིན་བཞིན་རྒ་བའི་བ་མོས་ལང་ཚོ་ཡི་འདབ་མ།",
    "ཞོགས་པའི་སྨུག་སྤྲིན་སངས་དུས་སྐྱོ་གདུང་གི་སྣོན་མ།",
    "དྲིན་ཆེན་ཨ་མའི་བྱམས་བརྩེས་སྐྱོང་སྐྱོང་ལ་རེ་བ།",
    "སྐྱིད་སྡུག་སྨྲ་བ་བསྐྱུངས་འདི་སྐྱོ་གདུང་གིས་མནར་བྱུང་།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "ང་རང་ཨ་མའི་དྲུང་ན་འཛུམ་དཀར་གྱིས་འཚོ་བ།",
    "གཅོང་རོང་ལམ་འཕྲང་དཀའ་བའི་ཉིན་ཞག་གིས་བཅད་ནས།",
    "ཨ་མའི་བུ་ངས་ཨ་མ་ལྷག་པར་དུ་དྲན་ཡོང་།",
    "ཨ་མའི་དུང་སེམས་ནམ་ཡང་བརྗེད་ཐབས་ཤིག་མི་ཐོན།",
    "ཚེ་གཅིག་ཨ་མ་དྲན་པའི་སྐྱོ་ངལ་གྱི་གདུང་བ།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྤྲུལ་བའི་བརྩེ་གླུ།",
    "མུན་པའི་གོ་སྐབས་རིམ་གྱིས་ཕར་ཕར་ལ་ཟད་མོད།",
    "དྲིན་ཆེན་ཨ་མ་དྲན་པའི་གསལ་འདེབས་དང་འདྲའོ།",
    "དྲིན་ཆེན་ཨ་མའི་མདུན་སར་འགྲོ་འདོད་ཅིག་ཡོད་ཀྱང་།",
    "མནོག་ཆུང་ཐོས་པ་བསམས་ནས་ད་བར་དུ་ལུས་སོང་།",
    "འབྱོན་བཞུད་གོམ་ཁ་འཁྱོར་བའི་རྣམ་འགྱུར་དེ་དྲན་ན།",
    "ཤ་དཀར་ལང་ཚོའི་སྐྱེ་མཆེད་མཚར་སྡུག་ཅིག་མིན་ཡང་།",
    "ཉིན་བཞིན་བསྟེན་དགོས་བྱུང་ན་ཨ་མ་དེ་དྲན་ནོ།",
    "འཆི་སྲིད་གཤེད་མའི་རལ་གྲིས་མ་ཆོད་མོད།",
    "མཐོ་ལ་སྲིད་པའི་རྩེ་མོ་མན་ཆད་ནས།",
    "ཡོད་མིན་མེད་མིན་སྲིད་པའི་རྩེ་མོ་ནས།",
    "སྐབས་རེར་ཡིད་འཕྲོག་ལྷ་ཡི་རྒྱལ་ཁབ་ཏུ།",
    "ཡིད་འཛིན་ལྷ་ཡི་བུ་མོའི་རྩེ་རོགས་ཡིན།",
    "འཆི་བའི་ནངས་མོར་ཕངས་བས་ཤུལ་དུ་སྐྱུར།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "བར་མའི་འཇིག་རྟེན་ཁམས་ལ་གྲངས་མེད་སོང་།",
    "སྡུག་གི་མཆི་མ་ཤོར་ནས་ཡུན་རིང་འགོར།",
    "ན་ཆུང་བུ་མོའི་འཛུམ་དཀར་ཁྱོད་ལ་མཁོ།",
    "དུག་གསུམ་དུག་གི་ན་བུན་ཁྱོད་ལ་འཐིབས།",
    "སྲིད་གསུམ་སྡུག་གི་ཁུར་བོ་ཁྱོད་ཀྱིས་ཁུར།",
    "ཤེས་མེད་ལང་ལ་ཤོར་བའི་གཅེས་ཕྲུག་ཁྱོད།",
    "སྐྱབས་མེད་རིགས་དྲུག་གནས་ལ་འཁྱམས་འཁྱམས་མོད།",
    "སྐྱིད་ལ་རེ་བའི་སེམསཀྱི་བུ་ཆུང་ཁྱོད།",
    "བདག་མེད་བུད་ཤིང་ཟ་བའི་དུས་ལ་བབ།",
    "ལམ་རྩོལ་མེད་རང་བབས་རང་བྱུང་གི་རིག་པ།",
    "གྲོགས་མཁའ་ལྡིང་ཁྱུང་གི་བུ་རྒྱུད་དང་འགྲོགས་ནས།",
    "རི་རྩེའི་སྨུག་པ་བྱང་གི་སྤྲིན་ལ་འདྲེས།",
    "སོས་ཀའི་ཞོགས་པ་རི་མོར་བྲིས་ལ་བལྟ།",
    "དར་ལྕེ་ལེབ་མོའི་ཕྱེད་ཀ་ཁ་བས་མནན།",
    "ལྕུག་ཕྲན་ཡལ་ག་སྐམ་པོ་རེ་ཟུང་གིས།",
    "ལ་ཁའི་ཁ་བ་སྲབ་མོའི་ཤོག་དཀར་ལ།",
    "ཡལ་ག་སྐམ་པོ་ཞིག་གིས་ག་ལེར་བྲིས།",
    "བུ་མོ་ཧྲན་ཧྲན་རྒྱ་ནག་ཡུལ་ནས་ཐོན།",
    "ལང་ཚོའི་འདབ་མ་གྲོལ་ནས་ཡུན་རིང་འགོར།",
    "རེ་བའི་རྨི་ལམ་ནང་ནས་ལོ་ཤས་འགོར།",
    "ལང་ཚོ་སྨིན་པའི་ཁྲག་གི་འཕར་རྒྱུན་བཞིན།",
    "བུ་མོའི་ལུས་ལ་ཟུག་རྔུ་ཇེ་ཆེ་ཡིན།",
    "ལེ་བར་སྟོང་གི་བར་གྱི་བོད་ཡུལ་ལ།",
    "གློག་གི་སྐུད་པ་བརྒྱུད་ནས་སྐད་འདི་བཤད།",
    "ན་ཆུང་བུ་མོའི་གསང་གཏམ་རྗེན་པ་ཡིན།",
    "མཇུག་མཐའི་ཕྱི་མིག་ཁྱོད་ལ་ཡང་ཡང་ཐོགས།",
    "འོན་ཀྱང་ཚོར་སྣང་མེད་པའི་ལག་གཡུག་དེས།",
    "ཁྱོད་ལ་འབུལ་བའི་འདུན་པ་སྐྱེས་བྱུང་ཟེར།",
    "མ་རྙེད་ལང་ཚོའི་མེ་ཏོག་ཡོངས་སུ་སྨིན།",
    "སེམས་ཀྱི་རེ་བ་ལོ་འགར་མེ་བཞིན་འབར།",
    "ནང་གི་དུང་བ་ཟབ་མོ་དགོས་མེད་དུ།",
    "འདོད་པར་སྐྱེས་པའི་སྐྱེ་བོ་ཕལ་མོ་ཆེ།",
    "ཁོ་བོའི་གཏམ་ལ་རྣ་བ་མཛུབ་མོ་ཁོབ།",
    "ན་ཆུང་བུ་མོའི་ཟུར་ཙམ་གླེང་ན་ཡང་།",
    "ཀློག་མཁན་དག་གི་ནང་ཉམས་མ་བླངས་པའི།",
    "འདོད་པའི་འདམ་དུ་བྱིང་བའི་བུ་མོ་ལ།",
    "ངག་ལས་ངག་གི་འདོད་པ་འཇོ་ཕྱིར་བྲིས།",
    "བྲིས་ན་ཟད་དུ་མེད་པ་སེམས་ཁོང་གི་སྙན་ངག།",
    "ལང་ཚོའི་མཇུག་འབྲས་ཡོད་ཚད་ཐག་རིང་ལ་བཅོལ་ཡོད།",
    "མཚོ་མོ་ཁྱོད་ཡིད་སྐྱོམ་པའི་རླབས་ཕྲེང་དང་རླབས་ཕྲེང་།",
    "ད་དུང་རེ་སྒུག་གཅིག་གི་ལྷག་མ་རུ་ལུས་ཡོད།",
    "ཡོད་ཚད་སེམས་ཀྱི་རེ་བ་དོན་ཡོད་རང་མིན་ནམ།",
    "དགུ་ཚིགས་དུས་ཀྱི་གྲང་རེག་ཁྱིམ་ཕུག་ཏུ་བོས་ནས།",
    "སྲ་འཐས་ཆུ་ཐིགས་ཕྲ་མོ་སེམས་ཁོང་དུ་བསགས་ཀྱང་།",
    "ཁུ་བྱུག་གྲག་ཐེངས་རེ་རེ་མཛུབ་དཀྲིས་སུ་ཟུངས་དང་།",
    "སྔོ་ལྗང་དབྱར་ཁ་རེ་རེ་སེམས་རྟེན་དུ་འབུལ་ཡོང་།",
    "ཁྱོད་སེམས་དཀྱིལ་དུ་ཐིམ་པའི་རྣམ་འགྱུར་ཞིག་སྟོན་རོགས།",
    "བཅོ་བརྒྱད་ལང་ཚོ་དར་བའི་སྐྲ་ལོའི་འདབ།",
    "ལན་གཅིག་ལུས་ལ་རེག་པའི་སིམ་པ་འདི།",
    "བདག་གི་སེམས་པ་ཕྱི་ནང་བར་གསུམ་བརླན།",
    "ཕན་ཚུན་སེམས་ཀྱི་དུང་བ་ཟབ་མོ་འདི།",
    "ཁོ་མོའི་ལང་ཚོའི་མེ་ཏོག་གསར་བ་འདིའི།",
    "བུ་མོའི་སེམས་པ་འཕྲོག་པའི་མཛེས་སྡུག་ནི།",
    "ལུས་དང་ལང་ཚོའི་སྐྱེ་མཆེད་མ་ཡིན་ཏེ།",
    "བདག་གི་སྐྱབས་ནི་ཤཱཀྱ་མུ་ནེ་ཡིན།",
    "བདག་གི་ཕུགས་འདུན་ཆུ་བོའི་རྒྱུན་ལས་རིང་།",
    "ཁྱོད་ཀྱི་རེ་བ་དམར་པོ་མེ་ལས་ཚ།",
    "རང་རང་བསམ་ཕྱོགས་གླེང་བའི་མཚན་མོ་འདིར།",
    "མི་ཡི་བུ་མོ་མ་ལགས་ལྷ་ཡི་ལྕམ།",
    "འོན་ཀྱང་ལས་ཀྱི་བཀོད་བསྒྲིག་ཁ་ཁ་རེད།",
    "མཚན་མོའི་ཟླ་བ་ལྗོན་པའི་རྩེ་ནས་ཡལ།",
    "༢༤ ༨ ༡༣ ལ་སྨུག་ལོང་གི་གྲུ་ག་དེ་ནས་སྨྱོན་པ་དེས་གང་བྱུང་དུ་ལབ་པའོ།",
    "སྣང་སྲིད་འཁོར་འདས་མཉམ་པ་ཉག་གཅིག་གི་ཐིག་ལེ།",
    "ཞེན་མེད་སྟོང་གཟུགས་སྒྱུ་མའི་ལྟད་མོ་ལ་རོལ་ནས།",
    "ལྷན་སྐྱེས་བདེ་ཆེན་རྟོགས་པ་ཉིན་རེ་བཞིན་མཆེད་ཅིང་།",
    "རེ་དོགས་ཟུག་རྔུའི་ཐག་པ་སེམས་ཁོང་ནས་ཆད་དེ།",
    "དོན་དམ་རང་ཞལ་མཇལ་བའི་བཅུ་དྲུག་གི་དགའ་བ།",
    "སྤྲིན་པ་ལེབ་མོ་གཡོ་བའི་ཕྱོགས་དེ་ན།",
    "བདག་གི་རྨི་ལམ་ནང་གི་ཤམ་བྷ་ལ།",
    "འདས་པའི་དོན་རྣམས་ཡིད་ལ་རེ་རེ་བཞིན།",
    "རིམ་པར་ཤར་བས་མཚན་མོའི་གཉིད་ཀྱང་བརྗེད།",
    "སྨིན་དྲུག་ཁྲ་མོ་སྐབས་རེར་ཤར་ན་ཡོད།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "ལོ་སར་དུས་ཆེན་ཉིན་མོར་ཐམས་ཅད་དྲན།",
    "རང་གི་ཕ་ཡུལ་སྔར་གྱི་ཕ་ཡུལ་མིན།",
    "རང་གི་གཉེན་ཉེའི་ཁྱིམ་ལ་སླེབས་ནས་འདུག།",
    "དགོང་ཁའི་མཚམས་སྤྲིན་འོག་ནས་བདག་གི་སེམས།",
    "ཐག་རིང་ཡུལ་གྱི་ཕ་ཡུལ་དྲོན་མོ་ན།",
    "ཨ་མའི་སེམས་ཀྱི་དྲོད་ཁོལ་སྔར་བཞིན་ཡོད།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྦྲུལ་བའི་བརྩེ་གླུ། ཐོར་བུ་ཁོལ་དུ་ཕྱུང་བའི་ཚོམ་བུ།",
    "གླེན་པ་ཨུ་ཚུགས་ཅན་ལ་རེ་མི་བཅོལ།",
    "སྡུག་བསྔལ་ཕྱག་གིས་སེལ་བའི་ཐབས་མ་བཙལ།",
    "ཕན་པའི་སེམས་ཀྱི་གཏམ་ཞིག་བདག་གིས་བཤད།",
    "ཤར་གྱི་རྒྱ་ཡིས་ནུབ་ཀྱི་ལད་མོ་བྱེད།",
    "དེ་ལྟར་གཅིག་གི་ལད་མོ་གཅིག་བྱས་ནས།",
    "སྐད་དང་ཆ་ལུགས་གནམ་སའི་རྒྱ་ཁྱོན་བརྗེ།",
    "སྐད་དང་ཡི་གེ་གཅིག་གིས་གཅིག་ཏུ་བསྡུས།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྒུལ་བའི་བརྩེ་གླུ།",
    "བདག་གི་སྟོན་པ་ཐར་བའི་ས་མཁན་ཡིན།",
    "རང་རང་བདེ་བ་འཚོལ་བའི་བྲེལ་ཟིང་གིས།",
    "ཡོད་མེད་གྲོས་ཐག་རང་གིས་མི་ཆོད་པའི།",
    "ལུས་དང་ངག་གི་ཀུན་སྤྱོད་གཙང་མ་ཡིན།",
    "མི་རེའི་ཁོང་ན་བསམ་པའི་དམིགས་ཡུལ་རེ།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྤྲུལ་བའི་བརྩེ་གླུ།",
    "སྲིད་པའི་ཁྲོམ་ཆེན་འགྲིམ་པའི་ལྟད་མོ་པ།",
    "འཁྲུལ་སྣང་རེ་སྐྱིད་རེ་སྡུག་བསམ་མི་ཁྱབ།",
    "དྲང་པོའི་མི་ལ་འཁྱོག་པོའི་ལམ་མི་མཁོ།",
    "བདག་གི་སྟོན་པའི་བསྟན་ལ་འདྲ་ཚུལ་མེད།",
    "གཡོ་སྒྱུ་ཝ་མོས་ཞོམ་ཞོམ་བྱེད་པ་ན།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྤྲུལ་བའི་བརྩེ་གླུ།",
    "གླེང་མོལ།",
    "འབྱུང་འགྱུར་སྐྱིད་སྡུག་གླེང་བའི་གླེང་མོལ་ལ།",
    "འཇུག་འདོད་བདག་ལྟའི་སྐྱེ་བོ་ཕལ་མོ་ཆེ།",
    "དམར་སེར་གོས་གྱིས་གཡོགས་པ་དོན་རེ་ཆུང་།",
    "སྐྱབས་སུ་འགྲོ་བ་སེམས་ཀྱི་རེ་སྨོན་ཡིན།",
    "འབོལ་རྩོམ་གྲོང་ཚོ་སྤྲུལ་བའི་བརྩེ་གླུ།",
    "རང་རང་སྲོག་གིས་འཚོ་བའི་སྲོག་ཆགས་རྣམས།",
    "ཡུན་རིང་གསོན་པར་དཀའ་བའི་འཇིགས་སྣང་གིས།",
