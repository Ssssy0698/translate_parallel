    "མཁྱེན་ལྡན་ས་བརྟོལ་གྱི་ལྗོན་པ་ག་ལ་བར།",
    "དཀར་མིན་ནག་མིན་གྱིས་མི་ཚེ་ཡོལ་བར་བྱས།",
    "པེ་ཅིན་དུ་ལྕགས་བྱའི་ནང་ནས་འགྲོ་རྒྱུ་བྱས།",
    "ལྷ་ས་ནས་རྡོ་རྗེ་རྒྱལ་བོ་སོགས་མི་ཁ་ཤས།",
    "གཞུང་ནས་རྒྱུ་ནོར་ཅི་ངས་གཏོང་ཟེར་ཞིང་ངེད་ཅག་ལོ་ན་མཐོ་བ་དག་ཕར་འགྲོ་ཚུར་འགྲོའི་དོན་དུ་རླངས་འཁོར་ཆུང་བ་ཞིག་ཀྱང་གནང་རྒྱུ་ཐག་བཅད།",
    "ཚེས་ཉིན་རང་བསམ་གྱིས་འཁྱམ་སྐྱོད་བྱས།",
    "ཚེས་ཉིན་སྔ་དྲོ་གསར་བརྗེའི་གནའ་དངོས་བཤམས་སྟོན་ཁང་དུ་ལྟ་སྐོར་བྱས།",
    "ཕྱི་དྲོ་རང་བསམ་གྱིས་འཁྱམ་སྐྱོད་བྱས།",
    "ལ་ཊ་ལ་ལགས་ཟེར་བ་དང་།",
    "ཨ་ལགས་ཚེ་ཏན་ཚང་ཡང་འདི་གར་ཡོད།",
    "ཁྱེད་འདིར་ཕེབས་གསོལ་ཟས་ཐེངས་གཅིག་དྲངས་པ་པའི་དགའ་སྟོན་ཡིན་གསུངས་ནསདང་གསོལ་ཟས་སྐབས་ངེད་ཀྱི་རྒྱུས་ཡོད།",
    "ཐེངས་རྗེས་མར་མཇལ་སྐབས་མཉམ་དུ་པར་ཞིག་བསྐྱོན་དགོས་གསུངས་ནས།",
    "གསལ་ངེད་ཅག་བཞི་མཉམ་དུ་པར་རྒྱག་པ་སོགས་དང་ཞལ་འཕྲོས་ཤིན་ཏུ་རྒྱས།",
    "ལན་གྱི་བཀའ་ཤོག་ངའི་ལག་ཏུ་འཇོག་གསུངསདེ་རིང་ད་དུང་མ་གནང་།",
    "གནང་བ་དང་འཕྲལ་དུ་སྐུར་ངེས་ཡིནའདི་ཚེ་དཔལ་གྱིས་ངའི་ལག་ཏུ་བསྐུར་སྟབས།",
    "ཉམ་ང་མེད་པར་དཔའ་ཉམས་སྟོན།",
    "ཞེས་པ་ནི་བསོད་རབ་ལ་གནང་བའོ་སྤོས་མཆོག་ཡིད་འོང་དྲི་མཆོག་ལྡནསྤོས་དྲི་བཟང་བོས་ནམ་མཁའ་ཁྱབ།",
    "འབྱུང་འདུས་ཟུག་རྔུ་རྣམ་པར་བཅོམ།",
    "དུ་ཁ་མ་ལུས་འཇོམས་པར་ཤོག།",
    "འཛིན་མཁན་མཁས་པའི་མཁས་ཚུལ་དཔལ་ཐོབ་ཤོག། ། ཟུར་ཕུད་ལྔ་བའི་མཁྱེན་དང་བརྩེ་བའི་ནོར།",
    "གླེགས་བམ་ཙམ་ལ་བརྟེན་ནས་ནིགཞན་མགོ་བསྐོར་བ་མ་ཡིན་པར།",
    "ཁྲལ་འཇལ་ངང་ཚུལ་གཏན་མིན་པར།",
    "འཕྲིན་ལས་ཡལ་ག་ཁོ་ལག་རབ་རྒྱས་པར།",
    "ལྷུག་པར་གྲོལ་བ་འདི་ལ་ཡིད་ཆེས་མཛོད།",
    "མཆོག་ཐུན་ཆར་གྱིས་ཤེས་རྒྱུད་བརླན་པར་ཤོག།",
    "རྣམ་པར་རོལ་བའི་དགའ་བ་བསྐལ་བརྒྱའི་བར།",
    "རྣམ་པར་རྒྱས་པའི་དཔལ་གྱིས་འཚོ་གྱུར་ཅིག།",
    "རྣམ་དཀར་སོ་ནམ་གྱིས་གཏན་བདེའི་ས་བོན་དཔག་མེད་འདེབས་པར་གྱུར་ཅིག།",
    "ཡོན་ཏན་རྒྱ་མཚོའི་གླིང་དུ་བགྲོད་པར་མཛོད།",
    "ཆད་མེད་སྙོམས་པར་བབ་པ་ལས།",
    "བདུད་ལིར་གནང་བའོ། ། རྣམ་པར་དཀར་བའི་འཕྲིན་ལས་ཀྱི།",
    "བཙན་རྒྱལ་སྨྱོ་ཧམ་ཅན་དག་བརྒྱལ་བར་བྱས།",
    "གྲོགས་བྱས་པདྨ་གཞོན་ནུའི་དགའ་ཚལ་རྒྱས།",
    "སློབ་བུ་དག་ལ་གནང་བའི་བརྡ་སྤྲོད་ཀུན་བྱེད་ཀྱི་མཚན། ། ཨོཾ་བདེ་ལེགས་སུ་གྱུར་ཅིག་མཚན་དཔེའི་མེ་ཏོག་རབ་ཏུ་མཛེས།",
    "༡ རྒྱལ་ཀུན་མཁྱེན་བརྩེའི་རྒྱ་མཚོ་འཕྱུར་བའི་རླབས།",
    "སྐལ་བཟང་འདོད་པ་འཇོ་བར་ཤོག་བློ་བཟང་ཐབས་མཁས་ལ་གནང་བའོ་༥ མཚོ་ལྡན་ཟག་མེད་དགའ་བའི་འཛུམ།",
    "ཉི་མའི་ཟེར་ལ་འགྲན་པར་ཤོག་ཀུན་དགའ་ཤེས་རབ་འོད་ཟེར་ལ་གནང་བའོ་༦མཚོ་བྱུང་དགེས་པའི་གྲུབ་པའི་མཆོག།",
    "སྐལ་བཟང་ལུང་རྟོགས་རྒྱ་མཚོ་ལ་གནང་བའོ།",
    "བསམ་གཏན་རྒྱ་མཚོ་ལ་གནང་བའོ།",
    "འཇིགས་མེད་བསྟན་པའི་རྒྱ་མཚོ་ལ་གནང་བའོ་༡༦དབྱངས་ཅན་མཛེསཛེས་མ་ཟག་མེད་ཀྱི།",
