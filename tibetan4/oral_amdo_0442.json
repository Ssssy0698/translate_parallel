    "གདུགས་དང་བ་དན་དང་རོལ་མོ་ལ་སོགས་པས་གདན་དྲངས་ནས་བའི་ལྕི་བས་བྱུགས་ཏེ་གཙང་པོ་ཆེན་པོའི་འགྲམ་དུ་འདུག་ནས་རྡུལ་ཚོན་དཀར་པོས་པདྨ་འདབ་མ་བརྒྱད་པ་བྲིས་ལ་པདྨའི་ཟེ་འབྲུ་ལ་ཨོཾ་ཨཱ་བ་རུ་ཎཱ་ཡ་ཧཱུཾ་སྭཱ་ཧཱ།",
    "དེ་ནས་ཀླུ་རྣམས་ཀྱིས་བཀུར་སྟི་ཆེན་པོས་ས་འོག་གི་མཐིལ་དུ་གདན་དྲང་པར་བསམ་པར་བྱའོ།",
    "སྦྱིན་བདག་གིས་སློབ་དཔོན་དང་སྒོ་ན་གནས་པའི་སློབ་དཔོན་དང་ལས་ཀྱི་རྡོ་རྗེ་དང་།",
    "དེ་ནས་མཚན་མོའི་དུས་ཀྱི་ཚོགས་ཀྱི་འཁོར་ལོའི་ཆོ་ག་བྲི་བར་བྱ་སྟེ།",
    "སྐལ་པ་ཅན་དེ་རྣམས་ལ་ལས་ཀྱི་རྡོ་རྗེ་ཅན་གྱིས་སོང་ནས་དེ་རྣམས་ཀྱི་མདུན་དུ་མཎྜལ་བྱས་ནས་སྙན་གསན་དབབ་པར་བྱའོ།",
    "དེ་ནས་ན་མོ་ནི་ཤཱ་བེ་ར་བཱ་ཡ་ཙི་རི་ཙི་རི།",
    "རཾ་ཡིག་ལས་བྱུང་བའི་མ་དང་ཊ་ཡིག་དག་གི་མིག་གི་རི་མོ་དག་གོ།",
    "ཨཊྚཊྚ་དགོད་རྒྱལ་བར་བྱེད་པ་ཉེ་བར་རྒྱལ་བྱེད་ཙ་རི་ཏྲ་དང་ཀོ་ཙཱི་ཆར་པ་རྣམས་རྒྱུད་ལས་གསུངས་པའི་རིམ་པས་དམ་ཚིག་གི་རི་ལུ་རྣམས་བསྒྲུབས་ནས་ཁར་བཅུག་སྟེ་ཆང་ལྷག་པར་གནས་པ་དང་།",
    "དེའི་སྟེང་དུ་བཾ་ཡིག་ལས་བྱུང་བའི་ཆུ་བདག་གི་རང་བཞིན་གྱི་སྣོད་དོ།",
    "ཨོཾ་ཨ་མྲྀ་ཏེ་ཨ་མྲྀ་ཏེ་སཾ་བྷ་བེ་ཨེ་ཧྱེ་ཧི་ཨ་མྲྀ་ཏེ་པྲ་བ་ཤཱ་ཡ་ཧྲཱི་ཧཱུཾ།",
    "འདིས་ལན་གསུམ་མམ་ཉི་ཤུ་རྩ་གཅིག་གིས་བདུད་རྩི་དགུག་པར་བྱའོ།",
    "མི་མོ་ཞལ་གྱི་པདྨ་ཅུང་ཟད་དམར་ཞིང་ནུ་མ་མཁྲེགས་ཤིང་རྒྱས་པ་ཟུང་ལྡན་རྒྱན་རྣམས་ཀུན་གྱིས་རྣམ་པར་བརྒྱན།",
    "ཤིན་ཏུ་ཡོན་ཏན་རྒྱ་ཆེན་དང་ལྡན་ཡིད་ཀྱི་མི་མཐུན་ཕྱོགས་བོར་རྣམ་པར་དུལ་བཅས་བཙུན་མོས་བདུད་རྩི་སོ་སོར་དབུལ་བར་བྱའོ།",
    "གཉིས་དང་གཉིས་མིན་རྣམ་གྲོལ་ཁྱོད།",
    "འཁོར་ལོའི་མགོན་པོ་ཁྱོད་ལ་འདུད།",
    "ཡེ་ཤེས་སྩོལ་མཛད་ཁྱོད་ལ་འདུད།",
    "དག་པའི་གཟུགས་ཅན་ཁྱོད་ལ་འདུད།",
    "སྲིད་པ་སྒྲོལ་མཛད་ཁྱོད་ལ་འདུད།",
    "ཚོགས་ཀྱི་འཁོར་ལོ་ཁྱོད་ལ་འདུད།",
    "དེ་ནས་སྐྱུར་མོ་དང་།",
    "དེ་ནས་མངར་མོ་དང་།",
    "སོ་སོར་རེ་རེ་ནས་ཕུང་པོ་ལས་གསར་པ་རྣམས་གོ་རིམས་བཞིན་དུ་བླངས་ནས་ཆང་དང་ཆུ་དང་།",
    "དེ་ནས་སྦྱིན་བདག་གིས་དྲི་བཟངས་ཀྱི་ཆུས་སྔོན་བཞིན་དུ་མཎྜལ་བྱས་ནས་ཚིགས་སུ་བཅད་པ་གསུམ་པོ་འདིས་གསོལ་བ་གདབ་པར་བྱའོ།",
    "དཔལ་གྱི་གནས་དབུས་མཆོག་གི་དཀྱིལ་འཁོར་འཁོར་ལོའི་མགོན་པོ་སྟེ།",
    "དེའི་དབུས་ལ་མཆོག་གི་ཧཾ་ས་ཀུནྡ་དཀར་པོ་རྣམ་པར་སྐྱེད་མཛད་ཀུན་གྱི་བདག།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཤིན་ཏུ་རྣམ་དག་གནས་ནི་ཤིན་ཏུ་མཛེས་པའི་ལྷ་མོའི་གནས་ལ་ནི།",
    "དཀྱིལ་འཁོར་པའི་ལྷ་རྣམས་དང་བཅས་པ་ལ་མཐེ་བོང་དང་མིང་མེད་དག་གིས་བདུད་རྩིའི་ཐིགས་པ་ཡང་དག་པར་བཟུང་ནས་ལེགས་པར་དབུལ་བར་བྱའོ།",
    "མཚན་མོ་རིལ་པོ་གཉིད་ཉལ་བར་མི་བྱའོ།",
    "དེའི་དབུས་སུ་རང་རང་གི་ལྷ་རྣམས་སུ་བོན་ལ་གནས་པར་གྱུར་ཏེ།",
    "རང་གི་སྤྱི་བོར་གནས་པའི་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་རང་རང་གི་ལྷ་རྣམས་ཀྱི་མཚན་མ་ནས་ཀྱི་འབྲུའི་ཚད་ཙམ་རྣམ་པར་བསྒོམས་ལ་ཚིམ་པར་བྱའོ།",
    "དེ་ནས་སོ་རྩི་དང་མར་མེ་དང་སྤོས་ཀྱི་རེང་བུ་ལ་སོགས་པ་ཕུལ་ནས་རྩ་བའི་གཏོར་མ་ཤར་ཕྱོགས་སུ་གནས་པའི་གཏོར་མའི་སྟེགས་བུ་ལ་དབུལ་བར་བྱའོ།",
    "ཟན་དང་ཚོད་མ་ལ་སོགས་པ་བྱིན་ནས།",
    "དེ་ནས་ཟས་གཙང་མའི་ལྷག་མ་རྣམས་ཀྱང་ཅུང་ཟད་བསྡུས་ནས་ཟན་དང་ཚོད་མ་ལ་སོགས་པ་བྱིན་ནས།",
    "དེ་ནས་ལག་པ་བཀྲུས་ནས་དྲི་དང་སོ་རྩི་དང་མཆོད་ཡོན་ལ་སོགས་པ་ཕུལ་ནས་སྦྱིན་བདག་གིས་མཎྜལ་བྱས་ནས་མར་མེ་ཕུལ་ལ།",
    "དེ་ནས་གང་གི་ཚེ་སྦྱིན་སྲེག་གི་མེ་ཉེ་བར་ཞི་བར་གྱུར་ནས་རྒྱ་ཆེར་བསྡུས་ནས་ཆུ་རབ་ཏུ་དབབ་པ་ལས་གསུངས་པའི་ཆོ་གས་དེ་བཞིན་དུ་ཐལ་བ་རྣམས་ཆུ་བོ་ལ་གཤེགས་པར་བྱའོ་ཞེས་སོ།",
    "འདི་ནི་བདག་གི་རྒྱུད་རྣམས་ཀུན་ལས་ངེས་བརྟགས་ནས།",
    "དུག་དང་ཁྲག་གིས་བྲི་བར་བྱ་།",
    "དེ་ན་རྒྱ་མཚོར་གླིང་ཚོགས་ཞེས་བྱ་བ་ཤིན་ཏུ་ཡང་རྒྱ་ཆེ་ཞིང་གཏིང་ཟབ་པ།",
    "ཆེ་གེ་མོ་མ་ར་ཡ་ཧུམ་ཕཏ།",
    "གནོད་སྦྱིན་ནག་པོ་དཔུང་གི་ཚོགས་།",
    "ཁྱོད་ཀྱིས་འདི་ལ་ཆད་པ་ཆོད་།",
    "ཡུངས་ཀར་ཤིང་དང་དུག་ཤིང་གིས་།",
    "སྲོག་བདག་ནག་པོའི་དཔུང་ཚོགས་ཀྱིས་།",
    "དྲག་པོ་སྦྱིན་སྲེག་གི་ལེའུ་སྟེ་དགུ་པའོ་།",
    "ཁྲག་དང་དུག་གིས་བྱུག་པར་བྱ་།",
    "ཁྲག་དང་དུག་གིས་བྱུགས་ལ་བརྡེག།",
    "ཁྲག་དང་དུག་གིས་ནག་པོར་བྱུག།",
    "ཁྲག་དང་དུག་གིས་ནག་པོར་བྱུག།",
    "དུག་ཤིང་ཚེར་མའི་ཤིང་གིས་བྱ་།",
    "སྐྱེ་མཆོག་ཁྱོད་ལ་ལས་བཅོལ་ལོ་།",
    "དེ་ཕྱིར་ཁྱོད་ལ་འཕྲིན་ལས་བཅོལ་།",
    "ཁྲག་དང་དུག་གིས་ནག་པོར་བྱུག།",
    "མོན་ནམ་རབས་ཆད་ཐོད་པ་རུ་།",
    "ཆེ་གེ་མོ་ལ་ལྕེ་འབབ་པ་མ་ར་ཡ།",
    "མིག་ནས་ཁྲག་གི་སེར་བ་འབབས་།",
    "མནྡལ་ཟླུམ་པོ་ཁྲག་གིས་བྱུག།",
    "རྟག་ཏུ་མཆོད་བསྟོད་ལས་ལ་མོས་།",
    "དམ་ཚིག་གི་ལེའུ་སྟེ་བཅུ་དགུ་པའོ་།",
    "ཉོན་མོངས་བདུད་ཀྱི་དཔུང་ཚོགས་འཇོམས་།",
