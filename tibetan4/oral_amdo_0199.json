    "བེ་སྐྱེས་རེ་རལ་ཁཟླ་བཞི་འགྱུར།",
    "ས་ལ་ནར་མོར་གནས།",
    "གྲང་ན་ཆང་གིས་ཕུལ་ནས་གུང་ལ་བཏང་།",
    "ཞག་གསུམ་སོང་ནས་ཕྱེ་མ་ཕུལ་རེ་གྲང་ན་ཆང་དང་ཚ་ན་དྲི་ཆུས་འཕུལ་བ་ཞག་རེ་བཏང་།",
    "ཟླ་དུག་ལ་གོང་གི་བདུད་རྩི་སྔོའི་སྦྱོར་བས་སེལ་ལོ།",
    "ག་བུར་དགུ་པ་ནི་ག་བུར་གུར་ཀུམ་ཨ་ཀ་རུ་ལི་ཁྲི་མཚལ་ཏིག་ཏ་ཧོང་ལེན་རེ་རལ་གྲོ་ཆང་སྲོ་ལོས་བསིངས་པའོ།",
    "ཞོ་ཤ་གསུམ་གུར་ཀུམ་སུག་སྨེལ་ཛཱ་ཏི་ལི་ཤི་ཀ་ཀོ་ལ་རྒྱ་མཚོའི་ལྷུ་བ་པུ་ཤེལ་རྩེ་མཚེ་ཚིགས་སྲིན་བུ་དུག་མོ་ཉུང་ཐལ་ཀ་རྡོ་རྗེ་སོ་མ་རཱ་ཛའོ།",
    "སྒོག་པ་ཆིག་སྐྱེས་བྱི་ཏང་ཀ་ཨ་རུ་ར་གུར་ཀུམ་མོ།",
    "བཟང་པོ་དྲུག་གིས་དོན་ཚད་འཕུལ།",
    "འབྲས་བུ་གསུམ་གྱིས་ཕྱི་ཚད་འཕུལ་བར་བྱེད་པས་དེ་རྣམས་ཞིབ་པར་བཏགས་ལ་ཆ་གསུམ་དུ་བྱས་ལ་ཆ་གཅིག་ཐོ་རངས་ཆང་གིས་འཕུལ་ལ་བཏང་བས་རྩ་ལམ་བ་སྤུའི་ལམ་འབྱེད།",
    "ཤིན་ཏུ་རྡུལ་བཏོན་པ་དཀའ་བ་ལ་ཆུ་ཚན་བསིལ་དྲོད་གང་རིགས་བསྟེན་པ་ནི་འབྱུང་པའི་ཆུ་ལུམས་སམ་རང་བྱུང་གི་ཆུ་ལུམས་ཞེས་བྱ་སྟེ།",
    "ཅོང་ཞི་བུ་མོ་ལོ་བརྒྱད་ཆུས་ཕུལ་འཇོམས།",
    "གཉིས་པ་ནི་གདོན་གྱིས་ལོག་པ་མོ་ཕྱ་རིམ་གྲོས་བཅོས།",
    "ཞེས་གདོན་གྱིས་ལོག་པ་ན་ངོས་འཛིན་པའི་མོ་ཕྱ་དེ་མཐུན་གྱི་རིམ་གྲོས་བཅོས་ཏེ།",
    "ག་བུར་ཅུ་གང་བྲག་ཞུན་ཨ་རུ་ར་ཙན་དན་དུག་མོ་ཉུང་བ་ལེ་ཀ་ཏིག་ཏ་བ་ཤ་ཀ་ཀ་རའོ།",
    "ཨ་རུ་ར་གཅིག་བསྲེག་གཅིག་མ་བསྲེག་པའི་ཐང་གིས་དབུལ།",
    "སེ་རུལ་ནི་གྱང་ས་སྣུམ་ལྡན་ཟེ་ཚྭའི་རྒྱུ་དེའི་ཁུ་བ་སེ་རྒོད་བར་ཤུན་གྱིས་གདུས་པའི་ཐང་གི་སྦྱོར་བས་བསལ།",
    "རུ་རྟ་རྒྱམ་ཚྭ་ཤིང་ཚྭ་གསུམ་མོ།",
    "ཡང་ན་རེ་རལ་དྲུག་ནི་རེ་རལ་བྲག་སྤོས་གུར་ཀུམ་ཨ་རུ་རྒྱམ་ཚྭ་ཐལ་ཚྭའོ།",
    "ཚྭ་ཐང་ནི་རྒྱ་ཚྭ་ཁ་རུ་ཚྭ་ཐལ་ཚྭ་དྲི་ཆུའི་ཐང་ངོ།",
    "ཕྱུགས་ལྷས་སམ་མཚེའུ་སྐྱོང་གི་ཁྲུ་གང་འོག་ས་བེའུ་ཞོ་འཐུང་གི་ལྕི་བ་ཆུ་སྦངས་ཏེ་བཙག་ཁུ་ལ་སོ་མ་རཱ་ཛ་བསྐོལ་བ་བཏང་།",
    "ནངས་པར་ར་ཁྲག་དྲོན་མོ་ཚུགས་ཚད་བཏང་བས་སྐྱུག་གོ་རྗེས་ལ་སེ་འབྲུ་ལྔ་པ་སྦྱར་རོ།",
    "གཉའ་རེངས་སེར་ཤའི་ཐང་བཏང་གཉའ་ཤས་བདུག་པ་ནི།",
    "གཉའ་བ་རེངས་ན་ཤ་མོ་སེར་ཤའི་ཐང་བཏང་།",
    "རྙེད་ན་གླང་གི་གཉའ་ཤ་ལ་བྱའོ།",
    "ཡན་ལག་རེངས་ན་གླ་རྩི་བཞི་པ་ནི་གླ་རྩི་བོང་ང་སྤང་སྤོས་ཛཱ་ཏི་དང་བུ་མོ་ལོ་བཅོ་ལྔ་ལོན་པའི་ཆུ་སྦྱར་བཏང་།",
    "རྐང་པའི་ལོང་མོ་མན་གྱི་རྒྱ་ཚིགས་དང་རུས་ཚིགས་རྣམས་ན་ན།",
    "ཕྱུགས་གང་རུང་གི་མཁྲིག་ལོང་ཡན་གྱི་རུས་པ་ལ་ནེ་སེག་ཅེས་བྱ་བ་དེའི་ཐང་བཏང་།",
    "གངས་ཆུ་ལ་ཅུ་གང་རེ་རལ་སེ་སྐྱེར་བར་ཤུན་སོ་མ་རཱ་ཛ་རྣམས་བསྲུངས་པའི་ཆུ་བཅག་བྱའོ།",
    "དྲན་མེད་དུ་འབོགས་སྨྱོས་འཕྱོས་པར་འགྱུར་སྲིད་པས་ན་རུས་ཐང་ཚོ་ཁུ་བུར་ཆང་བཏང་སྐུ་མཉེ་བྱའོ།",
    "དང་པོ་ནི་དེ་ནས་ཡང་ནས་ཉོན་ཅིག་གི་བར་རོ།",
    "ཞེས་སྨོས་ཏེ་མི་འཕྲོད་ད་པའི་དུག་གི་རྒྱུ་ནི་རྣམ་པ་གཉིས་ཏེ་རྫས་ཀྱི་ངོ་བོས་མི་འཕྲོད་པ་དང་།",
    "ངོ་བོ་མི་འཕྲོད་པ་དེ་དག་གི་ནུས་པ་རྒྱུ་འབྱུང་པའི་མཚན་ཉིད་དགྲ་གཤེད་དུ་གྱུར་པས་འཐབ་ནས་བརྟེན་པ་ཉེས་པ་གསུམ་འཁྲུག་སྟེ་རྟེན་ལུས་ལ་གནོད་པས་མི་འཕྲོད་པའོ།",
    "ཡང་ན་གོང་གི་ཁ་ཟས་མི་འཕྲོད་པ་རྣམས་མ་ཡིན་ཀྱང་།",
    "འཇུ་དཀའ་བ་མྱོང་བརླན་སྣུམ་པ་སོགས་གོང་གི་མ་ཞུ་བ་བཅོས་པར་བསྟན་པ་རྣམས་བསྟེན་པས།",
    "ཡང་ན་གཉེན་པོ་ཚད་བཅོག་གི་ཁ་འཛིན་གསུམ་ཞེས་པའི་གཉེན་པོ་ནི་བོང་ང་དཀར་དོམ་མཁྲིས་ཕྱ་ཚན།",
    "གསུམ་མོ།",
    "ཚད་བཅོག་ནི་ཙན་དན་ཏིག་ཏ་བྲག་ཞུན་གསུམ་མོ།",
    "ཁ་འཛིན་ནི་ཅུ་གང་གུར་ཀུམ་པི་པི་ལིང་གསུམ་མོ།",
    "སྦྱར་དུག་དང་ཆ་མཐུན་པས་གསོ་ཐབས་ཀྱང་ཐུན་མོང་དུ་འཕྲུལ་ཞིང་བཅོས་སོ།",
    "དེ་དག་གི་རྟགས།",
    "ཤ་རློན་དེ་ས་རློན་སྟེང་དུ་བཞག་སྟེ་བེམ་པ་བཙོས་པའི་དྲོན་མོ་རླངས་པ་སྲུབས་ནས་བམ་པ་དང་།",
    "ཤ་ལ་བཤན་པའི་ཁྲག་གིས་ཕོག་པ་རྣམས་ཀྱིས་རྐྱེན་ནོ།",
    "རྐྱེན་དེ་དག་ག་གིས་གིས་ཕོག་ཕོག་ནས་ཞག་བདུན་འདས་ཕན་ཆད་ནས་དུག་ཏུ་འགྱུར་བ་ཡིན་ནོ།",
    "རྒྱལ་མོ་འདལ་བར་འགྱུར་བ་ཡིན།",
    "རྐང་པ་གཏད་མི་ཚུགས་པ་ནི་རྐང་པ་གཏད་སར་མི་འགྲོ་བར་གོམ་པ་འཁྱོར་བའོ།",
    "སྣ་ཁྲིད་ནི་འགྲོན་ཐལ་གླ་རྩིའོ།",
    "མཚེ་སྐྱོང་ཁྲུ་གང་འོག་གི་ས་ནི་མཚེའུ་སྐྱོང་ཞེས་ཕྱུགས་ལྷས་ཀྱི་ཆུ་འཁྱིལ་བའི་ཁྲུ་གང་བརྐོས་པའི་གཏིང་སའོ།",
    "ཆུ་འགགས་ཀྱི་བོང་རྨིག་སྦྱོར་བ་ནི་བོང་རྫིག་རྩི་བཞུར་བ་ཆུ་སྦུར་ཉི་དགའ་སོ་བྱའི་སྒྲོ་ཐལ་སིངས་པོ་དྲོད་འཇམ་ལ་སྦྱར་བ་བཏང་ངོ།",
    "ཅེས་པ་འདི་དང་དུག་གི་མཚན་ཉིད་རྣམ་གྲངས་ནི་རྣ་བ་ལ་སོགས་པ་འདི་དག་དང་གོ་ལོག་ཅིང་མི་མཐུན་པས་འཇོམས་པར་ལྟའོ།",
    "དོན་དམ་པར་ནི་རང་གི་སེམས་སམ་སྤྲོས་བྲལ་གྱི་སྣང་རིག་གི་ཆ་ལ་གཟུང་འཛིན་དུ་འཁྲུལ་ནས་བདག་གཞན་དང་དངོས་འཛིན་གྱི་ཀུན་རྟོག་ལ།",
    "ཁྱིམ་བདག་ངས་ནང་གི་དུག་བཅོམ་པས་ཕྱིའི་དུག་གིས་གནོད་པར་མི་ནུས་སོ།",
    "ལྷ་མོ་ཨུ་མ་དང་ནོར་བུ་ཀོ་སྟི་བྷི་ཐོན་པ་ལྷ་རྣམས་ཀྱིས་སྤྱི་ནོར་བྱས།",
    "དུག་གི་གཟུགས་དེ་སྤྲ་ཡས་སུ་ཞིག་ཅིང་འཐོར་ཏེ་མི་གཡོ་མི་རྒྱུ་བ་བརྟན་པའི་དུག་རྣམས་དང་།",
    "དེ་ཡང་མི་རྒྱུ་བ་ནི་བཙན་དུག་གི་རིགས་རྣམས་དང་ཐང་ཕྲོམ་བསེ་ཤིང་རྟ་སྤུ་སོགས་བརྟན་པའི་དུག་མཐའ་དག་གོ།",
    "ཞེས་བགྲོས་ནས་ཚོགས་སུ་ཁྱབ་འཇུག་ཟིན་དུ་བཅུག་པ་ལས་ཁྱབ་འཇུག་གིས་བདུད་རྩི་ཁོ་རང་གིས་འཐུངས་ནས་མཐུ་ཆེ་བར་བསམས་ནས་འཐུང་རུང་ནམ་མཁར་བྲོས་པ་ལས།",
    "བོང་ང་རྐྱང་པའི་རྟགས་བཅོས་ཐང་ཕྲོམ་དཀར་ནག་གི་རྟགས་བཅོས།",
    "དེ་དག་གྲོགས་མེད་པ་རྐྱང་པར་པར་སོང་རྟགས།",
    "བསེ་ཤིང་རྟ་སྤུ་ཕྱི་ནང་གང་རེག་སྐྲངས།",
    "གླ་རྩི་མཚེ་དང་གོང་མོའི་བྲུན།",
    "བྱུག་པ་ཐེངས་རེས་ཟླ་རེས་ཐུབ།",
    "དེ་གཉིས་ནི་རེག་དུག་གཙོ་ཆེ་ཞིང་རྟགས་འདྲ་ཡང་ར་ཤ་ར་ཁྲག་དྲི་ཆུ་ནི་བསེ་ཤིང་འཇོམས་ལ་འབྲུ་མར་རྩི་མར་ཕག་ཚིལ་གྱིས་རྟ་སྤུ་འཇོམས་སོ།",
