    "བུད་མེད་དང་བྲལ་ཉོན་མོངས་ཀྱིས།",
    "སྐྱ་བསེང་བུ་ལྔ་དག་གི་ནི།",
    "ཆུང་མ་ལྔ་ལེན་བུ་མོ་སྟེ།",
    "བྱ་སླ་བྱ་དཀའ་དག་གི་ལམ།",
    "ལང་ཚོ་ཅན་བཞིན་དགའ་དང་གྲགས་པ་ཐོབ་པར་གྱུར།",
    "རྗེ་བོ་ཁྲོས་པའི་ཤིན་ཏུ་ལྕི་བའི་བཀའ་ལུང་དག་གིས་གཟི་བརྗིད་ཉམས་པར་བྱས་གྱུར་ཅིང་།",
    "རབ་བཟང་ལྗོན་ཤིང་གྲིབ་མ་དང་ལྡན་དྲ་མའི་དྲི་བོར་སོང་ལ་སྤྱོད་པས་གནས་པར་གྱིས།",
    "བདེ་ལ་ཆར་སྦྲིན་དག་གིས་རང་ཉིད་བྡེའམ་ཞེས་པའི་ཚིག་འདི་ཁྱེར་ནས་འཇུག་པ་བཞིན།",
    "ཅེས་པ་མཆོག་ཏུ་དགའ་བའི་གསང་བ་པ་ནི་དེ་ལས་ཡོངས་སུ་མི་ཤེས་གང་གིས་ནི་། འདོད་པའི་དོན་དུ་མཁས་དང་མི་མཁས་རྣམས་དང་སེམས་ལྡན་སེམས་མེད་རྣམས་ལ་ཞུ་བར་བྱེད།",
    "ཁྱོད་ནི་རིགས་མཆོག་དང་ལྡན་མཆོད་སྦྱིན་བརྒྱ་པའི་བློན་པོ་མཆོག་སྟེ་འདོད་འཇོའི་ངོ་བོ་ཉིད།",
    "ས་གསུམ་མཐའ་དག་རིག་ཅིང་བསྐལ་པར་འཇུག་པའི་ཆེ་བའི་ཆུ་འཛིན་ཉིད་དུ་བདག་གིས་ཤེས།",
    "ཀ་ཡེ་ཆུ་ལྡན་ཁྱོད་ནི་ཤིན་ཏུ་གདུངས་གྱུར་སྐབས་ཉིད་དེ་ཕྱིར་བདག་གི་དགའ་བ་ལ།",
    "གཏམ་གྱི་བདག་པོ་ཆེད་ཆེར་ཁྲོས་པས་འཁྱམས་ཤིང་བྲལ་བ་དག་གི་ཕྲིན་ནི་མཛད་དུ་གསོལ།",
    "ཕྱི་རོལ་སྐྱེད་མོས་མཆོག་གནས་འཕྲོག་བྱེད་གཙུག་གི་ཟླ་བའི་འོད་ཀྱིས་སྣང་བྱས་ཁང་བཟངས་ཅན།",
    "གསང་བའི་བདག་པོའི་བསྟི་གནས་ཆེན་པོ་ལྕང་ལོ་ཅན་ཞེས་བྱ་བའི་གནས་སུ་ཁྱོད་གཤེགས་མཛོད།",
    "བསམ་པ་དགའ་བར་གྱུར་ཏེ་ལེན་བུའི་རྩེ་མོ་རྒྱབ་ཏུ་བྱས་ནས་ལྟ་ཞིང་གུས་པར་བྱེད།",
    "དལ་བུ་དལ་བུས་བསྐྱོད་པའི་དྲི་བཞོན་དག་གིས་ཁྱོད་ལ་མཛེས་མཐུན་ཞབས་ཏོག་བྱེད་པ་བཞིན།",
    "མྱོས་པའི་ཙ་ཏ་ཀ་འྡིའང་ཁྱོད་ལ་སྙན་པའི་བསྟོད་པའི་བསྟོད་པ་གཡོན་ནས་སྒྲོགས་པ་དང་།",
    "བདག་གིས་མཛེས་མ་དེ་ཡང་ཉིན་ཞག་གྲངས་བཞིན་བདག་པོ་གཅིག་པུ་ཡིད་ལ་འདྲི་བར་ནི།",
    "གདོན་མི་ཟ་བར་མྱུར་དུ་གཤེགས་ཏེ་བདག་ནི་མ་ཤི་བ་ཉིད་ཁྱོད་ཀྱིས་བསྟན་པར་མཛོད།",
    "གང་ཞིག་ཁྱོད་ཀྱི་འབྲུག་སྒྲ་སྒྲོགས་པ་དེ་ནི་སྐལ་བཟང་རྣ་བས་ཐོས་བྱས་ནས།",
    "མཆོག་ཏུ་རྒྱས་པའི་མེ་ཏོག་དག་གིས་ས་གཞིའི་ཆེད་དུ་གདུགས་དག་བྱས་པར་གྱུར་པ་ཉིད།",
    "ཁྱོད་ནི་ནམ་མཁའ་དག་ལ་གཤེགས་ཚེ་དགའ་བའི་ཡིད་ཀྱིས་མཚོ་དང་གངས་ཅན་བར་ལ་ནི།",
    "ཆེ་བའི་རི་བོ་འདི་ནི་ཁྱོད་ཀྱི་དགའ་བའི་གྲོགས་བཟང་ཁྱོད་ལང་འཁྱུད་བ་སྔོན་འགྲོ་བའི།",
    "ཁྱོད་དང་གང་དེ་དུས་དུས་དག་ཏུ་ཡང་དག་མཇལ་འགྱུར་ཞེས་ནི་བྱས་ནས་ཁམས་བདེ་མཛོད་། ཀྭ་ཡེ་ཆུ་འཛིན་རེ་ཞིག་ཁྱོད་ནི་ལམ་ལ་བགྲོད་པའི་ཐབས་ཀྱིས་གཏམ་ནི་མཉན་པར་མཛོད།",
    "དེ་ཡི་རྗེས་སུ་བདག་གི་འཕྲིན་ནི་རྣ་བའི་བདེ་བ་སྐྱེད་ཁྱོད་རྣ་བར་གཟུང་བར་མཛོད།",
    "ནི་ཙུ་ལ་ནི་གསར་བས་གནས་འདི་ལས་ནི་ཁྱོད་ལངས་མཁའ་ལ་བྱང་དུ་གདོང་ཕྱོགས་མཛོད།",
    "རི་ཡི་རྩེ་མོ་ཕྲོགས་ནས་དྲི་བཞོན་འགྲོ་བའམ་ཆུ་འཛིན་ལངས་ནས་འགྲོ་བའི་ཅི་ཞེས་ཐེ་ཚོམ་དུ།",
    "གྱུར་ནས་གྲུབ་པའི་བུད་མེད་རྣམས་ཀྱིས་གྱེན་ཕྱོགས་བལྟས་ཏེ་འཇིགས་ཤིང་སྐྲག་པས་རྨོངས་བར་འགྱུར།",
    "ཁྱོད་སྐུ་མཆོག་ཏུ་མཛེས་པ་མཐིང་ནག་གང་གིས་ཀུན་དུ་ཁྱབ་པར་བྱེད་པ་ཐོབ་པར་འགྱུར།",
    "ཁྱོད་ནི་ཅུང་ཟད་ནུབ་ཏུ་བསྐྱོད་ཅིང་གནས་བྱ་འཕྲིན་ལ་སྨོན་གྱི་རོལ་དགའ་པ་ཡི།",
    "ཁྱོད་ཀྱི་ནགས་ནང་ཤིང་སྐམ་རྣམས་ནི་ཆར་གྱིས་བརླན་པར་བྱས་བཞིན་ལེགས་པར་མཛོད།",
    "ཀྭ་ཡེ་ཆུ་། འཛིན་ཁྱོད་ནི་ལམ་ལ་ངལ་ཚེ་སྣ་ཚོགས་བརྩེགས་པ་ཞེས་པའི་རི་བོ་ནི།",
    "ངོས་ལྡན་རྩེ་མོ་ཡངས་ལ་བསྡད་ནས་ཕན་ཚུན་མངོན་དུ་ཕྱོགས་པའི་བསྙུན་ནི་བྱེད་བཞིན་པས།",
    "ཁྱོད་ཀྱང་དེ་ཡི་སོ་ཀའི་མ་ནི་བདུད་རྩིས་ཞི་བྱེད་དེ་ཡང་ཕན་པའི་དངོས་པོའི་རྟེན་དུ་འགྱུར།",
    "ཁྱོད་ནི་གཡོ་མེད་རྩེ་མོར་གནས་ཚེ་ཨ་མྲའི་ནགས་ཀྱི་འབྲས་བུ་རྒྱས་པར་སྨིན་པ་ནི།",
    "འཆི་མེད་ཁྱོ་ཤུག་དག་ནི་ཡ་མཚན་ངེས་པ་ཐོབ་པའི་མིག་གིས་རབ་ཏུ་ལྟ་བར་བྱེད།",
    "དྲང་སྲོང་བུ་མོའི་ཆུ་བོ་འབིགས་བྱེད་རི་ཡི་ཞབས་ནི་རྩུབ་པའི་རྡོལ་འོག་ཏུ་འབབ་ལྡན་མ།",
    "སོ་གཉིས་ཡན་ལག་མཆོག་ལས་དཀར་མོ་ཚོན་གྱིས་ལེགས་བྲིས་བཞིན་དུ་ཁྱོད་ཀྱིས་མཐོང་བར་འགྱུར།",
    "ཁྱོད་ཀྱིས་ཐོག་མར་ཆར་པ་སྒྱུག་བྱ་དེ་ཡི་ཆུ་ནི་འཐུངས་ནས་བགྲོད་པར་བྱ་སྟེ་ཕྱིན་ནས་ནི།",
    "ནགས་ཀྱི་གླང་པོ་མྱོས་པའི་ཏིག་ཏའི་རོ་དང་འཛམ་བུའི་ཤིང་གི་ཆུ་དེའང་མྱུར་དུ་འགེངས།",
    "ཆུ་འཛིན་དལ་བུས་ཆར་བསྐྲུན་ཁྱོད་ལ་སཱ་རིགས་རྣམས་ནི་སྟོན་པར་བྱེད་པར་འགྱུར།",
    "ཁྱོད་ནི་ལེགས་པར་འོངས་ཆེ་སྙན་པའི་སྒྲ་བསྒྲགས་དུས་ན་གྲུབ་པ་རྣམས་ཀྱིས་མཆོད་བྱེད་ཅིང་།",
    "ཀྭ་ཡེ་གྲོགས་པོ་ཁྱོད་ནི་བདག་གི་དགའ་བའི་དོན་ལ་མྱུར་དུ་འགྲོ་སྙམ་ཡོད་ན་ཡང་།",
    "ཀ་ཀུ་བྷ་ཡི་དྲི་ལྡན་རི་བོ་རི་བོ་རྣམས་ལ་ཡུན་རིང་ཐོགས་པར་བདག་གིས་ཤེས།",
    "དེ་སླད་ཁྱོད་ནི་ཤིན་ཏུ་ཤིན་ཏུ་མྱུར་བ་འགྲོ་བར་འགྱུར་བ་དག་ཀྱང་ཇི་ལྟར་ཡིན།",
    "ཁྱོད་འོངས་ཚེ་ན་ངང་པ་རྣམས་ནི་དེ་ཉིད་ཅུང་ཟད་གནས་ནས་འགྲོ་ཞིང་འབྲས་བུ་ནི།",
    "དེ་ཡི་བྱང་ཕྱོགས་གཞི་ལ་བི་དི་ཤ་ཞེས་མཆོད་ཆ་རྒྱལ་པོའི་ཁབ་ཏུ་མྱུར་སོང་ནས།",
    "དེར་ནི་ཁྱོད་ཀྱིས་ཤིན་ཏུ་ཆེ་བའི་འབྲས་བུ་ཐོབ་མཆོག་གོ་འཕང་འཕྲལ་ལ་ཐོབ་འགྱུར་ཞིང་།",
    "གཡོ་བའི་རླབས་ཕྲེང་གདོང་ཁ་སྨིན་མ་གཡོ་བཞིན་པ་འདྲའི་མཚོ་དེའང་སྐལ་བཟང་ཁྱོད་འཐུང་འགྱུར།",
    "གང་ཞིག་ནི་ཙ་ཞེས་གྲགས་རི་བོར་ཁྱོད་འོངས་ཐོབ་ལས་དེར་ནི་ངལ་བསོའི་ཆེད་དུ་གནས།",
    "རྡོ་ཡི་ཕྲག་ཕྲུག་རྣམས་ཀྱི་མཆོག་ཏུ་མཛེས་བའི་ལང་ཚོམ་རྣམས་སྨྲ་རུ་འཇུག་པ་བཞིན།",
    "ཆུ་སྐྱེས་ཐོག་མའི་གདོང་གི་འགྲམ་པའི་རྡུལ་ཐིགས་སེར་ལ་རྣ་བའི་ཨུཏྤལ་ངལ་བ་དང་།",
    "ཡང་ནི་བྱང་གི་ཕྱོགས་སུ་བགྲོད་ཅིང་གང་ཞིག་ཁྱེད་ནི་འཁྱོག་པོའི་ལམ་ལ་ཞུགས་པའི་ཚེ།",
    "དེ་ན་གྲོང་གི་དགའ་མ་རྣམས་ཀྱི་རོལ་སྒེག་ཟུར་མིག་གློག་གི་། ཐག་པ་གཡོ་བ་ནི།",
    "སྐྱོང་བྱེད་མིག་གིས་གལ་ཏེ་ཁྱོད་ནི་མ་མཐོང་འབྲས་བུ་མེད་ཅིང་བསླུས་པ་ཉིད་དུ་འང་འགྱུར།",
    "རོ་མཆོག་དང་ལྡན་ཆུ་བོའི་ན་ཆུང་བིར་བིནྡྷ་ནི་ཁྱོད་ནི་ལམ་ན་མངོན་བཞུགས་ནས།",
    "ཀྭ་ཡེ་སྐལ་བཟང་ཁྱོད་དང་བྲལ་བར་གནས་པས་ལུས་ཀྱི་གནས་སྐབས་འདི་འདྲར་འགྱུར།",
    "གང་གི་ཆུང་མ་སྤངས་ནས་ཆེ་བའི་གནས་སྐབས་མཛད་དམ་ཁྱོད་མཁྱེན་དེ་ནི་རྗོད་པར་བྱེད།",
    "ཨ་ཝནྟའི་ཡུལ་ཐོག་ན་ཨུ་ད་ཡ་ནའི་གཏམ་ནི་གྲོང་གི་རྒན་མོས་ཤེས་པ་ཡོད།",
    "ཆུ་ཐིགས་ཀྱིས་བྲན་དྲི་བཞོན་བུད་མེད་ཆགས་གཟིར་གདུང་བ་ཕྲོག་བྱེད་ལུས་ཀྱི་རྗེས་མཐུན་པ།",
    "འཐོན་པས་ཁྱོད་ལུས་ཆེར་འགྱུར་ཁྱིམ་གྱི་གཅུག་པུད་ཅན་ནི་དགའ་བས་གཉེན་མཐོང་གར་གྱིས་ནི།",
    "མཆོད་འབུལ་ཆུ་སྐྱེས་དྲི་བཟངས་ལྡན་པ་བུད་མེད་རོལ་སྒེག་ལྡན་པའི་རྐང་པའི་ཚོན་རྣམས་ཀྱིས།",
    "ཡིད་འོང་དྲི་ལྡན་ཆུ་ལ་ལང་ཚོ་མ་རྣམས་རོལ་སྒེག་ཁྲུས་ནི་བྱེད་བའི་དྲི་ལྡང་ཞིང་།",
    "ཉིན་མོར་བྱེད་པ་འདྲེན་བྱེད་ཡུལ་དུ་འོངས་པར་གྱུར་གྱི་བར་དུ་ཁྱོད་ནི་གནས་པར་མཛོད།",
    "ཁྱོད་ཀྱིས་འབྲུག་དབྱངས་བསྒྲགས་ཚེ་མ་ཚང་མེད་པའི་འབྲས་བུ་ཐོབ་པས་ཀུན་གྱི་དོན་ཡང་བྱེད།",
    "ཚོགས་ཀྱི་མཛེས་མ་སེན་རྗེས་གསར་པས་གདུངས་ལ་ཁྱོད་ལས་ཆར་ཐིགས་ཐོབ་ན་ཚིམ་བྱེད་པ།",
    "ཁྱོད་འོངས་སྔ་དྲོའི་ཐུན་མཚམས་ཉི་གཞོན་དམར་བའི་འོད་ཀྱིས་དམར་བའི་ཆུ་སྐྱེས་འཛིན་བྱེད་ཅིང་། རྒྱབ་ནས་མཐོ་བའི་ལག་པ་ཟླུམ་པོའི་ནགས་ཀྱི་ཤིང་ཆེན་དག་གིས་བརྒྱངས་ནས་འཛིན་ཅིང་གནས།",
    "ཞི་བའི་ཆར་རྒྱུན་འབབ་ཚེ་རི་ཡི་སྲས་མོས་གཡོ་མེད་མིག་གིས་གུས་པས་ལྟ་བར་བྱེད།",
    "དེས་ན་བདག་པོའི་གནས་སུ་མཆོག་གི་བཙུན་མོ་རྣམས་ནི་རབ་དགས་སྒེག་པར་བྱེད་པ་ན།",
    "མཚན་མོའི་མུན་པ་སྟུག་པོ་རྣམས་ཀྱིས་མི་ཡི་བདག་པོའི་ལམ་གྱི་སྣང་བ་འགོག་བྱེད་པས།",
    "ཁྱོད་ཀྱི་གློག་འོད་གསེར་མཚུངས་འོད་ཀྱི་སྣང་བས་ས་གཞིའི་ལམ་ནི་ཀུན་ནས་བསྟན་པར་མཛོད།",
    "དེ་རྣམས་ཀྱིས་ནི་ཁང་བཟངས་ཕུག་ནོར་ཉལ་ས་སྟེང་གི་རྒྱ་ཕུབས་འགའ་ཞིག་དག་ཏུ་ནི།",
    "ཡུན་རིང་འོངས་ལས་དུབ་པའི་རང་གི་དགའ་མ་གློག་མའི་དོན་དུ་མཚན་མོ་གནས་བྱས་ནས།",
    "ཉི་མ་མཐོང་ཚེ་ཁྱོད་ནི་སླར་ཡང་ལྷག་མའི་ལམ་དག་ཤིན་ཏུ་མགྱོགས་པས་བགྲོད་པར་བྱ།",
    "དེ་ཡི་དུས་སུ་ཉིན་མོར་བྱེད་པས་ལམ་ནི་དོར་ནས་མྱུར་དུ་འགྲོ་བར་བྱ།",
    "འོད་ཟེར་རབ་ཏུ་འཕྲོ་བ་བསྒྲགས་ན་ཁྲོ་བ་ཆུང་བ་མིན་པ་ཁྱོད་ལ་བྱེད་པར་འགྱུར།",
    "མཚན་མོ་བདག་པོ་སོང་བའི་བུད་མེད་མིག་གི་མཆི་མ་སེལ་ལ་བདག་པོ་འོང་བ་བཞིན།",
    "པདྨོའི་ཡུམ་གྱི་ཆུ་སྐྱེས་གདོང་གི་མིག་ཆུ་དེ་ཡང་རབ་ཏུ་སེལ་བ་བྱེད་པར་འགྱུར།",
    "རབ་དུ་དང་བའི་སེམས་བཞིན་ཤིན་ཏུ་ཟབ་མོ་དང་ལྡན་མཚོ་ཡི་ཆུ་ཡི་ཆུ་ཡི་ནང་དུ་ནི།",
    "ཁྱོད་ཀྱི་གཟུགས་བརྙན་ཡང་ནི་རང་བཞིན་སྐལ་བ་བཟང་པོ་བདག་ཉིད་འཆར་བ་ཐོབ་པར་འགྱུར།",
    "དེ་སླད་དེ་ཡི་ཀུ་མུ་ཏ་ནི་དཀར་པོ་རྣམས་ཀྱིས་ཁྱོད་ལ་བཀུར་སྟི་བསྙེན་བཀུར་བྱེད།",
    "མ་འཕྲོག་ཅེས་ནི་ཤིང་ཆེན་ཡལ་གའི་ལག་པ་དག་གིས་དབུས་སུ་ཅུང་ཟད་འཛིན་པ་བཞིན།",
    "ཁྱོད་ཀྱིས་ཆར་ཆེན་ཕབ་པས་ནོར་འཛིན་མ་ཡི་དྲི་དང་རླངས་པ་གཙང་མ་ཚོགས་པ་ནི།",
    "གཙུག་ན་ཟླ་བ་རིན་ཆེན་མང་གི་དམག་ཚོགས་བསྲུང་པའི་དོན་དུ་བསྐོས་པ་དེ་ནི་གནས།"
  ]
}