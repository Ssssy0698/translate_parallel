    "བསྐལ་བཟང་རྣམ་འདྲེན་རྒྱལ་བའི་ཉི་མ་སྟོང་ཕྲག་བྱོན་དང་འབྱོན་འགྱུར་གྱི་རྣམ་པར་ཚར་དུ་དངར་བའི་དབུས་ན་པདྨ་དཀར་པོ་ལྟ་བུའི་བསྔགས་བརྗོད་རྒྱ་མཚོའི་ལྷ་མོ་ཕང་འགྲོའི་ཟློས་གར་ལ་རྩེན་པའི་དབྱངས་ཀྱིས་སྲིད་པའི་ཁོངས་ན་བཀྲ་ཤིས་དང་དགེ་ལེགས་ཅི་ཡང་བྱེད་པ།",
    "སྨྲ་བའི་ཁྱུ་མཆོག་ཐམས་ཅད་མཁྱེན་པ་མཉམ་མེད་ཟས་གཙང་གི་སྲས་པོ་དེ་ཉིད་ཀྱིས།",
    "མཁས་ཤིང་གྲུབ་བརྙེས་གསེར་ཏོག་ནོ་མོན་ཧན་སོགས་སྐྱེས་བུ་དམ་པ་ད་ལྟ་དངོས་སུ་ཞལ་བཞུགས་པ་དང་མི་བཞུགས་པ་ཐམས་ཅད་ཀྱི་མཛད་འཕྲིན་རྒྱས་ཤིང་ཐུགས་དགོངས་རྫོགས་པར་འགྱུར་བ།",
    "ར་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་ཆེན་པོར་གདན་དྲངས་ཏེ་ཇོ་བོ་ཡིད་བཞིན་ནོར་བུའི་མཚན་དཔེ་མེ་ཏོག་གི་ལོ་འདབ་ཡོངས་སུ་རྫོགས་པར་གསེར་ཞུན་འཁྱིལ་བའི་ཆབ་སྒྲོན་ཞིང་།",
    "ཞལ་ཟས་རོལ་མོ་སོགས་མཆོད་སྤྲིན་སྟོང་ཚར་ཤིན་ཏུ་རྒྱས་པ་དང་འབྲེལ།",
    "འདུས་པ་རྒྱ་མཚོར་མང་ཇ་ཉིན་འཁྱོངས་གཅིག་གི་བསྙེན་བསྐུར་ཞུས་ཤིང་།",
    "གོང་དུ་གསོལ་བ་བཏབ་པའི་རེ་འབྲས་སྤྱི་དང་།",
    "སྐུ་འབུམ་བྱམས་པ་ལོ་ཡེ་ནས་ལྷ་ལྡན་ར་ས་འཕྲུལ་སྣང་གི་གཙུག་ལག་ཁང་དུ་སྟོང་མཆོད་རྒྱས་པ་འབུལ་སྐབས་སྐྱབས་ཐོར་གནང་བའོ།",
    "ཡི་གེ་དེ་གྲགས་པ་ཁོ་རང་གིས་འཁྱེར་སྙམ་ནས་ད་བར་ཉར་ཀྱང་འོང་ཐབས་མ་འགྲིགས་པས་འདི་ལོ་རྟ་ལ་བསྐུར།",
    "ཡི་གེར་བལྟས་པ་ན་གྲྭ་ཚང་གི་གནས་ཚུལ་ལྷང་ངེར་ཤར་བའི་རྐྱེན་གྱིས་རེ་ཞིག་སྨྲ་བ་མི་ཐོན་པ་ལྟ་བུར་སོང་།",
    "ཨ་ཁུ་ཡོན་ཏན་དྲན་རྒྱ་ཆེ་ཞིང་གྲྭ་ཚང་ལ་ཤ་ཚ་བས་ཁོ་རང་མ་གཤེགས་གོང་དུ་ལོ་རེ་བཞིན་གྲྭ་ཚང་གཞུང་དང་།",
    "ཁོང་གི་སྒེར་ཡིག་རེ་མ་ཆད་པར་ཡོང་གི་ཡོད།",
    "བླུན་པོ་འདི་ཕྱི་གཉིས་མེད་ཀྱི་ལས་ངན་ལ་ཞུགས་པ་དག་གིས་ཅི་འཚལ།",
    "རང་རེར་ཡིག་བསྐུར་ཚུལ་བཞིན་བྱེད་ནུས་པ་མི་འདུག་པས་ལན་པར་ཡང་སེམས།",
    "དེ་ལྟར་ཐབས་གང་གིས་འགྱུར་སྙམ་དུ་དཔྱོད་པ་ལ་རྟག་པར་ཞུགས་བཞིན་པ་ཡིན།",
    "དེ་ལྟ་མོད་ཀྱི་རང་རེའི་གྲ་ཁོངས་ན་རང་ལ་ཡོན་ཏན་ཏིལ་འབྲུ་ཙམ་ཡང་མེད་རུང་ཡོད་པའི་གསོབ་བྱས།",
    "རང་གི་དགེ་རྩ་བཅད།",
    "བདག་འདྲ་ཡོད་ཏན་ཆུང་ཞིང་སྐྱོན་གྱི་གོང་བུ་ཤ་རྗེན་ཟ་བའི་སྲིན་པོ་ངུར་སྨྲིག་འཆང་བའི་ཟོལ་ལ་བརྟེན་པ་ཞིག་གིས་ཇི་ལྟར་ཕན་སྙམ་དུ་ཡི་མུག་ཀྱང་སྐྱེའོ།",
    "གཞི་གསུམ་གྱི་མཛུབ་ཁྲིད་རེ་ཨེ་ཐུབ་ལྟོས།",
    "འདི་རྣམས་ལ་འདུན་བརྩོན་ཆིག་སྒྲིལ་རེ་ཞུ།",
    "དེ་ན་ཡིག་བསྐུར་དང་དག་ཆ་ཤེས་མཁན་མི་འདུག་པས་མ་མཐའ་དེ་ཙམ་རེ་སྦྱང་རྒྱུ་ཐུགས་ཀྱི་དཔལ་བེར་སྣོམས།",
    "གཞན་དོན་འགོག་པའི་བསམ་སྦྱོར་དུ་མས་དེ་རིང་ཞུགས་པའི་གསར་བུ་ཡན་ཆད་རང་རང་གི་ཕྱོགས་སུ་ཁ་བཀྲིས་ནས་ཆགས་སྡང་གི་ས་བོན་རྒྱུད་ལ་བཏབ།",
    "ཕྲག་དོག་འཁྲུག་རྩོད་རང་རྒྱལ་གཞན་ཕམ་འབའ་ཞིག་གི་ཐབས་ཚུལ་རྟག་ཏུ་སེམས།",
    "རང་གི་དེ་དུག་ལྟར་གནོད་ནའང་སྒྲུབ་གང་ཐུབ།",
    "མི་ཤེས་པའི་བྱ་བ་རེ་རེ་གཉིས་གཉིས་ལམ་དུ་སོང་བ་ལ་ངོ་མཚར་ཅི་ཡང་མེད་དེ།",
    "སྲིན་བུ་དག་གིས་ཟོས་པའི་རྗེས།",
    "གཞོན་པ་ལ་བུ་ལྟ་བུའི་བཀུར་སྟི་ཡིད་འཇོ་བརྩེ་སེམས་ཀྱིས་མཐུན་པར་འགྲོགས་ཏེ་བསླབ་པ་རྒན་གཞོན་གྱི་བརྩི་འཇོག་དུས་གོའི་ཐུར་གྲིབ་སོར་གང་ཡན་ཆད་ཀྱང་ཆུད་ཟོས་སུ་མ་སོང་བར་བྱས་ན།",
    "ཁྱོད།",
    "ཕུར་གྱི་སྒྲ་བཞི་པོ་འདིར་བརྟགས་ཏེ་སྤངས་ནས་སུམ་བརྒྱ་པར་གསུངས་པའི་གུས་ཚིག་གི་བརྗོད་ཚུལ་རྣམས་ཀྱང་ཉམས་བཞེས་མཛད་འོས།",
    "གྱོང་དང་ཕམ་ཁ་རང་གིས་ཁུར།",
    "ཆགས་སྡང་གི་དགྲ་འདུལ་གཉེན་སྐྱོང་དུད་འགྲོས་ཀྱང་ཤེས།",
    "ཁྱོད་ཨོ་འདི་མོ་ཡེད་ཚུའུ་ཆི་ཨ་ཡོད།",
    "ཁག་མེད་ཀི་ཁུར་ཚོས་འདི་ཡེད་ན་ངེད་ཚོས་འདི་ཡེད།",
    "དགེ་སྦྱོང་གི་ཚུལ་ཉམས་པར་བྱེད་པའི་བདུད་ཀྱི་སྐད་ཆ་རེད།",
    "རང་གི་ལས་རེད།",
    "རང་གི་སྡོམ་པ་བསྲུངས་པ་རེད།",
    "ཉོན་མོངས་གདུང་བའི་དཀའ་ཐུབ་ཀུན་གྱི་ཕུལ།",
    "ཞེས་གསུངས་པ་རེད།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་ཀྱིས་བདག་རྐྱེན་བྱས་པའི་གསུང་ལ་ཐེ་ཚོམ་ཟོས་ནས་རང་གི་བློ་ངན་རྨོངས་པའི་སྣང་ཚུལ་ལ་ཡིད་ཆེས་པ་ནི།",
    "དེ་ལྟར་ཐུབ་པ་བདག་གི་བསྟན་པ་ནི།",
    "རབ་བྱུང་གི་བརྗེ་བ་གསུམ་ལ་གནས་པའི་དགོས་དོན་ཁྱིམ་པའི་སྤྱོད་ཚུལ་ལས་ཁྱད་པར་དུ་འཕགས་པ་ཞིག་ངེས་པར་དགོས།",
    "ཁྱད་པར་དྲང་ངེས་ཀྱི་རྣམ་གཞག་ཡིད་ངོར་ཁྲིག་གེར་བཀྲ་བའི་མཁས་པ་འབའ་ཞིག་གི་སྤྱོད་ཡུལ་ཡིན་པས་བླུན་པོའི་ཁ་ཆུ་འཐུངས་ན་མི་ལེགས་ཏེ།",
    "ལམ་མཆོག་གཉིས་ཀར་དགོས་པའི་ཐུན་མོང་ལམ།",
    "ལམ་ཐུན་མོང་པ་དོར་ན་ནི།",
    "ཞེས་གསུངས་པ་ལོས་ཤེས་མོད།",
    "གྲྭ་ཚང་ན་རེ་གཉིས་མ་གཏོགས་ངེད་ཀྱིས་ཞུས་པ་ལ་མི་གསན་མཁན་མེད་སྙམ་ནས་ཕན་པའི་གྲོས་འདེབས་ཁ་ཞེ་མེད་པར་གསོལ་བ་ལགས།",
    "མང་པོས་གཟིགས་བདེའི་ཕྱིར་ཡིག་དཀར་བྲིས།",
    "ཞུ་ཡིག་ལ་སྤྱན་རས་གཡོ་བའི་རྟེན་མཚོན་ལྷ་རེག་དང་།",
    "མ་ཁྱབ་ཀུན་རྫོབ་སྐྱོ་བ་ཅན་ཞིག་གིས་དབྱངས་ཀྱི་ཡན་ལག་བྱེ་བ་ཁྲི་ཕྲག་ཏུ་སྤྲོས་ཀྱང་སྐྲའི་རྩེ་མོ་བརྒྱ་སྟོང་དུ་གསིལ་བའི་ཆ་ཤས་ཙམ་ཡང་བརྗོད་པར་ག་ལ་ནུས།",
    "རང་རེའི་ལྗོངས་འདིར་མཚན་དཔེའི་དཀྱིལ་འཁོར་མཛེས་པར་བལྟམས་ཤིང་།",
    "ཁྱད་པར་རྡོ་སྦིས་གསེར་ལྡན་འཛིན་མའི་ཁྱོན་འདིར་འཁོད་པའི་འགྲོ་བ་རྣམས་ཀ་རུ་ཎི་ཀའི་གྲིབ་མར་ཅི་ཡང་བསྲེལ་ཏེ་སྨིན་གྲོལ་གདམས་པའི་བདུད་རྩིས་ཚིམ་པར་བྱ་བའི་ཕྱིར་སྔ་མའི་རིགས་རུས་ཕུན་སུམ་ཚོགས་པར་མཐོང་གྲོལ་མཚན་དཔེའི་ཚོམ་བུར་ཤར་བ་ནི།",
    "བློ་གྲོས་ཆེན་པོས་ཤེས་བྱའི་དེ་ཉིད་གཟིགས།",
    "རྗེས་འཛིན་ཕ་མཐའ་མི་མངོན་སྤྱན་རས་གཟིགས།",
    "བརྩེ་བ་འཕགས་པའི་མཆོག་གྱུར་སྤྱན་རས་གཟིགས།",
    "ཁྱོད་གསུང་ཉན་ཅིང་སྒོ་གསུམ་བྱ་བ་ཀུན།",
    "ཁྱོད་མཉེས་འབའ་ཞིག་སྒྲུབ་པར་བྱིན་གྱིས་རློབས།",
    "མུ་མེད་གློག་གི་བློ་ཡིས་འདི་སྐད།",
    "མོ་མས་ཕྲེང་རྡོག་བརྩིས་བཞིན་ཞིབ་བཅད།",
    "མ་སྦྱངས་རྨོངས་པ་ལྟ་ཅི་སྨོས་མོད།",
    "མ་བྱིན་ལེན་འདི་ངོ་རེ་ཚ་ཨང་།",
    "མ་ནིང་ཕོ་མིན་མོ་མིན་མང་ངོ།",
    "མཚོ་བྱུང་དགྱེས་པའི་ལང་ཚོར་གསོལ་བ་འདེབས།",
    "དད་ལྡན་སྒོ་མེ་སྔགས་འཆང་མགོན་པོ་སྐྱབས་ཀྱི་འདོད་མོས་བཞིན་ལྷ་རམས་པ་ཤེས་རབ་རྒྱ་མཚོས་སྦྱར་བའོ། ། འཛམ་གླིང་ཡོངས་ལ་བཀའ་ཡི་ལུང་འབེབས་ཤིང་།",
    "བཞི་བརྒྱ་རེ་བདུན་ཁྲི་ལོའི་ཆེ་བ་ཅན།",
    "དགྲ་འགོག་དྲག་ཤུལ་སྟོང་གི་ཟིལ་འབར་ཞིང་།",
    "དེང་གི་སེང་ཆེན་གཡུལ་ལས་རྒྱལ་བའི་ཉམས།",
    "གནམ་གྱི་གཟའ་སྐར་ཞིབ་མོར་ལྟ་བའི་ལས།",
    "སྣ་ཐག་རང་གི་མགོ་ན་ཡོད་དམ།",
    "དལ་དུས་ཕྱག་བསྐོར་འགའ་རེ་ཡོད་དམ།",
    "གཅིག་ན་རང་རེ་མཇལ་ཡང་སྲིད་དོ།",
    "རྔ་མོ་སྐེ་རིང་འགྲོ་འདུག་ཨེ་རྒོད།",
    "ཧ་ཡའི་སྐད་ཀྱི་འགྱུར་བ་རེ་རེར་ཡང་།",
    "ཁྱད་པར་རྒྱུ་སྦྱོར་མཆོག་གི་སྤྲུལ་པའི་སྐུ།",
    "ཁོ་རང་ལས་མཇུག་མ་ཟིན་པར་གཤེགས་སོང་བ་དང་།",
    "མ་སྐྱེ་རྒུའི་དཔུང་གཉེན་སྤྱན་རས་གཟིགས།",
    "འཛིན་མའི་ཁྱོན་འདི་ན་མི་སྣང་མཛོད།",
    "བདག་སྨོན་པའི་ཚིག་གི་འབྲུ་རེར་ཡང་།",
    "དྲང་སྲོང་གི་མཐུན་འགྱུར་མཛད་པར་ཞུ།",
    "མཚོ་སྔོན་པ་ཞིག་གིས་བླངས་པའི་གླུ།",
    "ལོའུ་ཅུན་གྲུབ་པའི་སྐྱེས་མཆོག་གི་མཛད་རྗེས་བྱེ་བས་གཏམས་པ།",
    "ཤ་བའི་སྟེང་ན་རང་གི་ལས་རྟགས་སུ།",
    "རྣམ་དཔྱོད་མཆོག་གི་སྐྱེས་བུ་ལ།",
    "སྤྱན་རས་གཟིགས་ཀྱི་བརྩེ་བའི་བསིལ།",
    "རྩལ་ཆེན་གཤོག་ཡངས་མཁའ་ལྡིང་གིས།",
    "བཀྲང་ཐེ་ཤན་སིན་ལ་གནང་བའོ། ། མོ་ཀྲུའུ་ཞིར།",
    "གསེར་གྱི་ལྷུན་པོ་ཁྱོད་ལ་བལྟ་བའི་ཕྱིར།",
    "ཉིན་རེ་བཞིན་དུ་རྒྱུག་པའི་ངལ་བ་བསྟེན།",
    "མི་སྡུག་སྲིན་བུ་དག་གི་མཆུ་འཕྱང་བ།",
    "ཨེ་མ་ད་ནི་རིལ་མོའི་འཛམ་གླིང་ནས།",
    "ཇེ་ཧྥང་མཆོག་གི་འོད་དམར་འཕྱུར་བའི་ཟིལ།",
    "མི་མཐུན་ཉིན་ལོང་མིག་གིས་བཟོད་དཀའ་བ།",
    "སྐྱེ་རྒུ་ཡོངས་ཀྱི་མགྲིན་པའི་རོལ་མོར་ཁྲོལ། ། ཀྲུའུ་ཙུང་ཟི་ལེན་ལ།",
    "ཕ་རོལ་རྣམ་གནོན་དྲག་རྩལ་ཁྱོད་ཉིད་ལ།",
    "འབར་བའི་གྲགས་སྙན་གཡུ་འབྲུག་སྟོང་གི་སྐད།",
    "པཎ་ཆེན་པན་སི་ཁྲུའུའི་ཅིས་ཁྲུའུ་ཀྲང་གིས་ཞུས་པ་ལྟར་གནང་བའོ། ། མཐུན་ལམ་ཆེན་པོའི་མེ་སྦར་ཏེ།",
    "རང་གི་རྒྱལ་ཁབ་གསེར་གྱི་ལྷུན་པོར་འཕགས།",
    "འགྲོ་འོང་བཟའ་བཏུང་གང་གི་སྐབས་སུ་ཡང་།",
    "རྒན་པོ་བདག་གི་བློ་ཡང་དེ་ཁོ་ན།",
    "ཀྱི་ཧུད་བླུན་པོའི་རིས་གཅོད་མཚང་རེ་ཆེ།",
    "ཧ་ཅང་ཐལ་བའི་སྐྱོན་གྱིས་ནོངས་པ་ཀུན།",
    "གཞན་ཕན་འགྲན་མེད་མི་ཡི་ཁྱུ་མཆོག་གིས།",
    "རང་དོན་སེན་མོའི་རྡུལ་ཡང་མི་སེམས་པར།",
    "གཞུང་ལ་ཤ་ཚའི་གློག་གི་སྐུད་པ་འཆང་།",
    "འཁྱོག་སྤྱོད་ཕྲ་ལ་མཛངས་པས་གཞན་གྱི་མགོ།",
    "མ་རབས་དཔུང་ལ་བསམ་ན་ཡི་རེ་མུག།",
    "རང་གི་ཁོང་ལ་དུག་ཆུའི་རྒྱུན་བསྲེལ་ནས།",
    "གཞན་ལ་སྨྲ་བའི་རྩེ་མོ་སྟོང་འགྲིམ་པ།",
    "དེ་དག་ཞིབ་མོའི་བློ་ཡིས་བག་ཡོད་བྱོས།",
    "ཨུ་དུམ་ཝ་རར་རེ་བ་ཨེ་མ་ཧོ།",
    "ངག་གི་དཔལ་མོ་བཞད་པའི་ལམ་ན་རྒྱུ།",
    "ནང་དོན་ལུང་གི་མཛའ་གཉེན་དུང་རིའི་སྤོར།",
    "རྡོ་རྗེ་ཧུང་གི་པོ་ཀར་བདེ།",
    "ད་རེས་གནས་ཚུལ་མེ་ཏོག་བཀྲ།",
    "འདིའི་མན་མ་རྙེད། ། འཛམ་གླིང་གནམ་སའི་ཁྱོན་ཀུན་འགེབས་པའི་ཟིལ།",
    "དཔལ་དཀྱིལ་མི་སེར་རྒྱལ་ཁབ་ནོར་འཛིན་མཛེས་རྒྱན་དབུ་བརྙེས་པའི་དུས་དྲན་བླ་ན་མི་མངའི་རྟེན་འབྱུང་གི་དངོས་པོར་༧པཎ་ཆེན་ཨེརྟི་ནི་ཞེས་འབོད་པས་ཕུལ།",
    "ཉེས་སྤོང་རི་མོའི་རོལ་བ་མི་དགོས་སོ།",
    "ཚེར་མར་གཟིགས་ན་ཇི་དགར་མཛད་པའི་རིགས།",
    "བྱིས་པ་འདྲིད་པའི་འཕུར་ལྡིང་དོན་རེ་ཆུང་།",
    "ཕྱག་གི་གེ་སར་སོན་པའི་དེ་མ་ཐག།",
    "ཁ་སྤུ་ཚུར་ལ་ཚིག་པའི་དཔེ་རུ་སོང་།",
    "དོན་གྱི་འགངས་དམན་ཚིག་གི་སྒྲོས་ཀྱང་ཞན།",
    "རང་རེའི་རིགས་བརྒྱར་དཔེ་ཀློག་ཙམ་ཡང་མེད།",
    "རང་གི་མགོ་ལ་བརྒྱ་སྟོང་འགྱུར་དུ་འབབ།",
    "སྤྲུལ་པའི་སྐུ་ལ་ཀུ་རེའི་རྣམ་པར་སྤྲོས།",
    "ཀུན་མཁྱེན་བུ་ཡིས་གསུངས་ལ་ཐལ་མོ་སྦྱོར།",
    "སྤྱིར་མ་རྟོགས་ལོག་རྟོག་གི་སྐྱོན་ཚབས་ཧ་ཅང་ཐལ་བ་ལ་བསྲེགས་བཅད་བརྡར་གསུམ་དང་མཚུངས་པའི་དགག་སྒྲུབ་རྣམ་དག་བགྱིད་པ་རྒྱལ་བའི་དགོངས་པར་གནས་མོད།",
    "མ་ཚུགས་མཆོག་གི་གྲགས་པ་ད་དུང་འབར།",
    "རང་གི་རིག་པ་རང་རྩལ་ལྷང་ངེ་བར།",
    "མང་ཐོས་མིང་ནི་གསར་བར་མི་ནུས་མོད།",
    "ཁྱོད་ནི་བཙུན་ལ་ཡིད་ཀྱི་བཟོ་མཛངས་པས།",
    "བསྟོད་པའི་ཉམས་ཀྱི་རི་མོ་བསྲིངས་པ་ནི།",
    "ཟོལ་ལ་བརྟེན་པ་ཡིན་ཡང་རང་གི་རྒྱན།",
    "རང་གི་ལུགས་ཀྱང་གཙང་མར་མ་ཆོད་པས།",
    "ཉེ་ལམ་ཁོ་བོ་གཤིན་རྗེའི་ཕོ་ཉ་མོས།",
    "ན་བ་རོ་བཞིན་ཐལ་བའི་དཔེར་བགྱིས་མོད།",
    "ད་ལྟ་ཁྱོད་ཀྱི་ཉམས་སུ་སྤྲོ་ལགས་སམ།",
    "ལུང་གི་མཆུ་སྒྲོས་དམར་པོའི་གེ་སར་ལ།",
    "རང་གི་འདོད་པ་བཞོ་བཞིན་བཞུགས་ལགས་སམ།",
    "བདག་གི་ཚེ་སྐྱོར་རིམ་གྲོ་བསྒྲུབས་པ་ལེགས།",
    "ཀུན་གཟིགས་དགོངས་པ་ཡུལ་ལས་ཡོལ་མི་སྲིད།",
    "ཁྱོད་བདེ་ང་བདེ་འཇིག་རྟེན་བདེ།",
    "གོས་གོང་མོ་ཙེ་ཏུང་གི་ཐུགས།",
    "ཟིལ་དུ་འཁྱིལ་བའི་དྲང་སྲོང་གིས།",
    "འདི་ཀོ་རང་གི་དཔྱད་ནས་ཏེ།",
    "གཞན་གྱི་ལད་མོ་ཟློས་པ་མིན།",
    "མ་ལུས་རྗེན་པར་གཟིགས་པའི་དཔལ་མངའ་བ།",
    "གུས་པས་འདུད་དོ་ངག་གི་སྤོབས་པ་སྩོལ།",
    "འཆི་མེད་གྲོང་གི་ཏོག་ན་སོམ་ཉིས་གཟིར།",
    "བི་ཤྭ་ཀརྨའི་སོར་མོའི་འདུ་བྱེད་ལས།",
    "མཐོང་ཐོས་དྲན་རེག་དོན་དང་ལྡན་པར་ངེས།",
    "ཨ་ཀའི་མཚན་ཅན་གང་དེས་གད་མོ་ཤོར།",
    "སྐྱོན་བྲལ་མཛེས་མའི་ལང་ཚོའི་རྒྱན་མང་ཅན།",
    "བཅུད་དུ་ངོམས་པས་ལྕི་བའི་ཤིང་གི་རྩེར།",
    "ཞེས་བཀའ་སྩལ་པ་འདི་དད་གཏོང་ཤེས་རབ་སོགས་འཕགས་པའི་ནོར་དང་ལྡན་པ་དག་གིས་ཡང་ཡང་དཔྱད་པར་བྱ་བའི་རིགས་སོ།",
    "ལས་འབྲས་ཕྲ་མོའི་སྨིན་ཚུལ་བསམ་གྱིས་མི་ཁྱབ་པ་རྒྱལ་བའི་སྤྱོད་ཡུལ་ཡིན་གྱི།",
    "རང་རེ་ཚུར་རོལ་མཐོང་བས་འོལ་ཚོད་དུ་མ་དད་པ་དང་ལོག་རྟོག་སྐུར་འདེབས་བྱ་མི་རུང་བས་གཟབ་དགོས་ཏེ།",
    "སྙིགས་མའི་ང་རྒྱལ་ཞེ་སྡང་གི་འཁོན་འཛིངས་འཇོམས་པ་དང་།",
    "འདི་ལོ་ལས་མགོ་རྩོམ་བཞིན་པ་ལ་དེང་སང་མཛོ་དགེར་ཕྱི་ནང་གི་འགལ་རྐྱེན་མང་ཞིང་ནག་པོའི་ཕྱོགས་ལ་གྱོད་གོད་འཛད་ཟགས་ཆེ་བ་དང་།",
    "རང་རེའང་ངོ་ཤེས་ལུགས་ཀྱིས་དེ་གའི་དཔོན་འབངས་སྤྱི་ནས་དགེ་འབྲེལ་ཆེ་འཛོམས་ཆུང་འཛོམས་ཤིག་ཐོགས་ན་རྟགས་རྟེན་དང་།",
    "འདིའི་ཨ་ཁུ་བློ་གྲོས་ཟེར་བ་རྡོ་སྦིས་ན་ཁོང་རྣམ་པ་ཡ་རབས་ཀྱི་ཚད་འཇོག་བྱེད་པ་གཉིས་ཀ་དཀར་ཕྱོགས་སུ་དད་བརྩོན་གཏོང་ཕོད་གཞན་དང་མི་མཉམ་སྟབས་གྲྭ་ཚང་གིས་བཞེངས་པའི་གནས་བརྟན་ལྷ་ཁང་བརྟེན་པར་བཅས་པ་ཕྱི་ལོར་འགྲུབ་ངེས།",
    "དེའི་ནང་དུ་སྤུན་འདི་གཉིས་ནས་བསྟན་པ་ནམ་གནས་བར་གནས་བརྟན་ཕྱག་མཆོད་ཀྱི་གཏོང་ཐེབས་སྦྱོར་འདུན་ཉག་གཅིག་ཡིན་ཀྱང་རྒྱུ་ཤེད་ཀྱིས་ཅུང་མི་འདང་བས་དེར་ཞལ་འདེབས་ཀྱི་རེ་ལྟོས་འཆའ་ཞིང་མཆིས་ན།",
    "ཅེས་གསུངས་པ་ལྟར་རེ་ས་ནས་མ་རུལ་བ་དང་།",
    "ནང་གཙང་ལྷུག་མའི་གཞེན་བསྐུལ་དམ་པར་གོ་མིང་ཀྲིན་ཧྥུའི་བཀའི་ལུང་གིས་ཧྥུ་ཇའོ་ཤོན་ཇིའི་ཁྲན་སིའམ།",
    "བཀའ་ཡིག་ནོར་བུའི་ཕྲེང་མཛེས་སྤྱི་རྒྱན་དུ་གནང་སོན་གཟིགས་པ་དམ་པོའི་དན་རྟགས་སུ་ཆེ་བར་མ་ཟད།",
    "བ་མོ་འདོད་རྒུ་འཇོ་བའི་སྤུན་ཟླར་སྒྲུབས།",
    "ཕོ་མོ་རྒན་གཞོན་མེད་པར་བདེ་ཞིང་སྐྱིད།",
    "གཟིགས་པའི་སྤྱན་ཞགས་སྣུམ་པོར་འཕངས་ལགས་སམ།",
    "མིག་གི་སྔ་ན་འཕྱོ་བ་མཛེས་ལགས་མོད།",
    "སྣང་ལ་སྨྲ་པོའི་རིག་པ་ཕྲ་མོས་སྒྲིམས།",
    "ཝང་གི་ཨུརྒེ་ཨོཾ་འདྲའི་རྩེ་གཞུང་ན།",
    "རིག་པའི་རི་མོ་དེ་ལ་བཀོད་པའི་འཕྲིན།",
    "མི་འགྱུར་བདེན་ཚིག་གྲུབ་པའི་དྲང་སྲོང་གིས།",
    "དོན་གཉེར་དང་ལྡན་པ་འགའི་འདོད་མོས་ལྟར།",
    "སྲོག་ལ་ཐུག་པའི་གཟིགས་མོ་འཕེལ་ལགས་སམ།",
    "ནེ་འུ་ཏོག་ཏུ་འབར་བའི་འབྲུག་གི་སྒྲ།",
    "བློ་གྲོས་འབྱུང་གནས་ཕྱག་གིས་བསུ་འམ་ཅི།",
    "གྲགས་སྙན་གཡུ་འབྲུག་སྟོང་གི་ང་རོ་ཅན།",
    "དེ་ཡིས་བསྐུལ་བའི་ཚིག་གི་ཀེ་ས་ར།",
    "དལ་འབྱོར་ཡལ་གས་ཕྱོགས་ཀྱི་ཁྱོན་འགོག་པ།",
    "རྒྱུད་ནས་རྒྱུད་དུ་བྲེལ་བའི་ཕྲེང་རིང་གིས།",
    "གླེན་ལྐུགས་བྱོལ་སོང་བུས་ཀྱང་སྒྲུབ་ནུས་པ།",
    "ཁ་ནས་ཚིག་གི་སྦྲང་རྩི་འཇོ་བཞིན་དུ།",
    "དོན་ལ་འཁྱོག་སྤྱོད་ཚེར་མའི་མཚོན་དཀྲིགས་པ།",
    "རང་མགོ་རང་གིས་མ་སྙིལ་ཞེ་རུས་ཅན།",
    "ལུས་དང་ངག་གི་རྩུབ་སྦྱོར་རྣམ་པ་བདུན།",
    "འབུར་མ་ཐག་ནས་ཆོམས་ཤིག་ཨ་མའི་བུ།",
    "རྟག་ཏུ་ཉིན་དང་མཚན་མོའི་སུམ་ཆ་རེར།",
    "ངན་སོང་ཙམ་གྱིས་སྐྲག་པ་སྐྱེས་བུ་ཆུང་།",
    "བསྟན་ལ་གཅེས་ན་ཞིབ་མོར་དཔྱད་པའི་རིགས།",
    "ཕྱི་དང་ནང་གི་དོན་ལ་ས་ཆོད་ཆེ།",
    "རང་གི་ཉམས་དང་སྦྱར་ནས་ནན་ཏན་མཛོད།",
    "གཤམ་ལ་སུན་འབྱིན་ལྕག་གིས་མི་གཞུ་བར།",
    "སྐྱོན་ལ་གློག་གི་མེ་ལྕེ་སྟོང་འཛུགས་པའི།",
    "ངེས་མེད་དྲུག་གི་རྣམ་པར་བཀྲ་བ་གང་།",
    "སྨོད་པའི་ཚིག་གིས་སུ་ཡང་སུན་མ་འབྱིན།",
    "སློང་བ་རེ་འདུན་ལོག་པས་འགྲོར་མ་སྟེར།",
    "སྨྲེ་སྔགས་འདོན་ན་སྙན་པའི་ངག་གིས་བཞོས།",
    "ཀུན་བཏུས་མིང་གི་རྣམ་གྲངས་གཞན་བཞེད་མོད།",
    "མོ་རྩེ་ཏུང་ཞེས་གྲགས་པའི་སྤྲིན་ཆེན་པོ།",
    "མེས་པོ་རྣ་བ་བརྒྱད་པའི་རོལ་མོ་བྱེད།",
    "དྲང་པོའི་ཐིག་གི་ཁེངས་པ་འཕྲོག་བྱེད་ཅིང་།",
    "ནང་གི་སྤང་གཞོངས་ཡངས་པོར་འཕེལ་འོས་ཏེ།",
    "འཛིན་པོ་རང་གིས་ཅི་མཛད་དོགས་པའི་གནས།",
    "ལག་རྗེས་མི་དམན་མཆོག་གི་གཟིགས་མོར་མཚར།",
    "རྨོངས་རྒན་སྦྲུལ་ནག་ཁུག་འགྲོའི་དུག་གི་ལྕེ།",
    "རང་བཞིན་མ་འཁྱོག་ཉག་ཕྲན་མདའ་ལ་འགྲན།",
    "ཞིབ་མོར་དཔྱད་ནས་ཉམས་སུ་བཞེས་པར་མཛོད།",
    "ལེགས་ལམ་མིག་གི་སྔ་ན་གནས་པ་བཞིན།",
    "བརྡ་སྤྲོད་གཞུང་གི་འབྲུ་མང་བཀྲོལ་བ་དང་།",
    "མ་བརྗེད་གུས་པའི་རི་མོ་ཁྲི་ཕྲག་གིས།",
    "མི་རྟག་དུས་ཀྱི་ལམ་ལ་ཉིན་རེ་བཞིན།",
    "མེ་ཏོག་འབྲས་བུའི་ལང་ཚོ་རྒྱས་པའི་ལྗོན།",
    "མིང་གི་ཅོད་པན་སྦུར་བའི་གོ་གནས་གཉིས།",
    "གཅིག་གིས་གཅིག་ཟ་མི་མིན་དུད་འགྲོ་ཞེས།",
    "གཅིག་དང་མཐུན་ན་གཅིག་གི་མིག་ལོག་པ།",
    "མཆོག་གི་ཕན་ཡོན་ནམ་མཁའི་མཐའ་དང་མཉམ།",
    "གནམ་ལྕགས་རྡོ་རྗེའི་ཐོག་གི་སེར་བ་ལ།",
    "གཟིམས་ཆུང་རྐྱལ་གྱིས་རྩེན་རྣམས་ཡི་རེ་མུག།",
    "མཆོག་གསུམ་མཐུ་རྩལ་དབུགས་ཀྱི་ཆ་རེས་ཀྱང་།",
    "བྱེ་མ་ལྟ་བུར་གཏོང་བ་ཆེས་སླ་མོད།",
    "ལྷ་མིན་རྒྱལ་མཚན་རྩེ་མོའི་དཔུང་རྒྱན་ལས།",
    "སྟོན་ལ་ཞུས་པའི་བཀའ་ལན་གཟིགས་ལགས་སམ།",
    "འདི་ལ་རེག་གཅོད་རལ་གྲིའི་སོ་བཞིན་རྣོ།",
    "བོད་འབངས་རྩུབ་འགྱུར་ཚལ་དུ་མ་སོང་ཡང་།",
    "སྲོག་གི་མཆོད་སྦྱིན་འགྱེད་ལ་མངོན་ཕྱོགས་པ།",
    "རང་གིས་འབུ་ཡང་སུན་འབྱིན་མི་ནུས་པར།",
    "གཞན་ལ་འབྲོང་གི་སྟེང་ནས་གཏམ་ཟློ་བ།",
    "ངག་འཁྱལ་དོན་མེད་ཚིག་གིས་ཚེ་མ་སྐྱེལ།",
    "གཏམ་ལ་ངག་གི་རྩལ་གསུམ་འཛོམས་པར་བྱ།",
    "རང་གི་དོན་ལ་གཅེས་པའི་ཡིད་དམ་ཞིག་འཆའ་འོ།",
    "གང་དུ་སོང་ཡང་བསྟན་འགྲོར་ཅི་ཕན་གྱི་བསམ་སྦྱོར།",
    "ཡིད་འཕྲོག་སྐུ་བཞིའི་རི་མོ་འབྲི་བ་རུ་྾།",
    "དངོས་གྲུབ་གཉིས་ལ་རེ་བའི་རྣམ་སད་ཀྱི་ཁྱེ་འུ།",
    "ཉིན་རེར་ལུས་ངག་ཡིད་ཀྱི་སྒོ་ལ་ལྟ་རྟོག་གིས་ལྷོད་ཅིག་གེར་བཞུགས།",
    "ཁྲིགས་ཆགས་དགེ་སྦྱོར་སུན་སྣང་གིས་སྦུ་སུ་དོག་ཏུ་མ་འཇུག་འདྲ་འགྲིག་མ་མུག་གྲངས་མང་དཀར་པོའི་གེགས།",
    "རེ་ཞིག་ཅང་མི་སྨྲ་བའི་ཧད་པོར་ལུས།",
    "མཇལ་འཛོམས་བདུད་རྩི་འཐུང་བའི་རེ་བ་ཕྲ།",
    "རེག་གཅོད་རལ་གྲིའི་ངན་འཕྲུལ་ལྷུར་བླངས་པ།",
    "སྔོན་ཆད་གོ་མིན་ཏང་གིས་བཀུར།",
    "ད་ལྟ་གུང་ཁྲན་ཏང་གིས་ཀྱང་།",
    "ཏིང་འཛིན་ཟབ་མོའི་བཅུད་དུ་ལོངས།",
    "འབྲལ་བ་མེད་པས་ཁྱོད་ལ་དགེ་གྱུར་ཅིག།",
    "སྲོག་གི་འཚོ་བས་གཤིན་རྗེའི་གཡར་སྔར་མཆོང་རྒྱུག་བྱེད་བཞིན་པ་ཡིན་མོད།",
    "ཕྱག་གི་ཡུལ་དུ་འོས་ཙམ་སྟེ།",
    "ཀུན་ཛའི་ཡི་གེར་ཞིབ་ཆ་འཁོད་པ་དེ་བཞིན་ཁྱོད་ཀྱིས་ཀྱང་ཚོལ་རོགས།",
    "ཐུབ་བསྟན་སྐྱོང་བ་བཤེས་གཉེན་མཆོག་གི་ལས།",
    "གྲྭ་ཚང་གི་མཁན་ཁྲི་མནན་ན་འོས་པ་ཉིད་དེ།",
    "ཀུན་ནས་ཕྱོགས་མོད་ཟ་ཟིའི་རི་བོ་ལྕི།",
    "མང་ཕྱེ་ལུང་གི་བང་མཛོད་ཁྲི་ཕྲག་ཅན།",
    "ཡུལ་དབུས་འཛིན་མའི་ཁྱོན་ལ་དགེ་འགྱུར་མོད།",
    "བླུན་པོས་མ་འཚལ་མ་ཡང་སྲིན་མོར་མཐོང་།",
    "བདག་གིས་རིང་ནས་གཅེས་པར་བསྐྱངས་པ་འགའང་།",
    "བདག་གི་ཚིག་འདིར་གཟུ་བོའི་དབྱིངས་ནས་དཔྱོད།",
    "དྲང་སྲོང་དགྱེས་པའི་ལམ་བཟང་ཚོལ་བ་འཚེངས།",
    "དཔང་དུ་གསོལ་ལོ་མཁྱེན་པའི་མཆོག་གིས་གཟིགས།",
    "མཚར་སྡུག་ཕྱོགས་ཀྱི་བུ་མོའི་རྣ་ལུང་ལ།",
    "མཐུ་སྟོབས་གཟི་བྱིན་མཆོག་གི་རི་མོ་འབུམ།",
    "ཕྱི་དབྱིངས་གསེར་གྱི་ཁྲིའི་རིགས་སུ་སོན་པ་དེ་ཁོ་ནས་ཆོག་གི་གལ་འགངས་ཤིང་རྡོའི་ཁྲི་ལ་འཛེག་པ་རང་ཆེ་སྟེ།",
    "མུ་བཞིའི་ནང་གི་དང་པོ་ལས།",
    "རྡོ་ཤིང་གི་གཞན་ཕན་ཚངས་པས་ཀྱང་དཔག་པར་དཀའ་བའི་ཕྱིར་རོ།",
    "རང་རེའི་གྲགས་བརྟན་ཐོག་མཐའ་བཞིན།",
    "རང་གི་ཚོད་ཀྱི་ལག་རྗེས་དམན།",
    "བསྟན་མི་འཛིན་མོད་ཀྱི་སྐྱིད་༡ ༣༣པར་ཐོས།",
    "གུང་སྲིད་གསར་མཐུན་འགྲོགས་ཟབ་མོས་བསུས།",
    "བདག་འདི་ན་གཤིན་རྗེའི་གཟིགས་ལམ་དུ།",
    "པད་མཚོ་མཚོ་ཡི་རྩེ་མོའི་པད་དཀར་བཞིན།",
    "དུས་སུ་གཟིགས།",
    "ལྟ་མགུར་དང་འདི་གཉིས་སློབ་བུ་སྐུ་འབུམ་པ་དག་གིས་བསྐུལ།",
    "གཞུང་མང་གི་མཐུན་རྐྱེན་འཛོམས་ཤིང་རང་གི་དཔྱད་པའི་རྩལ་བཏོན་ན་དེ་འདྲའི་འཆད་རྩོམ་ཧ་ཅང་རྔོ་མི་ཐོགས་པ་ཅི་ཡོད་སྙམ་དུ་སེམས་པའི་ཁེངས་རློམ་ཡང་ཆེ་ཞེས་ཀྱང་ཞུ།",
    "གང་གིས་བླང་དང་དོར་བྱའི་རིམ་པ་ལ།",
    "ནང་གི་ཟླ་ཟེར་བསིལ་བའི་རྩེར་འཛེགས་པས།",
    "རང་རེའི་དོན་དུ་གོོ་ཏཾ་སྟོབས་བཅུ་པ།",
    "དབྱིག་གི་ཐིག་ལེར་བལྟམས་ནས་རིང་ཞིག་འདས།",
    "དེ་ལྟ་མོད་ཀྱི་དེ་ཡི་བདུད་རྩིའི་འཕྲིན།",
    "མཁས་པའི་གཟིགས་ངོར་མ་འདྲེས་གསལ།",
    "གཅན་གཟན་མོ་དང་མི་ཉེ་འམ།",
    "ཕྱི་མའི་ཡུལ་གྱི་ལྟད་མོ་ལ།",
    "མིག་གི་འཇུག་པ་ཀུན་བརྟུལ་ནས།",
    "འདི་ན་རང་གཅེས་འབའ་ཞིག་གིས།",
    "སྨག་གི་དཀྱིལ་འཁོར་ཀུན་ནས་རྫོགས།",
    "ཉིན་མོ་ལོང་བ་ཧཱུཾ་སྒྲ་འབྱིན།",
    "མེད་གསུམ་ཚང་བ་འདི་རེ་བརྗིད།",
    "ཆང་གིས་མ་བེད་བཟི་བོ་ལགས།",
    "སྐྱེ་བོའི་ཁྲོད་ན་ཡ་རེ་ང་།",
    "མ་རབས་གཅིག་གི་བྱེད་འཛོལ་ལས།",
    "སྣག་ཚའི་ཐིགས་པ་ཕྲ་མོ་ཡིས།",
    "ལང་ཚོ་མཚར་རྒུའི་མཛེས་མ་ཡང་།",
    "ཕྱི་ཡི་ལུས་དང་ནང་གི་བློ།",
    "དྲུག་པ་རྡོ་རྗེ་འཆང་གི་བཀའ།",
    "ཕལ་བའི་ངག་གིས་ག་ལ་ལང་།",
    "ནང་གི་གློག་འཕྲུལ་ཟླ་དང་བྲལ་བར་གྱིས།",
    "མིང་གི་ཅོད་པན་མེས་པོས་སྒྲོན་པ་འདིར།",
    "རྣམ་པར་དཔྱོད་པའི་རྩེ་མོ་གཅིག་ཏུ་སྒྲིལ།",
    "ཀུན་མཁྱེན་དགྱེས་པའི་རོལ་མོར་བསྒྲགས་པ་ཐོས།",
    "བསྟན་པའི་ས་ཆེན་འདི་ན་གྲགས་མོད་ཀྱི།",
    "ཁ་བརྒྱ་ལྕེ་སྟོང་ཟབ་ཟབ་རྫིག་རྫིག་གི།",
    "མ་བཀྲོལ་ངང་གིས་ལྷོད་པར་འགྱུར་བ་ཡིན།"
