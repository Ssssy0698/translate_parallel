    "དེ་འདི་ཉིད་ཀྱང་བསྒྲག་པར་བྱ་སྟེ།",
    "གཡོ་མེད་པ་ཡིས་འདི་བྱས་ན།",
    "དེ་ནས་ཉི་མ་གཞན་ལ་ནང་པར་སྔ་བར་དམ་ཚིག་ལ་ཞི་བའི་གཏོར་མ་ཕུལ་ནས་སྐུ་གཟུགས་ལ་སོགས་པ་དེ་ཉིད་དུ་བཞུགས་སུ་གསོལ་ལོ།",
    "གཙུག་ལག་ཁང་ལ་སོགས་པ་རྣམས་ཀྱང་ཇི་ལྟར་གནས་པའི་དམ་ཚིག་སེམས་དཔའ་བསྐྱེད་པར་བྱའོ།",
    "མཆོད་རྟེན་གྱི་གཟུགས་རྣམས་ཀྱང་དམ་ཚིག་སེམས་དཔར་བསྐྱེད་ནས་ཞབས་བསིལ་དང་།",
    "དེ་ནས་སྐུ་གཟུགས་ཀྱི་དཔྲལ་པ་དང་།",
    "ལྟེ་བ་རྣམས་ལ་ཨོཾ་ཨཱ་ཧཱུཾ་ཀྵིཾ་ཛཾ་ཁཾ་གཾ་སྐཾ་སཾ་ཞེས་པའི་ས་བོན་གྱི་ཡི་གེས་ལྷག་པར་གནས་པར་བྱའོ།",
    "ཨོཾ་ཨཱ་ཛྙཱ་ན་ཙཀྵུ་ཀུ་རུ་ཀུ་རུ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཡེ་ཤེས་ཀྱི་མིག་ལྷག་པར་གནས་པར་བྱའོ།",
    "གླ་བ་དང་གུར་ཀུམ་ལ་སོགས་པའི་དྲི་བཟངས་རྣམས་ཀྱིས་ཡང་དག་པར་བྱུགས་ཏེ།",
    "ཞེས་པའི་སྔགས་ཀྱིས་དེའི་ཐུགས་ཀའི་རྡོ་རྗེ་ལ་དམིགས་ནས་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "དེ་ནས་མཆོད་ཡོན་ལ་སོགས་པ་རྣམས་ཀྱིས་ཡང་དག་པར་མཆོད་ལ།",
    "ཨོཾ་ཨཱ་ས་མཱ་དྷི་ཕཱ་ལ་ལེ་སརྦ་ཛི་ན་པུ་ཏྲ་པྲཱི་ཎ་ནེ་ཨཱ་ཧཱུཾ་སྭཱ་ཧཱ་ཞེས་པས་ལྷག་པར་གནས་ཤིང་དབུལ་བར་བྱའོ་ཞེས་པ་ནི་ཤིང་ཐོག་འབྲིམ་པའོ།",
    "གསེར་གྱི་སྣོད་ལ་སོགས་པར་གནས་པའི་བཅའ་བ་ལ་དུ་ལ་སོགས་པ་ཁུར་བའི་རྣམ་པ་ལ་སོགས་པ་དང་།",
    "ཅེས་པས་མེ་ཏོག་ལ་སོགས་པས་ཡང་དག་པར་མཆོད་ནས་བསྟོད་པར་བྱའོ་ཞེས་པ་ནི་ཉེ་བར་འདྲེན་པའོ།",
    "དཔལ་གྱི་རིན་ཆེན་འབྱུང་ལྡན་རྒྱལ་བས་ངེས་པར་བསྟེན་པ་ཡིས།",
    "ཁམས་གསུམ་ཀུན་གྱིས་ཕྱག་བྱས་པ།",
    "སྔགས་འདིས་བརྟན་པར་བྱས་ནས་ཙཱུ་ཌའི་རྣམ་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་སཏྭ་ཧཱུཾ་ཞེས་པའི་སྔགས་ཀྱིས་ལྷག་པར་གནས་ལ་མཚན་མ་ལྷ་རྣམས་ཀྱི་ཕྱག་ན་གནས་པར་བསམ་པར་བྱའོ།",
    "ངེས་པར་ཡང་ནི་རྟག་ཏུ་བྱ།",
    "དེ་ནས་བཛྲ་དྷརྨྨ་ཧྲཱི་འདིའི་སྔགས་ཀྱིས་ལྷག་པར་གནས་ནས་མགུལ་དུ་ཚངས་སྐུད་དབུལ་བར་བྱའོ།",
    "ཨོཾ་བཛྲ་སཏྭཱི་བཾ་སྔགས་འདིས་ལྷག་པར་གནས་ནས་རྐེད་པ་ལ་མུཉྫའི་སྐེ་རགས་དབུལ་བར་བྱའོ།",
    "སྔགས་འདིས་ལྷག་པར་གནས་པར་བྱས་ལ།",
    "ཕྱག་ཏུ་ཀེ་ཤུའི་དབྱུག་པ་གཏད་པར་བྱ་སྟེ་འདི་ནི་བརྟུལ་ཞུགས་བརྟན་པའོ།",
    "སྐུ་གཟུགས་ལ་སོགས་པའི་གཡོན་ལོགས་སུ་པདྨ་དང་ཟླ་བའི་གདན་ལ་དགོད་དོ།",
    "ཀཀོ་ལ་དང་ལི་ཤི་དང་ཛཱ་ཏི་ཕལ་དང་གུར་གུམ་དང་སིཧཱ་དང་ག་པུར་རྣམས་ཀྱིས་ཚོགས་པས་ཡང་དག་པར་བྱུག་གོ།",
    "ཡང་དག་པར་མཆོད་ནས་སྔོན་མ་བཞིན་དུ་གཤེགས་སུ་གསོལ་ལོ།",
    "ཨོཾ་ཡོ་ཛཱགྣ་ལེ་སྭཱ་ཧཱ་ཞེས་པའི་སྔགས་ཀྱིས་སྦྱོར་པར་བྱེད་པའི་མེ་བག་མའི་དུས་ཀྱི་ཆོ་གས་ཡང་དག་པར་མཆོད་ནས་དེའི་མེའོ།",
    "ཉི་མས་ཀྱང་ཡང་དག་པར་བསྲུང་ངོ།",
    "ཨ་ཀ་རུའི་བདུག་པས་ཀྱང་ཡང་དག་པར་མདུན་དུ་བྱའོ།",
    "རྡོ་རྗེ་ལས་ཀྱི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་ཡང་དག་པར་བསྲུངས་ལ།",
    "སྔོན་དུ་གསུངས་པའི་རིམ་པའི་ཚད་བཞིས་བྱའོ།",
    "དེ་ནས་དྲི་གཙང་ཁང་དང་གཞན་ཡང་ལྷག་པའི་གནས་རྣམས་སུ་བཟོ་བོ་མཁས་པས་བྱས་པའི་སེང་གེའི་ཁྲི་མཛེས་པ་ལ་ཚེས་གྲངས་དང་།",
    "ཡུད་ཙམ་བཟང་པོ་རྣམས་ལས་གནས་པར་གྱུར་པའི་སྐུ་གཟུགས་ལ་སོགས་པར་དགོད་པར་བྱའོ།",
    "འདིས་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་ནས་ལྷག་པར་གནས་པར་བྱའོ།",
    "བཀྲ་ཤིས་གང་ཞིག་ལྷ་ཡི་རྣམ་པར་དག་མཛད་པ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་སེམས་དཔའ་དེ་ཉིད་བསྐྱེད་པར་བསམས་ལ་སྦྱིན་པར་བྱའོ།",
    "སྐུ་གཟུགས་ལ་སོགས་པའི་ལྷ་རྣམས་ཀྱི་ཕྱག་ཏུ་རྡོ་རྗེ་དང་དྲིལ་བུ་དང་བཅས་པས་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱ་ལ་འཁྱུད་པའི་ཚུལ་དུ་རྣམ་པར་བསྒོམས་ནས།",
    "ཞེས་པའི་སྔགས་ཀྱིས་ལྷག་པར་གནས་པར་བྱའོ།",
    "ཁུ་བའི་སྐུ་གཟུགས་སུ་གྱུར་ཏེ་བདེ་བ་ཆེན་པོ་ཉམས་སུ་མྱོང་ནས་རྡོ་རྗེ་དང་པདྨ་དག་ལས་བདུད་རྩིར་གྱུར།",
    "དེ་ནས་འདི་དེ་མེ་ཏོག་ཅེས་པ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པས་མེ་ཏོག་ལ་སོགས་པ་རྣམས་ཀྱིས་ཡང་དག་པར་མཆོད་ལ་བསྟོད་པ་བྱས་ནས་ཆད་པ་དང་ལྷག་པའི་ཉེས་པ་ཞི་བར་བྱ་བའི་ཕྱིར།",
    "སརྦ་ཀརྨྨ་སུ་ཙ་མེ་ཙིཏྟཾ་ཤྲེ་ཡ་ཀུ་རུ་ཧཱུཾ་ཧ་ཧ་ཧ་ཧོ་བྷ་ག་བཱན་སརྦ་ཏ་ཐཱ་ག་ཏ་བཛྲ་མཱ་མེ་མུཉྩ་བཛྲཱི་བྷ་བ་མ་ཧཱ་ས་མ་ཡ་སཏྭ་ཨ་ཞེས་པའི་ཡི་གེ་བརྒྱ་པ་ལན་གསུམ་བཟླས་པར་བྱའོ།",
    "ཞེས་པས་བརྟན་པར་བྱའོ།",
    "ཁྱེད་ལ་ཐམས་ཅད་བཟོད་པར་གསོལ།",
    "དེ་སྲས་རྣམས་ལ་བཟོད་པར་གསོལ།",
    "ལྷ་རྣམས་ཀུན་ལ་བཟོད་པར་གསོལ།",
    "སྐུ་གཟུགས་ཡུན་རིངས་གནས་གྱུར་ཅིག།",
    "སློབ་དཔོན་ཀྱང་ཡང་དག་པའི་ཡོན་ལ་སོགས་པས་ཡོངས་སུ་མཉེས་པར་བྱའོ།",
    "ཨོཾ་ཨཱ་བཛྲ་བ་རུ་ཎཱ་ཡ་ཨ་དྷི་ཏིཥྛ་བུཾ་སྭཱ་ཧཱ་ཞེས་པའི་སྔགས་ཀྱིས་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "ཨོཾ་ཨཱ་བཛྲ་བ་རུ་ཎཱ་དྷི་པ་ཏི་པུདྡྷ་ཤཱ་ས་ནཾ་རཀྵ་རཀྵ་སྭཱ་ཧཱ་ཞེས་པའི་སྔགས་ཀྱིས་ལན་ཉི་ཤུ་རྩ་གཅིག་ཏུ་བཟླས་པར་བྱའོ་ཞེས་པ་ནི་ཆུ་བདག་གནས་པའོ།",
    "ཨོཾ་ཨཱ་བཛྲ་བེ་ཤྲ་བཎཱ་ཡ་ཧཱུཾ་སྭཱ་ཧཱ་ཞེས་པའི་སྔགས་ཀྱིས་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "ཨོཾ་མ་ཧཱ་བ་ལ་ཧཱུཾ་ཕཊ་ཅེས་པའི་སྔགས་ཀྱིས་ལན་བརྒྱ་རྩ་བརྒྱད་ལྷག་པར་གནས་པར་བྱའོ།",
    "སྔགས་འདིས་ལན་ཉི་ཤུ་རྩ་གཅིག་ལྷག་པར་གནས་པར་བྱའོ།",
    "འདིས་ལན་ཉི་ཤུ་རྩ་གཅིག་ཏུ་ཡོངས་སུ་བཟླས་པས་ལྷག་པར་གནས་པར་བྱའོ།",
    "འདིས་ལན་ཉི་ཤུ་རྩ་གཅིག་ཏུ་བཟླས་པས་ལྷག་པར་གནས་པར་བྱའོ།",
    "འདིས་ཀྱང་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "དེ་ནས་དེ་ལ་ཟས་ལ་སོགས་པའི་ཕུང་པོ་བྱས་ནས་དཔུང་པ་བཟང་པོའི་རྒྱུད་ལས་གསུངས་པའི་ཚིགས་སུ་བཅད་པ་བརྗོད་པ་སྔོན་དུ་འགྲོ་བས་དྲི་བཟངས་དང་ཆུ་དང་ཁྲག་དང་མ་ཛྙ་ར་དང་ཆང་དང་འོ་མའི་རྒྱུན་བླུགས་པ་སྔོན་དུ་འགྲོ་བས་གཏོར་མ་དབུལ་བར་བྱའོ།",
    "གཏོར་མའི་སྟེགས་བུ་དགོད་པར་རོ།",
    "དེ་ནས་ཡན་ལག་རྣམ་པ་བཞིའི་རྣམ་པར་དག་པས་གཎྜཱི་རྣམ་པ་བཞིའོ།",
    "ས་བཅུ་གསུམ་གྱི་རྣམ་པར་དག་པས་ཆ་བཅུ་གསུམ་པ་སྟེ་ཟླུམ་པོའོ།",
    "དེ་བཞིན་དུ་བཟོད་པའི་རྣམ་པར་དག་པ་ནི་གཎྜཱི་གསུམ་པ་སྟེ།",
    "སྒྲིབ་པ་མེད་པའི་རྣམ་པ་ལ་སོགས་པའི་དབྱངས་བཅོ་ལྔའི་རྣམ་པར་དག་པ་ཆ་བཅོ་ལྔ་ནི་ཟླུམ་པོའོ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་ཕུང་པོ་ལྔའི་རྣམ་པར་དག་པའོ།",
    "གཎྜཱི་ཐིའུའི་ཚད་བརྗོད་པར་བྱ་སྟེ།",
    "གཎྜཱི་བརྡུངས་པའི་སྒྲས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲའི་རང་བཞིན་དུ་བརྗོད་པར་འགྱུར་རོ།",
    "དཀྱིལ་འཁོར་ལ་ཤིན་ཏུ་གུས་པར་འགྱུར་རོ།",
    "དེ་ལ་ཚོན་རིས་བདུན་གྱི་ཚོན་གྱི་རིམ་པ་བརྗོད་པར་བྱ་སྟེ།",
    "དམར་པོ་ནི་ཐམས་ཅད་ཡོད་པར་སྨྲ་བའིའོ།",
    "འདིས་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པར་བྱའོ།",
    "འདིས་ལན་བརྒྱ་རྩ་བརྒྱད་ཡོངས་སུ་བཟླས་པར་བྱའོ།",
    "ཡེ་དྷརྨཱ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པས་རབ་ཏུ་གནས་པར་བྱའོ།",
    "འདིས་ལན་བརྒྱ་རྩ་བརྒྱད་ཡོངས་སུ་བཟླས་པར་བྱའོ།",
    "གནས་བརྟན་གདན་ལ་བཞུགས་པ་ལ་བརྗོད་པར་བྱ་སྟེ།",
    "མེ་ཏོག་ལ་སོགས་པས་ཡང་དག་པར་མཆོད་ནས་གནས་བརྟན་ལ་སྙན་གསན་དབབ་པར་བྱའོ།",
    "ད་ནི་རབ་ཏུ་བྱུང་བ་བླང་བ་བརྗོད་པར་བྱ་སྟེ།",
    "དགེ་སློང་རྣམས་ཀྱིས་རབ་ཏུ་བྱུང་བ་ཉེ་བར་བསྒྲུབ་པ་ཇི་ལྟར་ཤེས་པར་བྱ་ཞེ་ན།",
    "གཉིས་པ་ཡང་དེ་ནས་བསླབ་པའི་གནས་ལྔ་སྦྱིན་པར་བྱའོ།",
    "སྲོག་གཅོད་པ་ལས་བདག་སླར་ལྡོག་པར་བགྱིད་དོ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བ་ཇི་སྲིད་འཚོའི་བར་དུ་མ་བྱིན་པར་ལེན་པ་སྤོང་སྟེ་མ་བྱིན་པར་ལེན་པ་ལས་སླར་ལྡོག་པར་བགྱིད་དོ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བ་ཇི་སྲིད་འཚོའི་བར་དུ་འདོད་པ་ལོག་པར་སྤྱོད་པ་སྤོང་སྟེ་འདོད་པ་ལོག་པར་སྤྱོད་པ་ལས་བདག་སླར་ལྡོག་པར་བགྱིད་དོ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བ་ཇི་སྲིད་འཚོའི་བར་དུ་བརྫུན་དུ་སྨྲ་བ་སྤོང་སྟེ་བརྫུན་དུ་སྨྲ་བ་ལས་སླར་ལྡོག་པར་བགྱིད་དོ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བ་ཇི་སྲིད་འཚོའི་བར་དུ་འབྲུའི་ཆང་དང་བཙོས་པའི་ཆང་མྱོས་པར་འགྱུར་བ་བག་མེད་པའི་གནས་སྤོང་སྟེ་འབྲུའི་ཆང་དང་བཙོས་པའི་ཆང་མྱོས་པར་འགྱུར་བ་བག་མེད་པའི་གནས་ལས་བདག་སླར་ལྡོག་པར་བགྱིད་དོ།",
    "དེ་ནས་སྐྲ་བཞར་ནས་གཙུག་ཕུད་གཞག་པར་བྱའོ།",
    "གལ་ཏེ་ངེས་སོ་ཞེས་ཟེར་ན་རྒྱ་མཚོ་བཞིའི་ཆུས་ཁྲུས་བྱ་སྟེ་དེའི་ཚེ་གཙུག་ཕུད་བྲེག་པར་བྱ་ཞིང་གོས་ངུར་སྨྲིག་བསྐོན་པར་བྱའོ།",
    "རབ་ཏུ་བྱུང་བའི་རྟགས་ཡང་དག་པར་ལེན་ཏོ་ཞེས་ལན་གསུམ་དུའོ།",
    "དེ་ནས་བསླབ་པའི་གནས་བཅུ་སྦྱིན་པར་བྱའོ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བ་ཇི་སྲིད་འཚོའི་བར་དུ་སྲོག་གཅོད་པ་སྤོང་སྟེ་སྲོག་གཅོད་པ་ལས་སླར་ལྡོག་པར་བགྱིད་དོ།",
    "དགེ་ཚུལ་གྱི་བསླབ་པ་ཡང་དག་པར་བླང་བར་བགྱིའོ།",
    "ཇི་ལྟར་འཕགས་པ་དགྲ་བཅོམ་པ་དེ་རྣམས་ཀྱིས་ཇི་སྲིད་འཚོའི་བར་དུ་མ་བྱིན་པར་ལེན་པ་དང་མི་ཚངས་པར་སྤྱོད་པ་དང་།",
    "བརྫུན་དུ་སྨྲ་བ་དང་འབྲུའི་ཆང་དང་བཅོས་པའི་ཆང་མྱོས་པར་གྱུར་པ་བག་མེད་པའི་གནས་དང་།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བས་སློབ་དཔོན་ལ་གསོལ་བ་གདབ་པར་བགྱི་སྟེ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བས་སློབ་དཔོན་ལ་གསོལ་བ་གདབ་པར་བགྱིའོ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བས་སློབ་དཔོན་ལ་གསོལ་བ་གདབ་པར་བགྱི་སྟེ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བས་སློབ་དཔོན་ལ་གསོལ་བ་གདབ་པར་བགྱི་སྟེ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བས་སློབ་དཔོན་ལ་གསོལ་བ་གདབ་པར་བགྱི་སྟེ་བླང་བའི་སྣོད་འདི་ཆུ་སྣོད་དུ་ལྷག་པར་གནས་པར་བགྱིའོ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བས་སློབ་དཔོན་ལ་གསོལ་བ་གདབ་པར་བགྱི་སྟེ།",
    "བླང་བའི་སྣོད་འདི་ཆུ་སྣོད་དུ་ལྷག་པར་གནས་པར་བགྱིའོ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བས་སློབ་དཔོན་ལ་གསོལ་བ་གདབ་པར་བགྱི་སྟེ།",
    "ཡོངས་སུ་ལོངས་སྤྱད་པའི་ཕྱིར་ལྷག་པར་གནས་པར་བགྱིའོ།",
    "བླང་བའི་སྣོད་འདི་ཆུ་སྣོད་དུ་ལྷག་པར་གནས་པར་བགྱིའོ།",
    "འདི་གསིལ་བྱེད་དུ་ལྷག་པར་གནས་པར་བགྱིའོ།",
    "བདག་མིང་འདི་ཞེས་བགྱི་བས་འདི་གསིལ་བྱེད་དུ་ལྷག་པར་གནས་པར་བགྱིའོ།",
    "རྣམ་པར་གྲོལ་བའི་ཕུང་པོ་དང་།",
    "རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་མཐོང་བའི་ཕུང་པོ་རྣམས་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "གཞུང་མངས་པའི་འཇིགས་པས་བསླབ་པ་གསུངས་པ་གཞན་རྣམས་ནི་མ་བྲིས་སོ་ཞེས་པ་ནི་རབ་ཏུ་སྦྱིན་པའི་ཆོ་གའོ།",
    "ཤེས་ཤིང་བཞེངས་པར་བྱ་བ་དང་།",
    "ཐུང་བ་ནི་ཇི་ལྟར་མཛེས་པར་བྱའོ།",
    "སྟོབས་ལྔའི་རྣམ་པར་དག་པས་ཆ་ལྔ་ནི་འདེགས་པའོ།",
    "གྲུ་བཞི་འབྱེད་པའི་རྣམ་པར་དག་པས་ཆ་བཞི་ཡིས་འདེགས་པའི་སྟེགས་བུའི་སྟེང་འོག་ཏུའོ།",
    "རྣམ་པར་དག་པ་གསུམ་གྱི་རྣམ་པར་དག་པས་ཆ་གསུམ་གྱིས་འདེགས་པའི་སྟེགས་བུའི་སྟེང་འོག་ཏུའོ།",
    "བསམ་གཏན་བཞིའི་རྣམ་པར་དག་པ་ནི་རྟ་བབས་བཞི་པོ་རྣམས་སོ།",
    "མི་འཇིགས་པ་བཞིའི་རྣམ་པར་དག་པས་ཟུར་བཞིའོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞིའི་རྣམ་པར་དག་པ་བཞིའི་སྟེགས་བུའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞིའི་རྣམ་པར་དག་པས་སྟེགས་བུ་གཉིས་པའོ།",
    "དད་པ་ལ་སོགས་པའི་སྟོབས་ལྔའི་རྣམ་པར་དག་པས་མགུལ་རྒྱན་ནོ།",
    "མི་རྟག་པ་ལ་སོགས་པའི་སྒོའི་རྣམ་པར་དག་པས་སྒོ་བཞིའི་དང་མེ་ཏོག་འཛིན་པའོ།",
    "མཁའ་ཁྱབ་ཀྱི་ཏིང་ངེ་འཛིན་རྣམ་པར་དག་པས་ཆར་ཁབ་ཀྱི་གནས་སོ།",
    "བདུད་བཞི་བཅོམ་པའི་རྣམ་པར་དག་པས་མགྲིན་པའོ།",
    "ཚིགས་སུ་བཅད་པ་གཉིས་དང་ཡུལ་ཐམས་ཅད་ཀྱི་བདག་ཉིད་དུ་གྱུར་པ་རྣམ་པར་དག་པས་དྲིལ་བུ་གཉིས་སོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཡན་ལག་རྣམ་པར་དག་པས་གདུགས་སོ།",
    "ཆགས་པ་མེད་པའི་བདག་ཉིད་ཀྱི་སེམས་རྣམ་པར་གྲོལ་བའི་རྣམ་པར་དག་པས་རྒྱལ་མཚན་ནོ།",
    "དེ་དང་ཡང་བཅོམ་ལྡན་འདས་མ་ལ་སོགས་པའི་གྲགས་པ་རྣམ་པར་དག་པས་བ་དན་ནོ།",
    "རྨིག་པ་དང་བ་རཎྜ་ལ་སོགས་པ་རྣམས་ཀྱང་ཇི་ལྟར་མཛེས་པར་བྱའོ།",
    "སྔགས་འདིས་ལན་ཉི་ཤུ་རྩ་གཅིག་ཏུ་ཡོངས་སུ་བཟླས་པར་བྱའོ།",
    "ཨོཾ་དྷ་རྨ་དྷཱ་ཏུ་ག་རྦྷེ་སྭཱ་ཧཱ་ཞེས་པའི་སྔགས་འདིས་ལན་བརྒྱ་རྩ་བརྒྱད་ཡོངས་སུ་བཟླས་ལ་མཆོད་སྡོང་དགོད་པར་བྱའོ།",
    "སྔོན་དུ་གསུངས་པའི་རབ་ཏུ་གནས་པའི་ཆོ་གས་རབ་ཏུ་གནས་པར་རྒྱལ་མཚན་གཟུགས་པ་རབ་ཏུ་བསྔགས་པས་འདིར་རྒྱལ་མཚན་གྱི་མཚན་ཉིད་བརྗོད་པར་བྱ་སྟེ།",
    "རྒྱར་ཇི་ལྟར་འཚམ་པར་བྱའོ།",
    "ལྷག་མ་རྣམས་ནི་བཟོ་བོས་ཇི་ལྟར་མཛེས་པར་བྱའོ།",
    "འདིར་ཡང་ཟླུམས་སུ་ཇི་ལྟར་མཛེས་པར་རོ།",
    "ལྷག་མ་རྣམས་བཟོ་བོས་ཇི་ལྟར་མཛེས་པར་བྱའོ།",
    "དེ་རྣམས་ཀྱི་རྣམ་པར་དག་པ་ནི་མཆོད་རྟེན་བཞིན་དུའོ།",
    "དྲི་གཙང་ཁང་དང་ཁང་པ་བརྩེགས་པ་དང་འདུ་ཁང་རྣམས་ཀྱི་སྒོའི་རིང་དུའོ།",
    "དེ་ནས་སློབ་དཔོན་རྡོ་རྗེ་སེམས་དཔའི་རྣལ་འབྱོར་གྱི་བདག་ཉིད་ཀྱིས་ཤིང་སྲ་ཞིང་མཁྲེགས་པ་སྤོས་དཀར་གྱི་ཤིང་ལས་བྱས་པའི་རྒྱལ་མཚན་དང་རྗེས་སུ་མཐུན་པའི་སྲོག་ཤིང་མཆོད་རྟེན་གྱི་སྲོག་ཤིང་གནས་ལ་གསུངས་པའི་རིམ་པས་དགོད་པར་བྱ་སྟེ།",
    "གསེར་ལ་སོགས་པ་ལས་བྱས་པའི་རྒྱལ་མཚན་དགོད་པར་བྱའོ།",
    "ཏེ་ཥཱཉྩ་ཡོ་ནི་རོ་དྷ་ཨེ་ཝཾ་བཱ་དཱི་མ་ཧཱ་ཤྲ་མ་ཎ་ཞེས་པ་འདིས་རབ་ཏུ་གནས་པར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ཀྱི་གཟུངས་ཀྱིས་སོ།",
    "ཅེས་པ་འདིས་ལན་ཉི་ཤུ་རྩ་གཅིག་ཡོངས་སུ་བཟླས་པར་བྱའོ།",
    "འདིས་ལན་ཉི་ཤུ་རྩ་གཅིག་ཡོངས་སུ་བཟླས་པར་བྱའོ།",
    "འདིས་ལན་བདུན་དུ་ཡོངས་སུ་བཟླས་པར་བྱའོ།",
    "དྲི་གཙང་ཁང་དང་ཁང་མིག་དང་འདུ་ཁང་རྣམས་ཀྱི་ཤར་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་གཟུགས་ཀྱི་སྔགས་ལན་ཉི་ཤུ་རྩ་གཅིག་བཟླས་སོ།",
    "འདིས་དབུས་མ་ལན་བདུན་དུ་ལྷག་པར་གནས་པར་བྱས།",
    "ཡེ་དྷརྨཱ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པས་རབ་ཏུ་གནས་པར་བྱའོ།",
    "འདིས་ལན་བརྒྱ་རྩ་བརྒྱད་ཀྱིས་ལྷག་པར་གནས་པར་བྱས་ལ་གདུགས་རབ་ཏུ་གནས་པར་བྱའོ།",
    "ཞེས་པའི་སྔགས་ཀྱིས་ལན་བརྒྱ་རྩ་བརྒྱད་ལྷག་པར་གནས་པར་བྱའོ་ཞེས་པ་ནི་རྔ་ཡབ་རབ་ཏུ་གནས་པའོ།",
    "ཧཾ་ཡིག་ལས་བསྐྱེད་པའི་དང་པ་ལ་སོགས་པས་མཚན་པའི་དམ་ཚིག་སེམས་དཔར་བསྒོམས་ལ།",
    "འདིས་ལན་བརྒྱ་རྩ་བརྒྱད་ལྷག་པར་གནས་པར་བྱའོ་ཞེས་པ་ནི་རྒྱལ་མཚན་གྱི་རབ་ཏུ་གནས་པའོ།",
    "འདིས་ལན་བརྒྱ་རྩ་བརྒྱད་ཡོངས་སུ་བཟླས་པར་བྱའོ།",
    "ཞལ་ཟས་ལ་སོགས་པས་ཡང་དག་པར་མཆོད་ནས་འདིས་གསོལ་བ་གདབ་པར་བྱའོ།",
    "མགོན་པོ་ལེགས་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནས་སྔོན་དུ་གསུངས་པའི་རིམ་པས་སྦྱིན་སྲེག་བྱས་ནས་ཁྱུ་མཆོག་ཐག་པས་བཏགས་ནས་སྣོད་ལ་སོགས་པ་རྣམས་ཀྱིས་བསྐྱོད་པར་བྱའོ།",
    "གང་ཞིག་མཆོད་རྟེན་ལ་སོགས་པ་རྡོ་རྗེའི་རང་བཞིན་ཆག་པ་དང་གས་པ་དང་ཞིག་པ་མང་པོར་གྱུར་པ་དེ་རྣམས་གཙང་པོའི་ཆུ་ཆེན་པོ་ལ་ཟམ་པ་ལ་སོགས་པ་ནས་གཤེགས་པར་བྱའོ།",
    "གང་དུ་དེ་ཟངས་མ་ལ་སོགས་པའི་རང་བཞིན་དེ་ཡོངས་སུ་བཞུ་ནས་སྔོན་མའི་ཚད་པས་མ་ཆད་པར་བྱའོ།",
    "ད་ནི་དཀྱིལ་འཁོར་གཤེགས་སུ་གསོལ་བ་བརྗོད་པར་བྱ་སྟེ།",
    "རྒྱས་པ་རྣམ་པར་འཕེལ་བར་བྱ་བའི་ཕྱིར་མཐེ་བོང་གཡས་པ་ལག་པ་གཡོན་པས་བཟུང་ནས་རྫས་སོ་སོའི་དགང་བླུགས་ལན་གསུམ་མམ་བདུན་དུ་དབུལ་བར་བྱ་ཞིང་དབུལ་དུ་གཞུག་གོ།",
    "ཀ་ར་ལ་སོགས་པ་རྣམས་ཀྱིས་བསྲེས་ལ་བདུད་རྩི་རབ་ཏུ་བསྒྲུབ་པར་བྱ་སྟེ།",
    "ཆོ་གའི་བྱ་རྣམས་བཟོད་པར་མཛོད།",
    "དེ་ནས་སྒོ་རྣམས་དང་ཟུར་རྣམས་ཀྱང་ལག་པ་ལ་གནས་པའི་རྡོ་རྗེས་ཉེ་བར་བཤིག་པར་བྱའོ།",
    "ཞིབ་ལ་སོགས་པའི་དོན་དུ་སློང་བ་རྣམས་ལ་རྡུལ་ཚོན་ཅུང་ཟད་སྦྱིན་པར་བྱའོ།",
    "ཞེས་པ་འདིས་ཀླུ་རྣམས་བཀོད་ལ་ཡང་དག་པར་མཆོད་ནས།",
    "གང་དུ་རྡུལ་ཚོན་ཁྱེར་བའི་བུམ་པ་ཆུས་ཡོངས་སུ་བཀང་ནས་དེ་བཞིན་དུ་ཁྱེར་བར་བྱས་ནས་དེས་ཞི་བར་བྱ་བའི་དོན་དུ་དཀྱིལ་འཁོར་ཁང་པ་ལ་སོགས་པ་བསང་ཞིང་གཏོར་བར་བྱའོ།",
    "སོ་རྩི་ལ་སོགས་པ་རྣམས་ཀྱིས་མཉེས་པར་བྱའོ་ཞེས་པ་ནི་དཀྱིལ་འཁོར་གཤེགས་སུ་གསོལ་བའི་ཆོ་གའོ།",
    "ཞེས་པ་འདིས་སྙན་གསན་དབབ་པར་བགྱིའོ།",
    "པྲི་ཡང་ཀུ་དང་ཆ་མཉམ་པ་རྣམས་ནི་ཡང་དག་པར་བཏགས་ལ་དེ་རྣམས་ཀྱིས་བསྲེས་པའི་དྲི་མ་མེད་པའི་ཆུས་ཁྲུས་བྱའོ།",
    "རྒན་རིམས་བཞིན་དུ་གོ་རིམས་ཀྱིས་འཇུག་པར་བྱའོ།",
    "ཡོངས་སུ་བརྟགས་པའི་གདན་རྣམས་ལ་འཇུག་པར་བྱའོ།",
    "ཤའི་རྣམ་པ་རྣམས་ཡང་དག་པར་བསོགས་ནས།",
    "དེ་ནས་སྔགས་འདིས་གཏོར་མ་དགོད་པར་བྱ་སྟེ།",
    "ལྕགས་ཀྱུ་ལྷག་པར་གནས་པ་ཡང་བྱའོ།",
    "གུར་ཀུམ་གྱིས་རྣམ་པར་བྱུགས་ནས་མིག་དང་སིནྡྷཱུ་རས་རྣམ་པར་བརྒྱན་པར་བྱའོ།",
    "སླར་ཡང་ཆང་དེ་བཞིན་དུ་ལྷག་པར་གནས་པར་བྱའོ།",
    "ཨོཾ་ཨཱ་ཧཱུཾ་འདིས་ལྷག་པར་གནས་པར་བྱའོ།",
    "འདིས་ལྕགས་ཀྱུ་ལྔ་ལྷག་པར་གནས་པར་བྱའོ།",
    "རྣམ་པ་གཅིག་ཏུ་འཇུག་པར་གྱིས།",
    "ཚིགས་སུ་བཅད་པ་འདིས་པད་སྐོར་སྔོན་དུ་འགྲོ་བས་བླང་པར་བྱའོ།",
    "གནས་ལ་སོགས་པའི་ཕྱོགས་སུ་འཇུག་པས་རྣམ་པར་དག་པའི་ལུས།",
    "ལུས་ཀུན་རྟག་ཏུ་རྣམ་པར་མཛེས་པ་དཔའ་བོ་ཡིས།",
    "ཞེས་བརྗོད་ནས་ཇི་ལྟར་དགྱེས་པར་མཛད་དུ་གསོལ་ཞེས་བརྗོད་པར་བྱའོ།",
    "ཆང་ལ་སོགས་པ་རྣམས་ཀྱིས་ཡང་དག་པར་ཚིམ་པར་བྱའོ།",
    "དེ་ནས་ཨོཾ་ཤྲཱི་བཛྲི་གྷེཾ་ཧཱུཾ་ཞེས་པ་འདི་རྣམས་ཀྱི་ས་བོན་ལས་སྐྱེས་པ་ཁ་དོག་ཐམས་ཅད་པའི་ཡི་གེ་གསུམ་གྱི་སྔགས་ཀྱིས་ལན་བདུན་ཡོངས་སུ་བཟླས་ནས་རབ་ཏུ་སྤྱད་པར་བྱའོ།",
    "ལྷག་མའི་སྔགས་རྣམས་བརྗོད་པར་བྱའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཅིངས་ནས་ཁའི་ཟུར་དུ་མཆེ་བའི་རྣམ་པར་སྦྱར་བར་བྱའོ།",
    "དེ་བཞིན་དུ་ཕྱག་རྒྱ་བཅིངས་ནས་སྔགས་བརྗོད་པར་བྱ་སྟེ།",
    "ཆོ་གའི་བྱ་རྣམས་བཟོད་པར་མཛོད།",
    "ཅེས་པའི་ཚིགས་སུ་བཅད་པ་འདིས་བཟོད་པར་གསོལ་བར་བྱའོ།",
    "ཤིན་ཏུ་ལེགས་པར་རྣམ་པར་དག་པར་ཉེ་བར་བསྡུས།",
    "སྔོན་མེད་སྒྲ་ཡིས་ཤིན་ཏུ་ལེགས་པར་མ་གྱུར་ཀྱང་།",
    "དེ་ལྟ་ན་ཡང་བློ་ལྡན་མཁས་རྣམས་བཟོད་པར་གསོལ།",
    "དཀར་པོའི་ཕྱོགས་ཀྱི་ཚེས་བརྒྱད་ལ་གཞུའི་ཀུན་དགའ་ར་བའི་གཙུག་ལག་ཁང་ཆེན་པོར་ཡོངས་སུ་རྫོགས་པར་བསྒྱུར་ནས་བྲིས་སོ།",
    "མུ་ཁྱུད་གཉིས་དང་ལྡན་པར་བྱ་།",
    "ཉི་ཤུ་རྩ་ལྔ་ཤེས་པར་བྱ་།",
    "བསྐོར་ཐབས་སོ་སོར་ཤེས་པར་བྱའོ་།",
    "དྲག་པོའི་རྫས་ཀྱིས་བྲབ་པར་བྱ་།",
    "དང་པོར་རྣམ་པར་སྣང་མཛད་དེ་།",
    "དང་པོ་རྣམ་པར་སྣང་མཛད་གཞག།",
    "རྣམ་པ་གསུམ་དུ་ཤེས་པར་བྱ་།",
    "འཁོར་ལོ་དྲིལ་ལ་རབས་ཆད་ཐོད་པར་གཞུག།",
    "དཔངས་སུ་སོར་བཞི་བརྩིག་པར་བྱ་།",
    "མེ་དཔུང་འབར་བས་ཚིག་པར་བསམ་།",
    "མིང་རུས་ལྡན་པར་བྲི་བར་བྱ་།",
    "འབྲུབ་ཁུང་ནང་དུ་གཞུག་པར་བྱ་།",
    "དེ་བརྗོད་དྲག་པོས་བསྲེག་པར་བྱའོ་།",
    "གནམ་ལྕགས་འབབ་པར་ཐེ་ཚོམ་མེད་།",
    "ཧྲི་ལ་ཧྲི་ལ་ཤག་ཤག་སེན་སེན་ཕོབ་ཡ།",
    "མནྡལ་གཙང་མ་ཁྲུ་གང་ལ་།",
    "ལྷོ་རུ་གཡང་གཞི་དགོད་པར་བྱ་།",
    "མཐུན་པའི་དམ་རྫས་འདི་བཞེས་ལ་།",
    "གནག་པའི་ལས་འདི་གྲུབ་པར་མཛོད་།",
    "རྒྱལ་མཚན་གཡང་གཞི་བརྡབ་བྱས་ལ་།",
    "དེས་ན་ཐེ་ཚོམ་མེད་པར་འགྱུར་།",
    "རྟག་ཏུ་གཏོར་མ་སྦྱིན་པར་བྱ་།",
    "བྱང་ཞིང་ཆུབ་པར་བྱས་ནས་ཅིང་།",
    "ཁ་ཟས་རགས་པ་སྤང་བྱས་ཏེ།",
    "གདོན་དང་གྲིབ་ལ་འཛེམ་པར་བྱ་ འདི་ནི་ལག་ལེན་བསྡུས་པ་སྟེ།",
    "འབྱོངས་རྟགས་བཙིར་བ་མི་དགོས་པར།",
    "ཀ་བ་གཅིག་པས་འདྲེན་པར་བྱེད།་།",
    "མི་བསྐྱོད་རྒྱལ་པོ་བཞུགས་པར་གྱུར།",
    "ཞིབ་བཏགས་ཆུ་ལ་སྦྱར་བྱས་ནས།",
    "ཉམས་ཁྲིད་བསྐྱངས་པའི་ཞལ་གདམས་སྒོ་འབྱེད་རྣམས་བསྟན་པར་བྱའོ།",
