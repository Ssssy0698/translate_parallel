    "སློབ་པའི་སེམས་དང་ཤེས་རབ་རྣམ་པར་གྲོལ་བ་མ་ཐོབ་པ་དང་།",
    "དེས་ཐོབ་ཏུ་ཟིན་ན་ཡང་གོང་དུ་མི་སློབ་པའི་སེམས་དང་ཤེས་རབ་རྣམ་པར་གྲོལ་བ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་མི་ཤེས་ལ།",
    "ཤེས་རབ་རྣམ་པར་གྲོལ་བ་ཡོངས་སུ་རྫོགས་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལས་བཟློག་པ་ནི་དཀར་པོའི་ཕྱོགས་ཀྱིས་སྒོ་བསྡམས་པར་རིག་པར་བྱའོ།",
    "དོན་རབ་ཏུ་དབྱེ་བའི་སྒོ་ནས་རྣམ་པ་གཉིས་ཀྱིས་སྟོན་པས་གསུངས་པ་ཡང་དག་པ་ཁོ་ནར་བརྡ་སྤྲོད་ཅིང་སྟོན་པར་བྱེད་དེ།",
    "གང་ཁོ་ན་ལ་དགོངས་ཏེ་གསུངས་པའི་དགོངས་པ་དེའི་ཐོག་ཏུ་ཕེབས་པར་བརྡ་སྤྲོད་པ་དང་།",
    "ངན་དོན་ཙམ་གྱིས་ཆོག་ཤེས་པ་དང་སོགས་པར་བྱེད་པའི་འདོད་པའི་ལོངས་སྤྱོད་སྤངས་པ་དང་།",
    "འཁྲིག་པའི་འདོད་ཆགས་མ་སྐྱེས་པ་ནི་སྐྱེད་པར་མི་བྱེད་པ་དང་།",
    "འཇུག་པར་བྱ་བ་མ་ཡིན་པའི་འདུ་ཤེས་ཡིད་ལ་བྱེད་པ་དང་།",
    "ཡུན་རིང་པོར་འདྲིས་པར་བྱས་པས་ནི་དྲན་པ་ལེགས་པར་གནས་པ་ཡིན་ནོ།",
    "དེ་དེའི་ཚེ་ཆགས་པར་འགྱུར་བའི་དངོས་པོ་ལ་འདོད་པའི་རྟོག་པས་རྟེན་པར་མི་བྱེད་ལ་གཞན་ལ་ཡང་གནོད་སེམས་དང་འཚེ་བའི་རྟོག་པས་གནོད་པར་མི་བྱེད་དོ།",
    "ཚེ་འདི་ལ་ཡང་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་དེ་ནི་འདི་ལས་ཕྱི་རོལ་བའི་མུ་སྟེགས་ཅན་རྣམས་ལྟར་གཏི་མུག་ལས་སྐྱེས་པའི་རྟོག་པ་ལ་ཡང་རྟོག་པར་མི་བྱེད་དོ།",
    "དེ་དེའི་ཚེ་ན་ཕྱི་མ་ལ་ཡང་སྲིད་པར་སྐྱེ་བར་འགྱུར་བའི་སྡུག་བསྔལ་གྱི་རྒྱུ་འདུན་པས་ཀྱང་ལྷག་པར་བཅོམ་པར་འགྱུར་ཏེ།",
    "ཚེ་འདི་ལ་མྱ་ངན་ལས་འདའ་བ་ལ་བར་དུ་གཅོད་པར་བྱེད་པ་དང་།",
    "དེའི་ཡང་སྲིད་པར་སྐྱེ་བར་སྨོན་པ་དེ་ནི་འཆིང་བ་ཆ་ཕྲ་ཞིང་མཆོག་ཏུ་ཆ་ཕྲ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དགེ་སློང་ཡང་སྲིད་པར་སྐྱེ་བའི་སེམས་ཀྱི་སྨོན་པར་བྱེད་པའི་སེམས་བསྐྱེད་མ་ཐག་ཏུ་ཡང་བཅིང་བར་འགྱུར་ལ་བཅིངས་ནས་ཀྱང་བདག་ཉིད་བཅིངས་སོ་སྙམ་དུ་ཁོང་དུ་མི་ཆུད་དེ།",
    "དེ་བས་དེའི་བཅིང་བ་ནི་དུས་ཆ་ཕྲ་བའི་སྒོ་ནས་ཀྱང་རྟོགས་པར་དཀའ་ལ་མཆོག་ཏུ་ཆ་ཕྲ་བའི་སྒོ་ནས་ཀྱང་མཆོག་ཏུ་ཆ་ཕྲ་བར་རིག་པར་བྱའོ།",
    "སྡོམ་པ་མ་ཡིན་པ་ཡང་རིག་པར་བྱའོ།",
    "ཆེན་པོ་ཡང་རིག་པར་བྱའོ།",
    "སློབ་པ་དང་མི་སློབ་པའི་སྡོམ་པ་ཡང་རིག་པར་བྱའོ།",
    "ཡང་དག་པར་ངེས་པར་བྱེད་པ་དང་།",
    "ལེགས་པར་ཚར་གཅོད་པ་དང་།",
    "སྐྱེས་ཟིན་པ་ཡང་སྤོང་པར་བྱེད་པའོ།",
    "གཞན་ཡང་འདི་ན་ཁ་ཅིག་མྱུར་བ་ཁོ་ནར་ཡིད་ལ་བྱས་ནས་ཡུལ་རྣམས་གཏོང་བར་ནི་བྱེད་ན།",
    "གཞན་ཡང་འདི་ན་ཁ་ཅིག་མྱུར་བ་ཁོ་ནར་ཡང་ཡིད་ལ་བྱས་ནས་ཡུལ་རྣམས་གཏོང་བར་བྱེད་ལ།",
    "དེ་ལ་བརྟེན་ན་སེམས་གནས་པ་རྣམ་པ་དགུ་པོ་ཡིད་ལ་བྱེད་པ་རྣམ་པ་བཞིས་བསྡུས་པ་རྣམས་ཐོབ་པར་འགྱུར་ཏེ།",
    "སྡོམ་པ་ལ་ཞུགས་པའི་རྣལ་འབྱོར་བ་སྔར་ནི་ཞིང་པ་ལྟ་བུར་གྱུར་ལ་ད་ནི་བདག་པར་གྱུར་བས་རྒྱལ་པོ་ལྟ་བུ་ཡིན་ནོ།",
    "དེ་ལ་སྙོམས་པར་འཇུག་པ་ལ་བརྟེན་པའི་བྱེ་བྲག་ནི་འདི་ལྟ་སྟེ།",
    "ཉམས་པར་འགྱུར་བ་དང་།",
    "ཁྱད་པར་དུ་འགྲོ་བ་དང་།",
    "པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་སྟེ།",
    "དེའི་གོང་ན་ཁྱད་པར་དུ་འཕགས་པའི་སྡོམ་པ་ཆེས་ལྷག་པར་དང་ཆེས་བཟང་བ་གཞན་མེད་དོ།",
    "དེ་འདིའི་སྡུག་བསྔལ་གྱི་སྒོ་ནས་གཅིག་ཏུ་ངེས་པར་སྡུག་བསྔལ་བར་འགྱུར་རོ།",
    "མ་ལྟ་བུ་ཆགས་པར་འགྱུར་བའི་ཡུལ་རྣམས་ཀྱིས་ཕྱི་མ་ལ་ཡང་སྲིད་པར་སྐྱེ་བའི་སྡུག་བསྔལ་ཆ་ཕྲ་བ་དང་ལྡན་པ་ཡོངས་སུ་བཟུང་བས་དེའི་ལུས་རྣམ་པར་གཅོད་པར་བྱེད་པ་དེས་ནི་ཁོང་དུ་མི་ཆུད་དེ་དེ་ལྟར་ན་ཚེ་ཕྱི་མའི་སྡུག་བསྔལ་བས་སྡུག་བསྔལ་བར་འགྱུར་རོ།",
    "མ་དད་པ་རྣམས་མ་དད་པར་འགྱུར་བར་བྱེད་པའོ་ཞེས་རྣམ་པར་སྨོད་དོ།",
    "དང་མཐུན་ཞིང་དེ་དང་མཚུངས་པར་ལྡན་པའི་རྟོག་པ་དང་།",
    "བསྒོམས་པའི་སྟོབས་ཀྱིས་གཉེན་པོ་ལ་མི་ཕྱོགས་པ་འདི་ནི་སྡོམ་པ་མ་ཡིན་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ལས་བཟློག་པ་ནི་སྡོམ་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "བཟུང་ནས་ཀྱང་ཚུལ་བཞིན་དུ་སེམས་པས་ཐོབ་པའི་ནི་འོག་བསྒོམས་པའི་སྔ་རོལ་གྱི་བར་སྐབས་སུ་ཉེས་དམིགས་ཡང་དག་པར་དཔྱད་པའི་ཚུལ་གྱིས་སྡོམ་པར་བྱེད་དོ།",
    "ཉེས་དམིགས་ལེགས་པར་མཐོང་བའི་ཕྱིར་གཅིག་ཏུ་ངེས་པར་འབྲོས་ཀྱང་མི་ནུས་ན་ནི་དེ་དག་ད་དུང་ལེགས་པར་དུལ་བར་མ་གྱུར་བ་དང་།",
    "དེ་ལེགས་པར་བསྒོམས་པས་སོ་སོའི་ཡུལ་ལ་འཕྲོ་བར་མི་འགྱུར་ཏེ་ལེགས་པར་དུལ་བ་དང་།",
    "བྱེད་རྣམས་ཀྱི་ཉེས་དམིགས་རྣམ་པ་གསུམ་ཉན་པར་བྱེད་དེ།",
    "བདེན་པ་རྣམས་ཁོང་དུ་ཆུད་པར་འགྱུར་རོ།",
    "དེ་ནས་བདག་མེད་པ་ཤེས་པ་ཤིན་ཏུ་རྣམ་པར་དག་པས་ཁང་སྟོང་དུ་ཞུགས་པ་བཞིན་དུ་ནང་དང་ཕྱི་རོལ་གྱི་སྐྱེ་མཆེད་རྣམས་སྟོང་པ་ཉིད་དུ་མངོན་སུམ་དུ་བྱེད་དོ།",
    "ལྷག་མ་དང་བཅས་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་སུ་གནས་པ་ཐོབ་པར་འགྱུར་ཏེ།",
    "གནས་པ་ཐམས་ཅད་ལས་ཀྱང་ཡོངས་སུ་ཐར་བར་འགྱུར་ལ་དེ་ལ་གནས་ན་མཐར་ཐུག་ཅིང་སྡུག་བསྔལ་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པར་རིག་པར་བྱའོ།",
    "དེ་བོས་ན་སྲེད་པས་འགྲོ་བ་དང་ཆགས་པར་འགྱུར་བ་དང་།",
    "དེ་ངའོ་སྙམ་པའི་ང་རྒྱལ་ཙམ་ཞིག་ལུས་ལ་ཅུང་ཟད་སྲིད་པ་དང་ལྡན་པ་ལྷག་པར་བཏང་སྙོམས་སུ་བྱས་པས་བག་མེད་པར་གནས་པ་འདི་ནི་ཀུན་དུ་ཆགས་པའི་གནས་བཞི་བའོ།",
    "ལོག་པར་སྒྲུབ་པ་བཞི་གང་ཞེ་ན།",
    "དང་པོ་སྟེ་ཡང་སྲིད་པར་སྐྱེ་བར་འདོད་ཀྱི་ཚེ་འདི་ལ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་འགྱུར་བ་མི་འདོད་པའི་གང་ཟག་གང་ཡིན་པ་དང་།",
    "བསླབ་པ་ཕུལ་ནས་ཉམས་པར་འགྱུར་བ་འདི་ནི་ལོག་པར་སྒྲུབ་པར་གསུམ་པའོ།",
    "གནས་ཀྱི་རྒྱུ་ཡང་དག་པར་ཤེས་པ་དང་།",
    "དེ་བཞིན་དུ་གནས་པའི་རྒྱུ་ཡང་དག་པར་ཤེས་པ་དང་།",
    "ངེས་པའི་ཚིག་ཐ་དད་པ་སྟོན་པར་མཛད་ཀྱི་དོན་ཐ་དད་པ་ནི་མ་ཡིན་ནོ།",
    "རྩྭ་སྐམ་པོའི་ཁྱིམ་དང་འདྲ་སྟེ་དེར་བདུད་ཀྱིས་ཆགས་པར་འགྱུར་བའི་ཡུལ་གྱི་མེའི་རྩྭའི་མགྱོགས་མེ་བཏང་ན་གནས་ཐོབ་པར་འགྱུར་ཏེ།",
    "སྐྱེས་ཟིན་པ་རྒྱུན་དུ་གནས་པར་བྱེད་པའི་རྒྱུ་གཉིས་ཀྱིས་ཡུལ་རྣམས་ཀྱིས་ཟིལ་གྱིས་ནོན་པར་འགྱུར་རོ།",
    "ལོག་པར་བསྒྲུབ་པ་ནི་ལམ་ལོག་པར་འགྲོ་བ་ཡིན་ཏེ།",
    "རྒྱུན་ལོག་པར་ཞུགས་པ་ལ་ནི་རྒྱུན་ལོག་པ་ཞེས་བྱའོ།",
    "དེ་ལས་བཟློག་པའི་དཀར་པོའི་ཕྱོགས་ནི་རྒྱུན་མ་ལོག་པར་རིག་པར་བྱའོ།",
    "ཡང་དག་པར་རྩོམ་པ་དང་འཇིག་རྟེན་པའི་ཡང་དག་པའི་ལྟ་བ་རྒྱ་ཆེན་པོ་ལེགས་པར་བསྒོམས་པ་མངོན་སུམ་དུ་བྱེད་པ་དང་།",
    "སྟེང་ན་ནི་འཇིག་རྟེན་པའི་ཤེས་རབ་ཀྱི་མིག་ཡོངས་སུ་རྫོགས་ཀྱང་འཕགས་པའི་ཤེས་རབ་ཀྱི་མིག་མེད་པས་མུན་པ་མུན་ནག་ཏུ་གྱུར་བར་ཡང་དག་པར་མཐོང་སྟེ།",
    "བདག་ནི་ཕྱིར་ལྡོག་པར་མི་བྱའོ།",
    "འཆི་བའི་བརྟགས་པ་དེ་འབའ་ཞིག་ལམ་ཡིན་པར་འཛིན་ཅིང་དེ་ཉིད་ལ་བདེན་པའི་རྣམ་པར་བརྟག་པར་རྩོམ་སྟེ།",
    "རྒ་བ་དང་འཆི་བ་འགག་པར་འགྱུར་བའི་ལམ་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པ་ལ་བརྟེན་པ་དང་།",
    "པས་ཡུན་རིང་པོ་ནས་འདྲིས་པར་བྱས་པའི་འཇིག་རྟེན་པའི་ཡང་དག་པའི་ལྟ་བ་གང་ཡིན་པ་དེ་བསྒོམས་ནས་དེ་སྔོན་གྱི་གནས་རྗེས་སུ་དྲན་པའི་ཤེས་པས་མངོན་སུམ་དུ་བྱེད་དེ།",
    "འདི་ནི་དེའི་ཡང་དག་པའི་ལྟ་བ་རྒྱ་ཆེན་པོ་ལེགས་པར་བསྒོམས་པ་མངོན་སུམ་དུ་བྱེད་པ་ཞེས་བྱའོ།",
    "མན་ཆད་སྨོས་པས་ནི་སྔ་མ་ཐམས་ཅད་ཀྱང་རྟོགས་པར་བྱས་པ་ཡིན་ནོ།",
    "སྙོམས་པར་འཇུག་པ་རྣམས་དང་།",
    "གནས་ཡིན་པར་རིག་པར་བྱའོ།",
    "རྨོངས་པར་བྱེད་པའི་བདག་ཉིད་ཡིན་པས་ན།",
    "ཚུལ་དང་རྒྱུ་ཚུལ་བཞིན་དུ་གདགས་པར་བྱས་པ་ཡིན་ནོ།",
    "གདགས་སུ་མི་རུང་ན་དོན་དམ་པར་ལྟ་ཅི་སྨོས་ཏེ།",
    "དེ་བས་ན་གཅིག་ཏུ་ངེས་པར་སྟོང་པ་རྣམས་ལ་སྟོང་ངོ་སྙམ་པ་ཁོ་ནར་སེམས་ལ་ཚུལ་བཞིན་དུ་ཐོས་པ་བརྡ་སྤྲད་པ་དང་།",
    "བསྒོམས་པས་ངེས་པར་རྟོག་ཏུ་གཞུག་པས་གོ་རིམས་བཞིན་དུ་མགུ་བར་བྱ་ཞིང་ཡང་དག་པར་མགུ་བར་བྱ་སྟེ་ཡོངས་སུ་མགུ་བར་བྱའོ།",
    "བདག་མེད་པར་ནི་སྨྲ་བ་དང་།",
    "འདོད་ཆགས་བཏང་སྙོམས་སུ་བྱས་པ་མ་ཡིན་པའོ།",
    "ཁ་ཟས་ཀྱི་ཚོད་ཟིན་པ་དང་སྲོད་དང་ཐོ་རངས་ལ་མི་ཉལ་བ་ལ་བརྟེན་ནས་བདག་ཉིད་ངལ་བར་བྱེད་པའི་མཐའ་རྣམ་པར་སྤོང་བ་དང་།",
    "འགག་པ་ཡང་དག་པར་ཇི་ལྟ་བ་བཞིན་དུ་རྟོགས་པ་གང་ཡིན་པའམ།",
    "གཞན་ཡང་དྲན་པ་དང་ཤེས་བཞིན་དམ་པ་ནི་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ཐོབ་པ་དང་།",
    "ལྷའི་གནས་ལ་བརྟེན་ནས་དྲན་པ་དང་ཤེས་བཞིན་དམ་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "དེ་ལ་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ལས་ལྡང་བའི་ཚེ་དང་།",
    "སྙོམས་པར་གཞུག་པའི་ཚོར་བ་རྣམས་སྐྱེ་བ་དང་།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པའི་ཚོར་བ་རྣམས་ཇི་ལྟ་བ་བཞིན་དུ་མཚན་མ་མེད་པའི་སྙོམས་པར་འཇུག་པའི་འདུ་ཤེས་རྣམས་དང་།",
    "རྟོག་པ་མེད་ཅིང་དཔྱོད་པ་མེད་པའི་སྙོམས་པར་འཇུག་པའི་རྟོག་པ་རྣམས་དེ་དང་འདྲའོ།",
    "དེ་ནི་དྲན་པ་དང་ཤེས་བཞིན་པར་ཡང་མི་འགྱུར་ན་དམ་པར་ལྟ་ག་ལ་འགྱུར།",
    "དེ་ལ་དྲན་པ་དང་ཤེས་པ་བཞིན་དམ་པ་ཕྱི་མ་ཤོས་ནི་ཕྱིར་མི་འོང་བའམ་དགྲ་བཅོམ་པའི་ཡིན་པར་རིག་པར་བྱའོ།",
    "རྣམ་པར་གཏན་ལ་འབེབས་པའི་གཏམ་དང་།",
    "དེ་ལ་རྣམ་པར་གཏན་ལ་འབེབས་པའི་གཏམ་འདྲི་བའི་ཚུལ་གྱིས་ཐེ་ཚོམ་བསལ་བ་གང་ཡིན་པའོ།",
    "གདམས་ངག་རྗེས་སུ་བསྟན་པ་ནི་རྣམ་པ་བཞིས་མཐུན་པར་བྱེད་པ་ཞེས་བྱ་སྟེ།",
    "མ་འོངས་པའི་སྡུག་བསྔལ་ལས་ཡང་དག་པར་འདའ་བར་བྱ་བའི་ལྟ་བ་རྣམ་པ་དག་པ་དང་།",
    "ད་ལྟར་བྱུང་བའི་སྡུག་བསྔལ་ལས་ཡང་དག་པར་འདའ་བར་བྱ་བའི་ལྟ་བ་རྣམ་པར་དག་པའོ།",
    "རྣམ་པར་ཤེས་པ་དང་།",
