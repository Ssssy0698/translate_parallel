    "ལོག་པར་ཞུགས་ལ་གཏན་དུ་མ་ཡིན་པ་ཡང་ཡོད་དོ།",
    "དེའི་ནང་ནས་ཁ་ཅིག་ནི་ཡང་དག་པར་ཞུགས།",
    "ལོག་པར་སྒྲུབ་པའམ།",
    "དེ་ལ་དེ་བཞིན་གཤེགས་པ་ནི་རྣམ་པ་ལྔར་བསྒྱུར་བ་ཐམས་ཅད་དུ་ཅི་རིགས་པར་གཉེན་པོ་རྣམ་པ་གསུམ་ཐུགས་ལ་དགོངས་ཏེ།",
    "དེ་ཡང་ཅི་རིགས་པར་རིག་པར་བྱའོ།",
    "གཅིག་ཏུ་ངེས་པར་འདོད་པ་མ་ཡིན་པའམ།",
    "གཏི་མུག་དང་བྲལ་བའི་ཕྱིར་སེམས་རྣམ་པར་གྲོལ་བ་དང་།",
    "ཤེས་རབ་རྣམ་པར་གྲོལ་བའི་སྒོ་ནས་མྱུར་བ་མྱུར་བར་མཚན་མ་མེད་པས་དེ་ལས་སེམས་ལྷག་པར་བཏང་སྙོམས་སུ་བྱེད་དེ།",
    "སེམས་ཐག་པ་ནས་ཡུལ་ལ་ནི་མི་མཐུན་པར་འདུ་ཤེས་ལ་མྱ་ངན་ལས་འདས་པ་ལ་ནི་ཞི་བར་ལྟའོ།",
    "དེ་བས་ན་ཡང་དག་པར་ཞུགས་པ་ཞེས་བྱའོ།",
    "དག་པར་ནན་ཏན་དུ་སྒྲུབ་པའི་སྒོ་ནས་ཀྱང་མཛེས་སོ།",
    "བདག་མེད་པར་སྨྲ་བ་སྟོན་པའི་སྒོ་ནས་ཡང་དག་པའི་ལས་སུ་བྱ་བ་གསུམ་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ལས་བཟློག་པ་ནི་རྣམ་པར་བྱང་བ་ཡང་དག་པར་མཐོང་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "གཞན་ཡང་འདུ་བྱེད་རྣམས་ལ་བདག་ཏུ་སྒྲོ་འདོགས་པའི་བདག་ཏུ་ལྟ་བ་ཡང་སྤངས་ལ་བདེན་པ་འཛིན་པའི་བདག་མེད་པར་ལྟ་བ་ལ་བརྟེན་ནས་ཇི་ལྟར་རྣམ་པར་བྱང་བར་འགྱུར་བ་དེ་གླེང་བར་བྱའོ།",
    "དེའི་གོང་དུ་མི་སློབ་པར་གྱུར་བའི་ཟད་པ་དང་མི་སྐྱེ་བའི་ཡེ་ཤེས་ཀྱང་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་བས་འདི་ནི་བདག་མེད་པར་ལྟ་བ་དེའི་རྣམ་པར་བྱང་བར་འགྱུར་བ་གླེང་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདི་ནི་ཡང་དག་པའི་སྦྱོར་བའི་འབྲས་བུའི་ཕན་ཡོན་གྱི་ཁྱད་པར་དང་པོ་ཡིན་པར་རིག་པར་བྱའོ།",
    "གཞན་ཡང་མཉམ་པར་མ་བཞག་པའི་གང་ཟག་སྔ་མ་ཤོས་ཀྱིས་ནི་ཚོར་བརྟེན་དང་བཅས་དམིགས་པ་དང་བཅས་གྲོགས་དང་བཅས་འགྱུར་བ་དང་བཅས་པ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་མི་ཤེས་ཏེ།",
    "སྐྱེ་བར་འགྱུར་བའི་ཕྱིར་ཡང་སྲིད་པར་སྐྱེ་བའི་ཕུང་པོ་ཡང་ཉེ་བར་སོགས་ལ་སྲིད་པ་སྟེ་ཡང་སྲིད་པར་སྐྱེ་བའི་སྲིད་པ་དང་།",
    "སེམས་མཉམ་པར་གཞག་པའི་གང་ཟག་ཅིག་ཤོས་ནི་དེ་ལས་བཟློག་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "གཞན་ཡང་གང་ཟག་སྔ་མ་ཤོས་ནི་སེམས་མཉམ་པར་མ་བཞག་པས་བདག་དང་གཞན་རྣམས་ཀྱི་མི་ཤེས་པ་ལས་གྱུར་བའི་ཉེས་དམིགས་ཏེ།",
    "ཅིག་ཤོས་ནི་སེམས་མཉམ་པར་བཞག་པས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་སོ།",
    "དེས་དེ་ལྟར་ཞི་གནས་དང་ལྷག་མཐོང་ཐོབ་པ་དེས་སྤོང་བའི་ཁམས་སུ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་ནི་ཡོངས་སུ་ཤེས།",
    "མངོན་སུམ་དུ་བྱས་པ་དང་།",
    "བསྒོམས་ཟིན་པར་གྱུར་ཏེ་གཟུགས་ཏེ་རྟེན་དང་།",
    "ཡོངས་སུ་ཤེས་པར་འགྱུར་རོ།",
    "སྤངས་པར་གྱུར་ཏོ།",
    "རིག་པ་རྣམ་པར་དག་པའི་ཤེས་པ་སྟེ་རྟེན་དང་།",
    "མངོན་སུམ་དུ་བྱས་པར་གྱུར་ཏོ།",
    "བསྒོམས་པར་གྱུར་ཏོ།",
    "རྣམ་པ་གསུམ་པོ་འདི་དག་ནི་མི་རྟག་པ་ཉིད་ལས་གྱུར་བའི་སྡུག་བསྔལ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ལ་དེ་བཞིན་གཤེགས་པ་ནི་ཉེས་དམིགས་དེ་གཉིས་ལས་འདའ་བས་ན་གཅིག་ཏུ་ངེས་པར་བདེ་བ་ལ་གནས་པ་ཡིན་ནོ།",
    "དེ་ལ་བདེ་བ་དེ་ཡང་རིག་པར་བྱ་སྟེ།",
    "བདེ་བ་དེའི་ཐབས་ཀྱང་རིག་པར་བྱའོ།",
    "དེ་ལ་ཉན་ཐོས་གང་སྟོན་པའི་བདེ་བ་ལྷ་དང་མིའི་ལས་ཡང་དག་པར་འདས་པ་བོར་ཏེ།",
    "ལྷ་དང་མིའི་བདེ་བ་ངན་པ་འདོད་པ་དེ་ནི་དམ་པ་རྣམས་ཀྱིས་ཀྱང་སྨད་པར་འགྱུར་ལ།",
    "བདག་ཉིད་ཀྱང་བསླུས་པར་འགྱུར་རོ།",
    "ཀུན་མཁྱེན་དང་ནི་དེ་མཚན་དབྱེ།",
    "རྒྱུ་གཉིས་ཀྱིས་ཟླ་དང་བཅས་ཏེ་གནས་པར་རིག་པར་བྱ་སྟེ།",
    "ཉེ་བར་སྤྱོད་པའི་ཚེ་ཡང་ལྷག་པར་ཞེན་ཅིང་ཀུན་དུ་ཆགས་པར་འགྱུར་ཏེ་དེ་བས་ན་སྲེད་པ་དང་བཅས་པ་ཞེས་བྱའོ།",
    "དེ་ལས་བཟློག་པ་ནི་ཟླ་མེད་པར་གནས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "མ་བརྟགས་པར་བྱེད་པ་དང་།",
    "དད་པ་རྣམས་ནི་ཕྱིར་ཞིང་དད་པར་བྱ་བ་ལ་ཞུགས་པ་ཡིན་ནོ།",
    "དེ་ལ་བཟོད་པ་ནི་གཞན་དག་ལ་ལན་དུ་གནོད་པར་བྱེད་པས་ཉེ་བར་མི་གནས་པའོ།",
    "ཡོད་པ་དང་མེད་པའི་དངོས་པོ་བདེན་པར་རྟོགས་པ་དང་།",
    "དེ་བས་ན་དེ་བཞིན་གཤེགས་པ་ནི་ཉན་ཐོས་རྣམས་མཚན་ཉིད་ངེས་པ་ལ་འཇུག་པར་མཛད་པའི་ཕྱིར་རྣམ་པར་དབྱེ་བར་མཛད་དེ།",
    "མཚན་ཉིད་ཀྱི་དེ་ཉིད་ཤེས་པ་རྣམས་ནི་བདག་ཀྱང་བསླུས་པར་མི་འགྱུར་ལ།",
    "གཞན་དག་ལ་ཡང་བག་ཚ་བ་མེད་པར་སྟོན་པར་འགྱུར་རོ།",
    "རབ་ཏུ་བྱུང་བའི་བསླབ་པ་འབུལ་བའི་སྒོ་ནས་ནི་ཡུལ་ལ་ལྟ་བ་རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "ངོ་ཚ་ཤེས་པ་དང་ཁྲེལ་ཡོད་པ་དང་བྲལ་བས་གཅིག་ཏུ་ངེས་པར་རོ་མྱང་བས་བཟུང་ཞིང་དམིགས་པའི་ཡུལ་གང་ཡིན་པ་དེ་ནི་རོ་མྱང་བ་ལྷུར་ལེན་པ་ཞེས་བྱའོ།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་མི་ཤེས་ན་འདོད་པར་འགྱུར་རོ།",
    "འདོད་པར་གྱུར་ན་དེ་དང་ལྡན་པའི་ལས་བྱེད་ཅིང་སོགས་སོ།",
    "དེ་བཞིན་དུ་སྲེད་པ་ལ་སོགས་པ་ཡང་ལས་ལ་སོགས་པ་དང་ཅི་རིགས་པར་སྦྱར་བར་རིག་པར་བྱའོ།",
    "ཡང་སྲིད་པར་སྐྱེ་བ་ནི་ཡང་སྲིད་པར་སྐྱེ་བའི་ལས་དང་།",
    "དེར་སྡུག་པའི་རྣམ་པར་སྨིན་པ་འཕེན་ཅིང་།",
    "དེ་ནི་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་རྣམ་པར་སྨིན་པ་མེད་པ་ཁོ་ནའོ།",
    "དེ་ཡང་རྣམ་པ་བདུན་དུ་རིག་པར་བྱ་སྟེ།",
    "དེ་བས་ན་སྐྱེ་བའི་ཚེ་གང་ནས་ཀྱང་མི་འོང་ལ་མེད་པ་ལས་ཡོད་པར་ཡང་འགྱུར་བ་འདི་ནི་ཕྱི་མའི་མཐའ་སྟོང་པ་ཉིད་དེ།",
    "དེར་འདུ་བྱེད་སྐྱེས་ནས་འགག་པ་རྣམས་སོགས་པར་འགྱུར་བ་མེད་དེ།",
    "བདག་སྟོང་པ་ཉིད་དུ་རིག་པར་བྱའོ།",
    "ཡིད་བདེ་བ་དང་མཐུན་པའི་ཡུལ་ལ་ནི་རྣམ་པ་ལྔས་ཉེ་བར་སྤྱོད་ཅིང་ཀུན་དུ་ཆགས་ཏེ་ཚུལ་བཞིན་མ་ཡིན་པའི་མཚན་མ་འཛིན་པར་བྱེད་དོ།",
    "ལན་མང་དུ་རྗེས་སུ་རྟོག་པར་བྱེད་དོ།",
    "བཏང་སྙོམས་དང་མཐུན་པ་ལ་ཡང་ཅི་རིགས་པར་སྦྱར་བར་རིག་པར་བྱའོ།",
    "དེ་ལ་ཁྱད་པར་ནི་འདི་ཡོད་དེ་ཡིད་མི་བདེ་བ་དང་མཐུན་པ་རྣམས་ལ་ནི་གནོད་སེམས་སུ་འགྱུར་རོ།",
    "བཏང་སྙོམས་དང་མཐུན་པ་རྣམས་ལ་ནི་རྨོངས་པར་འགྱུར་རོ།",
    "རྟག་ཏུ་གནས་པར་བྱ་བ་དེ་དག་ནི་དཀའ་བ་དང་།",
    "ཡོན་གནས་ཀྱི་མཆོག་ཡིན་པར་རིག་པར་བྱ་བ་ནས་སྤྱན་དྲང་བའི་འོས་ཡིན་པའི་བར་དུ་རྒྱས་པར་སྦྱར་ཏེ།",
    "ཉན་ཐོས་རྣམས་ཀྱི་ཉན་ཐོས་ཕུན་སུམ་ཚོགས་པ་ཡང་རྣམ་པ་གཉིས་ཀྱིས་རིག་པར་བྱའོ།",
    "གཞན་ལ་ཕན་པ་བསྒྲུབ་པའི་སྒོ་ནས་ཚོར་བ་གང་ཅི་ཡང་རུང་བའི་འདི་དག་འདིར་སྡུག་བསྔལ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་འཇུག་པར་བྱ་བའི་ཕྱིར་ཚོར་བ་རྣམས་ཀྱི་རྟེན་བསྟན་པ་དང་།",
    "སྟོན་པའི་རྟགས་མི་མཐུན་པའི་ཕྱོགས་དང་གཉེན་པོ་རྣམ་པར་གཞག་པ་བསྟན་པ་དང་།",
    "ཉན་ཐོས་ཀྱི་ཉན་ཐོས་ཕུན་སུམ་ཚོགས་པ་ཡང་རྣམ་པ་གཉིས་ཀྱིས་རིག་པར་བྱའོ།",
    "སྟོན་པ་ཕུན་སུམ་ཚོགས་པ་རྣམ་པ་གསུམ་གྱིས་རིག་པར་བྱ་བ་གང་ཞེ་ན།",
    "ལོག་པར་ཞུགས་པ་རྣམས་བསྟན་པ་འདི་ལ་ཐབས་ལེགས་པར་འཇུག་པར་མཛད་པ་འདི་ནི་ཕུན་སུམ་ཚོགས་པ་གཉིས་པའོ།",
    "དེ་ལྟ་བ་རུང་བར་བྱས་པ་ལ་ཞུགས་ནས།",
    "གཞི་བསྡུ་བ་ལས་སྐྱེ་མཆེད་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་ཞེས་བྱ་བ་སྟེ་བསྡུ་བ་གཉིས་པ་རྫོགས་སོ།",
    "རྣམ་པར་གཞག་པར་བྱ་བ་དང་།",
    "རྣམ་པར་གཞག་པར་བྱ་བ་དང་།",
    "དུ་རྣམ་པར་གཞག་པར་བྱ་སྟེ།"
