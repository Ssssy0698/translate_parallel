    "བུ་དཔའ་བོའི་དཔའ་སྐད་དི་རིར་གདའ།",
    "ཁྲུས་བྱེད་པའི་གླགས་དང་བསྟུན་ནས་ཁོང་རང་སྦྲང་མར་སྤྲུལ་ཏེ།",
    "དེ་ལས་གཞན་ད་དུང་གཏམ་རྒྱུད་འདི་འདྲ་ཞིག་ཀྱང་བཀོད་འདུག་སྟེ།",
    "འདིས་སྒྲུང་གཏམ་གྱི་རིན་ཐང་དང་ཉམས་འགྱུར་ལྡབ་འགྱུར་གྱིས་ཇེ་ལེགས་སུ་བཏང་འདུག་གོདུད་འགྲོ་རྟ་དང་འདབ་ཆགས་བྱ་སོགས་ཀྱི་སྤྲུལ་གཉིས་པ།",
    "བྱ་འདི་འདྲ་ཧོར་ལ་གདའ་ལེ་ཡིན།",
    "ནག་པོ་སྒོ་གཅིག་གདའ་ལེ་དེ།",
    "སེར་པོའི་སྒོ་གཅིག་གདའ་ལེ་དེ།",
    "དམར་པོའི་སྒྲོ་གཅིག་གདའ་ལེ་དེ།",
    "དེ་མིན་སྒྲོ་འགའ་གདའ་ལེ་དེ།",
    "མཚོན་རྣོན་པོ་དགྲ་ལ་གཡུག་དུས་སུ།",
    "འགྲོ་ལུགས་འདུག་སྟངས་སོགས་སྤྱིའི་རང་གཤིས་སུ་གྲུབ་པའི་སྣང་ཚུལ་མཐའ་དག་འདུས་ཤིང་།",
    "རྣམས་ཡར་འགོ་མར་འབབ་བྱེད་པའི་ཐེམ་སྐས་ལྟ་བུར་གྱུར་འདུག་པར་མ་ཟདརྨུ་ཐག་འདིས་མི་ཕྱེད་ལྷ་ཕྱེད་ཀྱི་གཤིས་ཀའང་གསལ་བོར་མཚོན་པར་བྱས་ཡོདཡིན་ན་ཡོང་གླིང་གེ་སར་མཆོག་རྨུ་ཐག་ལས་གཤེགས་བཞུད་བྱས་པའི་གསུང་སྒྲོས་མ་ཐོས་ཀྱང་།",
    "སྨུག་ཆུང་འཛིན་མའི་གཟི་མདངས་གདའ།",
    "ཞེ་སྡང་སྦྲུལ་གྱི་ཨ་འབྲས་གདའ།",
    "མཁའ་འགྲོའི་གར་སྟབས་ཤིག་གེར་གདའ།",
    "ཤེལ་མུ་ཏིག་ཚོམ་བུ་ཤ་ལེར་བ་གདའ།",
    "ལྗགས་ལ་ཨ་ཡིག་རང་བྱོན་གདའ།",
    "བ་མ་སོགས་པར་སྐྲུན་གནང་འདུག་ལ།",
    "འདི་ཡང་རང་བྱུང་ཁམས་ཀྱི་གཏེར་དང་སྒྲུང་གཏེར་ཞེས་པའི་བར་ལ་ཁྱད་པར་གསལ་བོར་མཆིས།",
    "ཡིན་ནའང་རང་བྱུང་ཁམས་ཀྱི་ས་གཏེར་དེར་སྦེད་མཁན་གྱི་མི་མེད་ལ།",
    "རྗོད་བྱེད་ཀྱི་ཚིག་ཀྱང་སུམ་དག་རྟགས་གསུམ་གྱིས་ནསན་ཀུན་ནས་བཅིངས་འདུག་པར་མ་ཟད།",
    "སྒྲུང་ཁོ་ནར་འདུག་སྟེ།",
    "ལོར་ཁོང་རང་རྒྱལ་ཁབ་ཀྱི་ལས་བྱེད་མི་སྣའི་གྲས་སུ་བླངས་ཏེ།",
    "ཁོ་རང་ཕོ་ལོ་བདུན་གཉིས་བཅུ་བཞི་ལ་སོན་པའི་ལོ་དེའི་ཉིན་ཞིག་རི་མགོར་ཕྱུགས་འཚོ་སྐབས།",
    "ལོར་ཁོ་རང་ཁྱིམ་མི་ཚོ་དང་མཉམ་དུ་སྟོད་ཉི་མ་ལྷ་སར་མཇལ་སྐོར་ལ་འགྲོ་བའི་ལམ་དུ།",
    "སྐབས་དེ་ནས་བཟུང་ཁོ་རང་ཡང་གླིང་གེ་སར་རྒྱལ་པོའི་སྒྲུང་པའི་ལམ་དུ་གོམ་པ་སྤོ་འགོ་བརྩམས་པ་ཡིན་ནོ།",
    "གནང་འདུག་གཤམ་དུ་ཧོར་གླིང་གཡུལ་འགྱེད་ཀྱི་ལེགས་སྒྲིག་སྐོར་ཅུང་ཙམ་རྒྱས་པར་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་མིན་མིང་ཚིག་ཐ་སྙད་ཀྱང་རང་འདོད་ལྟར་སོར་བཞག་བྱས་ཡོད།",
    "ལྟར་བྲིས་འདུག་པ་སྟེ།",
    "དེ་ཡང་སྒྲུང་དཔེར་འདི་ལྟར་ཞིབ་འབྲི་བྱས་འདུག་པ་སྟེ།",
    "ཁོ་རང་ལོ་ན་གཞོན་ཡང་དཔའ་ངར་ཞུམ་པ་མེད་པར་ཧོར་གྱི་དམག་སྒར་ནང་ལ་ཁེར་རྒྱུག་བྱས་ནས་ཧོར་གྱི་པ་དུར་མང་པོ་རྨེག་མེད་བཟོས།",
    "མཁར་རྙིང་དེ་ཆགས་སའི་གཞི་དེར་ཡང་སྒྲུང་རྙིང་གང་མང་ལས་འདི་ལྟར་བྲིས་འདུག་སྟེ།",
    "རྒྱ་མཚོའི་ཆུ་སྲིན་ལྟ་བུ་འཇིགས་སུ་རུང་བ་ཞིག་བཟུང་ནས་ཁ་ལྷོ་ཕྱོགས་སུ་འཁོར་འདུག་མཁར་གྱི་ཤར་ནུབ་གཉིས་ཀྱི་མཚམས་སུ་ཁྲུ་གསུམ་ཙམ་གྱི་གསེར་བཙོ་མ་ལས་གྲུབ་པའི་མི་ཆུང་ཞིག་བཞེངས་འདུག་ལ།",
    "ལག་གཡོན་པས་ལྕགས་ཀྱི་མི་ཆུང་ཞིག་བཟུང་འདུག་ཅིང་།",
    "རྒྱལ་གསོལ་དང་ཕྱོགས་མཐུན་པའི་མཆོད་ཐབས་ཡོད་འདུག་ཅེས་བཀོད་ཡོད་པ་དང་།",
    "དེ་ནས་སྲས་གསུམ་པ་ལྷ་ཕྲུག་ཐོས་པ་དགའ་མི་ཡུལ་དུ་མངགས་ཞེས་འདུག་པ་ལས།",
    "གླིང་སྒྲུང་དུ་འདི་ལྟར་བྲིས་འདུག་པ་སྟེ།",
    "མེ་མ་འབར་བྱས་ན་ཁྲིག་གེར་འདུག།",
    "གླིང་རྗེ་གེ་སར་རྒྱལ་པོས་ཧོར་གུར་དཀར་རྒྱལ་པོར་གཉའ་སྒ་བསྟད་པ་དང་ཧོར་དམག་ཆམ་ལ་ཕབ་རྗེས་ཁོ་རང་སེང་ཆེན་རྒྱལ་པོའི་གསོལ་དཔོན་དུ་བསྐོས།",
    "ཐོག་རུའི་ཡུལ་ཁམས་བདེ་ལ་བཀོད་རྗེས་ཁོ་རང་ཐོག་རུའི་དཔོན་པོར་བསྐོས་སོ།",
    "གེ་སར་སྒྲུང་ལག་བྲིས་མ་སྐོར་ཁུངས་ལ་བརྟག་དཔྱད་བྱེད་པའི་སྐབས་སུཁོ་རང་ཕྱིར་ལོག་ནས་ལོར་ཆ་ཁེ་ཐུའུ་ཞིག་ལག་ཏུ་སོན་པར་མ་ཟད།",
    "ཡང་མི་སྐོར་ཞིག་མིག་ཟུང་གཡོ་བ་མེད་པར་འཁྲབ་ཡོལ་སྟེང་དུ་ཅེར་འདུགདེ་ནས་ཅང་མ་འགོར་བར་དྲིལ་ཆུང་སིང་སིང་འཁྲོལ་བར་བསྟུན་ནས།",
    "འདིར་གེ་སར་འཁོར་རྣམས་ཀྱི་ཁྲོད་དུ་གཟི་བརྗིད་ངང་བཞེངས་ནས་འདུག་ཅིང་།",
    "གོ་བཀྲག་འཇའ་ཚོན་འཁྱིལ་འདྲ་ཞིག་ཏུ་འདུག་པའི་ཚུལ།",
    "དུང་གཞུ་དཀར་པོ་རང་འཁྱིལ་ཞེས་པའི་སྟེང་དུ་མདའ་མི་འགྱུར་གནམ་ལྕགས་ཐོག་མདའ་སྤྲད་དེ་འདུག་པའི་ཚུལ།",
    "ཁོང་རང་ནི་ཚེ་སྟོད་ལ་རྒྱུ་ནོར་ལོངས་སྤྱོད་རྒྱས་པ་དང་།",
    "ཚེ་འདི་ནས་ཡུན་རིང་འདུག་ཁོམ་མེད།",
    "མྱུར་དུ་ལམ་ལ་སྐྱོད་པའི་ཚུལ་ནི་འདི་ལྟར་བྲིས་འདུག་རྟ་འདོ་བའི་གོང་ལ་ཞོན་ནས།",
    "ང་འབྲས་དཀར་མི་འདུག་འགྲོ་རྒྱུ་ཡིན།",
    "བོད་ཀྱི་རྩོམ་རིག་གསར་རྩོམ་སྒོ་ཀུན་ནས་ཐེམ་སྐས་གསར་བ་ཞིག་ལ་སླེབས་འདུག་པ་ར་སྤྲོད་བྱས་ཡོད།",
