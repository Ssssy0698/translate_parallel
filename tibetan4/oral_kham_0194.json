    "གཤེན་ལྷ་འདུག་པ་ངས་མ་མཐོང་།",
    "ནམ་མཁའ་དང་ས་གཞི་དང་རྒྱ་མཚོ་ལ་ཚོལ་ཙ་ན་ངེས་པའི་ལུང་བསྟན་པ་ཡང་ང་ཡིན་ནོ།",
    "རྒྱ་མཚོ་ཆེན་པོའི་དཀྱིལ་ན་དབལ་གྱི་རི་བོ་ཟུར་གསུམ་ཡོད་པའི་སྐེད་པར་ཚེར་ནག་གདུག་པའི་ཚལ་གསེབ་ཏུ་བྲག་ཕུག་ཁ་ནུབ་ཏུ་བལྟས་པ་ཁ་ཟླ་གམ་གཏིང་ཟུར་གསུམ་དུ་འདུག་པ་དེ་ནའོ།",
    "ཁྲག་སྐྱུག་པ་ལ་སོགས་པའི་སྐད་ཅིག་ལ་བརླག་འགྲོ་བ་འདུག་པས་ཤིན་ཏུ་འདར་ཞིང་དངངས་ནས་སྡུག་བསྔལ་བ་ཞེས་ཞུས་སོ།",
    "ལྷ་ཕྲུག་གཤའ་མར་འདུག་པས་ཤ།",
    "རྭ་ཅོ་འདུག་པས་ཁྱུང་ཕོ་ཡིན་འདུག་ཟེར།",
    "རང་རང་ཡུལ་དུ་སྐད་རིགས་སོ་སོར་བསྒྱུར་།",
    "རོ་ཙ་ནས་བོད་དུ་བསྒྱུར་བ་སྟེ།",
    "ད་ལྟ་རྒྱ་གར་གྱི་ཡི་གེ་དང་བོད་ཡིག་རྣམས་སྒྲ་གཟུགས་བརྙན་དང་བཅས་པ་མི་མཐུན་པར་འདུག་པའི་ཕྱིར་དང་།",
    "རྩི་ཤིང་རང་སྡུད་བྱེད་པའི་གཅོ་གྱིམ་བུ་ལན་ཚ།",
    "བདག་ཀྱང་མི་འདུག་ཟེར་ནས་བཞུགས་སུ་མ་འདོད་དོ།",
    "དེར་ལོ་ངམ་བློ་སེམས་མ་བདེ་བར་ཡོད་ཙ་ན།",
    "འོ་སྐོལ་གཉིས་ལ་རྗེ་འབངས་ཀྱི་ཁྱད་འདུག་པས།",
    "སད་ནས་བལྟས་ཙ་ན་སྔས་ན་གཡག་དཀར་པོ་ཞིག་ཉལ་ནས་སྣང་།",
    "གཞན་རྐྱེན་དང་རང་རྐྱེན་ནོ།",
    "ཁྱེའུ་འདི་ལས་ཅན་ཞིག་ཡིན་པར་འདུག་ཟེར།",
    "བོད་ཀྱི་རྒྱལ་པོས་ཀྱང་མི་བཟོད་པར་འདུག་ན།",
    "བོད་ཀྱི་མངའ་རིས་སུམ་གཉིས་སྟེར་བར་འདུག་གོ།",
    "དུག་མདེལ་གཅིག་དང་གསུམ་བཞག་གདའ་འོ།",
    "བ་གོར་བེ་རོ་ཙ་ན་རྐང་འགྱོགས་བྱ་དང་མཉམ།",
    "དེ་ནས་སྒོ་ནང་དུ་བྱོན་པས་ལྡེར་སོ་ཆེན་པོ་ཞིག་གདའ་བ་འདི་ཅི་ལགས་གསུངས་པས།",
    "རྗེ་ཁྲི་སྲོང་ཡང་བོན་ལ་ཐུགས་ཆེས་ནས་གཤིན་འདུར་གྱི་བོན་མེད་ན་གཤིན་པོ་གནས་ནས་མི་འདྲོང་བར་འདུག་གསུངས།",
    "དབུ་སྐྲ་ས་ལ་འཁྱིལ་པ་ཞིག་འདུག།",
    "ད་འདི་རུ་མ་འདུག་ཡུལ་དུ་རྒྱུག།",
    "ད་བཙལ་བས་མི་རྙེད་པར་འདུག་སྟེ།",
    "གདམས་ངག་མི་གནང་ན་རྗེ་གར་གཤེགས་གར་བཞུགས་ཀྱི་དྲུང་དུ་བདག་ཀྱང་འདུག་ལགས།",
    "ནངས་པར་རྗེ་བཞུགས་སམ་བལྟས་པས་བཞུགས་འདུག་ད་གདམས་ངག་ཞུ་ཞུས་པས།",
    "དེར་སྒྲོམ་གཅིག་ལ་ཁྲོ་ཆུས་རྒྱས་བཏབ་པ་ཞིག་འདུག་པ་བཏེགས་པས་ལྗིད་ཆེ་སྟེ་གསེར་ཡིན་སྙམ་ནས་ཁྱེར་ཏེ།",
    "ཁ་ཕྱེས་པས་ཐམས་ཅད་བོན་དུ་འདུག་གོ།",
    "མི་གཉིས་རྒྱགས་ཚོལ་དུ་ཕྱིན་པས་གྲོང་ཞིག་ན་རྔ་དིང་དིང་འདུག།",
    "ཚ་བོ་གཟེ་སྒུར་བྱ་བའི་བོན་པོ་ཞིག་ཀྱང་འདུག།",
    "ལྷ་ཕྱག་ཡང་འཚལ་གསོལ་བ་བཏབས་ནས་སྒྲོ་བ་ཁ་ཕྱེས་ཏེ་བལྟས་པས་ཐམས་ཅད་བོན་དུ་འདུག།",
    "ཕུར་པའི་གཏེར་སྲུང་རང་ཆས་ཡིན་པས་འཇིག་རྟེན་པའི་གཏེར་སྲུང་མེད་དོ།",
    "ནམ་ཞིག་དུས་ལ་བབ་ཙ་ན།",
    "ཚང་ནང་ན་ཁུང་བུ་འདུག་པ་ནས་བལྟས་པས།",
    "ཡང་དེ་བས་འདུག་གམ་སྙམ་ནས་བལྟས་པས།",
    "རྡོ་སྔོན་པོ་ཕྱི་ནང་གསལ་བ་སྒོ་ང་ཙམ་ཞིག་འདུག་པ་རྣམས་བླངས་ནས་གཞི་ལ་བྱོན་ནོ།",
    "ངའི་ཡབ་མེས་ཀུན་གྱིས་བྲག་ལ་བོན་བསྐུངས་ཟེར་བ་དེ་བྲག་འདིའི་ལོགས་ལ་ཡིན་ནམ་སྙམ་ནས་བལྟས་ཙ་ན།",
    "བྲག་དེར་འདུག་རྩིས་བྱས་ཀྱང་ལོ་འགའ་ལ་བསྡད་མ་གྲུབ།",
    "ཆུ་དཀར་པོ་ལ་སེར་པོའི་ཟར་བུ་ཆགས་པ་ཞིག་ཐིག་ཐིག་འདུག།",
    "དེ་བཙལ་བས་རྙེད་པ་ལ་དེ་ལྟར་འདུག།",
    "ཕ་བོང་བཟློག་བཏུབ་བམ་བལྟས་པས་བཏུབ་པར་འདུག་སྟེ།",
    "ཕ་བོང་གྲུ་བཞི་ལ་མཚལ་དང་ཤེལ་གྱིས་གཡུང་དྲུང་བྲིས་པ་ཞིག་འདུག།",
    "དེའི་ཚེ་ཐུགས་ཆད་ནས་བཞུགས་ཙ་ན་བསྟན་པའི་བདག་པོར་གྱུར་པའི་རྟགས་ཉི་ཟླ་ཁོང་དུ་མིད་པ་སོགས་ལྟས་བཟང་པོ་བྱུང་།",
    "དེར་ང་ལ་ཕྱི་མའི་དགེ་སྦྱོར་ཞིག་གལ་ཆེ་བས་བསྐྱུར་སྙམ་ཙ་ན།",
    "དགེ་སློང་བེ་རོ་ཙ་ནའི་སྤྲུལ་པ་ནི།",
    "དེར་བརྟགས་པས་བྲག་དེ་ལ་སྒོ་སྲུབ་དོད་དེ་འདུག།",
    "ད་དུང་པོ་ཏིས་བྲག་ཕུག་གང་ནས་འདུག་གསུངས་པས།",
    "འོ་ན་དེ་ཙམ་བྲི་ཚོད་མི་གདའ་ལགས་པས་གང་དགོས་འགའ་ལོངས་ཟེར་བར།",
    "སྦ་ལྕག་སོགས་ནོར་མང་པོ་འདུག་པ་བཞག།",
    "ངོ་བོའི་འདུག་ཚུལ་རྣམས་སོ།",
    "ང་ལ་ཟས་ནོར་གོས་གསུམ་འདོད་ཚད་ཡོད་ང་ལས་ཕྱུག་པ་ག་ན་ཡོད་ཟེར་བ་ལ་ལན་བྱས་པ་གདའ།",
    "ཆ་མེད་བྱས་ཙ་ན།",
    "འདི་ཀུན་ཏུ་བཟང་པོ་མན་ཆད་ནས་ད་ལྟ་ཡན་ཆད་དུ་སྙན་ནས་སྙན་དུ་བརྒྱུད་པ་ཞིག་གདའ་བས།",
    "མཆོད་རྟེན་དམར་པོའི་སོ་ཕག་གོག་ནས་ཤོག་དྲིལ་འགའ་ཞིག་བྱུང་བར་བལྟས་པས་བོན་དུ་འདུག་སྟེ་མེ་ལ་བསྲེགས་པས་མི་རུང་བ་སྣ་ཚོགས་བྱུང་སྐད།",
    "ཞིག་གསོས་བྱས་པས་སྒྲོམ་གཅིག་བྱུང་བ་ལ་བལྟས་པས་ཤོག་དྲིལ་མང་དུ་བྱུང་བ་ཡང་བོན་དུ་འདུག།",
    "བདག་བཙུན་པ་གཞོན་ནུ་ཁམས་སུ་ཡོད་ཙ་ན།",
    "ས་ཕུག་གཅིག་ན་རྣལ་འབྱོར་པ་གཡུ་ཐུལ་དང་བྱ་ཞུ་མནབ་པ་ཞིག་གཟིམ་ནས་འདུག་པ་ལ།",
    "གཉིད་སད་ནས་བལྟས་པས་མི་དེ་མིག་སྔ་ན་ཝ་ལེར་འདུག།",
    "ཡས་སྟག་རྩི་ཤིང་རང་འགྲོས།",
    "གཏེར་ཁུང་ནས་འཇལ་པའི་མདའ་དོའི་ས་ན་ཕུག་པ་གཉིས་ཀྱི་བར་དུ་མཚོ་ནག་ཟངས་ཁ་ཙམ་གྱི་དཀྱིལ་ན་སྦྲུལ་ནག་པོ་མདུང་ཙམ་ཞིག་འདུག།",
    "མཚོའི་འགྲམ་དུ་ཡས་སྟག་རང་འགྲོས་ཀྱི་སྐོར་རྣམས་འདུག་སྟེ་མ་དྲངས་སོ།",
    "རྒྱན་རྙིང་པར་འདུག་འགའ་ཞིག་དེ་ལས་བཟློག་པར་འདུག་དེའི་ཚེ་ཌཱཀི་མ་མདངས་བཟང་བ་ཞིག་འོངས་ནས་མེ་ཏོག་གཏད་པ་སློབ་དཔོན་གྱིས་བླངས་པས།",
    "དེར་བྱོན་པས་ཇི་ལྟ་བ་བཞིན་འདུག་ནས་ཞུས་པས་ཁྲོ།",
    "སླར་གསོལ་བ་དྲག་ཏུ་བཏབ་པས་ཅི་ཞིག་ལ་དྲན་མེད་དུ་བརྒྱལ་འདུག་པས་སངས་ཙ་ན།",
    "དབྱུག་པ་ཁཊྭཱྃ་ག་ལ་སོགས་པར་གྱུར་འདུག་ནས།",
    "རྟོགས་པ་སྐྱེས་ཙ་ན་འདི་ན་དྲི་གཅིག་འདུག་ཟེར།",
    "མཉམ་པར་བཞག་ཙ་ན་ཅི་ཡང་མི་འདུག་ཟེར།",
    "མུ་སྟེགས་བྱེད་ཀྱི་མཁའ་འགྲོ་མར་འདུག་གསུངས།",
    "རང་རིག་རང་བྱུང་རང་གསལ་གྱི།",
    "བལྟར་བཏང་བས་བདེན་པར་འདུག་ནས་སྤྱན་དྲངས།",
    "སྤྲུལ་པར་འདུག་པ་ལ་གོ་མ་ཆོད་སྙམ།",
    "ཡང་གནས་གཞི་ཆེན་པོ་ཞིག་ཏུ་ཕྱིན་ཙ་ན།",
    "དེ་དག་ཕན་ཚུན་བལྟས་ནས་རྒོད་ཤོ་ཤོ་གདའ་བ་ལ་དྲིས་པས།",
    "ཕྱིན་ཏེ་ཚོད་མ་ཟངས་གང་འདུག་པ་ནས་བཅུས་ཏེ་བྲོས།",
    "ཕྱོགས་བཞིའི་མི་རྣམས་ཀྱི་སྣང་བ་ལ་རང་རང་ཕྱོགས་ནས་བྱོན་པར་མཐོང་སྟེ་བསུས།",
    "ནངས་པོ་མནལ་སད་ཙ་ན།",
    "མཚན་དང་དཔེ་བྱད་ཀྱིས་བརྒྱན་པ་ལྟ་བས་ངོམས་པ་མེད་པའི་སྐུ་རང་བྱུང་དུ་བྱོན་ཏེ་གདའ།",
    "དེ་ན་པཎ་གྲུབ་རྒྱ་མཚོ་ལྟ་བུ་བཞུགས་པའི་ནང་ནས་འགྲན་ཟླ་མེད་པ་དཔལ་ནཱ་རོ་པར་འདུག་པ།",
    "དེས་བོད་ན་ངའི་མིང་པོ་ཌོཾམྦྷི་ཧེ་རུ་ཀ་བདེ་བར་འདུག་གམ་ཟེར།",
    "ཟེར་མ་ཞིག་གད་གློར་འཐོར་འདུག་པ་མྱངས་པས་རོ་དཔེ་མེད་པ་ཞིག་བྱུང་བས་ཏིང་ངེ་འཛིན་ལ་ཞག་བདུན་དུ་འབྱམས་པ་དང་།",
    "དེ་ནས་ཟླ་བ་བརྒྱད་འདས་ཙ་ན།",
    "གསུང་ཐོས་པས་ནང་དུ་ཕྱིན་ཙ་ན་སྐུ་གཟི་མདངས་ལམ་མེ་འཚོ་ཆས་ཅུང་ཟད་ལས་མ་གོད་པར་འདུག་པས་ཏིང་ངེ་འཛིན་གྱིས་འཚོ་བར་ཤེས།",
    "བཟོད་གསོལ་བྱས་པས་དེ་དག་མི་སྣང་བར་སྔར་གྱི་སར་དཔོན་སློབ་གཉིས་བཞུགས་གདའ་བ་ལ།",
    "འདས་ཙ་ན་རོ་བསྲེགས་པའི་དུ་བར་འཇའ་འཁྲིགས།",
    "ཡང་དྲེད་ཀྱི་གཙང་པོ་ལ་བཞུད་ཙ་ན།",
    "ཁྱེད་རང་གཉིས་གར་ཡང་མ་འགྲོ་གསུངས།",
    "དེ་མཁྱེན་འདུག་སྙམ་ནས་ཤིང་ཁུར་ཆེན་པོ་གཉིས་ཁུར་ནས་འོངས་པས། ། ཤིང་ཁུར་འདི་ཇི་ཙམ་ཡིན་གསུངས།",
    "བཟོ་རས་ཀྱིས་ཉི་ཁྲི་གཅིག་འབྲི་དགོས་སྙམ་ཙ་ན།",
    "འབུམ་ཁང་བྱེད་ཙ་ན་བྲག་བརྐོ་དགོས་པར་བྱུང་བས་སྐུ་ཁམས་ལ་ཅུང་གཟན་པར་བྱུང་།",
    "ཡར་འོངས་ནས་འོད་འཇོའི་སྒང་དུ་སླེབས་ཙ་ན་བཙུན་ཆུང་དེ་ལ་སྒོམ་སྐྱེས།",
    "སྤྱན་སྔར་སླེབས་ཙ་ན་ཆར་མེད་པས་ཞེད་གར་དགོས་གསུངས།",
    "ཆུ་མི་སྣང་སྟེ་ནངས་པར་བན་གཞོན་བཅུ་ལ་རོགས་བཅོལ་ནས་སྤྲུག་ཆུ་ནས་བླངས་པས་ཆོག་བྱས་ཚིས་སུ་ཡོད་ཙ་ན།",
    "སྐུ་འབུམ་གྱི་ནང་གཞུག་ལ་དམིགས་ནས་སཱཙྪ་བླ་གཡེལ་གང་བཏབ་ཡོད་ཙ་ན།",
    "གདུང་སྐལ་རྣམས་ལ་མཆོད་རྟེན་དག་སྣང་རང་ཤར་གྱི་བཀོད་པ་ཁྱད་དུ་ཐོན་པ་བཞེངས་ཏེ་ད་ལྟའང་བཞུགས།",
    "དེ་ཁྱེར་ནས་ཡོང་ཙ་ན།",
    "བལྟར་ཕྱིན་པས་བོན་པོའི་གཙོ་བོ་ཤི་འདུག་བོན་པོས་ངེད་རང་ལ་མཐུ་བྱེད་ཀྱིན་ཡོད་པར་འདུག་ཞུས་པས།",
    "ང་གོང་དུ་ཁྲིད་མི་དགོས་ཁོང་རང་གོང་དུ་སླེབས་པ་གྱིས་གསུངས་པས་ཁོ་སོག་ཏུ་ཤི།",
    "ཆར་འབེབས་དགོས་ཙ་ན་ཆུ་མིག་ཁར་མནལ་གཟིམས་པ་ཙམ་གྱིས་ཀླུས་མི་བཟོད་པ་དེ་མ་ཐག་ཏུ་ཆར་འབེབས།",
    "འགྲོ་འཆག་ཉལ་འདུག་དང་།",
    "ལུས་གཅེར་བུར་འདུག་པ།",
    "སེམས་དྲན་པ་ཉེར་གཞགདེ་ནི་སེམས་མི་རྟག་པ་དང་རང་འབྲས་ཕྱི་མ་རྒྱུན་མི་ཆད་པ་སོགས་སེམས་གྱི་གནས་ལུགས་རྣམས་བསྒོམས་ཏེ་མི་བརྗེད་པར་འཛིན་པའི་ཏིང་ངེ་འཛིན་ཞིག་ལ་ཟེར།",
    "སེམས་མི་རྟག་ཀྱང་རང་འབྲས་ཕྱི་མ་རྒྱུན་མི་ཆད་པ་དང་།",
    "ད་དུང་བདེན་གཉིས་ངོ་བོ་གཅིག་ལ་ལྡོག་པ་ཐ་དད་ཡིན་པའི་གནས་ལུགས་ཀྱང་བསྒྲུབས་འདུག་པས་སྔར་གྱི་ནང་བསྟན་དེ་ངོ་བོ་དང་བསམ་བློའི་ཆ་ནས་གཏིང་ཇེ་ཟབ་དང་རྒྱ་ཇེ་ཆེ་རུ་འགྲོ་བཞིན་ཡོད་དོ།",
    "ད་ལྟའི་བར་པར་དུ་བརྐོ་མ་ཐུབ་པར་ལུས་འདུག་དབྱིག་བཤེས་དང་།",
    "ཁོ་རང་དགྲ་བཅོམ་པ་ཡིན་ཡང་།",
    "མཁས་པ་སོ་སོའི་བཞེད་པ་མི་མཐུན་པ་མང་དུ་འདུག་གོ།",
    "ཕྱི་དོན་མེད་ཅིང་རང་རིག་འཐད་པ་སོགས་གཞིའི་རྣམ་གཞག་ཕལ་ཆེ་བ་སེམས་ཙམ་པ་དང་མཐུན་པར་བསྟན་ཡོད་ཕྱིར།",
    "གཟེར་བུ་སོགས་དང་རང་བཞིན་གཅིག་ཡིན་ཞེ་ན།",
    "དེའི་སྐབས་ཀྱི་ལྐོག་གྱུར་ནི་རྟག་པ་དང་སྤྱི་མཚན་ལ་བརྗོད་པ་གང་ཞིག་དེའི་སྐབས་ཀྱི་མངོན་གྱུར་ནི་དངོས་པོ་དང་རང་མཚན་ལ་བརྗོད་པ་ཡིན་པའི་ཕྱིར།",
    "འབྲས་རྟགས་དང་རང་བཞིན་གྱི་རྟགས།",
    "རི་བོ་དང་མི་རྟག་པ་གཉིས་ཀྱང་རང་བཞིན་གཅིག་ཡིན་ཞེས་བརྗོད་རུང་བ་ཡིན་ནོ།",
    "དེའང་རང་བཞིན་གྱི་རྟགས་ཡང་དག་ཏུ་མི་འགྱུར་སྟེ།",
    "དེ་དང་རང་བཞིན་གཅིག་པ་ཅན།",
    "ཤ་ཟ་ཁོ་རང་སྤྱིར་ཡོད་པ་ཡིན་པ་མ་བཀག་ལ།",
    "རང་རང་སྒྲུབ་ངག་ཕྱི་མ་གཉིས་ནི་སྒྲུབ་ངག་སྔ་མ་གཉིས་ལ་བརྟེན་ནས་རྗེས་དཔོག་བྱ་ཐུབ་པ་གཉིས་ཡིན་ལ།",
