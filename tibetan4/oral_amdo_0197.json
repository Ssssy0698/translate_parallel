    "རེད་སྦྱང་བ་ནི།",
    "ཞེས་རྒྱུ་རྐྱེན་དབྱེ་བ་བཅོས་ཐབས་ཀྱི་ཁོངས་སུ་རྟགས་འདུས་པས་དེ་གསུམ་མོ།",
    "མིའི་རྐང་མགོ་ཉ་ཤ་སྤུ་རྩ་རེ་ལྕག་ཆང་བཙོས་ལུམས་བྱ།",
    "ཀུན་ལ་སྤུ་མའམ་མཁན་སྐུའི་རེང་བུ་ཡི།",
    "མགོ་ལ་གུར་ཀུམ་དོམ་མཁྲིས་ཟབ་མགྲོན་ཐལ།",
    "ཟ་འོག་མགྲོན་བུའི་ཐལ་བ་གུར་ཀུམ་དོམ་མཁྲིས་ཀྱི་ཕྱེ་མ་བྱུགས་ལ་སྣ་རུ་འགྲོ་ཚད་བརྫངས་ལ་བཞག་ཁྲག་ལེགས་པར་ཆད་ནས་སྣབས་བྱུང་ཙ་ན་རེང་བུ་ལྡོག་ཏུ་འོང་།",
    "གྲེ་མཆུའི་ཤ་རྨེན་དེ་འབྲུད་ཅིང་བདར་ལ་ལྕགས་སྲེག་གིས་བསྲེག་སེང་ཕྲོམ་ནི་ཞུ་མཁན་ནོ།",
    "ཤོ་རེ་དར་གྱིས་བཙེམ་པ་ནི་སྦལ་འགྲོས་སུ་བཙེམ་པའོ།",
    "སྲིན་ལག་གཡོན་གྱི་ཚིགས་གས་མམགོའི་འོག་ནི་ལག་ཡུ་ངོས་ཀྱི་སོར་ཚིགས་དང་པོའི་འོག་ཙམ་རྒྱུས་པར་མ་སོང་བ་བསྲེག་སྟེ་མཚེར་རྩ་ཡོད་དོ།",
    "སོ་སྲིན་གྱི་རྟ་སྦངས་ནི་རྟ་གསེབ་སྔོ་ནག་གི་སྦྱང་ངོ།",
    "ས་རྫི་ཀ་ནི་སྙེ་ནག་མོའོ།",
    "སྲིན་ལག་གི་ཚིགས་མགོ་དང་།",
    "ཕྱི་མཁྲིག་གི་རུས་མགོ་སྟེ་མཁྲིག་མའི་ལག་པ་རྒྱབ་ཕྱོགས་ཀྱི་མ་ཟུར་ཚིགས་འབུར་དེ་བསྲེག་གོ།",
    "སྔོའི་ཚ་བ་གསུམ་ནི་ལྕེ་ཚ་དབྱི་མོང་སྲུབ་ཀ་ཡིན་ལ།",
    "ཕང་ལོ་མིག་གི་ནང་དུ་སྐུ་འཐེན་ནས་ཤིང་བུས་གཅུས་ལ་བཞག་གོ།",
    "ལྕགས་ཀྱུ་མཐོ་གང་ཁབ་སྦོམ་པོ་ཙམ་ཤིང་གི་ཡུ་བ་ཡོད་པས་ལྕེ་ཆུང་གི་རྩེ་བཟུང་ནང་ངོས་ནས་ཕྱིར་ཕུག་ལ་ཐུར་དུ་འཐེན།",
    "ཕྱེད་མཚམས་སུ་ཆ་བྱད་ཟོར་བ་ལྟ་བུ་ཞིག་གི་མཆན་པས་བཅད་དོ།",
    "བཅུ་པ་ནི་ཙན་དན་ཨ་ཀ་རུ་གི་ཝང་གུར་ཀུམ་ཅུ་གང་ཤིང་མངར་རྒུན་འབྲུམ་སྲོ་ལོ་སྤང་རྒྱན་འབུ་སུ་ཧང་ཀ་རའོ།",
    "པི་པི་ལིང་གི་ལྡེ་གུ་ནི་པི་པི་ལིང་མར་དུ་བཙོས་པ་མར་ཀར་སྦྲང་རྩི་སྦྱར་བའོ།",
    "གློ་གཅོང་གི་ཨ་ཀྲོང་ལུམས་ནི།",
    "ཀར་ཥ་པ་ཎི་ནི་མགྲོན་བུ་སྟེ་མགྲོན་བུ་ལྔའི་ཐལ་བ་དོམ་མཁྲིས་གུར་ཀུམ་མཚལ་ཟབ་ཐལ་ལོ།",
    "ཟངས་ཐལ་སྦྱོར་བ་ནི་ཟངས་ཐལ་མུ་ཟི་ཤ་རུ་སྤེན་མ་སྲོ་ལོ་ཨ་ཀྲོང་ངོ།",
    "ཀླད་པའི་སྦྱོར་བ་ནི་ཝ་དང་སྲིན་བྱའི་ཀླད་པ་ལ་མུ་ཟི་ཟབ་ཐལ་སྲོ་ལོ་ཅུ་གང་སྤང་རྒྱན་སྟར་བུའོ།",
    "ཤུ་མོ་ཟ་སྤར་བ་གང་ལི་གཅིག་རྣམས་ཀ་ར་སྦྱར་བའོ།",
    "ཟངས་ཐལ་སྦྱོར་བ་གོང་དུ་བསྟན།",
    "ཡང་ན་ཝ་དང་སྲིན་བྱའི་ཀླད་པ་མུ་ཟི་སག་རམ་རྩི་སྲོ་ལོ་པི་པི་ལིང་སླ་ངར་བསྲེག་པ་ན་མ་དང་ཤ་རུའི་ཐལ་བ་སྤང་རྒྱན་ཀ་ར་སྦྲང་སྦྱར་རོ།",
    "ལེབ་རྒན་གྱི་གི་ཝང་སྐྱུ་རུའི་ཐང་ལ་གསེར་མཆན་དུ།",
    "གི་ཝང་གི་ཐང་ངམ་སྐྱུ་རུ་བ་ཤ་ཀ་བ་ལེ་ཀ་ཐང་བཏང་ཞེས་སོ།",
    "ར་ས་ཡ་ནའི་རེ་བབ་ཤལ་ནི་ར་ས་ཡ་ན་རོ་མཆོག་ཅེས་པར་འགྱུར་ཟེར།",
    "དེའི་བཤལ་ནི་ལྡུམ་རྩ་དོང་ག་དུར་བྱིད་ཐར་ནུ་ཁྲོན་བུ་རེ་ལྕགས་སྐྱེར་བ་ཧོང་ལེན་ཨ་རུ་རའོ།",
    "གི་ཝང་བརྒྱད་པ་ནི་གི་ཝང་ཙན་དན་གཉིས་མཚལ་སྔོན་བུ་རེ་རལ་བཅད་འབྱོར་གཉིས་ཏེ་སྟག་ཤ་བ་དང་ཡུ་གུ་ཤིང་ངོ།",
    "ཆུ་ཤོར་གྱི་ར་གསུམ་ནི་ཨ་བར་སྐྱུར་གསུམ་མོ།",
    "དམར་གསུམ་ནི་བཙོད་འབྲི་མོག་རྒྱ་སྐྱེགས་སོ།",
    "གཞུང་རེངས་ཀྱི་དུར་ལྕགས་ཐང་ནི་དུར་ནས་ཐོན་པའི་ལྕགས་བཙའ་ཅན་དང་ཨ་རུ་རའི་ཐང་ངོ།",
    "མཆིན་དྲི་དཀར་པོའི་གུར་ཀུམ་བརྒྱད་པའི་ལྡེ་གུ་ནི་གུར་ཀུམ་ལི་ཤི་སུག་སྨེལ་ཀ་ཀོ་ལ་ད་བྱིད་པར་པ་ཏ་སྤང་སྤོས་ཤུ་མོ་ཟ་སྦྲང་ངོ།",
    "ཚིགས་པ་བཅུ་གཅིག་པའི་དབུས་དང་གཡས་གཡོན་ཚོན་རེ་སྟེ་འཕྲེད་དུ་རྩིས་པའི་ཁ་གསུམ་ཡིན་ནོ།",
    "དམར་པོ་བཞི་ཐང་ནི་ཨ་རུ་ར་རྒྱ་སྐྱེགས་འབྲི་མོག་བཙོད།",
    "བྱེ་བྲག་གི་གསོ་ཐབས་དང་སྤྱིར་བསྟན་གྱི་གསོ་ཐབས་སོ།",
    "སྟར་བུའི་སྦྱོངས་ནི་སྟར་བུ་དུང་ཐལ་རྒྱམ་ཚྭ་སྦྲུལ་ཤ་དུར་བྱིད་དོ།",
    "ཏྲེས་སམ་ཞེས་པ་ཞང་ཞུང་གི་སྐད་གཉིས་ཀ་ཕྱེ་མའི་མིང་ངོ།",
    "རྒྱུ་འཁྲིལ་གྱི་མདུན་རྒྱབ་གསང་ང་ནི་མདུན་གསང་ལྟེ་འོག་ཚོན་གང་ཁ་གསུམ་དེ་འོག་ཚོན་གང་ཁ་གསུམ་མོ།",
    "རྒྱམ་ཚྭ་ཐལ་ཚྭ་ཁ་རུ་ཚྭ་རྩབས་རུ་ཚྭའོ།",
    "ཤིང་ཚ་སུག་སྨེལ་ཀ་ར་ཞོ་ཕྱེད་རེ།",
    "གོ་རིམ་བཞིན་དུ་ཆ་རེ་བསྐྱེད།",
    "པི་པི་ལིང་གི་བརྒྱུད་འགྱུར་གྱིས།",
    "ཟས་བྱུང་གི་རིངས་ཐབས་ནི་སྟབ་སྟོབ་ཏུ་མགྱོགས་པར་ཟས་ཟོས་པའོ།",
    "ཨ་ཀ་རུ་གུ་གུལ་དཀར་པོ་རྡོ་དྲེག་སྤང་སྤོས་ཨ་རུ་ར་ཤིང་མངར་ཧ་རེ་ནུ་ཀ་ཨུ་ཤིར།",
    "དེ་རྗེས་ཁ་སྣའི་དབུགས་ནང་དུ་བསྡམ་མོ།",
    "ཨ་ཀ་རུ་གུ་གུལ་དཀར་པོ་སྟེ་སྤོས་དཀར་རྡོ་དྲེག་སྤང་སྤོས་ཨ་རུ་ར་ཤིང་མངར་ཧ་རེ་ནུ་ཀ་ཨུ་ཤིར་བྱི་དང་ཀ་གླ་རྩི་སྤྲ་ཚིལ་དུ་བ་མེད་པའི་མེ་ལ་བསྲེག་པའི་དུད་པས་བདུག་སྤོས་དཀར་ལྡོང་རོས་བདུག་ཨ་ཀ་རུ་མར་སྦྱར་བྱུག་ཉེས་པ་གར་ཆེའི་ཆ་དང་སྦྱར་བ་ནི།",
    "གཉིས་པ་ནི་བྱེ་བྲག་ནས་གསེང་གི་བར་ཏེ།",
    "རྫི་མ་ཆག་པ་ནི་མིག་གི་རྫི་མ་ཆག་སྟེ་ཐུར་དུ་ཞོལ་བའོ།",
    "མཆིན་གླང་གི་གྲོག་ཤིང་ནི་བྲག་གམ་གྱང་རྙིང་ལོགས་སུ་ལ་བེམ་ཆགས་པའི་ཟར་ཟིར་ཅན་དེའོ།",
    "དུར་བྱིད་སྟར་བུ་དུང་ཐལ་སྦྲུལ་ཤ་རྒྱམ་ཚྭའི་བཤལ་ལོ།",
    "གྲང་གླང་གི་དུགས་ནི་ཚྭ་བསྲོས།",
    "ཕྱེ་མ་ནི་ཤིང་ཀུན་ཁ་རུ་ཚྭ་ཚྭ་བ་གསུམ་མོ།",
    "སྲིན་གླང་གི་ཐང་ཕྲོམ་ནི་ནག་པོའོ།",
    "གཉན་གླང་གི་ལྷོག་དུག་གསུམ་ནི།",
    "མིག་སྲིན་ལ་སྤུ་རྩེ་རྟ་སྦངས་ཕུར་མོའི་ལུམས་བྱ་གླ་རྩིའི་ཆུས་བྱུགས།",
    "ཡ་མ་ནག་པོའི་སྦྱོངས་ནི་དུར་བྱིད་བྱི་དང་ཀ་མ་རུ་རྩེ་ཕུར་མོང་དུད་པའོ།",
    "ཐང་ཕྲོམ་དཀར་པོ་ཐང་ཕྲོམ་རང་གི་ངོས་སྐལ་བྱས།",
    "གཉིས་པ་ལའང་བཞི་ལས་དང་པོ་དང་གཉིས་པ་ཐུན་མོང་དུ་བརྗོད་པ་ནི།",
    "རྒྱ་ཚྭ་རྒྱམ་ཚྭ་ལྕེ་མྱང་ཚྭ་ཁ་རུ་ཚྭ་ཐལ་ཚྭ་ལྔ་ཡིན་ཟེར།",
    "པུས་མོ་དང་མཉམ་པའི་ནས་ཀྱི་ཁྲི་ལ་བཞག་རྒྱབ་ནས་པང་བས་བསྟེན།",
    "སྒྱིད་ཁུང་གསུས་པར་བཀུག་ལ་པང་དུ་བཟུང་མཁན་གྱིས་གཡོག་དང་བཅས་ཅས་པ་པ་རརས་ཡུག་གིས་བཅིང་ངོ།",
    "གཅིན་མང་རེག་བྱ་གྲང་རོ་མངར་བ་བསིལ་གྱི་ཟ་ཁུ།",
    "རྐང་མར་དང་འདྲེས་པ་རྐང་གི་ཟ་ཁུ།",
    "ལམ་དུ་གདུགས་དང་ལྷམ་དག་གི།"
  ]
}