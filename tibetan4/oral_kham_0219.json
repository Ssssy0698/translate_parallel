    "ས་བོན་གྱི་བདག་ཉིད་ཀྱང་རང་བཞིན་དུ་གནས་པ་དང་ཡང་དག་པར་བསྒྲུབས་པ་དང་རྣམ་པ་གཉིས་ཏེ།",
    "ཀུན་གཞི་རྣམ་པར་མ་བཞག་པའི་རིགས་ལ་ཡང་རང་བཞིན་དུ་གནས་པ་དང་རྒྱས་པ་ལས་གྱུར་པ་གཉིས་ཡོད།",
    "རིགས་དང་ས་བོན་དང་ཁམས་དང་རང་བཞིན་ཞེས་བྱ་བའི་མིང་དང་ཐ་སྙད་དེ་དག་བཏགས་པར་ཟད་པས་དེའི་ཕྱིར་ཆ་དེ་ནི་རྒྱུད་གཅིག་པ་ཞེས་བྱའོ།",
    "དེ་ཡང་རྣམ་པ་གཉིས་ཏེ་རྐྱེན་གྱིས་ཡང་དག་པར་བླངས་པ་དང་རང་བཞིན་དུ་གནས་པའོ།",
    "ཤིན་ཏུ་ཟབ་པའི་དབྱིངས་འདི་ཀུན་རྫོབ་ཉེ་བར་བཟུང་ནས་སྒྲོ་བཏགས་ཏེ་རྣམ་གཞག་བྱས་པ་མ་ཤེས་པར་རང་རྒྱུད་དུ་གྲུབ་པར་བྱས་ནས་ཁ་ཅིག་གཅིག་དང་གཞན་ཐ་དད་དུ་འདོད་པ་སོགས་ཀྱི་ཀུན་བརྟགས་དུ་མ་ཞིག་སྣང་བ་ལ་ནི་བློ་ངལ་བ་ཙམ་ཞིག་འབྲས་བུར་འདུག་གོ།",
    "དེ་ལྟ་ན་དེའི་མཚན་ཉིད་མཐའ་དག་དུས་ཐམས་ཅད་དུ་ཤེས་པའི་ཡེ་ཤེས་ཀྱི་རྟེན་དུ་གྱུར་པ་མཚན་ཉིད་དང་དུས་རྣམས་སྟོང་པར་རྟོགས་སོ།",
    "དེས་ཉོན་སྒྲིབ་དང་ཤེས་སྒྲིབ་བག་ཆགས་དང་བཅས་པ་སྤངས་པ་དང་རང་བྱུང་ཉིད་ཐོབ་པ་ན་དེ་སྟོང་པར་རྟོགས་ལ།",
    "དེ་ཡང་ཀུན་བརྟགས་འབལ་འདོད་ཅིང་མཚན་ཉིད་གཞན་གཉིས་ཐོགས་མེད་སྐུ་མཆེད་ཀྱི་གཞུང་རྩོད་མེད་གང་དུ་ཡང་རང་སྟོང་དུ་བསྒྲུབས་པ་མེད་དོ།",
    "ཟས་མང་པོ་ལ་ཆགས་པའི་གཉེན་པོར་སྟན་གཅིག་ལ་འདུག་ནས་ཟའི་དེ་ལས་ལངས་ནས་མ་ཡིན་པའི་སྟན་གཅིག་པ་དང་།",
    "ཟས་ཀྱི་ཕྱིར་འདུག་ནས་ཅི་ཙམ་གྱིས་བདག་འཚོ་བའི་ཟས་ཐམས་ཅད་མ་བླངས་པའི་བར་དུ་མི་ཟ་ཞིང་འདིས་འཚོའོ་སྙམ་དུ་དང་།",
    "ལྷུན་བེ་ཌཱུརྱར་འདུག་པ།",
    "དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "བྱེད་པ་ནི་དེའི་འཐད་པར་ཉན་རང་རང་ཉིད་གཅིག་པུ་དུལ་བའི་ཆེད་དུ་གནས་ལ།",
    "གང་རང་བཞིན་མ་ཡིན་པ་དེ་ནི་རང་བཞིན་ནོ།",
    "རང་རང་སོ་སོའི་ཡེ་ཤེས་རང་གདངས་ལས།",
    "བསླང་ན་སྟེར་བར་འདུག་ཅེས་གཏམ་ཐོས་བཞིན།",
    "དེ་ནས་བྱོན་པའི་དུས་ལ་བབ་ཙ་ན།",
    "གསེར་གྱི་རི་དེའི་རྩ་རུ་ཕྱིན་ཙ་ན།",
    "གྲུབ་པའི་ངོ་མཚར་མཆོག་ལྡན་མཁར་གཅིག་འདུག།",
    "ང་རང་འདིར་འདུག་རྒྱལ་པོ་ཆེན་པོ་ཁྱེད།",
    "ངེད་ཅག་རྒྱལ་ན་ཁྱེད་རང་ནང་པ་རྣམས།",
    "ཁྱེད་རང་རྒྱལ་ན་ངེད་ཀྱང་དེ་བཞིན་བྱེད།",
    "རང་རང་རབ་སོ་སོའི་གོ་ཚུལ་འདི་བཞིན་སྨྲས།",
    "སྟོན་པ་བཞི་པོ་རང་རང་གནས་སུ་བྲོས།",
    "ཐེ་ཚོམ་སྐྱེས་ཏེ་བལྟ་རུ་ཕྱིན་ཙ་ན།",
    "བོད་ལ་བཀའ་དྲིན་ཤིན་ཏུ་ཆེ་བར་འདུག།",
    "སློབ་དཔོན་པདྨ་ཁྱེད་རང་ལགས་སམ་ཞུས།",
    "སྲུང་མ་རྣམས་ཀྱིས་ཁྱེད་རང་བང་ཆེན་བདུན།",
    "བསྐུལ་མ་བྱུང་བཞིན་ང་རང་འདིར་ཕེབས་ནས།",
    "ཡི་མུག་བཏང་འཕྲལ་ཕུར་པ་བཏབ་ཙ་ན།",
    "ཁྲོ་བཅུ་བསྐུལ་བས་ཁོ་རང་གཉིས་སྦྱོར་བཅུག།",
    "ལན་ཅིག་དུས་ཀྱི་ཐ་མ་ལ།",
    "དེ་ནས་ལིང་པ་རོང་དུ་བྱོན་ཙ་ན།",
    "རང་རང་གནས་པའི་རི་རྩེར་བྲོས་གྱུར་ཀྱང་།",
    "དེ་ནས་ཐང་ལྷའི་གམ་དུ་བྱོན་ཙ་ན།",
    "ཁོ་རང་གནོད་སྦྱིན་ཆེན་པོ་གཅིག་སྤྲུལ་ནས།",
    "ཐབ་རླངས་འཕྱུར་བས་ཁོ་རང་ཐུགས་ཁྲོས་ནས།",
    "སྡང་བའི་ཀླུ་ཞིག་འདུག་པས་དེ་འདུལ་དགོས།",
    "ཚོང་པ་འགའ་ཞིག་འདུག་པས་དེ་དག་ལ།",
    "གསེག་ཤིང་བྱེ་མར་ལན་བདུན་བཏབ་ཙ་ན།",
    "བཞུགས་ནས་འདུག་པར་སློབ་དཔོན་ཆེན་པོ་ཡིས།",
    "བྱིན་པས་ཁོ་རང་དགའ་སྟེ་དམ་འོག་བཅུག།",
    "དགོངས་པ་ཤར་ནས་ཡུལ་དེར་བྱོན་ཙ་ན།",
    "ཞུ་རྗེས་ཁོ་རང་གངས་རྩེར་སྡོད་བཞིན་དུ།",
    "སྐལ་བར་ལྡན་པའི་ངེས་པ་མི་འདུག་པས།",
    "ཅི་ཡང་ཤེས་པར་འདུག་ཅེས་ངན་སྐུར་བཏབ།",
    "བཞུགས་པས་ཁོ་རང་ལུས་ལ་ཁྲག་ཟག་ནས།",
    "ང་རང་གསེར་འཚོལ་ཕྱིར་དུ་བོད་ཡུལ་འདིར།",
    "ཀླུ་དེ་ཉིད་ཀྱང་རྒྱལ་པོར་ཞེ་གནག་འདུག།",
    "འདུག་དུ་འགྲོ་གསུངས་ཆིབས་ཀྱི་སྟེང་ཉིད་ནས།",
    "ཁོ་ནར་འདུག་པས་རྒྱལ་པོའི་ཐུགས་སྐྱོ་ནས།",
    "ཁྲག་མང་བསྐྱུགས་ཏེ་འགྱེལ་ནས་འདུག་པ་ལ།",
    "ཁྱེད་རང་གཉིས་པོ་བརྩོན་འགྲུས་མཆོག་ལྡན་པས།",
    "ནངས་པར་བེ་རོ་ཙ་ན་བྱུང་འཕྲལ་དུ།",
    "ཅི་ཡང་མི་འདུག་ཏ་ལའི་ལོ་མ་ཡང་།",
    "སྟོང་པ་མ་གཏོགས་ཡི་གེ་བྲིས་མི་འདུག།",
    "ད་ནི་ཁོ་རང་ཐོངས་ཤིག་ཟེར་བཞིན་དུ།",
    "བེ་རོ་ཙ་ནས་དབུ་རྩེ་ཐང་དུ་ནི།",
    "དེ་རྗེས་སློབ་དཔོན་བེ་རོ་ཙ་ན་ཉིད།",
    "ང་རང་རྗེ་གཉིས་མཇལ་དུ་མཆི་ངེས་སོ།",
    "ནམ་ལངས་སྟེང་དུ་ཉི་ཤར་ཇི་བཞིན་འདུག།",
    "ང་རང་བོད་ཀྱི་རྒྱལ་བློན་ཀུན་བགྲོས་ནས།",
    "བ་གོར་ལོ་ཙཱ་བཱ་རོ་ཙ་ན་ཡིན།",
    "རང་རང་སོ་སོར་གོ་ལུགས་གསུམ་བྱུང་བ།",
    "སློབ་དཔོན་ཁྱེད་རང་ཕྱི་ལྟར་དགེ་སློང་ལ།",
    "འདུག་གམ་སྙམས་པའི་ཀུན་སློང་ཤར་བའི་ཚེ།",
    "བྱེ་མ་གསེར་དུ་བསྒྱུར་ནས་འདུག་པ་ལ།",
    "བོད་རྣམས་མ་ཐུལ་ཁོ་རང་སྤྲུགས་བཏང་བས།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ནས་འདི་སྐད་ཅེས།",
    "བྱས་པས་ཁོང་རང་དགའ་ཞིང་བག་ཕེབས་གྱུར།",
    "གར་འདུག་ལྟོས་ལ་སུ་ཡིན་དྲིས་ཤོག་ཅེས།",
    "ཞིག་ལས་ཆང་ཉོས་གསོལ་བཞིན་འདུག་པ་ན།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན་ཞེས་བྱ་བའི།",
    "བེ་རོ་ཙ་ན་སྤྲུགས་པར་འགྱོད་བཞིན་དུ།",
    "བེ་རོ་ཙ་ན་སྤྱན་དྲངས་བོད་ཡུལ་དུ།",
