    "དེས་ན་བྱས་པའི་ཕྱིར་མི་རྟག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་འདིར་བྱས་པ་ཉིད་ཉེ་བར་སྦྱར་བས་གཏན་ཚིགས་གསལ་པོར་བསྟན་པ་ཡིན་ནོ།",
    "དེས་ན་སུན་འབྱིན་པ་བརྗོད་པ་འདི་ནི་མ་འབྲེལ་པ་ཉིད་ཡིན་ནོ་ཞེས་ཤེས་པར་བྱའོ།",
    "བུམ་པ་ཞེས་བྱ་བའི་སྒྲས་ཉེ་བར་མཚོན་ནས་དངོས་པོ་གཞན་མ་ལུས་པར་བསྡུ་བར་འདོད་པས་སྣམ་བུ་ལ་སོགས་པའི་སྒོ་ནས་ཀྱང་མ་ངེས་པར་འགྱུར་བའི་སྐྱོན་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་གཉིས་ཀ་ལ་ངེས་པར་གྲུབ་པ་དེ་ཉིད་སྒྲུབ་པར་བྱེད་པ་དང་།",
    "སུན་འབྱིན་པར་བྱེད་པ་ཡིན་གྱི་ཅིག་ཤོས་ལ་རབ་ཏུ་གྲུབ་པ་དང་།",
    "ཞར་ལ་འོངས་པས་ཆོག་གོ་ཞེས་གསུངས་སོ།",
    "བྱེད་པ་པོ་དང་ལྷན་ཅིག་ཏུ་གནས་པར་འགལ་བ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་ནི་ས་བོན་དང་ལྷན་ཅིག་གནས་པ་འགལ་བའི་ཕྱིར་རོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེས་ན་བྱེད་པ་དང་ལྷན་ཅིག་གནས་པར་འགལ་བ་ཉིད་ཀྱི་ཕྱིར་ས་བོན་མི་དམིགས་པ་ཡིན་ནོ་ཞེས་གང་སྨྲས་པ་དེ་མ་ཡིན་ནོ།",
    "ད་ནི་ཐ་མི་དད་པ་ཉིད་ཀྱང་རིགས་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྫས་ཀྱི་ཁྱད་པར་ཡོངས་སུ་འགྱུར་བས་ཐོབ་པར་བྱ་བ་སྟེ་ཞེས་བྱ་བ་ནི་རྫས་ཀྱི་ཁྱད་པར་ཡོངས་སུ་འགྱུར་བ་སྟེ།",
    "ཐ་མི་དད་པར་ཞེས་བྱ་བ་ནི་ས་བོན་བཞིན་དུའོ།",
    "དེས་ན་དེ་དེའི་ངོ་བོ་ཞེས་བརྗོད་པར་རིགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཐ་མི་དད་པ་ཡིན་ན་གནས་སྐབས་ཞིག་པས་གནས་སྐབས་ཅན་ཡང་ཞིག་པས་ཅི་ལྟར་ཐ་མི་དད་པར་བརྗོད་ཅེས་པས་སོ།",
    "སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་ནི་ས་བོན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཕྱོགས་གཉིས་པ་ཁས་ལེན་ན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འཇིག་རྟེན་པའི་གནོད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཉིད་རྟོགས་པར་འདོད་པའི་ལུགས་གཞན་དུ་བརྟགས་པའི་ཞེས་བྱ་བ་ནི་དེ་ཁོ་ན་ཉིད་མངོན་སུམ་དུ་བྱེད་པར་འདོད་པས་ནི་དེ་ཉིད་རྟོགས་པར་འདོད་པ་སྟེ།",
    "འབྲས་བུ་མཐོང་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་འབྲས་བུ་མི་འཇུག་པར་མཐོང་བ་ཡིན་ནོ།",
    "ཁྱད་པར་དུ་མ་མཛད་ཅེས་པ་ནི་དོན་དམ་པས་ཁྱད་པར་དུ་མ་མཛད་པའོ།",
    "ཁྱད་པར་དུ་བྱེད་པས་ཞེས་བྱ་བ་ནི་རང་ལས་སྐྱེ་བ་འགོག་པ་ལ་དོན་དམ་པར་ཞེས་བྱ་བའི་ཁྱད་པར་ཁས་ལེན་པའོ།",
    "རང་ལས་སྐྱེ་བ་ལ་ཡང་སྐྱོན་གཞན་ཡང་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རང་ལས་སྐྱེ་བར་འདོད་ན་བསྐྱེད་པར་བྱ་བ་དང་།",
    "སྐྱེད་པར་བྱེད་པ་དང་།",
    "དེ་ལས་བསྐྱེད་པར་བྱ་བ་དང་།",
    "སྐྱེད་པར་བྱེད་པ་ཉིད་གཅིག་ཏུ་འགྱུར་བ་ནི་ཕ་དང་བུ་ལྟ་བུའོ།",
    "གལ་ཏེ་སྐྱེ་བའི་གནས་སྐབས་ཡིན་པས་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པ་དག་གཅིག་ཉིད་དུ་འགྱུར་གྲང་།",
    "བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པ་དག་གཅིག་ཡིན་གྲང་།",
    "དེ་ནི་དམ་བཅའ་བ་ཙམ་ཡིན་པས་རིགས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་ཤིང་ནི་བསྲེག་པར་བྱ་བའི་ཤིང་ལ་སོགས་པའི་ལས་སུ་གྱུར་པ་གང་ཡིན་པའོ།",
    "བྱེད་པ་པོ་ནི་སྲེག་པར་བྱེད་པའི་མེའོ།",
    "བདེན་པ་གཉིས་ཤེས་པར་བྱ་བའི་དོན་དམ་པའི་བདེན་པ་དང་།",
    "ཡང་ན་ཁྱེད་ལ་དངོས་པོ་རྣམས་སྐྱེ་བ་མེད་པ་ཉིད་དུ་ངེས་པ་གང་ལས་སྐྱེ་བར་འགྱུར་བ་དེ་ཉིད་ཀྱིས་ཁོ་བོ་ཅག་ལ་ཡང་དངོས་པོ་ཐམས་ཅད་ཡོད་པའི་ཕྱིར་འགྲུབ་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ལན་བརྗོད་པར་བྱ་སྟེ།",
    "འདིར་མ་ངེས་པར་ཡོད་པར་འགྱུར་ན་དེ་ལ་ལྟོས་པའི་དེའི་གཉེན་པོ་ངེས་པ་ཡོད་པར་འགྱུར་གྱི།",
    "ཐམས་ཅད་ཁོ་བོ་བརྗོད་པར་མི་བྱའོ།",
    "འོན་ཀྱང་འཇིག་རྟེན་པ་ལ་སྒྲུབ་པའི་རིགས་པ་གང་ཡིན་པ་དེ་གཞན་ལ་རྟོགས་པའི་དོན་དུ་ཁས་བླངས་ནས་དེ་ཉིད་ཀྱིས་འཇིག་རྟེན་པ་རྣམས་ལ་རྟོགས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "འཕགས་པ་རྣམས་ཀྱིས་དེ་དག་ལ་གྲུབ་པའི་རིགས་པས་ཁོང་དུ་ཆུད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དཔེར་ན་བུམ་པ་ཡོད་པ་དེ་འཇིམ་པ་ལ་སོགས་པ་ལས་མི་སྐྱེ་བ་ཡིན་ནོ་ཞེས་ཁས་ལེན་པ་དེ་བཞིན་དུ་བུམ་པ་སྐྱེས་པའི་སྔོན་རོལ་ན་ཡང་ཡོད་པའི་ཕྱིར་དེ་ལ་སྐྱེ་བ་མེད་དོ་ཞེས་ངེས་པར་གྱིས་ཞེས་པའོ།",
    "ཇི་ལྟར་རྐཞན་དུ་གྱུར་པའི་འབར་བ་དང་སོལ་བ་ལ་སོགས་པ་ལས་མྱུ་གུ་སྐྱེ་བ་མ་ཡིན་ནོ་ཞེས་ཁས་ལེན་པ་དེ་བཞིན་དུ་བརྗོད་པར་འདོད་པའི་ས་བོན་ལ་སོགས་པ་ལས་ཀྱང་སྐྱེ་བ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་ངེས་པར་གྱིས་ཞེས་པའི་དོན་ཏོ།",
    "དེས་ན་ཉམས་སུ་མྱོང་བའི་ཕྱིར་བདེན་ཞེས་བྱ་བ་དེ་ཉིད་ཀྱང་བསྒྲུབ་པར་བྱ་བ་ཡིན་པས་དེའི་སྒོ་ནས་ལན་གདབ་པར་མི་རིགས་སོ།",
    "འོ་ན་རྫས་སུ་བརྗོད་པ་དེའི་འབྲས་བུ་བརྗོད་པར་བྱ་དགོས་ཏེ།",
    "ཁོ་བོས་དེའི་མཚན་ཉིད་ཡང་དག་པར་བརྗོད་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཅི་ལྟར་འགྲུབ་པར་གྱུར་པ་སྨོས།",
    "གལ་ཏེ་ཐུག་པ་མེད་པར་འགྱུར་གྲང་།",
    "ཁྱད་པར་གྱི་ནི་རྟགས་བརྗོད་དགོས།",
    "འགའ་ཞིག་ནི་མ་ཡིན་ནོ་ཞེས་སྒྲུབ་པར་བྱེད་པའི་ཁྱད་པར་གྱི་གཏན་ཚིགས་བརྗོད་དགོས་པ་ལ།",
    "དེ་ལ་འགའ་ཞིག་ལན་འདེབས་པར་བྱེད་དེ།",
    "དོན་གྱི་བྱ་བ་སྒྲུབ་པར་བྱེད་པས་སྣང་བ་དང་།",
    "འདི་ལྟར་གལ་ཏེ་དེར་མེ་མེད་པར་གྱུར་ན་དུ་བ་ཡང་ཡོད་པར་མི་འགྱུར་ལ།",
    "གལ་ཏེ་དུ་བ་མེད་པར་གྱུར་ན་དུ་བ་མི་རྟོགས་པ་དང་།",
    "དུ་བ་ངེས་པར་ཡང་མི་འགྱུར་རོ།",
    "དེས་ན་མི་ཤེས་པར་ཡང་མི་འགྱུར་རོ།",
    "དོན་གྱི་བྱ་བ་སྒྲུབ་པར་བྱེད་པ་སྣང་བའི་མངོན་སུམ་གྱི་ཤེས་པ་ནི་རྒྱུ་གཉིས་ལ་སྐྱེ་བ་ཡིན་ཏེ།",
    "འཁྲུལ་པ་དང་འཁྲུལ་པ་མ་ཡིན་པ་དག་རང་ཉིད་ཀྱིས་ངེས་པར་འགྱུར་བས་སོ།",
    "གང་དོན་གྱི་བྱ་བ་སྒྲུབ་པར་བྱེད་པའི་སྣང་བ་མ་གོམས་པའི་རྒྱུད་ལ་སྐྱེ་བ་དེ་ལ་བདེན་ནམ་མི་བདེན་སྙམ་པའི་ཐེ་ཚོམ་སྐྱེར་ཟིན་ཀྱང་།",
    "ཐུག་པ་མེད་པར་ཡང་མི་འགྱུར་ཏེ།",
    "དེ་ལ་ལན་བརྗོད་པར་བྱ་སྟེ།",
    "སད་པའི་དུས་ཀྱི་དོན་གྱི་བྱ་བ་ལ་ཁྱད་པར་ཡོད་པས་རྨི་ལམ་དུ་མཐོང་བ་དེ་དོན་གྱི་བྱ་བ་མ་ཡིན་པས་རྨི་ལམ་དུ་མཐོང་བའི་དོན་གྱི་བྱ་བའི་ཤེས་པས་ཐེ་ཚོམ་སྐྱེ་བ་མ་ཡིན་ཏེ།",
    "འདི་ལྟར་སད་པའི་གནས་སྐབས་ཀྱི་དོན་གྱི་བྱ་བ་གང་ཡིན་པ་དེ་ནི་མཐུན་པར་སྣང་བ་ཡིན་ཏེ།",
    "རྨི་ལམ་དུ་མཐོང་བ་ནི་མཐུན་པར་སྣང་བ་མ་ཡིན་ཏེ།",
    "དེས་ན་མཐུན་པར་སྣང་བ་མ་ཡིན་པའི་ཕྱིར་རྨི་ལམ་དུ་མཐོང་བ་ནི་དོན་གྱི་བྱ་བ་མ་ཡིན་པ་ཉིད་དོ།",
    "གཞན་ཡང་རྨི་ལམ་གྱི་དོན་གྱི་བྱ་བ་ནི་འབད་པ་མེད་པར་གྲུབ་པ་ཡིན་ཏེ།",
    "གཞན་ཡང་རྨི་ལམ་ན་མཐོང་བའི་དོན་གྱི་བྱ་བ་ནི་རྫོགས་པར་མི་དམིགས་ཏེ།",
    "འདི་ལྟར་སད་པའི་གནས་སྐབས་ན་ཁྲུས་བྱས་ཏེ་ཁ་ཁྱཟས་ཟོས་ན་ཞུསྐྲ་གཤེར་བའི་གནས་སྐབས་དང་།",
    "འོན་ཏེ་སད་པའི་གནས་སྐབས་ན་མཐོང་བའི་སྐྱེས་བུ་རྣམས་དང་མཐུན་པར་སྣང་བ་མ་ཡིན།",
    "དེས་ན་མཐུན་སྣང་མ་ཡིན་པའི་ཕྱིར་དོན་གྱི་བྱ་བ་ཡིན་པར་མི་རིགས་སོ་ཞེས་བྱ་བ་དེ་མི་འཐད་དོ།",
    "དྲོ་བ་ལ་སོགས་པ་འཇུག་པའི་དུས་སུ་གྲང་བ་ལ་སོགས་པ་ཡོད་ཀྱང་དོན་གྱི་བྱ་བ་མ་ཡིན་པར་མི་འགྱུར་བ་དེ་བཞིན་དུ་རྨི་ལམ་གྱི་གནས་སྐབས་ན་ཡང་ཡིན་པས་འགལ་བ་ཅི་ཞིག་ཡོད།",
    "གཉིད་ཀྱི་སྟོབས་ཀྱིས་དྷིལུས་ཁྱད་པར་ཅན་གཞན་སྐྱེད་པ་ཡིན་པས་སོ།",
    "འབད་རྩོལ་མེད་པ་ལས་ཀྱང་དོན་གྱི་བྱ་བ་མེད་པར་མི་འགྱུར་ཏེ།",
    "གལ་ཏེ་འགལ་ཞིག་ཏུ་འབད་རྩོལ་མེད་པས་བསྒྲུབ་པར་བྱ་བ་ཞེས་བརྗོད་ན།",
    "དེ་ལ་ཡང་བརྒྱ་ལམ་ན་ལྷ་ལ་སོགས་པའི་བྱིན་གྱི་རླབས་ཀྱིས་གསེར་སྲང་སྟོང་ཕྲག་གཅིག་ལ་སོགས་པ་ཐོབ་པའི་ཕྱིར་དོན་གྱི་བྱ་བ་འབད་རྩོལ་མེད་པར་འགྲུབ་པ་ཡིན་ལ།",
    "གལ་ཏེ་སད་པའི་གནས་སྐབས་ན་དོན་གྱི་བྱ་བ་རྫོགས་པར་མི་དམིགས་སོ་ཞེ་ན།",
    "དེས་ན་རྒྱུན་ཆགས་པ་མེད་པས་དོན་གྱི་བྱ་བ་མེད་པར་མི་འགྱུར་རོ།",
    "དེ་རྣམས་ཀྱི་མཚན་ཉིད་ཡང་དག་པར་བརྗོད་པ་ག་ལ་ཡོད་ཅེས་པའོ།",
    "དེ་ལ་ལན་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་རང་རིག་པ་ཡོད་པར་གྱུར་ན་དེའི་ཚེ་དེ་བརྗོད་པར་རིགས་པ་ཡིན་པ་ལ་རང་རིག་ཀྱང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "རལ་གྲིའི་སོ་དེ་ཉིད་ལ་གཅོད་པར་མི་རིགས་པ་བཞིན་ནོ།",
    "ཡང་འགེགས་པར་འགྱུར་བ་ཡིན་པས་སོ།",
    "རིམ་དང་ཅིག་ཅར་གྱིས་དོན་བྱེད་པར་འགལ་བའི་ཕྱིར་རོ།",
    "མི་རྟག་པ་ཉིད་ཡིན་ན་ཡང་རིམ་དང་ཅིག་ཅར་གྱིས་དོན་བྱེད་པར་འགལ་བ་ཁོ་ན་ཡིན་གྱི།",
    "སྐབས་སུ་བབ་པ་བརྗོད་པར་བྱ་སྟེ།",
    "མི་རིགས་པ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྒྱུའི་རྐྱེན་ལ་སོགས་པ་རྣམས་ཀྱི་མཚན་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མཚུངས་པར་ལྡན་པའི་རྒྱུ་དང་།",
    "རྣམ་པར་སྨིན་པའི་རྒྱུའོ།",
    "གེགས་བྱེད་པར་མི་ནུས་པ་རྣམས་གེགས་མི་བྱེད་པའི་སྒོ་ནས་བྱེད་པའི་རྒྱུར་ཅི་ལྟར་འགྱུར་ཏེ།",
    "དེས་ན་གཉིས་ཀ་ལ་ཡང་གེགས་མི་བྱེད་པར་འགྱུར་བ་ཡོད་པས་བྱེད་པའི་རྒྱུ་ཉིད་དུ་འགལ་བ་མེད་དོ།",
    "མཚུངས་པར་ལྡན་པའི་རྒྱུ་ནི་རྟེན་གཅིག་པའི་སེམས་དང་སེམས་ལས་བྱུང་བ་དག་སྟེ།",
    "རྫས་མཚུངས་པ་སྟེ་ལྔའི་སྒོ་ནས་མཚུངས་པར་ལྡན་པའི་རྒྱུ་ཡིན་ཏེ།",
    "ལོག་པར་ལྟ་བ་དང་།",
    "ཀུན་འབྱུང་མཐོང་བས་སྤང་བར་བྱ་བའི་ལོག་པར་ལྟ་བ་དང་།",
    "དེ་ལ་དམིགས་པར་བྱ་བས་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་འདུས་བྱས་དང་།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་སྐྱེད་པར་བྱེད་པའོ།",
    "ཕྱི་ནས་སྐྱེ་བ་ལ་སོགས་པ་ནི་དཔེར་ན་དུས་ཐམས་ཅད་དངོས་པོ་ཡོད་པར་སྨྲ་བ་རྣམས་ཀྱིས་དངོས་པོར་གྱུར་པའི་མ་འོངས་པ་ཤེས་པའི་རྒྱུར་འདོད་པ་བཞིན་ནོ།",
    "ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐ་དད་པ་ནི་ནམ་ཡང་འཐད་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་དམ་བཅའ་བ་ཙམ་ཡིན་པས་འཐད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྒྱུ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐྱོན་གཞན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་སྒྲུབ་བྱེད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་སྐྱེད་པར་བྱེད་པར་འདོད་པའི་མེ་དུ་བ་ལས་གཞན་ཉིད་ཡིན་པ་དེ་བཞིན་དུ་ས་བོན་ལ་སོགས་པ་ལས་གཞན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་འདི་ངེས་པ་ནི་འདི་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེས་ན་སྐྱེད་པར་བྱེད་པ་ལས་ཞེས་བྱ་བ་ནི་སྔ་མའི་སྐད་ཅིག་མ་སྔ་མ་ཁོ་ན་ལས་ཡིན་གྱི།",
    "སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པའི་སྐད་ཅིག་མ་ཕྱི་མ་ལས་ནི་མ་ཡིན་ནོ།",
    "དེ་ལ་ལན་འདེབས་པ་ནི་མི་རུང་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་སྒྲུབ་པར་བྱེད་པ་མི་རིགས་པས་སོ།",
    "གལ་ཏེ་ངེས་པར་མཐོང་བའི་ཕྱིར་ཞེས་བྱ་བ་འདིས་ནུས་པ་ངེས་པ་ཡིན་ནོ་ཞེས་བརྗོད་ན་དེ་ལ་ཡང་མཚུངས་པ་ཡིན་ཏེ།",
    "གཞན་ལ་ཡང་ནུས་པ་ཅིའི་ཕྱིར་ཡོད་པར་མི་འགྱུར།",
    "གལ་ཏེ་ངེས་པ་མཐོང་བས་ནུས་པ་ངེས་པར་སྒྲུབ་པར་མི་བྱེད་ཀྱི།",
    "འོ་ན་ངེས་པ་མཐོང་བའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་དེ་དགོད་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "སྔར་ནུས་པ་ངེས་པར་ཁས་བླངས་ནས་སྐྱོན་བརྗོད་པ་ཡིན་ལ།",
    "ད་ནི་ནུས་པ་ངེས་པ་ཉིད་དང་མི་སྲིད་པ་ཉིད་དུ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ད་ནི་གཏན་ཚིགས་སུ་བཀོད་པའི་གཞན་ཉིད་ཀྱང་མ་གྲུབ་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ནི་མྱུ་གུ་མ་སྐྱེས་ན་མྱུ་གུ་ལ་ལྟོས་པའི་ས་བོན་ལས་གཞན་པ་ཉིད་མ་གྲུབ་པས་ས་བོན་ལས་གཞན་པ་ཉིད་ག་ལ་ཡོད་པར་འགྱུར་ཞེས་པའོ།",
    "ས་བོན་རྣམ་པར་མ་གྱུར་པར་ཞེས་བྱ་བ་ནི་འདས་པ་ལ་སོགས་པར་མ་གྱུར་ནའོ།",
    "གང་ཡོད་པས་ཡོད་པར་མཚོན་པ་ཞེས་བྱ་བ་ལ་གང་ཡོད་པས་ཞེས་བྱ་བ་ནི་རྐྱེན་ལ་སོགས་པ་ཡོད་པས་སོ།",
    "ཡོད་པ་མཚོན་པ་ཞེས་བྱ་བ་ནི་འབྲས་བུ་ཡོད་པར་མཚོན་པའོ།",
    "དེ་ཡོད་ན་ཡོད་པར་མཚོན་པ་དང་།",
    "མེད་པར་ཡང་ཞེས་བྱ་བ་ནི་གལ་ཏེ་འབྲས་བུ་དེ་རྐྱེན་ལ་སོགས་པ་རྣམས་ལ་བརྟེན་པ་ཉིད་དུ་ཡོད་པར་མ་གྱུར་ནའོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ལྟར་གང་ཁོ་ནའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ཉིད་དཔེའི་སྒོ་ནས་སྟོན་པ་ནི་ཇི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དུས་མཉམ་པ་མ་ཡིན་པ་ནི་མིན་པར་ཞེས་བྱ་བ་ནི་དགག་པའི་ཚིག་གཉིས་ཀྱིས་སྐབས་སུ་བབ་པའི་དོན་གོ་བར་བྱེད་པ་ཡིན་ནོ་ཞེས་པ་སྟེ།",
    "དུས་མཉམ་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་པའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟ་ན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དུས་གཅིག་པ་ཉིད་མི་རིགས་པར་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཅི་ལྟར་ཡོད་པ་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་བྱ་བ་སྲིད་པར་ཁས་བླངས་ཏེ།",
    "ད་ནི་བྱ་བ་ཉིད་ཀྱང་མི་སྲིད་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ལྷ་སྦྱིན་འགྲོ་བ་བཞིན་ནོ།",
    "རྟེན་མེད་པར་ཞེས་བྱ་བ་ནི་མྱུ་གུ་མེད་པར་རོ།",
    "མེད་ན་ཞེས་བྱ་བའི་དངོས་པོའི་ཁྱད་པར་རོ་ཞེས་བྱ་བའི་བྱེད་པ་པོའི་མཚན་ཉིད་ཀྱི་དངོས་པོ་མེད་པར་གྱུར་ནའོ།",
    "དོན་འདི་ཉིད་ལ་ལུང་དང་འགལ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་སྲང་མདའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་གོ་སླའོ།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་གཞན་ལས་སྐྱེ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "རྣམ་པར་དཔྱད་ན་གཞན་ལས་སྐྱེ་བ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་དམ་པའི་རང་བཞིན་ཅན་གྱི་དངོས་པོ་སྐྱེ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར་ཡང་མ་ཡིན་ཏེ།",
    "རྒྱུ་དང་འབྲས་བུ་མི་འཐད་པའི་ཕྱིར་དོན་དམ་པར་དངོས་པོ་མེད་པས་སོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་ལན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མིག་ལ་སོགས་པ་ལས་གཞན་ཉིད་ཡོད་པར་འགྱུར་ནའོ་ཞེས་པའོ།",
    "དེའི་ཚེ་གཞན་ཉིད་དེ་ཡོད་པ་ཉིད་ཟིན་ཀྱང་གང་ཡོད་པར་གྱུར་པ་དེ་ལ་སྐྱེ་བ་དགོས་པ་ཅི་ཞིག་ཡོད་ཅེས་སོ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མཇུག་ཉེ་བར་བསྡུ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་དེ་ལྟར་གཞན་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ལྟར་གལ་ཏེ་འབྲས་བུ་སྐྱེས་པར་གྱུར་ན།",
    "དེའི་ཚེ་འབྲས་བུ་ལ་ལྟོས་པའི་རྒྱུ་གཞན་ཉིད་དུ་ཡོད་པར་འགྱུར་བ་ཡིན་པ་ལས།",
    "སྒྲ་ཙམ་འབའ་ཞིག་ལུས་པར་འགྱུར་ཏེ་ཞེས་བྱ་བ་ནི་བརྟགས་ཤིང་དཔྱད་ན་དོན་གཞན་གྱིས་སྟོང་པའི་དུསྒྲ་ཙམ་ལུས་པའོ།",
    "དེ་ལྟར་རྒྱུ་དང་འབྲས་བུ་དག་ཅིག་ཅར་ཡོད་པ་མ་ཡིན་པས་གཞན་ཉིད་མི་སྲིད་པར་བསྟན་ནས་ད་ནི་འབྲས་བུ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་འབྲས་བུ་རྒྱུའི་དུས་ལ་ལྟོས་པ་ཡོད་པ་མ་ཡིན་པ་དང་།",
    "ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་ཉིད་དུ་བསྟན་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར།",
    "ཡོད་པའམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འོན་ཏེ་ཡོད་པ་ཡང་མ་ཡིན་མེད་པ་ཡང་མ་ཡིན་པ་གཉིས་ཀ་མ་ཡིན་པའི་རང་བཞིན་ཅན་ཞིག་སྐྱེད་པར་བྱེད།",
    "དེ་ལ་ཡོད་པ་ནི་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "མེད་པ་ཡང་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "གཉིས་ཀུའི་རང་བཞིན་ཅན་ཡང་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཕྱོགས་གཉིས་ཀ་ལ་བསྟན་པའི་སྐྱོན་ཡོད་པར་འགྱུར་བས་སོ།",
    "ཡོད་པ་དང་མེད་པ་གཉིས་ཀ་མ་ཡིན་པ་ཡང་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་དག་རྒྱུའི་གནས་སྐབས་ན་འབྲས་བུ་ཡོད་པར་སྨྲ་བ་ཡིན་ཏེ།",
    "སྔར་མེད་པའི་རྫས་སྐྱེད་པར་བྱེད་པ་ནི་མ་ཡིན་ནོ་ཞེས་འདོད་པའོ།",
    "སེམས་ཙམ་པ་རྣམས་ནི་འབྲས་བུ་མེད་པར་སྨྲ་བ་ཡིན་ཏེ།",
    "དེ་ལ་བྱེ་བྲག་པ་རྣམས་ནི་ས་ལ་སོགས་པའི་རྡུལ་ཕྲ་རབ་ལས་རྡུལ་ཕྲ་རབ་གཉིས་པ་ལ་སོགས་པའི་ཡན་ལག་ཅན་གྱི་རྫས་སྐྱེ་བ་ཡིན་ནོ་ཞེས་འདོད་པས་འབྲས་བུ་མེད་པར་སྐྱེ་བ་ཁས་ལེན་པ་ཡིན་ནོ།",
    "རྣམ་པ་གཞན་གྱིས་ཁྱིམ་དེ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་ཁས་ལེན་ན་འབྲས་བུ་མེད་པར་ཁས་ལེན་པར་འགྱུར་བས་སོ།",
    "གང་ཡང་འབྲས་བུ་མེད་པར་ཁས་ལེན་པ་དེ་ཡང་ཇི་སྐད་དུ་བསྟན་པའི་ཀ་བ་ལ་སོགས་པའི་རྒྱན་ཡང་དོན་མེད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་འབྲས་བུ་མེད་པར་སྨྲ་བ་རྣམས་ལ་ཡང་འབྲས་བུར་གྱུར་པའི་ཁྱིམ་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་སྐྱོན་དེ་སྤང་བར་བྱ་བའི་ཕྱིར་འབྲས་བུ་རྣམ་པ་ཐམས་ཅད་དུ་མེད་པ་ཉིད་དུ་ཁས་མི་ལེན་ན་འབྲས་བུ་མེད་པར་སྨྲ་བ་ཉམས་པར་འགྱུར་རོ།",
    "མྱུ་གུ་ལ་སོགས་པ་དངོས་པོ་ཐམས་ཅད་ལ་ཡོད་པ་དང་མེད་པར་བརྟགས་པས་མ་རིག་པ་དང་ས་བོན་ལ་སོགས་པའི་རྒྱུ་རྣམས་དོན་མེད་པ་ཉིད་དུ་བརྗོད་པར་བྱའོ།",
    "འབྲས་བུའི་ངོ་བོ་ཉིད་ཡོད་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གལ་ཏེ་རྒྱུས་འབྲས་བུ་སྐྱེད་པར་བྱེད་ན་དེས་འབྲས་བུ་ཡོད་པ་ཞིག་སྐྱེད་དམ་འོན་ཏེ་མེད་པ་ཞིག་སྐྱེད་གཉིས་ཀ་ཡང་མི་རིགས་ཏེ།",
    "ངོ་བོ་ཉིད་ཀྱིས་མེད་པའི་འབྲས་བུ་དེ་ཡང་རྒྱུས་སྐྱེད་པར་མི་བྱེད་དེ།",
    "དེ་ལ་གཞན་དག་ནི་རྒྱུས་འབྲས་བུ་སྐྱེད་པའི་བྱ་བ་བྱེད་པར་ཁས་བླངས་ན།",
    "འོན་ཀྱང་འབྲས་བུ་སྐྱེད་པའི་བྱ་བ་མི་བྱེད་པར་རྒྱུའི་ངོ་བོ་ཉིད་དུ་ཡོད་པ་ཡིན་ལ།",
    "འབྲས་བུ་མེད་ན་ཡང་རྒྱུ་རྒྱུ་ཉིད་དུ་མི་འགྲུབ་པ་ཡིན་པས་དེའི་ཕྱིར་འབྲས་བུ་ཡང་ཡོད་པར་འགྱུར་བ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་ལན་ནི་གལ་ཏེ་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་རྒྱུ་ཉིད་དུ་འགྲུབ་ན་དེ་རྒྱུར་འགྱུར་བ་ཡིན་པ་ལས་སྐྱེད་བྱེད་མ་ཡིན་པ་རྒྱུ་ཉིད་དུ་ཅི་ལྟར་རིགས།",
    "དེ་ལ་ལན་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ནི་ཡོད་པ་དང་མེད་པའི་རང་བཞིན་ཅན་གྱི་དངོས་པོ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དངོས་པོ་མེད་པ་དག་མྱ་ངན་ལས་འདས་པ་གཅིག་ཉིད་ལ་མི་སྲིད་པས་མྱ་ངན་ལས་འདས་པ་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ཅི་ལྟར་ཡོད་པར་འགྱུར་ཏེ།",
    "ཡོད་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་པའི་དོན་ཏོ།",
    "བསྐྱེད་པར་བྱ་བའི་རང་བཞིན་ཅན་དང་།",
    "བསྐྱེད་པར་བྱ་བ་མ་ཡིན་པའི་རང་བཞིན་ཅན་གྱི་ལས་མི་བྱེད་དེ།",
    "དངོས་པོ་གཅིག་ལ་དུས་གཅིག་ཏུ་བསྐྱེད་པར་བྱ་བའི་རང་བཞིན་ཅན་དང་།",
    "བསྐྱེད་པར་བྱ་བ་མ་ཡིན་པའི་རང་བཞིན་ཅན་དུ་མི་རིགས་པས་སོ།",
    "ཕྱོགས་བཞི་པ་དགག་པར་བྱ་བའི་ཕྱིར་གཉིས་ཀ་དང་བྲལ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་གོ་སླའོ།",
    "ཅུང་ཟད་ཀྱང་ཁྱད་པར་དུ་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཡོད་པ་དང་མེད་པ་དག་བཀག་པས་ཁྱད་པར་དུ་བྱས་པའི་དངོས་པོ་ཅུང་ཟད་ཀྱང་མེད་པས་སོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གལ་ཏེ་དངོས་པོ་ཞེས་བྱ་བ་འགའ་ཞིག་ཡོད་པར་གྱུར་ན།",
    "དེ་བཀག་པས་མྱ་ངན་ལས་འདས་པ་དངོས་པོ་མེད་ཅེས་བརྟག་པར་མི་རིགས་པ་དང་།",
    "གལ་ཏེ་དངོས་པོ་མེད་པ་འགའ་ཞིག་གྲུབ་ན་དེ་བཀག་པས་མྱ་ངན་ལས་འདས་པ་དངོས་པོར་གྲུབ་པར་འགྱུར་བ་ལས།",
    "འདིས་ནི་གཉིས་དང་བྲལ་བ་ཡང་མེད་པ་ཡིན་ནོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་འཇིག་རྟེན་པའི་སྒོ་ནས་གཞན་ལས་སྐྱེ་བ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "བརྗོད་པར་འདོད་པའི་དོན་གྲུབ་པ་ཞེས་བྱ་བ་ནི་བརྗོད་པར་འདོད་པའི་དོན་གཞན་ལས་སྐྱེ་བ་གྲུབ་པའོ།",
    "དེ་ལ་གཞན་གྱི་ལན་ནི་དེ་ནི་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བརྗོད་པར་འདོད་པའི་དོན་གྲུབ་པ་ཉིད་ཡིན་ནོ་ཞེས་པའོ།",
    "དོན་གང་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འཇིག་རྟེན་པ་འདི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ཁོ་ན་ལས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གལ་ཏེ་རིགས་པ་བརྗོད་པར་འདོད་ན་དངོས་པོ་མངོན་སུམ་པ་ལ་འམ།",
    "འདིར་གཞན་ལས་སྐྱེ་བར་མངོན་སུམ་གྱིས་འགྲུབ་པར་རིགས་པས་ཅི་ཞིག་བྱ།",
    "དེ་ལ་ལན་གྱི་རིམ་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གང་ཞིག་བསྟན་བཅོས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡི་མུག་པར་གྱུར་པ་ནི་ལན་བརྗོད་པར་མི་ནུས་པའོ།",
    "ཁྱད་པར་ཅན་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་པ་ལ་གྲགས་པ་ཉིད་དོ།",
    "བདེན་པ་གཉིས་ཀྱི་རྣམ་པར་གཞག་པ་ཞེས་བྱ་བ་ནི་ཀུན་རྫོབ་དང་དོན་དམ་པའི་བདེན་པ་གཉིས་ཀྱི་རྣམ་པར་གཞག་པ་སྟེ།",
    "དེ་ལ་ཡུལ་གྱི་སྒོ་ནས་ཀུན་རྫོབ་དང་དོན་དམ་པའི་རྣམ་པར་གཞག་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དངོས་པོ་ཀུན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དངོས་རྙེད་ཅེས་བྱ་བ་ནི་ཡང་དག་པར་བརྫུན་པ་མཐོང་བ་སྟེ།",
    "ངོ་བོ་གཉིས་ནི་འཛིན་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་ཡང་དག་པ་ཕྱིན་ཅི་མ་ལོག་པ་དམིགས་པ་གང་ལ་ཡོད་པ་དེ་ནི་ཡང་དག་པར་མཐོང་བ་སྟེ།",
    "མཐོང་བ་བརྫུན་པ་ཀུན་རྫོབ་བདེན་པར་གསུངས།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ན་བདེན་པ་གཉིས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་དེའི་རང་བཞིན་འཆད་པར་འགྱུར་བས་སོ།",
    "ད་ནི་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་དབྱེ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བདེན་པ་གཉིས་རྣམ་པར་བཞག་ནས་ཞེས་བྱ་བ་ནི་ཡང་དག་པ་དང་།",
    "བརྫུན་པ་མཐོང་བའི་ཡུལ་གྱི་སྒོ་ནས་བདེན་པ་གཉིས་སུ་རྣམ་པར་བཞག་ནས་སོ།",
    "གལ་ཏེ་མཐོང་བ་བརྫུན་པའི་ཀུན་རྫོབ་བདེན་པར་གསུངས་ཞེས་པའི་ཚིག་དེས་འཇིག་རྟེན་པའི་ཐམས་ཅད་བརྫུན་པར་མཐོང་བར་གསུངས་པས་དེ་རྣམས་ཡང་དག་པའི་མཐོང་བ་ཅི་ལྟར་ཡིན་ཞེ་ན།",
    "འཕགས་པ་རྣམས་ལ་ལྟོས་ནས་ཐམས་ཅད་བརྫུན་པར་མཐོང་བ་ཡིན་པས་སོ།",
    "འཕགས་པ་རྣམས་ལ་ལྟོས་ནས་བརྫུན་པར་མཐོང་བ་ཡིན་དུ་ཟིན་ཀྱང་།",
    "དེ་དང་བྲལ་བས་བརྫུན་པར་མཐོང་བ་དང་།",
    "དེས་གཟུང་བར་བྱ་བའི་དོན་དང་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་བརྫུན་པས་གཟུང་བར་བྱ་བའི་དོན་ཏོ།",
    "ཤེས་པའི་ཞེས་བྱ་བ་ནི་འཛིན་པར་བྱེད་པའོ།",
    "གཉིས་འདོད་དེ་ཞེས་བྱ་བ་ལ་གཉིས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོན་དམ་པར་ནི་བདེན་པ་མ་ཡིན་ནོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "ཏིལ་མར་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དུས་ཁྱད་པར་ཅན་དང་ཉེ་བར་གྱུར་པའི་ཉི་མའི་འོད་ཟེར་ལ་སོགས་པ་རྣམས་ནི་ཞེས་བྱ་བ་ལ།",
    "ཡུལ་ཁྱད་པར་ཅན་ནི་མྱ་ངན་གྱི་ཐང་ལ་སོགས་པའོ།",
    "དུས་ཁྱད་པར་ཅན་ནི་ཉི་མ་གུང་ལ་སོགས་པའོ།",
    "དེ་དག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཡང་དག་པ་མ་ཡིན་པས་བྱས་པའི་གྲུབ་པའི་མཐའ་ཞེས་བྱ་བ་ནི་མུ་སྟེགས་པས་བྱས་པའི་གྲུབ་པའི་མཐའོ།",
    "རྣམ་པར་གཞག་པ་ཞེས་བྱ་བ་ནི།",
    "འཆད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཅི་ལྟར་རྨི་ལམ་ཞེས་བྱ་བ་ལ་སོགས་པས་འཆད་པར་འགྱུར་བའོ།",
    "འཇིག་རྟེན་པའི་རྗེས་སུ་འབྲངས་ནས་བདེན་པ་དང་བརྫུན་པའི་རྣམ་གཞག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དཔེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མི་ཤེས་པ་གཉིད་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐྱོད་ཅེས་བྱ་བ་ནི་མི་རིགས་པའི་གཡོ་བར་བྱས་པའོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མུ་སྟེགས་ཅན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཁོ་ན་ཉིད་ལ་འཇུག་པར་འདོད་པས་ཞེས་བྱ་བ་ནི་དེ་ཁོ་ན་ཉིད་མངོན་དུ་བྱེད་པ་ལ་འཇུག་པར་འདོད་པས་སོ།",
    "ངེས་པར་མ་བཟུང་བ་ཞེས་བྱ་བ་ནི།",
    "འཇིག་པར་བརྗོད་པས་སྐྱེ་བ་དང་།",
    "འཇིག་པར་ངེས་པར་མ་བརྗོད་པའོ།",
    "གཟུགས་ལ་སོགས་པ་ལས་ཐ་དད་དུ་གྱུར་པའི་ཡན་ལག་ཅན་དུ་བརྟགས་པའི་ཕྱིར་དངོས་པོ་ངོ་བོ་ངེས་པར་མ་བཟུང་བའོ།",
    "དེ་ཉིད་རི་སྟེ་གཞིག་པར་དཀའ་བས་སོ།",
    "འབྲས་བུ་མི་ཐོབ་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་དེ་ཁོ་ན་ཉིད་ཁོང་དུ་ཆུད་པའི་རང་བཞིན་ཅན་གྱི་འབྲས་བུ་མི་ཐོབ་པས་སོ།",
    "འདིའི་དོན་ནི་ཅི་ལྟར་ཤིང་ཐོག་དོན་དུ་གཉེར་བའི་སྐྱེས་བུ་ཤིང་ཐོག་ཐོབ་པར་བྱ་བའི་ཆེད་དུ་ཤིང་ཐོག་དང་བཅས་པའི་སྡོང་པོ་ལ་འཛེག་ཅིང་ཡལ་ག་སྔ་མ་བཏང་ནས་ཡལ་ག་ཕྱི་མ་མ་བཟུང་ན་ཤིང་ཐོག་མ་ཐོབ་པར་གཡང་ས་ཆེན་པོར་ལྷུང་བར་འགྱུར་བ་དེ་བཞིན་དུ་མུ་སྟེགས་པ་རྣམས་སོ་ཞེས་པའོ།",
    "དེ་ལྟར་འཇིག་རྟེན་པའི་རྗེས་སུ་འབྲངས་ནས་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་དབྱེ་བའི་རྣམ་གཞག་བྱས་ནས་འཇིག་རྟེན་གྱི་མངོན་སུམ་གཞན་ལས་སྐྱེ་བ་འགོག་པ་ལ་གནོད་བྱེད་མ་ཡིན་ནོ་ཞེས་ཏུཉེབྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཀུན་རྫོབ་ཀྱི་རྣམ་གཞག་བྱས་ནས་སོ།",
    "དེས་ན་འཇིག་རྟེན་པའི་མངོན་སུམ་གྱིས་གཞན་ལ་སྐྱེ་བ་གྲུབ་པས་འཕགས་པའི་སྤྱོད་ཡུལ་དུ་གྱུར་པའི་གཞན་ལས་སྐྱེ་བ་མེད་པ་ལ་གནོད་པ་ཡོད་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་ལས་སྐྱེ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐྱེ་བ་དགག་པ་འདི་ཁྱད་པར་དུ་ཡིན་པ་ཞེས་བྱ་བ་ནི།",
    "འཕགས་པ་ལ་ལྟོས་ནས་དབྱེ་བའི་རྣམ་གཞག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་འདིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མེད་པ་ལ་སོགས་པར་སྒྲོ་འདོགས་པའི་ཕྱིར་རོ།",
    "བདེན་པར་སྣང་ཞེས་བྱ་བ་ནི་བདེན་པའི་རང་བཞིན་དུ་ཞེན་པའོ།",
    "ཀུན་རྫོབ་བདེན་ཞེས་ཐུབ་པ་དེས་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་དངོས་པོ་དེ་ནི་ཀུན་རྫོབ་ཀྱི་བདེན་པའོ་ཞེས་གསུངས་ཏེ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པར་ནི་མ་ཡིན་ཏེ།",
    "འཇིག་རྟེན་དང་འཕགས་པ་རྣམས་ལ་ཅི་ལྟར་རིགས་པར་དེ་དག་ལ་བདེན་པར་ཞེན་པ་མེད་པས་སོ།",
    "དེ་ཉིད་འགྲེལ་པས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ལ་འདིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མི་དམིགས་པའི་སྦྱོར་བས་མཐོང་བ་གང་ཡིན་པ་དེ་ལ་སྒྲིབ་པར་བྱེད་པ་སྟེ།",
    "བདེན་པར་སྣང་ཞིང་ཞེས་བྱ་བ་ནི་ངོ་བོ་ཉིད་མེད་པ་ལ་ཡོད་པ་དང་།",
    "དོན་དམ་པའི་བདེན་པ་དག་ཀུན་རྫོབ་ཀྱི་བདེན་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་ཞིག་ཀུན་རྫོབ་ཏུ་ཡང་བརྫུན་པ་ཞེས་བྱ་བ་ནི་གཟུགས་བརྙན་དང་བྲག་ཅ་ལ་སོགས་པ་རྣམས་ནི་ཀུན་རྫོབ་ཀྱི་བདེན་པར་མི་འགྱུར་ཏེ།"
  ]
}