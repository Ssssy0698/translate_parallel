    "དེ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་པས་སོ།",
    "འདོད་ཆགས་དང་བཅས་པ་རྣམས་འདོད་ཆགས་དང་བྲལ་བའི་བྱ་བ་བྱེད་པར་མཐོང་བ་དང་།",
    "འདོད་ཆགས་དང་བྲལ་བ་རྣམས་འདོད་ཆགས་དང་བཅས་པ་བཞིན་དུ་བྱ་བ་བྱེད་པར་མཐོང་བས་དེའི་ཕྱིར་ཉེས་པ་ཟད་པ་ཉིད་ཀྱི་རྟགས་ངེས་པར་མི་ནུས་པས་ངེས་པར་དཀའ་བ་ཡིན་ནོ།",
    "སྐྱེད་པར་བྱེད་པ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་གསལ་བར་བྱེད་ན་གསལ་བ་ཉིད་དེ་སྒྲ་རྣམས་ཀྱི་རང་བཞིན་ཁྱད་པར་ཅན་དུ་འགྱུར་བ་ཡིན་ནམ།",
    "སྒྲ་ལ་སྒྲིབ་པ་མེད་པར་འགྱུར་བའམ།",
    "འོན་ཏེ་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ལ་སྒྲ་རྣམས་རང་བཞིན་གྱི་ཁྱད་པར་དུ་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
    "རྟག་པ་ཉིད་ཡིན་པའི་ཕྱིར་སྒྲིབ་པས་སྒྲ་ལ་ཅུང་ཟད་ཀྱང་མ་བྱས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྟག་པའི་ཕྱིར་སྒྲ་རྣམས་རྒྱུན་དུ་ཤེས་པ་བསྐྱེད་པར་རུང་བ་ཡིན་པས་སོ།",
    "སྐྱེས་བུའི་དོན་རྗོད་པར་བྱེད་པ་དང་།",
    "བཏང་སྙོམས་ཀྱི་དོན་གཅིག་རྟོགས་པར་བྱེད་པ་གང་ཡིན་པའོ།",
    "རྗེས་སུ་མཐུན་པའི་ཐབས་ནི་གང་འབྲས་བུ་སྒྲུབ་པའི་ཐབས་སྒྲུབ་པར་ནུས་པ་དེ་ལ་རྗེས་སུ་མཐུན་པའི་ཐབས་ཞེས་བྱའོ།",
    "བརྗོད་པར་བྱ་སྟེ།",
