    "ལྡན་པར་གྱུར་ནས་མེ་ཏོག་གི་སྤྲིན་དང་།",
    "རོལ་མོའི་སྤྲིན་དང་།",
    "དེ་ནི་དེ་དག་གིས་ལྷའི་མིག་རྣམ་པར་དག་པར་བྱས་པའི་ཕྱིར་ཏེ།",
    "བདག་གི་ཐབས་མཁས་པའི་སྟོབས་ཀྱིས།",
    "བདག་གི་ལུས་ལ་བསྐུའོ།",
    "སྔགས་དང་རིག་སྔགས་ཀྱི་སྟོབས་དང་བྱིན་གྱི་རླབས་ཀྱིས་ཀྱང་བདག་གི་ལུས་བྱིན་གྱིས་བརླབས་ཏེ།",
    "དེ་བཞིན་ཉིད་མ་སྐྱེས་མ་འགགས་པ་དང་དུས་གསུམ་མཉམ་པ་ཉིད་ཀྱི་རྗེས་སུ་སོང་བ་རྟོག་པ་དང་།",
    "འོན་ཀྱང་བདག་གིས་གང་དུ་ཇི་ལྟར་སུ་ཡི་དོན།",
    "ཤིང་དང་པད་མོའི་ནགས་ཚལ་ས་རྣམས་གར་བབ་པའི།",
    "རྒྱལ་བའི་མཚན་ཐོས་བདེ་གཤེགས་འོད་ལ་རེག་གྱུར་ཀྱང་།",
    "སྟོང་གསུམ་ཚངས་གནས་ཀུན་ཏུ་རང་གི་ལུས་ཀྱང་སྟོན།",
    "ཚངས་པ་རང་གིས་ལུས་ཀྱང་ཐ་དད་བྱེད་པ་མིན།",
    "རང་གི་ལུས་ལ་བསྐུས་ཏེ་སྤྱོད་པ་ཐམས་ཅད་སྟོན།",
    "གང་གིས་མཐོང་གྱུར་དེ་དག་མིག་ཀྱང་རྣམ་པར་འདག།",
    "གང་གིས་རྒྱལ་བ་མཐོང་བ་དེ་དག་མིག་ལྔ་འཐོབ་པར་འགྱུར།",
    "སེམས་རབ་ཏུ་ཚིམ་པར་མཛད་པའི་ཕྱིར་འཁོར་གྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་མོས་པ་ཇི་ལྟ་བ་བཞིན་དུ་དགའ་བར་མཛད་པར་ཤེས་པར་བྱའོ།",
    "རྗོད་པར་བྱེད་པ་གང་ཡང་མེད་མོད་ཀྱི།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་ནི་སྡུག་བསྔལ་ལོ།",
    "བདག་གིར་འཛིན་པ་ནི་སྡུག་བསྔལ་སྟེ།",
    "བྲག་གི་སུལ་དང་མཚམས་ནས།",
    "རང་རང་གི་གནས་ཀྱི་འདོད་པའི་དགའ་བ་སྤངས་ནས།",
    "གང་གིས་ཀྱང་ཚིག་ཏུ་མི་བརྗོད་དོ།",
    "བདག་ཁོ་ནའི་དོན་དུ་ཚངས་པའི་སྒྲ་སྒྲོག་གོ་སྙམ་མོ།",
    "ནམ་མཁའི་དབྱིངས་ལས་ཆར་གྱི་རོ་གཅིག་པ་འབབ་ཀྱང་སྣོད་ཀྱི་རྣམ་པ་ཐ་དད་པས་ཆུ་རྣམ་པ་ཐ་དད་པར་སྣང་གི་ཆུ་ལ་རྣམ་པར་རྟོག་པ་མེད་དོ།",
    "ཕྱི་རོལ་ནས་བྱུང་བ་ཡང་མ་ཡིན་མོད་ཀྱི།",
    "རྒྱ་མཚོ་ཆེན་པོའི་ནང་ན་ལག་གིས་འགྲོ་བའི་བདག་པོ་རྒྱན་ཆེན་པོ་ཞེས་བྱ་བ་ཡོད་དེ།",
    "འོན་ཀྱང་ཀླུའི་རྒྱལ་པོ་དེའི་ཁྱུ་མཆོག་གི་མཐུ་ཕྱུང་བ།",
    "འདི་ལྟར་ལ་ལ་ནི་འཛམ་བུ་ཆུ་ཀླུང་གི་གསེར་གྱི་ཁ་དོག་ཏུ་སྣང་ངོ།",
    "ལ་ལར་ནི་ལྷའི་བུ་མོའི་གླུ་དང་རོལ་མོའི་སྒྲ་དབྱངས་ཀྱི་ང་རོ་འབྱིན་ཏོ།",
    "ལ་ལར་ནི་རོལ་མོ་བརྡུང་བ་དང་དཀྲོལ་བའི་སྒྲ་དབྱངས་ཀྱི་ང་རོ་འབྱིན་ཏོ།",
    "ལ་ལར་ནི་ཀླུའི་བུ་མོའི་གླུའི་སྒྲ་དབྱངས་སྣ་ཚོགས་ཀྱི་ང་རོ་འབྱིན་ཏོ།",
    "ལ་ལར་ནི་དྲི་ཟའི་བུ་མོའི་གླུའི་སྒྲ་དབྱངས་དང་ང་རོ་འབྱིན་ཏོ།",
    "ལ་ལར་ནི་མི་འམ་ཅིའི་བུ་མོའི་སྒྲ་དབྱངས་ཀྱི་ང་རོ་འབྱིན་ཏོ།",
    "ལ་ལར་ནི་རྒྱ་མཚོ་འབྲུག་གི་སྒྲ་ཟབ་མོའི་སྒྲ་དབྱངས་ཀྱི་ང་རོ་འབྱིན་ཏོ།",
    "མོས་པའི་ཁྱད་པར་གྱི་ཚུལ་ཇི་ལྟ་བ་བཞིན་དུ་ལས་ཀྱི་རྣམ་པ་སྣ་ཚོགས་སུ་ཐ་དད་དུ་གྱུར་བའི་ཆར་ཆེན་པོ་འབེབས་ཏེ།",
    "མཚེ་མའི་ལྷ་རྣམས་ལ་ནི་རྒྱན་སྣ་ཚོགས་ཤེས་བྱ་བ་མེ་ཏོག་གི་ཆར་ཆེན་པོ་འབེབས་སོ།",
    "བྱང་གི་སྒྲ་མི་སྙན་དུ་ནི་མེ་ཏོག་ཤིན་ཏུ་རྒྱས་པ་ཞེས་བྱ་བའི་མེ་ཏོག་སྣ་ཚོགས་ཀྱི་ཆར་ཆེན་པོ་འབེབས་སོ།",
    "ཏིང་ངེ་འཛིན་ཆེན་པོའི་འབྲུག་གི་སྒྲ་དབྱངས་རྣམ་པ་འདི་ལྟ་བུ་དག་རབ་ཏུ་སྒྲོག་སྟེ།",
    "ལྷ་མོའི་ཁ་དབུགས་གཅིག་ཀྱང་ཡན་ལག་མང་ལྡན་པས།",
    "ཐོས་ནས་ཉོན་མོངས་སྤོང་བྱེད་སྒྲ་ལ་རྟོག་པ་མེད།",
    "ལག་གིས་འགྲོ་བའི་བདག་པོ་ཡིད་དུ་འོང་བ་ནི།",
    "ཕན་པའི་དོན་དུ་ཆར་རྒྱུན་ཕྲ་མོ་ཕྱིས་འབེབས་སོ།",
    "ཆུའི་ཕུང་པོས་སྲིད་པའི་རྩེ་མོ་མན་ཆད་དུའང་གང་བར་འགྱུར་རོ།",
    "འོག་གི་ཆུའི་ཕུང་པོ་ཉེ་བར་བཟུང་པ་ཡན་ཅད།",
    "འདུ་ཤེས་མེད་མིན་གྱི་སྐྱེ་མཆེད་ཀྱི་སྲིད་པའི་རྩེ་མོའི་བར་གྱི་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ནམ་མཁའ་ལ་གནས་པ་སྟེ།",
    "རིའི་རྒྱལ་པོ་ཁ་བ་དང་ལྡན་པའི་རྩེ་མོ་ལ།",
    "མེ་ཏོག་གི་འོད་ཀྱིས་མེ་ཏོག་ཆགས་པར་འགྱུར་རོ།",
    "མེ་ཏོག་གི་འོད་ལས་མཚན་དང་དཔེ་བྱད་བཟང་པོ།",
    "མི་ལ་ལ་ཞིག་གིས་རྩྭ་སྐམ་པོ་དུད་པ་རླན་གྱིས་བག་མེད་པ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་མེའི་ཕུང་པོ་ཆེན་པོ་དེའི་ནང་གི་རྩྭའི་ཟེགས་མ་འགའ་ཞིག་མ་ཚིག་པ་ནི་ཡོད་ཀྱང་སྲིད་ཀྱི།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་རང་འབྱུང་གི་ཡེ་ཤེས་ཆགས་པ་མེད་པའི་ཡེ་ཤེས་ནི་འདུ་ཤེས་དང་།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་འདི་ལྟ་སྟེ་དཔེར་ན་རི་མོའི་གཞི་ཆེན་པོ་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཙམ་ཞིག་ཡོད་པར་གྱུར་ལ།",
    "རི་མོའི་གཞི་ཆེན་པོ་དེ་ལ་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་རིལ་གྱིས་རྫོགས་པར་བྲིས་ཏེ།",
    "སྟོང་གི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ཚད་དུ་ནི་སྟོང་གི་འཇིག་རྟེན་གྱི་ཁམས་བྲིས།",
    "འཛམ་བུའི་གླིང་གི་ཚད་དུ་ནི་འཛམ་བུའི་གླིང་བྲིས།",
    "ཤར་གྱི་ལུས་འཕགས་ཀྱི་གླིང་གི་ཚད་དུ་ནི་ཤར་གྱི་ལུས་འཕགས་ཀྱི་གླིང་བྲིས།",
    "ནུབ་ཀྱི་བན་ལང་སྤྱོད་ཀྱི་གླིང་གི་ཚད་དུ་ནི་ནུབ་ཀྱི་བན་ལང་སྤྱོད་ཀྱི་གླིང་བྲིས།",
    "བྱང་གི་སྒྲ་མི་སྙན་གྱི་གླིང་གི་ཚད་དུ་ནི་བྱང་གི་སྒྲ་མི་སྙན་གྱི་གླིང་བྲིས།",
    "ས་བླ་ན་སྤྱོད་པའི་ལྷའི་གཞལ་མེད་ཁང་གི་ཚད་དུ་ནི་ས་བླ་ན་སྤྱོད་པའི་ལྷའི་གཞལ་མེད་ཁང་རྣམས་བྲིས།",
    "འདོད་པ་ལ་སྤྱོད་པའི་ལྷའི་གཞལ་མེད་ཁང་གི་ཚད་དུ་ནི་འདོད་པ་ལ་སྤྱོད་པའི་ལྷའི་གཞལ་མེད་ཁང་རྣམས་བྲིས།",
    "གཟུགས་ལ་སྤྱོད་པའི་ལྷའི་གཞལ་མེད་ཁང་གི་ཚད་དུ་ནི་གཟུགས་ལ་སྤྱོད་པའི་ལྷའི་གཞལ་མེད་ཁང་རྣམས་བྲིས།",
    "གཟུགས་མེད་པ་ལ་སྤྱོད་པའི་ལྷའི་གཞལ་མེད་ཁང་གི་ཚད་དུ་ནི་གཟུགས་མེད་པ་ལ་སྤྱོད་པའི་ལྷའི་གཞལ་མེད་ཁང་རྣམས་བྲིས་པར་གྱུར་ལ་རི་མོའི་གཞི་ཆུ་ཞེང་དུ་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཙམ་ཡོད་པ་དེ།",
    "རྡུལ་ཤིན་ཏུ་ཕྲ་བ་གཅིག་གི་ནང་དུ་བཅུག་པར་གྱུར་ལ་རྡུལ་གཅིག་ལ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་མ་ལུས་པ་ཐམས་ཅད་རེ་རེ་ལ་ཡང་དེ་ཙམ་གྱི་རི་མོའི་གཞི་ཆེན་པོ་རེ་རེ་ཡོད་པར་གྱུར་ཏེ།",
    "ཀྱེ་མ་བདག་གིས་བརྩོན་འགྲུས་ཀྱི་མཐུ་དང་།",
    "སྟོབས་ཞིག་གིས་རྡུལ་ཕྲ་མོ་འདི་ཁ་ཕྱེ་སྟེ།",
    "རི་མོའི་གཞི་ཆེན་པོ་འདི་དག་འགྲོ་བ་ཐམས་ཅད་ཉེ་བར་འཚོ་བར་བྱའོ།",
    "རི་མོའི་གཞི་ཆེན་པོ་དེ་དག་འགྲོ་བ་ཐམས་ཅད་ཀྱི་བསམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཉེ་བར་འཚོ་བར་བྱེད་པ་ཞིག་ཡོད་ན།",
    "ཞེས་ནས་དེ་བཞིན་གཤེགས་པའི་ལམ་བསྟན་པས་དེ་དག་གི་འདུ་ཤེས་ཀྱི་རྣམ་པ་ཐམས་ཅད་ཡོངས་སུ་བསལ་བར་མཛད་དོ།",
    "འོག་གི་གཞི་ནས་བཟུང་སྟེ་སྲིད་པའི་རྩེ་མོའི་བར།",
    "འཛམ་བུའི་གླིང་གི་ཤིང་མཆོག་ཐམས་ཅད་རྣམ་པར་སྐྱེ།",
    "སྟོང་གསུམ་ཚད་ཀྱི་རི་མོའི་གཞི་ཞིག་ཡོད་གྱུར་ལ།",
    "རི་མོའི་གཞི་དེ་འགྲོ་ཀུན་ཉེ་བར་འཚོ་བྱས་ན།",
    "བྱང་གི་སྒྲ་མི་སྙན་གྱི་གླིང་ནས་ཆུ་ཀླུང་སྟོང་ཕྲག་བཅུ་ཚང་བར་འབབ་སྟེ།",
    "ཀླུའི་རྒྱལ་པོ་ཆེན་པོ་སྔ་མ་དེ་དག་གི་སྤྲིན་ལས་ཆུའི་ཕུང་པོ་ཇི་སྙེད་ཅིག་རྒྱ་མཚོ་ཆེན་པོར་བབ་པ་དང་།",
    "ཀླུའི་རྒྱལ་པོ་ཆེན་པོ་བཅུ་པོ་དེ་དག་གི་སྤྲིན་དང་གནས་ནས།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དེ་བཞིན་དུ་གླིང་ཆེན་པོ་བཞི་པའི་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ཆུ་ཀླུང་གི་ཆུའི་ཕུང་པོ་ཇི་སྙེད་ཅིག་རྒྱ་མཚོ་ཆེན་པོར་བབ་པ་དང་།",
    "ཀླུའི་རྒྱལ་པོ་ཆེན་པོ་སྔ་མ་དེ་དག་གི་སྤྲིན་དང་།",
    "དེ་ནི་རྒྱ་མཚོ་ཆེན་པོ་ཐམས་ཅད་ཀྱང་ཆུའི་ཤུགས་ཆེན་པོས་རྒྱས་པར་བྱེད་མོད་ཀྱི།",
    "སྟོང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོ་བ་ནས་རྒྱུར་བྱ་བའི་བར་དུ་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "རྒྱ་མཚོ་ཆེན་པོ་ལས་དེ་བཞིན་གཤེགས་པའི་ཡུལ་དཔེར་བླང་གི།",
    "འགྲོ་ན་ལོ་བརྒྱར་སོང་ཡང་ཇི་སྲིད་དུ་ཕྱིན་པ།",
    "ནམ་མཁའ་ལྡིང་གི་རྒྱལ་པོ་ཆེན་པོའི་སྤྱོད་ཡུལ་ནི་ནམ་མཁའ་སྟེ།",
    "ནམ་མཁའ་ལ་གནས་ཤིང་རང་གི་མིག་ཡོངས་སུ་དག་པས་ཀླུའི་གནས་སུ་བལྟས་ཏེ།",
    "རྒྱ་མཚོ་ཆེན་པོའི་ཆུའི་ཕུང་པོ་ཆེན་པོ་ནམ་མཁའ་ལྡིང་གི་ཤུགས་དྲག་པོ་དང་།",
    "བསལ་ནས་ཀླུའམ་ཀླུའི་བུད་མེད་དུས་ཡོངས་སུ་སྨིན་ཏེ་ཚེའི་མཐའ་ཕྱིན་པ་འཛིན་ཅིང་འབྱིན་ཏོ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་དེ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པ་ནམ་མཁའ་ལྡིང་གི་རྒྱལ་པོ་ཆེན་པོ་ཆགས་པ་མེད་པའི་སྤྱོད་ཡུལ་མངའ་བ་ཡང་བསྒྲིབས་པ་མེད་པའི་སྤྱོད་ཡུལ་ལ་ཞུགས་ཤིང་།",
    "འོན་ཀྱང་དེ་དག་ལ་བདག་ཅག་གིས་གང་དུ་སྐྱེ་བར་བྱ།",
    "ཆུ་ཆེན་ཡོངས་ཕྱེ་ཀླུ་དང་ཀླུ་ཡི་བུ་མོ་འདྲེན།",
    "སྟོབས་བཅུ་རང་གི་མཐུ་ཡིས་ཉོན་མོངས་རྣམ་ཕྱེ་ཞིང་།",
    "ཉོན་མོངས་པ་དང་།",
    "དུས་གསུམ་ཐམས་ཅད་སེམས་ཀྱི་སྐད་ཅིག་གཅིག་གི་ཡེ་ཤེས་ཀྱིས་རྗེས་སུ་རྟོགས་པས།",
    "ཐ་སྙད་ཐམས་ཅད་ཀྱིས་སྨོས་པ་མ་ཡིན་མོད་ཀྱི།",
    "སྐུ་དང་གསུང་གི་ཚད་ཇི་སྙེད་པ་དེ་སྙེད་དུ་ཆགས་པ་མེད་པའི་དགོངས་པ་ཀུན་ནས་གནས་པར་འགྱུར་ཏེ།",
    "མི་དེས་སྤྲུལ་བའི་སེམས་བསྐྱེད་པ་དེ་དག་གིས་དེ་བཞིན་གཤེགས་པ་ཇི་སྙེད་ཅིག་སྤྲུལ་པར་འགྱུར།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁྱོད་ཀྱིས་ཇི་སྐད་དུ་སྨྲས་པའི་དོན་བདག་གིས་ཤེས་ཏེ།",
    "མཉམ་པ་རེ་རེ་ཀུན་ནས་གནས་པར་འགྱུར་རོ།",
    "སྐྲའི་རྩེ་མོ་གཅིག་ལ་ཇི་ལྟར་ཁོང་དུ་ཆུད་པར་བྱ་བ་དེ་བཞིན་དུ།",
    "གནས་གང་ན་དེ་བཞིན་གཤེགས་པ་མི་བཞུགས་པ་དེ་ལྟ་བུ་ནི་གང་ཡང་མེད་པར་མོས་པར་བྱའོ།",
    "ཐམས་ཅད་རང་བཞིན་སྐུ་ལ་མཉམ་པ་ཉིད་དུ་གཟིགས།",
    "གང་རྣམས་ཇི་ལྟར་མོས་པ་དེ་བཞིན་གསུང་ཡང་ཉན།",
    "བདག་གི་རང་བཞིན་གྱི་མཐའི་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཇི་ལྟ་བ་དང་།",
    "དེ་དག་གིས་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ད་ལྟར་བྱུང་བ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་འདས་པ་དང་།",
    "སྐད་ཅིག་གཅིག་ལ་མངོན་དུ་བྱ་ཞིང་སྐད་ཅིག་ཀྱང་ཡེ་ཤེས་ཀྱི་སྐད་ཅིག་གིས་རྗེས་སུ་འབྲང་བར་བྱ།",
    "བདག་གི་འདུ་ཤེས་ཀྱང་མ་ཡིན་པའི་ཕྱིར་རོ།",
