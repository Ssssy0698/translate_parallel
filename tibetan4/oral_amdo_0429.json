    "རྒྱལ་ཁྱོད་བསྟན་པའི་ཉི་འོད་ཕྱོགས་ཀུན་དུ།",
    "༢༨༤༥དཔལ་བརྩེགས་བོད་ཡིག་དཔེ་རྙིང་ཞིབ་འཇུག་ཁང་གིས་བསྒྲིགས།",
    "རང་རེའི་སྤུན་ཟླ་རྣམས་ཀྱི་མཚན་ཐོ།",
    "༡༦༢བསྡུར་འབྲས་རེའུ་མིག་༡༧༢༡༧༣།",
    "༢༤༨བསྡུར་འབྲས་རེའུ་མིག་༢༤༨༡༦༦ དམ་ཚིག་གསུམ་བཀོད་པའི་རྒྱལ་པོའི་ཡི་གེ་བརྒྱ་པའི་སྒྲུབ་ཐབས་བ་༢༤༩སློབ་དཔོན་ཆེན་པོ་ཀེ་དྷ་ར་ཎ་དྷིས་མཛད།",
    "༢༥༧བསྡུར་འབྲས་རེའུ་མིག་༢༥༨༡༦༧ ཚེ་དཔག་མེད་ལ་བསྟོད་པ།",
    "༢༦༡བསྡུར་འབྲས་རེའུ་མིག་༢༦༡དེབ་སོ་བདུན་པའི་དཀར་ཆགབསར་༡༦༨ འཕགས་པ་ཚེ་དང་ཡེ་ཤེས་དཔག་ཏུ་མེད་པའི་སྒྲུབ་ཐབས།",
    "༢༦༤བསྡུར་འབྲས་རེའུ་མིག་༢༦༤༡༦༩ ཚེ་དང་ཡེ་ཤེས་དཔག་ཏུ་མེད་པའི་ཆོ་ག་ཞེས་བྱ་བ།",
    "༢༦༩བསྡུར་འབྲས་རེའུ་མིག་༢༧༡༦༡ འཇམ་དཔལ་རྡོ་རྗེ་བློ་གྲོས་འཕེལ་བ་ཞེས་བྱ་བ།",
    "༢༧༤བསྡུར་འབྲས་རེའུ་མིག་༢༧༤༡༦༡༡ བཅོམ་ལྡན་འདས་འཇམ་པའི་དབྱངས་ཀྱི་དཔྱད་བཞུགས་༢༧༥གྲུབ་པ་འཕགས་པའི་ལྷས་མཛད།",
    "༢༩ ༡བསྡུར་འབྲས་རེའུ་མིག་༢༩༢།",
    "༢༩༧བསྡུར་འབྲས་རེའུ་མིག་༢༩༧༡༦༡༤ རྗེ་བཙུན་འཇམ་དཔལ་ཤེས་རབ་འཁོར་ལོའི་སྒྲུབ་ཐབས།",
    "༣༡བསྡུར་འབྲས་རེའུ་མིག་༣༢༡༦༡༥ འཇམ་དཔལ་གཡོ་བའི་འཁོར་ལོ།",
    "བུ་མོ་བརྒྱད་ཀྱིས་བསྟོད།",
    "༣༨བསྡུར་འབྲས་རེའུ་མིག་༣༨༡༦༡༧ འཕགས་པ་འཇམ་དཔལ་ལ་བསྟོད་པ།",
    "༣༩ཁྱེའུ་བཅུ་དྲུག་གིས་བསྟོད།",
    "༣༡༥བསྡུར་འབྲས་རེའུ་མིག་༣ ༡༥༡༦༡༩ གུར་ཀུམ་གཞོན་ནུ་ལྟ་བུའི་བསྟོད་པ།",
    "༣༣བསྡུར་འབྲས་རེའུ་མིག་༣༣༡༦༢༣ ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་ཀྱི་ཆོ་ག་སློབ་དཔོན་ཤཱནྡྷ་ཀ་ར་ཝརྨས་མཛད།",
    "༣༣༣བསྡུར་འབྲས་རེའུ་མིག་༣༣༤༡༦༢༤ ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས།",
    "༣ ༣༨བསྡུར་འབྲས་རེའུ་མིག་༣ ༣༨༡༦༢༥ ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས།",
    "༣༤༧བསྡུར་འབྲས་རེའུ་མིག་༣༤༨༡༡༦༢༧ འཕགས་པ་འཇམ་དཔལ་གྱི་སྒྲུབ་པའི་ཐབས།",
    "༣༥ ༡བསྡུར་འབྲས་རེའུ་མིག་༣༥༡༡༦༢༨ འཕགས་པ་འཇམ་དཔལ་གྱི་བསྟོད་པ་ཞེས་བྱ་བ།",
    "༣༥༩བསྡུར་འབྲས་རེའུ་མིག་༣༦༡༦༣ འཕགས་པ་དོན་ཡོད་ཞགས་པ་ལྷ་ལྔའི་བསྟོད་པ།",
    "༣༦༣བསྡུར་འབྲས་རེའུ་མིག་༣༦༣༡༦༣༡ འཕགས་པ་དོན་ཡོད་ཞགས་པའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་ལ་བསྟོད་པ་དྲི་མ་མེད་པའི་འོད་ཅེས་བྱ་བ།",
    "༣༧བསྡུར་འབྲས་རེའུ་མིག་༣༧༡༡༦༣༢ འཇིག་རྟེན་མགོན་པོའི་བསྟོད་པ་ཡིད་འཕྲོག་སྡིག་འཇོམས་ཞེས་བྱ་བ།",
    "༣ ༧༢ཤར་ཕྱོགས་བ་རེན་ཌའི་སློབ་དཔོན་མཁས་པ་ཆེན་པོ་ཙནྡྲ་གོ་མིས་མཛད།",
    "རྒྱ་གར་ཤར་ཕྱོགས་བ་རེན་ཌའི་ཛཱ་ག་ཏ་ལའི་པཎྜི་ཏ་ཆེན་པོ་དཱ་ན་ཤཱི་ལས་བསྒྱུར།",
    "༣༧༦བསྡུར་འབྲས་རེའུ་མིག་༣༧༦༡༦༣༣ ཐུགས་རྗེ་ཆེན་པོ་ལ་བསྟོད་ཅིང་བསྐུལ་བ།",
    "༣༨༦བསྡུར་འབྲས་རེའུ་མིག་༣༨༦༡༦༣༥ འཕགས་པ་དོན་ཡོད་ཞགས་པ་ལྷ་ལྔའི་བསྟོད་པ།",
    "༣༩༣བསྡུར་འབྲས་རེའུ་མིག་༣༩༣༡༦༣༧ དཔལ་འཇིག་རྟེན་མགོན་པོ་མཁའ་ལ་སྤྱོད་པའི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ།",
    "༤༣༢བསྡུར་འབྲས་རེའུ་མིག་༤༣༢༡༦༤ ནོར་བུ་གླིང་གི་ཐུགས་རྗེ་ཆེན་པོ་ལྷ་ལྔ་ལ་བསྟོད་པ།",
    "༤༣༨བསྡུར་འབྲས་རེའུ་མིག་༤༣༨༡༦༤༢ ཐུགས་རྗེ་ཆེན་པོ་ལ་སྨྲེ་སྔགས་ཀྱི་བསྟོད་པ་ཞེས་བྱ་བ།",
    "དགེ་སློང་མ་དཔལ་མོས་མཛད།",
    "༥དགེ་སློང་མ་དཔལ་མོས་མཛད།",
    "༥ ༣དགེ་སློང་མ་དཔལ་མོས་མཛད།",
    "༥༦བསྡུར་འབྲས་རེའུ་མིག་༥༦དེབ་སོ་བདུན་པའི་དཀར་ཆག་༡༥༥༩༥ ༡བ་༥ ༡༥ ༡༢༥ ༡༣ད་༡༦༥༣ རྗེ་བཙུན་ཐུགས་རྗེ་ཆེན་པོ་ལ་བསྟོད་པ།",
    "༥༧དགེ་སློང་མ་དཔལ་མོས་མཛད།",
    "༥སྤྱན་རས་གཟིགས་བཅུ་གཅིག་པའི་ཞལ་ཅན་གྱི་སྒྲུབ་ཐབས།",
    "སྤྱན་རས་གཟིགས་ཡིད་བཞིན་ནོར་བུའི་སྒྲུབ་ཐབས།",
    "༥ ༣༨༥༤༥༤༥༥༤༧༥༤༨༥༤༩༥༥༥ ༥ ༡དཔལ་ཐུགས་རྗེ་ཆེན་པོ་པོ་ཏ་ལ་ཀེ་རིའི་རྩེ་མོའི་སྒྲུབ་ཐབས།",
    "༥༩དཔལ་མེ་ཏོག་གི་གདན་ཅན་གྱི་སྒྲུབ་ཐབས།",
    "༦༡༥སྤྱན་རས་གཟིགས་དྲི་མ་འཇིག་པའི་བུམ་པའི་ཆོ་ག་༦༡༦དཔལ་རྡོ་རྗེ་འབར་བའི་བསྲུང་བ་ཆེན་པོའི་མན་ངག་༦༡༧སྲུང་བའི་འཁོར་ལོ།",
    "༦༥༢རྡོ་རྗེ་སྐར་མདའི་མན་ངག་ཚེ་འདས་པ་ལ་བྱ་བའི་ཆོ་ག་༦༥༤རོ་བསྲེག་གི་ཆོ་ག་༦༥ ༦སྦྱིན་སྲེག་གི་ཆོ་ག་༦༥༧བཀྲ་ཤིས་ཀྱི་ཆོ་ག་ཚ་ཚ་འདེབས་པའི་ཆོ་ག་རབ་ཏུ་གནས་པའི་ཆོ་ག་༦༦༡གྲུབ་པ་བརྙེས་པའི་པཎྜི་ཏ་ཆེན་པོ་ཨ་ཛི་ཏ་མི་ཏྲ་གུཔས་མཛད།",
    "ཁ་ཆེའི་པཎྜི་ཏ་ཆེན་པོ་བུདྡྷ་ཤྲཱི་ཛྙཱ་ནས་གཏན་ལ་ཕབ་ནས་བོད་ཀྱི་ལོ་ཙཱ་བ་གནུབས་བྱམས་པའི་དཔལ་བཟང་པོ་ཞེས་བྱ་བས་བསྒྱུར།",
    "ཧོ་༦༨༨༡༦༥༥ ཕྱག་སྟོང་སྤྱན་སྟོང་གི་སྒྲུབ་ཐབས།",
    "༧༦བསྡུར་འབྲས་རེའུ་མིག་༧༦མས་བསྒྱུར།",
    "༧༡བསྡུར་འབྲས་རེའུ་མིག་༧༡༡༦༦ འཕགས་པ་ཡི་གེ་དྲུག་པའི་སྒྲུབ་ཐབས།",
    "༧༢༤བསྡུར་འབྲས་རེའུ་མིག་༧༢༤།",
    "༧༣༡བསྡུར་འབྲས་རེའུ་མིག་༧༣༡༡༦༦༧ སེང་གེ་སྒྲའི་སྲུང་བའི་འཁོར་ལོ་ཞེས་བྱ་བ།",
    "༧༣༦བསྡུར་འབྲས་རེའུ་མིག་༧༣༦༡༦༦༩ དོན་ཡོད་ཞགས་པའི་གཏོར་མའི་ཆོ་ག་༧༣༧ཁ་ཆེའི་པཎྜི་ཏ་ཆེན་པོ་ཤཱཀྱ་ཤྲཱི་བྷ་དྲས་མཛད།",
    "ལོ་ཙཱ་བ་དགེ་སློང་རབ་མཆོག་དཔལ་བར་ར་སོང་ཡོད།",
    "༧༤བསྡུར་འབྲས་རེའུ་མིག་༧༤༡༦༧༡ འཕགས་པ་དོན་ཡོད་ཞགས་པའི་གསོ་སྦྱོང་གི་ཆོ་གའི་མན་ངག་བ་སོག་ས་ཁ་ཆེའི་པཎྜི་ཏ་ཆེན་པོ་ཤཱཀྱ་ཤྲཱི་བྷ་དྲས་༡༡ བོད་ཀྱི་ལོ་ཙཱ་བ་དགེ་སློང་རབ་མཆོག་དཔལ་བཟང་པོས་བསྒྱུར།",
    "༧༥༣བསྡུར་འབྲས་རེའུ་མིག་༧༥༣༡༦༧༣ དཔལ་ཕྱག་ན་རྡོ་རྗེའི་སྒྲུབ་པའི་ཐབས།",
    "༧༦༨བསྡུར་འབྲས་རེའུ་མིག་༧༧༡༦༧༤ གོས་སྔོན་པོ་ཅན་གྱི་དངོས་གྲུབ་ཉེ་བ་ཞེས་བྱ་བ།",
    "༧༧༣བསྡུར་འབྲས་རེའུ་མིག་༧༧༤༡༦༧༥ གནོད་པ་སེལ་བའི་བདུད་རྩི།",
    "༧༧༦བསྡུར་འབྲས་རེའུ་མིག་༧༧༧༡༦༧༦ རྡོ་རྗེ་བྱབ་པའི་ལས་ཚོགས།",
    "༧༧༩བསྡུར་འབྲས་རེའུ་མིག་༧༧༩༡༦༧༧ ཡན་ལག་བདུན་པའི་སྒྲུབ་ཐབས།",
    "༧༩ ༡བསྡུར་འབྲས་རེའུ་མིག་༧༩༣༡༦༧༩ ཕྱག་ན་རྡོ་རྗེ་སྒྲུབ་པའི་ཐབས་ཞེས་བྱ་བ།",
    "༨༦བསྡུར་འབྲས་རེའུ་མག་༨༧།",
    "༨༡༡བསྡུར་འབྲས་རེའུ་མིག་༨ ༡༢༡༦༨༢ དཔལ་ཕྱག་ན་རྡོ་རྗེ་གོས་སྔོན་པོ་ཅན་གྱི་གཟུངས་ཀྱི་གཏོར་བ་མའི་ཆོ་ག་ཞེས་བྱ་བ།",
    "༨ ༡༩བསྡུར་འབྲས་རེའུ་མིག་༨ ༡༡༦༨༤ དོན་འགྲེལ་སྒྲོན་མ།"
  ]
}