    "ཁོ་བོ་ནི་ཐང་གི་སི་ཁོང་དབྱིན་ཀོ་གུང་གི་རྒྱུད་པ་ཡིན།",
    "ཝུའུ་ཧིག་གི་དུས་སུ།",
    "བདག་གིས་བྷོད་དུ་དམག་དཔོན་ཁུར་ཡོད་ཀྱང་།",
    "དེ་ནས་ཁོས་ཡན་སུའུ་ལ་དོ་ནུབ་ཁྱོད་ཚོ་བྲོས་ན་ཐར་ཐུབ་ཟེར།",
    "ངས་གོ་ཧྲི་ཅུན་ནི་ཐང་གི་བློན་ཆེན་ཞིག་གི་རྒྱུད་པ་ཡིན་པར་ཤེས་ནས་གསོད་འདོད་མེད་ཀྱང་།",
    "སྟབས་མ་ལེགས་པར་དམག་ཟིང་གི་དུས་སུ་ཤི་སོང་ཟེར།",
    "ཞུ་ཧྲེ་རིན་གྱིས་དམག་ཁྲིད་ནས་ཕྱིར་ལོག་བང་ཆེན་ཞེས་པ་ནི་བཙན་པོའི་བཀའ་བསྒྲགས་མཁན་ཞིག་རེད།",
    "དམག་བྱེད་ཐེངས་རེར་ཁོ་རྟ་ལ་ཞོན་ནས་དམག་དཔོན་ཚོར་ཐབས་བཀོད་འདོན་དུ་འགྲོ་བ་ཡིན།",
    "ལོ་དེ་དག་གི་རིང་ལ།",
    "ཐང་གི་ཁོངས་གཏོགས་ཁུན་མཱིན་གྱི་འཇང་བ་རྣམས་ཀྱང་བདེ་ལ་འགོད་ཐུབ་པ་བྱུང་།",
    "དེ་དུས་ལེ་ཀོ་བྱ་བས་ཝེ་ཀྲིག་ས་ཆ་དམག་གིས་བསྐོར།",
    "བཙན་པོ་ནས་བློན་མང་བཞེར་རྨོ་ལུང་ཆི་ཞི་པིས་བྱ་བ་ལ་སུང་ཀྲིག་གི་ཝུའུ་ཏའོ་ཅེ་ཏུའུ་པཱིན་མ་ཏུའུ་ཐུང་དང་།",
    "ཆི་ཞི་པིས་བྱ་བས་ཐང་གི་དམག་ཤུགས་ཞན་པ་མཐོང་ནས་ར་མདར་བརྒྱུགས།",
    "ཐང་གི་དམག་མི་རྣམས་གཡུལ་དུ་བརྒྱུགས་ཏེ་ཕྱོགས་བཞི་ནས་རྒོལ་བར་བརྩམས།",
    "གོང་མས་ཡུག་ལུང་ཧྲུའུ་དམག་སྤྱི་ཆེན་མོ་ཞོ་ཕེ་བྱ་བ་བྷོད་དུ་མངགས།",
    "གོང་མས་ཀུང་པུའུ་ཧྲི་ལང་གི་ཐབས་ཡོད་པ་ཀྲང་ཅན་བྱ་བ་འདས་མཆོད་དུ་མངགས།",
    "ཁུའུ་པུའུ་ཡོན་ཁྲེ་ལང་གི་ཐབས་ཡོད་པ་ཞུང་ཀྲི་དབྱི་བྱ་བ་གཉིས་ཀྱིས་གོང་མའི་བཀའ་ཡིག་ཁྱེར་ཏེ་བྷོད་དུ་སོང་།",
    "ཞན་ཙུང་གི་དུས་མགོར།",
    "ཐང་གིས་ཕོ་ཉ་བ་མངགས་ཏེ་བྷོད་ཀྱི་བཟུང་དམག་ཕྱིར་སྤྲད།",
    "དེ་ནས་བཟུང་བྷོད་ཀྱི་ཕོ་ཉ་བ་ལོ་རེ་བཞིན་སྐྱེས་འབུལ་དུ་འོངས།",
    "རྟ་དམག་ཆིག་ཁྲི་ཧྲིན་ཀྲིག་གི་ཏ་ཧྲི་ཀུའུ་བྱ་བའི་ས་ཆར་མངགས་ཏེ་ཡུ་གུར་གྱི་ཚོང་བ་རང་ཡུལ་དུ་ལོག་པ་རྣམས་བཅོམ།",
    "ཚི་པུའུ་ལང་ཀྲུང་གི་ཐབས་ཡོད་པ་ཞུ་ཧྥུའུ་བྱ་བ་བྷོད་དུ་ཕོ་ཉར་མངགས་ཏེ།",
    "ཞུ་ཧྲུའུ་བྱ་བ་དེ་ཧྲན་ཀྲིག་ལ་སླེབས་ནས་ཕྱིར་ལོག་ཁོའི་ལག་རོགས་པ་ལི་སྦྱིན་བྱ་བ་བཙན་པོ་མཇལ་དུ་སོང་།",
    "བྷོད་ཀྱིས་ལུང་ཀྲིག་གི་ས་མཚམས་སུ་ཕོ་ཉ་མངགས་ཏེ་ཚོང་བྱེད་ཟེར་བ་ལ་གོང་མས་ཀྱང་གསན་དུ་བཞེད་དོ།",
    "མ་གཞིར་རྡོ་ཧྲུང་ཅུན་གྱི་རྟ་དམག་དཔོན་པོ་ཞིག་རེད།",
    "ཁྲིན་ཡོན་གྱི་དུས་མགོར་ཁོ་གཉིས་བྷོད་དམག་གིས་འཛིན་གཟུང་བྱས།",
    "ཐང་གི་ཕོ་ཉ་བ་ཝུའུ་ཁྲུང་ཆི་དང་དོན་ཅུན་གྱིས་ཁོ་གཉིས་ཤི་མེད་པ་ཤེས་རྗེས་བྷོད་ལ་ཞུས་ཏེ་ཁྲིད་འོངས་པའོ།",
    "ཅན་ནན་གྱི་སྲུང་དམག་གིས་བྷོད་ཀྱི་མོ་ཧི་མཁར་དང་ཆུ་ཤུས་མཁར་གཉིས་བཅོམ།",
    "བྷོད་ཀྱི་ཅེ་ཏུའུ་བློན་ཨར་མོ་དང་།",
    "མཚན་མོ་བྷོད་ཀྱི་དམག་སྒར་ལ་འཇབ་རྒོལ་བྱས་ཤིང་།",
    "བྷོད་དམག་གིས་ཉིན་སུམ་ཅུར་འཐབ་ཀྱང་མཁར་གཏོར་མ་ཐུབ།",
    "རྡོ་ཧྲུང་གི་དམག་དཔོན་ཧྲི་ཅིན་ཧྲུན་བྱ་བས་རྟ་དམག་ཁྲིད་དེ་བྷོད་ཀྱི་རྒྱབ་ཕྱོགས་སུ་བརྒྱུགས་པས།",
    "ཧྲ་ཀྲིག་གི་ཚི་ཧྲིའི་ཐབས་ཡོད་པ་ཀྲིག་ཏཱིན་བྱ་བས་མཁར་དེ་སྲུང་ཞིང་མཆིས་པ་ལ།",
    "ཡན་ཁྲའོ་རང་ཉིད་ཀྱི་ཧྲ་ཀྲིག་གི་དམག་དཔོན་བྱས།",
    "ཁོས་གོས་དར་དུམ་གཅིག་ལ་འབྲུ་བྲེ་གང་རེ་བྱས་ཏེ་བཙོང་བ་ལ།",
    "འབྲུ་དང་མཚོན་ཆའང་རྫོགས་སོང་།",
    "ཧྲ་ཀྲིག་གི་མི་རྣམས་ཀྱིས་བྷོད་ལྭ་གྱོན་ཏེ་སྟོད་ཀྱི་འབངས་སུ་བྱས།",
    "ལོ་རེའི་ལོ་གསར་གྱི་སྐབས་སུ་ཁོ་ཚོས་མེས་པོར་མཆོད་འབུལ་བྱེད་སྐབས།",
    "གོང་མ་མོའུ་ཙུང་རྒྱལ་སར་བཞུགས་རྗེས།",
    "བྷོད་དམག་ལིན་ཝུའུ་ལ་དྲངས་པ་ལིན་ཀྲིག་དམག་གིས་ཕྱིར་བཟློགས།",
    "བྷིན་ཅི་ནས་ཡིན་མིན་གང་རུང་གི་སྒོ་ནས་ཁས་བླངས།",
    "ད་དམག་ཁྲང་ཝུའུ་ལ་སླེབས་དུས་བྷིན་ཅི་ནས་མཇལ་དུམ་བྱེད་པའི་ཁས་བླངས་ཟིན་པས་ང་ཚོ་འོངས་པ་ཡིན་ཟེར་ཞིང་།",
    "ཅིན་ཀྲིག་དང་དམག་ཚིགས་གཅིག་གིས་ཆོད་པའི་སར་སྒར་བཏབ།",
    "བྷིན་ཅི་ཡི་གོ་གནས་མར་ཕབ་སྟེ་མཁྲིན་ཀྲིག་གི་སི་ཧུའུ་ཚན་ཅུན་ལ་བསྐོས།",
    "སྐབས་དེར་ལི་ཀོང་ཡན་བྱ་བས་ཀྱང་པིན་ཀྲིག་གི་དམག་ཁྲིད་དེ་སླེབས་པས།",
    "དེ་དག་གིས་གྲོས་བགྱིས་ཏེ་བྷོད་དང་འདུམ་བྱེད་པའི་གནས་ཚུལ་དེ་གོང་མ་ཡབ་ཀྱི་མཆོད་སྡོང་ལ་གསོལ་དགོས་ཟེར་བ་ལ།",
    "བློན་པོ་ཞིག་ན་རེ།",
    "གོང་མ་སུའུ་ཙུང་དང་ཏེད་ཙུང་གི་རིང་ལའང་བྷོད་དང་མཇལ་དུམ་བྱས་མྱོང་མོད།",
    "གོང་མ་ཏེ་ཙུང་གི་ཅན་ཀྲུང་ཁྲི་ལོའི་དུས་སུ་མནའ་ལ་གཙིགས་སུ་བཟུང་སྟེ་གོང་མ་ཡབ་ཀྱི་མཆོད་སྡོང་ལ་གསོལ།",
    "ཡུག་སི་ལང་ཀྲུང་གི་ཐབས་ཡོད་པ་ལིག་ཧྲི་ལོ་བྱ་བ་དེའི་ལག་རོགས་སུ་མངགས།",
    "ལིན་ཀྲིག་གི་ཅེ་ཏུའུ་ཧྲིའི་ཐབས་ཡོད་པ་ལི་ཅིན་ཁྲིན་བྱ་བས་ཏཱ་ཧྲི་ཧྲན་ས་ཆ་ནས་བྷོད་དང་འཐབ་སྟེ་བྷོད་དམག་ཕམ།",
    "ཐང་གི་བློན་ཆེན་ལ་ཡི་གེ་དང་སྐྱེས་ཕུལ།",
    "བྷོད་ནས་ས་མཚམས་འབྱེད་རྒྱུའི་རེ་བ་བཏོན།",
    "ལིག་ཡོན་ཏཱིན་བྷོད་དུ་སོང་ནས་བློན་ན་ལོད་དང་ལྷན་དུ་མནའ་བོར།",
