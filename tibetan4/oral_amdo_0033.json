    "དེ་ནས་མོ་ཉིག་ཞ་མཛོ་ལུང་འགག་ལ་དམག་དྲངས།",
    "དམག་དཔོན་ཆེན་མོ་མོ་ལི་ཕེ་ཚི་བྱ་བས་དེར་མ་ཉན་པར།",
    "ཞང་པེ་པེ་རང་གིས་འཁོར་རྣམས་ཁྲིད་དེ་ཀན་ཀྲིག་གི་ནུབ་ཕྱོགས་སུ་སོང་།",
    "གོང་མ་ཞོན་ཙུང་གིས་ཐེ་ཕུའུ་ཆིན་གྱི་ཐབས་ཡོད་པ་ལུའུ་ཏན་བྱ་བ་མངགས་ཏེ།",
    "བཀའ་ཡིག་ཁྱེར་ནས་ཞིང་ཁོ་བཞེར་ལ་འཚམས་འདྲི་བྱེད་དུ་སོང་བ་དང་།",
    "ཞང་ཁོ་བཞེར་གྱིས་རང་གི་ཆེ་བ་བརྗོད་ཅིང་།",
    "ཧི་ཝེའི་ཅེ་ཏུའུ་ཧྲི་བྱེད་འདོད་པའི་རེ་བ་ཞུས་ཀྱང་།",
    "རེ་ཐག་ཆད་པའི་ངང་ནས་གལ་ཏེ་ངའི་བསམ་དོན་འགྲུབ་ཚེ།",
    "དམག་མི་ཁ་ཐོར་བ་རྣམས་བསྡུས་ཏེ་ཐང་གི་ས་མཚམས་སུ་དམག་འདྲེན་རྒྱུའི་གྲབས་བྱས།",
    "ཞང་ཁོ་བཞེར་ཀོ་ཀྲིག་ཏུ་སོང་།",
    "ཧྲིན་ཞང་དམག་གིས་ཆིན་ཀྲིག་བླངས།",
    "ཧྲིན་ཞང་དམག་གིས་ལུང་ཀྲིག་ནས་བྷོད་དང་འཐབ་སྟེ་བྷོད་དམག་ལྔ་བརྒྱ་བསད།",
    "ཁོ་ཚོར་ཞྭ་མོ་དང་གོན་པའང་བསྩལ།",
    "ལོ་གཉིས་རེའི་ནང་བརྗེ་སོར་བྱས།",
    "དང་ཐོག་གོང་མ་ཐེ་ཙུང་གི་རིང་ལ་ཞོས་རིན་ཀོས་བྱ་བ་ཕམ་པར་བཏང་སྟེ།",
    "གོང་མ་ཞོན་ཙུང་གི་རིང་ལ།",
    "ལོ་བཞི་བཅུའི་རིང་ལ་ཐང་གི་ས་མཚམས་སུ་དམག་མ་བྱུང་།",
    "དབྱི་ཝུའུ་ས་ཆར་དམག་གིས་སོ་ནམ་བྱས་ཤིང་།",
    "གོང་མ་ཞན་ཙུང་གིས་རྒྱུན་པར་ས་ཁྲ་ལ་གཟིགས་པ་དང་།",
    "དེང་ནི་ས་ཆ་དེ་དག་ཕྱིར་འཕྲོག་སྟེ་ཐང་གི་བདག་ཏུ་མཆིས་པའི་སྐབས་ཡིན་པས།",
    "གོང་མ་ན་རེ།",
    "གོང་མ་ཞན་ཙུང་གིས་རྨ་ཆུ་དང་ཙོང་ཆུའི་ས་ཆ་མངའ་བསྒྱུར་དགོས་བསམ་ན་ཡང་།",
    "ཁྱོད་ཚོས་གོང་མ་ཧྲུན་ཙུང་དང་ཞན་ཙུང་གི་མཆོད་སྡོང་ལ་མཚན་ཞིག་གསོལ་ཏེ་ཕྱི་རབས་སུ་ངོམ་པར་གྱིས་ཤིག་གསུངས།",
    "གོང་མའི་ཞལ་ནས་ཁོ་བོས་རེ་ཞིག་འབངས་རྣམས་དབུགས་དབྱུང་བར་བྱེད་འདོད་དེ།",
    "ཧྲ་ཀྲིག་གི་འགོ་བ་ཀྲང་དབྱི་ཁྲའོ་བྱ་བས་བཀྭའ་ཀྲིག་དང་།",
    "ཧྲ་ཀྲིག་དབྱིས་ཀྲིག་སུའུ་ཀྲིག་ཀན་ཀྲིག་ལ་སོགས་པའི་ཀྲིག་བཅུ་གཅིག་གི་ས་ཁྲ་གོང་མའི་ཕྱག་ཏུ་ཕུལ།",
    "བྷོད་ཀྱི་མཁར་སྲུང་མཁན་རྣམས་བྲོས་སོང་།",
    "དེ་ནས་ཀྲིག་གི་བྱ་བ་རྣམས་ཀྲུང་དབྱི་ཁྲའོ་རང་གིས་བསྐྱངས་པ་ཡིན།",
    "ཀྲུང་དབྱི་ཁྲའོ་ལ་ཧྲ་ཀྲིག་གི་ཧྲང་དབྱི་ཧྲི་བྱ་བའི་ཆོ་ལོ་སྦྱར།",
    "ཧི་ཀྲིག་དང་ཝེ་ཀྲིག་གི་བྷོད་ཀྱི་དམག་དཔོན་ཞང་ཡན་ཞིན་བྱ་བས་རྒྱལ་ཁབ་འཇིག་པར་དོགས་ནས་ཐང་ལ་མགོ་འདོགས་པར་འོངས།",
    "དེ་གའི་རེ་ཏུའུ་ཧྲིའི་ཐབས་ཡོད་པ་ཞོ་ཧྲང་ཙུང་བྱ་བས་ཕྱིར་བཟློགས།",
    "ཧྲ་ཀྲིག་གི་ཀྲུང་ཧྲིའི་ཐབས་ཡོད་པ་ཚའོ་དབྱི་ཅིན་བྱ་བས་ཧྥ་ཀྲིག་གི་ལས་དོན་གཉེར།",
    "ཧུང་མོ་ལ་ཝུན་མོ་ཞེས་ཀྱང་བྱ།",
    "ཁོ་ཚོས་རང་གི་འཁོར་གཡོག་རྗེས་སུ་ཁྲིད་པ་ཡིན།",
    "ཁོ་ཚོ་རང་གིས་ཝུན་མོ་ཞེས་འབོད།",
    "ཐང་གི་ཁབ་སོ་དར་བ་ནས་བཟུང་།",
    "མི་འཇིགས་དཔུང་གི་གོ་ཆ་བཙན་པོས་ཕམ་པར་བྱེད་ཅིང་།",
    "གྲོས་ཀྱི་ཇུས་འདོན་མཁན་དང་དཔུང་གི་རུ་འདྲེན་མཁན་རྣམས་ཀྱིས་བློ་བསྡུར་ཀྱང་ཐབས་བཟང་བོ་ཞིག་མ་རྙེད་པར།",
    "གོང་མ་ཐང་གི་རྒྱལ་ཁབ་ཀྱང་རིམ་གྱིས་རྒྱུད།",
    "གོང་མ་ཐང་གི་རྒྱལ་ཁབ་འདི་ཡང་རིམ་གྱིས་ཉམས་ཤིང་རྒུད་པར་གྱུར།",
    "ཐུ་བྷོད་ཅེས་བྱ་བ་ནི་ཁྲང་ཨན་ནུབ་ཕྱོགས་ཀྱི་ལེ་དབར་བརྒྱད་སྟོང་གི་སར་མཆིས་ཤིང་།",
    "དེའི་རིགས་རྒྱུད་དང་ཚོ་བ་རྣམས་ཀྱི་འབྱུང་ཁུངས་མི་ངེས་ཀྱང་།",
    "ཁ་ཅིག་གིས་ནན་ལེང་གི་ཐུའུ་ཧྥ་ལི་ལོའུ་ཀུའུ་ཞེས་བྱ་བའི་རྒྱུད་པ་ཡིན་ཟེར།",
    "འཕན་མྱི་ནི་ཨན་ཞི་དམག་དཔུང་གི་དཔོན་པོར་བསྐོས།",
    "མང་སུང་གིས་ཁོ་ལ་ལིན་སུང་གི་ཐེ་ཧྲིག་བྱ་བའི་ཆོ་ལོ་སྦྱར།",
    "འཕན་མྱིས་རང་གི་འཁོར་རྣམས་ཁྲིད་དེ་ནུབ་ཕྱོགས་སུ་བྲོས།",
    "རི་བོ་ཅི་ཧྲི་བརྒྱུད་དེ་འཇང་གི་ས་ཆར་རྒྱལ་ཁབ་ཅིག་བཙུགས་ཤིང་།",
    "དེ་ནས་འཕན་མྱིས་རང་གི་རུས་སྤུར་རྒྱལ་དུ་བྱས་ཤིང་།",
    "དྲག་པོའི་སྟོབས་ཀྱིས་ཁ་ལོ་བསྒྱུར་བས་མངའ་རིས་ཀྱང་རིམ་གྱིས་རྒྱུ་ཆེ་རུ་སོང་།",
    "ཆབ་སྲིད་ཀྱང་དེ་དག་གིས་སྐྱོང་།",
    "ལེ་དབར་བརྒྱ་རེའི་མཚམས་ན་བརྡ་གཏོང་ས་དེ་ལྟ་བུ་རེ་མཆིས།",
    "རྗེ་བློན་རྣམས་ཀྱིས་ལོ་རེར་འདུན་མ་ཆུང་ངུ་རེ་བསྡུ་སྟེ།",
    "བནྡེ་ཞིག་གིས་གནམ་ས་རི་ལུང་ཉི་ཟླ་གཟའ་སྐར་ལ་སོགས་པ་དཔང་དུ་གསོལ་ཏེ།",
    "ཁྱོད་ཚོ་ཡང་ལུག་ཁྱི་འདི་རྣམས་བཞིན་དུ་མི་བགྱིད་རི་ཞེས་མནའ་འདོར་རོ།",
    "ལོ་གསུམ་རེ་ན་འདུན་མ་ཆེན་པོ་རེ་བསྡུ།",
    "མཚན་མོ་ཁྲི་ཐོག་ཏུ་མཆོད་ཟས་རྣམས་བསྒྲིགས་པ་དང་།",
    "ཁྱོད་ཅག་ཡོད་དོ་ཅོག་གིས་སེམས་རྩ་མཐུན་པོའི་སྒོ་ནས་རང་ཡུལ་སྲུང་བར་གྱིས་ཤིག་གནམ་སའི་ལྷ་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་བསམ་པ་ཐམས་ཅད་མཁྱེན་པས།",
    "ཆང་འཁྱོར་བར་བླུགས་ནས་བཏུང་།",
    "མི་རྣམས་མོ་བ་དང་རྩིས་པར་དད།",
    "རྩེད་མོར་ཤོ་དང་མིག་མངས་རྩེ།",
    "རོལ་མོ་ནི་དུང་འབུད།",
    "ཁྱིམ་ཚང་གཅིག་ནས་མི་མང་པོ་གཡུལ་དུ་ཤི་ན་དུད་ཚང་དགའ་མོར་བརྩི།",
    "སྡར་མའི་མགོ་ལ་ཝ་ཡི་གཞུ་གུ་བཏགས་ཏེ་མང་མའི་མདུན་དུ་དམོད་འདེབས་ཤིང་།",
    "མིའི་གྲས་སུའང་མི་འཇོག་ལག་པ་ས་ལ་བཙུགས་ཏེ་ཁྱིའི་ལད་མོ་བྱས་ནས་གུས་ཕྱག་བྱེད།",
    "བཙན་པོས་གྲུ་གུ་དང་འ་ཞ་ལ་ཀོང་ཇོ་རེ་ཐོབ་པའི་གཏམ་གསན་ཏེ་ཕོ་ཉ་བ་མངགས་པ་ལ།",
    "ཀོང་ཇོ་ཞིག་ཀྱང་གནང་རྒྱུ་ཡིན་མོད།",
    "དེ་དུས་འ་ཞའི་རྒྱལ་པོ་ཐང་གི་ཁབ་ཏུ་སླེབས་ཏེ་ཕྲ་མ་བཅུག་སྟབས།",
    "དེ་ནས་སྲོང་བཙན་གྱིས་ཞང་ཞུང་གི་དཔུང་དང་བཅས་ཏེ་འ་ཞར་དམག་དྲངས་པ་ལ།",
    "བྷོད་དམག་ཁྲི་ཚོ་ཉི་ཤུ་ལྷག་སུང་ཀྲིག་གི་ནུབ་ཕྱོགས་སུ་སྒར་བཏབ།",
    "ཡང་བྷོད་དམག་གི་འཁོར་ཚོགས་ལ།",
    "ཏུའུ་ཏུའུ་ཡི་ཐབས་ཡོད་པ་ཧན་ཝེ་བྱ་བ་འཁོར་ཉུང་ཤས་དང་བཅས་འཐབ་ཏུ་སོང་ཡང་བྷོད་དམག་གིས་ཕམ་པར་བྱས།",
    "གོང་མ་ཐེ་ཙུང་གིས་ལིས་པུའུ་ཧྲང་ཧུའུ་ཡི་ཐབས་ཡོད་པ་ཧིག་ཅུན་ཅི་བྱ་བ་ཏང་མི་ཏའོ་ཡི་གཡུལ་འདེགས་སྤྱི་ཁྱབ་དམག་དཔོན་དང་གཡས་རུའི་དམག་དཔོན་ཆེན་མོ་ཀྲི་ཧྲི་སི་ལི་བྱ་བ་པེ་ལན་ཏའོ་ཡི་གཡུལ་འདེགས་སྤྱི་ཁྱབ་དམག་དཔོན་དུ་བསྐོས།",
    "ཉིག་ཅིན་ཏའི་མདུན་མཆོང་དམག་སུང་ཀྲིག་ནས་ཆས་ཏེ་མཚན་མོ་བྷོད་ཀྱི་སྐར་ཐོག་ཏུ་རྒྱུགས།",
    "གོང་མ་ཐེ་ཙུང་གིས་ཝུན་ཁྲིན་ཀོང་ཇོ་བག་མར་གནང་།",
    "ལི་པུའུ་ཧྲང་ཧུའུ་འམ་ཇང་ཞ་ཅུན་ཝང་གི་ཐབས་ཡོད་པ་ལི་ཏོ་ཙུང་ལ་གཉེན་གྱི་མགོ་འཛིན་དུ་བཅུག་ཅིང་།",
    "བཙན་པོས་རང་གི་འཁོར་ལ་འདི་སྐད་དུ་སྨྲས་པ།",
    "གོང་མ་ཐེ་ཙུང་གིས་ལེའོ་ཏུན་ཡུལ་ལ་དམག་དྲངས་ཏེ་ཕྱིར་ཕེབས་པ་ན།",
    "བྱ་ངང་བ་ཡང་ཁྲུང་ཁྲུང་གི་རིགས་དང་མཐུན་པས་ན།",
    "ཐང་གི་ཁབ་ཏུ་ཕོ་ཉ་བ་མངགས་ཏེ་རྒྱལ་ཁའི་འཕྲིན་བཟང་ཞུས།",
    "ཞི་ཧེ་ཅུན་ཝང་གི་ཆོ་ལོ་གནང་ཞིང་།",
    "གོང་མ་ཐེ་ཙུང་གི་གདུང་རྟེན་དུ་འཇོག་རྒྱུའི་རེ་བ་བཏོན།",
    "གོང་མ་གོ་ཙུང་གིས་སྲོང་བཙན་གྱི་ཆེ་བ་བརྗོད་ཅིང་།",
    "ཚུན་ཝང་གི་ཆོ་ལོའང་སྦྱར།",
    "སྲོང་བཙན་གྱི་སྐུ་བརྙན་རྡོ་ལ་བརྐོས་ཏེ་གོང་མ་ཐེ་ཙུང་གི་བང་སོའི་གམ་དུ་བཞག་ཡུན་ཧོས་ཀྱི་ཁྲི་ལོ་དང་པོར།",
    "གོང་མ་ཀོ་ཙུང་གིས་མྱ་ངན་ཞུས།",
    "གོང་མ་ཐེ་ཙུང་གིས་ཁོང་ལ་སྣེ་ལེན་བཟང་པོ་བྱས་པ་ནི་རྒྱལ་ཁབ་གཞན་དག་གི་ཕོ་ཉ་བས་འགྲན་དུ་མེད།",
    "གོང་མས་མགར་སྟོང་བཙན་ལ་གཡས་རུའི་སྐུ་སྲུང་དམག་དཔོན་ཆེན་མོ་ཡུག་ཝེ་ཏ་ཅང་ཅུན་བྱ་བའི་ཆོ་ལོ་སྦྱར།",
    "གོང་མས་ལང་ཞེ་ཁྲེང་ཀོང་ཇོ་བྱ་བའི་ཚ་མོ།",
    "མགར་སྟོང་བཙན་གྱིས་ཕྲན་ལ་རང་གི་ཁབ་ཏུ་ཁྱིམ་ཐབ་ཅིག་མཆིས་ཏེ།",
    "ཕྲན་ངེད་ཀྱང་ཁོ་མོ་དང་འབྲལ་འདོད་མེད།",
    "བློན་པོ་བདག་གིས་ཆུང་མ་ལེན་པའང་མི་རུང་ཞེས་གསོལ་བས།",
    "གོང་མའང་ཁོའི་གཏམ་ལ་ཐུགས་མོས་ཤིང་དྲིན་གྱིས་སྐྱོང་བར་དགོངས་ནས་མགར་གྱི་གཏམ་བདེན་དུ་དགོངས་ཀྱང་གསན་དུ་ནི་མ་བཞེད།",
    "ཐང་གིས་ཀྱང་ཤན་འབྱེད་དཀའ་བར་གྱུར་ནས་ཐག་གཅོད་མ་ཐུབ།",
    "ཧི་ཡོན་རྗེ་བོ་མོ་རུང་ནོ་ཧི་པོ་དང་ཧུང་ཧྭ་ཀོང་ཇོ་གཉིས་ཐར་ཏེ་ལེང་ཀྲིག་ཏུ་བྲོས།",
    "གོང་མས་ཡུག་ཝེ་ཝེ་དམག་དཔོན་ཆེན་མོ་ཞོས་རིན་ཀོས་བྱ་བ་ལྷ་ས་ཏའོ་ཡི་གཡུལ་འདེགས་སྤྱི་ཁྱབ་དམག་དཔོན་ཆེན་མོར་བསྐོས་པ་དང་།",
    "ཙོ་ཝེ་ཡོན་ཝེ་དམག་དཔོན་ཆེན་མོ་ཨ་ཧྲི་ན་ཏོ་ཀྲིན་བྱ་བ་དང་།",
    "བྷོད་ཀྱི་དམག་དཔོན་བློན་ཁྲི་འབྲིང་གིས་ཕམ་པར་བྱས།",
    "དེ་གའི་དཔོན་འབངས་བསད་ཅིང་རྒྱུ་ནོར་འཕྲོག་གོང་མ་ཀོ་ཙུང་གིས་ཧྲང་ཧུའུ་ཙོ་ཕུའུ་ཧྲེའི་ཐབས་ཡོད་པ་ལིག་རིན་ཀོས་བྱ་བ་ཐའོ་ཧི་ཅུན་ལ་བྷོད་དམག་འགོག་ཏུ་བཏང་།",
    "གོང་མས་ཀྲུང་ཧྲུའུ་ལིན་གྱི་ཐབས་ཡོད་པ་ལིས་ཅིན་ཞོན་བྱ་བ་ལ་ཧྲན་ཀྲིག་གི་ཏུའུ་ཏུའུ་གཅིག་ལྕོགས་བྱེད་དུ་བཅུག་ཅིང་།",
    "གོང་མས་དབྱི་ཀྲིག་གི་ཀྲུང་ཧྲིའི་ཐབས་ཡོད་པ་ལིས་ཞའོ་དབྱི་དང་།",
    "བྷོད་དམག་ས་མཐོ་སར་བསྡད་ནས་བཀག་དམག་དཔོན་གཞོན་པ་ཙོ་ལིན་ཅུན་ཡོན་ཝེ་དམག་དཔོན་ཧེ་ཁྲི་ཁྲང་ཀྲི་བྱ་བས་དམག་དཔའ་སྟོབས་ཅན་ལྔ་བརྒྱ་ཁྲིད་དེ་མཚན་མོ་ཞིག་ལ་བྷོད་ཀྱི་སྒར་ཐོག་ཏུ་རྒྱུགས་པ་ན།",
    "ལིས་ཅིན་ཞོན་གྱིས་དམག་དཔུང་ཁྲིད་ནས་ཧྲན་ཀྲིག་ཏུ་ཕྱིར་ལོག་གོང་མས་ཁོའི་གོ་གནས་ཧིན་ཀྲིག་གི་ཚི་ཧྲི་ལ་མར་ཕབ།",
    "སྔོན་ཆད་ཅན་ནན་ནས་བསྡུས་པའི་དམག་རྣམས་ཀྱིས་མའོ་ཀྲིག་གི་ནུབ་ལྷོའི་སར་ཨན་རོང་ཁྲིན་བྱ་བའི་མཁར་བརྩིགས་ཏེ་ས་དེ་ག་སྲུང་།",
    "ཡུན་རིང་མ་སོང་བར།",
    "སྐབས་དེར་བྷོད་དམག་གིས་ཞང་ཞུང་དང་།",
    "ནུབ་ཏུ་ཐང་གི་ཆིག་ཚི་དང་།",
    "གོང་མ་ཀོ་ཙུང་གིས་ལིག་ཧྲིན་ལི་སོགས་ཕམ་པའི་གཏམ་གསན་ནས།",
    "ཀྲུང་ཧྲུའུ་ཧྥེ་རིན་གྱི་ཐབས་ཡོད་པ་ཀོ་ཀྲིན་དབྱི་བྱ་བ་ན་རེ།",
    "ངེད་ནས་དཔོན་དམག་མངག་རྒྱུ་ལོ་རེ་བཞིན་མཚམས་ཆད་མ་མྱོང་།",
    "ཐག་རིང་སར་འཐབ་ཏུ་སོང་ནའང་རྒྱལ་ཁ་མི་ལོན།",
    "རྒོལ་ཐེངས་གཅིག་གིས་བྷོད་དམག་རྨེག་མེད་དུ་གཏོང་ཐུབ་ཅེས་ཟེར།",
    "ཅི་ཧྲི་ཀྲུང་གི་ཐབས་ཡོད་པ་ལིག་ཆི་ཞུན་དང་།",
    "དེར་མཐུད་ནས་ཧེ་ཁྲི་ཁྲང་ཀྲི་བྱ་བས་ལེང་ཧྥེ་ཁྲོན་ནས་བྷོད་ཀྱི་དམག་དཔོན་ཆེན་མོ་བཙན་བྲོད་དང་སུའུ་ཧི་ཀོས་བྱ་བ་གཉིས་ཕམ་པར་བཏང་།",
    "བྷོད་དམག་ཕྱིར་ལོག་སོང་།",
    "སྲིད་ཀྱི་བྱ་བ་རྣམས་ཁྲི་འབྲིང་གིས་བསྐྱངས།",
    "ཁྲི་འབྲིང་གིས་བློན་ཧན་ཏོ་ཕང་བྱ་བ་མངགས་ཏེ་བཙན་པོ་བཀྲོངས་པའི་གནས་ཚུལ་ཞུ་བར་འོངས་ཤིང་།",
    "གོང་མ་ཀོ་ཙུང་གིས་ལང་ཅང་གི་ཐབས་ཡོད་པ་སུང་ལིན་ཝུན་བྱ་བ་བྷོད་དུ་འདས་མཆོད་བྱེད་པར་མངགས།",
    "ཡུན་ལུང་གི་ཁྲི་ལོ་དང་པོར།",
    "གོང་མ་ཀོ་ཙུང་གིས་ཀོང་ཇོའི་འདས་མཆོད་དུ་ཕོ་ཉ་མངགས།",
    "ཝུན་ཁྲང་ཡུག་ཞང་གི་ཐབས་ཡོད་པ་ཝེ་ཏེ་ཅ་བྱ་བ་མན་ཞི་ཏའོ་ཡི་སྤྱི་ཁྱབ་དཔོན་ཆེན་དུ་བསྐོས་ཤིང་།",
    "ཡུན་ཁྲང་གི་ཁྲི་ལོ་དང་པོར།",
    "གོང་མས་ཁོ་གཉིས་དམག་ཁྲིད་དེ་བྷོད་དམག་ལ་འཐབ་ཏུ་མངགས་ཀྱང་མ་སོང་བས།",
    "གོང་མས་ཝུན་ཁྲང་ཡུག་ཞང་གི་ཐབས་ཡོད་པ་ཚིན་ཁྲུང་ཆིན་བྱ་བ་ཝུའུ་ཝེ་ཏའོ་ཡི་གཡུལ་འདེགས་སྤྱི་ཁྱབ་དམག་དཔོན་ཆེན་མོར་བསྐོས་ཏེ་བྷོད་དམག་དང་འཐབ་ཏུ་བཏང་ཡང་།",
    "དམག་རྣམས་ཀྱང་གཡུལ་དུ་མ་སོང་།",
    "བྷོད་ཀྱི་ཚེ་དཔོན་ཧི་སུའུ་བྱ་བས་རང་གི་འཁོར་དང་ཀོས་ཁྲོན་གྱི་ཚོ་བ་ཁག་ཁྲིད་དེ་ཐང་ལ་མགོ་འཛུལ་དུ་ཡོང་།",
    "ཝུའུ་ཙེ་ཐེན་གྱིས་ཡུན་ཡུ་ཆན་ཝེ་དམག་དཔོན་ཆེན་མོའི་ཐབས་ཡོད་པ་ཀྲུང་ཞོན་ཡུས་བྱ་བ་ལ་ཨན་ཧྥུའུ་ཧྲིའི་ཆོ་ལོ་སྦྱར་ཞིང་།",
    "ཁྲང་ཧྲིག་གི་ཁྲི་ལོ་དང་པོར།",
    "ཝང་ཞའོ་རེ་ཡི་གོ་གནས་ཀྱང་ཕབ།",
    "བག་གཡེང་གིས་གནས་ཚུལ་རྟོག་པར་ཕྱིན་པ་ལ།",
    "སྟོབས་ཟད་དེ་བྷོད་དམག་གིས་བསད།",
    "ཁྲི་འབྲིང་སྤུན་མཆེད་ཀྱིས་དམག་གི་བྱ་བ་གཉེར་བ་ནས་བཟུང་།",
    "ཁོང་གི་མཆེད་ཟླ་རྣམས་ཕྱོགས་ཀྱི་དམག་དཔོན་དུ་བསྐོས།",
    "ལོ་ངོ་སུམ་ཅུ་ལྷག་གི་རིང་ལ་ཐང་རྒྱལ་ཁབ་ས་མཚམས་ཀྱི་གེགས་སུ་གྱུར།",
    "ཁྲི་འབྲིང་གིས་དམག་ཤུགས་ལ་བརྟེན་ནས་བཀའ་མ་རྩིས།",
    "གཡུལ་མ་སྤྲད་པར་ཁྲི་འབྲིང་གི་དཔུང་འཐོར་བས།",
    "ཁྲི་འབྲིང་གིས་རང་སྲོག་བཅད།",
    "བཙན་བྲོད་ཀྱིས་རང་གི་འཁོར་སྟོང་ཕྲག་གཅིག་ལྷག་དང་།",
    "བཙན་བྲོད་ལ་ཧྥུའུ་གོ་དམག་དཔོན་ཆེན་མོ་དང་།",
    "ཞིན་ཡུག་ཝེ་དམག་དཔོན་ཆེན་མོའམ།",
    "དེ་ནས་གོང་མས་བཙན་བྲོད་ལ་རང་གི་འཁོར་དང་བཅས་ཧུང་ཡོན་ཀུའུ་བྱ་བར་སོང་ནས་བྷོད་དང་འཐབ་དགོས་པའི་བཀའ་ཕབ།",
    "ཁྲང་སུང་ཞན་བྷོད་དམག་གིས་བསྐོར།",
    "ལུང་ཡུག་གི་ཅུན་དང་ཀྲིག་སོ་སོའི་ཏ་ཧྲིའི་ཐབས་ཡོད་པ་ཐང་ཞིག་ཅིན་བྱ་བས་ཧོང་ཡོན་ཀུའུ་ཞེས་པའི་འགག་ཏུ་མང་པོ་རྗེ་ལྷ་ཟུང་དང་འཐབ་སྟེ།",
    "རོལ་མོ་སོགས་རྩེད་མོ་མང་པོ་འཁྲབ་སྟོན་བྱས།",
    "དེར་བློན་མི་བཟའ་ན་རེ།",
    "ཀྲུང་གོའི་རོལ་མོ་སོགས་ལ་གསལ་ཆ་མེད་པས།",
    "དེ་ནས་བློན་མི་བཟའ་སོགས་ཕན་ཚུན་གྱི་གདོང་ལ་ཅེ་རེར་བལྟ་ཞིང་འཛུམ་བག་དང་བཅས་ཏེ།",
    "ཁོ་བོ་ཅག་ཐང་གི་ཁབ་ཏུ་ཕོ་ཉར་འོངས་ཏེ།",
    "བདག་གིས་ལྷག་བསམ་རྣམ་པ་དཀར་པོས་གོང་མའི་སྐུ་ཚེ་བསྐལ་བརྒྱུར་བརྟན་པའི་སྨོན་འདུན་ཞུ་བ་ཡིན་ཞེས་ཟེར།",
    "འབངས་རྣམས་ཀྱིས་ཁྲི་འདུས་སྲོང་གི་སྲས་ཁྲི་ལྡེ་གཙུག་བཙན་བཙན་པོར་བསྐོས།",
    "གོང་མ་ཀྲུང་ཙུང་གི་ཧྲིན་ལུང་ཁྲི་ལོ་དང་པོར།",
    "གོང་མ་ཀྲུང་ཙུང་གིས་ཀྱང་དེར་མྱ་ངན་ཞུས་ཏེ།",
    "བཙན་པོའི་གྱོས་མོས་བློན་ཆེན་སྟོང་བཞེར་བྱ་བ་མངགས་ཏེ་སྐྱེས་ཕུལ་ཞིང་།",
    "མོའི་ཚ་བོ་ལ་གཉེན་བསླངས།",
    "གོང་མ་ཀྲུང་ཙུང་ནས་རང་གིས་གཉོར་བའི་དབྱུང་ཝང་ཧྲིག་ལི་བྱ་བའི་སྲས་མོའི་མིང་དུ་ཅིན་ཁྲིན་ཀོང་ཇོར་གསོལ་ནས་བྷོད་དུ་བརྫངས།",
    "ཅིན་ལུང་གི་ཁྲི་ལོ་གསུམ་པའི་ཟླ་བཅུ་གཅིག་པར།",
    "གོང་མ་ཀྲུང་ཙུང་གིས་སྐྱེད་མོས་ཚལ་གྱི་སྤོ་ལོ་རྩེད་རྭར་གསོལ་སྟོན་བཤམས་ཏེ།",
    "གོང་མ་ཀྲུང་ཙུང་ཡང་དེར་གཟིགས་སུ་ཕེབས།"
  ]
}