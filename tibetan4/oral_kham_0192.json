    "ང་རང་ཁྱེད་ཡོང་སའི་དུར་ཐང་གཞན་དེ་ལ་འཇིགས་པ་ཡིན།",
    "གླུ་སྐད་ལྡན་པའི་མི་ཞིག་གང་ན་འདུག་འོ་ན་ང་རང་ཡང་འཕྲུལ་འཁོར་ཞིག་ཡིན་ནམ།",
    "ཁོའི་མྱུར་དུ་མགོ་བོ་མཐོན་པོར་བཏེགས་ཏེ་ཕྱོགས་བཞིར་ལྟ་ཙམ་བྱས་པ་ན་ངུ་སྐད་དེ་མ་གཞི་དར་ཤིང་མཐོན་པོ་དེའི་འོག་ཏུ་གྲགས་ཀྱིན་འདུག་ལ་ངུ་སྐད་དེ་རང་ཉིད་ཀྱི་ཕྱེད་ཀ་ཡིན་པའང་གཞི་ནས་ཚོར།",
    "ཁོའི་ཁང་མིག་འདིའི་སྒོ་ད་དུང་དམ་པོར་གཏན་འདུག་ཀློག་མཁན་རྣམ་པ།",
    "སྐབས་ཤིག་ལ་ང་རང་སྐད་རིགས་ཡ་མ་བརླ་ལབ་པའི་ཕོ་གསར་བདུན་བརྒྱད་ཀྱིས་རུབ་བྱུང་།",
    "ང་རང་ཨེན་ཙམ་གྱིས་ཆུ་རྐུའི་ནང་དུ་བརྫངས།",
    "ཁོ་རང་ཁང་པ་འདི་དང་བྲལ་ཏེ་ལོ་ངོ་ལྔ་དྲུག་ཙམ་འགོར་བས།",
    "ཁོས་ཁྱེད་རང་འབོད་དོན་ཅི་ཡིན་ནམ་ཞེས་བཤད།",
    "མར་སྣུམ་དང་དྲེག་པ་བྱུགས་པའི་གདོང་ལ་མཛུ་གུ་ལྔ་ཡི་རྗེས་ཤུལ་སྲིད་ལ་ལན་གཅིག་དང་འཕྲེད་དུ་ལན་གཅིག་དྲུད་འདུག་མིག་འབྲས་གཉིས་ཀྱི་སྟེང་དུ་མར་རྙིང་བྱུགས་ཡོད་པས་མིག་རྩ་ནི་དམར་ལོག་གེ་ཡོད།",
    "ཀླུ་འབུམ་ཁོའི་ལྟག་རྒྱབ་ན་ལངས་འདུག་ཡང་ཁ་ནས་ཝུ་བ་དང་སྣ་ནས་དུ་རླངས་འཕྱུར་བཞིན་ཀླུ་འབུམ་གྱི་སྟེང་ལ་བརྒྱུགས་པ་དང་།",
    "ཀླུ་འབུམ་ནི་སྔར་བཞིན་དུ་ཁོའི་རྒྱུབ་ནས་ལངས་འདུག་ཞྭ་ལ་ཁུག་ཏིས་བསམ་འཕེལ་གླང་བོས་ལག་ཁུ་ཚུར་ལ་བརྟེན་ནས་ཀླུ་འབུམ་སྤ་བཀོང་དུ་མི་ཆུགས་པ་མཐོང་རྗེས་བསམ་འཕེལ་གླང་བོ་ལ་ཕ་གསོད་ཀྱི་ལག་དམར་ལ་མཚོན་ཆ་མི་འཛིན་པར་ཁུ་ཚུར་ཕྱར་ནས་ཅི་བྱེད།",
    "དེ་ནས་ལག་གཡུག་ཅིག་བྱས་པ་ན་ལག་ཏུ་ཟླ་དཀར་ཚེས་འདྲའི་གྲི་གུག་ཆུང་ཆུང་ལག་ལ་རན་པ་ཞིག་བཟུང་འདུག་གྲི་དེའི་སོ་ཁ་སྟ་ཁ་ཇི་བཞིན་སྒོར་ལ།",
    "རྒྱུ་ཚིགས་ལ་གཏད་དེ་ལན་བཞི་བསྣུན་ཙ་ན།",
    "འཇིག་རྟེན་ཁམས་འདི་ཁམ་ཁམ་ཞིག་ཡིན་ཟེར་བ་ལ་བདེན་ཞད་ཡོད་འདུག་དེ་མིན་ཕྱིན་བདག་ལྟ་བུའི་ཁ་ལ་ཟས་དང་རྒྱབ་ལ་གོས་མེད་པ་ཞིག་ལ་ཞུ་བ་བྱེད་མི་ཞིག་ཡོད་མི་སྲིད།",
    "ཀླུ་འབུམ་གྱིས་ཁོ་རང་བསྐྱབས་ཚུལ།",
    "ཨར་འདམ་གྱི་གཞུང་ལམ་ངོས་ནས་བཞུར་གྱིན་ང་རང་ལ་དངངས་སྐྲག་སྐྱེས་པ་འདི་སུ་ལ་ཞུ།",
    "ང་རང་གང་ལ་ཐོན་ན་ཡུལ་དང་།",
    "ང་རང་ཡུན་རིང་ལ་དམིགས་མེད་དུ་འཁྱམ་ལ།",
    "ཉི་འོད་རི་རྩེ་ནས་ཐོན་ཞིང་ང་རང་སྦྲ་སྒོ་ནས་ཆས།",
    "ང་རང་ཉི་འོད་ཀྱི་དམར་ཞིང་ཚ་བའི་ཟེར་ཁུ་ལ་ཐིམས་ནས་སྐད་ཅིག་སྐད་ཅིག་ལ་ཡར་ནས་ཡར་ལ་འཕགས་ཤིང་ཆེ་ནས་ཆེ་རུ་བགྲོད།",
    "ང་རང་གདོད་མ་ནས་ཕྱོགས་མེད་དུ་རྒྱུ་བའི་སྤྲིན་ཕུང་ཞིག་ལགས་པས་ནམ་ཞིག་ལ་འཚོལ་སྙེགས་ཀྱི་མཐའ་ལ་སླེབས་ཤིང་ནམ་ཞིག་ལ་ཉི་འོད་དེ་རུམ་ནས་འགྲོ།",
    "བགྲོད་སྟངས་གང་ཞིག་དང་ཐོབ་ཤོར་ཅི་ཞིག་ཡིན་ཡང་ང་རང་སྦྲ་སྒོ་ནས་ཐོན་པས་ཁ་ཕྱོགས་ལ་འགྱུར་བ་མེད།",
    "ང་རང་བྱ་ཞིག་ཏུ་སྤྲུལ་ནས་ཁུ་སིམ་པའི་རི་ལུང་འདི་ནས་ཕ་ཡུལ་དུ་འཕུར་ཐུབ་རྒྱུ་བྱུང་ན་ཅི་མ་རུང་སྙམ་པའི་བསམ་བློ་ཞིག་ཀྱང་སྐྱེས་བྱུང་།",
    "པདྨ་ཚེ་རིང་དང་བཀྲ་ཤིས་གཉིས་སི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་དུ་བགོ་རྒྱུ་ཞེས་སོགས་ཀློག་བཞིན་འདུག་ངས་ད་ང་རང་གང་ཞིག་ཏུ་བགོའམ།",
    "བགྲང་བྱ་ཉི་ཤུའི་རྗེས་སུ་གནས་ཚུལ་དེ་དག་དྲན་དུས་སྐབས་འགར་ངུ་ཤོར་བ་དང་སྐབས་འགར་དགོད་བྲོ་བ་ལྟ་བུར་གྱུར་འདུག།",
    "ཕྱི་དྲོར་ཁྱིམ་ལ་ལོག་དུས།",
    "འོན་ཀྱང་ཡིད་སྐྱོ་བ་ནི་བུམ་ཆུང་ལ་ཉེ་ཆར་ཡུལ་མི་ཚོས་ཡང་བསྐྱར་རྨ་ཁ་ཟབ་ཅིང་རྒྱ་ཆེ་བ་ཞིག་བཟོས་འདུག་དགུན་གནང་སྐབས་སུ་ང་རང་ཕ་ཡུལ་དུ་ལོག་དུས།",
    "ལོས་ཡིན།",
    "གཙང་བོའི་ཕ་རོལ་ན་ངུ་བ་ཁྱེད་རང་ཡིན་ལ།",
    "རི་བོའི་ཚུར་རོལ་ན་སྐྱོ་བ་ང་རང་ཡིན།",
    "ང་རང་ཕོ་ལོ་བཞི་གསུམ་བཅུ་གཉིས་ལ་སོན་ཏེ་ཕུགས་བསམ་ཀྱི་གནས་ཚང་ཕྱི་རོལ་ལ་གཡར་བ་ནས་བཟུང་།",
    "བུ་རབས་ཚ་རྒྱུད་ཀྱི་དངུལ་ཕོར་ཀྱང་བགྲེས་པོ་ཚོའི་སྨྲ་སྒོ་ལྟར་སུ་ལའང་གཟེད་འདུག་པ་མཐོང་བྱུང་།",
    "བཏུལ་ཐང་ནི་ཕྱི་དྲོར་བསླེབས་འདུག་སྟོན་ཀ་ཐོན་ལ་ཉེ་དུས།",
    "བཏུལ་ཐང་ནི་ཕྱི་དྲོར་བསླེབས་འདུག་ལ།",
    "ཕྱི་མར་ང་རང་ཆུ་ཕྲན་ཞིག་ཏུ་གྱུར་ནས་ཉིན་བཞིན་བྱེ་ཐང་འདིའི་རྨ་ཁ་བརྒྱུད་དེ་བཞུར་ཞིང་།",
    "ངས་ནམ་རྒྱུན་ཁྱེད་རང་དྲན་ཞིང་ཁྱེད་རང་གླེང་ལ།",
    "ངས་སྔར་བཞིན་ཁྱེད་རང་དྲན་ཞིང་ཁྱེད་རང་བོས།",
    "ཁོ་རང་གཉིད་ལས་སད་པ་ན།",
    "ཨུ་ཚུགས་དང་རང་ཚུགས་མེད།",
