    "ཐིག་གི་བྱ་རྗེས་བྱ་རྗེས་སུ་ཐལ་བ་དང་།",
    "ཐིག་གི་ཉ་ཡང་ཉར་ཐལ་བ་དང་།",
    "སྨྲ་བའི་སེང་ཆེན་སེང་ཆེན་དུ་ཐལ་བ་དང་།",
    "བློ་བཟང་རྐྱལ་སྟོང་རྐྱལ་སྟོང་དུ་ཐལ་བ་ལ་སོགས་པ་མཐའ་ཡས་ཏེ།",
    "མུན་ནག་འདོམ་འཁྱམ་མོ་གསུང་།",
    "ལམ་སྲིད་པ་གསུམ་གྱི་འབྱུང་འཇུག་གིས།",
    "རིགས་ལམ་མི་ཤེས་པ་རང་རེད།",
    "འཆི་བའི་མིང་གིས་བཏགས་ན་འཆི་བ་ཡིན་པས་མ་ཁྱབ་པར་ཕ་རོལ་པོ་ལ་སྒྲུབ་མི་དགོས།",
    "སྐྱེ་བ་དང་འཆི་བའི་མིང་བཏགས་པའི་འཇིག་པ་བརྒྱུད་མར་བྱེད་ཙམ་གྱིས་རང་གི་འདོད་ངན་དེ་ཡང་སྒྲུབ་མི་ཐུབ་ཅིང་ཕ་རོལ་པོས་དྲངས་པའི་ལུང་གི་ནུས་པ་ལའང་མི་གནོད་པའི་ཕྱིར།",
    "ནང་གི་འདུ་བྱེད་རྣམས་ནི།",
    "འཆི་བའོ་ཞེས་གཞུང་བགྲང་གིས་མི་ལང་བར་གསུངས་པའི་ཕྱིར།",
    "རང་ཅག་ལྔ་བརྒྱ་པ་རྣམས་ཀྱི་གཙུག་གི་ནོར་བུ་དཔལ་མགོན་འཕགས་པ་ཀླུའི་ཞལ་སྔ་ནས་གང་ཉིད་ད་སྔ་ཡན་ཆད་ནང་པའི་གྲལ་གོང་ན་བཞུགས་པ་དེ་ཕུད་ལ་གཅེར་བུ་པའི་ཚོགས་སུ་ཕྱུངས་ཤིགསྨྲས་པ།",
    "དེ་ཉིད་ཉིན་མོར་བགྱིད་པའི་མཆོག་རྣམས་དང་།",
    "ཧ་ས་བཛྲ་གཙུག་གི་ནོར་བུར་འཛིན།",
    "འཛིན་མ་ལྔ་བདོའི་དུག་གིས་ཁེབས་པ་ན།",
    "བ་མོ་ཏི་སེའི་ང་སྙམ་མཐོང་འཆང་བས།",
    "འཕུར་བར་རེ་བ་རྒྱ་ཡིས་བཅིངས་པ་ལྟར།",
    "གཟུར་གནས་རྣམ་དཔྱོད་ཀྱི་འདབ་མ་རབ་ཏུ་ཡངས་པ་དག་གི་ཡི་ག་འཇོ་བའི་ཚིགས་སུ་བཅད་པ་བུང་བ་གཞོན་ནུའི་གླུ་དབྱངས་སོ།",
    "དེ་ལྟར་རྩ་བའི་དམ་བཅའ་གསུམ་ཞིབ་མོ་རྣམ་འཐག་ཏུ་བཀག་ནས་ད་ནི་རྩ་བའི་ས་བཅད་གཉིས་པ་འཁྲུལ་བ་གཞན་མཛུབ་མོ་རི་སྟོན་གྱིས་ཆེ་ལོང་དུ་མཚོན་པ་ནི།",
    "ཞེས་བྲིས་འདུག་པ་ནང་འགལ་ངོ་མི་ཤེས་པ་དང་ངོ་ཚ་མེད་པ་དང་ཁྲེལ་མེད་པ་སོགས་ཉེས་པ་བརྒྱ་ཕྲག་གི་འབྱུང་ཁུངས་ཡིན་ཏེ།",
    "རྒྱུད་བླ་དར་ཊཱིཀ་གསུམ་མ་གཟིགས་པར་སེམས་ན་ནི།",
    "གཟིགས་ཀྱང་དེ་དག་གི་ཚིག་དོན་མ་མཁྱེན་པར་འདོད་ན་ནི།",
    "དེ་དག་གཟིགས་ཤིང་མཁྱེན་བཞིན་དུ་རྗེ་ཡབ་སྲས་ལས་ལྷག་པའི་མཁས་འདོད་གྲགས་འདོད་ཀྱིས་འཁྲུལ་བར་རགས་པར་གསུངས་པར་དོགས་ན་ནི།",
    "གསོར་མི་རུང་གི་སྐུར་འདེབས་གཞན་དང་མི་མཉམ་པའི་སྐྱོན་དང་།",
    "ཅེས་གསུངས་པས་ཞི་བ་ལྷས་རང་མཚང་བསྟན་པར་ཐལ་བ་དང་།",
    "ཁྱོད་མགོ་ཟླུམ་དང་ངུར་སྨྲིག་ཅན་དུ་བྱས་པ་ཡང་ཤཱཀྱ་ཐུབ་པའི་ལད་ཟློ་ཡིན་ཕྱིར་མཚང་དུ་འགྱུར་བས་ན།",
    "དེ་རིང་ནས་རྭ་བཞི་རྐང་གསུམ་མགོ་གཉིས་ལག་པ་བདུན་གྱི་ཀུན་སྤྱོད་ལ་གནས་པར་མཛོད་ཅིག་དེ་ལའང་ཕྱི་རོལ་པའི་ལད་མོ་བྱས་པའི་མཚང་ཅན་དུ་ཐལ་བ་ལྟག་རྡོའི་བདེ་བར་གཤེགས་པས་འཕེན་སྲིད་མོད།",
    "གཞིག་ཏུ་མེད་པའི་འཛིན་མཚམས་ཕྲ་མོ་ཞིག་ཁོ་བོས་བགྱིད་པར་དམ་བཅའ་འོ།",
    "ཁྱོད་ལྟ་བུས་མཐོང་བ་དང་གོ་དཀའ་བར་ཡོད།",
    "ཉོན་མོངས་ཤེས་བྱ་ལམ་གསུམ་གྱིས།",
    "བདག་གིར་མ་བྱས་པ་དང་།",
    "དེའི་ཕྱིར་ཐོབ་པ་ཆད་པའི་ཚུལ་ལའང་ནང་གསེས་ཀྱི་ཞིབ་ཆ་ཕྲ་མོར་དབྱེ་རིགས་པ་དང་།",
    "རྒྱུད་ཅེས་པ་བར་མ་ཆད་པའི་རྒྱུན་ལ་ཟེར་ཞིང་སྐད་ཅིག་སྔ་ཕྱི་གསུམ་ལྡན་ལ་རྒྱུད་ཆགས་དང་རྒྱུན་ལྡན་ཞེས་ཟེར་མོད།",
    "རྗེ་ཡབ་སྲས་ནང་ཕན་ཚུན་དང་སོ་སོའི་གཞུང་ནའང་གསུང་ཟིན་མི་མཐུན་པ་ཇི་འདྲ་འདུགའགའ་ཞིག་གི་ལུགས་ལྟར་དེ་དག་གི་ཕྱོགས་གཅིག་ལ་མིག་བཙུམ་རྐྱང་བྱས་པས་གང་ནས་འཐུས།",
    "རྟོག་གེ་སྣང་བར་མྱུ་གུ་བདེན་མེད་མ་ཡིན་དགག་ཡིན་པའི་ཚིག་རིས་ཀྱང་སྣང་ན་གཞན་ལྟ་ཅི་སྨོས་པས་བླུན་པོ་ཁྱོད་ལྟ་བུ་ཕེར་ཤ་མ་ཆེ་བར་ཁ་རོག་ཏུ་བག་ཡོད་བསྟེན་ན་ལེགས་སོ།",
    "རྩང་པོ་ཁྱོད་ཀྱིས་བྱེ་སྨྲའི་ལུགས་ལ་བསམས་འདྲ་ཡང་ཞིབ་ཆ་ཅི་ཡང་མེད་པར་སངས་འཕགས་ཟག་བཅས་སུ་བསྒྲུབས་པས་དོན་གྱིས་སྐྱོན་དེ་དག་རང་སྟེང་དུ་འགེལ་མ་དགོས་པར་བླངས་པའོ་ཞེས་པ་འདི་ལ་བརྟེན་ནས་ཁྱོད་ཀྱི་བྱེད་སྲོལ་ལྟར་ཁྱོད་ལ་སྐྱོན་བཅུ་གཉིས་འབབ་པ་ཡིན་ཏེ།",
    "བརྡ་དག་ལོ་པཎ་གྱི་ལུགས་བཟང་དྲི་མ་མེད་པའི་ཕྱོགས་མགོའང་མ་བཏོད་པར་རང་གིས་རང་ཉིད་པཎྜི་ཏར་ཁས་བླངས་པའི་དམ་བཅའ་རྩ་བ་ནས་ཤོར་བའི་སྐྱོན།",
    "སྒྲས་རང་གི་ཀུན་སློང་ལྟར་སྟོན་དགོས་པས་ཁ་སྒང་གི་ཚིག་དེས་གོང་མའི་ལུགས་ལ་སངས་འཕགས་ཟག་བཅས་སུ་སྒྲུབ་པ་མ་ཡིན་པར་མི་འདོད་བཞིན་དུ་ཁས་ལེན་དགོས་པའི་སྐྱོན།",
    "དོན་གྱིས་སྐྱོན་དེ་དག་རང་སྟེང་དུ་བླངས་ཞེས་པས་སྐྱོན་དེ་དག་རང་སྟེང་དུ་མ་བླངས་པར་འབྲུག་ལྟར་བསྒྲགས་པ་སྟེ་མ་ཎི་པ་རྟོལ་མགོའི་རྡུང་རེས་དང་མཚུངས་པའི་སྐྱོན།",
    "ངག་ཀྱལ་དང་འཆལ་གཏམ་ཞེས་ཡང་ཡང་སྨྲས་པ་འདི་ལ་བརྟེན་ནས་ཀྱང་ཁྱོད་ལ་སྐྱོན་བཅུ་གཉིས་འབབ་སྟེ།",
    "ཉོན་མོངས་ཅན་ཀུན་ཀྱལ་བ་ཉིད།",
    "ཅེས་གསུངས་པ་ལྟར་ངག་ཀྱལ་ཀུན་སློང་ལ་ལྟོས་ནས་འཇོག་གི་ཚིག་མཛེས་མི་མཛེས་དང་དོན་འགྲིག་མི་འགྲིག་ལ་ལྟོས་ནས་མི་འཇོག་པས་ངག་ཀྱལ་དང་འཆལ་གཏམ་གྱི་རྣམ་གཞག་ལ་རྨོངས་པའི་སྐྱོན།",
    "རྡོ་རྗེའི་སྤུན་ལ་ཕྲག་དོག་ཞེ་སྡང་གིས་ཀུན་ནས་བསླངས་ཏེ་ཚིག་ངན་དུག་གི་ཚེར་མ་བརྒྱུད་མར་བཏབ་པས་རང་རྒྱུད་ཀྱི་སྡོམ་པ་གསུམ་ག་ཧྲུལ་བོར་བརྫིས་པའི་སྐྱོན།",
    "གནས་བརྟན་ཞལ་མར་གཟིགས་མདུན་གྱི་དོང་ལ་མི་ལྟ་བའི་སྐྱོན།",
    "རྒན་ཞུགས་པའི་ངག་ཀྱལ་གྱི་མཆོད་བརྗོད་ནས་བཟུང་མཇུག་རྩོམ་གྱི་བར་ཚིག་གཅིག་ཀྱང་མ་ལུས་པར་སུན་ཕྱུངས་ཞེས་པ་འདི་ལ་བརྟེན་ནས་ཁྱོད་ལ་སྐྱོན་བཅུ་བཞི་འབབ་སྟེ།",
    "ཕལ་བའི་སྣང་ངོར་སྟོན་པ་ཐུགས་རྗེ་ཅན་ཡང་དགུང་ལོ་ཉེར་དགུའི་སྟེང་བཙུན་མོ་དྲུག་ཁྲི་སྲས་དང་བཅས་པ་སྤངས་ཏེ་རབ་ཏུ་བྱུང་བས་དེའང་རྒན་ཞུགས་སུ་ཐལ་བར་འགྱུར་བའི་སྐྱོན།",
    "ཁ་སྒང་མཚན་གཞིར་བཟུང་བའི་སྨོད་ཚིག་རང་གི་དགེ་རྩའི་བུད་ཤིང་ཤུལ་མེད་དུ་སྲེག་པར་བྱེད་པ་འདིས་དེ་དག་ཐམས་ཅད་ལ་རྒན་ཞུགས་ཞེས་སྐུར་བ་འདེབས་པར་འགྱུར་བའི་སྐྱོན།",
    "ཁ་སྒང་ཁོ་ན་ལས་གཞན་ལ་དེ་ལྟར་མི་འགྱུར་ཟེར་ན་བུད་མེད་ལ་སྨོད་པའི་རྩ་ལྟུང་གི་རྣམ་གཞག་ལ་རྨོངས་པའི་མུན་པ་འཐིབས་པའི་སྐྱོན།",
    "མི་གྲལ་ནས་བུད་པ་དང་།",
    "ཁ་སྒང་གི་ཚིག་ལ་འཐད་པ་གཅིག་ཀྱང་མེད་ཅེ་ན་བློ་གྲོས་དང་ལྡན་པ་དག་གི་རྣ་བར་འབབ་མི་འབབ་ཀྱི་རྟོག་དཔྱོད་ཙམ་ཡང་མི་བྱེད་པ་ནི།",
    "རིགས་པའི་གད་རྒྱངས་སུ་རང་དགར་ཁ་སྒང་གི་གཞུང་ལ་དོན་མེད་བྱིས་པའི་རོལ་རྩེད་བཞིན་དུ་ཨུ་ཚུགས་མཐར་སྐྱེལ་གྱིས་སྐྱོན་བཞི་འབབ་སྟེ།",
    "ཟླ་བས་ལེགས་ལྡན་ལ་སྐྱོན་བརྗོད་པའི་ཚུལ་དང་རྗེས་སུ་མཐུན་པར་ཁྱོད་ཀྱི་ཚིག་གསུམ་ལ་སྐྱོན་སུམ་ཅུ་སོ་བརྒྱད་རྩེ་འཇོའི་རྣམ་པར་སྨྲས་པ་སྟེ།",
    "ཁྱོད་རང་འཁོར་དང་བཅས་པས་ལུས་ངག་ཡིད་གསུམ་རྩལ་དུ་སྤྲུགས་ནས་ཞུ་དག་ཤ་ཟད་རུས་ཟད་བྱས་པའི་ལག་རྗེས་དྲི་བྲལ་ཤེལ་གྱི་མཆོད་སྡོང་ལྟ་བུར་རློམ་པ་འདི་ལ་ཁོ་བོས་ཞར་བྱུང་གྲུར་ཞུགས་ཀྱི་ངང་ཚུལ་ལྟར་བལྟས་པས་མཐོང་བའི་མ་དག་འཁྲུལ་རིས་རྨོངས་མུན་གྱི་རང་མཚང་ཤས་ཙམ་ཞིག་ཚིག་ཚོགས་བསྐྱུང་བའི་ཕྱིར་ཤོག་བུའི་མདུན་རྒྱབ་གཉིས་མིང་གཞི་ད་དང་རས་མཚོན་ནས་འདོམས་པར་བྱ་སྟེ།",
    "ཐོག་མར་རྩོད་ཡིག་གི་མིང་གི་སྐབས་རིགས་པའི་གད་རྒྱང་།",
    "མི་ལ་དག་གི་ལན་ཝར་གྱི་རྐང་པ་རེ་རེའི་མཐར་ཉིས་ཤད།",
    "རེ་དྲུག་པའི་ད་ལྔ་པར་མངས་པར་འགྱུར།",
    "རེ་བདུན་པའི་ད་བཞི་པར་མི་རྟོགས་པས་ཁྱབ།",
    "རེ་དགུ་པའི་ར་གཉིས་པར་མཚན་ཉིད་པ་ཅིག་མ་སྐྱེས་ན།",
    "བརྒྱད་ཅུ་པའི་ར་གཉིས་པར་ལང་ཚོ་ལ་འགོང་ན།",
    "དེའི་དྲུག་པར་རྩང་པོ་ཁྱོད།",
    "བརྒྱ་བཅུ་བཞི་པའི་ད་དྲུག་པར་ཁས་བླངས་ཆོག་པར་ཐལ།",
    "བརྒྱ་ཉེར་བརྒྱད་པའི་ར་གསུམ་པར་རིང་གི་དངོས་པོ།",
    "བརྒྱ་སུམ་ཅུ་པའི་ར་དྲུག་པར་དེས་ཐལ།",
    "ས་ལ་བཞུགས་པ་དག་གིས་ཀྱང་གཏིང་དཔོག་པར་མི་ནུས་པའི་ཡེ་ཤེས་ཀྱི་ཕུང་པོར་གྲུབ་པ།",
    "ཐམས་ཅད་མཁྱེན་པ་དཔལ་མི་ཕམ་མཚོ་བྱུང་བཞད་པའི་ལང་ཚོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཤ་སྟག་གིས་བློ་རྩལ་སྤུངས་ཏེ་ཞུ་དག་བགྱིས་པའི་དཔར་མ་ལའང་མ་དག་རྡུལ་གྱི་རྙོག་མ་འདི་མཆིས་ན་རང་མིང་གི་དག་ཆ་ཙམ་ཡང་མི་ཤེས་ཤིང་མི་གྲལ་དུ་མ་ཆུད་པར་ཁྱི་གྲལ་ལ་བཏོན་པའི་སོ་སོ་སྐྱེ་བོ་འཁྲུལ་བ་ཅན་དངུལ་རྭའི་སྲེ་བོའི་བྲིས་མ་ལ་ཡིག་དཀར་ཡིག་ནག་གང་ཡིན་མི་ཤེས་པ་དང་།",
    "ཁྱོད་རང་རྗེས་འབྲང་དང་བཅས་པ་ལ།",
    "གོམ་པ་གང་གི་ས་བྱིན་པས།",
    "དེང་ཕྱིན་ཆད་རང་བསྟོད་ས་གསུམ་གྱི་ཁྲེལ་རྒོད་འཆོར་བ་དེ་ཧ་ལའི་དུག་གི་ལོ་མ་ལྟར་དོར་ནས་སྲེ་བོའི་སྔོན་ལ་མི་གྲལ་དུ་ཚུད་པར་མཛོད་ཅིག་ནང་ཕན་ཚུན་བསྟོད་བསྔགས་འོས་མ་ཡིན་པས་འདའ་བ་འདི་ནི།",
    "ངེས་དོན་དམ་པའི་སྐྱེས་བུ་རྣམས་ཀྱི་མདུན་སར་ཕྱི་སའི་འདམ་དང་རྣག་གི་ཀླུང་བཞིན་མི་འགྱུར་རམ་དཔྱད་པར་བྱ་བའི་རིགས་སོ།",
    "པསཾ་ག་སོགས་ཐལ་བ་དང་ཐལ་འགྱུར་གྱི་སྐད་དོད་ཟ་འོག་གི་རི་མོ་ལྟར་མ་འདྲེས་པར་བསྒྲིག་ཏུ་ཡོད་ཅིང་ཀྲྀཏ་ཀྱི་རིགས་ལམ་ནམ་མཁའི་དབྱིངས་ཀྱི་རྗེས་འགྲོར་བཀྲ་བཞིན་ཐལ་འགྱུར་ལ་ཐལ་བའི་སྐད་དོད་ལོག་པར་སྦྱར་བ་དང་།",
    "རིང་དུ་དར་དང་གཞན་ཡོད་དང་མི་བཟད་ཀྱི་སྐད་དོད་དང་དཀྲུག་ཚུལ་སོགས་འོལ་ཟོབ་དུ་མ་ལ་རྐང་པ་རེ་རེ་ཞིང་ཉིས་ཤད་ཀྱིས་བཅད་པ་དང་།",
    "ནཎྜའི་ཆོ་ག་ཡ་མུ་ན་ས་བྷ་ལ་ཝའི་ལང་ཚོ་དར་ལ་བབ་ཞེས་པ་འདིས་བྲྀཏྟའི་སྤྱི་གྲངས་དྲ་ྣ་རའི་ཆོ་གར་ཐལ་བ་དང་།",
    "ནང་གསེས་ཀྱི་གནས་ཨུདྡྷིཥྛའི་ཆོ་གར་ཐལ་བ་ལ་སོགས་པར་འགྱུར་ཞིང་།",
    "དེ་ལྟར་ན་རྟོགས་བྱ་དྲུག་པོ་དེ་རྟོགས་བྱེད་དྲུག་པོ་དེ་དང་དེ་དག་ཏུ་ཐལ་བར་འགྱུར་བ་སོགས་རྨོངས་ཤིང་རྩིང་བའི་སྐྱོན་མཐའ་ལས་འདས།",
    "ཇ་ཆང་ཚོལ་བའི་གླུས་ཀྱང་ཁྲེལ་སྙམ་པ།",
    "པ་ཏྲའི་རིས་སུ་སེམས་ཀྱི་རྒྱུད་འཁྱོག་ཅིང་།",
    "ཕ་རོལ་སྨོད་པ་ཚིག་གི་རྒྱན་དུ་རློམ།",
    "འ་འུར་གར་དུ་ཟློ་བའི་བློ་བཟང་གིས།",
    "ཧ་ལའི་དུག་གི་འཁྲི་ཤིང་ཆེར་བདོ་ཡང་།",
    "ཨ་ཞེས་བཙོག་ཆུས་སློད་པ་འདི་རེ་བླུན།",
    "ཧ་ཧ་ཧ་ཅང་ཀུ་རེའི་ཚིག་སྦྱོར་ལ།",
    "གང་གང་གང་གི་སྐྱོན་ནམ་མིན་ཡང་རུང་།",
    "ཞེས་ཁ་སྒང་ལ་ཡི་རང་དང་ཉིད་ལ་རྩེ་འཇོའི་རྣམ་པར་ཐལ་བའོ།",
    "ཞེས་གསུངས་པའི་དོན་རྟག་ཏུ་ཡིད་ལ་གཅགས་པ་ཡིན་མོད།",
    "འོན་ཏང་བརྒལ་བ་འདིའི་གོང་འོག་ཏུ་རྩུབ་མོའི་ཚིག་གི་རྣམ་འགྱུར་དུ་མ་ཞིག་ཐོན་སོང་བ་ནི།",
    "ཁྱོད་རང་ནས་ཡུལ་གང་ཆེ་གང་གཉན་དང་།",
    "ས་པཎ་ལ་ཧོར་གྱི་རྒྱལ་པོས་ཁྱོད་བོད་ཀྱི་བནྟེ་ཁ་བརྡར་ཚ་གསུངས་པའི་གཤིས་ཀྱང་ཅུང་ཟད་ཡོད་པ་སྟེ།",
    "ཁ་སྒང་ལ་ཁྱོད་ཀྱིས་ཇི་ལྟར་བརྒལ་བའི་རི་མོ་དཔེར་བཟུང་སྟེ་རྩོད་པའི་གྲྭར་ཞུགས་ན་ཤོག་བུ་ལྔ་བརྒྱ་དྲུག་བརྒྱར་ལོངས་པས་ཀྱང་བློ་བཟང་འདོད་པ་བྱུང་རྒྱལ་གྱི་འཁྲུལ་བའི་མཐའ་བས་པར་གང་ནས་རྙེད།",
    "དེའི་ཕྱིར་རྩ་བའི་དམ་བཅའ་གསུམ་ཞིབ་མོ་རྣམ་འཐག་ཏུ་འགོག་པ་དང་།",
    "འཁྲུལ་བ་ཆེ་ལོང་མཛུབ་མོ་རི་སྟོན་དུ་མཚོན་པས་ཆོག་ཤེས་པར་བྱས་པ་སྟེ།",
    "རེ་ཞིག་རྫོགས་སོ།",
    "བསྒྲུབ་པའི་ཡན་ལག་མི་བརྗོད་པའམ་མ་ཡིན་པ་བརྗོད་པ་ལ་སོགས་པའི་སྒོ་ནས་རང་ཉིད་ཚར་བཅད་དུ་འགྱུར་མོད།",
    "མཚོན་དང་མི་ལ་སོགས་པས་བསྡིགས་པས་ཀྱང་མི་སྨྲ་བར་བྱེད་ནུས་པས་དེ་ཡང་བསྟན་པ་སྲུང་བར་ཧ་ཅང་ཐལ་ལོ་ཞེས་དང་།",
    "གཡོ་སྒྱུའི་ཚིག་གསུམ་ལ་རང་གི་ཚེ་ཧྲིལ་བོའི་བྱ་རྒྱུ་དང་།",
    "བོད་བླུན་པོ་དག་གི་དགག་ཡུལ་ནི།",
    "རབ་འབྱམས་ནམ་མཁའི་སྣང་འཛིན་དག་ནི་ཡིད་འོང་གཞལ་དཀའི་རྩེ་འཇོའི་ཟེར་མ་རྟག་ཏུ་འཐོར་མོད་དེ་ལྟ་ནའང་།",
    "དབུ་ཚད་གསང་མཐའི་སྐལ་བ་ཆེར་སྦོམ་བྷ་གི་ར་ཐར་ལྷུང་ལྷུང་འབེབས་པའི་ཛ་ཧྥུ།",
    "གནས་གསུམ་གཞལ་བྱ་ཡངས་པའི་ས་ཆེན་བློ་གྲོས་གོམ་པ་གཅིག་གིས་མནན།",
    "དབྱངས་ཅན་ངག་གི་བདུད་རྩི་ལ་ཆགས་ཚངས་པའི་གཏམ་གྱི་འབྲུག་སྟོང་ལྡིར།",
    "ཕྱོགས་ཀྱི་སྒེག་མོའི་རྣ་ལུང་འགྲིམ་ཕྱིར་སྙན་པའི་དར་ལྕེ་མཁའ་ལ་བསྐྱོད།",
    "རང་གི་སྣང་བར་ཞེན་པས་སེམས་གཏུགས་པའི།",
    "ངོ་ཚ་བོར་ནས་ལུག་གི་རིལ་མ་ལ།",
    "གཞན་གྱིར་སྨྲས་ན་ཁྱོད་ལ་ཅིའི་ཕྱིར་རྒོལ།",
    "རྙེད་དཀའི་མི་ལུས་མནོག་ཆུང་གི།",
    "ལྡན་པར་འདུན་པས་མོས་པ་སྐྱེད།",
    "བློ་གསལ་རིགས་བཟང་དཔལ་མོའི་བཞིན།",
    "ཁྱོད་ཕ་བདག་ནི་བུ་སྟེ་བུ།",
    "བཟང་པོར་གཟིགས་པའི་བཟང་པོའང་དེ།",
    "ཀེ་རེར་ཁེངས་པའི་ཨེ་རཎྜ།",
    "བསེར་བུས་ལྡེམ་ཡང་གད་མོའི་ཡུལ།",
    "བདག་གི་རིགས་བདག་རྡོ་རྗེ་སེམས།",
    "མི་ཤིགས་ཐིག་ལེའི་དཔྱིད་གཟིགས་པ།",
    "རང་གི་བཞིན་ལ་མིག་བསྲེལ་ནས།",
    "ཡིད་ཀྱིས་འདྲོངས་པའང་མ་ལགས་མོད།"
