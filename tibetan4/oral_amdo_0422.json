    "གང་ལྟར་བོད་ཀྱི་དེ་སྔ་དང་དེང་སྐབས་ཀྱི་གནས་ཚུལ་དང་འབྲེལ་བའི་གློག་བརྙན་སྟོན་གྱི་ཡོད་ངེས་རེད།",
    "དེ་བཞིན་གློག་བརྙན་བཟོ་རྒྱུ་ཡང་གཞི་མ་ལྟ་བུ་བོད་ཀྱི་གནས་ཚུལ་དང་འབྲེལ་བ་ཆགས་ཡོད་འདུག་བོད་ལ་འཛམ་གླིང་སྤྱི་ཡོངས་ཀྱིས་འཛམ་གླིང་གི་ཡང་ཐོག་ཅེས་བརྗོད་ཀྱི་འདུག་པ་ནི་བདེན་པ་རེད།",
    "བོད་ནི་ས་མཐོན་པོ་དང་ས་ཆ་གྲང་མོ་ཡིན་པར་བརྟེན་གངས་དང་འཁྱགས་པ་ཤུགས་ཆེན་པོ་ཡོད།",
    "དེ་ལྟ་བུའི་ཐོག་ནས་ཨེ་ཤི་ཡའི་ཕལ་ཆེར་ཁྱོན་ཡོངས་ཀྱི་རྒྱུག་ཆུ་གལ་ཆེ་བ་མང་པོ་ཞིག་བོད་ནས་ཡོང་གི་ཡོད་སྟབས།",
    "རང་བཞིན་གྱིས་དེ་གསོ་རྒྱུར་དུས་ཡུན་རིང་པོ་འགོར་གྱི་རེད།",
    "དེའི་ནང་འཛམ་གླིང་ལྷོ་བྱང་རྩེ་མོ་གཉིས་ནས་དྲོད་ཚད་ཀྱི་ཤུགས་རྐྱེན་ག་ཚོད་སླེབས་ཀྱི་ཡོད་པ་ལྟར།",
    "བོད་ས་མཐོའི་སྒང་ནས་ཀྱང་ཤུགས་རྐྱེན་དེ་ཡོང་གི་ཡོད་པར་བརྟེན།",
    "གཙོ་བོ་ལུང་པ་གང་ཞིག་ཡིན་རུང་གཡས་གཡོན་ནས་རིག་གཞུང་དེ་འདྲ་ཡོང་གི་རེད།",
    "དེང་སྐབས་དུས་རབས་ཉེར་གཅིག་པ་འདིའི་ནང་ཚན་རིག་པ་དང་མཉམ་དུ་ནང་སེམས་ཁམས་རིག་པའི་སྐོར་དང་དངོས་པོའི་རྡུལ་ཕྲ་མོའི་ཐོག་ལྟ་སྐབས།",
    "ང་ཚོ་མི་ཚང་མ་འཚེ་བ་དང་གཅིག་གིས་གཅིག་ལ་ཕྲག་དོག་འགྲན་སེམས།",
    "གཙོ་བོ་ནང་བསམ་བློའི་ཐོག་ནས་ཡོང་གི་ཡོད་པ་གཞི་ནས་དེང་སྐབས་དོ་སྣང་ཡོང་གི་འདུག་དེ་སྔ་ཡིན་ན་རྐྱེན་ངན་དེ་དག་ཕྱི་རོལ་ནས་རང་བཞིན་གྱིས་བྱུང་བ་ལྟ་བུ་ཞིག་རེད་བསམས་ཀྱི་ཡོད་ཀྱང་དེ་ལྟར་མིན།",
    "ཚན་རིག་དང་འཕྲུལ་ཆས་རིགས་ནི་མིར་ཕན་བདེ་སྒྲུབ་སླད་མ་གཏོགས་གནོད་པ་སྐྱེལ་ཆེད་མ་རེད།",
    "ངོ་མཚར་སྐྱེ་རྒྱུའི་ཚན་རིག་གི་ཤེས་བྱ་དང་འཕྲུལ་ཆས་རིགས་ཀྱང་མིར་སྡུག་བསྔལ་བཟོ་རྒྱུའི་ཐོག་འགྲོ་གི་འདུག་དེ་ལྟ་བུའི་སྐབས་ཤིག་ལ་དཔལ་ན་ལེནྡྲ་ནས་བརྒྱུད་པའི་སེམས་ཁམས་དང་།",
    "དེ་རིང་ཁྱེད་རང་ཚོས་བོད་དང་འབྲེལ་བའི་གློག་བརྙན་ལྟ་སྐབས།",
    "འོན་ཀྱང་གཟུགས་དང་སྒྲ་ཡོང་གི་ཡོད།",
    "དེར་བརྟེན་གཟུགས་སྒྲ་ནི་མིའི་ཡིད་བློའི་རྣམ་པར་ཤེས་པ་དང་རྟོགས་པའི་སྒང་ནས་ཡོང་གི་ཡོད་པ་མ་ཟད།",
    "རྟོགས་པ་བཟང་ངན་གྱི་རྐྱེན་པས་མིར་བདེ་སྡུག་ཡོང་གི་ཡོད།",
    "སྤྱི་ཡོངས་ལ་ཕན་གནོད་ཡོང་རྒྱུ་ཡང་རྩ་བ་ཡིད་བློར་ཐུག་གི་ཡོད།",
    "དེར་བརྟེན་སེམས་ཁམས་རིག་པ་ནི་ཧ་ཅང་གལ་ཆེན་པོ་རེད་འདུག་ངོས་རང་རྒྱུན་དུ་ནས་དེར་དོ་སྣང་བྱེད་ཀྱི་ཡོད།",
    "ཁྱེད་རང་ཚོ་ཚང་མས་བསམ་བློ་བཏང་སྟེ་གནས་ཚུལ་གང་ཞིག་ཡིན་རུང་སྣང་ཚོད་ཙམ་ལ་ཆ་མ་བཞག་པར།",
    "ཡིན་ལུགས་གང་འདྲ་ཡིན་མིན་ཐོག་ཞིབ་འཇུག་བྱེད་དགོས་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་རེད།",
    "ཞིབ་འཇུག་དང་བརྟག་དཔྱད་བྱེད་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་རེད།",
    "ཞེས་གསུང་འཕྲིན་སྩལ་འདུགསྤྱི་ནོར་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་ཨ་མ་ཝེ་གར་ལགས་འདས་གྲོངས་སུ་གྱུར་བར་ཁོང་གི་ནང་མིར་སེམས་གསོའི་གསུང་འཕྲིན་སྩལ་བ། །",
    "ཨ་མ་ཝེ་གར་ལགས་འདས་གྲོངས་སུ་གྱུར་བ་དེས་བོད་མིའི་གྲོགས་པོ་བློས་ཐུབ་གཅིག་མེད་པར་གྱུར་ཡོད།",
    "ལྕམ་སྐུ་དམ་པ་ཁོང་གིས་མི་ཚེ་ཧྲིལ་པོའི་རིང་བོད་མི་ཉམ་ཐག་རྣམས་ལ་བརྩེ་གདུང་ཧ་ཅང་ཆེན་པོས་གཟིགས་རྟོག་གནང་ཡོད།",
    "ཨ་མ་ལགས་རང་ཉིད་ཐུགས་སེམས་ཧ་ཅང་བཟང་པོ་ཡོད་པ་མ་ཟད།",
    "ཞེས་གསུང་འཕྲིན་སྩལ་འདུགསྤྱི་ནོར་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་འདི་ལོའི་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མཁན་གཉིས་ལ་འཚམས་འདྲི་མཛད་པ། །",
    "དེ་ཡང་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་མ་ལ་ལ་ཡུ་སུབ་ཛ་ཡ་མཆོག་ལ་འཚམས་འདྲི་མཛད་དོན།",
    "མི་ཁག་གཅིག་གི་བློར་མ་བབ་ནས་མགོ་བོར་མེ་མདའ་བརྒྱབ་སྟེ་རྨས་སྐྱོན་བཏང་ཡོད།",
    "དམ་པ་ཁོང་གིས་འཚེ་མེད་ཞི་བའི་ལམ་སྟོན་འོག་སྐུ་ཚེ་ཧྲིལ་པོའི་རིང་འབད་བརྩོན་གནང་བ་དེས་འཛམ་གླིང་ཁྱོན་ཡོངས་ལ་ཤུགས་རྐྱེན་ཧ་ཅང་ཐེབས་ཡོད།",
    "དེར་བརྟེན་ཐེངས་འདིར་གཱན་དྷིའི་རྗེས་འཇུག་པ་སྐུ་ཉིད་མཆོག་ལ་ཞི་བདེའི་གཟེངས་རྟགས་འབུལ་ལམ་ཞུ་རྒྱུ་འདི་ནི་གཱན་དྷི་མཆོག་གི་མཛད་རྗེས་ལའང་ངོས་འཛིན་ཞུས་པ་ཞིག་ཡིན་པར་ངོས་ཀྱིས་ངོས་འཛིན་ཞུ་བཞིན་ཡོད།",
    "པ་ཀི་སི་ཐན་གྱི་བུད་མེད་གཅིག་ལ་ཐུན་མོང་གིས་འབུལ་རྒྱུའི་ཐག་གཅོད་གནང་བ་འདི་ནི་ང་ཚོ་ཚང་མ་འགྲོ་བ་མི་རིགས་གཅིག་གྱུར་གྱི་འདུ་ཤེས་འཛིན་པའི་ཐོག་ནས་འཛམ་གླིང་འདི་དེ་སྔ་ལས་ཞི་བདེ་དང་བདེ་སྐྱིད་ལྡན་པ་ཞིག་སྐྲུན་ཐུབ་རྒྱུ་ཡིན་པའི་བརྡ་ལན་སྤྲད་པ་ཞིག་ཡིན་པར་ངོས་ཀྱིས་བསམ་བཞིན་ཡོད།",
    "གལ་ཏེ་ང་ཚོས་སོ་སོ་རང་ཉིད་ཙམ་མ་ཟད།",
    "འཛམ་གླིང་གི་གནས་སྟངས་ཇེ་བཟང་དུ་གཏོང་དགོས་ན།",
    "དེ་ནས་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་བཀའ་སློབ་སྩལ་དོན།",
    "ངོས་ཀྱིས་རྒྱུན་ལྡན་ང་ཚོ་ཚང་མ་འགྲོ་བ་མི་གཅིག་མཚུངས་ཡིན་བསམ་བཞིན་ཡོད་པ་ལས།",
    "སྤྱིར་ང་ཚོའི་དབར་རིགས་རུས་དང་ཐོབ་གོ་ས།",
    "གལ་ཆེ་ཤོས་འཛམ་གླིང་འདིའི་ནང་མི་འབོར་ཐེར་འབུམ་བདུན་ཡོད་པ་ཚང་མ་ལུས་དང་སེམས་ཚོར་གང་གི་ཆ་ནས་འགྲོ་བ་མི་རིགས་གཅིག་པ་ཆགས་ཡོད།",
    "ང་ཚོ་ཚང་མར་ཀླད་པ་ཡོད་པར་བརྟེན་དུད་འགྲོ་གཞན་དང་མཚུངས་པར་བདེ་བ་འདོད་པ་དང་སྡུག་བསྔལ་མི་འདོད་པ་གཅིག་གྱུར་ཡིན་སྟབས།",
    "དེར་བརྟེན་ང་ཚོས་རང་གི་རྣམ་དཔྱོད་འདི་དུས་ནམ་ཡང་མཐུན་པའི་རྐྱེན་དུ་འགྲོ་ཐབས་ལ་སྔར་ལྷག་འབད་དགོས།",
    "དེ་བཞིན་ངོས་ཀྱིས་བསླབ་པ་མཐར་སོན་གྱི་སློབ་ཕྲུག་ཁྱེད་རང་ཚོར་འཚམས་འདྲི་ཞུ་རྒྱུ་ཡིན།",
    "ད་ཆ་ཁྱེད་ཚོར་ལག་འཁྱེར་ཐོབ་ཡོད་ཀྱང་ལག་འཁྱེར་དེ་ཙམ་གལ་ཆེན་པོ་མ་རེད།",
    "གོང་ས་མཆོག་དང་བསྟི་གནས་ཁང་གི་འགན་འཛིན།",
    "ཕྱི་ལོ་༡༩༥གོང་ལ་རྒྱ་གར་བྱང་ཕྱོགས་ས་མཚམས་སུ་དམག་མི་གཅིག་རྐྱང་མེད་པར་ཞི་བདེ་ལྷིང་འཇགས་རེད།",
    "ཕྱོགས་མཚུངས་རྒྱ་ནག་གི་སྲིད་འཛིན་ཞི་ཅིན་ཕིང་ནི་རྒྱ་ནག་གི་དེ་སྔའི་སྲིད་འཛིན་གཞན་དང་བསྡུར་ན།",
    "ཐེངས་འདིར་རྒྱ་གར་ནང་རྒྱལ་དོན་འཚམས་གཟིགས་སྐབས་རྒྱ་གར་ནས་བློ་སྐྱེད་ལེན་ཐུབ་པའི་ཡིད་ཆེས་ཡོད།",
    "རྒྱ་དཀར་ནག་གཉིས་ཕན་ཚུན་གཅིག་གིས་གཅིག་ལ་ཡིད་ཆེས་བྱས་ཏེ།",
    "དེ་ནས་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་བཀའ་སློབ་སྩལ་དོན།",
    "ཁྱེད་རང་ཚོས་ལོ་གཉིས་ཙམ་གོང་ནས་ངོས་ལ་མགྲོན་འབོད་གནང་བ་ལྟར།",
    "ང་ཚོར་འཕྲད་བཞིན་པའི་དཀའ་ངལ་མང་དག་ཅིག་མིས་བཟོས་པ་ཆགས་ཡོད།",
    "ང་ཚོ་ཚང་མ་འགྲོ་བ་མིའི་ཁྱིམ་ཚང་གཅིག་ཡིན་བསམ་པའི་འདུ་ཤེས་འཛིན་རྒྱུའི་ཚབ་ཏུ་ཕན་ཚུན་དབར་ཐོབ་གོ་ས་དང་།",
    "གལ་ཏེ་ང་ཚོས་འགྲོ་བ་མི་ཚང་མར་གཅིག་གྱུར་གྱི་འདུ་ཤེས་འཛིན་ཐུབ་ན་ཕན་ཚུན་དབར་རྙོག་གྲ་ཡོང་གཞི་གང་ཡང་མེད།",
    "དབུལ་ཕོངས་ཇེ་མང་དུ་ཕྱིན་ནས་དབུལ་ཕྱུག་དབར་གྱི་ཁྱད་པར་ཧ་ཅང་ཆེ་རུ་འགྲོ་གི་ཡོད།",
    "དེར་བརྟེན་དབུལ་ཕྱུག་དབར་ཁྱད་པར་ཧ་ཅང་ཆེན་པོ་བྱུང་ཚེ་དཀའ་ངལ་འཕྲད་ཀྱི་རེད།",
    "དཀའ་ངལ་དེ་དག་སེལ་བར་ང་ཚོས་འགྲོ་བ་མི་རིགས་གཅིག་གྱུར་གྱི་འདུ་ཤེས་འཛིན་དགོས་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་ཆགས་ཡོད།",
    "སྐབས་དེར་ཚོགས་བཅར་བ་ཞིག་གིས་དེང་སྐབས་རྒྱ་ནག་གི་སྲིད་འཛིན་རྒྱ་གར་ནང་འཚམས་གཟིགས་སུ་ཕེབས་ཡོད་པ་དེར་དགོངས་ཚུལ་ཇི་ཡོད་ཀྱི་དྲི་བ་ཞུས་པར་བཀའ་ལན་སྩལ་དོན།",
    "རྒྱལ་ཁབ་ཡར་རྒྱས་ཕྱོགས་སུ་གོམ་སྟབས་སྤོ་ཐུབ་རྒྱུར་མཐུན་པའི་རྐྱེན་དུ་འགྲོ་བཞིན་ཡོད་པ་འདི་གསལ་པོ་གཟིགས་ཐུབ་པའི་རེ་བ་བྱེད་བཞིན་ཡོད།",
    "རྒྱ་ནག་གི་སྲིད་འཛིན་ཞི་ཅིན་ཕིང་གིས་དེང་སྐབས་རྒྱ་ནག་ནང་ལྐོག་ཟའི་དཀའ་ངལ་སེལ་ཆེད་འབད་བརྩོན་ཤུགས་ཆེ་གནང་བཞིན་པར་བསྔགས་བརྗོད་ཞུ་རྒྱུ་ཡིན།",
    "ལྷག་པར་སྲིད་འཛིན་ཞི་ཅིན་ཕིང་གིས་ཉེ་ལམ་ཕ་རན་སིའི་རྒྱལ་ས་པེ་རི་སིའི་ནང་།",
    "དེ་དག་དང་བསྡུར་ན་སྲིད་འཛིན་ཞི་ཅིན་ཕིང་དངོས་ཐོག་བདེན་འཚོལ་གནང་མཁན་ཞིག་ཡིན་པའི་སེམས་ཚོར་ཡོང་བཞིན་འདུག་སྤྱི་ཡོངས་ནས་ངོས་ལ་རེ་བ་ཆེན་པོ་ཡོད།",
    "ངོས་ཀྱིས་སྲིད་འཛིན་ཞི་ཅིན་ཕིང་མཆོག་གི་ཡབ་ཞི་ཊོང་ཤུན་མཆོག་ངོ་ཤེས་ཀྱི་ཡོད།",
    "ཞི་ཊོང་ཤུན་དམ་པ་ཁོང་རྒྱ་ནག་གི་སྲིད་བློན་ཀྲའོ་ཨེན་ལའི་སྒེར་དྲུང་གནང་མྱོང་ཡོད།",
    "དེ་ནས་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་བཀའ་སློབ་སྩལ་དོན།",
    "གཞི་རྩའི་ང་ཚོ་ཚང་མ་འགྲོ་བ་མི་ཞིག་ཡིན་པ་མ་ཟད།",
    "ང་ཚོ་ཚང་མ་འཚོ་གནས་ཆེད་ཕན་ཚུན་གཅིག་གི་གཅིག་ལ་བརྟེན་དགོས་པ་ཞིག་ཆགས་ཡོད།",
    "ལྷག་པར་ང་ཚོ་ཚང་མ་བདེ་བ་འདོད་པ་དང་སྡུག་བསྔལ་མི་འདོད་པ་གཅིག་མཚུངས་ཆགས་ཡོད་སྟབས།",
    "དུས་རབས་༢༡འདི་བཞིན་ཞི་བདེ་ལྡན་པའི་དུས་རབས་ཤིག་བསྐྲུན་ཆེད་དཀའ་རྙོག་རྣམས་གྲོས་མོལ་གྱི་ལམ་ནས་སེལ་ཐབས་གནང་དགོས།",
    "ང་ཚོར་རང་ཆས་སུ་སྐྱེས་དུས་ནས་བྱམས་བརྩེ་དང་།",
    "རྒྱ་གར་གྱི་ཁ་ཆེ་ཤི་ཡ་དང་སུ་ནི་དབར་རྩོད་རྙོག་དེ་ཙམ་ཡོང་གི་མེད།",
    "རྒྱ་གར་གྱི་ཁ་ཆེའི་དབུ་ཁྲིད་ཚོས་པ་ཀི་སི་ཐན་དང་ཨ་རབ་ནང་ཤི་ཡ་དང་སུ་ནི་ཁ་ཆེའི་དབར་གྱི་དཀའ་རྙོག་སེལ་ཐབས་བྱེད་དགོས་ཀྱི་རེད་བསམ་བཞིན་ཡོད།",
    "ཕྱོགས་མཚུངས་འབར་མར་ཡོད་པའི་ནང་པའི་དཀའ་ངལ་རེད།",
    "ང་ཚོ་རྒྱ་གར་གྱི་ནང་པ་ཚོས་དེའི་ཐོག་དངོས་གནས་ཕན་ཐོགས་བྱེད་ཐུབ་ཀྱི་རེད་སྙམ་གྱི་ཡོད།",
    "ཉིན་གྲངས་གཉིས་རིང་གི་ལྷན་ཚོགས་འདི་བཞིན་དོན་དང་ལྡན་པ་ཞིག་ཡོང་བའི་སྨོན་འདུན་ཞུ་རྒྱུ་ཡིན།",
    "ལྷན་ཚོགས་དབུ་འབྱེད་ཀྱི་མཛད་སྒོ་གྲུབ་བསྟུན་མགོན་པོ་གང་ཉིད་མཆོག་སྐུ་སྒེར་ངོས་ནས་ཚོགས་བཅར་བ་རྣམས་ལ་དྲན་རྟེན་གྱི་ཚུལ་དུ་སྐུ་ཐང་རེར་གསོལ་རས་སྩལ་ཡོད་པ་མ་ཟད།",
    "ཕྱི་ཚེས་༢༡ཉིན་ལྷན་ཚོགས་མཇུག་སྒྲིལ་ཐོག་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་བཀའ་སློབ་སྩལ་དོན།",
    "ལྷག་བསམ་རྣམ་དག་གིས་འགན་འཁུར་བཞེས་ཏེ།",
    "ཅེས་པའི་བརྗོད་གཞིའི་ཐོག་བཀའ་སློབ་སྩལ་གྲུབ་མཚམས་ཚོགས་བཅར་བ་ཞིག་གིས་འཛམ་གླིང་གི་རྒྱལ་ཁབ་ཁག་གཅིག་ལུང་འདྲེན་གནང་སྟེ།",
    "མགོན་པོ་གང་ཉིད་མཆོག་གིས་བཀའ་ལན་ཕེབས་དོན།",
    "སེ་ཁོ་ཊ་ལན་ཌེ་མི་དམངས་ཀྱིས་མང་མོས་ལམ་ནས་འོས་བསྡུའི་ཐག་གཅོད་བྱས་པའི་གནས་ཚུལ་ཐོས་སྐབས་ཧ་ཅང་དགའ་པོ་བྱུང་།",
    "ཕྱོགས་མཚུངས་མགོན་པོ་གང་ཉིད་མཆོག་གིས་ཉིན་འདིར་རྒྱ་གར་གྱི་དེ་སྔའི་སྲིད་བློན་མན་མོ་ཧན་སིངྒ་མཆོག་མཇལ་འཕྲད་སོགས་ཀྱི་མཛད་འཕྲིན་ཁག་ལེགས་པར་གྲུབ་མཚམས་ཕྱི་ལོ་༢༡༤ཟླ་༩ཚེས་༢༢ཉིན་རྒྱ་གར་གྱི་རྒྱལ་ས་ལྡི་ལི་ནས་མཁའ་ལམ་བརྒྱུད་ཕྱེད་ཡོལ་ཆུ་ཚོད་༢།",
    "འཛམ་གླིང་འདིའི་ཐོག་གི་དཀའ་ངལ་མང་དག་ཅིག་ང་ཚོ་མིས་བཟོས་པ་ཤ་སྟག་ཆགས་ཡོད།",
    "འགྲོ་བ་མིས་བཟོས་པའི་དཀའ་ངལ་མི་རང་ཉིད་ཀྱིས་སེལ་དགོས་པ་རེད་མ་གཏོགས་ཐབས་ལམ་གཞན་མེད།",
    "འགྲོ་བའི་སྡུག་བསྔལ་ཕྱག་གིས་མི་སེལ་ལ།",
    "ལྷག་པར་ད་ཆ་ང་ཚོ་དུས་རབས་ཉེར་གཅིག་ནང་བསླེབས་ཡོད།",
    "དུས་རབས་ཉི་ཤུ་ཐམ་པའི་ནང་དམག་འཁྲུག་སོགས་ཀྱི་དཀའ་ངལ་མང་དག་ཅིག་མིས་བཟོས་པ་རེད་འདུག་དུས་རབས་ཉེར་གཅིག་གི་འགོ་སྟོད་ལ་མིས་བཟོས་པའི་དཀའ་ངལ་མང་པོ་ཞིག་དང་།",
    "འགྲོ་བ་མིས་བཟོས་པའི་དཀའ་ངལ་ཇེ་ཉུང་དུ་འགྲོ་གི་རེད།",
    "མིས་བཟོས་པའི་དཀའ་ངལ་ཉུང་ཙམ་བྱུང་ན་འཛམ་གླིང་འདི་བདེ་ཞིང་སྐྱིད་པ་ཡོང་གི་རེད།",
    "འོན་ཀྱང་སེམས་ནང་དངངས་སྐྲག་བསླེབས་ཏེ་མ་སྐྱིད་པ་ཡོང་གི་འདུག་དེར་བརྟེན་དཀའ་ངལ་སེལ་རྒྱུ་དེ་ང་ཚོའི་དོན་དག་ལ་ཐུག་ཡོད།",
    "ཕྱོགས་གཅིག་ནས་རང་ཉིད་དང་རང་ཉིད་ཀྱི་ཉེ་འཁོར་ཁོ་ནའི་ཆེད་དུ་བསམ་བློ་གཏོང་སྐབས་དཀའ་ངལ་ཡོང་གི་ཡོད།",
    "ང་ཚོ་སྐྱེས་ཙམ་ཉིད་ནས་དགྲ་གཉེན་མེད།",
    "ཨ་རིའི་ཚན་རིག་པ་བགྲེས་སོང་ཞིག་གིས་ལོ་མང་རིང་།",
    "ཁོང་གིས་ང་ཚོས་ཞེ་སྡང་སྐྱེས་སྐབས་ཞེ་སྡང་སྐྱེས་སའི་དགྲ་དེ་མི་སྡུག་པ་ཞིག་མཐོང་གི་རེད།",
    "དོན་དངོས་ཐོག་མི་སྡུག་པའི་ཆ་བརྒྱ་ཆ་༩ཞེ་སྡང་བྱེད་མཁན་སོ་སོའི་སེམས་ཀྱིས་བཟོ་གི་ཡོད།",
    "ཅེས་གསུངས་ཀྱི་འདུག་ཁོང་གིས་ལོ་མང་རིང་མིའི་སེམས་ལ་བརྟག་དཔྱད་བྱས་ནས་ཉམས་མྱོང་བསགས་ཡོད།",
    "རྙོག་གྲ་ཆགས་སྡང་གིས་བཟོ་གི་ཡོད་པ་དང་།",
    "ཆགས་སྡང་དེ་ཡུལ་ལ་འཛིན་པ་ཨ་འཐས་ཤུགས་ཆེན་པོ་ཡོད་པའི་ཐོག་ནས་ཡོང་གི་ཡོད་པ་ཧ་ཅང་གསལ་པོ་རེད།",
    "འཛམ་གླིང་འདིའི་ནང་མི་དུང་ཕྱུར་བདུན་ཅུ་ཚང་མ་སྡུག་བསྔལ་མི་འདོད་པ་ཤ་སྟག་རེད།",
    "ང་ཚོས་མི་དུང་ཕྱུར་བདུན་ཅུ་སྤྱི་ལ་ཕན་པ་ཞིག་གི་ཐོག་བསམ་བློ་གཏོང་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་རེད།",
    "མི་དུང་ཕྱུར་བདུན་ཅུའི་སྡུག་བསྔལ་སེལ་རྒྱུར་ང་ཚོ་མི་རེ་ངོ་རེར་འགན་འཁྲི་ཡོད།",
    "ཡ་རབས་སྤྱོད་བཟང་གི་བསམ་བློ་སླེབས་ཐུབ་རྒྱུ་དང་།",
    "རྒྱ་གར་ནང་ཧ་ཅང་གསལ་པོ་རེད།",
    "ང་ཚོ་མི་དུང་ཕྱུར་བདུན་ཅུ་ཡོངས་རྫོགས་མ་ལས་སྐྱེས་ཏེ།",
    "སེམས་ལ་དངངས་སྐྲག་དང་འཇིགས་སྣང་ཉུང་དུ་འགྲོ་གི་རེད།",
    "དེ་བཞིན་བརྩེ་བའི་གྲོགས་པོ་ཡོད་ན་རང་ཉིད་ཀྱི་སེམས་ལ་ཞི་བདེ་ཡོང་གི་རེད།",
    "རྒྱ་ནག་སྐམ་ས་ཆེན་མོ།",
    "ཉོན་མོངས་སྤངས་པའི་བྲལ་བ་ཞིག་ཡོང་ངེས་རེད་བསམ་པ་ཞིག་བློར་སླེབས་ཀྱི་ཡོད།",
    "རང་ཉིད་ལ་བདེ་སྐྱིད་འཐོབ་ཀྱི་རེད།",
    "ལྷག་པར་བྱམས་བརྩེའི་བློ་བརྒྱུད་ནས་ཕྱི་གསལ་ནང་གསལ་ཐོག་རང་གཞན་ཚང་མ་སྐྱིད་པོ་ཡོང་གི་རེད།",
    "སྐབས་དེ་དུས་ངོས་ཀྱིས་སྐུ་འདྲ་ཆེན་པོ་འདི་འདྲ་ཞིག་བཞེངས་པ་ཧ་ཅང་ཡག་པོ་རེད།",
    "ལྷན་ཁང་ཁག་གི་དྲུང་ཆེ་ཆུང་རྣམ་པ།",
    "མཛད་སྒོ་དབུ་འཛུགས་ཀྱི་ཐོག་མར་ཚང་མ་སྐུ་བཞེངས་ཐོག་སྲིད་སྐྱོང་བློ་བཟང་སེང་གེ་མཆོག་གིས་བོད་རྒྱལ་ཁབ་ཆེན་པོའི་རྒྱལ་དར་མཁའ་དབྱིངས་སུ་སྒྲེང་འཛུགས་གནང་མུར།",
    "ཕྱི་ནང་གི་སྐུ་མགྲོན་རྣམ་པ།",
    "གཞུང་འབྲེལ་མིན་པའི་ཚོགས་པ་ཁག་གི་སྐུ་ཚབ་རྣམ་པ།",
    "སློབ་ཕྲུག་བཅས་ཡོངས་ལ་ངས་བཀའ་ཤག་གི་ཚབ་ཞུས་ཏེ་དགའ་སེམས་འཁོལ་བའི་ངང་ནས་འཚམས་འདྲིའི་བཀྲ་ཤིས་བདེ་ལེགས་ཞུ་རྒྱུ་ཡིན།",
    "བོད་དོན་ལ་ཁ་ཞེ་གཉིས་མེད་ཀྱི་རྒྱབ་སྐྱོར་གནང་མཁན་ཞིག་རེད།",
    "ཕྱི་ཟླ་༡ཚེས་༢ནི་བདག་ཉིད་ཆེན་པོ་གཱན་དྷི་མཆོག་གི་འཁྲུངས་སྐར་ཡིན་སྟབས།",
    "ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་ཚོགས་ཆུང་ངོས་ནས་མི་སྣ་འཚོ་བཞུགས་མེད་མཁན་ཚོར་གཟེངས་རྟགས་འདི་འབུལ་ལམ་ཞུ་གི་མེད་པར་བརྟེན།",
    "འཛམ་གླིང་ཁྱོན་ཡོངས་ནས་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་འབུལ་ལམ་ཞུས་ཁོངས་ནས་མེས་པོ་དམ་པ་གཱན་དྷི་མཆོག་གཙོ་བོ་ཞིག་ཆགས་ཀྱི་ཡོད་པ་ངོས་འཛིན་ཞུ་བཞིན་ཡོད།",
    "དེར་བརྟེན་ཁོང་གི་འཁྲུངས་སྐར་ཉིན་མོར་ང་ཚོས་དུས་དྲན་འདི་སྲུང་བརྩི་ཞུས་པ་ཞིག་ཡིན།",
    "གོང་ས་མཆོག་དང་ཐུགས་ཉེ་པོ་དང་བོད་དོན་ལ་རྒྱབ་སྐྱོར་གནང་མཁན་ཞིག་རེད།",
    "ལྷོ་ཨ་ཕི་རི་ཀར་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་རྣམས་ཀྱི་ལྷན་ཚོགས་འཚོགས་གཏན་འཁེལ་སྐབས།",
    "དེ་རྗེས་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་མང་པོ་ཞིག་གིས་ཀྱང་གོང་ས་མཆོག་ལྷོ་ཨ་ཕི་རི་ཀར་གདན་འདྲེན་ཞུ་མ་ཐུབ་ན།",
    "ཁོང་དང་ཁོ་མོ་ལྟ་བུ་བུད་མེད་རྣམས་ལས་གནས་ནས་ཕབ་ཡོད།",
    "བུད་མེད་དང་བྱིས་པ།",
    "ཕྱི་ལོ་༡༩༩༧ལོར་ཁོང་དང་ཁོང་གི་ཚོགས་པར་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་འབུལ་ལམ་ཞུས་ཡོད།",
    "དེ་རིང་མེས་པོ་དམ་པ་གཱན་དྷི་མཆོག་གི་འཁྲུངས་སྐར་དང་།",
    "དེའི་ཐོག་བོད་དོན་ལ་ཤ་ཚ་དང་རྒྱབ་སྐྱོར་ཤུགས་ཆེ་གནང་མཁན་རྒྱ་གར་གྱི་སྲིད་བློན་ཟུར་པ་ལལ་བྷ་ཧ་དུར་ཤསྟྲཱི་མཆོག་གི་འཁྲུངས་སྐར་ཡང་འཁེལ་ཡོད་པ་དང་སྟབས་བསྟུན།",
    "གལ་ཆེ་ཤོས་ཤིག་དེ་རིང་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་དང་ཐུགས་མཛའ་འབྲེལ་ཆེན་པོ་ཡོད་པའི་བོད་དོན་ལ་རྒྱབ་སྐྱོར་གནང་མཁན་ལྕམ་སྐུ་ཇོ་ཌི་ཝི་ལི་ཡམ་སི་མཆོག་དང་ཤི་རིན་ཨི་བྷ་ཌི་མཆོག་གིས་དབུས།",
    "དེ་རིང་གི་མཛད་རིམ་ནང་ཕེབས་བསུའི་ལས་རིམ་གཉིས་བཞག་ཡོད།",
    "དཔལ་ལྡན་སྲིད་སྐྱོང་མཆོག་གིས་སྤྱི་ནོར་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གི་མཛད་འཕྲིན་ཁག་དང་།",
    "དཔལ་ལྡན་སྲིད་སྐྱོང་མཆོག་གིས་གསུངས་གྲུབ་པར་རྒྱབ་སྐྱོར་ཞུས་པ་དང་ལྷན།",
    "ལྕམ་སྐུ་ཇོ་ཌི་ཝི་ལི་ཡམ་སི་མཆོག་གིས་ཕྱི་ལོ་༡༩༩༢ལོ་ནས་གཞུང་འབྲེལ་མ་ཡིན་པའི་ཚོགས་པ་བཅུའི་སྒྲིག་འཛུགས་ཆུང་ཆུང་ཞིག་བཙུགས་ཏེ་སྐུ་ལས་ཧ་ཅང་བསྐྱོན་ཏེ།",
    "གང་ལྟར་དམག་འཁྲུག་སྐབས་མི་གསོད་ཁྲག་སྦྱོར་མང་པོ་ཞིག་ཡོང་གི་ཡོད།",
    "དེ་དང་ཆབས་ཅིག་ས་འོག་ཏུ་འབར་རྫས་སྦས་ནས་དམག་འཁྲུག་ཚར་རྗེས་མི་མང་དཀྱུས་མ་མང་པོ་ཞིག་གི་ཚེ་སྲོག་ཤོར་གྱི་ཡོད་པ་དེར་ངོ་རྒོལ་གྱི་བརྡ་ལན་བྱས་རྗེས་ཆིངས་ཡིག་བཞག་ཐུབ་པ་བྱུང་ཡོད།",
    "ཕྱི་ལོ་༡༩༧༩ལོར་ཁ་ཆེའི་གསར་བརྗེ་ཆེན་མོ་ཞིག་བྱུང་རྗེས་དཀའ་སྡུག་མང་པོ་ཞིག་མྱངས་ནས།",
    "ད་ཆ་ང་ཚོ་བཞིན་དབྱིན་ཡུལ་དུ་སྐྱབས་བཅོལ་ཐོག་གནས་ཡོད།",
    "སྲིད་སྐྱོང་མཆོག་གིས་གསུངས་པ་ལྟར།",
    "གདུང་སེམས་མཉམ་སྐྱེའི་རྣམ་པ་བསྟན་པ་དེ་དག་ཚང་མ་དུས་སྟོན་འདིའི་ཐོག་མཉམ་ཞུགས་གནང་བ་དང་ཁྱད་པར་མེད་པ་ཞིག་ལ་ངོས་འཛིན་ཞུ་གི་ཡོད།",
    "གཞན་ཡང་ཧོང་ཀོང་ནང་མི་མང་གིས་ཞི་བའི་འཐབ་རྩོད་བྱེད་བཞིན་པའི་དུས་སྐབས་འདིར།",
    "མེས་པོ་དམ་པ་གཱན་དྷི་མཆོག་ལ་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་འབུལ་ལམ་ཞུ་མ་ཐུབ་པ་དེ་ནི་ནོ་བེལ་གཟེངས་རྟགས་ཚོགས་ཆུང་གིས་ནོར་འཁྲུལ་ཧ་ཅང་ཆེན་པོ་ཤོར་ཡོད།",
    "མེས་པོ་དམ་པ་གཱན་དྷི་ཁོང་གི་མཛད་རྗེས་ནི་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་ལས་ལྷག་པ་ཞིག་ཡིན།",
    "འཛམ་གླིང་ནང་གི་མི་རབས་རྒན་གཞོན་ཚང་མས་དམ་པ་ཁོང་གི་མཛད་རྗེས་ལ་མིག་དཔེ་ལྟ་དགོས་པ་ཞིག་ཆགས་ཡོད།",
    "ལྷག་པར་ང་ཚོ་མང་པོ་ཞིག་གིས་ཁོང་གཉིས་ལ་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་ནང་ནས་ཁྱད་དུ་འཕགས་པ་ཡིན།",
    "དེར་བརྟེན་ང་ཚོ་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་མི་གྲངས་བཅུ་བཞིས་ལྷོ་ཨ་ཕི་རི་ཀའི་སྲིད་འཛིན་ཇེ་ཀོབ་ཛུ་མ་མཆོག་ལ་ངོ་རྒོལ་བྱས་ཏེ།",
    "ང་ཚོས་ལྷན་ཚོགས་ནས་ཕྱིར་འཐེན་བྱས་པ་དེ་ལྷན་ཚོགས་གོ་སྒྲིག་ཚོགས་ཆུང་ལ་བརྡ་ལན་སྤྲད་པ་གང་ཡང་མིན།",
    "འོན་ཀྱང་སྐྱིད་པའི་ཉི་མ་མགྱོགས་མྱུར་འཆར་ངེས་རེད།",
    "རང་ཉིད་ལ་དཀའ་ངལ་ཇི་འདྲ་འཕྲད་ཀྱང་རེ་བ་གསོན་པོར་གནས་དགོས་པ་དང་།",
    "མཚན་གྱི་དུས་སུ་མུན་པ་ནག་ཀྱང་རིམ་པས་ཉི་མ་འཆར་སྐབས་གསལ་གྱི་རེད།",
    "ང་ཚོས་ཉི་མ་འཆར་རྒྱུར་ངང་སྒུག་བྱེད་ཐུབ་པ་དགོས།",
    "རྒྱ་ནག་གཞུང་ནས་ཀྱང་ཁོང་གི་མཛད་རྗེས་ལས་བློ་སྐྱེད་ལེན་རྒྱུའི་རེ་བ་ཞུ་རྒྱུ་དང་།",
    "འོན་ཀྱང་རྒྱ་ནག་གཞུང་གིས་ཁོང་ཚོར་དྲག་གནོན་བྱེད་ཀྱི་ཡོད།",
    "རྒྱ་ནག་གཞུང་གིས་དྲག་གནོན་དེ་དག་མཚམས་འཇོག་བྱ་རྒྱུར་ངས་རེ་བ་བྱེད་བཞིན་ཡོད།",
    "དེ་རིང་འདིར་གཙོ་བོ་གཱན་དྷིའི་འཁྲུངས་སྐར་དུས་ཆེན་དང་འབྲེལ་མཛད་སྒོ་གྲ་སྒྲིག་གནང་བ་རེད།",
    "བདག་ཉིད་ཆེན་པོ་གཱན་དྷིས་མཚོན་སྐྱེས་བུ་དམ་པ་མང་པོ་ཞིག་འདས་ཟིན་པ་རེད།",
    "དེར་བརྟེན་གང་ཞིག་བྱེད་དགོས་ཀྱི་རེད་བརྗོད་ན།",
    "ཁོང་རྣམ་པས་ང་ཚོར་དམིགས་དཔེ་དང་ལམ་སྟོན་གནང་བ་དེ་དག་གིས་མི་སྒེར་ལ་ཕན་ཐོགས་གང་འདུག་ལམ་སྟོན་གནང་བ་དེའི་ཐོག་ཕྱིན་ན་གྱོང་ག་རེ་འདུག་དགེ་དང་སྐྱོན་གྱི་ཕན་གནོད་གང་ཡོད་པ་དེར་བསམ་བློ་བཏང་སྟེ།",
    "འོན་ཀྱང་ཁོང་གིས་ཉིན་རེའི་འཚོ་བ་རྒྱ་གར་གྱི་མི་མང་དཀྱུས་མ་བཞིན་བསྐྱལ་བ་དེས་ང་ཚོར་ལམ་སྟོན་ཞིག་ཆགས་ཀྱི་ཡོད།",
    "ང་ཚོ་གང་ཙམ་མིང་གྲགས་ཡོད་པ་དང་།",
    "ཀྲོག་ཀྲོག་བྱེད་རྒྱུ་ཡོང་གི་འདུག་དེ་ནི་རང་ཉིད་རང་གིས་ཞབས་འདྲེན་ཞུ་རྒྱུ་ལྟ་བུ་རེད།",
    "རང་ཉིད་ཀྱིས་དམའ་ས་བཟུང་སྟེ་འགྲོ་དགོས་རྒྱུ་གལ་ཆེན་པོ་རེད།",
    "བདག་ཉིད་ཆེན་པོ་གཱན་དྷི་ལ་མི་ས་ཡ་བྱེ་བ་མང་པོས་གུས་འདུད་དང་བསྟོད་བསྔགས་ཞུ་གི་ཡོད།",
    "ཁོང་གི་གཤིས་ཀ་དང་མི་ཚེ་སྐྱེལ་སྟངས་མི་མང་དཀྱུས་མ་ལྟར་བཞུགས་པ་དང་།",
    "མཐར་རྒྱ་གར་རང་བཙན་ཐོབ་པའི་སྐབས་སུ་ཆབ་སྲིད་ཀྱི་འགན་མ་བཞེས་པར་བཞུགས་པ་རེད།",
    "ཁོང་གིས་མཐའ་གཅིག་ཏུ་འཚེ་བ་མེད་པའི་ལམ་ལ་བརྟེན་ནས་འགྲོ་དགོས་རྒྱུ་བརྗོད་པ་དེ།",
    "དེང་སྐབས་འཛམ་གླིང་གི་དུས་ཚོད་འདིའི་སྟེང་ཧ་ཅང་དགོས་མཁོ་ཆེན་པོ་ཆགས་ཡོད།",
    "ཉམ་ཆུང་དྲགས་པ་ལྟ་བུ་ཏན་ཏན་མཐོང་སྲིད་ཀྱི་རེད།",
    "འོན་ཀྱང་ཁོང་གི་བཟའ་ཟླ་དང་ཕྲུ་གུ་མཇལ་རྒྱུའི་གོ་སྐབས་བྱུང་།",
    "སྐབས་ཤིག་ལ་ཁོང་གི་གོས་ཀྱང་གཱན་དྷིའི་གོས་བཞིན་གྱོན་དགོས་མིན་ནམ་གསུངས་ཀྱི་ཡོད།",
    "ཅེས་མར་ཊིན་ལུ་ཐར་ཀིང་གི་བཟའ་ཟླས་ངོས་ལ་གསུངས་བྱུང་།",
    "དེར་བརྟེན་ངོས་ཀྱི་བསམ་བློའི་ནང་གལ་ཏེ་མར་ཊིན་ལུ་ཐར་ཀིང་གིས་གཱན་དྷི་ལྟར།",
    "འཛམ་གླིང་ཕྱི་རོལ་ལ་དོ་སྣང་བྱེད་མཁན་མང་དུ་ཕྱིན་ཏེ་འདི་ལྟར་བྱུང་བ་རེད།",
    "དེར་བརྟེན་གཱན་དྷིའི་རྗེས་དྲན་བྱེད་སྟངས་ཡང་དག་པ་དེ་ང་རང་ཚོའི་ཉིན་རེའི་འཚོ་བའི་ནང་གཱན་དྷིའི་གནང་སྟངས་དེ་ལག་ལེན་བསྟར་ནས་ཕྱིན་ན།",
    "དངོས་གནས་སོ་སོ་སེམས་སྐྱིད་པ་ཡོང་གི་རེད།",
    "རེ་དོགས་ལུ་གུ་རྒྱུད་བཅིངས་པ་དེ་ཉུང་དུ་འགྲོ་གི་རེད།",
    "སེམས་ནང་དངངས་སྐྲག་དང་རེ་དོགས་མང་བ་ཡོང་གི་རེད།",
    "རེ་དོགས་ཇི་ཙམ་མང་བ་དེའི་ཚོད་ཀྱིས་སེམས་མ་སྐྱིད་པ་ཆེ་བ་ཡོད།",
    "ངོས་ཀྱི་གྲྭ་ཆས་ཕུད་ནས་གཱན་དྷིའི་གོས་གྱོན་ཤེས་ཀྱི་མ་རེད།",
    "གྱོན་པ་ཡིན་ནའང་འཁྱག་ངེས་རེད།",
    "གཱན་དྷིའི་ལྟ་སྤྱོད་དངོས་འབྲེལ་མིག་དཔེ་འོས་པ་ཞིག་རེད་འདུག་དེ་བཞིན་ལཱལ་བྷདུར་ཤ་སྟྲི་ངོས་ཀྱི་གྲོགས་པོ་ཡིན།",
    "རྨི་ལམ་ནང་ཐུག་པའི་གཱན་དྷི་དང་གཱན་དྷི་ངོ་མ་གཉིས་འདྲ་གི་མི་འདུག་དེར་བརྟེན་རྨི་ལམ་ནི་འཁྲུལ་པ་རེད་འདུག་དེ་བཞིན་ང་རང་ཚོས་སྔར་གྱི་སྟོན་པ་དང་སློབ་དཔོན་དེ་དག་རྗེས་དྲན་བྱེད་སྐབས།",
    "དེ་མིན་ཚིག་གི་བསྟོད་པ་ཁ་ཤས་བཏང་བ་ཙམ་གྱིས་རྗེས་དྲན་ཆགས་ཀྱི་མ་རེད།",
    "ཁྱེད་རང་གཉིས་ངོས་ཀྱི་ངོ་ཤེས་གྲོགས་པོ་བློས་ཐུབ་རེད།",
    "ང་ཚོར་བདེན་པའི་བདེན་རྒྱབ་ཤུགས་ཆེ་གནང་བར་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "དེ་ནས་ད་རེས་ལྷོ་ཨ་ཕི་རི་ཀར་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་མང་པོ་ཞིག་འཛོམས་ཏེ།",
    "ལྷོ་ཨ་ཕི་རི་ཀའི་གཞུང་གིས་དཀའ་ངལ་སྤྲད་དེ་ཕལ་ཆེར་ངོས་རང་འགྲོ་རྒྱུའི་གོ་སྐབས་མ་བྱུང་བ་རེད།",
    "དེར་བརྟེན་ཁོང་ཚོ་མང་པོ་ཞིག་གིས་བདེན་པའི་བདེན་རྒྱབ་ནུས་པ་ལྡན་པ་ཞིག་གནང་སོང་བར་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "དེ་བཞིན་ཕྲུ་གུ་ཚོས་ཧ་ཅང་ཡག་པོ་འཁྲབ་སོང་།",
    "སེམས་པ་དཀར་གཙང་ལྷད་མེད་ཐོག་ཕྱི་གསལ་ནང་གསལ་བྱེད་རྒྱུ་དེ་རྩ་ཆེན་པོ་རེད།",
    "ཉམས་མྱོང་མང་དུ་འགྲོ་སྐབས་ཕྱི་ནང་མི་མཚུངས་པ་བྱེད་རྒྱུ་ཤུགས་ཆེ་རུ་འགྲོ་གི་འདུག་དེ་ལྟར་བསམ་བློ་གཏོང་སྐབས་བྱིས་པ་རྣམས་སེམས་ནང་ཡོད་པ་དེ་དག་སྟོན་ཐུབ་མཁན་ཕྱི་གསལ་ནང་གསལ་རེད།",
    "ང་ཚོ་གང་ཙམ་ཡར་བསླེབས་སྐབས་རྫིག་པོ་བྱས་ཏེ་ཕྱི་ནང་མི་མཚུངས་པ་ཆགས་པར་བརྟེན།",
    "མིས་ཡིད་ཆེས་བརླགས་ཏེ་གྱོང་སོ་སོར་རག་གི་ཡོད།",
    "ཕྱི་གསལ་ནང་གསལ་ཆེ་འདྲིས་ཆུང་འདྲིས་བྱས་ན་རང་ལ་ཁེ་བཟང་རག་གི་རེད།",
    "འོན་ཀྱང་རིམ་པས་དོ་སྣང་བྱེད་དགོས་ཀྱི་འདུག་བརྗོད་དེ་འབོད་སྐུལ་ཞུས་པ་ལྟར་མང་པོ་ཞིག་གིས་དོ་སྣང་བྱེད་ཀྱི་ཡོད།",
    "ད་རེས་རིགས་ལམ་འདུ་འཛོམས་ལ་ཕྲུ་གུ་བརྒྱ་ལྷག་བསླེབས་ཡོད་སྐོར་བརྗོད་བྱུང་།",
    "ངོས་ཀྱིས་ཁོང་ཚོ་ཐུག་གི་ཡིན།",
    "དེར་བརྟེན་རིགས་ལམ་ནི་ལག་ཆ་ལྟ་བུ་རེད།",
    "ཕོ་མོ་དབྱེར་མེད་ཀྱིས་གཞུང་ཆེན་བལྟ་རྒྱུ་དང་རིགས་ལམ་ཡག་པོ་སྦྱོངས་དང་།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་རྡ་སྟེང་བོད་ཁྱིམ་གྱི་ཚོགས་ཁང་ནང་རིགས་ལམ་འདུ་འཛོམས་ཐོག་བཅར་བའི་སློབ་ཕྲུག་ཚོར་བཀའ་སློབ་སྩལ་བ། །",
    "ཕྱི་ལོ་༢༡༤ཟླ་༡ཚེས་༢ཉིན་གྱི་ཕྱེད་ཡོལ་ཆུ་ཚོད་༢ཐོག་སྤྱི་ནོར་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་རྡ་སྟེང་བོད་ཁྱིམ་གྱི་ཚོགས་ཁང་ནང་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་ལྕམ་སྐུ་ཇོ་ཌི་ཝིལེ་ཡེམ་སི་མཆོག་དང་།",
    "དེ་བཞིན་བོད་ཁྱིམ་གྱི་དགེ་སློབ་སོགས་ཁྱོན་མི་གྲངས་༢བརྒལ་བར་ལམ་སྟོན་བཀའ་སློབ་སྩལ་དོན།",
    "སྤྱིར་བཏང་རྒྱུ་སྟོབས་ཡོད་མཁན་ཁོང་རང་ཚོ་འཛམ་གླིང་གཅིག་ལྟ་བུ་བྱས་ཏེ།",
    "ལྷག་པར་བོད་དོན་ཐོག་དམིགས་བསལ་དོ་སྣང་གིས་རྒྱབ་སྐྱོར་གནང་གི་ཡོད།",
    "ང་ཚོའི་མ་འོངས་པའི་རེ་བ་བརྒྱབ་ས་བོད་རིགས་སློབ་ཕྲུག་ཁྱེད་རང་ཚོ་ཆགས་ཡོད་པར་བརྟེན།",
    "ངོས་རང་ཚན་རིག་པ་དང་མཉམ་དུ་འདས་པའི་ལོ་སུམ་ཅུ་ལྷག་གི་རིང་བགྲོ་གླེང་བྱས་པ་ཡིན།",
    "སྦྱང་བརྩོན་བྱེད་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་རེད།",
    "ང་ཚོའི་མི་རིགས་ཧ་ཅང་བརྟན་པོ་ཆགས་ཀྱི་རེད།",
    "ང་ཚོའི་མི་རིགས་དུས་ད་ལྟ་བར་དུ་ཧ་ཅང་གྱོང་པོ་བྱས་ཏེ་བསྡད་ཡོད།",
    "མ་འོངས་པར་ཡིན་རུང་ང་ཚོ་བོད་མི་རིགས་ཕྱི་རྫིག་ནང་རྫིག་དང་གྱོང་པོ་ཞིག་ཆགས་རྒྱུར་ཏན་ཏན་ཕན་ཐོགས་ཡོད།",
    "དེ་རིང་འདི་གར་ཐེ་ཝན་གྱི་བོད་བརྒྱུད་ནང་བསྟན་རིས་སུ་མ་ཆད་པ་ཐུན་མོང་ཐོག་ནས་གྲ་སྒྲིག་གནང་བ་རེད།",
    "ཁྱེད་རང་ཚོར་འཚམས་འདྲིའི་བཀྲ་ཤིས་བདེ་ལེགས་ཡོད།",
    "གཞུང་ཆེན་བཅུ་གསུམ་དང་མངོན་རྟོགས་རྒྱན་སོགས་ཐུན་མོང་གི་གཞུང་རེད།",
    "ང་ཚོ་ཚང་མ་མགོན་པོ་ཀླུ་སྒྲུབ་ཀྱི་རྗེས་འབྲང་ཡིན་བསམ་པའི་ཐོག་ནས་གཅིག་གྱུར་ཆགས་ཀྱི་ཡོད།",
    "གང་ལྟར་ང་ཚོས་རྩ་བའི་སྟེང་ཕྱིན་ན་ཚང་མ་གཅིག་གྱུར་རེད།",
    "དེར་བརྟེན་ང་ཚོས་རྩ་བའི་ཐོག་འགྲོ་དགོས་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་རེད།",
    "ཁྱེད་རང་ཚོ་མགོན་པོ་ཀླུ་སྒྲུབ་ཀྱི་དགེ་ཕྲུག་རྒན་པ་ཡིན་བསམས་པ་བྱོས།",
    "དེ་བཞིན་གཞན་ཕན་དོན་གཉེར་གྱི་བློས་རང་ཉིད་གཅེས་འཛིན་གྱི་བློ་ཤུགས་ཆུང་དུ་གཏོང་གི་ཡོད།",
    "རང་གཅེས་འཛིན་གྱི་བློ་ཤུགས་ཆེ་དྲགས་ན་མི་ཚེའི་ནང་སྐྱིད་པ་གང་ཡང་ཡོང་གི་མ་རེད།",
    "ཇི་ཙམ་གྱིས་གཞན་གཅེས་འཛིན་གྱི་བློ་ཡོད་པ་དེའི་ཚོད་ཀྱིས་རང་གཅེས་འཛིན་གྱི་བློ་རང་བཞིན་གྱིས་ཤུགས་ཆུང་དུ་འགྲོ་གི་རེད།",
    "ང་ཚོ་དུས་ད་ལྟ་བར་དུ་རང་གཅེས་འཛིན་བྱས་ནས་བསྡད་པ་རེད་ཀྱང་འབྲས་བུ་དང་ཕན་ཐོགས།",
    "གཏན་དུ་སྐྱིད་པའི་སྐྱིད་འགོ་ཚུགས་ཀྱི་རེད།",
    "འོན་ཀྱང་དེ་ཙམ་གྱིས་ཉོན་མོངས་སེལ་རྒྱུ་ཤིན་ཏུ་ནས་དཀའ་ལས་ཁག་པོ་རེད།",
    "དེར་བརྟེན་ཤེས་རབ་ཀྱི་སྣང་བ་ཁོ་ནས་ཉོན་མོངས་སེལ་བ་མ་གཏོགས་དེ་ལས་ལྷག་པ་ཞིག་ཕལ་ཆེར་མེད།",
    "ང་ཚོ་མིར་ཐུན་མོང་མ་ཡིན་པའི་རྣམ་དཔྱོད་ཡོད།",
    "དེ་དག་གིས་བརྩེ་བའི་བསམ་པར་ཡོན་ཏན་དང་དགེ་མཚན་མཐོང་སྟེ།",
    "བརྟག་དཔྱད་ཞིབ་འཇུག་བྱས་པ་བརྒྱུད་ནས་ངེས་ཤེས་རྙེད་པ་དགོས་རྒྱུ་གལ་ཆེན་པོ་རེད།",
    "ང་ཚོ་འདི་གར་འདུས་པའི་མི་ཚང་མ་འཛམ་གླིང་འདིའི་ནང་ཡོད་པའི་མི་དུང་ཕྱུར་བདུན་ཅུའི་ཆ་ཤས་ཤིག་ཆགས་ཡོད།",
    "འཛམ་གླིང་འདིར་གཞན་ཕན་གྱི་བསམ་བློ་ཕྲན་བུ་ཞིག་ལས་གཏོང་མི་ཐུབ་ཀྱང་ཕན་ཐོགས་ཡོང་གི་རེད།",
    "ང་ཚོ་འགྲོ་བ་མི་གཅིག་གྱུར་ཡིན་བསམ་པའི་ཐོག་ནས་ཐུག་འཕྲད་བྱས་ཏེ།",
    "མིའི་རྣམ་དཔྱོད་བེད་སྤྱོད་ཆ་ཚང་བ་བྱས་ནས་ཉོན་མོངས་ཀྱི་གཉེན་པོ་བསྟེན་ཏེ།",
    "ཡོང་ཐབས་མེད་པས་མི་ལུས་འཐོབ་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་རེད།",
    "གང་གིས་ཤེས་དེ་མཁས་པ་ཡིན།",
    "ང་ཚོའི་དམིགས་ཡུལ་ཐམས་ཅད་མཁྱེན་པའི་གོ་འཕང་ཐོབ་ཆེད་རེད།",
    "མངོན་མཐོ་བརྒྱུད་ནས་ངེས་ལེགས་སྒྲུབ་དགོས་པ་རེད།",
    "ཅེས་མངོན་མཐོའི་ལུས་རྟེན་གྱི་ཐོག་ནས་ངེས་ལེགས་སྒྲུབ་པའི་ཐབས་གང་ཟག་གི་བདག་འཛིན་གྱི་གཉེན་པོ་བདག་མེད་རྟོགས་པའི་ཤེས་རབ་སྐྱེས་པ་དང་།",
    "ཅེས་པ་འདི་གསུངས་པ་རེད།",
    "ཞེས་པ་འདི་རེད།",
    "དེ་ལྟ་བུའི་ཚུལ་ལུགས་ཤེས་པ་ཡིན་ན་མཁས་པ་རེད།",
    "ཇོ་བོ་རྗེ་བོད་ལ་ཕེབས་ནས་ལམ་སྒྲོན་མཛད་པ་རེད།",
    "མགོན་པོ་གང་ཉིད་མཆོག་གིས་བཀའ་ལན་སྩལ་དོན།",
    "ཐེངས་གཉིས་བསླེབས་པ་རེད།",
    "ཆུ་ལོག་བྱུང་སྟེ་ཁྱུག་ཙམ་བསླེབ་ཐུབ་པ་བྱུང་བ་མ་གཏོགས་གཞན་བསླེབ་རྒྱུའི་གོ་སྐབས་ཐེ་ཝན་གཞུང་གིས་ཆོག་མཆན་སྤྲོད་ཀྱི་མེད་པར་བརྟེན་ངོས་ལ་བྱེད་རྒྱུ་གང་ཡང་མེད།",
    "ཁྱེད་རང་ཚོ་ཐེ་ཝན་གྱི་སྤྱི་འབངས་རེད།",
    "དེར་བརྟེན་ཁྱེད་རང་ཚོའི་མངོན་འདོད་འདི་ཐོག་མར་གཞུང་ནས་ཤེས་པ་བྱས་ན་ཡག་པོ་ཡོད།",
    "གལ་ཏེ་ཐེ་ཝན་གཞུང་གིས་མཐོང་མཆན་གནང་ཚེ།",
    "ཕལ་ཆེར་ལོ་བརྒྱད་གོང་ཀོ་སི་ཊ་རི་ཁའི་རྒྱལ་ཁབ་ནང་ནོ་བེལ་ཞི་བདེའི་ལྷན་ཚོགས་འཚོགས་རྒྱུ་བྱས་པ་རེད།",
    "ང་ཚོས་ཀྱང་ལྷན་ཚོགས་ལ་བཅར་མེད།",
    "ང་ཚོས་དེ་ལྟར་བྱེད་དགོས་དོན་ནི།",
    "ང་ཚོ་ཁོང་རྣམ་པའི་རྒྱབ་ཏུ་ཡོད།",
    "དེ་བཞིན་འདྲ་མཉམ་ཆེད་འཐབ་རྩོད་མཛད་དང་མཛད་མུས་ལ་འཛམ་གླིང་གིས་རྒྱབ་སྐྱོར་ཞུ་བཞིན་ཡོད།",
    "འོན་ཀྱང་སྟབས་མ་ལེགས་པ་ཞིག་ལ་ལྷོ་ཨ་ཕི་རི་ཀའི་ནང་དུའང་གནས་ཚུལ་དེ་མཚུངས་ཤིག་བྱུང་ཡོད།",
    "འོན་ཀྱང་ཁོང་གིས་ང་ཚོ་བཞིན་བསྒྲགས་གཏམ་སྤེལ་ཏེ།",
    "ལྷོ་ཨ་ཕི་རི་ཀའི་བྱ་སྤྱོད་ལ་སྐྱོན་བརྗོད་གང་ཡང་མ་གནང་བར་ང་རང་ཧ་ཅང་ཡ་མཚན་སྐྱེས་བྱུང་།",
    "རྒྱ་ནག་མི་འབོར་ཧ་ཅང་མང་པོ་ཡོད་པ་ཁྱེད་ཚོས་མཁྱེན་གསལ་རེད།",
    "ར་བྷི་ཡ་ཁ་ཌིར་མཆོག་གིས་རྒྱ་ནག་གཞུང་ལ་མུ་མཐུད་ནས་སྐྱོན་བརྗོད་བྱས་པར་བརྟེན།",
    "ཁོང་གི་ཕྲུ་གུ་རྣམས་རྒྱ་ནག་གཞུང་གིས་བཙོན་དུ་བཅུག་ཡོད།",
    "ང་ཚོར་མགྲོན་འབོད་མཛད་སྐབས་ང་ཚོས་མོས་མཐུན་མ་བྱས་པར་སྡོད་ཐབས་བྲལ།",
    "དེར་བརྟེན་ང་ཚོས་གོ་སྒྲིག་ཚོགས་ཆུང་ལ་ཚོར་ཤུགས་ཆེན་པོས་ལམ་སེང་ཡི་གེ་ཞིག་བཏང་སྟེ།",
    "ལྷན་ཚོགས་ཚུགས་ཡུལ་ཐད་ང་ཚོར་ཧ་ཅང་སེམས་འཚབ་ཡོད་སྐོར་ཞུ་རྒྱུ་བྱུང་བ་མ་ཟད།",
    "ཐོག་མར་ང་ཚོ་ཚང་མ་ལྷན་ཚོགས་སུ་བཅར་རྒྱུའི་བསམ་བློ་བཏང་བ་ཡིན།",
    "ཡི་གེའི་ནང་ང་ཚོས་ཧ་ཅང་གསལ་པོ་བཀོད་ཡོད།",
    "འོན་ཀྱང་རྒྱ་ནག་གཞུང་གིས་ཁ་བྲལ་བ་རེད།",
    "དེར་བརྟེན་ང་ཚོས་ལྷན་ཚོགས་ནང་འཛུལ་ཞུགས་མ་བྱེད་རྒྱུའི་ཐག་གཅོད་བྱས་པ་ཡིན།",
    "ང་ཚོས་ལྷན་ཚོགས་དེར་མཉམ་ཞུགས་མ་བྱེད་རྒྱུའི་ཐག་གཅོད་བྱས་པར་གྲུབ་འབྲས་ཐོན་ཡོད།",
    "ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་མང་པོ་ཞིག་གིས་ལྷན་ཚོགས་ནང་མཉམ་ཞུགས་མ་གནང་རྒྱུའི་ཐག་གཅོད་གནང་བར་བརྟེན།",
    "ད་ཆ་ང་ཚོ་སོ་སོའི་རྐང་པའི་ཐོག་ལ་ལངས་ཐུབ་པ་ཆགས་ཡོད།",
    "བརྒྱ་ཆར་བགོས་ན་བོད་པའི་མི་འབོར་བརྒྱ་ཆ་ཕྱེད་ཀ་རེད།",
    "རྒྱ་མིའི་མི་འབོར་བརྒྱ་ཆ་དགུ་བཅུ་གོ་དགུ་དང་ཕྱེད་ཀ་རེད།",
    "གྲངས་ཀའི་ཐོག་ནས་རྩིས་ན་བོད་པ་རེར་རྒྱ་མི་བརྒྱ་དང་དགུ་བཅུ་གོ་དགུ་ཆགས་ཀྱི་ཡོད།",
    "དེར་བརྟེན་བོད་པ་གཅིག་གིས་རྒྱ་མི་༡༩༩གདོང་ལེན་བྱེད་དགོས་ཀྱི་ཡོད།",
    "བོད་ནང་གི་བོད་མི་ཚོའི་མངོན་འདོད་དང་རེ་བ་བསྒྲུབ་རྒྱུའི་འགན་གཙོ་བོ་ང་ཚོ་བཙན་བྱོལ་དུ་ཡོད་པའི་བོད་མི་ཚོར་ཡོད།",
    "འོན་ཀྱང་དཀའ་ངལ་འཕྲད་སྐབས་སེམས་ཤུགས་མ་ཆག་པར་ངས་བྱེད་ཐུབ་ཀྱི་རེད་བསམ་པའི་ཐོག་ནས་མདུན་སྐྱོད་བྱེད་རྒྱུ་གལ་ཆེན་པོ་རེད།",
    "འོན་ཀྱང་ཡ་རབས་སྤྱོད་བཟང་བརྗོད་སྐབས་མཉམ་ཆུང་མགོ་སྒུར་ཏེ་ཐུབ་ཚོད་འཁྱེར་ནས་སྡོད་དགོས་པ་དེ་འདྲ་མ་རེད།",
    "ག་པར་ཕྱིན་ཀྱང་མི་མང་ཚོའི་སེམས་ཤུགས་ཧ་ལས་པའི་ཆེན་པོ་འདུག་བོད་ནང་ལ་ཡིན་ནའང་སེམས་ཤུགས་དང་འགན་ཁུར་སྔར་ལས་ལྷག་པ་གནང་གི་ཡོད་པ་རེད།",
    "ཉེ་ཆར་སྤྱི་ནོར་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ཕྱི་རྒྱལ་ཁག་ལ་ཆིབས་སྒྱུར་བསྐྱངས་སྐབས་དོལ་རྒྱལ་རྗེས་འབྲང་པ་ཉུས་ཤས་ཤིག་གིས་ངོ་རྒོལ་བྱེད་ཀྱི་ཡོད།",
    "གཙོ་ཆེ་ཤོས་ཨིན་ལེན་ཌི་ནས་ཡིན་པའི་ཕྱི་རྒྱལ་མི་རིགས་ཁག་རེད།",
    "དེ་ལྟར་རྩ་བ་ཉིད་ནས་མ་རེད།",
    "གཞིས་ཆགས་ཁག་ནང་ལའང་དེ་ལྟར་རེད།",
    "འོན་ཀྱང་ཉེ་ཆར་རྒྱ་ནག་གཞུང་གི་ངན་བྱུས་འོག་ནས་མི་ཉུང་ཤས་ཤིག་གིས་གོང་ས་མཆོག་ལ་མཚན་སྨད་དང་བོད་མིའི་སྒྲིག་འཛུགས་ལ་མིང་ཤས་བཟོ་རྒྱུའི་འབད་བརྩོན་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "ང་ཚོའི་ངོས་ནས་སྦས་གསང་བྱེད་དགོས་དོན་གཅིག་ཀྱང་མེད།",
    "དེ་ཚོ་མང་ཚོགས་ཀྱི་ཤེས་དགོས་པ་རེད།",
    "དེར་བརྟེན་སློབ་ཕྲུག་ཚོའི་ངོས་ནས་སློབ་སྦྱོང་ཧུར་ཐག་གནང་དགོས་པ་གལ་ཆེན་པོ་རེད།",
    "མང་ཚོགས་ཀྱི་དྲི་བ་ཁག་ལ་ལན་འདེབས་གནང་ཡོད།",
    "རེག་ཊར།",
    "ང་ཚོའི་གྲས་ནི་མི་རབས་རྒན་པ་དང་གཞོན་པ་དབར་གྱི་ཟམ་པ་ལྟ་བུ་ཆགས་ཡོད།",
    "དེ་སྔ་བཙན་བྱོལ་དུ་འབྱོར་མཚམས་ཀྱི་གནས་སྟངས་དང་དེང་སྐབས་འདྲ་གི་མ་རེད།",
    "སློབ་སྦྱོང་དང་མཉམ་དུ་ཀུན་སྤྱོད་ཀྱང་ཡག་པོ་དགོས་རྒྱུ་གལ་ཆེན་པོ་རེད།",
    "སློབ་སྦྱོང་གི་གོ་སྐབས་མ་རག་མཁན་བྱིས་པ་མང་པོ་ཡོད།",
    "ཁག་གཅིག་རང་གི་ཕ་མ་སྤུན་མཆེད་དང་སླར་ཡང་ཐུག་རྒྱུའི་གོ་སྐབས་རག་མིན་ངེས་གཏན་གང་ཡང་མེད།",
    "གང་ལྟར་སློབ་སྦྱོང་གི་གོ་སྐབས་ཤིག་ཐོབ་ཆེད་བཙན་བྱོལ་དུ་ཡོང་གི་ཡོད།",
    "འོན་ཀྱང་ང་ཚོ་འདིར་གོ་སྐབས་ཡོད་བཞིན་དུ་དམ་འཛིན་མ་བྱས་པར་ལྷོད་གཡེང་བཏང་ནས་བསྡད་ན་འགྲིག་ཐབས་མེད།",
    "མ་འོངས་པར་བོད་སྤྱི་པའི་འགན་དེ་ད་ལྟའི་ཕྲུ་གུ་ཁྱེད་རང་ཚོས་འཁྱེར་དགོས་པ་ཆགས་ཀྱི་རེད།",
    "བོད་མིའི་སྒྲིག་འཛུགས་ཀྱི་འགན་མི་སྒེར་འགའ་ཞིག་ལ་ཡོད་པ་དེ་འདྲ་རྩ་བ་ནས་མ་རེད།",
    "སྒྲིག་འཛུགས་འདི་ང་ཚོ་ཚང་མའི་ཡིན་པར་བརྟེན་ཚང་མར་འགན་དང་ལས་འགན་ཡོད།",
    "སྤྱི་འཐུས་ཚོགས་གཙོ་མཆོག་གིས་ལྔ་བཅུའི་དུས་དྲན་གྱི་དར་ཆ་མར་ཕབ་སྟེ་དུས་དྲན་མཇུག་སྒྲིལ་གནང་ཡོད།",
    "ད་ལྟའི་བོད་ནང་གི་ཛ་དྲག་གནས་སྟངས་སོགས་ངོ་སྤྲོད་གནང་བ་མ་ཟད།",
    "ཁྲེན་བོ་ཁུང་གིས་བརྩམས།",
    "ཕྱི་ལོ་༢༡༤ཟླ་བ་དགུ་པར་བཙན་བྱོལ་བོད་གཞུང་གི་བསྟི་གནས་རྒྱ་གར་བྱང་ཕྱོགས་རྡ་རམ་ས་ལར།",
    "གནས་ཚུལ་དེ་སྤེལ་མ་ཐག་རྒྱ་ནག་པེ་ཅིན་གཞུང་གིས་ཚུར་སྣང་ལན་ཆ་དྲག་པོ་བྱུང་སྟེ།",
    "དེ་ནི་བོད་བརྒྱུད་ནང་བསྟན་གྱི་རྒྱུན་གཏན་གྱི་སྒྲིག་སྲོལ་ལ་གཏོར་བཤིག་བཏང་བ་རེད་ཟེར་ལན་སློག་པ་དང་།",
    "མུ་མཐུད་རྒྱ་ནག་མི་མང་ལ་མགོ་སྐོར་གཏོང་ཆེད་འགྲེལ་བརྗོད་ལོག་པ་རྒྱག་བཞིན་ཡོད་པ་རེད།",
    "ཁོང་ག་རེ་བྱས་ཏེ་ནང་པའི་གནས་མཆོག་རི་བོ་རྩེ་ལྔར་གནས་གཟིགས་ཕེབས་རྒྱུར་བསུ་བ་མ་ཞུ་པ་གང་ཡིན་ནམ།",
    "ག་རེའི་དོན་དུ་ཁོང་ལོ་མང་རིང་རྒྱལ་སྒོའི་ཕྱིར་བཀག་དགོས་སམ།",
    "ཁོང་ཚོའི་བསམ་པའི་གཙོ་འཛིན་གཏན་འཁེལ་བྱེད་པ་ནི།",
    "མན་འཇུའི་རྒྱལ་རབས་ཀྱིས་དེ་སྔ་གསེར་འབུམ་དཀྲུག་འདོན་ཞེས་པ་འདོན་མྱོང་ཡོད་ཀྱང་དེ་ནི་གྲོས་འགོ་བཏོན་པ་ཙམ་ཞིག་རེད།",
    "བོད་བརྒྱུད་ནང་བསྟན་ལ་དད་པ་ཞུ་མཁན་རྒྱ་ཆེའི་མང་ཚོགས་ཀྱིས་ཐག་གཅོད་བྱ་དགོས།",
    "གལ་ཏེ་མང་ཚོགས་ནས་སྐུའི་ཡང་སྲིད་དགོས་ཀྱི་མེད་ན།",
    "གལ་སྲིད་མང་ཚོགས་ནས་མུ་མཐུད་དེ་ཡང་སྲིད་ལམ་ལུགས་དེ་དགོས་ཀྱི་ཡོད་ན།",
    "ད་མུས་བཞིན་མཇུག་བསྐྱང་རྒྱུ་རེད་ཅེས་བཀའ་ཕེབས་ཡོད།",
    "སྔ་ས་ལོ་རབས་དྲུག་ཅུའི་ནང་ཁོང་གིས་གོང་མཚུངས་བཀའ་ཞིག་ཕེབས་མྱོང་ཡོད།",
    "ཁོང་གི་བཞེངས་ཕྱོགས་ཁ་གསལ་བཀའ་ཕེབས་ཡོད།",
    "ཐག་གཅོད་གནང་གི་ཡིན་ཞེས་བཀའ་ཕེབས་པ་དེ་ནས་ད་ཆ་ཁོང་དགུང་གྲངས་༧༦ལ་ཕེབས་ཡོད་དུས་སྔོན་ཚུད་ནས་འཇོག་པའི་དུས་ཚོད་ལོ་༧ལྷག་ཡོད།",
    "རྒྱ་ནག་གཞུང་གིས་ང་རྒྱལ་ཁེངས་དྲེགས་སྤང་ཏེ།",
    "དེ་ཡང་བཟང་ཕྱོགས་ཐོག་ནས་བོད་རྒྱ་གཉིས་ཐུན་མོང་གི་ལྟ་ཚུལ་དང་འབད་བརྩོན་བྱས་ཏེ་བྱུང་བ་ཡིན་ན།",
    "ཕུགས་རིང་གི་བོད་རྒྱ་མི་རིགས་གཉིས་ཀྱི་འབྲེལ་བ་བརྟན་ལྷིང་ཡོང་རྒྱུར་ཕན་ནུས་ཐོན་པའི་ཐོག་ད་ཡོད་རྒྱ་ནག་གི་གཅིག་སྒྲིལ་གྱི་རྣམ་པ་བོད་ཚུད་པའི་",
    "གོང་གི་ལྟ་ཚུལ་འདིར་ངོས་འཛིན་བྱེད་ཐུབ་པ་རེད།",
    "ཆ་རྐྱེན་བཅས་ཕྱི་ལོ་༢༨ཟླ་༡༡ཚེས་༥འཁོད་༧དཔལ་ལྡན་བཀའ་ཤག་གི་ལམ་སྟོན་ལ་རྩ་འཛིན་སོར་གནས་ཡིན་པ་མ་ཟད།",
    "ཀུན་བཟང་འཁོར་ལོའི་རེའུ་མིག་ཚངས་སྲས་དགྱེས་པའི་རོལ་མོ་ཞེས་བྱ་བ་བཞུགས་སོ། །",
    "གཞི་བརྟེན་མངོན་གྱུར་རྒྱུན་གྱིས་རྟག་གང་གཉིས་མེད་གཟིགས་པ་སྤྲོས་ཞི་ཡང་།",
    "བ་སྤུའི་ཁུང་བུ་རེ་རེར་སྐད་ཅིག་གིས།",
    "མིང་ཚིག་གཟིངས་ཀྱིས་རིག་པའི་རྫིང་རིང་གི།",
    "རི་མོ་ཟུར་དུ་ཡོད། ༢༧༣༢༧༤༢༧༥༢༧༦༢༧༧༢༧༨༢༧༩༢༨༢༨༡",
    "རྟག་ཏུ་ཞི་བའི་རལ་ཀླུང་ཉིད་དུ་འཁྱིལ་ཡང་ལྷག་བསམ་སོར་མོས་ལེགས་དྲངས་ཤིང་།",
    "བརྟན་པར་གྱུར་ཅིག་གཉིས་མེད་གཟིགས་པའི་རྒྱལ།",
    "བློ་གཏེར་རབ་དགའ་ཚངས་བྱུང་སྙེམས་པའི་ལང་ཚོའི་ཟླ་སྣང་ཞེས་ཀྱང་བགྱི་བས།",
    "ཚོན་གྱི་ལས་འདི་བདག་གིས་བརྩམ།",
    "ལོག་པའི་རི་མོ་བྱུང་བ་ན།",
    "འཁོར་ལོའི་ཕྱི་ནང་གི་མུ་ཁྱུད་ནག།",
    "གཞན་དམ་ཅན་ཀུན་ལ་རང་རང་གི་གདན་བྲིའོ།",
    "རང་སྔགས་ཀྱིས་རང་རང་གི་ལྷར་བསྐྱེད།",
    "རྣམ་རྒྱལ་རྡོ་རྗེ་སྒེག་མོར།",
    "གཤིན་རྗེ་དུར་ཁྲོད་ལྷ་མོ་༴",
    "གཟིག་དང་ཁྭ་ཏའི",
    "རྟ་མགྲིན་རྡོ་རྗེ་གཏུམ་མོར་༴",
    "འགུགས་བྱེད་ཆེན་མོ་པུ་ཤུད་མགོ།",
    "འཆིང་བྱེད་ཆེན་མོ་བྱ་རོག་མགོ།",
    "སྡོམ་བྱེད་ཆེན་མོ་སྲིན་བྱའི་མགོ།",
    "མཉེས་བྱེད་ཆེན་མོ་ཁྲ་ཡི་མགོ།",
    "དཀྱིལ་འཁོར་གྱི་ནང་གི་གྲྭ་བཞིར།",
    "ཞིང་ལྤགས་ཀྱི་བླ་རེ་བྲེ།",
    "རང་གི་ཐུགས་ཀ་ནས་འོད་འཕྲོས།",
    "དྲི་ཟ་དག་གི་བདག་པོའི་རྒྱལ།",
    "ན་མོ་མཆོད་སྦྱིན་གྱི་གཏོར་མ་རྒྱ་ཆེན་པོ་འདི་རྒྱལ་པོ་ཆེན་པོ་གནས་སྲུང་པོ་འཁོར་དང་བཅས་པ་ལ་འབུལ་ལོ།",
    "བདག་ཅག་གི་དཀྱིལ་འཁོར་ཆེན་པོའི་བྱ་བ་མཐར་མ་ཕྱིན་གྱི་བར་དུ་བརྟན་པར་བཞུགས་ནས།",
    "གྲུལ་བུམ་དག་གི་བདག་པོའི་རྒྱལ།",
    "བྱང་གི་ཕྱོགས་རྣམས་སྐྱོང་བྱེད་པ།",
    "རོལ་མོའི་སྒྲ་དང་བཅས་པས།",
    "ཕྱོགས་སྐྱོང་གི་གཏོར་མ་སྟེ་བསྡུས་པ་བྱ། ལྔ་པ་ནི།",
    "གཙོ་བོ་དང་ཐ་མི་དད་དུ་མོས་ལ།",
    "བུ་ཁྱོད་ཚུར་ཤོག་ཅི་ལ་དགའ།",
    "འདོད་དོན་གང་ཡིན་ཁྱོད་ཀྱིས་སྨྲོས།",
    "བློ་ཆེན་ཁྱོད་ཀྱིས་བཟུང་བར་གྱིས།",
    "ཉིན་རེ་ཞིང་ནི་དུས་དྲུག་ཏུ།",
    "ནང་དུ་ཁྱོད་ཀྱིས་ཞུགས་པ་ཡིན།",
    "བཅོམ་ལྡན་རྡོ་རྗེ་གཞོན་ནུ་ཟསཡི་ ཡེ་ཤེས་ཁྱོད་ལ་བསྐྱེད་པར་བྱ།",
    "རྣལ་འབྱོར་བུ་མཆོག་ཁྱོད་ཀྱིས་ཀྱང་།",
    "ཁྱོད་ཀྱིས་དཀྱིལ་འཁོར་མ་མཐོང་བའི།",
    "ཨོཾ་བཛྲ་པཉྩ་ཨ་མྲྀ་ཏ་ཧ་ན་ཧ་ན་ཨུ་ད་ཀ་ཧཱུྃ་ཕཊ།",
    "ཁྱོད་ཀྱི་སྡུག་བསྔལ་མ་བྲལ་བར།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་གི་འོད་ལས་གནོད་སྦྱིན་མ་ལྕགས་ཀྱུ་ཐོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས།",
    "རོལ་མོའི་སྒྲ་དྲག་ཏུ་བསྒྲག།",
    "རང་གི་རིགས་ཀྱི་ལྷ་ལ་ཕུལ་བར་མོས་ཤིག།",
    "ཁྱོད་ཀྱི་ལྷ་ནི་འདིའོ་ཞེས་བསྟན་ཏོ། ། གསུམ་པ་ནི།",
    "མིག་གི་ལིང་ཏོག་བསལ་བ་ལྟར།",
    "ཁྱོད་ཀྱི་མི་ཤེས་དྲི་མ་བསལ།",
    "ཁྱོད་ཀྱི་མི་ཤེས་པའི་རབ་རིབ་དག་པས།",
    "ཁྱོད་ནི་ཐུགས་ཀྱི་རིགས་སུ་སྐྱེས།",
    "ཁྱོད་ཀྱིས་མཐོང་ཞིང་ཞུགས་པའི་དཀྱིལ་འཁོར་འདི་ནི།",
    "ཉོན་མོངས་ཆེ་ཆུང་རྣམ་དག་པའོ།",
    "འདོད་པའི་ལྷ་མོས་བརྒྱན་པ་ནི།",
    "ཞིང་གི་བླ་རེ་བྲེས་པ་ནི།",
    "དཔག་བསམ་ཤིང་གིས་བརྒྱན་པ་ནི།"
  ]
