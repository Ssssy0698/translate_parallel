    "ཚངས་པར་སྤྱོད་པ་ནི་ཤེས་རབ་ཀྱི་ཕུང་པོ་དང་ལྡན་པར་སྤྱོད་པའོ།",
    "འདི་རྣམས་ལན་བདུན་འཐབ་པ་ལས་ལན་བདུན་བསྡུམས་ན་ཉེས་བྱས་གསུམ་དང་སྦོམ་པོ་བཞི་དང་།",
    "མི་ཚངས་པར་སྤྱོད་དུ་བཅུག་པར་གྱུར་པས་ཕས་ཐུཕམ་པའི་སྦོམ་པོ་གཉིས་སུ་འགྱུར།",
    "གཞི་ལྟ་བའི་ཕྱིར་དགེ་སློང་ཁྲིད་ཅིག་པ་ནི་གཞི་རུང་བ་དང་མི་རྩོད་པ་དང་ཡངས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "ཡངས་པར་ཆུད་པ་ནི་ཁང་པའི་རྩིག་དྲུང་ནས་འདོམ་གང་ཚུན་ཆད་ན་ཆུ་དང་གད་པ་ལ་སོགས་པ་མེད་པའོ།",
    "དེ་ཕན་རྔཆད་ན་ནི་ཡི་གེའི་གཉེར་ནི་འཕྲུལ་དུ་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "དགེ་སློང་གཞན་ལ་ལེགས་པར་བསྒོ་སྟེ།",
    "ཚད་ལས་མ་འདས་ན་ཐུམིག་གྲངས་མང་དུ་བྱས་ཀྱང་ཉེས་མེད་དོ།",
    "བདག་གཏོགས་པར་གང་ཟག་གཉིས་གསུམ་ཙམ་གྱི་ཕྱིར་དགེ་སློང་ཁང་པ་བརྩིགས་ན་བཀག་པ་ལྡུགཅིག་པུའི་ཕྱིར་མ་ཡིན་པས་སྤོམ་པོར་འགྱུར་རོ།",
    "ཡང་དགེ་སློང་གང་ཞེ་སྡང་ཅན་ཞིག་ཁྲོས་ནས་གནོད་པར་བྱེད་དེ།",
    "དགེ་སྐོས་ནི་དགེ་སློང་གྱད་བུ་ནོར་ཞེས་པ་ཡིན་ནོ་ཞེས་བྱས་པ་དང་།",
    "དགེ་སློང་གྱད་བུ་ནོར་གྱིས་མི་རིགས་པར་བྱས་ཏེ།",
    "ང་དང་མི་ཚངས་པར་སྤྱོད་དོ་ཞེས་རྒོལ་དུ་བཅུག་ནས།",
    "དགེ་སློང་དེ་གཉིས་ཀྱིས་ཀྱང་ཆེ་བཞི་བྱས་ཏེ་བསྒྱུར་བ་ལས་བཅས།",
    "སྐུར་པ་ནི་མི་ཚངས་པར་སྤྱོད་ཅེས་བསྒྲགས་པའོ།",
    "དེ་མན་ཆད་ནི་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "ཡན་ལག་ནི་ཚངས་པར་སྤྱོད་པ་དང་དབྲལ་བར་བྱ་བ་དང་།",
    "ཐོས་ནས་ཡིད་མ་ཆེས་པར་མཐོང་ངོ་ཞེས་བརྗོད་པ་དང་།",
    "ཡང་དགེ་སློང་གང་ཞེ་སྡང་ཅན་ཞིག་ཁྲོས་ནས་གནོད་པར་བྱེད་དེ།",
    "ཡང་ན་གཞན་གྱི་ཆ་ཞེས་བྱ་བ་ནི་རི་དྭགས་མི་ཚངས་པར་སྤྱོད་པའོ།",
    "གལ་ཏེ་མི་གཏོང་ན་དངོས་པོ་དེ་སྤང་བར་བྱ་བའི་ཕྱིར་ལན་གཉིས་ལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ་བར་བྱ་ཡང་དག་པར་བསྟན་པར་བྱའོ།",
    "ལན་གཉིས་ལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ་ཡང་དག་པར་བསྟན་ནས་དངོས་པོ་དེ་གཏོང་ན་དེ་ལྟ་ན་ནི་ལེགས།",
    "ལྷ་སྦྱིན་རབ་ཏུ་མ་རངས་ནས་དགེ་སྦྱོང་རྒྱ་མཚོས་བྱིན་པ་ལ་སོགས་པ་ལ།",
    "དེ་ལ་མཚན་མི་གཅིག་པ་དཔེར་ན་ལྷ་སྦྱིན་ཙཀྱིས་བྱས་པ་དོན་མེད་པར་འགྱུར་བའི་ཕྱིར་རས་ཀྱི་ཁ་ཚར་མ་བཅད་པའི་ག་ཤ་པྱགྱོན་པ་ལྟ་བུའོ།",
    "བྱས་པ་དོན་མེད་པ་མི་འགྱུར་བའི་ཕྱིར་རས་ཀྱི་སྤུཁ་ཚར་མི་བཅད་ཐུཔ་དང་།",
    "འཚོ་བ་མི་གཅིག་པ་ནི་དཔེར་ན་ལྷ་སྦྱིན་ཙོཁ་གསག་དང་།",
    "དབྱེ་བར་བྱ་བའི་ཞེས་བྱ་བ་ནི་ཟས་མང་པོ་དང་གྲོགས་མང་པོ་རྙེད་པར་བྱ་བའི་ཕྱིར་རོ།་།",
    "རྩོད་པ་ཡང་དག་པར་གཟུང་ངོ་ཞེས་པ་ནི་དེ་བཞིན་དུ་བསམས་པའོ།",
    "འདུམ་པར་གྱིས་ཅེས་པ་ནི་བསྒོ་བ་སྙེསྟེ་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "བསྟན་པ་ནི་ཙོའཇུག་པར་གྱིས་ཤིག་པའོ།",
    "ལྷག་མ་འདི་ལ་ཉེས་བྱས་གཅིག་དང་།",
    "དགེ་སློང་དེའི་གྲོགས་སུ་གྱུར་ལ་དབྱེན་མེད་བྱེཔར་ཕྱོགས་ནས།",
    "དགེ་སློང་འདི་ནི་ཤེས་བཞིན་དུ་སྨྲའི་མི་ཤེས་པར་མ་ཡིན་ནོ།",
    "དགེ་སློང་འདི་ནི་མི་ཤེས་བཞིན་དུ་སྨྲའི་ཤེས་པར་མ་ཡིན་གྱི།",
    "གལ་ཏེ་མི་གཏོང་ན་དངོས་པོ་སྤང་བའི་ཕྱིར་ལན་གཉིས་ལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ་བར་བྱ་ཡང་དག་པར་བསྟན་པར་བྱའོ།",
    "ལན་གཉིས་ལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ་ཡང་དག་པར་བསྟན་ནས་གལ་ཏེ་དངོས་པོ་དེ་གཏོང་བ་ལྟ་ན་ནི་ལེགས།",
    "གཞན་ནི་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "ཀྱེཁྱིམ་སུན་འབྱིན་པར་སྣང་ངོ།",
    "ཁྱེད་ཁྱེམ་སུན་འབྱིན་པར་སྣང་ངོ།",
    "ལན་གཉིས་ལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ་བར་བྱ།",
    "ཡང་དག་པར་བསྟན་པར་བྱའོ།",
    "ལན་གཉིས་ལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ་ཡང་དག་པར་བསྟན་ནས།",
    "ཐ་སྐར་སྐྱེས་དང་ནབ་སོ་གཉིས་མཉན་དུ་ཡོད་པར་ལྷགས་ནས།",
    "ལན་གསུམ་གྱི་བར་དུ་བསྒོ་བའི་ལས་བྱས་པ་ལས་མ་གེ་མཉན་པ་ལས་བཅས།",
    "ཁྱིམ་སུན་འབྱིན་པར་སྣང་བ་ནི་མཐོང་བའི་དོན།",
    "དེ་མན་ཆད་གཞན་ནི་དངོས་སུ་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "གལ་ཏེ་དངོས་པོ་དེ་གཏོང་བ་ལྟ་ན་ནི་ལེགས་གལ་ཏེ་མི་གཏོང་ན་དངོས་པོ་དེ་སྤང་བའི་༦ཕྱིར་ལན་གཉིས་ལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ་བར་བྱ།",
    "ཡང་དག་པར་རབ་ཏུ་བསྟན་པར་བྱའོ།",
    "ལན་གཉིས་ལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ།",
    "ཡང་དག་པར་རབ་ཏུ་བསྟན་ནས་གལ་ཏེ་དངོས་པོ་གཏོང་བ་ལྟ་ན་ནི་ལེགས།",
    "ཁྱེད་རྣམས་ནི་དཔེར་ན་ཤིང་རྣམས་ཀྱི་འདབ་མ་ལྷགས་ཏེ་གཅིག་ཏུ་འདུས་པ་བཞིན་དུ་བྱེད་ཀྱང་རིགས་དང་རུས་ཐ་དད་པ་ལས་རབ་ཏུ་བྱུང་ནས་འདུས་ཏེ་དཔུང་གཅིག་ཏུ་བྱས་སོ་ཞེས་སྨྲས་ནས།",
    "དུས་ལ་བབ་པར་བསྒོ་བ་དང་།",
    "བདེན་པར་བསྒོ་བ་དང་།",
    "དོན་དང་བཅས་པ་ནི་དོན་ཡོད་པར་བསྒོའི་དོན་མེད་པ་ཀྱེ་མ་ཡིན་ནོ།",
    "དེ་མན་ཆད་གཞན་ནི་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "དགེ་སློང་དེ་དག་ཀྱང་སྨད་པར་འགྱུར་ཏེ་དེ་ལ་དེ་ནི་དུས་ཡིན་ནོ།",
    "མི་འདོད་བཞིན་དུ་ཞེས་བྱ་བ་ནས་སེམས་མགུ་བར་བྱས་ན་ཞེས་པའི་བར་དུ་ནི་ཆད་པ་དང་སྦྱར།",
    "ཆད་པའི་ལས་དེ་མ་ཟིན་པར་ལྷག་མ་ཞིག་བྱུང་སྟེ།",
    "གང་ཟག་ཡིད་གཅུགས་པ་ལས་མཐོལ་བས་ཀྱང་ཚངས་པར་འགྱུར་རོ།",
    "གང་ཟག་ཡིད་གཟུགས་༧པ་ལ་མཐོལ་བས་ཀྱང་ཚངས་པར་འགྱུར་རོ།",
    "ཅི་འདི་ན་ཡོངས་སུ་དག་པར་གནས་སམ་ཞེས་དྲིའོ།",
    "ཅི་འདི་ན་ཡོངས་སུ་དག་པར་གནས་སམ་ཞེས་ལན་གཉིནུ།་",
    "ལྷག་མ་བཅུ་གསུམ་བརྗོད་ཀྱང་སུ་ཡང་མི་སྨྲ་བས་ན་ཀློག་པས་ཡིད་ཆེས་པར་བྱེད་ཐུཔའི་དོན་ཏོ།",
    "འབྲུ་གཉེར་གཞན་ནི་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "ཅི་འདི་ན་ཡོངས་སུ་དག་པར་གནས་སམ་ཞེས་དྲིའོ།",
    "ཅི་འདི་ན་ཡོངས་སུ་དག་པར་གནས་སམ་ཞེས་ལན་གཉིས་ལན་གསུམ་གྱི་བར་དུ་དྲིའོ།་།",
    "བྱེསྣསྔགས་ཀྱིས་མ་བཏབ་ཀྱང་སྤང་ནི་མི་དགོས་ཏེ་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "པ་ལྟ་བུ་འབྲལ་དུ་གནང་བ་ནི་གནང་བའི་དུས་སོ།",
    "ཉེ་དུ་ཡིན་པར་བསམས་ཏེ་བཅོལ་བ་ནི་ཉེས་བྱས།",
    "ཉེ་དུ་ཡིན་པ་ལས་མ་ཡིན་པར་བསམས་ཏེ་བཅོལ་བ་དང་ཡིན་ནམ་མ་ཡིན་ཇེ་ཚོམ་ཟ་བཞིན་དུ་བཅོལ་ན་ཉེས་བྱས་ཉེ་དུ་ཧཱུཾཤེས་བཞིན་པ་ལ་བཅོལ་ན་ཉེས་བྱས་མེད་དོ།",
    "དགེ་སློང་མ་གོས་རིན་ཆེ་བ་འཆང་དུ་མི་གནང་བས།",
    "ཁྱེམ་བདག་དད་པས་གོས་བྱིན་པ་ལ་ཉེས་པ་ཅི་ཡོད་སྨྲས་ནས་གཞན་གྱེས་དཔྱས་པར་གྱུར་པ་ལས་བཅས།",
    "གོས་བླངས་ན་སློང་བའི་ཚེ་ཉེས་བྱས།",
    "ཀཱཪྵ་པ་ཎ་ལྔ་རི་བ་ཞིག་བླངས་པ་ལས་ཀཱཪྵ་པ་ཎ་དྲུག་སྤྱོཡན་ཆད་རི་བ་ཞིག་ཐོབ་ན་སློང་བའི་ཚེ་ཚུཉེས་བྱས།",
    "དེ་བཞིན་ཀྱེཁ་དོག་སྔོན་པོ་ཞིག་བླངས་པ་ལས་དམར་པོ་ཐོབ་པ་དང་གོས་ཁྲུ་ལྔ་པ་ཞིག་བླངས་པ་ལས་ཁྲུ་དྲུག་པ་ཡན་ཆད་ཅིག་ཐོབ་ན་དེ་བཞིན་དུ་རིག་རྨྱེཔར་བྱའོ།",
    "དེ་ལ་ཡི་གེའི་གཉེར་གཞན་ནི་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "མིང་འདི་ཞེས་བྱ་བའི་དགེ་སློང་འོང་ན་ཧཱུཾདེ་ལ་གོས་རུང་བ་དུས་སུ་བསྐོན་ནོ་སྙམ་པ་ལས་དེ་ལ་གལ་ཏེ་དགེ་སློང་དེ་ལ་སྔར་མ་བསྒོ་བར་རྣམ་པར་རྟོག་པ་འགའ་ཞིག་བྱུང་ཤེསྟེ།",
    "ཚོང་དུས་སུ་ཉེ་དགའ་བོས་རྒྱུས་མཁན་བྱས་ནས་བཟང་པོ་ཉོས་ཏེ།",
    "རིན་ཕྱི་དུས་སུ་སྦྱིན་པར་བྱས་པ་ལས་མ་འབྱོར་ནས་སྡུག་བསྔལ་བར་གྱུར་པ་ལས་བཅས།",
    "ཡི་གེའི་རྐེགཉེར་གཞན་ནི་བརྡ་ཕྲད་པར་ཟད་དོ།",
    "དགེ་སློང་མིང་འདི་ཞེས་བྱ་བ་འོངས་ཏེ་བདག་ཅག་གཉིས་ཀྱིས་སྐྱེསོ་སོ་ནས་དེ་ལ་གོས་རུང་བའི་དུས་སུ་བསྐོན་ནོ་ཞེས་བྱས་ཏེ།",
    "དེ་ལ་གལ་ཏེ་དགེ་སློང་དེ་ལ་སྔར་མ་བསྒོ་བར་རྣམ་པར་རྟོག་པ་འགའ་ཞིག་བྱུང་སྟེ།",
    "དེད་དཔོན་གྱོམིང་འདི་ཞེས་བྱ་བས་བསྐུར་གྱིས་ཐུགས་བརྩེ་ཞུབའི་སླད་དུ་འཕགས་པ་འདི་དག་བཞེས་ཤིག་ཅེས་དེ་སྐད་ཟེར་བ་དང་།",
    "དྲན་པར་གྱིས་ཤིག།",
    "ལན་གཉིས་ལན་གསུམ་དུ་བསྐུལ་ཏེ་དྲན་པར་བྱས་ནས།",
    "དེ་ནས་རིང་པོ་མ་ལོན་པར་དོང་ཙེ་ཁྱེར་ཤོག་ཅེས་བྱས་པ་དང་།",
    "སྲིན་བལ་འགོད་དང་སྒོང་དང་ཕུང་པོ་ལྟ་བུ་འཇིག་གམ་བརྟོལ་ཉུ་ན་ཉེས་བྱས།",
    "བལ་དཀར་པོ་རིན་༢ཆེ་ལ་ནག་པོ་རིན་ཆུང་བའི་ཡུལ་ན་ནི་ནག་པོ་འབའ་ཞིག་ལས་བྱས་ན་ཉེས་པ་མེད་དོ།",
    "སྟན་རྙིང་པ་སྤངས་ཏེ་རྔེད་པར་བྱས་ལ་སར་པ་བྱེད་ཀྱང་ཕྱོརྙིང་པ་ཡོད་བཞིན་དུ་སར་པ་བྱེད་ཀྱང་རུང་སྟེ།་",
    "ཚོང་པ་རབ་ཏུ་དད་པར་གྱུར་ནས་ཀྱེརས་ཡུག་ལྔ་བརྒྱ་ཁྲུཕུལ་ལོ།",
    "ཟུར་གྱིས་ལེན་དུ་བཅུག་ན་ཉེས་བྱས།",
    "ངས་ཀྱང་གྱོན་ནས་གྲོང་རྒྱུ་བའི་ཚེ་གཞན་གྱིས་དྲིས་ན་གཅེར་བུ་པ་མིང་འདི་ཞེས་བྱ་བས་བྱིན་ནོ་ཞེས་བརྗོད་པར་བྱའོ་ཞེས་ནས།",
    "གྲོགས་པོ་རྣམས་ཀྱིས་ཚངས་པར་སྤྱོད་པ་དང་དབྲལ་བར་བྱས་ནས་ལ་བ་ལེན་དུ་འོངས་པ་དང་།",
    "ལོ་ལེགས་པའི་ཚེ་འབྲུ་རིན་ཆུང་བ་རྣམས་ཉོས་ལ་ལོ་ཉེས་བྱུང་སྟེ་འབྲུ་རིན་ཆེ་བ་ན་བཙོངས་ནས་མུ་སྟེགས་ཅན་གྱིས་དཔྱས་པ་ལས་བཅས་ཁེ་སྤོགས་བྱ་བའི་ཕྱིར་ན་ཉོ་བ་ཕྱོབའི་ཚེ་ཉེས་བྱས།",
    "ཐོཔའི་ཚེ་ན་ཉོ་བའི་ཚེ་ཉེས་བྱས་འཚོང་བའི་ཚེ་ཉེས་པ་མེད།",
    "ཁེ་བཙལ་བའི་ཕྱིར་སྤོགས་བྱས་ན།",
    "དེ་ནས་སྦུན་ཟན་པས་རབ་ཏུ་འབུལ་བའི་རིགས་ན་བདག་ལ་ལྷུང་བཟེད་མེད་དོ་ཞེས་བྱས་པ་དང་།",
    "ཡང་དགེ་སློང་གང་ལྷུང་བཟེད་ལྷན་པ་ལྔ་མེད་པར་ཧཱུཾསྤྱད་བཟོད་པ་ཡོད་བཞིན་དུ།",
    "ཉེ་དགའ་བོས་མཐོང་ནས་ཚིགས་བཅད་བྱས་ཏེ་ལྷུང་བཟེད་བླངས་སོ།",
    "ཁྱེམ་བདག་དེས་བཙུན་པ་ཅི་ཞིག་བཞེད་ཅེས་བྱས་ནས།",
    "དེ་ལ་གལ་ཏེ་དགེ་སློང་ལ་སྔར་དེ་མ་བསྒོ་བར་དེར་སྙེརྣམ་པར་རྟོག་པ་འགའ་ཞིག་བྱུང་ནཟུ།",
    "ཚེ་དང་ལྡན་པ་ཐ་ག་པ་ཤེས་པར་གྱིས་ཤིག།",
    "ཚེ་དང་ལྡན་པ་ཐ་ག་པ་གོས་འདི་ཐག་རན་བཟང་བ་དང་ཡུག་ཁྱིམ་ཆེ་བ་དང་འཇུར་རུམདུད་མེད་པར་ཐོག་ལ་བཅག་ཐུན་ལེགས་སོ།",
    "ཉེ་དགའ་བོས་ཚིགས་བཅད་བྱས་ནས་སྣམ་ཐུ་བུ་བླངས་པའི་འོག་ཏུ་ཁྱིམ་བདག་འཁྲུག་༥པ་ལས་བཅས།",
    "དེ་ལྟར་མ་བྱས་ན་ཉེས་བྱས།",
    "དེ་ལས་འདས་པར་འཆང་ན་སྤང་བའི་རྩང་བའོ།་།",
    "འཇིགས་པ་དང་བཅས་པར་ཤེས་པ།",
    "ཉམ་ང་ཞིང་འཇིགས་པར་ཤེས་པའི་གནས་རྣམས་སུ་དབྱར་ཐ་མར་གྱུར་ལ།",
    "སྐུ་གཟུགས་དང་མཆོད་རྟེན་ལ་བསྔོས་པ་དང་ཆུང་ངུ་ན་དར་མའི་བམ་པོ་ལ་ཕ་སོ་སོར་བསྔོས་པ་ལས་ཕྱིར་ནོར་ཏེ་བསྔོས་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་ན་བ་རྣམས་ལ་གང་ཕན་པའི་ཡི་ག་འབྱེ་བ་རྣམས་གསུངས་པ་འདི་ལྟ་སྟེ།",
    "འདི་ཞག་བདུན་དུ་བདག་དང་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་ཀྱི་ཕྱིར་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཅི་འདི་ན་ཡོངས་སུ་དག་པར་གནས་སམ་ཞེས་ལན་གཉིས་ལན་གསུམ་དུ་དྲིའོ།",
    "ཤེས་བཞིན་གྱི་བརྫུན་ཀྱྀ་བྱས་ཏེ།",
    "རྒྱལ་པོའི་ཁབ་ན་བཞུགས་ན་ནི།",
    "བྱ་རྒོད་སྲུངས་པའི་རི་ལ་བཞུགས་ཞེས་སྨྲས།",
    "བྱ་རྒོད་སྤུངས་པའི་རི་ལ་བཞུགས་པའི་ཚེ་ན་ནི།",
    "འོད་མའི་ཚལ་དུ་བཞུགས་ཞེས་སྨྲས།",
    "བརྫུན་བྱས་ནས་ཁྱིམ་བདག་དང་བྲམ་ཟེས་ཐུདཔྱས་པར་གྱུར་ཏོ།",
    "བརྫུན་བྱས་ནས་མུ་སྟེགས་ཅན་གྱིས་དཔྱས་པ་ལས་བཅས།",
    "མིང་མཁན་མ་རྫོགས་པ་ནི་ཉེས་བྱས།",
    "དགེ་སློང་དག་བག་འཆུམས་ཤིང་འཛེམ་པར་གྱུར་ནས།",
    "དགེ་སློང་འདྲོན་རྟེཔོ་རྒྱུས་མི་ཤེས་པས་སྤྱོས་ནན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཡང་ཚིག་ལྔའམ་དྲུག་ཤོད་ཅིག་པར་བཀའ་སྤྲུལ་པ་ལས་བཅས།",
    "གཉིས་ཀས་༡༢མཉམ་པར་ཤེས་པ་ལས་ཅིག་ཅར་བཀླགས་ན་ཉེས་པ་མེད་དོ།",
    "སྐྱོན་ཡོད་པ་ལ་སྨྲས་ན་ཉེས་བྱས།",
    "སྔོན་ནི་བདག་ཅག་ལ་གདེང་མེད་བཞིན་དུ་བརྫུན་བྱས་པ་ཡིན།་",
    "ད་ནི་ཡང་དག་པར་ཐོབ་ནས་རུབདེན་པའི་ཡོན་ཏན་བརྗོད་པར་བྱའོ་ཞེས་པ་ནས།",
    "དགེ་སྤྱོང་རྨྱེལ་སྨྲས་ན་ཉེས་བྱས།",
    "གྱད་བུ་ནོར་ལ་སྦྱིན་པར་གསོལ་བའི་ལས་ཀྱིས་དད་པ་བསྡུས་ཏེ་བྱིན་པ་ལས།",
    "ས་བོན་དུ་མི་རུང་བར་བྱས་ན་རྩང་བའོ།",
    "མེ་ཏོག་ཁ་ཕྱེ་བ་བརྔས་སྔོན་ཉེས་བྱས་སུ་འགྱུར།",
    "ཐ་མལ་པར་བསྐོས་ཀྱང་རུང་སྟེ།",
    "གླགས་ཚོལ་བ་ལས་ལན་ལོག་པར་གླན་པ་དང་།",
    "འདོམ་བཞི་བཅུ་རྩ་དགུར་མ་འདས་ན་ཉེས་བྱས།",
    "མ་གཤེར་རམ་སྲིན་བུས་མ་ཟོས་ན་ཉེས་བྱས།",
    "བསྙེན་པར་མ་རྫོགས་པ་རྣམས་ལ་མི་བཅོལ་ཏེ།",
    "ལྷོ་ཕྱོགས་ནས་དགེ་སློང་གཉིས་ཤིག་མཉན་དུ་ཡོད་པར་ཕྱིན་ནས།་",
    "བཙུན་པ་ཉེ་དགའ་བོའི་མལ་སྟན་དང་རྐང་པ་བཀྲུ་བའི་ཆུ་ཡང་གནས་ཁང་དུ་བཞག་པ་ལགས་ཀྱིས་དེར་ནོན་ཤཱབྱེ་ཅིག་ཅེས་བྱས་པ་དང་ཉེ་དགའ་བོ་ཚིག་པ་ཟོས་ནས།",
    "སྲོག་ཆགས་འདི་དག་རྒྱ་མཚོ་ཆེན་པོར་མི་འདོང་བར་སྣོད་ཆུང་ངུའི་ནང་དུ་ཅི་འདོད་ཅེས་བྱས་ནས་དོན་ཉུང་བའི་དགེ་སློང་ངྒེ།",
    "སྲོག་ཆགས་ཡོད་པ་ལ་མེད་པར་འདུ་ཤེས་སམ་ཇེ་ཚོམ་ཟ་བས་སྤྱད་ན་ཉེས་བྱས་སུ་འགྱུར།",
    "བསྙེན་པར་རྫོགས་ནས་ལོ་ཉི་ཤུ་ལོན་པ་དང་།",
    "ལྕི་བ་བརྒྱད་རྒྱས་པར་འཆད་མི་ནུས་པ་ལས་བསྐོས་ན་ཉེས་བྱས།",
    "ཉི་མ་ནུབ་པ་ལ་ནུབ་པར་འདུ་ཤེས་པ་དང་།",
    "གོས་མེད་པར་གྱུར་ཏམ།",
    "འགྲོན་པོ་མང་པོ་འདོང་བའི་ལམ་དོགས་པ་དང་བཅས་པར་ཤེས་པ་འཇིགས་པ་དང་བཅས་པར་ཤེས་པ་ཉམ་ང་ཞིང་འཇིགས་སུ་རུང་བ་དང་བཅས་པར་ཤེས་པ་ཞིག་ན་དེ་ལ་དེ་རིཤེནི་དུས་ཡིན་ནོ།",
    "ཐོག་མ་མ་འཐམས་པར་ལམ་དུ་ཕྲད་དེ།",
    "འདི་ནི་མནའ་མའོ་ཞེས་བྱས་པ་བསོད་སྙོམས་པས་ཐོས་ལྗུནས།",
    "དགེ་སློང་འཆར་བ་ཅེ་དང་གཉིས་དབེེན་པ་ན་ཙོ་༡འགྲེང་ངོ་ཞེས་བྱས་ནས།",
    "འཕགས་པ་ཁ་ཅིག་བཤོས་ལེགས་པར་མི་གསོལ་ན།",
    "བདག་རྔུཡུལ་དུ་མི་སྐྱེ་བར་མི་འགྱུར་གྲང་ཞེས་བྱས་པའི་ཚེ་བཅས་སོ།",
    "གོས་དང་གོས་རིན་མེད་པར་ཁ་གཉིས་སུ་བོས་ན་སྔ་མ་ནི་བཟའ།",
    "སྔ་ཕྱི་གཉིས་ཀ་ལ་གོས་ཡོད་ན་བཟར་རུང་གོས་རིན་མེད་པར་ཁ་གཉིས་སུ་བོས་ཏེ་མ་ཟོས་པར་ཁས་བླངས་ན་ཉེས་བྱས།",
    "ལོ་ཉེས་བྱུང་ན་འགྲངས་ཀྱེཔར་རྙེད་པ་མེད་པས་ཡང་ཡང་ཟོས་ཀྱང་ཉེས་པ་མེད་དོ།",
    "ཁྱིམ་བདག་དེས་འཚོ་བ་སྦྱར་བར་བྱས་སོ།",
    "དེར་གནས་ཤིང་གུད་དུ་ཟན་ཟ་ན་ཉེས་བྱས།",
    "ན་བ་ལ་གནང་བ་ནི།",
    "དེ་ལས་ལྷག་པར་བླངས་ན་རྩང་བའོ།",
    "དེ་ནས་ལེན་པའི་གཉེ་བོ་སྦྱིན་པར་ཞར་མའི་མས་ཁྱར་བ་མང་པོ་བྱས་པ་དང་།",
    "དགེ་སློང་བཞི་པོ་ལ་མི་རྟ་བྱིན་ན་ཡང་ཉེས་བྱས་སུ་འགྱུར།",
    "དགེ་སློང་རྣམས་སྤང་བ་བྱས་པ་དང་།",
    "ཟས་མ་ཟ་ཤིག་པར་བཀའ་སྩལ་པ་ལས།",
    "སྤང་བ་བྱས་ལ་བྱས་པར་འདུ་ཤེས་བཞིན་དུ་ལྷག་བོར་མ་བྱས་པར་བཟའ་བ་དང་བཅའ་བ་ཟོས་སམ།",
    "སྤང་བ་མ་བྱས་པར་སྤང་བར་འདུ་ཤེས་པ་དང་།",
    "ཐེ་ཚོམ་ཡོད་བཞིན་དུ་ཟོས་པ་ན་ཉེས་བྱས་སུ་འགྱུར་ཏེ།",
    "ལྷག་མའི་སྔགས་ནི་ཟས་༣ཟོས་ཏེ་སྤང་བ་བྱས་པའི་འོག་ཏུ་བཟའ་བའམ་བཅའ་བ་ཞིག་འོངས་ཏེ།",
    "འདོད་ལ་བྱིན་ལེན་བྱས་ན།",
    "རྣམ་པ་འདི་ལྔས་ནི་ལྷག་མར་བྱས་པར་མི་འགྱུར་ཏེ།",
    "ལྡང་བའི་ཚེ་ན་ཟན་སྤང་བར་མ་བྱས་ན་ཕྱིས་ཟར་རུང་ངོ།",
    "སློབ་དཔོན་གྱི་སྤྲུལ་པ་དེ་དག་ནི་ལྷག་མར་མ་༡བྱས་པར་སླར་ལོག་ན་རྩེ་གནོད་པར་བྱ་བའི་ཕྱིར་ཁ་ཟས་དུས་ཀྱིས་བསྟབས་ཏེ་ཟོས་པའི་འོག་ཏུ་རྒན་ཞུགས་ཀྱིས་སྨྲས་པ།",
    "དགེ་སློང་ལ་གནོད་པ་བྱ་བའི་ཕྱིར་ཟས་ཟོས་ཟིན་ལ་ལྷག་མར་བྱས་པའི་ཁ་ཟས་བསྟབས་ན་བེེང་བར་འགྱུར།",
    "དགེ་སློང་ལྷ་སྦྱིན་གྱིས་གཞན་དག་ཐུམི་མཐུན་པར་བྱ་བའི་ཕྱིར་རྒྱ་མཚོས་བྱིན་ལ་སོགས་པ་བསྡུས་ནས།",
    "དེར་ཟན་ལ་འདུས་པ་རྣམས་ཀྱིས་སོ་སོའི་གནས་ཁང་ནས་དགེ་སློང་དག་འདིར་ལྷགས་སམ་ཞེས་མ་དྲིས་པར་བྱས་ཐུན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "མཆོད་རྟེན་གྱི་ཕྱིར་ལས་ཆེན་པོ་བྱས་པ་དང་།",
    "མུ་སྟེགས་ལས་བྱུང་བའི་དགེ་སློང་དེས་ཟས་བྱིན་པ་ཡང་འདུས་ཤིང་ཟར་རུང་ངོ་ཞེས་གསུངས་པ་ལྟ་བུ་སྟེཟུ།",
    "འདི་ལྟ་བུའི་ཚིག་ངན་པ་ཐོས་ན་ཅི་རུང་ཞེས་བྱས་ནས་བསོད་སྙོམས་མི་ལེན་པར་བྱེད་དོ་ཐུ།",
    "ནང་པར་ཟན་ཟོས་ཏེ།",
    "ཕྱི་དྲོ་ཁ་མ་བཀྲུས་པར་སྐོམ་འཐུངས་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "འོད་མི་སྣང་བའི་སྐོམ་འཐུངས་ན་ཉེས་བྱས།",
    "གཅིག་ཤི་བ་ལྟར་བྱས་ནས།",
    "དགེ་སློང་དེ་སྒོད་དུ་ཆས་པ་དང་རོ་ལྟར་བྱས་པའི་བུས་པ་དེས་ཁུས་བཏབ་སྟེ་བྲོས་ནས།",
    "བྱིན་ལེན་དུ་མི་འགྱུར་བ་ནི་རྒྱབ་དང་གློ་གཡས་གཡོན་ནས་བྱིན་ལེན་བྱས་པ་དང་།",
    "བྱིན་ལེན་མ་བྱས་ཀྱང་ཉེས་པ་མེད།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་རྣམས་ལ་ཟས་བཟང་པོར་གསུངས་པ་འདི་ལྟ་སྟེ།",
    "འདི་རྣམས་སློང་བའི་ཕྱིར་ཉེས་བྱས་ཟོས་ན་རྩང་བ།",
    "ན་བའི་ཚེ་ཟོས་ན་སློང་བའི་ཚེ་ཉེས་བྱས།",
    "སྲོག་ཆགས་འདི་དག་རྒྱ་མཚོའི་ཐུ་རྫིང་ཆེ་བར་ཅི་ཕྱིར་མི་འདོང་ཞེས་བྱས་པ་ན།",
    "སྲོག་ཆགས་ཡོད་པར་འདུ་ཤེས་སམ།",
    "ཁ་ཟས་ཀྱི་ཁུ་བ་སྣ་ཚོགས་དང་མར་དང་སྦྲང་རྩི་ལ་སོགས་པ་ཡོད་པར་འདུ་ཤེས་སམ།",
    "བསོད་སྙོམས་བཞེས་ལ་གཤེགས་ཤིག་ཅེས་བྱས་པ་དང་།",
    "ཀྱེ་ལ་རྒྱལ་བའི་སྲས་སྡུག་བསྔལ་ཅན་བདག་ཀྱང་འཚལ་མ་སྩོལ་ཅེས་བྱས་པ་དང་།",
    "དགེ་སློང་མགོ་བྱི་རྒྱགས་ཤིང་བྱུང་རྒྱལ་དུ་སྨྲ་བས་འཇིགས་ཞེས་བྱས་ནས།་",
    "དགེ་སློང་དེས་དམག་དེའི་ནང་དུ་ཞག་གཉིས་ལས་གནས་པར་མི་བྱའོ།",
    "དེ་ནས་དམག་རྣམ་བཞི་བྱུང་བ་ལ་ཡང་རྣམ་པར་སྨད།",
    "ཐུགས་བརྩེ་བའི་སླད་དུ་དགེ་སློང་དམག་ཆས་པ་ལ་ལྟར་འོངས་ན་ཡང་ཡུན་རིང་དུ་མི་གནས་པར་དྲན་པ་འཆའ་བ་ལས་བཅས།",
    "མ་གནང་བ་ལས་བཅས།",
    "ཡི་གེའི་ཀྱི་གཉེར་གཞན་ནི་བརྡ་སྤྲད་པར་ཟད་དོ།",
    "དགེ་སློང་ལ་བརྡེགས་པར་གཟས་ན།",
    "མ་ཆོད་ཚུན་ཆད་ཉེས་བྱས།",
    "གལ་ཏེ་ཉེས་པ་དེ་བསྙད་ན་བདག་ཚངས་པར་སྤྱོད་པའི་བར་ཉུ་དུ་འགྱུར་རམ།",
    "དགེ་སློང་འདི་ཟན་གཅོད་ཀོདོ་སྙམ་ནས་ཟན་གཅད་ཉུ་པར་བསམས་ཏེ།",
    "ང་ནི་གཅིག་ཏུ་ན་བདེའོ་ཞེས་བྱས་ཏེ།",
    "ཡི་གེའི་གཉེར་ལ་གཞན་ནི་བརྡ་འཕྲད་པར་ཟད་དོ།",
    "ཡང་དགེ་སློང་མིན་པར་བདག་མི་བཞུགས།་",
    "དགེ་སློང་བསྲོ་བའི་ཕྱིར་དང་འབྱེལ་པའི་ལས་བྱས་པའི་ཕྱིར་དང་།",
    "དེ་ནས་ཉེ་དགའ་བོ་དགེ་སློང་དང་ལྷན་ཅིག་ཞག་གཉིས་ལས་འདས་པར་ཉལ་ནས།",
    "བཅོམ་ལྡན་འདས་ལ་སྐུར་པས་ལེགས་པར་མི་འགྱུར་རོ།",
    "དེ་དག་བསྟེན་ན་བར་དུ་གཅོད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་མི་གཏོང་ན་དངོས་པོ་དེ་སྤང་བའི་ཕྱིར་ན་རྔུལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ་བར་བྱའོ།",
    "ཡང་དག་པར་བསྟན་པར་བྱའོ།",
    "ཡང་དགེ་སློང་སུ་ཡང་འདི་སྐད་དུ་ཇི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་འདོད་པ་ནི་བར་དུ་གཅོད་པའོ་ཞེས་གསུངས་པའོ།་།",
    "དེ་དག་གང་ཡིན་པ་བསྟེན་ཀྱང་བར་དུ་གཅོད་པར་མི་འགྱུར་ཏེ།་",
    "བཅོམ་ལྡན་འདས་ལ་སྐུར་པས་ལེགས་པར་མི་འགྱུར་རོ།",
    "ཚེ་དང་ལྡན་པ་དགེ་ཚུལ་འདོད་པའི་བར་དུ་གཅོད་པ་ཉིད་དོ་ཞེས་བཅོམ་ལྡན་འདས་ཀྱིས་རྣམ་གྲངས་དུ་མར་གསུངས་ཏེ།",
    "གལ་ཏེ་མི་གཏོང་ན་དངོས་པོ་དེ་སྤང་བར་བྱ་བའི་ཕྱིར་ལན་གཉིས་ལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ་བར་བྱ།",
    "ཡང་དག་པར་བསྟན་པར་བྱའོ།",
    "ལན་གཉིས་ལན་གསུམ་དུ་ཡང་དག་པར་བསྒོ་ཡང་དག་པར་བསྟན་ནས་དངོས་པོ་དེ་གཏོང་བ་ན་ནི་ལེགས།",
    "དྲེགས་ཤིང་རྒྱུག་པ་ནི་ལུས་འཚོག་པར་བྱེད་པ་ལས།",
    "བཙུན་པ་འཆར་བ་ལྟ་བུའི་འཕོང་རྩལ་ནི་གཞན་གྱི་བརྗོད་དུའང་མི་རུང་ངོ་ཞེས་བྱས་ནས།་",
    "གོ་བསྒོས་༡་ནས་རྒྱལ་པོ་མ་སྐྱེས་དགྲའི་དམག་རྒོལ་བའི་སྒྲ་གྲག་གོ་ཞེས་བྱས་པ་དང་།",
    "རིང་བསྲེལ་མེད་པ་བླངས་ན་ཉེས་བྱས།",
    "སྟོན་པར་འདུ་ཤེས་པར་སྐྱེད་དེ་བླངས་ན་ཉེས་པ་མེད།",
    "རྒྱལ་པོས་བསམས་པ་བདག་འཁྲུ་བར་ནི་འཕགས་པ་དག་ཁྲུས་མཛོད་ཅིག་ཅེས་བྱས་པའི་འོག་ཏུ།",
    "ཆུའི་ནང་དུ་འཁྲུ་བ་ནི་ལྟེ་བ་ཁུང་མན་ཆད་ནུབ་ན་ཉེས་བྱས།",
    "བཤམ་པ་ལས་མ་ཤི་ན་ཉེས་བྱས།",
    "དེ་ནས་ཁོས་ཙ་ག་ག་ཚིལ་བྱས་ནས་དེས་བགད་་པ་དང་གཞན་རྣམས་ཀྱིས་ཀྱང་ཐབས་དེ་བཟང་ངོ་ཞེས་བྱས་ཏེགེ།",
    "ལུས་ཀྱི་ཡན་ལག་ཇི་ལྟ་བུས་ག་ག་ཚིལ་བྱས་པས་ཀྱང་རུང་སྟེ།",
    "ག་ག་ཚིལ་བྱས་ན་རྩང་བར་འགྱུར།",
    "དགེ་སྦྱོང་ལ་བྱས་ན་ཉེས་བྱས།",
    "ལིས་དགྲ་བཅོམ་པ་ཐོབ་ནས་དེས་གདུལ་སྐལ་ཡོད་པར་མཐོང་ནས།",
