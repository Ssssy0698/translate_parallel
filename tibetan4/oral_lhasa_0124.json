    "ལོག་པར་ལྟ་བར་གྱུར་པ་དང་།",
    "དེ་ལྟར་ཁོམ་པ་ཕུན་སུམ་ཚོགས་པ་དང་ཡང་ཀྱེལྡན་པར་གྱུར།",
    "དེ་ལ་ངེས་པར་ཛེེཞེས་བྱ་བ་ནི་མཐོ་རིས་སུ་སྐྱེ་བ་དང་འཇིག་རྟེན་གྱི་ལོངས་སྤྱོད་མྱོང་བར་བྱ་བ་དང་།",
    "ཚིགས་བཅད་གཅིག་ནི་ལུང་ལས་ཐོབ་པར་དཀོན་པ་དང་།",
    "སྒྲུབ་པར་བྱེད་པ་ཤིན་ཏུ་དཀོན།",
    "གཟུང་བའི་སྒྲ་དོན་དང་བཅས་པར་ཡིད་ཀྱིས་ཟིན་པའོ།",
    "དེ་ལ་བསྒྲུབ་པ་ནི་ཡང་དག་པར་སྦྱོར་བ་སྟེ།",
    "དོན་ཇི་བཞིན་ཉམས་སུ་སྤྱད་ནས་ལུས་ངག་ཡིད་ཁུགས་པར་བྱེད་པ་སྟེ།",
    "གཟུངས་སུ་འཛིན་ཅིང་སྒྲུབ་པར་བྱེད་པའང་ཤིན་ཏུ་དཀོན་པར་རིག་པར་བྱའོ།",
    "དེ་ལས་ཆོཐོས་པ་དང་གཟུང་བ་དང་འཛིན་པ་གསུམ་ནི་ལུང་ལས་ཐོབ་པར་དཀོན་པའི་ནང་དུ་བསྡུ།",
    "གོང་མ་ལྟར་སྡུག་བསྔལ་གྱི་ཕུང་པོ་ཡིན་དུ་ཟིན་ཀྱང་དེ་ཉིད་རྣམ་པར་གྲོལ་བ་བདེ་བའི་རྒྱུར་འགྱུར་བས་ན་འགལ་བ་མེད་དོ།",
    "རྣམ་པར་གྲོལ་བའི་སྒུ་བརྙེས་པས་ན་བདག་བདེ་བ་ཡིན་ནོ།",
    "དེ་ལ་དཀའ་ཐུབ་ནི་གང་བསྒྲུབ་ཅིང་སྤྱད་པར་བྱ་བ་ཡིན་ཏེ།",
    "རང་བཞིན་དང་བཅས་པའི་ཉེས་བྱས་ཡན་ཅད་ཤེམི་སྤྱོད་པའོ།",
    "འདི་མན་ཆད་རྩ་བ་གཉིས་ནི་དོན་དམ་པའི་འཕགས་པའི་ཏྲེཡིན་པར་སྟོན་པའོ།",
    "ཡང་སྲིད་རྣམ་པར་གྲོལ་བ་ཡི་ཟུ།",
    "ང་རྒྱལ་ཟད་པ་བདེ་ཞེས་བྱ་བའི་བར་དུ་ཚིགས་བཅད་གཅིག་ནི་འཐོབ་པར་བྱ་བ་བདེ་བའི་རྒྱུ་དང་།",
    "བསྒྲུབ་པར་བྱ་བ་བདེ་བའི་རྒྱུ་བསྟན་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་ཐོབ་པར་བྱ་ན།",
    "རྩ་བ་འདིས་ནི་འཐོབ་པར་བྱ་བ་བདེ་བའི་རྒྱུ་ཡིན་པར་བསྟན་ཏོ།",
    "ངེས་པར་བྱ་བའི་ཐུམན་ཆད་ནས་ཡལ་བ་རྣམས་ཀྱང་བདེ་ཞེས་བྱ་བའི་༥བར་དུ་ཚིགས་བཅད་གཅིག་ནི་སྦྱངས་པའི་ཡོན་ཏན་དང་ལྡན་པས་བདེ་བའི་རྒྱུར་བསྟན་པ་ཡིན་ནོ།",
    "གནས་པར་གྱུར་དང་ནགས་སུ་གདགས་ཀླུཔ་དང་།",
    "ངེས་པར་བྱས་པ་ནི་འུཡི་དམ་བླངས་པ་ལ་བྱ་སྟེ།",
    "འདིས་ནི་ཡི་དམ་བཅས་པ་དང་པོ་རྣམ་པར་དག་པ་བསྟན་ཏོ།",
    "མང་དུ་ཐོས་པ་ནི་རང་བཞིན་དང་བཅས་པའི་ཉེས་བྱས་དང་།",
    "འདིས་ནི་ཞི་གནས་ཕུན་སུམ་ཚོགས་པར་ཀླེསྣ་བསྟན་ཏོ།",
    "སྒྲུབ་པར་དམ་འཆར་གཞུག་པ་དང་།",
    "ཡང་དག་པར་སྟོན་པ་དང་།",
    "ཚེ་དང་ལྡན་པ་ནི་ཀློག་པས་འཁོར་འདུས་པ་ལ་སྙན་པར་བོད་པ་སྟེ།",
    "གསོ་སྦྱིན་གྱི་ཁ་ཏོན་ཀློག་པའི་ཚེ་དུས་གང་ཡིན་པའི་ཟླ་བ་འདི་སྙེད་ཅིག་འདས་འདི་སྙེད་ཅིག་ལུས་ཞེས་བརྗོད་པར་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཚངས་པར་སྤྱོད་པའི་རྒྱུར་བསྟན་པ་ཡིན་ཏེ།",
    "དེ་ལ་སྟོན་པ་ནི་ཕྱིན་ཅི་མ་ལོག་པར་སྟོན་པ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་སྔ་རབས་ཀྱི་དེ་བཞིན་གཤེགས་པ་བཞིན་དུ་གསུངས།་",
    "སྔ་མ་བཞིན་དུ་ཆུད་ཅིང་མཁྱེན་པའོ།",
    "སྔ་མ་བཞིན་དུ་ལྷག་མ་མ་དུལུས་པར་མྱ་ངན་ལས་འདས་པས་དེ་བཞིན་གཤེགས་པ་ཞེས་བྱའོ།",
    "ཡང་དག་པར་རྫོགས་པ་ནི་ཕྱིན་ཅི་མ་ལོག་པར་རྫོགས་པའོ།",
    "ལེའུ་འདིས་ནི་བག་བྱས་པའི་འབྲས་བུ་བསྟན་པ་ཡིན་ནོ།",
    "འདི་མན་ཆད་ནས་བརྗོད་པར་བྱའོ་ཞེས་པའི་བར་དུ་མ་འདུས་པ་བསྡུ་བར་བསྟན་པ་ཡིན་ནོ།",
    "གཞན་གྱིས་ཐོས་པར་བརྗོད་པའི་དོན་ཡང་ཡིན་ནོ།",
    "དོན་ཉུང་བ་ནི་གོང་མ་ལྟར་བཤགས་པར་ཙུབྱས་པས་ན་ཉེས་བྱས་ཡན་ཆད་སེམས་ཀྱིས་སྡོམ་ཞིང་དྲན་པར་བྱེད་པའོ།",
    "དྲིས་ནས་ཀྱང་སླར་བརྗོད་པར་བྱའོ།",
    "གསོ་སྦྱིན་གྱི་གནས་སུ་མི་འདུར་གནང་བ་ནི།",
    "དེ་ལ་དད་པ་ཕུལ་བས་ནི་མི་མཐུན་པའི་ལས་མེད་པར་འགྱུར།",
    "འཕགས་པའི་ལམ་རྣམ་པར་གཞག་པས་འཕགས་པའི་འབྲས་བུ་མི་ཐོབ་བོ་ཞེས་གླེགས་ཀྱང་དོགས་༨པ་མེད་པའོ།",
    "ཐོས་པར་དམ་བཅའ་བ་དང་།",
    "བསྒྲིམས་ཏེ་གུས་པར་གྱེས་ཤིག་ཅེས།",
    "གསུངས་པ་བཞིན་དུ་བསྒྲུབ་པར་གྱིས།",
    "ཐོས་ཞེས་པ་ནི་ཁ་ཏོན་ཀློག་པར་ཐོས་པའོ།",
    "རྟག་པར་ཤིན་དུ་བརྟན་ཐུཔ་ཡི།",
    "དཔེར་ན་རྟ་རྒོད་ལས་མ་ཡིན་པར་བརྟེན་པ་ནི་གཟེར་བུ་བརྒྱ་ཟུག་པའི་སྲབ་ཀྱིས་བསྲབས་ན་དུལ་བར་འགྱུར་རོ།",
    "འདྲ་ཞེས་པའི་ཚིག་ནི་རྣམ་པ་གཅིག་ཏུ་རིགས་པར་ཡང་འདྲེན་ཏེ།",
    "འཁྱམ་ཀྱེཔར་འགྱུར་ཞེས་པའི་ཚིགས་བཅད་གཅིག་ནི་ལོག་པར་བསྒྲུབས་སྒེཔའི་ཉེས་པ་སྟོན་ཏོ།",
    "ནམ་དུའང་འདོད་པར་མི་འགྱུར་རོཙུ།",
    "གཟུངས་མེད་རྣམ་པར་འཁྱམ་ཁྱེཔར་འགྱུར།",
    "གཟུངས་མེད་རྣམ་པར་སྐྱེའཁྱམ་པ་ནི་ཕྱུགས་རྒོད་པ་ཤཱ་དེ་སྒོག་རྟོད་ཀྱི་གཟུངས་ལས་ཤོར་ན་འཁྱམས་རྨེཔ་བཞིན་དུ་མུ་སྟེགས་ཅན་དང་།",
    "གསོན་ཅིག་པ་མན་ཆད་ནས་གསོལ་བའོ་ཞེས་ཐུཔའི་བར་དུ་ནི་ཡང་དག་པར་སྟོན་པ་འཆད་པ་ཡིན་ནོ།",
    "ལྟ་བ་མཐུན་པའི་༢མདུན་དུ་བཤགས་པར་བྱའོ།་།",
    "ཁྱེད་ཅག་སུ་ལ་ཉེས་པ་ཡོད་པ་ཀྱེདེས་མཐོལ་ཞིང་ཉེས་པ་མེད་ན་ཅང་མ་སྨྲ་ཤིག་པའི་ཚིག་ནི་ཁ་ཏོན་ཀློག་པར་བྱས་སུ་མ་ཟིན་གྱི་སྤྱོབར་དུ་བརྗོད་པར་བྱཉུ་།",
    "ལེའུ་འདིས་ནི་ལྷང་བ་མེད་པར་འགྱུར་བས་སྐྱེའཁོར་ཡོངས་སུ་སྦྱངས་པ་སྟོན་ཏོ།",
    "དེ་བས་ན་དགེ་སློང་ཉེས་པ་བྱུང་བ་རྣམ་པར་དག་པར་འདོད་པས་ཉེས་པ་ཡོད་ལ་དྲན་བཞིན་དུ་ཛེེམཐོང་བ་བཤགས་པར་བྱའོ།",
    "བཤགས་ན་བདེ་བར་འགྱུར་རོ།",
    "མ་བཤགས་མ་མཐོལ་ན་ནི་མ་ཡིན་ནོ།",
    "རྣམ་པར་དག་པ་ནི་མྱ་ངན་ལས་འདས་པའམ།",
    "བདེ་བར་འགྱུར་བ་ནི་གོང་མ་ལྟར་བཤགས་པ་བྱས་པ་ན།",
    "འགྱོད་པ་དང་ཐེ་ཚོམ་མེད་པར་འགྱུར་བས་བདེ་བ་ཞེས་བྱའོ།",
    "ཅི་འདི་ན་ཡོངས་སུ་དག་པར་གནས་སམ་ཞེས་ལན་གཉིས་ལན་གསུམ་དུ་དྲིའོ།",
    "དེ་ལྟར་སུའང་བཤགས་པ་བྱེད་པ་མེད་པར་གྱུར་ན།",
    "ཀློག་པས་འཁོར་གཙང་མར་རིག་པར་བྱ་བར་སྟོན་པའོ།",
    "ཁྲེལ་ཡོད་པར་བདེ་བར་བྱེད་པ།",
    "མ་དད་པ་རྣམས་དད་པར་བྱེད་པ།",
    "ཕྱི་བ་དང་༩ཡང་བར་ཤེས་ནས་ཐེ་ཚོམ་མེད་པར་འགྱུར་ཏེ།",
    "ཁྲེལ་ཡོད་པར་བདེ་བར་བྱེད་པ་ནི།",
    "ཉེས་པ་སྤྱོད་པ་ལེགས་པར་སྡོམ་པའི་ལས་ཅན་དུ་གྱུར་ནས།",
    "མ་དད་པ་རྣམས་དད་པར་བྱེད་པ་ནི།",
