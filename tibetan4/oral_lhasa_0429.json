    "དཀར་གསལ་རྣམ་པར་མི་གཡེང་བའོ།",
    "གཅིག་ཏུ་རྣམ་པར་ངེས་ཡིད་ཀྱིས།",
    "དེ་རྗེས་གཞན་ཡང་བསྟོད་དབྱངས་ཀུན་བརྗོད་མི་བཟད་ཡིད་ཀྱི་ནོངས་པ་མ་ལུས་ཡང་དག་བཤགས།",
    "རྔ་ཡབ་དཀར་བརྒྱ་༦ སེར་བུའི་ངད་བསྐྱོད་བརྟན་པར་མི་ནུས་གཡོ་བར་བྱེད།",
    "དེ་དབུས་བདག་བཞུགས་འདབ་སྟོང་ལྡན།",
    "སྦྱོར་བས་འཇིགས་པ་བསྐྱབ་པར་བྱ།",
    "རིན་ཆེན་སྦྱངས་པའི་སྣོད་དག་པར།་།",
    "ནམ་མཁའི་ཆུ་ཡིས་གང་བྱས་པ།་།",
    "མ་དག་དག་པར་བྱེད་པ་ནི།",
    "དགའ་སྟོན་ཆེན་པོ་སྦྱིན་པར་བྱ་། གང་ཡང་རྣལ་འབྱོར་ལུས་སྦྱིན་གྱི།",
    "དེ་ལ་མི་གང་ཞིག་སྔོན་གྱི་ལས་ཀྱི་རྣམ་པར་སྨིན་པའམ།",
    "༦༢ ༧འབྲས་ཡོས་དང་སྣུམ་ཁུར་ལ་སོགས་པ་ཇི་སྙེད་འབྱོར་པའི་ཡོ་བྱད་བཤམ་༡ པར་བྱའོ།",
    "ཨོ་ནཱ་ག་ས་པ་རི་ཝཱ་ར་ས་མ་ཡ་ཧཱུྃ་ཛཛ་། རྡོ་རྗེ་བསྡམས་པ་བྱས་ནས་ནི།",
    "མཚོ་ཆེན་རབ་དང་དཔག་མེད་རིན་ཆེན་ཆལ་པར་བཀྲམ་པའི་ནང་།",
    "བཅས་ཏེ་ཀླུ་རྣམས་ཚིམ་པར་བྱ།",
    "ཉེར་བཙས་འཕགས་པ་ཉིད་བཞུགས་པའི།་།",
    "མེ་ཏོག་དཀར་པོས་རབ་བརྒྱན་པར།",
    "དུག་གསོད་ངེས་པར་འབྱིན་པ་དང་།",
    "པརྨོ་ཉི་ཟླ་བགེགས་རྣམས་མགོ་མནན་མི་བཟད་རྔམ་པའི་སྐུ་ཆེན་པོ།",
    "རྣལ་འབྱོར་བརྩོན་པར་བྱེད་པ་དེས།་།",
    "གཞན་ལས་རྣམ་པར་རྒྱལ་བའི་གདམས་ངག་རྫོགས་སོ།་།",
    "འབར་བའི་ལྟེ་བ་རྣམ་པར་གནོན།",
    "རྣམ་པར་གནོན་མཛད་ཐུགས་རྗེ་ཆེ།",
    "ཡེ་ཤེས་སྤྱན་དྲངས་གསང་སྔགས་གསུངས།"
