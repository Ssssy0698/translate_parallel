    "སྒྲོག་ཆགས་སྦྲང་མའི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་ཞིང་བསྙུང་བའི་སྦྲང་རྩི་རོ་བཅུད་ཕུན་སུམ་ཚོགས་པ་ནི་སྐྱེས་བུ་སྦྲང་རྩི་བརྟགས་པ་ལ་མཁས་པས་སྦྲང་རྩི་དེ་དོན་དུ་གཉེར་བ་ཡིས་སྤྲང་མའི་དབུས་ན་ཡོད་པར་མཐོང་ནས་དུ་ང་གཏོང་བ་སོགས་ཐབས་སྣ་ཚོགས་ཀྱིས་སྤྲང་རྩི་དེ་དང་སྲོག་ཆགས་སྦྲང་མའི་ཚོགས་ཀུན་ནས་བྲལ་བར་བྱས་ཏེང་རྩི་ཐོབ་པར་རབ་ཏུ་བྱེད་པ་བཞིན།",
    "པམ་སྲང་ཕན་ཚུན་དུ་གྲུབ་ཏུ་རྒྱུ་བའས་འགྲོ་བའི་ཚེ་མི་འགའ་ཡི་གསེབ་སྦྲུམ་ཞིག་ཡོད་པ་ལྗན་ལྗིན་རུལ་བའི་གནས་ང་བར་གྱུར་པ་རུལ་བ་སོགྲཱ་ཀྱིས་མི་འཇིག་པའི་ཆོ་སཅན་གསེར་བཟང་གནས་དེར་སྔར་གྱི་གནས་སྐབས་དེ་བཞིན་དུ་ལོ་བརྒྱ་ཕྲག་མང་པོ་དག་ཏུ་གནས་པ་ན་གསེར་མིག་རྣམ་དག་དང་ལྡན་ལྷ་ཡིས་གཞས་དེར་ཡོད་པར་མཐོང་ནས་མི་ཞིག་ལ་འདི་ན་ཡོད་པའི་གསེར་རིན་ཆེན་ཕ་པའི་མཆོག་ཏུ་གྱུར་པ་འདི་ལོངས་ལ་འདམ་སོགས་སྦྱངས་ཏེ་རིན་ཆེན་གྱིས་བསྒྲུབ་པར་བྱ་བའམ་བསྐུལ་བར་འོས་པ་སྐུ་གཟུགས་དང་རྒྱན་ལ་སོགས་པ་གྱེས་ཤིག་ཞེས་སྨྲ་བ་ལྟར་ངོ།",
    "རང་ལྟོ་ན་ཡོད་པ་དེ་མི་བདག་ཡིནཔར་མི་ཤེས་པས་གཞན་གྱིས་བརྙས་སོགས་སྐྱུག་བསྔལ་བ་ལྟར།",
    "འབྲས་བུའི་སྤུན་པ་དང་ནི་མི་གཙང་ས།",
    "སོ་སེའི་དཔེ་དོན་རྒྱས་པར་བཤད།",
    "བསྔལ་གྱི་ཟུག་རྔུ་སྐྱེད་པར་བྱེད་པའི་ཕྱིད་རོ།",
    "དེས་ན་ཡང་དག་མིན་པའི་སྒྲོ་འདོགས་ཀྱི་ལྟ་བ་འཛིན་རྙིང་ཡང་དགུ་པའི་དོན་ཞི་རིགཔར་མི་འགྱུར་བར་སྐུར་པ་འདེབས་སོ།",
    "མིན་པའི་ཉེས་པ་འདི་སྦྲང་བ་ལྟར་ཡོད་པར་བཟུང་བ་གཞིར་བྱས་ནས།",
    "ཀུན་རྫོབ་དྲི་མ་རྣམས་རང་བཞིན་མེད་པར་ཤེས་པའི་ཤེས་ར་དང་།",
    "སྐུལ་བ་དང་འཚམས་པར་གཞན་དོན་མཛད་པ་བདག་ཉིད་ཆེན་པོ་སྤྲུལ་པའི་སྐུ་སྟེ་དབྱེ་བ་འཇུག་པའི་དོན་དང་།",
    "རྗེས་ཐོབ་ཏུ་ཇི་སྙེད་པའི་དོན་ལ་དམི་གས་པའི་རབ་ཏུ་རྣམ་པར་འབྱེད་པའི་ཡེ་ཤེས་གཉིས་པོ་དགས་བརྟེན་ནས་མངོན་གྱུར་དུ་འཐོབ་པ་ཡིན་ནོ།",
    "དོན་དམ་པའི་སངས་རྒྱུས་ཉིད་ནི་ཡོན་ཏན་དང་དབྱེར་མེད་པར་གཞས་པ་རྟོགས་པ་དང་།",
    "ཁྱད་པར་འདི་ཡང་གཉིས་ཡིན་ཏེ།",
    "ཡང་མཉམ་བཞག་རྣམ་པར་མི་རྟོག་པ་དང་དེ་ཡི་ཞི་རྗེས་ཐོབ་ཤེས་བྱ་ཇི་སྙེད་པ་རྣམ་པར་འབྱེད་པ་དེ་ནི་ཡེ་ཤེས་གཉིས་ཡིན་ཕར་འདྲོང་དོ།",
    "རྟོགས་པ་ཕུན་སུམ་ཚོགས་པའི་རྟེན་སྟོང་པ་ཉིད་འོད་གསལ་རྣ་མ་པ་ཀུན་གྱི་མཆོག་དང་ལྡན་པའི་སངས་རྒྱུས་ཀྱི་སྐུ་ཞིངས་པར་ཐོབ་པ་དེ་ནི་རྗེས་ལས་ཐོབ་པ་ཡི་ཤེས་བྱ་རྣམ་པར་འབྱེད་པའི་ཡེ་ཤེས་ཀྱིས་ཤེས་སྒྲིབ་སྤུངས་པའི་འབྲས་བུ་ཡིན་པར་སྟོན་ཏོ།",
    "ཇིལྟ་བ་མཁྱེན་པས་ཆུགས་པ་མེད་པ་དང་ཇི་སྙེད་པ་མཁྱེན་པས་ཐོགས་པ་མེད་པའི་ཕྱིར་ཡེ་ཤེས་དེ་ཤེས་བྱ་ཐམས་ཅང་ལ་ཁྱབ་པ་ཉིད་དུ་འདོད་དོ།",
    "དེ་གཉིས་ཇུས་གཏན་དུ་འཇིག་པའམ་འགྱུར་བ་མེད་པ་ཡིརང་བཞིན་ཡིན་པའི་ཕྱིར་འདུས་མབྱས་ཡིནནོ།",
    "དེ་ལ་འཇུག་པ་ཞེས་བྱ་བ་ལ་འཇིག་ཚུལ་རྣམ་པ་བཞིར་ཤེས་པར་བྱ་སྟེ།",
    "བརྟན་པ་སོགས་བཞི་པོ་དག་ལས་བཟློག་སྟེ་རིམ་པར་མི་བརྟན་པ་མཞི་བ་མི་རྟག་པ།",
    "མ་རིག་བག་ཆགས་ཀྱི་སའི་རྣམ་པར་འགྱུར་བའམ་ཁམས་རྣམ་པར་འགྱུར་བའི་ན་བ་དང་།",
    "གཞན་དོན་ཕུན་ཚོགསཁྱད་པར་བཤད།",
    "སྒྲིབ་པ་མེད་པའི་སྦྱོར་བ་ཞེས་འབད་རྩོལ་གྱི་སྒྲིབ་པ་མེད་པའི་སྦྱོར་བ་བརྟན་པ་ཞེས་གསུངས།",
    "དེ་ཡི་ཁྱད་པར་རྒྱས་པར་བཤད།",
    "སྟུག་བསྔལ་ཐམསཅད་རྒྱུ་དང་བཅས་པ་མལུས་པར་རབ་ཏུ་ཞི་བ་ཡིན་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པའི་གེགས་ཤེས་བྱའི་སྒྲིབ་པ་ཀུན་རྣམ་པར་དག་པའི་ཕྱིར་ཇི་སྙེད་པའི་དོནལ་ཐམས་ཅད་དུ་བྷེ་ཐོགས་པ་མེད་པ་དང་།",
    "གདོད་ཟས་དྲི་མ་མེད་ཅིང་རྣམ་པར་རྟོག་པ་མེད་པ་འོད་གསལ་བའི་མཚན་ཉིད་རྣམས་ཏེ།",
    "དེ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པའི་དྲི་མེད་དབྱིངས་དེ་ནི་སྒྲིབ་གཉིས་བག་ཆགས་བཅས་པའི་ཉེས་པ་པར་སྤྱངས་བའི་ཡོན་ཏན་དང་ལྡན་པའོ།",
    "ལོངས་སྐུ་ལ་ཡང་ཁྱད་པར་ལྔ།",
    "སྐྱེ་གནས་འཇིག་གསུམ་མེད་པས་འདུས་མ་བྱས་ཤིང་།",
    "འདིང་ནི་དེ་ལྔའི་མཇུག་སྡུད་ལ་སྦྱར་ཏེ་ལོངས་སྐུ་འཆད་པའི་སྐབས་འདིར་སཱ་ཚོགས་སཱང་ཡང་སོགས་ལྔར་གསུངས་ཁྱད་པར་རྐྱེན་ལས་སྣང་ཚུལ་ལོ།",
    "རྟོགས་པར་དཀའ་བས་ཟབ་པ་དང་གཞན་དོན་སྒྲུབ་པའི་མཐུ་ཞི་ཕུན་སུམཚོ་གས་པ་དང་།",
    "དེ་གསུམ་ཡོད་ཀྱང་བཞུགས་པའི་ཚེ་ཡི་འཕེན་པ་རྫོགས་ནས་བཞུགས་མི་ཞུས་སོ་ཞེ་ན།",
    "འདུས་མ་བྱས་པའི་རང་བཞིན་ཅན་གྱི་ཐུབ་པ་གདོད་ནས་སྐྱེ་འཆི་སོགས་རབ་ཞིས་སྟེ་རང་ཏུ་ཞི་བ་ཡིན་པའི་ཕྱིར་དང་མི་བསླུ་བས་རྟག་པ་ཡིན་ཏེ།",
    "རྣམ་པར་དབྱེ་བ་ལ་ཡང་གཉིས།",
