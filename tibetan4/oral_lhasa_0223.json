    "དྷཱི་མ་མེད་པ་རྣམ་པར་བྱང་བཐམསཅད་མཁྱེན་པ་དང་།",
    "དེ་ལྟར་མཁྱེན་པའི་སྟོབས་ནི་ཟླུམ་པ་བཅུའོ།",
    "འགོག་པར་བྱེད་པ་ལ་མི་འཇིགས་པ་དང་།",
    "དེ་ཉིད་དཔེ་ཡིས་ངེས་པར་བྱ།",
    "ཐུགས་རྟག་ཏུ་མཉམ་པར་བཞག་པ་བརྟན་པའི་ཡོན་ཏན་དང་།",
    "སྤང་བྱ་ཤིན་ཏུ་ཕྲ་བའང་ཐབས་པས་རྩལ་དང་ལྡན་པར་གཟས་སོ།",
    "སྔོཞོ་གཞན་སེམས་བསྲུང་བ་སོགས་གོམས་པར་བྱས་པས་ཏེང་ངེ་འཛུཞལ་རྩེ་གཅིགཏུ་མཉམ་པར་མ་བཞག་པའི་ཐུགས་མི་མངའ་བ་དང་།",
    "སྒྲིབ་པ་དང་བྲལ་བའི་རྣམ་པར་གྲོལ་བ་དང་།",
    "ཅད་ཡོད་པ་ལྟར་ན་འདུན་བརྩོན་གཅིག་ཏུ་བྱས་པའམ།",
    "ཡང་ཞྭ་རྣམ་གྲོལ་དང་རྣམ་གྲོལ་གྱི་ཡེ་ཤེས་གཅིག་ཏུ་བྱས་ལ།",
    "བཞི་པ་མཁྱེན་པས་བསྡུས་པ་གསུམ།",
    "བདག་གཞན་ཀྱང་དེ་ལྟར་འཇུག་པ་གོམས་པར་བྱས་པ་ལས།",
    "དུས་གསུམ་གྱི་ཤེས་བྱ་རྣམས་ལ་རྟག་ཏུ་ཆ་གས་པ་དང་ཐོགས་པ་མེད་པ་མཁྱེན་པ་རྒྱ་ཆེན་བ་བསམ་མི་ཁྱབ་པ་ཇི་སྙེད་པའི་དོན་ལ་འཇུག་པ་སྟེ།",
    "སྔོན་སློབ་ལམ་དུ་དམ་བཅའ་བརྟན་པར་མཛད་པས།",
    "ཞབས་མཐིལ་ལེགས་པར་མཉམ་པར་གནས་པ་དང་།",
    "སྔོན་ཡོ་བྱད་སྣ་ཚོགས་སྦྱིན་པར་བཏང་བས།",
    "དཔུང་མགོ་ལེགས་པར་ཟླུམ་ཞིང་ཕྲ་ག་པའི་ལྷུན་མཛེས་པ་དང་།",
    "སྔོན་སྒོ་གསུམ་གྱི་ལས་ཐམསཅད་ཉེས་པའི་དྲི་མས་མ་གོས་པར་སྤང་པས།",
    "སྔོན་དེ་ཤེགས་པའི་སྐུ་གཟུགས་དང་མཆོད་རྟེན་གསོས་པ་དང་།",
    "འདུས་མ་བྱས་ཤིང་ལྷུན་གྱིས་གྲུབ་པས་བརྟན་པའི་ཕྱིར་རོ།",
    "དེ་ལ་ཤེས་བྱ་ཀུན་མངོན་སུམ་དུ་མཁྱེན་པས་དྲི་བ་ཀུན་ལུང་སྟོན་ཞུས་པས་ཕས་རྒོལ་སོགས་སྐྱེ་བོ་གང་ལྔས་ཀྱང་འཇིགས་པ་མེད་པར་ནི་རྣམ་པར་གནས་པ་དང་།",
    "མེ་ཡིས་སྨིན་པར་བྱེད་པ་དང་།",
    "གཟུགས་སྐུ་མཐོང་བའི་གེགས་སྒྲིབ་པ་རྣམ་པར་དག་པ་ལས་རིང་བ་སོ་སྐྱེ་དང་ཉན་ཐོས་སོགས་དང་།",
    "ཉེ་བ་ས་བཅུའི་བྱང་སེ་མས་ཆེན་པོ་རྣམས་ལ་འཇིག་རྟེན་དང་རྒྱལ་བའི་དཀྱིལ་འཁོར་དུ་ཆུ་དྭངས་པར་ཟླ་བའི་གཟུགས་བརྙན་མཐོང་བ་དང་།",
    "ལྷུན་གྲུབ་རྒྱུན་མི་འཆད་པར་བསྟན།",
    "དེ་ཉིད་དཔེ་ཡིས་ངེས་པར་བྱ།",
    "མཐའ་ཡས་པའི་གདུལ་བྱའི་ཁམས་དང་བསམ་པ་དང་འག་ཉལ་ཐམས་ཅད་མཁྱེན་ཡང་འདི་དང་འདིའོ་ཞེས་ཟླུམ་རྒྱུད་པར་རྟོག་པ་དང་འབད་རྩོལ་མེད་པར་ལྷུཞ་གྲུབ་ཏུ་འཇུག་པ་དང་།",
    "དེ་དག་ཡོངས་སུ་འཛིན་པར་མཛད་པ་དང་།",
    "ལྷུན་གྱིས་གྲུབ་པར་འཇུག་ཅིང་།",
    "ཐུགས་མཁྱེན་བརྩེའི་ཁྱབ་པ་སྤྲིན་དང་།",
    "སླར་ཡང་བསྡུས་ཏེ་ཁྱུད་པར་བཤད།",
    "རྣམ་རྟོག་མེད་ཀྱང་གཞན་དོན་འགྲུབ་། དེ་ཉིད་ལེགས་པར་སྦྱར་ཏེ་བཤད།",
    "བརྒྱ་བྱིན་སོགས་མཐོང་བའདྲི་གཟུགས་བརྙན་གྱི་སྣང་བ་ཙམ་ཡིན་གྱི་ལྷ་སོགས་ཀྱི་དངོས་པོ་འདིར་འོང་བ་ནི་མ་ཡིན་ནོ་ཞེས་དེ་ལྟ་བུར།",
    "གདན་ལ་བཞུགས་པ་དང་ནི་མལ་དུ་མནལ་ཏེ་གཟིམས་པ་དང་།",
    "མཐོང་བ་པོ་དེ་དག་ལ་ནི་དོན་ཆེ་ནབོ་ཡོད་པར་འགྱུར་ཏེ།",
    "དེ་བཞིན་འགྲོ་བའི་སེམས་ཀྱི་ས་གཞི་མ་དད་པ་སོགས་བྲལ་བའི་གཙང་མ་ལ།",
    "དཔེ་རྣ་མས་ལས་ཀྱང་ཁྱད་པར་འཕགས།",
    "དེ་གསུམ་རིམ་པར།",
    "འདུས་བྱས་མི་རྟག་པ་དང་༏",
    "དེས་ན་སྡུག་བསྔལ་ལས་ངེས་འབྱིན་གྱིས་ཁྱད་པར་འཕགས་སོ།",
    "གལ་ཏེ་ཐོས་པའི་སྐལ་ལྡན་རྣམས་ལ་ཡང་དཔོའ་ན་སྒྲའི་ཁྱད་པར་ཡོད་དོ་ཅོག་ཐམས་ཅ་ང་ཐོབ་པའི་རྣ་བར་ཡང་།",
    "གསུམ་པ་མཁྱེན་བརྩེས་ཁྱབ་པའི་ཚུལ།",
    "རྨ་བྱུ་དང་ནི་ཡི་དྭགས་དང་རིམ་པར་བཞིན་དུ་འདྲའོ།",
    "དེ་ཡི་དོན་ཉིད་རྒྱས་པར་བཤད།",
    "འཇིག་རྟེན་དག་ན་རང་། མཚོན་ཏེ་ཤེས་པར་བྱའོ།",
    "ལྟོས་པ་མེད་པར་འཇུག་ཚུལ་ལོ།",
    "ཇི་ལྟར་ཉི་མ་འདི་ལྟར་བྱའོ་ཞེས་རྟོག་པ་མེད་པར།",
    "པདྨ་རྒྱས་པར་བྱེད་པ་དང་།",
    "ཀུ་མུཏ་ཟུམ་པར་བྱེད་པ་ལྟར།",
    "གདུལ་བྱ་མ་ཡིན་པའི་ཡིད་ཀུ་ཨུཏ་ཟུམ་པར་བྱེད་པ་ལ།",
    "འདི་ལྟར་བྱའོ་ཞེས་སྙམ་པར་རྟོག་པ་མེད་པར་འཇུག་གོ།",
    "མཐར་ལོག་སྲེད་ཅན་ལའང་འཆར་ཞིང་སྨིན་པར་མཛད་དོ།",
    "དཔེ་ལས་ཁྱད་པར་འཕགས་ཚུལ་གཉིས།",
    "འོད་ཟེར་ཕྱོགས་བཅུའི་ཞིང་ཀུན་གྱི་རྣམ་མཁའི་མཐིལ་ཁྱབ་པར་འོད་ཟེར་སྤྲོ་བ་ཉི་མ་ལ་མེད་ལ་དེར་མ་ཟད་མི་ཤེས་། པའི་མུནཔསབཀབ་པ་བསལ་ནས་ཤེས་བྱའི་དོན་གསལ་བར་སྟོནཔ་ཡང་ཡོད་པམིན་ཞིང་།",
    "རྙེད་པར་དཀའ་བས་མཚུངས་པར་བསྟན།",
    "འབད་མེད་རྟག་ཏུ་བཞུགས་ཚུལ་ཏེ།",
    "འབད་པ་མེད་པར་གཞན་པ་དག་པ་རབ་ཏུ་སྟེར་བ་ལྟར།",
    "དཔེ་ཡིས་མཚོན་ཚུལ་ཁྱད་པར་བཤད།",
    "དྲི་མས་རྣམ་པར་དག་པའི་རིན་ཆེན་ཡིད་བཞིན་ནོར་འདྲའི་གཞན་དེལྷུན་གྲུབ་ཏུ་མཛད་པའི་ཐུགས་ཀྱི་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པ་མངའ་བ་དང་།",
    "མཚུངས་ཀྱང་ཁྱད་པར་འཕགས་ཚུལ་གཉིས།",
    "གཏན་ས་པར་བྱེད་པའི་ཆ་ནས་ཡིད་བཞིན་གྱི་ནོར་བུས་ཉིན་མཚན་གཉིས་ཆའ་གཏན་དུ་མུན་པ་འཇོམས་པ་དང་འདྲ་སྟེ།",
    "གནས་བཞི་རྟོགས་པར་དཀའ་ཚུལ་དང་།",
    "འདི་ལྟར་སྦྱིན་པས་ཕུན་སུམ་ཚོགས་པའི་ལོངས་སྤྱོད་དག་ནི་སྒྲུབ་པར་བྱེད་ཅིང་།",
    "རྣམ་པ་བཞི་པོ་བསྟན་བཅོས་འདིར་ཇི་སྐད་བརྗོད་པ་འདི་ལ་བློ་ལྡན་རྣམས་ཀྱིས་རིམ་པ་བཞིན་ཐམས་ཅད་ལ་ཁྱབ་པར་ཡོད་པ་ཉིད་ལ་ཡིད་ཆེས་པའི་དད་པ་དང་།",
    "གོ་འཕང་བླན་མེད་པ་ཐོབ་པའི་སྐལ་བ་དང་ལྡན་པར་འགྱུར་རོ།",
    "དག་ཐབས་ངེས་བཟུང་བསྟེན་པར་གདམས།",
    "དྲུང་དོན་ལ་དེ་ཁོ་ན་ཉིད་དུ་ངེས་པར་འཛིན་ཅིང་ངེས་དོན་སྤྱོང་བའི་ཕྱིར་དང་།",
    "མཚམས་མེད་བྱས་ཀྱང་།",
    "དངོས་དོན་དུ་རང་གའ་ཐད་ཀའི་འགྲེལ་བར་གང་ཡོད་མཆན་དུ་བཏཧ་པ་ལྟ་བུམ་ཡིན་པར་རྒྱལ་ཚབ་ཆེན་པོ་ཉིད་ཀྱི་དགོངས་པར་གང་འབྱོར་གྱིས།",
    "ཅེས་པའི་མཛད་བྱུང་ཅན་འདི་ཉིད་ཀྱིས་ཆོག་པར་མཛད་པ་རྒྱུད་བླ་ཕྱུ་གམཆན་ཅན་གྱི་ཕྱག་དཔེ་དང་ལྷན་ཅིག་ཏུ་འདི་བཞུགས་པར་མཛད་ནས་དེའི་མཇུག་ཏུ།",
    "རྟོགས་ན་མི་ལྡོག་ཡིད་ཆེས་རྒྱལ་གསུངས་བཞིན།",
    "དེ་ཕྱིར་ཁྱེད་གསུངས་ཐོལ་མེད་དད་པས་བསྟོད།",
    "བསམ་གྱིས་མི་ཁྱབ་འདུས་མ་བྱས་པའི་དབྱིངས།",
    "ཅེས་གཞུང་བཟང་ཁྱད་འཕགས་འདི་ཉིད་སྤར་གྱི་ལས་འདུ་བགྱི་། བའི་དོ་དམ་པ་འཕགས་མཆོག་རིག་གྲོལ་གྱིས་བསྐུལ་བ་ལ་བརྟན་འཇམ་དབྱངས་མཁྱེན་རབ་མཐའ་ཡས་ཀྱིས་བྲིས་པ་དོན་དང་ལྡན་པར་གྱུར་ཅིགསརྦ་མང་ག་ལཾ་ཤུབྷཾ།",
    "ལུང་ཨངདག་ལ་འང་དྲང་ངེས་ཀྱི་ཁྱད་པར་ཡོད་པ་བསྙོན་དུ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་བསན་ཡངདག་པའི་རིགས་ལམ་དང་མཐུན་པར་སྨྲ་བ་སྐྱེ་བོ་མཁས་པའི་ཚུལ་ཡིན་ལ།",
    "ཡང་དག་པའི་རང་ལུགས་རྣམ་པར་བཞག་པགཉིས།",
