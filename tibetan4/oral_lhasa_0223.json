    "མཚན་ཉིད་དམ་རྟགས་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "འདིར་ཤེས་བཟོད་ཀྱི་ཡེ་ཤེས་སྐང་ཅིག་མ་བཅུ་དྲུག་མཐོང་ལམ་པ་ཕྱིར་མི་ལྡོག་པའི་རྟགས་སུ་གསུངས་པ་ཞི།",
    "རྗེས་ཐོབ་ཏུ་རྟགས་བཅུ་དྲུག་ཏུ་གསུངས་པ་འདི་དག་མཐོང་ལམ་གྱི་རྗེས་ལསཐོབ་པའི་འབྲས་བུར་ཁྱད་མེད་ལ།",
    "སོ་སོར་སྦྱར་བ་ནི་ལྡོག་རྨས་ཕྱེ་བའི་ཤེས་བཟོད་ཀྱི་ཡེ་ཤེས་བཅུ་དྲུག་མཚོན་པར་བྱེད་པ་ཙམ་ལས་རྒྱུ་སོ་སོས་འབྲས་བུ་སོ་སོར་བསྐྱེད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཚིག་འཇམ་པར་སྨྲ་བའི་ཁ་བསགས་དང་།",
    "སྦྱིནསོགས་འཁོར་གསུམམི་དམིགས་པར་རྟོགས་པས་སེར་སྣ་དང་།",
    "འདི་ལྟར་བསླབ་པར་བྱ།",
    "འདི་ལྟར་གྲུབ་པར་བྱའོ།",
    "ཞེས་སོགས་གསུངས་སོ།",
    "ཞི་གནས་ཀྱི་སེ་མས་དགུས་ཡང་ཡང་འཇལ་བ་དང་ལྷགམཐོང་བཞིས་ཡང་ཡང་ངེས་པར་རྟོགས་པའང་སྟེ།",
    "ཞྭ་རྫོབ་ཏུའང་སྐད་ཅིག་མར་དཔྱད་ནས་རྣམ་མཁྱེན་ཐོབ་པར་མི་རུང་བའི་རྩོ་དསྤང་གཉིས།",
    "བརྗོད་དུ་མམཆིས་པའི་དོནལ་འཕེལ་འགྲིས་མེད་ན་དེས་སྦྱིན་སོགས་འཕེལ་འགྲིབ་མེད་པར་འགྱུར་རོ།",
    "དང་པོ་བདེན་གཉིས་འགལ་བལྟ་འཛིན་པར་དེ་ལྟ་ན་ཀུན་རྫོབཏུ་ཡང་སྒོས་ལམ་གྱིས་དོན་བྱེད་མི་རུང་སྟེ།",
    "དེ་བཞི་ནག་ཤེག་པ་༥འགོག་པ་ལས་སྤོང་བའི་ཚུལ་གྱིས་རྫོགས་སྨིན་སྦྱངས་པ་མཐའ་ཕྱིན་པའི་སྟོབས་ལས་སྐྱེས་པའི་ཏིང་འཛིན་ཁྱད་པར་ཅན་བསྐྱེད་ནས།",
    "དོན་དམ་པར་དངོས་དང་དངོསམེད་སོགས་དམིགས་པསམཐོང་བར་བྱ་བརྡ་ཙམ་ཡང་མེད་པ་དེ་ནི།",
    "དེ་ཏཔཤཱལའང་གཞི་ཡེ་དབངདུ་བྱས་ཏེ་དེ་བཞིན་ཉིད་ཐམས་ཅད་ལ་ཁྱད་མེད་པར་ཡོད་ཀྱང་རྫོགས་སྨིནསྦྱངས་པ་མཐར་བྱིན་ནས་སྒྲིབ་གཉིས་མ་བྲལ་བའི་དུས་མིན་དུ་མངོན་དུ་མིབྱེད་པར་ཤེས་པ་དང་།",
    "གཏེར་དངོས་སུ་རྙེད་པར་འཛིན་མཁན་སུ་ཡང་མེད་པ་བཞིན་ནོ།",
    "བློ་ཡུལ་ལ་མ་འཁྲུལ་བའི་ཞུགས་ན་ཉིན་མཚན་གྱི་ཁྱད་པརཆི་ལ་ཡོད་ཅེས་པའི་དོན་ཏོ།",
    "དེས་མཚོན་ནས་བདེན་ཚིག་གྲུབ་ཚུལ་གཞན་ཡང་ཤེས་པར་བྱ་།",
    "༡༡ རྩེ་ཤེར་དེའི་མཐུས་པར་ཕྱིན་གྱིམི་མཐུན་ཕྱོགས་ཀྱི་སེམས་མི་སྐྱེ་བ་དང་།",
    "ཞིང་དག་སྦྱོར་སོགསཆ་འདྲ་སྔ་ཞུས་ཡོད་ཀྱང་ཡོངས་སུ་དག་པ་ཁྱད་པར་བདག་ས་ནས་ཐོབ་པས་དེར་བཞག་པ་སོགས་ཀྱི་ཚུལ་འདི་འདྲ་གོང་འོག་ཀུན་ཏུ་སྦྱར་ཏེ་ཤེས་པ་བྱའོ། ། གསུམ་པ་བརྟུན་པས་མཚོན་པ་བཟོད་པ་ནི།",
    "རྣམ་ཀུན་མཁྱེན་པ་དང་།",
    "འཕགས་པའིགང་ཟགཉན་རང་ལ་དམིགས་ནས་བཏགས་པར་འཛིན་པ་སྟེ་གཉིས་སུ་ཕྱེ་བས་བཞིར་ཡོད་ལ།",
    "བདེན་པར་མ་ཞེན་པའི་འཇུག་ལྡོག་འཛིན་པ་ཞི་རྗེས་ཐོབ་གཉིས་སུ་སྦྱང་བ་ཅན་གྱི་ངོས་ན་སྤངས་མི་དགོས་ཀྱང་།",
    "དེ་བཞིན་དུ་རྫས་བཏགས་ཀྱང་ཤེས་པར་བྱ་སྟེ།",
    "ཇི་བཞིན་ཡུལ་ཉིད་དུ་གྲུབ་པ་མིན་པའི་ཕྱི་ན་ཅི་ལོག་ཏུ་སྣང་བའི་བདག་ཉིད་དག་ཏུ་ཤེས་པར་བྱའོ།",
    "བྱ་བའི་འབྲས་བུལ་མི་རྟོག་པའི་བར་གྱིས་གསུངས་སོ།",
    "དང་པོའི་དམིགས་པར་སོ་སྐྱེ་བསྟན་པས་འཕགས་པ་ཤུགས་དང་།",
    "དོན་དུ་སྐྱེ་འཕགས་ཀྱི་གང་ཟག་ཐམས་ཅང་རྫས་སུ་ལྟ་བ་དོན་དམ་པར་བཏ་གས་པར་ཡང་མི་དམིགས་པའོ།",
    "བླང་དོར་དྭགག་སྒྲུབ་ཀྱི་རྟོག་པ་མཇའ་ཡས་པའི་ཚུལ་གྱིས་མངོན་ཞེན་དང་དམིགས་པ་མཐའ་དག་སྤང་དགོས་པར་གྱི་བསྟན་པ་ཤེས་པར་བྱ་ཞིང་།",
    "ཐམས་ཅད་ཉེ་བར་ཞི་བལ་སྤྱོད་པར་བྱ་བ་ཡིན་ནོ།",
    "འབྲས་བུ་རྣམ་མཁྱེན་མི་ཐོབ་པ་ཞི།",
    "ཤེས་བྱའི་ཁོངས་སུ་རྒྱུ་འགག་པ་དང་བཅས་པའི་འབྲས་བུ་སྐྱེ་བ་ཀུན་རྫོབ་ལ་དོན་དམ་པར་ཞེན་པའི་གང་ཟག་ལ་དང་།",
    "ལམ་གྱི་འགལ་རྐྱེན་ཕྱིར་རྒོལ་བྲོ་ཞིབ་དུད་སོ་གྲྭ་དམིགས་པ་སྟེ་ཡོད་པར་ཞེན་པའི་གང་ཟག་ལ་བཏགས་པ་ཙམ་གྱིས་ལོངས་སྤྱོད་པ་པོར་འཛིན་པའི་རྣམ་པར་རྟོག་པ་སྟེ་འདི་དགུ་པོ་སྔ་མ་རྫས་འཛིན་ལས་གཞནབཏགས་པར་འཛིན་པ་ཡིན་ནོ།",
    "གཟུང་འཛིན་གྱི་སྤྲོས་པཞི་བའི་ཡེ་ཤེས་རྣམ་པར་མི་རྟོག་པ་ཡོངས་སུ་སྨིན་པར་གྱུར་པ་ན།",
    "སོ་སྐྱེ་རྣམས་ཀྱིས་རྫསསུ་ཡོད་པའི་བདག་དེས་ཡུལ་ལ་ལོངས་སྤྱོད་པར་འཛིན་ཞིང་བདེན་ཞེན་གྱིས་འཇུག་ལྡོག་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལྟར་རྟོག་པ་སྤངས་ནས་མི་རྟོག་པ་ལ་ག་ཞས་པར་བྱའོ།",
    "དེའི་རྒྱུ་ཤེར་ཕྱིན་གཏོད་པར་གསུངས།",
    "དངོས་པོར་སྨྲ་བའི་ལུགས་དགག་ སྟོང་པར་སྨྲ་བའི་ལུ་གས་བཞག་པའོ།",
    "བློས་དྲི་མ་མེད་པར་མཐོང་ན་ནི་དྲི་མ་མེད་པར་མཐོང་བའི་བློ་ཡུལ་གྱི་གནས་ཚུལ་ལ་ཕྱིན་ཅི་ལོག་ཏུ་ཁུགས་པའི་ལོག་ཤེས་སུ་འགྱུར་བས་དེས་རར་རྒྱུད་ལྡན་གྱི་གང་ཟག་དེ་དྲག་པར་ཡང་མི་འགྱུར་ལ།",
    "དྲི་མན་ངུ་མཐོད་བའི་བློ་ནི་ཡང་དག་པའི་ཤེས་པར་འགྱུར་རོ།",
    "དེ་དང་རྗེས་སུ་མཐུན་པར།",
    "པའར་འཇོག་པར་མཛད་དོ།",
    "སྣང་སྟོང་མཉམ་པ་ཉིད་བརྗོད་དུ་མེད་པའི་དོནལ་གཉིས་སྣང་ནུབ་པའི་ཚུལ་གྱིས་མཉམ་པར་བཞག་པ་ཡིན་པའི་ཕྱིར་ཞུའོ།",
    "ཐོད་རྒྱལ་ཆུང་ངུའི་རུས་སུ་མཐར་གནས་ཀྱི་སྙོམས་འཇུག་དགུ་ལ་ལུགས་མཐུན་དུ་སྙོམས་པར་འཇུག་སྟེ།",
