    "དེར་བརྟེན་རྒྱ་དཀར་ནག་གཉིས་དབར་ཡུན་རིང་ནས་ས་མཚམས་ཀྱི་རྩོད་རྙོག་ཡོད་པ་དེ་དག་ངེས་པར་དུ་སེལ་ཐབས་བྱེད་དགོས།",
    "དེར་བརྟེན་ཞི་བའི་སྒོ་ནས་རྩོད་རྙོག་སེལ་ཐབས་གནང་དགོས།",
    "ཕྲན་བུ་བསམ་བློ་གུ་ཡངས་ཡོད་པའི་འགོ་ཁྲིད་གཅིག་ཡིན་པར་བརྟེན།",
    "ངོས་ཀྱིས་ཕྱི་ལོ་༢༡༡ལོར་བོད་མིའི་ཆབ་སྲིད་ཀྱི་ལས་འགན་ཡོངས་རྫོགས་མང་གཙོའི་ལམ་ནས་འོས་འདེམས་བྱུང་བའི་བཀའ་བློན་ཁྲི་པར་རྩིས་སྤྲོད་བྱས་ཏེ་ད་ཆ་ངོས་རང་རྒན་ཡོལ་ཆ་ཚང་ཞུས་ཟིན།",
    "སྐུ་ཚབ་རྣམ་པ་བཅས་ལ་སྣེ་ལེན་ཕེབས་བསུ་མཛད་གྲུབ་བསྟུན།",
    "ལྷན་ཚོགས་འདིར་ཆེད་ཕེབས་གནང་བར་ཡི་རང་བསྔགས་བརྗོད་དང་བཀའ་དྲིན་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "འོན་ཀྱང་དམིགས་ཡུལ་བདེ་བ་འདོད་མཁན་གཅིག་མཚུངས་ཡིན་པར་བརྟེན།",
    "བསམ་བློ་རྒྱ་ཆེ་ས་ནས་བཏང་སྟེ་འཛམ་གླིང་ཞི་བདེའི་ཆེད་ཕྱག་ལས་གནང་དགོས།",
    "འཛམ་གླིང་ནང་ལྟ་གྲུབ་འདི་ཁྱབ་སྤེལ་གཏོང་ཐབས་གནང་དགོས།",
    "དེ་རིང་ལྷན་ཚོགས་མཇུག་སྒྲིལ་ཐོག་ཕེབས་པའི་རྣམ་པ་ལྷན་རྒྱས་ལ་སླར་ཡང་འཚམས་འདྲི་ཞུ་རྒྱུ་ཡིན།",
    "ལྟ་གྲུབ་ཀྱི་ཁྱད་པར་ལ་གུས་བཀུར་ཞུས་པ་དང་ཆབས་ཅིག་ཕྱི་གསལ་ནང་གསལ་གནང་སྟེ།",
    "འཛམ་གླིང་ཞི་བདེའི་སླད་འགན་ཁུར་སྔར་ལྷག་ཤུགས་ཆེ་ཙམ་བཞེས་རོགས་གནང་བརྗོད་རྒྱུ་ཡིན།",
    "འཛམ་གླིང་འདིའི་ཐོག་མིག་དཔེ་བཟང་པོ་ཞིག་བསྐྲུན་ཐབས་གནང་རོགས་ཞུ་བཞིན་ཡོད།",
    "གཞུང་འབྲེལ་མིན་པའི་ཚོགས་པའི་སྐུ་ཚབ་རྣམས་ཀྱིས་ཕེབས་བསུ་གཟབ་རྒྱས་ཞུས་ཡོད།",
    "དེ་ནས་ཆིབས་འགྲོ་བརྒྱུད་བཞུགས་སྒར་དུ་ཆིབས་སྒྱུར་བསྐྱངས་སྐབས།",
    "རྡ་སའི་མི་མང་སོགས་ཀྱིས་ལག་ཏུ་དཀར་གཙང་མཇལ་དར་དང་བདུག་སྤོས་ཐོགས་ཏེ་ཕེབས་བསུ་དང་།",
    "ལྷག་པར་དེང་སྐབས་འཛམ་གླིང་འདིའི་ནང་ཆ་མཚོན་ན།",
    "ཅེས་བཀའ་ཕེབས་ཡོད།",
    "བསམ་བློའི་ནང་དགྲ་དང་གཉེན་ཞེས་ཧ་ཅང་ཤུགས་ཆེན་པོ་འཛིན་བཞིན་པ་དེ་ཤུགས་ཆུང་དུ་གཏོང་རྒྱུར་ཁྱད་པར་ཡོད།",
    "གཞན་ཕན་བསྒྲུབ་རྒྱུའི་བློ་མེད་པར་བསྡད་ན།",
    "ལྷག་པར་འཇིག་རྟེན་བཀོད་པ་པོར་ཡིད་ཆེས་བྱེད་མཁན་གྱི་གང་ཟག་ཅིག་ཡིན་ན།",
    "ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་ལྕམ་སྐུ་ཇོ་ཌི་ཝིལེ་ཡེམ་སི་མཆོག་དང་།",
    "དེ་རིང་ཆེད་དུ་ཕེབས་པའི་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་ལྕམ་ཤི་རི་ཨི་བྷ་ཌི་མཆོག་དང་།",
    "བཀའ་ཤག་ནས་ཆེད་མངགས་འདི་ཉིན་དུས་དྲན་སྲུང་བརྩི་ཞུས་ན་འོས་འཚམ་ཞིག་ཆགས་ཡོད།",
    "དེ་བཞིན་འདིར་ཕེབས་པའི་ལྕམ་སྐུ་ཤི་རི་ཨི་བྷ་ཌི་མཆོག་དང་ལྕམ་སྐུ་ཇོ་ཌི་ཝི་ལི་ཡམ་སི་མཆོག་རྣམ་གཉིས་ནི་འཛམ་གླིང་ནང་ཆེས་སྙན་གྲགས་ཆེ་བའི་མི་སྣ་ཞིག་ཡིན་པ་མ་ཟད།",
    "ཁོང་རྣམ་པ་ཡང་བཅར་གྱི་མིན་ཞེས་གསུངས་ཡོད།",
    "འདི་ལྟར་ཡོང་ཆེད་ཁོང་རྣམ་པ་གཉིས་ཀྱིས་ཐུགས་འགན་ཆེན་པོ་བཞེས་ཡོད།",
    "ལྷག་པར་ཆབ་སྲིད་བཙོན་པ་ཚོར་རྒྱབ་སྐྱོར་ཤུགས་ཆེ་གནང་བར་བརྟེན།",
    "ལྷག་པར་ཁོང་ལ་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་ཕུལ་དགོས་དོན་ནི།",
    "མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ནས་ས་འོག་འབར་རྫས་མཚམས་འཇོག་བྱེད་དགོས་པ་ཆགས་པ་དེ་བྱས་རྗེས་ཆེན་པོ་ཞིག་ལ་ངོས་འཛིན་གནང་སྟེ།",
    "ཐེངས་འདིར་བཀའ་ཤག་ངོས་ནས་ཁོང་རྣམ་པ་གཉིས་གདན་ཞུས་ལྟར་ཆེད་ཕེབས་གནང་བར་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "དེ་བཞིན་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་ལྕམ་སྐུ་ཇོ་ཌི་ཝི་ལི་ཡམ་སི་མཆོག་དང་།",
    "ཤི་རིན་ཨི་བྷ་ཌི་མཆོག་རྣམ་གཉིས་ཀྱི་བྱས་རྗེས་ཆ་ཚང་ཞིག་སྙན་སྒྲོན་དང་ཆབས་ཅིག་དེ་རིང་འདིར་ཕེབས་པའི་དགའ་བསུའི་འཚམས་འདྲི་ཆ་ཚང་ཞིག་གསུངས་གྲུབ་པར་བརྟེན་བསྐྱར་ལྡབ་ཞུས་ཀྱི་མིན།",
    "འདི་ལྟ་བུའི་རླབས་ཆེན་གྱི་བྱས་རྗེས་ལ་བརྟེན་ནས་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་ཐོབ་ཡོད།",
    "ཁོང་རྣམ་པ་གཉིས་དེ་རིང་འདིར་ཕེབས་ཐུབ་པ་བྱུང་ཡོད།",
    "སྔར་ལས་ལྷག་པའི་འབད་བརྩོན་གནང་དགོས་པའི་དུས་སྐབས་ཤིག་ཏུའང་བསླེབས་ཡོད།",
    "དེ་རིང་མཛད་སྒོ་འདི་ལྟ་བུར་མགྲོན་འབོད་གནང་བར།",
    "ཁྱེད་རྣམ་པས་ང་ལ་མཛའ་བརྩེ་ཆེན་པོས་སྣེ་ལེན་གནང་བར་བཀའ་དྲིན་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "ད་ལྟ་ཁྱེད་རྣམས་བཙན་བྱོལ་བའི་གནས་སྟངས་ཐོག་དཀའ་ངལ་མང་པོར་གདོང་ལེན་གནང་དགོས་པ་ཆགས་ཡོད།",
    "ནམ་ཞིག་ཉི་མ་འཆར་ངེས་ཡིན་པ་ང་ལ་ཡིད་ཆེས་གཙང་མ་ཡོད།",
    "ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མཁན་རྒྱ་རིགས་ལིའུ་ཞའོ་པོ་མཆོག་ཀྱང་མགྱོགས་མྱུར་བཙོན་བཀྲོལ་གཏོང་རོགས་ཞུ་རྒྱུ་ཡིན།",
    "ཕྱི་ལོ་༢༥ལོར་ང་ལ་མགྲོན་འབོད་གནང་བ་ལྟར་རྒྱ་གར་གྲོས་ཚོགས་ནང་བཅར་རྒྱུ་བྱུང་།",
    "དེ་རྗེས་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་སྐྱེས་པ་ཚོས་ཀྱང་རྒྱབ་སྐྱོར་གནང་བར་བརྟེན།",
    "དེ་རིང་འདིར་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན།",
    "ལོ་མང་རིང་ནས་ངོ་ཤེས་གྲོགས་པོ་བློ་འཁེལ་བ་དང་བདེན་དོན་ལ་མཐའ་གཅིག་ཏུ་རྒྱབ་སྐྱོར་གནང་མཁན་ཁོང་རྣམ་པ་གཉིས་ཀྱིས་གཙོས་བོད་མིའི་སྒྲིག་འཛུགས་ནང་ཕྱག་ལས་གནང་མཁན་རྣམ་པ་དང་།",
    "འཚེ་བ་མེད་པའི་ལམ་ལ་ཕེབས་རྒྱུ་དེ་རིགས་ཁ་ཤས་ཀྱི་གཱན་དྷིར་ནུས་པ་མེད་པ་དང་།",
    "ནེལ་སོན་མཱན་ཌེ་ལ་དང་མར་ཊིན་ལུ་ཐར་ཀིང་ཡང་གཱན་དྷིའི་རྗེས་སུ་འབྲང་ནས་ཕེབས་ཡོད།",
    "རས་གོས་བཞེས་ཏེ་དམར་ཧྲེང་ལྟ་བུ་བཞུགས་ཚེ་འདྲ་ཆགས་པོ་ཨེ་ཡོད་ན་བསམ་པ་ངོས་ཀྱིས་དྲན་མྱོང་།",
    "ཇི་ཙམ་འདོད་ཆུང་ཆོག་ཤེས་དང་ཉམ་ཆུང་བྱས་ན།",
    "འདོད་ཆུང་ཆོག་ཤེས་བྱས་ནས་སྤྱི་སེམས་འཁུར་ཏེ་སྤྱི་ཕན་ཞབས་འདེགས་སྒྲུབ་མཁན་རིགས་དེ་གདོང་དང་མིག་ལྟ་སྟངས་རང་བཞིན་གྱིས་སེམས་བག་ཕེབས་ཡོད་པ་མ་ཟད།",
    "ངོས་རང་ལྷ་སར་ཡོད་སྐབས་གཱན་དྷི་རྨི་ལམ་ནང་བཏང་མྱོང་།",
    "ཞེ་ས་མ་བྱས་ན་ཉམ་ཆུང་མགོན་མེད་ལ་ཐུབ་ཚོད་ལྟ་བུ་ཆགས་ཀྱི་ཡོད།",
    "བསམ་བློ་ཧ་ཅང་གུ་ཡངས་པོ་དང་རྒྱ་ཆེ་རུ་འགྲོ་བའི་ཁྱད་པར་ཡོད།",
    "ངོས་ཀྱིས་ཀྲོག་ཀྲོག་རྩ་བ་ནས་མ་བྱས་པར་ཉམ་ཆུང་བྱེད་བཞིན་ཡོད།",
    "བོད་པར་ལྷན་སྐྱེས་ཀྱི་རྣམ་དཔྱོད་ནུས་པ་ཞིག་ཡོད་པའི་ཐོག་རིགས་ལམ་གྱི་སློབ་སྦྱོང་སྤྲོད་ཐུབ་པ་བྱུང་ན།",
    "དེ་ནས་ནོ་བེལ་ཞི་བདེའི་གཟེངས་རྟགས་བཞེས་མྱོང་མཁན་ལྕམ་སྐུ་ཇོ་ཌི་ཝིལེ་ཡེམ་སི་མཆོག་དང་།",
    "ཅེས་པའི་སྐད་ཆ་མིན་པར།",
    "ཕན་པའི་བསམ་བློ་ནི་ངེས་པར་དུ་དགོས་པ་ཞིག་ཆགས་ཡོད།",
    "ལག་ལེན་གྱི་སྐབས་སུ་དེ་ཟློག་པ་རིམ་པ་དང་པོ་བྱས་རྗེས་བར་དུ་བདག་ནི་ཟློག་པར་བྱེད།",
    "བསམ་པ་ཇི་མ་ཇི་བཞིན་ཤེས་པར་བར་དུ་གཅོད་པའི་ཤེས་སྒྲིབ་སྤངས་དགོས་པ་ཡིན།",
    "དེ་ནས་ལོ་གནངས་འཆར་ཐེ་ཝན་ལ་ཡོང་རྒྱུའི་འཆར་གཞི་བསྒྲིགས་པ་ཡིན།",
    "ཐེ་ཝན་གཞུང་ནས་ཡོང་ཆོག་པའི་བཀའ་འཁྲོལ་མ་གནང་བར་ངོས་རང་ཡོང་ཐབས་མེད།",
    "དེ་རྗེས་གཅིག་བྱས་ན་ལྷན་ཚོགས་འདི་རྒྱལ་ཁབ་གཞན་ཞིག་ནང་འཚོགས་སྲིད་པའི་གནས་སྟངས་ཤིག་མཐོང་སྟེ།",
    "བོད་པར་མི་འབོར་ས་ཡ་དྲུག་རྩིས་ཀྱི་ཡོད།",
    "འདས་པའི་ལོ་གསུམ་གྱི་རིང་བོད་མིའི་གཞིས་ཆགས་མང་ཆེ་བར་སྐོར་སྐྱོད་བྱས་ཟིན།",
    "དེ་ཚོར་དབྱེ་འབྱེད་བྱས་མེད།",
    "ལྷག་པར་གང་སྦྱང་པའི་སློབ་སྦྱོང་དེ་བེད་སྤྱོད་ལོག་པར་མ་འགྲོ་བ་བྱེད་དགོས།",
    "དེ་ནས་སློབ་ཕྲུག་ཚོས་རུ་སྒྲིག་དང་རིག་གཞུང་འཁྲབ་སྟོན་གནང་གྲུབ་མཚམས།",
    "ཁ་འཐོར་མི་མང་བཅས་ལ་ཐུག་འཕྲད་གནང་སྟེ།",
    "བོད་མི་མང་སྤྱི་འཐུས་ལྷན་ཚོགས་ཀྱི་ལས་དོན་གནང་ཕྱོགས་སྐོར་དང་།",
    "བོད་དོན་ལ་དོ་སྣང་ཅན་གྱི་གསར་ཤོག་ཀློག་པ་པོས་མཁྱེན་རྟོགས་སླད་རྒྱ་ཡིག་ནས་བོད་བསྒྱུར་ཞུས་ཡོད་པ་དེ་དོན་དགོངས་འཇགས་ཞུ།",
    "ཁུངས་ལུང་མེད་པར་གཞན་གྱི་འཕྱ་སྨོད་བྱེད་ཡུལ་ཞིག་ཏུ་གྱུར་ཡོད།",
    "གསེར་འབུམ་དཀྲུག་འདོན་གྱི་བྱ་ཐབས་སྤྱད་ཆོག་ལ་ཡང་གསེར་འབུམ་དཀྲུག་འདོན་མ་བྱས་རུང་འགྲིགས་ཀྱི་ཡོད།",
    "རྒྱ་དམར་གཞུང་དེ་མ་ཐག་ངར་ལངས་ཏེ་ལམ་ལུགས་རྙིང་པར་སྲུང་སྐྱོབ་བྱེད་གང་ཐུབ་བྱས་ཏེ།",
    "རྒྱུན་སྲིང་ཐུབ་པར་རོགས་ཕན་འོང་སྲིད།",
    "ཕྱི་ཕྱོགས་ནས་དབྱེ་འབྱེད་ངོས་འཛིན་ཞིག་ཏན་ཏན་ཡོང་ངེས་པ་ཞིག་ཡིན་ནོ།",
    "དེ་བཞིན་རིམ་པས་དེ་ལྟའི་ནོར་བཅོས་བྱ་དགོས་ཀྱིས་ལས་རྙོག་མེད་པ་བཟོ་ཐབས་སུ་དཔལ་ལྡན་བཀའ་ཤག་ནས་དགོངས་བཞེས་ཀྱིས་ཕྱི་ལོ་༢༡༤ཟླ་༡༢ཚེས་༡ནས་བཟུང་སོ་སོའི་མིང་དང་།",
    "ཐམས་ཅད་མཁྱེན་ཅེས་གྲགས་པ་དོན་ལྡན་པའི།",
    "སྣང་བར་དངོས་བརྟགས་ཞིང་སྐུའི་སྤྲིན་ཆེན་རྒྱ་མཚོར་སྙོམས་པར་རོལ་ཞིང་ལྡང་བ་དང་།",
    "བྱམས་པས་ཡོངས་བགོས་ནུས་རྟོགས་སྐྱེ་བ་དཔག་དཀའི་ཁྱད་པར་སླར་བཟུང་སྟེ།",
    "མཛེས་བྱེད་མཁྱེན་བརྩེ་མེ་ཤེལ་ཕྲེང་དེ་སྙེད།",
    "རྒྱལ་མཛད་ཕན་མཚུངས་ཉི་དང་འོད་ལྡན་མཁྱེན།",
    "མཁྱེན་ལྡན་ཉི་དང་འོད་མཚུངས་ཕན་མཛད་རྒྱལ།",
    "བསམ་ཡས་བྲལ་འབྲས་མཁའ་ཁྱབ་ཀ་ན་ཀ་གཙང་བདག་རྟག་པ་དམ་པར་སྣང་བར་བྱས།",
    "སྤྲོས་པའི་འདུ་འགོད་རྣམ་པར་གནས་པ་མེད།",
    "བདག་མེད་ལྷག་བསམ་མཁའ་དང་མཉམ་པར་གཟུང་།",
    "མུན་པར་དུབ་ལས་ཉེས་བྱས་ཇི་སྙེད་པ།",
    "ཡན་ལག་ཀུནྡའི་ཚལ་བརྒྱ་བརླན་པར་བགྱི།",
    "རྣམ་དཀར་འཁོར་ལོ་རྟག་ཏུ་བསྐོར་ལགས་གྲངས།",
    "ལྟ་སྤྱོད་འབྲས་བཅས་ཡོངས་སུ་དག་པར་གསོལ།",
    "ཚངས་དབྱངས་ཡན་ལག་བཅུ་གཉིས་བསྙད་པར་ངེས།",
    "ས་ལ་མཁྱེན་ནུས་བརྩེ་བ་མཚུངས་མེད་པས།",
    "སྣང་སེམས་ཨེ་ཝཾ་ཕྱག་རྒྱས་བསྡོམས་པར་མཚོན།",
