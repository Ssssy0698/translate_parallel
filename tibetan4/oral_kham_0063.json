    "ཡོན་ཏན་སྤུས་གཙང་བ་ཞིག་འདུག་པ་ལ་མངོན་སྤྱོད་དྲག་ལས་ལ་བློ་གཞོལ་བ་འདི་ཕུགས་རང་ཉིད་ལ་གྱོང་ཆེན་པོར་འགྲོ་ཉེན་ཡོད་སྙམ་པ་ཡང་བྱུང་།",
    "ཁང་པ་བསྒྱེལ་བའི་ཚུལ་བྱེད་ཀྱིན་འདུག།",
    "ཕྱི་ལོན་གྱི་ཚུལ་དུ་ཡོང་ལུགས་འདི་བཞིན་འདུག་པས།",
    "ནམ་ཐོ་རངས་ཙ་ན་ཧཱི་ཧི་ཟེར་བའི་སྒྲ་ཆེན་པོ་གཅིག་དང་པོ་ཐོག་མ་ཕ་ཚད་ན་ཡོད་སྙམ་པ་ལ།",
    "བར་ཆད་མ་བྱུང་ན་འགྲོ་དོན་ནི་ཅི་རིགས་པ་ཡོང་བ་འདུག་སྨྲས་པས།",
    "སྔར་མཚན་གྲགས་དེ་བྱུང་ཕྱིན་འགྲོ་དོན་ཡོང་ན་དེ་ཆོག་པར་འདུག་གསུངས།",
    "འདི་སྐབས་སྣ་དཀར་རྩེར་དུས་རིམ་ཐོག་ཏུ་འབྱོར་བའི་སྔགས་པ་རྣམས་ཀྱིས་འཚམས་སོགས་ཟིང་ཟིང་མང་པོ་འདུག།",
    "སྐུ་སྐྱེ་གཉིས་པའི་ཚུལ་དེ་དབོན་པོ་ཞུ་ཚང་རི་ཤིང་པའི་ཞལ་ངོ་དྲང་སྲོང་འདི་ཡིན་ཟེར་བར་འདུག་པས།",
    "འདུག་ལྟ་བ་དང་།",
    "ལོ་འདི་ལ་བྱང་ཞབས་དྲུང་རང་ལ་བཅུར་ཐག་ཅུང་ཟད་བྱུང་བ་ནི།",
    "སླར་དཀོན་ལེགས་པ་རང་ལ་ཡང་དཀའ་སྐྱོན་གྱི་སྒོ་འདུག་པ་དང་།",
    "དགོས་པ་རང་ནི་ཅང་མི་གདའ།",
    "མཚན་བརྗོད་འདོན་གྱིན་འདུག་པས།",
    "ཁོང་རང་དཔོན་སློབ་ལ་འཕྲིན་ལས་ཀྱི་བར་ཆད་ཡོང་བའི་ལྟས་སུ་གོ།",
    "དུས་འཁོར་གྱི་ཚོགས་མཆོད་མཛད་པའི་སྲོལ་བར་སྐབས་ནས་འཆད་འདུག་ག་ནག་པའི་བཅོ་ལྔ་སྒྲུབ་མཆོད་དངོས་གཞིའི་ཉིན།",
    "ཕྱིས་དེ་ངོར་དང་རས་ཆུང་ཕུག་པ་ལྟ་བར་འདུག།",
    "ཁ་བསྐོང་རྒྱས་བསྡུས་གཉིས་འདུག་པས།",
    "དེའི་དབུས་ན་ལྷ་ཁང་གཅིག་འདུག་པ་དེར་ཞུགས་དེ་ཕྱིན་པས།",
    "ཁོང་རྣམས་ཆོ་ག་བྱེད་ཀྱི་འདུག།",
    "ཞེས་དཀྱིལ་འཁོར་འབྲི་བའི་གནས་བསྟན་པར་འདུག་པས།",
    "སྐབས་དེར་སྔ་སོར་གཉེར་བ་ཀུན་དགའ་བཀྲ་ཤིས་ལ་གཏམ་སྨྲས་པ་དེ་འཛམ་ཐང་དུ་སླེབས་འདུག་པས།",
    "ཀ་བ་སུམ་ཅུ་སོ་བཞི་པོ་ཐམས་ཅད་ཚ་བཞེས་གྲོལ་ནས་ཉི་མ་ཕྱེད་ཟུར་ཡན་ལ་ཚུགས་འདུག།",
    "སྣེ་ཕྱོགས་གཅིག་མར་ལྷུང་འདུག་ཀྱང་།",
    "ཤིང་གཤོག་པ་ལྟ་བུའི་སྒྲ་སོགས་ཐམས་ཅད་ལས་ཀ་ལ་ལངས་འདུག་སྙམ་པ་ལ།",
    "ཡོང་རྒྱུར་གདའ།",
    "དེ་ནས་བསམ་གྲུབ་རྩེར་སླེབ་དུས་སྐུ་མཚམས་པ་ཙམ་གནང་འདུག་སླེབས་ཉིན་ནས་བཟུང་སྟེ།",
    "སྐུ་དོག་ཡོད་པའི་ལྟས་རང་ནི་མིན་པ་འདུག།",
    "ཕྱོགས་དེ་སྔར་ལུགས་ཀྱི་འཛོམས་ཆ་ཆེན་པོ་བག་དྲོ་བ་དེ་ནི་མི་གདའ།",
    "སྐུ་སྐྱེ་བཅུ་བཞིའི་ཞལ་ཐང་གསར་བཞེངས་བཟང་པོ་མཛད་འདུག་པ་ལ་རབ་གནས་རྒྱས་པ་བྱས་དེ་ནས་བསམ་སྡིངས་སུ་ཞག་པོ་གསུམ་པ་ཞིག་བསྡད་དེ།",
    "གང་ཡིན་ངོ་ཤེས་པ་ནི་གཞན་མི་འདུག་གོ།",
    "དེ་རྗེས་འགྱངས་ཆེན་མེད་པར་རྗེ་འཇམ་གྲགས་པ་ཞུ་བའི་འབྲུག་པའི་དབུ་ཆེ་ཞིག་ཡོང་འདུག་པའང་།",
    "སློབ་བརྒྱུད་ཚོས་གོ་ནི་ད་དུང་མ་གོ་བར་གདའ།",
    "ཕྱོགས་གཞན་གྱི་ཀླུ་འགའ་ཞིག་འདིར་འོངས་པའི་རྟགས་སུ་ནི་གདའ།",
    "ལམ་རིམ་གྱི་གྲུབ་འབྲས་བྱངས་བྱང་ལུགས་ཀྱི་སེམས་བསྐྱེད་ཆེན་པོ་དེ་མཛད་པ་སྔ་སྲོལ་དུ་འདུག་པ་བཞིན་བྱས།",
    "ཀྱེ་རྡོ་རྗེའི་འགྲེལ་པ་རྡོ་རྗེའི་ཚིག་བསྡུས་གཉིས་ཀའི་རྒྱ་དཔེ་འདུག་སྟེ།",
    "སྔ་མ་ལ་མཛད་བྱང་ནཱ་རོ་པའི་མཚན་འབྱར་བ་དེ་ཀ་འདུག།",
    "ཟེར་བ་འདུག་ཀྱང་རྒྱ་དཔེ་འདི་ན་སྙན་གྲགས་བཟང་པོའི་སྐད་དོད་ལ་ཡ་ཤོ་བྷ་དྲ་ཞེས་པ་མེད་པར།",
    "དཔང་ལོས་འགྱུར་བཅོས་མཛད་པ་ལ་ཡང་དེ་བཞིན་དུ་འདུག་ཀྱང་།",
    "ཅུང་ཟད་ཟི་བ་ཡང་ཡང་ཡོང་བ་ཞིག་བྱུང་འདུག།",
    "དོན་ལ་ཡང་གོ་བབས་ཤིན་ཏུ་བཟང་བའི་ཐུགས་རབ་ཁྱད་པར་ཅན་རང་ཡིན་པར་འདུག།",
    "དེའི་ནང་ན་བཤེས་འཕྲིན་ཡོངས་རྫོགས་ཀྱང་འདུག།",
    "སྔར་གྱི་འགྲེལ་པ་ཐམས་ཅད་ནི་བསྡུས་དོན་སྣ་ཟིང་སྤུ་ཟིང་ལས་ལམ་རིམ་རྐང་ཚུགས་མི་འདུག་པ་ལ།",
    "ཙནྡྲ་ཤིང་རྒྱལ་པོས་དུང་བཟང་པོ་གཅིག་ངེད་ལ་བསྐུར་གདའ།",
    "ཁོང་རང་དཔོན་སློབ་ཀྱི་འཕྲིན་ལས་ལ་བར་ཆད་ཀྱི་ལྟས་དུ་མ་མཐོང་སེལ་ཐབས་བྱས་ན་བར་ཆད་དེ་སེལ་བ་དཀའ་ལས་མི་འདུག་སྟེ།",
    "ཁོང་དཔོན་སློབ་ཚོ་རང་དགོས་དོན་མེད་པའི་འགྲན་ཟླའི་ཁུངས་རང་འདུག་པས།",
    "བཅོལ་གཏོགས་མེད་པ་དེ་བཞག་པ་རང་ལེགས་པ་འདུག།",
    "ལར་མི་འདི་རྣམས་ལ་ཕན་ཐོགས་བྱུང་ཚད་དེ་འཕྲལ་བརྗེད་འགྲོ་བར་འདུག།",
    "ཨོཾ་གཉིས་མ་མ་དག་ལོ་པཎ་ཡོན་ལ་མ་མགུ་བར་སྔགས་ཀྱི་གུང་ནས་བཅད་པ་ཡིན་ཟེར་བ་ཁོ་ན་འདུག་པ་ཡང་།",
    "འདི་དངོས་ནང་པའི་གཞུང་རང་ནི་མིན་པ་འདུག་ནའང་།",
    "བྱ་བ་ལ་སོགས་པ་འདུག་པ་ལ།",
    "ཁོང་རང་ཡང་མགུ་བས་རྒྱ་གར་དུ་ཐེགས།",
    "དང་པོའི་བརྣག་པ་ཞིག་ཐུགས་ལ་ཡོད་པ་ལོས་ཡིན།",
    "མགོན་པོའི་བཞུགས་ས་བྱེད་རྒྱུ་ཡིན་བྱས་པ་ཙམ་གྱི་བདག་བྱེད་པར་འདུག།",
    "ལོ་སྔ་མ་གསུམ་གཞུང་དང་མཆོད་བཞིས་གཉིས་ཀར་ལོག་ནས་བྱས་པ་དང་གྲུབ་ཆེ་ཆུང་རང་ཁྱད་ཆེན་མ་བྱུང་།",
    "དེ་རྫུན་མ་ཡིན་པར་བདེན་པར་འདུག་ངོ་མཚར་ཆེ་ཟེར།",
    "སྤྱིར་སྐུ་རིམ་རྒྱ་ཆེ་བ་གནང་འདུག།",
    "གཅིག་འདུག།",
    "གཡོན་ན་དེ་ཙམ་དམར་པོ་ཞིག་འདུག།",
    "དཀར་པོ་དེའི་ཡང་གཡས་ན་སེར་པོ་ཞིག་འདུག་བྱམས་པ་ཡིན་སྙམ།",
    "གཡོན་རང་ན་སྔོན་པོ་ཞིག་འདུག་པ་དེ།",
    "ང་འཕགས་པ་ཀུན་ཏུ་བཟང་པོ་ག་ན་བཞུགས་སྙམ་ཙ་ན།",
    "ཡི་དམ་མཐོང་ཡང་ནམ་མཁའི་འཇའ་ཚོན་གྱི་ཚུལ་དུ་འདུག།",
    "རོ་མཉམ་གཅིག་ལ་ཁྱད་པར་གང་ཡང་མི་འདུག་ཀྱང་།",
