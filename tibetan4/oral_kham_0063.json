    "ཆུ་རྒྱས་པས་འཛའ་འཕྲང་ཛོ་འཕྲང་ལ་མི་ཐར་བ་འདུག་པས།",
    "ས་ཕྱོགས་དེ་གྲུབ་པའི་བསྟི་གནས་སུ་འདུག་པས་གུས་པ་ཆེན་པོས་ཕྱག་དང་སྐོར་བ་ཞིག་བྱས་དར་ལྕོག་ཅིག་བཙུགས།",
    "དེ་ནས་མར་ལམ་སྟག་ཚེར་གྱི་གོང་ཙམ་དེར་ཡུར་བ་ཞིག་ན་འོད་འཚེར་བ་འདུག་པས་མགྱོགས་པོར་ཕྱིན་ནས་བླངས་ཙ་ན།",
    "ཁོང་པ་རང་ངེད་ལ་འཕྲད་པར་ཕེབས་པ་ཡང་ཡིན་པར་འདུག།",
    "སླར་ཡང་ཞུ་ནན་ཆེས་ན་ཐུགས་ལོག་པའི་རྒྱུད་འགྲོ་བ་འདུག་པས་བཀའ་བཞིན་མི་སྒྲུབ་མཐུ་མེད་བྱུང་ཞིང་།",
    "གཞི་རྒྱང་སོགས་ཀྱི་དཔུང་ཆེན་ཐམས་ཅད་འདུག།",
    "དེ་ནས་ནམ་ལངས་ཀྱི་བར་དུ་རིག་པ་དྭངས་ཤིང་ལུས་སེམས་བདེ་ཆམ་མེ་འདུག།",
    "འདི་སྐབས་ཙ་ན་ལེགས་སྦྱར་གྱི་སྐད་ཀྱང་མང་རབ་ཤེས་ཤིང་།",
    "དེ་ཡང་ཡིན་ནི་གཉིས་ཐད་ནས་ཕྱིའི་མཛེས་ཁྲིགས་ཙམ་གྱི་ཚུལ་ཀ་ཡིན་ཁོག་པ་ལོང་མཉམ་དུ་གདའ།",
    "ཕྱི་ལྟར་དུ་སྐུ་རིམ་ཡིན་པའི་ཁུངས་འདུག་ནའང་།",
    "ངོ་བོ་ནི་བདག་པོ་ནམ་མཁའ་རྒྱལ་པོའི་དགོངས་རྫོགས་སུ་འདུག།",
    "མཁའ་འགྲོས་ལུང་བསྟན་པའི་གསལ་སྣང་ཁྱད་པར་ཅན་བྱུང་བར་འདུག།",
    "ཅི་མཛད་པ་ཡིན་དྲིས་པས་བསང་དུད་འདི་བཏང་བས་སྔར་ཡང་བློ་བདེ་བའི་སྐྱེད་ཚལ་འདིའི་ཤིང་འདི་ཙམ་བསྐམས་པ་ཡིན་ཟེར་བྱེད་ཙམ་བསྐམས་འདུག་པ་རྨིས།",
    "འདི་སྐབས་སྦས་སྐུངས་བཏོན་པར་གདའ།",
    "དེའི་ཕྱི་ཉིན་དཀྱིལ་འཁོར་དེ་དང་ཆོ་གའི་རྣམ་སྤྱི་བློ་ལ་གསལ་སེང་ངེ་མ་བརྗེད་པར་འདུག་པས་སློབ་དཔོན་དམ་པ་སོགས་མཚམས་འོག་ཡོད་པ་རྣམས་ལ་གླེང་བསླངས་བྱུང་།",
    "བདག་པོ་མ་ཆེན་དྲུང་རྩེ་ཆེན་དུ་བུ་གཏེར་ཕེབས་དགོས་སོགས་ནས་སྐུ་གྲིབ་ཀྱི་རྣམ་པ་དང་ཐུགས་ལའང་བདེ་དོག་མཐོ་དམན་ཆེ་བ་རང་འདུག་པ་དང་།",
    "རྩེ་ཆེན་དབོན་པོ་བ་ལ་ཞུས་ན་ཡོང་ཕེབས་ཀྱིན་འདུག་པས།",
    "ཡར་ལམ་འཚེད་དུ་མཇལ་འདོད་ཡིན་ཡང་སྐུ་མཚམས་དམ་པོ་གནང་འདུག་པས་མཇལ་མ་ཐུབ།",
    "དེ་སྐབས་དཔོན་གཉེར་ཡང་ཐེགས་འདུག།",
    "ཁྱད་པར་སྨོན་འགྲོ་ནས་དཔོན་ས་ཡེ་ཤེས་དྲུང་རང་ལ་སྒེར་དུ་སྦྱོར་གཏོད་ཞུས་པའི་ལེགས་སློབ་ཉེས་སུབ་མགོ་འདོན་གནང་དགོས་ཚུལ་ཞུས་ནས་ཕྱིན་པ་ཡིན་ནའང་།",
    "དེ་མཚམས་སྨོན་འགྲོ་རང་ནས་མགོ་འདོན་དགོས་རྒྱུར་འདུག་ནའང་།",
    "ཕྱི་ནས་དགྲ་བྱུང་བ་སོགས་གང་ལའང་ཁུར་མི་འཁྱེར་བར་འདུག་པས།",
    "དེ་ལོ་ཇོ་ནང་དུ་རྫ་ཤར་པ་དང་གླིང་པ་ཟིངས་ཆེ་བ་བྱུང་བས་དུས་ཁྲིད་ཆག་འདུག་པ་ནས།",
    "ཕྱིན་ཆད་མཇལ་བར་དཀའ་བ་འདུག་སྙམ་པའི་ཡིད་སྐྱོ་སང་ངེ་བ་ཡང་ཡང་བྱུང་།",
    "ཕྱག་གསུམ་འཚལ་ནས་མདུན་ན་བསྡད་འདུག།",
    "སྒྲུབ་བརྒྱུད་ཀྱི་བསྟན་པ་སྐྱོང་བ་ཞིག་བྱུང་ན་ས་གང་ན་འདུག་ཀྱང་མཐུན་རྐྱེན་སྒྲུབ།",
    "ཚོང་འདུས་དབུ་རྩེར་ཞལ་ངོ་རྣམས་དང་མཇལ་ཞིང་དུས་རིམ་དང་ཐུག་པའི་ཟིང་ཟིང་མང་པོ་འདུག་པས་སྣང་བ་སྒྱུ་མ་ལྟ་བུ་ལ་ངེས་ཤེས་སྐྱེ་བར་བྱུང་།",
    "མི་རིང་བར་སྐུ་ཁམས་ལོག་པའི་ཐུགས་ལ་བདེ་དོག་ཆེར་བྱུང་འདུག་པ།",
    "དངོས་ཀྱིས་སླེབས་དུས་ཞབས་དྲུང་ནི་ཕྱིར་ཕེབས་གྲུབ་འདུག་ཅིང་།",
    "དེ་གོང་ཐུགས་འབྲེལ་མི་གདའ།",
    "དེ་སྐབས་བཞུགས་ཡུལ་ནི་མགྲོན་ཁང་ན་གནང་འདུག།",
    "སྔོན་གྱི་དེ་དངོས་རང་མིན་པའི་སྐུ་ཚབ་ཡིན་ནམ་སེམས་པ་ཞིག་འདུག་པ་གང་ལྟར་ཡང་དེ་རྣམས་མཇལ།",
    "ཞལ་ཕྱེ་ནས་བལྟས་པས་འཁོར་ལོ་སྡོམ་པའི་རྩ་རྒྱུད་དུ་འདུག་ཅིང་།",
    "མཆན་བུ་རིག་མི་གཅིག་པ་ཤིན་ཏུ་མང་བ་བརྒྱབ་པའི་ཡི་གེ་རྣམས་ཀྱང་གསེར་དངུལ་སྤང་མཐིང་མཚལ་སོགས་སྣ་ཚོགས་པས་བྲིས་པའི་ཁྲ་ཆེམ་ཆེམ་པ་ཞིག་འདུག།",
    "ཞེས་པ་ཞིག་འདུག།",
    "ཁོང་ཡང་ཞག་གཅིག་ལ་ཡང་རྩེག་འདམ་མཛད་ནས་མྱུར་པོར་འབྱོན་པར་འདུག།",
    "ཁོང་པ་ཡང་མུ་སྟེགས་པ་ཡིན་ཞིང་བསླབས་ཤེས་ཀྱི་ཡོན་ཏན་རང་ནི་ཡོད་རིགས་སུ་མི་འདུག།",
    "ས་སྐྱ་ཞབས་དྲུང་ཁྲི་ཆེན་གྱིས་གྲུབ་ཐོབ་ཡིན་རྒྱུའི་བསྔགས་བརྗོད་མཛད་འདུག་པས།",
    "དཔོན་སའི་དྲུང་སོགས་ཐམས་ཅད་བདེན་པར་མི་འཛིན་པ་འདུག་སྟེ་ཕྱིས་རང་རྟགས་བསྟན་པ་དེ་ཡིན།",
    "དེ་ལ་མ་ཉན་པར་ཚེས་བཅུ་བཞིའི་ཉིན་ཞུགས་འབུལ་བྱས་འདུག།",
    "ཁོང་དེ་དུས་འཁང་ངེ་བྱེད་ཀྱིན་འདུག་ནའང་ཕྱིས་ངེད་ཀྱི་ཚིག་བདེན་པར་བྱུང་།",
    "དེ་སྤྱན་ཧྲིག་ཧྲིག་ཞལ་འཛུམ་འཛུམ་མཛད་པ་མཐོང་བ་ཙམ་གྱིས་འཇིགས་ཀྱང་འཇིགས་ལ་དགའ་ཡང་དགའ་བ་ཟིལ་བཟོད་པར་དཀའ་ཞིང་བག་ཀྱང་དྲོ་བ་རིག་པ་ལ་དཔའ་ངར་ཡང་བསྐྱེད་ཐུབ་པ་ཞིག་འདུག།",
    "རོ་ལངས་ཡིན་ཟེར་བ་བརྒྱད་དང་ལྷན་དུ་ང་རང་ཡང་རྣལ་འབྱོར་པའི་ཆས་སུ་བསྒྱུར་ནས།",
    "ཨཥྟ་ལ་འཛབ་དབྱངས་བྱེད་ཀྱིན་འཆོད་རྒྱུག་དང་སྐོར་བ་བྱེད་ཀྱིན་འདུག།",
    "ཐོད་པ་འོ་མས་གང་བ་གཅིག་འདུག་པ་ལ་འདི་ཅི་ཡིན་དྲིས་པས་བསྐྱེད་རིམ་ཡིན་ཟེར།",
    "གཉིད་སད་ནས་ཀྱང་ཉིན་གུང་ཐུགས་མ་སངས་པར་འདུག།",
    "གསུམ་བཞི་ཞིག་ཞག་མང་རབ་བསྡད་པར་གདའ།",
    "ཇོ་ནང་བླ་བྲང་ན་ནི་དེ་སྐབས་རྒྱུ་ཡོད་པའི་རིགས་སུ་མི་འདུག།",
    "འདི་སྐབས་གཙུག་ལག་ཁང་སོགས་གསར་བཞེངས་དང་མངའ་ཞབས་ལ་གྲྭ་ཁྲལ་ཡང་མཛད་འདུག།",
    "བླ་ཆེན་གཞན་རྣམས་ཀྱིས་ཀྱང་འདི་ཡེ་མ་དགོངས་པར་གདའོ།",
