    "ལྷ་རྩེར་མཇལ་བའི་དགོངས་གཏད་འདུག་པ་ལྟར་དེ་ཁའི་རྩིས་ཀྱི་ཇོ་ནང་དུ་ཕྱིན།",
    "ཞབས་དྲུང་རང་དག་ཕྱག་གཡོག་དཔོན་སྐྱ་གཅིག་གཉིས་ཙམ་ཡོད།",
    "དེ་ལས་གཞན་ཤུལ་མའང་གྲྭ་རིགས་སམ་གཞན་དོན་ནམ་བྱ་བ་བྱེད་འཕྲོ་འདི་ལྟ་བུའོ་ཞེས་ལྷག་མ་ལ་ཡོངས་སུ་ཆགས་པའམ་རྗེས་སུ་འདི་ལྟ་བུ་ཞིག་དགོས་པར་འདུག་ཅེས་བློ་ལ་བཅགས་པ་ཡང་མེད་ལ།",
    "རང་དགེ་སྦྱོར་རང་ཅིག་བྱེད་ན་རང་དགོས་པར་འདུག།",
    "ཞབས་དྲུང་རང་དང་།",
    "གོ་བ་རང་སྔོན་མ་ནས་མི་སྐྱེ་བ་འདུག།",
    "དེང་སང་ཕལ་ཆེར་གྱི་ལུགས་སུ་གདའ་ནའང་།",
    "སྔར་གྱི་དེ་དང་ནི་འདྲ་ལ་འདྲ་མིན་ཞིག་བྱུང་སྙམ་པའི་མགོ་བོ་སྤོས་པ་དེ་ཁར་འདུག་གོ།",
    "རང་ཡུལ་དུ་ཕ་སྐུ་མདུན་རྣམ་རྒྱལ་ཕུན་ཚོགས་དེ་སྐུ་གཤེགས་པ་འདུག།",
    "དེས་ན་ཕྲ་ཞིང་ཕྲ་བ་ལ་སྤང་བླང་བྱེད་པ་གལ་ཆེ་བར་གདའ།",
    "དེ་ལ་འཕན་ནེ་བས་མགོ་སྐོར་གྱི་རྣམ་པ་བྱས་འདུག་ཀྱང་།",
    "གཟིངས་གཞི་ལ་དགོས་པ་མི་འདུག་སྙམ་ལོ་མང་དག་ཅིག་བཞག་པ་ཡིན།",
    "སྨོན་འགྲོ་བ་རང་རྟོགས་ལྡན་དང་བཅས་པས་བཙུད་པ་ཡིན་ངེས་སུ་འདུག་པ་དང་།",
    "ཁོང་པའི་གསང་ཆབ་ཀྱང་ཆུ་འཇོ་འཇོ་མཆོད་གདའ་ནའང་།",
    "ཕན་བསྐྱེད་ནི་ཆེར་མ་བྱུང་བར་འདུག།",
    "སྤྱིར་འཆི་བའི་ས་ཆ་ལ་ཁྱད་མི་འདུག་ཀྱང་།",
    "ད་དུང་འདི་བས་ཀྱང་ཆེས་ཆེ་བའི་ན་ཚ་སྡུག་བསྔལ་ཐམས་ཅད་སྤུངས་ཤིག་སྙམ་པ་ཁོ་ན་ཡང་ཡང་རང་ཞུགས་ལ་བྱུང་།",
    "ཁྲིད་གསར་པའི་རིགས་ངོ་སྤྲོད་ཞུ་འདོད་ཤིན་ཏུ་མང་བ་འདུག་པ་རྣམས་ལའང་།",
    "སྔོན་གྱི་སྤྱན་ལྟོས་བཟང་པོའི་རྒྱུན་འདི་ཁ་ངོ་མཚར་ཆེ་བར་གདའ།",
    "ཆ་ཅིག་ནས་དེ་ཡང་བདེན་པོར་གདའོ།",
    "བྲག་སྟོད་དུ་མི་མཐོ་སོགས་འདུག་ཀྱང་།",
    "བྱང་ཕྱོགས་ལ་འགྲོ་རྒྱུ་ཡིན་འདུག་པས།",
    "ལ་དེ་ལ་འཕྲང་ཡོད་དམ་ཟེར་མཁན་འདུག་ཀྱང་འཕྲད་མ་བྱུང་།",
    "ནས་ཟླ་གཅིག་ལྷག་ཙམ་ནས་ངམ་རིང་དུ་ཐོག་ཕོག་པའི་རྐྱེན་གྱིས་ཤི་འདུག།",
    "སྐད་ཆ་དྲིས་པས་ངེད་ཚོ་རྒྱ་རྒན་ནང་སོའི་གཡོག་ཡིན་གྱིན་འདུག།",
    "འཇིག་རྟེན་ཕྱོགས་ཀྱི་ཕྱི་ནང་གསང་གསུམ་གྱི་སྒོ་ཐམས་ཅད་ནི་བཞད་གད་ཀྱི་རྒྱུ་ཁོ་ནར་འདུག།",
    "དྲུང་སྐོར་ནང་གཟན་ཚོ་ནི་ངེད་ཚོའི་རྩར་ཡང་ངོམ་ངོམ་བྱེད་ཀྱིན་འདུག།",
    "སྐེ་འཕྲེང་ཝ་བ་རས་རས་བྱེད་ཀྱིན་འདུག་སྟ།",
    "མ་ནུབ་པ་ཚོ་ལའང་གཞན་རྣམས་ལ་རྐང་འཛིན་ཆེར་མི་གདའ།",
    "གཞན་ཕལ་ཆེར་ཡང་ནག་ཁྲ་རུ་ཀ་ཡོང་ཉེ་གདའ།",
    "ཀར་འབྲུག་གཉིས་སུ་གདའ་ནའང་།",
    "ཞེས་གསུངས་པ་དེར་གདའ།",
    "དེ་སྐབས་བྱ་མཆུ་བ་རྣམ་རྒྱལ་རྟོགས་ལྡན་བྱས་པ་ལ་དཔོན་གཡོག་ཐམས་ཅད་སྨོན་པའི་གནས་སུ་མཛད་ཀྱིན་འདུག་སྟ།",
    "འདིའི་རིགས་ཀ་ཡང་ཡང་ཡོད་པར་འདུག་ཀྱང་།",
    "མུན་སྲོས་པ་བཞིན་དུ་ནག་ཐོམ་ཐོམ་པར་འདུག།",
    "རང་ཡང་པོར་གཏོང་བ་དེ་འདྲ་མཛད་ཀྱིན་གདའ་འོ།",
    "ཁྱེད་རང་ཡང་དེ་བཞིན་རང་བྱེད་དགོས།",
    "ཁོང་རང་རྣམས་སོ་སོར་ཁུངས་སྟོངས་པའི་དུས་སུ་ཁུར་ཡང་བའི་ཁེ་བྱུང་།",
    "བྱང་ཕྱོགས་ལ་དམག་འདེགས་པའི་དཔུང་གྲ་སྒྲིག་པའི་སྐབས་སུ་འདུག།",
    "ཐུགས་ཡིད་མ་ཆེས་པའི་དགོངས་པ་ལོག་པ་ཞིག་ཤར་འདུག།",
    "བཀའ་གསལ་ནི་ཚིག་གཅིག་ཀྱང་མ་བྱུང་འདུག།",
    "དེ་མི་དགོངས་པ་དབུ་སྦོས་འདུག།",
    "བྱང་རང་དུ་ཕན་ཐོགས་གང་དྲག་ཞི་ཨེ་ཡོང་བསམ།",
    "བྱང་ཞབས་དྲུང་རང་ལའང་སླར་སྟོན་པ་གནང་དུས།",
    "རྒྱ་ཞིང་དེ་ཙམ་ལ་ཐུག་ནས་བྱིས་པའི་གསུང་དེས་མགོ་སྐོར་ཐོངས་རིས་མིན་པ་འདུག་ཅིང་།",
    "དཔོན་གཡོག་ཚོ་རང་ཤིན་ཏུ་སྐྲག་པས་ཕེབས་མི་ནུས་པའི་གང་དྲག་ཅི་དྲག་ཏུ་འདུག་པ་ལ།",
    "ཕར་འབྱོན་དུས་རྔོད་པའི་རྟོགས་ལྡན་པས་ཆིབས་སྣ་བྱེད་པ་སོགས་ཡ་ཆ་ལ་བཀྲ་མི་ཤིས་པ་དེ་འདྲའང་གདའ།",
    "ས་འཇགས་སོགས་ཡེ་མི་ཡོང་བའི་བཀའ་བཀྱོན་གྱི་སྒོ་འདུག་ཀྱང་ནན་ཆེར་ཞུས་པས་ས་ཆ་ཕལ་ཆེར་སྐྱོན་མེད་དུ་འཇགས།",
    "ཕན་ནི་ཤིན་ཏུ་ཆེ་སྟེ་དྲིན་ཤེས་པ་ནི་ཕལ་ཆེར་ལ་མི་གདའ།",
    "འཕྲལ་གྱི་ལྟར་དགྱེས་དགྱེས་ཙམ་ཡང་མེད་པའི་ཐུགས་ཁྲོས་སེ་བ་ཡོད་འདུག།",
    "མཁན་ཆེན་པས་གཙོ་མཛད་ལས་འཛིན་ཕལ་ཆེར་ཞིག་མང་ཇ་མི་འཐུང་བ་ཡིན་ཟེར་ལྐོག་ཤུབ་དིར་དིར་བྱེད་ཀྱིན་ཡོད་འདུག་པས།",
    "དོན་མེད་ཕྲག་དོག་ལངས་པའི་མིག་མ་ཤོང་བྱེད་མཁན་སྣ་ཚོགས་ཤིག་འདུག་པས།",
    "ལུས་གཡར་དེ་མི་རྣམས་ཟེར་བའི་གཏམ་སྣ་ཚོགས་དེ་ཁ་ལབ་པར་འདུག།",
    "དེ་དང་མི་མཐུན་པར་ཞིབ་རྒྱས་མང་པོ་ཟེར་བ་འདུག་པ།",
    "འཇིགས་སུ་རུང་བའི་གཟུགས་ཀྱིས་ས་གཞི་བར་སྣང་ཐམས་ཅད་ཁྱབ་འདུག།",
    "ང་རང་ཉིད་མེད་པ་ལ་རིག་པ་ཅི།",
    "དེ་ཙམ་མ་གཏོགས་ད་དགོས་བརྗེད་འདུག།",
    "དགག་དགོས་དུ་མ་འདུག་པ་ནས།",
    "ངམ་རིང་ནས་བྱང་ཞབས་དྲུང་རང་ཕེབས་དགོས་བྱུང་བའི་སྐབས།",
    "འཁོར་ལོ་མང་པོ་ཞིག་དེ་སྐབས་ཁྱེར་འདུག་པ།",
    "བསྔོ་རྟེན་རྣམ་གཞག་ཐམས་ཅད་ཀྱང་གང་བཟང་རང་བསྒྲུབས།",
    "ཚང་བས་ནན་བཅགས་ཞུས་ནས་དེ་འཕྲལ་སྤྱན་དྲངས་འདུག།",
    "རྒྱལ་རྩེའི་ལི་མ་ལྷ་ཁང་ན་རྟེན་བཅུ་ལྷག་ཞིག་རམ་མེ་འདུག།",
    "དེ་སྐབས་མངོན་སུམ་ལྟ་བུར་གྱུར་འདུག།",
    "ཕྱིས་མི་རིང་བར་འཚོ་མ་ཐུབ་པར་འདུག།",
    "ངེས་དོན་ཀྱི་བསྟན་པ་ལ་ཕན་པ་ནི་མི་ཡོང་བ་འདུག་པས།",
    "འོ་བརྒྱལ་བར་འདུག་བསམ་སྟ།",
