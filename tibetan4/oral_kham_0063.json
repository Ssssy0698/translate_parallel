    "ཐོག་མར་བགེགས་མི་འཇུག་པའི་བགེགས་སྐྲོད་རབ་གནས་བྱེད་དགོས་འདུག་པ།",
    "ནུབ་གཅིག་ཐོག་མར་རབ་གནས་ལ་ཡོང་དུས་ལྷ་རྟེན་གྱི་གསེབ་དེ་ཐམས་ཅད་མིའི་གཟུགས་ཅན་སྣ་ཚོགས་པས་གང་བའི་གཏམ་འབུག་འབུག་བྱེད་ཀྱིན་འདུག།",
    "སྔ་སོར་འཁོར་རང་གསུང་པ་བདེའང་བདེན་པ་འདུག།",
    "ནང་པར་སྔ་བར་དཔོན་ཁང་ནས་ཡར་ཙམ་ན་གཞིས་ཀ་ཞིག་འདུག་པ་དེར་ཕྱིན།",
    "དེ་ཡར་ལྷ་དངོས་སུ་གདའ།",
    "སྒྲུབ་ཆུའི་ཆུ་མིག་གསར་པ་ཞིག་འདུག་པ་ལ་རབ་གནས་ཤིག་ལ་ཕྱིན།",
    "དགུན་གྲང་སྒང་དེ་ཉིད་ལ་ནས་རྣམས་ལ་ལྗང་བ་དང་སྙེ་མ་ཐོན་འབྲུ་ཆགས་པ་ཙམ་བྱུང་འདུག།",
    "སྤྱིར་སྐུ་གཞོགས་སུ་རྒྱང་ཙམ་བསྡད་ན་དགོངས་པའང་འདུག་ཅིང་།",
    "ཁོ་བས་དགོས་མེད་ཀྱི་སྐུལ་ཅག་སྤྲོ་ཐུང་རང་བྱེད་པས་དེ་ཁའི་སྟབས་ནས་བཀའ་ཕེབས་ལ་ཡང་ད་ལམ་གང་མྱུར་འགྲོ་བ་ལས་འོས་མེད་ཕེབས་ཤིང་།",
    "བར་སྐོར་ལ་དཀོན་གཉེར་དཔོན་གྱིས་ཞིག་གསོས་བྱེད་ཀྱིན་འདུག་པ་རྟ་གསུམ་སོགས་ཟང་ཟིང་མང་དག་ཞིག་གསོས་ཀྱི་ཐེས་ལ་བཏང་།",
    "བཞེད་དོན་གྱི་གཙོ་བོ་ལམ་སྐོར་ཕྱི་མ་བརྒྱད་ཀྱི་ཁྲིད་ཡིན་འདུག་པ་བཞིན།",
    "ཁུ་དབོན་དྲུང་རང་དུ་ལུས་དཀྱིལ་ཡབ་བཀའ་ཡུམ་བཀའ་གཉིས།",
    "འབོད་མི་ཡིད་མ་ཆེས་བྱེད་ཀྱིན་འདུག་ནའང་ཕྱིས་དེ་ཀ་ལྟར་བྱུང་།",
    "རྒྱུན་སྡོད་ཀྱི་ཟླ་བོ་ཐམས་ཅད་ལ་གཏམ་གསན་ཆེན་པོ་ཞིག་ཡོང་བ་འདུག་སྨྲས་པ་ལྟར།",
    "ཡིན་ཟེར་ནའང་འགལ་བ་མི་འདུག་གོ།",
    "སྔ་སོར་སྟག་ལོའི་ནང་དུ་སྐུ་ཁམས་བསྙེལ་བའི་ཚུལ་བསྟན་པ་དེ་འདིའི་བར་དུ་འཕྲོ་ལུས་པའི་རྣམ་པ་ཕྱག་ཡུལ་ཅུང་ཟད་མི་བདེ་བ་དང་སྐུ་ཁམས་ཀྱང་བྱིང་པའི་རྣམ་པ་འདུག་ཕེབས་པ་ཞིག་ཡོད་ནའང་།",
    "བཟང་ལྡན་དུ་ཚེས་བཞི་ལ་ལམ་འབྲས་ཚུགས་ངེས་དགོས་ཚུལ་དུ་འདུག་ཅིང་།",
    "དེ་ཉིན་ལམ་གྱི་ངལ་དུབ་ཤིན་ཏུ་ཆེ་བ་ཞིག་བྱུང་སྟེ་ཕྱིན་ན་མི་ལེགས་ཟེར་རྒྱུར་འདུག།",
    "དེ་ཉིད་དཔལ་ལྡན་སྡིངས་སུ་ཞབས་དྲུང་ལྕམ་སྲིང་ཕེབས་འདུག།",
    "དེ་མཚམས་ངམ་རིང་དུ་ཡོང་དགོས་ཕེབས་བྱུང་བས་དེ་སྐབས་ཟེར་ཚད་ཉན་པའི་སྤྲེའུའི་ཁུང་རང་བྱས།",
    "ཕུགས་ཀྱི་དབྱིངས་དང་རྟག་བརླིང་ཁེལ་བ་ནི་གང་བྱས་ཀྱང་དཀའ་བར་གདའ།",
    "མཆོད་ཐེབས་ཀྱི་མཆོད་གཞིས་རྣམས་ལ་གནོད་པ་ཁོ་ན་བྱེད་པ་རྒྱུན་མི་ཆད་བྱུང་འདུག།",
    "དེ་འཕྲལ་ངམ་རིང་དུ་དགོངས་སངས་ཞུ་བར་བཏང་འདུག་ནའང་།",
    "ད་དགོན་གནས་འདི་བཟུང་ཡང་བསྟན་པ་སྤྱི་སྒོས་གང་ལ་ཡང་མི་ཕན་པར་འདུག།",
    "དེ་ནས་ཀྱང་ལོ་ཤས་ནི་ཅང་མ་བྱུང་སྟེ་ཕྱིས་རིམ་པས་ཡོང་བ་ལ་དགོངས་པར་འདུག་ཡང་དེའི་ཕྱི་ནུབ་ཀུན་མཁྱེན་ཆེན་པོ་ལ་གསོལ་བ་བཏབ་པས།",
    "དེ་ལ་ཕན་ཐབས་བཅོས་བྱེད་རྒྱུ་ཕྲན་བུ་འདུག་སྟེ་གཉིས་ཐད་ནས་བཅོལ་གཏོགས་མི་འདུག་པས་ཁ་རོག་བསྡད།",
    "གདོང་དགའ་བ་ལ་ཡོན་མཆོད་བར་གྱི་ལེགས་ལམ་གྱི་ཐབས་ཀྱིས་གསུངས་འདུག་ནའང་ཁོང་པས་མ་མཛད།",
    "སྙུང་གཞིའི་རྐྱེན་ཡང་གདོན་གྱི་གནོད་པས་བྱས་འདུག།",
    "ལས་གྲོལ་འགྲོ་ཤས་ཆེ་བ་འདུག་ཞུས་པ་ཡིན་ནའང་།",
    "བསམ་ངན་ཁོག་བཟུང་བ་སྔ་ཕྱི་ད་ལྟའི་བར་ཇི་སྙེད་ཅིག་གདའ་སྟེ་ལང་པ་ཞིག་དང་ཁུམ་པ་ཞིག་ཀ་སྔར་ཡང་བྱུང་།",
    "ད་དུང་ཡོང་བ་འདི་ལར་མི་གོ་བར་འདུག་ལགས།",
    "འདི་སྐབས་སྐུ་སྙེལ་བའི་འགོ་ཙམ་ཡིན་ཚོད་དུ་གདའ།",
    "ཞབས་དྲུང་དེ་ཕོ་གཉིས་ཀ་རིང་པོར་མི་བཞུགས་པ་ལ་ལྟ་བར་འདུག།",
    "དེ་རྗེས་ཟླ་གཅིག་ཙམ་ནས་འབྲུག་པའི་སྒར་ལ་ཐེགས་གདའ།",
    "དོན་ནི་རི་བོ་ཆེ་བ་ལ་དཔེ་འདྲ་གནང་བ་ཡིན་པར་འདུག།",
    "དེ་ཕྱིན་ཕྱག་གཡོག་བྱེད་རྒྱུ་ཡང་མི་འདུག་པས་མྱུར་དུ་འགྲོ་བའི་དགོངས་གྲོལ་ཡང་ཡང་ཞུས་ཀྱང་།",
    "མི་སྣས་ཡུལ་དུས་གཞན་དུ་སྣ་ཚོགས་ཤིག་གླེང་འདུག་ནའང་དེ་ལ་གྲུབ་འབྲས་རང་ནི་ཅང་མ་བྱུང་བ་འདྲའོ།",
    "ད་དུང་ཀར་དགེའི་འཁྲུག་པ་ཡོང་ཤས་འདུག་ནའང་ད་ནི་སླར་དམག་མི་གནང་བ་རང་ལེགས།",
    "དང་པོ་ཁྱི་ལོའི་སྐབས་ཀྱི་རྨི་ལམ་དེ་ཡང་ཐོག་ཏུ་ཁེལ་བར་གདའ།",
    "འཇིག་རྟེན་སྒྱུ་མའི་གར་མཁན་འཁྲུལ་སྣང་གང་ཤར་གྱི་ཉམས་སྐྱོང་བ་བདེན་མེད་ལ་བདེན་ཞེན་ཅན་དུ་གདའ།",
    "ཅུང་ཟད་ལེགས་པར་ཡང་འདུག།",
    "ད་ལོའི་གནས་ཚུལ་འདི་ཡང་མ་ལེགས་པ་ཆེ་སྟེ་ད་དུང་ལོ་ཤས་འཇམ་གང་ཆགས་དང་བརླིང་ཆ་གང་ཆེ་མ་མཛད་ན་སྐྱོན་ཆེ་བ་རང་གདའ་ཞུས།",
    "ནང་མི་རྣམས་ཟི་ངེ་བ་ཞིག་འདུག་ནས་ཁང་པའི་ནང་དུ་བློ་མ་ཆགས།",
    "སང་ཉིན་འགྲོ་རྒྱུའི་དེ་རིང་རང་དེ་རྒྱལ་རྩེ་ནས་འབོད་མཁན་སླེབས་ཀྱང་དེ་སྐོར་ལ་འགྲོ་མ་ཐུབ་རོང་ཆེན་བརྒྱུད་ནས་ཕྱིན།",
    "འདི་སྐབས་དད་གུས་ཆེན་པོ་དཔེ་མེད་མཛད་ཐུགས་ནང་གཙང་བའི་གསུང་ཕེབས་པ་སོགས་མཛད་ཀྱིན་འདུག།",
    "འདི་སྐབས་རྒྱལ་རྩེར་ནང་ཞིག་བྱུང་གདའ།",
    "དགྱེས་པ་དང་འཚུབ་འགྱུར་སྤེལ་མའི་ཉམས་སུ་གདའ།",
    "ཁོང་ལ་རྒྱལ་འགོང་རྗེས་སུ་འབྲང་པའི་ཆོ་འཕྲུལ་དུ་མ་འདུག་ནས་དེ་ལ་གཟིར་གྱིན་ཕྱིན།",
    "བསྐང་གསོའི་ཐུན་གཏོར་སྐྱེལ་མཁན་ལ་ཡང་མཐོང་སྣང་མང་པོ་བྱུང་གདའ།",
    "ཁ་སང་ཁོ་བའི་ཚོགས་འཁོར་དེ་མ་དག་པའི་གྲིབ་ཏུ་འདུག།",
