    "ཡེ་ཤེས་ཀྱི་གཞལ་ཡས་ཁང་གི་རྒྱུར་བྱིན་གྱིས་བརླབ་པོ།",
    "པེའི་༧༤བཏབ་ལ་ཡེ་ཤེས་ཀྱི་མཆོད་རྟེན་སྤྱན་དྲངས་ལ་གཉིས་སུ་མེད་པར་བསྟིམ་མོ།",
    "ཨོཾ་བུདྡྷ་ཨོཾ་ཧཱུྃ།",
    "གཞན་གྱིས་མ་མཐོང་བར་རང་རེས་བྱས་ན་ཉིན་རེ་ལ་གསེར་གྱི་དོང་ཙེ་བདུན་བརྒྱ་བདུན་བརྒྱ་སྦྱིན་པར་བྱེད་དོ།",
    "དལ་འབྱོར་ཆེན་མོའི་སྒྲུབ་པ་བཅུད་ཀྱིས་ལེན་པ་ཞེས་བྱ་བ།",
    "དེའི་ངང་ལས་བདག་ཉིད་ཀྱིས་པཾ་ཞེས་བརྗོད་པས་བདག་གི་མདུན་དུ་སྡོང་པོ་ཤིན་ཏུ་རྒྱ་ཆེ་བ་དཔངས་མཐོ་བ་སུམ་བརྩེགས་གཅིག་ལ།",
    "དེ་ཡང་སྟེང་གི་པདྨ་ལ་ཁ་དོག་དཀར་པོ་འདབ་མ་དཔག་ཏུ་མེད་པ་དབུས་དམར་པོ་འདབ་མ་དཔག་ཏུ་མེད་པ་འོད་སྔོན་པོ་དཔག་ཏུ་མེད་པ་དམིགས་སོ།",
    "དེ་ནས་ཨོཾ་ཞེས་བརྗོད་པས་སྣོད་ཀྱི་ནང་དམ་ཚིག་གི་བདུད་རྩི་དེ་སྐུའི་བདུད་རྩིར་གྱུར།",
    "ཨཱ་ཞེས་བརྗོད་པས་གསུང་གི་བདུད་རྩིར་གྱུར།",
    "༡༨༥དེ་ནས་ཡང་རཾ་ཞེས་བརྗོད་པས་དམ་ཚིག་གི་བདུད་རྩིའི་ཉེས་པ་རྣམས་བསྲེགས།",
    "ཡཾ་གིས་གཏོར།",
    "ཁཾ་གིས་བཀྲུས་ནས་དེ་ནས་སྐུ་གསུང་ཐུགས་དབྱེར་མི་ཕྱེད་པའི་བདུད་རྩིར་གྱུར་པའོ།",
    "གཟུགས་ཁམས་རྣམས་ལ་དཔག་བསམ་གྱི་ཤིང་འདོད་པ་རྣམས་ལ་རང་༤རང་ཇི་ལྟར་བསམས་པ་བཞིན་དུ་ཐོབ་པར་མོས་པར་བྱའོ།",
    "ལ་སོགས་པའི་སྣོད་ཁྱོར་བ་གང་ཤོང་བ་ཅིག་༢ཏུ་ཆུ་གཙང་མ་སྲོག་ཆགས་མེད་པས་བཀང་སྟེ།",
    "འབྲུའམ་ཟན་མཐེབ་ཀྱུ་རེ་བཅུག་ལ།",
    "ན་མཤྩཎྜ་བཛྲ་ཀྲོ་དྷཱ་ཡ་ཧུ་ལུ་ཧུ་ལུ་ཏིཥྛ་ཏིཥྛ་བནྡྷ་བནྡྷ་ཧ་ན་ཧ་ན་ཨ་མྲྀ་ཏེ་ཧཱུཾ་ཕཊ།",
    "དེ་ལྟར་ཕུལ་བས་ཉི་མ་རེ་ལ་ཀཱནྟཱ་པ་ཎ་ལྔ་སྟོང་ལྔ་སྟོང་ཐོབ་པར་ངེས་སོ།",
    "དེ་ལྟར་ཉི་མ་རེ་ལ་ཡི་དམ་དུ་བྱས་པས་འདོད་པའི་དོན་ཕུན་སུམ་ཚོགས་པར་ངེས་སོ།",
    "དེ་རེ་རེ་ལ་ངར་གླུད་སོར་བཞི་པ་བརྒྱ་རྩ་བརྒྱད་ཀྱིས་བསྐོར་ལ།",
    "སྐྲ་གཡེངས་སོ་གནན་ཁྲག་གིས་བརླན།",
    "བདག་གི་འདོད་པའི་དོན་རྣམས་ནི།",
    "རིའི་རྩེ་མོ་ལ་སིལ་སྙན་སྣ་ཚོགས་པའི་སྒྲ་དང་ལྡན་པར་བྱས་ལ་བསྐྱལ་ལ།",
    "ཚེར་མ་སྣ་ཚོགས་པ་ཉག་མ་རེ་གཟུགས་སོ།",
    "དེ་བདག་གི་མདུན་དུ་བཞག་ལ་གཙོ་བོ་ལ་མཆོད་བསྟོད་ཅི་རིགས་པར་བྱས་ལ་སྲན་མ་རྣམས་དང་སྒོག་སྐྱ་དང་།",
    "བསེ་ཤིང་གི་འབྲས་བུ་ལ་སརྦ་ཤ་ཧཱུཾ་ཧཱུྃ་ཕཊ་ཅེས་འབུམ་ཕྲག་གཅིག་བཟླས་ཏེ།",
    "བསྒྲུབ་བྱའི་ཁང་པ་ལ་ཁྲག་གིས་གཏོར་ན་ངེས་པར་མཛའ་སྡུག་རྣམས་ཀྱི་ལྕེ་འབབ་པར་ངེས་སོ།",
    "སྐྱེ་བོ་སྡང་བའི་ལས་མྱུར་བྱེད་ཆེན་མོ་ཞེས་བྱ་བ།",
    "གཏོར་མ་རེ་རེའི་ནང་དུ་སྡང་བ་རྣམས་ཡ་ཧི་གཙྪ་༤ཞེས་གྲོ་ག་ལ་བྲིས་ལ་གཞུག།",
    "ལྟེ་བར་ཆེ་གེ་མོ་མཱ་ར་ཡ་ཛ་ཞེས་པ་བྲི།",
    "ལག་མཐིལ་དུ་གི་ཝང་གིས་འཁོར་ལོ་རྩིབས་བཞི་པ་རེ་བྲིས་ལ།",
    "འཁོར་ལོ་གི་ཝང་གིས་བྲིས་ལ།",
    "རྒྱུདགཙེས་པ་བསྲུང་བའི་ཆོ་ག་ཆེན་མོ་ཞེས་བྱ་བ།",
    "མི་མཐུན་པའི་འཐབ་པ་དང་རྩོད་པ་རྣམས་ཞི་བར་འདོད་པས་ནགས་སྟུག་པོའི་ཁྲོད་དུ་སོང་སྟེ་དཀྱིལ་འཁོར་འཁོར་ལོ་རྩིབས་བཞི་པ་ཞི་བའི་ཁ་དོག་ཏུ་བཞེངས་ལ་ལྷ་རྣམས་སྤྱན་དྲང་བ་དང་།",
    "རྩྭ་དྲུར་༦ བ་ལ་དུར་ཁྲོད་ཀྱི་ཐལ་བ་ལ་བཟླས་ནས་གཏོར་ན་འཕྲོག་མའི་སེམས་ཞི་བར་འགྱུར་རོ།",
    "རྒྱལ་པོའམ་ཡོན་ཏན་ཅན་དང་མི་མཐུན་པ་ལ་ནི་བྱ་ནག་མོའི་སྒོ་ང་དང་།",
    "འཕྱང་མ་འཕྱང་གིས་ཁེབས་པར་བྱས་སོ།",
    "བྱང་ཤར་ནས་གཡོན་བརྐྱང་བའི་སྟབས་༤ཀྱིས་གཡོན་སྐོར་དུ་ཨོཾ་བཛྲ་ཡཀྵ་ཧཱུྃ་ཧཱུཾ་ཞེས་བརྗོད་པས་བདག་དང་ཡོན་བདག་གི་ནོར་འགྲིབ་པར་བྱེད་པའི་བགེགས་དེ་དཔག་ཚད་བརྗོད་ཀྱིས་མི་ལང་བར་བྱེར་ཞིང་དེངས་པར་བྱའོ།",
    "ཡོན་བདག་གིས་སེམས་བསྐྱེད་པ་དང་།",
    "བྱང་ཕྱོགས་ཀྱི་རྒྱལ་པོ་ཆེན་པོ་རྣམ་ཐོས་སྲས་ཀྱི་བུ་འཁོར་དང་བཅས་པས་དོ་ནུབ་ནས་བཟུང་བ་ཕན་ཆོད་ནོར་གྱི་བདག་པོ་མཛོད་ལ་བདག་ཅག་གི་ནོར་དང་ཟས་མི་འགྲིབ་པར་འཕེལ་བར་མཛད་དུ་གསོལ་ཞེས་དུས་ལ་བརྗོད་དོ།",
    "བདག་ཉིད་རྣམ་འཇོམས་ཀྱི་ང་རྒྱལ་དུ་བྱས་ལ་གཟུངས་ཐག་ཨོཾ་ག་སྭཱ་ཧཱ་ཞེས་སྟོང་སྟོང་གཞན་གྱིས་ན་མོ་རཏྣ་ཏྲ་ཡཱ་ཡ།",
