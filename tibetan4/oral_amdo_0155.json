    "གསུང་གི་ཡོན་ཏན་ཡན་ལག་དྲུག་ཅུ་རྩ་བཞི་པོ་དེ་ཡིན།",
    "དེ་རེ་རེའི་ཡོན་ཏན་ཡང་གཞལ་དུ་མེད།",
    "དེ་རྣམས་མཉམ་རྗེས་དབྱེར་མེད་ཀྱི་ཡོན་ཏན་ཤ་སྟག་ཡིན་པས་རེ་རེའི་མཐའ་ཡང་སུ་ཞིག་གིས་དཔོག་འཕྲིན་ལས་ཀྱི་ཡོན་ཏན་ལ་ལྷུན་གྱིས་གྲུབ་པ་དང་།",
    "མོས་པ་དང་།",
    "བདག་གི་ཚེ་རབས་གཏན་གྱི་སྐྱབས་ནི།",
    "མོ་བོན་རྩིས་གསུམ་སོགས་འཇིག་རྟེན་པའི་ཐབས་གཞན་མི་ཚོལ་བ།",
    "མགོན་པོ་གང་གི་བཀའ་ལུང་འཛིན་པའི་རྨོངས་རྟུལ་ཐ་ཤལ་བ་ཀུན་གླིང་ལྡེ་འཆང་བློ་བཟང་རྒྱལ་མཚན་གྱི་རེག་ཟིག་གོ།",
    "རབ་འབྱམས་ཞིང་གི་སྟོབས་བཅུ་མངའ་བའི་ཚོགས།",
    "གང་གི་ཆ་ཤས་ཡིག་འབྲུ་ཌེརེ་རེས་ཀྱང་།",
    "ཐུབ་པའི་གསུང་གི་གསང་བ་བསམ་མི་ཁྱབ།",
    "གྲོགས་བཟང་ཁྱོད་ནི་མཆོག་གིས་རྗེས་བཟུང་ཞིང་།",
    "ཟུར་ཡིག་ལ་ཟུར་ཡིག་གི་རི་མོ་གུད་དུ་སྤེལ་བར་འདོད་པས་དེར་གཟིགས་པར་ཞུ་ཞིང་།",
    "འོན་ཀྱང་ཁྱོད་ནི།",
    "སྔོན་ནས་མིག་རྣ་ཡིད་ཀྱི་བདུད་རྩིར་ཡང་ཡང་སོན་ཟིན་ཅིང་གྲུབ་པའི་ཉམས་དབྱངས་དོན་ཟབ་མོ་དང་ལྡན་པ་ཞིག་ལགས་ཏེ།",
    "ཡིན་ཡིན་མིན་མིན་དེ་ཨེ་ཡིན་སྙམ་མོ།",
    "ཞེས་གསུངས་པ་སོགས་བདེན་གཉིས་འགལ་མེད་ཟུང་འཇུག་གི་གླུ་རྣམས་དང་དོན་གྱི་འགངས་མཐུན་པར་སྣང་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཁྱེད་ཀྱི་འདུན་མོས་བཞིན་འབྲུ་དོན་ཅུང་ཟད་ཅིག་དགྲོལ་བར་བྱ་སྟེ།",
    "སྲིད་པ་གསུམ་གྱི་སྣོད་བཅུད་ལྟད་མོ་སྣ་ཚོགས་པའི་གར་འདི་རྫོགས་པར་བྱས་སོ།",
    "རང་གི་དངོས་པོ་སྟོང་པ་ཉིད་སོགས་བཞི་དང་།",
    "དེ་ལས་སྤྲོས་བྲལ་ལ་གཤིས་སུ་ཞེན་པ་ཁོ་རང་ཡང་བརྗེད་ཅིང་ཞིག་ནས་མེད་པར་ཐལ་ལོ།",
    "ལྟ་མགུར་བློ་ཀ་གཉིས་དང་རྐང་པ་གཅིག་གི་འབྲུ་འགྲེལ་ཆེ་ལོང་ཞིག་སོང་།",
    "ད་དུང་གླུ་འདི་རྣམ་པ་བརྒྱ་སྟོང་དུ་བཀྲལ་ཀྱང་ཁོ་བོའི་སྤོབས་པ་གཏུགས་པར་མི་འགྱུར་ལ་གླུ་འདིའི་དོན་ཡང་ཟད་པར་མི་འགྱུར་མོད།",
    "རང་རེ་ལྟ་བུས་འདོད་རྒྱལ་དུ་འདོགས་པ་མཛེས་མི་མཛེས་ཀྱང་བསམ་པར་བྱ་བའི་གནས་ཡིན་པར་མ་ཟད།",
    "ཁོང་གི་གསུང་དུ་བརྫུས་ཏེ་གནང་བའོ། ། བྱམས་བརྩེ་འཛུམ་དཀར་འགྲོ་ལ་གྲོལ་བའི་གཟིས།",
    "རང་སེམས་ལྷན་ཅིག་སྐྱེས་པ་ཕྲ་མོའི་གཞིར།",
    "འཛམ་གླིང་འདི་ན་ཡོངས་སུ་གྲགས་མོད་ཀྱི།",
    "ཆོ་གའི་ངག་དང་ལག་སྟབས་ཙམ་ཞིག་གིས།",
    "ཞིབ་མོར་འབྱེད་པའི་རྣམ་དཔྱོད་དགོས་པར་ཐོས།",
    "འོན་ཀྱང་ཚིག་གི་ཆ་ཙམ་འཛིན་པ་ཡང་།",
    "ཁྱོད་ནི་རིགས་བརྒྱའི་བདག་པོར་སུ་ཞིག་བསྙོན།",
    "འདུས་པའི་ནང་ན་རྩེ་མོར་འཕགས་པ་ནས།",
    "རྟག་ཏུ་འཚེར་བས་ཁྱོད་ལ་འཁྱུད་པར་སྨོན།",
    "ཤེས་རབ་ལྕེ་རྩེས་རྒྱ་བོད་གཞུང་གི་བཅུད།",
    "རིགས་ཀྱི་མྱུ་གུའང་འཆི་བདག་སེན་མོས་དྲལ།",
    "གཟིགས་ཏེ་བརྩེ་བའི་མེ་ཏོག་འཛིན་པར་འཚལ།",
    "བདག་ལྟའི་སྨྲ་བ་ཁྲི་ཡང་མི་བསིལ་མོད།",
    "བརྟགས་ན་ཡིག་འབྲུ་གཅིག་གི་དོན་ལ་ཡང་།",
    "རེ་བའི་འབྲས་བུས་ཡོངས་སུ་འགེངས་པར་སྨོན།",
    "གཡང་གི་མེ་ཏོག་འབུམ་ཕྲག་རྒོད་པ་ཅན།",
    "འདིར་གནས་ཡི་ག་འཇོ་བའི་ཕྱག་གི་རིས།",
    "འགོག་མེད་ཉི་ཟླའི་འགྲོས་ལ་གཟིགས་པར་འཚལ།",
    "ཡུམ་ཆེན་གངྒཱའི་ལྷ་མོར་གསོལ་བ་འདེབས།",
    "བློན་པོ་སོ་མ་བྷ་དྲར་གསོལ་བ་འདི་བརྟག་གཞི་ཆེ་ཡང་བསྐུལ་མོས་ལྟར་བྲིས།",
    "པདྨ་ཀ་རའི་ལུང་གིས་བསྔགས་པ་བཞིན།",
    "ལུང་གི་དོན་ལ་ཐོས་པས་སྒྲོ་འདོགས་བཅད།",
    "རྒྱ་ཁབ་ཕྲ་མོས་གོས་བཟང་སྦྲེལ་བ་བཞིན།",
    "མཚོ་དང་རྒྱལ་གྱི་མཐའ་ལྡན་བདག་གིས་བསྡུམས།",
    "བསྟན་ལ་གཟིགས་པ་རྣམ་དག་མཁྱེན་པའི་གཏེར།",
    "དེ་ལྟར་མཆོག་གི་ཉི་ཟླ་རྣམ་གཉིས་ལ།",
    "ཆུ་ཚན་གྱི་གྲོགས་དན་བརྩེ་གཟིགས་ཆེ།",
    "ལུས་འདི་ན་གནས་པའི་དགེ་སྦྱོང་གིས།",
    "སྒོས་རང་རེའི་ཚེ་འདི་རྩྭ་རྩེའི་ཟིལ།",
    "སྡིག་རི་བོ་རང་གི་མགོར་ཐོགས་ནས།",
    "གཏམ་ངན་པ་ཤུལ་ལུས་ཡི་རེ་མུག།",
    "གལ་ཆེ་བའི་མགོན་དཔུང་ཚོལ་རེ་རན།",
    "དེ་རང་གིས་རང་བསླུས་ཁོ་ནར་ཟད།",
    "རྨོངས་པ་དང་བྱིས་མཚར་རྒོད་རེ་བྲོ།",
    "འདི་ད་རེས་དོ་གལ་མི་ཆེ་ཡང་།",
    "ཡིད་སྐྱོ་བས་རང་དགར་ཁ་ནས་ཐལ།",
    "དམ་པའི་གསུང་གི་མེ་ཏོག་འཛིན་པ་གསོན།",
    "ཚེ་སྦྱིན་ལྷག་པའི་ལྷ་མོ་ཟླ་བའི་བཞིན།",
    "དབྱངས་བདུན་རྫོགས་པའི་མགྲིན་ཅན་འབུམ་ཕྲག་གིས།",
    "བརྒྱད་ལྡན་རྫིང་བུས་སྐོམ་པའི་རྗེས་སོང་ཡང་།",
    "ཕྱིར་ཞིང་སྤོང་བའི་ཀྲྀ་ཀྲྀའི་རྨི་ལམ་གཟིགས།",
    "མཁའ་གླང་གློག་གི་བུ་མོའི་ཟློས་གར་གྱིས།",
    "རང་ལ་རང་གི་བློ་ཡིས་ལེགས་དཔྱད་ནས།",
    "ཤེས་རབ་མིག་སྦྱིན་མཆོག་གི་སློབ་དཔོན་དང་།",
    "ཁྱོད་ནི་མ་རབས་བྱ་བས་མ་མགུ་ཞིང་།",
    "དབེན་པར་དབེན་གསུམ་བདག་གིར་བཟུང་བ་འདིས་།",
    "རྣམ་དཔྱོད་ཞིབ་ཎྞཾམོས་དཔྱོད་པའི་རིགས་པ་ཚུགས།",
    "ཞེས་ལྷ་རམས་པ་ཤེས་རབ་རྒྱ་མཚོས་ལྷ་རེག་བཅས་ས་འབྲུག་ཟླ་ཚེས་ལ་ཕུལ།",
    "དགེ་ལེགས་སྣ་ཚོགས་ལས་ཀྱི་སོར་མོའི་རིས།",
    "བློ་མཆོག་མཁའ་ཁྱབ་ཤེས་བྱའི་གཟིགས་མོ་ཅན།",
    "ཟུང་གི་ཞབས་དང་ལུང་ཁྱེར་གཟུ་བོ་ཡང་།",
    "རང་གི་སྒོ་གསུམ་སྡིག་ལྟུང་འདག་པ་སོགས།",
    "རྡོ་རྗེ་རྣོན་པོ་རིས་མཐུན་ངུར་སྨྲིག་གི་ཟློས་གར།",
    "ཟེར་སྒྲོས་ཁང་བྱིའུ་རྒན་མོའི་རྒུམ་བུ་ལྟར་བཏུས་ནས།",
    "གོ་རིགས་ཟུང་གི་མགྲོན་པོ་བགྲོད་པ་ལ་ཞུགས་ཚེ།",
    "འཕགས་བོད་གྲུབ་པའི་མཐའ་དང་གཞུང་མང་གི་སྤུ་རིས།",
    "མ་འདྲེས་འབྱེད་པའི་རེ་བ་ལ་སྒུག་འོས་ལྟ་ཅི།",
    "གཅིག་ཏུ་འདྲིས་གོམས་རང་སྲོལ་སྤྱིལ་ཆུང་གི་ཁར་ཡང་།",
    "ཆུང་ངུའི་དུས་ནས་ལུང་གི་དཀྱིལ་འཁོར་གཟིགས།",
    "ཉམ་ཐག་ཡི་ག་འཇོ་བའི་གསུང་གིས་སྐྱོང་།",
    "ཁེངས་ལྡན་གནམ་ལྕགས་རྡོ་རྗེ་ཐོག་གིས་འཇོམས།",
    "དོན་གཉེར་རེ་བ་ཡིད་བཞིན་སྐོང་བའི་གཉེན།",
    "ཆགས་སྡང་སྐྱོན་གྱིས་མ་གོས་དུང་གི་ལྗོན།",
    "ཤེས་རེ་རེ་རབ་རྒྱ་མཚོའི་ཞབས་ལ་གསོལ་བ་འདེབས།",
    "ཡིད་འཕྲོག་གསུང་གི་ཆ་ཤསལའང་།",
    "རང་གི་གམ་ན་འཁོད་པ་ལྔའི་ཁ་ཏོན་དུ་ཤཱཀྱའི་དགེ་སྦྱོང་རྒན་པོ་ཤེས་རབ་རྒྱ་མཚོས་སྦྱར་བའོ།",
    "མོས་པའི་བུ་ལ་བྱིན་གྱིས་རློབས་ཤིག།",
    "ཁྱོད་ལས་རེ་ས་གཞན་ན་མེད་པས།",
    "སྲོག་དབུགས་ཕྲ་མོ་འདི་ལས་མེད་ཅིང་།",
    "ལྷུན་པོའི་རྩེ་ཡང་ཐལ་བར་འགྱུར་ན།",
    "རྟག་ཏུ་མཛུབ་མོས་བགྲངས་ནས་སོམས་ཤིག།",
    "ཕྱི་དྲོ་གར་སོང་ཆ་མ་འཚལ་བའི།",
    "གློག་གི་བུ་མོ་འཁྱུག་པའི་གར་དང་།",
    "ངོ་ཚ་ཁྲེལ་འདས་དག་གིས་བསྒྲགས་པས།",
    "རང་རེའང་དེ་ལ་སྤྲོ་བས་འཇུག་མོད།",
    "ཉིན་རེར་ལུས་ངག་ཡིད་ཀྱི་སྒོ་ལ།",
    "དོན་གཉིས་ལག་པའི་རྩེ་མོར་འབྱུང་ངོ།",
    "ཡེ་གདོད་ནས་སྡུག་གིས་གདུངས་པའི་མགོན།",
    "འཛིན་མི་དམན་གློག་གི་ཉམས་འགྱུར་གྱི།",
    "གླེན་པ་ཀློ་མོ་གླང་གི་རྩེར་འཛེགས་ཀྱང་།",
    "རང་རེའི་སོ་སོར་རང་རིག་ལྟ་བུར་སོང་།",
    "བལ་ལྡན་ལུག་གི་ཨ་མ་འཆད་པའི་ཁྲིར།",
    "བསམ་ཞིང་བསམ་ཞིང་ཡི་རེ་མུག།",
    "རྗེས་སུ་ཕྲེང་རྡོག་ཞིབ་མོར་འདེད་ཆོག་པ་བཅས་རྣམ་ཀློང་ཟབ་མོར་བསྟི་བ་མཁྱེན།",
    "རྒྱལ་ཡུམ་སྒྲུབ་པའི་འདུན་མོས་ཅན།",
    "མཆོག་གི་དམ་པ་ཁྲེལ་བའི་གནས།",
    "མཆོག་གི་སྐྱེ་བོ་ཉིན་སྐར་བཞིན་།",
    "རྒྱལ་ཕམ་རེ་དོགས་ཚེར་མས་གདུངས།",
    "མཆོག་གི་མིང་སྙན་དགོས་པ་ཆུང་།",
    "མཆོག་གི་ལྟ་བ་བསྐྱེད་བྱས་ན།",
    "རྒྱལ་བའི་ཐུགས་བཅུད་ཨ་མའི་ལུགས།",
    "མཆོག་གི་གླུར་ཡང་དཀའ་བ་མེད།",
    "མཆོག་གི་དངོས་གྲུབ་འདྲེད་བྱེད་དེ།",
    "མཚན་འཛིན་དུག་གིས་ཟིན་ན་ནོངས།",
    "མཚན་མོའི་མགོན་པོ་ལྟ་བུར་འགྱུར།",
    "མཚན་དཔེས་སྤྲས་པ་འདོད་ན་རེམས།",
    "མཆོག་གི་མདུན་སར་བདུད་རེ་སྲིད།",
    "མཆོག་གི་རེ་བ་རུས་སྦལ་སྤུ།",
    "དཀོན་པར་གྱུར་པ་མ་ལགས་མོད།",
    "མཆོག་གི་མཛའ་སེམས་འདྲེས་པའི་སླད།",
    "མཆོག་གི་རྫས་སུ་དགོངས་ནས་བཞེས།",
    "རྒྱལ་བས་རྗེས་བཟུང་བདག་གི་སྟེ།",
    "ཚངས་པའི་ཐིག་གི་ལམ་ནས་སྨྲས།",
    "མརྒད་ནེའུ་གསིང་རི་ཆུའི་ལང་ཚོ་ཅན།",
    "དེ་ལ་མཆོག་གི་རོལ་མོ་འདི་ལྟར་བརྡུང་།",
    "ཡིད་ཀྱི་མཁའ་ལ་ཉིན་རེ་བཞིན་དུ་འཁྲིགས།",
    "ཡིད་འཕྲོག་མིག་གི་བདུད་རྩིར་འཛག་བཞིན་དུ།",
    "རྒྱ་བོད་གཞུང་བརྒྱའི་ཀློང་ན་གློག་གི་གར།",
    "སྲིད་ཞིའི་མིག་དག་ཡུ་མོའི་བརྟུལ་ཞུགས་འཛིན།",
    "ཚེ་ཡི་གཡོ་བ་གློག་གི་སྤུན།",
    "སྲོག་གི་གཤེད་མར་འགྱུར་བའང་སྲིད།",
    "རང་གི་འོག་ན་རྒྱུ་བའི་འབངས།",
    "ཉིན་མོའི་ཟས་དང་མཚན་མོའི་གཉིད།",
    "ཅི་སྙམ་ཞིབ་མོར་དཔྱད་པའི་རིགས།",
    "ནང་གི་མུན་པ་འབྱིན་པར་མི་ནུས་པས།",
    "ཁྲིད་དང་ཉན་པའི་མིང་གིས་ཅི་བགྱིར་མཆིས།",
    "ཡིག་འཇོ་བའི་རི་མོ་ཆད་མེད་འཚལ།",
    "སྣང་སྟོང་ཟུང་འཇུག་ཟབ་མོའི་ང་རོས་མུ་སྟེགས་གླང་ཆེན་བྱེ་བའི་ཁྱུ།",
    "ལྷམ་མེར་མཛེས་ཞེས་སྨྲ་བའི་མགྲིན་པ་རང་གི་དོན་ལ་ཅུང་ཟད་བཏེགས།",
    "དེ་སྲིད་ཁྱོན་ཡངས་དབྱིག་གི་བློ་གྲོས་ངོ་མཚར་འབུམ་དུ་མཛེས་གྱུར་ཅིག།",
    "པ་སངས་རྣམ་གནོན་མཆོག་གི་མཚན་མ་ཅན།",
    "ནོར་ལྷ་གཡང་གི་བུམ་པར་བསྐྱིལ་བ་དང་།",
    "བུ་ཁྱོད་རིག་པའི་གདོང་ལ་བསྐྱེད་པར་མཛོད།",
    "བུ་རུ་སྐྱེས་ཀྱང་རི་མོའི་མི་དང་མཚུངས།",
    "སངས་གསལ་ཤེས་རློམ་ཕལ་མོ་ཆེ་བའི་ཁ།",
    "ངག་གི་རང་བཞིན་འདོད་པ་འཇོ་བའི་བ།",
    "ནོར་འཛིན་སྒེག་མོའི་རྣ་ལུང་སྙན་ཚིག་ལ།",
    "བུ་ཁྱོད་སྨྲ་བའི་མགྲིན་པ་ཡངས་པོར་གྱིས།",
    "འཕེལ་རྒྱས་ལེགས་པའི་ལམ་དུ་འདེགས་ལ་རེམས།",
    "ཁྱོད་ལ་དྲིན་གྱི་ཕུང་པོ་མི་དམའ་བ།",
    "མི་འགྱུར་ཏིང་འཛིན་མཆོག་གིས་གུས་བསྟེན་ནས།",
    "རྒྱལ་ཀུན་གསང་གསུམ་ཚོམ་བུར་མོས་པའི་བློས།",
    "དལ་གྱིས་བཀླགས་ཤིང་ཞིབ་མོར་བསམ་པར་བྱ།",
    "ཟུར་དང་རྣམ་པའི་ཕྲ་མོ་རེ་རེར་ཡང་།",
    "ཟབ་གསལ་ཤེས་རབ་རྒྱ་མཚོ་སྐྱིལ་གྱུར་ཅིགཅེས་རབ་རྒྱལ་ལྕགས་རྟ་ཟླ་ཚེས་ལ་གང་གི་སློབ་དཔོན་གྱི་མིང་འཛིན་ལུང་རིགས་རབ་འབྱམས་སྨྲ་བའི་བཙུན་པ་པྲཛྙཱ་ས་མུ་དྲས་ལྷག་པའི་བསམ་པ་རྣམ་པར་དཀར་བའི་རང་མདངས་སུ་ཕུལ།",
    "གཟིགས་པའི་སྤྱན་ནི་མ་མཆིས་ཤིང་།",
    "ངོ་མཚར་སྟོང་གི་རྩེ་མོར་འཛེགས།",
    "མི་འགྱུར་རྡོ་རྗེའི་རི་མོར་ཡོངས་སྨིན་ཞིང་།",
    "གང་གི་ཞབས་ཟུང་རྡོ་རྗེའི་ལྷུན་པོར་འཁུ།",
    "གནམ་གྱིས་བསྐོས་པའི་ཆབ་སྲིད་དགུང་ལ་རེག།",
    "དྲག་རྩལ་སྟོང་གིས་རྣམ་རོལ་སྲུང་མ་ཆེས།",
    "མཚོ་བྱུང་ངང་མོ་རོལ་བའི་འོ་མཚོ་དེར།",
    "སྒྲོན་བསྐལ་མཆོག་གི་མཆོག་གི་རྒྱན་གང་ཞིག།",
    "ཁྱོད་སྐུ་རྣམ་དག་རྣམ་དག་མཚན་དཔེས་མཛེས།",
    "ཕུལ་བྱུང་སྙན་ཚིག་ཚིག་གི་རོ་མངར་བ།",
    "བར་མེད་ལྟད་མོ་མོ་རྡེལ་བཀྲམ་པ་བཞིན།",
    "དེ་ལ་གཟིགས་ནས་དེ་ཡི་བདེན་པའི་དོན།",
    "གཏམ་དུ་སྤྲོ་བའི་ངག་རྩལ་མ་མཆིས་མོད།",
    "མོད་ལ་དཔྱོད་ལྡན་འཛུམ་མདངས་འབྱིན་པའི་དབྱངས།",
    "དབྱངས་ཀྱི་ལྷ་མོར་ཕྱོགས་ནས་སླར་ཡང་གསོལ།",
    "སྟོབས་བཅུའི་མཛོད་འཛིན་བདེ་ལྡན་ཞིང་གི་མགོན།",
    "འགའ་ཞིག་རིགས་ལམ་ཕྲ་མོའི་འཕྲུལ་གྱིས་དབེན།",
    "ཀུན་གཟིགས་མཆོག་དེ་ཀུན་ནས་དགྱེས་པ་སྐྱེད།",
    "གང་གིས་གང་ལ་ཕབས་པའི་བཀའ་ཡི་ལུང་།",
    "དེ་ཕྱིར་ཁྱོད་ཚུལ་ཕྱོགས་ཀྱི་ཐང་ཡངས་པོར།",
    "ངོ་མཚར་གསུང་གི་བདུད་རྩི་འཛགས་དང་ལྷན།",
    "ངོ་མཚར་དེ་ལ་བདག་གི་ཡིད་ཀུན་སོང་།",
    "དབྱངས་ཀྱི་ལྷ་མོའི་རིགས་སྐྱེས་ཕྱིར་ན་རུང་།",
    "ཉིན་མོར་བྱེད་པའི་གྲོགས་དང་བསྡོངས་ནས་ཐལ།",
    "བུ་ཁྱོད་ཀྱི་མགོན་དུ་མཛེས་གྱུར་ཅིག།",
    "དཔལ་གཡང་མོ་ལུག་གི་དུས་ཚོད་དུ།",
    "ལྷོ་འབྲས་མོ་ལྗོངས་ན་ཆེ་བའི་ཕུལ།",
    "མི་ཁོ་བོའི་མིག་སྔར་བབས་པའི་མོད།",
    "དེ་ཁྱོད་ལ་ཚངས་པར་འགྱུར་རམ་ཅི།",
    "རྟ་གཡུ་བྱའི་གོང་ལ་འབུད་པའི་ཚེ།",
    "ཁྱོད་གནས་ལ་བསྐོར་བས་མ་འགྱངས་པར།",
    "ཁྱོད་འདི་ན་འདུག་དང་དེར་སོང་བའི།",
    "དེ་ཁྱོད་ཀྱིས་ཤེས་སམ་མུན་པ་ཅན།",
    "སྲོག་འཕྲོག་གི་ཚ་བ་འབར་བ་དང་།",
    "ཐག་རིང་གིས་གྲོལ་དུ་རེ་བའི་མི།",
    "ཟང་ཟིང་ལ་བཀོལ་བ་ཡིད་རེ་ཕམ།",
    "རང་མོས་པའི་མདུན་ན་ཐུབ་པ་མཛོད།",
    "ཁྱོད་མ་ལ་སྐྱེས་པའི་བུ་ཡིན་ན།",
    "དངུལ་སྒོར་མོ་དུང་ཕྱུར་འབུམ་པ་ཡང་།",
    "འཆི་བདག་གིས་བཟུང་བའི་སང་གནངས་མོ།",
    "ཁྱོད་རང་ལོ་ན་སྟོབས་ཞན་དང་གཉིས།",
    "ཁྱོད་ཀྱིས་ཀྱང་དེ་ལྟར་བསམ་ན་འཚེངས།",
    "བདེན་བཞི་ལ་དཔྱད་སྟོབས་མི་ཆུང་མོད།",
    "ཁྱོད་དྲན་པས་མ་བཟོད་འདི་འདྲ་ཐལ།",
    "ཁྲི་གའི་ལྷུན་འགྲུབ་རྒྱ་གར་དུ་སོང་བ་ལ་གནང་བའོ། ། བློ་གྲོས་མཆོག་གིས་ན་ཕྲའི་མཚང་འབྱིན་ཕྱིར།",
    "བློ་ལ་གཞལ་བྱའི་རི་མོ་མ་ལུས་བཀྲ།",
    "བཟང་ཋཱཎྜཱ་བཙུན་སྟོང་གི་རྩེར་འཛེགས་རྣམ་དཔྱོད་དང་།",
    "ཤེས་པའི་འཇུག་པ་འཇོང་མོ་རྡོ་བའི་ཟླ།",
    "འཛིན་མའི་གནས་ཚུལ་བསམས་ན་ཡིད་རེ་ཕམ།",
    "རྒྱ་ཁབ་ལྟ་བུའི་ཕྲ་མོར་མ་ལུས་པར།",
    "ད་ལྟ་དགེ་མིང་པས་ཁ་ཁོམ་ལག་ཁོམ་གྱི་རོལ་རྩེད་དུ་ཕུལ། ། མཛེས་མཛེས་མིག་གི་བདུད་རྩིར་མཛེས་མཛེས་མཐོང་ན་གྲོལ་བའི་མཚན་དཔེའི་སྐུ།",
    "མི་གསུམ་བླ་ཆེན་ཀླུ་མེས་ལ་སོགས་བསྟན་འགྲོའི་རྩ་ལག་དེ་དག་གི།",
    "འཕགས་ཡུལ་པཎ་གྲུབ་བྱེ་བའི་རྩེ་མོར་འཛེགས།",
    "གྲགས་སྙན་ཕྱོགས་ཀྱི་བུ་མོས་གླུར་ལེན་པ།",
    "བྱས་བསགས་ཕྲ་མོའི་འབྲེལ་བ་ཐོགས་པ་ཡང་།",
    "དུས་ཡུན་རིང་རྐྱེན་རྒུད་སྐྱོན་ཅི་ཆེར་བརྟེན་རབ་བྱུང་རྒྱལ་པོའི་བགྲང་བྱའི་ཉག་མ་གསུམ་པ་ས་མོ་སྦྲུལ་ལོར་ས་སྟེང་གི་རྒྱལ་བསྟན་ཡོངས་ཀྱི་མངའ་བདག་ལྷ་གཅིག་ཕྱག་ན་པདྨོ་སྡོམ་བརྩོན་འཁོར་ལོས་བསྒྱུར་བའི་རྣམ་པར་རོལ་བ།",
    "འགྲོ་བ་མང་པོའི་དོན་བྱེད་ཅིང་འགྲོ་བོ་ཅོག་གི་ཀུན་ལ་མི་མཐུན་པ་མེད་དོ།",
    "གཙུག་ལག་ཁང་གི་དོན་དུ་ནི།",
    "ཚིག་གིས་རབ་ཏུ་བསྐུལ་བ་དང་།",
    "བགྲང་གིས་མི་ལང་ངོ།",
    "སེམས་ཁྱོད་དགའ་བ་འདི་ལྟར་སྐྱེད་ན་ལེགས།",
    "ཚུལ་འདིར་ལུས་ཀྱིས་བགྱིས་དང་ངག་གིས་སྨྲས།",
    "མིང་གི་ལྷག་མར་གཞིག་པ་དམ་པའི་བློ།",
    "རང་སྤྱི་ཤེས་བྱའི་རི་མོ་ལྟ་བའི་མིག།",
    "དེ་ནས་ཛམྦུ་ནཱ་དའི་སྒྲ་དབྱངས་ཀྱིས་ཁྱད་པར་དུ་བྱས་པའི་གླིང་འདིར་གཟིགས་པ་རྣམ་པ་ལྔས་དགྱེས་པར་གཟིགས་ནས་ཡུམ་གྱི་ལྷུམས་སུ་ཞུགས་པ་དང་།",
    "གནས་དེར་དབྱར་གནས་པ་ཞལ་གྱིས་བཞེས་ཤིང་སྒྱུ་འཕྲུལ་ལྷ་མོའི་སྐྱེ་སྲིད་བདེན་པ་བཀོད་པ་སོགས་འདོད་ལྷ་རིགས་དྲུག་གི་གདུལ་བྱ་མུ་མཐའ་མ་མཆིས་པའི་དོན་མཛད་དེ་དེད་དཔོན་རྙེད་པ་གྲུབ་པ་དང་ཚུལ་མཚུངས་པར་གྱུར་པ་ན།",
    "རྣམ་འདྲེན་སྟོབས་བཅུ་མངའ་བ་མཐའ་དག་གི་གསང་གསུམ་མི་ཟད་རྒྱན་གྱི་འཁོར་ལོའི་མཛོད་ཆེན་པོ།",
    "ཁྱོད་ཉིད་བྱིས་པའི་གཟུགས་ཀྱིས་ནི།",
    "བློ་བཟང་ཉིན་མོར་བྱེད་པ་ཁྱོད་བྱོན་ཚུན།",
    "ཞེས་བསྔགས་པ་ལྟར་གངས་རིའི་ལྗོངས་ན་སེངྒེ་དཀར་མོ་སྲབ་མེད་ཀྱི་སྤུན་ཟླར་རྩེན་པའི་གྲགས་སྙན་ཕས་རྒོལ་ཟིལ་གནོན་སྲིད་པའི་རྩེ་མོའི་བར་དུ་ལྡིར།",
    "ཞེས་གསུངས་པ་ལྟར་ཐུགས་སྲས་ཉི་ཟླ་ལྟ་བུ་རྣམས་ཀྱིས་དགུང་ཞག་ཞེ་དགུའི་བར་དུ་དཀྱིལ་འཁོར་སྒྲུབ་མཆོད་སོགས་དགོངས་རྫོགས་ཀྱི་རིམ་པ་ཟབ་མོ་སྐུ་ཉམས་སུ་བསྟར་བ་ལ་བརྟེན་ནས་དགའ་ལྡན་ལྔ་མཆོད་ཆེན་མོ་ཞེས་ཡོངས་སུ་གྲགས་པ་འདི་ཉིད་བྱུང་ཞིང་ཕྱོགས་ཀུན་ཏུ་དར་བར་གྱུར་ཏོ།",
    "འདི་ཀོ་སྣང་བྱེད་སྟོང་གི་རྩེ་མོར་འཛེགས།",
    "ད་དུང་རྒྱལ་བ་སྲིད་དུ་བརྩེ་བས་གཟིགས།",
    "ཐོས་དང་རྣམ་དཔྱོད་རྩེ་མོ་བསྒྲིལ་བ་ལས།",
    "རྣམ་རོལ་ངེས་དོན་མཁས་པའི་གཟིགས་མོར་བརྗིད།",
    "ཀྱེ་མ་བསམ་ཞིང་བསམ་ཞིང་ཡི་རེ་མུག།",
    "བསྟོད་པ་འདི་ཡིས་ལྷ་སྲས་ཁྱོད་ཀྱི་ཐུགས།",
    "དགྱེས་པ་སྐྱེད་སྙམ་རེ་བ་བདག་ལ་མེད།",
    "གང་བློ་ཤེས་བྱའི་ཕ་མཐའ་ལ་སོང་བས།",
    "ལམ་བཟང་མཐར་ཐུག་རང་གིར་བགྱིས་པའི་ཟིལ།",
    "རང་རེའི་དོན་དུ་དམ་བཅའ་རྡོ་རྗེའི་ཁུར།",
    "རྒྱལ་ཀུན་དགྱེས་པའི་རོལ་མོར་གྱུར་པ་ཐོས།",
    "ཙོང་ཁའི་མིང་གི་ཡིག་འབྲུས་ཀྱང་།",
    "ཀུན་གཟིགས་སེངྒེ་ང་རོའི་སྐུ།",
    "རང་གི་ཆེ་སྲིད་འཆོར་དུ་དོགས་པའི་བློས།",
    "མིག་གི་འཇུག་པ་རྣོ་བར་གྱིས་ལ་ལྟོས།",
    "རང་གི་ཕན་བདེ་བ་མོའི་དཔལ་ཡང་རིང་དུ་མི་གནས་ནུབ་པར་འགྱུར།",
    "ཕ་རོལ་ཐལ་བས་སུན་འབྱིན་རལ་གྲིའི་ཆར།",
    "རང་གི་ཞེ་འདོད་སྒྲུབ་ངག་བདུད་རྩིའི་རྒྱུན།",
    "རྩོད་ངག་རྒྱན་དྲུག་དགྱེས་པའི་རོལ་མོ་མཚར།",
    "ཚིག་གི་སྦྱོར་བ་ཡིད་འོང་དཔའ་བོའི་མགྲིན།",
    "མཐོང་ཐོས་དྲན་རེག་དོན་ལྡན་དུ།",
    "དེ་ལྟ་མོད་ཀྱི་མེ་ཏོག་ལ།",
    "བླང་དོར་གནས་ལ་ལུང་གི་ཞུ་བ་བཞིན།",
    "ཉེས་སྐྱོན་ཆེན་པོའི་སྒོ་ཡང་ངང་གིས་འགག།",
    "བུད་བསྙེགས་ཐོབ་གསུམ་འགྲིག་གི་གོས་འོག་ཏུ།",
    "ཟག་ཟད་ཐུགས་ཀྱི་གསང་བ་ཟབ་མོས་དངོས་སུ་གཤེགས་ཤིང་བྱིན་བརླབས་པ།",
    "འདི་ན་སུ་ཞིག་སྙམ་དུ་སེམས་ཏེ་ཀུན་གསལ་གློག་གི་སྒྲོན་མེར་བགྲོས།",
    "རིམ་པར་བབས་པའི་སོར་རིས་མ་ཉམས་མིག་གི་བདུད་རྩིར་འདི་ན་འཁྱིལ།",
    "གནས་འདིའི་ཆེ་བ་རེ་རེ་ཡང་།",
    "རྩྭ་རྩེ་ཕྲ་མོའི་ཟིལ་བ་ཙམ།",
    "རང་གི་དད་པའི་གསོས་སུ་བླངས།",
    "གོ་མིང་ཀྲིན་ཧྥུའི་བཀའ་ལུང་གིས་ཧྥུའུ་ཇའོ་ཤོན་ཇིའི་ཁྲན་སིར་བསྔགས་པ་ཤཱཀྱའི་དགེ་སྦྱོང་ཤེས་རབ་རྒྱ་མཚོ་འཇམ་དཔལ་དགྱེས་པའི་བློ་གྲོས་ཀྱིས་སྦྱར་བ་ཛ་ཡནྟུ།",
    "ང་ཡི་མིང་གི་ཐོག་མ་དེས།",
    "ངེད་ཀྱི་དེ་དང་ཁྱེད་ཅག་གི།",
    "བསྟན་འཛིན་ལ་ཡང་ཆེར་བརྩེ་མོད།",
    "རང་རེས་ཞལ་འདེབས་བྱས་སམ་ཅི།",
    "རེ་ཡང་རེ་སྟེ་བྱུང་ཡང་བྱུང་།",
    "སྐྱེན་པར་དེ་ཡོང་རེ་འདུན་མིན།",
    "བདེ་བར་སྤྱོད་ལ་དགའ་མགུའི་མེ་ཏོག་གི།",
    "ཡི་གེ་རྩེ་མོ་མིག་སྔར་འགྲིམ་པ་ན།",
    "བོད་མིའི་ཁོང་ན་གསོན་རེ་བཅོས་མིན་ཞིག།",
    "རྒྱལ་ཁབ་སྤྱི་དང་རང་སྲུང་སྲོག་གི་གསོས།",
    "ཁྱེད་ཌ་རྡུང་དྲིལ་འཁྲོལ་དང་སྦ་མདུང་མཚོན་དུ་འཕྱར་བས་རོང་འབྲོག་གི་ནོར་སྐྱོང་བདེ་གསལ་མི་རྟོག་དྭངས་པའི་སྒོམ་ཉམས་སུབཞུགས་པ་ལ་མཛོད་རྩའི།",
    "དེས་མཚོན་བདག་གིས་ལུས་ཕྱུང་ན།",
    "ཞེས་སོགས་གསུངས་པའི་དོན་བཞིན་སྐབས་ཀྱི་ལྷུ་ཚང་བར་བྱ་བའི་ཕྱིར་སླར་ཡང་ནང་མའི་རི་མོར་སྤྲོས་པ་འདིའོ་ལོ།",
    "བོང་བུར་སྟག་གི་འདུ་ཤེས་འཛིངས་པའི་གཏམ།",
    "ཕྱི་གླིང་གི་སྣོད་འདི་དཀར་དང་གཅིག།",
    "དེའི་ནང་གི་ལུག་རྐང་ཞིམ་དང་གཉིས།",
    "ཉིན་རེ་བཞིན་བྱུང་ན་དེ་ས་སྐྱིད།",
    "རྒྱལ་ཚང་གི་མགོ་བསྐུལ་ལེགས་དང་གཅིག།",
    "ཁྲི་ཚང་གི་རམ་འདེགས་སྙན་དང་གཉིས།",
    "ཧཱུཾ་དུ་ལྡང་བའི་ངག་གིས་སྨྲ་བར་བྱ།",
    "གུང་ཁྲན་ཏང་དང་རང་རེའི་བླ་གྲྭའི་ཚུལ།",
    "ནང་གཙང་ཀུ་རེའི་ལན་གྱི་ཚིག་འདི་དག།",
    "དགེ་མིང་འདུ་གསུམ་པས་ལྷ་རེག་བཅས་ཟླ་ཚེས་ལ་ཕུལ། ། ཁྱད་པར་རྩེ་མོས་ཡོངས་སུ་འཛིན་པ་རུ།",
    "གནས་གསལ་རི་མོའི་ཚོགས་ཀྱི་སྤྱི་བོ་ན།",
    "བདག་ལ་རྒྱལ་བས་ཅི་དགོངས་ཞེ་རེ་འཚེར།",
    "འཕགས་མཆོག་འཇམ་དཔལ་དགྱེས་པའི་བློ་གྲོས་མོལ།",
    "མཚོན་བྱེད་རས་གཞིའི་རེ་ཁ་མི་སྡུག་པས།",
    "མི་སྙན་རྩུབ་མོའི་ཚིག་གི་ཚེར་མ་ཡིས།",
    "སྐབས་ཀྱི་མོལ་བཅུད།",
    "ཐོ་དབྱུག་འཕྱར་བ་བཟོད་དཀའི་ལྷ་སྲུང་གིས།",
    "གྲགས་སྙན་དོན་བཟང་ཁྱོད་ཡིད་སྤྲོ་བ་ལེགས།",
    "ང་སྙམ་མཐོ་བའི་ངང་ཚུལ་འགའ་རེ་སྲིད།",
    "རང་གི་ཆེད་བསྔགས་གསེར་གྱི་མ་ལི་ཀ།",
    "རང་མཚང་ཅན་རེ་མི་འབྱུང་ངེས་པའང་ཅི།",
    "ལེན་མཁས་ཚངས་པའི་སྲས་མོ་དབྱངས་ཅན་མ།",
    "ཕྱི་ནང་གསང་བའི་གླིང་བུ་འབུད།",
    "ཡ་ཐང་མ་ཐང་འབྲོག་གི་རྒྱན།",
    "བོད་དུ་ཐང་གི་གྲགས་པ་མཐོ།",
    "གང་ཡང་སོ་སོ་རང་གི་གཤིས།",
    "སྟག་ཚང་གཟིག་ཚང་འཇིགས་སུ་རུང་།",
    "དེ་ལྟ་མོད་ཀྱི་ད་ལྟའི་དུ་མ་ཞིག།",
    "མ་ནོར་རང་གིར་གྱིས་ཤིག་རྒྱལ་བའི་སྲས།",
    "ཐུགས་དགའ་མགུའི་ཀུ་རེ་ཅུང་ཟད་ཞུས།",
    "ཕྱི་ཕྱག་གི་རི་མོར་ནར་མར་སྤྲོས།",
    "ཀུན་མཐོང་གི་མོ་མ་འདི་ན་མང་།",
    "མཆོག་གི་ཞབས་རྡུལ་བློ་གསལ་བྱེ་བའི་ཏོག།",
    "རྟག་བརྟན་རྡོ་རྗེའི་རི་མོར་འབར་གྱུར་ཅིག།",
    "རབ་ཀྱི་རྩེ་མོར་འཛེགས་པ་ཁྱོད།",
    "རྒྱ་གླིང་གིས་ཀྱང་བསྔགས་སྙམ་དུ།",
    "ཡོན་ཏན་སྟོང་གིས་རློམ་པའི་བློ།",
    "ཡོན་ཏན་ལ་མོས་བདག་གིས་གཤུང་།",
    "ཟེར་དུ་བསྐྱེད་པར་བཞེད་པ་ཁྱོད།",
    "རྟ་དབྱངས་གཉིས་པའི་སྙན་ངག་གིས།",
    "བཀའ་ལ་བཀུར་བའི་གསེར་གཞིའི་ཁྱོན་ཡངས་པོར།",
    "གུས་འབངས་པུས་མོའི་ལྷ་ང་བཙུགས་ནས་བསྟར།",
    "ཐམས་ཅད་གསང་བ་ངན་སོང་སྦྱོང་།",
    "གཞུང་ལ་བརྟག་དཔྱད་ཞིབ་མོར་བྱ་བའི་རིགས།",
    "གོམས་འདྲིས་འདི་ལྟར་གྱིས་ཞེས་དཀར་ཆག་གི་དོན་བསྡུས་ནས་ཕྲན་ལ་གནང་བའོ།",
    "བདེན་གཉིས་བདེན་བཞིའི་ཁྱོན་ལ་མཁྱེན་པ་རྒྱས།",
    "འབྱེད་པར་མི་ནུས་མཆོག་གི་འདུན་པ་ཅན།",
    "ལྟད་མོ་སྟོང་ཕྲག་བརྒྱ་པའི་མིག།",
    "སྲོག་གི་འཚོ་བ་བརྟན་པའི་ངང་།",
    "སྤྱི་ལས་བྱེ་བྲག་གི་དངོས་པོ་བདག་ཅག་ཀེ་ལ་ཤ་རིའི་ངོགས་ན་འཚོ་བ་རྣམས་ཀྱི་མེ་ཏོག་ཕོགས་པའི་ལྷ་སྐལ།",
    "དམིགས་ཀྱིས་བསལ་བའི་མཛད་སྨོན་འབུམ་ཕྲག་གིས་ཁྱད་པར་དུ་བྱས་པ།",
    "རྒྱལ་བ་པཎ་ཆེན་ཞེས་ཡང་དག་པའི་དོན་དང་མཐུན་པའི་མཚན་གྱི་རོལ་མོ་འཛམ་གླིང་མཐའ་དབུས་དང་།",
    "རྒྱ་དཀར་ནག་སེར་གསུམ་ན་གཡུ་འབྲུག་དང་གངས་སེང་གི་ང་རོར་འགྲོ་བ་ནི།",
    "ཐ་མལ་ཆགས་སྡང་བདོ་བའི་ཆགས་སྡང་གི་ངོ་བོར་ཀུན་རྫོབ་སྒྱུ་མའི་རྫུན་རིས་ཐ་དད་པའི་རྣམ་འགྱུར་ཅུང་ཞིག་ཤར་བ་བསྟན་འགྲོའི་དོ་རར་ཕན་བདེའི་ཟློས་གར་བསྒྱུར་བ་ལས་ག་ལ་འདའ།",
    "རྨོངས་པ་ལུག་བོང་གི་ཟླ་བོར་འོས་པ་འགའ་འང་མཁས་ཁུར་ང་སྙམ་ཡིན་རློམ་གྱིས་འགྱིང་།",
    "ཀུན་གཟིགས་སྣང་མཐའི་ཉི་མ་ནི་བྱང་ཤར་ལ་འཁོར།",
    "མེ་ཤེལ་དང་རིང་བའི་སྨྲ་བ་ནི་འབར་རུང་གི་ས་བོན་ཙམ།",
    "སྐུ་གདུང་བསམ་འཕེལ་ནོར་བུའི་མདུན་སར་སྔོན་མེད་ཁྲི་འབུལ་གྱིས་སྣེ་བསུས་པའི་མཆོག་གི་ཉམས་འགྱུར་མཐོང་ན་གྲོལ་བས་བསིལ་ལྗོངས་སེར་སྐྱ་ཡོངས་ཀྱི་ཡི་ག་འཕྲོག་ན།",
    "བླ་གཞུང་གི་མཛའ་གཅུགས་རྒྱས་ན།",
    "འཛམ་གླིང་གི་ལེགས་ཚོགས་འཕེལ་ན།",
    "དམན་པའི་རེ་འདུན་དོན་གྱིས་སྟོང་བར་མི་འགྱུར་བ་དང་།",
    "བློ་ཡི་རྩེ་མོ་གཉིས་པ་གཞན་མེད་པས།",
    "རང་རེའི་སྐྱེ་བའི་ཡ་མཐའ་མི་མངོན་ཞིང་།",
    "བློ་དང་བརྩོན་པའི་རྩེ་མོ་གཅིག་ཏུ་སྒྲིལ།"
  ]
}