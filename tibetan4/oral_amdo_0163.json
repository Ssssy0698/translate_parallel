    "སློབ་བུ་དེས་ངར་ཆེན་འབྲུག་གི་ལྟ་སྟངས་ཞེས་བྱ་བ་ང་རྒྱལ་རང་གྲོལ་གྱི་ལྟ་སྟངས་བྱང་དུ་གཟིར་ལ།",
    "བུ་ཁྱོད་ནུབ་ཕྱོགས་སུ་རླབས་ཆེན་ཁྱུང་གི་ལྟ་སྟངས་ཀྱིས་ལྟོས་ལ།",
    "སློབ་བུ་དེས་རླབས་ཆེན་ཁྱུང་གི་ལྟ་སྟངས་ཞེས་བྱ་བ་འདོད་ཆགས་རང་གྲོལ་གྱི་ལྟ་སྟངས་ནུབ་ཏུ་གཟིར་ལ།",
    "འཁོར་རང་རང་གིས་ཉེ་འཁོར་ལ་བོན་སྟོན་པ་ཡོད་དོ།",
    "བུ་ཁྱོད་ལྷོ་ཕྱོགས་སུ་ཤུགས་ཆེན་རྟ་ཡི་ལྟ་སྟངས་ཀྱིས་ལྟོས་ལ་རྩོལ་བ་མེད་པའི་ཏིང་ངེ་འཛིན་གྱིས་བསྐྱོད་ཅིག།",
    "འཁོར་རང་རང་གིས་ཉེ་འཁོར་ལ་བོན་སྟོན་པ་ཡོད་དོ།",
    "བུ་ཁྱོད་དབུས་ཕྱོགས་ཀྱི་ཞིང་ཁམས་སུ་སྟོབས་ཆེན་གླང་པོའི་ལྟ་སྟངས་ཀྱིས་ལྟོས་ལ།",
    "གཟུགས་སྐུ་དེ་ལས་འདས་པའི་ཕ་རོལ་ན་དེ་དག་གི་འཆར་གཞིར་གྱུར་པ་རང་གི་རིག་པ་བསམ་ངོ་དང་བྲལ་བའི་ངོ་བོ།",
    "བུ་ཁྱོད་འགྲོ་ས་མེད་པའི་གཤིས་ལ་འགྲོ་མཁན་རྩ་གདར་ཆོད་ལ་ཞོག་ཅིག།",
    "ཐུགས་རྗེའི་རྩལ་ལས་སྐུ་དང་ཡེ་ཤེས་དབྱེར་མེད་བུམ་ནང་གི་སྒྲོན་མེ་ལྟར་གསལ་བའི་འོད་གདངས་ཤེལ་བུག་ཅན་ལས་འཐོན་ཏེ་སྒྲོན་མ་བཞིའི་རང་བཞིན་དུ་གསལ་བའོ།",
    "དེ་ལས་སྣང་བ་མཆེད་པའི་ཚུལ་དུ་འོད་ལྔའི་གདངས་ཁ་དོག་ལྔ་པ་ཟ་འོག་ཁ་ཕྱེ་བ་ལྟ་བུར་གསལ་བ་ནི་ནང་གི་དབྱིངས་ཕྱི་རུ་གསལ་བ་སྟེ་དབྱིངས་རྣམ་དག་གི་སྒྲོན་མ་ཞེས་བྱའོ།",
    "དེར་རྒྱང་ཞགས་གཟིགས་སྟངས་ཀྱིས་གཅུན་པས་ནང་གི་རིག་པ་ཤིན་དུ་དྭངས་ལ་ཡུལ་མེད་པ་ཞིག་ཉམས་སུ་མྱོང་བ་དེ་ནི་ཤེས་རབ་རང་བྱུང་གི་སྒྲོན་མའི་ངོ་བོ་ཡིན་ནོ།",
    "དེ་ལས་ལྷག་མཐོང་གི་རིག་པ་ལུ་གུ་རྒྱུད་མུ་ཏིག་བསྟར་ལ་བརྒྱུས་པའམ།",
    "ཨེ་མ་སྐལ་བ་དང་ལྡན་པའི་བུ་ཁྱོད།",
    "ཀྱེ་སྐལ་བ་དང་ལྡན་པ་ཁྱོད་ཉོན་ཅིག།",
    "སྐྱིད་འདོད་ཀྱི་རེ་བ་མ་བྱེད་ཅིག།",
    "ཁྱེད་ལས་རེ་ས་གཞན་མེད་པས།",
    "རྗེས་སུ་གཏང་རག་གི་ཚོགས་ཀྱི་འཁོར་ལོ་བསྐོར་རོ།",
    "བཀྲ་ཤིས་བྱ་ཞིང་འབྲུ་དང་མེ་ཏོག་གི་ཆར་བསྙིལ་ལོ།",
    "མན་ངག་ཟབ་མོ་ལྐུགས་པའི་ནོར་བཞིན་ལུས།",
    "དེའི་ཕྱིར་བདག་གིས་འདི་ཉིད་གསལ་བར་བྱས།",
    "གདམས་ངག་ཟབ་མོ་འཕྲོ་ཅན་དུ་ལུས་ན་རྗེས་འཇུག་བློ་ལྡན་རྣམས་ལ་ཕོངས་སེམས་འབྱུང་ངེས་པས།",
    "སྐལ་ལྡན་ཁྱོད་ལ།",
    "སོསྐལ་ལྡན་རིགས་ཀྱི་བུ་ཁྱོད་ལ།",
    "སྐལ་ལྡན་རིགས་ཀྱི་བུ་ཁྱོད་ལ།",
    "འདིར་མཆོག་ལྔའི་ད་བང་བསྐུར་བ་ལམ་སྒོ་དབྱེ་བ་སོགས་སྔོན་དུ་སོང་ནས།",
    "བསྭོ་ཡཱཾ་ཨ་མ་མུ་ཡེ་པྲ་ཕུད་ཉི་རི་བྷ་ར་ཏྲང་འདུ",
    "དབལ་གསས་རྔམ་པ་རྔམ་མོ་ཡུམ་།",
    "གཙོ་མཆོག་མཁའ་འགྱིང་གདུག་མོ་ཡུམ།",
    "སྒོ་བཞི་བསྲུང་མཛད་ཁྲོ་མོ་བཞིས།",
    "བསྭོ་ཡཱཾ་ཨ་མྲི་ཏ་ཏིང་མུར་དང་ར་རཏྣ་ཉི་རི་བྷ་ར་ཏྲང་འདུ",
    "ཉོན་མོངས་ཤེས་བྱའི་སྒྲིབ་དག་ནས།",
    "མཁའ་འགྲོ་སྐལ་པ་བཟང་མོ་ཡིས།",
    "མཁའ་འགྲོ་སྲིད་པའི་རྒྱལ་མོ་ཡིས།",
    "སྐལ་ལྡན་རིགས་མཆོག་བུ་ཁྱོད་ལ།",
    "སྡོམ་པ་གསུམ་གྱི་བསླབ་པ་མིག་གི་འབྲས་བུ་བཞིན་དུ་བསྲུང་།",
    "ཁྱོད་ལ་འཆི་བ་མི་རྟག་པ་བྱ་བ་བྱུང་ནས་ཤི་བ་ཡིན་ནོ།",
    "སྐྱེས་ནས་ད་ལྟ་ཤི་ལ་ཐུག་གི་བར་དུ་ནི།",
    "སྨིན་མཚམས་ནས་ཐད་ཀར་སོར་བཅུ་དྲུག་གི་བར་ལ་རིག་གདངས་འགག་པ་མེད་པའི་རྟགས་སུ་འོད་ཟླུམ་ཁྲ་གོ་རེ་བ་ཞིག་དཔག་ཆེན་གྱིས་མདའ་གསོར་བའི་ཡུན་ཙམ་དུ་འཆར་བ་དེ་ངོས་ཟིན་ན་གཞི་དབྱིངས་སུ་བཙན་ས་ཟིན་པ་ལ་ཐེ་ཚོམ་མེད་དོ།",
    "སྟེང་དུ་ཀ་དག་གི་སྣང་བ་ནམ་མཁའ་གཡའ་དག་པ་ལྟ་བུ་དང་།",
    "འོག་ན་རིགས་དྲུག་གི་སྣང་བ་དང་བཅས་པའི།",
    "སེང་གེའི་ཉལ་ལུགས་ཀྱིས་དབྱིངས་རིག་བསྲེས་ཏེ་དེའི་ངང་དུ་ཤི་ན་སྐད་ཅིག་ལ་ཡར་གྱི་ཟང་ཐལ་དུ་འགྲོ་སྟེ།",
    "མོ་ལ་དེ་ལས་བཟློག་པར་བྱ།",
    "ཁྱོད་འཇིག་རྟེན་འདི་ནས་ཞིང་ཁམས་གཞན་དུ་གཤེགས་པའི་དུས་ལ་ཐུག་པ་ལགས་ན།",
    "ཁྱོད་ད་ལྟ་ན་བ་ལྟར་སྣང་ངམ།",
    "གཞི་དང་རྩལ་གཉིས་སུ་མེད་པའི་ངང་ལ་ས་ལེ་སང་ངེ་རྗེན་ནེ་ཅེ་རེར་ཞོག་ཅིག།",
    "དབུགས་ཆད་མ་ཐག་ཁྱོད་ལ་རྣ་བ་ནས་བརྡ་སྤྲད་པ་ཡིན་གྱི།",
    "དེའི་ཚེ་ཁྱོད་ཀ་དག་གི་ས་ལ་སྐད་ཅིག་མ་གསུམ་ན་ཁྱོད་འཚང་རྒྱའོ།",
    "དེ་དག་གང་གི་དུས་སུ་ཡང་གང་ཤར་དེ་རང་སྣང་དུ་ངོ་ཤེས་ན་དེ་མ་ཐག་ཀ་དག་གི་སར་ཁྱེད་བདེ་བར་གཤེགས་སོ།",
    "ན་དགའ་འཆིར་བྲོད་རྣལ་འབྱོཪ་བློ་རེ་བདེ།",
    "ཐལ་བ་དབུགས་ཐལ་སྲོག་ཆད་རིག་པ་བརྒྱལ།",
    "སྐད་ཅིག་གཅིག་གིས་བསྐལ་པའི་སྐྱིད་སྡུག་ནུས།",
    "ཆེ་བསགས་ཆུང་བསགས་བཞག་ནས་སྐད་ཅིག་གིས།",
    "ཁྱོད་ལ་འཆི་བ་མི་རྟག་པ་འོང་བ་ཡིན་ནོ།",
    "དེ་ཡང་མི་རྟག་པ་ནི་ཁྱོད་གཅིག་པུ་ལ་འོང་བར་མ་ཟད།",
    "སྒོས་ཡུལ་ཁམས་འདིའི་མི་ཕོ་མོ།",
    "ཡང་སྒོས་རང་གི་ཁྱིམ་གང་གི་མི་རྣམས་ཀྱང་སྔར་འཆི་ཕྱིས་འཆི་ལས་མེད་དོ།",
    "དེའི་ཕྱིར་ཁྱོད་འཆི་བ་ལ་མ་སྐྲག་དང་།",
    "གལ་སྲིད་སྐྱེ་བ་ལེན་དགོས་བྱུང་ན་ལས་བཟང་གི་འཕྲོ་མཐུན་པ་ཡུར་བ་རྐང་ཆད་ལ་ཝ་འཛུགས་པ་ལྟ་བུའི་གདམས་ངག་བསྟན་ཏེ།",
    "དད་མོས་དྲག་པོ་བསྐྱེད་ཅིག།",
    "འཆི་བར་མ་སྐྲག་དད་མོས་རབ་བསྐྱེད་དང་།",
    "བདག་གིས་གདམས་ངག་ཟབ་མོ་ལ་བརྟེན་ནས།",
