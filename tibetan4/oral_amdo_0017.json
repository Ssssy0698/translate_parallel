    "མར་གྱིས་བཏགས་པ་ཉི་མ་རེ་རེར་སྟོང་ཕྲག་བརྒྱད་བརྒྱད་སྦྱིན་སྲེག་གྱིས་ཤིག།",
    "སྣ་མའི་ཤིང་གིས་མེ་རབ་ཏུ་སྦར་ནས་མེ་ཏོག་རྣམས་ཞོ་དང་།",
    "ཨ་མྲའི་ཤིང་གིས་མེ་རབ་ཏུ་སྦར་ནས་ཆུ་ཀླུང་གི་འགྲམ་དུ་ཞོ་དང་།",
    "ཀ་ར་བཱི་རའི་ཤིང་གིས་མེ་རབ་ཏུ་སྦར་ནས་དཀར་པོའི་བརྒྱད་པ་ནས་བརྩམས་ཏེ་ཇི་སྲིད་དཀར་པོའི་བཅུ་བཞི་པའི་བར་དུ་ཀ་ར་བཱི་རའི་ཞོགས་མ་འོ་མས་བཏགས་པ་སྟོང་ཕྲག་བརྒྱད་སྦྱིན་སྲེག་གྱིས་ཤིག།",
    "དེ་ནས་དཀྲུགས་ནས་བྲམ་ཟེའི་བུ་མོའི་ལག་པས་རྫས་འདི་རྣམས་འཐག་ཏུ་གཞུག་པར་བྱའོ།",
    "དཔལ་མོ་འོངས་ཏེ་མཆོག་སྦྱིན་པར་བྱེད་དོ།",
    "གི་རི་ཀརྞི་ཀ་དང་།",
    "གཉིད་དུ་སོང་བ་ན་ཁུ་བ་འཆིང་བར་འགྱུར་རོ།",
    "སེང་ལྡེང་གི་ཕུར་བུ་ལ་སྟོང་ཕྲག་བརྒྱད་བཟླས་པས་ལོ་ཐོག་ཐམས་ཅད་ཀུན་ཏུ་སྲུང་བ་དང་།",
    "ཐལ་བ་ལ་སྟོང་ཕྲག་བཟླས་པས་གང་གི་ཕྱོགས་སུ་གཏོར་བ་དེའི་ཕྱོགས་སུ་ཚེར་མ་ཟློག་པར་བྱེད་དོ།",
    "དེ་ནས་སེན་མོས་བཅད་པའི་ཏ་ལའི་འདབ་མ་ལ་རལ་གྲི་བྱས་ནས་དེའི་འདབ་མ་ལ་གུར་གུམ་གྱིས་བྲིའོ།",
    "ནག་པོའི་བརྒྱད་པའི་ཉི་མ་ནག་པོའི་བཅུ་བཞི་པ་ལ་གསོ་སྦྱོང་ལ་ངེས་པར་གནས་པས་གཅིག་པུ་རི་བོའི་རྩེ་མོ་ལ་འཛེགས་ཏོ་ཕྱོགས་སུ་དོར་ན་ཁྲུ་བརྒྱད་དམ།",
    "ཇི་སྲིད་རལ་གྲི་ལ་ཡོད་པའི་ནང་གི་སྔགས་ཀྱི་ཡི་གེ་དེ་རྣམས་འབར་བར་གྱུར་པ་དང་།",
    "དཀར་པོའི་ཚེས་གཅིག་ནས་བརྩམས་ཏེ་ཇི་སྲིད་བཅོ་ལྔའི་བར་དུ་ཉི་མ་རེ་རེ་ལ་སྟོང་ཕྲག་འཕེལ་བར་བྱས་ནས་བཟླས་པར་བྱའོ།",
    "ནག་པོའི་བཅུ་བཞི་པ་ལ་ཉིན་མཚན་དུ་སྨྱུང་བར་གནས་ཏེ་གཟུགས་བརྙན་གྱི་མདུན་དུ་པྲི་ཡང་ཀུའི་ཤིང་གིས་མེ་རབ་ཏུ་སྦར་ནས་བེ་ཀངྐ་ཏའི་ཡམ་ཤིང་སྟོང་ཕྲག་བརྒྱད་སྦྱིན་སྲེག་གྱིས་ཤིག།",
    "མཚན་མོ་གསུམ་དུ་སྨྱུང་བར་གནས་པས་ནག་པོའི་བཅུ་བཞི་པ་ལ་གུ་གུལ་གྱི་བདུག་པ་བསྲེགས་ཏེ་པཱ་ལའི་མེ་སྦར་ནས་ཞོ་དང་།",
    "ཕུག་གི་སྒོར་འབུམ་ཟློས་ཤིག།",
    "ཀླུའི་གནས་སུ་རས་རིས་བཞུགས་ནས་སྲུང་བའི་ཆོ་ག་བྱས་པས་ཛམ་བུའི་ཤིང་གི་མི་སྦར་ནས་མངར་གསུམ་གྱི་གཏོར་མ་བྱིན་ཏེ་ཀླུ་ཤིང་གི་མེ་ཏོག་སྟོང་ཕྲག་བརྒྱད་སྦྱིན་སྲེག་བྱའོ།",
    "ཉི་མ་རེ་རེ་ལ་དོང་ཙེ་བདུན་བདུན་རབ་ཏུ་སྩོལ་ཅིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "ཉི་མ་རེ་རེ་ལ་དོང་ཙེ་བདུན་བདུན་སྩོལ་བར་བྱེད་དོ།",
    "དཀར་པོའི་བརྒྱད་པ་ལ་མཚན་མོ་གཅིག་ཏུ་སྨྱུང་བར་གནས་པས་ཨ་ཏི་མུཀྟ་ཀའི་མེ་ཏོག་སྟོང་ཕྲག་བརྒྱད་དབུལ་བར་བྱའོ།",
    "ནག་པོའི་བཅུ་བཞི་པ་ལ་མཚན་མོ་གཅིག་སྨྱུང་བར་གནས་པས་མཚན་མོ་ཤིང་བ་ཏྱ་ཊ་ཀའི་རྩ་བ་རྣམས་བསྲེས་པའི་མེ་ལ་སྟོང་ཕྲག་བརྒྱད་སྦྱིན་སྲེག་གྱིས་ཤིག།",
    "མར་གྱིས་བཏགས་པ་རྣམས་བིལ་བའི་ཤིང་གིས་མེ་རབ་ཏུ་སྦར་ནས་འབུམ་སྦྱིན་སྲེག་བྱའོ།",
    "རས་རིས་ཀྱི་སྤྱན་སྔར་གི་ཝང་ངམ།",
    "གྲོང་གི་མཆོག་བཅུ་རྙེད་དོ།",
    "བདེ་བར་གཤེགས་པའི་མཐོ་གང་གི་ཚད་ཀྱི་མཆོད་རྟེན་བྱས་ནས་བདུག་པ་བསྲེགས་ཏེ་ཙམ་པ་ཀའི་མེ་ཏོག་སྟོང་ཕྲག་བརྒྱད་དབུལ་བར་བྱ་སྟེ་གསེར་སོ་སོར་རྙེད་དོ།",
    "བདེ་བར་གཤེགས་པའི་མཐོ་གང་གི་ཚད་ཀྱི་མཆོད་རྟེན་བྱས་ཏེ་མེ་ཏོག་གི་གེ་སར་སྟོང་ཕྲག་བརྒྱད་དབུལ་བར་བྱ་སྟེ་གོས་སྟོང་སོ་སོར་རྙེད་དོ།",
    "དུར་ཁྲོད་ནས་རོ་བསྲེགས་པའི་ཐལ་བ་བླངས་ཏེ་ཟླ་བ་ཉ་ལ་ཉིན་མཚན་དུ་སྨྱུང་བར་གནས་པས་མིང་མེད་ཀྱི་སོར་མོའི་ཁྲག་གི་ཟླུམ་པོ་བྱས་ནས་གཟུགས་བརྙན་བྲིས་ཏེ་རྐང་པ་གཡོན་པས་མནན་ནས་སྟོང་ཟློས་ཤིག།",
    "བདེ་བར་གཤེགས་པའི་མཐོ་གང་གི་ཚད་ཀྱི་མཆོད་རྟེན་བྱས་ནས་འབྲས་ཡོས་ལ་ཞོ་དང་།",
    "རིམས་གཞོམས་པར་འདོད་པས་གི་རི་ཀརྞི་ཀའི་མེ་ཏོག་སྟོང་ཕྲག་བརྒྱད་སྦྱིན་སྲེག་གྱིས་ཤིག།",
    "སེང་ལྡེང་གི་ཡམ་ཤིང་གིས་བརྒྱ་རྩ་བརྒྱད་སྦྱིན་སྲེག་གྱིས་ཤིག།",
    "ཐལ་བ་ལ་ལན་བདུན་བཟླས་ནས་གཞན་གྱིས་གསང་སྔགས་སྒྲུབ་པར་བྱེད་དོ།",
    "ནག་པོའི་བཅུ་བཞི་པ་ལ་མཚན་མོ་གསུམ་སྨྱུང་བར་གནས་པས་མཚན་མ་གཅིག་པར་སོང་ནས་ལུས་ཀྱི་གཡས་སུ་རས་རིས་བཞུགས་ཏེ་བཅིང་བར་བྱའོ།",
    "ཏོག་གཅིག་བླངས་ནས་ཀླུའི་གནས་སུ་སོང་སྟེ་མེ་ཏོག་ཀླུ་མཚོ་བྲན་དུ་བུག་ལ་སྔགས་བཟླས་པར་བྱའོ།",
    "ནག་པོའི་བརྒྱད་པ་ལ་ཁྲིའི་ཚོགས་ཅན་བླངས་ནས་གཞན་མོའི་བརྒྱད་པ་ལ་ཁྲོ་ཚོགས་ཅན་ལ་རྩེ་གསུམ་བྱེད་དུ་གཞུག་གོ།",
    "དེ་ནས་གྲུབ་པར་འགྱུར་ཏེ་མཚན་མོ་མ་བརྩིགས་པ་རུ་ལྷའི་ཁྱིམ་འབྱུང་སྟེ་རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པའི་བུད་མེད་འབྱུང་ངོ།",
    "སློང་མོ་ཟ་ཞིང་རིའི་རྩེ་མོར་འཛེགས་ཏེ་སྟོང་ཕྲག་བརྒྱ་བཟླས་པར་བྱ་སྟེ་དེ་བཞིན་གཤེགས་པའི་སྐུ་མངོན་དུ་འགྱུར་རོ།",
    "རྒྱ་མཚོར་འགྲོ་བའི་ཆུ་ཀླུང་དུ་ཞུགས་ནས་ཨརྒའི་མེ་ཏོག་གིས་སྦྱིན་སྲེག་གྱིས་ཤིག།",
    "དེ་ཉིད་ཆུ་ལ་མནྡཱ་ར་བའི་མེ་ཏོག་གིས་ནོར་སྦྱིན་མཆོག་སྦྱིན་པར་འགྱུར་རོ།",
    "རྒྱ་མཚོར་འགྲོ་བའི་ཆུ་ཀླུང་དུ་ཞུགས་ཏེ་མྱ་ངན་མེད་པའི་ཤིང་གི་མེ་ཏོག་སྟོང་ཕྲག་བརྒྱ་བླུགས་པར་བྱའོ།",
    "མཚན་མོ་བདུན་གྱིས་གནོད་སྦྱིན་མོ་རྣམས་འགུགས་པར་བྱེད་དོ།",
    "དེ་ནས་གཙང་ཞིང་དཀར་བའི་གོས་བགོས་ཏེ་དུར་ཁྲོད་དུ་སོང་ནས་དྲི་དང་།",
    "ཕག་གི་མིག་བླངས་ནས་ཕྱུགས་དང་ལྷན་ཅིག་གཞོན་ནུ་མའི་ལག་པས་བཏབ་བར་བྱའོ།",
    "ལྡོང་རོས་ཀྱང་རུང་སྟེ་ཆ་མཉམ་པར་བྱས་ནས་གསོ་སྦྱོང་ཅན་གྱི་བུ་མོའི་ལག་པས་བཏབ་པར་བྱའོ།",
    "ནས་ཟན་ཟ་ཞིང་རིའི་རྩེ་མོར་རས་རིས་བཞུགས་ནས་འབུམ་བཟླས་པར་བྱའོ།",
    "བདེ་བར་གཤེགས་པའི་མཐོ་གང་གི་ཚོད་ཀྱི་ངང་པ་བྱའོ།",
    "རི་མོ་མཁན་གསོ་སྦྱོང་ཅན་གྱིས་ཁ་དོག་མ་འདྲེས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "སྔགས་བཟླས་པའི་རྨ་བྱས་རེག་པར་བྱའོ།",
    "བསྐལ་པར་གནས་ཤིང་གང་གི་ཚེ་འཆི་བ་དེའི་ཚེ་གང་དུ་འདོད་པར་སྐྱེ་བར་འགྱུར་རོ།",
    "ཐལ་བ་ལ་ལན་ཉི་ཤུ་རྩ་གཅིག་བཟླས་ཏེ་སྤྱི་བོར་བཞག་པར་བྱས་ན་གཡུལ་དུ་རྒྱལ་བར་འགྱུར་ཏེ་གྱད་ཀྱི་དངོས་གྲུབ་བོ།",
    "ནག་པོའི་བརྒྱད་པ་ལ་མཚན་མོ་གཅིག་སྨྱུང་བར་གནས་པས་གཟུགས་བརྙན་གྱི་མདུན་དུ་གི་ཝང་བཞག་ནས་ཇི་སྲིད་འབར་བ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "ནག་པོའི་བཅུ་བཞི་པ་ལ་ཉིན་མཚན་དུ་སྨྱུང་བར་གནས་པས་རས་རིས་ཀྱི་སྤྱན་སྔར་བིལ་བའི་ཤིང་གིས་མེ་རབ་ཏུ་སྦར་ནས་བེ་ཀངྐ་ཏའི་ཡམ་ཤིང་ལ་ཚ་བའི་ཏིལ་མར་གྱིས་བཏགས་པ་སྟོང་ཕྲག་བརྒྱར་སྦྱིན་སྲེག་གྱིས་ཤིག།",
    "ནག་པོའི་བཅུ་བཞི་ལ་ཉིན་མཚན་དུ་སྨྱུང་བར་གནས་པས་དུར་ཁྲོད་དུ་སོང་སྟེ་ས་ལ་མ་ལྷུང་བའི་བ་ལང་གི་ལྕི་བས་དཀྱིལ་འཁོར་ཉེ་བར་བྱུག་པ་བྱས་ནས་མ་ཉམས་པའི་ཐོད་པ་བླངས་ཏེ་ཙནྡན་དམར་པོའི་ཆུས་བཀྲུས་ནས་མེ་ཏོག་དམར་པོ་དང་།",
    "དེའི་ཚེ་སེན་མོས་གང་བཀུག་པ་དེ་འོང་སྟེ་གང་བརྗོད་པ་དེ་བྱེད་དོ།",
    "འབར་བ་ཙམ་གྱིས་རིག་པ་འཛིན་པ་སྟོང་གིས་ཡོངས་སུ་བསྐོར་ཏེ་ནམ་མཁའི་མཐིལ་དུ་འཕུར་བར་བྱེད་དོ།",
    "མཚན་མོ་བདུན་ལ་རྫས་སྐྱེ་བར་འགྱུར་རོ།",
    "དཀར་པོའི་བཅུ་བཞི་ལ་མཚན་མོ་གསུམ་དུ་སྨྱུང་བར་གནས་པས་ཨུ་དུམ་བཱ་རའི་ཤིང་གིས་མེ་རབ་ཏུ་སྦར་ནས་ཨུ་དུམ་བཱ་རའི་ཡམ་ཤིང་ལ་ཞོ་དང་།",
    "ནས་ཟན་ཟ་ཞིང་དུས་གསུམ་དུ་ཁྲུས་བྱེད་ཅིང་གཙང་མ་བགོས་པས་ཡན་ལག་བརྒྱད་ལྡན་པའི་གསོ་སྦྱོང་ཅན་གྱིས་ཚེས་གཅིག་ནས་བརྩམས་ནས་ཇི་སྲིད་གཅིག་གི་བར་དུ་བཟླས་པ་དབུལ་བར་བྱའོ།",
    "བ་ལང་གི་གཅིན་དང་།",
    "མཚན་མོ་བདུན་དུ་དུས་གསུམ་དུ་ཡོངས་སུ་བཟླས་པར་བྱེད་ན་དེའི་མཚམས་མེད་པ་ལྔ་བསྲབས་པར་འགྱུར་རོ།",
    "ཁྱོད་ཀྱི་རིག་པའི་སྔགས་ཀྱི་ལེའུ་མཐའ་དག་རྣམ་པར་བཀོད་པའི་ཁྱད་པར་གྱི་ཚོགས་སྦྱིན་སྲེག་གི་ལས་རབ་ཏུ་སྦྱར་བས་རིག་པ་སྒྲུབ་པ་པོའི་མེ་ལ་རབ་ཏུ་སྤྱོད་པའི་ཁྱད་པར་གྱི་ཆོ་ག་དང་།",
    "དྲག་པོའི་ལས་རྣམས་རབ་ཏུ་སྦྱར་བ་ལ་ཡམ་ཤིང་གི་ཤིང་རྣམ་པ་གསུམ་དུ་འགྱུར་ཏེ།",
    "མ་རུལ་ཅིང་མི་འཁྱོག་པ་ཉིད་དང་།",
    "ཁྲུ་གང་གི་ཚད་ལས་ཁྲུ་གསུམ་མམ།",
    "རྩེ་མོ་གཉིས་ཀ་རྩེ་གསུམ་པ།",
    "གང་ཟག་མཆོག་གི་གནས་དེ་རྣམས།",
    "དེ་རྣམས་མེད་པའི་ཡམ་ཤིང་གིས།"
  ]
}