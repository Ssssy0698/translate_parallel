    "ཞེས་པ་ཉེར་གཅིག་གིས་བྱིན་གྱིས་བརླབ།",
    "བཟླ་དུས་ཀྱི་དམིགས་པ་ཐུན་མོང་མ་ཡིན་པ་ནི།",
    "ཕྱོགས་མཚམས་ཀྱི་འདབ་མ་རྣམས་ཀྱི་ནང་གི་བར་སྣང་ལ་རྩ་སྔགས་བཀོད་པ་ནི།",
    "ཞེས་པའི་ཡི་གེ་བཞི་པོ་རེ་རེའི་སྟེང་དུ་ཨོཾ་ཞབས་སུ་༢༤ཧཱུཾ་ཕཊ་བསམ།",
    "རང་གི་ལུས་བློ་གྲོས་ཀྱི་ནང་ཐམས་ཅད་གང་།",
    "མདུན་དུ་མངོན་སུམ་ལྟར་བཞུགས་པར་བསམ་ལ་དེ་དང་རང་གི་བར་དུ་དགྲ་བགེགས་དམིགས་ཀྱིས་གསལ་བ་ཡོད་ན་དེ་ཉིད་དམ་མེད་ནའང་མི་གཟུགས་ཀྱི་རྣམ་པ་རིད་ཅིང་ཉམ་ཐག་པ་གན་རྐྱལ་དུ་འགྱེལ་པ་ཞིག་བསམ་པའི་ལག་པ་གཉིས་རང་། གི་ཞབས་འོག་དང་།",
    "རང་དང་མདུན་བསྐྱེད་ཀྱི་ཞབས་འོག་གི་གདོང་བརྙན་རྣམས་ལས།",
    "དེ་ལྟ་བུའི་གདོང་བརྙན་དང་ལྡན་པའི་གཤིན་རྗེ་གྲངས་མེད་པ་ཉི་ཟེར་གྱི་རྡུལ་ལྟ་བུར་འཕྲོས་སྲིད་པ་གསུམ་ན་ཡོད་པའི་བསྟན་པ་དང་རྣལ་འབྱོར་ལ་སྡང་བའི་དགྲ་བགེགས་ཐམས་ཅད་སྐད་ཅིག་ཉིད་ལ་བཀུག་ནས་འོག་གི་དགྲ་བགེགས་རྣམས་ལ་ཐིམ་པས་དེ་རྣམས་དངོས་ཡིན་སྙམ་པའི་ངེས་ཤེས་དྲག་པོ་བྱེད།",
    "མདུན་སྐོར་གྱི་རྩེ་ནས་འཐོན་པདྨ་དང་འཁོར་ལོའི་སྟེང་ཕྱོགས་ལ་ཐོགས་མེད་དུ་སོང་།",
    "རྡོ་རྗེའི་རྭ་རྩེ་ནས་དུ་བ་འཐོན་པར་ལྟར་སྔགས་ཕྲེང་ནར་གྱིས་བྱུང་༢༤ བ་འཇམ་དཔལ་དང་ཐུགས་རྡོ་རྗེའི་རྩ་ཞལ་གྱི་མ་ཧེའི་ཞལ་ནས་ཡར་རིམ་བཞིན་འཐོན་ནས་བར་སྣང་ལ་ཕར་སོང་།",
    "ཡང་སྔགས་ཕྲེང་གི་ཁྲོད་ནས་མཚོན་ཆ་མེའི་ཚ་ཚ་འཕྲོ་བའི་ཆར་བབ་པས།",
    "འོག་གི་དགྲ་བགེགས་ཀྱི་ལུས་ཐམས་ཅད་གཞོབ་ཐུལ་ཏུ་བསྲེག།",
    "ངག་གི་ནུས་པ་བཅོམ།",
    "། དེ་རེ་རེས་ཀྱང་སྔགས་ཀྱི་སྒྲ་འབྲུག་གི་སྒྲ་བཞིན་འུར་འུར་དིར་དིར་བཟླས་པར་བསམ་མོ།",
    "འོད་ཟེར་ནག་པོ་མཚོན་ཆའི་དབྱིབས་ཅན་འཕྲོས་པས་དྲག་པོའི་ལས་ཐོགས་མེད་དུ་འགྲུབ་པར་བསམ་མོ།",
    "རྩ་སྔགས་ནི་ལས་ཀྱི་གཤིན་རྗེ་ཕོ་མོ་བཅུ་དྲུག་དང་།",
    "ༀཨ་རོ་ལྀཀ་ཧཱུྃ་ཕཊ།",
    "ༀམོ་ཧཱ་རཱ་ཏི་ཧཱུྃ་ཕཊ་ཨོཾ་དྭེ་ཥ་རཱ་ཏི་ཧཱུྃ་ཕཊ།",
    "ཅེས་རེ་རེ་བཞིན་བཟླའོ།",
    "འཁོར་སྔགས་རྣམས་གཙོ་སྔགས་ཀྱི་བཅུ་ཆ་བཟླ་ཞིང་འབུམསྟན་ཐོག་གཅིག་ཏུ་ཐུན་བཞིར་བཅད་ནས་ཐུན་གྱི་དངོས་གཞི་ལ་མིང་ཚིག་གིས་བར་མ་ཆོད་པ་དང་མཚམས་ཤིན་ཏུ་དམ་པས་བསྒྲུབ་ན་གེགས་ཆུང་ཞིང་དངོས་གྲུབ་ཉེ་བར་གསུངས་སོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་གོ་འཕང་ཚེ་འདི་ཉིད་ལ་ཐོབ་ཅིང་གནས་། སྐབས་སུ་ལས་བཞིའི་ཕྲིན་ལས་ཐམས་ཅད་འབད་མེད་དུ་འགྲུབ་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཐུན་མཚམས་སུ་གཏོར་མ་འབུལ་བར་འདོད་པས་གཏོཪ་མ་ནང་མཆོད་ཆུ་ཆང་གིས་སྦྱངས།",
    "པད་སྐོར་སྔོན་དུ་འགྲོ་བའི་རྡོ་རྗེ་ཐལ་མོ་ཁ་གྱེན་དུ་ཕྱེ་བའི་ཕྱག་རྒྱའི་མཐར་སེ་གོལ་གཏོགས་པ་དང་བཅས་པ་བྱས་ལ།",
    "གི་བར་གྱིས་ཕྱི་མཆོད།",
    "ཨོཾ་ཤྲཱི་བཛྲ་བྷེ་རཾ་ཝ་མཎྜ་ལ་ས་པ་རི་ཝཱ་ར་ཨོཾ་ཨཱ་ཧཱུྃ་གིས་བདུད་རྩི་འཐོར་ཞིང་ནང་མཆོད་ཕུལ།",
    "གཏི་མུག་རྡོ་རྗེའི་རང་བཞིན་ཁྱོད་སོགས་ཀྱིས་བསྟོད་པའི་མཐར།",
    "གི་བར་གྱིས་ཕྲིན་ལས་བཅོལ།",
    "གཏོར་མ་དགྲ་བགེགས་ཀྱི་ཤ་ཁྲག་གི་ཕུང་པོ་ཆེན་པོར་གྱུར།",
    "རང་གི་མདུན་དུ་པདྨ་དང་ཉི་མ་དང་མ་ཧེའི་སྟེང་དུ་ཡ་ལས་ཐོད་དབྱུག་བློ་གྲོས་ཡས་མཚན་པ་དེ་ལས་འོད་ཟེར་འཕྲོས།",
    "རང་གི་ཐུགས་ཀ་ནས་འོད་ཟེར་ལྕགས་ཀྱུ་ལྟ་བུ་གྲངས་མེད་པ་། འཕྲོས་པས་ལྷོ་ཕྱོགས་རིམ་པ་བདུན་གྱི་ས་འོག།",
    "ཅེས་བརྗོད་ཅིང་ཐལ་མོ་བརྡབ།",
    "རང་གི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པས་སྣོད་བཅུད་ཐམས་ཅད་འོད་དུ་ཞུ་ནས་སྲུང་བའི་འཁོར་ལོ་ལ་ཐིམ།",
    "མགྲིན་པར་ཨཱ་ཐུགས་ཀར་ཧཱུྃ་གིས་མཚན་པར་གྱུར།",
    "བློ་གྲོས་དམན་པ་རང་གི་དོན་དུ་བས།",
    "བློ་ཆེན་རྣམས་ཀྱིས་གོང་མའི་གསུང་ལ་གཟིགས།",
    "དེ་ལ་འདིར་དཔལ་རྡོ་རྗེ་ནག་པོ་ཆེན་པོ་གུར་གྱི་མགོན་པོའི་ཐུན་མོངམ་ཡིན་པའི་སྲུང་འཁོར་ནང་ཁྲིད་དང་བཅས་པ་རྒྱུན་དུ་ཉམས་སུ་ལེན་པར་འདོད་པས།",
    "རྗེས་གསུམ་མོ།",
    "ཁྱེད་རྣམས་ཀྱིས་བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "དེའི་ཆེད་དུ་དཔལ་རྡོ་རྗེ་ནག་པོ་ཆེན་པོའི་ལམ་གྱི་རིམ་པ་ཟབ་མོ་ཉམས་སུ་བླང་བར་བགྱིའོ།",
    "རང་གི་སྤྱི་བོར་པདྨ་དང་ཟླ་བའི་སྟེང་དུ་སྐད་ཅིག་གིས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་དཔལ་ཧེ་རུ་ཀ་སོགས་ཀྱེ་རྡོར་ལྟར།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཡབ་ཡུམ་འོད་བློ་གྲོས་བཀའ་དུ་ཞུ་སྟེ་སྤྱི་བོ་ནས་རང་ལ་ཐིམ་པས་རང་གི་ལུས་འཇའ་ཚོན་ལྟ་བུར་གྱུར།",
    "དེ་དག་གི་ཐུགས་ཀའི་ཧཱུཾ་ལས་འོད་ཟེར་འཕྲོས།",
    "ཞེས་པ་ལན་ཅི་ནུས་སུ་མོས་གུས་དྲག་པོ་དང་།",
    "རང་གི་སྤྱི་བོ་ནས་ཐིམ་པས་ལུས་ངག་ཡིད་གསུམ་དང་།",
    "ན་མོ་གུ་རུ་བྷྱ",
    "ཞེས་སོགས་རྒྱུན་བཤགས་ལན་གསུམ་བརྗོད་ཚོགས་ཞིང་རྣམས་རང་འ་ཐིམ་པར་བསམ་མོ།",
    "༢༥ དེའི་དབུས་སུ་པཾ་ལས་པདྨ་དང་རཾ་ལས་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཧཱུཾ་ལས་སྣ་ཚོགས་རྡོ་རྗེའི་ལྟེ་བ་ལ་ཧཱུཾ་གིས་མཚན་པ།",
    "འཁོར་ལོའི་ནང་གི་དབུས་དང་ཕྱོགས་བཅུར་པདྨ་དང་ཉི་མ་མི་རོ་དམར་སེར་མགོ་བོ་གཡས་སུ་བསྟན་པ་རེ་རེ།",
    "དེ་རྣམས་ཀྱི་སྟེང་དུ་ཧཱུཾ་མཐིང་ནག་རེ་རེ།",
    "བདག་ཉིད་ནག་པོ་ཆེན་པོ་ལྷ་བཅུ་གཅིག་གི་སྐུ་ཅིག་ཆར་དུ་གྱུར་པ་ནི།",
    "གཡོན་ཐོད་པ་ཁྲག་གིས་གང་བ་ཐུགས་ཀར་སྟེང་འོག་ཏུ་འཛིན་པ།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་ཅན།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབསཅན་དར་སྣ་ཚོགས་པའི་ཅོད་པན་དང་ལྷབ་ལྷུབ་ཀྱིས་བཀླུབས་པ།",
    "སྐུ་གང་དྲི་མ་དག་ཆུའི་ལྷག་མ་ཡར་ལུད་པ་ལས་ལྷ་བཅུ་གཅིག་ལ་མི་བསྐྱོད་པ་རེ་རེས་དབུར་བརྒྱན།",
    "གཡོན་དུ་མོ་ཉེ།",
    "ཐུགས་ཀར་ཧཱུྃ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན།",
    "དཔའ་བོ་མཁའ་འགྲོའི་གསུང་གི་བྱིན་ནུས་སོགས།",
    "ངག་གི་སྡིག་སྒྲིབ་བྱང་མའི་ངག་མནན་བསལ།",
    "རང་གི་གྲེ་ཕུག་རཾ་ཡིག་དམར་ནག་ལས།",
    "ངག་གི་ཉེས་སྐྱོན་ཐམས་ཅད་བསྲེགས་པར་གྱུར།",
    "གོང་གི་སྔགས་དེ་ཉེར་གཅིག་སོགས་བཟླ།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་ལས་འོད་འཕྲོས་པས།",
    "སྤྲོ་བསྡུའི་མཁར་དུ་གཞུག་པ་ཐུན་མོང་བ་ནི།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་ལས་འོད་ཟེར་འཕྲོས།",
    "ཐུན་མོང་མཡིན་པའི་སྤྲོ་བསྡུའི་མཁར་དུ་གཞུག་པ་ནི།",
    "སྔོན་པོ་མེ་འབར་ལྟེ་བར་ཧཱུཾ་གིས་མཚན།",
    "ཧཱུཾ་གི་རང་སྒྲ་སྒྲོགས་པ་དཔག་མེད་པ།",
    "མདུན་ནས་རྒྱབ་དཀྲིས་དེ་བཞིན་ཧཱུཾ་ཡིག་གིས།",
    "ཐུན་མོང་བ་འཁོར་ལོས་བཅད་པ་ནི།",
    "ནུས་སྟོབས་ཆེར་འབར་ནམ་མཁའི་ཁྱོན་ཀུན་ཁྱབ་། འཁོར་ལོ་གཡས་འཁོར་རང་སྒྲ་འབྲུག་ལྟར་ལྡིར།",
    "ཅུང་ཟད་དྲན་རྙེད་བདག་གི་ནུས་མཐུར་ཤེས།",
    "བདག་གི་བྲན་དུ་ཁས་བླངས་བཀའ་ཉན་གྱུར།",
    "ཐུན་མོང་མ་ཡིན་པ་སྣང་སྟོང་སྐུའི་འཁོར་ལོས་འདོད་ཁམས་གཡུལ་དུ་བཅད་པ་ནི།",
    "གྲགས་སྟོང་གསུང་གི་འཁོར་ལོས་གཟུགས་ཁམས་གཡུལ་དུ་བཅད་པ་ནི།",
    "གཟུགས་ཁམས་སྣང་བ་བག་ཆགས་དབྱིངས་སུ་དགགྲགས་སྟོང་སྐྱེ་མེད་གསུང་གི་རྡོ་རྗེར་གྲུབ།",
    "གཞན་གྱི་ངག་གི་ནུས་པ་འཇོམས་པའི་མཚོན་ཆ་ནི།",
    "དེ་ཡི་མེ་འོད་སྒྲ་ཡིས་དགྲ་ཕོ་མོ།",
    "ཆུ་གླང་སྔོན་། པོ་རྭ་གདེངས་དུག་གི་སྡོང་།",
    "བྱད་མ་དགྲ་བགེགས་ཕོ་མོའི་སྟེང་དུ་ཕབས།",
    "ཚུར་འདུས་རང་གི་ཕྱི་རོལ་གུར་ཁང་རྩེར།",
    "གཉིས་པ་ཐུན་མོངམ་ཡིན་པའི་མདེའུ་ཁ་གདགས་པ་ལ།",
    "སྲུང་བའི་དོན་དུ་ལྷ་རྣམས་ཞལ་ནང་གཟིགས།",
    "ནང་དམ་ཚིག་གི་འཁོར་ལོས་སེམས་ཉིད་ཡེ་ཤེས་ཀྱི་རྩལ་འདོན་ནི།",
    "བསྲུངབྱ་སོགས་རེ་ཞིག་མི་དམིགས་པར་བཞག་ལ།",
    "སྲན་མ་ཕྱེད་བཀས་ཙམ་རེའི་སྟེང་དུ་ཧཱུཾ།"
  ]
}