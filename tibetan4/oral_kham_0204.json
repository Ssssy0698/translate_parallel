    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "དེའི་ཉེས་པར་བྱས་པའི་ལས་ཀྱི་གཤིན་རྗེའི་མི་དང་ཉེ་བར་འདུག་སྟེ།",
    "ཡི་དྭགས་ཀྱི་ཡུལ་ན་ཡི་དྭགས་བྱིས་པ་ལ་ཟ་བ་ཞེས་བྱ་བ་མཐོར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་ཡུལ་ན་ཡི་དྭགས་མདངས་ཟ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ཡི་དྭགས་ཀྱི་ཡུལ་ན་ཡི་དྭགས་ཚངས་པའི་སྲིན་པོ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེ་ལྟར་ལོ་དུ་མ་ཞིག་ལ་ལོ་གསར་བའི་དགའ་སྟོན་འབྱུང་ཉེ་ཙ་ན།",
    "སེམས་ཆགས་པ་རུས་པའི་གཏིང་དུ་ཟུག་པའི་ལོ་སར་གྱི་དགྱེས་སྟོན་དེའང་སྔར་བཞིན་རོལ་གྱིན་འདུག་ཅེས་གླེང་བ་བདེན་ངེས།",
    "གྱིས་གང་འདུག་པ་མཐོང་བས།",
    "ས་ཆའི་མིའི་ངོ་མི་ཟིན་པ་དང་ཁ་ཡང་མི་གྲགས་པའི་གནས་སུ་གྱུར་འདུག་གམ།",
    "རིག་སློབ་ཅུས་ཀྱི་ཅུས་ཀྲང་སྐྱ་ཁོ་གསུམ་གྱིས་རྟག་ཏུ་དེ་ལྟར་སྨོས་ཤིང་གཞན་གྱིས་སློབ་པ་ལ་ཁྱད་གསོད་བྱེད་བཞིན་འདུག་སྟེ།",
    "སང་ཉིན་ཕྱིར་ཤོག་དང་འདུག་ཅེས་གསུངས།",
    "ཡུད་ཙམ་ལ་གླེང་བའམ་འ་འུར་གྱི་སྒྲས་ཁང་བའང་ཁེངས་འདུག་མཚམས་ཤིག་ལེ།",
    "ཁོ་ཚོ་ཡིད་མ་ཆེས་ཏེ་ཡི་ག་གཏིང་ནས་ལོག་པ་དང་སྐྱག་དྲི་བྲོ་བའི་གཏམ་སྣ་ཚོགས་ཀྱིས་སྐུར་བ་བཏབ་པ་དང་ཡ་མ་བརླ་མང་བོ་ལབ་འདུག་པས།",
    "ཇ་ཆང་ཟས་གསུམ་ཚོང་བའི་ཁང་ཧྲུལ་བལྟས་ན་ཉམས་མི་དགའ་བ་འགའ་ལས་མི་གདའ་བས།",
    "སྡང་ལངས་པའི་ངང་ནས་སྤུ་གྲི་ལངས་ཏེ་ས་ལ་བསྣུན་ཙ་ན།",
    "ན་པའི་ལྟ་ཎས་ཀ་གང་ལས་གང་ལྷག་སྔོན་དུ་འགྲན་པར་གདའ།",
    "མི་རྣམས་ཡང་རང་གནས་སུ་རྒྱུ་བཞིན་པའི་དུས་དེར།",
    "ཁ་ཆེ་བའི་ཚོད་ཀྱི་གཏམ་མཁན་ཞིག་ལོས་ཡིན་བསམས་པ་དང་།",
    "བསྟར་བྱེད་ཚེ་ང་རུ་དཔོན་མི་འདུག་ཁོ་ཐག་ཡིན།",
    "གཞན་ཚང་མ་དགའ་བ་གཏིང་ནས་སྐྱེས་ཏེ་ཕན་ཚུན་ངོ་ལ་བལྟས་ཤིང་འོར་འདུག་དང་།",
    "ནོར་བདག་ཨརྱ་ཛམ་བྷ་ལ་ལྟ་བུ་དེ་འབྲོག་ཞིང་ནགས་གསུམ་གྱི་ཉམས་མྱོང་ཕུན་སུམ་ཚོགས་པ་མཆིས་པས་ཨུ་ཡོན་ཞིག་ཏུ་བསྐོས་ཏེ་རང་རང་སོ་སོའི་འགན་ཁུར་དང་དུ་བླངས་སོ།",
    "འཛམ་གླིང་དུའང་སྣང་བའི་འོད་ཟེར་ལམ་ལམ་དུ་འཕྲོ་བཞིན་འདུག།",
    "བཞིན་རིས་སྔར་ལས་སྒེག་ཉམས་དང་ལྡན་པ་ཞིག་ཏུ་ཐོན་ཡོང་བ་ཡིན་པར་སྙམ་འདུག་གོ།",
    "སྒོས་སུ་གསོམ་སྡོང་ལ་སོགས་པའི་ལྗོན་ཤིང་རྣམས་ཀྱིས་འཚང་ཁ་ཤིག་ཤིག་ཏུ་ངང་བའི་ཚོགས་རྣམས་མཚོ་ལ་སྤྲོ་བས་འཇུག་པ་བཞིན་དུ་ཡལ་གའི་ཕྱག་སོར་མེ་ཏོག་སྣ་ཚོགས་ཐོགས་ནས་སོ་སོས་སྐྱེ་དགུའི་ཕུན་ཚོགས་དོན་དུ་བདག་ཉིད་གང་ལ་མཁོ་བ་དེ་རུ་བགྲོད་པ་དང་རང་ཤུགས་ཀྱིས་རྒྱུགས་པ་དང་རྒྱུག་བཞིན་ཡོད་ལ།",
    "བག་ཕབས་ཀྱི་ངང་དུ་དགའ་བདེའི་དཔལ་ལ་ཡོངས་སུ་རོལ་འདུག་ཀཚུ་ལཀ་ལ་སྤྱི་ལ་ཕ་མེས་རྒྱལ་ཁབ་གསར་བ་དབུ་བརྙེས་པ་ནས།",
    "དེང་སྐབས་རང་རྒྱལ་གྱི་ཕྱི་ཕྱོགས་ལ་སྒོ་ཆེན་འབྱེད་པའི་སྐབས་སུའང་རང་རྒྱལ་གྱི་ས་གནས་སོ་སོའི་མགྲོན་པོ་དགོན་རྙིང་གྲགས་ཅན་དང་།",
    "ངས་འཕྲུལ་བརྟེན་ནས་ཁྱེད་ལ་ཐེངས་འགའ་མཇལ་བ་ལས་དངོས་སུ་མཇལ་མ་ཐུབ་ཀྱང་ང་རང་ལ་བྱམས་བརྩེ་ཐུགས་ཀྱིས་བསྐྱངས་པའི་ཕ་མ་དང་རྩེད་འཇོ་མཉམ་དུ་རོལ་བའི་གྲོགས་པོ།",
    "ང་ནི་གང་དུ་གནས་ཀྱང་རུང་རང་ཡུལ་འབོར་ག་ལ་ཐུབ།",
    "སྔོ་ཞིང་དྭངས་པར་ལྗང་ལྡེམ་གྱི་རབ་ཏུ་མཛེས་པའི་རྩྭ་ཐང་དུ་འཁྱིལ་འདུག།",
    "སྐྱེས་ནས་མེ་ཏོག་ག་འདྲ་ཞིག་འགད་རྒྱུའི་ཐད་ལ་སྟོབས་ཤུགས་དང་སྤོབས་པ་གསོག་འཇོག་བྱེད་འདུག་ཚོགས་སྤྱིའི་སྟོབས་ཤུགས་རབ་ཏུ་རྫོགས་པའི་སྐབས་ཉིད་ན།",
    "ང་རང་མེ་ཏོག་སྣ་ཚོགས་ཀྱི་གསེང་དུ་སྐྱིད་པོའི་ངང་ཉལ།",
    "བདེ་སྐྱིད་ཀྱི་ཆེད་དུ་ལོས་ཡིན།",
    "སྐབས་དེ་དུས་ཙ་ན།",
    "ཉི་མ་ནི་སྨྲ་བཅད་དེ་འཛུམ་འབོལ་ལེར་འདུག་པ་དང་།",
    "ས་གཞི་ཡང་དགའ་ལྷང་ངེར་དལ་བཅགས་སེ་གདའ།",
    "སྲིབ་ཀའི་རི་རྩ་དག་ཏུ་ད་དུང་མ་ཞུ་བའི་གངས་དང་འཁྱག་རོམ་གྱིས་ཁེངས་འདུག་མ་གཞིར།",
    "སྤྱིར་འགྲན་ཚོགས་འདི་རྩེད་འཇོའི་རྣམ་གྲངས་མང་ཙམ་འདུག་སྟེ།",
    "ཁྱེད་རང་མེ་ཏོག་ལ་དགའ་ན་གཡུ་ལོ་ལ་དེ་བས་དགའ་དགོས།",
    "ཁྱེད་ཚོས་བལྟས་ན་ཇི་འདྲ་འདུག་གམ།",
    "ང་རང་གྲོགས་པོ་བློས་ཐུབ་པ་འགའ་དང་མཉམ་དུ་དེང་རབས་ཀྱི་ལག་རྩལ་ལས་ཐོན་པའི་རླངས་འཁོར་ཆུང་།",
    "དེའི་སྟེང་དུ་གཞུང་ལམ་ཞིག་རྒྱང་རིང་བོར་དར་དཀར་འཐེན་འདྲ་ཞིག་བྱས་འདུག་པ་མངོན་བྱུང་།",
    "ཡུལ་དེའི་ལྷོ་མཚམས་སུ་ལབ་རྩེ་ཞིག་ཡོད་པའི་རི་བོ་དེ་ནི་བརྗིད་ཉམས་ཀྱིས་ཚུལ་དུ་མགོ་འཕང་གནམ་ལ་བཏེགས་ནས་འགྱིང་འདུག་པའོ།",
    "ཕྱུགས་རིགས་སྐྱོང་གཉོར་བྱེད་པའི་ལས་ལ་འབད་འདུག་གོ།",
    "དེར་ཐོན་མ་ཐག་ཏུ་ལག་ལ་རྡོ་བཟུང་ནས་བྱ་ཡི་མ་མཆུ་ལ་རྒྱུག་པའི་སྲོལ་དར་འདུག།",
