    "ང་ཚོ་གཉིས་ཀས་ང་རང་དྲག་སྐྱེད་བྱུང་སྟེ་ཕྱི་ལ་འགྲོ་བསྐྱོད་ཐུབ་པ་དང་།",
    "ལྡུམ་རའི་ནང་ལས་ཀ་བྱེད་ཐུབ་པའི་ཉི་མ་དེ་ལ་རེ་སྒུག་བྱས་ནས་བསྡད།",
    "ང་ན་བ་དེ་ཡག་པོ་བྱུང་འདུག་ང་གཉིས་མཉམ་དུ་སྡོད་རྒྱུའི་གོ་སྐབས་ཤིག་ཐོབ་པ་དེ་ནམ་ཡང་བརྗེད་ཐབས་མེད་པ་ཞིག་རེད།",
    "སྐབས་ཅིག་རིང་ངས་ཁྱེད་རང་བརྗེད་པ་ལྟ་བུ་ཡང་བྱུང་སོང་།",
    "འོན་ཀྱང་ད་ནས་བཟུང་ང་མ་ཤི་བར་དུ་ངས་དེ་དག་ནམ་ཡང་བརྗེད་དུ་འཇུག་གི་མིན།",
    "དེའི་མཚན་མོ་ང་ཉལ་སར་འཛུལ་སྡོད་སྐབས།",
    "བདེ་པོ་འདུག་ང་ཉིན་རེ་བཞིན་བདེ་རུ་འགྲོ་གི་ཡོད་པ་ངས་ཚོར་ཐུབ་ཀྱི་འདུག་སྨྲས་པར་ཇཱོ་ཡིས་འཛུམ་དམུལ་ཙམ་གྱིས་མགོ་དཀྲུགས་ཏེ།",
    "ལག་པ་ཡ་གཅིག་ངའི་དཔུང་པའི་སྟེང་དུ་བཞག་ནས་སྐད་གདངས་མི་སྙོམ་པ་ཞིག་གི་ངང་ནས།",
    "འོན་ཀྱང་ཁོང་གིས་བུ་ལོན་གསབ་པ་མ་ཟད།",
    "ཁོ་མོ་ལ་རང་ཉིད་ཕྱིར་ལོག་ཡོང་ནས་གང་འདྲ་ཉམ་ཆུང་ཆགས་ཡོད་མེད་དང་།",
    "ད་ཆ་ང་དང་མཉམ་དུ་ཆང་ས་རྒྱག་གི་ཡིན་ནམ་ཞེས་ཁོ་མོར་སྐད་ཆ་འདྲི་གི་ཡིན།",
    "ང་ཚོ་གསུམ་གྱི་མི་ཚེ་ལྷག་མ་དེ་སྐྱིད་པོའི་ངང་ནས་སྐྱེལ་རྒྱུ་ཡིན་པའི་སྐོར་ཤོད་དགོས་སྙམ་པ་ནི་ངའི་ཀུན་སློང་དེ་ཡིན།",
    "ཇཱོ་དང་བྷི་ཌི་གཉིས་ངའི་མདུན་དུ་གཅིག་གི་ལག་པ་གཅིག་གིས་བཟུང་སྟེ་ལངས་བསྡད་འདུག་ཐོག་མར་བྷི་ཌིས་ང་མཐོང་བས་གདོན་འདྲེ་ཞིག་ཡིན་འགྲོ་བསམ་པ་ལྟར་སྐད་ཤོར་སོང་།",
    "དེའི་རྗེས་སུ་ཁོ་མོས་ང་ལ་འཐམས་ནས་ངུས་བསྡད།",
    "ཁྱེད་རང་ཡིད་དུ་འོང་བ་ཞིག་ཆགས་འདུག་སྨྲས་པར་མོས་ཡོད་རེད།",
    "ང་དང་ཧཱར་བྷཊ་བཟའ་ཟླ་གཉིས་བཅས་ང་ཚོ་ལྷན་དུ་དགའ་སྐྱིད་ངང་བསྡད།",
    "བདུན་ཕྲག་རེ་རེའི་ནང་ཇཱོ་ལ་ཡི་གེ་རེ་ཆག་མེད་བྲིས་པ་ཡིན།",
    "ང་ཚོའི་ཚོང་དེ་ཙམ་ཡག་པོ་མ་བྱུང་ཡང་།",
    "དེའི་རྗེས་སུ་ག་རེ་བྱུང་བ་ཆ་ཚང་ཤོད་རྒྱུར་བསྡད་པ་ལས་གཞན་ཅི་ཡང་མེད།",
    "ཟླ་བ་བཅུ་གཉིས་པའི་དགོང་མོ།",
    "ང་ཤར་ཕྱོགས་ལ་སྡོད་རིང་ཇཱོ་དང་བྷི་ཌི་གཉིས་མ་ཐུག་པར་ལོ་ངོ་བཅུ་གཅིག་ཙམ་སོང་ཡང་།",
    "ཁོང་ཚོ་ནི་ངའི་སེམས་ལ་ཡང་ཡང་འཆར་གྱི་འདུག་ཉིན་ཞིག་ཟླ་བ་བཅུ་གཉིས་པའི་དགོང་མོ་སྲོད་རུབ་ནས་ཆུ་ཚོད་གཅིག་གཉིས་ཤིག་གི་རྗེས་སུ།",
    "ཁྱེད་རང་དྲན་པའི་ཆེད་དུ་ང་ཚོས་ཁོ་ལ་ཕིབ་ཟེར་གྱི་ཡོད།",
    "ང་ཚོའི་རེ་བ་ལ་ཡང་ཁྱེད་རང་ནང་བཞིན་ཁོ་འཚར་ལོངས་བྱུང་ན་སྙམ་པ་དང་།",
    "ཡོང་གི་རེད་ཀྱང་བསམས་ཀྱི་ཡོད།",
    "ངས་ཀྱང་དེ་ག་རང་རེད་བསམས།",
    "ངས་ཁོ་དུར་ཁྲོད་ཡོད་ས་དེར་འཁྲིད་དེ་བང་སོ་གཅིག་གི་སྟེང་དུ་བཞག་ནས་གནས་ཚུལ་མང་པོ་དྲན་གསོ་སློང་གིན་བསྡད་པ་ཡིན།",
    "བྷི་ཌི་ཁྱེད་རང་གི་ཕིབ་དེ་ང་ལ་བྱུང་ན་དུས་གཏན་གྱི་ཆེད་དང་།",
    "ངའི་ལག་པའི་ཐོག་མོ་རང་གི་ལག་པ་བཞག་ནས།",
    "ཁྱེད་རང་གིས་ཁོ་མོ་བརྗེད་སོང་ངམ།",
    "དོ་ནུབ་དགོང་དྲོ་གཅིག་པུར་ཁོ་མོའི་དོན་དུ་བསྐོར་བ་ཞིག་བྱ་དགོས་སྙམ།",
    "ངས་གོ་ཐོས་ལ་ཁོ་མོའི་ཁྱོ་ག་དེས་མོ་ལ་གདུག་རྩུབ་དང་།",
    "ཁོ་མོས་ཡང་བསྐྱར་ཆང་ས་བརྒྱབ་པ་ཡང་ངས་ཧ་གོ་བྱུང་།",
    "དེ་གར་ལྡུམ་རའི་རྩིག་པ་དེ་མ་གཏོགས་ཁང་པ་སོགས་གང་ཡང་ལྷག་མི་འདུག་སྨུག་པ་སྲབ་མོ་ཞིག་ནམ་མཁར་འཕྱུར་བ་ལས་ཟླ་བ་ནི་འཆར་རྒྱུ་རེད།",
    "དགོང་མོ་དེ་མུན་ནག་རང་ཆགས་མེད་ཙང་།",
    "ང་རང་དེ་དང་ཉེ་བར་སླེབས་དུས་གཟུགས་བརྙན་དེ་བུད་མེད་ཅིག་ཡིན་པ་ཤེས།",
    "ད་དུང་ཉེ་བར་ཕྱིན་པས་བུད་མེད་དེས་ཧང་སངས་པའི་སྒོ་ནས་ངའི་མིང་ནས་བོས་བྱུང་བས་ངས།",
    "ཞེས་སྐད་བརྡ་བྱས་པས་ཁོ་མོས་ལག་པ་གཉིས་ཀ་བརྐྱངས་བྱུང་བས་ང་རང་གི་ལག་པས་བཟུང་བ་ཡིན།",
    "ཁྱོད་ཀྱིས་ང་ངོ་ཤེས་པ་དེར་ཡ་མཚན་སྐྱེས་བྱུང་།",
    "དེ་སྔ་ཁེངས་དྲེགས་ཆེ་བའི་མིག་གི་མདངས་དེ་ད་ཆ་ཞི་འཇམ་དུ་ཕྱིན་པ་དང་།",
    "མཛའ་བརྩེ་དང་ལྡན་པའི་ལག་པས་རེག་པ་དེ་བྱུང་།",
    "སྔོན་ཆད་རེག་མྱོང་ཡང་བརྩེ་བ་མེད་ཙང་གྲང་མོ་གྲང་རྐྱང་རེད།",
    "ང་གཉིས་ཀྱི་ཉེ་འགྲམ་དུ་ཡོད་པའི་རྐུབ་སྟེགས་རིང་པོ་ཞིག་གི་སྟེང་དུ་བསྡད་དེ་ངས།",
    "ལོ་མང་ཕྱིན་པའི་རྗེས་སུ་ང་གཉིས་སླར་ཡང་འདི་གར་ཐུག་རྒྱུ་བྱུང་བ་དེ་ཁྱད་མཚར་རེད།",
    "ཁྱེད་རང་འདི་གར་ཡང་ཡང་ཡོང་གི་ཡོད་དམ།",
    "ཞེས་དྲིས་པར་མོས།",
    "ཟླ་བ་ཤར་འགོ་ཚུགས་པ་དང་ངའི་བསམ་བློར་གྲུ་སྐྱ་བཞི་ཅན་གྱི་ནང་དུ་མེག་ཝིཅ་དབུགས་ཆད་འགྲོ་གི་ཡོད་པ་དང་།",
    "ང་ཚོའི་འཛོམས་ས་རྙིང་པ་དེའི་གནས་སྟངས་འདི་འདྲ་ཞིག་ཏུ་ཇི་ལྟར་གྱུར་བ་རེད།",
    "དེ་ག་རང་ཟེར་གི་ཡོད།",
    "སྨྲས་པར་ཁོ་མོས།",
    "ས་ཆ་འདི་ང་ལ་བདག་པ་རེད།",
    "གཞན་དག་རྒྱུ་དངོས་ཚང་མ་ག་ལེར་ག་ལེར་རྫོགས་སོང་སྟེ།",
    "ཞེས་དྲིས་པར་མོས།",
