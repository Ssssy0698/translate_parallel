    "སི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་བསྐྲུན་ནས་བཀྲམ།",
    "དངོས་པོ་ཐམས་ཅད་སྟོང་པ་ཡིན་ནོ་ཞེས་བརྗོད་པའི་ཁྱོད་ཀྱི་ཚིག་ཀྱང་རང་བཞིན་མེད་པས།",
    "གལ་ཏེ་དངོས་པོ་ཐམས་ཅད་ནི་སྟོང་པ་ཡིན་ལ་གང་གིས་འགོག་པར་བྱེད་པ་ཁྱོད་ཀྱི་ཚིག་ནི་སྟོང་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "མི་འདྲ་ཉིད་དེ་ཁྱོད་ཀྱི་འདོད་པ་དེ་ཡིན་ན།",
    "ཁྱོད་ཀྱི་བློ་ལ་སེམས་ན་དེ་མི་འཐད་དེ།",
    "ཁྱོད་ཀྱི་བློ་ལ་རྣམ་པ་འདི་འདྲས་དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་འགོག་པའི་ཚིག་འགོག་པར་བྱེད་པའི་ཚིག་དེའང་དེ་ལྟ་བུ་ཡིན་ནོ་ཞེས།",
    "གཞན་ཡང་རེ་ཞིག་གལ་ཏེ་ཁྱོད་ཀྱིས་མངོན་སུམ་གྱིས།",
    "གང་གིས་དངོས་པོ་རྣམས་དམིགས་པར་འགྱུར་བ།",
    "རྗེས་དཔག་དང་ལུང་གིས་བསྒྲུབ་བྱ་དང་།",
    "འོན་ཏེ་གཞི་མེད་པའི་མིང་དུ་གྱུར་ན་མི་རུང་ངོ་སྙམ་ནས་རང་བཞིན་ནི་ཡོད་མོད་ཀྱི།",
    "གཞན་ཡང་གང་གི་ཕྱིར་ཁྱིམ་ན་བུམ་པ་མེད།",
    "ཁྱོད་ཀྱི་ཚིག་འདིས་དངོས་པོ་ཅི་ཞིག་དགག་པར་བྱེད།",
    "དེ་བཞིན་དུ་ཁྱོད་ཀྱིས་རང་བཞིན་ཡོད་པ་མིན་པ་ལ།",
    "གཞན་ཡང་དངོས་པོ་ཐམས་ཅད་རང་བཞིན་མེད་དོ་ཞེས་སྒྲུབ་པའི་ཚེ་ཁྱོད་ལ་གཏན་ཚིགས་མི་འགྲུབ་སྟེ།",
    "དངོས་པོ་རྣམས་རང་བཞིན་མེད་པའི་ཕྱིར་སྟོང་པ་ཉིད་ཡིན་པས་ཁྱོད་ཀྱི་རྟགས།",
    "གང་ལ་ཡོད་དེ་རང་བཞིན་གྱིས་མ་གྲུབ་པས་ཁྱོད་ཀྱིས་བསྒྲུབ་བྱའི་དོན་དེ་ནི།",
    "གཞན་ཡང་ཁྱོད་ལ་གཏན་ཚིགས་མེད་པར་ཡང་།",
    "གཉི་ག་ཚོགས་པ་དང་སོ་སོ་རེ་རེ་དང་དེ་དག་མ་གཏོགས་པ་དག་ལ་ཡང་མེད་པས་རང་བཞིན་མེད་པའོ།",
    "གཞན་ཡང་སྤྲུལ་པའི་སྐྱེས་བུ་ཡིས་ནི་སྤྲུལ་པ་ཡི་སྐྱེས་བུ་གཞན་དོན་འགའ་ཞིག་གི་ཕྱིར་འོང་བར་བྱེད་པ་ཉིད་འགོག་པ་དང་།",
    "སྒྱུ་མས་ཕྱུང་བའི་སྐྱེས་བུ་གཞན་དོན་འགའ་ཞིག་གི་ཕྱིར་འོང་བ་ལ་འགོག་པར་བྱེད་པ་ལྟར།",
    "ཁྱོད་ཀྱིས་གང་བརྩམས་པའི་དཔེ་འདི་ངེད་ཀྱི་དཔེ་མིན་ཏེ།",
    "བུད་མེད་ལ་ནི་བུད་མེད་དེ་རང་བཞིན་གྱིས་གྲུབ་པ་ཉིད་དོ་སྙམ་དུ།",
    "དེས་ན་ང་ལ་ཁས་བླངས་པ་སྔོན་དུ་སོང་བའི་སྐྱོན་དེ་ཡོད་པ་ཞིག་ན།",
    "གཞན་ཡང་གལ་ཏེ་ཁྱོད་ཀྱིས་དོན་དེ་རྣམས།",
    "རང་གི་བདག་ཉིད་ཀྱང་གསལ་བ་ལྟར།",
    "རང་གི་བདག་ཉིད་དང་གཞན་གྱི་བདག་ཉིད་རབ་ཏུ་སྒྲུབ་པར་འདོད་ཅེ་ན།",
    "མུན་ཁང་ནང་གི་བུམ་པ་མི་དམིགས་པ་མེས་གསལ་བར་བྱེད་པ་བཞིན།",
    "གཞན་ཡང་གལ་ཏེ་ཁྱོད་ཀྱི་ཚིག་གིས་བརྗོད་པ་བཞིན་དུ་ནི།",
    "མེ་ཡིས་རང་གི་བདག་ཉིད་གསལ་བར་བྱེད་ན།",
    "གཞན་ཡང་གལ་ཏེ་ཁྱོད་ཀྱི་ཚིག་གིས་སྨྲས་པ་བཞིན་དུ་ནི།",
    "འབར་བྱེད་རང་གི་ངོ་བོ་དང་ནི་གང་གཞི་གཞན་ན་ཡང་།",
    "འོ་ན་གང་གི་ཕྱིར་མེ་ལ་ཡང་མུན་པ་མེད།",
    "གང་གི་ཕྱིར་དེ་དག་དེ་ལྟར་འགྲུབ་ན།",
    "ཁྱོད་ཀྱིས་གཉིས་ཀའང་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "དེས་ན་གང་གིས་གང་ཞིག་བསྐྱེད་པར་སྨྲོས་ཤིག།",
    "རང་གི་ངོ་བོར་ཇི་ལྟར་འགྱུར།",
    "རང་གི་ངོ་བོ་དེ་རྒྱུ་རྐྱེན་འགའ་ལའང་།",
    "དེ་མེད་པའི་ཕྱིར་དགེ་སྦྱོང་གི་ཚུལ་གྱི་འབྲས་བུ་མེད་པར་འགྱུར་ཏེ།",
    "བདེན་པ་མཐོང་བ་ལས་དགེ་སྦྱོང་གི་ཚུལ་གྱི་འབྲས་བུ་རྣམས་ཡང་དག་པར་འཐོབ་པས་སོ།",
    "དགེ་སྦྱོང་གི་ཚུལ་གྱི་འབྲས་བུ་རྣམས་མེད་པས་ཚངས་པར་སྤྱོད་པ་ལ་གནས་པར་མི་འགྱུར་རོ།",
    "དེ་བས་ན་ཁྱོད་ཀྱི་འདུས་བྱས་ཀྱི་དངོས་པོ་ཀུན།",
    "དེ་ལྟར་ཁྱོད་ཀྱིས་ལན་བཏབ་ཀྱི།",
    "ང་ཡི་མིང་གི་རང་བཞིན་ཡང་ཡོད་པར་མི་སྨྲའོ།",
    "གལ་ཏེ་མིང་དེ་ཡོད་པ་ཞིག་གི་ཡིན་ནམ་མེད་པ་ཞིག་གི་ཡིན་གྲང་ན།",
    "ཁྱོད་ཀྱིས་སྨྲས་པ་གཉིས་ཀའང་ཉམས་པ་ཡིན་ཏེ།",
    "དེ་བས་ན་མིང་གི་རང་བཞིན་ཡོད་དོ་ཞེས་པའི་དམ་བཅའ་ཉམས་པ་ཡིན་ནོ།",
    "ཁྱོད་ཀྱིས་ཀླན་ཀ་གང་ཡིན་པ་དེ་ཚོལ་བར་བྱེད་པ་ཡིན་ནོ།",
    "གཞན་ཡང་ཁྱོད་ཀྱིས་འོན་ཏེ་རང་བཞིན་ཞིག་ཡོད་ལ།",
    "དོགས་པ་འདི་རིགས་པ་མ་ཡིན་མོད་ཀྱི།",
    "མི་རིགས་པའི་དོགས་པ་དེ་ནི་ཁྱོད་ཀྱིས་བྱས་སོ།",
    "ཁྱོད་ནི་འགོག་པར་བྱེད་པས་སོ།",
    "གཞན་ཡང་གལ་ཏེ་ངས་དངོས་པོ་འགའ་ཞིག་འགོག་པར་བྱེད་ན་ནི་ཁྱོད་ཀྱིས་དེ་སྐད་ཀྱང་སྨྲ་བར་རིགས་ན་གང་གི་ཕྱིར་དགག་པར་བྱ་བ་ཅི་ཡང་མེད་པས་ན།",
    "ཡང་དག་པ་མིན་པ་དེ་ནི་ཁྱོད་ཀྱིས་སྨྲས་སོ།",
    "གཞན་ཡང་ཁྱོད་ཀྱི་ཚིག་དག་མེད་པར་ཡང་དངོས་པོ་རྣམས་མེད་པ་ཡི།",
    "དེ་ལ་ཚིག་གིས་ནི་དངོས་པོ་རྣམས་རང་བཞིན་མེད་ཅེས་ངེས་པར།",
    "དེ་ལ་ཁ་ཅིག་གིས་མེད་དོ་ཞེས་སྨྲ་ན་ཚིག་དེས་ལྷ་སྦྱིན་མེད་པར་མི་བྱེད་ཀྱི།",
    "གཞན་ཡང་སྨིག་རྒྱུའི་དཔེ་དེ་ལ་ཁྱོད་ཀྱིས་ཀྱང་།",
    "དགེ་སྦྱོང་གི་འབྲས་བུ་དང་།",
    "དེ་སྲིད་པས་ཉོན་མོངས་པ་དང་།",
    "ཉོན་མོངས་པའི་གཞི་རྣམས་སྲིད་དོ།",
    "༡༨ དཔལ་རྭ་ཚར་གཉིས་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་བཞེད་པ་རྡོ་རྗེ་འཇིགས་བྱེད་བཅུ་གསུམ་པའི་མངོན་དཀྱིལ་ལྷན་ཐབས་ཆ་ལག་བཅས་ཕྱོགས་གཅིག་ཏུ་བཀོད་པ་ཟབ་དོན་རབ་གསལ།",
    "༢ གཤེད་དམར་ལྷ་ལྔའི་སྒྲུབ་དཀྱིལ་བདག་འཇུག་གི་ཡི་གེ་བློ་དམན་འཇུག་བདེ།",
    "༢༦ ངན་སོང་སྦྱོང་རྒྱུད་ནས་གསུངས་པའི་རོ་སྲེག་སྔོན་འགྲོའི་ཕུང་པོ་ཆས་འཇུག་གམ་རུས་ཆོག་ཟུར་བཀོལ་ཐར་འདྲེན་ལྕགས་ཀྱུ།",
    "༤༡ འཕགས་པ་སྤྱན་རས་གཟིགས་གཙོ་འཁོར་གསུམ་པའི་སྒྲུབ་ཐབས་རྗེས་གནང་དང་བཅས་པ་བློ་དམན་གོ་བདེ།",
    "༤༢ འཕགས་པ་སྤྱན་རས་གཟིགས་ཀྱི་སྒྲུབ་ཐབས་བསྡུས་པ།",
    "༥༡ ཆེ་མཆོག་པདྨ་ཐོད་ཕྲེང་གི་སྒྲུབ་ཐབས་རྒྱས་འབྲིང་བསྡུས་གསུམ་གྱི་རྣམ་བཞག་ཉུང་ངུའི་ཚུལ་དུ་བཀོད་པ་བློ་དམན་རྣམས་ཀྱི་རྟོགས་པ།",
    "༧༡ ཧོར་རྩ་བོད་རྩར་སོང་བའི་སྤྱི་འགྲོ།",
    "༨༧ ངོར་ཆེན་རྡོ་རྗེ་འཆང་གི་ལམ་འབྲས་བཀའ་རྒྱ་ཐིམ་པའི་གཟིགས་སྣང་འབྲི་ཐོ།",
    "༩༡ དཔལ་ས་སྐྱར་ཞལ་གཏོར་ཆེན་སྐབས་ཟོར་ལས་པ་རིམ་ཅན་ནས་སྔོན་འགྲོ་སྒྲུབ་བསྙེན་གྱི་རྟེན་བླ་རྡོ་བྲམ་གཟུགས་ཀྱི་རི་མོ་ཅན་གྱི་བཞུགས་ཁང་ཞིང་བཀོད་ཐོ།",
    "༩༢ དངོས་གྲུབ་གླིང་དུ་དཀར་མོ་ཉི་ཟླ་དང་བདུད་རྒྱལ་གྱི་འབུར་སྐུ་བཞེངས་པའི་བྱིན་རྟེན་གཟུངས་བཞུགས་ཐོ།",
    "༩༣ ཐར་རྩེ་རྡོ་རྗེ་འཆང་གི་སྐུ་པུར་ལ་སྙན་ཤལ་ཕུལ་བའི་ཞལ་དབྱངས།",
    "འཇམ་མགོན་ཨ་མེས་ཞབས་གཉིས་ཀྱིས་མཛད་པའི་ཕྱག་དེབ་ལྷན་ཅིག་ཏུ་བསྒྲིགས་ནས་ཚིག་ཚོགས་ཕྱུང་ཞིང་གསལ་བྱེད་རིམ་པར་བཀོད་ན།",
    "༡༦ ལྕང་ཅན་གུང་གི་སྙན་ཤལ་ཞལ་བྱང་།",
    "༡༡ དཔལ་ས་སྐྱའི་ཕུར་སྒྲུབ་ཆེན་མོའི་འཆམས་ལ་སོགས་ཀྱི་སྐབས་སུ་ཉེ་བར་མཁོ་བ་ཕྱག་ལེན་མཛེས་རྒྱན།",
    "༡༣༤ དབྱངས་ཅན་ལྷ་མོའི་བསྒོམ་བཟླས་ཤེས་བྱ་རྒྱ་མཚོར་འཇུག་པའི་གྲུ་ཆེན།",
    "༡༣༥ ཁྱུང་ནག་གི་རྗེས་གནང་།",
    "༡༤༤ རྗེ་བཙུན་རིག་བྱེད་མའི་རྗེས་གནང་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་རྣམ་གཞག་ཚར་ཆེན་ཡབ་སྲས་ཀྱི་ཕྱག་བཞེས་ཟབ་དོན་འཁྲུལ་མེད།",
    "༡༥༥ དོན་ཞགས་གཟུངས་ཆོག་གི་གསལ་བྱེད་སྡུག་བསྔལ་ཀུན་སེལ།",
    "༡༦༡ ལྷ་མོ་ཤྲ་ཝ་ཎའི་སྒོ་ནས་རྨི་བརྟག་སྒྲུབ་ཚུལ་དུས་གསུམ་བླང་དོར་རབ་གསལ།",
    "༡༦༢ སློབ་དཔོན་ཉི་མ་སྦས་པའི་ལུགས་ཀྱི་སྒྲོལ་མ་ཉེར་གཅིག་གི་རྗེས་གནང་བྱ་ཚུལ་གསལ་བར་བཀོད་པ་བློ་གསལ་ཉེར་མཁོ།",
    "༡༧༡ དཔལ་རྡོ་རྗེ་ནག་པོ་ཆེན་པོ་གུར་གྱི་མགོན་པོའི་གསང་ཁྲིད་ཐུན་མོང་མ་ཡིན་པ་འཆད་ཚུལ་གསང་བ་ལས་ཀྱང་ཆེས་གསང་བ་ངེས་དོན་ཟབ་མོའི་བཅུད་ཐིགས།",
    "༡༧༣ འཕགས་མ་འོད་ཟེར་ཅན་མའི་སྦྱིན་སྲེག་གི་ཆོ་ག་འོད་ཟེར་མཐའ་ཡས།",
    "༡༧༧ གསང་བ་འདུས་པ་མི་བསྐྱོད་རྡོ་རྗེ་ཀླུ་སྒྲུབ་ལུགས་ཀྱི་བསྙེན་པའི་ཁ་སྐོང་གི་སྦྱིན་སྲེག་གསང་གསུམ་ཡེ་ཤེས་མེ་འོད།",
    "༡༨༦ དཔལ་རྡོ་རྗེ་གཞོན་ནུའི་སྦྱིན་སྲེག་གི་ཆོ་ག་ཡེ་ཤེས་མེ་ཆེན།",
    "༡༨༨ གུ་རུ་པདྨ་ཐོད་ཕྲེང་གི་སྦྱིན་སྲེག་སྒྲིབ་སེལ་ཉི་འོད་བཞུགས་པའི་དབུའོ།",
    "༢༤ སོ་འབྲང་འཁོར་ལོ་བཅུ་གསུམ་མའི་རབ་གནས་དང་འདོགས་ཚུལ་ཐུན་མོང་མ་ཡིན་པའི་གསལ་བྱེད་འདོད་དགུའི་རེ་སྐོང་།"
  ]
}