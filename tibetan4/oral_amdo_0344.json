    "རྒྱ་གར་རང་གི་སྐད་ཀྱི་ཐོག་ནས་གོ་བ་ལོན་ཁག་པོ་ཡོད་པ་རྣམས་བོད་ཡིག་གི་བསྒྱུར་དཔེའི་ཐོག་ནས་དང་པོའི་མ་ཡིག་གི་གོ་དོན་ཇི་མ་ཇི་བཞིན་ཤེས་ཐུབ་པ་ཡོང་གི་ཡོད་པ་དེའི་ཐོག་ནས།",
    "༥གོ་རིམ་ལྡན་པ་དང་ཆ་ཚང་བའི་བརྡ་སྤྲོད་རིག་པ་ཁུངས་བཙན་ཡོད་པ་རེད།",
    "རང་རེའི་བོད་ཀྱི་བརྡ་སྤྲོད་རིག་པ་ནི་དུས་རབས་བདུན་པའི་འགོར་སློབ་དཔོན་ཐོན་མི་སམ་བྷོ་ཊས་སྐབས་དེའི་བོད་སྤྱིའི་ཕལ་སྐད་ལ་བརྟག་དཔྱད་ནན་ཏན་མཛད་པའི་རྨང་གཞིའི་ཐོག་སུམ་ཅུ་པ་དང་རྟགས་འཇུག་སོགས་བོད་ཀྱི་སྒྲ་རིག་པའི་བསྟན་བཅོས་བརྒྱད་བརྩམས་པ་གནང་བ་ནས་ད་བར་ལོ་ཆིག་སྟོང་སུམ་རྒྱ་ཉི་ཤུ་ལྷག་ཙམ་སོང་ཚར་བ་རེད།",
    "གོ་བ་ཡང་ལོན་ཐུབ་ཀྱི་ཡོད་པ་རེད།",
    "དཔེར་ན་དེ་སྔོན་དུས་རབས་བརྒྱད་པའི་དཀྱིལ་དུ་བཙུགས་པའི་ཞོལ་རྡོ་རིང་ཕྱི་མ་དང་དུས་རབས་དགུ་པའི་དཀྱིལ་དུ་བཙུགས་པའི་ལྷ་ས་གཙུག་ལག་ཁང་མདུན་གྱི་རྡོ་རིང་ཐོག་གི་བོད་ཡིག་རྣམས་ལྟ་སྐབས།",
    "གོ་བ་ཡང་ལེན་ཐུབ་ཀྱི་ཡོད་པ་དེ་རེད།",
    "མིང་ཚིག་གསར་པ་ཁ་སྣོན་གང་བྱས་ཀྱང་ད་ཡོད་ཡིག་འབྲུ་བཞི་སྟོང་ལྷག་ཙམ་དེ་རང་གི་སྟེང་ནས་བྱེད་ཆོག་པ་ཡིན།",
    "མི་རིགས་གཞན་དག་གི་ཡི་གེ་དང་སྐད་སྒྲ་སྦྱོར་བྱས་ན་བོད་ཡིག་འདི་རང་གི་ཐོག་ནས་བྱེད་ཆོག་པ།",
    "དབྱིན་ཇིའི་སྐད་བཅས་སྒྲ་སྦྱོར་བྱས་པ་དེ་ཚོ་མི་རིགས་གཞན་དག་གི་ཡི་གེའི་ཐོག་ནས་སྒྲ་སྦྱོར་ལས་ཧ་ཅང་གིས་སྒྲ་དག་པ་དང་ཡག་པ་ཡོད།",
    "ད་ལྟ་ཀྲུང་གོ་གུང་ཁྲན་ཏང་གི་ཡང་དག་པའི་དབུ་ཁྲིད་ཡོད་པ་དང་།",
    "སྤུན་ཟླ་མི་རིགས་ཁག་གི་ཤུགས་ཆེན་རྒྱབ་སྐྱོར་ཡོད་པ།",
    "རྒྱ་ཆེའི་མི་རིགས་ཁག་གི་དགེ་སློབ་ཚང་མས་ཚན་རིག་སློབ་སྦྱོང་དང་།",
    "མི་རྣམས་ཐུན་མོང་གི་བྱ་སྤྱོད་གཅིག་གྱུར་ཞིག་ཡོང་རྒྱུར་སྐུལ་འདེད་བྱུང་ཞིང་།",
    "སྐད་རྒྱག་པ་དེས་མ་ལྡེང་བའི་ཆ་རྣམས་ལག་པའི་བརྡ་དང་ལུས་ཀྱི་རྣམ་འགྱུར་ལ་བརྟེན་ནས་གོ་ཐབས་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "འཚོ་བ་དངོས་ཀྱི་གོམས་གཤིས་ཐོག་ཡི་གེ་ཟེར་བའི་མིང་དེ་རྣ་བར་གོ་མ་ཐག་ཤོག་བུའི་ཐོག་ཏུ་བྲིས་པའི་རི་མོ་དེ་རང་ལམ་གྱིས་དྲན་ཡོང་བ་ལས།",
    "རི་མོ་དེ་སྐད་ཀྱི་སྒྲ་གདངས་མཚོན་བྱེད་ཀྱི་བརྡ་རྟགས་ཡིན་པ་དང་།",
    "མཐོ་དམན་མི་འདྲ་ཞིང་ནང་དོན་ཡོད་པའི་སྒྲ་གདངས་དེ་བསམ་བློ་མཚོན་བྱེད་ཀྱི་བརྡ་རྟགས་ཡིན་པ་དེ་གཉིས་བསམ་བློའི་ནང་འཁོར་ཐུབ་ཀྱི་མེད་པ་རེད།",
    "གི་སྤུངས་ཡིག་ཟེར་བ་ཞང་ཞུང་གི་ཡིག་རྒན་དུ་བསྒྱུར་ཞིང་།",
    "དེ་ནས་སྨར་བྲག་གི་ཡི་གེར་བསྒྱུར་བ་དང་།",
    "ཡི་གེ་ཡོད་པའི་མི་རིགས་གང་འདྲ་ཞིག་ཡིན་རུང་རང་ཉིད་ཀྱི་ཡི་གེ་དེ་རང་ཉིད་ཀྱི་སྐད་གཞིར་བཟུང་ནས་བཟོས་པ་ཡིན་པ་ལྟར་བོད་ཡིག་ཀྱང་དེ་འདྲ་རང་རེད།",
    "རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོའི་གོང་དུ་བོད་ཡིག་རྙིང་པ་ཞིག་ཡོད་པ་དེ་ནི་ཞང་ཞུང་གི་ཡིག་རྙིང་ཡིན་པ་དང་།",
    "རྟགས་འཇུག་སོགས་བརྡ་སྤྲོད་རིག་པའི་བསྟན་བཅོས་བརྒྱད་བརྩམས་པ་རེད།",
    "བོད་ཡིག་ནི་བོད་རིགས་འདུས་སྡོད་ཀྱི་ས་གནས་ཁག་ཚང་མས་ཐུན་མོང་དུ་གོ་ཐུབ་པའི་སྐད་ཀྱི་སྒྲ་གདངས་ཆགས་ཚུལ་ལ་ཞིབ་འཇུག་བྱས་པའི་རྨང་གཞིའི་ཐོག་དེ་དང་མཐུན་པའི་སྒྲ་སྦྱོར་ཡི་གེ་དང་།",
    "བོད་ཡིག་གི་སྒྲ་སྦྱོར་བྱེད་སྟངས་ཀྱང་དབྱངས་བཞི་འམ་ལྔ་ལས་མེད་པ་དང་།",
    "དེ་ནི་དེང་སྐབས་བོད་དབུས་གཙང་གི་སྐད་ཀྱི་ནང་སྒྲ་གདངས་གསལ་བར་མ་ཐོན་པ་ཙམ་ལས།",
    "གནའ་རབས་ཀྱི་ཡི་གེ་དེ་ཚོ་དེང་སང་ཡང་བོད་ཡིག་གི་ཆུ་ཚད་ངེས་ཅནཡོད་པའི་མི་ཚང་མས་བརྒྱ་ཆ་དགུ་བཅུ་ཚོད་དཔག་བྱས་པ་ཙམ་མ་ཡིན་པར་ཀློག་ཐུབ་པ་དང་གོ་བ་ལེན་ཐུབ་ཀྱི་ཡོད་པ་དཔེར་ན།",
    "ལྷ་ས་གཙུག་ལག་ཁང་མདུན་གྱི་དབོན་ཞང་མཐུན་འབྲེལ་རྡོ་རིང་སོགས་རྡོ་རིང་བོད་ཡིག་འཁོད་པ་ཚོར་བལྟས་ན་ནང་དོན་ཆ་ཚང་གོ་ཐུབ་པ་ལྟ་བུ་རེད།",
    "ཡི་གེ་དེ་དག་གི་གོ་དོན་གང་དང་གང་ཞིག་སྦྱོར་ནས་སྟོན་པའི་གནས་ཚུལ་ཡང་ག་ལ་ཤེས་ཐུབ་ཅེས་གསུང་རྒྱུ་ཡིན་པ་གསལ་པོ་རེད།",
    "འདི་ཐོག་མར་གསར་གཏོད་གནང་སྐབས་ས་གནས་སོ་སོའི་ཡུལ་སྐད་གཞིར་བཟུང་བ་མ་ཡིན་པར་ས་གནས་མང་ཆེ་བས་ཐུན་མོང་དུ་གོ་ཐུབ་པའི་ཕལ་སྐད་གཞིར་བཟུང་བ་ཡིན་པར་བརྟེན་དབུས་གཙང་ཁམས་གསུམ་དང་།",
    "༧མི་རིགས་གཞན་གྱི་སྐད་བརྡ་སྒྲ་སྦྱོར་བྱེད་སྐབས་བོད་ཡིག་རང་གི་ཐོག་ནས་བྱེད་ཐུབ་པ།",
    "ལག་རྩལ་སོགས་འགའ་ཞིག་མི་རིགས་སོ་སོའི་སྐད་དེ་ཉིད་རང་སོར་མ་བཞག་པར་གང་བྱུང་དོན་བསྒྱུར་བྱས་ན་ཕན་པ་ལས་གནོད་པ་ཆེ་བ་ཡིན་པས་དེ་འདྲའི་རིགས་རྣམས་བོད་ཡིག་རང་གི་ཐོག་ནས་སྒྲ་སྦྱོར་བྱས་ཚེ།",
    "དེང་སང་ང་ཚོས་བེད་སྤྱོད་གཏོང་བའི་ལག་རྒྱུན་འདི་ཡིན་ཞིང་།",
    "དེ་གཉིས་ཟུང་འབྲེལ་བྱས་པའི་དཔེ་རིས་བཟོས་ཏེ་པར་སྐྲུན་བྱས་པ་སོགས་ནི་ང་ཚོས་བསྟོད་བསྔགས་བྱེད་འོས་པ་ཞིག་རེད།",
    "སྐད་ཆ་ནི་བསམ་བློའི་ཚབ་བྱེད་མཁན་ཡིན་སྟབས་རང་གིས་བྲིས་པའི་ཡི་གེ་དེས་སྐད་ཆའི་ཚབ་བྱེད་ཐུབ་མིན་ནི་ཡི་གེ་དེ་མི་གཞན་དག་གིས་ཀློག་ཐུབ་མིན་ལ་རག་ལུས་ཡོད་པ་དང་།",
    "རང་ཉིད་ཀྱིས་བྲིས་པའི་ཡི་གེ་དེས་ཕན་ཐོགས་གང་ཡང་མ་བྱུང་བ་རེད།",
    "སྐྱོགས་སྟོན་ལོ་ཙཱ་བ་རིན་ཆེན་བཀྲ་ཤིས་ཀྱིས་བརྩམས་པའི་དག་ཡིག་ལི་ཤིའི་གུར་ཁང་གི་ཤོག་གྲངས་༡ན་༡ ༢བ་༡བར་གསལདེ་ནས་དུས་རབས་དགུ་པའི་མགོར་རྒྱལ་པོ་ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་དུས་སུ་ལོ་ཙཱ་བ་སྐ་བ་དཔལ་བརྩེགས་དང་།",
    "སྐབས་དེར་ཡི་གེའི་དག་ཆ་ལ་བཅོས་བསྒྱུར་གང་བྱས་པའི་སྐོར་གོང་གསལ་དག་ཡིག་ལི་ཤིའི་གུར་ཁང་གི་ཤོག་གྲངས་༣ བ་༣ནས་༡༢ན་༣བར་གསལ།",
    "དེང་སང་བོད་ཡིག་གི་བཅོས་བསྒྱུར་ཐེངས་གཉིས་པ་ཟེར་ཆོག་དུས་སྐབས་དེའི་རིང་བཅོས་བསྒྱུར་གང་དང་གང་བྱས་སྐོར།",
    "གོང་གསལ་དག་ཡིག་ལི་ཤིའི་གུར་ཁང་གི་ཤོག་གྲངས་༣ བ་༡དཔེ་མཚོན་འགའ་ཞིག་དྲངས་ཏེ་མཇུག་ཏུ།",
    "བསྒྱུར་ཐེངས་གཉིས་པ་ལྟར་རང་འཇགས་གནས་པའི་གནས་ཚུལ་དེ་ལ་བརྟགས་ན་བློ་སྒོ་ཆེན་པོ་ཕྱེ་ཐུབ་ཀྱི་རེད།",
    "དེང་སྐབས་ང་ཚོས་རྒྱུན་དུ་ཁ་སྐད་དང་ཡིག་སྐད་ཟེར་བའི་ཐ་སྙདཅིག་ཤོད་སྲོལ་ཡོད་པ་ཡིན་མོད་ཀྱང་།",
    "ས་གནས་ཁག་མང་པོར་ཁྱབ་ཅིང་མང་ཆེ་བས་ཐུན་མོང་དུ་གོ་ཐུབ་པའི་སྐད་ལ་ཕལ་སྐད་ཟེར་བའི་མིང་བཏགས་ཡོད།",
    "དེ་ཡང་ས་གནས་འགའ་ཞིག་གི་ཡུལ་སྐད་དེ་ས་གནས་གཞན་ཞིག་ལ་ཡིག་སྐད་ཡིན་པ་དང་།",
    "ས་གནས་འགའ་ཞིག་གི་ཡིག་སྐད་དེ་ས་གནས་གཞན་ཞིག་ལ་ཡུལ་སྐད་ཡིན་པ་དེ་འདྲ་རེད།",
    "ས་གནས་ཁག་མང་པོར་ཁྱབ་ཆེ་བའི་ཐུན་མོང་གི་སྐད་གཉིས་མཉམ་དུགནས་པའི་ཕྱོགས་གཉིས་ཀ་མཐོང་དགོས་པ་བཅས་རེད།",
    "ས་ཕྱོགས་ཀྱི་སྐད་རྣམས་གཅིག་ཏུ་གྱུར་ནས་མི་རིགས་ཀྱི་སྐད་ཐུན་མོང་བ་ཞིག་བྱུང་བ་ནི།",
    "ཐོན་སྐྱེད་བྱེད་མཁན་མི་དང་མིའི་བར་གྱི་འབྲེལ་བ་དེ་ཡང་རྒྱ་ཁྱོན་ཧ་ཅང་ཆུང་ཆུང་ཞིག་ལས་མེད་པར་བརྟེན།",
    "ཡུལ་ཚོ་གཞན་དག་བར་ཕན་ཚུན་འབྲེལ་བ་བྱེད་སྐབས་ཐུན་མོང་དུ་གོ་ཐུབ་པའི་སྐད་དེ་བེད་སྦྱོད་གཏོང་གི་ཡོད་ཀྱང་དེའི་དུས་ཡུན་ཐུང་ཐུང་ལས་མེད་པ་རེད།",
    "ཚོ་པ་ཁག་རྣམས་གཅིག་ཏུ་འདྲེས་ནས་གཅིག་གྱུར་གྱི་མི་རིགས་ཞིག་ཆགས་ཐུབ་པ་ཡོང་དང་མི་ཡོང་དེ་ཚོ་པ་ཁག་གི་ཐོན་སྐྱེད་ནུས་ཤུགས་དང་།",
    "སྐབས་དེར་ཕན་ཚུན་ཐུན་མོང་དུ་གོ་ཐུབ་པའི་སྐད་ཞིག་ཆགས་པ་དེ་མི་རིགས་ཀྱི་སྐད་རེད།",
    "དུས་ཡུན་རིང་པོར་བེད་སྤྱོད་བྱེད་ཐུབ་པའི་ཡི་གེ་ཞིག་དགོས་མཁོ་ཆེ་རུ་འགྲོ་བའི་རྗེས་སུ་གཞི་ནས་མི་རིགས་ཀྱི་ཡི་གེ་བྱུང་བ་རེད།",
    "ས་གནས་ཕན་ཚུན་བར་འབྲེལ་བ་བྱེད་སྐབས་ཐུན་མོང་དུ་གོ་ཐུབ་པའི་ཕལ་སྐད་ཡོད་ལ།",
    "རྒྱུན་དུ་སྤྱོད་པའི་ས་གནས་སོ་སོའི་ཡུལ་སྐད་ཀྱང་ཡོད་པ་དེ་འདྲ་ཞིག་ཡིན་པར་རྩི་གི་ཡོད།",
    "བློ་མཐུན་འགའ་ཞིག་གིས་ཚོ་པ་ཁག་རྣམས་གཅིག་ཏུ་འདྲེས་ནས་མི་རིགས་ཞིག་ཏུ་གྱུར་ཟིན་པའི་རྗེས་སུ་ཐུན་མོང་དུ་གོ་ཐུབ་པའི་སྐད་མ་གཏོགས་ས་གནས་སོ་སོའི་ཡུལ་སྐད་མེད་པ་ཆགས་ཟིན་པ་རེད་ཟེར་བ་དང་།",
    "ལྷག་པར་དུ་བོད་རིགས་ནི་གཅིག་གྱུར་གྱི་མི་རིགས་ཞིག་ཡིན་ཀྱང་ད་ལྟ་ཐུན་མོང་དུ་གོ་ཐུབ་པའི་ཕལ་སྐད་མེད་ཟེར་བ་དེ་ནི་དེ་བས་ཀྱང་ཁུངས་མེད་རེད།",
    "ཡུལ་སྐད་ཆེན་པོ་རིགས་གསུམ་གྱི་ནང་ནས་གང་ཞིག་ང་ཚོས་དེང་སང་ངོས་འཛིན་བྱས་པའི་ཡིག་སྐད་དང་མཐུན་པོ་ཡོད་མེད་ཞིབ་འཇུག་བྱས་ཏེ།",
    "མཐུན་པོ་ཡོད་པ་རྣམས་ཡུལ་སྐད་དང་ཡིག་སྐད་གཅིག་གྱུར་བྱེད་རྒྱུའི་གཞི་འཛིན་ས་བྱེད་དགོས་ཀྱི་རེད།",
    "དེ་མིན་འཚོ་བའི་ནང་གི་སྐད་ཆ་མང་ཆེ་བ་གོ་ཐུབ་ཀྱི་ཡོད་པ་དེ་ཐོག་ནས་བོད་སྐད་དེ་ལ་ས་གནས་སོསོའི་ཡུལ་སྐད་དང་།",
    "ཐུན་མོང་དུ་གོ་ཐུབ་པའི་ཕལ་སྐད་གཉིས་ཀ་ཡོད་པ་གསལ་པོར་མཐོང་ཐུབ་རྒྱུ་རེད།",
    "ཡུལ་སྐད་དང་ཡི་གེ་གཅིག་གྱུར་བཟོ་ཐུབ་རྒྱུ་ཕར་ཞོག་གསར་བཟོས་ཡི་གེའི་དག་ཆ་དེ་དང་ས་གནས་གཞན་དག་གི་ཡུལ་སྐད་བར་ཁ་བྲལ་ཆེ་རུ་འགྲོ་གི་རེད།",
    "རྒྱལ་མོ་རོང་།",
    "དེ་རྣམས་ཀྱིས་བེད་སྤྱོད་གཏོང་རྒྱུའི་བོད་ཡིག་ནི་གཅིག་མ་གཏོགས་ས་གནས་རེ་རེ་ལ་བོད་ཡིག་རེ་རེ་མེད་པ་རེད།",
    "གལ་ཏེ་ལྷ་སའི་སྐད་དང་མཐུན་པའི་བོད་ཡིག་གཅིག་བཟོས་ན་ས་གནས་གཞན་དག་གིས་དེ་གོ་མི་ཐུབ་པས་ཁོ་ཚོས་ཀྱང་སོ་སོའི་སྐད་དང་མཐུན་པའི་བོད་ཡིག་གསར་པ་ཞིག་བཟོ་དགོས་པ་ཡོང་ཞིང་།",
    "བོད་ཡིག་ནི་ཀྲུང་གོའི་མི་རིགས་ཁག་གི་ཡི་གེའི་ནང་གི་གཅིག་གྱུར་ཆགས་ཟིན་པའི་མི་རིགས་ཀྱི་ཡི་གེ་ཞིག་ཡིན་པས།",
    "གཅིག་གྱུར་གྱི་ཡི་གེ་ཁ་བྲལ་དུ་གཏོང་བའི་བཅོས་བསྒྱུར་དེ་འདྲ་ལ་སུས་ཀྱང་དགའ་བསུ་ཞུ་གི་མ་རེད།",
    "དུས་རབས་དེར་འཛམ་གླིང་གི་བཙན་རྒྱལ་རིང་ལུགས་མེད་པར་འགྱུར་རྒྱུ་དང་བཤུ་བཞོག་གྲལ་རིམ་གཏོར་ཏེ་མི་རིགས་ཁག་དང་བྲན་དུ་བཀོལ་ཡུལ་རྣམས་ལ་གཉའ་གནོན་བྱེད་པ་དེ་མེད་པར་འགྱུར་བ།",
    "ང་རང་གིས་བསམ་པར།",
    "གཅིག་གྱུར་ཆགས་ཟིན་པའི་མི་རིགས་ཞིག་གི་ནང་ས་གནས་ཀྱི་རང་བཞིན་ལྡན་པའི་ཡུལ་སྐད་དང་།",
    "ཐུན་མོང་གི་ཕལ་སྐད་བར་ཐག་ཉེ་རུ་འགྲོ་བའི་གོ་རིམ་ཁ་ཤས་བརྒྱུད་དགོས་པ་སྟེ།",
    "གོང་དུ་གསལ་བ་ལྟར་བོད་སྐད་ཀྱི་ཡུལ་སྐད་རིགས་གསུམ་དུ་བསྡུས་པ་དེ་རང་གི་ཐོག་ནས་ཡུལ་སྐད་དང་།",
    "དུས་མཚུངས་ས་གནས་ཁག་གི་ཡུལ་སྐད་ཀྱང་ཕན་ཚུན་ཐག་ཉེ་རུ་འགྲོ་གི་ཡོད་པ་བཅས་ནི་འགོག་ཐབས་མེད་པ་ཞིག་རེད།",
    "དེར་མ་ཟད་ད་དུང་ང་ཚོར་གཞི་རྒྱ་ཆེ་བའི་དཔེ་སྐྲུན་ཁང་དང་།",
    "ཚང་མའི་ནང་ནས་ལེགས་ཆ་འདུས་ཤིང་ཁྱབ་ཆེ་བའི་གཅིག་གྱུར་གྱི་སྐད་ཞིག་རེད།",
    "ང་ཚོས་བོད་སྐད་ཀྱི་འཕེལ་རྒྱས་འགྲོ་ཕྱོགས་དེ་དང་བསྟུན་ནས་མིག་སྔར་སྔར་ཡོད་སུམ་རྟགས་ཀྱི་འགྲོ་ལུགས་རྣམས་རྒྱུན་འཛིན་བྱས་པ་དང་ཆབས་ཅིག་ས་གནས་ཁག་གི་ཡུལ་སྐད་དང་།",
    "༧ རྒྱལ་པོ་ཁྲི་རལ་པ་ཅན་གྱི་དུས་བོད་ཀྱི་པཎྚི་ཏ་ལྕི་ཁྱི་འབྲུག་གིས་བརྩམས་པའི་གནས་བརྒྱད་རྩ་བ་དང་།",
    "ངལ་རྩོལ་གྱིས་སྤྲ་ནས་མིར་འགྱུར་བའི་གོ་རིམ་ནང་ཐོན་པའི་ནུས་པ་༡༩༧༥ལོར་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་པར་སྐྲུན་བྱས་པའི་དེབ་རྐྱང་པ།",
    "༣སྒྲ་རིག་པའི་སྐོར་གྱི་དོགས་པ་འགའ་ཞིག་ལ་མར་ཁེ་སིའི་རིང་ལུགས་ལྟར་ལན་བཏབ་པ་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་༡༩༥༨ལོར་པར་སྐྲུན་བྱས་པའི་སི་ཏ་ལིན་གྱི་གསུང་རྩོམ་དེབ་རྐྱང་པའི་བོད་ཡིག་ཤོག་གྲངས་༡༢པ།",
    "༦ སུམ་ཅུ་པའི་རྩ་བའི་མཇུག་ཏུ་སྒྲའི་བསྟན་བཅོས་བརྒྱད་ཀྱི་ནང་གི་དང་པོའི་ལེའུ་ལྔ་པ་ཡིན་པ་དང་།",
    "རྟགས་འཇུག་གི་མཇུག་ཏུ་སྒྲའི་བསྟན་བཅོས་དྲུག་གི་ནང་གི་གཉིས་པ་ཡིན་པར་བཤད།",
    "༡ སྙན་ངག་འགྲེལ་བ་མང་ཆེ་བའི་ནང་ཟུར་ཆག་གི་སྐད་དང་།",
    "༥༢༢གྱེསི་ཏ་ལིན་གྱི་གསུང་རྩོམ་སྒྲ་རིག་པའི་སྐོར་གྱི་དོགས་པ་འགའ་ཞིག་ལ་མར་ཁེ་སིའི་རིང་ལུགས་ལྟར་ལན་བཏབ་པ་༡༩༥༨ལོར་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་པར་སྐྲུན་བྱས་པའི་བོད་ཡིག་གི་དཔེ་དེབ།",
    "༢༦སི་ཏ་ལིན་གྱི་གསུང་རྩོམ་སྒྲ་རིག་པའི་སྐོར་གྱི་དོགས་པ་འགའ་ཞིག་ལ་མར་ཁེ་སིའི་རིང་ལུགས་ལྟར་ལན་བཏབ་པ་༡༩༥༨ལོར་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་པར་སྐྲུན་བྱས་པའི་བོད་ཡིག་གི་དཔེ་དེབ།",
    "མཁས་མཛངས་ལྡན་པའི་ཏང་ཀྲུང་དབྱང་གིས་གཡོན་ཐལ་བསམ་བློའི་རླབས་རྒྱུན་དང་།",
    "ཚན་པ་ཁག་གིས་དེའི་ཐད་ལ་ལེགས་སྐྱེས་ཆེན་པོ་ཕུལ་ཡོད་པ་འདི་ནི་རང་རྒྱལ་མི་རིགས་ཁག་གི་སེམས་ཀྱི་གཏིང་ནས་དགའ་སྤྲོ་སྐྱེ་འོས་པའི་བྱ་བ་རླབས་ཆེན་ཞིག་རེད།",
    "དེའི་ཐད་ལ་ཕུན་སུམ་ཚོགས་པའི་ཉམས་མྱོང་མང་པོ་བསགས་ཡོད་སྟབས་དེ་ཚོ་ཕྱོགས་བསྡུས་བྱས་ཏེ་རྒྱལ་ཁབ་ཕྱི་ནང་གི་ཚན་རིག་མཁས་པ་རྣམས་དང་།",
    "བོད་ཀྱི་དཀར་ཆག་རིག་པ་ཟེར་བའི་ཆེད་རྩོམ་འདི་བཞིན་ངོ་མཚར་ཆེ་བའི་གཟིགས་མོའི་སྔོན་འགྲོའི་འཁྲབ་ཚན་ལྟ་བུ་དང་།",
    "དཀར་ཆག་གི་ཆིངས་བདུན་ཞེས་པ་ནི།",
    "དཔེ་མཛོད་ཁང་གི་སྒོ་བརྒྱ་མྱུར་དུ་འབྱེད་པའི་ལྡེ་མིག་ལྟ་བུ།",
    "དཔྱད་གཞི་གསོག་འཇོག་ལེགས་སྒྲིག་བཅས་གནང་བ་བརྒྱུད་ཚན་རིག་གི་རང་བཞིན་ལྡན་པའི་གསུང་རྩོམ་རིན་ཐང་བྲལ་བ་མང་པོ་རྩོམ་གནང་མཛད་པ་དང་།",
    "༢ དཀར་ཆག་གི་ནུས་པ།",
    "དཀར་ཆག་གི་ནང་དུ་དཔེ་དེབ་སོ་སོའི་མིང་དང་།",
    "དགོས་མཁོ་ཆེ་ཆུང་གི་ཁྱད་པར་ཕྱེ་མེད་ལ་མ་ཕྱེ་ཡང་འགྲིག་པ་དང་།",
    "ཐ་ན་ཤོག་གྲངས་ཀྱི་རྒྱབ་མདུན་དང་ཡིག་ཕྲེང་གང་དང་གང་གི་ནང་དུ་གལ་ཆེའི་དཔྱད་གཞི་གང་དང་གང་ཡོད་པ་བཅས་ཀྱང་སེམས་ལ་འཇོག་ཐུབ།",
    "དེ་ནི་ཡིག་ཐོག་ཏུ་འཁོད་པའི་དཀར་ཆག་གིས་བསྡུར་ཐབས་མེད་པའི་དཀར་ཆག་གསོན་པོ་ཞིག་ཡིན་པས་ཞིབ་འཇུག་མི་སྣ་དང་།",
    "དཔེ་མཛོད་བདག་གཉེར་མཁན་བཅས་སུ་ཡིན་ཀྱང་ཡིག་ཐོག་གི་དཀར་ཆག་གཅིག་པུར་སྐྱབས་བཅོལ་ནས་བསྡད་ན་ལས་དོན་གྱི་ས་ཆོད་ཆུང་ཞིང་།",
    "༣ དཀར་ཆག་ནི་ཚན་རིག་ཞིབ་འཇུག་གི་ཐོག་མའི་འཇུག་སྒོ་ཡིན་པ།",
    "དེ་ཡང་ཆེད་ལས་ཚན་རིག་གི་ཞིབ་འཇུག་གང་བྱས་ཀྱང་དེའི་བྱ་ཡུལ་ངོ་མ་ནི་རང་བྱུང་ཁམས་དང་།",
    "༤དཀར་ཆག་ནི་དཔེ་མཛོད་ཁང་གི་སྒོ་བརྒྱ་མྱུར་དུ་འབྱེད་པའི་ལྡེ་མིག་ལྟ་བུ་ཡིན་ཏེ།",
    "དཀར་ཆག་ཡོད་ན་དེ་ལས་ལྡོག་པའི་དགེ་མཚན་མང་པོ་ཡོད་པ་རེད།",
    "འགའ་ཞིག་གིས་ལས་ཀ་དེ་འགོ་ཚུགས་ཟིན་པ།",
    "འགའ་ཞིག་ནི་ད་ལྟ་གྲ་སྒྲིག་བྱེད་མུས་ཀྱི་སྐབས་རེད།",
    "པར་གློག་རྒྱག་པ་སོགས་ཀྱི་ལས་ཀ་མང་པོ་ཞིག་ཏེན་ཙི་རྩིས་རྒྱག་འཕྲུལ་འཁོར་དང་རང་འགུལ་ཅན་དུ་འགྱུར་བའི་ཐབས་ཤེས་མང་པོ་གསར་གཏོད་བྱས་ཡོད་པ་རེད།",
    "སྤྱི་ལོའི་དུས་རབས་བརྒྱད་པའི་མཇུག་བཙན་པོ་ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་སྐབས་སུ་དཀར་ཆག་བཟོ་བའི་ལས་དོན་འགོ་ཚུགས་པ་ནས་ད་བར་ལོ་གྲངས་ཆིག་སྟོང་བརྒྱ་དང་བརྒྱད་ཅུ་གྱ་བཞི་སོང་ལ།",
    "དེའི་རིང་ལ་གལ་ཆེའི་ཉམས་མྱོང་ཕུན་སུམ་ཚོགས་ཙམ་བསགས་ཡོད་པས་ཉམས་མྱོང་བཟང་པོ་དེ་དག་རྨང་གཞིར་བྱས་ཏེ་ཚན་རིག་གི་རང་བཞིན་དང་།",
    "མྱུར་ཁྱད་ཅི་ཙམ་ཡོད་ན་ཡང་དེ་ཚོའི་ནུས་པ་ལེགས་པོ་འདོན་ཐུབ་མིན་ནི་མི་ལ་རག་ལས་པ་རེད།",
    "རྒྱ་ཁྱོན་ཆེ་བ་ཡིན་པས་དཀར་ཆག་མེད་ན་ལྟ་ཀློག་བྱེད་མཁན་ཚོར་གཡར་ཐབས་མེད་ལ།",
    "དེ་ལ་བརྟེན་ནས་རྒྱལ་ཁབ་དང་ཚན་པ་ཁག་གི་མི་ཤུགས་དང་།",
    "ལས་ཀའི་དུས་ཚོད་བཅས་མང་པོ་ཆུད་ཟོས་སུ་འགྲོ་བ་སོགས་ཏེ་གྱོང་གུན་བསམ་ཡུལ་ལས་འདས་པ་འབྱུང་རྒྱུ་རེད།",
    "དཔེ་མཛོད་ཁང་གི་དཀར་ཆག་དེ་འབྲེལ་གཏུགས་བྱེད་མཁན་དང་།",
    "མིག་དཔེ་བཟང་པོ་ཞིག་འཇོག་གནང་མཛད་པ་རེད།",
    "དེའི་ཞོར་ལ་བསྟན་བཅོས་དྲུག་གི་པར་ཡང་བཞེངས་ཡོད་སྐད་ལ་བསྟན་བཅོས་དྲུག་པོ་གང་དང་གང་ཡིན་རྗེས་སུ་རྩད་གཅོད་དགོས།",
    "སྐུ་ཕྲེང་ལྔ་པས་དཀར་ཆག་འདི་དངོས་སུ་གཟིགས་མྱོང་བ་ཡིན་པས་གསུང་ཚུལ་འདི་ཁུངས་བཙན་པར་སྣང་།",
    "ཁོང་རང་ཉིད་ཀྱིས་བོད་ཀྱི་དཔེ་མཛོད་ཁང་གི་སྐོར་བརྟག་དཔྱད་བྱེད་ཆེད་ཀ་རྡོར་སྒང་གསུམ་ཀ་ལོན་སྦུག་རྡོ་རྗེ་གླིང་།",
    "དཀར་ཆག་གི་ཞལ་བྱང་ནི་རྗེས་སུ་མ་དཔེ་རྙེད་ན་འབྲི་དགོས།",
    "གོ་ཐོས་ལ་ཨ་མེ་རི་ཀའི་མི་ཇོ་སེབ་རོག་གིས་༡༩༢༥ལོར་ཨ་མེ་རི་ཀའི་རྒྱལ་ཡོངས་དཔེ་མཛོད་ཁང་གི་ཆེད་དུ་ཅོ་ནེ་བཀའ་བསྟན་གཉིས་ཀ་ཆ་ཚང་པར་འདེབས་བླུ་ཡོན་ཞུས་ཏེ་རྒྱལ་ས་ཝ་ཤིང་ཀྲོན་དུ་བཞག་ཡོད་སྐད།",
    "༡༩༤ལོར་རྒྱལ་ས་ཏོག་ཁྱོའི་ཐྲོ་ཡོ་སྦུང་གོའི་དཔེ་མཛོད་ཁང་དུ་ཡོད་སྐད་དང་།",
    "ད་དུང་ཕྱི་སོག་དང་སུའུ་ལེན་ལ་ཡང་ཆ་ཚང་རེ་གཉིས་ཡོད་སྐད།",
    "བཀའ་གངས་ཅན་གྱི་བརྡས་དྲངས་པའི་ཕྱི་མོའི་ཚོགས་ཇི་རྙེད་པ་དཔར་དུ་བསྒྲུབས་པའི་ཚུལ་ལས་ཉེ་བར་བརྩམས་པའི་གཏམ་བློ་ལྡན་མོས་པའི་ཀུནྡ་ཡོངས་སུ་ཁ་ཕྱེ་བའི་ཟླ་འོད་གཞོན་ནུའི་འཁྲི་ཤིང་ཞེས་འཁོད་ཡོད་ཅིང་།",
    "ཞལ་བྱང་དུ་བསྟན་བཅོས་འགྱུར་རོ་ཅོག་གི་དཀར་ཆག་འཇིག་རྟེན་གསུམ་གྱི་བདེ་སྐྱིད་པད་ཚལ་བཞད་པའི་ཉིན་བྱེད་ཅེས་འཁོད་ཡོད།",
    "ཞལ་བྱང་དུ་བཀའ་ཡི་དགོངས་པ་འགྲེལ་པའི་བསྟན་བཅོས་འགྱུར་རོ་ཅོག་གི་དཀར་ཆག་དོན་ལྡན་ཚངས་པའི་དབྱངས་ཞེས་འཁོད་ཡོད།",
    "དེ་རྗེས་རབ་བྱུང་བཅུ་བཞི་བའི་མགོ་སྤྱི་ལོའི་དུས་རབས་བཅུ་དགུ་བའི་དཀྱིལ་སྟོད་ཙམ་དུ་འཇམ་དབྱངས་བཞད་པ་སྐུ་ཕྲེང་གསུམ་པའི་དྲུང་ཡིག་རྗེ་ཤེས་རབ་རྒྱ་མཚོས་འཇམ་དབྱངས་བཞད་པ་སྐུ་ཕྲེང་རིམ་པའི་གཟིགས་དཔེ་ཡོད་ཚད་དངོས་སུ་མཇལ་གནང་བའི་གོ་སྐབས་བཟང་པོ་ཐོབ་པ་ཕྱི་རབས་ཀྱི་མི་རྣམས་ལ་ངོ་སྤྲོད་མཛད་ཆེད།་",
    "དཔེ་རྒྱུན་དཀོན་པ་འགའ་ཞིག་གི་ཐོ་ཡིག་དོན་གཉེར་ཡིད་ཀྱི་ཀུནྡ་བཞད་པའི་ཟླ་འོད་འབུམ་གྱི་སྙེ་མ་དུང་དཀར་བློ་བཟང་འཕྲིན་ལས་ཀྱི་གསུང་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "ད་བར་བློ་མཐུན་མང་པོ་ཞིག་གིས།",
    "གསན་ཡིག་ནི་དཀར་ཆག་གི་གོ་ཆོད་པའི་དཔེ་ཐོ་ཞིག་ཡིན།",
    "དཀར་ཆག་ཁག་གི་ནང་དུ་མ་གསལ་བའི་དཔེ་རྒྱུན་དཀོན་པ་མང་པོ་ཞིག་གི་ཐོ་བཀོད་ཡོད་ལ་དཀར་ཆག་གི་ཚབ་བྱེད་ཐུབ་པ་ཡིན།",
    "དཀར་ཆག་ཁག་གི་ནང་མ་འཁོད་པའི་གསུང་རྩོམ་ཁག་གི་རྩོམ་པ་པོ་དང་།",
    "དཀར་ཆག་རིག་པའི་རྨང་གཞི་ཡང་དེ་ནས་བྱུང་བ་རེད།",
    "རོལ་མོའི་བསྟན་བཅོས།",
    "ཁྱོན་ཡོངས་ཀྱི་ཕྱོགས་ནས་ལེགས་པོ་ཡོད་ཅིང་།",
    "ཀ་ཐོ་ཞེས་པ་ནི་བོད་ཡིག་གི་ཀ་མད་སུམ་ཅུ་ཐམ་པ་ལ་དབྱངས་བཞི་བོ་གང་ཡང་མ་སྦྱར་བ་སུམ་ཅུ་དང་།",
    "ཨོ་ལྡན་བཅས་རེ་རེ་ལ་ཡང་སུམ་ཅུ་རེ་ཡོད་པ་བསྣན་པས་ཀ་མད་བརྒྱ་དང་ལྔ་བཅུ་ཐམ་པ་ཡོད་པས་ཀ་ཐོ་ལྡང་ངེས་ཡོད་ཅིང་།",
    "དེའི་ཨང་རྟགས་མ་གཏོགས་གཞན་དག་བཀོད་མེད་པ་རེད།",
    "གཞན་གྱིས་རྐུ་འཁྱེར་དང་བོར་བརླག་སོང་བ་སྔོན་འགོག་བྱེད་བདེ་བའི་ཆེད་ཡིན།",
    "འོན་ཀྱང་ཨང་རྟགས་དེ་ཚན་པ་དང་རང་སོ་སོའི་དཔེ་མཛོད་ཁང་གི་དཔེ་ཐོའི་ནང་འགོད་རྒྱུ་ལས་སྤྱིའི་དཀར་ཆག་ཆེན་མོའི་ནང་ཨང་རྟགས་མ་བཀོད་པར་བཞག་ན།",
    "སྐབས་རེ་རྩོམ་པ་པོའི་མཚན་སྔོན་དུ་འགོད་དགོས་པ་ཡང་ཡོད།",
    "དེ་ཡང་རང་གི་ལྟ་ཚུལ་དེ་ལ་ཚད་ལྡན་གྱི་མཁས་པ་སུས་ཇི་ལྟར་གསུངས་ཡོད་པ་དང་།",
    "གསུང་ཚུལ་དེ་གསུང་རྩོམ་གང་གི་ནང་དུ་ཡོད་པ་ཤེས་རྟོགས་བྱེད་པའི་བསམ་བློའི་ངོས་འཛིན་གྱི་གོ་རིམ་དང་བསྟུན་པའི་དགོས་པ་ཡོད་ཅིང་།",
    "ཡང་ན་རྒྱ་ཆེའི་གཟིགས་པ་པོ་ཚོའི་ཞལ་རྒྱུན་དུ་གོམས་བྱང་སོང་བ་ཞིག་དགོས་སམ་མི་དགོས་ཞེས་པ་དེ་ཡིན།",
    "གཉིས་ནས་བསྡུས་མིང་འདོགས་ཚུལ་ཐད་རྒྱ་ཆེའི་གཟིགས་པ་པོ་ཚོས་དགོངས་པ་གཅིག་མཐུན་རེ་ཞིག་ཡོང་དཀའ་བ་དེ་ཡིན།",
    "མཁས་པ་འགའ་ཞིག་གིས་དེབ་ཐེར་དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་ཞེས་གསུང་རྒྱུན་ཡོད་ལ།",
    "འགའ་ཞིག་གིས་དེབ་ཐེར་རྫོགས་ལྡན་གཞོན་ནུའི་དགའ་སྟོན་ཞེས་གསུང་རྒྱུན་ཡོད་པ་དང་།",
    "དེར་བརྟེན་དཀར་ཆག་པར་དུ་སྐྲུན་སྐབས་རེའུ་མིག་ཏུ་བསྡུས་མིང་འགོད་སའི་རེའུ་མིག་སྟོང་བ་སྤྱི་སྐར་བདུན་ཙམ་ཡོད་པ་ཞིག་བཞག་སྟེ་རེ་ཞིག་དངོས་སུ་མ་བཀོད་ན་ལེགས་སམ་སྙམ།",
    "བཀའ་རྒྱ་མའི་གསུང་འགའ་ཞིག་གི་ནང་ཟ་ཧོར་གི་རིགས་ལས་མང་དུ་ཐོས་པའི་བནྡེ་ཟིལ་གནོན་བཞད་པ་རྩལ་ཞེས་འགོད་གནང་མཛད་པ་དང་།",
    "དེ་ལྟར་བཀོད་ན་དེའི་ས་ཁོངས་རེའུ་མིག་གི་བར་སྟོང་ཆེ་ཙམ་འཇོག་དགོས་པས་གཞོགས་ངོས་གཉིས་སུ་བྲིས་ན་ལེགས།",
    "དེའི་དཔེ་མཚོན་གཤམ་གྱི་རེའུ་མིག་ལ་གཟིགས།",
    "ཤོག་དྲིལ་ཆེན་པོ་ཞིག་གི་ཚད་ཡིན།",
    "ཚིག་ལྷུག་མའི་ཚེག་བར་ཏེ་ཡིག་འབྲུ་སུམ་ཅུ་སོ་གཉིས་རེ་ལ་ཤོ་ལོ་ཀ་གཅིག་ཤོ་ལོ་ཀ་སུམ་བརྒྱ་ཐམ་པ་སྟེ་ཚེག་བར་ཡིག་འབྲུ་སུམ་སྟོང་བརྒྱ་དང་ཉི་ཤུ་ཐམ་པ་ལ་བམ་པོ་གཅིག་ཏུ་བརྩི་བ་མང་ཞིང་།",
    "སྐབས་རེར་ཤོ་ལོ་ཀ་སུམ་བརྒྱ་ལྔ་བཅུ་ཡིག་འབྲུ་སུམ་སྟོང་དྲུག་བརྒྱ་བཞི་བཅུ་ཐམ་པ་དང་།",
    "བཞི་བརྒྱ་ཡིག་འབྲུ་བཞི་སྟོང་བརྒྱ་དང་དྲུག་ཅུ་ཐམ་པ་ལ་བམ་པོ་རེར་བརྩིས་པ་མི་ཉུང་བ་ཡོད་ལ།",
    "རྒྱབ་མདུན་ངོས་རེར་ཡིག་ཕྲེང་ཇི་ཡོད་ཀྱི་ཁ་གྲངས་གསལ་བོར་བཀོད་ན་བམ་གྲངས་དང་ཤོ་ལོ་ཀའི་གྲངས་བཀོད་པ་ལྟ་བུའི་ནུས་པ་ཐོན་ཐུབ་ཀྱི་རེད།",
    "བསྒྱུར་ཡིག་གི་མ་དཔེ་གང་ནས་བྱུང་བ་བཀོད་པ་ཡང་མི་ཉུང་བ་ཡོད་ཅིང་།",
    "ལས་བཟོ་ཁག་གི་མི་གྲངས།",
    "ཉིན་རེའི་ལས་ཀའི་མགྱོགས་ཚད།",
    "༧ལས་རིགས་ཁག་གི་ལས་རིམ།",
    "ཞུས་དག་གི་རིམ་པ།",
    "༡འཛུགས་སྒང་གྲོལ་གསུམ་གྱི་སྟོན་མོ་གནང་ཆ།",
    "༤ཁྱོན་ཡོངས་ཀྱི་འགྲོ་གྲོན།",
    "༧དད་སྦྱིན་ཁག་གི་ཞལ་འདེབས་འབུལ་ཐོ།",
    "འོན་ཀྱང་པར་མ་འགའ་ཞིག་གི་མ་དཔེ་ལ་སྐྱོན་ཡོད་པའི་སྟབས་ཀྱིས་པར་མའི་ནང་དུ་ཡང་མ་དག་རྒྱུན་འབྱམས་བྱུང་བ་མི་ཉུང་བ་ཞིག་ཡོད་པས་བྲིས་མ་དང་།",
    "པར་མའི་རིགས་འགའ་ཞིག་དབུས་གཙང་ཁམས་གསུམ་གྱི་ས་གནས་མང་པོར་ཡོད་པས་དཀར་ཆག་ཐོག་པར་མ་དེ་ས་གནས་གང་གི་པར་ཡིན་མིན་གསལ་བོར་བཀོད་ན་པར་མ་ཕན་ཚུན་ཞིབ་བསྡུར་བྱས་ཏེ་ལྟ་ཀློག་བྱེད་བདེ་བའི་ཁྱད་པར་ཡོད།",
    "མགོ་མཇུག་གི་ཤོག་ལྷེ་ཕུད་པའི་སྤྱིའི་རིང་ཚད་སྤྱི་སྐར།",
    "༥༢ ༥༤མཐའ་སྣེའི་ཐག་གི་མགོ་མཇུག་བར་གྱི་རིང་ཚད་སྤྱི་སྐར།",
    "༧ ༥༣སྣེ་ཐིག་གི་ཞེང་ཚད་སྤྱི་སྐར།",
    "༥༣སྣེ་ཐིག་གི་རིང་ཚད་སྤྱི་སྐར།",
    "༤༧༥༣སྣེ་ཐིག་གི་རིང་ཚད་སྤྱི་སྐར།",
    "༧སྣེ་ཐིག་གི་ཞེང་ཚད་སྤྱི་སྐར།",
    "སྣེ་ཐིག་གི་རིང་ཚད་སྤྱི་སྐར།",
    "༢༧ ༢༥༦་༥སྣེ་ཐིག་གི་ཞེང་ཚད་སྤྱི་སྐར།",
    "དཔེར་ན་འཇམ་དབྱངས་བཞད་པ་སྐུ་ཕྲེང་དང་པོའི་རྒྱུན་གཟིགས་ཕྱག་དཔེ་བྲིས་མ་ལྟ་བུ་ཡིན།",
    "ཤོག་ངོས་རེར་ཡིག་ཕྲེང་དྲུག་ནས་བདུན་བར་གཏན་ཁེལ་བྱས་ཡོད།",
    "ཡིག་ཕྲེང་རེར་ཡིག་འབྲུ་ཇི་ཙམ་ཡོད་པ་ནི།",
    "མཐའ་སྣེ་མི་འཆོལ་བའི་ཆེད་སྣེ་ཐིག་གི་རྒྱ།",
    "དེ་ཡང་ཤོག་གྲངས་མང་ཉུང་གི་ཐོག་ནས་བརྩི་བ་ལས།",
    "ལྡེབ་རིང་ཐུང་གི་སྒོ་ནས་བརྩི་བ་མིན།",
    "སྔ་མའི་སྟེང་ནས་མར་ཕྲི་བ་སོགས་གང་གི་སྐབས་སུ་ཡང་གྲངས་ཀ་མེད་མི་རུང་ལ།",
    "༧ལོ་ཙཱ་བ་དང་མཁས་པ་གཅིག་གིས་དཔེ་སྣ་ཆ་ཚང་གཅིག་བསྒྱུར་བ་དང་བརྩམས་པ།",
    "༥༣ལོ་ཙཱ་བ་དང་མཁས་པ་འགའ་ཞིག་གིས་དཔེ་སྣ་དེའི་སྐོར་མགོ་མཇུག་ཆ་ཚང་བར་མཛད་པ།",
    "དེ་ཡང་སྐུ་སྒེར་གྱི་སྐུ་ཆས་དང་ཕྱག་དཔེའི་རིགས་ལ་དམིགས་བསལ་གྱིས་བསྐྱོན་པ་གནང་བྱེད་མགུལ་ཐམ་ཞེས་པའི་རྟགས་ཐམ་ཆུང་ངུ་ཞིག་ཡོད་པ་དེ་ཕྱག་དཔེའི་དབུ་ཤོག་གི་ཁ་བྱང་གི་སྟེང་དང་།",
    "ཞབས་ཤོག་གི་ཟུར་དུ་བསྐྱོན་པ་གནང་ཡོད།",
    "ཞབས་ཤོག་ཤོག་གྲངས་རེ་རེ་བཞིན་གྱི་གྲངས་ཀའི་ཐོག་དང་།",
    "ཟུར་མཆན་གྱི་མགོ་མཇུག་ཡི་གེ་མེད་པའི་ཤོག་སྟོང་གི་ཟུར་བཅས་ལ་རྟགས་ཐམ་ཡོད།",
    "དེ་ནས་རང་རང་གི་མིང་གཞི་དེ་ལ་དབྱངས་ཡོད་པ་རྣམས་དང་།",
    "དཀར་ཆག་རྒྱས་འབྲིང་བསྡུས་གསུམ་འགོད་ཚུལ་དང་དེའི་ལག་ལེན་གྱི་རེའུ་མིགདཀར་ཆག་རྒྱས་འབྲིང་བསྡུས་གསུམ་ཟེར་བ་ནི།",
    "ཞེང་ཚད་ཡིག་ཕྲེང་གཉིས་ཤོང་བའི་ཚད་དུ་བྱས་པའི་དུམ་བུ་སོ་སོར་ནང་དོན་གང་དང་གང་འགོད་དགོས་པའི་རེའུ་མིག་གཤམ་གསལ་ལྟར་ཁ་གསལ་འགོད་དགོས་ཤིང་།",
    "ནང་དོན་དེ་དག་ཡིག་ཕྲེང་སྟར་པ་གཅིག་གི་ངོས་སུ་ཤོང་བ་ཞིག་བྲིས་ཚེ་དེབ་ཧ་ཅང་ཆེན་པོ་ཞིག་མ་བྱུང་ན་ཤོང་མི་ཐུབ་པས་ཤོག་ངོས་ཕན་ཚུན་གཉིས་སུ་བགོས་པའམ།",
    "གཞན་རྣམས་མ་བྲིས་ཀྱང་ཆོག་པ་གཤམ་གྱི་རེའུ་མིག་ལ་གཟིགས།"
  ]
}