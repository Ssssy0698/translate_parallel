    "དོན་ཆེད་བཀའ་སྒོམ་མི་དགོས་པར་རང་བྱུང་རང་ཤར་རང་གྲོལ་བས་སྒོམ་རྒྱུན་མི་འཆད་པ་ལ་བྱའོ།",
    "སྤྱོད་པ་ཅིར་སྣང་རང་གྲོལ་དེ་རྣམས་ལམ་དུ་ཁྱེར་ཤེས་པ་ལ་བྱའོ།",
    "སྟོང་པ་བདེ་གསལ་འཛིན་མེད་དུ་འདུག་པ་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ཡིན།",
    "སེམས་གསལ་བ་དང་སྟོང་པ་དང་རང་བྱུང་རང་ཤར་གྱི་ཉམས་དང་།",
    "དགྲར་འཛིན་སེམས་སྟོང་པ་གཉེན་དུ་འཛིན་པ་ཡང་རང་སེམས་སྟོང་པ་ལས་དགྲ་གཉེན་འཛིན་པ་རང་ཤར་རང་གྲོལ་བས།",
    "འགྲོ་འཆག་ཉལ་འདུག་ཐམས་ཅད་དུ་ཐུགས་རྗེ་ཆེན་པོའི་སྐུ་གསུང་ཐུགས་དང་།",
    "སེམས་ཉིད་རང་གསལ་རང་བྱུང་རང་ཤར་ལ་བཞག་པས།",
    "དུག་ལྔ་དང་རྣམ་རྟོག་ཕྲ་རགས་གང་སྐྱེས་ཀྱང་རང་ཤར་རང་གྲོལ་དུ་བཏང་ངོ།",
    "དང་པོ་གང་ནས་སྐྱེས་ད་ལྟ་གང་ན་འདུག།",
    "སྐྱེ་ཙ་ན་འཇུར་མི་གནས་འདྲེན་པ་དང་།",
    "ངོ་བོ་སྟོང་པ་ཅིར་ཡང་མ་གྲུབ་པ་ཅིག་འདུག།",
    "སྐྱེ་མེད་སྟོང་པ་རང་བྱུང་རང་གནས་རང་ལ་འདུག་པར་མཐོང་བ་འདུ་འབྲལ་མེད་པར་ཡེ་ནས་གནས་པས་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ཞེས་བྱ་སྟོང་ལ་ང་བདག་མེད་པས།",
    "སེམས་སྟོང་པ་རང་བྱུང་རང་གསལ་དུ་ངོ་སྤྲད་པས་ཕྱག་རྒྱ་ཆེན་པོའི་ལྟ་བ་རྫོགས།",
    "ཞེ་སྡང་རང་ཤར་ཏེ་ཞེ་སྡང་དང་པོ་བྱུང་སས་སྟོང་པས་འདི་ནས་བྱུང་བྱ་བའི་ས་མེད།",
    "རང་བྱུང་རང་ཤར་རང་གྲོལ་དུ་བཞག་གོ།",
    "སེམས་ཉིད་སྟོང་པ་ཉིད་དེའི་ངང་ལས་སྟོང་པ་མ་འགགས་པ་ཅིག་འདུག་པས།",
    "མཉམ་པ་རིས་མེད་དུ་འདུག་པ་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས།",
    "གསལ་ལ་མ་འདྲེས་པར་འདུག་པ་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས།",
    "གཞན་ནས་བཙལ་དུ་མེད་ཅིང་རང་ལ་ཡེ་ནས་ཡོད་པ་བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་ཏེ།",
    "རིག་པ་གསལ་བཏབ་སྟེ་རིག་པ་རང་བྱུང་རང་གསལ་རང་ལ་ཤར་བ་དེ་ཤེས་པས།",
    "དེ་ཡང་རང་༡༥༦བ་ཉིད་འཆི་བ་འདུག་སྙམ་པ་དང་།",
    "གནམ་སའི་ཀ་གདུང་ཆད་པ་ཞེས་བྱ་སྟེ་ལག་པ་ནམ་མཁའ་ལ་ཕྱར་བས་མཁྲིག་མ་ནས་བར་ཆད་འདུག་ན་འཆི།",
    "དེ་ལ་ཟིན་ནས་མི་འཕྲོ་བར་འདུག་ན་སེམས་ལྷོད་ཀྱིས་གློད་ལ་བཞག།",
    "གསུང་གྲག་སྟོང་བྲག་ཆ་ལྟ་བུ་རང་བྱུང་རང་གྲོལ་དུ་བཞག།",
    "ཨོྃ་མ་ཎི་པདྨེ་ཧཱུཾ་ཞེས་པ་རང་བྱུང་རང་གྲག་རང་གྲོལ་དུ་དངས་ཏེ་གྲག་སྟོང་རྒྱུན་ཆད་མེད་པས།",
    "ཐུགས་ཀྱི་དམ་ཚིག་ཏུ་རྣམ་རྟོག་དུག་ལྔ་རང་དགར་མི་བཏང་རང་ཤར་རང་གྲོལ་དུ་བཞག་གོ།",
    "ཡི་དམ་ལྷས་ལྷ་དང་རང་སེམས་གཉིས་སུ་མེད་པར་ངོ་སྤྲད་དོ།",
    "ཉམས་རིག་པ་རང་བྱུང་རང་ཤར་དུ་ལྷག་ལྷག་སྐྱེ།",
    "འཁོར་ལོ་རྩིབས་བརྒྱད་པ་ས་པདྨ་འདབ་བརྒྱད་དུ་འདུག་པ།",
    "གཞན་ལ་ཕན་གདགས་ཤིང་རང་སྨིན་པར་བྱེད་པའི་ཞལ་གདམས་བརྒྱད།",
    "ཐུགས་རྗེ་ཆེན་པོའི་ལྟ་བ་ནི་ཕྱོགས་མེད་མཐའ་བྲལ་རང་བྱུང་རང་གསལ་ཀུན་ལ་ཁྱབ་པ་ཡིན་ནོ།",
    "ཡེ་ཤེས་ལྔ་སྒྲུབ་ཏུ་མེད་རང་བྱུང་རང་ཤར་དུ་གྲོལ་ལོ་ཞེས་ངོ་སྤྲོད་དོ།",
    "ཆོ་གའི་རིམ་པ་བརྒྱད་པོ་དེ་གཞན་ལ་ཕན་གདགས་ཤིང་རང་སྨིན་པར་བྱེད་པའི་ཞལ་གདམས་སོ།",
    "རང་བྱུང་རང་ཤར་ལྟ་བའི་མཆོག།",
    "རྗེས་ཕྱིར་མི་འབྲང་རང་སར་གྲོལ།",
    "ཐུགས་འཚེར་མི་འཚལ་དགོངས་པ་གློད་ལ་བློ་བདེ་བར་འདུག་ཤིག་ཅེས་ཡུམ་ལ་གདམས་པ་ཕོག།",
    "ཞེ་སྡང་རང་སར་གྲོལ་བས་སྤང་མི་དགོས།",
    "འཇིག་རྟེན་གྱི་བྱ་བ་ཐམས་ཅད་བྱས་པ་དོན་མེད་པས་སྡུག་བསྔལ་གྱི་ལོ་མ་ངན་འགྲོར་སྐྱེ་བའི་ས་བོན་དུ་གདའ་བས།",
    "ཐག་རིངས་སུ་འགྲོ་ན་ཁྱེར་རྒྱུ་ཅི་འདུག་བལྟ།",
    "མང་པོའི་ནང་ན་འདུག་ན་ངག་ལ་བལྟའོ།",
    "གཉིས་པ་གཅིག་པུར་འདུག་ན་སེམས་ལ་ལྟ་བ་ནི།",
    "མ་༢༧བ་བསླད་རང་བྱུང་རང་ཤར་རང་གསལ་གྱི་ངང་ལ་བཞག་གོ།",
    "གསུམ་པ་མང་པོའི་ནང་ན་འདུག་ན་ངག་ལ་ལྟ་བ་ལ་གསུམ་ལས།",
    "ཆུ་ཟླ་གཟུགས་བརྙན་དུ་སྣང་ཡང་རང་བཞིན་མེད་པ་ལྟར།",
    "དེ་ལྟར་ལྷ་ལ་སེམས་ཟིན་པ་དང་རང་ཐུགས་རྗེ་ཆེན་པོར་བསྒོམས་ལ།",
    "ད་ལྟར་བ་ལ་ངོས་བཟུང་མེད་པའི་ཕྱིར་བདག་མི་འདུག་གོ།",
    "དེ་ལྟར་ལུས་ལ་ང་བདག་མི་འདུག་པར་མཐོང་ན།",
    "མིང་ལ་ངའམ་བདག་མི་འདུག་པར་ཤེས་ན་སྙན་མི་སྙན་དང་བསྟོད་སྨད་ལ་སོགས་པའི་ཚིག་ལ་འཛིན་པ་ཆུང་དུ་འགྲོ།",
    "སེམས་ལ་ང་བདག་མི་འདུག་པར་རིག་ན་ཕ་མ་དང་བུ་ཚ་དང་།",
    "རིག་པའི་དུས་ན་བལྟས་པས་རིག་མཁན་དེ་ཉིད་སྟོང་པར་འདུག།",
    "འགྱུ་བའི་དུས་ན་འགྱུ་མཁན་དེ་ཉིད་སྟོང་པར་འདུག།",
    "གསལ་བའི་དུས་ན་གསལ་མཁན་དེ་ཉིད་སྟོང་པར་འདུག།",
    "ཤེས་པ་སྐད་ཅིག་མ་སྔ་མ་འདས་ཏེ་སྟོང་པར་འདུག།",
    "ཕྱི་མ་མ་འོངས་པས་སྟོང་པར་འདུག།",
    "ད་ལྟར་བ་ལ་ངོས་བཟུང་མེད་དེ་སྟོང་པར་འདུག།",
    "རང་ཐང་ལྷུག་པར་འདུག་པའོ།",
    "དུས་དང་གནས་སྐབས་ཐམས་ཅད་དུ་མི་འབྲལ་བར་འདུག་པའོ།",
    "དཔེར་ན་སྔར་འདྲིས་ཀྱི་མི་དང་ཕྱིས་ཕྲད་ན་དེར་འདུག་སྙམ་དུ་ཝལ་གྱིས་ཤེས་པ་ལྟར།",
    "ད་ལྟར་ལྷའི་རྣམ་པར་ཤར་བའི་དུས་ན་ཡང་ངོས་བཟུང་མེད་དེ་སྟོང་པར་འདུག།",
    "ལྷ་དང་སེམས་ཐ་མི་དད་པ་བསྒོམས་ནས་ཐ་མ་ལྷ་མི་དམིགས་པར་བཤིག་པའི་དུས་ན་ཡང་ལྷ་ལ་འགྲོ་ས་མི་འདུག་པས།",
    "རིག་པ་སྟོང་པར་འདུག་པ་དེ་ལ་བསྐྱེད་རྫོགས་ཟུང་དུ་འཇུག་པ་ཞེས་བྱའོ།",
    "སེམས་སྟོང་པ་རང་བྱུང་རང་གསལ་དུ་འདུག་པ་དེ་ཤེས་རབ་བོ།",
    "རང་སེམས་ཡེ་ནས་མ་བཅོས་པ་རང་བྱུང་རང་གསལ་ལ་ལྷན་ནེ་ལྷག་གེ་གཞག།",
    "སྤྱོད་པ་ངེས་མེད་ཀྱི་སྐབས་སུ་འགྲོ་བ་ལ་ཉེ་རིང་འདུག་གམ་མི་འདུག་བརྟག།",
    "འབྲས་བུ་དམིགས་མེད་ཀྱི་སྐབས་སུ་རང་སེམས་ལ་འདོད་པ་འདུག་གམ་མི་འདུག་བརྟག་གོ།",
    "སྤྱོད་པ་རང་བྱུང་རང་གྲོལ་བྱ་རྩོལ་མེད་པར་ལ་བཟླ།",
    "འོད་གསལ་ཆེན་པོའི་ངང་ལ་ཇི་ལྟར་འདུག་པ་དེ་ལྟར་བཞག་གོ།",
    "ཡུལ་དང་ལུང་པ་རང་རང་དུ་ཉི་ཟླ་སྣང་བ་ལྟར་བསྐྱེད་དོ།",
    "བློ་འདས་བྱར་མེད་ཅིག་འདུག་གོ།",
    "སྣ་ཚོགས་རྟགས་ཀྱང་རང་སྣང་ཡིན།",
    "འདུག་པ་ཐམས་ཅད་རང་འདུག་ཡིན།",
    "དེ་ཤེས་རབ་ཀྱི་རང་བརྡོལ་དུ་བྱོན་པ་ཝལ་ལོ་རྗེས་མེད་དུ་འདུག་པ།",
    "རིག་པ་རྐྱང་འདེད་དུ་འདུག་པ།",
    "དངོས་མེད་ལ་གཉེན་པོས་བཅོས་སུ་འདུག་གོ།",
