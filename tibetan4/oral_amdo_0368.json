    "དེ་ནས་གོང་གི་སྔགས་ཀྱིས་མེ་ཏོག་ལ་སོགས་པའི་ཉེར་སྤྱོད་དབུལ་བར་བྱ་བ་ཉིད་དང་།",
    "དེར་མ་ཟད་རྒྱུད་རྒྱས་པ་འབུམ་ལྔ་སོགས་གོང་མའི་རྒྱུད་ཀྱི་མཆོད་ཆོག་གི་རིམ་པས།",
    "སོར་མོ་ཉི་ཤུའམ་དེ་ཡི་ཕྱེད།",
    "ཁྲུ་གང་པ་དང་ནི་ཁྲུ་ཕྱེད་པའི་ཚད་ཉིད་ནི་རིམ་པས་ཞི་བའི་ཐབ་ཀྱི་སྟེང་གི་རྒྱ་ཚད་དང་འོག་ཏུ་སྟེ་ཟབས་སམ་དཔངས་ཀྱི་ཚད་ཡིན་ལ།",
    "དེ་བཞིན་དུ་ཁྲུ་དོ་དང་ནི་ཁྲུ་གང་ཉིད་ནི་རྒྱས་པའི་ཐབ་ཀྱི་སྟེང་གི་རྒྱ་དང་འོག་ཏུ་སྟེ་དཔངས་སུ་བརྗོད་ཅིང་།",
    "སོར་མོ་ཉི་ཤུའམ་དེ་ཡི་ཕྱེད་སོར་བཅུ་ནི་བསད་པའི་ཐབ་ཀྱི་སྟེང་གི་རྒྱ་དང་འོག་ཏུ་སྟེ་དཔངས་ཀྱི་ཚད་ཡིན་ཏེ།",
    "ལྷ་མོ་ཁྱོད་ནི་དཔང་དུ་གྱུར།",
    "སྦྱིན་སྲེག་དང་དཀྱིལ་འཁོར་འབྲེལ་བས་དེའི་ས་ཆོག་གི་སྐབས་སུ་ས་ལྷ་དཔང་དུ་གསོལ་བ་འདིར་ཁ་བསྐང་ནས་ཞར་ལ་གསུངས་ཏེ།",
    "ལྷ་མོ་ཁྱོད་ནི་དཔང་དུ་གྱུར་པ་སྟེ།",
    "དེས་ན་སློབ་དཔོན་ཆེ་གེ་མོ་བདག་ནི་གནས་འདིར་དཀྱིལ་འཁོར་འབྲི་བས་གནང་བར་མཛོད།",
    "སྭ་ཨརྠཉ་ཙ་ནི་བདག་གི་དོན་དང་།",
    "འདི་དག་གི་མཐར་ཨཱ་ཧཱུྃ་སྭཱ་ཧཱ།",
    "ཞེས་པ་གོང་གི་རིགས་པས་སྦྱར་བར་བྱ་སྟེ་བྱིན་གྱིས་རློབ་པའི་སྔགས་སུ་བྱའོ།",
    "དེའི་དབུས་ཀྱི་གཏུམ་མོ་ནི་མེ།",
    "གཉིས་སྣང་གི་ཀུན་རྟོག་ཞི་བ་ནི་ཡམ་ཤིང་བསྲེག་པ།",
    "དེ་ལྟ་བུའི་རྒྱུད་ལས་བརྟག་པ་གཉིས་པ་སྟེ་ཕྱི་མ་ལས་རབ་གནས་དང་སྦྱིན་སྲེག་སྟོན་བྱེད་ཀྱི་ལེའུ་སྟེ་གཞུང་གི་དུམ་ཚན་དང་པོའོ།",
    "ཞེས་གཞུང་གི་སྐབས་དོན་ཞིག་གསུངས་ཟིན་པའི་ཚིག་གོ།",
    "འདིའི་ལེའུ་དང་པོར་ཐུན་མོང་གི་དངོས་གྲུབ་སྒྲུབ་པའི་རབ་གནས་དང་སྦྱིན་སྲེག་གསུངས་ནས།",
    "རང་གི་ཁྱིམ་དུ་མཚན་དུས་སུ།",
    "མ་རྙེད་ན་རང་གི་ཁྱིམ་དུ་མཚན་མོ་གཞན་གྱིས་གཡེང་བ་ཞི་བའི་དུས་སུ་བསྒོམས་ཀྱང་རུང་སྟེ།",
    "འཐོར་འཐུང་གིས་འཐོར་བའམ་ཁ་བཤལ་བ་དང་།",
    "བསམ་གཏན་ཉོན་མོངས་འཇིག་བྱེད་པ།",
    "ལྷན་སྐྱེས་ཀྱི་བདེ་བ་ལ་རྩེ་གཅིག་པའི་བསམ་གཏན་སྡུག་བསྔལ་དང་ཉོན་མོངས་འཇིག་ཅིང་འཇོམས་པར་བྱེད་པ་ཐོབ་པའི་ཐབས་སྤྱོད་པ།",
    "བསམ་གཏན་ཉོན་མོངས་འཇིག་བྱེད་ཀྱི་དོན་ལ།",
    "འོག་ཏུ་ལྷན་སྐྱེས་ཀྱི་བདེ་བས་ཉོན་མོངས་འཇིག་ཚུལ་དཔེ་དང་སྦྱར་ནས་གསུངས་པ་འདིར་ཟུར་གྱིས་བསྟན་པའི་ཕྱིར་དང་།",
    "ཉོན་མོངས་ཐམས་ཅད་འཇོམས་པ་ཉིད།",
    "གོང་གི་བསམ་གཏན་དེ་ཐབས་གང་གིས་མངོན་དུ་བྱེད་ཅེ་ན།",
    "སྒྲུབ་པ་པོ་ཉིད་ཉོན་མི་མོངས།",
    "གཞན་གྱིས་གནོད་ཅིང་འཚེ་བ་དང་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་སྟེ་དུག་གསུམ་ཆེས་ཆེར་གྱུར་པས་ཀྱང་སྒྲུབ་པ་པོ་ཉིད་ཉོན་མི་མོངས་པ་སྟེ་དེས་མི་བརྫི་བ་དང་།",
    "སྐབས་འདིའི་གཞུང་གི་འགྱུར་ཅུང་ཟད་མ་བདེ་བ་སྟེ།",
    "གང་ཞིག་ལྷ་མོ་ལ་བརྟེན་པ།",
    "ལ་ལར་དུག་གསུམ་ཆེན་པོས་ཉོན་མི་མོངས་པ་མན་གྱིས་དྲོད་ཆུང་ངུ།",
    "མཆོག་གིས་ངེས་པར་འགྲུབ་ཚུལ་གཉིས་ཀྱི།",
    "གཞན་ཡང་བུད་མེད་སོགས་ཀྱི་སྐྱེ་བ་དམན་པ་གང་དག་དང་།",
    "གཉིས་པ་མཆོག་གིས་ངེས་པར་འགྲུབ་ཚུལ་",
    "དེ་ནི་རེ་ཤིག་ངེས་འགྲུབ་འགྱུར།",
    "ཁེངས་ཤིང་ང་རྒྱལ་བ་དང་གདུག་པ་ཆེ་ཞིང་ཁོང་ཁྲོ་བ་གཉིས་ལས་རྣམ་པར་གྲོལ་བ་སྟེ་དེ་དག་དང་བྲལ་བ་དེ་ནི་རེ་ཤིག་ཙམ་གྱིས་དྲོད་རྟགས་ངེས་པར་འགྲུབ་པར་འགྱུར།",
    "ཕྱག་རྒྱ་ཆེ་གེ་མོ་ཁྱེར་ལ།",
    "གཟུགས་དང་ལང་ཚོས་རྣམ་པར་བརྒྱན།",
    "ཟླ་བ་གཅིག་གིས་སྐལ་ལྡན་པར།",
    "མཆོག་ཐོབ་པ་ཡི་བུད་མེད་གང་།",
    "གཟུགས་བྱད་མཛེས་པ་དང་ལང་ཚོས་རྣམ་པར་བརྒྱན་པ།",
    "ཟླ་བ་གཅིག་གིས་ཕྱག་རྒྱ་དེ་དངོས་གྲུབ་ཀྱི་སྐལ་པ་བཟང་པོ་དང་ལྡན་པར་འགྱུར་བ་འདི་ལ་ཐེ་ཚོམ་མེད་ཅིང་།",
    "དེ་ལ་མཆོག་གི་དངོས་གྲུབ་ཕྱག་རྒྱ་ཆེན་པོ་ཐོབ་པར་བྱེད་ནུས་པ་ཡི་བུད་མེད་གང་དེ་ནི་གཉིས་འཛིན་གྱི་རྟོག་པ་ཐམས་ཅད་ཡང་དག་པར་སྤངས་པའི་ཡོན་ཏན་དང་ལྡན་པ་སྟེ།",
    "ཡང་ན་བདག་གི་ནུས་པ་ཡིས།",
    "ཡང་ན་རྣལ་འབྱོར་པ་བདག་གི་ཏིང་ངེ་འཛིན་གྱི་ནུས་པ་ཡིས་འགྲོ་བ་ལྷ་དང་ལྷ་མིན་དང་མི་རྣམས་དང་གནོད་སྦྱིན་དང་མིའམ་ཅི་མོ་རྣམས་ལས་ཀྱང་མཚན་ལྡན་གྱི་ཕྱག་རྒྱ་དགུག་པའི་ཆོ་གས་བཀུག་ལ་རབ་ཏུ་བརྟག་པ་སྟེ་རྒྱུད་སྨིན་པར་བྱས་ལ།",
    "བདག་གི་དལ་བ་མངོན་དུའི་ཕྱིར།",
    "རང་གི་སེམས་ནི་སོ་སོར་བརྟག།",
    "ཡིད་ནི་རྣལ་འབྱོར་ལ་རྩེ་གཅིག་ཏུ་བརྟན་ནམ་འོན་ཏེ་གཡོའམ་ཅི་ལྟ་བུ་སྙམ་དུ་རང་གི་སེམས་ནི་ཤེས་རབ་ཀྱིས་སོ་སོར་བརྟག་ཅིང་དཔྱད་པའི་དོན་དུ་གསུངས།",
    "ཕྱག་རྒྱ་ཕྱག་རྒྱ་གཉིས་དག་གིས།",
    "སྤྱོད་པའི་གྲོགས་ཕྱག་རྒྱ་མོ་བསྟེན་པ་ཉིད་བྱའོ།",
    "རང་བདག་མེད་མར་གསལ་བ་ཕྱག་རྒྱ་མོ་དང་།",
