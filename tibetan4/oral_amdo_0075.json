    "གང་གི་ཚེ་ཁམས་གསུམ་ན་སྤྲོད་པའི་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་པས་དགྲ་བཅོམ་པར་འགྱུར་ན།",
    "རེ་ལྟར་ཐོགས་ན་སྲིད་པ་ལན་བདུན་པ་གང་ཞེ་ན།",
    "ལྷ་དང་མི་རྣམས་ཀྱི་ནང་དུ་རིགས་ནས་རིགས་སུ་སོང་ནས་གང་སྡུག་བསྔལ་གྱི་མཐའ་མ་ཐོབ་པའོ།",
    "ལ་ལ་ནི་སྲིད་པའི་རྩེ་མོའི་བར་དུ་སོང་ནས་ལམ་མངོན་དུ་བྱས་ཏེ་སྡུག་བསྔལ་གྱི་མཐའ་མ་ཐོབ་པའོ།",
    "མོས་པས་སྤྱོད་པ་ཅན་གང་ཞེ་ན།",
    "མོས་པས་སྤྱོད་པའི་ས་ལ་བཟོད་པ་ཆུང་ངུ་དང་།",
    "ཁམས་གསུམ་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་རྣམས་རྣམ་པས་ཅིག་ཅར་སྤང་སྟེ།",
    "ཉོན་མོངས་པ་མེད་པ་དང་།",
    "ལས་བདག་གིར་བྱ་བ་མཁྱེན་པའི་སྟོབས་གང་ཞེ་ན།",
    "ལས་བདག་གིར་བྱ་བ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཡང་དག་པར་འབྱོར་པའི་ཞེས་བྱ་བ་སྔ་མ་བཞིན་ནོ།",
    "བསམ་གཏན་ལ་བརྟེན་ནས་རང་གི་དོན་ལས་བརྩམས་ཏེ།",
    "རང་གི་དོན་ལས་བརྩམས་ཏེ།",
    "སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་ཕྲིན་ལས་ཐུན་མོང་མ་ཡིན་པ་ཡོངས་སུ་དག་པ་ཡང་དག་པར་འབྱོར་པ་དང་།",
    "ཐུན་མོང་མ་ཡིན་པའི་ཕྲིན་ལས་མཛད་པ་ཡང་དག་པར་འབྱོར་པ་དང་།",
    "ཡེ་ཤེས་ལ་གནས་པ་ཐུན་མོང་མ་ཡིན་པ་ཡང་དག་པར་འབྱོར་པའི་ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་གང་ཡིན་པ་ཞེས་བྱ་བ་སྔ་མ་བཞིན་ནོ།",
    "རང་གི་བྱ་བ་ལ་ཉེ་བར་གནས་པ་དང་།",
    "རང་གི་བྱ་བ་ལ་ཉེ་བར་གནས་པ་གང་ཡིན་པ་དེ་དག་ནི་འཇིག་རྟེན་ལས་འདས་པའི་རྗེས་ལས་ཐོབ་པ་ཀུན་རྫོབ་ཤེས་པའི་རང་བཞིན་དུ་བལྟའོ།",
    "མོས་པའི་ཕྱིར་འཕགས་པའི་གནས་པ་མཆོག་ཏུ་རབ་ཏུ་ཞི་བའི་གནས་པས་གནས་སོ།",
    "ཉོན་མོངས་པ་མེད་པས་ལས་ཅི་མཛད་ཅེ་ན།",
    "ངག་གི་ལས་ཀྱིས་འདུན་པར་མཛད་དོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པས་ཚོགས་ཡོངས་སུ་སྡད་དོ།",
    "ཉོན་མོངས་པ་མེད་པས་ཉོན་མོངས་པ་ལྟ་བུའི་སྤྱོད་པ་མི་སྟོན་ཏོ།",
    "ཉིན་མཚན་ལན་དྲུག་ཏུ་འཇིག་རྟེན་ལ་རྣམ་པར་གཟིགས་སོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ས་བཅུ་རྣམས་སུ་བསྐོམ་པའི་ལམ་ལ་ཤེས་བྱའི་སྒྲིབ་པའི་གཉེན་པོའི་ལམ་སྒོམ་གྱི་ཉོན་མོངས་པའི་སྒྲིབ་པའི་གཉེན་པོ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ཉོན་མོངས་པ་མ་སྤངས་སུ་ཟིན་ཀྱང་།",
    "དཔེར་ན་སྤངས་པའི་དགྲ་བཅོམ་པ་ལྟར་ས་ཐམས་ཅད་དུ་ཉོན་མོངས་པའི་ཉེས་པ་མི་སྐྱེད་དོ།",
    "ངོ་བོ་ཉིད་ཀྱི་དོན་ནི་ངོ་བོ་ཉིད་གསུམ་མོ།",
    "ཕྱིན་ཅི་ལོག་གི་འཇུག་པ་དང་།",
    "ཡན་ལག་དང་ཉེ་བའི་ཡན་ལག་གི་སྒོ་དང་།",
    "མོས་པ་རྣམ་པར་ངེས་པ་དང་།",
    "ངོ་བོ་ཉིད་བསྒྲུབ་པ་ནི་བདག་གི་ངོ་བོ་ཉིད་དང་།",
    "ཁྱད་པར་ནི་བདག་གི་ཁྱད་པར་དང་།",
    "མངོན་སུམ་ནི་རང་གི་དོན་ཡོད་ཅིང་སྣང་ལ་མ་ནོར་བའོ།",
    "གཏམ་རྗེས་གཅད་པ་ནི་རང་གི་སྨྲ་བའི་སྐྱོན་ཁས་བླང་བ་དང་།",
    "མི་འཇིགས་པ་ནི་གང་གིས་འཁོར་ཐམས་ཅད་དུ་སྨྲ་བར་བྱེད་པའོ།",
    "སྤོབས་པ་ནི་གང་གིས་ཐམས་ཅད་དུ་ལན་གདབ་པ་ཤེས་པའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པར་གྱུར་པ་རེག་པར་གནས་པ་དཀོན་པ་དང་།",
    "མིང་གི་ཚོགས་དང་།",
    "ཚིག་གི་ཚོགས་དང་།",
    "ཉོན་མོངས་ཀུན་ནས་རབ་ཉོན་མོངས།",
    "རེས་འགའ་ཅི་ཡང་སྦྱིན་པར་མི་བྱེད་པ་དང་།",
    "༧༣༨བསྡུར་འབྲས་རེའུ་མིག་༨ ༣༩སྣ་ཚོགས།",
    "རྒྱ་གར་གྱི་པཎྜི་ཏ་ཤྲཱི་ན་རེནྡྲ་བྷ་དྲ་དང་།",
    "༨༥༧བསྡུར་འབྲས་རེའུ་མིག་༨༥༩༣༥༥ ༡ གསེར་འགྱུར་གྱི་བསྟན་བཅོས་བསྡུས་པ།",
    "༨༦༥བསྡུར་འབྲས་རེའུ་མིག་༨༦༦༣༥༥༢ སྐུ་གསུང་ཐུགས་ཀྱི་ཆ་ཚད།",
    "༨༨ ༡བསྡུར་འབྲས་རེའུ་མིག་༨༨༢༣༥༥༤ རི་མོའི་མཚན་ཉིད།",
    "༩༩བསྡུར་འབྲས་རེའུ་མིག་༩༡༣༥༥༥ སྐུ་གཟུགས་ཀྱི་ཚད་ཀྱི་མཚན་ཉིད་ཅེས་བྱ་བ།",
    "༩༣༨བསྡུར་འབྲས་རེའུ་མིག་༩༣༨༣༥༥༩ སྤོས་ཀྱི་སྦྱོར་བ་རེའུ་ཆར་བྱས་པ་བཞུགས།",
    "༩༧༢བསྡུར་འབྲས་རེའུ་མིག་༩༧༢༣༥༦༢ ཤཱ་རིའི་བུའི་བརྒྱད་པ།",
    "༩༧༣རྒྱ་གར་ཤར་ཕྱོགས་ཀྱི་པཎྜི་ཏ་བུདྡྷ་ཤྲཱི་ཛྙཱ་ནའི་ཞལ་སྔ་ནས་མཉན་ནས།",
    "༩༧༥བསྡུར་འབྲས་རེའུ་མིག་༩༧༥༣༥༦༣ ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "༡༥༥བསྡུར་འབྲས་རེའུ་མིག་༡༦༧༣༥༦༤ གཡུལ་ལས་རྣམ་པར་རྒྱལ་བ་ཞེས་པའི་རྒྱུད་ཀྱི་རྒྱལ་པོ་དབྱངས་འཆར་བ་ཞེས་བྱ་བ།",
    "དུས་སྦྱོར་གྱི་གཟའི་དུམ་བུ་དྲུག་གི་དོན་རབ་ཏུ་ཕྱེ་བ་ཆེན་པོའི་ལེའུ།",
    "༡༡༧༨བསྡུར་འབྲས་རེའུ་མིག་༡༢༤༣༣༥༦༥ མོ་རྩིས་འཇམ་པའི་དབྱངས་ཞེས་བྱ་བ་བཞུགས།",
    "༡༢༦༢བསྡུར་འབྲས་རེའུ་མིག་༡༢༦༢༣༥༦༧ གཙུག་གི་ནོར་བུ་ཞེས་བྱ་བ།",
    "དུས་སྦྱོར་གྱི་གཟའི་དུམ་བུ་དྲུག་གི་དོན་རབ་ཏུ་ཕྱེ་བའི་ལེའུ།",
    "༡༢༧༥བསྡུར་འབྲས་རེའུ་མིག་༡༢༧༧༣༥༦༨ ཚེ་རྩིས་ཀྱི་འབྲས་བུ་གསལ་བར་བྱེད་པ་ཞེས་བྱ་བ།",
    "༡༢༨བསྡུར་འབྲས་རེའུ་མིག་༡༢༨༣༥༦༩ དབྱངས་འཆར་བའི་དོན་བསྡུས་པ།",
    "༡༢༨༦བསྡུར་འབྲས་རེའུ་མིག་༡༢༨༧༣༥༧ དབྱངས་འཆར་བའི་དུས་སྦྱོར་གྱི་འབྲས་བུ་ཉེ་བར་མཁོ་བ།",
    "༡༢༩བསྡུར་འབྲས་རེའུ་མིག་༡༢༩ ༡༣༥༧༡ ཤེས་རབ་བརྒྱ་པ་ཞེས་བྱ་བའི་རབ་ཏུ་བྱེད་པ།",
    "༡༣༢བསྡུར་འབྲས་རེའུ་མིག་༡༣༤༡ ༣༥༧༢ ལུགས་ཀྱི་བསྟན་བཅོས་ཤེས་རབ་སྡོང་བུ་ཞེས་བྱ་བ།",
    "༡༣༤༢བསྡུར་འབྲས་རེའུ་མིག་༡༣༤༤༣༥༧༤ ཚིགས་སུ་བཅད་པའི་མཛོད་ཅེས་བྱ་བ།",
    "༡༣༥༩བསྡུར་འབྲས་རེའུ་མིག་༡༣༦༢༣༥༧༥ ཚིགས་སུ་བཅད་པ་བརྒྱ་པ།",
    "༡༤༨བསྡུར་འབྲས་རེའུ་མིག་༡༤༡༤བ་བ་༡༤༡༥༡༤༡༥༡༤༡༧༣༥༧༨ ལུགས་ཀྱི་བསྟན་བཅོས།",
    "༡༤༢༩བསྡུར་འབྲས་རེའུ་མིག་༡༤༣༢བ་ཟ་༡༤༣༣བ་༡༤༣༣༡༤༣༥༡༤༣༥༡༤༣༥༡༤༣༦༣༥༧༩ རྒྱ་མཚོས་བསྟན་པའི་མཚན།",
    "བུད་མེད་ཀྱི་མཚན་བསྟན་པ།",
    "༡༤༥༣བསྡུར་འབྲས་རེའུ་མིག་༡༤༥༨༣༥༨ མི་དཔྱད་ཀྱི་བསྟན་བཅོས་བསྡུས་པ་བཞུགས།",
    "༡༤༦༡བསྡུར་འབྲས་རེའུ་མིག་༡༤༦༢༣༥༨ ༡ བྱ་རོག་གི་སྐད་བརྟག་པར་བྱ་བ་བཞུགས།",
    "བྱ་རོག་གི་སྐད་ཀྱི་རྣམ་འགྱུར།",
    "༡༤༦༦བབ་༡༤༦༣༡༧དེབ་བརྒྱ་དང་བཅུ་བཞི་པའི་དཀར་ཆགགནས་པའི་བྱ་རོག་གི་ཚང་གི་མཚན་ཉིད།",
    "༡༤༦༨བསྡུར་འབྲས་རེའུ་མིག་༡༤༦༨བ་བས་༣༥༨༢ མིའི་མཚན་ཉིད་བརྟག་པ་རྒྱ་མཚོ་ཞེས་བྱ་བ།",
    "བུད་མེད་ཀྱི་མཚན་ཉིད་བརྟག་པའི་ལེའུ།",
    "གསུང་གིས་བསྐུལ་ནས་པཎྜི་ཏ་དྷརྨ་དྷ་རིའི་ཞལ་སྔ་ནས།",
    "༡༤༥༤བསྡུར་འབྲས་རེའུ་མིག་༡༤༨༤༣༥༨༥ ཐུགས་རྗེ་ཆེན་པོ་ལ་གྲུབ་པ་ཐོབ་པའི་གཏམ་རྒྱུད།",
    "༡༤༨༩བསྡུར་འབྲས་རེའུ་མིག་༡༤༩༣༥༨༧ བུད་མེད་ཀྱིས་གྲུབ་པ་ཐོབ་པ།",
    "༡༤༩༢བསྡུར་འབྲས་རེའུ་མིག་༡༤༩༢༣༥༨༨ སུ་ཁ་དེ་བས་གྲུབ་པ་ཐོབ་པ།",
    "༡༤༩༤བསྡུར་འབྲས་རེའུ་མིག་༡༤༩༥༣༥༨༩ རྟའི་ཚེའི་རིག་བྱེད་ཤ་ལི་ཧོ་ཏྲས་བསྡུས་པ་ཞེས་བྱ་བ།",
    "ངེས་པའི་ཚིག་གི་ལེའུ།",
