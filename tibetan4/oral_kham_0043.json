    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འཇིག་རྟེན་ཆགས་ནས་འདུག་གོ།",
    "ཐ་མལ་པར་འདུག་པ་ལ་བརྟེན་ནས་ནུབ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཉན་པའི་རྣམ་པར་རིག་པའི་ཚོགས་སོ་ཞེས་པ་ལྟར་སྣང་བ་དང་བྱེད་ལས་དང་རྒྱུ་དང་རང་བཞིན་གྱི་ཁྱད་པར་བཞི་དང་ལྡན་པའོ།",
    "དེ་གཉིས་ཀ་ཡང་རང་རིག་མེད་པ་སྟེ།",
    "སེམས་ལས་བྱུང་བའང་རྣམ་པ་དང་བཅས་པ་རྫས་གྲུབ་བོ་དེ་གཉིས་ཀའང་རང་དང་ངོ་བོ་གཅིག་པའི་དོན་གྱི་རྣམ་པ་རིག་པས་རང་རིག་མཚན་ཉིད་པ་དང་དོན་རིག་བཏགས་པ་བ་སྟེ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "སེམས་ཀྱིས་ཀུན་འགྲོ་ལྔའི་ཡུལ་འཛིན་པ་ཡང་རང་སྟོབས་སུ་འགྱུར་རོ།",
    "ཡུལ་ན་འདུག་པ་དང་།",
    "དེ་ཡང་རང་བཞིན་གཅིག་ཉིད་དུ་མཐོང་བའི་ཕྱིར་བློ་གཞན་ལ་མྱོང་བའང་གཞན་པ་ནི་མ་ཡིན་ནོ་ཞེས་དང་།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "དྲུག་པ་ནི་འདིར་ཉེར་ལེན་གྱི་ཕུང་པོ་ལ་ཇི་ལྟ་བ་བཞིན་དཔྱད་ཅིང་རང་དང་སྤྱིའི་མཚན་ཉིད་དག་གཅོད་པ་ཡིན་ན།",
    "ཅེས་པས་སྐྱེ་བས་འདུས་བྱས་དང་རང་མ་གཏོགས་པའི་མཚན་ཉིད་བདུན་ཏེ་བརྒྱད་མ་འོངས་པ་ནས་དེ་ལྟར་དུ་འདྲེན་པར་བྱེད་ལ།",
    "ཡང་རང་བཞིན་གྱི་རིགས་སྒྲིབ་པ་ཡིན་ན།",
    "ཆ་ལས་ཕྱི་རོལ་ལྟ་བུར་འདུག།",
    "མུ་གཉིས་པ་ནི་སྒོ་ང་ཞེས་ཏེ་ནུར་ནུར་པོ་ཕྱི་སྤྲིས་མ་ལྟ་བུས་གཡོགས་ཤིང་ནང་སླ་བར་འདུག་པ་དང་།",
    "མེར་མེར་པོ་ཕྱི་ནང་གཉིས་ག་སྤྲིས་མ་ལྟར་གྱུར་ཏེ་ཞོ་ལྟ་བུར་འདུག་ཅིང་ཤར་མ་གྱུར་བ་དང་།",
    "སྒོ་ངའི་ནང་ན་འདུག་པ་སོགས་ནི་གཉིས་ཡིན་དུ་འགྱུར་ལ།",
    "ཕྱོགས་ཆེ་གེ་ན་དེའོ་ཞེས་བསྟན་པར་ནུས་པ་དང་ཡུལ་ཕྱོགས་འགའ་ཞིག་ན་འདུག་པ་ཡུལ་དུ་འགྱུར་བ་དང་།",
    "ཚངས་པ་ཆེན་པོའི་མདུན་དུ་འདུག་སྟེ་ཚིག་འདོན་པས་དེའོ།",
    "ཡབ་སྲས་མཇལ་བར་སྤྱི་བོ་སྐྱེས་དང་བརྒྱ་བྱིན་སྟན་གཅིག་ལ་འདུག་པ་ལ་མིག་འབྱེད་འཛུམས་ཡོད་མེད་མ་གཏོགས་པ་ཁྱད་མེད་པར་བཀའ་བསྩལ་བས་སོ།",
    "མཐར་ཐུག་དུས་ནི་སྐད་ཅིག་འདོད།",
    "བསྐལ་པ་འཇིག་དུས་ཀྱི་མེ་བས་ཡང་སོས་ཀྱི་མེ་ཚ་ཞིང་།",
    "ཞིག་པར་འདུག་པ་ནི་སྟོང་པ་སྟེ་ཆགས་ནས་འདུག་པ་ནི་གནས་པའོ།",
    "སོ་སོའི་ངོ་བོ་ལ་མི་དགག་ཚིག་དང་རྟག་པ་དུས་ཀུན་པ་ཡིན་པས་རྟག་ཏུ་མེད་པ་ཞེས་པར་བསྒྱུར་ཏེ་ཕུང་པོ་སོགས་ལ་བདག་དུས་རྟག་ཏུ་མེད་པའོ།",
    "ཉི་ཤུར་ཞིག་པར་འདུག་པ་སྟོངས་པ་སྟེ་དེའི་ཚེ་འཕེལ་འགྲིབ་མི་འཇུག་ཀྱང་དུས་མཉམ་པར་བརྩིའོ།",
    "ཉི་ཤུར་ཆགས་ནས་འདུག་སྟེ།",
    "སྔགས་ལ་ཞུགས་ཀྱང་རྐང་པ་བརྐྱང་སྟེ་འདུག་ན་རིང་བའི་ཕྱིར་རོ།",
    "སྐད་ཅིག་ཅེས་ཏེ་ཅི་ལྟ་བུ་ནི་གནས་མའི་བུ་པ་སོགས་གཟུགས་སྐད་ཅིག་པར་མི་འདོད་པས་སོ་ ཇི་ལྟར་སེམས་དང་སེམས་བྱུང་ཁྱེད་རང་ལ་སྐད་ཅིག་མར་གྲུབ་པ་ལྟར་གཟུགས་ཀྱང་སྐད་ཅིག་པ་སྟེ་སེམས་སྐད་ཅིག་པས་ཟིན་པའི་ཕྱིར་རོ།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་བྱུང་དག་རང་རྒྱལ་དང་རྒྱལ་བ།",
    "ཕོ་ནི་མའི་ལྟོ་བ་ལ་བརྟེན་ཏེ་སྒལ་ཚིག་ལ་ཕྱོགས་ཤིང་གློ་གཡས་ན་འདུག་གོ།",
    "གསུམ་པོས་གོང་མ་ལ་དམིགས་པའང་རང་ས་ལྟར་མིན་གྱི་ཀུན་བརྟགས་པས་སོ།",
    "ལྟ་བ་དེ་རྣམས་ལ་མཆོག་འཛིན་གཉིས་ཀྱིས་མཆོག་དང་ལྟ་བ་དེ་དང་མཐུན་པའི་ཚུལ་ཞུགས་ལ་དག་བྱེད་དུ་འཛིན་ཅིང་ལྟ་བ་དེ་རྣམས་ལ་འདོད་ཆགས་པ་དང་དེས་ཁེངས་པ་དང་རང་དང་མི་མཐུན་པའི་ལྟ་བ་ལ་ཁོང་ཁྲོ་སྟེ་ལྔ་ལོག་པར་རྟོག་པ་ལ་ལོག་པར་རྟོག་པའོ།",
    "བསྡུ་བར་ནི་ཡིད་སྨོན་རྗེ་དཔོན་ལ་འདོད་པའི་རྣམ་པ་སོགས་དང་རང་ལ་གཞན་འདོད་པ་ཆུང་བ་སོགས་སུ་ཡིད་ཆེས་ན་སྙམ་པ་སོགས་དང་ཕྱི་མ་ལ་ལྷར་སྐྱེས་ན་སྙམ་པ་སོགས་དང་།",
    "སར་རྨི་ལམ་དུ་དང་མི་ཤེས་པར་དང་བསམ་བཞིན་མ་ཡིན་པར་དང་དྲག་པོ་མིན་ལ་རྒྱུན་ཆགས་མིན་པར་དང་ནོར་བར་དང་བརྗེད་པས་དང་མི་འདོད་བཞིན་དུ་བྱས་པ་དང་རང་བཞིན་གྱིས་ལུང་མ་བསྟན་དང་འགྱོད་པས་དང་གཉེན་པོས་གསལ་བའོ།",
    "འདོད་ལོག་ལ་གཞན་གྱི་ཆུང་མ་སོགས་ལ་དང་རྙེད་བཀུར་དང་རང་དང་མཛའ་བོ་བསྐྱང་པའི་ཆེད་དུ་ཆགས་པ་དང་གནོད་ལན་དུ་དང་།",
    "དེ་དང་ལྷན་ཅིག་འདུག་མི་བྱ།",
    "དུས་ཐུང་ངུ་དང་རང་ཉིད་སྤོང་བ་ཙམ་དང་།",
    "དུས་རིང་དུ་དང་རང་ཉིད་སྤོང་ཞིང་གཞན་ཡང་སྤོང་དུ་འཇུག་པ་དང་།",
    "སྡོམ་པ་ཆེན་པོ་ཀུན་དང་ཇི་སྲིད་འཚོ་བར་དུ་དང་རང་སྲུང་བ་སོགས་བཞི་ཅན་དང་ཡོངས་སུ་དག་པའི་སྡོམ་པ་སྡོམ་པ་བླངས་པས་སྐྱོན་མེད་པས་འགྱོད་པ་མེད་པའི་རྒྱུས་བསམ་གཏན་དང་ཟག་མེད་ཐོབ་པ་སྟེ་བརྒྱད་གསུངས་སོ།",
