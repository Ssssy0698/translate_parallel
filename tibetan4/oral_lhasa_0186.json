    "གཞན་ཡང་ཞེས་པ་ལ་སོགས་པས་ངེས་པར་གཟུང་བ་ངེས་ཉེ་བར་ཐོབ་པར་བྱེད་དེ།",
    "འདི་ཡང་ཅི་ཞིག་ཡིན་ཞེ་ན་གསུངས་པ།",
    "འགལ་བ་ཐམས་ཅད་ཀྱང་བསྒྲུབ་བྱ་ལ་གནོད་པར་བྱེད་པའི་སྒྲུབ་བྱེད་ཡིན་ཏེ།",
    "དེ་ཡང་གང་ངག་ཏུ་མ་བརྗོད་ཀྱང་འདོད་པས་ཁྱབ་པ་ལ་གནོད་པ་སྒྲུབ་པར་བྱེད་པ་དེ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འདི་ནི་གནོད་པ་ལ་གནོད་པར་བྱེད་པའོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "འདུས་པ་ཉིད་ནི་གཞན་གྱི་དོན་ཡང་སྒྲུབ་པར་བྱེད་དོ།",
    "གཡོན་ཅན་གྱི་ཐ་སྙད་ལ་ཁྱད་པར་ཇི་ལྟ་བ་བཞིན་སྐྱོན་བསྟན་པའི་དོན་དུའོ།",
    "སྦྱོར་བ་པོའི་འདོད་པ་ལས་བཟློག་པ་སྒྲུབ་པར་བྱེད་པ་གང་ཡིན་པ་དོན་གཅིག་མིན་སྒྲུབ་པར་བྱེད་པ་དེའི་ནང་དུ་འདུ་བར་རིག་པར་བྱའོ།",
    "ཇི་ལྟར་སྒྲ་རྟག་སྟེ་བྱས་པ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་པ་དོན་གཅིག་མིན་སྒྲུབ་པར་བྱེད་པ་འགལ་བའི་གཏན་ཚིགས་ཁོ་ན་ཡིན་པ་དེ་ལྟར་འདི་ཡང་ངོ་ཞེས་པའོ་ཞེས་པའི་ཡི་གེ་ནི་གཏན་ཚིགས་ལ་སྟེ།",
    "དེའི་ཕྱིར་ངེས་པར་གཟུང་བ་འགལ་བ་མེད་དོ་ཞེས་པ་དགོངས་པའོ།",
    "འོ་ན་འདུས་པ་རྣམས་གཞན་ལ་ཕན་འདོགས་པར་བྱེད་པ་ངེས་པ་མེད་པའི་ཕྱིར་འདི་འགལ་བ་མ་ཡིན་པ་ཁོ་ན་སྟེ།",
    "འདིར་ཕན་འདོགས་པའི་བྱ་བ་ལ་ཐོགས་པ་མེད་པའི་ནུས་པ་ཅན་གྱི་མིག་ལ་སོགས་པ་རྣམས་ཕྱོགས་སུ་བྱས་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "འདིར་གཏན་ཚིགས་ལ་སོགས་པའི་མཚན་ཉིད་ལ་རྟོགས་པ་ཅི་ཡིན་ཞེ་ན་གསུངས་པ།",
    "འདིར་ཡང་ཞེས་པ་བརྗོད་མ་ཐག་པའི་ཚིགས་སུ་བཅད་པར་རོ།",
    "སོགས་པའི་སྒྲས་འགལ་བ་དང་མ་ངེས་པར་གཟུང་ངོ།",
    "བརྗོད་པར་འདོད་པ་ཡང་དེ་ཡིན་ལ་གྲངས་གཅིག་པ་ཅན་ཡང་ངོ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "དེ་ཡང་ཅི་ཞིག་ལ་ཞེ་ན་གསུངས་པ།",
    "དེའི་ཕྱིར་ཁྱད་པར་གྱི་དོན་དུ་དེ་སྐད་བརྗོད་དོ།",
    "འདི་སྐད་བརྗོད་པར་འགྱུར་ཏེ།",
    "རྟེན་གྱི་གྲངས་ཀྱིས་འདིར་རིགས་ངེས་པར་བསྟན་པའོ།",
    "དེའི་ཕྱིར་གཏན་ཚིགས་གཅིག་ལ་སོགས་པའི་གཞི་ཁོ་ན་འདིར་གཏན་ཚིགས་ལ་སོགས་པའི་རིགས་སུ་རིག་པར་བྱའོ་ཞེས་པའོ།",
    "ཅི་སྟེ་གཅིག་ཉིད་ཀྱི་གྲངས་བརྗོད་པར་འདོད་པའི་དགོས་པ་ཅི་ཡིན་ཞེས་མི་ཤེས་པ་འདྲི་བར་བྱེད་པའོ།",
    "འགལ་བ་དག་ལས་ཞེས་པ་ལ་སོགས་པ་ལ་ཕན་ཚུན་འགལ་བའི་དོན་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་འགལ་བ་དག་སྟེ།",
    "སྒྲ་མི་རྟག་སྟེ་བྱས་པ་ཉིད་ཀྱི་ཕྱིར་བུམ་པ་བཞིན།",
    "དེ་བཞིན་དུ་སྒྲ་རྟག་སྟེ་བྱས་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཞེ་ན་གཅིག་ཉིད་ཀྱི་གྲངས་བརྗོད་པར་འདོད་ཅེ་ན་འདི་ནི་སྐྱོན་མ་ཡིན་ཏེ།",
    "ཇི་ཙམ་དུ་བྱས་པ་ཉིད་ནི་དངོས་པོའི་སྟོབས་ཀྱིས་ཞུགས་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དེ་འདིར་ཉེ་བར་དགོད་པར་མི་རིགས་སོ་ཞེ་ན།",
    "ཕྱོགས་ཙམ་བསྟན་པའི་ཆེད་དུ་དཔེར་བརྗོད་པ་འདི་སློབ་དཔོན་གྱིས་གསུངས་སོ།",
    "དེའི་ཕྱིར་བརྗོད་པར་འདོད་པ་ཞེས་པ།",
    "འོ་ན་ཚུལ་གསུམ་རྟགས་ལས་དོན་མཐོང་བའོ་ཞེས་བརྗོད་པར་བྱ་བ་མ་ཡིན་གྱི།",
    "ཚུལ་བཞིན་ཞེས་བྱ་བར་བརྗོད་པར་བྱ་སྟེ།",
    "ཅི་ལྟར་ད་ནི་ལུང་ལ་བརྟེན་པའི་རྟགས་ལས་སྐྱེས་པ་དེ་རྗེས་སུ་དཔག་པ་ཉིད་དུ་རྟོགས་པར་བྱ།",
    "བྱས་པ་ཉིད་དང་མཉན་པར་བྱ་བ་ཉིད་དག་ལས་ཡང་དག་པའི་ཤེས་པ་དང་བཟློག་པ་བཞིན་དུ་ཐེ་ཚོམ་མེད་པ་ཉིད་ཐོབ་པར་འགྱུར་ཞིང་།",
    "ཐེ་ཚོམ་དང་གཏན་ལ་ཕེབས་པའི་རྒྱུ་དག་ཐེ་ཚོམ་དང་གཏན་ལ་ཕེབས་པའི་སྒྲས་བརྗོད་དོ།",
    "གཏན་ཚིགས་ལ་སོགས་པའི་མཚན་ཉིད་དང་ལྡན་པ་ལ་གྲངས་གཅིག་བརྗོད་པར་འདོད་པ་ཡིན་གྱི།",
    "བྱས་པ་ཉིད་དང་མཉན་པར་བྱ་བ་ཉིད་འབའ་ཞིག་པ་དག་ལ།",
    "འགལ་བའི་དོན་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་འགལ་བ་ཡང་དེ་དག་ཡིན་ལ།",
    "འགལ་བ་མི་འཁྲུལ་བ་ཅན་ཞེས་བརྗོད་པར་བྱའོ།",
    "དེ་ལ་དུ་མ་ལས་ཅི་ལྟར་ངེས་པར་འགྱུར་ཏེ།",
    "ངེས་པར་འགྱུར་བ་མ་ཡིན་པ་ཁོ་ན་ཞེ་ན།",
    "གཅིག་ཉིད་དུ་བརྗོད་པར་འདོད་པ་ཉིད་ཀྱི་ཕྱིར་ཏེ།",
    "དེའི་ཕྱིར་བརྗོད་པར་འདོད་པའི་གྲངས་གཅིག་ཉིད་རིགས་པ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "ཕ་རོལ་པོས་ནི་སློབ་དཔོན་གྱི་དགོངས་པ་གཅིག་ཉིད་དུ་བརྗོད་པར་འདོད་པའི་ཡུལ་མི་ཤེས་པས།",
    "ཡུལ་ཐམས་ཅད་ལ་གཅིག་ཉིད་དུ་བརྗོད་པར་འདོད་པའོ་ཞེས་བསམས་ནས་རྩོད་ཅིང་།",
    "མི་འགལ་བའི་དོན་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་མི་འགལ་བ་སྟེ།",
    "དེ་ལྟ་ན་གང་དུ་ཞེས་པ་ལ་སོགས་པས་སླར་ཡང་དོན་གཅིག་བརྗོད་པར་འདོད་པ་མི་འཐད་པར་གསུངས་སོ།",
    "དེ་ཁོ་ནའི་ལན་གསུངས་སོ།",
    "ཡན་ལག་ཅན་ནི་ཡན་ལག་རྣམས་ལ་གཞན་ཞེས་པ་འདིར་ནི་བསྒྲུབ་པར་བྱ་བ་ཐ་དད་པ་དག་སྟེ།",
    "གཞན་ཉིད་ཀྱི་ཁྱད་པར་ཡན་ལག་དང་ཡན་ལག་ཅན་དག་བསྒྲུབ་བྱ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ཐེ་ཚོམ་དང་གཏན་ལ་ཕེབས་པའི་དངོས་པའི་ཕྱིར་རོ་ཞེས་པ་ཐེ་ཚོམ་དང་གཏན་ལ་ཕེབས་པ་དག་གོ།",
    "གང་ལ་ཐེ་ཚོམ་དང་གཏན་ལ་ཕེབས་པ་ཡོད་པ་དེ་ལ་གཞན་ཉིད་དེ།",
    "གཏན་ལ་ཕེབས་པ་ཡོད་ན་ཐེ་ཚོམ་ཡོད་པའི་ཕྱིར་ཞེས་པའོ།",
    "གཏན་ལ་ཕེབས་ཀྱང་ཐེ་ཚོམ་གྱི་ཟླ་བོ་ལ་ལྟོས་པའི་གཏན་ཚིགས་ཏེ།",
    "ཐེ་ཚོམ་ཡོད་ན་གཏན་ལ་ཕེབས་པའི་ཕྱིར་རོ་ཞེས་པའོ།",
    "དེས་ན་གཞལ་བྱ་ཉིད་ལ་སོགས་པས་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་ཅིང་།",
    "མཉན་པར་བྱ་བ་ཉིད་ལ་ནི་དེ་མེད་དོ་ཞེས་སྨྲས་པ།",
    "འདིས་འབྲེལ་པ་ཉིད་གསུངས་ཏེ།",
    "ཁྱད་པར་ཇི་སྲིད་ཀྱིས་ཞེས་པ།",
    "རྟག་པ་དང་མི་རྟག་པའི་དངོས་པོའི་ཁྱད་པར་གྱིས་དང་།",
    "ཟག་པ་དང་བཅས་པ་དང་ཟག་པ་མེད་པའི་ཁྱད་པར་གྱིས་སམ།",
    "མུ་སྟེགས་བྱེད་ཀྱིས་རྣམ་པར་གཞག་པའི་དངོས་པོའི་ཁྱད་པར་གྱིས་དངོས་པོ་ཐམས་ཅད་བསྡུས་པའོ།",
    "མཐའ་གཅིག་པ་ནི་གཏན་ལ་ཕེབས་པ་ཡིན་ཞིང་།",
    "འདིས་གཅིག་ལ་ཡོད་པ་ལ་སྒྲུབ་བྱེད་མེད་པ་གསུངས་སོ།",
    "འོ་ན་དེ་ཡང་ཐམས་ཅད་ཐེ་ཚོམ་གྱི་རྒྱུར་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "འདི་མཉན་པར་བྱ་བ་ཉིད་ལས་ཁྱད་པར་ཅི་ཞིག་ཡོད་གལ་ཏེ་ལྡོག་པ་མི་འཁྲུལ་བའོ།",
    "མཉན་པར་བྱ་བ་ཉིད་ཀྱི་ནི་དེ་ལྟ་མ་ཡིན་ཏེ།",
    "མི་མཐུན་ཕྱོགས་ཉིད་ལས་མཉན་པར་བྱ་བ་ཉིད་ལྡོག་པ་ནི་མ་ཡིན་གྱི།",
    "རྣམ་པ་གཞན་དུ་ན་འདི་ལྡོག་པ་ཅན་ཁོ་ནར་མི་འགྱུར་རོ་ཞེས་པས་སྲོག་ལ་སོགས་པ་མཉན་པར་བྱ་བ་ཉིད་དང་ཁྱད་པར་མེད་དོ།",
    "མ་ཡིན་པར་དགག་པ་གཅིག་པུ་ནི་དགག་པའི་ཡུལ་མ་ཡིན་གྱི།",
    "འོན་ཀྱང་མེད་པར་དགག་པ་ཡང་ཡིན་ཞིང་།",
    "ཁྱད་པར་སྟོན་པ་གསུངས་པ།",
    "རྣམ་པར་མི་གཅོད་པའི་གཏན་ཚིགས་ནི་ཐེ་ཚོམ་གྱི་རྒྱུའོ་ཞེས་པའི་དོན་ཏོ།",
    "ཐེ་ཚོམ་གྱི་རྒྱུ་ཉིད་དུ་མཚུངས་ན་ཡང་འདི་ནི་ཁྱད་པར་ཏེ།",
    "འདི་རྣམས་ལ་གང་གཉིས་ཀ་ལ་བརྟེན་པ་དེ་ནི་བསྒྲུབ་པར་བྱ་བ་འགའ་ཞིག་ལ་ངེས་པའི་རྒྱུ་ཡང་ཡིན་ཏེ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་གསུངས་པ།",
    "དཔེར་ན་རྩོལ་མ་ཐག་ཏུ་བྱུང་བ་བསྒྲུབ་པར་བྱ་བ་ལ།",
    "བྱས་པ་ཉིད་ལ་ངེས་པའི་གཏན་ཚིགས་ཡིན་པ་བཞིན་ཏེ།",
    "མ་བྱས་པ་ལས་ལྡོག་པའི་ཕྱིར་རོ།",
    "ཡང་མཉན་པར་བྱ་བ་ཉིད་ཅི་ལྟར་ན་གཉི་ག་བརྟེན་པར་མི་འགྱུར་ཏེ།",
    "འགའ་ཞིག་ལས་ལྡོག་པར་བྱའོ་ཞེ་ན།",
    "ཡོད་ན་ཡང་དེ་དག་ནི་ཇི་སྲིད་དུ་ངེས་པར་མ་བྱས་པ་དེ་སྲིད་དུ་མེད་པ་དང་མཚུངས་པ་དག་སྟེ།",
    "འོ་ན་མཉན་པར་བྱ་བ་ཉིད་ནི་རྣ་བས་གཟུང་བར་བྱ་བ་ཉིད་དེ།",
    "དེས་ན་མཉན་པར་བྱ་བ་ཉིད་མི་རྟག་པ་ཁོ་ན་ལ་འཇུག་གོ་ཞེས་པ་འདི་ནི་ཐེ་ཚོམ་མེད་དེ།",
    "ཁ་ཅིག་ནི་གཉིས་ཀ་ལ་མི་བསྟེན་པའི་གཞལ་བྱ་ཉིད་ཀྱང་འདུས་མ་བྱས་ལ་སྐུར་པ་འདེབས་པ་ལས་མེད་པ་ལ་རྗེས་སུ་འགྲོ་བ་མི་རིགས་པའི་ཕྱིར་རྗེས་སུ་འགྲོ་བ་མི་འཁྲུལ་བ་ཅན་མཐུན་ཕྱོགས་ཁོ་ན་ལ་ཡོད་དོ་ཞེས་པས་རྗེས་སུ་འགྲོ་བ་ཅན་ཁོ་ནའི་གཏན་ཚིགས་སུ་སྨྲའོ།",
    "གལ་ཏེ་མཐུན་པའི་ཕྱོགས་ལ་ཡོད་པ་ཉིད་རྣམ་པར་མི་གཅོད་ན་ངེས་པར་གཟུང་བ་འདིའི་འབྲས་བུ་ཅི་ཡིན་རྣམ་པར་གཅོད་ནའང་ཅི་ལྟར་མི་ལྡོག་སྟེ།",
    "ལྡོག་པ་ནི་ཡོད་པ་རྣམ་པར་གཅོད་པ་ལས་གཞན་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་རྣམ་པར་གཅོད་པས་རྟག་པ་ཉིད་གོ་བར་བྱེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་འདི་ལ་མི་རྟག་པ་ཉིད་ཀྱི་གཏན་ཚིགས་ཀྱང་བྱེ་བྲག་པས་སྟོན་པར་མི་བྱེད་པ་དེའི་ཚེ་གཏན་ཚིགས་ཉིད་དུ་ཡང་འགྱུར་ཞེས་སྦྲེལ་བར་བྱའོ།",
    "དེ་ནི་འདི་རྣམས་ཁོ་ནས་ཀྱང་ལུང་སྟོབས་དང་ལྡན་པར་ཁས་བླངས་ལ།",
    "བསྡུ་བའི་ཚིགས་སུ་བཅད་པར་གང་རྣམས་ཀྱི་དང་གང་རྣམས་ཀྱི་ཞེས་འདིར་གཅིག་ལྷག་བལྟ་བར་བྱ་སྟེ།",
    "གཞན་རྣམས་ནི་གཅིག་ལྷག་མ་བྱས་པ་ཁོ་ནར་ཇི་ལྟར་རིགས་པར་སྦྱོར་བར་བྱེད་དོ།",
    "དེ་རྣམས་ནི་མ་བརྗོད་པ་ཉིད་ཀྱི་ཕྱིར་མ་ལུས་པ་ཡིན་པ་བརྗོད་པ་ཉིད་དུ་དོགས་པར་འགྱུར་རོ།",
    "དེས་ན་དེ་བསལ་བའི་ཆེད་དུ་གསུངས་པ།",
    "ཐེ་ཚོམ་ཐོབ་པར་འགྱུར་ཏེ།",
    "དེ་ལ་གལ་ཏེ་འཁྲུལ་པ་དང་བཅས་པ་ལ་སོགས་པ་རྣམས་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་ན་མ་ངེས་པ་ཁོ་ནའི་ནང་དུ་འདུ་ཞིང་།",
    "གང་འདོད་པ་ལ་གནོད་པར་བྱེད་པའི་འགལ་བར་འདོད་པ་དེ་ཅི་ལྟར་བརྗོད་པར་བྱ་སྟེ།",
    "འོན་ཏེ་ཐེ་ཚོམ་གྱི་གཏན་ཚིགས་ཡིན་ཞེས་པར་རོ།",
    "རྣམ་པ་གཉིས་ཀར་བརྗོད་པར་མི་ནུས་སོ་ཞེས་པ་བསམ་པའོ།",
    "གལ་ཏེ་འདི་བཟློག་པའི་གཏན་ཚིགས་སུ་འགྱུར་ན་ནི་ཟློག་པ་གྲུབ་པར་འགྱུར་ན།",
    "ཉེ་བར་འགོད་པར་བྱེད་ཅིང་དཔེ་ཅན་ཉེ་བར་འཇོག་པར་བྱེད་དོ་ཞེས་བྱས་ནས་སོ།",
    "རྟག་པ་ཉིད་ཀྱི་གཏན་ཚིགས་དང་ལྷན་ཅིག་པ་ནི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པར་འགྱུར་རོ་ཞེས་སྦྲེལ་ལོ།",
    "གྲངས་གཅིག་བརྗོད་པར་འདོད་པ་ཉིད་ཀྱི་ཕྱིར་གཅིག་ཁོ་ན་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་གཟུང་བའོ།",
    "དེ་ལ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པ་ཉིད་དུ་རིགས་པའོ།",
    "འདིར་ནི་འགལ་ཟླ་དང་བྲལ་བ་གཅིག་ཁོ་ན་ཅིའི་ཕྱིར་སྒྲུབ་པར་མི་བྱེད།",
    "བསྒྲུབ་བྱའི་ཁྱད་པར་ནི་གཞན་གྱི་དོན་ཉིད་དང་གཞན་གྱི་དོན་མིན་པ་ཉིད་ཀྱི་མཚན་ཉིད་ཅན་དུ་སེམས་པར་བྱེད་དོ།",
    "ཐ་དད་མེད་པར་འགྱུར་རོ་ཞེས་པ་དེའི་མཚན་ཉིད་ཅན་གྱི་ཕྱིར་རོ།",
    "དེ་ལྟར་སྨྲས་པ་ཙམ་བསྒྲུབ་པར་བྱ་བར་སྨྲ་བ་བསལ་བ་ལ།",
    "སློབ་དཔོན་གྱིས་གསུངས་པ།",
