    "ཞེས་མང་བར་གསུངས་པ་དང་།",
    "ལྷ་འདྲེའི་ཡོ་ལང་ཚང་མ་མཁྱེན་པའི་རྟོགས་ལྡན་དེ་གདུག་ཅན་ལྷ་འདྲེས་རྒྱུད་རླམས་པ་ཞིག་དང་།",
    "ཞེས་གསུངས་པས་གང་ལ་གང་འདུལ་དེ་ལ་དེར་སྟོན་པ།",
    "དེ་ལྟར་གསུངས་མཁན་དེ་མ་ངེས་ཟེར་ན།",
    "གླིང་སྤྲུལ་ལུང་རྟོགས་བསྟན་འཛིན་འཕྲིན་ལས་མཆོག་སྤྱི་ལོ་༡ཊྭཱཾ་༥རྐྱལོར་འཁྲུངས་སྤྱི་ལོ་༡༩གཡས་གཡོན་དུ་གནས་འདིར་ཕེབས་པར་སེམས།",
    "མཚོ་ལ་རལ་གྲི་ཀླུ་བུམ་བཅས་ཕུལ་ནས་ཞག་གཅིག་བཞུགས།",
    "དེ་རྗེས་འབྲི་གུང་གདན་རབས་སུམ་ཅུ་པ་སྐྱབས་མགོན་པདྨའི་རྒྱལ་མཚན་མཆོག་འགོམ་དགོན་དུ་ཕེབས་ནས།",
    "ཡར་ལམ་ནགས་ལྷའི་ལྷ་མཁར་དུ་ཞག་གསུམ་བཞུགས་ཤིང་།",
    "རྗེ་ཉིད་ཀྱིས་སྦོས་རྫོངས་ནས་ནོར་བདག་གསང་བའི་བསྒྲུབ་སྐོར་རྣམས་གཏེར་ནས་བཞེས།",
    "གནས་འདིར་བཞུགས་མཁན་ནི་ཡུལ་མི་རྒན་རབས་རྣམས་ཀྱི་ངག་རྒྱུན་དུ།",
    "བར་སྐབས་ཤིག་ལ་འགོམ་ཨ་སྟག་དགེ་སློང་བྱ་བ་དེ་སྤྱོད་པ་ཅུང་ཞན་པས་སྟོད་དགོན་གཉིས་ནས་བློ་ལ་མ་བབས་པས་བར་སྐབས་ཤིག་འགོམ་གྱི་མཚམས་པ་བཞུགས་མཁན་མེད་པར་གྱུར་ཀྱང་སྟོང་རྩ་རྣམས་སྔར་བཞིན་རྒྱུན་གནས་དང་།",
    "རིག་གསར་གོང་དུ་རབ་བརྟན་དགོན་གྱི་གྲྭ་ཡེ་ཤེས་ཟླ་བ་བཞུགས།",
    "སྟག་ཕུའི་ཕྱག་གནང་གུ་རུ་གཙོ་འཁོར་གསུམ།",
    "དེ་ཡི་ནང་དུ་རྗེ་ཡབ་སྲས་གསུམ་དང་དེའི་གསུངས་འབུམ།",
    "རང་བསྟོད་པ་དང་གཞན་སྨོད་ལ་མི་དགྱེས་པར།",
    "རི་ཀླུང་མེད་པར་ནགས་ཚལ་གྱིས་གང་ཞིང་རི་སྐྱེས་སྲོག་ཆགས་དང་རིག་དངོས་ལ་གཏོར་སྐྱོན་ཉུང་ཞིང་བདེ་བར་གནས་པ།",
    "དེ་སྐབས་སུ་ཕྱོགས་གཞན་ནས་ཤ་མར་འབྲུ་གསུམ་སྒྲུབ་པར་ནགས་ཤོད་དུ་ཡོང་བར་བཤད།",
    "ལྷག་པར་དུ་དུང་དཀར་གྱི་མཛེས་ཆ་མདུན་དུ་སྣོལ་བ།",
    "ནགས་ཤོད་ཀྱི་དཔོན་ཁགསྔོན་དུས་སུ་ལུང་འདིར་དཔོན་ཚང་མང་པོ་བྱུང་བར་སྨོས་མ་དགོས་པ་འོག་ནས་རིམ་པར་གསལ་ཡང་།",
    "བོད་སིལ་བུའི་གོང་དང་མཇུག་ནས་ད་བར་དཔོན་གནས་དང་དཔོན་རྒྱུད་མ་ཉམས་པར་གནས་པས་མི་ཐོག་ཉི་ཤུ་ལྷག་ཙམ་སོན་པ་ཤ་སྟག་ཡིན་ཞེས་གསུངས།",
    "རྒྱལ་པོ་བཀའ་ཆེམས་དེབ་ངོས་༡རྡོ་༥ ཤཱ་བ་གཟུངས་ནས་རྨོས་བྱས།",
    "ནགས་ཤོད་དུ་ལམ་ནོར་དུ་བཅུག་པ་ལ་སོགས་སྙད་བྱས་ནས་འགོར་རོ།",
    "ཞེས་སྒྲུབ་གནས་ཁྱད་པར་ཅན་དུ་ལུང་བསྟན།",
    "མུ་ཏིག་ཤེར་གྱི་རྦ་མ་གོང་དུ་ཕེབས་པར་གསུངས་པ་དང་།",
    "དད་ལྡན་རྣམས་ཀྱིས་ས་སྐོར་ཡུལ་རིས་ཕུལ་བ་ལ་གཞི་བྱས་ནས་བསྟན་པ་དར་བས།",
    "ད་ལྟ་ཉི་གྲགས་ཡབ་སྲས་གཙོས་པའི་བླ་སྤྲུལ་རིམ་པར་བྱུང་ནས་འགྲོ་དོན་རྒྱས་བཞིན་མཆིས།",
    "གཞན་ཡང་ཀརྨ་པ་དུས་གསུམ་མཁྱེན་པས་ཕྱག་བཏབ་པ་འབྲོང་སྣ་དགོན་འདུ་ཁང་ཀ་བརྒྱ་མ་བཅས་བཞེངས་པ་ནས་བཟུང་།",
    "དུས་མཁྱེན་གྱི་ཐུགས་སྲས་གྱ་པ་གངས་པས་སོག་ཙན་དན་དགོན་དང་ཝ་ཐང་དགོན་བཅས་བཏབ་ནས་ནགས་སོག་ཏུ་འགྲོ་དོན་རྒྱ་ཆེན་མཛད།",
    "རྭ་ཁྱིམ་དགོན་གཉིས་ལ་བཞུགས།",
    "གཅིག་ཀརྨ་བཀའ་བརྒྱུད་ཡིན་ཞེས་གསུངས།",
    "གུ་ཤེ་ཆེན་པོ་དཔལ་ལྡན་དོན་གྲུབ་མཆོག་གནས་འདིར་ཕེབས་ནས་དུས་རབས་བཅོ་ལྔ་པའི་ནང་ཚན་དུ་སྟག་གདོང་རི་བོ་དཔལ་འབར་དགོན་ཕྱག་བཏབ་ནས་གདན་ས་ནགས་ཤོད་དུ་མཛད་ནས་ནགས་ཤོད་སྟག་ཕུ་ཞེས་སྐུ་ཕྲེང་རིམ་བྱོན་རྣམས་མཁས་གྲུབ་གཉིས་ལྡན་གྱི་གྲགས་པའི་སྙན་པ་བཟང་།",
    "སྟག་ཕུའི་གཏེར་གསར་རྣམས་གཏེར་ནས་བཞེས་ནས་ཉམས་སུ་བསྟར།",
    "༡༤༤ལྕགས་སྤྲེལ་ལོར་ནགས་ཤོད་དུ་ཕེབས་ནས་བཀའ་དགོན་རྣམ་ཆེན་དགོན་དང་།",
    "རྗེ་ཉིད་སྐུ་ཕྲེང་རིམ་པར་བྱུང་བ་རྣམས་གཞུང་བཀའ་པོད་ལྔ་ལ་མཁས་པ་དང་།",
    "དགུང་ལོ་དྲུག་ཅུ་ཆུ་བྱི་ལོ་༡༥༥༢ལོར་དགའ་ལྡན་ཁྲི་པའི་གསེར་ཁྲིར་ལོ་བདུན་བཞུགས་པས་འགྲོ་དོན་མཐའ་ཡས་དང་།",
    "ཨོ་རྒྱན་གསང་མཛོད་སོགས་ལ་ཕེབས་ནས་གསང་བ་བཅུ་གསུམ་གྱི་གསང་གཏེར་བཞེས།",
    "དབུ་རུ་བར་སྐོར་ཕེབས་ནས་མྱང་གུ་རུ་ཕུག་ནས་མཁའ་འགྲོའི་བརྡ་ཡིག་ལན་གསུམ་བབས།",
    "སྟག་ཕུའི་ཨར་གཞས་ལེའུ་སུམ་ཅུ་ལྷག་ཡོད་པ་ལྗགས་རྩོམ་གནང་བ་འདི་ནི།",
    "གཞས་ཤགས།",
    "གླུ་གར་སོགས་རྨང་གཞིའི་ཐོག་ལ་གསར་གཏོད་གནང་བས།",
    "བོད་མི་རིགས་སྤྱི་དང་ལྷག་པར་རང་ལུང་པའི་གནའ་བོའི་སྒྱུ་རྩལ་ཞིག་ཡིན་པས་ད་ལྟ་ནག་ཆུའི་སྒོར་བྲོ་སོགས་དང་།",
    "དེ་དང་མཚུངས་པར་རྗེ་ཉིད་ཀྱི་རས་པ་ཡང་བསྐྱར་གསོ་མཛད་པར་གྲགས།",
    "རྒྱང་རྩེའི་མཆོད་རྟེན་དང་མཚུངས་པར་བཞེངས།",
    "གཞན་ཡང་རྒྱ་གར་གནས་ཆེན་ཁག་སོགས་ནས་གཏེར་བཞེས་མང་།",
    "ཀརྨ་པཀྵིའི་ཡོངས་འཛིན་གནང་།",
    "ལྷག་པར་དཀར་ནག་རྩིས་དང་དབྱངས་འཆར་བཅས་ཀྱི་ཕྱག་ལེན་ལ་མཁས་པ།",
    "ལོ་ཐོའི་བསྟན་རྩིས་ཕྱོགས་བསྒྲིགས་པོད་གཅིག་ཡོད་པར་གསུངས་པས་མི་རབས་ནས་མི་རབས་བར་བོད་ཁམས་སྤྱི་དང་ཡུལ་ལུང་འདིའི་དགོན་གནས་དང་མི་སྣ་གྲགས་ཅན་སོགས་ལོ་ཚིག་བསྟར་ལ་བརྒྱུས་པའི་རྩ་ཆེའི་ནོར་བུ་གཅིག་ཡིན་ཀྱང་རིག་གསར་སྐབས་སུ་གཏོར་བརླག་ཕྱིན།",
    "དུས་རབས་ཉི་ཤུ་པའི་ནང་དུ་ཆར་རྒྱུད་རྩིས་པ་འབས་དགའ་ཞུ་བ་བཞུགས་པས་དགོན་ཁག་རྣམས་གཙོས་པས་དཀར་ནག་རྩིས་ལ་མཁས་པའི་སློབ་ཚོགས་མང་།",
    "ད་ལྟ་ཁྱིམ་རྒྱུད་དང་རྩིས་རྒྱུད་མ་ཆད་པར་བཞུགས་ཡོད།",
    "ད་ལྟ་ཁྱིམ་རྒྱུད་མ་ཉམས་པར་གནས་ཡོད་ཀྱང་།",
    "བཀའ་བརྒྱུད་པའི་མཁས་གྲུབ་གཉིས་ལྡན་གྱིས་བརྩམས་པའི་གསུངས་རྩོམ་ཀྱང་ཡོད་ངེས་པས།",
    "ད་ལྟ་བཞུགས་པ་དང་མ་བཞུགས་པའི་མཚན་ཙམ་དང་།",
    "གྲགས་ཅན་གྱི་མི་སྣ་སོགས་གང་སྤྱི་ནས་ཕྱོགས་བསྒྲིག་གནང་བའམ།",
    "དེ་མིན་གསུང་རྩ་ཆེན་པོ་ཡིན་ཞེས་མ་དཔེ་གཅིག་པུ་ཉར་ནས་གཞན་ལ་མི་སྟོན་པར་དད་པ་ཆེན་པོས་རྟེན་གྱི་གྲངས་སུ་བཞུགས་ཀྱང་།",
    "ཀུན་གྱི་མཇལ་མི་ཐུབ་པ་དང་གཅིག་པུ་བརླག་ན་རིན་ཐང་ལྡན་པའི་ནོར་བུ་དེ་ཕྱོགས་གང་དུ་བཙལ་ཀྱང་རྙེད་པར་མི་འགྱུར།",
    "གསུངས་རྩོམ་ཡར་རྒྱས་དང་འགྲེམ་སྤེལ་དར་ཁྱབ་བཅས་བཏང་ན།",
    "དེ་ལྟར་མ་བྱས་ན་ལུང་པ་གང་ཞིག་ཡིན་ཀྱང་རྣམ་དཔྱོད་དང་དཔའ་རྩལ་སྤྱང་གྲུང་ལྡན་པའི་མི་མེད་པར་བརྩི་བ་དང་།",
    "གང་ལ་རོགས་སྐྱོར་དང་ནུས་པ་འདོན་པའི་ཁ་ཕྱོགས་མེད་ལ་ཤེས་མེད་ཀྱི་ལུང་པ་ཞིག་ཡིན་པར་ཆགས་འགྲོ།",
    "ནང་བཞུགས་ལྷ་སྐུའི་རྒྱུ་ཆ་དང་།",
    "ཕྱག་བསྐོར་དང་མ་ཎི་བཅས་གཅིག་པུས་ཆོག་ཤེས་མ་བྱེད་པར།",
    "དཔལ་བཟང་རག་ཤིས་ལྷ་སྲོན་གསུམ།",
    "ནགས་སོག་ཤག་གསུམ་ས་བཅད་ཕུལ་ཞེས།",
    "ཡུལ་འཛིན་ཤེས་ན་བཙན་པོའི་རྒྱུད་ཡོང་གསུངས།",
    "ང་འདྲ་ཞབས་ཏོག་མུས་ཀྱི་གྱིས་གསུངས།",
    "ཞེས་འཁྲུངས་ལོ་མི་གསལ་ཀྱང་དགུང་ལོ་བརྒྱ་དང་རྩ་བརྒྱད་ཐོབ་པ་ཞིག་ཡིན་པས་སྤྱི་ལོ་༩༦༩ས་སྦྲུལ་ལོར་འཁྲུངས་པར་མངོན་ནོ།",
    "ཡང་འདུན་མ་ཞུ་ཟེར་ནས་ཞུ་བ་བྱས།",
    "ཁོང་ཡོང་དགོས་བྱས་པས།",
    "ཐོད་ལོག་རྡོར་ར་བ་ཚུལ་རྒྱལ་རྣམས་ཀྱིས་འགོ་བྱས།",
    "རིན་ཆེན་རྒྱལ་པོའི་མགོ་བྱས་བཙོན་གཅེས་པ་ཐམས་ཅད་ལ་རྟ་གོས་བསྐོན་ནས་བཏང་།",
    "འབྲི་གུང་བྱང་བོད་ཅེས་པ་ནགས་ཤོད་ཀྱི་དམག་དང་དཔོན་རིན་ཆེན་འོད་བཅས་འབྲི་གུང་པའི་དམག་དང་མཉམ་དུ་ཕེབས་པ་འདིས།",
    "འབྲི་གུང་གདན་རབས་བཅུ་གཉིས་པ་བཤེས་གཉེན་དོན་གྲུབ་རྒྱལ་པོ་ནགས་ཤོད་དུ་ཕེབས་སྐབས།",
    "ཁྱུང་པོ་མུ་ལང་སྐུ་མཆེད་ནི་དབུས་གཙང་སོགས་ལ་བརྟན་མེད་བྱ་བྲལ་གྱི་ཚུལ་དུ་བྱོན་ནས་སྟེང་ཆེན་དང་འདན་ཁོག་སོགས་ལ་གཞིས་ཆགས།",
    "སྟེང་ཆེན་རྨ་མདའ་ཁ་ནས་གསེར་རིའི་གཞུང་དུ་ཕེབས་པ་དང་།",
    "སྤུན་ཁྱུང་པོ་ནང་ཆེན་གྲགས་པ་ལ་གོང་མ་སེ་ཆེན་ཧན་ནས་འཇའ་ས་དང་ཐམ་ཀ་སོགས་དཔག་ཏུ་མེད་པ་གནང་།",
    "ད་ལྟའི་སོག་ཡུལ་གྱི་དེབ་ཐེར་ལ་ལར་དེའི་ཡབ་གསེར་ཁྲི་བ་ཡིན་ཞེས་གྲགས་པ་ནི་གནམ་གྱི་ཁྲི་བདུན་གྱི་ཐ་མ་སྲེབ་ཁྲི་བ་ཞེས་པ་ལ་ནོར་རམ་སྙམ་ཞེས་གསུངས་པ་དང་།",
    "སོག་པོ་ནས་གཙང་ས་སྐྱར་འགྲོ་ཕྱིར་ངོ་འཁོར་རྟ་པ་བདུན་བཅས་ཧོར་སྦྲ་ཆེན་གྱི་སར།",
    "ཁོང་རྣམས་མདའ་དང་རྟ་རྩལ་ལ་འགྲན་ཟླ་བྲལ་བས་ཡུལ་དེའི་དཔོན་བྱེད་ནས་བསྡད།",
    "རྟ་ཕྲལ་ཧོར་ལ་འཇལ་རྒྱུ་བྱས།",
    "རྒྱལ་ལྕགས་གཉིས་ལ་འདུན་མ་བྱས།",
    "ཤུག་ཐུམ་སྒང་ལ་བདེ་ཆེ་བཞག་ཝ་ཕྱི་ཐང་ལ་གནང་བགོས་བྱས།",
    "མཚོ་སྔོན་བཅའ་སྡོད་བཅས་ཀྱིས་བཀའ་བགྲོས་ནས་དེ་ལྟར་ཚོ་བ་བདུན་བཅུ་དོན་དགུ་དེ་གཅིག་གྱུར་བྱེད་ན་གྱེན་ལོག་ཡོང་བའི་ཉེན་ཁ་ཆེ་བས་དོག་ཟོན་བྱས་ནས།",
    "ཥྛ་ཞེས་པའི་དཔོན་མིང་རིམ་པར་བྱུང་བས་འདི་ནས་བཟུང་རྒྱ་དུས་ཞེས་འབོད།",
    "ཧོར་རྒྱལ་པོ་ཁྲི་རྒྱལ་རྗེ་ལྷ་སྐྱོང་ཁྲི་བཞུགས་བཅུ་གཅིག་པའི་སྐབས།",
    "མདའ་དཔོན་གནང་བྱུང་བ།",
    "མེ་འབྲུག་ཞིབ་གཞུང་བྱ་བའི་དུད་རྩིས་བྱས་ནས་ས་ཚུགས་སྐྱེལ་འདྲེན་དང་མི་ནོར་ས་ཞིང་ལ་ཞིབ་རྩིས་ཀྱི་ཁྲལ་འགེལ་བའི་ལམ་ལུགས་གསར་དུ་གཏོད།",
    "སྦྲ་ཆེན་ཧོར་རྒྱལ་བཞུགས་ཡུལ་ཡིན་པ་དང་།",
    "ཧོར་སྤྱི་རྣམས་ཀྱི་སྤྱོད་པ་ཅུང་ཙུབ་པ་དང་དམངས་སེམས་ལ་བསྟུན་མ་ཤེས་པས་ཧོར་སྤྱིའི་ལམ་ལུགས་མེད་པར་བྱས།",
    "ཧོར་ག་རྒྱ་དཀོན་རྒྱལ་ལྷ་སར་འགྲོ་སྐབས་ཉང་གཞུང་ནས་རྟ་གཉིས་སྐུ་ཤོར་བས་དཔོན་ལ་ཞུས་ཀྱང་སྟབས་མ་བདེ་བས་གནས་ཚུལ་ཐག་གཅོད་མ་ཐུབ།",
    "སྲས་ནོར་བུ་མ་བྲོས་པར་མེ་མདའི་རུ་ཕབ།",
    "ག་རྒྱ་ནས་ཐེ་ཚོམ་མེད་པར་རྒྱབ་པས་ལྕམ་གྱི་ནུ་མ་གཤག་ནས།",
    "སླར་ཡང་གཞི་མཐུན་གྲོས་བསྡུར་གནང་།",
    "དེ་ནས་གནས་འདིར་སྡོད་མ་བདེ་བར་གནས་སྐབས་བྲོས་བྱོལ་དུ་ཕེབས།",
    "དཔའ་རྩལ་ཆེ་བས་ཀུན་གྱི་བཀུར་ཞིང་དཔོན་གནས་ཡང་ཐོབ་ནས་ལོ་དྲུག་བསྡད།",
    "བརྒྱ་དཔོན་ལྷ་ནམ་དང་ལྡིང་དཔོན་དཔལ་བཟང་རབ་བརྟན་གཉིས་ཀྱིས་གྲོས་བཟང་འོག་ནགས་ཤོད་ཚོ་དགུ་གཅིག་གྱུར་ཐོག་འགོམ་སྐྱེན་པ་སྤུན་གཉིས་གདན་འདྲེན་མ་ཐུབ་ན་ནགས་ཤོད་ཚོ་དགུ་གནས་ཐབས་མེད་པའི་གཞུང་བཏུགས་གནང་བས།",
    "དེ་དོན་མངོན་གྱུར་བྱུང་ནས་ནགས་ཤོད་ནས་འབྲི་ཐུལ་མ་བརྒྱ་དེམ་ཆི་ལ་སྤྲད་ནས་རང་ཡུལ་དུ་ཕེབས།",
    "ལྡིང་དཔོན་བཟང་རབ་བརྟན་ལོ་ལྔ་བཞུགས་ནས།",
    "འགོམ་དཔོན་ནས་ང་ཕ་ཡུལ་ནས་ཡོང་དུས་ས་ཐག་རིང་པོ་མཐོང་བྱུང་བས་དེ་དོན་གནས་མི་ཐུབ་པར་གསུངས་པས།",
    "བོ་ངན་གཡང་ལྷའི་མི་སྟོང་རྣམས་ཆད་ལུས་མེད་པར་ཁྱིམ་དུ་སྤྲད།",
    "ཁོང་ལ་སྲས་གཉིས་ཡོད་པ་ད་ལྟ་བཞུགས།",
    "སྔགས་དགོན་རི་ཁྲོད་མང་བར་བཞུགས།",
    "ཕ་ས་ཞེས་གཙོ་བོ་རྒྱུད་འཛིན་སྲོལ་ཤུགས་ཆེ་བས་རིག་གསར་བར་མ་ཉམས་པར་གནས་ཡོད།",
    "དེ་ནས་དུད་ཆུང་འགའ་དང་བཅས་རིམ་པར་ཡུལ་འབྲོག་གཉིས་སུ་བྱེ་བ་མང་དུ་ཕྱིན་ནས།",
    "ཕན་ཚུན་ཤ་ཉེ་རུས་ཐོག་རྣམས་མ་འདྲེས་པར་གནས་ཐུབ་པ་འདི་བོད་སྔ་རབས་པའི་སྤྱོད་སྲོལ་མ་ཉམས་པའི་རང་རྟགས་ཡིན།",
    "སྤྱི་ལོ་༡༩༦༥ལོར་ཟླ་༡༡པར་ཏང་ནང་ཞུགས།",
    "དེ་ནས་སྤྱི་ལོ་༢རྐྱརྐྱ་༡ལོའི་ཟླ་བ་རྡོཔ་ནས་སྤྱི་ལོ་༢༡ལོའི་ཟླ་བ་༡རྐྱབར་ཀྲུང་གོའི་རྩོམ་པ་པོའི་མཐུན་ཚོགས་ཀྱི་ཏང་ཙུའུ་ཧྲུའུ་ཅི་གཞོན་པ་དང་ཀྲུང་གོའི་རྩོམ་པ་པོ་མཐུན་ཚོགས་ཀྱི་སྐབས་དྲུག་པའི་ཀྲུའུ་ཞི་གཞོན་པ་གནང་།",
    "སྐྱེན་པ་བརྒྱ་དཔོན་པད་དར་བཅས་རིམ་པར་བྱུང་།",
    "འགོམ་ལེང་དྲུག་ལས་ཤག་ཉང་ཁུ་གཞུང་ཞེས་འགོམ་དཔོན་ཚང་དང་།",
    "སྤྱི་ལོ་༡༩༥༩ལོའི་ཟླ་བ་༧པར་ལས་ཀར་ཞུགས།",
    "དེ་ནས་སྤྱི་ལོ་༡༩༧༥ལོའི་ཟླ་བ་རབར་ཀྲུང་གུང་བོད་ལྗོངས་ནག་ཆུ་ས་ཨུད་ཀྱི་ཧྲུའུ་ཅི་བྱས།",
    "ཁྱིམ་ཚང་གཞུང་བཞེས་འཐབ་རྩོད་སོགས་དཀའ་སྡུག་སྣ་ཚོགས་མྱང་།",
    "སྤྱི་ལོ་༡༩རྡོ་༦ལོར་ལྡིང་དཔོན་གྱི་ཚ་བོ་ཚེ་རིང་དོན་གྲུབ་འབྲི་རུ་སྲིད་གྲོས་ཨུ་ཡོན་དུ་ལས་གནས་བསྐྱར་གསོ་གནང་།",
    "འཁོར་མང་བཅས་ཀྱི་ས་མདུད་དུ་བསྡད་ནས་རིམ་པར་ཆགས།",
    "གྲྭ་ཁྲལ་འགོམ་དགོན་དུ་ཡིན་པས་ཕྱོགས་གཞན་ལ་སྒྲུབ་སྲོལ་མེད་པས་རིག་གསར་གོང་དུ་འདུས་གྲྭ་བཅོ་ལྔ་ཙམ་རང་དགོན་དུ་བཞུགས།",
    "དུད་ཁ་ཤས་ཙམ་ལས་རིམ་པར་དཀར་གཞུང་དུ་སྤོས་ནས་ད་ལྟ་བར་གནས།",
    "ཡར་ཆབ་གཙང་པོའི་འགོ་མ།",
    "དབུས་སུ་ཡུལ་ལྷ་ཇོ་བོ་དཔལ་དཀར་ཞེས་རྩ་རི་ཆགས་གྲབ་བྱས་ཟེར་སྨྱུག་མ་དང་།",
    "ལོ་ལྟར་འགོམ་བླ་གྲྭ་རྣམས་ཕེབས་ནས་གང་དགོས་སྒྲུབ་རིམ་དང་།",
    "རི་ཕུག་དགོན་ཡང་བཀའ་བརྒྱུད་ཡིན་པར་སེམས་ལ།",
    "གངས་ཅན་ལམ་རིམ་མངའ་བདག་སྣེའུ་ཟུར་པར།",
    "ཁོང་ནི་རབ་བྱུང་དང་པོའི་ཆུ་རྟ་ལོ་སྤྱི་ལོ་༡༤༢ཇོ་བོ་རྗེ་མངའ་རིས་སུ་ཕེབས་པའི་ལོ་དེར་སྤྲས་སྣེའུ་ཟུར་གྱི་ས་སྐོར་ཐང་པ་ཞེས་བྱ་བར།",
    "དེར་ལོ་འགའ་བཞུགས་ནས་སྟོན་པ་ཤཱཀྱ་ཚུལ་གྱིས་ཞུས་ཏེ།",
    "ཇོ་བོ་ཆེན་པོའི་མན་ངག་རྣམས་རྫོགས་པར་ཞུས་ནས་མཐིལ་ཕྱིན་པ་ཞིག་བྱུང་ན་ཅི་མ་རུང་སྙམ།",
    "ཚོགས་གཉིས་རྫོགས་བྱེད་གཏོར་མ་གཉིས་གནང་ནས་ཟླ་ཕྱེད་ཙམ་བསྐྱངས།",
    "དེ་ནས་ཚིག་ཉུང་དོན་བསྡུས་ཇོ་བོ་རྗེས་འདི་ལྟར་གསུངས་ཞེས་སྐྱེས་བུ་གསུམ་གྱི་ལམ་རིམ་རྣམས་ལེགས་པར་སྦྱངས།",
    "བོད་ཀྱི་སྲུང་བའི་སྐོར་ཐམས་ཅད་ཕྱོགས་གཅིག་ཏུ་བཞུགས་པ་བས།",
    "ངའི་དམིགས་པ་སྐོར་གསུམ་གྱིས་མཛེ་ཕོ་སོས་པ་མང་བ་ཡིན་གསུངས།",
    "ཕྱག་གཅིག་མཉལ་སྨད་གསེར་ཕྱེ་འབུམ་པའི་ནང་དུ་བཞུགས།",
    "ཕྱིས་སྣེའུ་ཟུར་བའི་ཞབས་ལ་མཇལ་ནས་ལོ་དགུ་བསྡད།",
    "གཅིག་རིན་ཆེན་སྒང་གཙུག་ལག་ཁང་བྱང་སེམས་སྐལ་ལྡན་ཤིང་རྟའི་སྐྱེ་བ་ཡོད་པ་དེ་ལ་སྤྲོད་གསུངས་པ་བཞིན་ཕུལ།",
    "ཤིང་རྣམས་གེགས་མེད་པར་རིན་ཆེན་སྒང་དུ་དྲངས།",
    "སྐུ་འབུམ་ཞེས་ནང་བཞུགས་བྱིན་ཅན་དང་ཁ་གྲངས་མང་ཤོས་ཀྱི་མཆོད་རྟེན་ཞིག་ལ་གོ་དགོས་པ་ལས།",
    "མཆོད་རྟེན་ལས་ལོགས་སུ་གྱུར་བའི་འབུམ་པ་ཞིག་ཡོད་པར་མི་སེམས།",
    "སྔོན་ཇོ་བོ་རྗེས་གླང་ཐང་དུ་དགེ་སྦྱོར་མཛད་ནས་ས་ཙྪ་གྲངས་མང་བཏབ་ནས་བཞུགས་སུ་གསོལ་བའི་མཆོད་རྟེན་ཞིག་བཞེངས་པར་ནང་བཞུགས་གཟུངས་རྫས་མང་བས་འབུམ་པ་ཞེས་བོད་གངས་ཅན་ལྗོངས་སུ་འབུམ་པ་དང་པོ་དེ་བཞེངས་པས་འབུམ་དང་ཞེས་མཚན་ཆགས།",
    "བོད་ཀྱི་སྔ་སྲོལ་མཆོད་རྟེན་ཁག་གཅིག་དེ་དང་མཚུངས་པར་རྨང་དགེ་ལས་སེང་ཁྲི་མེད་པ་དང་།",
    "བུམ་པ་ཡང་འདུམ་པོ་པར་གཟུགས་ཤ་སྟག་ཡིན།",
    "འབྲི་གུང་ཐེལ་གྱི་གདུང་འབུམ་སོགས་མཆོད་རྟེན་ཁག་མཇལ་བ་ཏྲེམ་གྱིས་ཤེས་པར་ནུས།",
    "དེ་རྗེས་སུ་བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པས་ཆུ་ཞིང་ལས་མ་བརྒལ་བར་མཆོད་རྟེན་གྱི་ཐིག་རྩ་ཅུང་བདེ་བར་བཞེངས་ནས་ས་ཁྱབ་རྡོ་ཁྱབ་དུ་གྱུར།",
    "ཤེལ་དཀར་མཆོད་རྟེན་ནི་ད་ལྟ་འགྲོ་བ་ལྷ་མི་ཀུན་གྱི་མཆོད་གནས་སུ་བཞུགས།",
    "སྔོན་འདིའི་སྐོར་དུ་མཆོད་རྟེན་ཆ་བརྒྱད་ཡོད་པར་བཤད།",
    "འབུམ་པའི་ཡར་རི་འགུལ་དེར་མཆོད་རྟེན་ཆ་བརྒྱད་ཀྱི་རྗེས་ཤུལ་བུམ་པའི་ཞབས་ར་ཡང་ད་ལྟ་བསྡད་ཡོད་པས་ཀུན་གྱིས་སྲུང་སྐྱོབ་བྱ་དགོས་པའི་རིག་དངོས་ཤིག་ཡིན།",
    "ཞབས་རྗེས་དེ་ཉིད་རིག་གསར་སྐབས་སྲུང་སྐྱོབ་བྱ་ཕྱིར་སྐུ་གདུང་དང་མཉམ་དུ་མེ་འབར་དུ་དབོར་བས་ད་ལྟ་མེ་འབར་སྒྲུབ་ཕུག་དུ་བཞུགས་ཡོད།",
    "ཚེ་ཡི་བར་ཆད་སེལ་བའི་ཉེར་གཅིག་བསམ་པའི་དོན་ཆེན་འགྲུབ་པར་མཛོད་ཅིག་ཅེས་པའི་ཚིག་བཅད་ཡང་བརྩམས་པས་རྗེས་སུ་སྒྲོལ་མ་ལྷ་ཁང་ཞེས་འབོད།",
    "བ་ལག་འབུམ་པར་ཟླ་བ་དང་པོའི་ཚེས་བཅོ་ལྔ་ལ་དར་ཆེན་སློང་བའི་ཐེབས་རྩ་དང་།",
    "རང་དགོན་ནས་འབུམ་པའི་ལྷ་གཉེར་རྒྱུན་བཞུགས་བཅས་ཡོད།",
    "དེ་ལྟར་རྟེན་དང་བརྟེན་པ་བཅས་པ་གཙང་བཤིག་བྱས་པ་དང་།",
    "འབུམ་པའི་ནང་བཞུགས་ཀྱི་གཟུངས་རྣམས་མ་ཉམས་པར་གནས་ཤིང་།",
    "གནས་བདག་རྣམས་ཀྱིས་སྲུང་སྐྱོབ་བྱས་པའི་རྟགས་དང་།",
    "ས་རྡོ་ལ་འགུལ་ཙམ་ཞིག་གནང་ནས།",
    "བཀའ་སྲུང་རྣམས་ལ་འཕྲིན་བཅོལ་དང་ཐུགས་སྨོན་བཅས་གནང་པས་ཉེར་འཚེ་མེད་པར་རིམ་བཞིན་གྲུབ།",
    "ཡེ་དྷར་རྟེན་བཞུགས།",
    "སྐུ་འདྲ་སྣ་ཚོགས་བཅས་མང་པོ་བཞུགས།",
    "ནང་བཞུགས་རྟེན་གཙོ།",
    "ཚེམས་བཅས་བཞུགས་པ་དང་།",
    "སྟག་ཕུ་པདྨ་བཛྲ་གྱི་དབུ་ཐོད་ཨ་རང་བྱུང་བཅས་བཞུགས།",
    "སྦྱིན་བདག་བསྟན་འཛིན་རྒྱལ་མཚན་ནས་ཁུར་བླངས་ཏེ་རབ་གནས་ལེགས་པར་གྲུབ།",
    "གཡས་སུ་བཤེས་གཉེན་དོན་གྲུབ་རྒྱལ་པོའི་ལྷ་ཁང་ཉམས་གསོ་ཞུས་ནས་རྟེན་གཙོ་རྗེ་ཉིད་ཀྱི་སྐུ་བཅས་བཞུགས།",
    "དེའི་ཕྱི་ལོ་ནང་བཞུགས་ལྷ་རྟེན་རྣམས་ཀྱང་བཞེངས་གྲུབ།",
    "ཤེལ་རྩེ་འབུམ་པར་མཇལ་ཁ་ཞུས།",
    "ཤེལ་རྩེ་འབུམ་པ་གདན་འདྲེན་དང་འབུམ་པར་ཁྲུས་གསོལ་དང་རབ་གནས་གནང་།",
    "གསང་སྔགས་རྗེས་སུ་འཛིན་མ་བཅས་གྲྭ་ལྔའི་ལྷ་ཚོགས་བཞུགས་པས་རྒྱལ་ཁམས་སྤྱི་དང་ཡུལ་ཕྱོགས་འདིར།",
    "རྗེ་ཙོང་ཁ་པ་བཅས་བཞུགས།",
    "ཟླ་བ་དགུ་པའི་ཚེས་བཅུ་ལ་རབ་གནས་རྒྱས་པར་རྗེ་ཉིད་ཀྱིས་འབུམ་པ་དང་མཉམ་དུ་མཛད།",
    "ཚེས་བཅུ་གསུམ་ལ་བསྙེན་གནས་སྨྱུང་གནས་གྲལ་འཛིན་དང་བཀའ་ཁྲིད་བཀའ་ལུང་གནང་།",
    "གཟུངས་ཞུགས་ལ་སྔོན་གྱི་སྐྱོབ་པའི་གཟུངས་དབྱིབས་ཁྱད་པར་ཅན་དེ་བཞུགས།",
    "སྨྱུང་གནས་ཉེར་འཁོ་ཆ་ཚང་བཅས་བཞུགས།",
    "དགོན་རྙིང་དགོན་གསར་དུ་སྤོ་སྐབས་གསུངས་བྱོན་ནས་ང་མི་འགྲོ་འགྲོ་དོན་གནས་འདིར་ཡོད་གསུངས་པས་གཞག་པ་ཞིག་ཡིན།",
    "གནས་ཀྱི་ཕན་ཡོན་སོགས་རྒྱས་པར་ནི།",
    "མཐར་ཐུག་རྣམ་མཁྱེན་རྒྱལ་བའི་གོ་འཕང་དམ་པར་བགྲོད་པར་གསུངས།",
    "རྡོ་བརྐོས་ཅུང་ཆེ་བ་དེ་ནི་རབ་བྱུང་བཅུ་གཅིག་པའི་ནང་དུ་བྱུང་བའི་གཏེར་སྟོན་པ་གྲྭ་སྒོམ་ཞིག་པོ་བཛྲ་ཞེས་པ་གནས་འདིར་ཕེབས་པ་དང་།",
    "གནས་འདིར་ཕེབས་པ་ཡིན།",
    "རིག་མ་དེ་ཉིད་མཁའ་འགྲོ་མ་ཡིན་པར་གསུངས།",
    "གཙོ་ཆེར་སེར་བཀྲ་ཤིས་སྟེང་དུ་བཞུགས།",
    "རབ་བྱུང་བཅུ་གཉིས་པའི་ནང་དུ་མེ་འབར་སྒྲུབ་ཕུག་ཏུ་གནས་འབྲེལ་དུ་ཕེབས་སྐབས།",
    "བ་ལག་འབུམ་པར་གནས་འབྲེལ་དུ་བཞུགས་པའི་ཉམས་སྣང་རྡོ་ལ་བཀོད་པ་ཡིན་ཏེ།",
    "འགོམ་བ་ལག་དགོན་དུ་ཕྱག་ཕེབས་ནས་བཞུགས།",
    "དེ་རྗེས་ནགས་ཤོད་ཤུག་ལྡིང་དགོན་རྣམ་རྒྱལ་ལྷ་རྩེ་རུ་སྐྱོབ་པ་འཇིག་རྟེན་གསུམ་མགོན་གྱིས་གཙང་དགོན་དུ་བསྒྱུར་བ་དང་།",
    "ས་ཆ་ཡང་ཕུལ་བས་རྗེ་སྐྱོབ་པ་ཉིད་གནས་འདིར་ཕེབས་པར་སེམས།",
    "མཁན་ཆེན་སྤྱན་སྔ་འབར་ནས་ལམ་སྣ་བྱས་ཏེ་རྗེ་སྐྱོབ་པ་འབྲི་གུང་དུ་གདན་དྲངས།",
    "དེ་ནས་བཟུང་དམ་ཚིག་གཙང་ཞིང་ཐུགས་ནང་དག་པས་འབྲེལ་བ་ཟབ།",
    "རླངས་ཀྱི་པོ་ཏི་བསེ་རུ་ལྕགས་པར་ཤོག་གྲངས་༢༢༥ལས།",
    "བར་འདུམ་བྱ་བ་བཅས་ལ་ཕེབས་པས་འདུམ་པ་བྱུང་བས་དེ་སྐབས་འབྲི་གུང་ཁྲི་སྐོར་གྱི་སྟོབས་ཤུགས་གཙོ་བོ་ཞིག་ནི་ནགས་ཤོད་པ་ཡིན།",
    "ལྷ་བབས་སྐྱུ་རའི་གདུང་རབས་དྲི་མ་མེད་པ་ཆད་པར་དོག་སྟེ།",
    "མཚན་ལྡན་རིག་མ་ཁབ་ཏུ་བཞེས་པས་བདག་པོ་ཝང་འཁྲུངས།",
    "ལས་བཞིའི་འཕྲིན་ལས་སྒྲུབ་པའི་ས་བཅད་ཕུན་སུམ་ཚོགས་པ་ནགས་ཤོད་འགོམ་བ་ལག་དགོན་གྱི་གནས་གཞི་རུ་ཕེབས།",
    "ཅུང་ཟད་ཐེན་ནས་འབུལ་བ་བཞེས་པར་ཞུ།",
    "ད་ནི་ཐུན་ཚོད་ལས་ཡོལ་བས་ཐམས་ཅད་སོ་སོའི་བྱ་བ་རྣམས་གྱིས་ཤིག་གསུངས་བཞིན་དུ་ཕྱག་སོར་བསྡུས་པས་ཉི་མ་ཡང་བཙན་ཐབས་སུ་བྲོས་པ་ལྟར་གྱུར་ཏེ།",
    "རྗེ་ཉིད་ལམ་བར་དུ་ནགས་ཤོད་ལུང་པར་རང་དགོན་ཁག་དང་ལྷག་པར་ཤུག་ལྡིང་དགོན་དུ་ཕེབས།",
    "རང་སྲིད་མི་ཉམས་པར་སྐྱོང་ཞིང་།",
    "སྟག་ལུང་ལྷ་ཁང་དམར་འགྱེད་ཀྱི་ཤིང་ཆ་ནགས་ཤོད་ཀ་རོང་སྟོད་ནས་དབོར་བའི་བཀའ་གནང་།",
    "བཀའ་གདམས་པའི་དགོན་ཆེན་གྱི་རི་ཁྲོད་བསམ་གཏན་པ་བཞུགས་གནས་ཁག་ཅུང་ཉམས་ཀྱང་།",
    "ཕྱིར་ཕེབས་ཚེ་ཕྱི་ལྟས་མཛད་པས་གཡུལ་སར་སྐྱེ་བོ་མང་པོའི་ཕུང་པོ་དང་གྲོད་པ།",
