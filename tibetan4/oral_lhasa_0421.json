    "དེ་ནས་འབྲི་གུང་དུ་ཕེབས་ནས་སྐྱབས་མགོན་པདྨའི་རྒྱལ་མཚན་གྱི་ཞབས་ལ་གཏུགས་པ་དང་།",
    "ཁྲོ་བ་ཙམ་ཡང་མི་བྱེད་པར་ཡར་བསྣབས།",
    "ཡ་ཧོ་བཟོད་པ་སོགས་ནས་བརྟན་བཞུགས་ཁྲི་གསོལ་འབུལ་ཞབས་བསྟར།",
    "སྐྱབས་མགོན་དགུང་ལོ་སུམ་ཅུ་ལྷག་ཏྲེམ་ལས་མ་བཞུགས་པས་རང་དགོན་དུ་གདན་འདྲེན་ཞུ་མ་ཐོབ།",
    "རྗེ་ཐུགས་རྗེའི་ཉི་མ་དབུ་ཉེས་མཇུག་མའི་སྐབས་འབྲི་གུང་དུ་བཞུགས་མ་སྤྲོ་བར་སྒམ་པོར་ཕེབས།",
    "ཀོང་སྤྲུལ་རི་ཁྲོད་རྣམས་སུ་ལོ་ཤས་བཞུགས།",
    "ཡབ་ཡུལ་ལུང་པ་གཅིག་ཡིན་པས་སྣེ་ལེན་དང་འགོ་འདྲེན་བཟང་པོར་གནང་།",
    "ཧབ་ཧ་མེ་འོད་འཁྱིལ་ཆེན་གྱིས་མི་མིན་ལྷ་འདྲེ་བཟུང་ནས་བཀའ་བསྒོ་བ་སོགས་རྫུ་འཕྲུལ་ཤིན་ཏུ་མང་བར་གསུངས་ཀྱང་།",
    "རབ་ཏུ་བྱུང་ནས་རང་དགོན་ཏུ་སྒྲིག་བཞུགས་མཛད།",
    "རང་དགོན་དུ་ཕེབས་ནས་ཀ་མཆོག་དང་།",
    "རྒྱ་ཕུག་སོགས་སུ་སྒྲུབ་པར་བརྩོན།",
    "འབྲི་གུང་དུ་གདན་དྲངས་ནས་རིག་པའི་གནས་ལ་སྦྱངས་བརྩོན་གནང་འགོ་ཚུགས།",
    "ཕྱི་ནང་འགལ་རྐྱེན་སྣ་ཚོགས་ལ་བརྟེན་ནས་རྗེ་ཉིད་ཁྲིར་ཟུར་ནས་གཙང་སྲད་རིན་ཆེན་སྒང་དུ་ཕེབས་དགོས་བྱུང་།",
    "ནག་ཆུ་སོགས་བརྒྱུད་ནས་ལོ་འབྲོང་ངུར་དགོན་དུ་ཞབས་སོར་འཁོད་ནས་ལུང་ཁྲིད་རྒྱས་པར་བསྩལ།",
    "གནས་འདིར་བཀའ་བརྒྱུད་པའི་བསྟན་པ་ཉི་མ་ཤར་བ་ལྟར་གནང་།",
    "དགོན་སྤྱི་ལ་ཕྱག་གནང་དང་བཅས་ཆིབས་བསྐྱོད་གནང་།",
    "བ་ལག་འབུམ་པར་དྲི་མེད་མཆོད་རྟེན་དང་ཚེས་བཅུ་ལྷ་ཁང་།",
    "རོང་པོའི་ཚེས་བཅུ་ལྷ་ཁང་དང་མཆོད་རྟེན་བཞེངས་ནས་སྐུ་ཚེ་སྨད་དུ་རོང་པོའི་ཕྱོགས་སུ་བཞུགས་ཡུན་རིང་།",
    "རང་དགོན་དུ་སྒྲིག་བཞུགས་མཛད།",
    "ལྡེང་རྒྱལ་དུ་ཕེབས་ནས་སྒྲུབ་པ་ཉམས་ལེན་མཛད་ནས་སྐུ་ཚེ་གང་པོ་དེར་བཞུགས།",
    "ད་ལྟ་འབྲི་གུང་སྒྲུབ་གྲྭའི་སློབ་དཔོན་སོ་བདུན་པ་དགེ་སློང་བཀྲ་ཤིས་རབ་བརྟན་མཆོག་རྗེ་འདིའི་ཡང་སྲིད་ཡིན་ཞེས་གསུངས།",
    "རང་དགོན་དུ་ཕེབས་ནས་སྤྱི་ཆེན་ཁག་དང་ཞབས་ཞུའི་ལས་གནས་རྣམས་ཡོངས་སུ་ཐོན།",
    "རྗེ་ཉིད་ཚུར་ཕེབས་པས་སྐུ་ཁམས་མ་བདེ་བ་ཅི་ཡང་མ་བྱུང་།",
    "རང་དགོན་དུ་ཕེབས་ནས་ཐེམ་སྤངས་འདག་སྦྱར་གྱི་ཚེ་མཚམས་སུ་བཞུགས།",
    "མ་འོངས་པ་ན་རྒྱུ་ཆེན་པོ་འོངས་གསུངས་པ་དང་།",
    "གདུང་རྟེན་གང་ཡང་མ་བཞེངས་གསུངས་ཀྱང་།",
    "རྗེ་ཉིད་ཀྱི་དབུ་ཐོད་ད་ལྟ་རང་དགོན་དུ་བཞུགས།",
    "ཉིན་གསུམ་ལ་ཐུགས་དམ་བཞུགས་པས་ཞལ་མདངས་སྔར་ལས་ལེགས་ཤིང་།",
    "རང་དགོན་དུ་ཕེབས་ནས་རབ་ཏུ་བྱུང་བས་མི་བརྗེད་པའི་གཟུང་ཐོབ།",
    "སྙན་བརྒྱུད་གདམས་པ་འདི་རྣམས་གྲ་མ་ཆག་ཟུར་མ་ཉམས་པར་གནས།",
    "ཤིང་སྤྲེལ་ལོའི་ཆོ་འཕྲུལ་ཟླ་བའི་ཡར་ཚེས་བརྒྱད་ལ་རྒྱལ་ཚབ་ཏུ་མངའ་གསོལ་ནས་གདན་སར་བཞུགས་པས་འཕྲིན་ལས་ཆེ།",
    "ཆུང་དུས་ནས་རང་དགོན་དུ་སྒྲིག་བཞུགས་མཛད།",
    "བཙོན་དུ་ཅུང་སྙུང་བས་ལྷ་དོག་ཡིན་པ་འདྲ་གསུངས།"
  ]
}