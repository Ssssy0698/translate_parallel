    "སྤྱན་སྔ་བ་ལ་སོགས་པ་འཕགས་པའི་དཀྱིལ་འཁོར་ཡོངས་སུ་རྫོགས་ཏེ་ཐ་མལ་བའི་ཁབ་རྩེ་ཙམ་ཡང་འཛུགས་ས་མེད་པ་དེ་ལས་དགའ་སྤྲོ་ཆེ་བ་ཅང་མི་འདུག་སྟེ།",
    "དེ་གསུམ་གས་འཕགས་པ་དང་མི་མཐུན་པའི་ཟག་ཚོར་སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་སྡུག་བསྔལ་གཉིས་དོན་གཅིག་ཏུ་མཛད་འདུག་པའི་ཕྱིར་ཏེ།",
    "ཨ་ཙི་ཨ་ཙི།",
    "སྤུན་ཟླ་ལ་སོགས་པའི་གཉེན་བཤེས་བརྩེ་གདུང་བློར་མི་ཤོང་བའི་རྣམ་པས་ཕེབས་གདའ་བ་དྲིན་དུ་ཆེ་ཞིང་།",
    "རྗེ་ཡབ་སྲས་རྗེས་འབྲང་དང་བཅས་པའི་ལུང་སྣ་ཚོགས་མཐོང་ལོ་ཐོས་ལོའི་ཡན་ལག་ཏུ་མགོ་སྦོས་སྦོས་ཀྱིས་དྲངས་འདུག་པ་ནི།",
    "མཆིམས་མཛོད་ཀྱི་དོན་ལས་ཕྱིས་ཀྱི་ཡིག་གསར་འགའི་སྲོལ་བཞིན་སྡུག་བསྔལ་ལ་ཡིད་བརྟན་བྲལ་བའི་མཁས་འཁྱེར་ཅི་ཡང་བྱས་གདའ་སྟེ།",
    "ཉེར་ལེན་གྱི་ཕུང་པོ་ཚོགས་པའི་རྒྱུན་དང་གང་ཟག་མ་ཡིན་པ་ལ་འཆི་བ་མེད་པར་ཡང་རྣམ་བཅད་དུ་འཕངས་འདུག་པའི་ཕྱིར།",
    "རྒྱུ་འབྲས་མི་མཐུན་པ་དང་འཆོལ་བར་འགྱུར་བའི་དོགས་པ་ཆེ་བཟོ་འདུག་པས།",
    "ཟག་བཅས་ཐམས་ཅད་དེར་འཇོག་པའི་སྒྲུབ་བྱེད་གང་ན་འདུག་མིག་གདངས་ནས་ལྟོས་ཤིག་ཡང་ན།",
    "བྱེད་ན་བློ་བཟང་རང་ཡིན།",
    "བདེན་གཉིས་མཐའ་དཔྱོད་སོགས་ལའང་ཐུགས་ཞིབ་མཛད་དགོས་པར་གདའ་ལགས་ཞེས་ཞུས་ན།",
    "ལེན་པ་པོ་གང་ཟག་ཀྱང་རང་བཞིན་གྱིས་མི་འཁོར་ཞེས་དང་།",
    "དེ་དང་མཚུངས་པར་སྒྲུབ་བྱེད་དུ་བཀོད་པ་གཞན་རྣམས་ཀྱང་རང་མཚང་དམར་པོར་འབྱིན་བྱེད་བསྒྲུབ་པར་བྱ་བ་འབའ་ཞིག་ལས་མ་འདས་ཤིང་།",
    "ལུང་དོན་ཡང་འཇོག་དགོས་པ་མི་གདའོ།",
    "ན་ཆུང་རང་སྣང་འུར་བའི་རྩེར་རྒལ་བ།",
    "ཅེས་པའི་དོན་ལ་རྨོངས་ཏེ་ཅོལ་ཆུང་རང་སྣང་འུར་བའི་སྐྱོན།",
    "གཉིས་འབབ་སྟེ་ཞེས་སོགས་ཡིད་དུ་མི་འོང་བའི་བླ་རྡོལ་སྣ་ཚོགས་བྲིས་འདུག་པ་ལ།",
    "ཁོ་བོ་ཅག་ནས་ཀྱང་རྟོག་འཇུག་རགས་པའི་ཞབས་འདེགས་ཅུང་ཟད་ཞུས་ཞེས་པ་ལྟར་སེ་ཏན་ཡུལ་གྱི་གཞོན་ནུ་རིག་བྱེད་སྨྲ་བ་ཞབས་དྲུང་འཇིགས་མེད་རིགས་པའི་བློ་གྲོས་ཀྱིས་ཀྱང་ཞབས་འདེགས་ནན་ཏན་བྱས་འདུག་པའི་ཕྱིར།",
    "བའང་རྒྱ་ཆེར་བསྒྲིགས་འདུག་པ་མཐོང་ནས་ཁྱབ་པ་འདུ་བྱེད་ཀྱི་དོན་ལ་བཞེད་སྲོལ་འདྲ་མིན་དུ་མ་ཡོད་པ་དང་།",
    "ངག་ཀྱལ་འདི་འབྱུང་ཉེ་ལ་ཉེས་དམིགས་ཤིན་ཏུ་ཆེ་བ་ཞིག་འདུག་པས་གཟབ་དགོས།",
    "མཐོ་དམན་དྲག་ཞན་སུ་ཡིན་ཀྱང་དང་པོར་སྐྱེ་བའི་ཚེ་ཡང་རང་གཅིག་པུར་སྐྱེ་ལ།",
    "ཐ་མར་འཆི་བའི་ཚེ་ཡང་རང་གཅིག་པུར་འཆི་དགོས་ཤིང་།",
    "ལུས་སྦྲེབས་འདར་ཞིང་སྒུར་ནས་གུམ་གུམ་པོར་འདུག་པ།",
    "གཅིག་དུ་བྲལ་གྱི་གཏན་ཚིགས་གཅིག་པུ་སྒོམ་ན་ཡང་བསྒོམ་རྒྱུས་འཕོངས་པ་མི་འདུག་ཅེས་གསུངས་པ་ནི།",
    "སྒོས་ཀྱི་དམ་ཚིག་དུས་འཁོར་གྱི་བརྟུལ་ཞུགས་ཉེར་ལྔ་དང་།",
    "ཞེས་བྲིས་འདུག་པའི་ཕྱིར།",
    "ཁོ་བོའི་ནོར་པ་འབའ་ཞིག་ཏུ་འདུག་པས།",
    "གཟུང་འཛིན་རྫས་དང་བདག་ཉིད་གཅིག་པར་དོགས་ལན་སྔ་མའི་སྒྲུབ་བྱེད་ལས་ཁས་བླངས་འདུག་པས་འདིར་རོ་ལ་གསོད་པར་མི་བྱ་ཞིང་།",
    "དེ་ཡང་རང་བཞིན་དང་མངོན་དུ་གྱུར་པའི་མཐུའོ།",
    "དེ་ཡང་རང་བཞིན་དུ་གནས་པའི་རིགས་སུ་བཞེད་ལ།",
    "ཞེས་སྨྲས་འདུག་པས་ཤེས་ལ།",
    "རྒྱ་བོད་ཀྱི་གཞུང་གང་དུ་འདུག་པ་སྟོན་ཅིག་གཉིས་པ་གྲུབ་སྟེ།",
    "རྒྱ་བོད་ཀྱི་གཞུང་གང་དུ་འདུག་པ་སྟོན་ཅིག་གཉིས་པ་གྲུབ་སྟེ།",
    "བསྒྲུབ་བྱ་རྟོགས་པའི་རྗེས་དཔག་སྐྱེ་བ་ཅིས་ཀྱང་རང་རྒྱུད་ཀྱི་སྦྱོར་ངག་ལ་རག་ལས་པའི་ཕྱིར་ཞེས་སོགས་ཀྱི་དགག་སྒྲུབ་རྒྱ་ཆེན་པོའི་སྒོ་ནས་རྩ་ཤེའི་དོན་རང་རྒྱུད་དུ་འགྲེལ་པའི་ཤིང་རྟའི་སྲོལ་ཕྱེ་བ་ན།",
    "ད་དུང་བོད་ཀྱི་ཕལ་སྐལ་ལབ་ཚུལ་ཡང་ཤེས་མི་འདུག་པས་ཅུང་ཟད་སྦྱང་བར་བྱ་དགོས་ལ།",
    "རྗེ་འཇམ་དབྱངས་བཞད་ཀྱི་གསུང་ཡང་མི་འདོད་བཞིན་དུ་ལུང་རིགས་ཀྱི་མཚོན་ཁར་ཚུད་འགྲོ་བར་ཨེ་འདུག་ཀུན་མཁྱེན་ཆེན་པོའི་གསུང་དེ་དཔལ་ལིའི་ཞེ་འདོད་འགྲུབ་པ་ལ་ཕན་གནོད་ཅི་འདུག་ལེགས་པར་སོམས་ཤིག་དེ་བས་ན།",
    "དེ་ལ་གནོད་བྱེད་སྟོན་རྒྱུ་འདུག་གམ།",
    "འདིར་ཡང་ཀུན་བརྟགས་ཞེས་ར་མགོ་ཅན་དུ་བྲིས་འདུག་སྟེ།",
    "སྒྲོ་སྐུར་སྤངས་པའི་ཚུལ་གྱིས་ཡོད་དོ་ཞེས་གསུངས་ཞེས་སོགས་ཀྱི་དགོངས་པར་འོ་ཆུ་འདྲེས་པ་ལྟ་བུར་འབྱོར་འདུག་པ་བློ་གྲོས་ཀྱི་མིག་ཡོད་ན་བལྟས་ཆོག་ཡིན་པའི་ཕྱིར་རོ།",
    "དགག་སྒྲུབ་ཀྱི་རྣམ་རྟོག་རང་ས་ན་དག་འདུག།",
    "ཞི་གནས་དང་ལྷག་མཐོང་འདམ་ཀ་ནི་མི་འདུག།",
    "འགྱུར་མེད་ཀྱི་བདེ་ཆེན་རང་རིག་ལ་རྫོགས་འདུག།",
