    "བདག་དུས་ཐམས་ཅད་དུ་ཕུན་སུམ་ཚོགས་པར་གྲུབ་པར་གྱིས་ཤིག།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་མ་ལ་མཆོད་ཅིང་ཡོངས་སུ་བསྔོ་སྟེ་དགྱེས་པར་བྱས་ལ་བདག་ཉིད་བཅོམ་ལྡན་འདས་མའི་གཟུགས་སུ་དམིགས་ཤིང་རང་ཉིད་ང་རྒྱལ་དང་ལྡན་པས་ཁྲི་ཕྲག་གསུམ་བཟླས་པ་བྱའོ།",
    "སྐྱིལ་ཀྲུང་དུ་འདུག་སྟེ་ལྟེ་བའི་ཕྱོགས་སུ་བདུག་པར་བྱའོ།",
    "ཅོ་འདུག་གཡུང་ན་གཡུང་པེ་བྱའི།",
    "དེས་ནི་རྐུན་མས་མི་ཚུགས་ཏེ་བཅིངས་ནས་རྨོངས་ནས་འདུག་གོ།",
    "ཆུའི་ནང་དུ་འདུག་ན་ནི་དྲན་པར་བྱའོ།",
    "གཅན་གཟན་ཁྲོ་བོའི་ནང་ན་འདུག་ན་ནི་གོས་ཀྱི་མཐའ་མར་མདུད་པ་བོར་རོ།",
    "ཨ་ཙིནྟ་གོ་ཙརྱ།",
    "ཨ་ཙིན་ཏྱ་བེ་ཤཱ་ནཱི།",
    "སརྦ་ཏ་ཐཱ་ག་ཏཱ་སུ་ག་ཏ་བ་ར་བ་ཙ་ན།",
    "སརྦ་ཏ་ཐཱ་ག་ཏཱ་སུ་ག་ཏ་བ་ར་བ་ཙ་ན།",
    "སརྦ་ཏ་ཐཱ་ག་ཏ་སུ་ག་ཏ་བར་བ་ཙ་ན།",
    "ལྷའི་བུ་འདིས་འགྲོ་བ་བདུན་པོ་གང་དག་མྱོང་བར་འགྱུར་སྙམ་དུ་སེམས་ཤིང་ཅང་མི་སྨྲ་བར་འདུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་ནས་ལྷའི་བུ་ཤིན་ཏུ་བརྟན་པའི་འགྲོ་བ་བདུན་པོ་དག་བཅོམ་ལྡན་འདས་ལ་ཞིབ་ཏུ་གསོལ་ཏོ།",
    "སརྦ་ཏ་ཐཱ་ག་ཏ་སུ་ག་ཏ་བ་ར་བཱ་ཙ་ན།",
    "སུ་ག་ཏ་བ་ར་བ་ཙ་ནཱ་མྲྀ་ཏཱ་བྷི་ཥེ་ཀེ་རྨ་ཧཱ་མུ་དྲཱ་མནྟྲ་པ་དེ།",
    "བེ་རོ་ཙ་ནཱ་ཡ།",
    "བདག་ཉིད་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་དྲུང་ན་འདུག་པར་ཤེས་ཤིང་།",
    "ཞལ་དྲུག་སྐྲ་ཡང་ཁམ་པར་འདུག།",
    "རང་རང་རྟགས་ཀྱི་བསྐུལ་ན་ནི།",
    "བརྟན་པར་འདུག་ལ་ལེགས་པར་བཟླས།",
    "དེ་ནས་ལྷོ་ཕྱོགས་སྒོར་འདུག་སྟེ།",
    "མཚན་མ་བསྟན་ཅིང་འདུག་ནས་ནི།",
    "ཙ་ན་ཀ་ཡི་འབྲུ་ཚད་ལ།",
    "བདག་དང་རང་ནི་ནོར་བཅས་པ།",
    "བྱས་ནས་དེ་ཡི་མདུན་འདུག་སྟེ།",
    "མི་ཐོད་ནང་དུ་འདུག་པ་ཡི།",
    "འདུག་ཅིང་གང་དུ་འདོད་པར་འགྲོ།",
    "ཞགས་པ་གང་ན་འདུག་པ་དེར།",
    "དཔག་ཚད་བརྒྱ་ན་འདུག་པ་ཡང་།",
    "ཡིད་ཀྱིས་པདྨོའི་སྟན་ལ་འདུག།",
    "ཀུ་ཤའི་སྟན་ལ་འདུག་ནས་ནི།",
    "རང་རང་ལུགས་ནི་ཇི་ལྟར་བསྒྲུབ།",
    "རང་རང་ལས་རྣམས་གང་ལ་དགའ།",
    "བརྒྱལ་བ་སངས་པ་ན་སུ་ཡང་མི་འདུག་པས།",
    "སྐྱེས་བུ་དམ་པ་གཉིས་པོ་འགྲོ་བའི་ལམ་དུ་འདུག་ནས།",
    "བེ་རོ་ཙ་ན་སོགས་པཎྜི་ཏ་དང་།",
    "འདུག་གམ་གསུངས།",
    "ཡང་པཎ་ཆེན་དེ་ལ་རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀྱི་སྤྲུལ་པ་ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ནས་རྫོགས་པ་ཆེན་པོའི་གདམས་པ་ཡོངས་སུ་ཚང་བར་གསན་ནས་བོད་ཡུལ་འདིར་དར་རྒྱས་སུ་མཛད་པ་ཡིན་ཏེ།",
    "པཱ་ཀོར་ཧེ་འདོད་ཀྱི་བུ་བེ་རོ་ཙ་ན་བྱ་བ་མཁྱེན་པ་ཡངས་ཤིང་རྫུ་འཕྲུལ་ཆེ་བ་དེ་དང་།",
    "འདི་རང་ན་ཡང་རང་དགར་སྤྱད་དུ་མེད།",
    "བེ་རོ་ཙ་ནས་སླར་ཡང་ནན་གྱིས་ཞུས་པས།",
    "དེ་ནས་ཤྲཱི་སིངྷས་བེ་རོ་ཙ་ན་ལ།",
    "དེའི་རྗེས་ཁྲི་སྲོང་ལྡེའུ་བཙན་གྱི་སྐབས་བེ་རོ་ཙ་ནས།",
    "དེ་བཞིན་དུ་བེ་རོ་ཙ་ན་དང་ཤྲཱི་སིངྷ་དུས་མི་མཚུངས་སྙམ་པའི་དོགས་པ་ཡང་མི་བྱ་སྟེ།",
    "གཞན་དུ་དེ་བཞིན་ཅི་ལ་འབྱུང་ཞེས་ཞུ་བ་བྱུང་འདུག་ཅིང་།",
    "གཞན་དུ་དེ་ཙམ་མི་ཡོང་འདུག་པ་དགོད་བྲོ།",
    "ངའི་རྨི་ལམ་ན་ཕྱག་ནའི་རི་ཡིན་ཟེར་བ་གཉིས་ལས་མི་འདུག།",
    "སོ་དྲུག་པ་ལ་གོང་མ་རྒྱལ་པོས་ཁྱེད་འཕགས་པ་ཏྲི་ཤྲཱི་དབོན་པོ་ཡིན་ངེས་སུ་འདུག་པས་གདུང་རྒྱུད་སྤེལ་ལ་ས་སྐྱར་གདན་ས་གྱིས་གསུངས་པའི་འཇའ་ས་སྩལ།",
    "བར་སྐབས་ཤིག་ཏུ་རྩེ་གདོང་དུ་བསྟི་གནས་ཀྱི་མཐིལ་མཛད་པས་རྩེ་གདོང་བླ་བྲང་པར་གྲགས་པ་ཡང་བྱུང་འདུག་ཀྱང་།",
    "དཔལ་མགོན་ཞལ་གྱི་ཆོ་འཕྲུལ་ཞིག་ཡིན་འདུག་པས་བསྐང་གསོ་གྱིས་གསུངས་བྱུང་འདུག་ཀྱང་།",
    "རྒྱལ་ཡུམ་དམ་པ་དེ་ཉིད་འཕྲལ་དུ་ཐུགས་བཀྲ་ཉམས་ཡོད་པ་ཞིག་ཡིན་འདུག་པས།",
    "རྩིས་མཁན་སོགས་གཞན་ལ་ཡང་བརྟག་པ་འདྲ་མཛད་འདུག་པར།",
    "ཡབ་རྗེ་ཉིད་ལ་སོགས་པ་སྐལ་ལྡན་གྱི་སློབ་ཚོགས་མང་པོ་འདུས་ནས་འདུག་པ་ལ།",
    "ཉེ་སྐོར་ན་སྐས་ཤིག་འདུག་པ་དེ་ལ་འཛེགས་ནས་ཕེབས་བཞེད་པ་ན།",
    "ཡ་མཚན་ཆེ་བར་དགོངས་པས་རྗེ་འདི་ལ་བསྟོད་བསྔགས་མཛད་པ་ཡང་བྱུང་འདུག་ཅིང་།",
    "ཁྱེད་རང་ངེད་ཀྱི་ཕྱི་ལ་ཕྱིན།",
    "ད་ལམ་ཁྱེད་རང་ཡབ་སྲས་ལྷན་ཅིག་ཏུ་གདན་སར་བྱོན།",
    "ཞེས་གསུངས་པ་སོགས་མ་འོངས་པ་མཁྱེན་པའི་ལུང་བསྟན་སྒྲིབ་མེད་དུ་སྩལ་བར་འདུག་ཀྱང་དེ་དུས་ནི་ཀུན་གྱི་སྲོལ་དུ་སྣང་བ་བཞིན།",
    "གདན་སར་ཕེབས་དགོས་ཤར་ཀྱང་ཐག་རིང་མི་འདུག་པས་ཕར་བྱོན་ཚུར་བྱོན་མཛད་པས་འཐུས་པ་འདུག་པ།",
    "བདག་ཚེ་ཧ་ཅང་མི་རིང་བ་ཞིག་བྱུང་ན་ཐོས་བསམ་རྒྱ་ཆེར་བྱས་པ་ལ་དོན་མི་འདུག་པས།",
    "སེམས་ལ་ཕན་པའི་བསླབ་སྟོན་ཞིག་གནང་དགོས་ཞུ་བ་མཛད་འདུག་པར།",
    "སྐུ་ཆ་བཏབ་པས་སྐུ་ཚེ་རིང་པོ་ཡོང་བ་གདའ།",
    "ཐུགས་སྦྱོང་གནང་གོང་མི་གཡོ་བ་དཀར་པོའི་བསྙེན་པ་ཞིག་མཛད་ན་ལེགས་པ་གདའ་ལགས།",
    "ཅེས་གསུངས་པ་སོགས་མང་དག་གདའ་ནའང་ཡི་གེ་མང་དོགས་མ་བྲིས་ལགས།",
    "ཞེས་པའི་གསུང་ཕེབས་འདུག་པ་དེའི་ནང་དུ།",
    "མི་གཡོ་བ་དཀར་པོའི་རྗེས་གནང་སོགས་གནང་འདུག་པ་དང་མཚུངས་པར།",
    "ལྷག་པར་བཀའ་དྲིན་ཅན་གྱི་ཡུམ་དེ་གང་དུ་འཁྲུངས་ཡོད་རྣམས་ལ་ལུང་བསྟན་གསལ་བ་ཞིག་དགོས་ཚུལ་ཞུ་བ་གནང་འདུག་པའི་ལན་དུ།",
    "བྱ་བ་ཁམས་ཆེན་བྱུང་འདུག་ལགས་ཀྱང་།",
    "ཞེས་པ་ལ་སོགས་པ་གསུངས་པ་ལྟར་འདུས་བྱས་ཐམས་ཅད་མི་རྟག་པར་གདའ་བ།",
    "གནས་མཐོན་པོར་འཁྲུངས་པ་གཞིར་བཅས་སུ་འདུག་ལགས།",
    "དེ་ཙམ་གྱི་སྡུག་བསྔལ་རང་མི་འདུག་ཅིང་།",
    "དག་སྣང་དང་དད་གུས་འགྲན་པ་བཞིན་དུ་གྱུར་པའི་བག་ཕེབས་ཀྱི་རྣམ་པ་གང་ཡང་ཞིག་མཛད་ཀྱི་འདུག་པ་ན།",
    "ལག་ན་ཡོད་པའི་དངོས་པོ་གང་ཡོད་འབུལ་ཐུབ་པ་ལ་དགའ་སྤྲོ་ཆེན་པོ་བྱེད་པའི་སྲོལ་བཟང་པོ་ཞིག་འདུག་ཀྱང་།",
    "གྲོལ་བར་འགྱུར་དང་རང་ཉིད་ཀྱིས།",
    "རྗེ་རང་ཉིད་ས་སྐྱའི་ལུང་པ་ཡིན་སྙམ་པ་ཞིག་ན་བཞུགས་འདུག་པ་ལ།",
    "ཅེས་པཎ་ཆེན་ལེགས་པའི་བློ་གྲོས་ཀྱི་གསུང་ནས་དགྱེས་དགྱེས་དཔག་མེད་མཛད་འདུག་པ་དེ།",
    "འདི་ནི་ཁྱེད་མུས་པ་ཚོས་བརྐུས་མ་བཏབ་སུ་སྤྱན་འདྲེན་གྱུར་འདུག།",
    "ངེད་ལ་ཡང་དྲིན་ཆེན་པོར་གོ་དགོས་རྒྱུར་གདའ་སྟེ།",
    "འོན་ཀྱང་གདུང་བརྒྱུད་སྐུ་གཞོན་པ་དེ་ཉིད་མ་བཞུགས་པས་མངའ་གྲང་བ་ཙམ་འདུག་པས།",
    "སླར་འདི་ཀ་རང་དུ་ཕེབས་ནས་བཅར་བཞུགས་གནང་བ་ཡོང་ལས་ཆེ་ཟེར་བ་སོགས་རྗེ་འདི་མུས་ཕྱོགས་སུ་ཕེབས་པ་ལ་འཕྲེང་ཆ་བྱེད་པ་མང་པོ་འདུག་པ་ནི།",
    "ཐོས་བློ་ཙམ་མ་ཡིན་པའི་སླར་འཆད་སྒོམ་གང་གནང་ཡང་ཐེ་ཚོམ་གྱི་སྒྲོ་འདོགས་ཆོད་དེ་ཐོགས་མེད་ཀྱི་སྤོབས་པ་མངའ་བ་འདི་བྱུང་བ་ཡིན་འདུག་ཅིང་།",
    "ནངས་པར་རྗེ་མུས་ཆེན་ལ་ཞུ་བ་མཛད་འདུག་པ་ན།",
    "རིགས་ཀྱི་བུ་ལ་བརྒྱུད་ཀྱི་ལྷ་འགོ་ཟེར་བ་དེ་གདའ།",
    "ཞེས་གསུངས་པ་དེ་ཡང་མཛད་འདུག་ཅིང་།",
    "དེ་ཕྱིན་ཆད་མགོ་ལ་ཐོད་པ་ལེན་པ་མི་དགོས་རྒྱུ་དེར་གདའ།",
    "ས་སྐྱ་པའི་གདུང་བརྒྱུད་རྣམས་གྲུབ་ཚུལ་སྟོན་པ་ཟམ་མ་ཆད་པ་ཞིག་བྱུང་འདུག་ཀྱང་།",
    "ས་ལོ་ཐམས་ཅད་མཁྱེན་པ་སོགས་ཐོར་ཙམ་ལས་མ་བྱུང་འདུག་པས།",
    "རྒྱལ་བརྒྱུད་ཡོང་བ་ནི་དཀའ་བ་འདུག།",
    "ད་ལམ་ཁྱེད་རང་ཕྱོགས་སུ་བསྟན་འགྲོའི་དོན་ཕྱིར་ཕེབས་འགྲུལ་ཐོག་མ་ལ་གཞི་བྱེས་གང་དུ་ཡང་ཉེས་པ་མེད་པར་བདེ་བར་འབྱོར་པ་འདི་ལེགས་ཚོགས་ཆེ།",
    "ངེད་ཀྱི་རྩར་ཁ་ཏོན་གྲུབ་མཚམས་ཁོར་ཙམ་ཞིག་ཡོང་ལུགས་གྱིས་ཤིག་ཕེབས་འདུག་པ་བཞིན།",
    "རྟེན་གསར་བཞེངས་ངེད་ཀྱི་བློ་ལ་ཇི་ལྟར་ཡོད་པ་འདི་རྣམས་ཀྱི་མཇུག་ཁྱེད་ལ་བསྒྲིལ་དགོས་པ་ཡོང་ཞེས་སོགས་གསུངས་པ་བྱུང་འདུག་པ་ན།",
    "ངེད་ནི་ཉེར་དགུའི་ཟླ་བར་འདུག།",
    "གསེར་ཁ་བདག་པོའི་དཔེར་འདུག་པས།",
    "ལུས་ཀྱི་འདུག་སྟངས།",
    "གསུངས་འདུག་པ་ན།",
    "ས་སྐྱའི་མགོན་ཁང་གོང་འོག་རྣམས་སུ་ཞབས་དྲུང་རང་བྱོན་ནས།",
    "ཞེས་གསུངས་འདུག་པ་ན་རྗེ་འདི་ཐུགས་ཅུང་ཟད་མ་བདེ་ནས།",
    "ཞེས་སོགས་ཉམས་ལྡན་གྱི་གསུང་མང་པོ་དང་བཅས་བསྟོད་བསྔགས་གང་ཡང་མཛད་འདུག་ཅིང་།",
    "ཡང་ཡང་འགྲོ་ཟེར་གྱིན་འདུག་ཀྱང་།",
    "དབུས་སུ་ལོ་བཞི་འགོར་བར་འདུག་ཀྱང་།",
    "ང་ཡང་མ་ཤི་ཙམ་དང་འཕྲད་པར་འདུག་གསུངས་ནས།",
    "སྐུ་བསྙེལ་བོ་འདུག་ཀྱང་ཤིན་ཏུ་མཉེས།",
    "ནམ་མགོན་ཡང་དེ་སྐད་ཟེར་གྱིན་འདུག་ཀྱང་ད་ང་ནི་ཕན་འདུག་གསུངས་ནས།",
    "གཟའ་སྐར་བཟང་བ་ཞིག་ལ་གསུང་ངག་ཚུགས་པ་ཅིས་ཀྱང་མཛད་དགོས་ཞེས་གསུངས་འདུག་པ་བཞིན་རྗེ་འདིས་མུས་ཆེན་འཁོར་ལོ་སྡོམ་པའི་དྲུང་དེར་ཉམས་བཞེས་ཀྱི་ཁ་གསོ་དགོས་པ་རྣམས་ཞུས་ཏེ།",
    "གསུང་ངག་འཆད་ལུགས་ཇི་ལྟར་འདུག་ཅེས་ཡང་ཡང་དྲི་རྟོག་མཛད་པ་ལ།",
    "ཕ་ལ་བུ་སྐྱེས་འདུག་གེ།",
    "ཁྱེད་རང་ཡང་ལས་འཕྲོ་དང་སྐལ་བ་ཤིན་ཏུ་བཟང་བ་ཡིན།",
    "སེམས་ཀྱང་སྐྱོ་ལ་དགའ་ཆེས་པའི་རྣམ་པས་མིད་པ་འཁྱིལ་བས་གོང་སའི་གསུང་རྣམས་ལ་ལན་ཡང་ཞུ་མ་ཐུབ་པ་ཞིག་བྱུང་ལགས་པ་དོན་ལ་ཇི་ལྟར་བྱས་ན་ལེགས་པ་འོངས་ལེགས་སམ་ཞེས་ཞུ་བ་མཛད་འདུག་པར།",
    "ཡབ་སྲས་གཉིས་ཀ་ཐུགས་བདེན་པའི་རང་བཞིན་དུ་ནི་གདའ།",
    "ཁྱེད་རང་ལ་མི་ལྟ།",
    "ཞལ་ངོ་ཆེ་མེས་ཤིག་ལ་སྐུ་དོགས་ཡོད་པའི་ལྟས་སུ་འདུག་པས།",
    "ཞེས་གསུངས་པ་ཞིག་བྱུང་འདུག་པ་ན།",
    "བདག་སོགས་ལྟོས་བཅས་ལ་དགོངས་ནས་ཡུན་རིང་དུ་ཞབས་པད་བརྟན་པར་བཞུགས་དགོས་ཞུ་བ་མཛད་འདུག་པར་རྗེ་མུས་པ་ཉིད་ཅི་ཡང་མི་གསུང་བར་ཡུན་རིང་དུ་བཞད་ཀྱིན་འདུག་པས།",
    "ཅེས་སོགས་ཐུགས་གཏིང་ནས་བརྩེ་བའི་གསུང་དུ་མ་ཞིག་སྩོལ་བར་མཛད་འདུག་ཅིང་།",
    "སྔགས་འཆང་ཉིད་ལ་མི་ཕྱེད་པའི་དད་ལྡན་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་ཡོད་འདུག་པའི་ནང་ནས།",
    "ཡར་རྒྱབ་དཔོན་ས་བརྒྱ་དགར་གྲགས་པ་འདི་ཐུགས་རྗེའི་སྤྱན་རས་ཀྱིས་འཚོ་ངེས་པའི་ལས་ཅན་མ་ཞིག་ཡིན་འདུག་པས།",
    "མར་ལམ་བསམ་གྲུབ་རྩེར་ཕེབས་པ་ཞིག་ཅིས་ཀྱང་དགོས་ཞེས་ནན་ཞུས་བྱུང་འདུག་པར་བརྟེན།",
    "སྐུ་གཟི་བརྗིད་ཆེ་བ་འདི་བཞིན་ངོ་མཚར་ཆེ་དགོངས་པའི་དད་པ་དང་ཐུགས་མཐོང་ཤིན་ཏུ་ཆེ་བ་ཞིག་ཡོད་འདུག་པ་དང་།",
    "དེ་ལོ་ཆར་ཤིན་ཏུ་དཀོན་པ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "རྗེ་འདི་ཕེབས་ཕྱིན་ཆད་སྔར་ཡང་ཆར་ཆེན་པོ་བབ་པ་བྱུང་འདུག་པས།",
    "ཇོ་བོ་ལ་ཡང་སྐུ་གྲིབ་ཕོག་པའི་ཉམས་བག་ཙམ་འདུག་པ་དགོངས་ནས།",
    "སྐུ་གྲིབ་སངས་པའི་རྟགས་ཀྱང་ཤིན་ཏུ་གསལ་བ་བྱུང་འདུག་ཅིང་།",
    "ལེགས་རྒྱུ་ཅི་ལྟར་ཡོད་ལགས་སམ་ཞུས་འདུག་པར།",
    "ཞེས་གསུངས་པ་བྱུང་འདུག་ཅིང་།",
    "དེར་འཚོགས་སྐྱ་སེར་གྱི་ཁྲོམ་ཆེན་པོ་དམར་སྨུག་ཏུ་འཁྱིལ་བ་རྣམས་ཀྱིས་སྒྲ་ཆེན་པོ་འུར་ཆིལ་བ་ལན་གསུམ་བསྒྲགས་འདུག་པ་འདི་ཡང་དུས་ངན་སྙིགས་མའི་མཐར་ཐུག་པ་འདི་ལྟ་བུ་ལ།",
    "ད་ལམ་སྐྱེས་བུ་དམ་པ་ཕེབས་པས་གནས་སྒོ་གསར་དུ་བྱེ་བར་འདུག་པས་ཤིན་ཏུ་ཡ་མཚན་ཆེ་ཟེར་ཞིང་ཀུན་ལ་སྒྲོགས་པར་བྱེད།",
    "སྐུ་གཉེར་ཁོ་རང་ཡང་འདི་སྔར་མེད།",
    "དེའི་སྤྲུལ་པ་ཞིག་ཏུ་འདུག་པས་ཤིན་ཏུ་ངོ་མཚར་ཆེ་ཟེར་ཞིང་།",
    "དཔལ་རབ་ཀྱི་གཟིམ་ཆུང་གཅིག་ལ་གཟའི་རྒྱུ་ལམ་འདུག་ཟེར་བ་ཞིག་ཡོད་པ་ལ།",
    "ངེད་ཀྱིས་གཟའ་བཟུང་ནས་ཁྱེད་རང་ལ་སྟོན་ནོ་གསུངས།",
    "དེ་སྔ་སེར་བའི་གནོད་པ་སྡང་པོ་བྱས་པ་ཞིག་ཡོད་འདུག་ཀྱང་།",
    "གཞན་ཡང་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་།",
    "བསྐྱེད་རྫོགས་ཟུང་འཇུག་སྟོན་པ་རིག་འཛིན་རྒོད་ལྡེམ་གྱིས་བྱང་གཏེར་ནས་སྤྱན་དྲངས་པའི་བཀའ་བརྒྱད་དྲག་པོ་རང་བྱུང་རང་ཤར་གྱི་སྐོར་དང་།",
    "དད་གུས་འདི་མཐའ་གཉིས་སུ་མ་ལྷུང་བ་གཅིག་དགོས་ཞེས་ཡང་ཡང་གསུང་བ་ཞིག་ཡོད་འདུག།",
    "བདག་ལ་དགྱེས་པར་འདུག་སྙམ་པ་འབྱུང་ཞིང་།",
    "མཚན་ལམ་དེ་རྗེ་བཙུན་མུས་ཆེན་ལ་ཞུ་བ་གནང་འདུག་དུས།",
    "སྒྲུབ་ཐབས་ས་ལོའི་འདི་མཛད་ན་ས་ལོ་ཆེན་པོ་ཡང་དགྱེས་པར་འགྱུར་བའི་རྟགས་སུ་སྣང་ཞིང་གདན་ས་ཆེན་པོ་འདིར་སྐབས་སུ་ཡང་དེ་ཀ་འབབ་པ་ཡོང་བ་འདུག།",
    "ཡང་ལན་གཅིག་མནལ་ལམ་དུ་རྗེ་ཉིད་དབུ་རྩེའི་འཇམ་དབྱངས་གཟི་འོད་འབར་བའི་དྲུང་ན་ཕེབས་འདུག་པ་ལ།",
    "ན་བཟའ་དེ་གོས་ཕྲུག་སྔོན་པོ་འཇམ་པོ་ཞིག་འདུག་ཅིང་།",
    "ཞལ་འཛུམ་འཛུམ་གསུང་འབྱོན་ལ་ཁད་འདུག་པ་ལ་ཐུགས་སྤྲོ་བ་ཆེན་པོས།",
    "སྐོར་ལམ་ཐམས་ཅད་བནྡྷེ་ལ་ལྷུས་བླངས་པའི་སྐྱེ་བོ་མང་པོས་གང་འདུག་ཅིང་།",
    "དེ་དུས་ཞབས་དྲུང་ན་སྔར་རྗེ་འདིའི་གསུང་རྩོམ་གྱི་ཡིག་མཁན་ཞུ་བའི་གདོང་དགའ་བ་བསམ་པ་དོན་ཆེན་ཡང་དྲུང་ན་འདུག་པ་ལ།",
    "ངེད་ཀྱིས་སྐུ་འདི་ལ་ལུང་བསྟན་མང་པོ་ཞུ་དགོས་འདུག་པས།",
    "ལུས་འདི་མ་སྤངས་པར་མཁའ་སྤྱོད་དུ་ཕྱིན་པས་ཆོག་པ་ལ་ཐེ་ཚོམ་མི་དགོས་པ་འདུག་དགོངས་ཙམ་ན།",
    "གླིང་གའི་བསམ་གཏན་ཕུའི་རྗེ་མུས་པའི་གཟིམ་ཕུག་དེ་ཡིན་དགོངས་པ་གཅིག་ན་སེམས་དཔའ་ཆེན་པོ་བཞུགས་འདུག་པ་ལ།",
    "དེ་མཚམས་སེམས་དཔའ་ཆེན་པོ་ནི་རྗེ་མུས་ཆེན་དུ་འདུག་པའི་ཕྱག་ན་སྦ་སྙུག་ལ་ཉག་ཁྲམ་མང་པོ་གཏོད་པ་ཧ་ཅང་མི་ཐུང་གཅིག་དང་།",
    "དེའི་ཚེ་རྗེ་མུས་པའི་ཞབས་དྲུང་རང་ན།",
    "རྒྱ་ཇ་སོགས་དངོས་པོ་མང་དུ་འདུག་པས།",
    "བསྐང་གསོ་རྒྱས་པ་ཞིག་མཛད་དགོས་པ་འདུག་དགོངས་པའི་ཚེ།",
    "བསེ་འབག་ཕྱོགས་གཞན་དུ་ཕེབས་པ་མེད་ཞུ་བ་བྱུང་འདུག་པ་ནི།",
    "ཀུན་གྱིས་རྟོགས་ཤིང་ཡ་མཚན་དུ་གྱུར་པ་བྱུང་འདུག་པ་ནི།",
    "འདི་འདྲའི་ནམ་འཕྱི་བ་ལ་མི་ལེགས་ཟེར་དང་ལེན་མ་ཞུས་འདུག་པ་ན།",
    "སྐུ་ཞོགས་ན་བནྡེ་བོང་ཅན་ངོ་ནག་པ་ཞིག་ཀྱང་འདུག་པས།",
    "ཁྱེད་ཀྱིས་བདུད་དཔུང་ཀུན་འཇོམས་མ་ལ་དབྱངས་མཛད་བྱུང་ཙ་ན།",
    "དེ་འདྲ་ག་ན་ཡོད་དྲིས་པས་དྲེའུ་རྒྱའུའི་སྟེང་མགོ་སྦྲེལ་བཀལ་བའི་ནང་ན་ཡོད་ཟེར་བ་ཇི་ལྟ་བ་བཞིན་འདུག་པ་ལ།",
    "ལུས་ལ་སྐྱེ་བ་སྔོན་མའི་ཤ་མཚན་གསལ་བ་སོགས་ཡིད་ཆེས་ཀྱང་བྱུང་འདུག་པ་དང་།",
    "འདི་མ་གྲོལ་བར་ལམ་སྟོན་མི་ཐུབ་པ་འདུག།",
    "ཕ་མ་དང་སྤུན་ཟླ་ནོར་རྫས་འདི་འདྲ་ཡོད་ཟེར་བ་སོགས་ཤིན་ཏུ་གསལ་བ་ཡིད་ཆེས་ཅན་བྱུང་འདུག་པ།",
    "ད་ལྟ་མི་ངོ་བཟང་བའི་ཚད་འདི་བཞིན་བྱུང་འདུག་པ་དང་།",
    "མའི་མངལ་དུ་ཆགས་པ་ཁོ་རང་སུས་ཀྱང་མ་ཤེས་པར།",
    "བྱིས་པ་དེས་མཐོང་འཕྲལ་ལག་ཏུ་བླངས་ནས་དགའ་དགའ་ཅི་ཡང་ཞིག་བྱེད་ཀྱི་འདུག་པ་ལ།",
    "ལན་གཅིག་ནམ་ཕྱེད་ཙམ་ན་གྲོང་པའི་སྐྱེ་བོ་དར་བབ་ཞིག་ལ་སྔར་གྱི་གཤིན་འདྲེ་དེ་པ་ཁོག་ཞུགས་ཀྱིས་རྒྱལ་སྒོ་སོགས་མནན་ཡོད་འདུག་ཀྱང་།",
    "དེ་ཕྱིན་ཆད་ཁོག་ཞུགས་ཀྱི་རྣམ་པ་གཏན་མ་བྱུང་འདུག་པ་འདིའང་འབྱུང་པོ་རྣམས་ཀྱང་ཉིད་ཀྱི་བཀའ་ལས་ཅུང་ཟད་ཀྱང་མི་འདའ་བའི་རྟགས་མཚན་དུ་སྣང་ངོ།",
    "དེ་ནུབ་གདན་སར་འོང་མི་ཐུབ་པ་བྱུང་འདུག་པ་འདི་འདྲའི་རིགས་ཅན་མང་དུ་ཡོད་ཅིང་།",
    "ཕྱག་དྲུག་ཙམ་བྱས་པ་ཞིག་ལོགས་བྲིས་ཀྱི་ཚུལ་དུ་འདུག་པ་དེའི་སྤྱན་ཁྲ་ཧྲིག་ཧྲིག།",
    "རྗེ་ཉིད་ལ་མུས་ཆེན་གྱིས་གནང་བའི་སོག་པོ་ཁ་རྟགས་ཁྱད་འཕགས་ཤིག་དེར་འབུལ་བར་མཛད་པ་དེ་གཉིས་ཙམ་ལུས་འདུག་པ་བྱུང་བ་ནས་བཟུང་རྒྱང་ཙམ་གཏོར་གཞི་འཛུགས་པ་གནང་མ་ཐུབ་པའི་སྐབས།",
    "དགའ་ཆེས་ཏེ་ཕྱག་བྱ་དགོས་སྙམ་ལངས་པའི་སྣང་བ་ཞིག་བྱུང་བ་ཡིན་གསུང་བ་བྱུང་འདུག་པ།",
    "སྐྱོན་མེད་དུ་ཁྲིག་གེ་འདུག་པ་མཐོང་བ་ན།",
    "ལོད་རྒྱུ་རང་ཆེར་མེད་དམ་གསུང་བ་བྱུང་འདུག་པ་བཞིན།",
    "ཤིན་ཏུ་ལེགས་པའི་དགེ་མཚན་གྱི་ལྟས་ཡིན་ཚུལ་བབ་འདུག་པ་བཞིན།",
    "རིགས་ཀྱི་བུ་ལ་བརྒྱུད་ཀྱི་ལྷ་འགོ་ཟེར་བ་དེར་གདའ།",
    "ངོས་ནི་ཉེར་དགུའི་ཟླ་བར་འདུག།",
    "རྣམ་པ་བང་རིམ་མང་པོ་བྱས་པའི་ཁང་བརྩེགས་ཤིག་ལ་ཞབས་འབྲིང་བ་མང་པོ་དང་བཅས་ཞབས་སྐོར་མཛད་ཀྱིན་རིམ་གྱིས་འཛེགས་ནས་ཕེབས་ཀྱི་འདུག་པ་ན།",
    "རྨི་ལམ་ལ་གཏད་པ་མེད་གསུངས་འདུག་ཀྱང་།",
    "ཁམས་ལ་བདེ་བསྐྱེད་མི་འདུག།",
    "དེ་ཉིན་སྐུ་འཆམ་གནང་མི་ཐུབ་པ་ལ་ཀུན་བློ་ཐག་ཆོད་པ་ཞིག་བྱུང་འདུག་ཀྱང་།",
    "རྗེ་གྲུབ་ཐོབ་ཀྱི་གཙུག་རྒྱན་དེ་ཉིད་ཀྱི་ཐུགས་རྗེ་ལ་ཉེ་རིང་མེད་པར་འདུག་དགོངས་པའི་ཡིད་ཆེས་ཀྱི་ཐུགས་དད་ཅི་ཡང་ཞིག་འཁྲུངས་པ་བྱུང་ཞེས་རྗེ་ཉིད་ཀྱི་གསུང་ལས་ཐོས་ཤིང་།",
    "དམ་པ་འདི་གཉིས་དཔལ་ས་སྐྱའི་དབུ་རྩེ་རྙིང་མ་ན་ལྷན་ཅིག་བཞུགས་འདུག་པ་ལ།",
    "ཁྱེད་རང་ལྷག་བསམ་པ་ཡོད་ཟེར་བ་ན་མནལ་སད་དེ།",
    "དཔལ་མགོན་འདི་ངེད་རང་ལ་འགོ་བའི་ལྟས་སུ་འདུག་དགོངས་ནས།",
    "ཕྱིས་གནས་ཚུལ་དེ་གཞན་ལ་ཟློ་ཙ་ན།",
    "མཆོག་ཏུ་རྗེས་སུ་ཡིད་རངས་པའི་དགྱེས་སྤྲོ་ཁྱད་པར་ཅན་ཞིག་འཁྲུངས་པར་འདུག་པས།",
    "དེ་འདྲའི་ལྦ་བ་དཀྱུས་མར་མི་འདུག་གསུངས།",
    "དེ་ནས་སྔགས་འཆང་ཆེན་པོའི་ཞབས་རྗེས་སུ་རྗེ་ཉིད་ཕེབས་ཀྱིན་འདུག་པ་ལ།",
    "ཁོང་རང་རྗེ་འདིའི་བཀའ་ལ་ཡིད་ཆེས་གདེངས་ཁེལ་ཡོད་པའི་སྟོབས་ཀྱིས་གཏར་ཞིག་བྱས་པས་གཞི་མེད་དུ་དྭངས།",
    "དེ་མཐུན་རྗེས་སུ་ཡ་འབྲོག་ལ་སོག་དམག་ཡོང་བ་རྣམས་ཀྱི་དཔོན་ཚོ་ཁོ་རང་ནང་འཐབ་ཀྱིས་ཀུན་གྲོན་ནས།",
    "བསམ་རྩེར་ཕེབས་པ་ཞིག་མ་བྱུང་དོགས་ཀ་འདུག་གསུངས།",
    "ཐུགས་སྦྲམ་ཐང་ངེ་བ་ཞིག་རྒྱུན་དུ་མཛད་ཀྱིན་འདུག་པ་བཞིན།",
    "ཞལ་རས་ལ་འབུ་རུ་ཁ་ཅིག་འཐོན་འདུག་པ།",
    "དེ་རིང་གོང་བཞུགས་གསུང་ཆེན་པོ་མཛད་ཀྱིན་འདུག།",
    "དེ་ཉིད་ཀྱི་གྲུབ་རྟགས་རང་དུ་འདུག་གོ་ཞེས་གླེང་ཞིང་།",
    "གཞན་མ་དེ་འདྲའི་ཟོས་པ་ཡོང་དོན་མི་འདུག།",
    "དེ་ཉིད་ཀྱི་བསྟན་པའི་རྒྱུན་འདི་མ་ཉམས་ཙམ་ཞིག་མ་བྱུང་བའི་ཐབས་མི་འདུག་ཅེས་གསུངས་ཤིང་ཕྱག་བཞེས་སུ་འདེབས་པར་མཛད།",
    "གོང་དཀར་གྲྭ་ཚང་སྒེར་དུ་མང་འགྱེད་འདུ་ཁང་ཞིག་བཟོས་གསར་བཟོ་ལྟ་བུ་བསྒྲུབས་འདུག་པ་ལ་ཕྱག་ནས་དང་།",
    "ཁ་བ་ཆེན་པོ་ཉིན་མཚན་སྦྲེལ་ནས་འབབ་པའི་གནས་ཡིད་དུ་འོངས་རྒྱུ་རང་ཞིག་མི་འདུག་པས།",
    "གདན་ས་ཆེན་པོའི་ཕུ་ཁའུ་སོགས་སུ་ཡང་མི་གྲིབ་ཅན་འགྲོ་འདུག་མང་བར་བརྟེན།",
    "དེའི་ནངས་པར་ཆུ་སྔར་བཞིན་དུ་བརྡོལ་འདུག་པ་མཐོང་བ་ན།",
    "ཕྱི་ལྟར་སྤོམ་ཡོར་མཛད་པ་ཞིག་འདུག་ཀྱང་།",
    "ངོ་མཚར་ཕུན་ཚོགས་མའི་ཚིགས་བཅད་སྔ་མ་རྣམས་མནལ་ལམ་དུ་ཀ་རྩོམ་གནང་བ་དེ་ནངས་པར་ཡང་ཐུགས་ལ་གསལ་བར་འདུག་པ་བཞིན་ཚོགས་སུ་འཛུགས་པར་མཛད་པས།",
    "དགོན་མང་པོར་རྒྱ་ཇའི་འདུར་སྐོལ་སོགས་རྒྱབ་རྟེན་མི་ཉུང་ཙམ་དགོས་པ་ཡོད་ཚུལ་ཞུ་བ་མཛད་འདུག་ཀྱང་།",
    "གཅེན་གྱིས་གྲུབ་ཉམས་ཀྱིས་གུར་ཤི་རྒྱལ་པོ་མཆོད་ཡོན་ལ་འཕྲོས་མ་བཏང་བར་གདན་སར་སྐུ་མཆེད་མཇལ་བར་ཏབ་ཏོབ་ཏུ་ཕེབས་རྩིས་གནང་འདུག་ཀྱང་།",
    "དེ་ལས་གཞན་སྒྲུབ་མཆོད་ཀྱི་དགོངས་གཏད་ནི་མཛད་མི་འདུག་ཀྱང་།",
    "ཁྱེད་རང་རྣམས་བློ་མཐུན་ངོས་དགོངས་རྫོགས་ཀྱི་འབྲེལ་བ་ཆོད་བསྟུན་རྒྱལ་པོ་མཆོད་ཡུལ་དུ་བསླབ་སྟོན་ཞུ་ལུགས་གོ་མ་ལོག་པ་དགོས་ཚུལ་སོགས་འཕྲལ་ཕུགས་ཀྱི་བསླབ་ཆ་ཞིབ་རྒྱས་བཀའ་ངག་དང་བཀའ་ཐོ་གཉིས་ཀ་ཕེབས་ཡོད་པ་བཞིན།",
    "ཁོང་རང་རྣམས་ཡུལ་ཆེན་དུ་ནམ་བྱོན་བར།",
    "ཐམས་ཅད་གྲོན་ཅན་དུ་གཏོང་རྩིས་ཁོ་ན་འདུག་པ་ལ།",
    "བོད་མི་གསོད་པ་ལ་ཆེར་རྔམ་པ་ཡོད་འདུག་ཀྱང་།",
    "སྟེང་ཁང་ནའང་མི་མང་པོའི་གསེབ་ན་རྗེ་བཙུན་རང་འདུག་པ་གཞན་དུ་གཤེགས་བཞེད་པ་ན།",
    "དེ་ནས་རྗེ་བཙུན་གྱིས་བྲག་ཐེམ་གཅིག་འདུག་པ་ལ་འཛེགས་བྱོན་པས།",
    "ད་ལམ་ལྔ་བཅུ་ཙམ་ལ་བྱེད་དགོས་པ་འདུག་གསུངས་ནས་རྫོགས་པར་སྩལ་ཅིང་།",
    "ཁོང་གཉིས་ཀྱིས་མི་འདུག་ཚུལ་ཞུས་པར།",
    "འདི་རྣམ་རྒྱལ་གྱི་གཟུངས་ཆུ་ཡིན་པ་འདུག་གསུང་བ་ཞིག་བྱུང་སྣང་བ་ནི།",
    "བདག་ཉིད་ཆེན་པོ་སྐུ་མཆེད་གསུམ་ཁྲི་ཕེབས་ཀྱི་སྐབས་སུ་ཡང་མཛད་ཀྱིན་ཡོད་འདུག་པ་བཞིན།",
    "ཉེ་རིང་ཀུན་ལ་སྙོམས་པ་ཚངས་པའི་དབྱངས་སུ་གྲགས་པ་དེར་སྣང་བས་ཆེས་ངོ་མཚར་བར་འདུག་ཅེས་ཀྱང་གླེང་བར་བྱེད་ཅིང་།",
    "ཛོ་ཀི་དེའི་གཞོགས་ན་བནྡེ་གཟུགས་བོངས་ཆེ་བ་ཞིག་ངོ་གནོང་ཙམ་བྱས་ཅང་མི་ཞུ་བར་འདུག་པ་ཞིག་བྱུང་ནས།",
    "དེ་ནུབ་ཅི་ཡིན་ནམ་རྨི་ལམ་དཀྱུས་མར་མི་འདུག་དགོངས།",
    "རྗེས་སུ་དར་སྟེང་དུ་བྱེའུ་ཕར་འཕུར་ཚུར་འཕུར་གྱི་རྐྱེན་གྱིས་བབས་འདུག་པ་ལ།",
    "ཞེས་གསུངས་འདུག་པ་ལྟར།",
    "རྩོམ་པའི་རློམ་པ་བྱས་ཀྱང་མཁས་པ་དགྱེས་པ་ཞིག་ཅི་ལ་ཡོང་དུ་འདུག་སྙམ་པའི་བློ་ཞུམ་པར་གྱུར་ཅིང་།",
    "འདུག་གནས་གྲོགས་དང་བཅས་པ་ཐམས་ཅད་ཀྱང་ལྷ་དང་།",
    "དེ་དག་ཀུན་ལ་ལྟོས་པ་མེད་པར་བརྗོད་བྲལ་གྱི་ཉམས་ཅུང་ཟད་འཆར་གྱིན་འདུག།",
    "བུས་པའི་ཤེས་རབ་ཀྱིས་བསྐལ་པར་སྦྱངས་ཀྱང་མི་ཤེས་པ་འདུག་སྙམ་པ་ཡང་ནས་ཡང་དུ་འབྱུང་།",
    "ཞེས་གསུངས་འདུག་པ་ཡིན།",
    "ཞི་བའི་སྒོ་འཕར་བརྒྱ་ཕྲག་དུས་གཅིག་ཏུ་དབྱེ་བར་མཛད་པ་ཡིན་ནོ།",
    "སྐུ་ལུས་ཀྱི་ཚོད་གཟུང་མི་ཐུབ་པ་ལྟ་བུ་བྱུང་བ་བདག་ཉིད་ཆེན་པོའི་དྲུང་དུ་ཞུ་བར་མཛད་འདུག་ཅིང་།",
    "ལྷག་པར་བདེ་མཆོག་གསུང་བསྙེན་གྱི་སྐབས་ཤིག་རྗེ་ཉིད་ཀྱིས་སྒྲུབ་གཡོག་ལ་ཁྱེད་ཅི་འདོད་ཀྱིན་འདུག་གསུངས་པས།",
    "ས་སྐྱ་པའི་གྲྭ་དགོན་གང་ན་ཡང་དེ་འདྲ་ཡོད་པར་མི་འདུག།",
    "འདི་ཐམས་ཅད་གདན་ས་ཆེན་པོ་འདི་ཉིད་ལས་གཞན་དུ་ནམ་ཡང་འཁྱར་བར་མི་འོས་པས་ན་འདི་རྣམས་ཕྱོགས་གཅིག་ཏུ་བཞུགས་པའི་གཙུག་ལག་ཁང་ཟུར་པ་ཞིག་ཆེད་དུ་གཏད་ནས་བཞེངས་དགོས་པར་འདུག་སྙམ་པའི་ཐུགས་དགོངས་བཟང་པོ་རྒྱུན་ཆགས་སུ་ཡོད་པ་དེ་ཕྱག་ཐོག་ཏུ་འགེལ་བར་བཞེད་ནས།",
    "དཔལ་ལྡན་ཀུན་དགའ་གྲོལ་མཆོག་རྣམས་ཀྱི་སྐུ་བརྙན་རང་རང་སོ་སོའི་ཕྱག་ནས་མ་སོགས།",
    "འདུག་ཀྱང་རུང་།",
    "དཔོན་སློབ་ཐམས་ཅད་བྲེལ་བ་ཆེས་པས་ཧ་ཅང་ཡུན་རིང་བ་འགོར་ན་མི་ཡོང་བ་འདུག།",
    "སྐབས་མང་པོར་ནི་མཆན་ཆེན་གྱི་ཡིན་ཚོད་དུ་འདུག་སྟེ།",
    "རྗེས་ཀྱང་བུ་ཊཱིཀ་སྟེང་ནས་ཚར་གསུམ་གསན་པས་དེའི་འབྲེལ་དང་ཞེན་པར་གདའ།",
    "མཆན་ཆེན་ཤོག་རིལ་གསུམ་དང་མ་མཇལ་ཚོད་དུ་འདུག་སྟེ།",
    "ཞེས་ཀྱང་ཞུ་ཡི་འདུག།",
    "ཕྱིས་སུ་བསམ་པས་ཁྲོལ་མ་བཞི་པོ་དེ་ནི་སྤ་གྲོ་དགོན་གླིང་བཞི་སོགས་ཀྱི་དམག་ཁ་བཞི་ལ་ལྟ་བ་འདུག་ཅེས་བདག་ཉིད་ཆེན་པོའི་གསུང་ལས་དངོས་སུ་ཐོས་པ་ཡིན་པས་སྐལ་ལྡན་དག་ཤིན་ཏུ་ཡིད་ཆེས་པར་ཟུངས་ཤིག།",
    "བདག་ཉིད་ཆེན་པོས་ཀྱང་བཤོས་འཆང་མང་པོ་གནང་བ་ལ་སོགས་པའི་རྨི་ལམ་ཤིན་ཏུ་གསལ་བ་ཞིག་བྱུང་འདུག་པ་དང་།",
    "ད་ལམ་བྲེལ་བའི་སྟབས་ཀྱིས་མ་ཐུབ་པ་སླར་འགྱང་མེད་དུ་དབུས་ཕྱོགས་སུ་ཆིབས་ཁ་བསྒྱུར་བ་ཞིག་དགོས་འདུག་པ།",
    "མཁན་ཆེན་དུ་སྐུ་དོག་ཅུང་ཟད་འདུག་པས།",
    "དབུ་ཟིལ་པ་ཁྲོམ་པ་ཙམ་འདུག་པས།",
    "སྔ་འགྱུར་ཟེར་བ་ཡང་འདུག་སྟེ་མ་འགྱུར་བ་དག།",
    "སྟག་རྩེར་གཏད་འདུག་པ་སླར་འབབ་ལྡན་མའི་དཀྱིལ་འཁོར་དུ་དག་བྱེད་ཀྱི་ཆོ་ག་བསྐྲུན་པར་མཛད་དགོས་ཤར་ཞིང་།",
    "ལ་ལ་ནི་བསྟོད་དབྱངས་འུར་དིར་དུ་འདོན་པ་སོགས་བྱུང་འདུག་ཅིང་།",
    "ཁྱེད་རང་བཞུགས་གནས་ལྕོག་འདི་འདྲ་ཞལ་བཀོད་གནང་།",
    "དེ་རྣམས་ཀྱི་སྲུང་མར་བཀའ་བསྒོས་དམ་བཞག་མཛད་འདུག་པ་བཞིན།",
    "ངེད་གཟུགས་ཅན་ཉམ་ཆུང་རྣམས་ཀྱིས་གང་ཡང་ཐུབ་པར་མི་གདའོ།",
    "ངེད་ཀྱིས་ཀྱང་དེ་བཞིན་དང་ལེན་མ་ཞུས་ན་དོན་མ་གོ་རང་དུ་འགྲོ་བ་འདུག་པས།",
    "རྗེ་ཉིད་ཀྱིས་ཁྱེད་རང་བསྟན་པ་སྤྱི་སྐེར་བསྲུང་བའི་ལས་ཡང་དག་པ་མཛད་དགོས་ཤིང་།",
    "རྗེ་འདི་ཉིད་ཀྱི་བཀའ་ལས་ངེད་རྣམས་སང་འགྲོ་བ་ལ་ཉི་དུག་མེད་ཅིང་འཇམ་ལ་བསིལ་བ་ཞིག་དགོས་འདུག་པ་དེ་བཞིན་གྱི་ནུས་ལྡན་མཛོད་ཅིག།",
