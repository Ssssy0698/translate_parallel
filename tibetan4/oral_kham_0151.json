    "པདྨོའི་རྒྱན་གྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "དབྱིབས་དཔལ་གྱི་བེའུ་ལྟར་འདུག་པ།",
    "ཁ་དོག་མཐའ་ཡས་པའི་རྒྱ་མཚོ་ལ་རབ་ཏུ་གནས་པ་ཟུར་དུ་མའི་དབྱིབས་སུ་འདུག་པ་རྒྱན་མིག་འཕྲུལ་ལྟ་བུ་ཐམས་ཅད་ཀྱི་ཀུན་ནས་གཡོག་པ་ཡོད་དེ།",
    "མན་ཤེལ་གྱི་མེ་ཏོག་སྣ་ཚོགས་ཀྱི་རྒྱལ་མཚན་གྱི་རྒྱ་མཚོས་བརྟན་པ་རི་རབ་ཀྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "གཅིག་ཏུ་དག་པ་ལུས་དང་ཁྱིམ་སྣ་ཚོགས་ཀྱི་སྤོས་ཀྱི་ཆུ་བོ་ལ་རབ་ཏུ་གནས་པ་རྣམ་པར་རྒྱལ་བ་རབ་ཏུ་ཕྱེ་བའི་ཁང་པ་བརྩེགས་པའི་དབྱིབས་ལྟར་འདུག་པ།",
    "གཅིག་ཏུ་དག་པ་ཀུན་ནས་གྲུ་བཞིར་འདུག་པ།",
    "གཅིག་ཏུ་དག་པ་རྡོ་རྗེའི་དབྱིབས་ལྟར་འདུག་པ་རྡོ་རྗེའི་རྒྱལ་མཚན་སྣ་ཚོགས་ལ་རབ་ཏུ་གནས་པ།",
    "སྟེགས་བུ་རྒྱ་མཚོའི་དབྱིབས་ལྟར་འདུག་པ།",
    "གཅིག་ཏུ་དག་པ་རྒྱན་ཐམས་ཅད་ཀྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "དེ་ལ་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་རྒྱུད་ཨིནྡྲ་ནི་ལའི་དབྱིབས་ལྟར་འདུག་པ་སྐར་མདའ་ལྟར་སྣང་བ་ཞེས་བྱ་བ་རབ་ཏུ་གནས་སོ།",
    "ཁ་དོག་ཐ་དད་རབ་ཏུ་འདུག།",
    "ལ་ལ་རྒྱ་མཚོའི་དབྱིངས་སུ་འདུག།",
    "ལ་ལ་རྡོ་རྗེའི་དབྱིབས་སུ་འདུག།",
    "ཀུན་ནས་ཟླུམ་པའི་དབྱིབས་སུ་འདུག་པ།",
    "རང་རང་སོ་སོའི་འཁོར་རྣམས་ཀྱིས།",
    "འཇིག་རྟེན་གྱི་ཁམས་རི་རབ་ནི་ཀུན་ཏུ་བཟང་པོས་ཚངས་པའི་ལྷའི་ལུས་ཀྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "དགའ་ལྡན་གྱི་ལྷའི་ལུས་ཀྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "འཚེ་མའི་ལྷའི་ལུས་ཀྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "གྲོང་རྡལ་ནི་མཛོད་མཐའ་ཡས་པ་ཁང་པ་བརྩེགས་པའི་དབྱིབས་ལྟར་འདུག་པ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་བཅུའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་ཀུན་ཀྱང་དེ་བཞིན་གཤེགས་པའི་སྐུའི་དབྱིབས་སུ་འདུག་པ་ཤ་སྟག་དང་།",
    "ཉན་ཐོས་ཀྱི་ལུས་ཀྱི་དབྱིབསུ་འདུག་པ་ཤ་སྟག་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་དེ་ནི་འཇིག་རྟེན་གྱི་ཁམས་རི་རབ་ཀུན་ཏུ་བཟང་པོ་ཞེས་བྱ་བ་ཚངས་པའི་ལྷའི་ལུས་ཀྱི་དབྱིབས་སུ་འདུག་པ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོའི་བང་རིམ་ཆེན་པོ་ཁྲི་འཕང་དུ་འདུག་པ་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་བཅུའི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་དང་ལྡན་པའོ།",
    "འཕྲུལ་དགའི་ལྷའི་དབྱིབས་སུ་འདུག་པ།",
    "གླིང་བཞི་པ་གནས་ཀྱི་དམ་པ་ཞེས་བྱ་བ་མཚེ་མའི་ལྷའི་ལུས་ཀྱི་དབྱིབས་སུ་འདུག་པ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་དེ་ཕྱོགས་ནི་གང་ན་འདུག།",
