    "རང་རང་ཡི་གེས་ཤེས་བྱ་རྣམ་གསུམ་ཁྱབ་བདག་བགྲོད་པ་རྣལ་འབྱོར་པ་ཡིས་སྟོང་པའི་དབྱེ་བས་སོ།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཇི་ལྟར་འགྲོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཡིས།",
    "ལག་པའི་རྒྱབ་ཀྱིས་སོད་ཅིག་ངེས་པར་རབ་ཏུ་བརྗོད་དེ་མངོན་དུ་ཕྱོགས་པས་འདུག་ཅིག་འདུག་ཅིག་གོ།",
    "ངེས་པར་འཇམ་པའི་མལ་སྟན་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་བསྲུང་བ་བྱས་ནས་ནི།",
    "ཕྱི་ནས་ཤེས་རབ་ལ་སོགས་དྲུག་ནི་རབ་ཏུ་གསལ་བར་བདག་པོ་རང་རང་པདྨའི་གདན་ལའོ།",
    "ཀཾ་པ་ཁྱབ་འཇུག་དུས་ཏེ་འཕྲོག་བྱེད་ཅེས་དང་ནོར་སྦྱིན་དག་ཀྱང་སཾ་དང་འདིར་ནི་རྐྐཉིད་དོ།",
    "ཧཱུྃ་ཡིག་ཡེ་ཤེས་ལས་སྐྱེས་འཇིག་དུས་སྤྲིན་དང་མཚུངས་པ་རྩེ་ལྔ་འོད་ཟེར་དང་བཅས་དགོད་པར་བྱ།",
    "སྔགས་ཀྱིས་དགུག་པར་རབ་ཏུ་འགྱུར་ཏེ་གདོན་གྱི་ཚོགས་པ་མཐའ་དག་དུས་ཀྱི་སོས་ཟིན་རྗོད་པར་བྱེད།",
    "གཡས་པ་བརྐྱང་ཞིང་རང་རང་སྣོད་རྣམས་ཀྱིས་ནི་ལྷ་མིན་ཁྲག་འཐུང་སྐྲ་གྲོལ་གོས་དང་བྲལ་བ་སྟེ།",
    "སྣ་ཚོགས་དངོས་རྣམས་ཀྱིས་ཕྱེ་རྒྱལ་བ་དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཉིས་འགྱུར་མི་བདག་གཞན་རྣམས་ཚེས་ནི་བརྒྱད་གཉིས་དབྱེ་བ་ལ།",
    "རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྐང་པ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ།",
    "དེ་ཡི་དུས་སུ་རྒྱལ་པོའི་འགྲོ་བ་དག་ནི་རང་རང་ཚད་ཀྱིས་རྣམ་པར་ཉམས་པར་རབ་ཏུ་འགྱུར་༡༥༢།",
    "ཉི་ཤུ་འགའ་ཞིག་ལྷག་པའི་བརྒྱ་ཕྲག་གང་ཞིག་དུས་དང་དགུ་ཡིས་མི་རྣམས་ཀྱི་ནི་འཇིག་རྟེན་ཚད།",
    "ལྷ་དང་རང་འཇིགས་ཕ་མེས་དང་།",
    "གླིང་བདུན་གྱི་རང་རང་བཞིན་དང་དུམ་བུ་བཅུ་གཉིས་ཀྱི་རང་བཞིན་ནོ།",
    "རྒྱུད། ༡༡སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྦྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "བརྒྱ་བྱིན་ལ་སོགས་པ་འདི་དག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རང་རང་ལས་ལ་ཉེར་སྤྱོད་པས།",
    "རང་རང་རྒྱུ་བ་ལས་རབ་གྲུབ།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད་ཅེས་པ་སྟེ།",
    "དེ་བཞིན་དུ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར་ཏེ་རིམ་པ་འདི་ནི་སྔར་བརྗོད་པ་ཡིན་ནོ།",
    "དུས་ཀྱི་ཉིན་ཞག་དུས་ལ་སྟེ་ཉིན་ཞག་དྲུག་ཅུ་རྩ་བཞི་ལ་དེ་ནི་ཆ་དམན་ཟླ་བ་སྟེ་ཟླ་བའི་ཆ་ཉམས་པའོ་ཞེས་པའི་དོན་ཏོ།",
    "འདི་དག་རྣམས་ཀྱང་རང་བཞིན་གསུམ་སྟེ་གཡོ་བ་ལུག་ལ་སོགས་པ་དང་བརྟན་པ་གླང་ལ་སོགས་པ་དང་མཉམ་པ་གཉིས་ཀྱི་རང་བཞིན་འཁྲིག་པ་ལ་སོགས་པའོ།",
    "དེ་ལ་ཡུད་ཙམ་སུམ་ཅུ་རྣམས་དང་ཞེས་པ་དུས་སྦྱོར་གྱི་ཚོགས་དེ་ལ་ཡུད་ཙམ་སུམ་ཅུའོ་། ཉིན་ཞག་དུས་ཐུན་བརྒྱད་ཀྱི་བདག་ཉིད་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ནར་འགྱུར་རོ།",
    "སྐུཝ་ཨོ་ག་ད་ནི་གསང་བ་ཞེས་པ་ལ་སོགས་པས་རྟེན་དང་བརྟེན་པའི་ཚོགས་པ་གསུངས་ཏེ་འདིར་ལུས་ལ་འཁོར་ལོ་དྲུག་ནི་རྟེན་དུ་གྱུར་པ་སྟེ་སྐུ་བཞི་ནི་བརྟེན་པའོ་། དེ་དག་ལས་ལྷན་ཅིག་སྐྱེས་པའི་སྐུ་ནི་པདྨ་གསུམ་ལ་རང་བཞིན་དང་རང་བཞིན་མེད་པའི་དབྱེ་བས་སོ།",
    "དེའི་ཕྱིར་གསང་བའི་པདྨ་དང་གཙུག་ཏོར་གྱི་པདྨ་དང་ལྟེ་བའི་པདྨ་ལ་རྣམ་པར་དག་པའི་སྐུ་ལྷག་པའི་ལྷ་སྟེ་རང་བཞིན་མེད་པ་མ་བརྟགས་པ་དང་རང་བཞིན་པྲ་ཕབ་པ་ལྟ་བུའོ།",
    "རིགས་པ་འདི་ལས་མངལ་ནས་སྐྱེས་པའི་བྱིས་པ་གང་ཞིག་དུས་མ་ཡིན་པར་འཆི་བར་འགྱུར་བ།",
    "དེ་ཡི་དབུས་སུ་རང་རང་བསམ་པས་མི་བདག་ནི་བོད་པ་སྟེ།",
    "ཞེས་པ་དེབ་འདིའི་ལྡེབ་༥༩༨ང་༡༤༦ང་༡༥པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་པེ་སྣར་ལ་ཆད་འདུག་པེ་སྣར་གྱི།",
    "གཞན་ནི་ཡོད་པའི་ལུས་ལྔ་ཞེས་པ་ནི་ཁ་ཟས་ཅན་གྱི་ལུས་དང་འོད་ཀྱི་ལུས་དང་རང་བཞིན་ཅན་གྱི་ལུས་དང་།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་པར་༤གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཅི་ལྟར་འགྲོ་ཞེས་པ་ནི་འདིར་སད་པའི་དུས་སུ་སད་པའི་གནས་སྐབས་ཀྱི་མཚན་ཉིད་ཀྱི་བྱ་བ་དང་བཅས་ཤིང་།",
    "འོག་ཏུ་ཡེ་ཤེས་ཀྱི་ཁམས་ལས་སྐྱེས་པ་ཡིད་ནི་ཀུན་ཏུ་བཟང་པོ་ཁ་དོག་སྔོན་པོ་ཞལ་གསུམ་པ་ཕྱག་དྲུག་པ་ཁ་དོག་དུས་ཀྱི་འཁོར་ལོ་ལྟ་བུ་སྟེ་ཤར་གྱི་སྒོའི་གཡོན་དུ་ར་བའི་རྩིག་པ་ལའོ།",
    "རང་རང་ཞིང་དུ་རབ་ཏུ་གཞུག་ཅེས་པའོ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "རྣམ་པར་དག་པ་དེས་ལྷ་རྣམས་ཀྱི་སྟབས་དང་འདུག་སྟངས་རྣམ་པར་དག་པར་འགྱུར་ཏེ་གཡོ་བ་མེད་པ་ལས་སོ་ཞེས་པ་ངེས་པའོ།",
    "ཨོཾ་ལོ་ཙ་ནེ་བ་སུ་དེ་སྭཱ་ཧཱ།",
    "ཐབ་དང་འདུག་སྟངས་ལ་སོགས་པའི་ཆོ་གས་གྲུབ་པར་འགྱུར་བ་ཇི་སྲིད་ཉིད་དུའོ་། ཕྱི་ནས་ཞི་བ་ལ་སོགས་རྣམས་ལ་འབྲས་བུ་སྟེར་བར་རབ་འགྱུར་རྣམ་པ་གཞན་དུ་འགྲུབ་མི་འགྱུར།",
    "དེ་བཞིན་དུ་བྱང་དུ་ར་པ་ཙ་ནཱ་༧ ཡ་ཏེ་ན་མ་ཞེས་པ་སྟེ་བཛྲ་ཏཱིཀྵ་ལ་སོགས་པ་ཡི་གེ་རྣམས་སོ།",
    "གལ་ཏེ་འཆད་པར་འགྱུར་བའི་འདུག་སྟངས་བཅིངས་ནས་ཐུན་ཚོད་གཅིག་ཏུ་སྦྱིན་སྲེག་བྱེད་པར་མི་ནུས་ན་དེའི་ཚེ་ཐུན་ཕྱེད་གཅིག་སྦྱིན་སྲེག་བྱས་ནས་བསྒྲུབ་པར་བྱ་སྟེ་གཉི་ག་གསུངས་སོ།",
    "འདིར་ཞི་བ་ལ་སོགས་པ་ལ་རིམ་པས་འདུག་སྟངས་རྣམས་སུ་འགྱུར་རོ།",
    "རྒྱས་པ་ལ་རྡོ་རྗེའི་འདུག་སྟངས་ནི་རྐང་པ་གཡས་པ་བརླ་གཡོན་པའི་སྟེང་དང་གཡོན་པ་ཡང་བརླ་གཡས་པའི་སྟེང་དུ་སྟེ་ཐད་ཀར་གན་རྐྱལ་གྱིས་སོ་ཞེས་པ་ནི་རྡོ་རྗེ་འདུག་སྟངས་སོ།",
    "འདུག་སྟངས་ཀྱི་དབྱེ་བ་རྣམ་པ་བརྒྱད་ཀྱི་ངེས་པའོ།",
    "དེ་དག་ཀུན་ལ་གསོལ་བ་བཏབ་ནས་སེང་ལྡེང་རང་བཞིན་སྲ་བའི་ཕུར་བུ་རྣམས་ཀྱིས་ས་ལ་གདབ་སྟེ་འཆད་པར་འགྱུར་བའི་རིམ་པས་སོ་ཞེས་པ་ནི་གསོལ་བ་གདབ་པའི་ངེས་པའོ་། དེ་ལྟར་གསུངས་པའི་ཁྲོ་བོ་མཚོན་ཆ་དང་ལྡན་པ་རྣམས་ནི།",
    "དེ་ནས་ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཧྲྀ་ད་ཡ་སི་ར་ཤི་ཁཱ་ཀ་བ་ཙ་ནེ་ཏྲ་ཨནྟྲ་བཛྲ་ཥ་ཌཾ་༦ག་སྭ་བྷཱ་བ་ཨཱཏྨ་ཀོ་ཧཾ་ཞེས་པ་སྟེ་ཡན་ལག་དྲུག་དགོད་པའི་ཆོ་གའོ།",
    "ཨོཾ་ལོ་ཙ་ནཱ་ཡེ་ན་མ།",
    "ལྔ་པ་ནི་ཟར་མ་དང་བ་ར་ཊཱི་དང་བཇཱ་དང་ཀུ་ལན་ཐ་དང་ཙ་ན་ཀ་ནག་པོ་སྟེ་ལེ་ཚེ་སྦྱར་བའི་ཆས་འབྲུ་ལྔ་ཇི་ལྟར་རྙེད་པ་གཟུང་བར་བྱའོ།",
    "ཁུ་ཚུར་གྱིས་མཐེ་བོ་བསྡམས་པ་དག་བརླ་གཡས་པ་དང་གཡོན་པའི་སྟེང་དུ་རྡོ་རྗེའི་འདུག་སྟངས་ལ་གནས་པ་ནི་རྡོ་རྗེའི་ཕྱག་རྒྱར་འགྱུར་རོ།",
    "མངོན་དུ་ཕྱོགས་པ་སྟོན་པར་གྱུར་ན་འདུག་ཅིག་ཅེས་བརྗོད་པའོ།",
    "སླར་ཡང་རང་བཞིན་རྣམས་ཀྱིས་རྣམ་པ་མང་པོར་རིག་པར་བྱའོ་ཞེས་པ་ནི་ལྟ་སྟངས་ཀྱི་བརྡའི་ངེས་པའོ།",
    "ཕྱེད་དང་གཅིག་དུས་རི་བོང་ཅན།",
    "དེ་བཞིན་དུ་གཡོན་གྱི་གདོང་པ་གང་ཡིན་པ་དེ་ནི་གཡས་ཀྱི་སྟེ་དེའི་ཁ་དོག་ཉིད་ཀྱང་རང་འོད་ཅེས་པར་མི་འགྱུར་རོ།",
    "འདི་དག་དུས་ཀུན་རྣལ་འབྱོར་རྣམས་ལ་བདེ་མཉམ་འབྲས་བུ་སྟེར།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "༡༢༢༥དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "དེ་བཞིན་དུ་བཟའ་བར་བྱ་བ་དང་བཟའ་བར་བྱ་བ་མ་ཡིན་པ་བྱེད་ཅིང་རང་དང་གཞན་གྱི་གཟུགས་ཡོངས་སུ་སྒྱུར་བར་བྱེད་དོ།",
    "དེ་ལ་དེ་ནས་དཔལ་ལྡན་རྡོ་རྗེ་འཆང་ཞེས་པ་ལ་སོགས་པ་ནས་ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག་ཅེས་པའི་མཐར་ཐུག་པ་ནི་གསོལ་བ་འདེབས་པའི་ཚིགས་སུ་བཅད་པ་བཅུ་དྲུག་གོ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཞེས་པ་ནི་འཁོར་ལོ་གསུམ་གྱི་སྡོམ་པའི་མཁའ་འགྲོ་མ་རྣམས་ཏེ་དེ་རྣམས་རིགས་ལྡན་མའི་སྦྱོར་བ་ལ་ཐུན་མཚམས་ཀྱི་དབྱེ་བ་དང་།",
    "དེ་ལྟར་རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྒྱུ་བ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ་ཞེས་པ་ནི་ངེས་པའོ།",
    "པེ་སྣར་འདུག་པེ་སྣར་ཏེ།",
    "པེ་སྣར་འདུག་པེ་སྣར་པ།",
    "༢ པེ་སྣར་འདུག་༣པེ་སྣར་དེ་ནས་དབུག་༤པེ་སྣར་ཏཱི།",
    "པེ་སྣར་འདུག་༧༩ ༡པེ་སྣར་ཌཱ།",
    "པེ་སྣར་འདུག་པེ་སྣར་པའོ།",
    "ཧྰུཾ་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་ལྡེབ་འདིའི་བསྡུར་མཆན་༦པའི་མཚམས་སུ་པེ་ལ་བསྐྱར་ཟློས་སུ་འཁོད་འདུག་པས་བསྡུར་མཆན་དུ་པེ་བསྐྱར་ཟློས་ཞེས་བཀོད་ཡོད།",
    "འདུག་སྟངས།",
    "དེ་༡༢༡༤སྣར་བཞུག་༥ པེ་སྣར་གོ་རོ་ཙ་ན།",
    "འདི་པཎ་ཆེན་ཤཱཀྱ་ཤྲཱི་བརྡུགས་པའི་འཕྲང་བྱ་བ་ཡིན་གསུངས་ནས་བཀག་སྟེ་ཤིན་ཏུ་བདེན་ཟེར་བར་འདུག་གོ།",
    "ལྷག་མ་སྐར་མའི་གནས་ནས་གང་འདུག་ནི་འཁོར་ཕྱེད་མ་དོར་བའི་ལྷག་མ་ཡིན་ན།",
    "ཞེས་གསུངས་ཏེ་མ་ཕམ་གཡུ་མཚོ་ཕྱག་སོར་གྱི་རྩེར་བཏེགས་ནས་སླར་ཡང་རང་འཇགས་སུ་བཞག་གནང་མཛད།",
    "ཡང་སྟེང་དུ་ཕེབས་ནས་ཅུང་མཐོ་དྲག་འདུག་གསུངས་ནས་ཞབས་ཀྱིས་བརྫིས་པས་ཐོག་སྟེང་དུ་ཞབས་རྗེས་བཞག་ཕུག་པའི་མིང་ལ་རྫུ་འཕྲུལ་ཕུག་ཅེས་ད་ལྟའང་བརྗོད་པ་ཡིན།",
    "ཁོང་རང་རི་ལྡེབས་སུ་འགྲིལ་བ་བཅས་ཀྱི་རྗེས་ཤུལ་གངས་རིའི་ལྷོ་ངོས་སུ་གསལ་བ་དེ་ཡིན་ཞེས་ཟེར།",
    "ཇོ་བོ་རྗེས་ཀྱང་ཁྱེད་ལྟ་བུ་པཎྜི་ཏ་བོད་ན་བཞུགས་བཞིན་དུ་ང་བོད་དུ་འོང་དགོས་དོན་མིན་འདུག་ཅེས་ཀྱང་གསུངས།",
    "དབྱར་དུས་སྦུག་སུབ་དོག་པས་ཅུང་དམའ་དྲག་འདུག་གསུངས་ནས་དབུས་ཕུག་པ་ཡར་བཀྱག་གནང་བས་དབུ་རྗེས་ཕུག་པའི་ཐོག་ལ་དོད་ཡོད་པ།",
    "ཡང་དགུན་དུས་གྲང་ངར་ཆེ་དུས་ཕུག་པ་མཐོ་དྲག་འདུག་གསུངས་ནས་ཕུག་པའི་སྟེང་ནས་ཞབས་ཀྱིས་བཅག་བཅག་གནང་བས་ཞབས་རྗེས་ཕུག་པའི་སྟེང་དུ་དོད་ཡོད་པ།",
    "འདུ་ག་ན་འདུག་དང་།",
    "གནས་མང་པོ་མཇལ་མི་ཐུབ་པ་བྱུང་འདུག་ཀྱང་།",
    "གཞན་གྱིས་ང་ལ་མཐོང་ཚུལ་འདི་འདྲ་འདུག་ལ་ལས་འདི་འདྲ་དགེ་ཚོགས་ཚེ་ཞེས་ཟེར།",
    "ཞེས་པ་དཔྱིད་ས་ཞིང་རྨོ་བའི་དུས་ཏེ་སྤྱི་ཟླ་༣ པའི་ཚེས་༢ ནས་སྤྱི་ཟླ་༥ པའི་ཚེས་༤ བར་ཞག་༤༦ རིང་ལ་སྤར་ཁ་ཁོན་གྱི་སྐག་དུས་ཡིན་པས་དུས་དེར།",
    "ཞེས་པ་དགུན་ཆུ་ལ་ཆབ་རོམ་ཆགས་པའི་དུས་ཏེ་སྤྱི་ཟླ་༡༡ པའི་ཚེས་༧ ནས་༡༢པའི་ཚེས་༢ བར་ཞག་༤༤ རིང་སྤར་ཁ་དྭ་ཡི་སྐག་དུས་ཡིན་པས།",
    "ཞེས་པ་དབྱར་རྩྭ་ཐང་སྔོ་བའི་དུས་ཏེ་སྤྱི་ཟླ་༥ པའི་ཚེས་༥ ནས་སྤྱི་ཟླ་༦ པའི་ཚེས་༢ བར་ཞག་༤༦ རིང་སྤར་ཁ་ཁེན་གྱི་སྐག་དུས་ཡིན་པས་དུས་དེར།",
    "གསེར་གྱི་རྩེ་རྡོར་འོད་འབར་བ་ཅན་གྱི་རྡོར་དྲིལ་ཕྱག་ཏུ་བསྣམས་ཏེ་བཞུགས་འདུག་ངེད་ཀྱིས་ཀྱང་རུས་རྒྱུན་གྱོན་ཅིང་།",
    "ངས་རྗེ་ཉིད་བསྟན་འགྲོའི་དཔལ་དུ་ཞབས་སེན་ཡུན་བརྟན་གྱི་སྐུའི་ཚེ་སྒྲུབ་ལ་བརྩོན་ཆོག་པ་ཞེས་ཞུས་འདུག་པ་ནི་ཐུགས་གཟུ་བོར་གནས་པའི་གཏམ་སྟེ།",
    "ཡང་སེང་ངེར་ཆུ་ཁར་ཐོན་ནས་ཕར་ཙམ་དུ་སླེབས་འདུག་པས་རྗེ་ཉིད་ལ་དད་པ་ལྷག་པར་དུ་འཕེལ་ཞིང་།",
    "ཐ་ན་སྒོ་ཁྱི་ཇི་འདྲ་ཡོད་པ་ཚུན་ཤིན་ཏུ་གསལ་བར་གསུངས་འདུག་པ་རྣམས་ནི་རྫོགས་རིམ་གཉིད་དུས་ཀྱི་བསྲེ་སྐོར་ཉམས་སུ་བཞེས་པ་སོགས་ཐུགས་དམ་འོད་གསལ་གྱི་ཆོ་འཕྲུལ་འབའ་ཞིག་ལས་བྱུང་བར་ཤེས་དགོས་པ་ཞིག་གོ།",
    "རྩོད་རིག་ལ་འགྲན་ཟླ་དང་བྲལ་བ་ཡོད་འདུག་སྟེ།",
    "འཛམ་གླིང་འདིར་ལན་འདེབས་ནུས་པ་སུ་འདུག་གསུང་བར།",
    "ལན་གདབ་ཐུབ་པ་ང་འདུག་བྱ་བ་ཞུས།",
    "སྦྱོར་བཅུག་ཡང་ཡང་འདུག་གནས་དང་།",
    "ཞེས་གསུངས་འདུག་པས་ཞིབ་ཏུ་དཔྱད་པར་འདོད་ན་ལུང་ཞུ་བ་ཆེ་ཆུང་དངོས་སུ་མཇལ་ཏེ་དཔྱད་དགོས་པར་འདུག་གོ།",
    "གསུངས་འདུག་པས།",
    "འདུག་འགྲེང་སྤངས་སྟོབས་འདུས་ཟ་དང་།",
    "བར་ན་ག་དུས་༡༩ནུབ་ལྷག་སྡིག་ལྟ་ཁྲུས་ཆུ་རྩེ།",
    "ཞེས་མ་ལོན་མི་སྨྲ་དུས་མིན་འགྲོ།",
    "མ་བསྐོས་སོགས་དགུ་འདུག་མ་གཏོགས།",
    "སྐྱེས་པ་དང་ནི་འདུག་མི་བྱ།",
    "གནས་ནས་དབྱུང་བ་དང་ལྷན་ཅིག་གནས་པ་ཁོ་རང་བླངས་འདས་མིན་གྱི་ཕྱོགས་མཐུན་ཡིན་ལ།",
    "ཞེས་གསུང་འདུག་པས་སྐབས་འདིར་བླངས་འདས་ལ་གཞི་བཅུ་ལས་གྱུར་པའི་བླངས་འདས་བཞག་ནས་ཕྱོགས་མཐུན་གྱི་ཉེས་པ་ཐམས་ཅད་བླངས་འདས་བཅུ་པོ་ཅི་རིགས་དང་ཕྱོགས་མཐུན་པར་འཇོག་ཚུལ་བཞེད་དམ་སྙམ་ཡང་།",
    "བླངས་འདས་བཅུ་པོའི་ངོས་འཛིན་སྐབས་དེར་ཞལ་གསལ་མི་འདུག་པས་མཁས་པའི་གསུང་རྒྱུན་ཇི་ཡོད་དཔྱད་པར་ཞུའོ།",
    "ཁཌ་མཁཊ་༡མ་ལ་ལོ་ལ་འདུག་གནས་འདུས་ཟ་ཉལ་གཤོམ་གཉིས།",
    "ཡོམི་སྨྲ་མ་གུས་དུས་མིན་འགྲོ།",
    "རིམ་གཉིས་འདུག་གནས་ཕྱེ་དང་ནི།",
    "དཙ་ཁག་པོ་འདུག་ལ་ཉེ་བ་ན་རྗེས་སུ་འབྲལ་དང་སྤངས་པ་ཟ་བ་དང་།",
    "འདུག་པ་མ་གཏོགས་དགུ་དག་དང་།",
    "མ་བསྐོས་སོགས་དགུ་འདུག་མ་གཏོགས།",
    "ལམ་དང་དབེན་པར་འདུག་འགྲེང་ལྷན་ཅིག་ཉལ་བ་དང་།",
    "ཁོ་དབེན་པར་འདུག་དང་ཉལ་དང་དྲུག།",
    "སྦྱོར་བཅུག་ཡང་ཡང་འདུག་གནས་དང་།",
    "ཊཱི་ཀ་སྦྱོར་བཅུག་ཡང་ཡང་འདུག་གནས་དང་།",
    "ཞི་བ་ཁག་མ་བསྐོས་སོགས་དག་འདུག་མ་གཏོགས།",
    "ཁྲི་རྐང་བཅས་སྣོད་སྤྱད་ལ་བརྟེན་པ་དགུ་འདྲེན་པར་མཛད་འདུག་པས་དཔྱད་པར་བྱའོ།",
    "སྐྱོད་གདིང་ཕྱི་གནོན་འབྱུང་འདུག་གནས།",
    "ཞེས་གསུངས་པ་ཙམ་ལས་བཅུ་གསུམ་གང་ཡིན་ངོས་འཛིན་མཛད་མི་འདུག་ཀྱང་།",
    "རང་རང་དངོས་གཞི་དམིགས་བསལ་སྤྱོད་ལམ་བཞི།",
    "མི་ཤོང་ན་ཡང་ལྷན་ཅིག་འདུག་འགྲེང་གསུམ།",
    "སྤྱི་ཚད་དང་རང་ཚད་གཉིས་ཡོད་པ་ལས།",
    "ཞེས་སྔོ་སེར་དམར་གསུམ་དང་དཀར་ནག་གཉིས་ཀྱང་ཁ་དོག་རུང་བར་བཞག་འདུག་ཅིང་།",
    "ཡང་ཡང་འདུག་གནས་ཕྱེ་དང་ནི།",
    "གོས་སྟེར་དང་ནི་འདུག་གནས་ཟ།",
    "ངན་པ་བསྒོ་གྱུར་བཞི་དང་འཁྲུར་འཇུག་ནས་གྲགས་འདུག་མ་སོ་སོའི་བར་དྲུག་རྨེལ་བ་དང་།",
    "བཞག་ན་འབྲལ་ཡང་རང་བཞིན་མཚམས་གཅིག་པ།",
    "མཚམས་ལ་ལས་ཀྱིས་བཅད་པའི་མཚམས་དང་རང་བཞིན་གྱི་མཚམས་གཉིས་སུ་ཡོད་ཅིང་།",
    "ནམ་མཁའ་ལ་འདུག་པར་མི་བྱའོ།",
    "ཞེས་གསུངས་འདུག་པས་དཔྱད་པར་ཞུའོ།",
    "གཎྜི་འབྲིང་པོའི་ཚད་སྡོམ་ལས་ང་རང་།",
    "ས་འདུག་ལྔ་ལྔར་ཕྱེ་བས་ཆོ་ག་ཉེར་ལྔ་འོ།",
    "གཅིག་ལས་མེད་ན་གཅིག་པུར་འདུག་ནས་ནི།",
    "མ་དད་གྲོང་དང་རང་སྲོག་གནོད་པ་སྤོང་།",
    "བྱ་བྱེད་འབད་པ་དགག་དབྱེ་བྱེད་པོའི་མདུན་འདུག་ཀུ་ཤ་ལ།",
    "བཅོས་མ་དང་རང་འཇུག་བྲལ་གཉིས་ཡོད་པ་ལས།",
    "དེ་དག་དུས་རུང་ཡིན་པའི་ཕྱིར་ཁྱབ་སྟེ།",
    "ཞེས་གསུངས་འདུག་པའི་ཕྱིར་ཟེར།",
    "གཞན་དུ་འདུག་སྟེ་ལེན་པ་དང་།",
    "མདུན་དུ་མ་འདུག་པར་ལེན་པ་དང་།",
    "༢༩ སྦྱོར་དུས་ལུས་ཀྱིས་ཚུལ་བཞིན་འདུག་པ་དང་།",
    "རང་རང་ལས་འཆགས་དེར་བརྟེན་འབྲས་བུ་ནི།",
    "འོན་ཀྱང་རང་ལ་བསྙེན་རྫོགས་ཕྱིར་བཟློག་འཆགས།",
    "རྗེས་གནང་བཞི་དང་རང་དོན་ལ་སྦྱར་གཉིས།",
    "འདི་ཐད་དུ་མི་མཐུན་ཉེར་བདུན་ཞེས་གསལ་འདུག་པས།",
