    "གནས་དང་རང་བཞིན་མཚན་ཉིད་ཤེས་པ་དག།",
    "རྣ་བ་སྣ་ཡང་རང་བཞིན་གྱིས།",
    "ངོ་ནི་ཇི་ལྟར་འདུག་པ་བཞིན།",
    "དེ་དག་ལུས་དང་ངག་ཡིད་རྟག་དུས་སུ།",
    "ཀུན་ཀྱང་རང་རང་སོ་སོའི་ལས་ལ་འཇུག།",
    "རང་རང་ལུས་ཀྱང་ཕྱོགས་རྣམས་ཀུན་ཏུ་སྟོན།",
    "མིག་ནི་མ་སྐྱེས་མ་བྱུང་རང་བཞིན་ཏེ།",
    "རྣ་བ་མ་སྐྱེས་མ་བྱུང་རང་བཞིན་ཏེ།",
    "སྣ་ནི་མ་སྐྱེས་མ་བྱུང་རང་བཞིན་ཏེ།",
    "སེམས་ནི་མ་སྐྱེས་མ་བྱུང་རང་བཞིན་ཏེ།",
    "འགྲོ་འདུག་ཉལ་ཞིང་འགྲེང་བ་དེ་བཞིན་ཏེ།",
    "སོ་སོ་རང་རང་གཟུགས་བརྙན་ཚུལ་བཞིན་མཐོང་།",
    "སྒྲ་སྐད་ཀུན་ཏུ་རང་རང་སྐད་དུ་བརྗོད།",
    "བརྒྱ་བྱིན་རང་རང་མདུན་ན་འདུག་པར་ཤེས།",
    "མ་ལུས་ཀུན་ཏུ་འདུག་པར་རབ་ཏུ་སྣང་།",
    "སྐབས་དེར་ང་རང་ལ་མི་ལོ་བརྒྱད་ཀྱི་ལོ་ཚད་སྤར་ཡང་དེ་ཙམ་གྱི་སྡུག་བསྔལ་འཕར་མ་ཞིག་མ་བྱུང་།",
    "ངས་ཡིད་སྐྱོའི་གནས་ཚུལ་དེ་ཐོས་སྐབས་ཡུད་ཙམ་རིང་ང་རང་དྲན་མེད་དུ་ལུས།",
    "ཡིན་ནའང་ཆུང་བྱིས་པའི་དུས་ནས་ཆབ་སྲིད་ཀྱི་བཙོན་པ་ཞིག་ཏུ་གྱུར་པའི་རྐྱེན་འདི་ད་ལྟ་བསམ་ཞིབ་བྱེད་དུས་རང་ཉིད་ཀྱི་ཁྱིམ་ཚང་དང་ཆུང་དུས་ཀྱི་འཚོ་བ་དང་འབྲེལ་བ་ཆེན་པོ་བྱུང་འདུག་བསམ་གྱི།",
    "ང་རང་ཡང་ཆུང་དུས།",
