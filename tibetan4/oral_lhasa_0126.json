    "བསྙེན་པར་མ་རྫོགས་པ་ལ་འཁྲུར་བཅོལ་བ་དང་།",
    "འགྲོ་བ་གཞན་དུ་གནས་པ་ལ་འཁྲུར་བཅོལ་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ས་ལེ་སྦྲམ་ལེན་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་རྒྱལ་པོའི་ཁབ་བྱ་ཀ་ལན་ད་ཐུཀ་གནས་པའི་༥འོད་མའི་ཚལ་ན་བཞུགས་སོ།",
    "མུ་སྟེགས་ཅན་རྣམས་ཀྱང་དགེ་སློང་འདི་དག་ཁྱེམ་པ་དང་ཁྱད་པར་ཐུཅི་ཡོད།",
    "བསམ་པ་ནི་ཅི་ཐ་དད་ཅེས་འཕྱ་ཞིང་མི་སྙན་པར་འཛེར་ཏོ།",
    "ས་ལེ་སྦྲམ་ལེན་དུ་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "འདི་སྙེད་ཅིག་ཁྱེར་ཤོག་ཅེས་བསྒོ་བའི་ཚེ་ན་ནི་ཉེས་བྱས་སོ།",
    "མ་བླངས་པ་དགེ་སློང་དག་ལ་བྱས་པ་དང་།",
    "རུང་བ་མ་ཡིན་པ་འདིས་རུང་བའི་གོས་ཤིག་བསྒྲུབ་པོ་ཞེས་ལན་གཉིས་ལན་གསུམ་དུ་བརྗོད་པར་བྱའོ།་།",
    "ལྐུགས་པ་ལ་གསེར་དངུལ་ལེན་དུ་བཅུག་ཀྱང་རུང་སྟེ་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "གསེར་དངུལ་བླངས་ཀྱང་ཉེས་པར་མི་འགྱུར་བ་ཡོད་དེ།",
    "བྱེད་མཚན་མ་བཏབ་པ་ཡོ་བྱད་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "ད་བེེན་ཆད་མཚན་མ་བཏབ་པ་རྣམ་པ་སྣ་ཚོགས་ལ་སྤྱོད་ཅིང་བཟང་ངན་བརྗེར་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "མཚན་མ་བཏབ་པ་ལ་སྤྱོད་པར་བྱེད་ཅེས་བྱ་བ་ནི་སྤོགས་བྱེད་པ་དང་།",
    "ནས་འབྲས་སྐྱེད་དང་བུན་འགྱེད་པའི་ཚེ་ན་ནི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ནོར་སྣ་ཚོགས་སྤོགས་བྱེད་པ་ནི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ལྷན་ཅིག་ཏུ་ནོར་ལྷག་སྤོགས་བྱེད་ན་ཉེས་བྱས་སོ།",
    "མི་ལ་མི་མ་ལགས་པར་འདུ་ཤེས་ན་ཉེས་བྱས་སོ།",
    "བསྙེན་པར་རྫོགས་ཁ་དང་བསྙེན་པར་མ་རྫོགས་པ་ན་བཏང་ཡང་ཉེས་བྱས་སོ།",
    "ཉོ་ཚོང་བྱེད་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ཛེ་ཏའི་ཚལ་ན་བཞུགས་སོ།",
    "ཁེའི་ཕྱིར་ཉོ་ན་ཉོ་བའི་ཚེ་ཉེས་བྱས་སོ།",
    "རྙིང་པ་ཀུན་ཚོང་གྱིས་ཤིག་ཅེས་རྗེས་སུ་གནང་ངོ།",
    "སྤང་བའི་བཅུ་ཕུང་ཐ་མ་ལྷུང་བཟེད་ལྷག་མ་བཅང་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "བདག་ལ་ལྷུང་བཟེད་མཁོའོ་ཞེས་བྱས་སོ།",
    "ཀཱར་ཥཱ་པ་ཎ་དྲུག་ཅུ་རིའོ་ཞེས་བྱས་པ་དང་།",
    "སླད་ཀྱིས་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་པའི་ཚེ།",
    "ཞག་བཅུ་ལས་ལྷུང་བཟེད་ལྷག་མ་འཆང་དུ་མ་གནང་བར་བཅས་སོ།",
    "ཉེས་པ་མ་བཤགས་ན།",
    "ཞག་བཅུ་ལས་ཁྲུང་བཟེད་ལྷག་པར་བཅངས་ཀྱང་ཉེས་པ་མེད་དེ།",
    "མ་བསྲེགས་པ་དང་དཀར་པོ་བཅངས་ན་ཉེས་བྱས་སོ།",
    "གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་དེ་ལྷུང་བཟེད་ལྷག་པ་ཞག་བཅུ་ལས་འདས་པར་སྣེབཅངས་ཀྱང་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ལྷུང་བཟེད་སྤྱད་བཟོད་པ་ཡོད་བྱེབཞིན་དུ་ལྷག་པར་བཟང་པོ་ཚོལ་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "ཁྱེའུ་དེས་ནང་པར་སྔར་དགེ་སློང་བསོད་སྙོམས་པ་ཞིག་དེར་འོངས་པ་ལ་ལྷུང་བཟེད་བཙོངས་ན་མ་འདོད་དོ།",
    "བསྙེན་དགའ་བོས་ཐོས་ནས་དེས་སྤུགཞན་ལ་བྱས་སུ་དོགས་ནས་གཞན་གྱིས་མི་ཐོས་པར་བྱ་བའི་ཕྱིར།",
    "ལྷུང་བཟེད་བཟང་པོ་ཚོལ་དུ་མི་གནང་བར་བཅས་སོ།",
    "དེ་ལྟར་ལྷུང་བཟེད་བཟང་པོ་ཚོལ་དུ་མི་གནང་བ་དང་།",
    "སྤྱད་བཟོད་པར་ཉེཡོད་བཞིན་དུ་ཞེས་བྱ་བ་ནི་སྤྱད་དུ་རུང་བའོ།",
    "ལས་ལྷག་པར་བཟང་པོ་འདོད་པའོ།",
    "གཉེན་མ་ཡིན་པའི་ཐ་ག་པ་ལ་གོས་འཐག་ཏུ་བཅུག་པའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "དེའི་ཚེ་བསྙེན་དགའ་བོས་བསམས་པ་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱེས་སློང་དུ་མི་གནང་བའི་སྡོམ་པ་བཅས་པས་རྙེད་པ་ཡང་རབ་ཏུ་ཉུང་ན་ད་ཅུང་ཟད་རྙེད་པ་དག་སྒྲུབ་པོ་སྙམ་ནས་ཁང་ཐོག་ཏུ་འཛེགས་ཏེ་བལྟས་ན།",
    "དེ་བཟོ་དཔོན་ལ་བྱས་ན་ཐ་ག་པ་གཞན་ལ་བཅོལ་དུ་མི་རུང་ངམ་ཞེས་དྲིས་པ་དང་།",
    "རྒྱལ་པོ་དང་བློན་པོའི་མཐུས་འཐག་ཏུ་བཅུག་གོ་ཞེས་མི་སྙན་པར་འཛེར་ཏོ།",
    "གཉེན་མ་ཡིན་པ་ལ་འཐག་ཏུ་མི་གནང་བར་ཧུ།",
    "གཉེན་མ་ཡིན་པ་ལ་སྐུད་པ་དང་བལ་སློང་བའི་ཚེ་ཉེས་བྱས་སོ།",
    "གཉེན་མ་ཡིན་པ་ལས་སྐུད་པ་བབེེངས་ཏེ་བདག་ཉིད་ཀྱིས་བཏགས་ན་ཉེས་བྱས་སུ་འགྱུརཁྱེ།",
    "གཞན་གྱི་ཕྱིར་བཅོལ་བ་ནི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "མི་མ་ཡིན་པ་ལ་འཐག་ཏུ་བཅུག་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "གཉིས་ཀ་མི་རུང་སྤྱོདང་འདྲེས་པ་འཐག་ཏུ་བཅུག་ན་ཉེས་བྱས་སོ།",
    "འཐག་པ་གཉིས་པའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "དེ་ཡང་ཡིད་མ་ཆེས་ཏེ་ཕྱིར་བསྡིགས་ཁྱེན་འཕགས་པ་མང་དུ་སྨྲ་མི་འཚལ་གྱིས་ཐ་ག་པའི་གན་དུ་བཞུད་ཅིག་ཅེས་བྱས་ནས་ཐ་ག་པ་དང་ཕྲད་ནས་གོས་དེ་ངའི་ཕྱིར་འཐག་པ་ཡིན་གྱིས།",
    "བསྙེན་དགའ་བོ་དང་ཐ་ག་པ་གཉིས་ཀྱིས་ཐབས་བྱས་ནས།",
    "དེ་ཡང་གླ་མ་བྱིན་པའི་སྟེང་དུ་དངོས་ཀྱང་བཟུང་བས་འཕྱ་ཞིང་མི་སྙན་པར་འཛེར་བས་དེ་ལྟར་གྱུར་པ་སྙན་དུ་བདས་སོ།",
    "ཞེས་མགྲོན་དུ་མ་བྱས་པའོ།",
    "རྣམ་པར་རྟོག་པ་འགའ་ཞིག་བྱུང་ཞེས་བྱ་བ་ནི་གཞན་ལས་ཐོས་པའོངའི་ཕྱིར་ཞེས་བྱ་བ་ནི་བདག་ཉེ་བར་སྟོན་པའོ།",
    "བཅའ་བ་ཅུང་ཟད་ཅིག་ཕྱེབྱིན་ནས་གོས་གྲུབ་ཅེས་བྱ་བ་ནི་ལག་པར་ཐོབ་པའོ།",
    "གོས་གྲུབ་པའི་ཕྱིར་འཐག་ཛེེཔ་ལ་བསྒོ་བའི་ཚེ་ནི་ཉེས་བྱས་སོ།",
    "འདི་ལྟ་བུ་ཞིག་ལོང་ཤིག་པར་བསྒོ་བ་ནི་ཉེས་པ་མེད་དོ།",
    "བྱིན་ཕྲོག་སྤུམི་གནང་བའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "སྟོན་ཟླ་ཐ་ཆུངས་ཀྱི་༦གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "བསྙེན་དགའ་བོས་གཞན་དག་དེར་དོང་དུ་དོགས་ནས་ཐབས་ཤིག་བྱས་ཏེ།",
    "དབྱར་ཟླ་བ་གསུམ་གྱི་ཡོ་བྱད་བགོས་ནས་ཟླ་བ་གཅིག་ཏུ་ཟད་པར་བྱས་ཏེ་ཕྱིར་དོང་བས་ན་ཕྱིས་ཚོང་པ་དག་གཙུག་ལག་ཁང་དུ་འོངས་ཏེ།",
    "ཞེས་བྱས་པ་དང་།",
    "དབྱར་གྱི་རྙེད་པ་དུས་མ་ཡིན་པར་ལེན་ཅིང་འགྱེད་དུ་མི་གནང་བར་བཅས་སོ།",
    "དེ་ནས་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་བློན་པོ་དམག་དཔོན་ཁ་འདའ་ཤག་ཏི་དམག་དཔོན་དུ་བཀའ་སྩལ་ནས།",
    "བསླབ་པ་ལ་ནན་ཏན་བྱེད་པའི་བསྔགས་པ་བརྗོད་པས་སྐྱེཞག་བཅུས་ཚུལ་ནས་མ་བྱུང་བ་ལ་གཏད་པའི་གོས་ལེན་དུ་རྗེས་སུ་གནང་སྟེ།",
    "དེ་ལས་སྔར་ལེན་ཞིང་འགྱེད་དུ་མི་གནང་བ་དང་།",
    "གོས་སྦེད་པའི་དགེ་སློང་ཡོན་ཏན་ལྔ་དང་ལྡན་པའི་དགེ་སློང་ཞིག་བསྐོས་ལ་དབྱར་གྱི་ནང་ལོགས་སུ་ལེན་དུ་ཡང་མི་གནང་།",
    "གཏད་པའི་གོས་འགྱེད་པའི་དུས་ལས་འདས་པར་བཅངས་ཀྱང་ཉེས་པར་མི་འགྱུར་བ་ཡང་ཡོད་དེ།",
    "དེ་ནས་དགེ་སློང་འདི་དག་ཀྱང་ཡོན་བདག་ལ་ནི་བ་བཞོས་པ་བཞིན་དུ་བྱ་དགོས་ཀྱི་དོང་ངོ་ཞེས་ནས་གཅེར་བུས་མཉན་དུ་ཡོད་པར་ཕྱིན་ཏེ།",
    "དེ་ལྟར་བྱེད་པ་བདེན་ནམ་ཞེས་སྨྲས་ན་མད་དོ་ཞེས་གསོལ་ནས་ད་སླན་ཆད་ཞག་བདུན་ལས་འདར་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "དབྱར་གྱི་རས་ཆེན་དུས་ལས་སྔོན་རོལ་དུ་བཙལ་ཏམ་དབྱར་འདས་པར་འཆང་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "དེའི་ཚེ་དགེ་སློང་དག་རྫིང་བུ་དང་ཁྲོན་པ་དག་ན་ཁྲུས་བྱེད་པའི་ཚེ་སྐྱབས་མེད་པར་ཁྲུས་བྱེད་པས་ནི་ན།",
    "དུས་མ་ཡིན་པར་རས་ཆེན་ཚོལ་ཞིང་བྱེད་པས་ན་བྱ་བ་དང་།",
    "གསོ་དཀའ་བ་དགང་དཀའ་བ་ཞེས་སྨད་ནས་སྔོན་རོལ་དུ་ཚོལ་དུ་མི་གནང་བ་དང་།",
    "དབྱར་ཟད་ནས་ཟླ་བ་ཕྱེད་ལས་འདས་པར་འཆང་དུ་མི་གནང་བར་བབེེབ་པ་བཅས་སོ།",
    "དབྱར་ཟད་ནས་ཟླ་བ་ཕྱེད་ཀྱི་བར་དུ་ཆོངས་ཤིག་ཅེས་བྱ་བ་ནི་དེ་ལས་འདས་པར་རོ།",
    "དབྱར་གྱི་རས་ཆེན་ཕྲིན་དང་ཕྲིན་ཡིག་དང་ལག་བརྡ་དང་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པས་རིང་དུ་བཅངས་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "འགྲོ་བ་གཞན་དུ་གནས་པ་ལ་དེ་བས་སྔོན་རོལ་དུ་བཙལ་ཏམ་དེ་དག་ལས་རྙེད་པ་རིང་དུ་བཅངས་ཀྱང་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "བསྙེན་དགའ་བོས་སྐྱེ་ཉེས་སོ་ཞེས་བྱས་པ་དང་།",
    "བསྔོས་པའི་སྤུཚེ་ནི་ཉེས་བྱས་སོ།",
    "འགོད་ཀྱེཔའི་ཚེ་ནི་ཉེས་བྱས་སོ།",
    "ཐོབ་ན་ཡང་ཉེས་བྱས་སོ།",
    "དེ་ལས་འདས་པར་བཅང་བར་མི་གནང་སྟེ་དེ་ལྟར་གྱུར་པ་ལ་དགེ་སློང་དག་འཕྱ་བ་སྙན་དུ་བདས་ནས།",
    "དེ་ལས་འདས་པར་བཞག་ན་སྤང་བའི་ཏྲིང་བར་འགྱུར་རོ་ཞེས་བསླབ་པ་བཅས་སོན་བ་ཞེས་བྱ་བ་ནི་མི་བདེ་བའོ།",
    "འདོད་ཅེས་བྱ་བ་ནི་གལ་ཏེ་འདོད་པར་གྱུར་པའོ།",
    "དེ་ལས་འདས་པར་བཞག་ན་ཞེས་བྱ་བ་ནི་དེ་ལས་འདས་པར་རོ།",
    "ཞག་བདུན་པ་ཡང་ཞག་བདུན་ཚུན་ཆད་དུ་སྤྱད་པར་བྱ།",
    "དེ་ལས་འདས་པར་བཅངས་ན་ཐམས་ཅད་དུ་སྤང་བའི་རྩང་བར་འགྱུར་བར་རིག་པར་བྱའོ།",
    "ཤེས་བཞིན་དུ་བརྫུན་དུ་སྨྲ་བའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་རྒྱལ་པོའི་ཁབ་ན་བཞུགས་སོ།",
    "ག་ལ་བཞུགས་ཞེས་དྲིས་ན།",
    "བཅོམ་ལྡན་འདས་འོད་མའི་ཚལ་ན་བཞུགས་ན་ནི་བྱ་རྒོད་ཕུང་པོའི་རི་ལ་བཞུགས་སོ་ཞེས་ཟེར།",
    "བདག་ཅག་ལ་ཐོ་འཚམས་སམ་དེ་བཞིན་ནོ་ཞེས་བྱས་པ་དང་།",
    "སླད་ཀྱིས་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་པའི་ཚེ་མཉན་དུ་ཡོད་པ་ན་ཤཱཀྱའི་བུ་དགེ་སློང་མེ་བཞི་སྐྱེས་སྣོཞེས་བྱ་བ་ཞིག་གནས་ཏེ།",
    "དེའི་ཚེ་ལྷོའི་ཕྱོགས་ནས་བྲམ་ཟེའི་བུ་ཞིག་སྔགས་ཚོལ་ཞིང་མཉན་དུ་ཡོད་པར་ཕྱིན་ཏེ།",
    "སྔར་གནས་པའི་བྲམ་ཟེ་དང་ཅུང་ཟད་འགྱེད་པར་བྱས་པ་ལས།",
    "བྲམ་ཟེ་དང་ཕྲད་ནས་ང་ནི་བརྗེད་དོ་བྱེཞེས་བྱས་སོ།",
    "ཕྱི་དེ་ཉིན་དུས་བྱས་པ་དང་།",
    "ཕས་ཕམ་པར་འགྱུར་བ་དང་ལྷག་མར་འགྱུར་བ་དང་།",
    "ཉེས་བྱས་སུ་འགྱུར་བ་དང་།",
    "ལྟ་བ་ལོག་པར་ཞུགས་པ་དང་།",
    "ཆོ་ག་ལོག་པར་ཞུགས་པ་དང་།",
    "འཚོ་བ་ལོག་པར་ཞུགས་པའོ།",
    "སེམས་འཁྲུགས་པ་དང་ར་རོ་བ་ལས་མིའི་སྐྱོན་ནས་བོས་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "མུ་སྟེགས་ཅན་ལ་སོགས་པ་ལ་སྐྱོན་ནས་བོས་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཕྲ་མའི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "སྐྱོ་སྔོགས་ཀྱི་གླེང་གཞི་ནི་བཅོམ་ལྡན་འདས་མཉན་དུ་ཡོད་པ་ན་བཞུགས་སོ།",
    "སྤངས་པར་ཙཤེས་བཞིན་དུ་བེེར་ཡང་དེ་ལས་སུ་མི་རུང་སྟེ་མ་བྱས་ལེགས་པར་མ་སྦྱངས་པས་སླར་ཁྱེ་སྦྱང་དགོས་སོ་ཞེས་ཡང་ནས་ཡང་དུ་སྐྱོ་སྔོགས་བྱས་ཏེ།",
    "འཐབས་ནས་རྩོད་པ་དང་མ་འཐབས་མ་བཅོས་པར་རྩོད་པ་དང་།",
    "སྤངས་པ་ཞེས་བྱ་བ་ནི་རྩོད་པ་རྣམ་པ་བཞི་པོ་གང་ཡང་རུང་སྟེ་ཞི་བར་བྱས་སོ།",
    "མ་སྤངས་པ་ལ་ཡང་སྤངས་པའི་འདུ་ཤེས་ཀྱིས་༨སྐྱོ་སྔོགས་བྱེད་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཇེ་ཚོམ་ཟ་ན་ཡང་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "སྐྱེས་པ་འདི་ལྟ་བུ་དང་འདི་འདྲར་བྱེད་པ་ཛེེན་ཅི་ཞེས་བྱས་པ་དང་།",
    "དེ་ལྟ་བུ་ནི་ཡོང་མ་བྱས་སོ།",
    "གཉི་ག་ཡང་མཐུན་ཏེ་འཆར་བས་བསྟན་ཏོ་ཞེས་བྱས་པ་དང་།",
    "བསྙེན་པར་མ་རྫོགས་པའི་གང་ཟག་དང་།",
    "ཅིག་ཅར་གདོན་དུ་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "བསྙེན་པར་མ་རྫོགས་པའི་གང་ཟག་ཅེས་བྱ་བ་ནི་དགེ་སློང་ཕ་དང་དགེ་སློང་མ་ཞེས་བྱ་བ་མ་གཏོགས་པ་གཞན་ཐམས་ཅད་དོ།",
    "སློབ་དཔོན་གྱིས་སྡོག་པ་ཐམས་ཅད་མི་བྱའོ་ཞེས་བྱས་པ་དང་།",
    "བསྙེན་པར་རྫོགས་པ་ལ་མ་སྡོགས་པར་འདུ་ཤེས་ན་ཉེས་བྱས་སོ།",
    "བསྙེན་པར་མ་སྡོགས་པའི་གང་ཟག་ལ་གནས་ངན་ལེན་གྱིས་ཞུཉེས་པ་བརྗོད་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "བསྙེན་པར་མ་རྫོགས་པར་རྩེཞེས་བྱ་བ་ནི་དགེ་སློང་ཕ་དང་དགེ་སློང་མ་གཉིས་མ་གཏོགས་པར་གཞན་ཐམས་ཅད་དོ།",
    "སྐྱེསོ་སོར་རིག་པར་བྱ་བའི་རིགས་རྣམས་ལ་སོ་སོར་རིག་པར་བྱ་བ་མ་ཡིན་པར་འདུ་ཤེས་སམ།",
    "ཚོ་ཇེ་ཚོམ་བཞིན་དུ་སོ་སོར་རིག་པར་བྱས་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དེ་དག་སྔོན་མུ་གེ་བྱུང་བའི་ཚེ་ན་ནི་ཡོན་ཏན་མེད་བཞིན་དུ་སྨྲས་པས་ཕས་ཕམ་པར་བབེེབ་པ་བཅས་སོ།",
    "བསྙེན་པར་མ་རྫོགས་པ་ནི་སྔ་མ་བཞིན་ནོ།",
    "ཅི་ངེད་ཅག་ཀྱང་མྱ་ངན་བྱེད་དུ་ཡང་མི་གནང་ངམ་ཞེས་བྱས་པ་དང་།",
    "སྔར་མཐུན་ཏེ་རུང་བར་བྱས་ཞེས་བྱ་བ་ནི་སྔར་ཚོགས་པས་མཐུན་པར་བྱིན་པའོ།",
    "ཚེ་དང་ལྡན་པ་དག་བསླབ་པའི་གནས་ཕྲན་ཚེགས་འདི་ལྟ་བུ་ཟླ་བ་ཕྱེད་ཕྱེད་ཅིང་གདོན་ཅི་དགོས་དགེ་སློང་རྣམས་ཞུམ་པ་དང་བག་འཁུམས་པར་གྱུར་ཏེ།",
    "ཉེས་པ་ཁ་ཅིག་ནི་བཤགས་ཁ་ཅིག་མ་བཤགས་པ་ཡང་༦ཡོད་དེ།",
    "ཤིང་གཅོད་དྷིདུ་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "མཚན་མ་ལྟ་བུ་བྱུང་ན་གཅོད་དུ་མི་གནང་ཞེས་གསུངས་ཏེ་དེའི་ཚེ་བསླབ་པ་མ་བཅས་སོ།",
    "ས་བོན་གྱི་ཚོགས་ནས་འབྱུང་པོའི་གནས་འཇིག་ཏུ་མི་གནང་བར་བཅས།",
    "བཏབ་པ་ལས་སྐྱེས་པར་གྱུར་པའོ།",
    "སྐམ་པོ་ལ་སྔོ་བར་འདུ་ཤེས་ཏེ་བཅད་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "སླད་ཀྱིས་གྱད་བུ་ནོར་གྱིས་ངེད་གཉིས་མནར་ཏོ་ཞེས་བྱས་སོ།",
    "བསྒོ་བའི་ལན་ལོག་པར་འདོན་པའི་གླེང་གཞི་ནི་ཀོ་ཤཱསྦྱིའི་དགྲ་ཟིན་གྱི་ཀུན་དགའ་ར་བ་ནའོ།",
    "ལོག་པར་ལན་ལྡོན་པ་གཉིས་བྱེད་བྱེད་པས་སྙན་དུ་བདས་ཏེ།",
    "ཀྱེ་མའོ་ཡོན་བདག་དད་པ་ནི་ཤ་ཁྲག་ཟད་ཟད་དུ་སྦྱོར་ཞིང་སྦྱིན་ན་དགེ་སློང་རྣམས་ནི་ཚོད་མི་ཟིན་པར་སྤྱོད་དོ་ཞེས་ནས།",
    "ཕྱིས་དགེ་སློང་དག་ལྷགས་པ་དང་སླན་ཆད་མལ་སྟན་མ་བསྡུས་ལྐུཔར་གྲོང་དུ་འགྲོར་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "ནང་པར་བདག་ནི་འགྲོ་ཞེས་མལ་སྟན་དག་གཏད་པ་ལས་རིང་དུ་ཐོགས་ནས།",
    "བསྙེན་པར་མ་རྫོགས་པ་ཐམས་ཅད་ལའོ།",
    "གདིང་བ་མ་བསྡུས་པར་འགྲོ་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "ད་སླན་ཆད་རྩྭ་བཏིང་བ་མ་བརྟུལ་ཏམ་བརྟུལ་ཏུ་མ་བཅུག་པར་འགྲོར་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "དེ་དག་ནང་པར་རྩྭ་ཀྱེ་སྡུད་ཅིང་འཁོད་པ་ལས་རིང་དུ་ཐོགས་ནས་འགྲོན་པ་མང་པོ་དང་བྲལ་ཏེ་ལམ་དུ་རྐུན་པོས་བཅོམ་པ་སྙན་བླ་དུ་བདས་ཏེ།",
    "དགེ་སློང་སྐྱོད་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "སློབ་དཔོན་འདི་ནི་རྙེད་པའི་གཎྜི་ཞིག་ཀྱང་སྲིད་ཀྱིས་འདོང་ཞེས་བྱས་ན་སྤྱོད་སྔར་དེང་ལ་ངའི་སྐལ་བ་ཡང་ནོས་ཤིག་ཅེས་བྱས་ནས་སྔར་དོང་ངོ།",
    "སློབ་དཔོན་ཀུན་སྟ་གོན་བགྱིས་ལགས་ཀྱིས་གཟིམས་ཞེས་བྱས་པ་དང་།",
    "ཞེས་ནས་མ་བཏུབ་པར་མཉན་དུ་ཡོད་པར་དོང་སྟེ་ལྷགས་པ་དང་།",
    "དེ་ལྟར་གྱུར་པ་ཞིབ་ཏུ་དགེ་སློང་དག་ལ་བྱས་པ་སྙན་དུ་བདས་པ་དང་།",
    "དགེ་སློང་སྔ་ན་གནས་ཤིང་འཁོད་པ་ལ་ཕྱིས་འོངས་ཤིང་གནོན་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "གནོད་པར་བྱེད་ཅེས་བྱ་བ་ནི་མི་བདེ་བར་བྱས་པའོ།་།",
    "འདི་འགྲོ་ཞེས་བྱ་བ་ནི་གཞན་མ་ཡིན་པར་དེ་ཉིད་ཀྱིས་བྱས་པའོ།",
    "རྒོལ་བ་ནི་ཚར་བཅད་དུ་འདོང་ངོ་ཞེས་ནས་དེ་གཉིས་ཀྱང་འགྲོགས་ཏེ་དོང་ནས་ཉེ་འཁོར་ལས་འདས་པ་དང་བསྙེན་དགའ་བོས་རྒན་པོ་ལ་གནས་འཆར་གཞུག་ཅིང་ཡོ་བྱད་དག་བསྒུར་ཕྱེབར་བྱས་ན་མ་བཏུབ་སྟེ་བདག་ནི་གནས་དབེེན་པ་འཆའོ།",
    "གཏམ་སྣ་ཚོགས་ལ་དགའ་བ་ནི་སྟོན་པས་སྨད་པ་ཡིན་ཀྱིས་གཎྜི་༤བརྡུངས་པ་ཡང་རྙེད་པའི་གཎྜི་སྲིད་ན་འདོང་ངོ་ཞེས་བྱས་ན་དེ་ནི་ལས་ཀྱི་གཎྜི་རྨྱེཏེ།",
    "རིང་ཞིག་བསྡད་ཀྱང་མ་འོངས་ནས་སྒོ་བཅད་དེ་ཉལ་ལོ།",
    "སྲོག་ཆགས་དང་བཅས་པའི་ཆུ་འདེབས་སུ་མི་གནང་བའི་གླེང་གཞི་ནི་ཀོ་ཤཱསྦྱིའི་དགྲ་ཟིན་གྱི་ཀུན་དགའ་ར་བ་ན་སྟེ།",
    "ཆུ་དང་རྩྭ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཆུས་སྤྱད་པར་བྱ་བའི་གནས་ཐམས་ཅད་ལ་བྱའོ།",
    "གཙུག་ལག་ཁང་རིམ་པ་གཉིས་ལས་རྩིག་ཏུ་མི་གནང་བའི་གླེང་གཞི་ནི་ཀོ་ཤཱསྦྱིའི་དགྲ་ཟིན་གྱི་ཀུན་དགའ་ར་བ་ན་སྟེ།",
    "དེ་ན་དགེ་སློང་གནས་པ་རྣམས་ཀྱིས་ཁྱེད་ཉིད་རྡོ་གཅིག་བསྒྲེང་ཡང་མི་ནུས་པར་གཞན་གྱིས་བརྩིགས་པའི་ཁང་པ་ལ་འཕྱ་བའི་རིགས་སམ་ཞེས་བྱས་པ་དང་།",
    "རྨང་ནས་བཟུང་སྟེ་རིམ་པ་གཉིས་སམ་གསུམ་རྩིགས་ཤིག་ཅེས་བྱ་བ་ནི་ཕ་གུ་དང་འཇིམ་པ་ཉིས་རིམ་དང་གསུམ་རིམ་ལས་རྩིག་ཏུ་མི་གནང་བའོ།",
    "དགེ་སློང་རྣམས་ཀྱིས་དགེ་སློང་མའི་སྟོན་པར་དགེ་སློང་མི་མཁས་མི་གསལ་བ་དག་བསྐོས་པས་བདག་མི་ཤེས་བདག་མ་དུལ་བས་ན་གཞན་ཞི་བར་བྱ་བའི་གནས་རྔེད་པས་ན་དེ་ཉིད་ཉེས་པའི་དམིགས་སུ་གྱུར་ནས་བཀའ་སྩལ་པ།",
    "གནས་བརྟན་རྒྱལ་པོ་ལྟ་བུ་ནི་བསྙེན་པར་རྫོགས་ནས་ལོ་ཉི་ཤུ་ལོན་པའམ་དེ་ལས་འདས་པའོ།",
    "ལམ་བསྟན་དགེ་སློང་མའི་སྟོན་པར་བསྐོས་པས་དགེ་སློང་མ་རྣམས་བདེན་པ་ལ་བཀོད་དོ།",
    "འཁོར་རྣམས་ཀྱང་དགྲ་བཅོམ་པ་ནས་རྒྱུན་དུ་ཞུགས་པ་ཡན་ཆད་དུ་ཐོབ་པར་བྱས་པས་ན་སྔ་མ་ནི་བཅས་པའོ།",
    "འདི་བེེ་རྗེས་སུ་གནང་བའོ།",
    "བཅོམ་ལྡན་འདས་ཞལ་བཞུགས་སོ་ཞེས་ནས་མ་བཏུབ་བོ།",
    "ཞེས་འཕྱ་བ་ལས་སྙན་དུ་བདས་ནས་ཉི་མ་ནུབ་ཀྱི་བར་དུ་དགེ་སློང་མ་རྣམས་ལ་སྟོན་དུ་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "ཉི་མ་ནུབ་པ་ལ་མ་ནུབ་པར་འདུ་ཤེས་སམ་ཐེ་ཚོམ་ཟ་ན་སྨད་དེ་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཁ་ཟས་ཅུང་ཟད་ཙམ་གྱི་ཕྱིར་དགེ་སློང་མ་རྣམས་ལ་སྟོན་ཏོ་ཞེས་སྨྲར་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "ཚེ་དང་ལྡན་པ་དགའ་བྱེད་ལ་འབུལ་ལོ་ཞེས་བྱས་པ་དང་།",
    "ཁྱེམ་བདག་ནི་ཡོ་བྱད་དག་དང་ལྡན་ཏེ་འབྱོར་པར་གྱུར།",
    "དགེ་སློང་མ་སྔོན་གྱི་ཆུང་མ་རྙིང་པ་ལ་སྩལ་ཏོ་ཞེས་བྱས་པ་དང་།",
    "ཡིན་པ་ལ་མ་ཡིན་པར་འདུ་ཤེས་དང་།",
    "ཐེ་ཚོམ་ན་ཉེས་བྱས་སུ་འགྱུར་རོཐུ།",
    "དགེ་སློང་མའི་འགྲོན་ཞུམང་པོ་དང་འགྲོགས་ཤིང་ལམ་དུ་འགྲོར་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "འོ་ན་ཆེ་ཞེ་ཁྱེད་ཅག་ཀྱང་འདོང་ངོ་ཞེས་བྱས་པ་དང་།",
    "སྙན་དུ་བདས་ཏེ་དགེ་སློང་མའི་འགྲོན་པ་དང་འགྲོར་མི་གནང་བར་བབེེབ་པ་བཅས་སོ་རྔུ་དུས་ལ་བབ་པ་མ་གཏོགས་ཞེས་བྱ་བ་ནི་དགེ་སློང་མ་གཅིག་མཉན་དུ་ཡོད་པར་འགྲོ་བ་ན་གྲོགས་མེད་དེ་དགེ་སློང་རྣམས་ལ་བསྡད་ན་དགེ་སློང་དག་ཀྱང་འགྲོགས་སུ་མ་བཏུབ་ནས་དགེ་སློང་མ་རྣམས་བཅོམ་པ་དང་དེ་ལྟ་བུའི་རྐྱེན་ནི་རྗེས་སུ་གནང་ངོ།",
    "དེས་ན་རྐྱེན་བྱུང་བ་དུས་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "དགེ་སློང་མའི་འགྲོན་པ་དང་གྲུར་ཞུགས་ཏེ་ཆུ་འབྱམ་དུ་འགྲོར་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "བྱེ་བྲག་ནི་སྔར་ལམ་དུ་འགྲོ་ཞིང་འགྲོར་མི་གནང་བ་དང་།",
    "དགེ་སློང་མ་དང་ལྷན་ཅིག་གྲུའི་ནང་དུ་ཞུགས་ནས་འདོང་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "ཆུ་འབྱམ་དུ་དོང་ན་རྒྱང་གྲགས་ཕྱེད་ཕྱེད་ཅིང་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ས་དབེེན་པ་ན་དགེ་སློང་དགེ་སློང་མ་དང་འགྲེང་ཤེདུ་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "དགེ་སློང་མས་ངོས་མགྲོན་ཀྱེསྦྱོར་དུ་བཅུག་པའི་ཟས་ཟར་མི་གནང་བ་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "དེ་རྣམས་ཀྱིས་འཕགས་པ་ཞལ་སུས་གསོལ་ཅིག་ཅེས་བྱས་ན།",
    "གང་དུ་མ་གནང་སུས་མ་གནང་ཞེས་བྱས་པ་དང་།",
    "སླན་ཆད་དགེ་སློང་མས་སྤྱོར་དུ་བཅུག་པ་ཟར་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "དེ་ཟན་ཆད་པར་མ་གྱུར་གྲང་ཞེས་བྱས་པ་དང་།",
    "ཞེས་བྱས་པ་དང་།",
    "དེ་ནི་སྔར་བོས་པ་མ་གཏོགས་སོ་ཞེས་རྗེས་སུ་གནང་ངོ།",
    "ཟོས་ཞེས་བྱ་བ་ནི་མགྲིན་པར་མིད་པའོ།",
    "འབྲས་བརྔོས་པའི་ཕྱེ་སྦྱིན་ནོ་ཞེས་བྱས་པ་དང་དེ་ལྟར་མ་ཡིན་གྱི་དེ་དག་ལ་ནས་བརྔོས་པའི་ཕྱེ་བྱིན་ཅིག་ཅེའམ།་",
    "དགེ་སློང་འདི་ནི་རྒྱུན་དུ་ཞུགས་པ་ཡིན་གྱི་དེ་དག་ལ་རའི་མར་མ་སྦྱིན་པར་འབྲིའམ།",
    "ཡང་ཡང་ཟར་མི་གནང་བའི་གླེང་གཞི་ནི་ཡུལ་ཡངས་པ་ཅན་ན་སྟེ།",
    "བཅོམ་ལྡན་འདས་ནི་བསླབ་པ་བཅའ་བར་བཞེད་པའི་ཕྱིར་གཤེགས་སུ་མ་གནང་ངོ།",
    "དགེ་སློང་རྣམས་ཚིམ་པར་གྱུར་ཏམ།་",
