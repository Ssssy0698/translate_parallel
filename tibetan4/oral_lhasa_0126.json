    "ཁ་ཟས་ཞག་ལོན་པ་བཟར་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "ནམ་རྨུས་པའི་ཚེ་ཆུའི་ནང་དུ་སྦངས་ཤིང་དུབསོད་སྙོམས་ལ་མི་འཇུག་པར་ཟའོཤེ།",
    "དགེ་སློང་ནག་པོའི་ལགས་སོ་ཞེས་ཀུན་དགའ་བོས་གསོལ་ཏེ།",
    "བཞག་པའི་ཁ་ཟས་ཟར་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "བྱིན་ལེན་བྱས་པའི་ཟས་ནི་ཕྱི་འཕྲེད་ཀྱི་དུས་སུ་བཞག་པར་གྱུར་ཏོ།",
    "ཕྱི་དྲོ་བྱིན་ལེན་བྱས་པ་ནི་སྲོད་ཀྱི་དུས་སུ་བཞག་པར་གྱུར་ཏོ།",
    "བཞག་པ་ཡོད་པའམ་ཁ་གཟར་དང་ཚ་སྟེགས་ན་བཞག་པ་ཡོད་པ་དང་སྤགས་པ་ཟོས་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "ཁ་མ་བཀྲུས་པར་བཏུང་བ་འཐུངས་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དགེ་སློང་བྱིན་ལེན་མ་བྱས་པར་ཟར་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "ནམ་མི་ཤི་བ་ཉུང་བ་ན་གྲོང་དུ་བསོད་སྙོམས་ལ་འཇུག་ལུས་ཀྱང་མ་བརྟས་ཤཱཉུཔར་གྱུར་པས་ན།",
    "ཆུ་དང་སོ་ཤིང་མ་གཏོགས་ཞེས་རྗེས་སུ་གནང་བའོཔྱེ།",
    "བྱེན་ལེན་བྱས་པ་ལ་མ་བྱས་པར་འདུ་ཤེས་པ་དང་ཐེ་ཚོམ་ཟ་བཞིན་དུ་ཟོས་ན་ཉེས་བྱས་སོ།",
    "སྨོད་པ་ཅན་གྱི་ཡུལ་ན་བྱིན་ལེན་མ་བྱས་པ་ཟར་ཡང་རུང་སྟེ།",
    "ཟུམི་ན་བར་ཟས་བཟང་པོ་གཞན་གྱི་ཁྱེམ་ནས་སློང་ཞིང་ཟར་མི་གནང་བའི་གླེང་གཞི་ནི་གྲོང་ཁྱེན་སེར་སྐྱའི་གནས་ན་སྟེ།",
    "བཅོམ་ལྡན་འདས་འཁོར་དང་བཅས་པར་གཤེགས་སུ་གནང་སྟེ།",
    "འོ་ན་ངེད་ཀྱིས་མ་མཐོང་ན་ཞེས་བྱས་པ་དང་།",
    "དེར་ཁྱེད་ཀྱིས་ཅི་ལྟ་བུ་ཞིག་ཟོས་ཞེས་བྱས་སྐྱེཔ་དང་།",
    "འཕགས་པ་འོ་མ་དང་ཤ་དང་ཉ་སྐམ་གསོལ་ཅིག་དང་སོས་པར་འགྱུར་རོ།",
    "གྲོང་དུ་སློང་དུ་མི་གནང་ངོ་ཞེས་པ་ལ་སྙན་དུ་བདས་ཏེ།",
    "ན་བའི་དུས་སུ་ཞེས་རྗེས་སུ་གནང་ངོ།",
    "མི་ན་ཞེས་བྱ་བ་ནི་ན་བ་མ་གཏོགས་ཏེ་གནང་བའོ།",
    "མི་ན་བའི་ཚེ་བསླངས་ལ་ན་བའི་ཚེ་ཟོས་ན་སློང་བའི་ཚེ་ཉེས་བྱས་སོ།",
    "སྲོག་ཆགས་དང་བཅས་པའི་ཆུ་ལ་གྱེཤེས་བཞིན་དུ་སྤྱོད་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་ཡུལ་ཀོ་ཤཱསྦྱི་སྤུཀུན་དགའ་ར་བ་ན་སྟེ།",
    "ཕྱིའི་སྤྱོད་པར་བྱ་བ་དང་།",
    "དེའི་ཚེ་ན་ཚེ་དང་ལྡན་པ་འཆར་བ་པོ་ནང་པར་སྔར་ལངས་ཏེ།",
    "དགེ་སློང་སྟེ་ངན་བྱེད་པར་འགྲེང་དུ་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "ཚེ་དང་ལྡན་པ་འཆར་བས་སྔ་མ་བཞིན་དུ་མི་ཚངས་པར་སྤྱོད་པར་རིག་ནས།",
    "འདིར་ཅི་འདོད་ཅེས་བྱས་ཞུནས་མ་བཏུབ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཡུལ་ཀོ་ས་ལར་ལྗོངས་རྒྱུ་བ་ལས་མཉན་དུ་ཡོད་པར་བྱོན་པའི་ཚེ།"
  ]
}