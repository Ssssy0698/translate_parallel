    "མེད་པར་དགག་པ་དང་མ་ཡིན་པར་དགག་པའི་དོན་ནི་དགག་པ་གཙོར་བྱེད་པའི་ཚིག་དེ་ཉིད་འགོག་པ།",
    "དཔེར་ན་ཤིད་ཟན་གྱི་ཞེས་བྱ་བ་ལྟ་བུ་ནི་མེད་པར་དགག་པ་ཡིན་ལ་བསྒྲུབ་པ་གཙོར་བྱེད་པའི་ཚིག་ཕྱི་མ་དང་འབྲེལ་བ་བྲམ་ཟེ་མ་ཡིན་པ་ཁྱེར་ལ་ཤོག་ཅེས་བྱ་བ་ལྟ་བུ་ནི་མ་ཡིན་པར་དགག་པའོ།",
    "སྐྱེ་བ་མེད་པར་བསྒྲུབ་པའི་ལུང་དང་འགལ་བ་སྤོང་བའོ།",
    "སྐྱེ་ན་ཐུག་པ་མེད་པར་ཡང་འགྱུར་རོ།",
    "གནས་སྐབས་ཐ་དད་པ་བཞིན་དུ་གནས་སྐབས་ཅན་ཡང་ཐ་དད་པར་འགྱུར་རོ།",
    "དེ་ལ་ཡང་ཡོད་ན་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "ཞེས་གཏན་ཚིགས་ལ་སོགས་པ་རང་རྒྱུད་ཀྱིས་རང་ལས་སྐྱེ་བ་དགག་པར་རིགས་པ་ཡིན་ན།",
    "འདིར་ཅི་ལྟར་བརྗོད་པ་དེ་ལྟར་རང་རྒྱུད་ཀྱི་དཔེ་དང་གཏན་ཚིགས་མ་བརྗོད་པའི་ཕྱིར་དགག་པར་མི་ནུས་སོ།",
    "གཏན་ཚིགས་འགལ་བར་གྲངས་ཅན་གྱིས་སྨྲས་པའི་ཉེས་པ་མ་བསལ་བའི་ཕྱིར་བདག་ལས་སྐྱེ་བ་དགག་པར་མི་ནུས་པས་རང་རྒྱུད་ཀྱི་སྦྱོར་བ་མ་ཡིན་ནོ།",
    "བདག་ལས་མི་སྐྱེ་བས་ནི་དེ་ལས་བཟློག་པའི་གཞན་ལས་སྐྱེ་བ་འགྲུབ་པར་འགྱུར།",
    "བཟློག་པ་གཉིས་ཀ་ཁས་བླངས་པ་ཙམ་གྱིས་ཕ་རོལ་པོའི་བདག་ལས་སྐྱེ་བར་དམ་བཅའ་བ་དག་པར་ནུས་པས་གཏན་ཚིགས་དང་དཔེ་མ་བརྗོད་པའི་ཕྱིར་གཞན་གྱི་འད་པ་མི་ཁེགས་ཞེས་བརྗོད་པ་མ་ངེས་པ་ཡིན་ནོ།",
    "དེ་ནི་མི་རུང་སྟེ་སྒྲ་མ་འབྱིན་ཅིག་བྱས་པས་མ་འབྱིན་ཅིག་ཅེས་ཟེར་བའི་ཚིག་འགོག་པ་མ་ཡིན་གྱི།",
    "མ་གྲུབ་པར་བརྗོད་པ་དེ་ལ་ཡང་གསུམ་སྟེ།",
    "བདག་ལས་སྐྱེ་བ་དགག་པར་མཛད་པ་ཡིན་ཏེ།",
    "བྱས་པ་མི་རྟག་པའི་ཕྱིར་ཞེས་པ་བསྡོམས་པ་ནི་དཔེ་ཡིན་ལ་སོ་སོ་ནི་རྟགས་དང་བསྒྲུབ་བྱ་ཡིན་ནོ།",
    "བསལ་བ་ནི་བྱས་པ་ནི་མི་རྟག་པར་མཐོང་སྟེ།",
    "སྐྱེ་བ་བཀག་པས་ཁོ་བོ་ཅག་ལ་གནོད་པར་འགྱུར་ན།",
    "དོན་གྱི་བརྗོད་པར་རྣམ་པར་དཔྱད་པ་འདི་ལྟ་བུ་ཞེས་པ་ནི་སློབ་དཔོན་གྱིས་གོང་དུ་བསྟན་པའི་སྦྱོར་བ་འདི་ལྟ་བུ་མ་གསུངས་སོ་ཞེས་བྱའོ།",
    "འོན་ཀྱང་བདག་ལས་སྐྱེ་བའི་ཕྱིར་སྐྱེ་བ་དོན་མེད་ཅིང་ཐུག་པ་མེད་པར་བརྗོད་པའི་སྒྲས་ཀྱང་དེ་ལྟ་དེ་ལྟར་བརྗོད་འདོད་པའི་བརྗོད་འདོད་སྟོན་པར་བྱེད་པ་ཡིན་ལ།",
    "བཟློག་པར་བརྗོད་པའི་སྒྲས་ཀྱང་བརྗོད་འདོད་སྟོན་པའི་འབྲས་བུ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "ཁྱད་པར་དོན་མེད་པ་དང་།",
    "གྲངས་ཅན་གྱིས་དོན་དམ་པར་བདག་ལས་སྐྱེ་བར་བརྟག་པ་བཀག་པའི་ཕྱིར་ཁྱད་པར་བརྗོད་དོ་ཞེས་རྒོལ་བ་ལ།",
    "འདི་ལྟར་དངོས་པོ་རྣམས་རང་ལས་སྐྱེ་བ་མེད་དེ་ཞེས་དོན་དམ་པར་ཁྱད་པར་བྱས་པ་ཡིན་པ་ལས།",
    "གསུམ་པ་ནི་འཇིག་རྟེན་པ་ཀུན་རྫོབ་ཏུ་བདག་ལས་སྐྱེ་བར་བརྗོད་པ་བཀག་པའི་ཕྱིར་ཁྱད་པར་བརྗོད་དོ་ཞེ་ན།",
    "ཁ་ཅིག་སྒྲ་རྟག་པར་འདོད་ལ་ཁ་ཅིག་ནི་མི་རྟག་པར་འདོད་དོ།",
    "ཕྱིན་ཅི་ལོག་ནི་མ་དཔྱད་པར་དངོས་པོར་འཛིན་པ་ཡིན་ལ།",
    "ཕྱིན་ཅི་མ་ལོག་པ་ནི་དཔྱད་ན་ཅིར་ཡང་མ་གྲུབ་པར་སྣང་བའོ།",
    "དོན་དམ་པའི་བདེན་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ནི་སྣང་བའི་གཟུགས་ཀྱང་ལྡོག་པས་ཁྱབ་བྱ་མི་སྲིད་པ་ཉིད་དོ་ཞེས་བྱ་བའོ།",
    "ཀུན་རྫོབ་དང་དོན་དམ་པས་ཁྱད་པར་དུ་མ་བྱས་པའི་ཀུན་རྫོབ་བཀག་པས་ཁས་བླངས་ལ་དོན་དམ་པར་ནི་མུ་མི་འདོད་པས་ཁས་བླངས་པ་ཡིན་ཞིང་།",
    "སྟོང་པ་ཉིད་མ་ཡིན་པར་སྨྲ་བ་ཀུན་ཏུ་མི་འདོད་པར་འགྱུར་བས་ཀུན་རྫོབ་ཁས་མ་བླངས་པ་ཡིན་ནོ།",
    "རྒོལ་བ་སྟོང་པ་མ་ཡིན་པར་འདོད་པས་ཀུན་རྫོབ་ཏུ་ཡང་མི་འདོད།",
    "ཀུན་རྫོབ་ཏུའམ་དོན་དམ་པར་ཞེས་བརྟགས་པ་དེའི་རྗེས་སུ་འབྲང་བ་ལ་སྨྲས་པའོ།",
    "ཡང་ན་དོན་དམ་པར་ཞེས་པ་ལ་སོགས་པས་བསྙད་ལ།",
    "འབྲས་བུར་གྱུར་བའི་ཁྱད་པར་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་བྱའོ།",
    "དམ་བཅའ་བ་མེད་པས་སྒྲུབ་པ་མེད་པའི་ལན་ཤུགས་ཀྱིས་ཤེས་པར་བྱ་བ་ཡིན་ལ།",
    "གལ་ཏེ་དེ་ཡོད་ན་རྒྱུ་དོན་མེད་པར་འགྱུར་རོ།",
    "གཉིས་པ་འཐད་པ་སྦྱར་བ་ལས་འཆད་པར་འགྱུར་བའི་འཐད་པ་སྦྱར་བ་འདི་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "སྐྱེ་བ་མེད་པར་གྲུབ་པའི་དོན་ལ་ལུང་དང་འགལ་བ་སྤང་བ་ལ་གཉིས་ཏེ།",
    "རྣམ་པར་གཞག་པ་མི་འགལ་བ་དང་།",
    "དེ་ཁོ་ན་ཉིད་ཁོང་དུ་ཆུད་པར་མཛད་པའི་ཚུལ་དང་།",
    "དེ་ཡང་བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་དང་།",
    "རང་རྒྱུད་ལ་ཉེས་པ་བརྗོད་པར་བྱེད་པས།",
    "སྔ་མས་ཡང་དག་པར་ཞེས་པ་ནི་སྔར་གྱི་སློབ་དཔོན་ཕྱོགས་ཀྱི་གླང་པོ་ལ་སོགས་པའོ།",
    "དེ་ལྟར་རང་དང་སྤྱིའི་མཚན་ཉིད་མཚོན་པར་བྱ་བའོ།",
    "ཤེས་པ་མེད་པར་ཁས་བླངས་ནས་མི་འཐད་པ་ལ་བཞི་སྟེ།",
    "ཅི་སྟེ་དེ་ཡང་ཞེས་པ་ཤེས་པ་དེ་ཡང་ལས་སུ་བསྒྲུབས་པ་ཡིན་ན་ལས་དེ་ལ་ཡང་ཤེས་པར་བྱེད་པ་གཞན་དགོས་པས་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "ཤེས་པ་ནི་རང་རིག་པའི་མཚན་ཉིད་ཅན་ཡིན་པས་སྒྲུབ་བྱེད་གཞན་ལ་མི་ལྟོས་པས་ཐུག་པ་མེད་པར་ག་ལ་འགྱུར་ཞེས་རྒོལ་བའི་ལན་ལ་བཞི་སྟེ།",
    "གལ་ཏེ་གཞན་གྱིས་གྲུབ་ན་གཞན་ལ་ཡང་སྒྲུབ་བྱེད་གཞན་དགོས་པས་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "ཤེས་པར་བྱེད་པས་ན་ཤེས་པ་ཡིན་པ་ལས།",
    "ཤེས་པར་བྱེད་པ་མི་སྲིད་པ་ཡིན་ལ།",
    "དེའི་གཞི་ཐ་དད་པ་མེད་ཀྱང་གྲངས་ཉམས་པའི་ཉེས་པར་མི་འགྱུར་ཏེ།",
    "དེའི་རྣམ་པར་འགྱུར་བ་མི་རྟག་པ་མི་བདེ་བ་ཡིན་ཏེ།",
    "དེའི་རྣམ་པར་འགྱུར་བ་མི་རྟག་པ་ལ་སོགས་པ་ལྟར་ཚངས་པ་ཡང་མི་རྟག་པ་ལ་སོགས་པར་འགྱུར་རོ།",
    "དེས་ན་ཚངས་པ་དང་དེའི་རྣམ་པར་འགྱུར་བ་དེ་ཉིད་དང་གཞན་ཉིད་དུ་བརྗོད་དུ་མེད་པ་ཞེས་བྱ་བར་རིགས་པ་ལ།",
    "ཤེས་པ་ནི་སེམས་ཡིན་པས་ཁྱད་པར་རོ།",
    "སྒྲ་གཅན་གྱི་ཞེས་ཐ་དད་པའི་རྟེན་ཅན་གྱི་དྲུག་པའི་རྣམ་པར་དབྱེ་བའི་ཚིག་སྦྱར་བ་མི་འགལ་བ་བཞིན་དུ།",
    "ལས་ཐ་དད་པའི་མཚན་ཉིད་བྱེད་པ་མེད་ཀྱང་མཚན་གཞི་ལས་མཚན་ཉིད་ཐ་དད་པ་ལྟར་བསྟན་པའི་ཆེད་དུ་ཐ་དད་པའི་རྟེན་ཅན་གྱི་དྲུག་པའི་རྣམ་པར་དབྱེ་བའི་ཚིག་སའི་སྲ་བ་ཞེས་བྱ་བ་བརྗོད་ལ།",
    "མཆི་གུའི་ལུས་དང་སྒྲ་གཅན་གྱི་མགོ་རྟོགས་པས་དྲུག་པའི་རྣམ་པར་དབྱེ་བ་སྦྱར་བར་རིགས་ན།",
    "གལ་ཏེ་འབྲེལ་བ་མེད་ན་འདུ་བའི་འབྲེལ་བ་འདི་ནི་མཚན་ཉིད་དང་མཚན་གཞིའི་འབྲེལ་བ་ཡིན་ནོ་ཞེས་ཤེས་པར་མི་འགྱུར་རོ།",
    "དངོས་པོ་ལ་ཡོད་པར་མི་རིགས་པའོ།",
    "གྲུབ་པ་དགག་པ་ལ་ཡང་རྣམ་པར་དཔྱོད་པ་མི་འཇུག་པས་མ་གྲུབ་པ་དང་།",
    "ཐ་དད་པར་དམིགས་པས་ཁྱབ་པ་ཡིན་ལ།",
    "གཉིས་པ་ནི་དེ་བཞིན་དུ་རྣམ་པར་དཔྱད་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དོན་དམ་པའི་བུམ་པ་ལ་མངོན་སུམ་ཞེས་བརྗོད་པར་མི་བྱེད་པས་འཕགས་པའི་ཐ་སྙད་ཁས་མ་བླངས་ཞེས་བྱ་ལ།",
    "མཚན་ཉིད་རྟོག་བྲལ་ཤེས་པ་ལ་བྱས་པས་མ་ཁྱབ་པའོ།",
    "ཐ་དད་པར་དམིགས་པ་དང་།",
    "གདགས་གཞི་མེད་པས་བཏགས་པར་མ་གྲུབ་པ་དང་།",
    "དང་པོ་ནི་ཅི་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པས་བཏགས་པར་ཡོད་པའི་བུམ་པའི་རྒྱུ་ནི་སྔོན་པོ་ལ་སོགས་པ་ཡིན་ལ།",
    "བཏགས་པར་ཡོད་པའི་བུམ་པ་མངོན་སུམ་མ་ཡིན་པ་ཡང་།",
    "སྔོན་པོ་མངོན་སུམ་དུ་བརྗོད་པ་ན་བུམ་པ་མངོན་སུམ་བརྗོད་པ་ཁོ་ན་ཡིན་པས་མ་བསྡུས་པར་མི་འགྱུར་ཞེས་བྱ་བ་འམ།",
    "སྔོན་པོ་མངོན་སུམ་དུ་བརྗོད་པ་ནི་བུམ་པ་མངོན་སུམ་པ་བརྗོད་པ་ཁོ་ན་ཡིན་པས་མ་བསྡུས་པར་མི་འགྱུར་ཞེས་བྱ་བའམ།",
    "བཏགས་པའི་མངོན་སུམ་བྱས་པས་དེའི་འབྲས་བུ་བུམ་པ་ལ་ཡང་མངོན་སུམ་ཞེས་བྱ་བ་སྒྲུབ་པས།",
    "བདེན་པ་ཞེས་བྱ་བའི་འབྲས་བུ་གཉིས་ཐ་དད་པར་དམིགས་པས་འདི་ལ་བཏགས་པ་ནི་རིགས་ན།",
    "འདིར་ནི་མངོན་སུམ་ཡིན་པའི་བུམ་པ་སྔོན་པོ་ལས་ཐ་དད་པར་དམིགས་པ་མེད་པ་མེད་པའི་ཕྱིར།",
    "ཐ་དད་པར་དམིགས་པས་གདགས་གཞི་མེད་ལ།",
    "དེས་ན་བཏགས་པར་མི་རུང་ངོ་ཞེས་བྱ་བའོ།",
    "རྟེན་གྱི་སྒོ་ནས་བསྟན་པས་ཤེས་པའི་རྣམ་པར་དབྱེ་བ་གྲུབ་དུ་ཟིན་ཀྱང་འདིར་དབྱེ་བ་བསྒྲུབ་པ་ནི་མ་ཡིན་གྱི་མཚན་ཉིད་སྟོན་པའི་སྐབས་ཡིན་ལ།",
    "མཚུངས་པར་ལྡན་པའི་རྒྱུ་དང་ལྷན་ཅིག་བྱུང་བའི་རྒྱུ་ནི་ལྷན་ཅིག་སྐྱེས་པས་བསྡུས་ཤིང་།",
    "དེ་རང་ལས་སྐྱེས་པས་དེའི་བྱ་བ་འགྲུབ་པར་ག་ལ་འགྱུར་ཞེས་བྱ་བའོ།",
    "ཅི་ལྟར་རྣམ་པར་ཞེས་བྱ་བ་ལ་སོགས་པས་རིམ་པ་བཞིན་དུ་བསྟན་ཏེ།",
    "རྒོལ་བ་ནི་འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་རྒྱུའི་རྐྱེན་གྱིས་མཚན་ཉིད་དང་མཚོན་པར་བྱས།",
    "དམིགས་པའི་རྐྱེན་གྱི་མཚན་ཉིད་དགག་པ་ལ་ཡང་ཡོད་པའི་དམིགས་པར་མི་འཐད་པ་དང་།",
    "མེད་པའི་དམིགས་པར་མི་འཐད་པ་དང་།",
    "འབྲས་བུའི་མ་སྐྱེས་པར་ཡང་འགག་པར་ཁས་ལེན་ན།",
    "འབྲས་བུ་སྐྱེ་བའི་རྐྱེན་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ཡིན་ལ།",
    "འགག་པ་འཐད་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་འགག་པ་མེད་པ་སྡུད་པ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པས་དོན་འདི་བསྟན་ཏེ།",
    "འབྲས་བུ་མ་སྐྱེས་པར་རྒྱུ་འགགས་ན་འབྲས་བུ་སྐྱེ་བ་དང་།",
    "འབྲས་བུ་སྐྱེ་བ་མཐོང་བའི་གཏན་ཚིགས་མ་གྲུབ་པར་བརྗོད་པ་དང་།",
    "མ་ངེས་པ་སྤང་བ་ནི་ཇི་ལྟར་འབྲས་བུ་དེ་ནི་མེད་པར་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "སྐྱེ་བ་ལ་གོ་འགལ་བ་ཅི་ཡོད་ཅེས་མ་ངེས་པར་བརྗོད་པ་ལ་ལན་བཏབ་པ་ཡིན་ནོ།",
    "གཉིས་པ་ནི་འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་རྐྱེན་དང་རྐྱེན་མ་ཡིན་པའི་འབྲས་བུ་ལ་ལྟོས་ནས་རྣམ་པར་གཞག་པ་ཡིན་ལ།",
    "ཡོད་པའི་དངོས་པོ་དམན་པར་འགྱུར་བ་མེད་པས་ན་རྒ་བ་མེད་པའོ།",
    "དེ་ཡང་སྒྲ་འགལ་བའི་སྒོ་ནས་སུན་འབྱིན་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ལྷ་སྦྱིན་གྱི་སྨྲ་བའི་དང་།",
    "བྱ་བ་ཐ་དད་པ་ལ་བྱེད་པ་པོ་ཐ་དད་པས་ཁྱབ་པས་མ་ངེས་པར་མི་འགྱུར་བའམ།",
    "ཉིས་པ་རྟེན་འགྲོ་བ་པོ་ལས་འགྲོ་བ་གྲུབ་པ་དགག་པ་ནི་འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་བརྒལ་ལན་གྱིས་སྟོན་ཏེ་འགྲོ་བ་པོ་མེད་པར་འགྲོ་བ་མི་འགྲུབ་ལ་འགྲོ་བ་མེད་པར་འགྲོ་བ་པོ་མི་འགྲུབ་སྟེ་དེས་ན་ཕན་ཚུན་རྟེན་པར་འགྱུར་རོ།",
    "བྱ་བ་བརྗོད་པ་དོན་གྱིས་སྟོང་པར་འགྱུར་ལ།",
    "དེ་མེད་ན་ནི་རྩོམ་པ་ཡོད་པར་ག་ལ་འགྱུར་ཞེས་བྱ་བས་བསྟན་ཏོ།",
    "གནས་པར་རྩོམ་པར་དགག་པ་དང་།",
    "གཉིས་ཀ་འགྲོའམ་ཞེས་བརྟགས་པས་འགྲོ་བ་བཀག་པས་གནས་པ་བཀག་པར་རིག་པར་བྱའོ།",
    "དེས་ན་རྩོམ་པ་བཀག་པའི་སྒོ་ནས་གནས་པ་བཀག་པར་ཤེས་པར་བྱའོ།",
    "གནས་པར་མ་གྱུར་བ་ལྡོག་གམ་ཞེས་བརྟགས་པས་ལྡོག་པ་བཀག་པས་གནས་པ་བཀག་པ་ཉིད་དོ་ཞེས་བསྟན་ཏོ།",
    "དང་པོ་ནི་འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་འགྲོ་བའི་བྱ་བ་གཅིག་པ་པོ་དེ་ཉིད་ཀྱིས་འགྲོ་བ་པོ་ཡང་བྱ་བ་དང་ལྡན་པར་འགྱུར་བས་གང་ཡང་རུང་བ་དོན་གྱིས་སྟོང་པའམ།",
    "དེ་བས་ན་ཕ་རོལ་པོས་འགྲོ་བ་སྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "ལྷག་མ་ཅི་རིགས་པར་ཤེས་པར་བྱའོ།",
    "མེའི་དཔེའི་སྒོ་ནས་མ་ངེས་པར་རྒོལ་བ་སྤྲང་བ་ནི་གལ་ཏེ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "རྣམ་པར་ཤེས་པ་ལ་སོགས་པའི་སྒྲུབ་བྱེད་དགག་པ་དང་བཞིས་སྟོན་པ་ལས།",
    "འདིར་ཡང་ལྟ་བ་པོ་རྣམ་པར་ཤེས་པ་ཡང་མིག་ལྟ་བའི་བྱེད་པའི་སྒོ་ནས་བདག་ལ་མི་ལྟ་བའི་ཕྱིར་གཞན་ལ་ཡང་མི་ལྟ་བའོ་ཞེས་བྱེད་པ་པོ་བཀག་པས་དེ་ལ་ལྟོས་ནས་བཞག་པའི་བྱེད་པ་ལྟ་བ་ཡང་བཀག་པར་རིག་པར་བྱའོ་ཞེས་བསྟན་ཏོ།",
    "རྣམ་པར་ཤེས་པ་ལ་སོགས་པའི་སྒྲུབ་བྱེད་དགག་པ་ནི་འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་བརྒལ་ལན་གྱིས་བསྟན་ཏོ།",
    "འདུས་བྱས་དང་།",
    "ཐབས་ཁྱད་པར་ཅན་ལ་གདམས་པ་དང་།",
    "འདིས་ནི་ཕུང་པོ་ཡོད་པའི་ཕྱིར་སྐྱེ་མཆེད་ཡོད་དོ་ཞེས་སྐྱེ་མཆེད་ཀྱི་སྒྲུབ་བྱེད་བསྒྲུབ་བྱ་དང་མཚུངས་པར་ཞར་ལ་བསྟན་པ་ཡིན་ལ།",
    "ཐབས་ཁྱད་པར་ཅན་ལ་གདམས་པ་ལ་གཉིས།",
    "ཕུང་པོ་བརྟག་པ་རྫོགས་སོ། འདིར་ཕུང་པོ་བསྒྲུབ་པའི་ཕྱིར་དགག་པ་མ་བྱས་པ་དང་།",
    "ལུང་ལས་གསུངས་པས་ཁམས་ཡོད་པའི་སྒྲུབ་བྱེད་དུ་བཀོད་པ་བསྒྲུབ་བྱ་དང་མཚུངས་པར་བསྟན་པའི་ཕྱིར་ཁམས་བརྟག་པ་འཆད་དོ།",
    "གོང་དུ་རྒྱུ་འབྲས་ཀྱི་བརྟག་པའི་སྒོ་ནས་སུ་ན་ཉིད་དང་མཚན་གཞིའི་བརྟག་པས་སུན་འདོན་པར་རིག་པར་བྱའོ།",
    "ཁམས་ནི་འཛིན་པར་བྱེད་པ་ཡིན་ཏེ།",
    "མཚན་ཉིད་འཇུག་པའི་ཡུལ་མེད་པར་མཚན་ཉིད་མི་འཇུག་པའི་ཕྱིར་མཚན་གཞིར་མ་གྲུབ་ཅེས་བྱའོ།",
    "མ་གྲུབ་པ་སྤང་བ་ནི་འདིར་སྨྲས་པས་མཚན་ཉིད་འཇུག་པར་ཁས་བླངས་ཀྱང་མཚན་གཞིར་མ་གྲུབ་པ་ནི་གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་མཚན་གཞིའི་སྒྲུབ་བྱེད་དུ་མཚན་ཉིད་བཀོད་པ་བསྒྲུབ་བྱ་དང་མཚུངས་པར་བསྟན་པའི་སྒོ་ནས་སྟོན་ཏེ།",
    "དངོས་པོར་མ་གྲུབ་པ་ནི་འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་མཚན་གཞི་དང་མཚན་ཉིད་ཀྱི་སྒྲུབ་བྱེད་དངོས་པོའི་རང་བཞིན་དུ་ཡོད་པའི་ཕྱིར་ཞེས་བཀོད་པ་བསྒྲུབ་བྱ་དང་མཚུངས་པར་བརྗོད་པའི་སྒོ་ནས་སྟོན་ནོ།",
    "དངོས་པོ་མེད་པར་མ་གྲུབ་པ་ནི་གལ་ཏེ་ནམ་མཁའ་ཞེས་བྱ་བའི་བརྒལ་ལན་གྱིས་བསྙད་དོ།",
    "ཡོད་པ་མེད་པར་ལྟ་བས་མི་མཐོང་བའི་ཚུལ་གྱིས་ལྟ་བར་བྱ་བ་སྤྲོས་པ་ཉེ་བར་ཞི་བ་དངོས་སུ་མི་མཐོང་ངོ་ཞེས་དངོས་སུ་བསྟན་པས།",
    "མེད་པར་ལྟ་བར་མི་བྱའོ་ཞེས་གདམས་པ་ཤུགས་ལ་བསྟན་པ་ཡིན་ནོ།",
    "འདོད་ཆགས་གྲུབ་པ་ལ་ལྟོས་ནས་ཆགས་པར་གཞག་པའི་ཕྱིར་རོ།",
    "རྭ་གཡས་གཡོན་བཞིན་དུ་འདོད་ཆགས་དང་ཆགས་པ་གཉིས་ལ་ཕན་ཚུན་ལྟོས་པ་མེད་པར་འགྱུར་རོ།",
    "གསུམ་པ་ནི་ཅི་སྟེ་ཡང་ཐ་དད་པར་ཞེས་བྱ་བ་ལ་སོགས་པས་ལྷན་ཅིག་པ་ཉིད་གྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "འདོད་ཆགས་དང་ཆགས་པ་ཐ་དད་པར་གྲུབ་པར་རྟོག་ན།",
    "འོ་ན་དེ་ཐ་དད་པར་གྲུབ་པས་འདོད་ཆགས་དང་ཆགས་པ་ཡོད་པར་གྲུབ་ཟེར་བ་བཞིན་དུ།",
    "ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་དགག་པར་མི་ནུས་ཏེ།",
    "འདུས་བྱས་ཀྱི་མཚན་ཉིད་སྐྱེ་བ་དང་གནས་པ་དང་འཇིག་པ་ཡོད་པའི་ཕྱིར་ཞེས་བརྗོད་པ།",
    "བསྒྲུབ་བྱ་དང་མཚུངས་པར་བསྟན་པའི་ཕྱིར་འདུས་བྱས་བརྟག་པ་འཆད་དོ།",
    "དེས་མཚོན་བྱ་མཚོན་པར་ག་ལ་ནུས།",
    "སློབ་དཔོན་གྱིས་གསུངས་པ་མ་ཡིན་འོ་ན་ཅི་ཞེ་ན།",
    "རྣམ་པར་གྲོལ་བ་གཉིས་གཅིག་ཏུ་བརྩིས་པས་རྣམ་པར་གྲོལ་བ་དང་།",
    "རྣམ་པར་གྲོལ་བི་རྣམ་པར་གྲོལ་བ་དང་།",
    "སྐྱེ་བའི་སྐྱེ་བས་རྩ་བའི་སྐྱེ་བ་འབའ་ཞིག་སྐྱེད་པར་བྱེད་དེ།",
    "དང་པོ་ནི་འདི་ལ་བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་དང་།",
    "བརྒལ་བ་ནི་འདིར་སྨྲས་པ་གང་ལ་ཐུག་པ་མེད་པར་ཞེས་བྱ་བ་ལ་སོགས་པས།",
    "དེ་ལྟར་ཇི་སྐད་བརྗོད་པས་ཕན་ཚུན་སྐྱེད་པ་མི་འཐད་པས་སྐྱེ་བའི་སྐྱེ་བའི་རྒྱུ་གཞན་བརྟག་དགོས་པས་ཐུག་པ་མེད་པར་འགྱུར་བའི་ཉེས་པ་ནི་མེད་དེ།",
    "དང་པོ་ནི་བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པས་སེལ་བར་བྱེད་པ་ནི་བསལ་བྱ་མུན་པ་བསལ་བ་ལ་ལྟོས་ནས་བཞག་པ་ཡིན་ན།",
    "མཚུངས་པར་བསྒྲེ་བ་དང་།",
    "མཚུངས་པར་བསྒྲེ་བ་ནི་ཚུལ་འདིས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "མི་མཚུངས་པ་དགག་པ་ནི་ཅི་སྟེ་མ་ཕྲད་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་མ་ཕྲད་ཀྱང་རུང་བའི་ཡུལ་ན་གནས་པ་ཙམ་གྱིས་མར་མེས་མུན་པ་འཇོམས་པ་ལ་སོགས་པར་བྱེད་པས་མར་མེ་དང་མི་མཚུངས་སོ་ཞེས་རྒོལ་བ་ལ།",
    "གྲུབ་པར་ཁས་བླངས་ནས་དགག་པའོ།",
    "ཁྱད་པར་བརྗོད་ཀྱང་སྐྱེ་བཞིན་པ་མ་གྲུབ་པའོ།",
    "སྐྱེ་བཞིན་པ་དེས་འདུས་བྱས་ཀྱི་མཚན་ཉིད་སྐྱེ་བ་སྐྱེད་ལ།",
    "དེས་སྐྱེ་བཞིན་པའི་བྱ་བ་ཁྱད་པར་ཅན་དེ་སྐྱེད་པར་བྱེད་དོ་ཞེས་རྒོལ་བ་ལ།",
    "སྐྱེ་བཞིན་པས་བུམ་པའི་སྐྱེ་བ་གཟུང་བར་མི་ནུས་སོ་ བུམ་པའི་སྐྱེ་བ་མ་བཟུང་ན་ནི་བརྟེན་པ་བུམ་པའི་སྐྱེ་བཞིན་པ་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "འདུས་བྱས་ཀྱི་མཚན་ཉིད་ཀྱི་སྐྱེ་བ་ལ་ལྟོས་ནས་མྱུ་གུ་སྔོན་པོ་ནི་བྱ་བའི་ལས་ཡིན་ཞེས་བྱ་བའོ།",
    "སྐྱེ་བ་མེད་ན་ནི་དེ་ལ་བརྟེན་པའི་སྐྱེ་བཞིན་པ་འགྲུབ་པར་སུ་ཞིག་སེམས་ཞེས་བྱ་བའོ།",
    "འོན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་རྒོལ་བའི་ལན་ཡང་མ་ཡིན་པར་དགག་པ་དང་།",
    "མེད་པར་དགག་པའི་ཕྱོགས་ལ་བརྟེན་ནས་བརྗོད་དོ།",
    "སྐྱེ་བ་བཞིན་ནོ་ཞེས་པ་ནི་འདུས་བྱས་ཀྱི་མཚན་ཉིད་ཀྱི་སྐྱེ་བའོ།",
    "ལུང་དང་སྦྱར་བ་ནི་དེ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་ནས་གསུངས་པ་ཡིན་ནོའི་བར་གྱིས་བསྙད་དོ།",
    "དེའི་དང་པོ་ནི་འདིར་སྨྲས་པ་སྐྱེ་བ་དང་ཞེས་བྱ་བ་ལ་སོགས་པས་སྐྱེ་བ་དང་གནས་པའི་སྒྲུབ་བྱེད་དུ་དགག་པ་བཀོད་པ་མ་གྲུབ་པར་ཞར་ལ་བསྟན་ཅིང་།",
    "གཞན་ཡང་གལ་ཏེ་དགག་པ་ཞེས་པ་ནས་རྟོག་པར་བྱའོ་ཡི་བར་དང་།",
    "དང་པོ་ནི་ཅི་སྟེ་དེ་ལྟར་རྣམ་པར་དཔྱད་པ་ཡིན་ན་ཞེས་བྱ་བའི་རྒོལ་བ་སྔོན་དུ་བཏང་བས་བསྙད་དོ།",
    "སྐད་ཅིག་མ་གཉིས་པ་ལ་དངོས་པོ་མེད་པར་གྱུར་པ་དེ་འཇིག་པ་ཞེས་བྱའོ།",
    "འདུས་བྱས་ཞེས་པ་ནི་རྒྱུ་དང་རྐྱེན་གྱིས་ཞེས་བསྐྱེད་པའོ།",
    "རྒྱུས་འཇིག་པར་བྱེད་པ་དང་གསུམ་སྟེ།",
    "དེའི་དོན་ནི་སྐྱེས་པ་དེ་འཇིག་པར་བྱས་ནས་དེ་ལ་རྒྱུ་ཅུང་ཟད་ཀྱང་བྱེད་པ་ནི་མ་ཡིན་གྱི།",
    "ཁས་བླངས་པ་གསུམ་གྱིས་འཇིག་པར་དངོས་པོ་སྟོན་པ་སྟེ།",
    "ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་འཇིག་པར་བྱེད་པ་དང་།",
    "དེ་འདུས་མ་བྱས་མ་ཡིན་པར་སུ་ཞིག་སེམས་ཞེས་བྱ་བའོ།",
    "འདུས་བྱས་ཀྱི་སྒྲུབ་བྱེད་དགག་པ་སྟེ།",
    "འདུས་བྱས་བརྟག་པ་རྫོགས་སོ། དེ་ལྟར་མཚན་ཉིད་མི་འཐད་པ་ཡིན་ཡང་འདུས་བྱས་དགག་པར་མི་ནུས་ཏེ།",
    "དེའི་རྒྱུ་ལས་དང་བྱེད་པ་པོ་ཡོད་པས་འདུས་བྱས་ཀྱི་རང་བཞིན་གྱི་ཕུང་པོ་སོགས་པ་ཡོད་པ་ཡིན་ནོ་ཞེས་འདིར་སྨྲས་པ་ཞེས་བྱ་པ་ལ་སོགས་པའི་བརྒལ་བ་སྔོན་དུ་བཏང་ནས།",
    "འདི་ཡང་ཕྱིན་ཅི་ལོག་པར་མ་གྲུབ་པ་དང་།",
    "མི་མཐུན་པར་མ་གྲུབ་པའོ།",
    "མཐུན་པར་མ་གྲུབ་པ་ལ་གཉིས།",
    "ཡིན་པར་གྱུར་པ་དང་མ་གྱུར་པས་ལས་སུ་གྱུར་པ་དང་མ་གྱུར་པ་མི་བྱེད་པའོ།",
    "འཐད་པ་གཉིས་ལས་དམ་བཅའ་ནི་བརྗོད་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "བྱེད་པ་ཞེས་བྱ་བ་བརྗོད་པ་དོན་གྱིས་སྟོང་པར་འགྱུར་བ་དང་།",
    "བྱེད་པ་པོ་ཞེས་པ་ཡང་དོན་གྱིས་སྟོང་པར་འགྱུར་བ་དང་།",
    "བྱེད་པར་མ་གྱུར་བས་ལས་སུ་གྱུར་བ་མི་བྱེད་པར་བསྟན་པ་ཡིན་ནོ།",
    "ད་ནི་བྱེད་པ་པོ་ཡིན་པར་གྱུར་པ་དང་ཞེས་པ་ནས་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་གྱིས་རིམ་པ་བཞིན་དུ་བསྙད་དོ།",
    "དེ་ལྟར་བརྒྱད་ཀྱིས་ནི་ཕྱིན་ཅི་མ་ལོག་པར་ལས་དང་བྱེད་པ་པོ་མ་གྲུབ་པར་བརྗོད་ནས།",
    "ཕྱིན་ཅི་ལོག་ཏུ་གྲུབ་པར་བརྗོད་པ་ནི་འདིར་སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་བརྒལ་ལན་གྱིས་བསྙད་དེ་སླ་བར་ཟད་དོ།",
    "གལ་ཏེ་དངོས་པོ་ལྷག་མ་ཤེས་པར་བྱ་ཞེས་བྱ་བ་ལ་སོགས་པའི་བརྒལ་ལན་གྱིས་རིམ་པ་བཞིན་དུ་བསྙད་དོ།",
    "དེ་ནས་འཐད་པར་བརྗོད་པའོ།",
    "བྱེད་པོ་ལྟ་བ་ལ་སོགས་པ་མེད་ཀྱང་བྱེད་པ་པོ་གང་ཟག་ཡོད་པར་དོགས་ན།",
    "ཉེ་བར་ལེན་པ་པོ་ཐ་དད་པར་གྱུར་ན།",
    "ཉེ་བར་ལེན་པ་པོ་དང་ལྟ་བ་ལ་སོགས་པ་ཐ་དད་པར་གྲུབ་པ་མེད་དོ་ཞེས་སྙམ་དུ་དགོངས་པའོ།",
    "དཔེར་ན་ལྷ་སྦྱིན་ཁང་པའི་སྐར་ཁུང་བཞི་ལ་རིམ་གྱིས་ལྟ་བ་ན།",
    "ཞེས་བྱ་བས་དགག་བྱ་གང་ཟག་མེད་ན་ནི་བཀག་པ་གང་ཟག་མེད་པར་གྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ནི་ལས་ཀྱང་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་སྟེ།",
    "དང་པོ་ནི་འདི་ཡང་མི་རིགས་པར་ཞེས་བྱ་བ་ནས་བཟློག་ཏུ་མེད་དོ་ཞེས་བྱ་བའི་བར་གྱིས་བསྙད་དོ།",
    "རྣམ་པར་རྟོག་པའི་དོན་དུ་བལྟ་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྔར་སྨོས་པའི་ཉེས་པར་འགྱུར་རོ།",
    "གྲུབ་པ་ཕན་ཚུན་རྟེན་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་དགོངས་པའོ།",
    "དང་པོ་ནི་བརྗོད་པར་བྱ་སྟེ་ཞེས་པ་ལ་སོགས་པས་བསྙད་དོ།",
    "བཞི་པ་གཞན་ལ་སྦྱར་བ་ནི་ཅི་ལྟར་རྣམ་པ་ལྔར་རྣམ་པར་བརྟགས་པ་ན་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དེས་བདག་དགག་པར་མི་ནུས་ཏེ།",
    "དང་པོ་ནི་བརྗོད་པར་བྱ་སྟེ་ཞེས་པ་ལ་སོགས་པས་བསྙད་དེ།",
    "སྔོན་དང་ཕྱི་མའི་ཆ་ཡང་ཡོད་པར་འགྱུར་བས་ན།",
    "ད་ནི་ཐ་མ་སྤྱད་པར་བཞེད་ནས་འདིར་སྤྱད་པར་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེའི་དོན་ནི་ཐ་མ་ཡོད་པར་གསུངས་པ་དང་འགལ་ལོ་ཞེས་བྱ་བར་རྟོག་ན།",
    "དོན་དམ་པའི་བདེ་པ་དགོངས་ནས་ཐོག་མ་དང་ཐ་མ་མེད་པར་བསྟན་པ་ཡིན་ལ།",
    "མ་རིག་པ་དང་སྲིད་པའི་འཇིག་རྟེན་ལ་ལྟོས་ནས་ཀྱང་ཐོག་མ་དང་ཐ་མ་མེད་པར་བསྟན་པ་ཡིན་ནོ།",
    "ཐ་མ་ཡོད་པར་བསྟན་པ་ནི་མ་བརྟགས་ན་ཉམས་དགའ་བ་ཀུན་རྫོབ་ཏུ་མ་རིག་པ་དང་།",
    "བདག་གཞན་གྱིས་མ་བྱས་པའི་འཐད་པ་དང་།",
    "དེ་ལས་གཞན་པས་མ་བྱས་པའི་འཐད་པའོ།",
    "གཞན་གྱིས་མ་བྱས་པའོ།",
    "གཞན་གྱིས་མ་བྱས་པ་ནི་ད་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེའི་དོན་ནི་འཆི་བའི་ཕུང་པོས་སྐྱེ་བའི་ཕུང་པོ་བྱས་པ་ཡིན་ན་ཡང་།",
    "དུས་མཉམ་པ་ཡིན་ན་རྒྱུ་འཆི་བའི་ཕུང་པོ་དང་འབྲས་བུ་སྐྱེ་བའི་ཕུང་པོ་ཕན་ཚུན་གྲུབ་པ་གཅིག་ལ་གཅིག་ལྟོས་པས་འཁོར་ལོ་ལྟ་བུའི་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "གཞན་གྱིས་མ་བྱས་པ་གཉིས་སོ།",
    "མིའི་ཉེ་བར་ལེན་པ་སྡུག་བསྔལ་གྱི་རང་བཞིན་ནི་མིའི་གང་ཟག་ཁོ་ནས་བྱས་སོ་ཞེས་བརྗོད་པས་སྡུག་བསྔལ་བདག་དང་གཞན་གྱིས་བྱས་པའི་ཕྱོགས་ལ་བརྗོད་པའི་ཉེས་པ་ལས་བྲལ་ལོ་ཞེས་རྒོལ་བ་སྔོན་དུ་བཏང་བས་བསྙད་དོ།",
    "གང་ཟག་གཞན་གྱིས་མ་བྱས་པ་ནི་འདིར་ཞེས་བྱ་བ་ལ་སོགས་པས་ལྷའི་ཉེ་བར་ལེན་པའི་ཕུང་པོ་སྡུག་བསྔལ་གྱི་རང་བཞིན་ནོ།"
  ]
}