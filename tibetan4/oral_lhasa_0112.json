    "སྒྱུམའི་གར་གྱིས་རོལ་པར་མངའ་གསོལ་ལོ།",
    "རྣམ་པར་འཕྲུལ་པོ་ཆེ་རུ་མངའ་གསོལ་ལོ།",
    "ཁྲག་འཐུང་ལེགས་ལྡན་དཔལ་འབར་བདུད་ལས་རྣམ་པར་རྒྱལ་ལ་མངའ་གསོལ་ལོ།",
    "བདུད་དང་དགྲ་རྣམས་ཕྱེ་མར་འཐག་ཅིང་ཁྲག་དྲོན་ཐོད་པར་གསོལ་མཛད་པ།",
    "འདིར་གཤེགས་རྒྱན་གྱི་གཏོར་མ་འདི་བཞེས་ཤིག།",
    "ཤཁྲག་དམར་གྱི་གཏོར་མ་འདི་བཞེས་ཤིག།",
    "འཛམ་བུ་ཏི་བའི་ཞལ་ཟས་འདི་བཞེས་ཤིག།",
    "ད་བཅོལ་ལས་ཀྱི་གསལ་འདེབས་གཉན་པོར་བཞེས།",
    "རྣལ་འབྱོར་བཅོལ་བའི་འཕྲིན་ལས་བསྒྲུབ་པར་མཛོད།",
    "ཕུད་ཀྱི་གསེར་སྐྱེམས་གཙང་མ་སོགས།",
    "བློ་གྲོས་བཞེས་ཤིག་རོལ་ཅིག་དགྱེས་པར་མཛོད།",
    "ཚེ་ཡི་རིག་འཛིན་གྲུབ་པར་མཛོད།",
    "དུས་དང་གནས་སྐབས་། ཐམས་ཅད་དུ་འཕྲིན་ལས་བཞིའི་བྱ་བ་ཐམས་ཅད་ལ་ཇི་ལྟར་གསོལ་བ་བཏབ་པའི་དོན་ཐམས་ཅད་དེ་ཁོ་ན་ཉིད་བཞིན་དུ་འགྲུབ་པར་མཛད་དུ་གསོལ།",
    "གཉིས་པ་ཆོ་ག་ལྷག་ཆད་ཁ་བསྐང་ཞིང་བཤགས་པ་ནི།",
    "དེ་ཀུན་མགོན་པོས་བཟོད་པར་མཛོད།",
    "ཞེས་པས་ནོངས་པ་བཟོད་པར་གསོལ།",
    "གསུམ་པ་བརྟན་བཞུགས་སོགས་ཀྱིས་གཏོར་མགྲོན་གྱི་མཇུག་བསྡུ་བ་ནི།",
    "འདིར་ནི་གཟུགས་དང་ལྷན་ཅིག་ཏུ་། འགྲོ་བའི་དོན་དུ་བཞུགས་ནས་ཀྱང་།",
    "མཆོག་རྣམས་ལེགས་པར་སྩལ་དུ་གསོལ།",
    "དམ་ཚིག་པ་རྣམས་རང་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "འཇིག་རྟེན་པ་རྣམས་རང་གནས་སུ་གཤེགས་པར་གྱུར།",
    "འགྲོ་བའི་དོན་ལ་ང་། མཐུ་དང་ལྡན་པར་ཤོག།",
    "མཁྱེན་གཉིས་ཡོན་ཏན་རབ་རྒྱས་པ།",
    "རྣམ་མཁྱེན་གསང་བ་བསམ་མི་ཁྱབ།",
    "ཇ་བཟང་བཞེས་སྤྲོ་རྒྱུན་མི་འཆད།",
    "ཅེས་ཤིས་པར་བརྗོད་པས་དགེ་ལེགས་སུ་བྱའོ།",
    "འོད་འཕྲོས་དོན་གཉིས་བསྒྲུབ་པར་བསམ།",
    "དགྱེས་བཞེས་ཕྱི་ནང་གསང་བའི་ཚོགས་ལ་རོལ།",
    "རྗེ་གྲུབ་ཐོབ་ཆེན་པོའི་གཡང་འབོད་ཀྱིས་ལུང་ལེགས་པར་ནོས་ནས།",
    "ཉི་མ་བྱང་བགྲོད་ཀྱི་ཡར་ངོའི་གཟའ་སྐར་བློ་གྲོས་ཚེས་དུས་བཟང་པོར་འཛུག་པར་བྱ་སྟེ།",
    "རྒྱན་སྣ་ཚོགས་པས་བརྒྱན་ཅིང་པད་ཟླ་སེང་གེའི་སྟེང་ན་རོལ་པའི་སྟབས་ཀྱིས་བཞུགས་པ།",
    "བྱི་བ་སྔོན་པོའི་གདན་ལ་ཕྱེད་སྐྱིལ་གྱིས་བཞུགས་པ།",
    "ཐུགས་རྗེས་འགྲོ་བའི་དོན་དུ་བཞེས་སུ་གསོལ།",
    "བཞེས་ནས་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཚོགས་བསགས་རྒྱས་པར་སྤྲོ་ན།",
    "ཀུན་མཁྱེན་གྱི་མཛད་པའི་བསྟོད་པ་སོགསའདོན་། བཞི་པ་ཕྱྭ་གཡང་བསྡུ་བ་ནི།",
    "སྤྲེའུའི་རྒྱལ་པོ་ལེགས་པར་ཉོན།",
    "ཨོཾ་ཚན་ཨཱ་ཧཱུཾ་ཕྱོགས་བཅུའི་འཇིག་རྟེན་ཁམས་བཞུགས་པའི།",
    "ཁྱད་པར་མཚན་ཙམ་འཛིན་པས་ཀྱང་།",
    "གཙང་རིས་དཔལ་མགོན་དམ་ཚིག་ཅན།",
    "དཀར་གསུམ་གཙང་མའི་ཕུད་ཀྱིས་མཆོད།",
    "པར་བསམས་ལ།",
    "ཞེས་ནོར་ལྷ་སྤྱིའི་སྔགས་རྣམས་ཅི་ནུས་བཟླས།",
    "ཚེ་སྣང་མཐའ་ཡས་རྣམ་པར་རྒྱལ།",
    "མཁྱེན་རབ་བློ་གྲོས་སྤོབས་པ་དེ།",
    "ཁྱད་པར་ཏི་སེ་ཐང་ལྷ་རྨ།",
