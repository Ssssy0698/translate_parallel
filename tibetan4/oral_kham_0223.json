    "འདི་ལ་དཔེ་ལ་ལར་ཀུ་ཀུ་རི་པས་མཛད་ཟེར་བའང་འདུག།",
    "བོད་སྐད་དུ་བསྒྱུར་བ་ཡིན་པས་སྔར་གྱི་རྣམས་ཀྱིས་བྲིས་འདུག་པས་བྲིས་ཞེས་གསུང་ངོ།",
    "འགྲེལ་པ་འདི་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་མཛད་མ་མཛད་རྩོད་པ་ཅན་དུ་འདུག་ནའང་།",
    "བོད་མ་མ་ཡིན་པར་འདུག་ཅིང་མཚན་བཟང་པོར་གཡར་འདུག་པའི་དོན་ལ་དབུ་རུ་བཞུགས་སུ་བཅུག་པ་ཡིན་ཞེས་གསུངས་སོ།",
    "འདི་ཡེ་ཤེས་ཞབས་ཀྱི་རྗེས་འབྲང་བྱ་བའི་དམིགས་བསལ་མི་འདུག་ནའང་།",
    "སྔར་གྱི་རྣམས་ཀྱིས་ཡེ་ཤེས་ཞབས་ལུགས་ཀྱི་སྐོར་དུ་བྲིས་འདུག་པས་བྲིས་སོ།",
    "སྔར་གྱི་རྣམས་ཀྱིས་ཀྱང་བྲིས་འདུག་ཅིང་དོན་བཟང་བས་བྲིས་སོ།",
    "ལྷ་བསྐྱེད་ཆོ་ག་ལ་སོགས་ཀྱང་འཕགས་སྐོར་དང་ཆ་མཐུན་པར་འདུག་ཅིང་།",
    "དེ་ཉིད་ཀྱིས་བསྒྱུར་བ་འདི་གཤེད་དམར་གྱི་སྐོར་ཡིན་ཏེ་འབྲེལ་འདུག་པས་དེར་བཞག་གོ།",
    "དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་གསལ་བ་ཞེས་བྱ་བ་རྒྱ་གར་གྱི་པཎྜི་ཏ་བེ་རོ་ཙ་ན་རཀྵི་ཏས་མཛད་པ།",
    "པཎྜི་ཏ་བེ་རོ་ཙ་ན་དེ་ཉིད་དང་།",
    "སྔ་འགྱུར་ལ་འདི་ལས་ཚན་ཆེ་ཙམ་གདའོ་ཞེས་བུ་སྟོན་གྱིས་གསུངས་སོ།",
    "འདི་དག་ལ་ཐེ་ཚོམ་ཟ་བ་སྣང་ཡང་རྒྱ་གར་མར་བྱེད་ཀྱིན་འདུག་པས་བྲིས་སོ་ཞེས་གསུངས།",
    "ཕྱག་ན་རྡོ་རྗེ་རྣལ་འབྱོར་ཆེན་པོར་བཀྲལ་བའི་སྐོར་འདི་ལ་ཐེ་ཚོམ་ཟ་བའི་གཞི་མང་དུ་སྣང་ཡང་བོད་ན་གྲགས་པ་ཅན་དུ་འདུག་པས་བྲིས་སོ་ཞེས་བུ་སྟོན་གྱིས་གསུངས་སོ། ། གཏུམ་པོ་བེ་ཅོན་ལ་སོགས་པ།",
    "སྐུ་འཁྲུངས་པའི་རྣལ་འབྱོར་པ་ཆེན་པོ་ཤྲཱི་བེ་རོ་ཙ་ན་བཛྲའི་རང་འགྱུར།",
    "ཤྲཱི་བེ་རོ་ཙ་ན་རཀྵི་ཏའི་རང་འགྱུར།",
    "ཤྲཱི་བེ་རོ་ཙ་ན་བཛྲའི་རང་འགྱུར།",
    "སྔར་གྱི་རྣམས་ཀྱི་བྲིས་འདུག་པས་བཞུགས་སུ་བཅུག་པ་ཡིན།",
    "སྔར་གྱི་རྣམས་ཀྱིས་བྲིས་འདུག་པས་བཞུགས་སུ་བཅུག་པ་རྣམས་སོ།",
    "འདི་རྩ་འགྲེལ་གཉིས་ཀ་རྫུན་མ་ཡང་དག་པ་ཅིག་འདུག་སྟེ།",
    "སྔར་གྱི་རྣམས་ཀྱིས་བྲིས་འདུག་པས་འདིར་ཡང་བཞུགས་སུ་བཅུག་པ་ཡིན་ནོ།",
    "འདི་སྤྱོད་པའི་རྒྱུད་དང་བསྐྱེད་ཆོག་རྣམས་མཐུན་པར་བཀོད་འདུག་ནའང་།",
    "རྒྱུད་འགྲེལ་དག་ལས་དམ་ཚིག་གསུམ་བཀོད་བྱ་རྒྱུད་དུ་གསུངས་འདུག་པས་འདིར་བྲིས་སོ།",
    "ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་ཀྱི་ཆོ་ག་སློབ་དཔོན་ཤྲདྡྷཱ་ཀ་ར་ཝརྨས་མཛད་པ།",
    "ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་དངོས་གྲུབ་བརྙེས་པའི་སློབ་དཔོན་མི་ཕམ་བཤེས་གཉེན་གྱི་མཛད་པ།",
    "ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་སློབ་དཔོན་ཆེན་པོ་མི་ཕམ་བཤེས་གཉེན་གྱིས་མཛད་པ།",
    "གང་ལྟར་བྱས་ཀྱང་སྣང་སྟོང་དབྱེར་མེད་ལས་མ་འདས་པ་རྨི་ལམ་ལྟར་ཡུལ་ཡུལ་བ་འདིར་གདའ།",
    "སྟོང་གཟུངས་དང་རང་སེམས་དབྱེར་མེད་སྣང་སྟོང་ཟུང་འཇུག་ལ་གནས་པ་དེ་སོ་སོར་རྟོགས་པའི་ལྷག་མཐོང་ཞེས་གསུངས་པ་དེ་ཡིན།",
    "དེ་ཟ་ཞིང་འདུག་པ་དང་།",
    "དེ་ནས་རྒྱལ་པོ་དེ་བློན་པོའི་ཚོགས་ཀྱིས་བསྐོར་ཏེ་འཁོར་གྱི་ནང་ན་འདུག་པ་དང་།",
    "འཁོར་གྱི་ནང་ན་འདུག་སྟེ་དགའ་བ་ལྟ་བའི་ཕྱིར་ལྷགས་པའི་བློན་པོ་ལ་སོགས་པ་བྲམ་ཟེ་དང་།",
    "བདེ་བར་འདུག་པས་ལྟ་སུ་ཞིག་སྦྱིན་པར་མི་བྱེད།",
    "བདེ་བར་འདུག་པ་ལྟ་སུ་ཞིག་སྦྱིན་པར་མི་བྱེད།",
    "མི་རྣམས་ནི་མེད་ལ་སྒྲ་ཅ་ཅོ་ཡང་མེད་ལ་སྡུག་བསྔལ་བ་ལྟར་འདུག་ཅིང་།",
    "ཟོར་བ་ཞིག་དེ་ན་འདུག་པ་མཐོང་ནས།",
    "སེམས་དཔའ་ཆེན་པོ་དེ་རྙེད་པའི་མཆོག་རྙེད་པ་བཞིན་དུ་དགའ་བར་གྱུར་ཅིང་དེ་ན་འདུག་གོ།",
    "ཀུ་རུ་ཞེས་བྱ་བའི་གླིང་ལྷོ་ཕྱོགས་ཀྱི་རྒྱ་མཚོའི་ནང་ན་འདུག་པ།",
    "སྤྱུགས་གླུ་ནི་ལེན་ཅིང་འདུག་པ་མཐོང་ནས།",
    "གྲོགས་ཀྱིས་བསྐོར་བའི་ནང་ན་འདུག་གྱུར་ཞིང་།",
    "གཅིག་པུའང་གྲོགས་ཀྱི་ནང་འདུག་འདྲ།",
    "བདག་ནི་འཇིགས་པ་མེད་པར་འདུག།",
    "འདི་དག་རིགས་དང་རང་བཞིན་དེ་ལྟ་ལགས།",
    "ལོ་མས་བརྒྱན་པའི་ཤིང་ལྗོན་པ་སྣུམ་སྣུམ་ལྟར་འདུག་པ་དུ་མས་གང་བ།",
    "རི་དྭགས་ཀྱི་རིགས་དུ་མ་རྒྱུ་བ་མཚོ་ཆུ་སྔོན་པོ་གཙང་མས་ཆེད་དུ་བསྐོར་བ་ལྟར་འདུག་པ།",
    "དུས་ཐམས་ཅད་དུ་བདེ་བ་དེ་ལྟ་བུ་ཞིག་ན་གནས་བཅས་ཏེ་འདུག་གོ།",
    "ནགས་ཚལ་དེ་ན་ཆུང་མ་འདུག་པས་བཀུར་སྟི་བྱས།",
    "བྲམ་ཟེ་ལམ་གྱི་རྡུལ་གྱིས་རྐང་པ་དང་བྱིན་པ་རྩུབ་རྩུབ་ལྟར་འདུག་པ།",
    "དེ་བས་བདག་ནི་འདུག་མི་འདོད།",
    "དེ་ལ་མིག་ཚུགས་ལྟ་ཞིང་བྲིས་བཞིན་འདུག།",
    "བགོ་སྐལ་གྱི་རིམ་པས་ཐོབ་པའི་ས་སྐྱོང་ཞིང་འདུག་གོ་ཞེས་གྲགས་སོ།",
    "འབངས་རྣམས་བསྲུང་བར་སེམས་པར་ང་འདུག་ཅིང་།",
    "མཚོན་ཆ་དང་གོ་ཆ་དྲི་མ་མེད་པ་བགོས་པས་འབར་འབར་ལྟར་འདུག་པ།",
    "ལྷའི་གོས་དཀར་པོ་ཅན་གྱི་སྟེང་ན་འདུག་ནས།",
    "ང་ནི་འདི་ན་འདུག་བཞིན་དུ།",
    "ཆགས་པས་རྩེ་གཅིག་ཡིད་དུ་གྱུར་ཞིང་འདུག་པའི་ཚེ།",
    "ཆུ་ཀུན་ཐ་མལ་འདུག་ལས་རབ་ཏུ་གཡོས།",
    "འདི་ལྟར་གདའ་བ་རྒྱ་མཚོ་གང་ཞིག་ལགས།",
    "དེ་ལྟར་གདའ་བའི་རྒྱ་མཚོ་འདི་གང་ལགས།",
    "ཆོ་གའི་ཟས་ཟ་བཞིན་དུ་འདུག།",
    "མདུན་གྱི་ནམ་མཁའ་ལ་བྱུང་སྟེ་འདུག་པར་གྱུར་ཏོ།",
    "བཙོང་རྒྱུ་དེ་ནི་བུམ་པ་འདི་ན་འདུག།",
    "དེ་ནི་སྨད་པའི་ལུས་བཞིན་བུམ་པ་འདི་ན་འདུག།",
    "པདྨའི་ལོ་མ་ནི་རྒྱན་འཁྲུགས་ཤིང་འདུག་པ་མཐོང་ནས།",
    "ཕྱག་དར་ཁྲོད་ཀྱི་ཚེམ་བུ་དྲུབ་ཅིང་འདུག་གོ།",
    "ཡིད་ལ་བྱ་བའི་མན་ངག་དེས་བསྟན་པའི་ཚུལ་བཞིན་དུ་བསམ་གཏན་བྱེད་ཅིང་འདུག་གོ།",
    "ཨུཏྤ་ལ་ཁ་བྱེ་བ་ནི་རབ་ཏུ་དགོད་པ་བཞིན་དུ་འདུག་པ།",
    "དེ་དང་ཉེ་བའི་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "དེ་བཞིན་དུ་སེམས་འཁྲུག་པ་མེད་ཅིང་རབ་ཏུ་ཞི་བར་ཕྱག་དར་ཁྲོད་པའི་ཚེམ་བུ་དྲུབ་ཅིང་འདུག་གོ།",
    "མཐུ་མེད་ཞུམ་ནས་རབ་ཏུ་ཞི་བར་འདུག།",
    "གུད་དུ་འདུག་ཀྱང་ཡིད་འཕྲོག་གྱུར།",
    "མེ་ཏོག་ཀུ་མུ་ཏ་དཀར་པོ་རྣམས་ནི་དགོད་པ་བཞིན་དུ་འདུག་པའི་མཚོ་དེ་མཐོང་བར་གྱུར་ཏོ།",
    "ལྷ་སྔོན་ངང་པ་མཆོག་གཉིས་ཤིག་ཡོན་ཏན་དང་གཟུགས་དཀའ་མཆིད་དུ་གདའ་བ།",
    "འདི་ན་འདུག་པ་མི་རིགས་སོ།",
    "དེ་ནས་གཅིག་ནི་རྙིས་ཟིན་གཅིག་ནི་མ་ཟིན་པར་བདེ་བར་འདུག་བཞིན་དུ།",
    "རིམ་གྲོ་བྱེད་ཅིང་འདུག་པ་མཐོང་ནས།",
    "བདག་ལ་བྱམས་པས་ཟིན་བཞིན་འདུག།",
    "རྒྱལ་པོ་དེ་ད་ལྟ་ཇི་ལྟར་འདུག་སྙམ་པ་དང་།",
    "མིའི་བདག་པོ་ནི་སེང་གེའི་ཁྲི་ལ་འདུག་པར་འོངས་སོ།",
    "དེ་ངོ་ཚ་བར་གྱུར་ནས་ཅུང་ཞིག་མ་གོ་སྨད་དེ་འདུག་གོ།",
    "རྩོལ་ཕོད་པའི་མཐུ་ཆེ་ཞིང་བརྟན་ཀྱང་བཀའ་ཐུབ་ཀྱི་ནགས་ན་འདུག་བཞིན་དུ།",
    "མཁས་པ་རྣམས་ཀྱང་རང་དགར་ཅི་བདེར་སྤྱོད་པའི་རིགས།",
    "ཤིང་ཏིན་དུ་ཅིག་གད་པ་གཡང་ཟ་བའི་ཁ་ན་འདུག་པའི་ཡལ་ག་འབྲས་བུ་སྨིན་པའི་ལྕིད་ཀྱིས་དྲུད་ཅིང་སེར་པོར་གྱུར་པ་ཞིག་མཐོང་ངོ།",
    "ལ་ལ་ང་དང་རང་ལ་ཕན་པ་དང་།",
    "དེ་ཉིད་སྐྱེངས་བཞིན་ཅན་དུ་འདུག་པ་མཐོང་།",
    "བདག་ཉིད་ཆེན་པོ་གང་ན་འདུག་པ་དེའི་ཕྱོགས་སུ་རྟ་མགྱོགས་པ་དེ་བརྒྱུགས་པ་དང་།",
    "རྟ་ཞོན་པ་མེད་པར་གྲོག་རོང་ཁ་ན་འདུག་པ་མཐོང་ངོ།",
    "འགྲེ་ཞིང་འདུག་པ་མཐོང་ངོ།",
    "གྲོག་རོང་དེ་ཡི་ནང་ན་འགྲེ་ཞིང་འདུག་པ་ཡི།",
    "ནགས་ཚལ་སྟུག་པོ་སྐྱེ་བོ་མེད་པ་དག་ན་ཉམས་དགའ་བར་འདུག་གོ།",
    "རི་དྭགས་རྣམས་ཀྱི་བདག་པོ་བྱེད་ཅིང་འདུག་གོ།",
    "དཔལ་རབ་ཏུ་འབར་བ་སེང་གེའི་ཁྲི་སྟེང་ན་འདུག་ཅིང་།",
    "དེ་ནས་མི་དེས་རི་དྭགས་རུ་རུ་དེ་བག་ཕབ་ཅིང་འདུག་པ་མཐོང་ནས།",
    "འབབ་ཆུའི་འགྲམ་ཅིག་ནའང་འདུག་པ་གོར་མ་ཆག་གོ།",
    "ལུས་སྣད་ལ་ཡུན་རིང་དུ་ཟམ་པ་བྱེད་ཅིང་འདུག་འདུག་པས་དུབ་པའི་ཕྱིར་གདོན་མི་ཟ་བར་བདག་རང་ལྡང་མི་ནུས་ཀྱིས།",
    "གསོལ་ཀ་བའི་ལག་ན་རལ་གྲི་འདུག་པ་བླངས་ཏེ།",
    "གཞལ་མེད་ཁང་གཙང་མ་བཟང་པོ་ཅིག་ན་འདུག་པ་དེའི་མདུན་དུ་ཚངས་པའི་འཇིག་རྟེན་ནས་འོད་འབར་ཞིང་བབ་སྟེ་འོང་བར་གྱུར་ཏོ།",
    "མངལ་ན་འདུག་པའི་སྔོན་རོལ་བློ་དེ་ནི།",
    "རབ་ཏུ་མནར་བའི་གནས་ན་འདུག་པ་ན།",
    "དེ་དང་མི་རིང་བ་ཅིག་ན་གླང་པོ་ཆེ་ཞིག་ཤི་ནས་རིང་པོར་མ་ལོན་པའི་རོ་ཞིག་འདུག་པ་མཐོང་ངོ།",
    "དེ་ནས་དེ་འབངས་རྣམས་སྐྱོང་ནུས་པ་དང་མ་འཇུངས་ཤིང་རང་བཞིན་བཟང་བའི་ཕྱིར་རྒྱལ་པོས་རྒྱལ་ཚབ་ཀྱི་ལོངས་སྤྱོད་བྱེད་དུ་བཅུག་གོ།",
    "དེ་དེ་ན་འདུག་པའི་དྲུང་དུ་བྲམ་ཟེ་ལེགས་པར་སྨྲ་བ་ལ་མཁས་པ་ཞིག་འོངས་ཏེ།",
    "ཞེ་ས་དང་ཕྱག་བྱས་ནས་དེའི་གཟུགས་བཟང་པོ་ལ་སེམས་ཆགས་བཞིན་དུ་དེར་འདུག་གོ།",
    "ཁྲོས་ཤིང་རྔམས་པས་མིག་ནི་བགྲད་ཅིང་འཇིགས་འཇིགས་ལྟར་འདུག།",
    "མིག་བགྲད་དེ་དེ་ལ་ལྟ་ཞིང་ངལ་བསོ་ཞིང་འདུག་གོ།",
    "དགྲ་ཐབས་ལ་མཁས་ཤིང་དཔའ་བ་གཡུལ་ངོ་དུ་མ་ལས་རྒྱལ་བར་གྱུར་པའི་དཔུང་ཆེན་པོ་འཇིགས་འཇིགས་ལྟར་འདུག་པ་བཤམས་ཟིན་གྱིས།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "རྒྱན་བཟང་པོ་དགའ་དགའ་ལྟར་འདུག་པ་ལ་བལྟར་འགྲོ་བ་ལ་ཕས་ཀྱང་གནང་སྟེ།",
    "གཤིན་རྗེའི་དགྲ་ནི་གཅིག་པུར་འདུག་ཀྱང་མི་ཐུབ་ལ།",
    "ནགས་དང་ཁྱིམ་ན་འདུག་ཀྱང་འཆི་བདག་འོང་འགྱུར་ལ།",
    "བར་བར་ནི་བཀྲེས་ཏེ་ཟས་བཙལ་དུ་འགྲོ་བའི་ལམ་བཀག་སྟེ་འདུག་གོ།",
    "མཆེ་བའི་བར་ན་འདུག་པའི་ཤ་ཡང་འཕྲོག་ནུས་ན།",
    "གནས་ཤིང་སྤྱོད་པ་ནི་སྤྱོད་ཅིང་འདུག་པའོ།"
  ]
}