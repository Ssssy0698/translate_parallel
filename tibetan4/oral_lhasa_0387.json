    "དོར་བར་བྱ་བ་ནི་གཞག་པར་མི་བྱ་བའོ།",
    "ལོངས་སྤྱོད་པའི་ཆུ་དང་ཐང་ནི་ལོངས་སྤྱོད་པར་བྱ་བ་སྟེ།",
    "ཁ་བཀང་བ་ནི་ཁ་གང་བར་བྱས་པ་སྟེ།",
    "འཇིག་རྟེན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཇིག་རྟེན་རྣམས་ཀྱི་དང་བ་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་གང་ཡིན་པ་དེ་ཐམས་ཅད་བསྟན་བཅོས་སམ་ཐ་སྙད་བལྟས་ཤིང་མཁས་པ་ལ་དྲིས་ནས་སྤང་བར་བྱའོ་ཞེས།",
    "དུས་མ་ཡིན་པར་སྨྲ་བ་མ་ཡིན།",
    "བཞིན་གྱི་མདངས་རབ་ཏུ་དང་བ་ཡིན་ནོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ལམ་ཡང་བསྟན་པར་མི་བྱའོ་ཞེས་འཇིག་རྟེན་ལ་མ་དད་པ་སྤང་བའི་ཕྱིར།",
    "དགོས་པ་ཆུང་ངུ་ལ་ལག་པ་བརྟེན་ཏེ་འགའ་ཞིག་ལ་བོད་པར་མི་བྱའོ།",
    "དེ་མི་བྱེད་ན་མཉམ་པར་མ་བཞག་པ་དང་སྤྱོད་པ་མ་བསྡམས་པར་འགྱུར་རོ།",
    "དེས་ཉལ་བ་ཡོངས་སུ་བརྟག་པ་ནི་འདི་ལྟར་ཡོངས་སུ་བརྟག་པར་བྱའོ་ཞེས་བསྟན་པ་མགོན་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བཅོམ་ལྡན་འདས་མྱ་ངན་ལས་འདས་པ་ཆེན་པོ་གཟིམས་པ་བཞིན་ཉལ་བ་བརྟག་པར་བྱའོ།",
    "མྱུར་དུ་ལྡང་བ་ནི་སྐྱེན་པར་ལྡང་བར་བྱ་བའོ།",
    "ལུས་གཅུ་བ་དང་ལེ་ལོས་ཉམས་པས་གནས་པར་མི་བྱ་སྟེ།",
    "ཉིན་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་ན་བསམས་བཞིན་དུ་བྱས་པ་གང་སླར་བཅོས་པ་སྟེ།",
    "ཤེས་བཞིན་མ་ཡིན་པས་བྱས་པ་དེ་དག་རབ་ཏུ་ཞི་བར་བྱ་བ་ནི་ཕྱིར་བཅོས་པ་སྟེ།",
    "རྒྱལ་བ་བཅོམ་ལྡན་འདས་ལ་ཡང་དག་པར་བརྟེན་པས་སོ།",
    "འདི་ལྟ་སྟེ་རྣམ་པར་སུན་འབྱིན་པ་ཀུན་ཏུ་སྤྱོད་པ་དང་།",
    "དེ་ལ་རྣམ་པར་སུན་འབྱིན་པ་ཀུན་ཏུ་སྤྱོད་པའི་སྟོབས་ནི།",
    "དེ་ལ་ཉེས་པ་བཟློག་པའི་སྟོབས་ནི་སྡོམ་པ་ཡང་དག་པར་བླངས་ནས་མི་བྱེད་པའི་སྡོམ་པ་ཐོབ་པའོ།",
    "དེ་དག་བསླབ་པ་ཀུན་ལས་བཏུས་པར་བལྟ་བར་བྱའོ།",
    "དེ་ལ་བཤགས་པ་ནི་འདི་ཡིན་ཏེ།",
    "དེ་དག་མ་ལུས་པར་བསླབ་པ་ཀུན་ལས་བཏུས་པ་ལས་རིག་པར་བྱའོ།",
    "རྣམ་པར་སུན་འབྱིན་པ་ཀུན་ཏུ་སྤྱོད་པ་བསྟན་ཏོ།",
    "ཉེས་པ་བཟློག་པའི་སྟོབས་ཀྱང་རྒྱས་པར་བསླབ་པ་ཀུན་ལས་བཏུས་པ་ཉིད་ལས་བལྟ་བར་བྱའོ།",
    "ཡང་ངེས་པ་མེད་པར་བསྟན་པ།",
    "རང་ངམ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཡང་ཅི་ལྟར་ངེས་པ་མེད་པར་བརྗོད་ཅེ་ན།",
    "རྒྱལ་སྲས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསླབ་པའི་གཞིའི་རྒྱུ་འདི་ཡང་གཟུང་བར་བྱའོ་ཞེས་གསུངས་པ།",
    "ཞེས་གང་གསུངས་པ་དེ་རྟག་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤིན་ཏུ་རྙེད་པར་དཀའ་བ་དེ་ལྟ་བུའོ།",
    "བག་མེད་པའི་གནས་ལས་ཡང་དག་པར་བཟློག་པའོ།",
    "ང་རྒྱལ་དང་ཆེ་བའི་ང་རྒྱལ་རྣམ་པར་སྤོང་བས་ཕྱག་དར་བ་ལྟ་བུའི་སེམས་དང་།",
    "ནན་ཏན་ལ་ནི་དགྲ་སེལ་བའི་འདུ་ཤེས་བསྐྱེད་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དུ་གསུངས་པ་ལྟ་བུའོ།",
    "ཞེས་གང་གསུངས་པ་དེ་བསྟན་པར་བྱ་བའི་ཕྱིར་གསུངས་པ།",
    "ནམ་མཁའ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟར་ཡང་དེ་ཉིད་ལས་གསུངས་པ།",
    "ཁྱིམ་ན་གནས་པར་བྱེད་པའམ།",
    "ལོག་པར་ལྟ་བ་དང་།",
    "གཞན་ཡང་དག་པར་ལེན་དུ་འཇུག་པ་ལས་ནི་ལྔ་པའོ།",
    "དེ་ཉིད་ལས་གསུངས་པ།",
    "གཞན་དག་ཀྱང་དེ་བཞིན་དུ་ཡང་དག་པར་ལེན་དུ་འཇུག་པ་ལས་ནི་དྲུག་པའོ།",
    "རྩ་བ་དེས་ཆོ་ག་ཉམས་པ་རྣམས་དང་བཀུར་སྟི་ཉམས་པར་བྱེད་པ་རྣམས་ཀྱིས་ཉེ་བར་སྤྱོད་པ་དང་།",
    "གཉིས་པར་ཐུབ་པས་གསུངས་པ་ཡིན།",
    "བཙོན་རར་འཇུག་པར་བྱེད་པ་དང་།"
  ]
}