    "རིག་པ་འཛིན་པས་རིག་པ་ཡིད་ལ་བྱེད་ཅིང་བདུག་སྤོས་བསྲེག་པར་བྱའོ།",
    "པདྨ་རབ་ཏུ་འཐོར་བཞིན་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "དེའི་བར་མ་ཆད་པར་ཁྲོ་གཉེར་ཅན་མ་གོས་དཀར་པོ་འཆང་བ་འདྲིར་གཞུག་པར་བྱའོ།",
    "རིག་པའི་རྒྱལ་པོའི་ཉེ་ལོགས་སུ་གསེར་ལྡན་མའང་རྡོ་རྗེ་ལྕགས་ཀྱུ་མ་འདྲིར་གཞུག་པར་བྱའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་སྔོ་བསངས་རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "རྡོ་རྗེ་བསྣམས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "རྡོ་རྗེ་དབྱུག་པ་དབྱུག་པ་བསྣམས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "གནམ་ལྕགས་མའང་རྡོ་རྗེ་དབྱུག་པའི་རྒྱབ་ཏུ་འདྲིར་གཞུག་པར་བྱའོ།",
    "གཡོན་དུ་ལྷ་སྐྲག་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "གཙུག་འཕྱང་རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "རྒྱལ་པོ་ཆེན་པོ་བཞི་བྱ་སྟེ་ལོག་འདྲེན་གྱི་རིགས་བཞི་རྣམས་རྣམ་པར་འགྱུར་བའི་གཟུགས་ཅན།",
    "ཀླུ་ལག་ན་པདྨ་ཐོགས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "ལྷའི་ཚོགས་ཐམས་ཅད་ཀྱང་མེ་ཏོག་རབ་ཏུ་འཐོར་བཞིན་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "ལྷའི་རྔ་བོ་ཆེ་འདྲིར་གཞུག་པར་བྱའོ།",
    "རིག་པ་འཛིན་པའི་རྒྱལ་པོ་ལུས་མེད་འདྲིར་གཞུག་པར་བྱའོ།",
    "ཀླུའི་རྒྱལ་པོའི་ཉེ་ལོགས་སུ་སྒྲུབ་པ་པོ་ལག་ན་སྤོས་ཕོར་ཐོགས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "དེ་ནས་འདི་ལ་རིག་པ་འཛིན་པ་ལུས་མེད་ཀྱི་རྨི་ལམ་དུ་སྟོན་པར་བྱེད་དེ།",
    "པདྨ་བཞིས་ཡོངས་སུ་བསྐོར་བ་བཞི་པོ་འདི་འདབ་མ་བརྒྱ་པར་བྱེད་དུ་གཞུག་གོ།",
    "ཟན་ཟ་ཞིང་རིག་པ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་ཉི་མ་བདུན་པ་ལ་གྲོགས་བཞག་པར་བྱའོ།",
    "ལེགས་པར་བསམས་པའི་ཚེ་ན་བྱས་པ་གཟོ་བ།",
    "ཀླུ་རྣམས་ཀྱང་སྒྲ་སྒྲོགས་ཏེ་འཇིགས་པར་མི་བྱའོ།",
    "ལོག་འདྲེན་རྣམས་ཀྱང་རྣམ་པར་འབྲོས་ཏེ་ལྷན་ཅིག་འཇིག་རྟེན་གྱི་ཁམས་གང་དུ་འགྲོ་བར་བྱེད་པ་རིག་པ་འཛིན་པ་དེ་རྣམས་འོང་བར་བྱེད་དོ།",
    "སྤྲིན་རྣམས་ཀྱང་འུར་འུར་པོའི་སྒྲ་སྒྲོག་པར་བྱེད་པར་བྱེད།",
    "རིག་པ་འཛིན་པའི་རྒྱལ་པོ་ཐམས་ཅད་ཀྱང་འདུས་པར་འགྱུར་རོ།",
    "ལྷན་ཅིག་འབྱོན་པར་འགྱུར་རོ།",
    "དེ་ནས་རིག་པ་འཛིན་པས་པདྨ་མནན་ནས་རིག་པ་ལན་བདུན་བཟླས་པར་བྱའོ།",
    "དེ་ནས་རིག་པ་འཛིན་པས་ལན་གཅིག་བརྗོད་པར་བྱའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་མའི་སྐུ་ལས་འོད་ཟེར་སྣ་ཚོགས་པ་འབྱུང་སྟེ་སྒྲུབ་པ་པོ་ལ་བྱུགས་ནས་པདྨའི་ཟེ་འབྲུར་ནུབ་པར་འགྱུར་རོ།",
    "ལྷ་རྣམས་ཀྱིས་ཀྱང་བསྟོད་པར་བྱ་བཞིན་པ།",
    "དམ་པར་བྱས་པ་དམར་སེར་མཆོད་ཕྱིར་ཐོགས་དཀར་པོ།",
    "གཡོན་དུ་རྡོ་རྗེ་འཆང་སྔོ་བསངས་རྣམ་པར་རྒྱན་དང་བཅས་པ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་མ་འདྲིར་གཞུག་པར་བྱའོ།",
    "ལྷའི་རྔ་པོ་ཆེ་འདྲིར་གཞུག་པར་བྱའོ།",
    "འོག་ཏུ་སྤོས་ཕོར་ལག་ན་ཐོགས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "དཀར་གསུམ་ཟ་ཞིང་རས་རིས་ཀྱི་སྤྱན་སྔར་རིག་པ་འབུམ་ཕྲག་བདུན་བཟླས་པར་བྱའོ།",
    "དེ་ལྟ་བུ་སྔོན་སྤྱད་པ་བྱས་པར་འགྱུར་རོ།",
    "དེ་ནས་ལས་ཡང་དག་པར་བརྩམས་ཏེ་སྔོན་དུ་ལྡོང་རོས་བླངས་ཏེ་གོས་ཀྱི་ནང་དུ་འོ་མ་བཀྲུ་བར་བྱའོ།",
    "འབར་བར་གྱུར་པ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་རིག་པ་འཛིན་པས་རྒྱ་མཚོར་འཇུག་པར་བྱ་སྟེ་ཇི་སྲིད་ཉི་མ་འཆར་བར་འགྱུར་བ་དེ་སྲིད་དུ་ཆུར་གནས་པར་བྱའོ།",
    "ཐམས་ཅད་ཀྱང་བན་ཀན་མཐར་བྱེད་ཀྱི་འབྲས་བུ་ལ་སོ་སོར་དགོད་པར་བྱའོ།",
    "དེ་ལྟ་བུ་སྔོན་སྤྱད་པ་བྱས་པར་འགྱུར་རོ།",
    "འཇིགས་པར་མི་བྱ་བར་སླར་ཡང་རིག་པ་བཟླས་པར་བྱའོ།",
    "རྒྱན་མ་ཉམས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "དེ་ནས་སྒྲུབ་པ་པོས་རས་རིས་ཀྱི་སྤྱན་སྔར་རིག་པ་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "འབར་བར་གྱུར་གྱི་བར་དུ་རིག་པ་བཟླས་པར་བྱའོ།",
    "འོ་མས་ཁྲུས་བྱས་ནས་མི་སྨྲ་བར་རིག་པ་སྟོང་ཕྲག་བརྒྱད་བཟླས་པར་བྱའོ།",
    "དེ་ནས་མགོ་བོའི་ཐོད་པ་ལྔ་བླངས་ནས་དྲི་བཟང་པོའི་ཏིལ་མར་གྱིས་རབ་ཏུ་སྦར་བར་བྱ་སྟེ་དུ་བ་མེད་པར་བྱའོ།",
    "དེ་ནས་རིག་པ་འཛིན་པ་རིངས་ཐབས་སུ་རིག་པ་ལན་བདུན་ཡོངས་སུ་བཟླས་པར་བྱའོ།",
    "རྡོ་རྗེ་དེ་ལག་པ་གཡས་པས་མནན་ནས་ཇི་སྲིད་བཅོམ་ལྡན་འདས་མ་ལ་འོད་ཟེར་བྱུང་བ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "རྡོ་རྗེའི་ཙི་ཊི་ཙི་ཊིའི་སྒྲ་ཐོས་ཏེ་འཇིགས་པར་མི་བྱ་བར་སླར་ཡང་ཡུད་ཙམ་རིག་པ་བཟླས་པར་བྱའོ།",
    "ཇི་སྲིད་རྔ་བོ་ཆེའི་སྒྲ་ཐོས་པ་ན་སླར་ཡང་ཡུད་ཙམ་དུ་རིག་པ་བཟླས་པར་བྱའོ།",
    "དེས་དུས་གསུམ་དུ་ཁྲུས་བྱས་པས་སྐྲ་ལི་ཞིང་འཁྱིལ་བ།",
    "དེ་ནས་ལྕགས་ཀྱུ་སྒྲུབ་པར་འདོད་ན་སྔོན་བཞིན་དུ་སྒྲུབ་པ་པོ་སྔོན་སྤྱོད་པར་བྱའོ།",
    "དེའི་ཉེ་ལོགས་སུ་བཅོམ་ལྡན་འདས་མ་ཁྲོ་གཉེར་ཅན་མ་འདྲིར་གཞུག་པར་བྱའོ།",
    "རྡོ་རྗེ་འཛིན་པའང་དེ་བཞིན་གཤེགས་པའི་གཙུག་ཏོར་དུ་རབ་ཏུ་འཇུག་བཞིན་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "ཐམས་ཅད་ཀྱང་པདྨའི་གདན་ལ་རབ་ཏུ་གནས་པར་བྱའོ།",
    "འོད་ཟེར་དེ་སྒྲུབ་པ་པོ་ལ་བསྐོར་བ་བྱས་ཏེ་ནུབ་པར་འགྱུར་ཏེ་དེ་བཟུང་བས་རིག་པ་འཛིན་པར་འགྱུར་ཏེ་རིག་པ་འཛིན་པ་ཐམས་ཅད་ཀྱང་རྗེས་སུ་འབྲང་བར་འགྱུར་རོ།",
    "བསྐལ་པར་གནས་པ་དང་།",
    "རང་འཆི་བ་ཤེས་པར་བྱེད་དོ།",
    "དེ་ནས་ཡང་ཚངས་པ་ཆེན་པོས་ཆོ་ག་གསུངས་པ།",
    "རྟག་ཏུ་སྐྱེ་བ་དྲན་པར་འགྱུར་རོ།",
    "བཀླགས་པས་ལས་རྣམས་འགྲུབ་པར་འགྱུར་རོ།",
    "ཁྲོས་པའི་མདུན་དུ་དྲན་པར་བྱས་ན་དཔལ་རབ་ཏུ་སྟེར་རོ།",
    "རྡོ་རྗེ་རྣམས་བཅིངས་པ་བྱས་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་རྣམ་པར་དབྱེ་བ་བྱས་པར་འགྱུར་རོ།",
    "འོད་དཔག་མེད་དབུ་ལ་བཞུགས་པ།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པའོ།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "པྲི་ཡང་ཀུ་ལྟར་སྔོ་བསངས་འདྲིར་གཞུག་པར་བྱའོ།",
    "འོག་ཏུ་ལོག་འདྲེན་སྣ་ཚོགས་པའི་གཟུགས་ཅན་འདྲིར་གཞུག་པར་བྱའོ།",
    "ལྷ་ཐམས་ཅད་ཀྱང་པདྨའི་གདན་ལ་གནས་པར་བྱའོ།",
    "འབར་བར་གྱུར་པ་དེ་སྲིད་དུ་རིག་པ་བཟླས་པར་བྱའོ།",
    "ཡུངས་ཀར་ལ་ལན་བརྒྱ་བཟླས་པ་བསྣུན་པར་བྱ་སྟེ་མཆོད་ཕྱིར་ཐོགས་སུ་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་མ་དྲན་པ་ཉིད་ཀྱི་རྗེས་སུ་བླངས་པར་བྱ་སྟེ་བླངས་བ་ཙམ་གྱིས་སྐྲ་ལི་ཞིང་འཁྱིལ་བ་ལོ་བརྒྱད་གཉིས་ལོན་པའི་རྣམ་པ་དཀར་ཞིང་དྭང་བའི་ལུས་རིག་པ་འཛིན་པས་བཅུ་གཉིས་ཀྱི་མངའ་བདག་ཏུ་འགྱུར་རོ།",
    "རཱ་ཛ་ཧཱ་སྟེ་རྫས་འདི་རྣམས་གཅིག་ཏུ་བྱས་ནས་བཀྲུ་བར་བྱའོ།",
    "འབར་བར་གྱུར་གྱི་བར་དུ་རིག་པ་བཟླས་པར་བྱའོ།",
    "དེའི་ཚེ་རིག་པ་འཛིན་པ་རྣམས་ལའང་ཆ་ཤས་སྦྱིན་པར་འགྱུར་རོ།",
    "དེ་ནས་བགྲང་ཕྲེང་སྒྲུབ་པར་འདོད་ན་སྔོན་བཞིན་དུ་རྒྱ་མཚོར་འབུམ་ཕྲག་ལྔ་བཟླས་པར་བྱའོ།",
    "སྐྱི་བུང་བཞག་ནས་བར་དུ་གཞག་པར་བྱའོ།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་བགེགས་ཆར་ལྟ་བུ་ལ་འཇིགས་པར་མི་བྱའོ།",
    "ཇི་སྲིད་ཙམ་གདུང་དུ་འགྱུར་ཏེ་ཡིད་ཀྱིས་མཆོད་ཡོན་ཕུལ་ནས་སླར་ཡང་ཇི་སྲིད་བགྲང་ཕྲེང་དུ་འགྱུར་གྱི་བར་དུ་བཟླས་པར་བྱའོ།",
    "སླར་ཡང་སྒྲུབ་པ་པོས་འཆང་བཞིན་པས་བཅོམ་ལྡན་འདས་མ་ལན་བདུན་བཟླས་པར་བྱའོ།",
    "དེས་རྒྱལ་བའི་སྤྱན་དང་མཚུངས་པར་འགྱུར་ཏེ་ལོ་སྟོང་ཕྲག་བཞིར་འཚོ་བར་འགྱུར་རོ།",
    "ནག་པོའི་བཅུ་བཞི་ལ་སྐྱེས་བུ་ཤི་བ་དེའི་ཡན་ལག་ལས་སྐྱེས་པ་བླངས་ནས་སྐམ་པོར་བྱས་ཏེ་བསྐ་བས་བཀྲུ་བར་བྱའོ།",
    "བགེགས་ཀྱི་གཟུགས་ཁ་འོག་ཏུ་བལྟས་བ་རྣམ་པར་འགྱུར་བའི་རྣམ་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "དེ་ནས་རས་རིས་ཀྱི་སྤྱན་སྔར་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་རིག་པ་འཛིན་པས་ལེགས་པར་ངེས་པ་སྐྱེས་པའི་རོ་བླངས་ནས་དུར་ཁྲོད་དུ་དྲི་དང་།",
    "མེ་ཏོག་ལ་སོགས་པས་བཅོམ་ལྡན་འདས་མ་མཆོད་ནས་འབྱུང་པོ་ཐམས་ཅད་པའི་གཏོར་མ་བྱས་ཏེ་གྲོགས་བཟང་པོས་སྲུང་བ་བྱས་པ།",
    "གཙང་མས་གོས་གཙང་མ་བགོས་ཏེ་རོའི་དཔྲལ་བར་རྐང་པ་བྱིན་ནས་གནས་པས་རིག་པ་བཟླས་པར་བྱའོ།",
    "ཇི་སྲིད་ན་ལྡང་བར་བྱེད་དེ་འཇིགས་པར་མི་བྱའོ།",
    "དེ་ནས་རིག་པ་འཛིན་པས་ཡུངས་ཀར་ལ་ལན་བདུན་བཟླས་ནས་བརྡེག་པར་བྱ་སྟེ་གནོན་པར་འགྱུར་རོ།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "ལྷའི་བུ་རྣམས་ཀྱང་མེ་ཏོག་རབ་ཏུ་འཐོར་བཞིན་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "འོག་ཏུ་སྒྲུབ་པ་པོ་ལག་ན་སྤོས་ཕོར་ཐོགས་པ་འདྲིར་གཞུག་པར་བྱ།",
    "ནས་ཟན་བཟའ་ཞིང་རས་རིས་ཀྱི་སྤྱན་སྔར་རིག་པ་བཟླས་པར་བྱའོ།",
    "སྦྱིན་སྲེག་དེ་རྫོགས་པ་ན་ལྦུ་བ་འབྱུང་སྟེ་ལག་པ་གཡས་པས་མནན་ནས་བརྒྱད་བརྒྱ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་དུ་བའི་སྒྲ་ཐོས་ཏེ་འཇིགས་པར་མི་བྱའོ།",
    "སྟོང་ཅིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "ཚེས་གྲངས་མེད་ཅིང་རྒྱུ་སྐར་མེད་སྨྱུང་བར་གནས་པ་མེད་དེ་བསྒྲུབ་པར་བྱའོ།",
    "རྒྱན་གྱིས་བརྒྱན་པར་བྱས་ནས་མགོ་བོ་ཤར་དུ་གཞག་པར་བྱའོ།",
    "ཇི་སྲིད་དུ་མི་རོའི་ཁ་གདངས་པར་འགྱུར་རོ།",
    "གླང་པོའི་རིག་པ་འཛིན་པ་ཐམས་ཅད་ཀྱི་བདག་པོར་ཐོགས་པ་མེད་པར་འགྱུར་ཏེ་ལོ་སྟོང་དྲུག་ཅུར་འཚོ་བར་འགྱུར་རོ།",
    "སླར་ཡང་རིག་པ་བཟླས་པར་བྱའོ།",
    "དེ་རྣམས་ཀྱིས་ལྷན་ཅིག་འཕུར་བར་བྱེད་དེ་སུམ་ཅུ་རྩ་གསུམ་དུ་རྣམ་པར་རྒྱུ་བར་འགྱུར་རོ།",
    "སེང་གེ་སྒྲུབ་པར་འདོད་ན་སྔར་བཞིན་དུ་རིག་པ་འཛིན་པས་འོ་མའི་ཟས་དང་།",
    "མི་སྨྲ་བའི་བརྟུལ་ཞུགས་ཀྱིས་རིག་པའི་སྤྱོད་པའི་རིག་པ་འབུམ་ཕྲག་ལྔ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་ཐོག་ཕོག་པའི་ཤིང་འོ་མར་ཞག་བདུན་གཞག་པར་བྱའོ།",
    "གཡོས་པ་ཙམ་ལའང་ས་འགུལ་ཏེ་ཡང་དག་པར་བཟླས་ལ་འཇིགས་པར་མི་བྱ་བར་སླར་ཡང་ལྷའི་རྔ་བོ་ཆེའི་སྒྲ་སྒྲོགས་ཀྱི་བར་དུ་རིག་པ་བཟླས་པར་བྱའོ།",
    "ཀུན་ཏུ་བསྣུན་པས་སེངྒེ་སེང་གེའི་སྒྲ་སྒྲོགས་པར་བྱེད་དེ་སྒྲུབ་པ་པོ་ཅན་གཞན་གྱིས་ངེས་པར་བསམ་པར་འགྱུར་རོ།",
    "དེ་ནས་རིག་པ་སླར་ཡང་བཟླས་པར་བྱ་ཞིང་སེངྒེ་ལ་ཞོན་ནས་འགྲོ་བར་བྱའོ།",
    "རིག་པ་འཛིན་པ་བྱེ་བས་ཡོངས་སུ་བསྐོར་ཞིང་བསྐལ་པར་གནས་སོ།",
    "རོའི་ཁ་གདངས་པར་འགྱུར་རོ།",
    "མགོ་ལ་བརྒྱན་པར་དཔག་ཚད་བརྒྱ་སྟོང་ཕྲག་བརྒྱད་ཅུར་ཀུན་ཏུ་སྣང་བར་བྱེད་དོ།",
    "འཇིག་རྟེན་སྐྱོང་བ་བཞིས་བཅོམ་ལྡན་འདས་མའི་ཆོ་ག་གསུངས་སོ།",
    "དེ་ནས་ལས་ཟད་པར་འགྱུར་རོ།",
    "ཀྱེ་ལོག་པར་འདྲེན་པ།",
    "ཁྲུས་བྱ་མལ་སྟན་གོས་བཅིང་བྱས།",
    "གསུངས་པའི་དེ་མ་ཐག་ཏུ་ཡང་ལོག་འདྲེན་ཐམས་ཅད་རྣམ་འཁྲུགས་པར།",
    "ལྟ་ངན་ཕྱོགས་བཞིན་འབྲོས་པར་བྱེད།",
    "དུས་གསུམ་མཉམ་པར་དམིགས་པ་ཡིས།",
    "གླགས་སྐབས་རྙེད་པར་མི་འགྱུར་རོ།",
    "ཀུན་ནས་འོད་འཕྲོ་བ་འདྲིར་གཞུག་པར་བྱའོ།",
    "ཕྱག་ན་རྡོ་རྗེའི་ཉེ་ལོགས་སུ་རྒྱལ་པོ་ཆེན་པོ་བཞི་མཚོན་ཆ་དང་བཅས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "བྲི་ཡང་ཀུ་སྔོ་བསངས་འདྲིར་གཞུག་པར་བྱའོ།",
    "ཇི་སྲིད་མ་ཧེའི་རྭ་གཡས་པ་ལ་འོད་ཟེར་འཕྲོ་བ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་གཏོར་མ་བྱ་སྟེ་དེ་ནས་སྒྲུབ་པ་པོས་ཀུ་ཤ་ལས་བྱུང་བའི་ཞགས་པ་བྱས་ནས་ལག་པ་གཡས་པས་མནན་ཏེ་ཇི་སྲིད་འབར་བར་གྱུར་པ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "སྲད་བུས་གདོན་སྐྲག་པར་བྱེད་དོ།",
    "ཡུངས་ཀར་ཁྲག་དང་བཅས་པ་ལ་བཟླས་པས་སྡང་བ་རྣམས་ཕྱིར་ཟློག་པར་བྱེད་དོ།",
    "མེ་ཏོག་བརྒྱ་པས་ཤ་ཟ་རྣམས་སྐྲག་པའི་ཡིད་ཀྱིས་འབྲོས་པར་བྱེད་དོ།",
    "ཁྱིམ་སྐྲོད་པར་བྱེད་དོ།",
    "ཕུབ་མས་རིག་པ་གཅོད་པར་བྱེད་དོ།",
    "འདིས་ཕ་རོལ་གྱི་རིག་པ་སྒྲུབ་པར་འགྱུར་རོ།",
    "གཙང་མས་གོས་གཙང་མ་བགོས་ཏེ་དུས་གསུམ་དུ་ཁྲུས་བྱས་ནས་གོས་ལན་གསུམ་དུ་བརྗེ་ཞིང་འོ་མ་དང་།",
    "བུམ་པ་གང་བ་བཞི་པོ་རྣམས་ལ་ཀླུའི་རྒྱལ་པོ་བཞི་འདྲིར་གཞུག་པར་བྱའོ།",
    "འབར་བར་བྱེད་པ་དེ་སྲིད་དུ་རིག་པ་བཟླས་པར་བྱའོ།",
    "ཐམས་ཅད་དབུགས་འབྱིན་པར་བྱེད་དོ།",
    "མར་གྱིས་བཏགས་པའི་སྦྱིན་སྲེག་འབུམ་བྱས་ན་ཀླུ་རྣམས་ལང་ངོ།",
    "དེའི་སྟེང་དུ་འཁོར་ལོ་གཞག་པར་བྱའོ།",
    "སྒྲུབ་པ་པོ་ལ་བསྐོར་བ་བྱས་ནས་དེ་ཉིད་ཀྱི་སྤྱི་བོར་ནུབ་པར་འགྱུར་རོ།",
    "ཉི་མ་འཆར་ཀའི་འོད་དང་མཚུངས་པ་ཀླུའི་རིག་པ་འཛིན་པ་ཐམས་ཅད་ཀྱང་དཔག་ཚད་སྟོང་དུ་འབྲོས་པར་བྱེད་དོ།",
    "སའི་ཆ་དྲུག་འཕྲོག་པར་འགྱུར་རོ།",
    "འབྱུང་པོ་ཐམས་ཅད་པའི་གཏོར་མའང་བྱས་ནས་དེ་ནས་སྒྲུབ་པ་པོས་ཐོད་པ་ལག་པ་གཡོན་པས་བླངས་ཏེ་ལག་པ་གཡས་པས་མནན་ནས་ཇི་སྲིད་ཅ་ཅོའི་སྒྲ་སྒྲོགས་པ་དེ་སྲིད་དུ་རིག་པ་བཟླས་པར་བྱའོ།",
    "འདིའི་ཚངས་པར་སྦྱད་པས་འདོད་པ་རྣམས་ལ་སེམས་བསྐྱེད་ན་དེ་གཅིག་པུ་འཇིག་རྟེན་གྱི་ཁམས་སུ་འགྲོ་ཞིང་བསྐལ་བ་ཆེན་པོར་གནས་སོ།",
    "ཡིད་ཀྱིས་སྐྱེ་བ་འཛིན་པར་བྱེད་དོ།",
    "གཙང་མས་གོས་གཙང་མ་བགོས་ཏེ་དུར་ཁྲོད་དུ་ཟླ་བ་དྲུག་རིག་པ་བཟླས་ན་མི་སྣང་བར་འགྱུར་རོ།",
    "པདྨ་གེ་སར་མཉམ་པར་འགྲོ་བའི་རྫས་མཉམ་པར་བྱས་ཏེ་ལྕགས་གསུམ་གྱིས་དཀྲི་བར་བྱའོ།",
    "དུར་ཁྲོད་དུ་གཟུགས་བརྙན་བྱས་ནས་རྐང་པ་ལ་ཕུར་བུས་གདབ་པར་བྱའོ།",
    "དེ་ནས་རིག་པ་བཟླས་པར་བྱའོ།",
    "མར་གྱིས་བཏགས་པའི་སྦྱིན་སྲེག་འབུམ་བྱས་ན་ངེས་པར་མཐོང་ངོ།",
    "དུར་ཁྲོད་དུ་བོཊྚ་ཀའི་སྦྱིན་སྲེག་བྱས་ནའང་ཤ་ཟ་མི་འོང་ངོ།",
    "སྦྲུལ་གྱི་ཤུན་པའི་སྦྱིན་སྲེག་བྱས་ན་སྦྲུལ་རྣམས་འབྲོས་པར་བྱེད་དོ།",
    "རྣམ་པར་འགྱུར་བའི་གཟུགས་ཅན་གྱི་གནོད་སྦྱིན་མ་འོང་བར་འགྱུར་ཏེ་འཇིགས་པར་མི་བྱ་བར་རིག་པ་དྲན་པས་སྟོད་ཅིག།",
    "གལ་ཏེ་གཞོན་ནུ་མདུང་ཐུང་ཐོགས་པ་མཐོང་ན་དེའི་ཚེ་དྲི་ཟས་རྫས་ཉམས་པར་བྱས་པའོ།",
    "སྦྱིན་སྲེག་ཡོངས་སུ་རྫོགས་པ་ན་རྫས་ལག་ཏུ་ཕྱིན་པར་འགྱུར་རོ།",
    "སྦྱིན་སྲེག་ཡོངས་སུ་རྫོགས་པ་ན་རྫས་ལག་ཏུ་ཕྱིན་པར་འགྱུར་རོ།",
    "གཏོར་མའང་ཇི་ལྟར་འབྱོར་པ་བྱ་སྟེ་ཀ་ར་བཱི་རའི་མེ་ཏོག་ལ་སོགས་པའི་མར་གྱིས་བཏགས་པའི་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱད་བྱས་ན་རྫས་ལག་ཏུ་ཕྱིན་པར་འགྱུར་རོ།",
    "ཡི་དྭགས་རྣམས་ལ་ནཱིར་མ་ལའི་སྦྱིན་སྲེག་སྟོང་ཕྲག་བརྒྱད་བྱས་ན་རྫས་ལག་ཏུ་ཕྱིན་པར་འགྱུར་རོ།",
    "ཤ་ཟ་ཐམས་ཅད་ཀྱིས་གསུངས་པའི་མཚན་ཉིད་ཀྱི་ལེའུ་བཅུ་པ་རྫོགས་སོ།",
    "གཅོད་པར་བྱེད་ཆུ་གྲི་དང་གསུམ་གྱིས་མཆེ་བ་འཇུག་པར་བྱེད་དོ།",
    "གུ་གུལ་གྱི་བདུག་པས་གནས་ནས་སྐྲོད་པར་བྱེད་དོ།",
    "འདི་རྣམས་མ་བསྒྲུབས་པར་ཡང་བྱེད་དོ།",
    "བདུག་པ་གང་ལ་སྦྱིན་པར་བྱ་སྟེ་རིག་པ་ཐམས་ཅད་འགུགས་པ་དང་།",
    "དེས་འདིའི་ལས་བྱ་སྟེ་གུར་གུམ་གྱིས་ཆུས་རྨོངས་པར་བྱེད་དོ།",
    "མེ་ཏོག་བཟང་པོ་རྣམས་ཀྱིས་འབྱིན་པར་བྱེད་དོ།",
    "དེས་སྒྲུབ་པ་པོ་དེའི་སྒྲུབ་པ་ཆེན་པོ་སྒྲུབ་པར་བྱེད་དོ།",
    "མིང་ནས་སྨོས་ནས་སྒྲུབ་པར་འགྱུར་ཏེ་རབ་ཏུ་སྦྱར་བར་བྱའོ།",
    "དོགས་པ་མེད་པར་རབ་ཏུ་འཇུག་པར་བྱ་སྟེ་ལྷ་མ་ཡིན་སེལ་བཞེས་བྱ་བའི་རིག་པ་དྲན་བཞིན་པས་རབ་ཏུ་བླང་བར་བྱའོ།",
    "དེ་ནས་རྣམ་པ་གཞན་ནི་བཅོམ་ལྡན་འདས་མའི་སྔགས་འདི་རྣམས་ཐམས་ཅད་བགགས་པར་བྱེད་པ་ནི་ཡུངས་ཀར་གྱིས་སོ།",
    "བར་སྐབས་འདི་གསུངས་པར་གྱུར་པ་དེ་གང་ཞེ་ན།",
    "དོན་མེད་བ་ཐམས་ཅད་ཟློག་པར་བྱེད་པ།",
    "ལས་ཀྱི་སྒྲིབ་པ་རྣམ་པར་དག་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་མའི་རྟོག་པའི་རྒྱལ་པོར་ཞི་བ་ཅན་གྱིས་ལས་ཐམས་ཅད་འགྲུབ་པར་བྱེད་དོ།",
    "ཉེ་བར་གནོད་པ་མེད་པར་དྲན་པར་འགྱུར་ཞིང་སྟོབས་དང་ལྡན་པ་དང་།",
    "ལྷ་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབས་པར་འགྱུར་རོ།",
    "མངོན་སྤྱོད་ཅན་ལ་སྡིགས་མཛུབ་ལ་བཟླས་པ་ཉིད་ཀྱིས་དེ་བརྩམས་པར་བྱའོ།",
    "དེའི་དངོས་གྲུབ་ངེས་པར་བརྗོད་དོ།",
    "གཞན་དུའང་རུང་སྟེ་གཙང་མའི་ཕྱོགས་སུ་གཟུགས་བརྙན་གྱི་སྤྱན་སྔར་འོ་མ་དང་།",
    "གསོ་སྦྱོང་ལ་མི་གནས་པར་ཡང་རུང་སྟེ་འབུམ་ཕྲག་ཕྱེད་དང་གསུམ་བཟླས་པར་བྱའོ།",
    "སྔོན་སྤྱད་པ་བྱས་པར་འགྱུར་རོ།",
    "མེ་ཏོག་སྟོང་ཕྲག་བརྒྱད་པོ་རྣམས་ཀྱིས་གཟུགས་བརྙན་ལ་བསྣུན་པར་བྱའོ།",
    "མྱོས་བྱེད་ཀྱི་ཤིང་ལ་གཟུགས་བརྙན་བྱས་ནས་རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "ནས་ཟན་བཟའ་ཞིང་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "ལེགས་པར་འོངས་སམ་ཞེས་བརྗོད་པར་བྱ་ཞིང་མཆོག་སྦྱིན་པར་བྱའོ་ཞེས་ཟེར་ན་ཆུང་མའམ།",
    "ཟླ་བ་གཟའ་ཡིས་ཟིན་པ་ན་རྒྱུད་མཚུངས་པའི་བའི་མར་སར་བླངས་ནས་སོར་དྲུག་པའི་གཟུགས་བརྙན་བྱས་ཏེ་ཟས་བཞིན་དང་།",
    "སྨྱུང་བར་གནས་པས་ཨ་ཤྭཏྠའི་འདབ་མར་བཞག་ནས་ཇི་སྲིད་ཟླ་བ་གྲོལ་གྱི་བར་བཟླས་པར་བྱའོ།",
    "དེ་མཆོག་སྦྱིན་པར་བྱེད་དེ་མའམ།",
    "ལྟེ་བ་ཙམ་གྱི་ཆུར་ཞུགས་ནས་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "འཁྲུལ་འཁོར་ཐམས་ཅད་འགེམས་པར་བྱེད་དོ།",
    "མིའང་འགུགས་པར་བྱེད་དོ།",
    "ཤི་བ་སོགས་པར་བྱེད་དོ།",
    "དུག་མེད་པར་བྱེད་དོ།",
    "འགུགས་པར་བྱེད་དོ།",
    "རྒྱལ་པོའི་སྒོར་སྲུང་བ་བྱས་ན་དགྲ་རྣམས་ལ་མཚམས་བཅད་བར་འགྱུར་རོ།",
    "རིང་བསྲེལ་དང་བཅས་པའི་མཆོད་རྟེན་གྱི་དྲུང་དུ་འབུམ་ཕྲག་དྲུག་བཟླས་པར་བྱའོ།",
    "རས་དཀར་པོས་བགོ་བ་བྱས་ནས་ཇི་སྲིད་དུ་འབར་བ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "འཁོར་སྟོང་དང་བཅས་པར་འཕུར་བར་འགྱུར་རོ།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་བ།",
    "བར་མ་ལ་སླར་ཡང་མཆོད་རྟེན་བྱས་ནས་ཉི་མ་ནུབ་པ་ནས་ཇི་སྲིད་སྟོང་ཕྲག་བརྒྱད་དེ་སྲིད་དུ་བཟླས་སོ།",
    "བསྐལ་བར་གནས་པར་འགྱུར་རོ།",
    "ཤུ་དག་ཁར་བཅུག་ནས་ཇི་སྲིད་དངོས་གྲུབ་རྣམ་པ་གསུམ་དུ་གྱུར་གྱི་བར་དུ་བཟླས་པར་བྱའོ།",
    "དེ་ནས་ཟ་མ་ཏོག་དཀར་པོ་ཡི་གེས་དཀྲིས་པ་ལྡོང་རོས་བཅུག་ནས་ཇི་སྲིད་དངོས་གྲུབ་རྣམ་པ་གསུམ་དུ་གྱུར་པ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "དྲོ་བཞིན་པ་ལ་ཡིད་གཞུངས་པར་འགྱུར་རོ།",
    "སྐྱེས་པ་རྣམ་པར་ལྡང་བར་འགྱུར་རོ།",
    "སེང་ལྡེང་ལ་ཕུར་བུ་སོར་བཞི་བའི་ཚད་བྱས་ནས་ཕྱོགས་བཞིར་གདབ་པར་བྱས་ཏེ་མཚམས་བཅིངས་པ་བྱས་པར་འགྱུར་རོ།",
    "ཁྲོས་པའི་མདུན་ཡོངས་སུ་བཟླས་ན་རབ་ཏུ་ཞུམ་པར་འགྱུར་རོ།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པ།",
    "གཟུགས་བརྙན་གྱི་སྤྱན་སྔར་རས་རིས་བཞུགས་སུ་གསོལ་ནས་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "ནོར་སྦྱིན་པར་བྱེད་དོ།",
    "ཆོ་འཕྲུལ་གྱི་ཕྱོགས་ནས་བརྩམས་ནས་གསོ་སྦྱོང་ཅན་གྱི་དུས་གསུམ་དུ་ཁྲུས་བྱ་ཞིང་གོས་ལན་གསུམ་དུ་བརྗེས་ལ་འབུམ་བཟླས་པར་བྱའོ།",
    "བསྙམས་པའི་རས་ལ་ལྷ་འདྲིར་གཞུག་པར་བྱ་སྟེ་སྟོན་ཀའི་སྤྲིན་ལྟར་དཀར་བ།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པ།"
  ]
}