    "རྒྱལ་སྲིད་ཆེན་པོ་རྙེད་དེ་དོན་ཆེན་པོ་ཡང་དག་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་མ་འཕགས་མ་སྒྲོལ་མ་རལ་པ་གྱེན་བརྫེས་ཀྱི་རྩ་བའི་རྟོག་པ་ཡངས་པ་དང་ལྡན་པའི་ཏིང་ངེ་འཛིན་ལས་ངེས་པར་སྐྱེས་པ་ཡི་གེ་བཅུ་པ་ཞེས་བྱ་བའི་རིག་པའི་རྒྱལ་པོ་ཆེན་པོ་ཡོངས་སུ་རྫོགས་སོ།",
    "གླགས་ཚོལ་བ་ཐམས་ཅད་ལས་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ།",
    "པདྨ་ལ་བཞུགས་པ།",
    "ཉིན་ཞག་བཅུ་གཉིས་ཀྱི་ནང་དེར་འདྲིར་གཞུག་པར་བྱའོ།",
    "རྣམ་པ་དེ་ལྟ་བུའི་རས་རིས་འདྲིར་བཅུག་ནས་མཆོད་རྟེན་གྱི་དྲུང་དུ་རས་རིས་བཞུགས་སུ་གསོལ་ཏེ་དེ་ལ་འདི་ཉིད་ཀྱིས་ཐམས་ཅད་བྱས་ལ་འབུམ་ཕྲག་ལྔ་བཟླས་པར་བྱའོ།",
    "གལ་ཏེ་སྒྲུབ་པ་བྱེད་པར་འདོད་ན་ཐོས་པ་འཛིན་པ་ཉིད་དམ།",
    "བཅོམ་ལྡན་འདས་མ་རྟོག་པའི་རྒྱལ་པོ་ཆེན་པོར་འོད་དང་ལྡན་པའི་མཚན་ཉིད་ཞེས་བྱ་བའི་རིག་པའི་རྒྱལ་པོ་ཆེན་པོ་འདི་གསུངས་སོ།",
    "ཟ་ན་ཟ་བས་འདི་ཉིད་ཀྱིས་ཐམས་ཅད་བྱས་ལ་འབུམ་བཟླ་བར་བྱ་སྟེ་སྔོན་དུ་བསྙེན་པ་བྱས་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་མ་འཕགས་མ་སྒྲོལ་མ་རལ་པ་གྱེན་བརྫེས་ཀྱི་རྩ་བའི་རྟོག་པ་ཡངས་པ་དང་ལྡན་པའི་ཏིང་ངེ་འཛིན་ལས་ངེས་པར་སྐྱེས་པ་འོད་ཟེར་དང་ལྡན་པ་ཞེས་བྱ་བའི་རྟོག་པའི་རྒྱལ་པོ་ཆེན་པོ་རྫོགས་སོ།",
    "གང་ཡང་ཉིན་མཚན་གསུམ་དུ་འདི་བྱས་ནས་དེ་ཡུན་རིང་པོ་ནས་མཚམས་མེད་པ་ལྔ་བྱས་པ་ཐམས་ཅད་ཡོངས་སུ་སྐྱོང་བར་འགྱུར་རོ།",
    "བདུག་པ་ལ་སོགས་པ་ཕུལ་ནས་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "ལེགས་སོ་ཞེས་བྱ་བའི་ཚིག་ཐོས་པར་འགྱུར་རོ།",
    "དེ་ནས་རལ་གྲི་འབར་བར་འགྱུར་ཏེ་སྐད་ཅིག་དེ་ཉིད་ལ་ལྷའི་ལུས་འཁོར་དང་བཅས་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་མ་འཕགས་མ་སྒྲོལ་མ་རལ་པ་གྱེན་བརྫེས་ཀྱི་རྩ་བའི་རྟོག་པ་ཡངས་པ་དང་ལྡན་པའི་ཏིང་ངེ་འཛིན་གྱི་རྒྱལ་པོ་ལས་ངེས་པར་སྐྱེས་པ་པདྨ་ཀུན་ཏུ་སྣང་བ་ཞེས་བྱ་བའི་རིག་པའི་རྒྱལ་པོ་ཆེན་པོ་ཡོངས་སུ་རྫོགས་སོ།",
    "འདི་ནི་མཐུ་ཆེན་པོ་ཐོབ་པ་དཔེ་བྱད་བརྒྱད་ཅུའི་རྗེས་སུ་བྱེད་པ་ཞེས་བྱ་བའི་རིག་པའི་རྒྱལ་པོ་ཆེན་པོ་སྒྲོལ་མའི་རྟོག་པ་དོན་ཆེན་པོ་སྦྱིན་པ་སྟེ་གང་ལ་ལ་འདི་དྲན་པར་བྱེད་པ་དེའི་དོན་ཐམས་ཅད་གྲུབ་པར་འགྱུར་རོ།",
    "དེ་ནས་འབར་ན་གྲུབ་པར་འགྱུར་ཏེ་དེ་ནས་ལས་ཐམས་ཅད་དུ་འགྱུར་རོ།",
    "ཉི་མ་བདུན་ཐུན་གསུམ་དུ་བྱས་ནས་དགའ་བར་འགྱུར་རོ།",
    "འཇིགས་པ་ལ་དམ་ཚིག་ལ་གནས་ཏེ་བཟླས་པ་བྱས་ན་འཇིགས་པ་མེད་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་མ་འཕགས་མ་སྒྲོལ་མ་རལ་པ་གྱེན་བརྫེས་ཀྱི་རྩ་བའི་རྟོག་པ་ཡངས་པ་དང་ལྡན་པའི་ཏིང་ངེ་འཛིན་ལས་ངེས་པར་སྐྱེས་པ་དཔེ་བྱད་བརྒྱད་ཅུའི་རྗེས་སུ་བྱེད་པ་ཞེས་བྱ་བའི་རིག་པའི་རྒྱལ་པོ་རྫོགས་སོ།",
    "གང་རིག་པའི་རྒྱལ་པོ་ཡོན་ཏན་རྒྱན་འདི་རྟག་ཏུ་དྲན་པར་འགྱུར་བ་དེ་དུས་རིང་པོར་མི་ཐོགས་པར་ལས་ཐམས་ཅད་བྱེད་པར་འགྱུར་རོ།",
    "རིང་བསྲེལ་དང་བཅས་པའི་མཆོད་རྟེན་དུ་རས་རིས་དེ་བཞུགས་སུ་གསོལ་ནས་ཚེས་གྲངས་དང་།",
    "བཅོམ་ལྡན་འདས་མ་འཕགས་མ་སྒྲོལ་མ་རལ་པ་གྱེན་བརྫེས་ཀྱི་རྩ་བའི་རྟོག་པ་ཡངས་པ་དང་ལྡན་པའི་ཏིང་ངེ་འཛིན་གྱི་རྒྱལ་པོ་ལས་ངེས་པར་སྐྱེས་པ་ཡོན་ཏན་གྱི་རྒྱན་ཞེས་བྱ་བའི་རིག་པའི་རྒྱལ་པོ་ཆེན་པོ་ཡོངས་སུ་རྫོགས་སོ།",
    "རྒྱན་ཐམས་ཅད་ཀྱིས་རྣམ་པར་བརྒྱན་པའོ།",
    "སྔོན་དུ་བསྙེན་པ་བྱས་པར་འགྱུར་རོ།",
    "ལས་ཐམས་ཅད་ཀྱི་དངོས་སྒྲུབ་ནི་འདི་ཉིད་ཀྱི་ཆོ་གས་འབུམ་བཟླས་པར་བྱའོ།",
    "རས་རིས་ཀྱི་སྤྱན་སྔར་ཨ་ག་རུ་ནག་པོ་འབུམ་ཕྲག་གསུམ་སྦྱིན་སྲེག་བྱས་ན་རྒྱལ་སྲིད་རྙེད་དོ།",
    "དེའི་སྤྱན་སྔར་ཐུན་གསུམ་དུ་མར་གྱིས་བཏགས་པའི་ཙནྡན་དམར་པོའི་སྦྱིན་སྲེག་འབུམ་བྱས་ན་གསེར་བརྒྱ་རྙེད་དོ།",
    "འབུམ་ཕྲག་བདུན་སྦྱིན་སྲེག་བྱས་ན་རྒྱལ་སྲིད་རྙེད་དོ།",
    "དེའི་སྤྱན་སྔར་མར་དང་སྦྲང་རྩིས་བཏགས་པའི་མེ་ཏོག་དམར་པོའི་སྦྱིན་སྲེག་འབུམ་བྱས་ན་པདྨ་རཱ་ག་བརྒྱད་རྙེད་དོ།",
    "འདི་ནི་དངུལ་སྦྱིན་པར་འགྱུར་ཏེ།",
    "སྦྲང་རྩི་མར་གྱིས་བཏགས་པའི་ནཱ་ག་གེ་སར་གྱི་སྦྱིན་སྲེག་འབུམ་བྱས་ན་དངུལ་བརྒྱ་རྙེད་པར་འགྱུར་རོ།",
    "པདྨའི་གདན་ལ་བཞུགས་པ་འདྲིར་གཞུག་པར་བྱའོ།",
    "གཡས་པར་མི་འཇིགས་པ་སྦྱིན་པའོ།",
    "རྣམ་པ་ཇི་ལྟ་བ་བཞིན་འདྲིར་གཞུག་པར་བྱའོ།",
    "དེ་ནས་རས་རིས་དེ་སྔར་བརྗོད་པའི་གནས་སུ་བཞུགས་ནས་དྲི་དང་།",
    "བདུག་པ་ལ་སོགས་པའི་དེ་ཉིད་ཀྱིས་ཕུལ་ལ་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "སྔོན་དུ་བསྙེན་པ་བྱས་པར་འགྱུར་རོ།",
    "མཚམས་མེད་པ་ལྔ་པོ་རྣམས་རྣམ་པར་སྦྱོད་བར་བྱེད་དོ།",
    "འབུམ་ཕྲག་དྲུག་བཟླས་པས་དམ་བཅས་པ་རྙེད་པར་འགྱུར་རོ།",
    "གདུག་པ་ཐམས་ཅད་བཅིངས་པར་འགྱུར་རོ།",
    "བ་ལི་ཀ་བསྲེས་པས་འདྲིར་གཞུག་སྟེ་པདྨའི་གདན་ལ་བཞུགས་པ།",
    "རས་རིས་དང་པོའི་གནས་སུ་བཞག་ནས་འབུམ་ཕྲག་ལྔ་བཟླས་པར་བྱའོ།",
    "སྔོན་དུ་བསྙེན་པ་བྱས་པར་འགྱུར་རོ།",
    "དེའི་སྤྱན་སྔར་ཙནྡན་དཀར་པོའི་ཞོགས་མ་དང་བཅས་པ་འབུམ་ཕྲག་གསུམ་སྦྱིན་སྲེག་བྱས་ན་རྒྱལ་སྲིད་རྙེད་དོ།",
    "ཡང་འདིའི་ཆོ་ག་ནི་སྔར་བརྗོད་པའི་རས་རིས་ལ་འོད་དཔག་མེད་འདྲིར་གཞུག་པར་བྱ་སྟེ།",
    "པདྨའི་གདན་ལ་བཞུགས་པ།",
    "དེ་ལྟ་བུའི་རས་རིས་འདྲིར་བཅུག་ནས་གཙང་མའི་ཕྱོགས་སུ་པ་ཊའི་ཤིང་ལ་སོ་སོ་སོ་སོར་བཞག་ནས་འདི་ཉིད་ཀྱིས་དྲི་དང་།",
    "མེ་ཏོག་ལ་སོགས་པ་ཕུལ་ལ་འབུམ་ཕྲག་བདུན་བཟླས་པར་བྱའོ།",
    "སྔོན་དུ་བསྙེན་པ་བྱས་པར་འགྱུར་རོ།",
    "དངོས་གྲུབ་ཀྱི་མཚན་མ་ནི་པདྨ་སྟོང་རྩ་བརྒྱད་པོ་དེ་རྣམས་གཅིག་ཏུ་གནས་པར་འགྱུར་ཏེ་འདི་ནི་དངོས་གྲུབ་ཀྱི་མཚན་མའོ།",
    "འདི་དག་ཕྱེ་མར་བྱས་ནས་གཞན་ཤ་ལ་དང་བསྲེས་ཏེ་རྒྱལ་པོའམ།",
    "མེ་ཏོག་བརྒྱ་པ་སྟེ་འདི་རྣམས་ཆ་མཉམ་པར་སྦྱར་ནས་ཕྱེ་མར་བྱེད་དུ་གཞུག་གོ།",
    "ཏིལ་གྱི་སྦྱིན་སྲེག་འབུམ་ཕྲག་གཅིག་བྱས་ན་གྲོང་གཅིག་རྙེད་དོ།",
