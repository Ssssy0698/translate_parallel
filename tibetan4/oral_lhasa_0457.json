    "འཕགས་པ་མ་ཕམ་ཡང་དག་དམ་པ་ལགས།",
    "ཏུན་ཧོང་གཏེར་ཡིག་སོགས་ནང་ཐོན་པའི་ཡི་གེའི་འབྲི་སྲོལ་སོགས་དང་བསྡུར་བ་བྱས་ཚེ།",
    "ལེགས་ངག་མཆོག་ནི་རྩོམ་པར་གསུངས།",
    "ལེའུ་དང་ས་བཅད་ཀྱི་རྣམ་པ་གཏན་ཆགས་ཅན་ཞིག་ཡིན་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "དེའི་ཡར་སྔོན་ལ་ཕལ་ཆེར་སྙན་ངག་ཅེས་པའི་ཐ་སྙད་དེས་འཐུས་པར་བྱེད།",
    "ལྷག་པར་དུ་མི་སྣའི་སེམས་ཁམས་གསལ་མཚོན་དང་།",
    "ཡང་ན་ཡུལ་ལྗོངས་འབྲི་བ་སོགས་ཅི་བྱས་རུང་རྟག་ཏུ་རྩོམ་མཁན་གྱིས་འཚོ་བའི་ནང་ནས་ཚོར་སྣང་ཐུབ་པའི་རྒྱུ་ཆ་འཚོལ་བསྡུ་བྱས་ནས་མི་སྣའི་སེམས་ཁམས་དང་གཤིས་ཀབྱ་སྤྱོད་སོགས་དངོས་སུ་མཐོང་བ་ལྟ་བུ་ཞིག་བཟོ་སྐྲུན་བྱེད་ཀྱི་ཡོད།",
    "རང་གཤིས་ཅན་བཅས་ལ་དང་དོད་བྱེད་པ་མ་ཟད་ད་དུང་ཚིག་རྒྱན་གྱིས་མཛེས་པར་སྤུད་པའང་ཡིན་ནོ།",
    "རྩོམ་པ་པོས་གསར་རྩོམ་བྱེད་པའི་སྐབས་བྱ་བ་བཟང་པོའམ་ངན་པ་གང་རུང་ཞིག་ཁོ་ན་འབྲི་བ་མ་ཡིན་པར།",
    "དེའང་ལུའུ་ཤུན་གྱིས་གསུངས་པ་ལྟར་ཏེ།",
    "དེས་ངེས་པར་དུ་མི་རྣམས་ཡིད་རྟོན་རུང་བ་དང་ཀློག་པ་པོར་བདེན་སྣང་སྟེར་ཐུབ་པ་ཞིག་དགོས།",
    "སྤྱིར་བྱ་བ་གང་ཞིག་བྱས་ཀྱང་ངེས་ཅན་གྱི་དམིགས་ཡུལ་ཡོད་པ་སྨོས་མི་དགོས་ཀྱང་།",
    "གང་ལྟར་བེད་སྤྱོད་དུ་ལོ་བ་མཐའ་དག་བེད་སྤྱོད་གཏོང་བ་ཙམ་མ་ཟད་ཐ་ན་ཡི་གེར་བཀོད་སྲོལ་མེད་པའང་བེད་སྤྱོད་བྱེད་ཀྱི་ཡོད་ཅེས་གསུངས།",
    "རྩོམ་འབྲིའི་ནུས་པ་བསྐྱེད་སྲིང་བྱེད་པར་མཚོན་ནའང་།",
    "རང་ཉིད་དངོས་སུ་རྩོམ་གྱི་ལག་ལེན་ནང་ཞུགས་ནས་སྦྱངས་པ་མ་བྱས་ན།",
    "འཇུ་ཐུབ་པ་བཅས་བྱས་ན་གཞི་ནས་ཤེས་བྱ་ནུས་རྩལ་ལ་འགྱུར་ནས་རང་ལག་ཆ་ཞིག་ཏུ་འགྱུར་ཐུབ་པར་ངེས།",
    "ཅེས་གསུངས་པ་ལྟར་གསར་རྩོམ་གྱི་བརྒྱུད་རིམ་ལ་འགྱུར་བ་གཉིས་ལྡན་དགོས་པ་ཞིག་ཡིན་པ་སྟེ།",
    "ཕྱི་རོལ་གྱི་ཡུལ་དངོས་ནས་འདུ་ཤེས་སུ་འགྱུར་བའི་བརྒྱུད་རིམ་དང་པོའི་ནང་རྩོམ་འབྲིའི་ངོས་འཛིན་དང་ལས་སྣོན་གྱི་པར་ལེན་ལས་ཀའི་བརྒྱུད་རིམ་ལས་ཁ་བྲལ་དུ་མེད་ཅིང་།",
    "འཚོ་བའི་པར་ལེན་ཞེས་པ་ནི་འཚོ་བ་པར་བརྒྱབ་པ་ལྟར་བློ་རུ་འཛིན་པ་དང་གསར་སྐྲུན་གྱི་ནུས་པ་བེད་སྤྱོད་བྱས་པ་ཞིག་ཡིན།",
    "དཔེ་དེབ་ནི་མིའི་རིགས་ཡར་ཐོན་འགྲོ་བའི་སྐས་རིམ་ཡིན་ཞེས་གསུངས།",
    "ཅིང་ལི་ཞིག་གདན་ཞུ་བྱེད་པར་རྩོམ་འབྲིའི་ཡིག་རྒྱུགས་ལེན་པ་མ་ཟད།",
    "བར་དུ་གཞུང་ལུགས་ཐམས་ཅད་གདམས་པར་ཤར།",
    "རྩོམ་པ་པོ་ཞིག་བྱེད་འདོད་ན་ངེས་པར་དུ་ལག་ལེན་ལ་ཞུགས་དགོས་པའི་གལ་ཆེའི་གནས་སྟན་པ་དང་།",
    "ཞེས་གསུངས་མྱོང་ལ།",
    "ཅེས་གསུངས།",
    "འདི་ཉིད་ཁོ་ནར་ནན་ཏན་བྱས།",
    "ས་བཟང་མ་ཏི་པཎ་ཆེན་གྱི་གསུངས་ལས།",
    "ཀུན་ལ་ཞིབ་ཏུ་སྦྱངས་བྱས་ན།",
    "དེ་འདྲའི་བརྡ་སྤྲོད་ཀྱི་གཞུང་དང་མཐུན་པར་སྦྱར་བའི་ངག་དེ་ལ་སྙན་པའི་ཉམས་དང་ལྡན་པས་ན་སྙན་ངག་དང་།",
    "ཤེས་བྱ་དག་ནུས་པར་བསྒྱུར་དགོས་ན་ངེས་པར་དུ་འབྲི་སྦྱོང་ལ་ཤུགས་སྣོན་རྒྱག་དགོས།",
    "བསམ་གཞིགས་མེད་པ་དང་དོན་ལ་གོ་བ་མ་རྙེད་པར་ནེ་ཙོའི་འདོན་པ་ཇི་བཞིན་ཀློག་ན་དོན་ལ་སྒྲོ་འདོགས་མི་ཆོད་པས།",
    "ཞེས་གསུངས་པ་ལྟར་རོ།",
    "དེའང་རྩོམ་འབྲིའི་ནུས་པར་གོམས་འདྲིས་བྱེད་པ་ནི་ངང་རྒྱུད་རིང་བའི་བྱ་ལས་ཤིག་ཡིན་ཞིང་།",
    "༥ ཁྱེད་ཀྱིས་ཇི་ལྟར་བྱས་ནས་རྩོམ་འབྲིའི་ནུས་པ་གོང་མཐོར་གཏོང་ངམ།",
    "དམིགས་བྱ་སོགས་གང་ཞིག་བརྩམས་པར་བྱ་བའི་གཞི་དང་མཚོནཔར་བྱ་བའི་གཞི།",
    "ཤེས་པར་བྱ་བའི་གཞི།",
    "མིའི་རིགས་ཀྱི་ཤེས་བྱ་ནི་རྒྱུན་གཏན་ཡིན་པ་མ་ཟད་ད་དུང་རིགས་དང་རིམ་པ་སོ་སོར་ཕྱེ་ཡོད་པས་རྩོམ་གྱི་རྒྱུ་ཆ་ལའང་མི་རབས་སྔ་མའམ་སྔོན་བྱོན་མཁས་པའི་གྲུབ་འབྲས་གཞིར་བྱས་པའི་ཐོག་རིགས་དང་རིམ་པ་སོ་སོར་ཕྱེ་ཡོད།",
    "དེས་ན་རྒྱུ་ཆ་དངོས་དང་གདོད་མའི་རྒྱུ་ཆ་གཉིས་ཀྱི་ཁྱད་པར་ནི།",
    "མཛེས་དཔྱོད་ཀྱི་ཕུགས་འདུན་ངེས་ཅན་ལ་བརྟེན་ནས་མཚོན་པར་བྱེད་སྟབས།",
    "ཕྱི་ཡུལ་ཁོ་ནའང་མ་ཡིན་པར་ཡུལ་དང་ཡུལ་ཅན་གཉིས་ཀ་ཕན་ཚུན་ལྷུན་གྲུབ་ཀྱི་འབྲེལ་བ་ཡིན།",
    "ཧྥུའུ་ལུ་པེས་ཁོ་ལ་གདམས་ངག་ཅིག་གནང་བ་འདི་ལྟར་ཏེ།",
    "དེར་ངེས་པར་དུ་རྒྱུན་རིང་དང་ཞིབ་ཚགས།",
    "མདུན་ལམ་ཡོད་པའི་རྩོམ་རིག་མཁས་པ་དང་སྒྱུ་རྩལ་མཁས་པ་ཞིག་ཡིན་ན་ངེས་པར་དུ་དུས་ཡུན་རིང་པོར་ཆ་རྐྱེན་གང་ཡང་མི་སྟོན་པར་བློ་སེམས་གཅིག་སྒྲིལ་གྱིས་བཟོ་ཞིང་དམག་དམངས་ཁྲོད་དུ་ཕྱིན་ནས་མི་ཐམས་ཅད་དང་གྲལ་རིམ་ཐམས་ཅད།",
    "ཞིབ་འཇུག་དབྱེ་ཞིབ་བཅས་བྱས་པའི་རྗེས་གཞི་ནས་གསར་རྩོམ་གྱི་བརྒྱུད་རིམ་ལ་འགྲོ་ཆོག་ཅེས་པའི་བཀའ་སློབ་ཀྱིས་གོ་ནུས་སོ།",
    "ངེས་པར་དུ་བྱ་དངོས་མང་པོ་ཞིག་མི་བརྗེད་པའི་ཐབས་སུ་རྩིས་འཁོར་ནང་དུ་གསོག་འཇོག་བྱེད་པ་དང་བརྗེད་ཐོར་ཟིན་བྲིས་སུ་བཀོད་པ།",
    "བློར་གང་ཐུབ་ཀྱིས་བསྐྱར་དྲན་སླར་གསོའི་ཐབས་སྤྱད་དེ་རྒྱུ་ཆའི་མཛོད་ཁང་ཞིག་ཆགས་པར་འབད་དགོས།",
    "འདུས་བྱས་ཐམས་ཅད་མི་རྟག་པ།",
    "དེ་བཞིན་དུ་ཕུན་ཚོགས་བཀྲ་ཤིས་ཀྱིས་བརྩམས་པའི་སྒོ་རས་སྤ་རའི་སྐྱོ་གླུ་ལྷང་ལྷང་ཞེས་པའི་བརྩམས་སྒྲུང་ནང་པཱ་ལྷག་དོན་ལགས་ཀྱང་སྐབས་དེའི་ཚབ་མཚོན་རང་བཞིན་ལྡན་པའི་མི་སྣ་ཞིག་སྟེ།",
    "མི་ཚེའི་ལྟ་ཚུལ་སོགས་བྲིས་གནང་ཡོད་དེ།",
    "ང་ཡིས་བལྟས་ན་རང་བཞིན་གཅིག་པར་མཐོང་།",
    "ཇ་མར་གོས་དང་པད་ཤགས་མཐོང་བའི་ཚེ།",
    "མ་བཅོས་སེམས་ཀྱི་རྒྱུ་དག་གཅིག་པར་མཐོང་།",
    "ས་སྟེང་འདི་རུ་མི་སྡོད་ཀ་མེད་ལགས།",
    "ཞེས་ལུས་ཀྱི་མཚན་ཉིད་བསྟན་དང་སྙན་ངག་མཛེས་པར་བྱེད་པ་ཡི།",
    "དེའི་ནང་ནས་བག་ཆགས་ཆེ་བ་རྣམས་ཀྱིས་རྩོམ་པ་པོའམ་སྒྱུ་རྩལ་པར་གསར་རྩོམ་གྱི་ལས་ལ་འཇུག་འདོད་པའི་ཀུན་སློང་ཐོག་མར་སྐྱེས།",
    "རྣམ་འགྱུར་གསལ་བ་ཞེས་པ་ནི་རྩོམ་པ་པོས་ངོས་འཛིན་པའི་ཐོག་ནས་བསྟོད་བསྔགས་ཤིས་བརྗོད་བྱ་རྒྱུའམ་ཡང་ན་དམན་པར་དགག་སྒྲུབ་བྱེད་རྒྱུ་ཡིན་ལ།",
    "ལྟ་ཚུལ་དང་ངོས་འཛིན་གསར་པ་ཞིག་དགོས་ན་ནི་རྩོམ་པ་པོས་ངེས་པར་དུ་ཤེས་བྱ་རྒྱ་ཚེ་ལ་གཏིང་ཟབ་པའི་རྨང་གཞི་འདིང་བར་བརྩོན་པ་ཆུ་བོའི་རྒྱུན་བཞིན་སྐྱོངས་དགོས།",
    "མཚན་གསོལ་བ་ལའང་དགོས་པ་ཁྱད་པར་བ་དུ་མ་ཡོད་དེ།",
    "མིང་དུ་གདགས་པར་མ་མཛད་ན།",
    "འཇིག་རྟེན་ཐམས་ཅད་རྨོངས་པར་གྱུར།",
    "མགོན་པོས་མིང་དུ་གདགས་པར་མཛད་ཅེས་གསུངས་པ་ལྟར་འཇིག་རྟེན་གྱི་བྱ་དངོས་གང་དང་གང་དེར་མིང་གསོལ་བ་ནི།",
    "དོ་ན་མཐོང་བའི་ཚེ་མིང་དྲན་པར་གྱུར་བས་མིང་དོན་གྱི་འབྲེལ་བ་གྲུབ་པ་སོགས་ཀྱི་ནུས་པ་ཆེན་པོ་ལྡན་ཡོད།",
    "༤ འཁྲབ་ཆས་གཙོ་བོ་རྩོམ་བྱང་དུ་བྱས་པ།",
    "སྨྱོན་པར་རྗེས་སུ་མི་དཔོག་གམ།",
    "རྩོམ་གྱི་རྒྱུ་ཆ་ཕུན་སུམ་ཚོགས་པོ་ཡོད་པ་ཙམ་གྱིས་མི་ཆོག་པར།",
    "ཚན་པ་སོགས་འོས་ཤིང་འཚམ་པར་བགོས་ཏེ།",
    "ངེས་པར་བསྟན་པ་དེ་ཡི་སྒོ་ཞེས་དང་།",
    "ཡང་སེང་གེའི་ལྟ་སྟངས་ཀྱིས་ཁྱད་པར་གྱི་གཞི་བཟུང་།",
    "རུས་སྦལ་གྱི་འབུར་འགྲོས་ཀྱིས་ཚིག་དོན་འཇེབས་པར་བཤད།",
    "རྩོམ་པ་པོའི་ཆགས་སྡང་མཚོན་པའི་གླེང་བརྗོད་སོགས་ལེགས་པར་བསྒྲིགས་པ་དེར་ཟེར།",
    "རུས་སྦལ་གྱིས་ཀྱང་དེ་དོན་ཁས་ལེན་བྱས།",
    "གལ་ཏེ་རྩོམ་པ་པོས་གོ་རིམ་ཇི་བཞིན་མ་བྲིས་པར་མཇུག་འབྲས་སམ་མཐོ་རླབས་སྔོན་དུ་བཀོད་པའམ་ཡང་ན་བར་ནས་འགོ་བཙུགས་ཏེ་གླེང་བ་སོགས་ཆ་ཤས་ལ་འགྱུར་བ་བཏང་བ་ཙམ་ལས་ཡོངས་ཁྱབ་ལ་འགྱུར་བ་བཏང་མེད་པས།",
    "དེ་དག་ལ་ངེས་པར་དུ་བསྟུན་དགོས་ཤིང་ཤེས་ཀྱང་དགོས་སོ།",
    "རྩོམ་པར་དམ་བཅའ་བ།",
    "དེ་ནས་ལུང་རིགས་ཀྱི་དབྱེ་ཞིབ་དཔྱད་པ་བྱས།",
    "བྱས་པ་འཇོན་ཐང་ཅན་གྱི་ཁྱིམ་མི་གཟི་བརྗིད་ཅན་ཞིག་ཡིན་པ་ལས།",
    "འབྲོག་དགེ་ལྡན་རྣམ་པར་རྒྱལ་བ་དེར།",
    "མཚན་བརྗོད་པར་དཀའ་བའི་དྲིན་པོ་ཆེ།",
    "ཕ་བློ་བཟང་གྲགས་པ་ཡབ་སྲས་བཞུགས།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "གལ་སྲིད་རང་བློས་བདེན་པར་ཐག་བཅད་པ་ཞིག་ཡིན་ཚེ།",
    "མི་རྣམས་ལ་ལྷ་སྒྲུང་ཤོད་པ་ལྟ་བུའི་ཚོར་སྣང་སྤྲོད་པ།",
    "དེ་ལྟར་མུན་པའི་ཁྲོད་ན་འཇིག་རྟེན་གྱི་ཁམས་ཡོངས་རྫོགས་ཤི་རོ་ཞིག་དང་མཚུངས་པར་ངག་བསྡམས།",
    "ལེགས་བཅོས་ཀྱི་དགོངས་འཆར་ལྷུག་པོར་གནང་རོགས་ཞུ་རྒྱུ་བཅས།",
    "རྩོམ་པ་པོའི་འདོད་བློ་ལྟར་སྒྲིག་པ་མ་ཡིན་གྱི་དངོས་ཡོད་ཀྱི་གནས་ཚུལ་ལྟར་གོ་རིམ་བཀོད་སྒྲིག་བྱས་པ་ཞིག་ཡིན།",
    "ངེས་པར་དུ་ཕྱི་རོལ་ཡུལ་གྱི་བྱ་དངོས་ལ་བསྟུན་དགོས་ཏེ།",
    "རྩིས་དཔོན་ལས་ཚབ་གནང་ཚུལ།",
    "སྡུག་བསྔལ་གྱི་བདེན་པ་ཕུལ་ཕྱིན་ཐུགས་ཉམས་སུ་བཞེས་པ།",
    "ཞེས་པར་དུམ་བུ་བཞིར་ཕྱེ་ནས་བརྗོད་ཚུལ་ལ་ཆ་བཞག་ན།",
    "དེ་གཉིས་ལ་ཁྱད་པར་ཅུང་ཆེཙམ་ཡོད་དེ།",
    "རྩོམ་གྱི་གོ་རིམ་དབྱེ་སྐབས་ནང་དོན་མངོན་སྟངས་ཀྱི་རྣམ་པར་གཟབ་ནན་བྱེད་དགོས།",
    "ཚིག་སྦྱོར་གྱི་སྒོ་ནས་དབྱེ་དགོས་ལངེས་པར་དུ་གོ་རིམ་ལ་བསྟུན་དགོས་པས་གཅིག་མཚུངས་སུ་བལྟ་མི་རུང་བའི་ཁྱད་པར་ཡོད་དོ།",
    "ཡར་ཀླུང་གཙང་པོ་བྱ་བའི་ཐ་སྙད་ལ་དཔྱད་པ་ཙམ་བྱས་པ་ཞེས་པའི་དཔྱད་རྩོམ་གྱི་འགོ་རུ་སྲིད་པའི་ཆུ་ཆེན་ཡར་ཆབ་གཙང་པོ་འདི་ནི་བོད་ཡུལ་ས་མཐོའི་ཐོག་ནས་འབབ་པའི་ཆུ་བོ་ཆེ་ཤོས་དེ་ཡིན་ལ།",
    "ཡང་ན་འགྱུར་བ་མེད་པའི་མཚོན་རྟགས་ལྟ་བུ་ཞིག་ཀྱང་ཡིན་ཞེས་ཡར་ཆབ་གཙང་པོ་ཞེས་པ་འདི་ཆུ་བོ་གང་འདྲ་ཞིག་ཡིན་ཚུལ་དང་།",
    "དེ་རྗེས་ཡར་ཀླུང་གཙང་པོ་ཞེས་པ་དང་དེའི་ཐ་སྙད་ཀྱི་གོ་དོན་ལ་ཕྱོགས་ཡོངས་ན་ས་དཔྱད་པ་བྱས་ཡོད།",
    "ངས་ལོ་གསུམ་ལ་བསམ་པའི་ཐོག་འཐབ་རྩོད་བྱས་ནའང་།",
    "༣ གོ་རིམ་དང་དུམ་བུ་ལ་ཁྱད་པར་ཅི་ཡོད་དམ།",
