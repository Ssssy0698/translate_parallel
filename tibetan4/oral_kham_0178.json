    "མི་བདག་ཀྱང་དེ་གའི་ངང་ལ་གདའ།",
    "དེ་ནི་གྲགས་པ་རྒྱལ་མཚན་ལ་བསྐུར་བའི་ཡིག་ལན་འདྲ་པོ་འདུག་པས་ཙོང་ཁ་པ་དང་གྲགས་པ་རྒྱལ་མཚན་དབར་ཡིག་འགྲུལ་རྟག་པོ་ཡོད་པའི་རྟགས་ཡིན།",
    "སུང་༢ བུམ་ནང་གྲུགས་པ་དོན་གྲུབ་ཅེས་བྲིས་འདུགབློ་དཆུང་།",
    "ལོ་དེའི་ནང་ཁྱིམ་ཚང་དེར་བུ་ཞིག་བཙས་འདུག་ཀྱང་ཚེ་མ་ཟིན་པ་དང་།",
    "དེ་གར་སྔར་ཡོདདགོན་ཆུང་ཞིག་ཡོད་པ་དེ་རྒྱ་ཆེ་རུ་བཏང་བ་ལ་འབྲི་གུང་མཐིལ་གོན་པ་ཟེར་བ་དང་ཁོང་རང་དགོན་བདག་ཏུ་གྱུར་ཏེ་མི་རྣམས་ཀྱིས་འབྲི་གུང་པ་ཞེས་ཞུ།",
    "འཕྲིན་སྐྱེལ་ཕོ་ཉ་ནི་ཨོ་པ་ཤི་ཀ་ཡིན་ལ་ཕྱག་བྲིས་འབྲི་ས་ལྷ་ལྡན་གཙུག་ལག་ཁང་དུ་ཡིན་འདུག།",
    "པཎ་ཆེན་སྐུ་ཕྲེང་ལྔ་པའི་སྐུ་དུས་ནི་ཏཱ་ཆིང་གོང་མའི་རྒྱལ་ཁབ་འཛུགས་སྒང་ཡིན་གཤིས་གཅིག་གྱུར་དང་ཁ་ཕྲལ་གྱི་འཐབ་རྩོད་ཛ་དྲག་པོས་ཁྱབ་ལ་བོད་ས་གནས་ཀྱང་ཏཱ་ཆིང་གོང་མའི་རྒྱལ་ཁབ་ཀྱི་གྲུབ་ཆ་ཞིག་ཡིན་པར་བརྟེན་གཅིག་གྱུར་དང་ཁ་ཕྲལ་གྱི་འཐབ་རྩོད་དེའི་ནང་རང་ཤུགསསུ་ཚུད་ཅིང་།",
    "ཆིང་རྒྱལ་རབས་ཀྱི་དོན་དངོས་གསལ་བཀོད་ནང་དུ་འདི་ལྟར་བྲིས་འདུག་ལིའི་ཧྥན་ཡོན་གྱིས་ཞུས་པར།",
    "གནས་ཚུལ་དེ་པེ་ཅིང་དུ་འབྱོར་སྐབས་རྒྱལ་བློན་ཚོའི་ཐུགས་ལ་བོད་ཀྱི་བྱ་བ་ནི་བྱེད་ཁག་པོ་འདུག་སྙམ་པའི་བསུན་སྣང་སྐྱེས་པ་དང་།",
    "ཡུང་ཀྲེང་ཁྲི་ལོ་དགུ་པར་སྤྱི་ལོ་༡༧༣༡འབྲུག་པ་ནང་འཁྲུག་ཐུག་དུས་ཕོ་ལྷ་བས་སྐབས་དང་བསྟུན་ཏེ་ཞི་བའི་སྒོ་ནས་འགྲིག་ཐབས་བྱས་པ་དང་།",
    "རང་ནུས་གང་ཐུབ་ཀྱི་སྒོ་ནས་ཡི་པིམ་ཇུན་གར་བའི་གནས་ཚུལ་མྱང་གནོན་ཞུས་ཏེ་ཕོ་ལྷ་བ་བརྒྱུད་སྙན་སེང་ཞུས་ཡོད་ན་གོང་མ་ཆེན་པོའི་ཐུགས་རྗེའི་བཀའ་ལན་གང་མྱུར་སྩོལ་གནང་ཡོང་བ་ཞེས་ཞུས་འདུག་པས་ངོས་དགའ་སྤྲོ་ཤིན་ཏུ་ཆེ།",
    "དེ་ནི་ཧ་ཅང་སྤམ་པོ་དང་ཡག་པོ་བྱུང་འདུགལེའུ་བཞི་པ།",
    "རང་འཚམས་སུ་གོ་མིང་རྫུན་མ་ཁྱེར་བ་སོགས་ལོག་པར་འཁུ་བའི་བྱེད་སྤྱོད་སྣ་ཚོགས་མངོན་གསལ་ཆེན་པོ་འདུག་ཅེས་གསུངས།",
    "གནས་དབྱུང་བཏང་བ་སོགས་མང་དག་བྱུང་འདུག་ཅེས་གསལ།",
    "འགྱུར་མེད་རྣམ་རྒྱལ་གྱིས་དམག་གྲོ་བསྒྲིགས་པ་དང་ལོག་པར་འཁུ་བའི་བསམ་པ་བཅངས་འདུག་ཁོ་དྭཊ་ས་ནས་ཕྱིར་ལོག་སྟེ་འདི་གར་མཇལ་ཞུར་ཡོང་སྐབས་བཟུང་ནས་བསད་ན་སྙམ་ཞེས་འཁོད།",
    "ཐུང་ཕན་ཁྲང་མིང་དང་ཡུལ་དམག་སོགས་ཚེས་ཉེར་བཞི་ཉིན་རང་གནས་སུ་ལོག་ཟིན་འདུག་ཅེས་འཁོད།",
    "རྒྱ་ཡིག་ཏུ་རྒྱལ་ཚབ་ཅེས་སྒྲ་སོར་བཞག་བྱས་འདུག་ལོ་དེར་པཎ་ཆེན་སྐུ་ཕྲེང་དྲུག་པ་དགུང་ལོ་བཅུ་དགུར་ཕེབས་ཏེ་བསྙེན་རྫོགས་ཀྱི་དུས་སུ་སོན་རུང་།",
    "དེར་གཞིགས་ན་ཁོང་ནི་རྒྱ་གར་སྐད་ལ་སྦྱངས་པ་གང་ཙམ་ཡོད་འདུག་ཅེས་དང་།",
    "སྤྱི་ལོ་༡༧༨་གོང་མ་ཆེན་པོ་དགུང་ལོ་བདུན་ཅུར་ཕེབས་པའི་རྟེནའབྲེལ་མཛད་སྟོན་ལ་ཕེབས་རྩིས་འདུག་ཅེས་ཞུས་བྱུང་།",
    "ད་ཆ་ཁོང་རང་ཕེབས་འདོད་ཡོད་པ་ནི་ངེད་ཀྱི་འདུན་པ་དང་ཡོངས་སུ་མཐུན་པས་བཀྲ་ཤིས་པའི་བྱ་བ་ཡིན།",
    "ཁོ་ལ་ལྕག་ལྕག་ནན་ནན་བྱེད་དགོས་ཀྱི་འདུག་དགོངས།",
    "ཏེ་ཧེའི་ས་རྒྱུད་དུ་ཆིང་རྒྱལ་རབས་ཀྱི་དོན་དངོས་གསལ་བཀོད་ནང་ཏེ་ཧའི་ཞེས་བྲིས་འདུག་ཀྱང་།",
    "ཟོག་དཀར་ནག་དང་སྦྲ་དུད་ཡོངས་རྫོགས་ཕྱག་མཛོད་ཡེ་ཤེསརྒྱལ་མཚན་གྱི་ལག་ཏུ་སོན་འདུག་གོས་ཆེན་བཅད་ལྡན་དང་།",
    "སྐུ་བརྙན་སོགས་མི་ཉུང་ཙམ་འདུག་ཀྱང་།",
    "གོང་མས་གནས་ཚུལ་བཀའ་འདྲི་གནང་རྗེས་ཞུའི་ནན་བེང་རང་འཇགས་བོད་ལ་བསྐྱོད་ནས་དམག་འཐབ་བྱ་དགོས་པའི་བཀའ་ཕབ།",
    "དང་པོ་ཉིད་ནས་དངོས་མེད་རྫུན་སྒྲིག་ཡིན་ཚེ་དེ་བས་ཀྱང་ཁུངས་ལུང་མེད་གཤིས་ལྷ་པས་བྱུང་རྒྱལ་དུ་སྨྲས་པར་ཡིད་ཆེས་བྱེད་འོས་པ་འདུག་གམ།",
    "དབྱིན་ཇི་བ་མ་ལིན་མན་ནིང་ཞེས་བསྒྱུར་པའང་འདུག་གྱིས་ཙཱ་ཆིང་ཁྲི་ལོ་བཅུ་དྲུག་པར་སྤྱི་ལོ་༡༨༡༡སྐད་སྒྱུར་ཀྲའོ་ཅིན་ཤིའུ་ཁྲིད་དེ་གནས་སྐོར་གྱི་མིང་ཐོག་ནས་ལྷ་སར་འཛུལ་བའི་གནས་ཚུལ་བོད་བཞུགས་ཨམ་བན་གཡང་ཁྲོན་གྱིས་ཤེས་ཏེ་ཆིང་གོང་མ་རིན་ཙུང་ལ་ཐག་གཅོད་ཇི་བྱེད་དགོངས་སྐོར་ཞུས་པ་ན།",
    "ཞི་དུལ་བབ་ཆགས་དང་རང་གཤིས་ལྷད་མེད་ཀྱི་བྱིས་པའི་ཡོན་ཏན་བཟང་པོ་འཛོམས་པ་ཞིག་ཏུ་མཐོང་།",
    "ཁོ་བོད་དུ་ཡོང་བའི་དམིགས་ཡུལ་ཡང་བོད་ཀྱི་ལུང་པའི་ལུགས་སྲོལ་དང་མིའི་གོམས་གཤིས་བརྟག་དཔྱད་བྱེད་ཕྱིར་ཡིན་པས་ཁོ་ནི་བྷོ་གལ་སོགས་དང་གཅིག་པ་མིན་པའི་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད་འདུག་དུག་ད་ཡོད་ཀྱི་དཔྱད་གཞིར་གཞིགས་ན་མ་ལིན་གྱིས་དབྱིན་ཇིའི་ཤར་རྒྱ་གར་ཀུང་སིའི་ནང་དུ་ལས་ཀ་བྱེད་མྱོང་ཡོད་ཀྱང་ཁོ་པབོད་ལ་ཡོང་བ་ནི་རང་ཉིད་གཉན་ས་འགྲིམ་དཔྱོད་ཀྱི་དོན་དུ་ཡིན་པ་ལས་དབྱིན་ཇིས་བཏང་ཡོང་བ་ཞིག་མ་ཡིན།",
    "མ་ལིན་ལ་གདེང་འཇོག་ཧ་ཅང་ཆེན་པོ་བྱས་འདུག་པ་དེ་ཐོག་ནས་མ་ལིན་བོད་དུ་ཡོང་བ་ནི་ངབྱིན་ཇི་བཙན་འཛུལ་མཁན་གྱི་དགོས་མཁོ་དང་མཐུན་ཡོད་པ་དངོས་ར་འཕྲོད་ངེས་བྱུང་བ་མ་ཡིན་ནམ།",
    "དེ་ནི་འགྲིག་འདུག་ག་འབྲས་ལྗོངས་ཚོ་པ་ནི་བོད་ཀྱི་ཁོངས་གཏོགས་མ་ཡིན།",
    "ཏའོ་ཀོང་ཁྲི་ལོ་ཉེར་དྲུག་པའི་སྤྱི་ལོ་༡༨༤༦ཟླ་བཅུ་གཉིས་པར་དབྱིན་ཇིས་སྟོད་སྒར་དཔོན་ལ་ཡི་གེ་ཞིག་བསྐུར་འདུག།",
    "ཞིགས་སྐབས་ཧ་ཅང་ངོ་མཚར་ཆེ་བའི་བྱིས་པ་གསུམ་ཡོད་འདུག་པ་ནི་བཀྲ་ཤིས་པའི་བྱ་བ་ཡིན་གཤིས་ངེད་དགའ་སྤྲོ་ཚེ།",
    "ཁོ་ཧམ་ཤེད་ཤིན་ཏུ་ཆེ་བས་རྭ་སྒྲེང་ཧོ་ཐོག་ཐུ་གསོད་རྩིས་བྱེད་ཀྱི་ཡོད་འདུག་ཅེས་འཁོད།",
    "ཞྭ་སེར་བསྟན་པ་དར་བར་བྱསཔས་དད་ལྡན་སྐྱེ་བོ་ཀུན་གྱིས་གསེར་སྡོང་ལེགས་པར་བསྐྲུན་ཏེ་ཟླ་བ་པའི་ཚེས་བ་སྤྱད་ཉིན་སྐུ་གདུང་བཅུག་ཟིན་པ་ནི་གང་ལེགས་བྱུང་འདུག་པས་ངེད་ལ་སེམས་གསོ་ཆེན་པོ་བྱུང་།",
    "འོན་ཀྱང་གོ་གནས་དེ་དབོང་རང་ཉིད་ཀྱི་དུས་ལ་མ་གཏོགས་རྒྱུད་འཛིན་མི་ཆོག་པ་བཟོས་ཏེ་ཡབ་ངོ་མ་དང་དབྱེ་བ་ཡོད་པ་མཚོན་པར་བྱས།",
    "ཚོང་འགྲུལ་བྱ་རྒྱུའི་ཐད་ངེད་བོད་ཕྱོགས་ཤིན་ཏུ་བྱེད་མི་བདེ་བ་ཞིག་འདུག་པས་གོང་མའི་བཀའ་ལྟར་ཚོང་འགྲུལ་མི་བྱ་ཐབས་མེད་ལ་ཐུག་རུང་རང་ཅག་བོད་ཀྱི་ས་ཁོངས་སུ་ཕྱི་གླིང་པ་གཏན་ནས་ཡོང་མི་ཆོག་པའི་ངོས་འཛིན་བྱས།",
    "དབྱིན་ཇི་བ་འདི་གར་ཡོང་དོན་ནི་ཡག་རྟགས་གཏཙ་ནས་ཡིན་ཞེས་བཤད།",
    "བོད་སྡོད་ཨམ་བན་ལན་གཡུས་ཀྱིས་ཟི་ཁྲོན་དུ་ཀྲའོ་ཨེར་ཉུང་བསད་པ་གོ་ཐོས་བྱུང་ནས་ཁོ་པ་རང་ཉིད་མཎྚི་རིགསཡིན་སྟབས་རང་ཉིད་ཀྱི་ཚེ་སྲོག་ལ་ཡང་ཉེས་སྐྱོན་མི་ཡོང་བའི་ངེས་པ་མི་འདུག་སྙམ་ནས་པཎ་ཆེན་སྐུ་ཕྲེང་དགུ་པ་མཆོག་ལ་སྲུང་སྐྱོབ་གནང་རོགས་ཞེས་གསང་འཕྲིན་བཏང་ག་ཤིས།་",
    "མཐའ་མཚམས་ཉེན་ཁ་ཆེན་པོ་འདི་ལྟ་བུ་ཆགས་པས་ན་དངངས་འཚབ་ཤིན་ཏུ་ཆེན་པོ་འདུག་པས་མགྱོགས་མྱུར་ཐག་གཅོད་ཡོང་ཐབས་གནང་སྟེ་ཉེན་ཁའི་གནས་ལས་འགྲོལ་ཐབས་གནང་སྐྱོང་འཚལ་ཞེས་བཤད།་",
    "ཉ་པས་སྐབས་བསྟུན་ཁེ་བཟང་བཟས་པ་ལྟར་འབྲས་བུ་ཐོགས་པར་ཡལ་ཀར་སྐྱོན་བཏང་འདུག་ཟེར་བའི་ཁག་དཀྲི་འཁེལ་སྲིད།",
    "དང་པོ་༡༩༢༡ ལོའི་རྒྱ་གར་དང་བོད་ལྗོངས་དབར་གྱི་ཆིངས་ཡིག་ལ་གཞིཊ་ན་རྒྱ་གར་གྱིས་བོད་ལ་གོ་མཚོན་མཁོ་སྤྲོད་མི་ཆོག་གཉིས་པ་རྗེས་སུ་གོ་མཚོན་མཁོ་སྤྲོད་བྱེད་སྐབས་བདེ་འཇཊ་དང་རང་སྲུང་ཁོ་ནར་བེད་སྤྱོད་བྱེད་རྒྱུའི་ཚད་བཀག་བྱེད་རྒྱུ།",
    "འོན་ཀྱང་རྗེས་སུ་ར་སྤྲོད་ཁུངས་བཙན་མི་འདུག་སྙམ་པ་དང་།",
    "པཎ་ཆེན་སྐུ་ཕྲེང་དགུ་པ་བཀྲ་མི་ཤིས་པར་སྐུ་གཤེགས་པ་དེ་ཁོང་རང་ཉིད་ཀྱི་སྐྱོ་གནས་ཤིག་ཡིན་པ་མ་ཟད།",
    "ལི་ཅེ་ཧྲེང་ནི་དབྱིན་ཇི་བ་ཕབ་སྒྱུར་བྱེད་སྐབས་ལི་ཁ་ཤུན་ཞེས་བྲིས་པ་འདུག་ལ་ལི་ཁྲ་ཧྲེན་ཞེས་བྲིས་པའང་འདུག་ཡིན་ཞིང་།",
    "ས་ཁྲ་དེ་བཟོ་བཅོས་ཟིན་འདུག་པས་བོད་ལྗོངས་འདི་ཉིད་ཀྲུང་གོའི་ས་ཁོངས་སུ་བྲིས་འདུག་ཅེས་འཁོད།",
    "ང་བཀའ་ཤག་ནས་ལོག་ཡོང་སྐབས་ས་རུབ་ལ་ཉེ་བར་འདུག་ཅིང་།",
    "བཀའ་ཤག་ནས་མི་བཏང་སྟེ་ཏར་གཏོང་འཕྲུལ་འཁོར་དེ་བཤིག་ཟིན་འདུག་ཅེས་འཁོད།",
    "ང་རང་ལོ་ན་མ་སོན་པའི་བར་ལ་རྒྱ་བོད་བར་འགལ་ཟླ་བྱུང་བ་བློ་ཕམ་ཆེན་པོ་བྱུང་།",
    "ཁ་ཏའི་སྐུ་ཚབ་ཚོགས་པའི་དྲུང་ཡིག་གེ་གཡུས་རུའི་ཡང་དགའ་སྐུ་ཡུ་བར་ཕེབས་འདུག་ལྷ་སའི་བོད་རིགས་སྤུན་ཟླ་རྣམས་གཟབ་མཆོར་ས་ཤིང་ཁྲོམ་ལམ་གྱི་གང་སར་དུས་ཆེན་གྱི་རྣམ་པས་ཁེངས།",
    "ངས་ཁོ་པར་བོད་ཞི་བས་བཅིངས་འགྲོལ་འབྱུང་ཐབས་སྐོར་གྱི་གྲོས་མཐུན་མཚོང་བྱུང་ངམ་ཞེས་དྲིས་པར་ཁོ་པས་ལན་འདེབས་ཀྱི་མི་འདུག་ཅེས་འཁོད།",
    "ཞལ་ངོ་ནང་མཚམས་ཀྱི་ལེགས་སྤེལ་མཛད་འདུག་པས་བོད་ཀྱི་རྒྱལ་རབས་སྲིད་དོན་ལ་ཕན་པ་ཧ་ཅང་ཆེན་པོ་ཐོབ།",
    "ཅེས་འཁོད་འདུག་ཐེངས་འདིལ་ལོ་འཇའ་ས་ཞུ་སྨྱུའི་ཐད་མ་རྙོབ་ལང་ཙམ་བྱུང་རུང་།",
    "འབུལ་བ་དཔྱ་ཁྲལ་རྣམས་ཀྱང་ཧྲན་ཧྭ་རྒྱལ་པོའི་མིང་ཐོག་ནས་ཕུལ་འདུག་པས།",
    "འངུལ་བ་ཐེངས་མང་ཕུལ་བ་རྣམས་ཧྲན་ཧྭ་རྒྱལ་པོའི་ཐོག་མའི་མིང་ཐོག་ནས་ཕུལ་འདུག་ད་ལམ་པོད་ནས་འ་༴",
    "ལ་བ་འབུལ་སྐབས་བཀའ་ཡིག་རུམ་ཁ་བརྗེ་འགྲུལ་ཡོང་བ་ཞུ་སྐབས་ཀྱང་ཁ་གསལ་སྙན་སེང་ཞུས་མི་འདུག་པས་ལོ་ང་འོག་གནས་ཚུལ་མི་མཐུན།",
    "དེར་བརྟེན་བོད་བཞུགས་ཨམ་བན་ལོ་ཁམས་གང་ལ་བཙུཔ་མིན་ཐད་ད་དུང་ཞིབ་འཇུག་བྱེད་དགོས་པ་འདུག་འོན་ཀྱང་བོད་ངཤུགས་ཨམ་བན་ལས་འཛིན་དང་པོ་ནིམཱ་ལ་དང་སེང་གེ་དཔལ་གཉིས་ཡིན་པ་གདོན་མི་ཟ།",
    "དམག་དཔུང་ཡང་ཕྱིར་འཐེན་ཟིན་པས་བློན་ཆེན་བཞུགས་དཕྲོས་དོན་མི་འདུག་ཅེས་སྙན་སེང་ཞུས།",
    "དེ་ཐད་བོད་བཞུགས་ཨམ་བན་གྱི་བཀའ་ལན་མི་འདུག་པས་དེ་ལྟར་འགྱངས་ན་མི་འགྲིག་ཅེས་འཁོད་འདུག་གོང་གསལ་ཐོ་བཀོད་དེ་ལ་གཞིགས་ན་སྤྱི་ལེ་དྲུག་བརྒྱའི་གཞུང་ཡིག་སྐྱེལ་བར་པེ་ཅིང་ནས་ཁྲེང་ཏུ་བར་སྤྱིར་བཏང་བྱས་ན་ཉིན་གྲངས་བཅུ་དང་།",
    "ཆིང་རྒྱལ་རབས་ཀྱི་དོན་དངོས་གསལ་བཀོད་ནང་འཁོད་གསལ་ལྟར་བསྡོམས་རྩིས་བྱས་ན་བོད་བཞུགས་ཨམ་བན་དང་ལས་རོགས་ཨམ་བན་མི་དུངས་བརྒྱ་དང་སུམ་ཅུ་སོ་ལྔར་བསྐོ་གཞག་གནང་འདུག་དེ་ཁོངས་ནས་མི་བཅུ་གཅིག་རྒྱུ་རྐྱེན་སྣ་ཚོགས་ཀྱིས་རྐྱེན་པས་ལས་གནས་སུ་ཕེབས་མེད་གཤིས་དོན་དངོས་ཐོག་ལས་གནས་བསྐོ་གཞག་བྱས་པ་ནི་མི་གྲངས་བརྒྱ་དང་ཉེར་བཞི་ཟིན།",
    "རྗེ་དྲུང་བཅས་ཀྱི་ནང་ནས་གནས་སྤར་ཁ་གསབ་བྱེད་རྒྱུ་ཞེས་འཁོད་འདུག་ད་ལམ་བརྟག་དཔྱད་བྱས་པར་གཞིགས་ན་རྩིས་དཔོན་ཕྱག་མཛོད་ནི་རིམ་པ་བཞི་པར་གཏོགས་པ་དང་།",
    "ཙ་ན་དཀའ་སོགས་མཐོང་གྱུར་ཅིང་།",
    "འཇིག་རྟེན་གྱི་ལུས་དང་གནས་དང་བྱེད་པ་དག་ཀྱང་འདུག་ནས་འཇུག་པའི་ཕྱིར།",
    "དཔེར་ན་ལྷ་སྦྱིན་འགྲོ་བ་ན་མཆོད་སྦྱིན་འདུག་པ་ལྟ་བུའོ།",
    "གོམས་པས་ཁྱད་པར་ཡོད་པ་ཡིན་ན་ཡང་རང་བཞིན་ལས་འདས་ཏེ།",
    "ཡུལ་ཡང་རང་བཞིན་འཛིན་པར་བྱེད་པའི་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་སོ།",
    "གཞན་ཡང་རང་བཞིན་འབད་རྩོལ་མེད་པར་ཟློག་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "གང་ཞིག་གང་རང་བཞིན་ཡིན་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་སྦྱོར་བ་ལ་གང་ཞིག་གང་ཞེས་བྱ་བ་ལ་སོགས་པས་གཏན་ཚིགས་གྲུབ་པར་སྟོན་པར་བྱེད་དོ།",
    "བདག་སྡུག་བསྔལ་གྱི་རྒྱུ་ཡིན་ན་ཡང་འདོད་ཆགས་དང་བྲལ་བ་མ་ཡིན་པ་དེ་ལྟར་བདག་ལ་ཆགས་པ་ཡང་རང་ཉིད་དུ་བཟུང་བ་ན་སྡུག་བསྔལ་གྱི་རྟེན་ཉིད་ཡིན་ན་ཡང་འདོད་ཆགས་དང་བྲལ་བར་འགྱུར་བ་མ་ཡིན་པ་དེ་ལྟར་ན་མ་ངེས་པ་ཡིན་པར་བསྟན་ཏོ།",
    "ཆ་འཛིན་པའི་རྣམ་པ་ཡང་རང་རིགས་པའི་ཡུལ་ཅན་ཉིད་ཡིན་པའི་ཕྱིར་དཔེ་མ་གྲུབ་པ་ཉིད་མ་ཡིན་ནམ་ཞེ་ན།",
    "དེ་ནི་རག་ལས་པ་མེད་པ་ཡང་རང་རྒྱུད་དུ་གྱུར་པ་ཡིན་ནོ།",
    "དེས་ནི་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་འབྲེལ་པའི་མཚན་ཉིད་བསྟན་ཏོ།",
    "དེ་དག་ནི་འབྲས་བུ་དང་རང་བཞིན་ཉིད་དུ་གྱུར་པའི་དོན་དག་གོ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་གཉིས་ཁོ་ན་ཡིན་ཏེ།",
    "འདིས་ཀྱང་རང་བཞིན་མི་དམིགས་པའི་སྦྱོར་བ་ལྟར་བཅོས་པ་བསྟན་ཏོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པ་རྣམས་འགའ་ཞིག་དང་ལྷན་ཅིག་འགལ་བ་གྲུབ་པ་མེད་ཕྱིར་དེའི་རྒྱུའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་གང་རང་བཞིན་དུ་གྱུར་པའམ།",
    "རྣམ་པར་འཇོག་ན་ཡང་རང་བཞིན་ཉིད་དུ་འགྱུར་ན་དེ་ལྟར་ཡང་མ་ཡིན་ནོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "བདེ་བ་ལ་སོགས་པའི་བདག་ཉིད་ཀྱི་ངོ་བོ་ཉིད་དུ་དེ་ཡང་རང་བཞིན་ཐ་དད་པ་ཅན་མེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "བདེ་བ་ལ་སོགས་པའི་བདག་ཉིད་སྐྱེད་པ་ལ་ཡང་རང་རིག་པ་བརྗོད་པ་དང་འདྲེས་པ་མ་ཡིན་ནོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱི་ངེས་པ་མི་རུང་བའི་ཕྱིར་རོ།",
    "ཡུལ་ཤེས་པའི་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་ཡུལ་དང་རྗེས་སུ་མཐུན་པའི་ཤེས་པར་སྣང་བ་དང་རང་སྣང་བ་ཡིན་ནོ།",
    "དེའི་སྒོ་ནས་འོངས་པ་ཡུལ་དུ་སྣང་བ་དང་རང་སྣང་བའི་མཚན་ཉིད་ཅན་དག་ནི།",
    "ཇི་ལྟར་སྔོན་པོ་དང་སེར་པོ་དག་དུས་གཅིག་ཏུ་དམིགས་པ་ཡིན་ན་ཡང་།",
    "རིགས་པ་འདིས་ནི་ཡུལ་དུ་སྣང་བ་དང་རང་སྣང་བ་ཉིད་ཀྱི་ཚུལ་གཉིས་པ་མ་ཡིན་ནོ།",
    "འོན་ཀྱང་བདག་ཉིད་དུ་གྱུར་པ་ཡིན་ནོ་དེས་དེའི་ཕྱིར་མངོན་སུམ་དང་བདག་རིག་གྲུབ་བློ་དེ་མངོན་སུམ་ཉིད་དང་རང་རིག་པ་ཉིད་དུ་གྲུབ་པ་ཡིན་ཏེ།",
    "བློ་ཡིད་བྱེད་དག་ཀྱང་རང་ཉིད་ཤེས་པ་ཡིན།",
    "དོན་དེ་མ་མཐོང་བ་ཡིན་ནོ་ཞེས་འདོད་པ་དེའི་ཡང་རང་ཉིད་བློ་རྗེས་སུ་དཔག་པར་འགྱུར་ན་རིགས་པ་མ་ཡིན་ནོ།",
    "འོན་ཀྱང་རང་ཉིད་གསལ་བར་བྱེད་པའི་བདག་ཉིད་ཅན་བློ་སྔ་མ་གསལ་བར་བྱེད་པའི་བློ་དེ་ནི་རང་རིག་པར་གྲུབ་པར་འགྱུར་གྱི་ཤེས་པ་གཞན་གྱིས་མྱོང་བ་མ་ཡིན་ནོ།",
    "མི་འཇིག་དུས་ཐམས་ཅད་དུ་གནས་པར་འགྱུར་རོ།",
    "གཞན་ཡང་རང་བཞིན་དང་སྟེ་ཤིང་ལ་སོགས་པ་ལྟ་བུའོ།",
    "དེ་ལ་ཡང་རང་བཞིན་ཉིད་ཀྱིས་རུང་བ་ཉིད་འདི་ལ་སྒྲ་ཐམས་ཅད་སྦྱོར་བ་བྱེད་པས་མཐུན་པའི་ཕྱོགས་ཟླ་བ་མ་ཡིན་པ་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་ན།",
    "ཅིའི་ཕྱིར་བྱས་པ་ཉིད་ཀྱང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཡིན་ཞེ་ན།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་བྱས་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པས་ཐ་དད་བྱས་པ་ཡིན།",
    "གང་རང་བདག་ཉིད་འཇུག་པ་ལ།",
    "རང་རང་གཙོ་བོ་ལ་གནས་ཕྱིར།",
    "དེའི་ཚེ་དེ་ཡང་རང་རིག་པའི་ཁྱད་པར་གཞན་ལས་ཁྱད་པར་དུ་གྱུར་པ་ཡིན་ཞིང་།",
    "དེ་ཁས་བླངས་ནས་རྒོལ་བ་ནི་སྤོབས་པ་མེད་པས་མི་སྨྲ་བར་འདུག་པའི་ཕྱིར་རམ།",
    "གྲུབ་པ་ཡང་རང་ཡོད་ན་དེ་ཡོད་པར་སྒྲུབ་པར་བྱེད་པ་ནི།",
