    "དམག་ནང་འདུག་དང་གནས་ངན་ལེན་འཆབ་པ་སྟེ།",
    "འོད་སྲུང་ཆེན་པོ་བདེ་ཆེན་གྱི་ཕུག་ན་གསོ་སྦྱོང་གཅིག་པའི་གནས་ཀྱི་སྡོམ་པས་འདུག་གོ།",
    "ཚོང་ཁང་ལ་འདུག་སྟེགས་དང་།",
    "ཤིང་རྟ་ལ་ཁ་ལོ་པ་འདུག་པ་དང་།",
    "གྲུ་ལ་གྲུ་པ་འདུག་པ་དང་།",
    "བྱ་གག་སྤུར་ནས་འདུག་པ་ཚུན་དང་།",
    "འདི་ལ་གཞི་ཉེ་དུ་མ་ཡིན་པའི་ཁྱིམ་པ་དང་རང་དོན་ཚེདུ་ལྷན་ཅིག་སྤྱོད་པ།",
    "ལྷུང་བཟེད་མེད་ཀྱང་རང་ལ་ལྷུང་བཟེད་ཀྱི་རིན་ཡོད་བཞིན་དུ་སློང་བར་བྱེད་ན་སྦྱོར་བ་དང་།",
    "ཉེ་དགའ་སྒོ་ན་འདུག་པས་དྲིས་ཏེ།",
    "རྒྱ་ཞེ་བཞི་ཁུར་ཡང་ཅི་འདུག་བལྟ་ཟེར་ནས་རྙེད་པ་ཡང་བགོས་སོ།",
    "མཉན་ཡོད་དུ་དབྱར་ཕྱི་མ་ཁས་བླངས་ཏེ་འདུག་གོ།",
    "ཞག་དྲུག་ལས་ཧ་ཅང་འདའ་བར་བྱའོ་སྙམ་པའི་བརྣག་པས་ཞག་དྲུག་སྦྲི་སྡོམ་གསུམ་ཚུན་འདུག་པ་ལ་ཡང་ཉེས་པ་མེད་དེ།",
    "གོས་བྱིན་དོན་མཐུན་གྲུར་འཇུག་གཅིག་འདུག་འགྲེང་།",
    "སྦྱོར་བཅུག་ཡང་ཡང་འདུག་གནས་ལྷག་སྨྲོ་པར་ལེན།",
    "འདུག་འགྲེང་གཅེར་བུ་དམག་བལྟ་ནང་དུ་གནས།",
    "སྒྲ་གཅན་འཛིན་ཆུ་དྲོན་ཅན་གྱི་ཀུན་དགའ་ར་བ་ན་འདུག་པ་ལ།",
    "ཕྱིས་དེ་དག་ལ་འདི་དང་འདི་གྱིས་ཤིག་ཅིའི་ཕྱིར་ཁྱེད་རང་མི་བྱེད།",
    "དེ་གཉིས་ཉེ་དགའ་དང་གཏམ་ཟེར་གྱི་འདུག་པ་དང་།",
    "ཆར་པ་བར་སྣང་ལ་ཆུ་ལོན་ལྟ་བུར་འདུག་གནས་མལ་སྐྱབས་ཡོད་པར་བྲུབས་ནས་རས་ཆེན་བསྣམས་ནས་བང་རིམ་ན་བཞུགས་སོ།",
    "མ་བརྗེད་པར་བློ་མངོན་དུ་བཏང་ནས་གནས་མལ་འདུག་པའི་ཕྱོགས་ནས་སམ།",
    "གང་ཟག་གཞན་འདུག་པའི་བར་ཕན་ཕུན་དུ་གྱུར་ན་ཡང་།",
    "གཏོང་བའི་དུས་ལས་གཞན་འཆག་པའི་ཚེ་སྣ་དེ་དག་ལ་སྲོག་ཆགས་འདུག་མེད་དུས་དུས་སུ་བརྟགས་ནས་སྲོག་ཆགས་མི་སྐྱེ་བར་བྱ་བའི་ས་ཆགས་དད་པ་ས་ལས་རྣམ་རབས་ལམ་ནས་གསལ་གསལ་།",
    "དེ་དག་དང་ལྷན་ཅིག་རི་བྲགས་འདི་སུའི་སོགས་འདུ་འཛིའི་གཏམ་གྱིས་འདུག་གོ།",
    "སྦྱོར་བ་ལྗིད་ཀྱིས་ཕབ་སྟེ་འདུག་གམ་ཉལ་བ།",
    "སྦེད་མས་སྟན་ལ་བཞུགས་ཤིག་འཆར་ཀ་ཁ་ནང་དུ་བལྟས་ཏེ་འདུག་སྦེད་མ་ཁ་ཕྱིར་བལྟས་ཏེ་འདུག་ནས།",
    "དབྱར་ཁང་ཕྱག་བདར་ལས་ཁྱེད་དོང་ནས་ས་ལ་མ་འདུག་གོ།",
    "ཉེ་དགའ་སྒོ་ན་འདུག་པས་ཐོས་ནས།",
    "གཅེར་བུ་པ་དེས་འདི་ཁྱེད་ཀྱི་གཙུག་ལག་ཁང་མ་ཡིན་ན་གར་འཇུག་དེ་སྐད་མ་ཟེར་ཅིག་འདུག་ན་འདུག་ཏུ་ཟད།",
    "མི་འདུག་ན་མཚམས་ཆེན་པོ་གཅད་དོ།",
    "སྡོམ་གསུམ་ཁྱིམ་བདག་ལ་ཁྱེད་རང་དབུས་སུ་གནས་གནས་པ་ཡིན་ནོ་ཟེར་ནས།",
    "དགེ་སློང་ཟས་ཟོས་ཟིན་ཅིང་སོར་འགྲེལ་སྤངས་ལ་སྤྱོད་ལམ་ལས་མ་ཉམས་པ་གང་ཡིན་པ་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "ལྔས་འདུག་ཅིང་ཟ་བར་གནང་སྟེ་ཞེས་སོ།",
    "མདངས་ཡོད་ཀྱི་བར་ཀློག་ནས་འདུག་གོ།",
    "བཙོ་བོར་བྱ་བ་སྣོད་རུང་བ་མ་ཡིན་པའི་ཕྱོགས་ན་འདུག་ཀྱང་རུང་།",
    "འབྲས་བུ་རང་བྲུལ་བ་སྐྱེ་ནིཊྛབའི་རྒྱུན་དང་མ་འབྲེལ་བ་རུང་བའི་ས་ན་འདུག་ཀྱང་རུང་སྟེ།",
    "བརྣག་པས་ཉལ་པོར་ཤོམ་ཁྱིམ་འདུག་པ་དང་།",
    "མཐར་ཐུག་མ་དྲིས་པས་བརྣག་པར་མཐོང་ཐོས་ཀྱི་སྤྱོད་ཚེཡུལ་གྱི་མཐའ་ཚུན་ཆད་དུ་འདུག་པ་སྟེ།",
    "མིག་ལམ་ན་འདུག་ཅིག་ཟེར་ནས་འཁུར་བ་བྱིན་ནས་སློང་ཕོར་བཀང་བས་ཕྱིར་བྱུང་བ་དང་།",
    "དེ་དག་མེད་པར་དེར་ཉིན་མཚན་གཉིས་ལས་ལྷག་པར་འདུག་ནའོ།",
    "རི་བྲགས་པ་མ་ཕེབས་ནས་རྒྱལ་པོས་དེ་ཉིད་དུ་ཕྲུ་མ་བཏབ་སྟེ་འདུག་པ་དང་།",
    "འདི་ཚང་ན་དམག་ནང་ན་འདུག་པའི་ལྟུང་ཟླ་བྱེད་དུ་འགྱུར་རོ།",
    "འདུན་པ་ཀོའུ་ཤམ་བི་ན་ཡིད་ངལ་དུ་འདུག་ནབས་སོ་འགྲོ་མགྱོགས་ཤི་ནས་ཚོགས་ན་དགའ་བོ་ཉེ་དགའ་གཉིས་འདུག་པགོ།",
    "དེས་ད་དུང་གནོད་དོ་སྙམ་ནས་བྱིན་ཏེ་ཡིད་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "གླུ་། བྲོའི་ཆས་འདུག་པ་ཁྲུས་བྱའམ་གླུ་བླང་།",
    "མཐར་ཐུག་དུས་དེ་ཉིད་དུའམ་གཞན་གྱི་ཚེ་ཤི་བ་སྟེ།",
    "དེ་དག་ཡིད་ཁོང་དུ་ཆུད་ཅིང་འདུག་སློབ་དཔོན་དེ་འོངས་ནས་ཚེཅིའི་ཕྱིར་ཡིད་ཁོང་དུ་ཆུད།",
    "དེ་དེར་འདུག་པ་དང་ཆུ་ཁྱེར་ཏེ་ཞབས་བཀྲུ་བར་བགྱིའོ།",
    "འདུན་པ་ཀོའུ་ཤམ་བིར་སྙོམས་ལས་སུ་འདུག་ནབས་སོ་འགྲོ་མགྱོགས་ཤི་དགའ་བོ་ཉེ་དགའ་གཉིས་ཚོགས་ན་འདུག་པ་དང་།",
    "མཛའ་བོ་དང་ས་ལས་སྐྱེས་གཉིས་ཕྱག་དར་ཁྲོད་ཀྱི་གོས་བཀྲུས་ཏེ་ཉི་མ་ལ་བཏིངས་ཏེ་འདུག་པ་དང་།",
    "གླེང་བ་པོས་རྒན་པའི་མཐར་འདུག་ནས།",
    "ཞེས་རྩོད་པ་ཉེ་བར་ཞི་བའི་ཕྱིར་སྤོང་བའི་ཁང་པར་འདུག་ཅིང་འདུན་པ་ན།",
    "སྟན་ནི་ཁྱེད་ཁོ་ནའི་དོན་དུ་བཤམས་པ་ལགས་ཀྱིས་བཞུགས་ཤིག་དེ་ཉིད་ཅི་བདེར་བྱས་པ་ཡིན་གྱིས་འདུག་ཅིག་ཟེར་ནས་སྦྲི་སྡོམ་གསུམ་ཀུན་དགའ་བོ་ཁྱིམ་བདག་ལ་གདུགས་ཚོད་ལ་བབ་ཏུ་ཉེ་བས་ཞལ་ཟས་བྲིམས་ཤིག་ཅེས་བསྒོ་ཞིག་བསྒོ་བས།",
    "ཉེ་སོར་འགྲེལ་དགའ་ངོ་ཚ་ནས་དེ་ཉིད་དུ་འདུག་གོ།",
    "བ་སོ་མཁན་ཞིག་འདུག་པ་དང་།",
