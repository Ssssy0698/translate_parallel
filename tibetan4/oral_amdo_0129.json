    "ཡུལ་སྟོང་གཟུགས་ཕྱག་རྒྱ་ཆེན་མོའི་ངོ་བོ་ངོས་འཛིན།",
    "སེམས་དང་སེམས་བྱུང་ལ་ནི་བདག་གི་འཁྱུད་དེ་འགྲོ་བ་དུ་མའི་གཟུགས་ཅན་དེ་ནི་གཅིག་པུའོ།",
    "རྣམ་པ་འགྱུར་བ་མེད་ཅིང་མཁའ་མཉམ་མུན་བཅོམ་ཁྱབ་བྱེད་རྣལ་འབྱོར་ངག་གི་བགྲོད་བྱ་ཐེར་ཟུག་གནས།",
    "རྣམ་པ་ཀུན་ལྡན་མཐའ་དག་ཐིག་ལེ་མཆོག་གི་རྒྱལ་བའི་བདག་པོ་སྣ་ཚོགས་སྒྱུ་མ་འཛིན་པ་འདི་ལའོ།",
    "ཕྱག་རྒྱ་ཆེན་མོ་དེ་ལ་འདུད་ ཞེས་སོགས་དང་།",
    "དེ་བཞིན་དུ་གཞན་ནང་གི་རིག་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་མ་རང་བཞིན་གྱིས་འོད་གསལ་བ་ཕྱག་རྒྱ་ཆེན་མོ་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བའི་གཟུགས་ཅན་མ།",
    "སྤྲོ་བྱེད་ནུས་པའི་ངོ་བོའི་མིང་ཅན་གཞིའི་བདེན་དོན་རྣམ་པ་བཅུ་གཉིས་པ་རྡོ་རྗེ་ཉི་མ་སྣང་བ་ཆེའི་བདག་ཉིད་སྟོང་གཟུགས་བཞིན་ལག་གི་རྣམ་པ་ཅན་དུ་གདོད་མ་ནས་བཞུགས་པའི་རྐྱེན་གྱིས་གསར་དུ་འདུས་མ་བྱས་པ་དེ་ཉིད་རྐྱེན་ཟབ་ལམ་རྡོ་རྗེའི་རྣལ་འབྱོར་གྱིས་དྲི་མ་སྦྱངས་པས་མངོན་དུ་གྱུར་པ།",
    "ངོ་བོ་བདེ་ཆེན་ཉིད་དེར་ཤར་བ་ཡིན་གྱི་མ་དག་ལས་སྣང་གི་གཟུང་འཛིན་བཞིན་དུ་ཡུལ་དང་ཡུལ་ཅན་དུ་མ་གྲུབ་ཅིང་།",
    "ཀུན་ཏུ་འགྲོ་ཡང་རྣལ་འབྱོར་པ་རང་སྣང་བ་རང་ཉིད་ཡབ་ཡུམ་ཞལ་སྦྱོར་གྱི་རྣམ་པར་ལྟེ་བར་ལངས་ནས་འགྱུར་མེད་ཀྱི་བདེ་ཆེན་སྦྱིན་པར་མཛད་པའི་ཡུམ་ཆེན་མོ་ཤེར་ཕྱིན་ནོ།",
    "དེས་ན་འདི་འདྲའི་སྣང་བ་འདི་དེང་སང་ཁ་ཅིག་ཚད་གྲུབ་ཏུ་འདོད་པའི་སྔོ་སོགས་ཀྱི་སྣང་བ་མ་འགག་ན་མཐོང་མི་སྲིད་པའི་ཡང་དག་ཀུན་རྫོབ་ཡིན་པས་འདི་སྣང་བའི་ཡེ་ཤེས་ལ་གཉིས་སྣང་གི་དྲི་མ་དང་བདེན་སྣང་བདེན་འཛིན་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "རིགས་རྒྱུ་ཡན་ལག་དང་པོ་བཞི་དང་ལས་ཡེའི་ཕྱག་རྒྱ་ལ་ཡང་བརྟེན་མོད་ཀྱི་དངོས་རྒྱུ་སྟོང་གཟུགས་ཕྱག་ཆེན་ཁོ་ན་ལས་གྲུབ་པ།",
    "ཆགས་དང་ཆགས་བྲལ་མཐའ་ཐོག་ལ་གནས་སྐད་ཅིག་མ་ཡང་ཁྱབ་བདག་གི་ནི་དབུགས་ཀྱི་གྲངས་འཕེལ་ལོ།",
    "གསང་བར་རྡོ་རྗེ་ནོར་བུའི་རྩེ་མོ་ལས་སྐད་ཅིག་མ་བརྒྱ་ཕྲག་སུམ་ཅུ་རྩ་དྲུག་རྣམས་ཀྱིས་འཕེལ་ཏེ།",
    "གསང་བར་རྡོ་རྗེ་ནོར་བུའི་རྩེ་མོ་ལས་ཅེས་པའི་ལུང་ལ་དངོས་སུ་འགོངས་ཤིང་།",
    "དེ་བཞིན་དུ་ཉོན་མོངས་བདུད་རྣམས་བཅོམ་བྱས་ནས་རྫུ་འཕྲུལ་དང་ཀུན་མཁྱེན་གྱི་ས་བཅུ་གཉིས་འཆད་པར་འགྱུར་བ་རྣམས་དང་།",
    "དེ་བཞིན་དུ་སྟོང་གཟུགས་ལྡང་པ་ནོར་བུའི་རྩེར་མོ་མཛད་པ་ལ་ཡང་།",
    "མོས་པ་ཡིད་བྱེད་དུ་གསལ་བར་གསུངས་ལ།",
    "ཞེས་པའི་དང་པོ་གཉིས་རིམ་བཞིན་སོར་བསམ་སོ་སོ་དང་དེ་ནས་སྲོག་འཛིན་ལ་གཅིག་དང་དྲན་ཏིང་ལ་རེ་རེ་སྦྱར་བར་བྱ་བ་ཡིན་ལ།",
    "བྱང་སེམས་དག་པ་ས་གསུམ་ལ་སྦྱོར་ཞིང་སྦྱོར་དྲུག་དང་སྒྲིག་པ་ཤ་སྟག་གི་ངང་ལ་སྔོན་ཆད་འདས་པ་ཡང་དོན་གྱིས་བཀག་ཟིན་ཏོ།",
    "འོ་ན་གཉེན་པོ་ཕྲ་རིམ་ཆུང་རིམ་ནས་སྐྱེ་བ་རིགས་མོད་ཀྱི་སྤང་བྱ་རགས་རིམ་ནས་འགག་དགོས་པ་ལ་ཕྲ་རིམ་དུ་བྱུང་བ་ཅིི་ཞེ་ན།",
    "རིགས་གཞན་ལས་བྱུང་ཕོ་ཉ་མོ།",
    "ཡི་མོའི་སྤྱོད་པ་ལེགས་པར་བསྲུབ།",
    "ཞེས་གསུངས་པས་དྲང་ངེས་རེ་རེ་ཡང་བརྒྱད་བརྒྱད་དེ།",
    "ལམ་ཐུན་མོང་བ་བསྟེན་པ་དང་།",
    "སྐལ་བ་ཆེས་མཆོག་ཏུ་འགྱུར་པའི་གང་ཟག་གིས་བགྲོད་པར་བྱ་བ།",
    "ཐུགས་མི་འགྱུར་བའི་བདེ་ཆེན་དང་སྐུ་སྟོང་གཟུགས་ཕྱག་རྒྱ་ཆེན་མོའི་ལམ་གཉིས་སུ་འདུས་ཏེ།",
    "མ་ནིང་གི་ནི་གོ་འཕང་མཆོག་ཅེས་གསུངས་པས་སོ།",
    "རེ་རེ་ཡང་ཕན་ཚུན་ལེགས་པར་རྒྱས་གཏབ་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་གྱི་སྡུག་བསྔལ་མི་འགོག་པར་རང་རྒྱུད་ཀྱི་ཉོན་མོངས་ཙམ་འགོག་པ་ཡིན་ལ།",
    "འདི་གཉིས་མེད་པར་ལམ་གཞན་གྱིས་མཐའ་ཐུག་གི་འབྲས་བུ་མི་འགྲུབ་པའི་ཚུལ་ནི་སྤྱི་དོན་མཇུག་ཏུ་བཀོད་ཟིན་ཏོ།",
    "ས་བཅུ་གཉིས་ཀྱི་བྱང་སེམས་ལ་ཐུན་མོང་དང་ཐུན་མོང་མིན་པའི་ལོངས་སྐུར་སྣང་བའོ།",
    "ཟླ་བ་ཉི་མའི་གཟུགས་ནི་ཟོས་ན་མཁའ་ལ་ཉིན་མཚན་དང་ནི་མཚན་མོ་ནམ་ཡང་མིན་པ་ཉིད།",
    "ཞེས་ཉིན་མོའི་དམར་ལམ་དང་མཚན་མོ་ཟླ་བའི་དཀར་ལམ་དང་ཐུན་མཚམས་ཀྱི་མུན་ནག་གང་ཡང་མིན་པའི་ཐོ་རེངས་ཀྱི་དུས་ཀྱི་ཐུན་མཚམས་སུ།",
    "གནམ་གང་ལ་ཉི་ཟླ་རོ་མཉམ་དུ་སོང་པ་བཞིན་དུ་སྲོག་ཐུར་རོ་མཉམ་དུ་འགགས་ནས་དགའ་བ་ཆ་བཅས་ལྔ་རྫོགས་པའི་བཅུ་དྲུག་པའི་དུས་སུའོ།",
    "དེ་ཡི་དུས་སུ་རྣལ་འབྱོར་པ་དེ་གང་ལ་གཉིས་ནི་ཅུང་ཟད་མེད་པ་མཆོག་གི་གོ་འཕང་འགྲོ།",
    "དེ་ཡི་འདོད་པའི་དངོས་གྲུབ་རི་བོང་ཅན་གྱི་ཞག་གི་ཐོ་རེངས་དང་ནི་མཚན་མོ་ཕྱེད་ལ་འགྱུར།",
    "ཉུང་འདུས་ཚིག་གི་གསལ་བར་བཀོད་པ་ལ།",
    "བདེ་སྟོང་མཆོག་གི་གླུ་གར་རྩེད་འཇོ་ཡིས།",
    "ན་མོ་མཉྫུ་ཤྲཱི་ཡེ།",
    "ཟབ་ལམ་རྡོ་རྗེའི་རྣལ་འབྱོར་གྱི་འཇུག་གི་ཡན་ལག་གེགས་སེལ་རྣམ་གྲོལ་རོལ་མཚོ་ཞེས་བྱ་བ།",
    "བར་ཆད་ཕྲ་མོ་སྨོས་ཀྱང་ཅི་འཚལ་བའི།",
