    "ཁ་དོག་རང་རང་གི་རྩ་འཁོར་ལྟ་བུ།",
    "ཡུངས་ཀར་སྦོམ་པོའི་ཚད་ཙམ་མོ།",
    "ནམ་མཁའ་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་སྲན་མ་ཕྱེད་ཤགས་ཙམ་གྱི་སྟེང་དུ་བྱ་ཞིང་རྒྱལ་བ་རིགས་དྲུག་གི་ངོ་བོར་སྒོམ་གྱི།",
    "སྔ་མ་མ་བསྟན་གྱི་བར་དུ་ཕྱི་མ་མི་སྒོམ་མོ།",
    "ལྟེ་བར་སྲོག་ཐུར་འདྲེས་ནས་གཏུམ་མོ་འབར་བས།",
    "ལྟེ་བར་བུམ་པ་ཅན་སྒོམས་པས་ལྕེ་ཆུང་གི་བདུད་རྩི་འཛག་ནས་ཁ་འཆིལ་མས་གང་བ་འབྱུང་།",
    "ན་མོ་མཉྫུ་གྷོ་ཥཱ་ཡ།",
    "རྣམ་གསུམ་ཕྱག་རྒྱ་མཆོག་གི་ཉིན་བྱེད་ཀྱི་ དགའ་བཞིའི་ཆུ་སྐྱེས་ལྷག་པར་བྱས་པ་ལ།",
    "དེས་ན་སྔ་མ་སྟོང་གཟུགས་མཐོང་བའི་གཏུམ་མོའི་གཟུགས་སྣང་ཕལ་པ་དང་ཕྱག་རྒྱ་དྲན་པའི་བདེ་བ་ཙམ་དུ་འདོད་པ་དང་ཕྱི་མ་མས་བརྟན་ཡིན་པ་དང་།",
    "སྔ་མས་སྟོང་གཟུགས་མཚན་ཉིད་པ་དང་པོར་སྒྲུབ་ཚུལ་གཞུང་གཞན་ན་ཧ་ཅང་མི་གསལ་བའི་རྐྱེན་གྱིས་བོད་དག་གིས་ད་དུང་མ་མཐོང་ཞིང་།",
    "དེ་ནས་ལྷའི་གཟུགས་བརྙན་སྒྲུབ་པ་ལ་ཞེས་པ་འཛིན་པའི་སྟོབས་ཀྱིས་ལྟེ་བའི་གནས་སུ་གཏུམ་མོ་འབར་བ་རྣལ་འབྱོར་པས་མཐོང་སྟེ།",
    "མཐར་གང་གི་འཇུག་ཏུ་མས་བརྟན་ཐིག་ལེ་དང་བདེ་བ་འགྱུར་མེད་ཀྱི་སྐད་ཅིག་འདྲེན་ནུས་པ།",
    "སྔ་གོང་གི་རྣམས་ཀྱང་ཕལ་པའོ།",
    "དང་པོ་ལ་ཡང་རྣམ་གཞག་དྲུག་གི་མཚན་དོན་ནི།",
    "རྣལ་འབྱོར་གྱི་གཏུམ་མོ་དང་ཏིང་ངེ་འཛིན་གྱི་ཕྱག་རྒྱའམ་གཏུམ་མོ་གཉིས་སུ་མཛད་པའི་ནང་གི་སྲོག་རྩོལ་ཞེས་གསང་འདུས་པ་ལས་གྲགས་པ།",
    "གློག་གི་དབྱུག་པའི་རྗེས་མཐུན་འཕོ་མེད་བདེ་བ་བསྐྱེད་པར་བྱེད་མ་མཚན་ཉིད་དང་ཡན་ལག་ཡོངས་སུ་རྫོགས།",
    "ཞེས་པ་ནང་གི་གཏུམ་མོ་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཉིད་ལ་མཛད་འདུག་པ་འདི་འཐད་པའི་ཕྱིར་རོ།",
    "གཏུམ་མོ་དམ་རྒྱ་གང་རུང་།",
    "གཉིས་པ་ལ་ཕྱག་རྒྱ་བཞི་པོ་གང་ལ་བརྟེན་ཀྱང་ངེས་པ་དྲུག་གི་དང་པོ་གཉིས།",
    "འཕྲུལ་འཁོར་གྱིས་ལུས་ལ་ཁྱབ་པར་བྱ་བ་རྣམས་ཁྱད་མེད་དུ་བྱ་ཞིང་དམ་ཚིག་གི་ཕྱག་རྒྱ་ལ་བརྟེན་པ་ནི།",
    "ལྟེ་བའི་རྩ་འདབ་བདུན་ཅུ་རྩ་གཉིས་ཀྱི་རྩེ་མོ་ན་ཞུགས་པའི་ཧོ་ཡིག་ཡེ་ཤེས་རྡོ་རྗེའི་རང་བཞིན་ཞེས་སོགས་ཐིག་ལེའི་རྣལ་འབྱོར་ཇི་བཞིན་དུ་འབར་ནས་དགའ་བཞི་འདྲེན་པ་སྟེ།",
    "འདི་ནི་བཞིན་ལག་གི་རྣམ་པ་ཅན་ལ་མ་བརྟེན་པར་ནང་གི་གཏུམ་མོ་ཁོ་ནས་བདེ་ཆེན་འདྲེན་པའོ།",
    "རྗེས་མཐུན་པ་ནི་ཡེ་རྒྱ་ལ་རྟེན་ནས་ཡིད་ངོར་བདེ་བ་རྗེས་མཐུན་པ་བསྐྱེད་པ་དང་མོས་པར་བྱེད་པ་ཙམ་དུ་ཟད་པས།",
    "དེ་དག་གི་ཡང་རྩ་བ་སྔོན་འགྲོ་ལ་འབད་པར་བྱའི།",
    "གཏུམ་མོ་དང་།",
    "ཕྱག་རྒྱ་ཆེན་མོའི་སྤོགས་ཆོག་ནི།",
    "དེའི་ཚེ་པདྨ་རྡོ་རྗེའི་སྒྲའམ་ཞེས་པ་དལ་བུ་དག་གིས་བྱ་ཞེས་དང་།",
    "རང་གི་ལག་པ་དག་གིས་གསོར་བ་བདེ་བའི་སླད་དུ་སྟེ།",
    "ལམ་འདིའི་ཡན་ལག་གི་གཙོ་བོ་ལུས་ལ་དཀའ་ཐུབ་ཀྱིས་མི་གདུང་།",
    "སོར་མོ་བསྐུམ་ཉ་བཞི་སྒྲིལ།",
    "གཞན་དུ་དེ་དག་གི་དྭངས་མར་མ་ཟད་ཟླ་བའི་དྭངས་ཀྱང་འཆོར་བའི་ཕྱིར་རོ།",
    "སོ་སྐྱེའི་ལམ་དུ་གསུངས་ཤིང་རིགས་པས་ཐོབ་པར་ལྟར་རང་རེ་རྣམས་ཀྱང་བཞེད་པ་དང་འགལ་བས།",
    "ཕྱིར་ལྟས་གཞན་རིག་གི་རིག་ཚུལ་དང་མི་མཐུན་པར་བདེ་བ་ནང་དུ་མྱོང་ཞིང་སྟོང་གཟུགས་ནང་དུ་མཐོང་ལ་རྣལ་འབྱོར་པ་སོ་སོར་རང་གི་རིག་པས་རང་རིག་མངོན་སུམ་དུ་ཁོ་བོ་སྨྲའོ།",
    "ལྟེ་བའི་ནང་གི་ལ་དགོངས་ལ།",
    "ཀྱང་གི་སྒྲས་བ་སྤུའི་ཁུང་བུ་ནས་འོད་ཟེར་ལྔ་འཕྲོ་ཞིང་ངེས་པར་རྒྱུའོ་ཞེས་གསུངས་པ་དང་།",
    "གཉིས་པ་ཏིང་ངེ་འཛིན་ལ་ཡང་རྣམ་གཞག་དྲུག་གི་དང་པོ་མཚན་དོན་ནི།",
    "འབྲིང་གི་སྲོག་རྩོལ་སོགས་སོ།",
    "ཐ་མ་རེ་རེ་ཡང་རྩོལ་བཅས་སུ་བསྒོམ་དགོས་པ་གསུམ་ལས་འཁྲུངས་པའི་ཏིང་ངེ་འཛིན་གསུམ་མོ།",
    "ཕྱི་ནང་གི་ཐབས་གཉིས་ཀྱི་སྒྲུབ་ཅིང་དེ་ཡང་དྲང་དོན་བསྐྱེད་རིམ་ལ་ཁྲོ་བོ་ཤིན་ཏུ་སྟོབས་དང་།",
    "དེས་ན་མཁས་པ་དག་གིས་སྐབས་འདིའི་ཡས་བབས་དགའ་བཞིའི་དགའ་བ་དང་པོ་གསུམ་རྗེས་དྲན་དངོས་དང་།",
    "དེ་རྗེས་ཏིང་ངེ་འཛིན་དངོས་སུ་འགྲོ་བའི་མས་བརྟན་ནི་བསྐྱེད་རིམ་ལ་སྤྱན་སོགས་བཞི་དང་ཐུན་མོང་དུ་ཞུ་བ་གླུས་བསྐུལ་བའི་ངེས་དོན།",
    "དེའི་རྐྱེན་གྱིས་ཁམས་དྭངས་མའི་དྭངས་མ་ནི་ནོར་བུའི་རྩེ་ནས་སྟེང་དུ་རིམ་པ་བཞིན་བརྟན་ཞིང་གཡོ་མེད་དུ་གྱུར་པ་ལ་བརྟེན་པའི་འགྱུར་མེད་བདེ་བའི་སྐད་ཅིག་ཉི་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱ་རྣམས་རིམ་གྱི་རྫོགས་པར་འགྱུར་བར་འཕགས་པའི་མཉམ་གཞག་འགྲུབ་ཚུལ་ཡིན་པས་ལས་དང་པོ་པ་དག་གིས་ནི་མོས་པར་བྱ་བ་ཙམ་དུ་ཟད་དོ།",
    "ལུས་སེམས་མཐའ་དག་རྟག་ཏུ་བདེ་སྟོང་གིས་ཁྱབ་པར་སྣང་བ་སོགས་དང་།",
    "ས་རེ་རེ་ཞིང་བརྒྱ་འགྱུར་སྟོང་འགྱུར་སོགས་གསུངས་ན་འདིར་ལྟ་ཅི་སྨོས།",
    "འོག་མ་འོག་མའི་བསམ་སྦྱོར་དང་ཡོན་ཏན་ཐུན་མོང་རྣམས་རྗེས་ཐོབ་དུ་གསོ་ཞིང་འཕེལ་བར་བྱེད་པ་ཡིན་པས།",
    "མོས་གུས་སོགས་ཀྱི་བསག་སྦྱང་ནི་གནས་སྐབས་ཀུན་གྱི་སྤོགས་ཆོག་ཏུ་ཤེས་པར་བྱ་ཡི།",
    "ལམ་མཐོན་པོར་སླེབ་ནས་འོག་མ་ལ་སྤོང་སེམས་བྱེད་པ་དག་གིས་ནི་ཡོན་ཏན་ཡར་ལྡན་དུ་སྐྱེད་པའི་དོན་མ་རྟོགས་སོ།",
    "རང་རང་གི་ཐུང་མོང་མིན་པའི་བསམ་སྦྱོར་དང་དྲི་མ་དང་འདྲེས་པ་ལ་དགོངས་པས་གཉིས་ཀ་མི་འགལ་ལོ།",
    "མཁས་པ་དག་སྐྱེ་བ་བདུན་ལ་སོགས་པ་དགོས་པར་ཡང་བཞེད་མོད།",
    "སྟོང་བརྒྱད་བརྒྱ་པ་ཕྲག་གཅིག་གིས་རྡོ་རྗེའི་སྐྱེད་པར་བརྟན།",
    "ཐུན་མོང་མིན་པའི་སྤང་བྱ་ཉི་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱ་སྤངས་པས་ལམ་མཐའ་དག་དང་མཐའ་དག་ལ་ལྟོས་པའི་སྒྲིབ་པ་གསུམ་ཀ་སྤང་ཤིང་།",
    "སོ་སོ་རང་རང་གིས་རིག་པ་རྣལ་འབྱོར་པའི་ཡེ་ཤེས་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའི་སའོ།",
    "ཞེས་གསུངས་པ་ལྟར་སྤང་བྱའི་ས་བོན་སྤོང་ཞིང་འཕགས་རྒྱུད་ཀྱི་མཉམ་གཞག་ཡེ་ཤེས་ཡིན་པར་རྣལ་འབྱོར་མངོན་སུམ་མོ།",
    "དེ་ལྟར་ན་སྦྱོར་བ་ཡན་ལག་དྲུག་གི་རེ་རེ་ཡང་རྣམ་གཞག་དྲུག་གི་སྒོ་ནས་ངོ་བོ་ཡོངས་སུ་རྫོགས་པར་ཉམས་སུ་ལེན་ཚུལ།",
    "རིགས་པ་དང་ལུང་རྒྱས་པའི་ཤེས་བྱེད་རེ་ཤིག་བཞག་ནས་ཉམས་ལེན་གྱི་མན་ངག་དངོས་ཤིན་ཏུ་གསལ་ཞིང་འདུས་པར་བརྗོད་པ་དེ།",
    "བཙན་ཐབས་དང་གེགས་སེལ་གྱི་མན་ངག་ཡལ་ག་ཕྲ་མོ་ལྟ་བུ་རྣམས་ཟུར་དུ་བརྗོད་ཅིང་།",
    "ཕྱག་རྒྱ་བརྟག་ཐབས་ཚོགས་འཁོར་རྒྱས་པ་སོགས་ནི་དེའི་ཐད་ཀྱི་རྒྱུད་འགྲེལ་དང་དེ་དག་གི་དོན་མཐའ་དཔྱོད་ཆེན་པོ་བསྟན་པའི་རྒྱ་མཚོར་བྲིས་ཟིན་པས་དེར་ལེགས་པར་ལྟ་བར་བྱའོ།",
    "འགྲན་ཟླ་དང་བྲལ་བ་སྦྱོར་བ་ཡན་ལག་དྲུག་གི་ཁྲིད་ཡིག་གཞན་ལས་ཆེས་མཆོག་དུ་གྱུར་པ་བརྗོད་པ་འདི།",
    "མངྒལཾ། ། སྦྱོར་དྲུག་གི་ངོ་སྤྲོད་ཡིད་ཀྱི་རོལ་མཚོ་བཞུགས།",
    "ན་མོ་མཉྫུ་ཤྲཱི་ཡེ།",
    "དཔལ་དུས་ཀྱི་འཁོར་ལོའི་རྫོགས་རིམ་སྦྱོར་བ་ཡན་ལག་དྲུག་གི་ངོ་སྤྲོད་ཡིད་ཀྱི་རོལ་མཚོ་ཞེས་བྱ་བ།",
