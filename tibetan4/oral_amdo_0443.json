    "ཇི་སྟེ་རུང་ན་ནི་ཧ་ཅང་ཐལ་བའི་སྐྱོན་དུ་འགྱུར་རོ་ཞེ་ན།",
    "ཧ་ཅང་ཡང་ཐལ་བའི་ཕྱིར་མི་རུང་ངོ།",
    "དེ་ལྟ་ན་ནི་གཞན་གྱི་སེམས་ཀྱི་རྒྱུད་ལ་ཡོད་པའི་ལས་འདིའི་འབྲས་བུ་འདི་ཡིན་ནོ་ཞེས་བྱ་བར་རིག་པ་མེད་པས་ཐམས་ཅད་མཁྱེན་པ་དག་གིས་ཀྱང་རྟོགས་པར་མི་སྤྱོད་དེ།",
    "རིག་པའི་ཡུལ་ནི་རང་གི་ངོ་བོ་ཙམ་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་གིས་འདི་ལྟ་བུར་རྟོགས་པའི་རྣམ་པ་གཞན་ནི་མེད་དོ།",
    "དེས་ན་ཐམས་ཅད་མཁྱེན་དེས་ཀྱང་ཞེས་བྱ་བའི་ཀྱང་གི་སྒྲ་ནི་གཞན་ཉི་ཚེ་མ་ཡིན་ནོ།",
    "ཡང་གི་སྒྲ་ནི་མཐའ་དག་ཀྱང་མ་ཡིན་པའོ།",
    "གང་དག་གི་ཞེ་ན།",
    "གཅིག་གིས་དུ་མའི་དངོས་མི་བྱེད།",
    "གཅིག་གིས་གཅིག་བྱེད་པ་ཡང་མིན།",
    "ལྟོས་ན་ནི་དངོས་པོ་རྣམས་རེས་འགའ་བ་ཉིད་ཡིན་པར་སྲིད་དོ།",
    "གང་གི་ཕྱིར་འདི་ཉིད་འབྲས་བུ་བསྒྲུབ་པའི་མཐུའི་བྱེ་བྲག་དང་ལྡན་པ་མྱོང་བར་བྱེད་དོ།",
    "དེའི་ཕྱིར་ཁྱོད་མངོན་སུམ་ལ་སོགས་པ་དང་འགལ་བ་དང་ཤིན་ཏུ་ལྡན་པར་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་རྒྱུ་དུ་མས་དུ་མ་བྱེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེའི་ཕྱིར་རང་གི་ངོ་བོ་ཉིད་ཇི་ལྟ་བུ་། བྱེ་བྲག་གིས་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དེའི་ཕྱིར་འདི་ལྟར་མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་གྱི་རྣམ་པར་ཤེས་པ་ལས་ནི་མིག་གི་རྣམ་པར་ཤེས་པ་རྟོགས་པའི་བདག་ཉིད་དུ་འགྱུར་རོ།",
    "རྒྱུ་རྣམས་ཀྱི་ངོ་བོ་ཉིད་ཐ་དད་པ་དག་གིས་ངོ་བོ་ཉིད་ཐ་དད་པ་ཁོ་ནར་འགྱུར་ཏེ།",
    "རྟོགས་པའི་བདག་ཉིད་ལ་སོགས་པའི་རང་གི་བདག་ཉིད་བཞིན་ནོ།",
    "རྣམ་པར་ཤེས་པའི་རང་གི་བདག་ཉིད་བཞིན་ནོ།",
    "ཡང་ན་ལོག་པ་དུ་མ་ཞེས་བྱེ་བྲག་གི་ཚིག་སྡུད་པའོ།",
    "གཞན་ཡང་དངོས་སུ་ན་འབྲས་བུ་ཐ་དད་པ་མ་ཡིན་ཡང་གལ་ཏེ་ཁྱོད་བྱེ་བྲག་རྣམས་ནི་ཐ་དད་པར་ཁས་ལེན་ན།",
    "རྟོགས་པའི་ངོ་བོའི་རང་གི་བདག་ཉིད་བཞིན་ནོ།",
    "ཡུལ་གྱི་རྣམ་པའི་རང་གི་བདག་ཉིད་བཞིན་ནོ།",
    "མི་སྐྱེ་བ་དག་ཏུ་ཐལ་བར་འགྱུར་ལ།",
    "སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་དག་ཏུ་ཐལ་བར་འགྱུར་ཏེ།",
    "འདི་སྐད་དུ་རང་གི་ངོ་བོ་ཉིད་ཇི་ལྟ་བའི་བྱེ་བྲག་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་བརྟེན་པར་བྱའོ་ཞེས་སྨྲའོ་སྙམ་ན།",
    "རེ་རེ་ནི་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པར་འགྱུར་རོ།",
    "འདི་ལ་གཅིག་གིས་ཀྱང་ནུས་ཀྱི།",
    "གལ་ཏེ་ཁྱོད་ནི་རྐྱེན་རྣམས་ལས།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་དེ་རྟོགས་པའི་བདག་ཉིད་ལ་སོགས་པའི་རྣམ་པར་དབྱེ་བ།",
    "གཅིག་གིས་དུ་མའི་དངོས་མི་བྱེད།",
    "གལ་ཏེ་གང་གིས་འབྲས་བུ་གཅིག་བྱེད་པ་དེ་ལས་བདག་ཉིད་ཀྱི་ཁྱད་པར་གཞན་གྱིས་འབྲས་བུ་གཞན་བྱེད་དོ་ཞེ་ན་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "གལ་ཏེ་རྒྱུ་གཅིག་གིས་འབྲས་བུ་གཅིག་ཁོ་ན་བྱེད་དུ་ཟད་མོད་ཅེ་ན་ཞེས་བྱ་བས་ནི་ཕྱོགས་བཞི་པ་ལ་བརྟེན་པར་བྱེད་དོ།",
    "འགྲོ་བ་ཐམས་ཅད་ལོང་བ་དང་འོན་པ་ལ་སོགས་པའི་དངོས་པོར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "མིག་ལ་སོགས་པ་རང་གི་རིགས་དང་མཐུན་པའི་སྐད་ཅིག་སྐྱེད་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར།",
    "རང་གི་རྣམ་པར་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལྷག་མའོ།",
    "རེག་མི་ཚོར་བའི་དངོས་པོར་གསལ་བར་ཐལ་བར་འགྱུར་རོ།",
    "ཇི་སྟེ་རང་གི་རྣམ་པར་ཤེས་པ་སྐྱེད་པ་ཉིད་དུ་ཁས་ལེན་ན།",
    "རང་གི་རྣམ་པར་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་ཉིད་ཡིན་པར་ཁས་ལེན་ན་ནི་རང་གི་རིགས་འཆད་དེ།",
    "རྒྱུ་གཅིག་གིས་འབྲས་བུ་གཅིག་སྐྱེད་པར་བྱེད་དོ་ཞེས་བྱ་བ་ཁས་མི་ལེན་མོད་ཀྱི་བརྒྱ་ཞིག་ལ་ཕ་རོལ་པོ་རེ་ཐག་ཆད་པར་གྱུར་པ་དེ་སྐད་སྨྲ་བར་འགྱུར་བས་ཁོ་བོ་ཅག་གིས་དེའི་ཚིག་འཇུག་པ་ལ་གནོད་པ་བྱས་སོ་སྙམ་དུ་བསམས་པའོ།",
    "རང་གི་མཚན་ཉིད་ནི་ངག་གི་རྒྱུ་ལས་འདས་ནས་འཇུག་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཕ་རོལ་པོ་རང་གི་སྒོ་ཁོ་ན་ནས་ལེན་འདེབས་སུ་འཇུག་པར་རིམ་པ་འགོད་པར་བྱེད་པའོ།",
    "རང་གི་མཚན་ཉིད་ནི་ངག་གི་སྤྱོད་ཡུལ་ལས་འདས་པའི་ཕྱིར་བརྗོད་པར་མི་ནུས་ཞེས་སྨྲའོ།",
    "དེ་ཉིད་ཁོ་བོ་ཅག་གིས་དགག།",
    "ཁྱོད་རྩོད་པ་ལ་མཁས་པ་ག་ལ་ཡིན་ཏེ་མ་ཡིན་པ་ཁོ་ནའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གལ་ཏེ་ཡོད་ན་ནི་དེའི་ཚེ་འབྲས་བུ་དང་རྒྱུ་གཉིས་ཅིག་ཅར་ཡིན་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཡང་དེ་གཉིས་ཀྱི་རང་གི་ངོ་བོ་ཉམས་པར་ཐལ་བ་ཡིན་ནོ།",
    "འདི་ལྟར་རེ་ཞིག་འབྲས་བུ་འདི་རྒྱུ་ཞིག་པ་ལས་ནི་མི་འགྱུར་ཏེ།",
    "དེ་ལ་ཡང་མཚུངས་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་སྐད་། ཅིག་མ་དང་པོ་ལ་ནི་རྒྱུ།",
    "འདི་ལྟར་རེ་ཞིག་དང་པོ་ཁོ་ནར་དེ་ལྟ་མ་ཡིན་ན།",
    "གང་གི་ཚེ་འདི་མ་ཞིག་པ་དེའི་ཚེ་ཡང་འབྲས་བུ་མེད་པ་ཁོ་ནའོ།",
    "ཡིན་ལ་ནི་རག་མོད་ཀྱི།",
    "ཁྱོད་ཀྱི་སྐད་ཅིག་པ་ཉིད་མ་ཡིན་པར་འགྱུར་རོ།",
    "འདི་ལྟར་རེ་ཞིག་གང་གི་ཚེ་རྒྱུ་འཇིག་པ་དེའི་ཚེ་ན་རེ་ཞིག་འབྲས་བུ་མེད་ལ་གང་གི་ཚེ།",
    "གང་གི་ཚེ་འབྲས་བུ་སྒྲུབ་པར་ནུས་པའི་མཐུའི་བྱེ་བྲག་ཐམས་ཅད་མེད་པར་གྱུར་པ་དེའི་ཚེ།",
    "ཁོ་བོ་ཅག་གི་རྐྱེན་ཉིད་འདི་པ་ཙམ།",
    "གལ་ཏེ་ཚིག་ཙམ་གྱིས་གྲུབ་པོ་ཞེ་ན་ཐམས་ཅད་འགྲུབ་པར་ཐལ་འགྱུར་ཕྱིར།",
    "ཁྱོད་ཀྱིས་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་བྱེ་བྲག་ནི་བརྗོད་ལ།",
    "གང་ཞིག་གིས་སྒྲིབ་ཅེས་བྱ་བ་འདིས་ནི་བྱེད་པ་སྒྲུབ་པའོ།",
    "གང་གི་ཕྱིར་གཟུགས་ལ་སོགས་པའི་དངོས་པོ་འདི་ཀུན་རྫོབ་ཀྱི་ངོ་བོ་ཉིད་ཡིན་པ་དེའི་ཕྱིར་དོན་བྱ་བར་མི་ནུས་ཏེ་མི་རུང་བ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་སྐྱེ་བའི་ངོ་བོ་ཉིད་ཡིན་པ་དེའི་ཕྱིར་དོན་བྱེད་ནུས་ཏེ་བསྒྲུབ་པར་ནུས་པའོ།",
    "སྐྱེ་བ་ཉིད་ཀྱི་གཏན་ཚིགས་འདིས་གང་གིས་ན་འདི་སྒྲུབ་པ་ཡིན་པར་འགྱུར་བ།",
    "གཞན་འགའ་ཞིག་གིས་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ལས་བརྩམས་ནས་སྨྲས་པ།",
    "ཀུན་རྫོབ་མཚན་འདི་ལས་ཞེས་བྱ་ནི་གང་གིས་ཡང་དག་པའི་སྒྲིབ་པར་བྱེད་ཅེས་བྱ་བ་ལ་སོགས་པ་ལས་སོ།",
    "ལྟོས་པའི་བྱེ་བྲག་གིས་ཞེས་སྙམ་དུ་བསམས་པའོ།",
    "གང་དག་གི་སྙམ་པ་ལ་དངོས་པོ་རྣམས་ཀྱི་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཅེས་བྱ་པའི་ཚིག་འདིས་ནི་གཞན་དག་གིས་དམ་བཅས་པ་ལ།",
    "རང་གི་ཚིག་དང་གྲངས་པ་དང་ལུང་དང་འགལ་བའི་གནོད་པ་ཡོད་དོ་ཞེས་བརྗོད་པ་གང་ཡིན་པ་དེ་མི་སྲིད་དོ་ཞེས་སྟོན་པར་བྱེད་དོ།",
    "འདི་ལྟར་སྐྱེ་བ་ལ་སོགས་པ་ཇི་ལྟར་སྣང་བ་བཞིན་རྣམ་པར་གནས་པ་དེ་དག་ནི་གང་གི་ཕྱིར་མངོན་སུམ་ལ་སོགས་པ་དང་འགལ་བར་འགྱུར་བ་དེ་ལྟར་ནི་མི་འགོག་གི།",
    "ཇི་ལྟར་གཞན་དག་གིས་སྐྱེ་བ་ལ་སོགས་པར་ཡོངས་སུ་བརྟགས་པ་དག་འཇུག་པ་དེ་དག་ཀྱང་དེ་ལྟར་ནི་མངོན་སུམ་མ་ཡིན་ཏེ།",
    "དོན་དམ་པར་སྐྱེའོ་ཞེས་བྱ་བ་དེ་ལ་རིགས་པ་སྨྲ་བ་རྣམས་ཀྱིས་གཞན་དག་གིས་དོན་དམ་པ་ཞེས་བྱ་བའི་སྒྲའི་དོན་ཇི་ལྟ་བུར་ཡོངས་སུ་བརྟགས་པ་དེ་ལ་བརྟེན་ནས་འགོག་པར་བྱེད་དེ།",
    "གང་གི་ཕྱིར་དོན་དམ་པ་དང་མཐུན་པའི་ཕྱིར།",
    "རྗེས་སུ་དཔག་པ་དང་རྗེས་སུ་དཔག་པར་བྱ་བ་འབྱུང་གི་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "གང་དག་གི་ཞེ་ན།",
    "འགའ་ཞིག་གིས་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་སྤྲོས་པ་ཐམས་ཅད་བྲལ་བ་དང་མཐུན་པའི་ཕྱིར་རིགས་པ་སྨྲ་བ་རྣམས་ཀྱིས་དོན་དམ་པ་ཉིད་དུ་འདོད་པའོ།",
    "གཞན་དག་གིས་ནི་སྐྱེ་བ་མེད་པ་ལ་སོགས་པ་འགོག་པ་ཡང་དག་པ་ཁོ་ནར་དོན་དམ་པ་ཉིད་དུ་འདོད་ཅེས་བྱ་བར་སྦྱར་ཏེ།",
    "གལ་ཏེ་ཇི་ལྟར་གཅིག་ཁོ་ན་གཅིག་གི་དོན་དམ་པ་ཡིན་ལ།",
    "ལྟོས་པའི་བྱེ་བྲག་གིས་དེ་ནི་ཉེས་པ་མེད་དེ།",
    "འདི་ལྟར་བུད་མེད་གཅིག་ཁོ་ན་གཞན་དེའི་བུའི་ནི་མ་ཡིན་ལ།",
    "བློ་རྒྱ་ཆེན་པོའི་ནོར་ཅན་ཁྱོད་ཀྱིས་གང་སྨྲས་པ།",
    "དོན་གཞན་དུ་སོང་བས་ཏེ།",
    "དེ་དག་གི་དེ་མ་རུང་ན་མ་རུང་དུ་ཟད་དོ།",
    "འདི་ལྟར་ཁྱོད་ལ་དུ་བ་ལ་སོགས་པ་ཆ་ཇི་ཙམ་སྣང་བ་དེ་ཙམ།",
    "ཁོ་བོས་ཁྱོད་ཀྱི་ངོ་མི་ཆོད་པའི་ཕྱིར་སྨྲ་བར་འདོད་ནས།",
    "ཁྱོད་ཀྱི་འདྲི་བ་འདི་ནི་དོན་མེད་ལ་ཁོ་ན་ཡིན་ཏེ།",
    "འདི་ལྟར་དྲིས་སུ་ཟིན་ཀྱང་ཁོ་བོས་གང་ཁྱོད་དང་བ་ལང་རྫི་ལ་སོགས་པ་དང་བཅས་བས་མཐོང་བ་དེ་ཙམ་གྱི་ཆ་ཞིག་བརྗོད་པར་བྱའི།",
    "འདྲི་བ་ནི་ཀུན་ནས་ཉོན་མོངས་པ་སྟེ།",
    "བཙུན་པ་བློ་བརྟེན་ན་རེ།",
    "གལ་ཏེ་དེ་ལྟ་ན་གཞི་ཡང་དེའི་ངོ་བོ་ཉིད་ཁོ་ན་ཡིན་པས་ཁོ་བོ་ཅག་གི་འདོད་པ་གྲུབ་པ་ཁོ་ན་ཡིན་ནོ།",
    "གཞི་ཀུན་རྫོབ་ཏུ་ཡོད་པར་ཐལ་བར་འགྱུར་རོ།",
    "རང་གི་ངོ་བོ་ཉམས་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "ཇི་སྟེ་དེ་རང་གི་ངོ་བོ་མི་འདོར་ན་དེ་ལྟ་ཡིན་ན་ནི།",
    "ཁྱོད་ཀྱི་གཞི་ཡང་ཇི་ལྟར་ཀུན་རྫོབ་ཏུ་མི་འགྱུར་ཏེ།",
    "གཏན་ཚིགས་གང་གི་ཕྱིར་རྣལ་འབྱོར་སྤྱོད་པ་དངོས་པོར་སྨྲ་བ་ཁྱོད་ཀྱི་ལྟར་ན་ཡང་།",
    "འདི་ལ་གང་གིས་ན་མངོན་སུམ་དང་འགལ་བར་རྣམ་པར་གཞག་པར་འགྱུར་བ་མངོན་སུམ་དང་གྲགས་པའི་དོན་སྤང་བ་གང་ཞིག་ཡིན་སྙམ་པ་ལ།",
    "མྱོང་བ་དང་འགལ་བ་སྒྲུབ་པ་ཁྱོད་ལ་འགོག་པར་བྱེད་པ་སུ་ཞིག་ཡོད།",
    "གྲུབ་པའི་མཐའི་ཕྱོགས་འཛིན་པས་མ་ཉམས་པའི་བློ་གྲོས་ཅན་བུད་མེད་དང་དམངས་རིགས་ལ་སོགས་པའམ།",
    "ཇི་སྟེ་ཁྱོད་དེ་ལྟར་གྱུར་པ་འཇིག་རྟེན་ཐམས་ཅད་ལ་གྲགས་པའི་དོན་ཡང་སྤང་ན་ནི་དེའི་ཚེ།",
    "བདག་ཉིད་མི་ཤེས་པ་དེ་ལྟ་བུ་བདག་དང་གཞན་གྱིས་ཉམས་སུ་མྱོང་བ་དང་འགལ་བའི་ཐ་སྙད་སྨྲ་བ་ཁྱོད་ནི།",
    "གང་ལ་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པ་དེས་དབེན་ཞིང་བྲལ་བའི་རང་གི་ངོ་བོ་ཡོད་པ་དེ་སྐད་ཅེས་བྱ་སྟེ།",
    "མ་རིག་པས་དཀྲུགས་པའི་ཕྱིར་དེ་ལྟར་སྣང་བར་ནི་ཆུག་མོད་ཀྱི་ཞེས་བྱ་བ་ནི་ཁས་བླང་བའོ།",
    "སྦྱོར་བ་ནི་གང་གིས་དབེན་པའམ་གང་ཞིག་གང་དང་འབྲེལ་བ་མེད་པ་ནི་དེ་སྣང་བ་ན་དེ་མི་སྣང་སྟེ།",
    "ཕ་རོལ་པོ་ན་རེ།",
    "དེའི་ཚེ་གཉིས་པོས་དབེན་པའི་ཤེས་པའི་རང་གི་ངོ་བོ་བཞིན་དུ།",
    "དེ་ནི་དེ་དག་གིས་བསྐྱེད་བ་མ་ཡིན་ནོ།",
