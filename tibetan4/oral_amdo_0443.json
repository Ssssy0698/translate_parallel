    "སྡང་བ་བོར་ཏེ་ཡང་དག་པ་མཐོང་བ་གོམས་པར་བྱས་པའི་རིམ་གྱིས་མོས་པ་འདི་ནི།",
    "རེ་ཞིག་གཅིག་ན་འགྱུར་ཏེ་དེ་ལྟ་མ་ཡིན་ན་ནི།",
    "སྡང་པས་ཚིག་པ་ཁྱོད་ལ་ནི་མོས་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "འཛམ་གླིང་གི་ཕྱོགས་གང་སར་མི་ཚོས་རི་དྭགས་དང་འདབ་ཆགས་ཀྱི་ཀོ་ལྤགས་གོས་སུ་གྱོན་རྒྱུ་གསར་དུ་རྟོགས་པ་མ་ཟད།",
    "ད་དུང་འབྲུ་རིགས་བཏབ་ནས་གྲོ་ཞིབ་ཀྱིས་གོ་རེ་སྐྱུར་བརྫིས་མ་དང་ཆུར་བརྫིས་མ་གཉིས་ཀ་བཅའ་རྒྱུ་ཤེས།",
    "མི་རྣམས་བྲག་ཁུང་དང་རང་བྱུང་གི་སྐྱིབས་འོག་ཏུ་ཁྱིམ་གཞིས་ཆགས་རྒྱུ་ཡང་ཤེས།",
    "ཏ་ཟིག་དང་རྒྱ་གར།",
    "རྒྱ་ནག་བཅས་འཛམ་གླིང་གི་ས་ཕྱོགས་འགའ་ཞིག་ལ་ཆགས་པའི་རྒྱལ་ཁམས་སམ།",
    "འགྲོ་བ་མི་རྣམས་དེ་ལྟར་ཡིན་རུང་ཡར་རྒྱས་སོང་སྟེ་མི་འབོར་འཕེལ།",
    "སྤྱི་ལོའི་གོང་གི་སྟོང་ལོ་གཉིས་པའི་མཚམས་སུ་སྲོག་ཆགས་ཆེ་ཁག་ཕལ་མོ་ཆེ་རྔོན་ནས་རྩ་སྟོང་དུ་སོང་བ་དང་གཡུང་ལ་ཕབ་ནས་སྒོ་ཟོག་ཏུ་བསྒྱུར།",
    "འཛམ་གླིང་གི་གྲུ་ཟུར་ཆུང་ངུ་ཞིག་ཏུ་མིའི་རིགས་བྱེ་བྲག་པ་ཞིག་འཕེལ།",
    "ཨི་ཇེབ། ། ཨི་ཇེབ་ནི་ཨ་ཧྥི་རི་ཀ་དང་ཨེ་ཤི་ཡའི་ཆུ་བོ་ཆེ་ཁག་ཅིག་གི་ངོགས་སུ་ཆགས་པའི་རྒྱལ་ཁམས་ཐོག་མ་དེ་ཡིན་ཞིང་།",
    "དེའི་གོང་གི་ལོ་སྟོང་ཕྲག་གསུམ་ལ་ཨི་ཇེབ་ནི་ཕྱེད་རང་བཙན་གྱི་རྒྱལ་ཁམས་ཤིག་གི་ངོ་བོར་གནས།",
    "ཨི་ཇེབ་ལོ་སྟོང་ཕྲག་གསུམ་ལ་བརྟན་ཐུབ་པའི་ཐུན་མོང་མ་ཡིན་པའི་ངོ་མཚར་ཅན་ཞིག་བྱུང་བ་ནི་ས་བབ་ཁེར་ལོགས་སུ་ཡོད་ཅིང་།",
    "དེ་ལ་ལྟོས་འཇོག་གི་སྒོ་ནས་འགྲན་རྩོད་པ་ཉུང་བའི་སྟབས་ཀྱིས་ཡིན་ཞེས་འགྲེལ་ཆོག་ཨི་ཇེབ་ཀྱི་ཕྱོགས་གསུམ་ཐར་ས་མེད་པའི་བྱེ་ཐང་གིས་བསྐོར།",
    "ཁོང་གི་བཀའ་ལ་བརྩིས།",
    "ཁོ་ཚོས་རང་མོས་ཀྱིས་ངལ་རྩོལ་བརྒྱུགས་པར་མངོན།",
    "གོང་གི་དོགས་སློང་ཁག་ལ་ལན་ཐེབས་མི་སྲིད་པ་ཞིག་མིན་རུང་ཤིན་ཏུ་དཀའ།",
    "གནའ་བོའི་ཨི་ཇེབ་དེ་ཉིད་རང་གི་མཐའ་ལྷུང་རྙིང་ཞེན་དང་མ་བྲལ།",
    "ཁོ་ཚོས་རང་གི་མི་ཚེ་ཧྲིལ་བོ་དང་ལོངས་སྤྱོད་རྣམས་འགྲོ་གྲོན་བཏང་ནས་འཆི་བའི་སྟ་གོན་བསྒྲུབས།",
    "འདི་ལ་ཐ་སྙད་གཞན་ཞིག་གིས་འགྲེལ་ན་རྩ་བའི་ཆ་ནས་ཨི་ཇེབ་པ་ཚོས་ཀྱང་འགྲོ་བ་མིའི་སྤྱོད་ཚུལ་འཛིན།",
    "དེར་བརྟེན་འདས་པའི་དུས་རབས་དེ་དག་གི་རིང་ལ་ཨི་ཇེབ་པ་ཚོས་གཏུམ་རྒྱལ་ཚོར་དགེ་མཚན་ལྡན་པའི་གསང་བ་ཞིག་ཤེས་རྟོགས་འབྱུང་དུ་བཅུག་ཡོད།",
    "སྐྱེ་བོ་ཐམས་ཅད་རང་གི་ལས་རིགས་དང་ཟས་སྤྱོད་ཀྱི་གོམས་གཤིས།",
    "དེས་ན་རྒྱ་ཆེའི་མང་ཚོགས་རྣམས་ཅིའི་ཕྱིར་ཐོབ་སྐལ་མེད་པར་འཚོ་དགོས་སམ།",
    "འཇིག་རྟེན་ཀུན་པོས་རིགས་རུས་དབྱེ་འབྱེད་ལ་ངོས་ལེན་བྱས་ན་ལམ་ལུགས་དེ་ཉིད་རྒྱུན་འཁྱོངས་ཐུབ་རྒྱུ་གདོན་མི་ཟ།",
    "ང་ཚོ་རིགས་རུས་དབྱེ་འབྱེད་འོག་ཏུ་འཚོ་གནས་བྱས་མེད་པས་རྒྱ་གར་གྱི་རིགས་རུས་དབྱེ་འབྱེད་སྐྱོན་དུ་མཐོང་སླ།",
    "ཁོ་ཚོ་ཕན་ཚུན་འབྲེལ་བ་དམ་ཟབ་ཡོད་པའི་ཆིན་ཞེས་པའི་མི་རིགས་ཤིག་གིས་གྲུབ།",
    "ཆིན་ཧྲི་ཧྭང་གིས་མངའ་རིས་ཤིག་བཟུང་བ་དེ་ནས་བཟུང་སྟེ་རྒྱ་ནག་གི་མངའ་ཁོངས་ཞེས་དབྱེ་མཚམས་ཕྱེ།",
    "དུས་ཕྱིས་སུ་རྒྱ་ནག་གིས་གཞན་གྱི་མངའ་རིས་བཟུང་མྱོང་ཡོད་རུང་ཆིན་ཧྲི་ཧྭང་གི་མངའ་ཁོངས་ནི་གཏན་ནས་བགོ་འགྲེམ་མི་རུང་བའི་རྒྱ་ནག་གི་མངའ་ཡུལ་དུ་གྲགས།",
    "ཁོང་ཉམས་རྒུད་དུ་སོང་བའི་སྐུ་དྲག་ཁྱིམ་ཚང་ཞིག་གི་མི་རྒྱུད་ཡིན་རུང་དྭ་ཕྲུག་ཏུ་ལུས་ཏེ་དབུལ་ཕོངས་ཀྱི་ངང་དུ་འཚར་ལོངས་བྱུང་།",
    "ཆིན་ཧྲི་ཧྭང་གི་གཤིས་རྒྱུད་ཀྱང་ཁུང་ཧྥུ་ཙིའི་ལྟ་གྲུབ་ཀྱིས་བརླན།",
    "ཤེས་བྱ་གཞན་པ་ཐམས་ཅད་ཉེན་ཀ་ཅན་དང་ཤེས་བྱའི་གཞུང་ལུགས་གཞན་ལ་རྟོག་དཔྱོད་བྱེད་པའི་ཤེས་བྱ་ཡིན་པས་བཀགཆིན་ཧྲི་ཧྭང་གི་མཐར་ཐུག་གི་མངོན་འདོད་ནི་ཚེ་ལ་རྟག་པ་འཐོབ་རྒྱུ་དང་དེ་ལ་ཕན་པར་སེམས་པའི་ལྷ་རྣམས་རྒྱལ་ཁབ་ཀྱིས་འགྲོ་གྲོན་བཏང་ནས་མཆོད།",
    "ཡིན་ནའང་ཁོང་གིས་བཏབ་པའི་གཅིག་སྒྲིལ་གྱི་ས་བོན་ལ་རྩ་བ་རྒྱས།",
    "སྤྱི་ལོའི་སྔོན་གྱི་༢་ནས་སྤྱི་ལོ་༢་བར་དུ་འཛམ་གླིང་གི་རྒྱལ་ཁབ་ཆེ་ཤོས་དང་མི་འབོར་མང་ཤོས་ནི་རྒྱ་ནག་ཡིན།",
    "ཆིན་ཧྲི་ཧྭང་འདས་ནས་ལོ་ཉིས་སྟོང་གི་གཞུག་སྟེ།",
    "ཕྱོགས་གཞན་ཞིག་ནས་མི་སུ་གཅིག་གིས་ཀྱང་ལས་ཤོར་གྱི་སེམས་ཚེགས་སམ།",
    "མེ་སོ་ཕོ་ཊ་མི་ཡ། ། རྒྱ་ནག་གི་ཡི་གེའི་དཔེ་གཟུགས་སྔ་ཤོས་ནི་ཧྲང་རྒྱལ་རབས་སྤྱི་ལོའི་གོང་གི་དུས་རབས་བཅོ་བརྒྱད་ནས་བཅུ་གཉིས་ཀྱི་དུས་སུ་དར།",
    "སྤྱི་ལོའི་སྔོན་གྱི་༡༤་ཡས་མས་སུ་རྒྱ་ནག་གི་ཡི་གེ་ཡིག་འབྲུ་ཉིས་སྟོང་ལྔ་བརྒྱ་ལྷག་ལ་འཕེལ།",
    "ད་ལྟའི་རྒྱ་ཡིག་གི་དཔེ་གཟུགས་འདི་ཆིན་གྱི་དུས་སྤྱི་ལོའི་སྔོན་གྱི་༢༢༡༢༦་བར་དུ་བསྐྱངས་པའི་ཆིན་ཧྲི་ཧྭང་གི་རྒྱལ་སྲིད་དུས་སུ་གཏན་ལ་ཕབ།",
    "ཆུ་བོ་དེ་ལེ་དབར་བརྒྱའི་རིང་ཚད་ལ་འཁྱག་འཁྱོག་ཏུ་དལ་བར་བཞུར་ནས་ཏ་ཟིག་མཚོ་ཁུག་ཏུ་འབབ།",
    "དེར་བརྟེན་ཡི་གེའི་བཀོལ་སྤྱོད་ཆེས་སྔ་བ་ནི་སྐྱེ་བོ་སུ་ཞིག་ལ་བ་མོ་ཅི་ཙམ་ཡོད་མེད་དང་རས་ཡུག་ཅི་ཙམ་ཡོད་མེད་ཀྱི་གྲངས་ཐོ་འགོད་རྒྱུ་དང་།",
    "ཡིན་ནའང་མིའི་འཚོ་བ་གྲ་རྒྱས་སུ་སོང་བས་ཅ་ལག་ཐོ་འགོད་བྱ་དགོས་པའང་མང་དུ་འཕེལ།",
    "སྤྱི་ལོའི་སྔོན་གྱི་སྟོང་ལོ་གསུམ་པར་སུ་མ་རི་ཡའི་ཡི་གེ་དེ་ཨ་ཁ་དི་པ་ཚོས་བཀོལ་སྤྱོད་བྱས་པས་ཡེ་གེའི་གོ་དོན་ཡང་སྔར་ལས་ཇེ་ཟབ་ཏུ་སོང་།",
    "ཁོ་ཚོར་ཉེ་འཁོར་གྱི་རྒྱལ་ཕྲན་ཁག་གིས་དཔྱ་སྐྱེས་འཇལ།",
    "ཁོ་ཚོས་ཕེ་རུ་བའི་ས་ཁོངས་སུ་གཏོགས་པའི་ཨིན་ཌི་སི་རི་བོའི་རྩེ་མོར་མ་ཆུ་ཕི་ཆུ་ཞེས་པའི་མཁར་གྲོང་ཞིག་བརྩིགས་པ་འཛམ་གླིང་གི་ངོ་མཚར་ཅན་གྱི་གནའ་ཤུལ་གྲས་སུ་རྩི།",
    "ཨིན་ཁ་བ་རྣམས་རང་ལ་ཆ་རྒྱུས་མེད་པའི་སྟབས་ཀྱིས་རང་གི་གྲུབ་འབྲས་ཀྱང་མ་ཤེས།",
    "རིན་འབབ་དེ་བྱིས་པ་དང་ན་གཞོན་གྱི་ཁྲག་གིས་འཇལ།",
    "སི་པེན་བ་ཚོ་མ་བསླེབས་གོང་གི་མཐའ་མཇུག་གི་ལོ་ཤས་རིང་ལ་བདུན་ཕྲག་རེར་བྱིས་པ་ཁམས་གཙང་དང་ན་གཞོན་དར་མ་སྟོང་ཕྲག་རེ་དམར་མཆོད་དུ་ཕུལ།",
    "དེ་ནས་མི་དེ་ཚོ་གཏོར་གཟུགས་ཅན་གྱི་མཆོད་རྟེན་ཞིག་གི་ཐེམ་པ་བརྒྱུད་ནས་རྩེ་རུ་དྲུད་ནས་བསང་ཁྲིའི་ཐོག་ཏུ་གན་རྐྱལ་ལ་བསྙལ།",
    "བདུན་ཕྲག་རེར་མི་སྟོང་ཕྲག་རེ་དམར་མཆོད་འབུལ་དགོས་པ་རྣམས་མེཀ་སི་ཀོའི་ཐང་གཤོང་གི་ཉེ་འཁོར་དུ་འཚོ་བའི་ཚོ་ཤོག་ཁག་ལ་བཙན་རྒོལ་བྱས་ནས་གསོན་པོར་བཟུང་།",
    "སེ་པེན་གྱི་རྒྱལ་པོ་གསེར་དངུལ་ལ་ཚིམ་པ་མེད་པས་ཨིན་ཌི་སི་རི་བོའི་སྟེང་དུ་ཨིན་ཌི་པ་ཚོ་གཏེར་ཁ་བརྐོ་བར་ངལ་རྩོལ་བསྐུལ་ནས་བདུན་ཕྲག་རེར་མི་སྟོང་ཕྲག་འགའ་རེ་ཤིའོ།",
    "དེ་མིན་གྱི་གནའ་བོའི་མི་རིགས་མང་ཆེ་བར་རང་རང་གི་ལྷ་རྣམས་ལ་མི་དམར་ཆོད་ཕུལ་བའི་སྲོལ་རེ་འཇགས།",
    "དེ་ནས་ཤ་ལྷག་མ་རྣམས་དམག་ལ་བཀྱེས་ནས་སྟོན་མོ་བཤམས་པར་གྲགས།",
    "ཨེབ་རེམ་གྱིས་རང་གི་བུ་ཨི་སཀ་དམར་མཆོད་འབུལ་གྲབས་བྱས་པའི་གཏམ་རྒྱུད་དེ་སྟོན་པ་ཡེ་ཤུ་མ་འཁྲུངས་སྔོན་གྱི་སྟོང་ལོ་གཉིས་པའི་མཚམས་སུ་བྱུང་བར་སྣང་།",
    "ཁྱོད་ཀྱིས་ཤིན་ཏུ་གཅེས་པའི་བུ་འབའ་ཞིག་སྟེ།",
    "ཨེབ་རེམ་གྱིས་བསང་ཁྲི་བརྩིགས།",
    "མེ་ཁ་གསོས་ནས་འབུད་ཤིང་སྤུངས།",
    "ཁོ་ཚོས་འཛམ་གླིང་གི་མི་དམངས་གཞན་ལའང་བདེན་པ་དེ་དག་ཁྱབ་སྤེལ་བྱ་དགོས་པའི་འཕྲིན་ལས་བཅོལ།",
    "ཁོང་གི་འཁྲུངས་ལོ་ནས་བརྩིས་ཏེ་འཛམ་གླིང་གི་ཡུལ་གྲུ་ཕལ་མོ་ཆེར་སྤྱི་ལོ་བརྩི་བའི་སྲོལ་དར།",
    "འདི་ལ་འཛམ་གླིང་གི་ཡེ་ཤུ་མཆིས་སོ་ཅོག་གིས་འདས་ལོག་དུས་ཆེན་དུ་གཙི།",
    "ཅིའི་ཕྱིར་ཞེ་ན་དེ་དག་གི་ལྟོགས་སྐོམ་སེལ་པར་འགྱུར།",
    "སྟོན་པ་ཡེ་ཤུས་སུ་ཞིག་གིས་རང་སྲོག་གཅེས་ན་རང་སྲོག་འཆོར་པར་འགྱུར།",
    "སྟོན་པ་ཡེ་ཤུའི་གསུང་ཕལ་མོ་ཆེ་དཔེ་འཇོག་ལ་སྦྱར་ཡོད་པ་དེ་དག་ལ་བློ་སྐྱེད་འཕེལ་བའི་ནུས་པ་ཟབ།",
    "ལོ་བརྒྱ་ཐམ་པའི་རྗེས་སུ་བཙན་རྒྱལ་ཞིག་ཚུགས་པ་དེའི་མངའ་ཐང་གི་ཆེ་ཆུང་དང་སྒྲིག་འཛུགས་རྣམས་རོ་མན་བཙན་རྒྱལ་གྱི་མངའ་ཐང་དར་སྒང་གི་དཔལ་ལ་འགྲན།",
    "ལོ་བཅུའི་ནང་དུ་མོཧ་མེ་ཐེའི་གནས་སྟངས་ནི་ཧ་ཅང་གི་དཀའ་ཁག་ཅན་ཞིག་ཏུ་གྱུར།",
    "ཁོང་ཕྱི་འབྱུང་གི་ཁ་ཆེ་ཚོའི་མཛངས་སྤྱོད་ཀྱི་མིག་དཔེ་རུ་གྱུར།",
    "ཁོང་གིས་རྒྱལ་ཁམས་ཤིག་བཙུགས་པ་མ་ཟད།",
    "ཡིན་ནའང་འཇིའུ་པ་དང་ཡེ་ཤུ་ཚོས་མི་རེའི་ཡོང་འབབ་ལ་དཔྱ་ཁྲལ་འཇལ་དགོས།",
    "འཛམ་གླིང་འདིའི་མི་དུང་ཕྱུར་མང་པོས་ཐུན་མོང་གི་བསྒྲུབ་བྱ་ཞིག་ཡོད་པར་འདོད་པ་དང་ཡོད་པར་སྨྲ།",
    "ཡུ་རོབ་གླིང་གི་འཇིའུ་རྣམས་ཤུལ་མེད་འགྲོ་གྲབས་བྱས་ཀྱང་ཨི་སི་རལ་དང་ཨུ་རུ་སུ།",
    "བསྟན་སྲུང་དྲག་འཐབ་ལ་སྟོབས་ཤུགས་གསར་པ་ཞིག་རྒྱས་ནས་འཛམ་གླིང་གི་ཁྱོན་ཡོངས་སུ་ཁ་ཆེ་ཚོར་ཕུ་ནུའི་འདུ་ཤེས་གསར་པ་ཞིག་སྐྱེས་ནས་ཀུན་ཁྱབ་ཏུ་འགྲོ་བཞིན་ཡོད་དོ།",
    "མོ་རི་ཡའི་མངའ་ཐང་དར་སྒང་ནི་རྒྱལ་པོ་མྱ་ངན་མེད་སྤྱི་ལོའི་སྔོན་གྱི་༢༦༥༢༣༥་བར་དུ་སྲིད་བསྐྱངས་ཀྱི་དུས་སུ་བྱུང་།",
    "རྩ་བ་ལེགས་པར་ཚུགས་པའི་བཙན་རྒྱལ་དེའི་མངའ་རིས་ཀྱི་རྒྱ་ཁྱོན་ལ་ལེ་དབར་གྲུ་བཞི་མ་ས་ཡ་གཅིག་དང་མི་འབོར་བྱེ་བ་ལྔ་ཙམ་ཡོད་སྐད།",
    "ཁོང་ལ་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བའི་རྒྱལ་ཁ་ཐོབ་ཀྱང་རྒྱལ་ཁ་དེ་དག་གིས་བདེ་བ་མ་ཐོབ།",
    "ད་དུང་གཡུལ་འཁྲུག་གི་རྒྱལ་ཁ་ཐོབ་མཁན་དང་ཕམ་ཁ་མྱོང་མཁན་གཉིས་ཀ་སྡུག་ལ་སྦྱར་པའི་གདུང་བ་དེས་མྱ་ངན་མེད་ཆེས་ཆེར་གཙེས།",
    "ཁོང་གིས་བཙུན་མོ་བཞེས་ནས་འཇིག་རྟེན་གྱི་ཕུན་ཚོགས་ལ་རོལ།",
    "ཁོང་གིས་སྡུག་བསྔལ་གྱིས་ཡོངས་སུ་མནར་པ་ཞི་ཐབས་ཤིག་བཙལ།",
    "གོ་ཏམ་གྱིས་བཙུན་མོ་དང་སྲས་བསྐྱུར།",
    "ཁོང་སྡུག་བསྔལ་གྱིས་མནར་པ་དེ་ལས་གྲོལ་ཐབས་སུ་བཤེས་གཉེན་ཞིག་བསྟེན་ནས་ལམ་ཞིག་རྙེད་པའི་རེ་བ་བཅངས།",
    "དཀའ་ཐུབ་བརྒྱུད་ནས་སྡུག་བསྔལ་ཇི་ལྟར་འབྱུང་གི་ཡོད་པ་ངོས་ཟིན་ཀྱང་སྡུག་བསྔལ་གྱི་རྒྱུ་རྐྱེན་མ་རྟོགས།",
    "ཁོང་གི་ཐུགས་ལ་ཁོ་བོས་བདེན་པ་འདི་རྟོགས།",
    "ཉོན་མོངས་པ་དང་མ་རིག་པས་ཡོངས་སུ་སྒྲིབ་པའི་སྐྱེ་བོ་དག་གིས་བདེན་པ་འདི་རྟོགས་མི་འགྱུར།",
    "བདེན་པ་འདི་ཉོན་མོངས་པ་དང་མ་རིག་པའི་གཉེན་པོ་ཡིན་པས་རྒྱ་ཆེ་ཞིང་གཏིང་ཟབ།",
    "སྔོན་གྱི་བསླབ་སྟོན། ། གནའ་བོའི་རྒྱལ་ཕྲན་ཁག་དང་རྒྱལ་ཁམས་རྣམས་ཁྱིམ་ཚང་དང་གྲོང་ཚོ།",
    "ང་ཚོས་ཤེས་གསལ་ལྟར་ཨི་ཇེབ་པ་ཚོས་བསྟེན་པའི་ཐབས་ལམ་དེར་སྒྱུར་བཅོས་ལ་ཡི་ཐང་ཆད་པའི་མཇུག་འབྲས་ཤིག་སྨིན།",
    "ཁོ་ཚོས་མི་ཞིག་གི་སྐྱེས་ཁུངས་གཅིག་པུས་ཅི་ཡང་མི་འཁྱོངས།",
    "དེ་ལས་ལྡོག་སྟེ་རྒྱལ་ཁབ་དེའི་སྤྱི་སྒེར་གཉིས་ཀྱི་བྱ་བ་མཐའ་དག་ལ་སྟངས་འཛིན་བྱེད་མཁན་མི་ཉུང་ཤས་ཤིག་གི་གྲས་སུ་ཚུད་ན་མཆོག་གྱུར་པར་བརྩིས།",
    "དེང་རབས་ཀྱི་བཟོ་ལས་ཡར་ཐོན་རྒྱལ་ཁབ་ཁག་ལ་མཚོན་ན་རྒྱལ་ཡོངས་ཐོན་སྐྱེད་ཀྱི་ཕྱེད་ཀ་ལྷག་བརྡ་འཕྲིན་བཟོ་ལས་ཁག་གིས་བཟུང་བར་མངོན།",
    "དེས་ན་གྱེན་ལོག་དེ་དག་ལ་མ་མཐའ་ཡང་ཕྱོགས་ཟུར་རེ་ནས་གྲུབ་འབྲས་ཐོན་ཡོད་ཅེས་ང་ཚོས་མཇུག་སྡོམ་རྒྱག་མི་དགོས་སམ།",
    "འཇིའུ་པ་ཚོ་མིའི་བྱས་ཉེས་མཐའ་དག་གི་འགན་འཁྲི་མི་ལ་ཡོད།",
    "སྐྱེས་པ་དང་བུད་མེད་གཉིས་ཀས་གཏན་དུ་སོ་སོའི་སྡིག་ཉེས་ཀྱི་འབྲས་བུ་མྱོང་དགོས།",
    "ཁོང་གིས་ཨེ་ཌམ་དང་ཨི་ཝྭེ་གཉིས་ཀྱི་རིགས་རྒྱུད་ལས་མཆེད་པའི་མིའི་རིགས་ལ་ཐུགས་བརྩེས་བསྐྱངས།",
    "ཁོང་གིས་ཡོན་ཏན་ངོ་མ་དེ་སྦྱངས་འབྲས་ཡོད་མེད་ལ་བལྟ་དགོས་པ་སྟེ།",
    "ཡང་ན་མི་གཞན་གྱིས་བརྩམས་པའི་བསྟན་བཅོས་ཁག་གི་སྦྱངས་འབྲས་ཀྱིས་ཐག་གཅོད་དགོས་ཞེས་གསུང་སྲིད།",
    "འོ་ན་ཁོང་གིས་གསུང་སྲིད་པ་དེར་གོ་དོན་གཏིང་ཟབ་ཅིག་དང་གསར་བརྗེའི་རྣམ་པ་ཞིག་མི་ལྡན་ནམ།",
    "སྐྱེས་པ་དང་བུད་མེད་བཅས་མི་ཐམས་ཅད་ལ་སྡིག་ཉེས་འགོས་པ་འདྲ་མཉམ་ཡིན།",
    "ད་དུང་ལྷ་མང་བསྟེན་མཁན་སོཀ་རེ་ཊི་སི་སོགས་ཀྱིས་དུས་དང་རྣམ་པ་ཀུན་ཏུ་ཤུགས་རྐྱེན་ཐེབས་ཡོད་པ་བརྗོད་ག་ལ་དགོས་སོ།",
    "སྤྱི་ལོའི་སྔོན་གྱི་དུས་རབས་བརྒྱད་པའི་དཀྱིལ་དུ་གྷེ་རི་སི་པ་ཚོས་དབྱངས་ཡིག་གི་མཚོན་རྟགས་ཤིག་གསར་དུ་བཟོས།",
    "དེའི་འབྲས་བུའི་གསལ་བྱེད་ལ་ལེགས་བཅོས་ཅུང་ཟད་ལས་མ་བྱས་པར་དེང་སྐབས་ང་ཚོས་བཀོལ་སྤྱོད་བྱེད་བཞིན་པའི་གསལ་བྱེད་འདི་ཡིན།",
    "ཡིན་ནའང་བརྗོད་དོན་གྱི་ཁྱད་པར་རྣམས་སྐབས་དོན་གྱི་འབྲེལ་ཆགས་ལ་གཞིགས་ནས་རྟོགས་དགོས་པ་ལས་ཡི་གེ་བྱེ་བྲག་པ་རེའི་དག་ཆར་བལྟས་ན་གོ་དོན་མི་ཤེས།"
  ]
}