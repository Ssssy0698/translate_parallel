    "རེ་གསུམ་ཕག་ལ་བྱམས་པའི་མདུན་སར་གཤེགས།",
    "ཐ་ན་སྔ་མའི་འདོད་པར་མོས་བློ་ཕྱིན་པའི་དབྱིབས་ཚུགས་ཙམ་ཡང་མ་བཏོད་པ་ས་སྦེད་རྡོ་སྦེད་སྲིན་པོ་མིར་བརྫུས་ཀྱི་ཟླར་ཆོག་པའི་ཚོད་དུ་འཁུམས་ཤིང་།",
    "ཕྱིར་རྒོལ་བར་བྱེད་པ་དེ་དག་གིས་ཀྱང་དེ་ཁོ་ན་བཞིན་དུ་སེམས་པའམ་ངན་གཡོའི་ཆོ་འཕྲུལ་ལ་རོལ་བ་གང་ལྟར་ཕར་འདྲི་ཚུར་འདྲི་ཡར་ལབ་མར་ལབ་ཀྱི་ལྡིང་བསྐོར་ཇི་སྙེད་ཅིག་བྱུང་གདའ་བ་ས་ཆུང་དགོན་ཆུང་གི་རང་མཚང་བཀྲུས་པས་མི་འདག་པ་ཉིད་ལས་གཞན་དུ་ཅི།",
    "བསྟན་པ་ཐམས་ཅད་འགལ་མེད་དུ་རྟོགས་པའི་ཆེ་བརྗོད་ལྕེའི་རྩེ་མོར་བ་དན་ལྟར་འཕྱར་བ་དག་གིས་ཁལ་གཡག་སྒལ་རལ་ལྟ་བུའི་ཐལ་གཙུབ་དེ་འདྲ་སློང་ག་ལ་རིགས།",
    "ཅོལ་ཆུང་གི་ཁ་ཤགས་དང་རང་བསྟོད་ཚིག་རྒྱན་དུ་རློམ་སྟེ་ཁྱི་ལུད་མི་ཟད་པའི་ཕུང་པོར་སྤུངས་པ།",
    "ནང་ན་རྙེད་བཀུར་གྲགས་འདོད་རང་མཐོང་ང་རྒྱལ་ཕྲག་དོག་གི་དུག་ཆུ་ཁོལ་བའི་ཉེས་པར་གདོན་མི་ཟ།",
    "བདག་གི་སྐྱབས་རྗེ་སྙིགས་དུས་ཀྱི་འཇིགས་མཛད་གྲུབ་པའི་ཁྱུ་མཆོག་ཨ་བྷྱའི་མཚན་ཅན་དཔལ་བཟང་པོའི་ཡང་སྤྲུལ་ལ་ཡི་ག་འགོག་པའི་བྱེད་ངན་རྒྱ་སྐྱེགས་ཀྱི་ཚིགས་མ་མི་སྒྲོན་པར་གསོལ།",
    "ཁྱེད་ཀྱི་རིགས་པའི་གད་རྒྱངས་དང་སེངྒེ་ཁྲོས་པའི་ང་རོ་ངོ་ཚའི་དྲི་མས་མ་གོས་པར་རང་ཉིད་སྒྲོག་ག་པ་ལཀུན་ནས་རྒྱུག་པ་འདི་དག་མ་འོས་པའི་ཕེར་ཤ་དང་མི་འཚམ་པའི་མཁས་ཉམས་ཧ་ཅང་ཐལ་དྲགས་པ་ལ་ཁོ་བོས་ལུང་དང་རིགས་པས་དཔྱད་པ་ཅུང་ཟད་ཅིག་བགྱིས་ཏེ་དགག་སྒྲུབ་ངེས་དོན་བློ་མཆོག་མགུ་བའི་མཆོད་སྤྲིན་དུ་བསྲིངས་པ་དེ་གའི་སུག་པར་སོན་པའི་ཚེ།",
    "བློ་བཟང་ཉིད་དམ་གཞན་དག་གིས།",
    "སུ་ལ་བྱུང་ཡང་ཐ་ཤལ་རྟགས་ཀྱིས་སྤྲས་པའི་རིགས་སུ་བཞུགས་ཡོད་པར་དོགས་པས་བདག་གི་ཡི་གེ་ཡི་གར་འོངས་ནའང་དག་བརྗོད་ཞལ་ནས་འབྱིན་དཀའ་བར་སེམས་མོད།",
    "དེ་ལུགས་ཀྱི་ལན་མོལ་ཞིབ་པར་སྤེལ་སྟངས་མི་གཡེལ་བ་དང་།",
    "དགག་པ་འདི་ཆུ་བྱ་ལོའི་དབྱར་གནས་ཀྱི་སྐབས་སུ་བརྩམས་ཟིན་མོད།",
    "ས་ཐག་རིང་བས་འཁྱེར་པོ་གདེང་ཁེལ་མ་རྙེད་ཕྱིར་ད་བར་ལུས་པའང་དགོངས་ཀློང་ཟབ་མོར་འཇགས་པའི་དབྱིངས་ནས།",
    "མཆིལ་མའི་ཐལ་བ་འབུམ་ཕྲག་འབེབས།",
    "ལ་རྒྱ་སྐྱོང་བ་ཁྱོད་ཀྱི་ལུགས།",
    "ཁྱོ་ག་ཤི་བས་འཚངས་པ་མོ།",
    "ཁྱོད་ལྟ་བརྩེ་བ་བསྐྱེད་པའི་ཡུལ།",
    "གུང་ཐང་བློ་གྲོས་ཞལ་སྔ་ནས་ལ་རྩོམ་སྐུལ་གྱི་ཡི་གེ་ཕུལ་ཅེས་ངེད་ཀྱིས་ཨ་ཁུ་བློ་གྲོས་ཚང་ལ་ཞུས་ཚུལ།",
    "རང་ཉིད་ནས་ཀྱང་ཡོད་རྒུ་རྩལ་སྤྲུགས་ཀྱིས་བརྒལ་ལན་འབྲི་བཞིན་ཡོད་ཚུལ་ཁོ་རང་གི་དྲུང་ནས་སྔ་ཕྱིར་འོངས་པ་དུ་མས་བསྙད་དེ་ལོ་གྲངས་དྲུག་བདུན་ཙམ་སོང་ཞེས་བསྐལ་པའི་མེ་དཔུང་བརྩམས་པ་ཡུན་རིང་འགོར་ལུགས།",
    "མཇུག་ཏུའང་རང་ཉིད་ཀྱིས་ཀུན་གླིང་ཚོང་དཔོན་ལ་ལས་བཅོལ་ཏེ་འདི་གའི་དཔར་མ་ཆུ་སྤྲེལ་ལོར་ཁྱེར་བ་ལ་ཆུ་བྱའི་ལོར་སྐུ་འབུམ་པ་དགེ་རྒྱམ་ནས་ཆེད་དུ་བྱིན་ཚུལ་དང་།",
    "ཁྱེད་རང་གི་གཉུག་མའི་སྤྱོད་ཚུལ་ཡ་ང་བ་བཅོས་སུ་མ་མཆིས་པའི་སྤྲུལ་གཟུགས་འདི་འདྲ་ཅི་ཞིག་ཡིན་ཨང་།",
    "གཞན་གྱིས་ཧ་མི་གོ་བའི་ལུགས་སུ་བྱས་ན་དེ་ལྟར་འགྱུར་བའང་སྲིད་མོད།",
    "ཁྱོད་ལ་དགག་པ་རྩོམ་རྒྱུ་དེ་ཙམ་དཀའ་བའི་གནས་ཡིན་ནམ།",
    "ཨ་ཁུ་ཚང་ལ་དེ་འདྲའི་གླེང་ཙམ་ཡང་མེད་དོ།",
    "དཔལ་གདོང་གི་སྔ་རོལ་ལོ་དྲུག་བདུན་ནས་བསྐལ་མེ་རྩོམ་རྒྱུ་ལྟ་ཞོག་ཁྱོད་ཡིག་གྲོག་མའི་སྤོས་ཤུལ་ཙམ་ཡང་མ་མཐོང་།",
    "ཚོང་ཀུན་གླིང་ཚོང་དཔོན་ལ་ལས་བཅོལ་བ་རྨི་ལམ་ནའང་མེད་པར་མ་ཟད།",
    "རང་གི་ལག་ཉར་སེངྒེའི་ང་རོ་གཉིས་ཆེད་གཉེར་གྱིས་བསྐུར་བ་ཡིན་པ་ལ་ངེད་ཀྱིས་བཙལ་བའི་ཁུངས་སུ་བསྒྱུར་བ་འདི་ཅི་ཡིན།",
    "ཁྱོད་ཀྱི་བྱ་སྤྱོད་ཐམས་ཅད་འདི་འདྲ་ཤ་སྟག་ཏུ་ཟད།",
    "ཨ་ངོ་ཚས་མ་གོས་པ་ཁྱོད་རང་མི་ཡིན་ནམ།",
    "གད་རྒྱངས་དང་ང་རོ་གཉིས་མཉམ་དུ་ཁྱེར་ན་ལེགས་ཞེས་བློ་བཟང་རང་གིས་སྨྲས་ཟེར་བ་ལོས་བདེན།",
    "རབ་ཏུ་བྱུང་བའི་རྟེན་ལ་ངོ་ཚ་ཁྲེལ་མེད་ཀྱི་སྤྱོད་ངན་འདོད་ཆེན་དང་ཆོག་མི་ཤེས་འདི་ལྟ་བུས་འཚོ་བ་ལས་ཁྱིམ་པར་བབས་ནས་ས་རྐོ་ཕྲུ་སློག་གི་འདུ་འཛི་མང་པོ་མི་སྤེལ་བར་བློ་བཟང་།",
    "ཨ་རོལ་ཚང་།",
    "ཁྱོད་རང་གི་སྐད་ཆ་ཡང་ཞིབ་མོར་ཐོས།",
    "དེ་ཚེ་ཁོ་པ་ནས་ཁ་སྒང་གི་དགག་ལན་དང་།",
    "བླ་བྲང་ལ་བསྐུར་བའི་ཡི་གེ་གཉིས་ཡོད་པས་གཟིགས་སམ་ཟེར་བ་ལ་ངེས་པར་བལྟ་དགོས་པས་ཁྱེར་ཤོག་བྱས།",
    "དེ་ཡང་ཁོང་གི་ལུགས་ཏེ་ངེད་ཀྱི་ན།",
    "བཟེ་རེ་ཅན་ལ་སྡུག་བསྔལ་ཆུང་ངུ་ཡང་།",
    "ཆེན་པོར་འགྱུར་བར་སྨྲ་བའི་མཆོག་གིས་གསུངས།",
    "མི་ལུས་ཁོག་པ་རུལ་བའི་ལྗོན་པར་སོང་།",
    "ནང་གི་ལྕམ་སྲས་ཚ་གྲང་ལྟ་བུར་ལྟོས།",
    "ཁྱོད་ཉིད་འབའ་ཞིག་དགའ་མགུའི་གོ་འཕང་འཛིན།",
    "བདེ་ལྡན་ཞིང་གི་པདྨའི་ཁྲི་ལ་འཛེགས།",
    "རང་གི་བདེ་བ་བདེ་བར་མི་འཚལ་བའི།",
    "མི་དེ་ཅེ་རེ་ལོང་བ་བླ་ན་མེད།",
    "མངོན་དང་ལྐོག་ན་མོ་ཡི་ལྕེ།",
    "བདག་གིས་ཐལ་མོ་ལན་བརྒྱར་སྦྱོར།",
    "དེས་ཀྱང་སོམ་ཉིའི་ཁྱོགས་ལ་དཔྱངས།",
    "ལྕོག་གི་བརྟགས་ལན་སྟོང་མིན་ནམ།",
    "སྐད་ཅིག་རེ་ལ་གྲོས་རེ་གཤོམ།",
    "མི་རེའི་ཐད་དུ་དོན་རེ་སྤེལ།",
    "གོང་གི་གསུམ་གྱི་གྲིབ་བསིལ་ལ།",
    "འོག་གི་དྲུག་པོ་བདེ་བར་སྨོན།",
    "ཁྱད་པར་འདོད་ཁམས་བདག་མོ་རེ་མ་ཏིས།",
    "ཉོན་མོངས་གཡུལ་ལས་ངེས་རྒྱལ་འགྱུར།",
    "གཙུག་ལག་ཁང་གི་བྱ་རོག་སྐྲོད་ནུས་པ་ཞིག་དགོས།",
    "དགོང་ཁར་བསྟན་འགྲོའི་སྤྱིའི་སྐུ་རིམ་དང་མཚན་མོའི་སྐྱོར་སྦྱང་ལ་འབད་པ་གལ་ཆེ།",
    "སྡོམ་དགྲ་བུད་མེད་ཞག་ཏུ་བསྡད་པའི་ཆད་པ་དང་།",
    "གྲྭ་ལོག་གི་འགྲིག་ཀྱང་སྔར་ལྟར་ཡིན།",
    "རྡོ་དབྱུག་གིས་འཛིངས་པ་ལ་ཕྱག་སུམ་བརྒྱ།",
    "མཚོན་ཆས་འཛིངས་པ་ལ་མར་རྒྱ་མ་གསུམ་དང་ཇ་རྒྱ་མ་གང་གི་མང་ཇ།",
    "བདག་འཇུག་དང་བོད་ལོའི་སྐུ་རིམ་གཉིས་ཀྱི་རྗེས་མ་ཟིན་ན་སྒོར་མོ་ལྔ།",
    "དེའི་གཅིག་གི་རྗེས་མ་ཆོད་ན་ཡང་སྒོར་མོ་ལྔ་སྟེར་དགོས་པ་སྔར་བཞིན་ཡིན།",
    "མཚར་སྡུག་སྟོང་གི་དྭངས་མར་འཛགས་པའི་སྐུ།",
    "མཚེ་མར་བདུད་རྩིའི་རོ་ལྡན་གསུང་གི་འཕྲིན།",
    "ཆུ་ཚོད་དགུ་བརྒྱས་བདག་གི་སུག་པར་འབྱོར།",
    "དེ་ཚེ་དེ་ལ་མིག་གི་མེ་ན་ཀ།",
    "ཀུན་མཁྱེན་ཐུགས་ཀྱི་ཏོག་ལ་འགོངས་ནས་སོང་།",
    "རང་རེས་མྱོང་བའི་རིམ་པའང་བགྲང་ནུས་སམ།",
    "རང་གི་རབས་བདུན་ཚུན་ཆད་ལ།",
    "རང་རེར་ཡིད་ཆེས་ཛཱ་ཏིའི་དྲི་བྲལ་བས།",
    "གནས་སྐབས་ན་རེནྡྲ་སྟེ་མཐའ་མི་མཐོང་།",
    "རང་གི་ས་ན་རློམ་པ་སྦོམ་ལགས་ཏེ།",
    "རེག་གཅོད་རིག་པའི་རལ་གྲི་མཁའ་ལ་གདེངས།",
    "བུ་དང་ཆུང་མས་རང་གི་ལས་ལམ་འཛིན།",
    "ཤེས་རབ་རྒྱ་མཚོ་ཤེས་བྱའི་རྣམ་གཡེང་གིས།",
    "རང་རེ་མཛའ་འམ་མི་མཛའ་བ་འང་སྲིད།",
    "ལས་འབྲས་ཞིབ་མོར་བརྩིས་ན་དམ་པ་དངོས།",
    "པྲ་ཛྙཱ་ས་ར་མཆོག་གི་བློ་འཆང་བས།",
    "ལྷ་རེག་ཤིས་སྨོན་གྱིས་བརྒྱན་པ་བཅས་དགོན་ཤོད་བླ་བྲང་ཡང་སྟེང་ནས་ཤཱཀྱའི་དགེ་སྦྱོང་ཤེས་རབ་རྒྱ་མཚོ་འཇམ་དཔལ་དགྱེས་པའི་བློ་གྲོས་ཀྱིས་ཕུལ།",
    "དད་བརྩོན་ངོ་མཚར་གློག་གི་འཕྲུལ་འཁོར་འགྲིམ།",
    "རྟག་ཆད་གཡང་ལ་མིག་གི་འཇུག་པ་རྣོ།",
    "གཞན་ཕན་ཟབ་རྒྱས་གསང་བའི་ཐིག་གིས་འཁྲིད།",
    "བསམ་པས་ལམ་གྱི་རིམ་པ་རང་གིར་མཛད།",
    "རེ་སྐོང་ནོར་བུའི་གཏེར་ལ་྾།",
    "ལུགས་བཟང་སྲིད་ཞིའིཁྱོན་ལ་སྤེལ་བའི་ཁུར།",
    "སྡིག་ལྟུང་ཀུན་བཤགས་མཆོག་གི་མཛད་ལ་རངས།",
    "མཆོག་དང་མཐུན་མོང་དངོས་གྲུབ་སྩལ་དུ་གསོལ།",
    "གིས་རང་ལ་བསྟོད་པའི་རྩོམ་རྩེད།",
    "ཞེས་པ་འདི་གཟིགས་ནས།",
    "ཅེས་གསུངས་ན་བཟང་གི་ཨང་ཞེས་ཀུ་རེ་མཛད།",
    "རང་བཞིན་བརྗོད་པའི་ངག་གིས་མཚོན་པར་བྱ།",
    "མི་ཚན་ཚོམས་སུ་མ་གཅིག་རེ་མ་ཏཱིས།",
    "མདུན་དུ་གློག་གི་སྐུད་པ་ལྟར་བརྐྱངས་པའི།",
    "ཡ་མཚན་མི་མང་མིག་གི་བདུད་རྩིར་འཛགས།",
    "རང་གི་རྫུན་མཚང་འབྱིན་དོགས་པས།",
    "སྨྲ་བའི་རྩེ་མོ་ཅི་ཡང་གྱེས།",
    "རྨོངས་པའི་མི་འདའ་ཞིབ་མོར་དཔྱོད་དང་ཀུན་བཟང་རྟག་བརྟན་དགེ་ལེགས་སྒོ།",
    "མཐོ་བར་བསྙེགས་པའི་སྔ་རབས་ཕལ་མོ་ཆེ།",
    "ཟག་ཟད་ལམ་འབྲས་མིག་གིས་མཐོང་བའི་ཉམས།",
    "སྟོན་པའི་ལུང་གི་བཅས་མཚམས་མཐའ་ཡས་པ།",
    "འཆད་པའི་ཁྲི་ལ་མགོན་ཁྱོད་ཅི་ཡང་མཛེས།",
    "ཕྲ་མོའི་སྟོང་པར་རོལ་བའི་རྣམ་འབྱོར་ལ།",
    "ཤེས་བྱའི་དཀྱིལ་འཁོར་མ་ལུས་བློར་སོང་བའི།",
    "གང་གི་གྲགས་པའི་མ་ལི་ཀ།",
    "མཐོ་རིས་བུ་མོ་རྗེས་ཆགས་ཅན།",
    "དེང་དུས་གཞི་ལམ་འབྲས་བུའི་ཆ་རེར་ཡང་།",
    "འཆད་པས་དོན་གཉེར་རེ་བ་ཡིད་བཞིན་སྐོང་།",
