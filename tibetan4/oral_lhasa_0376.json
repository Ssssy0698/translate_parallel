    "དེ་ལ་གུས་པར་སྦྱོར་བ་ནི་ཤིན་ཏུ་གུས་པས་སྦྱོར་བ་ཉིད་དོ།",
    "དེས་སེམས་མཉམ་པར་འཇོག་པར་མི་འགྱུར་བས་སོ།",
    "མཉམ་པར་གཞག་པའི་དུས་སུ་བྱིང་རྒོད་སྐྱོན་ཡིན་ཏེ།",
    "འབྲས་བུར་རྣམ་པར་གཞག་སྟེ།",
    "རྒྱུ་དང་འབྲས་བུ་ལ་དད་པ་ཡོད་ན་མཉམ་པར་འཇོག་པའི་བྱ་བ་འདོད་པ་ཡིན་པས་སོ།",
    "བརྩོན་འགྲུས་བརྩམས་པས་རྣམ་པར་རྟོག་པ་ལ་སོགས་པའི་སྐྱོན་དང་བྲལ་ནས་དགའ་བ་སྐྱེ་ལ་དགའ་བ་སྐྱེས་པ་ལས་ཞུལུས་དང་སེམས་ལས་སུ་རུང་བའི་མཚན་ཉིད་ཅན་ཤིན་ཏུ་སྦྱངས་པ་སྐྱེ་བས་སོ།",
    "དེས་གདམས་ངག་བརྗེད་པར་མི་འགྱུར་བས་སོ།",
    "འདི་ལྟར་དཔེར་ན་རྒྱལ་རིགས་གང་ཞིག་རྒྱལ་སྲིད་འདོད་པ་དེ་ལ་ཕན་པར་འདོད་པས་བསྐུལ་བ་ན་དང་པོ་གོ་གྱོན་པར་བྱེད་དོ།",
    "མི་མཐུན་པའི་ཕྱོགས་ལས་རྒྱལ་བར་བྱས་ནས་རྒྱལ་སྲིད་ཐོབ་པའོ།",
    "དེ་ནས་རྒྱུའི་མཐར་ཐུག་པ་ཐོབ་པར་འདོད་པས་ཚོགས་སོག་གོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་སློབ་དཔོན་དབྱིག་གཉེན་གྱིས་གཞུང་འགྲེལ་ལས་གོ་ཆ་ཆེན་པོ་བགོས་པ་ནི་སེམས་བསྐྱེད་པ་དང་པོ་ནས་བརྩམས་ཏེ་ལྷག་པའི་བསམ་པའི་བར་ལ་བྱའོ་ཞེས་གསུངས་སོ།",
    "མཚན་མར་ནི་མི་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གོ་ཆའི་བསྒྲུབ་པ་གསུངས་པ་ཡིན་ཏེ།",
    "མེ་ལྟ་བུའོ་ཞེས་རྣམ་པར་གཞག་གོ།",
    "དེ་ལ་དང་པོ་ལ་དྲོད་རྣམ་པར་གཞག་གོ།",
    "དེ་ལ་དྲོད་ནི་བདེན་པ་སོ་སོའི་བདག་ཉིད་ལ་སྣང་བ་ཐོབ་པའི་ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་མཚུངས་པར་ལྡན་པའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཉན་ཐོས་ཀྱི་ལམ་ལྡོག་པའི་སྒོ་ནས་འཕངས་སོ་ཞེས་གསུངས་སོ།",
    "བྱུང་བ་མེད་པར་འགྱུར་བས་མི་རྟག་པར་ཤེས་པར་བྱའོ།",
    "སྡུག་བསྔལ་གྱི་རྣམ་པ་བརྒྱད་པོའི་སྡུག་བསྔལ་ཉིད་ཀྱིས་སྡུག་བསྔལ་བས་སྡུག་བསྔལ་གྱི་བདེན་པའི་སྡུག་བསྔལ་གྱི་རྣམ་པར་ཤེས་པར་བྱའོ།",
    "མངལ་ནས་བྱུང་བ་ན་མི་གཙང་བའི་རྫས་སྣ་ཚོགས་ཀྱིས་གཟིར་བ་དང་།",
    "ཕྲད་པའི་སྡུག་བསྔལ་ཞེས་གང་གསུངས་པ་དེས་སྡུག་བསྔལ་གྱིས་སྡུག་བསྔལ་བ་ཉིད་རབ་ཏུ་བསྟན་ཏེ།",
    "མཛའ་བ་དང་བྲལ་བས་གང་འདོད་པ་བཙལ་ཏེ་མ་རྙེད་པ་ནི་སྡུག་བསྔལ་བའོ་ཞེས་གང་གསུངས་པ་དེས་འགྱུར་བའི་སྡུག་བསྔལ་ཉིད་ཡོངས་སུ་བསྟན་ཏེ།",
    "བྱུང་བ་མེད་པར་གྱུར་པས་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཡིན་པས་སོ།",
    "ཡང་ན་གང་མི་རྟག་པ་དེ་ནི་སྡུག་བསྔལ་བའོ་ཞེས་ཤེས་པར་བྱའོ།",
    "སྡུག་བསྔལ་གྱི་ཕྱོགས་ཀྱི་འདུ་བྱེད་རྣམས་བྱུང་བ་དེ་ཡང་གནོད་པར་བྱེད་པའི་རང་བཞིན་ཅན་ཡིན་པས་མི་རྟག་པ་ཉིད་ལ་བརྟེན་ནས་སྡུག་བསྔལ་གྱི་སྡུག་བསྔལ་ཉིད་ཅེས་བྱའོ།",
    "འཇིག་པའི་ཆར་གྱུར་པའི་མི་རྟག་པ་ཉིད་ནི་བྱུང་བ་མེད་པར་གྱུར་པ་ལ་བྱ་ལ།",
    "དེ་ལྟར་ན་ཡང་མི་རྟག་པ་སྐྱེ་བ་ལ་སོགས་པ་དང་ལྡན་པ་སྟེ་སྡུག་བསྔལ་བར་ཤེས་པར་བྱ་བ་ཡིན་གྱི།",
    "དེ་ལྟར་སྡུག་བསྔལ་གྱི་བདེན་པའི་སྟོང་པ་ཉིད་ཀྱི་རྣམ་པར་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་སྡུག་བསྔལ་གྱི་བདེན་པའི་བདག་མེད་པའི་རྣམ་པར་ཤེས་པར་བྱའོ།",
    "མ་ཐོབ་པ་ལ་ནི་མི་ཕྲད་པར་སྲེད་དོ།",
    "ད་ལྟར་བྱུང་བ་ལ་ནི་ལྷག་པར་ཆགས་པའི་རྗེས་སུ་འགྲོ་བའོ།",
    "ལོག་པར་ཚངས་པར་སྤྱོད་པ་ལ་ཚོལ་བའི་ཕྱིར་རོ།",
    "དེ་ལ་འདོད་པ་ཚོལ་བས་ནི་འདོད་པའི་ཁམས་ལས་ཡོངས་སུ་མ་གྲོལ་བར་དེ་ཉིད་དུ་སྡུག་བསྔལ་གྲུབ་པར་བྱེད་དོ།",
    "དེ་བཞིན་དུ་སྲིད་པ་ཚོལ་བས་ནི་གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་སུ་སྡུག་བསྔལ་འགྲུབ་པར་བྱེད་དོ།",
    "སྔོན་ཐོབ་པའི་དུས་འདས་པར་བྱེད་པའི་རྒྱུའོ།",
    "སྡུག་བསྔལ་དང་བྲལ་བ་ཡིན་པས་བདག་ཉིད་གཙང་བ་དང་།",
    "དེ་ལྟར་འགོག་པའི་བདེན་པའི་རྣམ་པ་བཞིར་ཤེས་པར་བྱའོ།",
    "རྣམ་པ་དེ་ལྟ་བུའི་བདེན་པ་ལ་གང་སྣང་བ་ཐོབ་པའི་ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་དང་མཚུངས་པར་ལྡན་པ་དེ་དྲོད་དེ།",
    "ཤེས་རབ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པ་སྟེ།",
    "གཅིག་ཏུ་ངེས་པར་གཟུང་བ་རང་བཞིན་མེད་པར་རྟོགས་པས་ཕྱོགས་གཅིག་ལ་ཞུགས་པ་དང་།",
    "གྲོགས་ནི་དེ་རྣམས་དང་མཚུངས་པར་ལྡན་པའི་སེམས་དང་སེམས་ལས་བྱུང་བའོ།",
    "དུས་དེ་ཉིད་དུ་རྒྱུད་ལ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་ཡོད་པར་གྱུར་པས་སོ།",
    "འདི་ནི་ཁྱད་པར་ཡིན་ཏེ།",
    "མི་མཐུན་པའི་ཕྱོགས་ངེས་པར་བསྲབས་པས་མི་བརྫི་བའི་ཕྱིར་སྟོབས་རྣམས་སོ།",
    "མ་དད་པ་ལ་སོགས་པ་མི་མཐུན་པའི་ཕྱོགས་བསྲབས་པར་ལྷག་པའོ།",
    "ས་བརྒྱད་པ་ལ་སོགས་པར་རྩོལ་བ་མེད་པར་ཤིང་རྟ་ལེགས་པར་དྲངས་པ་བཞིན་དུ་འགྲོའོ།",
    "དེས་ཁྱད་པར་དུ་རྟོགས་པ་མཆོག་ཏུ་གྱུར་པ་སྟེ།་",
    "རྣམ་པར་མི་རྟོག་པའི་ཞི་གནས་དང་།",
    "དམིགས་པར་བྱ་བ་དང་དམིགས་པར་བྱེད་པ་མཉམ་པས་མཉམ་པར་ཤེས་པ་ཡང་དེ་ཡིན་ཏེ།",
    "འཛིན་པ་དེ་ཁོ་ན་ཉིད་མངོན་དུ་བྱས་པས་སོ།",
    "རང་དང་གཞན་གྱི་རྒྱུད་གཉིས་ཀ་ལ་ཁྱད་པར་མེད་པར་བདག་དང་།",
    "དེ་བཞིན་དུ་བདེན་པ་ལྷག་མ་རྣམས་ལ་ཡང་བཟོད་པ་དང་ཤེས་པ་རྣམས་ཇི་ལྟར་རིགས་པར་ཤེས་པར་བྱའོ།",
    "ཤེས་པ་རྣམས་ཀྱིས་ནི་འཛིན་པར་རྟོགས་སོ།",
