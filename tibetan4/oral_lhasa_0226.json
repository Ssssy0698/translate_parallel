    "ཕྱོགས་ཆན་དུས་གསུམ་གྱི་རྗེ་བཙུན་རྩ་བ་དང་བརྒྱུད་པར་བཅས་པའི་དབལ་ལྡན་༤༥ ཀྱིས་བྱིན་གྱིས་རློབས་ཤིག།",
    "དེ་རྣམས་ཀྱི་སྐུ་གསུང་ཐུགས་ཡོན་ཏན་འཕྲིན་ལས་ཐམས་ཆོད་འོད་ཟེར་དཀར་དམར་མཐོང་གསུམ་ཀྱི་རྣམ་པར་སྤྱན་དྲངས་བ་རྣམས་སློབམའི་གནས་གསུམ་དུ་ཐིམ་པས།",
    "འདིར་ཨུཏྟིཥྛ་༡༧༡མཚམས་ནས་ཟིན་པ་འདྲ་མཚུངས་ཞེས་བྱ་བའི་བྲསྟཱ་རས་མཛེས་པར་བྱས་པའོ།",
    "བརྩམ་པར་བྱ་བའི་གཞུང་དངོས།",
    "བརྩམ་པར་དམ་བཅའ་བའོ།",
    "གཞུང་རྩོམ་པའི་ནུས་པ་ཡོད་པར་བསྟན་པ།",
    "འོན་ཀྱང་བརྒྱུད་པའི་མན་ངག་ལས་རྟོགས་ནུས་པར་བསྟན་པའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་བཀའ་ནི་རྒྱ་མཚོ་བཞིན།",
    "བཀའི་དགོངས་པ་ཕྱིན་ཅི་མ་ལོག་པར་རྟོགས་དགོས་པས་རང་དགར་རྟོགས་པ་ཡིན་ནམ་ཞེ་ན།",
    "ཐམས་ཅད་མཁྱེན་པའི་བཀའ་ནི་ཤིན་ཏུ་རྟོགས་པར་དཀའ་བའི་ཕྱིར་ཏེ།",
    "སྒྲ་ཇི་བཞིན་པ་དང་སྒྲ་ཇི་བཞིན་མ་ཡིན་པ་ལ་སོགས་པ་། དགོངས་པ་དུ་མས་གསུངས་ཤིང་།",
    "རྡོ་རྗེ་ལྟར་ཕྱེད་པར་དཀའ་བས་ན་རྡོ་རྗེའི་ཚིག་སྟེ་རྒྱུད་གསུམ་དང་།",
    "རྗེས་འཇུག་སྐྱེ་བོས་བཀའ་རྣམས་རྟོགས་པར་འགྱུར།",
    "དེ་ལྟར་རྟོགས་པར་དཀའ་ན།",
    "རྟག་ཆད་ལ་སོགས་པ་ལྟ་བ་ངན་པའི་མཐའ་འཇིག་པར་ལུང་བསྟན་པ་འཕགས་པ་ཀླུ་སྒྲུབ་དང་།",
    "ཞེས་གསུངས་པའང་འདི་འདྲའི་རིགས་ཅན་ལ་དགོངས་སོ།",
    "ཞེས་སོགས་མང་དུ་གསུངས་སོ།",
    "དེ་ལ་བཀའ་ཕྲིན་མི་འགོག་ཅེས་པའི་གཞུང་དུ་སྣང་ན་རྩོམས་ཤིག་ཅེས་བསྐུལ་བའི་བཀའི་ཕྲིན་ཡིག་མི་འགོག་པའི་ཕྱིར་ཞེས་པར་སྦྱར་ལ།",
    "གཉིས་པ་བརྩམ་པར་བྱ་བའི་གཞུང་དངོས་ལ་དོན་གཉིས་ཏེ།",
    "ནམ་ཞིག་དེ་སྐྱེས་པའི་ཚེ་སོ་སོ་ངོ་ཤེས་པར་བྱས་ནས་བྱུང་རྒྱལ་གྱིས་བསྐྱང་བའོ།",
    "ཞེས་གསུངས་པ་དང་དོན་གཅིག་གོ།",
    "རྒྱུད་ལས་གསུངས་པའི་གོ་རིམ།",
    "གཅིག་ནས་གཅིག་བརྒྱུད་ཤེས་པར་བྱ།",
    "རྟོག་གེ་པ་དག་རང་དགར་འཇུག་པ་དགག་པའི་ཕྱིར་དུ་དཀྲུགས་ནས་གསུངས་སོ།",
    "གཉིས་པ་སྤྲོས་པ་གཅད་པར་བྱ་བ་ནི།",
    "ས་བཅུ་གསུམ་པར་འགྲོས་བཞི་ཐིམ་པའོ།",
    "འདིར་རྣམ་པར་རྟོག་པ་བཞི་འབྱུང་སྟེ།",
    "གཞན་རྣམས་བསྟན་པ་ལ་དགོས་པ་མེད་པར་འགྱུར་རོ།",
    "རྣམ་པར་ཕྱེ་བས་སྒྲོ་སྐུར་བྲལ་བར་མཛོད།",
    "གདོན་གྱིས་བྱས་པ་ཡིན་ནོ་ཞེས་སྒྲོ་འདོགས་པར་བྱེད་ལ།",
    "ཏིང་ངེ་འཛིན་གྱི་ཉེ་རྒྱུ་རྟོགས་པར་བྱ།",
    "གང་ཡང་ཏིང་ངེ་འཛིན་དུ་མཁྱེན་པར་མཛོད།",
    "གང་ལའང་ཞེན་པ་མི་བྱ་བར་ངོ་ཤེས་པར་བྱས་ནས་བསྐྱང་བ་ནི་བྱུང་རྒྱལ་དུ་བསྐྱང་བའི་དོན་ཏོ།",
    "ཏིང་འཛིན་ཉམས་ཀྱི་བྱེ་བྲག་རྟོགས་པར་མཛོད།",
    "ལམ་གྱི་ས་མཚམས་ཐེ་ཚོམ་མེད་པར་མཛོད།",
    "བདུན་པོ་འདི་དག་ནི་གོ་རིམ་ཅུང་ཟད་ཙམ་མ་གཏོགས་རྗེ་བཙུན་ཆེན་པོས་འཇིག་རྟེན་པའི་ལམ་གྱི་སྐབས་སུ་ཤེས་པས་ཕན་འདོགས་པའི་མན་ངག་བདུན་གསུངས་པ་དང་དོན་གཅིག་ཏུ་ཤེས་པར་བྱའོ།",
    "བཞི་པོ་དེ་དག་ཕྱིའི་བདུད་ཀྱིས་བྱས་པ་ལ།",
    "བར་ཆད་རིམ་གྱིས་སེལ་བ་ཤེས་པར་བྱ།",
    "བདེ་བ་བསྒོམ་དང་རྣམ་པ་གསུམ་དུ་གསུངས།",
    "རིག་པ་སེམས་ཀྱིས་འཚིར་གནོན་བྱས་པས་ཞི་བའོ།",
    "འོག་གསང་བའི་སྙོམས་འཇུག་ལ་བརྟེན་པ་གཉིས་གསུངས་སོ།",
    "ལ་དོར་མན་ངག་དྲུག་ཏུ་ཤེས་པར་བྱ།",
    "རྣམ་པ་གཅིག་ཏུ་ན་གེགས་སེལ་རྣམས་སྐབས་འདིར་ཕྱོགས་གཅིག་ཏུ་བསྟན་པར་བཞེད་ནས་གཉིས་པོའང་འདིར་གསུངས་པ་ཡིན་པས།",
    "ཁ་སྦྱོར་དག་ལ་བརྟན་པར་གྱུར་པ་དང་།",
    "ལུས་ལ་ཐིག་ལེ་གཡོ་བ་མེད་བཅུ་དྲུག་པར་བྱ།",
    "ཀུན་ཏུ་ཁྱབ་ཅིང་བརྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཕྱག་རྒྱའི་གཟུགས་ལ་བལྟ་བ་ནས་སྒྲ་ལ་བསླབ་པའི་བར་རྣམ་པ་སྣ་ཚོགས་པའི་སྐད་ཅིག་མ་དང་རྡོ་རྗེ་དང་པདྨ་མཉམ་པར་སྦྱོར་བ་རྣམ་པར་སྨིན་པའི་སྐད་ཅིག་མ་ཉིད་ཀྱི་ཚེ་ཐིག་ལེ་འབར་བའི་དྲོད་འབྱུང་སྟེ།",
    "བསྲུབས་པ་ལ་སོགས་པའི་སྒོ་ནས་ཕྱག་རྒྱ་རྣམ་པར་ཉིད་པའི་སྐད་ཅིག་མ་ལ་ནི་ཐིག་ལེ་གཡོ་བའི་དྲོད་འབྱུང་ལ།",
    "དེའི་ཚེ་ཁ་སྦྱར་དག་ལ་བརྟན་པར་གྱུར་ནས།",
    "ལུས་ལས་ཕྱི་རོལ་དུ་ཐིག་ལེ་གཡོ་བ་མེད་པར་བྱའོ།",
    "ལག་པ་རྐེད་པར་འཇུས་ཏེ་སྐྱིལ་ཀྲུང་བཅས་ནས་རོ་སྟོད་སྒུལ་བའོ།",
    "གང་ཡང་ཉམས་ཀྱི་སྣང་མབར་མཁྱེན་བགྱིས་ན།",
    "འཇིགས་ཤིང་ཉམ་ང་བ་ལ་སོགས་པ་ལ་ཡང་དོགས་པ་མི་བྱ་བར་གང་ཡང་ཉམས་ཀྱི་སྣང་བར་ཤེས་པར་བྱས་ན་བདུད་དང་གོལ་ས་རང་གྲོལ་དུ་འགྱུར་རོ་ཞེས་པའོ།",
    "ཐེ་ཚོམ་མེད་པར་བརྩོན་པ་ཆེར་མཛད་ན།",
    "བདག་ལྟ་འདུ་བའི་ནང་ཞུགས་ནས་། སྒྲུབ་ལ་དད་ཀྱང་ལྷོད་པར་འགྱུར།",
    "མཁའ་འགྲོས་དཔང་མཛོད་བཟོད་པར་གསོལ།",
    "སྣང་བ་གསུམ་གྱིས་ཉམས་ལེན་གྱི་གཞི་བྱས།",
    "ཉམས་ལེན་གྱི་དངོས་གཞི་རྒྱུད་གསུམ་གྱིས་བྱས།",
    "རྒྱ་ཆེན་མཁྱེན་པའི་དཀྱིལ་འཁོར་རབ་ཏུ་རྒྱས།",
    "རྗེ་བཙུན་བིརླ་པས་རྣམ་པར་བཀྲལ་བའི་ལམ་རྒྱས་པ་འདི་ཡིན་ནོ།",
    "ཁྱད་པར་ལམ་སྐོར་དགུ་བྱུང་ཚུལ།",
    "གཞན་ཡང་མཁས་པ་དང་གྲུབ་པ་བརྙེས་པའི་སྐྱེས་བུ་དུ་མ་བྱོན་ནས་བསྟན་པ་ཡུན་དུ་གནས་པར་མཛད་པ་ཡིན་ནོ།",
    "ཆང་ལ་ཉི་མ་གཏེང་པར་བཅུག།",
