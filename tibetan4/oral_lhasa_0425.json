    "གདུལ་བྱ་རྣམས་བསླབ་པ་གསུམ་དང་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ལ་གེགས་མེད་དུ་འགོད་པར་གྱུར་ཅིག།",
    "འགྲོ་བའི་དོན་དུ་བསྙུན་པ་མི་མངའ་ཞིང་སྐུ་ཚེའི་རྒྱལ་མཚན་བརྟན་པར་གྱུར་ཅིག།",
    "མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་ཉེ་བར་ཞི་བ་ཞེས་པ་ནས་བཅོམ་ལྡན་འདས་ཀྱི་གོ་འཕང་མྱུར་དུ་ཐོབ་པར་གྱུར་ཅིག།",
    "ཕྱི་བཞིན་དུ་འབྲངབ་དང་རྗེས་སུ་འཇུག་པར་གྱུར་ཅིག།",
    "རྟེན་དེ་ལམཐོ་རིས་ཀྱི་ཡོན་ཏན་བདུན་དང་ལྡན་པར་གྱུར་ཅིག།",
    "བརྩོན་འགྲུས་དང་བཟོད་པའི་སྒོནས་བདག་ཉིད་ཀྱི་དོན་མཆོག་ཏུ་སྒྲུབ་པའི་བསམ་གཏན་དང་ཤེས་རབ་ཀྱི་སྒོ་ནས་གཉིས་གའི་དོན་སེམསཉིད་རྣམ་པར་གྲོལ་བ་ལ་འགོད་པའི་སྦྱིན་པ་དང་།",
    "སྙན་པར་སྨྲ་བ་དང་།",
    "ཅུང་ཟད་རྒྱསཔར་བྱེད་ན།",
    "གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་ལསའདས་པའི་བསམ་གཏན་བླ་ན་མེད་པ་ལ་མཉམ་པར་འཇོག་པའི་སྐུལ་བ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "ཕ་རོལ་དུ་ཕྱིན་པ་ལ་དོན་མཐུན་པའི་སྒོ་ནསསྒྲུབ་པ་རྣམ་པར་དག་པ་ལ་འགོད་པའི་སྐལ་བ་དང་ལྡན་པར་གྱུར་ཅིག།",
    "དཀའ་བ་སྤྱད་པ་མེད་པརཡང་།",
    "མིགཙང་ལུས་འདི་བོར་བར་གྱུར་མ་ཐག།",
    "སྤྲུལ་པས་ཕྱོགས་བཅུར་གཞན་དོན་བྱེད་པར་ཤོག།",
    "བསྔོབའི་མགོར་སྐབས་འདིརམཐུན་འགྱུར་ཐུགས་ལ་འདོགས་པར་ཞུ་ཞེས་བརྗོད་དགོས།",
    "ཡུལ་ཁྱད་པར་ཅན་ལ་མཆོད་བསྔོར་བྱེད་ན།",
    "དེ་ཙམ་མམ་ཅུང་ཟད་རྒྱསཔར་སྤྲོ་ན།",
    "སྙོམས་འཇུག་དང་ཤེས་བྱའི་སྒྲིབ་པ་མཐའ་དག་རྩ་བ་ནས་བྱང་ཞིངདགཔར་གྱུར་ཅིག།",
    "སྐུ་བཞི་ཡེ་ཤེས་ལྔའི་བདག་ཉིད་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་སངསརྒྱས་ཀྱི་གོ་འཕང་མྱུར་དུ་ཐོབ་པར་གྱུར་ཅིག།",
    "བཀྲ་ཤིས་གྱི་ཚིགས་བཅད་ཅི་རིགས་པར་བརྗོད་དོ།་",
    "གཞན་ཡང་རབ་བྱུང་བསྙེན་རྫོགས་བྱས་པའམ།",
    "ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་།",
    "མཁྱེན་པས་ཤེས་བྱ་མ་ལུས་པ་མཁྱེན་པ་འཕགས་པ་འཇམ་དཔལལྟབུརགྱུར་ཅིག།",
    "ཅེས་པ་ལ་སོགས་པ་ཇི་ལྟར་རིགས་པར་སྦྱར་རོ།",
    "ལེགས་པར་སྦྱངས་པའི་བློ་གསལ་རྣམག།",
    "བཀྲ་ཤིས་པར་ཤོག།་",
    "ཡི་རང་བསྔགས་པ་བརྗོད་པའི་ལེགསབྱསསོགས།",
    "རྣམ་དཀར་འཕྲིན་ལས་ལེགས་བྱས་རྒྱ་མཚོའི་ཚོགས།",
    "མཆོག་ཏུ་རྒྱ་ཆེན་སྟོབས་ལྡན་འགྲུབ་པར་ཤོག།",
    "ནམཡང་རྒྱུན་མི་ཆད་པར་སྐྱེ་བར་ཤོག།",
    "རྡོ་རྗེ་སློབ་དཔོན་ཀུན་དང་ཁྱད་པརདུ།",
    "འཇུག་པར་སྤྲོ་ན་གཞན་ལྟ་སྨོས་ཅི་དགོས།",
    "རང་འདོད་མེད་པར་ཁྱེད་ཀྱིསཅི་གསུངས་དང་།",
    "ཐུགས་སུ་ཅི་དགྱེས་ཐམས་ཅད་བསྒྲུབ་པར་ཤོག་ཁྱེད་ནི་འཁོརའདས་ཀུན་ཁྱབ་མཛད་པ་ཅན།",
    "དེ་འདྲའི་ཐབས་ཚུལ་མཐའ་ཡས་འགྲུབ་པར་ཤོག།",
    "རང་གཞན་དོན་གྱི་མཆོག་ཀུན་འགྲུབ་པརཤོག།",
    "ཁྱབ་པརབྱེད་པའིའཕྲིན་ལས་སྒྲུབ་པར་ཤོག།",
    "རྟག་ཏུ་མཐའ་ཡསའགྲོ་བ་སྨིན་པར་བྱེད།",
    "ཕུན་ཚོགས་བསམ་གྱིས་མི་ཁྱབ་རྟག་པར་འབྱོར།",
    "ཇི་བཞིན་འགྲུབ་ཅིང་རྒྱ་ཆེན་འགྲུབ་པར་ཤོག།",
    "གེགསམེད་འགྲུབ་ཅིང་འབད་མེད་འགྲུབ་པར་ཤོག།",
    "བཀྲ་ཤིསདགེ་ལེགས་ཕུན་སུམ་ཚོགསཔར་ཤོག།",
    "པེ་ཅིན་མའོ་རིན་ཚོན་ཁྲ་པར་འདེབས་ཀུང་སིས་དཔར་བཏབ།",
    "སྤྱི་ལོ་༢༨ལོའི་ཟླ་༤པར་པར་གཞི་དང་པོ་བསྒྲིགས།",
    "སྤྱི་ལོ་༢༨ལོའི་ཟླ་༤པར་པར་ཐེངས་དང་པོ་བཏབ།",
    "དཔར་གྲངས།",
    "དཔར་ཡོན་ཞལ་འདེབས་གནང་མཁན།",
    "ཀ་མད་ཀྱི་གོ་རིམ་ལྟར་ལགས།",
    "བཅོམ་ལྡན་འདས་ལ་ཞུ་བ་མཁྱེན་པར་གསོལ་བ་བསྟན་པ།",
    "༥ ༡གསོལ་བ་བཏབ་པའི་དོན་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་མངོན་དུ་ཕྱོགས་པར་མཛད་པ་བསྟན་པ།",
    "༩༡གཟུངས་ཀྱི་ངོ་བོ་འཐོབ་པར་བྱ་བའི་ཐབས་ལ་གནས་པའི་ཕན་ཡོན་དུ་དེ་བསྟན་པ།",
    "དེའི་སྔོན་བྱུང་བ་བསྙད་པ་བརྗོད་པར་བྱ་བ་བསྟན་པ།",
    "༢༦༢སློབ་དཔོན་མཁས་པ་ཛི་ཏཱ་རི་དགྲ་ལས་རྣམ་པར་རྒྱལ་བས་མཛད།",
    "༢༦༥སློབ་དཔོན་ཛེ་ཏཱ་རི་དགྲ་ལས་རྣམ་པར་རྒྱལ་བས།",
    "༡༦༡༣ འཇམ་དབྱངས་སྨྲ་བའི་སེང་གེའི་སྒྲུབ་ཐབས་བཞུགས།",
    "རྒྱ་གར་ཤར་ཕྱོགས་ཛ་ག་ཏཱ་ལའི་པཎྜི་ཏ་ཆེན་པོ་དཱ་ན་ཤཱི་ལས་ལྷའི་སྐད་ལས་བོད་ཀྱི་བརྡར་འཁྲུལ་པ་མེད་པར་བསྒྱུར།",
    "༥༦༣ཏིང་ངེ་འཛིན་མྱུར་དུ་བསྐྱེད་པའི་གདམས་ངག་༥༦༤ཏིང་ངེ་འཛིན་བརྟན་པར་བྱེད་པའི་གདམས་ངག་༥༦༦སེམས་བརྟན་པར་བྱེད་པ།",
    "༥༧༤རྨི་ལམ་གྱི་ལྟ་བ་ངན་པ་རྣམ་པར་བཟློག་པ།",
    "༦༢༨གཞན་ལས་རྣམ་པར་རྒྱལ་བའི་གདམས་ངག་ཕ་རོལ་གྱི་གནོད་པ་བསྲུང་བ།",
    "༧༡༩པར་གྲུབ་པ་བརྙེས་པའི་སྐྱེས་བུ་ཆེན་པོ་ཤྲཱི་ཤཱནྟ་ཀ་རས་མཛད།",
    "བྱས་པ་ལ་བསྡུར་མཆན།",
    "༨༢༥པར།",
    "༡༦༩ གསང་སྔགས་ཀྱི་བཟླས་བརྗོད་བཞུགས།",
    "དེ་དང་འདྲ་དཔར་༡༦༩༤ ཕྱག་ན་རྡོ་རྗེ་གོས་སྔོན་པོ་ཅན་གྱི་སྒྲུབ་པའི་ཐབས།",
    "༡༡༦༨དཔལ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་སུ་བྱ་བ་ས་དང་འབྲེལ་བ།",
    "༡ ༡༦༨པ་ལ་དཔལ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་སུ་བྱ་བ་ཆུ་དང་འབྲེལ་བ།",
    "འབྱུང་པོའི་གདོན་རྣམ་པར་སྐྲག་ཅིང་ཚར་གཅོད་པར་བྱེད་པ།",
    "༡༡༨༩གཞན་གྱི་རིག་སྔགས་ཀྱི་ལས་ཐམས་ཅད་གཅོད་པར་བྱེད་པ།",
    "༡༡༨༩ཕ་རོལ་གྱི་རིག་སྔགས་མནན་པར་བྱེད་པ།",
    "ལྷ་ལ་སོགས་པའི་གདོན་ཐམས་ཅད་རླག་པར་བྱེད་པ།",
    "༡༡༩༢རིག་སྔགས་ཀྱི་ལས་ཐམས་ཅད་བྱེད་དུ་འཇུག་པར་མངག་པ།",
    "ལས་མ་གྲུབ་ན་སྤོགས་པའི་ཆོ་གས་གྲུབ་པར་བྱེད་པ།",
    "ཚེ་དང་ལོངས་སྤྱོད་ལ་སོགས་པ་རྒྱས་པར་བྱེད་པ།",
    "༡༡༩༥རྨུགས་པར་བྱེད་པ།",
    "བཞུགས་༡༧༣༣ རྡོ་རྗེ་རྣམ་པར་འཇོམས་པའི་ལས་སྣ་ཚོགས་སྒྲུབ་པའི་ཆོ་ག་༡ ༡༩༩པཎྜི་ཏ་ཆེན་པོ་ཛྙཱ་ན་ཤྲཱི་དང་།",
    "༡༧༤༡ རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་བྱ་བའི་གཟུངས་ཀྱི་མན་ངག་༡༢༥༢ཞི་བའི་འཁྲུལ་འཁོར་གྱི་རྣམ་པར་དབྱེ་བ།",
    "༡༢༥ ༢རྒྱས་པའི་འཁྲུལ་འཁོར་གྱི་ལས་སུ་རིག་པར་བྱ་བ།",
    "༡༢༥༦དགྲའི་མངོན་སྤྱོད་ཀྱི་འཁྲུལ་འཁོར་རྣམ་པར་ཕྱེ་བའི་རིམ་པ།",
    "༡༢༥༦བགེགས་ཀྱི་མངོན་སྤྱོད་ཀྱི་འཁྲུལ་འཁོར་རྣམ་པར་ཕྱེ་བའི་རིམ་པ།",
    "༡༡༦༢རྒྱུད་ཀྱི་རྣམ་པར་བཞག་པ།",
    "༡༢༦༤༡༢༧༡༢༧༧དེབ་སོ་བདུན་པའི་དཀར་ཆགརྫས་དང་སྔགས་ཀྱི་གྲངས་གསུངས་པ།",
    "གཟུངས་འདི་ནི་དོན་དྲུག་ལ་བརྩམས་ནས་གསུངས་པར་མངོན་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལས་ལྡོག་པའི་རྒྱུ་ནི་དྲུག་སྟེ།",
    "དེའི་གཉེན་པོར་གོ་རིམས་ིབཞིན་དུ་སྒོ་དྲུག་པོ་དག་རིག་པར་བྱའོ།",
    "གསུམ་པ་དང་བཞི་པས་ནི་གེགས་༤སེལ་བས་བདག་ཉིད་ཀྱིས་བསྒྲུབ་པར་ནུས་པ་ཉིད་དོ།",
    "མ་དག་པའི་རྒྱུ་གནས་ངན་ལེན་གྱི་འབྲས་བུ་སྐྱེད་པའི་མཐུ་དང་མི་མཐུན་པར་བྱེད་པ་དང་།",
    "བརྟས་པར་བྱེད་པའི་རྒྱུ་ཡོངས་སུ་སྤོང་བས་སོ།",
    "བསམ་པ་རྣམ་པར་དག་པའི་འབྲས་བུ་ནི་བླ་ན་མེད་པའི་ཡེ་ཤེས་སོ།",
    "སྦྱོར་བ་རྣམ་པར་དག་པའི་འབྲས་བུ་ནི།",
    "རྣམ་པར་གྲོལ་བ་སྟེ་གནས་གྱུར་པའོ་། བླ་ན་མེད་པའི་ཡེ་ཤེས་དང་།",
    "རྣམ་པར་གྲོལ་བ་ནི་སྦྱོར་བ་རྣམ་པར་དག་པའི་འབྲས་བུ་ཡིན་ཏེ།",
    "རིགས་མཐུན་པའི་ཕྱིར་བླ་ན་མེད་པའི་ཡེ་ཤེས་ཉིད་བསམ་པ་རྣམ་པར་དག་པའི་འབྲས་བུར་རིགས་སོ།",
    "རྣམ་པ་དེ་ཉིད་ཀྱིས་ཡང་དག་པར་བསྒྲུབས་པའི་ཕྱིར་རོ།",
    "དེ་ནི་གནས་མ་ཡིན་པར་ཤིན་ཏུ་མངོན་བཞིན་འོན་ཀྱང་གཟུངས་དོན་རྣམ་པར་དབྱེ་བྱ་བར།",
    "མ་ཡིན་དམན་ཞིང་དོན་ཀྱང་མ་བྱས་པས།",
    "ཞུ་བ་ལ་ནི་ནན་ཏན་བྱས།",
    "རྒྱ་ཆེར་མཁྱེན་པར་གསོལ་བ་དང་།",
    "གླེང་གཞི་ཐུབ་པས་གསུངས་པ་འདི།",
    "དེ་དག་བྱིན་གྱིས་བརླབ་པར་བསྟན།",
    "བཙུན་པར་མི་འགྱུར་བསལ་བའི་ཕྱིར།",
    "གུས་པ་བསྐྱེད་པར་བྱ་བའི་ཕྱིར།",
    "ནུ་༧༣ སསཔསབདག་སྡུད་པར་བྱེད་དུ་བཅུག།",
    "དེ་གཉིས་མྱ་ངན་འདས་པར་བསྟན།",
    "བསྟན་པ་ཟད་པར་འདོད་པ་ཡིན།",
    "མངོན་དུ་ཕྱོགས་པར་མཛད་པ་ན།",
    "དོན་ཀུན་ཡང་དག་མཁྱེན་པ་སྟེ།",
    "དེ་སྤངས་ས་ཐོབ་འདི་ཡིན་པར།་།",
    "ས་ནི་རྟེན་བཞིས་ཐོབ་པར་འགྱུར།",
    "དགའ་དགུར་ཞིང་ནི་སྟོན་པར་བྱེད།་།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡོན་ཏན་གྱིས།",
    "འཛིན་པར་བྱེད་པས་དེ་ཕྱིར་གཟུངས།",
    "ཞུ་བ་ཉིད་དུ་རབ་ཏུ་གསུངས་། ཡང་ན་འབྲས་དང་ཐ་དད་པར།",
    "སྒྲོ་བཏགས་ཞུ་བ་ཉིད་དུ་གསུངས།",
    "ཐམས་ཅད་མཁྱེན་པའི་གོ་འཕང་ཐོབ།",
    "མི་གཙང་བ་ཡི་གཉེན་པོར་རམ།",
    "དོན་གསོལ་ཞལ་གྱིས་བཞེས་པས་ིན།",
    "འདིར་ནི་བསྲུང་བ་ལ་སོགས་གསུངས།",
    "དགག་པར་བྱ་བ་མེད་པས་ན།",
    "བྱ་བ་ལ་སོགས་བཅོམ་ལྡན་གསུངས།",
    "འབྲས་བུ་རྫོགས་པར་འཐོབ་འགྱུར་གྱི།",
    "མངོན་དུ་ཕྱོགས་པར་བྱེད་བཞིན་དུ།",
    "གསང་སྔགས་རན་པར་བརྗོད་བྱ་སྟེ།",
    "བརྗོད་པར་བྱ་བས་དེ་སྨོས་སོ།",
    "གསུངས་པའི་མིང་ནི་འདོགས་པ་དང་།",
    "འདི་ཞེས་གསུངས་པ་བརྗོད་བྱ་ཡིན།",
    "དེ་དག་དངོས་པོ་མེད་པར་བསྟན།",
    "འཕེལ་བ་ཐམས་ཅད་ཡིན་པར་བཞེད།",
    "ཡུལ་ལ་འཛིན་པར་མི་རུང་ངོ།",
    "ལྟོས་པར་གནས་པའི་ངོ་བོའི་ཕྱིར།",
    "བདེན་པར་བསམས་ན་གཟུགས་ལ་སོགས།",
    "དགག་པར་བྱ་བ་མེད་པས་ན།",
    "ལོངས་སྤྱོད་རྫོགས་པར་མཛད་པའི་སྐུ།",
    "ཅིག་ཤོས་བཅོ་བརྒྱད་ཤེས་པར་བྱ།",
    "གཟུངས་ཀྱིས་ཐོབ་པར་མི་འགྱུར་གང་།",
    "མིང་རྣམས་ལྔ་པོ་འདི་དག་ནི་། དོན་དང་མཐུན་པར་གསུངས་པ་ཡིན།",
    "ཐུགས་རྗེས་ཕན་ཡོན་ཡང་དག་གསུངས།",
    "རྒྱལ་བས་གསུངས་ཏེ་སྔ་མ་སྔ།",
    "བསྒྲུབ་པར་བྱ་ིབ་གང་ཡིན་པ།",
    "འདིར་ནི་དམིགས་པ་མེད་པར་བསྒྲགས།",
    "འཁོར་གསུམ་རྣམ་པར་དག་པའི་ཕྱིར།",
    "ཁྱད་པར་འདི་ལས་ཐོས་པར་འགྱུར།",
    "འོ་ན་དེ་རིགས་པར་ནི་སྦྱར་བར་ཟད།",
    "ཅི་རིགས་པར་ནི་རྟོགས་པར་བྱ།",
    "ཆེན་པོའང་ཡིན་པར་བཀའ་སྩལ་ཏོ་། གསང་སྔགས་ཚིག་ནི་སྔ་མ་ཡིས།",
    "བསྲུང་བའི་ཆོ་ག་འདི་བྱས་ལ།",
    "གཙང་མས་འདུ་དང་ཆགས་སྤངས་ཤིང་།",
    "སེམས་ནི་རྩེ་གཅིག་བྱས་ནས་སུ།",
    "བཟླས་ནས་བསྲུང་སོགས་ཕུན་ཚོགས་བྱས།",
    "ལོག་པར་བསམ་པར་མི་བྱའོ།",
    "གང་བྱས་པས་ནི་ཐོབ་འགྱུར་བ།",
    "བསྟན་པས་དེ་ལ་འཛུད་པར་བྱེད།",
