    "དེ་ལྟར་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་རྩ་བའི་ལྷག་མཐོང་ཡང་དག་པར་བསྟན་པའོ།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་སྦྱོར་བ་ཡང་དག་པར་བསྟན་པའོ།",
    "འདི་ལྟར་ལུས་དང་སེམས་ཤིན་ཏུ་སྦྱངས་པ་ཐོབ་པས་གནས་བྱས་པའི་ཕྱིར་དང་།",
    "ཏིང་ངེ་འཛིན་ལ་བརྟེན་ནས་ལྷག་མཐོང་སྐྱེ་བ་ཡང་གདོན་མི་ཟ་བར་ཐོས་པ་དང་བསམས་པའི་སེམས་རྣམ་པར་གཡེང་བས་སྦྱོར་བར་བྱེད་པའི་ཕྱིར།",
    "འདིས་ནི་ཐོས་པ་དང་བསམས་པའི་སྦྱོར་བ་ཉིད་ཡང་དག་པར་བསྟན་པ་སྟེ།",
    "ཞི་གནས་དང་ལྷག་མཐོང་གཉིས་ཀྱི་རྣམ་པའི་མཚན་ཉིད་ཐ་དད་པའི་ཕྱིར་ཏིང་ངེ་འཛིན་ཐོབ་པར་གྱུར་ཀྱང་ཡང་ཐོས་པ་དང་།",
    "ནང་དུ་ཏིང་ངེ་འཛིན་ཞེས་བྱ་བ་ནི་སེམས་བསྡུས་ནས་རྣམ་པར་མི་གཡེང་བས་ནང་ཞེས་བྱ་བའི་ཡང་དག་པའི་ཏིང་ངེ་འཛིན་ལ་གནས་པ་ལ་བྱ་བ་ནི་མ་ཡིན་པས་དེའི་ཕྱིར་ནང་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དང་པོ་ཡང་རྣམ་པ་གཉིས་ཏེ་ཞུ་བ་གསོལ་བ་དང་ལན་དུ་གསུངས་པའོ།",
    "ཞུ་བ་གསོལ་པ་དང་ལན་དུ་གསུངས་པའོ།",
    "ཞུ་བ་གསོལ་བ་དང་ལན་༤དུ་གསུངས་པའོ།",
    "ལམ་གཉིས་པོ་དེ་དག་གཅིག་པ་ཞིག་ལགས་སམ་ཐ་དད་པ་ཞིག་ལགས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རིགས་ཀྱི་བུ་ཐ་དད་པ་ཡང་མ་ཡིན་ཐ་དད་པ་མ་ཡིན་པ་ཡང་མ་ཡིན་ཞེས་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་དེ་བཞིན་གཤེགས་པས་ལན་ཡང་དག་པར་གསུངས་པ་བསྟན་ཏོ།",
    "ཐ་དད་པ་མ་ཡིན་པ་ཡང་མ་ཡིན་ཞེས་བྱ་བ་ནི་གཟུགས་བརྙན་ལས་བརྩམས་ནས་གསུངས་པ་ཡིན་ཏེ།",
    "འདི་ལྟར་ཞི་གནས་དང་ལྷག་མཐོང་དེ་དག་དམིགས་པར་མཚུངས་པར་གྱུར་པ་ན་གཟུགས་བརྙན་སྤྲུལ་པ་གང་ཡིན་པ་དེ་དག་སོ་སོ་ནས་མི་འདྲ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པ་དང་རྣམ་པར་རྟོག་པ་མེད་པའི་གཟུགས་བརྙན་ལ་བྱེ་བྲག་ཡོད་པའི་ཕྱིར་ཐ་དད་པ་མ་ཡིན་པ་ཡང་མ་ཡིན་པ་ཞེས་བྱའོ་ཞེའོ།",
    "བཅོམ་ལྡན་འདས་ལྷག་མཐོང་དང་ཏིང་ངེ་འཛིན་གྱི་སྤྱོད་ཡུལ་རྣམས་ཀྱི་གཟུགས་བརྙན་གང་ལགས་པ་དེ་དག་སེམས་འདི་དང་ཐ་དད་པ་ཞེས་བགྱི་འམ།",
    "ཐ་དད་པ་མ་ལགས་ཞེས་བཀྱི་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་དྲུག་པ་ཞི་གནས་དང་ལྷག་མཐོང་རྣམ་པར་རིག་པ་ཙམ་དུ་འབྱེད་པའི་སྒོའམ་ཡང་ན་སེམས་དང་ཡུལ་གཅིག་པ་དང་ཐ་དད་པ་ཉིད་དུ་རྣམ་པར་འབྱེད་པའི་སྒོ་ཞེས་བྱ་བ་སྟོན་ཏོ།",
    "ཞུས་པ་འདིའི་དོན་ནི་འདི་སྐད་དུ་ལྷག་མཐོང་དང་ཏིང་ངེ་འཛིན་གྱི་སྤྱོད་ཡུལ་སྔོན་པོ་ལ་སོགས་པ་ལྐུདེ་དག་སེམས་པ་འདི་དང་གཅིག་པ་ཞིག་ལགས་སམ།",
    "ཐ་དད་པ་ཞིག་ལགས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཟད་པར་ཀྱི་རྐྱེ།",
    "དེ་ནི་འདི་སྐད་དུ་དམིགས་པའི་ཡུལ་དང་ལྷག་མཐོང་གཅིག་པ་ཞིག་ལགས་སམ།",
    "ཐ་དད་པ་ཞིག་ལགས་ཞེས་བྱ་བའི་རིགས་ན་ཅིའི་ཕྱིར་སེམས་དང་གཅིག་པ་ཞིག་ལགས་སམ་ཐ་དད་པ་ཞིག་ལགས་ཞེས་བརྗོད་ཅེ་ན།",
    "སེམས་དང་མཚུངས་པར་ལྡན་པའི་ཕྱིར་སེམས་ཞེས་ཀྱང་བརྗོད་དོ།",
    "ཡུལ་སེམས་ལས་གུད་ན་མེད་པའི་ཕྱིར་ཐ་དད་པ་མ་ཡིན་ཞེས་གསུངས་ཀྱི།",
    "ཡང་དག་པར་ནི་གཅིག་པ་ཡང་མ་ཡིན་ཐ་དད་པ་ཡང་མ་ཡིན་པ་ཡང་ཐ་དད་པ་ཉིད་དུ་འཛིན་པ་རྣམ་པར་གཞིག་པའི་ཕྱིར་ཐ་དད་པ་མ་ཡིན་པ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དམིགས་པར་བྱ་བ་དེ་དམིགས་པར་བྱེད་པའི་སེམས་ལས་གུད་ན་ཡོད་པ་མ་ཡིན་ནམ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདི་ལྟར་གཟུགས་བརྙན་དེ་རྣམ་པར་རིག་པ་ལས་གྱུར་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་ཤེས་པས་དམིགས་པའི་སྤྱོད་ཡུལ་གང་ཡིན་པ་དེ་ནི་རྣམ་པར་རིག་པ་ཙམ་ལས་སྣང་བའི་གཟུགས་བརྙན་ཡིན་ཀྱི།",
    "ལོགས་ཤིག་ན་བདག་ཉིད་དུ་གྱུར་པ་ནི་མེད་དོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "རྣམ་པར་ཤེས་པའི་དམིགས་པ་ནི་རྣམ་པར་རིག་པ་ཙམ་ལས་སྣང་སྟེ་གུད་ན་ཡུལ་གྱི་དོན་དུ་གྱུར་པ་ནི་མེད་དོ།",
    "བཅོམ་ལྡན་འདས་གལ་ཏེ་དེའི་སྤྱོད་ཡུལ་གཟུགས་བརྙན་སེམས་དེ་ལས་ཐ་དད་པ་མ་ལགས་ན་ཇི་ལྟར་སེམས་དེ་ཉིད་ཀྱིས་སེམས་དེ་ཉིད་མཐོང་བར་འགྱུར་ལགས་ཞེས་བྱ་བ་ནི་གང་གསོལ་བ་སྟེ།",
    "དེ་ནི་འདི་སྐད་དུ་སེམས་ནི་དམིགས་པར་བགྱིད་པའི་དོན་ལགས།",
    "ཡུལ་ནི་བརྟེན་པར་བགྱིད་པའི་དོན་ལགས་ན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྤྱོད་ཡུལ་གཟུགས་བརྙན་དེ་དག་སེམས་དང་ཐ་དད་པ་མ་ལགས་པར་བཀའ་སྤྲུལ་པ་ལྟ་ན།",
    "མཚོན་གྱིས་ནི་རང་ཉིད་ལ་མི་གཅོད་དོ་ཞེས་བརྗོད་པ་དག་དང་འགལ་བར་འགྱུར་རོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "སློབ་དཔོན་ངོ་བོ་ཉིད་མེད་ཀྱིས་བྱས་པའི་འགྲེལ་པ་ལས།",
    "ཇེག་པ་ཆེན་པོ་བསྦུས་པའི་འགྲེལ་པ་མི་མཐུན་པ་རྣམ་པ་གཅིག་ལས་ནི་གལ་ཏེ་རྣམ་པར་ཤེས་པ་གཞན་ཞིག་རྣམ་པར་ཤེས་པའི་ཡུལ་གྱེ་དངོས་པོ་བྱེད་པ་ཞིག་ཡོད་ན་ཡང་རྣམ་པར་རིག་པ་ཙམ་གྱེ་དོན་འགྲུབ་པར་མི་འགྱུར་ལ།",
    "ཏིང་ངེ་འཛིན་གྱི་སྤྱོད་ཡུལ་སེམས་ལས་གུད་ན་མེད་པར་བསྟན་པ་དང་།",
    "སེམས་དེ་དག་ཡུལ་ལ་དམིགས་པའི་རིགས་པ་ནི་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱ་སྟེ།",
    "དེའི་ཉེ་བའི་དམིགས་པ་ཡིན་པར་མ་བསྟན་པ་ཙམ་དུ་ཟད་དེ་འདི་ལྟར་རྣམ་པར་ཤེས་པ་སྐྱེས་པ་ན་ཡང་དག་པར་བྱེད་པ་མེད་པས།",
    "ཇི་ལྟར་སློབ་དཔོན་དབྱིག་གཉེན་གྱིས་སྲིད་པ་བར་མ་རྣམ་པར་གཞག་པ་མཛོད་ཀྱི་བསྟན་བཅོས་ལས་རྒྱ་ཆེར་བསྟན་པ་ལྟ་བུའོ།",
    "ཞིབ་ཏུ་བསྟན་བཅོས་ཡང་དག་པའི་རིགས་ས་པ་དང་རྗེས་སུ་མཐུན་པ་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དེར་ཙོསྣབརྟགས་ན་ཁོང་དུ་ཆུད་པར་འགྱུར་རོ།",
    "གཟུགས་བརྙན་ཡང་རབ་ཏུ་མང་པོ་དག་འབྱུང་ངོ་ཞེས་གསུངས་པ་དང་།",
    "གལ་ཏེ་གཟུགས་ཁོ་ནར་ཟད་ཀྱི་གཟུགས་བརྙན་གཞན་མེད་ན་ནི་ལྟ་བའི་རྣམ་པ་འབའ་ཞིག་ཡོད་པར་འགྱུར་བའི་རིགས་ཀྱི།",
    "ནམ་མཁའི་མེ་ཏོག་ནི་ཀུན་བརྟགས་པའི་ངོ་བོ་ཉིད་ཀྱི་དཔེར་བསྟན་པ་ཡིན་པས་དེའི་ཕྱིར་ངེས་པར་གཟུགས་བརྙན་ཡོད་དེ།",
    "གཟུགས་བརྙན་དེ་ནི་ཡང་དག་པར་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་འབྱུང་ངོ།",
    "དཔེར་ན་གཟུགས་བརྙན་ནི་ཡང་དག་པར་དོན་ཡོད་པ་མ་ཡིན་ཡང་གཟུགས་དེ་ཉིད་ལ་གཟུགས་བརྙན་ཀྱི་བློ་སྐྱེད་པར་བྱེད་དེ།",
    "དང་པོ་ནི་ཀུན་གཞི་རྣམ་པར་ཁྱེཤེས་པ་ལས་གྱུར་པའི་གཟུགས་སོ།",
    "ལྟ་བའི་རྣམ་པ་ཉིད་ཀྱིས་ལྟ་བའི་རྣམ་པ་མཐོང་བ་ནི་མ་ཡིན་པའི་ཕྱིར་རང་ཉིད་མཐོང་བ་ཞེས་བརྗོད་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "གལ་ཏེ་ཏིང་ངེ་འཛིན་དང་རྣམ་པར་གཡེང་བ་ཡང་བསྡུས་ནས་དཔེ་འདི་གསུངས་པ་ཡིན་ན་ནི།",
    "ཞུ་བ་གསོལ་བ་དང་ལན་དུ་གསུངས་པའོ།",
    "རྣམ་པར་གཡེང་བའི་སེམས་ཀྱི་དམིགས་པ་ཡང་སེམས་ལས་གུད་ན་མེད་ཀྱང་འདི་ལྟར་བྱིས་པ་རྣམས་སེམས་ནོར་བར་གྱུར་པའི་ཕྱིར་གཟུགས་བརྙན་སེམས་ལས་ཕྱི་རོལ་དུ་གྱུར་པ་ཡིན་པར་སེམས་སོ་ཞེས་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་རྣམ་པར་རིག་པ་ཙམ་དུ་གསུངས་པ་ལ་དགོངས་པ་ཅི་ཡོད་ཅེ་ན།",
    "རྣམ་པར་རྟོག་པ་དག་ནི་སྐྱེ་མི་འགྱུར།",
    "དེས་ན་རྣམ་པར་རྟོག་པ་རབ་ཞི་ནས།",
    "ཞེས་གསུངས་ཏེ།",
    "ཕྱི་རོལ་གྱི་ཡུལ་སྤངས་པ་ཉིད་ཀྱིས་ཡང་དག་པ་མ་ཡིན་པའི་རྣམ་པར་ཤེས་པ་ཡང་ཉེ་བར་ཞི་བར་འགྱུར་ལ།",
    "བཅོམ་ལྡན་འདས་སེམས་ཀྱི་མཚན་མ་གང་ལགས་ཞེས་བྱ་བ་མན་ཆད་ཀྱིས་དམིགས་པ་གསུམ་གྱི་བྱེ་བྲག་བཟླས་ཏེ་བསྟན་པའོ།",
    "སྔར་སེམས་ཀྱི་མཚན་མ་སྤངས་པ་ཞེས་གསུངས་པ་དེ་དང་འདི་བྱེ་བྲག་ཅི་ཡོད་ཅེ་ན།",
    "འདི་ལྟར་ཞི་གནས་ཀྱིས་སེམས་རྣམ་པར་མི་གཡེང་བར་བྱེད་པའི་ཕྱིར་སེམས་ལ་དམིགས་པ་ཁོ་ནའོ།",
    "གཞན་ཡང་བར་ཆད་མེད་པའི་སེམས་ཞེས་བྱ་བ་ནི་དེའི་གོང་མ་བར་ཆད་མེད་པའི་སེམས་དམིགས་པར་གྱུར་པའོ།",
    "མཉམ་པར་ཟུང་དུ་འཇུག་པ་ཞེས་བགྱི་ལགས་ཞེས་བྱ་བ་ནི་གསུམ་པ་གཉི་ག་ཅིག་ཅར་དུ་འཇུག་པའི་མཚན་ཉིད་ཞུས་པའོ།",
    "ཡང་ན་སེམས་རྩེ་གཅིག་པ་ཉིད་ཅེས་བྱ་བ་ནི་དོན་དམ་པར་ཡང་རྣམ་པར་རིག་པ་ཙམ་ཁོ་ན་སྟེ།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་རྣམ་པར་རིག་པ་ཙམ་དུ་གྲུབ་པ་ལས་འདི་ལྟ་སྟེ།",
    "བཅོམ་ལྡན་འདས་སེམས་ཀྱི་མཚན་མ་གང་ལགས་པ་རྔུཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉིས་པ་དམིགས་པ་རྣམ་པ་གསུམ་གྱི་བྱེ་བྲག་བཟླས་ཏེ་བསྟན་པ་སྟོན་ཏོ།",
    "བཅོམ་ལྡན་འདས་བར་ཆད་མ་མཆིས་པའི་སེམས་གང་ལགས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་དམིགས་པ་གཉིས་པ་ཞུས་པ་བསྟན་ཏོ།",
    "བཅོམ་ལྡན་འདས་སེམས་རྩེ་གཅིག་པ་ཉིད་གང་ལགས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་དམིགས་པ་གསུམ་པ་ཞུས་པ་བསྟན་ཏོ།",
    "སྔ་མའི་སྒོ་གཉིས་ཀྱིས་ནི་སེམས་དང་ཡུལ་ཐ་དད་པར་རྟོགས་པས་ཞི་གནས་དང་ལྷག་མཐོང་ཅིག་ཅར་མི་འཇུག་པར་བསྟན་ལ།",
    "སྒོ་གསུམ་པ་འདིས་ནི་སེམས་དང་ཡུལ་ལ་འདྲེས་པར་དམིགས་ཤིང་ཞི་གནས་དང་ལྷག་མཐོང་ཅིག་ཅར་འཇུག་པར་བསྟན་པས་སོ།",
    "བསྟན་བཅོས་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཞུ་བ་གསོལ་བ་དང་ལན་དུ་གསུངས་པ་སྟེ།",
    "འདི་ལྟར་ཡུལ་དེ་དག་ཤིན་ཏུ་ལེགས་པར་རྟོགས་པར་གྱུར་ནས།",
    "ཤིན་ཏུ་རྣམ་པར་གྲོལ་བ་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཡིད་ལ་བྱེད་པ་གང་ཡིན་པའོ།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་ཅིང་སེམས་པར་མི་བྱེད།",
    "རྟོག་པར་མི་བྱེད།",
    "འཇལ་བར་མི་བྱེད་ཉེ་བར་རྟོག་པར་མི་བྱེད་པ་ཤེསྟེ།",
    "རྟོག་པར་བྱེད།",
    "འཇལ་བར་བྱེད་ཉེ་བར་རྟོག་པར་བྱེད་པ་དེའི་ཚེ་ན་ནི་ཡོངས་སུ་བཙལ་བའི་རྗེས་སུ་ཞུགས་པའི་ལྷག་མཐོང་ཞེས་བྱའོ།",
    "རབ་ཏུ་རྣམ་པར་འབྱེད་པའི་རྣམ་པའི་ལྷག་མཐོང་དང་།",
    "ཡོངས་སུ་དཔྱོད་པར་བྱེད་པའི་རྣམ་པའི་ལྷག་མཐོང་ངོ།",
    "ཡོངས་སུ་བཙལ་ནས་ཀྱང་དེ་དག་ལ་སོ་སོར་རྟོག་པར་བྱེད་དོ།",
    "རྣལ་འབྱོར་པས་ཤེས་པར་བྱ་བ་ནི་འདི་ལྟ་སྟེ།",
    "ཞིབ་ཏུ་དེ་ཉིད་ལས་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཞི་གནས་ལ་རྣམ་པ་དུ་མཆིས་ཞེས་བྱ་བ་འདི་མན་ཆད་ནི་གཉིས་པ་ཞི་གནས་ཀྱི་རྣམ་པ་མང་ཉུང་རྣམ་པར་འབྱེད་པའོ།",
    "བར་ཆད་མེད་པའི་སེམས་ལ་དམིགས་པའི་ཞི་གནས་ཀྱི་སེམས་ལ་ཡང་རྣམ་པ་གསུམ་ཡོད་དོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་བསྟན་པའོ།",
    "ཏིང་ངེ་འཛིན་འདི་ཡོངས་སུ་འཛིན་པར་བྱེད་པ་ནི་གྱ་ནོམ་པའི་ཏིང་ངེ་འཛིན་ཡིན་པས་གྱ་ནོམ་པའི་ཏིང་ངེ་འཛིན་དེ་ལ་བསམ་གཏན་ཞེས་བྱའོ་ཞེས་འབྱུང་སྟེ།",
    "ཡང་དག་པར་རྟོག་པ་དང་།",
    "གལ་ཏེ་དེ་ལྟ་ན་འདོད་པའི་ཁམས་ཀྱི་ཏིང་ངེ་འཛིན་ཡང་དག་པར་རྟོག་པར་བྱེད་པས་བསམ་གཏན་ཞེས་བྱ་བའི་རིགས་སོ་ཞེ་ན།",
    "ནུས་པ་དང་ལྡན་ཞིང་ཡང་དག་པར་རྟོག་པར་བྱེད་པ་རྔུནི་བསམ་གཏན་བྱེད་ཞེས་བྱ་བ་ཡིན་ན་འདོད་པའི་ཁམས་ཀྱི་ཏིང་ངེ་འཛིན་གྱི་མིང་དང་ལྡན་ཡང་ཏིང་ངེ་འཛིན་གྱི་ནུས་པ་མེད་པས།",
    "ཡང་དག་པར་རྟོག་པར་བྱེད་པའོ།",
    "འདོད་པའི་ཁམས་ཀྱི་ཏིང་ངེ་འཛིན་ཡང་དག་པར་རྟོག་པར་བྱེད་ཀྱང་ཀུན་དུ་སྦྱོར་བ་སྤོང་བར་མི་བྱེད་ལ་གཟུགས་མེད་པའི་ཏིང་ངེ་འཛིན་རྣམ་པ་ཉུཀུན་ཏུ་སྦྱོར་བ་སྤོང་བར་བྱེད་ཀྱང་ཡང་དག་པར་རྟོག་པར་མི་བྱེད་པའི་ཕྱིར་བསམ་གཏན་མ་ཡིན་ནོ།་།",
    "དབེན་པ་དང་ཡང་དག་པར་ཉེ་བར་གཏོད་པའི་ཕྱིར་བསམ་གཏན་ཞེས་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "གྲོགས་ལས་བསམ་གཏན་བཞི་རྣམ་པར་གཞག་པ་ཡིན་ན།",
    "བཞི་པ་ཞེས་རྣམ་པར་གཞག་ཅེ་ན།",
    "དཔྱོད་པ་དང་དགའ་བ་དང་བདེ་བ་དང་བཅས་པ་ལས་ནི་དང་པོ་རྣམ་པར་གཞག་གོ།",
    "བཞི་པ་རྣམ་པར་གཞག་སྟེ།",
    "གཞན་ཡང་མཛོད་ཀྱི་བསྟན་བཅོས་ཀྱི་ཚིག་ལེའུར་བྱས་པ་ལས།",
    "ཅིའི་ཕྱིར་ཚིག་ལེའུར་བྱས་པ་ལས་རྟོག་པ་ཚང་བར་མ་སྒོས་ཤེ་ན།",
    "དེའི་ཕྱིར་རྟོག་པ་དང་ལྡན་པར་ཡང་བསྟན་ཏེ།",
    "བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་པའི་བསམ་གཏན་ནི་གོ་རིམས་བཞིན་དུ་བཞི་པོ་དག་ཡིན་པར་སྦྱར་རོ་ཞེས་ཟེར་རོ་ཞེས་འབྱུང་ངོ།",
    "རྣམ་པར་འགྱུར་ཞིང་བསྟན་དུ་ཡོད་པ་ལ་བརྟེན་ནས་གཟུགས་ཞེས་བསྟན་ཏོ།",
    "འདི་ལྟར་ཁམས་དེ་ན་རྣམ་པར་འགྱུར་ཞིང་བསྟན་དུ་ཡོད་པ་ཟློག་པར་བྱེད་པས་གཟུགས་མེད་པའི་དོན་ལ་བརྟེན་ནས།",
    "གཟུགས་མེད་པའི་ཁམས་ནི་རྣམ་པར་འགྱུར་བ་དང་།",
    "ཨ་ཞེས་བྱ་བས་ནི་གཟུགས་མེད་པ་ཡོད་པར་རབ་ཏུ་བསྟན་ཏེ།",
    "དགག་ནས་རབ་ཏུ་བསྟན་པ་ཡང་ཡིན་པར་མཐོང་བ་ནི་ཇི་ལྟར་ཨས་འདི་རབ་ཏུ་བསྟན་ཀྱང་དགག་པ་ཁོ་ན་མ་ཡིན་པ་ལྟ་བུ་ཡིན་པས་དེའི་ཕྱིར་ཨ་ཞེས་བྱ་བས་ནི་དགག་པ་དང་རབ་ཏུ་བསྟན་པ་ཡང་ཡོངས་སུ་རྫོགས་པར་སྟོན་ཏོ་ཞེས་འབྱུང་སྟེ།",
    "སྔར་མཐའ་མེད་པའི་ནམ་མཁའི་མཚན་མ་ཡིད་ལ་བྱས་ཤིང་སྦྱོར་བ་བསྒོམས་པས།",
    "གོང་ནས་གོང་དུ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དང་པོ་རབ་ཏུ་འདྲེན་པའི་ཕྱིར།",
    "མགོན་སྐྱབས་མེད་ཅིང་ང་རྒྱལ་དང་ལེ་ལོ་དང་བག་མེད་པ་རྣམ་པར་གནོན་པ་ས་གཞན་དག་ལས་ཁྱད་པར་དུ་འཕགས་པའི་ཕྱིར་འདི་འབའ་ཞིག་ལ་ཅི་ཡང་མེད་པའི་སྐྱེ་མཆེད་ཅེས་བྱའོ།"
  ]
}