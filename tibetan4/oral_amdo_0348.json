    "དགེ་སློང་མ་ལ་ཕམ་པར་འགྱུར་ཚོད་ཀྱི་ཡུལ་སྐྱེས་པ་ལ་དགེ་སློང་གིས་རེག་ན་སྦོམ་པོར་འགྱུར་རོ།",
    "དགེ་སློང་གིས་དགེ་སློང་མའི་ཕམ་པ་འཆབ་ན་ཉེས་བྱས་སོ།",
    "དེ་ཡང་སྐྱེས་པ་ལ་རེག་པ་དང་སྐྱེས་པ་དང་ལུས་བཀན་པ་གཉིས་ནི་ཕ་ལ་ཕམ་ལྷག་ཅི་རིགས་པའི་སྦོམ་པོར་འགྱུར་ཞིང་།",
    "ལྷག་མ་ཉི་ཤུའི་ནང་ནས་དགེ་སློང་ཕ་མ་ཐུན་མོང་བའི་ལྷག་མ་ལ།",
    "ཕ་ཡི་ཐུན་མོང་མ་ཡིན་པའི་ལྷག་མ་འབྱིན་པ་དང་།",
    "རེག་པ་དང་།",
    "རེག་པ་ནི་ཕམ་པ་དང་།",
    "མ་ཡི་ཐུན་མོང་མ་ཡིན་པའི་ལྷག་མ་ལ་ཅི་ཡང་རུང་བ་ལེན་དང་ལེན་འཇུག་སོགས་བཅུ་གསུམ་ཡོད་པ་སོ་སོའི་ངོ་བོ་ནི།",
    "དགེ་སློང་མས་༡ སྐྱེས་པ་ལ་འཁྲིག་པའི་གླ་རྔན་ཅི་ཡང་རུང་བ་རང་གིས་ལེན་པ་དང་།",
    "༧ གསོད་པའི་ཚད་པ་ཐོག་པའི་བུད་མེད་རབ་ཏུ་དབྱུང་བ་དང་།",
    "༡༢ བུད་མེད་དང་ལྷན་ཅིག་རྩེ་རྒོད་དང་རྩབ་ཧྲལ་བྱེད་པ་ཟློག་པ་ལྔས་བཟློག་ཀྱང་མི་གཏོང་བ་དང་།",
    "མ་ཡི་ཐུན་མོང་མིན་པའི་ལྷག་མ་བཅུ་གསུམ་པོ་འདི་དག་ཕ་ལ་ཅི་འགྱུར་ནི།",
    "ཀྱི་ཐུན་མོང་བཅུ་དགུ་ཐུན་མིན་བཅུ་བཞིའོ།",
    "མ་ཡི་ཐུན་མོང་མ་ཡིན་པ་བཅུ་བཞི་སྟེ་སུམ་ཅུ་སོ་གསུམ་ཡིན་ལ།",
    "ཕ་མའི་ཐུན་མོང་བ་བཅུ་དགུའི་ནང་ནས།",
    "འདིར་རང་རེའི་སྡོམ་དུ་གསོག་འཇོག་བྱེད་པ་རྗེས་མཐུན་མིང་ཙམ་ལ་བགྲངས་ཀྱང་འདི་ཐད་མཚོ་ཊཱིཀ་ཏུ་དེ་མ་བགྲངས་པར་དེའི་དོད་དུ་ལྷུང་བཟེད་འཚོལ་བ་བགྲངས་ཏེ།",
    "དྲུག་ནི་མིང་ཙམ་གྱི་ཐུན་མོང་ཡིན་ནོ།",
    "མཐུན་མིང་ཙམ་དུ་བགྲངས་པས་གསོག་འཇོག་ལ་རང་གིས་བྱིན་ལེན་བྱས་པ་སྤྱི་དུས་ལས་ཡོལ་བ་དེ་མཚན་ཉིད་ཅི་འདྲ་དང་རང་དང་ཆོ་ག་གཅིག་པས་བྱིན་སོགས་བྱས་པ་རང་གིས་བྱིན་ལེན་མ་བཤིག་པར་དུས་ལས་ཡོལ་བ་དེ་རྗེས་མཐུན་མིང་ཙམ་དུ་བྱས་ནས་ཕྱོགས་གཅིག་གི་ཆ་ནས་འདྲེན་པ་དང་།",
    "དེ་བཞིན་ལྷུང་བཟེད་འཚོལ་བ་ལའང་ཕ་ཡི་ཆུང་ཚད་འཚོལ་བ་དེ་མཚན་ཉིད་ཅི་འདྲ་དང་མའི་ཆུང་ཚད་དང་ཕའི་ཆེ་འབྲིང་འཚོལ་བ་རྗེས་མཐུན་མིང་ཙམ་ལ་འདྲེན་པ་སྟེ་ཕྱོགས་རེའི་ཆ་ནས་འདྲེན་ཚུལ་ཡོད་པར་འཇོག་གམ་དཔྱད་པར་ཞུའོ།",
    "༩ དབྱར་ཁང་གི་ཆེད་དུ་རྙེད་པའི་དངོས་པོ་གོས་ལས་གཞན་པ་དེ་ཟས་སུ་བསྒྱུར་ནས་འཇོག་པ་དང་།",
    "༡༢ ལྗིད་ཀྱིས་ལྕི་བ་དང་རིན་གྱིས་ལྕི་བའི་གོས་བདག་གིར་བྱེད་པ་དང་།",
    "མའི་རྣམ་འབྱེད་དང་ལུང་ཞུ་བ་གཉིས་ལས་བཅུ་གཅིག་གི་ནང་ནས་སྲིན་བལ་དང་།",
    "༢ འཁོར་འཇོག་ནི་འཁོར་ཉེར་འཇོག་གི་གནང་བ་མ་ཐོབ་པར་འཁོར་གཅིག་གམ་གཉིས་འཇོག་པ་དང་།",
    "ནི་འཁོར་མང་གི་གནང་བ་མ་ཐོབ་པར་འཁོར་གསུམ་ཡན་འཇོག་པ་དང་།",
    "༤ བུད་མེད་ཁྱིམ་སོ་བཟུང་བ་མངལ་བཤོལ་བརྩིས་ཀྱང་ལོ་བཅུ་གཉིས་མ་ལོན་པར་མཁན་མོ་བྱས་ཏེ་བསྙེན་རྫོགས་བྱེད་པ་དང་།",
    "༡ ཁོ་མོ་ལ་རྔན་པ་བྱིན་ན་བསྙེན་པར་རྫོགས་པར་བྱའོ་ཞེས་ངག་གིས་བརྗོད་པའོ།",
    "འདྲིད་དང་ལོ་རེ་མ་གནང་དང་།",
    "༤ འཁྲུལ་མོ་དང་།",
    "འདི་ཐམས་ཅད་དགེ་སློང་མ་མཁན་མོ་ལ་བཅས་པའོ།",
    "ཐལ་མོ་སྤུ་དང་དབེན་གཉིས་དང་།",
    "༢ རང་གི་བསྟེན་བྱར་རྒྱ་སྐྱེགས་ཀྱི་ཆང་བུ་སོར་གཉིས་ཡན་ཆད་འཛུད་པ་དང་།",
    "༢ རང་གི་སོར་ཚིག་གཉིས་ལས་ལྷག་པས་མོ་མཚན་ནང་འཁྲུ་བ་དང་།",
    "༤ རང་གི་མོ་མཚན་ལ་ལག་ཐིལ་གྱིས་ཐལ་ལྕག་བསྣུན་པ་དང་།",
    "༥ རང་གི་མོ་མཚན་གྱི་སྤུ་འཐོག་གམ་འཐོག་ཏུ་བཅུག་པ་དང་།",
    "མཚན་མོ་གཅིག་པུ་ཉལ་བའོ།",
    "༡ དགེ་སློང་མས་དགེ་སློང་གི་རྣ་བར་ཤུབ་ཅིང་སྨྲ་བ་དང་།",
    "༢ དགེ་སློང་གིས་རང་གི་རྣ་བར་ཤུབ་ཅིང་སྨྲ་བ་ཉན་པ་དང་།",
    "༨ ཁྱིམ་བདག་ལ་མ་དྲིས་པར་ཁྱིམ་གཞན་དུ་མཚན་མོ་འདའ་བ་དང་།",
    "༩ སྐྱེས་པ་ཡོད་མེད་མ་བརྟགས་པར་སྐྱབས་ཡོད་པར་མཚན་མོ་འདའ་བ་དང་།",
    "༡ སྟེང་གཡོག་དང་བཅས་པའི་གནས་དེར་དགེ་སློང་མ་གཞན་མེད་པར་རང་གཅིག་པུར་མཚན་མོ་འདའ་བར་བྱེད་པའོ།",
    "༡ དགེ་སློང་མ་གཞན་དང་ཤ་ཐང་རེག་སྟེ་ཁྲི་གཅིག་ལ་ཉལ་ཏེ་མཚན་མོ་འདས་པ་དང་།",
    "༤ དེ་འདྲ་ཁྱིམ་པ་མོ་ལ་བྱེད་དུ་འཇུག་པ་དང་།",
    "༧ རང་ལུས་ཆུ་འབའ་ཞིག་གིས་འཁྲུ་བཤལ་བུད་མེད་གཞན་བྱེད་དུ་འཇུག་པ་དང་།",
    "༡ བུད་མེད་གཞན་དང་ལག་སྦྲེལ་ཏེ་ཆུ་ལ་འཁྲུས་བྱེད་པའོ།",
    "ལོ་དལ་༢༡་ཚཚོ་ཎ་༡༡མ་རོལ་མོ་བྱེད་དང་གདུགས་ཐོགས་པའོ།",
    "༩ རོལ་མོ་ཁྲོལ་བ་དང་།",
    "༥ དགེ་སྦྱོང་གི་གོས་སྣམ་སྦྱར་སོགས་ཁྱིམ་པ་ལ་གོས་སུ་སྦྱིན་པ་དང་།",
    "༧ དགེ་སློང་མ་གཞན་གྱི་བསྔགས་པ་བརྗོད་པ་ལ་ལུས་ངག་གི་རྣམ་འགྱུར་མི་མཐུན་པས་སེར་སྣ་བྱས་པ་དང་།",
    "༨ དགེ་སློང་གཞན་ལ་སྦྱིན་བདག་གི་ཁྱིམ་གྱི་གནས་ཀྱི་རྙེད་པ་ལ་སེར་སྣ་བྱས་པ་དང་།",
    "༩ དགེ་སློང་མ་གཞན་གྱི་དབྱར་ཁང་གི་གནས་ཀྱི་རྙེད་པ་ལ་སེར་སྣ་བྱས་པ་དང་།",
    "༣ མཚམས་པོ་ཆེ་བཅད་ན་དེའི་ཁོངས་སུ་དང་མ་བཅད་ན་དཔག་ཚད་གཅིག་གི་ཁོངས་སུ་ལས་དགེ་སློང་མའི་རྣམ་འབྱེད།",
    "༨ དགེ་སློང་མ་རྣམས་རྙེད་པའི་གོས་འགྱེད་པའི་ཕྱིར་ཡང་ཚོགས་པ་མི་སྦྱིན་པ་དང་།",
    "༢ ལྷ་ཁང་དུ་སོང་སྟེ་འཐབ་ཀྲོལ་བྱེད་པ་དང་།",
    "༥ མུ་སྟེགས་ཀྱི་གནས་སུ་སོང་སྟེ་འཐབ་ཀྲོལ་བྱེད་པ་དང་།",
    "དེ་ལྟར་ཐུན་མོང་བ་བདུན་ཅུ་རྩ་གཉིས་རྣམ་པར་བཞག་པ་ནི།",
    "ཞེས་གསུངས་པས་སྐྱོད་པ་སོགས་བཅོ་བརྒྱད་པོ་རྣམས་ནི་ཕ་ཡི་ཐུན་མོང་མ་ཡིན་པ་དང་།",
    "འཕྲོས་བདུན་ཅུ་རྩ་གཉིས་པོ་ཐུན་མོང་བ་ཡིན་པར་གསུངས་ལ།",
    "དབེན་པ་འདུག་པ་དང་འགྲེང་བ་གཉིས་ཕ་ལ་གཅིག་རེ་དང་།",
    "སྤྱོད་པ་ལ་ཡང་ཕ་ལ་གཅིག་དང་མ་ལ་གཉིས་གསུངས་པས་ཐུན་མོང་བ་མིན་ཞིང་།",
    "ཕ་མ་ཐུན་མོང་བ་བདུན་ཅུ་རྩ་ལྔ་རྣམ་པར་འཇོག་པའི་ཚུལ་མཚོ་ཊཱིཀ་ལས་གསུངས་སོ།",
    "ཁྱིམ་བདག་ལ་མ་དྲིས་པར་ཁྱིམ་གཞན་དུ་མཚན་མོ་འདའ་བ་དང་སྐྱེས་པ་ཡོད་མེད་མ་བརྟགས་པར་སྐྱབས་ཡོད་པར་མཚན་མོ་འདའ་དགེ་སློང་མའི་རྣམ་འབྱེད།",
    "བར་བྱེད་པ་དང་གནས་ཁང་དུ་དགེ་སློང་མ་གཞན་མེད་པར་མཚན་མོ་འདའ་བར་བྱེད་པ་འོ་ སྨེ་གབ་མི་འཆང་བ་དང་།",
    "རྒྱ་སྐྱེགས་ཀྱི་འཆང་བུ་རང་གི་རྨ་སྒོ་གསུམ་པོ་གང་རུང་དུ་འཛུད་པ་ནི་དགེ་སློང་ཕ་ལ་སྦོམ་པོར་འགྱུར་ལ།",
    "འོ་མ་སོགས་བཅུ་པོ་ངག་གིས་སློང་ཞིང་ཟ་བ་དང་འཐུང་བ་བཅུ་དང་།",
    "དྲལ་བ་ནི་ཕ་མ་གཉིས་ཀའི་ཐུན་མོང་བ་ཡིན་ཞིང་།",
    "མ་ཡི་ཐུན་མོང་མིན་པའི་ཉེས་བྱས་ཡིན།",
    "ཕ་དང་ཐུན་མོང་བ་བརྒྱ་དང་བཅུ་དང་མ་ཡི་ཐུན་མོང་མ་ཡིན་པ་གཉིས་ཏེ་ཉེས་བྱས་བརྒྱ་དང་བཅུ་གཉིས་དེ་ལྟར་འདྲེན་ནོ།",
    "ཚིག་གི་གཟེགས་མ་རེས་ཀྱང་དུག་གསུམ་གྱི།",
    "ལེགས་ཉེས་སྟངས་འཛིན་པྲ་ལྟས་མོ་ཡི་རིག་པ།",
    "ཡབ་མེས་གོང་མ་རྣམས་ཀྱི་རྩལ་དུ་བཏོན་པའི་རིག་གཞུང་གི་ཉིང་ཁུ་བདུད་རྩིའི་མཆོད་ཡོན་ལྟེམས་ཀྱིས་འཁྱིལ་ཡོད་པ་ནི།",
    "ངས་ལྷག་བསམ་རྣམ་དག་གིས་བཀའ་དྲིན་དང་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "བོན་གྱི་ཡིག་རྙིང་ཁག་གི་དགོངས་པ་དང་བསྟུན་ན།",
    "དམ་པ་མཆོག་གིས་དགྲ་འདུལ་གཉེན་སྐྱོང་དང་།",
    "ཡ་རབས་གུས་སྲོལ་སོགས་དངོས་པོའི་དཔལ་ཡོན་དང་བསམ་པའི་འདུ་ཤེས་གང་གི་ཐད་ནས།",
    "རིམ་གྱིས་སྟག་གཟིག་དང་ཞང་བོད་ཀྱི་ཡུལ་གྲུ་ཀུན་ལ་ཁྱབ་གདལ་དང་དར་སྤེལ་དུ་བཏང་བ་མ་ཟད།",
    "འདི་ནས་འདས་པའི་མི་ལོ་ཆིག་སྟོང་ལྷག་གི་ཡར་སྔོན་དུ།",
    "དེ་དག་གི་སློབ་བརྒྱུད་རྣམས་ཀྱིས་སྟོད་གངས་དཀར་ཏི་སེ་མན་ཆད་ནས།",
    "འོན་ཀྱང་མ་ཕྱི་ནི་གནའ་སྔའི་ཤིང་པར་དུ་བཏབ་པ་རེ་ཟུང་མ་གཏོགས།",
    "དུས་རབས་བཅུ་གཉིས་པའི་ནང་སྐུ་འཁྲུངས་པའི་གཤེན་སྟོན་ནམ་མཁའ་རྒྱལ་མཚན་མཆོག་གི་གསུང་པོད་གཅིག་དང་།",
    "ཡང་དག་པའི་ལྟ་གྲུབ་ཟབ་མོའི་དགོངས་པ་དང་།",
    "བགྲོད་བདེ་བའི་སྤྱོད་ལམ་དྲང་མོའི་རྣམ་གཞག་དུས་གཏན་གྱི་ཕན་བདེ་ལེགས་པོའི་འབྲས་བུ་བཅས་ལ་མྱོང་རོལ་བྱེད་ཐུབ་པ་སྨོས་མ་དགོས་ལ།",
    "མཁྱེན་ལྡན་རྣམས་ལ་ཞིབ་འཇུག་གི་རིན་ཐང་གསེར་གྱི་ཞུན་མ་ལྟ་བུའི་བྲིན་ཆེ་བ་དང་།",
    "ཁོང་གི་གསུང་རྩོམ་ལས་འཛམ་གླིང་གངས་རྒྱལ་ཏི་སེའི་དཀར་ཆག་ཚངས་དབྱངས་ཡིད་འཕྲོག་ཅེས་པ་ནི་སྙན་གྲགས་ཤིན་ཏུ་ཆེ་བའི་གནས་ཡིག་ཅིག་ལགས་ཤིང་།",
    "ད་ལན་གྱི་གསུང་འབུམ་ནང་གནས་ཡིག་དེ་དང་ཁོང་གི་རང་རྣམ།",
    "སྐྱང་སྤྲུལ་ནམ་མཁའ་རྒྱལ་མཚན་སོགས་ཀྱིས་མཛད་པའི་བོན་གྱི་གནས་ཆེན་ཁག་གི་གནས་ཡིག་ཚན་པ་སོ་དྲུག་བསྡུས་ཡོད་ལ།",
    "སྐྱང་སྤྲུལ་ནམ་མཁའ་རྒྱལ་མཚན་སོགས་ཀྱིས་མཛད་པའི་བོན་གྱི་མོ་ཡིག་ཚན་པ་ཉེར་གཅིག་བསྡུས་ཡོད་དོ།",
    "ཐོག་མའི་དག་སྒྲིག་གི་ལས་ཀར་ཀརྨ་ཀུན་ཁྱབ་དང་ཀུན་དགའ་ཡེ་ཤེས།",
    "གཞན་ས་དཔྱད་དང་མོ་ཡིག་སོགས་ཀྱང་དེའི་རང་བཞིན་ཡིན།",
    "ང་ཚོས་བོན་གྱི་གནའ་དཔེ་དག་སྒྲིག་གི་ཉམས་མྱོང་ཕུན་སུམ་ཚོགས་པའི་ཤེས་ལྡན་པ་ཁྲི་བསོད་བསྟན་དང་ས་ཁའི་བློ་ལྡན།",
    "འདིར་ངེད་ཅག་གིས་དཔེ་ཚོགས་འདིའི་འགོ་བརྗོད་མཛད་མཁན་ཀྲུང་གོའི་ནང་བསྟན་མཐུན་ཚོགས་བོད་ལྗོངས་ཡན་ལག་ཚོགས་པའི་ཚོགས་གཙོ་གཞོན་པ།",
    "གཉིས་པ་ཟུང་གསུམ་ཡ་དྲུག་གི་སྐབས་བསྟན་པ་དང་།",
    "དེས་ར་ཤག་གི་བོན་པོ་གཡུང་དྲུང་གསས་ལ་གདམས།",
    "དེས་ཕ་བ་རྒྱལ་གཟིགས་གསས་ཆུང་ལ་གདམས།",
    "ཞར་རྟགས་དང་སྒྲ་ཚིག་གི་གདམས་ངག་བསྟན་པ་དང་བཅུ་གསུམ།",
    "ཆུ་ལ་འཁྱག་པ་ལྟ་བུའི་གདམས་ངག་གིས།",
    "སྣང་སྟོང་དབྱེར་མེད་དུ་བསྟན་པའི་གདམས་ངག་དང་དྲུག་དུ་མ་རོ་གཅིག་གི་གདམས་ངག་གིས་སྣང་བ་བོན་སྐུར་ཤར་གྱིན།",
    "བདེ་བ་ལ་རེ་འཇོག་མེད་པར་བསྟན་པ་དང་བརྒྱད།",
    "མཐའ་གར་ཡང་མ་རེག་རྒྱ་གར་ཡང་མ་ཆད།",
    "རང་གི་སེམས་ཉིད་ངོ་བོ་དེའི་ངང་ལ།",
    "བྱུང་ཚོར་གྱི་རྗེས་སུ་མི་འབྲང་བ།",
    "རང་སྣང་རིག་མེད་ཟང་ཐལ།",
    "བྱར་མེད་བདེ་ཆེན་ཟང་ཐལ།",
    "མིག་གི་ཡུལ་དུ་གཟུགས་སྣ་ཚོགས་སྣང་བ་སྟེ།",
    "རེ་བ་དང་དོགས་པ་གཉིས་སོ།",
    "དེ་ལྟར་མ་ཤེས་ན་འཐད་པ་སྡུད་པས་བསྒོམ་མོ།",
    "རྟག་ཆད་ལ་རྟག་པར་མ་སོང་བ།",
    "ཆད་བར་མ་སོང་།",
