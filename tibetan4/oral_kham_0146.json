    "ཁྱད་པར་རྣམས་བརྗེད་འདུག་གསུང་།",
    "ཁྱེད་ཀྱང་འབད་དགོས་པར་འདུགས་གསུང་པ་གཅིག་བྱུང་ངོ།",
    "བྱུང་པས་དེའི་རྣམ་འགྱུར་དུ་འདུག་གསུངས་སོ།",
    "ཁྱད་པར་དུ་དྲུང་པ་ལའང་ཁྱེད་ལ་ཧོར་གྱི་གདན་འདྲེན་ཡོང་བར་འདུག།",
    "འོན་ཀྱང་སྐུ་ཚེ་ཐུང་བར་འདུག།",
    "འོན་ཀྱང་ད་རུང་དུས་སྐལ་ཅི་རིགས་པ་ལས་མི་ཡོང་བར་འདུག་པས་འགྲོ་གསུང་ནས་ཞི་བར་གཤེགས་པ་ཡིན་གསུང་ངོ།",
    "དེང་སང་ཡང་སྐབས་ལ་ལར་འོང་ཤིང་འདུག་གསུང་ངོ།",
    "འདི་ཞེས་བྱ་བ་ཡོད་འདུག།",
    "དེ་བར་དུ་འབྱོན་དགོས་པར་འདུག།",
    "དེ་ནས་འབྱོན་མི་དགོས་པར་འདུག་ཅེས་ལུང་བསྟན།",
    "ཁོང་པ་རང་ལ་དེའི་རྣལ་ལམ་གཅིག་བྱུང་བ་ཡིན་པར་འདུག་ཅེས་ཡང་གསུང་ངོ།",
    "དེའི་ཕལ་ཆེ་བ་གཅིག་ད་ལྟ་ནུབ་ནས་ཁུངས་སྟོར་འདུག་ནའང་།",
    "ཉིན་རངས་སུ་འདུག་པས་ཀུན་གྱིས་ངོ་མཚར་དུ་བྱེད་དོ།",
    "དེ་རིང་ཆར་གཅིག་ཡོང་བར་འདུག་ཅེས་ཟེར་རོ།",
    "རྣལ་སད་ནས་ཐུགས་དགོངས་ལ་ཧོར་གྱིས་གདན་འདྲེན་གཅིག་ཡོང་བ་ཡིན་པར་འདུག་ཀྱང་འགྲོ་མི་དགོས་པ་ཡིན་པར་འདུག་སྙམ་ཞེས་གསུང་ངོ།",
    "དཔོན་ཡིག་མཉྫུ་ཤྲཱི་དཔོན་སློབ་དཔེ་གོག་གཅིག་འདུག་པའི་ཕིབས་འོག་ཏུ་གཟིམས།",
    "དེ་པའི་ཁང་པ་ལ་ཐོག་རྒྱབ་ནས་གནས་པོ་དེ་ཤི་ཡོད་པར་འདུག།",
    "ངེད་ལ་ཞུ་བ་བྱ་རྒྱུ་ཡོད་པ་ཡིན་ཟེར་ཞིང་འདུག་པ་དང་།",
    "སྒྲོམ་བུ་གཅིག་ཁྱེར་འདུག་ནས།",
    "རྡོ་རྗེ་རྣལ་འབྱོར་མ་ཡིན་སྙམ་པ་གཅིག་ཀྱང་འདུག་པ་ན།"
  ]
}