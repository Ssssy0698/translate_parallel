    "རང་འཛིན་ཤེས་རྣམ་འགྲེལ་པའི་ཉེར་ལེན་དང་རང་མྱོང་བའི་ངོ་བོར་གནས་པ་ནི་ནང་སེམས་ཀྱི་གཟུང་བའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར།",
    "རྒོལ་བའི་འདོད་ཡུལ་བསྒྲུབ་བྱར་ཤེས་པའི་དོན་དུ་ཡང་རང་སྒྲ་སྨོས་མི་དགོས་པར་འགྱུར་ཏེ་མ་སྨོས་ཀྱང་རྒོལ་བའི་འདོད་ཡུལ་བསྒྲུབ་བྱར་བྱེད་པའི་ཕྱིར་རོ་ཞེ།",
    "དེ་ལ་ལྟོས་པ་མེད་པར་ཡང་རང་འབྲས་ཉན་ཤེས་བསྐྱེད་པའི་ཕྱིར་ཏེ་རྟག་པའི་རྣམ་ཕྱིར་རོ།",
    "འབྲས་རྟགས་དང་རང་བཞིན་རྟགས་ལ་ལྷན་ཅིག་ཏུ་རྩོལ་དུ་ཨ།",
    "དེ་ཡང་སྔ་ལོར་རྩོད་རྒྱུགས་སྐབས་སུ་ཉམས་ཞིབ་བྱུང་བ་སོགས་ལ་བརྟེན་དུས་ཡུན་དང་སྐབས་སྟོབས་ཀྱི་གནས་སྟངས་སོགས་ལ་གཞིགས་པའི་གྲུབ་འབྲས་ཧ་ཅང་ལེགས་པོ་ཐོན་འདུག་པས་ཚང་མར་བཀྲ་ཤིས་བདེ་ལེགས་ཡོད།",
    "ད་བར་ཚང་མ་ཡག་ཐག་ཆོད་བྱུང་འདུག་ད་དུང་འབད་བརྩོན་གཉུག་བསྲིང་དགོས།",
    "བུ་ལོན་སྒོར་ཉིས་སྟོང་བརྒལ་བ་ཆགས་འདུག་ཀྱང་སྐུ་སྒེར་ནས་ཞུ་མ་དགོས་པར་སློབ་གཞུང་ནས་འཇལ་ཐུབ་པ་བྱུང་།",
    "བསྟན་པར་དག་ཐེར་གཙང་མ་མཛད་རན་གདའ།",
    "བརྟག་ཙ་ན་མུ་ཏིག་བསྟར་རྒྱུས་བཞིན།",
    "སྔར་ཕྱི་རྒྱལ་ཞིག་ནས་པར་སྐྲུན་གྱི་མཐུན་རྐྱེན་ཧིན་སྒོར་ཁྲི་གཅིག་ལྷག་ཙམ་གནང་བྱུང་བ་དེ་ཡང་ད་ཆ་རྫོགས་ནས་མི་འདུག་༡༥",
    "རྩོད་གྲྭ་གྲོལ་བསྟུན་གསོལ་ཇ་དང་ཆུ་ཚོད་༤ པ་ནས་༥ དང་༣ བར་སྔར་བཞིན་དཔེ་འཁྲིད་དང་རང་སྦྱོང་གང་འཁེལ་དམ་དོན་དགོས།",
    "འདི་ཡང་གོ་རྟོགས་རྒྱ་སྐྱེད་དང་ཉམས་མྱོང་ཡར་རྒྱས་ལ་ཕན་ཐོགས་གང་ལེགས་འདུག་༡༦",
    "ད་ཆ་དམིགས་ཡུལ་དེ་དག་དུས་སུ་སྨིན་པ་ལྟར་གསལ་བཀོད་ཞུས་པ་ཡིན།",
    "ལོག་སྨོན་མའོ་ཙེ་ཏུང་ཡང་རང་ཤུགས་ཀྱིས་དུལ་ཞིང་ཡིད་འཕྲོགས་ཏེ་ཀུན་ནས་མགུ་བ་སྦྱིན་པ་མ་ཟད།",
    "དེ་བཞིན་ཤིང་སྡོང་གཅིག་ལ་འབུ་དམར་པོས་གང་ནས་འདུག་པས་ཤིང་དེའི་རྩ་བ་ནས་བཅད་ན་ཐམས་ཅད་ཤི་རྒྱུ་ལས་འོས་མེད་ཅེས་སོགས།",
    "ཁྱེད་ཚོ་དཔེ་མི་སྲིད་པའི་འཚོ་གོས་གནས་སྟངས་ཡག་པོ་འདུག་ན་བཅིངས་དཀྲོལ་ག་འདྲ་སེ་བཏང་བ་ཡིན་ནམ་དྲིས་པས།",
    "བཞེས་ཀྱི་འདུག་གམ་ཅེས་དྲིས་པར་ལན་མ་ཐེབས་པར་ཁྱེད་རིག་པ་གྲུང་པོ་འདུག་ན།",
    "ཁོང་ནི་བསླབས་པའི་ཡོན་ཏན་གྱིས་ཕྱུག་པ་ཆེས་མི་མངོན་ཡང་རང་བཞིན་གྱིས་གཞུང་བཟང་ཞིང་གཏོང་ཕོད་ཆེ་བ།",
    "རང་རང་སྲོག་བསྲུང་བྱ་རྒྱུ་དེ་ཉིད་འོས་པར་མཐོང་ནས་བྲོས་ཐར་ཅི་ཐུབ་བྱས།",
    "གྲུ་གཏོང་སའི་རི་ཐོད་དུ་རྒྱ་དམག་མང་པོ་གབ་འཇབ་བྱས་ནས་ཡོད་པ་དེ་ཚོས་ཀྱང་མཐོང་མི་འདུགརྒྱ་དམག་ནོར་གླིང་དུ་འཛུལ་རྗེས་ཤི་རོ་མགོ་རིལ་ཚང་མ་ཨ་སློག་བརྗེས་ཏེ་འཚོལ་ཉུལ་ཀུན་ཏུ་བྱས་མཐར།",
    "ནོར་གླིང་ཤར་ནུབ་གཉིས་ནས་མེ་སྒྱོགས་དང་རང་འགུལ་མེ་མདའ་ཟུང་ཁ་བསྒྲིགས་ནས་ཡོད་པས།",
    "དམག་མིས་གནམ་གྲུ་ནས་དབོར་འདྲེན་ཡང་གནང་འདུག་པས་སྲོག་སྦྱིན་གྱི་བཀའ་དྲིན་དེ་ལྷག་མ་མཆིས།",
    "གངས་ལ་གཉིས་ག་ཧ་ཅང་མཐོ་ལ་རི་གཟར་ཆེ་ཞིང་མི་རྐྱང་ང་བགྲོད་ཐུབ་ཙམ་ལས་མི་འདུག་གཡས་གཡོན་དུ་གངས་ཀྱི་རྩིག་པ་ལྟ་བུར་སྣང་བས་སྐྱོག་ཐུབ་ཐབས་མི་འདུག་ལ།",
    "ཕལ་ཆེ་བ་བཟའ་ཆས་རྫོགས་ཏེ་སྔོ་རྩྭ་སོགས་བསྒྲུགས་ནས་བཞེས་དགོས་པ་སོགས་ཀྱི་སྐུ་ངལ་ཆེན་པོ་བྱུང་འདུག་ལ།",
    "དེས་མ་བཟོད་ནས་ཕྱིར་ལོག་བྱེད་མཁན་ཡང་གང་འཚམས་བྱུང་འདུག་དེ་ནས་སྦག་སར་གསོག་འཇོག་བྱས་འདུག་ལ།",
    "དེ་ནས་རིམ་གྱིས་བྱང་ཝི་ཏི་ནམ་དུ་ལོ་བཅུ་ཕྲག་གཉིས་སྐོར་མི་རྒྱུ་གཉིས་ཐོག་ནས་རོགས་རམ་ཚོད་མེད་བྱས་མཐར་མ་འཆམ་པར་དམག་ཤུགས་ཆེན་པོས་ལེན་རྩིས་བྱས་ཀྱང་རང་ཉིད་ཕམ་ཉེས་ཀྱིས་འཛམ་གླིང་དུ་སྔོ་ལོའི་རྒྱལ་མཚན་འཕྱར།",
    "ལ་ལས་དེའི་སྔོན་དུ་ཡི་གེའི་རྣམ་གཞག་འདུག་པས་ཐུན་མིས་གསར་བཟོ་བྱས་པ་མིན་ཞེས་མགྲིན་པ་བཏེགས་ཏེ་སྨྲ་བ་ནི་བློ་གྲོས་རྩིང་པའི་སྐྱོན་དུ་སྣང་བས།",
    "སྒོམ་ཞྭ་སེར་པོ་བཞེས་པའི་སྐུ་ཐང་དེ་བཀྲ་ཤིས་ལྷུན་པོར་རྒྱ་ནག་ལྷ་ཁང་དུ་ཡོད་པ་གྲྭ་བགྲེས་མང་པོས་མཐོང་འདུག་ལ།",
    "དེ་བཞིན་རུ་སུས་སྲུང་སྐྱོབ་འོག་རྒྱལ་ཁབ་ཇི་སྙེད་ཅིག་འདུག་ཅིང་།",
    "སློབ་ཐོན་རྣམས་ཀྱང་རང་རང་ཤེས་འཇོན་གྱི་ནམ་འཕང་བཅད་དེ་འཛམ་གླིང་ཕྱི་ནང་གང་སར་ལས་དོན་གྱི་འོད་བརྒྱ་སྤྲོ་བཞིན་ཡོད་པ་དང་།",
    "བོད་ཆུང་ཡང་རང་བཙན་རྩོད་སྒྲུབ་བྱེད་པར་ཆ་རྐྱེན་ཧ་ཅང་མང་བས་དཔའ་ཞུམ་དགོས་དོན་མེད།",
    "ད་ལྟའང་དེ་ལྟ་བུའི་མཐོང་ཚུལ་ཞིག་འདུག་དེས་ད་ཆ་གྱོང་གུད་ག་ཚོད་ཕོག་འདུག་དྲན་གསོས་ཀྱིས་ཕྱིན་ཆད་སྤང་བླང་མ་འཛོལ་བའི་ལམ་ཕྱོགས་ཤིག་ད་ལྟ་ནས་གཞི་འདིང་དགོས་པར་སྙམ།",
    "ཆ་གཅིག་ལ་ཧོ་སེའི་ས་མཚམས་དང་ཕལ་ཆེར་འབྲེལ་ཡོད་ཚོད་འདུགདེ་ནས་ཉི་ནག་རོང་བརྒྱུད་དེ་འཇོལ་པའི་ས་མཚམས་དང་ཐུག་འཇོལ་ཀོང་གཉིས་ཀྱི་བར་ན་ནགས་རི་དང་།",
    "དབུས་གཞུང་ནས་ཆེ་བསྟོད་དང་གཟེངས་རྟགས་ཐོབ་པ་དུ་མ་བྱུང་འདུག་པ།",
    "མཛད་འཕྲིན་ཡང་རྒྱས་པོ་བྱུང་འདུག་ལ་ལྷག་པར་དུ་འཇང་ཡུལ་ཕྱོགས་སུ་ཡུན་རིང་བཞུགས་ཏེ་དགོན་ཁག་བཅུ་གསུམ་ཙམ་ཕྱག་བཏབ་པ་དང་།",
    "ཕན་གྲོགས་ཚུལ་མཐུན་དགོས་པའི་བཀའ་རྒྱ་གོས་ཆེན་ལ་བྲིས་པ་ཞིག་ཕྱིར་སྩལ་གནང་འདུག་པ།",
    "དུས་མཚུངས་འཇོལ་ཀོང་གཉིས་སུའང་ས་དཔྱོད་པ་ཆེད་བརྫངས་གནང་འདུག་པ།",
    "དགེ་ལུགས་རིམ་གྱིས་དར་ཏེ་དགོན་ཆུང་ཁག་མང་བྱུང་འདུག་པ།",
    "ཐ་མར་སྐུ་གཤེགས་ས་ཡང་གོང་ཞུས་ལྟར་གཉའ་ནང་བསྟན་མདའ་དཔོན་གྱི་གཟིམ་ཤག་ཏུ་ཡིན་འདུག་པ་དེའི་སྐུ་ཆས་དང་རྟེན་རྫས་བསམ་གྱིས་མི་ཁྱབ་པ་དང་།",
    "དེ་བཞིན་འཇོལ་པའི་ཕྱོགས་ཀྱི་འཇའ་རིགས་ཀྱི་ཁོངས་སུའང་བཀའ་དགོན་འགའ་ཞིག་ཡོད་འདུག་པ།",
    "དེ་ཡང་འབྲས་སྤུངས་བློ་གསལ་གླིང་ནས་གཏོང་སྲོལ་འདུག་པ་ཕྲན་ཚོའི་དུས་སུའང་ཕེབས་ཀྱི་འདུག་ཅིང་།",
    "༡༦༧༤ ལོར་སྐུ་གཤེགས་འདུག་ལ།",
    "བྱང་ངོས་ཀྱི་མཐའ་གྲལ་གྱི་མཇུག་ཏུ་ལྕམ་སྲིང་རང་བྱོན་དུ་གྲགས་པའི་ལྡེབས་བྲིས་བཞུགས་ཤིང་།",
    "དེང་དུས་སུའང་བཙུན་མ་སུམ་ཅུ་ལྷག་ཙམ་བཞུགས་འདུག་ནང་རྟེན་གྱི་གཙོ་བོ་སེང་གདོང་མ་ཤིན་ཏུ་རྩ་ཆེ་ཞིག་དང་།",
    "ལས་བཞིའི་མཐུ་ནུས་ལ་མངའ་བརྙེས་པ་ཞིག་བྱུང་འདུག་པ་འོག་ཏུ་གསལ།",
    "དེང་སང་རང་ཡུལ་དུ་བཞུགས་ཡོད།",
    "འདིའི་གཏམ་རྒྱུན་ཞིག་ལ་གསེར་བུམ་སྤྲུག་ནས་ག་དུས་ཐོན་ཡང་དེ་གསུམ་མཉམ་དུ་ཐོན་ནས་ཆ་ཕྱེ་མ་ཐུབ་པ་ན།",
    "དེ་བཞིན་དགོན་ནང་དུ་གོ་མཚོན་རིགས་སྦས་ནས་ཁྱེར་བ་དང་ཉར་མཁན་ཡོད་ཀྱང་མངོན་གསལ་དོད་པོར་ཁྱེར་བ་དང་རང་ཤག་ཏུ་བསྟན་ནས་བཞག་པ་སོགས་ནི་མི་ཆོགགདན་སར་གྲྭ་རྒྱུན་འགྲོ་ཁར་ལས་སྣེ་བཞི་སྒྲིལ་ལ་གསོལ་ཚིགས་ཕུལ་ཏེ་དགོངས་ཞུ་དགོས་པ་དང་།",
    "མཁས་པ་དང་གྲུབ་པ་ཐོབ་པ་ཉུང་ཤས་ལས་བྱུང་མི་འདུགསྨྲས་པ།",
    "གདན་སར་གཏོང་སྒོ་གཏོང་མ་ཐུབ་ནའང་སླར་ཡང་རང་དགོན་དུ་བསབ་ཆ་ཆེན་པོ་བྱེད་དགོས་ཤིང་།",
    "བསླབ་པ་འཆལ་བ་སྔ་ཕྱི་བསྡོམས་བརྒྱད་ཅུའི་སྐོར་རྩ་དགོངས་རང་ཞུ་བྱེད་དགོས་བྱུང་འདུག་དེའི་ནང་ཕལ་ཆེ་བ་ལོག་གཡེམ་གྱི་ཕམ་པ་བྱུང་བ་དང་།",
    "གངས་རི་ནས་ཆུ་གཙང་མ་ཞིག་རྒྱུགས་ཏེ་མཚོ་ཆེན་པོ་ཞིག་ཏུ་འཁྱིལ་བའི་གཟིམ་སྣང་བྱུང་བས་ད་གཙང་མར་ཆགས་འདུག་ཅེས་ཐུགས་ཤིན་ཏུ་དགྱེས་པོ་གནང་བར་གྲགས།",
    "ཕྱི་དྲོ་ཁྱིམ་ཚང་སོ་སོར་གྲལ་འཁོད་ཀྱིས་སྒྲོལ་མ་དང་དམིགས་བརྩེ་མ་སོགས་གཟུངས་སྔགས་དང་ཁྱད་པར་དུ་ཡིག་དྲུག་གྲངས་གསོག་དུས་ཆེན་ཁག་ཏུ་མཉམ་འཛོམས་ཀྱིས་སྒྲོལ་མ་དང་དམིགས་བརྩེ་མ།",
    "དེ་དག་ཚོན་སྣའི་རིགས་ཀྱང་ཕལ་ཆེར་རང་ཁུངས་ནས་ཐོན་གྱི་ཡོད་འདུགགསེར་དངུལ་སོགས་ལས་སྐུ་བརྙན་བརྡུང་བླུག་བསྲེག་གསུམ་གྱི་མགར་བ་ནི་དམིགས་བསལ་མེད་ཅིང་།",
    "ལམ་བར་ཟླ་བ་གཉིས་ལྷག་ཙམ་འགོར་གྱི་འདུག་ཕལ་ཆེ་བ་ལྷ་སར་ཟླ་བ་གཉིས་གསུམ་ལས་མང་བ་སྡོད་ཀྱི་མེད།",
    "རྒྱ་དཔོན་དེས་ལི་མ་ལས་བསྐྲུན་པའི་སྤོས་ཕོར་ཆེ་ལེགས་སེང་གེ་བཞིས་བཀྱགས་བསྡད་པ་གཅིག་ལེགས་སྐྱེས་སུ་གནང་འདུག་པ་ཕྲན་ཚོའི་དུས་སུའང་ཡོད།",
    "དེ་འཕྲོས་རྣམས་ཚོད་མེད་དུ་བྲོས་འདུག་ཁོ་ཚོའི་དཔའ་ཐུལ་ཕལ་ཆེར་དེ་རུ་བསད་པར་གྲགས།",
    "མདེའུ་སྐོགས་ཀྱིས་ཨམ་ཕྲག་གང་ནས་ཡོད་འདུག་ཀྱང་མཚོན་གཅིག་ཀྱང་མ་ཟུག་པས་སྙན་གྲགས་ཀྱིས་རི་ལུང་འགེངས་ཏེ།",
    "སྐབས་དེར་འཇོལ་བའི་ཡུལ་དམག་དང་རྒྱ་དམག་ཉིས་བརྒྱའི་སྐོར་ཡང་དམག་རོགས་སུ་འབྱོར་འདུག་དམག་འཁྲུག་དེ་ནི་ཕྲན་ཚོའི་ཕ་མའི་དུས་སུ་ཡིན།",
    "མང་པོ་ཞིག་བྲོས་ཐར་ཐུབ་ཙམ་བྱུང་འདུག་དེ་ནི་དྭང་བླངས་དམག་མི་རྣམས་ཀྱི་ཕམ་ཉེས་ཆེ་ཤོས་ཡིན་འདུག་སྔོན་དུ་གསང་བརྡ་གཏོང་མཁན་བྱུང་འདུག་ཀྱང་ཁོ་ཚོ་ཡིད་མ་ཆེས་པར་ལྷོད་ཡངས་ཤོར་བ་ཡིན་སྐད།",
    "རིམ་པར་ལྷག་བསྡད་དང་གསར་འབྱོར་བསྡོམས་བྲག་ལངས་རི་རྩེར་གུང་དམག་དང་སླར་ཡང་འཐབ་སྟེ་གུང་དམག་ལ་ཕམ་ཉེས་ཆེན་པོ་བཏང་འདུགགནས་དེར་བྲག་རི་མི་ལངས་པ་ལྟ་བུ་ཡོད་པས་ན་བྲག་ལངས་ཞེས་བརྗོད་ཀྱང་སྐད་ཟུར་ཆག་ནས་ཡུལ་མིས་བྲ་ཡང་ནང་ཞེས་ཟེར།",
    "སྐྱ་སར་བབ་པ་རྣམས་ཕུད་ནས་བསླབ་སྡོམ་གཙང་མ་སུམ་བརྒྱ་སྐོར་ཞིག་བཞུགས་འདུག་དེ་དག་དགྲའི་མདུན་སར་ཡོད་པར་བརྟེན།",
    "རྒྱ་དམག་དེ་ཚོ་ཟླ་བ་གསུམ་བཞི་ཙམ་གྱི་རིང་བསྡད་དེ་བོད་རིགས་སུའང་ཡོང་བཅུག་མི་འདུག་དེ་རྗེས་དམག་མི་ཚོ་ཕྱིར་ལོག་བྱས་པ་དང་།",
    "ཚར་ཐང་བཀྲ་ཤིས་རྡོ་རྗེ་བཞི་ནི་དཔའ་ཐོན་གྱི་སྐད་གྲགས་བྱུང་འདུག་དམག་སྒར་ནང་མཆོངས་ཏེ་སྲོག་ཤོར་བ་གཉིས་བྱུང་ཡང་མིང་གསལ་མ་དྲན།",
    "གཡས་གཡོན་དུ་མེ་སྒྱོགས་ཕོག་པས་ཞེད་སྣང་ཆེན་པོས་བྲོས་ཡོང་ནས་ཁང་ཚན་དུ་སླེབས་ནས་ཀྱང་ལུས་འདར་བ་དང་སྐད་འདར་ནས་སྒྲ་དག་པོ་ཤོད་ཐུབ་ཀྱི་མི་འདུག་ལ།",
    "གནས་དེ་རྒྱ་གར་ནང་ཚ་བ་ཧ་ཅང་ཆེ་བའི་གྲས་ཤིག་ཡིན་པ་མ་ཟད་ཚ་བ་ཤུགས་ཆེ་བའི་སྒང་སླེབས་འདུག་ཅིང་།",
    "ཞིག་རལ་ཡང་མང་པོ་འདུག་པ་ནི་སྔར་ཁ་ཆེ་ཕམ་ཉེས་བཏང་བའི་གནས་ཤིག་ཡིན་པར་གྲགས།",
    "དཀར་ཡོལ་སོགས་དངོས་པོ་མནོག་ཆེ་བ་མཐའ་དག་ཆག་གྲུམ་ཤོར་འདུག་རྒྱས་པ་འདིར་མ་སྤྲོས།",
    "ད་ཆ་དེ་བས་ཀྱང་རང་ཕྱོགས་ཀྱི་རྒྱལ་ཁ་ཉི་མ་ཤར་བ་ལྟ་བུ་འཛམ་གླིང་ནང་ནས་གསལ་ཐུབ་པ་དེས་བརྗོད་མི་ཤེས་པའི་དགའ་ཚོར་གསར་པ་རྙེད་ཡོད།",
    "ཞིང་འབྲོག་པའི་ཐོན་འབབ་རྣམས་ཆབ་སྲིད་པས་མིང་འདོགས་སྣ་ཚོགས་ཀྱིས་བསྡུས་པས་ཆབ་སྲིད་པའི་ཚེ་གཡོག་དངོས་གནས་ཆགས་ཀྱི་འདུགཕྲན་ཨུ་རུ་སུའི་ནང་ཐེངས་གཉིས་འགྲོ་མྱོང་།",
    "གང་ལྟར་ས་གནས་མི་མང་ལ་དགོས་མཁོ་གང་ཡོད་པ་དེ་མི་མང་རང་ལ་བསྒྲུབ་ཏུ་འཇུག་པ་དང་།",
    "རང་རང་འདོད་པའི་དཔལ་ལ་འགོད་པར་མཛད།",
    "གནའ་རབས་ཀྱི་དཔེ་ཚིག་དེ་ལས་གནམ་ཁོ་ནར་བརྟེན་ནས་ཞིང་ལས་ཐོན་སྐྱེད་བྱེད་མི་རུང་བའི་བབ་ཆགས་ཀྱི་ཚན་རིག་བསམ་བློ་ཞིག་ཀྱང་ཤུགས་ནས་མཚོན་གྱིན་མི་འདུག་གམ།",
    "ཤིང་འཚམ་ལ་མིང་དོན་གཉིས་ཚང་ཞིག་ཡོང་བ་འདུག་ཟེར་བ་ལྟ་བུ་དེ་རིགས་ལ་སྤྱོད་པ་སྐབས་དང་བསྟུན་ཆོག།",
    "དགོས་པ་གཅིག་བྱུང་ན་འཆུན་པ་གཅིག་བྱུང་དོགས་མི་འདུག་གསུངས།",
    "སློབ་དཔོན་ཆེན་པོ་འདི་ནི་སྐུ་ཚེ་དཔག་ཏུ་མེད་པ་ནས་ལམ་འདི་ལ་སྦྱངས་པ་གཅིག་འདུག་ཅེས་ཀུན་གྱིས་བསྟོད་པར་གྱུར་ཏོ།",
    "མང་པོའི་ནང་དུ་ངེས་པ་དང་བཅས་ནས་གསུང་བ་ལ་མཐུ་ཐོགས་པ་མེད་པ་གཅིག་འདུག།",
    "ཡུམ་གྱི་ཐུགས་དགོངས་ལ་འདིའི་མཛད་པ་འདིས་སྲས་ཚ་བྱུང་དོགས་མི་འདུག་སྟེ་འོན་ཀྱང་།",
    "ང་འགྲོ་དགོས་ན་ཁྱེད་རང་རྣམས་མ་གཅིག་པ་དང་དཔོན་ཆེན་གྱིས་རབ་ཏུ་འབྱུང་དུ་སྟེར་བའི་ཡི་གེ་ཁྱེར་ཤོག།",
    "དེ་བར་ང་འདིར་འདུག་པ་ཡིན།",
    "ཉིན་རང་དུ་འབྱར་འདུག་པས་ཐམས་ཅད་ངོ་མཚར་བར་གྱུར་ཏོ།",
    "འདི་ཐ་མལ་པར་མི་འདུག་གསུང་ནས་ཤིན་ཏུ་ངོ་མཚར་བར་གྱུར་ཏོ།",
    "དིང་སང་ཡང་སྐབས་ལ་ལར་འོང་ཞིང་འདུག་གསུངས།",
    "ཁྱད་པར་དུ་དྲུང་པ་ལའང་ཁྱེད་ལ་ཧོར་གྱི་གདན་འདྲེན་ཡོང་བར་འདུག།",
    "འོན་ཀྱང་སྐུ་ཚེ་ཐུང་པར་འདུག།",
    "སྤྱིར་བསྟན་པ་ལ་ཕན་པ་རྒྱ་ཆེན་པོ་ཡོང་བར་འདུག།",
    "འོན་ཀྱང་ད་རང་དུས་སྐལ་ཅི་རིགས་པ་ལས་མི་ཡོང་བར་འདུག་པས་འགྲོ་གསུངས་ནས་ཞི་བར་གཤེགས་པ་ཡིན་གསུངས་སོ།",
    "འདི་ལའང་གཞན་གསལ་པོ་མང་པོ་ཡོད་ཀྱང་མི་དྲན་པར་འདུག་གསུངས།",
    "ཁྱད་པར་རྣམས་བརྗེད་འདུག་གསུངས།",
    "ཨ་ར་པ་ཙ་ན་དང་པུ་ཏྲའི་རྗེས་གནང་།",
    "སྐྱེས་བུ་དམ་པ་འདི་ཉིད་མི་བཞུགས་པས་སའི་བཅུད་ཉམས་འགྲོ་བར་འདུག་ཅེས་ཡིད་གདུང་བར་གྱུར་ཅིང་།",
    "སྟོན་པ་ཐུབ་པ་ཆེན་པོ་ཤེར་ཕྱིན་གསུང་ཞིང་འདུག་པ་གཅིག་བྱུང་བའི་ཞག་འགའ་ན།",
    "སྐུ་རིམ་ལ་འབད་དགོས་པར་གདའ་ཞེས་ལུང་བསྟན།",
    "དུས་ཕྱིས་གཤེགས་པའི་སྐད་ཐོས་དུས་རྩིས་པ་ན་དུས་མཚུངས་པར་འདུག་ཅེས་ཟེར།",
    "མནལ་སད་ནས་ཐུགས་དགོངས་ལ་ཧོར་གྱི་གདན་འདྲེན་གཅིག་ཡོང་པར་འདུག་ནའང་འགྲོ་མི་དགོས་པ་འདུག་སྙམ་ཞེས་གསུངས་སོ།",
    "ད་རྒས་ནས་ཕྱིན་ཀྱང་ཁོང་རྣམས་ལ་ཕན་ཆུང་ཞིང་རང་ལ་གནོད་པ་གཅིག་ལས་མི་ཡོང་།",
    "དམག་མི་ཡོང་བའི་རྒྱུས་ང་རང་ལ་ཡོད་གསུངས་ནས་མི་འབྱོན་པ་ཐག་ཆོད་པའི་ཞལ་ཏ་བསྐུར།",
    "མགོ་ཐོམ་པ་གཅིག་འོང་བར་འདུག་སྙམ་པ་བྱུང་གསུངས།",
    "ང་འདི་བཞིན་རང་བྱས་ན་དབེན་ཞིང་དགེ་སྦྱོར་འཕེལ་བར་འདུག་གསུངས།",
    "སློབ་དཔོན་ཆེན་པོ་བསོད་བློ་བ་གོང་དུ་འདེགས་པར་བྱས་འདུག་ནའང་།",
    "འདི་ལྟ་བུའི་རིགས་ལ་དུས་སྦྱོར་གཉིས་ཀའི་རང་བཞིན་ལ་འདེགས་དགོས་པ་ལ་གཡོ་བའི་དུས་སྦྱོར་ལ་བཏེག་འདུག་གསུང་བ་ལ།",
    "དེ་རང་ལ་ངེས་པ་མེད་སྙམ་ཙ་ན།",
    "ཕྱིས་ས་སྐྱར་ཕྱིན་དུས་དེ་རྣམས་མཐོང་བས་སྔར་གྱི་དེ་དྲན་ནས་མཐོང་སྣང་ལའང་སྟོང་གཟུགས་དང་ཀུན་རྫོབ་རང་བཞིན་པ་མཐོང་བ་གཉིས་ཡོང་བ་འདུག་སྙམ་དུ་ཡིད་ཆེས།",
    "དེ་ལྟར་དུ་རིགས་ཀྱང་མངོན་ཤེས་ཀྱི་ཆར་འགྲོ་བར་འདུག་གསུངས།",
    "བླ་ཆེན་པ་ལ་སྐུ་ཚེ་རིང་པོ་གཅིག་མི་ཡོང་བར་འདུག་གསུང་བའི་ལུང་ཡང་བསྟན་ནོ།",
    "དྲུང་ནས་ཤིན་ཏུ་འོ་རྒྱལ་བར་གདའ་བས།",
    "སྔར་ནས་ཀྱང་དེ་འདྲ་མ་བྱས་ད་ལན་ནུས་པར་གདའ་ཡི་གསུངས་ནས་མ་གནང་།",
    "ང་རང་ལ་རབ་བྱུང་བྱེད་པའི་ཕྱོགས་ལ་དཀའ་སྤྱད་ཆེན་པོ་དགོས་པ་བྱུང་བས།",
    "ནེ་གསིང་སྔོན་པོའི་ཐང་གཅིག་ལ་རྡོ་དཀར་ལ་འཇམ་པ་གཅིག་འདུག་པས།",
    "ང་ལའང་ནུབ་གཅིག་རྨི་ལམ་དུ་ཐང་གཅིག་ན་གདན་ཀ་འདྲ་གཅིག་འདུག་པ་ན།",
    "ཟག་བཅས་ཀྱི་བདེ་བ་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཡིན་ཟེར་བ་དེ་ཤིན་ཏུ་བདེན་པར་འདུག་ཅེས་ཡང་ཡང་གསུངས།",
    "དེ་མིན་ན་ཆ་པའི་སྐུ་འབུམ་ལ་མི་མཇལ་བར་འདུག་གསུང་ནས་མཉེས་ཚོར་ཆེན་པོ་མཛད།",
    "ཞབས་དྲུང་པ་རྣམས་ཀྱིས་ད་ལན་རང་སྐུ་ཁམས་ཀྱིས་མི་ལྕོགས་པར་གདའ་བས་སྟིང་ལ་གནང་བ་འཐད་ཞུས་པས།",
    "དགའ་ལྡན་དུ་གདན་འདྲེན་པ་ཡིན་ཟེར་ནས་ཡུས་ཆེ་ཆེ་ལྟར་འདུག་པའི་སྣང་བ་གཅིག་བྱུང་གསུངས།",
    "དེ་ད་དུང་ལྷང་ལྷང་འདུག་གསུངས།",
    "མ་ཚོར་བར་བསྡད་ན་རང་འཐད་པར་འདུག་སྟེ་མི་ཉན་ཡོང་གསུངས།",
    "ཅི་འདྲ་གདའ་ལགས་ཞུས་པས།",
    "ཉིན་མཚན་ཕལ་ཆེར་ལྟ་སྟངས་ལ་བཞུགས་འདུག་པ་མཐོང་བ་ན།",
    "ཞུས་ན་མང་རབ་གསུང་བའི་རིགས་སུ་འདུག་པས་ཟེར།",
    "འོ་ནའང་དགོས་པ་གཅིག་འདུག་པས་བྲིས་ཤིག་གསུངས་ནས།",
    "ཁྱེད་རང་རྣམས་རང་སར་ཉོལ་ཅིག།",
    "གཞིས་ཁ་གོང་འོག་དང་འབྲེལ་ཡོད་ཀྱི་བུ་སློབ་ཐམས་ཅད་ཀྱིས་རང་རང་སོ་སོར་རྩེ་གཅིག་ཏུ་གསོལ་བ་བཏབ་སྟེ།",
    "གདུང་རྒྱུད་པ་ཁོང་རང་ངམ།",
    "དགོས་པ་ཞིག་བྱུང་ན་འཆུན་པ་གཅིག་བྱུང་དོགས་མི་འདུག་གསུངས།",
    "སློབ་དཔོན་ཆེན་པོ་དེ་ནི་སྐུ་ཚེ་དཔག་ཏུ་མེད་པ་ནས་ལམ་འདི་ལ་སྦྱངས་པ་ཞིག་འདུག།",
    "མང་པོའི་ནང་དུ་ངེས་པ་དང་བཅས་ནས་གསུང་པ་ལ་ཐོགས་པ་མེད་པ་གཅིག་འདུག།",
    "དེའི་རྣམ་འགྱུར་དུ་འདུག་གསུང་ཞིང་།",
    "འདིའི་མཛད་པ་འདིས་སྲས་ཚ་བྱུང་བར་མི་འདུག་སྟེ།",
    "ང་འགྲོ་དགོས་ན་ཁྱེད་རང་རྣམས་མ་གཅིག་དང་།",
    "དེ་བར་དུ་ང་འདིར་འདུག་པ་ཡིན།",
    "ཉིན་རངས་སུ་འབྱར་འདུག་པས།",
    "འདི་ཐ་མལ་པར་མི་འདུག་གསུངས་ནས།",
    "ཁྱེད་ལ་ཧོར་གྱིས་གདན་འདྲེན་ཡོང་བར་འདུག།",
    "འོན་ཀྱང་སྐུ་ཚེ་ཐུང་བར་འདུག།",
    "སྤྱིར་བསྟན་པ་ལ་ཕན་པ་རྒྱ་ཆེན་འོང་བར་གདའ།",
    "འོན་ཀྱང་ད་རང་དུས་སྐལ་ཅི་རིགས་པ་ལས་མི་ཡོང་བར་འདུག་པས།",
    "འདི་ལའང་གཞན་གསལ་པོ་མང་པོ་ཡོད་ཀྱང་མི་དྲན་པར་འདུག་གསུངས།",
    "དོན་ལ་མ་བཟུང་པས་བརྗེད་འདུག་གསུངས།",
    "ཁྱད་པར་རྣམས་བརྗེད་འདུག་གསུངས།",
    "གོང་དུ་མི་ཕེབས་པར་འདུག་བསམ་པ་དང་།",
    "དབུས་པ་ཁྲི་སྐོར་གྱིས་སྤྱི་འདོགས་ཀྱི་ཞབས་ཏོག་བྱེད་དུ་བཅུག་ནས་འཐད་པར་འདུག་བསམ་ནས།",
    "ཨ་ར་པ་ཙ་ན་དང་།",
    "སྐྱེས་བུ་དམ་པ་འདི་ཉིད་མི་བཞུགས་པས་སའི་བཅུད་ཉམས་འགྲོ་བར་འདུག་ཅེས་སྨྲ་ཞིང་།",
