    "སྔོན་དུ་སོང་ན་སྐབས་འདིར་སྔགས་སྡོམ་གྱི་ངོ་བོར་གནས་འགྱུར་རོ།",
    "འདོད་པ་དྲི་བའི་སྐབས་སུ་བུ་ཁྱོད་སུ་ཡིན་ཅི་ལ་དགའ་ཞེས་པའི་ལན་དུ།",
    "དེ་ཡང་བསྒོམ་བྱ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ཐུན་མོང་བ་ཡིན་ཞིང་།",
    "དེ་ནི་ཕྱི་འཇུག་གི་སྐབས་སུ་ཐོབ་པའི་སྡོམ་པ་ཡིན་ནོ།",
    "དང་པོ་གྲངས་ནི་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་ལ་གྲངས་ཇི་སྙེད་ཅིག་ཡོད་ཀྱང་དེ་ཐམས་ཅད་མི་བསྐྱོད་པའི་ངོ་བོར་སྡོམ་མོ།",
    "གསུམ་པ་དམ་ཚིག་ནི་རིག་ལྔ་སྤྱི་དང་བྱེ་བྲག་གི་དམ་ཚིག་ཐོབ་པ་ཡིན་ཏེ།",
    "རྗེ་བཙུན་རྩེ་མོས།",
    "དང་པོ་ནི་མེ་ཏོག་གང་ཕོག་གི་ལྷ་ལ་བརྟེན་པ་ཡིན་ལ།",
    "རིགས་བདག་གིས་རྒྱས་གདབ་པའི་དུས་སུ་ཐོབ་བོ།",
    "དེ་རེ་རེ་ལའང་ལྔ་ལྔ་སྟེ་ཉི་ཤུའོ།",
    "དུས་ཁྱད་པར་ཅན་གྱི་དམ་ཚིག་ནི་ཟླ་བ་གཅིག་ལ་དུས་དྲུག་གི་བརྒྱད་ཆ་ལ་ཚོགས་ཀྱི་འཁོར་ལོ་བྱའོ།",
    "བུད་མེད་དང་ནི་སྐྱེས་པའི་ལུས།",
    "རང་བཞིན་རྣམ་དག་གི་ཆ་ནས་སྐུ་རྡོ་རྗེ་ཡིན་ནོ་ཞེས་སྐུ་རྡོ་རྗེར་། ཤེས་ནས་གཞན་གྱི་ལུས་ལ་མི་སྨོད་པ་དངོས་སུ་བསྟན་ནས།",
    "ཀུན་རྟོག་དྲྭ་བའི་རྣམ་རྟོག་གིས།",
    "ཞེས་གསུངས་པས་གཞན་གྱི་སེམས་ཉོན་མོངས་པས་གདུང་བ་དང་།",
    "རང་བཞིན་རྣམ་དག་གི་ཆ་ནས་ཐུགས་རྡོ་རྗེ་ཡིན་ནོ་ཞེས་ཐུགས་རྡོ་རྗེར་ཤེས་ནས་གཞན་གྱི་སེམས་ལ་མི་སྨོད་པ་དངོས་སུ་བསྟན་ནས།",
    "གསུང་གི་རྡོ་རྗེའི་དམ་ཚིག་གོཞེས་གསུངས་པས་རྒྱུ་ཕྲག་དོག་གིས་ཀུན་ནས་བསླངས་ཏེ།",
    "ངག་གི་བཞི་སྤངས་པ་ངག་གི་སྡོམ་པ།",
    "ངག་གི་ལས་བཟང་ངན་ལ་བླང་དོར་མེད་པ་གསུང་རྡོ་རྗེའི་དམ་ཚིག།",
    "ཐུགས་རྗེས་སྤྲུལ་པའི་སྐྱེས་མཆོག་ཁྱོད་ལ་འདུད་། ཕུང་ཁམས་སྐྱེ་མཆེད་སྒོ་གསུམ་དྲི་མ་སྦྱངས།",
    "དགོས་ལྡན་གྱི་བསྟན་བཅོས་དོན་དུ་། ཞིག་གི་སྒོ་ནས་འཆད་པ་དང་བཞིའོ།",
    "གཤིན་རྗེ་གཤེད་དགྲ་ནག་གི་ལེའུ་བདུན་པར་བཞུགས་སོ།",
    "དགྲ་ནག་གི་རྒྱུད་དུ་གོ་རིམ་འཁྲུགས་པའི་ཚུལ་གྱིས་ཞུགས་པས་ན།",
    "གཞུང་གི་དོན་གཉིས།",
    "གཉིས་པ་གཞུང་གི་དོན་ལ།",
    "དང་པོ་ནི་རྒྱུད་རྒྱས་པའི་ལུང་གྲུབ་ཆེན་དཔལ་འཛིན་གྱིས་དགྲ་ནག་གི་དཀའ་འགྲེལ་དུ་དྲངས་པ་ལས།",
    "གསུམ་པ་ནི་ལུས་ངག་གང་རུང་གི་གྲོགས་ཡོད་ཀྱང་རུང་མེད་ཀྱང་རུང་གཙོ་བོར་ཡིད་ཀྱིས་བརྙས་པའོ།",
    "དེང་ཕྱིན་ཆད་བུ་ཁྱོད་ཀྱི་དཔལ་ཧེ་རུ་ཀ་ང་ཡིན་གྱི།",
    "ངས་ཇི་ལྟར་བསྒོ་བ་བཞིན་ཁྱོད་ཀྱིས་དེ་ལྟར་བྱ་དགོས་སོ།",
    "རྣམ་སྣང་གི་དམ་ཚིག་གནས་སྐབས་སུ།",
    "ཁྱོད་ཀྱི་སྤྱན་སྔར་མཐོལ་ལོ་བཤགས་སོ།",
    "དེ་ལྟར་མཐོལ་ཞིང་བཤགས་ན་བདག་བདེ་བ་ལ་རེག་པར་འགྱུར་གྱི།",
    "ཕ་རོལ་པོས་ཕྱིན་ཆད་རྡོ་རྗེ་འཆང་གི་བཀའ་བཞིན་དུ་སྡོམ་མམ།",
    "རང་གིས་སྡོམ་ལགས་སོ་ཞེས་དང་།",
    "དེ་དག་གི་དོན་ཡང་རང་ཉིད་ཡི་དམ་དུ་གསལ་བའི་སྤྱི་བོར་པདྨ་དང་ཟླ་བ་དང་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ།",
    "ཁཾ་ལས་རལ་གྲི་ལྗང་གུ་ཁཾ་གིས་མཚན་པ་དེ་ལས་འོད་ཟེར་འཕྲོས་འདུས་ཡོངས་སུ་གྱུར་པ་ལས།",
    "དེའི་བཞི་ཆའི་སྦྱིན་སྲེག་གི་སྒོ་ནས་ཚོགས་འཁོར་གྱི་སྒོ་ནས།",
    "རང་གི་རྡོ་རྗེ་སློབ་དཔོན་ནམ།",
    "ངོ་བོ་ཉིད་ཀྱི་སྒོ་ནས་ལུས་ངག་གང་རུང་གི་གྲོགས་མེད་པར་ཡིད་རྐྱང་པས་བརྙས་ན་ཆུང་ངུ།",
    "གང་རུང་གི་གྲོགས་དང་བཅས་ཏེ་བརྙས་ན་འབྲིང་།",
    "ཉོན་མོངས་མང་བའི་སྒོ་ནས་བརྙས་ན་ཆེན་པོའོ།",
    "དེ་ལ་ཡང་ཉན་ཐོས་དང་ཐུན་མོང་བའི་ཕམ་པ་བཞི་དང་།",
    "མིའམ་མིར་ཆགས་པ་ལ་སོགས་པ་བཅས་པ་རང་རང་གི་སྐབས་ལས་ཤེས་པར་བྱའོ།",
    "གསུམ་པ་ནི་གཙོ་བོར་ཡིད་དགོས་ཤིང་ལུས་ངག་གང་རུང་གི་གྲོགས་ཀྱང་དགོས་སོ།",
    "བཞི་པ་ནི་ཐུན་མོང་བའི་རྒྱུ་བཞི་སྔོན་དུ་བཏང་ནས་ཁྱད་གསོད་ཀྱི་ཀུན་སློང་གི་བསམ་པས་སོ།",
    "གསུམ་པ་ནི་རྒྱུད་རྡོ་རྗེ་རྩེ་མོ་ལས།",
    "ཁྱོད་ཀྱིས་སྲོག་ཆགས་གསད་མི་བྱ།",
    "རིགས་ལྔ་སྤྱིའི་དམ་ཚིག་གི་སྐབས་སུ།",
    "ལུས་ངག་གང་རུང་གི་གྲོགས་ཀྱང་དགོས་ཏེ།",
    "ལུས་ངག་གང་རུང་གི་གྲོགས་མེད་ན།",
    "བཞི་པ་ནི་སྔར་ལྟར་ཐུན་མོང་གི་རྒྱུ་བཞི་སྔོན་དུ་བཏང་བའི་སྒོ་ཀྐ་། ནས་དགྲར་འཛིན་པའི་བསམ་པས་ཁྲོས་པའོ།",
    "གསུམ་པ་ནི་འདིར་སེམས་རྐྱང་པས་རྫོགས་པས་ལུས་ངག་གང་རུང་གི་གྲོགས་མེད་ཀྱང་རུང་ངོ།",
    "དོན་ཡོད་གྲུབ་པའི་དམ་ཚིག་གི་སྐབས་སུ།",
    "རིགས་ལྔ་སྤྱིའི་དམ་ཚིག་གི་སྐབས་སུ།",
    "འོད་དཔག་མེད་ཀྱི་དམ་ཚིག་གི་སྐབས་སུ།",
    "དང་པོ་ནི་རང་གི་དམ་ཚིག་རྫས་སུ་བཟུང་བའི་རྡོ་རྗེ་དྲིལ་བུ་ཅང་ཏེའུ་སོགས་ལ་འདི་དང་འདི་ཞེས་བསྒྲགས་པའི་སྒོ་ནས་བསྟན་པའོ།",
    "གསུམ་པ་ནི་རིམ་གཉིས་ཀྱི་མན་ངག་ཟབ་མོ་བསྟན་པའམ།",
    "ཧེ་རུ་ཀ་དཔལ་དེང་ཁྱོད་ཀྱི།",
