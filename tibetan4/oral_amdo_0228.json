    "བུད་མེད་དེ་མཚོན་པའི་རྟགས་ཤེས་རབ་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཁས་བླངས་པའི་ཕྱིར།",
    "དེ་མཚོན་པའི་རྟགས་ཤེར་ཕྱིན་བུད་མེད་ཡིན་པས།",
    "སྐྱེ་བ་བཅུ་དྲུག་ཚུན་ཆད་དུ་མཆོག་གི་དངོས་གྲུབ་ངེས་པར་ཐོབ་པར་འགྱུར་རོ།",
    "གང་ཟག་གང་གིས་ན་མཐར་ཐུག་བདག་ལ་ཕན་པར་འདོད་པའི་སྔགས་པས་སོ།",
    "ཡན་ལག་གི་སྒྲ་དོན།",
    "ཐེག་ཆེན་ལ་མ་དད་པའི་གང་ཟག་གི་ནང་དུ་ཞག་བདུན་གནས་ཏེ།",
    "རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སེམས་མ་རྡོ་རྗེ་མ་ལ་སོགས་པའི་ཕྱག་རྒྱ་བསྟན་ན་ཡན་ལག་གི་ལྟུང་། བའོ་། བརྒྱད་པ་ནི།",
    "གཉིས་པ་ཡན་ལག་གི་སྒྲ་དོན་ནི།",
    "ཉིན་དང་མཚན་མོ་ལན་གསུམ་དུ།",
    "ཉིན་རེ་བཞིན་དུ་བཟླ་བར་བྱ།",
    "ཉིན་དང་མཚན་མོར་ལན་གསུམ་གསུམ་འདོན་ཞིང་།",
    "གལ་ཏེ་བྱུང་ན་རང་རང་གི་ཕྱིར་བཅོས་བྱེད་པ་སྐབས་ཐོབ་ཀྱིས་ཤེས་པར་བྱའོ།",
    "གང་གི་ཐུགས་རྗེའི་འདབ་སྟོང་དགོད་པ་ལས།",
    "ཐུན་མོང་མཆོག་དངོས་འཛད་མེད་རོ་བདའི་དཔལ།",
    "དཀའ་སྤྱད་བྷ་གི་ར་ཐས་ཉེར་ཕབ་ཀླུང་།",
    "ཞབས་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "སྤྱན་གསུམ་ནམ་མཁའ་ལ་ཧྲིག་ཧྲིག་གཟིགས་པ།",
    "སྲིད་པ་གསུམ་གྱི་དངོས་གྲུབ་ཐམས་ཅད་རིལ་གྱིས་བསྡུས་ནས་རང་གི་མདུན་དུ་ཟས་ནོར་ལོངས་སྤྱོད་རི་རབ་ཙམ་སྤུངས་པར་བསམ།",
    "དེ་དག་ནི་བསྐྱེད་རིམ་མོ།",
    "རྩེ་མོར་མགོན་པོའི་ཙ་ཀ་ལི་དང་།",
    "གཏོར་མ་ནང་མཆོད་ཆུ་གཙང་གིས་བྲན་ལ།",
    "ཨོཾ་ཨ་མྲྀ་ཏས་བསང་།",
    "བསྡུ་ན་སྐད་ཅིག་གིས་སྤྱན་དྲངས།",
    "འགྲོ་འདིའི་ཕུན་ཚོགས་རེ་བ་སྐོང་བའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་ཡིད་བཞིན་གཟི་ལྡན་ཐུགས་རྗེ་ཅན་ཁྱོད་ལ་གསོལ་བ་འདེབས་སོ།",
    "གོང་གི་ཉེར་བསྡུ་ཞེས་པའི་རྫོགས་རིམ་སྐབས་འདིར་བསྒོམ་ཀྱང་རུང་བས་གང་མོས་བྱའོ།",
    "སྟེགས་བུ་རྟེན་ཁེབས་ལ་སོགས་པས་བཀབ་པར་མེ་ཏོག་གི་སིལ་མ་བཀྲམ་པའི་སྟེང་དུ།",
    "རང་གི་མདུན་དུ་རྡོ་རྗེ་དྲིལ་བུ་ནང་མཆོད་སོགས་འོག་ཏུ་མཁོ་བའི་ཡོ་བྱད་རྣམས་མ་ཚང་བ་མེད་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏ་ཀུཎྜ་ལི་ཧ་ན་ཧ་ན་ཧཱུྃ་ཕཊ་ཅེས་པས་བསང་།",
    "ཞབས་བསིལ་སོགས་ནས་ཨོཾ་བཛྲ་ཤབྡ་ཨཱ་ཧཱུྃ་གི་བར་དང་།",
    "དྷརྨྨ་ར་ཎི་རོལ་མོ་དང་བཅས་པས་བྱིན་གྱིས་བརླབས།",
    "ཨོཾ་གུ་རུ་མ་ཧཱ་ཀཱ་ལ་ས་པ་རི་ཝཱ་ར་རེ་རེ་སྔོན་འགྲོའི་ཨརྒྷཾ་སོགས་ཀྱིས་ཕྱི་མཆོད་དང་།",
    "འབུལ་གཏོར་སྔར་ལྟར་བྱིན་གྱིས་བརླབས་པའམ་བསྡུ་ན་འབྲུ་གསུམ་ལན་གསུམ་གྱིས་བྱིན་གྱིས་བརླབས་ལ་ཐལ་མོ་སྦྱར་བ་ཁ་ཕྱེ་བའི་ཕྱག་རྒྱ་དང་བཅས་ཏེ་གོང་ལྟར་ཕུལ་ལ་མཆོད་བསྟོད་དང་གསོལ་གདབ་ཇི་ལྟར་རིགས་པ་བྱས།",
    "མཆོག་དང་ཐུན་མོང་གི་དངོས་གྲུབ་ལོ་ཟླས་འགྲུབ་པ།",
    "སྙིགས་མར་སོང་བས་ཉོན་མོངས་པ་རགས་པ་གདུག་པ་ཆེར་སོང་བ་གཟིགས་པ་དང་།",
    "རིགས་ཀྱི་བུ་དེ་ལྟ་བུའི་སེམས་བསྐྱེད་ལས་གཞོལ་བ་ནི་ཤིན་ཏུ་མ་ལེགས་པས་དེའི་བཤགས་པ་ལ་སྔར་ལས་རྒྱ་ཆེ་བ་ཞིག་གི་སེམས་བསྐྱེད་ཅིག་གསུངས་ནས།",
    "བར་དུ་གཅོད་པའི་དགྲ་བགེགས་ཐམས་ཅད་སྐད་ཅིག་གིས་བརླག་པར་བྱེད་པ།",
    "སྐྱེ་འགྲོའི་རེ་བ་ཚུལ་བཞིན་དུ་སྐོང་བའི་ཡིད་བཞིན་གྱི་ནོར་བུ་ལྟ་བུར་གྱུར་པ་དང་ས་རྣམ་པ་དྲུག་ཏུ་གཡོས་སོ།",
    "མ་མོ་དང་བཅས་པ་རྣམས་ཀྱིས་ཀྱང་ལས་སྣ་ཚོགས་བསྒྲུབ་པར་འགྱུར་རོ།",
    "རྗེས་གནང་གི་གཞི་དགོད་པའི་དོན་དུ་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "སློབ་དཔོན་ལ་མོས་གུས་བྱས་པས་སློབ་དཔོན་མགོན་དཀར་དུ་གསལ་བའི་སྐུ་ལས་འོད་ཟེར་འཕྲོས་པས།",
    "དེ་ནས་དངོས་གཞི་སྐུའི་རྗེས་གནང་གི་དོན་དུ་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "ཁྱེད་རང་རྣམས་མགོན་དཀར་དུ་གསལ་བའི་སྐུ་ལུས་ལ་སིབ་ཀྱིས་ཐིམ་པས་རྒྱུད་བྱིན་གྱིས་བརླབས་པའི་མོས་པ་མཛོད་ཅེས་དང་གུ་རུ་མ་ཧཱ་ཀཱ་ལ་ཧ་རི་ནི་ས་སིདྡྷི་ཛ་ཨཱ་ཝེ་ཤ་ཡ་ཨ་ཞེས་ལན་གསུམ་མམ་ལྔ་བརྗོད་ཅིང་རོལ་ཆེན་བྱ་ཞིང་གུ་གུལ་གྱིས་བདུག་དེ་ནི་སྐུའི་རྗེས་སུ་གནང་བ་ཡིན།",
    "གསུང་གི་རྗེས་གནང་གི་སླད་དུ་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "སློབ་དཔོན་ལ་མོས་གུས་བྱས་པས་སློབ་དཔོན་མདུན་བསྐྱེད་གཉིས་ཀ་མགོན་དཀར་དུ་གསལ་བའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས།",
    "དེ་ནི་གསུང་གི་རྗེས་སུ་གནང་བ་ཡིན།",
    "སློབ་དཔོན་ལ་མོས་གུས་བྱས་པས་སློབ་དཔོན་དང་མདུན་བསྐྱེད་གཉིས་ཀ་མགོན་དཀར་དུ་གསལ་བའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས།",
    "ཞབས་གཉིས་གར་སྟབས་ལིང་ངེ་བ་སྤྱན་གསུམ་ནམ་མཁའ་ལ་ཧྲིག་ཧྲིག་གཟིགས་པ་རེ་ལམ་གྱིས་གསལ་བཏབ་པའི་མཁའ་འགྲོ་མ་རྣམས་ཀྱི་སྐུ་ལས་འོད་ཟེར་དམར་པོ་ལྕགས་ཀྱུ་ལྟ་བུ་འཕྲོས་པས་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ཟས་ནོར་བཅུད་གཡང་ལ་སོགས་པའི་དངོས་གྲུབ་ཐམས་ཅད་འུབ་ཀྱིས་བསྡུས་ནས་ཁྱེད་རང་རྣམས་ལ་སིབ་ཀྱིས་ཐིམ་པའི་མོས་པ་མཛོད་ཅེས་དང་སྔགས་སྔར་བཞིན་བརྗོད་ཅིང་རོལ་ཆེན་དང་སྤོས་དུད་བྱ།",
    "དེ་ནས་བཟླས་ལུང་གི་སླད་དུ་སློབ་དཔོན་གྱི་ཐུགས་ཀའི་སྔགས་ཕྲེང་ལས།",
    "སྔགས་ཀྱི་དངོས་གྲུབ་མྱུར་དུ་ཐོབ་པའི་སྐལ་བ་ཅན་དུ་བྱས་སྙམ་དུ་མོས་པ་མཛོད་ཅེས་དང་།",
    "རྟག་ཏུ་སྲུང་སྐྱོབ་མཛད་པ་ཡིན་སྙམ་དུ་མོས་པ་མཛོད།",
    "མདུན་རྟགས་མཆུའམ་བཀྲ་ཤིས་རྟགས་ཀྱི་རི་མོས་མཛེས་པ།",
    "དེའི་ནང་དུ་ནས་དཀར་མོ་སད་སེར་འབུ་སྲིན་གྱིས་ཟོས་པའི་སྐྱོན་མེད་པ་དང་།",
    "ཤིང་ཐོག་གི་རིགས།",
    "མགོན་པོ་ཡིད་བཞིན་ནོར་བུ་འཁོར་དང་བཅས་པ་ཁྱེད་རྣམས་རྟེན་འདི་ལ་བརྟན་པར་བཞུགས་སོགས་འོག་གི་བརྟན་བཞུགས་ཀྱི་ཚིག་རྣམས་ཤོག་བུ་ལ་གསེར་དངུལ་མཚལ་གང་འབྱོར་གྱིས་དབུ་ཅན་དུ་བྲིས་པར་ག་པུར།",
    "གི་ཝང་སོགས་ཀྱིས་བྱུགས་པ་དབུ་ནས་བསྒྲིལ་བ།",
    "འཁོར་ལོ་མན་ངག་ལྟར་བྲིས་པ་ལ་ཐུན་མོང་མ་ཡིན་པའི་རབ་གནས་བྱས་ནས་བལྟབས་ཏེ་སྐུད་པ་དམར་པོས་དཀྲིས་པ།",
    "བུམ་པ་རྣམས་མེ་ཏོག་གིས་བཀྲམ་པའི་སྟེགས་ཀྱི་ཁར་བཞག་ལ་གཟུངས་ཐག་གིས་སྦྲེལ།",
    "བདག་གི་རྣལ་འབྱོར་མགོན་དཀར་དུ་བསྒོམ།",
    "ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏ་དང་སྭ་བྷཱ་ཝའི་སྔགས་གཉིས་ཀྱིས་བསང་སྦྱངས།",
    "ཚིག་ལྷུག་རྣམས་མེད་པའི་སྔགས་དྲུག་དང་ཕྱག་རྒྱ་དྲུག་གིས་བྱིན་གྱིས་བརླབ་ཅིང་རྒྱས་པར་སྤེལ།",
    "འཁོར་དུ་མཁའ་འགྲོ་གནོད་སྦྱིན་ནོར་བདག་གི་ཚོགས་དཔག་ཏུ་མེད་པས་བསྐོར་བ་དང་བཅས་པར་གྱུར།",
    "ཨོཾ་གུ་རུ་མ་ཧཱ་ཀཱ་ལ་ས་པ་རི་ཝཱ་ར་རེ་རེའི་མགོར་སྦྱར་བའི་ཨརྒྷཾ་ནས།",
    "བསྟོད་པ་གང་རུང་གིས་བསྟོད།",
    "མགོན་པོའི་ཕྱག་གི་བུམ་པ་དང་ཐོད་པ་ནས་ཀྱང་ལུད།",
    "དབྱར་གྱི་དཔལ་མོ་དང་འགྲོགས་ཆུ་གཏེར་གྱི།",
    "བུམ་ནང་གི་འདོད་གསོལ་དང་འཁོར་ལོའི་སྔགས་རྣམས་ཀློག་པར་མོས་ལ་སྔགས་རྣམས་ཀྱི་མཐར།",
    "འདི་ཉིད་ཀྱིས་བཀྲ་ཤིས་བཀའ་རྒྱ་མའམ་མི་ཤེས་ན་རྒྱལ་མཚན་རྩེ་མོ་སོགས་གང་རིགས་ཀྱི་བཀྲ་ཤིས་དང་།",
    "རང་གི་ལུས་ལ་བཅང་བ་གང་རུང་བྱ་བ་དང་།",
    "བུམ་པ་ནི་གང་དུ་འཇོག་པའི་ས་དེར་བསྒྲུབས་པ་ཡིན་ན་དེར་གཞན་གྱིས་མི་མཐོང་བར་བྱས་ནས་སྦས་པས་ཆོག་གཞན་རྟེན་གྱི་ནང་ངམ་གཙུག་ལག་ཁང་དང་རང་གི་གནས་ཁང་གི་མཛོད་ཀྱི་ཕུག་སོགས་ལ་གདན་དྲངས་དགོས་ན་གྱང་ལོགས་ལྟ་བུ་ལ་གྲུ་བཞིར་བརྐོས་པའམ་སྒམ་ནང་ལྟ་བུའི་ལོགས་བཞིར་སིནྡྷཱུ་རའི་གཡུང་དྲུང་རིས་བྲིས་པའི་བཞུགས་གནས་སུ།",
    "བུམ་པ་སྤོས་དུད་རོལ་མོ་དང་བཅས་པས་སྤྱན་དྲངས་ལ།",
    "ཡིད་ལ་མངོན་འདོད་གླེང་མོ་ཅི་དང་ཅི།",
    "ཉོན་མོངས་པ་མེད་པ།",
    "བདག་གི་དོན་རྗེས་སུ་ཐོབ་པ།",
    "ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་དད།",
    "སྐྱེ་དགུའི་བདག་མོ་ཆན་མོ་ལསོགས་པ་དགེ་སློང་མ་དྲུག་སྟོང་དང་།",
    "བར་ཆུབ་སེམས་དཔའ་སྤྱན་རས་གཟིགས་དབད་ཕྱུག་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱང་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཤིང་རྫུ་འཕྲུལ་གྱི་ཆ་འཕྲལ་ཆེན་པོ་དོ་མཚར་རྨད་དུ་བྱུང་བ་ཆེ་ན་པོས་བས་མ་གྱིས་མི་ཁྱབ་པ་འདི་ལྟ་བུ་འདི་དགཀྱང་སྣང་བར་གྱུརཔ་འདིའི་དོན་བདག་གིས་སུ་ལ་དྲིཥ་ནན་འདིའི་ལན་ལཱོན་ནུས་པ་ནི་སུ་ཡོད་སྙ་མ་མོ།",
    "བདག་གིས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་ལ་དེའི་དོན་དྲིའི་སྙམ་དུ་སན་ས་སོ།",
    "དོ་མཚར་དུ་གྱུར་རྨད་དུ་གྱུར་ལྟད་མོར་གྱུར་ཏེ།",
    "སྐད་ཅིག་གཅིག་གིས་ཐམསཅད་རབ་ཏུ་སྣད།",
    "མི་རྣམས་གང་གིས་རྒྱ་ཆེ་མཐུ་ཐོབ་ཆིང་།",
    "དེ་བཞིན་རིན་ཆེ་ན་དག་གིས་བརྒྱན་པའི་ཁྱོགས།",
    "ལ་ལ་དག་གིས་མགོ་དང་ལ་ལས་མག།",
    "འདྲེན་བའི་སྦྱན་སྡར་ཐལ་མོ་སྦྱར་བྱས་ནས།",
    "ཁ་ཅིག་གིས་ཀྱང་མ་ལུས་༣གཉིད་སྤངས་ནས།",
    "རྩེད་མོ་དགའ་བ་ཐམས་ཅད་རྣམ་སྤངས་ཏེ།",
    "ཇ་ལྟར་གང་གཱའི་ཀླུང་གི་བྱེ་མ་བཞིན།",
    "རིན་ཆེ་ན་སྣ་བདུན་མཆོག་གི་རྒྱལ་མཚན་གདུགས།",
    "རྣམརྒྱལབདན་བཅས་པ་ཁོར་མོར་མཛེས།",
    "སྔོན་གྱི་དེ་བཞིན་གཤེགས་པ་དེདག་གིས་ཀྱད།",
    "དེ་དག་གིས་བཅོམ་ལྡན་འདས་དེ་ཁག་༡།",
    "དགེ་སློང་དག་དོ་མོདནམ་གྱི་གུརཐུན་ལ་དེ་བཞིན་གཤེགས་བ་ཕུང་པོའ་ལྷག་མ་མ་དཔའ་མྱ་དན་ལས་འདའ་བའི་དབྱིངས་སུ་ཡོངས་སུ་མ་ངན་ལས་འདའོ་ཞེས་བཅུག་གསུངས་སོ།",
    "དེ་ཚེ་སྐད་ཅིག་དཀྱིལ་མོ་དཀྲུང་གོང་བཅས་ནས།",
    "ལྷ་ཡི་བུ་མོ་དྲི་ཟ་མི་འམ་ཅི་། གང་རྣམས་བདེ་བ་ར་གཤེགས་ལ་མཆོད་བརྩོན་པ།",
    "མཁས་པ་ཁྱོད་ནི་འཇིག་རྟེན་མིག་དད་ལམ།",
    "ཤཱཀྱའི་རྒྱལ་ཆེ་ན་དོ་ན་དམ་གཟིགས་པས་ཀྱང་།",
    "ཐལ་མོ་སྦྱར་ཏེ་སེམས་བཟང་བརྩོ་ན་པར་གྱིས།",
    "ཐབས་མཁས་པ་དེ་དང་དེ་དག་གིས་སེམས་ཅ་ན་དེ་དང་དེདེ་ལ་ཆ་ཆགས་པ་རྣམས་རབ་ཏུ་འགྲེལ་བའི་ཕྱིར་རོ།",
    "ཤཱ་རིའི་བུདེ་བཞིན་གཤེགས་བདགྲ།"
  ]
}