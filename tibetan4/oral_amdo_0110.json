    "སྤྱི་ལོའི་སྔོན་གྱི་ལོ་སུམ་སྟོང་ཡས་མས་ཀྱི་དུས་སུ་སུར་མེར་ཞེས་པའི་མི་རིགས་ཤིག་གིས་མར་གཟུགས་ཅན་གྱི་ཡི་གེ་དེ་གསར་བཏོད་བྱས།",
    "དུས་དེ་ཙམ་ནས་ཁོང་ཚོས་ལོ་གཅིག་ལ་ཟླ་བ་བཅུ་གཉིས་ཡོད་པ་དང་།",
    "དེང་དུས་ཀྱི་བརྟགས་འབྲས་དང་བསྡུར་ན་ཚེས་ཟླ་གཅིག་གི་ཡུན་ཚད་ལ་ཧེ་བག་སྐར་ཆ་༤དང་ཉེ་མཐའི་ཟླ་བའི་ཡུན་ཚད་ལ་ཧེ་བག་སྐར་ཆ་༣༦ལས་མེད།",
    "ཉིན་ཞག་གཅིག་གི་ཡུན་དེ་དུས་བཅུ་གཉིས་སམ་ཡང་ན་སྐར་མ་༣༦བྱས་ནས་རྩི་སྲོལ་ཡོད།",
    "ཧན་མོ་ལ་པིའི་དུས་སུ་སེར་ལམ་ཉེ་འགྲམ་གྱི་བརྟན་སྐར་ཁག་ཆ་གྲངས་བཅུ་གཉིས་སུ་བགོས་ནས་རྩི་སྲོལ་ཡོད་པ་དང་།",
    "སྤྱི་ལོའི་སྔོན་གྱི་ལོ་སུམ་སྟོང་ནས་ཉིས་སྟོང་གི་བར་དུ་ཡ་གླིང་ནུབ་ཕྱོགས་སུ་ཡོད་པའི་ཆུ་བོ་ཏི་ཀི་ལི་སིར་གྲགས་པ་དེའི་བྱང་ངོས་ཀྱི་ས་གནས་སུ་ཡ་ཧྲོ་ཞེས་པའི་རྒྱལ་ཁབ་ཞིག་རིམ་བཞིན་ཆགས་པ་རེད།",
    "སྤྱི་ལོའི་སྔོན་གྱི་༡༡ལོའི་ཡ་ཧྲོའི་ལོ་ཐོ་ནང་གི་ཟླ་བ་བཅུ་གཉིས་ཀྱི་མིང་ནི་སྐབས་དེའི་པ་པི་ལོན་གྱི་ལོ་ཐོའི་ནང་བཀོད་དང་ཕལ་ཆེར་མཚུངས།",
    "སྐབས་དེར་ཁོང་ཚོས་དཀར་ལམ་དང་སེར་ལམ་གཉིས་ངོས་འཛིན་བྱས་པ་མ་ཟད་དཀར་སེར་འཕྲད་མཚམས་ཀྱང་རྟོགས་ཡོད་པར་བཤད།",
    "སྤྱི་ལོའི་སྔོན་གྱི་དུས་རབས་དགུ་པའི་སྐབས་སུ་ཁོང་ཚོས་ཟླ་བ་ཉ་གང་བའི་དུས་ཏེ་ཟླ་བའི་དཀྱིལ་འཁོར་དཀར་སེར་འཕྲད་མཚམས་སུ་སླེབ་པའི་ཚེ་ཟླ་འཛིན་འབྱུང་གི་ཡོད་པའི་གནས་ཚུལ་ཡང་ཤེས་རྟོགས་བྱུང་འདུག་གོ།",
    "ཁོང་ཚོས་ཐོག་མར་ལོ་བརྒྱད་རེའི་ནང་དུ་ཟླ་བཤོལ་གསུམ་འདོན་པའི་སྲོལ་བཏོད།",
    "རྗེས་སུ་ལོ་ཉེར་བདུན་རེའི་ནང་དུ་ཟླ་བཤོལ་བཅུ་རེ་འདོན་པར་མཛད།",
    "སྤྱི་ལོའི་སྔོན་གྱི་༣༨ ༣ ལོར་ཞི་ཏན་ནིས་ལོ་བཅུ་དགུ་རེའི་ནང་དུ་ཟླ་བཤོལ་བདུན་རེ་འདོན་དགོས་པར་ཐག་བཅད།",
    "ཨེ་ཇི་ཞེས་པའི་རྒྱལ་ཁབ་ཏུའང་དུས་སྔ་མོ་ཙམ་ནས་གནམ་རིག་དར་ཡོད་པར་མངོན་ཏེ།",
    "སྤྱི་ལོའི་སྔོན་གྱི་དུས་རབས་༡༨ ཙམ་གྱི་སྔ་རོལ་དུ་ཁོང་ཚོས་ལོ་གཅིག་ལ་ཟླ་བ་བཅུ་གཉིས་དང་།",
    "དེ་རྗེས་ནས་ལོ་གཅིག་གི་ཟླ་བ་བཅུ་གཉིས་ཚར་བའི་མཇུག་ཏུ་ཉི་མ་ལྔ་ཁ་བསྣོན་གྱི་ཚུལ་དུ་བཞག་ནས་བརྩིས་པས་ལོ་གཅིག་ལ་ཁྱོན་བསྡོམས་ཉི་མ་༣༦༥རེ་འབྱུང་གི་ཡོད་ལ་རྩིས་ལུགས་དེ་ཡུན་རིང་བར་དུབསྐྱངས།",
    "འོན་ཀྱང་ལོ་གཅིག་གི་ཡུན་ཚད་དངོས་ནི་ཉིན་ཞག་༣༦༥༢༤༢༢ཡིན་པས།",
    "རེར་ཉིན་ཞག་༢༤༢༢གྲངས་ཀྱི་ཧེ་བག་ཤོར་འགྲོ་བ་ཡིན།",
    "དེ་ལྟར་བརྩིས་ནས་དུས་རབས་བཅུ་གསུམ་པ་ལ་སླེབ་སྐབས་ཟླ་བ་བཞི་སྟེ་དུས་ཚིགས་གཅིག་གི་གནའ་རབས་ཨེ་ཛིའི་ལོ་རྩིས་ནང་དུ་ཆུ་ལོག་གི་དུས་ཚིགས་དང་།",
    "དབྱར་གྱི་དུས་ཚིགས་བཅས་དུས་ཚིགས་གསུམ་ལས་མེད་པས་དུས་ཚིགས་རེར་ཟླ་བ་བཞི་བཞི་འོང་ཁྱད་ཞུགས།",
    "དེ་ནས་ཁོང་ཚོས་ལོ་གཅིག་གི་ཡུན་ཚད་ནི་ཉི་མ་༣༦༥དང་ཉིན་ཞག་གཅིག་གི་བཞི་ཆ་གཅིག་ལ་ཉེ་བ་ཡོད་པ་རྟོགས་སོ།",
    "རྒྱལ་པོ་ཏོ་ལོ་མི་ཨར་ཇི་ཏི་ཞེས་པས་ལོ་རེར་ཉིན་ཞག་༣༦༥རེ་རྩི་བའི་ཁར་ལོ་བཞི་རེའི་ནང་ཉིན་བཤོལ་རེ་བཏོན་ཏེ་བཤོལ་ལོའི་ལོ་མཇུག་གི་ཉི་མ་ལྔའི་ཁར་བསྣན་ནས་ཉི་མ་དྲུག་ཏུ་བཟོ་དགོས་པའི་བཀའ་ཕབ་ཀྱང་།",
    "གཞན་ཡང་ཚེས་ཟླ་གཅིག་གི་ཡུན་ཚད་ནི་ཉིན་ཞག་༢༩༥༣༧ལྟར་བརྩི་བ་དང་།",
    "ཞག་པོ་གཅིག་ལ་ཉིན་མཚན་གཉིས་སུ་ཕྱེ་སྟེ་རེ་རེར་དུས་བཅུ་གཉིས་སུ་དབྱེ་ནས་བརྩི་སྲོལ་ཡོད།",
    "འཛམ་གླིང་ཐོག་གི་རྒྱལ་ཁབ་དང་མི་རིགས་སོ་སོས་བཀོལ་སྤྱོད་བྱེད་པའི་ལོ་ཐོ་དང་དེའི་རྒྱབ་རྟེན་གྱི་རིགས་པའི་གཞུང་ལུགས་ལོ་རྩིས་བཅས་ལ་འདྲ་མིན་སྣ་ཚོགས་ཡོད་མོད།",
    "དང་པོ་ཉིན་ཞག་མའི་ལོ་རྩིས་ཞེས་པ་ནི་གཙོ་བོ་ཉི་མའི་འགྲོས་ལ་བརྟེན་ནས་བྱུང་བ་ཡིན་ཏེ་ཉི་མ་སྣང་འགྲོས་ཀྱིས་དཔྱིད་ཚུགས་པའི་ས་ནས་བརྩམས་ཏེ་བསྐོར་བ་འཁོར་ནས་སླར་ཡང་དཔྱིད་ཚུགས་པའི་ས་ལ་སླེབས་པའི་ཉི་ལྡོག་གི་ལོ་གཅིག་དེ་བརྩི་གཞིར་བྱས་ནས་ལོ་ཟླ་ཚེས་གསུམ་བརྩི་བའི་ལོ་རྩིས་ཞིག་ཡིན་པ་དང་།",
    "དེས་ན་ཉི་ལྡོག་གི་ལོ་གཅིག་གི་ཚད་ནི་ཉིན་ཞག་༣༦༥༢༤༢༢ཡིན་ཞར་བྱུང་ཉེར་མཁོའི་རིགས།",
    "པས་ལོ་གཅིག་གི་ཉིན་ཞག་གྲངས་ནི་མཐའ་གཅིག་ཏུ་ཉིན་ཞག་༣༦༥དང་༣༦༦གང་རུང་བྱས་ན་འོས་འཚམས་མིན།",
    "དེར་བརྟེན་རྒྱུན་ལྡན་གྱི་ལོ་ལ་ཉིན་ཞག་༣༦༥རེ་བྱས་ནས་བརྩི་བ་དང་།",
    "དུས་ངེས་ཅན་ཞིག་གི་ནང་དུ་ཉིན་བཤོལ་རེ་བཏོན་ནས་ཉིན་ཞག་༣༦༦བྱས་ནས་བརྩི་དགོས་པ་ཡིན་ནོ།",
    "གཉིས་པ་ཚེས་ཞག་མའི་ལོ་རྩིས་ཞེས་པ་ནི་གོང་གི་དེ་ལས་བཟློག་སྟེ་ཟླ་བའི་འཕེལ་འགྲིབ་ཁོ་ན་ལ་བརྟེན་ནས་བྱུང་བ་ཞིག་ཡིན་ཞིང་ཉི་མའི་འགྲོས་ལ་འབྲེལ་བ་ཅི་ཡང་མེད།",
    "དེ་ནི་གཙོ་བོ་ཚེས་ཟླ་གཅིག་གི་ཚད་ཉིན་ཞག་༢༩༥༣༥༩དེ་བརྩི་གཞིར་བཟུང་ནས་ལོ་ཟླ་ཞག་གསུམ་རྩི་བྱེད་ཀྱི་རྩིས་ལུགས་ཤིག་ཡིན་ནོ།",
    "དེས་ན་ཉི་མ་ལྡོག་པའི་ལོ་གཅིག་གི་ཚད་ནི་ཉིན་ཞག་༣༦༥༢༤༢༢ཡིན་པ་དང་།",
    "ཚེས་ཟླ་གཅིག་གི་ཚད་ནི་ཉིན་ཞག་༢༩༥༣༥༩ཡིན་པའི་རྐྱེན་གྱིས་དེ་གཉིས་ལྷུ་སྒྲིག་ཐབས་བྱེད་དགོས།",
    "འོ་ན་སྤྱི་ལོ་ཞེས་པའི་རྩི་སྟངས་དེ་གནའ་སྔ་མོའི་དུས་སུ་ད་ལྟ་ང་ཚོས་བེད་སྤྱོད་བྱེད་བཞིན་པའི་བཟོ་དབྱིབས་འདི་ལྟ་བུ་ཞིག་ཡིན་ནམ་ཞེ་ན་མིན་ཏེ།",
    "སྤྱི་ལོའི་རྩི་སྟངས་འདི་དང་ཐོག་རོའོ་མ་ཞེས་པའི་གནའ་དུས་ཀྱི་རྒྱལ་ཁབ་ཆེན་པོ་ཞིག་ཏུ་བྱུང་བ་རེད།",
    "འོན་ཀྱང་སྐབས་དེའི་མི་ཚོས་ཨང་ཀི་ཆ་གྲངས་ཅན་བཀྲ་མི་ཤིས་པར་བརྩི་བའི་རྣམ་རྟོག་གིས་ཟླ་བ་རེའི་ཉིན་གྲངས་ནི་ཕལ་ཆེ་བ་ཡ་གྲངས་ཡིན་པ་གཤམ་གསལ་རེའུ་མིག་ནང་བཀོད་ལྟར་རོ།",
    "ཁོང་ཚོས་ལོ་བཞི་རེའི་ནང་དུ་ཞེས་པ་ཁ་སྣོན་གྱི་ཟླ་བ་གཉིས་བསྣོན་རྒྱུ་བྱས།",
    "དེའི་སྣོན་སྟངས་དང་ཟླ་བའི་ཉིན་ཞག་གི་གྲངས་ནི་ལོ་གཉིས་པའི་ལོ་མཇུག་ཏུ་ཉིན་༢ ༢ ཅན་གྱི་ཟླ་བ་ཞིག་ཁ་སྣོན་རྒྱག་པ་དང་།",
    "ལུགས་ལ་ལོ་བཞི་རེའི་ནང་ལོ་སོ་སོའི་རིང་ཚད་ནི་འདི་ལྟར།",
    "ཉིན་གྲངས་༣༥༥ཉིན་གྲངས་༢༣སྣོན་ཟླ་ཉིན་གྲངས་༣༧༨ ༣༥༥༤༢༢ ༢༣༤༣༦༦༢༥དེས་ན་ལུགས་འདིའི་ལོ་གཅིག་གི་ཆ་སྙོམས་རིང་ཚད་དངོས་ནི་ཉིན་གྲངས་༣༦༦༢༥ཡིན།",
    "ཉི་ལྡོག་གི་ལོ་གཅིག་གི་རིང་ཚད་དངོས་ཉིན་ཞག་༣༦༥༢༤༢༢དང་བསྡུར་ན་མང་སྐྱོན་ཡོད།",
    "དེ་ལྟར་བརྩིས་པས་ལོ་སུམ་ཅུ་ལྷག་ཙམ་སོང་ཚེ་དུས་ཚིགས་སོགས་ཟླ་བ་གཅིག་གིས་ཁྱད་ཞུགས་འགྲོ་བ་དང་།",
    "ལོ་མང་སོང་ཚེ་མང་སྐྱོན་ཆེ་རུ་གྱུར་ཏེ་དུས་ཚིགས་ལ་ནོར་འཁྲུལ་འབྱུང་ངེས་ཡིན།",
    "དེར་བརྟེན་ཁོང་གིས་ཨེ་ཇིའི་གནམ་རིག་པ་སོ་སེ་ཇན་ནི་སི་སོགས་གདན་ཞུས་ཀྱིས་སྤྱི་ལོའི་སྔོན་གྱི་༤༦ལོར་ལོ་རྩིས་སྒྱུར་བཅོས་དང་གཏན་འཁེལ་གསར་པ་བྱས་པའི་ནང་དོན་གཙོ་བོ་ནི་འདི་ལྟར།",
    "༡ ལོ་གཅིག་གི་ཆ་སྙོམས་ཀྱི་རིང་ཚད་དངོས་ནི་ཉིན་ཞག་༣༦༥༢༥ཡིན་པར་གཏན་འཁེལ་བྱས།",
    "ལོ་བཞི་རེའི་ནང་དུ་བཤོལ་བའི་ལོ་གཅིག་རེ་བརྩི་བ་དང་།",
    "བཤོལ་བའི་ལོ་ལ་ཉིན་ཞག་༣༦༦གི་ཚད་དང་རྒྱུན་ལྡན་གྱི་ལོ་ལ་ཉིན་ཞག་༣༦༥ཡི་ཚད་བྱེད་རྒྱུ་གཏན་འཁེལ་བྱས།",
    "༢ ཞེས་པའི་ཟླ་བ་དེ་ལོ་གཅིག་གི་ལོ་མགོ་སྟེ་ཟླ་བ་དང་པོར་བཞག་སྒྱུར་བཅོས་མ་བྱས་གོང་གི་ཟླ་བ་དང་པོ་སྟེ་ཞེས་པའི་ཟླ་བ་དེ་ཟླ་བ་གསུམ་པར་ཆགས།",
    "ཟླ་བ་གཉིས་པའི་ཉིན་ཞག་གི་གྲངས་ནི་རྒྱུན་ལྡན་གྱི་ལོ་ལ་ཉིན་ཞག་༢༩དང་བཤོལ་བའི་ལོ་ལ་ཉིན་ཞག་༣  རེ་བྱེད་རྒྱུའི་གཏན་འཁེལ་བྱས།",
    "ལོ་དེའི་ཉིན་ཞག་གྲངས་༣༥༥དང་ལོ་མཇུག་གི་ཉིན་ཞག་༢ ༣ ཅན་གྱི་ཟླ་སྣོན་དང་བསྡོམས་པས་ཉིན་ཞག་༣༧༨ཀྱི་ཁར།",
    "དེའི་ལུགས་ཀྱི་ཟླ་བ་སོ་སོའི་མིང་དང་ཉིན་ཞག་གི་གྲངས་ནི་གཤམ་གསལ་རེའུ་མིག་ལྟར་རོ།",
    "འཇུ་ལེའི་ལོ་རྩིས་ལུགས་ཀྱི་ཉིན་བཤོལ་འདོན་ཚུལ་དངོས་ནི་ལོ་གསུམ་རེའི་རྗེས་ལ་ཉིན་བཤོལ་རེ་འདོན་པ་སྟེ་ལོ་བཞི་རེའི་ནང་དུ་ཉིན་བཤོལ་གཅིག་འདོན་པའི་གཏན་འཁེལ་བཟོས་ཡོད་པར།",
    "རྗེས་འཛིན་ལག་ལེན་བསྟར་མཁན་རྣམས་གྱིས་གོ་བ་ལེན་སྟངས་ནོར་ཏེ་ལོ་གསུམ་རེའི་ནང་དུ་ཉིན་བཤོལ་རེ་བཏོན།",
    "ཨང་དང་པོ་ནི་ཁོང་གི་གཅེན་མོའི་བུ་ཨོ་ཏེ་ཝི་འབོད་པ་དེ་བཞག་ཡོད།",
    "༩ལོ་བཅས་ཁྱོན་བསྡོམས་ལོ་བཅུ་ནི་བཤོལ་བའི་ལོ་ཡིན།",
    "༩ལོ་བཅས་ཁྱོན་བསྡོམས་བཤོལ་བའི་ལོ་ནི་བཅུ་གསུམ་བྱུང་།",
    "བཤོལ་རེ་འདོན་རྒྱུ་བྱས།",
    "དེ་ལྟར་ཟླ་བའི་ཆ་གྲངས་ཡ་གྲངས་ཀྱི་གོ་རིམ་རྣམས་དཀྲུགས་པ་ལ་དགོས་མཁོ་མེད་པར་མ་ཟད་ཡིད་ལ་འཛིན་མི་བདེ་བ་སོགས་ཀྱི་སྐྱོན་ཡོད་མོད་རྒྱུན་འབྱམས་སུ་གྱུར་སྟེ་ལོ་ཉིས་སྟོང་ཕྱིན་རྗེས་ཀྱི་ད་ལྟའི་དུས་སུའང་དེ་ལྟར་བཀོལ་སྤྱོད་བྱེད་པའི་གནས་སུ་མཆིས་སོ།",
    "དེ་ལྟར་སྒྱུར་བཅོས་བྱས་རྗེས་ཀྱི་འཇུ་ལེའི་ལོ་རྩིས་ལུགས་ཀྱི་གནས་བབས་ནི་གཤམ་གསལ་རེའུ་མིག་ནང་དུ་བཀོད་པ་ལྟར་རོ།",
    "གོང་དུ་བརྗོད་པ་ལྟར་གྱི་འཇུ་ལེའི་ལོ་རྩིས་ལུགས་དེའི་ལོ་གཅིག་གི་ཆ་སྙོམས་རིང་ཚད་ནི་ཉིན་ཞག་༣༦༥༢༥ཡིན།",
    "འོན་ཀྱང་ཉི་ལྡོག་གི་ལོ་གཅིག་གི་རིང་ཚད་དངོས་ནི་ཉིན་ཞག་༣༦༥༢ ༤༢ ༢ ཡིན་པས་ལོ་རེར་ཉིན་ཞག་༧༨ སྟེ་སྐར་མ་༡ ༡དང་སྐར་ཆ་༡༤ཙམ་གྱི་མང་སྐྱོན་འབྱུང་།",
    "མང་སྐྱོན་དེ་བསགས་ན་ལོ་༡༢༨རེའི་ནང་ཉིན་ཞག་གཅིག་གི་མང་སྐྱོན་འབྱུང་ཞིང་དཔྱིད་མཉམ་གྱི་ཉིན་མོ་དེ་ཉིན་ཞག་གཅིག་གིས་འཕྱི་འགྲོ།",
    "སྐབས་དེར་འཇུ་ལེའི་རྩིས་ལུགས་དེ་ཐུན་མོང་དུ་བཀོལ་སྤྱོད་བྱ་རྒྱུར་གྲོས་མཐུན་བྱུང་བ་ནས་བཟུང་ཏེ་སྤྱི་ལོའི་དུས་རབས་བཅུ་དྲུག་པའི་མཇུག་ལ་སླེབས་དུས་ལོ་ཆིག་སྟོང་ཉིས་བརྒྱ་ཙམ་སོང་ཟིན་པ་དང་།",
    "དུས་ཡུན་དེ་ཙམ་གྱི་རིང་ལ་སྐྱོན་སེལ་མ་བྱས་པས་སྐྱོན་ཕྲ་མོ་རིམ་གྱིས་བསགས་པས་ཉིན་ཞག་བཅུ་ཙམ་གྱི་མང་སྐྱོན་བྱུང་བས་དཔྱིད་ཉིན་མཚན་མཉམ་པའི་ཉིན་མོ་དེ་ལོ་ཐོའི་ནང་བཀོད་པའི་དུས་ཚིགས་ལས་ཉིན་བཅུ་ཙམ་གྱི་སྔོན་ལ་བྱུང་བས་ཕྱི་རོལ་ཡུལ་གྱི་གནས་བབས་དང་མི་མཐུན་པ་བྱུང་།",
    "༡༥༧༦ལོར་བཏོན་པའི་ལོ་བཞི་བརྒྱ་རེའི་ནང་བཤོལ་བའི་ལོ་གསུམ་ཉུང་དུ་གཏོང་བའི་འཆར་བཀོད་དེ་ལག་ལེན་བསྟར་རྒྱུ་གཏན་འཁེལ་བྱུང་སྟེ་སྤྱི་ལོ་༡༥༨༢ལོའི་ཟླ་༣ཚེས་༡ཉིན་ལོ་རྩིས་སྒྱུར་བཅོས་བྱེད་རྒྱུའི་བཀའ་ཕབ་ནས་བསྒྱུར་བཅོས་མཛད།",
    "སྐབས་དེར་ཉིན་ཞག་བཅུ་མཆོངས་ཀྱང་རེས་གཟའ་རྒྱུན་ལྡན་ལྟར་དེད་པས་ཟླ་༡ཚེས་༤ཉིན་རེས་གཟའ་ཕུར་བུ་ཡིན་པདང་དེའི་ཕྱི་ཉིན་ཏེ་ཟླ་༡ ཚེས་༡༥ཉིན་ནི་རེས་གཟའ་པ་སངས་ཡིན།",
    "༢ལོ་སོགས་ནི་འཇུ་ལེའི་ལོ་རྩིས་ལུགས་སུ་བཤོལ་བའི་ལོ་ཤ་སྟག་ཡིན་མོད།",
    "དེ་ལྟར་བརྩིས་པས་སྤྱི་ལོ་༡༦ལོ་ནས་སྤྱི་ལོ་༢ ལོ་བར་གྱི་ལོ་བཞི་བརྒྱ་ལ་མཚོན་ན་འཇུ་ལེའི་ལུགས་ལྟར་བརྩིས་པས་རྒྱུན་ལྡན་གྱི་ལོ་༣དང་བཤོལ་བའི་ལོ་༡འབྱུང་མོད།",
    "དོན་གྱིས་ལོ་བཞི་བརྒྱ་རེའི་ནང་གི་བཤོལ་བའི་ལོ་གསུམ་མེད་པར་བཟོས་པས་ཕྱི་མ་ནི་སྔ་མ་ལས་ཞིབ་ཆ་ཆེ་བ་ཡིན་ནོ།",
    "དེ་བཞིན་བརྩིས་པས་ཀོ་རིན་ལུགས་ཀྱི་ལོ་གཅིག་གི་ཆ་སྙོམས་རིང་ཚད་ནི་འདི་ལྟར།",
    "ཉིན་ཞག་༣༦༥༣༣༣༦༦༩༧༤ ཉིན་ཞག་༣༦༥༢༤༢༥ དེ་ལྟར་བརྩིས་པས་ལོ་གཅིག་གི་རིང་ཚད་ནི་ཉིན་ཞག་༣༦༥དང་ཆུ་ཚོད་༥ སྐར་མ་༤༩ སྐར་ཆ་༡༢ བཅས་ཡིན།",
    "ཉི་མ་ལྡོག་པའི་ལོ་གཅིག་གི་རིང་ཚད་དངོས་དང་བསྡུར་ན་ད་དུང་ཉིན་ཞག་༣སྟེ་སྐར་ཆ་༢༦ཙམ་གྱི་མང་སྐྱོན་ཡོད་ཀྱང་།",
    "དུས་ཕྱིས་བར་དུ་རྩིས་ལུགས་རྙིང་པ་འཇུ་ལེའི་ལོ་རྩིས་རང་སྤྱད་པ་རེད།",
    "དབྱིན་ཇི་ལ་མཚོན་ན་སྤྱི་ལོ་༡༧༥༢ལོར་སླེབ་དུས་གཞི་ནས་ཀོ་རིན་རྩིས་ལུགས་དེ་བེད་སྤྱོད་བྱེད་མགོ་བརྩམས་པ་རེད།",
    "སུ་ལན་དེང་གི་ར་ཞི་ཡ་རྒྱལ་ཁབ་ལ་མཚོན་ན་༡༩ ༡༧ལོའི་ཟླ་བ་བཅུ་པའི་གསར་བརྗེའི་བར་དུ་རྩིས་ལུགས་རྙིང་པ་ཁོ་ན་བེད་སྤྱོད་བྱས།",
    "བཅུ་པའི་གསར་བརྗེའི་རྒྱལ་ཁ་ཐོབ་པའི་ཉིན་མོ་དེ་ལུགས་རྙིང་འཇུ་ལེའི་ལོ་རྩིས་ཀྱི་ཟླ་བ་༡ཚེས་༢༥ལ་འཁེལ་བ་དང་།",
    "ལུགས་གསར་ཀོ་རིན་ལོ་རྩིས་ཀྱི་ཟླ་བ་༡ ༡ཚེས་༧ཉིན་ལ་འཁེལ་འདུག་པས་དོན་གྱིས་ཟླ་བ་བཅུ་གཅིག་པའི་གསར་བརྗེ་ཐོབ་མོད་སྐབས་དེར་ད་དུང་རྩིས་ལུགས་རྙིང་པ་སྤྱོད་པའི་དུས་ཡིན་པས་ཡོངས་གྲགས་སུ་བཅུ་པའི་གསར་བརྗེ་ཟེར་བ་ཡིན།",
    "འཛམ་གླིང་སྟེང་གི་རྒྱལ་ཁབ་ཁག་ཅིག་གིས་སྔ་གཞུག་ཏུ་སྤྱི་ལོའི་ལོ་རྩིས་ཐོག་མར་བེད་སྤྱོད་བྱས་པའི་ལོ་ཚིགས་སོགས་ནི་གཤམ་གསལ་རེའུ་མིག་ནང་བཀོད་ལྟར་རོ།",
    "། རེས་གཟའི་བསྐལ་འཁོར་རེའུ་མིག་བཞུགས་སོ།",
    "རེའུ་མིག་འདི་ནི་སྤྱི་ལོའི་ལོ་ཟླ་ཚེས་གསུམ་ལས་རེས་གཟའ་གང་འཁེལ་མྱུར་རྩིས་རྒྱག་བྱེད་ཡིན་པ་དང་ཚུགས་མཚམས་ནི་སྤྱི་ལོ་༡༥ནས་སྤྱི་ལོ་༢༢༩༩བར་ཡིན།",
    "དཔེར་ན་སྤྱི་ལོ་༡༩༩༣ལོའི་ཟླ་བ་༤ཚེས་༡༥ཉིན་གྱི་རེས་གཟའ་གང་འཁེལ་བརྩི་ན།",
    "གཞལ་བར་མ་ནུས་བདག་བློ་བྱེའུ་ཆུང་གི།",
    "ཚེ་རིང་མཚོ་མོ།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གི་བོད་ཡིག་རྩོམ་སྒྲིག་ཁང་།",
    "སྒོར་རིག་པའི་བང་མཛོད་སྒོ་མོ་ཆེ།",
    "གཅིག་། ཐང་རྒྱལ་གསང་སྤྱོད་མཁའ་འགྲོའི་སྙན་བརྒྱུད་ཀྱི་ཚོགས་ལས་ཌཱ་ཀི་དགྱེས་པའི་རོལ་མོ་ཅེས་བྱ་བ་བཞུགས་སོ།",
    "ཞབས་མཐིལ་ཉི་འོད་དམར་མོར་གུས་པས་བཏུད།",
    "དེའི་མདུན་ཕག་མོའི་གཏོར་མ་སྟོད་ཟུར་གསུམ་སྨད་ཟླུམ་པོ་པད་འདབ་འཐེབ་རིལ་གྱིས་བརྒྱན་པ་ལ་སྨུག་རྩི་བྱུགས་པ་ཅན།",
    "ཡུམ་ཆེན་མོར་དཀར་ཟླུམ་པད་འདབ་ཅན།",
    "ཉེར་སྤྱོད་གཡོན་བསྐོར་དང་སྦྲེང་ཚར་ཉེ་ལོགས་སུ་བགེགས་གཏོར་དང་ཚོགས་ཀྱི་ཡོ་བྱད་རྣམས་འདུ་བྱ།",
    "རང་གི་མདུན་དུ་ནང་མཆོད་རྡོར་དྲིལ་ཅང་ཏེའུ་རྐང་གླིང་རྣམས་བཤམས་ནས་བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "བགེགས་གཏོར་ལ་ཆུ་ཆང་གིས་བྲན་ལ།",
    "རང་རང་སྡོད་པའི་ས་དེར་སོང་།",
    "ང་ནི་རྡོ་རྗེ་ཕག་མོ་ནི།",
    "ཁྲོས་མ་ནག་མོ་ཕོ་ཉ་བཅས།",
    "ཨོཾ་ཨཱ་བཛྲ་པུཥྤ་ཧཱུཾ་ནས་ཤབྡ་ཧཱུྃ་གི་བར།",
    "སརྦ་བུདྡྷ་ཀྵེ་ཊ་པྲ་ཙ་ལི་ནི།",
    "ལན་གསུམ་བརྗོད་ཅིང་རོལ་མོས་བྱིན་དབབ་པར་བྱའོ།",
    "བདག་དང་བདག་གི་ཚེ་འདིའི་ཕ་མ་ལ་སོགས་ཏེ་བདག་ལ་ཚན་བློ་གཏད་ཅིང་འབྲེལ་ཐོབ་པའི་དམིགས་ཡུལ་གཤིན་གསོན་རྣམས་དང་།",
    "ཡི་དམ་རྡོ་རྗེ་ཕག་མོའི་ཞབས་ལ་༴",
    "བདགགི་འགལ་རྐྱེན་ལམ་དུ་ལོངས་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཚེ་འདི་ཉིད་ལ་འོད་གསལ་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་ཐོབ་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "རྡོ་རྗེ་བཙུན་མོའི་གསང་བ་མཆོག།",
    "མོས་གུས་དམ་ཚིག་རྟག་ཏུ་བཟུང་།",
    "བྷ་ག་དང་ནུ་འབུར་རབ་ཏུ་རྒྱས་པའི་ལང་ཚོས་སྒེག་པ།",
    "སྟེང་གི་ཕག་ཞལ་སྔོན་མོ་རབ་ཏུ་ཁྲོ་ཞིང་མཆེ་བ་གཙིགས་པ།",
    "ཕྱག་གཡས་གྲི་གུག་ནམ་མཁར་འཕྱར་ཞིང་གཡོན་ཐོད་པ་ཁྲག་གིས་གང་བ་ཐུགས་ཀར་འཛིན་པ།",
    "ཕག་མོ་ལྷ་ལྔའི་ཡེ་ཤེས་པ་དམ་ཚིག་སེམས་དཔའ་ལ་ཛ་ཧཱུྃ་བཾ་ཧོ",
    "ཨོཾ་ཨཱ་ཧཱུྃ་བྃ་ཧ་རི་ནི་ས་ར་ཙ་ཧྲི་ཡ་། བཛྲ་སརྦ་བུདྡྷ་ཌཱ་ཀི་ནཱི་སིདྡྷི་ཧཱུཾ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་གིས་ནང་མཆོད་ཕུལ་དཔལ་ལྡན་རྡོ་རྗེ་མཁའ་འགྲོ་མ།",
    "རྗེ་བཙུན་རྡོ་རྗེ་ཕག་མོས་བདག་ལ་མཆོག་དང་ཐུན་མོང་གི་དངོས་གྲུབ་མ་ལུས་པ་སྩལ་དུ་གསོལ།",
    "གཉིས་པ་མདུན་བསྐྱེད་ཚོགས་ཞིང་སྒྲུབ་པ་ནི་རང་ཉིད་གཙོ་མོའི་ང་རྒྱལ་གྱིས་ནང་མཆོད་གཏོར་ཞིང་།",
    "གོང་གི་དག་པ་གསུམ་གྱི་སྔགས་ཀྱིས་སྤྱངས།",
    "བྷ་ག་དང་ནུ་འབུར་རབ་ཏུ་རྒྱས་པའི་ལང་ཚོས་སྒེག་པ་རྩ་ཞལ་ཡིད་ཙམ་ཁྲོ་ལ་འཛུམ་པའི་མདངས་ཅན།",
    "གཡོན་ཐོད་པ་ཁྲག་གིས་གང་བ་ཐུགས་ཀར་འཛིན་པ།",
    "གཡོན་གྱི་གྲུ་མོའི་ངོས་ལ་ཁ་ཊཱཾ་བསྟེན་པ།",
    "དེའི་མདུན་དུ་གསང་བ་ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མ་ཁྲོས་མ་ནག་མོ་ཤིན་ཏུ་ཁྲོས་མའི་སྐུ་ཅན་ཞལ་གཅིག་ཕྱག་གཉིས་མ་སྐུ་སྐེམ་ཞིང་གཅེར་བུ་ཕྱག་རྒྱ་ལྔས་བརྒྱན་པ།",
    "གཡོན་བརྐྱང་པས་ཡབ་བདུད་ཕོ་མོ་བརྫིས་པ་མེ་དཔུང་སྔོ་ནག་འབར་བའི་ཀློང་དཀྱིལ་ན་བཞུགས་པ།",
    "ཞབས་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་གི་བཞུགས་ཤིང་དར་དཀར་གྱི་སླེ་བེར་གསོལ་བ།",
    "ཐབས་ཡབ་ཀྱི་ཁ་ཊཱཾ་བློ་གྲོས་བཀའ་འཆང་བ་ཞབས་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་གི་བཞུགས་པ།",
    "ཕྱག་གཡས་སེང་ལྡེང་གི་ཌཱ་མ་རུ་དྲག་ཏུ་འཁྲོལ་བ།",
    "སྤྱན་དབུས་མ་བར་སྣང་ལ་ཧྲིག་ཧྲིག་གཟིགས་པ།",
    "རྐང་གླིང་འབུད་ཅིང་ཚིལ་ཆེན་དང་གུ་གུལ་སྦྱར་བའི་སྤོས་བསྲེག།",
    "ཌཱ་མ་རུ་སོགས་རོལ་མོ་སྣ་ཚོགས་དཀྲོལ་ཞིང་དབྱངས་དང་བཅས།",
    "འཁོར་ཡང་དཀར་མོ་འབུམ་གྱིས་བསྐོར།",
    "འཁོར་ཡང་སེར་མོ་༴།",
    "འཁོར་ཡང་ལྗང་མོ་༴།",
    "འཁོར་ཡང་སྨུག་མོ་འབུམ་གྱིས་བསྐོར།",
    "མ་གང་ན་བཞུགས་ཀྱང་ཐུགས་རྗེས་གཟིགས།",
    "མི་རྐང་གི་གླིང་བུ་ཀྱུ་རུ་རུ།",
    "གཡོན་ན་དཔའ་མོ་། ཤིགས་སེ་ཤིག།",
    "བདག་མོས་པའི་བུ་ལ་བྱིན་གྱིས་རློབས།",
    "ཅེས་བརྗོད་ཅིང་སྤྱན་དྲངས་པས་སྟེང་གི་ནམ་མཁར་ཡེ་ཤེས་པ་བྱོན་པ་ལ།",
    "ཕག་མོ་ལྷ་ལྔའི་ཡེ་ཤེས་པ་རྟེན་དང་བརྟེན་པ་བཅས་པ་མདུན་གྱི་དཀྱིལ་འཁོར་ལ་ཛ་ཧཱུྃ་བཾ་ཧོ",
    "ཆུ་ལྷག་མ་ཡར་ལུད་པ་ལས་རྡོ་རྗེ་ཕག་མོ་ལ་མི་བསྐྱོད་པ།",
    "པདྨ་ཕག་མོ་ལ་འོད་དཔག་མེད།",
    "ལས་ཀྱི་ཕག་མོ་ལ་དོན་ཡོད་གྲུབ་པས་དབུར་བརྒྱན།",
    "མོས་སེམས་གཙང་མས་འཕགས་ནོར་བདུན་གྱི་མཆོད་སྤྲིན་སྤྲུལ།",
    "ཕཊ་ལ་ཟུང་བ་གཅིག་འབུད།",
    "གི་ཝཾ་ཙནྡན་གུར་གུམ་ལ་སོགས་པ།",
    "རེག་པས་བསིལ་བསྐྱེད་བྱུག་པ་ཇི་སྙེད་ཀུན།",
    "སོགས་ཀྱིས་རོལ་མོ་བྱ།"
  ]
}