    "གདམས་ངག་ཀྱང་རང་བདེ་མཆོག་ཡབ་ཡུམ།",
    "བྱང་བ་ལ་ཟུག་པ་དང་སྤྱི་བོ་ཙམ་ནས་སློག་འཐེན་དུས་མགོ་མཇུག་ལོག་པར་འོངས་ནས་སྔར་གྱི་སར་མ་ལོག་པར་འདུག་པའོ།",
    "འདུག་སྟངས་དང་།",
    "མཐར་འབེབས་དང་རང་ལུས་བཞིན་གྱི་སྙིགས་མ་འབོད།",
    "ལུས་རང་བབས་སུ་གཞག་དུས་གསུམ་གྱི་སྤྲོས་པ་བཅད།",
    "སྤྲོས་བཅས་ལ་རང་རང་ཕྱག་རྒྱ་བཅུ་གསུམ་དང་བཅས་ཏེ་བརྡ་དང་བརྡའི་ལན་གྱི་འདུས་ཏེ།",
    "དགོན་གནས་གཉན་པོར་འདུག་པ་ཐམས་ཅད་ཀྱི་དུས་ལྷ་འདྲེའི་གདུག་རྩུབ།",
    "ཕཊ་ཅེས་བརྗོད་པས་རྡོ་རྗེ་རྣལ་འབྱོར་མ་ནམ་མཁར་ཡལ་བར་བསམས་ཏེ་བདག་འཛིན་བློས་བཏང་ལ་འདུག་གོ།",
    "དཔེར་ན་སྐྱེས་བུ་ལྷ་ིན་ཨོ་ཚོམ་མེར་འདུག་བཞིན་པ་ལ་དགྲ་གཉེན་མཆོད་ིན་གྱིས་ཐ་དད་པར་མཐོང་བ་ལྟ་བུའོ།",
    "འཇུག་པ་རང་རང་སྐབས་ཀྱི་འབོད།",
    "དོན་གཅིག་ལ་རྣམ་འཕྲུལ་གྱིས་གཉིས་འདིར་འགོད་པ་ཡང་ལག་ན་རྡོ་རྗེ་དང་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་འདུག་ས་གཅིག་ཏུ་གྲལ་ལ་བ་ིགས་པ་ལྟ་བུའོ།",
    "འདི་དག་དུས་མིན་འཆི་བྱེད་པ།",
    "འདུག་ཕྱོགས་གོས་དང་ཕྱག་རྒྱ་བསམ།",
    "སྔགས་མང་རང་ལ་བཟློག་དེའི་ཕྱིར།",
    "འདུག་སྟངས་དུས།",
    "ཐོགས་པ་མེད་ཅིང་རང་བཞིན་སྟོང་པ།",
    "དིང་སང་རང་བཟོ་བགྱིས་དང་འཇུག་བདེའི་ངག།",
    "དཀྱིལ་འཁོར་གྱི་ས་ལ་མེ་ཏོག་གཅལ་དུ་བཀྲམ་པའི་དབུས་སུ་རང་གོས་དཀར་པོ་གྱོན་གཙུག་གཏོར་བཅིངས་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་ཏེ་ཤར་དུ་ཕྱོགས་པས་འདུག་ལ།",
