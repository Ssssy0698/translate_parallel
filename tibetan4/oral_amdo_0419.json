    "ཐེངས་དེའི་འཐབ་རྩོད་ལ་འབྲེལ་སྦྱོར་བྱས་པ་རེད།",
    "གལ་ཏེ་ཐག་གཅོད་ཐུབ་ན་མྱུར་བར་བསྒྲུབ་ཆོག་སོགས་ཟེར་བ་རེད།",
    "འདྲེ་ཤིག་གིས་ཡི་ལ་རྨུགས་ནས་ཤིར་འཇུག་པར་ངོ་རྒོལ་བྱེད་པ་དང་བཞི།",
    "གཅར་བརྡུངས་བྱས་ནས་མི་བསད་པ་ཟེར་བ་རེད་དམ།",
    "མི་གཅར་བརྡུངས་བྱས་ནས་གསོད་མི་ཆོག་པ་སྨོས་མ་དགོས་པ་རེད།",
    "ཚྭ་ཅུང་ཟད་མང་པོ་ཞིག་བྱིན་ནས་ཟོས་ན་ཡག་པོ་རེད།",
    "ཧན་ཅན་ཁུའེ་ལ་ཕྱི་ནང་གི་གནོན་ཤུགས་ཀྱིས་རྔམ་རྫིག་བཏང་བར་བརྟེན།",
    "རེ་བཞག་སྣ་ཚོགས་དེ་ཕྲལ་ཁས་བླངས་རུང་།",
    "ཁོ་པས་སླར་ཡང་ཕྱི་བསྣུར་བྱེད་ས་ཧ་ཅང་ཆེན་པོ་ཞིག་བཞག་པ་རེད།",
    "ང་རང་ལ་ཡང་བྱ་ཐབས་མེད་པ་རེད།",
    "ཁོ་བོས་མྱུར་མོར་གོང་རིམ་ལ་རེ་ཞུ་བྱེད་རྒྱུ་ཡིན།",
    "སེམས་ལ་ཆུ་འཁྱག་བླུགས་པ་ལྟར་འཁྱག་སོང་།",
    "ཧན་ཅན་ཁུའེ་སྒོ་ཕྱིར་ཐོན་མ་ཐག་མི་ཞིག་གིས་དབུགས་སྟོད་ལ་འཚང་བཞིན་པཤད་རྒྱུར།",
    "གཞན་སུ་ལ་ཡང་འདི་འདྲའི་སྟོབས་ཤུགས་ཆེན་པོ་ཡོད་ཀྱི་མ་རེད་བསམས་ནས།",
    "ཁྱོད་བཙོན་ལ་བཅུག་པ་ནས་བཟུང་།",
    "བཙོན་རས་ཁྱོད་ལ་མཐར་ཆགས་སུ་དམིགས་བསལ་གཟིགས་རྟོག་བྱས་ཡོད་པ་ཡིན།",
    "བློ་མཐུན་རུའོ་ཧྥེས་བདེན་དོན་རྣལ་མའི་ཚིག་གིས་ལན་འདེབས་རྒྱུར།",
    "རོགས་རམ་དང་ཐག་གཅོད་བྱེད་པའི་འགན་ཁུར་ཁྱོད་ལ་བབས་ཡོད་པ་རེད།",
    "ཡང་ན་བཙོན་རར་ཤི་སོང་ན།",
    "ཁྱོད་རང་གི་སེམས་ལ་ནོངས་འགྱོད་སྐྱེས་རྒྱུ་རེད་དམ་མ་རེད།",
    "ཁྱོད་ཀྱིས་ང་ལ་ཁ་བསྒོ་བྱེད་དགོས་དོན་མེད།",
    "ངས་ཁྱོད་ལ་ཁ་བསྒོ་བྱེད་རྒྱུ་ནི།",
    "ཕྱི་ལ་སོང་ན་ཡང་ཟིང་སློང་བྱེད་མཁན་ཞིག་ཡིན་གྱི་རེད།",
    "སྐད་མགོ་དེ་འདྲ་མཐོན་པོ་བྱས་ནས་གཞན་པ་དཀྲོགས་དགོས་དོན་ཡོད་པ་མ་རེད།",
    "ཁོ་ཚོ་གསོན་པོར་འདུག་གི་འཇུག་དགོས་ཀྱི་རེད།",
    "དེར་ཁ་གཡར་ནས་དཀྲུགས་སློང་བྱས་པ་རེད།",
    "བློ་མཐུན་རུའོ་ཧྥེའི་སྐད་ཆ་མཚམས་བཅད་པ་རེད།",
    "དཀྲུགས་སློང་ཞེས་བློ་མཐུན་རུའོ་ཧྥེ་ཤིང་ལེབ་ཚ་ཐབ་སྟེང་ནས་གོག་གེས་ལངས་ནས་སྒེའུ་ཁུང་གི་ལྕགས་དྲ་ལ་ལག་པ་གཉིས་དམ་པོར་འཇུས།",
    "ལྷོ་ནས་བྱང་གི་བར་ཤོར་མ་ཁྱུར་ལོང་བ་དང་བཀྲེས་ལྟོགས་ཀྱིས་ཤི་བའི་མི་ཁྱོད་ཚོས་བཟོས་པ་རེད་དམ།",
    "ད་དུང་ངས་དཀྲུགས་སློང་བྱས་པ་རེད།",
    "མིའི་མཚན་ཉིད་མི་ཚར་བར་བྱེད་པའི་ཉེས་སྤྱོད་རེ་རེ་བཞིན་བསྒྲུབས་པ་དེ་རྣམས་ཁྱོད་ཚོས་བྱས་པ་རེད་དམ།",
    "ད་དུང་ངས་དཀྲུགས་སློང་བྱས་པ་རེད།",
    "ཉི་མ་གཅིག་ཙམ་ལ་ཁྱོད་ཚོས་ངའི་སྲོག་མ་བཅད་ན།",
    "ཁྱོད་རང་གིས་ཤི་བ་དང་གསོན་པ་ལ་ཡག་པོ་ཞིག་བལྟས་འདུག་པ་རེད།",
    "མིའི་སེམས་དཀྲུགས་པའི་གུང་ཁྲན་ངག་འཆལ་རེད།",
    "ཚང་མས་སྐད་དམའ་མོས་རྒན་རུལ་མ་རུང་བ་དེ་ཕྱིར་ཟློག་པས།",
    "དོགས་ཟོན་ཇེ་མཐོར་འདེགས་པ་མ་གཏོགས་བག་མེད་བྱེད་མི་རུང་ཞེས་གདམས་པ་རེད།",
    "ནན་ཅིན་ནས་འོངས་པའི་མི་དྲག་ཆེན་པོ་དེ་སླེབས་སོང་།",
    "ཡིན་ན་ཡང་ཀྲུང་དབྱང་གིས་སྔོན་རྩིས་ཁ་སྣོན་མ་བྱིན་པས།",
    "ཁོང་རང་གིས་ལག་པ་བསྲིང་འདོད་ན་ཡང་ཕུ་རུང་ཐུང་བའི་དཔེ་ལྟར་རེད།",
    "བཟོ་ལྟ་ཤོར་བ་རེད།",
    "རང་དགར་མི་ལ་གཅར་བརྡུངས་བྱས་ནས་བསད་པ་དེ་ལ་ཡང་སྔོན་རྩིས་དགོས་པ་ཨེ་རེད།",
    "མི་དྲག་ཆེན་པོ་དབུགས་སྟོད་ལ་འཚང་བཞིན་ཐོན་སོང་བར།",
    "སྡུག་གྲོགས་ཚོ་དགའ་ནས་ཁ་མི་ཟུམ་པ་བྱུང་སྟེ་ད་ཐེངས་ཁྱི་རྒན་འཆའ་རེས་བྱེད་པ་འདི་ལྟད་མོ་ཆེ་བ་ལ།",
    "ཐར་ཐོར་དུ་ཡང་ཡང་འཐབ་རྩོད་བྱས་པ་དེ་དག་གི་ཁྲོད་དུ།",
    "འཐབ་རྩོད་བྱེད་པའི་སྤོབས་པ་ཡང་ཇེ་མཐོར་སོང་བས།",
    "ཚང་མས་ཐུན་མོང་དུ་འཐབ་རྩོད་ཀྱི་རྒྱལ་ཁ་ནི།",
    "ཏང་གི་སྙན་གྲགས་ཀྱང་མང་ཚོགས་ཀྱི་ཁྲོད་དུ་ཇེ་མཐོར་སོང་བ་རེད།",
    "མང་ཚོགས་ཀྱི་འཐབ་རྩོད་སྣང་བ་བརྟན་པོ་ཡོང་ཆེད་བློ་མཐུན་རུའོ་ཧྥེས།",
    "བཙོན་རའི་ང་རོ་འབྱིན་པའི་གླུ་ཞེས་བྱ་བ་ཞིག་མཛད་པ་དེ་མགྱོགས་པོར་བཙོན་རའི་ནང་ལ་ཁྱབ་འཕེལ་བྱུང་བ་རེད།",
    "དགྲ་ཟླས་བྱ་ཐབས་གདུག་རྩུབ་ཅན་སྤྱད་པ་རེད།",
    "དེ་ནི་ཁོ་ཚོ་བཙོན་མ་གཞན་པ་ལ་གུང་ཁྲན་ཏང་གི་ཤན་ཞུགས་ཐེབས་པར་སྐྲགས་པའི་སྟབས་ཀྱིས་རེད།",
    "བློ་མཐུན་རུའོ་ཧྥེ་ལ་ཅེ་རེ་ལྟ་བ་དང་།",
    "བཞིན་ལ་ཞེད་སྣང་གི་རྣམ་པ་ཤར་ཡོད།",
    "ང་ལ་མ་རེག་ངའི་ལུས་ལ་རེག་དུག་བྱུང་ཡོད་པ་ཡིན།",
    "སེམས་ལ་མི་འདི་འདྲ་ལ་རེག་དུག་འགོས་པ་ཅི་ཡིན་སྙམ་དུ་ཐེ་ཚོམ་སྐྱེས་པ་རེད།",
    "ཁོང་གིས་བརྩེ་གཟིགས་ཀྱིས།",
    "ཁྱོད་ཀྱི་མིང་ལ་ཅི་ཟེར།",
    "ད་དུང་ཉིན་རེར་ངས་ཁོ་ཚོར་ཞུ་འབུལ་བྱེད་དགོས་པ་རེད།",
    "ང་ལ་ལྟོ་བ་གང་བའི་མ་ཉེས་ཁ་གཡོགས་ཡོད་སྔ་མོ་ནས་ཁྱེད་ལ་སྡུག་ཡུས་ཤིག་ཞུ་འདོད་ཡོད་ན་ཡང་།",
    "ལོ་ངོ་སུམ་ཅུ་ལྷག་གི་སྐབས།",
    "ད་གཟོད་ཞིང་དབུལ་གྱི་བུ་མོ་ཞིག་དང་གཉེན་སྒྲིག་བྱས་པ་རེད།",
    "སླར་ལོག་ན་ཆུས་ལོ་ཏས་རྗེས་བསྙེགས་ནས་དེར་སླེབས་པ་རེད།",
    "ཉིན་གཅིག་ལིའུ་པོ་ཚོན་ཞིང་ཁར་ལས་ཀར་སོང་ཤུལ་དུ།",
    "རེག་དུག་གི་རྨ་ཚབས་ཆེན་ཡོད་སྟབས།",
    "ཁྱོད་ཀྱིས་ང་སོད་ལ་ཐོངས་ཞེས་སྡུག་སྨྲེ་བཏོན་པ་རེད།",
