    "དྲི་ཞིམ་རྣམས་ཀྱིས་ཁེངས་པར་གྱུར་པའི་ཁང་པ་ནང་ནས་སྙན་པའི་ཡིད་འོང་སྒྲ་འབྱུང་ཞིང་།",
    "བསྒྲགས་པར་གྱུར་ན་ངེས་པར་ཕྱུགས་བདག་དྲུང་དུ་གསུམ་འདུས་དབྱངས་སྙན་དོན་གྱི་ཚོགས་པ་འབྱུང་།",
    "མིག་གསུམ་པ་ཡིས་རབ་ཏུ་བརྒད་པ་ཕྱོགས་བཅུ་དག་ནས་གཅིག་ཏུ་སྤུངས་པར་གྱུར་པ་བཞིན།",
    "དེ་ནི་གཉིས་འཐུང་སོ་ནི་འཕྲལ་ལ་བཅད་པར་བྱས་པ་ལྟ་བུར་དཀར་ཞིང་མཛེས་པ་དེ།",
    "རོལ་སྒེག་གཡོ་བའི་མཛེས་མ་དེ་རྣམས་རྣ་བར་རྩུབ་པའི་སྒྲ་ཆེན་བསྒྲགས་བས་འཇིགས་པར་བྱ།",
    "མཆང་པར་གྱུར་ཅིང་རྣ་བའི་རྒྱན་གྱུར་བ་མཛེས་གསེར་གྱི་མེ་ཏོག་ལྷུང་བར་གྱུར་པ་དང་།",
    "ནུ་རྒྱས་མུ་ཏིག་དྲ་པ་མཚར་བར་གྱུར་ཅིང་དོ་ཤལ་སྲད་བུ་ཆད་པར་གྱུར་པ་ཡི།",
    "དྲ་མིག་རྣམས་ཀྱི་ནང་ནས་དུ་བཞུགས་པ་འཐོན་པ་རྣམས་ཀྱི་རྗེས་སུ་བྱེད་པ་བཞིན།",
    "གང་དུ་གནོད་སྦྱིན་བདག་པོའི་གྲོགས་བཟང་ལྷ་ཉིད་མངོན་སུམ་ཉིད་དུ་གནས་པ་ཤེས་བྱས་ནས།",
    "རོལ་སྒེག་གཡོ་བརྩོམ་པར་བྱེད་པ་ཉིད་ཀྱིས་དེ་ཡི་འབྲས་བུ་ངེས་པར་གྲུབ་པ་ཉིད།",
    "གདུང་བ་དང་བྲལ་ངང་བའི་ཚོགས་རྣམས་དག་ནི་གངྒཱའི་ཆུ་ལ་གནས་པར་བྱས་པའི་ཚེ།",
    "སྒོ་ཡི་མཐའ་དང་ཉེ་བ་དག་ན་དུང་དང་པདྨའི་གཟུགས་བྲིས་མཐོང་བར་བྱས་པ་ན།",
    "ད་ལྟ་བདག་དང་བྲལ་བར་གྱུར་པས་ངེས་པར་མཛེས་པ་དམན་པ་ཉིད་དུ་གནས་པར་ངེས།",
    "དགའ་མ་དེ་ནི་ངེས་པར་མཆི་མ་མང་པོ་བབས་ལས་མིག་འཕུར་ཆེ་བ་དག་ཏུ་གྱུར།",
    "སྟེང་འོག་ཆུ་ཡི་པགས་པ་དག་ནི་ཤུགས་རིང་ཤིན་ཏུ་དྲོ་བའི་དབུགས་ནི་དུ་མ་བྱས།",
    "གདོང་ནི་ལེགས་པར་བཀོད་ལ་ལེན་བུ་འཕྱང་བས་བསྒྲིབས་པས་མཐའ་དག་གསལ་བ་མིན་པ་ནི།",
    "གཏོར་མ་བྱེད་པའང་བྲལ་བས་བཏུད་པར་གྱུར་པ་བདག་འདྲ་ཡིད་ཀྱིས་རྟོགས་བྱ་འདྲི་བའམ།",
    "མིག་ཆུས་བརླན་པའི་རྒྱུད་མངས་ཅུང་ཟད་ཕྱི་བར་བྱས་ནས་ཀྱང་ནི་དེ་ནི་འོང་བར་འགྱུར།",
    "ས་ལ་རྣམ་པར་འགོད་ཅིང་སྒོ་ཡི་ནང་དུ་གངས་ཀྱི་མེ་ཏོག་རྣམས་ནི་སྒྱུར་བར་བྱེད།",
    "བདག་ཅན་ནམ་ནི་ཕྲད་པར་འགྱུར་རམ་སྙམ་པ་སྙིད་ལ་སེམས་པའི་རྩོམ་པ་མང་པོ་བྱེད།",
    "བྲལ་བས་ལྷག་པར་གདུངས་པས་ས་ཡི་གཞིལ་གཞོགས་གཅིག་བརྟེན་ཏེ་ཉལ་བར་གྱུར་པ་ནི།",
    "དགའ་མ་དེ་ནི་འདྲེན་བྱེད་མཆི་མ་དང་བཅས་ཤིན་ཏུ་གདུངས་པ་མཐོང་བས་འགོག་པར་བྱེད།",
    "མིག་ནི་མཆི་མ་མང་པོ་རྣམས་ཀྱིས་གདུངས་ལ་རྫི་མ་རྣམས་ཀྱིས་བཀབ་པར་བྱས་ནས་ནི།",
    "ལུས་ཕྲ་མ་ལ་གཅིག་ནི་བལྟ་ཚེ་ཀུན་གྱི་རྨད་བྱུང་བལྟ་བས་འཇུག་པར་འགྱུར་བ་ཉིད།",
    "དེ་ཕྱིར་དེ་ལྟར་གྱུར་པ་རྣམས་ནི་དང་པོར་བྲལ་ལ་དེ་ནི་བདག་ལ་སེམས་པར་བྱེད།",
    "ཉེས་པར་བྱེད་པ་ནམ་ཡང་མེད་པར་གྱུར་ལས་སྨིན་མའི་རྣམ་འགྱུར་བརྗེད་པར་འགྱུར་ན་ཡང་།",
    "གང་ཞིག་ཉ་ཡིས་བསྐྱོད་ལས་ཆུ་སྐྱེས་གཡོ་བའི་དཔལ་ནི་འཛིན་པར་བྱེད་པ་ཉིད་དང་མཚུངས།",
    "ཡུན་རིང་ཉིད་ནས་འདོར་བར་བྱས་པར་གྱུར་ཅིང་ལོངས་སྤྱོད་ཉིད་ཀྱིས་རྫོགས་པའི་མཐའ་རུ་ནི།",
    "དེ་ཡི་ཆུ་ཤིང་གསར་པའི་སྡོང་པོ་བརླ་ཡང་གཡོན་པ་གཡོ་བ་ཉིད་ནི་ཐོབ་པར་གྱུར།",
    "དེ་ཡི་བདག་པོར་གྱུར་བ་བདག་ལ་དཀའ་ཚེགས་ཆེན་པོས་ཐོབ་པར་འགྱུར་བའི་རྨི་ལམ་ནི།",
    "ཀྭ་ཡེ་གྲོགས་བཟང་དེ་ནས་ལེགས་པར་གནས་ལ་གཞན་ཡང་ཉན་འདོད་སྒྲ་ལྡན་མ་རྣམས་ནི།",
    "ཁོ་བོས་དམ་དུ་འཁྱུད་པར་བྱ་བའི་ཆེད་དུ་ནམ་མཁའ་དག་ལ་ལག་ཡུག་བྱ་བ་ནི།",
    "ས་ལ་གནས་པའི་ནགས་ཀྱི་ལྷ་རྣམས་ཀྱིས་ནི་ངེས་པར་མ་མཐོང་མ་ཡིན་མང་པོ་རུ།",
    "དེ་ཝ་དཱ་རུའི་ལྗོན་པ་རྣམས་ཀྱི་ཡལ་གའི་འདབ་མ་རྣམས་ནི་འཕྲལ་དུ་བཅད་བྱས་ནས།",
    "ཉིན་པར་ཡང་ནི་གནས་སྐབས་ཀུན་དུ་ཅུང་ཟད་གདུང་བའང་ཇི་ལྟར་གྱུར་པ་ཡིན།",
    "སྟོན་ཀའི་ཟླ་བ་རྫོགས་པའི་མཚན་མ་རྣམས་ལ་འདོད་པའི་ལོངས་སྤྱོད་དེ་དག་ལྡན་པར་འགྱུར།",
    "བདག་ནི་ཕྲལ་ལ་རབ་ཏུ་སད་པར་གྱུར་ནས་ཅི་ཡང་དུ་བར་བྱས་པར་གྱུར་པ་ན།",
    "ཚོགས་འདི་བྱམས་པར་གྱུར་པའམ་རྗེས་སུ་རབ་ཏུ་བརྩེ་བའི་བློས་ནི་འདི་རྣམས་ཀུན་བྱས་ནས།",
    "གང་ཞིག་ཐུགས་དགོངས་རྣམ་པར་དག་པ་ཡིས།",
    "མས་ཛ་ག་དག་པའི་སྣང་བར་ཤེས་པར་བྱ།",
    "མ་བྷ་ས་གས་བསྐྱེད་པ་མྱོས་མར་ཤེས་པར་བྱ།",
    "ན་ན་ར་ར་གྷཊི་ཏཱ་ཡིན་། ན་དང་བྷ་དང་བྷ་ར་དལ་མྱུར་ཡིན་པར་སྨྲ།",
    "ས་ཛ་ས་དང་ས་ག་རྣམས་ནི་སྙན་པའི་ངང་པར།",
    "ཏ་བྷ་ཛ་ཛ་ག་ག་དབྱིད་ཀྱི་ཐིག་ལེར་ཤེས་པར་བྱ།",
    "དེ་ལྟ་བུ་ལ་ནོར་དང་ཐུབ་པར་ངལ་གསོ་ཡོན་ཏན་ནོར་བུའི་ཚོགས།",
    "ཛ་སཱ་ལྭ་ན་ར་རཱ་ཝ་སུ་གྲ་ཧ་ཡ་ཏིསྟུ་པྲྀ་ཐཱི་མ་ན་ཛ་བྷ་ཛ་ར་རྣམས་རྣམ་པར་སྤེལ་བ་འདི་ནི་རྒྱ་མཚོ་ཅན།",
    "ན་ཛ་བཾ་ན་། ལྡན་མ་། བྷ་ར་ན་ཝ་ན་ན་ཝ་རྣམས་ཕྱོགས་དང་ཐུབ་པར་འོད་མའི་འདབ་མ་ལྟུང་།",
    "འདིར་ནི་ན་གཉིས་ར་བཞི་བསྒྲིགས་པ་དེ་ནི་ལྕགས་ཀྱི་མདའ་རུ་འཆད་པར་བྱེད།",
    "མྣོ་ནུརྡིརྣ་ནུ་ས་ག་བི་ཏི་ན་བ་ར་ས་ར་ས་ཀ་ར་ཎ་བི་ར་ཏི་ར་བ་བཱ་བྷ་ག་ཝ་བྷ་ག་ཝ་ན་དག་ལ་ཀ་ན་ན་ཝ་རྣམས་མདའ་མདའ་ནོར་དང་ཐུབ་པར་ངལ་བསོ་ཁྲུང་ཁྲུང་རྐང་།",
    "གལ་ཏེ་ཐ་མ་གཉིས་ཀ་དག་ཀྱང་ལྕི་བར་བྱས་པ་རོལ་པའི་རྐང་པ་རྣམ་པར་སྤྲོ་བར་གྱུར་བ་དག་ནི་གཙུག་ཕུད་ཅན་དུ་འགྱུར།",
    "ཁ་སྒོ་ཕན་པ་ཞེས་པར་། ཏཾ་། ཛེ་ནཱ་ཡུ་ཛོ་རུ་དཱ་ཧྲྀ་ཏཱ།",
    "དེ་དང་དེ་རྣམས་སྣ་ཚོགས་རྣམ་པར་བཀོད་པས་ཡང་དག་མཛེས་པ་ཅན་ལ།",
    "རོལ་སྒེག་དང་བཅས་རྐང་པ་རྐང་པར་ལྡན་པ་དག་ན་རྐང་བཞི་འཕེལ་དུ།",
    "གནས་པ་གལ་ཏེ་ཡོངས་སུ་བྱས་ཏེ་དེ་ནས་དབུས་སུ་གནས་པར་འགྱུར།",
    "ཅིག་ཤོས་གསུམ་རྣམས་གཡོ་བ་མེད་པར་གནས་ནི་ངེས་པར་གྱུར་པ་མེ་ཏོག་ཁམ་བྱེ་བ།",
    "རྣམ་པ་གསུམ་ནི་རྣམ་པར་གཡོ་བ་མེད་ཅིང་ངེས་པར་གནས་བར་གྱུར་པ་ཡུད་ཙམ་རོལ་པ།",
    "ས་ཛ་སཱ་ཛ་གོ་། བྱས་པས་རོལ་སྒེག་སྡོད་ཀྱིས་མངོན་བར་དགའ་བ་བསྐྱེད་པ་ཅན་འདི།",
    "ངེས་པར་བདུད་རྩིའི་རྒྱུན་དུ་འགྱུར་རོ།",
    "གསུམ་པ་རྣམས་གཞན་དུ་ཤེས་པར་བྱ་སྟེ།",
    "དེ་འདྲ་དེ་ནི་དྲི་ཞིམ་ལྡན་པར་བརྗོད་པར་འགྱུར་བ་ཡིན།",
    "གསུམ་པའི་མིང་ཅན་རྐང་པར་ན་དག་དང་ནི།",
    "ཁྱད་པར་རབ་མཆོག་ལྡན་དུ་དེ་ནི་རྗོད་པར་བྱེད་པ་ཡིན།",
    "འདི་ལས་ཕྱི་ནས་ཛཱ་ཏི་བརྗོད་པར་བྱ།",
    "གལ་ཏེ་ཟུང་མིན་གཅིག་ཀྱང་རྫོགས་མིན་པར།",
    "མིན་། དེ་ནི་རོ་ལངས་ཅན་དུ་བརྗོད་པར་བྱ།",
    "ཙ་ལས་ཁའམ་ཛ་ཉིད་ཁྱད་པར་ཚིགས་བཅད།",
    "འདབ་མ་སོ་སོར་བཅུ་བཅུ་བཅུ་རྣམས་ཡང་བ་བཀོད་མཐར་ལྕི་བྱས་ཤིན་ཏུ་གསལ་མཛེས་སོ།",
    "གཟུགས་ནི་དང་པོར་མ་བྱས་ཀྱང་།",
    "འདི་ནི་རྩོད་པའི་དུས་ཀྱི་ཐམས་ཅད་མཁྱེན་པ་རིན་ཆེན་འབྱུང་གནས་ཞི་བའི་ཞལ་སྔ་ནས་མཛད་པའོ།",
    "སླར་ཡང་དེ་ཉིད་ཀྱི་བཀའི་རྗེས་སུ་གནང་བ་ལ་བརྟེན་ནས།",
    "ཡང་འདིར་ཚིགས་སུ་བཅད་པར་གྱུར་ན།",
    "རྣམ་པར་གཅད་བྱ་དང་།",
    "ཡང་འདིར་ཚིགས་སུ་བཅད་པར་གྱུར་ན།",
    "ལེགས་བྱས་ནུས་ཤད་ལ།",
    "པླུ་ཏ་ནི་ངེས་པར་ཡང་སྟེ།",
    "བྱེད་ལྡན་དག་པ་རབ་ཀུན་རྣམ་ལེགས་ཤིན་ཏུ་ལྷག་པར་ལས་ཕྱི་མ་ཡང་ངོ།",
    "གྲངས་རབ་ཏུ་གྲགས་པའི་དངོས་པོ་རྣམས་ནི་གྲངས་ཉེ་བར་མཚོན་པར་བྱེད་དོ།",
    "ཉིས་འགྱུར་བྱས་ཞབས་སེན་ཟེར་ལ།",
    "གྲགས་པ་རབ་རྒྱས་འདི་ཉིད་ནི་། ས་སྐྱོང་ཉིད་དུ་རྣམ་པར་བཤད།",
    "བྷ་ལ་སོགས་པ་ཚོགས་པ་རྣམ་པ་བརྒྱད་ཀྱི་མཐར་ཨུ་ཡིག་གྱུར་ན་ངལ་བསོ་དང་ལྡན་པར་རིག་པར་བྱའོ།",
    "དབུས་ཕྲ་ཞེས་པ་མིང་ངོ་། དེ་བཞིན་དུ་ཕྱི་མ་རྣམས་ལ་ཡང་རིག་པར་བྱའོ།",
    "མ་བྷ་ས་གས་བསྐྱེད་པ་མྱོས་མར་ཤེས་པར་བྱ།",
    "རྐང་པ་སོ་སོ་ལ་མ་དང་བྷ་དང་ས་དང་ག་ཡིས་བསྐྱེད་པ་མྱོས་མ་རུ་རིག་པར་བྱའོ།",
    "རྐང་པ་བཞི་པོ་རྣམས་ཀྱི་ཁྱད་པར་ཡང་དང་པོའི་ཡི་གེ་རྣམས་ལའོ།",
    "དེའི་ཕྱིར་ཡི་གེ་བཞི་པའི་པྲྀཏྟ་བཞིན་པྲཱསྟཱ་ར་བྱས་ནས་བལྟ་བར་བྱ་སྟེ།",
    "ལྕི་བ་བ་ཞེས་པས་ལྕི་བའི་ངལ་བསོ་དང་ལྡན་པ་བའི་མིང་ཅན་དུ་བྱས་སོ།",
    "ས་ཛ་ས་དང་ས་ག་རྣམས་ནི་སྙན་པའི་དང་པར་བཤད།",
    "ཏ་བྷ་ཛ་ཛ་ག་ག་དག་ནི་དཔྱིད་ཀྱི་ཐིག་ལེར་ཤེས་པར་བྱ།",
    "གལ་ཏེ་རྐང་པ་སོ་སོ་ལ་རྟ་དང་བྷ་དང་ཛ་དང་ཛ་དང་ག་གཉིས་ཡིན་པ་དེའི་ཚེ་དཔྱིད་ཀྱི་ཐིག་ལེར་ཤེས་པར་བྱའོ།",
    "དེ་ལྟ་བུ་ལ་ནོར་དང་ཐུབ་པར་དལ་བསོ་ཡོན་ཏན་ནོར་བུའི་ཚོགས།",
    "ན་ཛ་བྷ་ཛ་ར་རྣམས་རྣམ་པར་སྤེལ་པ་འདི་ནི་རྒྱ་མཚོ་ཅན།",
    "ཡང་བའི་ངལ་བསོ་དང་ལྡན་པ་ནི་ཀའི་མིང་ཅན་ཏེ་ཡང་པ་ཀ་ཞེས་བྱས་པའི་ཕྱིར་རོ།",
    "བྷ་ར་ན་བ་ན་ན་བ་རྣམས་ཕྱོགས་དང་ཐུབ་པར་འོད་མའི་འདབ་མ་ལྷུང་།",
    "རྐང་པ་སོ་སོ་ལ་བྷ་དང་ར་དང་ན་དང་བ་དང་ན་དང་ན་དང་བ་རྣམས་ཏེ་ཕྱོགས་དང་ཐུབ་པར་ངལ་བསོ་བར་གྱུར་པ་ནི་འོད་མའི་འདབ་མ་ལྷུང་བའོ།",
    "དིདྨུ་ནི་བཾ་ཤ་པརྟྲ་པ་ཏི་ཏཾ་བྷ་ར་ན་བ་ན་ན་བེ།",
    "གལ་ཏེ་རྐང་པ་སོ་སོ་ལ་མ་དང་ལྕི་བ་འདིར་ནི་ན་དང་ན་དང་ར་བཞི་བསྒྲིགས་པ་དེ་ནི་ལྕགས་ཀྱི་མདའ་རུ་འཆད་པར་བྱེད་དོ།",
    "བྷ་ག་ཝ་བྷ་ག་ཝ་ན་དག་ཡང་ཀ་ན་ན་ཝ་རྣམས་མདའ་མདའ་ནོར་དང་ཐུབ་པར་ངལ་བསོ་ཁྲུང་ཁྲུང་རྐང་།",
    "དེ་ནས་ན་དང་ན་དང་ལ་དང་ཀ་དང་དེ་ནས་ཡང་ན་དང་ན་དང་བ་རྣམས་ཡིན་པ་དེའི་ཚེ་གང་ལ་མདའ་དང་མདའ་དང་ནོར་དང་ཐུབ་པར་ངལ་བསོ་པ་ནི་ཁྲུང་ཁྲུང་རྐང་ངོ།",
    "བཅུ་བཞི་རྣམས་ཀྱིས་དུང་ཞེས་པ་དེ་ལྟ་བུ་ལ་སོགས་པར་བརྗོད་པར་བྱའོ།",
    "འོན་ཀྱང་ཁྱད་པར་ནི་ན་གཉིས་ལས་ཕ་རོལ་ཏུ་ར་རྣམས་ཀྱིས་རྒྱུན་ཆགས་ཡིན་ཞིང་ན་གཉིས་ལས་ཕ་རོལ་ཏུ་ཡ་རྣམས་ཀྱིས་ནི་རབ་བསགས་སོ།",
    "བརྒྱད་དང་དགུ་ལ་སོགས་པ་རྣམས་ཀྱིས་གཏུམ་པའི་ཆར་འབེབས་ལ་སོགས་པར་དབྱེ་བར་རིགས་པར་བྱའོ།",
    "བཅུ་རྣམས་ཀྱིས་སྤྲུལ་ཞེས་པ་དེ་ལྟ་བུ་ལ་སོགས་པ་རྣམས་བརྗོད་པར་བྱའོ།",
    "གལ་ཏེ་ཐ་མ་གཉིས་ཀ་དག་ཀྱང་ལྕི་བར་བྱས་པ་རོལ་བའི་རྐང་པ་རྣམ་པར་སྤྲོ་བར་གྱུར་པ་དག་ནི་གཙུག་ཕུད་ཅན་དུ་འགྱུར་བ་ཡིན།",
    "གལ་ཏེ་གཉིས་ཀའི་མཐའ་ལྕི་ཞིང་རོལ་པའི་རྐང་པ་རྒྱས་པར་གྱུར་པ་དེའི་ཚེ་གཙུག་ཕུད་ཅན་དུ་འགྱུར་རོ།",
    "བཟློག་པར་བྱས་པས་གང་ལ་ཕྱེད་བཀོད་པ་འདི་འདིར་འགྲོ་ལྡན་འཐེང་པོར་འགྱུར་རོ།",
    "དང་པོ་དང་ཐ་མ་དག་སོ་སོར་བྱས་ཏེ།",
    "དེ་རྣམས་ལན་གཉིས་བསྐྱར་ཏེ་ཚིགས་སུ་བཅད་པ་རྫོགས་པར་བྱའོ།",
    "ཁ་སྒོ་ཕན་པ་ཞེས་པར་གྲགས་སོ།",
    "ན་ཡིག་སྦྱོར་ལས་ཤེས་པར་བྱའོ།",
    "ཁ་སྒོ་དེ་ཉིད་གྱ་གྱུ་ཅན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་དང་དེ་རྣམས་སྣ་ཚོགས་རྣམ་པར་བཀོད་པས་ཡང་དག་མཛེས་པ་ཅན་ལ།",
    "རོལ་སྒེག་དང་བཅས་རྐང་པ་རྐང་པར་ལྡན་པ་དག་ནི་རྐང་བཞི་འཕེལ་དུ་མཁས་རྣམས་སྨྲའོ།",
    "ཛཱ་ཏིའི་ཆ་ཤས་ཚོགས་པ་ལས་རིག་པར་བྱའོ།",
    "གནས་པར་གལ་ཏེ་ཡོངས་སུ་བྱས་ཏེ་དེ་ནས་དབུས་སུ་གནས་པར་གྱུར་ལ།",
    "ཅིག་ཤོས་གསུམ་རྣམས་གཡོ་བ་མེད་པར་གནས་ནི་ངེས་པར་གྱུར་པ་མེ་ཏོག་ཁམ་བྱེ་བ།",
    "རྣམ་པ་གསུམ་ནི་རྣམ་པར་གཡོ་བ་མེད་ཅིང་ངེས་པར་གནས་བར་གྱུར་པ་ཡུད་ཙམ་རོལ་པ།",
    "རྣམ་པར་གཡོ་པ་མེད་པ་ཉིད་ནི་ཡང་དག་འདས་པར་ལྷུང་བར་གྱུར་ཅིང་།",
    "ངེས་པར་བདུད་རྩིའི་རྒྱུན་དུ་འགྱུར་རོ།",
    "གལ་ཏེ་གང་ལ་རྣམ་པ་མང་པོར་བྱས་ཤིང་།",
    "གསུམ་པ་རྣམ་པ་གཞན་དུ་ཤེས་པར་བྱ་སྟེ།",
    "དེ་འདྲ་དེ་ནི་དྲི་ཞིམ་ལྡན་པར་བརྗོད་པར་འགྱུར་བ་ཡིན།",
    "རྐང་པ་གསུམ་པ་ནི་གཞན་བཞིན་ཤེས་པར་བྱའོ།",
    "ར་དང་ན་དང་བྷ་དང་ལྕི་བ་རྣམས་བསྒྲིགས་པ་དེ་འདྲ་དེ་ནི་དྲི་ཞིམ་ལྡན་པར་སྨྲའོ།",
    "གལ་ཏེ་རྐང་པ་དང་པར་མ་ས་ཛ་བྷ་ལྕི་བདག་གྱུར།",
    "འདིར་ཡང་གཞན་ཐམས་ཅད་རྐང་པའི་གནས་ཀྱི་མཚན་ཉིད་ཀྱི་ཆོ་ག་དལ་འགྲོ་ཉིད་དང་མཚུངས་པར་ཡོངས་སུ་བསྟན་པ་དེའི་ཚེ་སྙན་ངག་མཁན་རྣམས་འཕེལ་བ་ཅན་གྱི་ཞུགས་པར་སྨྲའོ།",
    "གང་ཚེ་གསུམ་པར་ཏ་ཛ་ར་རྣམས་འདི་ཉིད་དང་བོར་ངལ་བསོ།",
    "མཚུངས་པར་གྱུར་པ་དག་པ་སྣང་ལྡན་གྱི།",
    "ཁྱད་པར་རབ་ན་ཆོག་ལྡན་དུ་དེ་ནི་རྗོད་པར་བྱེད་པ་ཡིན།",
    "བྲྀཏྟའི་བྱེ་བྲག་རྣམས་བརྗོད་ཟིན་ཅིང་བརྗོད་པར་བྱ་བ་ནི་ཛཱ་ཏི་རྣམས་སོ།",
    "བརྒྱད་པར་ཡང་བདག་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཙ་གསུམ་རྣམས་ཀྱིས་ཟུང་མིན་རྐང་པ་དག་གང་ཆོ་རྫོགས་པ་དེ་ཚེ་འཕྲོད་པར་འགྱུར།",
    "ལྷག་མངལ་བསོ་ལ་སོགས་པའི་རྣམ་པར་གཞག་པ་སོ་སོར་ངེས་པ་དང་།",
    "གང་ཕྱེད་ཕྱི་མ་ལ་བྱས་པ་ཕྱེད་སྔ་མ་ལ་གྱུར་བ་དང་།",
    "གང་ཕྱེད་སྔ་མ་ལས་བྱས་པ་ནི་ཕྱེད་ཕྱི་མ་ལ་གྱུར་པ་དེ་མཆོག་དབྱངས་སུ་འགྱུར་རོ།",
    "དེ་ནི་རོ་ལངས་ཅན་དུ་བརྗོད་པར་བྱ།",
    "ཙ་ལས་ཁའམ་ཛ་ཉིད་ཁྱད་པར་ཚིགས་བཅད།",
    "གལ་ཏ་རྐང་པ་རྣམས་ལ་ཙ་ཡིག་བཞི་ཡིན་ལ་ཙ་ལས་ཕ་རོལ་ཁའམ་ཛ་ཡིན་པ་དེའི་ཚེ་ཁྱད་པར་ཚིགས་བཅད་དོ།",
    "དེ་ལ་བྲྀཏྟ་རྣམས་ཀྱི་མཐའ་དག་ཉུང་དུས་མཁས་པར་ཤེས་པའི་དོན་དུ་པྲཱསྟཱ་ར་ལ་སོགས་པ་དྲུག་བརྗོད་པར་བྱའོ།",
    "དེར་གང་མི་མཉམ་པ་དེ་ལ་གཅིག་བསྣན་པ་ལས་མཉམ་པར་བྱས་ནས་འདབ་མ་བྱའོ།",
    "དེ་ལྟ་བུས་དེ་གསལ་བར་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟར་བྱས་པས་གྲངས་གང་རྙེད་པ་དེ་འདི་ལྟ་བུ་ཡིན་ནོ་ཞེས་པ་ནི་ཨུདྡིཥྚར་རིག་པར་བྱའོ།",
    "དེ་ལྟ་བུས་དེ་བྲྀཏྟ་བཅུ་པའོ་ཞེས་པར་འགྱུར་རོ།",
    "རིམ་པས་ཐུང་དུང་བྱས་པའི་ལངས་པ་གཞན་རྣམས་ལ་གནས་པ་གསུམ་དང་།",
    "ཅི་ཞིག་འགྲུབ་པར་འགྱུར་ཞེ་ན།",
    "གཟུགས་ནི་དང་པོར་མ་བྱས་ཀྱང་།",
    "བྲྀཏྟ་རྣམས་ཀྱི་ཡི་གེ་ལ་སོགས་པ་ཤེས་པར་འདོད་པ་ལ་ཆོ་ག་འདིའོ།",
    "དེ་ལྟར་ནི་ལྕི་བ་རྣམས་ཀྱིས་ཇི་སྙེད་པ་དེ་སྙེད་དུ་ཡང་བ་རྣམས་ཀྱིས་བརྟག་པར་བྱའོ།",
    "འདི་རྣམས་ཀྱི་གང་ལས་མ་རྟོགས་པའི་ཁྱད་པར་ཉུང་དུས་རྟོགས་པར་བྱེད་ཅིང་།",
    "བསྟན་བཅོས་མཛད་པ་རྣམས་ཀྱི་ཡང་མཁྱེན་པ་ཕུལ་དུ་བྱུང་བ་ཡང་དག་པར་རྟོགས་པར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་རིགས་པར་ཅིག་ཤོས་རྣམས་གསལ་བར་བྱ་བ་ཡིན་པས་དེ་དང་དེ་རྣམས་ནི་འོག་དང་སྟེང་དུ་བཀོད་པའི་ལས་ཀྱི་མཐའ་ལ་བལྟ་བར་བྱའོ།",
    "ཡང་བ་ཡི་གེ་ཡི་གེ་དང་པོ་ལ་ལྕི་བ་རྣམས་གཉིས་འགྱུར་བྱས་ཏེ་བསྣན་ནོ།",
    "དབུས་སུ་ཡི་གེ་རྣམས་ཉིས་འགྱུར་བྱས་ཏེ་ཡང་བ་རྣམས་དབྲིའོ།",
    "སླད་ཀྱི་ས་གསུམ་ན་འགྲན་ཟླ་དང་བྲལ་བའི་ཐམས་ཅད་མཁྱེན་པ་ཆེན་པོ་དོན་གྱི་སླད་དུ་མཚན་ནས་སྨོས་ཏེ།",
    "སླར་ཡང་དེ་ཉིད་ཀྱི་བཀས་རྗེས་སུ་གནང་བ་ལ་བརྟེན་ཏེ།",
    "སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱི་བཀའ་དྲིན་གྱིས་ལེགས་པར་བསྐྱངས་པའི་དགེ་སློང་ནམ་མཁའ་བཟང་པོས་ཤཱཀྱའི་དགེ་སློང་སྡོམ་བརྩོན་དམ་པ་རྣམས་ཀྱི་གཙུག་རྒྱན།",
    "ཇི་ལྟར་རྣམ་མང་རྣམ་པར་བཀོད་པ་ཡིས།",
    "མཐའ་དག་རིམ་ལས་ལྕི་དང་ཡང་བ་རྣམས་བློ་ལྡན་རྣམས་ཀྱིས་རྣམ་པར་བགྲང་བར་ནུས།",
    "དེ་ནི་གུས་པས་རྣམ་པར་བསམས་པ་ན།",
    "ཁྱེད་ཀྱིས་འཁྲུལ་པ་འཇོམས་པར་ནུས་གྱུར་ཅིག་བློ།",
    "གཅིག་མིན་སྲིད་པར་ནི།",
    "རྟོགས་པའི་ཁྱད་པར་དག་ལེགས་འཆང་རྣམས་ཀྱིས་བརྟེན།",
    "གྱེན་དུ་འགྲོ་དང་ལྡན་པར་འགྱུར།",
    "བློ་ཡི་མིག་ནི་ངེས་པར་བཀག་པའི།",
    "ཡལ་འདབ་དག་དང་མཚུངས་པར་བྱེད་དོ།",
    "གོ་འཕང་བཀོད་པ་རབ་ཏུ་ཐོབ་པར་བྱེད།",
    "བཀོད་པར་གྱུར་པའི་ས་གཞི་བཞིན་དུ་མཛེས།",
    "ཞི་བའི་གཟུགས་ཀྱི་འབྲས་བུ་སྨིན་པར་བྱེད།",
    "བླུན་པོ་རྣམ་པར་འཇོམས་ནུས་འཇིག་རྟེན་གསུམ་གྱི།",
    "རྣམ་རྒྱལ་སྒྲ་ནི་རྒྱས་པར་བྱེད་ཅིང་རྒྱུ་སྟེ།",
    "ཇི་ལྟར་ཀུན་དུ་སྒྲོགས་པར་བྱེད་མེད་པ་བཞིན།",
    "རྣམས་ཀྱང་མྱོས་པར་བྱེད་ཅིང་རྣམ་པར་རོལ་ལོ།",
    "སྣ་ཚོགས་རྣམ་པར་འཕྲོ་བའི་འོད་ཟེར་ཕྲེང་ལྡན།",
    "སྒྲ་སྙན་སྒྲོགས་པར་བྱེད་ཅིང་གདུབ་བུ་དག་ནི།",
    "གསུམ་བསྔགས་དག་ལ་འགྲོ་བ་དམན་པར་ཉེ་བར་གྱུར།",
    "མཛེས་པའི་རྒྱུན་ནི་དཔེ་མེད་རབ་ཏུ་འཕྲོ་བ་དག་སུ་ཡི་དགའ་བ་དག་ནི་སྐྱེད་པར་བྱེད་མ་ཡིན།",
    "ལེགས་པར་འོངས་པ་བུང་བའི་ཚོགས་ནི་སྒྲོགས་བྱེད་པས།",
    "གྲགས་པ་རྣམ་པར་རྒྱལ་བ་བཞིན་དུ་སྒྲོགས་བྱེད་ཅིང་།",
    "སེམས་ཀྱི་རྒྱུད་ནི་ཅི་ཡི་རྣམ་པར་འཕྲོ་བ་ཡིན།",
    "རྣམ་པར་འཕྲུལ་བ་བཞི་ཆད་དག་ལ་དགའ་བ་ནི།",
    "དཀར་བ་དག་གས་ཕྱོགས་བཅུ་ཤིན་ཏུ་བརྒྱན་པར་གྱུར།",
    "རིམ་གྱིས་རབ་ཏུ་ཉམས་པར་འགྱུར་ཏེ་མི་བཟད་པའི།",
    "ཞི་བ་འདོད་པ་རྣམས་ཀྱིས་ཉེ་བར་བསྟེན་པར་གྱུར།",
    "དེ་དག་ལྷ་རྣམས་ཉེ་བའི་རིས་ཏེ་བསྔགས་པར་འོས།",
    "ལུས་མེད་དག་ལས་རྒྱལ་བ་རིགས་ལ་གནས་པར་གསུང་ངོ།",
    "བྱིས་པའི་དབྱིབས་ཅན་མཛེས་ཤིང་རྣམ་པར་བཀྲ་བའི་རྒྱན་ལྡན།",
    "འགྲོ་བ་གསུམ་པོ་དག་ཀྱང་གཙང་མ་ཉིད་དུ་བྱེད་ཅིང་།",
    "ཆུ་གཏེར་རླབས་ཆེན་བྱས་པར་ངལ་བ་མཆོག་ཏུ་སྟོན་ན།",
    "དབྱེ་བ་བརྒྱད་དང་ལྡན་པར་བདེ་བླག་ཁོ་ནར་འགྲོའོ།",
    "བདེ་དང་སྡུག་བསྔལ་ཁྱད་པར་འཕགས་ལ་སོགས་པའི་རྒྱུ་ནི།",
    "སྐྱེས་པ་རྣམས་ཀྱིས་དྲན་པ་ཉམས་པར་འགྱུར་བ་མེད་དོ།",
    "ཆུ་ཡི་གཏེར་དུ་ཆུ་རྣམས་རྣམ་པར་གསལ་བར་བྱས་ནས་ནི།",
    "སྒྲ་རྣམས་འཇམ་པའི་དབྱངས་བྱེད་ཚུལ་ཅན་འདི་ཡིས་རྒྱལ་གྱུར་ཅིག་ཁྱད་པར་འཕགས་པའི་ཡོན་ཏན་ཀུན་གྱིས་དགའ་བ་མཆོག་རབ་ཐོབ་པ་ཡི།",
    "ཤེས་ལྡན་སྦྲང་རྩིའི་བརྟུལ་ཞུགས་རྣམས་ཀྱིས་ཉེ་བར་བསྒྲགས་པར་བྱ་བ།",
    "ཁྱེད་ཀྱི་ཐུབ་པའི་སྤྱོད་ཚུལ་མི་ཕན་འཇོམས་པའི་རྣམ་པར་གནོན་པས།",
    "རྣམ་པ་སྣ་ཚོགས་མཚོན་ཆ་སྒྲོགས་པར་བྱེད་རྣམས་རྣམ་པར་རོལ་ལོ།",
    "བརྒྱན་པའི་ནོར་འཛིན་འདི་ནི་རང་ཉིད་ངེས་པར་འདམ་པར་བྱེད་དོ།",
    "སྟོབས་ཅན་ཆེས་ཆེར་འདར་བའི་འདོད་ལྷའི་རྣམ་པར་བསྒྱིངས་པ་འཛིན་པར་བྱེད།",
    "མཆོག་ཏུ་རྒྱ་ཆེའི་གཟུགས་གཞན་མ་ལུས་རྣམས་ལ་དགའ་བར་འཕྲོག་པར་བྱེད།",
    "མགོན་པོ་འགྲོ་བ་ཕམ་པར་བྱེད་པའི་གླང་པོ་གཡོ་མེད་བྱེད་པ་ཡི།",
    "འགྲོ་བ་གཞན་ལ་ཕན་པའི་མཁས་པ་རྣམས་ནི་རབ་ཏུ་རྒྱས་པར་མཛད།",
    "ཤིན་ཏུ་དགའ་བར་མཛད་པའི་གསུང་ཅན་རྒྱུན་ཆད་མེད་པར་གསར་བ་དང་།",
    "དཀའ་བ་མིན་ཞེས་འདི་ན་བློ་གྲོས་ཆུང་དུ་རྣམས་ཀྱང་སྒྲོགས་པར་བྱེད་དོ།",
    "གསང་མཐོར་སྨྲ་བ་མྱོས་ཤིང་སྒྲོགས་པའི་ལག་ལྡན་ཚོགས་རྣམས་འཇོམས་པར་བྱེད་ཅིང་།",
    "རྒྱ་ཆེ་བ་ནི་སྣ་ཚོགས་ནགས་ཀྱི་ནང་འདི་རྣམས་སུ་འཛིན་པར་མཛད་དོ།",
    "གང་ཕྱིར་བདུད་ཀྱི་ཆུང་མའི་སྐྱེ་བོའི་ལག་པ་དག་ནི་འདོད་པར་འོས་པའི།",
    "འགྲམ་པའི་གཞི་ལ་མཁུར་རྩི་གསར་པ་འགོད་པར་བྱེད་ལ་ལེ་ལོ་ཁོ་ནའོ།",
    "འདི་ཡིས་འཇིག་རྟེན་སྐྱོང་བ་བརྒྱད་པོ་རྣམས་ནི་ལྷག་པར་དགའ་བར་མཛད་དོ།",
    "སྣང་བར་བྱེད་པ་བརྒྱ་ཕྲག་རྣམས་ལས་ལྷག་པར་གསལ་བའི་གཟི་ཡིས་བརྒྱན་བྱས་པ།",
    "མཐར་བྱེད་དྲེགས་པ་འཇོམས་བྱེད་སྲིད་གསུམ་མགོན་པོའི་ས་རྣམས་འཛིན་པ་རྒྱལ་གྱུར་ཅིག་རྣམ་པར་རྨོངས་པ་རྒྱ་ཆེའི་མུན་པའི་ཚོགས་ཀྱིས་ངེས་པར་བཅིངས་པ་རྣམས་ཀྱིས་ནི།",
    "བརྒྱ་ཕྲག་རྣམས་སུ་ཉེ་བར་བསྒྲུབས་པའི་འབྲས་བུ་ཆེན་པོ་ལྟ་བུར་རྣམས་བྱས་ཏེ།",
    "མགོན་པོ་རྣམ་པར་གནོན་པར་གྲགས་པ་གདུལ་བར་དཀའ་བ་རྣམས་ནི་གདུལ་བ་ཡི།",
    "ཉན་པར་འདོད་པ་འཇིགས་བྱེད་དུ་བའི་སྒྲ་ལས་གཅིག་ཏུ་འཇུག་བྱེད་འཇིག་རྟེན་གསུམ།",
    "དམན་ཡང་མནན་འདི་ཐིམ་དང་མྱུར་དུ་རང་གནས་མིན་པར་འགྲོ་བྱེད་སྐུ་འཛིན་བྱེད།",
    "རྣམ་པར་འཕྲུལ་པའི་སྤྲོས་པ་རྒྱས་པ་སྤྲོ་བྱེད་མདའ་ལྔ་པ་ནི་འཇོམས་བྱེད་རྣམས་དང་མཛེས་མ་ཡི།",
    "སྐྱེ་བོ་བཅུ་ཡི་བདག་ཉིད་ཀྱིས་ཀྱང་རབ་ཏུ་འདོད་བྱའི་ངོ་མཚར་དཔལ་ནི་ཅི་ཡང་རྒྱས་པར་བྱེད།",
    "གཟུགས་དང་སྐྱེ་ཚུལ་དང་ནི་རྣམ་པར་འབྱོར་དང་རྣམ་གནོན་ཁྱད་འཕགས་ཕུན་སུམ་ཚོགས་མཐའ།",
    "སྒྲོགས་པའི་གྲགས་པ་དྲི་མ་མེད་པ་སྟོན་ཀའི་ཟླ་ལྟར་མཆོག་ཏུ་རབ་མཛེས་ངེས་པར་བདེ་བླག་སྒྲུབ་བོ།",
