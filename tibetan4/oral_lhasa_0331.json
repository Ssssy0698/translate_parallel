    "དེ་ལྟར་རྣམ་པར་མཛེས་བྱེད་བརྒྱནཀུན་གྱིས།",
    "བཏང་བ་སོགས་བྱས་ཏེ།",
    "འཇིག་རྟེན་གསུམ་བོ་གར་ར་ཆིསཕལ་བའི་རྡུལ་བཞིན་བརླག་པར་མཛོད།",
    "གཞན་གྱི་དཔུང་རྣམསའཇོམས་པར་བྱེད།",
    "བགེགས་རྣམས་མ་ལུས་མེད་པར་མཛོད།",
    "ཨོཾ་ཧྲི་ཨ་པཱཙྪ་ཏི་ཏི་པརག་ལ་སིདྷ་ཛ་ཧཱུཾ།",
    "གནོད་བྱེད་ཐམས་ཅད་སྐྲག་པར་བྱེད།",
    "ཚེ་ཡང་ཐམས་ཅད་འགུགས་པར་བྱེད།",
    "ཐེ་སྒྱུར་བའི་གཡང་ཕུར་བྱས།",
    "སརྦ་མངྒལཾ། ། ཞབཔོན་ཆེན་ངེད་འདུལ་གྱི་སྒྲུབཟབས་རྒྱས་པའདོད་དགུའི་ཆར་འབེབས་ཞེས་བྱ་བ་བཞུགསོ།",
    "མེ་དབུབའཆར་བའི་དབུས་ན་རོལ་པའི་སྟབས་ཀྱི་བཞུགས་པའོ།",
    "བསྟན་འཛིན་གྱི་སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱི་སྐུ་ཚབརྟན་ཞིང་འཕྲིན་ལས་རྒྱས་པར་མཛད་དུ་གསོལ།",
    "ཁྱད་པར་དུ་རྣལའབྱོར་བདག་ཅག་དཔོན་སློབ་འཁོར་དཔ་བཅས་པ་རྣམས་ཀྱི་འགབརྒྱནམི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་བཟློག་ཅིང་ཞི་བར་མཛད་དུ་གསོལ།",
    "དྲག་པོ་མངོན་སྤྱོད་ཀྱི་འཕྲིནཨས་ཅདཐོགས་པ་མེད་པར་འགྲུབ་བར་མཛད་དུ་གསོལ།",
    "བརྐྱང་བསྐུམ་སྟབས་ཀྱིསཔར་གྱུར།",
    "བརྐྱང་བསྐུམ་སྟབས་ཀྱིས་ཀླུ་སྟེང་བཞུགས།",
    "བཀྲ་ཤིས་དགེ་ལེགས་རྒྱས་པར་མཛོད།",
    "དེ་ན་ས་ཚོགས་པས་སྤྱི་ལྟར་བྱས་ཏེ།",
    "བཀྲ་ཤིས་ཅི་རིགས་པས་མཐའ་བརྙན་པར་བྱའོ།",
    "ཐུགས་དཔའགལ་བ་ཅི་མཆིས་མཐོལ་ཞིང་བཤགས།",
    "ཁྱདཔར་བདག་ལ་གནོད་བྱེད་པའི།",
    "རིནཔོཆེའི་སྣོད་གཙང་མར།",
    "ཛཧཱུྃབ་ཧོ་དམ་ཚིག་པ་དང་གཉིས་སུ་མེད་པར་གྱུར།",
    "ཆུ་ལྷལས་རྣམ་པར་སྣང་མཛད་ཀྱིས་དབུ་བརྒྱན་པར་གྱུར།",
    "འཇིག་རྟེན་པ་རྣམས་རང་གནས་སུ་གཤེགས་པར་གྱུར།",
    "མགྲིནཔར་ཨཱ་ཐུགསཀརཧཱུཾ།",
    "གཉིས་མེད་བཞུགས།",
    "བཀྲ་ཤིས་ཀྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "བཞུགས་ནས་དཔལ་གྱི་བཀའ་ལུང་བཞིན།",
    "ཡངངའི་ཟླ་ལྟར་རྒྱས་པར་མཛོད།",
    "༡ན་ཐོས་རང་རྒྱལ་ཇི་སྙེད་བཞུགས་རྣམས་ལ།",
    "བདུད་རྩིའི་བདེ་བས་ཡང་དག་ཚིམ་པར་བགྱི།",
    "ཡིད་འོངས་མས་ཀྱིས་རྟག་ཏུ་གནས་པར་ཤོག།",
    "སེམས་བསྐྱེད་བཅུ་པོའི་ཕ་རོལ་ཕྱིན་པར་ཤོལ།",
    "མཚན་དང་དཔེ་བྱད་སྐུ་གསུངས་ཐུགས་ཀྱི་རྒྱན།",
    "ཐམས་ཅད་མཁྱེནཔའི་ཡེ་ཤེས་རྟོགས་གྱུརཅིག།",
    "ངས་རྒྱས་མཛད་པ་མཐའ་ཡས་སྟོན་པར་ཤོག།",
    "འདྲེན་པ་ད་ནི་ཡོངས་སུ་འདྲེན་པར་ཤོག།",
    "བྱས་དང་བྱེད་འགྱུར་དེ་བཞིན་ཁྱེད་པ་དང་།",
    "རྣམ་པར་འཕྲུལ་བའི་འོད་ཟེར་དཔག་མེད་ཀྱིས།",
    "རྣམ་པར་དཔྱོད་པ་རིན་ཆེནལྟབུ་དང་།",
    "གཉིས་ཀ་འཛིན་པར་རློམ་པ་ཡང་།",
    "བཏགས་པ་ཙམ་གྱིས་ཁྱད་པར་དུ་བྱས་ནས་ངར་འཛིན་པ་དང་།",
    "ཞེས་པའི་འགྲེལ་པ་ཀུན་མཁྱེན་འབྲུག་པས་བཀྲལ་བར།",
    "གང་ཟག་བཏགས་པར་ཡོད་ཉིད་དུ།"
  ]
