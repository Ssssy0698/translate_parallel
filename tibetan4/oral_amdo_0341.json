    "གང་ཟག་གིས་སྤྱོད་དེ་ནི་རང་གིས་རང་བཅིངས་པའོ།",
    "དེ་ཕྱིར་རེ་དང་དོགས་པའི་གཉེན་པོས་འཆིང་མི་དགོས།",
    "ཕན་ངེས་སྔོན་དུ་སོང་ནས་བརྟུལ་ཞུགས་གང་སྤྱོད་པ།",
    "དངོས་པོར་འཛིན་པའི་དུག་གིས་རང་གི་སེམས་ལ་ཁྱབ།",
    "ཨཱརྱེ་ཐལ་བ་ལུས་ལ་བསྒོས་ནས་སུ།",
    "ཁྱོ་མེད་སྐྲ་མེད་འདི་འདྲ་གཞན་ལ་སྟོན།",
    "སེན་མོ་རིང་ཞིང་ལུས་ལ་དྲི་མས་གཡོགས།",
    "བུད་མེད་སྤུ་བཏོགས་གྲོལ་བར་འགྱུར།",
    "མདའ་བསྣུན་ན་རེ་ནམ་མཁའི་ཡིད་ཅན་ལ།",
    "ལྷན་ཅིག་སྐྱེས་བྲལ་གཞན་གང་གིས།",
    "གང་ཞིག་གང་ལ་མོས་པར་གྱུར་པ་དེས།",
    "དེ་ལ་ཅི་བྱ་གསང་སྔགས་བསྟེན་པ་གང་ཞིག་གིས།",
    "བྱོལ་སོང་འཇིག་རྟེན་མི་གོ་ཇི་ལྟར་བྱ།",
    "བསམ་གཏན་དག་གིས་མི་བསླད་དེ།",
    "རྨོངས་པའི་འཇིག་རྟེན་མགོ་པོར་རྡོག་པས་མནན་ནས་སོང་།",
    "མདའ་བསྣུན་གྱིས་ནི་མན་ངག་ཐམས་ཅད་བསྟན་ནས་སོང་།",
    "རང་གི་ངོ་བོའང་ཉམས་པར་འགྱུར།",
    "གཉུག་མའི་རང་བཞིན་ཚིག་གིས་མི་བརྗོད་ཀྱང་།",
    "སློབ་དཔོན་མན་ངག་མིག་གིས་མཐོང་བར་འགྱུར།",
    "བླུན་པོ་གང་གིས་འཆིང་འགྱུར་བ།",
    "གང་གིས་རྨོངས་པ་འཆིང་བའི་དངོས།",
    "གོ་ལྡོག་རྔ་མོ་ལྟ་བུར་བདག་གིས་རྟོགས།",
    "བུ་ཁྱོད་རྣམས་ཀྱང་དེ་ལྟར་རང་ལ་འཚོལ་ཏེ་ལྟོས།",
    "ཤིང་གི་རྣལ་འབྱོར་སྣ་རྩེར་མ་འདུག་ཅིག་ཨེ་མ་ཧོ།",
    "མཐོང་དང་ཐོས་དང་དྲན་དང་རེག་བ་དང་།",
    "སེམས་སོ་ཞེ་ན་གཅིག་གི་རྣམ་པ་ལས་མི་སྤྱོད།",
    "སྨྲ་རུ་མི་བཏུབ་དེ་ནི་བདག་གིས་གྱི་ན་མཚོན།",
    "རང་གིས་རང་ལ་ལེགས་པར་བསྟན་ཏེ་ཤེས་པར་བྱོས།",
    "ཁྱིམ་ན་ཡོད་པ་ཕྱི་རོལ་སོང་ནས་འཚོལ།",
    "ཨུཏྤལ་བླངས་ཀྱང་ཆུ་ཡིས་མི་རེག་བཞིན།",
    "གང་ཡང་འདི་ལྟར་རྩ་བ་སྐྱབས་སུ་སོང་།",
    "དུག་གི་སྔགས་ཅན་དུག་གིས་ག་ལ་ཚུགས།",
    "སྟོང་པ་འབའ་ཞིག་གིས་ནི་སྤྱད་པར་བྱ།",
    "རང་གི་འདོད་པ་མང་པོ་སོ་སོར་གསལ་བར་སྣང་།",
    "ཕྱི་རོལ་སོང་ནས་ཁྱིམ་བདག་འཚོལ།",
    "གང་ཡང་སྔ་ན་མེད་པའི་སྒེག་མོ་དང་འཕྲད་ནས།",
    "རང་གི་སེམས་དང་ཐ་དད་མ་བལྟ་ཞིག།",
    "ང་ཡིས་རྩེད་མོ་བྱས་པ་ལ།",
    "ཨ་མ་བཞག་ནས་བུ་དེ་སྐྱེ་མི་འགྱུར།",
    "ཕྱི་རོལ་པར་སེམས་སྡུག་བསྔལ་དག་གིས་འཛིན།",
    "གང་གིས་དེ་ཤེས་དེ་གྲོལ་འགྱུར།",
    "གང་གིས་ཡི་གེ་གཅིག་ཤེས་པ།",
    "བདེ་བ་གང་གི་རྣམ་པར་བསྐྱེད་པ་ནི།",
    "ས་གསུམ་གང་དུ་རྫོགས་སུ་རེ་བ་ལགས།",
    "གྲོགས་དག་ཟབ་མོ་དང་ནི་རྒྱ་ཆེ་བ།",
    "རང་བཞིན་གཅིག་གི་དབྱེ་བ་རྣམ་པར་སྤང་།",
    "དེ་ཉིད་དྲི་མེད་མཆོག་གི་གོ་འཕང་ངོ།",
    "དེ་ནི་གལ་ཏེ་འགྲོ་ན་རེ་བ་མེད།",
    "གསེར་འགྱུར་རྩི་ཡི་རིག་བྱེད་འཆང་གིས་རྟོགས།",
    "ཁྲི་སྙན་མིག་གིས་ནོར་བུའི་ནུས་པ་ལྟ།",
    "མངའ་བདག་ཚིག་ལ་བཙུན་མོ་ཟུར་མི་གཡོ།",
    "ཀ་འཇི་མི་དགོས་རང་གིས་བསགས་པའི་གསེར།",
    "ལྟོ་འགྲོས་དྲི་ཚོར་མ་གི་ཏ་ལ་འབྲོས།",
    "ཁྲི་མོན་ནང་དུ་གསེར་སྒྲོག་ཅི་ཞིག་བྱ།",
    "ཚ་གྲང་གཉིས་ཀ་སེལ་བ་སེང་གིའི་གླུ།",
    "ཁྱུ་མཆོག་ཐོང་མཁན་ཞིང་གི་མཐའ་མི་མཐོང་།",
    "རིགས་ངན་བུ་མོས་འཇོ་སྒེག་སྤངས་ནས་འདུག།",
    "རྒྱན་གྱིས་སྤྲས་པའི་བཙུན་མོས་གཞན་ཡིད་འཕྲོག།",
    "རང་གི་མཐེབ་མཛུབ་གཞན་གྱི་ལག་པ་མིན།",
    "གར་ཡང་བདེ་བ་ལང་ཚོ་རྒྱས་པའི་ལུས།",
    "ཁྱིམ་ལ་མི་དགའ་བུ་མོའི་བློ་མི་འཕྲོགས།",
    "ཨུ་རྒྱན་དུར་ཁྲོད་སྲིན་མོ་ཁྲོས་པའི་ས།",
    "སྨྲ་བར་མི་ཕོད་བཙུན་མོ་བསྣོལ་གྱི་མཚང་།",
    "གཏེར་གྱི་བདག་པོ་མི་རེ་རིགས་ངན་བུ།",
    "མཐོང་སྣང་དག་རུ་རེད་པ་དུག་སྦྲུལ་མིག།",
    "ཁྱོད་ལ་ཤིང་ལོས་གནོད་པ་བསྐྱལ་བ་མེད།",
    "གྲུ་བ་ཡན་ལག་བྲེལ་བ་རང་གི་ཆེད།",
    "མཐའ་ཐན་ན་ར་གཉིས་སུ་གང་གིས་འབྱེད།",
    "ཁྱོད་ཀྱིས་ཡུར་བ་འགགས་པ་ཕྱིར་སོལ་ཅིག།",
    "རྫིང་གི་ཆུ་ནི་ཕིག་པར་གྱུར་ཚེ་འཛད།",
    "འཁྲུལ་གྱི་བུ་མོ་འདི་ལ་མ་ཆགས་ཤིག།",
    "གསེར་དང་གྲེལ་མ་སྒྲོག་གི་ངོ་བོར་མཉམ།",
    "མཆོག་གི་ནོར་བུ་སྦ་བར་བྱ་བ་མིན།",
    "རྨོངས་པ་སྲིན་མོས་ཅོད་པན་བཅིངས་ལ་དགའ།",
    "ནོར་བུའི་ནུས་པ་ཐལ་བས་བྱིབས་ཚེ་སྟོར།",
    "ཆད་མེད་དུ་བའི་བུས་པ་ཤ་རེ་ཆད།",
    "སྟོང་ལོག་མི་བྱ་རིན་ཆེན་གླིང་གི་མི།",
    "དུག་གི་ཆུ་ནི་བཏུང་བར་བྱ་བ་མིན།",
    "བྲམ་ཟེ་ཆང་གིས་བཟི་བཅོས་བྱས་དུས་ལད།",
    "མིག་གི་རིན་ལ་ཅི་བཏུབ་སོམས་དང་ཀྱེ།",
    "སྟག་གི་རི་མོ་བཀྲ་བས་གྱོད་ལ་བཏུགས།",
    "དངུལ་ཆུ་སྣོད་དུ་ཟགས་པར་གྱུར་ཏ་རེ།",
    "སྦྲང་རྩི་མྱོས་པས་རྔ་མོ་གྱོད་ལ་གཏུགས།",
    "བག་མས་ལྟད་མོ་མ་མཐོང་ཚོར་དུས་དབུས།",
    "འབག་གི་རིག་བྱེད་གསེ་ཡི་བཟོ་ལ་གནོད།",
    "མ་ཧེའི་སྒྱིད་འཁྱོལ་འགྲོ་ལམ་ཐུར་གཞོལ་བདེ།",
    "དགེ་སློང་འདུག་ས་བཙུན་མོའི་ཁྲོད་མ་ཡིན།",
    "གསེར་མགར་མགུལ་དུ་རང་གི་རྒྱན་མ་ཐོགས།",
    "བྲན་མོས་རྙེད་ཀྱང་ནོར་བུ་རྗེ་བོས་འཁྱེར།",
    "བྱི་མོས་མིག་འབྲངས་ཕ་ཡི་ཡུལ་མི་ཟིན།",
    "ཁྲ་ཡིས་དེད་པའི་སྐྱར་མོ་ཉ་ཡིས་ལན།",
    "ཁྲི་མོན་ཁ་རུ་ལྷ་ཡི་སྲས་མོ་བྱུར།",
    "དུག་སྦྲུལ་གཙུག་གི་ནོར་བུ་བླང་མི་བྱ།",
    "བཙུན་མོའི་བསྲུང་མཚོན་མ་ལ་བཅོལ་བ་མིན།",
    "བུད་མེད་ཁྱིམ་གྱིས་སུན་པ་དེ་ལ་ལྟོས།",
    "མོ་གཤམ་བུ་ཡི་བག་མ་ངས་མ་མཐོང་།",
    "ཀཱརྵཱ་པ་ཎིས་དུང་གི་ཁ་དོག་མཚོན།",
    "ནམ་མཁའ་གང་ནས་བླངས་པ་ཁྱོད་ཀྱིས་སྨྲོས།",
    "ཡོད་མེད་གཉིས་སུ་སྨྲ་བ་གང་གིས་ནུས།",
    "ལྕགས་ཀྱི་ཐོ་བ་གང་གིས་ཕིག་པ་ཡིན།",
    "བྲག་ཅའི་སྒྲ་འདི་གང་གི་ཁ་ནས་བརྗོད།",
    "ནམ་མཁའ་འཕེལ་དུ་མ་སོང་ལྟོས་དང་ཀྱེ།",
    "རྡོ་ཡི་མི་ཡི་རིག་བྱེད་གང་དུ་སོང་།",
    "འགྲོ་མགོན་གྱིས་ཀྱང་ནམ་མཁའི་མུ་མ་གཟིགས།",
    "གསོ་རས་ཐལ་ཁུར་འཇུག་པ་དྲི་མ་མེད།",
    "ཚོང་ཁང་ནང་གི་འགྲོན་པོ་སྔ་རིམ་འགྱེས།",
    "ཉ་ཡིས་བརྣངས་པའི་སྐྱར་མོ་དགྲ་ལ་འབྱོལ།",
    "གཅིག་ཏུ་མི་གནས་སྟག་མོ་གྲུས་མའི་ཚང་།",
    "བུག་པ་ཡོད་བཞིན་ཟད་ཐལ་ཡུལ་མི་འགག།",
    "བི་རྩི་འཐུངས་པའི་མིག་ལ་མཚན་མོ་མེད།"
  ]
