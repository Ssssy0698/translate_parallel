    "ཀྱེ་ཧོ་དེ་ལྟར་མཁས་པས་ཐབས་ཟིན་དག་གིས་ནི།",
    "དྲན་མེད་གནས་པ་དག་གི་རྒྱས་བཏབ་ན།",
    "སྟོང་པར་མ་སོང་ཆད་པའི་མཐར་མ་ལྷུང་།",
    "དངོས་པོར་མ་སོང་རྟག་པའི་མཐར་མ་ལྷུང་།",
    "དབྱིན་གྲངས་༩༩ ནས་༡༡༧ ནང་གསལ། ། གསུང་གི་མཛོད་འཇམ་དབྱངས་རྡོ་རྗེའི་གླུ་བཞུགས་སོ། ། རྒྱ་གར་སྐད་དུ།",
    "གསུང་གི་མཛོད་འཇམ་དབྱངས་རྡོ་རྗེའི་གླུ།",
    "བདག་གཞན་དོན་འདོད་དངོས་འཛིན་རང་གིས་རང་ལ་འཆིང་།",
    "ལུང་དང་རིགས་པས་མཚན་ཉིད་རང་གིས་རྟོགས་འདོད་པས།",
    "ཕྱག་རྒྱ་མཆོག་དང་བསྟོད་པ་དག་གིས་གསོལ་བ་དང་གདབ།",
    "གང་གིས་རོ་སྙོམས་སྤྱོད་པ་དག་ལ་བརྟེན་ནས་འབྲས་བུ་ཐོབ།",
    "བཞིར་ལྡན་ཕྱག་རྒྱ་གཅིག་གི་ཆོ་འཕྲུལ་གཅིག་གི་ངང་།",
    "རྟོག་པའི་ངོ་བོ་བ་མོ་རྟ་ལྟར་སྣང་འདོད་ན།",
    "མཚོན་བྱ་མཚོན་བྱེད་ཚིག་གི་ཐ་སྙད་ལམ།",
    "མཚན་མའི་རྣལ་འབྱོར་མཚན་མེད་དོན་མི་རེག།",
    "ཐུན་མོང་མ་ཡིན་གསང་སྔགས་ཁྱད་པར་ཅན།",
    "ཕྱི་ནང་ཟབ་མོ་བསྐྱེད་པའི་རིམ་པ་ཀུན།",
    "འཇིག་རྟེན་ཅ་ཅོ་ཡིན་མོད་ཁྱད་མེད་མཚུངས།",
    "གསུང་གི་མཛོད་འཇམ་དབྱངས་རྡོ་རྗེའི་གླུ་ཞེས་བྱ་བ་དཔལ་ས་ར་ཧའི་ཞལ་སྔ་ནས་བསྟན་པ་རྫོགས་སོ།",
    "རང་གིས་ཉམས་སུ་མྱོང་བ་དེ་ཁོ་ནའོ།",
    "མཐའ་གསུམ་རྟག་འདོད་དག་གིས་རྙེད་པར་དཀའ།",
    "དོན་དམ་མཚན་ཉིད་ཉོན་མོངས་གཡུལ་ལས་རྒྱལ།",
    "ཀཱ་ཡ་ཝཱཀྐ་ཙིཏྟ་ཨ་མ་ན་སི་ཀ་ར་ནཱ་མ།",
    "རྣལ་འབྱོར་རྣམ་པར་གྲོལ་བར་མཛད་པ་གང་གིས་ནི།",
    "འགྲོ་ལ་བྱམས་པའི་ཆ་ལུགས་མཆོག་གིས་དོན་སྟོན་པའོ།",
    "གང་གི་སེམས་ལ་འདི་ཀུན་བསམ་དུ་མེད་དོ་ཀྱེ།",
    "ཁྱོད་ནི་ཕྲིན་ལས་ཡན་ལག་མང་པོ་སྟོན་མཛད་ཅིང་།",
    "གང་ཡང་གཙོ་མཆོག་ལྡན་པའི་སྦྱོར་བ་དག་གིས་རབ་ཏུ་མི་འབྱེད་པར།",
    "གང་གིས་དེ་ནི་མི་ཤེས་པས།",
    "གང་གིས་དེ་ཀུན་འཆིང་བར་བྱེད་པ་དེ་ཡིས་ནི།",
    "མན་ངག་ལོག་ན་གཅིག་གི་ངོ་བོ་ཉིད།",
    "ཤེས་པར་བྱ་དང་བྱའོ་ཅོག་གི་ཐ་སྙད་ཀུན།",
    "འདི་ལས་གཞན་དུ་ལྟ་བའི་མཚན་མ་ཉོན་མོངས་འགྱུར།",
    "གི་ཝང་གུར་གུམ་ཙནྡན་ཐིག་ལེར་བྲིས་པ་བཞིན།",
    "གང་གིས་ནམ་མཁའ་དག་ལ་ལོངས་སྤྱོད་པའི།",
    "འདི་ནས་སོང་བ་གང་ཡང་མེད་པར་ཤེས་པ་དེ།",
    "གང་གིས་མ་མཐོང་བ་ལས་དེ་ནི་རྒྱལ་བར་འགྱུར།",
    "འདི་ལ་ཤེས་དང་ཉོན་མོངས་ལ་སོགས་པའི།",
    "གསུང་གི་བདག་ཉིད་བརྗོད་པར་བྱ་བ་མིན།",
    "གང་གིས་གང་སྤྱོད་དེ་ཡིས་རབ་ཏུ་བརྒྱན།",
    "ཕྱི་ནང་བསམ་གཏན་རྩེ་མོས་བརྟགས་པས་སྟོང་།",
    "རང་གིས་མ་མཐོང་མཚན་ཉིད་ཀུན་ལྡན་པ།",
    "དྲན་མེད་མཉམ་པའི་དབྱིངས་ལས་སྐུར་གསལ་མོས་པ་མེད་པར་སྤྱོད།",
    "ཐུགས་རྗེས་མི་གཟིགས་སྐུ་གསུང་ཐུགས་ཀྱིས་མ་གོས་པ།",
    "དག་པའི་རིགས་རྣམས་ཀུན་ལ་ཁྱོད་ཀྱིས་སྤྱོད།",
    "གཅིག་གིས་དབྱིངས་ན་མི་མངོན་ཕྲ་བའི་ཚུལ་དུ་གནས།",
    "ཕྲག་དོག་སྲེད་པའི་ཉོན་མོངས་ལ་སོགས་པའི།",
    "དངོས་མེད་བདེན་པ་གཉིས་བྲལ་གཅིག་གི་དངོས་པོས་སྟོང་།",
    "ཉོན་མོངས་པ་རྣམས་ཉི་མས་རབ་ཏུ་སྐེམས་པར་བྱེད་ཟེར་འདི།",
    "ཉོན་མོངས་ལ་སོགས་བསགས་པའི་ས་བོན་ནི།",
    "གལ་ཏེ་སྟག་དང་ཝ་མོ་ལྟ་བུའི་སྟོབས་ནི་གོ་ལྡོག་ན།",
    "ཁྱོད་ཀྱིས་རྩྭ་མཆོག་ཙམ་དུ་གཉིས་ཀ་མེད་པར་བྱོས།",
    "ཁྱོད་ཀྱིས་ཡང་ནས་ཡང་དུ་བསམས་པས་མཐོང་བ་གང་ཡང་མེད་དོ་ཀྱེ།",
    "སྣ་ཚོགས་པར་སྣང་རང་གི་ངོ་བོ་མ་སྐྱེས་ཕྱིར།",
    "གཉིས་དང་གཅིག་གི་དྲན་པས་དུ་མ་དག་དང་འབྲལ་བར་འགྱུར།",
    "གང་ཡང་བརྗོད་པར་བྱ་བའི་དངོས་པོ་གང་ཞིག་རང་གིས་སྟོང་པ་སྟེ།",
    "བྲལ་བ་འདི་ལས་གཞན་དུ་སོང་བར་མ་མཐོང་ངོ།",
    "བསྐལ་བ་བརྒྱར་ཡང་མཆོག་གི་དོན་མི་མཐོང་།",
    "ཤེས་རབ་མིག་གིས་ལོག་པ་ཚར་བཅད་ན།",
    "གཞན་གྱི་ལོག་པར་ལྟ་བ་རང་གི་དེ་རུ་གྲོལ།",
    "རྣལ་འབྱོར་འདི་ལ་བདག་གི་གནས་སུ་འདུག་པར་མ་མཐོང་ངོ།",
    "སྲིད་དང་མྱ་ངན་འདས་གྲོལ་ཉོན་མོངས་རྒྱ་མཚོ་སྐེམས་པར་འགྱུར།",
    "དེ་ལས་གཞན་དུ་རྟོག་པའི་བློ་ཅན་འདིས་ནི་རྒྱ་མཚོའི་ནང་གི་ནོར་བུ་རྙེད་མི་འགྱུར།",
    "མཚོན་ཆ་བྲལ་བའི་ཆོམ་རྐུན་དག་གིས་གསད་གཅད་མ་ཡིན་ནོ།",
    "གང་གིས་སྲིད་པའི་ཆུ་བོ་འདི་རྫུན་པར།",
    "ཡུལ་ཅན་གང་གིས་ཕྱོགས་དག་ཏུ།",
    "མཚན་མའི་རྟོག་པ་དག་གིས་གསུམ་དུ་ཟག་པར་འགྱུར།",
    "འདི་ལ་ཉོན་མོངས་ཤེས་བྱའི་སྒྲིབ་པ་ལ་སོགས་ཀུན།",
    "ཉོན་མོངས་ལྔ་ཡི་ཡུལ་དུ་ཐམས་ཅད་ཟག་པར་འགྱུར་བ་ཡིན།",
    "གང་གིས་ཁེངས་པས་མྱུར་དུ་འཐོབ་པར་འགྱུར།",
    "ཁྱོད་ཀྱིས་རྫོགས་པར་གྱུར་པས་ཐོབ་པ་མ་ཡིན་ནོ།",
    "ཚང་ཚིང་འདི་ལ་ཟ་བར་ནུས་པ་གང་གིས་ནི།",
    "འདི་ཀུན་གང་གིས་ཡིད་ལ་མ་བྱས་པར།",
    "ཆུ་བུར་གཅིག་གི་འབྱུང་འཇུག་ཚོད་ཙམ་ལ།",
    "ལུས་ཀྱི་རྣམ་འཕྲུལ་རང་བཞིན་རང་གིས་ཞིག།",
    "དྲན་མེད་བདག་པོ་རང་ཞིག་རང་གིས་དག།",
    "གང་གིས་གདོད་ནས་སེམས་མེད་རྟོགས་པ་ཡིས།",
    "རི་དྭགས་ཕྲ་མོ་ཐམས་ཅད་སྐྲག་གྱུར་ཀྱང་།",
    "ཀྱེ་ཧོ་མ་ཡེངས་སེམས་ཀྱིས་རང་གིས་རང་ལ་ལྟོས།",
    "རང་གི་དེ་ཉིད་རང་གིས་རྟོགས་གྱུར་ན།",
    "རྨི་ལམ་དག་གི་བདེ་དང་སྡུག་བསྔལ་ཀུན།",
