    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "འཕགས་པ་དག་དུ་དགོས་པ་གང་ལགས།",
    "རྔུཔར་གྱུར་པའོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཚོད་མ་དང་མཉམ་པར་མ་ཡིན་པ་དང་།",
    "བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་མི་བཟེད་པ་དང་།",
    "ཡང་འདོད་པའི་ཕྱིར་འབྲས་ཆན་གྱེས་ཚོད་མ་མི་དགབ་ཚོད་མས་འབྲས་ཆན་ཐུམི་དགབ་པ་དང་བཟའ་བ་དང་བཅའ་བའི་སྟེང་དུ་ལྡུང་བཟེད་མི་བཟུང་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དེ་ལ་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ལེགས་པར་ཟས་གེབླང་བར་བསླབ་པར་བྱ་ཞེས་བྱ་བ་ནི་གྲོང་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་གཞན་དུ་ཡང་རུང་སྟེ།",
    "ལེགས་པར་ཟས་ཀྱི་བྱིན་ལེན་བླང་བར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ལེགས་པར་མི་ལེན་པ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ།",
    "འུམུ་དང་ཁ་ད་ཆད་དུ་མ་ཡིན་པར་ཟས་བླང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཁྱེད་ཅག་ནི་འདི་ལ་ལྷག་པར་ཆགས་པར་བྱས་ནས་ཡི་དྭགས་ལྦ་བ་ཅན་རྣམས་ཀྱི་ནང་དུ་སྐྱེ་བར་འགྱུར་རོ་ཞེས་ཟེར་བའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་མུ་དང་ཁ་ད་ཆད་དུ་མ་ཡིན་པར་ཁས་བླང་བར་བབེེབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཅི་ནས་ཀྱང་མུ་དང་ཁ་ད་ཆད་ཁུ་དུ་གང་བར་འགྱུར་བ་དེ་ལྟར་མ་ཡིན་པར་ཁ་ཟས་བླང་བར་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་བླང་བར་བསླབ་པར་བྱའོ།",
    "དེ་ལ་འདིར་དངོས་གཞིའི་རྩང་བ་རྣམ་པར་གཞག་པ་ནི་དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་ཉུ་༡་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྤྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཚོད་མ་དང་མཉམ་པ་མ་ཡིན་པར་ཟས་བླང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཚོད་མ་དང་མཉམ་པ་མ་ཡིན་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་ཚོད་མ་དང་མཉམ་པར་ཟས་ལེན་ང་།",
    "འབྲུས་པར་དགོས་པའི་ཚད་ལས་མ་ལྷག་པར་དེ་ལྟར་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱ་བའོ།",
    "དེ་ལ་འདིར་དངོས་གཞིའི་ལྷང་བ་རྣམ་པར་གཞག་པ་ནི་དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཚོད་མ་དང་མཉམ་པར་ལེན་པ་དང་ཟས་ཉིད་དོ།",
    "སྤྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "མཐར་ཆགས་སུ་ཟས་བླང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་མཐར་ཆགས་སུ་ཟས་བླང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱ་བའོ།",
    "དེ་ལ་འདིར་དངོས་གཞིའི་རྩང་བ་རྣམ་པར་གཞག་པ་ནི་དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་མཐར་ཆགས་མ་ཡིན་པར་ལེན་པ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ཞུན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལྷུང་བཟེད་ལ་བལྟ་ཞིང་ཟས་བླང་བར་བབེེབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལྷུང་བཟེད་ལ་བལྟ་ཞིང་ཟས་བླང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ལྷུང་བཟེད་ལ་བལྟ་བ་ཞེས་བྱ་བ་ནི་སྣོད་དུ་ཤེས་པར་བྱ་ཞིང་བླང་བ་སྟེ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "བཅའ་བ་དང་བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་མི་བཟེད་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བབེེབས་པར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་བཅའ་བ་དང་བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་མི་བཟེད་པར་སྤུབསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་བཅའ་བ་དང་བཟའ་བ་མ་འོངས་སྐྱེཔར་ལྷུང་བཟེད་བཟེད་པའོ།",
    "དེ་ལ་བཟའ་རྨྱེབ་དང་བཅའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་མི་བཟེད་པར་ཉུཆེཞེས་བྱ་བ་ནི་ཇི་སྲིད་དུ་བཟའ་བ་དང་བཅའ་བ་མངོན་སུམ་དུ་མ་འོངས་པ་དེ་སྲིད་དུ་ལྷུང་བཟེད་མི་བཟེད་པ་དེ་ལྟར་ལེགས་པར་ཟས་བླང་བར་སྐྱེབབེེབ་པར་བྱ་བའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་བཅའ་བ་དང་བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་བཟེད་པ་དང་ཟས་ཉིད་དོ།་།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་བྱེསྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཡང་འདོད་པའི་ཕྱིར་འབྲས་ཆན་གྱིས་ཚོད་མ་མི་དགབ་ཚོད་མས་འབྲས་ཆན་མི་དགབ་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཚེ་དང་ལྡན་པ་དག་ཁྱིམ་བདག་སྔ་མ་དེས་འབྲས་ཆན་དུབཟང་པོ་བྱས་ན་འདི་ལྟར་ཚོད་མ་ཉུང་ངོ།",
    "ཁྱིམ་བདག་ཕྱི་མ་དེས་ཚོད་མ་བཟང་པོ་བྱས་ན་འདི་ལྟར་འབྲས་ཆན་ཉུང་ངོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཡང་འདོད་པའི་ཕྱིར་འབྲས་ཆན་གྱིས་ཚོད་མ་ལ་མི་དགབ་ཚོད་མས་འབྲས་ཆན་མི་དགབ་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ཡང་འདོད་པའི་ཕྱིར་འབྲས་ཆན་རྨིས་ཚོད་མ་མི་དགབ་སྤུཚོད་མས་འབྲས་ཆན་མི་དགབ་པར་ཉུ་ཞེས་བྱ་བ་ནི་ཡང་ཐོབ་པར་བྱའོ་སྙམ་པའི་བསམ་ཏུ་༡པས་འབྲས་ཆན་གྱིས་ཤཱཤཱཚོད་མ་མི་དགབ་ཚོད་མས་འབྲས་ཆན་མི་དགབ་པ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རྔུརིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་མཛད་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་པར་གྱུར་པའོ།",
    "ཁྱེམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་བཅའ་བ་དང་བཟའ་བའི་སྟེང་དུ་ལྷུང་བཟེད་མི་གཟུང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་བཅའ་བ་དང་བཟའ་བའི་སྟེང་དུ་ལྷུང་བཟེད་མི་གཟུང་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི་བཅའ་བ་དང་བཟའ་བའི་སྟེང་དུ་ལྷུང་བཟེད་གཟུང་བར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱའོ།",
    "དེ་ལ་འདིར་དངོས་གཞིའི་རྩང་བ་རྣམ་པར་གཞག་པ་ནི་དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལེགས་པར་ཟས་བླང་བར་བསླབ་པར་བྱ་ཞེས་བྱ་བ་མན་ཆད་འདི་ཡན་ཆད་ཐམས་ཅད་ནི་གྲོང་དང་གཙུག་ལག་ཁང་ལ་སོགས་པའི་གནས་སྐབས་ཐམས་ཅད་དུ་ལེགས་པར་ཧཱུཾཟས་བླང་བར་བསླབ་པར་བྱ་བའི་སྤྲོས་པ་ཡིན་པར་སྦྱར་རོ།",
    "ཟས་ལ་ལེགས་པར་བྱ་བ་དྲུག།",
    "ཞེས་གསུངས་པ་ལ།",
    "ཟས་ལ་ལེགས་པར་བྱ་བ་དྲུག།",
    "ཁམ་མ་གཟས་པར་ཁ་མི་གདང་བ་དང་།",
    "ཁ་ཁམ་གྱིས་བཀང་སྟེ་མི་སྨྲ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དེ་ལ་ལེགས་པར་ཟས་བཟའ་བར་ཆབྱ་བའི་གླེང་གཞི་ནི།",
    "འཕགས་པ་དག་བྱིས་པ་ཁྱེའུ་དག་དང་གཟུགས་འཚོང་མ་དག་འདི་ལྟར་འཚལ་བར་རྔུབགྱིད་པས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་གེཀྱིས་འདི་ལྟར་མ་གསོལ་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་པར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ལེགས་པར་ཟས་བཟའ་༥བར་བསླབ་པར་བྱ་ཞེས་བྱ་བ་ནི་གྲོང་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱིས་༦གཞན་དུ་ཡང་རུང་སྟེ།",
    "ཁམ་ཧ་ཅང་ཆུང་བ་ལ་སོགས་པའི་རྣམ་པར་འགྱུར་བ་དག་མི་བྱ་བར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ལེགས་པར་མི་བཟའ་པེབ་དང་བྱེད་ཟས་ཉིད་དོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཁམ་ཧ་ཅང་ཆུང་བ་ཡང་བྱེམ་ཡིན་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་པར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ཁམ་ཧ་ཅང་ཆུང་བ་མ་ཡིན་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ཁམ་ཧ་ཅང་ཆུང་བ་མ་ཡིན་པ་ཞེས་བྱ་བ་ལ་ཁམ་ཞེས་བྱ་བ་ནི་ཁར་ཁམ་ཚད་དུ་གཞུག་རྔུ་ཅིང་མིད་པར་བྱ་བའི་ཕྱིར་ཁམ་ཞེས་པའོ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཁམ་ཧ་ཅང་ཆེན་པོ་མ་ཡིན་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "འཕགས་པ་དག་བྱིས་པ་ཁྱེའུ་དག་དང་མུ་ཕྱཏོ་བ་དག་འདི་ལྟར་འཚལ་བས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་གསོལ་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་པར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ཁམ་ཧ་ཅང་ཆེན་པོ་མ་ཡིན་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ཁམ་ཧ་ཅང་ཆེན་པོར་མ་ཡིན་པར་ཞེས་བྱ་བ་ནི་ཁམ་ཧ་ཅང་ཆེན་པོར་ཡང་མ་ཡིན་པ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བབེེབ་པར་བྱའོ།",
    "རྔུཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "འུ་ཁམ་རན་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "འཕགས་པ་དག་བྱིས་པ་ཁྱེའུ་དག་དང་མུ་ཏོ་བ་དག་འདི་ལྟར་འཚལ་བས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་གསོལ་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བབེེབས་པར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ཁམ་རན་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ཁམ་རན་པར་ཞེས་བྱ་བ་ནི་རང་དང་མཐུན་པ་དང་འཇིག་རྟེན་དང་མཐུན་པའི་ཁམ་རན་པ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཀྱེ་ཁམ་མ་གཟས་པར་ཁ་མི་གདང་བར་བྱེ་བབེེབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཁམ་མ་གཟས་པར་ཁ་མི་གདང་བར་དུ།",
    "བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་ཁམ་མ་གཟས་པར་ཁ་གདངས་པའོ།",
    "དེ་ལ་ཁམ་མ་གཟས་པར་ཞེས་བྱ་བ་ནི་ཇི་སྲིད་དུ་ཁམ་ཁའི་སྒོར་ཉེ་བར་མ་འོང་བར་དེ་སྲིད་དུ་ཁའི་སྒོ་གདང་བར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁམ་མ་གཟས་པར་ཁ་གདངས་པ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཁ་ཁམ་གྱིས་བཀང་སྟེ་མི་སྨྲ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཁ་ཁམ་གྱིས་བཀང་སྟེ་མི་སྨྲ་བར་བབེེབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་ཟ་བར་བབེེབ་པར་བྱ་བའོཀྱེ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལྕེ་ཕྱུང་སྟེ་ཟས་མི་ཟ་བར་བསྦབ་པར་བྱའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དེ་ལ་ཙུག་ཙུག་མི་བྱ་བར་ཟས་བཟའ་བར་བབེེབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཙུག་ཙུག་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ཙུག་ཙུག་མི་བྱ་བར་བསླབ་པར་བྱ་བ་ནི་ཙུག་ཙུག་ལྡུཟེར་ཞིང་ཟ་བར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བབེེབ་པར་བྱ་བའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁའི་རྣམ་པར་འགྱུར་བའི་སྒྲ་ཙུག་ཙུག་ཟེར་བ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "བལྕག་བལྕག་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་བལྕག་བལྕག་༢མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁའི་རྣམ་པར་འགྱུར་བའི་སྒྲ་བལྕག་བལྕག་ཟེར་བ་དང་ཟས་ཉིད་དོ།",
    "སྤྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཧཱུཾཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཧུ་ཧུ་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོཀྱེ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁའི་རྣམ་པར་འགྱུར་བའི་སྒྲ་ཧུ་ཧུ་ཟེར་བ་དང་ཟས་ཉིད་དོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་ཧཱུཾབཞིན་ནོ།",
    "ཕུ་ཕུ་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ཡུ་ཕུ་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་འུཔར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།་",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བབེེབ་པར་བྱ་བའོསྐྱོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ཁའི་རྣམ་པར་འགྱུར་བའི་སྒྲ་ཕུ་ཕུ་ཟེར་བ་དང་ཟས་ཉིད་དོ།",
    "སྤྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལྕེ་ཕྱུང་སྟེ་ཟས་མི་ཟ་ཛུབར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཚེ་དང་ལྡན་པ་དག་མ་བཅས་པར་མིད་ན་མི་རུང་བས་དེ་ལྟའོ།",
    "དེ་དག་སྨོད་པར་བྱེད་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལྕེ་ཕྱུང་སྟེ་ཟས་མི་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་ལྕེ་ཕྱུང་སྟེ་ཟས་ཟ་བའོདེ་ལ་ལྕེ་ཕྱུང་སྟེ་ཟས་མི་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ཟན་ཟ་བ་ན་ལྕེ་ཕྱུང་སྟེ་ཟ་བར་མི་བྱ་བར་ཁྱེ་བྱ་བ་སྟེ་དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ།་།",
    "དེ་ལ་འདིར་དངོས་གཞིའི་ལྡུང་བ་རྣམ་པར་གཞག་པ་ནི་དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་ཁྱེ་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཁམ་འཕྲོ་རྔུམི་བཅད་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དེ་ལ་འབྲུ་ནས་ཐ་དད་དུ་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "རྒྱན་པོ་པ་དག་དང་ནལ་ཀྱི་བུ་དག་འདི་ལྟར་འཚལ་བས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་གསོལ་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཁྱེམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་འབྲུ་ནས་ཐ་དད་དུ་མི་བྱ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ་ཐུཞེས་བཅའ་བ་མཛད་དེ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "འཕྱས་མི་གདགས་པར་ཟས་བཟའ་བ་བབེེབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་འཕྱས་མི་གདགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོདཱ།",
    "ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཉུ་མཁུར་བ་མི་སྤོ་བར་ཟས་བཟའ་བར་བབེེབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "འཕགས་པ་དག་བྱིས་པ་ཁྱེའུ་དག་དང་མུ་ཏོ་བ་དག་འདི་ལྟར་འཚལ་བས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་གསོལ་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་ཁྲུཔར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་མཁུར་བ་མི་སྤོ་བར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ།",
    "དེ་ལ་འདིར་དངོས་གཞིའི་བེེང་བ་རྣམ་པར་གཞག་པ་ནི་དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "རྐན་མི་གཏོགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "མུ་ཏོ་བ་དག་འདི་ལྟར་འཚལ་བས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་མཛད་ཅིག།",
    "འཕགས་པ་དག་འདི་ལ་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་པར་གྱུར་པའོ།",
    "ཁྱེམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་རྐན་མི་གཏོགས་༢བར་ཟས་བཟའ་བར་བསྦབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ།",
    "དེ་ལ་འདིར་དངོས་གཞིའི་བེེང་བ་རྣམ་པར་གཞག་པ་ནི་དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་ཀྱེསྣདངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "སྙེཁམ་འཕྲོར་མི་བཅད་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱེ་བྱ་བའི་གླེང་གཞི་ནི།",
    "འཕགས་པ་དག་བྱིས་པ་ཁྱེའུ་དག་དང་གཟུགས་འཚོང་མ་དག་འདི་ལྟར་འཚལ་བས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་གསོལ་ཅིག།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་བྱེཔར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ཁམ་འཕྲོར་མི་གཅོད་༡་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ཁམ་འཕྲོར་མི་བཅད་པར་ཟས་ཟ་ཧུ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ཁམ་འཕྲོར་བཅད་ཅིང་ཟན་བཟའ་ཧཱུཾ་བར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ།",
    "སྤྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "དེ་ལ་ལག་པ་མི་བལྡག་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དེ་དག་སྨོད་པར་བྱེད་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལག་པ་མི་བལྡག་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ལག་པ་མི་བལྡག་པ་ཞེས་བྱ་བ་ནི་ཟས་གང་ལ་ལག་པ་བལྡག་པ་ཡོད་པ་ནི་མི་བལྡག་པ་སྟེ་དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོཀྱེ།",
    "སྤྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཀྱེ་ལྷུང་བཟེད་མི་བྱོག་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དེ་དག་སྨོད་པར་བྱེད་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལྷུང་བཟེད་མི་བྱོག་པར་ཟས་བཟའ་བར་བབེེབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བབེེབ་པར་བྱ་བའོ།་།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་། ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཞུ་ལག་པ་མི་སྤྲུག་པར་ཟས་བཟའ་བར་བབེེབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལག་པ་མི་སྤྲུག་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ལག་པ་མི་སྤྲུག་པ་ཞེས་བྱ་བ་ནི་ལག་པ་ལ་ཟས་ཆགས་པ་སྤྲུག་པར་མི་བྱ་བ་དང་།",
    "ཡང་ན་ལག་པ་ལ་ཟས་ཆགས་པ་ལྕེའི་སྟེང་དུ་སྤྲུག་པར་མི་བྱ་བ་སྟེ་དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ་༥།",
    "སྦྱོར་བ་དང་སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལྷུང་བཟེད་མི་བསྐྱམ་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལྷུང་བཟེད་མི་བསྐྱམ་ཁྱེཔར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ལྷུང་བཟེད་མི་བསྐྱམ་ཏེ་པ་ཞེས་བྱ་བ་ནི་ལྷུང་བཟེད་ཀྱི་ནང་དུ་ཟས་ལ་སོགས་པ་བླུགས་ཏེ་བསྐྱམ་པར་མི་བྱ་བ་དང་།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཟས་མི་བཟའ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དགའ་བོ་ཉེ་དགའ་མཆོད་རྟེན་འདི་ནི་ངན་འགྲོ་རྫོགས་པར་བྱེད་པ་རྫོགས་བྱེད་ཀྱི་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ཡང་བཅོམ་སྟེ་ཟ་ཞིང་སྨྲས་པ་དགའ་བོ་ཉེ་དགའ་ངན་འགྲོ་སྡོགས་པར་བྱེད་པ་རྫོགས་བྱེད་ཀྱི་མཆོད་རྟེན་རྡིབ་བོ་ཞེས་ཟེར་བ་ལ་ཁྱེམ་བདག་དེས་ཐོས་ནས་དེས་སྨྲས་པ།",
    "དེ་ལྟར་ལེགས་པར་ཟས་བཟའ་བར་བབེེབ་པར་བྱའོ།",
    "དེ་ལ་འདིར་དངོས་གཞིའི་རྩང་བ་རྣམ་པར་གཞག་པ་ནི་དངོས་གཞིའི་གནས་སྐབས་སུ་བསླབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྤྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་མན་ཅད་འདི་ཡན་ཅད་ཐམས་ཅད་ནི་གྲོང་དང་གཙུག་ལག་ཁང་ལ་སོགས་པ་གནས་སྐབས་ཐམས་ཅད་དུ་ལེགས་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བ་དེའི་སྤྲོས་པ་ཡིན་པར་སྦྱར་རོ།",
    "ཞེས་གསུངས་པ་ལ།",
    "ལྷུང་བཟེད་ལ་འཕྱས་གདགས་པའི་ཕྱིར་མི་བལྟ་བུབར་བསླབ་པར་བྱ།",
    "ལག་པ་ཟས་དང་འབགས་པས་ཆུ་སྣོད་ལ་མི་གཟུང་བར་བསླབ་པར་བྱ།",
    "དེ་ལྟར་འཕྱས་སྨོད་ཀྱི་ཉེས་པྱརྩོམ་མི་བྱ་བར་རྔུ་བསླབ་པར་བྱ་བའོ།",
    "དེ་ལ་འདིར་དངོས་གཞིའི་ང་བ་རྣམ་པར་གཞག་པ་ནི་དངོས་གཞིའི་གནས་སྐབས་སུ་བབེེབ་པ་དེ་ལྟར་མ་བྱས་ན་བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་དངོས་གཞིར་འགྱུར་རོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལག་པ་ཟས་དང་འབགས་པས་ཆུ་སྣོད་ལ་མི་གཟུང་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "གཙང་སྦྲ་མེད་པ་ཡིན་ནོ་ཞེས་ཅོ་འདྲི་བར་བྱེད་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་ལག་པ་ཟས་དང་འབགས་པས་ཆུ་སྣོད་ལ་མི་གཟུང་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟར་གཙང་སྦྲ་མེད་པའི་ཉེས་རྩོམ་མི་བྱ་བར་བསླབ་པར་བྱ་བའོ།"
  ]
}