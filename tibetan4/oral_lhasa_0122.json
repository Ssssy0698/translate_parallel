    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "རྔུ་མི་བརྐྱང་བར་ཁྱིམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཤ་ཟས་བརླམས་པ་དག་འདི་ལྟར་བགྱིད་པས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་བཞུད་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་པར་གྱུར་པའོ།",
    "ཁྱེམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་རྨྱེནས་སྔ་མ་བཞིན་དུ་མི་བརྐྱང་བར་ཁྱེམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟ་བུས་ཤིན་ཏུ་བསྡམས་ཤིང་ཁྱིམ་གཞན་དུ་འགྲོ་བར་བསླབ་ལྕེཔར་བྱའོ།",
    "སྤྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བར་༤ཡང་སྔ་མ་བཞིན་ནོ།",
    "༥ཙོག་པུས་མ་ཡིན་པར་༦ཁྱེམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བྱིས་པ་ཁྱེའུ་དག་འདི་ལྟར་བགྱིད་པས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་མཛད་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་པར་གྱུར་པའོ།",
    "ཁྱེམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ཙོག་པུས་མ་ཡིན་པར་ཁྱེམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟ་བུས་ཤིན་ཏུ་བསྡམས་ཤིང་ཁྱིམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱ་བའོ།",
    "སྤྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "བྲང་བས་མ་ཡིན་པར་ཁྱིམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།་",
    "རྐང་མཐིལ་སྨས་པ་དག་འདི་ལྟར་བགྱིད་པས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་བཞུད་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་ལཔར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་བྲང་བས་མ་ཡིན་པར་ཁྱེམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱའོ་ཞེས་ཧཱུཾ་བཅའ་བ་མཛད་དེ།",
    "ཁྱེམ་གཞན་དུ་འགྲོ་བར་བབེེབ་པར་བྱའོ།",
    "བཤགས་པར་བྱ་བའི་ཉེས་བྱས་ཀྱི་ཙོསྣདངོས་གཞིར་འགྱུར་རོ།",
    "སྤྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "དཀུར་མི་བརྟེན་པར་ཁྱིམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དེད་དཔོན་དག་འདི་ལྟར་བགྱིད་པས་འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་བཞུད་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་པར་གྱུར་པའོ།",
    "ཁྱེམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་དཀུར་མི་བརྟེན་པར་ཁྱེམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལྟ་བུས་ཤིན་ཏུ་བསྡམས་ཤིང་ཁྱེམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱའོ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ཞེས་གསུངས་པའི་བསླབ་པ་བསྡུ་བའི་དོན་ནི་ལུས་མི་བསྒྱུར་བ་དང་།",
    "ལག་པ་མི་སྦྲེལ་བར་ཁྱེམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དེ་ལ་ལུས་མི་བསྒྱུར་བར་ཁྱེམ་གཞན་དུ་འགྲོ་བར་བབེེབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་བཞུད་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇེ་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་རྩེ་པར་གྱུར་པའོ།",
    "ཁྱིམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ལུས་མི་བསྒྱུར་བར་ཁྱིམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "འདི་ནི་བྱ་བའི་བྱེ་བྲག་ཡིན་པས་དེའི་ཕྱིར་ལུས་བསྒྱུར་བ་ཞེས་བྱ་བའི་བྱ་བ་དེ་མི་བྱ་བར་དེ་ལྟ་བུས་ཤིན་ཏུ་བསྡམས་ཤིང་ཁྱིམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱའོ།",
    "སྦྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
    "ལག་པ་མི་ཀྱོག་གྲུཔར་ཁྱིམ་གཞན་དུ་འགྲོ་བར་བབེེབ་པར་བྱ་བའི་གླེང་གཞི་ནི།་",
    "འདི་ནི་ཚུལ་དང་མཐུན་པ་མ་ལགས་ཀྱིས་འདི་ལྟར་མ་བཞུད་ཅིག།",
    "འཕགས་པ་དག་དགོས་པ་གང་ལགས།",
    "ཇི་དང་པོར་ཁྱེད་ཅག་ཉིད་མི་ཤེས་པ་དང་བྲལ་བ་དང་བསླབས་པར་གྱུར་པའོ།",
    "ཁྱེམ་པ་དག་ཟེར་བ་བདེན་ནོ་སྙམ་ནས་སྔ་མ་བཞིན་དུ་ལག་པ་མི་ཀྱོག་ཀྱེཔར་ཁྱེམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ལག་པ་ཀྱོག་་ཅིང་འགྲོ་བར་མི་བྱ་བ་དེ་ཐུལྟ་བུས་ཤིན་ཏུ་བསྡམས་ཤིང་ཁྱེམ་གཞན་དུ་འགྲོ་བར་བསླབ་པར་བྱའོ།",
    "སྤྱོར་བའི་སྤྱོར་བའི་སྒྲུབ་པ་ཉིད་དག་ལ་ནི་ཅི་རིགས་པར་ན་སྨད་དོ་ཞེས་བྱ་བ་ཡང་སྔ་མ་བཞིན་ནོ།",
