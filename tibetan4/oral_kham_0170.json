    "ཞེས་ཐིག་ལེ་རྡོ་རྗེའི་རྩ་བར་སླེབ་ཙ་ན།",
    "སླེབ་ཙ་ན་འདོད་ཆགས་ཀྱི་རྟོག་པ་བཞི་བཅུ་འགག་པ།",
    "འཇུག་དུས་དེར་སྣང་བའི་ཚོགས་དེ་དག་འདྲེས་ནས་སྨིག་རྒྱུ་ལ་འོད་ཟེར་ལྔའི་ཚོགས་དང་ལྡན་པར་མཐོང་།",
    "རྣལ་འབྱོར་མི་བསྐྱོད་རྡོ་རྗེས་གསུང་འབྲས་སྤུངས་དཔེ་རྙིང་ཟེར་བྲིས་ཡིག་འབྲུ་མི་གསལ་བ་ཁག་ཅིག་འདུག་པ་མཚོན་རྟགས་བཀོད་ཡོད།",
    "ཡིག་ནོར་མི་ཉུང་བ་འདུག་པས་ཅི་ནུས་བཅོས་ཡོད།",
    "ཐུགས་ཚིམས་ནས་བཞུགས་པའི་སྐབས་ཉ་མ་རྣམས་ཀྱིས་རས་ཆེན་ལས་རས་ཆུང་པ་ངོ་མཚར་ཆེ་ཞེས་བསྙེན་བཀུར་གོ་ལོག་ཏུ་བྱས་པས་སྡིག་གསོག་པར་འདུག་དགོངས་ཏེ།",
    "ཤེས་རབ་ཆེ་བར་འདུག་པས་ཀློག་འདྲ་སློབས་དང་ལས་སླ་བར་ཡོང་ཟེར།",
    "མི་གཞན་མང་པོ་ལུང་པའི་ཕུ་ན་ཡར་འགྲོ་ཞིང་འདུག།",
    "དེར་གཞན་རྣམས་ཀྱིས་ཀྱང་འབུལ་བ་བྱེད་ཅིང་འདུག།",
    "མ་ཁུས་རྩད་བཅད་པས་རྗེ་བཙུན་གྱི་དྲུང་ནུ་འདུག་ཅིང་།",
    "རྗེ་བཙུན་ལ་ཕུལ་བར་ཤེས་ནས་མ་ཁུས་ཇི་ལྟར་བཀག་རུང་མ་ཁེགས་པས་ཁོང་རང་གཉིས་ཁྲོས་ནས་ཤིན་ཏུ་སྡང་ཞིང་སྡུག་པར་བཅོལ།",
    "ཞོ་ཆང་ཉེས་པ་བསྲུང་ན་སྣོད་དུ་ལག་པ་བཅུག་པས་ཐུབ་པ་ཞིག་བས་འདུག།",
    "དེར་ཨ་ཙ་ཨཁ་རའི་དཔོན་དེས་བོད་སྐད་བྱུང་བར་ཤེས་ཤིང་འདུག་པས།",
    "བོད་ནས་རྒྱ་གར་དུ་སླེབ་པ་ལ་བདེ་བ་དང་ས་ཏ་གཉིས་རིང་ཟེར་བར་འདུག་ཟེར།",
    "ནགས་དེའི་ནང་ན་ནགས་མུན་པའི་པདྨ་བྱ་བ་ཞིག་འདུག་སྟེ།",
    "ནགས་དེའི་འོག་ནས་སྟག་དང་སེང་གེ་འཛིང་དུ་འཆའ་བ་གཉིས་འདུག་པ་དེའི་བར་ན་འགྲོ་དགོས་པ་ལ་འཇིགས་ཤིང་བྱེད་པས།",
    "སྤོས་ཕོར་མང་པོ་བཀྲམ་པ་ཞིག་འདུག་པའི་ནང་དུ་ཕྱིན་པས།",
    "གྲེད་དེ་འགྲོས་བསམ་འདུག་པ་དང་།",
    "བྱ་མང་པོས་ཕྱི་ནས་ཡར་འདེད་ཀྱིན་འགྲོ་འདུག་པས།",
    "ངོ་གདོང་ལ་བལྟས་པས་འཇམ་མུལ་ལེ་འདུག།",
    "རྐང་པ་ལ་ཕོལ་ཡོད་པ་རྣམས་ཀྱང་གཞི་མེད་དུ་དྲག་འདུག།",
    "ཤིན་ཏུ་ལུས་བདེ་བར་འདུག་པས་ཨ་ལི་དགའ་ན།",
    "སྔར་གྱི་འདག་སྦྱར་མ་བཤིགས་པར་བཞུགས་འདུག།",
    "བདག་ལ་བདེ་ཡས་ཡ་ལུགས་མང་བར་གདའ།",
    "རྣལ་འབྱོར་བདེ་བའི་ཚད་དུ་གདའ།",
    "ཡང་གོང་ལྟར་ཞུས་ཕྱིན་ཙ་ན།",
    "མི་དེ་ལ་སྦྲུལ་འཁྲིལ་ནས་འདུག་པ་བསལ་བས་དབུགས་ནར་གྱིས་བྱུང་།",
    "སྐྱེད་དུ་འཇུག་པ་མཛད་ཅིང་འདུག་པ་ལ།",
    "དེ་མིན་པའི་ཡོན་ཏན་མང་པོ་འདུག་པ་ལ།",
    "ང་རང་མཛེ་སོས་པས་ཆོག་སྙམ་ནས་ཞིབ་པར་མ་ཞུས།",
    "ང་རོ་ལངས་མིན་ང་རང་སོས་པ་ཡིན།",
    "ཁོ་མ་ཤི་བར་འདུག་ཟེར་མདུན་དུ་བྱུང་།",
    "རིམ་གྲོ་ལ་དུར་ཁྲོད་དུ་ཕྱིན་པར་འདུག་ཟེར།",
    "རྗེ་བཙུན་ཏེ་ལོ་པ་ཆེན་པོའི་བྱིན་གྱིས་བརླབས་པའི་བུར་འདུག་ཅིང་གསང་སྔགས་ཀྱི་བསྟན་པ་རྒྱ་བོད་གཉིས་སུ་རྒྱས་ཤིང་།",
    "ཉ་ཆུང་རང་ནས་གཙང་ཆབ་འགྲིམས།",
    "རྫུ་འཕྲུལ་ལ་ཡང་ཡིད་མི་ཆེས་པའི་སྟོན་པ་བློ་མ་ཚད་འདི་རྣམས་ཐ་སྙད་ཀྱི་ཚིག་དངོས་ལན་གྱིས་ཚར་གཅོད་དགོས་པ་འདུག།",
    "ཡང་ན་དྲག་པོ་མཐུ་ཡི་སྒོ་ནས་ཚར་གཅོད་དགོས་པ་འདུག་སྟེ་མཐུ་རྗེ་བཙུན་ལ་ཞུས་རུང་གསུང་གསུང་ཙམ་ཡིན་པ་འདྲ་མིན་ན་རྫུ་འཕྲུལ་ལ་མིག་འཕྲུལ་ཡིན་ཟེར་བ་འདི་རྣམས་ཚར་བཅད་ན་རུང་བ་འདུག་སྟེ་མི་མཛད་པ་འདུག།",
    "སྟོན་པ་འདི་རྣམས་ཚར་གཅོད་པ་ལ་རྒྱ་གར་ལ་ཕྱིན་རིག་པའམ་མཐུ་གང་རིགས་བསླབ་དགོས་པ་འདུག་སྙམ་ནས།",
    "ད་ན་སོ་རྒས་པ་དང་སེམས་ཀྱི་ཕུ་ཐག་ཆོད་པས་འགྲོ་བ་མི་ཡོང་བར་འདུག།",
    "གདམས་ངག་གཅིག་ཡོད་ང་རང་སྟེར།",
    "ཁྱི་སྟོན་དེ་དང་བོ་རི་དྭགས་བཤོར་བའི་ཁྱི་ར་བ་ཡིན་པར་འདུག་པས།",
    "དེར་ཁྱི་སྟོན་དཔོན་སློབ་སྲང་ཁ་ཞིག་ན་ལྟ་ཡིན་འདུག།",
    "སིང་ཀ་ལའི་ནགས་སུ་ཕྱིན་ཙ་ན།",
    "བལ་པོའི་མཐིལ་དུ་ཕྱིན་ཙ་ན།",
    "སྒོམ་བྱུང་ལྷན་སྐྱེས་གཉིས་ཀ་ཡོད་པའི་ཤེས་རབ་ཅན་ཞིག་འདུག་གསུང་།",
    "ང་རང་རས་ཆུང་རྡོ་རྗེ་གྲགས།",
    "གཞན་ཧེ་བཛྲ་ལ་སོགས་པ་ང་རང་ཤེས་ཏེ།",
    "བ་དེ་ཙན་དན་གྱི་ནགས་ན་ཙན་དན་སྡོང་པོ་གཅིག་ལ་འོ་མ་འཇོ་མཁན་མེད་པར་སི་རི་རི་གཏོར་བཞིན་འདུག།",
    "སྔར་ཡང་གཏོར་ནས་དྲག་པ་ཁ་ལེ་འདུག།",
    "ལྷ་སྐུ་དེའི་རྩར་སོ་སོ་སྐྱེ་བོ་ཞིག་བསྡད་ཀྱང་མི་རྟོག་པར་ཁྲིལ་ཁྲིལ་འགྲོ་ཞིང་འདུག་གསུང་།",
    "རས་ཆུང་བས་ང་རང་ཤི་ན་ཡང་མི་ཏོ་སྙམ་པ་ཚུན་ཐུབ་པར་འདོད་ཞུས་པས།",
    "པཎྜི་ཏ་བ་དེ་ལ་ཕྱག་བྱེད་ཅིང་འདུག་གོ།",
    "འཇའ་འོད་ཀྱི་གུར་ཕུབ་པའི་ནང་ན་ཡ་མཁའ་འགྲོ་མང་པོ་འདུག་པ་རྣམས་ཀྱིས་དབྱངས་འདི་སྐད་གསུངས་སོ།",
    "གཉིད་སད་པ་ལྟ་བུའི་ཉམས་སད་ཙ་ན།",
    "ཚིག་མ་ཟིན་པར་བློ་མི་བདེ་ཙ་ན།",
    "དེ་ལ་སོགས་པའི་རྫུ་འཕྲུལ་ནི་བརྗོད་ཀྱིས་མི་ལང་བ་འདུག་གསུང་།",
    "ལྟ་བ་བྱ་བ་ཅི་འདྲ་ཞིག་འདུག་གསུངས་པས།",
    "སྨྲ་བསམ་བརྗོད་དུ་མེད་པ་གཅིག་གདའ།",
    "དེ་འདྲའང་བྱེད་ཀྱི་གདའ་ཞུས་པས།",
    "དེ་ན་ཇོ་ཀི་དང་བསྒོམ་ཆེན་མང་པོ་བཞུགས་འདུག་པ་ལ།",
    "ལམ་དང་མདུན་གྱི་འགྲོ་འདུག་ལ།",
    "ལ་ལའི་ས་ན་མི་དད་པར་ཁྲོས་སྟངས་བྱེད་ཅིང་འདུག་པས།",
