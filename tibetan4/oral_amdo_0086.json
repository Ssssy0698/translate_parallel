    "གཞན་གྱི་དོན་ནི་སྤྱི་ཡིན་པས་དེའི་ཕྱིར་རང་གི་ངོ་བོ་ཞེས་བྱ་བ་སྨོས་ས་སོ།",
    "གྲངས་ཅན་པ་ལ་སོགས་པ་ན་རེ་ཚིག་ཏུ་སྨྲས་པ་ཁོ་ན་བསྒྲུབ་པར་བྱ་བ་ཡིན་གྱི་མ་སྨྲས་པ་ནི་མ་ཡིན་ནོ་ཞེས་ཟེར་ཞེས་༐",
    "དེ་དག་གིས་༧དམ་བཅའ་བ་ནི་སྒྲ་མཉན་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་དུ་དམ་བཅའ་བ་དེ་བཞིན་དུ།",
    "དངོས་པོ་ཐམས་ཅད་སྒྲ་༡༧བརྗོད་པར་བྱ་བ་ཉིད་དུ་རུང་བར་འདོད་པ་ཙམ་གྱི་རྗེས་སུ་བྱེད་པ་སྐྱེ་བོ་གནག་རྫི་མོ་༡༧ཡན་ཆད་ལ་གྲགས་པ་༐",
    "དེའི་ཕྱིར་རང་གི་ཚིག་དང་འགལ་བ་བརྗོད་དོ།",
    "གང་གི་ཕྱིར་སྐབས་བསམ་༢པ་དེ་གཏན་ལ་དབབ་པའི་ཕྱིཕྱིར།",
    "གཞན་དག་ན་རེ་རྫས་ཡིན་ཏེ།",
    "བྱེ་བྲག་པ་རྣམས་ན་རེ་སྟོན་པ་མ་ཡིན་པ་ནི་རབ་ཏུ་མ་གྲུབ་པ་དང་།",
    "རིགས་པ་ཅན་རྣམས་ན་རེ་གསོན་པོའི་ལུས་ནི་བདག་དང་བཅས་པ་ཡིན་ཏེ།",
    "བྱ་བ་ལ་ཡང་༧གང་གི་ཚེ་གཞན་ཞིག་གིས་བརྒལ་ཏེ།",
    "གསལ་བ་དག་ད་ང་དེ་དག་གི་སྟོང་པ་ཐམས་ཅད་ན་ཡོད་པའི་ཕྱིར་རོ་ཞེས་ཟེར་རོ།",
    "པེའི་ཐ་ར་ན་རེ་དེ་ནི་གསལ་བ་ཐམས་ཅད་ན་ཡོད་པ་ཡིན་གྱི་༢།",
    "བྱེ་བྲག་པ་ལ་སོགས་པ་ན་རེ།",
    "གསུམ་རིག་༡པའི་བྲམ་ཟེས་ནི་མི་འགའ་ཞིག་གིས་བརྗོད་༡༧པར་འདོད་པའི་ཚིག་གཟུང་བར་མི་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་བྲམ་ཟེ་རྣམས་ཀྱི་སྦྱོར་བ་ཡིན་ནོ།",
    "སྨྲ་བས་རྒོལ་༥བ་ཁྱོད་ཀྱི་གཏན་ཚིགས་འདི་ཅི་བསྒྲུབ་པར་བྱ་བ་དང་ཕྲད་ནས་སྒྲུབ་པར་བྱེད་དམ་འོན་ཏེ་མ་ཕྲད་ནས།",
    "རེ་ཞིག་མ་གྲུབ་པ་དང་ནི་མ་ཡིན་ཏེ།",
    "རི་བོང་གི་རྭ་བཞིན་མེད་པའི་ཕྱིར་ར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་གྲུབ་ཟིན་ན་ཡང་འདི་གང་གི་གཏན་ཚིགས་ཡིན་པར་འགྱུར།",
    "བསྒྲུབ་པར་བྱ་བ་ཡང་རི་བོང་གི་རྭ་བཞིན་དུ་ཤིན་ཏུ་མ་གྲུབ་པ་ཉིད་༩མ་ཡིན་ན་ནོ།",
    "ཁྱོད་ཀྱིས་སུན་འབྱིན་པ་ལ་ཡང་ཀླན་ཀ་འདི་ཐམས་ཅད་མཚུངས་པས་སུན་འབྱིན་པ་མ་ཡིན་པ་ཉིད་དོ།",
    "དེ་དག་གི་མཚན་ཉིད་ལོགས་ཤིག་ཏུ་བརྗོད་པར་མི་བྱ་སྟེ།",
    "༢༧༥ ༡པེ་སྣར་གིས་༢ཅོ་ུཏེ།",
    "གང་གིས་རིགས་པ་བཞི་མཁྱེན་ད་ང་།",
    "མངོན་སུམ་དག་གི་མཚན་ཉིད་ད་དང་།",
    "རང་གི་ངོ་བོ་རྣམ་པ་བཞི།",
    "རེ་རེ་ལ་ཡང་བཅོ་ལྔའོ།",
    "དེ་རྣམས་དག་གིས་འཇོམས་པར་བྱེད།",
    "རིགས་ཟིགས་དོན་བསྡུས་འདི་དག་ལ།",
    "གང་གི་ཕྱིར་འབྲེལ་པ་མེད་པ་དང་།",
    "འདི་བརྩམ་མོ་ཞེས་བྱ་བ་འདིས་ནི་ཤུགས་ཀྱིས་ན་རབ་ཏུ་བྱེད་པ་ཐབས་ཉིད་ཡིན་པར་བསྟན་ཏོ།",
    "འདི་ལྟར་རབ་ཏུ་བྱེད་པ་ནི་༡ཐོས་པ་ལས་རྗེས་སུ་དཔག་པའི་རང་གི་ངོ་བོ་ཕྱིན་ཅི་མ་ལོག་པར་ཤེས་པར་འགྱུར་བས་དེའི་ཕྱིར་རབ་ཏུ་བྱེད་པ་ནི་ཐབས་ཡིན་ལ།",
    "འདི་ལྟར་གང་ཞིག་དོན་དུ་གཉེར་བ་དེ་ནི་དེའི་ཐབས་ལ་འཇུག་ག་གི།",
    "དེ་ལྟ་བས་ན་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་རབ་ཏུ་བྱེད་པ་འདི་བརྩམ་མོ་ཞེས་བྱ་བར་གནས་ས་སོ།",
    "དེ་ནི་གང་དུའང་དགོས་པ་མེད་པས་བྱ་རོག་གི་སོ་བརྟག་པ་བཞིན་༥ནོ།",
    "དེས་ན་འདི་སྐད་དུ་གང་གི་ཕྱིཕྱིར་དོན་ལྐོག་ཏུ་གྱུར་པ་སྒྲུབ་པའི་རྟེན་རྗེས་སུ་དཔག་པ་ཡིན་༐",
    "རེ་ཞིག་འདི་ནི་བསྡུས་པའི་དོན་ཡིན་ན་ནོ།",
    "ཡན་ལག་གི་དོན་ནི།",
    "དོན་གྱི་སྒྲས་ནི་དོན་དུ་གཉེར་བར་བྱ་བ་མ་ཡིན་པ་རྣམ་པར་གཅོད་པར་བྱེད་པ་དེ་དག་གི་ལྟར་ན་ནི་དོར་བར་བྱ་བ་དང་།",
    "གང་གི་རྟེན་རྗེས་སུ་དཔག་པ་ཡིན་པ་དེ་ནི་རྟེན་རྗེས་སུ་དཔག་པའོ།",
    "དངོས་པོ་ནི་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ཙམ་དཔྱོད་པར་ཟད་ད་དེ།",
    "དེ་བྱེ་བྲག་ཏུ་རྟོགས་པ་ནི་སོ་སོར་ངེས་པའི་རང་གི་ངོ་བོ་ཡིད་ཆེས་པ་སྟེ།",
    "འདི་བརྩམ་མོ་ཞེས་བྱ་བ་ནི་བློ་ལ་རྣམ་པར་གནས་པ་སྟེ།",
    "བརྩམ་ཞེས་བྱ་བ་ནི་རབ་ཏུ་བྱེད་པའི་གཞུང་གི་བདག་ཉིད་དུ་བརྩམ་པར་བྱ་༐",
    "གང་གི་ཕྱིར་དོན་ལྐོག་ཏུ་གྱུར་པ་སྒྲུབ་པ་ལེན་པ་དང་འདོར་བ་དང་བཏང་སྙོམས་ཀྱི་མཚན་ཉིད་ཀྱི་རྒྱུ་ནི་རྗེས་སུ་དཔག་པ་ཡིན་པ་དེའི་ཕྱིར་རྗེས་སུ་དཔག་པའི་རང་གི་ངོ་བོ་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་རབ་ཏུ་བྱེད་པ་འདི་བརྩམ་མོ།",
    "དེ་ལ་གང་གི་ཆེ་རྗེས་སུ་དཔག་པ་རྗེས་སུ་དཔག་པར་བྱ་བའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ཡིན་པར་གཟུང་བ་དེའི་ཚེ་དེ་བྱེ་བྲག་ཏུ་རྟོགས་པ་ནི་ཚུལ་གསུམ་པའི་རྟགས་ལ་རག་༢ི་ལུས་པ་ཡིན་པས་ཚུལ་གསུམ་པའི་རྟགས་ཉིད་༐",
    "ཡན་ལག་གི་དོན་ནི་འབྲེལ་པ་ལས་བདག་ཉིད་ཀྱིས་སྟོན་པར་བྱེད་ད་དོ།",
    "མི་དམིགས་པའི་བྱེ་བྲག་གིས་རྣམ་པ་གསུམ་ཁོ་ན་ཡིན་ན་ནོ།",
    "དེའི་ཚེ་མིག་གིས་གཟུང་༨བ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་འགལ་བའི་གཞིས་མ་གྲུབ་པ་རྣམས་ཀྱང་རྒྱུ་ཉིད་དུ་བཀག་པ་ཡིན་ནོ།",
    "མི་མཐུན་པའི་ཕྱོགས་ལས་གཏན་ཚིགས་ལོག་པར་༤གྲུབ་མོད།",
    "རེ་ཞིག་དེ་ལྟར་འདོད་པའི་ངེས་པར་གཟུང་བ་བསྟན་པ་ཡིན་ན་ནོ།",
    "གང་གིས་ན་ལ་ལར་ནི་མ་འབྲེལ་བ་རྣམ་པར་བཅད་པས་ངེས་པར་གཟུང་བར་འདོད་ལ།",
    "དེ་ལྟ་བས་ན་ཆ་ཞེས་བྱ་བའི་སྒྲ་ཡན་ལག་གི་ཆིག་ཏུ་ག་ལ་འགྱུར་ཁྱབ་པའི་རང་གི་ངོ་བོ་བསྟན་པར་བཞེད་ན་ས།",
    "གཞལ་བྱ་ལ་སོགས་པ་ཐུན་མོང་བ་༢ཡང་གཏན་ཚིགས་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "ཐུན་མོང་ཡང་གཏན་ཚིགས་སུ་འགྱུར་ཏེ།",
    "རེ་ཞིག་དེ་ལྟར་ཁྱབ་པ་གཉི་གར་བསྟན་ཏོ།",
    "འམ་ཞེས་བྱ་བའི་སྒྲ་ནི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་ལས་གཅིག་གིས་ཀྱང་ཁྱབ་པ་ཡང་དག་པར་སྟོན་ནུས་པར་ཤེས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ངེས་པ་དག་གིས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་དེ་དག་ངེས་པའི་ཁྱབ་པ་ངེས་པ་ལ་རག་ལུས་པ་དེའི་ཕྱིར་གང་དུ་ཁྱབ་པ་བསྟན་པ་དེར་དེ་གཉིས་ངེས་པ་ཡང་འཕངས་པར་རིག་པར་བྱ་སྟེ།",
    "འདི་སྐད་དུ་ཁྱོད་ཀྱི་ལྟར་ན་ཡང་དུ་བའི་རྩ་བ་མེ་དང་འབྲེལ་པ་ཅན་གྱི་ཡན་ལག་གང་ཡིན་པ་དེ་ཉིད་མི་སྣང་བ་མ་ཡིན་ན་ནམ།",
    "དུ་བ་མེད་པ་ལ་སོགས་པའི་རང་གི་ངོ་བོ་དང་བྲལ་བའི་རང་གི་༢ིངོ་བོ་ཅན་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་བདག་ཉིད་དུ་ཞེས་བྱ་བ་ནི་དུ་བ་མེད་པ་དང་།",
    "མངོན་སུམ་གྱིས་མཐོང་བ་ལ་ཞེས་བྱ་བ་ནི་སྐྱེས་བུ་གང་གི་༥ངོ་བོ་དེ་ལྟ་བུ་མངོན་སུམ་དུ་མཐོང་བ་ཡིན་ཏེ།",
    "དེས་ན་འདི་སྐད་དུ་མངོན་སུམ་གྱིས་མདུན་ན་བླ་འོག་ཏུ་རྣམ་པར་གནས་པའི་དངོས་པོ་གཉིས་ཇི་ལྟར་གནས་པའི་རང་གི་ངོ་བོ་ཙམ་དེའི་རྣམ་པ་སྐྱེས་པས་༧ཤེས་ལ།",
    "དེའི་འོག་ཏུ་བླ་འོག་གི་དངོས་པོ་གཉིས་བྱ་རྟོགས་པར་བྱེད་པ་ན།",
    "བདག་ཉིད་ཀྱིས་ཀྱང་དེའི་རྣམ་པ་སྐྱེས་པས་དེའི་རང་གི་ངོ་བོ་ཡོངས་སུ་འཛིན་ན།",
    "དེ་ལ་དང་པོ་ཡུལ་ཐུན་མོང་མ་ཡིན་པ་མཐོང་བ་གང་ཡིན་པ་ཁོ་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དུ་བ་དང་བཅས་པའི་ཕྱོགས་དེ་ཐུན་མོང་མ་ཡན་པའི་ངོ་བོར་མཐོང་ནས་སོ།",
    "དེ་ལྟ་བུའི་ཕྱོགས་དེ་རྣམ་པ་གང་དང་གང་གིས་ཐུན་མོང་མ་ཡིན་པ་སྟེ།",
    "ཡང་ན་གཞན་གང་ཡང་རུང་བའི་རྣམ་པས་ཐུན་མོང་མ་ཡིན་པའོ།",
    "དེའི་ཐུན་མོང་མ་ཡིན་པ་ནི་དེའི་ཐུན་མོང་མ་ཡིན་པའོ།",
    "དེ་ལས་༤ཐ་དད་པ་ཞེས་བྱ་བ་འདིས་ནི་ཐུན་མོང་མ་ཡིན་པ་ཉིད་ཁོ་ན་སྟོན་ཏོ།",
    "སྔར་ཐུན་མོང་མ་ཡིན་པ་མཐོང་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "མངོན་སུམ་ཁོ་ནས་དུ་བ་དང་བཅས་པའི་ཕྱོགས་དེ་ཐུན་མོང་མ་ཡིན་པའི་ངོ་བོར་ཡོངས་སུ་བཟུང་བ་ཡིན་ལ།",
    "གྱི་གཟུང་༧བ་ཐུན་མོང་མ་ཡིན་པ་དེ་ཉིད་ལ་དེའི་ངོ་བོར་༨བརྗོད་པས་ཡང་མངོན་སུམ་༩དུ་བྱེད་པའི་སྔོན་མ་རྟོགས་པའི་དོན་རྟོགས་པར་བྱ་བ་མེད་པས་རྣམ་པར་རྟོག་༡པ་ནི་ཇི་ལྟར་ཡོངས་སུ་མཐོང་བའི་དོན་འཛིན་པར་བྱེད་པ་ཡིན་ཏེ།",
    "སྤྱི་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ནི་རང་གི་ལུགས་བརྗོད་པར་ཟད་དོ་སྙམ་དུ་སེམས་པར་འགྱུར་བས་དེའི་ཕྱིཕྱིར།",
    "ཡང་ན་འདི་ནི་འཇིག་རྟེན་པའི་ཚིག་གི་ལུགས་དང་མཐུན་པར་བརྗོད་པར་ཟད་༐",
    "དེའི་ཕྱིར་༩རང་གི་མཚན་ཉིད་རྟོགས་པའི་འོག་ཏུ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རང་གི་མཚན་ཉིད་རྟོགས་པ་ནི་མངོན་སུམ་གྱི་རྐྱེན་ནོ།",
    "སྔོན་པོའི་རང་གི་མཚན་ཉིད་དེ།",
    "སྔོན་པོའི་རང་གི་མཚན་ཉིད་ཀྱི་ངོ་བོ་གང་ཡིན་པ་དེ་ཁོ་ནས་སྔོན་པོས་བསྒྲུབ་པར་བྱ་བའི་དོན་གྱི་བྱ་བ་བྱེད།",
    "རང་གི་མཚན་ཉིད་དོ།",
    "དེ་ལ་འདི་སྙམ་དུ་སྔོན་པོའི་རང་གི་མཚན་ཉིད་མ་མཐོང་བ་དེ་ཉིད་རྣམ་པར་རྟོག་པས་ཤེས་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་པར་འགྱུར་བས་དེའི་ཕྱིར།",
    "སྔོན་པོའི་རང་གི་མཚན་ཉིད་དེ་ཡང་སྔོན་པོའི་དོན་བྱ་བ་བྱེད་པའི་བདག་ཉིད་དུ་མངོན་སུམ་ཁོ་ནས་མཐོང་ན་༢།",
    "དེ་ལ་འདི་སྙམ་དུ་སྡོན་པོའི་རང་གི་མཚན་ཉིད་ཀྱང་དོན་གྱི་བྱ་བ་བྱེད་ལ།",
    "དེའི་རང་གི་མཚན་ཉིད་གཟུང་བའི་འོག་ཏུ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རང་གི་མཚན་ཉིད་འཛིན་པ་ནི་མངོན་སུམ་གྱི་རྐྱེན་ན་ནོ།",
    "སྤྱི་རྟག་༢ིཔ་ཞིག་ཡིན་ན་ཡང་དངོས་པོའི་རང་གི་ངོ་བོ་མ་ཡིན་པའི་ཕྱིར་དོན་བྱེད་ནུས་པ་མ་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་མ་རྟོགས་པ་ཞེས་ཁྱད་པར་དུ་བྱ་དགོས་ཏེ།",
    "མངོན་སུམ་གྱི་༢རང་གི་མཚན་ཉིད་རྟོགས་ནས་ཕྱིས་མངོན་སུམ་གྱི་མཐུ་ལས་སྐྱེ་བ་མངོན་སུམ་དང་མཐུན་པར་བྱེད་པའི་རྣམ་པར་རྟོག་༩པ་གང་ཡིན་པ་དེ་ནི།",
    "དེ་ཞེས་བྱ་བའི་སྒྲ་ནི་རང་གི་མཚན་ཉིད་རྟོགས་པ་དང་སྦྱར་ཏེ།",
    "དེ་ཞེས་བྱ་བའི་སྒྲ་ནི་རང་གི་མཚན་ཉིད་ལ་བྱ་སྟེ།",
    "གསལ་བར་མི་སྣང་བར་༡བརྒྱུད་པའི་སྒོ་ནས་རང་གི་མཚན་ཉིད་ཁོ་ན་དང་མཐུན་པར་བྱེད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བྱ་བའི་སྒོ་ནས་དེའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་འབྲས་བུའི་སྒོ་ནས་རྣམ་པར་རྟོག་༢པ་རང་གི་མཚན་ཉིད་ཀྱི་ཡུལ་ཅན་ཡིན་གྱི།",
    "དེ་དག་ཇི་ལྟར་རང་གི་མཚན་ཉིད་ཀྱི་ཡུལ་ཅན་དུ་འགྱུར།",
    "བྱ་བ་ནི་འདིར་རང་གི་མཚན་ཉིད་ལ་ལྷག་པར་ཞེན་པ་ཡིན་ཏེ།",
    "འདི་ལྟར་རང་གི་མཚན་ཉིད་གང་ཡིན་པ་དང་།",
    "གང་གི་ཚེ་བྱ་བའི་སྒོ་ནས་རང་གི་མཚན་ཉིད་ཀྱི་ཡུལ་ཅན་ཡིན་པ་དེའི་ཚེ།",
    "གང་གི་ཕྱིར་དོན་བྱེད་པ་དོན་དུ་གཉེར་བ་རྣམས་དོན་བྱེད་པར་རུང་བ་ལ་འཇུག་ལ།",
    "དེ་ལྟ་བས་ན་གང་གི་ཚེ་དངོས་པོ་དོན་བྱེད་པར་རུང་༐",
    "གང་གི་ཕྱིར་རང་གི་མཚན་ཉིད་གཟུང་༡༧བའི་སྟོབས་ཀྱིས་སྐྱེ་བའི་༐",
    "རྣམ་པར་རྟོག་པ་གང་ཡིན་པའི་༡༧རྣམ་པར་རྟག་༡༧པ་དེ་ལས་ཀྱང་རང་གི་མཚན་ཉིད་ཀྱི་༡༧ལྷག་པར་ཆགས་པས་དངོས་པོ་ཁོ་ན་ལ་འཇུག་ལ།",
    "དེ་ལྟ་ན་ནི་༡གང་གི་ཚེ་ཡུལ་གཅིག་ལ་མངོན་སུམ་རྒྱུན་ཆགས་སུ་འཇུག་པ་དེའི་ཚེ།",
    "འདི་དག་གིས་ཉེ་བར་སྦྱོར་བ་ཐ་མི་དད་པས་ཞེས་ཚིག་རྣམ་པར་སྦྱར་ར་རོ།",
    "༢ིསྐད་ཅིག་མའི་བྱེ་བྲག་གིས་བསྒྲུབ་པར་བྱ་བའི་དོན་དུ་འདོད་པ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "གང་གི་ཚེ་སྐད་ཅིག་མའི་བྱེ་བྲག་གིས་བསྒྲུབ་པར་བྱ་བའི་དོན་དུ་འདོད་པ་ཡིན་པ་དེའི་ཚེ་འདི་དག་གི་ཉེ་བར་སྦྱོར་བ་ཐ་དད་པ་ཁོ་ན་ཡིན་ནོ།",
    "རྣམ་པར་གྲོལ་བའི་ལམ་གྱིས་ཀྱང་ཉོན་མོངས་པ་སྐྱེ་བ་དང་ཤིན་ཏུ་འགལ་བའི་བརྟེན་པ་བསྐྱེད་པའི་ཕྱིར་ཉོན་མོངས་པ་སྤངས་པ་བརྟན་པར་བྱེད་དོ།",
    "འབྲས་བུ་ཐུན་མོང་བ་ལ་ནི།",
    "གང་གི་ཚེ་སྐད་ཅིག་མ་ཐམས་ཅད་ཀྱི་འབྲས་བུ་ཐུན་མོང་ཡིན་པར་བརྗོད་པར་འདོད་པ་དེའི་ཚེ།",
    "དེ་དག་གི་མཐུ་ཐ་དད་པར་༤མེད་ད་དེ།",
    "གང་གི་ཚེ་དུ་བ་གཞན་དང་གཞན་གྱིས་མེ་ཉེ་བར་༦འཇལ་བར་བྱེད་པའི་ཚེ་མེ་ཙམ་གྱིས་བསྒྲུབ་པར་བྱ་བའི་དོན་བརྗོད་པར་འདོད་པ་ལ།",
    "དུ་བ་གཞན་དང་གཞན་དག་གིས་གཞལ་བ་ཞེས་བསྡུའོ།",
    "དེ་དག་གིས་ཞདུ་བ་གཞན་དང་གཞན་གྱིས་གཞལ་བ་ཡང་ཡིན་ལ་མེ་ཉེ་བ་ཡང་ཡིན་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "རེ་ཞིག་ཕྱོགས་ཙམ་ཞིག་བརྗོད་པར་བྱ་སྟེ།",
    "མངོན་སུམ་ནི་མདུན་ན་གནས་པའི་དངོས་པོ་རང་གི་ངོ་བོ་ཙམ་མཐུན་པར་བྱེད་པ་ན་སྐྱེ་ལ།",
    "དངོས་པོ་དེ་ནི་དངོས་སུ་ན་ཡོད་པའི་ངོ་བོས་སྔོན་པོའི་ངོ་བོ་གཅིག་པུ་དང་དེ་ལས་གཞན་པའི་དངོས་པོ་མཐའ་དག་ལས་ལོག་པའི་རང་གི་ངོ་བོ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དངོས་པོ་དེ་ཡོད་པའི་ངོ་བོས་སྔོན་པོ་ཡིན་པ་དེའི་ཕྱིར་འདིར་༨སྔོན་པོ་སྣང་བ་མངོན་སུམ་ལས་མ་སྐྱེས་པའི་ཕྱིར་མི་གསལ་བ་ཡིན་ཏེ།",
    "སྔར་མཐོང་བས་འཕངས་པའི་ཕྱིར་སྔོན་པོ་༩སྣང་བ་མ་བོར་ན་འདི་ནི་སྔོན་པོའོ་སྙམ་པ་ཡོད་པའི་ངོ་བོ་ལ་རེག་པའི་རྣམ་པར་རྟོག་པ་སྟེ་༡༧།",
    "གང་གི་ཕྱིར་སྔོན་པོ་དེ་དངོས་པོ་མ་ལུས་པ་དང་མཚན་ཉིད་མི་མཐུན་པ་དེ་ཁོ་ནའི་བྱ་ཕྱིར་སེར་པོ་ལ་སོགས་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་མངོན་སུམ་སྔོན་པོ་ལ་འཇུག་པ་ན་རེ་ཞིག་དེའི་རྣམ་པར་སྐྱེ་བས་བདག་ཉིད་ཀྱི་༡སྔོན་པོ་དེ་རྟོགས་པར་འགྱུར་ཏེ།",
    "རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ངེས་པའི་ཐབས་ཐ་དད་པའི་བྱེ་བྲག་གིས་བསྟན་པའི་ཕྱིཕྱིར།",
    "དམ་བཅས་པའི་ཕྱོགས་གཅིག་གིས་ཀྱང་གཏན་ཚིགས་མ་ཡིན་ན་ནོ།",
    "རང་གི་ངོ་བོ་རབ་ཏུ་བསྟན་པའི་ཐབས་ཀྱི་༢འབྲེལ་པ་གྲུབ་པའི་རྒྱུ་བསྟན་པའི་ཕྱིཕྱིར།",
    "གང་ཞིག་སྐད་ཅིག་མ་མ་ཡིན་པ་དེ་ནི་རིམ་དང་ཅིག་ཅར་ད་ག་གི་༡དོན་བྱེད་པར་མི་འཐད་དེ་ནི་འོག་ནས་སྟོན་པར་བྱེད་ད་དོ།",
    "གང་གི་ཕྱིར་གང་ན་དུ་བ་ཡོད་པ་དེ་ན་༦མེ་ཡོད་ཅེས་བྱ་བའི་རྗེས་སུ་འགྲོ་བ་གང་ཡིན་པ་དེ་རྒྱུ་དང་འབྲས་བུའི་ངོ་བོ་དོན་ཐ་དད་པ་ཡོད་ན་ནི་ཡོད་ལ།",
    "འདི་སྐད་དུ་འདི་གཉིས་དངོས་སུ་ཐ་དད་མོད།",
    "གང་གི་ཚེ་མེ་ཡོད་ན་དུ་བ་ཡོད་པ་ཉིད་ཀྱི་ཕྱིར་མེའི་འབྲས་བུ་ཉིད་དུ་འདོད་པ་དེའི་ཚེ།",
    "གང་གི་ཚེ་མེད་པའི་ཐ་སྙད་ནི་དམིགས་པའི་རིག་བྱར་གྱུར་པ་མི་དམིགས་པ་ཙམ་གྱི་རྒྱུ་ཅན་དུ་སྒྲུབ་པ་དེའི་ཚེ་མི་དམིགས་པའི་རྗེས་སུ་འགྲོ་བ་ངེས་པ་ཡིན་ནོ།",
    "གང་གི་ཚེ་ཡུལ་འགའ་ཞིག་ཉེ་བར་བསྟན་ནས་འདི་ན་མེད་དོ་ཞེས་མེད་པ་སྒྲུབ་པར་བྱེད་པ་དེའི་ཚེ་མི་དམིགས་པ་ཡུལ་བལྟར་རུང་བ་ཉིད་ལ་ལྟོས་༤པ་ཡིན་ནོ།",
    "གང་དུ་ཡུལ་ཉེ་བར་མ་བསྟན་པར་བསྒྲུབ་པར་བྱ་བ་མེད་ན་གཏན་ཚིགས་མེད་པར་སྟོན་པ་དེར་ནི་གང་གི་ཕྱིར་འབྲེལ་པ་ཙམ་ཞིག་གྲུབ་པས་བསྒྲུབ་པར་བྱ་བ་མེད་ན་གཏན་ཚིགས་མེད་པ་འགྲུབ་༡པ་དེའི་ཕྱིར་དེ་ལ་ནི་ལྡོག་པ་བསྒྲུབ་པར་བྱ་བ་ལ་མི་དམིགས་པ་ཡུལ་བལྟར་རུང་བ་ཉིད་ལ་ལྟོས་པ་མ་ཡིན་ན་ནོ།",
    "དེའི་ཕྱིར་གང་གིས་ན་དེ་ཉིད་༢གཅིག་ལ་གཅིག་བརྟེན་པ་ཉིད་ཀྱིས་ཉེས་པར་འགྱུར་བ་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ངེས་པ་དག་གཅིག་ལ་གཅིག་རག་ལས་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་ལྟར་འབྲས་བུ་དང་རང་བཞིན་དག་གི་ལྡོག་པ་བསྟན་ན་ནས།",
    "དེ་ལྟར་ན་གང་གི་ཚེ་མི་དམིགས་པ་མེད་པར་བསྟན་པ་དེའི་ཚེ་མི་དམིགས་པའི་ལྡོག་པ་ངེས་པ་ཡིན་ནོ།",
    "རང་རང་གི་མིང་གིས་གཏན་ཚིགས་གསུམ་སྟོན་པར་བྱེད་ད་དོ།",
    "རང་བཞིན་ནི་བདག་ཉིད་དང་རང་གི་ངོ་བོ་ཞེས་བྱ་བའི་ཐ་ཚིག་སྟེ།",
    "གང་གི་རང་བཞིན་ཡིན་ཞེ་ན།",
    "བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པ་དག་སེལ་བའི་བྱེ་བྲག་གིས་ཐ་དད་པ་ཁོ་ན་མ་ཡིན་ན་ནམ།",
    "གཏན་ཚིགས་བསྒྲུབ་པར་བྱ་བའི་རང་བཞིན་ཡིན་པར་ཁས་བླངས་ན་བསྒྲུབ་པར་བྱ་བའི་རྗེས་སུ་འགྲོ་བ་འཁྲུལ་པ་མེད་མོད་ཀྱི་འོན་ཀྱང་མཚན་ཉིད་བརྗོད་པར་བྱ་བ་ལ་གཞན་གྱི་ལུགས་༐",
    "དངོས་པོའི་རང་གི་རྒྱུ་དག་ལས་དོན་གཞན་པ་ནི་དོན་གཞན་ཏེ།",
    "གཞན་གྱི་བྱ་ཚིག་གི་གོ་སྐབས་ཀྱི་དོགས་པ་བསུ་བར།",
    "གཞལ་བྱ་རབ་ཏུ་བསྟན་པ་མེད་པར་གཞལ་བྱ་རྟོགས་པར་མི་འགྱུར་ན་ནི་དེའི་ཚེ་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པའི་ཚེ་ཡང་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "གང་གི་ཚེ་ཕྱོགས་ན་དུ་བ་ཉེ་བར་དམིགས་པ་ལ་དེ་ལ་ཡང་མེས་ཁྱབ་པར་དྲན་པ་དེའི་ཚེ་གཉི་གའི་མཐུ་ཁོ་ནས་ཕྱོགས་འདི་ན་༤མེ་ཡོད་དོ་ཞེས་དེ་ལྟར་རྟོགས།",
    "དེ་ལ་འདི་སྙམ་དུ་རེ་ཞིག་དང་པོ་ཁོ་ནར་གཞལ་བྱ་རྣམ་པར་གཞག་༢པར་བྱ་ལ།",
    "སློབ་དཔོན་ཕྱོགས་ཀྱི་གླང་པོའི་ལུགས་ཀྱི་རྗེས་སུ་འབྲང་བ་རྣམས་ཀྱི་ཚིག་གི་གོ་སྐབས་ཀྱི་དོགས་པ་བསུ་བར།",
    "རེ་ཞིག་བསྟན་པ་དེ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རེ་ཞིག་ཡུལ་༡༧བསྟན་པ་དེ་ཉིད་ཀྱིས་ཕན་པ་ཅི་ཞིག་ཡོད།",
    "གང་གིས་ན་ཡུལ་རབ་ཏུ་བསྟན་པའི་ཕྱིར་དམ་བཅའ་བ་སྨོས་པ་ལོག་པར་འགྱུར།",
    "གལ་ཏེ་ཡུལ་རབ་ཏུ་བསྟན་པ་མེད་པར་རྟོགས་པར་མི་འགྱུར་ན་ནི་དེའི་ཚེ་ཁྱོད་ཀྱིས་སྨྲས་པ་ཐམས་ཅད་ལེགས་པར་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་དམ་བཅའ་བ་སྨོས་པ་ཇི་ལྟར་ཡང་དགོས་པ་མེད་པའི་༦ཕྱིར་དམ་བཅའ་བ་སྨྲ་བ་འདི་གང་གི་ཚེ་བདག་ཉིད་རྟོགས་པར་བྱེད་པ་དེའི་ཚེ་དམ་བཅའ་བ་༐",
    "གང་གི་ཚེ་ཁོ་བོ་གཞལ་བྱ་རྟོགས་པར་བྱ་བར་རྩོམ་པ་དེའི་ཚེ་ནི་ཁོ་བོ་དེ་སྒྲུབ་པའི་༦དོན་དུ་གཉེར་བ་མཐོང་ནས་དམ་བཅའ་བ་སྨོས་པ་མེད་པར་ངས་མི་རྟོགས།",
    "ཚོང་པ་བཀྲེས་པ་ཤིན་ཏུ་དད་པ་ཅན་ཞིག་གིས་བྲམ་ཟེ་གཞན་ནི་མ་རྙེད་ཀྱི།",
    "གལ་ཏེ་མར་ཁུར་རེ་རེ་",
    "དེ་ལ་འདི་སྙམ་དུ་རང་གིས་རྟོགས་པ་ལ་ནི་རྟགས་ཀྱི་སྟོབས་ཀྱིས་གཞལ་བྱ་རྟོགས་ལ།",
    "གཞན་གྱི་༡ཁོང་དུ་ཆུད་པར་བྱེད་ན་ནི་ཚིག་གིས་རྟོགས་པར་འགྱུར་རོ་༢སྙམ་དུ་སེམས་ན།",
    "གཏན་ཚིགས་གཞན་གྱི་ཐབས་ཀྱིས་གཞན་གྱི་རྗེས་སུ་དཔག་པའི་༡༧རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པའི་ས་བོན་ཅན་ཉིད་ཡིན་པར་བསྟན་པའི་ཕྱིར།",
    "ཇི་ལྟར་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པའི་ཚེ་རང་ལ་ངེས་པ་སྐྱེས་པ་དེ་ཁོ་ན་བཞིན་གཞན་དག་ལ་ཡང་ཇི་ལྟར་ན་ངེས་པར་འགྱུར་སྙམ་ནས་གཏན་ཚིགས་རྗོད་ཞཔར་བྱེད་དོ་ཞེས་བྱ་བ་དེ་ནི་རིགས་པ་ཡིན་ནོ།",
    "གང་གི་ཚེ་ཕ་རོལ་པོ་གོ་བར་བྱེད་པ་དེའི་ཚེ་གཞལ་བྱའི་ཚིག་སྨོས་པར་བྱེད་པ་དེ་དོན་གྱི་རིམ་པ་སྔོན་མ་བྱུང་བ་ལ་བརྟེན་པ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ནི་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པའི་ས་བོན་ཅན་ཉིད་ཡིན་ལ།",
    "རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ཡང་དམ་བཅའ་བའི་སྦྱོར་བ་མེད་པ་དེའི་ཕྱིར་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ཡང་དམ་བཅའ་བ་སྨོས་པ་དགོས་པ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "རེ་ཞིག་སོམས་ཤིག་ཅེས་བྱ་བ་འདིས་ནི་གཏོད་པར་བྱེད་ད་དོ།",
    "དེ་ལ་ཕ་རོལ་པོའི་བསམ་པ་ནི་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་དང་པོར་ནི་༢ཕྱོགས་ན་དུ་བ་མཐོང་ངོ།",
    "འབྲེལ་པ་དྲན་པའི་མཇུག་ཐོགས་སུ་གང་གི་ཕྱོགས་ན་དུ་བ་ཡོད་པར་ཡང་སྣོན་པར་བྱེད་པ་འདི་དུ་བ་ནི་ཡོད་དོ་སྙམ་པ་དེ་ལྟ་བུ་སྣོན་པའི་ཤེས་པ་སྐྱེའོ།",
    "དེ་༤བས་ན་རང་གི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ཡང་ཉེ་བར་གཏོད་པའི་དོན་ཡོད་པའི་ཕྱིར་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ལ་ཡང་འདི་ཡན་ལག་གཞན་ཉིད་དུ་རིག་༥པ་ཁོ་ནའོ་སྙམ་པ་འདི་ཡིན་ནོ།",
    "མེ་དོན་དུ་གཉེར་བའི་རྟོགས་པ་པོ་གང་ཞིག་དང་པོ་ཁོ་ནར་དུ་བ་དང་མེ་དག་གིས་འབྲེལ་པ་སེམས་ལ་བཞག་ནས་མེ་གང་ན་ཡོད་ཅེས་མེ་ཚོལ་བར་བྱེད་པ་དེ་ལྟ་བུའི་རྟོག་༦པ་པོ་དེས་གལ་ཏེ་དུ་བ་མཐོང་ན་དེ་དུ་བ་མཐོང་བ་དང་པོ་ཁོ་ནས་འདི་ན་མེ་ཡོད་དོ་སྙམ་པའི་ཤེས་པ་སྐྱེའི་སྣོན་པའི་ཤེས་པ་གཉིས་པ་ལ་ནི་མི་ལྟོས་༧སོ།",
    "འོན་ཏེ་ཡང་རེས་འགའ་དགོས་པ་ཡོད་པས་སྒྲུབ་པའི་ཡན་ལག་ཉིད་དུ་འདོད་དོ་ཞེ་ན་༩།",
    "དེའི་ཚེ་ལག་པན་ལ་སོགས་པ་རེས་འགའ་དགོས་པ་རྣམས་ཀྱང་སྒྲུབ་པའི་ཡན་ལག་ཉད་ཡན་པར་བརྗོད་དགོས་ཏེ།",
    "གུར་གུམ་དང་ཙན་དན་དག་གིས་ལུས་བསྐྲུས་ཏེ་མཆུ་༐",
    "རྩི་དམར་པོས་༡༧མཛེས་པར་བྱས་མགོ་ལ་མེ་ཏོག་གི་ཐོད་བཅིངས་ནས་དུ་བ་མཐོང་སྟེ།",
    "མེ་ཤེས་པར་བྱེད་པའི་ལག་པ་ན་ལ་སོགས་པ་ཡང་བསྒྲུབ་པའི་ཡན་ལག་ཏུ་ཐལ་བར་འགྱུར་རོ་བྱ་སྙམ་པ་འདི་ཡིན་ནོ།",
    "སྦྱོར་བ་གཉིས་པོ་གང་གིས་འབྲེལ་པ་བརྗོད་པ་དེ་ནི་འབྲེལ་པ་སྨོས་པ་ཡིན་ན་ནོ།",
    "དེ་ལྟ་བས་ན་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་གི་༦ཞེས་བྱ་བ་ལ་སགས་པ་སྨོས་ཏེ།",
    "གཅིག་གིས་གཉིས་པའི་དོན་ཇི་ལྟར་སྟོན་པར་བྱེད་ཅེ་ན།",
    "གང་གི་ཚེ་བསྒྲུབ་པར་བྱ་བ་མེད་ན་གཏན་ཚིགས་གདོན་མི་ཟ་བར་མེད་པར་གྲུབ་པ་ཡིན་པ་དེའི་ཚེ་གཏན་ཚིགས་གདོན་མི་ཟ་བར་བསྒྲུབ་པར་བྱ་བའི་རྗེས་སུ་འགྲོའོ་ཞེས་བྱ་བ་འདི་ཡང་སྒྲུབ་༦པ་ཡིན་ཏེ།",
    "དེ་ལ་འདི་སྙམ་དུ་རྗེས་སུ་འགྲོ་བ་སྨོས་པ་ཁོ་ནས་ལྡོག་པ་སྒྲུབ་མོད།",
    "གང་གི་ཚེ་མཐུན་པའི་ཕྱོགས་མ་ཡིན་པས་མི་མཐུན་པའི་ཕྱོགས་ཞེས་བྱ་བ་དེའི་ཚེ་གཞན་དང་འགལ་བ་དག་ལ་ཡང་མི་མཐུན་པའི་ཕྱོགས་ཡོད་པ་ཁོ་ནའོ།",
    "མཐུན་པའི་ཕྱོགས་ལས་གཞན་པ་ལ་མི་མཐུན་པའི་ཕྱོགས་ཉིད་དུ་ཡོངས་སུ་བཟུང་༢ིན་གཏན་ཚིགས་ཆད་པར་ཐལ་བར་མི་འགྱུར་ཏེ།",
    "མཐུན་པའི་ཕྱོགས་དང་འགལ་བ་མི་མཐུན་པའི་ཕྱོགས་ཉིད་ཡིན་ན་ཡང་གལ་ཏེ་འགལ་བ་འབའ་ཞིག་ལས་རྣམ་པར་གཅོད་པར་བྱེད་ན་ནི་དེའི་ཚེ་མེ་ཡོད་པ་ལས་ནི་འདི་ན་དྲོ་བའི་རེག་པ་ཡོད་དོ་ཞེས་བྱ་བ་འདི་ལ་དྲོ་བ་ཡང་མ་ཡན་གྲང་བ་ཡང་མ་ཡིན་པ་ལས་རྣམ་པར་བཅད་པར་མི་༥འགྱུར་རོ།",
    "གང་གི་ཚེ་གཞན་ཡང་མི་མཐུན་པའི་ཕྱོགས་ཡིན་པ་ཉིད་ཀྱི་༦དྲོ་བ་ཡང་མ་ཡིན་གྲང་བ་ཡང་མ་ཡིན་པ་ལས་རྣམ་པར་བཅད་པར་སྒྲུབ་ཞཔ་དེའི་ཚེ་ཉེས་པ་འགའ་ཡང་མེད་དོ།",
    "དངོས་སུ་འབྲེལ་པ་སྒྲུབ་པར་བཞེད་ནས་གང་གི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་ཏུ་འགྱུར་བ་ཡོད་པ་གདོན་མི་ཟ་བར་འཇིག་པའི་རང་བཞིན་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ནི་༤ཇི་ལྟར་ཁོང་དུ་ཆུད་ཅེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "རྒྱུ་གང་གིས་ན་ཡོད་པ་སྐད་ཅིག་མ་ཉིད་ཡིན་པས་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་ཏུ་འགྱུར་བ་དངོས་པོ་ཡོད་པ་ནི་གདོན་མི་ཟ་བར་འཇིག་༥པར་འགྱུར་རོ་ཞེས་བྱ་བ་འདི་ཇི་ལྟར་ཁོང་དུ་ཆུད།",
    "འདི་ལྟར་དེ་དག་འཇིག་པའི་རྒྱུ་དང་ཕྲད་ནས་འཇིག་གི།",
    "༧འདི་ལྟར་འདི་དག་གི་འཇིག་པའི་རྒྱུ་དཔྱད་ན་ཇི་ལྟར་ཡང་མི་འཐད་ད་དོ།",
    "རེ་ཞིག་ཅི་ཤིང་ལ་སོགས་པ་མེ་ལ་སོགས་པས་བཤིག་སྟེ།",
    "དེའི་ཕྱིར་མི་སྣང་བ་ཞིག་ཡིན་ན་མ་འོན་ཏེ་རང་གི་དང་ཁོ་ན་༢ཞིག་ལ་རྒྱུའི་ཚོགས་པ་མཚན་ཉིད་མི་མཐུན་པ་དང་ཕྲད་པས་གཞན་དུ་བྱུང་སྟེ།",
    "དེའི་ཕྱིར་དངོས་པོ་རྣམས་ནི་རང་གི་ངོ་བོ་ཁོ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དངོས་པོ་རྣམས་ནི་རང་གི་ངོ་བོ་ཁོ་ནས་འཇིག་པའི་ངང་ཚུལ་ཅན་ཡིན་ཏེ།",
    "རང་གི་ངོ་བོ་གྲུབ་ཟིན་པ་འདི་དག་ཕྱིས་ཐོ་༢བ་ལ་སོགས་པ་གཞན་གྱི་༢འཇིག་པ་ནི་མ་ཡིན་ན་ནོ།",
    "འོན་ཏེ་དེ་ལས་གཞན་པ་གྱོ་མོ་ལ་སོགས་པའི་ངོ་བོ་ཞིག་བྱེད་དམ།",
    "འོན་ཏེ་དངོས་པོ་མེད་པ་ཞིག་བྱེད་ཅེས་བྱ་བ་བརྟག་པ་གསུམ་མ་མོ།",
    "རེ་ཞིག་འཇིག་པའི་རྒྱུས་གཞིག་པར་བྱ་བ་བུམ་པ་ལ་སོགས་པའི་༤རང་གི་ངོ་བོ་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
    "འཇི་བ་༦དང་དབྱུ་༧གུ་དང་འཁོར་ལོ་དང་སྐུད་པ་དང་ལག་ངར་དང་སོར་མོ་ད་ང་ཆུ་ལ་སོགས་པ་རང་གི་རྒྱུ་དག་ཉིད་ལས་གྲུབ་ཟིན་པ་ཁོ་ན་ཡིན་ན།",
    "དེ་ལ་འདི་སྙམ་དུ་ངོ་བོ་ཉིད་གཞན་གྱི་༢གྱོ་མོ་ལ་སོགས་པའི་ངོ་བོ་བྱས་པ་གང་ཡིན་པ་དེས་བུམ་པ་བསྒྲིབས་ཏེ།",
    "གལ་ཏེ་དེ་ལྟ་ཡིན་དུ་ཟིན་༧མོད་ཅེ་ན་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་མ་ཡིན་པའི་ངོ་བོ་མེད་པ་འབྲས་བུ་ཉིད་དུ་འདོད་ན་དེའི་ཚེ་མེད་པར་བྱེད་དོ་ཞེས་བྱ་བར་འདི་ལ་ཚིག་གི་དོན་ནི་དངོས་པོ་ལས་གཞན་པ་༩ཞིག་བྱེད་དོ་ཞེས་བྱ་བ་འདིར་འགྱུར་རོ།",
    "གལ་ཏེ་མེད་པར་དགག་པ་ལ་བརྟེན་ན་དེའི་ཚེ་ཚིག་གི་དོན་དངོས་པོ་མི་བྱེད་ཅེས་བྱ་བ་འདིར་འགྱུར་ཏེ།",
    "གལ་ཏེ་དངོས་པོ་རང་གི་ངོ་བོ་ཁོ་ནས་འཇིག་པ་ཡི་ན་ན་འཇིག་པའི་རྒྱུ་ཅི་ཞིག་དགོས།",
    "འདི་འཇིག་པའི་ངོ་བོ་ཡིན་པ་ཁོ་ནས་བདག་ཉིད་འཇིག་ན་རང་ཚིག་པ་དེ་ལ་མེ་ཅི་ཞིག་དགོས་དེ་ལ་འདི་སྙམ་དུ་འཇིག་པའི་རྒྱུ་དག་གིས་འདི་འཇིག་པའི་ངོ་བོ་ཉིད་བྱ་དུ་བྱེད་དོ་སྙམ་ན།",
    "གང་ཞིག་གང་གི་ངོ་བོ་ཉིད་ཡིན་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དངོས་པོ་གང་གི་༡རང་གི་ངོ་བོ་གང་ཡིན་པ་དེ་ནི་རང་གི་རྒྱུ་དག་ཁོ་ན་ལས་༢སྐྱེ་བར་འགྱུར་གྱི།",
    "དང་པོ་དངོས་པོ་སྐྱེ་ལ་ཕྱིས་རང་གི་ངོ་བོ་དེ་ལྟ་བུ་ཐོབ་པར་བྱ་བའི་ཕྱིར་རྒྱུ་གཞན་ལ་ལྟོས་༢ིཔ་ནི་མ་ཡིན་ནོ།",
    "གསལ་བ་ལ་སོགས་པའི་རང་གི་ངོ་བོ་ཉིད་དུ་བྱ་བའི་ཕྱིར་རང་གི་རྒྱུ་ལ་མ་གཏོགས་པ་རྒྱུ་གཞན་ལ་༐",
    "དེའི་བདག་ཉིད་ལ་དེའི་བདག་ཉིད་མེད་ན་བདག་ཉིད་མེད་པར་ཐལ་བར་འགྱུར་རོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "བ་མོའི་རེག་པ་ལ་ཁྱབ་པར་བྱེད་པ་དང་འགལ་བ་དྲོ་བའི་རེག་པ་བཞིན་ན་ནོ།",
    "ས་བོན་ལ་སོགས་པ་མྱུ་གུ་ལ་སོགས་པ་སྐྱེད་པའི་རང་བཞིན་ཡིན་མོད།",
    "འོན་ཀྱང་འབའ་ཞིག་གིས་རང་གི་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་གྱི་ཆུ་ལ་སོགས་པ་རྒྱུ་གཞན་ལ་ལྟོས་༨ས་སོ།",
    "སྐྱེ་བའི་༡༧ངོ་བོ་ཉིད་ཀྱི་རྒྱུ་གང་ཡིན་པ་དེ་ནི་རང་གི་འབྲས་བུ་བསྐྱེད་༡༧པ་ཁོ་ན་སྟེ།",
    "གང་གི་བྱ་ཕྱིར་དེ་ལྟར་སྐྱེད་པར་བྱེད་པ་ནི་འབྲས་བུ་སྐྱེད་པའི་ངོ་བོ་ཉིད་ཡིན་ལ།",
    "གལ་ཏེ་གནས་སྐབས་འདི་གཉིས་ངོ་བོ་ཉིད་ཐ་དད་པར་མ་གྱུར་ན་དེའི་ཚེ་དེའི་ངོ་བོ་ཉིད་གནས་སྐབས་ཐ་མ་བཞིན་དུ་སྡོན་གྱི་གནས་སྐབས་ན་ཡང་སྐྱེད་པར་བྱེད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "རྒྱུའི་རྒྱུ་ནི་རྒྱུའི་རྒྱུ་དག་ཡིན་ནོ་། དེ་ད་ག་གི་ངོ་བོ་ནི་དེ་དག་ཉིད་ད་དེ།",
    "དེ་དག་ལ་ཡང་སྐད་ཅིག་མ་གཞན་དང་གཞན་སྐྱེ་ན་དེ་དག་ལ་གཅིག་པ་ཉིད་ག་ལ་ཡོད་གཞན་གྱི་ཚིག་གི་གོ་སྐབས་ཀྱི་དོགས་པ་བསུ་བར།",
    "འདིར་ཡང་ཕ་རོལ་པོ་ཅི་སྟེ་སོ་སོར་འབྲས་བུ་རེ་རེ་སྐྱེད་པར་མི་བྱེད་ཅེས་དེ་སྙམ་དུ་སེམས་ཤིང་སྤྱིར་རྒལ་ཞིང་༐",
    "དེ་དག་གི་ཐ་མའི་གནས་སྐབས་འདི་ལ་གཞན་དུ་འགྱུར་བ་མེད་ད་དོ།",
    "འདི་ལྟར་འདི་དག་གི་འབྲས་བུ་བསྐྱེད་པའི་ངོ་བོ་ཉིད་གང་ཡིན་པ་དེ་ནམ་ཡང་བཟློག་པར་མི་འགྱུར་ཏེ།",
    "གཞན་རང་གི་བསམ་པ་སྒྲོགས་པའི་དོགས་པ་བསུ་བར།",
    "དེའི་ཕྱིར་དེ་ལ་གཞན་གྱི་ཉེ་བར་སྦྱོར་བ་ཅི་ཞིག་དག་དགོས་གང་གིས་ན་ལྷན་ཅིག་ཁོ་ནར་འབྲས་བུ་གཅིག་སྐྱེད་པར་བྱེད་པ་སོ་སོར་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཕྱོགས་སྔ་མའི་དོགས་པའོ།",
    "དངོས་པོ་རྣམས་ལ་ནི་གང་གིས་ན་འདི་གཅིག་པུས་ཀྱང་འབྲས་བུ་བསྐྱེད་པར་བྱ་བར་ནུས་ན་བདག་ཅག་ལྷག་པས་ཅི་ཞིག་བྱ་ཞེས་དེ་སྙམ་དུ་བརྟགས་ནས།",
    "གི་འདུ་༢བའི་རྒྱུ་ཡོངས་སུ་གྱུར་པ་ནི་རང་གི་རྒྱུར་ཡོངས་སུ་གྱུར་པའོ།",
    "གང་གི་ཕྱིར་འདི་དག་རྟོག་པ་སྔོན་དུ་གཏོང་བར་བྱེད་པ་ཅན་དག་མ་ཡིན་གྱི།",
    "གང་གི་ཕྱིར་དེ་ལྟར་འབྲས་བུ་གཅིག་བསྐྱེད་༢པར་ནུས་ཀྱི་གཞན་ནི་མ་ཡིན་པ་དེའི་ཕྱིར་གཞན་ད་ང་གཞན་སྐྱེད་པར་མི་བྱེད་ད་དོ།",
    "ཡང་གཞན་གྱི་ཚིག་གི་གོ་སྐབས་ཀྱི་དོགས་པ་བསུ་བར།",
    "གང་གི་ཚེ་མིག་ལ་སོགས་པ་ངོ་བོ་ཉིད་ཐ་དད་པ་རྣམས་འབྲས་བུ་གཅིག་༐",
    "གང་གི་ཕྱིར་ལྷན་ཅིག་བྱེད་པ་རྣམས་གང་གི་བདག་ཉིད་ཀྱི་ངོ་བོ་ཉིད་ཀྱི་བྱེ་བྲག་གང་ཡིན་པ་དེ་དག་ཉིད་ཇི་ལྟ་བའི་ངོ་བོ་ཉིད་ཀྱི་བྱེ་བྲག་དེས་འབྲས་བུ་ཁྱད་པར་དུ་བྱ་བ་ལ་ཉེ་བར་སྦྱར་༥བ་དེའི་ཕྱིར།",
    "དེའི་ཉེ་བར་སྦྱོར་བ་དག་གིས་བྱ་བའི་ཁྱད་པར་གང་དག་ཡིན་པ་དེ་དག་འཆོལ་བ་མེད་པའི་ཕྱིར་ཇི་སྐད་སྨྲས་པའི་ཉེས་པར་ཐལ་བར་འགྱུར་བ་མེད་དོ།",
    "དེ་དག་གི་ཉེ་བར་སྦྱོར་བ་ནི་དེའི་ཉེ་བར་སྦྱོར་བ་དག་སྟེ།",
    "དེ་དག་༧ཉེ་བར་སྦྱོར་བ་དག་གིས་བྱ་བ་ནི་དེའི་ཉེ་བར་སྦྱོར་བས་བྱ་བ་དག་ག་གོ།",
    "དེ་ལྟར་བྱེད་པའི་བྱེ་བྲག་གིས་༤ཡུལ་ཐ་དད་པ་ཉིད་དུ་བསྟན་ནས་མ་འཆོལ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཁན་དག་གི་བྱེད་པའི་བྱ་ིཡུལ་ཐ་དད་པའི་ཕྱིར་བུམ་པ་ངོ་བོ་ཉིད་གཉིས་སུ་ཐལ་བར་འགྱུར་༡སྙམ་དུ་སེམས་ན་དེའི་ཕྱིར།",
    "འཇིམ་པ་དང་རྫ་མཁན་དག་གི་༐",
    "ནུས་པའི་ཁྱད་པར་གྱིས་༢ཡུལ་ཐ་དད་པའི་ཕྱིར་བུམ་པ་ངོ་བོ་ཉིད་གཉིས་སུ་ཐལ་བར་འགྱུར་རོ་སྙམ་དུ་སེམས་ན།",
    "དེ་དག་གིས་བསྐྱེད་པ་ནི་དེས་བསྐྱེད་པ་སྟེ།",
    "དེའི་ཕྱིར་རྫ་མཁན་དང་འཇིམ་པའི་གོང་བུ་དག་གི་ཉེ་བར་སྦྱོར་བའི་ཡུལ་གང་ཡིན་པ་དེ་ངོ་བོ་ཉིད་ཐ་དད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "འཇིམ་པ་དང་དབྱིབས་དག་ཕན་ཚུན་གྱི་བདག་ཉིད་ཅན་མ་ཡིན་པ་ཉིད་ཀྱི་དེ་གཉིས་དབྱིབས་དང་འཇིམ་པའི་ངོ་བོ་དག་ཏུ་མི་སྣང་བར་ཐལ་བར་འགྱུར་རོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "གང་དག་ཐ་དད་པ་དེ་དག་ནི་རེས་འགའ་ལོགས་ཤིག་ཏུ་ཡང་བྱེད་ད་དེ།",
    "གང་གི་ཚེ་རང་བཞིན་ཁོ་ནས་བུམ་པ་ལ་སོགས་པའི་༥རྫས་དེ་གསུས་པ་དང་ཁོང་ཆེ་བ་ལ་སོགས་པའི་རྣམ་པའི་བྱ་ཏྲ་དབྱིབས་ཀྱི་རྟེན་གྱི་ངོ་བོ་ཉིད་གཅིག་ཡིན་པ་འམ།"
  ]
}