    "ལྷན་ཅིག་སྤྱོད་པས་རྟགས་ངེས་པར་བྱེད་པའི་མཚན་མ་མེད་པའམ།",
    "རྟ་དང་རྒོད་མ་དག་གོ་ཞེས་རྟགས་གཞན་གྱི་དམིགས་བསལ་ཅན་སྐྱེས་པར་བསྒྲུབས་ཏེ།",
    "ཅིག་ཤོས་སྦྱོར་བའི་ཟླས་དབྱེ་བའི་རྟགས་གཞན་ཉིད་ཀྱིས་ཤེས་པར་བྱེད་པས་སོ།",
    "དེའི་ཕྱིར་ཚིག་སྔ་མ་རྣམས་དང་འདི་ནི་རྟགས་ཐ་དད་པར་ཡང་འགྱུར་ལ།",
    "རྟགས་ཐ་དད་པ་རྣམས་ཀྱང་བསྡུས་པར་འགྱུར་རོ།",
    "ཟླས་དབྱེ་བྱས་མིན་གཅིག་ལྷག་མིན་ཏེ།",
    "རྟགས་དང་མིང་རྣམས་ཐ་དད་ཉིད་དུ་མ་བྱས་སོ་ཞེས་དགོངས་པའོ།",
    "དེས་ན་ཅིའི་ཕྱིར་རྟགས་ཐ་དད་པ་རྣམས་འདྲེས་པར་བྱེད།",
    "ཞེས་གསུངས་ཏེ།",
    "དེ་མ་གཏོགས་འདིར་འདྲེས་པ་སྟེ་ཡང་དག་པར་བསྲེས་པའི་ངོ་བོར་བྱས་པ་མེད་དེ་རིམ་པ་དང་འགལ་བ་སླར་ཡང་བྱས་པ་ལྟ་བུ་ནི་མེད་དོ་ཞེས་དགོངས་པའོ།",
    "དེ་ཡང་མཐོ་རིས་ལ་སོགས་པའི་རྣམ་གྲངས་ངེས་པར་ཡོད་པའི་ཡང་ངོའི་སྒྲ་ལ་སོགས་པ་དང་།",
    "དེ་ལྟར་ཐམས་ཅད་དུ་ཇི་ལྟར་སྲིད་པ་བཞིན་རྟོགས་པར་བྱའོ།",
    "སྐྱེས་པའི་སྐབས་ལ་སོགས་པ་རིམ་པ་སོ་སོར་ཤེས་པ་ཡང་མང་པོ་འདྲེས་པར་བལྟ་བར་བྱའོ།",
    "དེ་ལྟར་རྟགས་འདྲེས་པར་གྱུར་པ་རྣམས་ནི་རིམ་པ་ལས་རིང་དུ་གྱུར་པའོ།",
    "རྗེས་སུ་དཔག་པ་ལས་འཁྲིག་པ་རྟོགས་པར་བྱེད་དོ།",
    "རྟགས་བཀག་པ་ནི་རྟགས་ཀྱི་ཁྱད་པར་གང་ཡིན་པ་སྟེ།",
    "དེ་བཞིན་དུ་གྷསྲོ་དི་ནཱ་ཧ་ནཱི་བ་རུ་ཀྲཱི་བེ་དི་བ་ས་བཱ་ས་ར་དག་གོ་ཞེས་པ་འདིར་རྟགས་ཀྱི་ཚིག་འདྲེན་པར་བྱེད་དོ།",
    "དེ་ལ་རྟགས་གཞན་ཡང་ཞེས་པ་དེ་སོ་སོར་སྦྱོར་བའི་ཕྱིར་རྟགས་སྔ་མ་ཉིད་ཀྱང་རྣམ་པར་ཤེས་པར་བྱེད་དོ།",
    "བཙག་ཅན་དང་ནི་ཁྱད་པར་ཅན་། ཞེས་པ་འདིར་ནི་དགག་པའི་ཁྱད་པར་གྱི་ཆོ་གས་གནོད་དོ།",
    "དེ་ནས་དེ་ལ་བརྟེན་པའི་ལྷ་སྤྱི་རྣམས་དང་།",
    "དེའི་རྗེས་སུ་ཡུལ་ལྔ་པོ་རྣམས་ལ་སྤྱོད་པར་བྱེད་པ་དང་།",
    "སླར་ཡང་བྷཱ་གུ་རི་བཞིན་དུ་མཐོ་རིས་ལ་སོགས་པའི་གནས་གསུམ་གྱི་རིམ་པས་སྐབས་གསུམ་དུ་བྱས་པ་མ་ཡིན་ཞེས་པའོ།",
    "མི་སྤྱི་རྣམས་དང་དེའི་ཁྱད་པར་བྲམ་ཟེ་དང་རྒྱལ་རིགས་དང་རྗེའུ་རིགས་དང་དམངས་རིགས་རྣམས་ཀྱང་སྐབས་གསུམ་པར་སྔར་གསུངས་པའི་སྐབས་གཉིས་ལ་བརྟེན་ནས་དེ་ལྟར་བརྗོད་དོ།",
    "རྟགས་བསྡུས་པའི་རྟགས་རྟོགས་པར་བྱེད་པ་རྣམས་ཏེ།",
    "དེ་ནས་ཤས་ཀྱི་ན་ནི་སྐྱེས་པ་ལའོ་ཞེས་པ་ལ་སོགས་པའི་སྒྲའི་འདུ་བྱེད་ཀྱི་རྒྱུ་ཨ་ཡམ་ཞེས་པས་དོན་གསལ་བར་སྟོན་པར་བྱེད་པ་ནི་སྐྱེས་པའོ།",
    "ཨི་ཀའི་ཨ་ཙ་ལ་སུ་པ་ལའོ་ཞེས་པ་ལ་སོགས་པའི་སྒྲའི་འདུ་བྱེད་ཀྱི་རྒྱུ་ཨི་དམ་ཞེས་པས་དོན་གསལ་བར་སྟོན་པར་བྱེད་པ་ནི་མ་ནིང་ངོ།",
    "ཁྱད་པར་གྱི་སྒྲའི་འདུ་བྱེད་སྨོས་པ་ནི།",
    "ཁྱད་པར་གྱི་གཟུགས་ཅན་ཨུ་པ་སརྫ་ནཾ་སྟེ།",
    "ཁྱད་པར་ཉིད་ཀྱང་ངེས་པར་འདུ་བྱེད་པར་འོས་པ་ནི་ཨཱ་བིཥྚཾ་སྟེ།",
    "གལ་ཏེ་དེ་ལྟར་བརྗོད་པ་དེའི་ཁྱད་པར་ནི་མ་ནིང་ཉིད་དེ།",
    "འཆི་མེད་ཅེས་པ་ནས་ལྷའི་མཐར་ཐུག་པ་ཚིགས་སུ་བཅད་པ་གསུམ་གྱིས་ལྷ་སྤྱི་རྣམས་ཏེ།",
    "པྲྀ་ཥོ་ད་ར་ལ་སོགས་པ་ཉིད་ཀྱི་ཕྱིར་ཨོ་ཡིག་ནི་ཨོ་ཉིད་དུ་བྱས་པའོ།",
    "ཨར་དང་ཨུཎ་དང་ཨ་ཏ་མཐའ་རྣམས་ཀྱང་རྟགས་རྗེས་སུ་བསྟན་པར་ཀློག་སྟེ།",
    "དི་བི་ལས་ཨུཏ་ལ་བྱས་པའི་སྒྲ་ཕ་རོལ་ལ་དགག་པ་མེད་པའི་ཕྱིར་ཨུ་ཡིག་ཉིད་ཡཎ་ཏུ་བསྒྱུར་བས་དི་བོ་ཀ་ས་ཞེས་པ་ནི་སློབ་དཔོན་བྱམས་པ་སྲུང་བའ།",
    "མེ་ལ་སྲེག་བླུགས་བྱས་པ་ལྷ་རྣམས་ཀྱིས་ཐོབ་པས་ན་བསྲེག་བྱ་ཟ་བའི་དོན་དུ་འདིའི་ཞལ་མེ་ཡིན་པས་ན་མེ་ཞལ་ལོ།",
    "ལྷ་ཉིད་ཁོ་ན་ལྷ་སྟེ་པྲ་ཛྙཱ་ལ་སོགས་པ་རྣམས་ལས་ཡང་ནའོ་ཞེས་པས་ཨ་ཎའོ།",
    "ཉི་མ་སྣ་ཚོགས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཚོགས་པའི་ལྷ་སྟེ་འདུས་པར་གྱུར་པའི་ལྷ་རྣམས་སོ།"
  ]
}