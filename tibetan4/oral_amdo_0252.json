    "དེའི་མངག་གཞུག་མ་བུ་མོ་བསྐྱེད་མ་ཞེས་བྱ་བ་དང་།",
    "བསྐྱེད་མ་སོང་ལ་རྒྱན་འདི་དག་ཁྱིམ་དུ་ཞོག་ལ་ཤོག་ཤིག།",
    "དེ་རིངས་པར་སོང་ནས་དེས་ཁྱིམ་དུ་བཞག་སྟེ་སླར་འོངས་སོ།",
    "༥ ༤༡་མི་གཏོད་ཀྱི་མུ་ཏིག་གི་དོ་ཤལ་ཁོ་ན་ལ་རྟོག་པར་བྱེད་དོ།",
    "མིང་ཆེན་གྱི་ཆུང་མ་དམ་པས་ཤཱཀྱའི་བུ་མོ་མགུལ་པ་ན་མུ་ཏིག་གི་དོ་ཤལ་བཏགས་པ་ལ་མྱུར་བ་མྱུར་བར་རྟོག་པར་བྱེད་པ་མཐོང་ངོ།",
    "བསྐྱེད་མ་སོང་ལ་ཁོ་མོའི་མུ་ཏིག་གི་དོ་ཤལ་མྱུར་དུ་ཁྱེར་ཏེ་ཤོག་ཤིག།",
    "བདག་གི་འཚོ་བ་སྔོན་བྱས་ལས་ཀྱིས་ཐོབ་པ་ངནི།",
    "ཅེས་བྱ་བ་ཡིན་པས་ཚེ་ཆུང་ཞིག་ཡོད་པའི་ལས་ཚོགས་པ་རྙེད་པ་དེ་བ་དྲུས་མ་ཞིག་གིས་བསད་དོ།",
    "གང་གི་ཉི་མ་ལ་ཉིང་མཚམས་སྦྱར་ིབ་དེ་ཁོ་ནའི་ཉིན་པར་མུ་ཏིག་གི་ཆར་པ་༧བབ་བོ།",
    "བསྐ་བ་རྣམས་སྤངས་པའི་ཁ་ཟས་ཀྱིས་བསྙེན་བཀུར་བྱེད་ཅིང་དོ་ཤལ་དང་སེ་མོ་དོས་ལུས་བརྒྱན་ནས་ལྷའི་བུ་མོ་དགའ་ཚལ་ན་རྒྱུ་བ་བཞིན་དུ་ཁྲི་ནས་ཁྲི་དང་།",
    "ཁྲིའུ་ནས་ཁྲིའུར་འགྲོ་ཞིང་འོག་གི་ས་ལ་འབབས་ིཔར་མི་བྱེད་དོ།",
    "དེ་ཟླ་བ་བརྒྱད་དམ་དགུ་འདས་ནས་བུ་མོ་གཟུགས་བཟང་བ་མཛེས་པ་བལྟ་ན་སྡུག་པ་ཞིག་བཙས་ཏེ།",
    "༥ ༤༣བཙས་པ་དེ་ཉིད་ཀྱི་ཉིན་པར་ཡང་མུ་ཏིག་གི་ཆར་བབ་ིནས་རྒྱལ་པོས་བསམས་པ་འདི་ལྟར་བུ་མོའི་མཐུས་མུ་ཏིག་གི་ཆར་འབབ་པ་ནི་དེ་ཉིད་ཀྱི་མུ་ཏིག་ཏུ་འགྱུར་རོ་ཞེས་དེས་དེ་ཉིད་ལ་བྱིན་ནོ།",
    "དེ་ནས་ཉི་མ་བདུན་གསུམ་ཉི་ཤུ་རྩ་གཅིག་ཏུ་དེའི་བཙས་སྟོན་རྒྱ་ཆེར་བྱས་ནས་བུ་མོའི་མིང་ཅིར་གདགས་ཞེས་མིང་འདོགས་པར་བྱེད་དོ།",
    "གང་གི་ཕྱིར་འདིའི་མཐུས་མུ་ཏིག་གི་ཆར་བབ་པས་དེ་བས་ན་བུ་མོ་འདིའི་མིང་མུ་ཏིག་ཅན་ཞེས་གདགས་སོ་ཞེས་དེའི་མིང་མུ་ཏིག་ཅན་ཞེས་བྱ་བར་བཏགས་ཏེ།",
    "བུ་མོ་མུ་ཏིག་ཅན་མ་མ་བརྒྱད་ལ་གཏད་དེ།",
    "དེ་མ་མ་བརྒྱད་པོ་དག་གིས་འོ་མ་དང་།",
    "གཞན་ཡང་ཡོ་བྱད་ཀྱི་བྱེ་བྲག་གཙོ་བོ་གཙོ་བོ་དག་གིས་སྲིང་བར་བྱེད་སྐྱེད་པར་བྱེད་ཅིང་རྫིང་ན་གནས་པའི་པད་མ་བཞིན་མྱུར་དུ་སྐྱེད་པར་བྱེད་དོ།",
    "དེ་གང་གི་ཚེ་ཆེན་མོར་གྱུར་པ་དེའི་ཚེ་རང་གི་རིགས་དང་མཐུན་པའི་སྤྱོད་པ་དང་།",
    "དེ་རྣམས་ཀྱིས་མཚན་མོའི་ཐུན་ཐ་མ་ལ་ཆེད་དུ་བརྗོད་པ་དང་།",
    "ལྷ་མོ་བདག་ཅག་ནི་རོལ་མོ་མཁན་མ་ལགས་ཏེ།",
    "ལྷ་མོ་ཤཱཀྱ་རྣམས་ཀྱི་གཞོན་ནུ་གངས་རིའི་ངོས་དང་ཉེ་བ།",
    "ཡན་ལག་མཆོག་གི་གཟུགས་དང་ལྡན་པ།",
    "གང་གི་ཚེ་ཁྱེད་ཅག་ཡུལ་དུ་འདོང་བ་དེའི་ཚེ་ཁོ་མོ་ལ་སྒྲོན་ཅིག།",
    "ལྷ་མོ་བཀའ་བཞིན་འཚལ།",
    "ལམ་གྱིས་དུབ་པ་ངལ་སོས་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "བཙུན་པ་སིང་ག་ལའི་གླིང་ན་སིང་ག་ལའི་རྒྱལ་པོའི་བུ་མོ་དེས་མཆིད་ཡི་གེ་གསོལ་བ་འདི་ལགས་སོ།",
    "གང་གི་ཚེ་ཁྱེད་ཅག་སླར་འདོང་བར་གྱུར་པ་དེའི་ཚེ་ངའི་སྙན་དུ་གསོལ་ཅིག།",
    "དེ་ནས་ཟོང་བསྒྱུར་ཏེ་བསྒྱུར་བའི་ཟོང་ཐོགས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་སོང་སྟེ་གསོལ་པ།",
    "བཅོམ་ལྡན་འདས་བདག་ཅག་མཆི་ན་བདག་ཅག་གིས་མུ་ཏིག་ཅན་ལ་ཇི་སྐད་བགྱི་བཀའ་སྩལ་པར་གསོལ།",
    "ཤིན་ཏུ་ལེགས་པར་བྱི་དོར་བྱས་པའི་རས་དང་རི་མོ་མཁན་དག་ཁུག་ཤིག།",
    "དེ་རྣམས་ཀྱིས་རས་དང་རི་མོ་མཁན་དག་བཀུག་ནས་ཕུལ་བ་དང་།",
    "དེ་རྣམས་ཀྱིས་རས་བསྟན་པ་དང་བཅོམ་ལྡན་འདས་ཀྱིས་འོད་བཏང་བ་ལ་རི་མོ་མཁན་རྣམས་ཀྱིས་ཚོན་རྩི་སྣ་ཚོགས་ཀྱིས་རྒྱས་པར་བྱས་སོ།",
    "རས་ལ་རི་མོར་བྲིས་པ་ངས་མུ་ཏིག་ཅན་ལ་སྐྱེས་སུ་བསྐུར་བ་ཡིན་གྱིས།",
    "ཁྱོད་ཀྱིས་དེ་ལ་ཀྱིས་ཕྱོགས་ཡངས་ཤིང་རྒྱ་ཆེ་བར་སིང་ག་ལའི་གླིང་ན་གནས་པའི་སྐྱེ་བོའི་ཚོགས་བསྡུས་ལ།",
    "བཙུན་པ་བཀའ་བཞིན་འཚལ་ཞེས་ཚོང་པ་དེ་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལས་མཉན་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ིསྤྱན་སྔ་ནས་སོང་ངོ།",
    "ཟོང་ཁྱེར་ནས་སིང་ག་ལའི་གླིང་དུ་སོང་སྟེ།",
    "རྒྱལ་པོའི་དྲུང་དུ་སོང་ནས་རྐང་པ་གཉིས་ལ་གཏུགས་ཏེ་ཡི་གེ་བྱིན་ནོ།",
    "གྱོ་མོ་བསལ་ནས་ཙན་དན་གྱི་ཆུས་ཆག་ཆག་བཏབ།",
    "ཇི་སྲིད་ལན་གསུམ་དུ་ིམ་བཟླས་པ་དེའི་བར་དུ་དེས་འཇིག་ཚོགས་ལ་ལྟ་བའི་རིའི་རྩེ་མོ་ཉི་ཤུ་མཐོ་བ་ཡེ་ཤེས་ཀྱི་རྡོ་རྗེས་བཅོམ་ནས་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་མངོན་སུམ་དུ་བྱས་ཏེ།",
    "ཤེས་ལྡན་དག་ཁྱེད་ཅག་ནམ་འདོང་བ་དེའི་ཚེ་ཁོ་མོ་ལ་སྦྲོན་ཅིག།",
    "དེ་ནས་ཚོང་པ་རྣམས་ཀྱིས་ཟོང་རྣམས་བསྒྱུར་ཏེ་བསྒྱུར་བའི་ཟོང་རྣམས་ཁྱེར་ནས་མུ་ཏིག་ཅན་གྱི་དྲུང་དུ་སོང་སྟེ།",
    "ལྷ་མོ་བདག་ཅག་ིམཆི་ན་བདག་ཅག་གིས་ཅི་ཞིག་བགྱི་བར་བཀའ་སྩལ་པར་གསོལ།",
    "ཁོ་མོའི་ཚིག་གིས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་འཚོལ་ལ་ིགནོད་པ་ཆུང་ངམ།",
    "སྐུ་ཉམས་དང་ལྡན་ནམ་རེག་པར་གནས་སམ་ཞེས་ཞུས་ལ་འདི་སྐད་ཅེས།",
    "ངན་སོང་གི་སྒོ་ནི་བསྐུམ།",
    "ཐོག་མ་མ་མཆིས་པའི་དུས་ནས་བསགས་པའི་འཇིག་ཚོགས་ལ་ལྟ་བའི་རིའི་རྩེ་མོ་ཉི་ཤུ་མཐོ་བ་ཡེ་ཤེས་ཀྱི་རྡོ་རྗེས་བཅོམ་ནས་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་མངོན་སུམ་དུ་བགྱིས་ཏེ།",
    "ལམ་གྱིས་དུབ་པ་ངལ་སོས་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཞབས་གཉིས་ལ་གཏུགས་ནས་ཇི་སྐད་སྤྲིང་བ་བཞིན་བཅོམ་ལྡན་འདས་ལ་གསོལ་ནས་འདི་སྐད་ཅེས་ཀྱང་གསོལ་ཏོ།",
