    "ཁྱད་པར་དུ་དོ་ནུབ་རྨི་ལམ་རྨི་བར་བྱ།",
    "དེ་རྨི་ལམ་དུ་ངོ་ཤེས་པར་བྱ་སྙམ་དུ་དྲན་འདུན་ཡང་ཡང་བཏང་ངོ།",
    "གཉིད་འོད་གསལ་དུ་ཐིམ་པར་བྱིན་གྱིས་རློབས།",
    "ཅིས་ཀྱང་རྨི་ལམ་ཟིན་པར་བྱ།",
    "རྨི་ལམ་རྨི་ལམ་དུ་ངོ་ཤེས་པར་བྱ།",
    "རྨི་ལམ་རྨི་ལམ་ཡིན་པར་ཤེས་པར་བྱ།",
    "མགྲིན་པར་སྣ་ཚོགས་པདྨ་འདབ་བཞིའི་སྟེང་།",
    "ངན་པ་ལས་བཟང་པོ་དང་ལྷ་སྐུར་བསྒྱུར་བ་སོགས་བྱའོ་སྙམ་དུ་འདུན་པ་བཏང་ལ་ཉལ།",
    "རྨི་ལམ་བདེན་པར་མ་གྲུབ་ཅི་བྱས་བཏུབ་བསྙམ་པས།",
    "རང་ལུས་ལྷ་སྐུ་སྒྱུ་མར་བསྒོམ་ཞིང་བདེ་དགྱེས་སོགས་གང་འདོད་དུ་སྒྱུར་བ་དང་།",
    "རྨི་ལམ་བདེན་པར་མ་གྲུབ་སྒྱུ་མ་ཉིད།",
    "གཅིག་དང་དུ་མ་ལྷ་སྐུ་སྣ་ཚོགས་སོགས།",
    "གང་འདོད་སྤྲུལ་སྒྱུར་གཏན་ལ་དབབ་པར་བྱ།",
    "གཅན་གཟན་སོགས་འཇིགས་པའི་རྣམ་པ་མཐོང་ན་དེ་ལ་ཡ་ང་སྤང་ཞིང་སྒྱུ་མར་སྦྱང་དགོས་པས་རྨི་ལམ་ནི་མེད་བཞིན་སྣང་བ་བདེན་པར་མ་གྲུབ་པ་ཡིན་ན།",
    "གནས་ཀྱི་ཁྱད་པར་མང་དུ་བལྟ་བར་བྱ།",
    "ལུང་བསྟན་གདམས་པ་ཉན་ཅིང་ནོད་པར་བྱ།",
    "ཨོཾ་ལ་སེམས་བཟུང་ནས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཞིང་སྦྱང་།",
    "དེ་ལྟར་བྱས་པས་དང་པོ་འོལ་སྤྱི་ཙམ་དང་དེ་ནས་ཇི་གསལ་དུ་གྱུར་ཏེ།",
    "མཐར་ཇི་ལྟ་བར་མཐོང་ཞིང་འབྱོར་པར་འགྱུར་རོ།",
    "གཉིད་ཀྱི་འོད་གསལ་ཅིས་ཀྱང་ཟིན་པར་བྱའོ།",
    "ཕྱིའི་སྣང་བ་ཞུ་ནས་སྟོང་པར་ཐིམ་པ་སྣང་བ་ཐོབ་པའི་དུས་སུ་ར།",
    "དེ་ནས་སྟོང་པ་བཞིའི་རྟོགས་པའི་སྣ་ཅི་ཟིན་བྱས་ལ།",
    "མཆོག་མི་འགྱུར་བའི་འོད་གསལ་ངོས་ཅི་ཟིན་བྱས་ལ་ཟིན་པ་དང་མཉམ་པར་བཞག་གོ།",
    "གཉིད་ཉལ་ཁར་དོ་ནུབ་གཉིད་ཀྱི་འོད་གསལ་ཟིན་པར་བྱ་སྙམ་པའི་འདུན་པ་ཡང་ཡང་བཏང་ལ།",
    "རང་ཡི་དམ་དུ་གསལ་བ་ནས་ཧཱུྃ་ལ་བསྡུ་བའི་བར་བྱས་ལ།",
    "གྲོགས་ཀྱིས་ཀྱང་བསྐུལ་བརྡ་བྱས་ཤིང་ཨེ་ཟིན་བལྟ།",
    "ཟིན་པ་དང་གསལ་སྟོང་དང་བདེ་སྟོང་འདྲེས་པ་ཞིག་འོང་བ་དེ་ཀ་ལ་མཉམ་པར་བཞག་སྟེ།",
    "དེར་ཐིག་ལེ་ནག་པོ་རིལ་མ་ཙམ་ལ་སེམས་བཟུང་བས་ཟིན་པར་སླའོ།",
    "དེ་དག་ནི་མ་ཟིན་པ་ཟིན་པར་བྱེད་པའི་ཐབས་སོ།",
    "ཟིན་ནས་བརྟན་པར་བྱ་བ་དང་།",
    "སོ་སོར་བྱེད་དུས་རྐང་པ་གཉིས་པར།",
    "གསུམ་པར་དེའི་ཐུགས་ཀར་ཨོཾ་ཡིག།",
    "འོད་ཀྱི་རྣམ་པར་རང་ལ་ཐིམ་པ་ནས།",
    "རྣལ་འབྱོར་པ་རང་ཉིད་འཆི་བའི་ཉམས་ཁོང་དུ་ཆུད་པ་ན་འདི་ལྟར་བསམ་པར་བྱ་སྟེ།",
    "གལ་ཏེ་དངོས་པོ་རྣམས་ཡང་དག་པར་བདེན་ན་འཆི་མི་སྲིད་ལ།",
    "འཆི་བ་དང་འཇིག་པ་མཐོང་བའི་ཕྱིར་བདེན་པར་མ་གྲུབ་སྟེ།",
    "མི་ནུས་ན་སེང་གེའི་ཉལ་སྟབས་བྱས་ལ།",
    "བདག་འཆི་བ་དེ་ཁོ་ན་ཉིད་འོད་གསལ་དོན་དམ་པའི་བདེན་པ་རྟོགས་པར་བྱས་ལ།",
    "དེ་ནས་སྐད་ཅིག་བཞི་པར་ཐོབ་པ་འོད་གསལ་ལ་ཐིམ་སྟེ།",
    "འགྲུབ་པར་མ་གྱུར་དེ་ཚེ་ཕྱི་མ་ཡི།",
    "མངལ་གདམ་ཤེས་བཞིན་སྐྱེ་བ་འཛིན་པར་བྱ།",
    "དེ་འཆར་བའི་ཆེད་དུ་མཁའ་སྤྱོད་ཀྱི་གནས་སུ་རིག་པ་འཛིན་པའི་འཁོར་ལོས་སྒྱུར་བའི་ལུས་ཁྱད་པར་ཅན་དུ་སྐྱེ་བར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཟློག་པའི་ཐབས་ཡོད་པ་རྣམས་ཅི་ནུས་སུ་བཟློག་ཅིས་ཀྱང་བཟློག་པར་མི་ནུས་པ་དེའི་ཚེ།",
    "ཡི་དམ་གྱི་སྐུ་མདུན་དུ་བཤམ།",
    "སེང་གེའི་ཉལ་སྟབས་མགོ་བྱང་དུ་སྟན་བྱས།",
    "རང་ཡི་དམ་དུ་གསལ་བའི་མགྲིན་པར་ཨོཾ།",
    "དེ་ནས་དྭངས་མ་ཡས་༣བྱོན་གྱི་འགོས་སོགས་དང་མཐུན་པར་སྒོམ་ལམ་དང་པོ་ནས་བཟུང་སྟེ་བཅུ་གཉིས་མ་ཆགས་པདྨའི་སའི་བར་དུ་བགྲོད་པས་རྒྱུན་མཐའ་ཐོབ་བོ།",
    "མཐར་ཐུག་ཡིན་པར་འཁྲུལ་ནས་ཁ་འཆལ་གྱི།",
    "དོན་དང་དོན་མིན་ལེགས་པར་ཕྱེ་བ་ལ།",
    "མཁའ་འགྲོའི་ཚོགས་ཀྱིས་བཟོད་པར་མཛད་འཚལ་ཞིང་།",
    "དེ་རྣམས་ལེགས་པར་ཕྱེ་བ་ཡིན་ནོ།",
    "འདིར་ནི་མཐའ་དྲུག་དུ་གསུངས་པ་ཐམས་ཅད་ཀྱང་ངེས་དོན་འབའ་ཞིག་ཏུ་བཞེད་དོ།",
    "༡༢ ལོག་པའི་ཀུན་རྫོབ་ཀྱིས་དོན་བྱེད་མི་ནུས་པར་འདོད་དེ།",
    "ལོག་པའི་ཀུན་རྫོབ་ཀྱིས་ཀྱང་དོན་བྱེད་ནུས་པར་བཞེད་དོ།",
    "འདིར་ནི་ལམ་ཐམས་ཅད་ས་བཅུས་བགྲོད་པར་བཞེད་དོ།",
    "འདིར་ནི་ཤེས་བྱའི་སྒྲིབ་པ་སྔོན་ལ་སྤོང་བ་ཡང་ཡོད་པར་བཞེད་དོ།",
    "འདིར་ནི་ཁམས་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་བྲལ་འབྲས་ཡོན་ཏན་ལྷག་པར་བཞེད་དོ།",
    "འདིར་ནི་དགེ་མི་དགེ་གཉིས་སུ་ཐག་བཅད་ན་ལུང་མ་བསྟན་མེད་པར་བཞེད་དོ།",
    "འདིར་ནི་རྟོག་གཉིས་གཅིག་ཆར་མི་འཇུག་ཅིང་སེམས་པར་འགྲོགས་ནས་མི་སྐྱེ་བར་བཞེད་དོ།",
    "འདིར་ནི་ད་ལྟ་ཉིད་དུ་གང་བསྒྲུབས་པའི་འབྲས་བུ་ལ་ལོངས་སྤྱོད་པར་བཞེད་དོ།",
    "འདིར་ནི་དུས་ཀྱི་འཕེལ་བ་དང་འགྲིབ་པ་ད་ལྟ་རང་ཡང་བྱར་ཡོད་པར་བཞེད་དོ།",
    "འདིར་ནི་ལྷག་པ་ཤེས་རབ་ཀྱི་བསླབ་པ་སྔོན་དུ་འགྲོ་བ་ཡང་ཡོད་པར་བཞེད་དོ།",
    "འདིར་ནི་སྡོམ་པའི་ངོ་བོ་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་གཟུགས་སུ་བཞེད་དོ།",
    "འདིར་ནི་ཡིད་ཀྱི་རྣམ་པ་གསུམ་གཙོ་བོར་སྤོང་དགོས་པར་བཞེད་དོ།",
    "འདིར་སྣ་གཅིག་བསྲུངས་པའི་འབྲས་བུས་ཀྱང་མྱ་ངན་ལས་འདའ་བ་ཡིན་པར་བཞེད་དོ།",
    "འདིར་ནི་བཅས་པ་ཐམས་ཅད་འགྲོ་དྲུག་སྤྱི་ལ་བཅས་པར་བཞེད་དོ།",
    "འདིར་ནི་བཀག་པ་ཉེས་མེད་དུ་འགྱུར་མི་སྲིད་པས་སྤྱིར་བཀག་པ་ཐམས་ཅད་ཡེ་བཀག་ལ་གནང་བ་ཡེ་གནང་དུ་བཞེད་དོ།",
    "འདིར་ནི་བསྟན་པ་ལ་ཐབས་ལ་མཁས་པའི་ཆོ་ག་ལྷག་པར་གལ་ཆེ་བར་བཞེད་དོ།",
    "འདིར་ནི་མི་ཤེས་པ་གཏི་མུག་ལྷག་པར་ཉེས་པ་ཆེ་བར་བཞེད་དོ།",
    "འདིར་ནི་དུད་འགྲོ་གཏི་མུག་ཆེ་བས་དམན་པར་འགྱུར་བར་བཞད་དོ།",
    "འདིར་ནི་ཐབས་ལ་མཁས་ན་རང་གཞན་བརྗེ་བ་དེ་ཉིད་ཉེས་པར་འགྱུར་བའི་སྐབས་ཡོད་པར་ཡང་བཞེད་དོ།",
    "འདིར་ནི་བདེན་པ་ནི་གྲུབ་པའི་མཐའ་ཇི་སྙེད་པ་ཐམས་ཅད་ཀྱིས་སྒྲིབ་པར་བཞེད་དོ།",
    "འདིར་ནི་རྒྱུ་ལམ་འབྲས་བུ་ཐམས་ཅད་དུ་ཚོགས་གཉིས་ཟུང་དུ་འཇུག་པར་བཞེད་དོ།",
    "འདིར་ནི་ཕྲིན་ལས་རྫོགས་པར་འགྲོ་བས།",
    "འདིར་ནི་དཔེ་དོན་རྟོགས་པ་མ་སྐྱེས་ན་དོན་ཁོང་དུ་མི་ཆུད་པར་བཞེད་དོ།",
    "འདིར་ནི་བསྐྱེད་རིམ་ནི་ཡོངས་སུ་གྲུབ་པར་བཞེད་དོ།",
    "འདིར་ནི་ལྷ་ཐམས་ཅད་མཚན་དཔེའི་ཡོན་ཏན་དང་ལྡན་པར་བཞེད་དོ།",
    "འདིར་ནི་གཞན་གྱི་མི་ཟབ་པ་ཟབ་པར་བཞེད་དོ།",
    "འདིར་ནི་བཀའི་དགོངས་པ་ཐམས་ཅད་དང་འགལ་མེད་དུ་འགྲོ་དགོས་པར་བཞེད་དོ།",
    "འདིར་ནི་འདོད་པས་བར་དུ་གཅོད་པར་གསུངས་པའི་སྟེང་དུ་གཅིག་པར་བཞེད་དོ།",
    "འདིར་ནི་སྔགས་ཀྱི་མཐུ་བསྟན་པ་ལས་མངོན་སྤྱོད་མ་གནང་བར་བཞེད་དོ།",
    "འདིར་ནི་རྡོ་རྗེ་སློབ་དཔོན་རྒྱུད་ཚོད་མཐོ་ན་དེ་ཉིད་ཀྱིས་འདྲོངས་པར་བཞེད་དོ།",
    "འདིར་ནི་རྟོགས་པ་ཕུལ་དུ་ཕྱིན་པ་ལ་ལྟ་བ་རྟོགས་པ་དང་ལྡན་པར་བཞེད་དོ།",
    "འདིར་ནི་ཆེན་པོ་གསུམ་གྱིས་མ་རིག་པའི་རྟོགས་པར་བཞེད་དོ།",
    "འདིར་ནི་ལྟ་སྒོམ་སྤྱོད་པ་གསུམ་གཅིག་པར་བཞེད་དོ།",
    "འདིར་ནི་རྟོགས་པ་དང་ལྡན་པ་ལ་ཐབས་ལམ་ལ་སོགས་པ་ཤིན་ཏུ་ཡང་དགོས་པར་བཞེད་དོ།",
    "འདིར་ནི་སྐུ་གསུམ་ཐ་དད་མེད་པར་བཞུགས་པར་བཞེད་དོ།",
    "ལོངས་སྤྱོད་ཕལ་པའི་འབྱོར་པར་ལྡན་གྱུར་ཀྱང་།",
    "རིགས་འཆོལ་གཞན་ལ་སྨོད་པར་མི་བྱེད་ཅིང་།",
    "མཚན་ལྡན་སྲས་ནི་ཁྱད་པར་འཕགས་པ་བཞེད།",
    "ཕྱོགས་བཅུ་དུས་གསུམ་གྱི་འདྲེན་པ་རྣམས་ལས་ཡོན་ཏན་བཀོད་པ་ཀུན་གྱིས་ཁྱད་པར་དུ་འཕགས་པས་དུས་གསུམ་ཁེགས་པའི་སྟོན་པ།",
    "འདིར་ནི་འཁོར་འདས་ཐམས་ཅད་ཀྱང་ཕུན་སུམ་ཚོགས་པ་ལྔས་བསྡུས་པར་བཞེད་དོ།",
    "འདིར་ནི་མུ་སྟེགས་དང་བོན་གྱི་སྒོར་ཞུགས་པས་བདེན་པ་མཐོང་བའི་གནས་མེད་པར་བཞེད་དོ།",
    "འདིར་ནི་ཉམས་ལེན་དུ་རྨད་དུ་བྱུང་བ་ཀུ་ས་ལའི་ཚོགས་སོག་ཡིན་པར་བཞེད་དོ།",
    "འདིར་ནི་དེ་རྣམས་སེལ་བའི་ཐབས་མཆོག་ལམ་གཏོང་དང་དམིགས་པ་ཡིན་པར་བཞེད་དོ།",
    "འདིར་ནི་དུས་བཞིར་རྩ་བའི་དམ་ཚིག་གནང་བའི་དུས་སྐབས་མེད་པར་བཞེད་དོ།",
    "འདིར་ནི་ཐ་མལ་གྱི་ལུས་སུ་བཏགས་པས་དམད་པར་བཞེད་དོ།",
    "འདིར་ནི་དྲང་དོན་ངེས་དོན་ཐམས་ཅད་ལ་ཆོ་ག་རྒྱས་པ་དགོས་པར་བཞེད་དོ།",
    "འདིར་ནི་དཔོན་སློབ་གཉིས་ཀ་ཕན་ཚུན་དམ་ཚིག་མཉམ་པར་བཞེད་དོ།",
    "རྒྱལ་བ་དེའི་ཞལ་ནས་གསུངས་པ་ཡི།",
    "མ་བུ་བཞིན་དུ་དགོངས་པ་གཅིག་རྒྱལ་བ་ཐམས་ཅད་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདིའི་ངོར་ཡེ་ཤེས་བརྙེས་པར་གཅིག་པ་དང་བཞིའོ།",
    "ངོ་བོ་འཁོར་འདས་ཐམས་ཅད་ལ་ནམ་མཁའ་བཞིན་དུ་མི་ཁྱབ་པ་མེད་པ་དང་གཅིག་གཟུགས་ནས་རྣམ་མཁྱེན་གྱི་བར་དུ་དངོས་པོ་ཐམས་ཅད་ལ་མི་སྟོང་བ་མེད་པ་དང་གཉིས།",
    "དེ་ཉིད་སྦྱང་བ་བྱས་པ་ལས།",
    "ཞེས་གསུངས་ཏེ།",
    "རིམས་ཀྱིས་དག་པར་གྱུར་པ་དེ་ཉིད་ལ་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པ་ཞེས་བྱ་སྟེ།",
    "མཉམ་མེད་སྒམ་པོ་པར་གྲགས་རྒྱུད་པར་བཅས།",
    "རྡོ་རྗེ་འཛིན་པར་འདོད་པ་ནི།",
    "བསྟན་པའི་རྣམ་གཞག་ཁྱད་པར་ཅན་གྱི་སྤྱི་དོན་གསུམ་ལས།",
    "གཙང་མའི་གནས་རྣམས་སྤངས་པ་ཡི།",
    "ཐུགས་རྗེ་ཆེན་པོས་འཇིག་རྟེན་མཁྱེན།",
    "མྱ་ངན་འདས་པར་གཤེགས་མཛད་རྣམས།",
    "སྲིད་པ་ཇི་སྲིད་གནས་པར་སྟོན།",
    "འདི་རྣམས་དགྲོལ་བའི་དོན་དུ་སྲས་དང་བཅས་པ་རྒྱལ་བའི་བདག་པོ་ལས་ཀྱི་སར་ནི་རབ་བཞུགས་ཏེ།",
    "འཇམ་དཔལ་ནི་རྒྱལ་པོ་ཟས་གཙང་མར་གྱུར་ཏོ།",
    "རྒྱལ་པོ་ཆེན་པོ་ཟས་གཙང་མ།",
    "པུརྟི་ཀ་སོགས་དགྲ་བཅོམ་ལྔ་བརྒྱ་དང་ཝ་སུ་མི་ཏྲ་སོགས་བྱང་སེམས་ལྔ་བརྒྱ་དང་སོ་སྐྱེའི་པཎྜི་ཏ་ཁྲི་དྲུག་སྟོང་འདུས་ནས་བསྡུས་པ་བཀའ་བསྡུ་གསུམ་པར་བཤད།",
    "བདེ་བ་ཆེན་པོའི་གནས་དཀྱིལ་འཁོར་ཆེན་པོ་སྤྲུལ་ཏེ་སྟོན་པ་དཔལ་དུས་ཀྱི་འཁོར་ལོའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་བཞུགས་པས།",
    "ཞུ་བ་པོ་རྒྱལ་པོ་ཟླ་བ་བཟང་པོ་དང་གཞན་ཡང་རྒྱལ་པོ་དགུ་བཅུ་རྩ་དྲུག་སོགས་སྐལ་བ་དང་ལྡན་པའི་གདུལ་བྱ་རྣམས་ལ་རྩ་བའི་རྒྱུད་སྟོང་ཕྲག་བཅུ་གཉིས་པ་གསུངས།",
    "འཁོར་ནམ་མཁའ་ཁྱབ་པས་བཅོམ་ལྡན་འདས་ལ་གསོལ་བ་བཏབ་ནས་འདོད་ཆགས་ཅན་རྗེས་སུ་བཟུང་བའི་ཕྱིར་དཔལ་གསང་བ་འདུས་པ་༡༧གསུངས་པར་བཞེད་ཅིང་།",
    "རབ་ཏུ་སྒྲོན་གསལ་ལས་ཀྱང་དགའ་ལྡན་དུ་གསུངས་པར་བཤད།",
    "སྟོན་པས་བདུད་ཆེན་པོ་ལས་མཆོག་ཏུ་རྒྱལ་བ་ཞེས་པའི་ཏིང་ངེ་འཛིན་ལ་བཞུགས་ཏེ།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་རྡོ་རྗེ་ལས་ཁྲོ་བོ་གཤིན་རྗེ་གཤེད་ཕྱུང་ནས་དཀྱིལ་འཁོར་སྤྲུལ་ཏེ་བདུད་ཐམས་ཅད་བཏུལ་ནས་རྒྱུད་རྒྱས་པ་གསུངས།",
    "སྟོན་པ་གཤིན་རྗེ་གཤེད་ལྷ་བཅུ་གསུམ་དང་བཅས་པའི་འཁོར་ཚོགས་མང་པོ་དང་ཐབས་གཅིག་ཏུ་བཞུགས་ནས་བསྡུས་རྒྱུད་གསུངས།",
    "ཕྱག་རྡོར་ལ་ཉན་པར་གདམས་པས་དེས་ཞུས་ནས་གཤེད་དམར་གསུངས་སོ།",
    "འཛམ་བུའི་གླིང་འདིར་བདེ་མཆོག་ཞལ་བཞི་ཕྱག་བཅུ་གཉིས་པར་སྤྲུལ་ནས་འཇིགས་བྱེད་དང་དུས་མཚན་ཞབས་འོག་ཏུ་མནན་ཞིང་བཏུལ།",
    "དེའི་ནང་དུ་གནས་པའི་གཞལ་ཡས་ཁང་དུ་སྟོན་པ་བཅོམ་ལྡན་འདས་འཁོར་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པ་དུ་མས་བསྐོར་ཏེ་བཞུགས་པ་ལ།",
    "གཞན་ཡང་རྩ་རྒྱུད་རྒྱས་པ་རྣམས་ལས་བསྡུས་ནས་བསྡུས་རྒྱུད་རྣམས་གསུངས་པས་སྟོན་པ་པོ་ཉིད་ཀྱིས་བསྡུས་པར་འདོད་པ་སོགས་ཡོད་ཀྱང་།",
    "ཡང་ཕྱག་རྡོར་གྱིས་ཀླུ་དེ་རྣམས་སྨིན་པར་མཛད་ནས་རྒྱུད་ཐམས་ཅད་གླེགས་བམ་དུ་བྲིས་ཏེ་གཏད།",
    "ཕྱི་དུས་རིམ་པར་ལུང་བསྟན་བསྡུས་པ་པོས།",
    "རབ་ཏུ་གསུངས་པ་གསེར་གྱི་ཤོག་བུ་ལ།",
