    "བསྟན་པའི་དོན་ནི་བྱེད་པར་འགྱུར།",
    "ཀུན་གྱིས་རབ་ཏུ་ཤེས་པར་བྱ།",
    "རྒྱལ་བས་གསུངས་པ་དེ་དག་ལ།",
    "འཁོར་ལོ་རབ་ཏུ་བསྐོར་བྱས་ནས།",
    "འཁོར་ལོ་རབ་ཏུ་བསྐོར་བྱས་ནས།",
    "འགྲོ་བའི་སྟོན་པས་གསུངས་པ་ཡིན།",
    "དམ་པའི་དོན་ནི་ཐུབ་པས་གསུངས།",
    "མཁས་པ་རྣམས་ནི་རྣམ་པར་གྲོལ།",
    "ཡེ་ཤེས་རྒྱ་མཚོ་རྣམ་པར་བརྒྱན།",
    "ཚེ་འདི་ཉིད་ལ་འགྲུབ་པར་འགྱུར།",
    "ལེགས་པར་གསུངས་དང་དེ་ཡི་དགོངས་འགྲེལ་བ།",
    "ཞི་བའི་ཕན་ཡོན་སྟོན་པར་མཛད་པ་གང་།",
    "བཀའ་ལ་ཡང་ཞལ་ནས་གསུངས་པ་དང་བྱིན་གྱིས་བརླབས་པ་དང་རྗེས་སུ་གནང་བའི་བཀའ་གསུམ་དུ་ཡོད་པ་ལས།",
    "བཀའ་ཕལ་ཆེར་ཞལ་ནས་གསུངས་པའི་བཀའ་ཡིན་ཞིང་།",
    "རྗེས་སུ་གནང་བ་ནི་བསྡུ་བ་པོ་དང་ཞུ་བ་པོ་ལ་སོགས་པས་གསུངས་པའི་གླེང་གཞི་དང་འཚམས་སྦྱོར་དང་འཐུན་འགྱུར་ལ་སོགས་པ་རྣམས་ཡིན་ནོ།",
    "སྔགས་ཀྱི་བསྟན་བཅོས་རྣམ་པ་ལྔ་རུ་གསུངས་ཏེ།",
    "རྣལ་འབྱོར་མ་ཡི་རྒྱུད་ནི་དྲུག་པར་གྲགས་པ་ཡིན།",
    "རྒྱུད་ཀྱི་དབྱེ་བ་ཤེས་པར་བྱ།",
    "བྲམ་ཟེའི་རིགས་ཁྲུས་དང་གཙང་སྦྲ་ལ་དགའ་བ་དཀའ་ཐུབ་དང་དཀའ་སྤྱོད་ཀྱིས་གྲོལ་བར་འདོད་པ་ལ་བྱ་རྒྱུད།",
    "བྱ་བ་བྲམ་ཟེའི་གཙང་དང་བསྟུན།",
    "མུ་སྟེགས་གཏི་མུག་ཅན་ཚངས་པའི་རྗེས་སུ་འབྲང་བ་ཁྲུས་དང་གཙང་སྦྲ་དང་སྙུང་གནས་དང་སྦྱིན་བསྲེག་ལ་སོགས་པས་གྲོལ་བར་འདོད་པ་ལ་བྱ་རྒྱུད།",
