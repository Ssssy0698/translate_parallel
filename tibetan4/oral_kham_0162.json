    "དོ་པཱ་རི་ཀའི་གནས་དངོས་ནི་ཡུལ་དེ་ཀའི་ཐད་ཀྱི་ནུབ་ཕྱོགས་ཀྱི་རྒྱ་མཚོའི་ཕར་འགྲམ་ན་ཡོད་ཅེས་ཡན་ལག་བརྒྱད་པའི་འགྲེལ་པ་ཟླ་ཟེར་ན་གསུང་འདུག་དེའི་ནུབ་ཏུ་མྱ་ངམ་གྱི་ཐང་ཆེན་པོ་དང་།",
    "ཕེ་རང་ཕོར་སྟི་ཀེ་སིས་བྱས་པའི་གོ་ལའི་ཁ་བྱང་ན་ཡང་གནྠི་ནའི་ཡུལ་ཞེས་འདུག་ལ།",
    "དགྲ་བཅོམ་པ་ཉི་མ་གུང་པས་གུར་ཀུམ་གྱི་ས་བོན་བཏབ་པ་ཡིན་ཟེར་བ་ཁ་ཆེ་གུར་ཀུམ་སྐྱེ་བའི་ཐང་ཞིག་ཡོད་པ་ངེད་ཀྱི་གྲྭ་རིགས་གནས་སྐོར་བ་དགེ་ལེགས་ཟེར་བས་ཀྱང་དངོས་སུ་མཇལ་འདུག་ཡུལ་དེའི་བྱང་ཤར་སྦལ་ཏི་དང་ཉེ་སར་གནས་ཉེར་བཞིའི་ནང་ཚན་ཏེ་མ་ལ་ཡའི་གནས་ཡོད།",
    "ཐོ་དཀར་དང་རྒྱ་ནག་གཉིས་ཀས་ཡུར་བར་དྲངས་པས་ཆུ་ཆར་ཟེར་བ་བདེན་མི་བདེན་མ་ངེས་ཀྱང་དོན་འགྱུར་གྱི་ཐེ་ཚོམ་གྱི་གནས་སུ་འདུག་པ་འདི་ནི་ཤམྦྷ་ལའི་ལམ་ཡིག་ལས་གསུངས་པའི་སི་ཏ་དེ་མ་ཡིན།",
    "ཡུལ་འཁོར་ཡང་མི་ཆུང་བ་ཙམ་ཞིག་ཡོད་ཚོད་འདུག་ཡུལ་དེའི་མི་རྣམས་ཀྱི་ཆ་ལུགས་གོས་དང་ལྷམ་སོགས་ཕལ་ཆེར་ཁ་ཆེ་དང་འདྲ་ཡང་།",
    "བོད་དྲང་པོ་གསུམ་གསུངས་འདུག་པ་རིམ་བཞིན་སྟོད་མངའ་རིས་སྐོར་གསུམ་དང་།",
    "གནས་ཀྱང་ཤིན་ཏུ་ཉམས་དགའ་བ་རྭ་སྒྲེང་དང་ཕྱོགས་མཚུངས་ཤིག་ཡིན་ཚོད་འདུག་པ་དེང་སང་བདག་པོས་དབེན་སྟབས་གཙུག་ལག་ཁང་སོགས་ལ་ཕྱུགས་ར་བྱེད་ཀྱིན་ཡོད་ཟེར་བ་ཐོས།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ནའི་སྒྲུབ་ཕུག་དང་ཕྱག་ཞབས་སོགས་ཀྱི་རྗེས་སོགས་གནས་ཡ་མཚན་ཅན་མང་པོ་ཡོད།",
    "རྡོ་ཡུལ་དང་ཉེ་སར་ལྷ་ལུང་གཡུ་མཚོ་ཡོད་པ་དེའི་ནང་དུ་མཐོང་སྣང་སྣ་ཚོགས་ཡོང་ཞིང་མཚོ་འཁྱག་དུས་འཁྱག་པ་མཎྚལ་གྱི་གཟུགས་ཅན་ལ་གླིང་བཞི་གླིང་ཕྲན་གྱི་བཀོད་པ་ལྟ་བུ་རང་བྱོན་དུ་འཆར་བ་མང་པོ་ཐོན་ཡོང་ཟེར།",
    "ཕག་གྲུ་སློབ་བརྒྱུད་དང་བཅས་པའི་གདན་ས་དགེ་ལུགས་སུ་བསྒྱུར་ཡོད་པ་མང་པོ་ཡོད་ཚོད་འདུག་འབྲུ་གུ་དང་ཉེ་སར་ཀ་དྲོད་ཟེར་བའི་གནས་སོགས་ཡོད།",
    "ཞན་ཤན་ནས་ཆེར་མི་རིང་བར་གོང་མ་ཤུན་ཊིའི་དམར་གདུང་དུ་གྲགས་པ་དཔོན་པོའི་ཉམས་ཅན་ལ་བཟང་པོའི་འདུག་སྟངས་ཅན་གྱི་ལྷ་ཁང་ཡོད།",
    "རྗེས་སན་ལུང་པས་པེའི་ཅིང་དང་ཅང་ནན་གཉིས་ཀྱི་བར་ན་ཡུལ་ཞིག་ཡོད་པ་དེའི་མི་རྣམས་ཀྱི་མིག་གྱེན་ཐུར་དུ་ཡོད་པར་གསུངས་པ་ཞན་དུང་ཡིན་ཚོད་འདུག་ལ།",
    "ངག་དང་རང་བཞིན་འཇམ་ཞིང་།",
    "ལག་ན་མཚོན་ཆ་སྣ་ཚོགས་ཐོགས་ཏེ་འགྲོ་ཡང་རང་བཞིན་འཇམ།",
    "ཡུརྟེ་ཤྲི་ཡ་ཡའམ་ཨོ་ཏེ་ཡ་ཟེར་ིནབའི་རྒྱལ་ཁམས་ཨོ་ཊི་ནའི་ཡུལ་ཡིན་ཚོད་འདུག་ཡུལ་དེ་ཉིད་དྲོ་གྲང་ཕལ་ཆེར་སྙོམས་པ་ལ་ཅུང་ཟད་དྲོ་ཤས་ཆེ་བ།",
    "ཧོར་ཡུལ་སོགས་ལི་ཡུལ་ངོས་བཟུང་འདུག་ཀྱང་།",
    "སུམ་བྷ་མཁན་ཆེན་གྱིས་ཧོ་ཐོན་དང་རྒྱ་གར་གྱི་ཀླ་ཀློ་དག་ལ་ཁྱད་པར་ཆེན་པོ་ཡོད་ཅེས་གསུངས་འདུག་པ་དེ་ནི་ལེགས་པར་མ་བརྟགས་པའི་ཚིག་ཡིན་ལ།",
    "ཧོར་ཐུ་བ་རྒྱལ་པོས་བཞེངས་པ་ཡིན་ཚོད་དུ་འདུག་ལ།",
    "ཨ་ཀེ་མ་ཏ་སོགས་མཁས་པ་དང་གྲུབ་ཐོབ་པ་མང་ཙམ་བྱུང་འདུག་པ་ཐམས་ཅད་གང་ཟག་ཕལ་པ་ཡིན་ཟེར།",
    "ཏེ་ཕཱ་ར་ཐ་ཨ་ཙི་སི་ཁོན་དང་།",
    "རྒྱལ་པོའི་ལག་པ་བཏེགས་མ་ཐག་ཨིརྐ་མེ་ཏ་རང་ཉིད་ཀྱིས་གྲུའི་ནང་ན་འཕྲུལ་འཁོར་ཡོད་པ་བསྐྱོད་དུ་བཅུག་པས་དེ་མ་ཐག་གྲུ་ཁོ་རང་རྒྱ་མཚོར་ཞུགས་པ་དང་།",
    "ཡུལ་དེ་ཉིད་ཀྱི་རྒྱལ་པོ་ནི་ཡུལ་དེའི་མི་ཡོན་ཏན་ཆེ་ཞིང་རང་བཞིན་བཟང་བ་རྣམས་ཀྱི་ནང་ནས་བསྐོ་བར་བྱེད་པ་ཡིན་ཞིང་།",
    "དུས་འཁོར་ལུགས་དང་འགལ་ཚོད་ཆེར་མི་འདུག་སྟེ།",
    "རིམ་གྱིས་ཀླ་ཀློ་དག་ཡུལ་འདིར་འདུག་ཉེན་ཡོད་པར་དགོངས་ནས།",
    "རིགས་ལྡན་པ་ཁོང་རྣམས་ནས་ཀྱང་དེ་འདྲའི་རིགས་ཡོད་པའི་དོགས་ཟོན་བྱེད་ཀྱིན་ཡོད་འདུག་པས་དེ་ཙམ་ལས་མ་སྤྲོས་སོ།",
    "བོད་ཀྱི་མི་དེར་སླེབས་པ་ཆེར་མེད་འདུག་པས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་གསན།",
    "ཞེས་གསུངས་ཞེས་བཀོད་འདུག་ཕྱིས་དགའ་བ་གདོང་དུ་བཞུགས་དུས་ཀྱང་དེ་འདྲ་མང་དུ་བྱུང་སྟེ།",
    "མི་གོ་བར་འདུག་ཞུས་པས།",
    "ངས་ད་ལྟ་ས་བོན་བཏབ་པ་འདི་རྣམས་ཀྱིས་ཀྱང་རྐྱེན་བྱས་ནས་ལེགས་པར་གོ་བ་ཞིག་མྱུར་དུ་འོངས་པར་འདུག་ཅེས་གསུངས་སོ།",
    "དེ་བས་བོད་དུ་བཞུགས་ནས་འཇམ་པའི་དབྱངས་ལ་གསོལ་བ་བཏབ་ན་མྱུར་དུ་རྗེས་སུ་འཛིན་པར་འདུག་གསུངས་ནས་བཤོལ་བཏབ་པས།",
    "ཉམས་སྣང་རང་ག་བ་མིན་པས་གསོལ་བ་དྲག་ཏུ་ཐོབ།",
    "ཚུལ་འདི་བསམ་ཞིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "ཕྱེད་འོག་མས་ཀྱང་རང་རྒྱུད་ཉིད་སྤངས་སོ་ཞེས་ཟེར་བ་དེ་ནི་ཤིན་ཏུ་མ་འབྲེལ་ཏེ།",
    "ཕངས་པ་དང་རང་ཉིད་ཀྱང་ལུགས་དང་ལུགས་མིན་ཤེས་པ་ལ།",
    "ཀུན་རྫོབ་དེས་གང་ཞིག་བདེན་པར་སྣང་ཞིང་རང་བཞིན་མེད་བཞིན་དུ་སོ་སོར་སྣང་བ་དེ་ནི།",
    "བདེན་པ་གཉིས་སུའང་རང་དེབ་བདུན་པ།",
    "སད་ཀྱང་མི་བླུན་པོ་ལ་ཆགས་པ་སྐྱེ་བར་འགྱུར་བ་དེ་བཞིན་དུ་འགགས་ཤིང་རང་བཞིན་ཡོད་པ་མིན་པའི།",
    "དེའི་རྣམ་པ་ཅན་གྱི་བློ་ཡང་རང་བཞིན་མེད་ཅེས་པའི་དོན་འདི་ཤེས་པར་གྱིས་ཤིག།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པའི་རྒྱུ་ཅན་གྱི་དྲན་པ་མི་སྲིད་པ་ཉིད་དོ།",
    "གཞན་ཡང་རང་རྒྱུད་དུ་བཀོད་པ་ཉིད་ཀྱི་གཏན་ཚིགས་ཀྱི་ཕྱོགས་ལ་གལ་ཏེ་སྒྲུབ་བྱེད་ཀྱི་གཏན་ཚིགས་དང་།",
    "ཅི་སྟེ་ཡང་རང་དོན་རྗེས་དཔག་དང་།",
    "ལྷ་མ་ཡིན་གཏོར་མ་དེ་ཁྲི་ལ་འདུག།",
