    "དུ་བ་འཐུལ་ན་མི་གདའ་བར་འགྱུར།",
    "དུ་བ་འཐུལ་ན་ནི་མི་གདའ་བར་འགྱུར་རོ།",
    "ན་མ་སརྦ་ཏ་ཐཱ་ག་ཏེ་བྷྱོ་བྷ་ག་བདྡྷྱ་ཨོྃ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྚ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ཀ་ར་བཱི་རའི་མེ་ཏོག་དུས་གསུམ་དུ་བརྒྱ་རྩ་བརྒྱད་ཞག་བདུན་གྱི་བར་དུ་སྦྱིན་སྲེག་བྱས་ན་ཁྲག་འཛག་པར་འགྱུར་རོ།",
    "འདི་སྐད་དུ་མིག་སེར་མ་འདུག་ཤིག་འདུག་ཤིག་ཅེས་སྨྲས་ན་འདུག་ཤིག་འདུག་ཤིག་ཅེས་བྱ་བ་ཐོས་ནས་བདག་ནི་རྨ་ཕབ་བོ་སྙམ་སྟེ་ངུ་འབོད་ཀྱི་སྒྲ་ཆེན་པོ་ཕྱུང་ནས་མེད་པར་འགྱུར་ཏེ།",
    "དེའི་འོག་ལོགས་སུ་སྒྲུབ་པ་པོ་སྙིམ་པ་ཟེད་ཅིང་འདུག་པར་བྱའོ།",
    "ཡང་ན་ངོས་ཀུན་དུ་ཁྲུ་བཅུ་པའི་དཀྱིལ་འཁོར་སྐྱོང་ནུལ་གྱིས་བྱུགས་ཏེ་དེར་མེ་སྦར་ལ་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ནས་བེ་ཀང་ཀ་ཏའི་ཡམ་སྲེག་ཤིང་སྲིད་དུ་ཁྲུ་གང་སྦོམས་སུ་ཆང་བར་འཁྱུད་པ།",
    "མི་སྨྲ་བར་འདུག་ཅིང་དུས་གསུམ་དུ་ཁྲུས་བྱའོ།",
    "ས་ལ་དཀྱིལ་འཁོར་གྲུ་བཞིར་སྐྱོང་ནུལ་དུ་བྱུགས་ལ་ཀུ་ཤའི་སྟན་བཏིང་ལ་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ནས་གཙང་སྦྲ་དང་།",
    "ནུབ་ཕྱོགས་ཕྱོགས་པ་དེ་འདུག་བཞིན།",
    "ནུབ་ཕྱོགས་ཕྱོགས་པ་དེ་འདུག་བཞིན།",
    "བྱ་རོག་ས་ལ་འདུག་ནས་ནི།",
    "སྲེད་མེད་བུ་ཡང་ལྷོ་ཕྱོགས་འདུག།",
    "དྲན་པ་ཙམ་གྱིས་མྱུར་དུ་མདུན་ན་འདུག་པར་འགྱུར་རོ།",
    "ལྷགས་ནས་ཁྱབ་འཇུག་ནི་བཅོམ་ལྡན་འདས་ཀྱི་གློ་གཡོན་ཕྱོགས་སུ་འདུག་གོ།",
    "ལྷ་ཆེན་པོ་ནི་གཡས་ཕྱོགས་སུ་འདུག་གོ།",
    "སྨིན་དྲུག་མ་ནི་འཛེམ་བཞིན་དུ་རྒྱབ་ལོགས་སུ་འདུག་གོ།",
    "དཀའ་ཟློག་མ་ནི་མདུན་ཕྱོགས་སུ་འདུག་གོ།",
    "ཚོགས་རྣམས་ནི་གཡོན་ཕྱོགས་སུ་འདུག་གོ།",
    "སཏྱ་བཱ་ཙ་ནེ་ནས་ཏྱ།",
    "ཡི་དགས་དེས་འོ་ཐུང་འཐུངས་ནས་འཆི་བར་འགྱུར་ཏེ་དེའི་ལག་ན་ལྡོང་རོས་འདུག་པ་བླངས་ནས་དེ་ཐོགས་པས་ལག་ན་རྡོ་རྗེ་དང་མཐུ་སྟོབས་མཉམ་ཞིང་བསྐལ་པར་གནས་པར་འགྱུར་རོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་བ་རྩྭ་ཀུ་ཤའི་སྟན་གྱི་སྟེང་དུ་འདུག་པའི་ལག་པ་གཡས་པས་མནན་ལ་འབར་བར་གྱུར་གྱི་བར་དུ་བཟླས་བརྗོད་བྱས་ན་འགྲུབ་པར་འགྱུར་ཏེ།",
    "གསང་ཆེན་དང་བཅས་པ་དེའི་ལག་ཏུ་འདུག་པར་འགྱུར་ཏེ།",
    "ཁྲོས་བཞིན་དུ་མཚན་གཅིག་འདུག་པའི་སྟེང་དུ་ལག་པས་མནན་ཏེ་བཟླས་བརྗོད་བྱས་ན་དེ་མ་ཐག་ཏུ་དགྲ་མེད་པར་འགྱུར་རོ།",
    "སྐྲ་གྱེན་དུ་འགྲེང་ལ་ས་ལ་ལྟ་ཞིང་འདུག་པ་བྲིས་ཏེ།",
    "བཞི་པ་ནི་ཆུས་བྱས་ལ་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ནས།",
    "ལག་ན་རྡོ་རྗེ་ལ་ལྟ་ཞིང་འདུག་པར་བྲིའོ།",
    "ལྷ་ཆེན་པོ་ནི་བཅོམ་ལྡན་འདས་ཀྱི་གློ་གཡོན་ཕྱོགས་སུ་འདུག་གོ།",
    "སྤྱན་གྱི་གཡས་ཕྱོགས་སུ་འདུག་གོ།",
    "དྲུག་མ་དང་དཀའ་ཟློག་མ་ནི་རྒྱབ་ལོགས་སུ་འདུག་སྟེ།",
    "གདོང་དྲུག་པ་རྡོ་རྗེ་གསུམ་པ་འདུག་པར་ཡིད་ཀྱིས་བསམས་ལ།",
    "ཨོྃ་ལོ་ཙ་ནི་པྲ་བ་རི་བྷྲ་མ་རི་ནི་སུམྦྷ།",
    "དགྲ་བསད་པར་འདོད་ན་དགྲ་གང་ན་འདུག་པ་དེ་ལོགས་སུ་ཁ་བལྟས་ཏེ་ཞག་བདུན་གྱི་བར་དུ་དུས་གསུམ་དུ་ལན་བརྒྱད་བརྒྱ་བརྒྱད་བརྒྱ་བཟླས་བརྗོད་བྱས་ན་ཞག་བདུན་གྱི་ཉིན་པར་དགྲ་འཆི་བར་འགྱུར་རོ།",
    "དྲག་ཤུལ་ལ་ནི་རྐང་པས་རྐང་པ་མནན་ཏེ་འདུག་པར་བྱའོ།",
    "དེ་ནས་མེའི་དབུས་སྔོ་བྲེ་ངེར་འདུག་པ་དང་།",
    "བདག་འདུག་པ་དང་བགེགས་ཐམས་ཅད་མི་འབྱུང་ཞིང་རིག་སྔགས་ཀྱང་འགྲུབ་པར་འགྱུར་རོ།",
    "རིག་སྔགས་འདི་ཞག་བདུན་གྱི་བར་དུ་དབེན་པར་འདུག་ལ་གཅེར་བུའམ་ཡང་ན་ཁྱེད་རིངས་སུ་བྱས་ཏེ།",
    "ལག་ན་རྡོ་རྗེ་ཡང་རིག་སྔགས་ཐམས་ཅད་ཀྱིས་བསྟོད་ཅིང་འདུག་པར་བྲིའོ།",
    "བསྲེག་པའི་རང་བཞིན་ཅན་གྱིས་ལག་ན་རྡོ་རྗེ་གཙོ་བོར་བྱས་ནས་དེ་བཞིན་གཤེགས་པ་ཤཱཀྱ་ཐུབ་པའི་སྤྱན་སྔར་འདུག་གོ།",
    "གཅིག་ལ་གཅིག་ངོས་སྦྱར་ནས་གཡོན་པའི་མཐེའུ་ཆུང་སྟེང་ན་འདུག་པའི་ཚིགས་ཀྱི་སྲུབས་བཞག་སྟེ།",
    "མཱ་མ་ཀཱིའི་ཕྱག་རྒྱའི་ཚོགས་བྲིས་པ་གང་ན་འདུག་པ་དེ་ནང་ཕོ་ཉ་མ་རྣམས་ཀྱི་ཚོགས་ཀྱིས་བསྐོར་བ་ཡང་གནས་སོ།",
    "ཀུ་ཤའི་སྟན་ལ་འདུག་སྟེ་རྡོ་ལེབ་ཤིན་ཏུ་བཀྲུས་པ་ལ་དབྱིག་དང་གསེར་བཀྲམ་ནས།",
    "རྒྱལ་བའི་སྟེགས་བུའི་སྟེང་དུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ཀྱི་ཆང་ཟུངས་དྲང་པོར་འདུག་པར་བྱའོ།",
    "རྡོ་རྗེ་རྟགས་ཀྱི་ནི་དེ་ཉིད་ལ་དབུས་ནས་འབྲས་བུ་འདུག་པ་ཡིན་ནོ།",
    "དེའི་གཡས་ལོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་དྲང་པོར་བྱས་ལ་པདྨའི་སྟེང་ན་འདུག་པར་བྲིའོ།",
    "སྡོང་བུ་དང་བཅས་པར་འདུག་པར་བྱས་ལ།",
    "དེའི་གཡོན་ལོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་པ་ཁ་གཉིས་པ་དབུས་དྲང་པོར་འདུག་པར་བྲིའོ།",
    "མཆེ་བའི་སྟེགས་ནི་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ཀྱི་ཆང་ཟུངས་དྲང་པོར་འདུག་པར་བྲིས་ལ།",
    "དེའི་གཡས་ལོགས་སུ་པདྨ་ཁ་མ་བྱེ་བ་ལ་མཆེ་བའི་ཕྱིར་དགུ་བོར་འདུག་པར་བྲིའོ།",
    "དེ་གཉིས་ཀྱི་བར་ན་རྡོ་རྗེ་གསུམ་ཁ་གཉིས་པ་དབུས་ནས་འབྲས་བུ་འདུག་པ་སྦྲུལ་གྱི་མཇུག་མའི་སྟེང་ན་འདུག་པར་བྱའོ།",
    "ཞགས་པའི་ནི་སྟེགས་བུའི་སྟེང་དུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ནས་འབྲས་ལྟར་འདུག་པར་བྱའོ།",
    "རལ་གྲི་ནི་སྟེགས་བུའི་སྟེང་དུ་རལ་གྲི་བྲིས་ལ་དེའི་གཡོན་ལོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ནས་འབྲས་བུ་འདུག་པར་བྱའོ།",
    "དབྱུག་པའི་སྟེགས་བུའི་སྟེང་དུ་དབྱུག་པ་གླ་གོར་ཞོ་ཤའི་ཤིང་ལྟར་འདུག་ཅིང་།",
    "དེའི་གཡས་ལོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ནས་འབྲས་བུ་འདུག་པར་བྱའོ།",
    "དགེ་སློང་ཅིག་ཤོས་ནི་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ཏུ་གཞུག་ཅིང་གཟུགས་བཟང་མ་བཟླས་བརྗོད་བྱེད་བཞིན་དུ་གཞུག་པར་བྱའོ།",
    "ང་གང་ན་འདུག་པ་དེ་ན་ཕྱག་རྒྱ་གནས་ལ།",
    "ཕྱག་རྒྱ་གང་ན་གནས་པ་དེ་ན་ང་འདུག་སྟེ།",
    "དེ་ལྟར་འདུག་བཞིན་དུ་བཀུག་པ་ནི་རྡོ་རྗེ་གདུ་བུའི་ཕྱག་རྒྱའོ།",
    "རྟག་ཏུ་འདུག་པར་བྱ་བ་ཡིན།",
    "ཤེས་རབ་ཅན་གྱིས་ཐིག་ཀྱང་གདའ།",
    "བདག་ཉིད་གཡོན་ཕྱོགས་ངོས་ལ་འདུག།",
    "དངོས་གྲུབ་སྒོ་དྲུང་འདུག་པར་བྱ།",
    "འདུག་ནས་སྒྲ་ཆེན་གདོན་པར་བྱ།",
    "དེ་ཡི་སྟེང་དུ་འདུག་ནས་ནི།",
    "འདུག་ནས་ཀྱང་ནི་བཟླས་བརྗོད་བྱ།",
    "རྟག་ཏུ་ཀུ་ཤའི་མལ་སྟན་འདུག།",
    "དེ་ནས་ཀུ་ཤའི་སྟན་འདུག་ཅིང་།",
    "རྟག་ཏུ་ཤར་ཕྱོགས་ཁ་བལྟ་འདུག།",
    "དག་པས་ཤར་ཕྱོགས་བལྟས་ཏེ་འདུག།",
    "ཤིན་ཏུ་མཉམ་གཞག་དུས་གསུམ་དུ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་རྟག་ཏུ་ཞམ་རིང་ན་འདུག་ཅིང་གཡོན་ཕྱོགས་ན་གནས།",
    "ཨ་ཏེ་ན་སཾ་ཏྱཾ་བཱ་ཙ་ནེ་ན།",
    "ཤར་ཕྱོགས་བལྟ་ཞིང་འདུག་པར་བྱ།",
    "ཨ་པ་ཡཱ་མི་བཱ་པི་ཙ་ནུ་ས་ར་ས་ར་སརྦ་ཡཀྵ་ཧྲྀ་ད་ཡཱ་ནི་ཨ་པི་བ་པི་ཙ་སོ་ནི་སོ་ནི།",
    "མཆོག་རྣམས་ཀྱི་ནི་མདུན་དུ་འདུག།",
    "ཤིན་ཏུ་མཉམ་གཞག་དུས་གསུམ་དུ།",
    "རྒྱན་སྣ་ཚོགས་ཀྱིས་བརྒྱན་པ་པདྨ་རྩ་བ་དམར་པོའི་སྟེང་ན་འདུག་སྟེ།",
    "ལག་པ་གཡས་པ་དབུགས་འབྱིན་པའི་ཚུལ་དུ་འདུག་པ་བྲི།",
    "ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ནས།",
    "གཟུགས་ཀྱི་དྲུང་དུ་འདུག་ནས་ནི།",
    "དེ་བཞིན་གཟུགས་ཀྱི་དྲུང་འདུག་ཅིང་།",
    "བཱ་ཙ་ནི་ན་བཱ་ཙ་ནེ་ན་ས་ཏྱེ་ན་བཛྲེ་ཎ།",
    "ཚུལ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་ལ་བཟླས་བརྗོད་ཅིང་མིང་བརྗོད་པར་བྱའོ།",
    "ཨོྃ་ཀ་མ་ལ་ལོ་ཙ་ནི་མ་ནི་མ་ནུ་ཥུ་པཉྩ་ལི།",
    "ཨོྃ་བི་ཀ་ཊ་དུ་མུ་ཁི་དྃཥྚྲ་ཀ་རཱ་ལོ་ཛྭ་ལི་ཏ་ལོ་ཙ་ནི།",
    "ཉི་མ་ལྔ་ན་མདུན་ན་འདུག་གོ།",
    "བྲམ་ཟེའི་གཟུགས་ཀྱིས་མདུན་དུ་འདུག་སྟེ།",
    "རང་རང་གནས་སུ་དགོད་པར་བྱ།",
    "འདི་ཉིད་ཀྱིས་རྣམ་ཐོས་སྲས་ཀྱི་ཁང་པར་འདུག་ན་གསང་བའི་མཐའ་དང་བཟླས་པའི་མཐའ་ལ་ཤིན་ཏུ་མྱུར་བར་རྫས་བླངས་ནས་སྟེར་བར་བྱེད་དོ།",
    "ཉི་མ་གཉིས་པ་ལ་མདུན་དུ་འདུག་ཅིང་གཏམ་སྨྲ་བར་བྱེད་དོ།",
    "ཉི་མ་གསུམ་པ་ལ་རིངས་པར་འོངས་ཤིང་མདུན་དུ་འདུག་ནས་འདི་སྐད་སྨྲ་བར་བྱེད་དོ།",
    "མར་དང་འོ་ཐུག་སྦྱིན་ཞིང་ཀུ་ཤའི་ཁྲི་ལ་འདུག་སྟེ།",
    "མུན་པ་མུན་ནག་ཆེན་པོར་འདུག་པ་དེ་དག་ཐམས་ཅད་ཀྱང་གསལ་བར་སྣང་བར་གྱུར་ཏོ།",
    "བཅོམ་ལྡན་འདས་སྣང་བ་རྒྱ་ཆེན་པོ་ཀུན་དུ་གདའ་བ་འདི་སུའི་ལགས།",
    "གཤིན་རྗེའི་འཇིག་རྟེན་གྱི་སྡུག་བསྔལ་ཐམས་ཅད་མི་གདའ་བར་གྱུར།",
    "ནུབ་ཕྱོགས་སུ་མཆི་བར་གདའ་བ་འདི་སུའི་ལགས།",
    "མཆེ་བ་མནན་ནས་མེ་ལྕེ་ཆེན་པོ་ལྟར་སྨ་ར་སེར་ཞིང་འཇིགས་འཇིགས་ལྟར་འདུག་སྟེ།",
    "དེ་ལྟ་བུའི་གཟུགས་སུ་འདུག་པའི་རྐང་པ་གཉིས་ལས་ཁྲོ་བོ་འབར་ཞིང་འཇིགས་འཇིགས་ལྟར་འདུག་པ།",
    "དེ་ནས་གསང་བ་པའི་བདག་པོ་ལག་ན་རྡོ་རྗེ་ཅང་མི་སྨྲ་བར་འདུག་སྟེ།",
    "དེ་སྐབས་ཇོ་བོ་རྗེ་དབུས་ཀྱི་ཀ་ཆེན་ཛྷཱ་ན་ཤྲཱི་མི་ཏྲའི་ཉེ་གནས་ཡིན་འདུག་ནཱ་རོ་པ་རྒྱ་གར་ཤར་ཕྱོགས་སུ་བྱོན་པ་ལྗོངས་མེ་ཏོག་རྒྱས་པར་དཔལ་ནཱ་རོ་པ་དང་མཇལ།",
    "པཎྜི་ཏ་དེ་ནི་ནཱ་རོ་པས་ཀྱང་ཞེ་ས་འབུམ་དགོས་པ་ཞིག་འདུག་ཅིང་།",
    "དུས་དེར་བོད་རྣམས་བདེ་དགྱེས་གསང་གསུམ་ཁོ་ན་ཟེར་བའི་སྐབས་ཡིན་འདུག་པས།",
    "འདི་གཏོད་ཅིག་གསུངས་ཀྱིན་འདུག་གླུཅེས་གསུངས་ནས།",
    "ཁྱབ་བདག་དུས་འཁོར་དཔལ་ལྡན་རྡོ་རྗེ་སེམས།",
    "དེ་མིན་ང་འདིར་མ་བསྡད་ན་འདིས་གང་མིན་བྱས་ཉེན་འདུག་གསུངས།",
    "ཟངས་སྐུད་མིས་འདོན་པ་ཞིག་འོང་བར་འདུག་སྟེ་ཐབས་མེད་ཅེས་གནང་བ་དང་།",
    "ཆང་ཀ་པཱ་ལ་གང་གསོལ་ཞིང་འདུག་པ་དེ་གནང་ནས།",
    "ལས་སྟོད་ན་ས་ཕུག་ཅིག་ན་མི་ལའི་དངོས་སློབ་དགེ་ཚུལ་སྐུ་མཆེད་གཉིས་འདུག་པ་ལའང་གདམས་པ་ཞུས།",
    "ཀཾ་པོ་གནས་ནང་དུ་འབྱོན་དགོངས་ཙ་ན།",
    "དབེན་ཞིང་རང་བཞིན་སྟོང་པ་ཡི།",
    "གཞི་དང་རང་བཞིན་རྒྱུ་ཡིན་ཏེ།",
    "དེ་སེང་གེའི་ཁྲི་ལ་འཛེགས་ཏེ་འདུག་གོ།",
    "དེ་ཡང་རང་། རྒྱལ་གྱི་རིགས་སུ་མཐའ་གཅིག་ཏུ་ངེས་པ་མིན་ཏེ།",
    "མཐར་ཐུག་ཐེག་གཅིག་ཏུ་ངེས་པའི་རིགས་པ་དང་རྟེན་ཅིང་འབྲེལ་བའང་རང་བཞིན་མེད་དེ་ཕན་ཚུན་ཕྲད་ནས་སྐྱེད་པ་ལ་སོགས་པ་མ་གྲུབ་པའི་ཕྱིར་དང་།",
    "དེ་ཡང་རང་རྒྱུད་པ་རྣམས་ནི།",
    "དོན་དམ་དང་ཐ་སྙད་གང་དུ་ཡང་རང་ལུགས་སུ་རྣམ་པར་བཞག་པ་ཅུང་ཟད་ཀྱང་མེད།",
    "ཐ་སྙད་ཙམ་དུ་ཡང་རང་ལུགས་ཡིན་པར་ཁས་མི་ལེན་ཏེ།",
    "སུན་འབྱིན་ཕྱིན་ཅི་ལོག་ཏུ་རྒོལ་བའི་གཡོ་སྒྱུ་ཅན་དུ་འགྱུར་ན་ཡང་རང་ལ་བཞག་པར་བྱ་བའི་ཕྱོགས་ཅུང་ཟད་ཀྱང་མེད་ན་དེའི་སྒྲུབ་བྱེད་འཚོལ་བའི་ངལ་བ་མི་དགོས་ལ།",
    "འབྲས་བུའི་སྐབས་སུ་རང་རྒྱུད་པ་ཁ་ཅིག་དེ་བཞིན་གཤེགས་པ་ལ་གནས་གྱུར་པའི་ཡེ་ཤེས་སྒྱུ་འདུགམ་ལྟ་བུ་ཁས་བླངས་ནས།",
    "གནས་ཚུལ་རྟ་གླང་རང་མཚན་པར་ཞེན་འཛིན་ཡོད་མེད་ཀྱི་ཁྱད་པར་བྱུང་བ་ལྟར།",
    "སྤྱིར་སེམས་ཀྱི་གནས་ཚུལ་ལ་ངོ་བོ་དང་རང་བཞིན་དང་མཚན་ཉིད་དམ་རྣམ་པ་གསུམ་གྱི་ཐ་སྙད་བཞག་ཀྱང་དོན་དུ་སེམས་། ཀྱི་ངོ་བོ་ཉིད་ལས་གཞན་མིན་ཏེ།",
