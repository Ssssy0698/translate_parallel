    "སྐྱོན་ཡིན་པ་འདུག་ཀྱང་སྡུག་ཞེན་བྱས་ནས་ཡོན་ཏན་ཅན་དུ་སྒོམ་མཁན་ཞིག་མ་ཡིན།",
    "ངེད་ལ་ཕྲག་དོག་སྡང་སྨྲས་བྱེད་ཀྱི་ཡོད་པར་འདུག།",
    "སྐབས་འདིར་ཡང་ར་ལུང་པ་ལ་ངེད་ཞེ་མ་སྡུག་ཡོད་ཀྱི་དོགས་པའི་རབ་བེ་རིབ་བེ་ཡིན་པ་འདུག་ནའང་།",
    "རང་ལ་མི་གནོད་པའི་བག་ཡོད་མཚམས་ཚིགས་ཟིན་པ་ཞིག་ནི་དགོས་རྒྱུར་འདུག།",
    "ཁོང་རང་རྣམས་ཀྱིས་ཡར་མར་དཀྲུགས་པ་ཡིན་ནའང་།",
    "ར་ལུང་ནས་སོགས་གཞན་རྣམས་ཀྱི་རྩར་ཁོང་རང་རྣམས་ཀྱིས་ལེགས་སམ་བྱས་གྱུ་བ་དང་།",
    "བརྟག་པ་ལ་ཆུག་གམ་མི་ཆུག་ཕེབས་ཀྱིན་འདུག།",
    "དབུས་ལ་ཕེབས་བསྐྱིལ་གྱི་སྐོར་ལ་གླེང་བརྗོད་སྣ་ཚོགས་ཤིག་འདུག་ཀྱང་།",
    "ལ་ལ་ཚོ་ཉེ་གནས་ཀྱིས་ལོངས་སྤྱོད་པ་ཞིག་གདའ།",
    "སྐུ་དོན་གསར་པ་གཞན་གང་ཡང་མི་འདུག་པས།",
    "དུས་ཐུག་པས་ཐེགས་གོང་སླེབས་མི་ཐུབ་པར་འདུག་ནས།",
    "དགྲ་ངོས་ལེན་བྱེད་རྒྱུའི་ཁུངས་བྱེད་ཀྱིན་འདུག།",
    "གང་དང་གང་བསྒོམས་པ་དེ་དང་དེ་གསལ་བར་སྣང་བའི་ཚུལ་ནི་ལོས་ཡིན།",
    "སྟོང་རྐྱང་དུ་འདུག།",
    "དེ་ཙམ་ལ་རག་མ་ལུས་པའི་སྟོང་པ་དེ་མཐར་གཏུགས་ན་བདེ་བར་འདུག།",
    "ཤར་ཙམ་ཉིད་ནས་ཀུན་རྫོབ་གཟུང་འཛིན་གྱི་དྲི་མས་མ་གོས་པ་ཞིག་འདུག་པ་དེ་ཉམས་སུ་ནི་མྱོང་།",
    "དེ་ཙ་ན་གཞན་མཁས་པ་ཡིན།",
    "དེ་ལྟར་སྨོས་པ་དེ་དང་རྗེས་མཐུན་པ་ཙམ་ལོས་ཡིན།",
    "ལན་ཅིག་བྱུང་ནས་ཉམས་རྒྱུ་ཡང་མི་འདུག་གོ།",
    "འདི་ཐུགས་རྡོ་རྗེའི་རིམ་པའི་གཟུགས་བརྙན་ཙམ་དུ་གདའ་ལགས།",
    "མེད་ཀྱང་རང་གཅིག་པུས་མི་ཕྱུགས་ཐམས་ཅད་འདེད་ཐུབ་པ་ཡིན།",
    "འདྲ་སྐུ་རང་ཡིན་ཟེར་ཡང་ཟེར་ཡིན་ཡང་ཡིན་ཡོད་པར་འདུག།",
    "ཞིབ་ཏུ་བརྟགས་ན་སྐུ་བཞུགས་དུས་ཀྱི་རྣམ་ཆ་ཡང་ངེས་པར་འདུག་ཅིང་།",
    "མ་མིན་པ་ཞིག་འདུག།",
    "སྐྱེ་བ་འདིའི་ཕྱི་མ་ཞིག་ལ་ནི་དེ་ལས་ཀྱང་མི་འགྲུབ་པ་ཞིག་འདུག།",
    "མགོན་ཁང་འོག་ན་ཕུར་པའམ་རྙིང་མ་ལྷ་ཁང་ཡིན་ཕེབས་པ་ཤིག་འདུག་པ་དེ་ལའང་ཉིན་གཅིག་རབ་གནས་བྱས།",
    "དེ་གོང་མ་གྲུབ་པས་དེ་ལོ་ཁྲིད་ཅིག་གནང་རྒྱུར་འདུག་པ་ལ་ཕན་ཐོགས་པར་མ་བྱུང་ཡང་།",
    "འདི་ཕྱོགས་ཕེབས་པའི་དུས་དང་ཉེ་བར་འདུག་ནས།",
    "དགོངས་བཞེད་ཀྱི་གཙོ་བོ་སྦྱོར་དྲུག་དང་ལམ་འབྲས་ཀྱི་སྐོར་སྔར་མ་གསན་འདུག་པ་དང་།",
    "ནེ་གུ་རགས་རིམ་ཙམ་གསན་འདུག་ཀྱང་།",
    "ལས་འབྲེལ་རྣམ་པར་དག་ཅིང་དམ་གཙང་བའི་རྟགས་ཤིག་ཅིས་ཀྱང་ཡིན་པ་འདུག།",
    "བཟོ་བོ་ལག་བདེ་ཤོས་རང་མི་འདུག་ཀྱང་ཞལ་རས་མཚར་ཞིང་ཚུགས་ཀྱང་བཟང་བར་བྱུང་།",
    "ལར་ཁོང་པ་ལ་ནོར་ཆེན་པོ་ཡོད་འདུག་ཅིང་།",
    "ཤི་རྗེས་ནོར་ཐམས་ཅད་ས་སྐྱ་རང་ནས་བཞེས་འདུག་པས།",
    "རྒྱུ་གང་ཡིན་ཡང་མི་ཤེས་པའི་རིགས་གཅིག་བྱུང་འདུག།",
    "ནོར་ལ་མིག་ཉེ་ཤོས་འདི་ཚོ་ཞེད་པར་གདའ།",
    "སྒྲུབ་གནས་ཆེན་པོའི་བླ་བྲང་རྙིང་པའི་གདོང་དེ་ན་ཐབ་ཚང་སོགས་ཁང་པ་སྐྱལ་སྐྱོལ་འཇིགས་ལ་ཁད་དུ་མ་འདུག་པ་རྣམས།",
    "ངེས་པར་མཇལ་དགོས་འདུག་གསུང་།",
    "ཞལ་རས་སྐུ་གཟུགས་ཀྱི་གཙོ་བོར་འདུག་པས།",
    "པའི་སྲོལ་ཞིག་དུས་ཕྱིས་ཕལ་ཆེར་ལ་འདུག་སྟེ།",
    "བྱིས་བློ་ཙམ་གྱི་གཡོ་ཟོལ་དུ་འདུག།",
    "ཁག་ཆེ་ཤོས་ལ་གལ་ཆུང་བྱས་པའི་ཉེས་པ་ཞིག་ཀྱང་ཡོང་བ་འདུག།",
    "འགངས་མེད་བྱས་ཀྱང་ཐམས་ཅད་དེ་ཀ་ལ་རྡིབ་ནི་འགྲོ་བ་ཞིག་འདུག།",
    "རང་ལ་མེད་ཙ་ན་དེ་ལས་ཐབས་མི་གདའ།",
    "འདུག་ནི་བླུན་རྟགས་ཀྱི་གཏམ་དུ་འདུག་སྟེ།",
    "གླེན་པ་རྣམས་ཀྱི་རྣེ་མཆོག་ཏུ་དེ་འཛུལ་བ་ཞིག་ཀྱང་གདའ།",
    "ཡ་མཚན་ཅན་དགུ་བཅུ་རྩ་དྲུག་རང་དུ་འདུག་གོ།",
    "སྣེ་སྦྱོར་སྟག་ལུང་ནས་འབུལ་དཔོན་ཞིག་ཀྱང་འདུག།",
    "ཐ་གུ་སྣ་དབུས་གཙང་ལ་མི་སྣར་ཡོང་རིགས་སུ་འདུག་པས།",
    "ཐེག་ཆེན་གྱི་ལམ་རིམ་ཟབ་ལ་རྒྱ་ཆེ་བ་གོང་ན་མེད་པར་འདུག་པས།",
    "སྐུ་ཤིན་ཏུ་ལྟེམ་པར་འདུག་ནའང་ཐུགས་རིག་དྭངས་པར་འདུག་ཅིང་།",
    "སྐུ་མཐར་ཐོན་རང་མི་ཡོང་བ་འདུག་ནའང་།",
    "དེ་རྗེས་ཉི་མ་གཉིས་བསྙུང་གཞི་རང་ནི་ཆུང་ངུ་མི་འགྲོ་འདུག་ནའང་།",
    "གང་ཡོད་ལ་ནི་ཟ་འདྲེ་ལས་ངན་གྱི་བསྐོས་བ་པོ་གདའ།",
    "ཐོད་པ་གཉིས་སུ་བདུད་རྩི་མང་དུ་བབས་འདུག།",
    "གཏིང་ན་འཁྱིལ་བའི་རྣམ་པར་འདུག།",
    "ཤིན་ཏུ་ཁོགས་འདུག་པས་བརྟན་བྱེད་ཀྱི་ཐབས་དང་།",
    "ཁང་གཡོག་དེ་རྙིང་པའི་དུས་ན་ཉིས་ཐོག་ཏུ་འདུག་ཀྱང་།",
    "རྡོ་རྗེ་གདན་པས་མཛད་པར་བརྫུས་པའི་སྟོད་པའི་ལུགས་དེ་སྔ་ཕྱི་ཀུན་ཏུ་དར་བར་འདུག་ཀྱང་།",
    "རྣམ་འགྱུར་གང་ཡང་མི་ཡོང་བ་འདྲ་ཞིག་འདུག།",
    "ལ་ལས་ཟེར་ན་རྟོག་གེ་མགོ་མཁྲེགས་པོ་ཞིག་འདུག་ཟེར།",
    "ལ་ལས་ཟེར་ན་འཁྲུལ་ཞིག་ལྷོད་གྲོལ་བ་ཞིག་འདུག་ཟེར།",
    "ལ་ལས་ཟེར་ན་ལྟ་སྤྱོད་ངན་པ་ཞིག་འདུག་ཟེར།",
    "ལ་ལ་ཟེར་ན་བསམ་ངན་འཇིག་རྟེན་པ་ཞིག་འདུག་ཟེར།",
    "རྣམ་པ་ཐམས་ཅད་པ་ཞེས་པ་དེ་ཡིན་ཉེན་གདའ།",
    "ཉམས་འོག་ཏུ་ཆུད་པ་རྐྱང་འདུག་གོ།",
    "ཟླ་ཚེས་གང་ཡིན་བརྗེད་གདའ།",
    "ངེད་ལྷོ་སྐྱ་ནས་ཁ་བྱང་ལ་བསྟད་འདུག།",
    "དེ་འཕྲལ་ཕྱག་གཡོག་འགའ་བྱུང་ནས་ད་འབྱོན་རན་འདུག་ཟེར།",
    "དོན་ལ་ཡང་ཡིན་པ་འདུག།",
    "སྐུ་དོག་སེལ་བ་ལ་དཀའ་ཚེགས་ཆེན་པོ་རང་མེད་རིགས་སུ་འདུག་ནའང་།",
