    "དགེ་སློང་ད་དྲག་ཡིད་རངས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་གསུངས་པ་ལ་མདེན་པར་བསྟོད་དོ།",
    "བགོ་བཤའ་མ་བྱས་ཀྱི་བར་དུ་ཟ་བར་བ་བྱེད་ལ།",
    "བདེ་བར་གཤེགས་པ་མ་དེ་སྐད་གསུངས་ནས་གཞན་ཡང་སྟོན་པས་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དྲང་སྲོང་ཆེན་པོས་གསུངས་པ་བཞིན།",
    "ལྷ་བདག་བཀྲེས་ཀྱིས་ལྷ་ཉིད་ཀྱི་ཞལ་ཁམཅིག་པོ་དེས་གོ་བོབདག་ལ་ཕན་གདགས་པར་གསོལ།",
    "དགེ་སློང་དག་དེ་བསན་འདི་ལྟར་བསླབ་པར་བྱ་སྟེ་སྙན་བ་དག་སྦྱིན་ནོ།",
    "རྣམ་པ་ཐམསཅདམཁྱེན་པ།",
    "འདོད་པའི་འདོད་ཆགས་ཀྱི་ཀུན་ནས་བཀྲིས་པ་མེད་པར་གྱུར་ནས།",
    "ཉན་ཐོས་ཀྱི་ངག་འདུན་དང་བཅས་པ་མཉན་དུ་ཡོད་པ་ན་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་ཁྱིམ་བདག་མགོན་མེདཟས་སྐྱ་ན་གྱི་ཀུན་དག་འརབ་ན་བཞུགས་སོ།",
    "དགེ་སློད་དག་དབས་ན་འདི་ལྟར་བསླབ་པར་བྱ་སྟེ་སྦྱིན་པ་དག་སྤྱན་ནོ།",
    "མཉན་ངུ་ཡོདཔ་ནརྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་ཁྱིམབགམགོནམེད་ཟས་སྤྱན་གྱི་ཀུན་དགའར་བ་ན་བཞུགས་སོ།",
    "བཀུར་སྟེ་ཆེན་པོས་ཀྱང་བསྐུར་ཞིང་བསྟོད་པར་བྱའོ་ཞེས་ཀྱང་བྱས་སོ།",
    "ལྷ་བཟོད་པ་མཛད་དེ་ལྷའི་དགོངས་པ་རྫོགས་པར་མཛད་ལབདག་བདག་གསང་བའཐིས་སུ་སྩ་༩ བར་། བར་ཞེས་བྱས་སོ།",
    "དེ་ནས་དེ་ཡང་ཐབས་དེ་ཁོ་ན་ལྟརཟེས་པར་བསྟན་ཏེ།",
    "ཚེས་ལ་བཀུར་སྟི་བྱས།",
    "བདེབ་རགཤེགསཔས་དེསྐ་དགསུངས་ནས་གཞན་ཡང་སྟོན་པས་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏེ།",
    "པ་མ་དག་ལ་བཀུར་བྱས་པ།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་བ་མ་ལ་སྲིད་ཞུ་ཆེ་བའ་བསྔགས་པ་གསུང་བ་ནི་ངོ་མཚར་ལགས་སོ།",
    "དགེསློད་དག་ད་ལྟར་དེ་བཞིན་གཤེགས་པ་འདོད་ཆགས་དང་བྲལ་བ་ཞེ་སྡང་དང་བྲལ་བ་གཏི་མུག་དང་བྲལ་བ་སྐྱེ་བ་དང་རྒབ་དང་ནབ་དང་འཆི་བ་དང་མྱ་དན་དང་གླུ་སྔགས་འདོནཔ་དང་སྡུག་བསྔལབ་དང་ཡ་དི་མི་བདེབ་དང་འཁྲུག་པ་རྣམ་ལས་ཡོདཔ་སུ་གྲོལ་བཐམས་ཅད་མཁྱེནཔ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཡེ་ཤེས་དང་ཤེས་བྱ་ཐམས་ཅདལ་མངའ་བརྙེས་ཟིན་པ་ན།",
    "དེ་བུ་མེད་ད་བུ་འདོད་པའི་ཕྱིར་གུ་ལང་དང་ཆུ་ལྷ་དང་ཀུ་བེ་ར་དང་བརྒྱ་བརྒྱཀ་བྱིན་དང་ཆ་ངས་པ་ལསོགས་པ་དང་ལྷའི་ཁྱད་པར་གཞན་དག་ལ་ཡང་གསོལ་བ་འདེབས་ཏེ་འདིལྟ་སྟེ།",
    "དེ་ནས་དེས་བུ་ཆགས་པར་རིག་ནས་བུའིརི་མེ་གྲོ་བྱ་བའི་ཕྱིར།",
    "སྙན་པ་སྡུག་པ་ཡན་ལག་དང་ཉིད་ལག་ཐམས་ཅད་དང་ལྡནཔ་ཞག་བཙས་ནས་ང་བཙས་པའི་བཙས་སྟོན་བྱས་ནས་ཁྱེའུན་མང་ཇ་སྐད་གདགས་ཞེས་མང་འདགས་པར་བྱེད་དེ།",
    "གསེར་དང་དངུལ་གྱི་ཚོད་བྱས་སོ།",
    "ཚུར་སྐྱོན་དང་ལོངས་སྤྱོད་པར་བགྱིའོ་ཞེས་ཟེར་ནས།",
    "དགེ་སློང་དེ་ལྟ་བས་ན་འདི་ལྟར་བསླབ་པར་བྱ་སྟེ་ཐ་མ་ལ་བགུར་སྟེ་བྱའོ།",
    "བུས་པ་མ་གཉིས་ལ་དྲན་བསབས་པའམ་ཕན་བཏགས་པར་འགྱུར་རོ།",
    "དེའི་ས་ན་ནོར་ཡང་ཟད་པར་གྱུར་ལོངས་སྤྱོད་ཀྱང་ཟད་པར་གྱུར་ཏོ།",
    "པ་མ་གཉིས་རྒྱས་གནང་ནས་བཅོམ་ལྡན་འདས་ཀྱི་བསྟན་པ་ལ་རབ་ཏུ་བྱུང་ངོ།",
    "རྣམཔ་ཐམས་ཅང་མཁྱེན་པ་ཡེཤེས་༴",
    "ད་ནས་དྲང་སྲོད་དེ་མི་དགའ་བར་གྱུར་ནས་ངུ་བཞིན་ཕྱུང་ནསབྱ་གཅིག་བསྔག་པ་ལབྱ་བནབཞན་དུ་ལ་གོར་དུ་བླངས་ནས་བུ་འདི་ཅི་བྱེད་ཅེས་བྱས་སོ།",
    "དེ་ནས་ཉིན་པར་གྱི་བྱ་བ་བྱས་ཟིན་ཏེ།",
    "རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚིལ་འཕྱག་པར་མཛད་དོ།",
    "དགེ་སློང་དག་ལྔ་པོ་འདི་དག་ནི་ཕྱག་དར་བྱས་པའིའཐན་ཡོན་ཡིན་ཏེལྡ་གད་ཞེ་ན།",
    "ལྷ་རྣམས་མགུ་པར་འགྱུར་བ་དང་།",
    "ཡད་དག་པར་དགའ་བར་མཛད་དོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཚེས་ཀྱི་གཏམ་རྣམ་གྲངས་དུ་མས་ཡང་དག་པར་བསྟན།"
