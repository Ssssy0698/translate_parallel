    "ཀྱེ་མལྷའི་དབད་པོ་བརྒྱ་བྱིན་ལྷའི་ཚོགས་ཀྱིས་གཡོག་བྱས་པས།",
    "བཅོམ་པཉིད་མངོན་གསུམ་དུ་བྱས་སོ།",
    "དཔའ་རྒལ་བཞིན་དུ་བྱུང་ལ་གདོན་མི་ཟ་བར་འོང་བའི་ལས་རྣམས་བྱས་ཤིང་བསགས་ཏེ།",
    "དགེ་སློང་དག་ཁྱེད་ཉན་པར་འདོདདམ།",
    "བཅོམལྡན་འདས་ཉན་པར་འཚལ་ལགས་སོ།",
    "ནབ་ཟའི་ཁྱད་པར་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་ཕུལ་ནས།",
    "ཀྱི་རྣམ་པར་སྨིན་པ་དེས་ན།",
    "དགེསློང་དག་དེ་བས་ན་འདི་ལྟར་བསླབ་པར་བྱ་སྟེ་སྟོན་པ་ལ་བཀུར་སྟི་བྱའོ།",
    "ཡན་ལག་ལྔ་རྣམ་པར་སྡངས་པ་འགྲོབ་ལྔ་ལས་ཡང་དག་པར་འདསཔ་ཡན་ལག་དྲུག་དང་ལྡནཔ།",
    "རྟག་ཏུགནས་པར་བྱ་བ་དྲུག་ལ་གནས་པ།",
    "ལམ་ཡནལག་བརྒྱད་པ་སྟོ་ནཔ་མཐར་གྱིས་སྙོམས་པར་འཇུག་པ་དགུ་ལ་མཁས་པ།",
    "དེས་ན་མཉན་དུ་ཡོད་པར་ཕྱིན་ཏོ།",
    "སེར་བུའི་བསིལ་བཡ་ངལ་ངས་པ་ངོ་མཚར་ལགས་སོ།",
    "དགེ་སློང་དག་དེབཞིན་གཤགསཔ་ཉིད་ཀྱིས་སྔོན་ཚ་རབས་གཞན་དག་དུ་ཚོགས་རྙེད་ཅིང་རྐྱེན་གྲུབ་པ་དང་ལྡན་ཏེ།",
    "གདོན་མི་ཟ་བར་འོད་བའི་ལས་དདག་བྱས་ཤིང་བསགས་པས་ན།",
    "དགེ་སློང་དག་ལས་བྱས་ཤིང་བསགས་པ་རྣམས་ནི་ཕྱི་རོལ་གྱི་སའི་ཁམས་ལ་རྣམ་པར་སྨིན་པར་མི་འགྱུར།",
    "འབྲས་བུ་ཉིད་དུ་སྨིན་པར་འགྱུར།",
    "དེ་ནས་ཡང་དག་པར་རྫོགས་པའི་སངས་རྒྱ་མཚན་དན་ལྗོངས་རྒྱུ་ཞིང་གཤེགས་པ་ལས།",
    "ཤིང་ནམས་ཀྱང་མེ་ཏོག་དང་འབྲས་བུ་མེད་པར་གྱུར་ཏོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཡང་དག་པར་རྫོགས་པའིསངས་རྒྱ་སཙན་དན་གྱིས།",
    "རྒྱལ་པོ་ལ་ཅང་མི་གསུངབས་གནང་ངོ།",
    "དགེ་སློང་དག་དེབས་ན་འདི་ལྟར་བསླབ་པར་བྱ་སྟེ།",
    "བརྟེན་ཏེ་གནས་པར་བྱའོ་ཞེས་དགེ་སློང་ཁྱད་ཀྱིས་ད་ལྟར་བསླབ་པར་ཨདོཨུཞེགསུམགོངབྱའོ་བཅོམ་ལྡན་འདས་ཀྱིས་དེ་སྐདཅེས་བཀའསྩལ་ནས།",
    "ཐོངས་ཤིང་ཉམ་ཐག་པ་འདི་ལས་ཐར་བར་མཛད་དུ་གསོལ་ཞེས་བྱས་སོ།",
    "བསླབ་པ་གསུམ་ལ་ལེགས་པར་བསླབས་པ།",
    "བསྡུ་བའི་དངོས་སོ་བཞི་ལ་ཡུན་རིང་བོ་ནས་འདྲིས་པར་བྱས་པ།",
    "ཡན་ལག་ལྔ་རྣམ་པར་སྤངས་པ།",
    "མཐརགྱིས་སྙོམས་པར་འཇུག་པ་དགུ་ལ་མཁས་པ།",
    "འབྲས་བུ་འདི་ངུ་སྨཞི་པར་འགྱུར།",
    "དེས་སྐྱེ་བོ་ཕལ་པོ་ཆེ་དེ་དག་ལ་ཤནྟུ་ཏུ་གནོདཔར་གྱུར་ཏོ།",
    "ཅི་འདོད་པ་དེདག་རྣམས་ཅད་དེ་བཞིན་དུ་གྲུབ་པར་གྱུར་ཏོ།",
    "སློང་ཁྱེད་ཀྱིས་དེ་ལྟར་བསླབ་པར་བྱའོ།",
    "སུ་མ་དང་བ་དེ་དག་ནི་མཐུ་དང་ལྡན་པར་གྱུར་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་བསྟན་པ་ལ་སྣང་བ་ཞིག་ཡོད་པ་དེས་ཤྲམ་ཟེ་རྣམས་ལ་མཆོད་སྦྱིན་བྱས་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་བརྒྱ་བྱིན་གྱི་ཆ་ལུགས་སུ་བཞུགས་པ་གདན་གཤེམས་པ་ལ་བཞུགས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་བྲམ་ཟེ་རྣམས་དད་པར་གྱུར་པམཁྱེནནས།",
    "འབྲས་བུ་འདེ་ང་སྨིན་པར་འགྱུར།",
    "དེ་བཞིན་གཤེགས་པ་དགྲཅོམ་པ་ཡང་དག་པར་རྫོགས་པའིསངས་རིག་པདདཨུབ།",
    "འདེབར་གཤེགསོ་པ་འཇིག་རྟེན་མཁྱེན་པ་སྐྱེས་བུ་གདུལ་བྱའི་ཁ་ལོ་སྒྱུར་བ་བླ་ན་མེད་པ།",
    "བཅོམ་ལྡན་འདས་བཞེས་སུ་གསོལ་དང་།",
    "འབྲས་བུ་དང་ལྡན་པ་མང་པོས་ནི་བསྐོར་བཞིག་བྱས་སོ།",
    "བསྟན་པ་སྲུད་བ་གཅེས་པར་འཛིན་པར་གྱུར་ཏོ།",
    "དནས་ཚེ་དང་ལྡན་པ་ཀུན་དག་འབེས་ཇི་སྐད་ཐོས་པ་བཞིན་དུ་འཅོམ་ལྡན་འདསལགསོལ་ཏོ།",
    "བཙམ་ལྡན་འདས་ཀྱིས་བདག་ལ་གནང་བརམཛད་དུ་གསོལ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་གདན་བཤམས་པ་ལ་བཞུགས་སོ།",
    "ཕྱག་ནི་བཅབས་པར་རིག་ནས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ལྷའི་དབད་པོ་བརྒྱ་བྱིན་འཁོར་དང་བཅས་པ་ལ་ཆེས་གྱི་གཏམ་གྱིས་ཡང་དག་པར་བསྟན།",
    "ཡང་དག་པར་འཛིན་དུ་བཅུག་ཡང་དག་པར་གཟེང་བསྟོད།",
    "བཅོམ་ལྡན་འདས་ལ་བཀུར་སྟི་ཅི་དིག་འབར་གྱིས་ཤ་གཅེས་བྱས་སོ།",
    "དེནས་ལྷ་རྣམས་དང་མ་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་བཀུར་སྟེ་ཆེན་པོ་བྱས་སོ།",
    "བཙུནཔ་བཅོམ་ལྡན་འདས་ཀྱི་བསྟན་པ་ལ་འདི་ལྟ་བུའི་དགའ་སྟོན་པ་གྱིས་པ་ནི་དེ་མཚར་ལགས་སོ།",
    "དགེ་སློང་དག་ལས་བྱས་ཤིང་བསགས་པརྣམ་ས་ནི་ཕྱི་རོལ་གྱི་སའི་ཁམས་ལ་རྣམ་པར་སྨིན་པརམའགྱུར།",
    "ཁམས་དང་སྐྱེ་མཆེད་རྣམས་འབའཤ་ལ་རྣམ་པར་སྨིན་པར་འགྱུརངོ།",
    "འདིར་གསུངས་པ།",
    "དས་འཁོརབ་ནུབདེ་བ་ཆེན་པོ་ཉམས་སུ་མྱོད་ལད་ལྟར་དེ་བཞིན་གཤེགས་པར་གྱུར་པ་ན་ཡང་ང་ལ་འདི་ལྟ་བུའི་བཀུར་སྟི་བྱས་པ་ཡིན་ནོ།",
    "དགེ་སློང་དག་དེ་བས་ན་འདི་ལྟར་བསླབ་པར་བྱ་སྟེ།",
    "བྱས་ནས་བརྟེན་ཏེ་གནས་པར་བྱའོ་ཞེས་དགེ་སློང་ཁྱེད་ཀྱི་སདེ་ལྟར་བསླབ་བར་བྱའོ་། བཅོམ་ལྡན་འདས་ཀྱིས་དེ་སྐདཅེས་བཀའ་སྩལ་ནས།",
    "ཉན་ཐོས་ཀྱི་ངགེ་འདུན་དང་བཅས་པ་མཉན་དུ་ཡོདཔ་ནཚརྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཆལ་ཁྱིམ་བདག་མགོན་མེདཟས་སྦྱིན་གྱི་ཀུན་དགའར་བ་ན་བཞུགས་སོ།",
    "བསྡུ་བའི་དངོས་པོ་བཞིལ་ཡུན་རིང་པོ་ནས་འདྲིས་པར་བྱས་པ།",
    "ཡན་ལགལྔ་རྣམ་པར་སྤངས་པ།",
    "འགྲོ་བ་ལྔ་ལས་ཡང་དག་པར་འདས་པ།",
    "མཐར་གྱིས་སྙོམས་པར་འཇུག་པ་དགུ་ལ་མཁས།",
    "ར་བ་ས་པི་བདགཞི་བེ་དྷུ་རྱ་ལས་བྱས་པ་ཁྱེར་ཏེ་ངང་ཐད་དུ་འོངས་ན་ལེགས་སོ་སྙམ་དུ་དགོངས་སོ།",
