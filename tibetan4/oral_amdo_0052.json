    "མ་དང་སྲུ་མོ་ལ་སོགས་པའི་བུད་མེད་རྣམས་ཞེས་མཆན་འགྲེལ།",
    "གླིང་སྒྲུང་གཅེས་བཏུས་དེབ་བདུན་པ་མོན་གླིང་གཡུལ་འགྱེད་ཅེས་པ་ནི་གཅེས་བཏུས་ལེགས་སྒྲིག་བྱེད་པའི་སྤྱི་ཡོངས་ཀྱི་བསམ་བཀོད་དང་གཞི་རྩའི་བླང་བྱ་ལྟར་སྤྱི་ལོ་ལོའི་ཟླ་པར་བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་ནས་ལོ་དང་ཀན་སུའུ་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་ལོར་པར་དུ་བསྐྲུན་པའི་མོན་གླིང་གཡུལ་འགྱེད་ཅེས་པའི་སྒྲུང་དཔེ་རྨང་གཞིར་བཟུང་ཁར།",
    "རང་རེ་བོད་ཀྱི་མི་དམངས་ཀྱི་གཅེས་ནོར་གླིང་སྒྲུང་འཕེལ་རྒྱས་གཏོང་བའི་བྱ་གཞག་ཐད།",
    "ཞིབ་འཇུག་སོགས་བྱེད་པའི་སྐབས་སུ་དམིགས་བསལ་གྱིས་དོ་སྣང་བྱེད་དགོས་པ་ཞིག་རེད།",
    "བསྔགས་བརྗོད་དང་མཇུག་འཁྱོངས་ཡོང་བའི་སྐུལ་མའང་ནན་ཏན་གནང་བྱུང་བས།",
    "མཇུག་འཁྱོངས་ཡོང་བ་བྱེད་རྩིས་ཡོད།",
    "བསྟན་འཛིན་ཕུན་ཚོགས་བཅས་ལས་གྲུབ་པའི་མཐའ་མའི་ཞུ་དག་ཚོ་ཆུང་བཙུགས་ནས་གཅེས་བཏུས་འདིར་འགོ་ནས་མཇུག་བར་དག་བཅོས་གཏན་འཁེལ་བྱེད་པའི་འགན་ཡོངས་སུ་ཁུར་ཏེ་གཞན་གྱི་དགོངས་འཆར་ཡང་དག་རྣམས་ཉམས་ལེན་དང་བཅས་པར་མོན་གླིང་གཡུལ་འགྱེད་ཅེས་པའི་གླིང་སྒྲུང་གཅེས་བཏུས་དེབ་བདུན་པ་འདི་ལ་ཁྱོན་ཡོངས་ནས་དག་བཅོས་ལན་མང་ཞུས་པའི་ཁར།",
    "གླིང་སྒྲུང་གཅེས་བཏུས་དེབ་བདུན་པ་མོན་གླིང་གཡུལ་འགྱེད།",
    "གླིང་སྒྲུང་གཅེས་བཏུས་དེབ་བདུན་པ་མོན་གླིང་གཡུལ་འགྱེད་ནི་འཇམ་དཔལ་རྒྱ་མཚོས་ལེགས་པར་བསྒྲིགས་ཤིང་།",
    "རིམ་པ་ཁག་གི་དབུ་ཁྲིད་རྣམ་པ་དང་།",
    "མོན་གླིང་གཡུལ་འགྱེད།",
    "མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་བསྐྲུན་ཞིང་འགྲེམས་སྤེལ་བྱས།",
    "སྦྲག་ཨང་ཁ་པར་ཨང་གྲངས་མི་རིགས་དཔེ་སྐྲུན་ཁང་གི་སྐུལ་འོད་པར་སྒྲིག་ཁང་ནས་པར་བསྒྲིགས།",
    "འདི་ག་བདེ་སྲུང་བོད་གནས་ཉམས་ཞིབ་ཁང་གི་ལས་བྱེད་བཀྲ་ཤིས་རྒྱ་མཚོ་དང་།",
    "ཚེ་རིང་ལྷ་མོ།",
    "བོད་ཡིག་གི་ཚིག་འགྲོས་ཅི་བཞིན་བསྒྱུར་འདུག་པས།",
    "ང་ཚོར་ཤེས་ཚད་དང་ཉམས་མྱོང་ཞན་པ་དང་དུས་བྲེལ་ཆེ་སྟབས།",
    "ཐོག་མའི་བོད་ཡིག་གི་མ་རྩོམ་ཅི་ལྟ་བུ་ཞིག་ཡོང་རྒྱུར་ད་དུང་བར་ཐག་ངེས་ཅན་ཞིག་ཡོད་པ་གོར་མ་ཆག་བོད་འགྱུར་དང་ཞུ་དག་གི་རྒྱུད་རིམ་ཁྲོད།",
    "ང་ཚོས་ཐོག་མའི་མ་རྩོམ་གྱི་དགོངས་གཞི་དང་གཏུགས་གང་ཐུབ་བྱས་ཡོད་པ་དང་།",
    "བརྗོད་བྱ་རྗོད་བྱེད་ཀྱི་ཉིང་ལག་རེ་རེ་དང་།",
    "མང་ཚོགས་སྐུལ་སློང་དང་འཐབ་རྩོད་ཀྱི་སྐོར།",
    "མང་ཚོགས་ཀྱི་འཚོ་བའི་སྐོར།་",
    "གོང་གི་གནས་ཚུལ་གཤམ་འོག་ལ་བརྒྱུད་བསྒྲགས་བྱེད་མི་ཐུབ་པ་དང་།",
    "གཤམ་འོག་གི་གནས་ཚུལ་གོང་དུ་སྙན་སེང་ཞུ་མ་ཐུབ་པར་དཀྱིལ་དུ་འགག་བསྡད་པ།",
    "ནང་མ་སྒང་གི་འགན་འཛིན་གཙོ་བོ་ཅེའི་འཇིགས་མེད་བཅས་ནས་དགག་བྱ་ཞུས་ན་ཡང་།",
    "༡༨ ཉིན་རྒྱ་ནག་གི་སྲིད་བློན་ཀྲོའུ་ཨིན་ལེར་ཕུལ།",
    "མའོ་ཙེ་ཏུང་གིས།",
    "འཐབ་ཕྱོགས་གཅིག་གྱུར་ཁང་གིས་གྲལ་རིམ་འཐབ་རྩོད་མི་བྱེད་པར།",
    "འགན་འཛིན་མི་གཞན་ཞིག་གིས།",
    "ལི་ཝེ་ཧན་གྱིས་མི་དེ་དག་གཅེས་ལང་དུ་བཏང་བ་རེད།",
    "གནམ་གྲུ་ལས་ཀྱང་མཐོ་གི་རེད་ཅེས་བཤད།",
    "ཁ་རྩོད་དྲག་པོའི་སྒོ་ནས་དག་འབུད་གནང་བར་བརྟེན།",
    "བོད་རང་སྐྱོད་ལྗོངས་གྲ་སྒྲིག་ལྷན་ཁང་གི་གཙོ་འཛིན་ལས་ཚབ་ཀྱི་གོ་གནས་མེད་པར་བཟོས།",
    "དེ་ཡང་རྒྱ་ཆེའི་མང་ཚོགས་ནས་དོན་མེད་དཀའ་སྡུག་མྱོང་མི་དགོས་པར་འོས་འཚམས་བག་ཕེབས་ཀྱི་འཚོ་བ་སྤྱོད་ཐུབ་པའི་ཆེད་དུ།",
    "ལྷག་བསམ་རྣམ་དག་གི་སྒོ་ནས་མཐོ་རིམ་མི་སྣས་གཤམ་འོག་མང་ཚོགས་ཀྱི་བདེ་སྡུག་རྟོགས་པའི་ཆེད་བྲིས་པ་ཞིག་ཡིན།",
    "རྒྱལ་ཁབ་བཅས་པར་ངོ་རྒོལ་བྱེད་མཁན་གྱི་ཞྭ་མོ་གཡོགས།",
    "དེ་དག་ནི་གཙོ་འཛིན་མའོ་ཙེ་ཏུང་དང་རྒྱལ་སྲིད་སྤྱི་ཁྱབ་ཁང་གི་འགོ་འཁྲིད་འོག་ཏང་གི་མི་རིགས་སྲིད་བྱུས་དང་།",
    "ཏང་གིས་ཟིང་འཁྲུག་ཞོད་འཇགས་སུ་གཏོང་རྒྱུའི་སྲིད་བྱུས་ནི་ཧ་ཅང་ཡང་དག་པ་ཡིན་ལུགས།",
    "དེ་རིང་གི་རྙེད་པར་དཀའ་བའི་གོ་སྐབས་བཟང་བོ་འདི་བརྒྱུད།",
    "བདག་གིས་སྒེར་སེམས་སྤངས་ནས་ཏང་གི་མཚན་མཐོང་དང་མི་དམངས་ཀྱི་ཁེ་ཕན་ལ་དམིགས་ཏེ་ང་ཚོ་བོད་ལྗོངས་ཀྱི་གནས་ཚུལ་གལ་ཆེན་ཁག་སྙན་སེང་དང་།",
    "ས་སྟེང་སྐྱེ་འགྲོ་གཅེས་སུ་རུང་བའི་རླབས་ཆེན་ཀྲུང་ཧྭ་ཡངས་པའི་འཛིན་མའི་ཁྱོན་དུ།",
    "མི་དམངས་ཀྱི་དབུ་ཁྲིད་ཆེན་མོ་རླབས་ཆེན་ཡང་དག་མཁས་མཛངས་ཀྱི་མའོ་ཀྲུའུ་ཞིས་དབུ་ཁྲིད་པའི་ཀྲུང་གོ་བཟོ་བའི་གྲལ་རིམ་གཙོར་བྱས་པའི་རྒྱ་ཆེའི་ངལ་རྩོལ་མི་དམངས་ཀྱིས།",
    "རྒྱལ་ཁབ་ཕྱི་ནང་གི་ལོག་སྤྱོད་རུ་ཚོགས་ལ་གྲལ་རིམ་གྱི་གཡུལ་འཐབ་རིམ་པར་བྱས་པ་དང་།",
    "རྒྱལ་ཡོངས་ཀྱི་མངའ་ཁོངས་ཕལ་མོ་ཆེ་བཅིངས་འགྲོལ་བཏང་བ་དང་།",
    "ཀྲུང་ཧྭ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་བཙུགས་པ་རེད།",
    "བདེ་སྐྱིད་འོད་སྣང་གིས་ཡོངས་སུ་ཁེངས་ཤིང་།",
    "བློ་གཅིག་སེམས་གཅིག་ངང་བོད་ལྗོངས་མི་དམངས་ལ་རང་ཉིད་བློས་བཏང་གིས་དོན་བཟང་གྲངས་མེད་བསྒྲུབས་ཡོད།",
    "ཏང་གི་འཐབ་ཕྱོགས་གཅིག་གྱུར་དང་མཐོ་རིམ་མི་སྣར་ཐུགས་ཁུར་གཟིགས་སྐྱོང་ཐད།",
    "གཤམ་འོག་གི་མཐོ་རིམ་བླ་སྤྲུལ་དང་དཔོན་རིགས་ཁག་ལའང་ཀྲུང་དབྱང་དང་།",
    "ཕོགས་ཐོབ་ཀྱང་མཐོ་བོ་གནང་བ་སོགས་ཆབ་སྲིད་ཀྱི་གོ་གནས་དང་འཚོ་བའི་ཐད་གང་ཅིར་གཟིགས་རྟོག་ཆེན་པོ་གནང་ཡོད།",
    "༡༩༥༤ ལོར་བདག་སོགས་པེ་ཅིང་དུ་སླེབས་སྐབས་ཀྲུང་དབྱང་གི་སྐུ་ཚབ་དང་བོད་ཀྱི་བཀའ་ཤག་སྐུ་ཚབ།",
    "ནང་མ་སྒང་གི་སྐུ་ཚབ་ཚོས་རྒྱུན་རིང་གྲོས་མོལ་བྱས་རྗེས།",
    "ཀྲུང་དབྱང་གིས་ཡང་བསྐྱར་བོད་ཀྱི་མཐོ་རིམ་པ་དེ་ཚོར་བཟོད་སྒོམ་ངང་སྒུག་གིས་ལམ་ནོར་ལྡོག་ཤེས་ཀྱི་གོ་སྐབས་སྤྲད་དེ།",
    "ཀྲུང་དབྱང་གིས་བོད་ཀྱི་ལས་དོན་ལ་ཐོག་མཐའ་བར་གསུམ་དུ་གཟབ་བརླིང་བརྟན་བསྐྱོད་དང་།",
    "འུ་༤༡་ པམཐོ་རིམ་ལ་ཐུགས་ཁུར་གཟིགས་སྐྱོང་དང་གུ་ཡངས་བཟོད་སྒོམ་ཚད་ལས་བརྒལ་བ་གནང་བ་དང་།",
    "འདི་ནི་ང་ཚོ་བོད་ལྗོངས་ཀྱི་བོད་ཀྱི་མཐོ་རིམ་ཚང་མས་ཤེས་གསལ་ཡིན།",
    "བོད་ཀྱི་མཐོ་རིམ་ལོག་སྤྱོད་པ་ཚོས་ཀྲུང་དབྱང་གིས་ཁོ་ཚོར་གུ་ཡངས་དང་བཟོད་སྒོམ།",
    "རེ་སྒུག་ངང་རིང་།",
    "གཟིགས་སྐྱོང་གནང་བར་གོ་བ་ལོག་བསྒྲུབས་ཀྱིས་ཀྲུང་དབྱང་ཉམས་ཆུང་ཐུབ་ཚོད་གཏོང་ཆོག་ཏུ་འདོད་ཅིང་།",
    "བཤུ་གཞོག་པ་ཉུང་ཤས་མུ་མཐུད་ངལ་རྩོལ་མི་དམངས་ཀྱི་མགོ་ཐོག་ཏུ་ཞོན་ཏེ་གཉའ་གནོན་བཤུ་གཞོག་གིས་རུལ་སུངས་ཀྱི་འཚོ་བ་སྐྱེལ་ཐབས་མེད་པ་ཁོ་ཚོས་ཤེས་ཀྱི་ཡོད་པར་བརྟེན།",
    "མི་དེ་དག་བཤུ་གཞོག་གྲལ་རིམ་དུས་གཏན་དུ་གནས་ཐབས་སུ་གསར་བརྗེར་དགའ་གི་མེད་པས་ཟིང་འཁྲུག་གི་བསམ་བློ་ཤར་བ་དང་།",
    "རྒྱ་གར་ལོག་སྤྱོད་ཤོག་ཁག་ཚོས་ང་ཚོའི་མེས་རྒྱལ་གྱི་གསར་བརྗེའི་ལས་དོན་དང་།",
    "ཕྱི་ནང་གི་ལོག་སྤྱོད་ཤོག་ཟག་ཚོས་རང་ཉིད་ཀྱི་སྟོང་སེམས་སྣ་ཚོགས་མངོན་དུ་འགྱུར་ཆེད།",
    "ཡིན་ནའང་གལ་སྲིད་ཟིང་འཁྲུག་གི་དམིགས་ཡུལ་ངོ་མ་གསལ་རྗེན་དུ་བསྟན་ཚེ།",
    "རྒྱ་ཆེའི་མང་ཚོགས་དང་བཤུ་གཞོག་གྲལ་རིམ་ཁྲོད་ཀྱི་བཙན་རྒོལ་རྒྱལ་གཅེས་ཀྱི་མཐོ་འབྲིང་རིམ་གྱི་མི་སྣ་མི་ཉུང་བ་ཞིག་གིས་ལོག་སྤྱོད་ཤོག་ཁག་གི་ལྐོག་ཇུས་ལ་ངོ་རྒོལ་ཤུགས་ཆེན་བྱས་ཏེ་ཁོ་ཚོའི་སྟོང་སེམས་འགྲུབ་ཐབས་མེད་པ་བཟོ་ངེས།",
    "སོ་སོའི་མི་རིགས་ལ་དད་མོས་དང་དགའ་ཞེན།",
    "ང་ཚོ་གངས་ལྗོངས་ཀྱི་རྩམ་ཟན་མ་ཎི་བགྲང་མཁན་ཐམས་ཅད་རྡོག་རྩ་ཆིག་སྒྲིལ་གྱིས་དྲག་ཆས་སྤྲས་ཏེ།",
    "མང་ཚོགས་དང་མཐོ་འབྲིང་རིམ་གྱི་མི་སྣ་མང་བོས་དངོས་ཡོད་ཀྱི་གནས་ཚུལ་རྒྱུས་ལོན་མ་བྱུང་བར་མགོ་སྐོར་འོག་ཚུད་སྟབས།",
    "རྗེས་སོར་བོད་ལྗོངས་བཅས་ཀྱི་ཟིང་འཁྲུག་གི་མེ་ལྕེ་རིམ་བཞིན་མཆེད་པ་དང་།",
    "མཐར་༡༩༥༩ ལོའི་ཟླ་༣ ཚེས་༡ ཉིན་ལྷ་སར་མི་དམངས་རྣམས་ནོར་བུ་གླིང་གར་འདུ་འཛོམས་ཀྱིས་ཟིང་འཁྲུག་འགོ་བས་དེ་རིང་ནས་བོད་རང་བཙན་ཐོབ་སོང་།",
    "ཀྲུང་དབྱང་ནས་སྟོབས་ཆེན་གྱི་ཀྲུང་གོ་མི་དམངས་བཅིངས་འགྲོལ་དམག་བོད་སྡོད་དམག་དཔུང་ལ་གསར་བརྗེ་ངོ་ལོག་གི་དྲག་པོའི་ཟིང་འཁྲུག་དྲག་གནོན་ལྷིང་འཇགས་གཏོང་དགོས་པའི་བཀའ་རྒྱ་གནང་ཞིང་།",
    "དེ་བཞིན་དུ་བོད་ལྗོངས་ཀྱི་སེར་སྐྱ་མང་ཚོགས་ཡོངས་རྫོགས་ལ་ཟིང་འཁྲུག་གི་ནག་ཉེས་ཐེར་འདོན་དང་།",
    "བློ་ཐག་རྦད་བཅད་ཀྱིས་མི་དམངས་བཅིངས་འགྲོལ་དམག་གིས་ཟིང་འཁྲུག་ཞོད་འཇགས་གཏོང་བའི་ཁྲོད་རང་ཉིད་ཀྱི་ནུས་ཤུགས་ཡོད་ཚད་བཏོན་པ་དང་།",
    "ཏང་གི་འགོ་ཁྲིད་འོག་དམག་དམངས་རྡོག་རྩ་ཆིག་སྒྲིལ་གྱིས་མཉམ་རུབ་ཐོག་ཟིང་འཁྲུག་ཞོད་འཇགས་སུ་བཏང་སྟབས།",
    "ཏང་གི་འགོ་ཁྲིད་འོག་སོ་སོའི་ལུས་སྟེང་དུ་བཀལ་བའི་བཀས་བཀོད་རྒྱུད་འཛིན་ལམ་ལུགས་ཀྱི་ལྕགས་སྒྲོག་ཡོད་ཚད་སོ་སོས་གཏོར་ཏེ།",
    "ཡར་ལངས་བཅིངས་འགྲོལ་ཐོབ་ཐབས་ཀྱི་ཁ་ཚ་དགོས་གཏུགས་ཀྱི་རེ་འདུན་བཏོན།",
    "ཁོང་ཚོ་ཡར་ལངས་བཅིངས་འགྲོལ་ཐོབ་སྟེ་འཚོ་བ་གསར་བར་ལོངས་སུ་སྤྱོད་ཐུབ་རྒྱུའི་རེ་འདུན་ཡོད་པ་སོགས་གསར་བརྗེའི་བསམ་བློའི་རྨང་གཞི་གང་འཚམས་ཡོད།",
    "ང་ཚོར་དེའི་སྐོར་གྱི་བསམ་འཆར་བསྡུས་སོང་།",
    "དེའི་རྗེས་རླབས་ཆེན་གཙོ་འཛིན་མའོ་ཀྲུའུ་ཞི་དང་ཀྲོའུ་ཙུང་ལི་སྐུ་ཉིད་ནས་ཀྱང་ང་ཚོར་དམིགས་བསལ་མཇལ་འཕྲད་གནང་སྐབས་གསུངས་གསལ།",
    "དེ་དག་གི་བཀོད་བྱུས་འོག་མེས་རྒྱལ་ལ་རྒྱབ་འགལ་དང་།",
    "ངལ་རྩོལ་མི་དམངས་བཅིངས་འགྲོལ་གཏོང་རྒྱུའི་རེ་འདུན་ཤུགས་ཆེར་ཡོད་གནས་གསུངས་པ་དང་།",
    "ངོ་ལོག་ཟིང་འཁྲུག་གི་བྱ་འགུལ་ཚར་གཅོད།",
    "དེ་བཞིན་ང་ཚོར་བོད་ལྗོངས་བཅོས་བསྒྱུར་གྱི་བྱེད་ཐབས་ཐོག་བསམ་འཆར་འདོན་དུ་བཅུག་སོང་།",
    "དེར་བརྟེན་ང་ཚོར་སོ་སོའི་འདོད་ཚུལ་གསལ་བོར་བརྗོད་པའི་གོ་སྐབས་ཐོབ་སྟེ།",
    "བོད་ལྗོངས་ཀྱི་ངོ་ལོག་ཟིང་འཁྲུག་ཁྱོན་ཡོངས་ནས་ཞོད་འཇགས་དང་།",
    "ལྷག་བསམ་རྣམ་དག་གིས་རྒྱབ་སྐྱོར་སྲུང་བརྩི་ཞུ་རྒྱུ་ཡིན་ལུགས་གོང་དུ་བརྗོད་ཟིན་པ་ལྟར་ཞུ་རྒྱུ་བྱུང་།",
    "མང་ཚོགས་སྐུལ་སློང་བྱས་སྟབས།",
    "ཐེངས་འདིའི་ཁྱོད་ཤི་ང་གསོན་དང་ཛ་དྲག་རྣོ་ངར་གྱི་གྲལ་རིམ་འཐབ་རྩོད་ཀྱི་རླབས་རྒྱུན་ས་ཆེན་ཁྱོན་ལ་འཕྱུར་ཞིང་།",
    "མིའི་རིགས་འཕེལ་རྒྱས་ཁྲོད་ཀྱི་དགའ་འོས་པའི་དོན་ཆེན་ཞིག་ཀྱང་རེད།",
    "མི་སྨོན་རང་སྐྱིད་ཀྱི་བོད་ལྗོངས་གསར་བ་ཞིག་མངོན་དུ་འགྱུར་རྒྱུ་ནི་གཏན་འཁེལ་བ་ཞིག་རེད།",
    "ཏང་གི་འགོ་ཁྲིད་འོག་རོགས་རེས་ཚོགས་ཆུང་བཙུགས་པ་དང་།",
    "ལྷག་པར་ཏུ་ཏང་གི་གཅིག་གྱུར་གྱི་འགོ་ཁྲིད་འོག་བོད་ལྗོངས་བཟོ་ཞིང་མནའ་འབྲེལ་གྱི་རྨང་གཞི་སྲ་བརྟན་བྱུང་བ་དང་།",
    "འགོ་ཁྲིད་དང་མང་ཚོགས་དབར་འབྲེལ་ལམ་གསར་བ་བཙུགས་ཏེ།",
    "དེ་ནི་གཞན་དུ་འགྲན་ཟླ་དང་བསུབ་ཐབས་མེད་པ་ཞིག་རེད།",
    "ལོ་ངོ་སྟོང་ཕྲག་དུ་མའི་རིང་བྱུང་མ་མྱོང་བའི་འགལ་རྐྱེན་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བའི་རྒྱལ་ཁ་དང་གྲུབ་འབྲས་ཆེན་པོ་ཐོབ་པ་ནི་མི་རྣམས་ཧང་སངས་དགོས་པ་ཞིག་རེད།",
    "བཅིངས་འགྲོལ་དམག་གི་དཔོན་དམག་བཅས་ཚང་མས་ཏང་དང་མི་དམངས་ཀྱི་ཆེད་ཧུར་ཐག་འབད་ཐག་གིས་ལས་དོན་སྣ་མང་བསྒྲུབས་ཏེ་ཐོབ་པ་ཞིག་ཀྱང་ཡིན།",
    "བོད་བསྐྱོད་མི་དམངས་བཅིངས་འགྲོལ་དམག་དང་བོད་བསྐྱོད་རིགས་སོ་སོའི་ལས་བྱེད་ལ་དགའ་མོས་བརྩི་བཀུར་ཞུ་གི་ཡོད།",
    "གྲོང་བརྡལ་ལ་སོགས་པའི་ཕོ་མོ་རྒན་གཞོན་ཚང་མས།",
    "ང་ཚོའི་རླབས་ཆེན་གཟི་བརྗིད་ཀྱི་ཏང་དང་རྒྱལ་ཡོངས་མི་དམངས་བདེ་སྐྱིད་ཀྱི་ལམ་དུ་ཁྲིད་མཁན་རླབས་ཆེན་གྱི་མའོ་ཀྲུའུ་ཞི་ཡིས་ཁོ་ཚོ་སྡུག་བསྔལ་གྱི་གཡང་རོང་ནས་བསྐྱབས་ཏེ།",
    "དགའ་སྤྲོའི་ངང་ནས་རྒྱ་རིགས་གཙོས་པའི་རིགས་སོ་སོའི་མི་དམངས་ཀྱིས་བོད་ལྗོངས་བཅིངས་འགྲོལ་དང་གསར་བརྗེའི་ལས་དོན་ལ་ལྷག་བསམ་རྣམ་དག་གིས་རོགས་འདེགས་དང་།",
    "དེ་བཞིན་དུ་དེང་ཕྱིན་མཐའ་གཅིག་ཏུ་ཏང་གི་གསུང་ལ་ཉན་འཇོག་དང་།",
    "ཏང་གི་རྗེས་སུ་འབྲང་རྒྱུ།",
    "འདི་ནི་ཤིན་ཏུ་མི་འོས་པ་དང་ཐབས་རྡུགས་དང་ཚབས་ཆེན་ཞིག་རེད།",
    "མི་མཆོག་དམན་སུ་ཡིན་རུང་ཚང་མར་དབུལ་ཕོངས་ལ་སྦྱིན་གཏོང་གི་གོམས་གཤིས་བཟང་བོ་ཡོད་ཅིང་སློང་མོ་བརྒྱབ་ནའང་འཚོ་ཐབས་འབྱོངས་ངེས་ཡིན་པ་དང་།",
    "ཁྱོད་ཤི་ང་གསོན་གྱི་རྣོ་ངར་ལྡན་པའི་གྲལ་རིམ་འཐབ་རྩོད་ཅིག་ཡིན་སྟབས།",
    "ཟློག་ཐབས་མེད་པའི་སྐྱོན་ཆ་ནོར་འཁྲུལ་རེ་ཟུང་ནི་འབྱུང་སྲིད་པ་ཞིག་རེད།",
    "ཏང་གིས་ད་དུང་མཁས་མཛངས་ལྡན་པའི་སྒོ་ནས་ཟིང་འཁྲུག་ཞོད་འཇགས་སུ་གཏོང་རྒྱུར་ཐོག་མཐའ་བར་གསུམ་དུ་དམག་དོན་གྱིས་རྒོལ་རྡུང་དང་།",
    "ཕྱི་ནང་གི་ལོག་སྤྱོད་པ་ཚོས་ཟིང་འཁྲུག་སློང་བའི་ལྐོག་གཡོ་ངན་ཇུས་ཐེར་འདོན་དང་།",
    "ཟིང་འཁྲུག་གི་ཉེས་པ་སྒྲོག་སྦྱངས།",
    "ང་ཚོའི་ལས་དོན་ཁྲོད་ཟིང་འཁྲུག་པ་ཚོས་དཀྲོག་གཏམ་བཟོ་གཞིར་འགྱུར་བའི་ཞན་ཆ་ནོར་འཁྲུལ་ཡོད་ཚེ།",
    "དུས་ཡུན་གང་འཚམས་ཤིག་རིང་ལོག་སྤྱོད་ཤོག་ཁག་གི་མགོ་སྐོར་འོག་ཚུད་པའི་རིམ་པ་སོ་སོའི་མི་དམངས་མང་ཚོགས་ཀྱི་ཐེ་ཚོམ་ཡིད་དོགས་རྣམས་དོན་དངོས་ཀྱི་ཐོག་ནས་རིམ་བཞིན་སེལ་རྒྱུ་དང་གསུམ་ལས།",
    "ལས་བྱེད་ཚོས་འཁོན་སྡང་མཐོང་ཆུང་དང་སླ་བཅོས་ཀྱི་བྱེད་ཐབས་ཀྱིས་ཟིང་འཁྲུག་པ་དེ་དག་གི་གནས་ཚུལ་ཞིབ་བཤེར་བྱས་པ་ཁ་མི་ཚང་ཞིང་གཏིང་མི་ཟབ་པས།",
    "ཟིང་འཁྲུག་པའི་ནང་གི་མི་མང་བོ་ཞིག་ནི་ལོག་སྤྱོད་པ་ཚོའི་མགོ་སྐོར་འོག་ཚུད་པའི་མི་བཟང་བོ་ཡིན་པ་དང་།",
    "ཕྱི་མའི་མི་ཉུང་བ་ཞིག་ལ་ཟིང་འཁྲུག་པའི་ཞྭ་མོ་གཡོགས་ཏེ་ཐག་གཅོད་བྱས་པ་དང་།",
    "ཕྱི་ནང་གི་ལོག་སྤྱོད་པ་ཚོའི་ལྐོག་གཡོ་ངན་ཇུས་ཐེར་འདོན་དང་།",
    "ཟིང་འཁྲུག་གི་ཉེས་པ་སྒྲོག་སྦྱངས་ཐད་མ་གཞི་ཡག་པོ་བསྒྲུབས་ཡོད་མོད།",
    "ཟིང་འཁྲུག་ལ་ངོ་རྒོལ་བྱེད་སྐབས་ཟིང་འཁྲུག་གི་ཚབས་ཆེའི་ནག་ཉེས་སྒྲོག་སྦྱངས་དང་།",
    "རྒྱ་ཆེའི་ངལ་རྩོལ་མི་དམངས་ལ་སུ་ཞིག་ང་ཚོའི་དགྲ་བོ་ཡིན་པ་དང་།",
    "མི་དམངས་མང་ཚོགས་ཀྱི་བཙན་རྒོལ་རྒྱལ་གཅེས་དང་།",
    "ཟིང་འཁྲུག་པར་འཁོན་འགྲས་ཀྱི་བསམ་བློ་སྐུལ་སྤེལ་བྱས་ཏེ་ཟིང་འཁྲུག་གི་རྨང་གཞི་གཏོར་བཅོམ་གཏོང་བ་ནི་ཡང་དག་དགོས་ངེས་ཤིག་ཡིན།",
    "དེ་བས་མང་ཚོགས་རྣམས་སྐུལ་སློང་གང་ཐུབ་བྱེད་དགོས་པ་སྟེ།",
    "ཞེད་སྣང་གིས་ཟིང་འཁྲུག་པར་རྒྱུ་ནོར་སྤྲད་མྱོང་མཁན་དང་།",
    "མི་གཞན་ནི་དེ་བས་ཀྱང་སྨོས་མ་དགོས་པ་རེད།",
    "ཞྭ་མོ་གཡོག་མི་རུང་བའི་མི་བཟང་བོ་མི་ཉུང་བ་ཞིག་ལ་མ་ཉེས་ཁག་གཡོགས་ཀྱིས་ཞྭ་མོ་ཆེན་པོ་བསྐོན་པ་དང་།",
    "ངལ་རྩོལ་མི་དམངས་ཤིན་ཏུ་དགའ་སྤྲོ་སྐྱེ་གི་ཡོད།",
    "༡༩༥༩ ལོར་བཏང་བའི་བུ་ལོན་གསར་བ་ཁག་གི་སྐྱེད་ཀ་ཆག་ཡང་བཏང་སྟེ་མ་རྩ་ཚང་མ་འཇལ་དགོས་པ་དང་།",
    "གལ་སྲིད་གུ་ཡངས་གང་ཐུབ་དང་ཟིང་འཁྲུག་པའི་ཞྭ་མོ་ཉུང་ཙམ་གཡོགས་ཏེ་རྡུང་རྡེག་གཏོང་ཡུལ་གང་ཐུབ་ཇེ་ཉུང་དང་མི་གང་མང་ཚུར་འགུག་བྱེད་རྒྱུ་དེ་ནི་རང་ཉིད་ཀྱི་སྟོབས་ཤུགས་སྤེལ་རྒྱུ་དང་།",
    "དགྲ་བོའི་སྟོབས་ཤུགས་ཉམས་དམས་སུ་བཏང་ནས་ཁེར་རྐྱང་དུ་འབུད་པར་དགེ་མཚན་ཆེན་པོ་ཡོད།",
    "གོང་དུ་བདག་གིས་བརྗོད་མ་ཐག་པ་བཞིན།",
    "དངོས་ཡོད་དང་མི་འཚམས་པའི་སྒོ་ནས་ཞྭ་མོ་ནག་པོ་མང་དག་གཡོགས་པ་དང་།",
    "མི་དམངས་ཀྱིས་ང་ཚོར་ཐེ་ཚོམ་ཡིད་དོགས་དང་བློ་ཕམ་བྱུང་ཡོད།",
    "བླུ་ཉོའི་ཐད་དེ་སྔོན་ང་ཚོའི་རྒྱལ་གཅེས་སྔོན་ཐོན་མི་སྣའི་འགོ་དཔོན་ཚོས་བླུ་ཉོ་མི་དགོས་པའི་བསམ་ཚུལ་དང་རྣམ་འགྱུར་བསྟན་ཡོད།",
    "མི་ཉུང་ཤས་ཤིག་གིས་བདག་བཟུང་བྱེད་མ་འོས་པ་ཞིག་རེད།",
    "ང་ཚོས་རྒྱལ་ཁབ་ཀྱིས་དུས་བཅད་ལྟར་བླུ་ཉོ་གནང་རྒྱུ་ཁས་ལེན་ཞུས་པ་དེ་ནི་ཤིན་ཏུ་མ་འོས་པ་ཞིག་རེད།",
    "ཏང་གིས་བཙན་རྒོལ་རྒྱལ་གཅེས་ཀྱི་མཐོ་འབྲིང་རིམ་མི་སྣར་གཟིགས་སྐྱོང་དང་།",
    "དེའི་ཉེར་ལེན་ལས་བདག་པོ་ངོ་མ་སུ་ཡིན་དང་རྒྱ་ཁྱོན་ཆེ་ཆུང་།",
    "གྲལ་རིམ་དབྱེ་འབྱེད་སྐབས་བདག་གིས་འོག་ཏུ་འཆད་འགྱུར་གྱི་ཞིང་བྲན་ཁ་ཤས་མངའ་ཚབ་ཀྱི་གྲས་སུ་བརྩི་བ་དང་།",
    "དུས་མཚུངས་སུ་ཞིང་བྲན་འབྲིང་ཕྱུག་གིས་གལ་སྲིད་གཏམ་སྤྱོད་ཐོག་ཅུང་ཙམ་མཉམ་འཇོག་མ་བྱས་ཚེ་ལམ་སེང་རྡུང་རྡེག་བཏང་སྟེ།",
    "འབྲོག་བདག་གིས་འོས་འཚམས་ཀྱི་གླ་ཐོབ་སྤྲོད་རྒྱུ་དང་།",
    "རྦད་དེ་ཡང་དག་པ་ཞིག་རེད།",
    "འབྲོག་བྲན་ཚོར་གླ་ཐོབ་གྲངས་ཚང་རག་ཡོད་ནའང་ནོར་ལུག་འཚོ་སྐྱོང་གི་བཀོད་འདོམས་ལ་མི་ཉན་ཞིང་།",
    "འཐབ་རྩོད་ཕོག་གི་ཡོད་པ་སོགས་ཀྱི་གནས་ཚུལ་བྱུང་འདུག་འདི་ལྟར་ཁྱོན་ཡོང་ལ་ལྟ་མ་ཐུབ་པས།",
    "ཏང་གིས་ཞིང་བྲན་བདག་པོའི་གྲལ་རིམ་དང་།",
    "དངོས་ཐོག་བདེན་འཚོལ་གྱིས་དངོས་ཡོད་གནས་སྟངས་གཞིར་བཞག་གིས་གྲལ་རིམ་དབྱེ་འབྱེད་དང་།",
    "དགེ་སྐྱོན་ལ་ཁྱོན་ཡོངས་ནས་བསམ་གཞིགས།",
    "དེ་བྱིངས་ངེས་པར་དུ་རྡུང་རྡེག་གཏོང་ཡུལ་ལ་སྟངས་འཛིན་དམ་ཟབ་དང་འབད་བརྩོན་གྱིས་མི་གང་མང་ང་ཚོའི་ཕྱོགས་སུ་ཚུར་འགུག་བྱེད་དགོས།",
    "འདི་ནི་ཤིན་ཏུ་ནས་གལ་ཆེ་མོད།",
    "རྒན་པོ་དང་ཚོ་དཔོན།",
    "དེ་ལས་ཐོབ་པའི་ཁེ་ཕན་ཡོད་པ་སོགས་འདི་དག་མངའ་ཚབ་ཏུ་བགྲང་ཆོག་ཡིན་ནའང་ཁ་ཤས་དེ་ལྟར་མིན་པར་ལས་ཁུར་བརྗེ་རེས་བྱས་ཏེ།",
    "མང་ཚོགས་རང་ཉིད་ནས་འོས་འཚམས་ཀྱི་མི་ལ་རེ་སྐུལ་དང་འདེམས་སྒྲུག་བྱས་པ་ཡིན་སྟབས་ཁེ་ཕན་མེད་པར་ད་དུང་གྱོང་རག་གི་ཡོད་པ་དང་།",
    "ཁོ་ཚོ་མངའ་ཚབ་ཏུ་བགྲང་བ་ཡིན་ན་གྲལ་རིམ་གྱི་དབྱེ་བ་འཁྲུག་པ་རེད།",
    "མང་ཚོགས་སྐུལ་སློང་དང་འཐབ་རྩོད་ཀྱི་སྐོར།",
    "དེར་བརྟེན་དེའི་ངོ་བོ་ནི་ངེས་པར་དུ་རྒྱ་ཆེའི་མང་ཚོགས་བཀས་བཀོད་རྒྱུད་འཛིན་གྱི་རྨོངས་གཉིད་ཡོད་ཚད་ལས་བསླངས་པ་དང་།",
    "མང་ཚོགས་སྐུལ་སློང་ནི་མ་བརྒྱུད་མཐུ་མེད་ཀྱི་གོ་རིམ་ཞིག་ཡིན།",
    "ང་ཚོས་ལས་དོན་དེ་སྐུལ་སློང་བྱེད་འོས་པའི་མི་འབོར་གྱི་བརྒྱ་ཆའི་དགུ་བཅུ་ཡན་གྱི་ཀླད་པའི་ནང་ནུས་ཤུགས་ཐེབས་སུ་འཇུག་དགོས་པ་མ་ཟད།",
    "དེའི་ནང་གི་བརྒྱ་ཆའི་བདུན་ཅུ་ནས་བརྒྱ་ཆའི་དགུ་བཅུ་ཡན་གྱི་མི་འབོར་དེ་ཕྱི་ཚུལ་ཙམ་མ་ཡིན་པར་དོན་དངོས་ཀྱི་སྟོབས་ཤུགས་སུ་བསྒྱུར་དགོས་པ་དང་།",
    "ཕྱོགས་ཡོངས་ནས་ཕན་ཐོགས་མེད་པ་དགྲ་དགའ་གཉེན་སྡུག་གི་འབྱུང་རྐྱེན་སྔོན་འགོག་དང་།",
    "མང་ཚོགས་སྐུལ་སློང་དང་འཐབ་རྩོད་སོགས་ལས་དོན་ཡོད་ཚད་འབད་བརྩོན་གྱིས་སྔར་བས་གཏིང་ཟབ་པ་དང་ཞིབ་ཚགས་པ།",
    "མི་དམངས་མང་ཚོགས་མང་ཆེ་བས་བཅོས་བསྒྱུར་གྱི་དགོས་ངེས་དང་སྐུལ་སློང་གི་གལ་ཆེའི་རང་བཞིན་ལ་རྒྱུས་ལོན་ཡོད་མེད་མི་བལྟ་བར།",
    "རྣམ་པ་སྣ་ཚོགས་ཀྱི་ཧུར་བརྩོན་ཅན་བྱུང་བ་ཡིན་ན་མང་ཚོགས་སྐུལ་སློང་མཐིལ་ཕྱིན་པ་བྱུང་སྙམ་པའི་མངོན་རྟགས་ཤིག་དང་།",
    "ཧུར་བརྩོན་ཅན་ཁག་ཅིག་གི་བསམ་བློ་དང་བྱ་སྤྱོད་དེ་མི་དམངས་མང་ཚོགས་ཐམས་ཅད་ཀྱི་བསམ་བློ་དང་བྱ་སྤྱོད་ལ་ངོས་འཛིན་པའི་མངོན་རྟགས།་",
    "མང་ཚོགས་ཀྱིས་ནང་དོན་རྟོགས་པ་ཧ་ཅང་ཉུང་ཉུང་ཡིན།",
    "མང་ཚོགས་ནང་འདོད་ཚུལ་འདི་དག་ཡོད་མཁན་ཚོར་བརྗོད་པར།",
    "ཁྱོད་ཚོས་ལས་འགུལ་ཁྲོད་མངའ་བདག་དང་མངའ་ཚབ།",
    "ཐ་ན་ཞིང་བྲན་འབྲིང་ཕྱུག་ཁ་ཤས་ལའང་དཀར་ནག་གི་དབྱེ་བ་མེད་པར་ཁག་འདོགས་ས་མང་ཙམ་འཚོལ།",
    "ཁྱོད་ཚོས་བསམ་འཆར་མང་བོ་ཐོན།",
    "ཁྱོད་ཚོས་འདི་ལྟར་བྱས་པ་ཡིན་ན་ད་གཟོད་གཞུང་བཞེས་མང་ཙམ་གཏོང་ཐུབ་པ་དང་ཁྱོད་ཚོར་རྒྱུ་ནོར་མང་ཙམ་ཐོབ་ཐུབ།",
    "ཁྱོད་ནི་མངའ་བདག་གི་རྒྱུགས་ཁྱི་རེད་ཟེར་བའམ།",
    "མངའ་བདག་གི་ལངས་ཕྱོགས་རེད་ཅེས་ཞྭ་མོ་སྣ་ཚོགས་གཡོགས་ཏེ་གནོན་ཤུགས་སྤྲོད་པ་སོགས་གསར་བརྗེའི་དགོངས་དོན་དང་མི་འཚམས་པ་སྨོས་ཅི།",
    "ཐ་ན་འཇིག་རྟེན་སྤྱི་སྲོལ་གྱི་བྱེད་སྟངས་དང་ཡང་མི་མཚམས་པའི་ཞི་དྲག་གི་བྱེད་ཐབས་སྣ་ཚོགས་ལག་ལེན་བྱས་པར་བརྟེན།",
    "ལས་བྱེད་ཚོས་མང་ཚོགས་ཀྱི་བསམ་བློའི་གནས་ཚུལ་ལ་བསམ་གཞིགས་མ་བྱས་པ་དང་།",
    "མང་ཚོགས་རྦད་དེ་སྐུལ་སློང་བྱས་ཟིན་ཤག་ཏུ་རྩིས་ཏེ་ལས་འགུལ་སྤེལ་སྟབས།",
    "ད་ཆ་དཔའ་ངར་ཡང་དག་གི་སྒོ་ནས་ངལ་རྩོལ་མི་དམངས་ཀྱི་བདེ་སྡུག་ངོ་མ་བགྲང་རྒྱུ་དང་གྲལ་རིམ་འཐབ་རྩོད་ཀྱི་བུམ་༤ཉ་མདུན་གྲལ་དུ་ལངས་ཏེ།",
    "མི་ངན་པ་འགེབས་སྲུང་དང་མི་བཟང་བོར་ཀླན་འདེབས་སོགས་ཕྱོགས་ལྷུང་གི་བྱ་སྤྱོད་ཀྱིས་མི་སེམས་མི་དཀྲུགས་པ་དང་།",
    "ནོར་འཛོལ་དང་རྙོག་དྲ་མི་བཟོ་བའི་ཧུར་བརྩོན་ཅན་ནི་ཏང་གི་རྩ་ཆེའི་རྒྱུ་ནོར་ཡིན་ལ།",
    "མི་འདིའི་རིགས་གྲངས་འབོར་ངེས་ཅན་ཞིག་ཡོད་མོད།",
    "ལས་འགུལ་ཁྲོད་སྐད་ཅོར་འུར་ཅོར་བརྒྱབ་པ་ཙམ་ལ་བློ་ཚིམས་ཏེ་ལས་འགན་གྲུབ་ཡོད་ཤག་གིས་ང་རྒྱལ་དང་ངོམས་ཁྱེར་བྱེད་ཀྱི་ཡོད་པ་དཔེར་ན།",
    "མང་ཚོགས་དཀྱུས་མས་བཅོས་བསྒྱུར་ལས་འགུལ་གྱི་ངོས་འཛིན་དང་།",
    "ཏང་དང་མི་དམངས་ལ་དགའ་མོས་ག་ཚོད་ཡོད་མེད།",
    "དོན་དངོས་དང་འཚམས་པའི་ཚོད་དཔག་གིས་དགེ་སྐྱོན་གྱི་གནས་ཚུལ་བརྗོད་ཐུབ་མཁན་ནི་ཉུང་ཤས་ཡིན།",
    "ཏང་གིས་ང་ཚོར་སློབ་སྟོན་ཡང་ཡང་གནང་དོན།",
    "དེ་ནི་ང་ཚོའི་རྒྱང་རིང་རྙོག་འཛིང་གི་གལ་ཆེའི་ལས་འགན་ཞིག་ལ་བརྩི་དགོས་ཞེས་བསྟན་པ་འདི་ནི་མཁས་མཛངས་དང་ཡང་དག་པ་ཞིག་རེད།",
    "ཐ་ན་འཐབ་རྩོད་དང་ཞྭ་མོ་ནག་པོ་གཡོགས་པ་དང་།",
    "དོན་དངོས་སུ་མི་མང་བོ་ཞིག་གི་བསམ་བློའི་ནང་ཐེ་ཚོམ་དང་ཡིད་དོགས།",
    "ཧུར་བརྩོན་ཅན་ཁག་ཅིག་གི་བསམ་བློ་དང་བྱ་སྤྱོད་ལ་དོན་དངོས་ཁྲོད་དཔྱད་ཞིབ་མ་བྱས་པར་མི་དམངས་མང་ཚོགས་ཡོངས་ཀྱི་བསམ་བློ་དང་བྱ་སྤྱོད་དུ་རྩིས་ཡོད་པ་སྟེ།",
    "འཐབ་རྩོད་སྐབས་ཐལ་དྲགས་བྱུང་ཡོད།",
    "བརྒྱ་ཆའི་བདུན་ཅུ་ནས་དགུ་བཅུ་ཡན་གྱི་མང་ཚོགས་ཀྱི་བསམ་བློའི་ཐོག་ནས་འདོད་མོས་དང་རྒྱབ་སྐྱོར་ཐོབ་པ་ཡིན་ན་ད་གཟོད་མི་དམངས་མང་ཚོགས་ཀྱི་བསམ་བློ་དང་བྱ་སྤྱོད་དུ་རྩིས་ཆོག་པ་དང་།",
    "གལ་སྲིད་འདི་ལྟར་མིན་པར་དེ་མང་ཚོགས་ཀྱི་བསམ་སྤྱོད་ལ་རྩིས་ཚེ་དེ་ནི་དངོས་ཡོད་དང་མི་འཚམས་པ་དང་མི་འོས་པ།",
    "ཁས་ལེན་བྱེད་ཐབས་མེད་པ་ཞིག་རེད།",
    "མང་ཚོགས་ཀྱི་མིག་ནི་གསལ་པོ་ཡིན་པ་དངོས་འབྲེལ་ཡིན་ནའང་།",
    "བསམ་འཆར་འདོན་མཁན་གྱི་ལྟ་བ་དེས་མི་དམངས་མང་ཚོགས་དང་མང་ཚོགས་ཀྱི་བསམ་བློ་མཚོན་ཐུབ་ཀྱི་ཡོད་མེད་ལ་ཞིབ་འཇུག་ངེས་པར་དུ་བྱེད་དགོས་པ་ལས།",
    "ཞིང་བྲན་དང་བྲན་གཡོག་བརྒྱུད་ནས་ཡར་ལངས་བཅིངས་འགྲོལ་དང་ཁྱོད་ཤི་ང་གསོན་གྱི་གྲལ་རིམ་འཐབ་རྩོད་སྤེལ་ཏེ།",
    "ཁོ་ཚོར་གྲལ་རིམ་འཁོན་སྡང་གི་ཁོང་ཁྲོའི་མེ་ལྕེ་འབར་དུ་བཅུག་ནས་འཐབ་རྩོད་སྤེལ་ཏེ་སོ་སོའི་སྡུག་བསྔལ་གྱི་ཞེ་འཁོན་སངས་པ་དང་།",
    "གྲལ་རིམ་འདིའི་ནང་གི་མི་རྣམས་ཀྱི་བཤུ་བཞོག་གྲལ་རིམ་གྱི་ལྟ་བ་དང་།",
    "ཚུར་འགུག་གམ་རྡུང་རྡེག་གི་ཐབས་ཤེས་གང་རུང་སྤྱོད་རྒྱུ་དང་།",
    "མི་ལ་འཐབ་རྩོད་གཏོང་སྐབས་ངེས་པར་དུ་ཉེས་ཅན་གྱི་དངོས་ཡོད་ནག་ཉེས་སྣ་ཚོགས་ཀྱི་དཔང་རྟགས་ཁུངས་འཕེར་དང་མང་ཚོགས་ཀྱི་ར་སྤྲོད་དགོས་པ་ལས།",
    "མང་ཚོགས་ལ་དགོངས་སེལ་ཞུ་ཐུབ་པ།",
    "སེམས་སྒྱུར་ལུས་སྒྱུར་བྱེད་འདོད་ཡོད་མཁན་ལ་དམིགས་བསལ་ལྟ་སྐྱོང་དང་སྐུལ་ལྕག་བྱེད་རྒྱུ་སོགས་སེམས་ཤུགས་སྤར་རྒྱུ་ནི་མ་གཞི་ཤིན་ཏུ་གལ་ཆེ་མོད།",
    "དཔེར་ན་བདག་གི་སྐྱེད་བྱེད་མགོན་པོ་ཚེ་བརྟན་ལ་མཚོན་ན།",
    "ཁོང་སྒེར་གྱི་བྱ་སྤྱོད་ལ་ནོར་འཁྲུལ་ཚབས་ཆེན་མེད་མོད།",
    "མང་ཚོགས་ཀྱི་འདོད་མོས་དང་འགལ་བའི་ཆ་ཏན་ཏན་ཡོད་ངེས།",
    "དེ་ལས་ལྡོག་སྟེ་ལས་དོན་རུ་ཁག་གི་ལས་བྱེད་ཚོས་མཐོ་འབྲིང་མི་སྣའི་ཁྲོད་ཀྱི་ཧུར་བརྩོན་ཅན་དུ་རྫུས་མཁན་གྱི་མི་ངན་དང་།"
  ]
}