    "དེ་ནས་རྣམ་པར་གྲོལ་བ་འཐོབ་པར་འགྱུར།",
    "རྣམ་པར་གྱུར་པ་འདུས་བྱས་ཀྱི་འདུ་བྱེད་རྣམས་སོ།",
    "དེས་ནི་འདུ་བྱེད་ཀྱི་ཁམས་དོན་དམ་པ་ཡིན་པར་བསྟན་ཏོ།",
    "རྨོངས་པ་མ་ཡིན་པ་གང་ཡིན་པ་དེ་དག་ཞི་གནས་དང་ལྷག་མཐོང་བསྒོམས་ན་གདོད་རྣམ་པར་གྲོལ་བ་ཐོབ་པར་འགྱུར་བའོ།",
    "རྣམ་པར་གཡེང་བ་ཞི་བར་བྱེད་པས་ཞི་གནས་ཞེས་བྱའོ།",
    "འོག་ནས་རྣལ་འབྱོར་རྣམ་པར་འབྱེད་པའི་སྐབས་ནས་རྒྱ་ཆེར་རྣམ་པར་འབྱེད་དོ།",
    "རྣམ་པར་གྲོལ་བ་ཞེས་བྱ་བ་ནི་འདུས་བྱས་དང་འདུས་མ་བྱས་ཀྱི་རྣམ་པར་གྲོལ་བ་རྣམ་པ་གཉིས་ཏེ།",
    "འདུས་བྱས་ཀྱི་རྣམ་པར་གྲོལ་བ་ནི་སེམས་དང་ཤེས་རབ་རྣམ་པར་གྲོལ་བ་རྣམ་པ་གཉིས་སོ།",
    "འདུས་མ་བྱས་ཀྱི་རྣམ་པར་གྲོལ་བ་ནི་འདུས་མ་བྱས་ཀྱི་མྱ་ངན་ལས་འདས་པ་རྣམ་པ་བཞིའོ།",
    "དེ་ནི་འདི་སྐད་དུ་གལ་ཏེ་འཆིང་བ་རྣམ་པ་གཉིས་ཡོངས་སུ་སྤང་བར་འདོད་ན་བསྐལ་པ་གྲངས་མེད་པ་གསུམ་དུ་ཞི་གནས་དང་ལྷག་མཐོང་ཤིན་ཏུ་གོམས་པར་བྱས་ན་གདོད་འཆིང་བ་རྣམ་པ་གཉིས་ལས་གྲོལ་བར་འགྱུར་རོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "མཚན་མའི་འཆིང་བ་ལས་ངེས་པར་གྲོལ་ན།",
    "གཉིས་ཀ་ལས་ནི་རྣམ་པར་གྲོལ་བར་འགྱུར།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "བཀའ་སྨྲ་བ་ཉིད་ཡང་དག་པར་བསྟན་པ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་བཞིན་ཉིད་རོ་གཅིག་པའི་མཚན་ཉིད་གསུངས་པའི་ཚེའམ།",
    "ཡོངས་སུ་སྨིན་པར་བྱ་བ་རྒྱུན་མི་འཆད་ཅིང་འཁོར་འདུས་པའི་དུས་དང་།",
    "ས་བོན་བཏབ་ནས་རྣམ་པར་གྲོལ་བ་ཡོངས་སུ་སྨིན་པའི་དུས་དང་།",
    "ལོག་པར་འཛིན་པ་རྣམ་པར་གཞིག་པའི་དོན་རྣམ་པར་གཞག་པའི་དུས་དང་།",
    "ཤེས་པ་སྐྱེ་ཞིང་དོན་དམན་པ་དག་ཟིལ་ཀྱིས་གནོན་པའི་ཕྱིར་དེའི་ཚེ་ན་ཞེས་གསུངས་སོ་ཞེས་འབྱུང་ངོ།",
    "འདི་ལ་དང་པོ་བཙས་པའི་ཚེ་ཁྱིམ་སྟོན་པར་གྱུར་པ་དང་།",
    "གཉིས་པ་ནི་བསྙེན་པར་རྫོགས་ནས་ལོ་བརྒྱ་ལོན་པའི་དགེ་སློང་མས་དེར་བསྙེན་པར་རྫོགས་པའི་དགེ་སློང་ལ་ཕྱག་བྱ་བ་ཡིན་ཏེ།",
    "སེམས་མཐོ་བའི་ང་རྒྱལ་གྱི་རྒྱུ་ལས་དང་རྣམ་པར་སྨིན་པ་ལ་སོགས་པ་བསྐྱེད་པའོ།",
    "ཤེས་པ་བརྡ་སྤྲོད་པར་བྱེད་པ་ཡོད་པར་ཤེས་ཞེས་བྱ་བ་ནི་ང་རྒྱལ་གྱི་དངོས་པོའི་ནུས་པ་བསྟན་པའོ།",
    "ཤེས་པ་བརྡ་སྤྲོད་པར་བྱེད་པ་ཡོད་པ་ཞེས་བྱ་བ་ནི་ང་རྒྱལ་མེད་པའི་དངོས་པོའི་ནུས་པ་བསྟན་པའོ།",
    "ཇི་ལྟར་ལེན་གསོལ་ཅིང་ཞིང་ཡོངས་སུ་དག་པ་ན་གནས་པར་གྱུར་ཅེ་ན།",
    "ཤེས་པ་བརྡ་སྤྲོད་པར་བྱེད་པའི་མཚན་ཉིད་ནི་ཕྱིས་འོག་ནས་སྟོན་ཏོ།",
    "རྒྱུན་དུ་ཞུགས་པ་ནི་བཞི་སྐྱེད་པར་བྱེད་དེ་དང་པོ་མ་གཏོགས་པའོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བས་ནི་གསུམ་སྐྱེད་པར་བྱེད་དེ་དང་བོ་གཉིས་མ་གཏོགས་པའོ།",
    "ཕྱིར་མི་འོང་བས་ནི་གཉིས་སྐྱེད་པར་བྱེད་དེ་དང་པོ་གསུམ་མ་གཏོགས་པའོ།",
    "རྒྱུན་དུ་ཞུགས་པས་བདུན་སྐྱེད་པར་བྱེད་དེ་དང་པོ་གཉིས་མ་གཏོགས་པའོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བར་ཞུགས་པས་དྲུག་སྐྱེད་པར་བྱེད་དེ་སྔ་མའི་གསུམ་པོ་དག་མ་གཏོགས་པའོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བས་ལྔ་སྐྱེད་པར་བྱེད་དེ།",
    "ཕྱིར་མི་འོང་བས་ཞུགས་པས་བཞི་སྐྱེད་པར་བྱེད་དེ་སྔ་མའི་ལྔ་པོ་དག་མ་གཏོགས་པའོ།",
    "ཕྱིར་མི་འོང་བའི་འབྲས་བུ་ལ་གནས་པས་གསུམ་སྐྱེད་པར་བྱེད་དེ་སྔ་མའི་དྲུག་མ་གཏོགས་པའོ།",
    "དགྲ་བཅོམ་པ་ལ་ཞུགས་པས་གཉིས་སྐྱེད་པར་བྱེད་དེ་སྔ་མའི་བདུན་པོ་དག་མ་གཏོགས་པའོ།",
    "བདག་ཉིད་ཁེངས་ཤིང་གཞན་དག་ལ་རློམ་སེམས་དང་བཅས་པའི་མཚན་ཉིད་དེ་ང་རྒྱལ་མེད་པ་ལ་སྒྲིབ་ཅིང་སྡུག་བསྔལ་སྐྱེད་པར་བྱེད་པའི་རྟེན་བྱེད་པའི་ལས་ཅན་ནོ།",
    "འདི་ལྟར་རྣམ་པ་གསུམ་པོ་དེ་དག་གལ་ཏེ་ལྟ་བ་ལ་བརྟེན་ནས་འདུ་བྱེད་སྐྱེད་པར་བྱེད་ན།",
    "བདག་དང་མཚུངས་སོ་སྙམ་པའི་ང་རྒྱལ་ཀྱི་རྣམ་པ་ནི་འབྲིང་དང་ཆེན་པོའི་རྣམ་པ་ལ་བརྟེན་ནས་ང་རྒྱལ་རྣམ་པ་གཉིས་སྡུད་པར་བྱེད་དེ།",
    "ཁྱད་པར་དུ་གྱུར་པ་ལ་མཚུངས་སོ་སྙམ་དུ་འཛིན་པ་གང་ཡིན་པ་དེ་ནི་ཆེ་བའི་ང་རྒྱལ་ཞེས་བྱའོ།",
    "བདག་ཆུང་ངོ་སྙམ་པའི་ང་རྒྱལ་ནི་ཆེན་པོའི་རྣམ་པ་ལ་བརྟེན་ནས་ང་རྒྱལ་རྣམ་པ་གཅིག་སྡུད་པར་བྱེད་དེ།",
    "གསུམ་ནི་ཆེན་པོའི་རྣམ་པ་ལ་བརྟེན་ཏེ་སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཅིའི་ཕྱིར་མ་ལུས་པར་མཁྱེན་ཞེས་གསུངས།",
    "ཐམས་ཅད་མཁྱེན་པའི་གང་ཟག་ཅེས་ཀྱང་མི་བྱ་སྟེ།",
    "འདི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱི་གསུང་ནི་ཡང་དག་པའི་བདེན་པ་ཡིན་ལ་གདོན་མི་ཟ་བར་ཐམས་ཅད་མཁྱེན་པའི་གང་ཟག་ཀྱང་ཡོད་པ་ཡིན་ནོ།",
    "བཀྲེས་པ་དང་གྲང་བ་ལ་སོགས་པའི་སྡུག་བསྔལ་མྱོང་བ་རྣམས་ཀྱང་མེད་པར་འགྱུར་རོ།",
    "ཞེས་གསུངས་པ་ལྟ་བུ་སྟེ།",
    "ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་དག་ནི་རྒྱང་གྲགས་གཅིག་ལ་གཞུ་ལྔ་བརྒྱ་ཡོད་དོ་ཞེས་ཟེར་རོ།",
    "མཛོད་ཀྱི་བསྟན་བཅོས་ལས་འདིའི་ཚད་རྒྱ་ཆེར་རྣམ་པར་འབྱེད་དེ།",
    "དེའི་ཕྱིར་དེའི་ཚིག་ལེའུར་བྱས་པ་ལས།",
    "ཕྱི་མ་ཕྱི་མ་བདུན་འགྱུར་བསྐྱེད་པར་བྱ།",
    "དེ་ལ་རབ་ཏུ་དབེན་པ་ནི་མང་པོས་གནོད་པར་འགྱུར་བ་དང་།",
    "སློབ་དཔོན་ཡང་དག་བདེན་པའི་བརྗེད་བྱང་ལས་རྒྱུ་ལ་གནས་པའི་ཚེ་ནི་བདུད་སྐྲག་པར་བྱེད་པ་དང་སློང་བ་དང་།",
    "འབྲས་བུའི་གནས་སུ་ཕྱིན་པའི་ཚེ་བདུད་སྐྲག་པར་བྱེད་པ་ནི་དགྲ་བཅོམ་པར་འགྱུར་རོ།",
    "བརྟགས་པ་རྣམས་སྤྱིར་སྨོས་པ་དང་བརྟགས་པ་རྣམ་པར་ཕྱེ་སྟེ་བསྟན་པའོ།",
    "ཕུང་པོའི་འགོག་པ་མངོན་དུ་བབྱི་བ་ཐོབ་པའི་སླད་དུ་ཤེས་པ་བརྡ་སྤྲོད་པར་བབྱིད་ཅེས་བྱ་བ་འདི་མན་ཆད་ནི་གཉིས་པ་བརྟགས་པ་རྣམ་པར་ཕྱེ་སྟེ་བསྟན་པའོ།",
    "མཁས་པས་བརྟག་པར་བྱ་བའི་སྤྱོད་ཡུལ་རྣམ་པ་དྲུག་ལ་བརྟེན་ནས་ཤེས་པ་བརྡ་སྤྲོད་པར་བྱེད་པ་བསྟན་པ་དང་།",
    "འདིར་ནི་དང་པོར་མཁས་པས་བརྟག་པར་བྱ་བའི་སྤྱོད་ཡུལ་རྣམ་པ་དྲུག་ལ་བརྟེན་ནས་ཤེས་པ་བརྡ་སྤྲོད་པར་བྱེད་པ་སྟོན་ཏེ།",
    "མཁས་པར་བྱ་བ་རྣམ་པ་དྲུག་ནི་འདི་ལྟ་སྟེ།",
    "ཡང་ན་སྒོ་གཅིག་ལ་བརྟགས་པ་རྣམ་པ་གཅིག་ཏུ་བྱས་ན་ཡང་འགལ་བ་མེད་དོ།",
    "ཕུང་པོའི་རྣམ་པར་འགྱུར་བ་དང་།",
    "དེ་ལ་དགེ་སློང་ཁ་ཅིག་ནི་ཕུང་པོ་དམིགས་པ་ཞེས་བྱ་བ་ནི་བདག་ཉིད་ཀྱི་ཐོབ་པ་གང་ཡིན་པ་བརྡ་སྤྲོད་པར་བྱེད་པ་སྟེ།",
    "རྣམ་པར་ཕྱེ་སྟེ་ལུང་བསྟན་པའི་མཚན་ཉིད་དམ།",
    "རྣམ་པར་གཞག་པའི་ལུང་བསྟན་པའི་མཚན་ཉིད་དམ།",
    "འདི་ལྟར་རོ་གཅིག་པའི་རིག་པ་ཁོང་དུ་མ་ཆུད་པའི་ཕྱིར་འདི་ནི་ཡང་དག་པའི་རིག་པ་ཡིན་ནོ་སྙམ་པའི་འཛིན་པ་སྐྱེད་པར་བྱེད།",
    "དགེ་སློང་ཁ་ཅིག་ནི་ཕུང་པོའི་རྣམ་པར་འགྱུར་བ་དམིགས་པས་ཞེས་བྱ་བ་འདི་ནི་བཞི་པ་ཕུང་པོའི་རྣམ་པར་འགྱུར་བའི་མཚན་ཉིད་བསྟན་པ་སྟེ།",
    "འདི་ལྟར་འགག་པ་མེད་པ་རོ་གཅིག་པ་ཉིད་དུ་མ་ཤེས་པའི་ཕྱིར་ཡང་དག་པར་འགྱུར་བ་ཡོད་དོ་སྙམ་པའི་འཛིན་པ་འདི་འབྱུང་ངོ།",
    "འདི་ལྟར་རྣམ་པར་དག་པ་རོ་གཅིག་པ་ཉིད་དུ་མ་ཤེས་པའི་ཕྱིར་རྣམ་པར་དག་པ་ཡང་དག་པར་ཡོད་དོ་སྙམ་པའི་འཛིན་པ་འདི་འབྱུང་ངོ།",
    "འདི་ལྟར་ཡུལ་དང་ཤེས་པ་རོ་གཅིག་པ་ཉིད་དུ་མ་ཤེས་པའི་ཕྱིར་ཡང་དག་པར་འགོག་པ་ཐོབ་པའི་ལམ་ཡོད་དོ་སྙམ་པའི་འཛིན་པ་འདི་འབྱུང་ངོ།",
    "དུས་གསུམ་ལ་སོགས་པའི་མཚན་ཉིད་རྣམ་པ་སྣ་ཚོགས་མི་མཐུན་པ་སྔར་བསྟན་པ་ལྟ་བུ་ཡོད་ཀྱང་ཡང་དག་པའི་ཚུལ་དུ་ན་བདག་མེད་པར་གཅིག་པའོ།",
    "ཚིག་གསུམ་པས་ནི་དགག་པར་བྱ་བ་ཕྱོགས་ཀྱི་རྣམ་པ་བསྟན་པ་སྟེརྨྱེ།",
    "ཚིག་བཞི་པས་ནི་ཤེས་པར་བྱ་བའི་ཕྱོགས་ཀྱི་རྣམ་པ་བསྟན་ཏེ།",
    "ཚིག་ལྔ་པས་ནི་ཐོབ་པར་བྱ་བའི་ཕྱོགས་ཀྱི་རྣམ་པ་བསྟན་ཏེ།",
    "ཚིག་དྲུག་པས་ནི་བསྒྲུབ་པར་བྱ་བའི་ཕྱོགས་ཀྱི་རྣམ་པ་བསྟན་ཏེ།",
    "སྐྱེ་མཆེད་ལ་སོགས་པ་ལ་ཡང་དེ་བཞིན་དུ་དྲུག་པོ་འདི་དག་ཡོད་པར་སྦྱར་རོ་ཞེས་འབྱུང་ངོ།",
    "འགོག་པའི་མཚན་ཉིད་ཅེས་གསུངས་པ་དང་།",
    "གདོན་མི་ཟ་བར་བྱུང་ན་ཟད་པ་དང་མཚུངས་པར་ལྡན་པའི་ཕྱིར་རོ་ཞེས་འབྱུང་ངོ།",
    "ཟས་འགོག་པ་མངོན་དུ་བགྱི་བ་ཐོབ་པའི་སླད་དུ་ཤེས་པ་བརྡ་སྤྲོད་པར་བགྱིད་ཅེས་བྱ་བ་ནི་གསུམ་པ་ཟས་རྣམ་པ་བཞིའི་སྒོ་ལ་བརྟེན་ནས་ཤེས་པ་བརྡ་སྤྲོད་པར་བྱེད་པ་བསྟན་པ་སྟེ།",
    "ཚིག་རྣམ་པ་དྲུག་ལས་དང་པོ་གཉིས་ནི་སྤྱི་ཡིན་ཏེ་སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཕྱི་མ་བཞི་ནི་གོ་རིམས་བཞིན་དུ་སྡུག་བསྔལ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "དེ་ལས་ཅིའི་ཕྱིར་སྡུག་བསྔལ་གྱི་བདེན་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "སྡུག་བསྔལ་གྱི་བདེན་པ་དེ་ནི་ཕྱིན་ཅི་ལོག་བཞིའི་གནས་ཡིན་པས་ཕྱིན་ཅི་ལོག་བསལ་བས་ཕྱིར་ཡོངས་སུ་ཤེས་པར་བྱ་བའོ་ཞུ།",
    "མངོན་སུམ་དུ་བྱ་བ་ནི་མངོན་སུམ་དུ་བྱས་པའི་དོན་ཡིན་ཏེ།",
    "བདེན་པ་གསུམ་པོ་དག་ཀྱང་ཡོངས་སུ་ཤེས་པར་བྱ་བ་ཡིན་ན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྡུག་བསྔལ་ཁོ་ན་ཡོངས་སུ་ཤེས་པར་བྱ་བར་གསུངས་པའམ།",
    "ཡང་ན་སྡུག་བསྔལ་འབའ་ཞིག་ཡོངས་སུ་ཤེས་པར་བྱ་བ་ཡིན་པས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀུན་འབྱུང་ཁོ་ན་ཡོངས་སུ་སྤང་བར་གསུངས་པའམ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་འགོག་པ་ཁོ་ན་མངོན་སུམ་དུ་བྱ་བར་གསུངས་པའམ།",
    "ཁམས་འགོག་པ་མངོན་དུ་བགྱི་བ་ཐོབ་པའི་སླད་དུ་ཤེས་པ་བརྡ་སྤྲོད་པར་བརྨིད་ཅེས་བྱ་བ་ནི་ལྔ་པ་ཁམས་བཅོ་བརྒྱད་ལ་བརྟེན་ནས་ཤེས་པ་བརྡ་སྤྲོད་པར་བྱེད་པ་བསྟན་ཏོ།",
    "ཐ་མ་གཉིས་ནི་སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཁམས་ཀྱི་བར་དུ་གང་ཡིན་པ་དེ་ནི་ཁམས་སྣ་ཚོགས་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "གཟུགས་ཀྱི་ཕུང་པོ་ཡང་གཞན་ལ་དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པའི་ཕུང་པོའི་བར་ཡང་གཞན་པའོ།",
    "ཕྱི་མ་ལ་དྲན་པ་ཉེ་བར་གཞག་པ་ལ་སོགས་པ་ནི་རྟོགས་པའི་སྤྱོད་པ་ལ་བརྟེན་ནས་ཤེས་པ་བརྡ་སྤྲོད་པར་བྱེད་པ་ཡིན་ནོ་ཞེའོ།",
    "ཞིབ་ཏུ་དེ་ཉིད་ལས་གསུངས་པ་བཞིན་ནོ་ཞེའོ།",
    "གང་ལ་དྲན་པ་ཉེ་བར་གཞག་པར་བྱེད་པ་དང་།",
    "དེ་ལ་གང་ལ་དྲན་པ་ཉེ་བར་འཇོག་པར་བྱེད་ཅེ་ན།",
    "དེ་ལ་ཤེས་རབ་དང་དྲན་པས་ཏིང་ངེ་འཛིན་སྡུད་པར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་ངོ་བོ་ཉིད་ཀྱིས་དྲན་པ་ཉེ་བར་གཞག་པ་ཡིན་ནོ།",
    "དེ་ལ་ངོ་བོ་ཉིད་རྣམ་པར་འབྱེད་པ་ནི་ཐམས་ཅད་ཡོད་པར་སྨྲ་བ་དག་འདོད་པ་དང་སྦྱར་ན།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་དང་བཅས་པ་ཞེས་གསུངས་པའི་ཕྱིར་དང་།",
    "དྲན་པས་ཏིང་ངེ་འཛིན་ཡང་དག་པར་སྡུད་སྣེཔ་ནི་ངོ་བོ་ཉིད་ཀྱི་དྲན་པ་ཉེ་བར་གཞག་པའོ་ཞེས་འབྱུང་ངོ།",
    "དོན་རྣམ་པ་བཅུ་བསྟན་པའི་ཕྱིར་ཚིག་བཅུ་པོ་འདི་དག་གསུངས་པ་ཡིན་ཏེ།",
    "བདུན་པ་དྲན་པ་ཉེ་བར་གཞག་པ་སྐྱེས་པ་གནས་པ་རྟོགས་ཤིང་དམིགས་པ་ཞེས་བྱ་བ་དེ་ནི་རྣམ་པར་འགྲེལ་པའི་ལམ་ཡིན་ཏེ།",
    "རྫུ་འཕྲུལ་དང་སེམས་ལུང་བསྟན་པ་དང་ཡང་དག་པར་བསྟན་པ་རྣམས་ཀྱིས་སོ།",
    "དང་པོའི་ཚིག་གཉིས་ནི་ཕུང་པོ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཚིག་ལེའུར་བྱས་པ་ལས།",
    "ཟག་པ་མེད་པའི་འདུས་བྱས་དང་།",
    "རྒྱ་ཆེར་རྣམ་པར་འབྱེད་པ་ནི་བསྟན་བཅོས་ཡང་དག་པའི་རིགས་པ་དང་།",
    "བསྟན་བཅོས་རྣལ་འབྱོར་སྤྱོད་པའི་ས་ལས་ཀྱང་འདི་དང་མཐུན་པར་སྟོན་ཏོ།",
    "དེ་དག་ཐོབ་པར་བྱ་བའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་ཏིང་ངེ་འཛིན་ལ་རྫུ་འཕྲུལ་གྱི་རྐང་པ་ཞེས་རྣམ་པར་གཞག་ཅེ་ན།",
    "འདུན་པ་ལ་སོགས་པའི་ཏིང་ངེ་འཛིན་བཞི་པོ་དག་གོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "དེ་ལ་འདིར་བཅོམ་ལྡན་འདས་ཀྱིས་ཏིང་ངེ་འཛིན་ཀྱི་འབྲས་བུ་ལ་ནི་རྫུ་འཕྲུལ་ཞེས་གསུངས་སོ།",
    "འདུན་པ་ལ་སོགས་པའི་ཏིང་ངེ་འཛིན་ལ་ནི་རྐང་པ་ཞེས་གསུངས་ཏེ།",
    "བསྟན་བཅོས་ཡང་དག་པའི་རིགས་པ་ལས་ཀྱང་ཕལ་ཆེར་འདི་དང་མཐུན་པར་འབྱུང་ངོ།",
    "རྫུ་འཕྲུལ་ཡོན་ཏན་ཁྱད་པར་ཅན་གྱི་གནས་སུ་གྱུར་པའི་ཕྱིར་རྫུ་འཕྲུལ་རྨི་རྐང་པ་ཞེས་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "ཕ་རོལ་གནོན་པར་ནུས་པ་དེ་བཞིན་དུ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ཀྱང་ཡོངས་སུ་རྫོགས་པར་ཡོད་ཅིང་།",
    "མི་གཡོ་བ་ཐོབ་པར་གྱུར་ན།",
    "ཕ་རོལ་གནོན་པར་ནུས་ཏེ།",
    "གཞན་ཡང་ཟིལ་གྱིས་གནོན་པར་ནུས་པ་དང་།",
    "ཟིལ་རྨིས་གནོན་པར་དཀའ་བའི་ཕྱིར་རོ།",
    "སྔ་ཕྱི་རྣམ་པར་དབྱེ་བའི་ཕྱིར་དང་།",
    "ཟིལ་གྱིས་གནོན་པར་མི་ནུས་པ་ལ་གནས་པའི་ཕྱིར་དང་།",
    "རྣམ་པའི་ཆུང་ངུའི་དད་པ་ལ་སོགས་པ་ནི་མཐུ་ཆུང་བའི་ཕྱིར་མི་མཐུན་པའི་ཕྱོགས་ཀྱིས་ཟིལ་གྱིས་གནོན་པར་ནུས་ལ།",
    "ཆོམས་འུཔར་དཀའ་བའི་ཕྱིར་ནི་སྟོབས་ཞེས་བྱའོ་ཞེས་འབྱུང་ངོ།",
    "ཆོམས་པར་དཀའ་བའི་དོན་ཀྱི་ཕྱིར་ནི་སྟོབས་ཞེས་བྱའོ་ཞེས་འབྱུང་སྟེ།",
    "དེ་ལ་ངོ་བོ་ཉིད་རྣམ་པར་འབྱེད་པ་ནི།",
    "གཞན་ཡང་བསྟན་བཅོས་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་ལས།",
    "ཤེས་པ་བརྡ་སྤྲོད་པར་བཀྱིད་དོ་ཞེས་བྱ་བ་འདི་ནི་གསུམ་པ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ལ་བརྟེན་ནས་ཤེས་པ་བརྡ་སྤྲོད་པར་བྱེད་དོ།",
    "ཐམས་ཅད་མ་ལུས་པར་སྤང་བར་བྱ་བ་དང་།",
    "དབུས་མཐའ་རྣམ་པར་འབྱེད་པ་ལས།་",
    "དོན་དམ་པའི་བདེན་པ་ཐམས་ཅད་དུ་རོ་གཅིག་པའི་མཚན་ཉིད་མ་འཚལ་བ་ཤ་སྟག་ལགས་སོ་སྙམ་བཀྱིད་པས་ཞེས་བྱ་བ་ནི་གཉིས་པ་བདག་ཉིད་ཀྱི་བསམ་པ་བཟླས་ཏེ་གསོལ་བའོ།",
    "དེའི་བེེད་དུ་བཅོམ་ལྡན་འདས་ནི་ངོ་མཚར་རྨད་དུ་གྱུར་པ་དེ་བཞིན་དུ་བཅོམ་ལྡན་འདས་ནི་ལེགས་པར་གསུངས་པ་ལགས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི།",
    "བསྔགས་པར་བྱ་བའི་བསྟན་པ་སྨོས་པ་དང་།",
