    "དེ་དག་དེ་དང་དེ་ལ་མཁས་བྱ་བ་ནི་གཞན་ལ་མི་མཁས་པ་མ་ལགས་ཤིང་།",
    "དེ་དང་དེ་ལ་ལྷག་པར་མཁས་ཤིང་བཀའ་བབས་ཀྱི་བུ་ཆེན་ཡིན་པའི་དོན་ནོ།",
    "མཁས་མཆོག་འདི་ཉིད་སྔོན་བྱོན་གངས་ཅན་མཁས་པའི་ཁྲོད་ནས་འགྲན་གྱི་དོ་མེད་ལྟ་བུར་བཞུགས་ཤིང་བཀའ་དྲིན་ལྷག་པར་ཆེ་ནའང་དུས་དེང་སང་འདིའི་སྐུ་གསུང་ཐུགས་ཀྱི་ཡོན་ཏན་ལ་རྗེས་སུ་དྲན་པ་ཅུང་དཀོན་པ་ལྟ་བུར་སྣང་ཞིང་།",
    "རྣམས་བཏང་སྙོམས་སུ་མ་གནས་པར་ཐུགས་ཅུང་ཞིག་གཡོ་བ་སྙད་པའི་གསལ་འདེབས་དང་།",
    "དེ་དང་བྲལ་ན་བརྗོད་བྱའི་དོན་དང་ལྡན་ཡང་མཛེས་མ་གཅེར་བུར་རྒྱུ་བ་བཞིན་འགྱུར་བའི་ཕྱིར་ན་སྙན་དངགས་ནི་སྒྲ་རིག་པར་ངེས་པར་མེད་ཐབས་བྲལ་བ་ཡིན།",
    "དེས་ན་ཚིག་རྒྱན་སྦྱོར་ཚུལ་སྙན་དངགས་ཀྱི་གཞུང་ལ་འདྲིས་པར་བྱ་བ་ནི་མཁས་བྱའི་གནས་ལྔ་གར་མེད་དུ་མི་རུང་བ་ཡིན་ཏེ།",
    "གཞན་ཡང་སྔོན་གྱི་རབས་དང་གཞུང་ལུགས་རྩོམ་པ་ལ་ཚིག་དོན་ཡིད་འཕྲོག་པའི་ངག་སྒོ་ཡངས་པར་འགྱུར་བ་དང་།",
    "དེ་ལྟ་ནའང་དེ་དག་ཡུལ་དུས་འཕོ་འགྱུར་སྣ་ཚོགས་ཀྱིས་འགའ་ཞིག་ད་ལྟ་དཔེ་རྒྱུན་ཙམ་ཡང་མ་བཞུགས་པ་དང་།",
    "འཇོག་ཚུལ་སྣ་ཚོགས་ལས་ཀུན་མཁྱེན་འཇམ་དབྱངས་བཞད་པའི་རང་ལུགས་བཞིན་དོན་བདུན་དུ་ངེས་པར་མཛད་པ་དང་།",
    "སྔར་གྱི་བོད་འགྲེལ་རྣམས་སུ་སློབ་དཔོན་དབྱུག་པ་ཅན་ཕེབས་པའི་དུས་རབས་འདོད་ཚུལ་ཐ་དད་པ་དཔེར་ན།",
    "འགོག་རྒྱན་གྱི་བཅུ་གསུམ་པ་གྲོས་ཀྱིས་འགོག་པར།",
    "བྱ་དཀའ་གཞན་བསྟན་པ་སོགས་ལ་རྣམ་དཔྱོད་རིག་རྩལ་གྱི་ངོ་མཚར་སྒྱུ་མའི་རོལ་རྩེད་སྣ་ཚོགས་བསྒྱུར་བས་གཞན་གྱི་རྡོ་ཆག་བཙན་སྦྱོར་བྱས་པ་ལ་སྒྲ་རྒྱན་དུ་བཏགས་པ་ལྟ་བུ་མིན་པར་རང་བྱུང་ལྷུན་གྲུབ་རྩོལ་བྲལ་དུ་སྙན་ཞིང་འཇེབས་ལ་ཉམས་རག་རྡོ་བློ་བཟང་བསྟན་འཛིན་གྱི་དཔྱད་རྩོམ་ཐོར་བུ།",
    "སྨྲ་བའི་འབབ་སྟེགས་དོན་དུ་གཉེར་བའི་སྐྱེ་བོ་གཟུར་གནས་ཀུན་ལ་སྣང་བ་གསར་བ་ཞིག་ཐོབ་པ་ལགས་ན་དགའ་བའི་གར་སྟབས་བསྒྱུར་བར་འོས་ཡིན།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཀུན་ཏུ་ཡང་ཆེས་སྔ་བའི་དུས་སུ་ནི་ཡི་གེ་མེད་པར་མངོན་ལ།",
    "དེ་སང་ཡང་སྤྱོད་པའི་ཤར་ཕྱོགས་རྒྱ་ནག་སོགས་ཀྱི་ཡི་གེ་ལས་དཔག་པར་ནུས་ཤིང་།",
    "ཇར་མན་སོགས་ཀྱི་ཡི་གེའང་རྒྱ་གར་དབུས་ཀྱི་བྲམ་ཟེའམ་ཚངས་པའི་ཡི་གེ་ལས་རིམ་བཞིན་མཆེད་པར་གསུངས་སོ།",
    "༡༩༩ ལོར་བོད་ནས་དཔར་བསྐྲུན་བྱས་པའི་གངས་ཅན་རིག་མཛོད་ཨང་།",
    "རི་བོང་གྱི་རྭ་ལྟར་ཁས་ལེན་པར་མི་རུང་ཞིང་ཡིན་པ་མི་སྲིད་པའི་ཤེས་བྱ་ཞིག་ཏུ་འདོད་དོ།",
    "ཚ་བའི་ཡུལ་དེར་ལྟོ་གོས་ཁོ་ནའི་ཆེད་དུ་དུས་ཚོད་ཇི་ཡོད་ཟད་གྲོན་བྱས་ཏེ་གསེར་སྦྲམ་དང་གློག་ཧྲུལ་གྱི་དཔེ་བཞིན་མ་ཡིན་པར་མགོ་དང་གོས་ལ་མེ་ཤོར་བ་ལྟ་བུའི་བརྩོན་འགྲུས་ཀྱི་སྟོབས་བསྐྱེད་དེ།",
    "འོན་ཀྱང་དབྱངས་གསལ་བསྡུ་ལུགས་ནི་རྒྱ་གར་གྱི་དེ་ལྟ་བུའི་གཙང་སང་བ་སུ་ལའང་མི་སྣང་ཞིང་།",
    "སེངྒ་ལ་སོགས་ཀྱང་ཡི་གེ་འདི་ལས་བྱས་པ་ཡིན་པས།",
    "པ་གསུམ་གྱིས་ལེགས་པར་མཉེས་པར་བྱས་ཏེ་མཁས་པའི་གོ་འཕང་མཐོན་པོར་གཤེགས།",
    "བརྡ་སྤྲོད་པའི་གཞུང་སུམ་ཅུ་པ་དང་རྟགས་ཀྱི་འཇུག་པ་སོགས་ལེགས་པར་གཏན་ལ་ཕབ་ཅིང་།",
    "སྐད་ཀྱིས་བྲིས་ཞེས་གསུངས་པའི་ཕྱིར།",
    "མ་འོངས་བོད་ཀྱི་འགྲོ་བ་ལ་དྲིན་གཞན་ལས་ཆེ་ཚུལ་ཞལ་གྱིས་བཞེས་པ་ལས་ཤེས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "༡༨༡ པར།",
    "ལམ་བགྲོད་པར་དཀའ་བ་རྒྱ་གར་དུ།",
    "དོན་བརྙེད་པར་དཀའ་བའི་ཡིག་འབྲུ་བསྟན།",
    "བློ་ཐེ་ཚོམས་སེལ་བའི་མཛུབ་ཁྲིད་བྱས།",
    "ཚེགས་དབྱངས་ཡིག་རྣམས་ལ་མཁས་པར་སྦྱང་།",
    "རྗེ་རྒྱལ་པོ་ཉི་ཟླའི་ཚུལ་དུ་བཞུགས།",
    "ལྷག་པར་དུའང་སྤྱི་ལོའི་དུས་རབས་བཅུ་སྐོར་ལ་ཕེབས་པའི་ལོ་ཆེན་རིན་ཆེན་བཟང་པོ་སོགས་མངའ་རིས་ཀྱི་མཁས་པ་རྣམས་དང་།",
    "དུས་རབས་འདིའི་སྐོར་ལ་བྱོན་པའི་ཀུན་མཁྱེན་མི་ཕམ་འཇམ་དཔལ་དབྱངས་དང་།",
    "འཕེལ་རྒྱས་བཅས་བྱེད་རྒྱུ་ནི་རང་རིགས་ཡོངས་ཀྱི་ལས་འགན་དོན་པོ་དེ་ལགས་ན།",
    "དེང་སྐབས་ལྷ་སའི་ཕལ་སྐད་དཔེར་ན།",
    "གཞན་སྔར་ཡི་གེ་འབྲི་རོགས་ཞུས་པས་ང་ལྷ་སར་འགྲོ་མི་ཐུབ་པའི་ལན་རྒྱབ་པ་བཞིན།",
    "དེ་རིང་དེ་ལས་ཡག་པ་ཙམ་ཞིག་ཡི་གེར་འགོད་པར་ནུས་ཀྱང་ནམ་ཞིག་དེའང་ཡིག་སྐད་དུ་གྱུར་ཏེ་གོ་བར་མི་ནུས་པ་སྔར་སྨོས་པ་དེ་ལས་ཀྱང་ཐ་ཤལ་གྱི་ཕལ་སྐད་ཅིག་འབྲི་དགོས་པར་འགྱུར་བ་ནི་ད་ལྟ་ནས་རང་རིགས་ཀྱིས་བོད་ཡིག་འབྲི་ཀློག་མི་མཁྱེན་པ་འདི་ལས་ལྷག་པའི་ཤེས་བྱེད་གཞན་ཞིག་མི་དགོས་པར་སེམས།",
    "དེར་ཡི་གེ་འབྲི་ཀློག་ཤེས་མཁན་ཞིག་ཡོད་པ་དེ་ཉིད་རང་ཉིད་ཡིག་མཁན་དུ་རློམས་ཀྱང་ཡི་གེ་ལེགས་པར་མི་ཤེས་པས་ཁོ་པས་བྲིས་པར་གཞན་གྱིས་གོ་དོན་མི་རྟོགས་ཤིང་གོ་བརྡ་སྤྲོད་དུ་རང་ཉིད་འགྲོ་དགོས་པར་གྲགས།",
    "ཁོ་བོ་ལྷ་སར་འགྲོ་མི་ཐུབ་ཅེས་ལན་བཏབས།",
    "འཛུགས་བསྐྲུན་སོགས་ལ་གཙང་མའི་རང་བཙན་ཞིག་ཏུ་མ་མཐོང་བས།",
    "བླུན་པོས་སོལ་བ་བྱས་ལ་ལྟོས།",
    "དེའི་རིག་གཞུང་སྲུང་སྐྱོབ་དང་འཕེལ་རྒྱས་བྱེད་རྒྱུ་དེ་ནི་ཕྱིར་ཤིག་རྒྱབ་པས་མི་ཕན་པར་གོམ་གང་མདུན་དུ་སྤོས་ཏེ་རྒྱུན་འཛིན་དང་སྲུང་སྐྱོབ་བྱེད་དགོས་པ་ཡིན།",
    "འདི་ལ་ཅི་ནས་ཀྱང་གཟབ་ནན་མཛད་གལ་ཆེ་བར་མཐོང་ལགས།",
    "གནས་ནས་འགྲོ་ལ་བློ་མིག་ཐོབ་པར་ཤོག།",
    "ལེགས་པར་འཁྲུངས་ཤིང་འགྲོ་རྣམས་ཉམས་ངའི་འཇིགས་ལས་སྒྲོལ་བའི་མཚན་འཆང་བ།",
    "འཇུག་པ་ཁོ་ནར་བསམ་ནས་ལྷག་པར་དད།",
    "འཇིག་རྟེན་བློ་ངན་རྣམ་པར་འཁྲུལ་པར་གྱུར།",
    "ལུང་བསྟན་པར་མཛད་དོ།",
    "དེ་ནས་བསྐལ་པ་བི་པུ་ཥ་སྟེ་རྣམ་པར་རྒྱས་པ་ཞེས་བྱ་བ་ལ་དེ་བཞིན་གཤེགས་པ་དོན་ཡོད་གྲུབ་པའི་དྲུང་དུ་ཕྱོགས་བཅུའི་ཞིང་རབ་འབྱམས་ཐམས་ཅད་ཀྱི་ཉེ་བར་འཚེ་བ་འཇིགས་པ་བརྒྱད་དང་བཅུ་དྲུག་སོགས་ལས་སྲུང་ཞིང་སྐྱོབ་པར་དམ་བཅས།",
    "འགྲོ་བའི་དོན་ལ་རྒྱུན་ཆད་མེད་པར་གཞོལ།",
    "འགྲོ་བ་རྣམས་འཇིགས་པ་བརྒྱད་དང་བཅུ་དྲུག་ལས་སྐྱོབ་པར་མཛད་ཅིང་།",
    "ཕོངས་པ་ཐམས་ཅད་ལས་སྒྲོལ་པར་མཛད།",
    "ཕྲིན་ལས་ཀྱི་རོལ་བ་ནམ་མཁའི་མཐའ་ཁྱབ་ཏུ་སྤྲོ་བཞིན་བཞུགས།",
    "སྒྲོལ་མའི་རྒྱུད་ཇི་ལྟར་གསུངས་པའི་ཚུལ།",
    "གཞུང་དང་རྟོགས་པ་ཉམས་ཤིང་ནུབ་པར་གྱུར་ནས་ཀྱང་།",
    "དེ་ཡང་ནུབ་པར་གྱུར་ནས་རྟོགས་པ་འདི་ཡང་བྱུང་།",
    "རྒྱས་པར་བསྟན་པའི་རྒྱུད་ལས་བསྡུས་བྱས་ནས།",
    "ནམ་ཞིག་ན་དེའང་ནུབ་པར་གྱུར་པ་ན།",
    "ལྷ་ཀླུ་གནོད་སྦྱིན་སོགས་ལས་ཅན་གྲངས་མེད་པ་ལ་སྒྲོལ་མའི་རྒྱུད་འབུམ་ཕྲག་བརྒྱ་བ་གསུངས།",
    "རྫོགས་ལྡན་གྱི་བསྐལ་པར་སྒྲོལ་མའི་བསྟོད་རྒྱུད།",
    "དེ་ལྟར་རྫོགས་ལྡན་སོགས་ཀྱི་དུས་སུ་རྒྱུད་དེ་དག་ལྷ་དང་རིག་འཛིན་རྣམས་ཀྱི་སར་རྒྱ་ཆེར་སྤྱོད་པར་གྱུར་ཅིང་།",
    "ཤཱཀྱ་སེང་གེས་གསུངས་པའི་རྒྱུད།",
    "ཅེས་གསུངས་པ་བཞིན་འོ་སྐོལ་གྱི་སྟོན་པ་དེ་བཞིན་གཤེགས་པས་ཀྱང་སླར་ཡང་ཟློས་ཏེ་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་ལྟར་གསུངས་པའི་རྒྱུད་རྣམས་མི་ནུབ་པར་བྱ་བའི་ཆེད་དུ་རྡོ་བློ་བཟང་བསྟན་འཛིན་གྱི་དཔྱད་རྩོམ་ཐོར་བུ།",
    "དེ་ཡང་སྟོན་པས་གསུངས་པའི་སྒྲོལ་མའི་རྒྱུད་ནི།",
    "ངོ་བོ་ཉིད་མེད་པར་སྨྲ་བའི་བདག་ཉིད་ཆེན་པོ་བརྒྱད།",
    "དེ་དག་དང་དུས་མཚུངས་པར་བྱ་སྤྱོད་རྣལ་འབྱོར་གྱི་རྒྱུད་དང་།",
    "ཧེ་རུ་ཀ་བསྐྱེད་པ་ཞེས་བྱ་བའི་རྒྱུད་སོགས་སྤྱན་དྲངས་ནས་ཡུལ་ཏི་པུ་ར་བྱ་བར་ནགས་གསེབ་ཞིག་ཏུ་གཙུག་ལག་ཁང་བྱས་ཏེ།",
    "སློབ་དཔོན་དེ་གཉིས་དང་བྲམ་ཟེ་ས་ར་ཧ་དུས་མཉམ་པ་ཙམ་ཡིན་པར་གསུངས།",
    "དེས་ཨརྱ་དེཝ་ལ་གསུངས།",
    "རྩོད་པས་མུ་ཏིག་ཙཀྲ་ཝརྨ་ཕམ་པར་མཛད།",
    "དེས་ཁ་ཆེ་རྡརྨ་བྷ་དྲ་པཱ་ལ་ལ་གནང་།",
    "སྐྱེ་བ་བདུན་དུ་སྒྲོལ་མ་གྲུབ་པར་གྲགས།",
    "མཚུངས་ཙམ་ཡིན་པར་གསུངས།",
    "དེས་དྷ་ན་མེ་ཏྲ་ལ་གནང་།",
    "དེས་ཏ་ཐཱ་ག་ཏ་མེ་ཏྲ་ལ་གནང་།",
    "འདི་ནི་སློབ་དཔོན་ལཱ་ལཱི་ཏ་བཛྲ་དང་དུས་མཚུངས་པར་འདོད།",
    "གཞན་ཡང་གྲུབ་ཐོབ་འགས་ཁྱེར་བའི་རྒྱུད་ཀྱི་དུམ་བུ་ཆུང་བ་དུ་མ་གསེར་དངུལ་སོགས་ཀྱི་སྒྲོམ་བུར་བཅུག་སྟེ་བསིལ་བའི་ཚལ་དུ་སྦས་པར་མཛད།",
    "འདུས་པ་སོགས་བཀག་འགོག་མ་མཛད་པར་རྒྱ་ཆེར་དར་ཀྱང་སྒྲོལ་མའི་རྒྱུད་ཀྱི་འཆད་ཉན་གྱི་རྒྱུན་ཅུང་ཟད་ཆད་པར་བཤད།",
    "ཏིལློ་པ་གྲུབ་པ་མ་བརྙེས་ཙམ་ན་ཤར་ཕྱོགས་ཀྱི་གཙུག་ལག་ཁང་ཞིག་ཏུ་བཞུགས་པའི་ཚེ།",
    "ལས་ཚོགས་མཐའ་ཡས་པ་བཞུགས་ཡོད་དོ།",
    "ཇོ་བོ་ཆེན་པོ་ཡང་སྒྲོལ་མས་ལུང་བསྟན་པ་བཞིན་བོད་ཡུལ་དུ་ཕེབས་ཤིང་།",
    "དེ་དག་ལ་དངོས་དང་བརྒྱུད་པ་ཅི་རིགས་པར་འཕགས་མས་སྩལ་བའི་ལས་ཚོགས་དང་སྒྲུབ་སྐོར་བསམ་གྱིས་མི་ཁྱབ་པ་བཞུགས།",
    "དེ་མིན་འཕགས་པ་ཐུགས་རྗེ་ཆེན་པོས་བྱང་སེམས་བློ་གྲོས་རིན་ཆེན་ལ་གནང་བ་གྲུབ་ཆེན་མེཏྲ་ཛོ་ཀི་ནས་ཁྲོ་ཕུ་ལོ་ཙཱ་བ་སྣུབས་བྱམས་པ་དཔལ་རག་རྡོ་བློ་བཟང་བསྟན་འཛིན་གྱི་དཔྱད་རྩོམ་ཐོར་བུ།",
    "གཞན་ཡང་སྒྲོལ་དཀར་འོད་ཟེར་དྲུག་སྦྲག་བཀའ་བབས་བརྒྱད་སོགས་སྒྲོལ་མ་ལ་བརྟེན་པའི་མན་ངག་མཐའ་ཡས་པ་བཞུགས་ཡོད་དོ།",
    "སྒྲོལ་མའི་རྒྱུད་ཀྱི་བཞུགས་བྱང་སྔར་ཅུང་ཟད་སྨོས་པ་ལྟར་ལ།",
    "ཐམས་ཅད་མཁྱེན་པའི་བཤེས་གཉེན་གྱི་སྒྲོལ་མའི་སྒྲུབ་ཐབས།",
    "གུར་ལས་གསུངས་པའི་སྒྲོལ་མའི་སྒྲུབ་ཐབས།",
    "རྟག་གཉིས་ལས་གསུངས་པའི་ཀུ་རུ་ཀུལླེའི་རྟོག་པ།",
    "ཞེས་འབྱུང་ཞིང་དོན་ལ་ཁྱད་པར་མེད་དོ།",
    "ཞེས་ལོ་ཙཱ་བས་བཀས་བཅད་དང་མཐུན་པར་ལེགས་སྦྱར་ལས་བོད་སྐད་དུ་བསྒྱུར་བའི་ཐོག་མར་འདོད་པའི་ལྷ་ལ་ཕྱག་མཛད་པ་ཡིན་ནོ།",
    "རང་དོན་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དང་ལྡན་པའི་འཕགས་མ་དེ་ཉིད་ནི་གང་ཡིན་ཅེ་ན།",
    "བཟླས་པ་བྱས།",
    "རྣམ་པར་བྱེ་ཞིང་འཕྲོ་བའི་འོད་ཟེར་རབ་ཏུ་འབར་བའི་སྐུ་ཅན།",
    "འགྲོ་བ་རྣམས་ཀྱང་སྲིད་ཞིའི་བདེ་བ་ལ་མ་ཆགས་པར་ཉིད་ཀྱིས་བསླབ་པའི་སྤྱོད་པ་དེ་དག་ལ་སློབ་ཅིང་སྦྱོར་བར་མཛད་པའོ།",
    "འགྲོ་ཀུན་སྲིད་པའི་བདེ་ལ་མ་ཆགས་པར།",
