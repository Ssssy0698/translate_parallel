    "འཇིག་རྟེན་ལས་འདས་པའི་ཕུང་པོ་ལྔའི་རྣམ་པར་དག་པའོ།",
    "གཙཱ་བརྡུངས་པའི་སྒྲས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲའི་རང་བཞིན་དུ་བརྗོད་པར་འགྱུར་རོ།",
    "དཀྱིལ་འཁོར་ལ་ཤིན་ཏུ་གུས་པར་འགྱུར་རོ།",
    "དམར་པོ་ནི་ཐམས་ཅད་ཡོད་པར་སྨྲ་བའོ།",
    "ཐིའུ་ནི་ཤུ་ཤུར་སྟེ་ཁ་དོག་དམར་པོ་ཉིད་དོ་ཞེས་ཤིན་ཏུ་རྒྱས་པར་གསུངས་སོ།",
    "འཁར་གསིལ་གྱི་མཚོན་དོན་སོགས་ཇོ་བོ་རྗེས་གསུངས་པ་ནི།",
    "མ་རིག་འདུ་བྱེད་རྣམ་པར་ཤེས།",
    "གོང་གསལ་གྱི་བརྡ་རྣམས་མཚོན་བྱེད་ཡིན་པར་གསུངས་པ་དང་།",
    "དེ་ཕྱིས་ཀྱི་མཚོན་ཆ་རྣམས་ལ་ངེས་པ་མེད་པར་ཉག་བླ་པདྨ་བདུད་འདུལ་གྱིས་མཛད་པའི་མེ་མདའ་ཉེས་དམིགས་ལས་གསུངས་པ་བཞིན་ལ།",
    "ཏིང་ཏིང་ཤགས་དང་།",
    "ཐབས་གང་ལ་གང་འདུལ་གྱི་དགོས་པ་ལ་བརྟེན་ནས་གསུངས་པ་ལས་གང་བྱུང་སྦྱར་དུ་རུང་བ་མ་ཡིན་ཏེ།",
    "ཕྱག་མཚན་ནོར་བ་ནི་ཤིན་ཏུ་ཉེས་པ་ཆེན་པོ་གསུངས་ཏེ།",
    "རི་བོང་ཞིག་གླང་ཆེན་བཅས་གནས་པ་ཐམས་ཅད་ཀྱང་ཕན་ཚུན་འཚེ་བ་མེད་པར།",
    "མ་རྨོས་པའི་ལོ་ཏོག་རང་བྱུང་ཡན་ལག་བརྒྱུད་ལྡན་ལ་སོགས་པར་གང་དགར་ལོངས་སྤྱོད་ཅིང་མཛའ་བར་གནས་པར།",
    "དེར་སྐྱེས་པའི་ཤིང་ནྱ་གྲོ་དྷའི་སྡོང་པོ་ཆེ་བ་ཞིག་ལ་ཚད་བྱས་པས།",
    "ང་གཞོན་དུས་སུ་ཤིང་སྡོང་འདི་ངའི་ལུས་དང་མཉམ་པར་དྲན་ཟེར།",
    "ཐམས་ཅད་ཀྱང་ཇི་ལྟར་བསྟན་པ་བཞིན་བསྒྲུབས་ཤིང་ཡིན་གཅུགས་པར་གནས་སོ།",
    "དབེན་ཞིང་ཉམས་དགའ་བ་སྤྲུལ་པའི་བཟོ་བོས་བྱས་པ་བས་ཀྱང་ཆེས་མཛེས་པའི་ཡུལ་དེའི་དབུས་སུ།",
    "གཡོན་དུ་མི་ལོ་སྟོང་ལས་སྨིན་པའི་ལྷའི་ཁམ་བུ་བསྣམས་ཏེ་སྦྱིན་པའི་ཚུལ་དུ་བཞུགས་པའོ།",
    "ཡན་ལག་བརྒྱད་ལྡན་ཚེའི་སྒྲུབ་ཆུ་རྒྱུན་མི་ཆད་པར་སྐྱེ་དགུ་ཚེ་སྲོག་འཚོ་བའི་གཉེན་དུ་བབ་པའོ།",
    "བཞེད་དོན་འགྲུབ་པར་ཐེ་ཚོམ་མེད།",
    "དྲག་པོའི་ལས་འགྲུབ་པར་བྱེད་དོ་ཞེས་དབྱིབས་ཀྱི་མཚན་མ་བརྟག་པ་དང་།",
    "རྟོགས་ལྡན་སོགས་མ་གཏོགས་སྐྱེ་བོ་ཕལ་པས་འཆང་དུ་རུང་བ་མ་ཡིན་པའང་ཤེས་པར་བྱའོ།",
    "ནོར་དང་ལོངས་སྤྱོད་ལ་གནོད་པ་ཡིན་པས་བཅང་དུ་མི་རུང་བར་གསུངས་སོ།",
    "ཀ་ལིའི་ལྟག་འགོ་ནས་དཔྲལ་བའི་བར་སྲུབས་མ་ཆད་པར་ཡོད་པ་སྟེ།",
    "དེ་ནི་རྣལ་ཐོད་ཡིན་པར་ངེས་ཤིང་ཉམས་གྲིབ་ཅན་གྱི་རྫས་ཡིན་པས།",
    "དེ་ལྟར་ཐོད་པ་བཟང་ངན་གྱི་བརྟག་ཐབས་ལེགས་པར་ཤེས་ནས།",
    "མཆོག་ཏུ་བཟང་བའི་ཀ་པཱ་ལ་དེ་ཟླ་བ་ཡར་ངོའི་ཚེས་བརྒྱད་ལ་སོགས་གཟའ་སྐར་སྦྱོར་བ་ཕུན་སུམ་ཚོགས་པར་གཞུང་ནས་ཇི་ལྟར་གསུངས་པ་བཞིན་མཆོད་ན།",
    "རྫས་ལ་བརྟེན་ནས་བཀྲ་ཤིས་པར་བྱུང་ཚུལ་ལ་འདི་ལྟར་སྣང་སྟེ།",
    "མྱ་ངན་འདས་པར་གཤེགས་པར་སྟོན།",
    "འཛམ་གླིང་ཚེ་ལོ་བརྒྱ་པར་ཡུལ་དབུས་སུ།",
    "ཤཱཀྱ་རྣམས་ཀྱི་ལྷ་གནོད་སྦྱིན་ཤཱཀྱ་འཕེལ་སོགས་འཇིག་རྟེན་སྐྱོང་བ་ཐམས་ཅད་ཀྱིས་ཞབས་ལ་ཕྱག་བྱས་པས་ཡབ་ཀྱིས་མཚན་གསུམ་པ་ལྷའི་ཡང་ལྷ་ཞེས་བཏགས།",
    "འདེགས་མཆོངས་ལ་སོགས་པ་ལུགས་སྲོལ་ཤིན་ཏུ་མང་པོའི་སྒྱུ་རྩལ་དང་བཟོའི་གནས་ཡོད་དོ་ཅོག་ལ་ཤིན་ཏུ་མཁས་པས་སུས་ཀྱང་འགྲན་ཟླ་མེད་པར་གྱུར་ཏེ།",
    "ངེས་འབྱུང་རབ་ཏུ་བྱུང་ནས་ངུར་སྒྲིག་བཞེས།",
    "དེ་ནི་ཞག་བདུན་ལ་རབ་ཏུ་མ་བྱུང་ན་འཁོར་ལོས་བསྒྱུར་བའི་རྒྱལ་པོར་འགྱུར་རོ་ཞེས་མཚན་མཁན་རྣམས་ཀྱིས་ལུང་བསྟན་པ་ཐོས་ནས་ཤཱཀྱ་རྣམས་ཀྱིས་སྟོབས་ཅི་ཡོད་པས་མེལ་ཚེ་བྱས་ཏེ་བསྲུངས་པ་ན།",
    "ལྷ་ཡིས་ཕུལ་བའི་བཟའ་དུར་སྨྲིག་བཞེས།",
    "ཙཱ་ཤའི་ཁྱུ་རྣམས་སྙན་པར་སྒྲོགས་ཤིང་མཁའ་ལ་གཡས་སུ་བསྐོར།",
    "དྲན་པ་མངོན་དུ་བཞག་ནས་བཞུགས་སོ།",
    "བདུད་རིགས་ཀྱི་ལྷའི་བུ་དགེ་རྩ་ཅན་རྣམ་པར་སྨིན་པར་མཛད་པའི་སླད་དུ།",
    "ཅེས་ནམ་གྱི་གུང་ལ་བསམ་གཏན་བཞི་པོར་རིམ་གྱིས་སྙོམས་པར་ཞུགས།",
    "ལམ་གྱི་རྒྱུན་ནི་ཆད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཆེད་དུ་བརྗོད་པར་མཛད།",
    "བདུན་པ་ཚེ་ཤིང་སྒྲོལ་རྒྱུའི་དྲུང་དུ་བཞུགས་པ་ན་ལྷས་བསྐུལ་ཏེ་ཚོང་པ་ག་གོན་དང་བཟང་པོ་གཉིས་ཀྱིས་བསོད་སྙོམས་ཀྱི་ཐོག་མར་ཕུལ་བ་ལ་རྒྱལ་ཆེན་བཞིས་རྡོའི་ལྷུང་བཟེད་བཞི་ཕུལ་བ་གཅིག་ཏུ་བྱིན་གྱིས་བརླབས་པར་བླངས་ནས་གསོལ་ཏེ།",
    "ཟབ་ཞི་སྤྲོས་བྲལ་འོད་གསལ་འདུས་མ་བྱས།",
    "མི་སྨྲ་ནགས་འདབ་ཉིད་དུ་གནས་པར་བྱ།",
    "ཞེས་གསུངས་ཏེ་ཐུགས་ལས་ཆུང་ངུར་བཞུགས་པ་ན།",
    "དེ་ནས་རིམ་པར་རི་བོ་ག་ཡ་དང་སྤོས་ངད་ལྡང་།",
    "མཉན་དུ་ཡོད་པར་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་ཆོ་འཕྲུལ་ཆེན་པོ་བསྟན།",
    "སྐུ་གདུང་འཇིག་རྟེན་ཀུན་ཏུ་རྒྱས་པར་མཛད།",
    "ཐ་མའི་གཟིམས་ཁྲི་ལ་སེང་གེའི་ཉལ་སྟབས་ཀྱིས་བཞུགས་ཏེ་སྣང་བའི་འདུ་ཤེས་དང་།",
    "༡ཆོ་འཕྲུལ་ཆེན་པོའི་ཚེས་གཅིག་ཉིན་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་སྦྱིན་བདག་བྱས།",
    "ངེས་པར་ལེགས་པའི་འབྲས་བུ་ཐོབ་པར་མཛད་པའི་ཆོ་འཕྲུལ་དང་པོ་བསྟན་ཏོ།",
    "རྣམ་པར་གྲོལ་བའི་འབྲས་བུ་ཐོབ་པར་མཛད་པའི་ཆོ་འཕྲུལ་བསྟན།",
    "རྒྱལ་པོ་ཤུན་རྩི་ད་ལས་སྦྱིན་བདག་བྱས།",
    "༤ ཚེས་བཞི་ཉིན་རྒྱལ་པོ་ཨིནྡྲ་ཝར་མས་སྦྱིན་བདག་བྱས།",
    "༥ཚེས་ལྔ་ཉིན་རྒྱལ་པོ་ཚངས་བྱིན་གྱིས་སྦྱིན་བདག་བྱས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞལ་སྒོ་ནས་གསེར་གྱི་ཁ་དོག་ལྟ་བུའི་འོད་ཟེར་བཀྱེས་ནས་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཀུན་ཏུ་སྣང་བ་བྱས་ཏེ།",
    "༦ཚེས་དྲུག་ཉིན་ལི་ཙ་བྱི་རྣམས་ཀྱིས་སྦྱིན་བདག་བྱས།",
    "༧ཚེས་བདུན་ཉིན་ཤཱཀྱའི་རིགས་རྣམས་ཀྱིས་སྦྱིན་བདག་བྱས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་འཁོར་དེ་དག་ཐམས་ཅད་དེའི་ཉིན་པར་འཁོར་ལོས་བསྒྱུར་བའི་རྒྱལ་པོར་བསྒྱུར་ཅིང་།",
    "རྒྱལ་ཕྲན་དང་བློན་པོ་རྣམས་ཀྱིས་བསྟི་སྟངས་བྱེད་པར་མཐོང་སྟེ།",
    "༩ཚེས་དགུ་ཉིན་ཚངས་པའི་རྒྱལ་པོས་སྦྱིན་བདག་བྱས།",
    "གསུང་ཡང་ཐོས་པར་གྱུར་ནས།",
    "༡ཚེས་བཅུ་ཉིན་རྒྱལ་པོ་ཆེན་པོ་བཞིས་སྦྱིན་བདག་བྱས།",
    "༡༡ཚེས་བཅུ་གཅིག་ཉིན་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་སྦྱིན་བདག་བྱས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སེང་གེའི་ཁྲི་ལ་བཞུགས་བཞིན་དུ་སྐུ་མི་སྣང་བར་མཛད་ནས་འོད་ཟེར་ཆེན་པོ་བཀྱེས་ཏེ།",
    "༡༢ཚེས་བཅུ་གཉིས་ཉིན་ཁྱིམ་བདག་ཙི་ཏས་སྦྱིན་བདག་བྱས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བྱམས་པའི་ཏིང་ངེ་འཛིན་ལ་བཞུགས་ཤིང་གསེར་གྱི་འོད་ལྟ་བུའི་འོད་ཟེར་བཀྱེས་ཏེ།",
    "༡༣ཚེས་བཅུ་གསུམ་ཉིན་རྒྱལ་པོ་ཤིན་རྩི་ད་ལས་སྦྱིན་བདག་བྱས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སེང་གེའི་ཁྲི་ལ་བཞུགས་ཏེ།",
    "༡༤ཚེས་བཅུ་བཞི་ཉིན་རྒྱལ་པོ་ཨུ་ཏྲ་ཡ་ནས་སྦྱིན་བདག་བྱས།",
    "འཁོར་མང་པོ་ཐམས་ཅད་ལ་ཆོག་པར་གྱུར་ཏེ།",
    "གཡོན་མཉམ་བཞག་ཞབས་སྐྱིལ་ཀྲུང་དུ་བཞུགས་པ།",
    "ཡིད་ལ་བྱས་པ་དང་།",
    "༡པྲ་ཡརྐུ་ཡི་གླིང་ཕྲན་ན་བཞུགས་པའི་ཉན་ཐོས་ཆེན་པོ་སྒྲ་གཅན་འཛིན།",
    "༢བྱ་རྒོད་ཕུང་པོའི་རི་བོ་ན་བཞུགས་པའི་ཉན་ཐོས་ཆེན་པོ་ལམ་ཕྲན་བསྟན་ནི་ཕྱག་གཉིས་མཉམ་པར་བཞག་པར་དགྲ་བཅོམ་སྟོང་དང་དྲུག་བརྒྱས་བསྐོར་བ།",
    "༣ཤར་གྱི་ལུས་འཕགས་པོ་ན་བཞུགས་པའི་གནས་བརྟན་ཆེན་པོ་བྷ་ར་དྷ་ཛ་བསོད་སྙོམས་ལེན་ནི།",
    "༤ སུམ་ཅུ་རྩ་གསུམ་གྱི་ལྷ་གནས་ན་བཞུགས་པའི་ཉན་ཐོས་ཆེན་པོ་ལམ་ཆེན་བསྟན་ནི།",
    "༦རི་ཡི་རྒྱལ་པོ་བྷི་ཏུ་ན་བཞུགས་པའི་གནས་བརྟན་ཆེན་པོ་སྦེད་བྱེད་ནི།",
    "༧གངས་ཀྱི་རི་བོ་ཆེན་པོ་ན་བཞུགས་པའི་གནས་བརྟན་ཆེན་པོ་མི་ཕྱེད་པ་ནི།",
    "༨གངས་རི་ཆེན་པོ་ཏི་སེ་ན་བཞུགས་པའི་གནས་བརྟན་ཆེན་པོ་ཡན་ལག་འབྱུང་ནི།",
    "༩དྲང་སྲོང་རི་ངོགས་ཀྱི་ཤེལ་ནགས་ན་བཞུགས་པའི་གནས་བརྟན་ཆེན་པོ་མ་ཕམ་པ་ནི།",
    "ཕྱག་གཉིས་མཉམ་པར་བཞག་ཅིང་།",
    "༡ལོ་མ་བདུན་པའི་རི་ཕུག་བཞུགས་པའི་གནས་བརྟན་ཆེན་པོ་ནགས་ན་གནས་ནི།",
    "༡༡ཟངས་ཀྱི་གླིང་ན་བཞུགས་པའི།",
    "༡༤ ཁ་ཆེའི་ཡུལ་གྱི་ས་མཚམས་ན་བཞུགས་པའི་གནས་བརྟན་ཆེན་པོ་གསེར་བེའུ་ནི།",
    "༡༥ནུབ་བ་གླང་སྤྱོད་ན་བཞུགས་པའི་གནས་བརྟན་ཆེན་པོ་བྷ་ར་དྷ་ཛ་གསེར་ཅན་ནི།",
    "འཁོར་གནས་བརྟན་དག་ལས་ཁྱད་པར་ཅན་ནོ།",
    "ཐུགས་མཉམ་པར་མ་བཞག་པ་མི་མངའ་བའི་བརྡར་གཡོན་མཉམ་བཞག་མཛད་པ།",
    "གཡོན་པོ་ཏིས་མཚན་པའི་ཨུཏྤལ་གྱི་ཡུ་བ་འཛིན་ཅིང་ཞབས་སེམས་སྐྱིལ་དུ་བཞུགས་པ།",
    "༥འཛམ་གླིང་མཛེས་པར་བྱེད་པའི་རྒྱན་དྲུག་མཆོག་གཉིས།",
    "ཐབས་ཤེས་གཉིས་ལས་ཤེས་རབ་ཀྱི་ཆར་གཙོ་བོར་གནང་སྟེ།",
    "ཞི་དུལ་གྱི་རྣམ་པ་དང་བཅས་འབོལ་གདན་ལ་བཞུགས་པ།",
    "སློབ་དཔོན་དེ་ཉིད་ལྷོ་ཕྱོགས་དཔལ་གྱི་རི་ནས་ཕེབས་ཏེ་རྩོད་པ་དང་རྫུ་འཕྲུལ་གཉིས་ཀས་མུ་སྟེགས་ཀྱི་པཎྜི་ཏ་ཕམ་པར་མཛད་པ་དང་།",
    "གཡོན་གཏེར་གྱི་སྒྲོམ་བུ་དང་བཅས་ཏེ་དར་འབོལ་གྱི་གདན་ལ་བཞུགས་པའོ།",
    "གསུམ་པར་མཆོད་བརྗོད་བསུབས་མཁན་དང་རྩོད་པར་འདོད་ནས་གཟུགས་སྟོན་ཞེས་བྲིས་པ་དེ་མཐོང་སྟེ་བསྡད་ནས་རྩོད་པས་སློབ་དཔོན་གྱིས་ཚར་བཅད་དེ་མི་སྨྲ་བའི་བརྟུལ་ཞུགས་ལ་བཀོད་པས་ཁོ་འཁྲུག་སྟེ་ཁ་ནས་མེ་བཏང་བས་སློབ་དཔོན་གྱི་ཡོ་བྱད་ཚིག་སློབ་དཔོན་ཐུགས་སྐྱོ་སྟེ་སེམས་བསྐྱེད་གཏོང་བར་བརྩམས་པ་དང་།",
    "འཁར་གསིལ་དང་ལྷུང་བཟེད་བསྣམས་ནས་བཞུགས་པ་བཅས་ཏེ།",
    "ཞབས་ཕྱེད་སྐྱིལ་གྱིས་བཞུགས་ཤིང་སྐུ་ཟིལ་ཅན་ནོ།",
    "རྒྱལ་པོའི་འབྱོར་བ་ཆེན་པོས་ཁྱད་པར་དུ་བརྒྱན་པའི་སྟེང་དུ།",
    "བློན་པོ་ལ་སོགས་པ་འཁོར་ཚོགས་མང་པོའི་དབུས་ན་རྒྱལ་པོའི་གཟི་བརྗིད་དང་བཅས་པར་བཞུགས་པའོ།",
    "ཞབས་རོལ་པའི་སྟབས་ཀྱིས་བཞུགས་ཤིང་།",
    "ཁ་རླངས་ཀྱི་དུག་ཅན་བདུན་གྱིས་དབུའི་སྟེང་དུ་གདེངས་ཀར་བྱས་ཤིང་།",
    "མཱི་ན་སྟེ་ཉ་ཆེན་པོའི་ཁོག་པ་གཤགས་པའི་དབུས་ནས་ཐོན་པའི་ཚུལ་གྱིས་ཞབས་གཉིས་གར་སྟབས་ཀྱིས་བཞེངས་པའོ།",
    "ཞབས་གཉིས་ཅི་བདེར་བཞུགས་པའོ།",
    "ཌ་མ་རུ་བདུན་འཁྲོལ་བ་མེད་པར་སྒྲ་གྲགས་བཞིན་པ།",
    "ཤིང་ལྗོན་པ་ལ་སྐུ་རྒྱབ་བརྟེན་པའི་ཕྱེད་སྙེས་ཀྱིས་བཞུགས་ཤིང་ཕྱག་ས་གནོན་སོགས་ཅི་བདེར་སྤྱོད་པའོ།",
    "ཞབས་གར་སྟབས་སམ་བརྐྱངས་བསྐུམ་གྱི་ཚུལ་དུ་བཞུགས་ཤིང་།",
    "གཉུག་མའི་ཡེ་ཤེས་རང་ལ་རང་ཆས་སུ་བཞུགས་པ་ངོ་སྤྲོད་པའི་བརྡ་མཚོན་པ་བཅས་སོ།",
    "ཕྱག་མཉམ་པར་བཞག་པའི་ཕྱག་རྒྱ།",
    "གཡོན་ཕྱེད་སྐྱིལ་གྱིས་བཞུགས་པའོ།",
    "ཕྱེད་སྐྱིལ་ལམ་རྒྱལ་པོ་རོལ་པའི་སྟབས་ཀྱིས་བཞུགས་པའོ།",
    "མདུན་ན་སློབ་དཔོན་ཀླུ་སྒྲུབ་བཞུགས་པ་ལ་གུས་པ་དང་བཅས་བསྙེན་པའི་ཚུལ་ཅན་ནོ།",
    "གཞལ་ཡས་ཁང་ཡིད་དུ་མཆིས་པར་མཆོད་རྫས་སྣ་ཚོགས་ཀྱིས་བརྒྱན་པའི་དབུས་སུ།",
    "ཞབས་ཡ་གཅིག་རྒྱབ་ནས་དཔུང་པར་བཀལ་ཞིང་།",
    "པོ་ཏི་ཕྱག་ན་བསྣམས་ཤིང་ཞབས་སེམས་སྐྱིལ་གྱིས་བཞུགས་པའོ།",
    "ཕྱག་རྒྱ་ལྔ་ལྡན་ཤིན་ཏུ་མཛེས་མ་ལ་མཉམ་པར་སྦྱོར་བའི་བདེ་བས་དགྱེས་པ།",
    "ཡང་ན་ཕྱག་ཐོད་འཛིན་པར་བྱས་ཀྱང་རུང་བར་བཤད།",
    "ཕྱག་ཏུ་ཏིང་ཤག་བསྣམས་ཏེ་བརྡུང་བའི་ཚུལ་གྱིས་གཏོར་མ་སྣ་ཚོགས་གཏོང་བའི་རྣམ་པ་ཅན།",
    "ཤིང་ལྗོན་པའི་དྲུང་ན་བཞུགས་ཤིང་མདུན་དུ་མེ་བཏང་སྟེ་སྣུམ་ཁུར་བཙོས་པ་ལ།",
    "ཞབས་གཉིས་གར་སྟབས་བརྐྱང་བསྐུམ་གྱི་ཚུལ་དུ་བཞུགས་པའོ།",
    "ཏིང་ངེ་འཛིན་ལ་བཞུགས་པ།",
    "གཡོན་ཕུབ་བཟུང་སྟེ་རོལ་སྟབས་ཀྱིས་བཞུགས་པའོ།",
    "ཞབས་ལ་ལྷམ་ཡུ་བཅད་གཡེར་ཁ་སོགས་རྒྱུན་མང་པོ་བཏགས་ཏེ་སིལ་ཁྲོལ་གྱི་སྒྲ་དང་བཅས་རྒྱག་པའི་ཚུལ་གྱིས་བདེ་ཆེན་གྱི་སར་རིངས་པར་འགྲོ་བ་ལ་བརྩོན་དགོས་པའི་བརྡ་སྟོན་པའོ།",
    "ཕྱག་མཉམ་བཞག་དང་ས་གནོན་གྱི་ཚུལ་གྱིས་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞག་སྟེ་རྩྭའི་སྤྱིལ་བུར་གནས་པའོ།",
    "ཞབས་བརྐྱང་བསྐུམ་རོལ་སྟོབས་ཀྱིས་བཞུགས་པའོ།",
    "ཞབས་ཕྱེད་སྐྱིལ་གྱིས་བཞུགས་པ།",
    "བྲམ་ཟེའི་ཆ་བྱད་ཚང་སྐུད་དཀར་པོ་ཕྲག་པར་ཐོགས་པ།",
    "ཞབས་གཉིས་བརྐྱང་བསྐུམ་རོལ་སྟབས་ཀྱིས་ཡེ་ཤེས་ཀྱི་མེ་དཔུང་འབར་བའི་དབུས་ན་བཞུགས་པ།",
    "འཇིགས་པར་བྱེད་པའི་ཧེ་རུ་ཀ་དཔལ་ཆེན་དྲག་པོའི་འཁོར་ལོས་བསྒྱུར་བའི་ཚུལ་ཅན་དུ་བཞུགས་པའོ།",
    "དེ་ལྟར་མ་བྱུང་ན་སྔོན་གྱི་བྲིས་རྒྱུན་ཚད་ལྡན་ལ་བརྟེན་པར་བྱའོ།",
    "རྒྱས་པ་ཤེས་པར་འདོད་ན་གོང་གསལ་གྱི་གཞུང་དག་ལས་འབྱུང་ངོ།",
    "མ་ལུས་དགོངས་པའི་དོན་ཐམས་ཅད་འགྲུབ་པའི་བརྡ་དབུ་སྐྲ་ཁམ་ནག་ལྕང་ལོ་འཁྱིལ་བ་སྐྱེ་བོ་ཀུན་མཐོང་བ་ཙམ་གྱིས་ཡིད་དགའ་ཞིང་དད་པར་གྱུར་པའོ།",
    "བསྟན་གཉིས་ཟུང་འཇུག་གཏེར་གྱིས་སྐྱོང་བའི་བརྡ་གཡི་དཀར་པགས་པས་ཁ་འགྲིལ་བྱས་པ།",
    "དེ་སྟེང་འཇིག་རྟེན་དུར་ཁྲོད་གླིང་དགུར་མཁྱེན་པའི་བརྡ་ཐོད་པ་དགུ་བརྩེགས་སམ་སྐུ་གསུམ་མཚོན་པའི་ཐོད་པ་སྐམ་རློན་རྙིད་གསུམ།",
    "དེ་ལ་སྟོང་གཟུགས་ཡེ་ཤེས་ལྔ་ལྡན་སྦྱོར་བའི་བརྡ་དར་སྣ་ལྔའི་མགུལ་ཆིངས་བྱས་པ།",
    "འགྱོད་བཤགས་ཀྱི་ཚུལ་དུ་རྒྱལ་པོའི་ཟ་འོག་བེར་མཛོད་ཀྱི་སྒོ་ཕྱེ་ནས་རྒྱལ་པོའི་ཆས་སློབ་དཔོན་གྱི་སྐུ་ལ་གསོལ་བས་པད་འབྱུང་ཟ་ཧོར་གྱི་ཆས་ཅན་བྱུང་བ་ཤེས་གལ་ཆེའོ།",
    "ཐོག་ཕབ་པས་བྲག་ཚལ་བ་གཏོར་བ་སོགས་ཀྱིས་རྒྱལ་པོ་སྐྲག་སྟེ་གོས་དཀར་ལྕང་ལོ་ཅན་ལ་གནོད་མི་བྱ་བའི་ཁས་བླངས་པར་བྱས་པ་སོགས་གྲུབ་པའི་མཚན་མ་མངོན་སུམ་བསྟན།",
    "བྲག་ལ་ཕུར་པ་འདེབས་པའི་ཚུལ་དུ་བཞུགས་པའོ།",
    "ཚེའི་རིག་འཛིན་བརྙེས་པས་ཡུན་དུ་བཞུགས་སྐད་དོ།",
    "མཐར་ཕྱག་རྒྱ་ཆེན་པོའི་རིག་འཛིན་བརྙེས་ནས་ལུས་མ་སྤངས་པར་མཁའ་སྤྱོད་དུ་གཤེགས།",
    "ལོ་ཙཱ་མཁས་པར་མཁྱེན་ཏེ་རྨ་གཉགས་གཉིས་སུ་གྲགས།",
    "རྒྱལ་བ་མཆོག་དབྱངས་དང་ལྷན་ཅིག་ཡེར་པར་སྒྲུབ་པ་མཛད་སྐབས་བྱ་རོག་ཞིག་ཏུ་སྤྲུལ་ནས་གྲོགས་པོའི་རྩར་བྱོན་པས།",
    "བྲག་ལས་སྒྲུབ་ཆུ་འདོན་པའི་ཚུལ་དུ་བཞུགས་པའོ།",
    "སྣ་ཚོགས་ཀྱིས་མཛེས་པར་བརྒྱན་ཅིང་ལུས་ཕྲ་མ་མཛེས་པའི་མཚན་མ་དང་ལྡན་པ།",
    "དྲེགས་ཚོགས་ལྷ་སྲིན་ཐམས་ཅད་བྲན་དུ་བཀོལ།",
    "ཕྱག་སྡིགས་འཛུབ་ཀྱིས་དྲེགས་པའི་ལྷ་སྲིན་མང་པོ་བྲན་དུ་འགུགས་པའི་ཚུལ་དུ་བཞུགས་པའོ།",
    "སྒྲ་སྐད་ལོ་ཙཱ་ལ་མཁས་པའི་ཕུལ་དུ་ཕྱིན་པས་བསིལ་ལྡན་གྱི་ལྗོངས་འདི་ན་སྔ་ཕྱིར་བྱོན་པའི་མཁས་པ་སུས་ཀྱང་འགྲན་མི་བཟོད་པར་བཤད།",
    "ལོ་ཙཱ་མཁྱེན།",
    "མདུན་དུ་མི་འགའ་ཞིག་ལ་མངོན་ཤེས་འཆད་པའི་ཚུལ་དུ་བཞུགས་པའོ།",
    "སློབ་དཔོན་པདྨའི་དྲུང་ནས་ལོ་ཙཱ་ལ་མཁས་པར་སྦྱངས་ཏེ།",
    "ལོ་ཙཱ་མཁས་པར་མཁྱེན།",
    "གཤིན་ཡུལ་དུ་རྫུ་འཕྲུལ་གྱི་དམག་དྲངས་ནས་གཤིན་རྗེ་སྐྲག་པར་བྱས།",
    "གཞོན་དུས་ནས་ལོ་ཙཱ་མཁྱེན་པས་མཚན་དེ་ལྟར་གྲགས།",
    "མཁའ་ལ་བྱོན་ཏེ་བྱ་རྣམས་ཀྱང་ཟིན་པར་གྱུར་ཏོ།",
    "ལོ་ཙཱ་ཡང་མཁྱེན།",
    "སློབ་དཔོན་ལས་རབ་ཏུ་བྱུང་ཞིང་དབུ་ལ་ཞྭ་དམར་ཞིག་བཞེས་པས།",
    "ཆུ་བོ་ཆེན་པོ་ལ་འཇིགས་པ་མེད་པར་རྒྱུ་བས།",
    "མཁན་ཆེན་ཞི་བ་འཚོ་ལས་རབ་ཏུ་བྱུང་ཞིང་བསྙེན་པར་རྫོགས།",
    "ཀ་ཐོག་རྡོ་རྗེ་གདན་གྱི་མཚན་བརྒྱུད་དགུ་ཐང་ཤིང་པར་མ་སོགས་བྲིས་ཆ་བཅས་ལ་ཁུངས་བཅོལ་ནས་བྲིས་པའོ།",
