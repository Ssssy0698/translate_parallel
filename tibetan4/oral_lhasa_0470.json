    "སྦྲུལ་དཀར་པོའི་སེ་རལ་ཁར་བྱས་པ།",
    "མདུན་གཡོན་མི་གཡོ་བ་དཀར་པོ་ཆ་ལུགས་ཐམས་ཅད་སྔོན་པོ་ལྟར་ལ་རྡོ་རྗེའི་ཞགས་པའི་སྣེ་གཉིས་ཕྲག་གོང་དུ་ལྡིང་ཞིང་སྦྲུལ་ལྗང་གུའི་སྐེ་རགས་བྱས་པ།",
    "བྱང་སེམས་གཉིས་པདྨ་དང་གཞན་གདིང་བ་ལ་བཞུགས་པ།",
    "ཕྱག་ལྷག་མ་དགུ་བརྒྱ་དང་དགུ་བཅུ་རྩ་གཉིས་མཆོག་སྦྱིན་རྣམ་པར་བརྐྱང་བ།",
    "པད་ཟླ་ལ་རྡོར་སྐྱིལ་གྱིས་བཞུགས་པ།",
    "གཡོན་བསྐུམ་པད་ཟླ་ལ་བཞུགས་པ།",
    "པད་ཟླ་ལ་ཞབས་སེམས་སྐྱིལ་གྱིས་བཞུགས་ཤིང་འོད་ཀྱི་དཀྱིལ་འཁོར་འཕྲོ་བ།",
    "འོད་ཀྱི་དཀྱིལ་འཁོར་དབུས་ན་པད་ཟླའི་གདན་ལ་བཞུགས་པ།",
    "ཞབས་གཡོན་བརྐྱང་རྒྱལ་པོ་རོལ་སྟབས་ཀྱིས་བཞུགས་པ།",
    "རྟ་མཆོག་སེར་པོ་ལ་བཞུགས་པ།",
    "ལྡེམ་བག་ཅན་རྨ་བྱ་ལ་བཞུགས་པ།",
    "ཐ་མ་གཉིས་སྐྱབས་སྦྱིན་དང་བདུད་རྩིས་གང་བའི་བུམ་པ་ཐོགས་ཤིང་མཁའ་ལྡིང་ལ་བཞུགས་པ།",
    "འོག་མ་གཉིས་སྐྱབས་སྦྱིན་དང་ལྕགས་ཀྱུ་བསྣམས་ཤིང་སྦྲུལ་ལ་བཞུགས་པ།",
    "འོག་མ་གཉིས་སྐྱབས་སྦྱིན་དང་ལྕགས་སྒྲོག་འཛིན་ཅིང་ཆུ་སྲིན་ལ་བཞུགས་པ།",
    "འོག་མ་གཉིས་སྐྱབས་སྦྱིན་དང་པུསྟིས་མཚན་པའི་པདྨ་བསྣམས་ཤིང་གླང་པོ་ལ་བཞུགས་པ།",
    "གཡོན་གཉིས་འཁོར་ལོ་དང་དབྱུག་པ་ལ་བཞུགས་པ།",
    "དབུ་སྐྲ་ལི་བ་ལྟག་པར་བཅིངས་པའི་ཟུར་ཕུད་གཡོན་ངོས་སུ་འཕྱང་བ།",
    "ཞབས་གཡས་ཅུང་ཟད་བརྐྱང་ཞིང་གཡོན་བསྐུམ་པའི་རོལ་སྟབས་ཀྱིས་པད་ཟླ་ལ་བཞུགས་པ།",
    "ཞབས་རོལ་སྟབས་ཀྱིས་སྣ་ཚོགས་པད་ཟླ་ལ་བཞུགས་པའོ།",
    "པདྨ་དང་ཟླ་བ་དམར་པོ་ལ་སེམས་སྐྱིལ་གྱིས་བཞུགས་པ།",
    "སྣ་ཚོགས་པདྨའི་གདན་ལ་སེམས་སྐྱིལ་གྱིས་བཞུགས་པ།",
    "དབུ་སྐྲ་ནག་སྣུམ་ཕྱེད་ལྟག་པར་བཅིངས་ཤིང་ཕྱེད་སིལ་བུར་གྲོལ་བས་སྐུ་སྟོད་ཁྱབ་པ།",
    "འོ་མའི་རྒྱ་མཚོ་ལས་སྐྱེས་པའི་པད་དཀར་སྡོང་པོ་རབ་ཏུ་རྒྱས་པ་དང་ཟླ་བའི་གདན་ལ་བཞུགས་པ།",
    "དེའི་གཡས་ཕྱོགས་སུ་རྟོགས་པ་ལས་གསུངས་པའི་རིག་བྱེད་མ་དམར་སྐྱ་ཞལ་གཅིག་སྤྱན་གསུམ།",
    "པད་ཟླ་ལ་སེམས་སྐྱིལ་གྱིས་བཞུགས་པ།",
