    "ཞབས་རོལ་སྟབས་ཀྱིས་པད་ཉི་ལ་བཞུགས་པའོ།",
    "འདབ་མའི་བར་མཚམས་ཐམས་ཅད་རྡོ་རྗེས་གཏམས་པ་ལ་བཞུགས་ཤིང་གསེར་གྱི་ཁ་དོག་ལྟ་བུའི་འོད་ཟེར་འཕྲོ་བ།",
    "ཕྱག་གཡས་ན་གཙུག་ཏོར་བསྣམས་ཤིང་ཏིང་ངེ་འཛིན་ལ་བཞུགས་པའི་ཚུལ།",
    "ཐོག་མར་ཡོ་ག་རྩ་བའི་རྒྱུད་དེ་ཉིད་འདུས་པའི་དུམ་བུ་དང་པོ་ལས་གསུངས་པའི་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོའི་གཙོ་བསྡུས་ནི།",
    "ཕྱག་གཡས་སྣ་ཚོགས་རྡོ་རྗེ་ཐུགས་ཀར་གཏོད་ཅིང་གཡོན་དེས་ཡུ་བ་བྱས་པའི་དྲིལ་བུ་དཀུར་བརྟེན་པ།",
    "འཇམ་དཔལ་གསང་ལྡན་ཙམ་ལས་གཞན་པའི་རྣལ་འབྱོར་རྒྱུད་ཀྱི་སྒྲུབ་དཀྱིལ་རྣམས་ནི་བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པའི་བཀའ་སྲོལ་ཁོ་ན་ལས་འབྱོན་པ་ཤེས་པར་བྱའོ།",
    "སྐྱིལ་ཀྲུང་པད་ཟླ་རྨ་བྱའི་ཁྲི་ལ་བཞུགས་པ།",
    "ཞབས་སེམས་སྐྱིལ་གྱིས་སྡོང་བུ་དང་བཅས་པའི་པདྨ་ལ་བཞུགས་པའོ།",
    "རྟ་བདུན་གྱིས་དྲངས་པའི་ཤིང་རྟ་དང་སྣ་ཚོགས་པདྨ་ལ་སེམས་སྐྱིལ་གྱིས་བཞུགས་པ།",
    "འཁོར་ལོའི་ལྟེ་བར་སྣ་ཚོགས་པདྨ་ལ་སེམས་སྐྱིལ་གྱིས་བཞུགས་པ།",
    "པདྨ་ལ་སེམས་སྐྱིལ་གྱིས་བཞུགས་པ།",
    "དབུས་སུ་སེང་ཁྲི་པད་ཟླ་ལ་རྣམ་པར་སྣང་མཛད་རྡོར་དབྱིངས་ལྟར་ལ།",
    "འདིར་ཉི་མའི་རྒྱབ་ཡོལ་མ་གསུངས་པས་འོད་ཟེར་འཕྲོ་བ་བྱ།",
    "དབུས་སུ་སེང་གེའི་ཁྲི་ལ་བཅོམ་ལྡན་རྣམ་པར་མཛད་དཀར་པོ་ཞལ་བཞི་པ།",
    "སེམས་སྐྱིལ་གྱིས་པད་ཟླ་ལ་བཞུགས་པ།",
    "སེང་གེས་བཏེགས་པའི་ཁྲི་དང་པད་ཟླ་ལ་བཞུགས་པ།",
    "སེང་གེའི་ཁྲི་ལ་བཞུགས་པ།",
    "ཕྱི་མ་འདི་རྣམས་ཆུང་བར་བྲིས་ན་མཛེས་ཆ་ཐོན་པར་འོང་།",
    "གཙོ་འཁོར་དེ་དག་ཐམས་ཅད་རྡོར་སྐྱིལ་ཁོ་ནས་བཞུགས་པ།",
    "ཞབས་གཡས་བརྐྱངས་གཡོན་བསྐུམ་གྱིས་པདྨ་ཉི་ཟླའི་གདན་ལ་འཇའ་འོད་ཀྱི་ཀློང་དུ་བཞུགས་པའོ།",
    "སྙན་གྲགས་ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་དུ་ཁྱབ་པར་མཛད་པའོ།",
    "གཡོན་ཆུ་སྐྱེས་ཀྱི་པདྨ་སྔོན་པོ་བསྣམས་ཏེ་སྟོབས་བཅུའི་ཡོན་ཏན་ཐོབ་ཅིང་རྒྱས་པར་མཛད་པའོ།",
    "བརྟན་གཡོའི་དྭངས་བཅུད་བསྟིམ་ཞིང་རྒྱས་པར་མཛད་པའོ།",
    "གཡོན་སྤྱི་བླུགས་ཀྱིས་མཚན་པའི་ཨཏྤལ་གྱི་ཡུ་བ་ཐུགས་ཀར་འཛིན་པས་མཚམས་མེད་ཀྱི་ལས་ལ་སོགས་འབྲས་བུ་སྡུག་བསྔལ་ཆེན་པོ་རྩད་ནས་འཇོམས་པར་མཛད་པའོ།",
    "གཙོ་འཁོར་ཐམས་ཅད་འཇའ་སྤྲིན་གྱི་དབུས་ན་བཞུགས་ཤིང་བར་མཚམས་རྣམས་སུ།",
    "འདོད་འཇོའི་བ་སོགས་བཀོད་པའི་ཁྱད་པར་མཛེས་ཤིང་བག་དྲོ་བ་བྱའོ།",
    "རིན་འབྱུང་དུའང་རིགས་བརྒྱུད་རྗེས་གནང་ཚང་བ་དང་།",
    "༤ གཙང་རྒྱབ་འབྲོག་གནས་ཀྱི་རྡོ་རྗེ་བགེགས་གཙོ་མ།",
    "ཀ་ཤི་ཀ་བཅས་རས་ཀྱི་རིགས་བཞིར་གསུངས་ཀྱང་།",
    "དེ་ལ་ཐོག་མར་ཐང་ཀ་ཆེ་ཆུང་གང་འདོད་པའི་ཚད་དང་མཐུན་པ་དྲས་ཏེ་སྣོད་གཙང་མའི་ནང་དུ་ལེགས་པར་བཀྲུས་ནས་སྐམ་དུ་བཅུག་དེ་ལྟར་མ་གྲུབ་ན།",
    "གྲུ་ཡོ་སོག་ཀ་མེད་པར་བརྒྱངས་ནས།",
    "མདུན་ངོས་སུ་ཐེངས་གསུམ་དང་རྒྱབ་ངོས་སུ་ཐེངས་གཉིས་ཙམ་སྙོམས་པར་བྱུགས།",
    "སྐམ་དབུར་གྱིས་ངོས་འཇམ་ཞིང་འོད་དང་ལྡན་པར་བྱེད་དོ།",
    "གལ་ཏེ་མཚལ་ཐང་དང་ཐང་ནག་ཏུ་བསྒྱུར་བར་འདོད་ན་སྣག་དང་མཚལ་བཟང་པོའི་ཁ་ཆུ་བླངས་ཏེ་དམ་ཆུ་འདྲེས་ཙམ་དང་བཅས་བཟོས་ཟིན་པའི་རས་གཞི་དཀར་པོའི་སྟེང་དུ་ལན་གསུམ་ནས་བཞིའི་བར་དུ་ཆ་སྙོམ་པར་བྱུགས་ནས་གྲུབ་བོ།",
    "རས་གཞི་སྐམ་དབུར་མ་བྱས་སྔོན།",
    "མདངས་དང་བཅད་རིས་ཙམ་གྱིས་འོད་མི་ནོན་པ་ལྟར་སྣང་བས་བརྟག་པར་འཚལ་ལོ།",
    "རྣ་ལྟག་ནས་ཕྱོགས་གཉིས་ལ་གཡུའི་རྣ་རྒྱན་རྒྱལ་བློན་རྣམས་གདན་དུ་བཞུགས་སྐབས་པང་དུ་སླེབས་པ།",
    "དེ་ནས་རིམ་པར་སྲས་དམུ་བཙན་རྒྱལ་བ།",
    "ཆབ་རུ་སོགས་ཀྱི་མཐར་བོན་གྱི་མཚོན་བྱེད་ཟུར་སྐུད་སྔོན་པོ་ཞིག་ངེས་པར་དུ་འཐེན་དགོས་པ།",
    "ཁ་བཏགས་དཀར་པོས་ནི་ལྷག་བསམ་རྣམ་པར་དག་པ་མཚོན་པ་དང་།",
    "ཞི་བའི་ལས་ཐམས་ཅད་འགྲུབ་པར་བྱེད་དོ་ཅེས་གསུངས་པ་དང་།",
    "དཔལ་དང་འབྱོར་བ་རྒྱས་ཞེས་གསུངས་པ་སྟེ།",
    "ལྷའི་སྲོག་ཤིང་དང་རིང་བསྲེལ་ལྔ་ལ་སོགས་ཚད་དང་ལྡན་པར་འགྲུབ་པར།",
    "དྲག་པོ་ལྗང་ནག་པོས་གནོད་བྱེད་ཚར་བཅད་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་ཞེས་དང་།",
    "གཡོ་བ་འདོད་གཟུགས་དང་སྣ་ཚོགས་པདྨའི་ས་བོན་ཀྵ་ལྗང་གུཚེག་དྲག་སྟེ་རྣམ་བཅད་ཟླ་ཚེས་སུ་བྱས་པ་དཀར་པོ།",
    "གཙང་སྤང་གཙང་མཐིང་ལ་སོགས་ཚོན་རྩ་ཆེན་རིགས་སྤྱོད་པ་དང་།",
    "གཙང་སྤང་།",
    "གཙང་མཐིང་སོགས་རིན་ཐང་གསེར་དང་མཉམ་པའམ་ཡང་ན་གསེར་ལས་ལྷག་པའི་ཚོན་གྱི་རིགས་མང་དུ་སྤྱོད་པས།",
    "དཔེར་ན་བོད་རིས་སུ་ཁྱད་པར་སྤྱོད་ཅིང་།",
    "བོད་ལས་ཡུལ་གཞན་ན་མེད་པའི་གཙང་སྤང་གཙང་མཐིང་ཞེས་རིན་ཐང་གསེར་ལས་ཆེ་ཞིང་ལག་ལེན་དཀའ་བའི་ཚོན་དེ་སྤྱོད་པར་འདོད་ན།",
    "ཁྱད་པར་ལས་བྱུང་མཐིང་ནག་དང་།",
    "རམས་ལ་དཔག་ནས་བྱེད་པར་བྱ།",
    "རྒྱ་སེར་གཉིས་སུ་བྱེད་པར་སྣང་།",
    "མཚལ་སྐྱུར་བ་བླ་ཅུང་བསྲེས་པར།",
    "མཚལ་ཆེར་དཀར་པོ་ཅུང་བསྣན་པར།",
    "ལག་ལེན་དངོས་ལས་ཤེས་པར་བྱ།",
    "དང་པོ་རྒྱུ་ནི་གཟབ་པར་གཅེས།",
    "ཡང་རས་ཚོས་མི་འདྲེས་སྐུ་སྲོག་སྙི་ཟེར་བས་ཆུ་ཚོན་དང་རས་ཚོས་ཁྱད་པར་དུ་དེང་དུས་སྤྱོད་སྒོ་ཆེ་བའི་ཚོན་བྱེ་ལྡན་ནམ་དྲིལ་བསྒྲགས་ཀྱི་ཚོན་ཡང་ཟེར་ཞིང་སྣུམ་དང་རྩི་ཤིང་སོགས་ལས་བླངས་པའི་ཚོན་སོགས་ཚོན་ཆེན་དག་མ་མ་ཡིན་པ་ཐམས་ཅད་སྤང་དགོས་ཏེ།",
    "མཚལ་མཐིང་སྤང་གསུམ་རླན་ཅུང་ཡོད་པར་བྱས་ཏེ་ཤེད་ཆུང་ཕྱུང་ནས་འདུལ།",
    "མཚལ་ནི་ངེས་པ་མེད་གསུངས་ཀྱང་།",
    "གདུལ་བའི་སྣོད་ནི་གཙང་བ་ལ།",
    "རྡུལ་མ་ཤོར་བར་གཟབ་པར་གཅེས།",
    "དམ་བྱ་ཚོན་གྱི་ཁྱད་པར་སོགས་ལ་གཞིག་ནས་དམ་ཆུ་རན་པར་བླུགས་ཏེ་ཚོན་ཕོར་མེའི་ཐོག་ཏུ་བཞག་ཚོན་ལ་དྲོད་ཕོག་ཏེ་རླངས་པ་ཐོལ་གྱིས་བྱུང་བ་ན་བླངས་ཏེ་མཛུ་གུས་དཀྲོག་འདུལ་གྱིས་སྣུར་ཤ་བཅད།",
    "ཚོན་སྦྱོར་བ་ལ་སྦྱིན་མང་ན་གད་པར་འགྱུར་ཞིང་།",
    "ཁོལ་ན་མདངས་ཤོར་བས་དྲོད་ཚོད་ཟིན་པར་བྱའོ།",
    "ཚོན་བྱུག་པར་ཧ་ཅང་གར་ན་བྱུག་རིས་དང་སྲབ་མཐུག་འབྱུང་ཉེན་ཆེ་ཞིང་།",
    "ལན་གསུམ་དག་ཏུ་བྱུག་པར་བྱ།",
    "འབྱུང་འགྱུར་གྱི་ཚོན་ཐམས་ཅད་ཡིད་ལ་ངེས་པར་བྱ་ལ།",
    "དེ་བཙོ་སྒམ་དུ་གྲི་ལྟག་མཐུག་ཤོས་ཙམ་ཁོད་སྙོམས་པར་བཀྲམ་པའི་སྟེང་དུ།",
    "འབྲུ་བཙོ་བྱས་ན་གསེར་འབྲུ་ཐིག་པའམ།",
    "དེའི་སྟེང་དུ་ཡང་གཅིག་སྟེ་རིམ་པར་གསུམ་ལ་མང་མི་ཉན།"
  ]
}