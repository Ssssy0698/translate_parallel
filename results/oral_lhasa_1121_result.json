{
  "leixing": "oral_lhasa",
  "entries": [
    {
      "id": 1,
      "tibetan": "བདག་དང་གཞན་རྣམས་ཁོང་དུ་ཆུད་པར་བགྱིད་པར་འགྱུར་རོ།",
      "chinese": "我将会掌握自己和他人。"
    },
    {
      "id": 2,
      "tibetan": "བརྗོད་པར་བགྱི་བའམ།",
      "chinese": "或者说出。"
    },
    {
      "id": 3,
      "tibetan": "རིག་པར་བགྱི་བའམ།",
      "chinese": "使……看得见。"
    },
    {
      "id": 4,
      "tibetan": "ཐ་དད་པ་མ་ལགས་པ་ཞེས་བགྱི།",
      "chinese": "非异生。"
    },
    {
      "id": 5,
      "tibetan": "གཉི་ག་ཡང་ཉེས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
      "chinese": "都可构成犯罪。"
    },
    {
      "id": 6,
      "tibetan": "བློ་གྲོས་ཆེན་པོ་གལ་ཏེ་དེ་བཞིན་གཤེགས་པ་དངོས་པོ་ཡིན་མིན་བྱས་པའམ།",
      "chinese": "智慧大者如果能像如来佛一样做到物非所是。"
    },
    {
      "id": 7,
      "tibetan": "མི་རྟག་པར་འགྱུར་ཏེ།",
      "chinese": "而且变异。"
    },
    {
      "id": 8,
      "tibetan": "མི་རྟག་པའི་ཕྱིར་དངོས་པོ་ཐམས་ཅད་ཀྱང་དེ་བཞིན་གཤེགས་པར་འགྱུར་བས་ན།",
      "chinese": "既然万物都是因无常而成如来。"
    },
    {
      "id": 9,
      "tibetan": "ཅི་སྟེ་བྱས་པ་མ་ཡིན་ན་ནི་དམིགས་སུ་མེད་པའི་ཕྱིར་སྦྱོར་བ་རྣམས་དོན་མེད་པར་འགྱུར་ཏེ།",
      "chinese": "如果不是做的话，那么无意的行为就白费了。"
    },
    {
      "id": 10,
      "tibetan": "མ་ལྷུང་བའི་ཕྱིར་མཁས་པ་རྣམས་ཀྱིས་ལེན་པར་བྱེད་དེ།",
      "chinese": "使学者们能够接受。"
    },
    {
      "id": 11,
      "tibetan": "རྟའི་དངོས་པོ་མ་ཡིན་པ་ལ་བ་ལང་དང་རྟའི་དངོས་པོ་དེ་ཡང་དག་པར་ཡོད་པ་ཡང་མ་ཡིན།",
      "chinese": "非马的东西既不是牛的东西也不是马的东西。"
    },
    {
      "id": 12,
      "tibetan": "འདི་ལྟར་རྣམ་པར་རྟོག་པའི་ཕྱིར་རོ།",
      "chinese": "这样观察。"
    },
    {
      "id": 13,
      "tibetan": "རང་བཞིན་མེད་པ་ཡང་དེ་བཞིན་དུ་རིག་པར་བྱའོ།",
      "chinese": "无属性的也是一样。"
    },
    {
      "id": 14,
      "tibetan": "གལ་ཏེ་ཕུང་པོ་རྣམས་དང་ཐ་དད་པ་མ་ཡིན་ན་ནི་མི་རྟག་པ་ཡིན་པར་འགྱུར་རོ།",
      "chinese": "如果不是与身体分离的话，那就是不完整的。"
    },
    {
      "id": 15,
      "tibetan": "ཅི་སྟེ་ཐ་དད་ན་ནི་སྦྱོར་བ་རྣམས་དོན་མེད་པར་འགྱུར་རོ།",
      "chinese": "如果不同的，那么所有的努力都白费了。"
    },
    {
      "id": 16,
      "tibetan": "གལ་ཏེ་གཉིས་སུ་གྱུར་ན་ནི་ཐ་དད་པར་འགྱུར་ཏེ།",
      "chinese": "如果分化了就成为不同的。"
    },
    {
      "id": 17,
      "tibetan": "དེའི་ཕྱིར་རྭ་གཉིས་ནི་གདོན་མི་ཟ་བར་ཐ་དད་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
      "chinese": "因此，二角无疑是不同的。"
    },
    {
      "id": 18,
      "tibetan": "ཅི་སྟེ་ཐ་མི་དད་ན་ནི་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་ཐོབ་པའི་མཚན་ཉིད་བྱེ་བྲག་མེད་པར་འགྱུར་ཏེ།",
      "chinese": "如不相识，则yogini们所得的概念也就没有了。"
    },
    {
      "id": 19,
      "tibetan": "བྱས་པ་ཡང་མ་ཡིན།",
      "chinese": "也不是。"
    },
    {
      "id": 20,
      "tibetan": "འདུས་བྱས་ཀྱང་མ་ཡིན།",
      "chinese": "不是有为的。"
    },
    {
      "id": 21,
      "tibetan": "འདུས་མ་བྱས་ཀྱང་མ་ཡིན།",
      "chinese": "也不是无因。"
    },
    {
      "id": 22,
      "tibetan": "རིག་པར་བྱ་བ་ཡང་མ་ཡིན།",
      "chinese": "也不是什么事。"
    },
    {
      "id": 23,
      "tibetan": "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དོན་དེ་ཉིད་ཡང་བསྟན་པའི་ཕྱིར་ཚིགས་སུ་བཅད་པ་འདི་དག་གསུངས་སོ།",
      "chinese": "于是佛说了这几首诗以示此事。"
    },
    {
      "id": 24,
      "tibetan": "ཅི་ཡི་ཕྱིར་ན་རྣམ་པར་རྟོག།",
      "chinese": "为什么想知道？"
    },
    {
      "id": 25,
      "tibetan": "བྱས་པ་མ་ཡིན་མ་བྱས་མིན།",
      "chinese": "不是做也不是不做。"
    },
    {
      "id": 26,
      "tibetan": "མེད་པའང་མ་ཡིན་ཤེས་པར་བྱ།",
      "chinese": "不是没有。"
    },
    {
      "id": 27,
      "tibetan": "ཡོད་པར་གྱུར་ཕྱིར་མེད་པ་ཡོད།",
      "chinese": "为有所在，就要有所没有。"
    },
    {
      "id": 28,
      "tibetan": "མེད་པར་གྱུར་ཕྱིར་ཡོད་པ་ཡོད།",
      "chinese": "消失的有回归的。"
    },
    {
      "id": 29,
      "tibetan": "མེད་པར་ཡང་ནི་འཛིན་མི་བྱ།",
      "chinese": "不曾被抓住。"
    },
    {
      "id": 30,
      "tibetan": "ཡོད་པར་ཡང་ནི་མི་བརྟག་གོ།",
      "chinese": "有也不查。"
    },
    {
      "id": 31,
      "tibetan": "བདག་དང་འཇིག་རྟེན་རླག་པར་བྱེད།",
      "chinese": "毁了我和整个世界"
    },
    {
      "id": 32,
      "tibetan": "འགག་པ་མ་མཆིས་པ་དེ་ནི་དེ་བཞིན་གཤེགས་པའི་ཚིག་བླ་དགས་སོ་ཞེས་ཀྱང་གསུངས་ན།",
      "chinese": "无阻塞，就是如来之口无虚言。"
    },
    {
      "id": 33,
      "tibetan": "འགག་པ་མ་མཆིས་པ་ཞེས་གསུངས་སམ།",
      "chinese": "未曾有过阻隔？"
    },
    {
      "id": 34,
      "tibetan": "འོན་ཏེ་དེ་བཞིན་གཤེགས་པའི་རྣམ་གྲངས་གཞན་ཞིག་ལགས།",
      "chinese": "但不然是另一个佛陀项目"
    },
    {
      "id": 35,
      "tibetan": "ཤིན་ཏུ་ལེགས་པར་ཉོན་ལ་ཡིད་ལ་ཟུང་ཤིག་དང་།",
      "chinese": "请仔细听着，记下来"
    },
    {
      "id": 36,
      "tibetan": "དེ་བཞིན་དུ་བློ་གྲོས་ཆེན་པོ་ང་ཡང་མི་མཇེད་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་འདི་ན་མིང་གྲངས་མེད་པ་བརྒྱ་སྟོང་ཕྲག་གསུམ་ཡོད་པར་བྱིས་པ་རྣམས་ཀྱི་རྣ་ལམ་དུ་གྲགས་ཏེ།",
      "chinese": "同样智慧的大千世界有无数的千千万万个名字在孩子们的耳边响起。"
    },
    {
      "id": 37,
      "tibetan": "ཁ་ཅིག་ནི་ཐམས་ཅད་མཁྱེན་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "有的则是全知。"
    },
    {
      "id": 38,
      "tibetan": "འཇིག་རྟེན་སྐྱོབ་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "救世有方。"
    },
    {
      "id": 39,
      "tibetan": "བདག་ཉིད་རིག་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "有自我意识。"
    },
    {
      "id": 40,
      "tibetan": "འདྲེན་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "会引起的。"
    },
    {
      "id": 41,
      "tibetan": "རྣམ་པར་འདྲེན་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "有引入的智慧。"
    },
    {
      "id": 42,
      "tibetan": "ཡོངས་སུ་འདྲེན་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "并且完全会引导。"
    },
    {
      "id": 43,
      "tibetan": "ཚངས་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "而且知道佛法。"
    },
    {
      "id": 44,
      "tibetan": "སེར་སྐྱ་ཡིན་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "有了淡黄色。"
    },
    {
      "id": 45,
      "tibetan": "ཡང་དག་པའི་མཐའ་ཡིན་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "知道是正确的边。"
    },
    {
      "id": 46,
      "tibetan": "སྐྱེ་བ་མེད་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "也有无生而知。"
    },
    {
      "id": 47,
      "tibetan": "འགག་པ་མེད་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "无阻地知。"
    },
    {
      "id": 48,
      "tibetan": "མྱ་ངན་ལས་འདས་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "亦有解脱之知。"
    },
    {
      "id": 49,
      "tibetan": "རྟག་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "也常常有意识。"
    },
    {
      "id": 50,
      "tibetan": "གཉིས་སུ་མེད་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "亦无二。"
    },
    {
      "id": 51,
      "tibetan": "མཚན་མ་མེད་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "无性知觉亦有。"
    },
    {
      "id": 52,
      "tibetan": "ལམ་ཡིན་པར་ཤེས་པ་ཡང་ཡོད་དོ།",
      "chinese": "有可能是路"
    },
    {
      "id": 53,
      "tibetan": "བློ་གྲོས་ཆེན་པོ་དེ་ལ་སོགས་པ་མིང་གྲངས་མེད་པ་བརྒྱ་སྟོང་ཕྲག་གསུམ་ལྷག་ཆད་མེད་པར་འཇིག་རྟེན་གྱི་ཁམས་འདི་དང་།",
      "chinese": "包括智慧大士等无数千百万个名字在内，整个宇宙。"
    },
    {
      "id": 54,
      "tibetan": "འཇུག་པ་ཡང་མེད་པར་རབ་ཏུ་ཤེས་སོ།",
      "chinese": "也没有入门。"
    },
    {
      "id": 55,
      "tibetan": "འགག་པ་མེད་པ་ལ་དངོས་པོ་མེད་པར་འདུ་ཤེས་སོ།",
      "chinese": "没有阻碍的；没有障碍的。"
    },
    {
      "id": 56,
      "tibetan": "འགག་པ་མེད་པར་མི་རིག་གོ།",
      "chinese": "不见不识不烦恼。"
    },
    {
      "id": 57,
      "tibetan": "དོན་དང་མི་ལྡན་པར་འཆད་པ་ཡང་མ་ཡིན་ཏེ།",
      "chinese": "不是无意义的叙述。"
    },
    {
      "id": 58,
      "tibetan": "ཉན་ཐོས་རྣམས་ཀྱང་མེད་པར་འགྱུར་རོ།",
      "chinese": "听道的人也将灭绝。"
    },
    {
      "id": 59,
