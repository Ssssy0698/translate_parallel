{
  "leixing": "oral_lhasa",
  "entries": [
    {
      "id": 1,
      "tibetan": "ཞེས་པའི་ཤུགས་ལས་བསྟན་པར་བཞེད་དོ།",
      "chinese": "有力地表明了"
    },
    {
      "id": 2,
      "tibetan": "དེའི་རྗེས་ཐོགས་སུ་སླར་ཡང་རྫོགས་ལྡན་གྱི་དུས་འཇུག་ཅིང་མི་རྣམས་ཀྱང་ཚེ་ལོ་སྟོང་བརྒྱད་བརྒྱ་པར་རིམ་གྱིས་འགྱུར་རོ།",
      "chinese": "之后又进入了一个繁盛的末期，人们寿命逐渐长到八百岁。"
    },
    {
      "id": 3,
      "tibetan": "སླར་ཡང་དུམ་བུ་འདི་ཉིད་དུ་རིགས་ལྡན་དྲག་པོ་ཞེས་བྱ་བས་ཀླ་ཀློ་བཅོམ་ནས་རྫོགས་ལྡན་འཇུག་པར་བྱེད་དོ།",
      "chinese": "再这段中，有类猛兽，横扫野蛮，成就大业。"
    },
    {
      "id": 4,
      "tibetan": "བཞི་པ་གཟའ་རྣམས་སྟོང་པར་འཇུག་པའི་དུས་བཞི་",
      "chinese": "四季的第四个季节；"
    },
    {
      "id": 5,
      "tibetan": "ཞེས་གཟའ་རྣམས་སྟོང་པར་འཇུག་པའི་དུས་བཞིའི་ཚད་ཀྱི་ངེས་པ་དང་འཇུག་ཚུལ་བསྟན་པ་སྟེ།",
      "chinese": "指明空行期的四季度的数值和它的起止时间。"
    },
    {
      "id": 6,
      "tibetan": "དེ་ལ་རགས་པར་ན་མི་ལོ་དྲུག་ཅུ་རྩ་བཞི་དང་ཟླ་བ་བདུན་ཡོད་ལ།",
      "chinese": "那末，六十四岁零七个月。"
    },
    {
      "id": 7,
      "tibetan": "དེ་ལ་སྣོད་བཅུད་དེ་དག་འཇལ་བྱེད་ཚད་ཀྱི་རྣམ་པར་གཞག་པ་ནི།",
      "chinese": "将其列为生态量的形式。"
    },
    {
      "id": 8,
      "tibetan": "དེས་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ཚད་འཇོག་པར་བྱེད་པ་ཡིན་ནོ།",
      "chinese": "它就是用来衡量宇宙的。"
    },
    {
      "id": 9,
      "tibetan": "ཁྱིམ་བཅུ་གཉིས་ཞེས་བྱ་བའི་རིམ་པར་ཡང་འགྱུར་རོ།",
      "chinese": "也将成为十二家之称"
    },
    {
      "id": 10,
      "tibetan": "བྱུང་ཞེས་ཕྱི་རོལ་པ་རྣམས་ལོག་པར་སྨྲ།",
      "chinese": "是的，外面的人们都说是错的。"
    },
    {
      "id": 11,
      "tibetan": "དེས་འཇིག་རྟེན་ཐམས་ཅད་བྱས་སོ་ཞེས་ཟེར་བ་དང་།",
      "chinese": "它说：一切世间都是如此。"
    },
    {
      "id": 12,
      "tibetan": "ལས་ལས་སྣོད་བཅུད་འཇིག་རྟེན་སྐྱེས་པར་གསུངས།",
      "chinese": "说是生生世世男生"
    },
    {
      "id": 13,
      "tibetan": "ཡིད་ཤེས་རྒྱུན་དང་ཀུན་གཞིའི་རྣམ་པར་ཤེས།",
      "chinese": "意识流和潜意识的状态"
    },
    {
      "id": 14,
      "tibetan": "ལས་རྣམས་ནི་བྱས་མ་ཐག་ཏུ་འགགས་ཀྱང་དེ་ཉིད་བསྐལ་པ་བརྒྱར་ཡང་ཆུད་མི་ཟོས་པར་འབྲས་བུ་འབྱིན་པ་དེའི་ཚེ།",
      "chinese": "虽然作业一做就堵塞，但它千年不朽，直到结出果实。"
    },
    {
      "id": 15,
      "tibetan": "འཕགས་པས་རྡུལ་དང་སྐད་ཅིག་འགག་མཁྱེན་གསུངས།",
      "chinese": "如来菩萨说，知空能消尘，能识刹那。"
    },
    {
      "id": 16,
      "tibetan": "དེའང་ལས་རྒྱུར་སྨྲ་བ་གཞིར་བྱས།",
      "chinese": "也是基于行为论。"
    },
    {
      "id": 17,
      "tibetan": "འཕགས་པ་རྣམས་ལ་རྡུལ་ཕྲན་དང་སྐད་ཅིག་འགག་པར་མཁྱེན་ཏེ།",
      "chinese": "诸佛知微尘、知刹那。"
    },
    {
      "id": 18,
      "tibetan": "ཞེས་གསུངས་སོ།",
      "chinese": "他说。"
    },
    {
      "id": 19,
      "tibetan": "འགྲོ་བ་མ་ལུས་ལས་ལས་སྐྱེས་པར་གསུངས།",
      "chinese": "佛说：所有众生都是有业的。"
    },
    {
      "id": 20,
      "tibetan": "དེས་དགེ་མི་དགེའི་ལས་བསགས་པའི་བག་ཆགས་སེམས་ལ་བསྒོས་པ་ཡུལ་དུ་སྨིན་པར་ཉེ་བ་ན།",
      "chinese": "它的善与恶的造物的印象，在心中酝酿成熟时。"
    },
    {
      "id": 21,
      "tibetan": "རྣམ་པར་ཤེས་པ་ནི་ཁ་དོག་དང་དབྱིབས་དང་བྲལ་བ་ཡིན་ཀྱང་སྣང་བའི་མཚན་ཉིད་ཀྱིས་འོད་སྣ་ཚོགས་པ་དང་ལྡན་པ་བཞིན་དུ།",
      "chinese": "意识是没有颜色和形状的，但如同“感性”概念所认为的那样，带有各种各样的光辉。"
    },
    {
      "id": 22,
      "tibetan": "སྲུབ་པར་བྱེད་པ་དང་།",
      "chinese": "用来挤压的。"
    },
    {
      "id": 23,
      "tibetan": "ཞེས་གསུངས་པའི་རིགས་པ་ཕྱི་རོལ་དུ་སྦྱར་བྱ་ཡིན་པས།",
      "chinese": "并且把这种论点用到外部去。"
    },
    {
      "id": 24,
      "tibetan": "སྲོག་དང་ཐུར་སེལ་ནི་དེ་ཐམས་ཅད་ཀྱི་གྲོགས་ཏེ་གོ་སྐབས་སྦྱིན་པར་བྱེད་པའི་ངོ་བོ་ཉིད་ཡིན་ནོ།",
      "chinese": "生命和解脱是所有一切的友善，即提供机会的本质。"
    },
    {
      "id": 25,
      "tibetan": "ཞེས་སོགས་ཟུང་བདུན་གྱི་རིགས་པ་ལས་ཤེས་པར་བྱ་བ་ནི།",
      "chinese": "七对的原理。"
    },
    {
      "id": 26,
      "tibetan": "འདུས་བྱས་རང་ལས་གཞན་པ་བྱེད་རྒྱུ་སྟེ།",
      "chinese": "有为他外，非他之为。"
    },
    {
      "id": 27,
      "tibetan": "ལུས་སྐྱེད་པར་ནུས་པའི་ཕྱིར།",
      "chinese": "因为生长需要能量。"
    },
    {
      "id": 28,
      "tibetan": "ས་བོན་མྱུ་གུ་འདབ་མ་སྡོང་བུ་སོགས་སྔ་མ་སྔ་མ་ཕྱི་མ་ཕྱི་མའི་བྱེད་རྒྱུ་ཡིན་ཏེ་དེ་དག་རིམ་པར་སྐྱེད་པའི་བྱ་བ་ལ་ནུས་པ་ཡོད་པའི་ཕྱིར།",
      "chinese": "种籽、胚芽、萌芽、树干等等，前者作用于后者，后者作用于前者，因为它们逐渐生长而存在的。"
    },
    {
      "id": 29,
      "tibetan": "དེས་ན་འདུས་བྱས་ཕལ་ཆེ་བ་ཞིག་ལྷན་ཅིག་འབྱུང་རྒྱུར་གྲུབ་པ་ཡིན་ནོ།",
      "chinese": "于是，许多有为的存在便组成共生。"
    },
    {
      "id": 30,
      "tibetan": "རྟེན་དང་དམིགས་པ་དང་རྣམ་པ་དང་དུས་དང་རྫས་ཏེ་མཚུངས་པ་ལྔས་མཚུངས་པར་ལྡན་པ་རྣམས་ནི་མཚུངས་ལྡན་གྱི་རྒྱུ་ཞེས་བྱ་སྟེ།",
      "chinese": "对象、目的、方式、时、物等五个等同的因素同属于等同的因素。"
    },
    {
      "id": 31,
      "tibetan": "འགྲོན་པོ་རྣམས་ལམ་བར་དུ་ཟས་སྐོམ་ཁྲུས་མལ་སྟན་སོགས་ཐམས་ཅད་མཚུངས་པར་སྤྱོད་པ་ལྟ་བུའོ།",
      "chinese": "客人在路上吃饭洗澡睡床，统统一样用。"
    },
    {
      "id": 32,
      "tibetan": "མཛོད་ཀྱི་ཕྲ་རྒྱས་བསྟན་པར།",
      "chinese": "书中说："
    },
    {
      "id": 33,
      "tibetan": "གེགས་མིན་དངོས་ལས་འདུས་བྱས་བདག་པོའི་འབྲས།",
      "chinese": "非物质障碍所集中。"
    },
    {
      "id": 34,
      "tibetan": "གེགས་མ་ཡིན་པ་སྟེ་གེགས་མི་བྱེད་པ་ཙམ་གྱི་དངོས་པོའམ་འདུས་བྱས་ལས་བྱུང་ཞིང་།",
      "chinese": "不作为障碍的物或事实；只作为障碍的物或事实。"
    },
    {
      "id": 35,
      "tibetan": "དེ་ཡང་འདུས་བྱས་ཀུན་དང་བྲལ་ཐོབ་སྟེ།",
      "chinese": "因缘消失，得而不为。"
    },
    {
      "id": 36,
      "tibetan": "འདུས་མ་བྱས་གཉིས་རྒྱུ་འབྲས་མེད་པར་འདོད།",
      "chinese": "认为无为是无因无果的。"
    },
    {
      "id": 37,
      "tibetan": "ནམ་མཁའ་དང་སོ་སོར་བརྟགས་མིན་འགོག་པ་སྟེ་འདུས་མ་བྱས་གཉིས་ལ་རྒྱུ་འབྲས་མ་གྲུབ་པས་མེད་པར་འདོད་དེ།",
      "chinese": "认为天空和自身的因明不应相互作用，二者都是不应有的东西。"
    },
    {
      "id": 38,
      "tibetan": "སེམས་སོགས་ཏེ་སེམས་དང་སེམས་ལས་བྱུང་བ་དང་འདས་པ་དང་ད་ལྟ་བར་སྐྱེས་པ་དེའི་སྐབས་སུ་རིགས་མཐུན་གཞན་མེད་པར་རྫས་མཚུངས་ཤིང་།",
      "chinese": "心等等即心、心生、过去的、现在的，在其时没有别的同类，都是等物；"
    },
    {
      "id": 39,
      "tibetan": "མཚུངས་ལྡན་རིགས་མཐུན་གཞན་གྱིས་བར་མ་ཆོད་པར་སྐྱེས་འཕྲལ་དེ་མ་ཐག་ཏུ་རང་འབྲས་འབྱིན་པ་ནི་མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་ཞེས་བྱ།",
      "chinese": "其他等同的同位物没有中间环节，一生下来即发生作用，叫做等同的即刻因。"
    },
    {
      "id": 40,
      "tibetan": "འབྲས་བུ་གང་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་དེ་ནི་རྒྱུ་ཡིན་ངེས་པས་ན་བྱེད་པའི་རྒྱུའམ་ངོ་བོ་ཉིད་ཀྱི་རྒྱུ་ཞེས་བྱ།",
      "chinese": "只要产生某种结果的因素就是因素，因而是做因或本质因。"
    },
    {
      "id": 41,
      "tibetan": "བར་དུ་ཕན་ཚུན་མི་འབྲལ་བར་ཕན་འདོགས་པར་གནས་པ་ལྟ་བུ།",
      "chinese": "彼此不分离，相互有利。"
    },
