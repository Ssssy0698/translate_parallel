{
  "leixing": "oral_amdo",
  "entries": [
    {
      "id": 1,
      "tibetan": "གཞལ་ཡས་ཁང་གི་འོད་ཤོར་ཁ་དོག་ཉམས",
      "chinese": "殿堂光芒失去，颜色黯淡。"
    },
    {
      "id": 2,
      "tibetan": "ཕྱི་མ་གར་སྐྱེ་ལྷ་ཡི་མིག་གིས་མཐོང་",
      "chinese": "后者被生育神的眼睛所看"
    },
    {
      "id": 3,
      "tibetan": "བསག་པའི་བསོད་ཟས་སྡིག་འཕེལ་ངན་སོང་སྐྱེ",
      "chinese": "积累的福报，转化为恶业。"
    },
    {
      "id": 4,
      "tibetan": "དང་པོ་ཕོ་མོ་རྒྱུ་རྐྱེན་ཕྲད་པའི་༢༡༩བ་ཚེ",
      "chinese": "第一性别因素是遇到219次"
    },
    {
      "id": 5,
      "tibetan": "ཕོ་མོ་འཁྲིག་དུས་མེ་ཉོར་བཅོས་པ་ལྟར",
      "chinese": "如男女交合后做火星"
    },
    {
      "id": 6,
      "tibetan": "ཟླ་ངོ་བཅུ་སོང་ལུས་ཟུངས་རྫོགས་གྱུར་ཏེ",
      "chinese": "十月过去，身体虚弱。"
    },
    {
      "id": 7,
      "tibetan": "ཁོ་ཡི་རེ་བ་སྐོང་བར་མི་འགྱུར་རོ",
      "chinese": "他的要求将不会被满足。"
    },
    {
      "id": 8,
      "tibetan": "དེ་ནས་ཆེར་སོང་ལང་ཚོ་དར་ལ་བབས",
      "chinese": "然后长大了，进入了青春期"
    },
    {
      "id": 9,
      "tibetan": "བལྟོས་པ་མ་འཁྱོངས་དོགས་ནས་སེམས་ཁྲལ་བྱེད་",
      "chinese": "担心看不惯"
    },
    {
      "id": 10,
      "tibetan": "ཁ་མང་རང་གི་ཁ་ཡིས་ཕུང་ནས་སྡུག",
      "chinese": "过多的闲言碎语会毁了你。"
    },
    {
      "id": 11,
      "tibetan": "བན་བཙུན་༢༢༡ན་ཕོ་མོ་བུ་ཆུང་ཆེ་དོག་སྡུག",
      "chinese": "僧尼221名，男女幼童大多寒苦。"
    },
    {
      "id": 12,
      "tibetan": "འཕྱོན་མ་སྒེག་མོ་ཀུན་སེམས་འཛིན་དགོས་སྡུག",
      "chinese": "妓女的性骚扰和虐待。"
    },
    {
      "id": 13,
      "tibetan": "ན་ཆུང་བུ་མོ་གོ་རྒས་ལུས་དོག་སྡུག",
      "chinese": "年轻姑娘年老心酸。"
    },
    {
      "id": 14,
      "tibetan": "ཁྱོ་ཆུང་མ་རྙེད་ཕོ་རེང་མོ་རེང་སྡུག",
      "chinese": "丈夫找不到妻子，男人苦，女人苦。"
    },
    {
      "id": 15,
      "tibetan": "ཁ་དྲག་པོ་རྣམས་ཁ་ཉེན་སོང་དོགས་སྡུག",
      "chinese": "言辞尖锐者，生怕伤人。"
    },
    {
      "id": 16,
      "tibetan": "ཁ་ཉན་པོ་རྣམས་ཁ་དྲག་རེ་བས་སྡུག",
      "chinese": "听话的人都受到严厉的要求。"
    },
    {
      "id": 17,
      "tibetan": "བུ་མེད་པོ་རྣམས་བུ་ཡོད་རེ་བས་སྡུག",
      "chinese": "没有儿子的妇女，盼望儿子。"
    },
    {
      "id": 18,
      "tibetan": "ཕོ་མོ་སྒོ་ཐལ་བ་ལ་མིག་སེར་སྡུག",
      "chinese": "男女俱白眼。"
    },
    {
      "id": 19,
      "tibetan": "དྲང་པོར་སྐྱེས་པའི་ལུས་ནི་སྒུར་པོར་སོང་",
      "chinese": "直立的身体变成弓腰的身体"
    },
    {
      "id": 20,
      "tibetan": "ལེགས་པའི་ལང་ཚོ་རྒུད་པས་སྐྱུག་བྲོ་ལྟ",
      "chinese": "好的青春，衰了，就会丑。"
    },
    {
      "id": 21,
      "tibetan": "མཐོང་བྱེད་ཀྱིས་མ་ཁྱོགས་པས་མིག་མི་གསལ",
      "chinese": "视力减弱，眼睛模糊。"
    },
    {
      "id": 22,
      "tibetan": "ཤ་གྲོས་མཁུར་ཚོས་ཁྲག་གི་མེ་ཏོག་ཡལ",
      "chinese": "肌肉面部血管消失"
    },
    {
      "id": 23,
      "tibetan": "ཁ་མཚུལ་བཞིན་ནག་སྤོས་༢༢༡བ་བྱའི་རི་མོར་ཤར",
      "chinese": "像蚊子一样黑的221号鸟图案"
    },
    {
      "id": 24,
      "tibetan": "ལུས་ལ་གར་བལྟས་ཧེལ་གེ་བཅུས་བཞིན་སོང་",
      "chinese": "看似随随便便的洗了个澡"
    },
    {
      "id": 25,
      "tibetan": "མཚན་མོ་གཉིད་ཡར་ནམ་ལ་ལོངས་དུས་མེད",
      "chinese": "晚上睡觉老是没睡好。"
    },
    {
      "id": 26,
      "tibetan": "གཞོན་ནུ་ཀུན་གྱིས་ལྟད་མོ་ཆེ་ཞིང་དགོད",
      "chinese": "年轻人都看得很开心。"
    },
    {
      "id": 27,
      "tibetan": "བདེ་མོར་བཅུག་པའི་སྔས་ནི་ཤིང་བས་རེངས",
      "chinese": "舒适的枕头是木头的"
    },
    {
      "id": 28,
      "tibetan": "སྐྲ་ཉལ་རེ་ལས་རྔུལ་ཐིགས་རེ་རེ་འཛག",
      "chinese": "一缕鬈发上滴下汗珠。"
    },
    {
      "id": 29,
      "tibetan": "ཉིན་མོ་ཉིན་རིང་མཚན་མོ་མཚན་ཡང་རིང་",
      "chinese": "白天长夜长。"
    },
    {
      "id": 30,
      "tibetan": "གཉིད་བསྲུངས་ཟས་བསྲུངས་འགྲུལ་བསྲུང་རེ་ལམ་ཤོར",
      "chinese": "守寐守食守客失路"
    }
  ],
