{
  "leixing": "oral_lhasa",
  "entries": [
    {
      "id": 1,
      "tibetan": "ལྷ་གུར་དཀར་པོའི་རྒྱན་དུ་བཞུགས།",
      "chinese": "在白色的神龛中"
    },
    {
      "id": 2,
      "tibetan": "ཕྲག་གོང་གཡོན་པའི་ཐོག་ཏུ་ཕོག་ནས་གཡས་ཀྱི་མཆན་འོག་བར་དུ་གཤགས་ཏེ་རྡ་ར་མཐིང་གཤོག་འཕྲུལ་ལྕེ་དེ་རྟ་གོང་ནས་ལྷུང་སྟེ་བགྲོངས།",
      "chinese": "被射中左肩，向右肩下方一撕，蓝翅机翼从马背上掉下来，飞毙。"
    },
    {
      "id": 3,
      "tibetan": "ཁོང་གསུམ་ཤི་འཐབ་རོ་འཐབ་ཇ་ཡུན་ཙམ་བྱས་ཀྱང་ཁེ་ཕམ་གྱི་དབྱེར་བ་མ་ཕྱེད།",
      "chinese": "三人死对死，搏斗数小时，未分胜负。"
    },
    {
      "id": 4,
      "tibetan": "བདག་ལ་གནང་རྒྱུ་ཨེ་ཡོད་ཞུ།",
      "chinese": "请问我有什么可以要的吗？"
    },
    {
      "id": 5,
      "tibetan": "དེ་རིང་གཟའ་སྐར་སྤྲོད་སྦྱོར་གང་ལ་བལྟས་ཀྱང་ཡག་པོ་མེད་པས་ཁ་སྲས་ཕེབས་མི་ཉན།",
      "chinese": "今天星象不吉祥，陪请尊亲勿出门。"
    },
    {
      "id": 6,
      "tibetan": "དེའི་ཤ་ཤོར་ཤ་ལན་ཐོན་བསྡད་ཡོད།",
      "chinese": "它的肉有瘢痕。"
    },
    {
      "id": 7,
      "tibetan": "འབྲོང་རུ་རྒོད་རྒྱལ་གྲགས་པ་དེ་གཡུ་ལྷའི་གདོང་ལ་མཆོང་སྟེ་ལག་གཡས་དགྲ་ཟོར་གནམ་ལ་འཕྱར་ཏེ་གཡོན་པས་རྟ་ཁ་ལྷོད་ཙམ་བྱས་ནས་ཡིན་ལུགས་ཀྱི་དཔའ་གླུ་ཐུང་ཐུང་འདི་བླངས་སོ།",
      "chinese": "野牦牛杰合扎巴跳上玉拉的身子，右手高高地举起，左手轻轻地勒住马，唱起了这首英雄歌。"
    },
    {
      "id": 8,
      "tibetan": "དགྲ་བོའི་ལྷ་སྲུང་ཐམས་ཅད་རང་གཤེད་ལ་ཕབས་པའི་སྔགས་རྒོད་བཟླས།",
      "chinese": "诅咒敌人护法自灭的咒语。"
    },
    {
      "id": 9,
      "tibetan": "འབྲལ་མེད་སྤྱི་བོར་གཙུག་ཏུ་བཞུགས།",
      "chinese": "密切依附在头顶上。"
    },
    {
      "id": 10,
      "tibetan": "དཀར་གཏོར་གསེར་སྐྱེམས་འདི་བཞེས་ལ།",
      "chinese": "请饮此酥油茶。"
    },
    {
      "id": 11,
      "tibetan": "རུ་ང་ཕྲག་དོག་མ་བྱེད་པར།",
      "chinese": "别忌妒"
    },
    {
      "id": 12,
      "tibetan": "གཏོར་མ་གསེར་སྐྱེམས་འདི་བཞེས་ལ།",
      "chinese": "接受此次供品。"
    },
    {
      "id": 13,
      "tibetan": "འཇིག་རྟེན་དྲེགས་པའི་ལྷ་སྲུང་བཅོལ།",
      "chinese": "依靠世界尊者护法神。"
    },
    {
      "id": 14,
      "tibetan": "མཆོད་ཅིང་བསྟན་དགྲ་འཇོམ་པར་མཛོད།",
      "chinese": "请祈愿驱除敌害。"
    },
    {
      "id": 15,
      "tibetan": "བདུད་དཔུང་རྩད་ནས་གཅོད་པར་བྱེད།",
      "chinese": "摧毁魔军势力。"
    },
    {
      "id": 16,
      "tibetan": "པདྨ་ཉི་མའི་གདན་ལ་བཞུགས།",
      "chinese": "莲花座上太阳。"
    },
    {
      "id": 17,
      "tibetan": "མིང་ཙམ་མེད་པར་ཚར་ཆོད་ཅིག།",
      "chinese": "毁灭干脆地，干脆地。"
    },
    {
      "id": 18,
      "tibetan": "ཡན་ལག་བརྒྱད་ལྡན་ཆུ་གཙང་བབས།",
      "chinese": "八支清水泻。"
    },
    {
      "id": 19,
      "tibetan": "གླིང་སྒར་ཡུ་མེད་མ་བྱས་ན།",
      "chinese": "不做露营者。"
    },
    {
      "id": 20,
      "tibetan": "དེ་དུས་མཐིང་རིང་དང་གངས་རི་དཔའ་རྟུལ་རྣམས་ཀྱི་ཤི་བ་སྲོག་ལ་འཕང་མེད་ཀྱི་ཁོ་ལ་འཐབ་འཛིང་བྱས་པའི་དུས་སུ།",
      "chinese": "当时，蓝衣与雪山勇士们死里逃生地与他搏斗的时候，"
    },
    {
      "id": 21,
      "tibetan": "འབྲལ་མེད་སྤྱི་བོར་རྒྱན་དུ་བཞུགས།",
      "chinese": "密切地在头上戴着。"
    },
    {
      "id": 22,
      "tibetan": "བདེན་ཨེ་བསམ་དགྲ་འདྲེ་ཇོ་རུ་ལགས།",
      "chinese": "是吗？魔鬼大哥。"
    },
    {
      "id": 23,
      "tibetan": "དེ་རིང་གསོད་པའི་དུས་ལ་བབ་ཟེར་ནས་གླུ་འདི་གསུངས་སོ།",
      "chinese": "今天杀的正当其时说说这首歌。"
    },
    {
      "id": 24,
      "tibetan": "བཅོམ་ལྡན་ཤཱཀྱ་ཐུབ་པ་མཁྱེན།",
      "chinese": "释迦牟尼佛陀！"
    },
    {
      "id": 25,
      "tibetan": "ཕྱི་རབས་བོད་ལ་བྱས་རྗེས་བསྐྲུན།",
      "chinese": "为后世西藏作贡献"
    },
    {
      "id": 26,
      "tibetan": "ཅེས་གསུངས་པ་དང་།",
      "chinese": "习近平指出，"
    },
    {
      "id": 27,
      "tibetan": "ཁོས་རལ་གྲི་ཤུབས་ནང་ལ་བཅུག་སྟེ་དཔུང་པ་གཡས་བརྫེ་དང་གཡོན་བརྫེ་བྱས་ནས་ཐེ་ཚོམ་མེད་པར་གླིང་གེ་སར་གྱི་སྐུ་ལ་འཐམ་བྱུང་།",
      "chinese": "他把剑拔出，伸出左手右臂，果断地拥抱了格萨尔大王。"
    },
    {
      "id": 28,
      "tibetan": "བྱ་རྟ་ཁྱུང་གཤོག་གོང་ནས་གཡས་སུ་འགྱུར་ཙམ་བྱས་པས་མདའ་དེ་མ་ཐེབས།",
      "chinese": "鸟在凤翅上左偏了一点，未中此箭。"
    },
    {
      "id": 29,
      "tibetan": "ཉི་འབུམ་གྱིས་ལག་གཡས་ཁྲབ་ཀྱི་ཐོང་རྩ་ནས་བཟུང་སྟེ་གཡོན་པས་རྒྱབ་དར་ནས་དམ་འཛིན་བྱས་ཏེ་འབྲོང་རྒོད་རྭ་འཛིང་བརྒྱབ་པ་ལྟར་ཁོང་གཉིས་ཁྲབ་ཆེན་སྤར་འཛིང་ཡུན་རིང་བྱས།",
      "chinese": "尼布用右手抓住盾牌的束带，左手抓住旗杆，像野牛般地猛烈地撕扯着。"
    },
    {
      "id": 30,
      "tibetan": "ག་གླིང་གཡུལ་འགྱེད་དྲག་པོ་བྱས།",
      "chinese": "进行了欧洲大战"
    },
    {
      "id": 31,
      "tibetan": "ཅེས་གསུངས་པ་དང་།",
      "chinese": "他说，"
    },
    {
      "id": 32,
      "tibetan": "ཡང་སྒོས་ས་ར་ཧ་པ་མཁྱེན།",
      "chinese": "尤其是萨拉哈巴"
    },
    {
      "id": 33,
      "tibetan": "དེ་རིང་གླིང་སྡུག་འདན་མ་ཁོ་ལ་ཡ་ཡ་དྲན་ནས་མདའ་མཚོན་ངར་མའི་སོ་ཁ་བདར་ཤ་བཅད་དེ་བསྒུགས་བསྡད།",
      "chinese": "今天在朗都丹玛，他惦记着亚亚，像一把利刃，等待着。"
    },
    {
      "id": 34,
      "tibetan": "རོང་བཙན་ཁ་བ་དཀར་པོ་མཁྱེན།",
      "chinese": "绒辖卡瓦格博神。"
    },
    {
      "id": 35,
      "tibetan": "ཀླུ་བཙན་དཔོན་གྱི་ནང་བློན་བྱས།",
      "chinese": "做了吐蕃王的内阁大臣"
    },
    {
      "id": 36,
      "tibetan": "བདུད་ཀྱི་ལུག་རྫི་ལོ་གསུམ་བྱས།",
      "chinese": "当了魔鬼的放羊娃3年。"
    },
    {
      "id": 37,
      "tibetan": "དེ་ནས་སེང་ཆེན་བྱང་ལ་ཕེབས།",
      "chinese": "然后桑钦就走向北方"
    },
    {
      "id": 38,
      "tibetan": "གཡུ་འབྲུག་ཐོག་རྒོད་དཔོན་བློན་རྣམས་ཀྱིས་མཁར་ནང་དུ་ཐོན་དུས་ཡ་དང་ཡ་བསམ་ནས་བསྒུགས་བསྡད་པའི་དུས་སུ།",
      "chinese": "当玉珠火凤官员们进入城堡的时候，亚当和亚当想着他们所等候的时刻到了。"
    },
    {
      "id": 39,
      "tibetan": "ར་འདྲ་འཆི་བདག་ཡ་མེད་དེས་ངར་ཆེན་གྱིས་མདའ་རྒྱང་གང་ཙམ་སྔོན་ལ་ཐོན་ཏེ་གནམ་ལྕགས་ཀྱི་རལ་གྲི་ངར་མ་དེ་མེ་འོད་ཟི་ར་འཚུབ་སེ་ལྕགས་རི་དེ་ཚོ་མར་དུམ་གཅོད་གཅོད་བྱས་ཏེ་ནང་དུ་ནུབ་དམག་ཚོ་རྩྭ་མགོ་ཟོར་བས་འབྲེག་འབྲེག་བསད།",
      "chinese": "那厉害的神军大王就凭着神枪手的绝技，先出一箭把敌人城墙炸开了个窟窿。接着又出一箭把敌人的城墙炸开了一个窟窿。敌人城墙一面一面被炸塌了，敌人在里面被砍得死伤无数。"
    },
    {
      "id": 40,
      "tibetan": "འཕྲོ་ལུས་རྣམས་ཀྱིས་མགོ་འབུལ་བྱས།",
      "chinese": "剩下的都自首了"
    },
    {
      "id": 41,
      "tibetan": "ལ་ལ་ལ་བྲོས་ལུང་བྲོས་བྱས།",
      "chinese": "有些人逃之夭夭。"
    },
    {
      "id": 42,
      "tibetan": "དེ་དུས་དམག་དཔོན་གཡུ་འབྲུག་ཐོག་རྒོད་དེས་བསམ་པར།",
      "chinese": "这时，军长玉珠托合说："
    },
    {
      "id": 43,
      "tibetan": "རྗེ་རྒྱལ་པོའི་གསུངས་དེ་ལོས་བདེན་ཏེ།",
      "chinese": "您的话是对的。"
    },
    {
      "id": 44,
      "tibetan": "མ་ཤི་གསོན་པོ་གནས་བསྡད་ན།",
      "chinese": "活着。"
    },
    {
      "id": 45,
      "tibetan": "སོ་སྒྲ་འཆའ་བཞིན་ཨམ་གཙིགས་བསྡམས་ནས་བསྡད།",
      "chinese": "咬牙切齿。"
    },
    {
      "id": 46,
      "tibetan": "གླིང་ལ་མགོ་འབུལ་བྱས་ན་བསམ།",
      "chinese": "愿意为神献身"
    },
    {
      "id": 47,
      "tibetan": "གྲི་ལན་དགུ་གེ་སར་ལ་བཏབ་ཀྱང་མེ་སྟག་དམར་ཁྲོམ་ཁྲོམ་བྱས་པ་ལས་གོ་ཅི་ཡང་མ་ཆོད།",
      "chinese": "把刀子刺进格萨尔身上，火星嘭嘭地发着，但没有刺中。"
    },
