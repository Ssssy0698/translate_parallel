{
  "leixing": "oral_kham",
  "entries": [
    {
      "id": 1,
      "tibetan": "དེར་བྲམ་ཟེའི་ཁྱེའུ་དེའི་དགོངས་པ་ལ་ལོང་མེད་མྱུར་དུ་ལྷོ་ཕྱོགས་སུ་ཤོག་ཟེར་བའི་བརྡར་འདུག་སྙམ་སྟེ།",
      "chinese": "婆罗门的儿子想：我没有听见什么命令，怎么要赶快到南方去呢？"
    },
    {
      "id": 2,
      "tibetan": "དེ་རིང་གསལ་བ་འདི་བཞིན་འཛུམ་ཞིང་དགེས་ནས་གདའ་ན།",
      "chinese": "今天如此明亮和暖和。"
    },
    {
      "id": 3,
      "tibetan": "བདེ་གཤེགས་ཕྱག་བཞིན་བརྟན་པར་གདའ།",
      "chinese": "如来佛像的四只手牢牢握着宝瓶。"
    },
    {
      "id": 4,
      "tibetan": "འོད་སྟོང་གསལ་བ་དབུས་ན་གདའ།",
      "chinese": "光辉灿烂，犹如中天。"
    },
    {
      "id": 5,
      "tibetan": "བསམ་གཏན་འབོལ་བའི་སྟན་ལ་འདུག།",
      "chinese": "坐在软垫上静坐。"
    },
    {
      "id": 6,
      "tibetan": "ཞེས་ཞུས་ལན་དང་བཅས་པ་མང་པོ་གསུངས་གདའ་ན།",
      "chinese": "他说了许多话。"
    },
    {
      "id": 7,
      "tibetan": "ཇོ་བོའི་ཞལ་ནས་སྣོད་དུ་མི་རུང་བའི་མི་མི་གདའ་འམ།",
      "chinese": "佛祖说过不容纳的东西不在此中吗?"
    },
    {
      "id": 8,
      "tibetan": "དེ་རིང་འཛེར་བར་འགྲོ་བ་གདའ་བས།",
      "chinese": "今天去钉钉子。"
    },
    {
      "id": 9,
      "tibetan": "སྒྲ་སྙན་པ་ཅིག་ཀྱང་གདའ་བ་དང་།",
      "chinese": "发出很好的声音"
    },
    {
      "id": 10,
      "tibetan": "ལྟས་ཁྱད་པར་ཅན་གཞན་ཡང་གདའ་བས།",
      "chinese": "又有其他的特殊现象。"
    },
    {
      "id": 11,
      "tibetan": "རྔོག་བློ་སྣ་མ་མང་ལྷ་ཐམས་ཅད་ཀྱང་འདི་ན་འདུས་གདའ།",
      "chinese": "各神灵都聚集在此处。"
    },
    {
      "id": 12,
      "tibetan": "མཐོང་བ་ཙམ་གྱིས་དད་པ་ཕུན་སུམ་ཚོགས་པ་སྐྱེ་བ་ཅིག་འདུག་པ།",
      "chinese": "一见钟情，百感交集。"
    },
    {
      "id": 13,
      "tibetan": "འདི་སྤྲུལ་པའི་དགེ་སློང་ཞིག་འདུག་ངའི་མིང་ཡང་ཤེས།",
      "chinese": "这里有个化身的僧侣，知道我的名字。"
    },
    {
      "id": 14,
      "tibetan": "བཀའ་བཀྱོན་པའི་སྒོ་ནས་གདམས་ངག་འདོམས་ཤིང་གདའ་སྙམ་ནས་སླར་ཞུས་པ།",
      "chinese": "以为责备教诲，于是又请求。"
    },
    {
      "id": 15,
      "tibetan": "བུ་དེ་ཡང་ཐམས་ཅད་ཀྱིས་བཀུར་བ་ཅིག་དགོས་པར་གདའ་བས།",
      "chinese": "那个男孩需要一个被大家爱戴的。"
    },
    {
      "id": 16,
      "tibetan": "དུས་དང་རང་བཞིན་འགྱུར་བ་ཤིན་ཏུ་མཚར།",
      "chinese": "时尚的变化真是太神奇了。"
    },
    {
      "id": 17,
      "tibetan": "དེར་རྒྱལ་པོ་རི་དྭགས་ཀྱི་ཤ་ལྤགས་ཤིག་མདུན་ན་བཞག་སྟེ་འདུག་པ་དེ་མཐོང་ནས།",
      "chinese": "看到一只狮子皮放在一边。"
    },
    {
      "id": 18,
      "tibetan": "བརྩོན་འགྲུས་ཆེན་པོས་རྟག་ཏུ་དེ་ལྟར་སྤྱོད་ཅིང་འདུག་པ་མཐོང་བ་དང་།",
      "chinese": "勤劳的常这样做；"
    },
    {
      "id": 19,
      "tibetan": "དད་པའི་ཞིང་ས་གཤིན་པར་གདའ།",
      "chinese": "信念的沃土。"
    },
    {
      "id": 20,
      "tibetan": "ཡག་བཞེར་སྐུ་གཤེན་འབྲོམ་དུ་གདའ།",
      "chinese": "美貌被追求者。"
    },
    {
      "id": 21,
      "tibetan": "ཞེས་བྱ་བ་གསུངས་གདའ་ན།",
      "chinese": "说了这个话。"
    },
    {
      "id": 22,
      "tibetan": "ཕྱི་རོལ་བའི་སྟོན་པ་དེ་དག་འདུག་པའི་ཚེ་ན་ཁོང་འགྲེང་།",
      "chinese": "当外国人指着某物时他总是站着"
    },
    {
      "id": 23,
      "tibetan": "ཁོ་རང་ཟ་བ་ནི།",
      "chinese": "他吃的"
    },
    {
      "id": 24,
      "tibetan": "ཁོ་རང་ཡང་ཟ་བ་དེ་གཉིས་ཀར་གྱི་མ་ཡིན་པ་ལ།",
      "chinese": "他又不是那两个家伙的。"
    },
    {
      "id": 25,
      "tibetan": "གཉིས་ཀར་གྱིས་བཅད་ཅིང་ཟོས་པར་འགྱུར་ཟེར་བར་འདུག་པས།",
      "chinese": "两者均被切成小块然后被吃掉。"
    },
    {
      "id": 26,
      "tibetan": "མུ་སྟེགས་བྱེད་འདི་དག་ལ་བློ་ཕུགས་གཏད་མི་ཐུབ་ཟེར་བར་འདུག་སྙམ་དུ་དགོངས་སོ།",
      "chinese": "所以说这些邪说令人难以信服。"
    },
    {
      "id": 27,
      "tibetan": "མུ་སྟེགས་འདི་དག་ནི་མཆོད་གནས་ངན་པ་ཡིན་པར་གདའ་བ་ལ།",
      "chinese": "这些邪教徒竟然是邪恶的圣地。"
    },
    {
      "id": 28,
      "tibetan": "ཀུན་ཏུ་དགའ་འདི་ལས་འབྲེལ་ནང་པ་ལ་ཤར་བ་ཅིག་གདའ་བས།",
      "chinese": "天使使人心生爱。"
    },
    {
      "id": 29,
      "tibetan": "ཕྱག་དང་སྤྱོད་ལམ་ལ་སོགས་པ་མི་མཐུན་པར་ནང་བའི་སར་འགྲོ་ཞིང་འདུག་ཟེར་བ་ཐོས།",
      "chinese": "行、修、法、习不一，故而入家、居家。"
    },
    {
      "id": 30,
      "tibetan": "ལྷ་ཐམས་ཅད་ཀྱང་གཞོན་ནུ་མ་ཐམས་ཅད་དགའ་བ་འཇིག་རྟེན་གྱི་ཡིད་དུ་འོང་བ་གདའ་བས།",
      "chinese": "所有的神都喜欢所有的少女，所有的世界都美丽。"
    },
    {
      "id": 31,
      "tibetan": "ན་གཞོན་པས་ཁོ་ཞེན་གདའ་བས།",
      "chinese": "年轻人嫌弃他。"
    },
    {
      "id": 32,
      "tibetan": "དེ་ནས་ཁྱེད་རང་གར་མཉེས་པའི་སར་གཤེགས་པར་བྱེད་འོན་ཏེ་ཀུན་ཏུ་དགའ་མེད་ཀྱང་འདིར་བཞུགས་པར་བྱེད་ཅེས་སྨྲས་པ་དམ།",
      "chinese": "然后让你去你喜欢的地方去，而你却不喜欢却又留你在这里？"
    },
    {
      "id": 33,
      "tibetan": "སྤྱོད་ལམ་མ་བསྟུན་པས་ཕྱི་རོལ་བ་དག་གནས་དེར་མི་འདུག་པའི་ཐབས་སུ་གྱུར་ཏེ།",
      "chinese": "不讲究规矩，外人不便在那里居住。"
    },
    {
      "id": 34,
      "tibetan": "ད་གཟོད་ཐོས་ནས་འགྱོད་ནས་འོང་ཙ་ན།",
      "chinese": "再闻而悔。"
    },
    {
      "id": 35,
      "tibetan": "གོས་དཀར་པོ་དྲི་མ་མེད་པ་ཧ་ཅང་བཀྲག་མི་ཆེ་བ་གྱོན་པ་དེ་ལྟ་བུ་ཞིག་འདུག་པ་མཐོང་ངོ།",
      "chinese": "看见一个穿着很朴素的白色衣服。"
    },
    {
      "id": 36,
      "tibetan": "ཞེས་གསུངས་གདའ་ན།",
      "chinese": "那么说。"
    },
    {
      "id": 37,
      "tibetan": "རྒྱལ་པོ་འདི་ཉིད་དད་པ་ཆེ་བ་ཞིག་འདུག་སྟེ།",
      "chinese": "国王对佛教信仰很深。"
    },
    {
      "id": 38,
      "tibetan": "འཁོར་ན་ལྷག་པ་བཅུ་དྲུག་གདའ།",
      "chinese": "转了十六圈"
    },
    {
      "id": 39,
      "tibetan": "ལྷ་བཞིན་མཛེས་པར་མི་གདའ་འམ།",
      "chinese": "难道不美如仙？"
    },
    {
      "id": 40,
      "tibetan": "གཡེང་བ་སྤངས་ཏེ་ནང་ནའང་གདའ།",
      "chinese": "不顾浮沉。"
    },
    {
      "id": 41,
      "tibetan": "ཁྱད་པར་དུའང་དོ་ཞག་བློན་པོ་འདི་དག་སྔར་བས་དལ་བ་ཞི་བ་དུལ་བ་རྒྱལ་བུ་ལྷ་སྐྱེས་དང་མཚུངས་པར་གདའ་ཞེས་ཀུན་གྱིས་བསྒྲགས་སོ།",
      "chinese": "尤其是夜间这些大臣们更加文雅，像天生贵子一样。"
    },
    {
      "id": 42,
      "tibetan": "བློན་འབངས་དང་བཅས་པ་ནི་ཁྱེད་ལ་དེ་སྐད་མི་ཟེར་བར་གདའ།",
      "chinese": "臣子们都不敢这么说你。"
    },
    {
      "id": 43,
      "tibetan": "འདི་ལྟར་རྟ་བའི་ཚོགས་ཤིན་ཏུ་མང་བ་ཞིག་གདའ་བ།",
      "chinese": "这样就有很多的骑士团"
    },
    {
      "id": 44,
      "tibetan": "འདི་ལྟར་རྟ་བ་མང་བར་གདའ།",
      "chinese": "这样骑马的人多了"
    },
    {
      "id": 45,
      "tibetan": "བློ་གྲོས་མཐའ་རུ་ཕྱིན་པར་གདའ།",
      "chinese": "智慧远达。"
    },
    {
      "id": 46,
      "tibetan": "ཞེས་གསུངས་གདའ་ན།",
      "chinese": "他说过。"
    },
    {
      "id": 47,
      "tibetan": "ཟངས་གཞོང་ཡང་ཆུས་མི་འཁྱེར་མི་ནུབ་འདི་ལྟར་གདའ་ན།",
      "chinese": "铜盘不被冲走不被淹没"
    },
    {
      "id": 48,
      "tibetan": "ཡོན་ཏན་ཐ་མར་འདུག་དབུས་མས་ཅི་ཤེས།",
      "chinese": "学问最末尾，中间又何能知?"
    },
    {
      "id": 49,
      "tibetan": "ཡོན་ཏན་གོང་མ་ལྟར་འདུག་ཐ་མས་ཅི་ཤེས་སྨྲས་པས།",
      "chinese": "学问前后如次，最后才讲到。"
    },
    {
      "id": 50,
      "tibetan": "རྒྱལ་པོ་འདི་བདག་ལ་ཆགས་འདུག་པས།",
      "chinese": "国王喜欢你。"
    },
    {
      "id": 51,
      "tibetan": "ཕོ་རབ་ཡོན་ཏན་དེ་ན་གདའ།",
      "chinese": "贤人学识在此。"
    },
    {
      "id": 52,
      "tibetan": "ཐ་མའི་ཡོན་ཏན་དེ་ན་གདའ།",
      "chinese": "终极的知识就在那儿。"
    },
    {
      "id": 53,
      "tibetan": "དེ་དག་ལ་བདེན་པ་འདུག་གམ།",
      "chinese": "那些是真的吗？"
    },
    {
      "id": 54,
      "tibetan": "མི་གདའ་འོ།",
      "chinese": "没有。"
    },
