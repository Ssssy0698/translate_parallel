{
  "leixing": "oral_amdo",
  "entries": [
    {
      "id": 1,
      "tibetan": "ཡོངས་སུ་ཟིལ་གནོན་སྲིད་པ་འདི་ནི་འདི་ཉིད་བདག་གི་གནས།",
      "chinese": "完全压倒一切的可能性在于此。"
    },
    {
      "id": 2,
      "tibetan": "ཉོན་མོངས་བཞིན་དུ་སྐྲ་བཅད་པ།",
      "chinese": "剪发如同剃去烦恼。"
    },
    {
      "id": 3,
      "tibetan": "དེར་ནི་དམ་པ་རྣམས་དག་གིས།",
      "chinese": "对此，贤人云云。"
    },
    {
      "id": 4,
      "tibetan": "རབ་ཏུ་སོང་སྟེ་ཉིན་བདུན་གྱིས།",
      "chinese": "七天后"
    },
    {
      "id": 5,
      "tibetan": "མྱ་ངན་དག་གིས་གཟིར་བས་བསམས།",
      "chinese": "想必悲伤的袭上心头。"
    },
    {
      "id": 6,
      "tibetan": "པྲ་ཏི་པྲཱ་ལཱ་པ་མུ་ཁ་རཱ་ཤྩ་ཀྲི་རེ་ནི་ཁི་ལཱ་དི་ཤ།",
      "chinese": "巴德.布拉巴姆卡拉·扎里尼.克拉迪夏"
    },
    {
      "id": 7,
      "tibetan": "ཨུད་ྦྷཱུ་ཏཱརྟྟ་སྭ་རེ་ཀཎྛེ་བསམས་ནས་རྟ་བཏང་སྟེ།",
      "chinese": "俄布达尔萨里坎迪想放马。"
    },
    {
      "id": 8,
      "tibetan": "བི་བྷབ་མ་བྷབ་བྲྀ་ཏྱེ་ཛནྨ་པྲ་མུཀྟྱེ་བི་ཛ་ན་མ་བི་ཛ་ནཱ་ནཱཾ་མོ་ཧ་གརྟྟཱ་ནི་བྲྀ་ཏྱེ།",
      "chinese": "婆婆娜娜，陀罗迦，塞那布迦，毁寐迦，毁娜娜迦，摩哈格达尼陀罗迦。"
    },
    {
      "id": 9,
      "tibetan": "བརྒྱ་བྱིན་དག་གིས་བྱིན་པ་བླངས།",
      "chinese": "天鹅接受了赠予。"
    },
    {
      "id": 10,
      "tibetan": "མཛེས་པའི་མིག་གི་འཁོར་ལོས་སྒྱུར་བའི་བདུད།",
      "chinese": "被美丽的眼睛所改变的魔鬼。"
    },
    {
      "id": 11,
      "tibetan": "གང་གིས་བཀའ་ཡི་ཡུལ་དུ་བསྒྱུར་བྱས་པ།",
      "chinese": "以何为命令。"
    },
    {
      "id": 12,
      "tibetan": "ཝཱ་རཱ་ཎ་སཱིར་རབ་ཏུ་སོང་།",
      "chinese": "去瓦尔纳萨"
    },
    {
      "id": 13,
      "tibetan": "ཨཱ་མོ་དེ་ནཱི་ནཱཾ་ཧྲྀ་ད་ཡེ་ས་དཱ་སཱུ་ཏྲ་བ་དཱ་སྠི་པའི་བུ་མོར་ནི།",
      "chinese": "阿姆迪那尼沙德耶撒达撒德比的女儿"
    },
    {
      "id": 14,
      "tibetan": "དེ་ཡིས་ས་བདག་ཟས་གཙང་གི།",
      "chinese": "它把地主的饭菜吃得精光。"
    },
    {
      "id": 15,
      "tibetan": "བྲམ་ཟེའི་སུ་རེ་ཤྭ་ར།",
      "chinese": "婆罗门的色瑞夏拉"
    },
    {
      "id": 16,
      "tibetan": "བདག་ལས་རེ་ཞིག་ཚངས་པ་འདི།",
      "chinese": "我有一点像这阉人。"
    },
    {
      "id": 17,
      "tibetan": "དེ་དག་གིས་ཀྱང་མཁར་གནས་སྨྲས།",
      "chinese": "他们也谈到城乡"
    },
    {
      "id": 18,
      "tibetan": "ཞེས་བརྗོད་དེ་དག་གིས་མ་བླངས།",
      "chinese": "但那些人不领情。"
    },
    {
      "id": 19,
      "tibetan": "དེས་འཕངས་ཀླུ་རྣམས་དག་གིས་ཐོབ།",
      "chinese": "它被投手接杀了。"
    },
    {
      "id": 20,
      "tibetan": "དེ་ལ་བུད་མེད་དཔལ་མོ་བཞིན།",
      "chinese": "它有女人般的"
    },
    {
      "id": 21,
      "tibetan": "འོ་ཐུག་བདུད་རྩིའི་ཆ་དག་གིས།",
      "chinese": "用上香酥的酥油茶。"
    },
    {
      "id": 22,
      "tibetan": "བསིལ་གྲིབ་མཆོག་ལྡན་ཤིང་དག་གིས།",
      "chinese": "一棵棵高大的树"
    },
    {
      "id": 23,
      "tibetan": "ཨ་ཧཾ་ཀཱ་ར་ཨི་བཱ་ཏྱུཙྩ་ཤི་རཱ་སོ་དྲིརྦྱགི་རྻཏ།",
      "chinese": "阿合嘎日合瓦提牙买提。"
    },
    {
      "id": 24,
      "tibetan": "བི་ཤྲཱིརྞྞ་བྷཱུ་དྷརེ་ཏ་སྨིནས་པྲ་ད་དྷྱོ་བི་ཥརྞྞ་དྷཱི།",
      "chinese": "比什帕布达摩达米尼迦巴达比亚比什帕"
    },
    {
      "id": 25,
      "tibetan": "ན་ཏྭ་ཡཱ་བི་ཧི་ཏཾ་ང་རྒྱལ་བཞིན་དུ་རྩེ་མོ་ནི།",
      "chinese": "娜塔莉·维赫登傲然地玩着"
    },
    {
      "id": 26,
      "tibetan": "ལས་འདི་བདག་གིས་ཅི་ཞིག་བྱས།",
      "chinese": "这件事你咋办的？"
    },
    {
      "id": 27,
      "tibetan": "དམ་པ་ཁྱོད་ཀྱིས་མི་སཱ་དྷོ་ཀརྨྨ་ཀིཉྩི་ད་སཱཾ་པྲ་ཏཾ།",
      "chinese": "圣人，你就是米撒多革马哥尼兹大撒巴旦。"
    },
    {
      "id": 28,
      "tibetan": "ར་ཎནྟཱི་ཀཱཾ་སྱ་པཱ་ཏྲཱི་བ་བྲོནྣ་ནཱ་མ་ན་ནཱ་གདན་ཞེས་བརྗོད་པར་སོང་།",
      "chinese": "去叫叫拉嘛呢达西瓦布龙娜玛娜娜垫子"
    },
    {
      "id": 29,
      "tibetan": "ཞབས་ནི་བཀོད་པས་གསེར་དག་གི།",
      "chinese": "下面是由金子制成的"
    },
    {
      "id": 30,
      "tibetan": "བུད་ྡྷོཏྤཱ་དཱཔྟ་དྲྀག་ྦྷཱུ་མེ་ཤཔྡ་མཱ་། ཞེས་ནེམས་ཞེས་ཀྱང་།",
      "chinese": "佛陀说："
    },
    {
      "id": 31,
      "tibetan": "ཐལ་མོ་སྦྱར་བྱས་རབ་སྨྲས་པ།",
      "chinese": "合掌祈祷。"
    },
    {
      "id": 32,
      "tibetan": "པདྨའི་སྤྱན་ལྡན་མཛེས་པ་ཁྱོད་ནི་ལང་ཚོ་དར་ལ་ནགས་ཚལ་འདིར།",
      "chinese": "莲花眼，美丽的你，正青春，正绿野。"
    },
    {
      "id": 33,
      "tibetan": "ཁྱོད་ནི་སྲིད་པའི་མཚོ་ལས་ལུས་ཅན་རྣམས་ཀྱི་བདེན་པའི་ཟམ་སྟེགས་འགྱུར།",
      "chinese": "你是世间所有人的真理桥梁。"
    },
    {
      "id": 34,
      "tibetan": "ལག་ལྡན་ཕྲུ་གུ་པདྨོ་ལ་དགའ་ལག་པྲཱི་ཏྱཱ་ཀ་རོ་ཏི་ཧ་རེ་ཀ་རཾ་སུ་ཁ་ཡ་ཏི་ཤི་ཁི་སྣིག་ྡྷཱ་ལཱ་སཾ་ཀ་ལཱ་པ་ཤི་ཁཱ་ནི་ལེ།",
      "chinese": "手持花朵的儿童喜欢手持布底加罗德哈瑞加糖果斯卡亚蒂西科尼格拉萨拉萨拉巴西卡尼勒。"
    },
    {
      "id": 35,
      "tibetan": "མིག་ཟུར་གཡོ་བའི་རི་དྭགསདགས་མོ་རྣམས་མདུན་དུ་གུས་པས་གྱེན་དུ་ཕྱོགས་པར་གྱུར།",
      "chinese": "眼里闪烁的野猫们恭敬地仰首。"
    },
    {
      "id": 36,
      "tibetan": "ཨ་དྱེ་བ་བུད་ྡྷཏྭ་མ་བཱ་སྱ་ཤུད་ྡྷཾ་ཏྭཾ་བོ་དྷི་ཡེ་ཥྱ་ཏྱ་ཁི་ལཱཾ་ཏྲི་ལོ་ཀིཾ།",
      "chinese": "阿迈哈达玛巴耶希德达玛·乌德耶·齐迪·克拉姆·德洛格。"
    },
    {
      "id": 37,
      "tibetan": "འཇིག་རྟེན་གསུམ་པོ་ཁྱོད་ཀྱིས་མ་ལུས་རྟོགས་པར་བགྱིད།",
      "chinese": "你要知道，整个三界都不在你身边。"
    },
    {
      "id": 38,
      "tibetan": "ཉིན་མོའི་མགོན་བཞིན་གཟི་བརྗིད་རབ་འབར་ཁྱོད་ཀྱི་སྣང་བས་འཕྲལ་ལ་ནཱ་ཏ་ལོ་ཀཱ་ནཱཾ་ཀ་མ་ལ་པྲ་བོ་དྷཀ་ལ་ཡཱ་དི་བྱ་པྲ་ཀཱ་ཤ་སྤྲྀ་ཤཱཾ།",
      "chinese": "日神，光荣的你，忽然，纳达罗贡嘎纳，嘎玛拉布布德嘎拉，雅迪，巴格沙，希希。"
    },
    {
      "id": 39,
      "tibetan": "ནཾ་རྻ་ཏྱ་ཧྲྀ་ད་ཡཱནྣི་བད་ྡྷམ་དྷུ་པ་ཤྲེ་བ་སཾ་བྷི་ཏ་ན་ཏྲ་སྟཱནྟརྣ་པུ་ན་ཀ་རི་ཥྱ་ཏི་བ་དཾ་མོ་ཧཱན་ྡྷཀཱ་ར་བ་ལི།",
      "chinese": "那萨迦施达颂印那比娃德玛德巴舍娃萨布达那达坦那布那伐那伐那伐那伐那伐那伃"
    },
    {
      "id": 40,
      "tibetan": "རབ་རྒྱས་པདྨ་ལྟ་བུས་མཆོག་གི་སྣང་བ་ལ་རེག་འཇིག་རྟེན་རྣམས་དག་གིས།",
      "chinese": "如如其表，好似莲花开了。"
    },
    {
      "id": 41,
      "tibetan": "རྩེ་མོ་གཡས་བསྟན་མལ་སྟན་བྱས།",
      "chinese": "用右边为上铺的枕头。"
    },
    {
      "id": 42,
      "tibetan": "ཐུན་མོང་མིན་པར་བཟོད་པའི་རྟེན།",
      "chinese": "独特的耐力。"
    },
    {
      "id": 43,
      "tibetan": "ཨ་ཏྲཱནྟ་རེ་ས་མ་བྷྱེ་ཏྱེ་མཱ་ར་སཾ་ཡ་མ་མཚ་ར།",
      "chinese": "阿尔达里萨马比蒂玛热玛亚马奇阿"
    },
    {
      "id": 44,
      "tibetan": "ཁྱོད་ཀྱི་བློ་ཡང་སུ་ཞིག་འདོད།",
      "chinese": "你以为你是谁啊？"
    },
    {
      "id": 45,
      "tibetan": "ཨ་ཤི་ཀྵི་ཏ་བི་ཀཱ་རེ་ཎ་ཙེ་ཏ་ས་བྱ་ཙིནྟ་ཡ་ཏ།",
      "chinese": "阿西·西塔维·卡日那孜·达萨·贾孜亚。"
    },
    {
      "id": 46,
      "tibetan": "ཁྱོད་ཀྱིས་གནོད་པར་ནུས་མ་ཡིན།",
      "chinese": "你不会被伤害的。"
    },
    {
      "id": 47,
      "tibetan": "འཚེ་བའི་མཆོད་སྦྱིན་གཅིག་གིས་ནི།",
      "chinese": "一份灾祸的祭祀。"
    },
    {
      "id": 48,
      "tibetan": "འདོད་པ་ཉིད་འདི་ཁྱོད་ཀྱིས་ཐོབ།",
      "chinese": "欲望本身就是你得到的"
    },
    {
      "id": 49,
      "tibetan": "རང་གི་ཡོན་ཏན་བསྒྲགས་ན་པུ་ཎྱ་པུཥྤ་ཧི་ཤཱིཪྵྱ་ཏེ།",
      "chinese": "宣扬自己的学问，犹如布尼婆婆吹熏火。"
    },
    {
      "id": 50,
      "tibetan": "ཁྲོ་བ་དང་བཅས་རབ་སོང་སྟེ།",
      "chinese": "怒气冲冲地走出去。"
    },
    {
      "id": 51,
      "tibetan": "གཡོ་བའི་བུང་བས་རཾ་གི་ནྱ་ཀཱནྟཱ་ཤྩཱུ་ཏ་ལ་ཏཱ་ཨི་བ།",
      "chinese": "摇动的蜂，吱吱地飞向甘达拉山。"
    },
