{
  "leixing": "oral_amdo",
  "entries": [
    {
      "id": 1,
      "tibetan": "ཡང་བསྐོར་ཕྱོགས་སུ་སོང་སྟེ།",
      "chinese": "转过身去。"
    },
    {
      "id": 2,
      "tibetan": "དེའི་རྗེས་ལ་དེ་བཞིན་དུ་མེའི་ཕྱོགས་སུ་སོང་སྟེ།",
      "chinese": "然后这样地向火走去。"
    },
    {
      "id": 3,
      "tibetan": "དེ་ནས་བདེན་བྲལ་གྱི་ཕྱོགས་སུ་སོང་ལ་ལྷན་ཅིག་བྱང་གི་མཚམས་ཀྱི་ཐིག་གདབ་བོ།",
      "chinese": "再向北方画一条线。"
    },
    {
      "id": 4,
      "tibetan": "དེ་ནས་བདེན་བྲལ་གྱི་ཕྱོགས་སུ་སོང་ལ།",
      "chinese": "然后走向真理。"
    },
    {
      "id": 5,
      "tibetan": "བསྐོར་ཕྱོགས་སུ་ནང་གི་འཁོར་ལོའི་ཐིག་གདབ་བོ།",
      "chinese": "旋转方向为内转的轴。"
    },
    {
      "id": 6,
      "tibetan": "ཡེ་ཤེས་ཀྱི་ཐིག་གི་ཆོ་གའི་རིམ་པའོ།",
      "chinese": "圣基的仪式的序列。"
    },
    {
      "id": 7,
      "tibetan": "དེ་ནས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པ་ལྔའི་ཁ་དོག་ཅན་གྱི་ཚོན་རྩི་མུ་ཏིག་གི་ཕྱེ་མ་ལ་སོགས་པའམ།",
      "chinese": "在此之后，色彩鲜艳的彩晶粉末，或者是宝石粉末，或者是宝石碎片。"
    },
    {
      "id": 8,
      "tibetan": "ཚོན་དེ་རེ་རེ་ཞིང་གཡོན་པའི་ཁུ་ཚུར་གྱིས་བླངས་ལ།",
      "chinese": "每一色都用左拳来取得。"
    },
    {
      "id": 9,
      "tibetan": "ནག་པོ་ཕན་ཚུན་མ་རེག་ཅིང་མ་ཡོ་བར་སློབ་དཔོན་གྱིས་དགྱེ་བར་བྱའོ།",
      "chinese": "黑色不相触不相倾，师以直而立。"
    },
    {
      "id": 10,
      "tibetan": "རི་མོའི་བློས་ནམ་མཁར་བཏེག་སྟེ།",
      "chinese": "画笔高悬云端。"
    },
    {
      "id": 11,
      "tibetan": "ཡིད་ཀྱིས་རི་མོ་བཏེག་ནས་ནི།",
      "chinese": "心中挂起图画。"
    },
    {
      "id": 12,
      "tibetan": "དེ་ཡང་དང་པོར་རེ་ཞིག་སློབ་དཔོན་གྱི་ཏིང་ངེ་འཛིན་གསུམ་གྱི་སྦྱོར་བ་དང་ལྡན་པས་རང་གི་རྡོ་རྗེ་དང་།",
      "chinese": "初学者应先修三种教授的定情术，以此修炼自己的金刚。"
    },
    {
      "id": 13,
      "tibetan": "ཆུ་སྐྱེས་ཡང་དག་པར་སྦྱོར་བའི་སྒྲས་ནམ་མཁའ་ལ་བཞུགས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་བློས་རང་གི་ནང་དུ་བཅུག་ནས་སླར་ཡང་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་ལྟ་བུར་རང་གི་ལུས་ལས་བྱུང་ནས་ནམ་མཁའ་ལ་ཁྱབ་པར་སྤྲོ་བར་བྱའོ།",
      "chinese": "以水母般的正确合体声，纳入上自在坐的菩萨，复从菩萨身中出，散布如轮回，遍于天空。"
    },
    {
      "id": 14,
      "tibetan": "ཧཱུྃ་གིས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་རང་རང་གི་མཚན་མར་གཞུག་པ་དང་།",
      "chinese": "以“哑”字在坛中央各插上自己的性别。"
    },
    {
      "id": 15,
      "tibetan": "དེ་བཞིན་དུ་བཾ་གིས་བརྟན་པར་བྱ་བ་དང་།",
      "chinese": "同样用钨固定"
    },
    {
      "id": 16,
      "tibetan": "རང་བཞིན་འོད་གསལ་མཆོག་གི་མཆོག།",
      "chinese": "本性光明之至。"
    },
    {
      "id": 17,
      "tibetan": "ཉེས་པ་མི་མངའ་རྟག་པ་ཁྱོད།",
      "chinese": "你这个无罪者！"
    },
    {
      "id": 18,
      "tibetan": "བདེན་པ་གང་གིས་ཡེ་ཤེས་མཆོག།",
      "chinese": "真理，何其高明。"
    },
    {
      "id": 19,
      "tibetan": "ཁྱོད་ཀྱི་འདོད་པ་རབ་རྫོགས་ཤོག།",
      "chinese": "你就尽情的去享受吧。"
    },
    {
      "id": 20,
      "tibetan": "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་བྱིན་གྱིས་རླབ་ཀྱི།",
      "chinese": "如今，你已是万古至圣。"
    },
    {
      "id": 21,
      "tibetan": "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རིགས་སུ་ཞུགས་ཀྱིས།",
      "chinese": "如今你已加入了所有的佛陀之中。"
    },
    {
      "id": 22,
      "tibetan": "ངས་ཁྱོད་ལ་ཡེ་ཤེས་གང་གིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དངོས་གྲུབ་ཀྱང་ཐོབ་ན།",
      "chinese": "我将赐给你一切佛祖的恩惠。"
    },
    {
      "id": 23,
      "tibetan": "ཁྱོད་ཀྱིས་དཀྱིལ་འཁོར་ཆེན་པོ་མ་མཐོང་བ་རྣམས་ལ་མ་སྨྲ་ཤིག།",
      "chinese": "你不要对见不得光的人说。"
    },
    {
      "id": 24,
      "tibetan": "དམ་ཚིག་ཉམས་པར་གྱུར་ཏ་རེ།",
      "chinese": "誓言破坏了!"
    },
    {
      "id": 25,
      "tibetan": "ཨོཾ་རྡོ་རྗེ་སེམས་དཔའ་དེང་ཁྱོད་ཀྱི།",
      "chinese": "唵唵如来，今时你。"
    },
    {
      "id": 26,
      "tibetan": "དེང་ཕྱིན་ཆད་ཁྱོད་ཀྱི་ཕྱག་ན་རྡོ་རྗེ་ང་ཡིན་གྱིས།",
      "chinese": "从今以后，你的右手就是我。"
    },
    {
      "id": 27,
      "tibetan": "ཁྱོད་ཀྱིས་ང་ལ་བརྙས་པར་མ་བྱེད་ཅིག།",
      "chinese": "你不要欺负我。"
    },
    {
      "id": 28,
      "tibetan": "དབུས་ན་ཡི་གེ་ཨ་གནས་པར་བསྒོམ་མོ།",
      "chinese": "想像中间有一个阿字。"
    },
    {
      "id": 29,
      "tibetan": "རྡོ་རྗེ་སེམས་དཔའ་དེང་ཁྱོད་ཀྱི།",
      "chinese": "观世音菩萨现在就是你的。"
    },
    {
      "id": 30,
      "tibetan": "རི་མོ་བྲིས་པའི་ཅོད་པན་དེ་མ་འབྱོར་ན་རས་ལས་བྱས་པ་དེའི་སྤྱི་བོར་བཞག་ལ།",
      "chinese": "如果没有画的头冠，就把布做的头冠戴在头上。"
    },
    {
      "id": 31,
      "tibetan": "དེ་རིང་ཁྱོད་ལ་བསྐུར་བར་གྱུར།",
      "chinese": "今天就给你发过去了。"
    },
    {
      "id": 32,
      "tibetan": "རྡོ་རྗེ་འདི་ནི་ཁྱོད་ཀྱིས་ལོང་།",
      "chinese": "这块宝石你得拿着。"
    },
    {
      "id": 33,
      "tibetan": "རང་གི་དངོས་ཀུན་གང་གང་སྣང་།",
      "chinese": "一切如自己的意愿。"
    },
    {
      "id": 34,
      "tibetan": "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་བཅང་།",
      "chinese": "你也要常带着它。"
    },
    {
      "id": 35,
      "tibetan": "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་བཅང་།",
      "chinese": "你也一直抱着"
    },
    {
      "id": 36,
      "tibetan": "འདི་ནི་ངས་ཁྱོད་ལུང་བསྟན་པ།",
      "chinese": "这是我给你预言的。"
    },
    {
      "id": 37,
      "tibetan": "སྲིད་པ་མཆོག་གི་སྒྲུབ་པའི་ཕྱིར།",
      "chinese": "因为世上无奇不有。"
    },
    {
      "id": 38,
      "tibetan": "ཀྱེ་དེ་བཞིན་གཤེགས་པ་རྡོ་རྗེ་ཆེ་གེ་མོ་ཞེས་བྱ་བ།",
      "chinese": "啊！啥叫啥叫金刚大士啊。"
    },
    {
      "id": 39,
      "tibetan": "དེ་ནས་དེར་ཚིགས་སུ་བཅད་པ་འདི་དག་གིས་དབུགས་དབྱུང་བ་སྦྱིན་པར་བྱ་སྟེ།",
      "chinese": "然后由这些诗句给与某种解脱。"
    },
    {
      "id": 40,
      "tibetan": "སླར་ཁྱོད་འཆི་བ་ཡོད་མིན་ཏེ།",
      "chinese": "是否有再一次让你死去的机会？"
    },
    {
      "id": 41,
      "tibetan": "སྲིད་པའི་སྡུག་བསྔལ་ལས་ཁྱོད་འདས།",
      "chinese": "世间的苦难你已经渡过。"
    },
    {
      "id": 42,
      "tibetan": "རྟག་ཏུ་ཁྱོད་ཀྱིས་བསྲུང་བར་བྱ།",
      "chinese": "总是你守护着我。"
    },
    {
      "id": 43,
      "tibetan": "རྗེས་མཐུན་ཁྱོད་ཀྱིས་སྦྱིན་པར་བྱ།",
      "chinese": "以后你给送过去吧。"
    },
    {
      "id": 44,
      "tibetan": "རྟག་ཏུ་རང་གི་དམ་ཚིག་བསྲུངས།",
      "chinese": "时刻遵守自己的诺言"
    },
    {
      "id": 45,
      "tibetan": "དེང་ཁྱོད་སྐྱེ་བ་འབྲས་བུར་བཅས།",
      "chinese": "你今生就已经是有成就了。"
    },
    {
      "id": 46,
      "tibetan": "དེང་ཁྱོད་གྱུར་པར་ཐེ་ཚོམ་མེད།",
      "chinese": "你肯定会成为现在的你。"
    },
    {
      "id": 47,
      "tibetan": "རང་གི་དམ་ཚིག་མི་ཟད་བདེ་བསྐྱེད་བརྟེན་པར་གྱིས།",
      "chinese": "要依靠自己的信念不生灭。"
    },
    {
      "id": 48,
      "tibetan": "རང་གི་ལྷ་ཡི་སྦྱོར་བ་ཡིས།",
      "chinese": "自有神的恩情。"
    },
    {
      "id": 49,
      "tibetan": "སྟེང་ནས་བླ་རེ་བྲེ་བ་དང་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པར་བྱའོ།",
      "chinese": "上面绣着龙凤宝座，装饰一新。"
    },
    {
      "id": 50,
      "tibetan": "དེ་དག་མ་འབྱོར་ན་སྣ་ཚོགས་པདྨ་འདབ་མ་བརྒྱད་པར་ཁྲིའུ་དང་སྟན་བཞག་ལ་རང་གི་ལྷའི་སྦྱོར་བ་དང་ལྡན་པར་བཞག་ལ།",
      "chinese": "若不能得到，则在八瓣莲花座上摆放供品和坐具，按照自己所供神的仪式。"
    },
    {
      "id": 51,
      "tibetan": "ཉོན་མོངས་ཐམས་ཅད་ངེས་གཅོད་ཅིང་།",
      "chinese": "断绝一切烦恼。"
    },
    {
      "id": 52,
      "tibetan": "ཉོན་མོངས་པ་ཡི་ཕྱེད་འཕྲོག་པ།",
      "chinese": "取走烦恼的一半。"
    },
    {
      "id": 53,
      "tibetan": "མེ་ནི་གོས་དཀར་མོ་རུ་བཤད།",
      "chinese": "火被称为白衣"
    },
    {
      "id": 54,
