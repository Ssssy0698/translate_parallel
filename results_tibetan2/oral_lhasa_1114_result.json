{
  "leixing": "oral_lhasa",
  "entries": [
    {
      "id": 1,
      "tibetan": "སྲོག་ནི་གཅད་པར་བྱ་བའོ།",
      "chinese": "要杀死他。"
    },
    {
      "id": 2,
      "tibetan": "གྲུ་གསུམ་དྲི་མེད་དག་པར་ནི།",
      "chinese": "无为三角形。"
    },
    {
      "id": 3,
      "tibetan": "བྷག་དཀྱིལ་འཁོར་ཡིན་པར་བཤད།",
      "chinese": "说是巴中圆。"
    },
    {
      "id": 4,
      "tibetan": "བྱེ་བྲག་བརྒྱད་དུ་གྱེས་པར་དྲན།",
      "chinese": "分为八个部分。"
    },
    {
      "id": 5,
      "tibetan": "བསྐོར་བ་བྱས་ནས་ངལ་སོ་སྟེ།",
      "chinese": "转动来休息。"
    },
    {
      "id": 6,
      "tibetan": "བསྲེག་རྫས་གང་བས་དབུལ་པར་བྱ།",
      "chinese": "烧完所有的燃料。"
    },
    {
      "id": 7,
      "tibetan": "མཁས་པས་བསྲེག་རྫས་སྦྱིན་པར་བྱ།",
      "chinese": "智者以烧物相济"
    },
    {
      "id": 8,
      "tibetan": "སྣང་བ་མཐའ་ཡས་ཁུ་པར་བརྗོད།",
      "chinese": "佛光普照西班牙"
    },
    {
      "id": 9,
      "tibetan": "རྣམ་པར་སྣང་མཛད་དྲི་ཆེན་བཤད།",
      "chinese": "说了大慈大悲的佛。"
    },
    {
      "id": 10,
      "tibetan": "དེ་ལྟར་མཁས་པས་ཁང་པར་བྱ།",
      "chinese": "这样，能使屋子变得精巧。"
    },
    {
      "id": 11,
      "tibetan": "ལེགས་དགྱེས་རིངས་པར་གཡོ་བ་དང་།",
      "chinese": "昂首挺胸，"
    },
    {
      "id": 12,
      "tibetan": "གང་ཚེ་ཟླ་མཚན་འབྱུང་པར་འགྱུར།",
      "chinese": "只要月经来了"
    },
    {
      "id": 13,
      "tibetan": "ཞག་བདུན་པར་དུ་བླང་པར་བ།",
      "chinese": "七夜接收。"
    },
    {
      "id": 14,
      "tibetan": "བསྲུབ་ཐབས་ཆེན་པོ་དཔྱད་པར་བྱ།",
      "chinese": "试用大火熬制。"
    },
    {
      "id": 15,
      "tibetan": "པདྨའི་སྣོད་དུ་གཞག་པར་བྱ།",
      "chinese": "放在莲花盘中。"
    },
    {
      "id": 16,
      "tibetan": "ཞག་པར་བྱ།",
      "chinese": "过夜。"
    },
    {
      "id": 17,
      "tibetan": "ཅུང་ཟད་འབད་དེ་ག་རིམ་པར་ཆེ་བར་བྱ།",
      "chinese": "要努力做到一分为上"
    },
    {
      "id": 18,
      "tibetan": "བདུག་པ་བྱས་པར་གཞག་པར་བྱ།",
      "chinese": "做做香烟"
    },
    {
      "id": 19,
      "tibetan": "ཉི་མ་བདུན་དུ་བདུག་པར་བྱ།",
      "chinese": "熏七天。"
    },
    {
      "id": 20,
      "tibetan": "རིམ་པས་ཆ་བར་བླུག་པར་བྱ།",
      "chinese": "逐步灌进孔中。"
    },
    {
      "id": 21,
      "tibetan": "མེ་ནི་འཇམ་པར་སྨིན་པ་ཡིས།",
      "chinese": "火已经烧的很旺了。"
    },
    {
      "id": 22,
      "tibetan": "རྡོ་ཡི་སྣོད་དུ་གཞག་པར་བྱ།",
      "chinese": "放在石缸中。"
    },
    {
      "id": 23,
      "tibetan": "སྐྱུ་རུ་ར་ཙམ་དུ་བྱས་ཏེ།",
      "chinese": "作为橄榄。"
    },
    {
      "id": 24,
      "tibetan": "གྲིབ་མ་ལ་ནི་བསྐམ་པར་བྱ།",
      "chinese": "阴影里是干燥的。"
    },
    {
      "id": 25,
      "tibetan": "རས་དང་ཡན་ལག་བཀྲུ་བྱས་ནས།",
      "chinese": "用布或毛巾擦洗"
    },
    {
      "id": 26,
      "tibetan": "འབད་དེ་ཁ་ལ་གཞག་པར་བྱ།",
      "chinese": "努力把它记住。"
    },
    {
      "id": 27,
      "tibetan": "ཐེ་ཚོམ་མེད་པར་འགྲུབ་པར་འགྱུར།",
      "chinese": "就能毫无疑问地完成。"
    },
    {
      "id": 28,
      "tibetan": "ཨོོ་རྒྱན་གནས་ལ་སོགས་པར་ནི།",
      "chinese": "在佛教的神圣圣地。"
    },
    {
      "id": 29,
      "tibetan": "མ་ལ་ཨ་ཙ་འདུས་པར་དྲན།",
      "chinese": "我记得有马拉他妈的酸奶。"
    },
    {
      "id": 30,
      "tibetan": "དུ་དུར་སྐལ་ལྡན་མིན་པར་བཤད།",
      "chinese": "不算是得福土。"
    },
    {
      "id": 31,
      "tibetan": "དྲི་ཆེན་བཞི་མཉམ་ཡིན་པར་བསྟན།",
      "chinese": "四大化粪。"
    },
    {
      "id": 32,
      "tibetan": "ཧོ་ཞེས་བྱ་བ་འགྲངས་པར་བཤད།",
      "chinese": "“噢，好饱啦。”"
    },
    {
      "id": 33,
      "tibetan": "བཟའ་བ་དུད་དུ་ཤེས་པར་བྱ།",
      "chinese": "应该知道夫妻之间"
    },
    {
      "id": 34,
      "tibetan": "མིག་ནི་ཨུཏྤལ་ཤེས་པར་བྱ།",
      "chinese": "眼睛要当知觉的知觉。"
    },
    {
      "id": 35,
      "tibetan": "ལག་བ་མཚོ་སྐྱེས་བསྟན་པར་གྲགས།",
      "chinese": "手掌海生称为手掌海生。"
    },
    {
      "id": 36,
      "tibetan": "དབུས་ནི་རི་འབྱུང་ཤེས་པར་བྱ།",
      "chinese": "中是知山出"
    },
    {
      "id": 37,
      "tibetan": "རྒན་པོ་རྒྱ་མཚོ་ཞེས་པར་དྲན།",
      "chinese": "想起了老人家嘉措"
    },
    {
      "id": 38,
      "tibetan": "གར་ནི་གྲོགས་པོ་ཞེས་པར་དྲན།",
      "chinese": "戏叫做朋友"
    },
    {
      "id": 39,
      "tibetan": "ཤེས་པ་སྤང་པར་གེས་པར་བྱ།",
      "chinese": "用知来除知。"
    },
    {
      "id": 40,
      "tibetan": "རྒོད་པ་ཞེས་བྱ་བྱིས་པར་བསྟན།",
      "chinese": "指小孩子。"
    },
    {
      "id": 41,
      "tibetan": "མཚམས་ནི་དུད་མེད་ཤེས་པར་བྱ།",
      "chinese": "注意不要吸入二手烟"
    },
    {
      "id": 42,
      "tibetan": "ལེགས་པར་བསྙུན་ལན་ལྗོན་པ་ཡིན།",
      "chinese": "回报有加。"
    },
    {
      "id": 43,
      "tibetan": "དེ་ལ་སྲིན་ལག་བསྟན་པར་བྱ།",
      "chinese": "指出它。"
    },
    {
      "id": 44,
      "tibetan": "དེ་ལ་ལྕེ་ནི་བསྟན་པར་བྱ།",
      "chinese": "让舌头伸出来"
    },
    {
      "id": 45,
      "tibetan": "དེ་ལ་རྩེ་གསུམ་བསྟན་པར་བྱ།",
      "chinese": "让它三尖"
    },
    {
      "id": 46,
      "tibetan": "དེ་ལ་མཚོག་མ་བསྟན་པར་བྱ།",
      "chinese": "让它有个交代"
    },
    {
      "id": 47,
      "tibetan": "དེ་ལ་མཁུར་ཚོས་བསྟན་པར་བྱ།",
      "chinese": "给它指出脸颊。"
    },
    {
      "id": 48,
      "tibetan": "དེ་ལ་ས་གཞི་བསྟན་པར་བྱ།",
      "chinese": "指出它的位置。"
    },
    {
      "id": 49,
      "tibetan": "དེ་ལ་ལག་ངར་བསྟན་པར་བྱ།",
      "chinese": "请把它指出来"
    },
    {
      "id": 50,
      "tibetan": "དེ་ལ་ལྟོ་བ་བསྟན་པར་བྱ།",
      "chinese": "向它展示腹部"
    },
    {
      "id": 51,
      "tibetan": "དེ་ལ་ཀོས་ཀོ་བསྟན་པར་བྱ།",
      "chinese": "请给我看下皮革。"
    },
    {
      "id": 52,
      "tibetan": "དེ་ལ་ལྕི་ནི་བསྟན་པར་བྱ།",
      "chinese": "请给我看它的重量。"
    },
    {
      "id": 53,
      "tibetan": "དེ་ལ་ཀོས་ཁུར་བསྟན་པར་བྱ།",
      "chinese": "对此，顾尔丹巴指出。"
    },
    {
      "id": 54,
      "tibetan": "དེ་ལ་ལྟོ་བ་བསྟན་པར་བྱ།",
      "chinese": "叫它露肚子"
    },
    {
      "id": 55,
      "tibetan": "དེ་ལ་ལིང་ག་བསྟན་པར་བྱ།",
      "chinese": "给它装上朗嘎"
    },
    {
      "id": 56,
      "tibetan": "དེ་ལ་གཞང་ནི་བསྟན་པར་བྱ།",
      "chinese": "对此应指出，"
    },
    {
      "id": 57,
      "tibetan": "དེ་ལ་རྐང་མ་ཐིལ་བསྟན་པར་བྱ།",
      "chinese": "让它露脚趾。"
    },
    {
      "id": 58,
      "tibetan": "གང་ཞིག་གཙང་པོ་སྟོན་བྱེད་པ།",
      "chinese": "指哪个河。"
    },
    {
      "id": 59,
      "tibetan": "དེ་ལ་རྒྱ་མཚོ་བསྟན་པར་བྱ།",
      "chinese": "指出大海"
    },
    {
      "id": 60,
      "tibetan": "དེ་ལ་ཉི་མ་བསྟན་པར་བྱ།",
      "chinese": "让它见太阳"
    }
  ],
  "统计信息": {
    "总条数": 60,
    "最后更新": "2026-01-01 05:42:25"
  }
}