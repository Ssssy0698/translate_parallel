    "གཞན་གསུམ་ལ་བརྒྱད་ཁྲི་རེ་དང་།",
    "དགེ་རྒྱས་པའི་དྲུག་ཅུ་རེ་བཞི་དང་།",
    "དེ་ཉིས་འགྱུར་ལས་སྤྲིན་མེད་པའི་དཔག་ཚད་གསུམ་དོར་བས་བརྒྱ་ཉེར་ལྔ་ནས་འོག་མིན་པའི་ཁྲི་དྲུག་སྟོང་གི་བར་རོ།",
    "སྤྱིར་བོང་ཚོད་ཐ་དད་པ་རྣམས་ཀྱི་ཚེ་ཚད་ཀྱང་ཐ་དད་དམ་ཞེ་ན།",
    "གཉིད་སངས་ཕྲོ་ལས་ཏེ་སྣང་བའི་བྱ་བ་ནི་རང་གི་འོད་ཀྱིས་སོ།",
    "ཚེའི་ཚད་ནི་ལོས་མི་བགྲང་གི་རང་གི་ལུས་གཞལ་བའི་དཔག་ཚད་ཀྱི་གྲངས་ཀྱི་བསྐལ་པ་ཡིས་ཏེ།",
    "གོང་མ་གསུམ་ཉི་ཤུ་རེས་ལྷག་གོ།",
    "ཡང་སོས་སོགས་དྲུག་གིས་རིམ་པ་བཞིན་འདོད་ལྷའི་ཚེ་དང་ཉིན་ཞག་མཉམ་ལ།",
    "མིང་གི་མཐའ་ཡི་གེ་དང་།",
    "སོར་མོ་ཉི་ཤུ་རྩ་བཞི་ལ་ཁྲུ་དང་།",
    "ཉི་མ་གཞན་རྣམས་འདི་བས་བཞི་འགྱུར་རེས་ཚ་ཞིང་།",
    "དེའི་ཚེ་འོད་གསལ་བའི་ལྷ་གཞོན་པ་རྣམས་མེ་དེ་བྱུང་གི་དོགས་ནས་སྐྲག་པ་ལ།",
    "འཇིག་རྟེན་གྱི་ཁམས་གཞན་ནས་ས་བོན་ཁྱེར་ཏེ་འོང་ངོ་ཞེས་འབྱུང་མོད།",
    "ཚེ་ལོ་དཔག་མེད་ནས་འགྲིབ་པ་རྩོམ་པ་དུས་མཉམ་མོ།",
    "ངག་གི་བཞི་སྤངས་པས་ཉིས་སྟོང་པ་དང་།",
    "ཐོག་མཐའི་རྐྱང་པ་དང་བར་གྱི་ཁུག་པ་རེ་དུས་མཉམ་ལ།",
    "ལོ་ཇི་སྙེད་རེ་ལ་འཕེལ་འགྲིབ་བྱེད་ཅེ་ན།",
    "དགེ་སྡིག་སྤྱོད་པ་སྟོབས་ཆེ་ཆུང་གིས་ལོ་འཕེལ་འགྲིབ་སྟོབས།",
    "གནས་བསྐལ་གྱི་དུས་དེ་དང་ཆགས་པ་དང་འཇིག་པ་དང་ཞིག་ཅིང་སྟོངས་ནས་འདུག་པ་གསུམ་དུས་བར་བསྐལ་ཉི་ཤུར་མཉམ་མོ།",
    "སྔ་མའི་བསྐལ་པ་ཕྱི་མའི་ཞག་རེར་བཀའ་སྩལ་ཏོ།",
    "ཐེག་ཆེན་པས་མོས་སྤྱོད་དང་མ་དག་ས་བདུན་དང་དག་པ་ས་གསུམ་དུ་རྫོགས་པར་འདོད་དོ།",
    "མཐེ་བོང་གི་ཚད་ཙམ་གྱི་མི་རྣམས་ཀྱི་ནང་དུ།",
    "རང་རྒྱལ་དུས་གང་གི་ཚེ་འབྱུང་ཞེ་ན།",
    "མཆོག་གི་རིན་ཆེན་སྣ་བདུན་ནི།",
    "ཤར་ཕྱོགས་ནས་ལྷའི་འཁོར་ལོ་བརྒྱ་བྱིན་གྱི་ཚིག་གིས་ལས་ཐམས་ཅད་པས་བྱས་པ་རྒྱལ་པོ་ཆེན་པོ་བཞིས་རྒྱལ་པོ་ལ་བརྟན་པར་འགྱུར་རོ།",
    "ནམ་མཁའ་ལ་དཔག་ཚད་འབུམ་དུ་ཉི་མ་གཅིག་གིས་འགྲོ་བ།",
    "བཙུན་མོ་ནི་ལུས་ལ་ཙན་དན་དང་།",
    "རེག་ན་ཉོན་མོངས་པ་མེད་པ་བཀྲེས་སྐོམ་དང་མྱ་ངན་སེལ་བ།",
    "གླང་པོ་ཆེ་ནི་ཅང་ཤེས་ཤིང་བཀའ་ཉན་པས་ཕ་རོལ་ལས་རྒྱལ་བར་བྱེད་པ་གླང་པོ་ཆེ་སྟོང་གི་སྟོབས་ཡོད་པ་ཆུ་དང་སྐམས་ས་དང་བར་སྣང་གསུམ་ལ་གཡུལ་འགྱེད་པ།",
    "གདགས་པར་ནུབ་ཕྱོགས་ཀྱི་གླིང་ཕྲན་ཁམ་བུ་ཅན་ན་རྟའི་རྒྱལ་པོ་སྟོང་གིས་བསྐོར་བ་ཡོད་པ་ལ།",
    "བློན་པོ་ནི་དཔུང་གི་སྤྱན་ལྟ་བུའོ།",
    "རལ་གྲི་ནི་རྒྱལ་པོ་དང་འགལ་བ་བྱེད་འདོད་པ་དེར་སོང་སྟེ།",
    "ཚལ་གྱིས་མཐུས་ལྷའི་བུ་མོ་དང་བྱ་ལ་སོགས་པ་འོངས་ཏེ་འདོད་ཡོན་ལ་སྤྱོད་པའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་མི་སྐྱེ་བའོ།",
    "མི་སྟོང་རེ་ཐུབ་པའི་བུ་སྟོང་དང་དགྲ་ཟིལ་གྱིས་གནོན་པའི་མདའ་གཞུ་འབྱུང་ངོ།",
    "ཟངས་ཀྱི་འཁོར་ལོ་ཅན་ནི་སོང་སྟེ་གཡུལ་བཤམས་པས་འདུད།",
    "ལྕགས་ཀྱི་འཁོར་ལོ་ཅན་ནི་སོང་སྟེ་མཚོན་བསྣུན་པར་བརྩམས་པས་རྒྱལ་བར་བྱེད་དོ།",
    "ལྷའི་བུ་ཉི་ཟླ་གཉིས་ནི་རི་རབ་ཀྱི་ལྷོའམ་བྱང་གི་ངོས་གང་དུ་སོང་བ་མཐོང་བ་དེར་ཕྱིན་ཏེ་འཇིག་གོ།",
    "ནུབ་ཟ་ན་ནུབ་ལེན་པ་ན་གཅིག་གིས་ལེ་ལོས་གསོག་འཇོག་བྱས་པ་ལྟར་ཀུན་གྱིས་བྱས་པས་བརྔས་པ་མི་སྐྱེའོ།",
    "དེ་ནས་ཞིང་རྣམས་བགོས་ཏེ་རང་གི་ལ་བདག་གིར་འཛིན་པ་དང་བཅས་ནས་གཞན་གྱིས་དེ་ལ་རྐུའོ།",
    "དེ་བསྲུང་བའི་ཆེད་དུ་འདུས་ནས་དེ་རྣམས་ཀྱི་མི་ཁྱད་པར་ཅན་ཞིག་ཞིང་དཔོན་དུ་བསྐོས་ནས་རང་རང་གི་སྟོན་ཐོག་གི་དྲུག་ཆ་བསྟབས་ཏེ།",
    "དེ་ནས་ཕྱིས་རྒྱལ་པོ་གང་རུང་ཞིག་གིས་རྐུན་པོ་རྣམས་གསོད་ཅིང་དེར་བདག་གི་མ་རྐུ་ཞེས་རྫུན་སྨྲའོ།",
    "མུ་གེ་དེ་གཉིས་དང་ལོ་བདུན་ཚན་རེ་དག་འབྱུང་སྟེ།",
    "སོགས་པས་གསུམ་པ་དང་བཞི་པ་ནི་འཇིག་པ་དེ་དག་གིས་རྩེ་མོ་སྟེ་ལྷག་མ་ཡིན་ཏེ་གོ་རིམ་བཞིན་ནོ།",
    "འཇིག་པ་དེ་གསུམ་མེད་དེ་ནང་གི་སྐྱོན་དང་བྲལ་བས་མི་གཡོ་བའི་ཕྱིར་ཏེ།",
    "བསྐལ་ཆེན་རེ་བཞི་ནི་དགེ་རྒྱས་ཀྱི་ལྷའི་ཚེ་ཚད་དོ།",
    "དེ་ཡང་རེ་གསུམ་དང་ང་རྒྱལ་ལ་དེར་ཉེ་བས་བཏགས་པ་སྟེ་སྣོད་ཆགས་འཇིག་གི་བར་བསྐལ་གཉིས་དང་སྟོང་པའི་ཉི་ཤུ་དེའི་ཚེ་ཚད་དུ་མི་རུང་བས་སོ།",
    "ཚངས་པ་ཆེན་པོའི་ཡང་སྣོད་ཆགས་འཇིག་གི་བར་བསྐལ་གཉིས་དེའི་ཚེའི་ཚད་དུ་མི་རུང་བས་བར་བསྐལ་ང་བརྒྱད་ལ་དྲུག་ཅུར་བཏགས་པའོ།",
    "སེམས་པ་དེ་བསྐྱེད་པའི་བསམ་པའི་ལས་ནི་ལུས་དང་ངག་གི་ལས་སོ།",
    "ལུས་ལ་བརྟེན་པ་དག་གིས་ལས་དང་།",
    "དུས་ཀྱི་ཀུན་སློང་གི་སེམས་པ་ལ་བཞག་དགོས་ལ།",
    "ལུས་དང་ངག་གི་ལས་དེ་དག་ལ་རྣམ་རིག་དང་རྣམ་རིག་མིན་པ་གཉིས་གཉིས་སོ།",
    "རིག་བྱེད་མ་ཡིན་པའི་རྣམ་བཞག་གི་རང་བཞིན་ནོ།",
    "ལུས་ཀྱི་དབྱིབས་ཡུལ་གང་དུ་སྔར་སྐྱེས་པ་དེ་ཉིད་མ་ཞིག་པར་གཞན་དུ་འགྲོ་བ་མིན་པར་ཐལ།",
    "དེ་ཡང་གང་གི་ཕྱིར་ན་སྐད་ཅིག་ཡིན་པའི་ཕྱིར།",
    "མེས་བུད་ཤིང་འཇིག་ཅེས་པའི་དོན་ཅི་ལྟ་བུ་ཞིག་ལ་འདོད་ཅེས་དྲིས་པ་ན།",
    "ཕྱིས་བུམ་པ་འཇིག་པ་པོར་གྱུར་པ་ཐལ།",
    "བུམ་པའི་སྔར་གྱི་ཁ་དོག་གི་རྒྱུ་གཞན་དང་།",
    "ཁ་དོག་གི་གནས་སྐབས་ཚུལ་ལ་འདོགས་པས་སོ།",
    "མིག་གི་ཡུལ་ཡིན་པའི་ཕྱིར།",
    "མིག་གིས་མཐོང་བ་ན་གྲུ་བཞི་སོགས་ཀྱི་བློ་སྐྱེ་བའི་ཕྱིར།",
    "ལུས་ཀྱིས་རེག་པ་ན་ཡང་གྲུ་བཞི་སོགས་ཀྱི་བློ་སྐྱེ་བའི་ཕྱིར།",
    "སྐྱེས་བུ་འགྲོའོ་སྙམ་པའི་བློ་སྐྱེས་པ་ཡིན་ཏེ་འགྲོ་བཞིན་པ་ཡིན་པའི་ཕྱིར་ཞེས་སོགས་རང་གི་ཀུན་སློང་གཞན་ལ་རིག་པར་བྱེད་པས་རིག་བྱེད་དོ།",
    "ངག་གི་རྣམ་པར་རིག་བྱེད་ནི་ངག་གི་རང་བཞིན་གྱི་སྒྲ་སྟེ།",
    "རང་གི་ཀུན་སློང་རིག་པར་བྱེད་པའོ།",
    "ཡིད་ཉོན་མོངས་ཅན་གྱི་ཚེ་སོ་ཐར་གྱི་སྡོམ་པ་ཡོད་པ་ཡང་སྔོན་གོམས་པའི་དྲན་པའི་སྟོབས་ཀྱི་གཉེན་པོ་མངོན་དུ་གྱུར་པ་དང་ཆུའི་ཆུ་ལོན་ལྟར་གསུངས་པ་ཡང་ངོ་ཚ་ཤེས་པས་དམ་བཅས་པ་དྲན་ནས་འཆལ་ཚུལ་ལ་མི་འཇུག་པ་ལ་དགོངས་སོ།",
    "གཟུགས་མེད་ན་གཟུགས་མེད་པས་ལུས་ངག་གི་སྡོམ་པའི་ངོ་བོ་མེད་ཅིང་ཐོབ་པ་ནི་ཡོད་དོ།",
    "གང་གི་ཕྱིར་ན་ཀུན་སློང་མེད་པའི་ཕྱིར་ཏེ།",
    "འདོད་པ་ན་སྒོམ་སྤང་གི་བསྒྲིབས་ལ་ལུང་མ་བསྟན་གྱི་སེམས་མེད་པའི་ཕྱིར།",
    "གལ་ཏེ་འདོད་པའི་མཐོང་སྤང་གི་སློང་བར་བྱེད་དོ་སྙམ་ན།",
    "ཚངས་ཆེན་ན་གཡོས་ཀུན་ནས་བསླངས་པའི་ངག་གི་ལས་ཡོད་པས་སོ།",
    "དེས་ཀུན་ནས་བསླངས་པ་ནི་ཀུན་སློང་གི་ལུང་མ་བསྟན་ཏོ།",
    "དེ་ཡང་རབ་ཏུ་འཇུག་བྱེད་དགེ་སོགས་གསུམ་པོ་རེ་རེ་ལ་རྗེས་སུ་འཇུག་བྱེད་དགེ་སོགས་རྣམ་པ་གསུམ་གསུམ་དུ་འགྱུར་བས་དགུ་ཕྲུགས་སུ་འགྱུར་ཏེ།",
    "མུ་བཞི་པ་ནི་རྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པའི་སེམས་སྒོམ་སྤང་གི་ཆ་ནི་རབ་ཏུ་འཇུག་བྱེད་དང་།",
    "དེ་གཉིས་ལས་གཞན་ཕན་གནོད་ཕྱོགས་རེ་བ་བར་མའོ།",
    "ཐམས་ཅད་ཐུན་མོང་དུ་བསྟན་པའོ།",
    "བརྒྱད་པོ་དེ་དག་ཀྱང་མིང་གི་སྒོ་ནས་ཐ་དད་དུ་ཕྱེ་ཡི་རྫས་སུ་རྣམ་པ་བཞིར་འདུས་པ་ཡིན་ཏེ།",
    "ཕོ་མོའི་མཚན་ཕན་ཚུན་དུ་གྱུར་པ་ལས་མིང་ཙམ་འཕོ་ཡི།",
    "གང་གིས་སྡོམ་པ་གསུམ་རིམ་གྱིས་བླངས་པ་ན་སོ་སོའི་སྤོང་བ་རྣམས་ཆ་ཐ་དད་པ་ཁོ་ནར་སྐྱེའམ་ཞེ་ན་སོ་སོའི་སྲོག་གཅོད་སྤོང་བ་སོགས་ཆ་ཐ་དད་པ་གསུམ་གསུམ་དུ་སྐྱེས་ཏེ།",
    "དགེ་སློང་གི་བསླབ་པ་ཉིས་བརྒྱ་དང་ང་གསུམ་ནི།",
    "བསྙེན་གནས་ནས་དགེ་སློང་གི་བར་བརྒྱད་དོ།",
    "འཆལ་ཚུལ་དང་དེའི་ཀུན་སློང་སེམས་ཀྱི་རྗེས་འབྲང་ཉོན་མོངས་པ་རྣམས་དངོས་སུ་སྤོང་བས་སོ།",
    "རྒྱུ་གང་གིས་གཏོང་བ།",
    "སྐད་ཅིག་དང་པོ་ཕྱིན་ཆད་མ་བཏང་གི་བར་དུ་འདས་པ་དང་ཡང་ལྡན་ནོ།",
    "རིམ་བཞིན་ཇི་སྲིད་དུ་རབ་ཏུ་དང་བ་དང་ཉོན་མོངས་ཀྱི་ཤུགས་ལྡན་པ་དེ་སྲིད་ཀྱི་བར་དུ་རྟག་ཏུ་ད་ལྟར་བ་དང་།",
    "འདི་ཡང་སྐད་ཅིག་དང་པོ་ཕྱིན་ཆད་ཇི་སྲིད་མ་བཏང་གི་བར་དུ་འདས་པ་དང་ཡང་ལྡན་ལ་མ་འོངས་པའི་རིག་བྱེད་དང་ལྡན་པ་མེད་དེ།",
    "ཀུན་སློང་གིས་མ་འོངས་པའི་རིག་བྱེད་ཀྱི་ཐོབ་པ་འདྲེན་མི་ནུས་པས་སོ།",
    "སྡོམ་པ་མ་ཡིན་པའི་མིང་གི་རྣམ་གྲངས་ཏེ།",
    "ལུས་ངག་གི་ལས་ཡིན་པས་ལས་དང་།",
    "བཞི་པ་དེ་དག་གི་མུ་བཞི་དཔྱད་པ་ལ།",
    "ཟག་མེད་ཀྱི་བསམ་གཏན་ས་དྲུག་གི་སེམས་ཐོབ་པ་དེས་འཐོབ་བོ།",
    "དུས་ཀྱི་མཐའ་ནི་སྲོག་དང་ཉིན་ཞག་གི་མཐའ་གཉིས་ཡིན་པས་སོ།",
    "ལུས་ངག་གི་བྱ་བ་ལོག་པར་ཞུགས་པའི་རྒྱུས་ཐོབ་པས་ཇི་སྲིད་འཚོ་བའི་རིགས་ཡིན་ལ།",
    "གྲག་ཅེས་པ་ཟུར་ཟ་བ་སྟེ་དུས་རེ་ཞིག་པ་ཡང་ཡོད་པར་སྟོན་པའོ།",
    "དམའ་བར་འདུག་ཅིང་ཐལ་མོ་སྦྱར་ཏེ་འབོགས་པ་པོས་སྨྲས་པའི་རྗེས་སུ་བཟླས་པ་ཡིས།",
    "གང་གིས་ཚེས་བརྒྱད་ལ་རྟག་ཏུ་བསྙེན་གནས་བསྲུང་བའི་ངེས་པ་བྱ་བ་དེས་ནི་ཟས་ཟོས་ཀྱང་གཞན་ལས་ནོད་པར་བྱ་སྟེ།",
    "གནས་འཇོག་གིས་ཞུས་པར།",
    "ཁྱིམ་པའི་སྡོམ་པ་རང་གིས་ཀྱང་ལེན་པར་གསུངས་སོ།",
    "ལུང་གི་དོན་བཤད།",
    "སྡོམ་པ་ཆེ་ཆུང་གི་ཁྱད་པར།"
  ]
}