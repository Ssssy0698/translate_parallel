    "ལས་འཕྲོ་གླིང་བ་སོགས་གླིང་བའི་མཚན་ཅན་མང་དུ་འདུག་ལ།",
    "བློས་ཀྱང་འཆུན་དཀའ་བའི་ཚོད་དུ་འདུག་པས་སུས་ཀྱང་གྲངས་མཐའ་འདི་ཙམ་ཞེས་བརྗོད་མ་མྱོང་ཞིང་།",
    "བསྟན་བཅོས་དང་བསྟན་འཛིན་གྱི་སྐྱེས་བུ་ཉིས་ཆར་ནས་གྲ་མ་ཉམས་པར་ཡོད་པ་གསུམ་གྱིས་དེའི་དུས་གྱི་གསང་སྔགས་འཆལ་འཆོལ་དུ་འདུག་ཟེར་ན་ཡིད་ཆེས་རྣལ་མ་ཞིག་སྐྱེ་དཀའ།",
    "གཡུང་དྲུང་དུ་བཏོན་ཏོ་ཞེས་པ་གཉིས་ཀྱི་དོན་ཁོ་ནར་འདུག་པས་སུས་ཀྱང་ཡིད་མི་ཆེས་རང་ཆེས་སུ་གྱུར་འགྲོ།",
    "ཅང་མི་སྨྲ་བར་འདུག་པ་ཞེས་པ་དང་།",
    "ཕྱི་རྒོལ་ལམ་དམ་བཅའ་བ་གྲལ་མགོ་རུ་ཁ་མར་འཁོར་ཏེ་སྐྱིལ་ཀྲུང་དུ་འདུག་པ་དང་།",
    "དམ་བཅའ་བས་ལུས་དྲང་བོར་འདུག་ཅིང་ལག་པ་གཡས་གཡོན་གང་རུང་སྐེད་པར་འཇོག་པའམ།",
    "འཁོར་གསུམ་ཞེས་པའི་དོན་ནི་རྟགས་གསལ་རྩོད་གཞི་གསུམ་གའི་སྟེང་དུ་མགོ་འཁོར་འདུག་ཅེས་པའི་དོན་ཡིན་ལ།",
    "བྲང་དང་ཧ་ཅང་ཉེ་བ་གུམ་གུམ་པོར་འདུག་པ་ལྟ་བུ་མིན་པ།",
    "ཁོང་རང་ཉིད་ཀྱི་བློ་གྲོས་ཀྱི་རྩལ་ཤིན་ཏུ་རྫོགས་པ་དང་།",
    "ཇི་ལྟར་ན་རྣམ་པ་རིགས་པའི་འཕྲུལ་ཆེ་བ་ཞིག་འདུག་པས་ན།",
    "གང་ཕྱིར་དངོས་གང་རང་བཞིན་གྱིས།",
    "རང་རང་དངོས་པོ་ལ་གནས་ཕྱིར།",
    "དྲུག་དང་ཕྱེད་ཅེས་པར་ས་པཎ་གྱིས་ཀྱང་ཞིབ་ཆ་མ་ཐོན་པའི་གོ་འཛོལ་ཆེན་པོ་བྱུང་འདུག་གོ།",
    "དེའི་ཕྱིས་སུ་བྱུང་བའི་བསྡུས་གཞུང་རྣམས་ལས་གྲགས་ཆེ་བའི་གཞུང་འགའ་ཞིག་དུས་ཀྱི་སྔ་ཕྱིའི་བྱུང་རིམ་ལྟར་བཀོད་ནས་གཤིབ་བསྡུར་བྱས་ཏེ།",
    "དེ་ནི་དངོས་གཙོ་སྨྲ་བས་མིང་སྦྱོར་རྟོག་པར་གོ་དོན་འཇོག་ཚུལ་དང་མཐུན་པར་འདུག་པས།",
    "དཔོན་པོའི་བང་མཛོད་ནོར་གྱིས་འདུགབཀང་།",
    "རང་མཚན་ཁོ་རང་མིང་རྟོག་ཡིན་ཞེས་བརྗོད་པ་མ་ཡིན་པར།",
    "དོན་རང་མཚན་ལ་མི་གོ་བར་འཇུག་དུས་ཀྱི་རང་མཚན་ལ་གོ་དགོས་སྙམ་སྟེ།",
    "འཇུག་དུས་ཀྱི་རང་མཚན་གཉིས་ལས།",
    "རང་སྤྱི་གཉིས་སུ་ཕྱེ་བའི་རང་མཚན་ནི་འཇུག་དུས་ཀྱི་རང་མཚན་ཁོ་ནར་གོ་ན།",
    "རྟོག་ངོར་ཤར་ཙམ་ལས་མེད་པས་བརྡ་སོགས་ལ་བརྟེན་ནས་རྟོག་ངོར་ཇི་ལྟར་ཤར་བའི་ཆ་དེ་ཤེས་ན་དེ་རྟོགས་པ་ཡིན་པས་ཕྱི་རོལ་དོན་དུ་མ་གྲུབ་ཀྱང་རང་རྟོགས་པའི་བློ་ཡོད་ཕྱིར་ཡོད་པར་འཇོག་པ་ལྟ་བུའོ།",
    "དབྱེ་རྐྱེན་གྱི་ཚད་གཞི་གཅིག་མཐུན་མིན་པའི་སྐྱོན་འདུག་གོ།",
    "དེས་ན་གཏན་ཚིགས་རིག་པའི་དབུ་ནི་སྔོན་བྱོན་རྣམ་དཔྱོད་དང་ལྡན་པ་རྣམས་ཀྱིས་ཤེས་བྱ་གང་ཡིན་གྱི་གནས་ལུགས་དང་རང་བཞིན་ལ་དཔྱད་པའམ་གཏན་ཚིགས་ཀྱི་སྒོ་ནས་སྐྱེས་པའི་རིག་པ་ཡང་དག་བྱུང་བ་ནས་བརྩམས་པར་འོས་པར་མཐོང་ངོ།",
    "དེ་ཡང་རང་ཉིད་ཀྱིས།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "ངོས་འཛིན་སོགས་རིམ་བཞིན་འཕེལ་རྒྱས་ཕྱིན་པའི་འགྲོས་ལ་བརྟེན་ནས་བྱུང་བ་ཡིན་ཙ་ན།",
    "དེའི་མི་འཐད་པའི་ཆ་རྣམས་སྤངས་ཤིང་རང་ཉིད་ཀྱི་གསར་དུ་རྙེད་པ་ཁག་ཅིག་བསྣན་ཏེ།",
    "དེས་ན་གཏན་ཚིགས་རིག་པའི་དབུ་ནི་སྔོན་བྱོན་དཔྱོད་ལྡན་རྣམས་ཀྱིས་ཤེས་བྱ་གང་ཡིན་གྱི་གནས་ལུགས་དང་རང་བཞིན་ལ་དཔྱད་པའམ་གཏན་ཚིགས་ཀྱི་སྒོ་ནས་སྐྱེས་པའི་རིག་༦ ནས་བརྩམས་པར་འོས་པར་མཐོང་ངོ།",
    "ཞེས་གསུངས་པ་ནང་བཞིན་ཁྱེད་ཀྱིས་ཀྱང་འདོད་པར་འདུག་སྟེ།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "སྤྱིར་འཇིག་རྟེན་ཁམས་ཀྱི་བྱ་བ་དང་བེམ་གཟུགས་ཚང་མར་ཕྱིའི་སྣང་ཚུལ་དང་རང་བཞིན་གཉིས་ཡོད་པའི་ནང་ནས་རང་བཞིན་ངོ་མ་དེ་ངོས་འཛིན་བྱེད་སྐབས་རང་རང་སོ་སོའི་ཕྱིའི་སྣང་ཚུལ་བརྒྱུད་ནས་ངོས་འཛིན་བྱེད་པ་མ་གཏོགས་ཕྱིའི་སྣང་ཚུལ་དེ་མ་བརྒྱུད་པར་རང་བཞིན་ངོ་མ་དེ་ངོས་འཛིན་བྱེད་མི་ཐུབ།",
    "རིག་ན་རྟོགས་པས་ཁྱབ་པ་ནི་རྟོགས་གེ་པ་ཞིག་ལ་བརྡ་སྤྲོད་དགོས་མི་འདུག་གོ།",
    "རང་རང་ས་ནས་འགྲེལ་ཚུལ་མི་མཐུན་པ་སྣ་ཚོགས་ཡོད་དེ།",
    "དེ་ཡང་རང་བཞིན་གྱི་རྟགས་ཡང་དག་ཡིན་ན།",
    "འཇུག་དུས།",
    "འབྲས་རྟགས་དང་རང་བཞིན་གྱི་རྟགས་དང་།",
    "གཟུང་བ་ཡུལ་དུ་གྱུར་པའི་གཞལ་བྱ་ལ་ཡང་རང་མཚན་དང་སྤྱི་མཚན་གཉིས་སུ་ཡོད་པས།",
    "རྗེས་དཔག་དང་རང་དོན་རྗེས་དཔག་གཉིས་དོན་གཅིག་ཡིན་ལ།",
    "ཀླུ་སྒྲུབ་ཡབ་སྲས་དང་དབྱིག་གཉེན་ལ་སོགས་པའི་གཞུང་ཐམས་ཅད་ན་གཏན་ཚིགས་ཀྱི་རིགས་པ་འདི་ལ་བསྟེན་ནས་གཞན་ལུགས་དགག་པ་དང་རང་ལུགས་འཇོག་པའི་སྒྲུབ་བྱེད་ཀྱི་རིགས་པ་མང་དུ་གསུངས་པ་ཐམས་ཅད་རིགས་པ་འདིའི་ཁུངས་ཡིན་ཏེ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱི་བསྐལ་བས་ན་བསྐལ་བ་ནི་རྣམ་པ་གསུམ་སྟེ།",
    "ཕྲན་ཆུང་རང་ལྟ་བུ་དང་པོ་སྐྱེས་སྟོབས་ཀྱི་ཤེས་རབ་དང་།",
    "དེ་གསུམ་པོའི་གང་ཡིན་རུང་རང་ཚུགས་ཀྱིས་གྲུབ་ན་རྟགས་ཡང་དག་དུ་མི་འགྱུར་ཏེ།",
    "འོན་ཀྱང་ངའི་རིགས་པ་འདི་གཞན་གྱིས་མ་ནོར་བར་མི་ཤེས་པར་འདུག་དགོངས་ཏེ།",
