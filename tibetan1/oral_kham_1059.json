    "མངོན་སུམ་དུ་མི་སྙན་པ་བརྗོད་པ་ནི་སྡུག་བསྔལ་བ་ཡིན་པས་དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཁྱིམ་བདག་དེས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འདུག་ནས་ཁྱིམ་བདག་དེས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་འཁོར་དེའི་བསམ་པ་དང་བག་ལ་ཉལ་དང་ཁམས་དང་རང་བཞིན་ཤེས་ནས་འདི་ལྟར་ཁྱིམ་བདག་དེ་འཁོར་དང་བཅས་པ་དང་།",
    "འདུག་གནས་གཅིག་ཏུ་ཞག་ལོན་པའི་དགེ་སློང་མི་ན་བས་བསོད་སྙོམས་གཅིག་བཟའ་བར་བྱའོ།",
    "འདུག་གནས་གཅིག་ཏུ་ཞག་ལོན་པའི་ཞེས་བྱ་བ་ནི་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཞག་ལོན་པའོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "སྟན་གང་ལ་འདུག་པར་གྱུར་པའི་སྟན་དེ་ལས་ལངས་པར་གྱུར་པས་ཏེ།",
    "སྟན་གང་ལ་འདུག་པར་གྱུར་པའི་སྟན་དེ་ལས་ལངས་པར་མ་གྱུར་པས་ཏེ།",
    "དགེ་སློང་ཟས་ཟོས་ཟིན་ཅིང་སྤངས་ལ་སྤྱོད་ལམ་ལས་མ་ཉམས་པ་གང་ཡིན་པ་དེའི་མདུན་དུ་ཙོག་བུར་འདུག་སྟེ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད་དགའ་བར་བྱེད་དགའ་མགུར་སྤྱོད་པར་བྱེད་དོ།",
    "དགེ་སློང་དེས་འདུག་སྟེ་ཟོས་པ་དང་རྒན་ཞུགས་ཀྱིས་སྨྲས་པ།",
    "དགེ་སློང་དོན་ཉུང་ངུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་དུས་མ་ཡིན་པར་བཅའ་བ་དང་བཟའ་བ་ཟ་བར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "དེའི་ཚེ་ན་ཚེ་དང་ལྡན་པ་ནག་པོའི་གཙུག་ལག་ཁང་ན་འབྲས་ཆན་སྐམ་པོ་རབ་ཏུ་མང་པོ་དག་བཏིང་ཞིང་འདུག་གོ།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད་དགའ་བར་བྱེད་དགའ་མགུར་སྤྱོད་པར་བྱེད་དོ།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པས་དང་།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་མ་ཡིན་པ་ན་འདུག་པས་དང་།",
    "དུར་ཁྲོད་ཆེན་པོ་དེ་ན་གནོད་སྦྱིན་གདུག་པ་ཞིག་འདུག་པ་དེ་དེ་ན་མི་རོ་མྱགས་པ་ཟའོ།",
    "སྲོག་ཆགས་བཅས་དང་ཉལ་སར་འདུག།",
    "ཁ་ཟེར་བར་བྱེད་ནས་དགེ་སློང་དོན་ཉུང་དུ་དག་ཅིའི་ཕྱིར་དགེ་སློང་དག་ཤེས་བཞིན་དུ་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་དུ་ཕྱིས་གནོན་བྱས་ཏེ་སྟན་ལ་འདུག་པར་བྱེད་ཅེས་སྨོད་པར་བྱེད།",
    "ཤེས་པ་ཅན་དགེ་སློང་རྣམས་ཟན་ཟ་བའི་མིག་ལམ་དུ་འདུག་ཅིག་དང་།",
    "ཤེས་པ་ཅན་དེ་དགེ་སློང་རྣམས་ཟ་ན་ཟ་བའི་མིག་ལམ་དུ་འདུག་པ་དང་།",
    "གསེར་གྱི་སྣོད་ན་འདུག་པའི་མར་མེ་ལྟ་བུ།",
    "འདུག་ཅིག་དང་སྦྱིན་ནོ།",
    "དེ་གཉིས་འདུག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་མི་དེས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དགེ་སློང་བསོད་སྙོམས་ལ་ཞུགས་པ་ན་དམག་འགྲོ་བ་དང་གཙུག་ལག་ཁང་ལམ་ཀ་ན་འདུག་པ་དང་།",
    "རི་བྲགས་པ་དེ་དེ་ལྟར་ན་ཡང་མ་ཕེབས་ནས་རྒྱལ་པོས་དེ་ཉིད་དུ་ཕྲུ་མ་བཏབ་སྟེ་འདུག་པ་དང་།",
    "གལ་ཏེ་དེ་མཆིས་པར་གྱུར་ན་དེའི་མཐུས་རི་བྲགས་པ་འདི་ཕེབས་པར་འགྱུར་བ་གང་ལགས་པ་དེ་ལྟ་བུའི་གནས་མཆིས་པར་འགྱུར་བ་གདའོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་མི་དེས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ཤིང་བདག་ཅག་དུས་ལ་བབ་ན་བསྟན་པ་ནུབ་པར་བརྗོད་པར་བྱ་སྟེ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་མི་དེས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེའི་ནང་ན་གནས་པའི་ཆེ་ཡང་ཞེས་བྱ་བ་ནི་འདུག་པའི་ཚེ་ཡང་ངོ།",
    "དེ་ལ་དགེ་སློང་རབ་ཏུ་གྲགས་པས་སྨད་པས་ཅང་མི་སྨྲ་བར་འདུག་ནས།",
    "འདུག་པ་བདེ་བ་མ་ཡིན་གྱི།",
    "འདུག་པ་བདེ་བ་མ་ཡིན་གྱི་འདི་ལྟར་ཁོ་བོ་གཅིག་པུ་ཁོ་ན་སྨྲའམ།",
    "འདུག་ན་བདེས།",
    "འདུག་པ་བདེ་བ་མ་ཡིན་གྱི་འདི་ལྟར་ཁོ་བོ་གཅིག་པུ་ཁོ་ན་སྨྲའམ།",
    "འདུག་པ་བདེ་བ་མ་ཡིན་གྱི་འདི་ལྟར་ཁོ་བོ་གཅིག་པུ་ཁོ་ན་སྨྲའམ།",
    "རི་བྲགས་དེ་ནས་བྱིས་པ་ཁྱེའུ་གཉིས་ཤིག་ལམ་ཀར་འོངས་ཏེ་རྩེ་ཞིང་འདུག་གོ།",
    "ཇི་ཙམ་ན་རི་དྲུང་དང་ཉེ་བ་ཞིག་ན་སེང་གེ་རལ་བ་ཅན་ཅོད་བན་ལྟ་བུ་དང་ལྡན་པ་ཞིག་འདུག་པ་དེས་སེང་གེ་དེ་དག་འབྲོས་པ་མཐོང་ནས་དེས་སྨྲས་པ།",
    "ཡུལ་ཐ་དད་པ་ན་གནས་པའི་བྲམ་ཟེ་རྣམས་ཀྱི་སྟོན་པར་གྱུར་པ་ཞིག་འདུག་པ་དེ་འཇིག་རྟེན་ཐམས་ཅད་ཀྱིས་ཤིན་ཏུ་བཀུར་སྟིར་བྱས།",
    "ཚེ་དང་ལྡན་པ་སྒྲ་གཅན་ཟིན་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག།",
    "ཚེ་དང་ལྡན་པ་སྒྲ་གཅན་ཟིན་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་ཏུ་ཡོད།",
    "དགེ་སློང་གནས་བརྟན་དག་ན་བར་གྱུར་ནས་དེ་དག་ལངས་ཤིང་རང་ཉིད་ཀྱིས་བྱིན་ལེན་བྱས་ཏེ་ཟ་བར་མི་ནུས་ནས།",
    "ཁྱིམ་བདག་གཉིས་རྒྱལ་པོའི་ཞལ་ནས་ཁྱེད་གཉིས་ངའི་ཡུལ་ན་མ་འདུག་ཅིག་ཅེས་བྱུང་ངོ།",
    "དེར་བདག་ཅག་གཉིས་ཀྱང་རང་ཉིད་མཆིས་ནས་གཡར་སྔར་བྲིམ་པར་བགྱིའོ།",
    "ཅི་ཙམ་ན་ཚེ་དང་ལྡན་པ་འདུན་པས་ཟན་ཟོས་ཅིང་སྤངས་པས་བཅའ་བ་དང་བཟའ་བ་བསོད་པ་ཞིག་རྙེད་ཅིང་དེ་ཟ་བར་འདོད་ནས་དེས་ལག་པ་གཉིས་བསྙལ་ཏེ་བཅའ་བ་དང་བཟའ་བ་བསོད་པ་དེ་བྱིན་ལེན་བྱས་ནས་ཚེ་དང་ལྡན་པ་འཆར་ཀ་ཟན་ཟ་བ་ན་འདུན་པས་དེའི་མདུན་དུ་ཙོག་བུར་འདུག་སྟེ་སྨྲས་པ།",
    "བྱིན་ནོ་སྙམ་ནས་དེ་རྙེད་པ་ཐམས་ཅད་དེ་དག་ལ་བྱིན་ནས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "དེ་ན་ཧ་ཅང་ཐག་མི་རིང་བ་ན་མི་འབྲས་བུ་དང་རྩ་བ་ཐུ་བ་ཞིག་འདུག་པ་དེས་དེ་ཐོས་ནས།",
    "ཇི་ཙམ་ན་གཏེར་ཞིག་ལམ་ལམ་ལམ་འབར་ཞིང་འདུག་པ་མཐོང་ནས།",
    "གྲོགས་པོ་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག།",
    "དེས་དྲིས་པ་གྲོགས་པོ་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག།",
    "དེ་དག་ལ་འདུག།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཀུན་དགའ་བོ་དེ་ལ་བས་ན་ཀུན་དགའི་ར་བར་གཏོགས་པ་ན་འདུག་པའམ་གནས་ཁང་དུ་གཏོགས་པ་ན་འདུག་པ་མ་གཏོགས་སོ།",
    "དེ་ལྟ་བས་ན་ཀུན་དགའི་ར་བར་གཏོགས་པ་ན་འདུག་པའམ་གནས་ཁང་དུ་གཏོགས་པ་ན་འདུག་པ་མ་གཏོགས་སོ།",
    "ཀུན་དགའི་ར་བར་གཏོགས་པ་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་ཀུན་དགའ་ར་བའི་ཕྱི་རོལ་ནའོ།",
    "གནས་ཁང་དུ་གཏོགས་པ་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་ཀུན་དགའི་ར་བའི་ནང་ནའོ།",
    "མ་གཏོགས་ཏེ་ཞེས་བྱ་བ་ནི་ཀུན་དགའི་ར་བར་གཏོགས་པ་ན་འདུག་པ་འམ།",
    "གནས་ཁང་དུ་གཏོགས་པ་ན་འདུག་པ་ན་བཞག་སྟེའོ།",
    "དེ་ལྟར་བྱའོ་ཞེས་དེ་དག་ལས་གཉིས་ཀྱིས་ཁྲུས་བྱ་བར་བརྩམས་ཏེ་བཞིས་གྲོགས་བྱེད་ཅིང་འདུག་གོ།",
    "ཚེ་དང་ལྡན་པ་དག་འདི་གཅིག་པུ་ཕར་རྒྱུག་ཚུར་རྒྱུག་ཅིང་འདུག་ན་ཡུ་བུ་ཅག་ལས་སུས་ཀྱང་འདིའི་གྲོགས་མ་བྱས་སམ།",
    "དེ་ཅང་མི་སྨྲ་བ་ཉིད་དུ་འདུག་གོ།",
    "རྒྱལ་པོ་སྐྱེངས་ནས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ལྷས་དེ་ནི་གསན་ན་བཅོམ་ལྡན་འདས་ཀྱིས་འདི་ན་ངས་དགེ་སློང་འདུག་པ་ན་འདོད་ཆགས་དང་བཅས་ཞེ་སྡང་དང་བཅས་གཏི་མུག་དང་བཅས་པར་མཐོང་ལ།",
    "རྒྱལ་པོ་ཐོས་པ་ཉུང་བས་དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་གོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་མ་འགགས་པས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "རི་བྲགས་ཤིག་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "དེ་དེར་འདུག་པ་དང་དེས་དེའི་རྐང་པ་བཀྲུ་བའི་ཆུ་ཁྱེར་ཏེ་འོངས་ནས་སྨྲས་པ།",
    "ལུས་དྲང་པོར་བསྲངས་ཏེ་དྲན་པ་མངོན་དུ་ཕྱོགས་པར་བཞག་ནས་འདུག་གོ།",
    "ཁམས་དང་རང་བཞིན་ཁོང་དུ་ཆུད་ནས།",
    "དེར་དུས་སྟོན་ལ་བབ་པ་ན་ཆོམ་རྐུན་པ་འཇོམས་པར་འདོད་པ་ལྔ་བརྒྱ་དེར་ལྷགས་ནས་དེ་ན་ཆོམ་རྐུན་པའི་དམག་དཔོན་གྱི་ལྷམ་རལ་ནས་དེ་དང་ཧ་ཅང་མི་རིང་བ་ན་དྲི་གཙང་ཁང་འདུག་པ་དེ་ན་མར་མེའི་འོད་ཚོད་དུ་མི་གསལ་བར་ཆོམ་རྐུན་པའི་དམག་དཔོན་དེས་མཐོང་ནས་དེ་དྲི་གཙང་ཁང་དེར་ཞུགས་ཏེ།",
    "དེ་ཕྱི་དེ་ཉིན་པར་ལུས་དག་འབྲུ་མར་གྱིས་བསྐུ་མཉེ་བྱས་ནས་ཁྲི་ལ་ཉལ་ཞིང་འདུག་པ་དང་།",
    "དེ་ཡང་རང་རྒྱལ་གྱི་ལམ་དེ་གཟུགས་སོགས་ཕྱི་རོལ་དོན་འཛིན་གྱི་གཟུང་རྟོག་སྤང་བྱའི་གཙོ་བོར་བྱས་ནས་སྤོང་བའི་ཁྱད་པར།",
    "དེ་རྣམས་ཀྱི་ནང་ནས་ཀྱང་རང་ཅག་འཛམ་བུ་གླིང་པ་ལ་ཆེས་བསྔགས་པའི་ཕྱིར།",
    "ཞག་གསུམ་དུ་བརྒྱལ་ཞིང་འདུག་པར་གྱུར་ཏོ་།",
    "བྱང་གཏེར་བཀའ་བརྒྱད་རང་བྱུང་རང་ཤར་དྲིལ་སྒྲུབ་ཀྱི་བསྙེན་ཡིག་རིག་འཛིན་གྲུབ་པའི་ཞལ་ལུང་དང་།",
    "སྟངས་སྟབས་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "ཕ་མ་རྡོ་རྗེ་སྤུན་སྲིང་དང་རང་ལུས་ལ་སྨོད་པ།",
    "འདྲེས་པ་ལའང་རང་དགར་བསྟན་ན་དངོས་གྲུབ་ཉམས་པར་གསུངས།",
    "དྲག་པོ་རང་བྱུང་རང་ཤར་གྱི་རྒྱུད་ལས།",
    "ཡང་རང་དང་དམ་ཚིག་ཉམས་པའི་མི་དང་།",
    "འདུ་བ་མང་པོའི་དཀྱིལ་དུ་འདུག་པར་དགའ།",
    "འདེབས་མཛད་སྲོལ་འདུག་ཀྱང་སྐབས་འདིར་མེད་ཀྱང་རུང་སྟེ།",
    "ཞེས་པ་འདུག་པ་ནི་ཚིག་ཅུང་ཟད་འབྲེལ་མི་ཆགས་པར་མཐོང་སྟེ།",
    "སྤྱིར་བཏང་ལུགས་སོ་སོར་མགྲོན་ཚན་གྱི་བྱེ་བྲག་སྣ་ཚོགས་བཅུ་གསུམ་ཞིག་འདུག་ཀྱང་།",
    "ཡི་དྭགས་ཐམས་ཅད་ཚིམས་ནས་བདེ་གྱུར་ཅིག་ཅེས་སོགས་ཚིགས་བཅད་ཤོ་ལོ་ཀ་གསུམ་ཡང་གསུང་རྒྱུན་དུ་འདུག།",
    "ཞིང་པ་རྣམས་ཀྱི་སོ་ནམ་སྒྲུབ་པ་ལས་ང་ཡི་གཏོར་མ་བཏང་བ་ཁེ་ཆེ་བ་ཀ་། མི་འདུག་གམ།",
    "ནང་རང་ལུས་ཕུང་ཁམས་སྐྱེད་མཆེད།",
    "རང་ཉིད་སེང་གེའི་ཁྲི་ལ་འདུག་པ་དང་།",
