    "ཁྱད་པར་ལ་ལྟོས་པ་མེད་པའིཕྱིར།",
    "ཞེས་ངེས་པར་འགྱུར་ཞིང་དེ་ལསབཟློག་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "འདི་ཡང་ཡོད་པ་དང་མེད་པ་ཉིད་ཀྱི་ཕྱིར་ཁྱད་པར་ལལྟོས་པ་ཡིན་ལ་དེ་ལས་གཞན་དུན་ཐེ་ཚོམ་ཟ་བ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཐེ་ཚོམ་ནི་ཡོད་པ་ཡིན་ནོཞེ་ན་བྲྗོད་པར་བྱ་སྟེ།",
    "སྔར་བཀག་ཟིན་པའི་ཕྱིར་ཐེ་ཚོམ་ནིཁྱད་པར་ལ་ལྟོས་པ་མ་ཡིན་ནོ།",
    "འདི་སྐདདུ་སྟོན་པར་འགྱུར་ཏེ།",
    "ཁྱད་པར་ལ་ལྟོས་ནས་ཤེས་པར་འགྱུར་ལ།",
    "ཁྱདཔར་མ་མཐོང་བ་ལ་ནི་མི་ཤེས་པ་སྐྱེ་བར་འགྱུར་རོ།",
    "ཁྱད་པར་མེད་ན་ནི་མི་ཤེས་པ་ཉིད་ཡིན་ནོ།",
    "འདི་ལྟབུར་འགྱུར་ཏེ་ཁྱད་པར་ཡོད་ན་ཤེས་པར་འགྱུར་ཞིང་དེ་མེད་ན་མིཤེས་པ་ཉིད་དོ་གང་ལ་ཁྱད་པར་དང་ཁྱད་པར་མེད་པ་དག་ཅིག་ཅརའགྱུར་བ་རྟོག་པ་གསུམ་པ་ནི་མེད་པའི་ཕྱིར་ཐེ་ཚོམ་ཡོད་པ་མ་ཡིནནོ།",
    "གལ་ཏེ་འཇིམ་པ་ལ་བུམ་པ་ཡོད་པ་དེའི་ཚེདེའི་འཇུག་པ་དོནམེད་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་སྣམ་བུ་དགོས་པ་ན་སྣམ་བུ་ལསོགས་པ་ལ་འཇུག་པ་ཡིན་གྱི་འཇུག་པ་ལ་མ་ཡིན་པ་བཞིན་ནོ་ཞེ་ནབྲྗོད་པར་བྱསྟེ་དེ་ལྟ་བུ་དེ་ཡང་སྔ་མ་དང་མཚུངས་པ་ཉིད་དོ།",
    "བསྒྲུབ་པར་བྱ་བ་དང་།",
    "སྒྲུབ་པར་བྱེད་པ་དག་ཁྱད་པར་མེདཔའི་ཕྱིར་རོ།",
    "དེས་ན་ཐམས་ཅད་མ་འབྲེལ་བཉིད་ཀྱིས་འགོག་པ་ཡིན་པ་དེའི་ཕྱིར་གདོན་མི་ཟ་བར་ཡན་ལག་གཟུངབར་བྱས་ནས་བྲྗོད་པར་བྱ་དགོས་ཏེ།",
    "རྣམ་པ་གཞན་དུ་ན་དགག་པམི་འགྲུབ་པོཞེ་ན་བྲྗོད་པར་བྱ་སྟེ།",
    "ཚོགསཔ་ལ་ཡན་ལག་མ་གྲུབ་བོ་ཞེ་ན་བྲྗོད་པར་བྱ་སྟེ།",
    "བསྒྲུབ་པར་བྱ་བ་དང་མཚུངས་པའི་ཕྱིར་རོ།",
    "མངཔོ་འདུས་པས་ནི་གླང་པོ་ཆེ་འང་འཆིང་བར་ནུས་པར་འགྱུར་རོསྙམ་དུ་སེམས་ན།",
    "གལ་ཏེ་ཡན་ལག་ནི་མ་གྲུབ་པའི་དོན་སྒྲུབ་པར་བྱེད།",
    "དེ་དག་ཀྱང་གྲུབ་པ་ཞིག་སྒྲུབ་པར་བྱེད་པཡིན་ནམ་མ་གྲུབ་པ་ཞིག་ཡིན་གྲང་།",
    "འོན་ཏེ་གཏན་ཚིགས་དང་དམ་བཅའ་བདག་མ་ཡིན་ན་ཅིཞིག་འཐོབ་པར་འགྱུར་ཞེ་ན་དམ་བཅའ་བ་ནི་སྣམ་བུ་དཀར་པོའི་གཏནཚིགས་གང་ཞེ་ན་དཀར་པོ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "དེ་ཉིད་ནི་དེའིསྒྲུབ་བྱེད་མ་ཡིན་ཏེ་འདི་ནི་བསྒྲུབ་པར་བྱ་བ་དང་མཚུངས་པ་ཡིནནོ།",
    "གཏན་ཚིགས་ལས་གྲུབ་པོ་ཞེས་བྲྗོད་པ་གང་ཡིན་པ་དེ་ནི་མ་ཡིན་ཏེགཏན་ཚིགས་ལ་ཡངགཏན་ཚིགས་གཞན་ཐོབ་པར་འགྱུར་ཞིང་དེ་ལ་ཡང་གཞན་ཡིན་ནོ།",
    "ཞེས་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "འོན་ཏེ་གཏན་ཚིགས་ལ་ཡང་གཏནཚིགས་ཡོད་པར་མི་འདོད་ན་དེའི་ཕྱིར་གཏན་ཚིགས་མེད་པ་ཡིན་ནོ།",
    "ཡང་ན་གཏན་ཚིགས་བཞིན་དུ་ཐམས་ཅད་ཀྱང་གཏན་ཚིགས་མེདཔར་གྲུབ་པར་འགྱུར་རོ།",
    "གཞན་ཡངགལ་ཏེ་གྲུབ་པ་ནི་གཏན་ཚིགས་ཀྱིས་བྱས་པ་ཡིན་ན་ཅི་ཞིག་འཐོབ་ཅེ་ན།",
    "འོན་ཏེ་དཔེ་གྲུབ་པར་འདོདན་དེའི་ཚེ་གཏན་ཚིགས་དོན་མེད་པར་ཐོབ་པར་འགྱུར་རོ།",
    "བྲྗོད་པར་བྱ་སྟེ།",
    "གཏན་ཚིགས་ཀྱིས་འགྲུབ་པར་སེམས་ཏེ།",
    "གཏནཚིགས་ཀྱིས་འགྲུབ་པར་རྟག་པ་མ་ཡིན་ཏེ།",
    "དེ་ཡོད་པའི་ཕྱིར་གཞན་དག་ཀྱང་གྲུབ་པ་ཡིན་ནོ་ཞེན་བྲྗོད་པར་བྱ་སྟེ།",
    "དེ་ལ་གལ་ཏེ་ཤེས་པའི་དོན་ལ་ཡིན་ན་ཅི་ཞིག་དཔྱོདཔར་འགྱུར།",
    "འོན་ཏེ་མི་ཤེས་པའི་དོན་ལ་ཡིན་ན་ཡང་ཅི་ཞིག་དཔྱོདཔར་འགྱུར།",
    "རྣམ་པར་རྟོག་པ་གསུམ་པ་ནི་མེད་དོ།",
    "རྣམ་པར་དཔྱད་པ་དོན་ཁོང་དུ་ཆུད་པ་ནི་གཏན་ལ་ཕབ་པ་ཡིན་ལ།",
    "དེ་ཁོ་ན་ཉིད་ཤེསཔའི་དོན་དུ་དཔྱོད་པར་བྱེད་པ་ནི་རྟོག་གེ་ཡིན་ནོ་ཞེ་ན་བྲྗོད་པརབྱ་སྟེ།",
    "བྲྗོད་པར་བྱེད་པ་དང་བྲྗོད་བྱ་དག་མེདཔའི་ཕྱིར་རྩོད་པ་ཡང་མེད་དོ།",
    "ཆུ་ལ་སོགས་པ་འདུསཔ་ལ་མ་ལྟོས་པར་གྲུབ་པར་འགྱུར་ཏེ།",
    "བུམ་པ་ཞེསབྲྗོད་པ་ན་ཁ་གང་བར་འགྱུར་ལ་མེ་ཞེས་བྲྗོད་པ་ན་མཆུ་འཚིགཔར་འགྱུར་ཏེ་དེ་ལྟར་འདོད་པ་ཡང་མ་ཡིན་ནོ།",
    "གཞན་ཡིན་ན་བུམ་པཞེས་ངེས་པར་བྲྗོད་པ་ན་བུམ་པ་ངེས་པར་མི་འགྱུར་རོ།",
    "བརྡ་བྱསཔའི་བྲྗོད་པའི་ཐ་སྙད་ཡིན་ནོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "རྨོངས་པཞེས་བྱ་བའི་ཁྱད་པར་དག་ཀྱང་མེད་པར་འགྱུར་རོ།",
    "གཞན་ཡངབརྡ་བྱས་པའི་མིང་དག་ནི་རྣམ་པ་དུ་མ་མཐོང་སྟེ།",
    "བ་ལང་ལ་ཌ་མིཌ་ལ་སོགས་པ་ནི་སྟིགས་ཏ་དང་འཕགས་པ་ཞེས་མིང་དུ་བྱས་པ་ལྟབུ་དང་།",
    "གཞན་ཡང་འཇིག་རྟེན་པའི་མཁས་པ་དག་ཀྱངརྗོད་པར་བྱེདཔ་དང་བྲྗོད་པར་བྱ་བ་དུ་མ་ལ་སྦྱོར་བ་མཐོང་བའི་ཕྱིར་རོ།",
    "མཁས་པསཧ་རིར་ཤེས་པར་བྱ།",
    "དེ་ཡངདོན་དམ་པར་གྲུབ་པ་མཡིན་ནོ།",
    "དེའི་ཕྱིར་རྗོད་པར་བྱེད་པ་དང་བྲྗོད་པར་བྱ་བ་དགརྣམ་པ་དུ་མ་འདྲེས་པའི་སྐྱོན་མཐོང་བའི་ཕྱིར་མ་ངེས་པས་མགྲུབ་པ་ཡིན་ནོ།",
    "གཞན་ཡང་གཅིག་ཉིད་ཡིན་ན་རྗོད་པར་བྱེད་པདང་བྲྗོད་པར་བྱ་བ་མ་གྲུབ་པ་ཡིན་ལ།",
    "གཞན་ཉིད་ཡིན་ན་ནི་བུམཔ་ཞེས་བྱ་བའི་རྗོད་པར་བྱེད་པ་སྦྱོརབ་ན་བུམ་པ་ལ་ཤེས་པ་ངེས་པར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་བདག་ཉིད་ལ་འཁྲུལ་པར་མི་འགྱུར་བ་ཡིན་ན་འཁྲུལཔ་དང་བཅས་པར་མི་འགྱུར་ཏེ།",
