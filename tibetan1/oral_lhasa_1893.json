    "དེ་སྟོན་པར་བྱེད་པའི་རྒྱུད་ཡིན་པས་ན་རྡོ་རྗེའི་བྱིན་གྱིས་བརླབས་པའི་རྣལ་འབྱོར་གྱི་རྒྱུད་སྟོན་ཏོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ་སེམས་དཔའ་ལས་ཕྱག་རྒྱ་ཐ་མི་དད་དེ།",
    "ཕྱག་རྒྱ་ལས་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་དེ་སེམས་དཔར་གྱུར་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ནོར་བུའི་རིགས་ཀྱི་ལས་རྣམས་སྦྱིན་གྱིས་རློབ་པའི་སྦྱོར་བ་ཡིན་པས་ན་ནོར་བུའི་རིགས་ཀྱི་ལས་ཀྱི་བྱིན་གྱིས་བརླབ་པའི་རྣལ་འབྱོར་གྱི་རྒྱུད་དེ་སྟོན་པར་བྱེད་པ་གསུངས་སོ།",
    "དངོས་གྲུབ་རྣམས་ནི་འདི་དང་གྲུབ་ཅིང་སྡོམ་པར་འགྱུར་པའོ།",
    "རྡོ་རྗེའི་ལས་རྣམས་བསྒྲུབ་པར་བྱ།",
    "དེ་བས་ན་འདི་ལྟ་བུའི་ལས་ཐམས་ཅད་བསྒྲུབ་པར་བྱ་བ་སྟེ་ང་ཡང་དེ་ལས་ཐ་མི་དད་དོ་ཞེས་བྱ་བའི་ང་རྒྱལ་བྱས་ལ་སྔགས་པས་བསྒོམས་ནས་དེ་ནས་དེ་ཡང་ལས་བསམ་ཅན་བསྒྲུབ་པོ་ཞེས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་ལས་ཀྱིས་གསུངས་སོ།",
    "དེ་རྣམས་ཀྱི་དེ་ཁོ་ན་ཉིད་ནི་བསྒོམས་པའི་སྟོབས་ཀྱིས་ཡོངས་སུ་རྫོགས་པར་གྱུར་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཡི་དེ་ཁོ་ན་ཉིད་བསྡུས་པ་ནི་བསྡུ་བ་བྱས་པས་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་དེ་ཁོ་ན་ཉིད་བསྡུས་པ་སྟེ།",
    "དེ་ལ་རྟོགས་པར་ཐམས་ཅད་ཀྱི་གསང་བའི་རྒྱུད་ཕྱིར་མ་ཞེས་བྱ་བ་རྟོགས་པ་ཐམས་ཅད་ནི་བཞིན་སྟེ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བ་དང་།",
    "དོན་གང་རྒྱུད་དང་རྒྱུད་ཕྱི་མ་ལས་གསུངས་པ་ལས་མ་གསུང་ས་བརྒྱུད་ཕྱི་མའི་ཕྱི་མས་གདུལ་བྱའི་ཁྱད་པར་རྗེས་སུ་འཛིན་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ནི།",
    "ལྟ་བ་ངང་པ་ནི་དོན་ཚིག་ཇི་བཞིན་པར་འདོད་པ་དང་སྤྱོད་པར་རང་དྲར་བྱེད་པ་ལ་འཇུག་པ་གང་ཡིན་པ་རྣམས་སོ།",
    "སྒྲུབ་པའི་དུས་ན་བྱ་བའི་བྱེ་བྲག་གང་ཡིན་པ་དེ་དག་ལ་ཡོ་བྱད་ཀྱི་སྒྲར་གསུངས་སོ།",
    "ཟླ་བ་བཞིར་ཞེས་བྱ་བ་འདིས་ནི་སྔར་བསྙེན་པའི་དུས་ངེས་པར་སྟོན་ཏོ།",
    "འདིས་ནི་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་དམ་ཚིག་ལ་གནས་པར་སྟོན་པར་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་དམ་ཚིག་གསུངས་པ་ཡིན་ནོ།",
    "ཁ་ཟས་ཀུན་དང་ཞེས་བྱ་བ་ནི་རིག་པའི་བརྟུལ་ཞུགས་ཀྱིས་ངེས་པ་མེད་པར་བསྟན་པ་ཡིན་ཏེ་ཀུན་འདོད་དང་།",
    "བུ་རམ་ལ་སོགས་པ་དགག་པར་གསུངས་པ་དེ་ལྟ་བུ་དེ་འདིར་མི་བྱའོ།",
    "དེ་ལྟར་དེས་ཇི་ལྟར་བསྒྲུབ་པར་བྱ་ཞེ་ན་དེའི་ཕྱིར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཁྱིམ་པ་ཞིག་ན་ཁྲུས་བྱས་ཏེ།",
    "རབ་ཏུ་བྱུང་བ་ཞིག་ན་དེས་ཀྱང་ཅི་འདོད་པའི་ལས་རྣམས་བྱེད་བཞིན་དུ་དུས་བཞིར་རྒྱུན་མི་འཆད་པར་བྱེད་པའོ།",
    "བརྩེ་བའི་བདག་ཉིད་སྟོན་པར་མཛད།",
    "དེ་ལྟར་ན་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱོགས་བཞིར་སེམས་དཔའ་ཆེན་པོ་འཁོར་ལོས་སྒྱུར་བ་བཞི་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་གནས་པ་བྲི་བར་བྱའོ།",
    "དེ་བཞིན་དུ་གསུམ་པ་དང་བཞི་པ་ཡང་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་འཁོར་དུ་གྱུར་པ་ཡིན་ནོ།",
    "ཟླ་བ་བཞིའི་བར་དུ་བཟླ་བར་བྱའོ་ཞེས་བྱ་བ་ནི་ཇི་སྲིད་ཟླ་བ་བཞི་ལོན་པ་དེ་སྲིད་ཀྱི་བར་དུ་བཟླས་པར་བྱ་བ་སྟེ་འདི་ནི་སྔོན་དུ་བསྙེན་པའི་དུས་ཀྱི་ངེས་པའོ།",
    "ཕྱག་རྒྱ་བསྒྲུབ་པར་འདོད་ན་ནི།",
    "འདི་ནི་ཉེ་བར་མཚོན་པ་ཙམ་དུ་ཟད་ཀྱི་གང་དང་གང་བསྒྲུབ་པར་འདོད་པ་དེས་དེ་བཅིང་བར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟ་བུ་ལན་གསུམ་བསྐོར་བ་དང་བརྒྱ་རྩ་བརྒྱད་ལྷག་པ་དང་བཅས་པ་བཟླས་པར་གྱུར་ཏེ་དེ་ལྟར་བརྩི་བར་བྱའོ།",
    "ཕྱག་རྒྱ་བཅིངས་པ་དེ་འབར་རམ་འཕར་བའི་མཚན་མ་བྱུང་ན་དངོས་གྲུབ་དམ་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་བདག་ཉིད་ལྷའི་གཟུགས་ཡིན་པར་བདག་ཉིད་ཀྱིས་ཀྱང་མཐོང་ཞིང་གཞན་ལ་ཡང་སྟོན་པས་ན་ཅི་འདོད་པའི་གཟུགས་སུ་འགྱུར་བ་ཡིན་ནོ།",
    "གདོན་རྣམས་ཚར་གཅོད་པ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་བྱེད་པར་འགྱུར་རོ།",
    "བཅིངས་མ་ཐག་ཏུ་ཕྱག་རྒྱ་ཐམས་ཅད་ཀྱིས་ལས་ཐམས་ཅད་ཇི་ལྟ་བ་བཞིན་དུ་བྱེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་དངོས་གྲུབ་རྣམ་པ་བཞི་ཆར་གྱི་ལས་ཀྱི་སྤྱིའི་མཚན་ཉིད་ཡིན་ཏེ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་ཞེས་བྱ་བ་ནི་མཚན་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་ཐམས་ཅད་བྱེད་དོ་ཞེས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འཛིན་པས་གསུངས་སོ།",
    "ཟླ་བ་བཞིའི་བར་དུ་ཞེས་བྱ་བ་ནི་དུས་ཀྱི་ངེས་པ་སྟོན་པ་སྟེ་དེ་དང་པོར་སེམས་བརྟན་པར་བྱས་ཟིན་པའི་ཕྱིར་རོ།",
    "བསྒོམས་ལ་ཞེས་བྱ་བ་ནི་གོམས་པར་བྱས་པའོ།",
    "དེ་ལྟར་མངོན་སུམ་དུ་གྱུར་པ་དང་དེ་ནས་ཇི་ལྟ་བུ་འདོད་པ་དེ་ལྟ་བུ་འཐོབ་པར་འགྱུར་རོ་ཞེས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའ་གསུངས་སོ་ཞེས་པའོ།",
    "ཕྱག་བཞི་བྱས་ནས་མེ་ཏོག་དང་།",
    "དེ་ནས་ལས་ཐམས་ཅད་ཀྱི་དངོས་གྲུབ་ཏུ་འགྱུར་རོ་ཞེས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འཛིན་པས་གསུངས་སོ་ཞེས་པའོ།",
    "དེ་ཉིད་ཀྱིས་བདུག་པ་བྱ་སྟེ་དེ་ལྟར་ན་འབབ་པར་འགྱུར་བ་ཡིན་ནོ།",
    "བཅིངས་ན་བྱས་པའམ་བླུགས་པའི་དངོས་པོ་ཐམས་ཅད་ལ་རྡོ་རྗེ་ལ་སོགས་པ་འབབ་པར་འགྱུར་རོ།",
    "གལ་ཏེ་སྒྱུར་མའི་ལས་ཀྱང་བྱེད་པར་འདོད་ན་རྣ་བྱའི་མཇུག་མའི་ནང་དུ་རྡོ་རྗེ་བཅུག་སྟེ་བཅིངས་ལ།",
    "དེ་ཕྱིན་ཆད་རྨ་བྱའི་མཇུག་མ་དེས་གཟུགས་ཐམས་ཅད་ཡང་དག་པར་སྟོན་ཏོ།",
    "ལྷའི་གནས་ལེགས་པར་བརྟགས་པས་ཡོ་བྱད་རྣམས་ཚོགས་པ་དང་ལྡན་པས་ན་སྔར་བསྙེན་པར་བྱའོ།",
    "ཡི་གེ་འབྲུ་འབུམ་བཟླས་པར་བྱའོ་ཞེས་བྱ་བ་ནི་བཟླས་པར་བྱ་བ་ནི་བཟླས་པར་བྱ་བའི་སྔགས་ཀྱི་ཡི་གེ་འབྲུ་དུ་ཡོད་པའི་འབུམ་ཕྲག་དེ་སྙེད་བཟླས་བརྗོད་བྱའོ་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "འོན་ཏེ་བསྒྲུབ་པར་འདོད་ན་ཡང་།",
    "ཟླ་བ་གཅིག་འདོད་པ་ཀུན་ལ་ལོངས་སྤྱོད་ཅིང་ཞེས་བྱ་བ་འདིས་ནི་སྔ་མ་བཞིན་རིག་པའི་བརྟུལ་ཞུགས་ཀྱི་ངེས་པ་མེད་པར་སྟོན་ཏོ།",
    "ཅི་དགའ་བ་བཞིན་དུ་བྱས་ནས་ཞེས་བྱ་བ་ནི་ཁྱིམ་གྱི་བྱ་བ་ཐམས་ཅད་བྱེད་བཞིན་དུ་ཡང་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཅི་སྟེ་ཕྱག་རྒྱ་བསྒྲུབ་པར་འདོད་ན་ཡང་།",
    "ཅི་སྟེ་ཕྱག་རྒྱ་བསྒྲུབ་པར་འདོད་ན་ཡང་།",
    "དེ་ནས་ཕྱག་རྒྱ་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་བདུག་པ་མལ་སོགས་པའི་ལས་ནི་ཚིམ་པར་བྱེད་པ་ལ་སོག་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དབབ་པ་ནི་རྡོ་རྗེ་དྲིལ་བུའི་ལས་ཡིན་ཏེ་དེ་ལྟར་ན་དབབ་པ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་བྱེད་པར་འགྱུར་ཞེས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འཛིན་པས་གསུངས་སོ།",
    "ཏིང་ངེ་འཛིན་གྱི་ཕྱག་རྒྱ་ཉིད་འདིར་ལས་ཀྱི་ཕྱག་རྒྱས་གསུངས་སོ།",
    "དེ་ནས་ལས་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་ཞེས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འཛིན་པས་གསུངས་ཏེ་ལས་དེ་ཡང་སྲུང་བ་ལ་སོགས་པའི་ལས་རྣམས་བྱེད་པ་ཡིན་ནོ།",
    "དུས་ཇི་བཞིན་པར་ཞེས་བྱ་བ་ནི་ནང་པར་རོ།",
    "ཇི་ལྟ་བུར་དགའ་བའི་ཏིང་ངེ་འཛིན་ཞེས་བྱ་བ་ནི་ཏིང་ངེ་འཛིན་གང་ལ་དམིགས་ནས་མྱུར་བ་ཉིད་དུ་སེམས་རྩེ་གཅིག་པར་འགྱུར་བའི་ཏིང་ངེ་འཛིན་དེས་བཟླས་པ་འདི་བྱ་བའོ།",
    "དེ་ལྟར་ཏིང་ངེ་འཛིན་མངོན་དུ་བྱས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་བར་དུ་གསུངས་པ་ཡིན་ནོ།",
    "འདྲིར་གཞུག་པར་བྱ་ཞིང་སེམས་པའི་བཞིས་བསྐོར་བ་དང་།",
    "དངོས་པོ་འདི་རྣམས་ནི་རྣམ་པར་རྟོག་པ་ཙམ་ལ་རག་ལུས་པ་ཡིན་ཏེ།",
    "དེ་བས་ན་གང་ཅུང་ཟད་ཅིག་རྣམ་པར་བརྟགས་ལ་རྣམས་པར་བརྟགས་ནས་ཀྱང་བསྒོམ་ལ་བསྒོམས་ནས་ཀྱང་བརྟན་པར་གྱུར་ན་བདག་དང་གཞན་རྣམས་ལ་དེ་བཞིན་དུ་སྣང་བར་འགྱུར་རོ།",
    "ཅི་དགའ་བར་ཞེས་བྱ་བ་ནི་ཅི་འདོད་པར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཅི་ནུས་ཀྱིས་བཟླས་པ་བྱའོ་ཞེས་བྱ་བ་ནི་བརྒྱ་རྩ་བརྒྱད་དམ་སྟོང་རྩ་བརྒྱད་དམ་གྲངས་མེད་པར་བཟླས་པ་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྤྲོས་པ་མེད་པའི་ཚིག་གྲུབ་པར་གྱུར་ཅིག་ཅེས་བྱ་བ་སྟེ།",
    "སྤྲོས་པ་ནི་ཡི་གེ་དང་རྣམ་པར་རྟོག་པ་རྣམས་ཏེ་ཚིག་གང་དེ་ཐམས་ཅད་བྲལ་བར་གྱུར་པ་དེ་ནི་སྤྲོས་པ་མེད་པའི་ཚིག་གོ།",
    "གང་དང་གང་ཡིན་པའི་དོན་ཇི་ལྟ་བ་དེ་དང་དེ་ལྟ་བུར་གྲགས་པ་དང་སྒྲ་ཡང་དེ་དང་དེ་ལྟ་བུར་གྱུར་པ་དེ་ནི་སྤྲོས་པ་མེད་པའི་གསུངས་ཡིན་ནོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ནི་རིག་པ་སྟེ་རྟོགས་ཤིང་སྔོམ་པར་གྱུར་ཏོ་ཞེས་སྨྲས་ལ་ཞེས་བྱ་བ་ལ་རིགས་པ་ནི་ཡེ་ཤེས་སོ།",
    "དེ་ཐུགས་སུ་ཆུང་ཅིང་ཞེས་བྱ་བ་ལ་ནི་རིག་པ་མཁྱེན་པར་གྱུར་པའོ།",
    "དེའི་སྔོམ་པར་གྱུར་པ་ནི་རྒྱུར་གྱུར་ཅིང་རྩ་བར་གྱུར་ཏོ་ཞེས་བརྗོད་པའོ་། རིག་པ་ཅི་དགའ་བར་བཟླས་ཤིང་ཞེས་བྱ་བ་ནི་རིག་པ་གང་འདོད་པ་བཟླ་བར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རིག་པ་རྣམས་ཀྱི་དོན་ཇི་བ་བཞིན་དུ་བདག་དེ་ལྟར་འགྱུར་བའི་དོན་དེ་བསྒྲུབས་ན་སྐལ་བ་དང་ལྡན་པར་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བུས་ཀྱང་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔས་གསུངས་སོ།",
    "དང་པོ་ལྷའི་རྣལ་འབྱོར་བྱས་ནས་ནོར་འགྲུབ་པ་ལ་སོགས་པར་བྱའོ།",
    "ཇི་ལྟར་དགའ་བ་ཉིད་དུ་བླངས་ན་ཞེས་བྱ་བ་ནི་བཞི་ཆའམ་སུམ་ཆའམ་ཕྱེད་དམ་རངས་པར་བླང་བའོ།",
    "ཞེས་བྱ་བ་ནི་ཆུས་ལ་སོགས་པའི་རྣམ་པར་བསྒོམ་སྟེ།",
    "ད་ནི་རྡོ་རྗེ་རིག་འཛིན་གྱི་དངོས་གྲུབ་སྟོན་ཏེ་སྒྲུབ་པ་ན་བཛྲ་བིདྱཱ་དྷར་ཞེས་བྱ་བ་ནི་བཀྲ་ཤིས་པའི་ཚིག་ཡིན་པས་སྔར་བསྙེན་པ་བྱེད་པའི་ཚེ་ཐོག་མ་ཉིད་དུ་བརྗོད་པར་བྱའོ།",
    "ད་ནི་དེ་ལ་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པས་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དངོས་གྲུབ་སྟོན་ཏེ།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམས་པར་རྒྱལ་བའི་རྟོག་པར་གཏོགས་པའི་དངོས་གྲུབ་བཞི་ཡིན་པས་ན་འཇིག་རྟེན་གསུམ་ལས་རྣམས་པར་རྒྱལ་བའི་དངོས་གྲུབ་བོ།",
    "དེ་ཡང་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་གྱལ་བའི་དངོས་གྲུབ་དང་།",
    "དེ་ལས་ཐོག་མར་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་བཅིངས་ལ་ཞེ་བྱ་བ་ལ་སོགས་པས་འཇིག་རྟེན་གསུམ་ལས་རྣ་པར་རྒྱལ་བའི་དངོས་གྲུབ་སྟོན་ཏོ།",
    "དེ་ནས་ཧཱུཾ་ཞེས་བྱ་བ་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བ་ནི་འདི་སྐད་སྟོན་ཏེ།",
    "དེ་ཕྱིན་ཆད་འཇིག་རྟེན་གསུམ་པོ་ཐམས་ཅད་ཀྱི་བདག་པོ་རྡོ་རྗེ་འཛིན་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་གསུམ་པོ་མ་ལུས་པའི་བདག་པོ་རྡོ་རྗེ་འཛིན་པ་ལྟ་བུ་གཉིས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཇིག་རྟེན་གསུམ་པོ་ཐམས་ཅད་ལ་བཀའ་སྩོལ་ཅིག་ཅེས་བྱ་བ་ནི་བཀའ་བསྒོ་བ་ཙམ་གྱིས་བྱ་བ་ཐམས་ཅད་ལ་ངེས་པར་སྦྱར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལྷག་མ་རྣམས་ནི་གོ་སླའོ་། སྔ་མ་ནི་ཧཱུཾ་ཞེས་བྱ་བའི་ཕྱག་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དངོས་གྲུབ་ཀྱི་འབྲས་བུ་ཤིན་ཏུ་ཕུལ་དུ་བྱུང་བར་གསུངས་པ་ཡིན་ལ།",
    "ད་ནི་འདི་ནས་གཟུགས་བསྙེན་སྐད་འབྱིན་པར་འགྱུར་ན་དངོས་གྲུབ་ཀྱི་མཚན་མ་སྟེ།",
    "དེ་ནི་ཕལ་བ་ཡིན་པའི་ཕྱིར་ཁྱད་པར་ནི་དེ་ཡོད་དོ།",
    "དོན་གྱི་དངོས་གྲུབ་དང་རྫུ་འཕྲུལ་གྱི་དངོས་གྲུབ་དང་རིག་འཛིན་གྱི་དངོས་གྲུབ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་བཀྲ་ཤིས་པའི་ཚིག་ཡིན་པར་མཚུངས་པ་ཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "གསང་བའི་མཆོད་བ་བཅུ་དྲུག་གསང་བའི་དཀྱིལ་འཁོར་དུ་གསུངས་པ་གང་ཡིན་པ་རྣམས་སོ།",
    "ད་ནི་དེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པས་པདྨའི་རིགས་སུ་གཏོགས་པའི་དངོས་གྲུབ་སྟོན་ཏེ་དེ་ཡང་རྣམ་པ་བཞི་སྟེ་མཉེས་པར་བྱ་བ་དང་།",
    "སྤ་བ་ནི་མི་རྣམས་ལས་མཚོན་ལ་སོགས་པ་མི་འབབ་པར་བྱེད་པའོ།",
    "བསམས་པའི་དོན་ཚོགས་ཆུང་དུས་མྱུར་དུ་སྟོབས་པའི་ཕྱིར་ན་ཐབས་ཞེས་བྱ་བ་སྟེ་ཤེས་རབ་ཀྱིས་ཁྱད་པར་རོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ་མ་མཐོང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་སྔགས་འགྲུབ་པར་བྱ་བའི་ཐབས་ཅི་ཞིག་ཡོད་ཅེ་ན་དེའི་ཕྱིར།",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེས་ན་འདིར་སྔགས་གྲུབ་པའི་ཐབས་ནི་མི་སྨྲ་བ་ཡིན་པར་བསྟན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་མ་རིག་པ་ནི་མི་ཤེས་པ་སྟེ་རྨོངས་པ་ཡིན་ལ་རྨོངས་པའི་ཡིད་ཀྱིས་ནི་ཐབས་མེད་པའི་ཕྱིར་དངོས་གྲུབ་ཐོབ་པར་ག་ལ་འགྱུར།",
    "ཀུན་རྫོབ་ཏུ་ནི་རྣམ་པར་རྟོག་པ་ཙམ་ལ་རག་ལས་པ་ཡིན་ནོ།",
    "དེ་ལྟར་རྟོག་པ་ཐམས་ཅད་ཀྱི་ཐབས་ཀྱི་དངོས་གྲུབ་རྫོགས་པར་མཛད་ནས།",
    "ཅེས་བྱ་བ་གསུངས་པ་ཡིན་ཏེ།",
    "དེས་དངོས་གྲུབ་འཐོབ་པར་རྒྱུད་གང་དུ་སྟོན་པ་དེ་ནི་སྔགས་ཀྱི་བསོད་རྣམས་ཀྱི་དངོས་གྲུབ་ཀྱི་རྒྱུད་དོ།",
    "རིག་པ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པར་རྣམས་གཟུང་ངོ།",
    "ཅེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "ཡི་གེ་ཐམས་ཅད་ལ་ཡང་འཇུག་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དོན་དམ་པར་མ་སྐྱེས་པའི་དོན་སྟོན་པའི་ཕྱིར་དང་།",
    "ཡི་གེ་ཐམས་ཅད་ཀྱི་དོན་སྟོན་པའི་ཕྱིར་ཏེ་དཔེར་ན་ཀ་ཞེས་བྱ་བ་ནི་ལས་དང་རྣམ་པར་སྨིན་པ་ཉིད་ཀྱིས་སོ།",
    "དེ་ལྟར་དེ་ལ་སོགས་པ་ཀུན་རྫོགས་དང་དོན་དམ་པར་སྟོན་པ་ཡིན་པས་ན་ཡི་གེ་ཨ་ཉིད་ཀྱི་ནང་དུ་ཡི་གེ་ཐམས་ཅད་ཆུད་པར་ཨའི་དོན་རྟོགས་པར་བྱས་ལ།",
    "ཕྱག་རྒྱ་རྣམས་ཤེས་རབ་ཀྱིས་གྲུབ་པར་རྒྱུད་གང་དུ་སྟོན་པ་དེ་ནི་ཕྱག་རྒྱའི་ཤེས་རབ་ཀྱི་དངོས་གྲུབ་ཀྱི་རྒྱུད་དོ།",
    "ངེས་པར་འབིགས་པའི་ཕྱིར་ན་ངེས་འབིགས་ཏེ་འབིགས་པ་ནི་རྟོགས་པའོ།",
    "དེ་ཡང་ངེས་པར་འབིགས་པར་བྱེད་པས་ངེས་འབིགས་ནི་གང་ལ་མིང་དེ་སྐད་ཅེས་བྱ་བ་དེ་ནི་ངེས་འབིགས་ཞེས་བྱའོ།",
    "དེ་ལྟ་བུའི་ཤེས་རབ་དེས་ནི་ཕྱག་རྒྱ་མྱུར་འགྲུབ་པར།",
    "བསྒོམས་ན་ཉིད་དུ་འགྲུབ་པར་འགྱུར།",
    "དེ་བས་ན་མཉམ་པར་གཞག་པའི་སེམས་ལ།",
    "དེ་ལྟ་བུའི་ཤེས་རབ་ཀྱིས་ཤིན་ཏུ་བསྒོམས་པ་ལས་མྱུར་དུ་སྔགས་ཀྱི་དངོས་གྲུབ་འཐོབ་པར་འགྱུར་རོ་ཞེས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་བློས་གསུངས་སོ།",
    "རིག་པ་རྣམས་ཀྱིས་ཤེས་རབ་ཀྱིས་འགྲུབ་པར་རྒྱུད་གང་དུ་སྟོན་པ་དེ་ནི་རིག་པའི་ཤེས་རབ་ཀྱི་དངོས་གྲུབ་ཀྱི་རྒྱུད་དོ།",
    "རིག་དང་སྔགས་གཉིས་ཁྱད་པར་དུ།",
    "ཁྱད་པར་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གཏན་ཚིགས་དེས་ན་རིག་པ་དང་སྔགས་རྣམས་ཀྱི་ཁྱད་པར་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "འདི་དག་ནི་སྔགས་སོ་ཞེས་ཅིའི་ཕྱིར་རྣམ་པར་འཇོག་པར་མཛད་ཅེ་ན།",
    "ཤེས་རབ་བསྒོམས་ན་མྱུར་བར་ནི་། ངེས་པར་དངོས་གྲུབ་འཐོབ་པར་འགྱུར།",
    "ཞེས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཤེས་རབ་ཀྱི་ཡེ་ཤེས་གསུངས་སོ།",
    "ཚོགས་ནི་རྣམ་པར་འཕེལ་འགྱུར་ཏེ།",
    "དེ་ནས་ཚོགས་ནི་འགྲུབ་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་ཚོགས་ཡོངས་སུ་རྫོགས་པར་གྱུར་ན་འགྲུབ་པར་འགྱུར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཁོར་ལོ་མང་པོ་བཞུགས་པ་དང་།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འཁོར་ལོ་མང་པོར་ཞུགས་པ་ནི་དཀྱིལ་འཁོར་མང་པོར་འཇུག་པ་སྟེ་རྒྱུད་ལས་གསུངས་པའི་གསང་ཞིང་སྦ་བའི་དངོས་གྲུབ་དང་ཕྱག་རྒྱ་བཞིའི་དངོས་གྲུབ་ཐོབ་པར་འདོད་པ་དང་།",
    "ཇི་ལྟར་གསུངས་པའི་དངོས་གྲུབ་རྣམས་ཐོབ་པར་འདོད་པས།",
    "རྟོག་པ་ཐམས་ཅད་དུ་གཏོགས་པའི་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་འཇུག་པར་བྱའོ།",
    "གང་དཀྱིལ་འཁོར་གང་དུ་འཇུག་པ་དེ་དཀྱིལ་འཁོར་དེ་བསྟན་ཅིང་དངོས་གྲུབ་དེ་ཡང་བསྟན་པར་བྱའོ།",
    "གལ་ཏེ་གསང་ཞིང་སྦ་བར་འཛིན་པར་ནུས་པ་ཞིག་གསང་ཞིང་སྦ་བའི་མན་ངག་སྦྱིན་པར་བྱའི་གཞན་དུ་ནི་མ་ཡིན་ནོ།",
    "གཞན་དུ་ན་དཀྱིལ་འཁོར་གཅིག་ཏུ་ཞུགས་པ་ཁོ་ནས་རྒྱུད་མ་ལུས་པའི་དོན་ཐོབ་པར་རུང་བ་ཡིན་ནོ་ཞེ་ན་དེས་ནི་མ་རྟོགས་པ་ཡིན་ཏེ།",
    "གཞན་ཡང་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་འཇུག་པ་གསལ་བ་ཁོ་ན་གསུངས་པ་དང་།",
    "དེ་ལྟར་ཡང་དག་པར་དམ་ཚིག་འདོད་པ་རྣམས་ཀྱིས་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་འདི་བཞིན་དུ་འཇུག་པར་བྱའོ།",
    "རྒྱུད་འདི་གྲགས་པ་ཉི་ཚེ་བྲི་བར་མ་ཟད་ཀྱི་རྒྱུད་གཞན་དག་ལས་བྱུང་བ་རྣམས་ཀྱང་ཅི་ནུས་སུ་བྲིས་ན་ཚོགས་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
    "ཚོགས་ཡོངས་སུ་རྫོགས་ན་ཕྱག་རྒྱ་རྣམས་ཀྱི་ངོས་གྲུབ་ཆེན་པོ་ཐོབ་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་ན་སྔགས་ཀྱི་ཚོགས་ཡོངས་སུ་རྫོགས་པར་འགྱུར་ཞེ་ན།",
    "བཟླས་པ་མང་པོ་བྱས་ན་ནི།",
    "ཞེས་བྱ་བ་ནི་བཟླས་བརྗོད་གྲངས་མང་པོ་བྱས་ནའོ།",
    "དེ་ནས་ངེས་པར་སྔགས་ཀྱི་དངོས་གྲུབ་ཐོབ་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་ན་ཚོགས་ཡོངས་སུ་རྫོགས་པར་འགྱུར་ཞེ་ན།",
    "དེ་ལྟར་ན་མ་རིག་པ་རབ་ཏུ་སྤངས་པའི་ཕྱིར་དང་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་འདི་ལས་ཚོགས་ཡོངས་སུ་རྫོགས་པར་འགྱུར་ཏེ།",
    "འདི་ཡང་ས་ལ་སོགས་པ་ཡོངས་སུ་འཐོབ་ཅིང་དངོས་གྲུབ་དམ་པའི་ཡུལ་གྱི་ཚོགས་ཡོངས་སུ་རྫོགས་པ་ཡིན་པར་ཤེས་པར་བྱས་ལ་ཚོགས་ཡོངས་སུ་རྫོགས་ནས་ཀྱང་།",
    "མྱུར་དུ་དངོས་གྲུབ་འཐོབ་པར་འགྱུར།",
    "དེའི་ཕྱིར་ཉིད་བདག་པོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་ལྟ་བུའི་སེམས་དེ་ཉིད་སྐུ་དང་གསུང་དང་ཐུགས་སྣང་བ་ཐ་མི་དད་པར་ཡོངས་སུ་བསྒོམས་ན་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་འགྱུར་རོ།",
    "དེ་ཉིད་ལེགས་པར་བསྒོམས་ན་སེམས་དཔའ་བརྟན་པ་ཞེས་བྱ་བའོ།",
    "རྡོ་རྗེ་སེམས་དཔར་ཡང་དག་འགྱུར།",
    "ནི་ཞེས་བྱ་བའི་སྒྲ་ནི་ཉིད་ཅེས་བྱ་བའི་དོན་ཏེ་དེ་རྣམས་ཉིད་ལས་རྡོ་རྗེ་སེམས་དཔར་འགྱུར་བའོ།",
    "འཛིན་བྱེད་ཅིང་ཞེས་བྱ་བ་ནི་ཁ་ཏོན་དུ་བྱས་ཏེ་འཛིན་པའོ།",
    "དེའི་ཆོ་ག་རྒྱས་པ་ནི་རྣམ་པར་རྒྱས་པའོ།",
    "རྣམ་པར་རྟོག་པའི་སྤོ་བས་བ་ཐམས་ཅད་དུ་རྟོག་པ་དང་བྲལ་བ་ལས།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་དེ་ལ་རྣམ་པ་སྣ་ཚོགས་དུ་མར་བརྟག་པའི་ཕྱིར་ན་རྟོག་པ་ཞེས་བྱའོ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ལས་བརྟག་པ་ཡིན་པའི་ཕྱིར་རྟོག་པ་ཞེས་བྱའོ།",
    "རྟོག་བདག་ཉིད་ནི་རྟོག་པའི་རང་བཞིན་ཏེ་གང་ལས་གདོན་མི་ཟ་བར་དངོས་གྲུབ་འདི་བརྟགས་ཤིང་རྣམ་པར་གཞག་ལ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ཐམས་ཅད་བསྡུས་ཏེ་བཞུགས་པ་ནི་རྡོ་རྗེ་སེམས་དཔའ་ཡིན་པས་ན།",
    "གྲུབ་སྦྱིན་ཞེས་རྟོག་པ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "འདིའི་ངེས་པའི་ཚིག་བསྟན་པ་ནི་དེའི་ཕྱིར་རྟོག་པ་ཞེས་གསུངས་སོ་ཞེས་བྱ་བ་སྟོན་ཏོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་ཡང་རྣམ་པར་རྟོག་པ་ལས་འབྱུང་ངོ།",
    "རྣམ་པར་མི་རྟོག་ཡེ་ཤེས་ལས།",
    "མཚན་མ་ཕྱག་རྒྱ་ཞེས་པར་གྲགས།",
    "དེའི་གཟུགས་བརྙན་གྱི་མཚན་ནི་ལག་པ་ལ་སོགས་པ་ཕྱག་རྒྱའི་ཐབས་སུ་བྱེད་པ་ལ་བྱས་ཏེ།",
    "གང་དེས་ཚིག་བརྗོད་པ་དེ་ཡང་དེའི་གསུངས་བརྗོད་ལ།",
    "ཞེས་བྱ་བ་ངེས་པར་བྱའོ།",
    "དབྱེ་བར་དཀའ་བ་ནི་བསྒྲགས་པར་བྱ་བ་མ་ཡིན་པའི།",
    "ཞེས་བྱ་བ་ནི་དཔེར་ན་རྒྱལ་པོས་བློན་པོ་དང་གྲོས་བྱེད་པ་ཡང་གསང་བར་བྱ་བའི་དོན་འགྲུབ་པར་བྱ་བའི་ཕྱིར་ཡིན་པས་ན་གྲོས་སུ་བརྗོད་པ་ཞེས་པའི།",
    "བདུད་ཀྱིས་དབྱེ་བར་དཀའ་ལ་ཐམས་ཅད་དུ་བསྒྲུབས་པར་བྱ་བ་མ་ཡིན་པས་ན་གསང་བ་ཉིད་ཡིན་ནོ།",
    "ལྡོག་པའི་མཚན་ཉིད་ལེགས་པར་བཅད་ཅིང་བར་ཆད་མེད་པར་ཉམས་སུ་བླངས་པ་འདིའི་བདེན་པ་དང་།"
  ]
}