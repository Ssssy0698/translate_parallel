    "ཉོན་མོངས་པས་ནི་སེམས་དཀྲུགས་ཤིང་།",
    "སྙན་པ་ནི་འཇིག་རྟེན་དང་ཐུན་མོང་གི་དངོས་གྲུབ་པོ།",
    "ཚིག་གི་བདག་པོ་སོ་སོང་ཀུན་ཏུ་རྟོག་པའོ།",
    "ཚིགས་སུ་བཅད་པ་དྲུག་གིས་ཞལ་གྱིས་བཞེས་པ་བསྟན་པ་ནི།",
    "ལ་ལ་ནི་འཇིག་རྟེན་གསུམ་བཀང་བས་མོ་ཉེབའི་འཁོར་རྣམས་འགུགས་པ་ཡིན་ནོཞེས་ཟེར་རོ།",
    "བདག་དོན་བདག་ལ་ཐུགས་བརྩེའི་ཕྱིར་ཞེས་བྱ་བ་ནི་སྔར་རང་གི་དོན་དུ་བསྟན་པ་གར་ཡིན་པ་དེ་གོ་ཚེས་༦ པ་ཁྲི་༢༡༣ ཟླ་རྩ་རིམ་ཙམ་དུ་རྗེས་སུ་བསྟནཔ་ཡིན་ཏེ།",
    "རང་གི་དོན་གཉིས་གཞན་གྱི་དོན་ཡིན་པའི་ཕྱིར་རོ།",
    "གསང་སྔགས་རིགས་ཚོན་ཐམས་ཅད་དང་ཞེས་བྱ་བ་ནི་རིགས་དྲུག་གི་བདགཉིད་ཅན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རིགས་གསུམ་ལ་ནི་རྣམ་པར་གཟིགས་ཞེས་བྱ་བ་ནི་སྐུ་གསུང་ཐུགས་ཀྱི་བདག་ཉིད་རྣམ་པར་སྣང་མཛད་ཀྱི་རིགས་སོ།",
    "མེ་ལེདལྟ་བུའི་ཡེ་ཤེས་ཀྱིས་འཇིག་རྟེན་གཟིགས་པའི་ཕྱིར་རོ།",
    "འདིར་དག་གི་དོན་ནི་འདི་ཡིན་ཏེ།",
    "བགེགས་ལ་ཕུར་བུས་བཏབ་ནས་ཚུ་གི་འོད་ཟེར་འཕྲོས་པ་ཉིད་ལས་རྡོརྗེར་བ་ལ་སོགས་པ་ཕྱི་རོལ་དུ་བསྲུང་བ་བྱས་ལ།",
    "དེའི་ནང་གི་མུ་ཁྱུད་ལ་ཨོ་སརྦདྷརྨ་བྱ་བ་ཞེས་བྱ་བ་ལ་སོགསུ་པའི་སྔགས་ཀྱིས་བསྐོར་བའོ།",
    "དེའི་དབུས་སུ་འཁོར་ལོ་གཉིས་པ་རྩི་བས་དྲུག་པ་དེའི་ཕྱི་རོལ་ཏུ་དབྱངས་ཡིག་བཅུགཉིས་ཀྱིས་བསྐོར་བ་དེའི་ནང་གི་མུ་ཁྱུད་ལ་ཨོཾ་སརྦ་ཏ་ཐྰ་ག་ཏ་ཞེས་བྱ་བས་བསྐོར་བའོ།",
    "སྦི་ཏོཧྲི་དི་ཛྙཱ་ན་མུརྟར་ཧཾ་བུ་དྷོ་བུདྡྷ་ནཱན་ཏྲ་དྷུ་བརྟི་ནཱཾ།",
    "གཉིས་སུ་མེད་པའི་འཛམ་དཔལ་དབྱངས་ཇི་ལྟ་བ་བཞིན་དུ་རིགས་དྲུག་གི་རྗེས་སུ་འགྲོ་བས་རྡོརྗེ་རྣོན་པོ་ལ་སོགས་བདྲུག་གོ།",
    "འོད་གསལ་བའི་རང་བཞིན་རྣམ་པར་དག་པ་རྡོ་རྗེ་ལས་མ་ལྗང་གུ་སྣ་ཚོགས་རྡོརྗེད་དྲིལ་བུ་བསཱམས་པ་སྟེ་རིག་པའི་ལྷ་མོ་རྣམས་སོ།",
    "འཇིག་རྟེན་པའི་ཞེ་སྡད་གི་གཉེན་པོ་ཡིན་པའི་ཕྱིར།",
    "འཇིག་རྟེན་པའི་ཕྲག་དོག་གི་གཉེན་པོ་ཡིན་པའི་ཕྱིར་ཁྲོ་བ་ཆེ་བའོ།",
    "ཟང་ཟིང་གི་སྦྱིན་པ་ཡོངས་སུ་རྫོགས་པ་འབྲས་བུ་ཕུན་སུམ་ཚོགས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཤེས་རབ་ཆེ་ན་བ་ལུས་འཆད་བནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པའི་རང་བཞིན་མེ་ཏོག་གི་སྣོད་བསྣམས་པའོ།",
    "སྟོབས་པོཆེ་ལ་ཐབས་ཆེ་བནི་སྟོབས་དང་ཐབས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་རང་བཞིན་རྡོརྗེ་མར་མེམ་དམར་མོ་ཕྱག་གཉིས་ནན་མར་མེའི་མཆོད་སྡོང་བསྣམས་པའོ།",
    "སྔམ་བཞིན་དུ་ལྷ་མོ་བཅུས་ཡོངས་སུ་བསྐོར་བའོ། ། ཁྱབ་པའི་བདག་ཉིད་ནི་ཐལ་གྱིས་གནོན་པའི་སྐྱེ་མཆོད་བརྒྱད་ཀྱི་སྐེད་དུ་ནམཁའ་དང་རྣམ་པར་ཤེས་པའི་ཟིལ་གྱིས་གནོན་པའི་སྐྱེ་མཆེད་བཅུདང་ལྡན་བས་སྦྱོར་བའི་བརྩོན་འགྲུས་ཀྱིས་བྲེལ་གྱིས་གནོན་བའི་སྐྱེ་བཆེད་ལ་འཇུག་པནིརྡོརྗེ་ལས།",
    "སྔ་མ་བཞིན་དུ་ལྷམོ་བཅུས་བསྐོར་བའོ།",
    "སྡམ་བཞིན་དུ་ལྷ་མོ་བཅུས་བསྐོར་བའོ།",
    "རང་གི་ངོ་བོའི་སྐོནས་སོ་སོར་ཀུན་ཏུ་རྟོག་པའོ།",
    "མྱ་དན་ལས་འདས་པའི་ཡེ་ཤེས་འབའ་ཞིག་གི་དྲི་ལས་བྱད་བས་ཐུགས་རྗེ་ཆེན་པོའོ།",
    "ཤེས་རབ་མཚོན་ཆེན་གྱི་ཡེ་ཤེས་ཀྱི་བདག་ཉིད་ཀྱིས་ཉོནམོངས་པ་འཇོམས་པའི་རྟོག་ཡིན་པས་ན་ཡེ་ཤེས་ཏོག་གེ།",
    "ཡང་དག་པའི་རྩོལ་བས་སྐྱེས་མ་ཐག་ཏུ་སྐད་ཅིག་མ་ལ་བྱབ་གྲུབ་པའི་སྤྲུལ་པའགྲེ་བའྀ་བདག་པ་དྲུག་པ་དམ་ཚིག་གི་ཕྱག་རྒྱའི་འཁོར་ལོ་སྦྱར་བའོ།",
    "བྱམས་པ་ཆེན་པོ་མི་གཡོ་བའི་ཁྲོ་ཙཱའི་ཐལ་པ་གཅིག་གིས་བསྒྱིངས་པནརྡོ་རྗིརྒྱལམཚནནོ།",
    "སེསོརརྟོག་པའི་བརྩོན་འགྲུས་ཀྱིག་དམོ་ཆེན་པོའི་གད་རྒྱངས་ཅན་ནི་རྡོ་རྗེ་གནོད་སྦྱིན་ནོ།",
    "སྒྲུབ་པ་ནན་ཏན་གྱི་བརྩོན་འགྲུས་ཀྱི་རྡོ་རྗེགད་མོཆེར་སྒྲེགས་པས་ན་རྡོ་རྗེ་ཁུ་ཚུར་རོ།",
    "ལྷག་མཐོང་གི་ས་མ་ཟད་པས་ན་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་མཚན་འཆང་བས་ན་པདྨའི་མེཏོག་མའོ།",
    "གཉིས་མེད་ཡེ་ཤེས་ཚུལ་འཆང་བཞི་ཟུང་འཇུག་གིའོ།",
    "ཉོན་མོངས་པ་མལུས་པ་སྤང་བ་སན།",
    "འཇིག་རྟེན་དང་ཐུན་མོང་དང་མཆོག་གི་དངོས་གྲུབ་སྒྲུབ་པའི་མཆོག་ཏུ་གྱུར་པས་དམ་པ་སྟེ་རྣམ་པར་སྣང་མཛད་དོ།",
    "ཉོན་མོངས་ཁམས་རྣམས་དག་པའི་བདག་ནི་ངན་སེད་ཀུན་འདྲེན་ནོ།",
    "འོད་དཔག་ཏུ་མེད་པའི་ཡིཤེསཀྱི་ཉོན་མོངས་པ་དང་།",
    "བདག་དང་བདག་གིར་ལྟ་བའི་སྒྲིབ་པའི་འདུ་ཞེས།",
    "རྣམ་པཟམས་ཅདཔའི་སྟོང་པ་བརྒྱད་ཡིནལདེའི་ཕྱེད་ཀུན་རྫོབ་ཀྱི་རྣམ་པ་བཞི་སྤངས་པའི་སྟོད་པ་ཉིདབཞི་བསྒོམསནས་དེ་དག་ལ་རང་གི་ངང་གིས་ཟུང་དུ་འཇུག་པའི་ཐེག་ལེ་ཅན་ནོ།",
    "གདོན་མི་ཟ་བར་གྲུབ་པ་ཉོན་མོངས་པ་དང་ཕུང་པོ་དང་འཆི་བདག་དང་ལྷའི་བུའི་བདུད་བཞིའི་དགྲ་བདག་འདི་ཀྱིསརྒྱུདབཏུལཞིངགཞནགྱིབདུད་བཞིའི་འཇགས་པ་སེལ་བར་མཛད་པའི་སྣ་ཚོགསརྡོརྗེ་བསྣམས་པ་སྐྱབས་སྤྱན་མཛད་པ་ལྗང་གུའོ།",
