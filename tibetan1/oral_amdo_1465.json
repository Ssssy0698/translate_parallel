    "མཇུག་མ་ལ་རེག་སྟེ་ཕྱགས་མ་ལྟ་བུའོ།",
    "ཞེས་ངོས་འཛིན་ནའང་གླང་པོ་ཆེའི་གཟུགས་ལ་དེ་དག་ཚང་བར་ཡོད་མོད་ཀྱི་ཡོངས་སུ་རྫོགས་པར་མ་ཤེས་སོ།",
    "ཕྱོགས་རེ་ཉམས་སུ་བླངས་པས་གོ་མི་ཆོད་དོ།",
    "རྒྱལ་པོ་ཆེན་པོ་ཞིག་གིས་རི་མོ་མཁན་རྣམས་ལ་ངའི་གཟུགས་ཡོངས་སུ་རྫོགས་པ་བྲིས་ཤིག་ཅེས་བསྒོ་ན།",
    "མོས་ན་གསང་སྔགས་གཞུང་བཞིན་སྒྲུབས།",
    "ལུགས་འདི་ལས་གཞན་པའི་ཕྱག་རྒྱ་ཆེན་པོའི་ངོས་འཛིན་དང་སྒྲུབ་ཚུལ་རྡོ་རྗེ་འཆང་གིས་མ་གསུངས་སོ།",
    "རིགས་དྲུག་གི་སྣང་བ་མ་འགགས་པར་ཤར་བ་འདི་མ་བཅོས་ཕྱག་རྒྱ་ཆེན་པོ་ཡིན་ཟེར་བ་དང་།",
    "རྒྱལ་པོ་ཁྱོད་ཀྱི་བོད་ཡུལ་འདིར།",
    "ཁྱོད་རེ་ཤིག་ཡིབ་ལ་སྡོད་ཅིག།",
    "ལྷོ་ཕྱོགས་ནས་བྲམ་ཟེའི་བུ་མུ་སྟེགས་ཀྱི་རིག་བྱེད་ལ་ཤིན་ཏུ་མཁས་པ་ཞིག་གིས་ཕྱི་ནང་གི་རྒོལ་བ་རྣམས་ཕམ་པར་བྱས་ཏེ།",
    "རྒྱལ་པོ་ཁྱོད་ཀྱི་ཡུལ་ཁམས་སུ་ཕྱི་རོལ་མུ་སྟེགས་པ་མི་འབྱུང་སྟེ།",
    "ཁོ་བོས་ཅུང་ཟད་ཕན་པར་བྱའོ་ཞེས་གསུངས་ནས་ཐུགས་དམ་མཛད་པས་ཆུ་ཁོལ་བ་ཆེད་གྲང་མོར་གྱུར་ཏེ།",
    "དེ་ནས་རིམ་གྱིས་སྟོད་ལུང་གི་མདའི་ལྷ་ཆུ་ཁར་ཕེབས་ནས་འདི་ན་ཆུ་མི་འདུག་གསུངས་ཏེ།",
    "ཁྱེའུ་དང་བུ་མོ་གཙང་མ་ལ་པྲ་འབེབས་པའི་ཆོ་ག་མཛད།",
    "བཀའ་ནན་དྲག་པོ་སྩལ་བས་མི་མ་ཡིན་རྣམས་ཀྱིས་རང་རང་གི་ཉེས་པ་ཁས་བླངས་ཤིང་ཕྱིན་ཆད་མི་བྱེད་པར་དམ་བཅས་སོ།",
    "སློབ་དཔོན་བཀྲོངས་པའི་ཕྱིར་གཤེད་མ་མཚོན་ཆ་བཟུང་བ་རྣམས་རེངས་པར་གྱུར་ཏོ།",
    "གཟུངས་སྔགས་ཟབ་མོ་དང་གདམས་པ་བསྟན་ཏེ།",
    "བུད་མེད་ཀྱི་ལུས་སྤངས་ནས་སྐྱེས་པར་གྱུར།",
    "བུད་མེད་ཤིན་ཏུ་མང་པོ་སྐྱེས་པར་གྱུར་ཏེ་ཁྱིམ་སྤངས་ཤིང་རབ་ཏུ་བྱུང་བས་བུད་མེད་ལ་སྲེད་པའི་སྐྱེ་བོ་མང་པོ་མ་དད་པར་གྱུར་ཏེ་མཐའ་འཁོབ་ཏུ་སོང་ནས།",
    "དགེ་སློང་ཨུཏྤ་ལའི་གདོང་གིས་དེ་རྣམས་དད་པར་བྱ་བའི་ཕྱིར་སོང་བས་སླར་ཡང་ཞེ་སྡང་བར་གྱུར་ཏེ།",
    "ལུས་ངག་གི་དགེ་སྦྱོར་རྣམས་འཕྲོ་བཅད་དོ།",
    "ལ་ལས་རང་གི་མཚན་མ་རྡོས་བརྡུངས།",
    "ལན་ལེགས་པར་བཏབ་སྟེ་རེ་འཇིགས་གཅིག་འདུག་གོ་གསུང་ངོ།",
    "ལན་གསུངས་པ་ཁྱེད་ཀྱི་ལུགས་དེ་ལྟར་ཅི་ཡང་མི་བསམ་མོ་ཞེས་ཟེར་བ་དེ་ནི།",
    "ཁྱུང་གི་ཕྲུ་གུ་ཐོག་མ་ནས་ལུས་ཡོངས་སུ་རྫོགས་པའི་འདབ་གཤོག་རྩལ་དང་ལྡན་པར་རང་བྱུང་བ་ནི་མི་སྲིད་ལ།",
    "མེ་ཏོག་ཀཱ་མ་ལ་ཤཱི་ལའི་ཕྱག་ཏུ་ཕུལ་ནས་རང་གི་གནས་སུ་སོང་ངོ།",
    "ཅི་ཡང་ཡིད་ལ་མི་སེམས་པར་ཉལ་བས་ཆོག་གོ་ཞེས་པའི་སྒོམ་ཡིག་བསམ་གཏན་ཉལ་ཆོག་གི་འཁོར་ལོ།",
    "དེ་ལ་གཟིགས་པས་དེའི་དོན་དགོངས་ཏེ་སྟན་ཅིག་གི་ཐོག་ཏུ་སྒོམ་ཚུལ་ཞུས་པས་སྒོམ་རིམ་བར་པ་མཛད།",
    "དེ་ལྟར་བས་ན་ཅི་ཡང་མི་བསམ་མོ།",
    "འདི་ལྟར་ཅི་ཡང་མི་བསམ་མོ་ཞེས་སྨྲ་བ་ནི།",
    "བདག་གི་ལྟ་བ་མཆོག་ཏུ་འཛིན་པ།",
    "རིགས་པ་དང་ལུང་དང་འགལ་བའི་དུག་གིས་བཏབ་པའི་ཚིག་གིས་མཁས་པ་ཐ་བདག་ལ་ལེགས་སུ་འདོད་པས་ཟས་དུག་ཅན་བཞིན་དུ་རྒྱང་རིང་དུ་ཡོངས་སུ་སྤང་བར་བྱའོ།",
    "ཞེས་བྱ་བར་གཞོན་ནུ་ཁྱོད་ཀྱིས་བསླབ་པར་བྱའོ།",
    "བ་ལང་གི་རྭ་ལས་འོ་མ་བཞོས་པ་བཞིན་ནོ།",
    "དེ་འགྲུབ་པ་ནི་གུས་པར་ཡུན་རིང་དུ་ཞི་གནས་དང་ལྷག་མཐོང་གི་རྣལ་འབྱོར་གོམས་པ་ལས་འགྱུར་ཏེ།",
    "ཞེས་གསུངས་པ་ལྟར་ཞི་གནས་དང་ལྷག་མཐོང་གི་ངོས་འཛིན་དང་སྒོམ་ཚུལ་རྒྱས་པར་གསུངས་སོ།",
    "མི་གང་བྱས་པ་མི་གཟོ་བ་ དེ་ནི་བདག་གི་ཁུར་ཆེན་ཡིན།",
    "བློན་པོ་ངན་པ་རྒྱལ་ཏོ་རེ་དང་ཅོག་རོ་ལེགས་སྒྲ་ལ་སོགས་པ་དང་གྲོས་ངན་བཤམས་ཏེ།",
    "ཅེས་པ་ལྟར་ཕྱག་རྒྱ་ཆེན་པོའི་གདམས་ངག་གི་མིང་ལ་འཁྲུལ་བས་དར་བར་གྱུར་ཏོ།",
    "ཁྱི་ཅལ་རྒྱུགས་སུ་མ་སོང་བ་བྱེད་འཚལ་ལོ།",
    "དེའི་འབྲས་བུར་གྱུར་པ་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བ་ཟུང་འཇུག་གི་ཡེ་ཤེས་དེ་ནི་དོན་དམ་པའི་བདེན་པ་ཡིན་ནོ།",
    "རྒྱལ་བ་མཆོག་གིས་མ་གསུངས་སོ།",
    "དོན་གྱི་ཡེ་ཤེས་ནི་རང་བྱུང་གི་ཡེ་ཤེས་མ་བཅོས་པ་ཡིན་ནོ།",
    "དཔལ་ཆེན་མོའི་གཉིས་མེད་གྲུབ་པ།",
    "དེ་མ་ཤེས་ན་དམ་ཚིག་གི་ཕྱག་རྒྱའི་དོན་མི་གོ་ཞིང་།",
    "རྒྱུད་ཟབ་མོ་ཉན་པའི་སྣོད་དུ་རུང་བར་བྱེད་པ་ཡིན་ནོ།",
    "དགའ་བ་བཞི་པོ་རེ་རེ་ལའང་སྐུ་གསུམ་ཐུགས་ཡེ་ཤེས་བཞི་བཞིར་ཕྱེ་བས་བཅུ་དྲུག་ཏུ་འགྱུར་ཅིང་།",
    "རྐང་ཐེབ་སེན་མོའི་ཁྱོན་ལ་གནས།",
    "འོད་གསལ་བ་ལས་ཟུང་འཇུག་ཏུ་མཚམས་སྦྱོར་བའི་རྗེས་དྲན་གྱི་ཡན་ལག་ལ་སྟོང་གཟུགས་ཕྱག་རྒྱ་ཆེན་མོ་བུད་མེད་ཀྱི་རྣམ་པར་སྣང་དགོས་ཞེས།",
    "ནང་གི་རྣམ་རྟོག་སྔོན་སོང་གི་བློས་བསྟན་པར་ཟད་དོ།",
    "ཕྱག་རྒྱ་ཆེན་མོ་རྗེས་དྲན་དང་ཏིང་ངེ་འཛིན་གྱི་སྐབས་སུ་བསྒོམ་ཞིང་།",
    "གདྨ་ལ་སོགས་པའི་ཆུ་བོ་ཆེན་པོ་བཞི་ཨ་ངང་གིས་རྒྱ་མཚོར་འཇུག་པ་བཞིན་ནོ།",
    "ས་བཅུ་གསུམ་པའི་ཕྱེད་ནོན་ནས་རྡོ་རྗེ་འཆང་གི་གོ་འཕང་ཐོབ་པ་དང་།",
    "རང་གི་ཉམས་སྣང་ཡིན་ནམ།",
    "སྔོན་བྱུང་གི་དཔེ་དགོད་པ།",
    "མོས་གུས་ཙམ་གྱིས་སེམས་བསྒྱུར་ནས།",
    "ཉམས་རྟོགས་དེ་འདྲ་ཞི་གནས་ཡང་དག་གི་གོ་ཡང་མི་ཆོད་ན་ཕྱག་རྒྱ་ཆེན་པོར་ལྟ་ཅི་སྨོས།",
    "སྔོན་མི་རྒན་པོ་ཞིག་གིས་རི་སུལ་དུ་བུད་ཤིང་ཚོལ་བ་ལ་སོང་བས།",
    "གཉའ་ལོ་སྐམ་པའི་ཕུང་པོ་ཞིག་གི་ཁྲོད་ན་ལུག་གུའི་ལྤགས་པ་ལ་བྱས་པའི་ཞྭ་གཅིག་འདུག་པ་རྙེད་ནས་མགོ་བོ་ལ་གྱོན་པས་མི་རྣམས་ཀྱིས་མཚན་དཔེས་བརྒྱན་པའི་སྐྱེས་བུར་མཐོང་ནས་གྲུབ་ཐོབ་ཀ་རུ་འཛིན་ཞེས་གྲགས་ཤིང་།",
    "དེའི་ཆུང་མ་མེ་ཏོག་གི་གཙུག་ཕུད་ཅན་གྱི་སྤྱི་བོ་ན་མེ་ཏོག་གི་མདའ་ལྔ་ཡོད་དེ།",
    "བུད་མེད་ལ་སྲེད་ཅིང་རྨི་ལམ་དུའང་ས་བོན་འཕྲོག་པ་དང་ཚངས་སྤྱོད་དྲི་མ་ཅན་དུ་བྱེད།",
    "འདོད་པའི་གཟུགས་འཛིན་ལྷ་མོ་དང་།",
    "གསོད་པའི་ཕྱིར་ལུས་ལ་འཇུག་པ་ལ་སོགས་གནས་སྐབས་དང་མཐར་ཐུག་གི་དངོས་གྲུབ་ལ་བར་དུ་གཅོད་པའི་བདུད་ལས་མང་དུ་གསུངས་པ་རྣམས་ཤེས་ནས་སྤང་བར་བྱ་སྟེ།",
    "སྤོང་ཚུལ་ནི་རྡོ་རྗེ་རྩེ་མོར།",
    "རང་གི་སེམས་ནི་བདུད་ཅེས་གསུངས།",
