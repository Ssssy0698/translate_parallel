    "པོ་ཏ་ལ་ལས་བུད་རྗེས་ངེད་ཚོ་རང་རང་སར་བུད་སོང་།",
    "རྗེས་སུ་དེ་གཉིས་ཀྱིས་འཕྲིན་བསྐུར་ནས་ད་རེས་ལྷ་སར་ཡོང་བ་ལ་ལག་ཡོང་མི་ཉུང་བ་ཞིག་ཡོད་ཅིང་།",
    "ངས་ཁྱོད་ཚོ་རྐང་འགྲོས་ཀྱིས་སོང་བ་ཡིན་ནམ་ཞེས་དྲིས་པས་རླངས་འཁོར་ལས་སོང་བ་གངས་སེང་འཚོལ་བ།",
    "ངས་ཁྱེད་ཚོ་སོང་བ་ཡར་འབྲོག་གཡུ་མཚོ་ཡིན་ངེས།",
    "འདི་ནི་གཙུག་ལག་ཁང་གི་ཨ་ཁུ་ཞིག་གིས་བདག་ལ་བྱིན་པ་ཡིན་པས་ཤིན་ཏུ་རྩ་ཆེན་ཞིག་ཡིན་ཟེར།",
    "དགུང་མོ་ངས་མེ་འཁོར་གྱི་མལ་ཁྲིའི་སྟེང་དུ་ལྷ་སའི་སྣེ་ཤན་མའི་སྐོར་ལ་བསམ་གཞིག་བྱས་པ་ཡིན།",
    "བདེན་དོན་འགེབས་པ་ནི་འཇིག་རྟེན་གྱི་ཆེས་ཆེ་བའི་ཉེས་པ་ཡིན་པ་ལས་སྣེ་ཤན་མ་དེ་དག་གིས་བསམ་གཞིག་ཙམ་ཡང་མི་བྱེད་དམ།",
    "དེ་དག་གི་ལན་ངས་གཏན་ནས་ཤེས་མ་བྱུང་མོད།",
    "ངས་ཤེས་པ་ནི་གཉིད་དུ་ཡུར་བའི་མཇལ་སྐོར་བ་འདི་དག་གིས་ལྷ་ས་འགྲོ་དུས་མཚར་སྣང་ཞིག་འཁྱེར་ནས་སོང་ན་ཡང་ཕྱི་རུ་བརྫུན་གཏམ་མང་བོ་འཁྱེར་ནས་འགྲོ་བཞིན་པ་དེ་རེད།",
    "ལུག་ལྤགས་གྱོན་པའི་སྤྱང་ཀིབསླུ་བྲིད་ཚོགས་པ་ཞིག་གི་གཡོ་སྒྱུའི་བཞིན་རས་རྗེན་པར་སྟོན་པ།",
    "ཁོ་ཚོས་བྱེད་ཐབས་ནི་མགོ་སྐོར་བཏང་ནས་སྒོར་མོ་ལེན་པ་དེ་རེད།",
    "ཁོ་ཚོས་མཐར་ཐུག་གི་བྱེད་ཐབས་དེ་ཡིན་ནའང་ཤེས་རབ་ཀྱི་ཚོམས།",
    "ཁ་ནས་ངོ་ཕུར་བྱུགས་རྫས་སོགས་འཚོང་བའི་ཚོང་གཉེར་བ་ཡིན་ཞེས་མགོ་སྐོར་གཏོང་བཞིན་པ་སྟེ་སྒོར་མོ་དེ་དག་ཀྱང་ཚོང་གཉེར་བའི་ནང་དུ་ཞུགས་པའི་ཐོག་མའི་འགྲོ་སྟངས་ཡིན་ཞེས་ཤོད་ཀྱིན་ཡོད་ལ་ཁོ་ཚོས་ཚོང་གཉེར་བྱེད་སྟངས་དེ་དེང་རབས་སྔོན་ཐོན་གྱི་ཚོང་གཉེར་བྱེད་སྟངས་ཏེ་སྔོན་གྱི་ཚོང་ཐམས་ཅད་བཟོ་ཚོང་སྤྱིའི་རྩ་འཛུགས་སུ་ཞུགས་ནས་བརྒྱུད་པ་ཡིན་པས་ཁྲལ་སོགས་མང་བོ་སྟེར་དགོས།",
    "སྒོར་མོ་དེ་ཁོ་ཚོའི་ཟླ་ཕོགས་སུ་སྟེར་བ་ཡིན་ཚུལ།",
    "ཐ་ན་ཚོགས་པ་འདི་འཛམ་གླིང་གི་རྒྱལ་ཁབ་སོ་སོར་ཡོད་ཚུལ།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་གྲོགས་པོའམ།",
    "ཁྱོད་ཀྱིས་མེ་འཁོར་གླ་ཙམ་ལས་མ་བཟུང་བར་སོང་ན་མེ་འཁོར་ས་ཚུགས་སུ་ཁོ་ཚོ་བསུ་བར་འོང་ངེས་རེད།",
    "ཁྱོད་ཀྱིས་ཁོ་ཚོའི་སྡོད་གནས་ཀྱི་ཆ་རྐྱེན་ཞན་ཞིང་བསླུ་བྲིད་ཡིན་པ་ཤེས་ནས་ཁོང་ཁྲོ་ཆེན་པོ་ལངས་ནའང་ཁོ་ཚོས་ཁྱོད་ཀྱི་གྲོགས་པོ་དེར་འཕྲད་དུ་མི་འཇུག་པར་ཉིན་བཅུ་ཕྲག་འགའ་ལ་བསླུ་བྲིད་གཏོང་ལ་བློ་ཁ་འགྱུར་རྗེས་ཁོ་ཚོས་ལྟ་སྐུལ་འོག་ཕ་ཡུལ་ལ་ཁ་པར་བཏང་ནས་ཚོགས་པར་བསྡུ་རྒྱུའི་སྒོར་མོ་དེ་སློང་དུ་འཇུག་པ་དང་ཞུགས་རྗེས་མི་འཚོལ་དགོས་པ་རེད།",
    "ཐ་ན་བོད་དུ་སྡོད་དུས་ལྟ་རྒྱ་མཐོང་རྒྱ་ཆུང་ཚུལ་ལག་ཏུ་སྒོར་མོ་མི་ཡོང་བའི་ཚུལ་སོགས་མི་ཚེ་ལ་འགྱུར་ལྡོག་བྱུང་ཚུལ་གྱི་སྐད་ཆ་མང་བོ་ཞིག་གླེང་ངེས་ཡིན།",
    "གལ་ཏེ་མི་མ་བཙལ་ན་ལག་ཏུ་སྒོར་མོ་ཅི་ཡང་མི་འོང་ལ་ཐ་ན་ཟ་འཐུང་གི་དཀའ་ངལ་ཀྱང་ཤིན་ཏུ་ཆེ།",
    "ལོ་འགའི་སྔོན་ལ་ཚོགས་པ་ཞིག་བཙུགས་པའི་ནང་དུ་མི་ཉིས་བརྒྱ་ཡོད་ཅིང་མང་ཆེ་བ་རེབ་ཀོང་དང་གཅན་ཚའི་མི་རེད་ཟེར།",
    "ཁ་གཏད་ས་བོད་ཀྱི་ཞིང་འབྲོག་མང་ཚོགས་དང་།",
    "རེད།",
    "ཁྱོད་ཚོས་རྒྱ་ནང་གི་ན་གཞོན་དག་རྒྱུ་ནོར་འཚོལ་བར་བོད་དུ་ཡོང་བ་འདི་ལ་འདང་ཞིག་བརྒྱབས་ན་དེ་མགོ་སྐོར་གཏོང་བ་ཤེས་རབ་ཀྱི་ཚོམས།",
    "ཁྱད་པར་རང་གི་མདུན་ལམ་རྩ་བ་ནས་རློག་པའི་བསླུ་བྲིད་ཀྱི་ཚོགས་པ་དེར་ཞུགས་པ་ནི་ཁྱོད་ཀྱི་མི་ཚེ་འདིར་སྒྱུར་ཐབས་མེད་པའི་ཆེས་ཆེ་བའི་ཕམ་ཁ་ཞིག་རེད།",
    "དེར་ཞུགས་པའི་བླ་སྤྲུལ་ཉུང་ཤོས་ཤིག་ཡིན་ལ་དེ་དག་གིས་ཀྱང་འདང་རྒྱག་རྒྱུ་ཞིག་ཡོད།",
    "ཁྱོད་ཚོ་བོད་མི་རིགས་ཀྱི་སྐྱབས་མགོན་དུ་བཀུར་བ་རེད།",
    "ཁྱོད་ཚོ་དེ་ལྟར་བཀུར་དོན་ཡང་བོད་མི་རིགས་ལ་ཕན་ཞིག་ཨེ་ཐོགས་སྙམ་པ་དེ་ཡིན།",
    "ལྷག་པར་རང་གི་སྤྲུལ་མིང་འདི་བེད་སྤྱད་ནས་སྒོར་མོའི་ཆེད་དུ་རང་ལ་དད་པ་ཡོད་པའི་མང་ཚོགས་བསླུ་དོན་མེད་དོ།",
    "རང་ཉིད་བསླུ་བྲིད་བཏང་བ་ཤེས་ན་ཡང་གཞན་ལ་གསལ་བོར་བརྗོད་མི་ཕོད་པ་རེད།",
    "ཁོ་ཚོས་དེ་ལྟར་བྱེད་དོན་ཡང་མི་གང་མང་ཞིག་ལ་མགོ་སྐོར་གཏོང་བའི་ཆེད་དུ་རེད།",
    "ཡིན་ན་ཡང་མི་མང་བོ་ཞིག་དེ་ལྟ་བུའི་སྡུག་གྱོང་སྐེམ་པོ་མི་མྱོང་བའི་ཆེད་དུ་གསལ་འདེབས་བྱ་དགོས་པ་རེད།",
    "སྐོར་ཞིག་དུས་རབས་སྔོན་མར་ཉམས་ཟིན་པས་དེང་སང་འཛམ་གླིང་ན་སྐད་རིགས་དྲུག་སྟོང་ཉེ་བ་ལས་བརྒྱ་ཆའི་གོ་དྲུག་ཡན་སྤྱོད་མཁན་གྱི་མི་འཛམ་གླིང་གི་མི་གྲངས་ཀྱི་བརྒྱ་ཆའི་བཞི་མ་གཏོགས་མེད་ཟེར།",
    "འཛམ་གླིང་གི་སྐད་རིགས་ཀྱི་ཕྱེད་ཀའི་ཡན་འཇིག་པའི་ཉེན་ཁའི་ཁྲོད་དུ་གནས་ཤིང་།",
    "ཕལ་ཆེར་གཟའ་འཁོར་གཉིས་ནང་དུ་སྐད་རིགས་གཅིག་འཇིག་གིན་འདུག་སྐད་རིགས་འདི་དག་ལས་བརྒྱ་ཆའི་བརྒྱད་ཅུ་ནས་དགུ་བཅུ་མ་འོངས་པའི་ལོ་ཉིས་བརྒྱའི་ནང་དུ་རྩ་མེད་དུ་འགྲོ་ངེས་རེད་ཟེར།",
    "ལོར་མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ཀྱི་རིག་དངོས་ཚན་ཁག་གིས་བསྒྲགས་པ་ལྟར་ན།",
    "འཛམ་གླིང་གི་སྐད་རིགས་ལས་བརྒྱ་ཆའི་དགུ་ཅུའི་ལོའི་སྔོན་དུ་ཉམས་ངེས་རེད་ཟེར།",
    "དེ་དག་གི་ཁྲོད་ན་སྐད་རིགས་འཇིག་བཞིན་པ་མང་བོ་ཞིག་ཡོད་དེ་དཔེར་ན།",
    "གཅིག་ནི་མི་རིགས་དེས་རང་གི་སྐད་རིགས་དོར་ནས་སྐད་རིགས་གཞན་ཞིག་དང་ལེན་བྱས་པ་དེ་རེད།",
    "རང་གི་སྐད་རིགས་དོར་ནས་གཞན་པའི་སྐད་རིགས་དང་ལེན་བྱེད་པ་ནི་ད་ལྟའི་མི་རིགས་ཁག་གི་སྐད་རིགས་ཉམས་པའི་རྒྱུ་རྐྱེན་གཙོ་བོ་ཞིག་ཡིན་ལ།",
    "མ་འོངས་པར་སྐད་རིགས་ཉམས་པའི་རྒྱུ་རྐྱེན་གཙོ་བོ་ཞིག་ཀྱང་རེད།",
    "དེ་བས་མི་རིགས་ཤིག་ལ་སྲུང་སྐྱོབ་བྱས་པ་རེད་ལ།",
    "རིག་གཞུང་ཞིག་ལ་སྲུང་སྐྱོབ་བྱས་པའང་རེད།",
    "ད་ལྟ་དེ་གོང་སྤེལ་དུ་གཏོང་བཞིན་ཡོད་པ་རེད།",
    "ཉིན་མོ་འདི་གཏན་འཁེལ་བྱས་པ་ནས་ཕ་སྐད་སྲུང་སྐྱོབ་ཀྱི་ལས་འགུལ་རབས་དང་རིམ་པ་སྤེལ་བཞིན་ཡོད་ཅིང་།",
    "འདི་ནི་བདག་གིས་གཏམ་རྒྱུད་ཅིག་བཤད།",
    "རང་གི་བུ་ཕྲུག་དག་གིས་ཀྱང་སྐད་འདི་ཕ་སྐད་དུ་བཟུང་ནས་སློབ་དགོས་རྒྱུན་འཁྱོངས་བྱས་པས།",
    "ང་ཚོ་ལྐུགས་པ་ཇི་བཞིན་ད་མ་དིག་ཅིག་ཡིན་ལ།",
    "ལག་པ་དང་མིག་གིས་བརྡ་བྱས་ནས་མ་གཏོགས་རོགས་བྱེད་མི་ཐུབ།",
    "ཕལ་ཆེར་གཟའ་འཁོར་གཉིས་ནང་དུ་སྐད་རིགས་གཅིག་འཇིག་གིན་འདུག་ཟེར།",
    "སྐད་རིགས་འདི་དག་ལས་བརྒྱ་ཆའི་བརྒྱད་ཅུ་ནས་དགུ་བཅུ་མ་འོངས་པའི་ལོ་ཉེས་བརྒྱའི་ནང་དུ་རྩ་མེད་དུ་འགྲོ་ངེས་རེད་ཟེར།",
    "ང་ཚོས་རང་སྟེང་ལ་བསམ་བློ་ཞིག་བཏང་ན་ང་ཚོའི་མི་རིགས་འདིའི་སྐད་དང་ཡི་གེ་ཡང་ངེས་པར་སྲུང་སྐྱོབ་བྱ་དགོས་ཏེ།",
    "བོད་ཀྱི་ས་ཆ་སྐོར་ཞིག་གིས་ཡུལ་མི་རྣམས་ཀྱིས་ཤེས་རབ་ཀྱི་ཚོམས།",
    "བོད་མི་སྐོར་ཞིག་གིས་ད་ལྟ་རང་ཉིད་བོད་ཡིན་པ་ཡང་ཤེས་ཀྱིན་མེད།",
    "ང་ཚོ་མི་རེ་རེས་ཀྱང་རང་གི་མི་རིགས་འདིར་གདོན་འོས་པའི་ནུས་པ་ཞིག་བཏོན་མ་མྱོང་བ་དང་།",
    "ལྷག་པར་བོད་ཀྱི་ཕ་མ་མང་བོ་ཞིག་གིས་རང་གི་བུ་ཕྲུག་ལ་ཕ་སྐད་སྦྱོང་དུ་མི་འཇུག་ལ།",
    "ཐ་ན་ང་ཚོ་མི་རེ་རེས་ཀྱང་སྐད་དང་ཡི་གེ་ལ་དོ་སྣང་ཅི་ཡང་བྱེད་ཀྱིན་མི་འདུག་དེ་ནི་མི་རིགས་ཀྱི་བུ་ཕྲུག་ཚོས་རང་ཉིད་མི་རིགས་ཀྱི་རྗེས་རབས་པ་ཞིག་ཡིན་པའི་འགན་མ་འཁུར་བ་དང་ཕ་མ་ཚོས་རང་ཉིད་མི་རིགས་ཤིག་གི་ཕ་མ་ཞིག་ཡིན་པའི་འགན་མ་འཁུར་བ་མ་ཟད།",
    "དེ་བས་ང་ཚོ་བོད་ངོ་མ་ཞིག་བྱེད་པའི་ཆེད་དུ་བོད་སྐད་གཙང་མ་ཞིག་དང་ཡི་གེ་དག་མོ་ཞིག་སྦྱོང་དགོས་ལ།",
    "དེ་ནི་མི་རིགས་ཀྱི་ལས་དོན་སྒྲུབ་མཁན་ཞིག་མ་ཡིན་པར་མི་རིགས་ལ་གཏོར་བརླག་གཏོང་མཁན་ཞིག་རེད།",
    "ང་ཚོས་ཆེན་པོ་ཞིག་ལས་མི་དགོས་ཏེ་མི་རིགས་ཀྱི་སྲོག་རྩ་ལ་གངས་སེང་འཚོལ་བ།",
    "གཏོར་བརླག་གཏོང་བའི་ཚད་གཞིའང་མདའ་མདུང་གི་མཚོན་ཆ་བཟུང་བ་དེ་མ་ཡིན་པར་སྐད་དང་ཡི་གེ་རྩ་མེད་དུ་གཏོང་བ་དེ་ཡིན་ནོ།",
    "དེ་བས་ངས་ཁྱོད་རང་འཇིག་རྟེན་འདིར་ཆེས་ཕུལ་དུ་བྱུང་བའི་མི་ཞིག་ཏུ་འགྱུར་བའི་རེ་བ་བྱས་ཡོད་ཅིང་།",
    "ཁྱོད་ཀྱི་མ་འོངས་པས་ཀྱང་ཁྱོད་རང་ཆེས་ཕུལ་དུ་བྱུང་བའི་མི་ཞིག་ཏུ་འགྱུར་བའི་རེ་བ་བྱས་ཡོད།",
    "གཞན་ལས་ཁྱད་པར་འཕགས་པའི་མི་ཞིག་ཏུ་འགྱུར་མིན་དེ་ཁྱོད་རང་ཉིད་ལ་ཐུག་ཡོད་དེ།",
    "ཁྱོད་ཀྱིས་རང་ཉིད་ལེགས་པོ་ཞིག་ཏུ་འགྱུར་བའི་རེ་བ་ཡོད་ན་ལེགས་པོར་འགྱུར་ཐུབ་ལ།",
    "རང་ཉིད་ལ་ཡིད་ཆེས་བྱོས་དང་ཁྱོད་ནི་འཇིག་རྟེན་ན་ཆེས་ལེགས་པའི་བྱིས་པ་དེ་མིན་པའི་ངེས་པ་ག་ལ་ཡོད།",
    "འོན་ཀྱང་རིག་གཞུང་གི་ཁྱབ་ཁོངས་སུ་ཕུ་ནུའི་བརྩེ་དུང་དང་གྲོགས་པོའི་མཛའ་བརྩེ་ཟེར་བའང་མེད།",
    "དེ་བས་ཁྱོད་ཀྱིས་ཀྱང་ལོ་དུ་མར་སྙན་ངག་འཚོལ་བ་ལས་མྱུར་དུ་འཕྲུལ་རྟར་ཞོན་ན་ཅུང་མི་ལེགས།",
    "སྙན་ངག་གི་སྐད་ཆ་ནི་སྤྱི་སྐད་ཀྱི་དྭངས་མ་ཡིན་པ་ལས་ཡུལ་སྐད་དང་འགྱུར་ཡིག་གྱོང་རོ་འགའ་བཙན་གྱིས་བསྒྲིགས་པ་དེ་ག་ལ་ཡིན།",
    "བུ་མོ་དང་ལུས་ཕྲ་མ།",
    "བུ་མོ་ཞེས་བརྗོད་ཚེ་སྤྱིར་བཏང་གི་གོ་བ་ལས་མེད་ལ།",
    "སྒེག་མོ་ཞེས་བརྗོད་ཚེ་བུ་མོ་དེར་འཇོ་སྒེག་གི་ཉམས་ཐོན་པས་སྐབས་བབས་བུ་མོ་དེ་སྐྱོ་གདུང་དུ་ཡོད་ཚེ་སྒེག་མོ་དང་ལུས་ཕྲ་མ་ཞེས་པའི་ཐ་སྙད་འདི་བཀོལ་མི་རུང་།",
    "ཚིག་གི་ནུས་པ་རིམ་བཞིན་རྒྱས་པས་སྙན་ངག་གི་འགྱུར་བ་ཐོན་ངེས་ལ་སྙན་ངག་ལ་ཆགས་སྡང་གི་རོ་མངར་རྒྱས་པས་ཀློག་པ་བོའི་ཉམས་སྣང་དུ་འདྲེས།",
    "སོར་མོས་བསྐུལ་བའི་རྒྱུད་མངས་སྒྲ།",
    "སྙན་ངག་པ་མི་རིགས་ཀྱི་བསམ་བློའི་སྣེ་ཁྲིད་ཡིན་ཞེས་ན་གཞོན་མང་བོ་ཞིག་གིས་ཤེས་རབ་ཀྱི་ཚོམས།",
    "འདང་བརྒྱབས་ན་སྙན་ངག་པ་ཡོད་ཚད་བསམ་བློ་བ་ཡིན་པའི་ངེས་པ་མེད་པས་སྙན་ངག་པས་བསམ་བློའི་སྟེང་ནས་མི་རིགས་ལ་སྣེ་ཁྲིད་བྱ་རྒྱུ་ཟེར་བ་ནི་སྐད་ཆ་ཆེས་སྙན་པོ་ཞིག་སྟེ་འཇའ་ཚོན་གོས་སུ་རེ་བའི་རྨི་ལམ་ཙམ་དུ་ཟད་དོ།",
    "བསམ་བློའི་སྟེང་ནས་མི་རིགས་འདིར་དབུ་ཁྲིད་བྱེད་པ་ལ་བསམ་བློ་བ་ཞིག་དགོས་པས་ན་དེང་གི་བོད་ཀྱི་སྙན་ངག་པ་རྣམས་མཚན་ཉིད་རིག་པར་མཚོན་ན་ཁྭ་ཏ་མདའ་ཡིན་མོད།",
    "ང་ཚོ་ལ་རང་ཚུགས་དགོས་པ་མ་ཟད་ང་ཚོའི་སྙན་ངག་ལ་དེ་བས་ཀྱང་རང་ཚུགས་དགོས་སོ།",
    "ང་ཚོའི་སྙན་ངག་གི་ཚུར་ལེན་རིང་ལུགས་གངས་རྒྱན་མེ་ཏོག་ཏུ་འཁོད་པའི་དེང་རབས་སྙན་ངག་ལས་འཕྲོས་པའི་ལྟ་ཚུལ་འགའ་ལ་བལྟ་ཀློག་བྱ་རྒྱུ་རེ་བ་ཆེ་སྟེ་དེ་དག་ན་ངས་སྙན་ངག་བྲིས་པའི་ཉམས་མྱོང་འགའ་རེ་བྲིས་ཡོད་པས་ཁྱེད་ལ་བློ་སྐྱེད་རེ་འབྱུང་ན་ཐང་།",
    "ཚོགས་པའི་སྐོར་གྱི་ལྟ་ཚུལ་རེ་གཉིས།",
    "ཚོགས་པའི་སྒྲིག་ཡིག་ནི་ཚོགས་པའི་ཚད་གཞི་ཡིན་པས་ཚོགས་གཙོ་དང་ཚོགས་མི་སུ་ཡིན་རུང་སྒྲིག་ཡིག་ལྟར་བྱ་བ་བསྒྲུབ་དགོས།",
    "མི་སུས་ཀྱང་སྒྲིག་ཡིག་དང་མི་བསྟུན་པར་རང་ཤེད་བྱེད་མི་ཆོག་སྟེ་དེ་ནི་ཚོགས་པ་ཞིག་གི་སྤྱིའི་རྒྱུན་ཤེས་རེད།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་བདག་དགོང་ཚོགས་འདི་ལ་ཞུགས་པའི་སྐལ་བ་ལྡན་སོང་།",
    "འཚོག་འོས་པའི་རྗེས་དྲན་འདི་ད་ལྟའི་བར་དུ་འཚོགས་མ་ཐུབ་པ་ནི་བོད་མི་དག་གི་ངོ་ཚ་ཞིག་ཀྱང་ཡིན་པ་མ་ཟད།",
    "ཡིན་ན་ཚོགས་འཕྱི་བའི་དགོང་ཚོགས་འདི་ད་ལྟའི་བར་དུ་འཚོགས་པའི་མི་སྣའི་རྗེས་དྲན་ལས་ཆེས་རིན་ཐང་ལྡན་པ་ཞིག་ཡིན་ལ།",
    "རོལ་མོ།",
    "ཚོགས་མགོ་བརྩམས་པ་ནས་ཐལ་མོ་བརྡབ་པའི་སྒྲ་ནི་རྒྱུན་ཆད་མེད་པར་ཆུ་ཡི་རྦ་རླབས་བཞིན་དུ་འཕྱོ་འོང་།",
    "དེ་བས་ཐེངས་འདིའི་དགོང་ཚོགས་ནི་ཆེས་དམིགས་བསལ་གྱི་དགོང་ཚོགས་ཤིག་ཡིན་ཞིང་།",
    "ཆེས་དམིགས་བསལ་གྱི་དགོང་ཚོགས་ཤིག་ཡིན་པ་ལྟད་མོ་བ་ཀུན་གྱིས་ཀྱང་ཤེས་འདུག་པ་འདྲ།",
    "དེ་བས་སློབ་དཔོན་ཐོན་མི་ནི་བོད་ཀྱི་ཉི་མ་ནས་འཛམ་གླིང་གི་ཉི་མར་འགྱུར་བཞིན་ཡོད།",
    "རང་གི་ནུས་པས་སྲི་ཞུ་བསྒྲུབ་དགོས་ལ།",
    "དེ་བས་ངས་དགོང་ཚོགས་འདི་དང་འདི་ལྟ་བུ་འཚོགས་པ་ལ་དགའ་མགུ་ཡི་རང་སྐྱེས་པ་མ་ཟད།",
    "ལས་འདིའི་སློང་མཁན་དེ་དག་རྣམ་དཔྱོད་ལྡན་ཞིང་བློ་གྲོས་ཡངས་པ་ཡང་ཤེས་སོང་།",
    "ད་ལྟ་བོད་ལ་དྲིན་དུ་བྱས་ཀྱང་དྲིན་མི་ཤེས་པའི་དཔེ་ལྟར་སོང་ཞིང་།",
    "རེད་དེ།",
    "དེ་ནི་རང་ཉིད་ཀྱི་འཕེལ་རྒྱས་འལ་བསམ་གཞིག་བྱས་པ་ཡིན་ལ་རང་ཉིད་རུལ་སུངས་སུ་གྱུར་པ་ལ་བརྟེན་ནས་རང་ཉིད་ཉམས་རྒུད་དུ་འགྲོ་བ་རེད།",
    "དོན་བཅས་གང་ཐད་ནས་གཞེན་སྐུལ་བྱས་པ་ཞིག་རེད།",
    "མི་རིགས་ཤིག་གི་མདུན་ལམ་ལ་བསམ་དུས་དེ་རིང་གི་འགྲོ་སྟངས་ལས་སང་ཉིན་གྱི་གནས་བབས་བསམ་སྟེ་སང་ཉིན་གྱི་གནས་བབས་དེའི་ཕྱིར་དུ་དེ་རིང་བྱ་བ་གང་དང་གང་ཞིག་སྒྲུབ་དགོས་པ་དེ་རེད།",
    "ང་ཚོས་རང་སྟེང་ལ་བསམ་གཞིག་ཤིག་བཏང་ན་འུ་ཅག་སུ་ཡིན་ཡང་འདྲ།",
    "མི་རིགས་གཞན་གྱི་སྐད་མ་འདྲེས་པར་བོད་སྐད་རྐྱང་རྐྱང་གི་ལམ་ནས་ཁ་བརྡ་སྐྱིད་པོ་ཞིག་བྱེད་ཐུབ་བམ།",
    "ཕལ་ཆེར་དེ་རིང་གི་ཚོགས་གྲལ་ན་མི་ཚེ་འདིར་བོད་ལྭ་གྱོན་མ་མྱོང་བའང་ཡོང་རྒྱུ་རེད།",
    "དེ་བས་ང་ཚོའི་མི་རིགས་འདིའི་མདུན་ལམ་ག་འདྲ་ཞིག་ཡིན་ནམ།",
    "ང་ཚོས་དབྱིན་ཇིའི་ཡི་གེར་སྦྱོང་དགོས་བྱུང་བ་འདི་མི་རིགས་འདིའི་ཆེས་ངོ་ཚ་རེད།",
    "འོན་ཀྱང་མ་སྦྱངས་ན་མི་ཆོག་ང་ཚོ་རྗེས་སུ་ལུས་པས་ངེས་པར་དུ་ཁོ་ཚོ་ལས་ལེགས་ཆ་ལེན་དགོས།",
    "བསྙེགས་མི་རུང་ཞེས་གསུངས་པ་ལྟར་རེད།",
    "དེའི་ཕྱིར་ང་ཚོ་ན་གཞོན་རྣམས་ཀྱིས་བསམ་གཞིག་མང་ཙམ་བཏང་ནས་ཧོལ་རྒྱུགས་ཉུང་ཙམ་བྱེད་དགོས།",
    "འོན་ཀྱང་དེ་ནི་ཆ་མི་ཚང་བའི་ལྟ་ཚུལ་ཕྱེད་ཀ་ཞིག་རེད།",
    "དེ་རིང་གི་ང་ཚོའི་འོས་བབས་ནི་ནང་བསམ་བློ་སྲུང་སྐྱོབ་དང་དར་སྤེལ་ལས་གཞན་དངོས་པོའི་དཔལ་ཡོན་ཡར་རྒྱས་པའི་ཐད་ལ་འབད་དགོས།",
    "འདི་ནི་ང་ཚོའི་མི་རིགས་འདིའི་ད་ལྟའི་བསམ་བློའི་གོ་རྟོགས་དང་འབྲེལ་བས།",
    "དེའི་རྒྱུ་རྐྱེན་གཙོ་བོ་བྱ་བ་ལག་ཏུ་མི་འོང་ཞེས་པ་འདི་རེད།",
    "འདི་ལྟར་སོང་ན་མི་རིགས་འདིས་རང་ཉིད་རང་ཉིད་ཀྱི་མགོན་དུ་བྱེད་པ་ཕར་ཞོག་ཆེས་ཉེན་ཁ་ཆེ་བའི་ཉིན་མོ་ཞིག་ཐོན་པ་རེད།",
    "གུར་ཀུམ་ཆུན་པོར་འབྲེལ་ཏེ་བོད་ཀྱི་རྩོམ་རིག་གི་བསམ་བློའི་ཁ་ཕྱོགས་གླེང་བ།",
    "མི་རབས་ཤིག་གི་ཆེད་དུའང་ཡིན།",
    "ཨར་མའི་དགའ་བ་རྒྱ་མཚོ་སོགས་ཀྱིས་ཤེས་བརྩོན་གྱི་རྩལ་ལས་བསྐྲུན་ཅིང་རྒྱུན་འཁྱོངས་ཐུབ་པ་བྱུང་བ་འདི་ང་ཚོ་དགའ་འོས་པ་ཞིག་རེད།",
    "ཚིགས་བཅད་མང་བོས་ཚིག་གི་ལོ་མ་རྒྱས་པ།",
    "མི་རིགས་གཞན་པའི་ཟུར་ཟའི་རི་མོ་བཤུས་ཏེ་སྤེལ་བ།",
    "ངས་འདི་ནས་ནང་བསྟན་དང་འབྲེལ་བའི་བསམ་བློ་དང་སྒྱུ་རྩལ་གླེང་བ་འདིས་མང་བོ་ཞིག་གི་དགོངས་པར་ཕྱོགས་ཞེན་ཆེ་དྲགས་པའམ།",
    "ཡང་ན་ནང་བསྟན་གྱི་བསམ་བློ་དང་སྒྱུ་རྩལ་དེས་བོད་ཀྱི་བསམ་བློ་དང་སྒྱུ་རྩལ་གོ་ཆོད་སྙམ་ངེས་རེད།",
    "མིག་ཟུང་བཅས་ཡོད་ཚད་ཤར་ཕྱོགས་ལ་གཏོད་པའི་སྐབས་འདིར་ངས་ཀྱང་དེ་ལྟ་བུའི་མིག་ཟུང་གཡར་ནས་རང་རེའི་བོད་ཀྱི་རིག་གཞུང་འདིར་བལྟས་ན་བོད་ཀྱི་རྩོམ་རིག་གི་བསམ་བློ་ནི་དེ་ལྟ་བུའི་གསེར་གྱི་གཏེར་ཁའི་ནང་དུ་འགྲིམ་ཞིང་སྒྱུ་རྩལ་ནི་དེ་ལྟ་བུའི་གཏེར་ཁ་དེ་འདོན་པའི་ལག་ཐབས་བཟུང་ན་འོས་སྙམ།",
    "ཅེས་གསུངས་པ་ལྟར་ནང་བསྟན་གྱི་རྩོམ་རིག་གི་བསམ་བློ་རབ་རིབ་དང་ཆགས་སྡང་།",
    "སྒྱུ་རྩལ་གྱི་ཐབས་ལམ་བཅས་ནི་དེའི་ཡན་ལག་ཅིག་རེད།",
    "དེ་བས་ང་ཚོའི་སྙན་ངག་པ་རང་གི་མི་རིགས་ཀྱི་སེམས་ཁམས་དང་།",
    "ཞིག་ནི་ང་ཚོ་སོ་སོའི་སེམས་ཀྱིས་བཟོས་ཤིང་སེམས་ཀྱི་ཆ་རྐྱེན་འགའ་ཞིག་མ་བྱུང་བས་རང་ཉིད་ལ་སྡུག་བསྔལ་མྱོང་བཞིན་ཡོད།",
    "དེ་ཡིས་ང་ཚོས་རང་ཉིད་ལ་རྟག་ཏུ་མནར་གཅོད་གཏོང་གིན་ཡོད་ལ་གཞན་ལའང་མནར་གཅོད་གཏོང་བཞིན་ཡོད།",
    "ད་ལྟའི་བོད་ཀྱི་རྩོམ་རིག་གི་བསམ་བློ་ལ་བལྟས་ན་རང་ཉིད་ཀྱི་ཆེད་དུ་གཞན་མཐའ་དག་བེད་སྤྱོད་གཏོང་བའི་བསམ་བློ་ཡིན་ལ།",
    "གལ་ཏེ་དོར་སོང་ན་ང་ཚོའི་གངས་སེང་འཚོལ་བ།་",
    "དེ་ལྟ་བུའི་བསམ་བློ་དེ་འཛམ་གླིང་གི་ཁྱད་ནོར་དུ་འགྱུར་བཞིན་ཡོད་ལ།",
    "ང་ཚོའི་རྩོམ་རིག་འཛམ་གླིང་གི་རྩོམ་རིག་གི་ཁྲིར་འགོད་པ་ལ་དགེ་མཚན་ཆེན་པོ་ཞིག་གདོན་ངེས་ཡིན་ནོ།",
    "དེ་ཐབས་ལམ་གང་ཞིག་གིས་རྩོམ་རིག་དང་དབྱེར་མེད་དུ་འདྲེས་པའམ།",
    "ང་ཚོས་རང་ལ་བདེ་བ་འཐོབ་པའི་ཆེད་དུ་རང་ཉིད་ཁོ་ན་ལས་མི་བསམ་པ་འདིས་གཞན་ལ་གནོད་པ་སྐྱེལ་བ་དང་།",
    "དེ་ལ་བརྟེན་ནས་གཞན་གྱིས་འཁོན་ལན་བསློགས་པས་རང་ཉིད་ཀྱི་ཁོང་ཁྲོ་ཆེ་རུ་འགྲོ་རྒྱུ་དང་སྔར་ལུས་ལྷག་པར་གཞན་ལ་གནོད་པ་སྐྱེལ་ངེས་རེད།",
    "ང་ཚོས་ཤེས་དགོས་པ་ནི་བདེ་བ་ཡོད་ཚད་སེམས་ལས་འབྱུང་དགོས་པ་དེ་ཡིན།",
    "དེ་བས་ང་ཚོ་བྱ་བ་གང་ཞིག་བསྒྲུབས་ནའང་འདྲ།",
    "ཡིན་ནའང་མི་དག་གིས་རང་ཉིད་རང་ཁོ་ན་དང་གཞན་དག་གཞན་ཁོ་ན་ལས་དེའི་སྟེང་ན་ལྟོས་བཅས་ཀྱི་རང་གཞན་ཞིག་ཡོད་པར་བསམ་བློ་གཏན་ནས་འཁོར་གྱིན་མེད།",
    "དོན་དངོས་སུ་གཞན་དེ་དག་ནི་རང་དང་འདྲ་སྟེ་དེ་དག་ཁྱོད་རང་ཉིད་ཀྱི་གྲོགས་དང་གཉེན་ཉེ།",
    "ལྷག་བསམ་ཟོལ་མེད་བཅས་རེད།",
    "དེ་ལྟར་གཞན་དེ་ཁྱོད་ཀྱི་དགྲ་བོ་ཡིན་ན་ཁྱོད་ཀྱི་སེམས་སུ་འཚེར་སྣང་དང་དོགས་སྣང་གིས་ཁྱོད་ལ་བདེ་བ་དང་ཞི་བདེ་ཞིག་ནམ་ཡང་འབྱུང་མི་ཐུབ་པའི་ཁར་ཁྱོད་ཀྱི་ཞེ་སྡང་དང་ཁོང་ཁྲོ་ཅི་ཙམ་རྒྱས་པ་དེ་ཙམ་ཁྱོད་ཀྱི་དགྲ་བོ་དེ་དེ་ཙམ་གྱིས་ཁྱོད་ཀྱི་དགྲ་བོར་འགྱུར་ངེས།",
    "ང་ཚོས་འདི་ལས་བཟང་བ་དང་ལམ་ལྷོངས་ཆེ་བ།",
    "ང་ཚོའི་མ་འོངས་པའི་གནས་སྟངས་དང་།",
    "རང་གི་བདེ་བ་དགྲ་ལྟར་འཇོམས།",
    "ཞེས་མ་རིག་པ་ནི་འཇིག་རྟེན་རྒུད་པ་མཐའ་དག་གི་འབྱུང་རྩ་ཡིན་པར་གསུངས་ཡོད།",
    "ཐ་ན་རྒྱལ་ཁབ་དང་རྒྱལ་ཁབ་བར་དུ་གཡུལ་འཁྲུག་དང་ཕྱོགས་སོ་སོར་མུ་གེ་སོགས་དཀའ་ཉོག་སྣ་ཚོགས་འབྱུང་གིན་ཡོད།",
    "དམག་འཁྲུག་སོགས་དང་འབྲེལ་ནས་ཡོད་ནའང་མཐར་གཏུགས་ན་འགྲོ་བ་མིའི་སེམས་པ་སྟེ་རང་ཉིད་གཅེས་པར་འཛིན་པའི་མ་རིག་པ་དེར་འབྲེལ་ཡོད་པ་རེད།",
    "རྒྱལ་ཁབ་དང་ཚོགས་པ།",
    "དེ་བས་ང་ཚོས་སྙེག་པ་ནི་འཇིག་རྟེན་ཞི་བདེ་དང་ལྷིང་འཇགས།",
    "ཕྱིའི་དངོས་པོ་ཡར་རྒྱས་ག་འདྲ་ཕྱིན་ན་ཡང་ནང་བསམ་བློའི་ཆ་ནས་ཡར་རྒྱས་སུ་མ་སོང་ན་འཇིག་རྟེན་ཞི་བདེ་ཡོང་མི་ཐུབ་ལ་སེམས་པའི་ཞི་བདེ་དེ་བས་ཀྱང་ཡོང་མི་ཐུབ་པའི་ཁར་མི་རང་ཉིད་ལ་བདེ་སྐྱིད་ཅིག་ཀྱང་གཏན་ནས་ཡོང་མི་ཐུབ།",
    "དེ་དག་གི་སྡུག་བསྔལ་ཐམས་ཅད་རང་གི་ཁུར་དུ་འཁྱེར་བའི་སེམས་པ་འབྱུང་ངེས་ཡིན།",
    "དེ་ལྟ་བུའི་བསམ་བློ་ལྡན་པ་དག་གིས་བྱ་བ་གང་ཞིག་བསྒྲུབ་ནའང་འདྲ།",
    "ཐ་ན་གཞན་ལ་ཕན་པ་ཉུང་བསྒྲུབ་ཐུབ་ན་རང་ཉིད་མི་གཙང་བའི་དོང་དུ་ལོ་བརྒྱར་སྡོད་དགོས་ཀྱང་ཕངས་སེམས་མེད་ལ་གཞན་གྱི་ཆེད་དུ་རང་གི་སྲོག་གཏང་དགོས་རུང་འགྱོད་པ་ཅི་ཡང་མེད།",
    "གལ་ཏེ་ཡང་དག་པའི་བློ་གྲོས་ཤིག་མེད་ན་ཁྱོད་མི་ཁ་ཚང་ཞིག་གཏན་ནས་མིན།",
    "བྱས་ན་ཆེན་པོ་ཞིག་ཏུ་འགྱུར་ངེས་རེད།",
    "དེ་ལྟ་བུ་ཞིག་ཏུ་འགྱུར་བའི་ཆེད་དུ་རང་རེའི་མཁས་པ་སྔ་མས་རིག་པ་ནངས་པར་འཆི་ཡང་སློབ་ཟེར་བ་རེད།",
    "བསམ་བློ་འདི་རང་རེའི་བོད་དུ་ལོ་སྟོང་ལྷག་གི་སྔོན་དུ་གསུངས་ཡོད་མོད།",
    "ལྷག་པར་བརྒྱ་ཆའི་སུམ་ཅུ་ཕ་མ་ལ་ཐུག་ཡོད་པ་རེད།",
    "རང་རེའི་གཏམ་དཔེ་ལ།",
    "ཕ་ཆང་འཐུང་ལ་བུ་ཆང་འཐུང་ཞེས་པའི་དཔེ་ལྟར་ཆང་འཐུང་ཤོ་རྒྱག་གི་ཁྱིམ་ཚང་ཞིག་ནས་ཆང་འཐུང་ཤོ་རྒྱག་མ་གཏོགས་ཡོན་ཏན་ཅན་ཞིག་འབྱུང་མི་ཐུབ་ལ་སྐྱེས་བུ་དམ་པ་ཞིག་འབྱུང་མི་ཐུབ།",
    "དེ་བས་བྱིས་པ་དག་གིས་ཆང་འཐུང་གི་དུ་བ་འཐེན་གི་ཤོ་རྒྱག་གི་ཞེས་སྡིགས་སྨྲེ་འདོན་ནའང་དེ་ནི་ཕ་མས་རང་གིས་བསླབས་པ་ཡིན་ལ།",
    "འཛམ་གླིང་ན་མི་རིགས་མིང་གྲགས་ཅན་ཞིག་ཡོད་པ་ནི་ཡུག་ཐེ་མི་རིགས་རེད།",
    "དེ་བཞིན་ལོ་གསར་སྐབས་སུ་ཡང་བྱིས་པ་རྣམས་ལ་ལོ་གསར་ཡིན་ཞེས་ལོ་ལོན་དག་གིས་ཆང་ལྡུད་པ་རེད།",
    "དེ་ནི་བྱིས་པའི་མི་ཚེ་ནང་དུ་དུག་བཏབ་པ་ཞིག་རེད།",
    "ཕ་མ་འགན་ཁུར་གཙོ་བོ་བྱིས་པ་ལ་ཡོན་ཏན་ཅན་དུ་སྐྱོང་བ་དང་བྱིས་པའི་འགན་ཁུར་གཙོ་བོ་ཡོན་ཏན་གྱིས་ཕ་མ་ལ་བསྙེན་བཀུར་བྱེད་པ་དེ་རེད།",
    "ད་ལྟ་དེ་ནི་བྱིས་པ་ལ་འགན་མ་འཁུར་བ་རེད།",
    "བྱིས་པ་ལ་ཡོན་ཏན་མེད་ན་བྱིས་པ་དེ་སྐྱེས་ཀྱང་དུད་འགྲོ་དང་ཁྱད་པར་མེད་པ་རེད།",
    "དེ་རིང་ཚོགས་ཐོག་འདི་ནས་ཁྱོད་ཚོ་ལ་དགག་པ་བརྒྱག་པ་གཏན་ནས་མ་ཡིན།",
    "དེ་བས་རང་རང་གི་བྱིས་པའི་ཆེད་དུ་འདང་ཞིག་རྒྱག་ཨེ་ཐུབ་ལྟོས།",
    "ཕ་མ་མང་བོས་རེ་བ་ཁྱོད་ཚོ་ལ་བལྟས་ཡོད།",
    "འདི་ནི་ང་ཚོ་ལ་མཚོན་ན་གཟི་བརྗིད་ཅིག་ཡིན་ལ་ཁྱོད་ཚོ་ལ་མཚོན་ན་གཟི་བརྗིད་ཅིག་ཡིན།",
    "གཟི་བརྗིད་འདིའི་ཕུགས་ན་རི་བོ་ལྟར་ཆེ་བའི་རེ་བ་ཞིག་དང་རྒྱ་མཚོ་ལྟར་ཟབ་པའི་ཡིད་ཆེས་ཤིག་ཡོད་པ་ནི་ཁྱོད་ཚོའི་མདུན་ལམ་ཤེས་རབ་ཀྱི་ཚོམས།",
    "རེད།",
    "ཁྱོད་ཚོའི་མདུན་ལམ་འཚོལ་མཁན་ཁྱོད་ཚོ་ཡིན་པ་ལས་གཞན་སུ་ཡང་མིན།",
    "དེ་བས་རང་རེའི་གཟི་བརྗིད་ཆེན་པོ་འདི་མག་མོག་ཏུ་གཏོང་མིན་ཁྱོད་ཚོ་ལ་ཐུག་ཡོད།",
    "གལ་ཏེ་རེ་བ་འདི་མག་མོག་ཏུ་བཏང་ན་ཁྱོད་ཚར་སོང་བ་ཡིན།",
    "ཁྱོད་ཚོ་རེ་རེ་ལ་བློ་རིག་གསལ་ཞིང་།",
    "རང་རང་ལ་ཐུན་མོང་མ་ཡིན་པའི་ནུས་པ་ཞིག་ཡོད་པ་ངས་མཐོང་ཡོད།",
    "རང་རེའི་མཁས་པ་སྔོན་མས།",
    "ཡོན་ཏན་མ་ལུས་བརྩོན་འགྲུས་རྗེས་འགྲོ་ཞིང་ཞེས་གསུངས་པ་ཡིན་ཙ་ན་ཁྱོད་ཀྱིས་དེ་རིང་ནས་བརྩོན་པ་བསྐྱེད་ན་ཁྱོད་ཡོན་ཏན་པར་འགྱུར་བ་ལ་ཐེ་ཚོམ་བྱེད་མི་དགོས།",
    "དེ་བས་ཁྱོད་ཚོ་སློབ་སྦྱོང་ངོས་ཟིན་ཡང་དག་པ་ཞིག་དགོས།",
    "རང་གི་མདུན་ལམ་གྱི་ཆེད་དུ་ཡིན་པ་ལས་གཞན་སུ་ཞིག་གི་ཆེད་དུ་མིན་པ་དེ་རེད།",
    "ཞེས་གསུངས་ཡོད་པས་རང་གི་མི་ཚེའི་མདུན་ལམ་གྱི་ཆེད་དུ་ཡིན་པས་གྲོགས་བསྒྲིགས་པ་ལ་དོ་སྣང་བྱེད་པ་ཆེས་གལ་ཆེ་བ་ཞིག་ཡིན།",
    "རྒྱལ་ཁབ་ལ་བྱས་རྗེས་ཀྱང་འཇོག་ཐུབ་པ་རེད།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་གངས་སེང་འཚོལ་བ།",
    "རང་གི་མདུན་ལམ་སྒྲུབ་པའི་ནུས་པ་ཡང་མ་ཐོབ་ན་མི་རིགས་དང་རྒྱལ་ཁབ་ཀྱི་དོན་སྒྲུབ་པའི་རེ་བ་གཏན་ནས་མེད།",
    "ངེས་པར་འགྲོ་དགོས་སྙམ་ནས་སློབ་སྦྱོང་གི་ཕྱོགས་ནས་རང་གི་ནུས་པ་ཡོད་ཚད་གདོན་དགོས།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་ཡིད་ཕམ་སོང་ན་ད་གཟོད་ཁྱོད་གཏན་ནས་ཕམ་སོང་བ་རེད།",
    "ཁྱོད་ཀྱི་མདུན་དུ་ད་དུང་གཟི་བརྗིད་ཆེ་བའི་ལམ་མང་བོ་ཞིག་གིས་ཁྱོད་ལ་སྒུག་ཡོད།",
    "དེ་དག་ནི་ཆ་རྐྱེན་མ་ཚང་བ་ཙམ་རེད།",
    "མ་འོངས་པར་རང་གིས་ཅི་ཞིག་བྱེད་པའི་ཕྱོགས་ལ་བསམ་གཞིག་གཏོང་དགོས་པ་རེད།",
    "སློབ་སྦྱོང་ལེགས་པོ་བྱས་ན་ད་གཟོད་ཁྱོད་ལ་མདུན་ལམ་ཡོད་ལ།",
    "སྤྲིན་གྱི་མེ་ཏོག་གི་ལྷག་བསམ་གྱིས་གཞན་པ་བསྐྱང་རྒྱུ་དེ་ཡིན་ལ།",
    "ད་དུང་སྤྲིན་གྱི་མེ་ཏོག་གིས་དཀའ་ངལ་མང་བོ་ཁྱད་དུ་བསད་དེ་གཞན་གྱི་སླད་དུ་འབད་བརྩོན་བྱ་དགོས།",
    "དེས་ན་སྤྲིན་གྱི་མེ་ཏོག་ལ་མཚོན་ན་ད་ལྟའི་མི་རིགས་འདིའི་བྱས་རྗེས་ཀྱི་སྟེང་ནས་བལྟས་ཚེ་འོད་སྟོང་འབར་བ་ཞིག་རེད་ལ་མ་འོངས་པ་ཡང་འོད་སྣང་གིས་འཚོ་བའི་འཇིག་རྟེན་ཞིག་ཀྱང་རེད།",
    "རེ་བ་ཆེན་པོ་དེའི་ཆེད་དུ་ང་ཚོ་ཚང་མས་རྡོག་རྩ་གཅིག་ཏུ་བསྒྲིལ་ཏེ་ཐུན་མོང་གིས་འབད་པ་བྱས་ན་མ་འོངས་པར་མདུན་ལམ་ཡང་དག་པ་ཞིག་ཡོད་པ་ནི་ངེས་ཅན་རེད།",
    "མ་འོངས་པ་ཡང་ཀློག་པ་བོ་རེད།",
    "དེ་ཅི་རེད་ཅེ་ན་གཅིག་ནས་ཀློག་པ་བོར་བསྟུན་དགོས་ཤིང་།",
    "གཉིས་ནས་ཀློག་པ་བོའི་རེ་བ་བསྐང་དགོས།",
    "བོད་མི་རིགས་ཀྱི་ཀློག་པ་བོ་དེ་ཚད་ངེས་ཅན་ཞིག་གི་སྟེང་དུ་ཡོད་ལ།",
    "གྲངས་ཀ་ཡང་ཉུང་ཉུང་ཞིག་གི་སྟེང་ན་ཡོད།",
    "ཚད་གཞི་ཧ་ཅང་དམའ་མོ་ཞིག་གི་སྟེང་ན་ཡོད།",
    "དེར་ཅིའི་ཕྱིར་མཁྲེགས་འཛིན་དང་གུ་དོག་པོ་རེད་ཅེ་ན།",
    "འདི་ལྟ་བུའི་ལྟ་བ་མང་བོ་འབྱུང་འོས་པ་ཞིག་དང་འབྱུང་སྲིད་པ་ཞིག་བྱུང་ན་ཆོག་པ་ཞིག་རེད་མོད།",
    "མི་རིགས་འདི་དཀའ་ས་ཁག་སའི་འགག་རྩར་ཐུག་ཡོད་སྟབས་འདང་རྒྱག་རྒྱུ་ཞིག་ཡོད་དགོས་པ་རེད།",
    "རྩོད་པ་བྱེད་པ་དེས་ཛ་དྲག་གི་གནས་ཚུལ་ཐོན་བཞིན་འདུག་ལ།",
    "ང་ཚོར་རིག་གཞུང་ཡོད་ལ།",
    "དེས་ན་རིག་གཞུང་དེ་ཅི་ཞིག་རེད་ཅེ་ན།",
    "རིག་གཞུང་འདི་ལག་ལེན་ལ་འདེབས་དགོས་པ་རེད།",
