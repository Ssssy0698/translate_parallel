    "དེ་མིན་པ་བཙན་རྒོད་ཀྱི་དགྲ་ཤ་ལེན་རྒྱུ་ཡིན་ན་འཇིག་རྟེན་ཁ་དཔེར་ཉིན་མོ་འགྲོ་འགྲོ་མ་མང་རི་མགོ་ཐམས་ཅད་མིག་ཡིན།",
    "མཚན་མོ་ལབ་ལབ་མ་མང་སྦྲ་འདབས་ཐམས་ཅད་ཨམ་ལྕོག་ཡིན་ཟེར་གྱི་ཡོད་པས་ད་རེས་ཤག་པོ་རང་གིས་བསམ་བློ་ཡག་པོ་ཞིག་གཏོང་དགོས་ཞེས་བཤད།",
    "དགའ་བློས་བྱས་ན་འགྲིག་སོང་།",
    "ཨ་ཆེ་གཡང་མོས་ཁྱོད་ཕ་བུ་གཉིས་དྲན་དྲགས་པས་ད་རེས་ཁྱོད་དང་ཐུག་ན་མཉམ་དུ་འགྲོ་རྒྱུ་ལས་འབྱུང་འགྱུར་གྱི་བསམ་བློ་རྒྱ་ཆེན་པོ་གཏོང་ཐུབ་ཀྱི་མ་རེད།",
    "དེར་བརྟེན་ཁྱོད་སླེབས་པའི་གནས་ཚུལ་ཙམ་ཡང་མོས་མ་ཤེས་པ་བྱེད་དགོས་ཟེར།",
    "ཉིན་གཉིས་པའི་སྐྱ་རེངས་མ་ཤར་ཙམ་ནས་ཐག་རིང་གི་སྦྲ་ནགགནས་དེ་ལས་བྲལ་ཏེ་སླར་བྱང་དུ་བསྐྱོད་དོ།",
    "མནའ་བཞག་གི་ཤག་པོ་དགའ་བློ་རྒྱུད་དེ་ཚེ་གང་གི་གཏན་གྲོགས་གཡང་མོ་བདེ་གནས་ཡིན་པའི་གནས་ཚུལ་ཤེས་ཏེ་ཕྱིར་ལོག་པའི་ལམ་དུ་ཡིད་མུག་དང་སྐྱོ་ཤས་ཀྱི་ཚོར་སྣང་གང་ཡང་མ་བྱུང་།",
    "མཚོན་ཆ་གང་ཐད་ནས་བསྡུར་ཡང་གནམ་སའི་ཧེ་བག་འདུག་མོད།",
    "ངའི་མེ་མདའི་མཆུ་ཡང་ཁོའི་ལྕེ་དྲོན་མོས་ལྡག་མྱོང་།",
    "དུད་ཁྱིམ་དེ་དག་གི་སྒོ་འགྲམ་དུ་མི་ཐར་ཐོར་ལངས་ནས་འདུག།",
    "ཁོའི་སེམས་ལ་དེ་དག་གི་ཁྲོད་དུ་ངའི་བུ་དགྲ་འདུག་ཡོད་ངེས་རེད།",
    "དགྲ་འདུལ་གྱིས་ཁོ་རང་གི་ཨ་མའི་སྐོར་སྐད་ཆ་འདྲི་རྒྱུ་གཏན་འཁེལ་ཡིན་པས་ངས་ད་རེས་མོ་དང་ཐུག་འཕྲད་བྱས་མེད་ཟེར་ན་དགྲ་འདུལ་གྱི་ཡིད་དུ་འགྲོ་ཨ་ཡོང་།",
    "ཐུག་འཕྲད་བྱས་པ་ཡིན་ཟེར་ན་ག་འདྲ་ཤོད་བསམ་བློ་སྣ་ཚོགས་གཏོང་བཞིན་སོང་བས་འཕྲལ་མར་ལུང་པའི་མཐིལ་དུ་སླེབས་པས།",
    "ཁོ་ཚོ་རེ་རེ་བཞིན་ཕན་ཚུན་འགྲམ་པ་སྦྱར་ཏེ་ཁམས་འདྲི་བྱས།",
    "དཀའ་མ་ཐལ།",
    "ཁྱོད་ཚོ་སྡོད་སྐྱིད་ཆེ་ཆེ་ཐལ།",
    "ཐག་རིང་གི་སྦྲ་ནགདགྲ་འདུལ་གྱི་མགྲིན་པ་ཅུང་བརྣངས་བཞིན་ཨ་ཕར་བལྟས་ཏེ་ཨ་ཕ་ཨ་ཨ་མ་བདེ་མོ་རེད་དམ་ཞེས་དྲིས་བྱུང་།",
    "ང་ཚོ་སེམས་ཁྲལ་བྱེད་དགོས་མི་འདུག་ཟེར།",
    "དགྲ་འདུལ་གྱིས་ཨ་ཕ་ཁྱོད་ལ་ཨ་མ་ཐུག་བྱུང་ངམ་ཞེས་ཅུང་ཟད་ཡིད་མ་ཆེས་པའི་སྒོ་ནས་དྲིས།",
    "ཁྱོད་ཀྱི་ཨ་མས་ལྷམ་བཞི་ཁྲ་ཡག་པོ་ཞིག་ཁྱོད་ལ་སྐུར་རྩིས་བྱེད་ཀྱི་འདུག།",
    "ཁྱོད་ལ་བཀྲ་ཤིས་གཡང་ཆགས་ཞེས་པའི་བུ་མོ་ཡག་པོ་ཞིག་མནའ་མར་བསུས་ཡོད་པའི་སྐོར་དང་།",
    "ངས་ང་ཚོ་ཕ་བུ་དང་།",
    "ཉི་ཤར་དེ་མར་སྟོང་འདང་གི་རྒྱ་ལས་ཨ་ང་ཚོ་ཚང་མ་བདེ་མོ་ཡིན།",
    "ཧྭ་ཧྭ་ཞེས་དགོད་འཛུམ་གྲོལ་བ་ལྟར་ཨ་ང་སྒྲུང་གི་སྨད་ཆ།",
    "ཁྱོད་ཀྱི་སྐད་ཆ་ཤོད་སྟངས་ལ་བལྟས་ན་གཞིས་པ་རྣམས་ལ་རྐྱེན་ངན་ཞིག་འཕྲད་པ་འདྲ།",
    "དོན་རྐྱེན་ཅི་བྱུང་སོང་།",
    "མི་འདི་དག་གི་རྣམ་འགྱུར་ལ་བལྟས་ན་དོན་རྐྱེན་ཞིག་བྱུང་བ་ཁོ་ཐག་རེད།",
    "ད་རེས་ཁྱོད་ལོག་ཡོང་པ་མཐོང་བས་ཆེད་མངགས་བཟོས་པ་ཡིན།",
    "ཞིམ་ཐག་རིང་གི་སྦྲ་ནགཔོ་ཞིག་ཡོད།",
    "ཞིམ་པོ་འདུག་ཅེས་ཇ་ཕོར་པ་གང་བཏུང་རྗེས་ཁྱོད་ཚོའི་རྣམ་འགྱུར་ལ་བལྟས་ན་བཀྲ་མ་ཤིས་པའི་དོན་རྐྱེན་ཞིག་བྱུང་བ་འདྲ།",
    "དེས་ཀྱང་མི་ཚད་ཁོ་རང་སྐུ་ངོ་མས་ང་མི་ཕལ་པར་ཇ་བླུགས་སྟངས་ལ་བལྟས་ན་དོན་རྐྱེན་ཞིག་བྱུང་ཡོད་ཐག་ཆོད་རེད།",
    "ཡངས་ཤིང་རྒྱ་ཆེ་བའི་རྩྭ་ཐང་འབྲི་མོའི་འོ་མ་བཤོས་པ་ལྟར་གང་སར་སྐྱ་ཐིང་ཐིང་དུ་གྱུར།",
    "ཉི་ཤར་ཐབ་ཀྱི་བྱང་འགྲམ་དུ་བསྡད་དེ་མེ་འོད་ལ་བརྟེན་ནས་སློག་པ་རྙིང་སོང་ཞིག་ལ་ལྷན་པ་རྒྱག་བཞིན་འདུག།",
    "དེ་མིན་ན་ཁྱོད་རང་སྔོན་ལཉོལ་དང་ཟེར།",
    "མོ་གཅིན་པ་གཏོང་མཚམས་བཅད་དེ་ནང་དུ་རྒྱུག་ནས་ཉི་ཉི་ཤར།",
    "ཁྱོད་ཁྱོད་རང་ད་དུང་བསྟན་བཤིག་སློང་རྒྱུ་དྲན་ནམ།",
    "ཁྱོད་རང་མར་མར་དོན་ནས་ལྟོས་དང་ཞེས་སྔར་བཞིན་དབུགས་ཧལ་ཧལ་གྱིས་རྐང་པ་གཅིག་སྒོ་ཐེམ་གྱི་ནང་དང་།",
    "གཅིག་སྒོ་ཐེམ་གྱི་ཕྱི་བྱས་ཏེ་ལངས་ནས་འདུག་པས་མོའི་སྐད་ཆའི་གདངས་དང་།",
    "ཁོ་སྒོ་ནས་དོན་སྐབས་བྲེལ་འཚབ་ཧ་ཅང་ཆེ་བས་འོ་མ་སྐྱིད་ལ་འབུད་རྒྱག་ཐེབས་ནས་ཏོག་ཙམ་མ་གཏོགས་ལྟག་དགྱེ་ལོག།",
    "ཨ་མ་མ་ཞེས་འོ་མ་སྐྱིད་ལག་པ་གཡས་པ་ས་རུ་བཙུགས་པས་མ་འགྱེལ་ཙམ་དུ་ཡར་ལངས་ཐུབ་པ་བྱུང་ནས་ལྟོས་དང་ཞེས་དེ་ཕྱོགས་སུ་མཛུབ་མོ་བཙུགས།",
    "ཏྭ་ཞེས་མེ་མདའི་སྐད་གྲགས་པ་དང་སི་ཞེས་མདེའུ་མོ་རང་གི་མགོའི་སྟེང་ནས་རྒྱུག་པས་ཞེད་ཐག་ཆོད་ནས་དེ་མར་ནང་དུ་བྲོས།",
    "ཇག་པ་སླེབས་སོང་ཞེས་པའི་སྐད་དང་ལྕགས་སླང་བརྡུང་བའི་སྒྲ་གྲགས་པས་ད་ལྟ་རུམ་གཅིག་གི་ནང་དུ་ཉལ་མ་ཐག་པའི་དགྲ་འདུལ་དང་བཀྲ་ཤིས་གཡང་ཆགས་གཉིས་སློག་པ་ལྷེབ་གྱོན་གྱིས་སྒོར་དོན།",
