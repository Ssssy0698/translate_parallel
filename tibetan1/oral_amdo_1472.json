    "དེར་གྲགས་པ་ཁྲི་སྲོང་གི་ཕུང་པོ་ལ་ཁྱི་སྤྱང་གང་གི་གནོད་པ་མེད་པར་ཁ་ས་ལྟར་ཞྭ་མོ་ངོ་གདོང་ལ་བཀབས་ནས་གན་རྐྱལ་དུ་འགྱེལ་ནས་འདུག་པ་དེའང་རྟ་གཞན་ཞིག་ལ་བཀལ་ནས་སོང་།",
    "སྒྲུང་གི་སྨད་ཆ།",
    "ཁོ་ཚོ་ཚང་མའི་སེམས་ནང་དུ་འཚུབ་ཆ་ཆེ་རུ་སོང་།",
    "དེ་ནས་རེ་ཞིག་ཉི་ཤར་དང་ཁྱོ་ཤུག་གི་འཚོ་བ་བསྐྱལ་ནས་པང་དུ་བུ་ཡང་ཡོད་པས་གཞན་སྨོན་རང་སྐྱིད་ཀྱི་འཚོ་བ་སྐྱེལ་འགོ་ཚུགས་ཀྱང་ད་གཟོད་ཁྱོ་བོ་དགྲ་ལག་ཏུ་ཤོར་བས་སྡུག་བསྔལ་ཆེན་པོ་ཡོད་སྤྲོས་མེད་རེད།",
    "ད་རེས་མོའི་ཁྱོ་བོ་ཡང་ངས་བསད་པས་མོས་ང་དང་འཚོ་བ་མཉམ་དུ་སྐྱེལ་རྒྱུ་ལྟ་ཅི།",
    "ང་ནི་མོའི་མིག་ནང་གི་གྲ་མ་དང་སེམས་ནང་གི་མཛེར་རུར་གྱུར་ནས་མཐོང་ན་འདྲེ་དང་།",
    "འཁོན་འགྲས་ཀྱིས་མོ་རང་སྨྱོ་འགྲོ་གི་རེད།",
    "ཁྱོ་བོའི་དགྲ་ཤ་བླངས་ཡོད་ཅེས་ཤོད་ཟེར།",
    "ང་སྡུག་པོ་འདི་འདྲ་མྱོང་དོན་ཅི་རེད།",
    "མ་གཞི་ནས་ཁྱོད་འོ་སྒྲུང་གི་སྨད་ཆ།",
    "མ་སྐྱིད་ཀྱི་ཁྱོ་ག་མ་རེད་དམ།",
    "བཟའ་མ་བུད་མེད་གཅིག་གིས་དགྲ་ཤ་ལེན་རྒྱུའི་འཁོན་འཛིན་བཅང་སྲིད་དམ།",
    "སྤྲིན་བྱིའུ་མགོ་ཙམ་མེད་པར་ཐོག་སྟ་རེ་ཙམ་ལྷུང་པའི་དཔེ་ལྟར་བསམ་ཡུལ་ལས་འདས་པའི་དོན་རྐྱེན་བཀྲ་མི་ཤིས་པ་དེས་མོའི་སེམས་སུ་བཟོད་གླགས་བྲལ་བའི་སྡུག་བསྔལ་གྱིས་མོ་རང་ཡང་བསམ་ཡུལ་ལས་འདས་པའི་རྐྱེན་ངན་དང་འཕྲད་མི་ཡོང་ངམ།",
    "ཇི་ལྟར་རེ་ཞིག་ཁོ་གཉིས་དབར་རྒྱུ་རྐྱེན་སྣ་ཚོགས་ཤིག་གི་བར་ཆད་བྱུང་འདུག་མོད་གང་ལྟར་ཚེ་སྐྱབས་ནི་མོ་རང་གི་ཁྱོ་བོ་འཁྲུལ་མེད་ཅིག་ཡིན་པ་དང་།",
    "བྱིས་པ་གཉིས་པོས་རྙོག་འཛིང་ཆེ་བའི་བྱ་བའི་རྒྱུད་རིམ་དེ་དག་ཤེས་མི་སྲིད་པས་འོ་མ་སྐྱིད་ལ་སེམས་སྡུག་ག་ཚོད་ཆེ་ཡང་མི་ཚེར་བརྗེད་མེད་རྡོ་ལ་རི་མོ་བརྐོས་པ་ལྟ་བུའི་སེམས་སྡུག་ཡོང་དོན་མེད་སྙམ།",
    "ཁོང་ཚོ་ནོར་ཁྱུ་དང་བཅས་པ་ཕྱིར་ལོག་ཡོང་བ་མཐོང་བས་ཁྱིམ་ཚང་ཡོང་བྲེལ་བ་འཚུབ་འཚུབ་ཀྱིས་ཇ་བསྐོལ་བ་དང་།",
    "ཟས་རིགས་གཡོས་སྦྱོར་བྱེད་ཀྱི་ཡོད་པས་སྦྲའི་སྟེང་ནས་གྱེན་འཕུར་གཡུ་འབྲུག་ལྟ་བུའི་དུ་བ་སྔོ་ལྷོག་ལྷོག་གིས་འཕྱུར་ཐག་རིང་གི་སྦྲ་ནགགྱིན་འདུག།",
    "ད་ཁྱོད་ཚོ་ལོག་སོང་ཟེར་བས་འོ་མ་སྐྱིད་ཀྱིས་ཚེ་སྐྱབས་ཀྱི་མགོ་ནས་མཇུག་བར་ཐེངས་མང་བལྟས་རྗེས་མི་འདོད་པའི་རྣམ་འགྱུར་གང་ཡང་མེད་པར་འགྲོ་ཞེས་བྱིས་པ་གཉིས་ཁྲིད་དེ་ཚེ་སྐྱབས་དང་ལྷན་དུ་ནང་དུ་ལོག་སོང་།",
    "སྒྲུང་གི་སྨད་ཆ།",
    "སྔར་བྱས་ཀྱི་ལས་ལ་འགྱོད་བཤག་གིས་འོ་མ་སྐྱིད་ལ་གོས་དྲག་ཚད་གཡོག་ཟས་དྲག་ཚད་སྦྱིན་ནས་གཅེས་སྐྱོང་བྱེད་པ་མ་ཟད་ཁྱིམ་དོན་གྱི་ཐད་མོ་དང་ཁ་རྩོད་ཙམ་ཡང་ཤོར་མྱོང་མེད།",
    "ཀྭ་ཀྭ་ཞེས་ཉིན་གང་ཟས་ཀྱི་དོན་དུ་གང་སར་འཕུར་བའི་ཕོ་རོག་ནག་ཆུང་རྣམས་ཀྱང་གཉིས་རེ།",
    "བུད་མེད་རྣམས་ཀྱིས་ཟོ་བ་དང་།",
    "ཤིན་ཏུ་ཉམ་ཐག་གི་སྡུག་བསྔལ་ག་འདྲ་ཞིག་བྱུང་ཡང་དུས་ཀྱི་འཁོར་ལོའི་འགྲོས་དང་བསྟུན་ནས་རིམ་གྱིས་སངས་འགྲོ་བ་ནི་ལྡོག་ཏུ་མེད་པའི་འཇིག་རྟེན་སྒྲུང་གི་སྨད་ཆ།",
    "ངས་བལྟས་ན་འདས་པོ་དེ་དང་ཨ་ན་མ་ན་རེད་ཟེར།",
    "བརྙས་བཅོས་བྱེད་ཡུལ་ཞིག་ཡིན་མོད་ད་ནི་བུ་རྟའི་མདངས་ཐོན་སོང་ཞེས་བསྔགས་བརྗོད་བྱེད་ཀྱི་ཡོད།",
    "ཡ་མེད་སྤུན་གསུམ་གྱི་རྣ་ལམ་དུ་སྐད་ཐག་རིང་གི་སྦྲ་ནགཆ་དེ་ཐོས་སྐབས་ཤིན་ཏུ་མི་དགའ་བ་དང་།",
    "ཁྱོད་ལྟ་བུའི་ཐ་ཤལ་ཡོད་དམ།",
    "སློག་པའི་ཐུ་གཤམ་རིང་དུ་ཐོངས་སྒྲུང་གི་སྨད་ཆ།",
    "ལ་མོ་ལས་ཁོ་ན་མ་གཏོགས་ཕོ་ལས་ལས་མི་དགོས་ཞེས་ཁ་རྡུང་དྲག་པོ་བཏང་ནས་སྡང་མིག་གིས་བལྟས།",
    "མཚོན་རྣོ་ངར་མེད་ན་འུ་ལུ་རེད།",
    "ཕུ་བོ་གཉིས་ཀྱི་དམོད་ཚིག་དང་ཁ་རྡུང་ནི་སྒྲུང་པ་ཕུལ་བྱུང་ཞིག་གིས་ལྷ་སྒྲུང་ཤོད་པ་ལྟར་རྫོགས་མཐའ་མི་འདུག།",
    "ང་ཚོ་འཆི་གསོན་སྤུན་བརྒྱད་ཀྱི་ནང་གི་ཕོ་ཐ་ཁྱོད་རེད།",
    "བཟང་བྱེད་མཁན་ལ་བཟང་ལན་མེད་ན་བཟང་བྱེད་མཁན་ཉུང་དུ་ཉུང་དུ་རེད།",
    "དགྲ་བྱེད་མཁན་ལ་དགྲ་ལན་མེད་ན་དགྲ་བྱེད་མཁན་མང་དུ་མང་དུ་རེད་ཅེས་མཛུབ་མོ་འབྲུག་དར་གྱི་སྣ་རྩེར་གཏད་དེ་གོ་བྱུང་ངམ།",
    "ངོ་གདོང་ལས་བྱ་དཀའ་བྱེད་གཏད་ཀྱི་རྣམ་འགྱུར་ཉམ་ཐག་པའི་མིག་གིས་ཕུ་བོ་གཉིས་ཀྱི་གདོང་ལ་ཐད་ཀར་བལྟ་མ་ནུས་པར་ས་རུ་བལྟས་ནས་བརྙས་བཅོས་ཡིན་པ་ངས་ཤེས་ཀྱི་འདུག།",
    "རང་སྲོག་རྟ་རྔ་ཕྲ་མོ་ལ་ཕངས་སེམས་མེད་པར་ང་བཙན་ང་རྒོད་ཁོ་ནར་བསམ་ནས་ཁོས་སྔར་གྱི་སྤུན་ཟླ་འདས་པ་དེ་དག་ཟུངས་ཁྲག་དམར་ཆི་ལིར་ཁྲག་དམར་གྱི་ལྦུ་བའི་ཁྲོད་དུ་རེ་རེ་བཞིན་དབུགས་ཀྱི་རྒྱུ་བ་ཆད་པ་དེ་རྣམས་དྲན་ནས་ཚིག་མཇུག་མ་འཁྱོལ་བར་རྔམ་པ་རིང་པོ་ཞིག་འཐེན་ནས་སླར་སྒོ་འགྲམ་དུ་བསྡད་ནས་སྨྲ་བ་མེད་པར་ལུས།",
    "དེའི་ཚེ་ཕོ་རོག་གཅིག་གིས་གལ་ཏའི་ཁ་ནས་ཤ་ལྷུ་དེ་མཐོང་ནས་ཀྭ་ཀཱ་ཞེས་སྐད་རྒྱག་བཞིན་ལྡིང་སྐོར་རེ་གཉིས་བྱས་ནས་ཐད་ཀར་གལ་ཏའི་འཁྲིས་སུ་བབས་ཏེ་ཤ་བཟས།",
    "འདི་ཕྱོགས་ནས་ཏྭ་ཞེས་མེ་མདའི་སྐད་གྲགས་པ་དང་ཕོ་རོག་དེ་ནག་ཐག་རིང་གི་སྦྲ་ནགལྷེབ་བེ་བསད་སོང་བས་ཡ་མེད་སྤུན་གསུམ་གྱི་རྣ་ལམ་དུ་སྔར་འབྲུག་སྐད་ལས་ཆེ་བའི་སྒྲ་ཐོས་མྱོང་མེད་པས་ད་རེས་དེ་ནི་འབྲུག་སྐད་ལས་ཀྱང་ཆེ་བར་སྣང་བ་དང་།",
    "བར་ཐག་ཕོ་འདོམ་བརྒྱ་ཙམ་གྱི་ས་ནས་ཕོ་རོག་བསོད་ཐུབ་པའི་མཐུ་རྩལ་ལ་ཁོ་ཚོ་རྦད་དེ་ཧང་སང་ནས་ཁ་གདངས་མིག་བགྲད་ཀྱིས་རེ་ཞིག་རེངས་པོར་ལུས།",
    "རྟ་བོ་ལྕག་གིས་བྲབ་ནས་ཁྲམ་གླུ་གཏོང་བཞིན་ཕྱིར་ལོག།",
    "ངས་མེ་མདའ་མཆུ་མ་ལྡག་པར་ཕར་རྒོལ་བྱེད་རྩིས་བྱས་ན་ངའི་སྲོག་དེའི་ཁ་ནས་ཐར་ཐུབ་བམ་ཞེས་སྐབས་དེ་དུས་རང་ཉིད་བྱ་ཐབས་མེད་པར་གཞན་གྱི་བརྙས་བཅོས་ཁུར་དགོས་བྱུང་བའི་ཚུལ་གྱིས་དག་འབུད་བྱས།",
    "ཕུ་བོ་གཉིས་བླ་འཁྱེར་བ་ལྟར་ཁ་ནས་སྨྲ་བ་ཚིག་གཅིག་ཀྱང་མེད་པར་མིག་ཆེར་གདངས་ནས་ད་གིན་འཇིགས་སུ་རུང་བའི་མེ་མདའི་སྐད་ད་དུང་རྣ་ལམ་དུ་གྲགས་ཀྱིན་འདུག།",
    "གོང་བ་ཝ་མོའི་པགས་པ་བྱས་པ་ཞིག་གྱོན།",
    "བཀྲ་ཤིས་གཡང་ཆགས་ཀྱིས་ནོར་ཆུ་བླུད་པར་ཕྱིན་སོང་།",
    "ཏོག་ཙམ་མ་གཏོགས་འབྲོང་རྒོད་གསུམ་བསད་སོང་།",
    "ང་ཁ་སེང་ཡ་མེད་སྤུན་གསུམ་ལ་ཉམས་ཚོད་ལེན་པར་སོང་ནས་ཁོ་ཚང་གི་མདུན་གྱི་ན་ཐང་དེར་ཇ་བསྐོལ་ནས་བསྡད་ཀྱང་ཁོ་ཚོས་ཡ་བྱེད་ནུས་སྒྲུང་གི་སྨད་ཆ།",
    "རི་དྭགས་རྒྱག་པར་སོང་ནས་ཕོ་རོག་གཅིག་བསད་འདུག་ག།",
    "ཧྭ་ཧྭ་ཧྭ་ཞེས་ཀུ་རེ་བཤད།",
    "ཁྱོད་ཀྱིས་ང་མི་ཁྲིད་པ་ཅི་ཡིན།",
    "ངས་སྔ་ས་ནས་ཁྱོད་ལ་དགྲ་ཤ་ལེན་རོགས་བྱེད་རྒྱུའི་དམ་བཅའ་བཞག་པ་ཁྱོད་ཀྱིས་བརྗེད་སོང་བ་མ་རེད་དམ།",
    "ཁོ་ཐག་རིང་གི་སྦྲ་ནགཚོས་ང་ངོ་མ་ཤེས་པ་ཡིན་ཡང་སྲིད།",
    "གང་ལྟར་ཁོ་ཚོ་ངའི་མཐོང་ཡུལ་དུ་སོང་མ་བྱུང་།",
    "སང་ཉིན་དོན་གྲུབ་ང་གཉིས་ཀྱིས་ཁྱོད་རོགས་པར་ཁྲིད་དེ་དགྲ་ཤ་ལེན་པར་འགྲོ་བསམ་གྱི་འདུག།",
    "ཁྱོད་ཀྱིས་ག་དུས་འགྲོ་ཟེར་བ་དེ་དུས་འགྲོ་ཟེར་བ་དང་ཡང་དགྲ་ཤ་ལེན་པར་འགྲོ་དུས་དཔའ་བའི་དཔུང་རོགས་མེད་ན་ག་ལ་འགྲིག།",
    "དེ་དུས་རང་གིས་གཞན་ལ་རེ་དགོས་སྟབས་ཁ་དན་ཚིག་ལ་གནས་པ་བྱེད་དགོས་སྙམ་ནས་ཤིན་ཏུ་འཐད་པའི་ཚུལ་གྱིས་ང་ཚོ་ཚང་མར་མེ་མདའ་ཡོད་པས་སྐྱག་ཟན་གསུམ་ལ་སྐྲག་རྒྱུ་ཅི་ཡོད་ཟེར།",
    "དེ་སྒྲུང་གི་སྨད་ཆ།",
    "སྐྱེས་ཕོ་དང་སྐྱེས་ཕོ་ཐུག་དུས་དེ་ལྟ་བུའི་བརྙས་བཅོས་ཁུར་མཁན་ཉུང་ཉུང་རེད།",
    "དེ་བས་གདོང་གཏུག་ནས་འཛིང་རྩིས་བྱས་ན་ཁོ་ཚོས་མགོ་སྒུར་ངེས་རེད།",
    "ལྷག་པར་དུ་ཡ་མེད་སྤུན་གསུམ་དང་འཁོན་འགྲས་མེད་པས་ཁོ་ཚོ་གསོད་ཐུབ་པར་སྤོབས་པ་སྐྱེ་རྒྱུ་ཅི་ཡོད་སྙམ་ནས་ངས་བལྟས་ན་གདོང་གཏུག་ནས་འཛིང་རྒྱུ་རེད།",
    "དེ་མཚམས་རྫ་མའི་ནང་གི་ཤ་ཁུ་ལྷོག་ལྷོག་ཏུ་ཁོལ་བཞིན་ཆུ་ཡི་ཟེགས་མ་ཐབ་འགྲམ་གྱི་མེ་མདག་གི་ནང་དུ་ལྷུང་ནས་ཚིར།",
    "ཤ་ཚ་ན་དགའ་ཡང་གཞན་གྱིས་མི་བསྟེར་ཟེར་ཡང་ད་རེས་ཤ་ཚ་མོ་བསྟེར་ཡོད་ཞེས་ཀུ་རེ་བཤད།",
    "ཨ་ཚ་ཚ་ཞེས་ཤ་ལྷུ་ཚིལ་ཆེན་དེ་མར་བཞག་ནས་སྦར་མོའི་སྟེང་དུ་འགོས་པའི་ཞག་ཚིལ་དང་ཤ་ཁུ་གྱོན་པ་སྤུས་ལེགས་དེའི་སྟེང་དུ་འགོས་དོགས་ཀྱིས་སྦར་མོ་གཉིས་ཐེར་ཐེར་བྱས་ནས་མིག་གཉིས་ཤ་ལྷུ་དེའི་སྟེང་གི་ཚི་ལུར་བལྟས་ནས་སྒྲ་མི་གསལ་བའི་མ་ཎི་བགྲངས།",
    "ངས་རང་སྲོག་རྟ་རྔ་ཕྲ་མོར་ཕངས་པ་མེད་པ་མ་ཡིན་ཡང་།",
    "འོག་ལ་བཞོན་རྒྱུའི་རྟ་ཕོ་ཡོད་ལ་རྒྱབ་ཏུ་ཁུར་རྒྱུའི་མེ་མདའ་ཡོད་པས་བུ་རྟ་གཉིས་ཀྱི་མདངས་འདོན་རྒྱུའི་དུས་ལ་སླེབས་སོང་ཞེས་ཁོ་རང་ཁྲིད་རྒྱུའི་ཡིད་ཆེས་ཀྱིས་ཁེངས།",
    "ཁྱོད་གཉིས་ལ་ཡིད་མི་ཆེས་པ་དང་།",
    "དགྲ་འདུལ་ད་གིན་གྱི་ཡིད་ཆེས་དེ་ཆུ་ཡི་ལྦུ་བ་ལྟར་ཡལ་ནས་ང་ཡང་ཁྲིད་ཀྱི་མིན་ཟེར་རམ་ཞེས་ཧང་སང་ནས་ཁ་ཆེར་གདང་སྟེ་བསྡད།",
    "ཤིག་གསོད་པར་སྟ་རེ་འཕྱར་དགོས་སྒྲུང་གི་སྨད་ཆ།",
    "ཁྱེད་གཉིས་བློ་བདེ་མོ་བྱོས་ཟེར།",
    "དགྲ་འདུལ་གྱིས་སྐད་དམའ་པོའི་སྒོ་ནས་འོ་ན་ང་གཉིས་ལ་རོགས་པ་ཞིག་བཏང་སྟེ་སོང་ན་མི་འགྲིག་གམ་ཞེས་བཤད།",
