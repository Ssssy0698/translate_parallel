    "ཁྱེད་རང་ལྟར་ན་བདག་གཅིག་པས་འབྲེལ་ན་རང་བཞིན་གྱི་དངོས་པོ་དང་དེ་ལས་བྱུང་བས་འབྲེལ་ན་འབྲས་བུའི་དངོས་པོར་འགྱུར་རོ།",
    "གཅིག་ལ་འདུག་པ་འབྲེལ་བ་མེད།",
    "འདི་ནི་གཞན་དུ་འདུག་པ་ན།",
    "དངོས་ནའང་རང་གྲུབ་རྒྱུ་ཅི་དགོས།",
    "མི་རྟག་ནའང་ཤིང་ཁོ་རང་འཇིག་པས་མེ་མི་དགོས་སོ།",
    "མྱུ་གུ་རང་རང་རྒྱུ་ལ་ལྟོས།",
    "ཐ་དད་ན་གནས་སྐབས་མི་རྟག་པས་དོན་བྱེད་ཀྱང་རང་བཞིན་རྟག་པས་དོན་བྱེད་མི་ནུས་པར་འགྱུར་རོ།",
    "ཕྱིས་མུན་པ་ནུས་མེད་འགགས་པ་ཉིད་སྣང་བ་སྐྱེས་པ་ཡིན་པས་སྐྱེ་འགག་དུས་མཉམ་སྟེ་སྲང་མདའི་མཐོན་དམན་བཞིན་ནོ།",
    "རྟ་དང་འབྲེལ་བའི་བ་ལང་ཞེས་ལྷན་ཅིག་ཏུ་འདུག་པ་ལ་འབྲེལ་བར་འདོགས་པ་བཞིན་ཐ་དད་ལ་འགལ་བར་བཏགས་པ་ཡིན་གྱི་འགལ་བ་མཚན་ཉིད་པ་མ་ཡིན་ནོ།",
    "དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "འབྲས་བུ་དང་བྱེ་བྲག་བསྒྲུབ་པའི་ཤུགས་ཀྱིས་རྒྱུ་དང་སྤྱི་གྲུབ་པ་ནི་འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་ཡིན་ལ།",
    "ཡང་རང་རྒྱུད་ལ་རིག་པ་ཙམ་རིག་པ་ཕྱི་མ་བསྐྱེད་པར་གྲུབ་པས་རིག་པ་ཕྱི་མ་མི་བསྐྱེད་པའི་རིག་པ་ཙམ་དངོས་སུ་ཁེགས་པ་ན་ཕྱི་མ་མི་བསྐྱེད་པའི་རིག་པའི་བྱེ་བྲག་ཐམས་ཅད་ཤུགས་ལ་ཁེགས་ཏེ་སྒྲོན་མ་ཙམ་གྱིས་འོད་འབྱིན་པར་གྲུབ་པས་འོད་མི་འབྱིན་པའི་སྒྲོན་མའི་བྱེ་བྲག་ཐམས་ཅད་ཤུགས་ལ་ཁེགས་པ་བཞིན་ནོ་ཞེས་གསུང་ངོ།",
    "བེམ་པོ་ལས་ལོག་པའི་ཕྱིར་རང་རིག་མངོན་སུམ་བཞིན་ཞེས་བཀོད་པ་ན་མངོན་སུམ་དང་རང་རིག་ཁྱབ་མཉམ་ཡང་དཔེ་དང་ཤེས་འདོད་དུ་འགྱུར་བ་བཞིན་ནོ།",
    "མི་དམིགས་པ་ཐམས་ཅད་དཔེ་ལ་སྣང་རུང་མི་དམིགས་པར་འདུ་ལ་དེ་བདག་གཅིག་པའི་འབྲེལ་བ་ལ་བརྟེན་པས་རང་བཞིན་གྱིས་རྟགས་ཡིན་ཅིང་དེ་དག་བཟློག་པས་མི་དམིགས་པའི་འགལ་བའང་རང་བཞིན་འགལ་བའི་ལྟར་སྣང་དུ་འདུ་བས་འགལ་བའང་གཉིས་ཉིད་དེ།",
    "སྒྲ་དོན་དང་རང་མཚན་སོ་སོར་མ་ཕྱེ་བར་ཚོགས་དོན་བསྒྲུབ་བྱའོ།",
    "ཞེས་བརྗོད་པས་དགག་སྒྲུབ་སྒྲ་དོན་ལ་བྱས་ཀྱང་རངམཚན་གོ་བ་ཡིན་ཏེ།",
    "གཞན་དག་ལུང་དང་རང་ཚིག་ཟེར།",
    "རང་ཚིག་དང་ཁྱད་པར་མེད་པས་དེ་བླངས་ནས་འགལ་ཡང་རང་ཚིག་དང་འགལ་བ་དང་།",
    "བརྗོད་འདོད་ཀྱི་གྲགས་པ་ཁས་མི་ལེན་ན་ཁྱེད་རང་ཁས་ལེན་པའི་རི་བོང་ཅན་ལ་སོགས་པར་འདོད་པའང་འཇིག་པས་ཐ་སྙད་ཐམས་ཅད་འཇིག་པར་འགྱུར་རོ།",
    "དམ་བཅའ་དང་རང་ཚིག་འགལ་བ་དཔེར་ན་དགེ་སྦྱོར་མ་སྦྲུམ་མའམ་བདག་མེད་དོ་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "ཡང་རང་ལ་གྲུབ་པའི་བ་ལང་ཉིད་ལ་སོགས་པའང་གཞན་ལ་མ་ངེས་པར་སྟོན་ན་འགལ་བ་དང་།",
    "ཞེས་བསྲེགས་ཏེ་མི་སྨྲ་བར་འདུག་ན་སྐབས་དོན་གྲུབ་བོ་སྙམ་ན།",
    "མི་སྨྲ་བར་འདུག་གམ།",
    "ཁྱེད་རང་དེར་མི་འདོད་པའི་ཕྱིར་སྐྱེས་བུ་རྐུན་མ་ལ་རྟགས་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་སྒྲ་རྟག་སྟེ་མཉན་བྱ་ཡིན་པའི་ཕྱིར་སྒྲ་ཉིད་བཞིན་ཞེས་ཟེར་བ་མ་ངེས་པར་འདུག་ལ།",
    "དེའང་རང་དོན་དུ་དོན་གྱི་སྐྱོན་འབའ་ཞིག་དཔྱད་ལ་གཞན་དོན་དུ་བློ་དང་སྒྲའི་སྐྱོན་ཡང་དཔྱད་དོ།",
    "མེ་དང་སྤུ་ལོང་བྱེད་པ་ཕན་ཚུན་འགོག་པ་རྒྱུ་དང་འགལ་བ་དམིགས་པ་དང་རང་བཞིན་འགལ་བའི་འབྲས་བུ་དམིགས་པ་གཉིས་དང་།",
    "དེ་ལྟར་ལས་དང་བྱེད་པ་པོ་དང་བྱ་བའི་སྒོ་ནས་དབྱེ་ན་དབྱེ་སྒོ་གསུམ་པོ་དེའང་ཤེས་པ་ཡུལ་ཅན་ཁོ་རང་གནས་ལུགས་ཀྱི་སྒོ་ནས་དཔྱད་ན་རང་རིག་ཁོ་ནར་འདུའོ།",
    "ཁོ་ཁོ་རང་ལ་ཡོད་པའི་སྐད་ཅིག་དང་པོ་འཇིག་པའི་དུས་སུ་མ་ཞིག་ན།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "བུམ་པ་དེ་ཁོ་རང་ལ་ཡོད་པའི་རྫས་བརྒྱད་དང་རྫས་གཅིག་ཡིན་པའི་ཕྱིར།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས།",
    "གཞན་ཡང་རང་མཚན་ཉིད་སེལ་བ་ཡིན་ན།",
    "ན་སྒྲས་བརྗོད་ཅིང་རྟོག་པས་ངེས་པའི་ཆ་དེ་ཡང་རང་མཚན་མི་སྣང་བ་ལྐོག་སྒྲ་རྟོག་འཇུག་པ་ན་རྟགས་ལ་ལྟོས་སམ་མ་ལྟོས་ཀྱང་རུང་སྒྲས་བརྗོད་གྱུར་ལ།",
    "དེ་དང་རང་མཚན་ལ་འབྲེལ་བ་གཉིས་ཀ་མེད་པའི་ཕྱིར་རོ།",
    "འཇུག་དུས་ན་སྒྲ་དོན་དང་རང་མཚན་མ་ཕྱེ་བའི་རྟགས་ལས་དེ་གཉིས་མ་ཕྱེ་བའི་བསྒྲུབ་བྱ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "དེ་ཡང་འཇུག་དུས་ན་སྒྲ་དོན་ལ་རང་མཚན་དུ་ཞེན་པ་ལ་དགག་སྒྲུབ་བྱེད་པའི་ཕྱིར་རོ།",
    "དེས་ན་དང་པོ་བརྡ་བྱེད་པ་ནའང་རང་མཚན་དང་སྒྲ་དོན་སོ་སོར་མ་ཕྱེ་བར་བརྡ་བྱེད་ལ།",
    "སྒྲ་བྱས་མི་རྟག་པ་གསུམ་དངོས་པོ་ཡིན་ཞེས་པ་ནི་འཇུག་དུས་ཡིན་ཏེ།",
    "འཇུག་དུས་སྣང་བརྟག་གཅིག་ཏུ་ཞེན་ནས་འཇུག་དགོས་པའི་ཕྱིར་རོ།",
    "རང་མཚན་ལ་མ་སྦྱར་ན་སྤྱི་རྐྱང་པ་ལ་བརྡ་སྦྱར་ཡང་རང་མཚན་གོ་མི་ནུས་པས་བར་དེར་ལམ་སྟོན་པ་ལ་སྡོང་དུམ་ལ་འདྲི་བ་ལྟར་དགོས་ནུས་མེད་པའི་སྤྱི་བོར་ལ་རང་མཚན་ཉིད་ལ་བརྡ་སྦྱོར་ཅིག་གལ་ཏེ་རང་མཚན་མཐའ་ཡས་པའི་ཕྱིར་བརྡ་དངོས་སུ་སྦྱར་མི་ནུས་ཤེ་ན།",
    "འཇུག་དུས་ཀྱི་བརྗོད་བྱ་རྗོད་བྱེད་གཉིས་ཏེ།",
    "ཕྱིས་ཐ་སྙད་ཀྱི་དུས་ནའང་རང་སྤྱི་གཅིག་ཏུ་འཁྲུལ་ནས་དོན་རང་མཚན་གོ་བ་ཡིན་པའི་ཕྱིར།",
    "དོན་སྤྱི་དང་རང་མཚན་གཉིས་པོ་གཅིག་ཏུ་འཁྲུལ་བ་ལ་བརྡ་བྱེད་ན།",
    "འོ་ན་ཁྱེད་རང་བརྡ་ཆད་བྱེད་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "དོན་སྤྱི་དང་རང་མཚན་གཅིག་ཏུ་བསྲེས་ནས་བརྡ་བྱས་པ་ལ་དགོས་པ་ཡོད་དེ།",
    "འདི་ནི་གཞན་དུ་འདུག་པ་ན།",
    "སྐད་ཅིག་དུས་ལ་ལྟོས་པས་ཆ་མེད་ཡིན་ཅིང་།",
    "བྲལ་བའི་དོན་རྟོག་པའི་རྫས་དང་བྲལ་བ་ལ་བྱས་ན་རྟོག་མྱོང་རང་རིག་མངོན་སུམ་རྟོག་བྲལ་མ་ཡིན་པར་འགྱུར་ལ།",
    "འཛིན་པའི་རྣམ་པ་ཡང་རང་རིག་པའི་ཡུལ་ཅན་ཉིད་ཡིན་པའི་ཕྱིར།",
    "ཡང་རང་རྒྱུད་ལ་རིག་པ་ཙམ་རིག་པ་ཕྱི་མ་བསྐྱེད་པར་གྲུབ་པས་རིག་པ་ཕྱི་མ་མི་བསྐྱེད་པའི་རིག་པ་ཙམ་དངོས་སུ་ཁེགས་པ་ན།",
    "ཕྱི་རོལ་མེད་ཅིང་རང་རིག་བདེན་པར་གྲུབ་ལ།",
    "སྦྱོར་བའི་སྒོ་ནས་དབྱེ་ན་མ་དམིགས་པ་དང་རང་བཞིན་དང་འབྲས་བུའི་གཏན་ཚིགས་གསུམ།",
    "མ་དམིགས་པ་དང་རང་བཞིན་དང་འབྲས་བུའི་གཏན་ཚིགས་གསུམ།",
    "འོ་ན་ཁྱེད་རང་ལྟར་ནའང་བུམ་གཟུགས་འཛིན་པ་ལ་རྩིག་པ་ལ་སོགས་པས་བསྒྲིབས་པ་འགལ་ལོ་ཞེ་ན།",
    "དེ་ལ་བསྒྲུབ་བྱར་ཁས་བླངས་པས་ངོ་བོ་དང་རང་ཉིད་དང་འདོད་པ་དང་ཁོ་ནའི་དོན་འཕངས།",
    "དབྱེ་ན་དེ་ལ་ཁས་བླངས་དང་རང་ཚིག་བསལ་བ་གཉིས།",
    "གཞལ་བྱ་གསུམ་སྟོན་པ་ལ་མངོན་རྗེས་དང་རང་ཚིག་ཅན།",
    "གལ་ཏེ་འདོད་རྒྱལ་གྱི་གྲགས་པ་འགོག་ན་ཁྱེད་རང་ཁས་ལེན་པའི་རི་བོང་ཅན་ལ་སོགས་པར་འདོད་པའང་འཇིག་པས་ཐ་སྙད་ཐམས་ཅད་འཇིག་པར་འགྱུར་རོ།",
    "ངོ་བོ་དང་ཁོ་ན་དང་རང་ཉིད་དང་།",
    "འཕེལ་བ་དང་མཚུངས་པའི་ལྟག་ཆོད་སོགས་བཅུ་གསུངས་པ་རྣམས་དེ་གཉིས་དང་རང་འགྲེལ་ལས་ཤེས་པར་མཛོད།",
    "དེ་ཡང་རང་དོན་དུ་དོན་སྐྱོན་འབའ་ཞིག་དཔྱད་ན་གཞན་དོན་དུ་བློ་དང་སྒྲའི་སྐྱོན་ཡང་དཔྱད་དོ།",
    "སླེབས་ཨེ་འདུག་ལྟོས་ཤིག་ཟེར་རོ།",
    "རྒྱ་བྱ་རྨ་བྱ་ནེ་ཙོ་གསུམ་གང་ཡང་མི་གདའ།",
    "བྱ་ཁྭ་ཏ་དེ་ཧོར་ལྷ་གནམ་ཐེལ་དཀར་པོའི་རྟེན་ཐུག་ཆེན་པོ་གཅིག་ཡོད་པ་དེའི་སྟེང་དུ་བབས་འདུག་པ་ལ་ཤན་པས་སྨྲས་པ།",
    "མཁར་གཅིག་ལ་མིང་གསུམ་གདའ་ལེ་དེ།",
    "ཧོར་པ་ཁྲ་ཡི་སྤྱན་མིག་གདའ།",
    "སྨུག་ཆུང་འཛིན་མའི་གཟི་མདངས་གདའ།",
    "ཞེ་སྡང་སྦྲུལ་གྱི་ཨ་འབྲས་གདའ།",
    "མཁའ་འགྲོའི་གར་སྟབས་ཤིག་གེར་གདའ།",
    "ཤེལ་མུ་ཏིག་ཚོམ་བུ་ཤ་ལེར་གདའ།",
    "ལྗགས་ལ་ཨ་ཡིག་རང་བྱོན་གདའ།",
    "བུ་ལྷའུའི་མ་ཡར་ཡོང་ངེས་གདའ།",
    "གུར་དཀཪ་ཁོ་རང་མཉམ་འཇོག་བྱེད་མིན་ཅི་འདྲ་ཡང་།",
    "སླར་འགྱོད་པ་མི་སྐྱེ་བསམས་ནས་བཤོལ་འདེབས་བྱེད་པའི་གླུ་འདི་ལྟར་བླངས་པར་གདའ་འོ།",
    "མདའ་ལ་སྐྱེན་ཞན་ལྟོས་ལ་ཤོག་ས་ལ་ས་བཙན་ཅི་འདུག་ལྟོས།",
    "བོས་ན་ཡོང་ལེ་ཨེ་འདུག་ལྟོས།",
    "བསླངས་ན་སྟེར་ལེ་ཨེ་འདུག་ལྟོས།",
    "འཕྲོག་ན་ཐོབ་ལེ་ཨེ་གདའ་ལྟོས།",
    "འདུག་མི་ཕོད་ཨེ་ཤེས་ནེའུ་ཆུང་མ།",
    "གཡུ་སྦྲའི་མགོ་ལ་བབས་ནས་གདའ།",
    "འདུག་ཕོད་པ་ཡེ་ནས་ཡོད་ལེ་མེད།",
    "སྟག་ཤར་དགྲ་དར་འཚུབས་སེ་གདའ།",
    "བུ་ཁྱེའུ་ཚེ་མདུད་སྤུངས་སེ་གདའ།",
    "ཉོན་དང་ཞུ་རྒྱུ་འདི་འདྲ་གདའ།",
    "གཤོག་གཡས་ཤར་ཕྱོགས་ཁེབས་པ་གདའ།",
    "མཆེ་བ་གངས་རི་སྤུངས་འདྲ་གདའ།"
  ]
}