    "གཡོན་ལས་ཀྱང་དེ་བཞིན་དུ་ཧྲཱི་བྱུང་ནས་གཡོན་དུ་འདུག་ལ།",
    "ཁྲག་ལ་འཇིབ་བཞིན་དུ་འདུག་པར་དམིགས་ལ་ཁ་རྡོ་རྗེ་རྒྱ་གྲམ་གྱིས་བཅད།",
    "རང་རང་ལས་བསྟུན་རྫས་བསྒྲུབ་དང་།",
    "ཅེས་བཟླས་པ་རྫོགས་མཚན་མ་རྙེད་པ་དང་ལྕེ་སྒོག་དཀར་པོས་འདུག།",
    "བཛྲ་མུཚོགས་ཞིང་རང་གནས་སུ་གཤེགས།",
    "སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བར་འདུག་ན།",
    "ལྷའི་དེ་ཁོ་ན་ཉིད་ཇི་ལྟར་འདུག་དཔྱད་པས།",
    "ལྷའི་དེ་ཁོ་ན་ཉིད་དེ་ཡང་དོན་དམ་པར་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བར་འདུག་པར་ཤེས་སོ།",
    "སོ་སོར་ཡིད་ཀྱིས་མེ་འབར་བའི་ནང་ན་འདུག་པར་བརྟགས་ཏེ་བསམ་གཏན་ལ་གནས་པའོ།",
    "ཁྱེད་རང་རྣམས་མི་དམིགས་ཏེ་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "ཁྱེད་རང་རྣམས་མི་དམིགས་ཏེ་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "ཁྱེད་རང་རྣམས་བཅོམ་ལྡན་འདས་ཁྲོ་བོའི་རྒྱལ་པོ་རྡོ་རྗེ་རྣམ་པར་འཇོམས་པ་ཞེས་པ་ནས་མེ་འབར་བའི་དབུས་ན་བཞུགས་པར་གྱུར་དེའི་སྤྱི་བོར་ཨོཾ།",
    "མཆོད་སྦྱིན་གྱི་གཏོར་མ་གཟུགས་སྒྲ་དྲི་རོ་སོགསནས་འདིས་ཚིམ་པར་གྱིས་ལ་རང་རང་སོ་སོའི་གནས་སུ་དེངས་ཤིག་སུམྦྷ་ནི་སོགས་བརྗོད་དེ་ཡུངས་ཐུན་གྱིས་བྲབ་ནས་བསྐྲད།",
    "འོ་ད་ལམ་ཁྱེད་རང་རྣམས་དམིགས་པ་འདི་བཞིན་མཛོད།",
    "ཁྱེད་རང་རྣམས་དམིགས་པ་འདི་བཞིན་མཛད་པར་ཞུ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་སློབ་དཔོན་ལ་མེ་ཏོག་འཐོར་བཞིན་དུ།",
    "དེ་ཡང་རང་ལུགས་མཁན་ཆེན་ཤཱཀྱ་རཏྣས་མཛད་པའི་གཞུང་ཆོག་གཏོར་བསྔོས་འདོད་གསོལ་བཅས་ཀྱི་བར་སྔོན་དུ་བཏང་ནས།",
    "ཅིས་ཀྱང་འགྲོ་ན་དོ་ནུབ་འདིར་འདུག་ལ་སང་ནང་པར་སོངས་ཤིག་གསུངས།",
    "ཁྱེའུ་དེ་ཆེར་བསྐྱེད་རིམ་བཞིན་གླང་པོའི་ཕྲུ་གུ་ཡང་སྐྱེས་ཏེ་མཉམ་འདུག་བྱེད།",
    "ལམ་པས་མཐོ་འཚམ་པར་ཤེས་ནས་ཁྲི་ལ་འདུག་ཅིང་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞག་སྟེ།",
    "མདུན་དུ་བདེ་བར་འདུག་བཅུག་ལ།",
    "ཁྱེད་རང་སྔོན་ཆད་སྔར་བསགས་ཀྱི་རྣམ་པར་སྨིན་པ་དང་བཅས་པས།",
    "མྱ་ངན་ལས་འདས་ཁར་འཁོར་ཉན་ཐོས་དང་རང་རྒྱལ་དགྲ་བཅོམ་བྱང་སེམས་དཔག་ཏུ་མེད་པ་རྣམས་ཀྱི་ནང་།",
    "བཛྲ་མུཚོགས་ཞིང་རང་གནས་སུ་གཤེགས།",
    "ཁྲུས་བྱས་གཙང་སྦྲ་དང་ལྡན་པས་སྟན་བདེ་བ་ལ་སེམས་སྐྱིལ་གྱིས་འདུག་ལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "དེའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་རང་བཞིན་གྱིས་རྣམ་པར་། དག་པའི་འོད་གསལ་བ།",
    "ཁྱེད་རང་རྣམས་སྒྲོལ་དཀར་ཡིད་བཞིན་སྒྲོལ་། དཀཪ་འཁོར་ལོར་གསལ་བའི་ཐུགས་ཀར་པད་ཟླ་ལ་འཁོར་ལོ་དཀར་པོ་རྩིབས་བརྒྱད་པའི་ལྟེ་བར་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཏཱཾ་ཡིག་དཀར་པོ།",
    "ཞལ་ནས་ཐོན་ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་ནས་ཞུགས།",
    "དེ་ལྟར་ཕུལ་བའི་མེ་ཏོག་དེ་ཉིད་སྔགས་འཕྲེང་དུ་བྱིན་གྱིས་བརླབས་ཏེ་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་གཏོར་བས།",
    "དེ་ཉིད་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་བྱོན།",
    "རང་ཉིད་རྟེན་གྱི་དཀྱིལ་འཁོར་ལ་ཕྱོགས་ནས་བདེ་བར་འདུག་ལ།",
    "གནས་འདིར་མ་འདུག་གཞན་དུ་དེངས",
    "རང་རང་རིགས་ཀྱི་ཡུམ་བཅས་གསལ",
    "སྔགས་ཕྲེང་རང་སྒྲ་སྒྲོགས་བཞིན་པར",
    "རང་རང་ཐུགས་སྲོག་ལས་བྱུང་བའི",
    "འོན་ཀྱང་པར་མ་སྔ་ཕྱི་གཉིས་དང་བྲིས་མ་གཅིག་བཅས་དཔེ་གསུམ་པོ་རྩ་བའི་ཆ་ནས་གཅིག་མཚུངས་སུ་བཞུགས་པ་ལས་ཁྱད་པར་ཆེན་པོ་མི་འདུག།",
    "རིག་པའི་གནས་ཐམས་ཅད་ལ་ཤིན་ཏུ་མཁས་པར་འདུག་པས་དོགས་གཅོད་མང་དུ་བགྱིས་ཤིང་བསྟན་བཅོས་ཀྱང་ཐན་ཐུན་བསྒྱུར།",
    "འདུག་ས་འདི་ཉིད་དུ་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "གཏང་རག་དུས་སུ་མ་ཐོངས་འཐོལ་ལོ་བཤགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མདུན་གྱི་ནམ་མཁར་བསྲུང་བའི་འཁོར་ལོའི་ནང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་སྡིག་སྒྲིབ་ཐམས་ཅད་བསྲེགས།",
    "འུར་འུར་ཆེམ་ཆེམ་བྱོན་ཏེ་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་གཉིས་སུ་མེད་པར་ཐིམ་ཞེས་བརྗོད་ཅིང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བའི་ཨོཾ་ལ་ཐིམ་པས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གནས་གསུམ་གྱི་ཡི་གེ་འབྲུ་གསུམ་ལ་ཐིམ།",
    "སྟོང་པའི་ངང་ལས་ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་ཐིག་ལེ་ཧཱུ་དང་བཅས་པ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བར་ཨོཾ།",
    "ཁྱེད་རང་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྣ་བུག་གཡོན་པ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཉིད་ཅེས་པ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བར་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་མགྲིན་པར་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་གནས་གསུམ་དུ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས་ཏེ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "ཁྱེད་རང་རྣམས་སྐད་ཅིག་ཙམ་གྱིས་མགོན་ལྗང་ཚེ་བདག་ཡབ་ཡུམ་དུ་གསལ་བའི་དཔྲལ་བར་ཨོཾ།",
    "སྤྲོས་པའི་མཐའ་བྲལ་གཅེར་མཐོང་རང་རིག་འདི།",
    "འཇིག་དུས་ཀྱི་མེ་དཔུང་ལྟ་བུའི་དབུས་ན་དགོས་དགུར་རོལ་པས་འཇིགས་པའང་འཇིགས་པར་བྱེད་པའོ།",
    "མིའུ་ཐུང་གེལ་བའི་འདུག་སྟངས་ཀྱིས་ཟེའི་སྟེང་ན་བཞུགས་པ།",
