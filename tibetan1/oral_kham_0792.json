    "ཟླ་འོད་དཔའ་བོ་ཡང་ནི་མདུན་ན་འདུག།",
    "རབ་ཏུ་སེམས་དགའ་ས་ལ་འདུག་ཅིང་འདུད།",
    "བྱ་མང་ཀུན་ནི་ནམ་མཁར་འདུག་ནས་སུ།",
    "མེ་ཏོག་གཏོར་ནས་ནམ་མཁའི་དཀྱིལ་ན་འདུག།",
    "ནམ་མཁའི་དཀྱིལ་ན་འདུག་ཅིང་སེམས་དགའ་ནས།",
    "ཧ་ཅང་མི་རིང་བདེ་གཤེགས་སྤྱན་སྔར་འདུག།",
    "དེ་ཚེ་ནམ་མཁའ་ལ་ཡང་འདུག་གྱུར་པ།",
    "བདེ་བར་གཤེགས་པའི་སྤྱན་སྔར་གུས་པར་འདུག།",
    "བཏུང་དང་བཤོས་ཀྱང་གསོལ་བར་གདའ།",
    "ངོ་བོ་ཉིད་སྟོང་རང་བཞིན་རྣམ་དག་པ།",
    "ཇི་ལྟར་བར་སྣང་རང་བཞིན་སྟོང་པ་ལྟར།",
    "བསམ་དང་བྲལ་ཞིང་རང་བཞིན་ཞི།",
    "ལྷ་དང་ཀླུ་རྣམས་མཁའ་ལ་འདུག་ཅིང་རབ་དགའ་སྟེ།",
    "དེ་དག་སྒྲ་ནི་ནམ་མཁའ་འདི་ལས་གདའ།",
    "མཁའ་ལ་འདུག་སྟེ་ཆེད་དུ་བརྗོད་པ་བརྗོད།",
    "བཅོམ་ལྡན་འདས་ལ་ཡིད་ཀྱིས་ལན་གསུམ་བསྐོར་བ་བྱས་ནས་སྟན་ལ་འདུག་གོ།",
    "རྒྱལ་བ་དེ་ཡི་སྤྱན་སྔར་རྒྱལ་པོ་འདུག།",
    "རྟག་པར་རབ་ཏུ་མཉམ་གཞག་དུས་བྱས་པས།",
    "མགུ་རངས་སྟོབས་བཅུ་ཡི་ནི་མངོན་སུམ་འདུག།",
    "ཇི་སྙེད་མདུན་ན་འདུག་པ་རྣམས།",
    "དེ་དག་རྒྱལ་པོའི་མདུན་དུ་འདུག་པ་དང་།",
    "དེ་ཚེ་སྟོབས་བཅུ་ལྡན་པའི་སྤྱན་སྔར་འདུག།",
    "འཆག་ཅིང་འདུག་དང་འགྲེང་ཞིང་ཉལ་བ་ན།",
    "ཐོས་ནས་རྟག་ཏུ་ཡིད་ཀྱང་རངས་པར་འགྱུར།",
    "དེ་དག་དུས་ཀུན་དུ་ཡང་མཚུངས་མེད་དོན་བྱེད་དེ།",
    "དགའ་ཞིང་རངས་པ་སྐྱེས་ནས་སུ།",
    "བར་སྣང་ལ་ནི་འདུག་ནས་སུ།",
    "མྱི་ཕྲུག་བ་རྒན་ཁོ་རང་འཕུང་སྱི་རྔ་ཞོན་མ་བུ་དགུ་སྐོར་གྱིས་སྱིང་བརླམས་པ་ལྟ་བུར་གྱུར་ཏྗེ།",
    "ཁོ་རང་ག་ྱི་རྒྱུ་དུས་ཀྱི་ཀུན་སློང་།",
    "ངྗེད་ཚོར་མ་ཟད་ཁྗེད་ལའང་ཁབ་རྟགས་ཀྱི་ལན་རྱི་ཚུལ་ཁ་དོག་དཀར་དམར་བ་ཞྱིག་གྱི་བཟོ་ལྟའང་མ་བྱུང་འདུག་པ་འདྱི་རང་གྱིས་རྱིགས་སྨྲ་འབུམ་ཕྲག་དཔང་བོར་གསོལ་བའྱི་སྤན་སྔར་ངོ་ཚར་མྱི་ཆྗེའམ། ཟག་བཅས་ཀྱི་སྒྲས་བསད་ཚད་ལ་ཟག་བཅས་ཀྱིས་ཁབ་པར་མྱི་འདོད་ཀང་།",
    "ཞྗེས་གསུངས་པ་འདྱི་རྗེ་ཡབ་སས་ཀྱི་གཞུང་གཞན་དང་སྒྲས་ཟྱིན་མྱི་མཐུན་པ་ལྟ་བུར་འདུག་ཅྱིང་།",
    "ཁྗེད་ཀྱིས་འབྲུ་ཐམས་ཅད་ནས་རོག་གཅྱིག་ཏུ་བསྒྲྱིལ་བར་མཛད་འདུག་སྗེ།",
    "རྗེ་བ་མའྱི་རྗེས་འབང་ག་ྱི་མཁས་པ་ཆྗེན་པོ་དག་ག་ྱི་གསུང་དྲངས་པ་ཙམ་གྱིས་ཅྱི་ཡང་མྱི་འགྲུབ་བོ་ཞྗེས་ཁོད་ཀྱིས་ཞལ་བཞྗེས་དངོས་སུ་མཛད་འདུག་པས།",
    "གཉྱིས་སྣང་འཁྲུལ་བའྱི་སྗེམས་ཁོ་རང་ཤ་ྗེས་སྒྲྱིབ་ཏུ་འཇོག་པར་བཞྗེད་པ་ག་ལ་ཡྱིན།",
    "ལས་ཞྗེས་དྲངས་ནས་རང་ག་ྱི་དྗེ་ཉྱིད་དམར་རྗེན་དུ་བསན་འདུག་པའྱི་ལུང་དྗེ་འཕགས་པ་ཐོགས་མྗེད་ཀྱིས་བརམས་པ་ཡྱིན་མྱིན་རར་ཞྱིབ་གཅོད་དང་།",
    "ཞྗེས་པ་འདྱི་གཉྱིས་ཀྱིས་རང་བཞྱིན་བརྒྱུད་ཅུའྱི་རྟོག་པ་ལ་རང་རང་གྱི་བག་ཆགས་ཀང་འཇོག་པ་དང་།",
    "རྱིམ་པ་བཞྱི་བའྱི་འོད་གསལ་གྱི་རྗེས་སུ་བྱུང་བའྱི་རང་བཞྱིན་བརྒྱད་ཅུའྱི་རྟོག་པ་དྗེ་ཤྗེས་སྒྲྱིབ་ཡྱིན་པར་གསུངས་ཨྗེ་འདུགའདྱི་རྱི་ལམ་མྱིན་འདུག་པས་མྱིག་ལྗེགས་པར་ཕྗེ་ལ་ལྟོས་ཤྱིག་འདྱི་དག་སྔར་མ་མཐོང་བ་མྱིན་འདྲ་ཡང་།",
    "ཞྗེས་དྲངས་འདུག་པས།",
    "ཁྗེད་ཀྱིས་ལས་ཉོན་གྱི་འབས་བུ་ཡྱིན་ཙམ་ལ་བོ་རྗེ་གཏད་འདུག་ཅྗེས་ཕོགས་སྔའྱི་དགོངས་པའྱི་གཏད་སོའང་ཤ་ྗེས་པ་སྐད་པའྱི་ཕྗེར་གཏམ་དྗེས་ཅྱི་ཞྱིག་བྱ།",
    "ཀུན་བཏུས་ར་འགྗེལ་ཐམས་ཅད་ལས་སྐྗེ་བ་ཞྗེས་པའྱི་ཚིག་ནན་གྱིས་སྦར་འདུག་པ་དྗེ་དགོས་མྗེད་ཀྱི་ཚིག་ལྷག་ཏུ་བྱས་གསུང་རྒྱུ་ཡྱིན་ནམ།",
    "རྒྱལ་ཚབ་ཐམས་ཅད་མཁྗེན་པ་ལ་འཕྲྗེད་གཤགས་སུས་བརྒྱབ་འདུག་ལྗེགས་པར་དགོངས་ཤྱིག་གད་རྒྱངས་སུ།",
    "ལ་རྒྱའྱི་ཁ་འཛིན་ཙམ་ལས་ཐུགས་ཀྱི་བཞྗེད་ཕུགས་ངྗེད་ཚོའྱི་ཕོགས་ལ་ལྷུང་འདུག་པ་བསོན་མྗེད་དུ་གོའོ།",
    "དྗེ་ཀུན་མཁྗེན་བ་མའྱི་གསུང་རྒྱུན་ཡྱིན་ཤས་ཆྗེ་བའྱི་ཕྱིར་རོ། ནང་འགལ་ཡོད་ཚུལ་ཁྗེད་ཡབ་སས་ལ་གསུང་རྒྱུ་ཞྱིག་ཡོད་ན་གསུང་རན་འདུག་ཅྗེས་བསྐུལ་ན་ཡང་།",
    "ཀུན་མཁྗེན་བ་མ་ཆྗེན་པོ་དྗེ་ཉྱིད་ཀྱི་བཀའ་དྲྱིན་ལ་བསམས་ནས་ལན་གསུམ་ཁ་རོག་འདུག་གོ། སྡུག་ཀུན་རགས་པ་ཉྗེ་བར་ཞྱི་བའྱི་ཉྗེར་ཞྱི་ཙམ་ཡང་མ་ཐོབ་པའྱི་ལྷག་མྗེད་དག་བཅོམ་དྗེ་ཉྱིད་ཀྱིས།",
    "དམ་བཅའ་ནང་འགལ་གྱི་ཚ་མ་རྒྱག་ཅྗེས་ནན་ཏན་མཛད་འདུག་པའྱི་ཕྱིར་རོ། རོད་ཡྱིག་སྔ་མ་ལ་མྱི་འཐད་པ་གངས་མྱི་ཟྱིན་པ་ཡོད་ཀང་རྒྱས་པར་འགོག་པ་ལྟ་ཅྱི།",
    "ཨོཾ་ནྱི་རྱི་ལུ་ཙ་ན་ཀའྱི།",
    "ཁོད་རང་ག་ྱི་དབུ་ལ་གནམ་ལྕགས་ལས་ཀང་རྣོ་བའྱི་ལུང་རང་ག་ྱི་སྒྲུབ་བྱྗེད་ཀྱི་སྱིང་བོར་སྗེམས་པ་ནྱི་གཤྗེད་མ་ཕར་འཛིན་ལས་ཀང་ཐུ་བའྱི་འཁྲུལ་རྟོག་ཆྗེན་པོ་སྗེ།",
    "ཕ་མའྱི་རྒྱུད་ཀྱི་བསན་བྱའྱི་གཙོ་བོ་རོགས་རྱིམ་གཉྱིས་ཀང་གསལ་བར་གསུངས་འདུག་པས་ཕ་མའྱི་རྒྱུད་ཀྱི་ཁད་པར་སྔགས་རྱིམ་ལས་གསལ་བར་གསུངས་ཞྗེས་སྨྲས་ན་ཅྱི་ཡྱིྱིས་ཀང་ནོངས་པར་མྱི་འགྱུར་བའྱི་ཕྱིར།",
    "གང་ལྟར་ཡང་འདྱི་ཀས་ལོག་ནོམ་ཕྲན་བུས་ཁོ་རང་ག་ྱི་རོད་པ་བཤོལ་བར་གཞན་ལ་གགས་པ་སྐད་པ་དྗེ་ཅྱི།",
    "རྒྱམ་གསན་ཐོར་ལོ་ག་ོན་ཆད་འདུག་པས་གནང་མཁན་ཚོས་མཉམ་འཇོག་དགོས།",
    "བེ་རོ་ཙ་ན་རཀ་ྱི་ཏའྱི་སྒྲུབ་ཐབས་རོ་རྗེའྱི་འོད་འདྱི་དཔྱི་ས་བློ་གློས་རྒྱ་མཚོ།",
    "ཡྗེ་ཤྗེས་སྗེམས་དཔའ་སྦོར་རུང་མྱི་རུང་སོགས་དགག་གཞག་མང་པོ་བྱས་འདུག་འདྱི་སྤྱིར་བདྗེ་མཆོག་དཀར་བོ་ལ་ཡྱིག་རྱིང་ལུགས་དང་།",
    "ལྕང་སྐས་ནན་གྱིས་བསྒྲུབས་འདུག་པས་མདུན་བསྐྗེད་ལ་འཁོར་སྔགས་ཀང་ཆད་མྗེད་བྱས།",
    "རྗེ་བ་མས་བདྗེ་གསང་འཇྱིགས་གསུམ་ལྟ་བུར་མཚོན་ན་རང་རང་གྱི་གྲུབ་ཆྗེན་ལཱུ་ནག་དྲྱིལ་གསུམ།",
    "ཞྗེས་རྣལ་དང་འབྱོར་ཕྲལ་ནས་འཆད་པ་ལ་དགག་པ་བྱས་འདུགམདའ་སྔགས་གཉྱིས་ཀྱི་དོན་ཐོབ།",
    "རང་རང་ཕྱིའྱི་དྗེ་དང་།",
    "ཞྗེས་གསུངས་པ་འདྱིས་རྣལ་འབྱོར་མ་འདྱིའྱི་མཚན་དོན་ཡང་བསན་འདུག་ལ།",
    "རྣལ་འབྱོར་རོལ་བར་རྟགས་བྱྗེད་པར་གསུངས་འདུག་པས་ཉན་ལོག་བྱས་འདྲ།",
    "རང་རང་ག་ྱི་ཡྱི་དམ་གྱི་གཙོ་བོ་བྱས་པའྱི་མཁའ་སྤོད་རྗེ་ཡང་ངྗེས་པར་འདོད་དགོས།",
    "ཞྭ་ལུ་སོགས་ན་འདྱིའྱི་ཟུར་བཀའྱི་རྒྱུན་ཡང་འདུག་རྒྱུད་གསུངས་ཚུལ་སོགས་ལ་བོ་དོང་གྱིས།",
    "གཡྗེར་གཤོང་སོགས་ཀྱིས་གོ་བདུན་མཛད་འདུག་དྗེ་ཡང་རྟ་བབས་སྗེང་དུ་མཆོད་རྟྗེན་གྱི་རྒྱལ་ཆྗེན་བཞྱི་བརྱིས་མ་བརྱིས་ཀྱི་ཁད་རྗེད།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་དཀར་པོ་ལྷ་ལྔ།",
    "གྲུབ་ན་དོན་ཆྗེ་བ་དང་རང་རྗེར་འགྲུབ་སླ་བའྱི་རྟྗེན་འབྗེལ་ཡང་ཡོད།",
    "རྣལ་འབྱོར་པ་སྟན་བདེ་བ་ལ་འདུག་སྟེ་ཡི་དམ་གྱི་ལྷ་ཁྲོ་བོ་གང་ཡང་རུང་བའམ།",
    "ཁྲི་གང་ལ་འདུག་པའི་དགེ་སློང་འཆག་པའི་མགོས་ལ་ཐུག་པར་འགྱུར་བའི་ཁྲི་དེ་ལྟ་བུ་ལ་ཉལ་བར་མི་བྱ་བ་སྟེ།",
    "མལ་སྟན་མཐོན་པོ་དང་མལ་སྟན་ཆེན་པོ་ལ་འདུག་པ་འམ་ཉལ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "འདུག་པ་འམ་ཉལ་བར་མི་བྱའོ་ཞེས་ཚིག་གཉིས་སྨོས་པའི་སྔ་མ་ཤོས་འདུག་པ་ཞེས་བྱའི།",
    "ཁྲི་བརྩེག་མའི་སྟེང་དུ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་ཁྲི་བརྩེག་མ་ཞེས་བྱ་བ་ནི་ཁྲིའི་སྟེང་དུ་ཁྲི་བཞག་པ་སྟེ་དེ་ལ་འདུག་པར་མི་བྱའོ།",
    "འདུག་ན་འགལ་ཚབས་ཅན་དུ་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་གལ་ཏེ་དགེ་སློང་ལམ་པོ་ཆེན་འདུག་པས་དགེ་སློང་མ་གང་ཡང་རུང་བ་ན་འདུག་པ་དེ་ལས་བཅའ་བ་དང་བཅའ་བ་ལེན་ཅིང་ཟ་བར་བྱེད་ན་དངོས་གཞིར་འགྱུར་རོ།",
    "ཡོད་དེ་དགེ་སློང་གནས་ན་འདུག་པས་དགེ་སློང་མ་ཁྱིམ་གཞན་ན་འདུག་པ་ལས་ལེན་ནའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་དེའམ་དགེ་སློང་གཞན་ལ་འདི་ལ་བཅའ་བ་འམ་བཏུང་བའམ་སྲན་ཚོད་དམ་བཟའ་བ་འམ་ཡང་བྱིན་ཅིག་ཅེས་བྱ་བ་ལ་སོགས་པས་སྐོ་ཤམ་བྱེད་པ་ལ་ཞུགས་པའི་དགེ་སློང་མ་འདུག་པ་ནི་བྱེད་པ་པོ་ཡིན་ནོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཅི་དགེ་སློང་མ་དེ་ལྟར་གྱུར་པ་ཐམས་ཅད་ཀྱི་འདུག་པ་དེ་བྱེད་པ་པོ་ཉིད་ཡིན་ནམ་ཞེ་ན།",
    "འདིར་དགེ་སློང་མ་ཐག་ཇི་སྲིད་ན་འདུག་པར་གྱུར་པ་ཁ་ན་མ་ཐོ་བ་ཇི་ལྟ་བུའི་བྱེད་པ་པོ་ཡིན་ཞེ་ན།",
    "གལ་ཏེ་དེ་སྐད་ཉེ་བར་གདགས་ཤིང་བསྒོར་མི་རུང་བའི་ཐག་དེ་ཙམ་ན་འདུག་པ་ལ་ཉེ་བར་མ་བརྟགས་ཤིང་མ་བསྒོ་ན་ཉེས་བྱས་ཀྱི་བྱེད་པ་པོ་ཡིན་ནོ།",
    "ཟླུམ་པོ་ཞེས་བྱ་བ་ནི་མཐའི་ཁ་མཉམ་པར་འདུག་པའོ།",
    "ལྟེ་བའི་གོང་རོལ་དུ་ཏ་ལའི་ལོ་མ་ལྟར་ལྟེབས་ཤིང་འདུག་པ་དེ་ལྟ་བུ་མ་ཡིན་པར་ཤམ་ཐབས་ཟླུམ་པོར་བགོ་བར་བསླབ་པར་བྱའོ།",
    "ཕུར་མ་ལྟར་འདུག་པར་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "གློ་ནས་ཕྱི་རོལ་གྱི་རིམ་པའི་གྲྭ་ཕུར་མ་ལྟར་འདུག་པ་དེ་ལྟ་བུ་མ་ཡིན་པར་ཤམ་ཐབས་ཟླུམ་པོར་བགོ་བར་བསླབ་པར་བྱའོ།",
    "དང་པོ་གསུམ་ཞེས་བྱ་བ་ནི་ཟླུམ་པོར་འདུག་པ་དང་ཧ་ཅང་རྩེངས་པ་མ་ཡིན་པ་དང་ཧ་ཅང་འཇོལ་བ་མ་ཡིན་པ་ཞེས་བྱ་བ་དེ་དག་གོ།",
    "འདུག་པར་བྱ་བ་དགུ་དག་དང་།"
  ]
}