    "བྱུང་ནས་མི་རྒོད་མང་པོ་ལངས་འདུག་ཟེར།",
    "རྒྱལ་པོའི་དབུ་ལ་རྨོག་ཆེན་བཞེས་ཙ་ན།",
    "སྤྱིསརྒྱལ་པོའི་སྐུ་ལ་སྟག་དོང་གསོལ་ཙ་ན།",
    "མི་འགྲོ་ཞུ་བ་ཕུལ་ས་རང་ཅག་གཉིས་ལ་མི་འདུག།",
    "དགྲ་བོ་རྒྱལ་ཞིང་རང་ཉིད་ཕམ་པ་རུ་བྱས་ཡོང་།",
    "བསམ་བློ་གང་ནས་བཏང་ཡང་འབྲལ་དུ་ཕོད་པ་མི་འདུག།",
    "ང་རང་ཡབ་ཀྱི་བཀའ་བཞིན་དགྲ་བོ་འདུལ་དུ་འགྲོ་སྟེ།",
    "བསམ་བློ་གང་ནས་བཏང་ཡང་འབྲལ་དུ་ཡོད་པ་མི་འདུག།",
    "རྟ་དང་རྟེའུ་འཕྲལ་ཡང་རྟ་ར་ཕན་ཚུན་ཡིན་འདུག།",
    "དེ་ཡང་དྲན་པའི་སེམས་ཀྱིས་ཕར་སྐད་ཚུར་སྐད་བྱེད་འདུག།",
    "བལྟས་པས་མཐོང་ས་མི་འདུག་བོས་པས་ཚོར་ས་མི་འདུག།",
    "དེ་ཡང་དུང་བའི་སྐད་ནི་ཕར་སྐད་ཚུར་བྱེད་འདུག།",
    "ང་དང་རྒྱལ་པོ་ནོར་བཟང་འབྲལ་དུ་ཡོད་པ་མི་འདུག།",
    "འདབ་བྱ་ཁ་ཡ་བྲལ་བ་བྲག་སྟོད་ཡ་ན་མི་འདུག།",
    "མ་ཤི་གསོན་བྲལ་བྱེད་པ་ང་མིན་གཞན་ལ་མི་འདུག།",
    "རྒྱལ་པོ་བྱང་ལ་འཐབ་དགོས་རྒྱུ་གྲི་ཁྱེད་རང་བསྣམས་དང་།",
    "ཞེས་ཕོ་ལྷ་གསོལ་བས་ལུང་པ་དེའི་བྱང་ཤར་ཐང་དུ་གཞན་ན་མེད་པའི་ས་བཙན་བྷེ་ཝ་ཅུསྤྲིན་གསར་དཀར་པོ་གཅིག་ཐོན་བྱུང་བས་དེ་ལམ་སྟོན་གྱི་བརྡ་རུ་གོ་བ་དེའི་ཐད་དྲངས་པའི་རིང་པོར་བགྲོད་པའི་ས་ཞིག་ན་ཆུ་མིག་ཅིག་འདུག་དེ་དང་ཉེ་འདབ་ན་རྩྭ་ཡང་ཕྲན་བུ་འདུག་པ་དེར་སྒར་བབས།",
    "ནུ་ཞོ་འཐུང་ཞིང་མ་ཡི་དུང་སེམས་ཆེ་བ་འདུག་ག།",
    "གྱོན་པ་ལྤགས་རིགས་ཤ་སྟག་གྱོན་ཞིང་མཚོན་ཡང་གྲི་ཙམ་ལས་གཞན་མེད་པ་ཞིག་འདུག་པ།",
    "ཚུར་ཉོན་དང་རང་རིགས་ཕ་བུའི་ཚོགས།",
    "དུས་དེང་སང་རང་ཡུལ་བྱང་ཕྱོགས་འདིར།",
    "སྔོན་མེད་ཀྱི་དཔུང་ཞིག་སླེབས་འདུག་ཟེར།",
    "གླིང་རང་ཕྱོགས་ཉི་ཟླ་གཟའ་ཡིས་འཛིན།",
    "གླིང་རང་ཕྱོགས་ཉི་མ་གཟས་ཟིན་པའི།",
    "དོན་ཆབ་སྲིད་འཆོར་བའི་བརྡ་རུ་འདུག།་",
    "ང་ལ་ཁྱད་མེད་ཁྱེད་རང་ཅི་དགའ་བྱེད།",
    "ཐང་དཀར་རྒོད་པོ་ཁོ་ལ་འགྲོ་ས་ཨེ་འདུག་ལྟོས་ཤིག།",
    "དང་པོ་མི་དྲན་དགུ་དྲན་ལྔ་བརྒྱ་ཡིས་དྲན་འདུག།",
    "བདལ་གཞིགསཡབ་ཆེན་སྐུ་ཁམས་བཟང་བའི་བརྡ་རུ་འདུག།",
    "བུ་ཆུང་ཡུལ་དུ་འཁོར་གདོང་ཡིད་འཕྲོག་མེད་པར་བཟོས་འདུག།",
    "འདབ་བྱ་ལྷ་བྱ་མ་ཡིན་འདྲེ་བྱ་རང་ལ་འདུག་གོ།",
    "ང་ཡི་ཡིད་འཕྲོག་མེད་པར་ཚར་འདུག་པས།",
    "ཡིད་འཕྲོག་མེད་ན་བུ་ཆུང་རང་ཡུལ་དུ།",
    "ལོག་ཀྱང་བློ་སེམས་སྐྱོ་བའི་རྒྱུར་འདུག་ཀྱང་།་",
    "དེ་ནི་ནོར་བུ་བཟང་པོའི་འཕྲིན་དུ་འདུག།",
    "ཚིག་དོན་འདི་བཞིན་འདུག་པས་ད་ཉོན་ཅིག།",
    "ཡབ་ཆེན་རྒྱལ་པོའི་ཐུགས་ལ་ཇི་འདྲ་ཞིག་འདུག་པ།་",
    "ཐབ་བསུའི་སར་ཡུམ་ཕེབས་པ་མཁྱེན་པས་མདའ་རྒྱང་ཙམ་ནས་ཆིབས་བཤོལ་མཇལ་དར་ཕྱག་ཏུ་བསྣམས་ནས་ཕེབས་པས་ཡུམ་ཀྱང་ཚུར་ཙམ་ཕེབས་མཇལ་དར་རྩེ་སྤྲོད་གནང་སྟེ་ནོར་བཟང་ནས་ཕྱག་དང་བཅས་འདི་སྐད་དོ།",
    "ང་ལ་དགྲ་བོ་མང་ནས་ད་དུང་ཐུལ་དུས་མི་འདུག།་",
    "བློ་འཚབ་པར་གྱུར་ནས་འདུག་གོ།",
    "བུ་ཆུང་བྱེས་པས་བྱེས་གོ་གང་ཆོད་ཁྱེད་རང་ཞུས་ཡོད།",
    "འདི་འདྲ་ཡབ་ཆེན་པ་ཕས་ཐུགས་ནས་ཐོད་པ་འདུག་གམ།",
    "གཉིས་པར་ཡིད་འཕྲོག་མེད་པའི་བྱ་ངན་འདི་བཞིན་བརྩམས་འདུག།",
    "འདི་འདྲ་དགྲ་བོ་ཡིན་ཀྱང་ཐུགས་ནས་ཕོད་པ་འདུག་གམ།",
    "ད་ལན་ཡང་འཇའ་འདི་ལམ་སྟོན་གྱི་བརྡ་རུ་འདུག་དགོངས་ཏེ་ཐུགས་ལ་ཤར་བས་དགྱེས་པར་གྱུར་ནས་ཀེའུ་རིར་རྩོལ་ཁྱད་ཀྱིས་བྱོན།",
    "གསོད་འདོད་དཔའ་སྐད་མང་དུ་བསྒྲགས་འདུག་ཀྱང་།",
    "སྔོན་མེད་སྐྱེས་པ་ཡ་མཚན་ཅན་ཞིག་འདུག།",
    "མཐོང་འཕྲུལ་འཇིགས་ཤིང་སྐྲག་པའི་མི་ཞིག་འདུག།",
    "ཞིབ་པར་བལྟས་ན་ཡིད་ཀྱང་སྤྲོ་བར་འདུག།",
    "ད་ལྟ་རིན་ཆེན་སྤུངས་འདྲའི་ཁ་ན་འདུག།",
    "ལྡེམ་ལྡེམ་སྐུ་ཡི་རྣམ་འགྱུར་དར་དཀར་ཡོལ་བས་སྒྲིབ་འདུག།",
    "གསུང་ཞིང་ཁྲོ་བའི་རྣམ་པ་འདུག་ན་ཡང་།",
    "དད་ལྡན་མཇལ་ཞུར་བཅར་བ་མིན་འདུག་ཀྱང་།",
    "ནོར་བཟང་ཐག་རིང་ནས་བྱོན་སྐུ་ངལ་འདུག།",
    "ཁྱེད་རང་རྒྱལ་ཁག་ལྔ་ཡིས་རྩལ་འགྲན་ནས།",
    "འདོད་པར་ཡོད་ན་ང་ཡིས་ལག་ན་འདུག།",
    "རང་རང་མདའ་དར་ནམ་མཁར་འཕངས་པ་ཡིས།",
    "དེ་ཡང་བྱེད་དཀའ་ཟེར་བའི་རྒྱུར་འདུག་ཅིང་།",
    "ཡིད་འཕྲོག་སྟོབས་འབྱོར་དང་བཅས་ཁྲིད་འདུག་ཞུས།",
    "དེང་དུས་བསམ་གླིང་གཞིས་ཀར་འབྱོར་འདུག་ཞུས།",
    "སྔར་གྱི་འབྱོར་བའི་སྟོབས་དང་ལྡན་པ་འདུག།་།",
    "སྟོབས་འབྱོར་ཡ་མཚན་ཆེ་བ་འདུག་ཟེར་བའི།",
    "བསམས་ན་ང་འགྱོད་ངོ་ནི་གནོང་བར་འདུག།",
    "དེ་དྲུང་རང་ཅག་ཁ་ཤས་བཅར་བ་ཡིས།",
    "རང་གཞན་གཉིས་ཀ་ཕུང་བའི་རྒྱུར་འདུག་ཅིང་།",
    "དྲི་བ་བྱས་པའི་ཐོ་ལ་འདི་ལྟར་འདུག།",
    "བྱང་ཕྱོགས་རྗེ་འབངས་མཛད་སྤྱོད་འདི་ལྟར་འདུག།",
    "དྲག་པོས་ཚར་གཅོད་གནང་ཞེས་གསུངས་གདའ་བ།",
    "ཡབ་ཀྱི་བཀའ་བཞིན་འབབ་འབྲེལ་འདུག་ན་ཡང་།",
    "ཅེས་རབ་ཏུ་ཁྲོས་ནས་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་ཅི་ཡང་མ་སྨྲ་བར་འདུག་ག།",
    "དྲི་ཟ་ལ་སོགས་པ་འཁོར་གྱི་དཀྱིལ་འཁོར་ཐམས་ཅད་འདུག་པ་ལས་ལངས་ནས།",
    "འདུག་པ་ལས་ལངས་ཏེ།",
    "ཕས་རྒོལ་བའི་དགྲ་ཐམས་ཅད་ཞི་ཞིང་རང་ལྡོག་པར་འགྱུ་བ་དང་།",
    "འཁོརགྱི་ད་ཀྱིལ་འཁེར་དེའི་ནང་ན་འདུག་པ་ལས་ལངས་ཏེ།",
    "ཅི་ཡི་སླད་དུ་དེར་འདུག་དགེསློང་སྡིག་ཅན་ལ།",
    "སློང་དེ་ནི་དེར་འདུག་མ་གནང་།",
    "དེ་ནས་དེ་དག་འདུག་པ་ལས་ལངས་ཏེ།",
    "དེ་དག་འདུག་པ་ལས་ལངས་ནས།",
    "ཉན་ཐོས་དང་རང་སདས་རྒྱས་ཀྱི་སྲེག་པ་པ་ཐམ་ཅད་ཀྱིས་མཆོད་ཅིང་བསྙེན་བཀུར་བྱ་བ་དང་ཡོདས་སུ་བསྲུང་བར་འགྱུར་རོ།",
    "ཉན་ཐོས་དང་རང་སདས་རྒྱས་ཐམས་ཅད་དང་།",
    "ཉན་ཐོས་དང་རང་",
    "ཕྱིནས་སྟན་ལ་འདུག་བྱེད་ན།",
    "སྟན་ལ་འདུག་པ་ལྟ་བུར་སྣང་།",
    "ཁ་དོག་བཟར་བརྒྱས་པ་མཆོག་དང་ལྡན་པ་ཞིག་འདུག་སྟེ།",
    "འདུག་པ་དང་།",
