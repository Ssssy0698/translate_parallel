    "གང་གི་ཚེ་ནང་གི་བྱེ་བྲག་དམིགས་པ་ཡིད་དུ་འོང་བ་ལ་སོགས་པ་མཐོང་བ་དེའི་ཚེ་བདེ་བ་དང་སྡུག་བསྔལ་དག་ཕྱི་རོལ་ལ་བརྟེན་པར་འགྱུར་གྱི།",
    "ནང་གི་ཁྱད་པར་ལས་སྐྱེ་བའི།",
    "དེར་ཡང་འདུས་པ་ལ་སོགས་པས་ན་ང་གི་དོན་གྱི་ཁྱད་པར་ལ་དམིགས་པའི་བློ་ཉིད་ཀྱིས་ཡིད་འགྱུར་བ་སྐྱེད་པར་བྱེད་པ་ཡིན་གྱི་ལུས་ནི་མ་ཡིན་ཏེ།",
    "ཕྱི་རོལ་གྱི་ཁྲག་ལ་བརྟེན་པ་ནི་མ་ཡིན་པས་དེ་ལོག་ཀྱང་ཡིད་མི་ལྡོག་པ་དེ་བཞིན་དུ་ནང་གི་དོན་ལ་དམིགས་པ་ཉེ་བ་ལས།",
    "འདིའི་དགོངས་པ་ནི་གལ་ཏེ་རྟོག་པ་པོ་དང་ལྡན་པ་ཡིན་ན་དེའི་ཚེ་རང་ལ་རང་གི་ངོ་བོ་རྟོགས་ཀྱི་ཐོབ་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་སྡུག་བསྔལ་ལ་ཕྱིན་ཅི་ལོག་གི་བློ་ཅན་ཏེ།",
    "གང་ལ་སྲིད་པ་དང་ཕྱིན་ཅི་ལོག་གི་བློ་དེ་དག་མེད་པ་འདི་ནི་སྐྱེ་བ་ལེན་པར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་ཡང་འགྲོ་འོང་མ་མཐོང་ན་ཡང་དེ་ལྟ་མོད།",
    "དཔེར་ན་མིག་ནི་གསལ་བ་ཅན་གྱི་དུ་བ་ཕྲ་མོ་མི་དམིགས་ལ་སྐྱེ་བ་མ་ཡིན་པའི་ཕྱིར།",
    "འདི་ལྟར་གང་གི་ཚེ་འདུ་བྱེད་པ་སྟོབས་ཅན་དུ་གྱུར་པ་དེའི་ཚེ་གཡེང་བ་ལྡོག་པར་འགྱུར་ལ།",
    "གང་གི་ཚེ་གཡེང་བ་སྟོབས་དང་ལྡན་པ་དེའི་ཚེ་འདུ་བྱེད་པ་ཡོད་ཀྱང་རང་དང་མཐུན་པའི་རྣམ་པར་ཤེས་པ་མི་སྐྱེད་དོ།",
    "འོ་ན་སེམས་ནི་སེམས་ཀྱི་རྟེན་ཡིན་མོད།",
    "དེ་བས་ན་རང་གི་རྒྱུད་ལ་འཇུག་པའི་ཤེས་པའི་འདུ་བྱེད་པ་སེམས་ལ་འཇུག་པ་ཉིད་ཡིན་གྱི།",
    "ལུས་ཉིད་ལ་ནང་གི་བདེ་བ་ལ་སོགས་པ་དམིགས་པའི་ཕྱིར་སེམས་དེ་ལས་ཐ་དད་པ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "གང་གི་ཕྱིར།",
    "རྟོག་པ་ནི་ནང་གི་རེག་བྱའི་ཁྱད་པར་གྱི་རང་བཞིན་ཡིན་པས་གཞན་གྱིས་མི་མཐོང་ངོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "ཕྱི་རོལ་གྱི་རེག་བྱ་རྨ་གཞན་གྱིས་མཐོང་ཡང་།",
    "འདི་ལྟར་འཆི་བ་དང་སྐྱེ་བའི་སྲིད་པ་དག་གི་བར་མ་ནི་བར་མ་དོའི་སྲིད་པར་འདོད་ཅེ་ན།",
    "རྡུལ་ཕྲ་རབ་ལ་རེག་པའི་ཕྱིར་རོ།",
    "རང་གི་རིག་པ་ནི་ཐ་དད་པ་མི་རིགས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "རི་བོང་གི་རྭ་ལ་རིག་པར་ཅི་སྟེ་ཁས་ལེན་པར་མི་བྱེད།",
    "རི་བོང་གི་རྭ་ལས་ནུས་པས་སྟོང་པའི་ཕྱིར་རིག་པ་པོར་མི་རུང་ངོ་ཞེ་ན།",
    "རང་གི་ངོ་བོ་མྱོང་བ་ལས་སྔོན་པོ་གསལ་བྱར་མྱོང་བ་ངེས་པ་མེད་པར་ངེས་ཤིང་།",
    "དེའི་ཕྱིར་ཤེས་པ་ནི་གཟུགས་ལ་སོགས་པའི་རང་བཞིན་ཉིད་ཡིན་པའི་ཕྱིར་རྡུལ་ཕྲ་རབ་རིག་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་མོད་ཀྱི་ཆ་ཤས་ཅན་གྱི་ཤེས་པའི་ངོ་བོ་ཉིད་ཡོད།",
    "འདྲེས་པའི་བྱེ་བྲག་གིས་ཡན་ལག་ལ་སྒྲིབ།",
    "དེ་ལྟ་མོད་ཀྱི་ཡན་ལག་ཅན་ལ་མི་སྒྲིབ་ན་རྫས་ཐམས་ཅད་མཐོང་བར་འགྱུར་རོ།",
    "ཡན་ལག་གི་སྒོ་ནས་སྒྲིབ་ན་ཅུང་ཟད་ཀྱང་མི་མཐོང་བ་ཉིད་དོ།",
    "ཕན་འདོགས་པའི་བྱེ་བྲག་གིས་རྫས་གཞན་པས་ཡན་ལག་དམར་པོར་འགྱུར་བ་ཡིན་གྱི་ཡན་ལག་ཅན་མ་ཡིན་ནོ་ཞེ་ན།",
    "སྣ་ཚོགས་རྡུལ་ཕྲ་མོ་ཙམ་དུ་ཁས་ལེན་པ་མ་ཡིན་ནམ།",
    "ལྡན་པས་ཡིན་ན་འདིར་ཐལ་མཚུངས།",
    "ཡན་ལག་ཅན་དང་འབྲེལ་པའི་སྒྲིབ་གཡོགས་གང་དུ་ཡང་མ་མཐོང་བའི་ཕྱིར་གང་གིས་དེ་མེད་ན་མེད་པ་ཡིན།",
    "དེ་ལྟ་མོད་ཀྱི་ཁྱོད་ཀྱི་ལྟར་ན།",
    "ཕྱོགས་གཅིག་གིས་ཡིན་ཏེ།",
    "དེ་ལ་ཕྱོགས་གཅིག་གིས་ནི་མ་ཡིན་ཏེ།",
    "གོང་བུ་ཡང་རྡུལ་ཕྲན་ཙམ་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྦྲང་མ་ལ་སོགས་པ་དག་གིས་ཀྱང་བར་མེད་པ་ཉིད་མཐུག་པོའི་རྣམ་པར་སྣང་བ་སྐྱེད་པ་དེ་བཞིན་དུ།",
    "དེ་ལྟར་ནི་འགྱུར་མོད་ཀྱི་གལ་ཏེ་གསེར་དང་དངུལ་ཆུ་དག་རིགས་མི་མཐུན་པའི་ཕྱིར་རྫས་བསྐྱེད་པ་མ་ཡིན་ཡང་།",
    "དེ་ལྟ་མོད་ཀྱི་ལྡན་པ་དང་འཕྲོད་པ་འདུ་བ་ལས་རྡུལ་ཕྲ་རབ་ཀྱི་གཟུགས་ཀྱང་འཛིན་པར་འགྱུར་རོ།",
    "དེ་ལྟ་མོད་ཀྱི་འོན་ཀྱང་རྡུལ་ཕྲ་རབ་འདྲེས་པ་ཅན་རྣམས་ཀྱི་གཟུགས་ལ་སོགས་པ་གང་ཡིན་པ་དེ་ཉིད་འདྲེས་པའི་གཟུགས་ལ་སོགས་པ་དང་ཐ་དད་པར་སྣང་བར་འགྱུར་རོ།",
    "དེ་ལྟ་མོད་ཀྱི་རྫས་གཞན་བརྟགས་ཏེ་ཅི་ཞིག་བྱ་སྟེ།",
    "གང་གི་ཕྱིར་འདྲེས་པ་མེད་པའི་ཕྱིར་མ་འདྲེས་པ་དང་།",
    "འདི་ལྟར་མིག་གི་བྱེད་པའི་རྗེས་ལ་བུམ་པ་དང་ལྡན་པ་དག་གཅིག་པའོ་ཞེས་བྱ་བར་རྟོགས་པའོ་ཞེ་ན།",
    "མིག་གི་ཤེས་པས་ཀྱང་ལྡན་པ་ཅན་གཟུགས་ལ་སོགས་པ་རྟོགས་པར་འགྱུར་གྱི་རྫས་ལ་སོགས་པ་ཐ་དད་པ་ནི་མ་ཡིན་ནོ།",
    "བརྗོད་པའི་རང་བཞིན་ནང་གི་ཤེས་པས་བརྗོད་པར་འགྱུར་བ་ཉིད་ཡིན་གྱི་རིགས་ལ་སོགས་པ་རྣམས་ཀྱི་ངོ་བོ་ཉིད་ཀྱིས་སྣང་བ་ནི་མ་ཡིན་ནོ།",
    "འདི་དག་གིས་ནི་མི་དམིགས་པ་བསྟན་པ་ཡིན་ནོ།",
    "གལ་ཏེ་རིགས་ལ་སོགས་པ་མངོན་སུམ་གྱིས་མི་ཤེས་པ་དེ་ལྟ་ན་ཡང་བརྗོད་པ་དང་ཤེས་པ་གཅིག་གི་རྣམ་པ་ཅན་མཐོང་བའི་ཕྱིར་རིགས་ལ་སོགས་པ་ངེས་པར་བྱེད་པ་སྟེ།",
    "དེ་མི་རིགས་ཏེ་གང་གི་ཕྱིར།",
    "རྟོགས་པའི་བག་ཆགས་ཀྱི་སྟོབས་ལས་བྱུང་བའི་རྟོགས་པའི་བློ་ནི་རིགས་ལ་སོགས་པ་ཉིད་དུ་སྣང་གི་དངོས་པོའི་རྒྱུ་ཅན་ནི་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་བ་ལང་གི་གོང་བུ་ལ་གཞན་དུ་དཀར་པོ་ཉིད་མཐོང་ཞིང་།",
    "སྒྲོ་བཏགས་པའི་ཡུལ་ལ་སྒྲ་དང་ཤེས་པ་ཐ་དད་པ་དག་གིས་རིགས་དང་ཡོན་ཏན་ལ་སོགས་པ་ཐ་དད་པར་ཇི་ལྟར་སྒྲུབ་པར་བྱེད་དེ།",
    "དེ་དག་གིས་རྒྱུ་ཅིས་མི་འདོད།",
