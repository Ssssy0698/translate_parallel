    "ལས་རྣམས་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་།",
    "བདག་ལ་ཕན་ཕྱིར་མེ་ཏོག་ལ་། སོགས་སོ་སོར་བཞེས་པར་མཛད་དེ།",
    "ངན་འགྲོ་ཐམས་ཅད་རྣམ་པར་གྲོལ་།",
    "རྡོ་རྗེ་པདྨར་ལྡན་བྱས་ཏེ།",
    "རྡོ་རྗེ་ཞལ་གསུམ་ཕྱག་དྲུག་ནག་པོ་འོདཟེར་རྣམ་པར་འཕྲོག།",
    "མེ་ཏོག་འདབ་མ་ལ་སོགས་པ་གཏོར་མ་སྦྱིན་པར་བྱ།",
    "རོ་དེ་ལངས་ནས་འགྲུབ་པའི་བཀའ་བཞིན་ཉན་ཅིང་འཇུག་པར་འགྱུར་།",
    "རྡོ་རྗེ་སེམས་དཔའ་སེམས་དཔའི་ཚེ་དང་འདོད་པ་ཀུན་གྱི་འབྲས་བུ་ཐོབ་པར་འགྱུར་།",
    "འདོད་ཆགས་ཞེ་སྡང་ལ་སོགས་རྙེད་དང་ཕྲག་དོག་རྣམ་པར་སྤངས་།",
    "ལྔ་པ་དེ་བཞིན་དུ་དཀྱིལ་འཁོར་དང་ིདཀྱིལ་འཁོར་པ་ཐམས་ཅད་ཞུ་བར་གྱུར་པ་དེའི་འོད་ཀྱིས་ཡབ་དང་ཡུམ་དག་རོ་གཅིག་པར་ཞུ་བར་གྱུར་ཏེ།",
    "སྒྲིབ་པ་མེད་ཅིང་དག་པའི་ནམ་མཁའི་དབྱིངས་ཀྱི་རང་བཞིན་ཅན་ཤིན་ཏུ་དཀར་བའི་ཟླ་བའི་དཀྱིལ་འཁོར་སྟུག་པོའི་རྣམ་པར་བདག་ཉིད་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་གནས་པར་བསམ་པར་བྱའོ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "འདོད་ཆགས་དམ་ཚིག་ཆགས་པས་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།",
    "རབ་དགའི་སྤྱོད་པ་ཀུན་དུ་བཟང་པོ་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "མགོན་པོ་གལ་ཏེ་དེ་རིང་བདག་ནི་གསོན་པར་མཆིས་བཞེད་ན།་།",
    "ཡོན་ཏན་རིན་ཆེན་མང་པོའི་གཏེར་གྱུར་བདག་ལ་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "རིག་པ་དང་བཅས་པ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ག་ཞེས་བྱ་བའི་སྔགས་ཀྱིས་བརྟན་པར་བྱའོ།",
    "དེའི་འོག་ལོགས་སུ་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་རྡོ་རྗེ་དང་ས་བོན་ཡོངས་སུ་གྱུར་པའི་ཐུགས་རྡོ་རྗེ་ཕྱག་ན་རྡོ་རྗེ་ལྟ་བུ་ཐུགས་ཀར་ཟླ་བ་དང་རྡོ་རྗེ་དང་ས་བོན་གྱིས་བྱིན་གྱིས་བརླབས་པར་ིབསམས་ནས།",
    "འ་ཨོ་༧ སརྦ་ཏ་ཐཱ་ག་ཏ་ཙིཏྟ་བཛྲ་སྭ་བྷཱ་ཝ་ཨཱཏྨ་ཀོཉཧཾ་ཉཞེས་བྱ་བས་དེ་བརྟན་པར་བྱའོ།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཀཱ་ཡ་བཛྲ་སྭ་བྷཱ་ཝ་ཨཱཏྨ་ཀོཉཧཾ་ཞེས་བྱ་བས་བརྟན་པར་བྱའོ།",
    "ཨོ་༧ སརྦ་ཏ་ཐཱ་ག་ཏཱ་ཝཀ་བཛྲ་སྭ་བྷཱ་ཝ་ཨཱཏྨ་ཀོཉཧཾ་ཞེས་བྱ་བས་བརྟན་པར་བྱའོ།",
    "ཨ་ནུ་རཱ་ག་ཡ་མི་ཧཱུྃ་ཞེས་བརྗོད་ལ་དགའ་བ་བརྩམ་པར་བྱ་བ་དང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བླ་ན་མེད་པའི་བདེ་བ་དང་ཡིད་བདེ་བ་མངོན་སུམ་དུ་བྱས་ལ།",
    "ཞེས་བྱ་བས་ཀྱང་བྱིན་གྱིས་བརླབ་ཅིཔར་བྱའོ།",
    "ཐབས་དང་ཤེས་རབ་ལས་བྱུང་དཔེ་དང་རྣམ་པར་བྲལ།",
    "ཞེས་འཆད་པས་འཆད་པར་འགྱུར་རོ།",
    "དེ་ཉིད་ལས་ཛི་ན་ཛིཀ་ཅེས་བྱ་བ་འདིས་དེ་བཞིན་གཤེགས་པའི་རིགས་སྤྲོ་བ་དང་བསྡུ་བ་ལས་བྱུང་བའི་རྣམ་པར་སྣང་མཛད་སྟོན་ཀའི་ཟླ་བ་ལྟ་བུ་ཞལ་དཀར་པོ་དང་ནག་པོ་དང་དམར་པོ་ཅན་ཞི་བ་རང་སྣང་བའི་རིག་མ་ལ་འཁྱུད་པ་ཅན།",
    "ལྷག་མས་འཁོར་ལོ་དང་རལ་གྲི་དང་ནོར་བུ་དང་པདྨ་བསྣམས་པ་རྣམ་པར་བསམས་ལ་སྔ་མ་བཞིན་དུ་ཕྱུང་སྟེ་ཤར་ཕྱོགས་ཀྱི་ཟླ་བ་ལ་དགོད་པར་བྱའོ།",
    "དེ་ཉིད་ལས་རཏྭཱ་དྷཱིཀ་ཅེས་བྱ་བ་འདིས་རིག་པའི་རྒྱལ་པོའི་རིགས་སྤྲོ་བ་དང་བསྡུ་བ་ལས་བྱུང་བའི་རིན་ཆེན་འབྱུང་ལྡན་གསེར་བཙོ་མ་ལྟ་བུ་ཞལ་སེར་པོ་དང་ནག་པོ་དང་དཀར་པོ་ཅན་ནོར་བུ་དང་རལ་གྲི་དང་འཁོར་ལོ་དང་པདྨ་བསྣམས་པ་རྣམ་པར་བསམས་ལ་ལྷོ་ཕྱོགས་ཀྱི་ཉི་མ་ལ་དགོད་པར་བྱའོ།",
    "ས་ཨུཏྤ་ལ་དམར་པོ་དང་རལ་གྲི་དང་ནོར་བུ་དང་པདྨ་བསྣམས་པ་བདེན་བྲལ་གྱི་ཕྱོགས་ཀྱི་ཟླ་བ་ལ་དགོད་པར་བྱའོ།",
    "ཕྱག་ལྷག་མ་གསུམ་གྱིས་རལ་གྲི་དང་ནོར་བུ་དང་པདྨ་བསྣམས་པ་རིམ་པ་བཞིན་དུ་རྣམ་པར་བསྒོམས་ལ།",
    "རྩ་བའི་སྒོའི་ལོགས་གཉིས་ཀྱི་ཟླ་བའི་དཀྱིལ་འཁོར་དག་པ་ལ་དགོད་པར་བྱའོ།",
    "པདྨ་མཐར་བྱེད་ཀྱི་ཅིག་༧ཤོས་གསུམ་གྱིས་རལ་གྲི་དང་ནོར་བུ་དང་འཁོར་ལོ་བསྣམས་པར་བསམས་ནས་ཤར་ཕྱོགས་ལ་སོགས་པའི་སྒོའི་ཉི་མ་ལ་དགོད་པར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་ནི་མི་བསྐྱོད་པའོ།",
    "གཟུགས་རྡོ་རྗེ་ལ་སོགས་པ་ནི་དོན་ཡོད་པར་གྲུབ་པའོ།",
    "ཊ་གོང་བུའི་ཚུལ་དུ་བཅུག་སྟེ་ཞུ་བར་གྱུར་པ་པདྨའི་ནང་དུ་ཆུད་པར་བསམ་པར་བྱའོ།་",
    "ཞེས་བྱ་བས་ཀྱང་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "རྣམ་པར་སྣང་མཛད་དག་པ་ཆེ།",
    "རྣམ་པར་ཤེས་པའི་དེ་ཁོ་ན་ཉིད་ནི་མི་བསྐྱོད་པས་སོ།",
    "གཟུགས་ཀྱི་དེ་ཁོ་ན་ཉིད་ནི་ཡང་དག་པར་མཐོང་བའི་དགའ་བ་ནི་སྤྱན་གྱིས་སོ།",
    "རྣམ་པར་ཤེས་པའི་དེ་ཁོ་ན་ཉིད་ནི་མཱ་མ་ཀཱིས་སོ།",
    "གཟུགས་ཀྱི་དེ་ཁོ་ན་ཉིད་ནི་ཐོབ་པ་ལ་སྒྲིབ་པ་ཟད་པར་བྱེད་པ་ནི་གཤིན་རྗེ་མཐར་བྱེད་ཀྱིས་སོ།",
    "རྣམ་པར་ཤེས་པའི་དེ་ཁོ་ན་ཉིད་ནི་ཤེས་རབ་མཐར་བྱེད་ཀྱིས་སོ།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ལྟར་སྒྲུབ་པའི་རྣལ་འབྱོར་པ་དང་སྒྲུབ་པ་ཆེན་པོའི་རྣལ་འབྱོར་པ་བསྒོམས་པས་དུབ་པར་གྱུར་ན་ངལ་བསོས་ལ་བཟླས་བརྗོད་བྱའོ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་ནས་ཡི་གེ་བཞི་པོའི་སྔགས་རིམ་པ་འདིས་བཟླས་པར་བྱ་སྟེ།",
    "སྣ་ཚོགས་པའི་སྤྲིན་སྤྲོས་པ་གསུམ་དང་རོ་གཅིག་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ཡི་གེ་གསུམ་གྱིས་དཀྱིལ་འཁོར་ཉེ་བར་བསྡུ་བར་བྱས་ཏེ།",
    "ཁྱད་པར་ནི་འདི་ཡིན་ཏེ།",
    "རྗེས་སུ་མཐུན་པར་དངོས་གྲུབ་སྩོལ།",
    "སླར་ཡང་གཤེགས་པར་མཛད་དུ་གསོལ།་",
    "ཡུ་བ་ལེའུ་བཅོ་ལྔ་པ་ལས་གསུངས་པའི་རྨི་ལམ་གྱི་ཁྱད་པར་རྣམས་ཀྱིས་ཡང་དག་པར་ཤེས་པར་བྱའོ།་",
    "སེམས་ཙམ་དེ་ཡང་དོན་དམ་པར་སྣང་བ་ཙམ་གཉིས་མེད་པ་སྟེ།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་དག་རྗེས་སུ་དཔག་པར་བྱ།",
    "དེ་ཉིད་ལས་ནི་ངེས་པར་བཟུང་།",
    "གསུངས་པའམ་མ་གསུངས་༧པ་བཞིན་དུ།",
    "ཕྱུང་བ་དེ་ནི་བསྟིམ་པར་བྱ།",
    "དེ་ཡི་རིགས་དག་བསྟིམ་པར་བྱ།",
    "སྒྲུབ་པ་ཆེན་པོའི་རིམ་གྱིས་ལེའུ་ལྔ་པའི་བར་དུ་གསུངས་ལ།",
    "དེ་བཞིན་དུ་བཞི་པ་ིགཞན་དག་ཏུ་ཡང་གསུངས་སོ་། དེ་བས་ན་མཐར་ཆགས་སུ་བཀླག་པའི་རིམ་གྱིས་ལེའུ་རྣམས་ཇི་ལྟ་བ་བཞིན་གྱི་རིམ་པར་བཞག་པ་དེའི་དོན་གཅིག་ཉེ་བར་སྡུད་པ་ནི་རིམ་པ་བཞིན་ཡིན་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འོ་སྐྱེ་བོ་མེད་པའི་རིའི་ཕུག་པ་ལ་སོགས་པར་གནས་བཅས་ཏེ་ནང་པར་གྱི་དུས་སུ་བསམ་གཏན་གྱི་ཁང་པར་ཞུགས་ལ།",
    "པའི་འོད་ཟེར་གྱིས་སྤྱི་བོའི་ཁུ་བ་ཞུ་བར་བྱས་པའོ།",
    "བསྡུས་རྒྱུད་ལས་གླུས་བསྐུལ་བ་གསུངས་པ་དེ་བཞིན་དུ་རྩ་བའི་རྒྱུད་ལས་གླུས་བསྐུལ་བ་གསུངས་པ།",
    "དེས་ན་སྐུ་རྡོ་རྗེའི་རང་བཞིན་དུས་འཁོར་ཞུ་བ་ལས་བཞེངས་ལ་ཆུ་ཁམས་ཀྱི་རིགས་ཀྱི་ལྷ་སྤྲོ་བར་བདག་འདོད་པ་བཞིན་མཛོད་ཅིག།",
    "ད་ནི་རྡོ་རྗེ་ཅན་དེས་གླུ་དག་གསན་ནས་ཞེས་པ་ལ་སོགས་པས་ལྷའི་སྐུར་བཞེངས་པ་གསུངས་ཏེ།",
    "འདིར་ཁུ་བའི་ངོ་བོ་སྟོང་པ་ཉིད་ལ་རབ་ཏུ་ཞུགས་པའི་བཅོམ་ལྡན་འདས་ཡུམ་བཞིའི་གླུ་རྣམས་ཀྱིས་རབ་ཏུ་སད་པར་གྱུར་པ་ན།",
    "དེ་ཡང་སྟོང་པ་འགྱུར་མེད་རྒྱུ་འབྲས་ཡིན་པས་སྔར་གཙོ་བོ་མི་བསྐྱོད་པ་དང་འདིར་རྡོར་སེམས་སུ་བྱས་སོ།",
    "དེ་ནས་སླར་ཡང་པདྨ་ལས་སྔོན་བཞིན་དུ་ཞལ་དང་ཕྱག་དང་མཚན་མ་དང་དབྱིབས་ཀྱི་མཚན་ཉིད་ཅན་གྱི་ལྷ་སོ་སོར་གྱུར་པ་རྣམས་རྭ་མངས་འབྲོ་ལྟར།",
    "ཡེ་ཤེས་དང་ཐུགས་དང་གསུང་དང་སྐུའི་དཀྱིལ་འཁོར་རྣམས་སྤྲོས་ཏེ་ལྷ་སོ་སོ་ལ་ཞུགས་པར་བསམ་པར་བྱའོ།",
    "འདི་རྣམས་ཀྱིས་འབྲས་བུ་རྡོར་འཛིན་གྱི་མངལ་ནས་ལྷ་ཐམས་ཅད་སྤྲོས་ཏེ་ལྷ་སོ་སོ་ལ་བཞུགས་པར་བསྟན་ཏོ།",
    "བསྙེན་སྒྲུབ་གཉིས་ཡོད་པ་དེ་ལྟར་བསྐྱེད་པའི་རིམ་པ་ལ་རྣམ་པར་དག་པ་རྣམ་པ་གཉིས་ཏེ།",
    "འོད་ཆེན་རྣམ་པར་སྣང་བར་བྱེད་ཟླ་བའི་སྣང་བ་སྟེ།",
    "ད་ནི་འོད་ཟེར་སྔོན་པོ་ཞེས་པ་ལ་སོགས་པས་ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་དགུག་པ་གསུངས་ཏེ།",
    "སྒྲ་དྲག་པོ་སྒྲོག་པར་བྱེད་པ་ཉི་མའི་སྤྱན་ཏེ་སྤྱན་བཅུ་གཉིས་པ།",
    "ཤེས་རབ་ཡུམ་དང་ཐབས་ཡབ་སྙོམས་པར་འཇུག་པའི་སྦྱོར་བ་ལས་རབ་ཏུ་བྱུང་བ།",
    "རུས་པའི་ཕྱག་རྒྱ་ལྔས་ལས་ཚོགས་སུ་རུས་པའི་ཕྱག་རྒྱ་དང་ཞེས་པའོ་རྣམ་པར་བརྒྱན་པ།",
    "དེ་ཡང་མངལ་གྱི་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་ལས་མངས་འཇུག་པའི་རྣམ་པར་ཤེས་པ་བྱུང་སྟེ་ཡུལ་ལ་འཇུག་པའོ།",
    "རྣམ་པར་དག་པ་རྨུགས་བྱེད་ཀྱིས་བྱེད་དོ།",
    "དེ་ལྟར་ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་སྤྱན་དྲངས་པ་ལ་ཡང་དག་པར་མཆོད་དེ།",
    "དེ་བཞིན་དུ་ཤར་གྱི་པདྨའི་གདན་གྱི་ལྟེ་བར་ཉི་མ་ལ་གནས་པ་འདུ་བྱེད་དང་ས་གཉིས་པོའི་རིགས་ཅན་གྱི་ལྷ་དམ་ཚིག་སེམས་དཔའ་དག་དང་ཡེ་ཤེས་སེམས་དཔའ་ངེས་པར་ལྷན་ཅིག་རོ་མཉམ་པའོ།",
    "ད་ནི་ཁྲོ་བོའི་རྒྱལ་པོ་རྣམས་ཀྱི་རོ་མཉམ་པ་ཉིད་གསུངས་ཏེ།",
    "དེ་དག་ནི་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་ལ་རོ་མཉམ་པར་བྱེད་པའི་ཚུལ་ཏེ།",
    "གཞན་ནུབ་ཀྱི་སྒོའི་སྟེང་རྟ་བབས་ཀྱི་འོག་ཏུ་ཡང་ནི་གནོད་མཛེས་ཀྱི་མཚན་མ་དགོད་པར་འགྱུར་ཏེ།",
    "དེའི་ཐབས་གདོང་དྲུག་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བུའི་ལྷ་རྣམས་བཞུགས་པའི་ཚུལ་ནི་གཡོན་བརྐྱང་བའི་སྟབས་ནི་སྣ་ཚོགས་ཡུམ་གྱི་བཞུགས་ཚུལ་དུ་འགྱུར་ཏེ།",
    "ངེས་པར་ཡུམ་ཟླུམ་པོའི་སྟབས་ལ་གནས་པ་ལ་ཡང་ཡབ་ཟླུམ་པོའི་སྟབས་ཀྱིས་གནས་པའོ།",
    "རྐང་པ་ཟུང་ནི་གཞིབས་ནས་མཉམ་པར་སྦྱར་བ་དག་ཀྱང་མཉམ་པའི་སྟབས་སོ།",
    "བཞུགས་ཚུལ་ལྷག་མ་རྡོ་རྗེའི་གདན་དང་པདྨའི་གདན་དག་ནི་ཐམས་ཅད་ལ་གསལ་བར་རབ་ཏུ་གྲགས་པ་ཉིད་པས་འདིར་མ་གསུངས་ཀྱང་།",
    "དབྱུང་བ་བཞི་ལ་སོགས་པའི་གར་གྱི་ཚུར་རྣམས་བྷ་ར་ཏ་ལས་ཤེས་པར་བྱ་སྟེ།",
    "ཡེ་ཤེས་དང་རྣམ་པར་ཤེས་པའི་ཁམས་ཐབས་ཤེས་ཡིན་པས་ཕན་ཚུན་ཡང་དག་པར་སྦྱོར་བའི་ཕྱིར་རོ་ དེས་ན་ཡེ་ཤེས་ཀྱི་རིགས་ཀྱིས་རྣམ་པར་ཤེས་པའི་རིགས་དང་།",
    "རྣམ་པར་ཤེས་པའི་རིགས་ཀྱིས་ཡེ་ཤེས་ཀྱི་རིགས་ལ་རྒྱས་གདབ་པར་བྱ་སྟེ།",
    "རྒྱུད་འདིར་མི་བསྐྱོད་པ་ལ་རང་འདྲས་རྒྱས་གདབ་པར་མི་རིགས་ཏེ།",
    "གོང་དུ་སྐུའི་རྣམ་པས་ཐུགས་རྣམ་པ་གསུམ་དང་ཞེས་སྐུ་དང་ཐུགས་རྟེན་དང་བརྟེན་པར་གསུངས་པའི་ཕྱིར་རོ།",
    "གསལ་བར་པདྨ་འཛིན་པ་འོད་དཔག་ཏུ་མེད་པའི་རྒྱས་འདེབས་བྱེད་རྣམ་པར་སྣང་མཛད་ཉིད་དུ་འགྱུར་ཏེ།",
    "འདིར་རྒྱས་འདེབས་བྱེད་དེ་མ་ཐག་པར་བསྟན་པའི་ཚངས་པ་སྟེ་རྣམ་པར་སྣང་མཛད་དང་།",
    "གཡོན་གྱི་ལྷ་སྟེ་སྣང་བ་མཐའ་ཡས་དང་།",
    "ད་ནི་འཁོར་ལོ་ལ་སོགས་པའི་མཚན་མ་རྣམས་ཀྱི་རབ་ཏུ་སྐྱེ་བའི་ས་བོན་གསུངས་པ།",
    "འགྱུར་མེད་ཡེ་ཤེས་ལས་ཏེ་ཨོཾ་ཡིག་ལས་ཡེ་ཤེས་ཀྱི་གྲི་གུག་ཏུ་འགྱུར་ཞེས་བྱ་བ་ས་བོན་རྣམས་བསྐྱེད་པར་བྱ་བ་མཚན་མ་དང་འབྲེལ་བའོ།",
    "འདིར་མཚན་མ་སོ་སོའི་ས་བོན་གསུངས་པ་དེ་དག་ཀྱང་དེ་ལྟར་ཡིན་པར་ཅིས་ཤེས་ཤེ་ན།",
    "ཡ་ཎར་བསྒྱུར་པའི་དབྱངས་བཅོ་ལྔ་རྣམས་ལ་ཐུང་ངུ་དང་རིང་པོའི་རབ་ཏུ་དབྱེ་བ་རྣམས་ཀྱིས་ཕྱེ་བ་རིམ་པར་ཡོངས་སུ་བཀོད་པ་སྟེ།",
    "མཚན་མས་ལྷ་བསྐྱེད་པ་ནི་རྣལ་འབྱོར་པས་གོང་འོག་ཐམས་ཅད་དུ་རྟོགས་པར་བྱའོ།",
    "དེས་ན་ལྷ་གང་ལ་ས་བོན་གསུངས་པ་དེར་དེ་ལས་མཚན་མ་དང་།",
    "ལྷའི་མཚན་མ་གསུངས་པ་དེར་དེ་ལས་ས་བོན་དང་།",
    "ད་ནི་ནཱ་ད་ཞེས་པ་ལ་སོགས་པ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་ལྷ་རྣམས་ཀྱི་སྐྱེ་བའི་ས་བོན་གྱི་ཡི་གེ་གསུངས་ཏེ།",
    "དེ་ལྟར་འོག་ཐམས་ཅད་དུ་ཡང་ས་བོན་རྣམས་ཀྱིས་ལྷ་སོ་སོའི་མིང་དང་ས་བོན་སོ་སོའི་མིང་ཅན་གྱི་ལྷའི་འབྲེལ་བ་ཤེས་པར་བྱ་སྟེ།",
    "ཨི་ཡིག་ཐུང་ངུ་ནི་རལ་གྲི་ལྡན་པ་དོན་ཡོད་གྲུབ་པར་འགྱུར་བའོ།",
    "དེ་ལྟར་ན་གཉིས་ཀ་ཡེ་ཤེས་ཡིན་པས་རང་རིགས་ཀྱིས་འཁྱུད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་མི་བསྐྱོད་པ་དང་།",
    "ཨལ་ཡང་དེ་བཞིན་འདིར་ནི་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བར་འགྱུར་ཏེ་ལུས་ལ་གནས་པའོ།",
    "ངེས་པར་དེ་བཞིན་ཨཱཡིག་ལས་སྐྱེས་པ་ནི་སྒྲ་རྡོ་རྗེ་མའོ།",
    "ངེས་པར་དེ་བཞིན་ན་ཨཱལ་ཡིག་ལས་སྐྱེས་པ་ནི་དྲི་རྡོ་རྗེ་མའོ།",
    "ད་ནི་ཧཾ་ཞེས་པ་ལ་སོགས་པས་ཁྲོ་བོ་རྣམས་ཀྱི་རིགས་ལྔའི་ས་བོན་གསུངས་ཏེ་འདིར་ཧཱུྃ་ཡིག་ནི་གཙུག་ཏོར་འཁོར་ལོས་བསྒྱུར་བའི་ས་བོན་དུ་འགྱུར་ཏེ།",
    "ངེས་པར་དེ་བཞིན་རིང་པོ་ལས་སྐྱེས་དྲག་པོའི་མིག་མ་ཞེས་པ།",
    "དེ་བཞིན་དུ་ནུས་མའི་ས་བོན་རྣམས་གསུངས་ཏེ།",
    "ཐུང་ངུའི་དབྱངས་རྣམས་མདུན་དུའོ་ཞེས་པ་པདྨ་སོ་སོའི་མདུན་གྱི་འདབ་མ་བརྒྱད་པོ་རྣམས་ལ་ཧ་ཀླུ་ལ་རབ་ཏུ་གསལ་ཞིང་ངེས་པར་ཐུང་ངུའི་དབྱངས་ཀྱིས་ཕྱེ་བ་ཧི་ཧཱུཾ་ཧུ་ཧྥི་ཀཱ་ཀཱི་ཀཱུ་ཀླུ་ཞེས་པ་རྣམས་སྔ་མ་དེ་བཞིན་ཏེ།",
    "མཚམས་ཀྱི་པདྨ་རྣམས་ལ་ཀྱི་ལ་སོགས་པར་ངེས་པའོ་ཞེས་རྭས་ཏེ།",
    "བརྒྱ་བྱིན་ལ་སོགས་པ་རྣམས་ཀྱི་ས་བོན་གསུངས་ཏེ།",
    "དེ་ལ་འོས་པའི་ཤགས་ཐོབ་ལ།",
    "བཅོལ་བའི་ཕྲིན་ལས་འགྲུབ་པར་མཛོད།",
    "རྐང་པས་བསྣུན་པས་ཁ་ཟུམ་ཚོགས་ཕྱེ་གེ་སར་གསར་པར་གྱུར་པ་ཁྱེད་ལ་སྲུངས།",
    "བསམ་གཏན་ཟོལ་དག་ཉེ་བར་བཟུང་ནས་སྐད་ཅིག་མིག་ཕྱེ་སུ་ལ་སེམས་པར་བྱེད།",
    "དི་རིང་བདག་པོའི་དགའ་སྟོན་ལ་ཕྱོགས་སྣ་ཚོགས་ནས་འོངས་བ་དཔལ་ལྡན་དགའ་བའི་ལྷའི་ཞབས་ཀྱི་པདྨ་ཉེ་བར་བསྟེན་པའི་རྒྱལ་པོའི་ཚོགས་རྣམས་ཀྱིས་གུས་པ་དང་ལྡན་པར་བོས་ཏེ།",
    "སྔར་མེད་པའི་དངོས་པོའི་རྒྱན་རྣམ་པར་བཀོད་པ་རིག་པ་འཛིན་པའི་སྒེས་རབས་ལས་བརྩམས་པ།",
    "རྣམ་པར་བསམས་ནས་དེ་ལ་ད་ནི་ཅི་ཞིག་རིགས་པར་འགྱུར།",
    "བྱ་དང་བྱ་མིན་རྣམ་པར་དཔྱད་རྣམས་ལ།",
    "དེ་ལྟར་སྨད་པར་འོས་ཀྱང་དགའ་བྱེད་འགྱུར།",
    "བིདཱུ་ཥ་། ཀས་ཁྲོས་པ་དང་བཅས་པར།",
    "རིགས་པར་འོས་པའི་ལམ་ལ་བློན་པོ་རྣམས་སྦྱར་དམ་པ་རྣམས་ནི་བདེ་ལ་བཞག།",
    "དེ་བཞིན་གཉེན་གྱི་སྐྱེ་བོ་བདག་མཚུངས་ཉིད་བྱས་རྒྱལ་སྲིད་དག་ཀྱང་བསྲུང་བར་བྱས།",
    "ཀྱེ་གྲོགས་པོ་ཤིན་ཏུ་ཐུབ་ཆོད་ལྡན་ཞིང་ཉམས་པར་བྱེད་པའི་ལྷ།",
    "འདྲེན་པས་མ་ཏང་གས་རྒྱལ་སྲིད་ལེན་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོགས་པ་ཡོད་དམ་ཅི།",
    "ཡབ་ཀྱིས་རྗེས་སུ་བསྟན་པ་ཉིད་ལྷུར་བསྒྲུབ་པར་བྱའོ།",
    "རྔད་མང་བ་དག་རིང་དུ་བྱས་པར་གྱུར་གྱིས།",
    "དང་པོར་འགྲོགས་པར་འདོད་པའི་དགའ་མ་ལ་མགྲིན་པ་ནས་བཟུང་བ་བཞིན་དུ་གྲོགས་པོ་མཛའ་བོ་ལ་སྤུ་ལོང་རྒྱས་པར་བྱེད་པ་འདྲའོ།",
    "འཇོགས་ཏེ་མཚན་མ་གསལ་བར་བྱས་ནས།",
    "གྲོགས་པོ་ཡང་དག་པར་མཚོན་ནོ།",
    "རྟག་ཏུ་ཐོས་པས་ནེ་ཚོ་དག་ཀྱང་རིག་བྱེད་ཚིག་འདི་རབ་ཏུ་སྒྲོགས་པར་བྱེད།",
    "ཉེ་བར་མཚོན་པར་བྱའོ།",
    "ཨེ་མ་ཐུབ་པའི་སྐྱེ་བོ་རབ་ཏུ་དགའ་བ་རྣམས་ནི་རིག་བྱེད་ཀྱི་ཚིག་རྒྱས་པ་ལ་ཐེ་ཚོམ་རྣམ་པར་གཅོད་པར་བྱེད་ལ།",
    "དཀའ་ཐུབ་པའི་གཞོན་ནུ་མ་རྣམས་ནི་ལྗོན་པ་གསར་བའི་ཀྱོ་ར་འགེངས་པར་བྱེད་པའི་དཀའ་ཐུབ་ཀྱི་ནགས་ཚལ་ནི་རབ་ཏུ་ཞི་བ་དང་དགའ་བར་བྱེད་པ་ཉིད་དོ།",
    "བུང་བའི་སྒྲ་ཡིས་ལེགས་པར་འོངས་སམ་ཞེས་ནི་བརྗོད་པ་བཞིན།",
    "འདི་དག་མགོ་ནི་འབྲས་བུ་དུད་པས་འདུད་པར་བྱེད་པ་བཞིན།",
    "ཀྱེ་གྲོགས་པོ་འོན་ཀྱང་ངེས་པར་རི་དགས་འདི་དག་མགྲིན་པ་ཅུང་ཟད་ཀྱོགས་ཏེ་གཡོ་བ་མེད་པའི་ཁ་ལས་ཅུང་ཟད་ཟོས་པའི་རྩྭ་ཁམ་ནང་ན་གནས་བ་ཟག་ཅིང་རྣ་བ་གཅིག་རབ་ཏུ་བསླངས་ཏེ་གཏད་ནས་མིག་ཟུམ་པ་དང་བཅས་པས་ཉན་པར་བྱེད་པ་ལྟ་བུར་མཚོན་ནོ།",
    "སོ་ཡི་བར་ན་གནས་པ་རྩྭ་ཡི་ཁམ་ནི་གཅོད་པའི་སྒྲ་དག་བསྡམས་ནས་ཉན་པར་བྱེད།",
    "ཀྱེ་གྲོགས་པོ་དཀའ་ཐུབ་ཀྱི་ནགས་ཚལ་འདི་ན་སུ་ཞིག་གླུ་ལེན་པར་བྱེད།",
    "འདྲེན་པས་ལེགས་པར་བརྗོད་དེ།",
    "ངེས་པར་ལྷ་ནི་ཕྱག་བྱ་བར་འོས་པའོ།",
    "དེ་ལྟར་བྱས་ཏེ།",
    "ཀྱེ་གྲོགས་པོ་འདི་ནི་ངེས་པར་གཞོན་ནུ་མ་སྟེ་ཅིའི་ཕྱིར་མི་ལྟ།",
    "ཡ་མཚན་དང་བཅས་པར་ཀྱེ་གྲོགས་པོ་ལྟོས་ཤིག་ལྟོས་ཤིག།",
    "རྒྱུད་མངས་ཀྱི་སྒྲས་རྣ་བའི་བདེ་བ་སྐྱེད་པར་བྱེད་པ་འབའ་ཞིག་ཏུ་མ་ཟད་དེ།",
    "གལ་ཏེ་གྲུབ་རིགས་ལས་སྐྱེས་དེ་ཕྱིར་གྲུབ་པ་འཇིག་རྟེན་གསུམ་དུ་གྲགས་པར་འགྱུར།",
    "མཛའ་བ་དང་བཅས་པར་ཀྱེ་བྲམ་ཟེ་བདག་སྨྲའོ།",
    "དེའི་ཕྱིར་ཡུན་རིང་པོ་མ་ཡིན་པ་ན་རིག་པ་འཛིན་པའི་འཁོར་ལོས་སྒྱུར་བས་ལག་པ་འཛིན་པར་འགྱུར་རོ་ཞེས་སོ།",
    "འདྲེན་མས་འཇིགས་པ་དང་བཅས་པར་འདྲེན་པ་ལ་མཚོན་ཏེ།",
