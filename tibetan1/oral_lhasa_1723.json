    "ཞེས་གསུངས་པ་ལྟར་རོ།་",
    "ཤེས་རབ་ལོག་པར་འཁྲིད་པོའི་གཞུང་ལུགས་ཀུན།",
    "བསྐྱེད་རྫོགས་སྤྱིའི་རྣམ་པར་གཞག་པ་རིམ་གཉིས་གསལ་བྱེད་ཅེས་བྱ་བ་སོགས་གྲངས་ཀྱིས་བགྲང་བར་མི་ནུས་པ་དག་མཛད་དོ།",
    "ཆུ་མིག་མང་པོས་རྣམ་པར་བརྒྱན་པ།",
    "དུང་དཀར་པོ་གཡས་སུ་འཁྱིལ་བའི་རྣམ་པ་ཅན་ཞིག་ཡོད་པ་དེར་རྗེ་ཉིད་ཀྱིས་ཕྱག་འཁར་གྱིས་བཙུགས་ནས་བཀྲ་ཤིས་པར་གྱུར་ཅིག་ཅེས་གསུང་བཞིན་དུ་གཙུག་ལག་ཁང་དང་།",
    "རྣམ་པར་གཞག་པ་ཀུན་གསང་ཕུ་ནེའུ་ཐོག་ན་ཇི་ལྟར་ཡོད་པ་བཞིན་ཕྱག་ལེན་དུ་བཞེས་ཏེ།",
    "ལོ་བཅུ་བཞིའི་བར་དུ་ཞབས་བརྟན་པར་གདན་ཆགས།",
    "ཡུལ་ཕྱོགས་ཀྱི་མི་ཆེ་རྒུ་ཀུན་གྱིས་འབུལ་བ་དང་ཞེ་ས་བྱས།",
    "རྗེ་ཉིད་དགུང་ལོ་བརྒྱད་ཅུ་གྱ་གསུམ་མ་བཞེས་ཀྱི་བར་དུ།",
    "ཁོ་བོ་ལོ་བརྒྱད་ཅུ་གྱ་གསུམ་ལོན་ལོན་གྱི་བར་དུ་འཆད་ཉན་ཁོ་ན་བྱས་པ་ཡིན་ཞེས་གསུངས་སོ།",
    "དེ་ནས་ཚེས་བཅུ་བཞིའི་ཐོ་རངས་ཀྱི་དུས་སུ་སྔར་ལུགས་བཞིན་སྐུ་སྟོད་རྗེན་པར་བཏོན་ནས་ཐུགས་དམ་མཛད་པའི་ངང་དེ་ཉིད་དུ་དགའ་ལྡན་གྱི་གནས་སུ་བདེ་བར་གཤེགས་སོ།",
    "བཅིངས་འགྲོལ་བྱས་པའི་ཚུན་དང་།",
    "ཁྱད་པར་དུ་ཀྲུང་གུང་སྐབས་བཅུ་གཅིག་པའི་ཚང་འཛོམས་གྲོས་ཚོགས་ཐེངས་གསུམ་པ་འཚོགས་པའི་རྗེས་སུ།",
    "མི་རིགས་ཕན་ཚུན་བར་གྱི་འབྲེལ་གཏུག་འགྲོ་འོང་ཡང་དེ་ལྟ་དེ་ལྟར་ཆུ་བོའི་རྒྱུན་གྱི་རྗེས་སུ་སྙེག་པར་བྱེད་ཅིང་།",
    "དེ་དག་ཀྱང་མང་ཆེ་བ་ས་ཆུ་མ་འཕྲོད་པས་རྐྱེན་བྱས་ཏེ་ན་ཚ་བྱུང་བས་འདས་པར་གྱུར།",
    "བོད་རྒྱལ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་དུས་སྐབས་ནི་བོད་རྒྱལ་རབས་ཧ་ཅང་དར་རྒྱས་ཕུན་སུམ་ཚོགས་པར་ཕྱིན་པའི་དུས་སྐབས་ཡིན་ལ།",
    "ཕལ་ཆེར་སོ་ན་གནས་པའི་རྣམ་པར་མངོན་ཏེ།",
    "ལྷ་སར་བསྐྲུན་པའི་གློག་འདོན་ས་ཚིགས་ཆུང་ངུ་ཞིག་ཡོད་པ་དེ་ཡང་སྣུམ་རིགས་མེད་པར་མེ་རུ་འབར་བ་དང་།",
    "ལྷ་སའི་སྲང་ལམ་ཐོག་ཏུ་ལྕགས་རྟ་བ་ཞིག་བྱུང་ནའང་བགྲོད་བྱེད་མེད་ཀྱང་འཕུར་བཞིན་བསྐྱོད་པའི་ལྟས་ངན་ཞིག་ཏུ་བསྒོམས་ཤིང་།",
    "ཞེས་གསུངས།",
    "མི་རིགས་གཉིས་ཀྱིས་ཕན་ཚུན་འབྲེལ་གཏུག་བྱས་ན།",
    "ཕན་ཚུན་བརྡ་སྤྲོད་པར་བྱེད་པའི་ནུས་པ་འབྱིན་པ་པོ་འདི་ལྟ་བུ་ལ་སྐད་གཉིས་སྨྲ་བའི་ལོ་ཙཱ་བ་ཞེས་བྱ་ཞིང་།",
    "དོན་འདི་ལྟ་བུ་སྒྲུབ་ཐུབ་པའི་མི་མང་པོ་མེད་པས་དེ་རྣམས་ཀྱི་མིང་ལ་སྐད་གཉིས་སྨྲ་བ་པོ་ཙམ་གྱིས་མི་ཆོག་པར་སྐད་གཉིས་སྨྲ་བའི་ལོ་ཙཱ་བ་ཞེས་ཐ་སྙད་གདགས་དགོས་པ་བྱུང་།",
    "དེའི་འབྲས་བུར་རང་ཤུགས་ཀྱིས་གནས་དེ་རུ་སྡོད་པའི་སྐྱེ་བོ་ཀུན་མི་རིགས་གང་ཡིན་ལ་མ་དམིགས་པར་སྐད་གཉིས་སམ་དུ་མ་ལོབས་པ་ཡིན།",
    "ཁྱད་པར་མངོན་གསལ་ལྡན་པ་འདི་རྟོགས་རིགས་སོ།",
    "མཉམ་དུ་དར་རྒྱས་དང་སྔོན་ཐོན་དུ་འགྲོ་ཐུབ་པར་བྱས་ནས།",
    "རྒྱུས་ལོན་བྱས་པ་གཞིར་བཟུང་ན།",
    "དར་རྒྱས་སུ་འགྲོ་བ་བཅས་ལ་ཕན་གདགས་པར་མ་ཟད།",
    "མི་རིགས་གཞན་གྱི་སྔོན་ཐོན་ཡིན་ལ་ཕན་པར་འགྱུར་བའི་ཤེས་བྱ་དག་བསླབ་དགོས་ཤིང་།",
    "མི་རིགས་གཞན་གྱི་སྔོན་ཐོན་ཡིན་ལ་ཕན་པར་འགྱུར་བའི་ཤེས་བྱ་དག་བསླབ་དགོས་ན།",
    "རྫས་འགྱུར་རིག་པ་བཅས་ཀྱི་སློབ་ཚན་རིམ་པར་འཁྲིད་དགོས།",
    "དེར་མ་ཟད་སློབ་ཡུན་ཡང་ཇེ་རིང་ལ་གཏོང་ཆོག་པར་སེམས།",
    "དེ་དབུས་བཀོད་པས་ཁྱད་པར་འཕགས་པ་ཡི།",
    "འཆི་མེད་བདག་པོའི་ཁང་བཟང་སྐྱེངས་པར་བྱེད།",
    "དེབ་པར་འཁོད།",
    "ལ་ལས་བཟོ་རིག་པའི་ཁོངས་སུ་གཏོགས་པར་འདོད་པ་དང་།",
    "ལ་ལས་རྩོམ་རིག་སྒྱུ་རྩལ་གྱི་ཁོངས་སུ་གཏོགས་པར་འདོད་པའང་སྣང་ངོ།",
    "རྒྱན་སྣ་ཚོགས་པས་ཕྱུག་པའི་ཚིག་རྒྱན་གྱི་རྣམ་པ་ཞིག་ཏུ་གྱུར་ཏེ་བོད་རིགས་ཀྱི་ཡུལ་གྲུ་ཀུན་ཏུ་ཁྱབ་པར་གྱུར།",
    "རྗོད་བྱེད་ཀྱི་ཚིག་ཕུན་སུམ་ཚོགས་པའི་རྒྱན་སྣ་ཚོགས་ཀྱིས་བརྒྱན་པ་ཤ་སྟག་ཡིན་པར་འདོད་དོ།",
    "ཞལ་ལུ་དཀར་པོས་ཇོ་རུ་གདན་འདྲེན་པར།་",
    "མཛེས་རྒྱན་གྱི་ནང་གསེས་ཤར་ཕྱོགས་པའི་བཞེད་པ་མཚུངས་པར་གྱུར་པ་ནི།",
    "རི་ཆུང་འགོ་ནས་བསང་ཆེན་ཕུད་འདྲ་ཞིག་བྱས་ཤིང་།",
    "བྱ་ངང་པས་པད་མཚོར་གཤགས་འདྲ།",
    "རྩི་བཅུད་མར་གྱིས་མགོ་གནོན་བྱས།",
    "གཙང་རྒྱས་ཆབ་ཀྱིས་རྟ་ལ་བསྐྱོན།",
    "གཞུ་མཆོག་དཀར་རྒྱང་ཤིང་ཡོང་ངེས་ཡིན།",
    "ཞེས་པ་ལྟ་བུས་ཁྱད་གཞི་པད་མ་འབྱུང་གནས་གཙོ་བོར་སྟོན་པ་མིན་པར་ཁྱད་གཞི་དང་འབྲེལ་བའི་རྫས་ཀྱི་དངོས་པོ་ཟབ་བེར་དང་གཉེན་ཞུ་ལ་སོགས་པའི་དངོས་པོ་ཙམ་སྟོན་པ་ལྟ་བུའོ།",
    "ཡིད་བརྟན་བྱས་ཚེ་མཐའ་ལ་འཕེན།",
    "ཆང་འདི་བཞེས་དང་དབུ་འཕང་མཐོ།",
    "ཞེས་པར་ཡང་ཡང་བསྐོར་བ་ལྟ་བུའོ།",
    "ང་རྒྱལ་པོ་གསུམ་གྱིས་ཧབ་ཐོབ་བྱས།",
    "དེ་ལས་གཞན་པའི་རྒྱུ་གང་ཡང་མེད་པར་ཁུ་བྱུག་འབྱོར་བ་དང་།",
    "མེ་ཏོག་བཀྲ་བ་སོགས་རང་བཞིན་གྱིས་འབྲས་བུ་དེ་འདྲ་དག་གྲུབ་པར་སྟོན་པ་ལྟ་བུའོ།",
    "བརྗོད་པར་འདོད་པའི་དཔེ་ཅན་ཧོར་གྱི་ཤན་པས་སེང་ཆེན་རྒྱལ་པོའི་ཕུ་བོ་ཞལ་དཀར་བསད་པ་དེ་ལ་བསམས་ནས།",
