    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག།",
    "རང་ཉིད་མེ་ལས་ས་ཡང་རང་ཉིད་དེ།",
    "རང་ཉིད་ཁྱབ་འཇུག་ཉི་མ་ཟླ་བའང་རང་།",
    "དེ་རྣམས་ཀྱི་ཤ་ཟ་བར་བྱ་ཞིང་རང་བཞིན་མེད་པར་བྱ་སྟེ།",
    "བདེ་བ་ཅན་ན་འདུག་པ་རྣམས།",
    "གཡས་བརྐྱང་བ་ཡི་འདུག་སྟངས་གནས།",
    "ཕྱི་ནས་ཡེ་ཤེས་མེ་ལྕེས་སྲིད་པ་གསུམ་པོ་མཐའ་དག་དུས་གཅིག་ཏུ་ནི་དགུག་པར་བྱ།",
    "འདི་ནི་ཉེ་བར་འདུག་པའི་ཀ་ར་ཎ་ཡིན་ལ།",
    "འཕགས་པའི་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་འཕགས་པ་མ་ཡིན་པ་རྣམས་ཀྱང་རང་བཞིན་གྱིས་དྲི་མ་མེད་པ་འདིས་རྟག་ཏུ་གནས་པའི་ནམ་མཁའ་ལྟར་རྟག་ཏུ་འདུས་མ་བྱས་པའི་རང་བཞིན་ནོ།",
    "ཇི་ལྟར་ཆུའི་ཁམས་དང་གསེར་དང་ནམ་མཁའ་རྣམ་པར་དག་པ་ལྟར་འདི་དག་ཀྱང་ཀུན་དུ་རྟོག་པས་གཞག་པའི་རྣམ་པ་ཙམ་ལོག་ཅིང་རང་བཞིན་གྱིས་རྣམ་པར་དག་ཅིང་རང་རིག་པའི་བདེ་བ་ཆེན་པོ་རྟོག་པའི་དྲི་མ་ཐམས་ཅད་དང་བྲལ་བའི་བདག་ཉིད་དོ།",
    "གལ་ཏེ་སྦལ་བ་མེད་པ་རྣམས་ལ་གླེགས་བམ་དང་བྲིས་སྐུ་རྣམས་བསྟན་ན་མཆོག་ཏུ་ཟབ་ཅིང་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་སྤྱོད་ཡུལ་མ་ཡིན་ལ།",
    "གང་རང་བཞིན་ཡོད་པ་ལ་ནི་ལྟོས་པ་མེད་དོ།",
    "ཞེས་བྱ་བ་ནི་རྫོགས་པ་དང་རང་བཞིན་གྱིས་གྲུབ་པར་གནས་པའོ།",
    "འདུག་པ་སྟེ།",
    "བལྟ་བ་པོ་སྐྱེས་བུ་གཉི་ག་ཡང་རང་བཞིན་གྱིས་མེད་དེ།",
    "ཆུའི་སྟེང་དུ་འདུག་པ་དང་།",
    "བདེ་བ་ཅན་དུ་ང་ནི་འདུག།",
    "དེ་ཡང་རང་བཞིན་ཉིད་ཀྱིས་ཤིན་ཏུ་རྣམ་པར་དག་པའོ།",
    "འོན་ཀྱང་རང་ཉིད་གང་ཅིར་བློ་དམན་སྟབས།",
    "བྱམས་བརྩེའི་རླབས་ཕྲེང་མཁའ་ལ་འཕྱུར་ཡང་རང་ཉིད་གཅེས་འཛིན་འོབས་ལ་འདྲེན།",
    "ཡར་ཆབ་གཙང་པོའི་རྒྱུན་བཞིན་མི་ཉམས་པར་གནས་འདུག།",
    "གནས་འདིར་བྱོན་ཞིང་བསྔགས་པའི་མེ་ཏོག་ཡང་འཐོར་འདུག།",
    "ཚོང་པ་ཁེ་སྤོགས་ཐོབ་པས་འགྲན་ཟླ་རང་མིན་འདུག།",
    "ཡབ་སྲས་ཉི་ཟླའི་འཕྲིན་ལས་འོད་ཟེར་གྱིས་ཁྱབ་འདུག།",
    "སྔོན་ནས་འདི་ལྟར་གཏོང་བའི་སྲོལ་རྒྱུན་འདུག་ཞེས་པའི།",
    "རང་རང་གང་འདོད་ཇི་བཞིན་བསྐོང་བ་ཡི།",
    "རྟེན་གསུམ་སྤྱི་དང་རང་བྱོན་སྣ་ཚོགས་བཞུགས།",
    "སྲིད་ཞིའི་ཕུན་ཚོགས་བཅས་པ་གཙུག་རྒྱན་བཞིན་བཞུགས་འདུག།",
    "དྲིན་མ་ཡི་བཀའ་དྲིན་བསམས་ཙ་ན།",
    "མ་དྲིན་ཅན་ཞལ་མཇལ་བྱུང་ཙ་ན།",
    "ག་དུས་སླེབས་མིན་ད་དུང་ཆ་མི་རྟོགས།",
    "ལྟོ་བ་རྒྱགས་ན་སོས་དལ་གུ་ཡངས་འདུག།",
    "སླར་ཡང་རང་གནས་ལོག་པའི་གྲབས་བྱས་ཚེ།",
    "སྡུག་དུས་གང་ནུས་གང་ལྕོག་བྱེད་པའི་སེམས་བཟང་ཅན་གྱི་མི་རྣམས་དང་།",
    "བརྩེ་བའི་དྲི་བསུང་མཐུལ་བས་ལོས་ཡིན།"
  ]
