    "ལས་སྦྱོར་བརྟན་པར་བྱ་བ་དངོས་ཀྱི་དམིགས་པ་བཅས་ལས་སྔགས་ལ་གྲངས་བཟུང་སྟེ་རྟགས་མ་མཐོང་བར་བརྩོན་པ་བསྐྱེད་པར་བྱའོ།",
    "གནོད་པ་མེད་པར་ལས་གཞན་གྱི་འབྲས་བུའང་འདིའི་ཞར་ལ་འགྲུབ་ནུས་པའི་ཕྱིར་རོ།",
    "འདིར་རིགས་བྱེད་མ་ལ་བརྟེན་པའི་ཚེ་སྒྲུབ་ནི་ཤིན་ཏུ་ཟབ་པར་ཡོངས་སུ་གྲགས་ཤིང་།",
    "དེའི་ཚབ་ཏུ་ལྕགས་ཀྱུ་ཅན་གྱི་མེ་ཏོག་གང་རུང་ལས་འོས་མེད་གསུངས།",
    "དངུལ་ཆུ་དང་མུ་ཟི་འདྲེས་པར་སྦྱར།",
    "དེའི་ཕྱི་ནས་ཟངས་ཀྱི་སྒྲོམ་བྱས་པའོ།",
    "ཁྱད་པར་གྱི་རྫས་ཙནྡན་དམར་པོ།",
    "ཏོང་ཀུ་འདི་རྣམས་ཕྱེ་མར་བྱས་ཏེ་ཆང་ལ་པདྨ་རཀྟ་བཏབ་པས་སྦོལ།",
    "སྲིད་འདིར་ཡང་ནས་ཡང་དུ་རྩེན་པར་འདོད།",
    "མངྒ་ལཾ། ། དཔལ་ཚེ་བདག་ཕྱག་རྒྱ་ཟིལ་གནོན་གྱི་བསྙེན་ཡིག་སྲིད་གསུམ་དགྲ་ལས་རྣམ་པར་རྒྱལ་བ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "དེ་ཡང་བསྙེན་སོགས་སོ་སོའི་དུས་ཀྱི་ཡོ་བྱད་རྣམས་མ་ཚང་བ་མེད་པར་འདུ་༤བྱས་ནས་མཚན་ཉིད་ཚང་པའི་གྲོགས་དང་བཅས་པའམ་རང་གཅིག་པུས་ཀྱང་རུང་སྟེ་ཆོ་གའི་ཡན་ལག་ཚང་ལ་མ་ནོར་བ་དང་ལྡན་པའི་སྒོ་ནས་གསང་སྔགས་ཚུལ་བཞིན་བཟླ་ཞིང་།",
    "ཐུན་དང་ཆོ་གའི་སྔོན་དུ་འགྲོ་བ་རྣམས་འདོན་དམིགས་སྦྲགས་ཏེ་བློ་རྒྱུད་ལ་ལེགས་པར་འཁོལ་ངེས་བྱ།",
    "ཁྱད་པར་རིགས་ཀྱི་ཁྱབ་བདག་ཨ་ར་པ་ཙ་ལྟ་བུའི་སྒྲུབ་ཐབས་ཀྱི་གཞུང་བཞིན་མཚན་མ་དུས་གྲངས་ཀྱི་བསྙེན་པ་མཐར་འདོན་པར་བྱའོ།",
    "དམར་གཏོར་བྱིན་གྱིས་བརླབས་ནས་ནག་ཕྱོགས་སྤྱི་དང་ཁྱད་པར་ལན་ཆགས་ཀྱི་བདག་པོ་དང་བར་ཆད་རྩོམ་པའི་རིགས་ལ་བསྔོས་ཏེ་གཞན་དུ་བསྐྲད་ཅིང་སྲུང་བའི་འཁོར་ལོ་བསྒོམ།",
    "མཆོད་བསྟོད་གཏོར་མ་ཕུལ་ལ་བརྟན་པར་བཞུགས་སུ་གསོལ་ནས་བར་ཆད་ཀྱི་མཚམས་བཅད་པའི་ཕྲིན་ལས་བཅོལ།",
    "ས་བརྟག་བསླང་སྦྱང་བརླབ་བསྲུང་བ་ལྔ་ཚུལ་བཞིན་བྱས་ན་ལེགས་ཤིང་།",
    "ལྷ་འདི་ཉིད་སྣང་སྲིད་ཟིལ་གནོན་གྱི་བདག་པོ་ཡིན་པས་ས་ཆོག་མི་དགོས་པར་ཇི་ལྟར་སྤྱད་རུང་བར་ཡང་རྒྱུད་ལས་གསུངས།",
    "གནས་ཁང་བྱི་དོར་དང་སྐྱང་ནུལ་བྱས་པར་གནམ་ས་བར་གྱི་རྒྱན་སྐུ་གསུང་ཐུགས་རྟེན་སོགས་དགྲམ་པར་འོས་པ་ཀུན་བཀོད་པར་བྱས་ནས།",
    "རྡུལ་ཚོན་རྒྱས་པར་སྤྲོ་ན་ས་ཡི་སྟེགས་བུའམ།",
    "དངོས་གྲུབ་ཀྱི་རྫས་སོགས་གསར་དུ་བཤམ་དགོས་པའི་རིགས་གནས་སྐབས་སོ་སོའི་ཐད་དུ་ཤེས་པར་བྱ་ཞིང་།",
    "འཐོར་ནས་རྔེའུ་ཆུང་སོགས་དགོས་པའི་ཡོ་བྱད་ཐམས་ཅད་ཚོགས་པར་བྱས་ནས།",
    "གནས་རྟེན་རྣམས་ཤུག་པ་སོགས་ཀྱི་དུད་པས་བསང་བར་བྱས་ནས།",
    "ཞེས་བཏགས་པ་བདུན་ནམ་གསུམ་བརྗོད་རྗེས་མཆོད་བསྟོད་བྱས་ལ།",
    "སྐུ་ལ་ཁྲོ་བཅུ་རྫོགས་པར་བསྒོམ།",
    "མི་དམིགས་པར་ཅུང་ཟད་བཞག་སླར་ཡང་ལྷར་ལམ་གྱིས་གསལ།",
    "ཉི་མ་ནུབ་པར་ཉེ་བ་ན་ཐུན་བསྡུས།",
    "དབྱངས་གསལ་སྤེལ་ཚིག་ཅན་བདུན་བརྗོད་པ་སྲོད་ཐུན་གྱི་ཁྱད་པར་རོ།",
    "ཨྱེ་རིང་རྣམས་གོ་རིམ་བཞིན་བསྙེན་ཚད་ལྟར་བྱ་དགོས་པ་མ་གཏོགས་ཐུན་གྱི་བྱ་བ་ཆོ་ག་གཏོང་ལུགས་སོགས་ལ་ནི་ཁྱད་པར་ཅི་ཡང་མེད་དོ།",
    "དེ་ལ་དང་པོ་ཨཱ་ཀྲོ་སྤྱི་བསྙེན་བྱས་པ་གོང་ནོན་དུ་འགྱུར་བ་ཡིན།",
    "བཞི་པར་སྒྲུབ་ཆེན།",
    "ལྔ་པར་ལས་བཞིའི་དམིགས་པ་སྦྱར་ནས་བཟླ་བའི་ཕྱག་ལེན་མཛད་པ་བཞིན་བྱ་གང་ལྟར་ཀྱང་བཟླས་པའི་སྐབས་སུ།",
    "ཞབས་ཕྱེད་སྐྱིལ་དུ་བཞུགས་པར་བསྒོམ།",
    "དེ་ཡང་སྐབས་འདིར་གཙོ་བོར་ཡེ་ཤེས་སེམས་དཔའ་ལ་དམིགས་པ་གཏོད་པར་བྱ་སྟེ།",
    "ལྷར་གྱུར་མཐུ་དཔལ་གཟི་མདངས་ཐམས་ཅད་འོད་ཀྱི་རྣམ་པར་ཚུར་འདུས་བདག་ལ་ཐིམ་བདག་ཉིད་ཡེ་ཤེས་ཀྱི་སྐུ་གཟི་བརྗིད་དང་ལྡན་པར་བསམ།",
    "འཁོར་འདས་ལམ་གསུམ་གྱིས་བསྡུས་པའི་དཔལ་ཡོན་ཐམས་ཅད་འོད་ལྔ་ཐིག་ལེ་བཀྲ་ཤིས་རྫས་རྟགས་ལ་སོགས་པའི་རྣམ་པར་བསྡུས་པས།",
    "རང་ལུས་དང་གནས་ཁང་མེར་གྱིས་ཁེངས་ཞིང་ཡོན་ཏན་རྒྱས་ནས་རྒྱས་པའི་ལས་ལྷུན་གྱིས་གྲུབ་པར་བསམ།",
    "འབུམ་ཕྲག་གསུམ་ཁ་སྐོང་ཁྲི་གསུམ་བསྙེན་ཚད་དུ་གསུངས་ཀྱང་།",
    "འཇམ་དཔལ་གཞོན་ནུ་ཡིན་པར་བཤད།",
    "ཞེས་གསུངས་ཀྱང་དེང་སང་ལག་ལེན་ལ་འབུམ་ཕྲག་གསུམ་བཟླ་བར་མཛད་དོ། གཉིས་པ་ཨྱེ་རིང་དྲག་པོར་བཟླ་བ་ལ།",
    "བདག་མདུན་ཟིལ་གནོན་རྩ་བའི་ལྷ་དྲུག་རྒྱན་ལྷ་བརྒྱད་དང་བཅས་པར་གསལ་བའི་གཙོ་བོའི་ཐུགས་ཙིཏྟའི་ནང་དུ་ཉི་གདན་ལ་ཧཱུྃ་མཐིང་ག་ཡ་མའི་ཐུགས་ཀར་ཡ་སྨུག་ནག་ཕྱག་རྡོར་གྱི་ཐུགས་ཀར་ཧཱུྃ་སྔོན་པོ།",
    "ཁཾ་ཤག་རོ་མྱགས་མུགས་ཏི་རྦད་ཡ་ཞེས་བཏགས་པས་བསྐོར་བར་བསྒོམ།",
    "རྒྱས་པར་མཆོད་རྟེན་བཅས་ཆོག་དེ་ཙམ་མ་འགྲུབ་ན་ཐོད་པ་ཞལ་དབྱེ་མཆོག་ཕག་ལིང་ག་ཙམ་ལ་བརྟེན་པ་སོགས་རྣམ་གྲངས་མང་ཡང་།",
    "རྒྱུན་སྔགས་འཁོར་ལོ་ནག་པོའི་དྲག་སྔགས་དྲག་པོ་བཙན་ཐབས་འདིས་བརྡེག་པར་བྱ་སྟེ་དྲག་སྔགས་ནི།",
    "ཨེ་མྱགས་ཡ་རྔུབས་མུགས་ཤག་ཀ་དུན།",
    "དགུག་གཞུག་ནས་ཞལ་སྟོབ་བར་དཀྱུས་བཞིན་བྱས་རྗེས།",
    "ཡང་ན་མནན་ཆས་བྱས་ཏེ་ཐོད་པ་སོགས་སུ་མནན་པ་ཚུལ་བཞིན་བྱ།",
    "གཞན་ཡང་དངོས་གྲུབ་ཀྱི་རྫས་གང་འབྱོར་འདུ་བྱས་ལ།",
