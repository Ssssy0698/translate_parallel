    "གུས་པའི་མགྲིན་པ་རིང་པོར་བརྐྱངས་ཏེ་སོང་།",
    "ཁྱོད་བློའི་གཤོག་རླབས་ངོམ་པའི་དཔལ་སྟེར་བར།",
    "མཐོང་བའི་དགེ་ལེགས་སྣང་བས་བདག་གི་ཡིད།",
    "ཡོངས་འཛིན་གསུང་གིས་སྤེལ་བ་ཡི།",
    "མདུན་དུ་ཐལ་མོ་སྦྱར་བ་ཡི།",
    "ངན་སོང་སྒོ་ལ་སྒོ་གཏན་དང་།",
    "བ་དན་འདི་ནི་ཁྱོད་ཀྱིས་གཟུང་བའི་རིགས།",
    "སོངས་ཤིག་བུ་ཁྱོད་འདི་ནས་དྲུག་ཅུ་ཡི།",
    "ཕྱི་མིག་ལྟ་བཞིན་ལྷོ་ཕྱོགས་སོང་།",
    "འདུན་མ་གང་བྱུང་གིས་ཆོག་པའི།",
    "ཉེ་འབྲེལ་མ་འཁྱོངས་ཀྱི་དོགས་པ།",
    "ནོར་རྫས་བསོག་སྲུང་གི་སེམས་ཁྲལ།",
    "རང་ཕུང་གཞན་ཕུང་གི་བྱ་བས།",
    "གང་ཤར་ཚོགས་དྲུག་གི་སྣང་བ།",
    "འཁྲུལ་བ་ཨ་འཐས་སུ་སོང་བས།",
    "ཀྱེ་ཧོ་ཚེ་ཕྱེད་དེ་ཐལ་ལོ།",
    "གནོད་པའི་སྡིག་ལྟུང་གིས་རང་རྒྱུད་གང་ནས་འདུག།",
    "ད་ནི་ཅི་རང་དྲགས་བསམ་ཞིང་ཡི་རེ་མུག།",
    "བཟོད་མེད་ངན་སོང་གི་སྡུག་བསྔལ་དྲག་པོ་དང་།",
    "ཞེ་བློ་བདེ་མོ་རང་འདུག་པ་ཕོད་འདི་མཚར།",
    "རང་གི་ལུས་སེམས་ཀྱི་སྟེང་དུ་བབས་པའི་ཚེ།",
    "བློ་སེམས་བདེ་མོ་ཞིག་ཡོང་བ་མི་འདུག་ཀྱང་།",
    "ཉིན་གཅིག་བྲང་ལག་གཉིས་འཐབ་མོ་འཆོར་དོགས་ཡོད།",
    "མི་རང་མགོ་རང་གིས་འདོན་པ་གཅེས།",
    "དོན་ཆུང་ངུ་རེ་ལ་འཐབ་རྩོད་བྱེད།",
    "བུས་རང་གི་ཕ་ཡང་གསོད་མཐོང་ན།",
    "གཉེན་ཉེ་དུ་ཕན་པར་རེ་བ་འཁྲུལ།",
    "རྐྱེན་ཕྲན་བུ་ཙམ་རེའི་འགྱུར་ལྡོག་གིས།",
    "མགོན་སྐྱབས་སུ་རེ་བའི་དཔོན་རྣམས་ཀྱང་།",
    "རེ་ལྟོས་པའི་འབངས་དང་གཡོག་འཁོར་རྣམས།",
    "འདི་བསམ་ན་དཔོན་གྱིས་ཕན་རེ་འཁྲུལ།",
    "རང་གཡོག་དང་གཉེར་ཁ་རང་གིས་བྱས།",
    "ཉམས་དགའ་ལ་དགེ་སྦྱོར་ངང་གིས་འཕེལ།",
    "ཁྱོད་འདི་ལ་འབད་ན་གཏན་དུ་ལེགས།",
