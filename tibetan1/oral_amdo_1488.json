    "ཁྱོད་ནི་བློ་དང་ལང་ཚོའི་དཔལ།",
    "གསུང་གི་མེ་ཏོག་འཐོར་བ་སྒྲུབ་སྤྲོ་ཡང་།",
    "དེ་ཕྱིར་འཕྲལ་དུ་འགྲུབ་པའི་རེ་བྲལ་ཡང་།",
    "སླད་དུའང་མཁྱེན་དཔྱོད་ཨ་མྲའི་ལྗོན་པ་ནི།",
    "ལྷུག་པར་ཟགས་པས་ཡིད་ཀྱི་རེ་སྐོང་མཛོད།",
    "གང་གི་རྣམ་དཔྱོད་འོད་སྟོང་འབར་བ་ལ།",
    "གྲོགས་ཁྱོད་སྐྱེས་ཐོབ་རང་བཞིན་གསེར་འདྲ་ཞིང་།",
    "སྦྱངས་པའི་ཡོན་ཏན་ཕུལ་བྱུང་གིས་ཕྱུག་པའི།",
    "ཁྱོད་ནི་བསྟན་འགྲོའི་ཁུར་གྱིས་མི་ངལ་བ།",
    "དེང་གི་ཆར་ཡང་བདེན་གཉིས་ཨེ་ཝཾ་ཟུང་དུ་འཇུག་པའི་འཕྲུལ་ལས་སྐལ་ལྡན་རྣམས་ཀྱི་མིག་གི་བདུད་རྩིར་མཚན་དཔེ་བཞིན་ལག་གི་རྣམ་པར་ཤར་བའི་གཟུགས་ཀྱི་སྐུ་ཚུར་མཐོང་གི་སྣང་ངོར་མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་ཏེ།",
    "ར་དམར་བུབས་བཅས་སྩལ་བ་སྤྱི་བོར་སོན་པས་ཡིད་ཀྱི་གདུང་བ་མ་ལུས་པ་ཅིག་ཅར་བསལ་ཏེ་དད་གུས་དང་སྤྲོ་དགའ་འབའ་ཞིག་བདག་གིར་བྱེད་པར་གྱུར་ལགས།",
    "གསལ་རིག་གི་ཁྱེའུ་བསམ་མེད་ཀྱིས་གཏན་གྱི་བསྟི་གནས་སུ་རློམ་པས་བློ་བདེའི་མལ་དུ་རྨོངས་པའི་གཉིད་དུ་ཡུར་ཞིང་།",
    "སྟོང་བར་ཟད་པའི་ཚེའི་མཚན་དུས་རྫོགས་པར་ཉེ་བའི་དུས་ཀྱི་སྐྱ་རེངས་མ་ཤར་ཙམ་གྱི་གནས་སྐབས་སུ་སླེབས་ཏེ་མཆིས་ལགས།",
    "གང་གི་དོན་དུ་སྲོག་ཀྱང་རྩྭ་བཞིན་དུ།",
    "སྡུག་བསྔལ་ཕྱག་གིས་སེལ་བར་མི་ནུས་ལ།",
    "དེ་ཕྱིར་དུས་ངན་བ་མོའི་རེག་པ་ཡིས།",
    "བསྟན་པའི་པད་ཚལ་མོག་པོར་བྱས་པ་འདི།",
    "ཁྱོད་དྲིན་ཉི་མའི་འོད་ཀྱིས་སྐྱོང་བར་རིགས།",
    "དེ་ལྟའི་ཞུ་མཆིད་མཐིང་གི་ཨུཏྤལ་འདི།",
    "མེ་ཁྱི་སྤྱི་ལོ་ལོར་གོང་མ་ཆན་ལུང་གིས་གཟིགས་སྐྱོང་ཆེན་པོས་རྗེ་འདི་ལ་འཇའ་ས་དང་གསེར་ཐམ་གནང་།",
    "མེ་སྦྲུལ་སྤྱི་ལོ་ལོར་གོང་མ་ཆན་ལུང་གིས་པེ་ཅིན་དུ་གདན་འདྲེན་ཞུ་བའི་བཀའ་ཡིག་འབྱོར།",
    "ན་མོ་གུ་རུ།",
    "དགེ་སློང་རྡོ་རྗེ་འཛིན་པ་ཡེ་ཤེས་རྒྱལ་མཚན་གྱིས་འདི་ལྟ་བུ་ཞིག་དགོས་ཞེས་བསྐུལ་བ་ལ་བརྟེན་ནས་ཤཱཀྱའི་དགེ་སློང་བློ་བཟང་དཔལ་ལྡན་ཡེ་ཤེས་ཀྱིས་སྦྱར་བའོ། ། ན་མོ་གུ་རུ།",
    "ཚངས་ལེགས་ཡབ་ཡུམ་སྲས་དང་བཙུན་མོར་བཅས།",
    "ཡོན་ཏན་བརྗོད་ཅིང་དམག་ཟོར་རྒྱལ་མོ་མཆོད།",
    "མཆོད་རྟེན་ཆུ་མིག་ནེའུ་གསིང་གིས་མཛེས།",
    "བྷྱོ་ལས་སྐྱེས་པའི་ལྷ་མོ་འཇིགས་རུང་མ།",
    "འབྲས་ཆང་རྒུན་ཆང་ཁྲག་གི་བཏུང་བ་ཡིས།",
    "དགྱེས་བཞིན་བཞེས་ལ་རྣལ་འབྱོར་བདག་ཅག་གི།",
    "ཉོན་མོངས་རྩད་ནས་འབྱིན་པའི་གནས་མཆོག་བྲག།",
    "འོན་ཀྱང་ཐ་མལ་མིག་གི་སྣང་ངོ་ལ།",
    "ཉོན་མོངས་རྩད་ནས་གཅོད་པའི་མངོན་སྤྱོད་ལས།",
    "འཕགས་མཆོག་སྤྱན་རས་གཟིགས་དང་གཤིན་རྗེའི་རྒྱལ།",
    "བྱ་རྒྱལ་རྒོད་པོ་ལྷ་བྱ་གོང་མོ་སོགས།",
    "ཀུན་གྱིས་བདག་གིས་ཇི་ལྟར་སྨོན་པའི་དོན།",
    "གང་གི་གསུང་གསང་གཎྜིའི་སྒྲ་དབྱངས་ལས།",
    "བདག་གིས་བསྟོད་པའི་དབྱངས་ཀྱིས་བསྔགས་པར་བྱ།",
    "གསུང་གིས་དབུགས་དབྱུང་ལྷག་གནས་མེ་ཏོག་སྩལ།",
    "ཨོཾ་ན་མོ་གུ་རུ་ཝེ།",
    "གང་གི་ཚེམས་བཟང་བཞུགས་པའི་རྫི་ཕྱོགས་ཀྱི།",
    "རོལ་མོ་ལས་བྱུང་ངོ་མཚར་སྣང་བརྙན་དང་།",
    "མཚན་དཔེའི་གསལ་རྫོགས་བཀྲ་བ་མཐོང་བའི་མོད།",
    "རིམ་གཉིས་རྣལ་འབྱོར་མཆོག་གིས་དུས་འདའ་བའི།",
    "མྱུར་བའི་ཤུགས་ཀྱིས་གཟིགས་ནས་དངོས་གྲུབ་རྣམས།",
    "སྩལ་བའི་བྱང་སེམས་བདག་གིས་ཉམས་བླངས་ནས།",
    "བདག་གི་ལུས་ངག་ཡིད་གསུམ་བྱིན་གྱིས་རླབས།",
    "མགོན་ཁྱོད་མདུན་གྱི་ནམ་མཁར་རྡོ་རྗེའི་ཁྲིར།",
    "བསྔོ་ཡི་ཁྱོད་ཉིད་འགྲུབ་པར་བྱིན་གྱིས་རློབས།",
    "མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་མ་ལུས་སྩོལ།",
    "ཟུང་འཇུག་རྡོ་རྗེ་འཆང་གི་གོ་འཕང་དག།",
    "མགོན་པོ་ཁྱོད་ཀྱི་གོ་འཕང་མངོན་བྱེད་ཤོག།",
    "དགེ་ལེགས་འཕེལ། ། ཉམས་མགུར་ཁག་གཉིས། ། ན་མོ་གུ་ར་ཝེ།",
    "སྔགས་ཟབ་མོའི་བཟླས་སྒོམ་ཚུལ་ལ་འཇུག།",
    "ལམ་ཐུན་མོང་ཐུན་མོང་མིན་པ་ཡི།",
    "གོ་དགོས་པར་རྟོགས་པ་ཁྱོད་ཀྱི་དྲིན།",
    "ཆེས་རྙེད་དཀར་རྟོགས་པ་ཁྱོད་ཀྱི་དྲིན།",
    "དཔལ་ཁྱོད་ཀྱི་དྲིན་ལས་བདག་གིས་ཐོས།",
    "ཆེས་ཁྱོད་ཉིད་བཀའ་དྲིན་ཕུལ་བྱུང་སྟེ།",
    "དོན་འདི་ཡིས་ཁྱོད་ཉིད་བཀའ་དྲིན་ཆེ།",
    "ཞེས་པ་འདི་ནི་མགྲོན་གཉེར་བློ་བཟང་ཡར་འཕེལ་གྱིས་བསྐུལ་ངོར་ཤཱཀྱའི་བཙུན་པ་བློ་བཟང་དཔལ་ལྡན་ཡེ་ཤེས་ཀྱིས་སྦྱར་བའོ། ། ན་མོ་གུ་ར་ཝེ།",
    "དུས་ཉིན་རེ་ཟླ་རེ་ལོ་རེ་ཡིས།",
    "གནས་དབེན་པ་ནགས་ཀྱི་ནང་དུ་སོང་།"
  ]
}