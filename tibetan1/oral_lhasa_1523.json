    "གཉིད་ལོག་པ་དང་གཞན་ཡང་རྟོགས་པར་འ་༹གྱུར་རོ།",
    "གཞན་གྱྀ་གཡོའ་༹་བ་མྱེད་པར་བྱ་བ་དམྱིགས་པ་འ་༹བྱུང་བའ་ྀ༹་ཕྱིར་རོ།",
    "བྱ་བས་ནྀ་གཡོ་བ་རྟོགས་པར་བྱེད་ན།",
    "ངོ་བོ་ཉྀད་མྱེད་པ་དག་ལ་ཡང་འ་༹ཇུག་པར་མྱི་འ་༹གྱུར་བའ་ྀ༹་ཕྱིར་དང་།",
    "འ་༹ཇུག་པར་བྱེད་པས་དེའ་ྀ༹་སྒོ་ནས་སྲོག་ཆགས་གཞན་ཡོད་པར་རྟོགས་ནས།",
    "དེ་ལ་ཇྀ་ལྟར་རྣམ་པར་རིག་པའ་ྀ༹་ཤེས་པ་སྔ་མ་རྣམས་བརྒྱུད་དེ།",
    "རྣམ་པར་རིག་བྱེད་ཀྱི་ཤེས་པའ་ྀ༹་རྟེན་གཡོ་བའ་ི༹་གནས་སྐབས་ཕྱྀ་མ་པའ་ི༹་སེམས་ཀྱི་རྒྱུད་ཁོ་ན་ལས་བརྒྱུད་དེ་སྐྱེའོ།",
    "གལ་ཏེ་གཞན་གྱྀ་སེམས་ཀྱི་རང་གྀ་ངོ་བོ་མངོན་སུམ་དུ་ཤེས་པར་གྱུར་ན་ནྀ།",
    "འ་༹དྀའ་ི༹་མངོན་སུམ་དུ་ཤེས་པར་གྱུར་ན་ནི།",
    "འ་༹ཛྀན་པའ་ི༹་རྣམ་པར་རྟོག་པ་མ་སྤངས་པ་རྣམས་ཀྱྀ་གཞན་གྱི་སེམས་ཤེས་པ་ཡང་ཐ་སྙད་ལ་མྱྀ་སླུ་བ་ཉིད་ཀྱྀས།",
    "གཞན་གྱྀ་སེམས་ཤེས་པ་ཞེས་བྱ་བར་ངེས་པར་བཟུང་ནས་ཟ་སྙད་འ་༹དོགས་སོ།",
    "དེས་ན་བྱ་བར་སྣང་བའ་ྀ༹་ཤེས་པའ་ྀ༹་སྤྱི་གཡོ་བ་ཙམ་གྱྀ་སྤྱི་རྟོགས་པར་བྱེད་པ་ཡྀན་བར་འ་༹དོད་པས།",
    "རྣམ་པར་ཆད་པ་དང་།",
    "རྣམ་པར་མ་ཆད་པར་སྣང་བས་བྱས་པའ་ྀ༹་ཁྱད་བར་བསྩལ་བ་ཡིན་ལ།",
    "འ་༹དོད་ཆགས་ལས་སྩོགས་པས་བྱས་པའ་ྀ༹་ཁྱད་བར་གྱྀ་གཡོ་བ་བསྩལ་པ་ཡིན་ནོ།",
    "ཁ་ནང་དུ་ལྟས་྾྾ པར་སྣང་བར་འ་༹ཇུག་པ་ཡྀན་ལ།",
    "ཁ་ཕྱིར་ལྟས་པར་སྣང་བ་ཡྀན་ནོ།",
    "གཞན་གྱྀས་བྱས་པའ་ི༹་གཡོ་བ་ལས་སྩོགས་པ་སྟོན་པར་བྱེད་པ་ཡྀན་ནོ།",
    "རྐྱེན་ཀྱྀ་ཁྱད་པར་ནི།",
    "གཞན་གྱི་སེམས་དང་མཚུངས་པར་ལྡན་བའ་ྀ༹་གཡོ་བའོ།",
    "ཁྲག་ལས་སྩོགས་པ་སྐྱེད་པར་བྱེད་པའ་ྀ༹་སེམས་ཡོངས་སུ་བསྡུའོ།",
    "བྱ་བ་ལ་སྩོགས་པར་སྣང་བའ་ྀ༹་རྣམ་པར་ཤེས་པ་གང་ལ།",
    "བྱ་བར་སྣང་བའ་ྀ༹་རྣམ་པར་ཤེས་པ་སྐྱེད་པར་རུང་བའ་ྀ༹་བདག་ཉིད་དུ་ཉེ་བར་གནས་པ་ཡྀན་ནོ།",
    "དོན་གཞན་དུ་སྨྲ་བ་ཉྀད་ཉམས་པར་འ་༹གྱུར་བ་ཡིན་བས།",
    "དོན་གཞན་དུ་སྨྲ་བ་ཉམས་པར་འ་༹གྱུར་ཞྀང་།",
    "ངེས་པར་ཆོམས་པར་འ་༹གྱུར་བ་ནྀ།",
    "དེ་ལྟར་རྒྱུད་གཞན་གྲུབ་པ་ཡོངས་སུ་རྫོགས་པར་བྱས་ཏེ།",
    "མྱི་བཟོད་པ་སྟོན་པར་བྱེད་དེ།",
    "ལུས་དང་ངག་གྀ་རྣམ་པར་རིག་བྱེད་སྣང་བ་དག་ལས།",
    "དེ་དག་གུད་ནས་སློང་བར་བྱེད་པའ་ྀ༹་སེམས་རྗེས་སུ་དཔག་པར་རྀགས་པ་ཡིན་ནོ།",
    "ཁྱེད་ཀྱིས་ཉན་པ་པོའ་ྀ༹་རྒྱུད་དང་འ་༹བྲེལ་པའ་ྀ༹་རྣམ་པར་རྀག་བྱེད་དུ་སྣང་བའ་ྀ༹་ཤེས་བ་གང་དག་གཡོ་བའ་༹་རྟོགས་པར་བྱེད་པ་ཡྀན་བར་འ་༹དོད་པ་དེ་དག་སྨྲ་བ་པོའ་ི༹་རྣམ་པར་རྀག་བྱེད་དུ་ཇི་ལྟར་འ་༹གྱུར།",
    "ཉན་པ་པོའ་ི༹་རྒྱུད་དང་འ་༹བྲེལ་པའ་ྀ༹་རྣམ་པར་རིག་བྱེད་དུ་སྣང་བ་དག་ནི།",
    "སྨྲ་བ་པོའ་ྀ༹་རྗོད་པར་འ་༹དོད་པ་དང་།",
    "རྒྱུད་ཐ་དད་པར་གཏོགས་བའ་ྀ༹་ཕྱིར་རོ་སྙམ་དུ་བསམས་པ་ཡྀན་ནོ་ཞེས་བྱ་བ་ནྀ་ཕྱོགས་སྔ་མ་ཡིན་ནོ།",
    "གཞན་གྱྀ་སེམས་ཀྱིས་ཀུན་ནས་བསླང་བའ་ྀ༹་རྣམ་པར་རིག་བྱེད་ཀྱྀ་ངོ་བོ་ཅན་ཉིད་ཡིན་བའ་ྀ༹་ཕྱིར།",
    "དེར་སྣང་བའ་ྀ༹་ཤེས་པས་ཀུན་ནས་སློང་བར་བྱེད་པའ་ི༹་སེམས་རྟོག་པར་བྱེད་དོ་ཞེས་ནྀ་མྱྀ་ཟེར་རོ།",
    "རྣམ་པར་རིག་བྱེད་ཀྱང་ཡྀན་བས།",
    "གཞན་གྱི་སེམས་ཀྱྀས་ཀུན་ནས་བསླང་བའ་ྀ༹་རྣམ་པར་རིག་བྱེད་དོ།",
    "དེའ་ྀ༹་ངོ་བོ་ནི་དེའ་ྀ༹་ཉིད་྾྾྾གྱི་སེམས་ཀྱིས་ཀུན་ནས་བསླང་བའ་ྀ༹་རྣམ་པར་རིག་བྱེད་ཀྱྀ་ངོ་བོ་ཅན་ཉིད་ཡིན་བ་དེའ་ྀ༹་ཕྱིར་རོ།",
    "གཞན་གྱྀ་སེམས་རྟོགས་པར་བྱེད་དོ།",
    "ཚིག་གྀ་རྣམ་པ་ཅན་གྱི་ཤེས་པ་དག་རྣམ་྾྾྾྾྾྾྾྾྾པར་རྀག་བྱེད་གཞན་གང་ཞིག་ཡྀན་ཞེ་ན།",
    "དེའ་ྀ༹་ཕྱིར་རྣམ་པར་རྀག་བྱེད་དག་ནི།",
    "རང་གྀ་གཞུང་ལུགས་ཀྱྀས་ཉེ་བར་ལེན་པའ་ྀ༹་རྒྱུ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཡིན་བར་འ་༹དོད་དེ།",
    "བརྗོད་པར་འ་༹དོད་པའ་ྀ༹་སེམས་ནི་མ་ཡྀན་ནོ།",
    "རྣམ་པར་རྀག་བྱེད་ཉིད་དུ་བསྟན་པ་ཡྀན་ནོ།",
    "རྣམ་པར་རྀག་བྱེད་ཀྱི་ཉེ་བར་ལེན་པས་བསྐྱེད་པ་དེ་དག་ཀྱང་།",
    "རྣམ་པར་རྀག་བྱེད་ཀྱི་ཉེ་བར་ལེན་བའ་ྀ༹་རྒྱུ་གང་ཡིན་བ་དེས་ནྀ།",
    "རྣམ་པར་རྀག་བྱེད་དག་ཡིན་བར་ཐ་སྙད་གདགས་པར་འ་༹གྱུར་རོ།",
    "རང་ཀུན་ནས་སློང་བར་བྱེད་པའ་ྀ༹་སེམས་རྣམ་པར་རིག་པར་བྱེད་པས།",
    "རྣམ་པར་རྀག་བྱེད་དུ་འ་༹དོད་པ་མ་ཡིན་ནམ།",
    "རྗོད་པ་སྣང་བའ་ི༹་ཤེས་པ་དག་ནྀ་ཉན་པ་པོས་དམྱིགས་པར་ཡང་མྱྀ་འ་༹གྱུར་ཏེ།",
    "དེ་གཉིས་རྣམ་པར་རྀག་བྱེད་ཉིད་ཡྀན་བར་འ་༹གྱུར་བ།",
    "རང་ཀུན་ནས་སློང་བར་བྱེད་པའ་ི༹་རྟོགས་པར་བྱེད་པར་འ་༹དོད་ཅེ་ན།",
    "དོན་གཅྀག་སེམས་པར་འ་༹ཛིན་྾྾྾གྱྀ་རྣམ་པར་ཤེས་པ་ནི།",
    "རྣམ་པར་ཤེས་པ་དེ་ལྟ་བུ་ཡྀན་བར་འ་༹དོད་དོ།",
    "དེའ་ྀ༹་རྒྱུ་ནི་དོན་གཅྀག་དུ་འ་༹ཛིན་པར་྾྾྾མས་སུ་མྱོང་བའ་ྀ༹་རྣམ་པར་ཤེས་པ་སྔ་མ་ཡྀན་ནོ།",
    "དོན་གཅྀག་དུ་འ་༹ཛིན་པར་ངེས་པ་ཅན་གྱྀ་རྣམ་པར་ཤེས་པ་ཉེ་བར་སྐྱེད་པར་རུང་བའ་ྀ༹་།",
    "རང་དང་གཞན་གྱྀ་རྣམ་པར་རིག་བྱེད་དག་བློས་གཅྀག་དུ་བཟླུམས་པ་ཉིད་ཡྀན་ནོ།",
    "དོན་གཅྀག་དུ་འ་༹ཛིན་པར་ངེས་པ་ནྀ།",
