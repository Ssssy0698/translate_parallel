    "ཁང་ཁྱིམ་ཞིག་ལ་རྩོག་རྩོག་ལྟ་བུར་འདུག་སྟེ།",
    "ས་རིང་ཞིག་ལོན་བ་དང་རྩྭའི་སྤྱིལ་པོ་ཚིག་ནས་རྟག་པར་ཁྱིམ་ཆེད་པོ་འདུག་སྟེ།",
    "ཉི་མ་བཞི་ལྔ་ཙམ་བལྟས་ཏེ་རྟག་པར་འདུག་པ་མཐོང་ན་ཡི་གེ་འདི་བསལ་ཏེ་བལྟས་ལ།",
    "ཙ་ནས་ཀྱང་འགྲུས་པར་དོན་དུ་སྤྱད་དེ།",
    "འདུག་ཉལ།",
    "དགེ་སློན་བེ་རོ་ཙ་ནའི་ལུས་སུ་སྤྲུལ་ཏེ།",
    "དགེ་སློང་བེ་རོ་ཙ་ནའི་སླད་དུ།",
    "མཆིལ་མའ་ཡང་ང་ཀོར་ཀོར་པོར་འདུག།",
    "ཆོག་ཆོག་ཡོ་ས་འདུག་ན་གློ་མཆིན་དུ་བབ་སྟེ་ནའོ།",
    "གའ་ལ་འདུག་མྱངས་ན་ཆེར་ནི་རྡོ་ཅིག་མཆིས་ཅུང་ན་ནི་ཆུ་མར་མེར་མེར་ཞིག་མཆིསོ།",
    "འདུག་པ་དང་དེ་རྣམས་སྦྱར་ཏེ།",
    "འགྲེང་བ་ཞེས་བྱ་བའི་རྩའི་རིགས་ལྟེ་བ་ནས་བྱུང་ནས་ནམ་མཁའི་བར་དུ་འཕགས་ཏེ་འདུག་པ་དང་།",
    "ཟླ་བ་སྒྲ་ཅན་གྱིས་ཟིན་ཅེས་སྨྲས་པ་གང་ཡིན་པ་དེ་ནི་ཟླ་བ་འདི་མངོན་སུམ་དུ་འདུག་པ་མ་ཡིན་ནམ།",
    "འཇིང་ཀྱོག་བྱེད་ལ་ཕར་བྲོས་ཚུར་བྲོས་ཤིང་འདུག་ཏུ་མི་བཏུབ་བོ།",
    "དེ་ནས་འདུན་པ་མིག་མཆི་མས་གང་ཞིང་དབུགས་རིང་༤པོའི་ཤུགས་ནར་གྱིས་ཕྱུང་ནས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ཁང་བཟངས་ན་ནི་འདུག་པས་མཐོང་།",
    "རྒྱལ་པོས་འདུག་ནས་དགྱེས་པ་དང་།",
    "ཀྱེ་མའོ་ས་ཕྱོགས་འདི་ནི་དགའ་དགའ་ལྟར་འདུག་པ།",
    "ཤིང་སྣ་ཚོགས་ཀྱིས་བརྒྱན་པ་དགའ་དགའ་ལྟར་འདུག་པ་ཞིག་སྟེ།",
    "ལན་འགའ་འདུག་པར་འདོད་ན་གན་རྐྱལ་དུ་འགྱེལ་ལོདུ།",
    "ཚངས་པ་ཡང་འོངས་ནས་དེ་དང་ཉེ་བ་ཞིག་ཏུ་འདུག་གོ།",
    "རྩྭའི་གདིང་བ་ལ་འདུག་པར་བྱའོ་སྙམ་པ་དང་།",
    "སྤྱི་བོ་སྨད་ནས་སྤོབས་པ་མེད་ལ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པར་གྱུར་ཏེ།",
    "དེ་ནས་ཚངས་རིས་ཀྱི་ལྷ་གཉིས་ཤིག་ཚངས་པའི་འཇིག་རྟེན་ན་འདུག་པ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་ཕྱིན་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་བཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་རྗོཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་རྒྱལ་པོ་ཆེན་པོ་བཞིས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོལ།",
    "འཇིག་རྟེན་ཀུན་དུ་སྣང་བར་འདུག་པ་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་༧ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "སྟན་འདི་ཁོ་ན་ལ་གཞིན་ནུ་གྲགས་པ་འདུག་པ་མཐོང་བར་འགྱུར་བའི་གནས་གང་ཡིན་པ་དེ་ཡོད་དོ།",
    "འདི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་ཙོའདི་སྐད་ཅེས་ཁྱིམ་བདག་དེའི་ཕྱིར་ཙོའདུག་ཤིག་དང་།",
    "སྟན་འདི་ཁོ་ན་ལ་གཞོན་ནུ་གྲགས་པ་འདུག་པ་མཐོང་བར་འགྱུར་བའི་གནས་གང་ཡིན་པ་དེ་ཡོད་དོ་ཞེས་བཀའ་སྩལ་ཏོ་སྙམ་ཙོདུ་རིག་ནས་དགའ་བ་དང་།",
    "ཡིད་བདེ་བ་སྐྱེས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་པ་དང་།",
    "ཁྱིམ་བདག་རིགས་ཀྱི་གཙོ་བོས་གཞོན་ནུ་གྲགས་པ་སྟན་དེ་ཉིད་ལ་འདུག་པ་མཐོང་ངོ།",
    "དེས་ན་ད་ལྟར་ཆུང་ཐོ་མའི་ནང་ན་འདུག་པ་ན་རྐྱེན་རྙེད་པ་ཡིན་ནོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་སྟེ་ཚིགས་སུ་བཅད་པས་གསོལ་པ།",
    "དགའ་སྟོབས་མས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "མགུ་བར་འགྱུར་བའི་གཏམ་རྣམ་པ་སྣ་ཚོགས་མཛད་ནས་ཕྱོགས་གཅིག་བྱཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་པ་དང་བཅོམ་ལྡན་འདས་ཀྱིས་ལྟེང་རྒྱས་འོད་སྲུང་བྱུརལ་པ་ཅན་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "ཀུན་དུ་རབ་ཏུ་འབར་ཏེ་མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ནས་སྲེག་པར་བྱེད་པ་བཞི་ལྟ་བུའི་ལུས་ཀྱིས་འཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཀུན་དུ་རབ་ཏུ་འབར་ཏེ་མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ནས་སྲེག་པར་་བྱེད་པ་བཞི་ལྟ་བུའི་ལུས་ཀྱིས་ཕྱོགས་གཅིག་ཏུ་འདུག་པ་ཡིན་ནོ།",
    "ཀུན་དུ་རབ་ཏུ་འབར་ཏེ་མེ་ལྕེ་གཅིག་ཏུ་གྱུར་པ་བཞི་པོ་དེ་དག་བས་ཀྱང་ཆེས་ལྷག་ཅིང་ཆེས་འཕགས་ལ་ཆེས་བཟང་བ་ལྟ་བུའི་ལུས་ཀྱིས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཀུན་དུ་རབ་ཏུ་འབར་ཏེ་མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ནས་སྲེག་པ་བཞི་པོ་དེ་དག་པས་ཀྱང་ཆེས་ལྷག་ཅིང་ཆེས་འཕགས་ལ་ཆེས་བཟང་བ་ལྟ་བུའི་ལུས་ཀྱིས་བྱཕྱོགས་གཅིག་ཏུ་འདུག་པ་ཡིན་ནོ།",
    "དཔེར་ན་མེའི་ཕུང་པོ་བཞི་པོ་དེ་དག་ཉིད་སྔ་མ་བཞིན་དུ་སྲེག་པ་ཞེས་བྱ་བ་ནས་མེའི་ཕུང་པོ་ལྔ་པ་དེ་མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ནས་སྲེག་པར་བྱེད་དོ་ཞེས་བྱ་བའི་བར་དེ་དག་པས་ཀྱང་ཆེས་ལྷག་ཅིང་ཆེས་འཕགས་ལ་ཆེས་བཟང་བ་ལྟ་བུའི་ལུས་ཀྱིས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
