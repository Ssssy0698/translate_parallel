    "ང་རང་ཚོའི་ར་དོན་དེའི་བདེན་མཐའ་མགོགས་ནས་མྱུར་དུ་གསལ་ཐུབ་པའི་ཀུན་སོང་དང་དམིགས་ཡུལ་ཞིག་ཡོད་པ་རེད།",
    "གནང་སྟངས་ཤིག་གི་ཐོག་ནས་འཛམ་གིང་ནང་གི་རྒྱལ་ཁབ་མང་པོ་ཞིག་གི་ནང་ལ་འགིག་གི་མེད་དུས།",
    "རྒྱབ་སྐྱོར་བེད་རྒྱུ་ཁག་པོ་ཆགས་ཀི་ཡོད་པ་བརོད་ཀི་འདུག་ཁོ་རང་ཚོས་བརོད་པ་བཞིན་དངོས་གནས་རེད་འདུག་ད་ལྟ་བར་དུ་མི་གངས་༡༤༣ ལབ་ཀི་ཡོད་པ་རེད་ལ།",
    "ཡང་ཁ་ཤས་ཀིས་༡༥ ནང་ལབ་ཀི་ཡོད་པ་རེད།",
    "ཡིན་ནའང་དེ་ཚོ་ཚང་མ་བོ་ཕམ་དགོས་པ་ཞིག་རེད་འདུག་བསམ་གི་འདུག་དེ་འད་ཡིན་དུས་ངས་འདི་ནས་བསྐྱར་ལྡབ་མང་པོ་བེད་མི་དགོས་པར་བོས།",
    "གོང་དུ་ཕག་སེལ་སི་འཐུས་གཅིག་གིས་གསུངས་པ་བཞིན་རེད།",
    "དེ་ནས་སྐབས་བཅོ་ལྔ་པའི་གོས་ཚོགས་འདི་མཐའ་མ་ཆགས་ཀི་ཡོད་པ་རེད།",
    "ང་ཚོ་གོས་ཚོགས་ཀི་ངོས་ནས་བོད་ཕི་ནང་གཉིས་ལ་བཞུགས་པའི་བོད་མི་དག་ལ་འབོད་སྐུལ་ཤུགས་ཆེན་པོ་ཞིག་གནང་ན་ག་ང་འད་ཡོད་དམ།",
    "ཐུགས་རེས་གཟིགས།",
    "རང་ལུས་མེར་བསེག་མ་གཏོང་རོགས་གནང་ཞེས་འབོད་སྐུལ་བེད་དགོས་རྒྱུ་དེ་ཧ་ཅང་གི་གལ་ཆེན་པོ་མཐོང་གི་འདུག་ད་ལྟ་བར་དུ་ང་རང་ཚོས་གོས་ཚོགས་ནས་གསུངས་ཡོད་པ་རེད།",
    "ཡིན་ནའང་སྔར་ལས་ལྷག་པའི་ཤུགས་ཆེན་པོ་ཞིག་འབོད་སྐུལ་གནང་དགོས་ཀི་འདུག་ང་ཚོ་བོད་མི་གཅིག་ཉུང་དུ་ཕིན་པ་ཡིན་ན་བོ་ཕམ་དགོས་པ་རེད།",
    "ད་དུང་ཡིན་ནའང་ཁ་ཤས་གོ་བ་ལོག་ལེན་གིས་མ་འོངས་པར་དེ་འད་བྱུང་མི་སིད་པ་མ་རེད།",
    "དེ་འད་ཡིན་དུས་གོས་ཆོད་ཤུགས་ཆེན་པོ་འཇོག་དགོས་པ་མ་ཟད་བོད་ཕི་ནང་གཉིས་ལ་ད་མཚམས་འཇོག་གནང་རོགས་གནང་ཞེས་འབོད་སྐུལ་ཤུགས་ཆེན་པོ་གནང་དགོས་ཀི་འདུག་དེས་འཛམ་བུ་གིང་གི་རྒྱབ་སྐྱོར་རག་ཁག་པོ་འདུག་དེས་བོད་ཀི་ར་དོན་ཐོག་ལ་ཕན་ཐོགས་ཆེན་པོ་མི་འདུག་དེ་ལས་ང་ཚོས་རང་ལུས་མེར་བསེག་མ་བཏང་ནས་བོད་ཀི་ར་དོན་ཐོག་ལ་ཕག་ལས་གནང་རྒྱུ་ཧ་ཅང་མང་པོ་ཡོད་པ་རེད།",
    "དེ་ཚང་མ་གསལ་པོ་བས་ཏེ་ཞུ་ཐུབ་ན་ཡག་པོ་ཡོད་པ་རེད་བསམ་གི་འདུག་དེ་ནས་ངས་མང་པོ་ཞུ་མི་དགོས་པའི་ཐོག་ནས་གོ་སྐབས་གནང་བ་དེ་ལ་ཐུགས་རེ་ཆེ་ཞེས་ཞུ་རྒྱུ་ཡིན།",
    "ར་བའི་ཆ་ནས་ཕག་རོགས་ཁ་ཤས་ཀིས་དེ་འད་གསུངས་ཀི་འདུག་ང་ཚོའི་གོས་ཚོགས་སྐབས་བཅོ་ལྔ་འདི་ཉིད་འགོ་བཙུགས་ནས་ད་ལྟའི་བར་དུ་ཚོགས་ཐེངས་རེ་རེར་བོད་ནང་གི་ཛ་དག་གནས་སྟངས་ཟེར་བ་འདི་དང་།",
    "དེ་བཞིན་གདུང་སེམས་མཉམ་སྐྱེད་ཟེར་བ་གཉིས་མཚམས་ཆད་མྱོང་ཡོད་པ་མ་རེད།",
    "ཚོགས་ཐེངས་གཅིག་ལས་གཅིག་ཛ་དག་འད་པོའི་གནས་སྟངས་སང་ནས་འགོ་བསད་ཀི་ཡོད་པ་དེ་འད་ཞིག་རེད།",
    "ཕོགས་གཅིག་ནས་ཛ་དག་གི་གནས་སྟངས་འདི་ཡིས་ང་ཚོ་མང་པོ་ཞིག་ལ་སེམས་ཀི་དཀའ་ངལ་དང་།",
    "ལུས་ཀི་དཀའ་ངལ་སོགས་དཀའ་ངལ་མང་པོ་ཞིག་འཕྲད་བསད་ཀི་ཡོད་པ་རེད།",
    "ཡིན་ཡང་ཕོགས་གཅིག་ནས་རྒྱ་ནག་གིས་མི་རིགས་དབེ་འབེད་དང་གཉའ་གནོན།",
    "མི་སེར་སེལ་ཡུལ་ལ་སོགས་པའི་སིད་ཇུས་ཤིག་གཏན་ཁེལ་བ་འདིས་བོད་མི་རིགས་ལ་ཡང་བསྐྱར་གསོན་ཤུགས་ཤིག་བསྐྲུན་ཡོད་པ་རེད་ཅེས་དེ་ཞུ་འདོད་བྱུང་སོང་།",
    "དེ་བཞིན་བོད་ནང་ཛ་དག་གི་གནས་སྟངས་འདི་མཚམས་ཆད་རྒྱུ་ཁག་པོ་རེད།",
    "ར་བའི་ཆ་ནས་ལོ་རབས་ལྔ་བཅུ་ནས་ད་ལྟའི་བར་དུ་བོད་ནང་ཛ་དག་གི་གནས་སྟངས་དེ་རྒྱུན་ཆད་མེད་པ་ཞིག་རེད།",
    "ཡིན་ཡང་འདི་ལ་དམིགས་བསལ་གི་ཁྱད་པར་འད་བོ་ཞིག་ནི་བོད་ནང་གི་ཛ་དག་གི་གནས་སྟངས་དེ་ལོ་དུས་རྒྱས་བཅད་སང་ནས་ཞུས་པ་ཡིན་ན།",
    "བོད་ནང་གི་བོད་མི་ཚོས་སོ་སོའི་མི་རིགས་དང་སོ་སོའི་རྒྱལ་ཁབ།",
    "རྒྱ་ནག་གཞུང་གི་གདུག་རྩུབ་ཅན་གི་སིད་ཇུས་དེ་མུ་མཐུད་གནས་ཡོད་པར་བརེན།",
    "བཙན་བོལ་སི་ཚོགས་ནང་གསར་ཞུགས་བས་ནས་ཚང་མས་ཁུར་མཉམ་འཁུར་གི་སང་ནས་བོད་མི་རིགས་ཀི་ར་དོན་སང་ལ་ལས་ཀ་ཞིག་བེད་རྒྱུ་དེ་བསམ་བོ་དང་པོ་གཏོང་གི་ཡོད་པ་རེད།",
    "གདན་ས་ཁག་གི་གྲྭ་རྒྱུན་ཐོག་ལ་དཀའ་ངལ་ཏོག་ཙམ་ཞིག་འཕྲད་ཀི་ཡོད་པ་རེད།",
    "ཡིན་ཡང་བོད་ནང་གི་དཀའ་ངལ་དེ་སྔོན་ཆད་ཕི་ལོགས་ལ་ཡོང་ནས་མི་བསགས་རྒྱུའི་ཚབ་ལ་བོད་ནང་ནས་ནང་ལོགས་ལ་སོང་ནས་ཡར་སོང་ས་མེད་པའི་སྐབས་དེར།",
    "བོད་ནང་ལོགས་ནས་ལར་ཞེན་གི་མེ་ཕུང་འབར་གི་ཡོད་པ་རེད།",
    "འདི་ཡང་ཕོགས་གཅིག་ནས་ང་རང་ཚོའི་འཐབ་རོད་ཅིག་གི་ཁ་ཕོགས་ཡང་དག་ཅིག་འགོ་གི་ཡོད་པའི་བསམ་ཚུལ་ཞིག་སོ་སོ་ལ་ཡོད།",
    "གཙོ་བོ་དེ་བོད་ནང་གི་རང་ལུས་མེར་བསེགས་ཀི་གནས་སྟངས་འདིས།",
    "ཁ་གསལ་གཏིང་གསལ་གི་སང་ནས་ངོ་འཕྲོད་ཡོང་ཡོད།",
    "མི་བརྒྱ་དང་བཞི་བཅུ་ཞེ་གསུམ་རེད།",
    "དེ་འད་ཡིན་པ་སོང་ཙང་ད་ལྟ་བར་དུ་རང་ལུས་མེར་བསེགས་གཏོང་མཁན་དེ་ཚོས་སོ་སོར་འདེམས་ཁ་ཡོད་པའི་ཐོག་ནས་རང་ལུས་མེར་བསེགས་གཏོང་གི་ཡོད་ན།",
    "འདི་ཏོག་ཙམ་ཞིག་གནས་ཚུལ་ཆུང་ཆུང་རེད་བསམ་གི་འདུག་འདེམས་ཁ་མེད་ནས་རང་ལུས་མེར་བསེགས་གཏོང་གི་ཡོད་པ་ཞིག་སོ་སོ་ཡིས་ངོས་འཛིན་བེད་ཀི་ཡོད།",
    "བོད་ནང་གི་བོད་མི་གང་ཞིག་གི་ལོ་ཚོད་དང་སི་ཚོགས་ཐོག་གི་གནས་རིམ།",
    "བཙུན་མ་སོགས་སྐྱ་སེར་ཕོ་མོ་ལ་དབེ་བ་མེད་པར་མང་པོ་ཞིག་གིས་རང་ལུས་མེར་བསེགས་བཏང་ཡོད་པ་རེད།",
    "རྦད་དེ་ཕར་ཕོགས་ཀིས་གཉའ་གནོན་དང་གདུག་རྩུབ་དེ་བཟོད་ཐབས་བལ་བའི་སང་ནས་མི་རིགས་འདིའི་དཀའ་ངལ་སྐྱོབ་རྒྱུའི་འདུ་ཤེས་དག་པོ་ཞིག་གི་སང་ནས།",
    "ང་རང་ཚོ་ཡང་ད་བར་གཉིད་ཁུག་ནས་བསད་ཡོད་པ་མ་རེད་ཟེར།",
    "རྒྱལ་སིའི་སིངས་ཆ་ཡི་སང་ལ་ད་ལྟ་བར་དུ་གང་ལ་གང་འཚམས་ཀི་དཀའ་ལས་ཤིག་བརྒྱབ་ཡོད་པ་རེད།",
    "གྲུབ་འབས་དེ་ཞུ་རྒྱུ་གལ་ཆེན་པོ་མཐོང་གི་འདུག་དེ་ཡིན་པ་སོང་ཙང་ད་ལྟ་ཕག་རོགས་ཁ་ཤས་ཤིག་གིས་གསུངས་པ་བཞིན་བོད་ནང་ནས་རང་ལུས་མེར་བསེགས་གཏོང་མཁན་ཚོས་བསམ་བོ་ཞིག་གཏོང་རྒྱུ་ཡོད་ན་བཏང་ན་ཡག་པོ་འདུག་གོང་ཆེན་པོ་རག་གི་འདུག་བོད་མི་རིགས་ནང་དངོས་གནས་དང་གནས་ཀི་བསེགས་བཅད་བརར་གསུམ་གིས་བཙོ་སྦྱང་བས་པའི་གསེར་བཙོ་མ་ནང་བཞིན་བོད་མི་ཡང་དག་པ་དག་འདི་འདའི་བས་ནས་འཕྲོ་བརླག་སོང་ན་ཕངས་སེམས་ཆེན་པོ་ཞིག་འདུག་འདིས་མི་རིགས་ཀི་ར་དོན་གི་ཐོག་ག་རེ་ཞིག་ཕན་གི་འདུག་རྒྱལ་སིའི་སིངས་ཆའི་སང་ལ་ག་རེ་ཞིག་ཕན་གི་འདུག་འབས་བུ་ག་རེ་ཞིག་ཐོན་གི་འདུག་ཟེར་ན།",
    "ང་ཚོ་ལ་རྒྱལ་ཁ་ཆེན་པོ་ཞིག་མི་འདུག་ཟེར་ནས་ཁོང་ཚོ་ལ་ངོ་སོད་ཅིག་བེད་ཐུབ་ན་ཡག་པོ་རེད་བསམ་གི་འདུག་དེ་གཅིག་ཡིན།",
    "ད་ལྟ་རྒྱ་ནག་གི་སྟངས་འཛིན་འོག་ལ་ལྷག་བསད་པ་གཞིས་སོད་བོད་མིའི་ཁོད་ལ་ཡོད་པ་མ་རེད།",
    "འདི་དག་ཐམས་ཅད་ཀི་རོག་ར་གཅིག་སིལ་གིས་ཐུན་མོང་གོས་གཞི་གོས་ཆོད་བཞག་ཏེ།",
    "རྒྱ་ནག་གིས་ལས་ས་པོར་བཅོས་བསྒྱུར་ཐུབ་པ་དེ་འད་ཞིག་མ་རེད།",
    "ཁོང་གི་སྐུ་ཕྲེང་རེས་མ་ཡི་གནས་སྟངས་སྐོར་ལ་བཀའ་སོབ་གསལ་གསལ་ཐིང་ཐིང་གསར་རེན་དུ་བཏོན་ནས་གནང་བཞག་པ་དེ་ཚོ།",
    "ང་ཚོས་དམིགས་བསལ་བོད་ནང་གི་གཞིས་སོད་བོད་མི་ཚོར་རེ་རེ་བཞིན་ངོ་སོད་བེད་རྒྱུ་དེ་ཧ་ཅང་གི་གལ་ཆེན་པོ་རེད།",
    "དེ་འད་ཡིན་པ་སོང་ཙང་།",
    "སུ་ཞིག་གིས་ངོས་ལེན་བེད་ཀི་ཡོད་པ་རེད།",
    "ངེས་འཇོག་ཡག་པོ་མེད་པ་གསལ་པོ་ཆགས་ཡོད་པ་རེད།",
    "བོད་ནང་གི་བོད་མི་དེ་ཚོ་ལ་མགོ་སྐོར་གཏོང་རྒྱུ་དང་།",
    "རྒྱལ་སིའི་མི་མང་ལ་མགོ་སྐོར་གཏོང་རྒྱུའི་ཐབས་ཤེས་ངན་པ་དེ་འད་འཐེན་གི་ཡོད་ན།",
    "དེས་གང་ཡང་འཇོན་གི་མ་རེད་ལ་ནུས་པ་ཅི་ཡང་ཐོན་གི་མ་རེད་ཟེར་ནས་ཞུ་འདོད་བྱུང་སོང་།",
    "ར་བའི་ཆ་ནས་རྒྱ་ནག་དམར་ཤོག་གི་གཞུང་ཞིག་རེད།",
    "དམར་ཤོག་གཞུང་ཁོ་རང་ཚོའི་མཐའ་མའི་དམིགས་ཡུལ་དེ་གུང་ཁན་རིང་ལུགས་ཞེས་པ་དེ་མངོན་འགྱུར་བེད་རྒྱུ་དེ་རེད།",
    "རྒྱ་ནག་དམར་ཤོག་པ་ཐམས་ཅད་ཀི་མཐའ་དོན་གི་གཞི་འཛིན་སའི་ཕུགས་འདུན་རིང་པོ་དེ་གུང་ཁན་རིང་ལུགས་རེད།",
    "གུང་ལུགས་ཟེར་ན་ཁོང་ཚོས་ག་རེ་ལབ་ཀི་ཡོད་པ་རེད།",
    "དགོས་མཁོ་ལྟར་བགོ་བཤའ་རྒྱག་གི་ཡོད་ཟེར།",
    "དེ་ལ་འཚོལ་སྙེགས་བ་རྒྱུ་དམིགས་འབེན་དུ་བཟུང་ནས་དམར་ཤོག་པར་རྒྱབ་སྐྱོར་བེད་ཀི་ཡོད་ལབ་ཀི་ཡོད་པ་རེད།",
    "དེ་ལོག་ཟ་རུལ་སུངས་རིང་ལུགས་པ་ཆགས་བསད་པ་དེ་ཁོང་ཚོས་ཧ་གོ་ཡི་རེད།",
    "དེ་འད་ཡིན་པ་སོང་ཙང་།",
    "མི་མང་ལ་མགོ་སྐོར་ག་ཏོང་བར་མདུན་སྐྱོད་ཀི་དམིགས་འབེན་ཞིག་དགོས་པ་རེད།",
    "དེ་ལ་མིང་གསར་པ་རྨི་ལམ་ཟེར་བ་ཞིག་བཏགས་ཡོད་པ་རེད།",
    "རྨི་ལམ་ཟེར་བ་དེ་ནམ་མཁའ་ཡི་འཇའ་ལྟར་འཛིན་ས་ཞིག་མེད་པ་ཆགས་བསད་ཡོད་པ་རེད།",
    "རྨི་ལམ་ནི་རྨི་ལམ་རེད།",
    "དེ་འད་ཡིན་པ་སོང་ཙང་།",
    "ཁ་སང་དེ་རིང་ང་རང་ཚོས་མང་གཙོའི་ལམ་ལུགས་དང་སི་ཚོགས་ཀི་གནས་བབ་ལ་དཔག་ནས་ང་ཚོ་ལ་དམའ་འབེབས་རང་བཞིན་གི་ཚིག་ལྟ་བུ་ཁ་སང་དེ་རིང་ཏོག་ཙམ་ཐོན་གི་འདུག་ག་བོད་ནང་གི་བོད་མི་ཚོས་སེམས་ཤུགས་ཆག་ཡག་དང་བོ་སོབས་ཉམས་བཅུག་རྒྱུའི་ཆེད་དུ།",
    "མང་གཙོ་མིག་གིས་མ་མཐོང་མཁན།",
    "ལྷག་པར་དུ་རྒྱལ་ཁབ་མངའ་ཁོངས་ཡོད་པ་ཞིག་དང་བསྡུར་ན་ཡང་བཙན་བོལ་བོད་མིའི་མང་གཙོ་འདི་ཚད་ལྡན་ཞིག་རེད་བསམ་གི་ཡོད་པ་རེད།",
    "ཡིན་ཡང་འདིའི་ནང་རྩུབ་བརར་དང་རོག་ག་རོད་གཞི་ཏོག་ཙམ་ཞིག་ཡོང་སིད་ཀི་རེད་སྙམ།",
    "དེ་ག་རེ་རེད་ཟེར་ན།",
    "འཐབ་ཕོགས་གཅིག་གྱུར་ཁང་ཟེར་བ་དེ་རེད།",
    "དེས་ལས་ཀ་བེད་ས་གཙོ་བོ་དེ་ག་རེ་རེད་ཟེར་ན།",
    "འདིའི་འགོ་སྟངས་ཀང་རྒྱ་གར་དང་ཨ་རི་ལ་སོགས་པའི་མང་གཙོ་ཚད་ལྡན་གི་རྒྱལ་ཁབ་དེ་ཚོས་བསྟོད་བསྔགས་ཐོབ་བསད་པའི་ལམ་ཁ་ཞིག་དང་།",
    "འགོ་སྟངས་ཤིག་གི་ཐོག་འགོ་ཡི་ཡོད་པ་རེད་ཟེར་ནས་གསལ་པོ་ཞུ་འདོད་བྱུང་སོང་།",
    "དཔལ་ལྡན་ཚོགས་གཙོ་མཆོག་བོད་ནང་གི་ཛ་དག་གནས་སྟངས་ཀི་ཐད་ལ་ང་ཚོས་ལོ་མང་པོའི་རིང་བཀའ་མོལ་གནང་བསད་པ་རེད།",
    "ཐོག་མར་དེ་ལ་བོད་ནང་ཛ་དག་གི་གནས་སྟངས་ཐད་ལ་ཆ་ཤས་ལེན་པའི་སྐབས་སུ་སེམས་འཚོར་དང་འད་བའི་ཐོག་ནས་གཅིག་ཞུ་འདོད་བྱུང་།",
    "བོད་ནང་ཛ་དག་གི་གནས་སྟངས་དེ་ཇེ་ཞན་ཇེ་སྡུག་ཏུ་འགོ་ཡི་ཡོད་པ་དེ་ང་ཚོ་ཚང་མས་ད་ལྟ་བར་དུ་གསུང་བསད་པ་རེད།",
    "དེ་གསུང་པའི་མཉམ་དུ་ག་རེ་བསམ་གི་འདུག་ཞུས་པ་ཡིན་ན།",
    "རྒྱལ་སིའི་ནང་ལ་འབེལ་བ་བེད་སྟངས་རེད།",
    "དེ་ཚོའི་ཐད་ལ་ང་ཚོས་ཤུགས་ཇི་ཙམ་ཐེབས་ཡོད་དམ་སྙམ་པའི་འཚོར་བ་དེ་རང་བཞིན་གི་སེབས་ཀི་འདུག་ང་ཚོས་དེའི་ཐོག་ལ་སྐུ་ལས་བསྐྱོན་ཡོད་པ་བདེན་པ་རེད།",
    "དེར་བརེན་དཔེ་མཚོན་ཙམ་ཞུས་པ་ཡིན་ན།",
    "ཕི་རྒྱལ་གི་དཔོན་རིགས་མང་པོའི་མཉམ་དུ་འབེལ་བ་ཡོད་ཟེར་གི་ཡོད་པ་རེད།",
    "མི་མང་པོ་མཉམ་དུ་ང་ཚོ་འབེལ་བ་ཡོད་ཟེར་གི་ཡོད།",
    "དེ་ང་ཚོ་དང་འབེལ་བའི་གནས་བབས་དེ་དང་དཀའ་ལས་རྒྱབ་པའི་གནས་བབས་འདི་དེ་ནས་ཀང་གང་འད་ཡིན་ནམ་བསམ་པའི་འཚོར་བ་ཞིག་བྱུང་།",
    "ངས་ཡར་ལངས་དུས་འཚོར་བ་འདི་མ་ཞུས་ན་འགིག་གི་མི་འདུག་གང་ལྟར་ཡང་ང་འདིར་མི་མང་གི་མགིན་ཚབ་པ་ཞིག་ཆགས་བསད་ཡོད་པ་རེད།",
    "དེ་འདའི་བསམ་ཚུལ་དེ་མི་མང་ནང་དུའང་ཡོད་པ་རེད་དན་གི་འདུག་ལ།",
    "བོད་ནང་གི་གནས་སྟངས་ཀི་ཐད་ལ་གང་ལྟར་དཔའ་བོ་༡༤༣ གིས་སྐུ་ལུས་མེ་མཆོད་དུ་ཕུལ་བ་རེད།",
    "དེ་བཞིན་ཉེ་ཆར་དཔའ་བོ་རོ་རེ་ཚེ་རིང་ལགས་བཅས་ཀི་རང་ལུས་མེ་སེག་གཏོང་མཁན་དེ་ལྟར་བྱུང་ཡོད།",
    "དེ་མིན་བོད་ཀི་བདེན་མཐའ་སེལ་བའི་ཆེད་དུ་ལངས་ཕོགས་གང་ཡིན་མིན་ལ་མ་ལྟོས་པར་མང་པོ་ཞིག་གིས་སྐུ་ལས་སྐྱོན་ཡོད་པ་རེད།",
    "ཡིན་ནའང་ང་ཚོའི་གནས་སྟངས་དེ་ད་དུང་འདི་འདའི་སང་གནས་ཡོད་ཙང་།",
    "རང་བཞིན་གིས་སེམས་འཚབ་ཅིག་སེབས་ཀི་འདུག་ཞེས་ཞུ་འདོད་བྱུང་།",
    "དེའི་སྐོར་ལ་ཕག་སེལ་སི་འཐུས་མང་པོས་བཀའ་གནང་སོང་།",
    "དམ་དག་ཧ་ཅང་བེད་ཀི་ཡོད་པ་རེད།",
    "ང་ཚོ་ཚང་མས་མཁྱེན་གསལ་ལ་འདིར་ཡང་འཁོད་འདུག་དེ་ཚོ་ང་ཚོའི་བོ་ཕམ་གི་གནས་ཚུལ་རེད།",
    "ང་ཚོ་བོད་པ་ཚོའི་སེམས་ནང་ཕོག་ཤོས་དེ་ཁོ་ཚོས་བེད་ཀི་ཡོད་པ་རེད།",
    "དེའི་སྐུ་པར་ལ་ཁོ་ཚོས་དམ་དག་དེ་འད་བེད་དུས་བོད་པ་ལ་གནོད་ཀི་རེད་བསམ་པ་མ་གཏོགས།",
    "དེ་ང་ཚོ་ཚང་མས་ཤེས་ཀི་ཡོད་པ་རེད།",
    "ཡིན་ནའང་ང་ཚོར་ཁོ་ཚོས་ཁྱད་གསོད་བེད་ཀི་ཡོད་པ་རེད།",
    "དེ་འད་ཡིན་ཙང་དེའི་བར་ལན་ལ་ང་ཚོས་ག་རེ་སོད་དགོས་ཟེར་ན།",
    "འདིར་བོད་ཀི་རྒྱལ་དར་གཉིས་ཀི་བར་ལ་སྐུ་པར་བཞག་པ་ནང་བཞིན་ཕི་རྒྱལ་དོན་གཅོད་ཁག་ཚང་མའི་ནང་དུ་ཆབ་སིད་ཀི་སིངས་ཆ་ཡོད་ས་དེ་ཚོའི་ཐོག་ལ་དཔོན་རིགས་སུ་འད་ཞིག་ཡིན་རུང་མཇལ་རྒྱུ་ཡོད་པ་ཞིག་དགོས་རྒྱུ་གལ་ཆེན་པོ་མཐོང་གི་འདུག་མ་འོངས་པར་དེ་ཚོའི་གས་རྒྱ་མི་ལ་བར་ལན་སོད་རྒྱུར་གལ་ཆེན་པོ་མཐོང་གི་འདུག་ངས་འདི་གཅིག་ཞུ་འདོད་བྱུང་།",
    "དེ་ནས་ཁ་སང་ཕག་སེལ་སི་འཐུས་གཅིག་གིས་བཀའ་གནང་སོང་།",
    "མ་སུ་རི་བོད་ཁྱིམ་གི་སོབ་ཕྲུག་ལོ་ན་ཆུང་ཆུང་དགུང་ལོ་༡༦ ལ་ཕེབས་པ་ཞིག་གིས་སྐུ་ལུས་མེ་བསེགས་སུ་བཏང་གནང་བ་རེད།",
    "ཁོང་གི་གནས་བབས་ཐབས་སྐྱོ་པོ་དེའི་ཐོག་ང་ཚོ་ཚང་མ་སེམས་སྐྱོ་བའི་གནས་སྐབས་སུ་སན་ཁང་དུ་ང་ཚོའི་སེ་ཚན་མང་པོ་ཞིག་གིས་ཕར་གྲུ་མཉམ་འདེགས་ཀི་མཐུན་འགྱུར་གནང་འདུག་སྡུག་དུས་སྐབས་སུ་མཐུན་འགྱུར་ཞུ་དགོས་དང་དགོས།",
    "དེ་དག་གནང་མཁན་ཚང་མར་ངས་སིངས་ཆ་འདི་བརྒྱུད་ནས་ཐུགས་རེ་ཆེ་ཞུ་འདོད་བྱུང་།",
    "དེ་བཞིན་ཁོང་གི་ཡབ་ཡུམ་གཉིས་ཀིས་བཀའ་ག་རེ་གནང་སོང་ཞུས་ན།",
    "ད་ལན་ང་ཚོའི་བུས་དེ་ལྟར་བས་པ་རེད།",
    "དེ་ང་ཚོའི་གོས་ཆོད་འདིའི་ནང་དུ་ཡོད་པ་མ་རེད།",
    "ཡིན་ནའང་ཡབ་ཡུམ་གཉིས་ཀི་དགོངས་པ་ལ་ཡོད་པ་དེ་ཡང་སིངས་ཆ་འདིའི་ཐོག་ལ་ཞུས་ན་དན་སོང་།",
    "ང་ཚོའི་ར་དོན་ཐོག་ལ་འཐབ་རོད་བ་རྒྱུར་རང་ལུས་མེ་བསེགས་བཏང་མཁན་དེ་ཚོ་ཆེ་མཐོང་ལྡན་པ་མ་རེད་ར་བ་ནས་ཞུ་ཡི་མེད།",
    "ཡབ་ཡུམ་གཉིས་ཀི་དགོངས་པ་ལ་ཡོད་པ་དེ་ང་དེ་ལ་མགི་ན་ཚབ་གཅིག་ཡིན་པ་སོང་ཙང་།",
    "འདིར་གོ་སྐབས་འདི་བརྒྱུད་ནས་ཞུ་འདོད་བྱུང་སོང་།",
    "ཐུགས་རེ་ཆེ།",
    "དཔལ་ལྡན་ཚོགས་གཙོ་མཆོག་ད་ལྟ་བོད་ནང་གི་ཛ་དག་གི་གནས་སྟངས་ཐད་ལ་ང་ཚོས་གདུང་སེམས་མཉམ་སྐྱེད་ཀི་བཀའ་མོལ་གནང་གི་ཡོད་པ་རེད།",
    "སིར་བཏང་བོད་ནང་གི་ཛ་དག་གི་གནས་སྟངས་དེ་གུང་ཁན་ཏང་གིས་ང་ཚོའི་བོད་ལ་བཙན་འཛུལ་འགོ་བཙུགས་པ་ནས་བཟུང་དུས་ད་ལྟའི་བར་དུ་ཡོད་ཡོད་པ་ཞིག་རེད།",
    "ང་ཚོས་ཡིན་པ་ཡིན་ཡང་རྒྱ་ནག་གཞུང་གིས་ང་ཚོའི་ས་འཕྲོག་སོང་།",
    "མི་འབུམ་ག་ཉིས་ཙམ་བསད་སོང་།",
    "ད་ལྟ་ཡིན་ཡང་བསད་དང་གསོད་བཞིན་པ་རེད།",
    "དེ་ནང་བཞིན་གིས་ང་ཚོའི་ལམ་དང་ལུགས་སོལ་ཚང་མ་བསྣུབས་སོང་ཟེར་ནས་སྐད་རྒྱག་གི་ཡོད་པ་རེད།",
    "སྐད་རྒྱག་ས་དེ་སིངས་ཆ་མི་འད་བ་མང་པོ་ཡོད་པའི་ནང་ནས་ད་ལྟའི་སིངས་ཆ་འདི་གལ་ཆེན་པོ་ཞིག་རེད།",
    "རོམ་པ་པོ་དང་སྒྱུ་རལ་བ་རེད།",
    "དེ་ཚོ་མང་པོ་ཞིག་གི་བསམ་བོའི་ནང་ལ་དཀའ་ངལ་ག་ཚོད་ཅིག་ཡོད་པ།",
    "ཕི་ལོགས་ལ་ཐོན་གི་ཡོད་པ་དེ་ཚོ་ཚང་མ་ང་ཚོའི་གོས་ཆོད་རིམ་པའི་ནང་དུ་གསལ་གི་ཡོད་པ་རེད་ལ་གེང་སོང་ཡང་བེད་ཀི་ཡོད་པ་རེད།",
    "གེང་སོང་བེད་དགོས་ངེས་ཤིག་རེད།",
    "ལྷག་པར་དུ་སོ་སོར་མཚོན་པ་ཡིན་ན་བོད་ནང་གི་དངོས་ཡོད་ཀི་གནས་སྟངས་ཉམས་སུ་མྱོང་ནས་སིངས་ཆ་འདིའི་སང་ལ་སེབས་མཁན་ཞིག་ཡིན་ཙང་།",
    "བོད་ནང་གི་ཛ་དག་གི་གནས་སྟངས་ལ་གདུང་སེམས་མཉམ་བསྐྱེད་ཀི་གོད་ཆོད་གོས་འཆར་གོས་ཚོགས་རིམ་པར་སེབས་སྐབས་ཡར་ལངས་ནས་གེང་སོང་ཙམ་ཞིག་བེད་ཐུབ་པ་ཡིན་ནའང་།",
    "བོད་ནང་གི་རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་དང་།",
    "བོད་ནང་གི་མི་ཚོའི་སེམས་ཁམས་ཀི་ཐོག་ལ་གདུང་སེམས་མཉམ་སྐྱེད་ཅིག་བེད་རྒྱུར་ལས་རྒྱུ་འབས་ཀི་སོ་ནས་བསམ་བོ་ཞིག་བཏང་སྟེ་རག་པར་ཡར་ལངས་ནས་ཅིག་ཞུ་སོད་ཀི་ཡོད།",
    "རྒྱ་ནག་གཞུང་གིས་བོད་ནང་བདེ་སྐྱིད་དང་ལྡན་པ་དང་།",
    "དཔལ་འབོར་གི་ཐོག་ནས་ཧ་ཅང་གི་ག་རྒྱས་པོ་ཡོད་པ་དེ་འད་ཞིག་གསུང་སོད་ཀི་ཡོད་པ་རེད་དེ།",
    "བོད་ས་ཁྱོན་ཡོངས་ནས་དུས་ད་ལྟའི་བར་དུ་མེ་བསེགས་ག་ཚོད་བཏང་ཡོད་པ་དང་འཇུ་བཟུང་ག་ཚོད་བས་ཡོད་པ་དེ་ཚོར་བལྟས་པ་ཡིན་ན།",
    "དངོས་ཡོད་གནས་སྟངས་ཀི་ཐོག་ནས་བདེ་སྐྱིད་དང་ལྡན་པ་ཞིག་མེད་པ་ཆགས་བསད་ཡོད་པ་རེད།",
    "ང་ཚོའི་བོད་ནང་གི་མི་ཡི་སེམས་ནང་གི་དཀའ་ངལ་དེ་ཕི་ལོག་ས་ལ་སྟོན་བེད་ཀི་ལམ་ཁ་མང་པོ་ཞིག་སྒྱུ་རལ་གི་ཐོག་ནས་གཞས་བཏང་རྒྱུ་དང་འཁབ་སྟོན་བེད་རྒྱུ།",
    "རོམ་འབི་རྒྱུ་རེད།",
    "དེ་ཚོའི་ཐོག་ནས་ཕར་བལྟས་པ་ཡིན་ན་སྡུག་བསྔལ་ག་ཚོད་ཅིག་གི་ནང་ལ་ཡོད་པ་དེ་གསལ་ཞིང་གསལ་བ་རེད་འདུག་ད་ལྟ་ཡིན་ཡང་ང་ཚོའི་ངོས་ནས་བོད་ནང་གི་ཛ་དག་གི་གནས་སྟངས་ཀི་ཐོག་ལ་ང་ཚོས་ལས་ཀ་ག་ཚོད་ཅིག་བེད་ཀི་ཡོད་པ་རེད།",
    "རྒྱལ་སིའི་སང་ལ་ག་ཚོད་ཅིག་བེད་ཀི་ཡོད་པ་རེད།",
    "མཇུག་སྐྱོང་ག་འད་བེད་ནས་གནང་གི་ཡོད་པ་རེད།",
    "རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་བརྒྱ་དང་བཞི་བཅུ་ཞེ་གསུམ་གི་ཞལ་ཆེམས་ཀི་སྐོར་ལ་བདག་པོ་ག་ཚོད་རྒྱག་གི་ཡོད་པ་རེད།",
    "དེ་ནང་བཞིན་ཚང་མར་འགན་ཡོད་པ་ཞིག་ཆགས་བསད་ཡོད་པ་རེད།",
    "ང་ཚོ་མི་མང་གི་ངོས་ནས་གཙུག་ལག་ཁང་གི་མདུན་དུ་རོ་རིང་ཞིག་བཞེངས་ཡོད་པ་རེད།",
    "ང་ཚོའི་ངོས་ནས་ག་ཚོད་ཅིག་སྙོབ་ཀི་ཡོད་པ་རེད།",
    "ཁོང་རྣམ་པ་ཚོ་གཤེགས་ཟིན་པ་རེད།",
    "རེས་སུ་ལྷག་བསད་པ།",
    "མི་ཚེ་གང་བོར་ན་ཚའི་འོག་ཏུ་ག་ཚོད་ཅིག་ལྷག་བསད་ཡོད་པ་རེད།",
    "ཉི་མ་རེ་རེ་བཞིན་ག་ཚོད་ཅིག་གིས་ང་ཚོར་རེ་བ་རྒྱག་གི་ཡོད་པ་རེད།",
    "དེ་ཚོ་ཚང་མར་ང་ཚོ་གོས་ཚོགས་ཀི་སིངས་ཆ་འདི་བརྒྱུད་ནས།",
    "སོ་སོ་མི་མང་གི་འཐུས་ཚབ་ཅིག་ཡིན་པའི་ཆ་ནས་ཁོང་རྣམ་པ་ཚོའི་བསམ་བོའི་གཏིང་གི་སྡུག་བསྔལ་དེ་སྐྱིད་སྡུག་མཉམ་མྱོང་བེད་ཐུབ་ཡོད་མ་རེད་ཀང་།",
    "སྡུག་བསྔལ་ཡོད་པ་དེ་ང་ཚོ་ཚང་མས་གོ་སྐབས་ནམ་ཡོད་ལ་ཞུ་དགོས་རྒྱུ་དེ་འགན་ཞིག་རེད་བསམ་གི་ཡོད།",
    "དེ་དང་མཉམ་དུ་སྔོན་མ་ཡིན་ནའང་གོས་ཚོགས་ཀི་ནང་ལ་ཁོང་ཚོའི་བོ་སྟོབས་དང་ཁོང་ཚོའི་ཕག་ལས་གནང་སྟངས་ཀི་ཉམས་བཞེས་དེ་ཚོའི་ཐོག་ལ་བསྔགས་བརོད་ཞུ་ཡི་ཡོད་ཅེས་ཞུས་པ་དང་ཆབས་ཅིག་ཏུ་རང་སོག་གཅེས་འཛིན་དགོས་པའི་འབོད་སྐུལ་བེད་ཀི་ཡོད་ཅེས་བཟོ་བཅོས་གོས་འཆར་ཞིག་ཁྱེར་ཡོང་བ་རེད།",
    "འོན་ཀང་ཕིན་ཡོད་པ་མ་རེད།",
    "དུས་ད་ལྟ་ཡིན་ནའང་སོ་སོ་ཕར་ཁྱུར་འགོ་བའི་སྐབས་ལ་ཡིན་ནའང་སིངས་ཆ་འདིའི་སང་ནས་བོད་ནང་གི་གཞོན་སྐྱེས་ཚོ་རེད།",
    "གྲྭ་བཙུན་ཚོ་རེད།",
    "སྐྱ་སེར་ཕོ་མོ་སུ་འད་ཞིག་ཡིན་ནའང་འདི་འདའི་འ་ཆད་འུ་ཐུག་གི་རང་ལུས་མེར་བསེགས་བཏང་བའི་འཐབ་རོད་ཀི་གནས་བབས་འདིའི་ཐོག་ལ་ད་ལྟ་ཡིན་པ་ཡིན་ནའང་།",
    "གོང་དུ་ཡང་ཕག་སེལ་སི་འཐུས་ཁ་ཤས་ཀིས་འདི་ལས་ལྷག་ཅིག་གསུངས་སོང་།",
    "དེ་ནང་བཞིན་གིས་བཙན་བོལ་ནང་ལ་ཉེ་ལམ་གཞོན་སྐྱེས་ཤིག་གིས་རང་ལུས་མེར་བསེགས་བཏང་བ་དང་བོད་ནང་དུ་ཡང་དེ་ག་རང་བཏང་བ་རེད།",
    "གཞོན་སྐྱེས་དེ་ཚོའི་རང་ལུས་ར་ཆེན་པོ་དེ་མེར་བསེགས་བཏང་ཡོང་དུས་སེམས་ནང་ལ་དཀའ་ངལ་མང་པོ་ཡོང་གི་འདུག་དེ་ནང་བཞིན་ཉེ་འབེལ་ཚོ་ལ་དེ་ལས་ལྷག་པའི་དཀའ་ངལ་ཡོད་པ་རེད།",
    "བས་ཙང་མར་དགོས་མཁོའི་སོབ་གསོ་རྒྱག་དགོས་རྒྱུ་དེ་གལ་ཆེན་པོ་རེད་ཅེས་སོ་སོའི་ཚོར་སང་ལ་དེ་དན་གི་འདུག་ནམ་བཞག་རྒྱུན་ལྡན་ནས་དེ་གཅིག་ཞུས་ན་དན་བྱུང་།",
    "ངན་བྱུས་ཀི་ཁ་གཏད་ས་དེ་གང་དུ་ཡིན་པ་ཚང་མས་གེང་སོང་གནང་སོད་ཀི་ཡོད་པ་རེད།",
    "དུས་ད་ལྟ་ཡིན་ནའང་རེས་ལུས་མ་ཐེབས་པར་ཞུ་དགོས་རྒྱུ་དེ་གལ་ཆེན་པོ་རེད་ཅེས་ཞུ་རྒྱུ་ཡིན།",
    "དེ་ནས་ང་ཚོ་བོད་ནང་དུ་དཀའ་ངལ་འདི་ཙམ་ཞིག་ཡོད་པ་རེད།",
    "རྒྱ་ནག་གཞུང་གིས་ཡ་ལན་བེད་ཀི་ཡོད་པ་མ་རེད།",
    "རྣམ་འགྱུར་སྟོན་སྟངས་རེད།",
    "དེའི་ཐོག་ཏུ་ཡང་ངའི་ངོས་ནས་བསམ་ཚུལ་ག་རེ་ཞུ་འདོད་བྱུང་ཟེར་ན།",
    "བདུན་བཅུ་དོན་དགུ་ནས་བས་ཏེ་སེ་ཚན་རིམ་པ་གཅིག་གི་སྐུ་ཚབ་ཅིག་ཕིན་ཡོད་པ་རེད།",
    "ཉིས་སྟོང་ལོའི་སྟོང་ལོ་གསར་པའི་ནང་དུ་སྐུ་ཚབ་རིམ་པ་ཞིག་ཕིན་ཡོད་པ་རེད།",
    "སྐབས་རེ་སྐབས་རེར་འཐུས་ཤོར་ཏོག་ཙམ་ཏོག་ཙམ་ཕིན་མེད་འགོ་བསམ་པའི་གནས་སྟངས་མང་པོ་ཞིག་མཐོང་ཡོང་གི་ཡོད་པའི་སྐབས་ལ་དེ་ཚོ་གཅིག་ཞུས་བཞག་ན་བསམ་སྟེ་དེ་གཅིག་ཞུ་རྒྱུ་ཡིན།",
    "དེ་ནས་ད་ལྟ་ང་ཚོའི་ར་བའི་ར་དོན་གི་ཆ་ལ་གོས་མོལ་ཡོང་གི་ཡོད་པ་མ་རེད་ཀང་།",
    "དེ་ནང་བཞིན་སིར་བཏང་གོང་དུ་ཀང་གསུང་གི་ཡོད་པ་རེད།",
    "དེ་ནང་བཞིན་གཞུང་འབེལ་གི་མི་ས་རེད།",
    "དེ་ཚོའི་གནས་སྟངས་དེ་གལ་ཆེན་པོ་ཆགས་འདུག་དེ་དང་ཆབས་ཅིག་ཏུ་ང་ཚོ་བོད་ནང་གི་ཛ་དག་གནས་སྟངས་ཀི་སྐོར་ལ་ཕིའི་རྒྱལ་ཁབ་ལ་ཡིན་ན་ཁྱིམ་ཚང་གཅིག་གཉིས་ཤིག་གིས་སྐྱིད་སྡུག་མཉམ་མྱོང་།",
    "གདུང་སེམས་མཉམ་སྐྱེད་ཀི་ལས་འགུལ་སེལ་ནས་ཚར་ལྔ་བཅུ་ང་གཅིག་འདི་ལྟར་རིམ་པ་བས་ནས་འགོ་བསད་ཡོད་པ་རེད།",
    "ནང་ཡིན་པ་ཡིན་ནའང་དེ་ག་རང་རེད།",
    "དེ་དང་དེ་ནང་བཞིན་གི་དེ་ཚོའི་སྐོར་ལ་ང་ཚོའི་འབེལ་ཡོད་ཀི་འགོ་འཁིད་རྣམ་པ་ཚོ་ས་གནས་ས་ཐོག་ཏུ་ཕེབས་པའི་སྐབས་སུ་ཐུག་འཕྲད་བ་རྒྱུ་དང་།",
    "ཡང་ཐུག་འཕྲད་བ་མ་བདེ་བ་ཡོད་ན་འབེལ་ཡོད་སོགས་ལ་དེ་ཚོའི་གནས་སྟངས་ཀི་སྐོར་ལ་ཡིན་པ་ཡིན་ནའང་ང་ཚོས་གཅིག་ཞུ་དགོས་རྒྱུ་དང་།",
    "འབེལ་ལམ་བཟུང་དགོས་རྒྱུ་དེ་ཧ་ཅང་གི་གལ་ཆེན་པོ་ཆགས་བསད་འདུག་ལྔ་ཚན་ཐམ་པ་འདིའི་ནང་ན་ང་ཚོ་བོད་ནང་ལ་དཀའ་ངལ་བྱུང་བཞག་པའི་སྐབས་སུ་རྒྱལ་སིའི་ནང་རེད།",
    "དེ་ནང་བཞིན་གི་རྒྱ་གར་རེད།",
    "ང་ཚོ་བོད་པའི་སི་ཚོགས་ནང་རེད།",
    "འདིའི་སྐོར་ལ་ཕག་ལས་གནང་མཁན་ཚོས་བོད་ནང་ལ་ཁ་ཕན་ཚིག་ཕན་ཙམ་ལས་མ་བྱུང་བ་ཡིན་ཡང་རེད།",
    "རྣམ་འགྱུར་སྟོན་སྟངས་ཤིག་གི་ཐོག་ནས་ཡིན་ནའང་རེད།",
    "སྐུ་ལས་བསྐྱོན་མཁན་ཚང་མ་ལ་ཐུགས་རེ་ཆེ་ཞུ་རྒྱུ་དང་།",
    "རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་རྣམས་ཡིན་ནའང་རེད།",
    "ཐུགས་ཆེ་རེ་གནང་།",
    "གཞི་རའི་གོང་དུ་བཀུར་འོས་སི་འཐུས་མང་པོ་ཞིག་གིས་ཆ་ཤས་བངས་པ་ཡིན་ཙང་།",
    "སོ་སོའི་ཞུ་འདོད་པའི་གནས་ཚུལ་མང་པོ་ཞིག་གསུངས་ཚར་སོང་།",
    "དེ་ལྟར་ཡིན་དུས་དེ་ཚོ་བསྐྱར་ཟློས་མི་དགོས་པའི་ཐོག་ནས་ངས་དེ་རིང་འདི་ནས་ཚོར་བ་ཆེན་པོ་ཞིག་གི་ཐོག་ནས་ཞུ་རྒྱུ་གཅིག་དེ་ག་རེ་ཡིན་ཞུས་ན།",
    "ད་ལྟ་བོད་ནང་ལ་ཛ་དག་གི་གནས་སྟངས་ག་ཚོད་ཙམ་ཆགས་ཡོད་མེད་དེ་ང་ཚོ་ཚང་མས་ཤེས་ཀི་རེད།",
    "ལྷག་པར་དུ་རྒྱ་ནག་གི་སྡུག་རྩུབ་ཅན་གི་སིད་བྱུས་དེ་དག་གི་འོག་ནས་མ་གཟོད་དེ་སྐུ་ལུས་མེར་བསེགས་གནང་མཁན་གི་གངས་ཀ་ཡིན་ནའང་ད་ལྟ་ང་ཚོར་ཤེས་རོགས་བྱུང་བ་དེ་༡༤༣ ཆགས་ཀི་ཡོད་པ་རེད།",
    "གངས་ཀ་དེར་ཡང་ང་ཚོས་བསམ་བོ་ཞིག་གཏང་བ་ཡིན་ན་ཉུང་ཉུང་ཞིག་ཆགས་ཀི་ཡོད་པ་མ་རེད།",
    "ང་རང་ཚོའི་གོས་ཚོགས་ཀི་ར་བའི་ནང་ལ་སི་འཐུས་༤༤ མ་གཏོགས་ཡོད་པ་མ་རེད།",
    "འདི་ལྟར་གཅིག་འཛོམས་ཡོང་དུས་མང་པོ་ཞིག་མཐོང་གི་འདུག་འོན་ཀང་བོད་ནང་དུ་སྐུ་ལུས་མེར་བསེགས་གཏོང་མཁན་དེ་འདི་ལས་ལྡབ་གསུམ་གི་མང་བ་ཆགས་བསད་ཡོད་པ་རེད།",
    "བས་ཙང་དེ་འད་བའི་རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་ཚོས་རང་ཉིད་ཀི་ཚེ་སོག་བཏང་སྟེ་བོད་ནང་གི་བདེན་པའི་མཐའ་གསལ་བའི་ཆེད་དུ་ལས་འགུལ་སེལ་བའི་ཉེར་ལེན་ལ་བརེན་ནས་གཞི་རའི་རྒྱལ་སིའི་སི་ཚོགས་ཀི་ཐོག་ཏུ་ཡིན་ཡང་བོད་དོན་གི་ཐོག་ལ་ཐུགས་སང་ཡོང་བ།",
    "ཡིན་ནའང་བོད་ནང་གི་རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་དེ་ཚོས་རང་གི་སོག་ཡན་བོས་བཏང་བའི་རིན་ཚད་དེ་འད་བའི་གྲུབ་འབས་ཤིག་ཐོན་ཡོད་པ་རེད་དམ་ཟེར་ན་ར་བ་ཉིད་ནས་ཐོན་ཐུབ་ཀི་མེད་པ་ཞིག་ལ་ངོས་འཛིན་བེད་ཀི་ཡོད།",
    "དེ་འད་བའི་གྲུབ་འབས་ཤིག་ཐོན་གི་མེད་དུས།",
    "བོད་ནང་དུ་དཀའ་སྡུག་དངོས་སུ་མྱོང་བཞིན་པའི་རྒྱལ་ག་ཅེས་དཔའ་བོ་དཔའ་མོ་འགའ་ཞིག་གིས།",
    "རྒྱ་ནག་གི་སྡུག་རྩུབ་དེ་མྱོང་བཞིན་པའི་སྐབས་སུ།",
    "སོ་སོའི་དིན་ཆེན་གི་ཕ་ཐུག་པ་ཇི་བཞིན་དགའ་ཚོར་ཡོང་ས་རེད་ཅེས།",
    "དེ་ལྟ་བུའི་སྡུག་བསྔལ་ཡོད་ལུགས་ཀི་བཀའ་མོལ་དེ་འད་གནང་ཡོང་དུས།",
    "ངར་འབོད་སྐུལ་ཞུ་རྒྱུའི་སོབས་པ་དེའང་ར་བ་ནས་རེད་ཀི་མི་འདུག་དེ་འད་ཡིན་ཙང་ངས་དེ་རིང་གཙོ་བོ་ཞུ་འདོད་པ་དེ་ག་རེ་ཡིན་ཞེ་ན།",
    "ང་རང་ཚོ་ཕི་ལོག་ལ་ཡོད་པ་ཚོས།",
    "བཀའ་སི་ཐུན་མོང་གི་སོ་ནས་གནང་དགོས་ཀི་ཡོད་ཀང་འད།",
    "དེར་དམིགས་བསལ་གི་ཚོགས་ཆུང་བཙུག་ས་སྟེ།",
    "འཛམ་གིང་གི་སྟོབས་ཆེན་རྒྱལ་ཁབ་མང་པོ་དང་མཉམ་དུ་དེ་འདའི་ཐོག་ཏུ་དམིགས་བསལ་གི་ཆེད་མཁས་མི་ས་གདན་འདེན་ཞུས་ཏེ།",
    "དེའི་སང་ལ་བགོ་གེང་གནང་ནས་ནུས་པ་དང་ལྡན་པ་ཞིག་ཡོང་ཕིར་ང་ཚོས་ག་རེ་བེད་དགོས་ཀི་འདུག་དེའི་སང་ལ་ང་ཚོས་ངེས་པར་དུ་བེད་དགོས་ཀི་འདུག་ལ།",
    "བེད་ཐུབ་རྒྱུ་ཞིག་རེད་བསམ་གི་འདུག་མ་གཏོགས།",
    "དེ་ནས་ཕར་འགོ་དུས་སོ་སོའི་ལས་དོན་གི་ཐོག་ཏུ་མགོ་འཐོམ་བསད་པ་ཡིན་ན།",
    "ངས་འདི་འད་ཞིག་དན་གི་འདུག་རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་དེ་ཚོ་ད་ལྟ་ཇི་སྙེད་ཅིག་འགོ་ཚར་བ་རེད།",
    "མ་འོངས་པར་ཡང་རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་ཇི་སྙིད་ཅིག་བསེབས་ངེས་རེད།",
    "དེ་འད་ཡིན་ཙང་ཡོང་གི་རེད།",
    "རྒྱ་ནག་གིས་ག་ཚོད་སྡུག་པོ་བཏང་སྟེ་བསད་བཞག་པ་ཡིན་ཡང་རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོའི་ལུས་བསད་ཐུབ་ཀང་སེམས་ར་བ་ཉིད་ནས་གསོད་ཐུབ་ཀི་མ་རེད།",
    "ང་ཚོ་བཙན་བོལ་ཕི་ལོགས་ལ་ཡོད་པ་དེ་ཚོས་གཟབ་གཟབ་མ་བས་པ་ཡིན་ན།",
    "རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོའི་སེམས་ལ་ཉེན་ཁ་དེ་ང་ཚོས་བཟོ་ཡི་རེད་ཅེས་དེ་ངེས་པར་དུ་ཚང་མས་ཐུགས་འཚབ་གནང་དགོས་ཀི་འདུག་རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་རྣམས་ཀི་གཙོ་བོ་དེ་ཚེ་འདི་ཕི་གཉིས་ཀི་སྐྱབས་མགོན་རྒྱལ་བ་ཐམས་ཅད་མཁྱེན་པའི་བཀའ་དང་དགོངས་པ།",
    "ཁོང་ཚོའི་སེམས་ནང་དུ་ཡང་དེ་ཙམ་གི་དངངས་སྐྲག་ཆེ་བར་ཡོང་ནས།",
    "ལས་འགུལ་ཞིག་ཡིན་ཡང་ཤུགས་ཆེ་རུ་ཡོང་བའི་གནས་སྟངས་ཡིན་པ་དེ་གསལ་བོ་རེད།",
    "དེ་འད་ཡིན་ཙང་ང་ཚོ་བཙན་བོལ་ལ་ཡོད་པ་འདི་དག་ཐམས་ཅད་ཀིས་རང་གཞན་རོགས་གསུམ་ཚང་མས་གོས་ཚོགས་ནང་དུ་སྟོན་རྒྱུའི་གདོང་པ་གཅིག་དང་རྒྱ་ཆེའི་མང་ཚོགས་དང་ཕི་རུ་སྟོན་རྒྱུའི་གདོང་པ་གཉིས་གསུམ་ཞིག་ཁྱེར་ནས་མ་སོད་པར་བས་ཏེ།",
    "ང་ཚོས་གཟབ་གཟབ་མ་བས་པ་ཡིན་ན་འཇིག་རེན་གནའ་བོའི་གཏམ་དཔེ་ལ།",
    "ཐག་ཉེ་ན་མིག་གིས་རི་མ་མི་མཐོང་།",
    "ང་ཚོས་འདི་ནས་སྐབས་རེ་སྐྱབས་མགོན་ཡིད་བཞིན་ནོར་བུའི་བསླུ་བ་མེད་པའི་ལམ་སྟོན་དེ་དག་ལ་ཁྱད་གསོད་ཡིན་གི་མ་རེད་ཀང་མཚན་སད་འད་ཤོར་བའི་གནས་སྟངས་དེ་འད་ཡོང་བ་ཡིན་ན།",
    "ཏན་ཏན་རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་ཚོའི་ཐུགས་གསད་ཀི་རེད།",
    "དེའི་ཐོག་ལ་ང་རང་ཚོ་ཚང་མས་དགོངས་པ་ཆེ་བཞེས་གནང་དགོས་ཀི་འདུག་དེ་ནས་མཐའ་བསོམས་དེ་ལ་ངས་སྔོན་མའི་གོས་ཚོགས་སྐབས་སུ་ཐེངས་ཁ་ཤས་ཤིག་ཞུས་པ་ཡིན།",
    "ང་ཚོའི་གཞུང་ཟེར་བ་དེ་རྒྱ་མཚོ་ནང་བཞིན་འཁྱིལ་ནས་སོད་དགོས་ཀི་རེད།",
    "གཞུང་དང་མ་ཡིན་པ་ཟེར་བ་དེ་ཆུ་ཕྲན་ནང་བཞིན་བཞུར་དགོས་ཀི་རེད།",
    "དེ་འད་བྱུང་བ་ཡིན་ན་མགོ་ལ་མགོ་དང་གཞུག་ལ་གཞུག་གི་བཟོ་ལྟ་ཞིག་དོན་ཡོང་གི་རེད།",
    "དེ་དུས་ནུས་པ་ཞིག་དོན་ཡོང་གི་རེད་ཅེས་ཐེངས་ཁ་ཤས་ཤིག་ཞུས་པ་ཡིན།",
    "ཡིན་ནའང་ང་ཚོ་ར་རམ་ས་ལའི་བཟོ་གྲྭ་དེ་ཚོའི་ནང་དུ་ཕར་ཕིན་ནས་ངའི་སྐད་ཆ་དེ་ང་རང་གིས་ཀང་ངོ་མ་ཤེས་པ་འད་ཞིག་བཟོས་ནས་ཡོང་གི་འདུག་དེ་འད་ཡིན་ཙང་ད་ལྟ་བར་དུ་སྐད་ཆ་དེ་མ་ཞུས།",
    "ངས་དེ་རིང་གི་གོས་ཚོགས་མཐའ་མ་འདིའི་ནང་སྐད་ཆ་དེ་བསྐྱར་དུ་གཅིག་ཞུ་འདོད་བྱུང་།",
    "གཞུང་ཟེར་བ་དེ་རྒྱ་མཚོ་ནང་བཞིན་འཁྱིལ་ནས་སོད་དགོས་ཀི་རེད།",
    "བས་ཙང་གཞུང་དང་མ་ཡིན་པ་ཟེར་བ་དེ་ཆུ་ཕྲན་ནང་བཞིན་བཞུར་དགོས་ཀི་ཡོད་པ་རེད།",
    "དེ་འད་མ་གནང་བ་ཡིན་ན་ངས་གོང་དུ་ཞུས་པ་བཞིན་རྒྱལ་གཅེས་དཔའ་བོ་དཔའ་མོ་ཚོའི་ཐུགས་གསོད་ཀི་རེད།",
    "བས་ཙང་དེའི་འགན་དེ་ང་ཚོ་སུས་ཀང་བཟོད་མི་ཐུབ་པའི་གནས་སྟངས་ཤིག་ཆགས་ཀི་རེད་ཅེས་དེ་ཞུ་རྒྱུ་དང་།",
    "དེ་ཞུས་ཏེ་བསད་ན་བོད་ནང་གི་ཛ་དག་གི་གནས་སྟངས་ལ་གདུང་སེམས་མཉམ་སྐྱེད་ཆགས་ཀི་ཡོད་དམ།",
    "བོད་ཕི་ལོགས་ཀི་ཙག་གེ་ཙིག་གེ་ལ་གདུང་སེམས་མཉམ་སྐྱེད་ཆགས་ཀི་ཡོད་ཧ་མི་གོ་བ་འད་ཞིག་ཆགས་འགོ་ཡི་འདུག་དེ་འད་སོང་ཙང་ངས་མཚམས་འཇོག་གི་ཡིན།",
    "ཐུགས་རེ་ཆེ།",
    "ཚང་མ་བིས་འདུག་སི་འཐུས་རྒྱུན་ལས་ཚོས་མོས་མཐུན་བས་ཏེ་བཞག་ཡོད་དུས།",
    "ཡིན་ནའང་གནས་སྟངས་ཁ་ཤས་དང་བཀའ་མོལ་ཁ་ཤས་ལས་འཕྲོས་ཏེ་ཚིག་རེ་ཟུང་ཞིག་ཞུ་འདོད་བྱུང་སོང་།",
    "ལྷག་པར་བོད་ཡུལ་འདི་ཡང་རྒྱ་ཡུལ་དུ་སྒྱུར་བཞིན་པ་རེད་ཟེར་བ་བིས་ཡོད་པ་རེད།",
    "རྒྱ་གར་གི་མི་དང་།",
    "ཨིན་ཇིའི་མི་ལ་མ་བསྒྱུར་བ་བེད་དགོས་པ་དེ་ང་ཚོས་དམ་བཅའ་བརན་པོ་དགོས་པ་རེད།",
    "དང་པོ་ང་ཚོས་དམ་བཅའ་འདི་བཞག་དགོས་འདུག་ཅེས་ཞུ་རྒྱུ་དང་།",
    "གཉིས་པ་དེར་ཚིག་ཐོག་ནས་ཁ་སང་གསུངས་པ་རེད།",
    "ཐ་སྙད་མང་པོ་ཞིག་བཏགས་ཡོད་པ་རེད།",
    "དང་པོ་ང་ཚོས་བསམ་བོ་བཏང་དགོས་པ་རེད།",
    "གོང་དུ་ཞུས་པ་ལྟར་ང་ཚོས་རོད་བཞིན་པ་དེ་ཏག་ཏག་བསད་ཡོད་ན་ཐད་ཀར་འབི་རྒྱུ་རེད།",
    "རང་ལུས་མེར་སེག་མཁན་རྣམས་ཀིས་ཕུགས་འདུན་ཇི་བཞིན་གྲུབ་ཐུབ་མེད་པ་སོགས་མང་པོ་གསུངས་སོང་།",
    "ཕོགས་གཅིག་ནས་སྙན་པོ་ཞིག་འདུག་ལ་དགོས་རྒྱུ་ཞིག་ཀང་རེད་འདུག་ཕོགས་གཅིག་ནས་བལྟས་ན་རང་ལུས་མེར་བསེགས་བཏང་མཁན་ཚོས་བཏང་བ་ནང་བཞིན་གྲུབ་འབས་ཐོན་མ་སོང་ཟེར་དུས།",
    "དཔེར་ན་རོ་རེ་ཚེ་རིང་གི་ས་རང་ལུས་མེར་བསེགས་བཏང་བའི་རེས་སུ་དཔེ་མཚོན་ཞིག་བཞག་པ་ཡིན་ན།",
    "ཨ་མི་རི་ཀར་བསད་པའི་བོད་མི་ཚོས་ལམ་ལག་ཏུ་རོ་རེ་ཚེ་རིང་གི་སྐུ་པར་བཞག་ཐུབ་པ་དེ་རང་ལུས་མེར་བསེགས་བཏང་བ་ལ་བརེན་ནས་བཞག་ཐུབ་པ་ཞིག་རེད་མ་གཏོགས།",
    "དེ་མིན་པའི་མི་ཞིག་གིས་ལས་འགུལ་གཞན་ཞིག་སེལ་ནས་ལག་ཏུ་བཞག་ཐུབ་ཀི་རེད་དམ་མ་རེད།",
    "དེ་བཞིན་བཀའ་ཤག་གིས་ནམ་རྒྱུན་གསུངས་པ་ལྟར།",
    "དེ་འད་ཡིན་དུས་ནུས་པ་ཐོན་མ་སོང་གསུངས་པ་དེ་རྣ་བར་འགོ་མ་སོང་ལ།",
    "དངོས་ཡོད་གནས་ཚུལ་ཡང་མ་རེད་ཟེར་ནས་གསལ་པོ་ཞིག་ཞུ་འདོད་བྱུང་།",
    "དེ་བཞིན་ཁོང་ཚོས་མཚམས་བཞག་དགོས་པ་རེད་ལབ་པ་དེ་ད་ལྟའང་གསུངས་པ་རེད།",
    "ཁོང་གིས་ད་བར་གསུངས་པ་རེད།",
    "རྒྱུན་ལས་ནང་དུ་ང་ཚོ་ཐེངས་མང་པོ་ཐུག་པ་རེད།",
    "ཚེ་སོག་ལ་གཅེས་སས་བེད་དགོས་གསུངས་ནས་གོས་ཚོགས་རིམ་པའི་ནང་དུ་གསུངས་ཡོད་པ་རེད།",
    "ད་ལྟ་བར་དུ་རོད་ཡོད་པ་རེད།",
    "ཡིན་ནའང་ད་ལྟ་གོང་དུ་གསུངས་པ་བཞིན་བོད་ནང་དུ་ཡོད་པའི་བོད་མི་ཚོས་ལས་འགུལ་རེ་རེ་སེལ་ཡོང་དུས་བེད་ཐབས་ལས་ཐབས་དེ་མ་གཏོགས།",
    "ཐབས་ལམ་གང་ཡང་མེད་ནས་ལུས་སོག་ལོངས་སོད་དང་བཅས་པ་བོས་གཏོང་གི་ཡོད་པ་རེད།",
    "ཁ་ཤས་ལ་འགོ་གི་མ་རེད།",
    "ཡིན་ནའང་འགོ་ས་དེ་ཚོ་ལ་འགོ་གི་ཡོད་པ་རེད་མ་གཏོགས།",
    "དང་པོ་རྒྱལ་ཁབ་ག་ཚོད་ཅིག་གིས་ང་ཚོ་རྒྱ་ནག་གི་ཆ་ཤས་མ་རེད་ཟེར་ནས་ཁས་ལེན་གི་ཡོད་པ་རེད།",
    "དེ་ལ་རྣ་བར་འགོ་གི་མི་འདུག་ལབ་ན།"
  ]
