    "དེ་ཉིད་རྣམ་པར་རྟོག་པས་ཡོངས་སུ་བསྒྱུར་བ་ཉིད་ལའོ།",
    "རྣམ་པར་གཅད་པར་བྱ་བ་བརྗོད་པ་ནི་གཞན་ཞེས་བྱ་བའོ།",
    "གསལ་བ་དང་ལྷན་ཅིག་གཅིག་ཏུ་ལྷག་པར་ཞེན་པ་ག་ལས་ཡིན།",
    "ངོ་བོ་ཉིད་ནི་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་རྟོག་པ་སྣང་བའི་རིགས་དེ་ལ་ངོ་བོར་སྣང་བ་ཡང་སྟེ།",
    "འོ་ན་དེ་ཅི་ལྟར་འགྱུར་སྙམ་ན་འཁྲུལ་པ་གཅིག་ནས་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་སྤྱིར་དངོས་པོར་འགྱུར་བ་གསལ་ནས་རྣམ་པར་རྟོག་པའི་རྣམ་པ་ལ་དོན་གྱི་རང་བཞིན་ཉིད་ཀྱིས་སྤྱིར་རྣམ་པར་གཞག་སྟེ།",
    "ལྡོག་པར་བྱེད་པ་ཉིད་ཀྱི་མཚན་ཉིད་དེ་ངོ་བོ་ཉིད་གང་ལ་ཡོད་པར་གཞན་ལྡོག་པར་བྱེད་པའི་བདག་ཉིད་ཀྱི་དངོས་པོ་དེ་ཉིད་སྤྱི་ཡིན་ལ།",
    "དེ་སྤྱི་ཐ་དད་པར་སྨྲ་བ་བཞིན་དུ་བུམ་པ་ཡོད་པ་ཞེས་བྱ་བ་ནི།",
    "ཇི་ལྟར་ངོ་བོ་མེད་སྙམ་ན་གཞན་ལ་ལྡོག་པའི་མཚན་ཉིད་ཀྱི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་ན་ཡང་དེ་ནི་སྒྲས་ཤེས་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "རིགས་མི་མཐུན་པ་དེ་ལས་ཞེས་གསུངས་སོ།",
    "འཇུག་པར་ཡང་ཞེས་བྱ་བ་ནི་སྒྲུབ་པར་ཡང་ངོ།",
    "རང་ཉིད་ཅེས་བྱ་བ་ནི་སྒྲའི་བྱེད་པ་མེད་པར་རོ།",
    "དེར་བ་ལང་ཞེས་བྱ་བ་བ་ལང་མ་ཡིན་པ་ལས་ལྡོག་པར་བྱེད་པར་འགྱུར་གྱི།",
    "བ་ལང་ཉིད་སྒྲུབ་པའི་རང་བཞིན་དུ་རྟོགས་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་བ་ནི།",
    "གཞན་མིན་པར་ནི་ལེན་པར་མི་བྱེད་པའོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་ལེན་པར་མི་བྱེད་པའོ།",
    "མ་ཡིན་པ་དགག་པ་ཁོ་ན་ཡིན་པར་མེད་པའི་རང་བཞིན་ནི་མ་ཡིན་ཏེ།",
    "བཀག་པ་ན་ཞེས་བྱ་བ་ནི་རིགས་མི་མཐུན་པ་འགོག་པར་བྱེད་པ་ནའོ།",
    "གལ་ཏེ་གཞན་ལ་མེད་པར་རྟོགས་པ་ན་གཞན་ཡོད་པ་མི་རྟོག་པ་ལ་སོགས་པ་མེད་པ་ཉིད་ལ་གཞན་ལ་གླང་ཡོད་པ་ཉིད་དང་ཡིན་པར་ཇི་ལྟར་འགྱུར།",
    "གལ་ཏེ་རང་བཞིན་མེད་པར་གྲུབ་ན་དེའི་ཚེའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་ན་དོན་དམ་པར་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེས་ན་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་དགོངས་པའོ།",
    "རྣམ་པ་མེད་པའི་བློ་ལ་ཡང་གང་ཅི་སྣང་བ་དེ་ཐམས་ཅད་དོན་དམ་པར་ཡོད་པ་ནི་མ་ཡིན་ཏེ།",
    "དཔེར་ན་ཟླ་བ་གཉིས་ཀྱི་རྣམ་པ་དེ་བཞིན་དུ་སྤྱི་ཡང་ཡིན་པར་འགྱུར་རོ།",
    "ཅིའི་ཕྱིར་དེ་ཁོ་ནར་མེད་པར་རྟོགས་ཤེ་ན།",
    "སྤྱི་འདི་ནི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཞེས་བྱ་བ་ནི་བརྟག་མི་བཟོད་པར་ཡང་ཡོད་པར་ཁས་ལེན་ནའོ།",
    "རིགས་ལྡན་རིགས་མིན་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་ཉིད་དང་གཞན་དག་ཏུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་སྤྱི་དངོས་པོ་མ་ཡིན་ནོ་ཞེས་བརྗོད་ཟིན་པ་ཉིད།",
    "མ་ངེས་པ་ཉིད་ལ་སོགས་པའི་ཉེས་པ་སྤངས་པའི་དོན་དུ་ཟློས་པར་བྱེད་པ་ནི་བརྗོད་བྱ་མ་ཡིན་པའི་ཕྱིར་ཡང་ཞེས་བྱ་བའོ།",
    "ཅིའི་ཕྱིར་ཞེས་བྱ་བ་ལ་བརྗོད་པར་བྱ་བ་ཉིད་མ་ཡིན་པ་ཡང་ཡིན་ལ་དངོས་པོ་མ་ཡིན་པ་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་དྲི་བའི་དོན་ཏོ།",
    "ངོ་བོ་མེད་པར་ཁྱབ་པར་བྱ་བ་བརྗོད་བྱ་མ་ཡིན་པ་ཉིད་ཁྱབ་སྟེ།",
    "དེས་ན་གང་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་དེ་ནི་དངོས་པོ་མ་ཡིན་པ་ཉིད་དོ།",
    "གལ་ཏེ་དངོས་པོ་མ་ཡིན་པའི་གཏན་ཚིགས་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་མ་གྲུབ་བོ་ཞེས་དོགས་པ་བསུ་ནས་སེལ་བ་ནི་གལ་ཏེ་རྟ་ལ་སོགས་པའི་གསལ་བ་ལས་ཐ་དད་པའི་ཕྱིར་ན།",
    "བ་ལང་ཉིད་དེ་དངོས་པོ་འདོད་ན་དེའི་ཚེ་རྣམས་ནི་ཇི་ལྟར་ཡང་བརྗོད་པར་བྱ་བ་ཉིད་མ་ཡིན་པ་མ་ཡིན་ཏེ།",
    "ཁྱབ་པར་བྱ་བ་ཡོད་པའི་ཕྱིར་ཁྱབ་པར་བྱེད་པ་ཡོད་པར་བརྗོད་པ་ནི།",
    "བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་མ་གྲུབ་པོ་ཞེས་བརྗོད་པ་ནི་ཅི་སྟེ་སྤྱི་གཞན་ལས་ཞེས་བྱ་བའོ།",
    "འབྲེལ་པ་ཡོད་ཀྱང་མེ་ལ་ལྟོས་ནས་དུ་བའི་ཡུལ་ཐ་དད་པའི་ཕྱིར་ན་བརྗོད་པར་བྱ་བ་མ་ཡིན་ན་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡུལ་ཅན་ལས་ཐ་དད་པའི་ཡུལ་མེད་པའི་ཕྱིར་དེ་ཐ་མི་དད་པའི་ཕྱིར་རོ་ཞེས་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་པའི་ཡུལ་ཞེས་བྱ་བའོ།",
    "སྣང་བ་ལ་བརྗོད་པ་ནི་ཐ་དད་པར་ནི་ཞེས་བྱ་བའོ།",
    "ཇི་ལྟར་ཐ་མི་དད་པར་མྱོང་བར་འགྱུར་རོ།",
    "ད་ནི་དེའང་མེད་དོ་ཞེས་གསུངས་པ་ནི།",
    "སྤྱི་ནི་སྤྱི་གཞན་ལས་ཐ་དད་པར་བརྗོད་པ་མིན་པ་ཉིད་དོ།",
    "དེ་ལྟ་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཡང་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་བརྗོད་པར་བྱ་བ་ཉིད་ཡིན་ནོ།",
    "ཇི་ལྟར་ཞེ་ན་མེད་པ་ནི་ཞེས་གསུངས་སོ།",
    "སྤྱི་ཡང་མེད་པ་ཉིད་དུ་རྟོགས་པར་འགྱུར་རོ།",
    "འོན་ཏེ་མེད་པ་རྟོགས་པར་མི་ནུས་སོ།",
    "དཔེར་ན་ཞེས་གསུངས་ཏེ།",
    "གསལ་བ་ཉིད་ཡོད་པར་བརྗོད་པ་ནི།",
    "འདས་པ་དང་ཞེས་གསུངས་སོ།",
    "དེས་ན་བུམ་པ་འདས་སོ་ཞེས་བྱ་བ་སྣམ་བུ་འདས་སོ་ཞེས་བྱ་བའི་དོན་དུ་འགྱུར་རོ་ཞེས་རྣམ་པར་རྟོག་པའི་སྒོ་ནས་ལན་འདེབས་པ་ནི།",
    "དེ་ཡང་ཞེས་གསུངས་ཏེ།",
    "འདི་ཉིད་གཉིས་པ་ལ་ཡང་གསུངས་པ་ནི་སྒྲ་ཉེ་བར་འདོགས་པ་ལ་ཡང་ཞེས་གསུངས་ཏེ།",
    "དེ་དང་ལྡན་པར་ཅིས་ཞེས་བྱ་བ་ནི་ལན་ནོ།",
    "ཡོད་པ་ནི་མེད་པ་དང་འབྲེལ་པར་རྟོགས་པ་མ་ཡིན་ནོ་ཞེས་དགོངས་པའོ།",
    "དོན་བྱ་བ་དང་བྲལ་བ་བཞིན་དུ་སྤྱི་མེད་པ་ཡང་རྟོགས་པར་འགྱུར་རོ་ཞེས་དགོངས་པའོ།",
    "དངོས་པོ་ཡང་ཡོད་པར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་འདས་པ་དང་མ་འོངས་པའི་དོན་ཤེས་པའི་དམིགས་པར་ཡོད་པ་ཉིད་ཡིན་ནོ།",
    "ཀུན་རྫོབ་བདེན་པར་ཇི་ལྟར་འགྱུར་ཞེས་བྱ་བའོ།",
    "མེད་པའི་ཞེས་གསུངས་སོ།",
    "ཤེས་པས་དམིགས་པའི་ཕྱོགས་ལ་ཀུན་རྫོབ་མེད་པར་བསྟན་པ་ཡིན་ནོ།",
    "ད་ལྟར་བ་ཙམ་གྱི་ཞེས་གསུངས་སོ།",
    "དངོས་པོ་བརྗོད་བྱར་ཁས་བླངས་ན་ནི་ཉེ་བར་བཏགས་པར་མི་འཐད་དེ།",
    "དངོས་པོ་མེད་པ་བརྗོད་པར་བྱ་བ་ཡིན་ན་ནི་འགྱུར་བ་ཡིན་ནོ།",
    "གལ་ཏེ་བརྗོད་པར་བྱ་བ་ཐ་དད་པ་ཡིན་ན་གཙོ་བོར་འགྱུར་བ་ཡིན་ཏེ་བ་ལང་བ་ལང་ཞེས་བྱ་བ་བཞིན་ནོ།",
    "དེ་མེད་པའི་ཕྱིར་ནི་བཏགས་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "ངོ་བོ་གང་དུ་ཞེས་པ་ནི་སྣང་བ་ཐ་དད་པར་ཏེ་དེ་ལ་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཡང་སྔོན་མཐོང་བ་སྒྲོ་འདོགས་པར་ནུས་པ་བསུ་བ་ནི།",
    "སྔོན་མཐོང་བ་སྒྲོ་འདོགས་པར་ཁས་བླངས་ཀྱང་ཇི་ལྟར་འདས་པ་ལ་དེའི་ངོ་བོར་རྟོགས་པ་ཉིད་ད་ལྟར་སྒྲོ་བཏགས་པ་ཡིན་པ་དེ་བཞིན་དུ་འདས་པ་མ་ཡིན་པ་ལ་ཡང་འགྱུར་ལ་དེ་ལྟ་ན་ཡང་སྤྱི་དོན་དམ་པར་མི་འགྱུར་རོ་ཞེས་ལན་བརྗོད་པ་ནི།",
    "དེ་ལྟ་མ་ཡིན་ན་ཞེས་བྱ་བ་ནི་སྔོན་མཐོང་བ་སྒྲོ་འདོགས་པ་མེད་པར་རོ།",
    "གལ་ཏེ་རྗེས་སུ་དཔག་པས་གཟུང་བ་དོན་དམ་པ་མ་ཡིན་པ་ཡང་མངོན་སུམ་གྱིས་གཟུང་བ་ནི་དོན་དམ་པར་འགྱུར་རོ་ཞེས་དོགས་པ་བསུ་བ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "དེ་འདི་ཡིན་ནོ་སྙམ་པ་ནི་རྣམ་པར་རྟོག་པ་ཡིན་པའི་ཕྱིར་དང་རྒྱང་རིང་པོའི་རབ་རིབ་ལ་སོགས་པ་ལྟར།",
    "འོན་ཀྱང་རྣམ་པར་རྟོག་པ་དང་བཅས་པ་ཉིད་དོ།",
    "དེས་ན་ཇི་ལྟར་དེའི་ཡུལ་ཅན་མངོན་སུམ་དུ་གྱུར་ཅེས་བརྗོད་པ་ནི་ཁྱད་པར་ཞིག་ཀྱང་ཞེས་བྱ་བའོ།",
    "འདས་པར་སྣང་བ་དང་ལྷན་ཅིག་ད་ལྟར་བ་ཐ་མི་དད་པར་ནི་མངོན་སུམ་གྱིས་རྟོགས་པ་མེད་དོ་ཞེས་བརྗོད་པ་ནི།",
    "དེ་སྐད་དུ་ཡང་ཅིག་ཤོས་ནི་ཞེས་འཆད་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་ཞེས་ནི་མ་འཁྲུལ་པར་རོ།",
    "སྐབས་སུ་བབ་པ་ལ་ཡང་གཉི་ག་དེ་ལྟ་བུ་ཉིད་དོ་ཞེས་གསུངས་པ་ནི་འདིར་ཞེས་བྱ་སྟེ།",
    "སྒྲ་ཞེས་བྱ་བ་ནི་དངོས་པོ་མེད་པར་བརྗོད་པའོ།",
    "བུམ་པ་ཞེས་བྱ་བའི་སྒྲ་ནི་འདས་པའམ་མ་འོངས་པ་ལ་ཐ་དད་པར་འཇུག་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྟོགས་པ་ཉིད་ལས་ཞེས་བྱ་བ་ནི་དོགས་པ་བསུ་བ་སྟེ་རྟོགས་པར་བྱ་བ་ལས་སོ།",
    "དེ་ལྟར་འགྱུར་བས་ཞེས་བྱ་བ་ནི་ཡོད་པར་འགྱུར་བའོ།",
    "དེའི་ཕྱིར་མེད་པ་ལ་འཇུག་པར་འཐད་དོ་ཞེ་ན།",
    "འདས་པ་ལ་སོགས་པ་ཞིག་པར་མ་ཤེས་པ་ལའོ།",
    "ཁྱད་པར་མ་བཟུང་བ་ནི་ཐ་དད་པའི་བློར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "འོན་ཏེ་ཁྱད་པར་མ་བཟུང་ཡང་རྟོགས་པ་ཐ་དད་པ་ཡོད་པ་ཉིད་དོ་སྙམ་དུ་དོགས་པ་བསུ་ནས་གང་ལས་ཞེས་གསུངས་ཏེ།",
    "འདས་པའི་ཁྱད་པར་ལའོ།",
    "དེ་ལ་དངོས་པོ་འཛིན་པར་མི་འཐད་དོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "ཐ་དད་པར་བསྒྲུབ་པར་བྱ་བ་དུས་ཐ་དད་པར་ནི་མ་ངེས་པ་ཡིན་ནོ་ཞེས་ལན་འདེབས་པ་ནི་དེ་ཡང་ཞེས་བྱ་བའོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་དོན་ཡོད་ཉིད་ལའང་ཞེས་གསུངས་སོ།",
    "ཅི་སྟེ་དེ་ལྟར་གྲུབ་པར་ཡོད་སྙམ་ན་ཇི་ལྟར་ཁྱེད་ཀྱི་ཞེས་བྱ་བའོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་རྗེས་སུ་དཔག་པ་ཡང་ཞེས་གསུངས་སོ།",
    "རྟགས་ཀྱི་ཁྱད་པར་ལས་བདེན་པའི་དོན་ཅན་དང་ཅིག་ཤོས་ཀྱི་རྣམ་པར་དབྱེ་བ་དོགས་པར་བྱེད་པ་ནི་རྟགས་ཀྱི་ཁྱད་པར་ལས་ཞེས་བྱ་བའོ།",
    "འདི་ཉིད་རྣམ་པར་འབྲེལ་པ་ནི་འདི་ལྟར་ཞེས་བྱ་བའོ།",
    "རྩ་བ་ལས་བྱུང་བ་ལ་སོགས་པའི་རྣམ་པ་གཞན་ལ་ཐེ་ཚོམ་མེད་པར་འགྱུར།",
    "རྟོགས་པ་ཉིད་ལ་ནི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་རྣམ་པར་རྟོག་ནས་རིམ་བཞིན་སེལ་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྣམ་པར་རྟོག་པ་གཉིས་བྱས་ནས་དང་པོ་སེལ་བ་ན།",
    "དེའི་ཁྱད་པར་ནི་མ་མཐོང་བ་ལ་དེ་མཐོང་བར་འདོད་པ་ཐེ་ཚོམ་དུ་འགྱུར་བལ་མཐོང་བ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "ཁྱད་པར་མངོན་སུམ་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་འདིའི་དོན་འདྲི་བ་ནི་ཁྱད་པར་མངོན་སུམ་ནི་གང་དེའི་ཞེས་བྱ་བའོ།",
    "མངོན་སུམ་བཀག་པ་ཙམ་ཞིག་ཡིན་པར་འགྱུར།",
    "གལ་ཏེ་ཁྱད་པར་དྲན་པ་ནི་དམིགས་པ་དང་བཅས་པ་ཉིད་དུ།",
    "དེ་ལ་ཡང་ཞེས་བྱ་བ་ནི་ཁྱད་པར་དྲན་པ་ལ་ཡང་ངོ།",
    "བཟློག་པར་ཡང་ནི་དམིགས་པ་དང་བཅས་པར་རོ།",
    "ཁྱད་པར་གང་ལས་ཞེས་བྱ་བ་ནི་སྡོང་གྲུ་ལ་སོགས་པ་ལའོ།",
    "དེ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གྱི་རང་བཞིན་ནོ།",
    "དེ་ཁོ་ན་ལྟར་ཞེས་བྱ་བ་ནི་མཐོང་བ་ཉིད་ལས་མ་འདས་པར་རོ།",
    "མཐོང་བ་དང་མ་མཐོང་བ་ལ་ཡང་ཐེ་ཚོམ་དུ་མི་འགྱུར་བ་ཞེས་བྱ་བའི་ཉེས་པར་ཇི་ལྟར་ཟེར་བའི་ཕྱིར་ཇི་ལྟར་ཉེས་པར་མི་འགྱུར་ཞེས་དོགས་པ་ལ།",
    "ཐེ་ཚོམ་ཞེས་བྱ་བ་ནི་ཐེ་ཚོམ་གྱི་ཡུལ་ཡིན་པ་ནི་དེ་ལྟ་བུར་གྱུར་པ་ནི་གཉི་གའི་རྣམ་པར་གྱུར་པའོ།",
    "འོ་ན་ཇི་ལྟར་འཇིག་རྟེན་ཡིན་པ་ཐེ་ཚོམ་གྱི་དོན་ཡིན་པར་འགྱུར་རོ་སྙམ་ན།",
    "འཇིག་རྟེན་པ་མ་ཡིན་པ་ཉིད་ཁས་ལེན་ན་ཤེས་པ་ཉིད་དུ་ཁས་བླངས་པར་འགྱུར་རོ་ཞེས་བརྗོད་ཟིན་ལ།",
    "སྣང་བ་མེད་པས་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གཉི་ག་གསལ་བ་མེད་པས་སོ།",
    "མཐོང་བ་ཉིད་ནི་ཞེས་གསུངས་སོ།",
    "དཔེ་གསུངས་པ་ནི་མངོན་སུམ་ལ་ནི་ཞེས་གསུངས་ཏེ།",
    "གཡོ་བ་ཡིན་ན་ཞེས་གསུངས་སོ།",
    "མཐོང་བ་ཡིན་ཞེས་བྱ་བ་དེ་ནི་རྣམ་པར་འབྲེལ་པ་ན་ལན་འདེབས་པར་ནི་ཞེས་བྱ་བའོ།",
    "འདི་ཉིད་བསྒྲུབ་པའི་དོན་དུ་རྣམ་པར་རྟོག་པར་བྱེད་པ་ནི་ཅི་འདི་ཞེས་བྱ་བའོ།",
    "མཐོང་བ་ལ་ཡང་གཡོ་བ་ཡོད་པར་དོགས་པ་བསུ་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "རྣམ་པ་གཞན་གྱི་ཞེས་བྱ་བ་ནི་སྐད་ཅིག་ཉིད་དམ་ཐག་རིང་ནས་ཁྱད་པར་ལའོ།",
    "ཐག་རིང་པོ་ནས་ཁྱད་པར་གྱི་ཆ་མ་མཐོང་བ་ལ་ཡང་ངོ།",
    "གལ་ཏེ་མཐོང་བ་དང་རྗེས་སུ་དཔག་པར་བྱ་བ་དག་ཐ་མི་དད་པའི་ཕྱིར་ན།",
    "མཐོང་བ་ཉིད་དཔག་བྱ་ཡིན་ཞེས་གསུངས་སོ།",
    "དེ་བས་ན་མཐོང་བས་ནི་གཡོ་བ་མ་ཡིན་ནོ་ཞེས་རྣམ་པར་གནས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་དོན་བཞིན་དུ་སྣང་བ་ལ་ཡང་རྗེས་སུ་དཔག་པ་ཇི་ལྟར་མི་གཡོ་སྙམ་ན་སྣང་བ་ལ་ནི་ཞེས་གསུངས་སོ།",
    "ཕྱི་རོལ་གྱི་དངོས་པོ་ལ་ལྟོས་ནས་ཞེས་གསུངས་སོ།",
    "མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་ལ་སོགས་པའི་དབྱེ་བ་རྣམ་པར་རིག་པ་ལ་ལྟོས་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "གཞན་གྱིས་འགྱུར་ཏེ་ཞེས་སྨྲས་ཏེ་བདེན་པར་ཞེས་འབྲེལ་ཏོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རབ་རིབ་ཅན་གྱི་ཞེས་གསུངས་སོ།",
    "ཇི་ལྟར་ཡུལ་མེད་པར་འགྱུར་སྙམ་ན།",
    "དེ་ནི་དེའི་ཚེ་ཞེས་གསུངས་སོ།",
    "འདི་ག་ལས་ཤེ་ན་འདི་ལྟར་དེ་ལས་ཞེས་གསུངས་སོ།",
    "མེད་པ་ལ་ཡང་ཞེས་བྱ་བ་ནི་དངོས་པོའི་རང་བཞིན་མ་ཡིན་པ་འཛིན་པར་མཚུངས་པའོ།",
    "མངོན་སུམ་གྱི་བློ་ནི་ཞེས་གསུངས་སོ།",
    "རྗེས་སུ་དཔག་པ་ཐམས་ཅད་བཏགས་པར་འགྱུར་རོ་ཞེས་ལན་འདེབས་པ་ནི་རྗེས་སུ་དཔག་པ་ཞེས་བྱ་བའོ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་ཕྱིན་ཅི་ལོག་ཏུ་ཞེས་གསུངས་སོ།",
    "མེད་པ་རྗོད་པར་བྱེད་པའི་མཉན་པ་དེ་ནི་གྲངས་ཅན་གྱི་སྐྱེས་བུ་ཞེས་ནུས་པ་མེད་པའི་དངོས་པོ་ལ་ཡང་བྱེད་ལ་གཙོ་བོའི་སྒྲ་ནི་འབྲས་བུ་དུ་མ་ནུས་པ་ལ་ཡང་བྱེད་པ་ཡིན་ནོ།",
    "མེད་པའི་ཡུལ་ཅན་ལ་ཡང་དངོས་པོ་ཉིད་ཡིན་པར་བརྗོད་པ་ནི་རྟོགས་པ་ཅི་བཞིན་ཉིད་ཅེས་བྱ་བའོ།",
    "གྲངས་ཅན་གྱི་རྟོགས་པ་དང་རྗེས་སུ་མཐུན་པའི་དངོས་པོ་མེད་ཀྱང་གཙོ་བོ་ལ་སོགས་པའི་མཉན་པར་བྱེད་པ་བཞིན་ཞེས་འབྲེལ་ཏོ།",
    "ལྷག་པར་སྒྲོ་བཏགས་ན་གཙོ་བོ་དང་སྐྱེས་བུ་ལ་སོགས་པའི་སྒྲ་རྣམས་འཇུག་པས་ན་དངོས་པོ་མ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་བ་ནི་ཅི་སྟེ་གཞན་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་དངོས་པོ་ལ་ཡང་གཙོ་བོ་ལ་སོགས་པ་ལྷག་པར་སྒྲོ་བཏགས་པ་ནི་མེད་པའི་ཡུལ་ཅན་ཉིད།",
    "རྗེས་སུ་དཔག་པས་ཞེས་གསུངས་སོ།",
    "བུམ་པ་ལ་སོགས་པའི་སྒྲ་ནི་ཉེ་བར་བཏགས་པ་འཁྲུལ་པར་རྟོགས་པའི་ཡུལ་ཉིད་ཀྱང་འདས་པ་ལ་སོགས་པ་ལ་ནི་མེད་པ་ཉིད་དོ་ཞེས་བརྗོད་པ་ནི་དེའི་ཕྱིར་ཞེས་བྱ་བ་སྟེ།",
    "དེ་བྱས་པའི་ཁྱད་པར་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་འདས་པ་དང་མ་འོངས་པ་ལ་ནི་བློ་འཁྲུལ་པ་མེད་པར་འཇུག་པ་དེ་ཉིད།",
    "འབའ་ཞིག་འཛིན་པར་ཁས་བླངས་ནས་སུན་འབྱིན་པར་བརྗོད་པ་དེ་ནི་སྤྱི་ཙམ་ཞིག་ཅེས་བྱ་བའོ།",
    "གལ་ཏེ་ཐ་དད་པ་དང་འབའ་ཞིག་པ་བཟུང་ན་ནི་སྤྱི་མ་ཡིན་པར་འགྱུར་རོ།",
    "དེ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་མེད་འཛིན་པའོ།",
    "གསལ་བ་རྣམས་ཀྱི་རང་བཞིན་ནི་ཕན་ཚུན་བཟློག་པར་འདོད་པ་ཡིན་ཏེ།",
    "ལྡོག་པ་མ་ཡིན་པ་ཉིད་དུ་ནི་རྟོགས་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "ཞེས་གསུངས་སོ།",
    "གསལ་བ་མེད་པར་གྱུར་ན་སྤྱི་མེད་དེ་མཚུངས་པ་རྣམས་ཀྱི་ངོ་བོ་ནི་སྤྱི་ཡིན་ནོ་ཞེས་གྲུབ་པའི་མཐའ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཐ་དད་པར་ཁས་བླངས་ཀྱང་སྤྱི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་རྣམ་པར་རྟོག་པ་དང་ལྷན་ཅིག་པས་ནི་དམིགས་པར་འགྱུར་རོ་ཞེས་དོགས་པ་ནི་འོན་ཏེ་གསལ་བ་ཞེས་བྱ་བའོ།",
    "འདི་ཞེས་བྱ་བ་ནི་སྤྱི་དང་ཁྱད་པར་གྱི་ཤེས་པའོ།",
    "འོན་ཀྱང་སྔོན་པོ་དང་སེར་པོ་དག་ཤེས་པ་ལས་སམ་ཕན་ཚུན་ཐ་དད་པར་རྟོགས་ཏེ་སྔོན་པོ་མཐོང་ངོ་ཞེས་བྱ་བར་རོ།",
    "འདི་ནི་དེ་ལྟ་མ་ཡིན་ནོ་ཞེས་ཐ་དད་པར་རིགས་པར་འགྱུར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་དོ་ཞེ་ན།",
    "ཕྱོགས་གཉིས་ལ་ཡང་རྣམ་པར་རྟོག་པ་གཉིས་ཏེ་ཚིག་གམ་རྟགས་ལས་རྟོགས་པར་བྱ་བ་ཡིན་ཞེས་བྱ་བའོ།",
    "ཐ་དད་པར་དང་ཞེས་གསུངས་སོ།",
    "སྐབས་སྡུད་པར་བྱེད་པ་ནི་སྤྱི་གཞན་ཉིད་ནི་ཞེས་བྱ་བའོ།",
