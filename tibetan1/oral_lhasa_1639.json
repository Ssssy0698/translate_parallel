    "བརྡའི་རྗེས་སུ་འགྲོ་བ་མེད་པར་སྒྲ་ལས་དོན་རྟོགས་པ་མི་སྲིད་དོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "བརྡ་མེད་པར་ནི་ཞེས་བྱ་བའོ།",
    "བརྡ་མེད་པར་ནི་གང་དུ་ཡང་སྒྲ་རྗོད་བྱེད་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དངོས་གཉིས་མཐོང་ལ་ཞེས་བྱ་བའི་རྣམ་འགྲེལ་ཉེ་བར་བཀོད་པ་ཁོ་ནར་འཆད་པ་ནི་སྒྲ་མེད་པར་ཡང་ཞེས་བྱ་བའོ།",
    "སྒྲ་མེད་པར་ཡང་ཞེས་བྱ་བར་ནི་བརྡ་ལ་མི་ལྟོས་པར་སྤྱིར་བློར་འགྱུར་རོ་ཞེ་ན་ལན་དེར་ཡང་ཞེས་བྱ་བ་སྟེ།",
    "དེ་ལྟ་ན་ནི་འོ་ན་བརྡ་ལ་མི་ལྟོས་སོ་ཞེས་བྱ་བར་བརྗོད་པ་ནི་རིགས་སོ་ཞེས་དོགས་པ་བསུ་ནས་བརྡ་སྨོས་པ་ནི་ཞེས་གསུངས་སོ།",
    "ཅི་ལྟར་བ་ལང་ཉིད་ལ་སོགས་པའི་རིགས་རྟགས་དང་བརྡ་ལ་སོགས་པས་བསྐྱེད་པའི་ཤེས་པ་ལ་རྟོགས་པར་བྱ་བ་ལ་ཡིན་པ་དེ་བཞིན་དུ་བྲམ་ཟེ་ཉིད་ལ་སོགས་པའི་རིགས་ཀྱང་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི་དེ་བཞིན་དུ་གསལ་བྱ་ལ་སོགས་པ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་བརྡ་དང་ལྷན་ཅིག་པའི་མངོན་སུམ་ནི་རིགས་ཀྱིས་གྲུབ་པར་བྱེད་པ་མ་ཡིན་པ་དེས་ན།",
    "ཁྱབ་པར་བྱེད་པ་འགལ་བ་དམིགས་པས་དངོས་པོ་ཡུལ་ཅན་མ་ཡིན་པ་ཉིད་དུ་བརྗོད་པ་ནི་བརྡ་ཙམ་ལ་ལྟོས་པ་ནི་ཞེས་བྱ་བའོ།",
    "མཐོང་བ་ལ་ནི་ཞེས་གསུངས་སོ།",
    "བྲམ་ཟེ་ཉིད་ནི་རིགས་ནི་མི་འགྱུར་ཞེས་བྱ་བ་ཇི་ལྟར་ཞེ་ན་དེ་ནི་དེ་ལྟར་ཞེས་གསུངས་ཏེ་བྲམ་ཟེ་ཉིད་དེ་ནི་བརྡ་མེད་པར་བཏགས་པའི་ཕྱིར་རོ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "དེའི་གསལ་བྱེད་གསལ་སྣང་བ་ཡིན་པར་ཇི་ལྟར་རྟོགས་ཤེ་ན།",
    "བསྟན་པ་མེད་པར་ཞེས་བྱ་བའོ།",
    "སྒྲ་གཅིག་འཇུག་པར་བྱ་བའི་དོན་དུའོ་ཞེ་ན།",
    "གོང་དུ་སྤོང་སོགས་ཞེས་གསུངས་སོ།",
    "རིགས་མེད་པར་ཡང་འགྱུར་རོ་ཞེས་པའོ།",
    "བློ་གཅིག་པ་ལས་མ་གཏོགས་པར་ནི་མཚུངས་པའི་རྣམ་པ་ཉིད་ལ་དམིགས་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་མིག་ལ་སོགས་པ་དཔེ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི་དེ་ནི་ཞེས་གསུངས་ཏེ་བློ་གཅིག་བསྐྱེད་པའོ།",
    "འདི་སྙམ་དུ་མིག་ལ་སོགས་པ་ལ་ཡང་བློ་གཅིག་སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱི་སྤྱི་ཡོད་པ་ཁོ་ནའོ།",
    "དེས་ན་མེད་པར་བསྒྲུབ་པ་ལ་དེ་དག་དཔེ་ཉིད་དུ་ཇི་ལྟར་འགྱུར་ཞེས་དོགས་པ་བསུ་བ་ནི་དེ་དག་ལ་ཡང་ཞེས་བྱ་བའོ།",
    "སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱང་བློ་གཅིག་སྐྱེད་པ་ལས་གཞན་ནི་མེད་དོ་ཞེས་ལན་འདེབས་པ་ནི་ཁྲ་བོ་ལ་སོགས་པ་ལ་ཡང་ཞེས་བྱ་བའོ།",
    "བློ་གཅིག་བསྐྱེད་པ་ཉིད་སྤྱི་ཡིན་ནོ་སྙམ་པར་དོགས་པ་ནི་གལ་ཏེ་དེ་ཉིད་ཅེས་བྱ་བའོ།",
    "རྣམ་པར་འབྱེད་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་ངེས་པའི་གསལ་བས་གསལ་བར་བྱེད་པ་ཉིད་དང་རྟེན་དུ་བྱེད་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གསལ་བའི་རྒྱུ་ནི་ནུས་པ་ཉིད་ལས་རྣམ་པར་དབྱེ་བ་ཡིན་པའི་ཕྱིར་ཐུག་པ་མེད་པ་མ་ཡིན་ནོ་ཞེས་དོགས་པ་མེད་པ་བསུ་བ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་ཐ་དད་པ་རྣམས་ཀྱི་བློ་གཅིག་བསྐྱེད་པ་ཉིད་དུ་བཟློག་པར་བྱ་བ་མ་ཡིན་གྱི།",
    "མི་དམིགས་པ་མ་གྲུབ་པར་བརྗོད་པ་ནི་འབྲས་བུའི་སྒོ་ནས་ཀྱང་ཞེས་བྱ་བ་ནི་ལན་ནོ།",
    "མིག་ལ་སོགས་པ་བག་ཆགས་ཀྱི་ཁྱད་པར་ཡིན་པའི་ལུགས་བརྗོད་པ་ནི་གང་ཞིག་ཅེས་བྱ་བའོ།",
    "ཇི་ལྟ་ཞེ་ན་འབའ་ཞིག་པ་ཞེས་གསུངས་སོ།",
    "སྤྱི་འབའ་ཞིག་པ་མ་མཐོང་བ་དེ་དེའི་རང་བཞིན་ཉིད་ལས་ཉམས་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "གཟུགས་ནི་སྣང་བ་མེད་ཀྱང་དམིགས་པར་འགྱུར་གྱི།",
    "གསལ་བ་མེད་པར་ནི་སྤྱི་དམིགས་པ་མེད་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "གཟུགས་དང་རོ་ལ་སོགས་པ་ཡང་ཡུལ་གཅིག་པའི་ཕྱིར་ཐ་དད་དམིགས་པར་མི་འགྱུར་བ་ཞིག་མ་འགྱུར་བ་ཡང་ཡིན་ཏེ།",
    "ཤིན་ཏུ་འདྲེས་པ་ན་གང་ཞིག་གང་དང་ཡུལ་གཅིག་པ་ཞེས་ཁྱད་པར་དུ་བྱེད་པའི་ཕྱིར་མ་ངེས་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་བ་ནི།",
    "ཅིག་རང་བཞིན་འདྲེས་པར་གྱུར་ཏམ་དེ་མ་འདྲེས་པ་ཉིད་དོ།",
    "དེས་ན་ཁྱད་པར་མེད་པ་ཉིད་དུ་ཡུལ་གཅིག་པའི་གཏན་ཚིགས་རྒྱུ་ཡིན་པས་ད་ནི་དེ་ལ་དངོས་པོ་ཉིད་ཀྱང་མ་ངེས་པ་ཉིད་དུ་ཡང་བརྗོད་པ་ནི།",
    "ཡུལ་ཙམ་མ་གྲུབ་པ་ནི་ཤིན་ཏུ་གསལ་བར་དེའི་ཁྱད་པར་མ་གྲུབ་པོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དངོས་པོ་ལས་ཐ་དད་པར་ཞེས་བྱ་བ་ནི་འཆད་པའོ།",
    "ཡུལ་ཐ་དད་པ་ཡིན་དུ་ཟིན་ཀྱང་དེ་ལྟ་ན་ཡང་དེ་ཐ་དད་པ་ནི་འདིར་མ་གྲུབ་པོ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་ན་ཐུག་པ་མེད་པར་འགྱུར་རོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "རྣམ་པར་རྟོག་པ་དང་གཞན་པའི་ཤེས་པ་ཙམ་གྱི་དོན་བྱ་བ་ལ་ཡང་སྤྱི་དེ་རུང་བ་མ་ཡིན་ནོ།",
    "དེ་མི་རུང་ཕྱིར་ཞེས་གསུངས་སོ།",
    "དེ་ལ་ཡང་ཞེས་གསུངས་ཏེ།",
    "དེ་ཉིད་དང་གཞན་དག་ཏུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "ཤེས་པ་ཙམ་གྱི་དོན་བྱེད་པར་ཡང་མི་རུང་བའི་ཕྱིར་ན་སྤྱིར་མཚན་ཉིད་དོ།",
    "བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་ནི།",
    "ཐ་སྙད་ལས་ཞེས་གསུངས་ཏེ།",
    "རྣམ་པར་དབྱེ་བ་མེད་པར་འཇུག་པ་ལས་དེ་ལྟར་ཞེས་བྱ་བས་སྤྱི་ཉིད་དུ་བརྗོད་པ་ཡིན།",
    "གལ་ཏེ་རྣམ་པར་དབྱེ་བ་མེད་པར་འཇུག་པ་ལ་ཡང་ཇི་ལྟར་ཏེ་གསལ་བ་དུ་མའི་ཞེས་གསུངས་སོ།",
    "འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "རྟགས་ཀྱི་དབྱེ་བ་སྒྲུབ་པར་བྱེད་པ་ནི་མངོན་སུམ་ཉིད་ཡིན་པས་ཡུལ་གྱི་བྱེ་བས་ཅི་བྱ་བ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་སྤྱི་ལ་ཞེས་དབྱེ་བ་མེད་ན་འོ་ན་ནི་ཡུལ་གྱི་དབྱེ་བས་བརྟགས་པ་ཐ་དད་པར་མི་འགྱུར་རོ་ཞེས་དོགས་པ་བསུ་ནས་དངོས་པོ་དང་།",
    "དངོས་པོ་མེད་པ་དང་གཉིས་ཀ་ལ་བརྟེན་པའི་སྒོ་ནས་ཞེས་གསུངས་སོ།",
    "རྟགས་གོ་ཅི་ལྟར་ཞེ་ན་དེ་བྱེད་པ་ཉིད་ཀྱིས་ཞེས་གསུངས་སོ།",
    "ཐ་དད་པ་ནི་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དངོས་པོ་མེད་པའི་ཡིན་ན་ནི་ཐ་དད་པར་མི་འགྱུར་ཏེ།",
    "གཞན་གྱི་རང་བཞིན་ཡིན་ཡང་ཐ་དད་པར་མི་འགྱུར་ཏེ་ཤིང་ཤ་པ་ལས་ཤིང་ཉིད་བཞིན་ནོ།",
    "ཐ་དད་པ་ན་ཡང་དེའི་ཉེ་བར་ལེན་པ་ཅན་གྱི་རྣམ་པར་རྟོག་པ་གཉིས་པའི་ཉེ་བར་ལེན་པ་ཅན་ཁོ་ན་ཡིན་ནོ།",
    "བསྒྲུབ་པར་བྱ་བ་ཐ་དད་པ་ཡང་ཞེས་བྱ་བའོ།",
    "དངོས་པོ་གཉིས་ནི་ཞེས་གསུངས་སོ།",
    "སྣང་བ་ནི་འགྱུར་བ་ཡིན་ན་དེ་ལྟར་ན་ནི་སྤྱི་དངོས་པོ་ཡིན་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "དེའི་ཚེ་དངོས་པོ་ཤེས་པར་འགྱུར་གྱི་དངོས་པོ་མེད་པའི་སྤྱི་ནི་ཤེས་པར་མི་འགྱུར་རོ།",
    "རྣམ་པར་རྟོག་པའི་རྣམ་པར་ཤེས་པ་ཡང་དངོས་པོ་ལ་བརྟེན་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "ཤེས་པ་ཙམ་གྱི་དོན་བྱེད་པར་ཡང་མི་རུང་ངོ་ཞེས་བྱ་བ་དང་།",
    "རྣམ་པ་གཞན་དུ་ཞེས་བྱ་བ་སྟེ་སྤྱི་མེད་པར་ཡང་ངོ།",
    "རྣམ་པར་རྟོག་པའི་རྣམ་པར་ཤེས་པ་དེའོ།",
    "སྤྱིའི་རང་བཞིན་མ་ཁྱབ་པར་གྱི་རང་བཞིན་ནོ།",
    "རྣམ་པར་རྟོག་པའི་རྣམ་པར་ཤེས་པ་ལའོ།",
    "དེ་ལྟར་འཁྲུལ་པ་ཙམ་དུ་རྟོགས་པ་ཡིན་ནོ་ཞེས་རྗེས་སུ་འཇུག་པར་བྱ་བའོ།",
    "ལན་བཏབ་པའི་ཕྱིར་དང་ཞེས་བྱ་བས་ནི་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་རྟོག་པའི་རྣམ་པར་ཤེས་པ་ལའོ།",
    "སྤྱི་ཞེས་བྱ་བ་ནི་ཞེས་གསུངས་སོ།",
    "དོན་དམ་པར་ཞེས་གསུངས་སོ།",
    "དེ་ཉིད་ཡོད་པ་དང་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་དཔྱོད་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "རྩོད་པ་སྨྲ་བ་ཉིད་ཀྱིས་འོན་ཏེ་ཡུལ་གཅིག་ཡིན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པས་དོགས་པ་བསུ་བ་ནས་གཞལ་བྱ་དོན་མེད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི་དེ་ལྟ་ཡིན་ན་ཞེས་བྱ་བའོ།",
    "སྔོན་པོ་ལ་སོགས་པ་ཞེས་གསུངས་སོ།",
    "མཐའ་ཡས་པ་ཉིད་ཡིན་ན་ཇི་ལྟར་རྣམ་པ་གཉིས་ཡིན་སྙམ་ན་འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་ཡང་ཐ་དད་ན་ནི་བརྟགས་པ་ཁོ་ནར་འགྱུར་ཞེས་གསུངས་པའོ་ནི་ལྟོས་པས་བྱས་པའི་ཞེས་བྱ་བའོ།",
    "འཇུག་པར་འགྱུར་རོ།",
    "མཚན་ཉིད་མིན་པར་འགྱུར་ཞེས་བྱ་བ་ནི་ཐ་དད་པའི་ཞེས་བྱ་བས་ཁ་བསྐང་ངོ།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བས་དོན་དམ་པའི་མཚན་ཉིད་གསུངས་པ་ནི།",
    "དེ་ལས་བཟློག་པས་དམིགས་པ་ཉིད་ཡོད་པ་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ནོ་ཞེས་ལན་བརྗོད་པ་ནི་དམིགས་པ་ཉིད་ནི་དངོས་པོ་རྣམས་ཀྱི་དོན་དམ་པའི་ཡོད་པ་ཡིན་ནོ་ཞེས་རྣམ་པར་གཞག་སྟེ་བཟློག་པས་དོན་དམིགས་པས་ནི་མེད་པ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་རོ།",
    "ཅི་ཞིག་ཅེས་བྱ་བའི་དྲི་བ་སྔོན་དུ་བཏང་བ་ཅན་མི་དམིགས་པ་ཉིད་རྣམ་པ་གསུམ་དུ་རྣམ་པར་རྟོག་པ་ནི་དམིགས་པ་མེད་པ་ཡིན་ནམ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཅིའི་ཕྱིར་མི་རྟོགས་སྙམ་དུ་དོགས་པ་བསུ་བ་ནས་ཇི་ལྟར་དམིགས་པར་བྱ་བ་མེད་པར་ནི་དམིགས་པར་བྱ་བ་མ་ཡིན་པ་དེ་བཞིན་དུ་དམིགས་པ་མེད་པ་ཡང་དམིགས་པ་མ་ཡིན་པ་ཉིད་དོ་ཞེས་བརྗོད་པ་ནི།",
    "གལ་ཏེ་དོན་བཞིན་དུ་ཤེས་པ་ལ་ནི་དམིགས་པ་གཞན་མེད་པ་དེ་ན་དེ་མེད་པས་དམིགས་པ་མེད་པ་རྟོགས་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་ཐུག་པ་མེད་པར་འགྱུར་སྙམ་དུ་དོགས་པ་བསུ་བ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "ཡོད་པར་མ་རྟོགས་ན་ཉེས་པ་ཅི་ཡོད་སྙམ་ན།",
    "ཡང་དོན་གྱིས་གོ་བས་ཞེས་བྱ་བ་ནི་དེ་ལྟར་དོན་གྱིས་གོ་བའི་བློ་གཞན་དང་གཞན་གྱིས་གཞན་དང་གཞན་བསྒྲུབ་པར་བྱ་བ་ཡིན་པས་ན།",
    "དེའི་ཕྱིར་ཤེས་པ་ལྐོག་ཏུ་གྱུར་པར་ཞེས་བྱ་བར་ནི་མི་འཐད་དེ།",
    "གལ་ཏེ་རིགས་པ་རྣམས་ནི་ཅི་ལྟར་ཤེས་པ་གཞན་གྱིས་མངོན་སུམ་དུ་བྱེད་པ་ཡིན་ན་དེའི་ཚེ་དེ་མེད་ཀྱང་དམིགས་པ་མེད་པ་གཞན་གྱིས་རྟོགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ན།",
    "དེ་ཞེས་བྱ་བ་ནི་མངོན་སུམ་དུ་གྱུར་པའི་བློ་བཞིན་མེད་པར་རྟོགས་པ་ལའོ།",
    "ངོ་བོ་མེད་པར་ཁྱད་མེད་པའི་ཕྱིར་རོ།",
    "དེ་མེད་པར་རྟོགས་པ་ལ་ཐུག་པ་མེད་པས་མ་གྲུབ་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་བ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "ཇི་ལྟར་དོན་ཡོད་པར་འགྱུར་བ་དེ་བཞིན་དུ་དམིགས་པ་ཡང་ཡོད་པར་འགྱུར་རོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "མ་གྲུབ་པ་ཉིད་ཀྱི་ཉེས་པས་བཏང་སྙོམས་སུ་བྱས་ཏེ།",
    "མ་ངེས་པ་ཉིད་བརྗོད་པར་རྟོགས་པར་བྱའོ།",
    "དེས་ན་དངོས་པོ་མེད་པ་ཐ་དད་པར་སྨྲ་བ་རྣམས་ཀྱི་ལྟར་ན།",
    "དེ་ལྟ་ན་དངོས་པོ་དང་དམིགས་པ་དག་ཀྱང་དེའི་བདག་ཉིད་དུ་གྲུབ་པར་འགྱུར་རོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "ཤེས་པ་གཅིག་ལ་བདེ་བ་དམིགས་པས་ཀྱང་དེ་ལས་གཞན་དམིགས་པ་མེད་པར་ངེས་པར་བྱེད་པ་ཡིན་ཏེ་མ་འདྲེས་པའི་ཕྱིར་རོ།",
    "དགག་པར་བྱ་བ་དེའོ།",
    "འོན་ཀྱང་དགག་པར་བྱ་བ་གཞན་ལས་འཇུག་པ་མེད་པའོ།",
