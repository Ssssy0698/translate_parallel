    "དམིགས་པར་བྱ་བ་ཉིད་དོ་ཞེས་བྱ་བ་ལན་ནོ།",
    "གལ་ཏེ་རྗེས་སུ་དཔག་པའི་དུས་སུ་དེ་ལྟར་རྟོགས་པ་ནི་བལྟ་བར་བྱ་བ་མ་ཡིན་པ་ཁོ་ནར་འགྱུར་ཏེ་ཞེས་དོགས་པ་བསུ་བ་ནི་དམིགས་པར་བྱ་བའི་ཉིད་དུ་ཞེས་བྱ་བའོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་དམིགས་པར་བྱ་བ་མ་ཡིན་པའོ།",
    "དེའི་རང་བཞིན་དུ་ནི་དམིགས་པར་བྱ་བའི་རང་བཞིན་དུའོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་དམིགས་པར་བྱ་བ་ཡིན་པར་རོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ནི་དམིགས་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་དུའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རྗེས་སུ་དཔག་པའི་དུས་ན་ཡོད་པ་ཉམས་སུ་མ་མྱོང་ཡང་ཡོད་པར་རྟོགས་པ་ནི་མི་འཐད་དེ།",
    "རྗེས་སུ་དཔག་པ་ལས་ཡུལ་དུ་མ་བྱས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་གཉི་ག་ཡང་དམིགས་པར་བྱ་བ་ཁོ་ནའི་ཡུལ་ཅན་ཡིན་ན།",
    "དམིགས་པར་བྱ་བ་ཉིད་དོ།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ནི་དམིགས་པར་བྱ་བ་ཡོད་པ་ཉིད་དུའོ།",
    "དམིགས་པར་བྱ་བའི་རང་བཞིན་ཉིད་དོ།",
    "དེ་ལྟ་ན་ནི་འོ་ན་ཞེས་བྱ་བ་ལ་སོགས་པས་ལྟོས་པས་བྱས་པ་ཐ་དད་ན་དོན་དམ་མཚན་ཉིད་མིན་པར་འགྱུར་ཞེས་བརྗོད་པའི་རྩོད་པ་རྗེས་སུ་བརྗོད་པས་བདེན་ཏེ་ཞེས་བྱ་བས་ལན་འདེབས་པའོ།",
    "དངོས་པོ་ལ་མི་སླུ་བའི་སྒོ་ནས་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་བརྟག་པར་བྱ་བའི་དོན་གཅིག་ཏུ་བྱེད་པར་དངོས་པོ་ཉིད་ཡིན་པ་དེ་ལ་ལྟོས་ནས་སོ།",
    "རྩོད་པ་བརྗོད་པ་ནས་དེ་ནི་མི་རིགས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པར་བྱེད་དོ།",
    "རྟོགས་པར་ཁས་ལེན་ན་ཡང་ཉེས་པ་ཡོད་དོ་ཞེས་བརྗོད་པ་ནི།",
    "རྟོགས་པའི་དབྱེ་བ་ཉིད་ཀྱིས་ཞེས་གསུངས་ཏེ།",
    "འདི་ཡང་རྣམ་པ་ཇི་ཞིག་ལྟར་གཅིག་ཉིད་གཉི་གའི་རང་བཞིན་ཡིན་པས་ཁས་བླངས་ནས་བརྗོད་པ་ཡིན་གྱི་དེ་ནི་དོན་དམ་པར་ནི་རིགས་པ་མ་ཡིན་ཏེ།",
    "ལྟོས་པ་བྱས་པ་ཡིན་པའི་ཕྱིར་ཞེས་བརྗོད་པ་ནི་ཡང་ན་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་གཅིག་ལ་ཡང་ལྟོས་པས་ཐ་དད་པར་མཐོང་བ་ཉིད་མ་ཡིན་ནམ།",
    "གཞན་གྱིས་ཡུལ་གཅིག་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་ཐ་དད་པ་མེད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "མངོན་སུམ་ལ་ལྟོས་པའི་གཉིས་པ་རྗེས་སུ་དཔག་པའི་རྟོག་པ་ནི་འཁྲུལ་པ་ཉིད་ཡིན་པར་འདོད་དོ།",
    "ལྷག་པར་ཞེན་སྙམ་ན།",
    "སྔར་མཐོང་བའི་དོན་གྱིས་ཞེས་གསུངས་སོ།",
    "འཁྲུལ་པ་ཞེས་གསུངས་ཏེ་གཞན་རྟོགས་པ་ན་གཞན་ཐོབ་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འཁྲུལ་པ་ཉིད་ཡིན་པར་འགྱུར་ཞེ་ན།",
    "རྣམ་གཞན་གྱིས་ཀྱང་ཞེས་གསུངས་སོ།",
    "ཇི་ལྟར་དཀར་པོ་ལ་སེར་པོའི་རང་བཞིན་དུ་འཁྲུལ་པར་རྟོག་པ་མཐོང་བ་དེ་བཞིན་དོན་གྱི་རང་བཞིན་གསལ་བ་ཡང་མི་གསལ་བའི་རྣམ་པར་རྟོག་པའི་ཕྱིར་འགལ་བ་མེད་དོ།",
    "རྣམ་གཞན་གྱིས་ཀྱང་ཞེས་གསུངས་པའོ།",
    "དཔེར་ན་ལྷ་སྦྱིན་མཆོད་སྦྱིན་དུ་རློམ་པ་ལས་འཇུག་པ་ཡིན་ནོ།",
    "ཐོབ་པར་བྱ་བ་ཉིད་སྣང་བ་ཡིན་ནོ་ཞེས་ཇི་ལྟར་རྟོགས་པར་མི་བྱེད་སྙམ་ན།",
    "ཕྱོགས་འདི་ལ་ཞེས་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་རྣམ་པར་རྟོག་པ་དངོས་པོར་འཛིན་པ་ནི་བཀག་ཟིན་ཏོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་རྗེས་སུ་དཔག་པའི་རྟོག་པ་དོན་ཇི་ལྟ་བ་བཞིན་མ་ཡིན་པར་ལྷག་པར་ཞེན་པ་ཇི་ལྟར་ཡིན་ཏེ།",
    "འོ་ན་ཇི་ལྟར་རྗེས་སུ་དཔག་པ་དོན་ཇི་བཞིན་མ་ཡིན་པ་རྟོགས་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "འདི་ནི་འཆད་པར་བྱེད་པ་རྣམས་ཀྱིས་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་རྣམ་པར་རྟོག་པ་དོན་ལ་ངེས་པ་མ་ཡིན་ན་ནི་ཇི་ལྟར་དེ་ལས་སོ་སོར་ངེས་པའི་དོན་ལ་འཇུག་སྙམ་དུ་དོགས་པ་སེལ་བས།",
    "ཞེས་བྱ་བ་རྣམ་པར་འགྲེལ་པ་ནི།",
    "མཐོང་བ་ལ་ནི་ཞེས་གསུངས་སོ།",
    "དེ་ཡང་ཞེས་གསུངས་པ་སྟེ།",
    "སྒྲུབ་པར་བྱེད་པའི་མངོན་སུམ་ལ་ཡང་ངོ།",
    "ཇི་ལྟར་ཞེ་ན་ཉེ་བར་གནས་པ་ཞེས་གསུངས་སོ།",
    "ཉེས་ན་ཞེས་བྱ་བ་ནི་རྗེས་སུ་དཔག་པ་ནི་རྣམ་པར་རྟོག་པ་དང་བཅས་པ་ཡིན་པའི་ཕྱིར་ན།",
    "ཉེ་བར་གནས་པ་ཙམ་ནི་ཞེས་གསུངས་སོ།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་གཅིག་ཏུ་ལྷན་ཅིག་ལྷག་པར་ཞེན་པས་ནའོ།",
    "མཚུངས་པ་ཉིད་མི་འཐད་པར་དོགས་པ་བསུ་བ་ནི་འོན་ཀྱང་ཞེས་བྱ་བའོ།",
    "མངོན་སུམ་ནི་གཅིག་ཏུ་ལྷག་པར་ཞེན་པའི་རྣམ་པར་རྟོག་པ་སྐྱེད་པའི་སྒོ་ནས་འཇུག་པར་བྱེད་པ་ཡིན་ལ།",
    "རྣམ་པར་རྟོག་པ་གཞན་གྱིས་ཀྱང་འཇུག་པར་བྱེད་པ་ཉིད་ཇི་ལྟར་འགྱུར་སྙམ་ན།",
    "རྣམ་རྟོག་གཞན་ནི་གནས་པར་འགྱུར།",
    "ཞེས་གསུངས་སོ།",
    "དེས་ན་དེའི་སྒོ་ནས་དེ་ཡང་འཇུག་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བསྟན་པར་བྱ་བའི་དོན་འདུ་བ་ཡིན་ནོ།",
    "འོན་ཏེ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་ཐ་དད་པ་མེད་པའོ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་མེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འོ་ན་རང་བཞིན་དེ་ཉིད་ཅེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་མེད་པའི་རང་བཞིན་ནོ།",
    "རྣམ་པར་རྟོག་པ་ལ་ཡང་འཇུག་པར་བྱེད་པ་ཉིད་མེད་པའི་ཕྱིར་ན་ཇི་ལྟར་དེའི་སྒོ་ནས་མངོན་སུམ་འཇུག་པར་བྱེད་པ་ཡིན་ཞེས་བྱ་བ་ལན་འདེབས་པ་ནི།",
    "འོན་ཏེ་འཇུག་པར་བྱེད་པ་མ་ཡིན་པའི་རྣམ་པར་རྟོག་པ་སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱིས་འཇུག་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན་དེ་ནི་མི་རིགས་ཏེ་ཅིའི་ཕྱིར་ཞེ་ན་དེ་རང་ཉིད་ཅེས་གསུངས་སོ།",
    "འདི་སྙམ་དུ་རང་ཉིད་མི་འཇུག་པར་བྱེད་པ་མ་ཡིན་པ་ཉིད་ཡིན་ལ།",
    "འཇུག་པར་བྱེད་པའི་རྣམ་པར་རྟོག་པ་བསྐྱེད་པའི་སྒོ་ཁོ་ནས་འཇུག་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་དོགས་པར་བྱེད་པ་ནི་གལ་ཏེ་རྣམ་རྟོག་ཅེས་བྱ་བའོ།",
    "དངོས་འཛིན་མིན་པར་འཇུག་བྱེད་དུ།",
    "རྣམ་པར་རྟོག་པ་དངོས་པོ་འཛིན་པ་མ་ཡིན་ཡང་འཇུག་བྱེད་ཡིན་ན་ནི།",
    "དངོས་པོ་འཛིན་པ་མ་ཡིན་ཡང་གལ་ཏེ་རྣམ་པར་རྟོག་པ་འཇུག་པ་སྟེ་ཡིན་ན།"
  ]
}