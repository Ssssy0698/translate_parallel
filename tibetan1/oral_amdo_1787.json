    "མྱོང་ཚོར་བྱེ་བྲག་འཁོར་ལོ་ལུས་ལ་བསྐོར།",
    "དམྱལ་ཁམས་རེ་རེ་བསྐལ་ཆེན་གཉིས།",
    "ཉོན་མོངས་འཁྲུལ་འཁོར་ཤུགས་དྲག་པས།",
    "སྔར་འདས་རེ་རེས་བསམ་འདས་དྲངས་ཀྱང་།",
    "ཉོན་མོངས་དུག་འབྲས་བསྒག་པའི་ཕྱིར།",
    "ཉོན་མོངས་འཇིག་རྟེན་ཡུལ་འཁྱལ་བཅུ་གཉིས།",
    "གཟུང་འཛིན་བདག་གཞན་གཉིས་ཀ་ཉོན་མོངས་སྤོངས།",
    "འཁྲུལ་བའི་བློ་བསྐྱེད་དུག་རྒྱས་ཉོན་མོངས་སྤངས།",
    "གཏིང་སོགས་བག་ཆགས་འཛིན་བྱེད་ཉོན་མོངས་སྤངས།",
    "འདུ་འཛིན་གཞི་བསྐྱེད་ཉོན་མོངས་སྤངས།",
    "རྣམ་རྟོག་མཐའ་རྒོད་འཁྲུལ་འཁོར་ཉོན་མོངས་སྤངས།",
    "ལོག་པ་སྣང་ཆར་གསལ་རྒོད་ཉོན་མོངས་སྤངས།",
    "བསླུས་རྗེས་ཡི་རང་ཕྲ་བ་དུག་རྒྱས་ཉོན་མོངས་སྤངས།",
    "གཏིང་ཤར་གཡོ་འཁྲུག་བྱ་བྱེད་ཉོན་མོངས་སྤངས།",
    "ཉོན་མོངས་པས་ནི་འདམ་དུ་བྱིང་།",
    "མེ་ལྕེར་སྦུར་མ་ཆགས་མ་རེད།",
    "ལྷ་ཡི་བུ་མོ་བརྟག་ཀྱིན་སྡུག།",
    "བདུད་རྩིའི་ཟས་བཅུད་མྱོང་གིན་ཞིམ།",
    "ཉོན་མོངས་གཉེན་པོས་སྤངས་ཐུབ་ཉོབ་བེ་སྟེ་སོ་གཉིས་པའོ།",
    "ལེ་ལོ་འདུ་འཛིན་ངན་སོང་རྒྱུ།",
    "བདག་གཞན་ཕྱོགས་འཛིན་ངན་སོང་རྒྱུ།",
    "འགྲོ་དོན་འགོ་འདོན་ངན་སོང་རྒྱུ།",
    "དགེ་སྤྱོད་ཡུལ་འཛིན་ངན་སོང་རྒྱུ།",
    "དད་རྫས་རིན་ཆེན་ངན་སོང་རྒྱུ།",
    "དཔོན་གསས་རྗེས་ཚམ་ངན་སོང་རྒྱུ།"
  ]
}