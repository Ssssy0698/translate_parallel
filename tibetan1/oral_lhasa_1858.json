    "མ་གཞི་སྒྲོལ་མ་མེ་ཏོག་ལས་མཚར་སྡུག་རྣམ་པར་བཀྲ་བའི་མེ་ཏོག་ཇི་སྙེད་ཅིག་གངས་དཀར་རི་བོའི་མུ་ཁྱུད་ཀྱིས་ཕྱོགས་བཞི་མཚམས་བརྒྱད་སྐོར་བའི་གངས་ཅན་གྱི་ཞིང་འདིར་མཆིས་ཏེ།",
    "ལོག་པར་ཚར་གཅོད་ཀྱི་རལ་གྲི།",
    "ཡོན་ཏན་རྒྱ་མཚོས་སྐྱེ་རྒུའི་ཡིད་རབ་འཕྲོགཡོན་ཏན་རྒྱ་མཚོའི་བྱུང་བར་དཔྱོད་པར་སྤྲོ།",
    "གང་ལྟར་ད་བར་མཐའ་དཔྱོད་ལྟ་ཞོག་དཔྱོད་གླེང་ཟུར་གསལ་གནང་བ་ནི་མི་དམིགས།",
    "མ་ཤེས་པར་སློབ་སྟོན།",
    "གཞན་ཡང་ཁོང་གང་སར་ཕེབས་པའི་གྲགས་པ་དང་།",
    "རགས་ཙམ་དབྱེ་འབྱེད་བྱས་ནའང་འགལ་འདུ་བསལ་མི་ཐུབ་པར་སོར་གནས་གྱུར་ངེས།",
    "བཤེས་གཉེན་ལ་བརྩི་བཀུར་སོགས་ལེགས་བྱས་ཆེ་བ་མ་ཟད།",
    "འདས་རྗེས་༡༧༢ སྤྱི་ལོ་༡༡༥༨ ལོར་ཕྱག་བཏབ་པའི་འཇང་གདན་ས་ཐེལ་གྱི་རི་ཁྲོད་ལ་སྒྲུབ་པའི་ལག་རྗེས་བཞག་མུས་ཡིན་པར་གསལ་ལ།",
    "སྔ་ཕྱི་ཀུན་གྱི་འབུལ་བ་ལེགས་པར་ཐེངས།",
    "གཞོན་ནུར་འབྲི་གུང་དུ་ཕེབས།",
    "རབ་བྱུང་བཞི་པའི་ས་འབྲུག་ལོར་ཕག་གྲུའི་གདན་སར་བསྐོ་བཞག་བཞིན་ཕེབས།",
    "༣ཁོང་ནི་ནང་བསྟན་ཤེར་རྟོགས་རིག་པར་ནང་བྱན་ཚུད་དེ་རྟོགས་ཚད་ངེས་ཅན་རྙེད་པའི་རྣལ་འབྱོར་པ་ཞིག་ཡིན་པ་དང་།",
    "མ་ནོར་ལེགས་པར་རྟོགས་པའི་རྣལ་འབྱོར་པ།",
    "བྱམས་བརྩེའི་ཕོ་ཉ་ཕེབས་བྱུང་།",
    "སྐྱེ་དགུ་མཛེས་པར་བྱེད་པའི་མགུལ་རྒྱན་དུ།",
    "སྔོན་ཇོ་བོ་རྗེ་དཔལ་ལྡན་ཨ་ཏི་ཤ་མྱང་སྨད་ལྗོངས་ཀྱི་འདབས་རོལ་རྟ་མཚོ་ལའི་སྟེང་དུ་ཕེབས་པའི་ཚེ་གསོལ་ཞབས་ཚོར་གསུངས་པར།",
    "དཔོན་པོ་རིའི་ངོས་འགྲམ་ན་ས་དཀར་ཞིང་སྣུམ་པ་བཀྲ་ཤིས་པའི་དགེ་མཚན་དུ་མ་དང་ལྡན་པའི་ཡུལ་དུ་མཁྱེན་ཏེ།",
    "བོད་རྒྱལ་ཁྲི་སྲོང་ལྡེ་བཙན་དུས་ལོ་པཎ་བཞུགས་པའི་གནས་ཆེན་ཏེ།",
    "དེའང་པ་སྣ་ཞེས་པར་རྗེས་འཇུག་མ་སྦྱར་ན་པ་སྣམ་ཞེས་བརྗོད་པ་བདེ་བར་གྱུར་ཕྱིར་དེ་ལྟར་འབོད་པར་མངོ།",
    "ཡང་འགས་པ་ཚབ་ཉི་མ་གྲགས་པར་བཞེད་སྲོལ་ཡང་ཡོད།",
    "འདིའི་ཚིག་རིང་རིགས་ཕལ་ཆེར་ཕལ་སྐད་ལྟ་བུར་མཛད་པ་ནི་ཀུན་གྱི་གོ་སླ་བ་ལ་དགོངས་པར་སྣང་བས་དྲེགས་ལྡན་ང་རྒྱལ་ཅན་རྣམས་ཀྱིས་ལོག་ལྟ་མ་བྱེད་གཅིག། ། རྒྱ་གར་སྐད་དུ།",
    "སྲིད་པ་གསུམ་གྱི་འདྲེན་མཆོག་དམ་པར་གྱུར་པ།",
    "ཀུན་མཁྱེན་དགའ་མཛད་ངང་ཚུལ་དེས་པ་ཅན།",
    "ཁྱད་པར་གསང་སྔགས་ཟབ་དོན་བདུད་རྩིའི་དཔལ།",
    "རྒྱུན་ཆད་མེད་པར་གདུང་བའི་གསོལ་བཏབ་ནས།",
    "མཁས་མང་འདུ་བའི་གདན་ས་བསྔགས་པར་བགྱིས།",
    "དེ་སྐད་གསུངས་ཕྱིར་ངོ་མཚར་གནས་མཆོག་ཡིན།",
    "ཤམྦྷ་ལ་ལྟར་ཁྱད་པར་འཕགས་པར་མངོན།",
    "ཁ་འུའི་དལ་འབབ་རིན་ཆེན་འབྱུང་གནས་ལགས།",
    "ཁ་འུ་གཙང་པོ་རྟ་མཆོག་རིན་ཆེན་འདྲ།",
    "རྗེ་མི་བསྐྱོད་རྡོ་རྗེའི་བཞུགས་གནས་ཡིན།",
    "ལྷོ་ཁ་འུ་གཙང་པོ་རིན་ཆེན་རྟ།",
    "རིན་ཆེན་འབྱུང་ལྡན་གྱི་བཞུགས་གནས་ཡིན།",
    "རྗེ་འོད་དཔག་མེད་ཀྱི་བཞུགས་གནས་ཡིན།",
    "བདག་གཅིག་པུའི་ཁ་པོ་མ་ལགས་ཏེ།",
    "འདི་བཞིན་ཀུན་ལ་བདོག་པ་ལགས།",
    "རྒྱལ་བའི་བཀའ་དང་འདི་ལ་ཁྱད་པར་མེད།",
    "དེ་འདྲའི་བསྟི་གནས་ཁྱད་པར་འཕགས་པ་སྟེ།",
    "རིམ་བདུན་རིམ་བཞིན་རིམ་པར་བྱོན་ནས་ཀྱང་།",
    "བདེ་ཆེན་བདེ་ལེགས་བདེ་བ་སྟེར་ཞེས་གསུངས།",
    "རྣམ་པར་གསལ་བྱེད་མཛེས་པའི་མེ་ཏོག་རྣམས།",
    "ཟད་པར་སྤངས་པ་གྲགས་པ་རྒྱལ་མཚན་གྱི།",
    "སྤང་བྱའི་གཡུལ་ལས་རྒྱལ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "རིམ་པར་བརྒྱུད་དེ་ལ་རྩེར་བྱོན་པའི་ཚེ།",
    "དེ་སྐད་གསུངས་པས་ད་ལྟའི་བར་དུ་ཡང་།",
    "རིམ་གྱིས་ཕེབས་པས་ས་སྐྱའི་འདབས་སུ་བྱོན།",
    "ཇོ་བོ་ཆེན་པོའི་ཞལ་ནས་འདི་སྐད་གསུངས།",
    "གུར་ཞལ་རྣམ་གཉིས་འབྱོན་པར་འགྱུར་བ་ཡིན།",
    "རིམ་པར་འབྱོན་ཞིང་གནས་མཆོག་འདི་ཉིད་དུ།",
    "དེ་སྐད་གསུངས་ནས་ཕྱག་མཆོད་རྒྱས་པ་མཛད།",
    "བསྟན་པ་རིན་ཆེན་རྒྱུན་ཆད་མེད་པར་འབྱུང་།",
    "ཕྱོགས་བཞིར་མཆོད་རྟེན་ཆེན་པོ་བཞི་གནང་ནས།",
    "སྲིན་པོ་བསད་ནས་ཆུང་མ་ཁབ་དུ་བཞེས།",
    "ཡུམ་ཉིད་ཕལ་པ་ཡིན་ཏེ་མི་གཅིག་པར།",
    "ལེགས་པར་བསྟན་ཞིང་སྲས་ཀྱི་ཆེ་བ་ནི།",
    "ཡོན་ཏན་ཀུན་གྱི་ཕྱུག་ཅེས་གསུངས་པ་ཡིན།",
    "རིགས་འཛིན་བསྐུལ་དུ་ཚིག་བཅད་མཛད་པར་ཡང་།",
    "དེ་རྣམས་འཁོན་གྱི་བརྒྱུད་པ་བྱུང་ཚུལ་ལགས།",
    "རྒྱུན་རིང་བཞུགས་རྗེས་བྲ་བོ་ལུང་ཞེས་པར།",
    "བཞུགས་པའི་བར་སྐབས་ཞིག་ཏུ་དེ་ཉིད་ཀྱི།",
    "དེ་ལ་སོགས་པ་ཁྱད་པར་འཕགས་པ་ཡི།",
    "འདེབས་པར་འདོད་པས་རིན་ཅིག་བཅལ་བ་ན།",
    "གསུངས་མ་ཐག་ཏུ་དེ་དག་ཐམས་ཅད་ཀྱིས།",
    "བཀའ་གྲོས་མཐུན་པར་ཅིས་ཀྱང་གནང་བ་ཞུ།",
    "དེ་ཕྱིར་མཁའ་འགྲོ་གྲོག་པོ་བྱས་ཀྱང་ཆོག།",
    "ཁྱད་པར་རྗེ་བཙུན་གྲགས་པ་རྒྱལ་མཚན་གྱིས།",
    "ཇི་སྙེད་བགྲང་ལས་འདས་པར་བཞེངས་པར་མཛད།",
    "བཀའ་བསྒོ་དམ་བཞག་མཛད་ཅིང་ཁྱད་པར་དུ།",
    "ངེད་ཀྱི་ནོར་རྫས་བསྐྱེད་པར་བརྩམས་ན་ཡང་།",
    "བཀའ་ལུང་གང་གནང་འཕྲིན་ལས་བསྒྲུབ་ཆོག་པ།",
    "འདི་ཉིད་ཐུགས་རྗེས་བཟུང་ནས་གནང་བ་ཞུ།",
    "གཙུག་ལག་ཁང་རྣམས་རིམ་གྱིས་འདེབས་པར་མཛད།",
    "ཡོན་ཏན་ཆེ་ཞིང་ཁྱད་པར་སེར་བསྲུང་ལ།",
    "དེ་ལས་གཞན་པ་བྲམ་ཟེས་བྱས་པ་མིན།",
    "ཕུན་སུམ་ཚོགས་པ་བྱས་རྗེས་ངན་པ་ཡིས།",
    "སོག་མ་ཙམ་ཡང་མེད་པར་བྱེད་ནུས་པའི།",
    "ཇི་ལྟར་སྨོན་པ་བཞིན་དུ་འགྲུབ་པར་གྱུར།",
    "མེད་པར་བྱས་པས་ཀླུ་རྒྱལ་འདི་ཉིད་ལ།",
    "འདིར་ནི་ཁརྶ་པ་ཎི་ཡིན་པར་ངེས།",
    "དེ་ཉིད་ཁབ་ཏུ་བཞེས་པར་གྱུར་ནའང་།",
    "བླ་ཆེན་དགུང་ལོ་ང་དགུ་བཞེས་པའི་དུས།",
    "དཀར་གོང་འབྱུང་པས་དེ་ཡི་ལུང་པར་གྲགས།",
    "ཞབས་གཉིས་མཉམ་བཞེངས་བཞུགས་པ་དངོས་ལྟ་བུ།",
    "དེ་སྐད་གསུངས་ནས་ཡང་དང་ཡང་དུ་བྱོན།",
    "དེ་ནས་ཕུད་རིན་ནས་ཞིག་གནང་ནས་བརྫངས།",
    "དཀར་གོང་ལུང་དུ་ངེས་པར་ཞུགས་ཤིག་གསུངས།",
    "དེ་སྐད་གསུངས་པས་ཐུགས་རྗེ་གདོང་ཀྱང་ཟེར།",
    "ལེགས་པར་ཕེབས་ཤིང་དཀར་གོང་ལུང་མ་ཉིད།",
    "བརྙེད་བཀུར་ཕུན་སུམ་ཚོགས་པར་འབུལ་བ་བྱས།",
    "ལེགས་པར་ཕུལ་ནས་འདི་ལ་རིན་མི་འཚལ།",
    "གསུངས་ནས་གནས་མཆོག་ཁྲུ་མར་ལེགས་ཕེབས་ཏེ།",
    "སྐུ་ཡི་ཁྲུ་མ་བཞུགས་པས་དེ་སྐད་ཟེར།",
    "དེ་ཡང་ཅུང་ཟད་རྣམ་པར་ཕྱེ་བ་ན།",
    "བསྔགས་པ་ཆེས་ཆེར་མཛད་ཅིང་སྐུ་པང་བཞེས།",
    "གསུངས་ནས་ཤིན་ཏུ་དགེས་པའི་རྣམ་འགྱུར་མཛད།",
    "བདུད་འདུལ་མཆོད་རྟེན་བཞེངས་པར་མཛད་པ་ཡིན།",
    "གཙོ་བོར་བཞུགས་པས་ཁྲུ་མ་མཆོད་རྟེན་བྱུང་།",
    "སྲས་ཉིད་སྐུ་པང་བཞེས་ནས་ངོ་མཚར་ཆེ།",
    "ཐམས་ཅད་བུ་ཡི་མ་ལ་དགོས་གསུངས་ནས།",
    "ཡུམ་སྲས་གཉིས་ལ་ཐམས་ཅད་འབོག་པར་མཛད།",
    "བཞེས་པའི་ཚེ་ན་ཡབ་ཉིད་བདེ་བར་གཤེགས།",
    "ལེགས་པར་གདན་དྲངས་བཀྲ་ཤིས་མངའ་གསོལ་དང་།",
    "ཕྱི་རྟེན་ཆེན་པོའི་འགྲམ་ཡང་བཏིང་པར་མཛད།",
    "ཕྱི་རྟེན་ཆེན་པོ་འདི་ཉིད་བཞུགས་ས་ཡང་།",
    "མཐུན་པར་བྱི་འོ་ལྟ་བུའི་བཟོ་ལུགས་ཀྱི།",
    "ཞེས་གསུངས་དེ་ཉིད་བཀའ་གནང་ཇི་ལྟ་བར།",
    "ལེགས་པར་གྲུབ་སྟེ་བཀྲ་ཤིས་མངའ་གསོལ་དང་།",
    "རབ་གནས་ལ་སོགས་ཐམས་ཅད་གྲུབ་པར་མཛད།",
    "རིན་ཆེན་གྲགས་པའི་གསུང་ལས་འདི་སྐད་གསུངས།",
    "ད་ནི་དགུང་ལོ་བཅུ་གཉིས་ཙམ་དུ་ཕེབས།",
    "འདི་ལ་རྩོལ་བ་མཛོད་ཅིག་ཇོ་སྲས་ལགས།",
    "ཡོངས་སུ་རྫོགས་པར་ལེགས་པར་གནང་བ་ན།",
    "ས་ཆེན་ཕུག་པ་བྱས་ཀྱང་ཆོག་པར་སྣང་།",
    "བརྩེ་བ་ཆེན་པོའི་ཞལ་ནས་འདི་སྐད་གསུངས།",
    "འདི་སྐད་བྱས་ན་ཆེ་རུ་འགྲོ་ཡང་སྲིད།",
    "ད་ལྟའི་བཟོ་འདི་ལེགས་པར་བྱུང་བ་ཡིན།",
    "གཟིམ་ཕུག་འདི་ལ་རྡོ་རྗེ་ཕུག་པར་གྲགས།",
    "དེ་འདྲའི་གནས་མཆོག་ཉིད་དུ་ལེགས་པར་བསྒྲུབས།",
    "ལེགས་པར་ཞལ་བསྟན་ཉིད་ཀྱིས་འདི་སྐད་གསུངས།",
    "ཅེས་པའི་ཚིག་བཅད་འདི་དག་གསུངས་མ་ཐག།",
    "བརྩེ་བ་ཆེན་པོའི་ཐུགས་ཁར་ཐིམ་པར་གྱུར།",
    "ད་ལྟ་གནས་མཆོག་འདི་རུ་བཞུགས་པ་ཡིན།",
    "ཞབས་རྗེས་ཡིན་ཞེས་སྔགས་འཆང་ཆེན་པོས་གསུངས།",
    "རྗེ་བཙུན་གྲགས་པ་དབྱེར་མེད་ཡིན་པར་གོ།",
    "གཉིས་ཀ་བྲུས་དང་གསུངས་ནས་བརྐོས་པ་ཡི།",
    "བཞུགས་ཁྲི་འདི་ཡི་སྟེང་དུ་ལེགས་བཞུགས་ནས།",
    "གསུངས་པ་ལ་སོགས་ཡིད་ཆེས་དུ་མ་ཡི།",
    "ཀུན་གྱི་འཚོལ་ཅིག་གསུངས་ནས་ཐམས་ཅད་ཀྱི།",
    "བརྙེད་པར་མཛད་པའང་སྔོན་གྱི་ཐུགས་རྒྱུས་ཀྱི།",
    "ངེས་པར་བྱེད་དགོས་དགོངས་ནས་ཡུམ་ལ་གསུངས།",
    "ཡུམ་སྲས་བཀའ་གྲོས་མཐུན་པར་བྱུང་ནས་ནི།",
    "སྙན་གྲགས་ཆེ་བས་དེ་ཁར་ཕེབས་དགོངས་སྙམ།",
    "ལེགས་པར་དགོངས་ཏེ་རིམ་གྱིས་ཕེབས་པའི་ཚེ།",
    "ཡོལ་བས་ལེགས་པར་བཅད་ཅིང་བཞུགས་པར་མཛད།",
    "གནོད་སྦྱིན་ཡབ་ཉིད་སྐུ་ཕེབས་ཡོང་བ་དང་།",
    "དེ་འཕྲལ་ཡུམ་ལ་ཞུས་པས་འདི་སྐད་གསུངས།",
    "ཤིན་ཏུ་བདེན་པར་ངེས་པས་གྲབས་ཡུལ་གྱིས།",
    "གསུངས་པ་བཞིན་དུ་དེ་ནུབ་བང་ཆེན་སླེབ།",
    "ལེགས་པར་དགོངས་ཏེ་གསེར་སོགས་ཡོ་བྱད་ཀྱི།",
    "ལེགས་པར་ཕེབས་ཏེ་ངེད་ཀྱི་བུ་མཆོག་དེ།",
    "དེ་ནས་རིམ་གྱིས་ཕེབས་པར་མཛད་པ་དང་།",
    "སྲས་ཀྱིས་ཡུམ་ཉིད་ཕེབས་པའི་མཉེས་ཚོར་གྱིས།",
    "ཤེ་བ་བཅད་ཕྱིར་ཡུམ་གྱིས་འདི་སྐད་གསུངས།",
    "སྐུ་ཁམས་དྭངས་ནས་ཡུམ་གྱིས་ཡར་ཕེབས་དུས།",
    "སྲས་ཀྱིས་ཡུམ་ཉིད་ཕེབས་བསྐྱེལ་མཛད་པ་ལ།",
    "ཡོད་སར་ཕེབས་ནས་ཡུམ་སྲས་གྱེས་དུས་སུ།",
    "དེ་ནས་རིམ་གྱིས་ས་སྐྱར་ཕེབས་པ་ན།",
    "འཁོན་སྟོན་སྒྱི་ཆུ་བ་ཡི་དྲུང་དུ་ཕེབས།",
    "ལེགས་པར་བསྒྲལ་བའི་མཚན་ལྟས་བཟང་པོ་བྱུང་།",
    "ཞལ་ནས་གསུང་གླེང་ཆལ་ཆོལ་མང་པོ་གནང་།",
    "གསུངས་ནས་གཞན་རྣམས་ཀུན་ལ་བཀའ་སྩལ་རྗེས།",
    "གསུངས་པའི་ལན་དུ་བདག་ཅག་གྲོམ་སྦུག་པ།",
    "ཇི་ལྟར་ཡོད་ཅེས་གསུངས་པའི་ལན་དུ་ནི།",
    "དེ་ཡི་བུ་ཡི་དོད་ཅིག་བདག་གཅིག་ལགས།",
    "ས་ཆེན་སྐུ་པང་བཞེས་ནས་འདི་སྐད་གསུངས།",
    "གསུངས་ནས་སྤྱན་ཆབ་མང་པོ་མཛད་པ་དང་།",
    "དེ་སྐད་གསུངས་ནས་དེ་ནུབ་སེ་སྟོན་གྱི།",
    "བརྡེག་པར་མཛད་ནས་ཕེབས་གྲབས་མཛད་པའི་ཚེ།",
    "གནང་བ་ཙམ་ཡང་མ་ཞུས་བྱོན་པ་ན།",
    "གནང་བ་ཙམ་ཞིག་ཞུས་ནས་བྱོན་པ་ལེགས།",
    "གསུངས་ནས་བཀའ་གྲོལ་གནང་བ་མ་བྱུང་བས།",
    "ཉིན་མཚན་ཀུན་ཏུ་ཐུགས་ཡིད་ཆད་པར་གྱུར།",
    "འདིར་ཡང་གནང་བ་ཞུས་རྗེས་མ་བསྡད་ན།",
    "ལོ་འགའ་བཞུགས་པའི་ད་གཟོད་སེ་སྟོན་གཤེགས།",
    "བུ་ཆེན་རྣམས་ཀྱང་རགས་རིམ་འཛོམས་པར་གྱུར།",
    "ཞལ་མཇལ་མ་ཐུབ་ཐུགས་ཡིད་ཆད་པར་གྱུར།",
    "དེ་སྐད་གསུངས་པས་བརྩེ་བ་ཆེན་པོ་དེས།",
    "འཆམས་མགོན་ལ་སོགས་ངོ་མཚར་རྟེན་ཡང་གནང་།",
    "དེ་ནས་གདན་ས་ཆེན་པོར་ཕེབས་པའི་ཚེ།",
    "དགུང་ལོ་ཉེར་བརྒྱད་བཞེས་པའི་དུས་ཚོད་དེར།",
    "ལེགས་པར་བཞུགས་ཞེས་སྙན་གྲགས་ཀུན་གྱིས་ཞུས།",
    "ལེགས་པར་བསྣམས་ནས་སག་ཐང་དིང་དུ་ཕེབས།",
    "ལམ་འབྲས་གསོལ་བ་འདེབས་རྒྱུ་ཡིན་ལགས་ཤིང་།",
    "ཕལ་ཆེར་གདམ་ངག་རང་ནི་མེད་པར་འདྲ།",
    "སྐུ་པང་བཞེས་ནས་ཐུགས་རྩིས་མཛད་པ་དེ།",
    "ཉམས་པར་འགྲོ་བས་མྱུར་དུ་བོས་ཤོག་ཤིག།",
    "དེ་སྐད་གསུངས་ཤིང་འོད་མཆོག་ཕ་དེ་ཡིས།",
    "འགྱོགས་པར་ཕྱིན་ཏེ་ས་ཆེན་གདན་དྲངས་ཏེ།",
    "ངོ་ཡང་མ་ཤེས་བརྫུན་ཡང་བྱས་པ་ཡིན།",
    "ས་སྐྱར་བྱོན་ལ་ཆ་རྐྱེན་བསྒྲུབ་པར་མཛོད།",
    "དེ་སྐད་གསུངས་ནས་བརྩེ་བ་ཆེན་པོ་དེས།",
    "ས་སྐྱར་ཕེབས་ནས་ཆ་རྐྱེན་འཛོམས་པར་མཛད།",
    "དེ་ནས་སོས་བསྟུན་སག་ཐང་དིང་དུ་ཕེབས།",
    "ཞང་སྟོན་ཆེན་པོས་གསུང་ངག་འཛུགས་པར་མཛད།",
    "དེ་ལ་རྗེ་ཡི་གསུང་ལས་འདི་ལྟར་གསུངས།",
    "ལེགས་པར་མཛད་པས་རྗེ་ཉིད་སྙུང་ལས་གྲོལ།",
    "དེ་སྐད་གསུངས་ནས་འབྲི་རུ་མ་གནང་ཡང་།",
    "ལོ་བཞིའི་བར་དུ་ནན་ཏན་ཆེན་པོས་གནང་།",
    "ཉིན་ཅིག་སྔ་དྲོ་ཐོག་ཁར་བྱོན་གསུངས་ཏེ།",
    "དེ་ཕྱིར་བསྒོམ་ལ་འབད་འབུངས་བསྐྱེད་པར་མཛོད།",
    "ཡུལ་གྲུ་ཐམས་ཅད་ཁྱབ་པར་མཛད་པ་སོགས།",
    "ཐོགས་པ་མེད་པར་བསྟན་ནས་འདི་སྐད་གསུངས།",
    "ལེགས་པར་རྫོགས་ཏེ་བསྒྲུབ་པའི་ལུང་སྦྱིན་སྐབས།",
    "དེ་སྐད་གསུངས་པ་དེ་རྣམས་སྟ་གོན་གྱི།",
    "ཞུ་བྱས་སྒ་སྟོན་ནགས་བསྒོམ་བསོད་རྒྱལ་དང་།",
    "ས་སྐྱར་ཕེབས་ནས་བཀའ་རྒྱ་མ་ཐིམ་བར།",
    "གསང་སྒོ་དམ་པར་མཛད་དེ་བསྙེལ་གྱི་དོགས།",
    "དགུང་ལོ་ཞེ་བདུན་བཞེས་པའི་དུས་ཀྱི་ཚེ།",
    "རྙིང་མ་རྣམ་གཉིས་ཡིན་པར་ངེས་ཤེས་འདྲོངས།",
    "ཡོངས་སུ་རྫོགས་པར་གནང་ནས་ཐུགས་བསམ་ཀུན།",
    "བཞེད་དོན་མ་ལུས་འབད་མེད་འགྲུབ་པར་གྱུར།",
    "ཉེར་གསུམ་ཉིན་པར་དཔོན་པོ་རི་ཡི་ངོས།",
    "བསྙེལ་བ་གསོས་ཞིང་ཐུགས་ཀྱིས་ངེས་པར་གྱུར།",
    "མཚལ་ཁར་ལོ་གསུམ་བཞུགས་ནས་ཁྲིད་བསྐྱངས་ཤིང་།",
    "ས་སྐྱར་གསུང་ངག་རིན་ཆེན་གསུངས་པ་དང་།",
    "ཟངས་གདོང་འབྲོག་སིབ་གསུང་ངག་རིན་ཆེན་གསུངས།",
    "གདུལ་བྱ་མཐའ་དག་སྨིན་པར་མཛད་པ་ཡིན།",
    "སྔགས་འཆང་ཆེན་པོའི་གསུང་ལས་ངེས་པར་ཐོས།",
    "རབ་ཏུ་འགྱེད་པར་མཛད་ནས་གདུལ་བྱ་ཡི།",
    "ཤེས་བྱ་ཕལ་ཆེར་འབད་པ་ཆུང་ངུས་མཁྱེན།",
    "ཅེས་སོགས་རྒྱས་པར་གསུངས་པ་དེ་དག་རྣམས།",
    "ཁྱེད་ཀྱི་ཐུགས་ལ་མངའ་ཡང་མི་གསུངས་པར།",
    "དགོངས་ནས་ཁོང་ལ་ཚར་གཅིག་གསུངས་པའི་རྗེས།",
    "སྙག་མ་ཀློག་ཀྱང་ཞུ་བྱས་ཡུམ་སྲས་དང་།",
    "ཁྱད་པར་སྐུ་ལུས་མ་སྤངས་མཁའ་སྤྱོད་གཤེགས།",
    "གཉན་ཕུལ་ཆུང་པར་གྲགས།",
    "རྒྱ་མཚོའི་གོས་ཅན་དཔལ་དང་ལྡན་པར་བྱས།",
    "ཐུགས་རྗེ་ཆེ་ལྡན་དེ་ཡི་སློབ་བརྒྱུད་ལགས།",
    "གྲགས་པ་རྒྱལ་མཚན་ཞུ་བྱས་དངོས་གྲུབ་སོགས།",
    "དེ་ཡི་ལོངས་སྤྲུལ་རྣམ་གཉིས་བཞུགས་པའི་གནས།",
    "ཀུན་གྱི་འཁོར་ལོ་བདེ་མཆོག་ཞལ་བཞི་པར།",
    "ཞེས་སོགས་རྒྱས་པར་གསུངས་པ་དེ་དག་ཀྱང་།",
    "འཁྲུལ་མེད་ཡིན་ནོ་ངེས་ཤེས་ལྡན་པར་མཛོད།",
    "དེ་འདྲའི་གནས་མཆོག་ཁྱད་པར་འཕགས་པའི་དབུས།",
    "བཞུགས་ཁྲི་གསར་བཞེངས་ཡིད་འོང་ལྡན་པའི་སྟེང་།",
    "འགྲོ་བ་ཀུན་གྱི་འདྲེན་པ་དམ་པར་བཞུགས།",
    "ཡང་དག་མཐའ་དང་རྣམ་པར་ལྷན་བྱས་ནས།",
    "གཙོ་བོ་མགོན་པོ་མཆོག་ནི་ཐོབ་པར་འགྱུར།",
    "ཀུན་མཁྱེན་མཁྱེན་པས་ལེགས་པར་བསྒྲུབ་པ་ཡིས།",
    "ཞེས་གསུངས་འདི་ནི་རྡོ་རྗེ་ཕུག་པ་ཡི།",
    "ས་སྐྱར་བཞུགས་ཞེས་སྙན་པའི་གྲགས་པ་ཡིས།",
    "འཛམ་གླིང་ས་སྟེང་ཐམས་ཅད་ཁྱབ་པར་གསན།",
    "ལེགས་པར་སད་དེ་སྐད་ཅིག་དེ་ཉིད་ལ།",
    "ལེགས་པར་གསོལ་བ་བཏབ་པས་ཡོངས་རྫོགས་གནང་།",
    "དགེ་སྦྱོར་འཕེལ་ལམ་མཐུན་རྐྱེན་འཛོམས་སམ་གསུངས།",
    "འཛོམས་པར་བྱུང་སྟེ་ཆུ་ཉིད་ཅུང་ཟད་ཙམ།",
    "གནང་བ་མ་ཞུས་ཕྱིན་ན་བར་ཆད་འགྱུར།",
    "གསུངས་ནས་སྣང་བ་གདོང་གཏད་ཧད་དེ་བྱོན།",
    "དེ་སོགས་བརྟག་དཔྱད་ཁྱད་པར་འཕགས་པ་ཡོད།",
    "འགྲོ་བ་ཀུན་གྱི་སྐྱབས་མཆོག་དག་ཏུ་བཞུགས།",
    "རྒྱལ་པོ་དེ་གཉིས་ཐོག་མར་གྲོགས་མཆེད་བྱས།",
    "ཤིན་ཏུ་མཛའ་ཞིང་མཐུན་པར་ཡོད་པ་ལས།",
    "རི་སུལ་ནགས་གསེབ་གང་བྱུང་དག་ལ་བསྡད།",
    "གཎྜི་ཕྲག་པར་བཀལ་ནས་བྲོས་བྱུང་བས།",
    "བྱས་མ་ཐག་ཏུ་ངེད་རྣམས་ཧབ་ཤ་བྱེད།",
    "སྐུ་བརྙན་ཡོད་པར་འདི་ཉིད་རྒྱུ་གང་ཡིན།",
    "གང་ལ་ཅི་འཚམས་ལེགས་པར་བཞེངས་པ་ཡིན།",
    "ལེགས་པར་བབས་ནས་སྐུ་ལ་ཐིམ་པ་ན།",
    "རབ་གནས་བཀྲ་ཤིས་མཛད་དེ་བཞུགས་པ་ལ།",
    "ཤདྷ་ཀ་ར་ཝརྨ་ཞེས་བྱས་གནང་།",
    "ལེགས་པར་གནང་ཚེའང་གོང་བཞིན་འཕུར་ནས་ནི།",
    "མཧཱ་ཀཱ་ལའི་གནས་མཆོག་ཏུ་ཕེབས་ཏེ།",
    "ཕྱག་ཏུ་ལེགས་པར་བབས་པ་ཡིན་ནོ་ཀྱེ།",
    "གསུངས་ནས་ཅུང་ཟད་བཀྱོན་པའི་ཚུལ་བསྟན་པས།",
    "ཐུགས་ལས་མཛད་ཅིང་ཅུང་ཟད་བཞུགས་པའི་དུས།",
    "ཕྱག་དཔེ་ཚོ་ནི་གཅིག་ཀྱང་མ་གྱག་པར།",
    "ཐམས་ཅད་བརྩེ་བ་ཆེན་པོ་བཞུགས་སར་བབས།",
    "མལ་གྱོ་ཉིད་ལ་འབུལ་དུ་ཕེབས་པའི་ཚེ།",
    "གསུངས་བ་ཙམ་ལས་གཞན་ནི་བཀའ་མི་སྩལ།",
    "དེ་ནས་ས་སྐྱར་ཕེབས་བཞུགས་གནང་བའི་དུས།",
    "གསང་སྔགས་བྱ་བ་ལག་ལེན་གཙང་དགོས་སོ།",
    "ཞེས་ཞུས་དེ་ནས་ལྷོ་ལམ་བརྒྱུད་དེ་ཕེབས།",
    "ཕེབས་ས་ཀུན་ཏུ་ཇོ་སྲས་ས་སྐྱ་པ།",
    "གང་ཕེབས་ས་རུ་བརྙེད་བཀུར་ཞབས་ཏོག་དང་།",
    "དེ་ནས་གདན་ས་ཆེན་པོར་ཕེབས་པའི་ཚེ།",
    "ལེགས་པར་འབུལ་བསྐྱེལ་བྱེད་པར་ཕྱིན་པ་ན།",
    "དེ་སྐད་གསུངས་པ་ལྟ་བུ་སྔགས་པ་ལ།",
    "ལེགས་པར་གླེང་བས་སྔགས་པ་བང་ཆེན་དེས།",
    "དེ་སྐད་ཞུས་དང་བྱས་ནས་སླར་ཞུས་པས།",
    "གསུངས་པ་ལྟར་དུ་བང་ཆེན་ལ་བསྒྱུར་བས།",
    "གང་ཙམ་ཡོད་ཅེས་བལྟ་རྟོག་ཚུལ་གྱིས་གསུངས།",
    "བཅས་ཏེ་ལེགས་པར་ཕུལ་ཅིག་གསུངས་རྗེས་སུ།",
    "བླ་ཆེན་རང་ཡང་ཤིན་ཏུ་དགེས་པར་གྱུར།",
    "ཤིན་ཏུ་དགེས་ཤིང་དྲི་རྩད་མང་པོ་གནང་།",
    "སྐོར་ཅིག་ཡར་ལ་ངེས་པར་འབྱོན་པ་ཞུ།",
    "འབུལ་རྒྱུ་བདོག་པས་མྱུར་དུ་ཕེབས་ཞུས་ཅིག།",
    "ཅེས་གསུངས་བང་ཆེན་གྱིས་ཀྱང་མྱུར་བར་འོང་།",
    "ས་སྐྱར་སླེབས་ཏེ་ཇི་ལྟར་གསུངས་པ་རྣམས།",
    "ལེགས་སོའི་བྱ་དགའ་ཆེན་པོ་གནང་བར་མཛད།",
    "དེ་ནས་བླ་ཆེན་མལ་གྱིས་བཀའ་གནང་བཞིན།",
    "མྱུར་བར་ན་ལ་རྩེ་རུ་ཕེབས་པའི་ཚེ།",
    "ཞེས་གསུངས་ཐུགས་ཀྱི་ཉིང་ཁུ་མ་ལུས་པ།",
    "ལེགས་པར་གནང་ཞིང་ཁྱད་པར་མགོན་པོ་ཡི།",
    "རྗེས་གནང་སྐབས་སུ་སྐུ་ཡི་རྗེས་གནང་དུས།",
    "འཆམས་མགོན་ཡིད་བཞིན་ནོར་བུ་འདི་གནང་སྟེ།",
    "དེ་སྐད་གསུངས་ནས་མི་ལ་མི་གཏོད་པ།",
    "ཁམས་གསུམ་མ་ལུས་ཐམས་ཅད་སྐྲག་པར་མཛད།",
    "གསུམ་པ་ཐུགས་ཀྱི་རྗེས་གནང་གནང་དུས་སུ།",
    "ལྕགས་ཀྱི་རྡོ་རྗེ་རྩེ་དགུ་ལེགས་གནང་བ།",
    "ལེགས་པར་བསྡུས་པའི་བེའུ་བུམ་མ་ལུས་ཏེ།",
    "ལེགས་པར་གནང་སྟེ་ཅི་བསམ་ཐམས་ཅད་འགྲུབ།",
    "ལ་སྟོད་བརྒྱུད་ཅིང་ཕེབས་པར་མཛད་པའི་ཚེ།",
    "འཆམས་མགོན་ཕེབས་པའི་ལམ་ཉིད་ཡིན་པ་དང་།",
    "དེ་དང་མཚུངས་པར་གྲང་སོའི་ལ་ཡི་མིང་།",
    "ཁྲ་བོ་མ་ཡིན་ཁྲོ་བོ་ཡིན་པར་ནི།",
    "ལེགས་པར་ཕེབས་པས་གྲང་སོ་ཁྲོ་བོ་ལ།",
    "ལེགས་པར་དྲིལ་ནས་ཀུན་གྱིས་མི་མཐོང་བར།",
    "སྒོ་རུམ་གཟིམ་སྤྱིལ་དཀར་པོར་ཕེབས་པའི་ཚེ།",
    "ད་ལྟ་བཞུགས་སའི་གཟིམ་ཁང་འདི་ཉིད་དུ།",
    "ཅུང་ཟད་བཞུགས་བཅུག་དེ་ནས་མགོན་ཁང་སོགས།",
    "ཞལ་བཀོད་མཛད་ནས་བཞུགས་སུ་གསོལ་སྙམ་པས།",
    "ཞེས་སོགས་གསུངས་ཏེ་ད་ལྟའི་བཞུགས་ས་འདིར།",
    "ཀུན་གྱི་བསྒུལ་བསྐྱོད་མ་ནུས་དེ་ཁར་བཞུགས།",
    "བཞུགས་ལུགས་ཉིད་ཀྱང་འདྲོངས་པོ་མ་ཡིན་པའི།",
    "བཞུགས་ལུགས་སྔར་གྱི་ཡོན་པོ་དེ་ཁ་ལས།",
    "སུས་ཀྱང་བཟོས་བཅོས་མ་ནུས་དེ་ཁར་བཞུགས།",
    "ཕྱག་རྣམས་ལེགས་པར་བསིལ་རྗེས་དྲི་བཟང་དང་།",
    "བསྒྲུབ་ཆུ་རྣམས་ལ་ལེགས་པར་སྦྲུས་བྱས་ཏེ།",
    "ཞིག་གསོའི་རིགས་རྣམས་ལེགས་པར་གྲུབ་པའི་རྗེས།",
    "ཐམས་ཅད་བྲལ་ནས་ལྷུ་ལག་མ་འགྲིག་པར།",
    "མགོན་ཁང་ཕྱི་རུ་ཐམས་ཅད་བྲོས་པར་གྱུར།",
    "དེ་ཁར་བཞུགས་པས་ཡེ་ཤེས་མགོན་པོ་ཡི།",
    "ཤིན་ཏུ་འདྲོངས་པར་ལོ་གྲངས་དུ་མར་བཞུགས།",
    "དམ་ཚིག་གཙང་བཙོག་སྐྱེ་བོ་དུ་མ་ཞིག།",
    "ལེགས་པར་གནང་རྗེས་སྐུ་ངོས་གཅིག་པུ་ཡིས།",
    "བསྐང་བཤགས་དམིགས་སུ་གང་འགྲོ་གནང་བ་ཞུ།",
    "བདག་ཀྱང་ཞག་བདུན་གོང་དུ་སླེབ་ཡོང་ལགས།",
    "ཕྱག་ལེན་གནང་རྒྱུ་ཡིན་ཡང་དེ་ཡི་ཉིན།",
    "བྱེད་པར་བརྩམས་ཏེ་ཐོག་མར་སྙན་དར་རྣམས།"
  ]
}