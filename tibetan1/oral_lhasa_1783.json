    "འགྲིབ་པས་མ་དམིགས་ཡང་དག་པར་རྗེས་སུ་མན།",
    "འགྲིབ་པ་མ་ངམགས་ཡང་དག་པར་རྗེས་སུ་མམཐོང་།",
    "དེ་ནས་བཟུང་སྟེ་དེ་ནི་ཐོབ་པར་གྱུར་པ་ཡིས།",
    "འཇིག་རྟེན་ཁམས་བརྒྱ་ཀུན་ནས་གཡོ་བར་ནུས་པར་གྱུར་པའང་ཡིན།",
    "དེ་ཚེ་འདི་ཡི་ངན་འགྲོའི་ལམ་རྣམས་མཐའ་དག་འགག་པར་འགྱུར།",
    "དང་པོ་སྦྱིན་པ་ཉིད་ནི་ལྷག་པར་འགྱུར།",
    "རང་ཤ་སྟེར་ལའང་གུས་པར་བྱས་པ་ཡིས།",
    "ལོངས་སྤྱོད་ཀྱང་ནི་སྦྱིན་ལས་འབྱུང་མཁྱེན་ནས།",
    "དེ་ནས་སྲིད་རྒྱུན་ཡང་དག་བཅད་བྱས་ཏེ།",
    "འགྲོ་ལ་ཕན་པར་དམ་བཅས་ཡིད་ཅན་རྣམས།",
    "དམ་པའི་ལས་ལམ་བཅུ་ཆར་གསོག་པར་བྱེད།",
    "དེ་ལ་ཀླགས་ཏེ་ཤིན་ཏུ་དག་པར་འགྱུར།",
    "གལ་ཏེ་འདིར་བདག་འཛིན་པར་མི་བྱེད་ན།",
    "འབྲས་བུ་ཉེར་སྤྱོད་ཆད་པ་མེད་པར་འགྱུར།",
    "རྒྱལ་སྲས་རྣམས་ཀྱི་ངེས་པར་ལེགས་པ་དང་།",
    "བཟོད་པ་གཅོད་པར་བྱེད་ལ་ལྷག་པར་སྐྱེ།",
    "མཐོང་བ་དེས་ཀྱང་དེ་ཡིས་བཟོད་པར་འགྱུར།",
    "གནོད་པ་བྱས་པས་གལ་ཏེ་དེར་བཀོན་ན།",
    "དེ་ལ་བཀོན་པས་བྱས་ཟིན་ལྡོག་གམ་ཅི།",
    "དེ་ཕྱིར་དེར་བཀོན་ངེས་པར་འདིར་དོན་མེད།",
    "འཇིག་རྟེན་ཕ་རོལ་ཡང་ནི་འགལ་བར་འགྱུར་། སྔོན་བྱས་པ་ཡི་མི་དགེའི་ལས་ཀྱི་འབྲས་བུ་གང་།",
    "ཟད་པར་བྱེད་པར་བརྗོད་པར་འདོད་པ་དེ་ཉིད་ཀོ།",
    "ས་བོན་ཉིད་དུ་ཇི་ལྟ་བུར་ན་འཁྲིད་པར་བྱེད།",
    "མི་སྡུག་གཟུགས་སུ་བྱེད་ཅིང་དམ་པ་མིན་པར་བཀྲི།",
    "མཁས་པར་འགྱུར་ཞིང་དེ་ཡི་འོག་ཏུ་ནི།",
    "ཁྲོ་དང་བཟོད་པའི་སྐྱོན་ཡོན་རིག་བྱས་ཏེ།",
    "འདོད་ཆགས་ཞེ་སྡང་ཡོངས་སུ་ཟད་པར་འགྱུར།",
    "འདོད་པའི་འདོད་ཆགས་འཇོམས་པར་ནུས་པར་འགྱུར།",
    "རྒྱལ་བའི་སྲས་པོ་ཉི་མ་ལ་གནས་འོད་བྱེད་འདི་། རང་གཏོགས་མུན་རྣམས་དང་པོ་ཡང་དག་བསལ་བྱས་ནས།",
    "སྦྱང་དཀའི་ས་ལ་ཕམ་པར་ནུས་མ་ཡིན།",
    "མངོན་དུ་ཕྱོགས་པར་མཉམ་བཞག་སེམས་གནས་ཏེ།",
    "ཤེས་རབ་གནས་པས་འགོག་པ་ཐོབ་པར་འགྱུར།",
    "ཇི་ལྟར་གནས་པའི་ལུགས་བཞིན་བརྗོད་པར་བྱ།",
    "དེ་ལ་དམ་པའི་དོན་གྱི་བདེན་པ་བསྟན་པར་བྱ།",
    "དེ་ནི་དོན་དུ་གཉེར་བས་ལམ་འདི་མཉན་པར་གྱིས།",
    "སྐྱེས་པར་གྱུར་པ་སླར་ཡང་སྐྱེ་བར་རིགས་པའང་མ་ཡིན་ཉིད་། སྐྱེས་ཟིན་སླར་ཡང་སྐྱེ་བར་ཡོངས་སུ་རྟོག་པར་འགྱུར་ན་ནི།",
    "ས་བོན་སྲིད་མཐར་ཐུག་པར་རབ་ཏུ་སྐྱེ་བ་ཉིད་དུ་འགྱུར།",
    "ཇི་ལྟར་དེ་ཉིད་ཀྱིས་དེ་རྣམ་པར་འཇིག་པར་བྱེད་པར་འགྱུར།",
    "བདག་ལས་སྐྱེ་བར་འདོད་ན་བསྐྱེད་པར་བྱ་དང་སྐྱེད་བྱེད་དང་།",
    "སྐྱེད་པར་བྱེད་པ་མ་ཡིན་མ་ལུས་ལ་ཡང་གཞན་ཉིད་མཚུངས།",
    "གང་ཞིག་དེ་སྐྱེད་ནུས་པ་དེ་ནི་གཞན་ནའང་རྒྱུ་ཡིན་ལ་། རྒྱུད་གཅིག་གཏོགས་དང་སྐྱེད་པར་བྱེད་ལས་སྐྱེ་བ་དེ་ཡི་ཕྱིར།",
    "སཱ་ལུའི་མྱུ་གུའི་སྐྱེད་པར་བྱེད་པར་འདོད་མིན་ནུས་ལྡན་མིན།",
    "གཞན་ཉིད་མེད་པར་ས་བོན་གཞན་པ་ཉིད་དུ་ག་ལ་འགྱུར།",
    "དེས་ན་མྱུ་གུ་ས་བོན་ལས་སྐྱེ་འགྲུབ་པར་འགྱུར་མིན་པས།",
    "དུས་མཉམ་མ་ཡིན་པར་ནི་མིན་པར་མཐོང་བ་དེ་བཞིན་དུ།",
    "འགག་བཞིན་པ་ནི་ཡོད་ཀྱང་འཇིག་ལ་ཕྱོགས་པར་འདོད་གྱུར་པ།",
    "སྐྱེ་བ་འདི་ནི་བྱེད་པོ་མེད་པར་རིགས་པའི་ངོ་བོའང་མིན།",
    "སྐྱེད་པར་བྱེད་པ་བསྐྱེད་བྱ་གཞན་སྐྱེད་པ་དེ་རྒྱུ་ཡིན་ན།",
    "དངོས་རྙེད་ངོ་བོ་གཉིས་ནི་འཛིན་པར་འགྱུར་། ཡང་དག་མཐོང་ཡུལ་གང་དེ་དེ་ཉིད་དེ།",
    "མཐོང་བ་རྫུན་པ་ཀུན་རྫོབ་བདེན་པར་གསུངས།",
    "འཇིག་རྟེན་ཉིད་ལས་ལོག་པར་རྣམ་པར་བཞག།",
    "དེས་གང་བཅོས་མ་བདེན་པར་སྣང་དེ་ནི།",
    "ཀུན་རྫོབ་བདེན་ཞེས་ཐུབ་པ་དེས་གསུངས་ཏེ།",
    "ཐ་སྙད་བདེན་ལ་རྣམ་པར་དཔྱད་མི་བྱ།",
    "རབ་རིབ་ཅན་གྱིས་སྐྲ་ཤད་རྣམ་པར་ནི།",
    "རིག་པར་མི་འགྱུར་གང་ཡིན་དེ་ལའོ།",
    "གཟུང་བ་མེད་པར་འཛིན་པ་མ་མཐོང་ཞིང་།",
    "དངོས་པོ་བཏགས་པར་ཡོད་པའི་རྒྱུར་འགྱུར་ཞིང་། ཕྱི་རོལ་གཟུང་བ་མེད་པར་འབྱུང་འགྱུར་ལ།",
    "སད་པར་གྱུར་ན་གསུམ་ཆར་ཡོད་མིན་ལྟར།",
    "གལ་ཏེ་ཤེས་བྱ་མེད་པར་བློ་ཡོད་ན།",
    "ཁྱད་པར་མེད་པར་ཁྱད་པར་ཅན་ཡོད་མིན།",
    "ནུས་པ་མེད་པར་འདི་ཡི་འབྱུང་འགྱུར་མེད།",
    "གྲུབ་མིན་ཉིད་ཅེས་དམ་པ་རྣམས་ཀྱིས་གསུངས།",
    "རྨི་ལམ་ན་ནི་གཟུགས་དོན་གཞན་མེད་པར།",
    "ཕྱི་རོལ་མེད་པར་ཡིད་ནི་ཡོད་ཅེ་ན།",
    "ཇི་ལྟར་མིག་མེད་པར་ནི་རྨི་ལམ་དུ།",
    "ནུས་པ་སྨིན་ཡོད་སད་པར་མེད་གྱུར་ན།",
    "དེར་ཡང་གསུམ་ཆར་སྐྱེ་བ་མེད་པར་མཐོང་།",
    "ལོག་པ་ཡིད་ལ་བྱེད་པར་བསྟན་ཕྱིར་རོ།",
    "རྟོགས་འགྱུར་དེ་ནི་བརྫུན་པར་ཡང་མི་འགྱུར།",
    "བློ་ཡང་མེད་ཅེས་དོན་འདི་ཤེས་པར་གྱིས།",
    "མ་གྲུབ་བསྒྲུབ་པར་བྱ་ཕྱིར་བརྗོད་པ་ཡི།",
    "མ་གྲུབ་འདི་ནི་སྒྲུབ་པར་བྱེད་པ་མིན།",
    "གཏན་ཚིགས་འདིས་ནི་ཁྱད་པར་དག་ཀྱང་འཇོམས།",
    "དེ་ཉིད་ཀྱིས་དེ་འཛིན་པར་རིགས་མ་ཡིན།",
    "འཇིག་རྟེན་ངོར་བྱས་བདག་ནི་སྨྲ་བར་བྱེད།",
    "འཇིག་རྟེན་ཉིད་ལྟོས་འདི་ནི་དགག་པར་གྱིས།",
    "བྱེད་པ་པོ་ནི་སེམས་ཙམ་ཡིན་པར་རྟོགས།",
    "རྡོ་རྗེ་འདི་ནི་དགོངས་པ་བཅད་ཕྱིར་གསུངས།",
    "རྒྱལ་བས་སེམས་ཙམ་འཇིག་རྟེན་བྱེད་པོར་གསུངས།",
    "གལ་ཏེ་འདི་དག་སེམས་ཙམ་ཞེས་མཁྱེན་ནས།",
    "དེ་ལས་གཟུགས་ཉིད་དགག་པར་མཛད་ན་ནི།",
    "གཏི་མུག་ལས་ལས་སྐྱེས་པར་ཅི་ཕྱིར་གསུངས།",
    "སྣོད་ཀྱི་འཇིག་རྟེན་ཤིན་ཏུ་སྣ་ཚོགས་འགོད་། འགྲོ་བ་མ་ལུས་ལས་ལས་སྐྱེས་པར་གསུངས།",
    "སེམས་ནི་སྣ་ཚོགས་སྣང་ངོ་ཞེས་གསུངས་པ།",
    "འདི་ནི་སྟོན་པས་དྲང་དོན་ཉིད་གསུངས་ཤིང་།",
    "དྲང་དོན་གསུངས་པའང་རྟོགས་ནས་དྲང་བྱ་ཞིང་།",
    "གལ་ཏེ་འགྲོ་བ་རྒྱུ་ཡིས་སྟོང་པར་གྱུར་ན་ནམ་མཁའ་ཡི།",
    "དེས་ནི་ཇི་ལྟར་འཇིག་རྟེན་ཕ་རོལ་ཡང་དག་རྟོགས་པར་འགྱུར།",
    "འཇིག་རྟེན་ཕ་རོལ་འགོག་པར་བྱེད་པའི་དུས་སུ་བདག་ཉིད་ནི།",
    "འདུས་བྱས་ལྟ་ཞིག་སྣ་ཚོགས་བློ་གྲོས་ཀྱིས་ནི་རྟོགས་པར་འགྱུར།",
    "གལ་ཏེ་གཏི་མུག་བརྟེན་ནས་ལས་འབྱུང་གཏི་མུག་མེད་པར་དེ།",
    "མི་འབྱུང་ཞེས་བྱར་མི་མཁས་ཁོ་ནས་རྟོགས་པར་གོར་མ་ཆག།",
    "བློ་བཟང་ཉི་མས་མུན་པ་སྟུག་པོ་རྣམ་པར་བསལ་བ་ཡི།",
    "ཡོངས་སུ་མྱ་ངན་འདས་པ་གསུངས་གྱུར་པ།",
    "བུམ་སོགས་འདི་དག་དེ་ཉིད་དུ་མེད་ཅིང་། འཇིག་རྟེན་རབ་ཏུ་གྲགས་པར་ཡོད་ཇི་བཞིན།",
    "རྟོག་པ་འདི་དག་བརྟག་པར་མི་ནུས་པ་། དེ་ཕྱིར་རྟེན་འབྱུང་རིགས་པ་འདི་ཡིས་ནི།",
    "ལྟ་ངན་དྲྭ་བ་མཐའ་དག་གཅོད་པར་བྱེད།",
    "དངོས་པོ་ཇི་ལྟར་མེད་པར་ཡོངས་དཔྱད་ཟིན།",
    "དངོས་པོ་མེད་པར་འདི་རྣམས་མི་འབྱུང་དཔེར།",
    "རྟོག་རྣམས་ལོག་པར་གྱུར་པ་གང་ཡིན་དེ་། རྣམ་པར་དཔྱོད་པའི་འབྲས་བུར་མཁས་རྣམས་གསུང་།",
    "གཞན་གཞུང་འཇིག་པར་འགྱུར་ན་ཉེས་པ་མེད།",
    "བདག་ནི་འདི་ཡི་ཡུལ་དུ་རྟོགས་བྱས་ནས།",
    "རྣལ་འབྱོར་པ་ཡིས་བདག་ནི་འགོག་པར་བྱེད།",
    "མྱ་ངན་འདས་ཚེ་ངེས་པར་བདག་ཆད་འགྱུར།",
    "དེ་ཚེ་ངེས་པར་དངོས་རྣམས་མེད་པར་འགྱུར།",
    "གཟུགས་སོགས་དེ་ཉིད་རྟོགས་པར་མི་འགྱུར་ཞིང་།",
    "གསུངས་པ་དེ་ཕྱིར་ཕུང་པོ་བདག་འདོད་ན།",
    "དེས་གསུངས་དེ་ཕྱིར་དེ་ནི་དེ་རྣམས་དང་།",
    "འདི་ནི་ཕུང་པོ་རྣམས་བརྟེན་འགྲུབ་པར་འགྱུར།",
    "མི་བདེན་པ་ཡི་རྒྱུ་ལ་བརྟེན་བྱས་ནས།",
    "ཐམས་ཅད་ཀྱང་ནི་སྐྱེ་བར་ཤེས་པར་གྱིས།",
    "རྣམ་དཔྱད་མེད་པར་འཇིག་རྟེན་ཉིད་ལས་འདིར།",
    "འདིར་དེའི་གྲུབ་པ་དེ་བཞིན་འདོད་པར་བྱ།",
    "མ་བརྟགས་གྲགས་པར་གཏི་མུག་ལས་ཡིན་ནོ།",
    "རྣལ་འབྱོར་པ་དེ་རྣམ་པར་གྲོལ་བར་འགྱུར།",
    "དེ་རྣམས་ཤིང་རྟའི་རྣམ་དཔྱད་བྱས་པས་རྣམ་བདུན་ཡོད་པ་མ་ཡིན་ཞིང་།",
    "དེ་ལས་གཞན་དུ་གྱུར་པར་འཇིག་རྟེན་གྲགས་པའི་སྒོ་ནས་ཡོད་པ་ཡིན།",
    "གལ་ཏེ་རྒྱུ་ཡིས་བསྐྱེད་པར་བྱ་སྐྱེད་དེ་ལྟ་ན་དེ་རྒྱུ་ཡིན་ཞིང་།",
    "གཉིས་པོ་འདི་དག་སྤངས་ནས་རྟོག་པ་གཞན་ཡང་ཡོད་པར་འགྱུར་མ་ཡིན།",
    "སུན་འབྱིན་འདིས་སུན་དབྱུང་བྱ་ཕྲད་ནས་འབྱིན་ནམ་མ་ཕྲད་པར།",
    "རིགས་པ་མེད་པར་དངོས་མཐའ་དག་ལ་སྐུར་འདེབས་དེ་ཡི་ཕྱིར།",
    "ངེས་པར་ཕྱོགས་ཡོད་དེ་ལ་འགྱུར་གྱི་བདག་ལ་ཕྱོགས་འདི་ནི།",
    "ཉི་མ་དང་ནི་གཟུགས་བརྙན་རྣམ་པར་ཕྲད་དང་མ་ཕྲད་པར།",
    "འཐད་པ་དང་བྲལ་ལས་ཀྱང་བསྒྲུབ་བྱ་རྟོགས་ཞེས་ཤེས་པར་བྱ།",
    "དངོས་རྣམས་མཐའ་དག་དངོས་པོ་མེད་པར་རྟོགས་སུ་གཞུག་པར་ནི།",
    "ནུས་པར་ཆེས་སླ་ཇི་ལྟ་དེ་ལྟར་རང་བཞིན་གཞན་དག་ལ།",
    "ཁོང་དུ་ཆུད་པར་བདེ་བླག་ཏུ་ནི་ནུས་པ་མ་ཡིན་ནོ།",
    "སུན་འབྱིན་ལྷག་མ་གོང་དུ་བསྟན་པ་ཡང་ནི་ཤེས་བྱས་ནས།",
    "གདུལ་བྱ་རྣམས་ལ་ཕྱེ་སྟེ་རྣམ་མང་གསུངས།",
    "སྤྲོས་དང་བཅས་པར་སྟོང་པ་ཉིད།",
    "ལུས་དང་ཡིད་ཀྱང་བསྙད་པར་བྱ།",
    "ངོ་བོས་སྟོང་པར་འདོད་པ་ཡིན།",
    "འཛིན་པ་བཟློག་ཕྱིར་གསུངས་པ་ཡིན།",
    "ཆེན་པོར་འཛིན་པ་བཟློག་ཕྱིར་གསུངས།",
    "འཛིན་པ་བཟློག་པར་བྱ་བའི་ཕྱིར།",
    "དོན་དམ་མཁྱེན་པས་དོན་དམ་པ།",
    "སྟོང་པ་ཉིད་ནི་བསྟན་པར་མཛད་། རྐྱེན་ལས་བྱུང་ཕྱིར་ཁམས་གསུམ་པོ།",
    "དེ་དག་མེད་པ་འདུས་མ་བྱས།",
    "དེ་ནི་མཐའ་ལས་འདས་པར་བརྗོད།",
    "ཐོག་མ་མཐའ་མ་མེད་པར་བརྗོད།",
    "བསྟན་བཅོས་ལས་ནི་ངེས་པར་བསྙད།",
    "འབོར་བ་ལ་ནི་ངེས་པར་བརྗོད།",
    "འདུས་བྱས་ལ་སོགས་ངོ་བོ་ཉིད།",
    "མ་མཛད་དེའི་ཕྱིར་འདུས་བྱས་ལ།",
    "སྐྱེ་བའི་སྒོར་གྱུར་ཉིད་དུ་གསུངས།",
    "མཚན་ཉིད་འདི་དག་ཡིན་པར་བརྗོད།",
    "དེ་དག་ཡང་དག་མཁྱེན་པ་ཡིས།",
    "མ་འཁྲུག་མཚན་ཉིད་ཅན་དུ་གསུངས།",
    "མཚན་ཉིད་རྣམ་པར་གྲོལ་བྱེད་པའོ།",
    "སྟོབས་རྣམས་ཤིན་ཏུ་རྣམ་པར་ནི།",
    "གཏན་ལ་འབེབས་པའི་རང་བཞིན་གསུངས།",
    "རྣམ་ཀུན་མཁྱེན་ཉིད་ཡེ་ཤེས་ནི།",
    "གང་ཞིག་འདུས་བྱས་མཚན་ཉིད་དང་།",
    "འདུས་མ་བྱས་པའི་མཚན་ཉིད་གང་།",
    "འདི་ལྟར་རང་བཞིན་མ་བྱས་པས།",
    "དེ་ལྟར་བློ་གྲོས་ཟེར་གྱིས་སྣང་བ་གསལ་བྱས་པའི།",
    "སྲིད་གསུམ་འདི་དག་མ་ལུས་གདོད་ནས་སྐྱེ་མེད་པར།",
    "རྟོགས་ཏེ་ཐ་སྙད་བདེན་པའི་སྟོབས་ཀྱིས་འགོག་པར་འགྲོ།",
    "མ་ལུས་པ་རྣམས་བློ་ཡིས་ཕམ་པར་བྱེད་པའང་ཡིན།",
    "སྐད་ཅིག་ལ་ནི་འགོག་པར་འཇུག་འགྱུར་ཞིང་།",
    "འབྱོར་པ་མཁའ་ལྟར་མཐའ་བྲལ་མ་ལུས་འཐོབ་པར་ནུས་མ་ཡིན།",
    "དགུ་པ་ལ་ནི་དེའི་སྟོབས་ལྟ་ཞིག་མཐའ་དག་རྫོགས་པར་དག་འགྱུར་ཞིང་།",
    "དམ་པ་འཐོབ་ཅིང་ཡེ་ཤེས་ལྷག་པར་མཆོག་ཏུ་བྱུང་བར་གྱུར་པའང་ཡིན།",
    "བློ་ལྡན་ཏིང་འཛིན་བརྒྱ་ཕྲག་སྙོམས་པར་འཇུག་ཅིང་གཏོང་བྱེད་དེ།",
    "ཐོབ་པར་གྱུར་ནས་དེ་བཞིན་ཁོ་ནར་དྲི་མ་མེད་གནས་པས།",
    "དེ་དག་སྟོང་ནི་ཡང་དག་འཐོབ་པར་འགྱུར་ཏེ་ས་ལྔ་པོ།",
    "ཁྲག་ཁྲིག་ཕྲག་བརྒྱར་རྫོགས་པར་བསྒྱུར་དང་སླར་ཡང་སྟོང་ཕྲག་ཏུ།",
    "ཡང་དག་པར་ནི་བསྒྱུར་བ་མཐའ་དག་རབ་ཏུ་འཐོབ་པར་འགྱུར།",
    "གྲངས་མཉམ་ཡོན་ཏན་དག་ནི་འཐོབ་པར་འགྱུར།",
    "གྲངས་མེད་བརྒྱ་ཕྲག་སྟོང་དུ་ཡང་དག་པར་། བསྡོམས་པ་ཕྲག་བཅུའི་རྡུལ་ཚད་ཐོབ་པར་འགྱུར།",
    "སྐད་ཅིག་སྐད་ཅིག་ལ་ནི་སྟོན་པར་ནུས།",
    "དངོས་བྱས་དབྱེ་བ་འགའ་ཡང་དེ་ཉིད་ལ་མེད་དེ་ཡི་ཕྱིར་། རོ་མཉམ་ཉིད་དུ་ཡང་དག་ཐུགས་སུ་ཆུད་པར་མཛད་གྱུར་ན།",
    "བློ་མ་ཞུགས་པར་ཤེས་བྱའི་ཡུལ་ཅན་ངེས་པར་རིགས་པའང་མ་ཡིན་ལ།",
    "ཀུན་ནས་ཤེས་མེད་པ་ནི་ཤེས་པར་ཇི་ལྟར་འགྱུར་ཏེ་འགལ་བར་འགྱུར།",
    "མཁྱེན་པོ་མེད་པར་ཁྱེད་ཀྱིས་གཞན་ལ་འདི་ལྟའོ་ཞེས་སུ་ཞིག་སྟོན་། གང་ཚེ་སྐྱེ་མེད་དེ་ཉིད་ཡིན་ཞིང་བློ་ཡང་སྐྱེ་བ་དང་བྲལ་བ།",
    "ཁྱད་པར་གྱིས་འཕངས་ལས་ཆེས་བསམ་མི་ཁྱབ།",
    "མ་ལུས་ཀྱིས་བཀྲ་མཐའ་དག་སྟོན་པར་མཛད།",
    "གང་དག་ད་ལྟར་ནམ་མཁའི་མཐར་ཐུག་པར།",
    "འགྲོ་དབུགས་འབྱིན་ཞིང་འཇིག་རྟེན་བཞུགས་པ་དང་།",
    "རང་བཞིན་མཁྱེན་ནས་བདག་བཞིན་བ་སྤུ་ཡི།",
    "གནས་དང་གནས་མིན་མཁྱེན་སྟོབས་དང་།",
    "མཁྱེན་དང་ཐམས་ཅད་དུ་འགྲོ་དང་།",
    "སྔོན་གནས་དྲན་པ་མཁྱེན་པ་དང་། དེ་བཞིན་འཆི་འཕོ་སྐྱེ་བློ་དང་།",
    "ཟག་རྣམས་ཟད་པ་མཁྱེན་སྟོབས་ཏེ།",
    "རྒྱུ་གང་ཞིག་ལས་གང་ཞིག་ངེས་པར་སྐྱེ་འགྱུར་བ།",
    "དེ་ནི་དེ་ཡི་གནས་སུ་དེ་མཁྱེན་རྣམས་ཀྱིས་གསུངས།",
    "མཁྱེན་པ་ཐོགས་པ་སྤངས་པ་དེ་ནི་སྟོབས་སུ་བཤད།",
    "མཁྱེན་པ་ནུས་མཐུ་ཐོགས་མེད་སོ་སོར་འཇུག་འགྱུར་བ།",
    "མིག་སོགས་རྣམས་ཀྱི་རང་བཞིན་གང་དེ་ཁམས་སུ་གསུངས།",
    "རྣམ་ཀུན་ཁམས་ཀྱི་ཁྱད་པར་ལ་འཇུག་སྟོབས་སུ་འདོད།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཆགས་མེད་སྟོབས་སུ་གསུངས།",
    "དེ་ལ་མཁྱེན་པ་ཆགས་མེད་མཐའ་ཡས་སྟོབས་སུ་འདོད།",
    "སྙོམས་འཇུག་ཁྱད་པར་གང་དག་གཅིག་དང་བརྒྱད་གྱུར་པ།",
    "དེ་ལ་མཁྱེན་པ་ཐོགས་མེད་འདི་ནི་སྟོབས་སུ་བཤད།",
    "བཀྲ་མང་དེ་ལ་མཁྱེན་པ་དུས་དེར་འཇུག་པ་ཡིས་། མ་ཆགས་རྣམ་ཀུན་ཡོངས་དག་མཐའ་ཡས་སྟོབས་སུ་འདོད།",
    "རྣམ་ཀུན་མཁྱེན་པའི་སྟོབས་ཀྱིས་མྱུར་དུ་རྒྱལ་རྣམས་ཀྱི།",
    "དེ་ལ་མཁྱེན་པ་ཆགས་མེད་མཐའ་ཡས་སྟོབས་སུ་འདོད།",
    "ནམ་མཁའ་མེད་པས་འདབ་ཆགས་ལྡོག་པར་མི་འགྱུར་གྱི།",
    "འདི་ནི་རང་མཐུ་ཟད་པས་ལྡོག་པར་འགྱུར་དེ་བཞིན།",
    "ཡོན་ཏན་མཁའ་ལྟར་མཐའ་ཡས་མ་བརྗོད་ལྡོག་པར་འགྱུར།",
    "ཤེས་པ་དང་ནི་བརྗོད་པར་ནུས་འགྱུར་རམ་། འོན་ཀྱང་དེ་དག་འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱིས།",
    "མང་པོས་བཅིངས་པ་མ་ལུས་ཐུགས་རྗེས་མྱ་ངན་འདས་པར་བཀྲི་བར་མཛད།",
    "སྦྱར་ཞིང་རྣམ་པར་དབེན་ལའང་བློ་སྦྱངས་རྣམས་ལ་ལོགས་སུ་གསུངས།",
    "ཕྲ་རབ་རྡུལ་གྱི་རྡུལ་རྣམས་བདོག་པར་གྱུར་པ་ཇི་སྙེད་པ།",
    "དེས་ན་མགོན་པོ་མཆོག་ཏུ་རབ་ཞིར་གཤེགས་པར་འགྱུར་མ་ལགས།",
    "མེད་ཅེས་མཁས་རྣམས་ངེས་པར་མཛོད།",
    "ལེའུར་བྱས་པའི་ཁ་འབུས་ཀུ་མུ་ཏ་ཁ་ཕྱེ་བའི་ཆུས།",
    "ངེས་པར་རྟོགས་འགྱུར་འདི་ནི་གསན་རྒྱ་ཆེ་ཡང་གཞན་གྱིས་ཐུགས་སུ་ཆུད་མི་འགྱུར།",
    "མི་འཕྲོག་པའི་མཁྱེན་རབ་དང་ཐུགས་རྗེ་མངའ་བ།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་བན་དེ་པ་ཚབ་ཉི་མ་གྲགས་ཀྱིས་ཁ་ཆེའི་དཔེ་དང་མཐུན་པར་བསྒྱུར།",
    "ལོ་ཙཱ་བ་དེ་ཉིད་ཀྱིས་ཉི་འོག་ཤར་ཕྱོགས་པའི་དཔེ་དང་གཏུགས་ཤིང་ལེགས་པར་བཅོས་ཏེ་གཏན་ལ་ཕབ་པའོ།",
    "ཚོགས་གཉིས་རྫོགས་ནས་བཅོམ་ལྡན་འདས་མི་གཡོ་བར་ཀྲོང་ངེ་གྱུར་པར་བསྒོམ།",
    "དེ་ནས་རང་བཞིན་གྱི་གནས་ནས་བཅོམ་ལྡན་འདས་མི་གཡོ་བ་ཡེ་ཤེས་སེམས་དཔའ་ཚོན་གང་བ་གཅིག་སྤྱི་བོའི་སྟེང་དུ་བྱོན་པར་བསམ།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་བཟླས་པར་འགྲོ་བ་ཡིན།",
    "སྟོང་པ་ཉིད་བསྒོམས་པ་དེ་ཐུགས་ཀྱི་བཟླས་པ་ཡིན་གསུངས།",
    "སྔར་བསྟིམ་པའི་སེམས་དཔའ་ཚོན་གང་བ་དེ་སྤྱི་བོའི་སྟེང་ན་བཞུགས་པར་བསམས་ལ།",
    "ད་ལྟའི་སྣང་བ་འདི་རྨི་ལམ་སྒྱུ་མ་ལྟ་བུར་བསྒོམ་གསུངས།",
    "གྲོགས་ངན་བསྟེན་པར་མི་བྱ་སྟེ།",
    "ལེགས་པར་སྨྲས་ཀྱང་ཉེས་པར་འགྲོ།",
    "གང་ཞིག་མ་བརྟགས་པར་སྨྲ་བ།",
    "ནམ་ཡང་བརྗོད་པར་མི་བྱའོ།",
    "བདག་མི་ཕན་པར་གཞན་གནོད་པ།",
    "བརྫུན་གྱི་ཚིག་རྣམས་བརྗོད་བྱས་ན།",
    "དེ་ནི་བཙུན་པར་མི་འགྱུར་ཏེ།",
    "འདོད་དོན་མེད་པར་བསླུས་པར་འགྱུར།",
    "འོ་མ་མེད་པར་གྱུར་པའི་བ།",
