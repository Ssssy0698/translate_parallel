    "ད་དུང་མཚོ་བོད་ས་ཕྱོགས་ཁག་ནས་ཕེབས་པའི་བོད་རིགས་ཀྱི་མཇལ་སྐོར་པའང་ཡོད།",
    "ལ་ལས་བང་སོའི་དྲུང་དུ་དྲན་རྟེན་འདྲ་པར་རྒྱག་པ།",
    "འཕྱིང་ཡུལ་དར་ཐང་ངར་ཐང་ཞེས་ཀྱང་སྣང་སོགས་ཡིན་པར་བཤད།",
    "ད་ལྟ་དངོས་སུ་མཇལ་རྒྱུ་ཡོད་པའི་བང་སོ་མང་ཆེ་བའི་ཐོག་མའི་དབྱིབས་ནི་གྲུ་བཞི་ཁ་གང་མའི་ཚུལ་དུ་ཡོད་པར་སྣང་ལ།",
    "ཆུ་མགོ་ཡུལ་ཚོའི་ལྷོ་ནས་བྱང་དུ་རྒྱུག་པའི་གཙང་བོའི་ལྷོ་ངོས་སུ་བང་སོ་ཆེན་པོ་ཞིག་ཡོད་པ་ནི།",
    "སྙན་པའི་གྲགས་པ་འཛམ་གླིང་དུ་ཁྱབ་པའི་བཙན་པོའི་གདུང་རྒྱུད་སོ་གཉིས་པ་སྲོང་བཙན་སྒམ་པོའི་བང་སོ་ཡིན་པར་གྲགས།",
    "སྐུ་དེ་བང་སོའི་ནང་དུ་བཞུགས་པར་མཛད།",
    "བང་སོ་ནང་རྒྱན་ཅན་དུ་གྲགས་པར་གྱུར།",
    "ནང་དུ་ལྷ་ཁང་ལྔ་ཡང་བཞུགས་སོ་ཟེར།",
    "གནའ་རྫས་རྟོག་ཞིབ་པས་ཐིག་ལེན་བྱས་པར་གཞིགས་ན།",
    "སྲོང་བཙན་བང་སོའི་ཞེང་ཚད་ལ་སྤྱི་ཁྲེ་དང་དཀྱུས་ལ་སྤྱི་ཁྲེ་ཡོད་པར་བཤད།",
    "ད་ལྟའི་སྲོང་བཙན་བང་སོའི་སྟེང་ཆགས་པའི་ལྷ་ཁང་དེ་བང་སོ་བཞེངས་པའི་དུས་སུ་མེད་པར་སྣང་ལ།",
    "ཐོན་མི་སམ་བྷོ་ཊ་སོགས་མཇལ་རྒྱུ་ཡོད་པར་བཤད།",
    "ནང་དུ་ལྷ་ཁང་ལྔ་ཡི་བཞུགས་སུ་གསོལ།",
    "ཆབ་སྲིད་ཐད་བྱས་རྗེས་དེ་ཙམ་མེད་པར་མངོན་ཞིང་།",
    "དེ་ཡི་བང་སོ་ཡབ་མེས་སྲོང་བཙན་གྱི་བང་སོའི་འགྲམ་དུ་བརྩིགས་པར་མངོན་ནོ།",
    "ཀྐཱལྡེ་གཙུག་བརྟན་མེས་ཨག་ཚོམ་གྱི་སྲས་ལྗང་ཚ་ལྷ་དབོན་གྱི་བང་སོ་ཡིན་པར་གྲགས།",
    "ལྷ་སྲས་ལྗང་ཚ་ལྷ་དབོན་འཁྲུངས་པ་ལ།",
    "༣གཙུག་བརྟན་གྱི་ཡབ་འདུས་སྲོང་ལ་གོ་དགོས་པར་སྙམ།",
    "བཙན་པོའི་གདུང་རྒྱུད་སོ་དྲུག་པ་ཁྲི་ལྡེ་གཙུག་བརྟན་མེས་ཨག་ཚོམ་གྱི་བང་སོ་ཡིན་པར་གྲགས།",
    "མིང་ནི་ལྷ་རི་གཙུག་ནམ་བྱ་བ་ལགས།",
    "ལ་རྒྱ་དང་འགན་འཁྲིའི་བསམ་པ་དབེན་པའི་སྐྱེ་བོ་འགའ་ཞིག་ལགས་པས་ན།",
    "ཁོ་པས་ཉིན་ཞིག་བང་སོའི་འཁྲིས་ཀྱི་སེང་གེའི་ལག་པ་ཡ་གཅིག་བཅགས་ནས་རང་ཁྱིམ་གྱི་སྣུམ་བཙིར་གྱི་ལག་ཆ་བྱས་པས།",
    "འདུས་སྲོང་དང་ལྗང་ཚ་ལྷ་དབོན་གྱི་བང་སོའི་དཀྱིལ་ལྷོའི་ངོས་སུ་བང་སོ་ཆུང་ངུ་ཞིག་ཡོད་པ་ནི་བཙན་པོའི་གདུང་རྒྱུད་སོ་བརྒྱད་པ་མུ་ནེ་བཙན་པོའི་བང་སོ་ཡིན་པར་གྲགས།",
    "ལྷ་སྲས་མུ་ནེ་བཙན་པོའི་བང་སོ་ནི།",
    "ཙན་པོའི་གདུང་རྒྱུད་སོ་དགུ་པ་ཁྲི་ལྡེ་སྲོང་བཙན་སད་ན་ལེགས་འཇིང་ཡོན་གྱི་བང་སོ་ཡིན་པར་གྲགས།",
    "རྡོ་རིང་དེའི་སྟེང་བཙན་པོ་དེ་ཉིད་ཀྱི་མཛད་རྗེས་ཡིག་ཕྲེང་ཞེ་བདུན་བརྐོས་ཡོད་པར་མ་ཟད།",
    "མིང་དུ་སྐྱེའུ་ལྷ་རྟེན་ལགས་སོ་སྐད།",
    "ཅེས་འཁོད་པར་དཔགས་ན།",
    "བང་སོ་གསུམ་པོའི་ཁྲོད་ལས་གཉིས་ནི་ཁྲི་དར་མ་འུ་དུམ་བཙན་དང་འོད་སྲུངས་ཀྱི་བང་སོ་ཡིན་པར་བསྙོན་དུ་མེད་ལ།",
    "འོད་སྲུངས་དང་ཡུམ་བརྟན་གཉིས་མ་འཆམ་པར་དབུ་གཡོ་འཁྲུགས་ཏེ།",
    "བཙན་པོ་སྔ་མ་རྣམས་ཀྱི་བང་སོ་ལྟར་ཚགས་སུ་ཚུད་པོ་ཞིག་དང་གྲ་རྒྱས་ཕུན་སུམ་ཚོགས་པོ་ཞིག་བསྐྲུན་མ་ཐུབ་པར་ལུས་པར་མ་ཟད།",
    "ཐ་ན་ལས་མཇུག་ཡོངས་སུ་བསྒྲིལ་མ་ཐུབ་པར་བརྩིགས་འཕྲོར་ལུས་པ་དང་།",
    "ཞེས་པ་ཞིབ་པར་གཞིགས་ན།",
    "བྱང་ངོས་ཀྱི་རི་མ་འདབས་སུ་བང་སོ་གཅིག་འགྱིང་ངེར་འཕགས་པ་ནི་བཙན་པོའི་གདུང་རྒྱུད་སོ་གསུམ་པ་གུང་རི་གུང་བཙན་གྱི་བང་སོ་ཡིན་པར་གྲགས།",
    "མིང་ནི་གུང་རི་གུང་ཆེན་ལགས་སོ་སྐད།",
    "སྐས་ཞིང་མཐོ་བས་གལ་ཏེ་འགྲམ་དུ་བསྐྱོད་ནས་ཞིབ་ལྟ་མ་བྱས་ན་བང་སོ་དེ་རྙེད་ཐབས་དཀའ།",
    "བང་སོ་ཕྱི་རྒྱན་ཅན་དུ་གྲགས་པར་གྱུར།",
    "བཙན་པོའི་གདུང་རྒྱུད་ཉེར་དགུ་པ་འབྲོང་གཉན་ལྡེ་རུའི་བང་སོ་ཡིན་པར་གྲགས།",
    "བློན་པོ་སྙགས་ཐང་པ་ཡར་རྗེ་དང་བཅས་པ་གསོན་པོར་དུར་དུ་བཞུགས་པར་གྲགས།",
    "བློན་པོ་དང་བཅས་པའི་གདུང་རྒྱུད་ལ་སྙུན་མི་ཕོག་པའི་ཆེད་ཞང་མདའི་བང་སོར་གསོན་པོར་དུར་དུ་བཞུགས་པར་གྲགས་སོ།",
    "ད་དུང་ཡང་བཙན་པོ་གོང་མ་རྣམས་ཀྱི་བང་སོ་ཡང་ཡོད་པར་གྲགས།",
    "གནམ་གྱི་ཁྲི་བདུན་གྱི་བང་སོ་གནམ་ལ་བཏབ་པས་བང་སོ་མེད་པར་གྲགས།",
    "བང་སོ་རྫ་དང་གཡའ་ལ་བཏབ་པར་བཤད།",
    "ཅེས་བྱུང་བས་ལེགས་དྲུག་བང་སོ་པུ་དེ་གུང་རྒྱལ་གྱི་བང་སོ་ལས་ཅུང་དམའ་བའི་ས་ཆར་བཏབ་པར་མངོན་ནོ།",
    "ལྡེ་བརྒྱད་ཀྱི་པུར་ཆུ་ལ་བཤགས་པར་མངོན་ནོ།",
    "བཙན་པོ་དེ་རྣམས་ཀྱི་བང་སོ་འཕྱིང་ཡུལ་ཞེས་འཕྱོངས་རྒྱས་འཕྱིང་བ་སྟག་རྩེའི་ཉེ་འཁོར་གྱི་ས་ཆ་ཞིག་ཏུ་བཏབ་པར་བཤད།",
    "གྱིམ་ཤིང་ཀོང་ཇོའི་བང་སོ་འཕྱོངས་རྒྱས་རྒྱབ་རིར་བརྩིགས་ཞེས་གསུངས།",
    "ལྕགས་རིའི་ཕྱོགས་གཉིས་ནས་རྩིག་པ་བསླངས་པ་དང་དཀྱིལ་ནས་འགྲོ་ལམ་བཟོས་ཡོད་པར་མ་ཟད།",
    "བང་སོའི་གཞོགས་གཉིས་ཀྱི་ལྕགས་རིའི་རིང་ཚད་ལ་སྨི་ནས་སྨི་ཙམ་ཡོད་པར་སྣང་ལ།",
    "འོ་ན་གྱིམ་ཤིང་ཀོང་ཇོའི་བང་སོ་དབུས་སུ་བྱས་ཏེ་གཞོགས་གཉིས་ལྕགས་རིས་སྦྲེལ་དགོས་དོན་གང་ཡིན་ན།",
    "འདིའི་ནང་འགལ་འཁྲུལ་གྱི་ཆ་ནི་གཡོལ་ཐབས་བྲལ་བས་གཟུར་གནས་མཁས་པའི་སྤྱན་སྔར་བཤགས།",
    "དེ་ཡི་སྲས་འོད་སྲུངས་དང་ཡུམ་བརྟན་གཉིས་མ་འཆམ་པར་དབུ་གཡོ་ཡོ་འཁྲུགས་ཏེ།",
