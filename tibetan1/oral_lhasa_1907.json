    "ཤེས་རབ་ཀྱི་ཡུལ་ལ་དམིགས་ནས་རགས་པའམ་རྙིང་བའི་རྣམ་པས་འཇུག་པར་བྱེད་པའི་སེམས་བྱུང་དེ།",
    "ཤེས་རབ་ཀྱི་ཡུལ་ལ་དམིགས་ནས་ཞིབ་ཏུ་བྱས་ནས་དཔྱོད་པའི་རྣམ་པས་འཇུག་པའི་སེམས་བྱུང་དེ།",
    "པ་ཡང་བློ་དེ་རང་སྟོབས་ཀྱིས་བུམ་པ་ལ་ཕར་གཡོ་བ་དང་སེམས་པར་བྱེད་པ་ཡིན་པའི་ཆ་དེ་སེམས་བྱུང་སེམས་པ་དང་།",
    "ཡང་བློ་དེ་བུམ་པ་ལ་རང་སྟོབས་ཀྱིས་གཏོད་པར་བྱེད་པ་ཡིན་པའི་ཆ་དེ་སེམས་བྱུང་ཡིད་བྱེད་ལ་བཞག་པ་དང་།",
    "དེས་ན་དེའི་རྒྱུད་ཀྱི་བུམ་འཛིན་རྟོག་པ་དེ་སྒྲ་དོན་འདྲེས་པར་འཛིན་པའི་བློ་མིན་ཏེ།",
    "བུམ་འཛིན་རྟོག་པས་ནན་གྱིས་མ་བཟུང་བར་མིག་ཤེས་ལྟར་འཛིན་མི་ནུས་པའི་ཁྱད་པར་མྱོང་བས་གྲུབ་བོ།་",
    "འདི་དང་སྒྲ་དོན་འདྲེས་པར་འཛིན་པའི་རྟོག་པ་གཉིས་དོན་གཅིག་དོན་སྦྱོར་རྟོག་པ་ནི།",
    "སྐབས་འདིའི་རང་ཡུལ་ནི་སྣང་ཡུལ་ཙམ་ལ་བྱེད་པ་མིན་པར་བཟུང་བྱའི་ཡུལ་ལ་བྱེད་དགོས་པས།",
    "དོན་སྤྱི་དེ་བུམ་པ་མིན་ཡང་བུམ་པ་ཡིན་པར་འཁྲུལ་བའི་བློ་ཡིན་པ་བཞིན་ནོ།",
    "བྱས་རྟོགས་༧ཀྱིས་སྒྲ་མི་རྟག་པར་རྟོགས་པའི་རྗེས་དཔག་ལྟ་བུ།",
    "དུ་བའི་རྟགས་ཀྱིས་དུ་ལྡན་ལ་ལ་མེ་ཡོད་པར་རྟོགས་པའི་རྗེས་དཔག་ལྟ་བུ།",
    "སྒྲ་མི་རྟག་པར་རྟོགས་པའི་རྗེས་དཔག་སྐད་ཅིག་གཉིས་པ་ལྟ་བུ།",
    "སྒྲ་མི་རྟག་པར་རྟོགས་པའི་རྗེས་དཔག་སྐད་ཅིག་གཉིས་པ་ལྟ་བུའོ།་",
    "ཐེ་ཚོམ་མེད་པར་མཐའ་གཅིག་ཏུ་འཛིན་པའི་རིག་པའང་ཡིན།",
    "གཉིས་པ་ནི་སྒྲ་བྱས་པ་ཡིན་ན་མི་རྟག་པ་ཡིན་དགོས་སོ་སྙམ་པ་ཙམ་གྱིས་སྒྲ་མི་རྟག་པར་འཛིན་པའི་ཡིད་དཔྱོད་ལྟ་བུའོ།་",
    "སྒྲ་མི་རྟག་པར་རྟོགས་པའི་རྗེས་དཔག་ལ་སྒྲ་མི་རྟག་པའི་དོན་སྤྱི་སྣང་བའི་སྒོ་ནས་དེས་སྒྲ་མི་རྟག་པ་གཞལ་བའམ་འཛིན་པ་ཡིན་པའི་ཕྱིར།",
    "སྒྲ་མི་རྟོག་པར་རྟོགས་པའི་རྗེས་དཔག་ལ་སྒྲ་མི་རྟག་པའི་དོན་སྤྱི་སྣང་བ་ལ་བརྟེན་ནས་སྒྲ་འདི་ནི་མི་རྟག་གོ་སྙམ་དུ་འཛིན་པ་ཡིན་ལ།",
    "སྒྲ་མི་རྟག་པར་རྟོགས་པའི་བཅད་ཤེས་དང་།",
    "སྒྲ་རྟག་པར་འཛིན་པའི་བློ་ལྟ་བུ།",
    "སྒྲ་མི་རྟག་པར་རྟོགས་པའི་བློས་སྒྲ་མི་རྟག་པར་རྟོགས་པ་ལྟ་བུ།",
    "སྒྲ་རྟག་པར་འཛིན་པའི་སྒྲོ་འདོགས་དངོས་སུ་བཅད་ནས་སྒྲ་རྟག་པས་མི་སྟོང་བར་འཛིན་པའི་སྒྲོ་འདོགས་ཤུགས་ལ་བཅད་དོ།",
    "སྒྲ་རྟག་པར་འཛིན་པའི་བློ་ལྟ་བུ།",
    "སྒྲ་རྟག་འཛིན་རྟོག་པ་དང་སྒྲ་མི་རྟག་པར་འཛིན་པའི་རྟོག་པ་ལྟ་བུ།",
    "སྒྲ་མི་རྟག་པ་ཡིན་པར་སྣང་བའི་སྒོ་ནས་འཁྲུལ་བའི་ཕྱིར།",
    "སྒྲ་མི་རྟག་པར་འཛིན་པའི་རྟོག་པ་དང་།",
    "བུམ་འཛིན་རྟོག་པས་བུམ་པའི་ཁྱད་པར་བུམ་པ་ཡིན་པ་ཤེས་བྱ་ཡིན་པ་མི་རྟག་པ་ཡིན་པ་དངོས་པོ་ཡིན་པ་འདུས་བྱས་ཡིན་པ་དང་།",
    "རང་ཡུལ་ལ་ཁྱད་པར་གྱི་ཆ་ཤས་དུ་མ་ཡོད་པ་དག་སོ་སོར་ཕྱེས་ནས་ཆ་ཤས་གཅིག་འཛིན་པ་མིན་པར།",
    "ཡང་རྟོག་བཅས་རྟོག་མེད་ཀྱི་བློ་དོན་མཐུན་རྣམས་རང་ཡུལ་ལ་ཡུལ་དེའི་དོན་དང་མཐུན་པར་འཇུག་ལ།",
    "དོན་མི་མཐུན་རྣམས་རང་ཡུལ་ལ་ཡུལ་དེའི་དོན་དང་མི་མཐུན་པར་འཇུག་པ་ཡིན་ཏེ།",
    "སྒྲ་མི་རྟག་པ་ཡིན་པ་ལྟར་སྒྲ་མི་རྟག་པར་རྟོགས་པའི་རྟོག་པ་དེའི་འཛིན་སྟངས་ཀྱི་ཡུལ་ནི།",
    "གཟུགས་ཤེས་གང་རུང་མ་ཡིན་པའི་འདུས་བྱས་དེ།",
    "རྒྱུ་རྐྱེན་ལས་སྐྱེས་པའི་འདུས་བྱས་ཡིན་དགོས་སོ།",
    "དེ་ནི་བུམ་པའི་སྟེང་དུ་བུམ་པ་དེ་ཉིད་ཀྱང་མ་ཡིན་པར་བློ་ངོར་སྣང་ལ།",
    "འོན་ཀྱང་རྟོག་ངོར་ཤར་ཙམ་ཞིག་མ་ཡིན་པར་བུམ་པའི་སྟེང་ནས་གྲུབ་པ་ཞིག་དེ་ཡང་བུམ་པ་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་ལས་བྱུང་ཡིན་པས་ཡོད་པ་ཡིན་པ་དང་།",
    "དེ་བ་ཡིན་པར་འཆར་བ་ལྟར་གྲུབ་པས་ན་འདུས་བྱས་ཡིན་དགོས་ལཡང་གཟུགས་དང་ཤེས་པ་གཉིས་གང་ཡང་མིན་པས་ན་མཚུངས་ལྡན་མ་ཡིན་པའི་འདུ་བྱེད་ལས་འོས་མེད་དོ།",
    "དེ་བཞིན་དུ་བུམ་པ་མི་རྟག་པ་དེ་ཡང་བུམ་པ་དུས་སྐད་ཅིག་གཉིས་པར་མི་སྡོད་པ་དེ་ནི་རྟོག་ངོར་ཤར་ཙམ་མིན་པར་བུམ་པ་སྐད་ཡིན་པའི་ཆ་དེ་ཡིན་ལ།",
    "ཅིག་དང་བོའི་སྟེང་དུ་གྲུབ་པ་ཞིག་ཡོད་པར་སྣང་བ་ལྟར་དོན་དུ་ཡང་དེ་ཡང་བུམ་པ་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་ལས་བྱུང་བ་ཡིན་པར་གྲུབ་པ་དང་།",
    "བུམ་པ་སྐད་ཅིག་དང་བོ་དེ་རང་དུས་སུ་གནས་པའམ་མི་འགག་པར་སྡོད་པའི་བུམ་པའི་རྒ་བའམ་རྙིང་བ་ནི་བུམ་པ་སྐད་ཅིག་དང་བོ་དེ་ལཆ་དང་།",
    "དེ་གཉིས་ཀྱང་གཟུགས་ཤེས་གཉིས་གང་ཡང་མ་ཡིན་པའི་འདུས་བྱས་ཡིན་པས།",
    "བུམ་པ་རང་དུས་སྐད་ཅིག་གཉིས་པར་མི་སྡོད་པ་དང་།",
    "བུམ་པའི་སྐྱེ་བ་སོགས་ལྡན་མིན་འདུ་བྱེད་རྣམས་འདུས་བྱས་ཡིན་མིན་གྱི་ཁྱད་པར་ནི།",
    "རྒྱུ་འབྲས་སྔ་ཕྱི་རྒྱུན་མི་འཆད་པར་འཇུག་པའི་ཆ་ལ་བཏགས་པའི་འཇུག་པ་དང་།",
    "སྐད་ཅིག་གཉིས་པར་མི་སྡོད་པ་ལ་སོགས་པ་དེ་ཡིན་ཞིང་།",
    "འདི་དག་ཞིབ་པར་སྐོར་རྩིས་ཀྱི་གཞུང་ལས་ཤེས་པར་བྱའོ།",
    "ཕུང་བོ་བཞིའམ་ལྔའི་ཚོགས་པའི་ཆ་དེ་གང་ཟག་ཡིན་པར་འདོད་དོ།",
    "འདུས་བྱས་ཡིན་པས་ལྡན་མིན་འདུ་བྱེད་ལས་འོས་མེད་དོ།་",
    "འདུས་བྱས་སམ་དངོས་པོ་ཡིན་པས་ལྡན་མིན་འདུ་བྱེད་ཡིན་དགོས་སོ།",
    "སྐད་ཅིག་མ་འདུས་བྱས།",
    "གཟུགས་དང་ཤེས་པ་གཉིས་པོ་གང་རུང་མ་ཡིན་པའི་འདུས་བྱས་ཏེ།",
    "བྱས་པ་སོགས་ཀྱང་སྒྲ་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་ལས་བྱུང་བས་དངོས་པོ་ཡིན་ལགཟུགས་ཤེས་གཉིས་པོ་གང་ཡང་མ་ཡིན་པའི་སྟབས་ཀྱིས་ལྡན་མིན་འདུ་བྱེད་ཡིན་ཟེར་དགོས་སོ།",
    "ལྡན་མིན་འདུ་བྱེད་བཅུ་བཞི་དང་ཉེར་གསུམ་གྱི་དབྱེ་བ་དག་གཞན་དུ་འཆད་པར་འདོད་དོ།",
    "འབྲས་བུ་ཞིག་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་ཞིག་ཡིན་ཕྱིར་དངོས་པོ་ཞིག་ཡིན་དགོས་ཀྱི་དངོས་མེད་ཡིན་པར་གྱུར་པའི་རྒྱུ་ཞིག་མེད་པའི་ཕྱིར།",
    "ཆུར་བརྒལ་བས་ཆུའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ་སྐྱེད་པར་བྱེད་པ་སོགས་མཐའ་ཡས་པ་ཡོད་པ་དག་ཤེས་པར་བྱའོ།",
