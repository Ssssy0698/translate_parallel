    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་དང་ཕྱག་མཉམ་བཞག་ཅན་ལྷམ་མེ་ལྷན་ནེ་ལྷང་ངེར་འཚོ་ཞིང་གཞེས་པ་བཞིན་དུ་མཛེས་པར་སྣང་ངོ།",
    "དེ་ནས་ཙན་དན་དཀར་དམར་དང་ཨ་ག་རུ་ལ་སོགས་པའི་བུད་ཤིང་གི་མེ་ཅུང་ཟད་སྦྱར་བའི་ཟོལ་གྱིས་སྐུ་ལས་རང་བྱུང་གི་ཡེ་ཤེས་ཀྱི་མེས་བཞུས་པ་ན་མར་མེ་ཐོག་ཏུ་འ་པ།",
    "འགྲོ་དྲུག་རྟག་ཏུ་གཟིགས་པའི་ཕྱིར།",
    "མའི་སྐུ་ཆེ་བ་གསུམ་བྱོན་ཏེ་རིམ་པས་སྟེང་གི་ནམ་མཁའ་ལ་གཤེགས་པར་མཐོང་།",
    "མོས་གུས་སྐྱེས་པ།",
    "ལ་ལ་རེ་དོགས་འཕྲང་ལས་སྒྲོལ།",
    "གླིང་བཞིའི་མུན་པ་གང་གིས་སེལ།",
    "ཨེ་མ་སྡུག་བསྔལ་གང་གིས་སྒྲོལ།",
    "ཉོན་མོངས་དུག་ལྔས་ནོན་པ་ཡི།",
    "ཉེར་བརྒྱད་ཀྱི་ཉིན་རབ་བྱུང་སྔགས་པ་སྐྱ་བོ་སོགས་ཁྲི་ཚོ་དགུ་ཙམ་ཚོགས་པ་ཐམས་ཅད་ལ་ཇ་མར་ཞོ་རེ་བཀྱེས།",
    "ཆིབས་འབྲི་ཁྱུང་གི་མགོས་བྱས་པའི་རྟ་ཕྱེད་དང་སུམ་བརྒྱ་སོགས་ནོར་སྣ་སྟོང་ཕྲག་ལྔའི་འབུལ་འགྱེད་བྱས་སོ།",
    "རྒྱལ་བའི་རྒྱལ་ཚབ་མཆོག་གི་སྤྲུལ་པའི་སྐྱེས་ཆེན་རཏ་ནཱ་ཐའི་ཞལ་སྔ་ནས་ལེགས་པར་མངའ་གསོལ་བའི་ཚུལ་བརྗོད་པར་བྱ་སྟེ།",
    "བུདྡྷ་མེ་ཏ།",
    "ཐེག་ཆེན་ཐུན་མོང་མ་ཡིན་པའི་བསྟན་པ་ནི།",
    "བྱམས་པས་ཐོགས་མེད་རྗེས་སུ་གཟུང་སྟེ་ཟབ་མོ་ལྟ་བ་དང་རྒྱ་ཆེན་སྤྱོད་པའི་བརྒྱུད་ཀྱི་ཤིང་རྟའི་སྲོལ་གཉིས་འཛིན་པའི་སྐྱེས་ཆེན་དམ་པ་དཔལ་ལྡན་ཨ་ཏི་ཤའི་བར་དུ་འཕགས་པའི་འབྱུང་གནས་རྒྱ་གར་གྱི་ཡུལ་དུ་རྒྱུན་མ་ཆད་པར་བྱུང་ཞིང་།",
    "ཁྱོད་བསྟན་པའི་བདག་པོ་ཡིན་ནོ་གསུང་།",
    "བུ་ཁྱོད་ཀྱི་ཚངེས་པར་བྱེད་དགོས་པས།",
    "དབུ་ཁམ་ཞེས་ཐུན་མོང་ཚུར་མཐོང་གི་ངོར་སྣང་བའི་གཟུགས་སྐུའི་དབུ་སྐྱེས་མཚན་གཞི་མཚོན་བྱེད་དུ་བརྗོད་པར་མཛད་པ་ཙམ་སྟེ།",
    "ཡང་གདུལ་བྱ་སྐལ་མཆོག་དག་ལ་ཁོ་བོའི་རྗེས་སུ་བཙུན་ཆུང་རྣ་བ་དམར་ཅོ་རེ་བ་གཅིག་འོང་།",
    "ད་ལྟ་ཁམས་དབུས་བསྟན་པ་རོ་གཅིག་ཏུ་གྱུར་པ་འདི་ལུང་བསྟན་ནོ་སྙམ་མོ།",
    "སྐུ་ཡལ་བ་ཞེས་ཀྱང་འདོན་པ་རྒྱལ་ཚབ་མཆོག་གི་སྤྲུལ་པའི་སྐུ་རཏྣ་ནཱ་ཐ་ནི།",
    "ཀུ་གཡུང་སྒང་གི་གཡང་ཤོད་ལུང་པའི་གྲོང་བོང་ར་སྟེང་དུ་ཡབ་བན་བློན་མགོ་ཡག་དང་།",
    "བྱུང་བ་དང་ཁྱོད་ཀྱི་ཤུལ་དུ་གཞི་ན་བུ་གཅིག་སྐྱེས་ཡོད་པར་འདུག་དེ་ང་ལ་ཕུལ་འབུལ་གྱིས་འབུལ་གྱིས་གསུང་བས།",
    "འབུལ་ལགས་ཞུས་པ་ལྟར་སྟག་ལུང་ཐང་པ་ཆེན་ཟཔོའི་ལྔ་བཅུ་བཞེས་པ་ལྕགས་མོ་ཕག་གི་ལོ་ལ་རབ་སྒང་ན་མཁར་གསུམ་ཡོད་པའི་དབུས་མའི་ཞོལ་དུ་འཁྲུངས།",
    "བཀའ་ལས་མཚུར་ཕུ་བས་གདན་ས་གང་གིས་བྱེད་ཀྱང་ངས་ནི་གདན་ས་པ་ཞིག་ཚགས་བྱས་ཡོད་གསུང་བ་ལ།",
    "རྣམ་ཉིས་བཅུ་གཅིག་། ཟིན་ཁོས་གོ་ཆོད་ནས་འོང་གིས་གསུང་།",
    "དཔལ་ཕག་མོ་གྲུ་པའི་ཕྱག་འཁར་དེ་ཕྱག་ཏུ་གཏད་ནས་འབོལ་ཁར་བཞུགས་སུ་བཅུག་བཞེངས་ལ་སྒོར་སྒོར་གྱིས་ཤམ་ཤམ་གྱིས་གསུང་།",
    "རེ་ལ་འདོམ་ཕྱེད་གསུམ་རེ་ཡོད་པར་བཞེངས།",
    "ཀྱི་རྡོ་རྗེའི་བུམ་སྐུ་ངོ་མཚར་བ་ཞིག་གི་ཐོག་དྲངས་འཕགས་ཡུལ་ཤར་ལྷོ་ནུབ་བྱང་དང་དབུས་འགྱུར་འཆང་གི་རྟེན་ཉི་ཤུ་རྩ་བདུན།",
    "བང་རིམ་དང་སེང་ཁྲི་སྒོ་མང་གི་རྣམ་པ་ལ།",
    "དེ་དག་བཞུགས་པའི་གཙུག་ལག་ཁང་ཆེན་མོ་ནི།",
    "༣ དཔལ་འཁོར་ལོ་བདེ་མཆོག་གི་དཀྱིལ་འཁོར་གྱི་ཐིག་ཡོངས་སུ་རྫོགས་པར་བཏབ་པའི་གཞི་ལ།",
    "དཔོན་བཀྲ་ཤིས་མགོན་དང་བཞིས་ཟུར་རྡོ་བཞག་རྨང་གི་རྡོ་ཐོག་མ་ལྡོང་དཀར་པོ་འཛོམས་ཞེས་བྱ་བས་བཞག་ཐུར་དུ་ཕོ་འདོམ་བཅོ་བརྒྱད་བྲུས་ནས་བརྩེགས།",
    "གྱེན་དུ་མོ་འདོམ་བཅོ་བརྒྱད་བརྩེགས་ཏེ་ཁྱམས་སྟོད་ཀ་ཚར་བཞི་ལ་སོ་གཉིས།",
    "རྒྱལ་ཚབ་སྤྲུལ་པའི་སྐྱེས་མཆོག་འདི་ཉིད་ཀྱི་རྟོགས་པ་བརྗོད་པ་ཟབ་གསང་གི་ཕུལ་ལས་ཚུར་མཐོང་གི་ངོ་མཚར་སྣང་བ་ཆ་ཙམ་ནི།",
    "དེ་ནས་རིམ་བཞིན་ཡར་ཐང་གི་སེང་གེའི་གདན་ཅན།",
    "མར་ཐང་གི་གདན་ས་ཆེན་པོར་བསྟན་སྐྱོང་གི་ཕྲིན་ལས་མཛད་པ་ནི།",
    "དཔལ་རྡོ་རྗེ་འཆང་གི་བརྒྱུད་པ་འཛིན་ཚུལ་རིམ་གཉིས་གྲུབ་པ།",
    "ན་མོ་རཏྣ་གུ་རུ་དེ་བ་ཌཱཀི་ནི་ཡེ།",
    "གང་གིས་རིམ་གཉིས་ཟུང་འཇུག་ལམ།",
    "གུས་པར་སྤྱི་བོས་གཙུག་གིས་གཏུགས་ཤིང་དྲིན་གྱིས་ལེགས་པར་ངོམས་པར་བགྱིས་པ།",
    "རྣམ་འཕྲུལ་རེ་རེའི་དྲུང་དུའང་འབབས་པར་ཤོག།",
    "འཁོར་དང་ཞིང་གི་ཁྱོན་ཀུན་ཁྱབ་པར་བརྡོལ།",
    "བདག་གི་ལེགས་སྨོན་འདི་འགྲུབ་ཆེད་དུ་བསྔོ།",
    "བརྒྱུད་མཆོག་གི་རིང་སྲོལ་བཟང་།",
    "དྲང་སྲོང་མཆོག་གི་རྗེས་སུ་སློབ་པའི་བློས།",
    "ཞི་གནས་རབ་ཏུ་ལྡན་པའི་ལྷག་མཐོང་གིས་རང་རྒྱུད་ཉོན་མོངས་དགྲ་ཡུལ་ཕམ་བྱེད་པ།",
    "འགྲོ་བ་རེ་རེའི་གན་དུའང་སྤྲུལ་པའི་གཟུགས།",
    "བདེ་དང་རྣམ་ཀུན་མཆོག་ལྡན་ཟུང་འཇུག་གི།",
    "མཆོག་ཏུ་ཟབ་མོའི་ཤེས་རབ་སྤོབས་པའི་མཐུས།",
    "རྒྱུ་དེས་སྤྲོ་བས་སྟེང་གི་ནམ་མཁའ་ལ།",
    "དགའ་དང་གུས་པའི་མིག་གིས་རབ་བལྟས་པས།",
    "མཆོག་གི་ལུང་བསྟན་ཐོབ་པའི་རྐྱེན་འགྱུར་ཤོག།",
    "དེའི་རྗེས་སུ་འདྲེན་མཆོག་གཙུག་གི་ནོར་བུ་རྡོ་རྗེའི་སློབ་དཔོན་དམ་པ་རྣམ་རྒྱལ་རིན་ཆེན་དཔལ་བཟང་པོའི་ཞལ་སྔ་ནས་བཀས་གནང་ཞིང་།",
    "རྡོ་རྗེའི་མཆེད་པོ་བསླབ་གསུམ་རྣམ་པར་དག་པ་དམ་ཚིག་གི་ནོར་ཅན་མང་ཐོས་རྣམ་པར་རྒྱལ་བས་ཀྱང་ཡང་ཡང་ནན་ཏན་གྱིས་བསྐུལ་བར་མཛད་པ་ཁོ་ནའི་རྒྱུས།",
    "བོད་དང་རྒྱ་ནག་གི་རྩིས་ཀྱི་གཙུག་ལག་ལས་མེ་མོ་བྱའི་ལོར་གྲགས་པ།",
    "རེ་རེ་ལའང་ར་བ་འབྲིང་ཐ་ཆུང་གསུམ་གསུམ་དུ་ཕྱེ་བས་ལོ་གཅིག་ལ་དུས་བཞི་འཇོག་པའི་དུས།",
    "གཉིས་ལ་དུས་རེ་རེ་བྱས་ནས་དུས་དྲུག་ཏུ་འཇོག་པའི་དཔྱིད་ཟླ་གཉིས་ཀྱི་ཕྱི་མ།",
    "གར་སོང་ཆ་མེད་སྤྱོད་ཀྱིས་མེད་དེ་སོང་།",
    "ཕ་རོལ་གནོད་པ་གང་གིས་ཚུགས་མི་འགྱུར།",
    "གསང་བྲག་ནོར་བུའི་བྲག་ལ་རྟ་མགྲིན་མགྲོན་ཁང་གི་ཞབས་རྗེས་ཟེར་ཞབས་ཀྱིས་བཅགས།",
    "མ་མོ་སྟག་རི་རོང་སོགས་མོ་རྒྱུད་དང་།",
    "དེ་ཡང་མ་རྩིག་རིན་ཆེན་བཞི་ལ་ཞལ་གྱིས་གཟིགས།",
    "ཁྲུས་ཀྱི་སྒོ་མོ་བཞི་ལ་སྐུ་ཁྲུས་མཛད།",
    "འབྲོང་གིས་མི་སྐད་དུ་ལྷང་གིས་སྨྲས་ཏེ།",
    "ཁྱེའུ་ཆུང་གི་ཞབས་རྗེས།",
    "ད་ལྟ་ཁ་ལ་རེག་ཚད་ཚེ་རིང་བ་དང་ལུས་སྟོབས་རྒྱས་པ་ཡང་ཡོད།",
    "བདུད་ཀྱི་ཁ་བ་དང་བུ་ཡུག་ཐམས་ཅད་གཞའ་ཚོན་དང་འོད་ཟེར་མེ་ཏོག་གི་ཆར་བ་ལ་སོགས་དངོས་སུ་གྱུར་ཏེ།",
    "བདུད་རྣམས་ཀྱང་ཉི་མས་བ་མོ་འཇོམས་པ་ལྟར་མེད་དེ་སོང་ངོ།",
    "དེ་ལྟར་བདུད་ཀྱི་ཁ་བ་ཡང་བཀྲ་ཤིས་པའི་ས་རྟགས་བྱེ་མ་དཀར་པོ་གཡུང་དྲུང་ལུ་གུ་རྒྱུད་ལྟ་བུ་ཁ་ལ་རེག་ན་ངན་སོང་མེད་པ།",
    "གཞན་ཡང་རྣམ་མཁྱེན་སྟོན་པའི་སྐྱིལ་ཀྲུང་གི་ཞབས་རྗེས་ཁྱེའུ་ཆུང་བཞི་ཡི་ཞབས་རྗེས་དེ་རྣམས་ཕ་བོང་སྟེང་ཤིན་ཏུ་གསལ་བ་ཡོད་དང་།",
    "བདུད་ཀྱི་ཚོགས་ཐམས་ཅད་དུད་པ་གནམ་ལ་དྭངས་པ་ལྟ་བུ་མེད་དེ་སོང་ངོ།",
    "ཁྱེའུ་ཆུང་གི་ཞབས་རྗེས།",
    "ཞང་ཞུང་གི་སྒོ་ཕུག་བར་གསུམ་ཞེས་པ།",
    "བཀྲ་ཤིས་པའི་ས་རྟགས་སུ་གཤེན་གྱི་ཞབས་རྗེས་དང་ཁྱེའུ་ཆུང་གི་ཞབས་རྗེས་དང་།",
    "སླར་འོལ་མོའི་གླིང་ཆེན་གྱི་རྒྱལ་ས་རུ་གཤེགས་སོ།",
    "ཞང་ཞུང་གི་ཡུལ་དུ་ཡེ་སྲིད་ལྷ་ལས་བབ་པའི་རྒྱལ་པོ་བྱ་རུ་ཐོབ་པ་བཅོ་བརྒྱད་འོང་བར་གྱུར་ཅིག་བོད་གྱི་ཡུལ་དུའང་གནམ་ནས་བབ་པའི་ཁྲི་བདུན་དང་།",
    "འཛམ་གླིང་གི་ཕྱོགས་བཅུ་ཀུན་ཏུ་བསྟན་པ་སྤེལ་བའི་དུས་སུ་ཡང་།",
    "སྟག་གཟིག་གི་ཡུལ་ནས་དྲང་སྲོང་ཁྲི་ལྡེ་འོད་པོ་ཞེས་བྱ་བ་དེ་བྱ་རྒོད་དུ་སྤྲུལ་ཏེ།",
    "ཞང་ཞུང་གི་ཡུལ་གངས་ཏི་སེ་ཤེལ་གྱི་མཆོད་རྟེན་ལྟ་བུའི་མགུལ།",
    "རང་རང་གི་ཞེ་ས་དང་བསྙུང་འདྲི་བ་ལ་སོགས་མཛད་དོ།",
    "གངས་རི་ཆེན་པོ་གཡོན་ཕྱོགས་ཨ་ཏི་གསང་བ་གཡུང་དྲུང་ཕུག་ཨ་ཕུག་ཟེར་ཏུ།",
    "ཞང་ཞུང་པུ་མར་ཧྲེང་གི་ཡུལ་དུ་མུ་ལེ་མཚོ་ཡི་གླིང་ལ་ངག་མཚོ་ཟེར་དུ།",
    "ལ་མོར་རྡོ་ཡི་ཁང་བའི་གླིང་ལི་མུར་ཟེར་དུ།",
    "ཞང་ཞུང་རུ་ཐོག་གི་ཡུལ་གསང་བྲག་གཡུང་དྲུང་གཏམས་པའི་ཚལ་དུའང་།",
    "དེ་ལྟར་དུའང་ཞང་ཞུང་གི་ཡུལ་དུ་མི་ལོ་ཉིས་སྟོང་ལྔ་བརྒྱ་རུ།",
    "འདི་རྣམས་འཕགས་པའི་གནས་བརྟན་རྣམས་ཀྱིས་གནས་བསྟེན་ཅིང་བྱིན་གྱིས་བརླབས་ཚུལ་ཟུར་ཙམ་མོ།",
    "གསུང་མཆོག་ཏུ་གྲུབ་པའི་རིག་འཛིན་ཡིན་པས་ཕོ་མོ་གང་རུང་བསྒྱུར་ཡང་ཐོགས་པ་མེད་པ་དང་།",
    "ཤེས་རབ་ལུང་རྒྱུད་ཀྱི་ལྷ་མོ་ཡུམ་རྣམས་དང་།",
    "རེ་ཞིག་སྤོས་ཀྱི་བན་གླིང་རིག་པ་ཅན་ཞིག་ཡོད་པ་དེ།",
    "བདག་གི་སྲས་སྐལ་མཛད་པར་ཞུ།",
    "ཞེས་གསུངས་ནས་ཡབ་ཡུམ་གཉིས་ལ་བྱིན་གྱིས་བརླབས་ཤིང་ནམ་མཁའ་ལ་གཞའ་ཡལ་བ་ལྟར་དུ་སོང་ངོ།",
    "དེ་ལ་རྒྱལ་པོ་བཙུན་མོ་བློན་འཁོར་དང་བཅས་པ་རྒྱལ་བ་མཉེས་ཡུལ་དུ་ཕེབས་པ་དང་།",
    "ཁྱད་པར་འཛམ་གླིང་གི་ཡུལ་ཆེན་པོ་བཅོ་བརྒྱད་སོགས་ལ་འགྲོ་དོན་ཐོག་མཐའ་མེད་པར་མཛད་པ་དང་།",
    "རེ་ཞིག་མཚོ་མུ་ལེ་ཁྱུད་མཚོ་མ་པང་ཡིན་ཀྱི་ལྷོ་ཤར་རིན་ཆེན་སྤུངས་པའི་ཚལ་ལང་གར་ཤག་པ་ཟེར་དུའང་རྒྱལ་པོ་ཡབ་ཡུམ་བློན་འཁོར་དང་བཅས་ཏེ།",
    "མཚན་ལྡན་གྱི་བུ་མོ་འོད་དང་ལྡན་པ་ཞིག་འབྱོར་བ་ལ།",
    "མིང་ཡང་འཆི་མེད་སྤྲུལ་པ་བོན་མོ་སྟག་ཟ་ལི་ཝེར་དུ་གྲགས་སོ།",
    "དེ་ཡང་བོན་མོ་མཆོག་གི་རི་ལ་བོན་མོ་ཕུག་གི་རི་ཟེར་མཆོག་གི་སྒྲུབ་པ་མཛད་པས་མོ་ཕོ་རུ་འགྱུར་ཏེ་སྙ་ཆེན་པོ་ལི་ཤུ་སྟག་རིང་དུ་གྲགས་སོ།",
    "མི་ལོ་ཉིས་སྟོང་ལྔ་བརྒྱ་རུ་ལྷ་དང་སྟག་གཟིག་རྒྱ་བོད་ཞང་གསུམ་གྱི་ཡུལ་དུ་འགྲོ་དོན་རྒྱ་ཆེར་མཛད་པའི་ཡོན་ཏན་བསམ་ལས་འདས་པའོ།",
    "དེ་ལྟར་དུའང་ཞང་ཞུང་གི་ཕུག་ཏུ་གྲུབ་པ་མངའ་བསྙེམས་པའི་རིག་འཛིན་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབས་ཚུལ་ནི།",
    "ཞང་ཞུང་སྤོས་རི་ངད་ལྡན་དུ་སློབ་དཔོན་ཐད་མི་ཐད་ཀེམུ་ལེ་ཁྱུད་ཀྱི་མཚོ་འགྲམ་དུ་བོན་མོ་སྟག་ཝེར་ལི་ཝེར།",
    "མེ་ཏོག་གི་ཆར་འབེབས་པ་དང་།",
    "རིག་འཛིན་དེ་རྣམས་ནི་ཞང་ཞུང་གི་ཕུག་གངས་རི་ཆེན་པོའི་གནས་ནང་དུ་གྲུབ་པ་ཐོབ་པའི་རིག་འཛིན་རྣམས།",
    "ཞེས་གསུངས་ཤིང་གངས་རི་ཆེན་པོའི་རྩེ་མོར་ཡེ་ཤེས་དབལ་གྱི་མེ་རིའི་གུར་ཁང་དུ་གསང་བ་སྔགས་ཀྱི་ལྷ་ཚོགས་ཀུན་དངོས་སུ་གསལ་བར་མཛད་དོ།",
    "ཞེས་གསུངས་ཤིང་ཕྱོགས་བཞིའི་ལ་མོར་རྡོ་ལ་ཞབས་རྗེས་དང་།",
    "རི་ནི་ཐེག་གསུམ་མཆོག་གི་རི།",
    "ཅེས་གསུངས་ཤིང་ནམ་མཁའ་བར་སྣང་ས་གཞི་ཀུན་ཏུ་གཞའ་ཚོན་དང་མེ་ཏོག་གི་ཆར་བ་དངོས་སུ་འབེབས་པར་མཛད་དོ།",
    "རི་བཞི་ཕྱག་གིས་ལེན་པ་དང་།",
    "བྲག་བཞི་འཇུར་གྱིས་བུད་པ་ལ་སོགས་གྲུབ་རྟགས་མང་དུ་མཛད་དོ།",
    "ཀུན་གྱིས་མེ་ཏོག་གི་ཆར་དང་གཞའ་ཚོན་གྱི་འོད་དང་།",
    "ཞེས་གསུངས་ཤིང་གངས་རི་ཆེན་པོ་དེའི་རྩེ་མོ་རུ་སྤྲིན་དཀར་དང་གཞའ་ཚོན་གྱི་གསེབ་ཏུ་ཉི་ཟླ་ཕྱག་ཏུ་ལེན་ཞིང་གཞའ་ཚོན་འོད་ལ་ཆིབས་པའི་རྫུ་འཕྲུལ་ལ་སོགས་མཛད་དོ།",
    "གངས་རི་ཆེན་པོ་དེའི་རྩེ་མོ་རུ་ལྷ་དང་ལྷ་མོའི་ཚོགས་རྣམས་བྲན་དུ་བཀོལ་ལོ།",
    "ཞེས་གསུངས་ཤིང་རོལ་མོའི་སྒྲ་དང་འོད་ཟེར་ལ་བཅིབས་ཤིང་།",
    "ཞང་ཞུང་སྒོ་ཕུག་བར་གསུམ་ལའང་གསུམ་གསུམ་མོ།",
    "བར་ལ་མོ་གངས་ར་ཕྱི་ཡི་རི་དང་།",
    "སྒོ་མཁའ་འགྲོ་འདུས་གླིང་ཙ་ཡི་རི་དང་གསུམ་མོ།",
    "སྒོ་ཐང་ལྷ་དང་གནམ་མཚོ་ཕྱུག་མོ་དང་གསུམ་མོ།",
    "དེ་ལ་སྤྱི་ལྟར་ན་སྟོད་མངའ་རིས་སྐོར་གསུམ་ཞང་ཞུང་གི་ཡུལ་དང་།",
    "ཞང་ཞུང་ཟིལ་གནོན་རྒྱལ་པོ་རླབས་ཆེན་ཁྱུང་གི་བྱ་རུ་ཅན་དང་།",
    "ཀྱི་ལེ་གུ་གེ་རྒྱལ་པོ་ཨུན་ཆེན་དུང་གི་བྱ་རུ་ཅན་དང་གསུམ་མོ།",
    "ཞང་ཞུང་པུ་མར་ཧྲང་གི་ཡུལ་དུ།",
    "ཞང་ཞུང་རུ་ཐོག་ཡུལ་དུ་མུ་མར་ཐོག་རྒོད་རྒྱལ་པོ་ཨེནྡ་འོད་ཀྱི་བྱ་རུ་ཅན་སོགས་ཞང་ཞུང་གི་རྒྱལ་པོ་བྱ་རུ་ཅན་བཅོ་བརྒྱད་འདི་རྣམས་ཀྱི་རིང་ལ།",
    "གནམ་བསྐོས་མུ་ཁྲི་བཙད་པོ་དང་གསུམ་མོ།",
    "གོང་གི་གཤེན་རབ་ཀྱང་དབུ་འཕང་མཐོ།",
    "གནས་པའི་མཚོ་མ་འགྱུར་བ་མ་པང་གཡུ་མཚོ་སྔོན་མོ་རུ་སྲིད།",
    "འོག་གི་རྒྱལ་པོ་མ་འགྱུར་བ་ཞང་བོད་གནམ་བབ་ཀྱི་རྒྱལ་པོ་སུམ་ཅུ་སོ་གཅིག་གིས་མཛད་ཅིང་ཤིན་ཏུ་དར་བར་རྒྱས་སོ།",
    "དེ་ནས་དུས་རེ་ཞིག་ཙམ་ནའང་ཤིང་ཕོ་རྟ་ལོའི་ལོ་གསར་ཚེས་ཀྱི་དང་པོའི་དུས་སུ་ཡང་།",
    "དུས་ལོ་རེ་བཞིན་དུ་རིག་འཛིན་མཁའ་འགྲོའི་ཚོགས་ར་ཆེན་པོ་ཡོད་པ་ལ་བརྟེན་ནས།",
