    "བདག་གི་མདང་གསུམ་རྨི་ལམ་པྲ་ལྟས་ལ།",
    "ཕ་གི་རྒྱ་གར་ཡུལ་གྱི་མཐིལ་ཞིག་ན།",
    "ཨ་ཙར་ནག་པོ་དུག་གི་སྨྱོན་པ་ཞིག།",
    "མ་གི་བོད་ཡུལ་མཐིལ་དུ་རྒྱུག་པ་ལ།",
    "བདག་གི་མདང་གསུམ་རྨི་ལམ་པྲ་ལྟས་ལ།",
    "མ་གི་བོད་ཡུལ་དབུས་ཀྱི་མཐིལ་ཞིག་ན།",
    "དེ་ནས་ལྡེ་བོན་གྱིམ་ཚ་རྨ་ཆུང་གིས་འདི་ལྟར་གསུངས་པ།",
    "བདག་གི་མདང་གསུམ་རྨི་ལམ་པྲ་ལྟས་ལ།",
    "ཕ་གི་རྒྱ་གར་མཐའ་འཁོབ་ཡུལ་ཞིག་ན།",
    "བོང་བུ་རྣ་རིང་སྐད་པོ་ཆེ་ཞིག་གིས།",
    "མ་གི་བོད་ཡུལ་མཐིལ་གྱི་བོང་བུ་རྣམས།",
    "བདག་གི་མདང་གསུམ་རྨི་ལམ་པྲ་ལྟས་ལ།",
    "མ་གི་རྒྱ་ནག་ཡུལ་གྱི་མཐིལ་ཞིག་ན།",
    "བདག་གི་མདང་གསུམ་དྲན་པའི་གསལ་ཆ་ལ།",
    "བདག་གི་བློ་ལ་འདྲི་ན་འདི་ལྟར་སྣང་།",
    "སྔོན་ཚེ་བདུད་རྗེ་ཁྱབ་པའི་དམོད་པ་ཡིན།",
    "ཕ་གི་རྒྱ་གར་ཡུལ་གྱི་མཐིལ་ཞིག་ནས།",
    "ངག་འཁྱལ་ལོང་གཏམ་ལུས་འཆལ་བུད་མེད་བསྟེན།",
    "སྔོན་ཚེ་བདུད་རྗེ་ཁྱབ་པའི་དམོད་པ་ཡིན།",
    "སྔོན་ཚེ་བདུད་རྗེ་ཁྱབ་པའི་དམོད་པ་ཡིན།",
    "དེ་ཡང་བདུད་རྗེ་ཁྱབ་པའི་དམོད་པ་ཡིན།",
    "དེ་ནས་ཡང་ཞང་བོད་རིག་འཛིན་ཀུན་གྱི་ནང་ནས་མཆོག་ཏུ་གྱུར་བ་མཁས་པ་ཆེན་པོ་སྟོང་རྒྱུང་གི་ཞལ་ནས་འདི་ལྟར་གསུངས་པ།",
    "བདག་གི་བློ་ལ་འདྲི་ན་འདི་ལྟར་སྣང་།",
    "ཡ་གི་ཡུལ་ཆེན་གསུམ་ཡང་གསལ་བ་དེ།",
    "སྤྱིར་བོན་གྱི་སྒོ་མོ་བརྒྱད་ཁྲི་བཞི་སྟོང་དུ་ཡོད་ཀྱང་།",
    "ལྷག་ཏུ་སྟག་གཟིག་གི་ཡུལ་ནས་ལོ་པཎ་གཤེན་བརྒྱད་ཀྱིས་ཞང་ཞུང་གི་ཡུལ་དུ་བསྒྱུར་བ་དཔོན་གསས་མན་ངག་མཛོད་སྒོ་རུ་བཀའ་བསྒྱུར་བ་ཉི་ཟེར་ས་རྡུལ་དང་།",
    "ཐལས་ཟབ་ལམ་སྟོང་ཕྲག་བརྒྱ་བ།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་གནས་གསུམ་སོགས་འཛམ་གླིང་གི་གནས་ཆེན་རྣམས་ལ་སྦས་ཏེ།",
    "སྲིང་གཅིག་སྒྲ་བླའི་རྒྱལ་མོ།",
    "ད་ནི་གཡུང་དྲུང་བོན་གྱི་སྒོ་མོ་རྣམས།",
    "གཏེར་སྲུང་ཡེ་ཤེས་ལྷ་མོ་ལྔ་ལ་བཅོལ།",
    "དེ་ཡང་སྟག་གཟིག་ནས་ལོ་པཎ་གྱིས་བསྒྱུར་བའི་བོན་སྒོ་དང་།",
    "ཞིང་ཞུང་གི་བླ་ཆེན་དྲན་པ་དང་།",
    "ཞང་ཞུང་གི་སྟོང་རྒྱུང་མཐུ་ཆེན་དང་།",
    "ཞང་ཞུང་གི་ཤ་རི་དབུ་ཆེན་དང་།",
    "ཡར་ལུང་གི་ཤ་བ་རི་དབུ་ཆེན་གཉིས།",
    "རྡོ་རྗེ་འཆང་གི་གནས་ཐོབ་པའི།",
