    "བྱི་བ་མུན་ཁང་ནང་དུ་འཛུལ་སྟེ་སོང་།",
    "སླད་དེའི་ནུབ་མོ་བྱི་ལ་རྟེན་མར་བཏག།",
    "དུང་གི་སྦལ་པར་སྤྲུལ་ནས་མཚོ་ལ་རབ་དྲངས་པས།",
    "མ་ཧེ་བ་དཀར་མཛོ་མོ་དཀར་མོའི་འོ་མ་རུ།",
    "ཞོ་མར་དཀར་ཐོག་དག་གིས་མཆོད།",
    "དུང་གི་མཆོད་རྟེན་བཞི་ཡང་བཞག་པར་བྱ།",
    "གསང་བ་འདུས་པས་རང་གི་ཤ་ལ་རི་བོང་ཙམ་ཅིག་བཅད།",
    "ཞང་ཞུང་གི་སྐད་དུ།",
    "༧ འདི་སྐད་བདག་གིས་ཐོས་པའི་དུས་ཅིག་ན།",
    "དེ་ནས་གཟིགས་པའི་གཤེན་ལྔས་གསན།",
    "ཨ་དེ་རང་འབྱུང་རང་གི་བཅོམ་པས་ནང་ནས།",
    "ལྡང་ར་མོ་ར་ཧ་ཛ་ཉེ་རེ་བྱ།",
    "མེ་ཉག་གི་སྐད་དུ།",
    "ཡི་གེ་ཨ་དང་ཧཱུཾ་གི་ཆོ་འཕྲུལ་ལས།",
    "ཉི་ཟླ་གཉིས་ཀྱི་ཉིན་མོ་དང་།",
    "མཚན་མོ་བར་འཚམས་འབྱེད་པར་བྱེད་དོ།",
    "སྟོན་པ་ལགས་ཉོན་མོངས་པ་དུག་ལྔ་ནི་ཅིས་འཇོམས་ཞེས་ཞུས་པ་དང་།",
    "ཉོན་མོངས་པ་དུག་ལྔ་ནི་རང་གི་སེམས་ཀྱིས་འཇོམས་པར་བྱེད་པ་ཡིན།",
    "སོར་མོ་དྲུག་པ་དང་།",
    "མོ་མཚན་ན་བར་བྱེད་པ་ཡང་ཀླུ་ཡིན།",
    "གཞོགས་སྐམས་སུ་སོང་བ་ཡང་ཀླུ་ཡིན།",
    "དུག་གི་བསྐལ་པ་དང་།",
    "འདི་སྐད་བདག་གིས་ཐོས་པའི་དུས་ཅིག་ན།",
    "དཔྱིད་ཐ་ཆུང་གི་གདུགས་ཀྱི་སྔ་གྲོ་ལ།"
  ]
}