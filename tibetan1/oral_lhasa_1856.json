    "དེའི་ཕྱིར་ཉེ་བར་བརྗོད་པ་མེད་པ་ལ་ལུས་ཅན་གྱི་སྒྲུབ་པ་བཀག་ན་དགག་པ་བརྗོད་པར་འགྱུར་བའི་ཞེས་སོ།",
    "མེད་པར་དགག་པས་ནི་བཟློག་པ་འབའ་ཞིག་བརྗོད་པ་ཡིན་ལ་ཞེས་དང་།",
    "མེད་པར་དགག་པ་ལ་ནི་ཏི་ངའི་མཐའ་ཁོ་ན་དང་དགག་སྒྲ་འབྲེལ་བ་སྟེ།",
    "རྟག་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བ་དང་འབྲེལ་པ་ཁོ་ནར་དགག་སྒྲ་བརྗོད་པར་འདོད་པར་འགྱུར་རོ་ཞེས་སོ།",
    "རང་བཞིན་ནམ་རྒྱུ་ལ་གཙོ་བོའི་སྒོ་ནས་གསལ་བ་རྣམས་མ་འདྲེས་པར་འདོད་པ་དང་།",
    "རང་རྗོདབྱེད་ཀྱི་དགག་སྒྲས་བྱ་བ་མི་འགོག་པར་དགག་པའི་ཁྱད་པར་དུ་བྱས་པ་སྒྲུབ་པ་འཕེན་པ་སྟེ།",
    "མ་ཡིན་པར་དགག་པ་ལ་དགག་སྒྲ་ནི་བྱ་བ་དང་འབྲེལ་བམེད་པ་ཁོ་ན་སྟེ།",
    "འོ་ན་ཅི་ཡིན་ན་བསྒྲབ་པར་བྱའོ་ཞེས་སོ།",
    "གཉིས་པ་ཁྱད་པར་དཔྱད་པ་ནི།",
    "དགག་པའི་ཁྱད་པར་ཡིན་པའི་མ་ཡིན་དགག་ལ་ནི་དངོས་སུ་ཁྱད་པར་དུ་བྱས་པ་དགོས་ཤིང་།",
    "མ་ཡིན་སྒྲུབ་པར་བྱེད་ཕྱིར་རོ།",
    "མེད་པར་སྒྲིབ་པའི་གཏན་ཚིགས་ནི་དམིགས་པའི་མཚན་ཉིད་ཀྱིས་གྱུར་པ་མ་དམིགས་པའོ་ཞེས་སོ།",
    "ཁ་ཅིག་ནི་དོན་གཞན་གྱི་སྒོ་ནས་པར་བྱེད་ཅེས་། སོ།",
    "དམིགས་པ་མེད་པའི་ཕྱིར་མེད་པ་ཡིན་པར་ཤེས་པར་ནུས་ཀྱི།",
    "འདི་ན་བུམ་པ་ཕྱིས་ཡོད་པར་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "མི་དམིགས་པར་འགྱུར་བའི་ཕྱིར་ཞེས་བྱ་བར་ནི་ཤེས་པར་མི་ནུས་ཏེ།",
    "མ་འོངས་པའི་མི་དམིགས་པ་ཡོད་པར་ཐེ་ཚོམ་ཟ་བའི་ཕྱིར་རོ་ཞེས་སོ།",
    "འདི་ནི་རྣམ་འཇོག་རྟགས་སུ་བཀོད་ནས་རྣམ་པར་གཞག་བྱ་སྒྲུབ་པ་ཡིན་པས་རང་བཞིན་གཏན་ཚིགས་སུ་སྡུད་དེ།",
    "མེད་པའི་ཐ་སྙད་ནི་མེད་དོ་ཞེས་བྱ་བའི་རྣམ་པར་ཤེས་པ་དང་སྒྲའི་རྣམ་པ་དང་།",
    "བུམ་པ་མེད་པར་ཤེས་ན་ནི་ཐེ་ཚོམ་མེད་པར་འགྲོ་བ་དང་།",
    "འོང་བར་འཇུག་པར་བྱེད་དོ་ཞེས་སོ།",
    "སྣང་རུང་དུ་བ་ཡོད་ན་མེའི་ཁ་དོག་ཡོད་པར་དམིགས་པའི་ཕྱིར་ཞེས་པ་ལྟ་བུའོ།",
    "ཁ་ཅིག་ནི་དོན་གཞན་འགོག་པའི་སྒོ་ནས་རྗོད་པར་བྱེད་དོ་ཞེས་སོ།",
    "རིགས་མི་མཐུན་པ་རྣམ་པར་བཅད་པའི་ངོ་བོར་གནས་པ་སྟེ།",
    "དངོས་པོ་ཐ་དད་ལས་གྱུར་པའི་འགལ་བ་གང་ཞིག་རྒྱུན་གཅོད་པར་རུང་བ་སྟེ།",
    "རྒྱུན་གཅོད་པར་རུང་བ་ནི།",
    "འདི་ལྟར་བསྲེག་པར་བྱ་བའི་སྐད་ཅིག་མ་བསྐྱེད་པ་ན།",
    "རྒྱུན་གཉིས་བཟློག་པར་བྱ་བ་དང་།",
    "སྣང་བས་མུན་པ་འཇོམས་པ་ལྟ་བུ་ནུས་པ་ཉམས་པར་བྱེད་པ་དང་།",
    "གསུམ་པ་ལ་རྒྱུན་འགག་པར་བྱེད་དེ།",
    "ཟློག་པར་བྱེད་ན་ཆེས་མྱུར་ན་སྐད་ཅིག་གསུམ་པ་ལ་བྱེད་དོ།",
    "གཉིས་པ་ལ་ཡང་འགལ་བ་ནུས་པ་མེད་པར་བྱེད་དོ།",
    "གསུམ་པ་ལ་ནི་འགལ་བ་ནུས་པར་མེད་པ་འགག་པའི་ཡུལ་དེར་འོང་བར་བྱེད་དོ་ཞེས་སོ།",
    "གཉིས་པ་རྒྱུན་གཅོད་ཚུལ་ནི་ཁ་ཅིག་སྔ་ལོགས་སུ་རྒྱུན་གཅོད་པར་འདོད་པ་ལྟར་ན་དུས་མཉམ་དང་ཕྱི་ལོགས་སུ་མེད་པས་གནོད་བྱ་མི་སྲིད་པར་འགྱུར་རོ།",
    "མ་འོངས་པ་ན་སྒྲོ་འདོགས་དེ་སྐྱེ་ན་སྐྱེ་འགྱུར་མ་བཀག་པར་འགྱུར་ལ།",
    "མུན་པ་ལོག་པ་ན་ཡུལ་དེར་གནོན་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་དང་།",
    "གཞན་ཡོད་ན་སྟེ་འགལ་བ་ཡོད་པར་གྱུར་ནམེད་པའི་ཕྱིར།",
    "འདི་ནི་མཚན་ཉིད་པའི་འགལ་བ་མཚན་ཉིད་ཀྱི་རང་བཞིན་ལ་རྣམ་པར་གནས་པ་ཡིན་ནོ་ཞེས་སོ།",
    "འདི་ནི་ཐ་སྙད་དུ་འཇོག་བྱེད་དང་བདག་ཉིད་གཅིག་པར་འགལ་བས་གཅིག་པ་བཀག་པའི་ཐ་སྙད་ཀྱང་ཡིན་ཏེ།",
    "དངོས་འགལ་གྱི་ཁྱད་པར་དུ་བྱས་པ་དང་།",
    "བྱས་པ་དང་རྟག་པ་ལྟ་བུ་སྟེ།",
    "རྒྱུད་འགལ་མིན་པར་འགལ།",
    "དེའི་འགྲེལ་པར།",
    "བྱས་པ་དང་རྟག་པ་ལྟ་བུ་གཅིག་བཀག་པའི་ཐ་དད་དེ་བཞིའོ།",
    "དག་པར་བྱ་བ་མི་དམིགས་པ་ཁོ་ནར་ཤུགས་ཀྱིས་བརྗོད་དོ་ཞེས་དང་།",
    "འགལ་བའི་རྒྱུ་ཕན་ཚུན་སྤངས་པ་དེ་ཡང་མི་དམིགས་པ་ཉིད་ལས་ངེས་པར་བྱ་བ་ཡིན་ནོ་ཞེས་སོ།",
    "ཡུལ་རྣམ་པར་ཕྱེ་བའི་ཕྱིར་ཏེ།",
    "མེས་ཁྱབ་པ་ཞེས་པ་རྟགས་ལ་ངེས་པར་སྦྱར་དགོས་ཏེ།",
    "དེ་ལྟར་རྟགས་ཁྱད་པར་ཅན་སྦྱར་དགོས་ཏེ།",
    "འགལ་འབྲས་ལ་ཡང་ཡུལ་དང་ནི་ དུས་ལ་སོགས་པ་ལྟོས་པར་འདོད།",
    "སྒྲ་རྟག་དངོས་ཀྱིས་སྟོང་སྟེ་བྱས་པའི་ཕྱིར་ཞེས་པའོ།",
    "དེས་མྱུ་གུ་བསྐྱེད་པ་རང་རྒྱུ་ལས་དོན་གཞན་རིགས་འདྲ་ཕྱི་མ་ཁྱད་པར་དུ་འགྱུར་བ་ལ་ལྟོས་པ་དང་བཅས་པའི་ཕྱིར།",
    "རང་གྲུབ་ཙམ་གྱིས་འཇིག་པར་ངེས་པའི་ཕྱིར།",
    "བརྒྱུད་ནས་རང་བཞིན་མ་དམིགས་པར་ཡང་འདུ་སྟེ།",
    "ཅེས་དང་ཕྱེད་དང་བཞི་པར།",
    "འདི་ནི་མི་དམིགས་པ་ལས་ཐ་དད་པར་བཞག་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "འགལ་བ་ལས་ཀྱང་མེད་པར་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་ཞེས་སོ།",
    "རྟགས་ཐམས་ཅད་རང་བཞིན་རྟགས་སུ་འདུ་ཞེས་ཀ་མ་ལ་ཤཱི་ལས་གསུངས་པ་ནི་སྒྲབ་ཚུལ་ལ་དགོངས་པ་ཡིན་ནོ།",
    "འདིའང་ཁྱབ་བྱེདམ་དམིགས་པར་འདུས་སོ།",
    "བྱས་དང་མ་བྱས་པ་རྣམས་སུ་ སྣ་ཚོགས་རང་བཞིན་ཉིད་ཀྱིས་རུང་།",
    "ཉེས་ཟད་ཀྱི་ཚིག་ཁྱད་པར་གསུམ་ལྡན་ཡིན་པའི་ཕྱིར།",
    "འདུས་བྱས་ཐམས་ཅད་མི་རྟག་ཅེས་པའི་ཚིག་བཞིན་ཞེས་པ་ལྟ་བུ་སྟེ།",
    "འཁྲུལ་པར་འདྲ་ཡང་གཞན་ལས་མིན།",
    "འབིགས་ལ་གནས་པས་སྨྲས་པའི་ཁྱད་པར་མཐོང་བ་ལ་སོགས་པ་སྟེ།",
    "དེ་ཡང་ཁྱད་པར་མཐོང་བ་ཞེས།",
    "ཞེས་སྤུ་རིས་ངེས་པར་གཟུང་བའི་བློ་ལ་འདོད་དོ།",
    "གཙང་པོ་རྒྱས་པའི་ཕྱིར་ཞེས་པ་ལྟ་བུའོ།"
