    "དྲུང་འཁོར་སེར་མོ་བ་དང་འཆམས་པ་རྣམས་གཟབས་སྤྲོས།",
    "བུད་མེད་འཆམས་པ་རྣམས་གོས་དམར་སྟོད་གོས་རྒྱན་བཅས།",
    "ངེད་རང་གི་རྗེས་ལ་དྲུང་ཆེན་ཟུང་བཅས་གཞི་ཐོག་ནས་ཆས་ཏེ་ས་ཚོགས་སུ་མདུང་།",
    "ལྷོ་བྱང་གི་གྲྭ་ཁྲོལ།",
    "བུད་མེད་ཤ་སྐལ་གྱི་སྐབས་སུ་སྔ་རྟིང་གཉིས་ལ་བཀྲས་བཏགས་དང་།",
    "གཞན་ཚོར་གསར་འཕེལ་ཡག་པ་རེ།",
    "ཉེར་བདུན་ལ་བུད་མེད་ཀྱི་ཆས་དང་།",
    "དེའི་མགོ་པ་དང་གཙོ་མོའི་དམ་རྫས་བཅོ་ལྔ།",
    "བུད་མེད་ཀྱི་ས་ཁྲི་གཡང་གཞིའི་ཐུམ་བཅས་ཁང་དཔོན།",
    "བུད་མེད་ཤ་སྐལ་ལ་རྒྱུག་ཚེ་ཁྲོམ་ནང་ཕྱོགས་བཞིར་སླ་ང་སོགས་སུ་ཤ་ཆེན་ཅུང་ཟད་བསྲེས་པའི་གུ་གུལ་ཕོན་ཆེ་བ་དང་།",
    "སྤོས་རེངས་བུ་དྲི་བཟང་གི་དུམ་བུས་དུད་པ་ཤིན་ཏུ་གཏོས་ཆེ་བ་སྦྱར།",
    "དུང་པ་ཆ་ལྔའི་མཐའ་གཡས་གཡོན་དུ་རྫག་དུང་ཆ་རེ་བཅས་ནུབ་བསྟན་དུ་བསྒྲིག།",
    "བར་མ་གཉིས་དང་མཇུག་མ་རུང་བྱང་ནས་གཏང་རྒྱུའི་དང་པོ་བུད་མེད་རྫོགས་མཚམས་གུང་སང་།",
    "བཞི་པ་དྲུག་བརྡུང་དང་བདུན་བརྡུང་གཉིས་སོང་མཚམས།",
    "ཐམས་ཅད་ཀྱི་ལོག་འཆམས་གྲུབ་ནས་མདུང་སོགས་སྔོན་འགྲོའི་ངེད་རང་དཔོན་གཡོག་གོང་གི་གྲལ་རིམ་བཞིན་འགྲོ།",
    "བུ་མོ་མདའ་དར་ཅན་དགེ་སློང་སྔགས་པ་སོགས་ཀྱི་གྲངས་དང་མཉམ་པ།",
    "གཏོར་བཟློག་གྲུབ་ནས་སྐྱེས་ཆེ་ཆུང་རྐང་ཐང་གི་དམག་བཅས་བྱ་ཁྲ་མར་བསྡད།",
    "སྐྱེས་ཆེ་ཆུང་གིས་རྦད་ཤོད་གྲུབ་པ་དང་རྐང་དམག་དང་རྟ་བ་རྣམས་རྒྱུན་བཞིན་བསྡད་ལ།",
    "མངའ་གསོལ་མཇུག་ཆོག་གྲུབ་ནས་གཏོར་འབུལ་གྱི་སྐབས་བརྒྱ་ཚར་གྱི་སྤྱན་གཟིགས་དང་ཚོམས་ཆེན་གྱི་དྲག་ཆས་རྣམས་བསྡུས།",
    "ཞེས་རྗེ་རྡོ་རྗེ་འཆང་ཆེན་པོ་དེ་ཉིད་ཀྱི་བཀའ་ཡང་དག་པའི་དེ་དུས་ཀྱི་ཟིན་བྲིས་རྣམས་ཕལ་ཆེར་ཕྱོགས་བསྡུས་འདི་ཡང་མ་འོངས་པར་རིམ་ཅན་དུ་གཟིགས་བདེ་ཕྱིར་འདིར་བྲིས་པ་ཡིན་ལགས།",
    "སྔར་གྱི་ཕྱག་སྲོལ་ལ་འཆམས་བཀའ་གཉན་འདི་འདྲ་མཛད་སྲོལ་འདུག་པར་འགའ་ཞིག་གི་སེམས་ལ།",
    "བསེ་མགོན་ཡིད་བཞིན་ནོར་བུ་ལྟ་བུའང་འཆམས་སྟབས་ཀྱི་སྤྱན་འདྲེན་མཛད་པ་ནས་བཟུང་བཀའ་གཉན་གྱི་གར་འཆམས་དུ་མར་མངའ་བརྙེས་པས་འདི་བཞིན་འཆམས་པ་ལ་ཉེས་པ་མེད་པའི་གཏན་ཚིགས་ཡང་དག་ཡོད་པ་བཞིན་མཉེན་ཆས་དང་དངོས་གཞི་གཏོར་བཟློག་རྣམས་གཟབས་སྤྲོས་ཀྱིས་མིག་གང་གི་ལྟས་མོ་ལྟ་བུར་འཆམས་དུས་གནམ་གཤིས་ཤིན་ཏུ་འཇམ་ཞིང་གྲ་འགྲིག་བྱུང་།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "ལུགས་ཟུང་བསིལ་ཟེར་ཕབ་ཚེ་དད་མོས་ཆབ།",
    "སྣོད་བཅུད་རྣ་བ་སྟོང་གིས་ཉན་པར་ལྷགས།",
    "ནོར་འཛིན་བཞིན་སྣུམ་འབྱོར་རྒྱས་མིག་གིའང་བལྟ།",
    "ཞེས་ཀྱང་སྨྲས་སོ། དགུང་གྲངས་སོ་དྲུག་དུ་ཕེབས་པ་ཤིང་སྤྲེལ་རྒྱལ་ཟླའི་ཚེས་གཅིག་ལོ་གསར་ལ་འཕྱར་དར་ཚང་མ་དཀར་པོ་དང་ཚོགས་པས་གོས་བེར་གྱོན་པ་སོགས་སྔར་སྲོལ་མེད་ཀྱང་ཁྱད་མཚར་མཛད་པ་དང་།",
    "ཚོམས་ཆེན་གནམ་ཡངས་ལ་ནོར་བུའི་དོ་ཤལ་ཐོག་མར་འགྲེམས་གནང་གི་སྐབས་དང་།",
    "ནུབ་གཅིག་རྗེ་རྡོ་རྗེ་འཆང་ཆེན་པོར་ཚ་བའི་སྙུན་ཐུ་མོ་ཞིག་འཁྲུངས་ཀྱང་སང་དེ་གར་སོང་ཆ་མེད་དུ་དེངས་པའི་ཚུལ་མཛད།",
    "ལོ་གསུམ་རིང་ཐེག་ཆེན་གན་དྲིལ་གཞན་ཞིག་གནང་བ་ཡང་མི་རིང་བར་གས་འཛེར་དུ་སོང་བ་དང་།",
    "དེ་ལོ་ཕུར་སྒྲུབ་ཕྲིན་འཆོལ་གཟབས་མ་དང་དངོས་གྲུབ་གླིང་དུ་རྒྱུན་བསྐང་འཛུགས་གནང་གིས་ཆུ་སྟོད་ཟླ་ནང་ལྷོར་སྤོས་ནས་ལྷ་ཆེན་ཁྱམས་སྟོད་མདའི་གཡབ་སྟེང་དུ་རྗེ་ཉིད།",
    "གྲོ་བཞིན་ཙམ་ནས་ཡུམ་མཆོག་གི་འོ་འཛིན་གཡོན་སྙུན་པ་རིམ་གྱིས་ཇེ་ལོད་དུ་གྱུར་པ་ལྗགས་ཆུ་དང་།",
    "གསེར་དངུལ་གྱི་གཟུངས་ཐག་མུ་ཏིག་སོགས་ཀྱི་སྤེལ་བཅས་སྒྲོན་གནང་གིས་ཚེ་ཆོག་གནང་བ་བཅས་གསེར་ཐིག་ཀྱང་དེ་གྲས་སུ་འགྲིག་པས་ལེགས་པར་བཀའ་སྩལ།",
    "སྔར་སྐུ་བལྟམས་དུས་གཏང་རག་ལ་ཕུལ་བའི་ལྷ་མདུང་ལ་དར་ཡུག་རིང་མོ་རེ་གསོལ་བར་མཛད་ནས་སྐྱེད་ལྷས་བསམ་བརླིང་གཉིས་ལ་གཏོར་སྤོད་གྲས་སུ་ཕྱགས་ལེགས་པར་ཕེབས།",
    "མགོ་ཟླའི་ཚེས་དྲུག་གི་ཐོ་རངས་འོད་གསལ་དུ།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "གཟིགས་མོད་གྲ་ལྔའི་ལྷ་མོ་ས་འདིར་བྱོན།",
    "འཁུ་བའི་ཚ་རེག་ཏིང་འཛིན་གཡུལ་ངོར་ཕམ།",
    "ལོ་མའི་གོས་ཅན་ལྷ་མོར་བཞེངས་ཏེ་བསྐྲད།",
    "དུང་སོགས་གཙུག་ལག་ཁང་གི་ཉེར་སྤྱད་རྣམས་ཕྱག་ཏུ་བསྟར་ཙམ་རེ་མཛད་ནས་སྐུ་རྣམས་ཀྱི་དྲུང་དུ་ཕུལ་ཏེ་བཞུགས་ཁྲི་ལ་ཕེབས་པའི་ཐོག་མ་རང་དེ་འགྲིག་བས་རྫས་བརྒྱད་མངའ་གསོལ་ཤུགས་འབྱུང་དུ་བྱུང་བའང་སྔར་འདྲ་འདྲ་འགྲིག་འགྲིག་མཛད་པ་མ་ཡིན་པར་རང་བགྲིག་དེ་རིགས་རྣམ་པ་ཀུན་ཏུ་མང་དུ་བྱུང་བ་རྣམས་ནི་ཡབ་སྲས་ཡུམ་བཅས་ཀྱི་ངོ་མཚར་བའི་མཛད་པ་ཤ་དག་དང་།",
    "རྡོ་སྐས་འགོ་ནས་ཞལ་དྲོའི་བར་བྱིས་པ་ལང་ཚོ་བཅུ་དྲུག་ལོན་པ་ཁ་ཤས་ནས་མདུང་འཛིན་པ་དང་།",
    "ལྷག་པར་མེ་ཏོག་གི་ཆར་ནི་སྔར་དྲན་མ་མྱོང་བ་ལྟ་བུ་འབབ་པ་འདུག་ཅེས་སྐྱ་སེར་མཐའ་དག་ནས་གླེང་བའང་དོན་ལྡན་བཞིན་དང་།",
    "མཁན་ཆེན་བསྙེན་སོང་རྣམས་སྟེང་དུ་འདུ་བར་མཛད་དེ་ཀྱེ་རྡོར་རབ་གནས་འབྲིང་པོ་བཅས་ཕྱི་བསྐོར་ལ་མེ་ཏོག་གི་ཆར་ཉིལ་བའི་ཞར་ལ་ལྷ་ཆེན་རུང་ཁང་ཉམས་གསོ་ཁྲོ་ཆེན་གསར་བླུགས་བཅས་ལའང་ཤིས་བརྗོད་ཀྱི་མེ་ཆར་ཕབ་སྟེ།",
    "སྔགས་འཆང་ཆེན་པོ་དང་ཨ་མེས་ཞབས་རབ་བྱུང་ལས་སླར་གདུང་འཛིན་མཛད་ཚུལ་སོགས་ལས་འཕྲོས་ཏེ་གྲགས་བློ་བས་ཨ་མེས་ཞབས་ལ་ཞལ་ཏ་ནན་ཏན་གནང་ཚུལ་བཞིན་དེང་དུས་རྗེ་རྡོ་རྗེ་འཛིན་ཉིད་ལའང་གནས་ཚུལ་དེ་ལྟར་ཤར་ཚུལ།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "ངལ་བསོས་མཆོག་གི་དངོས་གྲུབ་སྣང་བརྙན་དུ།",
    "དོན་དང་ལྡན་མོད་སླར་ཡང་མཆོད་ཡོན་གྱི།",
    "དེ་ཉིན་མཛོད་འཛིན་ནས་ཞལ་དྲོ་ལྷ་ཁང་གི་མཆོད་ཀོང་གསེར་ལྗང་མ་འབྲུས་ཕྱུར་ཏེ་གཟིགས་འབུལ་སྐབས་ད་ནངས་ཡང་གདུང་བརྒྱུད་ཞིག་འཁྲུངས་ཚུལ་ལས་འཕྲོས་པའི་བཀའ་གསང་མང་དུ་གྲོལ་ཞིང་།",
    "རང་གི་སེམས་ལའང་གདུང་སྐུ་མཆེད་འདི་དག་འཁྲུངས་རྟགས་སོགས་གང་ས་ནས་ཤིན་ཏུ་ལེགས་ཤིང་།",
    "རང་ཡང་སོ་བདུན་ཀེག་སྲི་ཐུ་མོ་དེ་ལས་ཐར་བས་སྤྱི་སྒོས་ནས་རེ་བ་མཛད་ཅིང་།",
    "རང་ལ་གདན་སའི་འཁུར་བབས་པ་ནས་བཟུང་ཉིན་རེ་བཞིན་ཡང་སྐྱོན་ཡོན་ཆར་འབེབས་ལྟར་བཀའ་དྲིན་ཆེ་བས་དེ་སྐབས་སུ་ནི་ཞེ་བསུན་ཡོང་ཡང་རིང་པོར་མ་ཐོགས་པར་མི་གྲལ་དུ་ཆུད་ཅིང་བླ་གོ་ཆོད་ཙམ་གྱིས་གདན་ས་བཟུང་ཐུབ་པའང་དེ་ཉིད་ཀྱི་སྐུ་དྲིན་ཡིན་པས་གང་ལྟར་རང་གཞན་རྒྱུ་རྐྱེན་དེ་དག་གིས་གདན་ས་ཆེན་པོར་སྐུ་ཆག་ཡོང་ཉེ་རང་ཡིན་འདུག་ཀྱང་།",
    "དེ་ཡང་སྔགས་འཆང་ཀུན་དགའ་བཀྲ་ཤིས་ནས་ལྕམ་ཟུང་གཞོན་ནུ་ནས་བཞེས་ཀྱང་རིགས་སྲས་ཞལ་གཟིགས་ཤིན་ཏུ་དཀའ་ཚུལ་མཛད་པས་སྤྱི་སྒོས་ཡི་མུག་མུན་གླིང་ངུ་འཁྱམས་སྐབས་ཐུགས་རྗེའི་རང་གཟུགས་ཉི་མ་ཤར་བ་བཞིན་ཕེབས་ཏེ་ཡབ་རྗེ་མཆོག་ལས་གསན་པ་རྒྱ་མཚོའི་ཕ་རོལ་ཏུ་སོན།",
    "གཞོན་ནུ་ནས་གསན་བཞེས་ཕུལ་ཕྱིན་བཀའ་དྲིན་བསྐྱངས་ཏེ་དགུང་ལོ་བདུན་པར་ཡབ་གཤེགས་པས་སྐུ་ན་ཕྲ་མོ་སྐུ་རྐྱང་ངང་ལ་ཐུག།",
    "རེ་ཞིག་ནས་དམག་པ་དེ་གྲས་ཁ་ཤས་གཙང་ལ་དོན་སྤྱོད་གཞན་ལ་ཡོང་ཞོར་འདིར་ཡང་འབྱོར་བར་སྤྱིར་ཁ་འཁྱམས་སྣ་ཚོགས་ཀྱིས་བརྡབ་ཤོགས་དང་།",
    "བྱེ་བྲག་མི་ཉག་དཔོན་པོ་ཟེར་བ་ཞིག་གིས་དགོས་མེད་དུ་བསྡིགས་པ་ཐམས་ཅད་བློ་གཏོར་ནས་ཅི་བྱར་གྱུར་པའི་མུར་དམག་པ་དེ་རྣམས་འབྱོར་ཕྱག་ཞུ་སྐབས་རང་བཞིན་སྐུ་མདུན་དུ་འོངས་པ་ལས་དད་གུས་ཀྱི་པར་ཀབ་མེད་ཀྱང་ཞག་ཤས་ནས་འཐོན་ཕྱག་ཞུས་དུས།",
    "ཅེས་བྱམས་བསྟན་སོགས་མ་འོངས་པར་འབྱུང་རྒྱུ་ཡིན་པས་ནུ་བོ་དེ་སྔོན་ལ་འདས་ནས་མ་འོངས་པའི་ལྕི་ཁག་དེ་ཁྱོད་རང་གཅིག་སྟེང་དུ་ཁེལ་ནས་དར་ཙམ་ཞིག་དཀའ་མོ་ཡོང་ཡང་ཕྲིན་ལས་སྲུང་མར་བཅོལ་ཡོད་པས་ཧུར་ཐག་ཐོངས་ཤིག་གསུང་རྒྱུར་འདུག་ཀྱང་།",
    "རིང་འཚོའི་བདེན་ཚིག་ཡིན་པའི་ལུགས་སུ་མཛད་ནས་གསུང་རིགས་དེ་འདྲ་ཞིག་མཛད་པ་སོགས་དུས་གསུམ་སྒྲིབ་མེད་དུ་གཟིགས་ཤིང་།",
    "རྩེ་གདོང་སོགས་རང་རེའི་ལག་འབྱོར་དེར་ཡང་ཟླ་ཤས་སྡོད་དགོས་པ་དང་།",
    "ཞེས་སོགས་སྐུ་བསྟོད་ཤློ་ཀ་གཅིག་པོ་འདི་ཡང་དོན་ལ་གནས་པའི་སྐུ་བསྟོད་རང་ཡིན་མིན་གཟིགས་པ་ཞུ་ཞིང་།",
    "རང་གི་ལས་ཀྱིས་བདས་པས་རྗེ་དེ་ཉིད་ཀྱི་སྲས་སུ་རྗེས་སུ་བཟུང་ཡང་ཞལ་གྱི་བདུད་རྩི་ཉུང་ངུ་ལས་མ་ཐོབ་ཅིང་།",
    "ནར་མ་སོན་པར་འཁུར་འཁྱེར་བས་རང་གིས་ནི་མི་ཤེས།",
    "དེ་ནས་རྗེ་ཉིད་ཀྱིས་མགོན་ཁང་བཞིར་གདུང་བརྒྱུད་གེགས་མེད་ཕེབས་པའི་གཏང་རག་ཐོག་འཛུགས་གཏོར་འབུལ་གནང་གི་སྐྱེད་ལྷས་སུ་ལྷོའི་སྤང་སྟེང་དུ་གཏོར་འབུལ་དུས་འཛུགས་གཏོར་དཔལ་བཤོས་དེ་མགོན་ཁང་དུ་ལུས་པས་སླར་ཡང་ཕྲིན་འཆོལ་རྒྱུན་འཐུད་ན་དགེ་མཚན་འཁྲུངས།",
    "བསམ་བརླིང་ལྷོ་རི་རྡོ་གདུགས་འདི་གཅུང་དམ་པའི་བླ་རི་དང་ས་འཛིན་ཕུན་ཚོགས་ཡང་རྩེར་མངའ་གསོལ་མཛད་དེ་སླར་ཡང་སྐྱེད་ལྷས་སུ་དམ་རྫས་རྒྱན་ལྡན་གྱི་གཏོར་ཆེན་འཛུགས་གནང་གིས་གཏོར་བསྔོ་དང་བསྐང་བ་བརྒྱ་རྩ་དང་།",
    "ལྷོར་སྤོ་གནང་གིས་ཕེབས་འཕྲལ་ཤིས་བརྗོད་སྦྱང་ཁྲུས་ཚེ་ཆོག་ལྷ་བསང་གཏོར་སྤོད་སོགས་མཛད།",
    "དེ་ནུབ་རྡོ་རྗེ་ཕུག་ནས་སྲས་མོ་དཔལ་ལགས་འཇིགས་སྣང་ཞིག་གི་རྐྱེན་གྱིས་མཚན་ལངས་བྱུང་བ་མ་འགྱངས་པར་ཞིང་བརྗེ་བའི་ལྟས་དང་།",
    "ཁྱད་པར་སྔགས་འཆང་ཡབ་སྲས་དང་ཨ་མེས་ཞབས་ཡབ་སྲས་རྣམས་ནས་ཚོགས་འདོན་གསུང་བསྐུལ་དང་རོལ་དཔོན་སོགས་རྟག་པོར་མཛད།",
    "ཨ་མེས་ཞབས་དགུང་གྲངས་རེ་བགྲངས་ཙམ་གྱི་གསུང་ལས།",
    "བདུད་རྩི་སྩོལ་བ་སོགས་མཛད་དེ་ཉེར་བཞིའི་ཐོ་རེངས་དག་ཞིང་དུ་ཕེབས་འཕྲལ་རྗེ་ཉིད་ནས་མི་འཁྲུགས་པ།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "ལེགས་བྱས་གཡབ་མོས་གཉའ་ཤིང་འཛིན་རི་ནས།",
    "ཤེས་རབ་སྒྱུ་མའི་སྐྱེད་མོས་ཚལ་འཁྲུངས་པའི།",
    "ཟླ་བ་འདི་ནས་བཟུང་ཇི་སྲིད་བསྐལ་པའི་བར་སྡོམ་གསུམ་ཚེས་མཆོད་གཞུང་སྐྱོར་ཟླ་རེར་ལན་གསུམ་རེ་ཆག་མེད་ཀྱི་རྒྱུན་བཟང་འདི་ཉིད་གསར་འཛུགས་བཀའ་དྲིན་ཆེ་སྟེ་ཚོགས་དབུར་བྱོན།",
    "སྲས་ཡུམ་སྲས་མོ་དཔོན་གཡོག་བྱོན་པས་སྔར་བཞིན་གང་སར་བདག་རྐྱེན་ཡང་དག་དང་།",
    "དུས་གཏོར་ཆེན་མོ་དགུང་གྲངས་ཉེར་གཉིས་ནས་བཟུང་ཆག་མེད་མཛད་ཀྱང་བན་ཚང་པ་དང་ལྷན་ཅིག་སྒྲུབ་མཆོད་གཏོར་བཟློག་སྐབས་མ་གཏོགས་མགོན་ཁང་སོ་སོར་མ་གནང་ཡང་།",
    "དེ་ལོ་ནས་བཟུང་ཁྲུམས་ཟླའི་རིགས་ཆར་ཡང་ཚོགས་ཕེབས་རྟག་པོ་དང་།",
    "མཆོད་རྟེན་བྱར་རུང་ཁ་ཤོར་གཟི་འོད་འབར་ཞིང་བྱང་ཕྱོགས་ན་སྤྱན་གཟིགས་ཀྱི་ལྷ་ཁང་འོ་བརྒྱལ་བ་ཞིག་དང་།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "ཤེས་རབ་ལྷ་མོའི་གཞིས་མགྲོན་དགའ་མགུའི་འཛུམ།",
    "དྲང་སྲོང་རྀ་ཥིའི་དུས་སྟོན་གཟིགས་མོ་ལས།",
    "དེ་ནས་གནས་བཅུར་སྤྱན་གཟིགས་མཆོད་གཏོར་གཟབས་པ་བཅས་ཚོགས་བདག་བསྐང་བ་ཟླ་གང་མའི་ཐོག།",
    "དེ་ནས་ལྷ་མོ་མཆོད།",
    "ལྷ་བཟོ་བ་ཟླ་འོད་སོགས་ལ་བཀའ་འདོམས་བཞིན་སྐུའི་སྒྲོན་དར་རྣམས་གྱེན་བརྫེས་ཀྱིས་བལྟས་པས་ཉམས་ཚོད་ཧ་ལམ་ལོངས་པས་གདན་འདྲེན་པར་ཐུགས་ཐག་ཆོད་དེ་རྗེ་ཉིད་ནས་ནང་སོར་གསུང་བསྐང་དང་འཛུགས་གཏོར་རྣམས་ཕུལ་སྐབས་དར་ཕོན་གྱེན་བརྫེས་ཀྱིས་ཞབས་གཉེས་ཕེབས་ལ་ཁད་དབུ་དུད་དུད་མཛད་པ་ལྟ་བུའི་ཚུལ་དུ་གཟིགས་པས།",
    "ཞམ་འབྲིང་པ་ཚོས་ད་ལམ་ཇི་གསུང་བཞིན་པུ་ཏྲ་རང་ཡང་ཕེབས་པ་ལ་མཉིས་པ་འདྲ་མོ་འདུག།",
    "དེ་ནས་རྗེ་ཉིད་ཀྱིས་སྨུག་ཆུང་ཞལ་འབག་དང་ཨ་མེས་ཞབས་སོགས་ཀྱིས་བཞེས་འབག་སྐུར་སྒྲོན་པའི་ཕྱག་མཚན་དར་ཕོན་རྣམས་བཅས་ཕལ་ཆེར་བསྡུ་བར་མཛད།",
    "གཏོར་སྒམ་ཆེ་བ་སྤྱན་གཟིགས་སོགས་རིམ་བཞིན་བསྡུ་བའི་བཀའ་འདོམས་སྩལ་རྗེས།",
    "བན་ཚང་ལྷ་བྲིས་བསྙེན་སོང་གཉིས་སོགས་ཁ་རས་ལག་བཀྲུ།",
    "མགོན་ཁང་ཆེན་མོའི་སྒོ་གླེགས་གཉིས་ཀྱང་ཕུད་ཆོག་གིས་སྐུ་དང་ཟངས་ཆེན་སོགས་བཞུགས་ཡུལ་རྣམས་ལྷུས་ཐེངས་མཛད་རྗེས།",
    "རྗེ་ཉིད་ཀྱིས་རྣམ་འཇོམས་ཀྱི་གཟུངས་བཟླ་ཞིང་བུམ་ཆུ་འཐོར་བཞིན་པས་སྣ་དྲངས་ཏེ་སྤྱན་འདྲེན་སྐབས་ལྕིད་མེད་ལྟར་བདེ་བར་ཡེར་གྱིས་མགོན་ཁང་ཆེན་མོར་ཕེབས་ཞབས་ལ་ཉམས་གསོའི་སྐབས།",
    "སེ་མོའི་རོ་ས་བྲེ་གང་གི་ཚོད་ཙམ་ལ་ཕལ་ཆེར་སེ་རོ་རང་དུ་ངོས་འཛིན་དང་།",
    "ཆུ་ཕལ་ཆེར་དྭངས་གྲུབ་ནས་བན་ཚང་པ་བརྒྱད་གྲས་ཟངས་ཆེན་སྤྱན་འདྲེན་གདོང་རྗེ་ཉིད་ནས་གོང་བཞིན་བུམ་ཆུས་སྣ་འདྲེན་གྱིས་མགོན་ཁང་ཆེན་མོར་སྤྱན་དྲངས་ཏེ་ཆུས་བཀང་།",
    "ཨ་མེས་ཞབས་ཀྱིས་བཞེས་འབག།",
    "གཏིང་རྒྱུག་ཁང་ཐོག་གི་ཁྱམས་གདུང་སྤྱི་དང་།",
    "ཁྱད་པར་པུ་ཏྲའི་བཞུགས་ཐད་དེའི་གདུང་ལ་ཉེན་ཆེན་ཡོད་པ་སོགས་དུས་གསུམ་སྒྲིབ་མེད་གཟིགས་པའི་ཉམས་གསོ་དུས་བབས་དང་།",
    "དེ་ནས་ཨང་ཟུག་གི་ཞལ་བཀོད་ཕལ་ཆེར་གྲུབ་ནས་མཛོད་འཛིན་གཞུང་ཕྱག་ལ་བྱོན།",
    "ཨ་མེས་ཞབས་ཀྱི་ཞལ་འབག་པུ་ཏྲའི་ཞལ་བརྙན་ལ་སྐུ་གཟུགས་ཀྱི་ཞལ་བཀོད་དང་ས་མཆོད་སོགས་མཛད་མུ་དང་།",
    "པུ་ཏྲའི་ལྡེར་སྐུ་ཐུན་མོང་མ་ཡིན་པ་སོགས་མྱུར་དུ་གྲུབ་སྐབས་རྗེ་རྡོ་རྗེ་འཆང་ཐུགས་དགེས་པའི་གསུང་ལས།",
    "བཟོ་བ་དང་འུ་ལ་མིའི་བརྩོན་འགྲུས་ལས་བྱུང་བ་འདི་ངེད་རང་གི་རྫུ་འཕྲུལ་ཡིན་ཞེས་ཉམས་ལྡན་གྱི་གསུང་གླེང་དང་།",
    "ཟངས་ཆེན་དང་སྐུ་གསར་རྙིང་གི་གཟུངས་སྒྲིག་དང་།",
    "རྗེ་ཉིད་ཀྱི་ཕྱག་བསྟར་གྱིས་སྨུག་ཆུང་ཞལ་འབག་ཉམས་གསོ་གཟུངས་འབུལ་སོགས་གནང་སྐབས་ལྷ་མིའི་དྲི་བཟང་གིས་མཚོན་མི་ནུས་པའི་དྲིའི་ཁྱད་པར་དཔག་མེད་འཐུལ་ཞིང་།",
    "ཕྱག་རོགས་གསོལ་གཟིམ་གཉིས་ནས་མཛད་པས་ནུབ་གཉིས་ཀར་ཁོང་ཟུང་ལ་མོན་ཕྲུག་གཉིས་མངོན་སུམ་དུ་འོངས་ཏེ་གྲི་ཁྱེར་ནས་ཁྱོད་གསོད་རྒྱུ་ཡིན་ཟེར་བ་དང་།",
    "གཅིག་ལ་མོན་ཕྲུག་གིས་རག་དུང་རྣ་རྩར་འབུད་པ་སོགས་འཚུབས་ཉམས་དང་འཇིགས་སྣང་ཆེན་པོ་བྱུང་བ་སོགས་ནི་ཞལ་འབག་བཀའ་གཉན་པའི་ཆེ་བར་འཁུམས།",
    "གུར་ལྷ་བརྒྱད་ཞི་བའི་སྦྱིན་སྲེག་སོགས་རྗེ་ཉིད་ནས་གནང་བའི་སྦྱིན་སྲེག་གི་སྤྱན་འདྲེན་མཆོད་བསྟོད་སོགས་ལ་འབྲེལ་མཚུངས་རྔ་རོལ་དབྱངས་སོགས་མཛད་པས་གཞན་ལས་བབས་ཆགས་པ་བྱུང་བར་གསུངས་ཤིང་མེ་བཀྲའང་ཤིས།",
    "དེའི་ཚེ་ཨ་མེས་ཞབས་ཀྱི་དགོངས་རྫོགས་བདེ་མཆོག་ཚུགས་མུ་བཞིན་དུས་ཆེན་ཚེས་བཅུར་བསུ་གནང་དང་།",
    "ཁྱེད་རྣམས་ནས་བསྟན་པ་སྤྱི་བྱེ་བྲག་ལ་དར་འདོད་དེ་བཞིན་རྗེས་སུ་ཡི་རང་གི་གནས་ཡིན་འདུག་པས།",
    "མ་གིར་ཡང་རྣམ་དཀར་གྱི་བགྱི་བ་ཡར་ལྡན་དགོས་ལུགས་རྣམས་བཀའ་སྩལ་པས།",
    "གང་ཅིའི་མཚམས་ལ་དེ་བཞིན་དང་གནས་སྐབས་ཀུན་ཏུ་སྐྱབས་འཇུག་གི་རྗེས་འཛིན་ཞུ་བ་སོགས་དད་ཤུགས་ཀྱིས་གདུངས་པའི་རྣམ་འགྱུར་ཅི་ཡང་གཡོ་བའི་སྐབས་སོ།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "ཆུ་གཏེར་གསར་བུས་ཕྱུར་དུས་དད་མོས་ཀྱིས།",
    "བསེ་མགོན་ཆེན་པོའི་ཞལ་གདོང་ནང་གི་གསེང་ཐག་རྣམས་དང་ལྗགས་བཅས་ཞལ་ནས་ཕྱིར་ཕྱུང་སྟེ་སྐུ་སྟོད་འོག་ཙམ་ན་ཕན་ཚུན་གཟིངས་ཤིང་བརྐྱང་པའི་ཚུལ་གྱིས་ཤིན་ཏུ་འཇིགས་ཤིང་མཆིས་པས།",
    "འོན་ཀྱང་སྒོ་རུམ་དུ་འགྲོ་དགོས་གསུངས་ཕེབས་ཏེ་གོང་གི་གནས་ཚུལ་བཞིན་གཟིགས་པས།",
    "སྐུ་བྱིངས་ཀྱང་གོག་ཉམས་ཆེ་རུང་རེ་ཞིག་གནང་བ་མ་ཐོབ་པས་བཅོས་མ་ནུས།",
    "གཞན་ཡང་སྒོ་རུམ་སྐོར་ལ་གཟིགས་སྣང་ངོ་མཚར་ཅན་མང་པོ་ཞིག་འཁྲུངས་ཚུལ་ཡང་མཆིས།",
    "དེ་སྐོར་ལ་མཛོད་འཛིན་ནས་སྐྱེད་སྟོན་དང་རྩིས་པ་སོགས་ལ་མོ་བཏབ་རིམ་གྲོ་རྣམས་ཚར་ཕྱིན་མཛད།",
    "དེ་ཙམ་ནས་བཟུང་གང་གི་ཨ་ལྕེ་དྲུང་མཆོག་གསུམ་ལགས་སྙུན་གྱི་འགོ་ཟུག་སྟེ།",
    "ས་གའི་ཚེས་བཞི་འཁྲུངས་བསངས་གྲོལ་ནས་རྗེ་ཉིད་བདེ་མཆོག་ཏུ་ཕེབས་པས་སྐུ་ལུས་ཀྱི་རྣམ་འགྱུར་འགྱུར་བ་སོགས་གཟིགས་པས།",
    "གཤེགས་བཞུགས་གང་བྱུང་ཡང་ཕན་འགྱུར་ཡང་དག་གི་ཞལ་བཞེས་སྩལ་བས་ཁོང་ཐུགས་དགེས་པའི་གསུང་གླེང་ཡང་ཕུལ།",
    "མཚན་གཟིམ་ཡང་བདེ་བ་སོགས་ཀྱི་མུར་ཞག་འགའ་ཁྱོལ།",
    "དེ་ནས་ཡང་ཇེ་ལོད་དུ་སོང་ནས་ས་གའི་དགེ་ཚར་བདེ་མཆོག་ནས་བསྙེན་བཀུར་གཟབས་པ་མཛད་པའི་ཐོ་རངས་སྐུ་ཞི་བར་གཤེགས་ཤིང་།",
    "དར་ཙམ་ནས་སླར་ཡང་ཕེབས་ཏེ་གཟིམ་མལ་མ་ཡིན་པའི་བཞུགས་སྟན་ཞིག་ལ་རགས་ཙམ་འཁོད་གནང་གིས།",
    "དེ་ཉིན་ཕྱེད་ཡོལ་ཙམ་ལ་བཙུན་མ་སོགས་འུལ་མི་རྣམས་བཟའ་བཏུང་ཐོག་འགའ་ཞིག་ཤར་ལྷོའི་གཡབ་སྟེང་ནས་གཞན་དུ་འགྲོ་འདོད་ཀྱིས་ཕོར་པ་བཟའ་བཏུང་གིས་གང་བཞིན་དུ་འགྲོ་མུར།",
    "དེའི་སྐྱོན་གྱིས་རྐྱེན་ལམ་དུ་སོང་བ་རྣམས་ལ་ཐུགས་ལྷག་པར་ཡང་བརྩེ་བས་རྗེས་སུ་འཛིན་པའི་ཞལ་བཞེས་དང་བཅས།",
    "དེ་ནས་སྔོན་དུས་འཇམ་མགོན་ཨ་མེས་ཞབས་དང་ཡབ་རྗེ་རཏྣའི་མཚན་ཅན་གྱི་སྐུ་ཐོག་སོགས་ལ་དཔའ་བོ་དཔའ་མོར་རྡོར་ལེགས་སོགས་ཁོག་ཞུགས་ཀྱིས་ངན་གཏད་འདོན་སྲོལ་འདུག་པ་དེ་བཞིན་གྱི་བཀའ་གསང་མཛོད་འཛིན་སོགས་ལ་གྲོལ་ནས།",
    "འཇམ་མགོན་སྐུ་གདུང་བགྲེས་པ་སྣྲོན་ཟླའི་ཚེས་མགོར་གསན་སྦྱོང་གི་ཐོག་མ་གནང་རྒྱུའི་སྐུ་རིམ་དུ།",
    "བདེ་གླིང་ཚོགས་ཡོངས་འཕྲལ་ནས་གཙུག་ལག་ཁང་བྱིངས་ལ་རབ་ཏུ་གནས་པ་ཞག་འགའ་སྩལ།",
    "ཀ་ཡི་གི་གུ།",
    "དུས་ཚེས་ཆེ་གེ་མོར་རྫས་དང་ཡོ་བྱད་ཆེ་གེ་མོ་དགོས་ཚུལ་གླེང་བ་དང་བསྟུན།",
    "དེ་ནས་བརྟག་དགོས་ཚུལ་ཟེར་བ་སོགས་བྱུང་བ་བཞིན་དཔའ་ཆེན་ལའང་བདག་རྐྱེན་ཡང་དག་གིས་ཕྱིར་མངགས་ནས་ལུང་གསལ་གྱི་རིམ་གྲོ་རྣམས་ཚར་ཕྱིན་མཛད་དོ།",
    "ཆུ་སྟོད་ཟླ་ནང་ཨ་ཙ་ར་སྤྲེའུ་ཁྱེར་བ་ཞིག་གཞི་ཐོག་ལྟག་སྒོར་དར་ཙམ་བསྡད་ནས་ཐལ་གྱིས་བྱུང་བ།",
    "འབུམ་ཐང་མཆོད་རྫས་སུ་བཞུགས་པ་དེ་རྣམས་བཅུད་སོ་སོས་བཀང་བ་རིམ་བཞིན་བསྟར་ཏེ་རྟེན་དྲུང་དུ་འབུལ་བ་སོགས་ཕྱག་ལེན་རྣམ་དག་གི་སྒོ་ནས་མཛད་ཅིང་།",
    "མཆོད་བསྟོད་གྲུབ་ནས་ཕྱི་བསྐོར་ལ་མེ་ཏོག་གི་ཆར་སྙིལ་བར་ཡབ་རྗེ་རཏྣའི་མཚན་ཅན་གྱི་སྐུ་ཐོག་གི་མཆོད་ཕྲེང་གཅིག་དང་།",
    "སྣ་ལྔའི་མཆོད་ཤོམ་རྒྱས་པའི་མཐར་མཆོད་ཕྲེང་གིས་མཛེས་པར་བསྐོར་ཏེ།",
    "སྐྱབས་སེམས་ནས་བཟུང་ཤིས་བརྗོད་མཛད་རྗེས་མཆོད་ཕྲེང་སོགས་ཚང་མ་འཕན་ནག་སྐུ་རྒྱབ་ནས་ལྷ་ཆེན་ནང་གི་ཞལ་ཆེན་ལྷོ།",
    "མཆོད་ཕྲེང་གི་སྔོན་དུ་ཀོང་གཞས་པ་བཅས་རིམ་བཞིན་ཕྱི་བསྐོར་འཁོར་འཕྲལ།",
    "ཨ་མེས་ཞབས་རྣམས་གཙོ་བོར་སྨོས་ཏེ་མཆོད་བསྔོ་ཡང་དག་དང་མཇུག་ཆོག་རྣམས་གྲུབ་ནས།",
    "མགུལ་ལ་བཀྲ་ཤིས་པའི་ལྷ་རེག་གི་སྤྲས་ཤིང་།",
    "རབ་འབྱམས་རྒྱལ་བ་ཀུན་གྱི་དྲག་པོའི་ཕྲིན་ལས་གཅིག་བསྡུས་དཔལ་ཕྲིན་ལས་ཀྱི་མགོན་པོ་དམ་ཅན་མོན་བུ་པུ་ཏྲ་ཆེན་པོའི་སྣང་བརྙན་རིང་བསྲེལ་རྣམ་བཞི་སྤྱི་བྱེ་བྲག་གི་བདག་ཉིད་རབ་ཏུ་གནས་པ་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་སྒོ་ནས་ཡེ་ཤེས་སེམས་དཔར་སྒྲུབ་པར་མཛད་པ་དང་།",
    "ཚོགས་མང་སྐབས་ནུབ་གཅིག་གཟིགས་སྣང་དུ།",
    "བུད་མེད་འཆོར་མོ་དང་ཧྲུལ་མོ་མང་པོ་ཀུན་རང་གཞས་བྱེད་མུ་ནས།",
    "སྤང་ཤིང་ཕུན་ཚོགས་སོགས་སྐྱིད་གྲོང་པ་རེ་གཉིས་བཅས་འབྱོར་ཕྱག་པུ་ཏྲའི་བསྟོད་བསྐུལ་དང་མཉམ་དུ་བྱུང་བས་མོན་བུ་དངོས་སུ་འོང་བ་ལྟ་བུའི་ཐུགས་ཉམས་འཁྲུངས།",
    "མི་སྣ་རྒན་པ་དེས་རྡོ་ནག་གི་ཕོར་པ་གུ་ཡུས་བཀང་བ་སོགས་སྤྱི་སྒེར་ནས་འབུལ་བ་དང་།",
    "ཁོ་ན་རེ།",
    "རྗེ་རྡོ་རྗེ་འཆང་གི་གསུང་ལས།",
    "ཕྱག་མཛོད་སོ་སོ་དང་ཚོང་འདུས་སོགས་གང་སར་ཕན་བཞེད་དེ་བཞིན་རྗེས་སུ་ཡི་རང་།",
    "ཞེས་པའི་རྡོ་རྗེའི་ཐ་ཚིག་དེས་ཁོང་རྣམས་ཐལ་མོ་སྦྱར་ཞིང་མགོ་དུད་པ་བཅས་དགའ་མགུ་ཡི་རང་ལ་འཁོད་ཅིང་།",
    "བྱ་ཁྲ་མར་མདུན་གྱི་ཤུགས་འདྲེན་མཚོན་པའི་བུ་མོ་རྣམས་ནས་ཞིང་སྟེང་དུ་མདའ་དར་དྲང་པོར་བཙུགས་པས།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "བཅོམ་ནས་བལ་རྒྱལ་རྡོ་རྗེའི་ཚིག་གིས་བསྐྱངས།",
    "དེང་སང་གི་བར་དུ་རང་གིས་བསྒྲགས་པ་མ་ཡིན་པར།",
    "དག་པའི་གཟིགས་ངོར་བདེ་བ་ཅན་གྱི་ཞིང་ཁམས་ཀྱང་དེ་བཞིན་བཅས།",
    "ངེད་རང་གི་ཐོག་ལའང་ཕྱི་ནང་གི་སྤེན་པད་ཉམས་གསོ་གསར་བཞེངས་དང་།",
    "སྐུ་གསུང་གི་རྟེན་ཁྱད་མཚར་གྲངས་མང་མཆིས་ཀྱང་།",
    "ཞེས་སྟོན་པ་མཚོན་བྱེད་དུ་ད་ལམ་གཙུག་ལག་ཁང་གི་རྩེར་སྐལ་ལྡན་ཐམས་ཅད་བགྲོད་པའི་སྐས་རིང་ངོ་མཚར་ཅན་ཀུན་གྱི་བློར་མི་ཤོང་བ་ལྟ་བུ་དང་།",
    "ཚེས་བཞིར་གསོལ་ཐབ་སྤོ་གནང་དང་ཆབས་གཅིག་རྗེ་རྡོ་རྗེ་འཆང་གི་དབུ་གཡས་ཞལ་ངོ་རྣམས་དང་།",
    "གཞན་བྱིངས་ནས་རང་རང་གི་བློས་དཔྱད་ཀྱི་ལག་ཆ་བཅས།",
    "རྗེ་རྡོ་རྗེ་འཆང་ཡབ་སྲས་དཔོན་བརྒྱུད་དང་བཅས་ལ་འབྲེལ་ཐོགས་ཐམས་ཅད་སྲིད་ཞིའི་རྩེ་མོར་འཁྲིད་པ་སོགས་ཏེ།",
    "དགའ་སྟོན་གྱི་སྤྲོ་ཟས་སོགས་སྩལ་ཏེ་རིམ་གྱིས་ལྷ་ཁང་བྱང་གི་སྐས་ལ་བཏང་།",
    "དེ་ནས་ཞལ་དྲོའི་ལྷུམས་ཞུགས་དུས་སྟོན་གྱི་ཐོ་རེངས་མནལ་ལམ་དུ།",
    "རྗེ་ཉིད་ཀྱི་སྐུ་གཟན་སྣེ་མོས་ཀ་བ་དེ་བརྡུངས་ཤིང་བགེགས་སྐྲོད་དང་།",
    "ཕུན་སུམ་ཚོགས་པའི་ཤིས་བརྗོད་མཛད་སོང་བས།",
    "དེ་སྐབས་མཛོད་འཛིན་པར་ཡར་ལམ་རྟ་དྲེའུའི་གདོང་འུར་གྱིས་འགའ་ཞིག་གི་རྐང་ལག་ལ་སྐྱོན་པ་སོགས་འཚུབས་ཉམས་དེ་དག་ཞི་བའི་བཀའ་འདོམས་དང་།",
    "ཕུར་སྒྲུབ་སྐབས་གང་གི་རྔ་བོ་ཆེ་གསར་བཞེངས་ལ་ཤིང་རྩི།",
    "ཨ་མེས་ཞབས་རྣམས་ཀྱི་འདྲ་སྐུར་ས་ཞུ།",
    "ས་བསྐོར་ཉིན་ཐོ་རངས་སྔ་མོར་རྗེ་ཉིད་ནས་སྒོ་རྔར་ཕྱག་ནས་དུས།",
    "སྒོ་རྔ་སོགས་སྲུང་སྐྱོང་གི་གཉེར་དམ་དང་སྦྱིན་བདག་བསྒོ་བར་སྲས་ཡུམ་རྣམས་ཕེབས་ཐོག་དྲུང་སེར་སྐྱས་ལེགས་སོ་བཅས་ཤར་མདའ་བཏང་ཙམ་ལ་གྲོལ་ཅིང་།",
    "བསྟན་བསྟན་འཛིན་སྤྱི་བྱེ་བྲག་སྣོད་བཅུད་བཅས་ལ་གནས་སྐབས་མཐར་ཐུག་གི་བསྔོ་སྨོན་བཀྲ་ཤིས་ཀྱིས་མཐའ་བརྒྱན་པ་བཅས་སྩལ་ཉིན་ཉི་མའང་གཞན་ལས་རིང་བ་བྱུང་ཞིང་།",
    "ཚེས་དགུའི་ཉིན་སྐྱེད་ལྷས་མེ་འབར་གྱི་མགོན་ཁང་གི་གཡས་གཡོན་རི་ནས་ཤག་མཆེར་ཉིལ་བ་དང་།",
    "མགོན་ཁང་དུ་གཏོར་བསྔོ་བསྐང་བ་སོ་སོ་ནས་བརྒྱ་ཚར་སོགས་སྤྱི་བྱེའི་བསྟན་པ་ཐུགས་ཀྱི་དཔལ་བེར་དམ་དུ་བཟུང་བའི་རླབས་ཆེན་རྒྱལ་སྲས་མཆོག་གི་མཛད་པས་ཞག་འགའ་ཞིག་འདས་རྗེས་སུ།",
    "དགེ་སློང་གི་ལུས་ཀྱང་བདེ་བར་གྱུར་ཏེ་མི་ཕྱེད་པའི་དད་པ་ལ་བཀོད།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "གཉན་མགོན་གདོད་མའི་རང་ཞལ་ལྷུག་པར་གཟིགས།",
    "མཐའ་འགྲོའི་རེ་བའི་ཡོལ་གོ་བཅུད་ཀྱིས་ཕྱུང་།",
    "ཞེས་ཀྱང་སྨྲས་སོ། དགུང་གྲངས་ཞེ་གསུམ་དུ་ཕེབས་པ་ལྕགས་ཡོས་རྒྱལ་ཟླའི་མཇུག་ཙམ་གྱི་གཟིགས་སྣང་དུ།",
    "དེའི་ཚེ་གཉའ་ནང་ཤོ་པ་ཟུང་གི་ཡི་གེ་ལས།",
    "འདི་ནས་བང་མི་བལ་ཡུལ་ལ་འགྲོ་སྐབས་ཡོ་མོའི་ཆུ་སོགས་འབབ་པའི་ཆུ་ཆེན་ཞིག་ལ།",
    "སྐྱབས་མགོན་ཁྱེད་རང་གི་ཐུགས་རྗེས་ཆུ་ཆུང་བ་ཞིག་ཏུ་བང་མི་གྲུ་མཁན་གྲུ་ཆག་སོགས་དང་།",
    "བདེ་གླིང་ཚོགས་ཡོངས་ནས་རི་ཁྲོད་མའི་བུམ་ཆོག་རྒྱས་པ་ཚོམས་ཆེན་དུ་མཛད་པ་ལ།",
    "གོང་གི་རྫས་རྣམས་གཏོར་མ་དང་ཆབས་གཅིག་ཏིང་འཛིན་སྔགས་རྒྱས་བསྔོ་གནང་གིས།",
    "འཛམ་བུའི་གླིང་འདིའི་ཕྱི་རོལ་བདེ་བ་ཅན་གྱི་ཞིང་གི་ཤར་ཙམ་དུ།",
    "ཉིན་རེ་བཞིན་ལྷ་ཆེན་རྩེ་ནས་ཕྱོགས་བཞིར་སྦྱོང་ཁྲུས་མཛད་པས།",
    "སྲུང་མ་སྤྱི་དང་ལྷ་མོ་རྗེ་ཁོལ་ལ་ཕྲིན་འཆོལ་བཅས་ཉིན་གསུམ་སྔོན་འགྲོའི་ཟླ་བ་ཁ་ཤས་དེ་བཞིན་ནར་མར་མཛད།",
    "འཕྲལ་ཡུན་རེ་སྨོན་རྗེ་བཙུན་ས་སྐྱ་པའི་གོང་མ་སྤྱི་དང་།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "དག་སྣང་རྣམ་བཀྲ་ནང་གི་མ་ཀུ་རར།",
    "རྫས་སྔགས་ཏིང་འཛིན་དཔུང་གིས་ཕ་མཐར་དབྱུང་།",
    "གཟིགས་འཕྲལ་ལུས་མིན་ཧུབ་གཅིག་གིས་གསོལ་བའི།",
    "ཕྱོགས་བཞིར་སྦྱོང་ཁྲུས་རེ་མོས།",
    "རེ་མནྟ་དང་མགོན་པོའི་རྟ་གཟུངས།",
    "དབུགས་ཆེན་མོ་རྣམས་ཉིན་རེ་བཞིན་ལྗགས་ཀློག་མཐར།",
    "མ་མོ་སྤྱི་གཏོར་རྗེ་ཁོལ་གྱི་བསྐང་གཏོར།",
    "མ་མོ་མཁའ་འགྲོའི་ཆོ་འཕྲུལ་འཁོར་ཉམས་ཅི་ཡང་བྱུང་ཞིང་།",
    "སྤྲུལ་པའི་ལྷ་ཁང་ཆེན་མོ་གཅིག་པུར་ཡང་ཤར་ནུབ་བྱང་གསུམ་ལ་སྤེན་བད་གསར་སྒྲོན།",
    "གཞུང་ས་མཆོག་ནས་ཀྱང་གཞིས་རྩེས་མཚོན་བོད་ཁམས་བདེ་ཐབས་སུ་མངགས་པའི་རིམ་གྲོ་རྣམས་དང་དོད་ལྷུས་བླངས་གང་ལ་གང་འཚམས་ཡེ་ཤེས་གཟིགས་པས་དཔྱད་ནས་མཛད་ཅིང་།",
    "གང་ནའང་གྲོལ་ནས་ཞག་གསུམ་པའི་ཐོ་རེངས་འོད་གསལ་དུ།",
    "མི་ཕོ་མོ་མང་པོས་སྐུ་ཉིད་ལ་དད་འདུན་ལྷག་པར་ཆེ་བ་དང་།",
    "བུད་མེད་གཅིག་འཆོར་གཉིས་འཆོར་བདུན་བརྒྱད་ཅིག་འོངས་ནས་པད་བསྐོར་སོགས་ལུས་ཀྱི་རྣམ་འགྱུར་དོད་ཉམས་དང་།",
    "གྲོ་བཞིན་ཕུར་བསྒྲུབ་ཉེར་གཅིག་མུས་ཆེན་མཆོད་བསྔོར་དཔལ་འཁོར་ལོ་བདེ་མཆོག་གི་རྣམ་སྤྲུལ་ཡིན་པའི་བསྔགས་བརྗོད་མཛད་པས།",
    "དེའི་ཐོ་རེངས་ཀྱི་འོད་གསལ་དུ།",
    "རྟེན་ཁྲི་གཞན་ཞིག་ན་ཁ་ཆེ་པཎ་ཆེན་གྱི་ཐུགས་དམ་མ་བདེ་མཆོག་ལྷན་སྐྱེས་གསེར་ཟངས་ཀྱི་སྐུ་མཁྱིད་གང་ཙམ་ཞིག་བཅས་གཟིགས་སྣང་དུ་འཁྲུངས་པ་འདི་ལ།",
    "རྗེ་རྡོ་རྗེ་འཆང་གི་བཀའ་ལས།",
    "ཐུབ་སྐུ་དེ་འབུལ་མི་ཡིན་རྒྱུའི་མུས་ཕྱོགས་ནས་དགེ་སློང་བུད་མེད་ཀྱི་ཆས་ཅན་ཞིག་འདུག་པར།",
    "སྤྱིར་དགེ་སློང་གི་སྐྱ་ཆས་དང་།",
    "བྱེ་བྲག་བུད་མེད་ཀྱི་ཆས་འདི་འདྲ་གླང་དར་མའི་དགེ་སློང་ཡིན་འདྲ་གསུངས་པས།",
    "བྱེ་བྲག་རང་རེས་ལུགས་ལ་གོང་མ་ལྔ་བསྟོད་མེད་ན་མི་རུང་བས་ཐོན་གསུངས་པས།",
    "བུད་མེད་གྱི་ཆས་བགྱིས་པ་གབ་ཚིག་བཟང་ངན་དབྱེ་དཀའ་གསུངས།",
    "རྗེ་རྡོ་རྗེ་འཆང་ཉིད་ཀྱིས་ས་སྐྱ་ནས་འབུལ་གནང་གིས་ཕར་གསན་ཚུར་གསན་ཤིན་ཏུ་གསལ་བར་འཁྲུངས་ཀྱང་ཚིག་དོན་ཇི་བཞིན་མ་ངེས།",
    "ཞེས་གསུང་གི་གསང་བར་མངའ་བརྙེས་པའི་བརྡའོ།",
    "ལྷ་མོ་སྟག་ཞོན་རྣམས་དང་།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "ཟེའུ་ལྷ་ཁང་འདྲ་མོ་ཞིག་ནས་ཚེ་དཔག་མེད་ཀྱི་སྐུ་ཆེ་ཆུང་སྣ་ཚོགས་ཤིག་རྙེད་པ་འཁྲུངས་པ་དང་མཉམ་དུ།",
    "ཡང་རྒྱལ་ཟླའི་ནང་ཞིག་སྐུ་པར་མང་པོ་ཞིག་གི་ཁྲོད་ནས་ཚེ་དཔག་མེད་ཀྱི་སྐུ་པར་གསལ་བ་རྣམས་རྙེད་པ་འཁྲུངས་པ་ནི།",
    "ལྷོ་རོང་གི་ལམ་ཡིན་དགོངས་པ་ཞིག་ཤར་བ་ནི།",
    "དེ་དུས་མར་པ་མི་ལ་ཞལ་གཟིགས།",
    "ཏེ་ལོ་པ་རྣམས་ཀྱང་གཟིགས་ཤིང་།",
