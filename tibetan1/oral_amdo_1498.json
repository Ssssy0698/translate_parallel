    "ཁྲེན་པ་ལ་སོགས་པ་རང་གི་སྒྲ་ཡིས་ཡང་དག་པར་སྦྱོར་བ་ལས་སྒྲ་བརྙན་དུ་འགྱུར་རོ།",
    "འདི་ནི་སྲིང་བ་གསུམ་གྱི་གནསསུ་སུ་ཞིག་གིས་ཀྱང་སྤྲུལ་པ་མིན་ནོ།",
    "གཞི་ག་ཡང་རྒྱ་ཉིད་དུ་ཐལ་བར་འགྱུརརོ།",
    "རྒྱན་འབྲས་བུལ་ལྟོས་པའི་ཕྱིར་ངེས་པམེད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་ཏེ།",
    "འདིར་ཁྱོད་ཀྱི་འདོད་པ་ལས་གྲུབ་ཅིང་།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་འདོད་པ་ལས་གྲུབ་ན།",
    "དེའི་ཚེ་བདག་གི་ཡང་འདོད་པ་ལས་ཁྱོད་ཀྱི་ཡོདཔ་གང་ཡིནཔ་དེ་ནི་བདག་གི་མེད་པར་གྲུབ་སྟེ།",
    "ཇི་ལྟརག་ལ་ཏེ་ཁྱོད་ཀྱི་ཕྱོགས་སྒྲུབ་པར་བྱེད་པའི་མཚན་ཉིད་ཐོབ་པ་དེའི་ཚེ།",
    "བདག་གི་ཕྱོགས་ཀྱང་བསྒྲུབ་བར་འགྱུར་ཞིང་།",
    "ཅི་སྟེ་ཁྱོད་ཀྱི་ཕྱོགས་སུན་འབྱིནཔའི་མཚན་ཉིད་ཐོབ་།་པ་དེའི་ཚེ།",
    "བདག་གི་ཕྱོགས་ཀྱང་སུན་འབྱིན་པར་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་ཇི་ལྟར་ནམ་མཁའལུས་ཅན་མ་ཡིན་པ་ཉིད་ཀྱིས་རྟག་པ་དེ་བཞིན་དུ་སྒྲ་ཡང་ཡིནནོ།",
    "འདིར་གང་གི་དུས་ན་དམ་བཅའ་བ་ཡོད་པ་དེའི་དུས་ན་གཏན་ཚིགས་མེད་དོ།",
    "གང་གི་དུས་ན་གཏན་ཚིགས་ཡོད་པ་དེའི་དུས་ན་དམ་བཅའ་མེད་དོ།",
    "དེས་ན་ད་མ་བཅའ་མེད་པའི་གཏན་ཚིགས་འདི་གང་གི་ཡིན་ཏེ།་",
    "པྲ་ཡིག་གིས་ཇི་ལྟ་བ་བཞིན་དུ་ཡི་གེ་ཡི་གེ་ཡིའོ།",
    "བདག་གི་བ་མེད་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་དངོས་མེད་དག་ཀྱང་ཡོད་དེ་སྐད་ཅིག་རྣམ་བྲལ་རང་བཞིན་མེད་པ་དག་གི་ཞུསྲིདཔ་ཡོད་ཅེས་པ་ནི།",
    "གདོན་ཐམས་ཅད་ལས་རྣམ་པར་གྲོལ་བའི་ཚིག་གང་ཡིན་པོ་དེ་ནི་ལྷ་དང་གདེངས་ཅ་ན་རྣམས་ཀྱི་གདོན་བཅས་ཚིག་གིས་འཇོམས་མི་འགྱུར།",
    "རང་གི་ཕྱོགས་འཛིན་པ་དེས།",
    "འདིར་གལ་ཏེ་གང་ཟག་གི་ནང་ན་འདུས་པ་སྐྱེ་བའི་ཆ་གས་ཅན་གྱི་གང་ཟག་ཡོད་ན།",
    "མོ་གཤམ་གྱི་བུ་བཞིན་དུ་མེདཔ་དག་ཏུ་འདོད་པས་སོ།",
    "བདག་གིས་སྟོང་ཞིང་བྱེད་པོ་མེད།",
    "ཁ་ཆེའི་གཞུང་གི་ཆུ་གཏེར་གྱི།",
    "ནམ་མཁའ་མོ་གཤམ་བུ་དང་མཚུངས།",
    "འདིར་ཁམས་གསུམ་པ་ནི་རྣམ་པར་ཤེས་པ་ཙམ་མོ།",
    "མ་རིག་པའི་བག་ཆགས་ཀྱི་དབངགིས་སོ་ཞེན།",
    "འདིར་གང་གི་དུས་ན་གནས་ཉིས་བརྒྱཔ་ཡོད་པ་དེའི་དུས་ན་སྐྱེ་བ་དང་འཇིག་པ་མེད་དོ།",
    "གང་གི་དུས་ནའཇིག་པ་ཡོད་པ་དེའི་དུས་ན་སྐྱེ་བ་དང་གནས་པའོ།",
    "གང་གི་ངུས་ན་སྐྱེ་བ་ཡོད་པ་དེའི་དུས་ན་གནས་པ་དང་འཇིག་པ་མེད་དོ།",
    "འཁོརབ་ཡང་སྲིད་པ་གསུམ་གྱི་མཆ་ན་ཉིད་དེ་སྲིད་པ་གསུམ་ནི་ཁམས་གསུམ་མོ།",
    "གལ་ཏེགནས་པ་མེད་པར་འཇིག་པ་དང་སྐྱེ་བར་འགྱུར་ན་དེའི་ཚེ་རི་བོང་གི་རྭ་ལ་ཡང་འགྱུར་རོ།",
    "འདིར་གངགི་དུས་ན་གནས་པ་ཡོད་པ་དེའི་དུས་ན་སྐྱེ་བ་དང་འཇིག་པ་མང་པོ།",
    "ཉེགང་གི་རུས་ནི་འཇིག་པ་ཡོད་པ་དེའི་དུས་ན་སྐྱེ་བ་དང་།",
    "གང་གི་དུསན་སྐྱེ་བ་ཡོདཔ་དེའི་དུས་ན་གནས་པ་དང་འཇིག་པ་མེད་དོ།",
    "འདིར་གང་གི་སྐྱིད་རྗེདམིགས་པ་མེད་ཅིང་རྣམ་པར་རྟོག་པ་དང་བྲལ་བ་དང་།",
    "མི་རྣམས་སྐྱེ་དང་སྐྱེ་བ་གཞན་དག་གི་ལས་ཀྱི་འབྲས་བུ་ཉེ་བར་ལོངས་སྤྱོད་པའི་ཕྱིདངོ།",
    "འདི་དག་སྟག་གཟིག་རྣམས་ཀྱང་ངེས་པར་འདོད་པར་འགྱུར་ཏེ།",
    "བརྟག་པ་དག་ནི་ལུམ་ཀྱི་མཐུ་ལས་ཕྲ་མོ་བཟུང་བ་ལས་ཕྲ་མོར་འགྱུར་ཞིང་ལུས་སྦོམ་པོར་བཟུང་བ་ལས་སྦོམ་བོར་ཡང་ནིརབ་ཏུ་འགྱུརརམ་ཅི།",
    "ཡེ་ཤེས་འབའ་ཞིག་གི་སྟོབས་ཀྱིས་སོ།",
    "འཇིག་པའི་བདག་ཉིད་ནི་རང་གི་ཡོན་ཏན་དང་ལྡན་པའི་ཕྱིར་ཏེ།",
    "འདིར་སྔར་བརྗོད་པའི་སྲོག་གི་ལུས་ཀྱི་ཆ་ཤསདྲུག་པོ་རྣམས་ཀྱི་ནང་ནས་ནགས་ཀྱི་བདག་པོ་རྣམས་ཀྱི་སྲོག་སྟེ།",
    "ཉིས་དེའི་ཚེ་བུར་ཤིང་གི་དབྱིག་པ་དུམ་བུ་དུམ་བུར་བྱས་པ་ལས་དུམ་བུ་དུ་མར་འགྱུར་ཏེ།",
    "དེ་དག་གི་ནང་ནས་དུམ་བུ་གཅིག་ནི་རྟག་ཏུ་སྲོག་དང་བཅས་པ་སྟེ།",
    "རིག་བྱེད་ཨོ་གྱི་ཡི་གེ་གཙངམ་དག་སྟེ་རྒྱལ་པོ་དངོས་པོ་ཀུནགྱི་བདག་ལ་སྐྱབས་སུ་སོང་ཞེས་པ་ནི་སྐྱབས་ཀྱི་ངེས་པའོ།",
    "ཁྱབ་ནི་། མགོན་པོ་ཁྱོད་ནི་བྱེད་པོ་ཕན་དང་སྡིག་འཕྲོག་ཁྱོད་ནི་གོ་འཕང་ཕུན་སུམ་ཚོགས་པ་ཡད།",
    "ཁྱོད་ནི་འབའ་ཞིག་གནས་དང་ཁྱོད་ནི་ཡོན་ཏན་མཆོག་ག་གི་གནས་ཏེ་སྐྱོན་རྣམས་བཅོམ་པ་ཁྱོད་ཉིད་དོ།",
    "དཔེ་སྒྲིག་གི་སྐབས་སུ་དཀའ་ལས་མི་ཉུང་བ་ཞིག་ལ་ཕྲད་མོད་ཀྱི།",
    "བསྡུར་ཐབས་མ་བྱུང་བ་རྣམས་འོལ་ཚོད་ཀྱིས་བཅོས་ན་གནའ་དཔེ་ཞིབ་འཇུག་གི་རིན་ཐང་ལ་གནོད་པར་དོགས་ནས་སོར་བཞག་བྱས་ཡོད་ལ།",
    "ན་མོ་ཤྲཱི་དི་པཾ་ཀ་ར་ཛྙཱ་ཎ་ཡེ།",
    "དཔལ་ལྡན་མར་མེ་མཛད་ཅེས་གང་གི་མཚན་ཐོས་ཀྱང་།",
    "རྒྱུད་ལ་སྐྱེ་སྙམ་འབད་པ་མཆོག་གིས་འདི་འབྲིའོ།",
    "ཇོ་བོ་ཉིད་ཀྱིས་མཛད་པའི་གསེར་གླིང་གི་ལམ་ཡིག་དང་།",
    "ཞག་རེ་ཞག་གཉིས་བབ་མལ་བརྩིས་པའི་སར།",
    "དེ་ནས་ལོ་གསུམ་སོང་ནས་སྙེ་ཐང་བཞུགས།",
    "གཙང་གི་ཕྱོགས་སུ་ལོ་གཉིས་ཉེ་བར་གནས།",
    "དེས་ཇོ་བོ་ལ་འཇིགས་པའམ་བག་ཚ་བ་ཅི་ཡང་མ་བྱུང་བས་བར་ཆད་མ་ནུས་པར་གྱེས་ནས་སོང་སྐད།",
