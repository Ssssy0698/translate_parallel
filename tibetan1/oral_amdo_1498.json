    "ཁྱོད་བསམ་ད་རུང་བྱོན་པར་མ་ལགས།",
    "ཨེ་མ་མཁས་པ་ཁྱོད་ཉིད་མི་བཞུགས་པས།",
    "ཡུལ་གྱི་དབུས་འདི་ཁྱོད་ཀྱིས་བསྐྱང་དུ་གསོལ།",
    "ཡོངས་འཛིན་ཁྱོད་ཀྱིས་ངེད་ཀྱི་ལྷ་དེ་རྫོངས།",
    "རྔ་མོའི་བྲེས་སུ་གླང་པོའི་སྣ་མི་ཤོང་།",
    "ཚང་དེར་སོར་མོ་ཙམ་ཡང་ག་ལ་ཤོང་།",
    "འབྲུ་ཤོད་འབྲས་ཀྱི་ཡུལ་ན་ཅོག་མོ་ཞིག།",
    "འབྲས་ཕུལ་གང་གིས་བྱ་བརྒྱ་སོག་ཞེས་ཐོས།",
    "ནགས་སྟོད་འགྲིམ་པ་སྟག་གི་རྒྱལ་པོ་ལ།",
    "རང་གིས་ཉམས་སུ་མྱོང་བ་ཚད་བྱ་ཡིན།",
    "མཁས་པ་ཁྱོད་ཀྱིས་ངའི་དྲུང་བཞུགས་ནས།",
    "ལོ་དྲུག་ཟླ་བ་བདུན་དུ་སོང་བ་ལས།",
    "བདག་གི་ཡོན་ཏན་ཐམས་ཅད་རྫོགས་པར་བྱས།",
    "ད་ནི་རེ་ཞིག་རྒྱ་གར་དབུས་སུ་སོང་།",
    "རེ་ཞིག་གསུངས་རྣམས་བདག་གིས་སྒྲུབ་པར་བགྱིད།",
    "འཕྲིན་ལས་བཟང་པོས་ཉོན་མོངས་གདུང་བ་ཆོད།",
    "དེ་ནས་ཇོ་བོས་རང་རང་གི་སའི་བདག་པོ་རྣམས་བསྐུལ་ཏེ།",
    "གཙུག་ལག་ཁང་གི་ཞིག་རལ་ཐམས་ཅད་བསོས་ཞིང་དར་ཞིང་རྒྱས་པར་མཛད་དོ།",
    "ཐུན་མོང་གི་དངོས་གྲུབ་ཐོབ་པ་དང་།",
    "ཏིང་ངེ་འཛིན་རི་རྒྱུད་ཙམ་ཡོད་པ་སོགས་ཁྱོད་ཀྱི་ཡོན་ཏན་དེ་རྣམས་ཀྱིས་གར་ཡང་མི་ཕྱིན།",
    "ཡང་གཅིག་ན་རེ།",
    "ཡང་ཞབས་བསྐོར་མཛད་པའི་དུས་ཤིག་རྡོ་རྗེ་གདན་གྱི་ལྷོ་ཕྱོགས་ཀྱི་ནམ་མཁའ་ལ་བུ་མོ་གཞོན་ནུ་མ་ལྷའི་ལུས་ཅན་རྒྱན་གྱིས་བརྒྱན་པགཉིས་བྱུང་ནས།",
    "བུད་མེད་གཉིས་དྲི་བ་དྲི་ལན་བྱེད་ཅིང་།",
    "ཡང་སྒྲོལ་མ་ལྷ་ཁང་གི་དྲུང་ན་བུད་མེད་རྒན་གཞོན་གཉིས་ཅེས་འདུག་པས་གཞོན་པ་དེས།",
    "ཐུགས་རྗེ་ཆེན་པོ་ཞལ་མངོན་སུམ་དུ་གཟིགས་ནས།",
    "བྲི་ཀ་མ་ལ་ཤཱི་ལའི་གཙུག་ལག་ཁང་གི་ངོས་གཅིག་ལ་པཎྜི་ཏ་རྣམས་དང་།",
    "ཁྱད་པར་གཙུག་ལག་ཁང་གི་སྒོ་གདོང་གཡས་ལ་སློབ་དཔོན་ཀླུ་སྒྲུབ་དང་གཡོན་ལ་ཇོ་བོ་བྲིས་ཏེ་ཀླུ་སྒྲུབ་དང་མཉམ་པར་བྱེད་སྐད།",
    "ཉམས་པ་སྒོ་ལ་འགྲོར་མི་བཏུབ་གསུངས་ནས་རྩིག་པ་ལ་ཐལ་གྱིས་བཞུད།",
    "དེ་སྦྱངས་པའི་ཕྱིར་ཉིན་རེ་བཞིན་སཱ་ཚ་བདུན་རེ་འདེབཔ་དང་།",
    "སྐབས་དེ་དག་གི་ཚེ་རྒྱ་ནག་གི་རྒྱལ་པོ་དང་།",
    "དེ་ནས་ལོ་གཉིས་ཟླ་བ་ཕྱེད་ལྷག་པ་སོང་བ་ན།",
    "དེར་སོང་དེ་ན་ཁྱོད་ཀྱི་གདུལ་བྱ་ཡོད།",
    "ཁྱོད་ཀྱིས་སྲས་ཡིན་སྣ་ཚོགས་སྤྲུལ་པ་འགྱེད།",
    "སྤྱན་རས་གཟིགས་ཡིན་འགྲོ་རྣམས་ཐུགས་རྗེས་སྐྱོངས།",
    "ཁྱོད་སོང་བོད་ཁམས་ཡོངས་ཀྱི་བདག་པོ་མཛོད།",
    "ཇོ་བོས་དག་པའི་སྤྱན་གྱིས་བོད་ཡུལ་གྱི་ཕྱོགས་ལ་གཟིགས་ནས།",
    "ཞིང་དེ་བདག་གིས་གདུལ་བ་ཅང་ནུས་སམ།",
    "བདག་གིས་མཐའ་འཁོབ་ཇི་ལྟར་ཐུལ།",
    "དེ་ནི་བདག་གི་མཐུ་བོ་དམ་པར་མཐོང་།",
    "བདག་གི་འཕྲིན་ལས་ཆེན་པོ་བསྐལ་པ་བཟང་།",
    "ཁྱོད་ཀྱི་ཐུགས་དང་འགལ་བ་མི་བགྱིའོ།",
    "ཡང་དུས་སྐབས་དེ་དག་གི་ཚེ་མ་ག་དྷའི་རྒྱལ་པོ་དང་།",
    "ཇོ་བོས་ཀྱང་ལམ་བར་ཆུ་ཆེན་པོ་ཡོད་པ་སོགས་ལ་དཀའ་ཚེགས་དང་ལུས་སྲོག་ལ་མ་གཟིགས་པར་ཡང་ཡང་བརྒལ་ཏེ་ཡོ་བྱད་ཐམས་ཅད་འདུམ་གྱི་ཕྱིར་བཏང་ནས་རྒྱལ་པོ་གཉིས་འདུམས་ནས་མཛའ་བར་མཛད་དོ།",
    "བོད་ཕྲུག་རིག་པ་ཆེ་བ་མང་པོའི་ནང་ནས་རིན་ཆེན་བཟང་པོ་ལ་སོགས་པ་བདུན་ལ་གཡོག་རེ་རེ་དང་།",
    "དེ་ཁྱོད་ཀྱིས་སྤྱན་མི་འདྲོང་།",
    "བོད་ཀྱི་ལྷ་འདྲེ་དཔུང་ཚོགས་ཆེ་བས་ན།",
    "མེས་ཆེན་རྣམས་ཀྱི་རྣམ་སྲོལ་བསྐྱང་སྙམ་མོ།",
    "དེ་ལྟར་དགོངས་ནས་ལན་བཅུ་དྲུག་གི་བར་ཕོ་ཉ་བ་བརྫངས་ཀྱང་།",
    "ནོར་རྣམས་ཀྱང་གྲོན་དུ་སོང་བས་ཐུགས་སྐྱོ་བར་གྱུར་ཀྱང་།",
    "འཇིག་རྟེན་ལྷ་དང་བཅས་པས་ཁྱོད་བཀུར་ཞིང་།",
    "ཁྱོད་ཀྱི་ཐུགས་རྗེ་ཕྱོགས་རིས་མི་མངའ་ཞིང་།",
    "ཉིན་དང་མཚན་དུ་མགོན་པོ་ཁྱོད་བསམ་ན།",
    "དེ་མ་ཐག་ཕེབས་ཀྱང་བོད་ཀྱི་གདུལ་བྱ་མགུ་དཀའ་བས་དོན་དུ་ཆེར་མི་འགྱུར་བར་གཟིགས་ནས།",
    "དགེ་སློང་དིང་སང་ཀ་མ་ལ་རུ་སོང་།",
    "དགེ་སློང་དིང་སང་དི་པཾ་ཀ་རའི་དྲུང་དུ་སོང་།",
    "བདག་གི་གཏམ་འདི་དབེན་པར་སྙན་དུ་ཞུས།",
    "གསན་མ་ཐག་ལམ་དུ་ཞུགས་ནས་ཟླ་བ་དྲུག་གིས་རྒྱ་མཚོའི་ཕ་རོལ་བཅད་དེ་གསེར་གླིང་དུ་བྱོན་པས།",
    "ཁྱོད་ཀྱི་ལྟ་བ་གང་ཡིན་ཚུར་ཕུལ་དང་།",
    "གླང་པོ་གཅིག་གིས་གླང་པོ་གཅིག་བསད་ན།",
    "གང་དུ་ཁྱོད་ཀྱིས་འཕྲིན་ལས་བསྐྱངས་གྱུར་ཡང་།",
    "ཁྱོད་ཀྱི་འཕྲིན་ལས་བལྟ་ཕྱིར་ཡང་ཡང་འོང་།",
    "དེ་ནས་ཁྱོད་ཀྱིས་ཤེས་བྱ་སྤེལ་དུ་གསོལ།",
    "དེ་ལྟར་ཞུ་ལགས་མཁས་པ་གཟིགས་སུ་གསོལ།",
    "སྲོད་ལ་བུ་མོ་ཆས་ཀྱིས་བརྒྱན་པ་ཞིག་རྒྱན་ཆ་སིལ་སིལ་བྱུང་བས།",
    "ཁོ་བོ་དགེ་སློང་གཙང་མ་བུད་མེད་ལ་བལྟ་བར་མི་རུང་སྙམ་མ་གཟིགས་པར་བསྐྱེད་རིམ་བསྒོམས་པ་ན།",
    "དེ་ན་རེ།",
    "ཉོན་མོངས་འཆིང་པས་བསྡམས་པའི་སྐྱེ་བོ་དག།",
    "འཕགས་པའི་ཚོགས་ལ་མི་ལྟ་ཉོན་མོངས་བལྟ།",
    "བུ་གཅིག་ཁྱོད་ཀྱིས་མཉམ་བཞག་མཐུན་མཚམས་སུ།",
    "ང་འདིར་འོང་ཚེ་མ་ལ་ཅིས་མི་གཟིགས།",
    "ལས་ཀྱི་ལྷ་མོ་བཀྲ་ཤིས་དཔལ་འབར་མ།",
    "སྒྲོལ་མ་ཁྱོད་ནི་བདག་གི་མ་གཅིག་ཡིན།",
    "དི་པཾ་བདག་གི་གདུལ་བྱ་གང་ན་ཡོད།",
    "ཨེ་མ་བདག་གི་ཐེ་ཚོམ་གཅད་དུ་གསོལ།",
    "ཞིང་དེར་ཁྱོད་ཀྱིས་འགྲོ་དོན་དཔག་མེད་འབྱུང་།",
    "དེ་ལ་སོམས་ལ་ཁ་བ་ཅན་དུ་སོང་།",
    "ཇོ་བོས་དག་པའི་སྤྱན་གྱིས་ཨུ་པ་སི་ཀ་ཇི་ལྟར་མཛད་པ་ཀུན་གཟིགས་ཤིང་སྤྱན་ཆབ་ཁྲུལ་མཛད་ནས།",
    "གདན་འདྲེན་ཆེད་དུ་སྔ་མོར་བཏང་བྱུང་སྟེ།",
    "བཞི་སྣམ་གཅིག་གིས་ཆོག་ཀྱང་མི་སྟེར་གྱིས།",
    "སྔོན་ཆད་ཟླ་བ་གཉིས་ཙམ་སོང་ན་ཡང་།",
    "ད་རུང་ཁྱོད་དང་མ་མཇལ་སྐྱོ་ཡིན་གདའ།",
    "ཨ་རེ་བོད་ཀྱི་རྒྱལ་པོ་འོ་རེ་བརྒྱལ།",
    "སྡིག་རྒྱལ་ན་རེ་རང་དང་མཉམ་པ་དགོས།",
    "སྡིག་རྒྱལ་ན་རེ་ཐམས་ཅད་མ་ལོངས་ན།",
    "རྒྱལ་པོ་མི་གཏོང་ད་རུང་ཚོལ་ཞེས་ཟེར།",
    "དེ་ནས་ལྷ་ཆེན་སྡིག་རྒྱལ་ཁྲི་མོན་ན།",
    "ཁྱོད་ཀྱིས་སྔོན་ཆད་རྙེད་པའི་གསེར་རྣམས་ལས།",
    "ཡེ་ཤེས་འོད་ཀྱིས་ཁྱོད་ཕྱིར་འབད་པ་ཡིས།",
    "སྡིག་གི་རྒྱལ་པོས་སྲོག་དང་བྲལ་བར་བྱས།",
    "བདག་གི་བསམ་པ་ཚིམ་པར་མཛད་དུ་གསོལ།",
    "ཚེ་དང་ལྡན་པ་ཁྱོད་བདེན་ཤིན་ཏུ་མད།",
    "འདི་ལྟར་ན་རྒས་མགོ་བོ་དཀར་པོར་སོང་།",
    "ད་རུང་དུ་ཡང་འཐོན་པ་དཀའ་མོད་ཀྱི།",
    "ན་མོ་མཧཱ་ཀཱ་རུ་ཎི་ཀ་ཡ།",
    "ན་མོ་དི་པཾ་ཀཱ་ར་ཤྲཱི་ཛྙཱ་ན་ཡ།",
    "ན་མོ་ཛ་ཡ་ན་ཨཱ་ཀ་ར་ཡ།",
    "ཞིག་ཁྱེད་རང་གི་གསེར་བཟུང་ཞིག་གསུངས་ནས་གཏད།",
    "ནང་པའི་ལྷ་ཁང་ཆུང་ངུ་ཞིག་ཡོད་པ་དེར་སོང་ལ་རྣལ་འབྱོར་མ་ཞིག་ཡོད་པ་དེ་ལ་དྲིས་ཅེས་བྱུང་ནས་དེར་བྱོན་ཏེ་མཎྜལ་མཛད་ཅིང་ཡོད་ཙ་ན།",
    "ཡང་རྡོ་རྗེ་གདན་དུ་གསོལ་བ་གདབ་དགོས་དགོངས་ནས་བཞུད་པར་ཛྙཱ་ན་ཤྲཱི་ལ་ཞུས་པས་ཁྱོད་ཀྱི་དྲི་བ་དེ་རླབས་ཆེ་བར་འདུག་པས།",
    "རྡོ་རྗེ་གདན་ན་སྒྲོལ་མའི་རྣལ་འབྱོར་མ་རལ་པ་སེར་ཤ་རེ་བ་ཞིག་ཡོད།",
    "དེའི་ལམ་དུ་བུད་མེད་མིའི་ལུས་ལས་འདས་ལྷའི་ལུས་སུ་མ་སླེབས་པ་ཞིག་ལ་ཡིད་ཀྱིས་ཕྱག་དང་དྲི་བ་མཛད་པས།",
    "ཁྱོད་ངེས་པར་ལུས་སྲོག་ལ་མ་ལྟ་བར་སོང་ཞིག་འགྲོ་བ་མང་པོ་ལ་ཕན་ཐོགས་པར་འགྱུར་གསུངས་ཏེ་སྒྲོལ་མ་ཡིན་སྐད།",
    "རྡོ་རྗེ་གདན་དུ་བྱོན་པ་དང་རྒན་མོ་རལ་པ་སེར་ཤར་རེ་བ་ཞིག་ན་ཇོ་བོ་ཛྙཱ་ན་ཤྲཱིས་བསྐུར་བའི་འགྲོན་བུ་ཚུར་ཐོངས་གསུངས་ཏེ།",
    "ཁྱོད་བོད་དུ་འགྲོ་བར་འདུག་ཁྱོད་ཀྱི་གདན་ས་བྱང་སྐྱོབས་པ་ལྷོ་གཞོལ་བ་རྩི་ཤིང་ནགས་ཚལ་ཅན་ཞིག་འོང་།",
    "བྲམ་ཟེ་རྒན་པོ་ཞིག་གིས་རྒྱལ་པོའི་བུ་ལོ་བཅུ་ལོན་པའི་རོ་གཅིག་ཁུར་ནས་བྱུང་སྟེརོ་དེ་ཆུས་བཀྲུས།",
    "ཅུང་ཟད་ན་རོ་དེ་ལངསབྲམ་ཟེ་ཤི་ནས་རོ་ཆུར་སྐྱུར་ཏེ་སོང་བས།",
    "དེ་དག་ལ་སོགས་པ་ངོ་མཚར་བ་ཡང་སྣ་ཚོགས་གཟིགས་སོ།",
    "བྲི་ཀ་མ་ལའི་དགེ་སློང་གཞོན་ནུ་གཅིག་ན་རེ།",
    "མཁས་པ་ཆེན་པོ་བདག་གི་གདུལ་བྱ་གང་།",
    "མཁས་པ་བདག་གིས་འགྲོ་དོན་ཇི་ལྟར་བྱ།",
    "ཕ་གི་སྤུ་རྒྱལ་བོད་ཀྱི་ཡུལ་ཞེས་པ།",
    "མགོན་པོ་སྤྱན་རས་གཟིགས་ཀྱི་ཞིང་ཁམས་ཡིན།",
    "ཁྱོད་ཀྱི་སྲས་པོ་འབྲོམ་རྗེ་ཞེས་པ་ཡོད།",
    "མཁས་པ་བདག་གིས་ཞིང་དེར་ཕྱིན་པ་ན།",
    "བདག་གིས་ཞིང་དེར་འགྲོ་དོན་ཇི་ལྟར་བྱ།",
    "དི་པཾ་ཁྱོད་ནི་ཞིང་དེར་ཅི་ཞིག་བྱ།",
    "པཎ་ཆེན་གང་གིས་ཕྱིན་ཀྱང་འགྲོ་དོན་ཆུང་།",
    "དེ་ཕྱིར་མཁྱེན་བརྩེའི་མངའ་བདག་ཁྱོད་སོང་ལ།",
    "བདུད་རིགས་ཐམས་ཅད་ཐལ་བར་རློག་ཅིང་རྒྱུག།",
    "ལས་འབྲས་ཞིབ་མོ་ཕྱེ་རུ་འཐག་ཅིང་རྒྱུག།",
    "སྐྱེ་བ་གཏན་དུ་ཁྱོད་དང་མཇལ་བར་ཤོག།",
    "ཁྱོད་ཀྱི་གདུལ་བྱ་སྤུར་རྒྱལ་བོད་ན་ཡོད།",
    "ཕ་གི་རི་བོ་གངས་ཅན་རྒྱུད་དུ་བསྒོམས།",
    "དི་པཾ་ཀ་ར་གངས་རིའི་ཁྲོད་དུ་སོང་།",
    "ཐུགས་རྗེ་ཆེན་པོ་ཁ་བ་ཅན་དུ་སོང་།",
    "རེ་ལྟོས་མེད་པར་ཕན་བདེའི་གོ་ཆ་གྱོན།",
    "དྲིན་ལན་གང་གི་སྲོག་ལ་རྒོལ་གྱུར་ཀྱང་།",
    "གསང་སྔགས་ཐམས་ཅད་རང་གི་སེམས་ལ་བཟུང་།",
    "དེ་ན་ཁྱོད་ཀྱི་སྲས་པོ་འབྲོམ་རྗེ་ཡོད།",
    "དེ་ལ་སོམས་ལ་ཁ་བ་ཅན་དུ་སོང་།",
    "མགོན་པོ་ཁྱོད་ཀྱིས་བོད་ཁམས་མ་བཏུལ་ན།",
    "མགོན་མེད་རྣམས་ཀྱིས་མགོན་སྐྱབས་སུ་ལ་རེ།",
    "དིང་སང་དུས་ན་མཁས་པ་ཆེན་པོ་ཁྱོད།",
    "ཁྱོད་ཀྱི་ཐུགས་རྗེ་ཆེན་པོའི་བསྐུལ་མ་ལགས།",
    "དེ་ལྟར་ལགས་པས་ཁྱོད་ཀྱི་སྐུ་མཆོག་ནི།",
    "དེ་ལྟ་མོད་ཀྱི་ཤིན་ཏུ་ངོ་མཚར་ཆེ།",
    "ཅི་ཟེར་ཁྱོད་ཀྱི་གདུལ་བྱ་བོད་ན་ཡོད།",
    "ཚམ་ཚོམ་མ་མང་མྱུར་དུ་བོད་དུ་སོང་།",
    "མི་ཁྱོད་མགོ་བོ་དུང་དུ་སོང་སོང་དུ།",
    "ཕཊ་ཕཊ་ད་ནི་མྱུར་དུ་ཁྱོད་སོང་ལ།",
    "དམ་པའི་མིང་གི་སུ་ལ་ཅི་ཞིག་བྱ།",
    "ཁྱོད་ཀྱི་ཆེད་དུ་བོད་ཀྱི་རྒྱལ་པོ་ཡིས།",
    "རིན་ཆེན་སྦས་པའི་གཏེར་ལ་སྦྱོར་དུ་སོང་།",
    "མཐའ་འཁོབ་རྒྱལ་བའི་ཞིང་ལ་སྦྱོར་དུ་སོང་།",
    "དམ་ཚིག་ངན་པའི་སྤྱོད་པ་རྫི་རུ་སོང་།",
    "ཁྱོད་ཀྱིས་རིག་པ་བསྐྱེད་ནས་གནས་ལུགས་སྟོན།",
    "ཉོན་མོངས་ངན་པས་རྒབ་ཏུ་འཁྲིད་པར་ཉེ།",
    "ད་འདིར་ཁྱོད་ལ་གྲོགས་ངན་སུ་ཡིས་གོས།",
    "ཅི་ཟེར་ཁྱོད་ཀྱི་གདུལ་བྱ་བོད་ན་ཡོད།",
    "ངེས་པར་ཁྱོད་ཀྱི་འཕྲིན་ལས་བོད་དུ་འཇུག།",
    "མ་འདུག་མ་འདུག་ཁ་བ་ཅན་དུ་སོང་།",
    "ཁོག་པ་དུག་གིས་ཁེངས་པའི་འགྲོགས་མ་ཟབ།",
    "བློ་སྣ་ཐུང་གིས་ཐོངས་ལ་རྒྱངས་ཀྱིས་བསྲིངས།",
    "མི་ཁྱོད་ནམ་ཡང་མཐོན་པོའི་རྩེ་ལ་འགྲིམ།",
    "ང་ཁྱོད་ཆགས་སྡང་འཆིང་བའི་དགྲ་མ་འཚོལ།",
    "མོ་བོན་རྩིས་དང་ཟོག་གི་ཐབས་མ་མཁས།",
    "ཁྱོད་ཀྱི་གདུལ་བྱ་ཁ་བ་ཅན་ན་ཡོད།"
  ]
