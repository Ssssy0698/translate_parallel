    "རུས་གོང་གི་འདུ་ཤེས་དང་།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "འཇིག་རྟེན་ནི་ཡོན་ཏན་ལ་དགའ་བ་ཡིན་པས་རེ་ཤིག་རང་གི་བུ་དག་ལས་ཀྱང་ཕྲོགས་ཏེ།",
    "མཐོང་ནས་ཀྱང་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་ལ་མཉེས་གཤིན་པས་བཤེས་པ་དང་བཅས་པ་ཉིད་ཀྱིས་ཚིག་གིས་བསུ་ནས་ལྷུང་བཟེད་དང་།",
    "ཚེ་དང་ལྡན་པ་དག་ཇི་ལྟར་སྤོང་བྱེད་ཀྱི་གྲོང་དུ་བདེ་བ་ལ་རེག་པར་དབྱར་གནས་པར་ཁས་བླངས་སམ།",
    "ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་བདག་ཅག་སྤོང་བྱེད་ཀྱི་གྲོང་དུ་ཏེ་པོར་བདེ་བ་ལ་རེག་པར་དབྱར་གནས་པར་ཁས་བླངས་མོད་ཀྱི་བདག་ཅག་བསོད་སྙོམས་ཀྱིས་ངལ་བར་གྱུར་ཏེ།",
    "དགེ་སློང་གང་དག་ཉ་པའི་གྲོང་གི་ཉེན་ཀོར་དུ་དབྱར་གནས་པར་ཁས་བླངས་པ་དེ་དག་ཀྱང་དབྱར་གྱི་ཟླ་བ་གསུམ་པོ་དག་འདས་ནས།",
    "མཐོང་ནས་ཀྱང་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་ལ་མཉེས་གཤིན་པས་བཤེས་པ་དང་བཅས་པ་ཉིད་ཀྱི་ཚིག་གིས་བསུ་ནས་ལྷུང་བཟེད་དང་།",
    "ཚེ་དང་ལྡན་པ་དག་ཇི་ལྟར་ཉ་པའི་གྲོང་དུ་བདེ་བ་ལ་རེག་པར་དབྱར་གནས་པར་ཁས་བླངས་སམ།",
    "ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་བདག་ཅག་ཉ་པའི་གྲོང་དུ་ཏེ་པོར་བདེ་བ་ལ་རེག་པར་དབྱར་གནས་པར་ཁས་བླངས་སོ།",
    "བྱ་བར་སེམས་དཔའ་དཀའ་ན་སློངས་མོ་པ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་པ་བྱུང་ན་འདིར་ཚེ་དང་ལྡན་པ་ཁྱེད་ཅག་བསོད་སྙོམས་ཀྱིས་བྲེལ་བ་མེད་པར་གྱུར་པའི་རྒྱུ་ནི་གང་ཡིན་རྐྱེན་ནི་གང་ཡིན།",
    "ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་བདག་ཅག་ཉེ་དུ་རྣམས་ཀྱིས་མདུན་དུ་གཅིག་གིས་གཅིག་གི་ཡོན་ཏན་བསྒྲག་པ་བྱས་ཏེ།",
    "རུས་གོང་གི་འདུ་ཤེས་དང་།",
    "དགེ་སློང་འདི་ནི་གཉི་གའི་ཆ་ལས་རྣམ་པར་གྲོལ་བ་ཡིན་ནོ་ཞེས་གཅིག་གིས་གཅིག་གི་ཡོན་ཏན་བསྒྲག་པར་བྱས་སོ།",
    "འདི་ལྟར་བདག་ཅག་གིས་སྨྲས་སོ།",
    "འཁོར་སྟོང་དང་ལྡན་པ་དེ་བརྒྱ་འམ་སྟོང་གི་མདུན་དུ་སོང་སྟེ།",
    "སྟོང་གི་མདུན་དུ་སོང་སྟེ།",
    "ཡུལ་འཇོམས་པར་མི་བྱེད་མོད་ཀྱི།",
    "སྟོང་གི་མདུན་དུ་སོང་སྟེ།",
    "བརྒྱ་འམ་སྟོང་གི་མདུན་དུ་སོང་སྟེ།",
    "རེག་པར་སྤྱོད་པ་མེད་ལ་མེད་བཞིན་དུ་འདི་ཤེས་སོ།",
    "འདི་སྐད་ཅེས་ཚེ་དང་ལྡན་པ་དག་བདག་གིས་ནི་མི་ཤེས་པར་ཤེས་སོ་ཞེས་སྨྲས།",
    "གནོད་སེམས་དག་དེ་དག་གི་རྒྱུད་ལ་ཀུན་དུ་མི་འབྱུང་ནས་དེའི་འོག་ཏུ་དེ་དག་གིས་གཅིག་ལ་གཅིག་ཚེ་དང་ལྡན་པ་དག་ཤེས་པར་གྱིས་ཤིག།",
    "དེར་དེ་དག་ཡང་དང་ཡང་དུ་བུད་མེད་ཀྱི་ཡུལ་མཐོང་ཞིང་ཀུན་དགའ་ར་བའི་དགེ་ཚུལ་རྣམས་དང་།",
    "ལྷན་ཅིག་འདྲེ་ཞིང་གནས་པ་དག་ལ་ཡང་ཉོན་མོངས་པ་དག་བྱུང་བར་གྱུར་ཏེ།",
    "རེག་པར་སྤྱོད་པ་མེད་ལ་མེད་བཞིན་དུ་འདི་ཤེས་སོ།",
    "འདི་སྐད་ཅེས་ཚེ་དང་ལྡན་པ་དག་བདག་གིས་ནི་མི་ཤེས་པར་ཤེས་སོ་ཞེས་སྨྲས།",
    "བདག་ཅག་གིས་གཅིག་ལ་གཅིག་ཚེ་དང་ལྡན་པ་དག་ཤེས་པར་གྱིས་ཤིག།",
    "དེར་བདག་ཅག་ཡང་དང་ཡང་དུ་བུད་མེད་ཀྱི་ཡུལ་མཐོང་ཞིང་།",
    "ཀུན་དགའ་ར་བའི་དགེ་ཚུལ་རྣམས་དང་ལྷན་ཅིག་འདྲེ་ཞིང་གནས་པ་དག་ལ་ཡང་ཉོན་མོངས་པ་དག་བྱུང་བར་གྱུར་ཏེ།",
    "དེ་དག་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "རེག་པར་སྤྱོད་པ་མེད་པས་མེད་བཞིན་དུ་འདི་ཤེས་སོ།",
    "བདག་ཅག་གིས་གཅིག་ལ་གཅིག་ཚེ་དང་ལྡན་པ་དག་ཤེས་པར་གྱིས་ཤིག།",
    "དེར་བདག་ཅག་ཡང་དང་ཡང་དུ་བུད་མེད་ཀྱི་ཡུལ་མཐོང་ཞིང་ཀུན་དགའ་ར་བའི་དགེ་ཚུལ་རྣམས་དང་།",
    "ལྷན་ཅིག་འདྲེ་ཞིང་གནས་པ་དག་ལ་ཡང་ཉོན་མོངས་པ་དག་བྱུང་བར་གྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་།",
    "རེག་པར་སྤྱོད་པ་མེད་ལ་མེད་བཞིན་དུ་འདི་ཤེས་སོ།",
    "མ་དྲིས་ཀྱང་རུང་འདི་སྐད་ཅེས་ཚེ་དང་ལྡན་པ་དག་བདག་གིས་ནི་མི་ཤེས་པར་ཤེས་སོ་ཞེས་སྨྲས།",
    "འདི་དག་གིས་གཅིག་ལ་གཅིག་ཚེ་དང་ལྡན་པ་དག་ཤེས་པར་གྱིས་ཤིག།",
    "དེར་འདི་དག་ཡང་དང་ཡང་དུ་བུད་མེད་ཀྱི་ཡུལ་མཐོང་ཞིང་ཀུན་དགའ་ར་བ་པའི་དགེ་ཚུལ་རྣམས་དང་ལྷན་ཅིག་འདྲེ་ཞིང་གནས་པ་དག་ལ་ཡང་ཉོན་མོངས་པ་དག་བྱུང་བར་གྱུར་ཏེ།",
    "རེག་པར་སྤྱོད་པ་མེད་ལ་མེད་བཞིན་དུ་འདི་ཤེས་སོ།",
    "འདི་སྐད་ཅེས་ཚེ་དང་ལྡན་པ་དག་བདག་གིས་ནི་མི་ཤེས་པར་ཤེས་སོ་ཞེས་སྨྲས།",
    "བྱེ་བྲག་ཐོབ་པ་ཞེས་བྱ་བ་ལ་བྱེ་བྲག་ཐོབ་པ་ནི་དགེ་སྦྱོང་གི་ཚུལ་གྱི་འབྲས་བུ་བཞི་པོ་དག་སྟེ།",
    "རེག་པར་སྤྱོད་པ་ཞེས་བྱ་བ་ལ་རེག་པར་སྤྱོད་པ་ནི་བསམ་གཏན་བཞི་པོ་དག་སྟེ།",
    "ལྷ་རྣམས་ཀྱིས་ཀྱང་བདག་གི་སྒྲ་ཐོས་སོ།",
    "རྡུལ་ཁྲོད་ཀྱི་ཤ་ཟ་རྣམས་ཀྱིས་ཀྱང་བདག་གི་སྒྲ་ཐོས་སོ།",
    "མ་ཐོབ་བཞིན་དུ་བདག་གིས་མི་རྟག་པའི་འདུ་ཤེས་དང་།",
    "རུས་གོང་གི་འདུ་ཤེས་དང་།",
    "མ་ཐོབ་བཞིན་དུ་བདག་གིས་བསམ་གཏན་དང་པོ་དང་།",
    "དྲིས་ཀྱང་རུང་ཞེས་བྱ་བ་ནི་གཞན་དག་གིས་སོ།",
    "འདི་སྐད་ཅེས་ཚེ་དང་ལྡན་པ་དག་བདག་གིས་ནི་མི་ཤེས་པར་ཤེས་སོ།",
    "ཞེས་བྱ་བ་ནི་མིག་གི་རྣམ་པར་ཤེས་པས་སོ།",
    "དགེ་སློང་ཞེས་བྱ་བ་ནི་གང་ལ་དགེ་སློང་གི་དངོས་པོ་ཡོད་པ་སྟེ།",
    "གནས་པར་མི་བྱའོ་ཞེས་བྱ་བ་ཡང་གང་ཟག་བཅུ་གཉིས་པོ་དག་གི་བསྐོ་བར་མི་བྱའོ་ཞེས་བྱ་བའི་བར་དུ་སྔ་མ་བཞིན་ཏེ།",
    "རང་གི་མཚན་ཉིད་འཛིན་པ་དང་།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "ལྟ་བ་བསྒྱུར་ཏེ་འདི་སྐད་ཅེས་མ་ཐོབ་བཞིན་དུ་བདག་གིས་མི་རྟག་པའི་འདུ་ཤེས་ཐོབ་བོ་ཞེས་ཟེར་ན་ཕམ་པར་འགྱུར་རོ།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "ལྟ་བ་བསྒྱུར་ཏེ་འདི་སྐད་ཅེས་མ་ཐོབ་བཞིན་དུ་བདག་གིས་བསམ་གཏན་དང་པོ་ཐོབ་བོ་ཞེས་ཟེར་ན་ཕམ་པར་འགྱུར་རོ།",
    "དགྲ་བཅོམ་པ་ཡིན་པ་དེ་ལ་དེ་ན་མི་མ་ཡིན་པ་དག་གིས་འཚེ་བར་མི་བྱེད་ནས།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "གནོད་སེམས་དག་བདག་གི་རྒྱུད་ལ་ཡང་ཀུན་ཏུ་མི་འབྱུང་ངོ་ཞེས་ཟེར་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "དགེ་སློང་གིས་བདག་ཉིད་ལ་ཉེ་བར་སྟོན་པས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "ལྟ་བ་བསྒྱུར་ཏེ་འདི་སྐད་ཅེས་དགེ་སློང་གང་གིས་ལྷ་རྣམས་མཐོང་བ་དེ་ཡོད་དོ་ཞེས་ཟེར་ཞིང་འདི་སྐད་ཅེས་ཁོ་བོ་འོ་ཞེས་ནི་མི་ཟེར་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "ཐ་ན་འདི་སྐད་ཅེས་དགེ་སློང་གང་གིས་རྡུལ་ཁྲོད་ཀྱི་ཤ་ཟ་རྣམས་མཐོང་བ་དེ་ཡོད་དོ་ཞེས་ཟེར་ཞིང་།",
    "དགེ་སློང་གིས་བདག་ཉིད་ལ་ཉེ་བར་སྟོན་པས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "ལྟ་བ་བསྒྱུར་ཏེ་འདི་སྐད་ཅེས་དགེ་སློང་གང་གིས་ལྷ་རྣམས་ཀྱི་སྒྲ་ཐོས་པ་དེ་ཡོད་དོ་ཞེས་ཟེར་ཞིང་།",
    "ཐ་ན་འདི་སྐད་ཅེས་དགེ་སློང་གང་གིས་རྡུལ་ཁྲོད་ཀྱི་ཤ་ཟ་རྣམས་ཀྱི་སྒྲ་ཐོས་པ་དེ་ཡོད་དོ་ཞེས་ཟེར་ཞིང་།",
    "དགེ་སློང་གིས་བདག་ཉིད་ལ་ཉེ་བར་སྟོན་པས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་བདག་ཉིད་ལ་ཉེ་བར་སྟོན་པས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་བདག་ཉིད་ལ་ཉེ་བར་སྟོན་པས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་བདག་ཉིད་ལ་ཉེ་བར་སྟོན་པས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གི་བདག་ཉིད་ལ་ཉེ་བར་སྟོན་པས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "ལྟ་བ་བསྒྱུར་ཏེ་འདི་སྐད་ཅེས་དགེ་སློང་གང་གིས་མི་རྟག་པའི་འདུ་ཤེས་ཐོབ་པ་དེ་ཡོད་དོ་ཞེས་ཟེར་ཞིང་འདི་སྐད་ཅེས་ཁོ་བོའོ་ཞེས་ནི་མི་ཟེར་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "མི་རྟག་པའི་འདུ་ཤེས་ཇི་ལྟ་བ་དེ་བཞིན་དུ་གང་གིས་སྔ་མ་བཞིན་དུ་སྟོང་པ་ཉིད་དུ་སོ་སོར་རྟོག་པའི་འདུ་ཤེས་ཀྱི་བར་དུ་ཐོབ་པ་དེ་ཡོད་དོ་ཞེས་ཟེར་ཞིང་།",
    "དགེ་སློང་གིས་བདག་ཉིད་ལ་ཉེ་བར་སྟོན་པས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "ལྟ་བ་བསྒྱུར་ཏེ་འདི་སྐད་ཅེས་དགེ་སློང་གང་གིས་བསམ་གཏན་དང་པོ་ཐོབ་པ་དེ་ཡོད་དོ་ཞེས་ཟེར་ཞིང་།",
    "བསམ་གཏན་དང་པོ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་གང་གིས་སྔ་མ་བཞིན་དུ་གཉིས་པ་དང་།",
    "དགྲ་བཅོམ་པ་ཡིན་པ་དེ་ལ་དེ་ན་མི་མ་ཡིན་པ་དག་གིས་འཚེ་བར་མི་བྱེད་ནས་དགེ་སློང་གིས་བདག་ཉིད་ལ་ཉེ་བར་སྟོན་པས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དགེ་སློང་གིས་བདག་ཉིད་ལ་ཉེ་བར་སྟོན་པས་འདུ་ཤེས་བསྒྱུར་ཅིང་བཟོད་པ་དང་།",
    "དེ་ནས་ལུས་འཕགས་མའི་བུ་མ་ག་དྷར་བྱུང་བའི་རྒྱལ་པོ་མ་སྐྱེས་དགྲས་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་པ་གླང་པོ་ཆེ་པའི་ཚོགས་དང་།",
    "དཔུང་བུ་ཆུང་གི་ཚོགས་གོ་བསྐོན་ཏེ།",
    "ཡུལ་སྤོང་བྱེད་ན་གནས་པའི་སྐྱེ་བོའི་ཚོགས་ཀྱིས་ཡངས་པ་ཅན་གྱི་ལིད་ཙ་བི་རྣམས་ལ་ཤེས་ལྡན་དག་ལུས་འཕགས་མའི་བུ་མ་ག་དྷར་བྱུང་བའི་རྒྱལ་པོ་མ་སྐྱེས་དགྲས་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་པོ་གླང་པོ་ཆེ་བའི་ཚོགས་དང་།",
    "དཔུང་བུ་ཆུང་གི་ཚོགས་གོ་བསྐོན་ཏེ་ཡུལ་སྤོང་བྱེད་འཇོམས་པར་བྱེད་དོ་ཞེས་ར་མདའ་བ་བཟློག་གོ།",
    "ཡངས་པ་ཅན་གྱི་ལིད་ཙ་བི་རྣམས་ཀྱིས་ཐོས་ནས་དེ་དག་གིས་ཀྱང་དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་པ་གླང་པོ་ཆེ་པའི་ཚོགས་དང་།",
    "དཔུང་བུ་ཆུང་གི་ཚོགས་གོ་བསྐོན་ཏེ།",
    "ཡངས་པ་ཅན་གྱི་ལིད་ཙ་བི་རྣམས་ཀྱིས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ཐག་རིང་པོ་ཁོ་ན་ནས་མཐོང་ངོ།",
    "རྣམ་པར་མི་ཤེས་པ་ཅུང་ཟད་ཀྱང་མེད་དོ་ཞེས་གྲག་གིས་བདག་ཅག་གིས་འདི་ལ་བདག་ཅག་གང་རྒྱལ་བར་འགྱུར་བ་དྲི་བར་བྱའོ་སྙམ་ནས།",
    "དེ་དག་གིས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ལ་དྲིས་པ།",
    "མོད་གལ་གྱི་བུ་ཆེན་པོས་སྨྲས་པ།",
    "དེ་དག་འཕགས་པ་མོད་གལ་གྱི་བུ་ཆེན་པོས་བདག་ཅག་རྒྱལ་བར་ལུང་བསྟན་ཏོ་ཞེས་རངས་པ་དང་།",
    "ཡངས་པ་ཅན་གྱི་ལིད་ཙ་བི་འདི་དག་ནི་གདུག་ཅིང་རྣམ་པར་གནོན་པ་ཡིན་པས་གལ་ཏེ་བདག་གང་གཱའི་ནང་དུ་ཞུགས་ན་ཡང་འདི་དག་གིས་རྒྱ་མོ་འམ་མཆིལ་པས་དབྱུང་བས་འབྱིན་པར་བྱེད་ཅིང་ཚུལ་མ་ཡིན་པས་སྡུག་བསྔལ་བར་འགྱུར་བའི་གནས་ཡོད་ཀྱིས་བདག་མངོན་དུ་ཕྱོགས་ཏེ་ཤི་བ་ནི་ལེགས་སོ་སྙམ་དུ་རིག་ནས།",
    "ལུས་འཕགས་མའི་བུ་མ་ག་དྷར་བྱུང་བའི་རྒྱལ་པོ་མ་སྐྱེས་དགྲ་གཡུལ་ལས་རྣམ་པར་རྒྱལ་ཞིང་ཡུལ་སྤོང་བྱེད་བཅོམ་ནས་རྒྱལ་པོའི་ཁབ་ཏུ་སོང་ངོ།",
