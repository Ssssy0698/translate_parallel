    "སྐབས་བསམ་བློར་ཐོན་སྐྱེད་ཀྱི་རྒྱུ་ཆ་བྲལ་སོང་།",
    "དེ་བས་རྒྱུན་དུ་དཔེ་ཀློག་གི་གོམས་སྟབས་ཀྱིས་ཁ་ཡོད་ལག་ཡོད་ཀྱིས་ཕན་ཐོགས་གཤིས་འཇགས་རྒྱུར་བརྩོན་ཏེ་ནང་སེམས་དང་དགེ་མཚན་ཆེན་པོ་ཡོད་པ་མྱོང་བས་གྲུབ།",
    "དག་གི་རིགས་གལ་ཆེན་དུ་ངོས་འཛིན་དགོས་འདི་ལྟར་བསམ་བློ་བཏང་ན།",
    "ངས་རྟབ་རྟབ་པོར་རླབས་ཆེན་གྱི་ལ་འཆག་པའི་སྐབས་ནི་ཐེངས་གཅིག་གཉིས་བསམ་བློ་བ་ཞིག་གི་སྐད་ཆ་དྲན་སོང་།",
    "ང་བརྒྱུད་མྱོང་བའི་སློབ་གླིང་གི་ལོ་ངོ་བཅས་འདི་དག་གིས་ཁོང་གི་མི་ཚེ་དོན་དང་དྲུག་པོ་དེ་ལད་བཟློས་རིང་ལུགས་ཀྱི་ལམ་བུར་ལྡན་པར་བྱས་སོང་ཟེར།",
    "སྤྱི་སེམས་པར་མིག་ཆུ་དང་སྨྲེང་སེམས་ཀྱི་ན་ཡོངས་ཀྱི་གནས་ཚུལ་རེ་ཟུང་ལ་ཕྱིར་མིག་དང་བུན་འཐིབས་པ་ཧ་ཅང་ལྕི་བ་ཚོར་བྱུང་།",
    "ངུ་ངག་གིས་དེད་སྟབས་བསྒྱུར་བའི་དབུ་ཁྱུད་བྲིས།",
    "རང་ཉིད་ཐེ་བའི་དུ་རང་ཉིད་ཀྱིས་ཅི་ཞིག་སྒྲུབ་རྩིས་ཀྱི་ཕུགས་སློབ་གྲོགས་མི་ཉུང་བའི་མིག་མཐའ་མཆི་མས་འདུན་དེ་ཡང་སྔར་བཞིན་རབ་རིབ་མོག་མོག་ཁེངས་ནས་སེམས་རྩ་སྡུག་ལ་སྦྱར་བ་སྨྲས་ཅིག་ལས་ཅི་ཡང་མེད།",
    "ལོ་མཇུག་གི་ལྷན་འཛོམས་དང་གླེང་མོལ་བྱུང་ངོ་དེ་དག་གི་རིང་ངའི་ཕྱི་ཚུལ་གྱི་སློབ་སྦྱོང་གི་ཞིང་།",
    "བདག་གིས་རྒྱུན་དུ་གླེང་འདོད་པ་དོན་ཅི་ཞིག་ཡིན་པ་མ་ཤེས།",
    "ངའི་འཆར་སྣང་ནི་ང་ཚོས་གོ་སྐབས་མི་རྙེད་པར་ཞེད་སྣང་སྐྱེ་ལ་ཕལ་ཆེར་རང་ཉིད་འགྲོ་སའི་ས་ཆ་གཞན་མི་དགོས་པར།",
    "ལོ་ངོ་དྲུག་གི་རྩ་དུ་འདུས་པ་ཞིག་ཡིན།",
    "ང་ལ་ད་དུང་གོ་བ་རྙེད་མ་སོང་།",
    "དོན་དངོས་ཁ་གྱེས་ནས་ལོ་ངོ་བཅུ་བཞི་ལྷག་འགོར་བའི་སུའང་ཁྲ་ཆུང་མིག་གི་མཐོང་སྣང་ཆེ་རུ་ཕྱེས་འདས་དོན་ལ་ཕྱིར་མིག་བལྟས་ན།",
    "མ་ཡུམ་སློབ་གླིང་གི་ཁོག་ལྷུག་རྩོམ་གཅེས་བཏུས།",
    "ཕྱི་ནང་གི་འགལ་རྐྱེན་དེ་དག་བསམ།",
    "མ་ཡུམ་སློབ་གླིང་གི་སློབ་དཔོན་རྣམ་པའི་ན་ཉེས་པ་མེད།",
    "བོད་རང་གི་གནའ་བོའི་སྲོལ་རྒྱུན་རིག་ཡི་ཚད་ཀྱང་ཇི་ཙམ་མི་ཤེས་པས།",
    "རང་གི་འདོད་གཞིར་བཞག་ནས་སྙིགས་དོར་བཅུད་ལེན་སྒོས།",
    "དེ་ཇི་ལྟར་རེད་ཅེ་ན།",
    "ཁང་གི་ཉིས་ཐོག་ཀླད་ལ་ཞོག་ཟེར།",
    "ཕྱི་དྲོ་དེར་ང་ཚོའི་རྩོད་པར་འབད།",
    "ཕྱི་ཉིན་སྔར་བཞིན་འབྲི་དེབ་དང་སྣུམ་སྨྱུག་ལག་ཏུ་བཟུང་སྟེ་ཉིས་ཞོགས་པའི་རང་སྦྱོང་ཡོད་པ་དང་སློབ་ཐུན་དང་ཐོག་ཀླད་ལ་སོང་ནས་བྲིས་པ་ཡིན།",
    "ཁང་གི་ཕྱོགས་སུ་བསྒྱུར་རོ།",
    "ཁོང་ཅག་གི་ཐུགས་འཁུར་འདུ་ཤེས་ཟབ་མོ་ཞིག་རྙེད་བྱུང་།",
    "དོན་དམ་པར་དགེ་ཏུ་གྱུར་འགྲོ་བ་བློའི་ཡུལ་དུའང་དྲན་མ་མྱོང་རྒན་ཟེར་བ་དེ་ཅི་འདྲ་ཞིག་ཡིན་འོས་པའི་ཐད་མོད།",
    "སོང་སྙམ་དུ་ང་རྒྱལ་ཞིག་དང་སྤྲོ་སྣང་ཞིག་ལྡོག་དུ་ཚད་ལས་འདས་པའི་གདེང་འཇོག་དང་བརྩི་མེད་དུ་སྐྱེས་མྱོང་།",
    "སྐུའི་ཉེ་ས་ནས་ཞལ་མཇལ་ཡང་ཡང་ཐོབ་རྒན་འཇིགས་མེད་རྒྱལ་མཚན་མཆོག་གིས་མོད།",
    "ཁོང་གིས་རང་ཉིད་ལྟ་བུ་ཡོད་བཀའ་འདྲི་གནང་བྱུང་།",
    "འོན་ཀྱང་ཁོང་གི་སྐུའི་བསྙུང་གཞི་ཇེ་ཡོད་པས་དེ་དོན་ཁོང་ལ་ཞུས་པ་ཡིན།",
    "དེ་བསམ་ཚུལ་ཡག་པོ་ཞིག་རེད།",
    "ན་སློབ་དཔོན་འཇིགས་མེད་རྒྱལ་མཚན་མཆོག་ཁོང་གིས་དངོས་སུ་ང་ལ་དེ་ལྟར་གསུངས་བྱུང་།",
    "དེ་དག་ཐམས་ཅད་ང་ལ་སྐུ་དྲིན་ཅན་དེར་ཡང་ཁོང་རྣམ་པ་གཉིས་ཀྱིས་ང་རང་རེ་ཤ་སྟག་ཡིན་པ་སྨོས་མ་དགོས་མོད།",
    "ཁོང་གིས་དེ་ལྟ་བུའི་ཞལ་བཞེས་དེ་ནི་སྟོན་ཁ་ཞིག་ལ་ཡིན།",
    "ལའང་བོང་བ་གསེར་གཟིགས་ཀྱི་དཔེ་བཞིན་ཞིག་མི་རྙེད་པས།",
    "ཁྱོད་ཚོའི་མིག་གིས་སྔོན་ཆད་ང་རང་གི་བཤེས་གཉེན་རྣམ་མཐོང་བ་འདི་ལས་ལྷག་པའི་མཐོང་རྒྱུ་གཞན་པས་ང་ཚོར་ཉི་མ་རེ་རེ་བཞིན་དུ་གཏིང་ཟབ་ཞིག་ཡེ་ནས་མེད།",
    "ངེད་ཀྱི་དགེ་གྲོགས་ཕལ་མོ་ཆེ་ཞིག་ཀྱང་དོན་ལ་བཟུང་བའི་ཕུགས་བསམ་ཉི་མ་གཅིག་ལྷག་བསམ་ཆེ་ལ་རང་བཞིན་དྲང་བའི་ན་གཞོན་ལའང་ཉམས་མྱོང་།",
    "དེ་ཡི་འདབ་ཆགས་དག་ཀྱང་སོགས་མང་བོ་ཞིག་གིས་རེ་ལྟོས་མཐོན་པོ་རི་གསེར་དུ་འགྱུར།",
    "ཁོམ་སྐབས་རེ་བཞིན་ངས་འདི་ལྟར་ཅི་ཡང་སྦྱིན་མི་ཐུབ་པ་རྐྱང་བ་ཡིན་ན་ད་བསམ་བློ་བཏང་བ་ཡིན།",
    "འོན་ཀྱང་ཧ་ཅང་འཁྱོངས་དཀའ་བ་ཞིག་ཡིན་པ་དེ་རེད།",
    "གཞུང་གི་མི་སྣ་དག་གིས་ཁོང་མང་བོས་རེ་བ་འཇོག་ས་དེ་འདྲ་ཞིག་མིན་མོད།",
    "སྐུ་ཚེགས་དེ་དག་དྲན་ན་ལྷག་ཏུ་དགེ་འདི་དག་གི་རིང་ལ་དོན་ཆེན་འདི་ཡིན་ཟེར་བ་རྒན་གྱི་སྟེགས་བུ་འདི་ནས་རང་དགར་སྡོད་པ་ཞིག་མི་འགྲུབ་པ་བདེན་ན་ཡང་རང་དོན་ཕྲན་ནི་སེམས་ཁྲལ་ལྕི་མོ་ཞིག་རེད།",
    "བུ་རེ་འཁྱོངས་ཡོད་པར་གདོན་མི་ཟ།",
    "ནམ་ཞིག་འཆི་བདེ་བའི་ས་ཞིག་བཙལ་ནས་མཐར་མ་ཡུམ་སློབ་གླིང་གི་བཤེས་གཉེན་འགྲོ་རྒྱུ་དེ་ཡིན་པས།",
    "དེ་ནས་ངེད་གཉིས་རྔ་ཡུལ་ཀིརྟི་དགོན་ལ་སོང་བ་ཡིན།",
    "ལོ་གཅིག་ནི་མིག་རྡེབ་ཡུན་ཙམ་ལ་འདས་སོང་།",
    "ས་དེའི་ཚོང་ལས་པ་དག་གིས་གོ་སྐབས་དམ་འཛིན་གྱིས་མགྲོན་ཁང་གི་གླ་ཇེ་མཐོར་བཏང་ནས་སྒོར་བཅོ་ལྔ་ཉི་ཤུ་ཅན་གྱི་མགྲོན་ཁང་ཐེབས་ཆགས་དག་ཀྱང་སྒོར་དྲུག་ཅུར་འཕར་འདུག་པས་ས་དེར་གསར་དུ་ཐོན་པའི་ངེད་ཅག་གིས་ཕམ་ཁ་ཁུར་ནས་དེར་མི་འདུག་ཀ་མེད་བྱུང་།",
    "ཚ་རྒན་དག་གི་ཁྲོད་ན་ཞལ་ངོ་སྨུག་ལ་སྐུ་ཤ་ཅུང་སྐམ་ཞིང་དབུ་ལ་སྐྲ་དཀར་ཐར་ཐོར་ཡོད་པ།",
    "ང་རང་གིས་བོད་ཡིག་གི་དྲི་བ་ཁོ་ནར་གཟབ་ནན་གྱིས་ལན་ཅི་ཐེབས་བྱས།",
    "མ་ཀྱང་གསུམ་དང་མཉམ་དུ་མལ་ཁང་གཅིག་ཏུ་ཁེལ་ཞིང་ངེད་ཚོ་རྒྱུད་མགོ་རུ་མཁོ་ཆས་ཙག་ཙིག་རེ་ཉོ་རུ་སོང་ནས་འདུག་ཆས་ལེགས་པོ་ཞིག་བྱས།",
    "དེ་ནས་ལོ་ངོ་གསུམ་གྱིས་སློབ་སྦྱོང་གི་བརྒྱུད་རིམ་ཁྲོད་ནས་བདག་གིས་སྔར་མ་ཤེས་པའི་ཤེས་བྱ་མང་བོ་ཞིག་ཤེས་ཤིང་།",
    "ཡིན་ནའང་ང་ཚོ་ནམ་ཡང་བྱམས་བརྩེའི་སྤྱན་ཟུང་གིས་བོར་མ་མྱོང་བའི་སློབ་གཙོ་དམ་པ།",
    "པཎཎསཱརཱཎྞ་༥བ་ཝཱཎསཱཝཀྐཏཔསྶ་ཟླ་སྨཁཉ་ཙའདིའི་ཞབས་ཞུ་བ་ཞིག་གི་བརྟུལ་ཞུགས་བཟུང་ནས་ཉིན་མཚན་ཀུན་ཏུ་ཁོམ་པ་ཅུང་ཟད་ཀྱང་མེད་པར་རྒྱལ་ཁབ་ཕྱི་ནང་དང་ས་གནས་སོ་སོར་ཕེབས་ཏེ་སྐུ་ཚེ་དེ་སྐུ་ཚེགས་འོ་བརྒྱལ་གྱི་ཀློང་དུ་བསྟིམས་བཞིན་ཡོད་ཅིང་།",
    "ད་དུང་ཁོང་ལ་དྲུང་ཡིག་ཅིག་ཀྱང་མེད་པར་ཁ་ལོ་བ་འཕྲིན་ལས་ཕུན་ཚོགས་དང་ལག་བརྗེས་རེས་ཀྱིས་ལོ་རེར་རླངས་འཁོར་རྐྱང་རྐྱང་སྤྱི་ལེ་ཁྲི་བཅུ་ལ་ཉེ་བ་རེར་རྒྱུག་བཞིན་ཡོད་ཅིང་།",
    "ཁོང་གི་སྐུ་ཚེ་གང་བོ་རྔུལ་ཆུས་སྐྱེལ་བ་ནི་ཁོང་ལ་མཚོན་ན་འོད་སྟོང་འཕྲོ་བའི་ཕུགས་བསམ་ཞིག་ཡིན་ངེས་མོད།",
    "ང་ཚོ་ལ་མཚོན་ན་ཅི་འདྲའི་བློས་མི་ཐོང་བ་ཞིག་རེད།",
    "ད་དུང་ཁོང་གི་གནག་སྣུམ་ཀྱི་དབུ་སྐྲ་དེ་ཉིན་རེ་ལས་ཉིན་རེར་དཀར་སངས་སངས་སུ་འགྱུར་བཞིན་པའི་སྣང་ཚུལ་འདི་ནི་སློབ་བུ་ང་ཚོའི་སེམས་སུ་ཅི་འདྲའི་བཟོད་མི་ཐུབ་པའི་ན་ཟུག་ཅིག་རེད་ཨང་།",
    "ཁོང་གི་མིང་ལ་པད་མ་རྡོ་རྗེ་ཟེར་ཞིང་གྲྭ་ཟེར་བ་ཞིག་ཡོད་ཅིང་།",
    "ཕྱིན་ཆད་འགྲོ་ཐུབ་རྒྱུ་རེད་ཟེར།",
    "ཚེས་ཉེར་དྲུག་ཀྱི་ཐད་ལ་སྐད་ཆ་དྲིས་ན་ཡང་སྐབས་དེར་ཁོང་གི་ཉིན་དེར་ནམ་མཁའ་གཡའ་དག་ཅིང་ཉི་མའི་ལ་རྒྱུས་མངའ་ཆེར་མི་འདུག་པས་རྗེས་སུ་རྩོད་འོད་ཀྱིས་དཀར་ཐིང་ཐིང་དུ་གྱུར་པའི་རི་བོ་དག་གཅོད་བྱས་ཏེ་གནས་ཚུལ་ཆ་ཚང་ཧ་གོ་བ་བྱེད་ལ་མཛེས་སྡུག་གི་གཟི་འོད་གསར་བ་ཞིག་སྣོན་ཡོང་ཟེར།",
    "གཅེན་མོ།",
    "མཚོ་འགྲམ་དུ་ངང་ངུར་ཁང་དུ་ལས་ཀ་གཉེར་མྱོང་བས་ངའི་ཚ་མོ་ལོ་བཅོ་དང་ཁྲུང་ཁྲུང་།",
    "སྐབས་ཏུ་འཇོག་ཐུབ་སོང་ལ་ནམ་རྒྱུན་ཁོང་གིས་ལྟ་སྐྱོང་དེར་ཆར་སྤྲིན་གྱི་ཀློང་ནས་སྦྲང་ཆར་ཟིམ་ཟིམ་བྱེད་རྒྱུར་ཞལ་བཞེས་གནང་བྱུང་བས་དེ་ནས་ང་དུ་བབས་ཏེ་རྩི་ཤིང་དང་མེ་ཏོག་དག་ལ་ཚེ་སྲོག་རང་ནོར་བུའི་གླིང་དུ་བསྐྱོད་པའི་གོམ་སྟབས་ཐོག་གསར་པ་ཞིག་བྱིན་རྗེས་རིམ་བཞིན་གནམ་དྭངས་མ་དེ་སྤོས་པ་ཡིན།",
    "ཏེ་ཉི་མ་ཤར་བ་དང་མཉམ་དུ་ཁ་དོག་སྣ་ལྔ་ལྡན་པའི་དེ་ཡང་སྤྱི་ལོ་༢༡༢ ལོའི་ཟླ་༧ ཚེས་༡༦ འཇའ་ཚོན་ཞིག་འཆར་ཞིང་དེའི་སྣེ་མོ་གཉིས་ནི་རེས་གཟའ་ཟླ་བའི་ཉིན་ཞོགས་པའི་ཆུ་ཚོད་༡༡པས་མཚོའི་གཡས་གཡོན་དུ་ཟུག་བྱུང་།",
    "དུ་གྱུར་སོང་།",
    "སྐབས་དེར་བདག་ལ་ཁ་པར་ཞིག་འབྱོར་དེའི་ཕྱི་ཉིན་རླངས་འཁོར་འབབ་ཚིགས་ཞིང་དེ་ནི་ང་དང་ཕ་ཡུལ་གཅིག་པའི་ཚོང་པ་ཞིག་ནས་རྭ་རྒྱ་ལ་འགྲོ་མཁན་གྱི་རླངས་འཁོར་འཛིན་གི་ཁ་པར་རེད་འདུག་ངའི་གནས་ཚུལ་རྣམས་བྱང་ཞིག་ཉོས་པས་སྒོར་བདུན་ཅུ་དོན་ལྔ་རེད།",
    "དེ་ནས་ཡུད་ཙམ་སོང་རྗེས་ཁོང་ཞིག་ནང་བསྡད་དེ་ལམ་ལ་ཆས།",
    "ང་རང་སྒོའི་འགྲམ་དུ་སོང་རྩྭ་ཐང་དང་།",
    "ད་དུང་སྦྲ་ནག་ཡུན་རིང་བྲལ་བའི་བུ་ཆུང་གིས་ཨ་མ་འཕྲད་པ་གི་འབྲོག་ཁྱིམ་དང་།",
    "ནོར་གནག་གི་ཁྱུ་ཚོགས།",
    "བཞིན་དུ་སེམས་ལ་དགའ་སྐྱོ་འདྲེས་མའི་ཚོར་བ་གཡང་དཀར་གྱི་ལུག་ཁྱུ་སོགས་སྣོད་བཅུད་ཀྱི་ཟབ་མོ་ཞིག་གིས་ཡོངས་སུ་ཁེངས་སོང་།",
    "བུའི་སློབ་གླིང་དུ་སླེབས་སོང་།",
    "མདུན་རི་ནོར་བུའི་རང་གི་ཐོས་བསམ་ཅམ་གྱིས་བཞག་སྟེ་མི་རི་སྤུངས།",
    "ཁོང་གི་གཟིམ་ཁང་མི་གཅིག་ཀྱང་དམིགས་ཡུལ་དང་མདུན་ལམ་དུ་དཔེ་སྒྲོམ་ཞིག་དང་།",
    "གཟིམ་ཁྲི་དང་མདུན་ཅོག་གཅིག་པ་ཡིན་པའི་ཡིད་ཆེས་བརྟན་པོ་རྙེད་སོང་།",
    "ལྷག་བསམ་ཆེ་ཞིང་༢༡༢ ༩༡༦གི་ཉིན་ཐོ་ལས་བཤུས།",
    "ཐུགས་རྒྱུད་བྱམས་བརྩེས་ཕྱུག་པ་ཤ་སྟག་རེད་འདུག་པས།",
    "མ་འོངས་པའི་མདུན་ལམ་ཇི་ལྟར་འཚོལ་དགུན་དུས་བཅས་ནམ་ཡིན་རུང་རེ་བའི་འདུན་པ་དགོས་ཚུལ་སོགས་ཀྱི་བློ་སྒོ་གསར་དུ་འབྱེད་པར་ཉག་གཅིག་ནི་གངས་ལྗོངས་འཇིགས་མེད་ཤེས་བརྟེན།",
    "ཕུགས་བསམ་གྱི་རེ་འབྲས་མཆོག་གིས་ཐུགས་ཀྱི་རེ་བ་ཆུད་ཟོས་སུ་མི་གཏོང་ལེན་སའི་མ་ཡུམ་སློབ་གླིང་ཡིན་ལ།",
    "སྒྲིག་ལམ་གྱི་ཐད་ནས་བློ་འཛིན་སྐྱོར་སྦྱོང་གནམ་གཤིས་དྲོ་གྲང་གི་འགྱུར་ལྡོག་ཇི་ལྟར་བྱུང་དང་།",
    "གི་དུལ་ཞིང་ཞི་བའི་སྤྱོད་པ་དང་།",
    "དེ་དུས་ང་ལ་མཚོན་དཔེ་གསོན་པོ་ཞིག་རྙེད་སོང་བར་མ་ཟད།",
    "མཐོང་དུ་མེད་པའི་དགེ་སློབ་ཡོངས་ཀྱི་བར་སློབ་སྦྱོང་གི་ཆེད་དུ་དཀའ་སྤྱད་སྡུག་ལ་ཀུན་སྤྱོད་ཀྱི་དམ་ཚིག་གཙང་མ་ཞིག་གིས་རུས་བྱེད་ཐུབ་རྒྱུ་ནི་མ་ཡུམ་སློབ་གླིང་འདིའི་ཀུན་ནས་སྦྲེལ་ཡོད་དེ།",
    "དེང་སྐབས་ཀྱི་དགེ་ཆེས་རྩ་བའི་དམ་བཅའ་རེད་ལ།",
    "མིའི་རིགས་དང་ཆུ་ཞིག་ཏུ་གྱུར་སོང་བ་རེད་ལ།",
    "གི་རྔུལ་ཆུ་དང་བསྡོངས་ནས་ལམ་ལ་བསྐྱོད་༢༡༤ ༣ ༢༦ ཉིན་བཙན་པོའི་གདུང་རྒྱུད་པ་ཡིན།",
    "གཟི་བརྗིད་ངང་རབ་བྱུང་བཅུ་བདུན་པའི་ཤིང་ཆུ་སྤྱི་ལོ་༡༩༩༤ལོའི་ཟླ་༡༢པའི་ཚེས་༡༥་ཉིན་མཚུངས་མེད་རིག་པའི་དཔའ་བོ་བཤེས་གཉེན་དམ་པ་འཇིགས་མེད་རྒྱལ་མཚན་མཆོག་གིས་ལེགས་པར་བསྐྲུན་ཡོད་པ་ནི་ཀུན་གྱིས་ཤེས་གསལ་རེད།",
    "ཡིད་ཆེས་དང་རེ་བའི་ཀློང་ནས་མི་ཡུལ་འདིར་ཆེས་ཐོག་མའི་གོམ་པ་དང་བོ་སྤོ་ས་དེའང་ཡིན་ངེས།",
    "འདི་ལྟར་ལོ་ཡི་འཁོར་ལོ་བར་མེད་དུ་བགྲོད་ནས་ཡུན་ཐུང་མི་ཚེ་གཅིག་གི་ཕྱེད་ཀ་ཁད་ཀྱིས་རྫོགས་པའི་དེ་རིང་།",
    "ངས་ཡང་སྐྱར་རང་གིས་བརྒྱུད་མྱོང་བའི་ཀྱག་ཀྱོག་གི་ལམ་ཁར་ཕྱིར་མིག་ཐེངས་གཅིག་འཕེན་དགོས་ཐུག་དེ་ནི་ང་ལ་ཆེས་འོད་ཀྱིས་གང་བའི་ལམ་བཟང་གནང་མཁན་དང་།",
    "འདུན་ལམ་དང་རེ་བའི་ཐེམ་སྐས་སུ་འཇུག་མཁན་དེ་ནི་མ་ཡུམ་སློབ་གླིང་གི་བྱེད་པོ་སློབ་དཔོན་རྣམ་གསུམ་གཙོས་འགྲན་པའི་ཟླ་དང་པསལྷུག་རྩོམ་གཅེས་བཏུས།",
    "དུང་ཞེན་སོགས་ཧ་ཅང་མོད་པས།",
    "བརྗོད་མི་ཚར་བའི་རེ་འབོད་དང་།",
    "སྐབས་དེར་གནས་འདི་ནས་བློ་རིག་གི་སྒོ་མོ་འབྱེད་འདོད་ཡོད་པའི་ཁོ་བོར་མཚོན་ན་སློབ་གླིང་འདིའི་སྒོ་ཆེན་བརྒྱད་སྐབས་སུ།",
    "བཅོས་མིན་གྱི་དགའ་ཚོར་ཞིག་དང་བླ་ན་མེད་པའི་སེམས་ཤུགས་དང་སྤོབས་པ་གསར་བ་ཞིག་ངང་གིས་སྟེར་འོང་།",
    "ཡིད་ཆེས་དང་གདེངས་འཇོག་སོགས་མཐོང་ཐུབ་སོང་སྟེ།",
    "ལམ་སྟོན་པ་བོ་དངོས་སུ་འཛིན་པའི་དད་ཞེན་དང་ཡིད་ཆེས་གཙང་མ་ཞིག་ཡོད་པས་རེད།",
    "ལ་ལས་འདི་ནི་ཧ་ཀྱང་ཐལ་དྲགས་ཏེ་དྲན་གཡོག་ལམ་ལུགས་ཀྱི་རྣམ་པ་ལས་མ་འདས་སོ།",
    "ཞེས་བརྗོད་པ་ཐོས་མོད།",
    "ད་དུང་ཡང་གུས་པའི་རྣམ་འགྱུར་ལ་ལ་ཞིག་ཧ་ཅང་ཐལ་དྲགས་སོང་ཞེས་རྒྱུན་དུ་གསུངས་པ་ནི་ཁོ་བོས་ཀྱང་རྗེས་སུ་ཡང་ཡང་ཐོས།",
    "འདི་ནི་ཕྱི་ཚུལ་གྱི་རྣམ་པ་ཙམ་ཞིག་རེད་མོད།",
    "དེ་ལས་ཀྱང་ཁོང་ཚོའི་སེམས་ཁམས་བདེ་ཐང་དང་།",
    "སྐྱིད་པོ་ཡིན་ལ་སློབ་སྦྱོང་ལ་བརྩོན་འདོད་ཀྱི་བསམ་པ་ནི་བཅོས་མ་མ་ཡིན་པ་ཞིག་རེད།",
    "སྤྲོ་སྣང་སོགས་ནི་ཆེས་ཁྱད་པར་པ་ཞིག་ཡིན་པ་ཤེས་སོང་།",
    "གཞན་དག་གིས་སློབ་གླིང་འདིའི་སྐྱོན་ཆ་སྣ་ཚོགས་ཤིག་བགྲངབཞིན་འདུག་བསམ་བློ་རྙིང་རུལ་ཡིན་པས་སོ།",
    "དེ་ནི་དེ་དག་གི་བསམ་བློ་ཞན་དྲགས་པའམ་ཕྲག་དོག་མོད་དྲགས་པས་ཡིན་ནམ་གང་ལྟར།",
    "སྐབས་དེར་ཅི་ཡང་མ་དྲན་མོད།",
    "བླ་ན་མེད་པའི་རིག་གཞུང་གི་རྒྱ་མཚོ་ལྟ་བུ་ཞིག་མཆིས་པ་ནི།",
    "སློབ་གླིང་འདིའི་མདུན་དུ་འབབ་པའི་རྨ་ཆུ་སྔོན་མོའི་འགྲོས་ལ་འགྲན་བཟོད་པ་ཡིན་དེ།",
    "ཁོ་བོ་ཡང་བདེ་བླག་ངང་སློབ་གླིང་འདིར་ཞུགས་ཐུབ་སོང་།",
    "སློབ་གླིང་གི་ཁ་ཕྱོགས་དང་དམིགས་ཡུལ་སོགས་མཚམས་སྦྱོར་ལྷུག་རྩོམ་གཅེས་བཏུས།",
    "དེ་ནི་མི་རིགས་རང་གི་གནས་བབ་དང་མཐུན་ཅིང་མི་དམངས་ཀྱི་འདོད་བློ་དང་ཡང་མཐུན་པས་སོ།",
    "རང་ཉིད་ལ་རང་གི་ཚོད་ཀྱི་ང་རྒྱལ་ཅུང་ལྷུག་རྩོམ་གཅེས་བཏུས།",
    "འུ་ཅག་གི་སློབ་གླིང་ལ་ཉེན་ཁ་གཏན་ནས་བཟོ་མི་ཉན།",
    "ལ་རྒྱ་འཛིན་ཚུལ་ལ་རིགས་མང་བོ་ཡོད་ཅེས་སོགས་སྐོར་གྱི་བཀའ་སློབ་གནང་སོང་།",
    "སློབ་དཔོན་དམ་པ་ལྡོང་ཡོན་ཏན་རྒྱ་མཚོ་མཆོག་གིས་སློབ་གླིང་འདི་ཡུན་རིང་གནས་དགོས་ཐད་ཀྱི་བཀའ་སློབ་དང་།",
    "དེ་ལས་གནས་འདིའི་བྱེད་པོ་དགེན་འཇིགས་མེད་ཚང་ལ་རྒྱ་གཞུང་གིས་གནོད་པ་མི་འབྱུང་ཆེད་ང་ཚོས་ངེས་པར་དུ་ཆབ་སྲིད་དང་འགལ་བའི་ལས་ཀ་སྤེལ་མི་ཉན།",
    "༡༦ ༢༡༧ ༢ ༣ ཏཏྟ་༣ དབཏྠདུས་དང་རྣམ་པ་ཀུན་ཏུ་མི་ཡུལ་གྱི་བསམ་སྦྱོར་ངན་པ་ཅན་དག་གིས་དམོད་ཚིག་དང་སྡིགས་མཛུབ་ཀེར།"
  ]
}