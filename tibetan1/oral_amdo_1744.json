    "ཨོཾ་བཛྲ་སཏྭ་སྟྭཱཾ་ཨ་བྷི་ཥིཉྩཱ་མི་བཛྲ་ནཱ་མ་ཨ་བྷི་ཥེ་ཀ་ཏ་ཨོཾ་ཆེ་གེ་མོ་བཛྲ་སྟྭཾ་ཞེས་བརྗོད་ཅིང་།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་སེམས་དཔའ་ཉིད་སྐུ་གཟུགས་ལ་སོགས་པའི་ལྷ་ལ་རང་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་མིང་འདོགས་པར་ལྷག་པར་མོས་བཞིན་པས་བརྗོད་པར་བྱའོ།",
    "སྐུ་གཟུགས་ལ་སོགས་པའི་ལྷ་རྡོ་རྗེ་དང་རྡོ་རྗེ་དྲིལ་བུ་དང་བཅས་པའི་ཕྱག་གིས་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱལ་འཁྱུད་པའི་ཚུལ་བྱས་པར་བསྒོམས་ལ།",
    "རང་རང་གི་རིགས་ཀྱི་བདག་པོས་དབུ་ལ་རྒྱས་གདབ་བོ།",
    "ལྷ་མོ་གཞན་རྣམས་ནི་དེ་ཉིད་དུ་ཡེ་ཤེས་སེམས་དཔའི་ངོ་བོ་ཉིད་དུ་བཅུག་ནས།",
    "ཨོཾ་ཧཱུཾ་ཧྲཱི་སྟྭཱཾ་ཞེས་པའི་སྔགས་དག་གིས་སོ།",
    "དེ་ནས་རྡོ་རྗེ་སེམས་དཔའ་དེས་གཏད་པའི་ལྷ་མོ་དང་སྙོམས་པར་ཞུགས་པའི་སྐུ་གཟུགས་ལ་སོགས་པའི་ལྷ་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བའི་རང་བཞིན་དུ་མོས་པར་བྱའོ།",
    "གང་གི་ཕྱིར་ཕྱེད་བཅས་བཞི་བརྒྱ་པ་ལས།",
    "དམ་ཚིག་གི་རྫས་དང་གི་ཝང་ཡང་ཕུལ་ཏེ།",
    "དེའི་རྗེས་ལ་འམ་སྦྱིན་སྲེག་ཡོད་ན་སྦྱིན་སྲེག་གིས་ཚིམ་པར་བྱས་པའི་རྗེས་ལ་ཡོན་བདག་ལ་སོགས་པ་ཞི་བ་ལ་སོགས་པ་ནས།",
    "ཞི་བ་ལ་སོགས་པའི་དོན་དུ་ཡོན་བདག་ལ་སོགས་པ་ལ་གཟིགས་པ་ལྷུར་བྱེད་པའི་ལྷག་པའི་ལྟར་མོས་པར་བྱའོ།",
    "དེའི་རྗེས་སུ་ཐབ་ཁུང་གི་མེ་ལམ་ན་ཇིའི་སྟེང་དུ་གནས་པའི་སྣོད་དུ་དགང་གཟར་དང་བླུགས་གཟར་གྱིས་སམ།",
    "ཤ་ཁ་ར་རྣམས་དང་བསྲེས་པའི་འོ་མ་བླུགས་ལ་རང་གི་བདག་པོའི་སྔགས་འགྱིང་བ་དང་བཅས་པས་ཟློས་ཤིང་འོ་ཐུག་བསྒྲུབ་པར་བྱའོ།",
    "སྦྱིན་སྲེག་གི་ཐབ་ཁུང་མེད་ན་མེ་གཞན་ལའོ།",
    "དེ་ནས་མེ་ཏོག་ལ་སོགས་པ་ཕུལ་ནས་ཐལ་མོ་སྦྱར་ཏེ།",
    "ལྷ་མོ་སྒྱུ་འཕྲུལ་ལྷུམས་ཞུགས་ལྟར།",
    "འཁྱིལ་པའི་སྔགས་ཟློས་ཤིང་སྐུ་གཟུགས་ལ་སོགས་པའི་འོག་དང་བར་དང་སྟེང་གི་ཆ་རྣམས་ལ་ལག་པ་གཡས་པས་རྡོ་རྗེ་སྟེང་དུ་གསོར་བས་ལན་གསུམ་བསྐོར་ནས་བརྟན་པར་བྱ་སྟེ།",
    "རང་བཞིན་འོད་གསལ་མཆོག་གི་མཆོག།",
    "ཞེས་པའི་ཚིགས་སུ་བཅད་པ་དག་གིས་བསྟོད་ནས།",
    "ཡང་ན་སྐུ་གཟུགས་ཀྱི་ལྷ་ཁང་གི་རིགས་གང་ཡིན་ཤེས་པན་རིགས་དེའི་དེ་བཞིན་གཤེགས་པ་གཙོ་བོའི་དཀྱིལ་འཁོར་དུའོ།",
    "ཡང་ན་རང་གི་ལྷག་པའི་ལྷ།",
    "སློབ་དཔོན་རང་གི་གང་ཡིན་པ།",
    "རང་གི་ལྷག་པའི་ལྷ་ནི་སྐུ་དེའི་རིགས་ཀྱི་བདག་པོ་དེ་བཞིན་གཤེགས་པ་སྟེ།",
    "སྐད་ཅིག་གིས་དེ་དང་དེའི་དམ་ཚིག་སེམས་དཔའ་སྤྱན་དང་།",
    "གང་གི་ཚེ་དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་ལ་བཀུར་སྟིའི་ཁྱད་པར་བྱ་བར་འདོད་ན།",
    "གྲུབ་པ་ན་གྲོ་གར་གུར་གུམ་དང་གི་ཝང་དག་གིས།",
    "ན་མོ་བྷག་བ་ཏེ་ཤཱཀྱ་མུ་ན་ཡེ་ཏ་ཐཱ་ག་ཏཱ་ཡ།",
    "ཨརྷ་ཏེ་སམྱ་ཀྶཾ་བུད་ྡྷཱ་ཡ།",
    "རིག་པ་རབ་ཏུ་གནས་པ་ལ་ནི་སློབ་དཔོན་རྡོ་རྗེ་འཆང་གི་གཟུགས་སུའམ་རིག་པའི་བདག་པོའི་གཟུགས་སུ་བྱ་སྟེ།",
    "བསྒྲུབ་བྱ་ནི་རང་གི་མིང་ལ་བཅུག་ནས་རིག་པ་སྤྱི་བོའི་བུ་གནས།",
    "སློབ་དཔོན་རྡོ་རྗེ་འཆང་གི་གཟུགས་སུ་རང་གི་ལག་པ་གཡས་པའི་སོར་མོ་རྣམས་རྡོ་རྗེ་རྩེ་ལྔ་པའི་ངོ་བོར་སྐད་ཅིག་གིས་བསྒོམས་པ་ལ་ཡི་གེ་ཨཱ་ལས་སྐྱེས་པའི་ཉི་མ་ཨཱ་ས་བྱིན་གྱིས་བརླབས་པ་དང་།",
    "ལག་པ་གཡོན་པའི་སོར་མོ་རྣམས་པདྨའི་འདབ་མའི་རྣམ་པར་སྐད་ཅིག་གིས་བསམས་པ་ལ་ཨ་ལས་སྐྱེས་པའི་ཟླ་བ་དེས་བྱིན་གྱིས་བརླབས་པ་བསྒོམས་ནས།",
    "རྫིང་དེར་དབུས་སུ་མཆོད་སྡོང་གི་ཤིང་ཟབས་ལས་ཚད་ཉིས་འགྱུར་རམ།",
    "དེ་ལྟར་སེམས་དཔའ་གཉིས་ཀྱི་བདག་ཉིད་ཅན་ཆུ་ལྷའི་གཟུགས་བརྙན་དང་ལྡན་པའི་རྩེ་མོ་ཅན་བཙུགས་པའི་དྲུང་དུའོ།",
    "མཆོད་སྡོང་གི་ཤིང་དང་བྲལ་བའི་ཆུའི་རྟེན་གྱི་དབུས་སུ་ཡང་ངོ།",
    "དེ་ནས་བདུད་རྩི་ལྔ་དང་འོ་མ་དང་ག་པུ་ར་ལ་སོགས་པ་ཆུ་ལྷ་ལ་སོགས་པ་ལ་གཏོར་ཏེ་དེ་རྣམས་ལ་མེ་ཏོག་ལ་སོགས་པས་མཆོད་ལ་འབྱོར་ན་རྒྱས་པའི་དོན་དུ་སྦྱིན་སྲེག་བྱས་ནས་བ་ལང་གི་ལྕི་བ་བྱུགས་པར་འདུག་སྟེ་དྲི་དཀར་པོས་མཎྜལ་བྱས་ནས།",
    "དེ་ལྟར་རང་གི་མིང་བཅུག་པའི་སྔགས་རྣམས་ཀྱིས་མེ་ཏོག་དཀར་པོས་མཆོད་དེ་ལག་པ་གཡོན་པ་གདེངས་ཀའི་ཚུལ་དུ་ལག་པ་གཡས་པ་བརྐྱང་སྟེ།",
    "བྱིན་གྱིས་བརླབས་པའི་འོ་མའི་གཏོར་མ་རེ་ཁམ་ཕོར་རྣམས་སུ་ཕྱོགས་བརྒྱད་རྣམས་སུ་དབུལ་ལོ།",
    "ཨ་མྲའི་ཚལ་དང་སྐྱེད་མོས་ཚལ་ལ་སོགས་པ་རབ་ཏུ་གནས་པའི་ཆོག་ལ།",
    "ཕྱོགས་སུ་གཏོར་མ་བྱིན་ནས་བདག་ཉིད་རྣམ་པར་སྣང་མཛད་ཀྱིས་ཤིང་གི་གཙོ་བོ་སྟོང་པ་ཉིད་ཀྱི་རྗེས་ལ་རྣམ་པར་སྣང་མཛད་ཀྱི་ངོ་བོར་བསམས་ནས་དེར་རྣམ་པར་སྣང་མཛད་ཀྱི་ཡེ་ཤེས་སེམས་དཔའ་མཆོད་ཡོན་ལ་སོགས་པ་སྔོན་དུ་འགྲོ་བས་བཅུག་ནས།",
    "ཤིང་གི་གཙོ་བོ་དང་དེ་ལ་བྱིན་གྱིས་བརླབ་པའི་ལྷའི་མེ་ཏོག་ལ་སོགས་པས་མཆོད་དེ།",
