    "དེ་ལྟར་དཔྱད་པས་དཔྱོད་བྱེད་ཀྱི་སོ་སོར་རྟོག་པ་ཉིད་ཀྱང་རང་ཞི་ནས་ཆིའི་ངོ་བོར་ཡང་མ་གྲུབ་པའི་མི་རྟོག་པར་གྱུར་པ་ནི་སྐབས་འདིའི་ལྟ་བ་དངོས་གཞི་ཡིན་ཏེ།",
    "འདུག་ཅིང་འདུག་ཅིང་ཡང་གསོལ་བ་གདབ།་",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "འདུག་ནའང་བདག་འདུག་གོ་ཞེས་རབ་ཏུ་ཤེས་སོ།",
    "འབུལ་ཇི་ལྟར་འདུག་དང་འདི་ལྟར་སྣང་སོགས་དལྟའི་རྟོག་དཔྱོད་ཀྱང་ཡིད་ལ་མབྱེད་པར་སེམས་རང་གར་ལྷོད་དེ་ཤིག་ག་བར་འཛེག་བ་ཡིན་ལ་འཛེག་ཚུལ་འདི་ནི་གསང་འདུས་ལས།",
    "དེའི་ཚེ་ཇི་སྲིད་འདོད་ཀྱི་བར་དུ་འདུག་པར་བྱའོ།",
    "སྟོང་བར་འདུག་ན་ཅང་མེད་ཀྱི་སྟོང་པ་བར་སྣང་ལྟ་བུའི་སྟོང་བ་ཇི་ལྟར་འདུག་བརྟག།",
    "འོད་དང་འ་དེ་ག་མེད་པའི་རང་གསལ་དུ་འདུག་ལ་སོགས་པ་སྒོ་དུ་མ་ནས་བརྟགས་ཤིང་དཔྱད།",
    "ངོས་བཟུང་དང་རྣམ་འགྱུར་ཇི་ལྟར་འདུག་གཟུང་འཛིན་གྱིས་བསྡུས་པ་གྱིནང་ཐམས་ཅ་ད་དུ་དཔྱོད་པར་གསུངས་ཤིང་།",
    "མི་ང་ཡང་རང་བཞིན་མེད་པ་ཡིན།",
    "སངས་ན་རྐྱེན་གྱིས་སངས་པ་དང་རང་སངས་ལ་སེང་བ་བརྟག་པ་སྦྱར་ནས་རྣམ་རྟོག་ཕྲ་རགས་གཞན་ཐམས་ཅ་ད་ལའང་ཞིབ་ཅུ་བ་རྟག་ཅིང་དཔྱད།",
    "ཐ་ན་ཚུ་ན་ནམ་གྱྀ་ནང་ངམ་སྟེང་འོག་སོགས་སུ་འདུག་བརྟག།",
    "དེ་ལྟར་འདུག་ན་རང་རྐྱ་ཐུབ་པའི་ངོ་བོ་གཉིས་སོ་སོར་གྲུབ་པ་ག་ག་མ།",
    "དེ་རང་རིག་ཅིང་རང་གསལ་བ་གཉི་ས་ཚོགས་པའི་སེམས་ལ་སེམས་ཀྱིས་དྲིག་ཚུད་པའི་མྱོང་མཛོདཔལ་ལས་དང་པོ་པའི་ལྷག་མཐོང་དུ་འཇོག་པར་སྣང་སྟེ།",
    "དེ་ལྟར་ན་རྣལ་འབྱོར་པའིཉམས་སྣང་ལ་ཅྀ་ཤརཡང་དེ་ཉིད་སོ་སོ་རང་རིག་དང་རང་བཞིན་འོད་གསལ་གྱི་དོན་དུ་གཏན་མི་རུང་སྟེ།",
    "དེ་ཡང་ཉི་མ་དང་ཉི་མའི་འོད་འབྲི་ཙ་ན་ད་ན་དང་ཙན་དན་གྱི་དྲི་ལྟ་བུ་ཡིན།",
    "རང་རིག་ཅིང་རང་གསལ་བ།",
    "ཕྱོགས་སྔ་མ་ལ་སུན་འབྱིན་ཅ་ཡོད་པ་ཁྱེད་རང་ལ་བ་ཟློག་པའི་ཕྱིར་དང་།",
    "མ་བཟུང་མ་བཏང་རང་གཉིད་དུ་ཞོག།",
    "བྱང་རྨུགས་ཀྱིས་རྨོངས་པའམ་འཕྲོ་རྒོད་ཀྱི་རྟོག་པ་རང་མཚན་པས་གཡེངས་ནས་སེམས་ཀྱི་གནས་ཚུལ་ལམ་འདུག་ཚུལ་ལ་བསྒྲིབས་པར་མགྱུར་པའོ།",
    "དེ་ལྟར་ངོ་འཕྲོད་ན་ནི་དགག་སྒྲུབ་གྱི་བློས་མབཅོས་མ་བསླད་པའི་སེམས་ཀྱི་འདུག་ཚུལ་ལམ་གནས་ཚུལ་ཅི་ཡོད་པ་དེ་ཀ་ཐ་མལ་གྱི་ཤེས་པ་ཡིན་ཚུལ་དང་།",
    "སྐྱེ་བོ་ཙ་ནའི་ཤེས་པ་འདི།",
    "ད་ལྟར་ཐ་མལ་གྱི་ཤེས་པ་ད་ཉིད་རང་ངོ་ཤེས་ཤིང་རང་རིག་པའི་དྲན་པས་དོན་ཐོག་ནས་མ་ཡངས་པའི་དྭང་ནས།",
    "དེས་ན་སེ་མས་ཀྱི་རང་བབས་ཅི་འདུག་དེ་ཀ་རང་ངོ་ཤེས་པའི་དྲན་པསསྐྱོངབ་ལས་སྤྲོས་ནས།",
    "རང་ངོ་ཤེས་ཤིང་རང་རིག་པའི་དྲན་པ་དེ་ཉིད་མ་ཡེངས་པས་དེ་དག་ཐམས་ཅད་བཟོ་མ་བཅོས་པར་ལྷུག་པར་སྐྱོང་བ་ཡིན་གྱི།",
    "དེ་སན་གནས་དུ་ན་གནས་ཐོག་འགྱུ་ན་འགྱུ་ཐོག་སྣང་ན་སྣང་ཐོག་དེ་ཀ་རང་ངོ་ཤེས་ཤིང་རང་རིག་པའི་དྲན་པས་སྐྱོང་བ་ལས་གཞན་པའི་བསྒྱུར་བ་གོང་དང་བཟོ་བཅོས་བྱ་མི་དགོས་ཏེ།",
    "རྣམ་རྟོག་སྒྱུ་ཚོགས་སུ་འཆར་ཀྱིན་འདུག་ཀྱང་རུང་།",
    "གཉིས་མེད་ཀྱི་ཡི་ཤས་རང་དུ་འདུག་ཨང་སྙམ་པའི་གོ་བ་བྱུང་ཙ་ན།",
    "རྣམ་རྟོག་སྣཚོགས་དགག་ཏུ་མི་བཏུབ་པར་འཆརབར་འདུགཙ་ནགཉིས་མེད་ཀྱི་ཡེ་ཤེས་ཀྱར་དགག་ཏུ་མི་བཏུབ་པར་འཆར་རོ།",
    "འོན་ཀྱང་རང་སའི་མཉམ་རྗེས་ཙམ་འབྱེད་དུ་རུང་བར་བཞེད་པ་ལས།་",
    "གནས་ན་ལབ་ལོབ་འགྲོ་འདུག་ཀྱང་།",
    "འདིའི་སྐབས་སུའང་གུང་རང་སའི་དྲན་རྒྱུན་གོམས་པལ་བརྟེན་ནས་མཉམ་རྗེས་འདྲེ་བ་ལྟ་བུ་འབྱུང་སྟེ།",
    "རང་བཞིན་བཞག་ཅེས་བ་སེམས་ཀྱི་རང་བཞིན་ནམ་འདུག་ཚུལ་ཇི་ལྟར་ཡོད་པ་དེ་ཀལྟར་མ་བཅོས་པར་འཇུག་པ་སྟེ།",
    "སེ་མས་གློད་ཤེས་ན་སེམས་ཀྱི་འདུག་ཚུལ་དང་བཅོས་མིན་གྱི་བོལསྒྲོ་འདོགས་གཙོད་པའིཐབས་ཤིན་ཏུ་ཟབ་པ་ཞིག་ཡིན་ཏེ།",
    "སེམས་གང་ཤར་ཅི་འདུག་དེ་ཀའི་ཐོག་ཏུ་ཞ་འདོད་ཀྱི་ཡང་མི་བྱ་བར་རང་ལུགས་སུ་ལྷོད་པ་ན།",
    "སེམས་ཀྱི་གནས་ལུགས་སམ་འདུགཟུགས་ཅི་ཡོད་པ་དེ་ཀ་རང་ལུགས་སུ་ཅི་བདེར་འཇོག་པ་སྟེ།",
    "ཉི་ནམཚན་ཐུན་མཚམས་འགྲོ་འདུག་སོགས།",
    "མཉམ་རྗེས་མཚན་ཉིད་པ་མེད་ཀྱང་རང་སའི་མཉམ་རྗེས་ཡོད་པ་ལས།",
    "ངོ་བོ་སྐྱ་འགག་དང་བྲལ་ཞིང་རང་བཞིན་ངོས་བཟུང་མེད་པ།",
    "དེ་ལ་གོམས་ཙ་ན་རང་ལ་ངེས་ཤེས་སྐྱེ་བ་བཞི།",
    "དེ་བཞིན་དུ་ཡིད་ལ་དགའ་མི་དགའི་ཟུག་རྔུ་བསྐྱེད་པའི་རྣམ་རྟོག་རགས་ལ་མངོན་ཚན་ཆེ་བ་ཤར་བའམ་ཆེད་བྲ་ཇགས་དེ་གཉིས་ཀྱི་ངོ་བོལ་ཁྱད་བར་དེ་ལ་སྒྲོ་འདོགས་ཆོད་ན་དེ་དག་དང་སེམས་གནས་དུས་ཀྱི་ངོ་བོ་ལ་ཁྱད་བར་ཅི་འདུག་བལྟར།",
    "དེ་གཉིས་ལ་ཕན་ཚུན་ནམ་ཕྱི་ནང་ལྟ་བུའི་གཉིས་སྣང་འདུག་ན་སྒྲོ་འདོགས་མ་ཆོད་པས་སླར་ཡང་ལེགས་པར་བརྟག་སྟེ།",
    "དེ་ལྟར་སྒྲོ་འདོགས་ཆོད་པ་ན་དེ་བཞིན་དུ་དུས་གསུམ་གྱི་ཤེས་བ་ལཁྱད་བར་ཅི་འདུག་བལྟ་སྟེ།",
    "ད་ལྟའི་མས་ཇི་ལྟ་བུ་འདུག་བལྟས་པས་དུས་གསུམ་གྱི་སེམས་སྐྱེ་འགག་གནས་གསུམ་ལྟ་བུར་མཐོང་ན་སྐབས་དོན་ལ་ཐྲིག་མ་ཚུད་པས་སླར་ཡང་ལེགས་པར་བརྟག་སྟེ།",
    "ཐ་མལ་གྱི་སམས་གང་དུ་འདུག་ཅི་བྱུང་ཅི་ཤར་དེ་ཀ་སྒོམ་གྱི་རང་བཞིན་སྟོང་པའི་རྣམ་འགྱུར།",
    "ཟ་སྣོམ་ཁྱམ་དང་འགྲོ་དང་འདུག་པ་དང་།",
    "གཞན་གྱིས་མ་བཙེར་ཡང་རང་ལས་ཀྱི་མི་བཟོད་པའི་སྡུག་བསྔལ་ཅི་རིགས་ཀྱིས་ཟིན་ནས་སྡུག་བསྔལ་པར་གྱུར་བ་མཐོང་བའམ།",
    "ཁྱེད་རང་ལྟར་ན་རྙོག་པ་གསལ་མི་གསལ་གྱི་ཁྱད་པར་དེ་ཀགོ་རྟོགས་ཀྱི་ཁྱད་པར་དུ་འགྱུར་དགོས་པས་གོང་དུ་སྨྲ་བ་དང་འགལ་བར་འགྱུར་བའི་ཕྱིར་དང་།",
    "སྔར་གྱི་ཉམས་དང་མྱོང་བའི་དྲི་མཐམས་ཅད་ངག་ནས་ལམ་གྱི་རྟོགས་པ་དང་རང་བཞིན་གྱི་གནས་ལུས་འདྲེས་ཏེ་མཉམ་རྗེས་དང་དྲན་ཡེངས་མེད་པ་ཞིག་སྟེ།",
