    "ཟུང་དུ་འབྲེལ་བར་ཤེས་པར་བྱ།",
    "དེ་གཉིས་གཅིག་ཏུ་བསྡུས་ནས་ཞི་གནས་ལྷག་མཐོང་མགོ་མཉམ་དུ་འབྲེལ་ཏེ་དམིགས་པར་བྱེད་པའི་ལམ་དེ་ནི་ཞི་གནས་དང་ལྷག་མཐོང་ཟུང་དུ་འབྲེལ་བའི་ལམ་དུ་ཤེས་པར་བྱ་སྟེ།",
    "ལྷག་མཐོང་མཚན་མ་ཡིད་ལ་བྱེད་པས་སེམས་གཟུང་ཞིང་གཟེངས་བསྟོད་པར་བྱ་སྟེ།",
    "སྔོན་མཐོང་བ་དང་ཐོས་པ་ལ་སོགས་པ་དྲན་ནས་ཕྱིའི་ཡུལ་ལ་སེམས་འཕྲོས་པར་གྱུར་ན་ཞི་གནས་ཀྱི་མཚན་མ་ཡིད་ལ་བྱེད་པས་རྒོད་པ་ཞི་བར་བྱ་སྟེ།",
    "དམིགས་པར་བྱ་བའི་ཡུལ་ལ་ཞུམ་རྒོད་མེད་པར་གྱུར་ནས་སེམས་མཉམ་པ་ཉིད་དུ་གྱུར་ན་མི་བསྐྱོད་པར་བཏང་སྙོམས་སུ་བཞག་སྟེ།",
    "གལ་ཏེ་འགའ་ཞིག་ཡིད་ལ་བྱས་པ་ན།",
    "མཉམ་པ་ཉིད་ཀྱི་སེམས་ལས་ཉམས་པར་འགྱུར་ཏེ།",
    "རྟག་ཏུ་དང་ནི་གུས་པ་བྱསི་། ཐམས་ཅད་དང་ཡང་སྦྱར་བར་བྱ།",
    "ལེ་ལོ་དང་བཏང་ིསྙོམས་ལས་ཡིད་ལ་བྱེད་པར་ནན་ཏན་དང་བསྒྲིམས་ཏེ་ཡིད་ལ་བྱེད་པ་ནི་གུས་པ་ཞེས་བྱ་སྟེ།",
    "གུས་པར་ཡིད་ལ་བྱེད་པའི་ཚུལ་གྱིས་ཡིད་ལ་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དང་པོ་རྣལ་འབྱོར་པས་ཏིང་ངེ་འཛིན་གྱིས་དམིགས་པར་བྱ་བའི་ཡུལ་ལ་སེམས་རྩེ་གཅིག་ཏུ་བཞག་སྟེ།",
    "ཇི་ལྟར་བཞག་ཅེ་ན་ཏིང་ངེ་འཛིན་གྱིས་དམིགས་པར་བྱ་བའི་ཡུལ་དང་།",
    "ཡང་ནས་ཡང་དུ་རྒྱུན་དུ་སེམས་རྩེ་གཅིག་པར་བཞག་པ་སྟེ།",
    "དེས་ནི་ཡང་དག་པར་གནས་པ་བསྟན་ཏོ།",
    "རྣམ་པར་གཡེང་བ་ཤེས་ནས་ཀྱང་།",
    "དེ་༡༥ ༦༡ནི་ཡུལ་ལ་གཡེངས་པར་གྱུར་ཏོ་ཞེས་ཤེས་པར་བྱས་ནས།",
    "རྩེ་གཅིག་པ་ལ་འཇོག་པར་བྱེད་དེ་དེ་ནི་ཀུན་དུ་གནས་པ་ཞེས་བྱའོ།",
    "སེམས་ནི་ནང་དུ་བླན་པར་བྱ།",
    "སེམས་ཕྱིའི་ཡུལ་ལ་མི་གཏོང་ེཞིང་ཡང་ནས་ཡང་དུ་སེམས་ནང་དུ་བློན་པར་བྱེད་དེ་ཏིང་ངེ་འཛིན་རྩེ་གཅིག་པ་ལ་སེམས་ཡང་ནས་ཡང་དུ་སེམས་བློན་པར་བྱེད།",
    "གཏོང་བར་བྱེད་འཇོག་པར་བྱེད་དེ་དེ་ནི་ཉེ་བར་གནས་པ་ཞེས་བྱའོ།",
    "དེའི་དུས་ན་དེས་ཏིང་ངེ་འཛིན་གྱི་ཡོན་ཏན་ལ་བརྟག་པར་བྱའོ།",
    "རྣམ་པར་གཡེངས་ལ་སྐྱོན་མཐོང་བས།",
    "གཡེངས་པའི་སེམས་དང་མི་དགའ་བ་སྤང་བའི་ཕྱིར་གཉེན་པོ་ལ་རྟེན་པར་བྱེད་དེ།",
    "དེས་ནི་རྣམ་པར་ཞི་བར་བྱེད་པ་བསྟན་ཏོ།",
    "སེམས་རྒྱུན་དུ་འཇུག་ཅིང་གནས་པར་འགྱུར་ཏེ།",
    "འབད་པ་དང་བཅས་པའི་ཏིང་ངེ་འཛིན་ལ་གོམས་པར་བྱས་པས།",
    "ལྷུན་གྱིས་གྲུབ་པར་གནས་པའི་ཏིང་ངེ་འཛིན་འཐོབ་པར་འགྱུར་ཏེ།",
    "དེ་ནི་མཉམ་པར་འཇོག་པ་ཞེས་བྱའོ།",
    "ཡིད་ལ་བྱེད་པ་ཤེས་པར་བྱ།",
    "ལུས་དང་སེམས་ལས་སུ་རུང་བ་ཤས་ཆུང་ངུ་འཐོབ་པ་དེའི་དུས་ན་རྣལ་འབྱོར་པ་ཡིད་ལ་བྱེད་པ་འཐོབ་པོ་ཞེས་ཤེས་པར་བྱ་བའི་དོན་ཏོ།",
    "ཤས་ཆེན་པོ་འཐོབ་པར་འགྱུར་ཏེ།",
    "ལུས་དང་སེམས་ལས་སུ་རུང་བ་ལ་ཤས་ཆེན་པོ་ཐོབ་པའི་འོག་ཏུ་གཟུགས་ཀྱི་ཁམས་ཀྱི་རྩ་བའི་བསམ་གཏན་བཞི་ཐོབ་པར་འགྱུར་ཏེ།",
    "ཐེ་ཚོམ་གྱི་ཤས་ཆེ་བ་མེད་པར་བྱ་སྟེ།",
    "ཡེ་ཤེས་ཀྱི་ཚོགས་རྫོགས་པར་བྱ་བ་དང་།",
    "ས་དང་པོ་ཐོབ་པར་འགྱུར་བའི་མཚན་མ་ཡོན་ཏན་ལྔ་ཐོབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་དག་པའི་སྣོད་འགྱུར་ཞིང་།",
    "དེ་ནས་བླ་ན་མེད་པར་འགྱུར།",
    "ཡོན་ཏན་རྣམ་པ་ལྔ་ཐོབ་ནས་ཀྱང་རྣམ་པར་དག་པ་སྟེ།",
    "གཞི་བླ་ན་མེད་པར་འགྱུར་ཏེ།",
    "སེམས་ལས་སུ་རུང་ཞིང་སེམས་བདེ་བས་ཀྱང་སེམས་ཀུན་དུ་ཁྱབ་པར་འགྱུར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་དག་པའི་མཚན་མ་ཡང་།",
    "མ་བརྟགས་པར་ནི་རབ་ཏུ་མཐོང་།",
    "རྣམ་པར་དག་པའི་སྒྲས་ནི་ས་དང་པོ་ལ་བྱ་སྟེ།",
    "ས་དང་པོ་འཐོབ་པར་འགྱུར་བའི་མཚན་མ་དང་།",
    "རྟགས་དག་ཀྱང་མ་བརྟགས་མ་བསམས་པར་རྨི་ལམ་དུ་ལུས་ལས་སྲིན་བུ་འཛག་པ་དང་།",
    "མི་གཙང་བས་ལུས་བསྐུས་པ་ལས་ཁྲུས་བྱེད་པ་ལ་སོགས་པ་ལུས་ཀྱི་སྐྱོན་དང་བྲལ་བ་དག་རྨི་ལམ་དུ་མཐོང་བར་འགྱུར་ཏེ།",
    "རྣམ་པར་དག་པའི་རྒྱུ་སྟེ།",
    "དེ་བས་ན་རྣམ་པར་དག་པའི་སྣོད་བླ་ན་མེད་པར་འགྱུར་བ་ཞེས་བྱའོ་། འདི་ནི་ཞི་གནས་དང་ལྷག་མཐོང་གཉི་གའི་ཕྱོགས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ད་འདི་མན་ཆད་ནི་ངེས་པར་འབྱེད་པའི་ཕྱོགས་བཞི་ལ་འཇུག་པ་སྟོན་ཏེ།",
    "ཡིད་ཀྱི་རྣམ་རྟོག་མ་གཏོགས་པར།",
    "སེམས་ཙམ་ལ་ནི་གནས་པར་འགྱུར།",
    "དེའི་ཡུལ་དུ་ཕྱིའི་ཡུལ་ལ་སོགས་པར་སྣང་བ་ཀུན་དང་བྲལ་བའི་སེམས་ཙམ་ལ་གནས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་ལྟར་སེམས་ཙམ་ལ་གནས་པར་འགྱུར་ཞེ་ན།",
    "ཕྱིའི་དངོས་པོར་སྣང་བ་རྣམས་ལ་ཡོད་པར་འཛིན་ཅིང་ཕྱིའི་དངོས་པོ་སེམས་ལ་སྣང་བ་ནི་གཟུང་བའི་གཡེང་བ་ཞེས་བྱ་སྟེ།",
    "ཌསེམས་ལ་ཡོད་པར་འཛིན་པའི་གཡེང་བ་མ་སྤངས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཏིང་འཛིན་མྱུར་དུ་ཐོབ་པར་འགྱུར།",
    "དེ་སྤངས་པའི་དེ་མ་ཐག་པའི་ཏིང་ངེ་འཛིན་མྱུར་དུ་ཐོབ་པར་བྱེད་དེ།",
