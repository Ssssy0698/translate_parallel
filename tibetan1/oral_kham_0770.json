    "ང་རང་གཅིག་པུར་གནས་དུས་ཡིད་དུ་གསལ་ལྷང་ངེར་འཆར་ཡོང་བའི་བྱིས་དུས་ཀྱི་ཕྱིར་དྲན་ནི་ཧ་ཅང་མང་ཞིང་།",
    "དེ་དུས་ཕལ་ཆེར་ང་རང་ལོ་ན་བཅུ་ཡས་མས་ཤིག་ཡིན་སྲིད།",
    "ང་རང་ཉིད་ཀྱིས་ཀྱང་དེ་ལྟར་འདོད་བཞིན་ཡོད།",
    "ང་རང་སྔོན་ཆད་འུར་ཟིང་ལ་དགའ་བ་དེ་གནས་སྐབས་ཙམ་ཡིན་སྲིད་དེ།",
    "ང་རང་ཆར་དུས་སུ་ཀ་ཏ་མན་རྡུར་འབྱོར་བ་དང་།",
    "ང་རང་ཀ་ཏ་མན་རྡུར་གཟའ་འཁོར་གཅིག་ལ་བསྡད།",
    "མདའ་ཁབ་ཀ་ཏ་མན་རྡུའི་དུས་ཚོད་བརྒྱད་པར་ཁེལ་འདུག་ཡིན་ན་ཡང་།",
    "ཁས་ལེན་བྱེད་དཀའ་བའི་ཚད་དུ་འདུག་སྟེ།",
    "ང་རང་ཀ་ཏ་མན་རྡུ་རུ་རིམ་གྱིས་ཇེ་དལ་དུ་གྱུར་ཅིང་།",
    "དེ་ལ་ཕྱི་ར་བརྒྱབ་ཡོད་ཅིང་ནང་དུ་མི་མང་པོ་རྐང་རྩེད་སྤོ་ལོ་རྩེད་ཅིང་ཁ་ཤས་བག་ཡངས་ཀྱི་འགྲོ་བཞིན་འདུག་རྒྱུས་ལོན་ལྟར་ན་དེ་ལ་བོད་ཐང་དུ་འབོད་ཅིང་།",
    "ང་རང་ག་ལེར་བོད་ཐང་དེ་རུ་འཆམ་འཆམ་ལ་བསྐྱོད།",
    "ང་རང་ཀ་ཏ་མན་རྡུ་ནས་པེ་ཅིན་དུ་འཕུར་བའི་གནམ་གྲུར་བསྡད།",
    "ཁྱེད་རང་ད་བར་དུ་རྩོམ་རིག་གསར་རྩོམ་གྱི་ལས་ལ་ཞུགས་ཤིང་།",
    "བྲིས་འདུག་འོན་ཀྱང་།",
    "དོན་དམ་དུ་དོན་དངོས་ཀྱིས་ར་སྤྲོད་པ་ནི་འདི་རིགས་ཏོག་ཙམ་ཏོག་ཙམ་བྲིས་ཚེ་ཀློག་པ་པོ་ལའང་འདྲེན་ཤུགས་ཤིག་འདུག་པས།",
    "དེར་བརྟེན་ལོ་ཙཱ་ལ་ཆེད་ལས་ཀྱི་ལྟ་སྟངས་ཤིག་ངེས་པར་དགོས་ཀྱི་འདུག་ལ།",
    "རྒྱ་ནང་ལ་དེའི་སྐོར་ལ་རྩོད་པ་བྱེད་མཁན་མང་པོ་འདུག་གང་ལྟར།",
    "ང་རང་ཆུང་ངུའི་དུས་ནས་ཕྱི་རྒྱལ་གྱི་རྩོམ་མང་པོར་བལྟས་མྱོང་ཡོད།",
    "ང་རང་ག་དུས་ཡིན་ཡང་སྤྲོ་སྣང་རིང་ལུགས་དེ་འདྲ་མིན་ཏེ།",
    "དེ་ང་རང་ཉིད་ཀྱི་གཤིས་ཀ་དང་འབྲེལ་བ་ཡོད་ཀྱང་སྲིད།",
    "ང་ལའང་འཁྲབ་གཞུང་བྲིས་དང་ཟེར་མཁན་འདུག་ཀྱང་།",
    "ང་རང་ཉིད་ཀྱི་མི་ཚེ་ཕྱེད་ཀའི་མྱོང་བ་ལྟར་ན།",
    "ཁྱེད་རང་ཡུལ་གང་ཞིག་ལ་གནས་སྤོར་རྩིས་ཡོད་དམ།",
    "ངས་ད་དུང་ང་རང་གང་ལ་འགྲོ་དགོས་མིན་ཡིད་ལ་འཁོར་གྱི་མི་འདུག་ཟེར།",
    "ལོག་ཕེབས་ཐེངས་དེ་ཕམ་ཁ་ཐེངས་ཤིག་ཏུ་གྱུར་ཅིང་སྒྲུང་གཏམ་ཡང་མི་སྣ་གཙོ་བོ་གཉིས་ཀ་སྔ་གཞུག་ཏུ་ཅེ་ཁེ་དང་སླར་ཡང་བྲལ་བའི་མཚམས་ནས་མཇུག་རྫོགས་པར་བྱས་འདུག་གང་ལྟར་ཀྱང་།",
    "ཕྱིས་ཀྱི་འཕེལ་ལམ་དུ་སྦྲང་ཆར་གྲུབ་འབྲས་སྡུད་མཁན་ཞིག་ཏུ་འགྱུར་མ་ཐུབ་པར་སྲུང་འཛིན་བྱེད་མཁན་ཞིག་ཏུ་གྱུར་འདུག་སྦྲང་ཆར་གྱིས་གསར་རྩོམ་གྱི་སྨྱུ་གུ་ལག་ནས་འབོར་གྲབས་བྱེད་པའི་རྩོམ་པ་པོ་དེ་དག་བསྲུངས་ནས་ཡོང་།",
    "ལོ་ངོ་མང་པོའི་རྗེས་སུ་ང་རང་སྒྲུང་གཏམ་རྩོམ་པ་པོ་ཞིག་ཏུ་གྱུར།",
    "དང་ཐོག་ཁྱེད་རང་སྒྲུང་གཏམ་གསར་རྩོམ་བྱེད་སྐབས་དཀའ་ངལ་གང་དག་ལ་ཐུག་མྱོང་།",
    "སྒྲུང་རིང་དང་པོ་ཡིན་པའི་ཆ་ནས་ལེགས་འགྲུབ་བྱུང་བའི་ཆ་བལྟོས་བཅས་ཀྱིས་མང་ན་ཡང་ཞན་ཆ་དང་ཕངས་སེམས་ཀྱི་ཆའང་འདུག་ངས་བསམ་ན་དེར་སྐྱོན་མི་འདུག་གང་ལྟར་ངས་སྒྲུང་རིང་འདི་བྲིས་པ་བརྒྱུད་ནས་སྒྲུང་གཏམ་ཞེས་པར་ངོས་འཛིན་སྐྱེ་རྒྱུར་རོགས་རམ་ཆེན་པོ་ཞིག་ཐོབ་བྱུང་།",
    "དེ་མ་ཡིན་པར་ཀློག་པ་པོར་ཤུགས་རྐྱེན་ཐེབས་པའི་སྒྲུང་ཐུང་བྲིས་མ་མྱོང་བའི་མི་ཁ་ཤས་ཀྱིས་སྒྲུང་རིང་ཧ་ལས་པ་ཞིག་འབྲི་ཐུབ་ངེས་ཟེར་ན་ང་ཡིད་ཆེས་ཡོང་དཀའ་བར་འདུགདེ་ལས་གཞན་ད་སྐབས་བོད་ལ་སྒྲུང་རིང་ཤིན་ཏུ་མཁོ་བའི་དུས་ལ་སླེབས་འདུག་དེ་བས་བོད་ཀྱི་རྩོམ་རིག་ལ་མཚན་སྙན་གྲགས་མི་བསམ་པ་དང་ཁེངས་སྐྱུངས་ཅན།",
    "དེར་སྐྱོན་མི་འདུག་ཐོག་མར་ངས་དྲ་ལམ་སོགས་ནས་ཁྱེད་ཀྱིས་ངའི་རྩོམ་ལ་གདེང་འཇོག་གང་མང་བྱས་པ་མཐོང་མྱོང་ལ།",
    "སྤྱིར་འདི་གཉིས་ལ་འགལ་བ་ཡོང་དགོས་དོན་མི་འདུག་རྒྱབ་ལ་ལྟ་བའི་རྨང་གཞིའི་སྟེང་དུ་མདུན་ལ་ཕྱོགས་དགོས་པ་ཞིག་ཡིན།",
    "ལ་བརྟེན་ནས་ང་རང་ཉིད་འདུས་པའི་རྩོམ་པ་པོ་མང་པོ་ཞིག་ལ་གསར་རྩོམ་གྱི་སྒུལ་ཤུགས་ཡོད་པར་གྱུར་ཅིང་།",
    "ངས་དུས་ནམ་ཡང་རང་ལས་རྒན་པའི་རྩོམ་པ་པོ་དག་ལ་གུས་འདུད་ཞུ་བཞིན་ཡོད་ཅིང་།",
    "ངས་ང་རང་ཉིད་ཚུད་པའི་ན་གཞོན་གྱི་གསར་རྩོམ་པ་དག་ལ་ཚད་ཐིག་འདིའི་ངོས་ནས་ནམ་ཡང་གུ་ཡངས་སྟེར་མི་འདོད་དེ།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "རྟག་རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རང་རང་མཚན་ཉིད་ཀྱིས་གནོད་སྙིར།",
    "དེ་ཡང་རང་རིག་ཡིན་པས་ན།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "དེ་ཡུལ་ལ་ནི་འདོད་ཆཊ་ལ་སོགས་པ་ཉིད་བཞིན་དུ་མངོན་སུམ་མ་ཡིན་ཡང་རང་རིག་གོ་ཞེས་བྱ་བའི་སྐྱོན་ནི་མེད་དོ།",
    "རང་རང་རིག་པར་བྱ་བའི་དོན།",
    "རང་རང་མཚན་ཉིད་ཀྱིས་གནོད་ཕྱིར།",
    "སྒྲ་ལ་ཡང་བ་ལང་ལ་སོགས་པ་དང་རང་ལས་བྱེ་བྲག་ཏུ་གྱུར་པ་ནི་མེད་ཀྱང་།",
    "རང་རང་ལ་བརྟེན་པའི་སྤྱི་གསལ་བར་བྱེད་པ་ཡིན་ནོ།",
