    "གསལ་ཕྱིར་ཞེས་པ་དོན་གསལ་བ་ལ་མི་འཆད་པར་སྒྲ་གདངས་གསལ་བར་འདོད་པ་ལྟར་ན་ཡང་དོན་མི་གསལ་བའི་སྐྱོན་སོ་ན་གནས་སོ།",
    "འདི་སྐབས་འགྱུར་སྔ་མ་ཉིད་ལེགས་པར་བཟུང་དགོས་སོ།",
    "རྒྱ་སྐད་ལ་མེད་པ་ཅ་ཆ་ཇ་ཞ་ཟ་འ་རྣམས་ཙ་ཛ་ཤ་ས་ཨ་རྣམས་དང་མཚུངས་པར་གྱུར་པས་ན།",
    "འཕུལ་འཇུག་ཡོད་པའི་མགོ་ལྡན་འདོགས་གཉིས་ཡོད་པ་ལྟ་བུའི་ཡི་གེ་དུ་མ་ཚོགས་པ་སྒྲ་ཆེ་ཞིང་ཤིན་ཏུ་ལྕི་བའམ་རྩུབ་པར་འགྱུར་རོ།",
    "བརྗོད་བྱའི་དོན་འབད་པས་བརྟགས་མི་དགོས་པར་བདེ་གླག་ཏུ་ཤེས་ནུས་པ་ཉིད་དོ།",
    "ཕྱི་མ་གཉིས་ཀས་མི་འདོད་པའི་དཔེར་གསུངས་ཀྱང་ཕྱི་མ་ཤར་པས་འདོད་ཚུལ་ཡིན་ཡང་མི་རུང་བ་མེད་དོ།",
    "དེར་གཞན་ལས་ཁྱད་འཕགས་ལྡན་པའི་ཡོན་ཏན་ཡོད་པར་རྟོགས་ནུས་པའི་ངག་དེ་ནི་རྒྱ་ཆེར་བརྗོད་དེ།",
    "དེའི་དཔེ་གསུངས་པ།",
    "རྒྱལ་པོ་དེ་གཏོང་བ་ཁྱད་འཕགས་ལེགས་པར་མཚོན་ནུས་པའི་ཉམས་ཡོད་པ་ཡིན་ལ།",
    "ལམ་འདི་ཉིད་བརྗོད་ཚུལ་གྱིས་མཚོན་ནས་གཞན་དཔའ་བ་དང་མང་ཐོས་སོགས་ཀྱང་འདི་དང་རིགས་པ་མཚུངས་པས་དཔག་པར་བྱའོ།",
    "རྩེ་དགའི་ཆེད་དུ་བྱས་པའི་མཚོ་ཡིད་དུ་འོང་བ་དང་།",
    "དེ་ཡང་བརྗོད་ཚུལ་ཉམས་དང་ལྡན་པས་ཆེས་མཛེས་པར་འགྱུར་རོ།",
    "དེ་གཉིས་མཉམ་པའི་དཔེ་ཤུགས་ལས་ཤེས་པར་བྱའོ་ཞེས་སྔ་མ་དག་གསུངས།",
    "གཞན་གསུམ་ལྕི་བ་མང་བའི་དཔེ་སྟེ་མཉམ་པ་ཤུགས་ལས་ཤེས་པར་བྱས་ཀྱང་རུང་ངོ།",
    "བརྗིད་དང་ལྡན་པའི་ཚིག་འདི་ལྷུག་པར་མ་ཟད་ཚིགས་བཅད་ལ་ཡང་ཤར་པས་འདི་ལྟར་སྦྱོར་བར་བྱེད་དོ་ཞེས་སྔ་མ་འདི་ཤར་པས་འདོད་པའི་དཔེའོ།",
    "ཚིག་རྣམས་ཚིག་སྡུད་ཅི་རིགས་དང་ལྡན་པ་བརྗིད་པར་འདོད་དེ།",
    "ཚིག་ལྷུག་ལ་ལྷག་པར་ཚིག་སྡུད་དགོས་སོ།",
    "སྤྱིར་ཚིག་གང་ལ་ཡང་དོན་གོ་ངེས་པ་ལས་དགོས་མེད་ཀྱི་ཚིག་ལྷག་རྣམས་དོར་ནས་བརྗོད་ན་བརྗོད་པ་དངོས་གཙང་བ་དང་།",
    "དགོས་མེད་མིན་པར་དོན་ལ་ཐོབ་པའི་རྣམ་དབྱེ་སོགས་ཀྱང་ཅི་རིགས་སུ་བསྡུ་སྟེ།",
    "ནོར་སོ་ཡོད་པ་དང་དོན་གསལ་ངེས་སོགས་མི་བཞག་ཀ་མེད་ལས་གཞན་ཅི་རིགས་སུ་བསྡུ་ན་ཚིག་ཟོར་ཡང་ལ་དངོས་གཙང་བ་ཞིག་འབྱུང་སྟེ།",
    "བསྟན་པ་རྒྱས་པར་གྱུར་ནས་འཕགས་པའི་གང་ཟག་མང་དུ་བྱུང་ངོ།",
    "བྱོན་ནས་བསྟན་ནས་བཀོད་ནས་གྱུར་ནས་ཞེས་ཚིག་ཕྲད་ཐམས་ཅད་སྒྲ་གཅིག་ཏུ་བྱས་ན་རྣ་བར་མི་མཛེས་ཤིང་།",
    "བསྟན་པ་རྒྱས་པར་མཛད་པས།",
    "ལམ་ལ་བཀོད་སོགས་གཅོད་མཚམས་ཐ་དད་པར་བྱ་དགོས་ཤིང་།",
    "རྐང་པ་བཞིའི་མཐའ་ཡི་གེ་གཅིག་མ་ཡིན་པར་སོ་སོ་དང་།",
    "སྐྱེ་གནས་ཀྱང་སོ་སོ་བར་གྱུར་པ་ཕལ་ཆེར་བརྗོད་པ་མཛེས་པར་མཐོང་ལ།",
    "ཇི་ལྟར་བརྗོད་པ་དེ་ཉིད་འཇིག་རྟེན་ཐ་སྙད་ཀྱི་དོན་དུ་གྲགས་ཤིང་གྲུབ་པ་ཡིན་པས་འཇིག་རྟེན་གྱི་དོན་དག་ལས་མ་འདས་པས་སྐྱེ་བོ་མཁས་རྨོངས་ཀུན་ལ་འཐད་ཅིང་མཛེས་པ་སྟེ་རན་པར་སྨྲ་བའོ།",
    "འཇིག་རྟེན་གྲགས་ཚོད་ལས་ནི་འདས་པར་ཤེས་བཞིན་དུ་ཧ་ཅང་ཡང་བརྗོད་འདོད་ཀྱིས་འཇིག་རྟེན་གྲགས་པ་ལས་བརྒལ་བའི་ཁྱད་འཕགས་ཀྱི་དོན་གང་ཞིག་ཚིག་རླབས་ཀྱིས་ཤིན་ཏུ་བཀོད་པར་གྱུར་པ་དེ་ཡིས་ཁྱད་འཕགས་བརྗོད་པའི་ཚིག་ཉམས་ལ་མཁས་པ་རྣམས་ཤིན་ཏུ་ནི་ཚིམ་པར་འགྱུར་ཡང་།",
    "ཞེས་ནུ་མ་མི་ཤོང་བས་ནམ་མཁའ་ད་ལྟའི་འདི་ལས་ཆེ་དགོས་པར་བརྗོད་པ་འདི་ལྟ་བུ་ནི་ཧ་ཅང་འཇིག་རྟེན་ན་གྲགས་ཚོད་དང་སྣང་ཚད་ལས་བརྒལ་ཏེ་བརྗོད་པ་འདི་ལྟ་བུ་གོ་ཌ་པ་ཡི་ལུགས་ལས་ལྷག་པར་མཛེས་པར་བརྗོད་ཅིང་།",
    "གྲགས་ཚོད་ལས་བརྒལ་ཏེ་བརྗོད་པ་གཙོ་ཆེར་བྱེད་པ་ཤར་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "སམ་དྷིའི་སྒྲ་ལས་མཉམ་གཞག་གམ་ཏིང་ངེ་འཛིན་ཅེས་བརྗོད་པ་དམིགས་བྱའི་དོན་ལ་བློ་མཉམ་པར་བཞག་པའམ།",
    "ཞེས་པ་འདི་ལྟ་བུ་ཡིད་དུ་མི་འོང་བའི་དངོས་པོ་སྐྱུག་པ་བརྗོད་ཀྱང་ཡིད་དུ་མི་འོང་བ་མེད་པར་རྣ་བར་མཛེས་ཏེ།",
    "མི་མཛེས་པ་ནི་ཆུང་མ་སྐྱུག་པར་བྱེད་ཅེས་པ་ལྟ་བུའོ།",
    "ཤྲཱི་བཛྲ་དེ་བ་སོགས་སྙན་ངག་མཁན་སོ་སོ་ཡི་ཡིད་དང་ཞལ་ལ་གནས་པའི་རྒྱན་གྱི་ཉམས་འདོད་ཚུལ་རྣམ་རྟོག་དང་གྲངས་མཚུངས་པ་ཇི་སྙེད་པ་རྣམས་ནི་བརྗོད་པར་མི་ནུས་ཏེ།",
    "དེ་འདྲའི་ཁྱད་པར་དེ་རྣམས་མཐའ་དག་སོ་སོ་ནས་མཐར་ཐུག་པར་བསྟན་བཅོས་ཀྱི་དཀྱུས་གཅིག་ལ་བརྗོད་པར་དབྱངས་ཅན་མས་ཀྱང་ནུས་པ་མ་ཡིན་ན།",
    "དེ་ཉིད་ཡང་དག་བར་མཁྱེན་པ་ཡིན་གྱི།",
    "མ་མཁྱེན་པ་མ་ཡིན་ནོ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་ནུས་པ་ལ་མཁྱེན་ནུས་ཡང་དག་པ་མངའ་བར་ཤེས་དགོས་ཀྱི།",
    "དེ་ལས་ལྡོག་པ་ནི་མཁྱེན་ནུས་མ་ཡིན་ཏེ།",
    "ཞེས་ཤེས་པར་བྱའོ།",
    "ཡེ་ཤེས་སྦྱངས་པ་དང་ལྡན་མི་ལྡན་གྱི་ཁྱད་པར་ཅི་ལྟ་བུ་ཞེ་ན།",
    "འདུ་ཤེས་འཛིན་པས་བྱིས་པ་རྣམ་པར་ཕྱེ།",
    "དེ་ཕྱིར་ཐོགས་མེད་ལམ་འདི་སྐྱེད་པར་གྱིས།",
    "ཞེས་གསུངས་པ་ལྟར་ཐེག་ཆེན་འཕགས་པ་རྣམས་ཀྱིས་བསམ་གྱིས་མི་ཁྱབ་པའི་དོན་འདི་ལྟ་བུ་རྣམས་ཐུགས་སུ་ཆུད་ཅིང་མངོན་དུ་མཛད་ནུས་ཀྱི།",
    "ཞེས་གསུངས་པ་ལྟར་རྣམ་པར་དག་པའི་སྤྱོད་པ་སྦྱངས་ཤིང་ཡེ་ཤེས་དང་ལྡན་པ་དག་ལ་གནས་འདི་མངོན་དུ་འགྱུར་བ་སྟེ།",
    "དེའི་ཞར་བྱུང་སྙན་ངག་རྩོམ་པར་ནུས་པའི་རྒྱུ་གསུངས་པ།",
    "སྙོམ་ལས་མེད་པར་ཡོངས་སུ་གོམས་པའི་རིམ་པས་སྙན་པའི་ཉམས་ཀྱིས་མཛེས་པའི་དབྱངས་ཅན་ཏེ་སྙན་ངག་བསྟེན་པར་བྱའོ།",
    "ངག་སྦྱོར་རྩོམ་པ་གོམས་པར་བྱས་པའི་ཤུགས་ཀྱིས་ཚེགས་ཆུང་ངུས་གཞན་གྱིས་བརྩམས་པའི་དོན་ཤེས་ཤིང་།",
    "སྙན་ངག་མཛེས་པར་བྱེད་པ་ཡི།",
    "རབ་ཏུ་བརྗོད་དེ་དོན་གསལ་བར་བྱེད་པ་དང་མཛེས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "སྔོན་གྱི་སློབ་དཔོན་སྙན་ངག་མཁན་རྣམས་ཀྱིས་བསྟན་ཟིན་པ་དེ་ཉིད་ཀྱི་དོན་མཐའ་དག་ཕྱོགས་གཅིག་ཏུ་བསྡུས་ཤིང་གསལ་བར་རབ་ཏུ་ལེགས་པར་སྦྱར་བའི་ཕྱིར།",
    "དེ་ལ་ལྷོ་ཤར་གྱི་ལམ་ནི་རྣམ་པར་དབྱེ་བའི་དོན་དུ་སྦྱར་བ་དང་།",
    "ཁྱད་པར་མཚུངས་པར་སྦྱོར་བ་དང་།",
    "ཟོལ་བསྟོད་ངེས་པར་བསྟན་པ་དང་།",
    "གཉིས་པ་བྱ་བའི་རང་བཞིན་འབའ་ཞིག་བརྗོད་བྱའི་གཙོ་བོར་བྱས་པའི་བྱ་བའི་རང་བཞིན་བརྗོད་པའི་རྒྱན་ནི།",
    "མཇུག་ཏུ་འཇུག་པར་བྱེད་པ་ཞིག་གོ་ཞེས།",
    "འགྱུར་ཁ་ཅིག་ཏུ་འཁྲུངས་བར་གྱུར་ཅེས་ཀྱང་བྱས་སོ།",
    "གང་ཟག་གང་ལ་ཡོད་པའི་རྫས་བརྗོད་བྱར་བྱས་ནས་བསྟན་ན་རྫས་བརྗོད་པར་འགྱུར་ལ།",
    "དེ་ལྟར་ན་བྱ་བ་དང་ཡོན་ཏན་རྫས་ཀྱི་གནས་སྐབས་བརྗོད་བྱའི་གཙོ་བོར་བྱས་པའི་ཚེ་དེ་དང་དེ་བརྗོད་པར་འགྱུར་ཏེ།",
    "བྱ་བ་ཅན་ནམ་བྱེད་པ་པོ་དང་བྱ་བ་གཉིས་ལས་བྱ་བ་བརྗོད་བྱའི་གཙོ་བོར་བྱས་པས་བྱ་བ་བརྗོད་པ།",
    "རྫས་དང་རྫས་ཅན་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "རྫས་དང་བྱ་བ་ཡོན་ཏན་བརྗོད་བྱའི་གཙོ་བོར་མ་བྱས་པར།",
    "རྫས་དང་བྱ་བ་ཡོན་ཏན་ཅན་གྱི་དངོས་པོ་དེ་ཉིད་བརྗོད་བྱའི་གཙོ་བོར་བསྟན་ཏེ་དྲང་པོར་བརྗོད་ན་རིགས་བརྗོད་པར་འགྱུར་གྱི་གཞན་དུ་མི་འགྱུར་བའི་ཚུལ་ཤེས་དགོས་ཀྱི།",
    "སི་ཏུའི་འགྱུར་དུ་ཅུང་ཟད་དམར་ཞེས་གསུངས།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཅེས་པ་དེ་ལྟ་བུ་ནི་འཇིག་རྟེན་ན་པདྨ་སོགས་དཔེར་བྱས་ནས་འགོད་པའི་གྲགས་པ་ལས་བཟློག་ནས་གདོང་དཔེ་དང་པདྨ་དཔེ་ཅན་དུ་བྱས་པའི་ཕྱིར།",
    "གལ་ཏེ་ཡོད་ན་དཔེ་དེ་བྱེད་པར་འགྱུར་རོ།",
    "ཞེས་པ་འདི་ནི་དཔེ་གཅིག་ཏུ་ངེས་པར་མ་བྱས་པས་ངེས་མེད་ཀྱི་དཔེའོ།",
    "བསིལ་ཟེར་ཅན་གྱི་ཞེས་ཟླ་བའི་དགྲ་ཟླ་ཡིན་ཏེ་དེས་དེ་ཟུམ་པར་བྱེད་པ་དང་།",
    "འདིར་དཔེ་ཅན་ལ་གདོང་ཟླ་བའི་དགྲ་ཟླ་སྟེ་ཟླ་བ་སྐྱེངས་པར་བྱེད་པ་དང་།",
    "སྤོས་དཀར་གྱི་ནགས་ཀྱི་མཛེས་པ་དང་ལྡན་པར་གོ་ལ།",
    "མཛེས་ལྡན་ལན་བུར་བཅས་པའི་གདོང་ཞེས་པར་འགྱུར་བ་ནི།",
    "འགལ་བའི་དོན་ཅི་ཡིན་བརྟགས་པ་ན་འདི་གསུམ་མཛེས་པར་གཅིག་ཀྱང་གཟུགས་དབྱིབས་ཀྱི་སྒོ་ནས་འགལ་ཞེས་དང་།",
    "མངར་བ་ཉིད་ཀྱི་ཁྱད་པར་ཆེ།",
    "ཞེས་སོགས་གསུངས་པ་བཞིན་ནོ།",
    "བསིལ་བ་མཆོག་ཏུ་གྱུར་པའི་ཁྱད་པར་གསལ་བར་བྱེད་པ་མང་པའི་དཔེ་སྟེ་དཔེ་ཅན་གཅིག་ལ་དཔེ་མང་པོ་ལྷན་ཅིག་བཀོད་པའི་ཕྱིར་རོ།",
    "བྲམ་ཟེ་ཕུར་བུས་དབྱངས་ཅན་མའི་བསྟོད་པར།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཞེས་རྩེ་བར་བྱས་ཞེས་པའི་དོན་ནོ།",
    "རྒྱལ་པོ་རྣམས་ནི་མང་པོ་ཞིག་སྐྱེས་པར་གྱུར་ཀྱང་།",
    "ངེས་པར་དཔེ་ཡི་སྐྱོན་ལྟར་སྣང་བ་དག་ནི་འདི་ལྟར་དཔེ་དཔེ་ཅན་ཐ་དད་པའི་རྟགས་སུ་སྦྱར་བ་དང་།",
    "བརྡ་སྤྲོད་སོགས་ཀྱི་རིག་པ་རྣམས་ནི་བསྒྲུབ་པར་བྱ་བའི་ནོར་བཞིན་དུ་བཙལ་བར་བྱ་བ་ཡིན་ནོ་ཞེས་དཔེ་དཔེ་ཅན་སོ་སོར་ཉུང་ཚིག་དང་མང་ཚིག་སྦྱར་བའོ།",
    "ལྷ་ཡི་རྒྱལ་པོ་རྣམ་པར་མཛེས་སོ་ཞེས་པ་དཔེ་ཅན་དམན་པ་དང་།",
    "དེ་བཞིན་ངེས་པར་གསལ་ཞེས་དང་།",
    "དེ་སྐྱེངས་པར་བྱེད་པས་དགྲ་ཟླ་དང་།",
    "དེས་དེ་སོ་སོར་རྟོགས་པའམ་ཤེས་པར་བྱེད་པ་དང་།",
    "དེ་དེའི་མཐུན་ཕྱོགས་སུ་བྱས་པ་ཞེས་ཟེར་ཀྱང་གདོང་འདི་ཟླ་བའི་ཕྱོགས་སུ་བྱས་ལྟ་བུ་དཔེ་ཅན་དཔེའི་ཕྱོགས་དང་བཅས་པའམ་ཕྱོགས་སུ་སྨྲ་བ་དང་།",
    "ཟླ་བོ་དངོས་པོའི་དཔེ་ལྟ་བུ་དེ་དག་མཚུངས་པ་གསལ་བྱེད་ཀྱི་སྒྲ་དངོས་སུ་མེད་ཀྱང་མཚུངས་པར་དོན་གྱིས་གོ་བའི་ངག་དོན་དེ་ནི་མཚུངས་པར་གོ་བྱེད་ཡིན་ནོ།",
    "དེ་བཞིན་ཁྱད་པར་གྱི་དཔེ་དང་།",
    "བཞིན་སོགས་མཚུངས་སྒྲ་དངོས་སུ་མེད་ཀྱང་མཚུངས་པར་གོ་ནུས་ཀྱི།",
    "གཞུང་འདིར་ཡང་དེ་རྣམས་དངོས་སུ་གསུངས་པ་གང་ཡང་དཔེ་ཅན་དམན་པ་མིན་པའི་དོན་ཅན་གྱི་ཚིག་འབྲུ་མང་པོ་ཡི་ཚིག་སྡུད་དུ་གྱུར་པ་ནི་རི་བོང་མཚན་མའི་གདོང་ཅན་སོགས་ཀྱི་སྒྲ་ཡང་མཚུངས་པ་གསལ་བྱེད་ཡིན་ཏེ།",
    "དེས་གཞན་ཡང་མཚུངས་སྒྲ་དངོས་སུ་མེད་ཀྱང་མཚུངས་པར་གོ་བ་དེ་ལ་འགྲན་ཞེས་དང་།",
    "དེས་དེ་ལ་མི་མཐུན་པར་སྒྲོག་པ་དང་།",
    "དེ་དང་མཚུངས་ལས་ལྷག་པར་མཛེས་ཞེས་དང་།",
