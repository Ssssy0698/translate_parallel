    "ཉལ་བཤོམས་ཁྱིམ་ན་འདུག་དང་འགྲེང་བ་དང་།",
    "དབེན་པར་འདུག་དང་ཉལ་དང་དྲུག།",
    "འདུག་གནས་ཕྱེ་དང་བསོད་པ་དང་།",
    "མ་བསྐོས་སོགས་དགུ་འདུག་མ་གཏོགས།",
    "འདུག་གནས་དང་ནི་གཅེར་བུ་འོ།",
    "ཡང་ཡང་འདུག་གནས་ཕྱེ་དང་ནི།",
    "རྩ་བ་འབྱུང་ལ་འདུག་པ་དང་།",
    "འདུག་གནས་ཟ་དང་རིམ་ལྷག་དང་།",
    "འདུག་འགྲེང་གསུམ་ནི་དངོས་གཞི་སྤྱོད་ལམ་བཞི།",
    "རྩ་བ་འབྱུང་འདུག་རིམ་གཉིས་ཕྱོགས་གཅིག་དང་། ། འདུས་ཤིང་ཟ་དང་མ་གུས་ཕྱོགས་གཅིག་དང་།",
    "གདིང་དང་འབྱུང་ལ་འདུག་དང་གོས་བྱེད་དང་།",
    "དབེན་པར་འདུག་འགྲེང་གཉིས་དང་སྦྱོར་བཅུག་དང་།",
    "ཡང་ཡང་འདུག་གནས་སྤངས་ཟ་འདུས་ཤིང་ཟ།",
    "ཉལ་བཤོམས་ཁྱིམ་ན་འདུག་དང་འགྲེང་བ་དང་།",
    "མགྲོན་གཉེར་རིང་འདུག་ཉན་རྣ་བྱེད་པ་དང་།",
    "འདུག་གནས་འདུས་ཟ་ཉལ་བཤོམས་གཉིས།",
    "མི་སྨྲ་མ་གུས་དུས་མིན་འགྲོ།",
    "སྦྱོར་བཅུག་ཡང་ཡང་འདུག་གནས་དང་།",
    "ཀུན་སློང་རང་དོན་ཁོ་ན་སྦྱར།",
    "མ་བགྲངས་འོན་ཀྱང་ཡང་ཡང་འདུག།",
    "གོས་སྟེར་དང་ནི་འདུག་གནས་ཟ།",
    "ལུང་གཞིར་འདུག་པ་བྱ་བ་གསོ་སྦྱོང་གནང་།",
    "འདུག་པ་ཞི་གནས་གསོ་སྦྱོང་ཚེ།",
    "དགེ་སློང་ལ་ནི་འདུག་སྟེ་ལན་གསུམ་བརྗོད།",
    "རྟེན་ནི་ལྔ་ལྡན་གསོ་རུང་རང་བཞིན་གནས།",
    "ཡང་ཡང་ཟ་དང་འདུས་ཟ་དུས་མིན་འགྲོ།",
    "ས་གཞན་དེ་འཐོབ་རང་རང་འབའ་ཞིག་ཚེ།",
    "དུས་ནི་སྔ་དྲོ་ཡུན་ཚད་རང་རང་མཐའ། ། ཆོ་ག་སྦྱོར་དངོས་མཇུག་གསུམ་འཇིག་རྒྱུ་ནི།",
    "དགོས་དོན་རང་རང་ལས་ཆགས་སྡོམ་སྐྱེ་སོགས།",
    "རྗེས་གནང་རང་དོན་རབ་བྱུང་མཁོ་བཞག་བརྒྱད། ། ཡན་ལག་དབྱེ་བ་སྦྱིན་ལས་ཞེ་བརྒྱད་ནི།",
    "འདུན་པ་འདུག་ནས་གསུམ་བརྗོད་ཚོགས་ལ་དེ།",
    "རིན་ཕྲེང་རང་དོན་སྔགས་བརྗོད་ལན་གསུམ་ལ།",
    "རིང་མིན་འགྲོ་བ་མ་ལུས་འགོད་པར་ཤོག།",
    "ཞེས་ཆེད་བརྗོད་དུ་བྲིས་འདུག་པ།",
    "ཞེས་འཁོད་པ་འདི་གཉིས་པོ་བསྡུར་ནས་ཁྱེད་རང་བསམ་བློ་ཡག་པོ་ཞིག་ཐོངས་དང་།",
    "ཞེས་ཆེད་གཉེར་ཨུ་ཚུགས་ཀྱིས་བྲིས་པ་ར་སྤྲོད་གསལ་བོ་མི་འདུག་གམ།",
    "དེང་སང་རང་བཙན་དུ་གནས་དང་།",
    "གང་ལྟར་ང་རང་ཞེ་མེར་བའི་ཟས་དུག་འདི་སྐྱགས་ཚར་ན་དེས་འགྲིགས།",
    "ངའི་མིག་ལམ་དུ་དར་ཆ་དམར་པོ་དེ་ནི་གཤིན་རྗེའི་ལྕེ་ཞགས་ལྷབ་ལྷུབ་ཏུ་སྐྱོད་པ་ཞིག་ཏུ་སྣང་བས་ང་རང་ཁ་བཏགས་དཀར་པོ་དང་གངས་རི་དཀར་པོ་ལ་ངང་ངམ་ཤུགས་ཀྱིས་དགའ་དད་ཅིག་སྐྱེས་མྱོང་ཡ།",
    "དེས་གསར་རྩོམ་བྱེད་པའི་སེམས་ཤུགས་ལ་གནོད་ཀྱི་འདུག་ཅེས་དང་།",
    "ལོས་ཡིན།",
    "ཡིན་ཡང་རང་ངོས་ནས་གཏོར་བཤིག་བྱས་ན་འགལ་བ་གང་ཡང་མེད།",
    "ཁོ་རང་ལ་མཚོན་ན་ངོ་མ་རྒྱ་ཡིག་ཁོ་ནར་བརྟེན་ནས་བོད་ཀྱི་འཚོ་བ་བྲིས་ཏེ་རྒྱ་ནག་རྩོམ་རིག་ལས་རིགས་ནང་དུ་གྲགས་པ་རྒྱས་ཤིང་རྩོམ་པ་པོའི་མཐུན་ཚོགས་བོད་ལྗོངས་ཡན་ལག་མཐུན་ཚོགས་ཀྱི་རྒྱུན་ལས་གཙོ་འཛིན་གཞོན་པ་ཞིག་ཏུ་གྱུར་ཡོད་པས།",
    "གསེར་ཡིག་དེ་ནི་བོད་རབ་བྱུང་དྲུག་པའི་ཆུ་སྦྲུལ་ཕྱི་ལོ་༡༤༡༣ ལོར་ཕུལ་འདུག་སྟབས།",
    "སྤྱིར་ཏཱ་མིང་རྒྱལ་པོས་རྗེ་ཙོང་ཁ་བ་ཆེན་པོ་ཉུང་མཐརཡང་ལན་བཞི་ལས་མང་བ་གདན་ཞུ་ཕུལ་འདུག་པ་གསལ་པོ་ཡིན།",
    "ཁྱེད་རང་ལམ་གྱི་ཡོན་ཏན་ཤིན་ཏུ་ཟབ་ཅིང་མཐོ་བ།",
    "ཡང་མི་ཁ་ཤས་ཀྱིས་ཡུལ་དབུས་ཞེས་འཁོད་འདུག་པས་རྒྱ་ནག་གོང་མ་བཞུགས་ས་ཡུལ་དབུས་དང་།",
    "བྱི་བ་ལོ་ཟླ་བ་དྲུག་པའི་ཚེས་བཅུ་དགུ་ལ་ཡུལ་དབུས་ནས་ཕུལ་བའི་ཞུ་ཡིག་ཅེས་འཁོད་འདུག་པ་ལས།",
    "ཡུལ་དབུས་ཞེས་པ་དེས་བོད་ཀྱི་རྒྱལ་ས་ལྷ་སར་གོ་བར་འདུག་ན།",
    "དེ་བཞིན་གསེར་ཡིག་པ་རྣམས་ཏཱ་མིང་རྒྱལ་པོའི་མངའ་ཁོངས་ཀྱི་ས་གནས་གང་ཞིག་ཏུ་ཕྱིན་རུང་རང་ཉིད་གོང་མའི་སྐུ་ཚབ་ཡིན་སྙམ་པའི་གདེང་སྤོབས་ཤིག་དང་།",
    "དེ་སྔོན་ཏཱ་ཞིང་བྲེ་བོས་མགོ་བྱས་གདན་ཞུའི་ཕོ་ཉ་ལན་མང་ཡོང་བ་རྣམས་ལ་ལན་གཅིག་ལས་མཇལ་ཁ་ཙམ་ཡང་གནང་ཡོད་མེད་དོགས་གནས་སུ་འདུག་སྟེ།",
    "དེ་ལྟར་ཡང་རང་རང་ལ་རྣམ་པར་དཔྱོད་པའི་བློ་དང་ལྡན་ན་ནི།",
    "བྱས་ཙང་བོད་ཀྲུང་གོའི་འོག་མིན་པར་དེས་ཀྱང་ར་འཕྲོད་པར་འདུག་དམག་ཆེན་གཉིས་པའི་སྐབས་རྒྱའི་མཐུན་ཕྱོགས་ཨ་རི་དང་དབྱིན་ཇི་སོགས་ནས་བོད་གཞུང་ལ་བོད་ཀྱི་ས་ཐོག་བརྒྱུད་དམག་མཁོ་འོར་འདྲེན་ཆོག་པར་བསྐུལ་ནའང་བོད་ནི་དབར་གནས་རྒྱལ་ཁབ་ཏུ་གནས་པས་དེ་ལ་ངོས་ལེན་མཛད་མེད།",
    "ཡང་སྲིད་འཁྲུལ་བྲལ་ཞིག་དུས་ལས་མ་གཡོལ་བར་བསོད་སྐལ་དུ་ཐོབ།",
    "ལྟོ་བགྲངས་དུས་བསྐྱེལ་གྱིས་གཞི་འདུག་བྱས་ཕྱིར།",
    "གྲོས་ཚོགས་འདི་ནི་དབྱིན་ཇིས་བོད་རྒྱ་ཁོངས་ནས་ཁ་བྲལ་གཏོང་བའི་གཡོ་བྱུས་ཤིག་ཡིན་པར་ངོས་འཛིན་བྱས་པར་འདུག་ཀྱང་།",
    "རྒྱས་བོད་ལྗོངས་ཟ་སེམས་ཀྱིས་དམག་བཏང་སྟེ་ཁ་མཆུ་བྱེད་ཀྱི་འདུག་ན།",
    "ཞེས་བོད་འདི་རྒྱ་ནག་ལས་ལོགས་སུ་བཀར་འདུག་པ་འདི་ནི།",
    "ཞེས་འཁོད་འདུག་དེ་ནི་བདེན་འབྲེལ་ནམ་ཡང་མིན།",
    "བོད་ཀྱི་མི་དམངས་ཀྲུང་ཧྭ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་མེས་པོའི་རྒྱལ་ཁབ་ཁྱིམ་ཚང་ཆེན་པོའི་ནང་ལོག་དགོས་ཞེས་འཁོད་འདུག་༡༩༣ ནས་བོད་ནང་བཙན་འཛུལ་བྱས་པའི་ཀྲའོ་ཨེར་ཕུང་ཅན་མན་ཇུའི་དཔུང་དམག་རྣམས།",
    "མི་དམངས་ཀྱི་བདེ་ཐབས་ཡར་རྒྱས་འབྱུང་ཆེད་བོད་མིའི་ཡུལ་གོམས་གཤིས་ལུགས་དང་བསྟུན་པའི་བོད་གཞུང་རང་ནས།",
    "གསང་མྱུལ་གྱི་ཉེས་པ་འདུག་ལ།",
    "ཚེ་སྲོག་བློས་གཏོང་དགོས་ཀྱང་ཕངས་པ་མེད་ཅེས་ཞུས་ན་ཡང་གྲགས་འགུལ་ཇི་ཡང་མི་འདུག་པས།",
    "ངེད་གཉིས་ཀྱིས་ཉིན་དྲུག་དང་ཕྱེད་བར་ཟས་བཅད་ངོ་རྒོལ་བྱས་པ་མ་གཏོགས་གཏུག་ཡིག་ཁོ་ཚོར་སྤྲོད་རྒྱུ་ཡང་ཁག་པོ་འདུག་རྐང་གཞུང་ཨ་ཚེ་ལགས་ཀྱིས་སྔ་རྗེས་སུ་ཁོ་ཚོར་བྲིས་པའི་འཕྲིན་སོགས་མང་ཡང་ཐུག་འཕྲད་ཀྱི་གོ་སྐབས་མེད་པས་སྒྲུབ་བྱེད་དུ་འདིར་མ་དྲངས།",
    "ནན་ཡང་རང་བཙན་ལ་རོགས་བྱེད་པ།",
    "མི་རིགས་རང་ཐག་རང་གཅོད་ཀྱི་ཆ་རྐྱེན་ཡོངས་སུ་ཚང་བའང་བསྟན་འདུག་པས།",
    "ཅེས་ཁྲི་ཕེབས་མཛད་སྒོའི་ལོ་ཚིགས་ཀྱང་ནོར་འདུག་མཛད་སྒོ་དངོས་གཞི་ནི།",
    "ཁོང་གཟི་བརྗིད་ཆེན་པོ་འདུག་ལབ་སྟེ།",
    "ཁོ་རང་ནས་མཛད་སྒོ་དེའི་འགོ་ཁྲིད་བྱས་ཏེ།",
    "དེ་མྱུར་ཚད་འདི་འདྲ་ངང་མདུན་དུ་འགུལ་བསྐྱོད་བྱེད་ཀྱི་འདུག་ཅེས་བརྗོད་ཐབས་མེད།",
    "ཁོ་རང་གནས་པའི་མཐའ་ཡས་འཇིག་རྟེན་གྱི་གསང་བ་ལྐོག་གྱུར་གྱི་རང་བཞིན་ངོས་ཟིན་ཐུབ་ཀྱི་མེད་ཅིང་།",
    "བྱ་དངོས་གང་ཡིན་ཡང་རང་ངོས་ནས་གྲུབ་པ་ཞིག་མ་ཡིན་པར་དེའི་གྲུབ་ཆའི་རྒྱུ་ཚོགས་ཀྱི་སྤྱི་བསྡོམས་ཙམ་གྱི་སྟེང་དུ་གྲུབ་ཡོད་ལ།",
    "ཕྲ་ཞིང་རང་བཞིན་མེད་པའི་འཇིག་རྟེན་ཕྲ་བ་འདི་དག་ཐམས་ཅད་མིའི་སེམས་ཁོ་ན་ལས་མ་འདས་པ་ལགས་ན།",
    "ས་ཆ་འདིར་རོ་ཆང་ཞེས་པའི་གཞིས་ཆགས་འདུག་མིང་གཞན་དུ་ཏིས་རྐང་ངམ་ཏིས་འཇང་ཟེར།",
    "ས་ཆ་འདིར་རོ་ཆང་གཞིས་ཆགས་འདུག་ཟེར་བ་བདེན་པར་སྙམ་སྟེ།",
    "བོད་ཀྱི་མཁས་པ་མི་གསུམ་ས་ཆ་འདིར་སླེབས་དུས་བླ་ཆེན་ནི་འབྲོག་ཁྱིམ་ཞིག་ཏུ་སྐྱེས་ནས་རྫི་བོ་བྱེད་བཞིན་འདུག་ཟེར་བ་ལས་ད་དུང་འབྲོག་ཁྱིམ་མང་པོ་ཡང་ས་ཆ་འདིར་མེད་མི་སྲིད་པ་ཞིག་ག་ལ་ཡིན།",
    "ས་ཆ་འདིར་རོ་ཆང་གཞིས་ཆགས་འདུག་ཟེར་བ་དང་།",
    "དེ་ཡང་རྗེ་འཇིགས་མེད་རིགས་པའི་བློ་གྲོས་ཀྱི་གསུང་རྩོམ་པོད་དང་པོའི་ཤོག་ངོས་༥༢ ཐོག་དུས་ཕྱིས་རབ་བྱུང་དྲུག་པའི་སྟོད་ཙམ་ན་ཛལཎཎ་ར་དང་ཡོ་ཊི་ཡ་ན་སོགས་དང་ཉེ་བའི་ཡུལ་ཁམས་ཤིག་ནས་མའོ་ཧ་མདྷེ་ལ་སྐྱབས་སུ་འཛིན་པའི་སྐྱེ་བོའི་ཚོགས་མང་པོ་ཞིག་གནས་འཕོས་ནས་ས་འདིར་སླེབས་ཏེ་གནས་གཞི་བཟུང་ཞིང་རིམ་གྱིས་སྐྱེ་བོ་མང་དུ་འཕེལ་བ་དང་།",
    "ཁ་ཆེ་མི་རིགས་བྱུང་ནས་ད་བར་ཧ་ལམ་མི་ལོ་༦ ནས་༧ ལྷག་རྒྱ་མི་རིགས་བྱུང་ནས་ད་ལྟའི་བར་མི་ལོ་༢༩ ནས་༣ ལྷག་འགོར་འདུག་བཞི་པ།",
    "ཞ་ལུར་ཡང་ཡ་རྩེ་ནས་ཕུལ་བྱ་བའི་རྒྱ་དཔེ་འདུག་པས།",
    "ཁོ་ཚོ་ཚང་མ་ཡོ་རོབ་ཀྱི་རིག་གཞུང་དེའི་རྙི་ལ་ཐེབས་ཡོད་པ་དང་རང་ཉིད་རྙི་དེ་ལས་ཐར་བར་རང་ཉིད་ཀྱི་བརྩོན་པ་བྱེད་དགོས་པ་ཞིག་ཆགས་ཀྱི་འདུག་དེ་ལ་བསམ་གཞིགས་དང་།",
    "སྤྱིར་བཏང་བོད་དུ་གནས་པའི་མི་དམངས་ཚང་མས་ལས་དགེ་སྡུག་བརྩི་ཞིང་རང་བཞིན་གྱིས་གནས་ལུགས་ལ་བརྩི་སྲུང་བྱེད་ཀྱི་ཡོད།",
    "ཡིན་ན་ཡང་གོ་སྐབས་ཤིག་བྱུང་ན་ཁོ་རང་ཕྱིར་བྱང་ཕྱོགས་སུ་བྲོས་འགྲོ་ངེས་ཡིན།",
    "དེ་ལ་གཅེས་འཛིན་བྱེད་རྒྱུ་ཡིན་པ་དྲན་གྱི་འདུག་གལ་སྲིད་རྒྱ་ཡི་དམག་ཁོངས་སུ་ཡོད་པའི་བོད་མི་ཚང་མ་ཕྱིར་འཐེན་བྱས་པ་ཡིན་ན།",
    "གལ་སྲིད་ཁྱེད་རང་དཔྱ་ཁྲལ་བསྡུ་མཁན་ཞིག་ཡིན་ན།",
    "གལ་སྲིད་ཁྱེད་རང་རྩོམ་པ་པོ་ཞིག་ཡིན་ཚེ།",
    "བོད་ཟླ་ལྔ་བའི་ཟླ་དཀྱིལ་དུ་དེ་གའི་ལོ་གཅིག་དུས་གཅིག་ནང་པའི་དུས་ཆེན་ཏེ་གོས་སྐུ་འགྲེམས་པའི་དུས་ཚོད་འཁེལ་གྱི་ཡོད།",
    "པཎ་ཆེན་རྒྱལ་མཚན་ནོར་བུ་རྒྱ་མི་ཇི་ལྟ་བ་བཞིན་བསྒྱུར་ནས་རིམ་པས་ཁོང་རང་ཉིད་བོད་པ་ཡིན་པ་བརྗེད་དུ་འཇུག་རྒྱུ་དང་།",
    "དབྱིངས་གཡུང་དྲུང་ཡོངས་སུ་རྫོགས་པའི་དོན་དང་སྦྱར་ཏེ་གྲུ་བཞིར་འདུག་པ",
    "ཡལ་ག་བྱང་བུར་འདུག་པས་རྩིས་དང་ཡི་གེའི་བྱང་བུ་ཡང་དེ་ནས་བྱུང་",
    "ཆུ་བོ་ཞགས་པར་སྡོག་པ་རྩི་ཤིང་རང་བསྡུད་བྱེད་པ་ཏིང་འཛིན་བཅུད་ལ་རོལ་བ",
    "འདི་ནས་རིང་པོར་མི་ཐོག་དུས་ཤེད་ནས",
    "བདལ་པ་བཀོད་ལེགས་གཡུང་དྲུང་རང་བཞིན་མི་འགྱུར་ཞིང་ཁམས་ཞེས་བྱ་བ",
    "ཕ་རོལ་ཡུལ་རྣམས་འཕྲག་དོག་ཁོ་ནར་མཐོང་རང་རིག་བཞི་ཡི་དམིགས་བུ་ཕྲ་བས་ན",
    "འདུག་པའི་སེམས་འཆང་ཞེ་སྡང་རྒྱུ",
    "གདོད་ནས་བྱམས་དང་རང་བཞིན་བྱམས",
    "གདོད་ནས་ངང་དང་རང་བཞིན་ཤུགས",
    "ངང་དང་ཐབས་དང་རང་བཞིན་དད",
    "ཐམས་ཅད་ཀུན་བཟང་རང་བཞིན་ཡིན",
    "ཏིང་ངེ་འཛིན་དེ་ལ་བརྟེན་ནས་ཕྱིས་དེ་བཞིན་དུ་འདུག་སྟེ།",
    "དེ་གཅིག་བུ་དབེན་པར་འདུག་སྟེ་ནང་དུ་ཡང་དག་བཞག་ནས།",
    "ཞི་ཚེ་རྣལ་དུ་འདུག་པའོ།",
    "བསམ་གཏན་དང་པོ་ལ་རང་སའི་ཆགས་པ་རགས་པ་དང་མ་བྲལ་ཡང་རང་ཉིད་ཡན་ལག་ཁ་ཅིག་ལ་ཆགས་བྲལ་རུང་ལ།",
    "ཁྱབ་སྟེ་དགའ་བ་དང་དད་པ་གཉིས་ལ་མུ་བཞི་རྩི་ཚུལ་ཡོད་པའི་ཕྱིར་དང་རང་འགྲེལ་ལས།",
    "ཉེར་བསྡོགས་ཀྱིས་དེ་ལྟར་སྒོམ་ནས་དངོས་གཞིར་གྱུར་པ་ན་ནམ་མཁའ་ལ་དམིགས་པ་དང་རང་སའི་ཕུང་པོ་བཞི་ལ་དམིགས་པ་ཡང་ཡོད་ལ།",
    "ངས་འཇིག་རྟེན་བློས་གཏོང་བློ་བྱས་པས་མི་ཡོང་བར་འདུག་གསུངས་ནས།",
    "ཁོང་ལ་དེ་དགོས་ཤད་མི་གདའ་སྟེ་རྗེས་འཇུག་ལ་སློབ་པ་ཡིན་གསུང་།",
    "སྐྱེས་ན་ཡང་འབད་པས་སྤོང་བ་ཞིག་གལ་ཆེ་བ་དེར་གདའ།",
    "འདི་ལ་གཅིག་སྒྲིལ་དང་ཞེས་ནན་ཏན་གྱིས་གསུང་བར་གདའ་ཡང་།",
    "ཚེ་བློས་ཐོངས་པ་ཞིག་རང་འདོད་སྙམ་པ་བྱས་ཀྱིན་འབུང་དགོས་གསུང་བ་དེར་གདའ།",
    "ལྟོགས་ཀྱི་དོགས་པ་ལས་ཤིའི་དོགས་པ་ནི་ཡེ་མི་འདུག་ན་གསུང་།",
    "ཞེས་མཚམས་མཛད་པའི་སྒོ་ལ་གླན་པ་ཡིན་པར་གདའ།",
    "དེ་བས་ཆེས་མཆོག་ཏུ་གྱུར་པ་འགྲུབ་ཡོད་མི་གསུང་བར་གདའ།",
    "འབད་དགོས་གསུང་བ་ལགས་པར་གདའ།",
    "ཅེས་ཁོང་རང་ལ་གདམས་པ་མཛད་པ་འདི་ཐམས་ཅད་ཀྱི་གོ་འཚལ།",
    "མ་བྱུང་ཡང་ཁོ་རང་ཤེས།",
    "འདོད་པ་སྤངས་པའི་རྩ་ན་གདའ།",
    "འདོད་པའི་བློ་སྣ་བཟློག་ཏུ་བཏུབ་ཙ་ན་སྐྱིད་འགོ་ཚུགས་པ་ཡིན།",
    "རྙེད་པ་མི་འདོད་ཙ་ན་རྙེད་པའི་མཆོག་ཡིན།",
    "སྙན་པ་མི་འདོད་ཙ་ན་སྙན་པའི་མཆོག་ཡིན།",
    "གྲགས་པ་མི་འདོད་ཙ་ན་གྲགས་པའི་མཆོག་ཡིན།",
    "འཁོར་མི་འདོད་ཙ་ན་འཁོར་གྱི་མཆོག་ཡིན།",
    "ཅིས་ཀྱང་དགོས་པ་མེད་ཙ་ན།",
    "རྒྱལ་སྲིད་བཟུང་བས་ཀྱང་རང་གཞན་ཡོ་ལ་ཕན་ཐོགས།",
