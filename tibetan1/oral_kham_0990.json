    "སྒེར་གཅོད་རྒྱལ་ཁབ་ཏུ་འཇིག་རྟེན་ན་དཔེ་མི་སྲིད་པའི་ནག་ཉེས་ཀྱི་དཔེ་མང་པོ་ཡོད་པ་དཔེར་ན།",
    "མི་རོ་མང་པོའི་གསེབ་ན་ཤི་མ་ཐུབ་པའི་རྨས་མ་གཡས་ལོག་གཡོན་ལོག་བྱས་འདུག་པ།",
    "བཙོན་མ་རྐང་ལག་ཞ་ནས་རྐང་པ་དཔྱི་ལ་འབྱར་བ་དང་ལག་པ་བྲང་ལ་འབྱར་བ་ཡང་མང་པོ་འདུག་ལ།",
    "བོའུ་དེ་བརྒྱབ་པའི་ཤུལ་དུ་སྔུན་ན་ཨུ་ཁུང་ཆུང་ངུ་ཞིག་མ་གཏོགས་མི་འདུག་ལ།",
    "ལྟག་རྒྱབ་ཏུ་བར་ཚགས་མེད་པར་གཏོར་འདུག་ཅེས་དང་།",
    "ཡར་དེད་པས་བློ་འབྱེད་ལས་འགུལ་ལ་ཐུག་འདུག་ཁྱད་འཕགས་མཆོག་གྱུར་གྱི་བསམ་བློ་དེ་གནམ་ས་གོ་འབྱེད།",
    "ཞེས་བཀོད་འདུག་པ་དང་།",
    "ཞི་བདེའི་རྒྱུན་སྐྱོང་ལ་བར་ཆད་བཟོས་པ་ཡིན་ཞེས་བཀོད་འདུག་པ་དང་།",
    "རྐང་སྣེ་ས་ལ་མི་ཐུག་པའི་འཁྲུལ་སྣང་ཅན་དུ་གྱུར་འདུག་པ་དང་།",
    "ཨ་ཁ་དང་ཨ་ཙི་ཤོར།",
    "རང་ཉིད་ཁ་འཁུམས་ལག་འཁུམས་སུ་འདུག་པའི་གནས་ལུགས་སུ་བགྲང་བ་དེ་བས་ཀྱང་མ་ཡིན་པར།",
    "འཐབ་རྩོད་རབ་དང་རིམ་པ་དང་གང་ས་གང་ལ་བྱེད་པའི་ལྟས་འདུག་ན།",
    "ཁོ་བོས་དེ་ལྟར་ཕྱི་ནང་རང་གཞན་ཀུན་ལ་བསམ་ནས་དྲག་པོ་སྤྱོད་པའམ་འཇིགས་སྐུལ་རིང་ལུགས་ཀྱི་ལམ་འདེམས་པ་ནི་རང་ཉིད་རྩ་བ་ནས་རྫོགས་པའི་ལམ་འདེམས་པ་ཡིན་པར་ཐག་བཅད་པ་ཡིན་ལ།",
    "ཁོ་ཚོས་བསམ་བཞིན་ཤུགས་རྒྱག་ས་དེ་ཁོ་ཚོས་ལྷ་ཡིན་ནམ་ཡང་ན་འདྲེ་ཡིན་པ་སྒྲུབ་ཁག་པོ་ཡིན་པ་ལྟར་འདུག་རྒྱལ་ཁབ་ལ་ཤུགས་རྒྱག་མཁན་དེ་ཚོས་རྒྱལ་ཁབ་ཀྱི་བཀའ་ལས་འདའ་བ་མེད་པའི་མི་སེར་གྱི་རིན་ཐང་ནི་རྟ་ཞིག་དང་ཁྱི་ཞིག་ལའང་མི་དོ་བ་ལྟར་ལྟ་སྟེ།",
    "མཚན་ཉིད་རིག་པ་མཁན་ཧ་པི་སི་དང་ཧུ་མེ་སོགས་ཀྱི་རྩོམ་དུ་སྤྱི་དམངས་ཀྱི་རྟོན་དང་མི་རྟོན་གྱི་དོན་དེ་ལ་དགོངས་བཞེས་ཆེན་པོ་གནང་འདུག་རབས་དང་།",
    "ནུབ་ཕྱོགས་པ་རྣམས་ཀྱིས་གཞུང་ལུགས་དང་ལག་ལེན་ཡ་མ་བྲལ་བའི་ཆབ་སྲིད་སྲོལ་རྒྱུན་ཞིག་ཏུ་ངོས་འཛིན་གྱི་འདུག་ལ།",
    "བོད་སྐད་དུ་བདེན་པའི་ཨུ་ཚུགས་ཞེས་བསྒྱུར་འདུག་དེ་ཡང་ས་ཏ་ཡ་ནི་བདེན་པ་དང་ག་ར་ཧྭ་ནི་འཛིན་པ་དང་།",
    "འཚེ་མེད་ཞི་བ་ཞེས་པ་ལ་མ་མཐར་ཡང་ང་དོན་གཉིས་འདུག་སྟེ།",
    "མི་བུ་གངདེ་དང་མི་རིགས་གང་དེ་དང་འཛམ་གླིང་གང་དེ་རྣམས་ངེས་པར་དུ་འཚེ་མེད་ཞི་བ་ལ་བརྟེན་ན་གཞི་ནས་གནས་དེར་འབྱོན་པ་གདོན་མི་ཟའོ་ཞེས་སོགས་རྒྱ་ཆེར་གསུངས་འདུག་སྟེ་དྲངས་པས་མི་ལང་བས་ཤེས་གནམ་ས་གོ་འབྱེད།",
    "དོན་ལ་ཁོ་ནི་གཡོ་ཟོལ་དང་འཕྲུལ་ཅན་ཞིག་འདུག་ཅེས་ཟུར་ཟ་དང་དམའ་འབེབས་བྱས་མྱོང་ལ།",
    "ཞེས་བདེན་པ་བསྟན་འདུག་ནའང་།",
    "གན་དྷི་རིང་ལུགས་ཞེས་པ་ནི་ཞི་བདེ་རིང་ལུགས་སུ་གོ་ཡི་འདུག་པ་དང་།",
    "ཕྱི་ཕྱིར་འགྲོ་བ་མིའི་རིགས་ཀྱི་ཡོངས་ཁྱབ་ལྟ་བ་ཞིག་ཏུ་ཆགས་ནས་འདུག་ལ།",
    "ད་ལྟ་གན་དྷི་ཞེས་ཚེ་ཞི་བའི་ལྟ་བ་ཞིག་དང་ཞི་བའི་རིང་ལུགས་ཤིག་ལ་ངོས་འཛིན་གྱི་འདུག་ཕྱིར།",
    "ཐང་ཞི་བས་རྩོད་པའི་དེད་དཔོན་དུ་གྱུར་འདུག་ཅེས་སྨྲས་པ་ཡིན་ནོ།",
    "གཤིན་དུར་པ་རྣམས་ཀྱིས་བེམ་པོ་འདུག་ཅེས་དང་།",
    "ཡོད་ཚད་ཆབ་སྲིད་དང་མ་འབྲེལ་བ་མེད་འདུག་ཡོད་ཚད་ཆབ་སྲིད་དང་འབྲེལ་བ་དེ་ལྟར་ན།",
    "རྟེན་གཞི་ཞིག་ཅིས་ཀྱང་དགོས་འདུག་དེ་ནི་རྒྱ་གར་གྱི་གན་དྷིའི་བདེན་པའི་ཨུ་ཚུགས་ཡིན་པ་ཁོ་བོས་མ་ཤེས་གོང་ལ་ཀུན་གྱིས་རྟོགས་ཡོད་ཀྱང་སྲིད།",
    "ཐ་ན་འུ་ཐུག་ངོ་རྒོལ་གྱི་རྟགས་སྟོན་ཕྱིར་རང་ལུས་གནམ་ཐག་ཆུར་ལྕེབ་དང་རང་སྲེག་བྱས་པའི་སྐྱི་གཡའ་བ་དེ་འདྲའང་རྣ་ལ་ཐོས་རྒྱུ་འདུག་དེ་དག་མི་བུ་སྒེར་གྱི་རྣམ་པས་དང་།",
    "རྩ་འཛུགས་ཡོད་པའི་ལས་འགུལ་མཚན་ཉིད་ཚང་བ་ཞིག་ཏུ་ནི་ཆགས་བཟོ་མི་འདུག་ཡིན་ནའང་།",
    "གཞི་རྩའི་སྲོག་ཤིང་རྣམས་ཉིན་བཞིན་ཇེ་གསལ་དང་ཇེ་བརྟན་ཡིན་པར་སྨྲ་ཡི་འདུག་གནམ་ས་གོ་འབྱེད།",
    "སུ་ཡིན་རུང་རང་ཉིད་དང་།",
    "འགྲོ་ཐབས་འདུག་ཐབས་བྱས་ཡོད་ན།",
    "དེ་བཞིན་དེ་གཉིས་ཐོག་མར་གྲུབ་པའི་དུས་དོན་གཅིག་ཅིང་སྔ་མ་དང་རང་བཞིན་གཅིག་པ་དང་།",
    "རྫ་མཁན་ལ་སོགས་པ་ནི་རང་བསྡད་ཅིང་བསྡད་ཅིང་འདུག་པ་ཡིན་ལ།",
    "བལྟར་རུང་བ་ཡང་རང་བཞིན་གྱིས་བསྐལ་པ་སྤངས་པ་ཁོ་ནས་ཡིན་གྱི།",
    "ལུས་ཀྱི་བདག་ཉིད་དམ་ཞེས་བྱ་བ་ནི་རང་བཞིན་ཡང་རང་བཞིན་ཅན་ལ་བརྟེན་པ་ཞེས་བརྗོད་པར་འདོད་པས་སོ།",
    "གཞན་དག་འབྲས་བུ་དང་རང་བཞིན་གྱི་ཕྱོགས་སྦྱར་བར་བྱ་བའི་ཕྱིར་གལ་ཏེ་ཞེས་བརྗོད་དོ།",
    "དེ་བཞིན་དུ་དངོས་པོ་ཡང་རང་བཞིན་འགྱུར་བ་ན།",
    "དེ་བཞིན་དུ་འཆི་བའི་གནས་སྐབས་སུ་ཡང་རང་ངམ་གཞན་གྱི་སེམས་རྣམ་པར་ཆད་པས་མི་རྟོགས་སོ།",
    "འོན་ཀྱང་རང་ངམ་འབྲེལ་པ་ཅན་གྱི་ཡོད་པ་དང་མེད་པ་སྲིད་ན་ཡིན་ནོ།",
    "རྒྱུད་ཀྱང་རང་བཞིན་གྱིས་བརྩེ་དང་ལྡན་པ་ལ་ནི་བརྩེ་བ་ཉིད་འབྱུང་ལ།",
    "དེ་ལྟར་ན་ཡང་རང་ལོག་ན་ལྡོག་པར་བྱེད་པ་གོ་ཅི་ལྟར་སྙམ་ན།",
    "འོན་ཀྱང་རང་ལོག་པས་ཟློག་པར་བྱེད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "དེས་ན་ཡན་ལག་ཅན་རིག་པའི་རང་བཞིན་ཡིན་ཡང་རང་ཉིད་རྡུལ་ཕྲ་རབ་དག་ལས་སྐྱེ་བར་རིག་པར་ཇི་ལྟར་ཤེས།",
    "ཡོན་ཏན་གྱི་མཚན་ཉིད་ཉམས་པ་སོན་འདུག་གོ་སྙམ་དུ་དོགས་པའོ།",
    "གཞན་གྱིས་ནི་སྟེ་སོ་སོའི་སྐྱེ་པོས་ནི་དེའི་ཚེའི་ད་ལྟར་བའི་དུས་དང་རང་འབྲེལ་པར་མི་འཛིན་པའི་ཕྱིར་རོ།",
    "བདེ་བ་ཡང་རང་སྐྱེས་བ་ཙམ་གྱིས་ནི་སྐྱེད་བྱེད་མ་ཡིན་གྱི།",
    "འོན་ཏེ་ཡང་རང་ཉིད་ཐམས་ཅད་རྟོགས་པ་མ་ཡིན་ནོ་སྙམ་ན།",
    "གང་ཡང་ལུས་ཉིད་དེའི་རྒྱུ་ཡིན་པ་ཞེས་བྱ་བ་ཕྱོགས་སྔ་མར་བཀོད་པ་དེ་ལྟ་ན་ཡང་རང་བཞིན་ཡིན་པ་ཞེས་རྗེས་སུ་བརྗོད་པ་ནི་ཉེས་པ་མཚུངས་པའི་ཕྱིར་རོ།",
    "འདུག་གོ་སྙམ་དུ་དོགས་པ་བསུ་ནས་དབྱེར་མེད་ཕྱིར་ན་ཞེས་སྨོས་སོ།",
    "གཞན་ལ་ནི་དཀར་པོ་ལ་སོགས་པ་ལོག་ཀྱང་རང་བཞིན་གཞན་སྐྱེས་པ་ན།",
    "འདོད་ཆགས་དང་བྲལ་བའི་འབད་པ་ཡང་རང་རིག་པ་ཙམ་ཡིན་གྱི་རྣམ་པར་རྟོག་པ་ནི་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "དེ་ཉིད་དང་གཞན་ཉིད་ཀྱི་ཕྱོགས་དག་ལ་ཁྱད་པར་མེད་བ་འདུག་པ་དང་ལྡན་པ་ཡང་མེད་པ་ཁོ་ནའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ན་གཅིག་དུས་ཐ་དད་པ་ཉིད་མེད་པའི་ཕྱིར་ན་མཐོང་བ་དང་མི་མཐོང་བ་ཉིད་དོ་སྙམ་དུ་དགོངས་པའོ།",
    "ཡང་དག་དོན་དང་རང་བཞིན་ཞེས་བྱ་བ་གཉིས་ཀྱང་སྤང་བར་མི་ནུས་བ་རྩོལ་བ་མེད་པའི་རྒྱུར་བརྗོད་པ་ཡིན་ནོ།",
    "དོན་དམ་པ་སོ་ན་འདུག་གོ་ཞེས་ལན་བཏབ་བ་ནི།",
    "འདོད་ཆགས་ལ་སོགས་བ་དེ་དང་ལྡན་པ་ཡང་རང་ཉིད་དེ་རང་བཞིན་གྱིས་བདག་གཞན་ཡིན་ཏེ།",
    "དམིགས་པ་མ་ཡིན་ཡང་རང་བཞིན་ཉིད་ཀྱིས་མཚུངས་པར་རྟོགས་པ་དེའི་ས་བོན་ནི་གཞན་ལས་ཐ་དད་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི།",
    "རྒྱུ་སྦྱར་སྲི་ཞུར་བརྩོན་པའི་ཞེས་སོགས་སྨོན་ཚིག་མང་དུ་བཀོད་འདུག་པས།",
    "རྙིང་མ་དགེ་ལུགས་པར་བསྒྱུར་བ་འདུག་ཟེར་བའང་བྱུང་།",
    "ང་རང་སེ་ར་ཏྲེ་བོ་ཁང་ཚན་ཡིན་ཞུས་པས།",
    "ང་རང་ཁ་སང་ལྷ་ས་ནས་འོངས་པ་ཡིན།",
    "རང་གཞན་གཉིས་ཀའི་དོན་མི་འདུག་ཞུས་པས་ན།",
    "དེའི་སྒོ་ནས་རྗེས་གནང་ཞིག་ཞུ་དགོས་པར་འདུག་པས།",
    "བཅུ་གཅིག་ཉིན་ཐུགས་ཧ་ཅང་དྭངས་ནས་འདུག་པས།",
    "ལས་སླ་པོ་མི་འདུག་གསུངས།",
    "ནམ་ལངས་ནས་ཡར་བཞེངས་ཏེ་དམ་ཅན་གྱི་བྲིས་རྟེན་ལ་བལྟས་པས་རྨི་ལམ་ཇི་བཞིན་དུ་འདུག་པ་ན།",
    "ག་ལེར་ཕྱི་རོལ་ཏུ་ཕེབས་ནས་ར་རྣམས་ཉལ་བའི་ས་དེར་ཅི་འདྲ་འདུག་བལྟས་པས་རྨི་ལམ་དང་ཁྱད་པར་མི་འདུག།",
    "ཁོང་ཡང་ཡར་ཕེབས་དུས་འཇིགས་སུ་རུང་བ་ཞིག་བསྡད་འདུག་པས།",
    "དར་དགོན་གྱི་ཕྱོགས་ཤིག་ཏུ་ང་རང་སྡོད་གནས་ཤིག་བཙལ་ནས་བསྡད་སྙམ་ཡོད་པས་དེ་རྣམས་ཇི་དགོས་ངེད་ལ་ཐུགས་བརྟག་དང་ཐུགས་བློ་ཞུས་པར།",
    "ལར་ང་རང་ཆུང་ངུའི་དུས་ནས་ཡར་འོངས་པས་ས་ཆ་གསལ་པོ་ཞིག་མི་ཤེས་པར་འདུག་ཞུས་པར།",
    "གནས་དེའི་ཤར་ཕྱོགས་སུ་དཔལ་འཁོར་ལོ་སྡོམ་པའི་གནས་རི་ཁྱད་པར་ཅན་ཞིག་འདུག་པས་གནས་ཁང་ལྷ།"
  ]
}