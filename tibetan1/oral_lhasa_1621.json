    "དེ་ལྟ་བས་ན་བསྒྲུབ་པར་བྱ་བ་སྟེ།",
    "ཡོད་པ་ལ་སོགས་པའི་རྟགས་ངེས་པ་ནི་འབྲེལ་པ་ངེས་པར་འཛིན་པ་མེད་པ་ལས་མི་རྟག་པ་ལ་སོགས་པ་ངེས་པ་མ་ཡིན་པའི་ཕྱིར་འདིར་འཁྲུལ་པར་རིགས་པ་མ་ཡིན་ནམ།",
    "ཡོད་པའི་ཁྱད་པར་བུམ་པ་ལ་སོགས་པ་ལ་སེམས་ལས་སྐྱེས་པར་གྲུབ་ཀྱི་རི་ལ་སོགས་པ་ལ་རྗེས་སུ་དཔོག་པ་ནི་རིགས་པ་མ་ཡིན་ནོ།",
    "སྔོན་པོ་ཉིད་ཙམ་མཚུངས་པ་ནི་ཁང་པ་སྐྱ་བོ་ལའང་ཡོད་པའི་ཕྱིར་རྟོགས་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "གྲོག་མཁར་ཡང་བྱས་དེས་གྲུབ་འགྱུར།",
    "གཞན་དུ་འབྲེལ་པ་ངེས་པ་མ་གཏོགས་པར་དབྱིབས་མཚུངས་པ་ལས་སེམས་ཀྱིས་བྱས་པ་ཉིད་དུ་རྗེས་སུ་དཔོག་ན།",
    "རྫ་མཁན་གྱིས་འགའ་ཞིག་ཏུ་འཇིམ་པའི་འགྱུར་བ་བུམ་པ་ལ་སོགས་པ་བྱས་པ་ན་གྲོགས་མཁར་ལ་རྫ་མཁན་གྱིས་བུམ་པ་བཞིན་བྱས་པར་དཔོག་པར་འགྱུར་ཏེ།",
    "འདི་སྙམ་དུ་དགོངས་ཏེ་གྲོག་མཁར་ལ་རྫ་མཁན་གྱིས་བསྐྱེད་པ་ཉིད་ལ་གནོད་པ་མ་མཐོང་བས་རྗེས་སུ་དཔག་པར་འགྱུར་རོ།",
    "རྫ་མཁན་གྱིས་བྱས་པ་ལས་བྱུང་བར་མ་མཐོང་བ་ཉིད་གནོད་པ་ཅན་མ་ཡིན་ནམ་ཞེ་ན།",
    "དེ་ལྟ་ན་འོ་ན་ནི་དམིགས་པར་མ་གྱུར་པའི་ལས་ཀྱིས་ཀྱང་ཇི་ལྟར་ནུས་པ་ཡིན་ཞེ་ན།",
    "འགྲོ་བ་སྣ་ཚོགས་པར་མཐོང་བའི་ཕྱིར།",
    "དེ་བཞིན་དུ་དབྱིབས་ཀྱི་ཁྱད་པར་འདིར་ཡང་ཡིན་ཏེ།",
    "སྤྱིས་ཀྱང་སྒྲུབ་པར་བྱེད་ཡིན་ན།",
    "སྤྱིས་ཀྱང་རྩོལ་བ་ལས་བྱུང་བའི་འབྲས་བུ་བྱེད་ཀྱི་ཡུལ་ལ་སྐྱོན་གང་ཡིན་པ་དེ་ནི་འབྲས་བུ་མཚུངས་པར་འདོད་དོ།",
    "ཐ་དད་པར་བརྗོད་པའི་སྐྱོན་ཏེ།",
    "ཐ་དད་པར་བརྗོད་པ་ནི་བཀོད་པ་སྟེ།",
    "འོན་ཏེ་སྐྱེ་བ་ལ་གནས་པ་ཡིན་ཞེས་འབྲེལ་པ་ཅན་ཐ་དད་པ་ལས་ཐ་དད་པར་བརྗོད་པའི་སྐྱོན་གང་ཡིན་པ་དེ་ནི།",
    "འབྲས་བུ་མཚུངས་པར་འདོད་ཀྱི་ཡང་དག་པའི་སྐྱོན་ནི་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་ཡང་རྟག་པ་དང་འགལ་བའི་རྩོལ་བ་ལས་བྱུང་བ་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ལེའུ་བཞི་པ་ལས་རྟོགས་པར་བྱའོ།",
    "གལ་ཏེ་བློ་སྔོན་དུ་བྱེད་པའི་རྗེས་སུ་འགྲོ་བའི་ཤེས་པ་ཡོད་པ་ནི་མ་ཡིན་པ་དེ་ལྟ་ན་ཡང་དབྱིབས་ཀྱི་སྒྲ་བརྗོད་པར་བྱ་བ་ཉིད་ཀྱི་རྗེས་སུ་འགྲོ་བ་ཉིད་དེ།",
    "ཚིག་ལ་ཐ་མི་དད་པར་དཔག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ལྗོན་ཤིང་ལ་སོགས་པ་དང་མཚན་ཉིད་མི་མཐུན་པ་ལ་སེམས་དང་ལྡན་པར་གྲུབ་ཀྱང་དབྱིབས་ཀྱི་སྒྲ་མཚུངས་པར་མཐོང་བ་ལས་རི་ལ་སོགས་པ་ལས་སེམས་སྒྲུབ་བྱེད་གྲུབ་པ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་འདིས་ནི་རྗོད་པར་བྱེད་པ་ནི་རྟགས་མ་ཡིན་པར་བསྟན་ཏེ།",
    "སྒྲ་ཡང་དབྱིབས་ཀྱི་ཁྱད་པར་ལས་ཐ་དད་པའི་རི་ལ་སོགས་པ་ལ་ཇི་ལྟར་འཇུག་སྟེ།",
    "དེས་ན་སྒྲ་ལས་དབྱིབས་ཀྱི་ཁྱད་པར་གྲུབ་པ་མ་ཡིན་ནམ།",
    "དེ་ལྟ་བས་ན་སེམས་ཀྱིས་བྱས་པ་ཉིད་དོ་སྙམ་དུ་སེམས་ན་དེའི་ཕྱིར།",
    "རྗོད་པར་འདོད་པ་གཞན་ལ་རག་ལས་པའི་ཕྱིར་སྒྲ་གང་ལ་མེད་པ་ཡིན་ཏེ་ཐམས་ཅད་ལ་ཡོད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྒྲ་དེའི་དོན་འགྲུབ་ན་ནི་སུ་ཡང་ཕོངས་པར་མི་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་ལས་སྒྲུབ་བྱེད་མ་གྲུབ་པ་དེས་ནི་བརྗོད་པ་མཚུངས་པའི་ཕྱིར་ཞེས་རྟགས་མེད་པ་དེ་མ་ཐག་པར་བསྟན་པས་སེར་སྐྱ་ལ་སོགས་པ་སྟེ།",
    "མི་རྟག་པ་ལ་སོགས་པའི་སྒྲས་བྱས་པ་ཉིད་བསྟན་པ་ཡིན་ཏེ།",
    "འཆི་བ་ལ་སོགས་པ་ལས་སེམས་དང་ལྡན་པར་དཔྱོད་པར་བྱེད་དོ།",
    "གཅེར་བུ་པ་ནི་ཤུན་ལྤགས་ཐམས་ཅད་བཤུས་པས་འཆི་བའི་རྟགས་ལས་ཤིང་རྣམས་སེམས་ཡོད་པར་རོ།",
    "ཇི་ལྟར་སེམས་དང་མི་ལྡན་པ་ལ་རྟགས་མེད་པ་དེ་བཞིན་དུ་བསྟན་པར་བྱའོ།",
    "འོ་ན་ནི་བྱས་པ་ཉིད་ཀྱང་རྟགས་མ་ཡིན་པར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "དེ་ལ་ཡང་ཐ་དད་པར་རྟོགས་པ་ལས་འདི་ཅི་སྟེ་མེད་པ་སྐྱེད་པ་ཡིན་ནམ།",
    "མ་གྲུབ་པས་བྱས་པ་ནི་རྟགས་མ་ཡིན་ནོ་ཞེ་ན།",
    "ཁྱད་པར་གནོད་པ་ཅན་མིན་ཏེ།",
    "བྱས་པ་ཉིད་ལ་སོགས་པའི་སྒྲུབ་བྱེད་གྲུབ་ན།",
    "ཁྱད་པར་མེད་པ་སྐྱེད་པའམ།",
    "ཡོད་པ་གསལ་བ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རྣམ་པ་ནི་ཁྱད་པར་གྱིས་གནོད་པ་ཅན་ལ་མ་གྲུབ་པ་ཡིན་ནོ།",
    "ཡོད་པ་ཉིད་གསལ་བ་ལས་ཁྱད་པར་སེམས་པ་ནི་མཁོ་བ་མ་ཡིན་ནོ།",
    "མི་རྟག་པ་ཉིད་མ་རྟོགས་པར་རྣམ་པ་ཐམས་ཅད་དུ་ནམ་ཡང་དམིགས་པ་མ་ཡིན་པའི་ཕྱིར་བྱས་པ་ནི་རྟོགས་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡང་རྟག་པ་ལ་གསལ་བ་མི་སྲིད་པས་གདོན་མི་ཟ་བར་བྱས་པ་ཉིད་གོ་བར་བྱེད་པར་འགྱུར་ཏེ།",
    "གྲངས་ཅན་གྱི་གསལ་བ་ཉིད་བྱས་པའི་སྒྲར་བརྗོད་པའི་ཕྱིར་རོ།",
    "དཔེར་ན་སྒྲ་རྣ་བའི་གཟུང་བྱ་ནི་ནམ་མཁའི་ཡོན་ཏན་དུ་མ་གྲུབ་པ་ལས་མ་གྲུབ་པར་འདྲེན་པ་ནི་མ་ཡིན་ནོ།",
    "གྲངས་ཅན་ལ་བྱས་པ་ཉིད་བརྗོད་པ་ལས་མེད་པ་བསྐྱེད་པ་ནི་གང་དུ་ཡང་མ་གྲུབ་པ་མ་ཡིན་ནམ།",
    "དེ་བས་ན་རྗོད་བྱེད་མ་གྲུབ་པས་གཞན་དོན་གྱི་རྗེས་སུ་དཔག་པར་ཇི་ལྟར་རིགས་ཤེ་ན།",
    "གྲུབ་ན་གྲུབ་པར་འགྱུར་ཏེ་དཔེར།",
    "རྗོད་པར་བྱེད་པ་ངེས་པ་མེད་ཀྱང་དངོས་པོ་ལ་རྟགས་ཀྱི་མཚན་ཉིད་གསལ་བྱེད་མི་རྟག་པ་ལ་གྲུབ་པ་ཡིན་ཏེ།",
    "འགལ་བས་སྐྱོན་དང་ལྡན་པའི་སྒྲུབ་བྱེད་དུ་ཤེས་པར་བྱ་བའི་སྒྲ་ལ་མ་ཡིན་ཏེ།",
    "དེ་དང་བྲལ་ན་གོ་བར་བྱེད་པ་མ་ཡིན་པས་དོན་ལ་བརྟེན་པ་ཉིད་ཀྱིས་སྐྱོན་དུ་རྣམ་པར་གཞག་པར་བྱའོ།",
    "ཡང་ན་སྒྲ་རྣམས་འཁྲུལ་པ་མེད་པར་གྲགས་པ་ཡིན་དུ་ཆུག་ན་ཡང་འཁྲུལ་པ་མེད་པའི་སྒྲ་ནི་དངོས་པོ་དང་བྲལ་ན་སྒྲུབ་བྱེད་སྐྱོན་ཅན་ནོ།",
    "འོ་ན་ནི་མ་འཁྲུལ་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "གྲགས་པའི་ཁྱད་པར་ཅན་གྱི་ཡུལ་ལ་ངེས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བས་ན་རྟོགས་པར་འདོད་པས་འཁྲུལ་པ་མེད་པ་ཉིད་ཡིན་པ་དེ་ལྟ་ན་ཡང་འབྲེལ་པའི་རྒྱུ་དང་བྲལ་བའི་ཕྱིར་སྒྲ་རྣམས་གོ་བར་བྱེད་པ་མ་ཡིན་ནོ།",
    "འདིར་ཡང་གཏན་ཚིགས་ཀྱི་དོན་གླང་པོ་ཆེ་དང་འབྲེལ་པ་ལ་བརྗོད་པར་འདོད་དོ།",
    "སྒྲ་ནི་གླང་པོ་ཆེ་ལ་འཇུག་པར་གྲགས་ཏེ།",
    "སྲོག་ཆགས་རྣམས་སྡུག་བསྔལ་ལ་འཇུག་པར་འདོད་པ་ནི་མེད་དོ།",
    "སྡུག་བསྔལ་ལ་སྐུལ་ཞིང་འགྱིགས་པ་ལ་འཇུག་པར་བྱེད་པ་ཡིན།",
    "རང་བཞིན་ཐ་དད་མེད་པར་ནི།",
    "ནུས་པ་ཉིད་ནི་རྟོགས་པར་དཀའ།",
    "གལ་ཏེ་རྫ་མཁན་གྱིས་བྱས་པའི་དབྱིབས་ལ་སོགས་པའི་ཁྱད་པར་བཞིན།",
    "འབྲས་བུའི་དུས་སུ་རང་བཞིན་གྱིས་ཐ་དད་པར་བལྟ་སྟེ།",
    "འོན་ཀྱང་རྟག་པ་དང་ཁྱབ་པས་འབྲས་བུའི་ཡུལ་དུ་ཉེ་བར་བྱེད་པར་ནུས་པ་ཡིན་ནོ།",
    "རྒྱུ་རྣམས་ཐུག་པ་མེད་པར་འགྱུར།",
    "ཡོད་པར་འགྱུར་བ་ཉིད་དེ་མེད་ན་ནི་མ་བྱུང་བ་ཡིན་ནོ།",
    "དེ་རྒྱུ་ཉིད་མྱུ་གུའི་རྒྱུ་ཡིན་པར་རྟོག་ན་ནི་མཐའ་མེད་པར་འགྱུར་བ་དེ་ལྟར་ན་སོ་སོར་ངེས་པའི་རྒྱུ་ཉིད་ངེས་པ་མ་ཡིན་ནོ།",
    "རྒྱུ་ཡིན་ལེགས་པར་སྦྱངས་པ་ན།",
    "དེ་ཡི་ཁྱད་པར་མཐོང་ཕྱིར་རོ།",
