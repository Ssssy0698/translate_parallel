    "ཡང་ན་རང་གི་ལོ་དང་ཟླ་བ་རྩིས་པའི་ཆ་ག་ནི་བཅུ་པ།",
    "སྣང་བ་འདི་ལ་རྐྱེན་གྱིས་ཉོན་མོངས་བར་འགྱུར་བ་ནི།",
    "སྟན་ཐོག་གཅིག་དུ་འདུག་ལ་བརྒྱ་དང་ཉི་ཤུ་སོང་བའི་རྗེས་ལ་ཤེས་ཀྱི་འགྱུ་བ་གཅིག་ཡོད་ལ་དེ་ནས་ལྔ་བརྒྱའི་བར་ལ་ལས་དང་ཉོན་མོངས་པ་འབའ་ཞིག།",
    "རང་གི་དུས་ངེས་པ་ལ་རང་དང་མཐུན་པའི་དགེ་སྦྱོར་བྱས་ན།",
    "དེའི་འགྱུ་བ་ཆེན་མོའི་བརྒྱ་ཉི་ཤུ་ལ་ཕྲ་བའི་བར་དུ་རང་གཤེས་པ་བཟུང་བས།",
    "འདི་ནི་ངོ་བོ་ལས་དོ་བོ་ཉིད་འཁྲུལ་པར་སོང་སྟེ།",
    "ཡད་དག་པར་ན་འཁྲུལ་ཞེས་ཐམས་ཅད་མིང་གི་བྱེ་བྲག་དུ་མེད་ལས་མ་གཏོགས་པ་གང་ཡང་མེད་པས་ཐ་སྙད་ལྟར་ན་འཁྲུལ་པའི་ཡུལ་ལ་བཟུང་བ་དྭང་།",
    "དབྱེ་ནང་རྒྱུད་དུ་འགྱུ་བ་ཉོན་མོངས་པ་དང་བཅས་པ་ཕུལ་ལ་བརྟེན་ནས།",
    "དབྱེ་ན་ཉོན་མོངས་པ་རང་རྒྱུད་དུ་འཛིན་པ་དང་།",
    "ལུས་རེག་གི་བཟུང་བ་ཐ་དད་པ་དང་།",
    "རྣམ་དག་གི་ངོ་བོ་གཅིག་མ་ཤེས་པ་ལས་བྱུང་ཞིང་།",
    "ལྟར་བྱེ་བྲག་གིས་མཐོ་རིས་དང་།",
    "ངེསཚིག་གི་འགྱུ་བ་ལས་བརྟེན་ནས་འཇུག་པས་ན་ཡིད་ཅེས་བྱའོ།",
    "དེ་ཡང་སྟོང་པ་ཞེས་གང་གིས་ཀྱང་མ་བསྐྱེད་ཅིང་།",
    "འགྲོ་བ་རིགས་དྲུག་གི་གཟུགས་ཐདད་པ་རྣམས་ས།",
    "ཞེས་དེ་དག་གིས་ནི་ཟླལུས་ན་བཞི་པ་འཁྲུལ་པའི་མཚན་ཉིད་བསྟན་པ་ལ་ནང་དོན་བཅུར་བྱས་ནས་བསྟན་ནོ།",
    "དེ་དག་གིས་།་། ཚོ་ཚད་ནི་ཀློང་དྲུག་པའི་སྐབས་ནས་བསྟན་ནོ།",
    "དགི་ནང་དོན་དྲུག་པ་སྟོང་པའི་ཚད་བསྟན་པའི།",
    "ད་ནི་བདུན་པ་རྣམ་རྟོག་ཟད་པའིཚད་བསྟན་པ་ནི་སྐྱེདས་ལུགས་དེ་ལྟར་ཕྱི་ནང་གི་རྣམ་པར་རྟོག་པ་ཟད་པ་དང་།",
    "བཅུ་པ་འབྲས་བུ་བསྟན་པ་དང་འབྲས་བུའི་ཝ་མ་ཚིག་བཞི་གཞུང་གིས་ཤེས་སོ།",
    "མིང་གི་ལ་སོགས་པ་ཚིག་བཞི་གཞུང་གསལ་ལོ།",
    "ཡིང་གི་རྒྱུའིཚིག་གསུམ་གཞུང་གིས་ཤེས་སོ།",
    "དེ་ལ་མིང་གི་ཡི་གེ་དང་པོ་དང་།",
    "དེ་ཡང་སྲོག་གི་གནས་པར་བྱེད་ན་ཐོག་མས་བསྒྱུར།",
    "སྤེལ་ན་ཐལ་ནས་བསྒྱུར་བ་ནི།",
    "ད་ནི་ལྔ་པ་མིང་གི་མཐའ་ལ་བརྟེན་ནས་འགོ་བའི་ལས་ཀྱི་འགྱུར་བྱེད་བསྟན་པ་ནི།",
    "དེ་ལྟར་མིང་གི་ཡི་གེ་དང་སོ་སོའི་འབྱུང་གསང་གས་འཇིག་པའི་རྟེན་ཅིང་འབྲེལ་པ་བྱའོ།",
    "དེ་དག་གིསཤེས་པར་བྱའོ།",
    "ཞེས་དྲུག་པ་མིང་གི་ཡི་གེ་དང་པོ་ལ་བརྟེན་ནས།",
    "མིང་གི་ཡི་གེ་།་། མཐའི་མགོ་ལ་གསད་པ་དང་སྦྱར།",
    "དེ་དག་གིས་ནི་ལུས་དོན་བདུན་པ་མིང་གི་མཚན་ཉིད་ཀྱི་༤བྱེད་པ་བསྟན་པ་ལ་བཅུར་བྱས་ནས་བསྟན་ནོ།",
    "ང་ཡི་བསྟན་པ་ལ་ཡན་ལག་གི་དོན་བཅུས་བསྟན་པའི་དང་པ།",
    "དེ་ཡང་ཁམས་གསུམ་དུ་འཇུག་པ་ཡང་ཉུང་གིས་བྱེད་ཅིང་དེ་དག་ལས་འཐོན་པ་ཡོད།",
    "ཤེས་པ་ཡད་དུམ་བུ་དུམ་བུར་སོང་སྟེ།",
    "༥ས་བམསམ་༣ བ་ཚུལ་ནི་ཚིག་གསུམ་གཞུང་གིས་ཤེས་སོ།",
    "དབུད་པ་རིགས་གསུམ་ལས་འགྲོ་ས་མེད་དོ།",
    "འབའཁྲིད་ཐ་མ་གསུམ་བཞག་ནས་དོན་གྱིས་ཉེར་གཅིག་གིས་ཐམ་བདུན་ལ།"
  ]
}