    "གྱ་ནོམ་པ་བཞིས་བྱུང་ཚོར་ཐ་དད་པའི་ལས་ཀ་ལ་དྲོད།",
    "དེ་ཡང་བན་བཅུ་དེ་ཡང་ཕོ་མོ་གཉིས་བསྡུའོ།་།",
    "རང་དང་ཞེསཾ་པོས་ལྗང་གིས་འཁྲུལ་པའི་དུས་རྩི་བའི་མིང་དང་།",
    "མོ་རལ་པ་ལས་བྱུང་བའོ།",
    "རང་གི་སྣང་བ་ལས་རང་བཞིན་མེད་པར་ཤེས་པས།",
    "གཉིས་སྣང་གི་ཞེ་བ་ལས་གྲོལ་བའོ།",
    "བློ་དང་ཐ་སྙད་གང་གིས་ཀྱང་བསྒྱུར་དུ་བབ་པ་མེད་དེ།",
    "ནང་གི་ཡུལ་དབྱིངསརྣམ་པར་དག་པའི་སྒྲོན་མེ་འོད་དང་འོད་ཁྱིམ་གྱི་ནང་དུ།",
    "ད་ནི་ནང་དོན་བདུན་པ་གྲོལ་བརང་གི་མཚན་ཉིད་བསྟན་པའི།",
    "ཞེས་ནང་དོན་བདུནཔ་གྱོལ་པ་རང་གི་མཆན་ཉིད་བསྟན་ནས།",
    "གཉིས་དུ་ཀའི་མཐའ་ལས་གྲོལ་བས་ངོ་བོ་འང་གིས་ཀྱང་གཏན་ལ་མི་ཕེབས།",
    "དེ་ལྟ་བུའི་དོན་དེ་རིག་པ་མཆོག་གིས་ལས་དྲངས་ནས།",
    "ངུ་ལས་བ་གི་བྱུང་སྙམ་པའི་སྐུམ་བྱེད་ལས་ཁ་དོག་ལྔའི་གདང་ཤིན་ཏུ་གསལ་བ་ལ་རྟོག་ཅིང་འཛིན་པ་ཁ་ཕྱིར་བལྟས་པ་ལས་འོད་ཀྱི་སྣང་བས་ཡིད་འཕྲོག་གེཅེས་བ་དང་།",
    "བཙམ་དུ་ནི་མཐོང་བས་འདི་ནི་མ་འཁྲུལ་པའི་རྟོག་དཔྱོད་ཀྱིས་འཁྲུལ་པར་སོང་།",
    "དེ་དག་ཀྱང་ལས་ཀྱི་ཀླུང་གིས་འགྱུ་ཞིང་འགྲོ་བ་དང་།",
    "དེ་བདུན་གྱིས་འགྱུར་པ་ལས་ལྕགས་རྔུབ་གཅིག་གི་བརྩིས་ཕྲ་རྡུལ་འཕེལ་བས་ལྕགས་ལས་བདུན་འགྱུརཆུ་རྡུལ་དུ་འཁོལ་བས་གོང་མ་ཐེ་ཤེས་ལྔའི་སྣང་བ་འོད་ལྔ་འགགས་ནས།",
    "༩ དུ་ནི་ནང་དོན་ལྔ་པ་རྡུལ་དང་རྡུལ་ཕྲན་ལས་འགྲོ་བའི་ལུས་ཀྱི་ཚུལ་བསྟན་པགི།",
    "འགྲོ་བ་གཅིག་གིས་ལུས་ལ་རྡུལ་ཕྲ་རབ་འདིཙགཅིག་ཡོད་བྱ་བ་འབྱུང་རྩིས་ཀྱིས་གཏན་ལ་ཕེབས་སུ་འད་དོ།",
    "ཚོར་བ་བདེ་སྡུག་གི་འཁོར་ལོ་ལས་གྲུབ།",
    "དེ་ཡང་ལུས་གྲུབ་པས་ཉོན་མོངས་བས་གྲུབ་སྟེ།",
    "འདི་དག་གིས་ཤས་ཀྱི་ཁྱད་པར་གྱི་ལས་བྱེ་བྲག་ཀྱང་དེ་ཙམ་ཞིག་དུ་འགྱུར་བའོ།",
    "དེས་ན་ད་ལྟ་སྣོད་སྦྱངས་པའི་མན་ངག་གི་བདུ་ཟབ་བོ།",
    "ཞེས་དེ་དག་གིས་ནི་ལུས་དོན་བཞི་པ།",
    "ལུས་བསྐྱེད་པའི་ས་ཞེས་འདྲ་གི་ངོ་བོའི་བཞུགས་ཚུལ་བསྟན་པ་ནི།",
    "ད་ནི་ནང་དོན་ལྔ་པ་དེ་དག་གི་གནས་པ་དངོས་བསྟན་བཞི།",
    "ཡེ་ཤེས་རྣམ་པར་དག་པའི་སྣང་བ་བདག་ཉིད་ཀྱི་དམིག་གིས་མཐོང་བས།",
    "རྩ་གཉིད་ལོགའང་གི་འཐེབ་འཛུབ་ཀྱིས་དཀྲུགས་པས་གྲུབ་བོ།",
    "ཉིན་ཞག་ཕྲུག་གཅིག་ལ་ཟུང་གི་འགྲོ་འོང་།",
    "རིག་པ་སྒྲོན་མ་ལ་གཏད་ཕུང་པོ་དང་ཁམས་བྱེར་ནས་རྩིག་ཁུང་དུ་སོང་བ་སྙམ།",
    "ཞེས་དེ་དག་གིས་ནི་ལུས་རྣམ་པར་བཞག་པ་ལྔ་པ་ལུས་ལ་རིག་བའི་ཤེས་ཇི་ལྟར་གནས་པའི་ས་བསྟན་པ་ལ་ནང་དོན་བཅུར་བྱས་ནས་བསྟན་ནོ།",
    "དོན་དམ་ཀུན་རྫོབ་ཀྱི་ལས་ཐུན་མོང་དུ་བྱེད་པའོ།",
    "ཞེས་ནང་དོན་ལྔ་པ་དེ་ཉིད་ཀྱི་མན་ངག་གི་རྩྭ་ལ་བརྟེན་པའི་ཡེ་ཤེས་ཛིལྟར་བསྐྱེ་བའི་རིམ་པ་བསྟན་ནས།",
    "འདིའི་དུས་ན་སེམས་ཀྱི་བདག་པོ་ནི་ཕྱི་ནང་གི་གཟུགས་ཅན་གཟུགས་མེད་དེ་གང་སྣང་ལ་ཡིད་གཏད་པས་རྣམད་ཤེས་བརྩོན་དུ་བཟུང་བ་ཞེས་བྱའོ།",
    "ཞེས་དེ་དག་གིས་མི་ལུས་རྣམ་པར་བཞག་པ་དྲུག་པ་རིག་པ་ཡེ་ཤེས་ཀྱིས་ལས་དྲིས་ལན་རྒྱས་པར་བསྟན་བ་ལ།",
    "དམིག་གི་མཚན་ཉིད་དབྱེ་བ་དང་བཅས་པ་བསྟན་པ་ནི།",
    "ཉོན་མོངས་པ་གསུམ་གྱིས་བཅིངས་པས།",
    "ཞེས་ནང་དོན་བརྒྱད་པ་ཤེས་རབ་རང་བྱུང་གི་སྒྲོན་མ་རྒྱས་སྦྲ་བ་བསྟན་ནས།",
    "ད་ནི་ནང་དོན་བཅུ་པདེ་དག་གི་འཇུག་བསྡུད་པ་ཚིག་གསུམ་གཞུང་གསལ།",
    "དེ་བྱ་༧ ཡང་དད་པ་དང་ལྡན་པ་ཞིག་གིས།",
    "དེ་ཡང་དང་པོ་ཐོས་པས་རང་གི་མིཤེས་པ་བསམ་ནས་ཤེས་པར་རྒྱུད་སྦྱངས།",
    "པ་དེ་ཡུན་དུ་བསྲིང་ལ་ཐང་གིས་དུས་ཐོམས་ཅད་བསྒོམས་པས།",
    "བསམ་པའི་རྒྱུན་དག་ཟླནས་གང་ལས་བསམ་དང་མདུད་ཁུང་གི་སྒྲོན་མེ་ལྟར་འགྱུར་རོ།",
    "ཨ་ལེ་དང་ཀ་ལི་ལ་འབུམ་ཕྲག་གཅིག་བཟླས་ནས་བསྒོམས་ཉམས་སུ་མྱོང་བ་ཐུན་མོང་མ་ཡིན་པ་སྐྱེ་བར་ངེས་སོ།",
    "དེ་ཡང་དད་པ་དང་ལྡན་པ་ཞིག་གིས།",
    "ཨི་མི་རྒྱུ་ཀའི་གནས་སུ་སོང་སྟེ།",
    "མིག་གིས་ཕུག་པ་དང་།",
    "རང་གི་འཐེབ་མོ་དང་།",
    "ལུས་ཟང་ཐལ་དུ་མཐོང་བ་དང་།",
    "ཆུ་ནང་གི་ཟླ་བ་ལྟར་མཐོང་བ་ལ་སོགས་པའི་དུས་ན།",
    "དགི་ནང་དོན་བཞི་པ་རྒྱང་ཞགསགི་སྒྲོན་མའི་མཚན་ཉིད་བསྟན་པ་ནི།",
    "དེ་ཡང་མིག་གིས་གཟུགས་འཛིན་པས་སའི་ངོ་བོ་ས་ཉིད་ཡིན་། བ་ཁམཁ།",
    "ཕྱི་ནང་གི་བྱེ་བྲག་ཤེས་པས་མེའི་རྒྱུ།",
    "དེ་བསྡུས་པའི་དགོས་པ་ཉོན་མོངས་པའི་དགོས་པ་ཚོངལྔའི་སྒྲིབ་པ་དང་ལས་ཀྱིས་བསགས་པ་རྣམ་སྨིན་གྱི་སྒྲིབ་པ་དང་།",
    "སྤྲེས་དང་ནི་འོད་ཀྱི་དཀྱིལ་འཁོར་རེས་གྱེན་འགྲེང་དང་།",
    "དོན་དགུ་པ་སྒྲོན་མ་དེ་དག་གི་སྣང་བ་བསྟན་པ་ནི།",
    "ཞེས་དེ་དག་གིས་ནི་ལུས་དོན་དགུ་པ་སྒྲོན་མའི་མཚན་ཉིད་བསྟན་པ་ལ་བཅུའི་བྱས་ནས་བསྟན་ཝ་གསཁམས་ཅན་སམ་ནོ།",
    "ཡེ་ཤེསཀྱི་ཀླུང་གིས་བསྐྱོད་པས།",
    "ཞེས་ནང་དོན་བཞི་པ་བྱེ་བྲག་དུ་རྒྱང་ཞགས་གི་སྒྲོན་མའི་ཕུལ་བསྟན་ནས།་།",
    "ཀྱང་མ་གྲོལ་ན་ཐ་མ་ཚིག་གིས་བརྗོད་བར་བྱའོ།",
    "དེ་ཡང་ཁ་དོག་གི་མཚན་ཉིད་ནི་གསལ་དང་ཞེས་ངའ་དཀར་པོ་དང་།",
    "ད་ནི་ནང་དོན་བཅུ་པ་དེ་དག་གི་འཇུག་བསྡུ་བ་དང་བཅས་པ་བསྟན་བནི།",
    "ཤེས་རབ་རང་བྱུང་གི་སྒྲོན་མ་དང་།",
    "དེ་དག་གཉིས་ཀྱི་བྱེ་བྲག་གིས་དགའ་བས་སྐུ་གསུམ་དུ་འཚོགས་པ་དང་།",
    "དེལིརྟེན་པ་ནི་རང་གི་སྨིན་མཚམས་ཀྱི་མཛོད་སྤུ།",
    "ཞེས་ནང་དོན་དྲུག་པ་བརྟེན་པ་རང་གི་ངོ་བོ་བསྟན་ནས།་།",
    "གཏི་མུག་གིས་བཅིངས་པ་ལས་འདས་པའི་འདུན་པ་སྐུ་གསུམ་ལ་རང་རྒྱུད་ཀྱིས་བཅིངས་པ་རྣམས་འཇིག་པར་བྱེད་པའོ།",
    "རྣལ་འབྱོར་པ་གང་གིས་རིག་པའི་མེ་ཏོག་མཛེས་པའི་ཕྱིར་ཡུལ་གྱིས་ནམ་མཁའ་ལ།",
    "འགྲོ་བའི་བློ་ཆེ་ཆུང་གི་ཁྱད་པར་ཀྱང་དེ་ཙམ་ཞིག་དུ་བྱུང་བའོ།",
    "མོའིལྕི་ཞིང་ཚིག་ལ་མི་དགའ་དོན་ལ་གཅོདམེ་པོའི་ཚིག་ལ་ཟིན་ཅིང་དོན་ལ་མཆེད་པ་དཀའ།",
    "མོ་འགྱུར་ལྡོག་མང་ལ་ཐམས་ཅདའཇུག་པའབྱེད་པ་སྟེ།",
    "མ་གིང་སྟོང་པས་ཐ་མ་སྟེ་གསུམ།",
    "དེ་ཉིད་རང་གིས་ལུས་སུ་སྨིན་ནོ།",
    "ཆུའི་ལུས་སུ་སྨིན་པའི་ལུས་ཡིན་ན་རང་གིས་དུས་ངེས་པ་དང་།",
    "དེ་དག་གིས་རྩིས་ཀྱིས་ཟིན་པར་བྱས་ན།",
    "བསྒོམ་ན་ཉམས་སུ་མྱོང་བ་ཐུན་མོང་མ་ཡིན་པ་སྐྱེ་བ།",
    "ཞེས་དེ་དག་གིས་ནི་ལུས་རྣམ་པར་བཞག་པ།",
    "དེའང་དད་པ་དང་ལྡན་པ་ཞིག་གིས།",
    "དེ་ནས་རབ་ཏུ་དབེན་པའི་ས་ཕྱོགས་སུ་སོང་།",
    "གཟུགས་ཀྱི་ཁ་དོག་ནི་རས་ཡུག་ལ་སོགས་པ་སྔོན་པོའི་རྣམ་པ་རང་གིས་མདུན་དུ་བཏིང་ལ།",
    "ཁྲ་བོ་ལ་སོགས་པར་རང་མོས་པ་ལ་བྱས་ལ།",
    "འ་། ཉིད་བདེ་ཆེན་དུ་འབར་བ་ལ་སོགས་བའི་ཉམས་སུ་མྱོང་བ་ཐུན་མོང་མ་ཡིན་པ་འབྱུང་ངོ།",
    "རིང་དུ་འཕེན་པར་བྱེད་པ་ཐངཤིང་གི་རྩེ་མོ་ལ་སོགས་པ་བཟོ་དུ་མ་ལ་བརྟེན་ནས་རིག་པའི་རྩལ་སྦྱངས་གཞན་ནས་བསྟན་ནས་ཡོད་དོ།",
    "ལག་གི་འདུ་བྱེད་དང་།",
    "དེ་ལྟར་ཐ་དད་པ་དང་རང་གི་རིག་པ་བསྲེས་ནས་སྦྱངས་པས།",
    "ཡང་དད་པ་དང་ལྡན་པ་ཞིག་གིས།",
    "རྡོ་རྗེ་མཁའ་འགྲོ་མ་ལ་སོགས་པ་མགུ་བར་བྱ་བའི་དོན་དུ་ཚོགས་ཀྱི་འཁོར་ལེ་བྱ་བ་རྣམས་རང་གི་འབྱོར་པ་།",
    "ལེགས་པར་བསྒོམ་མོ།",
    "དེལྟར་ཡུན་ཐུང་བ་ལ་ཐུན་མོང་དུ་བྱའོ།",
    "འང་གི་རྣལ་འབྱོར་བརྒྱད་མན་ངག་ཞུས་ལ།",
    "བར་བུཟན་ཁམརེ་ཟ་ཡུན་ཙམ་དུ་བཞག་གོ།",
