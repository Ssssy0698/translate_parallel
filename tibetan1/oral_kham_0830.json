    "སྟན་ལ་འདུག་ཏུ་རུང་ངམ་ཞེས་དྲིས་ཏེ་འདུག་པར་བྱ།",
    "འཆར་བསམ་བརྟགས་པར་འདུག་སྟེ་ཤི་བ་ལས་བཅས།",
    "ཚིག་པ་ཟོས་ནས་ཁྲི་བཅག་སྙམ་སྟེ་ལྗིད་ཀྱིས་མནན་ཅིང་དྲག་ཏུ་འདུག་པ་དང་ནང་དུ་ལྟེམས་ཞེས་བྱིང་ནས་ཕྱེ་དང་ཞོ་ཡང་ཐོང་ཀར་བོའོ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བསླབ་པར་བྱ།",
    "ཁྱིམ་པ་འདུག་པར་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ།",
    "བཞོན་པའི་སྟེང་དུ་འདུག་པ་དང་།",
    "མ་དང་རང་སེམས་གཉིས་མེད་དོ།",
    "དེ་རྣམས་ཀྱང་རང་བཞིན་མེད་པ་ཉིད་ཀྱི་ཕྱིར།",
    "ཡང་རང་བཞིན་དང་དམིགས་པ་དང་ལྡན་པ་དང་རྒྱུ་ཡོངས་སུ་འཛིན་པ་རྣམས་ལ་ཡང་ཐམས་ཅད་དུ་གཞིའི་སྒྲ་ནི་རང་བཞིན་གྱི་ཚིག་ཉིད་དོ།",
    "ལས་དང་རང་བཞིན་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན་བྱེད་པ་ལ་བལྟོས་པ་དང་དེ་བཞིན་དུ་ལས་ཀྱི་ཀུན་སྤྱོད་རྫས་འཛིན་པ་ལ་བལྟོས་པ་ན།",
    "ལུས་དང་གཟུགས་ཀྱང་རང་དང་འོག་མའི་ས་པའོ།",
    "མཱ་ཏྲཱ་དྱ་བྷི་ག་མེ་ཙ་ནཱ་ཏི་གུ་རུ་མཱ་ཏྲི་མ།",
    "དུས་གཞན་གྱི་བར་དུ་འདུག་པའི་ཞེས་བྱ་བ་ལ།",
    "གནས་པའི་ངང་ཚུལ་ནི་འདུག་པའོ།",
    "བ་ཙ་ན་མི་གཅིག་ཅེས་བྱ་བ།",
    "འདི་དག་སོ་སོ་སྐྱེ་བོ་ཞེས་བྱ་བའི་རྣམ་པར་གཞག་པ་མེད་པ་སོ་ན་འདུག་གོ།",
    "ཉན་ཐོས་ལ་སོགས་པ་རྣམས་འཕགས་པ་མ་ཡིན་པ་ཉིད་ཀྱི་ཉེས་པ་ནི་འདི་ན་ཡང་སོ་ན་འདུག་པ་ཉིད་དོ།",
    "སྤྱོད་པ་དང་རང་བཞིན་མཚུངས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གཉིས་པའི་ནི་གཞན་གྱིས་གསོད་པ་ཁོ་ནར་འགྱུར་གྱི་བདག་ཉིད་འཆི་མི་འགྱུར་བ་སྟེ་མངལ་ན་འདུག་པ་ནུར་ནུར་པོ་དང་།",
    "རྐང་ལག་འགྱུས་པའི་གནས་སྐབས་ན་འདུག་པ་དང་།",
    "སྒོ་ང་ན་འདུག་པ་རྣམས་ལ་བདག་ཉིད་འཆི་བ་མེད་པའི་ཕྱིར་རོ།",
    "སེམས་ཀྱི་རྗེས་འཇུག་དུས་དང་ནི།",
    "དངོས་པོ་ཡང་རང་བཞིན་གྱིས་རྟག་ཏུ་མི་བསྒྲིབས་པས་སོ།",
    "རྣམ་པར་སྨིན་པ་དག་དུས་ཡོངས་སུ་ཆད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་ཡུལ་དང་དུས་དང་རང་བཞིན་སོ་སོར་ངེས་པ་ཡིན་པར་ཡང་མི་འགྱུར་ཏེ།",
    "གཟུགས་ཅན་རྣམས་ལ་འགྲོ་བ་དང་འདུག་པ་ལ་སོགས་པ་ཡོད་པའི་ཕྱིར་སྤྱོད་ལམ་པ་ཡོད་དོ།",
    "ཉི་མ་ལ་འདུག་པ་ལ་གྲིབ་མ་སྣང་ན།",
    "འདི་ལྟར་གལ་ཏེ་རལ་གྲི་བསགས་ཀར་བསྙལ་ཏེ་འདུག་པ་ཡིན་ན་ནི་གཟུགས་བརྙན་ཡང་བསགས་ཀར་རིང་བར་སྣང་ལ།",
    "གལ་ཏེ་གྱེན་ལ་འགྲེང་སྟེ་འདུག་པ་ཡིན་ན་ནི་གཟུགས་བརྙན་ཡང་དེ་ལྟར་སྣང་ངོ།",
    "གང་ཞིག་དུས་དང་སྐྱེ་བ་ངེས་པས་ཡུལ་མ་ངེས་པར་འཕེན་པ་དེ་ནི་དེ་ལས་གཞན་པའི་ཡུལ་དང་སྐྱེ་བ་དེར་སྐྱེའོ།",
    "འདི་ལྟར་ཛམྦུའི་ཚལ་ན་འདུག་པ་མ་གཏོགས་པའི་ཕྱི་རོལ་པ་རྣམས་ལས་ཞེས་བྱ་བ་རྒྱས་པར་འབྱུང་ངོ།",
    "འོ་མ་བསྐོལ་བ་སྤྲིས་མ་ཆགས་པ་ཞེས་བྱ་བ་ནི་ཞུ་བ་དང་འཐས་པའི་ངོ་བོར་འདུག་པའི་ཕྱིར་རོ།",
    "རྣམ་ཕྱེ་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཕྱེ་ནས་འདུག་པའོ།",
    "དེའི་རྡུལ་ཕྲ་རབ་རྣམས་ཕྲད་པ་ལ་མ་གཏོགས་པར་ཅུང་ཟད་ཀྱང་མེད་དོ་ཞེས་བྱ་བ་ནི་མྱུ་གུ་ལ་སོགས་པའི་རྡུལ་ཕྲ་རབ་མ་མཐོང་བས་བསྐུལ་བ་རྣམས་ས་བོན་གྱི་ཡུལ་དུ་ཉེ་བར་འདུག་སྟེ།",
    "དེ་དུས་ཀྱི་བྱ་རོག་དེ་ནི་དཔལ་མགོན་ཞལ་གྱི་རྣམ་འཕྲུལ་དུ་འདུག།",
    "ཟས་བསོད་པ་སློང་བ་དང་འདུག་པ་དང་འགྲེང་བ་དང་ཕྱིར་མ་བླངས་པ་སྤྱོད་པ་དང་།",
    "དབེན་པ་ན་འདུག་འགྲེང་གཉིས་ཀྱང་དགེ་སློང་མ་ལ་མ་བཞག་སྟེ།",
    "ཉལ་པོ་བྱེད་པར་བཤོམ་པའི་ཁྱིམ་ན་འདུག་འགྲེང་གཉིས་ཀྱང་མ་བཞག་སྟེ།",
    "དགེ་སློང་སྟན་ལས་འདུག་པས་དགེ་སློང་མ་དེ་འགྲེང་བས་ཧ་ཅང་ཡུན་རིང་དུ་འདའ་བར་བྱེད་ན་སྟན་ལ་འདུག་ཏུ་གཞུག་གོ།",
    "འདུག་པར་བྱ་བ་བརྒྱད་དག་དང་།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་གཞན་དང་འདྲ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ལ་བྱིན་ལེན་སྟོབས་པ་ལ་སོགས་པ་ལ་འདྲ་ཊཱིཀྐར།",
    "དེའི་ལག་ཉ་གསོག་འཇོག་ལ་སོགས་པས་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་ལག་ཉ་གསོག་འཇོག་ལ་སོགས་པར་མི་འགྱུར་བར་འདྲ།",
    "བསམ་པ་ཐག་པས་དགའ་ཞིང་རང་ཉིད་ཀྱིས།",
    "མཐར་ཐུག་ཡོད་ཀྱང་རང་བཞིན་གནས་པ་ལ་སྦྱོར་བ་མེད་པའི་ཕྱིར་རོ།",
    "འདིའི་སྦྱོར་བ་ལ་རྟེན་དེ་ལ་གང་འདུག་བསྐྱེད་དེ།",
    "ཡང་ན་འདུག་པ་སྦྱོར་བའི་སྦྱོར་བ།",
    "ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་འགྲེང་བ་ནི་ཉན་རྣ་ལས་གྱུར་པ་ཡིན་གྱི།",
    "འདུག་གནས་ཕྱེ་དང་བསོད་པ་དང་།",
    "མ་སྐོས་སོགས་དགུ་འདུག་མ་གཏོགས།",
    "འདུག་གནས་དང་ནི་གཅེར་བུའོ།",
    "ཡང་ཡང་འདུག་གནས་ཕྱེ་དང་ནི།",
    "དེ་འདུག་མ་ཐག་ཏུ་སེམས་འཇོག་སྟེ་སེམས་རྣམ་པར་འབྱེད་པར་མི་བྱེད་དོ།",
    "གཉིས་པ་ནི་སྤོང་ཁང་དེར་འདུག་པའི་ཆེད་དུ་སའི་སྟེགས་བུ་དག་དང་ཁྲིའུ་ཡང་བྱའོ།",
    "དེ་ནས་སྟན་ལ་འདུག་ལ་སྤྱི་བཤགས་ལ་ཐུགས་གཏད་པར་ཞུ་ཞེས་བརྗོད་ལ།",
    "ནམ་མཁར་ནི་མཚམས་གཞན་ཡིན་པས་ནམ་མཁའ་ལ་འདུག་པའམ་འགྲོ་བར་མི་བྱའོ།",
    "གསོ་སྦྱོང་དུ་མ་ཟད་དགག་དབྱེ་ལ་སོགས་པའི་ལས་ཀྱི་གནས་ཐམས་ཅད་དུ་འདུག་པར་བྱའོ།",
    "གལ་ཏེ་དགེ་སློང་དེ་གྲོགས་མེད་པ་གཅིག་པུ་འབའ་ཞིག་ཡིན་ན་འདུག་སྟེ་བྱིན་གྱིས་བརླབ་བོ།",
    "དགེ་སློང་ལྷག་མ་གཞན་དང་བཅས་པ་ཡིན་ན་མདུན་དུ་འདུག་སྟེ་བྱིན་གྱིས་བརླབ་བོ།",
    "སེང་གེའི་ཁྲི་ལ་སོགས་པ་ལ་འདུག་སྟེ་བསྟན་པར་བྱའོ།",
    "འདུག་བཞིན་དུ་སྨྲས་པ་མགོ་ན་ལངས་ནས་ཚིག་དང་དོན་རྣམ་པར་དབྱེ་བར་བྱའོ།",
    "དེས་ན་ནམ་མཁའ་ལ་འདུག་པ་དང་ས་ལ་འདུག་པ་དག་ལྷན་ཅིག་ལས་བྱར་མི་རུང་ངོ།",
    "ལ་ལར་འདུག་པ་དང་།",
    "ལ་༣༤༩ བ་ལར་སྔ་དྲོ་དང་གུང་ཚིགས་དང་ཕྱི་དྲོ་འདུག་པས་ལོངས་སྤྱོད་པ་དེ་ལ་སྦྱར་བར་བྱའོ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་ཕྱིར་དུས་ཐམས་ཅད་དུ་སྔར་གྱི་སྒྱུ་ཐབས་དེ་མི་བྱའོ།",
    "ཚེ་དང་ལྡན་པ་ཁོ་བོ་ཅག་ནི་ཚེ་དང་ལྡན་པས་ཅི་ནས་ཀྱང་གཞི་འཇོག་པར་བྱེད་ཅིང་གང་ཟག་འཇོག་པར་མི་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མིན་གྱི།",
    "གང་ཟག་འཇོག་པར་བྱེད་ཅིང་གཞི་འཇོག་པར་མི་བྱེད་པ་དང་གཞི་ཡང་འཇོག་པར་བྱེད་ཅིང་གང་ཟག་ཀྱང་འཇོག་པར་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་༣ ༥ ༧ན་མིན་གྱི་ཞེས་སོགས་ཀྱང་བརྗོད།",
    "དེ་དག་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་རིགས་མི་མཐུན་པའི་ཕྱིར་རོ།",
    "མར་ལྷན་ཅིག་བཞག་པ་ཐོགས་ཏེ་རྒན་རིམ་དུ་འདུག་པས་སྲ་བརྐྱང་གདིང་བ་བསྒྲུབ་པར་བྱའོ།",
    "དབྱུང་བའི་བློ་སྔོན་དུ་མ་བཏང་བར་སྲ་བརྐྱང་རང་ཉིད་བཏིང་བའི་འཇུག་པ་དང་བྲལ་བ་དང་།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་གནས་སུ་སྲ་བརྐྱང་འདིང་བ་དེ་སྤངས་པ་གནས་ཕྱུང་རྣམས་ལ་མི་འབྱུང་ངོ།",
    "ཁྱིམ་གཞན་དུ་འདུག་པ་རྣམས་བྱིན་གྱིས་མི་བརློབ་བོ།",
    "གནས་གང་ན་བྱིན་གྱིས་བརླབ་པར་བྱ་བའི་དངོས་པོ་འདུག་པ་དེའི་མཚམས་༣༦༩ ན་སུ་གཏོགས་པ་རྣམས་ཀྱིས་བྱིན་གྱིས་བརློབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "འོ་ན་མཚམས་གཉིས་ཀྱི་བར་ན་ཡོ་བྱད་འདུག་པ་ལ་སུས་བྱིན་གྱིས་བརློབ་ཅེ་ན།",
    "ལྕགས་སྡོད་ལྷས་མ་གྲུ་བཞིར་འདུག་པའོ།",
    "རྒྱ་ཆང་སྐུད་པ་མང་པོ་ལས་བཏགས་པ་དབུས་ཁོང་སྟོང་དུ་འདུག་པའོ།",
    "ཉམས་སུ་མྱོང་བ་ལས་གཞན་པའི་བྱ་བ་ལ་སྣམ་སྦྱར་བགོ་བར་མི་བྱའོ་། སྣམ་སྦྱར་དེའི་སྟེང་ལ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ།",
    "རྐྱེན་དེ་ལྟ་བུ་མེད་པར་སྣམ་སྦྱར་མ་དྲས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཡང་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "རྐྱེན་དེ་ལྟ་བུ་ཡོད་ཅིང་མུ་སྟེགས་ཅན་མེད་ན་འཇུག་པ་དང་འདུག་པར་བྱའོ།",
    "མུ་སྟེགས་ཅན་འཁོད་ན་རྐྱེན་དེ་ལྟ་བུ་ཡོད་ཀྱང་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "ལུང་དུ་ལྭ་བ་སྤུ་ཕྱིར་བསྟན་ཏེ་བྱོན་ལ་འདུག་པར་བྱ་ཞིང་ཉལ་བར་ཡང་བྱའོ།",
    "ཁྱིམ་པའི་ཁྱིམ་གཞན་དུ་སྟན་གཞན་མེད་ན་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོ།",
    "ཀོ་ལྤགས་ཀྱི་ཐགས་མ་ཡང་ཀོ་ལྤགས་ཡིན་པས་ཀོ་ལྤགས་ཀྱིས་བརྒྱུས་པའི་ཁྲི་དང་ཁྲིའུ་སོགས་ལའང་འདུག་པར་མི་བྱའོ།",
    "གཞང་འབྲུམ་ཅན་ཐམས་ཅད་ཀྱིས་ཀྱང་སྔར་བསྟན་པ་དེ་བཞིན་དུ་རྐང་པའི་གནས་སུ་གདིང་བ་དང་མཆིལ་ལྷམ་དུ་བགོ་བ་དང་འདུག་པ་དང་ཉལ་བར་བྱའོ།",
    "ཤིང་ཀན་ཙ་ན་དང་།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དང་།",
    "སྟན་གཞན་མེད་ན་རྩྭ་བམ་ལ་འདུག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་སྒྲ་སྐྱུངས་པ་དང་ཤིན་ཏུ་བསྡམས་པ་ལ་སོགས་པས་ཟན་གྱི་ཆེད་དུ་འདུག་པར་བྱའོ།",
    "ཟན་གྱི་ཕྱིར་འདུག་པས་དངོས་པོ་འདི་བྱིན་ཅིག་སྤྱི་སྤུངས་འདི་ནས་བྱིན་ཅིག་ཅེས་འབྲིམ་མཁན་ལ་གོ་བར་མི་བྱའོ།",
    "མཆིལ་མ་དེའི་སྣོད་ཆོལ་ཟངས་ནི་ཞབས་གླང་པོ་ཆེའི་རྨིག་མཐིལ་ལྟ་བུར་མཉམ་པར་འདུག་པའམ།",
    "ཆབ་ཁུང་སའི་སྒོ་སྣོལ་མར་གདོད་ཅིང་སྒོ་དྲང་པོར་མི་འདུག་པས་ནང་དུ་ཞུགས་པ་ཕྱི་རོལ་ནས་མི་སྣང་བར་བྱའོ།",
    "ཆབ་ཁུང་སར་གོས་ལེགས་པར་བརྗེས་པས་ཤེས་བཞིན་དུ་འདུག་པར་བྱའོ།",
    "ལྟོ་འཛག་པ་དེ་ལས་གཞན་པས་ནི་ཆུ་ཡོད་ན་འཐོར་འཐུང་མ་བྱས་པར་འདུག་པར་མི་བྱའོ།",
    "འདུག་པར་གཅིག་པའི་ཕྱིར་རོ།",
    "ལྷག་པོར་ཡང་གང་ཟག་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ་བྱའི་སྤྱོད་ལམ་གཞན་གྱིས་མི་བྱའོ།",
    "ཙོག་པུར་འདུག་ཏུ་མི་གཞུག་སྟེ།",
    "དབྱར་དང་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་པ་ནི་ཙོག་པུར་འདུག་སྟེ་བྱའོ།",
    "ཤིང་དྲུང་དང་ནེའུ་གསིང་ལ་སོགས་པ་འདུག་པའི་གནས་ཐམས་ཅད་ལ་རྒན་རིམ་དུ་བསྐོ་བ་རིགས་སོ།",
    "དེ་ཡང་རང་དང་ལྟ་བ་ཐ་མི་དད་པ་ལ་རིག་པར་བྱའི་ལྟ་བ་ཐ་དད་པ་ལ་རིག་པར་མི་བྱའོ།",
    "དེའི་སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དེ་དང་ལྷན་ཅིག་ཏུ་གོམ་པ་བསྲི་བ་ལས་གཞན་པ་གོམ་པ་མཉམ་དུ་འདོར་བ་དང་།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་དྲུང་དུ་སྟན་ཆེས་དམའ་བ་ལས་གཞན་པ་མཉམ་པའམ་མཐོ་བས་འདུག་པར་མི་བྱའོ།",
    "དེ་གཉིས་དགེ་སློང་རང་བཞིན་དུ་གནས་༤༣ ༥ བ་པ་དང་གཡོགས་མ་གཅིག་པའི་གནས་ཀྱི་ནང་དུ་མལ་བཤམ་པར་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ལ་བརྗོད་པ་དང་བཅས་པ་ཉིད་དང་།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ལ་གདམས་ངག་བཞག་པ་དང་གསོ་སྦྱོང་དང་དགག་དབྱེ་དང་གསོལ་བ་དང་བརྗོད་པ་དག་བཞག་པར་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་བསྟེན་ཅིང་འཇིང་བསྒྲིལ་བར་མི་བྱའོ།",
    "བར་བྱ་བ་སྤྱོད་པས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་གཡོགས་མ་གཅིག་པར་ཉལ་ན།",
    "ཐོས་ཀྱང་རང་ཡིད་མ་ཆེས་པ་ནི་གཞི་མིན་ནོ།",
    "ངལ་གསོ་ཞིང་འདའ་བར་བྱེད་པའི་གནས་གང་ན་རང་དང་མི་མཐུན་པ་དགྲ་བོ་ཡོད་པ་དེ་དང་ལྷན་ཅིག་འདུག་པ་དང་འགྲེང་བར་མི་བྱ་སྟེ།",
    "མངག་པ་བཏང་བར་ཡང་མི་བྱ་ཞིང་ཕྱོགས་གཉིས་པར་ཡང་རང་འགྲོ་བར་ཡང་མི་བྱ།",
    "ལོགས་ཤིག་ན་འདུག་ཅིག་ཅེས་ཟེར་བའོ།",
    "འདུག་པ་དང་ལྷན་ཅིག་འཆག་སར་འཆག་པ་དང་།",
    "ཁྱིམ་པའི་ཁྱིམ་གཞན་དུ་འདུག་པ་དང་།",
    "ཟས་ཟ་བའི་གྲལ་ན་འདུག་སམ་གཏོགས་ཏེ།",
    "རབ་ཏུ་བྱུང་བ་ཁྱིམ་གཞན་ན་འདུག་པ་ལ་ཡང་ཕྱག་བྱ་སྟེ།",
    "འདུག་པ་དང་ཉལ་བ་ན་འདུག་པའི་སྤྱོད་ལམ་བསྟེན།",
    "གང་དུ་འདུག་ཅེ་ན།",
    "སྟན་ཆེས་དམའ་བ་ལ་འདུག་གོ།",
    "གསར་བུས་ནི་སློབ་དཔོན་གྱིས་སྒོ་ན་འདུག་གོ།",
    "མ་བསྒོ་ན་ཙོག་པུར་འདུག་གོ།",
    "ལུང་ནོད་པར་བྱ་བ་མང་བ་ཉིད་ཡིན་ན་འདུག་པའི་ཕྱིར་ལུང་འབོག་པར་བྱེད་པ་ལ་ཞུ་བར་བྱའོ།",
    "ལུང་འབོག་པར་བྱེད་པའི་ཐོས་པའི་ཉེ་འཁོར་མ་གཏོགས་པ་སྣང་བའི་ཉེ་འཁོར་དུ་འདུག་སྟེ་ཁ་ཏོན་བྱའོ།",
    "གནས་ཁང་འདིར་འདུག་ཅེས་གནས་ཁང་བསྐོ་བ་དང་།",
    "བསྙེན་པར་རྫོགས་པའི་དུས་ལོ་གསུམ་ལས་ལྷག་པས་བར་དུ་ཆོད་པ་དང་ལྷན་ཅིག་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱ་སྟེ་གཞོན་པ་ཆེས་རྒན་པ་དང་ལྷན་ཅིག་འདུག་པ་མི་རིགས་པའི་ཕྱིར་རོ།",
    "ཁྱིམ་པ་དང་གནས་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "བསྙེན་པར་མ་རྫོགས་པ་དང་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "གནས་པར་མི་བྱ་བ་དག་དང་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "བསླབ་པ་བྱིན་པ་དང་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "ཆར་ཆད་ན་དྲུང་ན་འདུག་པའི་ཁྱིམ་དུ་གདུགས་དེ་གཏམས་ཏེ་གཞག་གོ།",
    "དགེ་སློང་མ་དེས་དབྱར་ཁང་དེའི་ཕྱིའི་སྐོར་འདུག་པར་མི་བྱའོ།",
    "སྐར་ཁུང་ལ་སོགས་པ་སྣང་ཡེལ་ཅན་དུ་འདུག་པར་མི་བྱའོ།",
    "དགེ་སློང་མ་གོས་མེད་པ་ཅན་གྱིས་ཐམས་ཅད་དུ་འདུག་པར་མི་བྱའོ།",
    "དགེ་སློང་མས་དཔུང་བ་གཉིས་གོས་ཀྱིས་མ་གཡོགས་པར་ཁྱིམ་པའི་དྲུང་དུ་འདུག་པར་མི་བྱའོ།",
    "གནས་ཁང་དུ་ཞུགས་པ་དེ་ན་སྣོད་སྤྱད་དག་བསྡུ་བསྐྱོག་མ་བྱས་པ་བརྩམ་པར་འདུག་ན་དེ་དག་གནས་ཇི་ལྟ་བ་བཞིན་དུ་བསྡུ་བསྐྱོག་བྱ་ཞིང་མཁོས་སུ་དབབ་པར་བྱའོ།",
    "རབ་འབྱོར་ངས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མ་མགྫོང་སྟེ།",
    "འདུག་གམ་ཉལ་ཡང་རུང་སྟེ།",
    "ཚེ་དང་ལྡན་པ་ཀ་ཏྱའི་བུ་ཆེན་པོའི་མདུན་དུ་འདུག་གོ།",
    "འདུགནསཚེ་དང་ལྡན་པ་ཀ་ཏྱའི་བུ་ཆེན་པོས་འདི་སྨད་ཅེས་པའོ།",
    "ཕན་ཆ་ཤིན་ཏུ་ཆེ་བར་འདུག་ཅེས་ནན་ཏན་ཆེན་པོས་ཞུ་མཆིད་ཚིགས་བཅད་ཀྱི་ལམ་ནས་སྤེལ་བ་འདི་ལྟར།",
    "སྐབས་འདིར་ཡན་ལག་བདུན་པའི་ཚིགས་སུ་བཅས་པ་མང་ཙམ་འདུག་ཀྱང་ཡི་གེ་མང་བས་མ་བྲིས།",
    "གང་སྣང་ཐམས་ཅད་ཡིག་འབྲུ་ཤིན་ཏུ་ཆེ་བ་མང་པོས་གང་ནས་ཁྲ་ཆེམ་ཆེམ་འདུག་པ་ལ།",
    "ལྡེབ་ཕྲེང་མི་ཚང་བའང་འདུག་པས་དེ་རྣམས་སྟོང་པ་མི་བཞག་ཀ་མེད་བྱུང་བ་བཅས་ལ་བརྟེན་ནས་ད་དུང་ཞུ་བཅོས་མ་ཐུབ་པ་ཤིན་ཏུ་མང་བ་དང་།",
    "ཡིག་ནོར་ཡིན་ངེས་རྣམས་དག་བཅོས་གནང་འདུག།",
    "དོགས་གཞི་ཅན་ནམ་ཐག་མ་ཆོད་པའི་ཚིག་དོན་རྣམས་མ་དཔེ་སོར་བཞག་ལས་བཅོས་མི་འདུག།",
    "འགྲོ་དྲུག་དུས་གནས་མ་ལུས་སྣང་ཞེས་པས་སོ།",
    "རས་གཙང་ཞིང་དྲི་མ་མེད་པའི་གདན་ལ་འདུག་ཅིག་དང་།",
    "ནང་རྟགས་ཕྱི་རུ་བྱུང་བ་ལའང་རང་རིག་པའི་རྩལ་གདུལ་བྱ་ལ་མངོན་དུ་སྣང་བ་ནི།",
    "སྟོད་བྱར་འདུག་པས་ནམ་མཁའ་ལ་ལོངས་སྤྱོད།",
    "སྨད་མིར་འདུག་པས་ས་གཞིར་ལོངས་སྤྱོད།",
    "འདི་དག་ལ་ནི་དག་བྱ་དག་བྱེད་མེད་ཀྱང་རང་བཞིན་མངོན་དུ་གྱུར་པ་ཙམ་ལ་བྱ་སྟེ།",
    "རང་བྱུང་རང་སྣང་བས་ཡེ་ཤེས་ལྔར་གསལ་ཏེ།",
    "ནམ་མཁའ་ལ་སྒྲིབ་པ་མེད་ཅིང་རང་ས་དེ་ཉིད་ན་ཞི་བ་བཞིན།",
    "ཞེ་སྡང་དང་རང་བཞིན་དབྱེར་མེད་པའི་ངོ་བོ་ནི་དོན་མཐར་ཐུག་པ་སྟེ།",
    "དེ་ཡང་རང་བྱུང་ཡེ་ཤེས་སུ་གསལ་བ་སྟེ།",
    "རྫུ་འཕྲུལ་འདི་ནི་གང་དུ་ཡང་མ་གྲུབ་པ་ཅིར་ཡང་རང་སྣང་བ་སྟེ།",
    "རང་རིག་ཉིད་ཅིར་ཡང་རང་སྣང་བ་ནི་མ་བཅོས་པའི་སྐད་ཅིག་མ་སྟེ་ཚུལ་ཞེས་བྱའོ།",
    "མཚོན་བྱེད་ཀྱི་ཐ་སྙད་ཐམས་ཅད་སྣང་བའང་རང་སྣང་བྱ་སྣང་བྱེད་མ་དམིག་སོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བ་རྣམས་པ་སྐྲག་ཅིང་བརྒྱལ།",
    "འབྲུ་འདུག་ས་བསྒྱུར་ལ།",
    "ཙ་ནི་སྤྱན་གྱི་སྐུ་ཡི་མཆོག།",
    "འོག་དུས་གསུམ་རྒྱལ་བས་ཐུགས་ཆུད་པའི།",
    "དོན་ལ་ངོ་བོ་དང་ཡོན་ཏན་གྱི་རྩལ་ཐམས་ཅད་གང་དུ་ཡང་མ་གྲུབ་ལ་ཅིར་ཡང་རང་སྣང་བའོ།",
    "བྱང་རང་བཞིན་གྱིས་འོད་གསལ་བའི་སྒོ་སྟེ།",
    "བསེ་རུ་ནི་གཅིག་པུར་འདུག་པའི་ཆ་བྱད་དོ།",
    "ཞེས་སོགས་གསུངས་འདུག་པ་ལྟར་རྗེ་ཉིད་ཀྱི་འཕྲིན་ཡིག་ཁག་ལ་ཞིབ་ཏུ་མཇལ་ན་སྐབས་དེའི་གནས་ཚུལ་ཟ་ཟུར་ནས་རགས་ཙམ་ངེས་ཐུབ།",
    "ལྟར་དད་གུས་ལ་ཐུག་འདུག་པས།",
    "ཀླུ་སྒྲུབ་ཀླུ་ཡུལ་དུ་ཕེབས་དུས་ཀླུའི་གནས་ཤིག་ན་དེ་དུས་ཀྱི་མི་ལས་གཟུགས་ཉིས་འགྱུར་སུམ་འགྱུར་གྱིས་ཆེ་བའི་དགྲ་བཅོམ་པ་མང་བོ་བཞུགས་འདུག་པ་ལ།",
    "དེ་གསུམ་དུ་མ་གཏོགས་ན་རྣམ་མཁྱེན་དོན་གཉེར་བའི་གྲངས་སུ་མེདགསུངས་པ་ཡིན་པས་རྗེའི་གསུང་འཇམ་པ་མ་གཏོགས་ཚིག་འདི་གཅིག་པུས་ཡུལ་ག་ཆེན་པོ་ཞིག་ལེབ་ལེབ་བྱས་འདུག་ཕལ་ཆེ་བས་འདིའི་ནང་ན་གྲོང་ཆོག་ཉུལ་བྱེད།",
    "ནུས་པ་རླབས་ཆེ་ན་གྲངས་མང་བོ་ཡོད་མེད་ལ་བལྟོས་པ་མི་འདུག་སྟེ།",
    "སྟོང་ཁུན་མ་ཡིན་པར་ཏོང་ཧན་ཞེས་པ་ནི་མཁར་གྱི་རྒྱལ་པོའི་རྒྱ་སྐད་ཡིན་འདུག་གསུངས་ཞེས་སྐྱབས་མགོན་རྡོ་རྗེ་འཆང་ནས་གསུངས་ཞེས་དང་།",
    "མནལ་སད་པ་ན་ཚིག་དོན་རྣམས་མ་བརྗེད་པར་འདུག་གསུངས།",
    "ལྷ་ཀླུའི་ཡུལ་སོགས་ནས་གདན་དྲངས་པ་ཡིན་པར་གདའ།",
    "གསང་སྔགས་འདི་ལ་མཐའ་ཡོད་པ་ཞིག་མིན་པར་གདའ་གསུངས་ནས་ཐུགས་རྒྱལ་ཆག་ཅེས་འབྱུང་ངོ།",
    "རབ་ཏུ་བྱུང་ན་ཕྱིས་རབ་ཏུ་བྱུང་བའི་གདུལ་བྱ་མང་བོ་ཡོང་བར་འདུག་གོ་ཞེས་ལུང་བསྟན།",
    "ལུང་འདྲེན་འདིའི་སྔ་འགྲེལ་དང་བསྟོད་པ་རང་ལྟར་ན་ཚིག་རྐང་གཉིས་ཆད་ཡོད་པའི་བཟོ་ལྟ་ཞིག་འདུག་དེས་ན་འདི་ལྟར།",
    "སྒྲོལ་མས་ལུང་བསྟན་ཞེས་པའི་སྐབས་རྗེ་བཙུན་སྒྲོལ་མས་ཇོ་བོ་ལ་ཁྱེད་རང་བོད་དུ་ཕེབས་ན་ཕན་ཐོགས་རྒྱ་ཆེན་པོ་འབྱུང་ཞིང་།",
    "རྗེའི་གསུང་ཕལ་ཆེར་ལ་སྔ་འགྲེལ་གྱི་ཚུལ་དུ་ཡོད་ཅིང་རང་བཟོ་མ་ཡིན་པའི་ཁུངས་ཤེས་བྱེད་བཀའ་བསྟན་གྱི་གཞུང་ལུང་དུ་དྲངས་པ་ཡིན་གསུངས་ཏེ།",
