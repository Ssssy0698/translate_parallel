    "སྔགས་པ་སྦྱར་སྟན་དེར་འདུག་ནས།",
    "འཇིག་རྟེན་པ་མུར་འདུག་བྱེད་པ་ཞེས་པ་ནི།",
    "ཇི་ལྟར་ཆུད་པ་ན་འདུག་པའི་རྫས་རྣམས་དངོས་པོ་གང་ཡིན་མི་ཤེས་པ་ཉི་མ་ཤར་བ་ན་རྫས་དག་གསལ་བར་མཐོང་བ་བཞིན་དུ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དེས་ཀྱང་མ་རིག་པའི་མུན་པ་བསལ་ནས་ཀུན་རྫོབ་དང་དོན་དམ་པའི་དངོས་པོ་རྣམས་གསལ་བར་མཁྱེན་པ་སྟེ།",
    "དེ་ལ་གྲངས་སུ་༧འདུག་པ་གཅིག་གཉིས་གསུམ་ལ་སོགས་པ་བྱེད་པ་ཞེས་པ་ནི་ཡི་གེ་ཨ་ཞེས་པ་གཅིག་པོ་༨དེ་ལས་ཀྱང་འདུ་ཤེས་ཙམ་དུ་བྱ་བའི་སྒོ་ནས་ཨི་ལ་སོགས་པའི་ཡི་གེ་མང་པོ་རྣམས་ཀྱི་བྱེ་བྲག་ཏུ་འགྱུར་རོ་ཞེས་པའོ་། དེ་ལྟར་དཔའ་བོ་༐",
    "སེམས་དེ་ནི་དོན་དམ་པར་གཟུང་བ་དང་འཛིན་པའི་རང་བཞིན་སྔོན་པོ་དང་སེར་པོ་ལ་སོགས་པའི་མཚན་མ་ཐམས་ཅད་དང་བྲལ་བ་དང་རང་བཞིན་གྱིས་སྟོང་པ་བས་དུས་གསུམ་པ་ཡང་འདས་པ་སྟེ།",
    "གང་དུས་གསུམ་མེད་ཅིང་རང་བཞིན་གྱིས་སྟོང་པ་༐",
    "ཞེས་པ་ནི་གཟུགས་ལྷ་དང་བདག་གཉིས་གཅིག་ཏུ་བྱ་བ་དང་གཟུགས་ཐ་དད་པ་གནས་གཅིག་འདུག་པ་ཡང་སྲིད་དེ་དེ་ལྟ་བུ་མ་ཡིན་གྱི།",
    "ཞེས་པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་དེབ་འདིའི་ལྡེབ་༨༤༨པའི་བསྡུར་མཆན་༥པར་པ་སྣར་ལ་ལྷག་མ་འཁོད་འདུག་༥པ་སྣར་དེ།",
    "བེེ་རོ་ཙ་ནཱ་བྷི་སཾ་བོ་དྷི་ཏནྟྲ་སྱ་སད་བྲྀཏྟཱི་ནཱ་མ་བོད་སྐད་དུ།",
    "བྱིན་གྱིས་ལོབ་པ་ཞེས་པ་ནི་དཀྱིལ་འཁོར་དང་སྔགས་དང་ཕྱག་རྒྱའི་སྒོ་ནས་ལུས་ངག་ཡིད་གསུམ་གྱི་ཆ་ལུགས་དང་རང་བཞིན་དུ་ལྷག་པར་གཞག་༦༣ེ་ེ་ེཅེས་པའི་དོན་ཏོ།",
    "ཚིག་ལྷུར་ལེན་པའི་གདུལ་བའི་འགྲོ་བ་རྣམས་ཀྱིས་དེ་ལྟར་རྒྱུ་དང་རང་༣ེ་བཞིན་དང་འབྲས་བུ་ལ་སོགས་པ་རྣམ་པར་ཕྱེ་སྟེ།",
