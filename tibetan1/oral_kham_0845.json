    "ཕྱོགས་གཅིག་ཏུ་འདུག་གོ་ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཁྱེའུ་ཤེས་ལྡན་གྱིས་བཅོམ་ལྡན་འདས་ལ་ཚིགས་སུ་བཅད་དེ་གསོལ་པ།",
    "གྲུ་བཞི་བ་གནས་བཞི་དང་ལྡན་པ་ཞིག་འདུག་པར་གྱུར་ཏོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཀྱང་།",
    "ཇི་ཙམ་ན་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་རྒན་པའི་མཐའ་ལོགས་སུ་འདུག་སྟེ།",
    "བྱེ་བྲག་དུ་སྨྲ་བ་རྣམས་ཀྱི་མཆོག་ཏུ་བསྟན་པ་དེ་བེ་ཌཱུརྱའི་ཁང་པ་བརྩེགས་པའི་ནང་དུ་འདུག་ནས་འོང་བ་འདི་ཡིན་ནོ།",
    "བར་སྐབས་དེར་ཚེ་དང་ལྡན་པ་རྣ་བ་བྱེ་བ་ཉི་ཤུ་རི་ནགས་ཀྱི་ཚོགས་ལ་འཆག་ཅིང་འདུག་པ་དེ་འཆག་བཞིན་དུ་འོང་ངོ།",
    "དེ་ཡང་ཕྱི་མ་ས་བདག་ཉིས་བརྒྱ་སོ་གཅིག་ལས་ཡོངས་སུ་གྲགས་པའི་ལོ་ཟླ་ཞག་དུས་ཀྱི་ས་བདག་རྣམས་དབྱེ་དགོས་པ་ཡིན།",
    "ས་བདག་ཧལ་ཁྱི་ལྟ་བུར་མཚོན་ན་ལོ་ཟླ་ཞག་དུས་ཀྱི་ས་བདག་ཚང་མའི་ནང་དུ་ཡོང་བཞིན་ཡོད་པ་ལྟ་བུའི་རྐྱེན་གྱིས་ཡིན་སྲིད་པར་སྙམ།",
    "གཞན་ཡང་རང་བྱུང་ཁམས་ཀྱི་བྱ་གཅན་རི་གཡུང་རྔོན་པ་སོགས་ནི།",
    "གསེར་མཛོད་གཡུ་མཛོད་ལ་སོགས་ཞག་དུས་ཀྱི་ས་བདག་དང་།",
    "བོན་འདི་ལ་བོད་ཀྱི་ལྷ་རྣམས་དགའ་བར་མ་ཟད་ཀླུ་ལ་ལྷག་པར་མངའ་བརྙེས་པ་ཞིག་ཡོད་ཚོད་དུ་འདུག་༢ ཅེས་གསུངས།",
    "དེ་ཡང་རང་རྣམ་ལས།",
    "༡༢ ཞེས་ལན་གསུམ་གསུངས་འདུག་པས།",
    "ཡ་མཚན་པ་ཞིག་ལ་གོང་སྨོས་བོན་དཔེ་གསེར་བྲིས་ཅན་པོ་ཏི་གསུམ་པོ་དེ་ཚོ་ནི་དཀར་ཆག་དེའི་ནང་དུ་འཁོད་མི་འདུག་ལ།",
    "༣༡ དེ་ཡང་གནམ་གྱི་ཁྲི་བདུན་གྱི་རིང་ཡུམ་སྲས་མཚན་འབྲེལ་གྱི་སྲོལ་རྒྱུན་ཞིག་ཀྱང་འདུག་སྟེ།",
    "ལྡེའུ་རྒྱལ་པོ་ཞེས་བཀོད་གནང་འདུག་ཅིང་།",
    "ཞེས་བཀོད་གནང་འདུག།",
    "གཞན་ཡང་གཏམ་རྒྱུད་ཅིག་ཏུ་རྒྱལ་སྲས་རྣམས་ཀྱིས་རིམ་པ་བཞིན་ཆིབས་ཁ་ཐུབ་ཙ་ན།",
    "འདུལ་གཞུང་རང་ལ་སྟོད་ལུགས་དང་སྨད་ལུགས་ཞེས་པའི་ཐ་སྙད་གཏན་ནས་མེད་དོ།",
    "འོན་ཀྱང་འདུལ་གཞུང་རང་ལ་སྟོད་ལུགས་དང་སྨད་ལུགས་ཞེས་སོ་སོར་ཇི་ལྟར་འབྱེད་དགོས་མིན་ངེས་པར་དུ་དཔྱད་དགོས་པའི་གནས་ཤིག་ཡིན་ཏེ།",
    "འོན་ཀྱང་མཇུག་བྱང་ན་ཕ་ནམ་མཁའི་མུ་ལ་ཝེར་རོ་མིང་འཛིན་ནས་དག་པར་བྲིས་ཞེས་གསལ་བའི་ནམ་མཁའ་ཞེས་པའི་ཟུར་དུ་མུ་ལ་ཝེར་རོ་ཞེས་པའི་མཆན་ཡིག་གསལ་པོར་བཀོད་འདུག་པས།",
    "དངོས་གཞི་དཀྱུས་ཀྱི་གཞུང་དོན་ལ་ས་བཅད་རྣམ་པ་ལྔ་ཡི་སྒོ་ནས་ཁོག་དབུབ་སྟེ་རྒྱས་པར་བསྟན་འདུག་པ་སྟེ།",
    "ཞེས་བྲིས་འདུག་པས།",
    "ས་ཆ་དེའི་མིང་ལ་འཆམ་མདའ་ཟེར་གྱི་འདུག་དེ་ཡང་ལུང་པ་དེའི་ནང་ནས་འཆམ་ཆུ་ཞེས་པའི་ཆུ་བོ་ཆེན་པོ་ཞིག་བབས་པ་དང་དེའི་མདའ་ལ་འཆམ་མདའ་ཞེས་བཏགས་པར་སྙམ།",
    "པའི་དམིགས་ཡུལ་དང་འགྲོ་སྟངས་སོགས་ཀྱི་དཔྱད་བརྗོད་ལ་གཞིགས་ན་ཅུང་ཙམ་གོ་ནོར་ཐེབས་འདུག་བསམ་པ་བྱུང་།",
    "ཞེས་གསལ་ཡང་གྲངས་བཞི་བཅུ་ཏག་ཏག་བགྲངས་མི་འདུག་པས་དཔྱད་བྱ་ཙམ་དུ་ཟད་དོ།",
    "པ་ཏྲ་བཟོ་དང་རང་མཐུན་བཟོ་སོགས་རིགས་བདུན་དུ་བསྟན།",
    "སྐར་མ་དང་བསྒྱུར་ལག་དུས་སུ།",
    "རང་རང་འདོད་པ་མང་ཡོད་ཀྱང་།",
    "འགའ་ཞིག་དུས་ཀྱི་གཟེར་དང་འགལ།",
    "རང་རང་འདོད་པ་མང་ཡོད་ཀྱང་།",
    "བོད་སྐད་བརྗེད་ནས་རྒྱ་སྐད་རྒྱག་དུས།",
    "རང་དོན་ཆེད་དུ་ཁྱི་བཞིན་རྒྱུག་དུས།",
    "ལྐོག་ནས་དབྱེན་དཀྲུག་བསྟན་པ་བཤིག་དུས།",
    "བླ་སློབ་དམ་ཚིག་རྒྱབ་ཏུ་གཡུག་དུས།",
    "ཟ་ཁང་སོགས་ན་གཡོག་པོར་རྒྱུག་དུས།",
    "ལྷ་སྐུ་རྟེན་གསུམ་ཁེ་ཚོང་རྒྱག་དུས།",
    "བཟའ་བཏུང་འགྲོ་འདུག་གོམ་པ་དང་པོ་ལ།",
    "འགྲོ་འདུག་སྐྱེལ་བསུའི་དཀའ་ངལ་མྱོང་བ་ལ།",
    "གྲོགས་པོ་ཚོས་ཁོང་ལ་པཱ་ལི་ནས་འདུག་དགོས་པའི་བསྐུལ་མ་བྱས།",
    "དེ་དུས་རླངས་འཁོར་མེད་ཅིང་འགྲིམ་འགྲུལ་ཧ་ཅང་སྟབས་བདེ་མིན་པས་ལྗོངས་རྒྱུར་ཕྱིན་ཚེ་ཤིང་རྟར་འདུག་དགོས།",
    "ལོ་ངོ་༢ ༣  གྱི་སྔོན་དུ་ཨོ་སི་ཁྲུ་རི་ཡའི་རྒྱལ་ས་ཝི་ཨེན་ན་རུ་མགྲོན་ཁང་ཐབས་ཆག་ཅིག་ཡོད་པ་དེར་འཇར་མན་ནས་ཡོང་བའི་ན་གཞོན་སྐུ་མགྲོན་ཞིག་བསྡད་འདུག་སྐུ་མགྲོན་འདིའི་གཟུགས་ཕུང་ཐུང་ཞིང་ལུས་སྟོབས་རྒྱས་ལ་ཕྲག་ཞེང་ཆེ་བ་མ་ཟད།",
    "ཁོས་ཉིན་ཐོའི་སྟེང་སེམས་འགུལ་ཐེབས་ཤིང་སྤོབས་ཉམས་ལྡན་པའི་གཏམ་འདི་ལྟར་བྲིས་འདུག་སྟེ།",
    "ཁོ་ཟ་ཁང་དུ་ཕྱིན་ཏེ་འདུག་སྟེགས་ཤིག་བཙལ་ནས་མར་བསྡད་ཀྱང་།",
    "ང་རང་རྒྱང་བཞུད་བྱེད་དགོས།",
    "ཁོང་རང་ཤག་ཏུ་ཕྱིར་ཡོང་སྟེ་ཤུགས་ཆེན་པོས་ཀང་ཆིན་བརྡུང་ནས་འབྲུག་སྒྲ་ལྡིར་བ་ལྟ་བུའི་སྒྲ་ཕྱུང་སྟེ།",
    "༡༩༡༩༡༩དགོས་འདུག་ཡིན་ན་ཡང་།",
    "བྱིས་པ་ཚོ་ཁང་སྒོའི་ཕྱི་རོལ་དུ་རྩེད་འཇོར་རོལ་བཞིན་འདུག་པས།",
    "མདང་གསུམ་རྨི་ལམ་དེ་དེར་འདུག།",
    "ཀློག་ཀྱང་ཡུལ་དེ་ན་བྱིས་པས་གཙུག་ཏོར་འདོན་པ་ཁོ་ནར་གདའ་བས།",
    "དེས་ན་ང་འབུ་ལྟ་བུའི་རྣལ་འབྱོར་བ་ལ་ཡང་དེ་ལྟ་བུ་འོང་བར་འདུག་པས་ན།",
    "འབྱིང་བར་འདུག་བྱ་བའི་གྲགས་པ་འོང་།",
    "དགའ་ལྡན་དང་བདེ་བ་ཅན་དུ་འགྲོ་བར་འདུག།",
    "རྣལ་འབྱོར་པ་དེ་ལུས་ནམ་མཁའ་ལ་དཀྱིལ་ཀྲུང་བཅའ་བར་འདུག་རྡུ་ལ་མི་འབྱིང་བར་འདུག་བྱ་བའི་གྲགས་པ་འབྱུང་།",
    "དེ་རྨི་ལམ་གྱི་ལག་པར་འདུག་དགོངས་པ་དང་།",
    "ཕམ་བུ་ངོ་ཤེས་པར་གདའ་གསུང་།",
    "བགྱི་བ་ལ་སོགས་པའི་བཀུར་མཛད་ནས་གདའ།",
    "བཅོམ་ལྡན་འདས་དོན་ཡོད་གྲུབ་པའི་ཡོན་ཏན་དང་མཉ་ལ་བའི་རིགས་ཅན་དུ་གདའ།",
    "གཞི་བདག་ལ་མི་གནོདཅིང་རང་ཉིད་གནས་དེར་ཡུན་དུ་ཆགས་པའི་ཐབས།",
    "ང་རང་ཅིས་ཀྱང་སྡོད་པའི་ངོ་བོ་མེད་དོ།",
    "དེའི་འབྲས་བུ་བདེ་སྐྱིད་དུ་སྨིན་ཏོ་དེས་ན་ཚོགས་སོག་པ་འདི་ཁོ་ན་ཟབ་པར་འདུག་པས།",
    "བཞུགས་པ་ལ་བྱས་ན་ཡིད་ཚིམ་པར་འདུག་གསུང་།",
    "དེ་ཉིད་དང་ལས་མ་ཡེངས་པར་བཞག་པས་དེ་རང་ལ་མ་ཡེདབ་པར་ཡུན་བསྲིངས་ནས་བསྒོམས་པས་ཁོ་རང་ཉིད་མ་མཐོད་ནས་ཟང་ཟི་ང་སྣ་ཚོགས་པ་འོང་སྟེ་སྐད་ཅིག་ཀྱང་ཡེངས་ཐབས་མེད།",
    "གོང་འཇུག་བྱེད་པ་དང་དེ་ཀུན་ཡང་ང་འོང་བར་འདུག་གསུང་།་",
    "ཡར་གསེངས་ནས་དགེ་སྦྱོར་མཛོད་ཙ་ན།",
    "དྷཱུལ་ཞིག་བྱུང་ནས་སྐུ་སྐེད་ལ་འཁྲིལ་ནས་འདུག་པ་ལ།",
    "ཁོ་རང་ཇི་ལྟར་འདོད་པས་ལོངས་སྤྱོད་ཡོད་པར་བསམས་ལ།",
    "དེ་སྐྱེས་པ་དང་རང་ཧེ་རུ་ཀར་བསྒོམ།",
    "ནང་དང་གསང་བ་གསུམ་དུ་འོང་བར་གདའ།",
    "བྲོ་རངས་ལ་སོགས་པ་འདི་ལ་གོ་རྒྱུ་གཅིག་གདའ།",
    "དེ་ལྟར་གོ་ན་དམིགས་པའི་རྩ་བ་ཐམས་ད་ཀྱང་གོ་ནས་འོང་བར་འདུག་སྟེ།",
    "ཉིན་གཉིད་ལོག་པས་ཉེས་པ་དཔག་ཏུ་མེད་པ་སྐྱེད་པར་འདུག་པས།",
    "ལོད་བུ་དང་བོལ་ཆད་དྭོགས་འདུག་གོ།",
    "སྡུག་བསྔལ་ཆེན་གཅིག་པོ་ལ་མ་ལྟོས་པར་དཀའ་བར་གདའོ།",
    "ལོ་དུས་དང་ཞག་དུས་གཉིས་གཅིག་ཏུ་འགྲིག་པའི་དུས་ཡིན་པས།",
    "དེ་ལ་ི་འོར་མི་ཤེས་པ་ཞིག་འདུག་བྱས་ནས་ཁྱད་དུ་བསད་པས་མི་འོང་།་",
    "གཉིས་སུ་ཐུབ་པའི་གསུང་རང་མ་མཐོང་བ་ཡིན།",
    "མཚོན་ཆ་དེ་མེ་ཏོག་ཨུདཔལ་འགྱུར་བ་ཡོད་པ་ཡིན་ཏིང་ངེ་འཛིན་དེ་བས་ཞན་པ་གཅིག་ལས་མེད་ན་ཡང་ཐང་ལ་ཐཱུལ་ནས་རྣལ་འབྱོར་པ་དེ་ལ་གནོད་པ་མི་འབྱུང་ཉིང་ངེ་འཛིན་དེ་བས་ཀྱང་ཞན་པ་བྱམས་པའི་ཏིད་དེ་འཛིན་ཐ་མ་ཞིག་ལས་མེད་པར་སོད་ན་ཡད་མཚོན་ན་དེ་ཁོ་རང་ལ་ཕར་ཟུག་ནས་རྣལ་འབྱོར་པ་དེ་ལ་གནོད་པ་མི་འོང་བ་ཡིན་གསུང་།",
    "འགྲོ་འདུག་ལ་དགའ།",
    "གནས་སྐབས་ལས་སོ་སོར་སྒྲུབ་པའི་ཐབས་སྔ་མ་བཞིན་ནོ་། སྤྱིར་དྲི་ཆབ་འདི་ལ་ང་དུ་ཡོད་པར་འདུག་སྟེ།",
    "སྲན་མའི་ལྷ་བཤོས་ཤིག་ཕུལ་ནས་འདུག་དེར་དེ་རྣམས་དོར་ཏེ་ཚོང་དུས་ནས་ནས་བཟང་པོ་ཁལ་གཅིག་ལ་ནས།",
    "ཁྱེད་རང་སོ་སོའི་ལུས་ཇོ་བོ་ཐུགས་རྗེ་ཆེན་པོར་བསྒོམས་དང་།",
    "ངོ་ལྤགས་ཡ་བ་གཅིག་བཤུས་ནས་ཡར་ལ་ལྟ་ཡང་མི་ཕོད་པར་འདུག་ཟེར་ཤད་དེདེའི་དུས་སུ་འདམ་བ་ཡ་བོར་མ་མཐོང་ཞིང་།",
    "རྫེ་གཅིག་དུས་སུ་དང་པོ་རྟོགས།",
    "རོ་གཅིག་དུས་སུ་གསུམ་པ་ཤེས།",
    "སྤྱན་སྔ་ན་གཞན་སུ་ཡང་མི་གདའ།",
    "ལྟས་བཟང་བ་ཀུན་འགྲོར་འཇུག་པ་ཡིན་པར་གདའ།",
    "འགྲོ་འདུག་མང་པོའི་ཁ་ན་མེད།",
    "ཁྱེད་རང་རྣམས་ལ་ཡང་ཤི་ཟེར་བ་ཡོང་།",
    "འཕྲོ་གཅོད་ཙ་ན།",
    "ཉལ་བ་དང་འདུག་པ་གང་ཡིན་ཀྱང་།",
    "ངའི་ལྟོ་སྐལ་ཕྱེད་ཀྱིས་། གཅིག་གསའོ་བར་ཞུ་ཞུས་པ་ལགས་པར་གདའ།",
    "འདི་ལ་དགེ་སྦྱོར་ཞིག་འདེབས་རན་པར་འདུག་དགོངས་ནས།་",
    "ད་ཕྱིན་ཆད་ན་ཁྱེད་རང་རྣམས་ཀྱང་བྱ་བ་དང་བྱེད་པ་ཅི་བྱེད་པ་ཐམས་ཆད་ཀྱང་།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "མུ་ཏྲའི་ཕྱག་རྒྱ་སྰ་ང་ཙམ་ཞིག་དང་གསུམ་བྱོན་པར་གདའ།",
    "སྡུག་བསྟབ་ཆེན་པོ་བྱུང་བ་ལགས་པར་གདའ།",
    "འོ་སྐོལ་བོད་ལ་སྒོམ་ཆེན་ཤིན་ཏུ་མང་བར་འདུག་པ་ལ།",
    "ཡི་དམ་གྱི་ལྷ་རྒྱན་ཆ་ལུགས་མ་ཚང་བ་མེད་པ་གསལ་སེལ་བ་དེ་རང་ཉིད་ལ་སྣུམ་ཞིང་རང་ཉིད་ཀྱང་ཡི་དམ་གྱི་ལྷ་བརྒྱན་ཆ་ལུགས་མ་ཚང་བ་མེད་པར་སྒོམ།",
    "རྨིལམ་དུ་འགྲོ་འཆག་ཉལ་འདུག་ལ་སོགས།",
    "ཐམས་ཅད་ཀྱི་དང་པོར་ནི་ཡིད་དང་མཐུན་པའི་གནས་སུ་གནས་ནས་བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "ཉལ་བ་དང་འདུག་པ་དང་འཆག་པར་ཡང་བྱེད་དོ།",
    "ཨེ་ཡིག་ཐུགས་གསུང་རང་བཞིན་ཏེ།",
    "སྤྲིན་དྲལ་བའི་ཆོ་ག་ནི་དུར་ཁྲོད་ཀྱི་རས་ལ་ཉེ་བར་འདུག་ནས་ཞེས་པ་བཅུ་བཞི་ལ་སོགས་པ་ལ་རོའི་གདོང་གཡོགས་པའི་གོས་བླངས་ཏེ།"
  ]
}