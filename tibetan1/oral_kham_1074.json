    "མགུ་ན་ཕན་ཐོགས་ནུས་པ་ཅིག་གདའ།",
    "འདིར་མི་གང་དྲག་པ་དང་འདབ་ནོར་ཁྱེར་ནས་འོང་བ་ཚོ་བཟང་པོར་གཏོང་བར་གདའ།",
    "གསེར་ཡོད་ན་གང་འདོད་འོང་པར་འདུག་པས་དགོངས་མཛོད།",
    "བསམ་ཡས་སུ་སྒྲ་བསྒྱུར་གླིང་བཙུགས་ནས་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན་དང་སྐ་བ་དཔལ་བརྩེགས།",
    "དེས་ན་བོད་བྲིས་མ་འདི་དག་དུས་ཚོད་ནམ་ཞིག་ལ་བཞེངས་པ་ཡིན་ཟེར་ན་དཔྱད་པར་བྱ་བ་འདི་སྣང་སྟེ།",
    "སྒོ་སྲུང་ཁྲོ་བོ་སྤྲུལ་འདུག་པ་ལ་བཀའ་བསྒོས་ཤིང་།",
    "རྒྱང་ནས་བལྟས་ན་གསོན་ཉམས་ཆེ་ཞིང་དད་པ་འདྲེན་པ་ཞིག་འདུག་ཅེས་བཤད།",
    "རྒྱང་ནས་བལྟས་ན་གསལ་བོར་མཐོང་ནུས་པ་ཞིག་འདུག་གསུངས།",
    "ངེད་ཅག་བོན་གྱི་བསྟན་པ་མུན་ནག་བཞིན་དུ་གཏོང་བའི་སྔ་ལྟས་བྱུང་འདུག་ཟེར།",
    "འབྱུང་དང་མི་འབྱུང་རང་རིག་ངོ་བོ་ཉིད།",
    "འདུག་ཁང་ཆུང་བ་ཞིག་འདིར་གྱིས་ཤིག་གསུངས་པས་ཤིན་ཏུ་དགའ།",
    "འདི་ལ་སྐྲྀ་ཏིའི་རང་འགྱུར་ཞིག་ཀྱང་ཡོད་པར་གྲགས་པའི་རྒྱུད་ཕྱི་མ་ནི་བུ་སྟོན་གྱི་དུས་ནས་མ་རྙེད་པར་འདུག་དེའི་རྒྱུད་ཕྱི་མའི་ཕྱི་མ་བརྟག་པ་ལྔ་བ་སྨྲ་ཏིའི་རང་འགྱུར་རྣམས་སོ།",
    "འདི་མཚན་མང་པོ་བསབས་པའི་རྒྱུན་ཡིན་ཀྱང་ད་དུང་ཅུང་ཟད་མ་ཚང་བར་འདུག་གོ།",
    "འཕགས་པ་རི་ཁྲོད་ལོ་མ་གྱོན་མ་ཞེས་བྱ་བའི་གཟུངས་ལ་འགྱུར་བྱང་མ་བཀོད་པར་འདུག་ཀྱང་སྰ་བི་ར་དང་བ་རིའི་འགྱུར་རྣམས་སོ།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་ཕུང་བོཙ་ན།",
    "འདུག་མ་བྱས་རྫས་གྲུབ་སྨྲ་བ་སོགས་རིགས་པ་དང་འགལཾ་བ་དུ་མ་སྣང་བའི་ཕྱིར།",
    "གསུམ་པོ་དེ་དང་རང་ཉིད་བསྣན་པས་སོ།",
    "གདགས་གཞི་དགུའི་སྟེང་དུ་སྲོག་དང་རང་རང་བསྣན་པས་སོ།",
    "གདགས་གཞི་ངགུའོསྟེང་དུ་སྲོག་དང་ལུས་དང་སྡུག་བསྔལ་དང་རང་བསྣན་པསསོ།",
    "སྔར་གྱི་ཉི་ཤུའི་སྟེང་དུ་རང་རང་བསྣན་པས་སོ།",
    "གང་ཟག་ལ་དམིགས་པའི་དགའ་བ་དང་གུས་བ་དེ་གང་ན་ཡོད་ཙ་ན།",
    "འདི་སྲ་བར་འདུག་སྙམ་དུ་ངེས་པ་ལྟ་བུའོ།",
    "རྣམ་ཐོབ་པ་ཡང་རང་རྒྱུད་དུ་གཏོགས་པར་རྒྱུད་ཀྱིས་བསྡུས་པའི་ཡིན་གྱི།",
    "དེ་ཡང་རང་དང་ས་གཅིག་པ་ཐམས་ཅད་སྐལ་མཉམ་གྱི་རྒྱུ་ཡིན་གྱི།",
    "ཁོ་རང་སའི་གསུམ་ལས་འབྱུང་།",
    "འཛམ་བུའི་ཚལ་ན་འདུག་པའི་སོ་སོ་སྐྱེ་བོ་དགང་ཞེན།",
    "འོན་དབྱར་དགུན་གྱི་ཉི་མ་ལྡོག་དུས་གང་ཞེན།",
    "དེ་ཡང་མཚམསནང་གཅིག་ཏུ་གསོ་སྦྱོང་ལ་སོགས་པའི་ལས་བློ་མི་མཐུནཔས་བྱེད་པའི་གང་ཟག་དུས་ཡིན།",
    "དེ་དང་ཉེ་བ་ན་འདུག་པའི་ཕྱིར་བཞི་པ་ལ་དངོས་དང་།",
    "འོན་ཀྱང་ཀུན་རྫོབ་པའི་ཤེས་པ་གཅིག་དུས་ཚེས་ཐམས་ཅད་རིག་སྟེ།",
    "དེ་དག་ཀྱང་རང་གང་ལ་བརྟེན་པའི་རང་ས་དང་འོག་སའི་སྤྱོད་ཡུལོ་ཅན་ཡིན་ནོ།",
    "དེ་ཡང་རང་ལུས་དང་འབྲེལ་བ་དང་གཞན་ལུས་དང་འབྲེལ་བ་གཉིས་སོ་། གཉིས་ནི།",
    "དེ་ཉིད་མ་མཐོང་རང་དགར་གྱུར་པའི་ངན་རྟོག་རྣམས་ཀྱིས་བསྟབསྟན་པ་འདི་ཚིག་དང་དོན་གྱི་སྒོ་ནས་དཀྲུགས་སེ།",
    "འདི་དང་ཕྱིམ་དང་རང་དང་གཞན་དང་།",
    "གཡོ་བར་འདུག་བ་ང་དགེ་སློང་མ་དང་འགྲེང་བ་གཉིས་དང་།",
    "ཉལ་པོ་བྱེད་པརཾགཤོམ་པའི་སྒྱུ་། ཁྱིམདུ་སྟན་ལ་འདུག་པ་དང་།",
    "མགྲོན་དུ་གཉེར་བ་ལསརིང་དུ་འདུག་པ་དང་།",
    "གསུམ་པའི་ཤམ་ཐབས་ཀྱིམ་མཐའི་ཁ་མཉམ་པོར་འདུག་བའི་ཟུམ་པོར་འགོ་བར་བསླབ་པར་བྱའོ།",
    "སྟན་ལ་སྲོག་ཆགས་སོགས་ཡོད་མེད་མ་བརྟག་ལྔ་སྟན་ལ་མི་འདུག་པ་དང་།",
    "འདོམསཾམི་སྣང་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་བཞི་པ་ལ་གཉིས་ལས།",
    "ང་ན་འདུག་བའི་དགེ་སློང་གཞན་ལ་ཟས་དང་འབག་ས་བའི་ཆུས་མི་གཏོར་བར་བསླབ་བར་བྱ།",
    "ས་བོན་དང་རང་བཞིན་གཅིག་ཡིན་པའི་ཕྱིར།",
    "ལུདརིགས་བམ་ཡིན་པའིརོགས་པ་དེས་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་རིགས་པ་མིན་པས་སོ།",
    "གཟུགས་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་ན།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར།",
    "རྟག་པ་ཉིད་ལ་སོགས་པ་ཡང་རང་བཞིན་གྱིས་ཡོད་པམིན།",
    "འབྲས་བུ་། དང་རང་བཞིན་གྱིས་སོ་སོ་བ་ཡིན་པའི་ཕྱིར།",
    "དངོས་སུ་གོ་བྱཉིད་དུ་འགྱུར་བའི་བསྒྲུབ་བྱའི་ངོ་བོའང་རང་བཞིན་གྱིས་ཡོད་ན་རྒྱུ་འབྲས་ཕྲད་པ་ལ་སོགས་པ་རིགས་པ་ཉེ་བར་སྦྱོར་བར་འགྱུར་བཞིག་ན་དོ་ལང་ཡོད་བ་མིན་པས་སོ།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་ཡོད་པ་དགག།",
    "འབྲས་གཟུགས་གསཞེས་བྱ་བམ་གཏོགས་པར་གཟུགས་ཀྱི་རྒྱུ་ཡང་རང་བཞིན་གྱིས་མི་སྣང་སྟེ།",
    "དངོས་པོ་དང་དངོས་མེད་དང་དེ་གཉིས་ཀར་ཡང་རང་བཞིན་གྱིསམེད་པའི་ཕྱིར།",
    "ཇི་ལྟར་མར་ལོས་རང་དང་གཞན་གཉིས་ཀ་སྣང་བར་བྱེད་བ་དེ་བཞིན་ང་སྐྱེ་བས་ཀྱང་རང་དང་གཞན་གྱི་དངོས་པོ་གཉིས་ཀ་སྐྱེད་པར་བྱེད་པ་ཡིན་པས་འདུས་མ་བྱས་དང་ཐུག་མེད་ཀྱི་སྐྱོན་གཉིས་ཀ་མེད་དོ།",
    "མར་མེ་དང་ནི་ཡུལ་གང་དག་ན་མར་མེ་དེ་འདུག་པན་མུན་པ་མེད་པའི་ངག་དོནཕྱིར།",
    "གནས་བཞིན་པ་ཡང་རང་བཞིན་གྱིས་མི་གནས་ཏེ།",
    "མེ་ཤིང་རང་བཞིན་གྱིས་ཡོད་པ་དགག།",
    "བདཤིང་གང་དེ་མེ་དང་རང་བཞིན་གྱིས་གཅིག་ཡིན་པའི་ཕྱིར།",
    "གཉིས་པའི་མེ་ཤིང་རང་བཞིན་གྱིས་ཡོད་དེ།",
    "མེལ་ལྟོས་པའི་ཤིང་རང་བཞིན་གྱིས་མེད།",
    "མཤིང་རང་བཞིན་གྱིས་ཡོད་དེ།",
