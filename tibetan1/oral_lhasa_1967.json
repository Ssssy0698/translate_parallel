    "རིག་བྱེད་ཀྱི་སྔགས་སྐྱེས་བུས་མ་བྱས་པ་བྱེ་བྲག་ཏུ་དགག་པའོ།",
    "སྐྱེས་བུས་མ་བྱས་པའི་ཚིག་ཡིན་ན།",
    "ཞེས་ནི་སྤྱོད་པ་བ་ལ་ལ་བརྗོད་པར་བྱེད་དོ།",
    "རིག་བྱེད་སྒྲ་དོན་གྱི་འབྲེལ་བ་སྐྱེས་བུས་བྱས་པ་མིན་པས་སྐྱོན་མེད་དོ་ཞེ་ན།",
    "རིག་བྱེད་སྒྲ་དོན་གྱི་འབྲེལ་བ་རྟོགས་པ་སྐྱེས་བུས་བརྡ་བྱས་པ་ལ་ལྟོས་པ་མེད་པའི་རྟགས་དངོས་ཡིན་པའི་ཕྱིར།",
    "སྒྲ་ལས་དོན་གོ་བ་སྐྱེས་བུ་ལ་མི་ལྟོས་པར་བྱ་བའི་ཕྱིར་དུ་སྒྲ་དོན་གྱི་འབྲེལ་བ་དངོས་པོ་བ་གཞན་དག་བརྟགས་པ་དགོས་ནུས་མེད་པར་འགྱུར་ཏེ་འབྲེལ་བ་རྟག་དངོས་ཡོད་ཀྱང་དེ་གོ་བ་སྐྱེས་བུའི་བརྡ་ལ་རག་ལས་པའི་ཕྱིར་རོ།",
    "འབྲེལ་བ་སྐྱེས་བུས་བྱས་མིན་ན།",
    "ཞེས་རིག་བྱེད་སྒྲ་དོན་གྱི་འབྲེལ་བ་སྐྱེས་བུས་མ་བྱས་པའི་དངོས་པོར་ཁས་བླངས་པ་ཡང་མི་འཐད་དེ།",
    "དེ་ལྟ་བུ་ཡོད་པར་རྣམ་པར་གཞག་པའི་ཕྱིར་དུ་གཏན་ཚིགས་ཡང་དག་བརྗོད་མི་ནུས་པའི་ཕྱིར།",
    "དེ་བས་ན་རིག་བྱེད་ཀྱི་ཚིག་སྐྱེས་བུས་ལེགས་པར་མ་བྱས་པར་ཁས་ལེན་ན་རྣམ་པ་ཀུན་ཏུ་བརྗོད་བྱའི་དོན་སྟོན་པའི་ནུས་མེད་དུ་འགྱུར་ཞིང་ཉེས་པ་དེ་སྤང་བར་འདོད་ནས།",
    "དོན་ལོག་པར་སྟོན་པ་དགག་པའི་ཕྱིར་དུ།",
    "སྐྱེས་བུས་མ་བྱས་པར་ཁས་ལེན།",
    "དོན་མི་སྟོན་པ་དགག་པའི་ཕྱིར་དུ་སྐྱེས་བུས་བྱས་པར་ཁས་ལེན་རིགས་པའི་ཕྱིར།",
    "དེས་ན་དོན་དང་སྒྲ་ཡི་འབྲེལ་བ་དེ་སྐྱེས་བུའི་བློ་རྟོག་པ་ཡིས་ལེགས་པར་བརྟགས་ནས་བྱས་པ་ཡིན་ཏེ།",
    "སྒྲ་དེ་ཞིག་ནས་ཀྱང་དོན་སྟོན་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྤྱིར་སྒྲ་དོན་མི་རྟག་པས་དེའི་འབྲེལ་བ་རྟག་པ་མིན་པར་མི་འགྱུར་ཏེ།",
    "ཁོ་བོ་ཅག་སྒྲ་དོན་གྱི་འབྲེལ་བ་དེ་རྟོག་པས་རྣམ་པར་བཏགས་པ་ཙམ་དུ་ཁས་ལེན་པའི་ཕྱིར།",
    "བུམ་གཟུགས་སྒྲོན་འོད་ཀྱིས་གསལ་བར་བྱས་པར་འདོད་པ་ཡིན་པས་སྤྱིར་གསལ་བྱ་གསལ་བྱེད་ཀྱི་ཚུལ་དེ་ལྟར་ཡིན་པ་ལ།",
    "འགྱུར་བ་མེད་པ་རྣམས་ལ་རྐྱེན་གྱིས་ཁྱད་པར་བྱར་མེད་པས་སོ།",
    "དེ་ལས་རྫས་ཐ་དད་མེད་པར་རྫས་གཅིག་ཡིན་པ་གང་ཞིག།",
    "ཐ་དད་ཡིན་ན་བློ་མ་འཁྲུལ་བ་ཐ་དད་དུ་སྣང་དགོས་པ་ཁས་ལེན་དགོས་པར་འགྱུར་བས་མ་བདེ་ཞིང་།",
    "ཞེས་དངོས་པོ་ཐམས་ཅད་མཐའ་གཉིས་པོ་འདིར་ཁ་ཚོན་ཆོད་པར་གསུངས་པའི་ཕྱིར་དང་།",
    "ཞེས་པར་འགྱུར་བས་སོ།",
    "རྒྱས་པར་གཞན་དུ་བཀག་ཟིན་ཏོ།",
    "འབྲེལ་བ་རྟག་ཏུ་རྒྱས་པར་འཆད་དོ།",
    "དེ་ཡིན་ན་ཡི་གེ་ཇི་ཙམ་བསགས་ཀྱང་དོན་སྟོན་པ་མི་སྲིད་དགོས་པས་མིང་ཚིག་དང་ངག་ཐམས་ཅད་ཀྱིས་དོན་མི་སྟོན་པར་འགྱུར་བསདོན་སྟོན་པ་ཤེས་བྱ་ལ་མི་སྲིད་པར་འགྱུར་རོ།",
    "དོན་སྟོན་པ་ཤེས་བྱ་ལ་མེད་པར་ཁས་བླངས་པ་ཡིན་པས་རང་ཚིག་འགལ་བའི་མཐར་ཐུག་པ་ཡིན་ཏེ།",
    "ཚིག་གང་ལའང་དོན་སྟོན་པའི་ནུས་པ་མེད་པར་ཁས་བླངས་པ་དང་།",
    "མིང་ཚིག་ཐམས་ཅད་དངོས་པོ་མེད་པར།",
    "ལྟོ་ལྡིར་བ་ལ་དེའི་བློ་སྐྱེ་བ་བརྡ་ལ་མི་ལྟོས་པར་འགྱུར་བས།",
    "དེ་ལ་བུམ་པའི་སྒྲ་སྦྱོར་ཤེས་པར་འགྱུར་ཞིང་།",
    "བུམ་སྒྲ་དེའི་རྗོད་བྱེད་ཡིན་པའི་ཆ་སྒྲོ་བཏགས་མ་ཡིན་ན་ལྟོ་ལྡིར་བའི་རྗོད་བྱེད་ཡིན་པའི་ཆ་བུམ་སྒྲའི་དོན་གྱི་གནས་ཚོད་དུ་གྱུར་པའི་རྫས་ཡིན་དགོས་པས་བུམ་སྒྲ་ལས་ལྟོ་ལྡིར་བ་གོ་བ་བརྡ་ལ་མི་ལྟོས་པར་འགྱུར་ལ།",
    "དེ་བས་ན་དེ་དག་སྒྲོ་བཏགས་ཡིན་པར་གྲུབ་བོ་ཞེས་ཤེས་པར་བྱའོ།",
    "དེས་ན་བུམ་པ་དོན་དམ་པར་གྲུབ་པ་དང་།",
    "དེ་སྒྲའི་བརྗོད་བྱ་ཡིན་པའི་ཆ་ཀུན་རྫོབ་ཙམ་ཡིན་པ་སོགས་ཀྱི་ཁྱད་པར་ལ་རྨོངས་པས་རིག་བྱེད་ཀྱི་སྒྲ་དོན་དམ་པར་ཡོད་པར་ཁས་བླངས་ཕྱིན་ཆད།",
    "དེས་དོན་གོ་བར་བྱེད་པའི་འབྲེལ་བ་ཡང་དོན་དམ་དུ་ཡོད་པར་ཁས་ལེན་དགོས་པའི་ལོག་རྟོག་རྣམས་བྱུང་བ་ཡིན་པས་སྒྲ་དོན་གྱི་འབྲེལ་བ་དོན་དམ་དུ་ཡོད་པ་བཀག་པ་ན།",
    "སྒྲ་ཡང་དངོས་པོ་ཡིན་པ་འགོག་པར་མ་བྱེད་ཅིག།",
    "གསུམ་པ་རིག་བྱེད་སྐྱེས་བུས་མ་བྱས་པའི་སྒྲུབ་བྱེད་དང་བསྒྲུབ་བྱ་དགག་པ་ལ།",
    "སྐྱེས་བུས་མ་བྱས་པ་དགག་པ་གཉིས།",
    "རིག་བྱེད་སྐྱེས་བུས་མ་བྱས་ཏེ།",
    "དེས་ན་རིག་བྱེད་བདེན་པའི་དོན་ཅན་ཡིན་པར་མ་ཟད།",
    "སྐྱེས་བུས་མ་བྱས་པར་ཡང་འདོད་དོ་ལོ།",
    "དམ་བཅའ་དང་སྒྲུབ་བྱེད་ལྟར་སྣང་འདི་ལྟ་བུ་ལའང་རྗེས་སུ་བརྗོད་ཅིང་བདེན་པར་ཞེན་པ་ཡོད་པ་དེས་ན་སྤྱོད་པ་བ་འདིས་ནི་ལོག་རྟོག་ངན་པའི་མུན་པས་ཁྱད་པར་བྱེད་པ་ཞིག་གོ།",
    "སྣ་ཚོགས་བཤེས་གཉེན་སོགས་ཀྱིས་བྱས་པར་དྲན་ལ།",
    "འདི་ནི་སྒྲུབ་བྱེད་ལྟར་སྣང་དུ་སུས་ཀྱང་རྟོགས་སླ་བས་དགག་པ་རྒྱས་པར་མ་བསྟན་ཏོ།",
    "ཞེས་པའི་རྟགས་ལས་རིག་བྱེད་འདོན་པའི་སྐྱེས་བུའི་ཐོག་མ་མེད་པར་གྲུབ་ལ།",
    "ཐོག་མ་མེད་པའི་རྟགས་ལས་སྐྱེས་བུས་མ་བྱས་པར་འགྲུབ་ཅིང་།",
    "སྐྱེས་བུས་མ་བྱས་པའི་ངག་ཡིན་པའི་རྟགས་ལས་བདེན་པའི་དོན་ཅན་དུ་འགྲུབ་བོ་ཞེས་སྤྱོད་པ་བ་འགའ་ཞིག་སྨྲའོ།",
    "གྲུབ་ཀྱང་མ་བྱས་པར་མི་འགྲུབ།",
    "མ་བྱས་པར་གྲུབ་ཀྱང་བདེན་པའི་དོན་ཅན་དུ་མི་འགྲུབ་པའོ།",
    "དེས་ན་དེ་ཉིད་ཀྱང་སྐྱེས་བུས་མ་བྱས་པར་འགྱུར་རོ།",
    "འདོན་པ་པོ་རྟགས་མ་ངེས་པར་མ་ཟད།",
    "རང་རྒྱུ་སྐྱེས་བུ་དེ་ལས་འགྱུར་བའམ་སྐྱེས་པར་ཡང་དག་པར་ཤེས་ཏེ།",
    "འདོན་པ་པོ་ཡིན་པར་མཚུངས་པར་མཐོང་བའི་ཕྱིར།",
    "སྐྱེས་བུས་བྱས་མ་བྱས་ཀྱི་ཁྱད་པར་དག་ནི་བསྟན་པར་མི་ནུས་པ་དེ་དག་སྐྱེས་བུས་མ་བྱས་པར་སྒྲུབ་པའི་གཏན་ཚིགས་རབ་ཏུ་སྤྲོས་པ་གང་ཡིན་པ་དེ་དག་ཐམས་ཅད་རྟགས་འཁྲུལ་བ་ཅན་ཡིན་ནོ།",
    "དེ་ཡང་རིག་བྱེད་པ་དག་ཡི་གེ་རྟག་པར་འདོད་པའི་རྒྱུ་དག་ནི།",
    "དེའི་དོན་ངོ་བོ་མི་འགྱུར་བ་ལ་བསམས་ནས་ཡི་གེ་མི་འགྱུར་བའི་རྟགས་པར་འདོད་པ་ཡིན་ལ།",
    "དེ་ཙམ་གྱིས་སྐྱེས་བུ་མིན་པ་ཁོ་ན་ལ་བརྟེན་པ་ཅན་དུ་འགྲུབ་པ་མིན་ཏེ་ཐོག་མ་མེད་པ་ཙམ་གྱིས་སྐྱེས་བུས་མ་བྱས་པར་འགྲུབ་ཅིང་།",
    "བྱེད་པ་པོ་མི་དྲན་པ་ཙམ་གྱིས་ཐོག་མེད་དུ་འགྲུབ་ན་དེའི་ཕྱིར་སྐྱེས་བུས་མ་བྱས་པ་ཉིད་ཀྱིས།",
    "འཇིག་རྟེན་པའི་ཐ་སྙད་གཞན་ཡང་མི་ལ་མི་བརྟེན་པར་འགྱུར་ཏེ།",
    "སྔོན་མ་སྔོན་མས་འདུས་བྱས་པའི་རྒྱུ་ལས་འཇུག་པ་ཡུན་ཆེས་རིང་དུ་ལོན་པ་ཡིན་པས་དང་པོར་བྱེད་པ་པོ་འདི་ཡིན་ནོ་ཞེས་མི་དྲན་པའི་ཕྱིར་རོ།",
    "གསུམ་པ་མ་བྱས་པར་གྲུབ་ཀྱང་བདེན་པའི་དོན་ཅན་དུ་མི་འགྲུབ་པ་ནི་གལ་ཏེ་ཀླ་ཀློ་ལ་སོགས་པའི་ཐ་སྙད་དེ་འདྲ་ཡང་སྐྱེས་བུས་མ་བྱས་པ་ཉིད་དུ་གྲུབ་ན་ནི།",
    "ལོག་པའི་ཐ་སྙད་དེ་ལྟ་བུ་ཡང་སྐྱེས་བུས་མ་བྱས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་རིག་བྱེད་སྐྱེས་བུས་མ་བྱས་པ་དགག་པ་ལ།",
    "རིག་བྱེད་ཀྱི་ཡི་གེ་མ་བྱས་པ་དགག་ང་པ་དང་།",
    "རིག་བྱེད་ཀྱི་ངག་མ་བྱས་པ་དགག་པ་གཉིས།",
    "གཞན་འཇིག་རྟེན་གྱི་ཡི་གེ་ཨ་ལ་སོགས་པ་རྣམས་དང་སྐྱེས་བུས་བྱས་པར་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "གཉིས་པ་རིག་བྱེད་ཀྱི་ངག་མ་བྱས་པ་དགག་པ་ལ།",
    "ཡི་གེ་ལས་རྫས་ཐ་དད་པའི་མ་བྱས་པའི་ངག་དགག་པ་དང་།",
    "ཡི་གེའི་གོ་རིམས་ཁྱད་པར་ཅན་མ་བྱས་པའི་ངག་ཡིན་པ་དགག་པའོ།",
    "ངག་ཆ་མེད་གཅིག་ཉིད་ཡིན་ཡང་དུས་ཀྱི་ཁྱད་པར་ལ་ལྟོས་པ་མི་རུང་བའི་སྐྱོན་སོ་ན་གནས་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་རིགས་རྟག་པ་ཡིན་ཀྱང་གནས་སྐབས་འགར་མ་ཐོས་པ་དེ་འགལ་རྐྱེན་གྱིས་ནུས་པ་ཉམས་པར་བྱས་པ་མ་ཡིན་གྱི།",
    "གལ་ཏེ་ངག་དེ་ཡུལ་དུས་ཐམས་ཅད་དུ་རྟག་ཏུ་ཁྱབ་པར་ཡོད་དོ་ཞེ་ན།",
    "རྟག་ཏུ་ཡུལ་ཐམས་ཅད་ལ་ཁྱབ་པར་ཡོད་པའི་ཕྱིར།",
    "གལ་ཏེ་འཆད་པ་པོའི་ཁྱད་པར་གྱིས་ཐོས་རུང་དུ་འདུས་བྱས་པའི་རིག་བྱེད་ཀྱི་ངག་ཉན་ཤེས་ཀྱིས་དམིགས་པ་ཡིན་གྱི།",
    "དུས་གཅིག་ལ་དོན་རིག་བྱེད་ཀྱི་ངག་གཅིག་ཁོ་ན་ཐོས་པར་ངེས་པ་ཡིན་གྱི།",
    "དེ་ལ་གལ་ཏེ་བརྗོད་བྱ་མི་སྟོན་པའི་སྒྲ་ཙམ་ཡན་གར་བ་དུ་མ་དུས་གཅིག་ཏུ་ཐོས་པར་འགྱུར་བ་ཡིན་གྱི།",
    "སྒྲ་གཞན་དག་ནི་མི་འདོན་པར་གནས་ནས།",
    "རིག་བྱེད་གཅིག་གཅིག་འདོན་པ་ན་ཡང་དེའི་སྒྲ་ལས་ཐ་དད་པར་དེའི་རྗོད་བྱེད་ཉན་ཤེས་ཀྱིས་ཐོས་དགོས་པ་ལ།",
    "ཅ་ཅོ་ཇི་ལྟར་ཐོས་པར་འགྱུར་ཞེས་པའི་སྐྱོན་ལས་གྲོལ་བ་མི་འགྱུར་ཞེས་བྱ་བའི་དོན་ནོ།",
    "གཉིས་པ་ཡི་གེའི་གོ་རིམ་ཁྱད་པར་ཅན་མ་བྱས་པའི་ངག་ཡིན་པ་དགག་པ་ལ།",
    "ཡི་གེའི་གོ་རིམ་ཡི་གེ་ལས་རྫས་གཅིག་པ་མ་བྱས་པའི་ངག་ཡིན་པ་དགག་པ་དང་།",
    "ཡི་གེས་གསལ་བའི་གོ་རིམ་མ་བྱས་པའི་ངག་ཡིན་པ་དགག་པ་དང་།",
    "ཡི་གེའི་གོ་རིམ་ཡི་གེ་ལས་རྫས་ཐ་དད་པ་མ་བྱས་པའི་ངག་ཡིན་པ་དགག་པ་དང་།",
    "གོ་རིམ་སྐྱེས་བུ་ལ་བརྟེན་པར་བསྟན་པའི་དོན་བསྡུ་བའོ།",
    "གལ་ཏེ་ཡི་གེའི་རིམ་པ་ཁྱད་པར་ཅན་སྐྱེས་བུས་མ་བྱས་པའི་ངག་ཡིན་ནོ་ཞེ་ན།",
    "གཞན་ཡང་ཡི་གེའི་གོ་རིམ་སྐྱེས་བུས་མ་བྱས་པའི་ངག་ཡིན་ན།",
    "རིག་བྱེད་ཀྱི་ཡི་གེའི་གོ་རིམ་དེ་དག་མཐའ་གཅིག་ཏུ་རྣམ་པར་གཞག་པའང་མེད་དེ།",
    "གཞན་ཡང་ཁས་བླངས་འགལ་བའི་ཉེས་པར་ཡང་འགྱུར་ཏེ།",
    "དུས་ཐམས་ཅད་དུ་ཡོད་པའི་ཆ་མེད་རྟག་པར་བརྗོད་ཅིང་ཁས་བླངས་པའི་ཕྱིར།",
    "སླར་ཡང་ཡི་གེའི་གོ་རིམ་ངག་ཡིན་པར་ཁས་བླངས་པས་སོ།",
    "ཉེས་པ་དེ་སྤང་བར་འདོད་ནས་ཡི་གེ་མི་རྟག་པ་དང་ཁྱབ་བྱེད་མ་ཡིན་པར་འདོད་པ་ན།",
    "སྐྱེས་བུས་མ་བྱས་པར་ཁས་བླངས་ནས།",
    "མི་རྟག་པ་དང་ཡུལ་ཐམས་ཅད་དུ་ཁྱབ་བྱེད་མ་ཡིན་པར་འདོད་པའི་སྐྱོན་ཡང་སྔར་མི་རྟག་ན་ནི།",
    "གཉིས་པ་ཡི་གེ་གསལ་བའི་གོ་རིམ་མ་བྱས་པའི་ངག་ཡིན་པ་དགག་པ་ནི།",
    "གལ་ཏེ་ཡི་གེ་གྲུབ་ཟིན་རྐྱེན་གྱིས་གསལ་བའི་རིམ་པ་མ་བྱས་པའི་ངག་ཡིན་ནོ་ཞེ་ན།",
    "ཡི་གེ་ལྕེ་རྐན་ལ་སོགས་པས་གསལ་བར་བྱས་པའི་རིམ་པའང་མ་བྱས་པས་ངག་མིན་ཏེ།",
    "དེ་རྐྱེན་གྱིས་གསལ་བར་བྱས་པའི་གོ་རིམ་ངག་ཡིན་པ་མི་འཐད་པར་བསྟན་ནས།",
    "རྩོལ་བ་སོགས་ཀྱིས་གསལ་བར་བྱས་པའི་གོ་རིམ་དེ་དག་ཡིན་ན་ངག་མ་བྱས་པའང་འགལ་བར་བསྟན་པ་ནི།",
    "དེ་ལྟར་ཡིན་པ་ལས་གཞན་དུ་རིགས་འདྲ་སྔར་མེད་གསར་དུ་སྐྱེད་པར་བྱེད་པ་ཡིན་ནའང་།",
