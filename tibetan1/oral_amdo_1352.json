    "ཕྱི་མིག་གི་ཧྲག་བར་ནས་མཐོང་བ་ནི་ཚེ་སྲོག་གི་བརྙས་བཅོས་རྐྱང་རྐྱང་ཡིན་སྟབས།",
    "དུང་རྡོ་གཞུང་ལྟ་བུའི་ཚོར་གདུང་གི་ཆུ་བོ་དོ་བརྒལ་ཐུབ་མེད།",
    "རྒྱུ་རྐྱེན་དེ་དག་གིས་དེད་དེ་ང་ཁྱོད་ཚོའི་ཐག་རིང་ལ་མི་འགྲོ།",
    "ཧམ་སེམས་བརྩེ་གཟུགས་སུ་བཞེངས་ཏེ་ང་ཁྱོད་ཚོའི་ཐུ་འོག་ལའང་མི་འཛུལ།",
    "འདི་ནི་སྒྱུ་འཕྲུལ་ལྟ་བུའི་སྙན་ངག་གི་དྲོད་ཤ་ག་ལ་ཡིན་སྟེ།",
    "སྨྱོན་པ་ཚོས་འདི་ལྟར་གླུ་རེ་བླངས་རྗེས་རང་ཉིད་ལ་མཁོ་བ་ལྟ་བུའི་ན་ཟུག་གི་བདེ་བ་མྱོང་ཞིང་།",
    "དཀྱིལ་འཁོར་རྣམས་ཀྱི་ཆེད་དུ་སྨྱོན་པ་ཚོས་གླུ་རེ་ལེན་དུས།",
    "མཐའ་འཁོར་ན་ཡོད་པའི་མི་རྣམས་ཀྱིས་འཇིག་རྟེན་ནི་ཅི་འདྲའི་གོ་ལོག་ཅིག་རེད་ཨང་བསམ་སྲིད་མོད།",
    "མག་མོག་གི་གཏམ་རྒྱུད་ལྟ་བུའི་ཁེར་རྐྱང་གི་རྐང་རྗེས་སྙན་ངག་ལྟ་བུ་སྒྱུ་རྩལ་གྱི་ཐོན་དངོས་དེ་ཚོ་བོར་འགྲོ།",
    "འབོར་མི་རུང་བ་ནི་འུ་ཅག་གི་རྐང་གླིང་རྐང་གླིང་ནི་འུ་ཅག་གི་མེས་པོ་ཚོས་ཐོག་མར་སྤྱད་མྱོང་བའི་རོལ་ཆ་ཡག་ཤོས་ཤིག་ཡིན།",
    "ང་ཚོར་སྐྱེ་བ་ནས་ཤི་བའི་བར་གྱི་ལྟ་སྤྱོད་ཀྱི་ཁ་ཕྱོགས་ཤིག་ཡོད་ལ།",
    "དེ་ལས་ང་ཚོའི་ངོ་བོ་མཐོང་ཐུབ་པ་ཡིན།",
    "ཁྱོད་ཀྱིས་ཁྱོད་ལ་གུ་ཡངས་མ་གཏོང་།",
    "སྨྱོན་པ་ལྟ་བུའི་ཁྱི་སྤྱང་ཚོས་ཀུ་ཅོ་སྒྲོག་ངེས་མོད།",
    "དེ་དུས་སུས་ཀྱང་ང་ལ་མཚན་མོ་ལྟ་བུའི་མཛེས་སྡུག་གི་སྤྱང་གྲུང་མེད་ནའང་ཆག་གྲུམ་ཏུ་ཤོར་བའི་སེམས་གཞས་སྣ་ཚོགས་སྒྲག་ནས་ཡོང་།",
    "ཁོང་ཚོའི་ལྷག་བསམ་གྱི་མཐུན་འགྱུར་དང་བྲལ་ན་སྨྱོ་གཏམ་འདི་དག་ད་དུང་ས་འོག་ནས་ལུས་འགྲོ།",
    "དེའི་ཕྱིར་གླེང་འོས་པ་ནི་ཁོང་ཚོ་སྟེ།",
    "ཀློག་མཁན་ཡོངས་ལའང་ཐུགས་རྗེ་ཆེ་ཞེས་ཞུ་བ་དང་ཆབས་ཅིག་བདག་གི་དེབ་ཆུང་འདིའི་ལེགས་ཉེས་ཀྱི་གླེང་གཞི་སྤེལ་རྒྱུ་དེ་ཁྱེད་ཅག་གི་སྐུ་སྐལ་དུ་འཇོག་འོས་ལྟར་བཞག་ཡོད་ཅེས་རྩོམ་པ་བོས་རྡ་རམ་ས་ནས།",
    "ལུ་ལཱ་ལོ་ལུ་ཙ་པ་ལ་ཝ་ཨ་ཁུག་མེ་ཧཱུྃ་ཛཛའདིར་སྦྱིན་སྲེག་བསྟན་ནོ།",
    "སྲིན་མོའི་དཀྱིལ་འཁོར་དང་ལས་ཚོགས་གསུམ་སྟོན་པ་ལེའུ་བཅུ་གཅིག་པའི་དོན་བསྡུས་ཏེ།",
    "སྟོབས་ཀྱིས་སྲིན་མོས་འདུལ་ཞེས་འཐད་དོ།",
    "ཚིག་རྐང་གཉིས་པ་ལེའུ་བཅུ་གཉིས་པ་ལྷ་མོ་བོང་ཞོན་རྗེ་མོའམ་དགུ་ཚིགས་རྐང་ཅན་མའི་སྒྲུབ་དཀྱིལ་ལས་སྦྱོར་སྟོན་པའི་དོན་བསྡུས་སོ།",
    "མ་མ་ཙི་མོ་ཙི་ཏི་ཏི་མ་ར་ཧཱུཾ་ཛཛཚིག་རྐང་གསུམ་པས་རེ་མ་ཏིའི་ཕྲིན་ལས།",
    "འདོས་ནི་མ་མོའི་བརྟུལ་ཞུགས་ཡིན།",
    "ཚིག་རྐང་བཞི་པས་ལེའུ་བཅུ་བཞི་པ་བོང་བུའི་མཚན་མའི་གཟུགས་ཀྱི་ལས་ཚོགས་བརྒྱད་སྒྲུབ་པ་སྟོན་པའི་དོན་བསྡུས་ཏེ་འདི་ལྟར་ན་མཚན་མས་འདུལ་ཞེས་ཐོབ་བམ་སྙམ་མོ།",
    "ཧཱུཾ་ན་མོ་བུདྡྷ་དྷརྨ་སངྒྷ་བྷ་ཀུ་མཱ་ར་ཛི་ཧཱ་པྲ་བེ་ཤ་ཛཔ་ར་མཱི་ཤ་མ་ཧཱ་དེ་བཱི་ཀུ་མཱ་རཱ་ཛི་ཧྭ་ཨ་བ་ས་ནི་ན་མོ།",
    "ཧཱུྃ་ཀརྨ་དྷརྨ་པྲ་བེ་ཤ་པྲ་བེ་ཤ་པ་ར་མཱི་ཤ་ཤྲཱི་མ་ཧཱ་དེ་བཱི་ན་མོ།",
    "ན་མོ་བུདྡྷ་དྷརྨ་སངྒ་ཧེ་བློ་བཛྲ་ཨཱ་ལོ་ཀེ་ཛྷཱ་ན་ཨགི་པྲ་བེ་ཤ་སྭཱ་ཧཱ།",
    "ན་མོ་བུདྡྷ་དྷརྨ་སང་གྷོ་ཧེ་སྦྱོ་ཛཱི་བ་པྲ་བེ་ཤ་པ་ར་མཱི་ཤ་ཁ་ཁ་ཁཱ་ཧི་ཁཱ་ཧི་པྲ་བེ་ཤ་ཛཛཡི་གེ་རྩ་རྒྱུད་ལས་ཀྱང་།",
    "ཨོཾ་མ་ཧཱ་ཀཱ་ལི་ཡེ་སརྦ་ཤ་རྩྭ་ཨ་མུ་ཀཾ་རཱུ་པ་མ་ཧཱ་རཱུ་པ་པཱུ་ཙ་ཧཱུྃ།",
    "རྐང་པ་གཉིས་པ་ལེའུ་སོ་གཉིས་པ་སྲིད་པ་བཞིའི་ལྷ་མོའི་ལས་སྟོན་པའི་དོན་ཏེ་སྔགས་མང་བ་ཞིག་བྱུང་བས་ཡི་གེ་བཞི་བཅུ་ཟེར་བ་དང་བསྒྲིག་མ་ཐུབ།",
    "བཅུ་ཞེ་དགུ་འདུག་རྐང་པ་གསུམ་པ་ཙ་གཤིན་རྗེའི་བུ་མོ།",
    "དངོས་གྲུབ་བརྟན་གཟིགས་རྒྱུད་ཕྱི་མའི་དབུར་འབྱུང་ཞིང་ལྷ་རྣམས་ཀྱིས་ཕྱག་བྱས་པའི་ཚེ་བསྟོད་པར་གསུངས་སོ།",
    "ཁྱོད་ཀྱི་རང་བཞིན་རྟོགས་པར་རབ་ཏུ་དཀའ།",
    "ཁྱོད་ལ་ལྷ་རྣམས་ཕྱག་བགྱིད་རྟག་ཏུ་སྐྱོངས།",
    "ཐལ་བ་རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་གྱུར།",
    "ཁྱོད་ཀྱི་རིགས་སྔགས་བཟླས་པའི་མཐུ་ནུས་ལས།",
    "ཉི་མ་ཕྱོགས་བཞི་མཚམས་བརྒྱད་སྟེང་འོག་གི།",
    "ཞེས་ཐལ་མོ་གདབ་ཅིང་སྤྲོ་ན་མནན་དམིགས་ཀྱང་བྱའོ།",
    "མ་མོ་མ་མཾ།",
    "ཙི་དུ་སོང་ཙི་དུ་སོང་།",
    "བདག་གི་གནོད་བྱེད་བྱད་མ་ཀཱ་ཝཱ་ཙི་རླག་རླག།",
    "རྗེས་མེད་སོང་བསྒོམ་ཐལ་མོ་ཡན་དགུ་བརྡབ།",
    "ཁྱོད་ཀྱི་ངོ་བོ་ཡེ་ཤེས་པ་ཉིད་ཀྱང་།",
    "བདག་གིས་ལྷག་བསམ་བཟང་པོའི་མོས་སྟོབས་ཀྱིས།",
    "ལྷ་ཁྱོད་གཡེལ་མེད་མཆོད་སྒྲུབ་བསྟེན་པ་དང་།",
    "མ་མོ་བྱེ་བ་སྤྲུལ་པ་ཡང་སྤྲུལ་བཅས།",
    "ཐལ་བ་རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་མཛོད།",
    "ཅེས་སི་ཏུ་པས་ཤར་རྒྱལ་མོ་རོང་ཚ་ཀོ་རྒྱལ་པོ་པདྨ་ནོར་བུའི་བཞེད་པ་བཞིན་བྲིས་པ་སརྦ་དཱ་ཛ་ཡནྟུ།་ ། ཨོ་རྒྱུན་གནས་སུ་སྐུ་འཁྲུངས་ཤིང་།",
    "མཆོག་གི་གོ་འཕང་ཆེ་བརྙེས་པ།",
    "རིགས་ལྔའི་སྟོང་ཟློག་འདོན་ཐལ་བརྡེབ་བྱེད།",
    "དེ་ནས་མཆོད་བསྟོད་དང་ཀུན་བཟང་གི་བཀྲ་ཤིས་སོགས་བྱས་ཀྱང་འགལ་བ་མེད་འདྲ།",
    "ཞལ་བསྟབ་ལ་ཤྲཱི་ཧེ་རུ་ཀ་སོགས་བརྒྱ་རྩ་རེ་དང་གཏོར་འབུལ་རེ་སྦྲགས།",
    "འདི་ནི་གཏེར་སྟོན་རང་གིས་ཀུན་མཁྱེན་ལ་གསུངས་པའི་དེང་སང་ངེད་ཀྱི་བར་བྱེད་རྒྱུ་དེའོ།",
    "རང་ཉིད་སྒྲོལ་མ་སེར་མོ་ཞལ་གཅིག་མ།",
    "ཨེ་ཀ་བཱི་རི་མ་ཧཱ་ཀཱ་རུ་ཎེ་ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་སྭཱ་ཧཱ། ། ཆོམ་རྐུན་སོགས་མིའི་འགྲོ་བའི་གནོད་པ་སྲུང་བ་ནི།",
    "ཞབས་གཉིས་བརྐྱང་བསྐུམ་དྲག་མོའི་རྒྱུན་ཀུན་རྫོགས།",
    "ཨུ་ཏཱ་ར་ཡ་ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་སྭཱ་ཧཱ། ། ཤ་ཟ་སོགས་གདོན་གྱི་འཇིགས་པ་ལས་སྲུང་ཞིང་འཇོམས་པ་ནི།",
    "རང་ཉིད་སྒྲོལ་མ་དཀར་མོ་ཞལ་གཅིག་ཁྲོ།",
    "ཨ་བྷ་ཡ་ཧསྟི་ཏཱ་རེ་ཏུཏྟཱ་རེ་སྭཱ་ཧཱ།",
    "ནག་མོ་ཕྱག་གཉིས་གཡས་འཁོར་ལོ།",
    "ཨོཾ་ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་སརྦ་བྷ་ཡ།",
    "སརྦ་དུརྒ་ཏེ་ཏཱ་རེ་ནི་ཏུ་རེ་སྭཱ་ཧཱ།",
    "རཾ་ཡཾ་ཁཾ་གིས་བསྐང་རྫས་ཀྱི",
    "ཨོ་ཨཱཧཱུྃ་གིས་འདོད་ཡོན་གྱི",
    "༣ རིགས་བདག་བདེ་ཆེན་ཞིང་གི་མགོན།",
    "༨ ནུབ་ཕྱོགས་རྒྱལ་ཀུན་གསུང་གི་བདག།",
    "མར་མེ་དྲི་ཞལ་རོལ་མོ་དང་།",
    "གཟུགས་སྒྲ་དྲི་རོ་རེག་ཡོན་ཏན།",
    "དག་ཚངས་མཆོག་གི་དངོས་གྲུབ་སྩོལ།",
    "གཏི་མུག་གི་རྟོག་པ་བདུན་རྣམས་འགག་ཅིང་དེ་དག་གི་ངོས་ཡ་མ་བཟང་བའམ་འཛིན་ཡང་།",
    "ཚོར་དང་ཚོར་བ་བར་མ་དང་།",
    "སྒྱུ་ལུས་ཟུང་འཇུག་གི་སྐུར་ལྡང་སྟེ།",
    "སྟེང་ནས་སྟེང་གི་གནས་ཡིན་ཏེ།",
    "རྣ་བ་དག་གིས་གྲུབ་པའི་ལྷ།",
    "ཕྱེད་སྐྱེ་བ་ཕྱི་མའི་གཟུགས་སུ་གཟིགས་པ་དང་།",
    "གཟིགས་པར་གསུངས་འདུག་པ་དང་།",
    "སྲོག་སོང་བའི་བེམ་པོའི་སྔས་སུ་ཞག་ཞེ་དགུའི་བར་དུ།",
    "ལྷ་མིག་གིས་མཐོང་བའི་གཞན་སྣང་ལ་དགོངས་པའི་འགལ་སྤོང་མཛད་སྣང་ངོ།",
    "ཀུན་བཏུས་སུ་རེ་ལྟར་ཐོགས་ན་ཞེས་བསྟན་པའི་ཤུགས་ལས་རྐྱེན་རྙེད་ན་བདུན་ལས་སྔ་བར་ཡང་གཞན་དུ་ཉིང་འཚམས་སྦྱོར་བར་བསྟན་པ་དང་།",
    "མཁས་པ་ཕལ་མོ་ཆེས་ནི་སྤྱོད་བསྡུས་ལས་གསུངས་པ་གཙོ་བོར་འདོན་པར་མཛད་འདུག་ཅིང་།",
    "རྟོག་དཔྱོད་མཛད་པའི་ལས་ཅན་བྱུང་ན་དེ་དག་ལ་གཟིགས་པ་གལ་ཆེ་ཞིང་།",
    "བདག་རྙིང་ཕྱོགས་ལ་སྦྱངས་པ་སྔོན་དུ་མ་སོང་བས་འདིར་ཇི་བཞིན་སྨྲ་མ་སྤོབས་སོ།",
    "དེ་དག་གི་ཚེ་སྲིད་པ་སྔ་མ་ལ་སེམས་དབེན་ཐོབ་ཀྱང་ཉིན་སྣང་མཚན་སྣང་ཟ་བ་བ་གསང་བ་བས་ནཐམས་ཅད་སྒྱུ་མར་ཁྱེར་ཤིང་།",
    "དེ་ཉིད་ཀྱང་རྡོ་རྗེའི་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་རབ་འབྱམས་སུ་སྤྲུལ་བསྒྱུར་བྱེད་པའི་སྤྱོད་པ་རབ་ཀྱི་མཐར་དབྱུང་མ་ཟིན་པ་དག་གིས།",
    "ཟུང་འཇུག་གི་ལྷའི་སྣང་བ་སྒྱུ་མ་ལྟ་བུར་བཞེངས་ནས།",
    "དྲག་པོ་སྔོན་དུ་སོང་བའི་ཉེར་ལེན་གྱིས་འཆི་སྲིད་ཀྱི་མཐར་དཔེའི་འོད་གསལ་མངོན་དུ་བྱས་ནས་སླར།",
    "དེ་ལྟ་བུའི་སྦྱངས་པ་སྔོན་དུ་ཆེར་སོང་བ་མ་ཡིན་ན།",
    "ཞེས་བསྟན་པ་རྣམས་ཡིན་ཏེ་དེ་དག་རྒྱས་པར་མར་པའི་གསུང་གི་ང་རྒྱལ་རྡོ་རྗེའི་ཤོག་དྲིལ་ལས།",
    "སོགས་ནས་སྐྱེ་ན་དུད་འགྲོ་ཕོ་མོ་མཐོང་།",
    "དེ་ལས་ཀྱང་གོམས་པ་ཤས་ཆུང་བ་དག་གིས་མངལ་སྒོ་ཚུལ་བཞིན་དགག་པར་མ་ནུས་ན།",
    "བུད་མེད་དང་སྐྱེས་པ་རྗེས་སུ་ཆགས་པར་མཐོང་བར་འགྱུར་ཏེ།",
    "གི་རེག་པས་སྐྱེ་བར་འགྱུར་རོ།",
    "བདག་ཉིད་སྐྱེས་བའི་སྐྱེས་པ་དེའི་བུད་མེད་དང་སྐྱེས་པ་དག་ཤིན་ཏུ་དགའ་བར་མཐོང་ནས།",
    "ས་དངོས་ལ་རྟོག་ཞིབ་དང་ཞིབ་འཇུག་བྱ་རྒྱུ་ནི་དུས་རབས་ཉི་ཤུ་པའི་དུས་སྟོད་དུ་འགོ་བརྩམས་ཡོད་པ་ཞིག་རེད།",
    "དབྱིན་ཇི་བ་སྐུ་ཞབས་རེ་ཅཱ་སེན་གྱིས་བོད་ལྗོངས་སྔ་དུས་ཀྱི་འཆད་པ་དང་དུས་རབས་བརྒྱད་པ་ནས་དགུ་པའི་བར་གྱི་བོད་ལྗོངས་ཀྱི་རྒྱན་ཆའི་ལག་རྩལ་ཞེས་པའི་རྩོམ་དེབ་དང་།",
    "ལྷོ་བྱང་གི་ཞེང་ཚད་ལ་ཧ་འམ་སྨི་ཡོད་པ།",
    "རྒྱ་ཁྱོན་ལ་ཧ་ལམ་སྨི་གྲུ་བཞི་མ་ཁྲི་ཡོད།",
    "བཙན་པོ་རིམ་བྱོན་གྱི་བང་སོ་དེ་དག་གི་ནང་དུ་ཐོག་སྙོམས་གྲུ་བཞི་དབྱིབས་ཅན་གྱི་ས་འབུར་མང་བ་ཡོད།",
    "ས་རྡོ་ཤིང་གི་རྡུང་བཅག་བྱས་ཏེ་གྲུབ་ཡོད་པ་རེད།",
    "འཕྱིང་ལུང་ཞེས་པ་ནི་དེང་གི་འཕྱོངས་རྒྱས་ཡིན་པ་དང་།",
    "དོན་མཁར་མདའ་ཞེས་པ་ནི་དེང་གི་དུང་དཀར་ལུང་ཤུར་ཡིན་པར་སེམས།",
    "དེ་མིན་ཏུན་ཧོང་བོད་ཀྱི་གནའ་ཡིག་ནང་དགུན་བཙན་མོ་མུན་ཅང་ཀོང་ཅོའི་མདད་བཏང་སྟོན་ཕྱ་མང་པངས་གྱ་མདད་བཏང་།",
    "དཔྱིད་བ་ཙན་མོ་ག་ཏུན་གྱ་མདད་བཏང་།",
    "བཙན་མོ་ཀམ་ཤིང་ཁོང་ཅོ་ནོངས།",
    "བཙན་མོ་ཁོང་ཅོ་གཉས་གྱ་མདད་བཏང་།",
    "ཇོ་མོ་ཁྲ་བཙུན་གྱ་མདད་བཏང་།",
    "རྒྱུན་ལྡན་མིན་པར་གཤེགས་པའི་བཙན་པོའི་བང་སོ་བཏབ་གནས་ཞིག་ཆགས་ཡོད་པ་རེད་སྙམ།",
    "ཁྲི་གཙུག་ལྡེ་བཙན་བཅས་བཙན་པོ་དྲུག་གི་བང་སོ་ཡིན་པ་དང་།",
    "བོད་ཀྱི་དེབ་ཐེར་དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས།",
    "ཁྲི་སྲོང་ལྡེ་བཙན་བཅས་བཙན་པོ་བཞིའི་བང་སོར་ངོས་འཛིན་བྱེད་ཚུལ་ནི་སྤྱིར་གཅིག་མཚུངས་སུ་རེད་འདུག་བཞེད་པ་མི་མཐུན་པ་བྱུང་རྐྱེན་ནི།",
    "མུ་ར་རིའི་ནུབ་ངོས་སུ་བཏབ་ཡོད་པའི་བང་སོ་དེ་དག་ནི་སྲིད་ཁྲིར་བཞུགས་ཡུན་ཅུང་རིང་བའི་བཙན་པོ་དག་གི་བང་སོ་ཡིན་པ་དང་།",
    "འོན་ཀྱང་ཤར་གྱི་བྱང་ངོས་སུ་བཏབ་ཡོད་པའི་ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་བང་སོར་ངོས་འཛིན་པ་དེ་ནི་དམིགས་གསལ་གྱི་གནས་ཚུལ་ཞིག་རེད་སྙམ།",
    "བང་སོ་དེའི་བཟོ་བཀོད་དང་གཞི་རྒྱ་སོགས་ནི་ནུབ་ངོས་ཀྱི་བང་སོ་ཁག་དང་གཅིག་མཚུངས་རེད་འདུག་ལ།",
    "ཞང་མདའ་གྲོང་ཚོའི་ཉེ་འགྲམ་དུ་ཡོད་པའི་བང་སོ་དེ་ནི་ཟླུམ་དབྱིབས་ཅན་གྱི་སའི་སྟེགས་བུ་ཞིག་ཡིན་ཞིང་།",
    "ཤར་ནུབ་ཀྱི་ཚངས་ཐིག་ལ་སྨི་དང་ལྷོ་བྱང་གི་ཚངས་ཐིག་ལ་སྨི་ཡོད་ཚོད་འདུག་གནའ་རྫས་རྟོག་ཞིབ་པས་རྟོག་ཞིབ་བྱས་པར་གཞིགས་ན་དེ་སྔ་སའི་སྟེགས་བུའི་སྟེང་དུ་ས་རྡོ་ལས་གྲུབ་པའི་བང་སོའི་དུར་འབུར་ཟླུམ་པོ་ཞིག་ཡོད་པ་དང་།",
    "དེའི་ཤར་ངོས་སུ་རིང་ཚད་ལ་སྨི་དང་ཞེང་ཚད་ལ་སྨི་ཡོད་པའི་རྡོ་རྩིག་གི་དུར་སྐྱ་ཞིག་ཡོད་པ་དེས་མདུན་ངོས་ཀྱི་ཁང་པའི་ཤུལ་རྗེས་དང་བཅད་འཐེན་བྱས་ཡོད་ཚོད་འདུག་ཁང་པའི་ཤུལ་རྗེས་དེར་གཞི་རྩའི་ཐོག་ཆེ་ཆུང་གཅིག་པ་ཡིན་པའི་ཁང་པ་གསུམ་ཡོད་པ་དང་།",
    "ཁྲི་གཙུག་ལྡེ་བཙན་གྱི་བང་སོའི་རྡོ་རིང་དེར་རྒྱལ་ཁབ་ཕྱི་ནང་གི་མཁས་པ་མི་ཉུང་བས་དཔྱད་པ་དང་ཞིབ་འཇུག་གནང་མྱོང་འདུག་རྡོ་རིང་དེར་རིག་དངོས་ཚན་པས་གཙང་བཤེར་བྱས་རྗེས་ད་ལྟ་སྲུང་སྐྱོབ་ཡག་པོ་བྱས་འདུག་རྡོ་རིང་དེའི་རིང་ཚད་ལ་སྨི་ཡོད་པ།",
    "ཞབས་ར་བཅས་ཆ་ཤས་གསུམ་ལས་གྲུབ་ཡོད་པ་ཞིག་ཡིན་ཞིང་རྡོ་རིང་ཐོག་བརྐོས་པའི་རི་མོ་དང་ཡི་གེར་ཞིབ་འཇུག་གི་རིན་ཐང་གཞལ་དུ་མེད་པ་ལྡན་ཡོད་པ་ནི་སྨོས་མེད་རེད།",
    "ཁྲི་སྲོང་ལྡེ་བཙན་གྱིས་གཟེངས་བསྟོད་རྡོ་རིང་གི་རིང་ཚད་ལ་སྨི་ཡོད།",
    "ཁོ་བོའི་བསམ་པར་རྡོ་རིང་དེ་དང་བཙན་པོ་ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་བང་སོའི་རྡོ་རིང་གཉིས་ཀྱི་ངོ་བོ་གཅིག་མཚུངས་རེད་སྙམ།",
    "རྡོ་བརྐོས་མི་སྣའི་གཟུགས་བརྙན་སོགས་བཙུགས་རྒྱུ་དེ་འདྲ་ལམ་ལུགས་ཤིག་ཏུ་ཆགས་ཏེ་གཏན་འཁེལ་བྱས་ཡོད་པ་དེ་ཐང་རྒྱལ་རབས་རྗེས་ཀྱི་རྒྱལ་རབས་རིམ་བྱུང་ཁག་གི་གོང་མའི་བང་སོའི་མདུན་དུ་རྡོ་བརྐོས་བཙུགས་པའི་ལམ་ལུགས་ལ་ཤུགས་རྐྱེན་ཐེབས་ཡོད།",
    "དེས་ན་བཙན་པོའི་བང་སོའི་མདུན་དུ་རྡོ་རིང་སོགས་བཙུགས་པའི་སྲོལ་དེའང་ཐང་རྒྱལ་རབས་ཀྱི་ལམ་ལུགས་དེར་དཔེ་བལྟས་ཏེ་བཙུགས་པ་ཞིག་རེད་སྙམ།",
    "བང་སོའི་མདུན་ངོས་སུ་རྡོའི་སེང་གེའམ་སྲོག་ཆགས་གཞན་གྱི་གཟུགས་བརྙན་རྡོ་རུ་བརྐོས་ཏེ་བསླངས་པའི་བྱ་ཐབས་ནི་འཛམ་གླིང་ཐོག་གནའ་རབས་ཀྱི་མི་རིགས་མང་པོའི་ནང་དར་ཁྱབ་བྱེད་མྱོང་ཡོད་པ་ཞིག་རེད།",
    "དཔེར་ན་སུའུ་མེར་སྔ་དུས་རྒྱལ་རབས་ཀྱི་ཨུར་རྒྱལ་རིགས་ཀྱི་བང་སོ་གནའ་བོའི་སྟག་གཟིག་གི་ཨ་མེ་ནེ་ཏེ་རྒྱལ་རིགས་ཀྱི་བང་སོ་གནའ་བོའི་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོའི་བང་སོ་དང་ཀྲུང་གོའི་གནའ་བོའི་རྗེ་རིགས་ཀྱི་བང་སོ་སོགས་ཀྱི་མདུན་དུ་རྡོ་བརྐོས་སྲོག་ཆགས་བསླངས་ཡོད།",
    "སྤྱི་ལོའི་དུས་རབས་བརྒྱད་པའི་དུས་མཇུག་ནས་དུས་རབས་དགུ་པའི་དུས་སྟོད་ཀྱི་དུས་སྐབས་ཤིག་རིང་ཡ་གླིང་དཀྱིལ་མ་ཐ་ན་ཐུ་བྷོད་དང་ཧུའེ་ཧོའོ་ཡིས་དུས་རབས་སུ་ཆགས་ཞེས་པའི་ཞིབ་འཇུག་གི་དཔྱད་འབྲས་ལ་གཞིགས་ན།",
    "བང་སོའི་ཕྱི་དབྱིབས་ཀྱི་ས་འབུར་ཕལ་ཆེ་བ་གྲུ་བཞི་དང་སྐས་དབྱིབས་འབོ་ཁ་སྤུབ་ལྟར་བརྩིགས་ཡོད་པ་དེ་དང་ཀྲུང་ཡོན་གྱི་ཧན་རྒྱལ་རབས་དང་ཐང་རྒྱལ་རབས་ཀྱི་གོང་མ་རྣམས་ཀྱི་བང་སོའི་བཟོ་བཀོད་དང་འདྲ་མཚུངས་ཡིན་པ་ནི་དེང་དུས་སུ་ང་ཚོས་མཐོང་རྒྱུ་ཡོད་པའི་ནང་སའི་ས་ཆ་ཁག་གི་གོང་མ་རིམ་བྱོན་གྱི་བང་སོ་དེ་རིགས་རེད།",
    "དཔེར་ན་ཐང་ཀའོ་ཙུང་གི་བང་སོ་ཆན་ལིང་གི་མཐོ་ཞིང་བརྗིད་ཉམས་ལྡན་པའི་ས་འབུར་སྟེང་དུ་བསླངས་ཡོད་པའི་རྡོ་བརྐོས་མིའི་གཟུགས་བརྙན་དྲུག་ཅུ་རེ་གཅིག་ཡོད་པ་དེའི་ནང་དུ་སྤུ་རྒྱལ་གྱི་ཕོ་ཉའི་རྡོ་བརྐོས་གཟུགས་བརྙན་ཡོད་པ་ནས་མཚོན་ཐུབ།",
    "གཞན་ཡང་བཙན་པོའི་བང་སོའམ་བློན་ཆེན་མི་གྲགས་གང་གི་བང་སོ་ཡིན་རུང་ཚང་མ་ཚོ་པ་སོ་སོའི་རུས་རྒྱུད་དང་འབྲེལ་བ་དམ་ཟབ་ཡོད་པས་ན་རུས་ལྷ་གང་དུ་ཡོད་པའི་ས་དེའི་ཉེ་འགྲམ་དུ་རུས་རྒྱུད་ཀྱི་བང་སོ་བཏབ་པའི་སྲོལ་ཡོད་པ་ནི་ཧ་ཅང་སྔ་བའི་དུས་ནས་དར་བའི་སྲོལ་ཞིག་རེད།",
    "མཆིམས་སོགས་ལའང་སྲོལ་དེ་འདྲ་ཡོད་པ་རེད་ཅེས་གསུངས།",
    "གཟིག་ཕྲུག་རྣམས།",
    "ལོ་དེ་ནི་༡༩༤༧ ལོ་ཡིན་མོད།",
    "ཁོང་ཚོའི་ལུགས་སྲོལ་ནང་ལོ་དེ་ནི་༢༧༤ ཡིན་པར་གསལ།",
    "ནུབ་ཕྱོགས་པའི་མིག་ལམ་དུ་ལོ་ཁམས་དེ་གཉིས་ཕན་ཚུན་འབྲེལ་བ་མེད་པ་ཞིག་མཐོང་དགོས་པ་རེད།",
    "དུས་ཚོད་གཅུས་སྒྲིམ་བྱས་པའི་རྒྱལ་ཕྲན་འདིའི་ཁེར་རྐྱང་གི་རང་བཞིན་ནི་བཟློག་ཏུ་མེད་པ་ཞིག་རེད།",
    "ཁྱེད་རང་གི་གོམ་ཁ་སྙོམ་ཞིང་རྐང་སྟོབས་ཆེན་པོ།",
    "དེ་དག་གནམ་ལ་སྙེག་པའི་གཡང་ས་གཟར་པོས་བསྐོར་ཡོད་པ་དག་གིས་ཉི་འོད་ཙམ་མ་གཏོགས་སྤྱིར་བཏང་བ་ཞིག་མི་གཏོང་།",
    "རྒྱལ་ཕྲན་དེའི་གྲོང་ལྟེ་བའི་ནུབ་ཙམ་ན་ཨེ་ཤེ་ཡའི་ནང་གི་གཙང་པོ་ཆེ་གྲས་འབྲི་ཆུ་ཡོད་ཅིང་།",
    "ཝུ་བ་འཕྱུར་བའི་གཙང་པོའི་སྟོད་དེར་སྡོད་ཁང་དང་ཚོང་ཁང་མང་པོ་ནི་རི་བོང་སྡོད་སའི་ཨི་ཁུང་དང་མཚུངས་པར་འཁྱོག་པོར་ཡོད་པའི་སྲང་ལམ་དང་རྐང་ལམ་བརྒྱུད་བསླངས་ཡོད་ལ།",
    "མི་རྣམས་གཅིག་གིས་གཅིག་ལ་འབྲེལ་བ་སྣ་ཚོགས་ཡོད།",
    "རྡོ་རིགས་སྣ་ཚོགས་པའི་རྒྱུ་ཆ་གཅིག་གིས་བཟོས་ཡོད།",
    "མི་གཅིག་གི་གོ་བབས་ནི་ཁང་བཟོ་མཛེས་མིན་གྱིས་མི་བལྟ་བར་ཁང་པའི་མཐོ་ཚད་དང་སྤུས་ཚད་ཀྱིས་ཐག་གཅོད་བྱེད།",
    "སྐྱེལ་འདྲེན་གྱི་གཞི་རིམ་ཞིག་ནི་འཕྲུལ་ཆས་ཀྱི་ཕ་རོལ་དུ་སོན་རྒྱུ་དེ་རེད།",
    "དངུལ་ལོར་ཡོད་ན་ཡང་ཚོང་འབྲེལ་ནི་ད་དུང་ཤུགས་ཆེར་དངོས་ཟོག་བརྗེ་རེས་ལ་བརྟེན་ཡོད།",
    "ཅ་ལག་དང་གྱོན་ཆས་ཀྱི་མང་ཤོས་ནི་རང་གི་ལག་པས་བཟོས་པ་ཞིག་རེད།",
    "ཁྱིམ་གྱི་བདེ་སྲུང་ལམ་ལུགས་དེས་ཁྱི་ནག་གི་ཚུལ་བཟུང་སྟེ་སྒོ་འགྲམ་དུ་བཏགས་ཡོད།",
    "འོག་ཐོག་ཏུ་ཐང་གཞིར་འདམ་གྱིས་བྱུགས་པ་ཡོད་པ་དེ་སྒོ་ཟོག་གི་སྡོད་ཁང་དང་།",
    "འབྲུ་དང་ཕྱུགས་ཆས་ཀྱི་མཛོད་ཁང་རེད།",
    "ཞིག་བརྒྱུད་དེ་ཡར་འཛེགས་དགོས་པ་དེ་ནི་སྡོད་ཁང་དུ་སྤྱོད་པ་རེད།",
    "ཁང་པའི་ནང་དུ་ཡོད་པའི་ཁྲུས་ཁང་གསང་སྤྱོད་ནི་དུས་རབས་ཉེར་གཅིག་པའི་ནང་གི་གཙང་སྦྲའི་བསམ་ཚུལ་ཅན་ཞིག་རྩ་ནས་མེད།",
    "ཚོང་པ་དང་སྐུ་དྲག་གི་ཁང་ཁྱིམ་ནི་ཕལ་ཆེར་ཐོག་རྩེག་གསུམ་ཕྱོགས་གསུམ་དུ་ཡོད་ལ།",
    "ཤིང་ཁང་གི་ཐོག་ཁང་འཕར་མ་ཡོད་པ་དེ་ཚོས་ཕྱུག་པོ་ཡིན་པའི་རྟགས་མཚན་ངེས་ཅན་རེ་སྟོན།",
    "མདུན་ཅོག་དམའ་མོར་ཡོད་པ་དེ་ཚོར་རྐོས་ཞིབ་ཚགས་ཐོག་ཚོན་བཀྲག་ཆེ་བ་བྱས་ཡོད།",
    "རྩིག་ངོས་སུ་ལྷ་སར་གནས་མཇལ་སྐབས་སུ་ཐོབ་པའམ་ཡང་ན་རྒྱ་སོག་དང་རྒྱ་གར་ནས་འོང་པའི་ཚོང་པ་ཚོ་ནས་ཉོས་པའི་དར་གྱི་རས་དཔྱངས་དང་དེ་མིན་གྱི་མཛེས་རྒྱན་དག་གིས་འོད་འཚེར་བར་བྱས་ཡོད།",
    "ཕན་ཚུན་ཅལ་ཅོལ་གྱི་གླེང་མོལ་བྱེད་རོགས་སྒྲིག་པ་དང་།",
    "ཁོང་གི་མིང་ལ་བྱ་རྒོད་ཚང་དོན་ཡོད་ཟེར།",
    "ཁོང་ལོ་བཅུ་རེད།",
    "ཁོང་སྟོབས་ཅན་རེད།",
    "ཁོང་གྲུང་པོ་རེད།",
    "ང་ཚོར་ས་ཞིང་རྒྱ་ཆེར་ཡོད་ལ།",
    "ཁོང་གིས་མི་ཚང་དེ་ཚོའི་བདེ་སྡུག་ལ་ཐད་ཀར་ལྟ་རྟོག་བྱེད་ཀྱི་ཡོད།",
    "དེས་ན་ཁོང་ལ་བྲེལ་བ་ཇི་ཙམ་ཡོད་མེད་ཁྱེད་ཀྱི་སེམས་ནང་ཤར་ཐུབ་ཀྱི་རེད།",
    "མི་ཚང་མས་ཁོང་ལ་ཡར་ལྟ་གི་རེད།",
    "མི་ལས་ངན་ཚོར་དཀའ་ངལ་འཕྲད་དུས་ཁོང་ཚོ་ངའི་ཕའི་རྩར་རོགས་རམ་ཞུ་ཆེད་ཡོང་གི་རེད།",
    "ཁོང་ལ་ལས་འགན་ཆེས་མང་པོ་ཡོད་པ་རེད།",
    "ཁོང་གི་ས་ཞིང་རྒྱ་ཆེ་བ་དེར་བདག་སྐྱོང་བྱེད་དགོས།",
    "ཁོང་གི་མི་རྒྱུད་རྣམས་ཞི་འཇམ་ངང་འཇོག་དགོས།",
    "རྒྱལ་པོའི་ཐུགས་བཞེད་རྣམས་བཀོད་ཁྱབ་གཏོང་དགོས་ཕྱོགས་གཞན་ཞིག་ནས་ང་ལ་ནི་སེམས་ཁྲལ་གཅིག་ཀྱང་ཡོད་མ་རེད།",
    "ང་ཚོ་རྩེད་མོ་རྩེས་ནས་དུས་ཚོད་མང་ཆེ་བ་བསྐྱལ་བ་རེད།",
    "ང་ལ་ཡང་དེ་ལྟར་སློབ་སྦྱོང་ཐོབ་པ་རེད།",
    "དེ་མིན་ང་ཚོ་བྱིས་པ་རྣམས་རང་གིས་གང་འདོད་བཞིན་ཧ་ལམ་བྱེད་ཆོག་པ་ཡོད།",
    "ང་ཚོ་ཁེར་རྐྱང་རྩ་ནས་མིན།",
    "ང་ཚོ་མི་འབངས་དཀྱུས་མ་ཚོ་ནས་ལོགས་སུ་བཏོན་པ་དེ་འདྲ་མ་རེད།",
    "སྟོན་ཐོག་བསྡུས་ཟིན་རྗེས་ལག་ཤེས་པ་དང་སྐུ་དྲག་ཚོ་ཡང་མཉམ་དུ་འཛོམས་ནས་སྟོན་མོ་བྱེད་ཅིང་ནས་ཆང་འཐུང་ནས།",
    "སྐུ་དྲག་དེས་ཁོང་གི་ཁྱམས་རྭར་གཞས་འཁྲབ་རྒྱུ་གོ་སྒྲིག་བྱས་པ་དེར་བལྟ།",
    "བོད་མི་ཚོའི་དབྱར་ཁའི་དགའ་སྐྱིད་གཏོང་བའི་དུས་སྐབས་སུ་སྐུ་དྲག་གིས་ཁོང་གི་ནང་མི་རྣམས་སྤྲོ་བསངས་ལ་འཁྲིད་སྐབས།",
    "གཡོག་པོ་ཚོ་ཡང་གཡོག་བྱེད་པ་ཙམ་མིན་པར་མདའ་རྩེད་འགྲན་བསྡུར་དང་རྒྱུགས་རེས་སྣ་ཚོགས།",
    "ཐུན་མོང་མ་ཡིན་པའི་ལམ་སྲོལ་ཞིག་སྟེ་འཛམ་གླིང་ནང་གི་དམག་མེད་རིང་ལུགས་ལྷད་མེད་པ་ཞིག་རེད།",
    "དེ་ནི་བོད་མི་རྣམས་ལ་དུས་རབས་མང་པོའི་རིང་བརྟན་ལྷིང་སྐྱེ་བ་ཕྱི་མ་ལའང་ཚེ་འདི་དང་ཆ་མཉམ་གྱི་བསམ་བློ་གཏོང་བ་སྤྲོད་པའི་ལམ་སྲོལ་ཞིག་རེད།",
    "རྒྱལ་སྲས་ཆུང་ཆུང་བྱ་རྒོད་ཚང་དོན་ཡོད་ཀྱིས་དོན་འདི་ཚང་མ་ཤེས་འདུག་ཁོང་གིས་ད་དུང་ཁམས་ཀྱི་ནང་སྐབས་རེར་ལམ་སྲོལ་དེ་རྩིས་མེད་བྱེད་པ་ཡང་ཤེས་འདུགཁོང་དར་མ་ཆགས་སྐབས་སུ་ས་བདག་དང་དཔོན་པོ།",
    "སྔ་ཕྱི་ལ་མ་ལྟོས་པར་ཁོང་དཔའ་རྟུལ་ཞིག་ཆགས་རྒྱུ་ཡིན་པ་རེད།",
    "དེ་ཡང་ཁོང་ཚོའི་མི་ཚེའི་འགྲོ་སྟངས་ཤིག་རེད།",
    "དེར་མ་ཟད་བོད་ཀྱི་ཤར་ཕྱོགས་སུ་ཡོད་པའི་ལྷ་སའི་དམག་མི་རྣམས་ནི་གླ་ཕོགས་ཆུང་ཆུང་སྤྲད་པའི་དམག་མིའི་དོད་ཙམ་ཞིག་ལས་གང་གི་ཡང་རིན་ཐང་ཡོད་མ་རེད།",
    "ཁོང་ཚོ་ནི་དཔའ་རྟུལ་མ་རེད།",
    "དེ་ནི་ལྷ་སའི་ལས་ཀ་གང་ཡང་རུང་བ་ཞིག་ཁམས་པ་ཚོས་བྱས་བཞག་པ་དེ་འདྲ་མ་རེད།",
    "ཁམས་པ་ཚོ་བོད་པ་ཡིན་མིན་ལ་བློ་དོགས་སྤུ་ཙམ་ཡཡོད་མ་རེད།",
    "ང་ཚོས་སྲུང་བརྩི་བྱས་པའི་དུས་ཆེན་གང་ཐད་ནས་ང་ཚོ་བོད་མི་ཡིན་ལ།",
    "ཡིན་ན་ཡང་ང་ཚོ་ཁེར་རྐྱང་དུ་བཞག་པ་སྟེ།",
    "རྒྱ་ནག་གིས་འདི་རང་གི་ཁེ་ཕན་ཆེད་བེད་སྤྱོད་བྱེད་ཐབས་བྱས་ཤིང་།",
    "ང་ཚོ་ཁམས་པ་ཚོ་ནི་ནམ་ཡིན་ཡང་ང་ཚོ་རང་བདག་ཡིན་ཞིང་།",
    "དམིགས་བསལ་དཀའ་རྙོག་གི་སྐབས་སུ་དེ་ལྟར་རེད།",
    "ང་ཚོས་ང་ཚོར་ཡོད་པ་དེ་སྲུང་བ་དང་དེའི་ཆེད་དུ་དམག་རྒྱུག་རྒྱུ་ནི་འདམ་ཁ་མེད་པ་ཞིག་རེད།",
    "དེ་ནི་རྒྱུ་ཅི་ཞིག་གིས་ང་ཚོ་ཁམས་པ་བཟོས་པ་དེ་རེད།",
    "རྒྱ་མིས་ནམ་ཡིན་ཡང་ཁ་ཐག་ཉེ་བོར་བསྡད་ནས་ང་ཚོའི་རྒྱབ་ནས་དེད་ཡོད་པ་རེད།",
    "ཡིན་ན་ཡང་ཤར་ནུབ་ཕྱོགས་གང་ནས་ཡིན་རུང་ཐེ་བྱུས་བྱེད་པ་དེ་ཚད་ཅིག་བར་དུ་ང་ཚོས་བཟོད་སྒོམ་བྱེད་ཀྱི་རེད་ལ།",
    "ཚད་དེ་བརྒལ་ན་དཀའ་རྙོག་ལྷགས་རྒྱུ་ཡིན་པ་ཐག་ཆོད་རེད།",
    "ཕོ་ཁྱོ་ག་ཡིན་བསམ་མཁན་ཚང་མས་ཉུང་མཐའ་ལ་ཡང་དངུལ་གྱིས་བརྒྱན་པའི་ལག་མདའ་དང་རིང་མདའ་གང་རུང་འཁྱེར་ཡོད།",
    "དེ་ཚོ་བེད་སྤྱོད་བྱེད་སྟངས་ཀྱང་ཤེས་པ་རེད།",
    "ཉམས་བྱེད་པ་ནི་གོམ་སྟབས་སྐབས་ངང་གིས་བྱུང་བ་ཞིག་རེད།",
    "ཁོང་ཚོ་དམིགས་བསལ་གྱིས་གཡུ་དང་དངུལ་གྱི་རྣ་ལོང་འདོགས་རྒྱུ་ལ་དགའ་ཞིང་ཇི་ཙམ་ཆེ་བ་དེ་ཙམ་གྱིས་བཟང་བར་བརྩི།",
    "དེས་སྐྱེ་བ་ཕྱི་མ་ལ་བོང་ཁུའི་མི་སྐྱེ་བའི་རོགས་བྱས་པ་རེད།",
    "སྐད་ཅིག་གི་དྲན་ཤེས་ཀྱི་ཐོག་ནས་གོམས་སྟབས་རྫིག་པོ་དེ་རང་ཚོད་ཟིན་པའི་ནང་འགྱུར་བར་བྱེད།",
    "ཁོང་ཚོ་ཁོང་ཚོའི་སྐོར་གྱི་དགོད་གཏམ་ཡག་པོ་ལ་ཤིན་ཏུ་དགའ་ཞིང་།",
    "ཡིན་ན་ཡང་ཁམས་པ་ཚོར་འབྲེལ་བ་བྱེད་སྐབས་ཁོང་ཚོའི་ནང་གཟིག་གི་ཅ་ལག་གཅིག་ཡོད་པ་དྲན་པར་བྱེད་རྒྱུ་དེ་རེད།",
    "དུལ་བར་བྱས་པའི་གཟིག་ཀྱང་གཟིག་རང་རེད།",
    "ཁམས་པ་ཚོ་རྟ་པ་ཟླ་དང་བྲལ་བ་རེད།",
    "ཁམས་པ་ཚོ་མདའ་འཕེན་ལ་རྩེ་ཕུད་རེད།",
    "འབྲི་ཆུའི་ཕྱོགས་མར་བལྟས་ན་གྲིབ་ནག་དང་ཤིང་ཕུང་གི་འདམ་གསེབ་དེར་རྒྱའི་སྒར་ཡོད།",
    "གོ་མིན་ཏང་གི་ཚབ་བྱས་པའི་རང་རློམ་གྱི་གོང་མ་ཡི་སྡོད་ཁང་བཅས་ཡོད།",
    "གོ་མིན་ཏང་གི་མི་ས་འདིར་ཡོད་པ་དེ་ཁམས་པ་ཚོར་མཚོན་ན་དགོད་བྲོ་བའི་དོན་ཞིག་རེད།",
    "ཁྱེད་རང་གིས་ཁོང་ཚོ་དངོས་གནས་འདོད་རྔམ་ཅན་དང་མགོ་སྐོར་གཏོང་མཁན།",
    "མཚམས་མཚམས་ལ་གོ་མིན་ཏང་གི་དམག་མི་ཐར་ཐོར་ཁམས་ཀྱི་ཤར་ངོས་བརྒྱུད་ཁྱི་སྤྱང་བཞིན་ཐོར་ནས་འགྲོ་བ་མཐོང་།",
    "ཐ་ན་མཚམས་མཚམས་ལ་ངའི་ཕ་ཡིས་ཅ་དངོས་རྣམས་རི་ངོགས་བརྒྱུད་དེ་དབོར་འདྲེན་བྱེད་རོགས་ཀྱང་བྱས་མོད།",
    "ང་ཚོ་ཁོང་ཚོ་ལ་གུས་ཞབས་མེད།",
    "ཇག་པ་རྒྱག་སླ་བ་བཅས་རེད།",
    "གོ་མིན་ཏང་ལ་ནི་ལྐོག་ཟ་རུལ་སུངས་ཀྱི་མིང་གྲགས་ཡོད་རེད།",
    "རྒྱ་མི་ཚོས་ཉལ་ཐ་འཐེན་པ་རེད།",
    "ང་ཚོས་དེ་འདྲའི་རིགས་ནི་ཤིན་ཏུ་ཐབས་སྡུག་ཅིག་རེད་བསམས་སོང་།",
    "ཁམས་པ་ཚོས་གོ་མིན་ཏང་ལས་དཀའ་སྡུག་མྱངས་ཡོད་མོད་དེ་ནི་ཆེས་ཆུང་ཆུང་ཞིག་རེད།",
    "ཡིན་ན་ཡང་ང་ཚོ་ཁོ་ཚོ་ལ་དངོས་གནས་སྐྲག་གི་མེད།",
    "གུང་ཁྲན་ཏང་ཟེར་བའི་རྒྱ་མིའི་ཕྱོགས་གཏོགས་གཅིག་གིས་རྒྱ་ནག་གི་ནང་ས་ན་གོ་མིན་ཏང་ལ་དམག་རྒྱག་གི་ཡོད་རེད་ཟེར་བའི་གཏམ་ཡན་ཁྱབ་བསྡད་ཡོད་རེད་ལ།",
    "དུས་རབས་མང་པོའི་རིང་རྒྱ་མི་ཡོང་ནས་བསུན་གཙེར་མང་པོ་བྱས་པ་རེད།",
    "དེ་ཚོ་ཚང་མར་བཙན་འཛུལ་བྱེད་བསམ་མུ་མཐུད་ཡོད་པ་གཅིག་མཚུངས་རེད།",
    "གནའ་སྔ་མོའི་བསམ་ཚུལ་གནམ་གྱི་གོང་མ་ཟེར་བ་ཞིག་ཡོད་པ་དེས་ཁོང་ཚོ་བོད་མི་ཀླ་ཀློ་ཚོ་ལས་མ་མཐོན་པོ་ཡིན་པའི་ཚོར་བ་སླེབས་བཅུག་པ་རེད།",
    "ང་ཚོས་གཡོལ་ཐབས་བྱེད་པའི་དོན་ཅིག་རེད།",
    "ཨ་མི་རི་ཀ་ཞེས་པའི་ས་ཆ་ཞིག་ཡོད་པ་དེ་ནི་སྟོབས་ཆེན་གྱི་རྒྱལ་ཁབ་ཅིག་ཡིན་པ་དེ་ཡུ་རོབ་ཀྱི་ས་ཕྱོགས་གང་རུང་ཞིག་ཏུ་ཡོད་ཚོད་རེད།",
    "སེམས་ཁྲལ་མེད་པའི་ཁམས་པ་རྒྱལ་སྲས་འདིས་བར་སྡོད་ས་གནས་ཀྱི་སྣེ་མོར་གོམ་པ་སྤོས་ཏེ་དུས་རབས་ཉི་ཤུ་བའི་དམག་འཁྲུག་ས་དོང་གཏིང་མེད་དེར་འཛུལ་གྲབས་ཡོད་པ་རེད།",
    "ནུབ་ཕྱོགས་པ་ཞིག་གིས་གནམ་གཤིས་ཏག་ཏག་མེད་པ་ཞིག་ཏུ་མཐོང་།",
    "གྲོང་འདིའི་མཐའ་འཁོར་གྱི་ཤིང་སྡོང་མེད་པའི་གཡང་གཟར་གྱི་ལུང་པ་དེ་རོང་ཤིན་ཏུ་ཆེ་སྟབས་ས་དེར་ཁྱབ་པའི་གཡག་དང་ལུག་འབྲོག་པའི་སྦྲ་ནག་རྣམས་གཞོང་པ་རྒྱ་སྨུག་ཅིག་གི་ནང་གཡེར་མ་བཏབ་པ་དང་བསྡུར་ན་ཆུང་བ་ཙམ་ཞིག་རེད།",
    "ཆག་གྲུམ་མེད་པའི་གནམ་སྔོན་པོ་ཞིག་གིས་རྒྱ་ཆེ་བའི་རྒྱབ་ཡོལ་དེ་ངོ་མཚར་དུ་བྱས་ཡོད།",
    "གྲོང་གི་དཀྱིལ་ནས་དྲང་པོ་དང་རྒྱ་ཆེ་བར་བཤགས་ཡོད་ཅིང་།",
    "ཐག་རིང་ཐུང་གི་ཚོང་པ་སྣེ་མང་བྲེལ་འཚུབ་བྱེད་ཅིང་།",
    "མཚམས་རེར་བདུན་ཕྲག་མང་པོའི་རིང་གནམ་གཤིས་ཏག་ཏག་ཅིག་ལ་འཁེལ་འཁེལ་གྱི་བར་རམ་ཡང་ན་ཚོང་ཁྱུ་ཆེན་པོ་འཛོམས་འཛོམས་ཀྱི་བར་དུ་མགྲོན་ཁང་ཚང་མ་ཚོང་པས་ཁེངས་ཡོད།",
    "དམིགས་བསལ་གྱིས་ཚོང་ཟོག་རྩ་ཆེན་ཡོད་པ་ལ་བསམས་ན་དེ་ལྟར་རེད།",
    "དུས་ཚོད་འདི་དག་ལ་ཚོང་ཟོག་གི་ཁྱད་པར་ནི་ཡ་མཚན་དགོས་པ་ཞིག་རེད།",
    "སྤྱི་ཡོངས་ཀྱི་ཆ་ནས་འདྲེས་མར་གྱུར་པའི་མཚར་སྣང་དང་མགོ་རྙོག་འདི་ལ་སྣོན་པ་བྱེད་པ་ནི་འབྲོག་པ་ཚོ་རེད།",
    "ཁོང་ཚོ་ཁོང་ཚོའི་བོད་རྟ་དང་མ་མཉེལ་བའི་ཀོ་བའི་རིགས།",
    "གཡག་གི་རྔ་མ་སོགས་འགྲུལ་པ་ལ་འཕྲལ་སེལ་དགོས་པའི་ཅ་ལག་མང་པོ་འཁྱེར་ནས་གྲོང་དུ་བརྫངས་ཡོང་གི་རེད།",
    "སྲང་ལམ་ཁག་ཏུ་རྒྱུ་དངོས་ཆེས་མང་པོ་བཤོ་བཞིན་ཡོད་སྟབས་ཁྱེད་རང་གིས་ཁྱེད་ཀྱི་སྲུང་སྐྱོབ་ཏག་ཏག་ཡོད་པ་ཞིག་བྱེད་དགོས་པ་ནི་རང་བཞིན་གྱི་གནས་ཚུལ་ཞིག་རེད།",
    "དེ་ཡང་ཁྱེད་ཀྱིས་རང་གི་རྒྱུ་དངོས་རྣམས་ཉར་འདོད་ཡོད་ན་དེ་ལྟར་བྱེད་དགོས་ཤིང་མཚོན་ཆ་ཐོགས་པའི་ཁམས་པ་ཞིག་གླ་རྒྱུ་ནི་དཀའ་ལས་ཁག་པོ་ཞིག་མ་རེད།",
    "སྲང་ལམ་ཨ་མའི་སྟོད་ན།",
    "ཚོང་གི་སྐད་ཆ་འཁོལ་བཞིན་པའི་ཁང་སྤྱིལ་འདིའི་ནང་དུ།",
    "ཁོང་གིས་ཉིན་དེའི་སློབ་སྦྱོང་རྣམས་གྲུབ་པ་དང་།",
    "གྲའུ་དཔོན་ནི་མཐོང་བདེ་བའི་ན་གཞོན་ཞིག་རེད།",
    "གཟུགས་པོ་ཁྲུ་དྲུག་ཙམ་དུ་རིང་པོ་ཆགས་ཟིན་འདུག་ཁོང་གི་ངོ་གདོང་ལ་བྱིས་པའི་རྣམ་འགྱུར་ཡོད་ན་ཡང་ཁོང་གི་ཕྲག་རྒྱ་ཆེ་བ་དང་།",
    "རྐང་ལག་སྟོབས་ཆེ་བ་བཅས་ཀྱིས་ཕོ་ཁྱོ་ག་ཞིག་ཡོང་རྒྱུ་སྟོན།",
    "དེ་ལ་རས་ཆ་འཕར་མ་འདང་ངེས་ཤིག་བརྒྱབ་ནས་ཁོང་གི་འགོག་ཏུ་མེད་པའི་འཚར་ལོངས་དང་བསྟུན་ཡོད།",
    "མ་གཞི་ནས་ཕྱུ་པ་དེ་ཚོ་ནི་གྱོན་ཆས་ཤིག་ཆེ་རུ་བཏང་བ་ཙམ་ཞིག་རེད།",
    "ང་ཚོ་ཁམས་པ་ཚོ་དེའི་ནང་སྡོད་ཅིང་ཉལ་པ་རེད།",
    "མཚམས་མཚམས་ལ་དེ་ནི་བལ་མཐུག་པོས་བཟོས་ཡོད་ཅིང་མཚམས་མཚམས་ལ་དེ་ནི་ལུག་པགས་ཁ་ནང་དུ་བསྐོར་ནས་བཟོས་པ་རེད།",
    "དེ་ཚོའི་ཕུ་དུང་ནི་པུས་མོ་བར་དུ་མར་བསྣར་ཡོད།",
    "དེས་ས་མཐོན་པའི་ལ་ལ་འགྲོ་བ་དང་ནམ་ཟླ་གྲང་མོའི་རིང་གོན་མཁན་གྱི་ལག་པ་སྲུང་སྐྱོབ་བྱེད་ཀྱི་རེད།",
    "ཨམ་འབོག་ནང་ཁྱེད་རང་ལ་དགོས་པའི་ཅ་ལག་ཚང་མ་འཁྱེར་གི་རེད།",
    "དེ་ཚོ་ནི་བོད་ཀྱི་ལུགས་སྲོལ་ངོ་མ་ཞིག་རེད།",
    "སྐེ་རགས་བསྡམས་ནས་རྟ་ལ་ཞོན་རྒྱུ་ཙམ་ཞིག་ལས་ལས་ཀ་ཡོད་མ་རེད།",
    "དེ་ཚོར་ཚོན་དམར་པོ་དང་ནག་པོ་ང་ཚོའི་ཀོ་ལྷམ་བཞིན་བརྒྱབ་ཅིང་སྐེ་རགས་ཕན་ཚུན་མི་མཚུངས་པ་བཟོས་ཡོད།",
    "ཕོ་ཁྱོ་ག་ཞིག་གི་མིང་གྲགས་དེ་ཡང་ལྟ་ཚུལ་གཅིག་བྱས་ན་ཁོའི་ཕྱུ་པའི་བཟང་ངན་གྱིས་ཐག་གཅོད་པ་རེད།",
    "དུས་ཚོད་དེའི་སྐབས་ལ་ཕྱུ་པའི་མཐའ་དང་གོང་ང་ལ་གཟིག་ལྤགས་སོར་བཅུ་ཙམ་འཇོག་པ་དེ་དར་ཁྱབ་ཡོད་པ་རེད།",
    "ང་ཚོས་རྟ་ཡག་པོ་ཞིག་ལ་དངུལ་ཕོན་ཆེན་པོ་གཏོང་གི་རེད།",
    "ཁྱེད་རང་ཞོན་པའི་རྟ་ལ་བལྟས་ནས་ཁྱེད་རང་མི་གང་འདྲ་ཞིག་ཡིན་པའང་ཤོད་ཐུབ་པ་ཡོད་གཤིས་ང་ཚོས་བཞོན་པ་ལྟ་སྐྱོང་ཡག་པོ་བྱས་པ་རེད།",
    "རྟ་ན་ན་ང་ཚོ་ན་བ་རེད།",
    "ཁྱེད་རང་གིས་གོ་བྱུང་ངམ།",
    "གྲའུ་དཔོན་གྱིས་གཞས་པ་ཁོང་ཚོར་བསུ་བ་བྱས་ཤིང་།",
    "ཁོང་ཚོ་གང་ནས་ཡོང་མིན་དང་།",
    "གལ་ཆེ་ཤོས་ཤིག་ལ་ཁོང་ཚོས་གླིང་གེ་སར་སྒྲུང་འཁྲབ་རྒྱུ་ཡིན་མིན་བཅས་བརྩད་གཅོད་བྱས།",
    "གྲའུ་དཔོན་གྱིས་དགའ་སྣང་གིས་འཛུམ་དམུལ་བྱས།",
    "མི་ཚོགས་རྒྱ་ཆེ་འཛོམས་རྒྱུ་རེད།",
    "ཁམས་པ་སུ་ཞིག་གིས་ཁམས་ཀྱི་དཔའ་རྟུལ་ངོ་མ་གླིང་གེ་སར་གྱི་གཏམ་རྒྱུད་ལ་མིན་ཟེར་ཐུབ་བམ།",
    "ས་སྲོད་ཙམ་ལ་ཕྱི་རོལ་དུ་མེ་ལྕེ་བཟོ་གི་རེད།",
    "ལྟ་སྐོར་བ་ཚོ་ཟས་སྟོན་འདི་ལ་འདུ་འཛོམས་བྱེད་ཀྱི་རེད།",
    "མི་ཚོགས་ཀྱིས་འོད་ཆེམས་ཆེམས་ཡོད་པའི་འཁྲབ་ཁང་གི་ནང་སྡོད་ས་འཚོལ་བར་འཚང་ཁ་བྱེད་ཀྱི་རེད།",
    "སྙན་གྲགས་ཆེ་བ་དེ་ནི་ནུབ་ཕྱོགས་ཀྱི་རི་མོའི་དེབ་ཀྱི་དེ་དང་མི་མཚུངས་ཏེ་འདི་ནི་སེམས་ཀྱི་འཆར་སྣང་ཞིག་མ་རེད།",
    "གལ་སྲིད་ཁྱེད་རང་གིས་ཁོང་གི་རྫུ་འཕྲུལ་གྱི་སྟོབས་དེ་དག་ཚུལ་བཞིན་མཐོང་ན་འདིར་བསྟོད་བསྔགས་ཆེ་དྲགས་པ་ཞིག་དངོས་གནས་ཡོད་མ་རེད།",
    "ཁོང་གིས་དུས་རབས་བརྒྱད་པའི་ནང་གདོད་མའི་བོན་གྱི་བདུད་རྣམས་ཕམ་པར་བྱས་ཏེ།",
    "དུས་ཚོད་དེ་དག་གི་སྐབས་སུ་སྒྲུང་མཁན་གྱི་ལྟད་མོ་ལ་འགྲོ་བ་ནི་བྱ་བ་ཆེན་པོ་གཅིག་རེད།",
    "ཐ་ན་རྒྱ་མི་ཚོ་ཡང་ཁོ་ལ་དགའ་ནས་གེ་སར་དེ་རྒྱ་མི་ཞིག་རེད་ཅེས་ཟེར་ཐབས་སུ་སྒྲུང་ལ་བཟོ་བཅོས་བྱས་པ་རེད།",
    "དེ་ནི་དངོས་གནས་ཅོལ་ཆུང་ཞིག་རེད།",
    "གླིང་གེ་སར་དེ་ས་གནས་ཀྱི་དཔའ་བོ་ཞིག་ཡིན་པ་ཡོངས་གྲགས་རེད།",
    "ཟེར་བ་རེད།",
    "བོད་ནང་ལ་རྒྱུད་པ་ཞིག་རྒྱབ་རོགས་མེད་ན་ཕོ་ཁྱོ་གའི་མིང་གྲགས་དེ་སྟོང་པ་རེད།",
    "ཁོང་གི་དཔའ་རབས་ཀྱི་གནས་ཚུལ་དེ་ང་ཚོ་ཁམས་ཀྱི་བྱིས་པ་ཚོ་ཡང་ནར་སོན་དུས་ཁོང་ནང་བཞིན་དཔའ་བོ་ཞིག་བྱེད་འདོད་བཟོས་པ་རེད།",
    "ཁོང་གིས་ཁམས་པ་དཔའ་རྟུལ་ཚོ་ཇི་འདྲ་ཞིག་དགོས་པའི་དཔེ་མཚོན་བཞག་པ་རེད།",
    "གལ་སྲིད་དགྲ་བོས་ང་ཚོར་གཏུགས་ནས་ང་ཚོ་ལ་དུས་ཚོད་མེད་པ་ཡིན་ན།",
    "གལ་སྲིད་ཁྱེད་རང་གི་དད་པ་བརྟན་པོ་ཡོད་ན།",
    "དེ་ཚོས་ང་ཚོ་དགྲ་བོའི་མདེའུ་དང་མདའ་ལས་སྐྱོབ་ཀྱི་རེད།",
    "དད་པ་བརྟན་པོ་མེད་ན་སྲུང་བ་དེ་ཚོས་སྐྱོབ་ཀྱི་མ་རེད།",
    "གལ་སྲིད་ང་ཚོར་དུས་ཚོད་ཡོད་ན།",
    "ང་ཚོས་ཡང་བསྐྱར་མཉམ་འཛོམས་ཀྱི་མཆོད་འབུལ་བྱེད་ཀྱི་རེད།",
    "ང་ཚོར་དུས་ཚོད་མེད་ན་ང་ཚོས་རང་རང་སྒེར་གྱིས་ལྷ་སྲུང་ལ་གཏང་རག་འབུལ་གྱི་རེད།",
    "དེ་ནི་གེ་སར་རྒྱལ་པོ་དམག་ས་ལ་ཕེབས་པ་ནང་བཞིན་རེད།",
    "ནམ་རྒྱུན་བཞིན་རྒད་པོ་སྐོར་ཞིག་སྒོ་འགྲམ་དུ་ཙོག་པུར་བསྡད་ནས་ཆབ་སྲིད་ཀྱི་ཤོད་རེས་སུ་ཡོད་པ་ཙམ་མ་ཡིན་པར།",
    "དེ་བས་ས་གནས་ཀྱི་དཀའ་རྙོག་ལངས་ཚད་ཀྱི་ཕལ་ཆེ་བ་ཞིག་ལ་ལྟ་རྟོག་བྱེད་མཁན་རེད།",
    "དོན་འགྲུབ་རེ་ཆུང་བར་མངོན་ན་ཡང་གྲའུ་དཔོན་གྱིས་རང་གི་ཕ་ལ་དངོས་གནས་བྲེལ་བ་ཇི་ཙམ་ཡོད་པ་ཤེས་ཆེད་ཁོ་བཀག་གཡོག་པོས་ཚམ་ཚོམ་ངང་མགོ་བོ་གཡུགས།",
    "ཉི་མ་དེ་ནི་ཆེས་ཉི་སྡུག་ཅིག་རེད།",
    "རྙོག་དྲ་འདི་ལ་ས་གནས་སུ་ཡོད་པའི་གོ་མིན་ཏང་གི་མི་སྣས་རང་ཉིད་ཀྱང་རྙོག་དྲ་འདིར་འཛུལ་ཞུགས་བྱེད་ཆེད་འགོག་རྐྱེན་བཟོ་བ་ལྟ་བུ་ཞིག་གིས་དོན་དག་བཙོག་པ་བཟོས།",
    "གོ་མིན་ཏང་གི་ཐེ་གཏོགས་ཀྱིས་ནམ་རྒྱུན་ནས་ཁོང་གི་ཕའི་ལས་དོན་དེ་ཉིས་རྩེག་བཟོ་ཞིང་ཁོ་རང་ཡང་མ་སྐྱིད་པ་བཟོ་གི་ཡོད།",
    "ནང་མི་ཟུར་ཉན་པའི་ཚུལ་དུ་ཁོ་རང་ནང་དུ་འགྲོ་རྒྱུ་ནི་དགའ་བསུ་ཞུ་བ་ཞིག་ཡིན་མོད།",
    "ཡིན་ན་ཡང་དེ་རིང་དེ་ལྟར་མ་རེད།",
    "ཇི་ལྟར་ཁོས་རང་གི་སྨྲ་ལྕེ་འགོག་ཐུབ་ཀྱི་རེད།",
    "ཁོ་ཆུ་ཚོད་གཅིག་ནང་ཚུར་ལོག་ཡོང་གི་རེད།",
    "སེམས་ནང་ལ་འཆར་གཞི་ཅི་ཡང་མེད་པར་ཁོང་གྲོང་གི་ལྷོ་ཕྱོགས་སུ་ཕྱིན།",
    "ཁོ་རང་གིས་ཡན་ཨན་ནས་གསར་དུ་སླེབས་པའི་ཇ་ཟོག་གི་ཁྲོམ་སྟོན་མཁན་ཞིག་ལ་འཕྲད།",
    "གྲའུ་དཔོན་ཕར་སོང་ནས་ཞིབ་ལྟ་བྱེད་ཆེད་ཇའི་ལོ་མ་ཞིག་བཏོན།",
    "ཁོང་གི་སྣ་དེ་ཇ་ལ་ཟུག་ཁོས་ལོ་མ་དེ་སྣ་རྩེ་ནས་ཕར་ཚུར་གཡུགས་ནས་དྲི་ཞིམ་གྱི་རྡུལ་ཕྲན་སྤྲོ་བའི་སྐུལ་མ་བྱས།",
    "འདི་ནི་སྒོ་མང་ཕྱུ་པ་ཟེར་བ་དེ་རེད་ལ།",
    "ཁོང་གི་ཁྱིམ་དུ་འདི་རང་བེད་སྤྱོད་བྱེད་པ་རེད།",
    "ཁོང་རྒྱ་མིའི་ཁྲོམ་རྭ་ནས་ཐོན་ཏེ་སོང་།",
    "དངོས་གནས་གོ་མིན་ཏང་དང་མཉམ་དུ་ཏོག་ཙམ་ཞི་འཇགས་ཡོད་རེད།",
    "དོན་དག་ཅིག་ལ་ཁོང་ཚོའི་མི་འབོར་དེ་མངོན་གསལ་དོད་པོ་མ་རེད།",
    "དེ་ཚོའི་མང་པོ་ཞིག་གིས་ཉལ་ཐ་འཐུང་ཞིང་བེད་སྤྱོད་མེད་པ་དེ་འདྲ་རེད།",
    "གཞུང་གི་ལས་སྣེའི་ཐོག་ཡོད་པའི་མི་ཚོས་མཚམས་མཚམས་ལྐོག་དངུལ་ལེན་གྱི་རེད་ལ།",
    "ཚོང་གི་ཐོག་ནས་ཁོང་ཚོ་མངོན་གསལ་དོད་པོ་རེད།",
    "ཁོང་ཚོས་ང་ཚོ་ལས་གླ་རྩི་དང་གཡག་ལུག་གི་པགས་རིགས།",
    "གསེར་ཕྱེ་བཅས་ཉོ་གི་རེད།",
    "ཁོང་ཚོའི་ཇ་མེད་པར་ང་ཚོ་སྡོད་ཐུབ་ཀྱི་མ་རེད།",
    "ང་ཚོ་བོད་མི་རྣམས་རྒྱ་ནག་གི་ཇ་ལ་གོམས་ལང་ཤོར་ཡོད་པ་རེད།",
    "སྐབས་རེར་ང་ཚོའི་མི་ཚོས་རྒྱ་ནག་གི་གོ་མཛོད་བཅོམ་གྱི་རེད།",
    "དེ་འདྲ་རེད།",
    "ང་ཚོར་ཁོང་ཚོའི་མེ་མདའ་དང་གོ་ལག་ཐོབ་པ་ལ་ཤིན་ཏུ་དགའ།",
    "ངའི་བསམ་ཚུལ་ལ་ཁྱེད་རང་གིས་ང་ཚོས་ཁོང་ཚོའི་མཉམ་དུ་གང་གཟབ་ཅི་གཟབ་བྱས་པ་རེད་ཟེར་སྲིད་ཀྱང་།",
    "ང་ཚོ་དངོས་གནས་ཁོ་ཚོ་ལ་ཞེད་གི་མེད།",
    "སང་དགོང་གེ་སར་རྒྱལ་པོས་གླུ་ལེན་གྱི་རེད།",
    "ཁོང་འབྲོག་མོ་དང་དེའི་བུ་མོ་མཛེས་མ་ཞིག་ལ་ཐུག་དེ་ཚོས་ནམ་རྒྱུན་ནས་དངུལ་མགར་གྱི་བཟོ་ཁང་འཁྲིས་ལ་ཅོག་ཙེ་བཞག་ནས་ད་ར་འཚོང་།",
    "བོད་ལ་གསེར་བརྐོ་གི་མ་རེད།",
    "ཡིན་ན་ཡང་ཆུ་ཡིས་འཁྱེར་པ་དག་ནི་ལེན་ཆོག་པ་རེད།",
    "གང་ཡིན་ཟེར་ན་ཆུ་ཡིས་ས་གཞི་ནས་བླངས་ཟིན་པ་ཞིག་རེད།",
    "དེར་ལམ་རྟགས་མེད་པའི་ལམ་ཕྲན་འཁྱོག་པོ་ཞིག་ནུབ་ངོས་ལ་གཏད་འདུག་ཉི་མ་གཅིག་ཁོ་ཡང་ལམ་དེ་ལ་འགྲོ་དགོས།",
    "འདི་ནི་བོད་མི་ཚང་མར་ཡོད་པའི་རྨི་ལམ་གཅིག་རེད།",
    "དེ་ནི་ང་ཚོར་མཚོན་ན་གླེན་རྟགས་རང་རེད།",
    "དམར་པོའི་ལྟ་བ་དེ་ཚོ་སེམས་ནང་བསམས་མི་ཐུབ་པ་ཞིག་རེད།",
    "གཅིག་བྱས་ན་དཀྲོག་གཏམ་དེ་ཚོ་རྫུན་མ་ཡིན་རྒྱུ་རེད།",
    "བོད་པ་མང་ཆེ་བས་རྩོད་གཞི་འདིའི་སྐོར་ནས་ཕྱོགས་དེ་བཟུང་བ་རེད།",
    "གལ་སྲིད་མི་གཅིག་གིས་ཡི་གེ་ཀློག་ཐུབ་ཀྱི་ཡོད་ན།",
    "ཚོང་པ་ཚོས་ཉོ་ཤུགས་ཆེ་ཤོས་འདི་རེད་ཅེས་ངོས་འཛིན་ཞུ་ས་དེ་སུ་རེད།",
    "འབྲོག་པ་ཚོས་ཕྱུགས་ཟོག་རྩྭ་སར་འདེད་པའི་ཉི་མ་སྐར་མ་བཟང་ཤོས་དེ་ག་དུས་ཡིན་པ་སུས་ཐག་གཅོད་བྱེད་ཀྱི་རེད།",
    "གཟན་ཤམ་གོན་པའི་རྩིས་པ་ཚོ་རེད།",
    "སུས་བྱིས་པ་བཙས་མ་ཐག་པ་ལ་མིང་འདོགས་ཀྱི་རེད།",
    "ཏན་ཏན་གུང་ཁྲན་ཏང་གི་སྐོར་གྱི་དཀྲོག་གཏམ་དེ་ཚོ་རྫུན་མ་ཡིན་རྒྱུ་རེད།",
    "གྲའུ་དཔོན་གྱིས་ཁོང་གི་ཕའི་གཏམ་དཔེ་གྲགས་ཅན་ཞིག་དྲན་སོས།",
    "སྦུ་གུ་གསར་པ་དེ་རི་འབུར་རྙིང་པ་བརྒྱུད་ནས་ད་དུང་ཡང་འགྲོ་གི་རེད།",
    "ཉི་མ་དེ་ལྷ་སའི་ཕྱོགས་སུ་ནུབ་བཞིན་འདུག་ད་ནི་གཅིག་བྱས་ན་ཁོས་རང་གི་ཕའི་སེམས་དེ་མའོ་ཙེ་ཏུང་གི་ཐོག་ཡོད་པ་དེ་མེད་པ་བཟོས་ནས་རྟ་ཡི་སྐོར་ལ་སྐད་ཆ་ཤོད་ཐུབ།",
    "ཐ་ན་གེ་སར་སྒྲུང་གི་ནང་གི་གླུ་སེམས་སྐྱོ་ཤོས་དེ་ཡང་བཅོས་མ་མ་ཡིན་པའི་དགའ་སྣང་ཞིག་གི་ནང་ནས་ལེན་ཐུབ།",
    "སྐྱེས་པ་དང་བུད་མེད་ཚོ།",
    "ཇོ་བོ་ཟེ་རྒྱལ་ནི་གནས་རྩ་ཆེན་ཞིག་རེད།"
  ]
