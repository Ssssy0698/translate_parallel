    "རྣམ་པ་མཆོད་ཡོན་སོགས་རྫས་རང་རང་།",
    "ལྤགས་པ་ཁྱེར་ཤོག་གསུངས་ནས་བསྣམས་ཏེ་ཕེབས་འདུག།",
    "ཕྱོགས་སྐྱོང་རང་རང་གང་ནས་སྤྱན་དྲངས་པའི་གནས་སུ་གཤེགས་པའམ།",
    "འདིའི་སྲོགས་ཆགས་ཀྱི་གྲངས་སུ་ངང་པ་ཀླུ་ཟ་བ་ཞེས་པ་ཞིག་འདུག་པ་ཅི་འདྲ་ཡིན་མ་ངེས་པས་རྩར་ཆོད་གསུངས།",
    "གསལ་ཤིང་ལ་བསྐྱོན་པས་འདུག་པ་སྟེ་རོས་སྤྱོད་ལམ་རྣམ་བཞིའི་བྱ་བ་བྱེད་པའི་དུར་ཁྲོད་ཀྱིས་བདག་མེད་གཉིས་དང་།",
    "རྒྱུའི་ལྷ་འདི་དག་ཡོ་ག་དང་ཚུལ་མཚུངས་པར་འདུག་ཅེས་གསུངས་པ་ལྟར།",
    "སྨ་ར་འཇིག་དུས་ཀྱི་མེ་ལྟར་རབ་ཏུ་འབར་ཞིང་།",
    "དེ་འདྲའི་བཙན་པོ་ཞིག་དེ་ན་ཡོད་གསུངས་པས་སྔར་མཐོང་བའི་བྱ་དེ་ཡིན་འདུག་གསུངས་གསུང་།",
    "ཡུམ་གྱི་ས་བོན་ཧཱུྃ་དང་བོ་འདམ་ང་མཛད་འདུག་པ་བེ་ཏ་ལིའི་མིང་དང་པོའམ།",
    "རང་རང་བཞུགས་གནས་སུ་ལྟེ་བའི་ཐད་ནས་འབུལ།",
    "ཡིག་ཏུ་གྱུར་པའི་མཐར་ཨོཾ་ཨ་ར་པ་ཙ་ནའི་ཡི་གེ་དྲུག་བཀོད་ནས་བཟླ་བ་ལ་ཉི་གདན་ཟླ་གདན་དུ་བསྒྱུར་བའི་སྦྲགས་སྒྲུབ་ཟེར།",
    "རྩིབས་དྲུག་ལ་ཨོཾ་ཨ་ར་པ་ཙ་ན།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ནཧཱུྃ་གང་རུང་བཟླ།",
    "གཏོར་མགྲོན་གཤེགས་པའམ་བྲིས་སྐུ་དང་རང་ལ་བསྟིམས་ཀྱང་རུང་།",
    "ཐུན་མཚམས་སུའང་ལྷའི་ང་རྒྱལ་དང་མ་བྲལ་བས་འགྲོ་འདུག་སྨྲ་བརྗོད་ཕྱག་རྒྱ་དང་གླུ་གར།",
    "པུར་ལ་འཇའ་ཟུག་པ་སོགས་འདུག་པ་ཅི་ཡིན་ཞེས་ཀུན་མཁྱེན་གོང་མས་སྲད་རྒྱུད་རྡོ་རྗེ་འཆང་ལ་ཞུས་པར།",
    "ཚུར་ཤོག་ཅེས་ལྷ་བསྟིམས་ནས་ཡེ་ཤེས་པ་ཞུགས་ཟིན་པས་རབ་གནས་བསྐྱར་མ་མི་དགོས་འདུག་གསུངས།",
    "ཁ་ན་མ་ཐོ་བ་མེད་པའི་ཟས་ཡིན་པས་ཁྱེད་རང་ཡང་ཁམ་གཅིག་ཟོ་ཟེར།",
    "ལོ་གྱོན་མའི་ཁྲིད་གསན་ནས་ཟིན་བྲིས་ཀྱང་འདུག་ཀུན་མཁྱེན་འཇམ་དབྱངས་བཞད་པས་རྒྱུད་ཆེན་ལ་བདེ་གསང་འཇིག་གསུམ་ཀའི་གདམས་པ་ཡོངས་རྫོགས་ཞུས་པས་གསུམ་ཀ་མི་འོང་ཞེས་བཀའ་དམ་པོ་གནང་།",
    "ལན་གཅིག་ཕྱག་བྲིས་ཚིགས་བཅད་མ་ཞིག་བྱུང་བར་འཆི་བ་ལ་བསྒུག་ནས་ཡོད་ཚུལ་གནང་འདུག་པས་གདན་འདྲེན་ཞུ་དགོས་པར་གོ་ནས་ཆིབས་པ་མི་སྣ་དང་བཅས་མངགས་པ་ཕེབས་འཕྲལ།",
    "དེའང་རྗེ་བདག་ཉིད་ཆེན་པོས་རྨོངས་པའི་མུན་པ་སེལ་བ་ལ་ཐོས་པ་གལ་ཆེ་བར་འདུག་སྙམ་ནས་གཞན་ལ་ཟོན་མ་བྱས་པར་དེ་གཅིག་པུར་འབད་ན་ཚུལ་འཆལ་གྱི་ལྗིད་ཀྱིས་ནོན།",
    "མིད་ལ་སོགས་མི་མེད་ཀྱི་རི་སུལ་དང་ཐང་སྟོང་དུ་བཞུགས་པ་ལ་སྐུ་གསུང་ཐུགས་རྟེན་དང་མཆོད་གཏོར་བཀྲ་ལམ་མེ་བའི་གཤོམ་ཅན་མེད་ཀྱང་ཉམས་ལེན་གྲུབ་འདུག་པས་རྟེན་དང་མཆོད་གཏོར།",
    "དེ་ལྟར་ཤྲཱིའི་དོན་གཉིས་སྣང་དང་བྲལ་བའི་བདེ་སྟོང་དབྱེར་མེད་དང་རང་སེམས་རོ་གཅིག་ཏུ་ཞུགས་པ་ནི་ཡིད་དག་བྱེད་ཀྱི་རྣལ་འབྱོར་རོ།",
    "རུ་གུར་གྱི་མཚམས་ཀྱི་ཕྱི་རོལ་ཏུ་ཆུ་དར་འཕྱང་བ་ལྟར་ཡོད་གསུངས་པ་གཉིས་ཀ་ཁྲིད་ཡིག་རྣམས་སུ་འདུག་པས་ཕྱི་ནང་གཉིས་ཀར་བསམ་ཀྱང་ཆོག་པ་འདྲ།",
    "གསལ་ཤིང་ལ་བསྐྱོན་པས་འདུག་པ་སྟེ་རོས་སྤྱོད་ལམ་རྣམ་བཞི་སོགས་བྱེད་པས་དུར་ཁྲོད་དང་།",
    "རས་བྲིས་འགའ་ཞིག་ལས་དཀྱིལ་འཁོར་གྱི་གཙོ་བོར་ལྟ་བ་བྲིས་འདུག་པའང་དཀྱིལ་འཁོར་ཤེལ་ལྟར་མི་སྒྲིབ་པའི་མཚོན་བྱེད་དུའང་འགྱུར་རམ་དཔྱད།",
    "བལ་པོ་སྐད་གྲྭ་བ་ཟེར་བས་མགོ་རས་ཀྱིས་དཀྲིས་པ་ལ་རྡོ་རྗེ་ཞིག་སྨྱུག་སྒྲོག་ལྟར་དྲང་འདུག་པ་དེ་ཡང་ལུགས་གཅིག་གམ་བརྟགས་གསུངས།",
    "ནང་མཆོད་དཔྲལ་བར་བཟུང་སྟེ་འདུག་པས་གཡས་སྐོར་དང་།",
    "རྫོགས་རིམ་ལ་སྔར་ཆོག་བསྒྲིག་མི་འདུག་ཀྱང་འདི་ལྟར་ན་བྱས་ཆོག་པ་འདྲ།",
    "འདོད་འཇོ་སོགས་སུ་པདྨ་ནི་རྟི་དང་སཱ་ཧཱ་ཧུ་ཞེས་པའི་སྔགས་གཉིས་འདམ་ག་མཛད་འདུག་པས་སོ།",
    "དོན་ཡོད་མཁས་གྲུབ་གྲགས་ཆེ་བས་ད་ལྟའི་བརྒྱུད་ཡིག་ཕལ་ཆེར་དུ་ཀུན་མཁྱེན་གོང་མ་མ་ཐེབས་འདུག་ཀྱང་རྒྱལ་བ་སྐལ་བཟང་རྒྱ་མཚོའི་གསན་ཡིག་དང་བརྒྱུད་འདེབས་སོགས་སུ་གསལ་བ་བཞིན་ཐང་སག་པ་དང་།",
    "དེ་ཐམས་ཅད་ལ་མཐའི་གསལ་བྱེད་སྤྲོས་ཞེས་པ་གཅིག་པུ་ལས་མ་བྱུང་བས་ཡབ་ཀྱིས་ཡུམ་སྤྲོ་བ་ལྟ་བུ་ཞིག་འདུག་པ་ཡི་གེ་མ་དག་པའམ།",
    "ཞེས་རྟག་ཏུ་ཞེས་པ་ཚིག་ཟིན་ལ་ཐོན་འདུག་ཅིང་།",
    "སྟན་དེ་ལ་འདུག་བཞིན་དུ་གདུལ་བྱ་དེའི་ངོར་གྲངས་མེད་གསུམ།",
    "དམ་ཉམས་ཁ་ཤས་ཀྱིས་གཞི་དངོས་པོའི་གནས་ཚུལ་སོགས་ཀྱང་བྲིས་འདུག་ཨ་ཁ་ཁ་གསུངས།",
    "གནའ་དཔེ་པར་སྐྲུན་གྱི་ལས་ཀའི་ཐད་དུ་ལས་གཞིའི་མ་དངུལ་གྱི་རོགས་སྐྱོར་རབ་དང་རིམ་པ་འཐོབ་ཀྱིན་གདའ།",
    "དེའི་ནང་དུ་ལོ་ཆེན་བེ་རོ་ཙ་ན་དང་མཁན་ཆེན་ཉི་མ་བསྟན་འཛིན།",
    "མི་དང་རང་བྱུང་ཁམས་བར་གྱི་འབྲེལ་བ།",
    "གཞུང་དོན་གྱི་ཚིག་དང་རང་སེམས་ཤེས་རབ་གཉིས་མ་དང་།",
    "གསང་སྔགས་ཆེན་པོའི་སྤྱོད་ལམ་འགྲོ་ཉལ་སྨྲ་འདུག་ཅི་བྱེད་ཀྱང་།",
    "ཡང་དེ་བཞིན་དྲན་དུ་འགྱུར་བར་འདུག་པ།",
