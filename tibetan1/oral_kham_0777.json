    "ཚིགས་བཅད་དུ་བསྒྲིགས་པ་མི་དགོས་པ་འདུག་གཙོ་བོར་ཀུན་སློང་ལ་རག་ལས་པས་ཐོག་མར་འདི་ལྟར་བསམ་སྟེ།",
    "གདུལ་བྱའི་དོན་དུ་བྱོན་ལུགས་འདི་འདྲ་ལོས་ཡིན་སྙམ་དུ་བསམ།",
    "དེ་ཐམས་ཅད་ཀྱི་རྩ་བ་བཤེས་གཉེན་ཚུལ་བཞིན་བསྟེན་པ་ལ་རག་ལས་བར་འདུགདེ་ལྟ་བུའི་ལམ་གྱི་རིམ་པ་ལ་སློབ་བ་ཞིག་བྱུང་ན་ཅི་མ་རུང་སྙམ་དུ་བསམ་ལ་ལམ་རིམ་ཆེ་ཆུང་ལས་ཐོག་མར་ལམ་གྱི་ལུས་གཅིག་ཏུ་དྲིལ་ཚུལ་གསུངས་བ་དྲན་ཏེ་ངེས་པ་བརྟན་པར་བྱ།",
    "བསམ་པ་དང་སྦྱོར་བས་བསྟེན་ཚུལ་གཉིས་གསུངས་པའི་བསམ་པ་ལ་དད་པ་དང་གུས་པ་གཉིས་འདུག་དད་པ་སྐྱེ་བ་ལ་མ་དད་པ་འགོག་དགོས་པས་འདི་ལྟར་བསམ་དགོས་ཏེ།",
    "དེ་གཉིས་གང་རུང་མ་ཡིན་པར་གྲུབ་ཚུལ་ཞིག་མེད་པས་ང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དོ་སྙམ་དུ་ཐག་བཅད།",
    "དཔེར་ན་ཉ་བ་མཆིལ་བ་ཐོགས་པས་ཉ་གཤོར་བའི་ཕྱིར་མཆིལ་བ་གཟན་མ་དང་བཅས་པ་མཚོ་ཆུ་ཆེན་པོར་བཅུག་ལ་དེར་བཅུག་པ་དེ་ཉས་མིད་པར་གྱུར་ན་མཆིལ་བ་མེད་པའི་ཉ་དེ་མཚོ་ཆུའི་ནང་ན་འཕྱོ་ཡང་སྐམ་ལ་འདུག་པ་ཉིད་དུ་ཤེས་པར་བྱའོ།",
    "སྲད་བུ་ཡང་མཆིལ་བ་དང་འབྲེལ་བར་གྱུར་ན་ཆུའི་ནང་དུ་འདུག་པ་ཡང་ཡིན་ལ།",
    "སྐམ་ལ་འདུག་པ་ཡང་ཡིན་ཏེ།",
    "ཡུ་བ་སྐམ་ལ་འདུག་ཅིང་ལེགས་པར་ཟིན་ན་ཉ་བ་དེ་འོང་ནས་སྲད་བུ་དེས་ཉ་ཟིན་པར་ཤེས་ཏེ་སྲད་བུ་དེས་བླངས་ནས་ཇི་ལྟར་འདོད་པར་སྐམ་ལ་བྱུང་སྟེ་དགའ་མགུར་བྱ་བ་བྱེད་པའི་དུས་དེ་ཡོད་དོ།",
    "རང་རང་གདམས་པའི་བཀའ་བབས་ཐ་དད་དོ།",
    "རང་རང་བློ་དང་གང་ལ་གང་འཚམས་ཀྱིས།",
    "འདོན་མཁན་སུ་ཡང་མི་འདུག་པས།",
    "དེ་ཡང་རང་དང་རིགས་མཐུན་པའི་འགྲོ་བ་སྐྱོན་དང་བཅས་པའི་རྣམ་པར་བསྟན་པ་ཡིན་གྱི་དོན་དངོས་གནས་ལྟར་གྱི་མཛད་པ་བསྟན་ན་ངས་མཐོང་མི་ནུས།",
    "དེ་གཉིས་ང་ལ་ཨེ་འདུག་དེ་ཡང་རྩ་བ་དད་པ་སྦྱང་བ་ཞེས་གསུངས་པས།",
    "སྤྱིར་མང་རུང་རང་ལ་ཕན་མི་ཐོགས་པ་དཔེར་ན་ཕྱུག་པོ་ནོམ་རྫས་མང་བོ་ཅན་ལོས་ཡོད་ཀྱང་།",
    "དཔེར་ན་གོ་ས་མཐོ་བ་བཙན་ཕྱུག་འཛོམ་པ་འདི་ལས་སྐྱིད་པ་ཞིག་མི་འདུག་སྙམ་པ་ཚོ་ལ་ཡང་དེའི་གོ་སར་བསྡད་ན་དེ་ལས་སྡུག་པ་ཞིག་མེད་པ་མངོན་སུམ་གྱིས་གྲུབ་ཡོད།",
    "དེ་བཞིན་དུ་འགྲོ་འདུག་སྤྱོད་ལམ་ཁ་ཟས་གནས་ཁང་སོགས་གང་ཡིན་ཀྱང་སྐབས་ཤིག་ན་སྡུག་བསྔལ་དུ་གྱུར་འགྲོ་བས།",
    "བྱང་སེམས་དེ་འདུག་པའི་ཤིང་རྟ་དེ་བཞིན་གཤེགས་པའི་དབུ་ལ་ཡང་བཀུར་བར་འོས་པར་གསུངས་པ་དང་།",
    "ཉམས་སུ་ལེན་པ་ལྟ་ཅི་གོ་བ་ཆགས་པ་ཡང་ཤིན་ཏུ་དཀོན་པར་འདུག་པས།",
    "ཞི་ཁྲོ་རབ་འབྱམས་རང་རང་གདན་ལ་བཞུགས།",
    "རང་རང་རྟོག་ངོར་རང་སྐྱ་ཐུབ་པ་ཙམ།",
    "འདི་སྣང་རང་འདོད་རྨོངས་པས་སླད་པ་ཡི།",
    "ཞེས་གསུང་བ་འདིས་མིག་ཕྱེ་འདུག་པས་འདིའི་སྟེང་ནས་བསམ་དགོས།",
    "ལྷ་བདུད་དུ་བབས་ནས་ལྷག་པར་ལོག་རྟོག་སྐྱེ་། བའི་རྒྱུར་འགྲོ་བ་ཡང་འདུག་པས།",
    "ཕར་བལྟས་ན་ཁྱི་ཇི་མ་ཇི་བཞིན་ལོས་ཡིན་ཞེས་གསུངས།",
    "ཁྱིམ་པ་ཚོ་ལ་བློ་རིག་རྩལ་གསུམ་འཛོམས་པ་ཅི་འདྲ་འདུག་ཀྱང་སྐལ་བ་འདི་ལྟ་བུ་མ་རྙེད།",
    "ཁོང་སོ་ཀློད་ཅེས་པ་འདི་གསུམ་གྱི་ནང་དུ་འདུག་གསུངས།",
    "དེ་དུས་གཉེན་ཉེ་དུ་གྲོགས་མཛའ་བཤེས་ཅི་ཙམ་ཡོད་ན་ཡང་ངུས་ནས་འདུག་པ་མ་གཏོགས་ཐབས་མེད་པས་ཞི་བ་ལྷས།",
    "དེ་ལ་མགོ་འཁོར་ནས་འདུག་ཁོམ་མེད།",
    "ཅེས་གསུངས་པ་ལྟར་ངེས་པར་ང་ལ་སེམས་ཞིག་མེད་འདུག་ཞང་སྟོན་བསྟན་པ་རྒྱ་མཚོའི་གསུང་འབུམ་བཞུགས་སོབསམ་དགོས།",
    "ཐུགས་དགོངས་ཞིག་ཡོད་པ་ལོས་ཡིན།",
    "མྱུ་གུ་འདི་མི་སྐྱེ་བར་འདུག་ཅེས་ལག་པས་འཐེན་ན་ཆད་འགྲོ་བ་ལྟ་བུ་ཡིན།",
    "ཕྱག་ལེན་ཡིན་འདུག་པས།",
    "འགྲེལ་གཏོར་ཟུར་དུ་བཤམས་དགོས་པ་མིན་ཀྱང་འདི་ཙམ་ཡང་མེ་ཤེས་པར་འདུག་ཐུན་དང་པོ་ལ་བདག་བསྐྱེད་རྒྱས་པ་དང་།",
    "འདོན་ཆ་ལ་མི་དག་པ་མང་བར་འདུག་ཀྱི་རྡོར་ལ།",
    "འོ་ན་གསང་འདུས་དང་རྟ་མགྲིན་གྱི་སྦྱིན་སྲེག་དེ་ལྟར་ཡིན་པར་གསུང་འདུག་པས་དེའི་སྟེང་ནས་བླུག་ཨེ་ཆོག་ཞུས་པས་དེ་ལོས་ཆོག་གསུང་།",
    "སྦྱིན་སྲེག་ཐམས་ཅད་ལ་ཐབ་ཀྱི་དབུས་སུ་ལྷའི་ཕྱག་མཚན་བཀོད་འདུག་པས།",
    "བདག་བསྐྱེད་ཀྱི་སྐབས་དེ་ལས་བསྐྱེད་འདུག་པས་སོ།",
    "ཁྱད་པར་དུ་གནས་འདིའི་བདག་པོ་གུང་རུ་ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མ་སྐུ་གོང་མ་ནི་ཁམས་གུང་རུའི་ཡིན་པར་འདུག་ལ།",
    "འདུག་པ་ཡོངས་འཛིན་མཆོག་ལ་གསུངས།",
    "སྐུ་གེགས་རྣམ་མང་ཅུང་འདུག་པས།",
    "བདེན་འཛིན་དང་རང་གཅེས་འཛིན་གྱིས་བཅིངས་པའི་འབྲས་ཡུམ་ལ་རིང་བའི་གཞི་ཤེས་དང་།",
    "དཔེར་ན་ཚེ་གང་བོར་སྐྱིད་པོ་བྱས་ནས་འདུག་དགོས་སྙམ་ན།",
    "དེ་ཡང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་རྣམས་སྤོང་བ་ཡིན་པས།",
    "རྫུན་དུ་འདུག་སྙམ་པའི་ལོག་ལྟ་སྐྱེས་ན་ཤིན་ཏུ་མི་རུང་བས།",
    "ཐམས་ཅད་ཀུན་ཀྱང་རང་བྱུང་བདེ་བའི་༧བ་ཞིང་།",
    "འདི་ཀུན་ཤར་ཡང་རང་བཞིན་འགག་མེད་དེ།",
    "གང་སྣང་རང་གཞག་བྱ་རྩོལ་བྲལ་ན་མངོན།",
    "དེ་ཡང་རང་བྱུང་ངང་འདིར་ལྷུན་གྲུབ་པས།",
    "གཉིས་སུ་མེད་པ་ངོ་བོའི་འདུག་ཚུལ་ཏེ།",
    "ཟ་འཆག་ཉལ་འདུག་ཉིན་ཞག་ཕྱམ་གདལ་བས།",
    "ད་ལྟར་སེམས་ལས་གང་བྱུང་རང་ཞིར་གློད།",
    "མཉམ་པར་གྲོལ་ཡང་རང་བྱུང་ཡེ་ཤེས་ཀློང་།",
    "རྒྱལ་བའི་དགོངས་ཀློང་རང་བཞིན་ཡངས་པའི་མཆོག།",
    "དྲན་བསམ་ཐམས་ཅད་རང་བྱུང་རང་ཞི་ན།",
    "རང་བཞིན་བར་མ་འགྲོ་འདུག་གྱིན་འདར་གནས།",
    "གཉིད་ཀྱང་རང་བྱུང་གདོད་མའི་ཀློང་ཆེན་ཏེ།",
    "ཁྱེད་ཅག་ཅི་བྱ་ང་ནི་གང་ན་འདུག།",
    "པནྟིཨུབྷརཱུརིག་པའི་ངང་འདི་ན་སྣང་སྲིད་སྣོད་བཅུད་འཁོར་འདས་སུ་སྣང་ངོ་ཅོག་རང་སྣང་རང་ཤར་རྨི་ལམ་གྱི་ངོ་བོ་ཉིད་དམ།",
    "མ་བརྟགས་ཡེ་ནས་ཆོད་ནས་འདུག།",
    "འདི་ལྟར་རིག་པ་གང་དུའང་མ་གྲུབ་པས་འདི་དང་འདིའོ་ཞེས་མཚོན་དཔེ་དང་རང་བཞིན་ཐམས་ཅད་ལས་འདས་པའི་ཕྱིར།",
    "ནང་རང་བྱུང་ལ་ངོས་ཟིན་ནས་རྩལ་གཞི་ཐོག་ཏུ་གྲོལ་བར་འགྱུར་ཏེ།",
    "ངོ་བོ་དང་རང་བཞིན་མེད་པ།",
    "རང་བྱུང་རང་ཞི་ཉིད་ཤེས་ན།",
    "ུཐམས་ཅད་ཀུན་ཀྱང་རང་བྱུང་བདེ་བའི་ཞིང་།",
    "འདི་ཀུན་ཤར་ཡང་རང་བཞིན་འགའ་མེད་དེ།",
    "ཞི་གནས་ལྷག་མཐོང་རང་ཤར་བས།",
    "བརྩལ་བྱ་རྩོལ་བྱེད་མེད་པར་རང་བྱུང་རང་ལས་ཤར།",
    "རྟོག་པ་ཆུང་ཞིང་རང་བཞིན་དལ།"
  ]
}