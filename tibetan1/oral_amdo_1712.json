    "གལ་ཆེ་བ་ནི་གངས་སེང་འདི་རྒྱ་ནག་གི་གཡུ་འབྲུག་ཇི་བཞིན་མི་རིགས་ཀྱི་བསམ་བློ་མཚོན་བྱེད་ཅིག་ཡིན་ལ།",
    "དེ་བས་བདག་གིས་ད་ལྟའི་བར་དུ་མི་ཚེ་རིག་པའི་གནས་སུ་བཏང་བ་ནི་གངས་སེང་འཚོལ་བའི་གཏམ་རྒྱུད་ཡིན་ལ་གཏམ་རྒྱུད་འདིས་བདག་གིས་ཡོད་ཆོག་པ་མང་བོ་ཞིག་བློས་བཏང་།",
    "མིའི་གནས་སྐབས་ཀྱི་དགོས་པ་བསྒྲུབ་པའི་ཆེད་དུ་རིག་པ་བསྒྲུབ་དགོས་ལ་མིའི་མཐར་ཐུག་གི་དགོས་པ་བསྒྲུབ་པའི་ཆེད་དུ་ཡང་རིག་པ་བསྒྲུབ་དགོས།",
    "གནས་སྐབས་དང་མཐར་ཐུག་གི་དགོས་པ་བསྒྲུབ་པའི་ཆེད་དུ་རིག་པ་སྦྱང་དགོས་ཀྱང་རང་གི་བློ་གྲོས་ཀྱི་གདམ་ཀ་ནོར་ན་རིག་པ་དེ་དག་ཀྱང་རིག་ལོག་ཏུ་འགྱུར་བའི་ཉེན་ཁ་ཤིན་ཏུ་ཆེ།",
    "དེ་བས་རང་གི་མི་ཚེའི་གདམ་ཀ་ཇི་བཞིན་རིག་པ་ཡང་གདམ་ཀ་བྱེད་དགོས་པ་སྨོས་མ་དགོས་པ་རེད།",
    "དེ་བས་ང་ཚོས་ཅི་ཞིག་འཚོལ་བར་གདམ་ཀ་ཡང་དག་པ་ཞིག་དགོས་པ་ནི་མི་ཚེ་ལ་གདམ་ཀ་ཡང་དག་པ་ཞིག་བྱེད་པ་དང་འདྲ།",
    "དེ་བས་ང་ཚོས་གངས་སེང་འཚོལ་དགོས་པའི་དམིགས་ཡུལ་ཡང་དེ་ཡིན།",
    "གཏམ་འདི་དག་ནི་རང་གི་མ་བཅོས་པའི་སེམས་ཀྱི་རང་སྒྲ་ཉག་གཅིག་ཡིན།",
    "ད་ལྟ་བདག་གིས་དངོས་གནས་གངས་སེང་མཐོང་བྱུང་།",
    "འདི་ནི་བདག་གིས་ཡུན་རིང་བོར་འཚོལ་བཞིན་པའི་མི་ཚེའི་རིན་ཐང་ཡིན་ལ།",
    "བདག་གིས་མི་ཚེ་འདིར་ཡོད་ཚད་བློས་བཏང་བའི་འབྲས་བུ་གཟུགས་སུ་ཤར་བ་ཞིག་ཀྱང་ཡིན།",
    "དེ་རིང་གངས་སེང་གི་ཆེད་དུ་འུ་གཉིས་ལས་འབྲེལ་ཞིག་བྱུང་ཡོད་ལ།",
    "བདག་གི་བསམ་བློ་ལ་རྒྱུས་ཆེ་བའི་གྲོགས་པོ་ཞིག་ཏུ་གྱུར་ཡོད།",
    "བདག་རྩོམ་པ་བོ་ཞིག་ཡིན་པའི་ཆ་ནས་རང་གི་ཀློག་པ་བོར་བཀྲ་ཤིས་བདེ་ལེགས་ཞུ་བཞིན་ཡོད།",
    "རྫི་གླུ་ཞིག་གི་བསམ་བློ་དང་སྒྱུ་རྩལ།",
    "བོད་ཀྱི་སྙན་ངག་གི་འཕེལ་རིམ་མི་རིགས་གཞན་དང་བསྡུར་ན་རུས་སྦལ་གྱི་འགྲོས་ལྟར་ནུར་བཞིན་ཡོད་ན་ཡང་།",
    "ལོ་རབས་བརྒྱད་བཅུ་བ་ནས་འགོ་བརྩམས་པའི་ལོ་ངོ་བཅུ་ལྷག་གི་གྲུབ་འབྲས་ལ་བལྟས་ན་ངོ་མ་ཧ་ལས་པ་ཞིག་ཡིན།",
    "དུས་ཡུན་ཐུང་ངུའི་འདིའི་ནང་དུ་བོད་ཀྱི་སྙན་ངག་གི་མ་འོངས་པ་ལ་བསམ་གཞིག་བྱེད་དུས།",
    "ཅིག་ཤོས་ནི་གསར་བ་གསར་རྐྱང་གིས་སྲོལ་རྒྱུན་གྱི་ཁ་གཏད་དུ་ལངས་པ་དེ་ཡིན།",
    "ད་རེས་ཁ་བཏགས་ལྟ་བུའི་དབྱངས་ཅན་མ་ཞེས་པའི་དེབ་ཆུང་འདི་ཀློག་པ་བོའི་སྤྱན་ལམ་དུ་འགྲེམ་པའི་སྐལ་བ་དང་ལྡན་པར་གྱུར།",
    "འདི་ནི་ན་གཞོན་སྙན་ངག་པ་གངས་འཚོ་ལགས་ཀྱིས་ལོ་ངོ་བཅུ་ཕྲག་རིང་ལ་རྔུལ་ཆུ་དང་ཟུངས་ཁྲག་ཐ་ན་ཚེ་སྲོག་དང་འབྲེལ་བ་ཡོད་པའི་དགའ་སྐྱོའི་འགྱུར་བ་ལས་བཏོན་པའི་ལྷག་བསམ་གྱི་སྐྱེས་ཆུང་ཞིག་སྟེ་མགྱོགས་འགྲོས་ཆོལ་ཁའི་རྩྭ་འཇམ་གྱི་ཁྲོད་ནས་དུང་དུང་གིས་གྲགས་པའི་ཁུ་བྱུག་གི་གཞས་ཆུང་བཞིན་ཁྱེད་ལ་སྤྲོ་སྐྱིད་དམ་ཡང་ན་སྐྱོ་དུང་བ་ཞིག་སྟེར་ངེས།",
    "མི་རིགས་འདི་ངོས་དང་ཟུར་ནས་མཐོང་བའི་མྱོང་ཚོར་ཏག་ཏག་ཡིན་པས་དུས་དང་མཐུན་པའི་གྲུབ་འབྲས་དང་དགེ་མཚན་མི་ཉུང་བ་ཞིག་ཡོད།",
    "ཚེ་སྲོག་གི་མདངས་མ་ཡལ་བའི་ལྷ་སྒྲུང་སྣ་ཚོགས།",
    "དེ་དང་དེ་དག་གིས་སྙན་ངག་གི་བག་ཆགས་སྦྲུམ་ཞིང་།",
    "དེ་བས་ཆེས་ཟབ་པའི་བག་ཆགས་དེ་ཡོངས་སུ་སྨིན་ནས་མགྲིན་པའི་དཔྱིད་ཀྱི་དགའ་ཚལ་དུ་སྙན་ངག་གི་འཕང་འགྲོ་ངང་གིས་བརྡོལ་བར་གྱུར།",
    "ཐ་ན་ཚན་རིག་གིས་འགྲོ་བ་མི་རིགས་རང་ཉིད་ལ་ལྕེབས་ཐག་བཟོས་ཏེ་འཛམ་གླིང་ངམ།",
    "རྒྱལ་ཁབ་ཅིག་གམ་མི་རིགས་ཤིག་གི་ཉམས་རྒུད་ཇི་བྱུང་གི་སྡུག་བསྔལ་ལས་སྒྲོལ་བའམ་ཡང་ན་ཞི་བདེ་དང་།",
    "སྙན་ངག་རེ་རེའི་རང་མཚན་གྱི་བསམ་བློའི་སྟེང་ནས་བལྟས་ན་ཡོད་ཚད་ཕ་ཡུལ་དང་འབྲེལ་བ་ཡོད་པར་མ་ཟད།",
    "མི་དང་མིའི་བར་གྱི་འབྲེལ་བའི་སྟེང་གི་བསམ་བློ་གསལ་བྱེད་དུ་ལེགས་བཤདསྙན་ངག་གི་ཚོམ་བུ་མཛོ་མོ་བལ་ཁུརཁྱེད་མྱུར་ཏུ་ཕེབས་ཤོག",
    "འདི་ནི་སྙན་ངག་དེ་དག་ལ་འབྲེལ་ཐབས་མེད་པའི་ཆ་ཤས་ཤིག་རེད།",
    "ལ་བསམ་གཞིག་བྱེད་དགོས་པ་དེ་རེད།",
    "ཁོང་གིས་བལྟས་ན་མི་དང་མིའི་བར་གྱི་འབྲེལ་བ་དང་ཕ་ཡུལ་གྱི་སྣང་ཚུལ་སོགས་ཀྱང་དེང་རབས་དང་འབྲེལ་བ་ཡོད་པས།",
    "རོང་བའི་ཞིང་ཚིགས་བར་གྱི་འགལ་ཟླ་དང་འབྲོག་པའི་རྩྭ་ལོའི་སྟེང་གི་ཞེ་འཁོན་སོགས།",
    "སྙིགས་མའི་ལུས་སུ་ཚེ་གཅིག་ཏུ་འཚང་རྒྱ་བའི་གདམས་ངག་སྟེ་འཇིག་རྟེན་ལ་ཞི་བདེ་དང་འགྲོ་བ་མིའི་རིགས་ལ་བདེ་སྐྱིད་སྟེར་བའི་ཟབ་མོའི་གངས་སེང་འཚོལ་བ།",
    "དེའི་ཕྱིར་ན་ཟླ་ཚོ་གླུ་ཞིག་ལོངས་དང་གངས་སེང་གི་དྲི་བ་ལྟ་བུས་འབོད་སྐུལ་བྱས་ཤིང་གླིང་ལྔ་ཡོམ་ཡོམ་སྒུལ་བའི་ང་རོ་གངས་རིའི་རོལ་དབྱངས་ལྟ་བུས་མི་རིགས་ཀྱི་མདུན་དུ་ལངས་ནས་བདེན་དོན་གྱི་མིག་ཟུང་ལས་ཉི་མ་ལྟ་བུའི་འོད་སྣང་བཀྱེས་པའི་སྐྱེས་བུ་ཆེན་པོ་དེ་དག་ལ་རེ་སྨོན་བྱས།",
    "སྐབས་རེར།",
    "སོགས་སྤྱོད་པ་གཙོ་བོར་སྟོན་པའི་གཞུང་ལུགས་ལ་བརྟེན་ནས་བསམ་གཞིག་བྱེད་དགོས་པ་རེད།",
    "འོན་ཀྱང་བསམ་བློ་དེ་དག་བརྗོད་པ་ཙམ་གྱིས་སྙན་དེབ་འདི་མཐོ་རུ་འཕགས་པ་མ་ཡིན་ཏེ་སྙན་ངག་གི་འགྱུར་བ་དང་འགྲོགས་ཏེ་བསྡུས་བརྗོད་དང་འཆར་ཡན།",
    "ད་དུང་སྙན་ངག་གི་ངོས་དང་ཟུར།",
    "ཡང་ན་སྐབས་ཐོབ་དང་དངོས་ཤུགས་ཅི་རིགས་སུ་ཆུ་ཕྲན་བཞུར་བ་ལྟར་ངང་གིས་བརྡོལ་བ་འདི་ཡིན་ཏེ་མཐར་གཏུགས་ན་སྙན་དེབ་འདིའི་དམིགས་བྱ་ནི་ཞི་བདེ་ཞེས་པའི་རླབས་ཆེ་བའི་ཐ་སྙད་འདིའི་ནང་དུ་འདུས་ཡོད།",
    "འོན་ཀྱང་མཚོན་ཐབས་དང་སྒྱུ་རྩལ་ཞེས་པའང་ཆ་ཤས་དུ་མས་གྲུབ་པ་ལས་སྤྱི་དང་བྱེ་བྲག་གི་ནུས་པ་ཁྱད་པར་ཅན་འདོན་དགོས་པ་ཡིན་པས།",
    "བཅད་ལྷུག་གང་ཡིན་རུང་གཙོ་བོ་བརྗོད་འདོད་ལ་རག་ལས་ཤིང་རང་མོས་ལུས་དེ་རང་རེའི་སྐད་དུ་གངས་སེང་འཚོལ་བ།",
    "ཚིག་གི་ཆ་ནས་ངག་ཐོག་ཏུ་རྒྱུགས་ཆེ་ཞིང་བྲོ་བ་ལྡན་ལ་གོ་སླ་བ་ཏག་ཏག་བེད་སྤྱོད་བྱས་འདུགདེ་ཡང་ཡིན་ཏེ།",
    "སྙན་ངག་ནི་འཚོ་བའི་སྐད་ཆ་དྭངས་མ་ཡིན་པ་དེ་སྟེང་ནས་སྙན་ངག་གི་སྐད་ཆ་འཚོ་བ་ལས་བྱུང་བའི་སྤྱི་འགྲོས་སྐད་ཅིག་ཡིན་པ་ལས་མཁའ་འགྲོ་བརྡ་སྐད་དམ་ཤ་ཟའི་རང་སྐད་ཅིག་ཅིས་ནས་ཀྱང་མ་ཡིན།",
    "འདིའི་མིང་དང་ཚིག་ལ་ཚིག་རྒྱན་གཙོར་བསྙེགས་ཀྱིས་བརྡ་སྐད་སྤྱད་ཡོད་ལ་དེ་ཡང་སྔོན་བྱོན་མཁས་པའི་སྙན་ངག་གི་བརྡ་དང་འཚོ་བ་ལས་རྒྱུགས་ཆེ་བའི་སྤྱི་འགྲོས་སྐད་མང་བོ་བཀོལ་འདུག་པ་འདིས་རྣམ་པ་གསར་བ་ཞིག་བསྟེར་ཐུབ།",
    "སྙན་ངག་ཅིག་གི་ཡོན་ཏན་ནི་མཚོན་ཐབས་དང་སྒྱུ་རྩལ་སྤྱད་ཡོད་པ་དེ་མ་ཡིན་པར་དེ་གཉིས་ཀྱི་སྙན་ངག་ལ་ནུས་པ་ཆེན་པོ་ཐོན་ཡོད་པ་དེ་ཡིན།",
    "དེ་བཞིན་སྙན་དེབ་འདིར་ཧ་ཅང་མང་མོད་རེ་རེ་བཞིན་ངོ་སྤྲོད་ཀྱིས་མི་ལང་བས་སྤྱི་མཚན་ལས་བལྟས་ན་ཕྱོགས་འདི་དག་ཏུ་འདུས་སྙམ།",
    "དབྱངས་ཅན་མ་དང་སྤྱན་རས་གཟིགས་ལས་རེ་སྨོན་ཇི་བཞིན་བརྗོད་པ།",
    "འུད་བརྗོད་བཅས་གང་བརྗོད་ནའང་རང་བཞིན་བརྗོད་པའི་ཆ་ཤས་ཤིག་འདུས་ཡོད་དེ་དེ་མེད་ན་བདེན་དོན་གྱི་རྨང་གཞི་མེད་པས་ཀློག་པ་བོས་རོ་མྱོང་བའི་ཚེ་ན་ཆུ་ལ་ཆུ་བཞག་ལྟར་སྙན་ངག་གི་འགྱུར་བ་རང་སེམས་ལ་སིམ་པའི་ནུས་པ་ཡོད་པ་མ་རེད།",
    "དབྱངས་ཅན་མ་ནི་ཁོང་གི་བསྡུས་བརྗོད་ཀྱི་གཙོ་བོ་ཡིན་ལ་ད་དུང་གྲོགས་པོ།",
    "ཁོང་གི་བསྡུས་བརྗོད་ཀྱི་མཚོན་སྟངས་ནི་སྒྱུ་རྩལ་ཁ་ཡན་པ་ཞིག་མ་ཡིན་པར་བོད་ཀྱི་གོམས་སྲོལ་དང་རང་གི་བརྩེ་དུང་།",
    "ཕྲ་མོའི་རྒྱན།",
    "རབ་རྟོག་གི་རྒྱན།",
    "དཔེར་ནབདག་གི་རྗེ་བཙུན་སྒྲོལ་མ་དུས་བཞིའི་དྲན་སྣང་ཁྲུང་ཁྲུང་ནང་སེམས་ཀྱི་གཏམ་རྒྱུད་ཁྱེད་མྱུར་དུ་ཕེབས་ཤོག་ལྟ་བུ་སོགས་སྟེ་དེ་དག་ལས།",
    "ཡུན་རིང་གི་རྗེས་སུ་ངའི་རྨི་ལམ་ཇི་བཞིན་ཁོ་མོ་རྫ་ཆེན་གྱི་སྨུག་པའི་ཁྲོད་དུ་ཡལ་འདུག་ཨ།",
    "རྨི་ལམ་ལྟ་བུའི་བུ་མོ་ད་ལྟའི་མིག་མདངས་མཐོང་ཚེ།",
    "སྤྲིན་དཀར་ལྟ་བུའི་མཚར་སྡུག་མེ་ཏོག་ལྟ་བུའི་བསུང་ཞིམ་ཨ་མ་ལྟ་བུའི་བྱམས་བརྩེ་དང་མེ་ལྕེ་ལྟ་བུའི་བུ་མོ་སྐར་ཆེན་ལྟ་བུའི་མིག་འོད་ཟླ་འོད་ལྟ་བུའི་འཛུམ་དཀར་དྲི་བཞོན་ལྟ་བུའི་བསུང་ཞིམ་རྨི་ལམ་ལྟ་བུའི་བུ་མོ་ཡུན་རིང་རྗེས་སུ།",
    "མེ་ཏོག་གི་གོས་རྒྱན་ལྡེམ་ལྡེམ་སྨུག་སྤྲིན་གྱི་རྦ་རླབས་ཡོམ་ཡོམ་དང་བེམ་རོའི་དགོད་སྒྲ་དང་ལྐོག་གཡོའི་གླུ་དབྱངས་བརྩེ་དུང་གི་རྒུན་ཆང་ཞིམ་པོ་ཁྱོད་ཀྱི་བྲང་ཁོང་ན།",
    "ངའི་སེམས་ཁོང་དུ་རིམ་བཞིན་ཁྱོད་ཀྱི་མེ་ཏོག་བཞད་ཅིང་མེ་ཏོག་གི་བསུང་ཞིམ་དེ་ང་ཁོ་ནས་ནམ་རྒྱུན་ཚོར་དྲོད་འཇམ་གྱི་སྣང་བ་དཀར་བོ་རྒྱང་ལ་གཏད་ཡོད།",
    "མྱོང་ཚོར་བཏོན་པ་ལ་ཕན་ནུས་ངེས་ཅན་ཞིག་ཡོད།",
    "ད་དུང་མཚོན་ཐབས་ལས་ཐུན་མིན་ཕྲ་ཞིང་ཞིབ་པ་རེ་ཡོད་མོད་མང་དུ་དོགས་ནས་མ་སྤྲོས་སོ།",
    "འོན་ཀྱང་འདི་ནི་གསར་རྩོམ་གྱི་ལམ་དུ་འབྱུང་ངེས་པ་ཞིག་ཡིན་པས་ཡ་མཚན་པ་ཅི་ཡང་མེད་ལ་འགེབས་པའི་དགོས་པའང་མ་མཆིས་ཏེ་སྙན་ངག་པ་ཞིག་གི་ཞན་ཆ་ནི་ཁོའི་སྙན་ངག་གམ་ཁོ་ལ་སྐྱོན་ཡོད་པ་དེ་མ་ཡིན་པར་སྐྱོན་ཆ་འགེབས་པ་དང་ཁས་མི་ལེན་པ་དེ་ཡིན།",
    "དེའི་ཕྱིར་ཀློག་པ་བོས་སྙན་དེབ་འདིའི་དགེ་སྐྱོན་ལས་ཁོང་ལ་འབྲེལ་གཏུགས་བྱས་ཆོག་སྔོན་འགྲོ་བྲིས་ནས་མཇུག་སྒྲིལ་བའི་དུས་འདིར་ངའི་ཡིད་ལ་སྔོན་འགྲོ་དྭངས་མོ་ཞེས་པའི་སྙན་ངག་ཅིག་བརྡོལ་བྱུང་བ་འདི་ལྟར།",
    "རེ་སྨོན།",
    "འཛུམ་ཆུང་ལྟ་བུའི་མེ་ཏོག་གི་གང་བུ་གྲོལ་ཚེ།",
    "སེམས་པའི་ཚེམས་ཕྲེང་གི་མདངས་སུ་བཞད་པ།",
    "འཆར་ཡན་ཇི་བཞིན་གྱི་སེམས་པ་ཕྲ་མོ།",
    "ད་དུང་སྔོན་འགྲོ་དྭངས་མོ།",
    "མི་རིགས་ཤིག་ཡུན་དུ་གནས་མིན་ནི་དེའི་ཐུན་མོང་མ་ཡིན་པའི་རིག་གཞུང་སྟེ།",
    "ང་ཚོས་ཉེན་ཁ་འདི་ལས་སྡིགས་སྨྲེ་རེ་བཏོན་ཏེ་ལེ་བདའ་ཡིས་ཉི་མ་བཏང་ན་འགྲིག་གམ།",
    "ཕལ་བའི་ལྷག་བསམ་གྱི་རྒྱབ་སྐྱོར་བཅས་མཁོ་ཞིང་ལྷག་པར་གར་འགྲོ་གཏོལ་ལ་བྲལ་བའི་དེ་རིང་གི་དུས་འདིར་དེ་བས་ཀྱང་དགོས་གལ་ཆེ།",
