    "ང་ཚོའི་འོ་མ་འདི་ལས་འབྲི་མར་སེར་བོ་འབྱུང་ངེས་ཡིན་ལ།",
    "ང་ཚོའི་ཁ་བ་དཀར་བོ་ནི་འདབ་མ་དྲུག་པའི་ལང་ཚོ་ཡིན།",
    "འདབ་མ་རེ་རེ་ཡི་གེ་རེ་རེས་གྲུབ།",
    "དུས་རབས་གང་ལྟར་འགྱུར་ནའང་དཀར་བོ་ཡི་ལང་ཚོ་ཡལ་མི་སྲིད།",
    "དེ་ལྟ་བུའི་རེ་སྨོན་དུ།",
    "ཡིན་ནའང་ཁྱོད་ཀྱིས་དེ་དག་ཀློག་དུས་དེའི་ནང་དུ་རིག་པའི་གཟི་འོད་ཅིག་དང་རེ་བའི་འོ་མ་ལྷུང་ལྷུང་དུ་བཞུར་བཞིན་པ་མཐོང་མྱོང་ངམ།",
    "ཀ་ཁ་སུམ་ཅུ་མ་འཚོས་ནའང་ང་ཚོས་ཕ་མེས་རིང་ནས་རྩམ་པ་ཟོས་ཏེ་པགས་པ་གྱོན་པ་མ་ཡིན་ནམ་ཞེ་ན་དེ་ནི་དངོས་འབྲེལ་བདེན་པ་ཞིག་ཡིན་མོད་ཡིན་ནའང་རྒྱ་མིའི་ཁ་དཔེར།",
    "ཁྱིམ་དེ་ཕག་ཚང་ཞིག་གི་དོ་ཟླ་མིན་ཞེས་པ་འདིར་བལྟས་ན་ང་ཚོའི་ཁྱིམ་ཚང་དག་ནི་ཕག་ཚང་ཞིག་གི་དོ་ཟླ་ཡིན་མིན་ལ་འདང་རྒྱག་རྒྱུ་ནི་ཤིན་ཏུགལ་ཆེ་བ་ཡིན།",
    "རིག་པའི་འཇིག་རྟེན་དེ་ནིམཐར་གཏུགས་ན་རང་ཉིད་ཕག་པ་དང་ཁྱད་འབྱེད་པའི་ཁྱད་ནོར་གལ་ཆེན་ཞིག་ཡིན་ལ་ང་ཚོས་ལུག་འཚོ་བཞིན་འཚོ་བ་རོལ་ནའང་མཁས་པས་བལྟས་ན་སྔར་བཞིན་དུད་འགྲོ་ལས་མ་འདས་ཏེ་ས་སྐྱ་པཎ་ཆེན་གྱིས།",
    "དེ་ནི་ང་ཚོ་དུད་འགྲོ་ནས་དུད་འགྲོར་འགྱུར་བཞིན་པའི་རྟགས་མཚན་འབའ་ཞིག་ཡིན་ནོ།",
    "རེ་སྨོན་གྱི་མྱུ་གུ་རེ་སྨོན་གྱི་མྱུ་གུའི་སྔོན་འགྲོ།",
    "མའི་ཚོར་སྣང་ངོ་མ་མྱོང་ཐུབ་ལ་གཡའ་མ་གོས་པའི་གཞོན་ནུའི་སེམས་ཁམས་དྭངས་མོ་དེའང་མཐོང་ཐུབ།",
    "ལྷག་པར་ལོ་རིམ་དང་བོས་གངས་སེང་གི་ངར་སྐད་བསྒྲགས་མི་འོས་པ་དེ་རེད།",
    "ཚིག་དོན་ཆ་ནས་ཀྱང་རྩོམ་དེབ་གཞན་དང་དོ་མཉམ་པ་ཞིག་རེད།",
    "སློབ་གྲོགས་འདི་དག་གི་སྤོབས་པ་དང་ཤེས་རབ་ལ་བལྟས་ན་མྱུ་གུ་འདི་ལྗོན་པར་འགྱུར་ངེས་ལ་ལྗོན་པར་གྱུར་ནས་ཀྱང་ང་ཚོའི་ལྗོངས་འདིར་གཡུར་དུ་ཟ་བའི་འབྲས་བུ་མང་བོའི་དགའ་སྟོན་ཞིག་སྦྱིན་ངེས་རེད།",
    "དོན་འགྲུབ་ཚེ་རིང་ནི་ཁྱིམ་ཚང་དབུལ་བོ་ཞིག་གི་རེད།",
    "ཡིན་ནའང་སློབ་སྦྱོང་ནི་ཁོང་གི་དུས་ཚོད་རེད།",
    "དེ་གཙོ་བོ་རང་གིས་སྦྱངས་མིན་ལ་རག་ལས་པ་མ་ཡིན་ནམ།",
    "འདི་ལ་རྒྱུ་རྐྱེན་མང་བོ་ཡོད་ན་ཡང་ང་ཚོས་དེ་ལྟ་བུའི་དམིགས་ཡུལ་དུ་མ་བཟུང་ན་ག་ལ་འགྲིག།",
    "ལྷུང་ལྷུང་གི་བཞུར་རྒྱུན།",
    "དེ་བས་ང་ཚོའི་མི་རིགས་འདི་གླུ་གར་གྱི་རྒྱ་མཚོ་ནས་རྩོམ་རིག་གི་རྒྱ་མཚོར་སྙེག་གིན་ཡོད་པའི་གནས་ཚུལ་འདི་མཐོང་ཐུབ།",
    "གཞོན་ནུ་དག་གིས་སློབ་སྦྱོང་མི་བྱེད་པ་ནི་དེ་བས་ཀྱང་བླུན་པའི་གླེན་པ་ཁ་ནག་ཅིག་ཡིན་པ་ནི་བརྒྱ་ཆའི་བརྒྱས་ཐག་ཆོད་པ་ཡིན་ནོ།",
    "དད་པའི་པད་མོ་འཛུམ་པའི་ཉིན་བྱེད།",
    "ལུང་རྟོགས་ཀྱི་བསྟན་པ་སྤེལ་བ་སོགས་བྱ་ཉུང་དོན་ཉུང་དང་འདོད་ཆུང་ཆོག་ཤེས་ཀྱིས་རི་དྭགས་རྨས་མ་བཞིན་གནས་པ་ནི་ངོ་མ་ཡ་མཚན་པ་སྟེ་དེང་གི་དུས་རབས་འདིར་བདག་ཅག་གི་སྟོན་པ་བྱོན་པ་བཞིན་ཆེས་ཡ་མཚན་པ་ཞིག་རེད།",
    "ལྷག་པར་སྤང་དཀའ་བ་ནི་ཉེ་རིང་ཆགས་སྡང་རེད།",
    "དེ་ནི་སྐྱེས་བུ་དམ་པ་རེད།",
    "སོ་སྐྱེའི་མཛད་པ་ཡིན་ན་ངོ་མ་ཡ་མཚན་པ་རེད་ཅེས་སྙམ་པ་ཤར་ཡོང་།",
    "དེང་གི་སྐྱེ་བོ་ཕལ་བ་དག་གི་རྣ་བར་འགྲོ་དཀའ།",
    "དེ་བས་ཁོང་གི་ཐུགས་རྒྱུད་དང་མཛད་པ་འཕྲིན་ལས།",
    "སུས་ཀྱང་ཁོང་ཉིད་འཛམ་གླིང་གི་རླབས་ཆེ་བའི་མི་སྣ་ཞིག་ཏུ་འགྱུར་བ་བློ་ཡུལ་ལ་ཡང་འཁོར་མེད།",
    "གཏན་ཚིགས་བཅུད་དུ་འདྲེས་པ་སོགས་ཀྱིས་བྲིས་ན་དངོས་གནས་དད་པའི་པད་མོ་རྒྱས་པའི་ཉིན་བྱེད་དུ་འགྱུར་རོ།",
    "བུ་མོ་མ་ཡིས་མི་བསྟོད་གནས་ཀྱིས་བསྟོད།",
    "དགུང་མོར་མང་རའི་དགོན་ཆེན་དུ་བྲིས།",
    "བཙན་པོའི་ཞབས་རྗེས་ཞེས་པའི་ཐ་སྙད་འདི་མཐོང་མ་ཐག་ང་ཚོའི་ཡིད་ལ་སྤོབས་པ་ཞིག་དང་ང་རྒྱལ་ཞིག་སྐྱེས་འོང་།",
    "ང་ཚོས་གཞན་འཚོལ་མི་དགོས་པར་ང་ཚོ་རང་ཉིད་འཚོལ་དགོས་ཏེ་ང་ཚོ་རང་ཉིད་ཀྱི་འཇིག་རྟེན་དེར་གང་ཞིག་ཆད་ཡོད་པ་དང་གང་ཞིག་མི་འདང་བའི་ཞན་ཆ་དེ་འཚོལ་དགོས།",
    "སྐར་མ་འདི་དག་གིས་རང་ལུས་འོད་དུ་བསྲེས་ནས་འཇིག་རྟེན་ལ་འོད་སྣང་སྟེར་བཞིན་ཡོད་ལ་ཚེ་སྲོག་ཡོད་ཚད་སྤྱད་ནས་རང་ལུས་ལ་འོད་སྣང་འཚོལ་བཞིན་ཡོད།",
    "དེ་རིང་གི་ཉམ་ཆུང་གི་བཞིན་རས་འདི་ལ་བརྟེན་ནས་རང་གི་འཇིག་རྟེན་ཞིག་བསུ་རྒྱུ་ནི་དེ་རིང་བཙན་པོའི་ཞབས་རྗེས་ཀྱི་རེ་བ་ཡིན་ལ་ང་ཚོ་མི་རིགས་འདིའི་རེ་བའང་ཡིན།",
    "ཁྱོད་རང་སྤོབས་པ་ལ་དགའ་འམ།",
    "དེ་དག་ནི་སྙན་ངག་གི་ཟུངས་ཁྲག་ཡིན།",
    "ཁྱོད་རང་སྤོབས་པ་ལ་དགྱེས་སམ།",
    "དྭངས་གཙང་གི་རོལ་དབྱངས་ཤིག་འཕྱུར་ཚེ་དེ་ནི་སྙན་ངག་ཡིན།",
    "ཁྱོད་རང་ཞོགས་པ་ཞིག་ཏུ་འགྲིམ་འདོད་ན།",
    "འདི་ན་དྲག་ཏུ་འཕྱོ་བཞིན་པའི་མེ་ལྕེ་ཞིག་ཡོད་པ་ནི་སྙན་ངག་གི་མེ་ལྕེ་ཡིན་ལ་འདི་ནི་གསར་དུ་འཛུམ་བཞིན་པའི་ཁ་བའི་མཚན་ལྗོངས་སྟེ།",
    "ལང་ཚོའི་མེ་ལྕེ་ཞིག་ཡིན་ལ་རོལ་དབྱངས་ཀྱི་ཞོགས་པ་ཞིག་ཡིན་ནོ།",
    "ཁྱོད་ཀྱིས་ཞིབ་ཏུ་གཟིགས་དང་།",
    "ཁ་བའི་མེ་ཏོག་གིས་སྐྱོ་གདུང་གི་གསེབ་ནས་ཡི་གེ་དྲུག་མའི་སྤོབས་པ་མཐོང་ངེས་ཡིན་ལ།",
    "ཡིད་མི་ཆེས་ན་ཁྱོད་ཀྱིས་ཁ་བའི་མཚན་ལྗོངས་ལ་གཟིགས་རོགས།",
    "གསུམ་དུ་བུ་མོ་ཞིག་གི་མིང་སྟེ་འཛམ་གླིང་ཟླུམ་པོ་འདིའི་སྟེང་དུ་དགྲ་གཉེན་གྱི་ཆགས་སྡང་ཆེས་གསལ་བའི་བྲག་སྲིན་མོའི་ཚ་མོ་དག་གི་མཚོན་བྱེད་ཡིན།",
    "དེབ་འདི་ལས་བོད་ཀྱི་བུ་མོ་དག་གིས་བདེ་སྡུག་དང་ཕུགས་བསམ།",
    "བསམ་བློ་བ་སོགས་རང་གི་རྨི་ལམ་ལས་ཡལ།",
    "སྒྲོལ་མ་སྙན་ངག་གི་བརྗོད་བྱ་ཙམ་ཡིན་ནམ།",
    "སྒྲོལ་མ་ནི་སྤྱན་རས་གཟིགས་ཀྱི་གྲོགས་སུ་སྦྲན་པའི་མྱུར་མ་དཔའ་མོ་ཡིན་པས་རང་གི་བདག་པོ་རང་ཉིད་དུ་བྱེད་པའི་དཔའ་མོ་ཞིག་ཅི་ལ་མིན་སྲིད།",
    "དེ་བས་ངའི་བསམ་པར་བུད་མེད་དག་ནི་སྒྲོལ་མ་ཡིན་དགོས་པ་ལས་འཕྱོར་རྫས་ཡིན་མི་རུང་ལ་རྨ་བྱ་ཞིག་ཀྱང་གཏན་ནས་ཡིན་མི་རུང་བ་ནི་བོད་ཀྱི་བུད་མེད་དག་གིས་གསལ་བོར་ཤེས་དགོས་སོ།",
    "མི་རིགས་ཤིག་ལ་མཚོན་ན་སྙན་ངག་མེད་དུ་མི་རུང་བ་བཞིན་དུ་རི་མོ་ཡང་མེད་དུ་མི་རུང་བ་ཞིག་རེད།",
    "རི་མོ་ཡིན་ནའང་འདྲ།",
    "འོ་ན་བོད་ཀྱི་རི་མོ་གང་འདྲ་ཞིག་ཡིན་ནམ།",
    "རང་གིས་རང་ལ་བལྟས་ན་ད་དུང་བྱིས་པ་ཞིག་སྟེ་གོག་ནས་འགྲོ་བའི་བྱིས་པ་ཞིག་རེད།",
    "ད་དུང་བྱིས་པ་ཞིག་ཡིན་པ་འདིས་ང་ཚོ་དགའ་ཞིང་ང་ཚོ་སྐྱོ་བའང་སྐྱེ་འོང་།",
    "དགའ་བ་ནི་བྱིས་པ་ཞིག་ཡིན་ན་འཚར་ལོངས་འབྱུང་ངེས་ཡིན་ལ་མ་འོངས་པར་བོད་ཀྱི་མི་རིགས་འདིའི་རེ་བ་གཏད་སའི་བྱིས་པ་ཞིག་ཡིན་པ་དེ་ཡིན་ལ།",
    "འོ་ན་ང་ཚོ་བོད་ལ་ལྷ་རིས་སྒྱུ་རྩལ་ཞིག་མེད་པ་ཡིན་ནམ་ཞེ་ན་ཡོད་ནི་ཡོད་དེ།",
    "བོད་ཀྱི་རི་མོས་སྒྱུ་རྩལ་གྱི་ཐབས་ལམ་གསར་བ་ཞིག་བསྙེགས་པའི་གོམ་པ་དང་བོའང་སྤོས་པ་རེད།",
    "དེ་བས་དེབ་འདིའི་མདུན་ལམ་ཆེས་ཡིད་དུ་འོང་བ་ཞིག་རེད་ལ་ཆེས་མཚར་སྡུག་ལྡན་པ་ཞིག་ཡིན་ངེས་པས་ངས་ཆེད་དུ་ཀློག་པ་བོ་དག་གིས་ཚབ་བྱས་ནས་བཀྲ་ཤིས་བདེ་ལེགས་ཞུ་བཞིན་ཡོད་པ་རེད།",
    "གནའ་ནས་ད་བར་དུ་འགྲོ་བ་མིའི་རིགས་ཀྱིས་རྩ་འཛུགས་དང་བྱེད་ཐབས་སྣ་མང་སྤྱད་ནས་བདེ་སྐྱིད་བཙལ་མོད་བདེ་སྐྱིད་ནི་སེམས་ནས་ཐོན་དགོས་པ་ཞིག་ཡིན་པས་སྤྱིའི་ཆ་ནས་བདེ་སྐྱིད་ཐག་གཅོད་ཐུབ་མེད།",
