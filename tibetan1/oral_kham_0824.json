    "སྐྱེ་གནས་བརྒྱ་ཞེས་བྱ་བ་ནི་རོའི་སེན་རྩི་དང་རོ་ཙ་ནས་གྲོ་ག་ལ་སྔར་བསྟན་པའི་འཁོར་ལོ་མིང་དང་སྤེལ་བ་བྲིའོ།",
    "དེ་ནས་དགེ་ཚུལ་དགེ་སློང་གཉིས་པོ་དུམ་ནས་ཐ་དད་མེད་པར་འདུག་གོ།",
    "འཇིག་རྟེན་ཁ་ངག་སྐྱིད་སྡུག་བླ་འོ་ཙམ།",
    "གསེར་ཁྱམས་ཞེས་བྱར་འདུག་ཚེ་ཀརྨ་པ།",
    "དོན་གྱི་མ་ཡར་ཉིད་དུ་ཐོབ་པར་འདུག།",
    "ཁོ་རང་ཉིད་ཀྱི་འང་བུ་རུ་འཛིན་པའོ།",
    "ཁོ་རང་ཡིན་སྙམ་ང་རྒྱལ་མཛད་པའི་ཚེ།",
    "ཁོང་རང་ལ་ཡང་དེ་ལྟར་གདའ་བ་སྟོན།",
    "ཁོང་རང་ཡབ་ནི་ཨ་ནུ་བཙན་ཕྱུག་ལའང་།",
    "དགོངས་པའི་གདེང་ལ་དེ་ག་འདུག་པ་དེ།",
    "རིང་བསྲེལ་བྱོན་ནས་གདའ་བས་ཨ་ནུ་མཉེས།",
    "རྣམ་རྟོག་བྱུང་ཚེ་རུས་སྒོག་བེད་གཅིག་གདའ།",
    "མགོ་རུས་ལྷ་བའི་དཀྱིལ་ནས་བྱོན་གདའོ།",
    "ཁྱེད་རང་བསྙེན་སྒྲུབ་མཛད་པའི་ཡི་དམ་ལྷ།",
    "གཟུགས་བརྙན་ཧ་ཅང་མ་དོད་པ་འདུག་སྐད།",
    "ཡིན་པར་འདུག་ཅེས་ཡང་ཡང་སྨྲ་བ་ཐོས།",
    "ཨ་ནུས་སྦྱར་བ་ཡིན་ནམ་སྦྱར་འདུག་པའི།",
    "དམར་པོ་ཞིག་ནི་བྲེས་ཏེ་གདའ་བ་མཐོང་།",
    "ཁྱིམ་དུ་ཇོ་རུའི་རུམ་དུ་ཉལ་ཙ་ན།",
    "སྲུང་ལུགས་ཤེས་པར་འདུག་ཀྱང་མ་བསྐྱངས་སོ།",
    "དབྱར་དགུན་རྒྱུན་དུ་ཐབ་ཁའི་ལྟག་དེར་འདུག།",
    "མགུར་འབུམ་ནང་དུ་ཅི་འདྲ་གདའ་ཟེར་བས།",
    "ང་རང་ལོ་བརྒྱད་ལོན་དུས་ཨ་ནུ་ཡི།",
    "དེ་དུས་གཟུགས་ཆུང་རྩམ་པ་ཕོཪ་ཤུབ་གང་། སོགས་པ་དེ་ལ་ང་རང་ཁྱག་ཐང་གདའ།",
    "ལོ་ནི་བཅུའམ་བཅུ་གཅིག་དུས་ཙམ་ནས་། རྗེས་གནང་བསྔོ་བ་ཐུབ་ཙམ་འོང་རྒྱུར་འདུག།",
    "བསྡམས་། རྡུང་རྡེག་བྱིས་སྦ་སྡིགས་པར་མཛད་འདུག་པས།",
    "དེ་ནས་སྐུ་སྐྱེ་རང་ཡང་བཞད་ཅིང་གདའ་། དེ་སྐོར་སྐུ་མདུན་སི་ཏུ་ཕེབས་པ་ལ།",
    "གཅིག་འདུག་བདག་ནི་དེ་ཡི་སྟེང་དུ་ཕྱིན།",
    "དེ་ཚེ་འདུག་ཚུགས་ངག་མི་འཆོར་བ་སོགས།",
    "མི་རྒན་ཞིག་དང་ཁྱད་པར་མི་འདུག་ཅེས་། སློབ་དཔོན་གྱིས་ནི་བསྟོད་ར་མང་དུ་མཛད།",
    "བལྟས་ན་ང་རང་ལས་འཕྲོ་སད་རྟགས་ལགས།",
    "དྲག་སྔགས་དཔེ་ཞིག་གཞན་ལ་འཚོང་འདུག་པས།",
    "ཡར་ཞུས་པ་ནི་ང་རང་ཁོ་ན་ཡིན་། བྱིསྦ་འདི་ཡི་ཡི་གེ་སྐྱེན་པ་ཞེས།",
    "འདུག་ནས་དག་དང་མ་དག་འདོན་ནོན་བྱེད།",
    "ང་རང་ཡང་ནི་བླ་ཆག་ནོར་ཤོམ་བྱུང་།",
    "སློབ་དཔོན་ཞལ་ནས་ཁྱེད་རང་རྡེལ་རྣམས་རྒྱོབ།",
    "ངེད་གཉིས་དཔྱད་ནི་འདུག་གསུངས་ངས་བརྒྱབས་པས།",
    "དེ་ཡི་བུ་ཚ་ངོ་ཤེས་ཞིག་འདུག་པས།",
    "ཅེས་ཀྱང་འགྲོ་ཟེར་དོ་དམ་བྱེད་འདུག་ཅིང་། ཁྱིམ་པ་རྣམས་ཀྱང་མི་འདོད་མེད་ཙམ་གདའ།",
    "མལ་སར་འདུག་ན་གཉིད་ན་འགྲོ་འདུག་པས།",
    "དེ་ཡི་སྟེང་དུ་རང་ཉིད་ཙོག་པུར་འདུག་མལ་ས་གྲང་དོགས་གོས་གཤམ་སྟན་ལ་བཀབ།",
    "རས་ཆུང་པཎ་ཞུ་འདྲ་ཞིག་བཟོས་འདུག་པ་། པད་མ་མཐོང་གྲོལ་ཡིན་ནོ་ལན་གསུམ་གསུངས།",
    "སྒར་དེ་འཁྱེར་ཁ་ཤིན་ཏུ་ཆེ་འདུག་པ།",
    "སློབ་དཔོན་གྱིས་ཀྱང་བཀག་པ་མི་གདའ་སྟེ།",
    "ང་རང་ན་སོ་ཆུང་ཡང་བསམ་པ་ཆེ།",
    "ང་རང་ཡང་ནི་དེ་དང་འདྲ་ན་ཡང་།",
    "མཚམས་དུས་མ་གཏོགས་འདུག་རྒྱུ་ཡུད་ཙམ་མེད།",
    "འདུག་རྒྱུ་བྱུང་ན་ཟ་ཡིག་འཁོར་ལོ་དང་།",
    "ང་རང་བཅའ་ཚོགས་མགྱོགས་ཤིང་འདོན་བཟང་བ་། བུ་ཆུང་ཡིན་པས་དགའ་མགུ་བདེ་བ་དེས།",
    "ཁོང་རང་ལྷ་དེ་རྡུང་བློ་མེད་ཞུས་པས།",
    "ཆུ་རྩད་གདའ་བ་བརྐོས་པས་ཆུ་མིག་བྱུང་།",
    "སློབ་དཔོན་ཕ་མ་གཉིས་ཀྱང་གཏམ་ཞིང་འདུག།",
    "དེ་ཡང་རང་ལ་ཁ་ཐབས་མེད་པ་ཡི།",
    "ང་ཡི་བསམ་པ་མཁྱེན་ནས་གདའ་འོ་བསམ།",
    "དགེ་སློང་གཉིས་ལ་བཀའ་ཤོག་བསྐུར་ནས་ཀྱང་། གྲྭ་རྒྱུན་གང་མང་ཐོངས་ཤོག་གསུངས་པར་གདའ།",
    "ལངས་འདུག།",
    "ཞྭ་དམར་པ་དེ་བགྲེས་ཉམས་ཆེ་ཟེར་བས་། ང་རང་མ་མཇལ་གོང་དུ་འདས་དོགས་ནས།",
    "ཕྱི་རབས་འགྲོ་འདུག་བྱེད་པའི་བན་སར་རྣམས།",
    "བཞི་བཅུ་ལྷག་ཙམ་འདུག་ལ་ཤོག་ཇ་བསྐོལ།",
    "དྲུང་པས་གྲལ་བཞག་དགོས་ནི་གསུངས་གདའ་སྟེ།",
    "ཇ་ཐུག་འདྲེན་པ་མི་ཤེས་དཀའ་འདུག་སྟེ།",
    "དཀྱིལ་འཁོར་ཆེ་གྲ་འདོམ་པ་བཞི་ལྔ་འདུག།",
    "དེ་ནང་ཙོག་པུར་འདུག་ཅིང་ཟིན་ཐུན་སྐྱོར།",
    "ཝ་ཞིག་ཕྱིན་པ་ང་ལ་ལྟ་ཞིང་གདའ།",
    "བྲོས་ན་བར་ཆད་ཡིན་པས་འདུག་དགོས་བསམས།",
    "ཅི་འདྲ་འདུག་དེ་ལེགས་པར་བལྟ་ངཔས་། ཁང་རྩེག་གསུམ་ཙམ་རིང་བས་ནག་པོ་ནི།",
    "ཡང་ན་རོགས་ནི་མང་པོ་ཁག་ཅིག་འདུག།",
    "ཁོང་རང་མཐུན་ཕྱོགས་བདེ་ཆེན་ཞེས་བྱ་ལ།",
    "ང་རང་ཇ་རྣམས་མ་ཟད་བར་དུ་དྲངས།",
    "བན་ཆུང་རང་དང་འདྲ་འདྲ་དེ་ཚོ་ཡང་།",
    "ཅུང་ཞིག་དྲེད་སྙམ་ཡོད་པ་འདྲ་ཞིག་འདུག།",
    "བློ་ལ་ལྷག་ལུས་མེད་པ་བྱེད་དགོས་གདའ།",
    "བཀའ་བཅུ་པ་ཞིག་གདའ་ལ་རིགས་ལུང་བཏང་།",
    "བློ་སྐྱེད་ལེགས་པོ་བྱུང་ནི་གདའ་འོ་ཟེར།",
    "ང་རང་སྣ་ཁྲག་ཐིགས་བྱུང་བསྡུ་མ་ཕོད།",
    "བཙག་བྱུག་བལ་ཚོན་མང་པོ་བཏགས་པ་འདུག།",
    "དེ་ཡི་མདུན་དེར་ང་རང་དུས་རྒྱུན་དུ།",
    "མཚན་རིང་གཅིག་པུར་ཟིན་ཐུན་སྐྱོར་ཞིང་འདུག།",
    "ད་གང་ལ་ཡང་གལ་ཆེན་འདུག་གོ་ཀྱེ།",
    "གཤེགས་རྫོངས་མང་ཇ་མང་པོ་བསྐོལ་འདུག་པས།",
    "ང་ལ་ཡང་ནི་མི་དགའ་ལྟ་འདུག་པས།",
    "ཤིག་མི་གསོད་དང་བསྟན་དོན་ཁོ་རང་དོན།",
    "དེ་ཕྱིར་གང་ལའང་ས་འབྲེལ་པ་དགོས་འདུག་པས།",
    "རྟ་དང་དར་གོས་འགྱེད་སོགས་ཚན་ཆེན་གདའ།",
    "ང་རང་ལ་ཡང་ཨེ་འགྲོ་ཟེར་བ་མང་།",
    "ང་རང་རིགས་པ་རབ་ཏུ་རྣོ་བ་དེས།",
    "ཁོང་རང་ཡང་ནི་ཅུང་ཟད་མ་དབེན་ནས།",
    "ནུས་པ་ཆེ་བར་འདུག་སྙམ་ངེས་ཤེས་སྐྱེས།",
    "འདྲེན་ཐུབ་པ་ནི་ང་རང་ཁག་ཁྱག་གསུངས་། དེ་སྐོར་ཟ་དམ་གཉེར་ཆེན་ཞལ་ངོ་ཡིས།",
    "རྫོག་ན་རྫོག་མ་རག་ལ་འདུག་པ་དང་།",
    "བྱས་ན་རྟགས་ཚོ་མྱུར་དུ་ཐོན་འདུག་སྟེ།",
    "དགོངས་པ་ཞུས་ན་མྱུར་དུ་གནང་སྲོལ་གདའ།",
    "ང་རང་ཡོད་པའི་མདུན་དེར་འཕང་ཞིང་སྔགས།",
    "སྔགས་པ་འདས་རྒྱུ་ཨེ་ཡིན་ཟེར་ཞིང་འདུག།",
    "ཀླུ་ཡི་ཁ་གནོན་མཆོད་རྟེན་ལ་སོགས་འདུག་འབྲི་གུང་མཐིལ་ནི་རྒྱང་མཇལ་ཙམ་ཞིག་བྱས།",
    "གནམ་སྒྲོན་གཤིན་རྗེའི་མཆེ་བ་འདུག་གོ་སྨྲས།",
    "ནམ་ཕྱེད་ཙམ་ལ་ཕོ་ལྷོག་ན་ནས་འདུག་ཡར་ལངས་ཆུ་བསྐོལ་སྔགས་ནས་འཐུང་དུ་བཅོལ།",
    "ང་ཡི་རྒྱགས་རྣམས་བྱང་པ་སྟོང་པར་ཆད་། རྩམ་ལྷག་ཇ་མར་ཅུང་ཟད་འདུག་པ་དེས།",
    "ལ་ཁར་ལ་བཙས་ཤིན་ཏུ་འཇིགས་པ་གདའ།",
    "སོག་དོགས་ཆེ་བར་འདུག་པས་མ་བསྡད་ཅིང་།",
    "རྗེས་ཀྱང་འུར་ཞོག་ཡང་ཡང་འོང་འདུག་པས།",
    "སྐྱེས་པའི་ཡུལ་འདིར་མི་འདུག་རྒྱུན་དུ་བསམ།",
    "རྨོ་ཡི་གཟིམས་ཁང་ནང་དུ་འདུག་འོས་ཀྱང་།",
    "ཉ་རོང་ནང་དུ་འདུག་གམ་བསམ་ན་ཡང་།",
    "འཆི་བར་འདུག་སྙམ་སེམས་ངོ་ཨུ་ཚུགས་ཀྱིས།",
    "ཕན་ཡོན་དགོས་ཁྱད་ཆེ་བར་མི་གདའ་བས།",
    "དབྱར་ལྡོམ་འདི་ལ་འབུ་སྲིན་འཆི་འདུག་ཀྱང་།",
    "རང་ཁྱིམ་འདུག་གམ་གྲོང་ཆོག་བྱས་ཀྱང་རུང་།",
    "འབུལ་བ་བྱུང་ན་ཁོ་རང་རྐྱེན་རྣམས་འགྱུར་། གཤིན་དོན་ཡིན་ཀྱང་ཚེ་འདས་དེ་ཡིས་ཐོབ།",
    "གྲོང་ཡུལ་རྣམས་སུ་རྒྱུན་དུ་འདུག་དགོས་ཀྱང་།",
    "ཡུས་དང་ཧམ་པ་གཞན་ལས་ཆེ་འདུག་ཀྱང་།",
    "གྲྭ་ཚང་མང་ཇ་འགའ་ཞིག་ཐེངས་འདུག་ཅིང་།",
    "བར་ཆད་ཞུགས་ཤིང་ཆོ་འཕྲུལ་ཆེ་དྲག་པས་། སུ་ཡང་སྡོད་པར་ནུས་པ་མི་གདའ་བས།",
    "གཞན་ཡང་ང་རང་སུ་བཞག་བར་ཆད་མེད།",
    "རང་རང་ཡོན་ཏན་དེ་ལ་འབྲེལ་གཏམ་བྱས།",
    "ལོ་གྲངས་བཅུ་གསུམ་མཚམས་ལ་འདུག་པ་དང་།",
    "ང་རང་སྲོལ་ལུགས་ཇི་བཞིན་མ་ཆག་ཐོན།",
    "འབྲུག་ལོར་ང་རང་སྤུན་གཉིས་རབ་ཏུ་ན།",
    "སེམས་ལ་ཕན་པ་མང་དུ་བྱུང་འདུག་གོ།",
    "ཆས་ཀ་ཅུང་ཟད་ཅི་འདུག་རྗེས་འབྲངས་བྱས།",
    "མིག་མཐོང་ལྷབ་ཁ་བ་ཅིག་འདུག་པ་དེས།",
    "བརྩོན་འགྲུས་བྱས་ནས་ལེགས་པར་བསྒྲུབས་འདུག་ཅིང་།",
    "ཁྲིད་པ་ཡང་ནི་ལྔ་བཅུ་ཨེ་ཡོད་ཙམ་། ཁྲོམ་པ་ལྔ་བརྒྱ་ལྷག་ཙམ་འདུག་པ་དང་།",
    "ཡུལ་འབྲོག་འཁྲུག་པ་ཞིག་ཀྱང་འདུག་པ་སྡུམ་། ཟང་ཟིང་ལོངས་སྤྱོད་འབུལ་བ་མང་དུ་བྱུང་།",
    "ཟིན་ཐུན་དགེ་སྦྱོར་རང་རང་ཤེས་རབ་ལ།",
    "འོན་ཀྱང་རང་ཤུགས་གདུལ་བྱ་བྱུང་བབ་རྣམས་། མི་དགོས་མི་འདོད་མི་ལེན་ཟེར་བ་སོགས།",
    "ཚེ་མཇུག་གང་གདའ་སྒྲུབ་ལ་དྲིལ་སྙམ་ཡོད།",
    "ས་རྣམས་ནོན་པའི་སྔ་ལྟས་། ཁྲི་མཐོན་སྟེང་ན་འདུག་པ་དང་།",
    "རི་བོའི་རྩེ་ལ་འདུག་པ་དང་།",
    "ནམ་མཁའི་དབྱིངས་ལ་འདུག་པ་དང་།",
    "ཉི་མའི་དཀྱིལ་དུ་འདུག་པ་རྣམས།",
    "སེང་གེ་གླང་ཆེན་ཁྲི་ལ་འདུག་པ་ནི།",
    "ལྷ་ཁང་གཉིས་ཙམ་འདུག་པ་མཇལ་བ་ཡི།",
    "མི་གོ་འདུག་པས་གཤེ་འབར་འགའ་ཡང་བྱས།",
    "ཉི་མ་དེ་ཡང་ཤར་ཕྱོགས་ནམ་མཁའ་ནས་། སྔར་བས་ཤར་འདུག་རི་དེ་ཤིན་ཏུ་མཐོ།",
    "ཐབ་ཏུ་འོ་མ་གཅིག་ནི་བཀོལ་ཞིང་གདའ།",
    "ཨ་དབྱིས་ད་བར་གཉིད་ནི་འདུག་ཨ་ཟེར།",
    "འདུག་པའི་བྷ་གའི་ནང་དུ་བདག་ཞུགས་ནས།",
    "བཀའ་ཤོག་གསུང་ཕྲིན་འགའ་ཡང་མཛད་ཅིང་གདའ།",
    "དཀྱིལ་འཁོར་གཅིག་ལ་གཡོན་སྐོར་མཛད་འདུག་པས།",
    "ཡིན་པར་འདུག་སྙམ་བསྐྱེད་རྫོགས་གོ་བ་ཤར།",
    "ཁོང་རང་གཏེར་ཁའི་ཐུགས་རྗེ་ཆེན་པོ་ཡི།",
    "དེ་ལ་ཁྱེད་རང་གསོལ་བ་ཐོབ་ཅིག་གསུངས།",
    "དེ་ཡི་ངང་ལ་མ་སད་བར་དུ་བསྡད་། སད་མ་ཐག་ཏུ་ཉམས་ལེན་དེ་ཐོག་གདའ།",
    "ལྷམ་མེ་ལྷང་ངེ་བཞུགས་ནི་འདུག་ན་ཡང་།",
    "གཞལ་ཡས་ཁང་དུ་འདུག་པའི་དབུས་ན་ནི།",
    "ཡུན་རིང་སྒྲོང་ན་ཞིང་དེར་ཁྲིད་ནུས་གདའ།",
    "ཐུར་དུ་འགྲོ་མི་ཤིན་ཏུ་ཚན་ཆེན་གདའ།",
    "ངོ་མི་ཤེས་པའི་ཚེ་འདས་ཤིག་འདུག་པའི།",
    "དེ་ནི་བེ་གར་དངོས་སུ་གྱུར་ནས་གདའ།",
    "མང་པོ་འདུག་པ་རྒྱལ་འགོང་རྟགས་སུ་ཤེས།",
    "བསྒོམས་པས་ང་རང་དེ་ཉིད་དངོས་སུ་གྱུར།",
    "ང་རང་ཀརྨ་ཆགས་མེད་ཡིན་པ་དང་།",
    "ཁ་ཡི་ནང་ན་སྐྱ་དང་ཟིང་ངེ་གདའ།",
    "བུ་ཆུང་དང་ནི་མི་གཞོན་མང་པོ་གདའ།",
    "བདག་ནི་གན་རྐྱལ་ཉིད་དུ་མནན་ནས་བྱུང་། ཡར་བལྟས་སྟེང་དུ་ངོམ་ཆུ་འབབས་ཤིང་གདའ།",
    "དེ་ཡི་སྟེང་དུ་ས་སྒང་ཟམ་ཡང་གདའ།",
    "ང་རང་བྱ་ཁྱུང་དམར་པོ་ཞིག་ཏུ་སྤྲུལ།",
    "ང་རང་དབྱུག་པ་ཞིག་ཁྱེར་ཡར་འོང་ཛ།",
    "རང་ཉིད་ན་ནས་ཉལ་བའི་འདུག་སྐབས་ཤིག་སྔས་དེར་བནྡེ་གཅེར་བུ་རྒྱགས་པ་ཞིག།",
    "མགོ་ལ་དར་གྱི་གདུགས་ཤིག་གྱོན་སི་འདུག།",
    "སྐབས་སུ་མཉམ་གཞག་བྱེད་ཅིང་གདའ།",
    "ཤེར་ཕྱིན་འབུམ་གྱི་གླེང་གཞི་གསུངས་ཤིང་འདུག།",
    "མངོན་སུམ་ལྟ་བུར་བཞུགས་ནས་འདུག་པ་ལ།",
    "རྒྱ་སྟག་མང་པོ་དངོས་སུ་འགྲོ་ཞིང་གདའ།",
