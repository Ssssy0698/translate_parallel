    "དེ་དག་རྣམས་ཀློག་དུས་ར་མགོ་སྟེ་ལྕེ་རྩེ་འདར་བའི་ཚུལ་གྱིས་ཧ་སྒྲ་ཅུང་ཟད་ལྡན་པར་སྒྲ་ངོ་རང་ཅུང་དྲག་པོའི་ཚུལ་གྱིས་བཀླག་གོ་ཞེས་པའི་དོན་དུ་གོ་བས་བཀླག་ཚུལ་འདི་ཤིན་ཏུ་འཐད་དེ།",
    "གོ་རོ་ཙ་ན་ཀླད་པ་ལ་འགོ་རོ་ཙ་ན་དང་།",
    "གཞན་ཡང་ཤ་དང་ཥ་ས་གསུམ་སྐབས་གང་དུ་བྱུང་ཡང་རང་ལྕེར་གང་བདེ་བཀླག་དགོས་ཏེ།",
    "འདིའི་སྐབས་སྣར་ཐང་ལས་བྱུང་བའི་བརྩེགས་པ་ཡར་སྦྱར་ཚུལ་དུ་ཀློག་དུས་ཀྱི་གལ་ཆེའི་ཡི་གེ་འགའ་ནི།",
    "ཙ་ཚ་ཛ་གསུམ་ལ་ཡ་སྟ་བཏགས་པ་དེ་རྣམས་ཀློག་དུས་བོད་ཀྱི་ཅ་ཆ་ཇ་གསུམ་ལ་ཡ་སྒྲ་འགྲེང་བུ་དང་ལྡན་པའི་ཚུལ་དུ་བཀླག་ལ།",
    "དེ་དག་ལ་གུག་སྐྱེད་བྱས་འདུག་ནའང་རིམ་པ་ཇི་བཞིན་སྦྱར་དགོས་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པའི་གོ་འཕང་ཐོབ་འདོད་ཀྱི་ངེས་དེ་བས་བཀའ་ཕྱག་ཆུ་བོ་འབྱུང་ཁྱད་པར་ཅན་སྐྱེ་བའི་ངེས་པ་མི་འདུག་གཉིས་འདྲེས་དཔལ་དྭགས་པོའི་དཀར་བརྒྱུད་པ་རྣམས་ཀྱི་ཕྱག་བཞེས་འདི་ལེགས་པར་འཁུམས་ཏེ།",
    "མི་ལུས་ཙམ་ཐོབ་པ་མང་པོ་འདུག་ཀྱང་།",
    "ཕྱོགས་མཐའ་དག་ན་མི་བསམ་གྱིས་མི་ཁྱབ་པ་འདུག་པས་སོ་སྙམ་ན།",
    "ལུང་པ་གང་བའི་མི་ལ་ཡང་གྲངས་དེ་ཙམ་འདུག་གམ་སྙམ་དུ་བསམ་དགོས་ཏེ།",
    "འཆི་མེད་ཚེའི་རིག་འཛིན་ཟེར་བའང་ཚེ་རིང་བ་ཙམ་ལ་བསྙད་པར་འདུག་པས།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "བདག་ནི་མལ་ན་འདུག་བཞིན་དུ།",
    "སད་སེར་སོགས་ཀྱིས་འཚེ་བ་མེད་པར་ལོ་ཐོག་དུས་སུ་སྨིན་པ་སོགས་འབྱུང་།",
    "དེ་ནམ་ཟད་ཀྱི་བར་གྱི་ཡུན་ཚད་དེ་ཙམ་དུ་སྡུག་བསྔལ་མྱོང་དགོས་པ་ཡིན་པར་འདུག་དེ་ལྟ་བུ་ཡིད་ལ་བསམ་པ་ཙམ་གྱིས་ཀྱང་།",
    "ལས་ངན་གྱིས་ཁོག་པ་བཀང་ནས་ཡིད་བདེར་འདུག་ཕོད་དམ།",
    "འདུག་སྙམ་ཕྱིན་པས་མེ་མ་མུར་གྱི་འོབས་ལ་རྐང་པའི་ལོང་བུ་མན་ནུབ་པ་དང་།",
    "ཞེས་སོགས་གསུངས་འདུག་པ་སོམས་དང་།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "ཅེས་གསུངས་པར་གདའ།",
    "སྐྱབས་སུ་མཆིའོ་ཟེར་ཙ་ན་ཕྱག་ཡུལ་གྱི་ཐུགས་རྗེ་བསྐུལ་བར་བསམ་ལ།",
    "ལུས་ཀྱི་འགྲོ་འདུག་བྱ་བྱེད།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་སྟེ།",
    "སྤྱོད་ལམ་དེས་འདུག་པ་མཐོང་ན་ཤིན་ཏུ་དང་བ་སྐྱེ་བ་དང་།",
    "སེམས་ཀྱི་རང་བཞིན་ནམ་འདུག་ཚུལ་ཇི་ལྟར་ཡོད་པ་དེ་ག་ལྟར་མ་བཅོས་པར་འཇོག་པ་སྟེ།",
    "མ་བཟུང་མ་བཏང་རང་ག་ཉིད་དུ་ཞོག།",
    "དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ་ནང་དུ་ཡང་དག་བཞག་ནས།",
    "འགྲོ་དང་འཆག་དང་ཉལ་དང་འདུག་པ་ན།",
    "འཕྲལ་ཇི་ལྟར་འདུག་དང་འདི་ལྟར་སྣང་སོགས་ད་ལྟའི་རྟོག་དཔྱོད་ཀྱང་ཡིད་ལ་མི་བྱེད་པར་སེམས་རང་གར་ལྷོད་དེ་ཤིག་གེ་བར་འཇོག་པ་ཡིན་ལ།",
    "བཀག་པས་ཁེགས་པར་མི་འདུག་དིང་རི་བ་།",
    "རྣམ་རྟོག་ཁོ་རང་གང་བྱེད་དུ་བཞག་ཅེས་སོགས་ཁྲིད་ཡིག་ཏུ་གསུངས་པའི་ཕྱིར་འདི་ནི་ཞི་གནས་རང་ལ་དཔགས་པའི་ཁ་ཡན་དུ་སྐྱོང་བ་སྟེ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "ལུས་སེམས་ཡོད་དུ་མི་ཚོར་བ་བར་སྣང་སྟོང་པ་ལ་འདུག་པ་ལྟ་བུ་ལ་སོགས་པའི་ཉམས་ཀྱི་སྣང་བ་འཆར་བའོ།",
    "དེ་དུས་ཀྱི་གནས་པ་དང་འགྱུ་བ་ངོ་ཤེས་མཁན་དེ་ལ་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའམ་སོ་སོར་རྟོག་པའི་ཤེས་རབ་དང་རང་རིག་པ་ཞེས་ཀྱང་བྱ།",
    "དེས་གནས་འགྱུ་རང་བཞིན་མེད་པར་སྦྱངས་མཐར་ཤེས་རབ་ཁོ་རང་ཡང་དམིགས་སུ་མེད་དེ་དཔེར་བཀོད་པའི་གཙུབ་ཤིང་དང་གཙུབ་གཏན་བསྲུབས་པ་ལས་སྐྱེས་པའི་མེས་ཤིང་གཉིས་བསྲེག་མཐར།",
    "ཕྱོགས་སྔ་མ་ལ་སུན་འབྱིན་ཅིང་ཡོད་པ་ཁྱེད་རང་ལ་བཟློག་པའི་ཕྱིར་དང་།",
    "གསལ་བའི་ངོས་བཟུང་དང་དེའི་རྣམ་པ་ཅན་དུ་འདུག་བརྟག་སྟོང་པར་འདུག་ན་ཅང་མེད་ཀྱི་སྟོང་པ་དང་བར་སྣང་ལྟ་བུའི་སྟོང་པ་ཇི་ལྟར་འདུག་བརྟག་གསལ་ན་ཉི་ཟླ་ལྟ་བུའམ་མར་མེ་ལས་འོད་འཕྲོ་བ་ལྟ་བུར་གསལ་བ་དང་འོད་དང་ཁ་དོག་མེད་པའི་རང་གསལ་དུ་འདུག་ལ་སོགས་པ་སྒོ་དུ་མ་ནས་བརྟག་ཅིང་དཔྱད།",
    "དང་པོ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲོད་པ་ནི།",
    "དེ་ཙ་ན་འོད་གསལ་གཟུང་བར་བྱ་སྟེ།",
    "ཨ་ཇོ་ཤགས་དཔོན།",
    "མི་རྣམས་ཀྱིས་ང་ལ་དགའ་པོ་བྱེད་ཀྱི་མི་འདུག་ལ།",
    "སྤྲང་པོའི་བུས་གདོན་འདྲེ་འདི་ནི་མི་རྗེན་ཟ་དང་མི་ཁྲག་ཧུབ་འཐུང་བྱེད་མཁན་མི་གཟན་ཞིག་ཡིན་པ་ཐག་ཆོད་འདུག་པས་ངས་ཁོའི་མི་དབུགས་བསྡུ་སའི་མི་ལྤགས་ཀྱི་རྐྱལ་པ་དེ་མགོ་སྐོར་བཏང་ནས་འཕྲོག་ཐུབ་པ་བྱས་ནས་མི་རྣམས་ཀྱི་སྲོག་སྐྱོབ་ཐུབ་པ་བྱེད་དགོས་བསམས་ཏེ་ཐབས་མཁས་ཀྱི་སྒོ་ནས།",
    "ང་རང་དགའ་ཆེ་ཤོས་ནི་ཁྱེད་ལྟ་བུ་མཐུ་དང་ནུས་པ་ལྡན་པ་ཡིན་པ་དང་།",
    "ང་རང་དགའ་ཆེ་ཤོས་ནི་མིའི་བླ་བསྡུ་སའི་རྐྱལ་པ་དེ་ཡིན་ཞེས་མི་ལྤགས་ཀྱི་རྐྱལ་པ་ཞིག་བསྟན་ནས།",
