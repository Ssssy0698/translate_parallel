    "ལྷག་བསམ་རྣམ་པར་དག་པ་དཀར་བའི་ཀུན་སློང་དེ་ལྷུན་པོའི་རི་བཞིན་བརྟན་པ་དང་རང་རྒྱལ་གཞན་ཕམ་དང་གཡོ་ཁྲམ་སྤྲེལ་ལད་སོགས་གང་དང་བྲལ་བའི་མཛངས་མ་གཏོང་ཕོད་ཅན་ཞིག་ཡིན།",
    "ཡང་བཙུན་མས་འཛུམ་བཞིན་སྨྲས་པ་བྱ་བ་བཟང་པོ་དང་འཕྲད་པས་ཁྱེད་རང་དངངས་སྐྲག་བྱེད་མི་དགོས།",
    "ག་བཟའ་མས་གཅེན་པོར་དྲང་པོར་ཞུས་ན་ང་ལ་དངོས་འབྲེལ་སྐྱེས་པ་ནི་གྲོད་ཐུམ་ཞིག་འདུག་དེ་ཁ་འབྱེད་མ་ནུས་པར་བསྡད་ཡོད་ཅེས་བརྗོད།",
    "ཁྲོ་རྒྱལ་གྱིས་ཨ་ཙི་བུ་ཡིན་པ་འདྲ།",
    "ལུག་ཤ་བཙོས་མ་རླངས་པ་འཚུབ་འཐུབ་ཨ་ཞང་ལ་བཤམས།",
    "ཁོས་ང་མཚོ་ལ་གཡུག་རྩིས་བྱེད་ཀྱི་འདུག་འདིར་དམག་དཔུང་ནི་མེད།",
    "ཁྱེད་རང་སེམས་འཁྲལ་མ་གནང་ཞིག་ཅེས་བརྗོད།",
    "ད་ནི་ཉི་སྐར་ཁྲུམས་སྟོད་ལ་སླེབས་ཡོད་ཚོད་འདུག་པས་མ་ཟད་ང་ལུག་རྫིར་འགྲོ་དུས་འཕྱི་བ་མལ་ནས་ལངས་པའང་མཐོང་བྱུང་ལ་བྱ་པུ་ཤུད་ཀྱི་སྐད་ཀྱང་ཐོས་བྱུང་།",
    "ལྟས་ངན་འབྲོང་འདྲོགས་ཡིན་འགྲོ།",
    "ཕག་རྫི་ཁྱེད་རང་ཧང་སངས་མི་དགོས།",
    "སྤྲང་ཕྲུག་ལ་ཆའི་ཐོད་མགོ་དེར་ཉལ་ཡོད་སྟབས་གསེར་ལོ་སྐྱིད་ཀྱིས་ཀྭ་ཡེ་སྤྲང་ཕྲུག་ལ་ཆའི་ཐོད་མགོ་ཕར་ཙམ་རྒྱུགས།",
    "སྤྲང་ཕྲུག་ལ་ཆའི་ཐོད་མགོ་དེར་ཡོད་སྟབས་གཡུ་ལོ་སྐྱིད་ཀྱིས་ཀྭ་ཡེ་སྤྲང་ཕྲུག་ལ་ཆའི་ཐོད་མགོ་ཕར་ཙམ་རྒྱུག་ལག་རུ་མ་བཀག་ང་ཆུ་ལེན་དགོས་ཟེར།",
    "སྐབས་ཤིག་ལས་འཕྲོ་མི་འདུག།",
    "སྐབས་ཤིག་ལས་འཕྲོ་མི་འདུག།",
    "དུང་ལོ་སྐྱིད་ཀྱིས་ང་རང་མི་གཉིས་ལས་མེད་པར་ལས་སླ་ས་ཞིག་ནས་མཉམ་དུ་འགྲོ་ཟེར།",
    "དུང་ལོ་སྐྱིད་ཀྱིས་ང་རང་གཉིས་ལས་མེད་པར་སླ་ས་ཞིག་ནས་མཉམ་དུ་འགྲོ་བརྗོད།",
    "དུང་ལོ་སྐྱིད་ཀྱིས་ང་རང་གཉིས་ལས་མེད་པར་དྲོ་ས་ཞིག་ཏུ་མཉམ་དུ་སྡོད་དོ་ཟེར།",
    "དུང་ལོ་སྐྱིད་ཀྱིས་ང་རང་མི་རྡོག་གཉིས་ལས་མེད་པར་ལས་སླ་ས་ཞིག་ནས་འགྲོ་ཟེར་བས་ཁོང་གཉིས་མཉམ་དུ་བྱེ་རི་ནས་བབས་པས་འཁྱུག་ཙམ་ཞིག་ལ་ལ་གཤམ་དུ་སླེབས།",
    "སྐབས་དེར་གཅུང་པོས་གཅེན་པོར་ཨ་ཇོ།",
    "རྔོན་པ་གཅུང་པོ་བློ་ཕྲན་བུ་མི་བདེ་བ་བྱུང་ཡང་རང་ཉིད་ཀྱིས་གཅེན་པོར་སྲུང་སྐྱོབ་གྲ་སྒྲིག་འཐུས་ཚང་བྱས་ཡོད་པས་མི་དོ་སྙམ།",
    "རྔོན་པ་རྒན་པ་དེའི་མཐའ་འཁོར་དུ་ལྕགས་ཀྱི་རྐང་པ་ཁ་ལྟག་ཁུང་དུ་ཡོད་པ་མང་པོས་བསྐོར་འདུག་པ་དང་།",
    "དེ་ནས་གཅུང་པོ་བྲག་ཟུར་གྱི་འདུག་གནས་སུ་སླེབས་སྐབས་གཅེན་པོ་ཉལ་སའི་ནང་ནས་གཅུང་པོ།",
    "ཁྱེད་མེད་ཤུལ་དུ་བདག་ཁྱེད་དྲན་པའི་གདུང་བ་བཟོད་ཐབས་མི་འདུག་པས་ཅི་དྲག་བསམས་ནས་ངུ་བ་ཡིན་ཞེས་བརྗོད།",
    "ཁྱེད་ཀྱི་སྐུ་འདྲ་ཞིག་ཡོད་ནའང་སེམས་ཅུང་ཟད་ཆགས་པ་ཞིག་ཡོང་བ་འདུག་ཟེར།",
    "ཚོང་དཔོན་གྱིས་ཨ་ཙི་ཁྱེད་འདི་འདྲ་ཐུགས་ཅ་སུན་པོ་གནང་ནས་གང་དྲག་ཕྲན་ལ་སོའོ་དང་།",
    "མུ་ཏིག་སྐྱུག་མཁན་གྱིས་གོས་ཆེན་གྱི་བློན་ཆས་ཆ་ཚང་གྱོན་ཞིང་རང་ཁྱིམ་ཕྱོགས་སུ་བསྐྱོད།",
    "ད་ཆ་ཁྱེད་རང་རྒྱལ་ཁབ་ཀྱི་བློན་པོར་གྱུར་རྗེས་ནམ་ཉིན་མཚན་ཀུན་ཏུ་ཁྱེད་བསམ་མཁན་དམན་ཆུང་ང་བརྩེ་བས་དོར་རམ།",
    "དང་ཐོག་ང་རང་དེ་ཉིན་སེམས་སྐྱོ་ནས་བསྡད་པའི་སྐབས་ཁོས་བཙན་ཤེད་ཀྱིས་གནས་ཚང་གཡར་དགོས་ཟེར་བ་དང་།",
    "ཁ་རྒྱུན་དུ་སེངྒེའི་སྐད་ཀྱིས་རི་དྭགས་ཐམས་ཅད་ཟིལ་གྱིས་གནོན་ཞེས་པ་ལྟར་སེངྒེ་རང་ཡིན་འདུག་སྙམ།",
    "ཁོང་གཉིས་བོང་བུའི་སར་འབྱོར་ན་སུས་ཀྱང་ཕྱིར་བཤོལ་མི་བྱེད་རྒྱུའི་དམ་བཅའ་བཞག་པར་མ་ཟད་སྤྱང་ཀིའི་སེམས་ལ་སྟག་བྲོས་ཡོང་སྙམ་ནས་ཁོ་རང་གཉིས་ཀྱི་མཇུག་མ་གཉིས་མདུད་པ་བརྒྱབས་ནས་འབྲེལ་ཏེ་ཕྱིན།",
    "གྲོང་པ་ཁྱིམ་མཚེས་རྣམས་ཀྱི་རོགས་རམ་འོག་བྲག་༡༢༡༢ཨ་ཇོ་ཤགས་དཔོན།",
    "ཁྱེད་རང་དོགས་འདྲོག་ལངས་མི་དགོས།",
    "དེ་རིང་རྒྱལ་པོས་ཁྱེད་རང་ཤགས་རྒྱག་པར་བོས་ཤོག་གསུངས་པ་ལྟར་ཡོང་བ་ཡིན།",
    "ཨ་ཇོ་ཤགས་དཔོན་གྱིས་ཁྱེད་ཀྱི་རྒྱུས་མངའ་དང་།",
    "མི་ཚོས་ཟེར་སྐད་བྱས་ན་ཁྱེད་རང་ཤགས་དང་།",
    "དེ་ནས་ཨ་ཇོ་ཤགས་དཔོན་གྱི་མེས་པོའི་དུས་ཀྱི་བུ་ལོན་འབྲུལ་ཁལ་ཆིག་སྟོང་ལྔ་བརྒྱ་དེ་སྤྱོད་པའི་དམིགས་བརྟེན་གང་ཡང་མེད་ཀྱང་ཁ་རྩལ་གྱིས་དག་པར་བྱས་སོ།",
    "གཞན་ལ་ཁྲེལ་ཡོད་ཡང་དང་རང་ཉིད་ལ།",
    "གོས་བྱིན་དོན་མཐུན་གྲུར་འཇུག་གཅིག་འདུག་འགྲེང་།",
    "སྦྱོར་བཅུག་ཡང་ཡང་འདུག་གནས་ལྷག་པར་ལེན།",
    "འདུག་འགྲེང་གཅེར་བུ་དམག་བལྟ་ནང་དུ་གནས།",
    "བརྣག་པས་ཉལ་པོ་བཤོམ་ཁྱིམ་འདུག་པ་དང་།",
    "འདུག་དགུ་ཟས་བླང་བརྒྱད་དང་ཟ་ཉེར་གཅིག།",
    "འགྲེང་ཉལ་དམའ་བར་འདུག་དང་ཕྱི་ནས་འོང་།",
    "བསྒོ་ནས་ཐམས་ཅད་འདུག་ཅིང་མཐུན་གྱུར་ཚེ།",
    "མཚམས་ནང་འདུག་ན་ཕོ་ཉ་ལས་ཐ་དད།",
    "དེ་དག་དུས་རུང་ཆུ་ཤིང་སོགས་བརྒྱད་འབྲས།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་སམ་ཉིན་དང་མཚན།",
    "དགའ་དང་རངས་པར་འགྱུར་བ་ལུས་ཀྱིས་སྤྱད།",
    "ཉན་ཐོས་ནང་འདུག་སྔགས་པ་ཡིན་ཟེར་དང་།",
    "དག་པ་ཡེ་ཤེས་དམ་ཚིག་དུས་འཁོར་དུའོ།",
