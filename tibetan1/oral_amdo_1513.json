    "ཁྱོད་རིགས་དང་གདུང་རུས་བཟང་ཡང་།",
    "དེ་ཁྱོད་མེ་ལ་སྲེག་ཅིང་ཐོ་བས་བརྡུང་ངོ་ཟེར་ནས།",
    "དེར་ང་རང་གི་ཉེ་བ་རྣམས་ཀྱི་མིང་ནས་བོས་ཀྱང་ང་ལ་རོགས་དང་ར་མདའ་རྒྱག་མཁན་ནི་གཅིག་ཀྱང་མེད།",
    "དེའི་ཁྲོད་ན་སྐྱེས་པ་གཅིག་གིས་འདི་ནི་གདུང་རིང་བསྲེལ་འཛིན་པའི་བརྒྱུད་པ་ཡིན་ཞིང་།",
    "དེར་གཞིན་རྗེ་སྟག་གི་མགོ་ཅན་གཞིག་གིས་མེ་དེ་ཕར་དཀྲུགས་ཚུར་དཀྲུགས་བྱས་ནས།",
    "ཁྱོད་རང་གི་ཨ་ལྕེ་ཡ་གི་ན་སླེབ་འདུག་པས།",
    "མི་ཁྱོད་ཀྱི་རིགས་རྒྱུད་སྨྲས་མི་དགོས།",
    "དེ་ནས་སྐྱེས་པ་ཕོ་ལུས་ཐོབ་པ་ཡོད་དོ་གསུང་གི་འདུག།",
    "ཡི་དམ་རྡོ་རྗེ་ཕག་མོ་ལ་གསོལ་བ་ཐོབ།",
    "ངའི་ཟླ་གྲོགས་ཀྱི་བུད་མེད་དེ་བསླེབས་ནས།",
    "ཁྱོད་ཀྱི་མིང་པོ་འདི་རིགས་བཟང་བློ་གསལ་ང་རྒྱལ་ཆེ་བ་གཅིག་ཡིན་ཏེ།",
    "ཁྱོད་རང་སྡུག་བསྔལ་མ་བྱེད་པར་ལོངས་ཤིག་ཟེར་རོ།",
    "ཁ་ལ་ཁྲོ་ཆུ་ཁོལ་མ་བླུག་གིན་འདུག་པས།",
    "ངའི་ཟླ་གྲོགས་ཀྱི་བུད་མེད་དེས།",
    "ཨ་ཙ་མ་རྒན་མོ་འདིས་བྱ་བ་ངན་པ་ཅི་འདྲ་ཞིག་བྱས་པ་ཡིན་ཟེར་བས།",
    "རྒན་མོས་སྡུག་བསྔལ་མང་པོ་མྱོང་བ་འདི།",
    "ཡང་ངའི་ཟླ་གྲོགས་ཀྱི་བུད་མེད་དེས་འདི་སྐད་དུ།",
    "རྒན་མོ་སྡུག་བསྔལ་མྱོང་བ་འདི།",
    "མི་ཡུལ་དྲན་པ་སྒང་གི་མི།",
    "བུད་མེད་ཁྱོད་ལ་བུ་དང་ཚ་ཡུག་ནོར་རྫས་རྣམས་ཡོད་ན།",
    "བུད་མེད་རྒན་མོ་དེས་ཀྱེ་མ་ཀྱི་ཧུད་ང་རང་གིས་ཡུལ་ལ་འཕྲིན་པ་བསྐུར་ཀྱང་།",
    "ང་རང་གི་ཡུལ་ནི་འབྲིང་པ་སྤེ་སར་ནས་ཡིན།",
    "བུ་རྒན་པ་ལ་ཆུང་མ་ང་རང་གི་ཚ་མོ་བླངས།",
    "དང་པོ་རང་གི་ཕ་མས་བྱིན་པའི་གོས་ལྗང་ཁྲ་གཅིག་དང་།",
    "རང་གི་གྲོགས་ཀྱི་ཁ་འཆེམས་སུ་ཁྱོད་ལ་བུ་འདིས་བྱམས་པོ་རང་ཨེ་བྱེད་མི་ཤེས་པས།",
    "འདི་བུ་ལ་མ་སྟེར་བར་ཁྱོད་རང་གིས་བདག་ཉར་གྱིས་ཟེར་ནས་སྦར་སྦུག་ཏུ་གཡུ་མཛོ་རབ་གཅིག་བྱུང་བ་དེ་ང་རང་གིས་སྦས་ནས་བཞག་ཀྱང་།",
    "གཡོག་མོ་དང་མནའ་མ་གཉིས་གྲོས་བྱས།",
    "མནའ་མ་དང་གཡོག་མོ་གཉིས་ཀྱིས་ངའི་ཁ་ལྟག་སྐོར་གཅུས་ནས་རྐུབ་འོག་ཏུ་མནན་པས།",
    "ནག་ཚང་གི་ཤིང་ཁྲོད་ན་ལྷ།",
    "ནག་ཚང་གི་ཕྱི་ན་རྒྱུག་ཁྲོད་དང་སྤང་ཤིང་གི་ཁྲོད་ན།",
    "རེ་བའི་ཕྱི་སྐོགས་བྱས་ནས་ཕད་གོག་གིས་དྲིལ་བ་གཅིག་ཡོད།",
    "དེའི་ནང་ན་ཚྭ་དང་ཚོད་སྡོར་སྣམ་སྣུམ་སྤེན་ཏོག་གཅིག་དང་བཅས་པ་ཡོད།",
    "ར་སྤེའི་སྨིན་དྲུག་གི་ལག་ནས།",
    "སྤེ་སར་ནུབ་པའི་བུ་ཁྲིད་ལྷ་མོ་ལ་གོས་ཀྱི་ལྟེབ་རྣམ་པ་གཉིས་བཅོལ་ནས་ཡོད།",
    "དེ་རྣམས་ལོང་ལས་སྤེ་སར་ལུང་པའི་མི་རྣམས་ལ་ཆང་ཕོར་བ་རེ་མ་བྱུང་ཡང་དྲོངས་ལ་མ་ཎི་འདྲེན་རོགས་མཛོད་གྱིས་ཤིག།",
    "གཅེས་པར་བསྐྱངས་པ་ཡི་རེ་མུག།",
    "དྲན་པ་སྒང་གི་མི་རྣམས་ཀུན།",
    "ཡང་གཤིན་རྗེ་རྣམས་ཀྱིས་སྔར་བཞིན་དུ་ཁ་ལ་ཁྲོ་ཆུ་ཁོལ་མ་བླུག་གིན་འདུག་གོ།",
    "དེར་ཡང་ངའི་ཟླ་གྲོགས་ཀྱི་བུ་མོ་དེས།",
    "ངའི་ཟླ་གྲོགས་ཀྱེ་བུ་མོ་དེས་འདི་སྐད་ཅེས་ཟེར་ཏོ།",
    "སྐྱེས་པ་ཁྱོད་ལ་སྡུག་བསྔལ་འདི་ལྟ་བུ།",
    "གཞིན་རྗེ་རྣམས་ཀྱིས་ཕ་བོང་གི་འོག་ནས་བཏོན་བྱུང་སྟེ།",
    "ང་རང་གི་མིང་ལ་ཚེ་རིང་དར་རྒྱས་ཟེར།",
    "ང་རང་ཕྲུག་གུ་ནས་ཇོ་བོའི་དྲུང་གི་ཕྱག་གཡོག་བྱས།",
    "ཚེ་རིང་དར་རྒྱས་ཧོར་པོ་ཡོད་ཟེར་བ་དེ་རྣ་བའི་རྒྱན་དུ་སོང་སྟེ།",
    "མི་རེ་ཆང་དམ་སྤི་རེ་ཁྱེར་ནས་ཡོང་།",
    "ང་ཡིས་མ་ཉན་གྲིན་ཆང་རེ་བྱིན།",
    "མཚན་མོ་ང་རང་བུད་མེད་དེ་དང་མཉམ་དུ་ཉལ་བས།",
    "ཨ་མའི་ཞིང་དང་ནོར་ལ་མ་ཕངས་པར།",
    "འཚོང་ལ་ང་ཡི་ཤུལ་དུ་ཅི་འགྲོ་གིས།",
    "ནས་རྩམ་མར་གྱི་སྟན་མོ་ཅི་སྒྲུབ་གྱིས།",
    "ལས་དཀར་ནག་དང་དགེ་སྡིག་གི་ཤན་འབྱེད་བྱས་ཏེ།",
    "རྟོགས་ལྡན་སྒོམ་ཐག་དང་སྒོམ་བེར་བོུན་ཞིང་མགོ་ལ་དོམ་ར་བཙུགས་པ་གཅིག་གི་ཁ་ལ།",
    "གཤིན་རྗེ་རྣམས་ཀྱིས་ལྕགས་ཀྱི་གཟར་བུས་མེ་ཐལ་རྒྱུན་དུ་བླུག་གྱིན་འདུག་པས།",
    "ངའི་ཟླ་གྲོགས་ཀྱི་བུ་མོ་དེས་གཞིན་རྗེ་རྣམས་ལ་འདི་སྐད་ཅེས་ཟེར་ཏོ།",
    "མེ་ཐལ་ཟ་བའི་སྡུག་བསྔལ་འདི་ལྟ་བུ།",
    "ད་གསུང་གི་འདུག།",
    "བླངས་ཏེ་རང་གི་བུ་སྨད་རྐྱང་པ་གསོས།",
    "ས་ཅད་རང་གིས་བཟས་པའི་རྣམ་སྨིན་ལ།",
    "འདི་རུ་མེ་ཐལ་རྒྱུན་དུ་བླུགས་པ་ཡིན།",
    "ངའི་ཟླ་གྲོགས་ཀྱི་བུ་མོ་དེས།",
    "ཁྱོད་བཙུན་མའི་ཆ་ལུགས་བྱས་ནས་འདི་རུ་སྡོད་པ་ཅི་ཡིན།",
    "ཡུལ་པ་རྣམས་ལ་བཟའ་བཏུང་སྟོན་མོ་གཅིག།",
    "ཆེན་པོ་ཡིན་ཟེར་བའི་མེ་དཔུང་ཆེན་པོ་ཉིན་ལམ་རེའི་ས་གནས་མེ་དེའི་ངད་པས་ཐའི།",
    "མི་དེ་རྣམས་མིག་གིས་མི་མཐོང་བར་མེ་དེས་སྟོང་གསུམ་ཐམས་ཅད་མཆོད་སོང་བསམ་པ་འབར་གྲིན་འདུག།",
    "དེར་གའན་རྗེ་དོམ་གྱི་མགོ་ཅན་གཅིག་གིས།",
    "མི་གཅིག་ལྕགས་ཀྱི་སྐམ་པས་བཏོན་ནས་རྒྱང་རིང་པོར་བསྐྱུར་སོང་།",
    "ངའི་ཟླ་གྲོགས་ཀྱི་བུ་མོ་དེས་གཞིན་རྗེ་རྣམས་ལ་འདི་སྐད་དུ།",
    "ཀྱི་བུད་མེད་དེས་མི་དེ་ལ་འདི་སྐད་དུ།",
    "ཁྱོད་ལ་འདི་འདྲའི་སྡུག་བསྔལ་མྱོང་དགོས་པ།",
    "མི་དེས་ངའི་གདོང་ལ་བལྟས་ནས་མཆི་མ་འདོན་ཞིང་ལག་པ་ཐལ་མོ་སྦྱར་ནས།",
    "ཁྱེད་ང་རང་གི་དཔོན་གྱི་ཇོ་མོ་ཡིན་པས།",
    "དཔོན་གཡོག་གི་དབྱེ་བ་ཕྱེ་ནས་ཕྱག་འབུལ་བྱས་པ་མ་གཏོགས།",
    "ཁྱོད་ལ་འདི་ལྟ་བུ་ནུས་པ་ཡོད་པ་ནི་མ་ཤེས།",
    "མིའི་རྣ་བ་ལ་གཡུ་ལེགས་པོ་བཏགས་པ་གཅིག་བྲོས་སོང་བས།",
    "དེ་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པས་ང་རང་གི་ལུས་མེ་དཔུང་ཆེན་པོའི་ནང་དུ་བསྐྱུར།",
    "ང་རང་གིས་མི་ཡུལ་དུ་ཡོད་དུས།",
    "ཚོ་ལ་ཉིན་གཅིག་གི་ཞབས་ཏོག་བྱས་པས་འདིར་སེམ་ས་ལ་བདེ་བ་ཆེན་པོ་ཡོང་གིན་འདུག།",
    "ཨ་མའི་དོན་དུ་རྒྱལ་ཁམས་ལ་མ་ཎི་བསྐུལ་བ་ཡི་ན་ཟེར་བ་གཅིག་ཞག་གསུམ་ང་རང་གི་ཁྱིམ་དུ་གདན་དྲངས་ནས་མི་རྣམས་ལ་མ་ཎི་འདྲེན་དུ་ཤག་ཟེར་ཞིང་ཞབས་ཏོག་བྱས།",
    "ང་རང་གི་འཕྲལ་འདོགས་ཀྱི་གཡུ་སྤུངས་དེ་ཡང་ཁོང་ལ་ཕུལ་བས།",
    "ཀྱེ་མ་ཀྱི་ཧུད་བདག་གི་སྡུག་བསྔལ་འདི།",
    "རི་ཁྲོད་འགྲིམས་པའི་རྟོགས་ལྡན་ཕོ་མོ་ལ།",
    "ཕག་མོའི་ཆོ་ག་སྦྱིན་སྲེག་བཅས་པ་གྱིས།",
    "ཁོག་སྨད་ལྕགས་ཀྱི་ཐོ་བས་བརྡུངགི་འདུག་པས།",
    "ངའི་ཟླ་གྲོགས་ཀྱི་བུ་མོ་དེས་གཤིན་རྗེ་རྣམས་ལ།",
    "ཞེས་དྲིས་སོང་བས།",
    "ལམ་གྱི་ཕྱག་རྒྱ་གཏུམ་མོའི་ལག་ལེན་བསླབས།",
    "༥༧ཉོན་མོངས་འདམ་དུ་བྱིང་བ་མི་ཤེས་པར།",
    "དེ་དུས་ཉོན་མོངས་རྩད་ཆོད་མ་སོང་བས།",
    "ཁྱོད་ཀྱིས་ཉོན་མོངས་དུག་ལས་མ་བྱས་སམ།",
    "ཉེ་འཁོར་འཆི་དུས་སྔས་མགོར་ཁྱོད་བོས་ནས།",
    "ཟས་ནོར་མང་པོ་ཁྱོད་ཀྱིས་ལྐོག་ཏུ་སྦས།",
    "ད་ལྟ་ཁྱོད་ལ་སྐྱིད་པོ་ཨེ་བྱུང་ལྟོས།",
    "རང་གི་བུ་ཚ་བསད་པའི་རྣམ་སྨིན་ལ།",
    "ངའི་ཟླ་གྲོགས་ཀྱི་བུ་མོ་དེས།",
    "ཁྱོད་ལ་ཕྲིན་པ་བསྐུར་རྒྱུ་ཡོད་ན་ལྷོད་པ་གཁྲིག་བགྱི་དང་ཟེར་ཞིང་བསྡམས་པ་རྣམས་གློད་ནས་ཕ་བོང་གི་འོག་ནས་བཏོན་བྱུང་བས།",
    "ཁྱོད་མཐོ་རིས་ཀྱི་སྐས་ཁ་ཆག།",
    "ད་གསོལ་བ་འདེབས་པ་ཨེན་ཙམོ་ཐལ་ཟིན་ཟེར་ཞིང་རལ་གྲི་ནམ་མཁའ་ལ་འཕྱར་ནས་བརྒྱག་གིན་འདུག་ག།",
    "ནུ་མོ་ཐུབ་བསྟན་དཔལ་མོ་ཟེར་བ་ཡོད།",
    "གཤིན་རྗེ་རྣམས་ཀྱིས་མང་པོ་གསུང་གིན་འདུག།",
    "ད་ལྟའི་སྡུག་བསྔལ་འདི་ལ་གཟིགས་མཛོད་དང་།",
    "ང་ཡི་ནུ་མོ་ཐུབ་བསྟན་དཔལ་མོ་ལ།",
    "དེའི་ཕྱོགས་བཞི་ན་རྒྱལ་སྒོ་རེ་རེ་ཡོད།",
    "ལ་ལ་ནི་གཟིག་ལྤགས་ཀྱི་ཤམ་ཐབས་དང་གླང་ཆེན་གྱི་ཀོ་རློན་གྱོན་པ།",
    "ལ་ལ་ནི་མི་ལྤགས་ཀྱི་ཤམ་ཐབས་དང་དར་ནག་གི་ཡུག་གོན་བྱས་པ།",
    "དུམ་བུར་སོང་བ་རྣམས་ཀྱང་།",
    "སླར་ནས་དང་སྲན་མ་ཙམ་དུ་མ་སོང་བར་དུ་བརྡུང་གིན་འདུག།",
    "ངའི་ཟླ་གྲོགས་ཀྱི་བུ་མོ་དེས་ང་ཡར་བསླངས་ནས་འདི་སྐད་དུ།",
    "ཁྱོད་རང་འདི་འདྲའི་སྡུག་བསྔལ་མཁྲུད་ཅིག།",
    "སྒོམ་ཡུན་དུ་མ་བསྲིངས་ང་རེ་འགྱོད།",
    "རང་གི་ཁ་ཏ་འགྲོ་བའི་མི་རྣམས་ལ།",
    "རང་གི་ཉེ་འབྲེལ་ལ་མ་ཆགས་པར།",
    "རང་གི་བྲང་ལ་རང་གིས་སྦར་རྩིར་རྒྱབ་ནས།",
    "ཡང་ངའི་ཟླ་གྲོགས་ཀྱི་ངུ་མོ་དེས།",
    "ཁྱོད་ལ་ང་ཡི་ཟླ་གྲོགས་ཡོད།",
    "ལམ་དང་པོ་དཀར་ལ་འོད་ཆེ་བ་ཞིག་འདུག་པ་དེ་གང་གི་ལམ་ཡིན་བྱས་པས།",
    "དེའི་འོག་ན་ལམ་དམར་པོ་གཅིག་འདུག་པ་དེ་གང་གི་ལམ་ཡིན་བྱས་པས།",
    "དེའི་འོག་ན་ལམ་སྔོན་པོ་གཅིག་འདུག་པ་དེ་གང་གི་ལམ་ཡིན་བྱས་པས།",
    "ཉིན་མོའི་སྐར་མ་བས་ཀྱང་དཀོན་པས་འགྲོ་མཁན་ཉུང་བ་ཡིན་ནོ་ཟེར།",
    "ཡང་དེའི་འོག་ན་ལམ་ལྗང་ཁུ་གཅིག་འདུག་པ་དེ་གང་གི་ལམ་ཡིན་བྱས་པས།",
    "དེ་བྱོལ་སོང་གི་ལམ་ཡིན་ཟེར།",
    "དེའི་འོག་ན་ལམ་ནག་པོ་གཅིག་འདུག་པ་དེ་གང་གི་ལམ་ཡིན་བྱས་པས།",
    "དེ་ནི་དཔྱལ་བ་ཐར་མེད་ལ་འགྲོ་བའི་ལམ་ཡིན་པས་དེར་མ་སོང་བ་གཅིག་དགོས་སོ།",
    "ད་ལྟ་འདིར་ཁྲིད་ཤོག་གསུང་གི་འདུག་གོ་ཟེར་བས།",
    "ས་གཞི་བར་སྣང་ཐམས་ཅད་ཆོད་འགྲོ་བ་ཙམ་བྱས་ནས་སོང་བས།",
    "གསུང་སྙན་ལ་རིང་བས་འདི་ལྟར་གསུང་གིན་འདུག་གོ།",
    "མ་གི་དམྱལ་ཁམས་བཅོ་བརྒྱད་ནང་དག་ན།",
    "འདོན་པ་གཙང་གི་སེ་བྲག་གཡའ་ལུང་ན།",
    "མཁའ་སྤྱོད་དག་པའི་ཞིང་དུ་སོང་ངོ་བགྱིས།",
    "ལྕགས་ཁར་སྒོ་མེད་ཀྱི་ནང་ན་ཡོད་པའི་མི་རྣམས་དང་བཅས་པ་གཤིན་རྗེ་རྣམས་ཀྱིས་བཟུང་ཡང་མ་ཐུབ་པར་ཐམས་ཅད་ཁོང་གི་རྗེས་ནས་ཡར་ལ་སོང་ངོ།",
    "ཟངས་མོ་ཆེ་གཞི་མ་ཡིན་ཟེར་བ་ཆེ་ཆུང་ལ་གཡུ་མཚོ་ཙམ་གཅིག་འདུག་པའི་ནང་ནས་མི་མང་པོ་འཚེད་ཀྱི་འདུག་པ་ཡང་ཁ་སྦུབ་ལ་སོང་ནས་མི་བརྒྱ་ཕྲག་མང་པོ་ཐོན་སོང་།",
    "ང་རང་གིས་ངོ་མི་ཤེས་ཀྱང་གཙང་གི་ཕྱོགས་ནས་མདའ་དཔོན་འགོག་ལུང་བ་ཡིན་ཟེར་བ་ཡང་འདུག།",
    "ཟངས་ཀྱི་མཐིལ་དུ་འབྱར་བ་དེ་རྣམས་མ་གཏོགས་གཞན་ཐམས་ཅད་ཨ་རྣེ་དེའི་ཕྱི་བཞིན་རིག་འཛིན་གྱི་ས་ལ་འགྲོ་བ་ཡིན་ཟེར་ནས་སོང་ངོ།",
    "རྣམ་སྨིན་སྡུག་བསྔལ་འདི་འདྲ་མྱོང་གིན་འདུག།",
    "ལན་གཅིག་ཐོན་ཀྱང་སླར་ཡང་བཅུག་སོང་གྱིས།",
    "དེ་རྣམས་ནི་གཤིན་རྗེ་རྣམས་ཀྱིས་མར་ཁྲིད་ནས་རང་རང་གི་སྡུག་བསྔལ་མྱོང་དུ་བཅུག་སོང་།",
    "ཀྱི་མི་དང་ས་རྡོ་ཐམ་ས་ཅད་ལ་བཔྲུང་ཞིང་ལག་པ་ཐལ་མོ་ཐབ་ཐབ་བྱས་ནས་འདི་སྐད་ཟེར་ཏོ།",
    "ཅེས་ཟེར་བས་མོ་ཁྲིད་མཁན་ནི་གཤིན་རྗེ་དེས་རལ་གྲི་ནམ་མཁའ་ལ་འཕྱར་ནས།་",
    "བུད་མེད་ཁྱོད་མི་ཡུལ་དྲན་པ་སྒང་ལ་སྡོད་པའི་དུས།",
    "ཁྱོད་སྐྱིད་དུ་མ་ཚོར།",
    "ཁྱོད་ཀྱིས་མི་རྣམས་ལས་ཕུང་དང་གཡོ་སྒྲུ་བྱས་ནས།",
    "ཕོ་དཀར་དང་མོ་ནག་འདུག་ཟེར་ཞིང་འདིས་སྐྱེས་པ་ཐམས་ཅད་ཀྱི་མགོ་བསྐོར།",
    "སྒོས་བུ་མོ་རྣམས་ལ་ཅི་མིན་སྣ་དགུའི་གཏམ་མང་དུ་གླེང་པས།",
    "བུ་མོ་རྣམས་ཀྱང་བློ་ངན་དུ་སོང་བས།",
    "བུད་མེད་དེའི་ཁ་ནས་འདི་སྐད་ཟེར་གྱིན་འདུག།",
    "གཤིན་རྗེ་རྣམས་ཀྱིས་ཁྲིད་སོང་ངོ།",
    "དེར་སྒོ་སྲུང་གི་གཤིན་རྗེ་གཅིག་ན་རེ།",
    "འོན་ཀྱང་ང་རང་གིས་ཡི་དམ་ལྷ་ལ་གསོལ་བ་དྲག་ཏུ་བཏབ་ཡོད་པས་ཐུགས་རྗེའི་སྤྱན་གྱིས་གཟིགས་ཤིག།",
    "ང་རང་གི་ཟླ་གྲོགས་ཀྱི་བུ་མོ་དེས་ངའི་མཆི་མ་ཕྱིས་ནས་ཡར་བསླངས་ཏེ།",
    "ཁྱོད་ཀྱིས་ཟང་ཟིང་གི་སྦྱིན་པ་བཏང་བ་དང་སྒོམ་བརྟན་པོ་ཐོབ་པ་མེད་ཀྱང་།",
    "ང་ཡིས་ཁྱོད་ཀྱི་ལམ་སྣ་འདྲེན་ནོ་ཟེར་ནས།་",
    "ལུས་འདར་བའི་ངང་ནས་ཡ་གི་བདེ་ཡངས་ཆེན་པོ་དེར་བསླེབས་བྱུང་།",
    "ཕྱག་དང་བསྐོར་བ་བྱེད་དགོས་བསམས་ཀྱང་གཡས་གཡོན་གྱི་ཁྲོ་བོ་ཁྲོ་མོ་རྣམས་ལ་འཇིགས་སྐྲག་ནས་མ་ནུས།",
    "ཁྲོ་བོ་ཁྲོ་མོ་འཇིགས་པའི་གཟུགས་ཅན་དར་ནག་གི་ན་བཟའ་གསོལ་བ།",
    "ལ་ལ་ནི་མི་ལྤགས་ཀྱི་གཡང་གཞི་དང་སྟག་གཟིག་གི་ལྤགས་པའི་ཤམ་ཐབས་བྱས་པ།",
    "དེའི་འགྲམ་ན་གཤིན་རྗེ་སྟག་གི་མགོ་ཅན་མི་ལྤགས་ཀྱི་གཡང་གཞི་གྱོན་པས་ཡི་གེ་འབྲི་ཞིང་འདུག།",
    "དེའི་མདུན་དུ་བྱ་རོག་དང་ཕག་གི་མགོ་ཅན་རྩིས་དང་ཆུ་ཚོད་བལྟ་གིན་འདུག།",
    "༧༣ཡང་ངའི་ཟླ་གྲོགས་ཀྱི་བུ་མོ་དེས་ང་ཡར་བསླངས་ནས་འདི་སྐད་གསུངས་བྱུང་།",
    "ཁྱོད་མགོ་ནས་བཏེགས་ནས་འཛིངས་ནས་བོར།",
    "ཡ་གི་སྤུ་གྲི་བྱེ་ཐང་ཁ་རུ་ངོ་སྤྲད་པ་དེ་མ་དྲན་ནམ།",
    "ཁྱོད་ལ་སྡིག་སྒྲིབ་ཆེན་པོ་མི་འདུག་པས་སྡུག་བསྔལ་མ་བྱེད་པར་ཡར་ལོངས།",
    "འཇིག་རྟེན་མི་ཡུལ་ནས་ཚེ་ལས་འདས་པ་གཅིག་ཡོང་གིན་༧༤འདུག་པས་ད་ལྟ་ཉིད་དུ་འདིར་ཁྲིད་ཤོག་ཅིག་གསུངས་སོང་བས།",
    "ཡ་གི་ནས་མར་ལ་སྐྱེ་དམན་གསེར་མ་བཞག་སྒོར་ཙམ་བྱས་པ་གཅིག་སླེབ་བྱུང་བས།",
    "མ་ཎི་སྒྲ་ཐོས་པ་དང་གཞིན་རྗེ་རྣམས་རང་སར་སྡོད་སོང་།",
    "དེས་མོ་རང་གི་ཟླ་ལ།",
    "བུད་མེད་དེའི་དཔུང་པ་ནས་བཟུང་སྟེ་ཁྲིད་བྱུང་བས།",
    "ངག་གི་སྒྲིབ་པ་དག་ཕྱིར་དུ་ཡི་གེ་དྲུག་པ་བགྲངས་སམ།",
    "ཅེས་གསུང་གིན་འདུག་པས།",
    "མོ་ནི་ལུས་འདར་ཞིང་མ་ཆགས་པར་འགྱེལ་སོང་།",
    "ད་ནི་སྡུག་བསྔལ་བྱས་ཀྱང་མི་ཕན་ཤ་ཁྲག་གི་ལུས་ནི་མི་ཡུལ་དྲན་པ་སྒང་དུ་ལུས།",
    "མོ་ནི་ལུས་འདར་ཞིང་སྐད་ངུ་སྐད་དུ་བྱས་ནས་ཞུ་བ་འདི་ལྟར་འབུལ་གྲིན་འདུག་གོ།",
    "འཇིག་རྟེན་ལ་སོང་ནས་བུ་ཚ་གཉིས་ཀྱང་སྐྱེས།",
    "ཕ་མི་ང་རྣམས་ཀྱང་མི་ཁའི་འོག་ཏུ་སོང་བས་ང་རང་མི་ཡུལ་གཞན་དུ་འཁྱམས་དགོས་པ་བྱུང་།",
    "ངན་སློང་ལ་སྦྱིན་པ་དུམ་ཙམ་རེ་བཏང་།",
    "གྲོགས་ལྡན་ཕོ་མོ་རྣམས་ལ་ཟ་མ་ཕོར་པ་རེ་ལ་སོགས་གང་བྱུང་གི་འབྲེལ་པ་རེ་བྱས།",
    "མ་གིའི་ཙིར་ཙིར་འུར་འུར་ཟེར་བ་དེ་ལ་མ་གཏོང་རོགས་མཛོད་ཅིག་ཟེར་ནས།",
    "སྐྱེ་ས་རིགས་ཁུངས་མོ་རང་ཞུས་པ་བཞིན།",
    "རྟོགས་ལྡན་ཕོ་མོ་རྣམས་ལ་ཞབས་ཏོག་ཕུལ།",
    "ཅེས་ཟེར་ཞིང་རྡེའུ་དཀར་པོ་བྲེ་གང་ཙམ་གཅིག་སྤུངས་སོང་།",
    "མོ་ངན་བསམ་སྐྱིད་ཟེར་བ་ཁྱོད།",
    "ཞེས་ཟེར་ཞིང་རྡེའུ་ནག་པོ་བྲེ་ཕྱེད་ཙམ་གཅིག་སྤུངས་སོང་།",
    "རྡེའུ་སྲང་ལ་བཏེགས་སོང་།",
    "ཡང་སྐུ་གཞོགས་གཡས་ནས་གཤིན་རྗེ་གླང་གི་མགོ་ཅན་དེས།",
    "ཁྱོད་བག་མ་བཏང་བའི་དུས་སུ་ཕ་སུ་ཡིན་འདི་ཡིན་མེད་པའི་ཕྲུ་གུ་གཅིག་བྱུང་འདུག།",
    "ཁྱོད་ཀྱིས་མེད་པར་བཏང་འདུག།",
    "རང་གི་ཕྲུ་གུ་བསད་པ་སྡིག་མི་ཆེ་བ་ཨེ་ཡིན།",
    "ཁྱོད་ཀྱིས་དེ་ལ་འགྱོད་སེམས་བྱས་ནས་ལུས་ཀྱི་སྒོ་ནས་ཕྱག་དང་བསྐོར་བ་བྱས།",
    "ངག་གི་སྒོ་ནས་ཡི་གེ་དྲུག་པ་རྒྱུན་དུ་བགྲངས།",
    "ཁྱོད་ཀྱི་བསམ་པ་ལ་ཁོང་ཕྱུག་པོ་རྣམས་ཀྱི་ཞབས་ཏོག་ཞུས་པ་དང་།",
    "དཔའ་དར་དང་གནང་སྦྱིན་བཟང་པོ་གནང་གི་འདུག།",
    "གཞན་ཁྱོད་ཀྱིས་ད་མི་ལུས་ཐོབ་པ་འདུག་སྟེ།",
    "མི་ལུས་ཐོབ་པ་ཡོད་དོ་གསུངས་སོང་།",
    "ཡི་དམ་སྤྱན་རས་གཟིགས་ལ་གསོལ་བ་ཐོབ།",
    "ཞེས་ཟེོར་ནོས་བྱོལ་སོང་གི་ལམ་ལ་ཞུགས་ཏེ་བྱ་དགོ་བོ་གཅིག་ཏུ་སྐྱེ་བ་ལེན་པར་སང་ང་།",
    "ད་ལྟ་འདིར་ཁྲིད་ཤོག་གསུང་གི་འདུག།",
    "གཤིན་རྗེའི་ལས་མཁན་རྣམས་སྔར་ལྟར་བྱས་ནས་༨ལངས་སོང་།"
  ]
}