    "ཕྱི་རོལ་འདོད་ཡོན་གྱི་སྣམ་བུ་དམར་པོའི་སྟེང་དུ་ཕྱོགས་རེར་རབ་ཏུ་མཛེས་ཤིང་ཡིད་དུ་འོང་བའི་ལྷ་མོ་བཞི་བཞིས་མཆོད་རྫས་དཔག་ཏུ་མེད་པ།",
    "གོས་དང་འཕན་ལ་སོགས་པའི་རྒྱན་རྣམས་ཀྱིས་མཛེས་པར་བྱས་གོ་ལྔ་པ་ནང་གི་ལྷ་སྣམ་ཤར་སྔོ།",
    "བར་པ་གསུང་གི་འཁོར་ལོ་དམར་པོ་པདྨས་མཚན་པའི་ར་བ་དང་།",
    "ལྟེ་བ་བདེ་ཆེན་གྱི་འཁོར་ལོ་པདྨ་འདབ་མ་བརྒྱད་པ་གྲི་གུག་གིས་མཚན་པའི་ར་བ་དང་།",
    "དབུས་ཕྱུར་བུར་ཕུབ་པའི་རྩེ་མོར་རྡོ་རྗེ་ཕྱེད་པའི་ཏོག་གིས་སྤྲས་པ།",
    "ལྷའི་གནས་རྣམས་སུ་པདྨ་དང་ཉི་མའི་གདན་རེ་རེའི་སྟེང་དུ་དབུས་སུ་འཇིགས་བྱེད་ཕོ་མོ།",
    "གཞལ་ཡས་ཁང་གི་ཕྱི་རོལ་ཏུ་ཤར་ཕྱོགས་སུ་གཏུམ་དྲག།",
    "དེ་ནས་ལག་པ་གཡོན་པའི་སྲིན་ལག་གིས་དཀྱིལ་འཁོར་གྱི་ས་གཞི་ལ་རེག་སྟེ།",
    "དེ་གཉིས་ཀྱི་བར་དུ་ཧཱུྃ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་སོ་སོར་རྟོགས་པའི་ཡེ་ཤེས།",
    "ཞལ་རེ་རེ་ལ་སྤྱན་གསུམ་གསུམ་དང་ལྡན་ཞིང་མཆེ་བ་བཞི་བཞི་གཙིགས་པ།",
    "ལྔ་པ་ན་ཁྲག་གིས་གང་བའི་ཐོད་པ།",
    "དྲུག་པ་ན་ཚངས་པའི་མགོ་བོ་གདོང་བཞི་པ་བསྣམས་པ་ཞབས་གཡས་བརྐྱང་པས་དུས་མཚན་མ་དམར་མོའི་ནུ་མའི་སྟེང་དང་།",
    "གཡོན་ན་ཚེས་གཅིག་གི་ཟླ་བ་དང་།",
    "དབུ་རེ་རེ་ལ་མི་མགོ་སྐམ་པོ་ལྔ་ལྔས་དབུ་བརྒྱན་ཅིང་།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་གྲོལ་བ།",
    "གཡོན་པས་ཐོད་པ་ཁྲག་གིས་གང་བ་འཛིན་པས་ཡབ་ལ་འཁྱུད་ཅིང་།",
    "གཡས་པས་སྡིགས་མཛུབ་དང་བཅས་པའི་གྲི་གུག་གིས་ཕྱོགས་ཁདྷཱི་། ཐམས་ཅད་དུ་བསྡིགས་པར་མཛད་པ།",
    "དེའི་ཕྱི་རོལ་ཐུགས་ཀྱི་འཁོར་ལོ་རྩིབས་བརྒྱད་པའི་ཤར་རྩིབས་པུལླི་ར་མ་ལ་ཡར་ཁཎྜ་ཀ་པཱ་ལི་དང་རབ་ཏུ་གཏུམ་མོ།",
    "ཤར་ལྷོ་གོ་དཱ་ཝ་རཱིར་སུ་ཝཱི་རེ་དང་།",
    "དེའི་ཕྱི་རོལ་གསུང་གི་འཁོར་ལོ་རྩིབས་བརྒྱད་པའི་ཤར་རྩིབས་ཀཱ་མ་རཱུ་པར་ཨཾ་ཀུ་རི་དང་ཨེ་རཱ་ཝ་ཏཱི།",
    "བྱང་རྩིབས་ཨོ་ཏྲེར་རྡོ་རྗེ་རལ་པ་ཅན་དང་འཇིགས་བྱེད་ཆེན་མོ།",
    "ལྷོ་ནུབ་ལམ་པཱ་ཀར་རྡོ་རྗེ་བཟང་པོ་དང་ཤིན་ཏུ་བཟང་མོ།",
    "གསུང་གི་འཁོར་ལོའི་ལྷ་རྣམས་ཁ་དོག་དམར་པོ་ས་སྟེང་ན་སྤྱོད་པའི་ཨདྷཱི་། ཚུལ་གྱིས་བཞུགས་པའོ།",
    "ཤར་ལྷོ་ནཱ་ག་རར་དཔལ་ཧེ་རུ་ཀ་དང་ཤིན་ཏུ་དཔའ་མོ།",
    "བྱང་ཤར་ཀུ་ལུ་ཏཱར་རྡོ་རྗེ་སེམས་དཔའ་དང་བརྩོན་འགྲུས་ཆེན་མོ་སྟེ།",
    "རུས་པའི་རྒྱན་དྲུག་གིས་བརྒྱན་པ།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་གྲོལ་བ།",
    "རོའི་གདན་ལ་ཞབས་གཡས་བརྐྱང་གིས་༡༡སྟབས་ཀྱིས་བཞུགས་པ།",
    "རབ་ཏུ་གཏུམ་མོ་ལ་སོགས་པའི་དཔའ་མོ་རྣམས་ནི་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གྲི་གུག་དང་ཐོད་པ་འཛིན་པས་ཡབ་ལ་འཁྱུད་པ།",
    "ཐམས་ཅད་ཀྱང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པའོ། དེའི་ཕྱི་རོལ་དམ་ཚིག་གི་འཁོར་ལོའི་ཤར་སྒོར་ཁ་གདོང་མ་སྔོ་སྐྱ།",
    "ལྷོ་ནུབ་ཏུ་གཤིན་རྗེ་ཕོ་ཉ་མོ་གཡས་སེར་གཡོན་དམར་བ།",
    "ཡུམ་གྱི་ལྟེ་བར་ཨོ་ཨོ་བི་དམར་མོ་རྡོ་རྗེ་ཕག་མོ།",
    "ཁར་ཨོཾ་ཧྲི་བརྒྱ་ཐམ་པ་མོ་དཀར་མོ་རྨོངས་བྱེད་མ།",
    "སྤྱི་བོར་ཨོཾ་ཧཱུྃ་ཏྲཾ་སེར་མོ་བསྐྱོད་བྱེད་མ།",
    "བདག་གི་མོས་པ་དང་།",
    "ན་མས་མན་དྷཱི ། བུདྡྷ་ནཱཾ།",
    "བདག་གི་མོས་པ་དང་།",
    "ན་མས་མནྟ་བུདྡྷ་ནཱཾ།",
    "དེ་བཞིན་བདག་གིས་ཁྲུས་བྱའོ།",
    "ཤབྡ་ཨཱཧཱུྃ་གི་བར་གྱིས་ཕྱི་མཆོད་དང་།",
    "བདག་གི་མོས་པ་དང་།",
    "ན་མས་མན་བུདྡྷ་ནཱཾ།",
    "ལས་ཀྱི་རྡོ་རྗེས་རྡོ་རྗེའི་དབྱུག་པ་བཟུང་སྟེ་ལྷ་རྣམས་ལ་རེག།",
    "ཡང་ན་སློབ་དཔོན་ཉིད་ཀྱིས་ཕྱག་གི་རྡོ་རྗེས་ལྷའི་གནས་སུམ་ཅུ་རྩ་བདུན་བུམ་ཐོད་བཞི་བརྒྱ་གསུམ་རྣམས་ལ་ཕྱོགས་གཡོན་སྐོར་དང་མཚམས་གཡས་སྐོར་གྱིས་རེག་སྟེ།",
    "ཨོ་ཀི་ལི་ཀི་ལི་སུ་ཝཱི་རེ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་སརྦ་བུདྡྷ་ཌཱ་ཀི་ནཱི་ཡེ་བཛྲ་ཝརྞ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཅེས་ཡི་གེ་བརྒྱ་པ་ལན་བཞི་བཅུ་ཞེ་གཅིག་གིས་བྱིན་གྱིས་བརླབས་ལ།",
    "ཕྱིའི་འཇུག་པ་དང་ནང་གི་འཇུག་པ་གཉིས་ལས།",
    "དེ་བཞིན་བདག་གིས་ཁྲུས་བགྱིའོ།",
    "བུ་ཁྱོད་སུ་ཡིན་ཅི་ལ་དགའ།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་བྱིན་གྱིས་རློབ་པར་འགྱུར་གྱི།",
    "གོང་ནས་གོང་མའི་སྡོམ་པ་ངནི་། བུ་ཁྱོད་ཀྱིས་ནི་གཟུང་བྱ་སྟེ།",
    "༡༧༧མཆོག་ཡུམ་གྱི་ལྟེ་བར་ཨོཾ་ཨོཾ་བཾ་དམར་མོ་རྡོ་རྗེ་ཕག་མོ།",
    "ཁར་ཨོ་ཧྲི་མཾ་དཀར་མོ་རྨོངས་བྱེད་མ།",
    "སྤྱི་བོར་ཨོཾ་ཧྲི་ཧྲི་སེར་མོ་བསྐྱོད་བྱེད་མ།",
    "རང་གི་མཐེ་བོང་གཡས་གཙོ་བོའི་གཡོན་པས་བཟུང་བར་བསམས་ལ།",
    "རང་གི་སེམས་ཉིད་ལ་དཔའ་བོ་བསྐུལ་ལོ།",
    "གང་གི་དྲིན་གྱིས་བདེ་ཆེན་ཉིད།",
    "ཉོན་མོངས་གཅོད་པའི་དོན་ལ་ཤིན་ཏུ་མཁས་གྱུར་པ།",
    "སྲིད་པའི་ཉེས་བརྒྱ་བསྐྱེད་རྩ་ཉོན་མོངས་ཆོམ་མཛོད་ལ།",
    "ཕྱག་ལེན་ལ་བདག་འཇུག་གི་ཚེ་བགེགས་སྦྱང་བ་ཙམ་མཛད་པས།",
