    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་གྲོལ་བ།",
    "གཡོན་པས་ཐོད་པ་ཁྲག་གིས་གང་བ་འཛིན་པས་ཡབ་ལ་འཁྱུད་ཅིང་།",
    "གཡས་པས་སྡིགས་མཛུབ་དང་བཅས་པའི་གྲི་གུག་གིས་ཕྱོགས་ཐམས་ཅད་དུ་བསྡིགས་པར་མཛད་པ།",
    "གཡོན་པ་རྣམས་ན་རེ་དྲུག་གླང་པོ་ཆེ་དང་།",
    "དེའི་ཕྱི་རོལ་ཐུགས་ཀྱི་འཁོར་ལོ་རྩིབས་བརྒྱད་པའི་ཤར་རྩིབས་པུལླི་ར་མ་ལ་ཡར་ཁཎྜ་ཀ་པཱ་ལི་དང་རབ་ཏུ་གཏུམ་མོ།",
    "ཤར་ལྷོ་གོ་དཱ་ཝ་རཱིར་སུ་ཝཱི་རེ་དང་བརྟན་པའི་བློ་ཅན་མ།",
    "དེའི་ཕྱི་རོལ་གསུང་གི་ཆོ་ག་ཕྱོགས་བསྒྲིགས་འཁོར་ལོ་རྩིབས་བརྒྱད་པའི་ཤར་རྩིབས་ཀཱ་མ་རཱུ་པར་ཨཾ་ཀུ་རི་དང་ཨེ་རཱ་ཝ་ཏཱི།",
    "བྱང་རྩིབས་ཨོ་ཏྲེར་རྡོ་རྗེ་རལ་པ་ཅན་དང་འཇིགས་བྱེད་ཆེན་མོ།",
    "ལྷོ་ནུབ་ལམ་བཱ་ཀར་རྡོ་རྗེ་བཟང་པོ་དང་ཤིན་ཏུ་བཟང་མོ།",
    "གསུང་གི་བདྷཱི་། འཁོར་ལོའི་ལྷ་རྣམས་ཁ་དོག་དམར་པོ་ས་སྟེང་ན་སྤྱོད་པའི་ཚུལ་གྱིས་བཞུགས་པའོ།",
    "ཤར་ལྷོ་ནཱ་ག་རར་དཔལ་ཧེ་རུ་ཀ་དང་ཤིན་ཏུ་དཔའ་མོ།",
    "རེ་བདུན་ནུབ་བྱང་མ་རུར་རྣམ་པར་སྣང་མཛད་དང་འཁོར་ལོས་སྒྱུར་མ།",
    "བྱང་ཤར་ཀུ་ལུ་ཏཱར་རྡོ་རྗེ་སེམས་དཔའ་དང་བརྩོན་འགྲུས་ཆེན་མོ་སྟེ།",
    "རུས་པའི་རྒྱན་དྲུག་གིས་བརྒྱན་པ།",
    "སྟག་གི་པགས་པའི་ཤམ་༨ཐབས་གྲོལ་བ།",
    "རོའི་གདན་ལ་ཞབས་གཡས་བརྐྱང་གི་སྟབས་ཀྱིས་བཞུགས་པ།",
    "རབ་ཏུ་གཏུམ་མོ་ལ་སོགས་པའི་དཔའ་མོ་རྣམས་ནི་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གྲི་གུག་དང་ཐོད་པ་འཛིན་པས་ཡབ་ལ་འཁྱུད་པ།",
    "དེའི་ཕྱི་རོལ་དམ་ཚིག་གི་འཁོར་ལོའི་ཤར་དུ་ཁ་གདོང་མ་སྔོ་སྐྱ།",
    "ལྷོ་ནུབ་ཏུ་གཤིན་རྗེ་ཕོ་ཉ་མོ་གཡས་སེར་གཡོན་དམར་བ།",
    "ཡུམ་གྱི་ལྟེ་བར་ཨོཾ་ཨོ་བོ་དམར་མོ་རྡོ་རྗེ་ཕག་མོ།",
