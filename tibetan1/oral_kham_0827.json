    "ཡན་ལག་བདུན་པ་ཕུལ་ནས་ལུས་དྲང་པོར་འདུག་སྟེ་དབུགས་ཕྱིར་འགྲོ་དང་།",
    "གཉེན་པོ་ཉིད་ཀྱང་རང་སར་གྲོལ།",
    "བདག་ལ་སྡུག་བསྔལ་ཅི་བྱུང་ཡང་རང་ཉིད་ཀྱིས་རང་ལ་བདག་ཏུ་བཟུང་བས་ལན་པ་ཡིན་པས།",
    "བདག་འཛིན་ནམ་བྱུང་ཙ་ན་བརྟགས་ན་བདག་གང་ཡང་མི་འདུག་པ་ལ།",
    "ཡང་རང་དོན་བསྒྲུབ་པའི་བསམ་སྦྱོར་ལ།",
    "སྔར་ནི་ངས་འདི་ལ་གནོད་པ་འབའ་ཞིག་བྱས་འདུག་ད་ནི་འདིའི་གནོད་པ་བསལ་ཞིང་ཕན་པ་བསྒྲུབ་པར་བྱའོ་སྙམ་དུ་བསམས་ལ།",
    "དེ་ལྟར་ན་ཉེས་པ་ཐམས་ཅད་བདག་གཅེས་འཛིན་ལས་བྱུང་འདུག་པས་དེ་ལ་དགྲར་བལྟས་ལ།",
    "ད་དུང་འདི་དང་མ་བྲལ་ན་བདེར་མི་སྟེར་བར་འདུག་ཅིང་།",
    "གནོད་པའི་ལན་འཇལ་བའི་དུས་བྱུང་ཙ་ན་འཇལ་བ་དེ་སྤོང་བའོ།",
    "མ་འགལ་བ་འདུག་ན་དགའ་བ་བསྒོམས་ཏེ།",
    "ཀོ་ལོང་གཙང་བཙན་བས་དམ་པར་གདའ་སྟེ།",
    "འཛམ་གླིང་རང་བྱུང་ཐེབས་རྩ་ལྷན་ཚོགས་ཀྱིས་ཞིབ་འཇུག་བྱས་པ་ལས་ཤེས་རྟོགས་བྱུང་བར།",
    "འཛམ་གླིང་རང་བྱུང་ཐེབས་རྩ་ལྷན་ཚོགས་ཀྱིས་ནེ་པ་ལའི་རྒྱལ་ས་ཀ་ཏ་མན་ཀྲུའི་བྱང་རྒྱུད་དང་ཧི་མ་ལ་ཡའི་ལྷོ་རྒྱུད་དུ་འཚོ་གནས་བྱེད་པའི་ཕྱེ་མ་ལེབ་དང་བྱི་བ།",
    "དེའི་ཤ་ལ་སོགས་པ་དང་རང་ལས་གང་འདོད་ཀྱི་རྫས་བསྲེས་ལ་བྱ་སྟེ།",
    "གོ་རོ་ཙ་ན་བསྲེས་པའི་ཐིག་ལེས་ཀྱང་གང་འདོད་པའི་གཟུགས་སུ་འགྱུར་རོ།",
    "དེ་ཡང་དེའི་གོ་རོ་ཙ་ན་དང་གོང་དུ་འདོད་པ་དེའི་སྤུ་བསྲེས་ལ།",
    "བཛྲ་བེ་རོ་ཙ་ནའི་འཁོར་ལོ་ཇི་ལྟ་བ་བཞིན་བྲིས་ཏེ།",
    "རྒྱུ་ནིར་ང་རང་སྐྱེད་པའི་རྐྱེན་ཡིན་ཏེ་ སྔར་ཚུལ་ཞེས་བྱ་བྱེ་བྲག་གསལ་མིན་པ།",
    "སྨྱན་པ་མདུན་ངོས་ནས་ཀྱི་ཁྲི་སྟེང་འདུག།",
    "ཕྲན་ཚགས་འགྲངས་ངོམས་འདུག་རྗེས་དྲག་ཤུལ་འབྱུང་།",
    "ཛོདང་རང་འཐག་ལ་སོགས་སྐད་ཆེན་སྒྲ།",
    "སྒྱུ་བརྗོད་སེམས་ལས་འགྲོ་འདུག་སྡངས་ཏེ་བརྟག།",
    "མའི་ལྟོར་བུ་དཀྲིས་ཤིང་འདུག་པའི་གནས་ནི་མངལ་ཏེ།",
    "ཡུལ་གཅིག་ན་ལྷན་ཅིག་ཏུ་རྒྱུར་བྱས་པའི་གཟུགས་གཉིས་འདུག་པ་མེད་པའིཕྱིར་རོ།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་བྱུང་གཉིས།",
    "མངལ་གྱི་གནས་སྐབས་ནནུར་ནུར་པོར་འདུག་པ་ལ་སོགས་པའི་ཚོན་བར་མ་དོར་འཆི་སོ་ལྔ་བདག་ལ་ཡོངས་སུ་རྫོགས་པར་ཡོད་པ་མ་ཡིན་ནོ།",
    "སྤྱི་མཚན་དང་རང་མཚན་གྱི་དོན་དེ་དང་དེ་ལྔཅུ་དྲག་གོ་བར་བྱེད་པ་ལ་བ་ལང་དང་རྟ་ཞེའམ།",
    "མཁས་རྣམས་དྲི་ནི་རྗེ་ཕྱོགས་མིན་འགྲོ་སྟེ།",
    "ཡི་དྭགས་རྣམས་ཀྱི་ལུསནི་རོ་གྱུར་ཏེ་འདུག་གོ།",
    "དེའི་ཚོ་འཇིག་རྟེན་འདི་ཆགས་ནས་བར་གྱི་བསྐལ་པ་ཉི་གྱུར་འདུག་པ་དེ་ལས་ནི་ངེས་པར་བྱུང་བ་ཡིན་ལ་གང་བར་གྱི་བསྐལ་པ་ཉི་ཤར་འཇིག་པར་འགྱུར་བ་དེ་ལ་ནི་ཞུགས་པ་ཡིན་ནོ།",
    "དེའི་ཚོའཇིག་རྟེན་འདི་ཞིག་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤར་འདུག་པ་གང་ཡིན་པ་དེ་ལས་ནི་ངེས་པར་བྱུང་བ་ཞེས་བྱ་ལ།་",
    "ཆགས་ནས་བུར་གྱི་བསྐལ་པ་ཉིཤུར་འདུག་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ནི་ཉེ་བར་འོངས་རྟེན་འདི་བར་གྱི་བསྐལ་པ་ཉི་ཞུར་འཆགས་པ་གང་ཡིན་པ་དེ་ལས་ནི་ངེས་པར་བྱུང་བ་ཡིན་ལ།",
    "ཉི་ཤུར་ཞིག་ནས་འདུག་གོ།",
    "ཞིག་ནས་སྟོང་པར་འདུག་པ་དེའི་ཚོ་ཡར་སྐྱེ་བ་དང་མར་འགྲིབ་པ་ནི་མི་འཇུག་ཏུ་ཟིན་ཀྱང་དུས་ནི་མཉམ་པར་ཡོངས་བརྒྱ་ས་བརྩི་བ་ཡིནནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་འཕགས་པའི་ལམདང་ལྡན་པ་ཡང་འཕགས་པའི་ལམ་ལ་གནས་པ་ཡིན་པས་ཐ་མལ་པར་འདུག་པའི་འཕགས་པ་དག་ཀྱང་ད་ལྟར་གྱི་ཟག་པ་མེད་པའི་སྡོམ་པ་དང་ལྡན་པར་འགྱུར་དུ་འོང་ངོ།",
    "དོདམའ་བར་འདུག་སྨྲས་བཟླས་པ་ཡིས།",
    "མི་སྨྲ་བར་འདུག་པ་ཙམ་གྱིས་ཐུབཔར་ལྟ་བ་རྣམས་དང་ལུས་ཀྱི་དྲི་མ་ཚམེད་པར་བྱེད་པ་ཙམ་གྱིས་འདག་པར་ལྟ་བ་རྣམས་ལྟ་བ་དེ་དང་འབྲལ་བའི་ཆེད་ཡིན་ནོ།",
    "བགྲོད་མིན་འགྲོག་འདོད་པ་ཡིས།",
    "བྱེ་ནས་དུས་ཇི་སྲིད་ཅིག་ཏུ་འདུགཅེ་ན།",
    "ཕྲ་རྒྱས་དེ་དང་ལྷན་ཅིག་འདུག་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་དུ་མི་འདུག་པ་ཉིད་དང་ང་།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཀྱང་འདི་སྐདིཅས་དེ་བཞིན་གཤེགས་པ་བཞུགས་བཞིན་དུ་བདག་ལ་འདྲི་བར་༤སམས་སུམ་ཞེས་སྨྲས་སོ།",
    "ས་ཇི་བཞིན་དུ་རང་རང་དང་།",
    "ཀློང་རྡོལ་གསན་ཡིག་ན་འདི་གཉིས་ཀྱི་བར་ཐག་མི་འདུག་ཅིང་།",
    "སུམ་བརྒྱ་པ་དང་རང་འགྲེལ་འོད་ལྡན་གཉིས་ཀྱིས་ལུང་རྒྱུན་ནི།",
    "༥༤ བར་དགེ་ཚུལ་གྱི་ཀཱ་རི་ཀཱ་ལྔ་བཅུ་པ་ལ་གསན་ཡིག་འགའ་ཞིག་ཏུ་ཁ་ཆེ་འདུན་བཟང་ཞེས་འདུག་པས་དཔྱད།",
    "བདེ་བའི་སྟན་གྱི་སྟེང་འདུག་ལ།",
    "སྣང་ཞིང་རང་སྣང་བདེ་བ་སྟེར།",
    "ལྷ་མཆོག་ཐུགས་རྗེའི་བདག་ཉིད་ཁྱེད་རང་མཁྱེན",
    "དེས་ན་སྐབས་འདིར་ཡང་རང་གཞུང་ནས་གསུངས་པའི་བསྐྱེད་རིམ་ལ་ནན་ཏན་བྱེད་པ་གལ་ཆེ།",
    "ལྷར་སྣང་དང་རང་སེམས་དབྱེར་མེད་དུ་བསྲེས་ཏེ་བསྒོམ་བྱའི་ལྷ་དང་སྒོམ་བྱེད་ཀྱི་ཤེས་པ་དུམ་བུ་རིས་ཆད་དུ་མི་བཟུང་བར་དུ་མ་རོ་གཅིག་བུ་རམ་གྱི་གཟུགས་བརྙན།",
