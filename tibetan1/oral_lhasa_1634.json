    "ལེགས་པར་སྦྱར་དང་ལེགས་སྦྱར་མིན།",
    "ལེགས་པར་སྦྱར་བ་དང་།",
    "ལེགས་པར་སྦྱར་བ་མ་ཡིན་པ་ཉིད་དོ།",
    "དོན་ཡོད་མ་ཡིན་ཡང་ཞེས་བྱ་བའི་སྒྲ་རྣམས་ནི་དོན་རྟོགས་པ་ཙམ་ལ་ཉེ་བར་མཁོ་བ་ཡིན་ན་དེ་ནི་ལེགས་པར་སྦྱར་བ་མ་ཡིན་པ་ལ་ཡང་ཉམས་པ་མེད་དོ།",
    "ཞེས་བྱ་བ་ནི་ཤིན་དུ་ཚབས་ཆེན་པོར་ལེགས་པ་དང་ལེགས་པ་མ་ཡིན་པར་འཛིན་པའི་རྨོངས་པ་བསལ་བའི་དོན་དུ་ཅི་ཞིག་བརྗོད་པར་བྱ་བ་ཡིན་ཏེ།",
    "ལེགས་པར་སྦྱར་བ་མ་བརྗོད་ན་ཕུང་བར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་ལ་ནི་ཡིད་ཆེས་པ་ཡིན་པའི་ཕྱིར།",
    "ཁྱད་པར་ཆེ་ཞེ་ན།",
    "དེའི་ཕྱིར་བརྗོད་བྱ་དང་རྗོད་བྱེད་ཀྱི་དངོས་པོ་ལ་ཡང་རྟོག་པ་ཙམ་སྐྱབས་ཡིན་པའི་ཕྱིར་སྒྲ་ཙམ་ལས་མ་གཏོགས་པར་ནི་ཡན་ལག་ཅན་ལ་སོགས་པ་གྲུབ་པ་མེད་དོ་ཞེས་གནས་སོ།",
    "དེས་ན་ཤེས་པ་དེའི་ཉེ་བར་ལེན་པ་ཅན་ཡིན་པར་སྨྲ་བ་རྣམ་པར་བརྟག་པའི་དོན་དུ་གལ་ཏེ་ཞེས་གསུངས་སོ།",
    "མིན་ཞེས་བྱ་བ་ནི་ཤེས་པ་སྐྱེད་པར་མི་འགྱུར་རོ།",
    "དུ་མ་ཉིད་དུ་ཞེས་གསུངས་སོ།",
    "འོན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རྣམ་པར་རྟོག་པ་གཉིས་པ་སློང་བའོ།",
    "དེ་སྐྱེས་པར་བྱེད་པ་ནི་ཞེས་བྱ་བའོ།",
    "དེ་ལྟ་ན་ཡང་ལུས་ཀྱི་ཆ་དུ་མ་ལྷན་ཅིག་བྱེད་པ་ཡིན་པའི་ཕྱིར་ཆ་གཅིག་མེད་ན་ཡང་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་མི་འགྱུར་སྙམ་ན།",
    "ཞེས་གསུངས་ཏེ།",
    "དེས་ན་རྣམ་པར་ཤེས་པ་མི་སྐྱེ་བ་ཡིན་ནོ་སྙམ་དུ་བསམས་པའོ།",
    "འོ་ན་ནི་ལྷན་ཅིག་བྱེད་པ་ཐ་དད་པ་གཞན་དང་གཞན་ལས་རྣམ་པར་ཤེས་པ་ཐ་དད་པར་འགྱུར་རོ་སྙམ་ན།",
    "མ་གསལ་འགྱུར་ཞེས་བྱ་བ་ནི་རིམ་མ་ཡིན་པར་འགྱུར་རོ།",
    "དེ་རྒྱུ་ནི་རྣམ་པར་ཤེས་པ་དུ་མའི་རྒྱུའོ།",
    "ཅིའི་ཕྱིར་བརྒལ་ཞིང་བརྟག་པར་འོས་པ་མ་ཡིན་ཞེ་ན།",
    "མེ་ནི་ཞེས་གསུངས་སོ།",
    "མེ་གཞན་དང་གཞན་ཉིད་ཡིན་པར་གསལ་བར་ངེས་པར་གཟུང་བའི་ཕྱིར་རོ།",
    "སད་པར་བྱེད་པའི་རྐྱེན་ནི་ཡུལ་ཉེ་བའོ།",
    "སྔོན་གྱི་འདུ་བྱེད་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "སྟོབས་དང་ལྡན་པས་ནི་འདོད་ཆགས་ལ་སོགས་པ་གྲགས་པར་འགྱུར་ལ་མི་ལྡན་པས་ནི་དམན་པར་འགྱུར་རོ།",
    "དོན་དུ་མ་ཅིག་ཅར་ཉིད་ཤེས་པར་འགྱུར་རོ།",
    "འོན་ཏེ་དོན་ཅིག་ཅར་འཛིན་པར་ནུས་པ་མ་ཡིན་ནོ་སྙམ་ན།",
    "འོན་ཀྱང་དེ་ནི་གཅིག་ཁོ་ན་ཡིན་ནོ་ཞེས་དགོངས་པར་བྱེད་པ་ནི།",
    "བདེ་བ་ལ་སོགས་པའི་རྣམ་པ་ལས་མ་གཏོགས་པར་ཡིད་དམིགས་པ་མེད་པའི་ཕྱིར་དེ་དོན་དུ་མ་འཛིན་པ་ཉིད་དུ་ཇི་ལྟར་བརྗོད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་རྣམ་པར་ཤེས་པ་བྱ་བ་མེད་པ་ཉིད་ལ་བརྟེན་ནས།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པ་དེའི་བདག་ཉིད་དུ་གྱུར་པ་དང་མ་འབྲེལ་བའི་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ནས་སོ།",
    "ཆགས་པ་ལ་སོགས་པའི་གནས་སྐབས་སུ་ནི་འགའ་ཞིག་ཁོ་ན་ལ་ཤེས་པར་ཡང་མཐོང་བ་ཡིན་ནོ།",
    "གོམས་པའི་ཁྱད་པར་གྱི་རིམ་པས་གང་ལ་ཆགས་པ་དེ་ལ་གཟུགས་བརྙན་སྐྱེ་བའི་ཕྱིར་ཤེས་པ་ཡིན་གྱི།",
    "ལན་དུ་འོ་ན་དེ་ཉིད་ཅེས་གསུངས་ཏེ།",
    "དེ་ཙམ་གྱིས་རྣམ་པར་ཤེས་པ་ཐོག་མ་མེད་པ་གྲུབ་པ་དང་ཤེས་པ་དང་ཤེས་བྱའི་ཐ་སྙད་ཡོངས་སུ་རྫོགས་པས་འདིར་གཟུགས་བརྙན་དང་ཐ་མི་དད་པའི་ཤེས་པ་བཙལ་བས་ཅི་ཞིག་བྱ།",
    "གཟུགས་བརྙན་གྱི་སྒྲས་བརྗོད་པར་བྱ་བའི་དོན།",
    "ལྟོས་པ་མེད་ན་ནི་ཤེས་པ་ཐ་དད་པར་ཁས་བླངས་ཀྱང་ཉེས་པ་དེ་གནས་པ་ཁོ་ནའོ་ཞེས་སྟོན་པ་ནི་ཕྱེད་པོ་ཕྱི་མ་འཆད་པ་ནི།",
    "དོན་གཞན་དེ་འཛིན་པར་མི་འགྱུར་རོ།",
    "རྣམ་པར་རྟོག་པ་རྣམས་ཅིག་ཅར་སྐྱེ་བར་འགྱུར་རོ།",
    "རྣམ་པར་འགྲེལ་པ་ནི་དབུགས་སྐད་ཅིག་མ་ཞེས་བྱ་བ་སྟེ།",
    "རྣམ་འགྲེལ་གཉིས་པ་རྣམ་པར་འགྲེལ་པ་ན་ལན་གསུང་བ་ནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་རྣམ་པར་འགྲེལ་པ་ནི་ཁས་བླངས་ནས་ཞེས་བྱ་བའོ།",
    "ཇི་ལྟར་རིགས་མཐུན་པའི་ཞེས་གསུངས་སོ།",
    "འོན་ཀྱང་ཉེ་བར་གནས་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟར་ནི་བརྗོད་པར་འཐད་པ་མ་ཡིན་ཏེ།",
    "ཁྱབ་པར་ཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "དེ་འགྱུར་ན་འགྱུར་བ་ཉིད་མེད་པར་དེ་ཡོད་ན་ཡོད་པ་ཉིད་མི་རྟོགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཙམ་ཉིད་ལས་ཞེས་བྱ་བ་ནི་ཁྱད་པར་དང་བྲལ་བའི་རྒྱུ་ཙམ་འབའ་ཞིག་ལས་སོ།",
    "དེའི་ཕྱིར་དེའི་ཁྱད་པར་གྱི་རྗེས་སུ་བྱེད་པ་ཁོ་ན་དེ་ཡོད་ན་ཡོད་པ་ཉིད་ཡིན་ནོ།",
    "འདིས་ནི་ཞེས་བྱ་བས་ནི་རྒྱུ་ཁྱད་པར་མེད་པས་འབྲས་བུ་ཁྱད་པར་མེད་པར་བསྟན་པས་སོ།",
    "ཡོངས་སུ་འགྱུར་བའི་ཁྱད་པར་ལ་ལྟོས་པའི་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གཞན་དང་གཞན་དག་དང་ལྡན་པ་སྟེ།",
    "དེ་ལྟ་བུའི་ལུས་ལས་རྣམ་པར་ཤེས་པ་གཞན་དང་གཞན་སྐྱེ་བ་ཡིན་ལ་ཁྱད་པར་ཐམས་ཅད་མེད་ན་འཆི་བའི་གནས་སྐབས་ན་མི་སྐྱེ་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་མེད་པའི་ཕྱིར་རྣམ་པར་ཤེས་པ་ཁྱད་པར་མེད་པར་འགྱུར་རོ།",
    "རང་བཞིན་ཁྱད་པར་མེད་ཀྱང་ཡོངས་སུ་གྱུར་པ་ཁྱད་པར་ཡོད་པར་སྟོན་པ་ནི་གལ་ཏེ་འོ་མ་ཞེས་བྱ་བའོ།",
    "སྐ་བ་དང་ཅིག་ཤོས་ཀྱི་ཁྱད་པར་གང་ལས་ཡིན་སྙམ་ན།",
    "དེ་བཞིན་དུ་ལུས་ཀྱང་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་གྱུར་པ་ཁྱད་པར་མེད་པ་ཅན་ཡིན་ཡང་འགྱུར་བ་ཡིན་ནོ།",
    "ཞེས་བྱ་བ་ནི་འོ་མ་ལ་སོགས་པའི་རྣམ་པར་འགྱུར་བའོ།",
    "འགའ་ཞིག་ཏུ་ཡོངས་སུ་གྱུར་པ་འགའ་ཞིག་སེམས་ཀྱི་ཁྱད་པར་གྱི་རྒྱུ་ཡིན་ནོ།",
    "དེས་ན་ལུས་ནི་མཚུངས་པ་དང་མི་མཚུངས་པ་དག་ལ་རྗེས་སུ་མཐུན་པ་གོམས་པའི་བག་ཆགས་གང་ཡིན་པ་དེ་ཉིད་རྣམ་པར་རྟོག་པ་དང་རྣམ་པར་མི་རྟོག་པ་ནི་ཤེས་པ་དག་ཐ་དད་པའམ་ཐ་མི་དད་པའི་རྒྱུ་ཡིན་ནོ།",
    "རྣམ་པར་རྟོག་པ་དང་རྣམ་པར་མི་རྟོག་པའི་ཤེས་པ་རྣམས་ལ་ཐ་དད་པ་དང་ཐ་མི་དད་པ་མེད་པའི་ཕྱིར་རོ།",
    "ཞར་ལ་བྱུང་བ་རྫོགས་པར་བྱས་ནས་གཉུག་མ་ཉེ་བར་སྡུད་པ་ནི།",
    "དེ་ལྟ་མ་ཡིན་ན་ཞེས་བྱ་བ་ནི་སོ་སོར་སྐྱེད་པར་ནུས་པའི་ཕྱོགས་ལའོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པ་འབའ་ཞིག་པ་རྣམས་སམ།",
    "རྣམ་པར་རྟོག་པ་གཅིག་དང་ལྡན་པ་རྣམས་ནི་ལྷན་ཅིག་སྐྱེད་པར་འདོད་པའི་ཕྱིར་རོ།",
    "གཏན་ཚིགས་ཡིན་ནོ་ཞེས་འབྲེལ་པར་བྱའོ།",
    "གཉིས་པ་བརྗོད་པ་ནི་ཆགས་པའི་ཁྱད་པར་ཏེ་ཞེས་བྱ་བའོ།",
    "དང་པོ་རྣམ་པར་འགྲེལ་པ་ནི་བག་ཆགས་བརྟན་པའི་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ནི་ཡིད་དོ།",
    "འབའ་ཞིག་གམ་ཞེས་བྱ་བ་ནི་ཇི་སྐད་བརྗོད་པའི་དེ་མ་ཐག་པ་ལ་མ་ལྟོས་པར་རོ།",
    "ཆགས་པའི་ཁྱད་པར་ཏེ་ཞེས་བྱ་བ་འཆད་པ་ནི།",
    "རྣམ་པར་རྟོག་པ་གཞན་ནི་སྐྱེ་བར་མཐོང་བ་མ་ཡིན་ནོ།",
    "མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་གྱི་རྣམ་པར་ཤེས་པའི་བག་ཆགས་ནི་རྣམ་པར་རྟོག་པ་སྐྱེད་པར་ནུས་པ་གང་ཡིན་པ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་སྐྱེ་བ་གང་དག་ལ།",
    "དེ་བར་དུ་བཅད་པ་ཞེས་བྱ་བ་ནུས་པ་མེད་པར་བྱས་པ་ཡོད་པ་དེ་དག་ནི་སྐྱེ་བར་མ་མཐོང་ངོ་ཞེས་འབྲེལ་ཏོ།",
    "གཞན་གྱིས་ཞེས་སྨོས་ཏེ་རྣམ་པར་རྟོག་པ་ཞེས་བྱ་བ་སྐབས་ཡིན་ནོ།",
    "དེ་ལྟར་རྣམ་པར་ཤེས་པ་ལས་རྣམ་པར་ཤེས་པ་སྐྱེ་བར་ཁས་བླང་བ་ན་རྣམ་པར་རྟོག་པ་གཅིག་སྐྱེ་བའི་ཚོགས་པ་ཡོད་པ་ཡིན་གྱི།",
    "ལྟོས་པར་བྱ་བ་གོམས་པ་ལ་སོགས་པ་ལ་ལོག་པ་མེད་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པར་འགྱུར་རོ།",
    "མ་ཆགས་པའི་དུས་ན་རྣམ་པར་རྟོག་པ་མེད་པ་བཞིན་དུ་ཉེ་བའི་དོན་རྣམས་ལ་དུས་གཅིག་ཏུ་རྣམ་པར་རྟོག་པ་དུ་མ་ཉིད་ཅི་སྟེ་མི་སྐྱེ་ཞེ་ན།",
    "འབད་པ་དང་ལྡན་པ་ལ་ཡང་ཅིག་ཅར་རྣམ་པར་རྟོག་པ་གཉིས་མི་སྐྱེ་བའི་ཕྱིར་ན་མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་རྣམ་པར་རྟོག་པ་གཅིག་སྐྱེད་པ་ལ་ནུས་པ་ངེས་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཅིག་གམ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་དང་བཅས་པའོ།",
    "དུ་མ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་མེད་པའོ།",
    "རྣམ་པར་ཤེས་པ་དེ་ཉིད་ལས་ཞེས་བྱ་བ་ནི་གཅིག་གམ་དུ་མ་སྐྱེས་པ་གང་ཡིན་པ་དེ་ཉིད་ལས་སོ།",
    "ཆགས་པའི་ཁྱད་པར་དེ་ཉིད་ལས་ཞེས་བྱ་བ་ནི་འདི་ཉིད་དུ་འབྲེལ་པར་བྱའོ།",
    "ལུས་ལ་ནི་དེ་བཞིན་དུ་སྐྱེད་པར་བྱེད་པའི་ནུས་པ་ཡོད་པའི་ཕྱིར་རྒྱུན་གཞན་དང་གཞན་ཡང་སྐྱེ་བར་འགྱུར་རོ་སྙམ་དུ་བསམས་པ་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་ལས་ཞེས་བྱ་བའོ།",
    "གནོད་པར་བྱེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ་ཞེས་སྟོན་པ་ན།",
    "ཆགས་པ་ཕྱོགས་སུ་ལྷུང་བར་བྱས།",
    "དེ་བས་ན་རྣམ་པར་ཤེས་པའི་ངེས་བྱེད་ཉིད་ནི་བརྒྱུད་ནས་གོམས་པ་ཉིད་ལས་སྐྱེས་པ་ཡིན་ནོ།",
    "ཇི་ལྟར་མི་རིགས་སྙམ་ན་ཆགས་པའི་རང་བཞིན་མ་ཡིན་པའི་ཞེས་གསུངས་སོ།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཤེས་པ་གཞན་སྐྱེ་བ་མ་བཟློགས་པས་སོ།",
    "དང་པོ་སྐྱེས་པའི་རྣམ་པར་ཤེས་པའི་རྒྱུན་མ་གཏོགས་པ་ནུས་པའི་ལུས་ལས་ཡང་དེ་ལྟར་སྐྱེས་པ་ན་ཚོགས་སུ་འགྱུར་རོ་ཞེས་བྱ་བའི་གནས་སྐབས་ཀྱི་མཐར་ཐུག་པའོ།",
    "ཇི་ལྟར་སྙམ་ན་ཕན་གདགས་པར་བྱ་བ་དང་ཞེས་བྱ་བ་གསུངས་སོ།",
    "འོན་ཏེ་ཞེས་བྱ་བ་ལ་ལུས་ལྷན་ཅིག་བྱེད་པ་ཅན་གྱི་རྣམ་པར་ཤེས་པས་ཞེས་བྱ་བ་ནི་བྱེད་པ་པོའོ།",
    "རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ནི་ལས་སོ།",
    "རིགས་མཐུན་པ་ཉིད་ཀྱིས་ནི་ཤེས་པའི་ཉེ་བར་ལེན་པ་ནི་ཤེས་པ་ཉིད་ཡིན་པར་གསལ་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བར་གྱི་གནས་སྐབས་ཀྱི་རྣམ་པར་ཤེས་པ་གང་ཤིན་དུ་ཁྱད་པར་ཆེ་བའི་ཕྱིར་ཇི་ལྟར་སྐྱེ་བ་དང་པོའི་རྣམ་པར་ཤེས་པ་རྣམ་པར་ཤེས་པ་གཞན་གྱི་སྒྲུབ་བྱེད་དུ་འགྱུར་སྙམ་དུ་དོགས་པ་བསུ་ནས་གསལ་བ་ལ་སོགས་ཞེས་གསུངས་སོ།",
    "ལུས་ལས་ཞེས་བྱ་བ་ནི་ཉེ་བར་ལེན་པར་གྱུར་པ་ལས་སོ།",
    "གང་ལ་ལས་ལྷན་ཅིག་བྱེད་པར་འགྱུར་བའི་རྒྱུ་དེ་གང་ཡིན་སྙམ་ན།",
    "གཟུགས་མེད་པའི་ཁམས་ནས་ཞེས་གསུངས་སོ།",
    "བག་ཆགས་འཛིན་པར་བྱེད་པ་ཉིད་ཀྱིས་སོ།",
    "གཟུགས་མེད་པའི་ཁམས་སུ་འཇུག་པ་ན་ཡོད་པར་གྱུར་པ་གང་ཡིན་པ་དེ་ཉིད་སྲིད་པ་གཞན་གྱི་ལུས་ཀྱི་རྒྱུ་ཡིན་ན་སྟེ།",
    "འདིས་ནི་འབའ་ཞིག་གནས་པ་ག་ལ་ཡིན་ཞེས་བྱ་བ་དེ་ནི་དམིགས་པས་གནོད་པར་བསྟན་ཏོ།",
    "གང་ཡང་འབའ་ཞིག་གནས་པར་འདོད་པ་ཉིད་དོ་ཞེས་བརྗོད་པ་དེ་ཡང་འདིས་གནོད་དོ་ཞེས་སྨྲས་པ་ནི།",
    "དེ་ལྟ་ན་ཡང་མ་དམིགས་པ་ཙམ་གྱིས་དེ་མེད་པར་ངེས་པ་མ་ཡིན་ནོ་ཞེས་འབྲེལ་ཏོ།",
    "དེ་མེད་པར་བརྗོད་པའི་ངེས་པའི་རྣམ་པར་བརྗོད་པ་ནི་སེམས་ཀྱི་རྒྱུན་ཞེས་བྱ་བའོ།",
    "འགལ་བས་ཁྱབ་པའི་དམིགས་པའོ་ཞེས་བྱ་བ་ནི་དང་པོ་ཉིད་ལ་ནི་དགག་པར་བྱ་བ་མཚམས་སྦྱོར་བ་དང་འགལ་བས་ཁྱབ་པའོ།",
    "འོན་ཏེ་ཚེ་འདི་པའི་ཞེས་བྱ་བ་ནི་སྔོན་གྱི་སྐྱེ་མཆེད་ལྔས་སྐྱེ་མཆེད་གཞན་གྱི་རང་བཞིན་གྱི་ལུས་བསྐྱེད་པར་ཟད་ཀྱི།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་མཚམས་སྦྱོར་བའི་ལུས་སོ།",
    "དཔེར་ན་ལྟོས་པའི་ཕྱིར་ཚུ་རོལ་དང་པོ་ལ་གཅིག་ཏུ་ངེས་པ་མ་ཡིན་པ་དེ་བཞིན་དུ་འདི་ལ་ཡང་ཡིན་པས་ཁྱད་པར་མེད་དོ།",
    "དེར་ཡང་ཞེས་བྱ་བ་ནི་ཁྱད་པར་དང་བཅས་པའི་གཏན་ཚིགས་ལའོ།",
    "དམིགས་པ་ཙམ་མེད་པར་མི་མཐུན་པའི་ཕྱོགས་ལ་མེད་པར་རྟོགས་པ་མ་ཡིན་ནོ།",
    "དཔེར་ན་བྱས་པའི་ཁྱད་པར་ནུས་པ་དང་སྒྲའི་ཡིན་པ་ཉིད་རྗེས་སུ་དཔག་པར་སེལ་བར་བྱེད་པ་ལ་ནུས་པ་མེད་པ་དེ་བཞིན་དུ་འདི་ཡང་ཡིན་ནོ།",
    "འོ་ན་གང་ལས་ཁྱད་པར་ལ་བརྟེན་པའི་ཉེས་པའི་གོ་སྐབས་སུ་མི་འགྱུར་བ་ཚེ་འདི་ཉིད་ཀྱི་སྐྱེ་མཆེད་ལྔ།",
    "ལུས་གཞན་སྐྱེ་བའི་རྒྱུ་ཡིན་ནོ་ཞེས་བྱ་བའི་སྤྱིས་ཀྱང་ཇི་ལྟར་ཁྱབ་པར་འགྲུབ་པར་འགྱུར་སྙམ་དུ་དོགས་ན།",
    "འདི་ལྟར་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཞེས་བྱ་བ་ནི་གསལ་བའི་ཁྱད་པར་ལ་ལྟོས་ནའོ།",
    "གལ་ཏེ་ཐ་སྙད་ཀྱང་ཁྱད་པར་གྱི་ཡུལ་ཅན་ཉིད་དུ་འགྱུར་རོ་སྙམ་ན།",
    "ཐ་སྙད་ནི་སྤྱིའི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་ན་ཡང་ཞེས་བྱ་བ་ནི་གསལ་བའི་ཁྱད་པར་ལ་མི་ལྟོས་ནའོ།",
    "དེ་ལྟ་བུར་ཞེས་བྱ་བ་ནི་གཡོ་བག་ལ་སོགས་པ་དང་ལྡན་པར་དབུས་ཀྱི་གནས་སྐབས་སུ་སྐྱེས་པར་གྲུབ་པ་ནའོ།",
    "གོམས་པའི་ཁྱད་པར་ལས་ཞེས་སྨོས་སོ།",
    "གཞན་གྱི་ཁྱད་པར་ནི་ཞེས་བྱ་བ་ནི་ཁུ་ཁྲག་གཞན་ལས་སྐྱེས་པ་ལ་སོགས་པའོ།",
    "གོམས་པ་ལས་སྐྱེས་པའི་ཞེས་གསུངས་སོ།",
    "དྲན་པས་བར་ཆོད་པས་ན་ཞེས་གསུངས་སོ།",
    "སྐྱེ་བ་གཞན་དེ་ཁོ་ནར་ཡོད་པ་ཡིན་ཡང་མེད་པ་བཞིན་དུ་རྟོགས་པ་དེས་ན་གཅིག་ཉིད་དུ་ལྷག་པར་ཞེན་པ་མ་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ཕྱི་མ་སྐད་ཅིག་ལུས་གཞན་དམིགས་པར་འགྱུར་རོ།",
    "དེ་ནི་སྔར་སྤྱིར་བཀག་པ་ཡིན་ནོ་ཞེས་རྟོགས་པར་བྱའོ།",
    "རྣམ་པར་ཤེས་པ་ནི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ནི་འདི་ཡོད་པའི་ཡུལ་ནི་དུས་བཞིན་དུ་བརྟགས་པ་དགག་པར་མི་ནུས་སོ་དེ་ཉིད་ཀྱང་རྟེན་གྱི་རྣམ་པ་ཡིན་ནོ།",
    "དམིགས་པར་བྱ་བའི་ལུས་ནི་ཞེས་བྱ་བའོ།",
    "དམིགས་པར་བྱ་བ་ལ་གནས་པའི་ཐ་སྙད་ནི་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྱད་པར་ལུས་ཐ་དད་པ་ཉིད་ཀྱང་མ་གྲུབ་པོ་ཞེས་བརྗོད་པ་ནི་ལུས་གཞན་ཉིད་ཀྱང་ཞེས་བྱ་བའོ།",
    "འོན་ཏེ་དོན་དམ་པར་ཐ་དད་པ་ཡོད་པའི་ཕྱིར།",
    "ཁྱད་པར་མ་གྲུབ་པ་ཡིན་ནོ་སྙམ་ན།",
    "དོན་དམ་པར་ནི་ཞེས་བྱ་བའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ལུས་ནི་ཉེ་བར་ལེན་པ་ཉིད་དུ་མི་འགལ་ལོ་སྙམ་ན་དེ་ཕྱིར་ཞེས་གསུངས་སོ།",
    "ལུས་ཞིག་པ་ན་སེམས་ཀྱང་འཇིག་པར་འགྱུར་རོ་ཞེ་ན།",
    "བསྲེག་པར་བྱ་བ་རང་ཉིད་མེ་དང་འབྲེལ་ན་འཚིག་པ་ཡིན་ལ།",
    "དེ་ལྟར་འཇིག་རྟེན་ཕ་རོལ་གྲུབ་ན་གོམས་པ་ཉམས་པ་མེད་པའི་ཕྱིར་ན་ཐམས་ཅད་མཁྱེན་པ་ལ་སྙོམས་པའི་རྣམ་པ་གཞན་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "ཁྱད་པར་ཅུང་ཟད་དང་ལྡན་པ་ཞེས་བྱ་བ་ནི་རབ་ཏུ་འགྲོ་བ་གང་ལ་ཁྱད་པར་ཅུང་ཟད་ཙམ་ཡོད་པའོ།",
    "རྟེན་བརྟན་པའི་རང་བཞིན་ཁོ་ན་འཕེལ་རབ་ཀྱི་མཐར་ཐུག་པ་ཡིན་ནོ་ཞེས་བརྗོད་པར་འདོད་པ་ཡིན་པར་བསམས་ནས་བརྗོད་པ་ནི་རང་བཞིན་དེ་འདྲའང་ཞེས་བྱ་བའོ།",
    "ཁྱད་པར་ཇི་ཙམ་ཞིག་བྱས་པའི་ཁྱད་པར་དེ་ཙམ་ལ།",
    "ནུས་པ་ཟད་པའི་སྒྲུབ་པར་བྱེད་པ་རྣམས་ལ།",
    "ཁྱད་པར་ཕྱི་མ་དག་ལ་ནུས་པ་མེད་པའི་ཕྱིར་ཡང་འབད་པ་ལ་ལྟོས་པའི་ཁྱད་པར་འཕེལ་བ་མ་ཡིན་ནོ།",
    "རྟེན་མི་བརྟན་པ་ཅན་གྱི་ཁྱད་པར་འཕེལ་བ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་གང་དང་གང་ཁྱད་པར་ཡིན་པ་དེ་ཐམས་ཅད་ནི་འཕེལ་བ་གནས་པ་ཅན་ཡིན་ཏེ།",
    "ཁྱད་པར་ཡིན་ནོ་ཅོག་ནི་ཞེས་གསུངས་སོ།",
    "འོན་ཀྱང་ཞེས་གསུངས་སོ།",
    "ཡང་རྩོལ་བ་ལ་ལྟོས་པ་ཉིད་གསལ་བར་བྱ་བའི་དོན་དུ་མཆོང་བ་ནི་ཞེས་གསུངས་སོ།",
    "གང་ལ་འཕེལ་བ་རྣམ་པར་གནས་པ་མེད་པར་འགྱུར་ལ།",
    "འཕེལ་བ་རྣམ་པར་གནས་པ་ཉིད་ལ་གཉི་གས་ཁྱབ་པ་ཉེ་བར་སྡུད་པ་ནི་དེའི་ཕྱིར་འཕེལ་བ་མཐར་ཐུག་པ་མ་ཡིན་པ་ཉིད་ནི་ཞེས་བྱ་བའོ།",
    "གཉི་ག་མེད་པའི་ཕྱིར་ཡིད་ཀྱི་ཡོན་ཏན་རྣམས་ནི་ཁྱབ་པར་བྱེད་པ་སྟོན་པ་ནི།",
    "ཁྱད་པར་འཕེལ་ཡང་མཐར་ཐུག་པར་འཕེལ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "འོ་ན་གང་ཞིག་ཤིན་དུ་འཕེལ་བ་དང་ལྡན་པར་འགྱུར་སྙམ་ན།",
    "གང་ཚེ་བྱས་གྱུར་པ་ཞེས་བྱ་བའོ།",
    "དེ་ལྟ་བུར་གྱུར་པའི་ཁྱད་པར་ནི་ཤིན་དུ་འཕེལ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྒྱུ་ཉེ་བ་ལ་ལྟོས་པ་ནི་ཞེས་གསུངས་སོ།",
    "ཤིན་དུ་བརྟན་པར་གོམས་པར་བྱས་པ་བརྗོད་པར་འདོད་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ཞེས་གསུངས་སོ།",
