    "འདྲིས་ཕྱིར་ཡིད་ཀྱི་གཏད་སོ་ཁྱོད་དུ་ཁུམས།",
    "གཞན་དུ་ཡོན་ཏན་ཕྱོགས་རེ་ལྡན་པ་དག།",
    "ཁྱོད་ནི་ཡང་སྲིད་མང་པོར་མཁས་གྲུབ་ཕྲེང་།",
    "ལྷ་འདྲེ་མི་གསུམ་གང་གིས་བརྫི་མི་ནུས།",
    "གང་གི་དུས་གསུམ་གཟིགས་པའི་ཨ་དར་ཤར།",
    "གང་ཐུགས་རིན་ཆེན་འབྱུང་གནས་བསྙེགས་སོང་ལགས།",
    "དེ་ནས་ཚོ་འདུའི་དགུས་སྟེང་སྒར་སོགས་རེབ་གོང་གི་དགོན་གྲོང་ཕལ་མོ་ཆེས་གདན་འདྲེན་དང་།",
    "སྟོན་མོ་འབུལ་བ་གྱ་ནོམ་པ་ཕུལ།",
    "ལོ་སྔ་ཕྱི་དེར་རྟ་ནོར་སྟོང་ཚོ་བདུན་གྱི་འབུལ་བ་བྱུང་ཞིང་ནོམ་རྫས་ཀྱི་བྱེ་བྲག་ལྟ་ཅི་སྨོས།",
    "ཨ་མཆོག་སྒར་གསར་དང་།",
    "རྒྱ་བོད་ཀྱི་སློང་མོ་བ་རྣམས་ལ་ཅི་འདོད་ཀྱི་གནང་སྦྱིན་བཟང་པོས་ཚིམ་པར་མཛད།",
    "ང་ལ་རེ་ཞིག་སྐྱོན་མེད་པ་འདྲ་སྟེ་གྲྭ་སློབ་འགའ་ལ་འཚེ་བ་ཡོད་པར་ལྟ་མོད།",
    "འདི་ནས་ཚོགས་ཀྱི་ཁྲིར་བཞུགས་ནས་གྲྭ་ཚང་གི་དོན་དུ་དཀའ་སྤྱད་སོགས་མཛད་ཚུལ་དང་ཕྱི་ནང་གི་འཚོ་སྐྱོང་ཐབས་དུ་མར་བྱས་ལུགས།",
    "མངའ་འབངས་ཀྱི་ཞལ་འདེབས་དང་བཅས་རྒྱུད་པ་སྙན་མོ་རིའི་བཞུགས་སྒར་དུ་གདན་དྲངས།",
    "ལོ་ཏོག་གི་སྲུང་རིམ།",
    "འཁྲུག་ལོང་གི་རྩོད་འདུམ།",
    "གནས་འདིར་ཐུགས་རྗེ་ཆེན་པོ་ཕྱག་སྟོང་སྤྱན་སྟོང་གི་སྐུ་བཞུགས་གནས་དང་བཅས་པ།",
    "གཉྫིར་ཆེ་ཆུང་གསུམ་སོགས་ཕྱི་ནང་གི་མཆོད་རྫས་དུ་མ།",
    "བྲག་སྒམ་ནང་གི་གདོང་རྣམས་སུ་ཐུགས་རྗེ་ཆེན་པོ་ཕྱག་སྟོང་སྤྱན་སྟོང་རེའི་མཐུན་རྐྱེན་གནང་།",
    "གུས་ཞབས་ཀྱི་སྒོ་ནས་མཆོད་བསྙེན་བགྱིད་པའི་སྦྱིན་བདག་གི་རིགས་རགས་རིམ་ཙམ་སྨོས་ན།",
    "གང་གི་མཁྱེན་དཔྱོད་ཟླ་བའི་མ་མ་ལས།",
    "གང་གིས་ཞུམ་པ་མེད་པར་རྒྱལ་སྲས་ཀྱི།",
    "ཕུལ་བྱུང་མཛད་པ་བདག་གིར་མཛད་པའི་ངོས།",
    "ཞེས་པའི་བཀའ་འཕྲིན་གནང་འདུག་༩ གདན་ས་ཆེན་པོ་སྟག་ཚང་ལྷ་མོར་ཕྱག་ཕེབས་ཏེ་ཞལ་གདམས་དུ་མ་དང་བཅས་མཛད་པའི་ཐ་མ་བསྟན་པ་དང་།",
    "དེ་ནས་མ་འགྱངས་པར་ཧོར་ཟླ་བཅུ་གཉིས་པའི་ཚེས་བརྒྱད་ཀྱི་ཉིན་བདག་སོགས་གྲྭ་ཚང་གིས་ཕེབས་བསུ་དང་སེར་སྦྲེང་བཅས་འདུ་ཁང་ནང་གི་ཁྲི་ཐོག་ཏུ་ཕེབས།",
    "དེར་ཐམས་ཅད་ཀྱིས་མཇལ་ཁ་ཞུས་ནས་སྒོར་ཕེབས་པའི་ཚེ་གཡོན་ངོས་ཀྱི་ཆབ་གྲལ་ནས་རེ་ཞིག་གྱང་ལོགས་སོགས་ལ་གཟིགས་ནས།",
    "འོན་ཀྱང་མ་ཕྱིན་ན་བླ་རྒན་ཚང་མི་དགའ་བས་སོས་དལ་གྱིས་ཡོང་གསུང་ནས་གུང་ཡོལ་གྱི་དུས་སུ་འདིར་ཕེབས་པ་ལ་གསོལ་ཇ་ཞལ་དུ་རེག་ཙམ་ལས་བཞེས་མ་ཐུབ།",
    "སྐུ་ཞབས་ཀྱི་གཟིམས་ཁང་ལ་རབ་གསལ་ཡོད་པ་མཛད་ན་ལེགས་མོད་ཞུས་པས།",
    "དེ་འདྲ་འདོད་ཀྱང་མ་བྱུང་བ་རེད་གསུངས་ནས་བཞེངས།",
    "ཕྱི་ཉིན་ནས་ཞི་དྲག་གི་རིམ་གྲོ་བུམ་སྒྲུབ།",
    "ཅེས་གསུངས་པས་བདག་གིས་གང་འཛོམས་ཀྱི་ངག་ནས་ཞབས་པད་བརྟན་དགོས་ཚུལ་དང་རིམ་གྲོ་སོགས་གང་དྲག་སྒྲུབ་པར་ནན་གྱིས་གསོལ་བས་སྐྱོན་མེད་ཐུགས་འཚེར་མི་དགོས་པས་བདེ་མོར་ཕེབས་ཨང་གསུངས།",
    "བརྒྱད་ཀྱི་སྐྱ་རེངས་ཤར་བའི་ཚེ་ནམ་མཁའི་གཤིས་ལ་ལྟོས་དང་ཁ་བ་ཞིག་བབ་ཨེ་འདུག་གསུངས་པར་ཕྱག་གཡོག་ཚོས་ཁ་བ་ཆེ་བར་སྣང་ཞུས་པས་འོ་ལགས།",
    "བདག་གིས་མཇལ་བར་ཕྱིན་དུས་སྤྱན་གྱིས་གཟིགས་ཙམ་བྱས་པ་དང་མཉམ་དུ་བཀྲུས་ནས་ན་བཟའ་གསར་བ་ཕུལ།",
    "གྲྭ་བ་བཅུ་གསུམ་རེ་ལ་གསང་བདེ་འཇིགས་གསུམ་གྱི་སྒྲུབ་མཆོད་བདག་འཇུག་བཅས་བདུན་ཕྲག་རེ་མོས་གྱིས་སྒྲུབ་པར་བྱས།",
    "ཕྱི་ནང་གི་འདུ་འགོད་ཀྱི་བྱ་བ་ཐམས་ཅད་ཀྱི་དབྱེ་འབྱེད་བདག་ཁོ་ནས་བྱེད་དགོས་པ་བྱུང་།",
    "བདུན་གསུམ་གྱི་བར་བདག་ཅག་མདུན་ན་འཁོད་པ་རྣམས་ཀྱིས་འཇིགས་བྱེད་ལ་བརྟེན་པའི་ཆོག་ཁྲུས་རེ་ཕུལ།",
    "ལ་མོ་ཞབས་དྲུང་དང་།",
    "ལོ་སྔ་ཕྱིའི་ཟས་ནོར་བཟང་རིགས་ཀྱང་ཀིརྟི་ལ་ཁྱེར་ནས་འདི་མགྲོན་ལམ་ལྟ་བུར་སོང་ཞིང་།",
    "དེ་ལྟ་བུའི་འདྲེན་པ་མཆོག་གི་དགོངས་རྫོགས་ཀྱི་རིམ་པའི་སྐབས་སུ་མཚོ་སྔོན་གྱི་རྒྱལ་པོ་ཆིང་ཝང་དཔོན་གཡོག་གསེར་ཁྲི་ཚང་གིས་གདན་འདྲེན་བྱས་པ་འདིར་ཕེབས།",
    "ལྷ་ལས་བབས་པའི་མཆོད་རྟེན་གྱི་ཐིག་དང་གཟུངས་གཞུག་གི་རིམ་པ་དངུལ་བརྡུང་རྒྱུའི་དོ་དམ་སོགས་ཀྱང་ཁོང་ལ་བཅོལ་བས་སྟབས་བདེ་བ་བྱུང་།",
    "མི་ཏོ་སྤྲུལ་བའི་སྐུ་རྒྱ་མཚོ་དོན་ལྡན་གྱིས་མཛད། ། ན་མོ་གུ་རུ་དེ་ཝ་ཌཱ་ཀ་ནི་ཡེ།",
    "རྣམ་གསུམ་མཁྱེན་བརྩེ་གཅིག་གྱུར་རྣམ་འདྲེན་གཞན་ལས་ཐུགས་རྗེ་ཆེས་ལྷག་ལྔ་བདོའི་ལུས་ཅན་ཡོངས་ཀྱི་སྐྱབས་མགོན་གསུམ་ལྡན་རྡོ་རྗེ་འཛིན་ཁྱོད་ལྷར་བཅས་འགྲོ་བའི་གཙུག་ན་མཛེས།",
    "ཁྱོད་ཐུགས་ཨ་དར་ཤ་ཡི་བཞིན་རས་ངོས།",
    "འཆི་མེད་སྒེག་མོའི་ཕ་མཐར་བརྒལ་དགོས་ཏེ།",
    "མཁས་པའི་སྙན་གྲགས་འཛིན་མའི་ཁྱོན་ཀུན་འགེངས།",
    "མཁས་དང་གྲུབ་པའི་གཙུགས་རྒྱན་ཁྱོད་མིན་སུ།",
    "དཔྱོད་ལྡན་མཁས་གྲུབ་དག་གིས་གཞལ་ནུས་སུ།",
    "སྐྲ་ཡི་རྩེ་མོས་ཆུ་གཏེར་མཇལ་དང་མཚུངས།",
    "འོན་ཀྱང་དཔྱོད་ལྡན་གསུང་གིས་ལེགས་བསྐུལ་ཚེ།",
    "ངོ་མཚར་ཞལ་གཟིགས་ཐོར་བུར་བཞུགས་པ་རྣམས།",
    "གནང་ནས་ཁྱོད་ཀྱིས་བསྒྲིགས་ཞེས་བཀའ་སྩལ་ཚེ།",
    "གང་གི་དགོངས་དོན་གསང་བའི་རྟོགས་བརྗོད་འདོད་འཇོའི་བསམ་འཕེལ་རིན་ཆེན་འཕྲེང་མཛེས་རྣམས།",
    "རྣམ་བཀྲ་ཚིག་གི་སྲད་བུར་བརྒྱུས་ཏེ་དོན་གཉེར་རྣམས་ཀྱི་སྒྲ་འཛིན་རྒྱན་དུ་སྤེལ།",
    "སྤེལ་ལ་རྩ་གསུམ་རྣམས་ཀྱང་དགྱེས་པས་མཆོག་དང་ཐུན་མོང་ཀུན་སྩོལ་ཅིག།",
    "ཟབ་དོན་སྒོམས་པས་སྐད་གཅིག་ཉིད་ལ་བདེན་པ་མངོན་དུ་གཟིགས་ཤིང་ཟུང་འཇུག་ཡེ་ཤེས་ལྔའི་བདག་ཉིད།",
    "གནས་ལྔ་མཁས་པའི་པཎ་ཆེན་མཁྱེན་པས་དུས་གསུམ་ལྐོག་གྱུར་གྱི་རྟོག་པ་ཐམས་ཅད་ས་ལེར་གཟིགས་པའི་མངོན་ཤེས་ལྔའི་བདག་ཉིད།",
    "མ་ལུས་ཤེས་བྱ་ཇི་རྙེད་གཟིགས་པའི་བདག།",
    "བདག་གི་ངག་ལ་སྤོབས་པའི་དགེ་ལེགས་སྩོལ།",
    "གང་གི་སྐུ་ལ་རྩ་གསུམ་ལྷ་ཚོགས་རྫོགས།",
    "ཡེ་ཤེས་རང་སྣང་དག་པའི་ཞིང་དུ་གཟིགས།",
    "གཟིགས་སྣང་ལྷ་དང་ལྷ་མོའི་རང་བཞིན་གསལ།",
    "ལྷ་ཡི་འཇའ་ཚོན་བླ་རེས་འོད་དུ་འཁྱིལ།",
    "ལྷག་གིས་འཛོམས་པས་དགེ་མཚན་འདི་ཀོ་མཚར།",
    "ཉམས་དང་རྨི་ལམ་དངོས་དང་ཕྱི་ནང་གི།",
    "དེའི་ཚེ་ཁོང་ཡང་ལྷག་པའི་ལྷའི་ང་རྒྱལ་གསལ་སྣང་གི་མི་འཇིགས་པའི་གདེང་མངོན་དུ་གྱུར་གསུངས།",
    "སྐྱེད་མོའི་ཚལ་མཆོག་ཏུ་ཡངས་ཤིང་ངོ་མཚར་བ་ཞིག་ན།",
    "འཕགས་མ་སྒྲོལ་མ་བཞུགས་པ་དང་བས་ཞལ་གྱི་བདུད་རྩིའི་བཅུད་ཕྱུང་བ་ཁོང་གི་ཞལ་དུ་བཞེས་པས་སྐུ་ཚེའི་བགེགས་དང་བར་ཆད་ཐམས་ཅད་ཞི་བར་གྱུར།",
    "ཇོ་བོའི་དཔྲལ་བའི་མཛོད་སྤུཪ་བཀྱེ་བས་འོད་ཟེར་དཀར་པོ་ཉི་མའི་མདངས་ལྟར་གསལ་བ་ཅིག་ཁོང་གི་ཐུགས་ཀར་ཐིམ་པའི་མོད་ལ་བདེ་སྟོང་ཟག་མེད་ཏིང་འཛིན་བསམ་གྱིས་མི་ཁྱབ་པ་ཡུན་རིང་དུ་ཐུགས་ལ་ཤར།",
    "ཁོང་ལྷག་པའི་ལྷའི་ང་རྒྱལ་གསལ་སྣང་གི་ཟིར་ཚེ།",
    "ཞེ་སྡང་འབར་བ་ཡབ་ཡུམ་འོད་དུ་འབར་བ་ཁོང་གི་དཔྲལ་བར་ཐིམ་ཚེ་བདེ་སྟོང་གི་ཉམས་སྐྱེ་ཞིང་འཇམ་དཔལ་རྡོ་རྗེ་དྲག་པོའི་གཟི་བརྗིད་ཅན་ཡང་ཡང་གསལ་བར་གྱུར།",
    "ཞེས་འོད་དཔུང་གི་ཀློང་ན་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ལ་མགོན་པོ་གུར་ཞལ།",
    "དམག་ཟོར་སོགས་ཀྱིས་ལེགས་པར་བསྐོར་བ་གར་དགུའི་ཉམས་དང་ལྡན་པ་གསལ་བར་མངོན་དུ་གཟིགས་ཚེ་བར་ཆད་བགེགས་ལས་རྒྱལ་བར་གྱུར་གསུངས།",
    "བལྟས་ཤིང་མཇལ་ནས་རང་ཡུལ་སོང་།",
