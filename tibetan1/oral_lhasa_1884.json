    "དེའང་རིགས་དང་ཉེ་བར་བསགས་པ་དང་ཡོངས་སུ་སྦྱང་བ་མ་བྱས་པས་ཀྱང་ངོ།",
    "དེ་ལ་རིགས་སམ་ངོ་བོ་ཉིད་ཀྱིས་ཐོགས་བཅས་ནི་གང་དག་ཕན་ཚུན་སྒྲིབ་པར་བྱེད་པའི་རྩིག་པ་ལ་སོགས་པ་དང་།",
    "དེ་ཉེ་བར་བསགས་པ་ལས་གོང་མར་རྒྱས་པར་འགྱུར་བ་རགས་པའི་དངོས་པོའོ།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་ཐོགས་པ་མེད་པར་བརྟག་ཅེ་ན།",
    "འདུས་བྱས་འདུས་མ་བྱས་གཉིས།",
    "དང་བཅས་པར་བརྟག་ཅེ་ན་མཛོད་ལས།",
    "ལམ་མ་གཏོགས་པའི་འདུས་བྱས་རྣམས།",
    "ཟག་རྣམས་ཀུན་ཏུ་རྒྱས་པར་འགྱུར།",
    "རང་བཞིན་ཡིན་པས་ཟག་པ་དང་བཅས་པར་བལྟའོ།",
    "ཞེས་གསུངས་སོ།",
    "འདུས་མ་བྱས་བོར་བ་ནི་ཟག་པ་དང་བཅས་པ་རྣམས་སོ།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་གཉེན་པོ་ཟག་པ་མེད་པར་བརྟག་ཅེ་ན།",
    "འདུས་མ་བྱས་རྣམ་གསུམ།",
    "ཟག་པའི་སྒོ་དྲུག་དང་མ་འབྲེལ་པ་ནི་ཟག་པ་མེད་པར་བལྟའོ།",
    "ཞེས་ཡེ་ཤེས་བཤེས་གཉེན་དང་ཡོན་ཏན་འོད་ཀྱིས་གསུངས་པ་ལྟར་རམ།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་འཐབ་པ་དང་བཅས་པར་བརྟག་ཅེ་ན།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་འཐབ་པ་མེད་པར་བརྟག་ཅེ་ན།",
    "ཟག་པ་མེད་པའི་གྲངས་ཇི་སྙེད་པར་འཐད་པ་མེད་པའི་དངོས་པོའང་དེ་སྙེད་དོ།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་ཟང་ཟིང་དང་བཅས་པར་བརྟག་ཅེ་ན།",
    "འཐབ་པ་དང་བཅས་པ་ཇི་སྙེད་པར་ཟང་ཟིང་དང་བཅས་པའང་དེ་སྙེད་དེ་ཟག་བཅས་ཀྱི་སྐབས་སུ་བསྟན་པ་ཉིད་དོ།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་ཟང་ཟིང་མེད་པར་བརྟག་ཅེ་ན།",
    "འཐབ་པ་མེད་པ་ཇི་སྙེད་པར་ཟང་ཟིང་མེད་པའང་དེ་སྙེད་དེ་ཟག་མེད་དོ།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་ཞེན་པ་རྟེན་པར་བརྟག་ཅེ་ན།",
    "ཟག་བཅས་རྣམས་དེའི་རྒྱུ་ལས་བྱུང་བའི་ཕྱིར་ཞེན་པ་རྟེན་པར་བལྟའོ།",
    "ཟང་ཟིང་དང་བཅས་པ་ཇི་སྙེད་པར་ཞེན་པ་རྟེན་པའང་དེ་སྙེད་དེ་ཟག་བཅས་ཉིད་དོ།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་འདུས་བྱས་སུ་བརྟག་ཅེ་ན།",
    "གནས་སྐབས་གཞན་དུ་འགྱུར་བར་སྣང་བ་དེ་རྒྱུ་དང་མཛོད་འགྲེལ་དུ་རྐྱེན་རྣམས་འདུས་ཤིང་ཕྲད་ནས་བྱས་པའི་ཕྱིར་འདུས་བྱས་སུ་བལྟའོ།",
    "འདི་ནི་འདུས་བྱས་སྤྱིའི་མཚན་ཉིད་དོ།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་འདུས་མ་བྱས་སུ་བརྟག་ཅེ་ན།",
    "མཐའ་གཉིས་སུ་ཞེན་པ་སྤང་བའི་ཕྱིར་འཇོག་ཚུལ་གཉིས་ལ་ལྟོས་ཏེ་འདུས་བྱས་ཀྱང་མ་ཡིན་འདུས་མ་བྱས་ཀྱང་མ་ཡིན་ཞེས་བྱའོ།",
    "འདོད་པ་སེམས་བསྐྱེད་པ་བཞིན་དུ་ལམ་སྒྲུབ་པར་བྱེད་པས་མྱ་ངན་ལས་འདས་པ་ལ་མངོན་དུ་ཕྱོགས་པ་དང་།",
    "ཡང་ན་མངོན་དུ་ཕྱོགས་པ་སྐྱེ་བར་ཡང་སྣང་ན་ཞིང་རྒྱབ་ཀྱིས་བལྟ་བ་འཇིག་པར་ཡང་སྣང་བས་འདུས་མ་བྱས་མ་ཡིན་ནོ།་",
    "ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་ལ་སོགས་པ་འགའ་ཞིག་འདུས་མ་བྱས་མཚན་ཉིད་པ་དང་འདུས་མ་བྱས་བཏགས་པ་བ་ཡིན་ལ།",
    "ཕུང་པོ་ལྔའི་དེ་བཞིན་ཉིད་ནི་འདུས་མ་བྱས་མཚན་ཉིད་པ་དང་འདུས་བྱས་བཏགས་པ་བ་ཡིན་པའི་ཕྱིར་རོ། བམ་པོ་གཉིས་པ་ནས་བརྩམས་ཏེ་འཆད་ཅེས་མཚམས་སྦྱར་ནས།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་འཇིག་རྟེན་པར་བརྟག་ཅེ་ན།",
    "སྐྱེ་མཆེད་ཕྱི་མ་གཉིས་ཀྱི་ཕྱོགས་གཅིག་ནི་ཡང་དག་པའི་ལམ་དང་རྗེས་ཐོབ་དེ་བཞིན་དུ་སྣང་བ་དང་འདུས་མ་བྱས་བོར་བ་རྣམས་སོ།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་འཇིག་རྟེན་ལས་འདས་པར་བརྟག་ཅེ་ན།",
    "སྤང་བྱ་ཁམས་གསུམ་པའི་ས་བོན་སྤོང་བའི་གཉེན་པོ་འཕགས་པའི་ལམ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ནི་འཇིག་རྟེན་ལས་འདས་པ་སྟེ།",
    "འདུས་མ་བྱས་ནི་རྟོག་པ་ཐམས་ཅད་ཀྱི་གཞིའི་གནས་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཕུང་པོ་ལྔ་པོ་རྣམས་དང་ཁམས་ཕྱི་མ་གསུམ་དང་སྐྱེ་མཆེད་ཕྱི་མ་གཉིས་ཀྱི་ཕྱོགས་གཅིག་གོ་ཞེས་པ་ནི་ཡང་དག་པའི་ལམ་དང་རྗེས་ཐོབ་སྟེ་དེ་བཞིན་ཉིད་དུ་སྣང་བ་ལ་སོགས་པ་དང་འདུས་མ་བྱས་ཀྱིས་བསྡུས་པ་རྣམས་སོ།",
    "མཉམ་པར་མ་བཞག་པ་དང་བཞག་པ་དང་།",
    "དེ་ལྟར་བྱུང་བས་བསྡུས་པའི་འདུས་བྱས་རྣམས་ནི་རྒྱུ་རྐྱེན་ལས་སྐྱེས་པ་ན་བྱུང་བའོ།",
    "ཐམས་ཅད་ཀྱི་ཕྱོགས་གཅིག་ནི་མ་འོངས་པ་དང་འདུས་མ་བྱས་བོར་བ་དག་གོ།",
    "གཉིད་དང་ཟས་དང་ཚངས་སྤྱོད་དང་སྙོམས་འཇུག་སྟེ་རྒྱས་པར་བྱེད་པའི་རྒྱུ་བཞི་ལས་བྱུང་བ་དང་།",
    "རྒྱས་པའི་གནས་སྐབས་སུ་ཕུང་པོ་རྣམས་ཡོངས་སུ་སྨིན་པར་བྱུང་བ་དང་།",
    "བདེ་འགྲོ་ནས་ངན་འགྲོར་སྐྱེས་པ་ཉམས་པར་བྱུང་བ་དང་།",
    "ངན་འགྲོ་ནས་བདེ་འགྲོ་སྐྱེས་པ་ཁྱད་པར་དུ་འཕགས་པར་བྱུང་བ་དང་།",
    "དགྲ་བཅོམ་པ་ཐ་མའི་ཕུང་པོ་མ་གཏོགས་པ་རྣམས་རིགས་འདྲ་ཕྱི་མ་སྐྱེད་པའི་ས་བོན་དང་བཅས་པར་བྱུང་བ་དང་།",
    "དགྲ་བཅོམ་པ་ཐ་མའི་ཕུང་པོ་ནི་རིགས་འདྲ་ཕྱི་མ་སྐྱེད་པའི་ཕྱིར་ས་བོན་དང་བཅས་པ་མ་ཡིན་པར་བྱུང་བ་དང་།",
    "འདུས་བྱས་ཀྱི་མཚན་ཉིད་སྐད་ཅིག་སོ་སོར་གནས་པའི་སྔ་མ་ཞིག་ནས་ཕྱི་མ་བྱུང་བ་དང་།",
    "དེ་ནི་རྒྱུ་ཡོད་ཀྱང་མ་བྱུང་བ་དང་འདུས་མ་བྱས་འབྱུང་དུ་མི་རུང་བས་མ་བྱུང་བའོ།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་འཛིན་པར་བརྟག་ཅེ་ན།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་ཕྱི་སརོལ་དུ་བལྟས་པར་བརྟག་ཅེ་ན།",
    "ཇི་ལྟར་དུ་ཞིག་ཅིའི་ཕྱིར་ནང་དུ་བལྟས་པར་བརྟག་ཅེ་ན།",
