    "རང་ཉིད་ཚོགས་དྲུག་དུས་གཅིག་པར་མི་འདོད་པ་དང་།",
    "ཉེ་བར་ལེན་པ་པོའི་བདག་གཉིས་ཕན་ཚུན་ལྟོས་ཀྱང་རང་བཞིན་དུ་ཡོད་པ་མི་འགལ་ཏེ།",
    "དང་པོ་ལའང་རང་བཞིན་གཞན་དུ་འགྱུར་བར་འགལ་བ་དང་།",
    "དང་པོ་ལའང་རང་བཞིན་གཞན་དངོས་དགག་པ་དང་།",
    "རང་བཞིན་འགའ་ཞིག་ལས་གཞན་གྱི་དངོས་པོའང་ཡིན་ལ་དེ་ཉིད་ཀྱི་རང་བཞིན་ཡང་ཡིན་པ་ཞིག་ལ་ནི་གཞན་གྱི་དངོས་པོའི་རང་བཞིན་ཡིན་ཞེས་བརྗོད་པ་ཡིན་པས་དེ་ལ་ཡང་རང་བཞིན་གྱིས་ཁྱབ་དགོས་སོ།",
    "གནས་སྐབས་འགྱུར་ཡང་རང་བཞིན་རྟག་གོ་ཞེས་ཀྱང་བརྗོད་པར་མི་རུས་ཏེ།",
    "ངར་འཛིན་དང་ང་ཡིར་འཛིན་པ་མེད་པའི་རྣལ་འབྱོར་པ་གང་ཡིན་པ་དེ་ཡང་རང་བཞིན་དུ་ཡོད་པ་མ་ཡིན་ཏེ་སྔར་བདག་དང་ཕུང་པོ་ཙམ་བཀག་པས་དེ་གཉིས་སུ་མ་འདུས་པའི་རྣལ་འབྱོར་པ་ཉིད་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "མ་འོངས་པའི་དུས་ཀྱང་རང་བཞིན་དུ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "འབྲས་བུ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའམ་མི་སྟོང་པ་ཞིག་སྐྱེ།",
    "གལ་ཏེ་དེ་ལྟར་འགག་བཞིན་སྐྱེ་བཞིན་གྱི་སྲིད་པ་གཉིས་དག་དུས་ལྷན་ཅིག་ཉིད་དུའང་རིགས་མིན་ན།",
    "བསྟན་པའི་ཚུལ་དེ་ལྟར་བློ་ངོ་གཉིས་ལ་ལྟོས་ནས་སྣང་བ་དང་རང་བཞིན་ཅིར་ཡང་མ་གྲུབ་པར་གནས་པ་ཡིན་པ་དང་།",
    "བྱད་ལ་སོགས་པའི་རིག་སྔགས་མན་ངག་ཇི་ལྟ་བ་བཞིན་བསྒྲུབས་ན་དགྲ་བརླག་པ་དང་རང་ལ་དངོས་གྲུབ་འབྱུང་ཡང་མན་ངག་བོར་ཏེ་ཉེས་པར་བསྒྲུབས་པས་རང་བརླག་པར་འགྱུར་བ་བཞིན་ནོ།",
    "བཅོས་མ་དང་རང་བཞིན་འགལ་བས་སོ།",
    "རང་རང་དངོས་ལ་ཐེར་ཟུག་གནས་དེ་ལ།",
    "གཟུགས་མེད་པའི་སྙོམས་བར་འདུག་པ་རྣམས་བདག་སྐྱེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ་པགས་མེད་པའི་སྙོམས་པ་དང་དྲུག་པ་རྣམས་སྤྱི་སྡུག་ཅེས་བྱ་བར་དགའ།",
    "མགྱོགས་པར་བཞི་འགྲམ་འོང་ནས་འདུག།",
    "རང་རང་མཐུན་པའི་རྫས་ཀྱིས་བཀང་།",
    "ག་དུས་ཡིན་རུང་འཕེལ་མེད་རང་སོར་གནས་པ་ཞིག་མ་ཡིན་པར་ཕྱི་རོལ་ཡུལ་གྱི་འགྱུར་ལྡོག་དང་འཚམས་པའི་གསོན་ཤུགས་ལྡན་པ་ཞིག་ངེས་པར་ཡིན་དགོས།",
    "གླུའི་གདངས་མཚམས་ནི་ག་དུས་ཡིན་རུང་དེ་འདྲའི་ངལ་རྩོལ་ལ་ཁྱད་པར་དུ་མངའ་བའི་ཐོན་སྐྱེད་བྱེད་སྟངས་ཀྱི་འགྲོས་དང་ཧ་ཅང་འཚམ་ཞིང་རན་ཞེས་གསུངས་ཡོད་པ་ལྟར།",
    "ད་ལྟའི་བོད་ཡིག་འདིའི་ཐོག་མའི་༢ེ་མཛད་པ་པོ་ཞིག་ཡིན་ཙ་ན།",
    "༧ ཞེས་སྒྲ་སྙན་ངག་ལ་སོགས་པ་ཡི་གེའི་རིགས་ཀུན་མ་ལུས་པར་བསྟན་ཚུལ་འཁོད་འདུག་ན།",
    "སྔོན་ཆད་བོད་འབངས་རྣམས་དུས་རྟག་ཏུ་འཐབ་འཁྲུག་སོགས་ཀྱི་མནར་གཅོད་མྱོང་བ་ནས་ད་ཆ་རང་རང་གང་བགྱི་བའི་ལས་ལ་བརྩོན་ཏེ་བློ་བདེ་བག་ཕེབས་སུ་འཁོད་ནས་དལ་དུ་ནི་མཆིས་པ།",
    "ཡང་ང་རང་གཉིས་པོའི་ལས་དེ།",
    "འཇིགས་དང་མ་འཇིགས་མི་འདུག།",
    "ཉ་པ་རྒད་པོའི་སེམས་དང་ཁྱད་མི་འདུག།",
    "དངོས་འབྲེལ་དགའ་བའི་ཉམས་འགྱུར་ཁོང་ནས་འཕྱུར་བའི་བདེན་དོན་གྱི་ཉམས་སྣང་ཞིག་སྐྱེ་རྒྱུ་འདུག་གང་ལགས་ཤེ་ན།",
    "ཅེས་སྒེག་པ་དང་རོལ་བ་ལ་སོགས་ལུས་ཀྱི་འདུག་སྟངས་དང་།",
    "དེ་དག་ནི་སྒྱུ་རྩོམ་སྤྱིར་དགོས་པའི་ཆ་རྐྱེན་དུ་འདུག་པ་དང་།",
    "སྙན་གཞུང་སྨྲ་བ་མང་པོས་བོད་ཀྱི་སྙན་ངག་ཅེས་པ་དེ་སྒྱུ་རྩོམ་སྤྱིའི་གོ་དོན་དང་གཉིས་སུ་མེད་པའི་ངོས་འཛིན་གནང་བཞིན་འདུག་པ་ཐུགས་ཤིན་ཏུ་མད་དེ།",
    "སྐབས་དེར་སྙན་ངག་ཚེཅེས་པས་རྩོམ་རིག་སྤྱིའི་མིང་ཚབ་ཏུ་དོན་གྱིས་གནས་པ་ཞེས་པ་ལ་སོགས་པའི་མཐུན་ཕྱོགས་ཀྱི་མཚོན་དཔེ་མང་དུ་དྲང་རྒྱུ་འདུག་པ་བཅས།",
    "དོན་དངོས་ཐོག་དེ་གཉིས་ཀ་རང་རང་སོ་སོའི་བཞེད་ཕྱོགས་ནས་བལྟས་ན་གཏན་ཚིགས་དང་འགལ་ཞིང་རྒྱུ་འབྲས་གོ་ལྡོག་པ་གང་ཡང་མེད་ན།",
    "གལ་ཏེ་སྐྱེ་བ་སྔ་མར་སྦྱངས་མེད་ན་སྐྱེ་བ་འདིར་སྐྱེས་ཐོབ་ཀྱི་ཤེས་རབ་ག་ལ་ཡོང་ཞེས་སོགས་ཞལ་མཐུན་ལྟ་བུར་གསུངས་འདུག་པ་ཡང་དེ་དེ་བཞིན་རྟོགས་པར་བྱའོ།",
    "གཉིས་པ་ནི་དེ་འདྲའི་སྒྱུ་རྩལ་གྱི་སྣང་བརྙན་དེའང་རང་གཅིག་པུའི་སེམས་ངོས་སུ་གསལ་བའི་ངག་སྦྱོར་གྱི་ཟོལ་ཙམ་ལ་བརྟེན་ཏེ་གནས་མུས་ཡིན་པ་ནས།",
    "ལྷག་དོན་ཚེག་བར་ཧ་ཅང་མང་ན་སྙན་ཆ་དེ་ཙམ་མི་ཐོན་པའི་ཐོག་རྩོམ་དཀའ་བ་ཞིག་ཀྱང་ཡིན་འདུག་པས།",
    "ཨུ་རུ་སུའི་རྩོམ་པ་པོ་ཀང་ཁྲ་ལོ་ཧྥུས་ཚི་ངས་ང་རང་ལ་མྱོང་ཆ་བྱུང་བའི་དངོས་པོ་དང་།",
    "གཏམ་རྒྱུད་ཟེར་བ་སོགས་ལས་བརྩམས་སྒྲུང་ཞེས་པའི་ཐ་སྙད་འདི་འདྲ་ཞིག་སྔར་ནས་ཡོད་པ་གོ་ཐོས་མི་འདུག་དེས་ན་འདི་ནི་རྗེས་སུ་བྱུང་བའི་ཐ་སྙད་ཅིག་ཡིན་ལ་དེའང་ཞིབ་པར་གླེང་ན་དུས་རབས་ཉི་ཤུ་པའི་ལོ་རབས་བདུན་ཅུའི་ནང་གཞི་ནས་བྱུང་ཞིང་དེ་ནི་རྒྱ་རིགས་ཀྱི་ཞེས་པའི་རྩོམ་ལུས་དེ་མཚོན་པའི་གསར་བྱུང་ཐ་སྙད་ཅིག་ཡིན་ངེས།",
    "ལྟ་བའི་དོན་ཡིན་ཞེས་སྒེག་པ་དང་རོལ་པ་ལ་སོགས་པའི་ཉམས་གཙོ་བོར་གྱུར་པའི་ལུས་ཀྱི་འདུག་སྟངས་དང་།",
    "ག་དུས་ཡིན་ཡང་སློབ་ལ་མི་བརྩོན་དེ་འདྲའི་གྲོགས་པོ་མི་འདོད་ང་།",
    "ག་དུས་ཡིན་ཡང་མ་ཉམས་གསལ་ཞིང་ཆད་མེད་རྒྱུ་བའི་ཆུ་གངྒཱ།",
    "དཀའ་ཉེན་ཆེ་སར་ག་དུས་ཡིན་ན་ཡང་།",
    "ཉ་པ་རྒད་པོའི་སེམས་དང་ཁྱད་མི་འདུག།",
    "ཡོན་ཏན་མི་འདུག་མ་གསུངས།",
