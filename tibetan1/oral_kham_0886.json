    "ཁྱེད་རང་ལ་ཡང་འགལ་ལ།",
    "དོན་དམ་ཀུན་རྫོབ་ཀྱི་སྲིད་གསུམ་དེ་ཀུན་ཀྱང་རང་བཞིན་ཁྱབ་བྱེད་བདེ་སྟོང་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་སུ་རོ་གཅིག་པ།",
    "དེ་ནི་དཔྱད་པ་མེད་པར་ཁས་ལེན་གྱི་འདུག་ན།",
    "དེ་དང་འདི་ལ་ཁྱད་ཅི་འདུག་ལྟོས་ཤིག་དེས་ན་བསྐྱེད་རིམ་གྱི་ཆ་ལག་ཐིག་ཕྲ་ལ་རྫོགས་རིམ་གྱི་ཐ་སྙད་སྐབས་འགར་སྦྱར་བ་ལ་ཉེས་པ་ཅི་ཡོད།",
    "སྔགས་ཀྱི་ལྷ་ལ་རྣམ་རྟོག་ཀྱང་མེད་ཅིང་རང་ལས་གཞན་དུ་གྲུབ་པ་ཡང་མེད་དེ།",
    "འོན་ཀྱང་རང་ལུགས་ནི་འདི་ཡིན་ཏེ།",
    "སྒྲུབ་པོའི་མིང་ཡིག་དང་པོ་ར་ཡིག་ལ་སྔགས་ཀྱི་དང་པོ་ལོ་ཙ་ན་ལྟ་བུ་ལ་ཡིག་ས་ཁམས་ཡོད་ན།",
    "ཡང་རང་ལུས་ཕལ་པ་རྩ་འཁོར་ལས་བྱུང་བའི་རྡོ་རྗེ་དང་བཅས་པ་བཞག་ནས།",
    "ཡེ་ཤེས་ཀྱི་ལྷ་དུས་ཀྱི་འཁོར་ལོ་གཙུག་ཏོར་དུ་བསྟིམ་པ་ཡིན་ཟེར་ན་ཡང་རང་ཐ་མལ་དུ་འགྱུར་བས་ཤིན་ཏུ་མི་འཐད་ལ།",
    "མཁའ་འགྲོ་མའི་གཏོར་སྔགས་ཀྱང་དེ་ལ་འཐུས་པར་མཛད་པའི་སྲོལ་ཞིག་རྗེ་ཕྱོགས་པ་མན་ཆད་ལ་བྱུང་འདུག་ཀྱང་།",
    "གཞལ་ཡས་ཁང་གུར་དང་བཅས་པ་བཅུ་གཅིག་དུས་གཅིག་ཏུ་བསྐྱེད།",
    "རྩ་བ་མེད་པར་མང་དུ་སྨྲ་ཞེས་བྱ་བའི་དོན་དེ་ཁྱེད་དག་རང་ལ་ཚང་འདུག་པ་ངོ་ཤེས་པར་མཛད་འཚལ་ལོ།",
    "ཕ་རོལ་སུན་འབྱིན་ཅིང་རང་གཞུང་འཛུགས་པ་དགོས་པ་དང་།",
    "བསྐྱེད་རིམ་ལ་བརྟན་པ་ཐོབ་པའི་གང་ཟག་དེ་ཚེ་འདིར་ས་བདུན་པ་ངེས་པར་ཐོབ་ཅེས་པར་གོ་འདུག་སྟེ།",
    "ཞེས་བསམ་པར་འདུག་སྟེ།",
    "ཞིང་སྣ་ཚོགས་སུ་མི་རྒྱུ་བར་གནས་གཅིག་ཏུ་འདུག་པ་ལ་ནི།",
    "ས་སྔགས་ཀྱིས་སྤྲུལ་པའམ་ལྷ་རྫས་ཀྱི་རང་བཞིན་དེ་ཡང་རང་ལ་ཇི་ལྟར་སྣང་བ་དེ་ཙམ་ཁྱབ་པར་འགྱུར་ཏེ།",
    "དེ་དག་དུས་གཞན་ཞིག་ན་ལམ་འདིར་འཇུག་པར་ཤོག།",
    "འཕགས་རྒྱུད་ཀྱི་བདེན་པའི་གནས་ལུགས་མངོན་སུམ་དུ་རྟོགས་པའི་ཡེ་ཤེས་དེས་རང་ཡུལ་གྱི་དམིགས་རྣམ་མི་བརྗེད་པར་དྲན་འདུག་པའི་ཆའི་སེམས་བྱུང་དེ།",
    "འཕགས་རྒྱུད་ཀྱི་ཞི་གནས་དང་དམིགས་པ་ལ་སེམས་རབ་ཏུ་འཛིན་པ་དང་བྱིང་རྒོད་བྲལ་ཚེ་གཉེན་པོ་བསྟེན་པ་ལ་མི་རྩོལ་བའི་བཏང་སྙོམས་རྣམས་མི་བརྗེད་པར་དྲན་འདུག་པའི་ཆའི་སེམས་བྱུང་དེ་ཡང་དག་པའི་དྲན་པའོ།",
    "འབྲིང་དུ་དབྱེ་ན་དངོས་པོ་དངོས་པོ་མེད་པ་སྟོང་པ་ཉིད་དང་རང་གཞན་གྱི་ངོ་བོ་སྟོང་པ་ཉིད་དང་བཞི་དང་།",
    "ཕྱི་དོན་ཁས་མི་ལེན་པ་ཙམ་ལས་གོང་རང་རྒྱུད་པ་དང་འདྲའོ།",
    "ཁྱེད་ལྟ་བུའི་མཁས་པ་བོད་ན་བཞུགས་བཞིན་དུ་ཁོང་བོད་དུ་འོང་མི་དགོས་པར་འདུག་གསུངས།",
    "ང་བོད་དུ་འོང་དགོས་པར་འདུག་གསུངས།",
    "ཉལ་གཉིད་འགྲོ་འདུག་མང་པོ་སོགས་ལྟ་བུ་འདོད་རྒྱལ་གྱི་མིང་དང་།",
    "ཐམས་ཅད་ཅང་མི་སྨྲ་བར་འདུགདེ་མ་ཐག་ཏུ་མེ་དོང་དུ་མཆོངས་སོ།",
    "རྒྱལ་བུ་དེ་ཡང་པདྨའི་སྟེང་ན་འདུག་པར་གྱུར་ཏེ།",
    "ཇོ་ནང་རང་ལུགས་ལ་རྣམ་རྟོག་འཁོར་རྩ་དང་།",
    "ཇི་ལྟར་བུ་ཆུང་ཚུལ་དུ་འདུག་པ་ཡིས།",
    "ཉན་རང་དགྲ་བཅོམ་པའི་ལམ་ཡང་རང་ལམ་གྱི་མི་སློབ་ལམ་ཡིན་ཡང་རྣམ་མཁྱེན་མ་ཐོབ་པར་དུ་གོང་ནས་གོང་དུ་བསླབ་ཅིང་བགྲོད་དགོས་པའི་སློབ་ལམ་ཡིན་པའི་ཕྱིར་རོ།",
    "༢༧མཚམས་སྐར་དྲིལ་ཉི་དྷུ་འགྲུབ་ཟླ་རྒྱུར་རང་རང་སྒྱུར་བྱེད་བྱིན།",
    "༦༡༣ང་རང་རང་འཁོར་ལོས་དབྱུག་ལ་བསྒྲིལ་༦༧ འབྱུང་མེ་ཟླས་ཐོབ་ཡང་རྒྱུའི་དབྱུག་༡༣་ལྷག་མ་མཁའ་རོས་བསྒྱུར་སྲང་བཅུག་མདའ་ཡོན་ཟླས་ཐོབ་ཆུ་སྲུང་སྟེ།",
    "བྱིན་ཚེ་རང་རང་འཁོར་ལོས་བསྒྲིལ།",
    "ཅེས་གསུང་སྲོལ་འདུག་ཚངས་དབྱངས་རྒྱ་མཚོ་དང་།",
    "ཁ་རོག་ཙོག་འདུགལ་སྐྱོན་མེད།",
    "ང་བོད་དུ་འགྲོ་བས་ཁྱེད་རྣམས་རང་རང་ལ་ཚོས་གང་དགོས་པ་དང་།",
    "དེའི་ཉེ་སྐོར་དུ་ཕེ་རོའི་བཞུགས་གནས་བྲག་ཕུག་བཟང་བོ་ཞིག་འདུག་པར་ཟླ་ཤས་བསྡད་ཅེས་འཁོད།",
    "དཔེར་ན་ཆུ་ལ་དེ་ཆུ་ཟེར་བ་དེ་ཀློག་དུས་དེ་ཅི་དང་།",
    "བྱ་ལ་བྱ་ཟེར་བ་དེ་ཀློག་དུས་པ་ཡ་ཕྱི་ལ་ཕྱི་ཟེར་བ་དེ་ཀློག་དུས་མི་ཡི་ཁ་ཕྲུ་ལ་ཁ་ཕྲུ་ཟེར་བ་དེ་ཀློག་དུས་ཁ་ཕུ་རུ་ཁབ་ལ་ད་ཁབ་ཟེར་བ་དེ་ད་ཀབ་ཀ་འཛེར་ཟེར་བར་ཀ་གཙེར།",
    "ཁྱེད་ཀྱི་ཐུགས་ལ་མི་འབབ་ན་ལོས་ཡིན།",
    "སྐུ་ཨ་ལོས་ཁོག་ཟེར་ས་དེར་རི་དྭགས་གཅན་གཟན་མ་གཏོགས་ཅི་ཡང་མི་འདུག་ཟེར།",
    "རང་རང་སྐལ་བ་ཇི་བཞིན་བསྒྲགས་པ་ཡིས།",
    "ཨ་ར་པ་ཙ་ན་ཅི་ནུས་བཟླ།",
    "བླང་བྱ་གང་མཐོང་རང་གཞན་གྱིས་འཐོབ་པར་སྨོན་ན་ལམ་རིམ་ཤ་སྟག་སྟེ།",
    "ཁ་མིག་གདངས་ཏེ་ཉམས་ལེན་ཕྱོགས་གང་ན་འདུག་པ་བལྟ་མི་དགོས་ཏེ།",
    "གནས་སྐབས་ཀྱི་ལྡོག་དུས་གཉིས་དང་།",
    "ཁ་ཅིག་སོགས་སྨོས་ཀྱང་རང་ལུགས་ཀྱི་མཁས་པ་སོ་སོས་ཟློས་སྤོང་བྱེད་ཚུལ་དཀྱུས་གཅིག་ཏུ་མཛད་པ་སྟེ།",
    "ཉི་སྣང་དུ་སྐབས་དེ་བཟོད་པར་སྦྱར་འདུག་པས་སློབ་དཔོན་གྱི་དགོངས་པ་ཟབ།",
    "དེ་ཁོ་ཁོ་རང་ཡིན་མིན་ཀྱང་བྱེད་པར་བྱའོ།",
    "ཞུགས་གནས་གཞན་དང་རང་རྒྱལ་གསུམ་ལ་ཡང་དཔྱད་པས་ཤེས།",
    "ཉན་ཐོས་འབྲེལ་ཆུང་རང་རྒྱལ་དགྲ་བཅོམ་གཙོ།",
    "འགོག་པ་མངོན་མཐོང་འདྲ་ཡང་རང་སྟེང་མིན།",
    "སྔ་རབས་དག་སྟེ་ཞར་བྱུང་རང་རྒྱུད་ཀྱང་།",
    "དངོས་པོ་ཟད་དང་རང་བཞིན་མེད་པ་གཅིག།",
    "མེད་དང་རང་བཞིན་མེད་འཛིན་འགལ་ལམ་མིན།",
    "རང་མྱོང་གཞན་མྱོང་མེད་ཀྱང་རང་གཞན་མྱོང་།",
    "རང་མྱོང་རང་རིག་ཇི་བཞིན་འདིར་ཡང་བཀག།",
    "བ་ཞན་མྱོང་རང་རིག་ལ་ནི་མི་དྲན་སྐྱོན།",
    "དཔྱད་ནས་མིན་ཀྱང་རང་རང་དྲན་པས་འགྲུབ།",
    "རང་མྱོང་རང་རིག་མ་ཡིན་གཉིས་སྣང་བཅས།",
    "འོན་ཀྱང་རང་དགའི་ངོར་ཙམ་འཇོག་མ་ངེས།",
    "ཚོར་བ་རང་མྱོང་འོན་ཀྱང་རང་རིག་འགལ།",
    "རང་རིག་མེད་ཀྱང་གཟུགས་རུང་རང་མཚན་ནོ།",
    "ང་འོ་ཙམ་བློས་དུས་གསུམ་ས་དགུར་དམིགས།",
    "མཐའ་བཞིར་སྐྱེ་བ་དང་རང་བཞིན་གྱིས་སྐྱེ་བ་གཉིས་འདྲའམ།",
    "དག་པའི་ཞིང་རང་ངོས་ནས་སྣང་ཞིང་རང་ངོས་ནས་གྲུབ་བམ།",
    "དེར་མྱོང་བའི་ཚུལ་དཔྱད་པ་སྐབས་སུ་བབ་ཅིང་དེ་ལ་བརྟག་པའི་མཐའ་གཞན་མྱོང་དང་རང་མྱོང་གཉིས་ཕྱི་མ་ལ་གཟུང་འཛིན་གཉིས་ཀར་འཇུག་པ་དང་།",
    "ཁྱེད་རང་བར་ནས་དུམ་བུ་ཞིག་ཁ་ཕྲལ་ཡང་།",
    "མེད་དགོས་པ་ཀུན་གཞི་དང་རང་རིག་ཡོད་ཟེར་བ་ལ།",
    "ཆེན་ཁུར་དུ་འཁྱེར་བའི་གྲོགས་ངན་བྱེད་པར་འདུག་པས་མི་སྐྱོན་སྙམ་ནས་སེམས་དཔའ་བསྐྱེད་དེ་སྨྲས་པ།",
    "སྨེ་བ་གཉིས་ནག་དུས་སྦྱོར་བདུད་རྩི་ཐུན་མཚམས་ཤར་བའི་ཉི་དྲོས་ཀྱི་སྟོད་ཆར།",
    "ཆུ་ཡོས་ཟླ་ཚེས་ལ་ཡོང་འདུག་ཟེར།",
    "རྟོག་གཉིས་གཅིག་ཅར་མཐོང་བ་མེད་གསུང་བ་རང་ལུགས་བྱས་འདུག་པས་སྟར་རྡོག་སྐམ་པོའི་དེ་ཉིད་གོ་བར་ཟད་དོ།",
    "འོན་ཀྱང་རང་སྣང་འཁྲུལ་བའི་སྲིན་བུ་དང་།",
    "ད་ནི་ཁྱེད་རང་རྣམས་འཁྲུལ་གཞི་དེ་བུ་མ་སྣང་བའི་ཚིག་ལ་བརྩིག་པར་བྱ་སྟེ།",
    "སྒྲིམས་ནས་ལྟོས་དང་རང་ཡང་ཡིད་འབྱུང་འགྱུར།",
    "ད་དུང་མང་བོ་ལུས་འདུག་པ་ཁྱེད་ཅག་ལ་སྦྱིན་པར་བྱ་སྟེ།",
    "བཀའ་གདམས་པའི་གསུང་གྲོས་ལ་སེམས་ཀྱི་དཔངས་དམའ་དགོས་པར་འདུག་པ་དགོངས་འཚལ།",
    "ད་ཁས་ལེན་མེད་པའི་ལྟ་བ་དེ་སྐྱོང་ལ་མཐོ་རིས་སུ་འགྲོ་ན་འབྲས་བུ་ཆེ་བའི་ཕྱོགས་ཤིག་ན་དབེན་པའི་རི་ཁྲོད་ཉམས་དགའ་བ་ཞིག་ཡོད་འདུག་པས་དེར་བསྐལ་ཆེན་ལྔ་བརྒྱུར་མཚམས་སུ་བཞུགས་པར་ཞུ།",
    "ཁྱེད་རང་ལྟར་ན་སྲོག་དང་ལྡན་ན་སྲོག་ཆགས་དང་།",
    "རང་རང་ལས་ཀྱི་བགོ་སྐལ་མི་བསྣོལ་བ།",
    "རྩོད་ལན་འདིར་རིགས་པ་དང་གོ་བ་དམན་པའི་ངང་ཚུལ་མང་དུ་འདུག་པས་མཁས་པོ་ཉིད་ནས་༥ཛད་པ་མིན་ནམ་གང་ལྟར།",
    "རྒྱལ་བོ་ལྐོག་ཏུ་འདུག་ན་མཛེས།",
    "ཧོར་ཟླ་དང་བོ་སོགས་དྲུག་ལ་ཤོལ་བྱུང་ཚེ་ཐུབ་པའི་རྗེས་སུ་ཐུབ་པ་དམ་པ་འགའ་ཞིག་གསུངས་པ་རྗེ་ཡབ་སྲས་ཀྱི་ཕྱག་ལེན་ལས་ཞིབ་ཆ་ཐོན་པ་ལྟར་འདུག་པས་དེ་ལྟར་བྱེད་དོ་སྙམ་ན།",
    "གཞན་གྱི་ལོ་མགོ་རང་རང་དུས་ཟླས་དབྱེ།",
    "ཁྱེད་རང་དཀར་ཆ་ཕྲོགས་པ་ལ་གནམ་གང་ཟེར་བ་སྔོན་མེད་པའི་ཐ་སྙད་དེ།",
    "ཁྱེད་རང་ཁས་བླངས་པ་འགལ་ལོ།",
    "ཁྱེད་རང་དེ་དུས་བག་སྟོན་གྱི་སར་བོས་པ་ཡིན་ན།་",
    "དེ་ཡང་གུང་བསྒྲིགས་པའི་དཔྱད་པ་མ་དག་པར་ཁ་ཚོན་གཅོད་པ་སྐྱོན་པར་གདའ་ཞེས་དང་།",
    "སངས་འཕགས་ལ་མིན་མཉམ་དུ་འདུག་པ་སོགས་བྲིས་པས་མི་ལང་ངོ།",
    "འོག་ཏུའང་རང་བཞིན་དང་འགལ་བའི་ཁྱབ་བྱ་ཞེས་པའོ།",
    "འབད་ཀྱང་རང་དོན་འདུན་པ་བོར་བར་ཟད།",
    "འདིར་དགོས་པ་ཡང་རང་འབྲས་རྗེས་དཔག་བསྐྱེད་པའི་ཞེས་སོགས་སྦྱོར་དགོས།",
    "རང་དང་མཚུངས་ལྡན་གྱི་སེམས་ཡོད་པའི་ཤེས་པ་དང་རང་དང་མཚུངས་ལྡན་གྱི་སེམས་བྱུང་ཡོད་པའི་ཤེས་པ་ལ་མུ་བཞི་ཡོད་པའི་ཕྱིར།",
    "རང་དང་མཚུངས་ལྡན་གྱི་ཀུན་འགྲོ་ལྔ་ཡོད་པའི་ཤེས་པ་དང་རང་དང་མཚུངས་ལྡན་གྱི་ཡུལ་ངེས་ལྔ་ཡོད་པའི་ཤེས་པ་ལ་མུ་བཞི་ཡོད་པའི་ཕྱིར།",
    "ཐེ་ཚོམ་དང་རང་སྟོབས་ཀྱིས་རྩ་གཉིས་པའི་བློ་ལ་མུ་བཞི་ཡོད་པའི་ཕྱིར།",
    "རང་ཡུལ་མེད་པའི་ཤེས་པ་དང་རང་ཡུལ་ཡོད་པའི་རྟོག་པ་ལ་མུ་བཞི་ཡོད་པའི་ཕྱིར།",
    "དཔེ་སྟོན་པ་དང་རང་རྒྱུད་པས་འདོད་པའི་ཚད་ཡ་ལ་མུ་བཞི་ཡོད་པའི་ཕྱིར།",
    "སྐྱེས་བུའི་རྩོལ་བྱུང་རང་རྒྱུའི་སྦྱོར་རམ་མིན།",
    "རང་ཡིན་རྫས་མཐུན་གང་རུང་རང་མིན་ལྡོག།",
    "དོན་བྱེད་ནུས་དང་རང་སྐྱ་འཛིན་པ་བཞི།",
    "བུམ་པ་གཞིར་བཟུང་རང་རྒྱུ་ལས་སྐྱེས་དང་།",
    "དངོས་ལ་རང་རང་གཅིག་ཡིན་མི་རྟག་ངེས།",
    "འཇིག་དུས་འགགས་དུས་འདྲ་ཡང་ཡོད་དུས་མིན།",
    "སྐད་ཅིག་ཐ་མ་འཇིག་དུས་འགག་དུས་མིན།",
    "སྐྱེ་འགགས་གནས་གསུམ་ཞིག་དུས་ལྷན་མཚུངས་དཔྱད།",
    "སྐྱེ་འཇིག་དུས་ཀྱང་བརྒྱུད་པའི་རྒྱུ་འབྲས་མིན།",
    "ཤར་ནུབ་སྔ་ཕྱིའི་དུས་དང་རང་བཞིན་ལ།",
    "ཡང་གདོང་ཚུགས་སུ་བལྟ་སྟེ་འདུག་གོ།",
    "གང་རང་བཞིན་གྱིས་མཉམ་པར་བཞག་པ་དང་།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "འཁྲུལ་པ་ཡང་རང་རིག་པའི་མཐར་ཐུག་པ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་གཞན་གྱིས་རྟོགས་པ་ལ་སྤྱོར་བ་མ་ཡིན་པའི་ཕྱིར་ལ་དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་ཉིད་ནི་རྣམ་པར་རྟོག་པར་མི་རིགས་སོ།",
    "སྔོན་པོ་ལ་སོགས་པ་ཡང་ངོ་ཞེས་སྔོན་པོ་ལ་སོགས་པར་གསལ་བར་བྱེད་པ་ཉིད་ཀྱང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱིས་རྣམ་པར་ཤེས་པའི་ཐ་སྙད་ཙམ་སྒྲུབ་པར་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
