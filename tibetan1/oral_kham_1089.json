    "ངུ་སྐད་དེ་སྔར་བཞིན་ཁོའི་རྣ་ལམ་དུ་མཚམས་མི་ཆད་པར་གྲག་འདུག་རྨི་ལམ་ཁྲོད་ཀྱི་ཆུང་མ་དང་བྱིས་པ་གཉིས་ཀྱི་གཟུགས་བརྙན་ཁོའི་མིག་ལམ་དུ་གསལ་ལེར་སྣང་བས།",
    "གངས་ནི་ད་དུང་གར་སྟེགས་ལ་ཅེར་འདུག་པས།",
    "ཕྱི་རོལ་ཏུ་དངོས་གནས་ཁ་བ་འབབ་བཞིན་འདུག་འདི་ནི་དགུན་ཟླ་འདིའི་ཁ་བ་འབབ་ཐེངས་དང་པོ་ཡིན་ལ།",
    "ཁོའི་ཆུང་མས་ཚལ་རིགས་སྣ་ག་ལྔ་དྲུག་ཅིག་བསྔོས་ཏེ་ངེད་གཉིས་ལ་སྒུག་འདུག་ངེད་གཉིས་བསླེབས་འཕྲལ།",
    "བྲག་ཁུང་དུ་སྔར་བཞིན་ལྷིང་འཇགས་སེ་འདུག་པ་ལས་གྲག་འགུལ་ཅི་ཡང་མ་བྱུང་།",
    "ཨ་ཙི།",
    "ཁོ་ཅུང་ལྷོད་ལ་བབས་ཤིང་མིག་ཟུང་དུ་རབ་རིབ་ཀྱི་མདངས་ཤིག་འཚེར་བཞིན་གདའ།",
    "ཡིན་ནའང་གནམ་ངོ་རུབ་འདུག་སྟེ།",
    "ཁོ་ལ་རྒྱུ་འབྱོར་བ་ལྡན་ཚུལ་སོགས་གང་མང་ལབ་ཀྱིན་འདུག་ཉིན་གཉིས་གསུམ་ཙམ་གྱི་རྗེས་སུ་ཁོ་གཉིས་འདྲིས་ཤིང་མཐུན་ནས་སྐྱུགས་བྲོ་བའི་ཉམས་འགྱུར་སྣ་ཚོགས་སྟོན་བཞིན་པ་མཐོང་བས།",
    "ང་མི་རྐྱང་ལ་འདུག་རྒྱུ་ཡིན་ཅེས་བཤད།",
    "སྐད་ཆ་དེ་དག་ཐོས་དུས་ངའི་སེམས་ལའང་རང་ཤུགས་ཀྱིས་དྲོད་འཁོལ་གྱི་ཚོར་བ་ཞིག་ཁྱབ་ཡོང་ལ།",
    "དུས་རྒྱུན་ངེད་གཉིས་ལ་ཟུར་གྱིས་ད་བྱིས་པ་ཞིག་དགོས་རན་འདུག་ཅེས་ཡང་དང་བསྐྱར་དུ་བཤད།",
    "འཆུགས་མི་ཤོག་ལྷེ་གཅིག་འདུག་ལི་ཐོ་དེའི་ངོས་སུ་ལོའི་ཟླ་པའི་ཚེས་ཞེས་གསལ་བོར་བཀོད་ཡོད།",
    "མི་ཞིག་ཁོའི་གན་དུ་ཡོང་ནས་ཁོ་ལ་ཅེར་འདུག་ཁོས་མི་དེའི་བརྩེ་འདང་བྲལ་པའི་ངོ་ལ་ལྟ་བཞིན་ཁོག་འདར་ཞིག་བརྒྱབ།",
    "དེ་ལས་ལྡོག་སྟེ་ངས་དེ་ཡག་པོ་འདུག་སྙམ།",
    "ཉི་ཟེར་གྱི་ཉག་མ་འགའ་ཤེལ་སྒོ་བརྒྱུད་དེ་ཐད་ཀར་རྩིག་ངོས་ཀྱི་ལི་ཐོའི་སྟེང་ལ་འཕྲོས་འདུག་ཁོའི་མིག་མདངས་ཀྱང་རྩིག་ངོས་ཀྱི་ལི་ཐོའི་སྟེང་ལ་གཏད།",
    "ཆུང་དུས་ནས་བཟུང་མི་རྣམས་ཀྱིས་འདི་ལྟར་འབོད་བཞིན་འདུག་ཟེར།",
    "ཉིན་རྒྱུན་ཁ་མི་གྲག་པར་རང་ཉིད་གཅིག་པུར་འདུག་པ་དང་།",
    "ལོ་ངོ་བརྒྱད་ཀྱི་དུས་ཡུན་གྱིས་མི་ཆ་ཡོད་ཅིག་མི་ཆ་མེད་ཅིག་ཏུ་བསྒྱུར་འདུག།",
    "འདི་འདྲའི་དོན་དག་གལ་ཆེན་ཞིག་ཀྱང་བརྗེད་འདུག་ཅེས་ཁེར་ལབ་བརྒྱབ།",
    "ད་དུང་ཁོ་ལ་རྩ་ཞིག་ཚང་མི་འདུག་ཅེས་འདོད་པར་འགྱོད་པ་སྐྱེས།",
    "ཁྱིམ་དུ་འགྲོ་ལ་འདུག་ཅེས་བཤད།",
    "གསར་རྒོད་དེ་ཡང་གཏོལ་མེད་དུ་འདུག་པ་ལས་སྐད་ཆ་ཅི་ཡང་མ་བཤད།",
    "ད་ལྟ་གཞུང་ལམ་ལེགས་པོ་བསྐྲུན་འདུག་པས་ཧ་ཅང་སྟབས་བདེ་རུ་གྱུར་ཡོད།",
    "དྭངས་ཤིང་གསལ་བའི་དགོད་སྒྲ་དེ་ཟླ་འོད་ཀྱི་འོག་ཏུ་འཕུར་སྐྱོད་བྱེད་བཞིན་འདུག་ཁོ་ཡང་དགོད་ཞོར་དུ་འདི་ལྟར་དྲིས།",
    "ཕྱོགས་བཞིའི་རི་ཀླུང་དག་རབ་རིབ་ཏུ་གྱུར་འདུག་འགྲུལ་སྐྱེལ་རླངས་འཁོར་རྙིང་བ་དེས་ང་བསྐྱུར་ནས་བྱ་འཕུར་བ་ལྟར་མདུན་ཕྱོགས་སུ་བསྐྱོད།",
    "མིག་སྔར་ངའི་གསར་རྩོམ་གྱི་ཕྱོགས་ན་དཀའ་ཁག་ཆེན་པོ་འདུག་པས།",
    "འཛུམ་བཞིན་ང་ལ་ཅེར་འདུག་ངས་ཁོ་ལ་བཀའ་དྲིན་ཆེ་ཞུས་རྗེས།",
    "ཨ་ཞང་ཆུང་བ་ནི་མི་ཧ་ཅང་སེམས་ཆུང་ཞིག་ཡིན་ལ།",
    "ཨ་ཞང་ཆུང་བས་བློ་ལྡན་གྱི་སྐད་ཆ་ཐོས་རྗེས།",
    "ཨ་ཞང་ཆེ་བ་ནི་ནམ་རྒྱུན་མི་སྤྲོ་སྣང་ཅན་ཞིག་ཡིན་ལ།",
    "བློ་ལྡན་ལ་ཤ་ཉེ་ནི་ཨ་ཞང་འདི་གཉིས་ལས་མེད།",
    "ང་ལ་མཚོན་ན་ངོ་མས་རིན་ཐང་ཆེན་པོ་འདུག་ཟ་མ་ཟོས་རྗེས།",
    "ཕྱོགས་བཞི་ལྷིང་འཇགས་ཀྱི་ངང་འདུག་ལ།",
    "འདི་དག་ཐམས་ཅད་ཁྱེད་རང་ལན་པ་ཡིན།",
    "བློ་ལྡན་ནི་ཁོ་རང་ཉིད་ཡིན་པ་དང་འདྲ།",
    "ཁོ་གཉིས་ཀྱིས་ཀྱང་སྔོན་ཆད་ཐེངས་མང་བོར་བལྟས་མྱོང་བའི་ཡིག་ཕྲེང་དེ་དག་ལ་ཞིབ་ཏུ་བལྟས་འདུག་བལྟས་ཚར་རྗེས།",
    "ཡ་མཚན་པའི་མིག་མདངས་ཀྱིས་སེམས་དཔའ་ལ་ཅེར་ནས་ལྡབ་ལྡིབ་ཀྱིས་ཅི་ཞིག་ལབ་བཞིན་འདུག་སྒྲོལ་མ་ཡང་ཧོར་གྱིས་ཡར་ལངས་ཏེ་དབྱིན་སྐད་ཀྱིས་དེ་དག་ལ་ཚིག་འགའ་ལབ་པས།",
    "སྔར་བཞིན་ཅི་འདོད་གང་བྱུང་དུ་ལབ་ཞོར་ཕྱི་གླིང་པ་དེ་དག་གྲུ་གཟིངས་སྟེང་ལ་འདུག་ཏུ་བཅུག་སྟེ།",
    "ལམ་ཐག་རིང་བས་སུན་སྣང་སྐྱེས་འདུག་གམ།",
    "མི་རིགས་འདི་ཚར་འདུག་ཟེར།",
    "ཞོགས་པའི་ཁྲོད་དུ་ཆར་བ་ཟམ་ཟིམ་འབབ་ཀྱིན་འདུག་ན་ནིང་།",
    "བཟོ་དབྱིབས་འདྲ་ཡང་ཆེ་ཆུང་མི་སྙོམས་པའི་ས་ཕུང་ཁ་ཤས་གཡས་ཉལ་གཡོན་ལོག་བྱས་འདུག་མི་ལོ་སྟོང་ཕྲག་སྔོན་གྱི་མིང་ལ་བཙན་པོ་ཟེར་བ་ཁ་ཤས།",
    "ད་ལྟའང་ས་ནག་ཁྲོད་ན་ཉལ་འདུག་ཟེར།",
    "ཁོ་ཚོའི་རྗེས་སུ་དུ་བ་སྔོ་ལྷོག་ལྷོག་འཕྱུར་བཞིན་འདུག་སྐབས་དེར།",
    "ངོ་ལ་ཐང་ཆད་པའི་ཉམས་ཤིག་ཤར་འདུག་ཕྱི་དྲོའི་ཉི་འོད་འཕྲེད་དུ་ཁོ་ཚོའི་ངོ་ལ་འཕྲོས་ནས་ཡོད།",
    "དྲག་ཆར་ད་དུང་འབབ་ཀྱིན་འདུག་སྐབས་དེར།",
    "ཁོ་འགུལ་ཙམ་ཡང་མི་བྱེད་པར་རྒྱང་རིང་ཞིག་ལ་ཅེར་འདུག་ལག་སྐྱོར་འདྲུད་འཐེན་འཁོར་ལོ་ཞིག་ཤེས་མེད་ཚོར་མེད་དུ་ཁོ་ཚོའི་གན་དུ་བསླེབས།",
    "དགུན་དུས་ཀྱི་ནམ་ཟླ་ཧ་ཅང་འཁྱག་སྡོང་རྒན་གྱི་ཡལ་ཀ་རྣམས་ཕྱོགས་དང་མཚམས་སུ་བརྐྱངས་འདུག་པས།",
    "ཁོ་ཚོས་སྐེ་བསྲིངས་ཏེ་ཕར་ངོགས་སུ་བལྟས་འདུག།",
    "ཅི་ཞིག་ལ་སྒུག་པ་ལས་ཐབས་སྡུག་པའི་བྱ་བ་ཞིག་མི་འདུག་ད་ལྟ་ང་ཤི་ཡང་ཆོག་སྟེ།",
    "གྲོགས་པོ་གཞན་རྣམས་ཀྱིས་ཁ་རོག་གེར་ཉན་འདུག་སྙན་ངག་གྱེར་འདོན་བྱས་ཚར་དུས་ཀྱང་མེ་ཏོག་སྐྱིད་ཀྱི་སྐད་ཆུང་ངུའི་ངུ་སྒྲ་ལས་གྲ་རྒྱུ་ཅི་ཡང་མི་འདུག་དུས་ཚོད་ནི་དགུན་དཀྱིལ་བསླུ་བྲིད།",
    "དེ་ནི་ཁོ་རང་ཉིད་ཀྱང་ཡིད་ཚིམས་པའི་འདྲ་པར་ཞིག་ཡིན་པས།",
    "པར་ལེན་ཁང་དུ་ཡང་བསྐྱར་ཇེ་ཆེར་བཏང་ནས་ད་བར་ཉར་ཚགས་བྱས་འདུག་སྙན་དེབ་དེ་ནི་ཁོས་མི་ཚེ་འདིར་པར་སྐྲུན་བྱས་པའི་སྙན་དེབ་ཐོག་མ་ཡིན་ལ་མཐའ་མའང་ཡིན།",
    "དེ་རུ་དུད་ཁྱིམ་བརྒྱ་ལྷག་ཡོད་ལ་མི་གྲངས་དྲུག་བརྒྱ་ཙམ་འདུག་པས།",
    "ཟླ་འོད་ཁྲོད་ཀྱི་དུར་ཐང་ནི་ལྷིང་འཇགས་སེར་འདུག་སྟེ།",
    "སྙན་ངག་བྲིས་རྗེས་ཁོའི་བཟི་ཡང་ཡོངས་སུ་དྭངས་འདུག་དེ་བས་ཁོས་ལྕགས་སྨྱུག་ཤུགས་ཀྱིས་དུར་ཁྲོད་དུ་གཡུགས་ཤིང་ཚི་ལེན་གོན་འཕྲལ་ཅི་ཞིག་ལ་བསམ་བློ་གཏོང་བ་ལྟར་བསྡད།",
    "དེར་ཁག་མི་འདུག་འུ་གཉིས་ངོ་ཤེས་ནས་ཅང་འགོར་མེད།",
    "སློབ་གླིང་སྙན་ངག་པའི་མིང་ཡང་རང་ཤུགས་སུ་ཐོགས།",
    "ཟ་ཁང་དུ་ཁོ་གཅིག་པུ་མ་གཏོགས་མི་གཅིག་ཀྱང་མི་འདུག་སྐབས་དེར།",
    "ཁོས་ང་གན་ལ་འདུག་ཏུ་བཅུག་འཕྲལ་ཆང་དཀར་ནང་ལ་ཆང་གང་བླུགས་ཏེ་དྲངས་བྱུང་ལ།",
    "ངའི་སེམས་ཁོང་དུ་དྲོད་ཁོལ་གྱིས་ཁེངས་འདུག་ངས་ཁོའི་རྣམ་འགྱུར་དང་སྐད་ཆ་དེའི་ནང་དོན་མ་རྟོགས་པར།",
    "མཚོ་སྔོན་པོའི་ཁ་རུ་བསླེབས་འཕྲལ་སྙན་ངག་པར་སྤྲོ་བ་ཆེན་པོ་རྒྱས་འདུག་ཁོས་ད་བར་མཚོ་ཞིག་མཐོང་མ་མྱོང་བས།",
    "སེམས་སྨྲེང་ནས་སྐད་ཀྱང་འདའ་འདར་བྱེད་ཀྱིན་གདའ།",
    "ངེད་གཉིས་ཀྱིས་རང་རང་ས་ནས་དུ་བ་འཐེན་པ་ལས་སུས་ཀྱང་ཁ་མ་གྲག་བསླུ་བྲིད།",
    "ཁོ་གཞི་ནས་ར་རོ་བར་གྱུར་འདུག་སྐབས་དེ་ནི་དགུན་ཁ་ཡིན་ལ།",
    "ཟ་ཁང་དུ་དྲོད་ལམ་ལམ་གྱི་སྐྱིད་སྣང་ཞིག་འདུག་སྙན་ངག་པ་དུར་ཁྲོད་རྗེས་སུ་དྲན་པ།",
    "ཁོའི་ངོ་ལ་སྡུག་བསྔལ་གྱི་རྣམ་པས་ཁེངས་འདུག་སྟེ།",
    "དུ་སྙན་ངག་པ་དེ་ལ་ཁག་མི་འདུག་དོན་རྐྱེན་དེ་འདྲ་ཞིག་བྱུང་བ་གཙོ་བོ་བདེ་སྐྱིད་དང་ཅུས་ཀྲང་གཉིས་ལན་འདུག་ཟེར་མཁན་ཡང་མང་བོ་འདུག་ང་དང་ང་ལྟ་བུའི་སྙན་ངག་པའི་གྲོགས་པོ་འགས་ཇི་ལྟར་བསམ་བློ་བཏང་ཡང་།",
    "ཡིན་ནའང་སྙན་ངག་པས་ཆུང་མའི་གནས་སྤོར་མ་ཐུབ་པས་ཁོ་གཉིས་རང་རང་ས་རུ་འདུག་དགོས་བྱུང་།",
    "འོན་ཀྱང་ཡོད་ཚད་འཕྱིས་འདུག་དེ་ནི་ངོ་མ་ནོར་བུ་རང་ལ་ཡོད་དུས།",
    "མེ་ཏོག་སྐྱིད་ཀྱང་སྐྱེལ་མར་ཡོང་བའི་ཡི་ཚོགས་ཀྱི་གྲས་སུ་འདུག་ལམ་ལ་ཆས་ཁར།",
    "རིམ་གྱིས་རིམ་གྱིས་ང་རང་ཉིད་ལ་དོགས་པ་སྐྱེས་བྱུང་ཟླ་པའི་ཚེས་ཉིན།",
    "ངའི་སེམས་ལ་བྱིས་པར་ཉེས་པ་ཅི་ཡང་མི་འདུག་སེམས་ཞོར་དབུགས་སྣུམ་མར་བསླུ་བྲིད།",
    "ང་རང་བདེ་སྤྱོད་བཟང་བོ་ཡིན།",
    "འདུག་ཅིང་།",
    "བུ་དེས་ནམ་ཉི་མ་ཞིག་ལ་ཁྱིམ་ཚང་སྟོང་བར་ཕུད་དེ་ཁོ་རང་ཉིད་ཀྱང་བརླག་ངེས།",
    "སྔར་ལྟར་ཤོ་རྒྱག་དུས་ཕམ་ཁ་ཉོ་ཚུལ་ལྷག་ཏུ་ཇེ་སྡུག་ལ་འགྲོ།",
    "ཁོས་འདང་རྒྱག་ཅི་ཡང་མི་བྱེད་པར་ཕ་མེས་ཡང་མེས་ཀྱིས་ཤུལ་དུ་བཞག་འདུག་པའི་གཞིས་ཁྱིམ་ཡང་གཞན་ལ་བཙོང་།",
    "མདུན་ཕྱོགས་ཀྱི་གླ་བ་དེ་དག་རང་རང་སར་བྲོས་ཤིང་མིང་མེད་ཐང་ལ་འགྱེལ་འགྲོ།",
    "འུ་སྤུན་ཟླ་གཉིས་ཀྱང་རང་རང་ས་རུ་འདུག་ག་ལ་དགོས་སྐབས་དེར།",
    "ལོ་མང་བོ་འགོར་པས་མེ་མདའི་སྟེང་ལ་འོད་མདངས་ཅི་ཡང་མི་འདུག་ཁོས་མདེའུ་ལྷག་མ་གཉིས་མེ་མདའི་ནང་ལ་དེད་དུས་མེ་མདའི་སྦུག་ཁོག་ནས་ཙག་སྒྲ་ཞིག་གྲགས།",
    "སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱི་ཞལ་གདམས་དང་རང་ཉིད་ཀྱི་སྡུག་མྱངས་པ་ཐམས་ཅད་ཡོངས་སུ་བརྗེད་དེ་མེ་མདའ་ཞེས་པ་ནི་དངོས་གནས་ཅི་ཞིག་ཡིན་ནམ་ཞེས་དྲིས་བྱུང་།",
    "དེའི་སྒོ་ཡང་རང་བྱེ་བ་དང་།",
    "འདི་སུ་དང་ཕྲད་པ་ལསྦྱིན་ནོ་སྙམ་ཙ་ན།",
    "དེ་ནས་སློབ་དཔོན་ཁྱིམ་གྱི་ནང་དུ་བྱོན་ཙ་ན།",
    "ཉི་མ་ནུབ་ལ་ཁད་ཙ་ན་སྔར་གྱི་ས་དེ་ཀར་འཁོར།",
    "གསེར་གྱི་ཁྲི་ལ་འདུག་པ་ཅིག་ཏུ་གྱུར་ནས།",
    "མིག་ཤེལ་མིག་ཏུ་འདུག་པ།",
    "གོས་ཧྲུལ་བ་ཞིག་འདུག་གོ།",
    "འདི་འདྲ་གདའ་ཞེས་སློབ་དཔོན་ལ་ཕུལ་བས།",
    "དེ་ནས་གཞན་ཐམས་ཅད་ཀྱང་ཅི་འདོད་འོང་བར་འདུག་ནས།",
    "སློབ་དཔོན་གྱི་དྲུང་ན་འདུག་ཅིང་གཡོག་བྱེད་དོ།",
    "དེར་ལན་ཅིག་མི་མང་པོ་ཞིག་དུས་གཅིག་ཏུ་བཟུང་ནས་དུས་སྟོན་ལ་ཟ་བར་བྱེད་འདོད་པ་ལ།",
    "སློབ་དཔོན་གྱིས་ལྟ་སྟངས་མཛད་པས་སླར་འབྱོར་ཏེ་འདུག་གོ།",
    "དེ་ན་གང་ཡང་མེད་པར་གློ་གཡས་གཡོན་ནམ་རྒྱབ་ཀྱི་ཕྱོགས་སུ་སློབ་དཔོན་འདུག་པར་མཐོང་ངོ།",
    "སློབ་དཔོན་བཞུགས་པའི་ཕྱོགས་དེར་འདུས་ཤིང་སྒྲ་དེ་ཉན་ཅིང་འདུག་གོ།",
    "དེ་བཞིན་དུ་རི་དྭགས་དང་བྱ་སྣ་ཚོགས་དང་གཅན་གཟན་སྣ་ཚོགས་པ་དག་ཀྱང་དེ་ཉན་པའི་ཕྱིར་འདུས་ཤིང་འདུག་གོ།",
    "དེང་སང་ནི་ཙནྡྲ་ཀུ་མ་ར་ཟེར་གྱིན་འདུག་གོ།",
    "སྔར་གྱི་ཤུལ་ན་སྔ་མ་བཞིན་འདུག་སྟེ།",
    "མ་བུ་གཉིས་ལས་གཞན་མི་འདུག་གོ།",
    "སྔར་གྱི་ཤུལ་མ་བུ་གཉིས་འདུག་གོ།",
    "ཁྱེད་ཀྱིས་འདི་ལྟ་བུ་བཞེངས་འདུག་པ་དེ་ཡུལ་གཞན་ཞིག་ཏུ་བརྫངས་ན་ལགས།",
    "འདི་ལྟར་བྱེད་དགོས་བྱུང་བས་སློབ་དཔོན་གྱིས་ནུས་པ་བསྟན་པར་ཞུ་བྱས་ཙ་ན།",
    "དེར་བྲིས་སྐུ་སྔ་མ་དཔལ་ཧེ་རུ་ཀ་ནི་སྔར་བས་ཀྱང་ཆེས་གཟི་བརྗིད་འབར་བར་འདུག་རྒྱལ་པོས་བཞེངས་པའི་བྲིས་སྐུ་དེ་ཡང་སྔ་མ་ལས་རང་འགྱུར་ནས།",
    "ཕྱིན་ཆད་གཞན་དུ་མི་འགྲོ་བར་འདིར་འདུག་གོ་གསུང་ངོ།",
    "དེ་ལ་དེས་འཁོན་དུ་བལྟས་ནས་འདུག་གོ།",
    "གདུག་པའི་མཁའ་འགྲོ་མ་དེ་གཏུན་ཤིང་ཐོགས་ནས་འབྲས་བརྡུང་ཞིང་འདུག་གོ།",
    "ཆུང་བ་མཛད་པའང་ཅི་རིགས་པ་ཡོད་བ་དེར་གདའ།",
    "ཚིག་བཅད་རྟིང་མ་འདི་རྒྱ་གར་བའི་ངག་སྒྲོས་ཅིག་ཡིན་པར་འདུག་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པར་བྱེད་པའི་ཚིག་སྔ་མ་དྲུག་པོ་རྣམས་བོད་ཚིག་ཏུ་གསལ།",
    "དེ་སད་ཙ་ན་རྐང་མགྱོགས་ཀྱི་དངོས་གྲུབ་ཐོབ་སྐད།",
    "སྐྱེ་བ་སྔ་མ་ཡོད་དེ་རྒྱལ་པོ་ཁྱེད་རང་སྐྱེ་བ་སྔ་མ་ཞིག་གདོལ་པར་སྐྱེས་པའི་དུས།",
    "རབས་ཆད་པས་གསེར་ཡོད་པ་རྣམས་རི་འདིའི་མཚན་རྟགས་འདི་ལྟ་བུར་སྦས་འདུག་པ།",
    "ཆུ་གྲི་ལ་སོགས་པའི་མཚོན་ཆ་སྣ་ཚོགས་བསྣུན་ཙ་ན་རྡོ་ངར་མ་དང་ཐུག་པ་བཞིན་དུ་མེ་སྟག་ཁྲོམ་ཁྲོམ་པ་བྱུང་།",
    "སྒོ་བསྡམས་ཏེ་སུ་ཡང་མི་གཏོང་བར་འདུག་པ་ལ།",
    "གདམས་པ་དང་རྗེས་སུ་གདམས་པས་སྐྱོང་བཞིན་དུ་ལོ་བདུན་གྱི་བར་དུ་འདུག་གོ།",
    "འཇའ་ཚོན་ཐམས་ཅད་ཚོགས་པ་ཅིག་འདུག་ནས།",
    "ཕྱིས་ཆ་བྱེད་རྣལ་འབྱོར་པ་ཀ་ཡིན་པར་འདུག་ཚིམ་བུའི་གོ་བ་ནི་ཕྱགས་དར་ཁྲོད་གྱོན་པའི་མིང་ཡིན།",
    "གོ་རཀྵའི་རྗེས་འབྲང་རྣལ་འབྱོར་པ་ཕལ་པ་མང་པོ་ལམ་ན་འདུག་པ་རྣམས་ཀྱིས་ཅོ་འདྲི་ཞིང་།",
    "འདི་འདྲ་མང་དག་བྱུང་བར་གདའ་འོ།",
    "འདི་དག་དང་ཉེ་བར་ཡང་མི་ནུས་སྙམ་ཙ་ན།",
    "རྐང་མགྱོགས་ལ་སོགས་པའི་ཆོ་འཕྲུལ་རྣམས་ཀྱང་རང་ཤུགས་ལ་ཐོབ་པོ།",
    "དེར་ཚོགས་ཀྱི་ཁང་པར་ཞུགས་ཙ་ན།",
    "ཕུག་པ་དེ་ཡང་ཤིན་ཏུ་ཆེ་བར་འདུག་ཅིང་།",
    "ཟས་ནོར་སྣ་ཚོགས་པའི་དབུས་ན་རྣལ་འབྱོར་པ་དེ་འདུག་པར་མཐོང་ངོ།",
    "སྔར་མ་ཐོས་པའི་བསྟན་བཅོས་ཐམས་ཅད་ཀྱང་རང་ཤེས་ནས།",
    "ལན་ཅིག་རྒྱལ་པོའི་དྲུང་དུ་ཕྱོགས་ཀྱི་རྒྱལ་པོ་མང་པོའི་འཕྲིན་ཡིག་དུས་གཅིག་ཏུ་འཛོམ།",
    "དེ་ནས་ཁོང་རང་ཚིམས་ཚུལ་མཛད་ནས་སེ་གོལ་གཏོགས་པ་ན།",
    "རི་ཀོ་པ་ལྷོ་ན་མན་ཙ་ནུབ་ན་གཉན་ཡོད།",
    "གང་ལས་བལྟམས་པའི་ཡུམ་ནི་གཡོ་སྒྱུ་ཆུང་ཞིང་རང་བཞིན་བཟང་བ།",
    "ང་རང་ལ་ཅིའང་མི་སྐྱོན།",
    "གནང་ཉིན་ཚེས་པ་བཅུ་གཉིས་ལ་ང་རང་འགྲོ་བའི་དུས་ཚོད་ཅིག་ཡིན།",
    "ཐོས་རྒྱ་ཆེ་ཞིང་རང་རྒྱུད་གྲོལ",
    "རྡོ་རྗེའི་སྐུ་ལ་བགྲེས་རྒུད་བྲལགཤེགས་བཞུད་མཚན་མ་ག་ལ་གདའདེ་དོན་རྟོགས་ན་པད་འབྱུང་མ་བཞུད་རིག་པའི་ངོ་བོར་གདལ་སྐྱེ་མེད་ནམ་མཁའ་ཡངས་པའི་ཀློངརྟོག་ཚོགས་སྤྲིན་ལས་རབ་གྲོལ་བའི",
    "ཞེས་པའང་རང་ལོ་བཅུ་དགུ་ཆུ་ཡོས་ལོར།",
    "བཙལ་ནས་བསྐལ་བའི་བར་དུ་རྙེད་མི་སྲིདམ་བཙལ་རང་སར་ཞོག་དང་རང་ཞལ་མཇལ་དེང་སང་བླུན་པོ་ཟོལ་མའི་སྟོན་པ་ཚོསགཟུང་འཛིན་སེམས་ཀྱི་སྤྲོས་པའི་གཏད་སོ་ཅན",
    "རྐྱེན་དང་ན་ཚར་མ་བལྟ་རིག་པའི་ངང་། རང་སར་ཞོག་དང་རང་སར་གྲོལ་བར་འགྱུར།",
    "སྡང་ཡང་འཁྲུལ་བའི་ལན་གྲངས་བག་ཆགས་དེ་བསོགས་འདུག།",
    "དེ་རིང་དགའ་ཡང་སང་ཉིན་མི་དགའ་རུ་གྱུར་འདུག།",
    "ལྐོག་ཏུ་བླ་བཙག་ངན་སྨྲས་སྣ་ཚོགས་ཀྱང་བྱེད་འདུག།",
    "ཕྱི་རྐྱེན་དགྲ་འདྲེའི་འཚུབ་ཆའི་ཆུ་རླབས་ཀྱང་གཡོ་འདུག།",
    "འཁོར་འདས་སྟོངས་སྲོག་དུས་གཅིག་འཕྲོག་པ་ཡི་ཐབས་ཟབ།",
    "བྱུང་རྒྱལ་བག་ཡངས་ཉམས་དགར་ལྷོད་ལྷོད་དུ་འདུག་ན།",
    "ད་ནི་བསྟོད་སྨད་ཚིག་ལ་ཉན་ཚོད་ནི་མི་འདུག།",
    "གཞན་ནས་མ་བཙལ་ཡེ་ནས་རང་ཆས་སུ་རྫོགས་འདུག།",
    "འདི་བདེ་ཕྱི་སྐྱིད་གཏན་གྱི་བདེ་བའི་སར་སླེབས་འདུག།",
    "ཚོགས་དྲུག་གང་སྣང་རང་གྲོལ་བདེ་ཆེན་ངང་།",
    "འཛིན་མེད་ལྷུག་པར་ཞོག་དང་རང་ཞལ་མཇལ།",
    "ཀུན་ཁྱབ་སྟོང་ཆེན་གཞི་ལ་འཕོ་འགྱུར་ནི་མི་འདུག།",
    "རང་གྲོལ་རིག་པའི་རྡོ་རྗེར་བགྲེས་རྒུད་ནི་མི་གདའ།",
    "མ་བཅོས་མ་སྤང་རང་བབ་རྩོལ་བྲལ་གྱི་རིག་པ།",
    "ཤོམ་ར་མང་པོའི་ལོང་ཁོམ་མི་གདའ་བས།",
    "སྔར་མེད་གསར་དུ་གཞན་ནས་བཙལ་རྒྱུ་ཞིག་མི་གདའ།",
    "བསྒུལ་མེད་བློ་སྣ་མ་མང་རང་ཚུགས་ཟུངས།",
    "རྟོག་ཚོགས་གང་ཤར་རྗེས་མཐུད་སྤང་བླང་རང་མ་བྱེད།",
    "སྣང་ཡང་རང་བཞིན་གྲུབ་པ་རྡུལ་ཙམ་མེད།",
    "འདུག་ན་མ་བཅོས་རིག་པའི་ངང་དུ་སྡོད།",
    "ལོགས་ན་མེད་དེ་རང་བྱུང་རང་རིག་སྐུ།",
    "རྣམ་རྟོག་རྗེས་འདེད་བྱེད་པའི་སྒོམ་རྒྱུ་ཞིག་མི་གདའ།",
    "ནམ་སྤྲུལ་སྨྱོན་པ་གུ་ཡངས་བློ་བདེ་ང་རང་ལ།",
    "གདོད་ནས་མ་གྲུབ་སྒྱུ་མའི་མིག་འཕྲུལ་བཞིན་འདུག་པས།",
    "བྱ་བ་མང་པོའི་ཁོམ་ལོང་མི་གདའ་ཞིང་།",
    "ཐོས་པའི་མཐའ་རྒྱ་ཆོད་པ་དཀའ་ཙམ་འདུག།",
    "གདོད་ནས་དཀྱིལ་འཁོར་གསུམ་གྱི་ངང་དུ་རང་རྫོགས་འདུག།",
    "གང་ཤར་ཡེ་ཤེས་ཆེན་པོའི་རང་བཞིན་དུ་འདུག་ཅིང་།",
    "འཁྲུལ་མེད་གདོད་མའི་གཞི་ལ་རང་གྲོལ་དུ་འདུག་གོ་གར་ཤར་ཡེ་ཤེས་ཆེན་པོའི་རོལ་བ་ལས་མི་འདུག།",
    "སྣང་སྲིད་ཡེ་ཤེས་ཕུར་བའི་དཀྱིར་འཁོར་དུ་ཤར་འདུག།",
    "འཇིག་རྟེན་བྱ་བ་ཀུན་ལ་ཟིན་དུས་ནི་མི་འདུག།",
    "འདི་ལས་ལྷག་པའི་ལྟ་བ་མཐར་ཐུག་ཅིག་མི་འདུག།",
    "རྩོལ་མེད་རང་སར་ཞོག་དང་རང་ངོ་དེ་མཇལ་འོང་།",
    "རྟོགས་བྱའི་མཐར་ཐུག་དེ་ལས་མེད་ཚོད་རང་འདུག་སྙམ།",
    "རྟོག་གེས་འཁོན་ནས་བཅོས་མས་བཙལ་ཀྱང་རང་རྙེད་དཀའ།",
    "ཤེས་པར་གྱིས་ལ་བདེན་མེད་རྩལ་སྦྱོང་རང་མཛོད་ཅིག།",
    "འོན་ཀྱང་སྨྱོན་པའི་གཏམ་ལ་བདེན་བཟུང་རང་མེད་ན།",
    "སྣང་དང་མུན་པའི་གོ་སྐབས་ཡེ་ནས་རང་མི་གདའ།",
    "འགྲམ་ནས་གཅར་ཀྱང་མ་དགོས་རང་རྩལ་དུ་རྫོགས་འདུག།",
    "ཕུང་ཁྲོལ་བྱེད་པོ་གཞན་ན་མི་འདུག་པས།",
    "ཆུ་བོའི་གཉེར་མར་ཟད་མཐའ་མི་འདུག་ཅིང་།",
    "ཤོམ་ར་མང་པོ་བྱེད་ལོང་མི་གདའ་བས།",
    "བདེ་ཡང་སེམས་ཏེ་སྡུག་ཀྱང་རང་སེམས་ཉིད།",
    "ན་ཞེས་རིག་པའི་རང་རྩལ་གདའ།",
    "དོན་ལ་རང་སྣང་ཉིད་ལས་མི་གཞན་པར་འདུག་པས།",
    "རང་ས་ཟུངས་དང་རང་གྲོལ་གྱི་གདེང་རྙེད།",
    "རང་སར་ཡལ་བའི་ངང་ལ་ང་རང་གནས།",
    "གཏད་མེད་གུ་ཡངས་ངང་དུ་ང་རང་གནས།",
    "ཀུན་ཁྱབ་ཡེ་ཤེས་ཆེན་པོའི་དབྱིངས་ཀློང་དུ་། ཀུན་བཟང་ཐེག་མཆོག་རྡོ་རྗེ་ང་རང་གནས།",
    "དྲན་མ་ཐག་ཏུ་ང་ཉིད་དེ་ན་གདའ།",
    "མང་པོའི་བྱ་བའི་ཤོམ་ར་སྒྲིག་ལོང་ཞིག་མི་གདའ།",
    "གཉུག་མའི་རྣལ་འབྱོར་སྐྱིད་པོའི་མལ་སླེབས་འདུག།",
    "ངོ་བོ་སྟོང་ཞིང་རང་བཞིན་ཡེ་ནས་གསལ།",
    "གང་སྣང་ཡེ་ཤེས་འཁོར་ལོར་གདའ།",
    "དྲན་མ་ཐག་ཏུ་ང་ཉིད་དེ་ན་གདའ།",
    "དེ་ལྟར་ཟ་ཉལ་འགྲོ་འདུག་སྤྱོད་ལམ་ཀུན།",
    "འཇིགས་དང་དོགས་པ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་བཅིངས་འདུག།",
    "བཟང་ངན་འདྲེར་འཛིན་རྣམ་རྟོག་འཛིན་ཡུལ་ཞིག་མི་འདུག།",
    "ལྷ་དང་འདྲེ་ཞེས་བཟང་ངན་རྟོག་པ་ནི་མི་གདའ།",
    "རང་བྱུང་རང་བཞག་སེམས་ཀྱི་འཛིན་རྩོལ་དང་བྲལ་བར།",
    "འདི་ཞེས་དངོས་མཚན་ཅན་གྱི་སྒོམ་རྒྱུ་ཞིག་མི་གདའ།",
    "གསལ་ལ་འཛིན་མེད་ཡེ་ནས་རང་གཤིས་སུ་འདུག་པས།",
    "ཡེ་སྟོང་རང་བབ་ངང་དུ་ཆམ་མེ་རང་ཞོག་ཐོངས།",
    "ཡིད་འཛིན་རིན་ཆེན་གའུའི་སྣོད་བཟང་དུ་བསྐྱིལ་འདུག།",
    "ཀུན་བཟང་གདོད་མའི་ས་ལ་ཐག་རིང་ནི་མི་འདུག།",
    "ང་ཅག་ཇི་ལྟར་བྱས་ཀྱང་བདེ་དགའི་ངང་གནས་འདུག།",
    "རང་རང་ལས་ཀྱིས་ཉེ་བར་བཀོད་པ་ཡིན།",
    "བློ་ཁ་ནང་དུ་སྐོར་དང་རང་རྒྱུས་ལོན།",
    "གནས་གཅིག་འདུག་ཚུགས་མི་མེད་དབེན་རི་རྟེན།",
    "མ་བཅོས་རང་སར་ཞོག་དང་རང་གྲོལ་ས་ཟིན།",
    "ཡེ་གནས་རང་རིག་ཀུན་བཟང་རང་ཞལ་མཇལ།",
    "ནམ་མཁའ་གཞི་ཡི་ངོ་ལ་གོས་པ་མི་འདུག།",
    "ཚེ་འདི་རྣམ་གཡེངས་ངང་དུ་ཟད་ཟད་དུ་བཏང་བའིམཛེས་མའི་གཟུགས་ལ་ཆགས་པའི་འདོད་ལྡན་གྱི་མི་ཚོསཝ་ཡིས་ཨ་ཀྲད་ཟོས་བཞིན་ཡིན་ལོ་རང་བྱེད་འདུག་ཞྭ་ལྟར་བྲག་ཕུག་གྱོན་ཞིང་ཏིང་འཛིན་གྱི་ཟས་ཟོས་ཟས་གོས་གྱི་ན་ཙམ་ལ་བརྟེན་པ་ཡི་བློ་ལྡན",
    "བློ་བྲལ་གཉུག་མ་དོན་གྱི་ཡེ་ཤེས་མཇལ་མ་ཡེངས་མི་བསྒོམས་རང་ངོ་སྐྱོང་ཙ་ན",
    "བསམ་བསམ་འགྲུབ་དུས་མི་གདའ་བློ་སྣ་ཟུངས།",
    "འདུག་ལོང་ཁོམ་ཅི་ཡོད་མི་ཤེས་པས།",
    "སོས་དལ་དལ་འདུག་ལོང་མི་གདའ་བས།",
    "བྱ་བ་མང་པོའི་ལོང་ཁོམ་མི་གདའ་བས།",
    "མི་དགོས་པ་ནི་གཅིག་ཀྱང་མི་འདུག་པས།",
    "ལོང་ཁོམ་མི་འདུག་ཆེ་བཞག་ཆུང་སྒྱུར་མཛོད།",
    "དགྲ་གཉེན་གང་ལའང་ངེས་པ་མི་འདུག་པས།",
    "བཏང་སྙོམས་ལུང་མ་བསྟན་ངང་རང་གར་འདུག།",
    "རང་བྱུང་རང་བཞག་སེམས་ཀྱི་འཛིན་རྩོལ་དང་བྲལ་བར།",
    "འདི་ཞེས་དངོས་མཚན་ཅན་གྱི་སྒོམ་རྒྱུ་ཞིག་མི་གདའ།",
    "གསལ་ལ་འཛིན་མེད་ཡེ་ནས་རང་གཤིས་སུ་འདུག་པས།",
    "ཡེ་སྟོང་རང་བབ་ངང་དུ་ཆམ་མེ་རང་ཞོག་ཐོང་།",
    "ཟད་པ་མི་འདུག་འཕགས་པའི་ནོར་དང་མཚུངས་འཇིག་རྟེན་ཟས་ལ་བཀྲེས་པའི་གདུང་བ་མེད",
    "རང་སར་ཞོག་དང་རང་སར་གྲོལ་བར་འགྱུར།",
    "སྡང་ཡང་འཁྲུལ་བའི་ལན་གྲངས་བག་ཆགས་དེ་བསགས་འདུག།",
    "དེ་རིང་དགའ་ཡང་སང་ཉིན་མི་དགའ་རུ་གྱུར་འདུག།",
    "ལྐོག་ཏུ་བླ་བཙག་ངན་སྨྲས་སྣ་ཚོགས་ཡང་བྱེད་འདུག།",
    "ཕྱི་རྐྱེན་དགྲ་འདྲེ་འཚུབ་ཆའི་ཆུ་རླབས་ཡང་གཡོ་འདུག།",
    "འཁོར་འདས་སྟོངས་སྲོག་དུས་གཅིག་འཕྲོག་པ་ཡི་ཐབས་ཟབ།",
    "བྱུང་རྒྱལ་བག་ཡངས་ཉམས་དགར་ལྷོད་ལྷོད་དུ་འདུག་ན།",
    "ད་ནི་བསྟོད་སྨད་ཚིག་ལ་ཉན་ཚོད་ནི་མི་འདུག།",
    "གཞན་ནས་མ་བཙལ་ཡེ་ནས་རང་ཆས་སུ་རྫོགས་འདུག།",
    "འདི་བདེ་ཕྱི་སྐྱིད་གཏན་གྱི་བདེ་བའི་སར་སླེབ་འདུག།",
    "ཚོགས་དྲུག་གང་སྣང་རང་གྲོལ་བདེ་ཆེན་ངང་།",
