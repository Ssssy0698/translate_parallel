    "དེ་ནྱི་མྱི་རྣམས་ཀྱི་མེས་པོ་གོང་བཀུར་བྱེད་པའྱི་གོམས་སོལ་ལས་བྱུང་བ་རེད་ཅེས་སོགས་གསུངས་སོ།",
    "རང་མྱི་རྱིགས་ཀྱི་འཚོ་གནས་དང་དར་རྒུད་ཀྱི་ཆེད་དུ་ཧུར་བརོན་བྱས་ཤྱིང་ཕག་རེས་ཁྱད་པར་ཅན་བཞག་མོང་བའྱི་དམ་པ་རྣམས་ལ་བསགས་བརོད་དང་རེས་དྲན་བྱེད་པའམ།",
    "དྲན་གསོའྱི་རྡོ་རྱིང་བསླངས་ནས་ཁོ་ཚོའྱི་མཁས་མཛངས་དཔའ་གསུམ་གྱི་སྣང་བརྙན་ཡུན་དུ་གནས་པར་བྱེད་པ་སོགས་ནྱི་འཛམ་གྱིང་ཤར་ནུབ་ཀུན་ཏུ་དར་ཞྱིང་ད་ལྟའྱི་བར་རྒྱུན་སོང་མུས་སུ་ཡོད་པའྱི་གོམས་སོལ་ཞྱིག་ཡྱིན།",
    "དམ་པ་གོང་མ་རྣམས་ཀྱི་མཛད་འཕྱིན་མྱི་བརེད་ཐོ་རུ་འགོད་པ།",
    "བཀའ་དྲྱིན་དྲན་ནས་བསྟོད་པའྱི་ཚིག་སྨྲ་བ་སོགས་ཀྱི་སོལ་ནྱི་གནའ་ས་མོ་ནས་ཡོད།",
    "ཡྱི་གེ་བྱུང་རེས་རྡོ་རྱིང་དུ་བརོས་པ་དང་བསྟན་བཅོས་སུ་མཛད་པའང་མང་པོ་ཡོད།",
    "ཨ་ཕྲུག་ཅེས་པའྱི་གཞོན་ནུ་བོ་གྲོས་ལྡན་ཞྱིང་དཔའ་ངར་ཆེ་བ།",
    "གཅྱིག་པུ་ཀླུ་ཡུལ་དུ་སོང་བ་དང་།",
    "མཐར་ཁོའྱི་དཔའ་ངར་དང་སྙྱིང་སྟོབས་ལ་བརེན་ནས།",
    "རེས་སུ་ཁོར་ཀླུའྱི་རྒྱལ་པོའྱི་ཁྱིམས་ཆད་ཕོག་ནས་ཁྱྱི་ལུས་སུ་བསྒྱུར་བ་སོགས་ཁྱད་མཚར་བའྱི་གཏམ་རྒྱུད་ཀྱི་བྱུང་རྱིམ་མང་པོ་ལ་བརེན་ནས།",
    "ཨ་ཕྲུག་གྱི་བཀའ་དྲྱིན་ལས་མྱིའྱི་རྱིགས་ཀྱིས་སྦྲང་དཀར་རམ་པ་ཟ་ཐུབ་པར་གྱུར་བའྱི་བརོད་སྙྱིང་འབུར་དུ་བཏོན་ཡོད།",
    "རེབ་གོང་རྡོ་རེ་མཁར་སོགས།",
    "རེས་རབས་པར་སྐུལ་མ་བཏང་པ་ཡྱིན་ཞེས་དང་།",
    "དོན་དངོས་དང་ཁད་ཅུང་཈ེ་བའྱི་སྒྱུ་རལ་གྱི་རྣམ་པ་ཞྱིག་རེད།",
    "རྱིགས་རུས་ལྷ་ལས་མཆེད་ཅྱིང་བོད་ཀ་གཡག་དྲུག་གྱི་རེ་བོ་མཛད་པའྱི་མཛངས་མྱི་སྟེ།",
    "བོད་རེ་ཐོག་མ་ག་཈འ་ཁྱི་བཙན་པོའྱི་མྱི་ཚེའྱི་བྱུང་བ་གཙོ་བོར་བརོད་ཡོད་ལ།",
    "ཤུགས་སུ་ཁོང་ནྱི་རང་གྱི་དཔའ་ངར་དང་བོ་གྲོས་ལ་བརེན་ནས་རེ་བོའྱི་གོ་སར་འཛེགས་ཤྱིང་།",
    "གནམ་རྱི་སོང་བཙན་དང་སོང་བཙན་སམ་པོ།",
    "ཁྱི་འདུས་སོང་བཙན།",
    "རེས་རབས་པར་ཡྱིད་ཆེས་དང་སོབས་པ་བསེད་པར་ཡང་ནུས་པ་མྱི་དམན་པ་ཐོན་ཐུབ།",
    "བོད་ཀྱི་སྒྱུ་རལ་རོམ་རྱིག་གྱི་བསྟན་བཅོས་འགའ་རེ་གླུའྱི་རྣམ་པར་བརེན་ནས་དར་སེལ་དང་རྒྱུད་འཛིན་བྱེད་པ་ཧ་ཅང་གསལ།",
    "ཁྱུང་པོ་སྤུང་སད་ཟུ་ཙེའྱི་མོན་ཀའྱི་ནྱི་སྟག་ཆྱིག་པ་སོགས་གང་ལ་མཚོན་ན་ཡང་།",
    "ཚིག་གྱི་དངོས་ཤུགས་གང་རུང་དུ་བཙན་པོ་རེ་བོན་དེ་དག་གྱི་མྱི་ཚེའྱི་བྱུང་བ་རགས་བསྡུས་རེ་དང་སོ་སོའྱི་གཤྱིས་རྒྱུད་དང་མཛད་རེས་ཅྱི་རྱིགས་མཚོན་ཡོད་པས།",
    "བྱ་རོ་རོ་ན་མདུང་གྱི་རེ་རང་ནྱིག།",
    "ལག་ཆགས་རེས་ཨ་ཁུའྱི་རོགས་རམ་ལ་བརེན་ནས།",
    "བརྡ་སོད་སྨྲ་བ་ཚོས་སྐད་ཀྱི་འགྱུར་བ་མཚོན་པའྱི་ཚོན་རྱིས་ལྟ་བུར་བརྱི་མོད།",
    "བརོད་བྱ་རོད་བྱེད་རོམ་པའྱི་ཀུན་སློང་དང་བརམས་རེས་ཀྱི་བྱེད་ལས།",
    "དེར་སོན་གྱི་རྒྱལ་བོན་བྱས་རེས་ཅན་དང་།",
    "བཙན་པོ་ཁྱི་ལྡེ་སོང་བཙན་གྱི་བང་སོའྱི་རྡོ་རྱིང་ཡྱི་གེར། བཙན་པོ་ལྷ་སས་ཁྀ་ལྡེ་སོང་བཙན་མྱིའྱི་རེ་མཛད་པ།",
    "མྱི་ཡོངས་ཀྱིས་ཁོང་གྱི་འཕྱིན་ལས་རེས་སུ་དྲན་ཕྱིར་བརོས་པའྱི་ཕྱིར་རོ།",
    "ལྷག་པར་དུ་ཕྱི་འབེལ་དང་དམག་འཁྲུག་ཐད་ཀྱི་མཛད་རེས་གཙོར་བརོད་པ་ལྟ་བུའོ།",
    "བོན་སྟག་ས་ཀླུ་ཀོང་གྱི་མཛད་རེས་ལ་བསགས་པའྱི་ཞོལ་རྡོ་རྱིང་།",
    "བན་ཆེན་པོ་མང་ཏྱིང་འཛིན་བཟང་པོའྱི་མཛད་རེས་ལ་བསགས་པའྱི་དབུ་སྟོད་ཞྭ་ལྷ་ཁང་གྱི་རྡོ་རྱིང་ས་ཕྱི་ག་཈ྱིས།",
    "ཁྱི་ལྡེ་སོང་བཙན་སྐུ་རྱིང་ལ་བཞེངས་པའྱི་རྒྱལ་སེ་སྐར་ཆུང་ལྷ་ཁང་གྱི་རྡོ་རྱིང་སོགས་རྡོ་རྱིང་ཡྱི་གེ་ཕལ་མོ་ཆེ་ནྱི་སོན་བྱོན་མེས་པོ་དག་གྱི་མཛད་རྣམ་གསལ་པའྱི་བརྙན་ཡོལ་ལྟ་བུ་ཡྱིན།",
    "རང་རེ་མཁས་པ་རྣམས་ཀྱི་རྣམ་དཔྱོད་ཀྱི་འཆར་ཚུལ།",
    "འཕགས་ཡུལ་རྒྱལ་བསྟན་རྱིན་ཆེན་བོད་ཡུལ་དུ་དར་བ་དང་བསོང་ནས།",
    "སྟོན་པ་ཤཱཀ་ཐུབ་པའྱི་སེས་རབས་རོགས་བརོད་ཀྱི་རོམ་ཐབས་རོམ་ལུགས་ལ་དཔེ་དང་ལད་མོ་བྱས་ནས།",
    "ཕག་མོའྱི་རོགས་པ་བརོད་པ་ཤོ་ལོ་ཀ་བརྒྱ་",
    "སྐ་བ་དཔལ་བརེགས་ཀྱིས་བསྒྱུར་བ།",
    "བཅོམ་ལྡན་འདས་རྒྱལ་པོའྱི་ཁབ་འོད་མའྱི་ཚལ་ཀ་ལན་ད་ཀ་གནས་པ་ན་རེན་ཅྱིང་བཞུགས་པའྱི་ཚེ།་",
    "སྟག་མོའྱི་སེས་པའྱི་རབས་ནས་བྱ་ཤྱིང་ར་མོའྱི་སེས་པའྱི་རབས་ཀྱི་བར་ཏེ།",
    "རེས་སུ་ཀརྨ་རང་བྱུང་རྡོ་རེས་ཁ་བསྐངས་པ་སེས་རབས་བརྒྱ་བ་ཞེས་གྲགས་པ་དེའོ།",
    "ཤ་འཇྱིག་རེན་ཀུན་ཏུ་དགའ་བའྱི་ཟློས་ག་ར་ཞེས་པ་སློབ་དཔོན་ཙནྡྲ་གོ་མྱིས་མཛད་ཅྱིང་ལོ་བྷཱ་བ་ཡར་ལུང་གྲགས་པ་རྒྱལ་མཚན་གྱིས་བསྒྱུར་བ།",
    "ཤ་བཅོམ་གང་རུང་གྱི་འདས་མ་ད་གསུམ་ལུང་བསྟན་གྱི་ཚུལ་དུ་གསུངས་པའང་འགའ་རེ་ཡོད།",
    "ཀརྨ་རང་བྱུང་རྡོ་རེས་མཛད་པའྱི་སེས་རབས་བརྒྱ་བ།",
    "སྐུ་ཚེའྱི་འདྱིའྱི་མཛད་པ་བརྒྱ་དང་བརྒྱད་བརོད་པ་ཞྱིག་རེད།",
