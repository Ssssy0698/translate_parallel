    "ཚོར་འདུ་རགས་པ་མ་ལུས་པ་བཀག་པའི་ལུས་ཀྱི་གནས་སྐབས་ལ་བཏགས་པའི་བཏགས་ཡོད་དུ་ཁས་ལེན་པའི་ཕྱོགས་དང་མཐུན་པར་སྨྲ་དགོས་ལ།",
    "དེ་ལྟ་ན་སྙོམས་འཇུག་དངོས་པོ་མིན་པར་ཁས་ལེན་དགོས་ཏེ།",
    "ཚོར་འདུ་མ་ལུས་པ་བཀག་པར་འགལ་ལོ་ཞེ་ན།",
    "རགས་པ་ཡོད་པར་ངེད་ཀྱང་མི་འདོད་ལ།",
    "ཀུན་གཞི་དེའི་ཚད་ཡོད་པར་སྨྲ་བ་དག་ལ་ཡང་སྐྱོན་འབྱུང་སྟེ།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་འཇུག་དང་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "སྙོམས་པར་འཇུག་པའི་འདུ་ཤེས་ཕྱིན་ཅི་ལོག་མ་ལོག་ལ་སོགས་པའི་སྒོ་ནས་ཁྱད་པར་ཤིན་ཏུ་ཆེའོ།",
    "རྟོག་མེད་ལོག་ཤེས་ཡིན་པར་མི་འཐད་དེ།",
    "མངོན་སུམ་དབྱེ་གཞིར་བྱས་པའི་དབྱེ་བ་ལ།",
    "རྣལ་འབྱོར་མངོན་སུམ་བཞི་པོ་ཐམས་ཅད་དང་རིགས་མི་གཅིག་པའི་མངོན་སུམ་ཡོད་པར་འདོད་དགོས་པར་འགྱུར་རོ།",
    "བདག་ལྟ་བདག་ཆགས་གཉིས་དུས་མཚུངས་པར་ཁས་ལེན་དགོས་ནའང་།",
    "སྒྲ་དོན་འཛིན་པའི་རྟོག་པར་ཁས་ལེན་དགོས་ལ།",
    "ཉོན་ཡིད་ནི་འདས་ལམ་ལ་མཉམ་པར་བཞག་པ་དང་།",
    "འགོག་པ་ལ་སྙོམས་པར་ཞུགས་པ་དང་།",
    "ཉོན་ཡིད་ཁས་མི་ལེན་པར་གྲུབ་ཅིང་།",
    "འདི་ལྟར་ཀུན་གཞི་ཁས་ལེན་པ་དག་ཀུན་གཞི་ཉིད་བདག་ལྟའི་དམིགས་པར་འདོད་པ་ཡིན་ལ།",
    "འགོག་པ་ལ་སྙོམས་པར་ཞུགས་པའི་ཚེ་སེམས་མེད་པར་མི་འཐད་ལ།",
    "དེ་མ་ཐག་རྐྱེན་ཡིན་པར་གྲུབ་པས།",
    "སྙོམས་པར་འཇུག་ཁའི་ཤེས་པ་སྐད་ཅིག་ཐ་མ་དེ།",
    "གཞན་ཡང་དེའི་རྒྱུ་ཡིན་པར་མི་འཐད་པས།",
    "དེའི་དངོས་ཀྱི་ཉེར་ལེན་མི་སྲིད་པར་འདོད་དགོས་པས།",
    "ཚུལ་འདི་ཡང་ཧ་ཅང་འགྲིག་པར་མ་མཐོང་ངོ།",
    "ལུས་ཀྱིས་སེམས་ཀྱི་ཉེར་ལེན་བྱེད་པར་འདོད་པ།",
    "གཞན་ཡང་འདི་དག་ལ་བརྗོད་པར་བྱ་བ་ཤིན་ཏུ་མང་ཡང་མངས་པར་འགྱུར་བས་མ་བྲིས་སོ།",
    "འདོད་ཁམས་སུ་སྐྱེ་བ་འཕེན་བྱེད་ཀྱི་སྔོན་གྱི་ལས་ཀྱིས་བཞག་པའི་བག་ཆགས་ཉིད་དེའི་ཉེར་ལེན་ཡིན་པར་འདོད་ལ།",
    "དེ་ཉིད་ཀྱི་ལུས་སྐྱེ་མཆེད་ལྔས་འདུས་བྱས་པའི་བག་ཆགས་རྒྱུར་འགྱུར་རོ།",
    "བག་ཆགས་ཉེར་ལེན་ཡིན་ན་ཤེས་པ་ཉེར་ལེན་མ་ཡིན་པར་འདོད་པ་དང་འགལ་ཏེ།",
    "བག་ཆགས་རྣམས་ཤེས་པར་འདོད་པ་འདི་ནི་གཞུང་ལུགས་ཆེན་པོ་དག་ལ་འདྲེས་པར་མ་བྱས་པའི་བབ་ཅོལ་ཏེ།",
    "རང་གང་ལ་ལྡན་པའི་ཤེས་པ་དེ་མ་ཡིན་པའི་ཤེས་པར་ཡང་མི་འཐད་དེ།",
    "ཤེས་པ་དབྱེ་གཞིར་བྱས་ནས་ཕྱེ་བའི་ཤེས་པ་ལ།",
    "ཚུལ་འདིས་བག་ཆགས་ཤེས་པར་འགྱུར་ཚུལ་མཐའ་དག་ཤེས་པར་བྱའོ་ཞེ་ན།",
    "ཤེས་པས་ལུས་ཀྱི་ཉེར་ལེན་བྱེད་པ་ཡོད་པར་གྲུབ་བོ་ཞེ་ན།",
    "བདག་སྐྱེ་ཁས་བླངས་པར་མི་འགྱུར་བས།",
    "བདག་སྐྱེར་འགྱུར་བའི་སྐྱོན་བརྗོད་མཛད་པ་མཐའ་དག་མི་རིགས་པར་འགྱུར་ལ།",
    "བུམ་པ་བདག་ལས་སྐྱེ་བར་གྲུབ་པའི་མཐའ་ལས་ཁས་ལེན་པའི་རྒོལ་བ་སུ་ཡང་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཚུལ་འདིས་ནི་བདག་སྐྱེའི་དོན་ཁོང་དུ་མ་ཆུད་པར་ཟད་དོ།",
    "ཡང་ན་དེའི་དེ་མ་ཐག་རྐྱེན་ཡང་དེ་དང་དུས་མཉམ་ཞིང་རྫས་གཅིག་པར་ཁས་ལེན་དགོས་པས།",
    "རྣམ་པར་གཞག་པ་ཐམས་ཅད་འགྲིག་དཀའ་བར་འགྱུར་རོ།",
    "རྫས་སུ་གྲུབ་མ་གྲུབ་གང་ཡང་མ་ཡིན་པའི་རྒྱུ་འབྲས་སྲིད་པར་འགྱུར་རོ།",
    "རྒྱུ་འབྲས་རྫས་མ་གྲུབ་སྲིད་པར་འགྱུར་རོ།",
    "རྫས་སུ་གྲུབ་མ་གྲུབ་དཔྱོད་པའི་རིགས་པ་དོན་དམ་དཔྱོད་པའི་རིགས་པ་མ་ཡིན་པར་འདོད་པ་དང་།",
    "དེའི་ཚེ་དེའི་དམིགས་རྐྱེན་མ་ཡིན་པར་འགྱུར་ལ།",
    "དེའི་ཚེ་དམིགས་རྐྱེན་གཞན་ཡང་མེད་པར་འདོད་དགོས་པས།",
    "དེ་ལྟ་ན་བདག་རྐྱེན་ཡང་ཤེས་པ་སྔ་མ་ཉིད་ལ་འདོད་དགོས་པར་མཚུངས་པས།",
    "ཉེར་ལེན་གྱིས་འབྲས་བུ་སྐྱེད་སྐྱེད་པ་ལྷན་ཅིག་བྱེད་རྐྱེན་ལ་ལྟོས་དགོས་པས་མ་ཁྱབ་པར་འགྱུར་རོ།",
    "ལྷན་ཅིག་དམིགས་ངེས་ཡིན་ན་དུས་མཉམ་ཡིན་པར་འདོད་པ་རྣམས་ནི་ནང་འགལ་བ་ཡིན་ཏེ།",
    "ཞེས་གསུངས་པས་བསྟན་པའི་དམིགས་རྐྱེན་དང་།",
    "དེའི་རྣམ་པར་ཤེས་པར་བྱ་བའི་ངོ་བོ་ཡིན་པའི་ཕྱིར།",
    "ཞེས་པའི་འབྲུ་སྣོན་བྱས་པ་ནི།",
    "ཞེས་པ་ཟློས་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "རྒྱུ་འབྲས་ལ་རྫས་གཞན་གྱིས་མ་ཁྱབ་པར་འདོད་པ།",
    "ཡང་ན་ནུས་པ་འཇོག་ཕྱིར་རིམ་གྱིས་ཡིན་ཞེས་གསུངས་པ་ཡིན་ལ།",
    "ཡཡང་ན་ཁོ་བོ་ནི་འདི་ལྟར་འཆད་པར་བྱེད་དོ་ཞེས་པའོ།",
    "དེའི་དམིགས་རྐྱེན་དུ་བཞག་པའི་ཚུལ་འདི་ནི་གྲུབ་པའི་མཐའ་ལས་འོངས་པའི་རྣམ་པར་གཞག་པ་རབ་ཏུ་བརླིང་པ་ཁོ་ནའོ།",
    "རྣམ་པར་ཤེས་པ་ལས་དེ་གཉིས་གཞན་དང་གཞན་མ་ཡིན་པ་ཉིད་དུ་ཅི་དགར་བརྗོད་པར་བྱའོ།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཞེས་ཤེས་པར་བྱའོ།",
    "དེའི་ཕྱིར་སེམས་ཙམ་པས་ཡུལ་ཤེས་ལྷན་ཅིག་དམིགས་ངེས་ཀྱི་རྟགས་ཀྱིས་རྫས་གཞན་མ་ཡིན་པར་སྒྲུབ་པ་ནི།",
    "ངེས་པར་ཡུལ་དེ་ཕྱི་རོལ་གྱི་དོན་ཡིན་པར་ཁས་ལེན་དགོས་པའི་ཡུལ་དེ་རྣམས།",
    "ཡུལ་ཅན་ཤེས་པ་རྣམས་དང་རྫས་གཞན་མ་ཡིན་པར་སྒྲུབ་པ་ཡིན་ལ།",
    "དེ་ལྟར་གྲུབ་ན་ཤེས་པ་ལས་ཕྱི་རོལ་ཏུ་གྱུར་པའི་དོན་གྲུབ་པར་འདོད་དགོས་པས།",
    "དེའི་ཕྱིར་དེ་ལྟ་བུའི་ཤེས་པ་གཞིར་བྱས་ཀྱི་ཡུལ་ཡུལ་ཅན་འགའ་ཞིག་ལྷན་ཅིག་དམིགས་ངེས་ཀྱི་རྟགས་ཀྱིས་རྫས་གཞན་མ་ཡིན་པར་སྒྲུབ་པ་མ་ཡིན་ལ།",
    "ཕྱི་རོལ་དོན་དུ་འདོད་དགོས་པར་འགྱུར་བས་རྫས་གཅིག་ཏུ་ལྷན་གཅིག་དམིགས་ངེས་ཀྱི་རྟགས་ཀྱིས་སྒྲུབ་པ་ཡིན་གྱི།",
    "སྔོ་སོགས་རྣམས་ཀུན་མཁྱེན་ཡེ་ཤེས་དང་རྫས་གཅིག་ཏུ་འདོད་དགོས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བདག་མེད་མངོན་སུམ་རྟོགས་པའི་ཀུན་མཁྱེན་ཡེ་ཤེས་དང་བདག་འཛིན་ཡང་རྫས་གཞན་མ་ཡིན་པར་འགྱུར་བ་བས།",
    "སེམས་ཙམ་པའི་ལུགས་ལ་རྫས་གཞན་མི་སྲིད་པར་འགྱུར་རོ།",
    "མིག་ཤེས་ཀྱིས་ཡུལ་མཛིན་པར་མི་འདོད་པས་མིག་ཤེས་ལ་སྔོན་པོར་སྣང་བ།",
    "བྱེ་བྲག་སྨྲ་བ་མིག་ཤེས་ཀྱིས་ཡུལ་མི་འཛིན་པར་འདོད་པ་ལ་ཤེས་བྱེད་ཅི་ཡོད་ཅེ་ན།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རྣམ་པར་རིག་པ་ཙམ་དུ་སྨྲ་བ་གཉིས་ཀས་མཐུན་སྣང་དུ་གྲུབ་ཅིང་།",
    "ཡུལ་ལྔ་པོ་དེ་ཉིད་དོན་སྨྲ་གཉིས་ཀྱིས་ཕྱི་དོན་དུ་སྒྲུབ་པར་བྱེད་ཅིང་།",
    "སྐབས་འདིར་གཞན་གྱི་ལོག་པར་རྟོག་པ་ཅུང་ཟད་དགག་པར་བྱ་སྟེ།",
    "སྐྱེ་མཆེད་བཅུ་གཉིས་ཀྱི་རྣམ་གཞག་ཀྱང་ཁས་མི་ལེན་པར་འགྱུར་བས།",
    "ཡང་ན་སེམས་ཙམ་པའི་གཞུང་ལུགས་ཕལ་ཆེ་བ་ནས་ཕུང་པོ་ལྔའི་རྣམ་གཞག་སོགས་ལན་མང་དུ་འགྱུར་བ་དག་ལ་ཁོ་བོ་ཅག་བསྙོན་པར་བྱེད་དོ་ཞེས་སྨྲོས་ཤིག་གཞན་ཡང་།",
    "རྣམ་འགྲེལ་ངེས་ལས་གསུངས་པ་རྣམས་སྤངས་པར་འགྱུར་རོ།",
    "ཁམས་གསུམ་དང་སྐུ་གསུམ་ལ་སོགས་པ་འཁོར་འདས་ཀྱི་རྣམ་གཞག་ཕལ་ཆེ་བ་ཁས་བླང་བའི་ཐབས་མེད་པས་རྣམ་པ་ཐམས་ཅད་དུ་རྒུད་པ་འབའ་ཞིག་ཐོབ་པར་འགྱུར་རོ།",
    "གཞི་གྲུབ་ན་ཀུན་མཁྱེན་ཡེ་ཤེས་ཡིན་པས་ཁྱབ་པར་སྨྲ་དགོས་པར་འགྱུར་རོ།",
    "གཞི་གྲུབ་ན་རང་རིག་མངོན་སུམ་དུ་ཡང་མི་འདོད་བཞིན་དུ་ཁས་བླང་དགོས་པར་འགྱུར་རོ།",
    "སྐྱེས་བུ་ལོང་བ་མི་སྲིད་པར་འགྱུར་ཞིང་།",
    "གཅེར་བུ་པའི་རིང་ལུགས་ཆེས་གསལ་བར་བྱེད་པར་འགྱུར་རོ།",
    "མངོན་སུམ་རྟོག་བཅས་སྲིད་པར་འགྱུར་རོ།",
    "འདིས་མཚོན་ནས་མིག་ཤེས་ཡིན་ན་མི་འགལ་བས་ཁྱབ་པར་ཁས་ལེན་དགོས་པར་འགྱུར་རོ།",
    "ལྷས་བྱིན་འགོག་པ་ལ་མཉམ་པར་བཞག་པའི་ལུས་གཟུགས་དྲི་རོ་རྣམས་ཀྱང་ལུས་ཤེས་མིག་ཤེས་སོགས་སུ་འདོད་དགོས་པའི་ཕྱིར།",
    "བློ་གྲོས་ཤིན་ཏུ་རྩིང་བ་འགའ་ཞིག་ཤེས་བྱ་ཡིན་ན་སེམས་ཡིན་པས་ཁྱབ་པར་འདོད་པ་དེ་དག་ཐམས་ཅད་ལའང་།",
    "ཡང་དག་པར་ཤེས་པ་ཡིན་ནོ་ཞེས་ཟེར་ཏོ།",
    "གོ་མི་ཆོད་ན་ཐ་སྙད་དུ་ཡོད་པས་ཀྱང་ཡོད་པའི་གོ་མི་ཆོད་པར་མཚུངས་པས།",
    "ཀུན་རྫོབ་བདེན་པ་རྣམ་པར་ཆད་པ་མེད་པའི་ཕྱོགས་སུ་བསླན་པར་འགྱུར་རོ།",
    "བེམ་པོའི་དུ་བ་ཡོད་པའི་ཕྱིར་ཞེས་པའམརིག་པའི་དུ་བ་ཡོད་པའི་ཕྱིར་ཞེས་པའི་ཁྱད་པར་མ་སྦྱར་བར།",
    "དེ་གཉིས་གང་ཡང་མ་ཡིན་པའི་ཡོད་པའི་གོ་ཆོད་མི་ཆོད་འདྲི་ཞེས་ལན་འདེབས་པར་བྱེད་པ་ནི།",
    "བྱས་པའི་ཕྱིར་ཞེས་བརྗོད་པ་ལ།",
    "སྒྲའི་བྱས་པ་ཡིན་པའི་ཕྱིར་ཞེས་ཟེར་རམ།",
    "བུམ་པའི་བྱས་པ་ཡིན་པའི་ཕྱིར་ཞེས་ཟེར་རམ།",
    "དེ་གཉིས་གང་ཡང་མིན་པའི་བྱས་པ་ཡིན་པའི་ཕྱིར་ཞེས་ཟེར།",
    "དེས་ན་ཚུལ་འདི་ནི་ལན་འདེབས་པར་མ་ནུས་པ་ན།",
    "ཡང་དག་པར་ཤེས་པ་ཡིན་ཞེས་ཁས་བླངས་པས།",
    "རྗེས་ཀྱི་རྟོག་པས་སྔོན་པོ་དང་ཕྱི་རོལ་གྱི་དོན་དུ་ཞེན་པར་བྱེད་པའི་ཕྱིར།",
    "དོན་དམ་པར་གཟུང་འཛིན་རིག་གསུམ་ཐ་དད་དུ་འདོད་དགོས་པས་སེམས་ཙམ་པའི་དྲི་ཙམ་ཡང་མི་དྲོའོ།",
    "གཞན་ཡང་ཐ་སྙད་རྣམ་པར་འཇོག་པ་ནི།",
    "སྔོན་པོ་དེ་ཀུན་མཁྱེན་ཡེ་ཤེས་ཀྱིའང་བདག་ཉིད་ཡིན་ནམ་ཞེ་ན།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་དང་སྔོན་པོ་སོགས་རྫས་གཅིག་ཏུ་སྒྲུབ་མི་ནུས་ཏེ།",
    "གང་དག་བེམ་རིག་གང་ཡང་མ་ཡིན་པའི་དངོས་པོ་མི་སྲིད་པར་འདོད་པ་ནི་རྣམ་པར་མ་བརྟགས་པ་སྟེ།",
    "རྣམ་བདེན་པ་ལྟར་ན་རྫས་གཅིག་ཏུ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ལ།",
    "རྫས་གཅིག་ཏུ་སྒྲུབ་པ་དང་རྫས་གཞན་མ་ཡིན་པར་སྒྲུབ་པ་གཉིས་ཀ་ལྟར་ཡང་མི་འཐད་པ་མེད་ལ།",
    "གང་དུ་སྒྲུབས་ཀྱང་འདོད་པའི་དོན་འགྲུབ་པ་ལ་ཡང་ཁྱད་པར་མེད་དེ།",
    "དེ་གཉིས་གང་ཡིན་ཡང་ཕྱི་དོན་ཡིན་པར་འགལ་བའི་ཕྱིར་རོ།",
    "ལྷན་ཅིག་དམིགས་པར་ངེས་པའི་དོན།",
    "ལྷན་ཅིག་དམིགས་པར་ངེས་པའི་ཕྱིར།",
    "རྫས་གཞན་མ་ཡིན་པར་སྒྲུབ་པ་ལ་ལྷན་ཅིག་དམིགས་ངེས་ཡིན་པ་ཙམ་རྟགས་སུ་བཀོད་ན།",
    "ལྷན་ཅིག་དམིགས་པར་ངེས་པའི་ཕྱིར།",
    "འོག་ཏུ་རང་རིག་མངོན་སུམ་གྱི་སྐབས་ནས་འཆད་པར་འགྱུར་བའི་རིགས་པ་རྣམས་ཀྱིས་དགག་པར་བྱའོ།",
    "སྔོན་འཛིན་མིག་ཤེས་དང་དེ་ལ་སྣང་བའི་སྔོན་པོ་གཉིས་གཅིག་དངོས་སུ་དམིགས་པའི་བློས་གཅིག་དངོས་སུ་དམིགས་པར་འདོད་པ་ཡིན་གྱི།",
    "དེ་བས་ན་ལྷན་ཅིག་དམིགས་པར་ངེས་པའི་དོན་ནི་འདི་ཡིན་ཏེ།",
    "ཅེས་པར་ཤེས་པར་བྱ་སྟེ།",
