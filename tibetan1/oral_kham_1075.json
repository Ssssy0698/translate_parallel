    "སེམས་དང་སེམས་བྱུང་རང་གསལ་སྐད་ཅིག་མ།",
    "བྱེ་སྨྲ་སུན་འབྱུང་རང་ལུགས་བརྗོད།",
    "སེམས་དང་སེམས་བྱུང་གཉིས་ཀ་ཡང་རང་གསལ་པ་རྣམ་པ་དང་བཅས་པ་རྫས་གྲུབ་ཁོ་ན་ཡིན་ནོ།",
    "དེ་གཉིས་ཀའང་རང་དང་ངོ་བོ་གཅིག་པའི་དོན་གྱི་རྣམ་པ་རིག་པས་རང་རིག་མཚན་ཉིད་པ་དང་།",
    "ཁྱེད་རང་སྒྲ་མེད་ཕྲ་རབ་རྡུལ་རྫས་བརྒྱད་ཅེས་འདོད་པའི་རྫས་བརྒྱད་པོ་སོ་སོ་ནས་གྲུབ་པ་མེད་པའི་ཕྱིར་དེ་དག་འདུས་པའི་རྡུལ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཀུན་ཀྱང་རང་རང་ལུགས་ཀྱི་ཀུན་རྫོབ་ཀྱི།",
    "ཁྱེད་རང་རྣམ་པར་རིག་པ་ཙམ་དུ་ཡང་།",
    "འཕགས་པ་བདེན་པ་གཉིས་ལ་འདུག་པ་ལས།",
    "མིན་ན་འདི་ཙམ་ནས་འཆི་བར་འདུག་ཅེས་ཀུན་གྱིས་རྟོགས་པའི་ཁ་དམར་གདགས་དགོས།",
    "མི་གང་ཞིག་ཡིན་ཡང་རང་ཉིད་མ་གོམས་ཤིང་རྒྱུན་དུ་ཟས་ཟ་བའི་སྐབས་མ་ཡིན་པའི་དུས་ནམ་ཕྱེད་སོགས་སུ་ཟོས་མ་མྱོང་བའི་ཁ་ཟས་རིགས་ཟོས་ན།",
    "འགྲངས་རྗེས་དལ་བར་འདུག་པ་དང་རླན་སྟེང་དུ་ཉལ་བའམ།",
    "འདིའི་རིགས་ཀྱི་ཚད་གཉའ་ཆག་དུས་སུ་བསིལ།",
    "ལྔ་བརྒྱ་ཕྲག་བཅུའི་དུས་ཀྱི་ཐ་མར་སླེབས་ཙ་ན།",
    "ལྔ་བརྒྱ་ཕྲག་བཅུའི་དུས་ཀྱི་ཐ་མར་སླེབས་ཙ་ན།",
    "ལྔ་བརྒྱ་ཕྲག་བཅུའི་དུས་ཀྱི་ཐ་མར་སླེབས་ཙ་ན།",
    "ལྔ་བརྒྱ་ཕྲག་བཅུའི་དུས་ཀྱི་ཐ་མར་སླེབས་ཙ་ན།",
    "ལྔ་བརྒྱ་ཕྲག་བཅུའི་དུས་ཀྱི་ཐ་མར་སླེབས་ཙ་ན།",
    "ལྔ་བརྒྱ་ཕྲག་བཅུའི་དུས་ཀྱི་ཐ་མར་སླེབས་ཙ་ན།",
    "ལྔ་བརྒྱ་ཕྲག་བཅུའི་དུས་ཀྱི་ཐ་མར་སླེབས་ཙ་ན།",
    "ལྔ་བརྒྱ་ཕྲག་བཅུའི་དུས་ཀྱི་ཐ་མར་སླེབས་ཙ་ན།",
    "ལྔ་བརྒྱ་ཕྲག་བཅུའི་དུས་ཀྱི་ཐ་མར་སླེབས་ཙ་ན།",
    "སྤྱོད་ལམ་འགྲོ་འདུག་དྲགས་པ་དང་།",
    "རླན་ཆེ་སར་མལ་ནས་འདུག་དྲགས་པ་སོགས་ཀྱིས་བད་ཚིལ་འཕེལ་བ་ཟུངས་སུ་མ་གྱུར་པར།",
    "༣ སྟན་སྲབ་ཙོག་འདུགསྟན་སྲབ་པོར་ཙོག་པུར་ཡུན་རིང་དུ་བསྡད་ན།",
    "༤འགྱུརསྟན་སྲབ་པོར་ཙོག་པུར་འདུག་པ་དང་།",
    "སྟན་སྲབ་པོའི་སྟེང་དུ་ཙོག་པུར་འདུག་པའི་ཡུན་ཤིན་ཏུ་རིང་ན།",
    "སྟན་སྲབ་པོའི་ཁར་ཙོག་པུར་འདུག་པ་དང་།",
    "དེས་ཟིན་ན་རྟགས་སུ་ཤིང་སོགས་འཛིན་ཅིང་གཅེར་བུར་རྒྱུག་པ་དང་གནས་སྟོང་དུ་འདུག་པ།",
    "དེ་ལ་མཚོན་གྱིས་ཕུག་ན་ཙོག་གེ་འདུག་མི་ཚུགས་ལ་ཟུག་ཆེ་ཞིང་།",
    "ཤོའུ་ཁྱད་འཕགས་ཁེངས་པོ་དུང་རང་ལགས།",
    "ཡིད་ཀྱི་ཁྱེའུ་ཆུང་བེ་རོ་ཙ་ན།",
    "བེ་རོ་ཙ་ན་མངའ་བདག་རྒྱལ་པོ་དང་།",
    "གདམས་པ་འདི་དག་ལས་བེ་རོ་ཙ་ན་དང་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེའུ་བཙན།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ནའི་སྐུ་དུས་སུ་ཡོད་པར་གསུངས།",
    "བོན་ལའང་རང་བཞིན་གྱིས་འགྱུར་ལྡོག་འགྲོ་བ་ནི་བརྗོད་མི་དགོས་པ་ཞིག་སྟེ།",
    "འོན་ཀྱང་ཐང་ལྷའི་བླ་རིའི་ལོགས་སུ་མི་འདུག་པས།",
    "དབུགས་ལྷེབ་ལྷེབ་འདུག་པ་མཐོང་།",
    "གླུད་ཅིག་གྱིས་ལ་དེའི་རྒྱབ་ལ་ལོ་དུ་ལོན་གྱི་ཁྲམ་ཐོབ་ལ་དེ་ཟར་ཆུགས་དང་དེས་ཕན་ཡོང་བར་འདུག་ཅིག་ཟེར།",
    "སྤྲང་པོ་ཕ་སྤད་གཉིས་འདུག་པའི་བུ་དེ་དགུང་མཉམ་དུ་འདུག་པས་དེ་ལ་ན་བཟའ་ཞིག་བྱིན།",
    "ངེད་ཅག་བློན་པོ་ཀུན་རང་རང་སོ་སོར་བྱེར་ནས་འགྲོ།",
    "ལྷ་ཡི་དཀོར་མདུང་རང་འདེབས་དང་།",
    "ཡང་གྱང་དོ་རི་འདི་ནས་ཡར་ལྷ་ཤམ་པོ་མཇལ་གྱི་འདུག་གམ་ཞེས་ཞུས་པས།",
    "འོ་ན་ཕྱག་སོར་དང་ལྕེ་ངོ་མཚར་ཆེ་བ་གཅིག་འདུག་པ།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་གཉའ་བར་ཁྲི་ལ་བཏེག་ཅིག་དང་སྟོབས་རྫུ་འཕྲུལ་གྱིས་གདོན་མི་ཟ་ཟེར་བ་དང་།",
    "རྒན་རབས་ཚོས་དེར་ཤིང་སྡོང་ཞིག་ཀྱང་བཙུགས་ཡོད་ཚུལ་བརྗོད་མཁན་འདུག་རྟེན་མཁར་དང་སྡིངས་ཆའི་རྩིག་པ་དང་རྡོ་སྐས་རྣམས་ལོ་སྟོང་ཕྲག་དུ་མའི་གོང་ནས་བྱས་པ་ནི་བལྟས་པ་ཙམ་གྱིས་ཤེས་ཐུབ་པ་དང་།",
    "འོན་ཀྱང་ཡ་མཚན་ཆེ་བ་ཞིག་ལ་ཀོང་པོའི་ལྷ་རི་གྱང་དོ་ལའང་སྟོན་པ་གཤེན་རབ་མི་བོ་ཆེས་རི་རྩེ་དེ་ནས་གྲུ་བཏང་བའི་སྒྲུང་གཏམ་ཞིག་གསུང་རྒྱུ་འདུག་དོ་ར་ལྷ་ཆེན་ཞེས་པའི་ལྷ་རི་འདིར་སྔོན་དུས་ཤིང་ཤུག་པའི་ནགས་ཚལ་ཡང་ཡོད་པར་སྣང་སྟེ།",
    "སྔ་མ་ལ་དཀར་ཆག་འཕང་ཐང་མར་བམ་པོ་ཉེར་བདུན་ཞེས་འབྱུང་ཡང་ཉེར་དགུར་ཁོ་རང་ལས་བྱུང་ངོ།",
    "ཅིག་ཤོས་ནི་དུས་རབས་བརྒྱད་པའི་སྐབས་སུ་བྱུང་བའི་བོད་ཀྱི་སད་མི་བདུན་གྱི་གྲས་བེ་རོ་ཙ་ནས་སྲོལ་བཏོད་དོ་ཞེས་པ་དེ་ཡིན།",
    "བོན་གཅིག་པུ་མ་ཡིན་པར་རྙིང་མ་བའི་གྲུབ་མཐས་ཀྱང་རང་ཉིད་ཀྱི་གཞུང་ལུགས་རྣམས་ནང་གསེས་དགུ་རུ་དབྱེ་བ་ཡིན།",
    "དེ་རྗེས་མདུན་དུ་འདུག་པ་ལ།",
    "དཀྱིལ་འཁོར་ཤར་སྒོར་འདུག་སྟེ།",
    "ལས་པའམ་ཡང་ན་འདུག་པའམ།",
    "མི་དང་མི་མིན་ཕྱོགས་མཚམས་གར་འདུག་ཀྱང་།",
    "གུམ་པ་དེའི་ཡོ་བྱད་གདའ་བ་དང་མི་གདའ་བ་མཆིས་པ་འདི་ལགས་ཏེ།",
    "ཇི་ཙམ་ན་ཝ་ཞིག་དུས་ཀྱི་ཞགས་པས་བཅིངས་ནས་ཕྱོགས་དེར་འོངས་ནས་དེས་རོ་དེ་དག་ཐམས་ཅད་མཐོང་ངོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཉིད་ཀྱིས་ཕྱེ་བ་དང་སྦྲུལ་ཞིག་མགོའི་གདེངས་ཀ་ཆེར་བྱས་ནས་འདུག་གོ།",
    "ཡུམ་བདག་དུས་འདི་སྲིད་ཀྱི་བར་དུ་སྔོན་སུ་ལ་ཡང་འགའ་ལ་ཁྲོས་པ་མཆིས་སམ།",
    "སླར་ཡང་མཚམས་ན་འདུག་པ་རྣམས་དང་ལྷན་ཅིག་བགོ་བར་བྱ་སྟེ།",
