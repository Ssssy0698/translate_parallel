    "གཞན་གྱི་སྣང་བ་ལས་ནི་རང་གི་སྣང་བ་སྐྱེ་བ་ཡང་མ་ཡིན་ནོ་ཞེ་ན།",
    "གང་གིས་མྱུ་གུ་དེ་རྒྱུ་ཅན།",
    "འོན་ཏེ་རྗེས་སུ་དཔག་པས་རང་གི་ངོ་བོ་མ་རྟོགས་པ་ཉིད་ན་དེ་ལྟ་ཡིན་ན་ཇི་ལྟར་འདི་ཡོད་པར་རྟོགས།",
    "དེ་ལ་ཇི་ལྟར་ཕྱིའི་དོན་སྨྲ་བ་དག་གི་ལྟར་ཕྱིས་ཀྱི་མེར་སྣང་བ་ལས་སྔར་མེ་བྱུང་བར་གྱུར་ཏོ་ཞེས་རྟོགས་པར་བྱེད་པ་དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་སྨྲ་བའི་ལྟར་ན་ཡང་བག་ཆགས་ཡོད་པར་འགྱུར་རོ་ཞེས་རྟོགས་པས་འདི་གཉིས་ལ་ཁྱད་པར་མེད་དོ།",
    "དེ་རྒྱུ་དག་ནི་ཡིན་ན་ཡང་།",
    "རང་གི་བག་ཆགས་དང་འབྲེལ་པའི་ཕྱིར།",
    "ཡང་ན་རྨི་ལམ་གྱི་ཁྱད་པར་ཉིད་ཡིན་ལ་རག་མོད།",
    "གང་གི་ངོ་བོར་སྣང་བ་ཡིས།",
    "རྣམ་པ་གཞན་ཉིད་པས་དེ་ལ་རེས་འགའ་འཛིན་པའི་རྣམ་པ་ཐ་དད་པ་ཉིད་དུ་འཛིན་པར་འགྱུར་རོ།",
    "རེ་ཞིག་མངོན་སུམ་ནི་མ་ཡིན་ཏེ།",
    "དེར་དོན་དམ་པར་ཡོད་པ་ནི་རང་གི་མཚན་ཉིད་ལ་ལྟོས་ཏེ།",
    "གང་གི་ཚེ་ཤེས་པ་རྣམ་པར་མེད་པ་ཡིན་པ་དེའི་ཚེ་ནི་དུས་ཐམས་ཅད་དུ་དག་པ་དེ་ཉིད་ཡིན་པར་འགྱུར་གྱི་གསལ་བ་དང་མི་གསལ་བ་དང་རྙོག་པའི་རང་བཞིན་ནི་མ་ཡིན་པར་འགྱུར་ན།",
    "རབ་རིབ་ཀྱིས་མིག་གི་ནུས་པ་ཉམས་པར་བྱེད་པ་རྣམས་ཀྱིས་མར་མེ་ལ།",
    "འདི་ལྟར་རེ་ཞིག་མཐོང་བའི་ནུས་པ་ཉམས་པ་རང་གི་ངོ་བོས་ནི་མངོན་སུམ་དུ་རྟོགས་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "གང་ཞིག་གཞན་གྱིས་བལྟར་མེད་པ་ཕྲ་མོ་མཐོང་བ་དེ་ནི་གཞན་གྱིས་བལྟར་ཡོད་པ་ཡོངས་སུ་གསལ་བར་མཐོང་བ་ཉིད་དུ་མཐོང་བ་ཡིན་ནོ།",
    "གང་གིས་གང་གི་ངོ་བོར་མཐོང་།",
    "རབ་རིབ་ལ་སོགས་པའི་རྣམ་པར་འགྱུར་བ་དག་གི་རྗེས་སུ་བྱེད་པ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "གཞན་ནི་གཅིག་གིས་ནུས་རྟོགས་པ།",
    "རང་གི་ངོ་བོས་ཇི་ལྟར་འཁྲུལ་པ་ཡིན་ཞེ་ན།",
    "རང་གི་ངོ་བོས་སྣང་བ་ནི་རང་རིག་པ་ཡིན་གྱི་ཡུལ་ནི་མ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོས་སྣང་བ་ཇི་ལྟར་གཞན་དུ་སྣང་བ་ཞེས་བྱ་བར་རུང་།",
    "དེ་བཞིན་དུ་གཞན་ཡང་རང་གི་ངོ་བོ་ཉིད་སྣང་བ་ཡིན་པའི་ཕྱིར་ན་རང་རིག་པ་ཉིད་དོ།",
    "རང་གི་ངོ་བོར་སྣང་བའི་ཕྱིར་ཐམས་ཅད་དེ་ལྟ་བུ་ཉིད་ཡིན་པས་ཐ་དད་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "ཚེགས་པ་གཅིག་ལ་རག་ལས་པའི་རེག་པ་ལ་སོགས་པ་མཐོང་བའི་ཕྱིར་དང་།",
    "མཚན་མོ་རྒྱུ་བ་ལ་སོགས་པ་གཞན་གྱིས་མཐོང་བའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་ནི་དེ་ལྟར་མ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ནི་བདག་ཅག་གི་འདོད་པ་ཉིད་ཡིན་ནོ།",
    "ཇི་ལྟར་མར་མེ་ལ་ལྟོས་འགྱུར་ཁྱོན་དང་ལྡན་པའི་རང་བཞིན་ནི་དེའི་ཕྱོགས་གཅིག་མེད་ཀྱང་ཕྱོགས་གཅིག་པོ་གཞན་དུ་འཛིན་པ་ཡིན་ནོ།",
    "དེ་ལ་མིག་གི་བྱེད་པ་འཇུག་པ་དེས་ན་རིག་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འབྲེལ་པ་མ་ཡིན་ཏེ།",
    "དུས་མཚུངས་པ་ཉིད་ཀྱིས་དེ་ལ་མིག་གི་བྱེད་པ་མེད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་མར་མེ་རང་གི་རྒྱུད་ལས་འོད་དང་བཅས་པ་ཡིན་པ་དེ་བཞིན་དུ་མིག་ཀྱང་མདུན་ན་ཡོངས་སུ་གསལ་བའི་རང་བཞིན་དང་ལྡན་པ་ཡིན་པས་ན་སྐྱོན་མེད་དོ།",
    "ཐ་དད་ལ་རག་མོད།",
    "འོན་ཀྱང་རང་གི་ངོ་བོ་མྱོང་བས་བྱིན་གྱིས་བརླབས་པའི་རང་བཞིན་གཉིས་པོ་དེ་ཉིད་མྱོང་བ་ཡིན་ནོ།",
    "དེ་ཉིད་རྣམ་པར་ཤེས་པའི་གཟུང་བ་ཡིན་ན་དེའི་ཚེ་དོན་རང་གི་ངོ་བོས་བཟུང་བའི་ཕྱིར་ན།",
    "མཐོང་བའི་ཡུལ་གྱི་མཚམས་ལས་མ་འདས་པ་གནས་པའི་དོན་ནི་རང་གི་རྒྱུ་བརྒྱུད་པ་ལས་གཞན་གྱི་རང་བཞིན་དང་བྲལ་བར་སྐྱེ་བ་རང་བཞིན་ངེས་པ་དང་འབྲེལ་པ་ཡིན་པའི་ཕྱིར་རང་གི་ངོ་བོ་ཉིད་སྣང་བ་ཡིན་པས་གང་གིས་གསལ་བ་དང་གཞན་པའི་རང་བཞིན་དང་འབྲེལ་པ་ཡུལ་ཉེ་བ་དང་རིང་བ་ལ་སོགས་པ་ཉིད་ཡིན་ཡང་འདི་ཐ་དད་པར་སྣང་བར་ཇི་ལྟར་འགྱུར།",
    "དེས་ན་རྣམ་པ་དང་ལྡན་པའི་ཕྱི་རོལ་ཉིད་གཟུང་བས་རང་གི་སྣང་བ་ནི་མ་ཡིན་ནོ།",
    "དེའི་རང་བཞིན་ཐ་དད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོར་སྣང་བ་དག་ཅིག་ཤོས་ཀྱི་རྣམ་པར་རྟོག་པ་ལས་མི་འདའ་བའི་ཕྱིར་རོ།",
    "སྣང་བ་ཐ་དད་ཀྱང་གལ་ཏེ་རང་གི་ངོ་བོས་སྣང་བ་ཡིན་ན་ཇི་ལྟར་མི་གསལ།",
    "སྣང་བ་ཐ་དད་ན་དེར་དེ་གཞན་གཟུང་བར་ཟད་མོད་དོན་མི་གསལ་བ་ལ་སོགས་པའི་རང་བཞིན་དུ་གོ་བ་ལྟར་འགྱུར།",
    "དེ་ལ་ཐུན་མོང་འགའ་ཞིག་ནི།",
    "ཡུལ་ཐག་རིང་བ་ཉིད་ཀྱིས་ནི་ཕྲ་མོ་ཉིད་སྒྲིབ་པར་བྱེད་ཀྱི་རགས་པའི་སྣང་བས་ནི་མ་ཡིན་ནོ།",
    "ཕྲ་མོ་ནི་ཡུལ་ཐག་རིང་པོས་བསྐལ་ན་མི་མཐོང་བ་ཉིད་དོ་ཞེ་ན།",
    "འོན་ཏེ་གཅིག་མ་ཡིན་ན་དེའི་ཚེ་ཐམས་ཅད་ཕྲ་མོ་ཉིད་ཡིན་པས་རྟོགས་པ་ཉིད་དུ་མི་འགྱུར་བའམ།",
    "གལ་ཏེ་ཡན་ལག་ཅན་གཅིག་ཡིན་ཡང་ཕྲ་མོ་དང་ལྡན་པའི་ཕྱིར་དེ་དང་བྲལ་བར་མཐོང་བ་ནི་མི་གསལ་བའི་རྣམ་པ་ཉིད་ཡིན་ན།",
    "གཞན་གྱིས་མ་མཐོང་ན་ནི་ཐུན་མོང་མ་ཡིན་པའི་ཕྱིར་རྟོགས་པ་ཉིད་ཡིན་ནོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "འདི་ལྟར་སྐྱེ་བོ་དག་བདག་གི་རྟོགས་པ་ཉིད་མི་གསལ་བར་སྐྱེས་སོ་ཞེས་རྟོགས་པ་ཡིན་ནོ།",
    "གཞན་རང་གི་ངོ་བོས་སྣང་བ་ནི་དེ་ལས་གཞན་དེ་ལྟར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོས་སྣང་ན་ནི་དམར་པོ་ཉིད་སྣང་བ་མ་ཡིན་ནོ།",
    "འདི་ནི་གྷོ་དྷ་དང་རི་བོང་གི་ཚུལ་ཡིན་ཏེ།",
    "ཉི་མ་ཤིང་གི་རྩེ་མོ་དང་འབྱར་བར་མཐོང་བ་བཞིན་ནོ་ཞེ་ན།",
    "གང་གི་ཚེ་ཁྱེད་གཞན་གྱི་ལྟ་བ་སུན་ཕྱུང་བའི་ཕྱིར་ཁྱད་ཅུང་ཟད་ཅིག་བརྗོད་པ་དེའི་ཚེ་གཞན་ཡང་ཁྱེད་ལ་སྐྱོན་སྣང་གི།",
    "མ་མཐོང་བ་ཞེས་བྱ་བ་ནི་ཚིག་གི་ལྷག་མའོ།",
    "གང་གིས་དོན་དང་དོན་མིན་བྱེད།",
    "གང་གི་ཤེས་ལས་མི་གསལ་འགྱུར།",
