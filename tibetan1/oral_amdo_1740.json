    "གཤིན་རྗེ་སྔོན་མོས་འཁྱུད་པའི་འཁོར་དུ།",
    "ཀཱ་རྡོ་རྗེ་མ་ནས་ལཱད་ྀརྡོ་རྗེ་མའི་བར་གྱི་དབོ་ཟླ་བའི་ཚེས་ཀྱི་ལྷ་མོ་ཉེར་བརྒྱད་ལྗང་གུ་ཞལ་གཅིག་ཕྱག་བཞི་མ་ཕྱག་མཚན་གཙོ་བོ་དང་མཚུངས་པས་བསྐོར་བ།",
    "འོད་ཟེར་ཅན་མ་སེར་མོ་སྟོབས་པོ་ཆེ་དང་མཚུངས་པས་འཁྱུད་པ།",
    "གཞུ་དང་ཞགས་པ་འཛིན་པ་ལ་སྐུལ་བྱེད་མ་དཀར་མོ་མི་གཡོ་བ་ལྟ་བུས་འཁྱུད་པ།",
    "ཁྲོ་གཉེར་ཅན་དམར་མོ་འདོད་རྒྱལ་དང་མཚུངས་པས་འཁྱུད་པ།",
    "རྡོ་རྗེ་ལྕགས་སྒྲོག་མ་ནག་མོ་དབྱུག་སྔོན་ལྟ་བུས་འཁྱུད་པ།",
    "ཤིན་ཏུ་སྔོན་མོ་གནོད་མཛེས་ལྟ་བུས་འཁྱུད་པ།",
    "དྲག་སྤྱན་མ་ལྗང་མོ་གཙུག་ཏོར་འཁོར་སྒྱུར་ལྟ་བུས་འཁྱུད་པ།",
    "སྐུ་དཀྱིལ་གྱི་ནང་གི་འདོད་སྣམ་ལ་ཕྱིར་འདོད་མ་སོ་དྲུག་སྟེ།",
    "གཡོན་དུ་གདུང་བར་མི་འདོད་མ་སྔོན་མོ།",
    "རེག་བྱ་མི་འདོད་མ།",
    "གཡོན་དུ་རྒྱུག་པར་མི་འདོད་མ་ལྗང་མོ།",
    "གཡོན་དུ་རོལ་མོ་མི་འདོད་མ་སྔོན་མོ།",
    "ནུབ་སྒོའི་གཡས་སུ་རེངས་པར་མི་འདོད་མ།",
    "ཤར་གྱི་ཀུན་ནག་མོ།",
    "ལྷོའི་དམར་མོ།",
    "བྱང་གི་དཀར་མོ།",
    "ནུབ་ཀྱི་སེར་མོ་རྣམས་རང་རང་གི་ཕྱག་མཚན་ཐོགས་པའོ།",
    "སྐུ་དཀྱིལ་གྱི་ཕྱིའི་རྟ་བབས་འོག་གི་སྟེགས་བུ་ལ་ཀླུ་རྣམས་དགོད་པར་བྱ་སྟེ།",
    "མཁའ་ལྡིང་གདོང་མ་སེར་མོས་འཁྱུད་པ།",
    "ཀླུ་ནོར་རྒྱས་དང་དུང་སྐྱོང་དམར་པོ་ལ་སྟག་གདོང་མ་དང་འུག་གདོང་མ་དཀར་མོས་འཁྱུད་པ་བྱང་སྒོའི་གཡོན་དང་གཡས་ཀྱི་སྟེགས་བུར་ཆུ་དཀྱིལ་དཀར་པོ་ཟླ་གམ་པདྨས་མཚན་པ་རེ་རེར།",
    "ཕག་གདོང་མ་དང་བྱ་རྒོད་གདོང་མ་དམར་མོས་འཁྱུད་པ།",
    "ནུབ་སྒོའི་གཡོན་དང་གཡས་སུ་ས་དཀྱིལ་སེར་པོ་གྲུ་བཞི་རྡོ་རྗེས་མཚན་པ་རེ་ལ།",
    "ཁྱི་གདོང་མ་དང་བྱ་རོག་གདོང་མ་ནག་མོས་འཁྱུད་པ་སྟེང་དུ་ནམ་མཁའི་དཀྱིལ་འཁོར་ལྗང་གུ་ཟླུམ་པོ་ལ།",
    "འོག་ཏུ་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་སྔོན་པོ་ཟླུམ་པོ་ལ་ཀླུ་རྣམ་པར་རྒྱལ་བ་སྔོན་པོར་རོ་ལངས་མ་ཤིན་ཏུ་སྔོན་མོ་ཁ་དོག་ལྗང་གུས་འཁྱུད་པ།",
    "བསེ་ཡི་སྟེང་དུ་འཁོར་ལོ་རྩིབས་བརྒྱད་དམར་པོའི་ལྟེ་བར་ཁྱི་གདོང་མ་ནག་མོར་འཇོག་པོ་སེར་པོས་འཁྱུད་པ།",
    "ཁྭ་གདོང་ནག་མོར་པད་ཆེན་སེར་པོས་འཁྱུད་པ།",
    "ཕག་གདོང་དམར་མོར་མཐའ་ཡས་དཀར་པོས་འཁྱུད་པ།",
    "ལྷོ་ནུབ་དྲག་པོའི་གཡུལ་གྱི་དུར་ཁྲོད་དུ་ཁྲུང་ཁྲུང་གི་སྟེང་དུ་འཁོར་ལོ་རྩིབས་བརྒྱད་དཀར་པོའི་ལྟེ་བར།",
    "བྱ་རྒོད་གདོང་མ་དམར་མོ་ལ་རིགས་ལྡན་དཀར་པོས་འཁྱུད་པ།",
    "སྟག་གདོང་དཀར་མོར་ནོར་རྒྱས་དམར་པོས་འཁྱུད་པ།",
    "བྱ་མ་བྱིའི་སྟེང་དུ་འཁོར་ལོ་དཀར་པོ་རྩིབས་བརྒྱད་པའི་ལྟེ་བར་འུག་གདོང་མ་དཀར་མོར་དུང་སྐྱོང་དམར་པོས་འཁྱུད་པ།",
    "ནུབ་ཕྱོགས་རྣག་གི་དྲི་ཡི་དུར་ཁྲོད་དུ་སེང་གེའི་གདན་ལ་འཁོར་ལོ་དམར་པོ་རྩིབས་བརྒྱད་པའི་ལྟེ་བར།",
    "ཅེ་སྤྱང་གདོང་མ་སེར་མོར་སྟོབས་རྒྱུ་ནག་པོས་འཁྱུད་པ།",
    "ནུབ་བྱང་སྦྲུལ་གྱིས་ཟོས་པའི་དུར་ཁྲོད་དུ་མིག་སྔོན་གྱི་གདན་སྟེང་འཁོར་ལོ་དཀར་པོ་རྩིབས་བརྒྱད་པའི་ལྟེ་བར་མཁའ་ལྡིང་གདོང་མ་སེར་མོ་ལ་པདྨ་ནག་པོས་འཁྱུད་པ།",
    "སྟེང་གི་ཕྱོགས་སུ་ཤིང་རྟ་ལྗང་གུ་ལ་སྔོན་མོ་ལྗང་གུར་རྣམ་རྒྱལ་སྔོན་པོས་འཁྱུད་པ།",
    "འོག་གི་ཕྱོགས་སུ་ཤིང་རྟ་སྔོན་པོ་ལ་རྡོ་རྗེའི་མིག་མ་སྔོན་མོར་རྒྱལ་བ་ལྗང་གུས་འཁྱུད་པ།",
    "བྷྲཱིཾ་གི་ཎ་ལ་སོགས་པ་འབྱུང་པོ་བྱེ་བ་ཕྲག་ཕྱེད་བཞི་དང་བཅས་པ་གནས་པའོ།",
    "དེ་ལྟར་ལྷ་ཆེན་པོ་བཅུ་གཉིས་སོ་སོའི་ཤེས་རབ་མ་དང་བཅས་པའི་འཁོར་དུ་ཚེས་ཀྱི་ལྷ་མོ་རྣམས་ཀྱིས་བསྐོར་བའི་ཚེས་ལྷ་སུམ་བརྒྱ་དྲུག་ཅུ་དང་།",
    "ལས་རྒྱལ་མཆོག་གི་སྐབས་འདིར་ཡང་དམ་ཚིག་གི་དཀྱིལ་འཁོར་རྣམས་མི་བསྡུ་བར་མངལ་ནས་ལྷ་སྤྲོས་པ་དེ་སོ་སོར་བསྟིམ་པར་མཛད་པའང་ཡོད་མོད་བསྡུས་ནས་སླར་བསྐྱེད་པ་འདི་ཤིན་ཏུ་ལེགས་ཤིང་རྒྱུད་ཀྱི་དགོངས་པར་གནས།",
    "གཞན་དཀྱིལ་འཁོར་རྒྱལ་མཆོག་གི་སྐབས་ནས་བསྟན་པ་བཞིན་བསྐྱེད་པར་བྱས་ཀྱང་ཆོག་ལ།",
    "ལྷ་རེ་རེ་བཞིན་དུ་ཞལ་ཕྱག་ཕྱག་མཚན་གསལ་འདེབས་སྦྱར་བར་འདོད་ནའང་དེ་ལྟར་བྱ།",
    "ཐུགས་དཀྱིལ་གྱི་སྐབས་སུ་ལྷ་ཡབ་ཟུང་རེ་དང་ཡུམ་ཟུང་རེ་མཉམ་བསྐྱེད་བྱས་ནས་ཕན་ཚུན་འཁྱུད་པ་ཕྱོགས་གཉིས་སུ་འགོད་པ་ལྟར་རང་བློར་གང་བདེ་བསྒོམ་རུང་མོད་ཀྱི།",
    "དོན་དུ་རྒྱ་བོད་ཀྱི་ལུགས་འདིའི་ཤིང་རྟ་ཆེན་པོ་རྣམས་ཀྱི་དགོངས་པ་རྨ་མེད་པ་གསལ་བར་བྱས་པ་ཡིན་ནོ་ གསུམ་པ་དཀྱིལ་འཁོར་དེ་དག་གི་རྣམ་དག་དྲན་པ་ནི།",
    "གཏུམ་མོ་རྣམས་སྤྲུལ་པའི་སྐུའོ།",
    "བཛྲ་ཀཱ་མཾ་པྲ་ཏཱི་ཙྪ་ན་མ་ཞེས་ལྷ་མོ་བཅུ་གཉིས་ཀྱིས་མཆོད་ནས།",
    "ཞེས་བརྗོད་པས་བགེགས་མཐར་བྱེད་ཀྱིས་རོ་མཉམ་དུ་བྱས་པར་བསམ་མོ།",
    "རྡོ་རྗེ་ནོར་བུའི་རྩེ་མོར་ཨ་ཡེ་ཤེས་ཀྱི་རྒྱས་གདབ་བོ།",
    "གཙུག་ཏོར་དུ་ནམ་མཁའ་ལ་ཨ་སྟེ་རང་བྱུང་གི་དབྱངས་ལྔ་གསུང་གི་རྒྱས་གདབ་བོ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་རྡོ་རྗེ་འཁོར་ལོ་པདྨ།",
    "སླར་ཡང་རང་གི་མདུན་གྱི་ནམ་མཁར་བཞུགས་པ་ལ།",
    "རྡོ་རྗེ་གསུམ་གྱི་ལྷ་ཚོགས་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབས་ཏེ་རང་གི་གནས་གསུམ་དུ་འདུས་ཤིང་འཁོད་པར་བསམས་ལ།",
    "གསུང་གི་རྡོ་རྗེ་ཅན་གྱིས་ནི།",
    "ཞེས་བརྗོད་པས་སྒོ་གསུམ་སྐུ་གསུང་ཐུགས་རྡོ་རྗེའི་བདག་ཉིད་དུ་གྱུར་པར་བསམ་མོ།",
    "རང་གི་དཔྲལ་བར་ཨོཾ་ལས་སྐུ་རྡོ་རྗེ།",
    "གཙུག་ཏོར་དུ་ཧཱ་ལས་ཐུགས་རྡོ་རྗེ་རྣམས་རང་རང་གི་ཤེས་རབ་མ་དང་བཅས་པ་འཁོད་པ་ལས།",
    "སེམས་དཔའ་སེམས་མ་ཁྲོ་བོ་ཁྲོ་མོའི་ཚོགས་རྣམས་བཛྲ་ས་མཱ་ཛ་ཞེས་རྡོ་རྗེ་བསྡུ་བའི་ཕྱག་རྒྱ་བཅས་སྤྱན་དྲངས་ལ།",
    "དེ་དག་གི་ཡུམ་རྣམས་དང་མི་བསྐྱོད་པ་ལ་རྡོ་རྗེ་སེམས་དཔའ་སྔོན་པོ་ས་གནོན་གྱི་ཕྱག་རྒྱ་ཅན་གྱིས་རྒྱས་བཏབ།",
    "རང་རང་གི་རིགས་ཀྱི་བདག་པོས་རྒྱས་འདེབས་ཏེ།",
    "རྡོ་རྗེ་ནོར་བུར་གཞོམ་མེད་ཨ་ཡིག་གིས་རྒྱས་གདབ་རྣམས་ཇོ་ལུགས་སྐབས་འདིར་གསུངས།",
    "ཤེས་རབ་ཀྱི་མཁའ་ཨཱ་ལས་པདྨ་དམར་པོ་འདབ་མ་བརྒྱད་པ་ལ་ཧཱུྃ་ལས་སྐྱེས་པའི་རྡོ་རྗེ་སྔོན་པོ་ཕྲ་མོས་མཚན་པ།",
    "རང་གི་རྡོ་རྗེ་ཧཱུྃ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པ།",
    "ཡབ་ཡུམ་སྙོམས་པར་ཞུགས་པས་ལྟེ་བའི་ཧོ་ཡིག་ལས་གློག་དང་མཚུངས་པའི་གཏུམ་མོ་ཡེ་ཤེས་ཀྱི་མེ་འབར་བས།",
    "བཞི་པ་བདེ་བ་རྫོགས་པ་སྒྲུབ་པ་ཆེན་པོའི་ཡན་ལག་ཕྲ་མོའི་རྣལ་འབྱོར་ནི།",
    "དྲང་དོན་བསྐྱེད་རིམ་ལ་བརྟེན་པའི་ཕྲ་མོའི་རྣལ་འབྱོར་རོ།",
    "སོགས་ལྷ་མོ་བཅུ་གཉིས་ཀྱིས་མཆོད།",
    "རང་གིས་ཀྱང་མྱང་པས་ལུས་ཀྱི་ལྷ་རྣམས་མཉེས་པར་བསམས་ལ།",
    "མཆོག་གི་ཕྱག་རྒྱར་རབ་ཏུ་སྦྱོར།",
    "གཡོན་པའི་སོར་མོ་རྣམས་པདྨ་འདབ་མ་ལྔ་པའི་ལྟེ་བར།",
    "ཨོཾ་པ་དེ་པ་དེ་མ་ཧཱ་ཛྙཱ་ནཾ་སརྦ་བུདྡྷ་མ་ཧཾ་བྷེ་ཏ།",
    "ལྷ་རྣམས་ཀྱི་ཐུགས་ཀར་རང་རང་གི་ས་བོན་གྱི་མཐར་སྔགས་བཀོད་དེ་ལས་དང་རྗེས་སུ་མཐུན་པའི་དམིགས་པ་དང་ལྡན་པས།",
    "རྒྱས་པར་མཚན་གྱི་ཐོག་མ་ཀཱ་ཡི་ཀླད་ཧ་སོགས་ཀྱི་མནན་ཅིང་མཐའ་རྟེན་སོ་སོ་བཅས་པ་དྲུག་པོར་འབུམ་རེ་རེ་བཅུ་ཆའི་ཁ་སྐོང་གི་སྦྱིན་སྲེག་བཅས་བཟླ་བ་ནི།",
    "ཐུགས་ཀྱི་བཟླས་པ་སྟེ་ལྷ་མྱུར་དུ་འགྲུབ་པའི་མན་ངག་གི་བཟླས་པའོ།",
    "ཇོ་ནང་རྗེ་བཙུན་ཆེན་པོས་འཁོར་གྱི་སྔགས་ནི་རང་རང་གི་མཚན་སྔགས་ཀྱང་སྔགས་སུ་འགྱུར་མོད་ཀྱི།",
    "རྒྱས་པར་སྤྲོ་ན་མཆོད་ཕྲེང་གི་ནང་བཞིན།",
    "དམ་ཚིག་གི་དཀྱིལ་འཁོར་རྣམས་རང་ཉིད་དུས་ཀྱི་འཁོར་ལོའི་གཙུག་ཏོར་དུ་རྡོ་རྗེ་རྩེ་མོ་ལྔ་པའི་ལྟེ་བར་བདེ་བ་ཆེན་པོའི་འཁོར་ལོ་རྣམས་གཤེགས།",
    "དཔྲལ་བར་རྡོ་རྗེ་རྩེ་མོ་བཅུ་བདུན་པའི་ལྟེ་བར་བདེ་གཤེགས་ཡབ་ཡུམ་དང་།",
    "མགྲིན་པར་རྡོ་རྗེ་རྩེ་མོ་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྟེ་བར་སེམས་དཔའ་སེམས་མ་ཐུགས་ཀྱི་སྒོ་བ་དང་བཅས་པ་གཤེགས།",
    "ལྟེ་བར་རྡོ་རྗེ་རྩེ་མོ་དྲུག་ཅུ་རྩ་ལྔ་པའི་ལྟེ་བར་གསུང་གི་རྣལ་འབྱོར་མ་འཁོར་དང་བཅས་པ་རྣམས་གཤེགས།",
    "གསང་བར་རྡོ་རྗེ་རྩེ་མོ་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྟེ་བར་སྐུའི་སྒོ་སྐྱོང་རྣམས་དང་།",
    "ལས་ཀྱི་འཁོར་ལ་ཚིགས་ཆེན་བཅུ་གཉིས་པོ་རྡོ་རྗེ་རྩེ་མོ་སུམ་ཅུ་རྩ་གཅིག་པ་རྣམས་ཀྱི་ལྟེ་བར་ལྷ་ཆེན་པོ་བཅུ་གཉིས་འཁོར་དང་བཅས་པ་གཤེགས།",
    "བྱ་བའི་འཁོར་ལོ་རྐང་ལག་གི་སོར་མོའི་ཚིགས་རྣམས་རྡོ་རྗེ་རྩེ་མོ་བདུན་པར་བྱས་པའི་ལྟེ་བར་ཀླུ་དང་རབ་གཏུམ་མ་རྣམས་གཤེགས་སུ་གསོལ་ཞིང་གཞལ་ཡས་ཁང་རྟེན་གཞི་དང་བཅས་པ་རང་ལ་ཐིམ།",
    "རང་གི་ལྟེ་བར་ཧྲལཱ་ྀ།",
    "གསང་གནས་སུ་ཧྲཱ་བཀོད་པའི་ཡན་ལག་དྲུག་གི་གོ་ཆ་བགོས་ཏེ་དཀྱིལ་འཁོར་གྱི་གཙོ་བོའི་རྣམ་པས་ལངས་ནས།",
    "ཉལ་བའི་ཚེ་རང་གི་འཁོར་ལོ་དྲུག་གི་གནས་སུ་ཧྲཱཾ་སོགས་དྲུག་དང་།",
    "མཐར་ཐུག་མཆོག་གི་དངོས་གྲུབ་འགྲུབ་པ་ནི་ངེས་པའོ།",
    "གོ་རིམ་དང་སྐབས་མ་འབྲེལ་བ་སོགས་ཀྱི་ཚིག་གིས་བརྗོད་པའི་གནས་སྐབས་དེར་བསྒོམ་དོན་བདེ་བླག་ཏུ་གསལ་དཀའ་བ་ལྟ་བུའི་སྐྱོན་མེད་པའི་ཆོ་ག་གསལ་བའི་ཚིག་གི་དོན་ལ་བསམ་ན་ཚིག་ཉུང་ཡང་དོན་གོ་བ་ཉིད་གཙོ་ཆེ་ཡི་འདོན་རྒྱུའི་ཚིག་མང་བ་མི་གཙོ་ཞིང་།",
    "སྤྱིར་ལས་དང་པོ་པས་ཚིག་བརྗོད་པའི་རྗེས་སུ་ཞུགས་པའི་སྤྱིའི་རྣམ་པ་ལ་བསམས་ནས་དེ་ལྟར་ཡིན་ནོ་སྙམ་པའི་མོས་སྒོམ་གྱིས་ཀྱང་གོ་ཅུང་ཟད་མི་ཆོད་པ་ཡང་མ་ཡིན་ལ།",
    "བསྒོམ་དོན་རང་ཤེས་པས་ཆོག་གི་ཚིག་འབའ་ཞིག་ལ་མི་ལྟོས་སོ།",
    "ན་མོ་མཉྫུ་ཤྲཱིཛྙཱ་ན་སཏྭཱ་ཡ།",
    "ཕྱིར་འདོད་མ་སོ་དྲུག་ཕྱིའི་རྟ་བབས་ཀྱི་འོག་གི་སྟེགས་བུ་དང་སྟེང་དང་འོག་ཏུ་ཀླུ་ཆེན་པོ་བཅུ་ཤེས་རབ་མ་དང་བཅས་པ་སྟེ་སྐུ་དཀྱིལ་གྱི་གཞལ་མེད་ཁང་ལ་གནས་པ་རྣམས་དང་།",
    "རང་གི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པས་རང་བཞིན་གྱི་གནས་ནས་དཔལ་དུས་ཀྱི་འཁོར་ལོའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས།",
    "གྲོགས་བཅས་གཉེན་རྣམས་དག་གིས་བསྐོར་བའི་ཚོགས་པ་ནི།",
    "ལྷ་དང་ལྷ་མོ་དག་གིས་མཉེས་པར་བྱེད་རྣམས་དང་།",
    "མཆོག་གི་རྡོ་རྗེ་སེམས་དཔའ་དག་ནི་གཤེགས་སུ་གསོལ།",
    "ཞེས་བརྗོད་པས་དམ་ཚིག་གི་འཁོར་ལོ་ལ་རྟེན་དང་བརྟེན་པར་བཅས་པ་དགུག་གཞུག་བཅིང་མཉེས་རོ་མཉམ་པར་བསམ་མོ།",
    "ཨོཾ་ཤྲཱི་ཀཱ་ལ་ཙཀྲ་ས་པ་རི་ཝཱ་རེ་བྷྱ་བཛྲ་ཨརྒྷཾ།",
    "གླུ་མ་འདོད་མ་ལྷ་མོ་བཅུ་གཉིས་ཀྱིས།",
    "ཨོཾ་ཤྲཱི་ཀཱ་ལ་ཙཀྲ་ས་པ་རི་ཝཱ་རེ་བྷྱ་བཛྲ་གནྡྷཾ།",
    "ཨོཾ་ཤྲཱི་ཀཱ་ལ་ཙཀྲ་ས་པ་རི་ཝཱ་རེ་བྷྱ་ཨ་ནུཏྟ་ར་པཱུ་ཛ་མེ་གྷ་ས་མུ་དྲ་སྥ་ར་ཎ་ཨི་མཾ་ག་ག་ན་ཁཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཨོཾ་བཛྲ་རེ་ཁེ་ཨཱ་ཧཱུྃ།",
    "རང་གི་ལག་པ་གཡོན་པའི་མཐིལ་དུ་ཟླ་བ་ལ་གནས་པ་སྐུ་རྡོ་རྗེའི་ངོ་བོ་ཨོཾ་དཀར་པོའི་འོད་ཀྱིས་རྫས་རྣམས་ཀྱི་མ་དག་པ་སྦྱང་།",
    "མཁའ་ལྡིང་གི་ཕྱག་རྒྱའི་དབུས་སུ་དུས་མེ་ལ་གནས་པའི་ཡེ་ཤེས་རྡོ་རྗེའི་ངོ་བོ་ཧོ་ཡིག་སེར་པོའི་འོད་ཀྱིས་ཟག་མེད་བདེ་བ་ཆེན་པོའི་རང་བཞིན་དུ་གྱུར།",
    "རིགས་དྲུག་གི་བདེ་གཤེགས་ཡབ་ཡུམ་བཅུ་གཉིས།",
    "ཞེས་འབུལ་ཞིང་རང་གིས་ཀྱང་མྱང་བས་ལུས་ཁམས་ཀྱི་ལྷ་ཐམས་ཅད་བདེ་སྟོང་གིས་ཚིམ་པར་བསམ་ལ།",
    "མཆོག་གི་ཕྱག་རྒྱར་རབ་ཏུ་སྦྱོར།",
    "རྣམ་པ་ཀུན་གྱི་མཆོག་ལྡན་མ་ ཕྱག་རྒྱ་ཆེན་མོ་དེ་ལ་འདུད།",
    "ཤེས་དང་ཤེས་བྱ་གཅིག་གྱུར་རྒྱལ་བ་མཆོག་གི་དམ་ཚིག་ཡན་ལག་རྣམ་པ་བཅུ་གཉིས་ཀྱི།",
    "རེག་བྱ་གཟུགས་དང་སེམས་མེད་རང་བཞིན་དང་ནི་སྐྱེས་བུ་མེད་ཅིང་འཆིང་དང་གྲོལ་དང་བྱེད་པོ་མེད།",
    "ནུས་པ་ངོ་བོ་གློག་གི་མེ་དང་མཚུངས་ཤིང་ཉི་མ་བཅུ་གཉིས་དག་གི་གཟི་བྱིན་ཅན།",
    "དམ་པ་རྣམས་ལ་ཞི་བའི་གཟུགས་ནི་རང་གིས་བྱས་པའི་ཉམས་མྱོང་མི་བཟད་རྣམས་ལ་མི་བཟད་པ།",
    "གང་གིས་ལས་གང་རབ་བྱས་རང་གི་སེམས་ལ་ཆོ་ག་བཞིན་དུ་དེ་ཡི་འབྲས་བུ་དེ་སྐྱེད་པ།",
    "སྟེང་འོག་ཀུན་ནས་དཀར་ལྗང་སྣ་ཚོགས་ཁ་དོག་ཆེན་པོ་གཅིག་གི་གཟུགས་ཏེ་ཐུང་ངུ་རིང་པོ་དང་།",
    "ཤིན་ཏུ་རིང་པོ་ཡོན་ཏན་མེད་ཅེས་ཡོན་ཏན་དང་བཅས་བུད་མེད་སྐྱེས་པའང་སྐྱེས་པ་བུད་མེད་མིན།",
    "གང་ཞིག་ཀུན་གྱི་རྟེན་གཅིག་བྷ་ག་བཟང་མོ་མཆོག་གི་བྷ་ག་ཁྱོད་ལ་འདུད་དེ་ཁྱོད་ལ་འདུད།",
    "ཅེས་རང་གི་ཡིད་ལ་གང་འདོད་པའི་དོན་དེ་ཉིད་ཀྱི་ཆེད་དུ་གསོལ་བ་གདབ་པ་སོགས་ཀྱང་མོས་པ་ལྟར་བྱའོ།",
    "ཁྱོད་ནི་སྲིད་པ་གསུམ་ལས་འདས་ཀྱང་སྲིད་པ་གསུམ་གྱི་རྣམ་པ་ཅན།",
    "ཁྱོད་ནི་མགོན་པོ་ཁྱོད་ནི་བྱེད་པོ་ཕན་དང་སྡིག་འཕྲོག་ཁྱོད་ནི་གོ་འཕང་ཕུན་སུམ་ཚོགས་པ་ཡང་།",
    "ཁྱོད་ནི་འབའ་ཞིག་གནས་དང་ཁྱོད་ནི་ཡོན་ཏན་མཆོག་གི་གནས་ཏེ་སྐྱོན་རྣམས་བཅོམ་པ་ཁྱོད་ཉིད་དོ།",
    "ལྷ་རྣམས་མགོ་ཡི་གཙུག་གི་ནོར་བུའི་འོད་ཟེར་ཚོགས་ཀྱིས་ཞབས་ཀྱི་པདྨ་ལ་གཏུགས་ཤིང་།",
    "སྐྱེས་བུ་གང་དག་བདུད་ཀྱི་གྲོགས་ཀྱིས་རྟག་ཏུ་མི་བདེན་མུན་པར་སོང་ཞིང་ལམ་ཉམས་པ།",
    "ཡེ་ཤེས་ཐོབ་ནས་མི་ཟད་མཆོག་གི་གནས་སུ་རབ་བགྲོད་སླར་ཡང་གང་དུའང་སྐྱེ་ལྡན་མིན་གྱུར་ཅིག།",
    "དབུལ་དང་བུད་མེད་བྲལ་དང་མི་བདག་འཁྲུགས་པས་འཇིགས་པ་དང་ནི་རྡོ་རྗེ་ལྷུང་དང་དོན་ཉམས་པ་ གང་ཞིག་རྣལ་འབྱོར་མ་རྣམས་ཞབས་ནི་བདག་གིས་གསལ་བར་དྲན་པའི་མཐུ་ལས་རབ་ཏུ་ཉམས་གྱུར་ཅིག།",
    "མི་ཡི་འཇིག་རྟེན་དག་ན་ཕྱོགས་དང་ཕྱོགས་བྲལ་དུ་གནས་ཁྲོ་བོའི་རྒྱལ་པོ་བཙུན་མོར་བཅས་རྣམས་དང་།",
    "བདེན་པ་དེ་ཡིས་ལྷ་མོ་དེ་དག་གིས།",
    "བསྟོད་པར་འོས་པ་སོགས་ཚིགས་བཅད་གཅིག་གིས་བསྟོད་ནས།",
    "དམ་ཚིག་གི་དཀྱིལ་འཁོར་རྣམས་རང་ཉིད་དུས་ཀྱི་འཁོར་ལོའི་གཙུག་ཏོར་དུ་རྡོ་རྗེ་རྩེ་ལྔ་པའི་ལྟེ་བར་བདེ་ཆེན་གྱི་འཁོར་ལོ་རྣམས་གཤེགས།",
    "དཔྲལ་བར་རྡོ་རྗེ་རྩེ་མོ་བཅུ་བདུན་པའི་ལྟེ་བར་བདེ་གཤེགས་ཡབ་ཡུམ་རྣམས་གཤེགས།",
    "མགྲིན་པར་རྡོ་རྗེ་རྩེ་མོ་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྟེ་བར་སེམས་དཔའ་སེམས་མ་ཐུགས་ཀྱི་སྒོ་བ་དང་བཅས་པ་གཤེགས།",
    "ལྟེ་བར་རྡོ་རྗེ་རྩེ་མོ་དྲུག་ཅུ་རྩ་ལྔ་པའི་ལྟེ་བར་གསུང་གི་རྣལ་འབྱོར་མ་རྣམས་གཤེགས།",
    "གསང་བར་རྡོ་རྗེ་རྩེ་མོ་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྟེ་བར་སྐུའི་སྒོ་བ་རྣམས་གཤེགས།",
    "བྱ་བའི་འཁོར་ལོ་རྐང་ལག་གི་སོར་ཚིགས་རྣམས་རྡོ་རྗེ་རྩེ་མོ་བདུན་པར་བྱས་པའི་ལྟེ་བར་ཀླུ་དང་རབ་གཏུམ་མ་རྣམས་གཤེགས་སུ་གསོལ་ཞིང་གཞལ་ཡས་ཁང་རྟེན་གཞི་དང་བཅས་པ་རང་ལ་ཐིམ།",
    "རང་གི་ལྟེ་བར་ཧྲལཱྀ།",
    "བཙུན་མོའི་ཁུ་བ་མཉམ་ཟས་ཅན།",
    "གང་གིས་ལམ་གྱིས་འགྲོ་འགྱུར་བ།",
    "ཤེས་རབ་རང་བཞིན་དཀྱིལ་འཁོར་གཙོ་མོ་མཆོག།",
    "རྩ་འདབ་རྣམ་དག་ལྷ་མོས་ཡོངས་བསྐོར་བ།",
    "ཚེས་ཀྱི་ལྷ་མོ་རྣམས་ཀྱིས་ཡོངས་བསྐོར་བ།",
    "ཀླུ་དང་གཏུམ་མོ་བཅུ་བཅུ་ཟུང་འཇུག་པ།",
    "དོན་གཉིས་མི་ཟད་བཀྲ་ཤིས་རི་མོ་དང་།",
    "གཏུམ་མོ་སོགས་དང་བཅས་པའི་བཀྲ་ཤིས་ཤོག།",
    "གསུང་གི་དཀྱིལ་འཁོར་ལྷ་ཡི་བཀྲ་ཤིས་ཤོག།",
