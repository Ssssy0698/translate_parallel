    "རང་གི་སེམས་གོང་ནས་གསུངས་པའི་དཀྱིལ་འཁོར་འཁོར་ལོ་ལ་གནས་པ་མི་མཐུན་པ་བཅོམ་པ་དེ་ལྟ་བུ་ཞེས་སོ།",
    "ལས་དང་པོ་པ་ཞེས་པ་ནི་འདི་ལས་རྣལ་འབྱོར་པའི་བྱེ་བྲག་གིས་ལས་བཞིར་སྟོན་པ་ལས་དང་པོ་པའི་ལས་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་བསམ་གཏན་དང་བྱ་བས་བསྐལ་པ་སྟེ་རང་རང་གི་ལས་ཀྱིས་བསྟན་པའི་མཚན་མ་མཐོང་ཞིང་རྙེད་པའོ།",
    "རང་གི་ལས་གསུངས་པ་མིག་ཅེས་པ་ལ་སོགས་པ་སྟེ།",
    "འཁྲུལ་མེད་ཅེས་པ་ནི་བརྟན་པ་མ་ཡིན་པས་ཐིག་ལེ་དང་ཕྲ་མོ་ནན་ཏན་དུ་བྱ་བ་མ་ཡིན་ནོ།",
    "དེ་ལྟར་རང་གི་འཁོར་གནས་སོགས་བསྟན་པ་བྱས་ནས་ཞེས་བྱ་བའི་སྒྲ་ཡི་དོན་བསྟན་ནས།",
    "པདྨའི་སྡོང་པོ་རྒྱ་ཁྱོན་རབ་ཏུ་ཡངས་པ་སྐྱེས་པ་ལ།",
    "མེ་ཏོག་ཉི་ཤུ་རྩ་ལྔ་ཡོད་པའི་མེ་ཏོག་རེ་རེའི་སྟེང་དུ་འཇིག་རྟེན་གྱི་ཁམས་རེ་རེ་ཡོད་པར་གསུངས་པའི་ཡས་མར་གང་ནས་ཀྱང་པདྨ་བཅུ་གཉིས་རེ་བརྩིས་པའི་དབུས་བཅུ་གསུམ་པ།",
    "༡ ནམ་མཁའ་། ལ་དཔག་ཚད་འབུམ་དུ་ཉི་མ་གཅིག་གིས་ཐོགས་པ་མེད་པར་འགྲོ་བ།",
    "༢ རྒྱལ་པོ་གླིང་གང་དུ་འགྲོ་བའི་ཚེ་འཁོར་ལོ་དེའང་སྔོན་དུ་ནམ་མཁར་འགྲོ་ཞིང་དཔུང་ཚོགས་ཡན་ལག་བཞིའང་ཕྱི་བཞིན་དུ་ནམ་མཁར་འགྲོ་བ།",
    "༣ གླང་པོ་ཆེ་སྟོང་གི་སྟོབས་དང་ལྡན་པས་གཞན་གྱིས་གདུལ་དཀའ་བ་དང་།",
    "༦ ཁ་དོག་ཐལ་ཀར་དུ་སྣང་ཞིང་༧རྒྱུསྐུད་པས་ཀྱང་བཀྲིར་ནུས་པ་དང་།",
    "༣ ཚིག་ཅལ་ཅོལ་མེད་ཅིང་རྒྱལ་པོའི་སྲིད་ངང་གིས་མཐོ་བར་འགྱུར་༤ ལོག་པར་ལྟ་བ་མེད་པའོ།",
    "༣ ཉོན་མོངས་དང་ཕྲག་དོག་དང་གནོད་སེམས་མེད་པའོ།",
    "༦ ཉོན་མོངས་པ་དུག་གསུམ་སྤངས་པ།",
    "རེག་འཇམ་གཟིམ་ཆ་འདི་ཡིས་ཐོབ་པར་འགྱུར།",
    "མཎྜལ་མེ་ཏོག་བཅས་ཐལ་མོས།",
    "ཡང་ཚོམ་བུ་བདུན་མའི་སྟེང་མེ་ཏོག་སོགས་བཞི་བསྣན་པའི་བཅུ་གཅིག་པ།",
    "ལྷ་མོ་གོས་དཀར་མོ་དང་ནི།",
    "དཀར་མོ་ཆེན་མོ་གཞན་ཕན་བརྩོན།",
    "ཉི་མ་བཟུང་བ་སོགས་སྐྱེ་བ་གསུམ་ན་མཆོག་གི་དངོས་གྲུབ་མཛད།",
    "ཟིན་ཤིང་གི་སྟོན་པ་བཅུ་བདུན་བཏུལ།",
    "གངས་ལྡན་རེ་ལས་ས་དུམ་བུ་དྲུག་གོ།",
    "བརྡ་སྤྲོད་གཞུང་གི་བརྗོད་བྱ་ཡིན།",
    "དེ་བཞིན་རི་མོ་སྒྱུ་རྩལ་གཙོ།",
    "དེ་རྣམས་ཀྱིས་ནི་སྙན་ངག་གི།",
    "རྩེ་མོར་ཕྱིན་དང་མཐར་གྱིས་པ།",
    "གང་ཞིག་གང་གིས་ཆགས་བྲལ་བ།",
    "ཇི་ལྟ་ཇི་སྙེད་ནང་གི་ནི།",
    "ཡེ་ཤེས་གཟིགས་པ་དག་པའི་ཕྱིར།",
    "ཁམས་གསུམ་ཀུན་ནས་ཉོན་། མོངས་སྤོང་བྱེད་གསུང་།",
    "གང་ཞིག་རྒྱལ་བ་སྟོན་པ་འབའ་ཞིག་གི།",
    "ལྔ་པས་ཉོན་མོངས།",
    "བརྒྱད་པས་ཐུན་མོང་པའི་ཡོན་ཏན་བསམ་གཟུགས་སོགས། ། ཐམས་ཅད་མཁྱེན་པ་ཡེ་ཤེས་སྐུ་དང་ཉིན་མོར་བྱེད་པའི་སྐུ་སྟེ་པདྨའི་འདབ་མ་རྒྱས་པའི་སྤྱན།",
    "རྣལ་འབྱོར་དཔལ་ལྡན་དུས་འཁོར་ཨ་ཕྲེང་ལྡན་པའི་ཀ་འདུས་ལ་སྟེ་མི་རྣམས་དགྲོལ་བའི",
    "ལུང་གི་དུས་ཡོངས་རྫོགས།",
    "ཁྱོན་ལོ་ཉིས་སྟོང་ཉིས་བརྒྱ་དང་གཉིས་གནས་པ།",
    "རབ་བྱུང་བཅུ་བཞི་པའི་དོན་གྲུབ་ཅེས་པ་ས་མོ་ལུག་གི་ལོ།",
    "རེས་གཟའ་ལྷག་པ་དང་རྒྱུ་སྐར་གྱི་རྒྱལ་པོ། ། བདེ་མཆོག་སྙན་བརྒྱུད་དུ་གྲགས་པ་ནི།",
    "གང་ཟག་སྙན་ཁུང་གི་བརྒྱུད་པ་སྟེ་བཞི་ལྡན་དུ་མཛད་དོ།",
    "ཟབ་པ་དང་རྒྱ་ཆེ་བ་ཟུང་དུ་འཇུག་པའི་དམ་ཚིག་གསུམ་མོ།",
    "གཏུམ་མོ་བདེ་དྲོད་རང་འབར།",
    "ཐུན་མོང་མ་ཡིན་པ་གཉིས་ལས།",
    "ཉི་ཟླ་སྐར་གསུམ་མཁའ་ལ་གནས་ཀྱང་ཉི་མའི་འོད་ཀྱིས་ཟིལ་མནན་པས་དེ་དག་གི་འོད་ཀྱི་བྱ་བ་མི་སྣང་བ་ལྟ་བུ།",
    "སྤྱན་རས་གཟིགས་མགོན་དེ་ལ་ཡང་།",
    "རང་ལ་ཉོན་མོངས་པའམ།",
    "དེ་ལ་ཏིལླི་པས་ཚར་གསུམ་ཁུག་པ་དག་གི་གདམས་ངག་དང་།",
    "ཞི་གནས་ཀྱི་འདོད་སེམས་རྩེ་གཅིག་པ་ནས་ལུས་སེམས་ཤིན་སྦྱོང་གི་བདེ་བ་མ་ཐོབ་ཀྱི་བར་རྩེ་གཅིག།",
    "དེ་ནི་རང་གི་སེམས་ཉིད་རང་བཞིན་དུ་འཁྲུལ་པས་ཐོག་མ་མེད་པའི་བག་ཆགས་ཀྱི་རྒྱུན་ཅན་ཏེ།",
    "མི་ལྡན་པའང་མ་ཡིན་གྱི་ཉོན་མོངས་པ་ཉལ་བ་ལ་ནི་ཕྲ་རྒྱས་ཞེས་བྱ་ལ།",
    "འཁོར་འདས་གཉིས་སུ་མེད་པའི་ཟུང་འཇུག་གི་མཐར་ཐུག་སེམས་ཀྱི་རྡོ་རྗེ་འདི་ཉིད་ཕུང་པོ་སོགས་དང་བྲལ་བའི་མཚན་ཉིད་ཅན་གྱི་མྱ་ངན་ལས་འདས་པའི་གཟུགས་རྣམ་པ་ཐམས་ཅད་པའི་སྟོང་པ་ཉིད་ཡིན་པའི་ཆ་ནས་གསལ་བ་སྟེ།",
    "བག་ཆགས་བགོ་བའི་གཞིར་གྱུར་ཀྱང་རང་གི་ངོ་བོ་ལ་མ་གོས་ཏེ།",
    "གང་ཟག་གི་ཟླས་ཕྱེ་བའི་ཕུང་སོགས་སྐད་ཅིག་རེ་རེར་འཇིག་པ་ནི་འཇིག་པའི་སྐུམ་པ་སྟེ།",
    "སྒྲུབ་པའི་དུས་འཇིག་རྟེན་བློས་བཏང་གི།",
    "ཐམས་ཅད་རོ་མཉམ་བདེ་བ་ཆེན་པོའི་ས་ཐོབ་པས་བཅུ་དྲུག་གི་རྣམ་གཞག་ནི་དགའ་བ་དེ་སྙེད་ཀྱི་ངོ་སྐལ་དང་མཐུན་པར་ལྡོག་ཆས་ཕྱེ་བ་ཙམ་སྟེ།",
    "གེགས་བསལ་ནས་མཐར་ཐུག་གི་འབྲས་བུ་ཐོབ་པའི་ཚུལ་བསྟན་པའོ།",
