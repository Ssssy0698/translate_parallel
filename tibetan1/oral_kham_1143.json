    "༥༩ ཟིལ་གནོན་དྲག་པོའི་སྦྱིན་འ་སྲེག་དུས་ཀྱི་མེ་ལྕེ་ལ།",
    "ཚེ་བདག་དྲག་སྲེག་དུས་ཀྱི་མེ་འཕྲེང་།",
    "ང་ཡི་ཚོང་དཔོན་ནོར་བཟང་ཞེས་བྱ་བ་དེ་རིག་པའི་གནས་ལ་ཤིན་ཏུ་མཁས་པར་འདུག་པས།",
    "ང་རང་རྒྱལ་པོའི་དྲུང་དུ་ཕྱིན་པས་ཆོག།",
    "གཏེར་ཆེན་དགོས་འདོད་ཀུན་འབྱུང་མི་འདུག་པས།",
    "ནོར་བུ་ལེན་དུ་ཁྱེད་རང་འགྲོ་དགོས་ཡོད།",
    "རྦབ་རྡོ་གྱེན་ལ་ལོག་པའི་དཔེ་མི་སྲིད།",
    "རྦ་རླབས་གྱེན་ལ་ལོག་པའི་དཔེ་མི་སྲིད།",
    "ཁྱེད་རང་རྒྱ་མཚོ་ཅན་ལ་མ་ཕྱིན་ན།",
    "བདུད་བློན་འདི་ཡིས་ང་ཡི་མ་ལྷ་རིགས་བྲམ་ཟེ་དེ་ལ་སྡུག་བསྔལ་དྲག་པོ་ཞིག་བཏང་པ་འདུག་དགོངས་ཏེ་བློན་པོའི་རྗེས་སུ་ཕེབས་ནས་ཁོའི་ལག་པ་ནས་བཟུང་སྟེ་འདི་སྐད་ཅེས་སྨྲས་པ་ཞུ་ལགས།",
    "ལྦུ་བ་རི་རབ་ཙམ་ཞིག་ལངས་ཀྱི་འདུག།",
    "རང་རང་ལས་ཀྱི་ཤིང་གུ་འཐུ་བར་འདུག།",
    "ཕ་དེ་བྱས་པ་ཅན་ཞིག་ཡིན་པར་འདུག།",
    "ཆུང་བ་ཁབ་དང་སྐུད་པའི་ཚོང་ཞིག་འདུག།",
    "ཨ་ཙི་དེ་འདྲ་ཡ་མཚན་ཅི་ཞིག་ཡིན།",
    "འོད་དེ་ཆེ་བ་ཉི་ཟླ་ཙམ་ཞིག་འདུག།",
    "འོད་དེ་ཆུང་བ་སྐར་ཆེན་ཙམ་ཞིག་འདུག།",
    "འོད་ཟེར་བཀྲ་མདངས་ལྡན་པའི་ནོར་ཅིག་འདུག།",
    "རྒྱལ་ཁབ་གཞན་ནས་ཐོན་པའི་འོད་ཅིག་འདུག།",
    "སྔོན་དུས་ཕ་དེ་བྱས་པ་ཅན་ཞིག་འདུག།",
    "ཕ་ལས་ལྷག་པའི་བུ་ཞིག་འཁྲུངས་ནས་འདུག།",
    "ལོ་ན་གསུམ་གྱི་སྟེང་ལ་བསླེབས་ནས་འདུག།",
    "སྔོན་དུས་ཕ་དེ་བྱས་པ་ཅན་ཞིག་འདུག།",
    "ཕ་ལས་ལྷག་པའི་བུ་ཞིག་འཁྲུངས་ནས་འདུག།",
    "ཐ་མ་ང་ཡི་རྒྱལ་གཞིས་འཕྲོགས་ཉེན་འདུག།",
    "ཕ་ལས་ལྷག་པའི་བུ་ཞིག་འཁྲུངས་ནས་འདུག།",
    "རྒྱལ་པོ་ང་ལ་བུ་ཞིག་མི་འདུག་པས།",
    "ཁྱེད་རང་རྒྱ་མཚོ་ཅན་ལ་ཕྱིན་ཟེར་ན།",
    "ལྦུ་བ་རི་རབ་ཙམ་ཞིག་ལངས་ཀྱི་འདུག།",
    "མཐའ་གླིང་རྒྱ་མཚོ་ཅན་ནས་འཁོར་ནས་འདུག།",
    "མཐའ་གླིང་རྒྱ་མཚོ་ཅན་ནས་འཁོར་ནས་འདུག།",
    "བཤན་པ་རྣམས་ཀྱི་སྲོག་དང་བྲལ་བ་འདུག་དགོངས་ཏེ་མེ་མཆོད་བཞེས་པ་དང་།",
    "ཞེས་སྨྲས་ལྟར་དུ་མུ་སྟེགས་རྒྱལ་བོ་དེ་ཤིན་ཏུ་དགའ་སྤྲོ་སྐྱེས་ནས་བཤན་པ་རྣམས་ལ་བྱ་དགའ་གསེར་དངུལ་ཕངས་མེད་དུ་སྟེར་བ་དང་བཤན་པ་རྣམས་ཀྱང་རང་གནས་སུ་ལོག་ཅིང་།",
    "མགོ་ཡང་ན་ཞིང་སྐྱུག་པ་ཤོར་བ་འདུག།",
    "གཟུགས་བཟང་ལྡན་ཞིང་ཨེ་འདྲ་མཚར་བ་འདུག།",
    "བསམ་སྦྱོར་ངན་པའི་འབྲས་བུ་སྨིན་པར་འདུག།",
    "སྡིག་ཆེན་ཕག་རྒོད་གཅིག་ཀྱང་བསླེབས་ནས་འདུག།",
    "མེ་ཏོག་གསར་པ་རྣམས་ཚོ་བཟས་ནས་འདུག།",
    "མེ་ཏོག་རྙིང་པ་རྣམས་ཚོ་རྙོག་ནས་འདུག།",
    "ཆུ་མིག་དེ་ཡི་ཁ་རུ་བུམ་པ་དང་སྐྱོགས་བཞག་པའི་རྗེས་ཤུལ་ཞིག་འདུག་པས་རྔོན་པའི་ཐུགས་ཀྱི་དགོངས་པ་ལ།",
    "རི་དྭགས་བསད་པའི་ཤ་ནི་མི་འདུག་པས།",
    "ཡང་ན་གནས་ཕྱོགས་གཞན་ལ་གྱུར་ཉེན་འདུག།",
    "ད་ལྟ་འགྲོ་བའི་དུས་ལ་བབས་མི་འདུག།",
    "ཕྱི་པ་མུ་སྟེགས་བསྟན་པ་དར་ནས་འདུག།",
    "ཁྲ་དོག་མེ་ལྟར་འབར་བ་བྱེད་བཞིན་འདུག།",
    "ཆུང་མས་ནེའུ་ལི་བསད་པ་དཔེ་ཞིག་འདུག།",
    "ཆུང་མས་བུ་ཚ་ནེའུ་ལེར་བཅོལ་ནས་འདུག།",
    "དེ་ནི་ང་ལ་ཕན་ཐོག་མི་འདུག་པས།",
    "ཤ་ནི་ཐམས་ཅད་རུས་ལ་ཐིམ་པར་འདུག།",
    "ཁྲག་དང་ཆུ་ཟེར་ཁ་ནས་ལྷུང་པར་འདུག།",
    "བྱ་དགའ་བདག་སྐྱེས་ཡོད་ན་ཨ་ཇོ་རང་སྦྱིན།",
    "གཟུགས་ཀྱི་སྙེ་མ་ལ་སོགས་པའི་ཟློས་གར་གསུང་བ་ཞིག་འདུག་པས།",
    "ཡ་མཚན་ཆེ་ཞིང་ངོ་མཚར་ཆེ་བ་འདུག།",
    "མི་ཡིས་ལབ་ཅིང་ཀུན་གྱི་འཕྱིར་ར་འདུག།",
    "དེས་ནས་རྒྱལ་པོ་ཁོ་རང་བསྟེན་པའི་ལྷ་ཁང་དུ་བཞུགས་པ་དང་།",
    "ཁྱེད་ཀྱི་ལྐོག་ལ་ཆུང་མ་བཙལ་ནས་འདུག།",
    "གཟེ་མ་ར་མགོའི་གཏམ་དེ་བདེན་པར་འདུག།",
    "ཁྱེད་རང་ལྕམ་སྲིང་གཉིས་ཀྱི་བློ་གཏད་དེ།",
    "ང་རང་ལྕམ་སྲིང་གཉིས་ཀྱི་བློ་གཏད་དེ།",
    "ཨ་ལྕེས་ལམ་སྣ་འཁྲིད་དང་རང་ཉིད་འགྲོ།",
    "ང་རང་ལྕམ་སྲིང་གཉིས་ཀྱི་བློ་གཏད་དེ།",
    "དེ་ལ་ཐུགས་འཁྲལ་མཛད་དགོས་མི་འདུག་པས།",
    "རྩྭ་ཕུང་རི་རབ་ཙམ་ཞིག་ཚིག་ཉེན་འདུག་ཆུ་ནི་ཆུང་བའི་དུས་རྩ་ནས་མ་བཀག་ན།",
    "ཐིག་པ་བསགས་ནས་རྒྱ་མཚོ་ཆགས་ཉེན་འདུག་ལྕམ་སྲིང་ཆུང་དུས་རྩ་ནས་མ་བསད་ན།",
    "ཨ་ཇོ་གསོན་དང་ཤན་པ་རྒན་གཞོན་གཉིས།",
    "སྔར་ནི་ཨ་ཇོ་ཤན་པ་མཐོང་བའི་དུས།",
    "འཇིགས་སྐྲགས་ཆེ་ཞིང་སྡུག་བསྔལ་ཆེ་བ་འདུག།",
    "ཤ་ནི་ཐམས་ཅད་ལུས་ལ་ཐིམས་པ་འདུག།",
    "དེ་རིང་ལྕམ་སྲིང་སྲོག་ལ་བབས་ཀྱི་འདུག།",
    "ཨ་ཇོ་གསོན་དང་ཤན་པ་རྒན་པ་ལགས།",
    "ཨ་ཇོ་གསོན་དང་ཉ་པ་རྒན་གཞོན་གཉིས།",
    "ཨ་ཅེའི་ཚབ་ལ་ལྷ་སྲས་ང་རང་གཡུག།",
    "ལྷ་སྲས་ཚབ་ལ་ཨ་ཅེ་ང་རང་གཡུག།",
    "བཞག་ཅིག་བཞག་ན་སེམས་པས་མ་འཕོད་འདུག།",
    "ང་རང་ལྕམ་སྲིང་གཉིས་ཀྱི་སྡུག་བསྔལ་འདི།",
    "ལྷ་སྲས་ང་ནི་སྲོག་དང་བྲལ་ཉེན་འདུག།",
    "འདི་འདྲའི་གནས་ལ་ཆུ་ཞིག་མིན་འདུག་གམ།",
    "ཨ་ཅེས་ལམ་སྣ་འཁྲིད་དང་རང་གཉིས་འགྲོ།",
    "ང་རང་མིང་ལ་ལྷ་སྲས་རྒྱལ་བུ་ཟེར།",
    "ཤན་པ་མ་བསད་ཚེ་ཐར་བཏང་ནས་འདུག།",
    "ཡབ་ཆེན་མུན་པའི་བཙོན་ནས་བཏོན་ནས་འདུག།",
