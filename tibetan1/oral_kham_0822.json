    "སུན་དང་སྐྱོ་བ་མི་འདུག།",
    "ཕྱེ་ལེབ་ཤེས་བཞིན་ལྕེབ་འདུག།",
    "དངུལ་སྲང་བཅུ་བཅས་སྐྱབས་རྟེན་འབུལ་བ་མཛད་ནས་སྐྱབས་འཇུག་ཞུས་པས་བཀའ་ལན་དུ་རྗེས་འཛིན་གྱི་གསུང་དུ་མ་སྩལ་ཡོད་འདུག་ཀྱང་དམ་པ་ནང་ཕུན་ཚུན་གྱི་བགྲོ་བ་རྣམས་ནི་། རིན་ཆེན་སྦྱོར་བའི་བཅུད་ལེན་ལྟར་སུ་ཡིན་གྱི་འཇུ་བ་དཀའ་བའི་གནས་སུ་གྱུར་པས་མ་བཀོད་ལ།",
    "འདི་སྐོར་གྲྭ་སར་རྒྱུན་རིང་བཞུགས་ཏེ་རྩོད་པས་བརྡར་ཤ་བཅད་པ་ཞིག་ཐུགས་ལ་བརྣག་ཡོད་འདུག་ཀྱང་།",
    "ཉིད་ཀྱིས་དཔྱད་མཁྱེན་པའི་ཡོན་ཏན་ཁོ་ནས་ཡིན་འདུག་ལ།",
    "མང་དུ་ཐོས་པའི་དོན་པོ་དེ་ཁར་འདུག།",
    "འོལ་སྤྱི་ཙམ་ནི་ཐུགས་དམ་གྱི་རྟེན་དང་ཡོ་བྱད་ཕྱག་དཔེ་འགོད་ཆེ་བ་མཛད་པ་སོགས་ལས་བརྟགས་ཤིང་ཁྱད་པར་ཉམས་བཞེས་ཀྱི་ཐོ་ཆུང་ཞིག་འདུག་པ་ནས་ཅུང་ཟད་བརྗོད་ན།",
    "འཕགས་མ་ཡིད་བཞིན་འཁོར་ལོ་སོགས་ཡི་དམ་གྱི་མཐིལ་དུ་འཛིན་པ་ཡིན་འདུག་ལ།",
    "རྡོ་རྗེ་མཁར་འགྲོའི་སྦྱིན་སྲེག་སོགས་རྩ་བའི་ཉམས་བཞེས་ཡིན་འདུག་པས།",
    "མི་གསན་པ་དེ་འདྲ་ཞིག་ཡོད་པ་ནི་ཐུགས་ཏིང་ངེ་འཛིན་གྱི་དང་དུ་འབྱམས་པས་ཡིན་འདུག་ལ།",
    "ཕྲན་ནས་དམིགས་པ་ཆེར་གསལ་གྱི་མི་འདུག་མ་གཏོགས་དམིགས་པ་གང་གསལ་བ་དེ་ལ་མི་བཙུམས་པས་མི་ཕན་ཞིང་དེ་འདྲ་དགོས་པ་ཡང་མི་འདུག་གསུངས་པ་སོགས་དམིགས་པ་བརྟན་ཅིང་སེམས་ལས་སུ་རུང་བ་སྣང་བ་སྣ་ཚོགས་ཀྱིས་འཕྲོག་མི་ནུས་པའི་ཏིང་ངེ་འཛིན་ཁྱད་པར་ཅན་དང་ལྡན་པའི་ཚུལ་ཏེ།",
    "དེ་དག་ན་གཞོན་པའི་གནས་སྐབས་དེ་ཙམ་ལ་དགའ་རབ་ཡིན་འདུག་སྟེ་དེའི་ཚོད་ལ་ད་ལྟ།",
    "སྐུ་ན་ཕྲུ་བ་ནས་བཟུང་ལྟ་བ་ལ་ངེས་པར་བརྙེད་པའི་ཚུལ་ཁྱད་པར་ཅན་ཡོད་པར་ཡིན་། འདུག་ལ་དེར་མ་ཟད་རྫོགས་རིམ་ལ་ཉམས་སུ་བཞེས་པའི་ཚུལ་སོགས་གསང་བ་དམ་པས་དངོས་སུ་མི་གསུང་ཀྱང་།",
    "སྐྱེ་སྒོ་བཏབ་ཀྱང་དོན་མི་འདུག་གསུང་།",
    "རྗེ་ཉིད་ཀྱིས་མི་དེ་ཤི་མེད་དམ་གསུང་པ་བཞིན་ཕྲན་ཚོ་དེར་སླེབས་ནས་མི་དེ་དྲག་ནས་འདུག་དེ་ལ་སོགས་པ་ཤིན་ཏུ་མང་ཡང་འདིར་ས་བོན་ཙམ་བཀོད་པ་ཡིན།",
    "དེ་འདྲ་ལ་འཛེམ་བག་ཆེར་མེད་པའི་སྲོལ་ངན་པ་ཞིག་སྔར་ནས་ཡོད་འདུག་པ།",
    "ཀ་ཅ་གང་ཡོད་འཕྲོགས་ནས་ཉམས་ཐག་པར་ས་སྟོང་དུ་ལུས་འདུག་པར།",
    "ད་ངེད་རང་ཡང་ན་རྒྱུ་ཤིན་ཏུ་མང་བ་ཞིག་འདུག་པས་ལོ་གསར་ཚེས་དུས་འཕྲལ་དུ་ཚེ་སྒྲུབ་ཞིག་མཛད་ཤོག་གསུངས་པ་དང་།",
    "ཁྱེད་རང་ཚེ་རིང་བ་དང་བར་ཆད་མེད་པར་བྱུང་ན་ང་རང་བསམ་པ་ཐམས་། ཅད་དེས་རྫོགས།",
    "འགའ་ཞིག་ནི་རིམ་གྲོ་སོགས་ཀྱིས་བཟློག་པའང་འདུག་འགའ་ཞིག་བཟློག་མི་ཐུབ་པའང་འདུག་སྟེ།",
    "ང་རང་གཞན་ཐམས་ཅད་ཀྱིས་ཕྲན་ལ་ཆེད་དམིགས་ཀྱིས་རྐྱེན་བཟློག་རིམ་གྲོ་དེ་ཙམ་ལས་བསྒྲུབ་ཐབས་མེད་ངེས་པ་ཡིན།",
    "ལགས་དེ་མིན་དགུན་དང་པོའི་ཚེས་བརྒྱད་ལ་བྱེད་འདུག་ཞུས་པས་ཨི་ཡིན་ན་གསུངས་པར་རྗེས་སོར་བརྟག་ན་བསྐལ་བཟང་འཕྲིན་ལས་ལྷུན་གྲུབ་ཀྱི་དུས་བཟང་ནམ་ཡིན་མི་མཁྱེན་པ་ཅི་ལ་ཡིན་ཏེ།",
    "དེ་ལས་ཐབས་མི་འདུག་གམ་ཞེས་དང་།",
    "གཞན་ཡང་རང་ཕྱོགས་བོད་གངས་ཅན་ལྗོངས་ཀྱི་བླ་བྲང་ཕལ་ཆེ་བ་དང་།",
    "ཡིག་འབྲུ་སོགས་བྱོན་པ་རྣམ་གྲངས་མང་ཙམ་ཕྲན་གྱི་མིག་ལམ་དུ་སོན་པ་དུ་མ་ཞིག་ཡོད་འདུག་རུང་།",
    "ཞེས་པ་དེ་ཡིན་འདུག་གསུངས།",
    "དེ་ཡང་རང་བློ་མ་དག་པའི་བསམ་ཚོད་ལ།",
    "གོས་གྱོན་མི་དགོས་པ་ནི་དུད་འགྲོ་ཕལ་ཆེར་ལ་འདུག་ཡང་དགུན་དུས་ཆུ་རས་བྱས་པ་ལ་ཡ་མཚན་ཆེར་བྱེད་པ་ཡང་ལྷན་སྐྱེས་ཀྱི་ཡེ་ཤེས་མ་སྐྱེས་ན་དགུན་དུས་རས་ཆུས་སྦགས་བ་དྲོས་པ་ཙམ་ལས།",
    "ཐང་མ་གོར་ཙ་ན།",
    "དེ་བསན་འཚོ་བ་ངན་འགྲབ་ཙམ་ཡོང་བ་འདུག་པས།",
    "ཁ་འཕྲིན་མ་གཏོགས་ཡི་གེ་མེད་པས་བོད་ལའང་ཡི་གེ་ཞིག་ཅིས་ཀྱང་དགོས་པར་འདུག་ཅེས་ཐུགས་ལ་དགོངས་ཏེ།",
    "ངའི་ཡབ་མེས་ཀྱི་གཉེན་པོ་གསང་བ་འདི་ན་ཅི་འདུག་ཀློག་གསུངས།",
    "དེང་ལ་ལྐོག་ཏུ་ཇི་ལྟར་ཁྲིད་པ་བཞིན་དུ་བྲིས་འདུག་ཅུང་ཟབ་དྲགས་གསུངས།",
    "ངས་ཚོང་བྱས་པ་འདི་བ་འབྲི་ཡིན་ཁེ་ཕོག་འདུག་ཨང་གསུང་བར།",
    "འབྲི་བར་འགྱུར་གདའ།",
    "རྣམ་བཞིའི་འཕྲིན་ལས་ཀྱང་གཡེལ་མེད་ཡོད་འདུག།",
    "བོད་ནས་ཕྱིར་མི་ཕེབས་པར་ཞིང་ཁམས་གཞན་དུ་གཤེགས་པར་གསུང་འདུག་ཅེས་མཐུན་པར་གླེང་།",
    "བདག་པོ་ང་རང་ཡིན་པས་རང་ཡུལ་དུ་གདན་ཞུ་བྱ་བ་ཡིན་གསུངས་ཏེ།",
    "རྗེས་སུ་དེ་ཁོ་ནར་གྱུར་ཡོད་འདུག་དེ་ནས་ལྕགས་སྤྲེལ་ལོ་ལ་དབུས་ཕེབས་མཛད།",
    "རིན་པ་ཕུར་ལྕོག་བླ་བྲང་རང་ནས་གནང་སྟེ་ཉོས་ཤིག་གསུངས་པ་ལྟར་ཕྱག་འབྱོར་བྱུང་།",
    "མདའ་དེ་རྭ་ཉག་མཚོ་ཁར་ཡོད་གསུངས་པ་ལྟར་རྭ་ཉག་མཚོ་ཁར་ཟུག་འདུག་པར།",
    "སྒར་དུ་ཕེབས་སྐབས་ཆིབས་རགས་སྔོན་ནས་ཕེབས་པར་ལམ་ཁ་ཞིག་ནས་ཕ་ཝང་ཞིག་འདུག་པར།",
    "ཕྱི་ལོར་ཕ་ཡུལ་འབྱོར་སྐབས་རྟ་ཇག་པར་ཤོར་བར་མ་ཟད་ཟླ་ཚེས་ཀྱང་དེ་ཁོ་ནར་བྱུང་འདུག་ཟླ་བ་དགུ་པའི་ཚེས་དྲུག་ལ་སྐྱིད་ཤོད་བན་ཛར་གཞིས་ཀར་ཕེབས།",
    "རྟ་དེ་འདི་གར་ཡོད་འདུག་གསུང་།",
    "ཁོ་རང་དང་ངེད་གཉིས་སྐྱེ་བ་མང་པོར་འགྲོགས་ཏེ།",
    "བཀྲ་དོན་སོགས་དབུས་འབྱོར་སྐབས་ཡིན་པས་རྒྱལ་ཁབ་གསུམཀས་ཁོ་རང་རྣམས་ཀྱི་ཡུལ་དུ་གདན་འདྲེན་ནན་ཆེ་དང་།",
