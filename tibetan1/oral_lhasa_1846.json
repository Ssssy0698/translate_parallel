    "མཐའ་རྟེན་དུ་རྫོགས་པ་ཆེན་པོ་དེ་དག་ལ་ངོ་སྤྲད་དེ་ཅུང་ཟད་མཉམ་པར་བཞག།",
    "ཐུགས་ཀ་དང་ཁྱད་པར་ལྟེ་བ་དཔུང་པ་གཡས་ཀྱི་སྭཱ་ལས་འོད་ཟེར་སེར་པོ་དཔག་ཏུ་མེད་པ་སྭཱ་ཡིག་དང་བཅས་པ་བྱུང་།",
    "ཐུགས་ཀ་དང་ཁྱད་པར་གསང་གནས་དཔུང་པ་གཡོན་པའི་ཧྲཱི་ལས་འོད་ཟེར་ལྗང་གུ་དཔག་ཏུ་མེད་པ་ས་ཡིག་དང་བཅས་པ་བྱུང་།",
    "འཕྲིན་ལས་རྣམ་བཞིས་གང་ལ་ལྡན་ཐོགས་མེད་པར།",
    "བསྐུར་བའི་གཏོར་མ་དེ་ཉིད་སྤྲོས་བྱས་ལ།",
    "དཀར་དམར་གཏོར་མ་གཙང་མའི་ཕུད་ཀྱིས་བྲན།",
    "འབུལ་ལོ་མཆོད་སྦྱིན་གཏོར་མ་འདི་བཞེས་ལ།",
    "བདག་ཅག་དཔོན་སློབ་བསམ་དོན་གྲུབ་པར་མཛོད།",
    "ཅེས་པས་བསྔོས་ལས་ཕྱོགསགཙང་སར་བསྐྱལ།",
    "སྲུང་བ་མན་ངག་སྦྱིན་པར་བྱེད་ན་ཡང་།",
    "སྔོན་ལ་སྣོད་རུང་བྱས་ལ་སྲུང་ཡོན་གྱི།",
    "དེ་ལྟར་བྱས་པས་གདགས་བྱ་དག་ལ་ཡང་།",
    "མཚུངས་པར་ཕན་བདེའི་སྒོ་བརྒྱ་འབྱེད་པར་ཤོག།",
    "མཁྱེན་པའི་སྤྱན་ལྡན་སེ་སྟོན་རིན་རྒྱལ་ཞབས།",
    "གཏེར་སྐྱོང་རྣམས་ཀྱིས་གནང་བ་ཉེར་སྩལ་ནས།",
    "དེ་ཉིད་ཀྱི་ནང་གཏེར་ལྷ་སྲས་ཀྱི་ཞུས་ལན་སྐབས་ལས།",
    "ང་ཡི་གཏེར་འདོན་ལྷ་སྲས་གདུང་བརྒྱུད་སྐྱོབ།",
    "གུང་ཐང་༢བ་རྒྱལ་པོ་རྗེ་འབངས་སྐྱོབ་པར་ངེས།",
    "ཞེས་གསལ་བར་ལུང་དང་མཐུན་པར་བྱོན་པའི་གཏེར་ཆེན་གྱི་རྒྱལ་པོ་དངོས་གྲུབ་རྒྱལ་མཚན་ནམ།",
    "མཚན་ཡོངས་སུ་གྲགས་པ་རིགས་འཛིན་རྒོད་ཀྱི་ལྡེམ་ཕྲུ་ཅན་གྱི་བྱང་ཕྱོགས་བྲག་རི་དུག་སྤྲུལ་སྤུངས་འདྲའི་རྐེད་པར་གཞོམ་མེད་རྡོ་རྗེའི་སྒྲོམ་བུར་རྒྱས་བཏབ་པ་མཛོད་ལྔ་འདུས་པའི་ནང་ཚན་ལས།",
    "ཐེ་ཚོམ་སྤངས་ལ་སྒྲུབ་པར་མཛོད།",
    "ཅེས་གསུངས་པའི་ཚེ་སྒྲུབ་ཕྱི་ནང་གསང་གསུམ་ལས།",
    "༣ན་བཙང་མའི་གོས་དཀྲིས་དཔག་བསམ་སྡོང་པོས་བརྒྱན།",
    "སྟེགས་བུའི་ཁང་རྟེན་ཁེབས་སོགས་ཀྱིསམཛེས་པར་བྱས།",
    "སྲ་ཞིང་བརྟན་པར་བྱིན་གྱིས་རློབས།",
    "རང་འདྲ་སྤྱན་དྲངས་མཁའ་ལ་བཞུགས།",
    "གོང་ལྟར་སྔགས་དང་ཏིང་ངེ་འཛིན་རྒྱས་པར་བྱ།",
    "འབུལ་གྱིས་དགྱེས་པར་བཞེས་ནས་ཀྱང་།",
    "དམ་ཚིག་རྣམ་པར་དག་པའི་སྐུ།",
    "སྔོན་ནས་བསགས་པའི་སྡིག་སྒྲིབ་བཤགས།",
    "ལན་གསུམ་གྱིས་རྒྱུད་དག་པར་བྱ།",
    "སྤྱི་བོར་རྡོ་རྗེ་བཞག་ནས་ཏིཥྛ་བཛྲ་གྱིས་བརྟེན་པར་བྱ།",
    "ཁོག་པ་གང་ཞིང་དངོས་གྲུབ་ཐོབ་༦བ་པར་བསམ།",
    "འཆི་མེད་ཚེ་ཡི་དངོས་གྲུབ་ཐོབ་པར་བསམ།",
    "ཚེ་རྒྱས་པར་གྱུར་ཅིག།",
    "མཐར་བདུད་བཞིའི་འཇིགས་པ་ལས་ཐར་ནས་མན་པར་རྫོགས་པར་འཚང་རྒྱ་བར་གྱུར་ཅིག།",
    "ཚེ་བདག་ཆེན་པོར་བཞུགས་སུ་གསོལ།",
    "ང་ལ་བརྙས་པར་མ་བྱེད་པར།",
    "སྔ་འགྱུར་ཕལཆེར་ལ་པར་བཀབ་མི་མཛད་ཀྱང་།",
    "འདི་བསྒྲུབས་ལོ་བརྒྱ་ངེས་པར་ཐུབ།",
    "ཞེས་ཕན་ཡོན་ཆེ་བར་གསུངས་པ་ནི་མི་བསླུ་བའི་གཏན་ཚིགས་སོ།",
    "རིང་རིང་བསྐལ་པར་སྲོག་འཚོའི་བདུད་རྩིའི་རྒྱུན།",
    "ཚེ་དཔག་མེད་མགོན་འཆི་མེད་གནང་བ་སྩོལ།",
    "ཀུན་མཁྱེན་མཛད་བཟང་ལོ་འདབ་ཕྱོགས་བཅུར་གཡོ།",
    "ལེགས་པར་བྲི་ལ་གཏེར་སྲུང་གནང་བ་སྩོལ།",
    "ཚེ་འགུགས་ཀྱི་ཚེ་དབྱངས་རོལ་བྱེད་པར་སྤྲོ་ན་སྦུབ་ཆོལ་དང་རྔ་སོགས་ཀྱང་སྟ་གོན་ལེགས་པར་བྱས།",
    "སུ་བྷཱ་ཝས་སྟོང་པར་སྦྱངས།",
    "ཞེས་པའི་བར་གཏེར་གཞུང་ལྟར་གྱི་ཚེ་འགུགས་འང་གཅིག་བྱས་ཏེ་བུམ་རྫས་རྣམས་ནུས་ལྡན་དུ་བྱ།",
    "གལ་ཏེ་མི་འགྲོ་ན་ཁྲོ་བོའི་ཡེ་ཤེས་ཀྱི་རྡོ་རྗེ་མེ་འབར་བས་མགོ་བོ་ཚལ་པ་བརྒྱར་འགས་པར་གྱུར་ཏེ།",
    "སྐད་ཅིག་ཙམ་གྱིས་བར་མཚམས་མེད་པར་གཏམས།",
    "ཞེས་པའི་བར་གཏེར་གཞུང་ལྟར་ལན་གསུམ་རྗེས་ཟློས་བྱས།",
    "ཚིག་དོན་ལྟར་ཏིང་ངེ་འཛིན་གྱི་དམིགས་པའི་འཕྲོ་འདུ་ལེགས་པར་བྱས།",
    "དེ་རྗེས་དཔྲལ་བར་ལི་ཁྲིའི་ཐིག་ལེ་བྱས་ལ།",
    "རྒྱུན་ཆད་མེད་པར་འཛིན་མཁས་མངའ་རིས་རྗེ།",
    "རྗེ་བཙུན་ལེགས་ལྡན་རྡོ་རྗེ་བརྒྱུད་པར་ངེས།",
    "མ་ལུས་དེ་ཉིད་མཆོག་ནི་ཚུལ་བཞིན་ཀུན་མཁྱེན་གྱིས་མཁྱེན་གཞན་མིན་པ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "ཉ་དང་ཉུང་མ་བསྲེ་མ་མྱོང་བའི་སྟབས་ཀྱིས་འདིར་ཡང་སྔ་འགྱུར་རང་སྐད་གཙང་མར་བྱས་སོ།",
    "བརྒྱུད་ལྡན་དམ་པའི་ཕྱག་ལེན་གྱིས་ལེགས་པར་བརྒྱན་ཅིང་།",
    "བཀའ་བརྒྱད་སོགས་༢བརྐོང་བཟོ་དབྱིབས་ལམ་ཙམ་མཐུན་པར་རྒྱན་སྤྲོས་གང་ལེགས་བྱས་པ་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་མ་སྒྱུའི་ཁར་བཞག།",
    "གཏོར་མའི་ཙ་གླི་ནང་སྒྲུབ་ཀྱི་མངོན་རྟོགས་དང་མཐུན་པར་བཙུགས།",
    "རྒྱལ་ཆེན་གྱི་མཐོ་འགྲོལ་བ་སོགས་སྤྱི་དང་མཐུན་པར་བྱས་ནས་སྐུ་མཚམས་འགྲོལ་ལོ།",
    "བཀོད་ལས་རྒྱུན་མེད་མགོ་སྐོར་བློས་བྱས་ཀྱི།",
    "རྡོ་རྗེ་གཏུམ་པོའི་ལས་བྱང་རྒྱུན་འབྱེར་མཐོང་བས་རྣམ་གྲོལ་ཞེས་བྱ་བ་བཞུགས།",
    "རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་བྱེད།",
    "མེ་དཔུང་ཀློང་ན་འགྱིང་ཚུལ་བཞུགས།",
