    "སྐྱབས་རེ་གཞན་ན་མི་འཚོལ་བར།",
    "སྐྱབས་སུ་སོང་ན་གདུལ་འོས་བདག།",
    "བསྟན་དོན་དེ་ཉིད་གཟིགས་ནས་ནི།",
    "བློ་ཆེན་མཛད་བཟང་མཐའ་ཡས་མོད།",
    "དེ་ནི་ཁྱོད་ཀྱི་ཡོན་ཏན་ལགས།",
    "ཁྱོད་ཀྱི་སྐུ་ལ་རབ་འཁྱུད་ནས།",
    "འཕགས་ནོར་ཉིད་དུ་ཁྱོད་ཀྱིས་དགོངས།",
    "རྣམ་འགྲེལ་ཐུན་མོང་མིན་པའི་ལུགས།",
    "ཁྱད་དུ་འཕགས་པར་ཁྱོད་ཀྱིས་མཁྱེན།",
    "ཉིན་མཚན་འཁོར་མོར་བསྒོམས་པས་ན།",
    "མཐོང་བས་མོད་ལ་དགའ་སྤྲོ་སྐྱེས།",
    "བདག་གི་ཡིད་ནི་དུས་དྲུག་ཏུ།",
    "ཁྱོད་ཀྱི་རྗེས་སུ་རབ་ཏུ་གཞོལ།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་བྲག་ཙམ་མཐོང་།",
    "ཅེས་པ་འདི་ནི་གང་གི་ཞབས།",
    "རང་རེས་དགའ་སྐྱེད་རྒྱལ་མཚན་རྒྱལ་གྱུར་ཅིག།",
    "ལང་ཚོ་བདོ་བའི་སྐབས་དང་ཉེར་འཚམས་སྐུ།",
    "རབ་ཏུ་དྭངས་པའི་ཕུལ་བྱུང་མཛེས་སྡུག་གིས།",
    "འཁྲིལ་ལྡེམ་འཁྱོག་པའི་སྒེག་ཉམས་མཛེས་སྡུག་གིས།",
    "འཇམ་མཉེན་ཕྱག་གིས་སྐྱབས་སྦྱིན་འདི་སྟོན་ན།",
    "དཀྱུས་རིང་རྣ་བར་འགོངས་པའི་གཟིགས་སྟངས་ཀྱིས།",
    "བདག་ཡིད་མུན་པས་ཁེབས་ཚུལ་ཅིས་མི་གཟིགས།",
    "ཉེ་བར་བསྒྲུབ་འོས་ཁྱོད་ཀྱི་ཞབས་སྐྱེའི་རྡུལ།",
    "རི་མོ་གསུམ་བཀྲ་མགུར་གྱི་བུམ་བཟང་ལས།",
    "བཤེས་གཉེན་མཆོག་གིས་དགེ་ལེགས་སྩོལ་གྱུར་ཅིག།",
    "མཚོ་ལས་བྱུང་བའི་ཁྱོད་ཀྱི་སྙན་པ་གང་།",
    "ལང་ཚོ་གསར་པའི་མཛེས་སྡུག་ངོམས་པའི་དཔལ།",
    "ནམ་ཞིག་མིག་གི་བདུད་རྩིར་འཐུང་བར་འགྱུར།",
    "ཐབས་ཀྱིས་སྟོན་ནམ་སྙམ་དུ་འཕྱང་མོ་ཉུག།",
    "རྒྱུད་མངས་མཉེན་ལྕུག་སོར་མོས་བསྐྱོད་པ་ཡིས།",
    "གློག་གི་འཕྲུལ་ལ་མི་ཟད་འཇིགས་སྟེར་བའི།",
    "འཇིག་རྟེན་འདི་ན་ལྷམ་མེར་གསལ་བ་ཁྱོད།",
    "ད་ལྟ་ཁྱོད་ཀྱིས་བསྟན་པ་སྤེལ་དང་མཚུངས།",
    "ངེས་པའི་དཔེ་རྟེན་འབྱུང་སྟོང་པའི་དོན་དུ་གཟིགས་པ་སོགས།",
    "མིག་བརྒྱ་སྤྲུལ་ནས་བཙལ་ཀྱང་རྙེད་རེ་སྐན།",
    "ངེས་མེད་ཀྱི་དཔེ་ཟབ་མོ་རྟེན་འབྱུང་མཁྱེན་པ་དེ་ལྟ་མོད།",
    "ཕུལ་བྱུང་གི་དཔེ་ལྕང་སྐྱ་རོལ་པའི་རྡོ་རྗེའི་ཞབས་སེན་མཆོག།",
    "ཁྱོད་ནི་ཡིད་ཆེས་དད་པས་སྤྱི་བོར་མཆོད།",
    "ཕྱག་གིས་དེ་ཉིད་ཡི་གེར་འདྲི་གྱུར་ན།",
    "ད་གཟོད་བཤེས་གཉེན་གང་གི་དཔལ་བཟང་འཛིན།",
    "རྨོངས་པའི་དཔེ་ཁྱོད་ཀྱིས་བསྟན་པ་ཇི་ལྟར་སྐྱོང་ཚུལ་གྱི།",
    "གཏམ་འདི་ཐོས་ཚེ་མི་རྣམས་ཕལ་མོ་ཆེ།",
    "བདག་གི་ཡིད་ནི་གང་དུའང་མ་ཟིན་པར།",
    "བདག་གི་བཤེས་གཉེན་ཡིན་པར་གོར་མ་ཆག།",
    "འདྲེན་པ་ཁྱོད་ནི་ཟས་གཙང་སྲས་པོ་བཞིན།",
    "ཁྱོད་ནི་དེ་དག་ལས་ཀྱང་མཚུངས་པ་ལས།",
    "ཚུལ་དེ་ཇི་བཞིན་ཉམས་མེད་འཛིན་པ་ཁྱོད།",
    "ཟག་པ་མེད་པའི་ཁྱོད་ཀྱི་ཐུགས་རྗེ་ནི།",
    "བརྗོད་འདོད་རྟོག་པ་བདག་གི་ཡིད་ལ་ཤར།",
    "ཁྱོད་ཀྱི་ཐུགས་རྗེར་འགྲན་པའི་གནས་སྐབས་ཅི།",
    "ཁྱོད་ནི་འཇམ་པའི་དབྱངས་ཀྱི་སྤྲུལ་པ་ཙམ།",
    "འོན་ཀྱང་མཆོག་གི་དངོས་གྲུབ་སྩོལ་བ་ལ།",
    "རང་ཉིད་རང་གི་དཔེ་ལ་འོས་འདི་སུ།",
    "འབྱུང་མིན་དཔེ་དམ་པ་ཁྱོད་ནི་དུས་ཀྱི་ཐ་མ་འདིར།",
    "ཁྱོད་ཀྱི་ཐུགས་རྗེས་རྗེས་སུ་མ་འཛིན་པས།",
    "ཁྱོད་ནི་བགྲང་ཡས་གདུལ་བྱའི་དབུས་སུ་བརྗིད།",
    "ཁྱོད་ཀྱིས་གང་བསྐྱབས་ངེས་པར་རྗེས་སུ་བཟུང་།",
    "ངག་དོན་གྱི་དཔེ་བཞིན་སྒྲ་གཅིག་པ་ཁྱོད་ནི་གཞན་དོན་འབའ་ཞིག་ལེགས་དགོངས་ཤིང་།",
    "དམན་སར་སྐྱེས་པའི་ཙན་དན་མཆོག་གི་དྲི།",
    "དེ་ཡི་དྲི་བཟང་བཞིན་དུ་ཁྱོད་ཀྱི་གསུང་།",
    "མཁས་པ་དག་གིས་དོན་དུ་གཉེར་པ་བཞིན།",
    "བདག་གིས་ཡང་དང་ཡང་དུ་མཉན་པར་བྱ།",
    "ཟླ་བོའི་དངོས་དཔེ་མན་ངག་སྟོན་མཁས་བཤེས་གཉེན་མཐའ་ཀླས་མོད།",
    "དད་པའི་སོར་མོས་བཏེགས་ཏེ་བསྐོན་པར་བགྱི།",
    "སྔོན་ཆད་ཕུལ་བྱུང་ཞིང་ལ་སྙན་ངག་གིས།",
    "དེ་ཕྱིར་རྣམ་འདྲེན་ཁྱོད་དང་རྒྱལ་བ་གཉིས།",
    "མགོན་ཁྱོད་འགྲོ་བའི་མོས་ངོར་སྣ་ཚོགས་སྐུ།",
    "གཉེན་པོ་ནི་ཁྱོད་ལ་མཐོང་ཐོས་དྲན་རེག་འབྲེལ་ཚད་ཀུན།",
    "ཡིད་ལ་རེ་བ་སྐོང་བའི་དཔལ་ཐོབ་འདི།",
    "དགྲ་ཟླ་ནི་གང་ཞིག་ཁྱོད་ལ་སྐྱབས་སུ་འགྲོ་བ་རྣམས།",
    "མོས་པ་འདྲ་མིན་གདུལ་བྱ་རང་རང་གི།",
    "བཅས་པ་ནི་རྟེན་འབྱུང་སྟོང་པའི་དོན་དུ་གཟིགས་པ་ཁྱོད།",
    "ཡང་སྐྱར་ལྡབ་པས་གཅིག་མོད་མིང་འདོགས་ཙམ།",
    "ཁྱོད་གསུང་བདུད་རྩི་མྱང་བའི་སྐལ་ལྡན་ཚོགས།",
    "ཡང་དག་གཞལ་བ་ནི་ཐོགས་དང་བཅས་པའི་གཟུགས་ཅན་མཐའ་དག་གི།",
    "གོ་འབྱེད་ལྷ་ལམ་ཡངས་པའི་རྒྱ་ཁྱོན་ཚད།",
    "དཔག་པར་དཀའ་ཡང་ཁྱོད་ཐུགས་མཁྱེན་པའི་ཕུལ།",
    "ཅིག་ཅར་ཆུད་པའི་ཁྱོད་ཐུགས་ཡངས་པའི་དཔེ།",
    "རང་རེའི་བསྟན་འཛིན་ཕལ་ཆེར་ཁྱོད་བས་དམན།",
    "འགྲན་པའི་ཟླ་དང་བྲལ་བའི་བཤེས་ཁྱོད་དང་།",
    "རིགས་མཐུན་མཉམ་བྱས་ནི་སེར་སྣའི་ཉེས་དམིགས་མངོན་སུམ་གཟིགས་པ་ཡིས།",
    "རང་ཤ་སྟེར་ལའང་གུས་པར་བྱེད་པ་ཁྱོད།",
    "དབུལ་ཕོངས་འགྲོ་བའི་སྐྱབས་དང་དཔུང་གཉེན་ཁྱོད།",
    "ཅི་ཙམ་སྤྱད་ཀྱང་ཁྱོད་ཐུགས་མ་བཀང་བ།",
    "ཅིའི་ཕྱིར་མི་རྒྱལ་ཡོན་ཏན་ཀུན་ལྡན་ཁྱོད།",
    "སྡང་བ་ནི་དེ་ལྟར་བསྟན་པ་འཛིན་རློམ་དེ་དག་གི།",
    "མི་མཐུན་སྒྲོགས་ནི་འཁྲུལ་བྲལ་མངོན་ཤེས་མངའ་བའི་མགོན་ཁྱོད་དང་།",
    "ཉོན་མོངས་དང་བཅས་རབ་ཏུ་བཅོམ་པའི་ཚེ།",
    "ཁྱོད་གསུང་དེ་ལའང་དེ་ཡི་ནུས་པ་འཇུག།",
    "མགོན་ཁྱོད་རྡོ་རྗེ་གཟེགས་མའི་གཏན་ཚིགས་ཀྱིས།",
    "སྲོག་ལས་གཅེས་པར་འཛིན་པའི་དམ་པ་ཁྱོད།"
  ]
}