    "ལྗགས་རྩོམ་གྱི་ཕྱི་མ་རང་ཡིན་ལགས།",
    "དེ་ནས་ཕེབས་ཏེ་ཐུབ་བསྟན་དགེ་འཕེལ་དུ་བཞུགས་ནས།",
    "སྐབས་འགར་ཛ་ལུང་པ་སྐུ་མདུན་དུ་མྱུར་དུ་གདན་འདྲེན་ཞུས་གསུང་པ་སོགས་འཁྲུངས་སྣང་མཐའ་ཡས་པའི་མུར་འབྱམས།",
    "འདི་དང་འདི་ལྟ་བུ་དགོས་སོ་ཞེས་འདོམས་པར་མཛད་པ་ཡིན་གྲང་།",
    "ཕྱག་གཉེར་གསོལ་གཟིམ་མཆོད་སོགས་གཞན་མ་རྣམས་ལའང་གནང་ཆ་གྱ་ནོམ་པ་དང་བཅས་སོ་སོར་སྔ་ཕྱི་བར་གྱི་གསུང་གླེང་ཇི་བཞིན་མཛད་དེ།",
    "བདེན་པར་ཉེ་བའི་དུས་ཤིག་ཤར་མིན་ནམ།",
    "ཁྱད་པར་གཟིམ་ཆུང་སྐོར་གྱི་རྟེན་རྣམས་སྐུ་མདུན་དུ་སྤྱན་དྲངས།",
    "ས་སྐྱར་ཕེབས་དུས་ན་བཟའ་གཟབས་མ་དང་བཅས་ཕེབས་དགོས་གསུང་བ་དང་།",
    "ངེད་ཀྱིས་ས་ཞུ་ཁ་གསར་སུམ་བརྩེགས་སུ་བཞེས་ཡོད་གསུང་བ་དང་།",
    "འོ་ད་ཐུགས་དམ་ལམ་དུས་ཀྱི་ཉམས་བཞེས་ལ་འཇུག་གོ་གསུངས་ནས།",
    "རང་ཉིད་ཞི་བདེའི་ས་ལ་ཕེབས་མིན་ནམ།",
    "ཡར་ངོའི་དགའ་བ་གསུམ་པའི་ནམ་ལངས་བར་ལ་སྐུ་སྤུར་ལ་སྐྱོན་གྱི་རྣམ་པ་ཡེ་མ་བཞེས་པའི་ངོ་མཚར་དང་བཀའ་དྲིན་ལྷན་ཅིག་ཏུ་ཆེ་བ་དང་།",
