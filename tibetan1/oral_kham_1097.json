    "གདན་གཅིག་བཏིངས་འདུག་ཀྱང་ས་བརྗེན་རང་ལ་བསྡད་མཚམས།",
    "རྗེ་དྲུང་ཀརྨ་པ་ཉུལ་རྒྱལ་ཁང་ན་གདན་ཆགས་འདུག་པའི་དྲུང་།",
    "ཁྲིད་ཁ་བརྒྱ་རྩའི་ཁ་བསྐོངས་བཀྲ་ཤིས་གྲངས་ཀྱི་མཐའ་བསྟེན་མིང་བཀྲ་བཟང་བར་འདུག་པས།",
    "ངོར་དུ་འགྲོ་མི་འདྲ་འདུག་པ་ལ་གསེར་གྱི་ཡང་ཆུང་ཞོ་གསུམ་འགོར་བ་ཅིག་གཡུ་ཞོ་བརྒྱད་རི་བ།་",
    "གཅིག་པུར་འདུག་ཀྱང་དགའ་བའི་ཅ་ཅོ་ཤོར།",
    "མིང་ཙམ་མཚུངས་ཀྱང་རང་བཞིན་ཐ་དད་ཅེས།",
    "ཐུགས་དོག་ཆེ་བ་རང་འདུག་པ་ནས།",
    "བར་ཆད་རྩོམ་པའི་དམིགས་བྱ་དེར་འདུག་པས་བསྒྲལ་ལམ་སྙམ་པ་སྐད་ཅིག་ལ།",
    "སྣོད་གང་འདུག་ཏུ་མར་མེ་ཕུལ་བས།",
    "མཇལ་ན་སྐུ་ཆས་འདི་པ་འབུལ་བ་ལ་ང་རང་འགྲོ་ཟེར་ཀྱིན་འདུག་པ་ལ།",
    "འབྲུམ་པས་ན་ནས་ཤི་ན་ཕུང་པོ་སོགས་སྐྱུར་བ་ལ་ལས་སླ་བར་འདུག་སྙམ་ནས།",
    "ས་གར་བསྡད་པ་ལ་ཆུ་འདི་རང་ལུས་ལ་ཕན་པར་འདུག་ཅིང་།",
    "རྡོ་གཡེབས་མི་བསྐྱོད་པ་མང་པོའི་དཔྱིལ་པོའི་ཕྱོགས་ཀྱི་ཕྱི་མཐའ་ཀུན་ན་འདུག་པ་ཡོངས་ཀྱི་མིག་ཤེས་ལ་ཕེབས་པ་ངེས་ཅན་བརྫུན་བྲལ་ཡིན།",
    "ཡི་གེ་ལ་ཞལ་བཤུས་པའི་མྱང་སྟོད་ཕལ་ཆེར་ཁྱབ་འདུག་ཅིང་།",
    "དེ་ལ་ས་སྐྱ་སོགས་སྐྱ་མུག་ཆེ་བར་འདུག་པ་ལ་ངེད་དཔོན་སློབ་སྐྱིད་དུ་ཚོར་བའི་ཆས་འབད་མེད་བྱུང་།",
    "སྟོད་ཧོར་ཡང་དེའི་ཉིན་ཀ་བློ་བུར་དམག་ཡོང་བ་འདུག་ཟེར་ནས་ལོག་སྐད་དོ།",
    "སླར་འབོད་མི་གནང་བ་དང་བསྟུན་ནས་ཚུར་ལམ་ཆུ་འདུས་ཕྱོགས་ན་འབྲུམ་བགས་འདུག་ཟེར་བ་ལ་འཛེམས་ནས་གཏིང་སྐྱེས་ནས་གདོང་ནག་ལ་བྱས།",
    "ལྷག་པར་ཉན་པོའི་རི་བོ་དགེ་ལྡན་པ་རྣམས་ལོ་དུས་ཀྱི་གསང་བ་འདུས་པའི་སྒྲུབ་མཆོད་ཅིག་འདུག་པའི་དབུས་སུ་བོས་ནས།",
    "དེར་ཁྱེད་རང་ལ་དམིགས་ནས་བསྒྲུབས་པ་ཡིན་གསུང་བའི་དཔྱིལ་བུ་ཅིག་ཏུ་ཉལ་བས་མཚན་ཕྱེད་ཙམ་ན་ལྷག་པར་ན་བའི་ཁྲག་དྲོན་སྐྱུག་པ་རང་བྱུང་བས་ཁོང་ཐམས་ཅད་སོ་མ་སོད་ལ་བཀོད།",
    "མཁས་བཙུན་པ་གསུམ་གྱི་སྐུ་རིང་ལ་ས་སྐྱ་པའི་གུར་ཞལ་རང་ལ་བྱེད་པ་ཡིན་འདུག་ཅིང་།",
    "སླར་ངམ་རིངས་སུ་ཡོངས་རྨི་ལམ་ལ་གུར་མགོན་ཚུབ་འགྱུར་གྱི་རྣམ་འཕྲུལ་སྣ་ཚོགས་རང་འདུག་པས་བསྐངས་གསོ་ཅུང་རྒྱུན་རིང་པ་ཙམ་ཅིག་སྐུ་རིམ་དུ་ཆེ་བ་ཞུས་ནས་བསྐང་གསོ་ཟབ་རྒྱས་རང་བརྒྱ་ཚར་གསུམ་བཏུད།",
    "རང་རང་ཕྱག་བཞེས་ཡིན་པས་ཅི་ཞིག་གོརིག་བྱེད་གཞུང་ལུགས་ཡིག་མངས་བསླབ་སྦྱངས་མཁས།",
    "ཕེབས་པའི་རྟེན་མཆོད་སུལ་ཆ་ཡང་མི་འདུག་ལ།",
    "དེར་ཞིབ་ཏུ་དཔྱད་པས་གསར་གཞེངས་ཀྱི་ས་པཎ་གྱི་སྐུ་དེ་སྐུ་འདྲ་ཡིད་བཞིན་གྱི་ནོར་བུ་ལས་དབུ་དཔངས་མཐོ་བར་འདུག་པས།",
    "བསོ་ཡང་བསོད་པར་འདུག་སྙམ་སང་འདེགས་གནང་འདེགས་རང་ལ།",
    "རང་རང་སྐལ་པའི་ཆ་ཤས་གྱུར་པ་ནི།",
    "ཁོ་རང་ལ་ཡང་དངོས་ཀྱིས་ཁྱེད་ཀྱི་མགོ་འདི་མི་ལག་ཏུ་མཆོར་ངེས་འདུག་པས་འགྲོ་འགྲོ་མངས་པ་མི་དགའ་ཡང་ཡང་ལབས།",
    "དེའི་གནམ་གང་ལ་རྗེ་རབ་གསལ་ཟླ་མགོན་པ་གཤེགས་པར་འདུག་པ་ལ།",
    "དུས་ཟིངས་པས་ངེད་ལ་ལོན་ཆ་སོགས་མ་ཐེངས་པ་ཡིན་ཚོད་དུ་འདུག་པ་ལ།",
    "གཞིས་ཀ་ནས་དངུལ་སྐུའི་སྐུ་འདྲ་དྲན་པའི་གསལ་འདེབས་སུ་མཚན་ཐོགས་པ་དེའི་རབ་གནས་ཀྱང་སྟག་ལུང་རང་དུ་ཞུར་གནས་བྱུང་བ་བཞིན་བསྒྲུབས།",
    "ངེས་འབྱུང་ཆེན་པོའི་དགའ་གདུང་རང་གྲོལ་མཆོག།",
    "ཡུད་ཙམ་དྲན་ཚེ་བཟོད་བླགས་མི་འདུག་ན།",
    "འོས་བབ་ཏུ་འདུག་ཟེར།",
    "ཁོང་རྣམས་བདེན་པར་འདུག་སྙམ་པ་ལས།",
    "ཨ་ཇོ་ཨའུ་པ་སྐུ་ཚེའི་འདུ་བྱེད་བཏང་པ་ཡིན་ཚོད་དུ་འདུག་ཅིང་།",
    "བདག་ཅག་སྐྱོ་བའི་ཚུལ་དེ་མཐོང་ཙ་ན།",
    "དགའ་བར་བྱེད་པའི་རོ་ནི་ནང་ན་འདུག།",
    "འཆི་བ་ལས་མ་འདས་འདུག་པས།",
    "ཚེ་འདི་དང་བསྟུན་ན་འདིར་ཡང་འདུག་སྙམ་ནས་ལན་དུ།",
    "དེའི་དུས་སུ་ཤིང་ཁ་གཅིག་ན་འདབ་ཆགས་གཅིག་འདུག་ནའང་།",
    "ཟེར་བའི་དང་པོ་དེ་ཁྱེད་ལ་ཚང་འདུག་གསུང་།",
    "བུ་ཞིག་འདུག་པའི་འཁྲིས་སུ།",
    "སྒྲོ་འདོགས་སྐུར་འདེབས་ཀྱི་གཞི་ལས་མི་འདུག་པས་ཡི་གེར་མ་བྲིས་སོ།",
    "དེ་བཞིན་དུ་མི་གོ་འདུག་གསུང་།",
    "ཌཱ་ཀིའི་ཚོགས་ཀྱིས་སྐོར་ནས་བཞུགས་འདུག་པ་ལ།",
    "གཉིས་མེད་འོད་གསལ་གྱི་ངང་ལ་གནས་འདུག་གོ།",
    "ཅེས་སོགས་དབྱངས་དང་བཅས་བློ་ཀ་བརྒྱད་པོ་དེ་མཛད་ཀྱི་འདུག་པས་ངས་ཀྱང་བློ་ལ་ཟིན།",
    "ཞབས་སྤྱི་བོར་བླངས་གཡོན་ཕྱོགས་སུ་སྐོར་བ་བྱས་འགྲོ་ཡི་འདུགངས་ཀྱང་ཞབས་སྤྱི་བོར་བླངས།",
    "ཚིགས་བཅད་རྣམས་ཀྱང་བློ་ལ་ཁ་ལེ་འདུག་གོ།",
    "དཔལ་བི་རུ་པ་པ་ཡང་དོན་ཅིའི་ཚུལ་དུ་བཞུགས་འདུག་པ་ལྟ་བུ་བྱུང་ཞིང་།",
    "བསུ་བ་གྱ་ནོམ་པ་བྱེད་ཀྱི་འདུག་ངས་ཀྱང་ཕྱིན་པས།",
    "ཤིན་ཏུ་དགྱེས་པའི་རྣམ་པ་མཛད་ཀྱི་འདུག་པ།",
    "དཔལ་ལྡན་ས་སྐྱ་པ་ཡབ་སྲས་ལ་བཀའ་བབས་པའི་གསོ་སྦྱོང་རང་ཉིད་ཀྱིས་བླངས་པའི་ཆོ་ག་དང་།",
    "སྔ་གོང་རྨི་ལམ་དུ་རྣམ་རྒྱལ་མཆོད་རྟེན་རྡོ་རྒྱུས་ལ་གྲུབ་པའི་སྐུ་ཅིག་འདུག་པའི་སྒོ་ན་དགེ་སློང་ཞི་དུལ་ཅན།",
    "དེའི་ནུབ་རྨི་ལམ་ཡང་རང་ཟིན་བྱུང་བ་དང་།",
    "གཉིད་སད་ཙ་ནའང་།",
