    "ལྔ་ཉིད་ལྔ་ཉིད་རབ་ཏུ་དབྱེ་བ་བྱས་པ་ལས།",
    "རྐང་པ་བཞི་པས་ལམ་གྱི་རྗེས་སུ་བསྔགས་པ་གསུངས་ཏེ།",
    "སེམས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྣམ་པ་ཐམས་ཅད་དང་ལྡན་པའི་སྟོང་པ་ཉིད་ཀྱི་གྲུའི་ལམ་ལ་སེམས་གདོས་པ་འཛིན་པར་ཡང་དག་པར་བསྐྱེད་པ་དང་འགྲོགས་ཏེ་ནག་པོ་སྤྱོད་པའི་ཞབས་བདེ་བ་ཆེན་པོའི་གླིང་དང་མཚུངས་པར་འགྲོ་བར་བྱེད་དོ།",
    "གངྒཱ་དང་ནི་ཡ་མུ་ན་དབུས་གཙང་པོ་འབབ།",
    "གཡོན་དང་གཡས་ཀྱི་ལམ་མི་བསམ་ཞིང་རྒྱུན་མི་འཆད་པར་འབབ།",
    "དེའི་ཕྱིར་དེ་ཉིད་གྲུ་དགོངས་པའི་སྐད་དུ་རྟོགས་པར་བྱེད་དོ།",
    "ཅིའི་ཕྱིར་ཡུན་རིང་སྡོད་པར་བྱེད།",
    "དེ་བཞིན་ཉིད་ཀྱི་རྗེས་སུ་སེམས་པས་རྒྱུན་མི་འཆད་པར་བསྒྲོད་ཅིང་གོམས་པར་བྱའོ།",
    "རྐང་པ་གཉིས་པས་གོམས་པའི་རྗེས་སུ་བསྔགས་པ་གསུངས་ཏེ།",
    "དྲི་མ་མེད་པ་བརྒྱ་ཡིས་འཁོར་ལོའི་ཕྱོགས་སུ་འབབ་པར་བྱའོ།",
    "རྐང་པ་གསུམ་པས་གོམས་པའི་ཁྱད་པར་ལས་སྣང་བ་གསུམ་འགོག་པ་གསུངས་ཏེ།",
    "འགྲོན་བུ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཕྱི་རོལ་དུ་ཕན་ཚུན་དུ་སྒྲོལ་བར་བྱེད་པ་ལ་གླུ་དབྱངས་འགྲོན་བུ་ལ་སོགས་པ་ལེན་པར་བྱེད་པའོ།",
    "བརྟན་པའི་རྐང་པས་དེ་ཁོ་ན་ཉིད་ཀྱི་དོན་བརྟན་པར་བྱེད་དོ།",
    "རྐང་པ་གསུམ་པས་ལམ་གྱི་ཆེ་བའི་བདག་ཉིད་གསུངས་ཏེ།",
    "འདིར་ཡོངས་སུ་དག་པའི་ཨ་ཝ་དྷཱུ་ཏཱིར་ཁྱད་པར་གྱི་དགའ་བའི་ལམ་གྱིས་འགྲོ་བར་གྱུར་པ་ལ་འགག་དང་ཁྲལ་ས་དང་ཤོ་གམ་དང་འཕྲང་ལ་སོགས་པའི་འཇིགས་པ་མེད།",
    "མིག་ནི་གཡོ་བ་མེད་བྱས་ཏེ།",
    "མགོ་ནི་ཅུང་ཟད་སྨད་བྱས་ནས།",
    "རྒྱུན་མི་འཆད་པར་ནམ་མཁའི་ཕྱོགས་སུ་ཉི་ཟླ་འཁོར།",
    "དགེ་སྡིག་གཉིས་ཀྱི་ལྕགས་སྒྲོག་འཐེན་ནས་ཀ་བའི་གནས་སུ་ཉེད་པར་བྱེད།",
    "ནམ་མཁའ་གཞོམ་མེད་སྒྲ་རུ་གྱུར་ནས་སེམས་ནི་མྱ་ངན་འདས་པར་བཞུགས།",
    "རབ་ཏུ་འཇིགས་ཤིང་སྐྲག་པ་ནི་སྟོང་པ་ཉིད་ཀྱི་གདངས་ཐོས་ནས་མགྲིན་པར་སྒྲོགས་པར་བྱེད་དོ།",
    "བརྟན་པའི་རྐང་པས་དེའི་ཤིན་ཏུ་དགའ་བས་རབ་ཏུ་ཚིམ་པ་གསལ་བར་གསུངས་ཏེ།",
    "རྐང་པ་གཉིས་པས་དེ་ཁོ་ན་ཉིད་གསལ་བར་གསུངས་ཏེ།",
    "ས་ཆུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "བཅུད་ཆེན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་གཅིག་པའི་གཟུང་བ་ལ་རྣམ་པར་རྟོག་པ་མི་བྱའོ།",
    "རྐང་པ་བཞི་པས་རྣམ་པར་མི་རྟོག་པ་རབ་ཏུ་རྟོགས་པར་བྱ་བའི་ཕྱིར་གསུངས་ཏེ།",
    "རྣམ་པར་མི་རྟོག་པའོ།",
    "དེ་ཉིད་རྣམ་པར་མི་རྟོག་པ།",
    "གཞོམ་མེད་དབྱིག་དྲང་ཨ་ཝ་དྷཱུ་ཏཱིར་བྱས།",
    "བཟའ་མཆོག་རོ་མཉམ་མཚན་རྣམས་བརྩི་བྱས་ནས།",
    "ཡུལ་གྱི་འཁོར་ལོ་ཅན་ཨ་ཝ་དྷཱུ་ཏཱིར་ལྷན་ཅིག་བྱས་ནས་གཞོམ་དུ་མེད་པའི་སྒྲ་དབྱིག་པ་ལ་སྦྱར་ཏེ།",
    "དེ་ཉིད་སྲིད་པ་ལས་རྣམ་པར་གྲོལ་བར་བྱེད་པ་སྟེ།",
    "སྲིད་པར་འཆིང་བར་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "དངོས་པོར་འཆིང་བ་གསད་པར་བྱ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྐང་པ་གཉིས་པས་དེའི་དོན་བསྟན་པར་བྱེད་དོ།",
    "དེ་བཞིན་དུ་མཚན་ཡང་དག་པར་བརྗོད་པ་ལས་ཀྱང་།",
    "ཅེས་པས་དེ་ལ་མི་འགྱུར་བའི་ངོ་བོ་ཉིད་རྟོགས་པས་བཟའ་མཆོག་ནི་སེམས་ཀྱི་རྒྱལ་པོའི་ཉེས་པའི་མཚམས་ཀྱི་བུ་ག་བརྩིས་ནས་དེ་ཉིད་པི་ཝང་ཞབས་ཀྱི་དེ་ཁོ་ན་ཉིད་ཀྱི་དོན་གྱི་སྒྲའི་སྒོ་ནས་རྟོགས་པར་བྱ་བའི་ཕྱིར་གསུངས་སོ།",
    "རགས་པར་སྒྲ་ཡི་དངོས་པོར་གསུངས།",
    "རྐང་པ་གསུམ་པས་ངོ་བོ་ཉིད་ཀྱི་རང་བཞིན་གསུངས་ཏེ།",
    "དེ་ལ་དེ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དོན་དེ་ཉིད་དོན་དམ་པ་དང་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་དོན་ཁོང་དུ་ཆུད་པས་ནག་པོ་སྤྱོད་པའི་ཞབས་ཀྱིས་ཌོམྦི་ནི་དགོངས་པའི་སྐད་ཀྱིས་གསུངས་ཏེ།",
    "དོང་དུ་ལྷུང་ན་ག་པུར་འཇིག་པར་བྱེད།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྐང་པ་གསུམ་པས་ཌོམྦི་ནིའི་རང་བཞིན་གསུངས་ཏེ།",
    "དུར་ཁྲོད་གནས་སུ་གནས་པར་རྟག་ཏུ་རབ་ཏུ་དགའ་བ་འགའ་ཞིག་རྣལ་འབྱོར་པས།",
    "རྐང་པ་གཉིས་པས་ཌོམྦི་ནཱི་བག་མའི་འབྲས་བུ་གསུངས་ཏེ།",
    "རྐང་པ་གསུམ་པས་རྣལ་འབྱོར་མའི་སྟོབས་གསུངས་ཏེ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "བདག་ནི་གཞོན་ནུ་དར་མ་རྫོགས་པར་གྱུར།",
    "ཀུཀྐུ་རཱི་པའི་སྲིད་པ་བརྟན་པར་སྨྲ།",
    "དྷཱུའི་རྐང་པས་དེའི་དོན་བརྟན་པར་གསུངས་ཏེ།",
    "རྐང་པ་བཞི་པས་མངོན་སུམ་དུ་བྱས་པས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གང་དུ་བྱི་བ་འདི་ཡི་རྐང་པ་བཅད་བྱས་ན།",
    "དོན་དེ་ཉིད་བྱི་བ་དགོངས་པའི་སྐད་ཀྱིས་འདུ་ཤེས་གསུམ་པའི་ཞབས་ཀྱིས་གསུངས་ཏེ།",
    "རྐང་པ་གཉིས་པས་བྱི་བ་སེམས་ཀྱི་ཐ་སྙད་ཀྱི་རྗེས་སུ་བསྔགས་པ་གསུངས་ཏེ།",
    "ཀྱེའི་རྣལ་འབྱོར་པ་མན་ངག་ཐོས་པ་དེ་ཡིས་དེའི་དངོས་པོར་སྒྲོ་བཏགས་པར་མི་བྱའོ་ཞེས་སོ།",
    "རྐང་པ་གསུམ་པས་དེའི་ངོ་བོ་གསུངས་ཏེ།",
    "དེའི་ཕུང་པོ་ཟ་བས་དབྱེ་བས་རྣམ་པར་དཔྱོད་པས་ཀྱེའི་རྣལ་འབྱོར་པ་གདམས་པ་ཐོབ་པ་ལ་མེད་པའོ།",
    "ཆུ་སྐྱེས་རྣམ་རྒྱས་གསུངས་ལ་གཤིན་རྗེའི་རྒྱལ་མེད་ཆུ་སྐྱེས་སྦྲང་རྩི་བུང་བ་འཐུང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྐང་པ་ལྔ་པས་སེམས་ཀྱི་བྱི་བའི་རང་བཞིན་གསུངས་ཏེ།",
    "དེ་བཞིན་གྲོལ་བྱས་གྲོལ་བར་བྱ།",
    "ལོག་པར་སྒྲོ་བཏགས་བྱས་དེ་ལས།",
    "གསོན་དང་ཤི་བ་དག་ལ་ཁྱད་པར་མེད།",
    "དེ་བྱེད་གསེར་འགྱུར་བཅུད་ལེན་སྒྲུབ་པར་བྱེད།",
    "རྐང་པ་གཉིས་པས་སྐྱེ་བའི་རང་བཞིན་གསུངས་ཏེ།",
    "དེ་ཉིད་འཇིག་པར་མ་མཐོང་སྟེ།",
    "རྣམ་པར་རྟོག་པ་ཐམས་ཅད་སྤངས།",
    "རྣམ་པར་རྟོག་བྱེད་རྨི་ལམ་འབྲས་བུ་མངོན་འདོད་ཅན།",
    "རྐང་པ་གསུམ་པས་རང་ཉིད་ཀྱི་རྗེས་སུ་བསྔགས་པ་གསུངས་ཏེ།",
    "བདག་ནི་སླར་ཡང་འཆི་བ་ལ་སོགས་པའི་འཇིགས་པའི་ཐེ་ཚོམ་གྱི་རྣམ་པར་རྟོག་པ་མེད་པའི་གཟུགས་སོ།",
    "རྐང་པ་བཞི་པས་སླར་ཡང་རྗེས་སུ་བསྔགས་པ་གསུངས་ཏེ།",
    "རྐང་པ་ལྔ་པས་ལམ་གྱི་བདག་ཉིད་ཀྱི་ཆེ་བ་གསུངས་ཏེ།",
    "གསོན་པོ་གསོད་པར་མ་བྱེད་ཤི་བའི་རོ་ནི་མ་བླང་ཅིག།",
    "ཤ་ནི་མེད་པར་བྷུ་སུ་ཀུ་པ་ཁྱིམ་དུ་འཇུག་མ་བྱེད།",
    "རྒྱ་དང་རྡོ་ལྕགས་ཐག་པ་མེད་པར་རི་དྭགས་རྒྱག་ཅིང་བྲོས།",
    "མཆོང་ཞིང་མཆོང་ཞིང་བརྒྱུག་པས་ནམ་མཁའི་མཐིལ་དུ་ནུབ་པར་གྱུར།",
    "རྔོན་པ་ཞེས་པ་ནི་རང་བཞིན་མེད་པར་བྱེད་པའི་ཐབས་ཚོལ་བས་འགྲོ་བར་བྱའོ།",
    "ཡིད་གཅིག་ཏུ་བྱེད་པ་ནི་རྣམ་པར་རྟོག་པ་མེད་པར་འགྱུར་བ་རང་ཉིད་ཀྱིས་བདག་ལ་ཡང་དག་པར་འབོད་པར་བྱེད་པའོ།",
    "དེའི་ཕྱིར་དྷཱུའི་རྐང་པས་བརྟན་པ་ལ་དམིགས་པ་གསལ་པོར་བྱེད་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྐང་པ་གཉིས་པས་ལམ་གྱི་ཐབས་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་དེ་ལ་བདེ་བ་ཉམས་སུ་མྱོང་བའི་ངོ་བོ་ཉིད་ཐོབ་པ་དེའི་ཚེ་གང་དུ་ཡང་བརྗོད་པར་མི་ནུས་པའོ།",
    "དགའ་བས་མཉེས་གཤིན་འཇིག་རྟེན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྐང་པ་གསུམ་པས་གོམས་པའི་ཁྱད་པར་དུ་གསུངས་སོ།",
    "བཟའ་བ་དང་བཏུང་བ་ནི་རང་བཞིན་མེད་པར་བྱེད་པའོ།",
    "གང་ཞིག་ཐིག་ལེ་དཀར་འཛིན་ལྷུང་ན་ཉིན་མཚན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྐང་པ་བཞི་པས་འབྲས་བུ་རྫོགས་པ་གསུངས་ཏེ།",
    "རྒྱ་དང་རྡོས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དེ་ལ་བདེ་བ་ཆེན་པོའི་དགའ་བ་ནི་རྒྱ་ཞེས་ཏེ་དགོངས་པའི་སྐད་ཀྱི་སྐུའི་དགའ་བའི་རྣམ་པར་རྟོག་པའོ།",
    "ཐག་པ་ཞེས་པ་ནི་ཐུགས་ཀྱི་དགའ་བའི་རྣམ་པར་རྟོག་པའོ།",
    "བྲོས་པ་ནི་རང་བཞིན་མེད་པར་གྱུར་པ་རྟག་ཏུ་གོམས་པའི་རྣལ་འབྱོར་པས་ནམ་མཁར་འོད་གསལ་ལ་ཐིམ་པར་གྱུར་པའོ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དྷཱའི་རྐང་པ་དོན་དེ་ཉིད་བརྟན་པར་བྱེད་དོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྐང་པ་གསུམ་པས་དེའི་ཁྱད་པར་གྱི་མཚན་ཉིད་གསུངས་ཏེ།",
    "ངང་པའི་རྒྱལ་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དཔེར་ན་ཕྱི་རོལ་དུ་ངང་པའི་རྒྱལ་པོས་ཆུ་དང་འོ་མ་འདྲེས་པའི་ཆུ་རྣམ་པར་ཕྱེ་ནས་འོ་མ་འཐུང་བར་བྱེད་དོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དྲི་མེད་གོས་ཞེས་པ་ནི་རང་བཞིན་གྱིས་འོད་གསལ་གྱིས་ཡོངས་སུ་དག་པར་བྱེད་དོ་ཞེས་སོ།",
    "དྷཱུའི་རྐང་པས་ཡང་དག་པར་རྟོགས་པ་བརྟན་པར་བྱེད་དོ།",
    "རྐང་པ་གཉིས་པས་རྟེན་དང་བརྟན་པ་གསུངས་ཏེ།",
    "ནམ་མཁའ་ཁེངས་གྱུར་ཞེས་པ་ནི་ཡོངས་སུ་དག་པའི་འོད་གསལ་གྱིས་ཡོངས་སུ་སྦྱར་བར་བྱས་པས་སོ་སོར་ལྟ་བ་དང་ལྡན་པས་བདག་གནས་པའོ།",
    "རྐང་པ་གསུམ་པས་ཡིད་ཆེས་པའི་ཚོགས་པ་གསུངས་ཏེ།",
    "རྐང་པ་བཞི་པས་རྣལ་འབྱོར་པའི་རྗེས་སུ་བསྔགས་པ་གསུངས་ཏེ།",
    "དེ་ནི་དཔལ་ལྡན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཡེ་ཤེས་ཀྱི་དགའ་བའི་བདེ་བས་གང་ཞིང་བརླན་པ་གྲུབ་པའི་སློབ་དཔོན་ཤཱནྟི་པས་དོན་དེ་ཉིད་སྐྱེ་བོ་རྣམས་ཀྱི་ཕྱིར་རབ་ཏུ་གསུངས་སོ།",
    "ཤཱནྟིའི་ཞབས་ཀྱིས་གསུངས་པ།",
    "རྣམ་པར་དཔྱད་བྱས་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྐང་པ་གཉིས་པས་དོན་དེ་ཉིད་བརྟན་པར་བྱེད་དོ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྐང་པ་གསུམ་པས་ལམ་གྱི་རྗེས་སུ་བསྔགས་པ་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་ཤཱནྟིའི་ཞབས་ཀྱིས་གསུངས་ཏེ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྐང་པ་བཞི་པས་རང་བཞིན་ལ་དམིགས་པ་གསུངས་ཏེ།",
    "བྱ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གྲུབ་པའི་སློབ་དཔོན་ཤཱནྟིའི་ཞབས་ཀྱིས་རང་ཉིད་བྱ་བ་དང་བྱེད་པ་དང་བྲལ་བའི་ཕྱིར་བླ་ན་མེད་པའི་གོ་འཕང་དུ་གསུངས་སོ།",
    "རི་བོང་འཛིན་བསྐྱོད་མྱ་ངན་འདས་པར་འགྲོ།",
    "ཁྱད་པར་དགའ་བ་མཚན་ཉིད་དང་བྲལ་བ།",
    "དོན་དེ་ཉིད་ལྷན་ཅིག་སྐྱེས་པའི་རོས་ཡོངས་སུ་གང་བའི་གྲུབ་པའི་སློབ་དཔོན་བྷུ་སུ་ཀུས་གསུངས་ཏེ།",
    "དེའི་གནས་སུ་འབབ་པར་བྱེད་དོ།",
    "དེ་རྣམས་ཀྱི་དགའ་བ་ལ་སོགས་པའི་ཚོགས་པས་ཡན་ལག་ཡང་དག་པར་ཚིམ་པར་གྱུར་པའོ།",
