    "སྤྱོད་པ་བགས་ཀྱིས་སྤྱད་པར་བྱ།",
    "དཔལ་ལྡན་ལཱུ་ཡི་ཞབས་སོགས་གྲུབ་པ་རྣམས་ཀྱིས་གསུངས་ཤིང་ཡ་མཚན་སྤྱོད་པའི་གླུ་ཡི་ཚོགས།",
    "ལམ་མཆོག་དྲི་མ་མེད་པའི་ཚིག་ནི་རྟོགས་པར་བྱ་ཕྱིར་དེ་ཡི་འགྲེལ་པས་གསལ་བར་བྱ།",
    "བརྟན་པར་མཛོད་ཅིག་བདེ་ཆེན་ཡོངས་ཀྱི་ཚད།",
    "བདེ་བ་རྩ་ནས་བཏོན་ན་ངེས་པར་འཆི།",
    "རིམ་པ་ལྔ་པའི་ཐབས་འཛིན་པ་ལ་ཞུགས་པ་སྔོན་དུ་འགྲོ་བ་ཟུང་འཇུག་བཅིངས་པའི་ངོ་བོ་ལྷན་ཅིག་སྐྱེས་པའི་དགའ་བའི་འབྲས་བུ་རྟག་ཏུ་ཚོལ་བ་ན་དེ་ཡང་རྡོ་རྗེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་མངོན་སུམ་དུ་བྱེད་པར་འགྱུར་རོ།",
    "འཕགས་པ་ལྷའི་ཞབས་ཀྱིས་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་ཡང་ཀླུ་སྒྲུབ་ཞབས་ཀྱིས་ཀྱང་རྡོ་རྗེའི་བཟླས་པ་ལས་གསུངས་ཏེ།",
    "དེ་ཡི་ཞབས་ཟུང་སྤྱི་བོས་གུས་པར་འདུད།",
    "རྐང་པ་གཞན་གྱིས་འདོད་ཆགས་ཆེན་པོའི་ཚུལ་གྱི་ཏིང་ངེ་འཛིན་ཉེ་བར་གསལ་ཞིང་རྗེས་སུ་བསྔགས་པ་གསུངས་ཏེ།",
    "ཞེས་པའི་ཚིག་ལས་འདོད་ཆགས་ཆེན་པོའི་ཚུལ་གྱི་སྤྱོད་པའང་གསུངས་ཏེ།",
    "ལྷན་སྐྱེས་སྡུག་བསྔལ་ཉིད་ཀྱང་འཇོམས་པར་བྱེད།",
    "སྨྲས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དང་པོ་སྒྲུབ་པའི་སློབ་དཔོན་ལཱུ་ཡི་ཞབས་ཀྱིས་འདི་བཞིན་དུ་གསུངས་ཏེ།",
