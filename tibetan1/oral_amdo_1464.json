    "དེ་ནས་ཀོ་ཤཱམཱིའི་རྒྱལ་པོས་དམག་མང་པོ་བསད་པའི་སྡིག་སྦྱང་བའི་ཕྱིར་འཛམ་བུའི་གླིང་གི་དགེ་སློང་རིལ་སྤྱན་དྲངས་ནས་ཀོ་ཤཱམཱིའི་ཡུལ་དུ་ཕྱིན་པའི་རྗེས།",
    "རྣམ་ཐོས་ཀྱི་བུས་སྣག་གི་རི་དྲིལ་ཏེ་ཆབ་ཕོ་ནས་དོགས་གདའ་པ་དང་།",
    "ཁ་རེའུ་སྟེང་ཞེས་བགྱི་བ་ལ་སོགས་པ་དྲང་སྲོང་མང་པོའི་ཡུན་མི་རིང་བ་ཞིག་ཏུ་ལི་ཡུལ་ཕྱོགས་ཀྱི་རི་རྩ་དག་ན་གནས་ཏེ།",
    "རྒྱལ་པོ་མ་སྐྱེས་དགྲའི་བུ་མོ་དྲི་མ་མེད་པའི་འོད་དང་།",
    "ལྷའི་བུ་མོ་བློ་རབ་བརྟན་དང་།",
    "ལྷ་མོ་འཕྲོག་ིམ་ལ་སོགས་པ་འཁོར་དང་བཅས་པ་ལ་གཏད་ནས་བཅོམ་ལྡན་འདས་ཉིད་ཀྱང་འཁོར་རྣམ་བཞི་འབུམ་ཕྲག་དུ་མ་དང་ནམ་མཁའ་ལ་ལྡིངས་ནས་ལི་ཡུལ་དུ་གཤེགས་ཏེ།",
    "པདྨ་རེ་རེའི་ཁར་ཡང་མེ་མར་ཁ་རེ་རེ་བྱུང་དེ་ནས་འོད་ཟེར་དེ་དག་གཅིག་ཏུ་འདུས་ནས་ཆབ་ཀྱི་སྟེང་དུ་གཡས་ཕྱོགས་སུ་ལན་གསུམ་བསྐོར་ནས་ཆུའི་དཀྱིལ་དུ་ནུབ་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་མོ་དྲི་མ་མེད་པའི་འོད་དང་།",
    "ལྷ་མོ་ལྕགས་ཀྱུ་ཅན་འཁོར་སྟོང་ཕྲག་བཅུ་དང་།",
    "ལྷ་མོ་གནས་ལྡན་མ་འཁོར་ལྔ་སྟོང་དང་།",
    "རིགས་ཀྱི་བུ་མོ་དྲི་མ་མེད་པའི་འོད་དང་།",
    "ལྷ་མོ་འཕྲོག་མ་འཁོར་དང་བཅས་པ་ལ་སོགས་པས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་དམ་ཚིག་བཅས་ནས་ལི་ཡུལ་བསྲུང་བར་ཞལ་གྱིས་བཞེས་ཏེ།",
    "ད་ལྟར་འུ་ཐེན་གྱི་སྐུ་མཁར་མཆིས་པའི་དོག་སར་ཀུས་པོ་ཡེན་དུ་ཤུལ་ཕྱུང་ནས་དྲོ་དགོངས་ཤིག་ིབཏབ་པའི་ནུབ་མོ་རྒྱལ་པོའི་བཙུན་མོ་དམ་པ་ལས་ཁྱེའུ་མཚན་དང་ལྡན་པ་བཟང་པོ་ཞིག་བཙས་ནས།",
    "སྔོན་རྒྱལ་པོའི་བཙུན་མོས་དེ་ཀུན་དགའ་ར་བའི་སྐྱེད་མོས་ཚལ་དུ་མཆིས་པ་ལས།",
    "རྫིང་བུའི་ནང་དུ་ཁྲུས་བགྱིད་ཅིང་མཆིས་པའི་དུས་ན་རྣམ་ཐོས་སྲས་འཁོར་དང་བཅས་པ་ནམ་མཁའ་ལ་གཤེགས་པས་ཀྱང་༧ གཟིགས།་",
    "རྒྱལ་པོའི་བཙུན་མོས་ཀྱང་རྣམ་ཐོས་སྲས་ཀྱི་སྲས་བྱད་བཞིན་བཟང་པོ་མཐོང་བས་སེམས་ཀྱི་བུར་ཆགས་པས་ཀུས་པོ་ཡེན་དུ་བཙས་ནས།",
    "དེ་ནས་རྒྱ་རྗེས་བུ་དེ་གསོས་ནས་སླད་ཀྱི་ཁྱེའུ་ཆེན་པོར་སྐྱེས་ནས་རྒྱའི་བུ་སྤུན་དང་བྱིས་པ་རྩེ་རྩེ་བ་ལས་འཐབས་ནས་ཁྱོད་རྒྱ་རྗེའི་བུ་མ་ཡིན་ནོ་ཞེས་བགྱིས་པ་དང་།",
    "རྒྱ་རྗེའི་ཞལ་ནས་ཁྱོད་ངའི་བུ་ཡིན་ཏེ།",
    "ཡུལ་ལྗོངས་སྟོང་པ་བཟང་པོ་ཞིག་གདའ་ནས་འདི་བདག་ཅག་གི་རྒྱལ་བུ་ས་ནུའི་ཡུལ་སར་རུང་ངོ་ཞེས་མཆིད་གྲོས་སུ་འཚལ་ནས་ཡུལ་ས་དེ་ལྟ་ཞིག་མཆིས་མཆིས་པ་དང་།",
    "ཡ་ཤས་ཀྱང་རྒྱལ་བུ་ས་ནུ་མེ་སྐར་ན་མཆིས་པའི་སྟེང་དུ་ཕོ་ཉས་འཕྲིན་ོཔ་ལས་ཁྱོད་ནི་རྒྱལ་རིགས།",
    "ཁྱོད་ཀྱིས་ནི་རྒྱལ་པོ་བྱས།",
    "བདག་གིས་ིབློན་པོ་བྱས་ཏེ་འུ་ཐེན་གྱི་ལྗོངས་འདིར་ཡུལ་སར་བཙུགས་ན་རུང་ངོ་ཞེས་མཆི་ནི།",
    "དཔལ་གྱི་ལྷ་མོ་བྱུང་ནས་བཤུག་ཏེ།",
    "དཔལ་གྱི་ལྷ་མོ་བཞུགས་པའི་སྟེང་ཁང་རེ་རེ་ཞིང་བརྩིགས་པ་ཡང་དེང་སང་གི་བར་དུ་མཆིས་ཏེ།",
    "འབངས་འཁོར་དང་བཅས་པ་ཀུན་གྱིས་ཀྱང་ཙར་མར་གཙུག་ལག་ཁང་རེ་རེ་བརྩིག་པར་གསོལ་ནས་བརྩིགས་པ་མང་པོ་ཞིག་བྱུང་བ་ལས་རྒྱལ་པོས་བསམས་པ།",
    "དེ་བཞིན་གཤེགས་པའི་སྤྲུལ་པ་མངོན་སུམ་དུ་གཤེགས་པའི་དན་རྟགས་སུ་གོར་མ་ལ་ཞབས་ཀྱིས་བཅགས་པའི་རྗེས་ད་དུང་གི་བར་དུ་ཙར་མ་ན་མཆིས།",
    "མཆོད་རྟེན་འདི་དྲི་གཙང་ཁང་གི་ནང་ན་བཞུགས་ཏེ།",
    "དེང་སོང་གི་བར་དུ་མངོན་རྟགས་དང་།",
    "དེ་ནས་དེའི་འོག་ཏུ་རྒྱ་གར་ཡུལ་ནས་འཕགས་པ་དགྲ་བཅོམ་པ་བུདྡྷ་དུ་ཏ་དང་།",
    "དེ་ནས་རྒྱལ་པོས་མཆོད་རྟེན་འདི་གང་གི་དུས་ན་སུས་བརྩིགས་ཞེས་སྨྲས་པ་དང་།",
    "༡༧༥ནི་ལམ་སྟོན་པའོ་ཞེས་མོ་རྒུ་བདེ་ཤི་བྱ་བར་བཏགས་ཏེ།",
    "ཐོག་མ་མོ་རྒུ་བདེ་ཤིའི་མིང་ནི་དེ་ནས་བྱུང་སྟེ་དེང་སང་གི་བར་དུ་ཡང་ཐུབ་ལྡན་དང་།",
    "མོ་རྒུ་བདེ་ཤིར་བསྒོ་བ་ལགས།",
    "ཡོན་བདག་འཕགས་པ་ཤ་སྟག་གིས་མཛད་ལ།",
    "གཙུག་ལག་ཁང་གི་སྲུང་མར་ཞལ་གྱིས་བཞེས་པ་ཡང་རྣམ་ཐོས་ཀྱི་སྲས་དང་།",
    "དེ་ནས་དེའི་འོག་ཏུ་རྒྱལ་པོ་བི་ཛ་ཡ་ཛ་ཡ་ཞེས་བགྱི་བས་རྒྱ་རྗེའི་བུ་མོ་པུ་ཉེ་ཤྭ་ར་ཞེས་བགྱི་བ་མཆིས་འབྲང་དུ་བླངས་ནས་རྒྱ་རྗེའི་བུ་མོ་དེས་ལི་ཡུལ་དུ་སྲིན་བུའི་ས་བོན་ཞིག་འཚལ་ཏེ་མཆིས་ནས་ཡུལ་ཡ་ཤ་བགྱི་བར་སྲིན་བུ་གསོས་པ་དང་།",
    "༡༨ ༨རྒྱལ་པོའི་བཙུན་མོ་བགྱིད་པ་དེས་སྦྲུལ་གདུག་པ་མང་པོ་མ་ཞར་གསོ་ཞིང་མཆིས་ཏེ་ཆེན་པོར་གྱུར་པ་དང་།",
    "དེའི་སླད་དུ་དཔྱིད་ཟླ་ར་བའི་ངོ་ཐོག་ཐག་བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པའི་སྐུའི་གཟུགས་བརྙན་མ་ཞོ་པོ་ཏརྱ་ཞེས་བགྱི་བའི་གཙུག་ལག་ཁང་ན་བཞུགས་སོ་ཞེས་འཕགས་པ་དག་གིས་ལུང་བསྟན་པས་དེང་སང་གི་བར་དུ་ཡང་།",
    "དེང་སོང་གི་བར་དུ་ཡང་དངོས་རྟགས་དང་མཚན་མ་དག་ཀྱང་འབྱུང་ངོ།",
    "ཁྱོད་ཀྱིས་བདག་ལ་མདའ་འཕངས་ཏེ་ཅི་བྱ་ཞེས་བགྱིས་པ་དང་།",
    "རྒྱལ་པོས་ཀྱང་ཤ་བ་མ་ལགས་པར་ཚོར་ནས་བདག་གིས་ནོངས་ན་ཁྲི་ལན་ཞེས་བགྱིས་པ་དང་།",
    "དགེ་སློང་དེའི་མཆིད་ནས་གཅིག་ཏུ་ན་ང་ཁྱོད་ཀྱི་ཕུ་བོ་ཡིན།",
    "དེང་སང་གི་བར་དུ་ཡང་གཟུགས་བརྙན་འདི་བཞུགས།",
    "ལྷ་མོ་ཨ་ཤོ་ཀ་དང་།",
    "སྐུ་མཁར་གྱི་ནང་དུ་ཡང་ལྷོ་སྒོའི་སྒེའུ་ཆུང་མཆིས་པའི་ནང་ལོགས་ན་ཀླུའི་རྒྱལ་པོ་ཆེན་པོ་བ་རུ་ཎའི་གནས་ཀྱི་སྟེང་ན་པ་རི་ཐ་ཞེས་བགྱི་བའི་མཆོད་རྟེན་གཉེན་པོ་བཞུགས་པའི་དྲུང་ན་ནང་གི་གཙུག་ལག་ཁང་ཞིག་དང་།",
    "དེང་སང་གི་བར་དུ་ཡང་མངོན་རྟགས་དང་མཚན་མ་འབྱུང་ངོ།",
    "བློན་པོ་ཁ་ཅིག་གི་མཆིད་ནས་རྒྱལ་བུའི་གཅེན་རྒྱལ་བུ་འདོན་འདྲོས་རྒྱ་རྗེས་ལི་ཡུལ་གྱི་རྒྱལ་པོར་བསྐོས་ཏེ།",
    "ཁོ་བ་དག་གི་རིན་གྱིས་འཇལ་ཏེ།",
    "ལྷའི་རོལ་མོ་བཟང་པོ་སྔ་ན་མ་བྱུང་བ་དེ་ཐོས་ནས་མི་གཅིག་གིས་གཅིག་སྦྲན་ཏེ་མ་བཟོད་ནས་དེར་མཆིས།",
    "སང་ཏིར་གྱི་གཙུག་ལག་ཁང་གི་འདབས་སུ་མཆིས་པ་དང་།",
    "པུས་མོ་ས་ལ་བཙུགས་༧ ཐལ་མོ་སྦྱར་ཏེ།",
    "སྤྲིང་ཡིག་རེ་༡༨༨དུ་གྱུར་ནས་བདག་གིས་རབ་ཏུ་ནོངས་པ་བཟོད་པར་གསོལ་ཞིང་མཆིས་ན།",
    "གཙུག་ལག་ཁང་གི་སྲུང་མ་ཡང་ལྷ་ཀ་བི་ལ་ཞེས་བགྱི་བས་ཞལ་གྱིས་བཞེས་གསུངས།",
    "དེང་སང་གི་བར་དུ་ལོ་གཅིག་ཅིང་ཡང་རྟག་ཏུ་སྟོན་ཟླ་ར་བ་ཚེས་བདུན་དང་བརྒྱུད་ཀྱི་གདུགས་ལ།",
    "དེའི་འོག་ཏུ་རྒྱལ་པོ་བི་ཛ་ཡ་དྷརྨའི་བུ་རྒྱལ་པོ་བི་ཛ་ཡ་སིང་ཧས་རྒྱལ་པོ་བགྱིད་པའི་ཚེ་ག་འཇག་གི་རྒྱལ་པོས་ལི་ཡུལ་དུ་དམག་མང་པོ་དྲངས་ཏེ།",
    "རྒྱལ་པོ་བི་ཛ་ཡ་སིང་ཧ་དང་འཐབས་པ་ལས་ག་འཇག་གི་དམག་ཕམ་སྟེ།",
    "མཆོད་རྟེན་བརྩིགས་ཏེ་གཙུག་ལག་ཁང་གི་སྲུང་མ་ནི་རྣམ་༧ ཐོས་ཀྱི་སྲས་དང་།",
    "གཙུག་ལག་ཁང་འདི་ཡང་དེང་སང་གི་བར་དུ་མ་ཞིག་སྟེ།",
    "དེའི་འོག་ཏུ་སེང་གེ་མི་ལ་རྒོལ་བ་ཞིག་བྱུང་སྟེ་དམག་གིས་ིབཏབ་ན་ཡང་འཁུམས་ཏེ་རྒྱལ་པོ་གཅིག་པུས་སེང་གེ་དེ་ལ་བརྒལ་ཏེ་ཟིན་ནས་བཀུམ།",
    "གཙུག་ལག་ཁང་གི་དོགས་བརྟག་པའི་ཕུར་བུ་བཏབ་ནས།",
    "རྒྱལ་པོ་རབས་བཅུ་བཞིའི་བར་དུ་རེས་འགའ་ནི།",
    "རེས་འགའ་ནི་ལི་རྗེ་དག་གིས་ཡུལ་གཞན་དུ་དམག་དྲངས་ནས་འབངས་ཀྱི་ཚེགས་གྱུར།",
    "དགེ་སློང་བདུན་ཞིག་ཆབ་ཀྱི་ནང་དུ་ཁྲུས་བགྱིད་ཅིང་རྩེད་མོ་སྣ་ཚོགས་བགྱིད་པ་མཐོང་ནས།",
    "དགེ་སློང་གིས་ཚུལ་མ་ཡིན་པར་བྱེད་ཅེས་བྱས་པ་དང་།",
    "འཕགས་པ་དེ་དག་གིས་རྫུ་འཕྲུལ་རྣམ་པ་སྣ་ཚོགས་བསྟན་པ་མཐོང་ནས་དད་པ་ཡང་ཆེར་སྐྱེས་ཏེ།",
    "བཟོད་པར་གསོལ་ནས་འཕགས་པ་དགྲ་བཅོམ་པ་པོ་ཉན་རེ་ཏ་ལ་སོགས་པ་འཕགས་པ་བདུན་གྱི་ཕྱིར་འགུ་ཞན་༧།",
    "ཞི་བའི་ས་དགུ་ཞན་ཏ་ཞེས་བགྱི་བར་གཙུག་ལག་ཁང་གི་མཚན་མ་ཡང་བརྟགས་ཏེ།",
    "དེང་སང་གི་བར་དུ་མངོན་རྟགས་དང་མཚན་མ་དག་ཀྱང་འབྱུང་ངོ།",
    "རྒྱལ་རབས་དྲུག་གི་བར་དུ་གཙུག་ལག་ཁང་གཞན་མ་བརྩིགས་སོ།",
    "དེ་ནས་སླད་ཀྱིས་རྒྱལ་པོ་དེའུ་ཐེན་གྱི་སྐུ་མཁར་གྱི་སྟེང་གི།",
    "སྐྱེ་བོ་ལ་སོ་སོར་རྨས་ིནས་དགེ་སློང་གི་མཆིད་ནས་ཁྱིམ་པ་སྐྱེ་བོ་འདི་ནི་འཕགས་པ་འཇམ་དཔལ་གྱི་སྤྲུལ་པ་ལགས་ཞེས་མཆི།",
    "དེ་དག་གིས་འོད་ཟེར་བཏང་བ་རྒྱལ་པོའི་སྤྱི་བོར་རིག་པར་མཐོང་སྟེ།་",
    "དེང་སང་གི་བར་དུ་ཡང་དཔྱིད་ཟླ་ར་བ་ཡར་གྱི་ངོ་ལ་བྱང་སྲང་དུ་སྐུ་གཟུགས་ཆེན་པོ་འདྲེན་པ་དང་།",
    "དེ་ཡང་རྒྱལ་པོ་ཁྱོད་ཀྱིས་གཙུག་ལག་ཁང་གཅིག་བརྩིག་པའི་རིགས་སོ་ཞེས་བགྱིས་པ་དང་།",
    "ད་ལྟར་འཛམ་བུའི་གླིང་ན་འཕགས་པ་དག་གིས་བྱིན་གྱིས་བརླབས་ཏེ་འདིར་གཤེགས་པར་གནང་ན།",
    "དེ་ནས་དེའི་འོག་ཏུ་རྒྱལ་པོ་བི་ཛ་ཡ་སང་གྲ་མ་དང་བུ་རྒྱལ་པོ་བི་ཛ་ཡ་སང་གྲ་མ་སྤང་རྒྱ་ཡུལ་དུ་མཆིས་ནས་སླར་ལི་ཡུལ་དུ་མཆི་བའི་བར་དུ་དྲུ་གུའི་དམག་གིས་ཤུལ་ཁུམས་པ་ལས་ཕ་ནི་རྒྱ་ཡུལ་དུ་གུམ་བུ་ཆུང་སྟེ་སླར་མཆི་བའི་རྔོ་མ་ཐོགས་པའི་སྐབས་སུ།",
    "ཐོག་མ་དགེ་སློང་འཕགས་པ་བེ་རོ་ཙ་ན་ཙར་མའི་ཚལ་དུ་གཤེགས་པ་ཕྱུགས་རྫི་ལ་སོགས་པ་མི་འོག་མ་དག་གིས་མཐོང་ནས།",
    "རྒྱལ་པོ་བི་ཛ་ཡ་སཾ་བྷ་བ་ལ་བདག་ཅག་གིས་སྔ་ན་ིམ་མཐོང་བའི་མི་འདི་ལྟ་བུ་ཞིག་ཙར་མའི་ཚལ་དུ་མཆིས་སོ་ཞེས་གསོལ་བ་དང་།",
    "སྤྲིང་ཡིགངེ་༡༨༨གོ་རིམས་ལ་རྒྱལ་པོ་བི་ཛ་ཡ་སིང་ཧ་ཞེས་བགྱི་བ་ཞིག་ཆུང་ངུ་ནས་རྒྱལ་པོར་ཞུགས་ཏེ་ཆུངས་པའི་སྐབས་སུ་བློན་པོ་ཁ་ཅིག་གིས་རྔན་ཅན་བགྱིས་ཏེ།",
    "རྒྱལ་མོ་དང་།",
    "སྔར་བློན་པོ་དེ་དག་གིས་རྔན་ཅན་ིབགྱིས་ཤིང་བརྙས་པ་དེ་དྲན་ནས།",
    "དེ་ནས་སྐུ་མཁར་དུ་མཆིས་ནས་རྒྱལ་པོ་མཆིས་པའི་གནས་ནས་རྒྱལ་མོ་དང་།",
    "རྒྱལ་མོ་མོག་ཤ་ཀོ་ཤ་དང་།",
    "དེ་ནས་དེའི་འོག་ཏུ་རྒྱལ་པོ་བི་ཛ་ཡ་ཤ་ཏའི་ནུ་བོ་ཨ་མ་ཅ་ཟེ་རོའི་མཆིས་འབྲང་ིདུ་སུ་ཧ་ཚོ་ཧ་ཞེས་བགྱི་བ་ཁྱིམ་ཐབ་གུམས་ཡིཔ་དང་།",
    "བུད་མེད་དེ་ལ་རྒྱལ་པོའི་མཆིད་ནས་བདག་དང་མི་ཕྲད་དུ་མི་རུང་ངོ་ཞེས་བགྱིས་པ་དང་།",
    "བུད་མེད་དེའི་མཆིད་ནས་བདག་དགུང་བདུན་ཞིག་ཁྱིམ་ཐབ་ཀྱི་འདུན་བགྱིད་ཅི་སླད་རོལ་དུ་མི་མཆི་བར་ཅི་གནང་ཞེས་གསོལ་པའི།",
    "དེ་བཞིན་གཤེགས་པའི་ཞལ་ཡང་མངོན་སུམ་དུ་མཐོང་ནས་དགྲ་བཅོམ་སྟེ་མིང་ཡང་བུདྡྷཱ་ནནྡར་བཏགས།",
