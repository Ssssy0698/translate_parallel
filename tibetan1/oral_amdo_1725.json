    "ནུབ་མོ་ཞིབ་ཏུ་བཏགས་ཏེ་རུས་ཆེན་ཕྱེ་མ་ཞིབ་མོར་བྱ་།",
    "དྷ་རུ་རའི་འབྲས་བུ་བཟང་ཨ་མྲྀ་ཏར་སྦྱང་བ་ནི།",
    "དགྲའི་སྒོར་སྦས་ན་ཞག་བདུན་ནུབ་མོ་ངེས་པར་འཆི་བར་འགྱུར་།",
    "གླིང་བུ་པི་ཝང་ལ་སོགས་སྙན་པའི་རོལ་མོ་སྒྲ་སྙན་སྣ་ཚོགས་།",
    "མ་དང་ཆུང་མ་བུ་མོ་ལ་སོགས་མཛེས་བརྒྱན་པ་།",
    "ཞལ་བཞི་ཕྱག་བརྒྱད་ཐོད་སྐམ་དབུ་རྒྱན་ཐོད་རློནཐོད་འཕྲེང་ཐོད་རློན་ཁྲག་གིས་གང་བས་དག་བྱེདཐོད་སྐམ་རྒྱལ་མཚན་འཛིན་།",
    "དྲུང་དང་དུར་ཁྲོད་དངནི་ནགས་གསེབ་རི་བོའི་རྩེ་མོ་དག།",
    "སུམ་ཅུ་རྩ་གཉིས་མཚན་ལྡན་ཉི་ཤུ་རྩལྔ་ལོན་པའི་བུད་མེད་མཆོག།",
    "ཚིལ་ཆེན་ཁ་རུ་བླུགས་ཤིང་ཉུངས་ཀར་བུད་མེད་དེའི་ལྟོ་རུ་གཏོག་པར་བྱ།",
    "ཤ་ཆེན་ཕྱེ་མ་ཞིབ་མོ་དང་ནི་ཁྲག་གིས་སྦྲུའོ་།",
    "རིགས་ལྔའི་ཚོགས་ནི་དགའ་མ་ལྔར་བསྡུས་ལ་གོས་དཀར་མོ་གཉིས་གཅིག་ཏུ་བྱས་ཏེ་དེའི་ངོས་བཞིའི་ཟླ་བ་ལ་དགོད་དོ།",
    "དེའི་འོག་ཏུ་ཏིང་ངེ་འཛིན་དེ་ལས་བསླང་བར་བྱ་བའི་ཕྱིར་འབད་རྩོལ་མེད་པར་མཱ་མ་ཀཱི་ལ་སོགས་པ་ལྷ་མོ་བཞིས་བསྐུལ་བའི་གླུས་བསྐུལ་བར་བསམ་པར་བྱའོ།",
    "ཁྱོད་ནི་རྡོ་རྗེའི་གསུང་སྟེ་ཀུན་ལ་ཕན་ཞིང་ཐུགས་བརྩེ་བ།",
    "འཇིག་རྟེན་དག་གི་༧དགོས་པའི་དོན་མཛད་པ་ལ་རྟག་ཏུ་བརྩོན།",
    "ཁྱོད་ནི་རྡོ་རྗེའི་འདོད་པ་དམ་ཚིག་མཆོག་གི་ཕན་ཡོན་ཆེ།",
    "དེའི་འོག་ཏུ་མིག་དང་རྣ་བ་དང་སྣ་དང་ལྕེ་དང་ལུས་དང་ཡིད་ལ་གོ་རིམས་བཞིན་དུ་ཀླུ་ཛཾ་ཁཾ་གཾ་ཎཾ་སཾ་ཞེས་བྱ་བའི་འོད་འཕྲོ་བ་ཅན་དེ་དག་གི་རྣམ་པར་སྦྱངས་ལ།",
    "དེའི་འོག་ཏུ་ཐུགས་ཀའི་ཟླ་བ་ལ་རང་གི་མཚན་མ་དང་ས་བོན་ཡོངས་སུ་གྱུར་པ་ལས་དམ་ཚིག་སེམས་དཔའི་རྣམ་པ་ཅན་གྱི་ཡེ་ཤེས་སེམས་དཔའ་དེའི་ཐུགས་ཀ་ལ་ཟླ་བ་དང་རྡོ་རྗེ་དང་ས་བོན་གྱིས་བྱིན་གྱིས་བརླབས་པར་བསམས་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུན་མོང་དུ་གྱུར་པའི་ཡེ་ཤེས་སེམས་དཔའ་རྡོ་རྗེ་འཆང་ཆེན་པོ་བཀུག་ཅིང་བཅུག་ལ།",
    "ཞེས་བྱ་བ་དེ་དག་གིས་གོ་རིམས་ིབཞིན་དུ་པདྨ་དམར་པོ་འདབ་མ་བརྒྱད་པ་ལ་དེའི་ནོར་བུ་ཟུར་གསུམ་མུ་ཏིག་གི་འོད་ཅན་རྗེས་སུ་མཐུན་པའི་བུ་ག་ཅན་རྡོ་རྗེ་དམར་པོ་རྩེ་མོ་ཤིན་ཏུ་སྦས་པ་དེའི་ནོར་བུ་མུ་ཏིག་གི་འོད་ཅན་བསྐྱེད་པར་བྱའོ།",
    "དེ་བསྡུས་པ་ལས་བྱུང་བའི་རང་གི་ས་བོན་གདན་དང་བཅས་པ་རྣམ་པར་བསམས་ལ་དེ་ཉིད་ལས་དཀྱིལ་འཁོར་པ་ཐམས་ཅད་རེ་རེ་ཞིང་རྡོ་རྗེ་དམ་ཚིག་གསུམ་གྱིས་བསྐྱེད་ལ་བཞི་པས་གཞག་པར་བྱའོ།",
    "ན་ལྷག་མས་རྡོ་རྗེ་དང་ིརལ་གྲི་དང་ནོར་བུ་དང་པདྨ་བསྣམས་པ་བསམས་ལ་དེ་ཕྱུང་སྟེ་བཅོམ་ལྡན་འདས་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་ལ་རང་གི་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་ནང་དུ་གཞུག་པར་བྱའོ།",
    "དེ་ཉིད་ལས་ཨཱ་རོ་ལིཀ་ཅེས་བྱ་བ་འདིས་རིག་པའི་རྒྱལ་མོའི་རིགས་སྤྲོ་བ་དང་བསྡུ་བ་ལས་བྱུང་བའི་འོད་དཔག་ཏུ་མེད་པ་པདྨ་རཱ་ག་ལྟ་བུ་ཞལ་དམར་པོ་དང་ནག་པོ་དང་དཀར་པོ་ཅན་པདྨ་དང་རལ་གྲི་དང་ནོར་བུ་དང་འཁོར་ལོ་བསྣམས་པར་བསམས་ལ་ནུབ་ཀྱི་ཉི་མ་ལ་དགོད་པར་བྱའོ།",
    "གཡོན་བརྐྱང་གིས་བཞུགས་སྦྲུལ་གྱིས་བརྒྱན།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་ཅན།",
    "དེ་ལྟར་དམ་ཚིག་གི་དཀྱིལ་འཁོར་དང་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་གཅིག་ཏུ་བྱས་ནས་ཐམས་ཅད་ཀྱི་ཐུགས་ཀ་དང་དབུ་དང་ལྐོག་མ་དང་ཐུགས་ཀྱི་གནས་སུ་ཟླ་བ་དང་མཚན་མ་དང་ཟླ་བ་ལ་གནས་པའི་ཡེ་ཤེས་དང་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་ས་བོན་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "རང་བཞིན་འོད་གསལ་མཆོག་གི་མཆོག།",
    "དེ་ལ་དང་པོར་ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀའི་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་དབུས་ན་གནས་པའི་རང་གི་མཚན་མ་རང་གི་ངོ་བོ་ཉིད་དུ་གྱུར་པ་དེའི་ལྟེ་བའི་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་གནས་པའི་རང་གི་ས་བོན་གྱི་དོན་ཉིད་ལ་ངེས་པར་བརྟག་པར་བྱའོ།",
    "དེའི་འོག་ཏུ་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་གནས་པའི་རང་གི་ས་བོན་གྱི་མདུན་དང་གཡས་དང་གཡོན་ཕྱོགས་ཀྱི་ཆ་དག་ལ་གོ་རིམས་བཞིན་དུ་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་ས་བོན་དང་ས་བོན་གྱི་གདན་བཞི་བསམ་མོ།",
    "དེ་ལ་དབུས་མ་གང་ཡིན་པ་དེ་ནི་རང་གི་སེམས་ཏེ་དེ་ནི་སྣ་ཚོགས་པ་ཡིན་ལ་དེ་ཉིད་ནི་རྡོ་རྗེ་གསུམ་མི་ཕྱེད་པའི་ངོ་བོ་ཉིད་ཡིན་པར།",
    "དེ་ལ་སྣ་ཚོགས་པ་ལས་ཁ་དོག་ལྔའི་འོད་ཟེར་སྤྲོ་ཞིང་དབྱེ་བ་ལས་ནི་ཁ་དོག་རེ་རེའོ།",
    "སྣ་ཚོགས་པ་བརྗོད་པ་ན་རང་གི་སེམས་ཉིད་སྣ་ཚོགས་པའི་ངོ་བོ་ཉིད་དུ་མོས་པར་བྱས་ཏེ།་",
    "དྲག་པོ་བརྗོད་པ་ན་མཉམ་པ་ཉིད་དུ་མོས་པར་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ན་རེ་ཞིག་ལན་དང་པོ་ལ་དེ་ལྟར་ཡིན་ནོ།",
    "རང་གི་སེམས་སུ་སྡུད་པ་ཡིན་ནོ།",
    "ལན་གཉིས་པ་ལ་སོགས་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཐམས་ཅད་ཀྱི་ཕྱི་མའི་ལན་ཡང་ཡིན་མོད་ཀྱི་འོན་ཀྱང་སྣ་ཚོགས་པ་ཉིད་བརྗོད་ཅིང་སྤྲོ་བར་ནི་མི་བྱ་སྟེ་དབྱེ་བ་རྣམས་ལ་ཡང་སྣ་ཚོགས་པའི་རབ་ཏུ་ིདབྱེ་བ་ཉིད་དུ་མོས་པར་བྱའོ།",
    "དབྱེ་བ་རྣམས་ལ་ཡང་མཉམ་པ་ཉིད་དུ་མོས་པར་བྱ་སྟེ།",
    "དེ་ལ་ཡང་རྣམ་པ་གཉིས་ཏེ་གང་གི་ཚེ་དབྱེ་བ་ལས་དབྱེ་བ་དང་སྣ་ཚོགས་པ་ལས་སྣ་ཚོགས་པ་སྤྲོས་ནས་སྣ་ཚོགས་པར་སྡུད་པ་དེའི་ཚེ་ཐམས་ཅད་ལས་སྤྲོས་པའི་རྡོ་རྗེ་བཟླས་པའོ།",
    "ཡང་གང་གི་ཚེ་སྣ་ིཚོགས་པ་ཉིད་ལས་དབྱེ་བ་དང་སྣ་ཚོགས་པ་ཡང་དག་པར་སྤྲོས་ནས་དབྱེ་བ་དག་ལ་སྡུད་པ་དེའི་ཚེ་གཅིག་པུ་ཉིད་ལས་སྤྲོས་པ་ནི་༧རྡོ་རྗེ་བཟླས་པ་ཡིན་པ་དེ་ལྟར་ན་རྡོ་རྗེ་བཟླས་པ་ནི་རྣམ་པ་གཉིས་སོ།",
    "རྒྱལ་བ་ལྷ་མོ་མཐར་བྱེད་བསྡུའོ།",
    "ཡང་ཡང་མོས་ཤིང་གནས་པར་བྱ།",
    "མི་བསྐྱོད་པའི་ཅོད་པན་ཅན་རང་གི་རིག་མ་དང་གཉིས་སུ་མེད་པར་གྱུར་པའི་རིགས་ཀྱི་རིག་པ་དང་ཡང་དག་པར་སྦྱོར་བ་ཅན་དམིགས་པར་བྱའོ།",
    "དེ་ནས་དམ་ཚིག་གི་དཀྱིལ་འཁོར་སྔ་མ་བཞིན་དུ་ཉེ་བར་བསྡུས་ལ།",
    "སད་པའི་ཚེ་ན་ཡང་ལྷ་མོ་བཞིའི་གླུས་བསྐུལ་བར་བསམས་ལ་དེ་ནས་ལངས་ཏེ་ཞག་སྔ་མ་བཞིན་དུ་ཐམས་ཅད་བྱའོ།",
    "དེ་ལྟར་ཉིན་རེའི་ཐུན་མཚམས་སམ་གནས་སྐབས་ཇི་ལྟ་བ་བཞིན་དུ་དེ་དག་ཐམས་ཅད་བྱ་སྟེ།",
    "བ་གང་ཡིན་པ་དག་ནི་ངའི་སེམས་ཙམ་སྟེ་རང་གི་སེམས་ལས་གཞན་སྣང་བ་མི་རིགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་སེམས་ལ་དཔྱད་པའོ།",
    "གང་ཡང་ལྷ་གཞན་དག་གི་སྦྱར་བས་དངོས་གྲུབ་ཀྱི་མཆོག་འདོད་པ་དེ་རྣམས་ཀྱི་ཆོ་ག་འདི་རྣམས་ཐམས་ཅད་ཉིད་བྱས་ཏེ།",
    "འདིར་ཡན་ལག་དྲུག་གི་བསྙེན་པ་ནན་ཏན་དུ་བྱས་པའི་སྒྲུབ་པ་པོས།",
    "གཞུང་གི་གོ་རིམ་འདི་ལྟར་རྭས་བསྒྱུར་རོ།",
    "གཉིས་པ་ནི་ལོ་བཅུ་དྲུག་གི་མཐར་བདེ་བ་རྫོགས་པའི་སླད་དུ་ཁམས་རྣམས་ཀྱིས་བསྐུལ་བའོ།",
    "དེ་ནས་གཏུམ་མོའི་མེས་ཞུ་བས་ཁྱབ་བདག་རྡོ་རྗེ་ཅན་གཙོ་བོ་ཡང་རི་བོང་འཛིན་པ་ཟླ་བ་ཞུ་བ་བཞིན་ཞུ་བར་བལྟས་ནས།",
    "ཡང་ཡིག་གི་སྒྲས་ཤེས་རབ་ཀྱང་ཞུ་བར་བསྟན་ཏེ།",
    "དེ་ནས་ལྷ་མོ་རྣམས་ཀྱིས་གླུ་དག་མཛད་དེ།",
    "ལྷ་མོ་བཞིས་རྡོ་རྗེའི་གླུ་ཡིས་གཙོ་བོ་ཡབ་ཡུམ་ཞུ་བ་ལས་བཞེངས་པར་བསྐུལ་བའི་དོན་ངེས་པ་བསྟན་པའོ།",
    "དེས་ན་ཡེ་ཤེས་རྡོ་རྗེའི་རང་བཞིན་དུས་འཁོར་ཁྱེད་ཁུ་བའི་ངོ་བོ་ལས་བཞེངས་ནས་ཡེ་ཤེས་ཀྱི་རིགས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ལྷ་སྤྲོ་བ་ལ་བདག་གི་འདོད་པས་བསྐུལ་བ་བཞིན་དུ་མཛོད།",
    "ཆུ་དག་པ་མཱ་མ་ཀཱི་བདག་བདེ་ཆེན་གྱི་སྐལ་བ་དང་སྐལ་མིན་སྟོན་པས་སྲིང་མོ་སྟེ།",
    "སྲིང་མོ་ལ་བྷ་གི་ནི་ཞེས་པའི་བྷ་ག་ཎ་སྐལ་བ་ཨི་ནི་ལྡན་པའམ་སྟོན་པ་ལ་འཇུག་པས་སོ།",
    "མེ་དག་པ་གོས་དཀར་མོ་བདག་ཡོན་ཏན་འཇོ་བའི་ཕྱིར་བུ་མོ་སྟེ།",
    "བུ་མོ་ནི་དྷུ་ཧི་ཏི་ཞེས་པའི་དྷོ་ཧ་འཇོ་བ་ལ་འཇུག་པས་སོ།",
    "དེས་ན་གསུང་རྡོ་རྗེའི་རང་བཞིན་གྱི་དུས་ཀྱི་འཁོར་ལོ་ཁུ་བ་ལས་བཞེངས་ལ་བདག་གི་འདོད་པ་མེའི་རིགས་ཀྱི་ལྷ་སྤྲོ་བས་སེམས་ཀྱི་དོན་མཛོད་ཅིག།",
    "དྲི་མ་མེད་པའི་འོད་ཟེར་ལྔ་འཕྲོ་བའི་རང་གི་མཚན་མ་ཧཱུྃ་ཡིག་ཡོངས་སུ་གྱུར་པའི་རྡོ་རྗེ་རྩེ་ལྔ་པ་གདན་གྱི་སྟེང་དུ་སྤྲོས་པར་བྱས་ནས་དེ་ལས་བྱུང་བའི་རྡོ་རྗེའི་རྒྱན་དང་ལྡན་ཞིང་རྒྱལ་བའི་བདག་པོའི་ཅོད་པན་ནོ་ཞེས་པ་གཙོ་བོ་འགྱུར་མེད་བདེ་བའི་རང་བཞིན་རྡོ་རྗེ་སེམས་དཔར་མཚོན་པའི་དོན་དུ་མི་བསྐྱོད་པའི་ཅོད་པན་ཅན་འབྲས་བུ་ལ་རྒྱུས་རྒྱས་བཏབ་པ་ཡིན་ནོ།",
    "ཀྱང་ཡིག་གིས་སྔོན་བསྙེན་པའི་སྐབས་བཞིན་སྤྲོའོ་ཞེས་པ་བསྡུས་པའོ།",
    "ཚངས་པའི་སྒོ་ང་རྩེ་ནས་གནོན་ཞེས་པའི་ཚིག་གིས་འཇིག་རྟེན་གྱི་ཁམས་སྒོ་ང་ལས་སྐྱེས་པར་འཆད་པའི་ཕྱིར་རོ།",
    "རྫོགས་པའི་རིམ་པ་ལ་དཀྱིལ་འཁོར་ནི་རྟོག་པ་དང་བྲལ་བར་ལྷ་དང་གཞལ་ཡས་ཁང་གི་རྣམ་པར་སྣང་བ་ཕྲ་ཕབ་པ་ལྟ་བུ་སྟེ།",
    "དེ་ནི་ཉིན་མོའི་རྣལ་འབྱོར་གྱིས་སྤྲིན་མེད་པའི་ནམ་མཁའ་ལས་བྱུང་བ།",
    "ཕྱག་ལྷག་མ་གཉིས་སྡིགས་མཛུབ་དང་བཅས་པས་གླང་པོ་ཆེའི་སྣ་ཅན་ཚོགས་བདག་གི་ལྤགས་པའི་གོས་འཛིན་པ།",
    "དེ་བཞིན་དུ་ཕྱག་ཉི་ཤུ་རྩ་བཞི་པོ་རྣམས་རྡོ་རྗེ་ཤུགས་རང་གི་རྡོ་རྗེ་གདེངས་ཅན་ཀླུའི་ཞགས་པ་སྟེ་རྡོ་རྗེས་མཚན་པའི་ཞགས་པ་ཞགས་མིག་བརྒྱད་པ་ཅན་དག་གིས་རབ་ཏུ་བཅིངས་ནས་ཤུགས་རང་གི་མཚོན་ཆ་ལྷག་མ་རྣམས་ཀྱིས་འཇིགས་པར་བྱས་ཏེ།",
    "དཀྱིལ་འཁོར་པའི་ལྷའི་དངོས་པོའི་མཚན་ཉིད་སྣ་ཚོགས་པའི་འཁོར་ལོ་བཟང་པོ་མཐའ་དག་བསྐྱོད་པ་སྟེ་སྤྱན་དྲང་བར་བྱས་ནས་སླར་ཡང་རྡོ་རྗེ་ཤུགས་འདི་ནི་རང་གི་གཙོ་བོའི་ཐུགས་སུ་འགྲོའོ་ཞེས་པ་ཐིམ་པར་བལྟའོ།",
    "འདིར་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པའི་མིག་གི་ཞེས་འགྱུར་མངས་དང་།",
    "དེ་ལྟར་ན་དགུག་གཞུག་བཅིང་མཉེས་རོ་མཉམ་པ་རྣམ་པ་ལྔ་ནི་ས་བོན་ཛ་ཡིག་གིས་དགུག་པ་དང་།",
    "ཧཱུྃ་ཡིག་གིས་བཞུག་པ་དང་།",
    "བེ་ཡིག་གིས་བཅིང་བ་དང་།",
    "ཧོཎཡིག་གིས་མཉེ་བ་དང་།",
    "ཧི་ཡིག་གིས་བརྗོད་པ་བ་དག་གིས་རོ་མཉམ་པར་བྱ་སྟེ།",
    "ཞེས་པ་ནི་གཞུང་གི་དོན་ངེས་པའོ།",
    "ད་ནི་བསྐྱེད་པའི་ཞེས་པ་ལ་སོགས་པས་བསྐྱེད་པའི་རིམ་པས་གནས་སོ་སོར་ཡེ་ཤེས་ཀྱི་ལྷ་རྣམས་དམ་ཚིག་གི་རྣམས་དང་ཞེས་སྤང་ལོཙྩ་བ་གསུང་བ་ལྟར་ཏེ།",
    "དེ་བཞིན་དུ་ཤར་གྱི་འདབ་མ་ལ་དཔལ་ལྡན་ནག་མོ་འབར་མ་དམ་ཚིག་པ་ལ་ཡེ་ཤེས་པ་རོ་མཉམ་པའོ།",
    "མཆོག་གི་པད་འདབ་ལ་ནི་ལྷོ་རུ་དམར་མོ་འབར་མ་དང་ཡེ་ཤེས་སེམས་དཔའ་རོ་མཉམ་པའོ།",
    "བྱང་དུ་དཔལ་ལྡན་དཀར་མོ་འབར་མ་རོ་མཉམ་པར་འགྱུར་བའོ།",
    "ཟུར་དུ་ལྷ་མོ་རྣམས་གཙོ་མོའོ།",
    "ས་འོག་ཏུ་སྒྲ་རྡོ་རྗེ་མ་དང་རྣ་བ་སྟེ་བྱང་གི་སྒོའི་གཡོན་དུའོ།",
    "དེའི་ཕྱག་རྒྱ་རེངས་བྱེད་མ་བརྗོད་པའི་བྱ་བའོ།"
