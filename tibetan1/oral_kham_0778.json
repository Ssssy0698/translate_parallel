    "མིག་འབུར་ཚུགས་སུ་བལྟས་ནས་སྐད་ཆེན་པོས་མ་ཎི་ཁོ་ན་འདྲེན་བཞིན་འདུག་ཅེས་ཟེར་སྐད་དང་།",
    "དེ་ནས་ལྷོ་སྤྱིའི་སར་འབྱོར་སྐབས་ལྷོ་སྤྱིས་དཀོན་ཅོག་ལ་ཁྱེད་རང་ཉེས་ཚབས་ཆེ་བས་ཆུ་ལ་དབྱུག་རྒྱུ་ཁོ་ན་ཡིན་རུང་།",
    "མེ་མདའ་གཉིས་པ་རྒྱབ་འདུག་རུང་ཁ་གཏད་ཕྱོགས་ལ་སྐྱོན་གནོད་ཐུབ་མེད་༢རྒྱག་རྩིས་བྱེད་སྐབས་མེ་མདའི་ཁ་འབྱར་ནས་བྱ་ཐབས་ཟད་དེ་གཡོག་པོ་རྣམས་བྲོས།",
    "འཛིན་ཆས་རྣམས་ངོ་ཡོད་ངོ་དང་ངོ་མེད་ཚབ་སྒྲིག་བྱས་ནས་ཐག་གཅོད་བྱུང་འདུགལྷོ་སྤྱི་དྲུག་པ།",
    "ཚོད་འདུག་པས་གློག་ལ་མར་མེའི་གསལ་འདེབས་ཞུ་མ་དགོས་ཀྱང་དགོངས་པ་ཟབ་བཞེས་གནང་དགོས་ཞེས་ཟེར་བ་ཞིག་བཏང་འབྱོར་བྱུང་ཡོད་ལ།",
    "ལན་གསལ་གང་ཡང་བྱས་མི་འདུག་གོང་ལོའི་བོད་ཟླ་པའི་ནང་ཛ་སག་སྨིན་སྐྱིད་གླིང་པ་དང་།",
    "རྒྱ་མིའི་ཆེད་དུ་སྐད་ཆ་ཤོད་ཀྱི་མི་འདུག་གམ་ཚང་མས་བསམ་བློ་ཡག་པོ་གཏོང་དགོས།",
    "སྔོན་ལ་བལ་པོ་བསད་དེ་དེ་ནས་གསེར་བགོ་བཤའ་རྒྱབ་ཆོག་པ་ལྟར་བྱེད་དགོས་པ་མི་འདུག་གམ་ཞེས་ཟེར་ནས་ངར་ངར་རྫིག་རྫིག་བྱས།",
    "དམག་སྒར་ཟུང་སྦྲེལ་གྱིས་དོ་དམ་བྱས་པའི་ནང་མི་སེར་གྱི་དྲེའུ་གཉིས་པོ་དེའང་འདུག་པ་དོ་བདག་ཁང་ཤར་ལ་རྩིས་སྤྲོད་བྱས་པ་དང་།",
    "གཞིས་རྩེར་དམག་སྒར་འགོ་དམག་རྣམས་དོ་དམ་གནང་ཟིན་འདུག་ཅིང་།",
    "དིང་རིར་ས་གནས་གཞན་ནས་རང་རང་ཐོན་ཁུངས་ཚོང་འཁོས་སུ་ཡོང་མཁན་ལྷ་རྩེ་ནས་བོད་སྣུམ་དང་།",
    "ཕྱིས་ཀྱང་རྒན་རབས་ཚོས་སྔོན་མ་གྲོགས་རྣམ་གྱིས་བཀའ་སློབ་གནང་བ་དེ་ཚོ་ཡང་དག་པ་དང་བཀའ་དྲིན་བསྐྱངས་འདུག་ཞེས་ཤོད་ཀྱི་འདུག།",
    "དཔེར་ན་ཀྲོག་ཇིས་མགོ་ཟེར་བ་ཞིག་ཡོད་པ་དེས་རྣམ་ཀུན་ཁོ་རང་དཔའ་བོ་ཡིན་ཟེར་ཞིང་།",
    "མེ་མདའ་རིང་མདའ་རྙིང་པ་འདི་དག་ཇི་ལྟར་ཞུ་འགབ་སྐྱོན་ཡོད་བཅས་འདུག་པ་གཞུང་ལེན་བྱས་ཐོག་ཆེ་མིན་སྐོར་ཨ་དྲུང་ཕྱིར་ལོག་གདོང་སྙན་འབུལ་ཞུས།",
    "འགེབས་གཡོན་འགེབས་བྱས་པ་མང་དག་ཅིག་འདུག་པ་དེ་རྣམས་རྩིས་རྒྱག་དང་།",
    "བརྡ་འདེད་བྱེད་ཐབས་བྲལ་བ་ཞིག་འདུག་ཡི་གེ་དང་།",
    "ལྡིང་དཔོན་རིམ་ཅན་ཡིན་འདུག་པས་སྐབས་དེར་འདུ་ཁོངས་ཚང་འཛོམས་སར་ད་ལམ་རིང་གཙོ་དྲག་དང་།",
    "རྟ་སློག་པས་མི་སེར་ཐོག་རྟ་འུལ་གཅིག་བསྐུལ་ནས་བཞོན་འདུག་པ་མ་ཟདདེ་འཕྲལ་མི་སེར་ལྡིང་རྒན།",
    "ཤོར་འོཇལ་འབོ་བསྡུར་རྒྱུག་སྐབས་བྲེ་དོ་ལྷག་ཙམ་ཧེ་བག་རྒྱུགས་འདུག་པས།",
    "ངས་ཁྱེད་རང་སུ་ཡིན་ནམ།",
    "ཡུལ་དམག་མི་ཇ་ཐུག་གཟབ་སྟེ་བཅོལ་ཞུ་རུ་བཅུག་གྲི་མདུང་སྐོར་ལས་གོ་ལག་མི་གྲངས་སྐོར་ལ་བོད་མདའ་དང་འདུག་སྟབས་མི་གྲངས་ཕྱོགས་བགོས་ཀྱིས་སྐབས་དེར་བོད་ཟླ་ཚེས་ཤར་ཡིན་སྟབས་ཆར་ཆུ་རྒྱུས་སྒང་ཡིན་པས་ལྷ་རྩེའི་འཕྲང་འགག་བསྲུང་དུ་བཅུག་པ་དང་།",
    "དྲེའུ་གཅིག་རྨིས་འདུག་ཟ་ཉལ་ཆས།",
    "ལག་སྒམ་རྒྱབ་གཅིག་བཅས་དོ་གྲངས་ཙམ་ལག་སོན་བྱུང་སྟབས་བཀའ་དོན་མ་འགུལ་ཙམ་རང་ས་ནས་བསྲུང་བཀག་དེ་ལྷག་བྱ་ཐབས་མི་འདུག་སྙམ་སྟེ་དེ་ཉིན་དགོང་དྲོ་བར་བསྲུང་སྟེཁོ་ཚོའི་དངོས་པོ་ཐོབ་པ་ནས་ཇ་མར་སྣུམ་པ་དང་།",
    "བག་མའི་ཁྱིམ་ཚང་ཡབ་ཡུམ་སྟོན་འཁོར་རྣམས་རྒྱུན་གོས་གཟབ་བཞེས་རང་རང་བབ་བསྟུན་བཞུགས་གྲལ་དུ་འཁོད་རྗེས་གསོལ་འབྲས་འདེགས་འབུལ་སོགས་མཛད་སྒོ་རགས་ཙམ་གྲུབ་རྗེས་བག་མ་སྐྱེལ་བསུ་མཁན་ལ་སོགས་པར་གསོལ་བ་ཞབས་ཏོག་ལེགས་པར་ཞུས།",
    "དེ་བྱིངས་ན་བཟའ་བདེ་ཆས་སྤུས་ཏེ་གཟིམ་ཆུང་དུ་རང་རང་རོལ་རྩེད་ལ་ཅི་དགར་སྤྱོད་ཅིང་།",
    "དུས་མཚུངས་དེ་སྔོན་ལ་སྒོ་ཁག་ལ་བཏང་བའི་རང་དམག་རྣམས་ཀྱང་རིམ་བཞིན་དེ་གར་འབྱོར་བར་བརྟེན་སྐབས་གཅིག་རིང་རང་དམག་དང་།",
    "སྒར་དཔོན་གྱི་གཡོག་གཅིག་བཅས་ཡིད་སྐྱོ་བའི་ངང་དམར་གསོད་བཏང་འདུག་པ་མ་ཟད།",
    "སྐབས་དེར་གཙོ་རྒན་བློ་དག་འཕྲལ་སྒྲུབ་དགོས་ལུགས་བརྗོད་བྱུང་ཞིང་རང་ཉིད་བཅས་མི་གསུམ་ནས་མར་བཟང་བསྟན་འཛིན་དང་།",
    "གཉེར་ལས་བྱེད་ཚང་མས་ཁྱེད་ལོ་ན་ཆུང་ཡང་ལས་ཀར་བྱས་འབྲས་ཆེན་པོ་ཐོབ་འདུག་ཅེས་བསྟོད་བསྔགས་ཀྱང་ཐོབ།",
    "ཤོ་སྟར་ལྷོ་གསུམ་གྱི་དམག་དེ་གཉིས་ཀྱང་རང་སར་ལ་འབྱོར་ནས་གནས་ཚུལ་ཞུས།",
    "རི་བོ་ཆེ་དམག་དབར་མི་འཁེལ་ཆེད་མཁན་ཟླ་ལྕགས་ཟམ་ཁར་ཕེབས་པ་དང་ང་རང་རྒྱལ་བློན་གྱིས་ཟི་དམག་ནས་མི་ཚོར་བའི་འགན་ལེན་བྱ་རྒྱུ་དང་།",
    "མནའ་མ་བཞག་ན་རྨ་ཞང་ཡེ་ཧྲིས་ཡིད་ཆེས་བྱེད་བཟོ་མི་འདུག་སྙམ་སྟེ་མཛོད་ཚེས་དཔོན་པོ་ཁྱེད་ནི་ཉི་ཟླ་སོགས་ལ་སྐྱབས་སུ་འགྲོ་མཁན་ཡིན་པ་དང་།",
    "ཚེ་གྲགས་ནས་ངས་ཁ་དན་ཚིག་ཐག་བཅད་ཚར་བས་ཕྱིས་འགྱུར་བ་བྱེད་བཟོ་གཏན་ནས་མི་འདུག་ཅེས་ཞུས་པས།",
    "ཚེ་གྲགས་རི་ཆེར་འབྱོར་མ་ཐག་བྱང་སྤྱིས་གཟིམ་དཔོན་ཞིག་འབོད་མི་བཏང་བར་སྐུ་མདུན་དུ་བཅར་སྐབས་གྲོས་སྣེ་མཐུད་ཐུབ་མིན་གྱི་སྐོར་དྲིས་པར་ཚེ་གྲགས་ནས་རྨ་ཞང་ཡེ་ཧྲི་ལ་ཁོང་རང་ནས་བཏོན་པའི་ཞི་གྲོས་འཆར་ཟིན་དེ་ཕུལ་ནས་ཟི་རྒྱའི་དཔོན་ལ་སླར་ཡང་ཞི་གྲོས་སྣེ་མཐུད་པའི་གནས་ལུགས་ཞིབ་ཕྲ་ཞུས་པས།",
