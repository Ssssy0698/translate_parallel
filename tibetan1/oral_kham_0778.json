    "སླར་ཡང་རང་ཉིད་རྣལ་འབྱོར་མ་ཡི་སྐུ།",
    "སླར་ཡང་རང་ཉིད་རྣལ་འབྱོར་མ་ཡི་སྐུ།",
    "མེ་ཏོག་ཆར་འབེབས་འཕན་འདུགས་རྒྱལ་མཚན་སོགས།",
    "འདི་རུ་མ་བདུག་རང་རང་གནས་སུ་དེངས།",
    "ངོ་བོས་སྟོང་ཀྱང་རང་བཞིན་གསལ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུ་ཧཱུྃ་ཕཊ",
    "བཛྲ་ཝརྞ་ནི་། ཡེ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ",
    "རྒྱལ་བ་ཀུན་གྱི་བདེ་སྟོང་རང་གཟུགས་མཆོག།",
    "རྒྱལ་ཀུན་བདེ་སྟོང་རང་གཟུགས་བེ་དམར་པོ།",
    "སྒྲིབ་སྦྱང་རང་ལུས་འོད་གོང་གྱུར།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "ན་མ་ཨཱརྱ་ཛྙཱ་ན་ས་ག་ར་བེ་རོ་ཙ་ན་བ་ཡུ་ཧ་རཱ་ཛཱ་ཡ།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཅེས་རྩ་སྔགས་ཀྱི་བསངས།",
    "མ་ཆེན་རྡོ་རྗེ་རྣལ་འབྱོར་མ་ཞིང་སྔགས་ལྷན་སྐྱེས་ཀྱི་མཁའ་འགྲོའི་ཚོགས་ཐམས་ཅད་ཁ་ཆར་བུ་ཡུག་འཚུབ་པ་བཞིན་བྱིན་ཐིབ་ཀྱིས་བྱོན་ནས་ཁྱེད་རང་ལ་སིབ་སིབ་ཐིམ་པས་བྱིན་གྱིས་བརླབ་པར་གྱུར།",
    "ཅེས་དམིགས་ཡུལ་གྱི་སེམས་དང་རང་སེམས་ཐ་དད་མེད་ཅིང་བཟོ་མེད་དུ་བཞག་གོ།",
    "སྒྲིབ་སྦྱང་རང་ལུས་འོད་གོང་གྱུར།",
    "བཛྲ་ཝརྣ་ནི་ཡེ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "ངོ་བོ་སྟོང་ཞིང་རང་བཞིན་གསལ།",
    "ཁོང་ལ་འདི་འདྲ་དགོས་པ་མི་གདའ་ཡང་།",
    "ཁོང་ལ་འདི་འདྲ་དགོས་པ་མི་གདའ་ཡང་།",
    "ནམ་ཞིག་འཆི་བ་ཐོག་ཏུ་བབས་ཙ་ན་ཕྱི་ནང་གསང་བའི་འཆི་ལྟས་སོགས་ལ་ལེགས་པར་བརྟག་ཅིང་།",
    "བཀའ་ལས་མ་འདའ་རང་རང་གནས་སུ་དེངས།",
    "ངོ་བོས་སྟོང་ཀྱང་རང་བཞིན་གསལ།",
    "ན་མ་ཨཱརྱ་ཛྙཱ་ན་སཱ་ག་ར་བེ་རོ་ཙ་ན་བཱུ་ཧ་རཱ་ཛཱ་ཡ།",
    "དེ་བས་རང་རང་གནས་སུ་ད་སོངས་ཤིག།",
    "ནུབ་ཐ་མའམ་ནམ་དགོས་ཆེ་བྱང་བུ་བསྲེག་དུས་སྤྲོས་བྲལ་ལ་གཞོལ་བཞིན།་",
    "ཧྲཱི་མཐར་རང་རང་སྔགས་བསྐོར་འོད་ཟེར་གྱིས།",
    "སླར་ཡང་རང་ཉིད་འཇིག་རྟེན་མགོན་པོའི་སྐུ།",
    "ནོར་རྒྱུན་ལྗང་སོགས་རང་རང་རྒྱན་ཕྱག་རྫོགས།",
    "༧ ཅེས་པ་འདིའང་རང་ཉིད་ཀྱི་ཕ་རྒན་ལ་རྒྱུན་འདོན་གྱི་ཆེད་དུ།",
    "མཚན་འཛིན་སྤོངས་ལ་འཁྲུལ་སྣང་རང་སར་གློད།",
    "གཏོར་མ་ལོངས་ལ་རང་རང་གནས་སུ་དེངས།",
    "ངོ་བོས་སྟོང་ཀྱང་རང་བཞིན་གསལ།",
    "དོན་གྱི་གནས་ཚོད་ལ་རྗེས་གནང་ལྟར་འདུག་ལ།",
    "སྤྱི་བ་ཆེ་ཆུང་སོགས་ལས་སྣེ་ཐམས་ཅད་ཀྱིས་རང་རང་སོ་སོའི་སྐབས་ཐོབ་ཀྱི་ལས་དོན་གང་དགོས་རྣམས་གཉོམ་ཆུང་ཚུལ་མཐུན་གྱི་སྒོ་ནས་བསྒྲུབ་པ་ལས།",
    "རང་རང་སྡོམ་པ་གསུམ་གའི་བཅས་པ་དང་མི་འགལ་བ་འདི་གལ་ཆེ་སྟེ།",
    "བདག་ཅག་དུས་ཀུན་དགེ་མཚན་དཔལ་གྱིས་སྐྱོངས།",
    "ཐ་ན་ཇ་མ་ཆུ་ལེན་ཡན་ཆད་ཀྱི་རང་རང་ལས་ཁུར་རྣམས་གཉོམ་ཆུང་ཚུལ་མཐུན་གྱི་སྒོ་ནས།",
    "སྐྱེ་བོ་ཐ་མལ་བ་རྣམས་དེ་ལྟར་བྱུང་ཡང་འཆི་སྡོད་དུ་ཕལ་ཆེར་འདུག་གོ།",
    "རླན་སྟེང་ཁ་ཡེབ་མ་ཡིན་དབེན་པར་འདུག།",
    "སྐེག་དུས་འཚོ་འཆི་བརྟག་པའོ།",
    "མཁྲིས་རིམས་སྤྱི་དང་བྱེ་བྲག་དུས་གསུམ་དང་སྦྱར་ཏེ་བཅོས་པ་དང་།",
    "འགྲངས་རྗེས་ལ་དལ་བར་འདུག་ཅིང་ཉིན་གཉིད་ལོག་པ་དང་།",
    "སྟོབས་ཆུང་རང་ཞྭ་ལ།",
    "ཕྱིས་ཀྱི་གཙག་དུས།",
    "སྐྱོགས་རྒྱུ་དབྱེ་པ་ཡུལ་གཞུག་དུས་དཔྲལ་དུས་དམ་སྐྱོན་ལྷོད་སྐྱོན་ནང་ཚང་གདབས་ཐབས་ཉེས་སྐྱོན་ཡོན་ཏན་བཅུ་གྲུས་སོ།",
    "རྨ་ཇི་ཚོད་འདུག་པ་དེ་ལས་འགྲམས་མི་འོངས་ཏེ།",
    "སྡོད་པར་འདུག་ན་མདེ་མལ་བཅའ།",
    "སྤྱིར་བསྐམ་པ་ལ་ཁྲག་དུས་ཕྱེ་མའི་བསྐམ་པ་དང་།",
    "གཉིས་མཐར་མ་ལྷུང་རང་གཤིས་བཟང་པོས་ངོམས་མེད་ཡོན་ཏན་བསྲེལ་བྱས་ན།",
    "རྟེན་དུ་ཐོངས་དང་རང་གཞན་ཀུན་ལ་ཕན།",
    "ལན་བརྒྱར་བརྟགས་ཀྱང་རང་གཤིས་འགྱུར་སྲིད་དམ།",
    "ནམ་ཞིག་དུས་སུ་བབས་ཚེ་ཇི་སྙེད་དོན།",
    "སུ་ལའང་རང་རྒྱུས་མ་འཆོར་བློ་འཁེལ་དཀོན།",
    "ཇི་ཞིག་དུས་ན་རྒ་བའི་ཕོ་ཉ་བ།",
    "དེ་ཡང་རང་བཞིན་ཡང་དག་གསེར།",
    "ཚེ་འདི་ནམ་གཞུག་དུས་ཀྱི་སྦྲང་མར་མཚུངས།",
    "ནང་ཀུན་བསྣོལ་མཚམས་མ་ལོག་པར་འཆད་ཁྲིད་ནུས་ཤིང་རང་རྒྱུད་ལ་བོག་ཐོན་པ།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་རིག་སྔགས་རྒྱལ་པོ་འབྲུ་བདུན་པ།",
    "ཤིས་པའི་མེ་ཏོག་དུས་ཀུན་ཆར་དུ་སྙིལ།",
    "སྲིད་ལ་མི་གནས་ཞི་ལ་མ་ཡིན་འགྲོ་ལ་ཡིད་བཞིན་ནོར་བུའི་སྐུ།",
    "མི་འདོད་ཉེར་འཚེས་དབེན་ཞིང་རང་སྐལ་གྱི།",
    "འཐོར་བརླག་དུས་ཀྱི་རྐུན་པོས་གཙེས་པ་མང་།",
    "མ་བསྡུས་པར་ཡང་རང་བཞིན་འདུ།"
  ]
}