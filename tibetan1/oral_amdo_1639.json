    "རི་མོ་མཁན་ལ་ལྟོས་པའི་རི་མོ་ཡང་རྟོགས་པར་བྱ་བ་ཡིན་ནོ།",
    "འོན་ཏེ་མི་འགལ་མོད།",
    "འབྱུང་རྔུབ་ལ་སོགས་པ་ནི་རང་གི་རིགས་ལ་ལྟོས་པ་མེད་པར་མི་འཐད་དོ།",
    "གོམས་པ་ལ་སོགས་པ་རྣམས་ཀྱི་གོམས་པ་སྔོན་དུ་སོང་བ་ཅན་ཉིད་དུ་གསལ་འདེབས་པར་བྱེད་དོ།",
    "འགའ་ཞིག་ལ་དངོས་པོ་འགའ་ཞིག་གི་རང་བཞིན་རྗེས་སུ་འཇུག་པ་མཐོང་བས་ནི་དེ་ཡང་དེ་ཁོ་ན་བཞིན་གོམས་པར་གྱུར་པ་ཡིན་ནོ་ཞེས་ངེས་པ་ཡིན་ནོ།",
    "མ་ཡིན་པར་བཀབ་པས་རང་གི་གོམས་པ་ཉིད་ལས་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོ་ན་གང་གི་ཚེ་ཕ་མའི་ལུས་ལ་སོགས་པ་རྒྱུར་འཐད་ཅེ་ན།",
    "གལ་ཏེ་བུ་ཆུང་གི་རང་བཞིན་དེ་དག་ཕ་མའི་རང་བཞིན་ཡོད་ན་སྟེ།",
    "ཡང་ན་གལ་ཏེ་བུ་ཆུང་གི་འདོད་པ་ལ་སོགས་པ་ཐམས་ཅད་སྔར་ཕ་མའི་རང་བཞིན་ལ་ཡོད་པར་གྱུར་ན་དེའི་ཚེའོ།",
    "ལུས་ལ་སོགས་པ་ཡང་ཞེས་ཡང་གི་སྒྲས་ནི་སྲིད་པ་མ་ཡིན་ཏེ།",
    "བུ་ཆུང་གི་རང་བཞིན་མཐའ་དག་ཕ་མ་གཉིས་ལ་གདོན་མི་ཟ་བར་གནས་པ་ཡང་མ་ཡིན་ནོ།",
    "འདིར་འདི་མ་གྲུབ་ན་ནི་གཞན་དུ་ཡང་མི་འགྲུབ་པར་ཐལ་ལོ་སྙམ་དུ་དགོངས་པའོ།",
    "གལ་ཏེ་གོམས་པ་སྔོན་དུ་འགྲོ་བར་གྲུབ་པར་དེའི་ཚེ་རང་གི་གོམས་པ་དང་བྲལ་བ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ནགས་དང་ཅིག་ཤོས་ཀྱི་རྒྱལ་མོ་ག་གོན་གཉིས་བཞིན་དུ་གཅིག་ཏུ་རྟོགས་པ་ཡིན་ཡང་།",
    "གལ་ཏེ་དེ་ལ་རྒྱུ་ཉིད་མ་མཐོང་བའི་ཕྱིར་གང་གི་འབྲེལ་པར་འགྱུར་བ།",
    "གླེན་པ་གཞན་གྱིས་ཁྱུ་མཆོག་དང་མ་ཧེ་དག་ཅི་ལྟ་བ་བཞིན་དུ་མ་ངེས་པའི་ཕྱིར་ཁྱུ་མཆོག་གི་སྒྲས་མ་ཧེ་ལ་བརྗོད་པ་སྟེ།",
    "གང་གི་ཕྱིར་འདི་ནི་ཤིན་དུ་བརྟག་པར་དཀའོ།",
    "རི་མོ་མཁན་གྱི་རི་མོ་ལྟར་འབྲས་བུ་ཉིད་ཡིན་པའི་ཕྱོགས་སུན་ཕྱུང་བ་ཡིན་ལ།",
    "དེ་ཉིད་ཀྱིས་རྩིག་པའི་རི་མོ་དང་ཨ་མྲའི་སྨིན་པ་ལྟར་རང་བཞིན་ཡིན་པའི་ཕྱོགས་དང་།",
    "ཆང་གི་ནུས་པ་ལྟར་ཡོན་ཏན་ཡིན་པའི་ཕྱོགས་ཀྱང་སྤངས་པ་ཡིན་ནོ།",
    "གང་གིས་དེ་སྐད་བརྗོད་པ་སྔར་མཚམས་སྦྱོར་བའི་ནུས་པ་དང་ལྡན་པ་ཅི་ཞིག་མཐོང་ཞེ་ན།",
    "སོགས་པའི་སྒྲས་ནི་ངག་གི་རྒྱུ་བ་ཞན་པ་ལ་སོགས་པ་གཟུང་ངོ།",
    "ཚང་བ་ནི་ལས་དང་ཉོན་མོངས་པ་ཚོགས་པས་སོ།",
    "གང་གི་ཕྱིར་མྱུ་གུ་དང་འབྲས་བུའི་ས་བོན་ཡང་མཐོང་བའི་ཕྱིར་རོ་སྙམ་དུ་བསམས་ནས།",
    "བསྒྲུབ་པ་དག་ཁྱད་པར་ཅི་ཞིག་ཡོད་ན་གང་གིས་དེ་གྲུབ་པའི་ཐ་སྙད་ལ་གུས་ཤེ་ན།",
    "གཉིས་སུ་མེད་པ་མངོན་དུ་བྱས་པའི་གནས་སྐབས་དེ་དེར་ཉོན་མོངས་པ་དེའི་ལས་རྣམས་རབ་ཏུ་ཉེ་བར་ཞི་བའི་ཕྱིར་རོ།",
    "འཇིག་རྟེན་ཕ་རོལ་ངེས་ན་ནི་ཉོན་མོངས་པ་ལ་སོགས་པའི་ཚོགས་ལས་བྱང་ཞིང་གྲོལ་བར་བྱས་པའི་དོན་དུ་འབད་པ་ཡིན་ལ།",
    "བར་དུ་ཡང་མི་འདོད་པའི་རང་གི་ལས་ལ་དེ་རྣམས་ཀྱི་རྒྱུ་བ་འགོག་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་མིག་ལ་སོགས་པ་བག་ཆགས་ཀྱི་སྟོབས་ལ་བརྟེན་པ་ངེས་ན་རྣམ་པ་དེ་ལྟ་བུའི་ལས་ཀྱི་སྟོབས་ཀྱིས་བག་ཆགས་མི་མཐུན་པར་གྱུར་པས།",
    "རྣམ་པར་ཤེས་པ་ནི་རང་གི་ངོ་བོས་གནས་པའོ།",
    "གལ་ཏེ་བག་ཆགས་ཀྱི་སྟོབས་ལ་བརྟེན་པས་ན་དེ་ལྟར་འགྱུར་མོད་ཕྱི་རོལ་དོན་ལ་གོ་དེ་ཅི་ལྟར་འགྱུར་ཞེ་ན།",
    "རྫུས་ཏེ་སྐྱེ་བ་ལ་ནི་རེ་ཞིག་ལོག་པར་རྟོགས་པ་ཉིད་ཡོད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་རྡོའི་དཀྱིལ་ན་ཡོད་པའི་སྲོག་ཆགས་ཀྱང་སྐྱེ་བར་གྲགས་པ་ཡིན་མོད་ཀྱི།",
    "བདག་ཉིད་ཅེས་བྱ་བ་ནི་བདག་ཉིད་གཅིག་གིས་བསྐྱེད་པའི་རང་བཞིན་ནོ།",
    "རང་བཞིན་གཅིག་པ་ཅན་གྱི་པདྨ་དཀར་པོ་ལ་སོགས་པའི་ས་བོན་ལ་སོགས་པ་དུ་མ་དག་བདག་ལས་དཀར་པོ་དང་དམར་པོ་ལ་སོགས་པའི་རང་བཞིན་གྱི་པདྨ་ལ་སོགས་པའི་དབྱེ་བ་ངེས་པ་མེད་པར་འགའ་ཞིག་གི་ཚེ་མཐོང་བའམ།",
    "སྲིད་པ་འདིར་འབྲས་བུ་ལ་རེ་བ་རྒྱང་རིང་ངོ་ཞེ་ན།",
    "དེ་ཅིའི་ཕྱིར་ཅི་ལྟར་འགགས་ནས་ཡུན་རིང་དུ་ལོན་པའི་བློ་དེ་མ་ཐག་པའི་རྐྱེན་ཡིན་པ་དེ་བཞིན་དུ་འགགས་ནས་ཡུན་རིང་དུ་ལོན་པའི་མིག་ཀྱང་མིག་གི་རྒྱུ་ཡིན་ནོ།",
    "དེ་བས་མིག་ལ་སོགས་པས་ནི་རང་གི་རིགས་སྔ་མ་ལ་རག་ལས་པ་ཁོ་ནའོ།",
    "རང་གི་འབྲས་བུ་བྱེད་པ་ནི་དེས་སྐུལ་བ་ཁོ་ནས་ཁྱད་པར་དུ་ཡུལ་རྟོགས་པའི་སྒྲུབ་བྱེད་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་གི་རིགས་ལས་སྐྱེ་བ་ཡིན་གྱི་ས་དང་ཆུ་ལ་སོགས་པ་དག་ལས་ནི་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིད་ཀྱི་རྣམ་པར་འགྱུར་བ་ཉིད་དུ་མཐོང་བ་འཁྲུལ་པ་མེད་པ་དེའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་མོད་ཅི་སྐྱོན་ཞེ་ན།",
    "དེའི་ཕྱིར་ཞེས་བྱ་བ་གང་གི་ཕྱིར་ཁྱེད་ཀྱི་ལུགས་ཀྱིས་ཐམས་ཅད་རྟེན་དང་བཅས་པ་ཁོ་ན་ཡིན་པའི་ཕྱིར་རོ།",
    "སེམས་པའི་ལས་དང་ཞེས་ཡིད་དང་དེས་བསྐྱེད་པ་ལུས་དང་ངག་གི་ལས་སོ་ཞེས་བསྟན་ཏོ།",
    "ཕན་ཚུན་གྱི་རྒྱུ་ཅན་དག་གི་ཚོགས་པ་ནི་ཕུང་པོའི་ཚོགས་པ་གཞན་ལས་ཞེས་བྱ་བ་ནི་སྔ་མ་ལས་སོ།",
    "ད་ལྟ་བ་ལས་ཕྱི་མ་ལུས་དང་ཡིད་གང་ཡིན་པ་དེའི་ཕན་ཚུན་གྱི་རྒྱུ་ཅན་ཉིད་ཀྱང་ཚོགས་པ་ལས་སྐྱེས་པ་ཉིད་ལས་ཡིན་ནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་འབྲས་བུ་མཐའ་དག་ཅིག་ཅར་བྱེད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "དེ་ཉིད་བརྗོད་པ་ནི་དེ་ལ་རེ་ཞིག་ཅེས་བྱ་བའོ།",
    "འབྲས་བུའི་དུས་ཞེས་བྱ་བ་ནི་འབྲས་བུ་ལ་ཕན་འདོགས་པའི་དུས་དེ་སྐད་ཅིག་གང་གི་མོད་ལ་འབྲས་བུ་སྐྱེ་བར་འགྱུར་བའོ།",
    "གང་གིས་དེའི་རྗེས་སུ་འབྲངས་པས་མ་མཐོང་བ་ཡང་དེ་ལྟར་གཞག་པར་འགྱུར་བ།",
    "ཡང་གི་སྒྲ་ནི་མི་བཟོད་པ་ཙམ་མོ།",
    "གལ་ཏེ་རེ་ཞིག་དངོས་པོ་མེད་པ་ནི་རང་ཉིད་འགྱུར་བས་ཁས་བླངས་པ་ཡིན་ནོ།",
    "རྒྱུ་ཉེ་བར་གནས་ཀྱང་རེས་འགའ་མི་འབྱུང་ངོ་སྙམ་ན།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ལ་རྒྱུ་ཡོད་པ་ཉིད་ན་ཞེས་བྱ་བ་ཉིད་ཀྱི་སྒྲ་ཡང་གང་གི་དོན་དུ་བསྒྱུར་བར་བྱའོ།",
    "གང་གི་ཕྱིར་མེད་པ་དེ་མེད་པས་སྦྱར་བ་མ་ཡིན་པ་དེས་ནའོ།",
    "རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་མེད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "གང་གི་ཚེ་རྒྱུ་ཡོད་ན་ཞེས་གསུངས་སོ།",
    "གང་གི་ཕྱིར་རྒྱུ་ཡོད་ན་སྐྱེས་པ་ནི་རང་ཉིད་སྐད་ཅིག་གཞན་དུ་མི་གནས་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "རང་གི་ངང་གིས་འགགས་པ་ཡིན་ཡང་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་དོན་དམ་པར་སྐད་ཅིག་གཞན་དང་གཞན་སྐྱེས་པའི་ཕྱིར་རང་གི་ངང་གིས་འགགས་པ་ཡིན་པ་དེ་ལྟ་ན་ཡང་ཐ་སྙད་པ་རྣམས་གཅིག་ཏུ་ལྷག་པར་ཞེན་པའི་ཕྱིར།",
    "གང་གི་ཚེ་སྔར་གྱི་མི་དམིགས་པ་ལ་ལྟོས་པ་ན་ནི་དུ་བ་ལ་སོགས་པ་ལ་ཡང་དེ་ཁོ་ན་ལྟར་ཡིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "ཐལ་བ་སྔ་མ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་དེ་ལ་ལྟོས་པའི་འབྲས་བུ་ནི་དེ་ཉིད་ལས་སྐྱེ་བར་འགྱུར་གྱི།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "ཡང་གི་སྒྲས་ནི་རང་ལ་ཡོད་པ་ཡང་ངོ།",
    "དེ་ལྟ་མིན་ན་ཞེས་བྱ་བ་ནི་ལུས་རིམ་ཅན་མ་ཡིན་ན་གང་གིས་བློ་དེའི་རིམ་པ་བྱས་པ།",
    "ཕྱི་མ་ཕྱི་མའི་སྐད་ཅིག་རེ་རེར་རོ།",
    "དེ་ལ་མེད་པར་སྨྲ་བ་གཞན་ལ་རེ་ཞིག་འགལ་བ་མེད་པ་བརྗོད་པ་ནི།",
    "གང་གིས་དེ་མེད་པར་སྒྲུབ་པར་བྱེད་པ་དེའི་ཡུལ་དང་འགལ་བ་ཅི་ཞིག་ཡོད།",
    "འགལ་བ་གང་གིས་སོ།",
    "དེ་ལྟ་མོད་ཀྱི་འདི་གླང་པོ་ཆེའི་ལྟ་བས་བཏང་སྙོམས་སུ་བྱས་ཏེ།",
    "གལ་ཏེ་འདི་དག་གི་དོན་འཛིན་པ་ཡིན་ན་དེ་ལྟ་ན་ནི།",
    "དེ་སྟེ་མཚམས་སྦྱོར་བ་ལས་བཟློག་པ་མཐོང་བ་མེད་པ་ཞེས་པ་དག་གི་ཕྱོགས་གཅིག་འཛིན་པ་ཡིན་ན་ནི་དེའི་ཚེ་ཕན་ཚུན་སྤངས་པའི་འགལ་བ་གཉི་ག་མཐོང་བ་ལ་གདོན་མི་ཟ་བར་ལྟོས་པ་མ་ཡིན་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་འདི་ནི་ངག་གི་དོན་འཛིན་པ་ཡིན་ནོ།",
    "འཆི་བའི་སེམས་མ་ཡིན་པ་རྣམ་པར་གཅད་པར་མཐོང་གི་མཚམས་སྦྱོར་བ་ལས་བཟློག་པ་ནི་མ་ཡིན་ནོ།",
    "མཚམས་སྦྱོར་ན་སྔ་མ་བཞིན་གསོན་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "མཚམས་སྦྱོར་བ་དེ་ནི་རང་གིས་རིག་པར་བྱ་བ་ཡིན་ཡང་གཞན་གྱིས་ནི་རིག་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "འོ་ན་ཁྱོད་ཀྱིས་མཚམས་སྦྱོར་བ་ཡང་ཅི་ལྟར་འགྲུབ་སྙམ་ན།",
    "ཉོན་མོངས་པ་དང་ཞེས་གསུངས་སོ།",
    "ཉོན་མོངས་པ་དང་བྲལ་བ་དེ་གཞན་གྱི་ཡང་སོ་སོའི་སྐྱེ་བོ་རྣམས་ལ་ཁས་ལེན་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡང་ལུང་གིས་ལ།",
    "ལྷག་མ་དེ་ཉིད་ལ་ཞེས་བྱ་བ་ནི་གཏན་ཚིགས་ཉིད་དུ་སྦྱོར་བ་ནི་གང་གི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "གང་གིས་ཕྱི་ནས་མཚམས་སྦྱོར་མེད།",
    "ཐལ་བ་སྐྱེ་བ་ལ་ཚོགས་ཐ་དད་པ་ཡོད་པ་ཡིན་ཏེ།",
    "རང་གི་ཚིག་ལེའུར་བྱས་པ་དང་བཅས་པ་རྩ་བའི་དོན་གསལ་འདེབས་པ་ནི།",
    "གལ་ཏེ་གཞན་ལ་ལྟོས་ནས་ནུས་པ་ཡིན་ན་དེའི་ཚེ་ཚོགས་པ་སྐྱེད་བྱེད་ཡིན་པས་ན་གཅིག་མེད་ཀྱང་ཚོགས་པ་མེད་པའི་ཕྱིར་ཡིད་ཀྱི་ཤེས་པ་མི་སྐྱེ་བར་འགྱུར་རོ།",
    "ཀྱང་གི་སྒྲས་ནི་ཞེས་བྱ་བས་ནི་ནུས་པ་ཐ་དད་ཕྱིར་ཞེས་བྱ་བ་འདིའི་དེ་མ་ཐག་ཏུ་བལྟ་བར་བྱ་བས་སོ།",
    "གལ་ཏེ་སྐྲ་དང་སེན་མོའི་རྩེ་མོ་ལ་སོགས་པ་ལ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་མེད་པའི་ཕྱིར།",
    "དེའི་ཚེ་སྐྱེ་བ་དང་པོར་སྐྲ་དང་སེན་མོའི་རྩེ་མོ་ལ་སོགས་དེ་ལས་ཡིད་ཀྱི་ཤེས་པ་སྐྱེ་བ་ཡིན་ནོ་ཞེས་ཅི་ལྟར་རྟོགས།",
    "དཔེར་ན་ལུས་དང་ལྕེ་ལ་སོགས་པ་ཤིན་དུ་ཉེ་བ་ན་གནས་པ་ལས་རང་གི་ཤེས་པ་དང་རྗེས་སུ་འབྲེལ་པར་རྟོགས་པས་ན་གཞན་གྱི་ཚེ་ཤེས་པའི་ཉེ་བར་ལེན་པའི་རྒྱུ་ཡང་ཡིན་ནོ་ཞེས་རེས་འགའ་འཁྲུལ་པ་རྟེན་པར་ཡང་འགྱུར་བ་ཡིན་ནོ།",
    "སྐྲ་དང་སེན་མོའི་རྩེ་མོ་ལ་སོགས་པ་ནི་དེ་ལྟར་རང་གི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པའི་རྗེས་སུ་བྱེད་པའི་ཚོར་བ་དང་ལྡན་པར་རྟོགས་པ་མ་ཡིན་ན།",
    "གང་གིས་རེས་འགའ་དེའི་ཉེ་བར་ལེན་པའི་ཐ་སྙད་ལ་བརྟེན་པར་འགྱུར།",
    "གང་གི་ཚེ་མི་བཟོད་ཅེ་ན་དེ་ཡིད་ལ་མནོས་པས་ན་སྟེ།",
    "གང་གི་ཚེ་མཚོན་བརྡེག་པ་ལ་སོགས་པ་ཡིད་ལ་བྱེད་པས་དམིགས་པར་གྱུར་པ་དེའི་ཚེ་སྡུག་བསྔལ་གྱི་རྒྱུ་ཉིད་དུ་བསྒོམས་པས་དེ་མི་བཟོད་པ་ནི་ཡིད་ཀྱི་རྣམ་པར་འགྱུར་བ་གདུང་བའི་མཚན་ཉིད་དུ་འགྱུར་གྱི་གཞན་དུ་ནི་མ་ཡིན་ནོ།",
    "རང་གི་ཤེས་པས་མྱོང་བས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱིའམ་ནང་གི་གནོད་པར་བྱེད་པ་ནི་རང་གི་ངོ་བོས་རིག་པ་མ་ཡིན་ནོ།",
    "ཕྱིའམ་ནང་གི་རྟེན་མ་ཡིན་ཏེ།",
    "དངོས་པོ་དམིགས་བཞིན་པ་ཉིད་རྣམ་པར་འགྱུར་བར་བྱེད་པ་ཡིན་མོད་དེ་ལྟ་ན་ཡང་དམིགས་པ་ཉིད་ནི་རྟེན་མ་ཡིན་ཏེ།",
    "གང་ཞིག་རེས་འགའ་ཞེས་བྱ་བ་ལ་ལུས་ཀྱི་བསྐུ་བྱུག་ལ་སོགས་པ་ལྟར་རོ།",
    "དེ་ལ་སྐྱེས་པ་དང་མ་སྐྱེས་པའི་ཕྱོགས་སེལ་བ་ནི་དེ་ལ་རེ་ཞིག་ཅེས་བྱ་བའོ།",
    "གཞལ་ཞེས་བྱ་བ་ནི་ངའི་ཞེས་རང་གི་ངོ་བོ་ལ་དམིགས་པ་ཞེས་འབྲེལ་ཏོ།",
    "ཡང་ན་དེ་ལྟར་རང་གི་ངོ་བོ་ལ་དམིགས་པའམ།",
    "དེའི་ཚེ་ནི་མིག་གི་བྱེད་པ་མེད་ལ།",
    "དེའི་ཚེ་རྨི་ལམ་གྱི་གནས་སྐབས་ཀྱི་ཚོར་བ་ཡང་འགོག་པར་ཐལ་ལོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་རིག་པ་ཉིད་ནི་རང་གི་དྲན་པ་ཁོ་ནའོ།",
    "དྲན་ན་ནི་དེའི་མོད་ལ་རྨི་ལམ་འདི་གནས་པ་ཡིན་ནོ་ཞེས་རྟོགས་པར་འགྱུར་བ་ན་དེ་ལྟ་ཡང་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཤེས་པ་དེ་ལས་བཟློག་པ་ཡིན་ཏེ།",
    "འཇིག་རྟེན་ཕ་རོལ་ལ་རེ་བས་དོན་སྟོང་པ་ལ་སོགས་པ་དཀའ་བ་སྣ་ཚོགས་པ་ལ་བརྟེན་པས་ནི་གོ་བཅད་དོ་ཞེས་འབད་པའི་སྒྲས་བསྟན་ཏོ།",
    "དེ་ལྟ་མོད་ཀྱི་རྒྱུ་ལས་འབྲས་བུ་རྗེས་སུ་དཔོག་པའི་སྐྱོན་དུ་འགྱུར་རོ་ཞེས་བརྗོད་པ་ཡིན་ནོ་སྙམ་ན།",
    "གང་གི་ཚེ་ན་ཚོད་དང་རྒྱགས་པ་ལ་སོགས་པས་ལུས་མཚུངས་པ་གཉིས་གཉིད་མཐུག་པོས་ལོག་པ་ནའོ།",
    "གལ་ཏེ་དེའི་ཚེ་ཡང་ཁྱད་པར་ཕྲ་མོ་འགའ་ཞིག་ཡོད་པར་འགྱུར་རོ་སྙམ་ན།",
    "འབྱུང་འགྱུར་ལ་ཡང་ཞེས་ཡང་གི་སྒྲས་ནི་འདས་མ་ཐག་པ་དང་འདས་ནས་རིང་དུ་ལོན་པ་སྡུད་པའོ།",
    "བྱེད་པ་པོ་ཉིད་མེད་པ་ལ་ཇི་ལྟར་ཞེས་བྱ་བ་འདི་ནི་འོ་ན་འདས་པ་ཡང་རྒྱུར་མི་འགྱུར་ཏེ་ཞེས་བྱ་བ་དེ་ཉིད་ཀྱིས་རྟོགས་མོད་ཀྱིས་ཡང་བརྗོད་པར་ནི་ཁྱད་པར་བརྗོད་པའི་དོན་དུ་ཡིན་ནོ།",
    "ཧ་ཀྱང་ཐལ་བའི་ཉེས་པར་འགྱུར་བའི་ཕྱིར་ཡང་འདི་ཡང་མཚན་ཉིད་མ་ཡིན་ནོ་བརྗོད་པ་ནི།",
    "ཅི་འགལ་ཞེས་བྱ་བ་ནི་ཁྱོད་ཀྱི་ཞེན་པ་ལས་མ་རྟོགས་པ་དངོས་པོའི་སྐྱོན་ནི་འགའ་ཡང་མེད་དེ་ཧ་ཀྱང་ཐལ་བ་ལ་སོགས་པ་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་རེ་ཞིག་མ་གསུངས་པ་ཙམ་ནི་ཉེས་པ་མ་ཡིན་ཏེ།",
    "གང་གིས་ཕྱི་ནས་མཚམས་སྦྱོར་མེད།",
    "དེ་ལྟ་ན་འབྲས་བུ་ཐམས་ཅད་དེའི་བདག་ཉིད་དུ་ཐལ་ལོ།",
    "དེས་ན་འབྲས་བུའི་གཏན་ཚིགས་ཀྱང་རང་བཞིན་གྱི་གཏན་ཚིགས་སུ་ཐལ་བར་འགྱུར་རོ།",
    "གང་གིས་ཕྱི་ནས་མཚམས་སྦྱོར་མེད།",
    "གང་དང་གང་དུ་དུ་བ་ཡིན་པ་དེ་དང་དེ་ནི་མེ་ལས་སྐྱེས་པ་ཡིན་ཏེ་ཞེས་བྱ་བ་འདིར་ཡང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རེ་ཞིག་ཅེས་བྱ་བ་རྟེན་གྱི་སྒོ་ནས་ཕན་འདོགས་པ་ཙམ་གྱིས་སོ།",
    "རེས་འགའ་བའི་ཕན་འདོགས་པར་བྱེད་པ་ལོག་པས་ནི་ལྡོག་པ་མ་ཡིན་ནོ་ཞེས་གསལ་བར་བརྗོད་དོ།",
    "རྒོལ་བ་གང་གིས་ལྟར་ནའོ།",
    "འོན་ཏེ་ཡང་སེམས་ནི་དབུགས་ཕྱུང་བ་དང་རྔུབ་པ་དག་གི་ཡང་འབྲས་བུ་ཡིན་ཏེ།",
    "དེས་ན་འཆི་བའི་གནས་སྐབས་དེ་ཉིད་མེད་པའི་ཕྱིར་ལྡོག་པ་མེད་པར་ཐལ་བ་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེས་ན་རྗོད་བྱེད་པའི་ཐལ་བ་མ་སྤངས་པ་ཉིད་དུ་སྙམ་དུ་དགོངས་པའོ།",
    "འོ་ན་གང་གི་ཚེ་ལྡོག་པ་མེད་པར་ཐལ་སྙམ་ན།",
    "གཞན་ལས་སྐྱེས་ཀྱང་ཞེས་ཀྱང་གི་སྒྲ་ནི་སྲིད་པ་ལའོ།",
    "འོ་ན་དེ་དག་གི་རང་བཞིན་གང་ལས་སྐྱེས་སྙམ་ན།",
    "རང་གི་ངོ་བོ་ནི་རྒྱུ་གཞན་ལས་ཞེས་སྨྲས་སོ།",
    "དེས་ན་ལྡོག་པ་མེད་པར་ཐལ་བ་སོ་ན་འདུག་གོ།",
    "ཐལ་བར་འགྱུར་བ་སྐྱེ་འདོད་པའི་སེམས་ལ་ལྟོས་ནས་སྔ་མ་འཆི་ཁ་མའི་སེམས་ཐ་མ་ཡང་དེའི་སྔ་མ་འདོད་ན་ལོག་པ་མ་ཡིན་ནོ།",
    "རྣམ་པ་དེ་ལྟ་བུའི་ཤེས་པའི་རྒྱུད་འདུས་བྱས་པའི་ཁྱད་པར་ཤེས་པ་ལས་སྐྱེས་པའི་བདག་གི་ཡོན་ཏན་ཁས་བླང་བར་བྱ་བ་འམ།",
    "རང་གི་འདོད་པས་སྡུད་པ་ནི།",
    "གང་གིས་དེ་ལ་གཞན་ཡང་དེ་ལྟར་འགྱུར་བ།",
    "དེ་ལ་རེ་ཞིག་དཔེ་ཉིད་རྣམ་པར་འགྲེལ་པ་ནི།",
    "འགའ་ཞིག་གིས་ཞེས་བྱ་བའོ།",
    "གཅིག་གི་རྨི་ལམ་གྱི་ཤེས་པ་ཅི་ལྟ་བ་དེ་ལྟར་གཞན་ནི་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་མོད།",
    "གང་གི་ཕྱིར་མི་དམིགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རེ་ཞིག་ཐ་དད་པ་ཉིད་ནི་བཟློག་པར་དཀའོ།",
    "ཐུན་མོང་མ་ཡིན་པར་དམིགས་པ་ཡིན་ཞེས་བྱ་བའོ།",
    "གང་གི་ཚེ་ཞེས་བྱ་བ་གཉིད་ལོག་པའི་གནས་སྐབས་ནའོ།",
    "རི་བོང་གི་རྭ་བཞིན་མེད་པའམ་ཟླ་བ་ལྟར་མི་བདེན་པའོ།",
    "བག་ཆགས་སྟོབས་ཆུང་བས་བྱས་པ་ཤེས་པ་སྟོབས་ཆུང་བའི་མིང་ཅན་རིང་དུ་མི་གན་ས་པ་དང་ཐུན་མོང་མ་ཡིན་པར་དམིགས་པ་གང་ཡིན་པ་དེ་རྨི་ལམ་གྱི་ཤེས་པའི་མི་བདེན་པ་ཉིད་ཡིན་གྱི་མེད་པའམ་བརྫུན་པ་མ་ཡིན་ཏེ་རིགས་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "ཐུན་མོང་དུ་དམིགས་པ་ཞེས་བྱ་བ་ལ།",
    "ཐུན་མོང་དུ་དམིགས་པ་ནི།",
    "ཐུན་མོང་དུ་དམིགས་པ་ཞེས་བྱ་བ་འདི་ལ་ཐུན་མོང་མ་ཡིན་པར་དམིགས་པའི་བྱ་བ་ཡོད་པ་སྟེ་འབྲུ་མང་པོ་བའོ།",
    "ཀུན་དུ་འཛིན་པའི་གོམས་པ་སྔོན་དུ་སོང་བ་ཅན་ནི་བདག་ཉིད་ལས་མཐོང་བ་ཉིད་དོ།",
    "དོགས་པ་བསུ་བ་ནི་མེ་ཙམ་ལས་འཇུག་གོ་ཞེས་བྱ་བ་སྟེ་མངོན་སུམ་མོ།",
    "ཅི་ལྟར་རྨི་ལམ་ཞེས་བྱ་བའི་གང་གི་ཚེ་རྨི་ལམ་གྱི་དམིགས་པ་མེད་པ་ན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྔོན་གྱི་ལུས་དེས་མོད་དོར་བ་གོ་ཅི་ལྟར་ཞེ་ན།",
    "རང་གི་དུས་དེའི་ཚེ་ཡང་ངོ།",
    "འབྲས་བུ་འཆི་བ་དང་གསོན་པ་རང་གི་རྒྱུ་ལ་ངེས་པའི་རྣམ་པར་གནས་པ་འདིར་མི་འགྱུར་རོ།",
    "བྱས་གང་ཞེས་བྱ་བ་ནི་གང་གིས་སམ་གང་ལས་བྱས་པ་དེ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་སླར་འཚོ་བར་ཅི་ལྟར་ཐལ་ཏེ།",
    "དེས་ན་གལ་ཏེ་གཉིད་མཐུག་པོའི་གནས་སྐབས་ན་དེ་ཆད་པ་རང་གིས་མ་རྟོགས་སུ་ཆུད་པ་དེ་ལྟར་ན་ཡང་སེམས་པ་མ་སྐྱེས་པའི་ལུས་ཀྱིས་ནི་གཞན་དག་མངོན་སུམ་གྱིས་ངེས་པར་བྱེད་པའམ།",
    "དེས་ན་གཉིད་ལ་སོགས་པ་བྱས་པ་སེམས་པ་དང་བྲལ་བའི་མཚན་ཉིད་ཀྱི་རྣམ་པར་འགྱུར་བ་ལྡོག་པ་ལྟར་འཆི་བའི་མཚན་ཉིད་ཀྱི་རྣམ་པར་འགྱུར་བ་ཡང་ལྡོག་པར་འགྱུར་བའི་ཕྱིར་སླར་འཚོ་བར་ཐལ་ལོ།",
    "དེའི་ཚེ་ཡང་བརྗོད་པའི་ཐལ་བ་མི་ལྡོག་གོ་ཞེས་སྟོན་པ་ནི།",
    "དེས་ན་ནུས་པའི་རང་བཞིན་ཡང་རིག་པ་ལས་གཞན་ཡིན་པའི་ཕྱིར་ན་རིག་པའི་རང་བཞིན་ཡོད་པ་མ་ཡིན་པ་ལ་ཁྱོད་རིག་པར་འདོད་པར་མི་བྱའོ།",
    "དེའི་ཕྱིར་དེ་གང་ཡིན་ཡང་གཉིད་ལོག་པ་ལྟར་ཤི་བ་ལ་ཡང་རྟོག་པ་ཡོད་པའི་ཕྱིར་སླར་འཚོ་བར་ཐལ་ལོ་ཞེས་བྱ་བའི་གནས་སོ།",
    "དེ་དང་མཐུན་པ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་བདག་གིས་འདི་ལྟར་བྱའོ་ཞེས་སོ།",
    "བདག་གིས་ཞེས་གསུངས་ཏེ།",
    "གང་གིས་གཉིད་ལོག་པ་བརྡེབས་པ་ཚར་ནས་མི་བཟད་པས་འཇིགས་པ་ལ་སོགས་པ་གོམས་པ་ལས།",
    "གང་གི་ཚེ་ཚོགས་པ་ཡིན་པས་གཉི་ག་གཅིག་པར་སྐྱེ་བ་དེའི་ཚེ་ན་གཉི་ག་ཡང་སད་པ་ཡིན་ནོ།",
    "བརྟན་སོགས་ཞེས་སོགས་པའི་སྒྲས་ནི་འདོད་པར་བྱ་བའི་བུད་མེད་གཟུང་ངོ།",
    "གང་གི་ཕྱིར་འདིར་རྣམ་པར་རིག་པ་ཙམ་ལས་འདས་པ་དང་ཅིག་ཤོས་དག་ལྷན་ཅིག་བྱེད་པ་ཉིད་དུ་མི་འཐད་པ་དེས་ན་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "འོན་ཀྱང་རྣམ་པར་ཤེས་པ་སྔ་མ་དེ་ཇི་ལྟར་རང་གི་རྒྱུས་དུས་ངེས་པར་བསྐྱེད་པ་དེ་བཞིན་དུ་བར་དུ་ཆད་པའི་དུས་དང་།",
    "འབྲེལ་པའི་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་དེས་སང་གི་དུས་ཀྱི་དེ་མ་ཐག་ཏུ་འབྲས་བུ་མི་སྐྱེད་པ་དང་།",
    "གཞན་གྱི་ཚེ་འབྲས་བུ་ནི་ཡོད་པར་ཐལ་བའི་ཉེས་པ་མེད་དོ།",
    "འདི་གང་གིས་ངེས་པར་ཟིན་ཏེ།",
    "འོན་ཏེ་མི་མཐུན་པ་ཚབས་ཆེན་པོ་སེམས་དང་བྲལ་བའི་མཚན་ཉིད་ནི་རང་གི་རྒྱུ་ལོག་ཀྱང་མི་རྟོག་པའི་ཕྱིར་ན།",
    "གང་ཞིག་རང་གི་རྒྱུན་ཡོད་ན་སྐྱེས་པ་དང་།",
    "དཔེར་ན་བུད་ཤིང་གི་རྣམ་པས་འགྱུར་བ་ལྟ་བུའོ།",
    "རྣམ་པར་འགྱུར་བ་གཞན་ཡང་བཟློག་ཏུ་མེད་པར་ཐལ་བ་ཉིད་དུ་སྟོན་པ་ནི་བརྒྱལ་བ་ལ་སོགས་པ་སྟེ་གཉིད་སྟུག་པོས་ལོག་པ་ལ་སོགས་པ་གང་དག་ཡིན་པ་དེ་དག་གིས་རྣམ་པར་ནི་རྣམ་པར་ཤེས་པ་མེད་པའི་མཚན་ཉིད་དེ་རང་བཞིན་དེ་ཉིད་གང་ལ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་དག་གིས་བྱས་པའི་རྣམ་པར་འགྱུར་བ་ནི་སེམས་ལྡོག་པའི་མཚན་ཉིད་འཇིག་རྟེན་གྲགས་པ་དེ་སེལ་བར་ནུས་པའོ།",
    "དེ་ལྟར་རང་གི་ལུགས་ལེགས་པར་བསྟན་ནས་སླར་འཚོ་བ་ཐལ་བ་འདི་ནི་གཞན་ཁོ་ན་ལས་ཡིན་ནོ་ཞེས་མཇུག་སྡུད་པའི་སྒོ་ནས་སྟོན་པ་ནི་དེའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "དེ་ལ་མཚན་ཉིད་གཞན་བསྒྲུབས་པས་རེ་ཞིག་དེ་དགག་པ་བརྗོད་པ་ནི་མ་ཡིན་ཏེ་ཞེས་བྱ་བའོ།",
    "མེ་ནི་སེང་ལྡེང་ལ་སོགས་པ་དང་ཐུན་མོང་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་དེ་ལྟ་ན་སཱ་ལུའི་རང་བཞིན་ལ་ཆུ་ཉེ་བར་ལེན་པ་མ་ཡིན་མོད།",
    "སཱ་ལུའི་རང་བཞིན་བརྒྱུད་པས་གནས་པ་ན་ལྷན་ཅིག་བྱེད་པ་དག་ལས་ཁྱད་པར་གཞན་དང་གཞན་པ་ན་རེ་ཞིག་ཡོད་པ་ཡིན་ནོ།",
    "བ་མེན་བ་ལང་གི་ཞེས་བྱ་བའོ།",
    "རང་གི་བརྗོད་པའི་ཉེ་བར་ལེན་པའི་མཚན་ཉིད་དྲན་པར་བྱེད་པས།",
    "གང་གི་ཚེ་ཆུ་ལོག་ན་ལྡོག་པ་མ་ཡིན་ནོ་ཞེས་འདོན་པ་དེའི་ཚེ་ནི་དེ་ཞེས་བྱ་བ་རྒྱུན་ལ་བྱ་སྟེ་རྒྱུན་དེ་ནི་ཆུ་ལོག་ཀྱང་མི་ལྡོག་གོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ན་རྣམ་པར་ཤེས་པའི་རྒྱུན་ནི་རྣམ་པར་ཤེས་པའི་རྒྱུན་གྱི་རྒྱུ་ཡིན་པའི་ཕྱིར་ལུས་ཉེ་བར་ལེན་པར་ཐལ་ལོ་ཞེས་བྱ་བ་ནི་གཞན་གྱི་བསམ་པའོ།",
    "གང་གི་ཕྱིར་སྔ་མ་རྣམ་པ་ཐམས་ཅད་དུ་ཉམས་པ་ན་ཕྱིས་ལུས་ལས་སྔ་ན་མེད་པའི་སེམས་ཉིད་སྐྱེ་བའི་ཕྱིར་རོ་སྙམ་ན།",
    "གལ་ཏེ་རྣམ་པར་ཆད་པ་རྟག་ཏུ་རང་ཉིད་མི་དམིགས་པ་ཡིན་པ་དེ་ལྟ་ན་ཡང་མཐའ་གཅིག་ཏུ་བྱ་བར་མི་ནུས་པའི་ཕྱིར་ན་རེས་འགའ་གཏན་དུ་རྣམ་པར་ཆད་པར་ཡང་འགྱུར་རོ།",
    "སྔོན་དང་ཕྱི་མ་དག་གི་མཐའ་རྣམ་པར་ཆད་པ་དམིགས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་རྗེས་སུ་འཇུག་པ་དེ་ནི་སྔོན་གྱི་འདུ་བྱེད་མེད་པར་མ་ཡིན་ལ་དེ་བཞིན་དུ་འདུ་བྱེད་སྔ་མ་སྔ་མ་ཡང་ངོ།",
    "འོན་ཏེ་ཡང་འདོད་ཆགས་དང་བྲལ་བ་ནི་ཉོན་མོངས་པ་མ་ལུས་པ་བྲལ་བའི་ཕྱིར་ན་སེམས་ཀྱི་རྒྱུན་གནས་པ་ལ་ཉམས་པ་སྲིད་པའི་ཕྱིར་རྣམ་པར་ཆད་པར་འགྱུར་རོ་སྙམ་ན་འདོད་ཆགས་དང་བྲལ་བས་གསུངས་སོ།",
    "རང་གི་དོན་ལ་ཞེས་གསུངས་སོ།",
    "འདོད་ཆགས་དང་བྲལ་བའི་གནས་སྐབས་ན་ནི་འབྲས་བུ་སྐྱེད་མི་ནུས་པའི་སྐད་ཅིག་འཇོག་པས་རྒྱུན་ཆད་པ་ཡིན་དུ་ཆུག་མོད།",
    "དེས་ན་མཐའ་མེད་པ་ཉིད་ནི་ཀུན་ནས་ཉོན་མོངས་པའི་གནས་སྐབས་ལ་ལྟོས་ནས་འདོད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རེ་ཞིག་རྟེན་གྱི་དངོས་པོ་ཁས་བླངས་ནས་རང་ཉིད་རྩོད་པ་འདི་སེལ་བ་ཡིན་ཡང་གནོད་པ་མ་ཡིན་ནོ་ཞེས་རྣམ་པར་ཤེས་པ་ནི་རི་མོ་བཞིན་དུ་རྟེན་སོ་སོར་ངེས་པ་མ་ཡིན་ནོ་ཞེས་འབྲེལ་ཏོ།",
    "ཅི་ལྟར་ཞེ་ན་གང་གང་གི་ཕྱིར་དང་པོའི་སྐྱེ་བར་སྐྱེ་བ་གཞན་གྱི་ལུས་དང་ལྷན་ཅིག་སྤྱོད་པའི་འདུ་བྱེད་པ་གང་ཡིན་པ་དེ་དང་རྗེས་སུ་འབྲེལ་པ་དང་།",
    "རྨི་ལམ་གྱི་དེ་མ་ཐག་ཏུ་སད་པའི་གནས་སྐབས་སུ་འཇིགས་པ་དང་མྱ་ངན་ལ་སོགས་པས་རྨི་ལམ་གྱི་འདུ་བྱེད་གང་ཡིན་པ་དེ་དང་རྗེས་སུ་འབྲེལ་པར་དམིགས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ལྷག་མའི་རྟེན་སོ་སོར་ངེས་པ་མ་ཡིན་མོད།",
    "རང་གིས་སྤངས་ནས་ད་ནི་རྟེན་ཉིད་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་སྟོན་པས་རྣམ་འགྲེལ་ལ་འགྲེལ་པ་ནི་གཞན་ཡང་ཞེས་བྱ་བའོ།",
    "འོ་ན་ཇི་ལྟར་རི་མོ་ལ་སོགས་པ་འཇིག་སྙམ་པ་ལ།",
    "རི་མོ་ལ་སོགས་པ་ནི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་ན་དེ་ཉིད་བྱས་མོད་ཅེ་ན་སྐྱོན་ཅི་ཡོད་ཞེ་ན།",
    "རང་གི་དང་བའི་ཞེས་བྱ་བ་ནི་སྐབས་ཀྱིས་གནས་པར་བྱ་བ་ལས་སོ།",
    "དེ་ལ་རེ་ཞིག་ཕྱོགས་གཉིས་པ་ཉིད་སེལ་བ་ནི་ཤིང་ལ་སོགས་པའི་ཞེས་གསུངས་སོ།",
    "ཐལ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་རབ་ཏུ་འབྲེལ་པ་སྟེ་དེའི་ཕྱིར་རོ།",
    "དེས་ན་དེར་ནི་བ་ལང་འདི་ལ་རིགས་ཞེས་བྱ་བ་འདི་རང་གི་རྟོག་པ་ཙམ་ཡིན་ནོ།",
    "རང་གི་རྟོག་པ་ཙམ་ཞིག་ཐབས་སུ་འགྱུར།",
    "དེ་ལྟ་ན་ཡང་ཞེས་བྱ་བ་ནི་རང་གི་འདུ་བ་ཅན་རྣམས་འདུས་པ་ཉིད་ཡིན་ཡང་འདིར་འདི་རང་གི་འདུ་བ་ཅན་གྱི་ཡན་ལག་འདུས་སོ་ཞེས་དེ་ལྟ་བུའི་རང་བཞིན་ཅན་ཐ་དད་པར་རྟོགས་པས་སོ།",
    "དོན་འདི་ཡིན་ཏེ་གལ་ཏེ་གཉིས་རང་གི་ངོ་བོས་སྣང་ན།",
    "དེ་ལྟར་ཕྱོགས་གཅིག་གིས་འབྱར་བ་ཁས་བླངས་ནས།",
    "ཐ་དད་པར་རྟོགས་པར་ཐལ་བ་ནི་གནས་དང་གནས་པ་ཅན་ཏེ།",
    "ཡུལ་དང་དུས་དག་གི་མངོན་སུམ་གྱི་རྣམ་པ་ཐ་དད་པར་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "གང་གི་ཕྱིར་དེ་ལྟར་གཞི་ལས་ཐ་དད་པ་ཐ་མི་དད་པ་གནས་པར་མི་འཐད།",
    "དེས་ན་གནས་པ་ནི་འཇིག་པ་དང་འགལ་བས་ཁྱབ་པ་ཡིན་པའི་ཕྱིར་ཐལ་བར་འགྱུར་བ་རིགས་སོ།",
    "དེ་ལའང་ཐལ་བར་མཚུངས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འཇིག་པ་དེ་ཡང་དངོས་པོ་ལས་ཐ་དད་པའམ་ཐ་མི་དད་པ་ཡིན།",
    "ཅིའི་ཕྱིར་འཇིག་པ་མེད་པར་ཐལ་སྙམ་ན།",
    "དངོས་པོ་ལས་འཇིག་པ་གཞན་ཡིན་ན་ཡང་འཇིག་པའི་རྒྱུ་དེས་དངོས་པོ་ལ་ཅི་ཞིག་བྱས་ནས་གང་གིས་དེའི་འཇིག་པར་བྱེད་པར་འགྱུར།",
    "འཇིག་པར་བྱེད་པར་ཐལ་བར་འགྱུར།",
    "རེ་ཞིག་རྩོད་པའི་ཆ་རྣམ་པར་འགྲེལ་པ་ནི་གནས་པར་བྱེད་པ་མེད་ན་ཞེས་བྱ་བའོ།",
    "གང་གི་ཕྱིར་གནས་པར་བྱེད་པ་མེད་པར་འཇིག་པ་གང་ཡིན་པ་དེ་ནི་འཇིག་བྱེད་མེད་པར་རང་ཉིད་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "གལ་ཏེ་དེ་ལྟ་ཡིན་མོད་དེ་ལྟ་ན་ཡང་གནས་པར་བྱེད་པར་བྱེད་པ་ཇི་ལྟར་ཉེ་བར་སྦྱོར་བ་ཡིན་སྙམ་ན།",
    "འོན་ཏེ་མི་འཇིག་པའི་ཕྱིར་མེད་པ་མ་ཡིན་མོད།",
    "དེ་ཉིད་སྟོན་པ་ནི་བྱ་བའི་རྟེན་གང་ཡིན་པ་དེ་ནི་བྱེད་པ་པོ་དང་ལས་དག་གིས་འཛིན་པ་ལས་ཡིན་ནོ།",
    "རིགས་པ་འདི་དག་གིས་ཅི་ཞིག་བྱ་སྟེ་མངོན་སུམ་ཉིད་ཀྱིས་སྔ་མ་དང་ཕྱི་མའི་རང་བཞིན་གཅིག་ཏུ་བྱས་ནས་གཟུང་བས་ན།",
    "ཡོད་པ་ནི་བདེན་མོད་ཀྱི་འོན་ཀྱང་རྣམ་པར་རྟོག་པ་ཙམ་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་དུས་གཞན་ཁྱབ་པ་དང་བྲལ་བའི་མངོན་སུམ་གྱིས་སྐད་ཅིག་གཅིག་ཉིད་ལ་གནས་སྐབས་འཛིན་པ་མ་ཡིན་མོད།",
    "གང་གིས་བྱ་བ་ནི་རིམ་པ་མངོན་སུམ་དུ་གྱུར་པས་སོ།",
    "ཡང་མངོན་སུམ་གང་གིས་དམིགས་པའི་ཞེས་སྦྱར་རོ།",
    "འོ་ན་ནི་ཞེས་བྱ་བ་ནི་བྱ་རོག་གི་ལན་ནོ།",
    "ཕྱིན་ཅི་ལོག་གི་རྣམ་པར་རྟོག་པ་ནི་མཐོང་བ་ཡང་ཡིན་ཏེ་ནང་གི་ནི།",
    "སྔ་མ་ཕྱི་མར་སྐྱེ་བ་ཅན་ཕྱིན་ཅི་ལོག་གི་ཤེས་པ་ཅན་འདི་ནི།",
    "གཅིག་ཉིད་དུ་རྣམ་པར་རྟོག་པ་ཡང་གཅིག་ཏུ་མཐོང་བ་ཅན་དུ་འགྲོ་བ་ཅན་ཡིན་མོད།",
    "ཕྱིན་ཅི་ལོག་གི་རྣམ་པར་རྟོག་པ་ནི་ཤེས་པ་སུམ་དང་འབྲེལ་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ཙམ་ཞིག་བསྟན་པར་འདོད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་དཔེ་དོན་ཉམས་སུ་མྱོང་བ་རྣམ་པར་རྟོག་པ་དེ་སྐྱེད་པའི་ས་བོན་འཇོག་པར་བྱེད་པ་ཡིན་པ་དེ་བཞིན་དུ་དོན་མེད་པའི་རྣམ་པར་རྟོག་པས་ཀྱང་གལ་ཏེ་རིགས་མཐུན་པ་སྐྱེ་བའི་ས་བོན་འཇོག་མོད་ཉེས་པ་ཅི་ཡོད།",
    "དེ་ལྟར་ཡོན་ཏན་ལ་སོགས་པ་ལ་རྟེན་མེད་མོད།",
    "གང་གི་ཕྱིར་མ་གྲུབ་པ་ལ་སོགས་པ་བརྗོད་ལ།",
    "རྟེན་དང་བརྟེན་པའི་དངོས་པོ་བསལ་བ་འདིས་ནི་གལ་ཏེ་རྟེན་དང་བརྟེན་པའི་དངོས་པོ་བསལ་བས་འདུ་བ་ལ་སོགས་པ་རྣམས་བསལ་བར་གྱུར་མོད།",
    "རིགས་ནི་ཚིག་གི་དོན་གསུམ་པ་ཡོད་པ་དང་།",
    "འོན་ཏེ་ཐམས་ཅད་ཐམས་ཅད་དུ་སོང་བའི་ཕྱོགས་ལ་གནས་ན་སྔར་ཡོད་པ་ཡིན་ན་ཡོད་མོད་གོང་བུ་དེ་དང་འབྲེལ་པར་འགྱུར་བ་ནི་མ་ཡིན་ཏེ།",
    "རྗེས་སུ་མ་སོང་བ་གསལ་བ་གསལ་བ་གཞན་པ་ལ་རྗེས་སུ་འགྲོ་བ་དེ་བཞིན་དུ་སེམས་ཀྱང་ལུས་གཞན་ལ་ཡིན་ནོ།",
    "གལ་ཏེ་རྣམ་པ་དང་དོན་བྱ་བ་ལ་སོགས་པ་མཚུངས་པའི་མཚན་ཉིད་ཀྱི་ཉེ་བ་འགའ་ཞིག་གིས་གཞན་ལ་བ་ལང་ཞེས་བྱ་བ་ལ་སོགས་པ་རྗེས་སུ་འགྲོ་བའི་བློར་འགྱུར་བ་ཡིན་ན།",
    "རེ་ཞིག་ལུས་གཞན་རྣམ་པ་ལ་སོགས་པ་མི་འདྲ་ཡང་རྒྱུན་དེ་ལ་ལས་འཇིག་པ་ཉིད་ཉེ་བར་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་ཐ་དད་པ་ནི་འཆི་བ་དང་སྐྱེ་བའི་སྲིད་པ་ལ་སོགས་པ་འདོད་པ་ཁོ་ནའོ།",
    "རེ་ཞིག་འཇིག་པའི་དངོས་པོ་གང་ཡིན་པ་དེ་གཞན་ལ་ལྟོས་པའམ་མི་ལྟོས་པ་ཡིན།",
    "ཡུལ་དང་རྣམ་པ་དག་གི་ཆས་རྗེས་སུ་འཇུག་པའི་ཕྱིར་རོ།",
    "དེ་དག་གི་དངོས་པོ་གང་དག་ཡིན་པའི་ཕྱིར།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་གང་གི་ཕྱིར་བློ་ལུས་འཕེལ་བ་དང་འགྲི་བ་པའི་རྗེས་སུ་མི་བྱེད་པ།",
    "གལ་ཏེ་བློ་ནི་བློའི་བྱེད་པའི་ཁྱད་པར་ཉིད་ཀྱིས་བྱས་མོད་དེ་ལྟ་ན་ལུས་ལ་ནི་བརྟེན་པ་ཁོ་ན་སྟེ།",
    "མར་མེ་དང་ཉེ་བར་གནས་པ་ཙམ་དུ་གྱུར་པའི་སྦྲུལ་ལ་སོགས་པ་དག་གིས་མར་མེའི་འོད་རྣམ་པར་འགྱུར་བ་མ་ཡིན་ཡང་མར་མེ་ལ་བརྟེན་པ་མ་ཡིན་པ་བཞིན་ནོ།",
    "མར་ཁུ་ལ་སོགས་པ་རང་གི་ཚོགས་པ་ལས་མར་མེའི་མདངས་གསལ་བའི་རྣམ་པ་དང་ལྡན་པ་ཡིན་ཡང་སྦྲུལ་ལ་སོགས་པ་ཉེ་བ་ཙམ་གྱིས་ཆུང་བར་འགྱུར་བར་མཐོང་བ་ཉིད་དོ།",
    "གང་གི་ཕྱིར་བཅུད་ཀྱིས་ལེན་ལ་སོགས་པ་ཟོས་པ་ལས་བསྟན་བཅོས་ལ་སོགས་པ་ཤེས་པ་སྔ་ན་མེད་པ་ཉིད་སྐྱེ་བ་ཡིན་ནོ་སྙམ་ན།",
    "དེའི་ཚེ་བཅུད་ཀྱིས་ལེན་དེ་ལས་བསྟན་བཅོས་སམ་སྐྱེས་བུ་ཐམས་ཅད་འཆད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ཐལ་བའོ།",
    "འདི་ནི་རྟོག་མེད་ཀྱི་ཤེས་པ་ཉེ་བར་མཚོན་པ་ཙམ་མོ།",
    "གལ་ཏེ་བརྩེ་བ་ལ་སོགས་པ་རྣམས་དྲན་པའི་རང་བཞིན་ཡིན་མོད།",
    "རིགས་གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཚིག་རྐང་གསུམ་གྱིས་ནི་ཡིད་གཞུངས་པའི་རང་བཞིན་ཡང་བརྗོད་པ་ཡིན་ནོ།",
    "དྲན་པའི་རྗེས་འབྲངས་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་བདག་གིས་ནི་དེ་ལྟར་ཐོས་པ་འམ་རྟོགས་པ་ཡིན་ནོ་ཞེས་སྒྲ་འམ་དོན་ངེས་པ་ནི་ཡིད་གཞུངས་པའོ།",
    "དེ་ལྟར་བློའི་རང་བཞིན་ཡིན་མོད།",
    "དེས་ན་དེ་དག་གི་སྔོན་གྱི་གོམས་པ་ལ་མི་འཁྲུལ་པ་ཁོ་ནའོ།",
    "དེ་ལྟར་རང་གི་ངོ་བོ་བསྟན་ཏེ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་རང་གི་ངོ་བོ་མ་གྲུབ་པ་ལ་སོགས་པ་ཉེས་པ་མེད་ན།",
    "འཇིག་རྟེན་རྒྱང་འཕན་པས་བརྗོད་པ་བདེ་བ་དང་སྡུག་བསྔལ་ལས་སྐྱེས་པའི་འདོད་ཆགས་ལ་སོགས་པ་འཕེལ་བ་གང་ཡིན་པ་དེ་ཡང་རེས་འགའ་ཁོ་ན་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁམས་སྙོམས་པ་དང་མ་སྙོམས་པ་ལ་སོགས་པ་ནང་གི་དོན་ཏོ་ཡུལ་དེ་ཉིད་ལས་སྐྱེ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "དེ་ལ་འགའི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པ་རེ་ཞིག་རྣམ་པར་འགྲེལ་པ་ནི།",
    "གང་གིས་དེ་ལྟར་བརྗོད་པ་དེ་ལྟ་བུ་འགའ་ཞིག་མཐོང་ངམ་ཅི་སྙམ་ན།",
    "ཚུལ་བཞིན་མ་ཡིན་པའི་ཡིད་ལ་བྱེད་པ་ཤས་ཆེ་བ་ལ་ནི་འདོད་ཆགས་འབྱུང་གི་སྡང་བ་ལ་ནི་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པ་དེའི་ཕྱིར་བདེ་བ་དང་སྡུག་བསྔལ་བ་ལས་སྐྱེས་པ་ཡང་བརྗོད་པ་ཡིན་ནོ།",
    "འཇིག་རྟེན་རྒྱང་འཕེན་པའི་ལུགས་ལ་བརྟེན་པ་ཉིད་ཀྱིས་ཞེ་སྡང་སྡུག་བསྔལ་ལས་སྐྱེས་པར་གཞན་དག་གི་དོགས་པ་བསུ་བ་ནི།",
    "རེས་འགའ་ཞེས་བྱ་བའི་དོན་ཉིད་གསལ་བར་བྱེད་པས་འདི་ཡང་སུན་འབྱིན་པ་ནི་འདིར་ཞེས་བྱ་བའོ།",
    "རང་གི་སྡུག་བསྔལ་རྒྱུར་གྱུར་པས།",
    "སོ་སོར་རྟོག་པ་དང་བྲལ་ཡང་འགའ་ཞིག་རང་བཞིན་གྱིས་བཟང་བས་ན་སྡང་བ་ཤས་ཆུང་བ་ནི་སྡུག་བསྔལ་ཕྱིར་གཞིལ་བར་བྱེད་པ་ལ་མོད་ལ་ཆགས་པས་སྡུག་བསྔལ་སྐྱེ་བ་སེལ་བར་བྱེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བདེ་བ་དང་སྡུག་བསྔལ་དེ་དག་གིའོ།",
    "དེའི་ཚེ་ཉེ་བར་གནས་པའི་ཡུལ་ནི་ཕྱི་དང་ནང་མཚུངས་ཏེ་དེའི་ཕྱིར་བདེ་བ་ལ་སོགས་པའི་ཡང་རྟེན་མ་ཡིན་ན་དེའི་སྒོ་ནས་སེམས་ཀྱི་རྒྱུན་གྱི་རྟེན་དུ་ལྟ་འགྱུར་རེ་ཡང་སྐན།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ནང་དང་ཕྱིའི་ཡུལ་མཚུངས་པའི་གཏན་ཚིགས་དེས་ན་ནང་འབའ་ཞིག་རྟེན་དུ་འགྱུར་བར་མ་ཟད་དོ།",
    "མེ་ཏོག་ཕྲེང་དང་ཙནྡན་ལ་སོགས་པ་ཕྱི་རོལ་ཡང་རྒྱུ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ།",
    "འགྱུར་ན་རག་མོད་སྙམ་ན།",
    "ཕྱི་རོལ་ཡང་ཉེ་བར་ལེན་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ་ཞེས་ཅི་སྟེ་བརྗོད་སྙམ་ན།",
    "གང་གི་ཚེ་ཞེས་གསུངས་སོ།",
    "འོན་ཏེ་ཞེས་ནང་གི་ཡན་ལག་ཉིད་དུ་ཉེ་བར་གནས་པ་ཅི་ལྟར་དམིགས་པ་མ་ཡིན་སྙམ་ན།",
    "གང་གིས་ནང་གི་དོན་མྱོང་བར་བྱེད་པ་ཡང་མི་མཐུན་པར་སྐྱེ་བར་འགྱུར་བ།",
    "དེ་ལ་བརྟེན་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ནང་གི་དོན་ཏོ།",
    "དེ་ལྟ་ན་ནི་ཕྱི་རོལ་ཡང་རྟེན་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་དུ་དགོངས་པའོ།",
    "དེ་ལྟ་ཡིན་ལ་རག་མོད་སྙམ་ན།",
    "ནང་གི་ཡུལ་ལ་རྒྱུ་བ་དེ་སྤངས་ནས་སོ།",
    "ནང་དོན་ཁྱད་པར་ནི་བཟོད་པར་དཀའ་བའི་རེག་བྱའི་མཚན་ཉིད་སྡུག་བསྔལ་གྱི་བློ་སྐྱེད་པར་བྱེད་པ་གང་ཡིན་པའོ།",
    "ལུས་པ་ལ་སོགས་པ་འབའ་ཞིག་ལས་ཡིན་པར་ནི་མ་ཟད་དེ་འོན་ཀྱང་བཅུད་ཀྱིས་ལེན་པ་ལ་སོགས་པས་ཀྱང་ནང་གི་དོན་ཉེ་བ་ན་བདེ་བ་ལ་སོགས་པའི་བློ་སྐྱེད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་དཔེར་ན་མིག་ལ་སོགས་པ་རྣམས་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་སྐྱེ་བའི་རྟེན་ཡིན་པ་དེ་བཞིན་དུ།",
    "གལ་ཏེ་མ་དམིགས་ཀྱང་རྒྱུར་འགྱུར་ན་གང་གིས་དེ་སྐད་བརྗོད་ཅེ་ན།",
    "བདེ་བ་ལ་སོགས་པའི་ཤེས་པས་ཡུལ་དུ་མ་བྱས་པའི་ལུས་བདེ་བ་ལ་སོགས་པའི་རྒྱུར་ཁས་ལེན་ནམ་ཤེས་པ་ཐམས་ཅད་ཀྱི་རྒྱུ་ཡིན་པར་ཐལ་ལོ།",
    "གང་གིས་ཡིད་གཞུངས་པ་ལ་སོགས་པའི་རྒྱུར་མི་འགྱུར་བ་མ་ཤེས་པ་ཉིད་དུ་ནི་ཁྱད་པར་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "ནང་གི་དོན་གྱི་མཚན་ཉིད་ཅན་ནོ།",
    "ནང་གི་དོན་གྱི་མཚན་ཉིད་ཅན་བདེ་བ་ལ་སོགས་པ་སྐྱེད་པར་བྱེད་པའི་ལུས་མེད་ཀྱང་ངོ།",
    "གང་གིས་བརྒྱུད་ནས་འདོད་ཆགས་ལ་སོགས་པའི་རྟེན་དུ་འགྱུར།",
    "གང་གིས་སྐྱེ་བ་དྲན་པ་ཉམས་པ་ལ་སོགས་པ་འདུས་པ་ལ་སོགས་པས་བསྐྱེད་པའི་དྲན་པ་ཉམས་པ་དེ་ལྟར་རྟོགས་པ།",
    "རྒྱུ་ཁྱད་པར་ཅན་ནི་སྔར་བའི་ཁྱད་པར་ཙམ་མོ།",
    "དཔེར་ན་ནང་གི་ཡུལ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པས་བསྟན་པ་ཉིད་ཡིན་ནོ།",
    "འོ་ན་སེམས་རྟེན་མེད་པར་ཐལ་ལོ་སྙམ་ན།",
    "རང་གི་འབྲས་བུ་རྗེས་སུ་མཐུན་པའི་རེག་པ་བསྐྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གཏན་མི་སྐྱེད་པའམ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་འདུ་བྱེད་པའི་ཁྱད་པར་གྱི་སེམས་ཐ་དད་པར་འགྱུར་བ་དེའི་ཕྱིར་རོ།",
    "སེམས་ཉིད་ལྡོག་ན་སེམས་ལྡོག་གི་ལུས་ལྡོག་ན་ནི་མ་ཡིན་པའོ།",
    "གལ་ཏེ་དེ་ལྟར་རྟེན་ཡིན་མོད།",
    "དེས་ན་གང་གིས་དེ་ལོག་ན་ལྡོག་པ་འམ།",
    "ཤེས་པ་སྔ་མ་ལ་མ་ལྟོས་པར་ནི་རང་གི་ཤེས་པ་ལ་ཡང་ནུས་པ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "གང་གི་ཚེ་རྣམ་པར་ཤེས་པ་སྔ་མ་ཉིད་ལ་ལྟོས་ནས་སྐྱེ་བ་ཡིན་པ་དེའི་ཚེ་དུ་བ་དཔེར་ཅི་ལྟར་སྲིད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "གང་གི་ཕྱིར་ངེས་པ་མེད་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་ནི་ཐམས་ཅད་ལ་ཡང་བརྗོད་པར་ནུས་པ་ཡིན་ནོ།",
    "སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པར་སྣང་བ་འགའ་ཞིག་ནི་དོན་ཉིད་དུ་ལྷག་པར་མོས་པས་དོན་ཡིན་ལ།",
    "དོན་དུ་མོས་པ་མེད་པའི་ཕྱིར་རོ།",
    "ཞེན་པར་བྱེད་པའི་གཞལ་བྱ་གང་དང་གང་ཡིན་པ་དེ་ལྟ་བུའི་རྣམ་པ་འདི་ལ་ཡོད་པའོ་ཞེས་བྱ་བ་ནི་ཐུན་མོང་གི་ཚུལ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་སྐབས་ཉམས་པ་མེད་དོ་ཞེས་བྱ་བར་གཟིགས་ནས་གྲུབ་པའི་མཐའ་གསུངས་པ་ན།",
    "ཕ་མ་བཞིན་དུ་བུ་ལ་འདུས་བྱས་པ་ཡིན་ཡང་རེས་འགའ་མཁས་པ་ལ་སོགས་པའི་རང་བཞིན་མེད་པའི་ཕྱིར་རོ་དེ་ལྟ་མ་ཡིན་པར་ཡང་སྟེ།",
    "རང་གི་སྔོན་གོམས་པའི་རྗེས་སུ་འཇུག་པ་ཡང་མ་མཐོང་བར་ཅི་ལྟར་རྟོགས་སྙམ་ན།",
    "རང་གི་རྒྱུད་ལ་ཞེས་གསུངས་སོ།",
    "དེས་ན་འདུ་བྱེད་པ་དེ་ཡང་བརྒྱུད་ནས་རང་གི་འདོད་པ་ལས་བྱུང་བས་ན།",
    "རང་གི་རྒྱུད་ཁོ་ན་ལས་གྱུར་པ་ཡིན་ནོ།",
    "ཡིན་མོད་ཅེས་བྱ་བ་ནི་གྲུབ་པའི་མཐའོ།",
    "འདོད་པའི་ལྷན་ཅིག་བྱེད་པ་ལ་ལྟོས་མོད་རང་གི་ཡོད་པའི་རིགས་ལ་ལྟོས་པ་ཉིད་དེ་རང་གི་སེམས་ཀྱི་རྒྱུན་སྔ་མ་ལ་ལྟོས་པ་ཉིད་ཀྱི་འདུ་བྱེད་པ་སྐྱེ་བས་མ་སྤངས་པ་ཅི་ཡོད།",
    "ཐམས་ཅད་ཕའི་རང་བཞིན་གྱི་རྗེས་སུ་འཇུག་པར་ཐལ་བའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་གང་ཡིན་པ་དེ་མི་འགྲིབ་པར་བྱ་བའི་དོན་དུ་དོགས་པར་བྱེད་པ་ནི།",
    "དེས་ན་ཐམས་ཅད་ཕའི་རང་བཞིན་གྱི་རྗེས་སུ་འཇུག་པར་ཐལ་བ་མ་ཡིན་སྙམ་དུ་དགོངས་པའོ།",
    "འོན་ཏེ་ཡང་དེ་ལྟར་འགྱུར་མོད།",
    "ཐལ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དེ་མ་ཐག་ཏུ་ཞེས་ཀྱི་སྒྲ་ནི་བལྟ་བར་བྱའོ།",
    "འདི་ལྟར་ཤིང་ཝ་ཊ་ལས་ཤིང་དུ་མ་འབྱུང་ཡང་ཤིང་ཝ་ཊའི་རང་གི་རང་བཞིན་མ་ཡིན་པ་ནི་མ་ཡིན་ནོ།",
    "དེས་ན་སྔར་གྱི་ཤེས་པ་གཅིག་པའི་རང་བཞིན་གྱི་རྗེས་སུ་འཇུག་པར་ཐལ་བ་བཟློག་པར་དཀའོ།"
  ]
