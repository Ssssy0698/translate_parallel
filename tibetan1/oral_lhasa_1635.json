    "འགྱུར་ཕྱིར་དེ་ཁྱད་པར་དུ་འགྱུར་བའི་ཕྱིར་ཏེ་ཞེ་སྡང་ཞེས་བྱ་བར་འབྲེལ་ལོ།",
    "ཐམས་ཅད་འགྱུར་བའི་རྗེས་སུ་བྱེད་པ་ནི་འགའ་ཞིག་ཁོ་ནའི་ཡིན་པར་ནི་མི་རུང་ངོ།",
    "གཞན་གྱི་སྨྲ་བ་དྲན་པར་བྱེད་པ་ནི་ཇི་སྐད་དུ་ཞེས་བྱ་བའོ།",
    "མ་མཐོང་བའི་ཁྱད་པར་ནི་རྒྱུ་ལ་བརྟེན་པའོ།",
    "ཁྱད་པར་གཞན་ཞེས་བྱ་བ་ནི་རྒྱུ་ལ་གནས་པའོ།",
    "གལ་ཏེ་ཇི་ལྟར་འདོད་ཆགས་ཀྱི་རང་བཞིན་ཅན་གྱི་ཞེ་སྡང་གཞན་གྱི་རྒྱུ་ཅན་ཡིན་ནོ་ཞེས་ཁྱད་པར་གཞན་རྟོག་པ་དེ་བཞིན་དུ་འདོད་ཆགས་ཀྱི་ཁྱད་པར་ཡང་དེ་ལས་གཞན་པའི་ཁྱད་པར་གྱི་རྒྱུ་ཅན་ཡིན་ནོ་སྙམ་དུ་དོགས་པ་ནི་དེར་ཡང་ཞེས་བྱ་བ་སྟེ།",
    "འདོད་ཆགས་ཀྱི་རང་བཞིན་ལ་གནས་པའི་ཁྱད་པར་དེའོ།",
    "མཐོང་བ་ནི་མ་མཐོང་བའི་ཁྱད་པར་དུ་རིགས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ།",
    "འབྲས་བུའི་ཁྱད་པར་མཐོང་བ་ནི་མ་མཐོང་བའི་ཁྱད་པར་ཏེ་རྒྱུ་གང་ལ་ཡོད་པ་སྟེ།",
    "མ་མཐོང་བའི་ཁྱད་པར་ཅན་གྱི་དངོས་པོ་དེར་མི་རིགས་སོ།",
    "དེའི་ཁྱད་པར་ལས་ཞེས་གསུངས་ཏེ།",
    "ཁྱད་པར་དུ་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་ཁྱད་པར་དུ་འཛིན་ནའོ།",
    "ཁྱད་པར་ཡོད་མིན་ཞེས་བྱ་བ་ནི་སྐབས་ཀྱིས་འདོད་ཆགས་སོ།",
    "མ་གྲུབ་ཉིད་ཅེས་བྱ་བ་དེའི་རྣམ་པར་འགྲེལ་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "དེས་ན་སྐྱོན་རྣམས་ཁྱད་པར་ཡོད་ན་ཡང་ཁྱད་པར་མེད་ཕྱིར་ཞེས་བྱ་བ་འདི་ལ་ལྟོས་ནས།",
    "ཞེ་སྡང་ཉིད་དུ་ཞེས་པར་གཟུང་བས་ནི།",
    "འདོད་ཆགས་ཙམ་ཡང་མེད་པར་བསྟན་ཏོ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ནི་ཞེས་གསུངས་སོ།",
    "མེད་པའི་ཕྱིར་ཁྱབ་པར་བྱེད་པ་མེད་པས་ན་འདོད་ཆགས་ནི་འབྲས་བུ་ཡིན་ནོ་ཞེས་མི་རིགས་སོ།",
    "གཞན་གྱིས་གེགས་བྱས་ན་ཞེས་བྱ་བ་ནི་ལྷན་ཅིག་བྱེད་པ་མ་ཚང་བས་གེགས་བྱས་ནའོ།",
    "འདིས་ནི་བཟློག་པའི་རྗེས་སུ་བྱེད་པ་མེད་པར་བརྗོད་པ་ཡིན་ནོ།",
    "ངེས་པ་མེད་པར་ཞེས་གསུངས་སོ།",
    "འོན་ཀྱང་སྡུག་པ་ལ་སོགས་པར་འཛིན་པ་ཡིན་ནོ་སྙམ་དུ་དོགས་པ་བསུ་བ་ནི།",
    "རྒྱུ་ནི་ཞེས་གསུངས་ཏེ།",
    "གཟུགས་ལ་སོགས་པ་ཡང་ཁུ་བ་བཞིན་དུ་ནུས་པར་བརྗོད་པ་ནི་ཁྱད་པར་ཅན་གཟུགས་ཞེས་བྱ་བའོ།",
    "སྐྱོན་མེད་དོ་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་ལ་འདོད་ཆགས་དྲག་པར་འགྱུར་རོ་ཞེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པའི་རང་བཞིན་ནོ།",
    "འོ་ན་སྤྱོད་ཚུལ་རྒྱུ་ཡིན་པར་འགྱུར་རོ་སྙམ་ན།",
    "སྤྱོད་ཚུལ་དང་ནི་ཞེས་གསུངས་སོ།",
    "འོ་ན་གཉི་ག་རྒྱུ་ཡིན་པར་འགྱུར་རོ་སྙམ་ན་ལ་ལར་ཞེས་གསུངས་སོ།",
    "ཀུན་ལ་ཞེས་གསུངས་སོ།",
    "གཟུགས་ལ་སོགས་པ་ཇི་ལྟར་ཡོད་པ་རྒྱུ་ཉིད་ཡིན་པར་བཀག་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ངེས་པ་མེད་པ་ཞེས་བྱ་བ་ནི་གང་རུང་ཞིག་མེད་པར་ཡང་མི་ལྡོག་པའོ།",
    "འདི་ཉིད་ལ་ཡང་བཀོད་པ་གཞན་གསུངས་པ་ནི་ཡང་ན་ཞེས་བྱ་བའོ།",
    "འདིར་ནི་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་ལ་སོགས་པ་ལ་མ་ངེས་པར་རོ།",
    "གོམས་པས་གྲུབ་པ་མེད་ཅེ་ན་ཞེས་བྱ་བ་ལ་སོགས་པས་བཀག་ཟིན་ཀྱང་ལོག་པར་རྟོག་པ་སྲིད་པས་ཡང་འགོག་པ་ཡིན་ནོ།",
    "འདིས་ནི་ཞེས་བྱ་བ་གཏན་ཚིགས་ཀྱི་ཚིག་རྣམ་པར་འགྲེལ་པ་ནི།",
    "ཐམས་ཅད་དུ་ཞེས་གསུངས་སོ།",
    "ཇི་ལྟར་གནོད་པར་འགྱུར་སྙམ་ན།",
    "ཐ་དད་པ་མ་ཡིན་པར་ཁས་ལེན་པ་ལ་ཡང་སྐྱོན་བརྗོད་པ་ནི།",
    "ལྟོས་པར་བྱ་བ་ལ་ལྟོས་པ་ཡིན་ལ།",
    "ལྟོས་པར་བྱ་བའི་སྔར་ཡོད་པར་ཡང་དེ་ཉིད་ཡིན་ནོ།",
    "འབྱེད་མེད་པར་གནས་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི།",
    "གཞན་དུ་འཐད་མ་ཡིན་ཞེས་གསུངས་སོ།",
    "དུས་མཚུངས་པ་དག་ལ་ཞེས་གསུངས་སོ།",
    "དེས་ནི་ཞེས་བྱ་བ་ཕན་འདོགས་པ་དང་ཕན་གདགས་པར་བྱ་བ་དག་མེད་པ་ནའོ།",
    "དབྱེར་མེད་པར་འཇུག་པའི་ཕྱིར་རྟེན་ཡིན་ནོ་ཞེས་འབྲེལ་ཏོ།",
    "ཕན་ཚུན་འཁྲུལ་པ་མེད་པ་ནི་དབྱེར་མེད་པར་འཇུག་པ་ཡིན་ནོ་ཞེས་འཆད་པ་ནི་འདི་ལྟར་ཞེས་བྱ་བའོ།",
    "ཡང་ཇི་ལྟར་ན་རྟེན་ནི་རྣམ་པར་དབྱེར་མེད་པར་གནས་པ་ཙམ་ཡིན་སྙམ་པའི་དོགས་པ་སེལ་བས་གཞན་དུ་འཐད་མ་ཡིན་ཞེས་བྱ་བ་འཆད་པ་ནི་གལ་ཏེ་དེ་དག་ཅེས་བྱ་བའོ།",
    "དེས་ན་ཅི་ལྟར་དེ་ལ་གཟུགས་ལ་སོགས་པ་རྣམས་རྣམ་པར་དབྱེར་མེད་པར་གནས་པར་བརྗོད་སྙམ་དུ་དོགས་པ་བསུ་ནས་གཟུགས་ལ་སོགས་པ་ལས་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ཞེ་སྡང་ལ་སོགས་པའི་ཡང་མ་ཡིན་ནོ་ཞེས་རྟོགས་པར་བྱ་བའོ།",
    "འདོད་ཆགས་དབྱེར་མེད་པར་གནས་པ་ཉིད་ཀྱིས་ནི་ལུས་ཀྱི་རྟེན་ཉིད་ལ་ཁྱབ་པ་མ་ཡིན་ཏེ།",
    "རྣམ་པར་དབྱེར་མེད་ཀྱང་ཆང་དང་ནུས་པ་དག་ལ་རྟེན་ལ་སོགས་ཡོད་པའི་ཕྱིར་རོ་ཞེས་སྨྲས་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "དེས་ན་རྣམ་པར་དབྱེ་བ་མེད་པ་ཉིད་ཀྱིས་རྟེན་ལ་མ་ཁྱབ་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "ཐ་དད་པ་ཡིན་ན་ཡང་བརྟེན་པ་ཉེ་བར་བསྒྲུབ་པའི་རང་བཞིན་བརྟེན་པ་ཞིག་ན་འཇིག་པར་འགྱུར་གྱི་གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "ཐ་དད་པ་ལ་ཡང་རྟེན་དང་བརྟེན་པའི་དངོས་པོ་ཡོད་པ་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་ནི།",
    "རྟེན་དང་བརྟེན་པའི་དངོས་པོ་རྣམ་པར་དབྱེ་བ་མེད་པ་ཉིད་ཀྱིས་མ་ཁྱབ་པར་བརྗོད་པ་ཡིན་ནོ།",
