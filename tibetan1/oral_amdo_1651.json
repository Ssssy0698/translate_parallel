    "དེར་མ་ཟད་མོ་ནི་ཨ་ལིའི་ཕ་རྒྱུད་གཅུང་མོ་ཞིག་ཀྱང་ཡིན་རབས།",
    "ཨ་ལི་དང་ཧྲ་ན་བྷ་གཉིས་ལ་འདྲ་མཚུངས་ཀྱི་ཆ་གང་ཡང་ཡོད་པ་མ་རེད།",
    "སྐྱེས་མ་ཉིད་ནས་ངོ་ཕྱེད་ཞ་རེངས་སུ་སོང་ཡོད་པས་འཛུམ་མདངས་ཙམ་ཡང་ཕྱུང་ཐབས་མེད་པར་དུས་རྒྱུན་གདོང་པ་ནག་རོག་གེར་ཡོད།",
    "དེར་བརྟེན་རྡོ་བའི་ངོ་གདོང་ཅན་གྱི་ཨ་ལིའི་དགའ་སྡུག་བརྟག་རྒྱུ་དེ་ནི་ལས་སླ་མོ་ཞིག་མིན།",
    "མིག་གི་མདངས་ལས་སེམས་ཀྱི་གཏིང་མཐོང་ཟེར་བ་དེ་ཨ་ལིའི་སྟེང་ལ་བཀོད་ན་ཤིན་ཏུ་འཕྲོད།",
    "སེམས་ཀྱི་རྟ་རྒོད་མོའི་རི་ལ་ཤོར་ཏེ་འཛིན་ཐབས་མེད་ཟེར།",
    "ངས་རྒྱབ་ལོགས་ནས་སྣ་དགོད་རྒྱག་གིན་ཁོའི་གོམ་པ་གཏོང་སྟངས་ལ་ལད་ཟློས་བྱེད་ཀྱིན་སོང་།",
    "རིད་ཅིང་སྐེམ་པའི་གཡས་རྐང་ཡར་འདེག་གིན་ཁོས་ས་ངོས་སུ་ཟླུམ་གོར་ཕྱེད་ཀ་རེ་དཔར་གྱིན་འདར་ལྷེམ་ལྷེམ་སྔོན་དུ་སྐྱོད།",
    "རྐང་པ་སྐྱོན་ཅན་དེ་ས་ངོས་སུ་འཁེལ་ཐེངས་རེར།",
    "དེར་ངས་གད་མོ་ཐག་ཐག་བརྒྱབ།",
    "འོན་ཀྱང་ཏག་ཏག་ཁོར་སྡུག་པོ་གཏོང་མཁན་ནི་ལོ་ན་ཆེ་ཙམ་གྱི་གཞོན་ནུ་དེ་དག་རེད།",
    "དེ་ནི་ཆེད་མངགས་བྱིས་པ་བཟའ་རྒྱུར་དགའ་བའི་གདོན་འདྲེ་ཞིག་གི་མིང་རེད།",
    "དེ་རིང་ཁྱོད་ཀྱིས་སུ་ཚང་གི་བྱིས་པ་ཟོས་སོང་།",
    "ཁྱོད་ཀྱིས་སུ་ཚང་གི་བྱིས་པ་ཟོས་སོང་།",
    "ངས་ཧ་ཙ་ར་ནི་སོག་པོའི་མི་རྒྱུད་ཅིག་ཡིན་ཞིང་རྒྱ་ནག་པ་དང་ཡང་འདྲ་སེ་བ་ཞིག་རེད་སྙམ་མྱོང་བ་ཙམ་ལས་དེ་ལ་རྒྱུས་ལོན་བྱས་པ་ཧ་ཅང་ཉུང་།",
    "རྩོམ་པ་པོ་དབྱི་ལང་གི་རེད།",
    "ངས་དེའི་སྒང་གི་ས་རྡུལ་གཏགས་རྗེས་དགོང་མོ་དེར་ལྐོག་ནས་མལ་ཁྲིའི་སྟེང་ཁྱེར།",
    "ཧ་ཙ་ར་པས་ཕུ་ཧྲི་ཐོ་པ་ལ་ཕྱིར་རྒོལ་བྱ་རྩིས་བྱས་མོད།",
    "ངའི་རིགས་རྒྱུད་ཕུ་ཧྲི་ཐོས་དེ་ཚོའི་གཞིས་ཁྱིམ་མེ་རུ་སྦར་ཞིང་བུད་མེད་བཙན་འཚོང་བྱས་པ་རེད་ཅེས་བཀོད་འདུག་དེབ་དེའི་འདོད་ཚུལ་ལྟར་ན།",
    "ཨ་ཕས་ཀྱང་ནམ་རྒྱུན་ལྐུགས་པའི་བརྟུལ་ཞུགས་འཛིན།",
    "ངས་སྔོན་ཆད་ཁྱིམ་མཚེས་ཀྱི་བྱིས་པ་ཚོས་འདི་འདྲའི་ཐ་སྙད་སྤྱད་དེ་ཧཱ་སན་ལ་དམའ་འབེབས་དང་བཅས་སྡིགས་མོ་བརྒྱབ་པ་ཐོས་མྱོང་།",
    "ཧྲི་ཡའེ་ཞེས་པའི་ཐ་སྙད་འདི་གླེང་དུས་ཁོས་ད་དུང་སྣ་སྙེར་ཞིག་བརྒྱབ་སོང་།",
    "ནམ་རྒྱུན་མོས་ཁྲེལ་དགོད་རྒྱག་གིན།",
    "ཡང་ཨ་ལི་མི་དྲང་མོ་ཞིག་ཡིན་པ་མ་གཏོགས།",
    "ངས་བལྟས་ན་དེ་ནི་ཁོའི་ཚུགས་ཀ་འཁྱོར་ཚར་བའི་རྐང་པ་སྐྱོན་ཅན་དེ་དང་འབྲེལ་བ་ཡོད།",
    "ཁོས་བྱ་འཕུར་བ་ལྟར་བྲོས་འགྲོ་བའི་པྲ་ཆལ་དེ་དག་གི་རྗེས་ག་ལ་ཆོད།",
    "དམའ་འབེབས་དེ་དག་གིས་ཁོའི་ལུས་སྟེང་ལ་ནུས་པ་གང་ཡང་མི་ཐོན།",
    "ཨ་ལི་དང་བཙའ་རོགས་རྒན་མོ་གཉིས་འཁྲིས་སུ་བསྡད་དེ་རོགས་རམ་བྱེད་པའི་ཚུགས་ཀ་བཏོད་པ་རེད།",
    "དོན་ལ་མོར་དེ་ཙམ་གྱི་རོགས་རམ་ཡང་མི་དགོས།",
    "གདོང་ལ་འཛུམ་ཆུང་འདྲ་ཞིག་བཟུང་སྟེ་གཞི་ནས་ངུ་རྒྱངས་བྱས་སོང་།",
    "ཧྲ་ན་བྷས་ཨ་ལིའི་པང་གི་བྱིས་པ་དམར་འབྱར་དེ་ཁ་ཤོ་ཞིག་ཡིན་པ་མཐོང་འཕྲལ།",
    "ད་ལྟ་ཁྱོད་ལ་བུ་གླེན་པ་ཞིག་སྐྱེས་པ་རེད།",
    "ཧོ་ཧོ་ཡ་ཞེས་སྐྱི་གཡའ་བའི་ཧབ་ཆ་གཅིག་བརྒྱབ་སོང་ཟེར།",
    "བྲང་ནུ་མ་བླུད་དེ་གསོ་རྒྱུ་ཕར་ཞོག་མོས་རང་ལ་བཙས་པའི་ཕྲུ་གུ་དེ་པང་དུ་ལེན་འདོད་ཙམ་ཡང་མེད་པར།",
    "ཉིན་ལྔ་པར་ཏན་ཏན་ཡུལ་སྐོར་གླུ་བྲོ་མཁན་འགའ་དང་འགྲོགས་ནས་བྲོས་སོང་བ་རེད།",
    "བྷ་རྨེ་དབྱང་ན་སྟོན་པ་ཤཱཀྱ་ཐུབ་པའི་འདྲ་འབག་ཆེན་པོ་ཡོད་པ་རེད་ཟེར།",
    "མོའི་གཞས་སྐད་ནི་རྣ་བའི་བདུད་རྩི་དང་འདྲ་ཟེར།",
    "སྟོད་རི་ཆེན་རི་ཡི་རྩེ་མོ་ནས།",
    "བྲང་ནུ་མ་གཅིག་གི་འོ་མས་གསོས་པའི་སྐྱེ་བོ་ནི་བུ་སྤུན་ཡིན་པ་རེད།",
    "ངེད་གཉིས་ཀྱིས་སྒོ་ར་གཅིག་གི་སྤང་ངོགས་ནས་གོམ་ཁ་དང་པོ་སྤོས་ཤིང་།",
    "དེར་ངས་ཨ་ཕ་ཞེས་བོས།",
    "ངའི་ཨ་ཕས་སྔོན་ཆད་པེ་ལོ་ཀྲི་ནས་མཚོན་རྒྱ་ཁབ་ཙམ་མེད་པར་དོམ་དང་འཛིང་རེས་བྱས་མྱོང་ཟེར།",
    "གལ་སྲིད་འདི་ནི་གཞན་ཞིག་གི་གཏམ་རྒྱུད་ཡིན་ཚེ་མཐའ་མཇུག་དགོད་གཏམ་ཙམ་དུ་འགྲོ་སྲིད།",
    "ཨ་ཕ་དང་འབྲེལ་བའི་གཏམ་རྒྱུད་ཅིག་ཡིན་ཕྱིན་སུས་ཀྱང་ཡིད་གཉིས་མི་བྱེད།",
    "བརྒྱ་ལ་སུ་ཞིག་གིས་ཐེ་ཚོམ་བྱེད་ན།",
    "ཨ་ཕས་དོམ་དང་འཛིང་རེས་བྱས་པའི་རྣམ་པ་དེ་ངས་སེམས་ནང་ནས་རྟོག་བཟོ་བྱས་མྱོང་།",
    "ཐ་ན་དེ་དགོང་མོར་རྨི་ལམ་དུ་ཡང་འཁོར་མྱོང་།",
    "ཨ་ཕའི་གནག་འོད་ཁྱུག་ཁྱུག་གི་མིག་འབྲས་དེ་གཉིས་ནི་བགྲད་པ་ཙམ་གྱིས་ཀྱང་།",
    "ཨ་ཕའི་སྡུར་སྒྲ་ནི་འབར་གྱིན་པའི་རླངས་འཁོར་གྱི་གློག་མ་ཇི་བཞིན་ལྡིར་སྒྲ་དང་བཅས་ངའི་རྣ་ནང་དུ་གསལ་ལྷང་ལྷང་འཁོར་ཡོང་།",
    "ཁྱོད་ཀྱིས་ངེད་གཉིས་ཀྱི་ཁང་པའི་བར་ན་མགྲོན་བསུ་ཚོམས་ཁང་ཡོད་པ་མ་བརྗེད།",
    "གལ་སྲིད་ཨ་མ་འཚོ་ཞིང་གཞེས་ཚེ།",
    "ངས་མོར་ད་དུང་འདི་འདྲའི་དྲི་བ་གང་མང་དྲིས་ན་འདོད།",
