    "རང་ལས་དག་གིས་འགྲོ་བ་ན།",
    "སྲིད་པར་ཁྱོད་ལ་རང་འདོད་ཀྱིས།",
    "ལས་དང་ཉོན་མོངས་པ་ལ་རག་ལས་ཏེ་འགྲོ་ཞིང་གཤེད་དུ་འགྲོའོ་སྙམ་སྟེ་འགྲོ་བའི་ཁྱད་པར་ངེས་པར་མ་ཟིན་པ་འདིས་ནི་ཉིན་མཚན་ཕྱེད་པར་སྐྱོ་བར་བྱ་བར་རིགས་སོ།",
    "རང་གི་ལས་ལ་རག་ལས་ཏེ་འགྲོ་བའི་ཕྱིར་རོ།",
    "ཁྱོད་འདས་ཇི་ལྟར་དེ་བཞིན་དུ།",
    "མ་འོངས་པའི་དུས་ལ་མཐའ་མེད་ལ་འདས་པ་ཡང་དེ་བཞིན་དུ་ཡིན་ཞིང་ཁྱོད་ཀྱང་འདས་པའི་དུས་ཐམས་ཅད་དུ་སོ་སོའི་སྐྱེ་བོ་ཞིག་སྟེ།",
    "ཁྱོད་ཀྱིས་འདས་པའི་དུས་ཇི་ལྟར་དོན་མེད་པར་གྱུར་པ་དེ་བཞིན་དུ་མ་འོངས་པ་ཡང་མི་འགྱུར་བ་དེ་ལྟར་གྱིས་ཤིག།",
    "ཉོན་མོངས་པ་ཉེ་བར་ཞི་བར་མ་མྱོང་བཞིན་དུ་ཁྱོད་ཀྱིས་འདས་པའི་དུས་སོང་སྟེ།",
    "ཁྱོད་ཀྱི་འདོད་རྒྱུས་དོན་མེད་ཆུད་གསན་པའི།",
    "ཁྱོད་ཀྱི་འདོད་རྒྱུས་དོན་མེད་ཆུད་གསན་པའི།",
    "གཞན་གྱི་བུད་མེད་ལ་འཕྱན་པ་འགའ་ཞིག་ལ་མཛའ་བོ་དེ་ལྟར་མ་བྱེད་ཅིག་ཅེས་རྗེས་སུ་བསྟན་པ་དང་ཕྱིན་ཆད་དེ་ལྟར་མི་བྱེད་དོ་ཞེས་སྨྲས་ལ།",
    "སྔོན་ཡང་ཁྱོད་ཀྱིས་ཕྱིན་ཆད་མི་བྱེད་དོ་ཞེས་སྨྲས་མོད་ཀྱི་བྱས་པ་ཡང་ཡིན་པས་མ་འོངས་པའི་དུས་སུ་དེ་ལྟར་མི་བྱའོ་ཞེས་སྨྲས་སོ།",
    "དེ་དག་ཁྱོད་ཀྱིས་མཉེས་པར་མ་བྱས་ཏེ།",
    "དེའི་ཕྱིར་ད་ལྟར་རྐྱེན་ལ་རག་ལས་པ་ཉིད་ཀྱི་ཕྱིར་ཇི་སྲིད་དུ་མཐའ་དང་མཐའ་མེད་པ་དག་གི་རྐྱེན་ཚོགས་པ་འདི་ལ་མ་ཚང་བ་མེད་པ་དེ་སྲིད་དུ་མཁས་པས་སྲིད་པ་ཡོངས་སུ་ཟད་པ་ལ་མངོན་བར་བརྩོན་པར་ག་ས་རིགས་སོ།",
    "གང་གི་ཕྱིར།",
    "ཕལ་མོ་ཆེ་ན་མི་རྣམས་ནི།",
    "སྐྱེས་བུ་དམ་པ་མ་ཡིན་པ་དང་ཕྲད་པས་སྲོག་ཆགས་གསོད་པ་ལ་སོགས་པ་མི་དགེ་འངག་བ་བཅུའི་ལས་ཀྱི་ལམ་བར་མཚམས་མེད་པའི་ཕྱིར་མི་འདི་དག་ནི་ཕལ་ཆེར་ངན་སོང་དུ་འགྲོ་བར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་སྐྱེས་བུ་གཉིས་ཤ་ནའི་ཤིང་གི་ཕྱིར་སོན་པར་གྱུར་ལ།",
    "དེ་ནས་གཅིག་གིས་ཤ་ནའི་ཁུར་བོར་ནས་རས་བལ་གྱི་ཁུར་བཟུང་བ་ན།",
    "དེ་བཞིན་དུ་ཇི་སྲིད་ཅིག་གསེར་གྱི་ཁུར་ཁུར་ནས་འོངས་ཤིང་གཉིས་པ་ནི་ཁོ་བོས་འདི་ཡུན་རིང་མོ་ཞིག་ཏུ་ཁུར་ཁུར་ནས་ཇི་ལྟར་འདི་བསྒྱུར་བར་བྱ་སྙམ་སྟེ།",
    "ངན་སོང་ནི་མི་ཁོམ་པ་ཉིད་ཀྱི་ཕྱིར་དང་སྡུག་བསྔལ་རྣམ་པ་སྣ་ཚོགས་པ་ཡོད་པའི་ཕྱིར་མངོན་བར་དགའ་བའི་གནས་མ་ཡིན་མོད་ཀྱི།",
    "ངན་སོང་ལྟར་བདེ་འགྲོ་ལ་ཡང་སྐྱོ་བར་རིགས་ཏེ།",
    "ཇི་ལྟར་རྒྱལ་པོ་འགའ་ཞིག་གིས་བློན་པོ་ཞིག་རི་མོར་བྱ་བ་དམ་པས་རི་མོར་བྱས་ལ།",
    "གླང་པོ་ཆེ་སྨོན་བ་ཆང་གིས་སྨྱོས་པ་ལྟར་སྨྱོན་པའི་རང་བཞིན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱལ་པོ་དེ་གང་གི་ཚེ་དེ་མ་མཐོང་བ་དེའི་ཚེ་བུའི་སྲེད་པས་ཤིན་ཏུ་གཟིར་བར་འགྱུར་ཞིང་།",
    "ཁྱོད་མཐོང་ནས་མེས་ཚིག་པ་ཙུག་བྱེད་དོ་ཞེས་སྨྲའོ།",
    "དེས་པུས་མོ་གཉི་ག་ས་ལ་བཙུགས་ནས་ཐལ་མོ་སྦྱར་ཏེ་ངུ་ཞིང་འདར་བཞིན་དུ་རྒྱལ་པོ་ལ་དངོས་ཀྱི་ཅི་ནོངས་ཞེས་སྐད་ལྡིབ་ལྡིབ་པོ་དང་བཅས་པས་ཞུས་པ་དང་།",
    "རྒྱལ་པོ་དེས་ཁྱོད་ཀྱིས་ཅི་ཡང་མ་ཉེས་མོད་ཀྱི།",
    "ཁྱོད་མཐོང་བར་མི་འདོད་དོ་ཞེས་སྨྲས་སོ།",
    "སྨྱོ་བའི་གནས་ཉིད་ཡིན་པའི་ཕྱིར་མཁས་པ་དག་གིས་སྲིད་པ་ཡོངས་སུ་སྤང་བར་བྱས་ལ།",
    "ཉོན་མོངས་ཟད་པའི་བདེ་ལས་ཀྱང་།",
    "གང་ཚེ་འབྲས་བུ་གཅིག་གི་ཡང་།",
    "དཔེར་ན་བུམ་པ་ལ་རྐྱེན་དག་དུ་མ་ལྟ་བུ་སྟེ་རེ་ཞིག་བུམ་པ་བྱ་བ་ལ་འཇིམ་པའི་གོང་བུ་དང་དབྱུ་གུ་དང་འཁོར་ལོ་དང་སྲད་བུ་དང་ཆུ་དང་སྐྱེས་བུའི་རྩོལ་བ་ལ་སོགས་པ་དག་སྣང་ན།",
    "དེ་ལྟར་གྱུར་ཀྱང་ཁྱོད་ལ་ཀོ།",
    "འདི་ན་འབད་པ་ཆེན་པོས་སྒྲུབ་པའི་ཐབས་མང་པོ་དག་གིས་བྱེད་ལ།",
    "དེ་ཡང་འབད་པ་ཆེན་པོ་དང་སྒྲུབ་པར་བྱེད་པ་མང་པོ་དག་གིས་བྱས་བཞིན་དུ་འབྲས་བུ་ལྟར་འབད་པ་མེད་པ་ཁོ་ནར་འཇིག་གོ།",
    "ཁྱོད་ནི་སླར་ཡང་ལས་དེ་དག་བྱེད་པའི་ཕྱིར་ན་འདོད་ཆགས་དང་བྲལ་བ་མེད་པས་བླུན་པ་ཉིད་དུ་སྟོན་པར་བྱེད་དོ།",
    "གང་གི་ཕྱིར་ན་རྒྱུ་དང་རྐྱེན།",
    "གལ་ཏེ་ཡང་འབད་པ་མེད་པར་ལས་འཇིག་མོད་ཀྱི།",
    "ཁྱོད་ཀྱི་ངལ་འདི་གང་ཕྱིར་ཡིན།",
    "རེ་ཞིག་རྣམ་པར་ཤེས་པ་འདས་པ་ལ་ནི་བདེ་བ་ཡོད་པ་ནི་མ་ཡིན་ཏེ་འགགས་ཟིན་པའི་ཕྱིར་རོ།",
    "བདེ་བ་ལོངས་སྤྱོད་པ་ལ་བརྐམ་པ་ཡོད་ཀྱི་བདེ་བའི་རྒྱུ་སོག་པའི་དུབ་པ་གང་ཡིན་པ་དེ་གང་གི་ཆེད་དུ་ཡིན་པ་ཞིག་སྟེ།",
    "ཀླུང་གི་ངོགས་སུ་ཁང་པ་བརྩིགས་པ་བཞིན་ནོ།",
    "འགའ་ཞིག་གིས་ཆུ་ཀླུང་གི་འགྲམ་དུ་ཁང་པ་བརྩིགས་པ་དང་ས་ཕྱོགས་དེ་རྡིབ་པར་གྱུར་ཏོ།",
    "གང་གི་ཕྱིར་ན་དུས་གསུམ་དུའང་།",
    "ལས་རྣམས་གང་གི་དོན་དུ་སོག།",
    "དེ་ལྟ་ཡིན་མོད་ཀྱི།",
    "དེ་ལ་ཀུན་ནས་ཉོན་མོངས་པ་རྣམ་པ་སྣ་ཚོགས་སྐྱེ་བའི་སྒོར་གྱུར་པ་ཉིད་ཀྱི་ཕྱིར་དང་།",
    "གང་དག་ལ་མཐོ་རིས་ཕུན་སུམ་ཚོགས་པ་སྨད་དུ་མེད་པའི་བདེ་བ་ལ་ལོངས་སྤྱོད་པས་དགའ་བར་འོས་པ་རྣམས་ཀྱིས་རེས་འཇོག་སྐྱེད་པར་མི་བྱེད་པ་དེ་དག་ལ་དེ་ལས་གཞན་པའི་སྲིད་པ་དུར་ཁྲོད་ཀྱི་ས་གཞི་ལྟ་བུ་ལ་དགའ་བར་ག་ལ་འགྱུར།",
    "ཀྱང་གི་སྒྲ་ནི་འདིར་རིམ་པ་གཞན་དུ་སྦྱར་ཏེ།",
    "རེ་ཞིག་སྲིད་པ་གཞན་ལྟ་ཞོག་ཤིག།",
    "དེ་གང་གི་ཚེ་འགའ་ཞིག་འགྲོལ་བར་བྱེད་པ་དེའི་ཚེ་སྐྱེས་བུ་སྲུང་མ་རྣམས་ལ་འདི་འཆིང་བ་ཐམས་ཅད་ལས་གྲོལ་བར་བྱ་འོན་ཀྱང་སྤྱོད་ལམ་གཅིག་པོ་གང་ཞིག་གིས་ཚེའི་མཐར་གནས་པར་འདོད་པ་དེ་མོད་ཀྱི།",
    "བདེ་བ་མྱོང་བར་བྱ་བའི་ཡུལ་མ་ཐོབ་པར་ཉེ་བར་སོང་བའི་ཕྱིར་དང་།",
    "རྒྱུ་ཅི་ཞིག་གིས་ཡང་དག་འདོད།",
    "གང་ཡུལ་དག་ལ་རེ་བ་མེད་པ་ནི་ཚངས་པར་སྤྱོད་པ་ཁས་བླངས་པ་ལས་དེ་དག་ཡོངས་སུ་འདོར་ལ་དེ་འདི་ནས་ཤི་འཕོས་ཤིང་།",
    "དམ་པ་རྣམས་མི་བཞེད་པ་གང་ཞིག་གིས་ཁས་བླངས་པ་སྟེ།",
    "ཇི་ལྟར་ལུག་ནི་བརྡུང་བར་འདོད་པ་ན་རིངས་པོར་སོང་བ་ཡང་ལོག་པ་མ་ཡིན་པ་དེ་བཞིན་དུ་ཡུལ་ལོག་ཅིང་ཡུལ་དོན་དུ་གཉེར་བ་ཡང་ཡིན་ནོ།",
    "སྡུག་བསྔལ་རྣམ་པ་སྣ་ཚོགས་ཀྱི་གནས་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་ན་མཁས་པས་རེ་བ་གཞག་པར་མི་བྱ་སྟེ།",
    "དེ་ནི་ཇི་ལྟར་བདག་གིར་འགྱུར།",
    "དེ་ཡང་བདག་གི་བར་འདུ་ཤེས་བྱས་པ་ཞིག་ཡིན་ལ།",
    "གལ་ཏེ་དེ་བདག་གི་བ་ཡིན་ན་ནི་མི་བདག་ང་རྒྱལ་ཅན་དང་།",
    "གང་ཞིག་གཞན་དག་གིས་གཅད་པར་བྱ་བའི་ཕྱིར་རྟག་པར་བསྲུང་བའི་ཚུལ་བྱ་དགོས་པ་དེ་ཅི་ལྟར་བདག་གི་བ་ཡིན་པར་བརྗོད་པར་ནུས།",
    "གང་ཞིག་རྟག་ཏུ་བསྲུང་བར་བྱ་བ་ཡིན་པ་དེ་ནི་བདག་གི་བ་མ་ཡིན་ནོ།",
    "བུ་མོ་བག་མར་ལེན་པ་བཞིན་ནོ།",
    "སྐྱེས་བུ་ཡུལ་ཡ་བོ་ནར་ཕྱིན་པ་འགའ་ཞིག་གིས་ཡུལ་ཡ་བ་ན་པ་འགའ་ཞིག་མེ་སྦར་ནས་རིག་སྔགས་ཀྱི་མེ་དེ་ལས་ཁྱོད་ལ་བུ་མོ་ཆུང་མར་རུང་ངོ་ཞེས་བྱ་བའི་སྒྲ་འབྱིན་པར་བྱེད་པ་མཐོང་ངོ།",
    "དེའི་བུ་མོ་གཟུགས་དང་ལང་ཚོ་དང་ལྡན་པ་ཞིག་ཀྱང་རང་གི་ཡུལ་ན་གནས་སོ།",
    "རང་གི་ཡུལ་དུ་འོངས་ཏེ་རང་གི་བུ་མོ་ཆུང་མར་བྱ་བར་འདོད་ནས་དོན་དེ་སྨྲ་བར་བྱ་བའི་ཕྱིར་མེ་ལ་དྲིས་པ་དང་མེ་དེས་ཚུལ་ལུགས་རྣམ་པ་གཞན་དུ་ཡིན་ནོ་སྨྲ་སྟེ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ཉོན་མོངས་པ་སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱིས་བག་མེད་པའི་གནས་ཉིད་ཀྱི་ཕྱིར་ཡོངས་སུ་བཏང་བ་མཆོག་ཏུ་བཀྲབས་པར་འགྱུར་བ་དེ་ནི་གྲུབ་པས་ཀྱང་དགོས་པ་ཅི་ཞིག་ཡོད།",
    "དགེ་སློང་འགའ་ཞིག་ཀམ་པོ་ཙེར་ཡུལ་མི་དག་ལ་སློང་དུ་སོང་བ་དང་།",
    "དེ་ནས་དེས་དགེ་སློང་དེ་ལ་ད་ནི་སྐྱེས་བུ་དེ་དག་གི་དོན་དུ་ཚིག་སྨོས་ཤིག་ཅེས་པ་དང་།",
    "དེས་ཀྱང་དེ་ལྟར་བྱས་ཏེ་ཨ་རོག་གྱ་ལ་སོགས་པའི་ཚིག་ཕྱུང་ངོ།",
    "དེ་ནས་དེ་དག་ཡ་མཚན་དུ་གྱུར་ཏེ་འདི་ནི་བདག་གིས་མི་ནུས་ཀྱི་གསལ་བར་བདག་ཅག་དེས་ཕམ་པར་བྱས་སོ་ཞེས་སྨྲའོ།",
    "གཡོ་སྒྱུ་ཅན་དེ་ཡང་རང་གི་ངོ་བོ་ཡོངས་སུ་ཤེས་པ་ལས་ངན་པར་བརྩི་བར་འགྱུར་ཏེ།",
    "གང་ཞིག་གིས་འདོད་པའི་དོན་རྣམ་པ་གཞན་དུ་གྲུབ་པ་མི་སྲིད་པ་དེས་ནི་གཞན་གྱི་དེ་སྒྲུབ་ཏུ་གཞུག་པའི་ཕྱིར་བཀའ་ལུང་སྩོལ་བའི་ངལ་བ་འཐོབ་པར་འགྱུར་གྱི།",
    "དེ་ཡང་བུ་དེ་དང་ལྷན་ཅིག་ཡུལ་གཞན་དུ་སོང་བར་འགྱུར་ཞིང་དེ་གཞན་དག་གི་གམ་དུ་བདག་ཉིད་དོང་བར་བྱའོ་ཞེས་ངུ་བར་བརྩམས་སོ།",
    "གཞན་དག་གིས་དེ་ལ་ཅིའི་ཕྱིར་དུ་ཞེས་དྲིས་པ་དང་།",
    "དེས་ཉི་མ་དྲུག་ན་བདག་གི་བུ་འདི་འཆི་བའི་དུས་བྱེད་པར་འགྱུར་རོ་ཞེས་སྨྲ་སྟེ།",
    "རང་ཀ་ཊ་ཞེས་བྱ་བ་མཆོག་ཏུ་དབུལ་ཞིང་ཕོངས་པ་སྤྲང་པ་འགའ་ཞིག་གིས་འགའ་ཞིག་དག་ལས་ཁ་འཕྲོ་ལེགས་པར་མ་སྦྱར་བ་ཞིག་རྙེད་དོ།",
    "དེ་དང་ཤིན་ཏུ་མི་རིང་བ་ཞིག་ན་རྒྱལ་བུ་ཞིག་ལྷ་མཉེས་པར་བྱ་བར་འདོད་པས་སྨྱུང་བར་རྣམ་པར་གནས་པ་དེ་ལ་དེས་རྒྱལ་བུ་འདིས་བདག་གི་སློང་མོ་ཕྲོགས་ཏེ་ཟོས་སོ་ཞེས་སྐུར་པ་བཏབ་སྟེ་རྒྱལ་བུ་དེ་ནི་སྨྱུང་བར་གནས་པ་ཉམས་པར་འགྱུར་དུ་འོང་ངོ་ཞེས་ཏེ།",
    "རང་གི་ཁ་ཟས་ཤིན་ཏུ་ལེགས་པར་སྦྱར་བ་ཡང་མི་ཟ་ན་དེ་ལྟ་ཟ་བར་ག་ལ་འགྱུར།",
    "གང་གིས་འགྲོ་བར་འཁྲུལ་འཁོར་གྱི།",
    "འཁྲུལ་འཁོར་གྱི་བུ་མོ་བཞིན་ནོ།",
    "རི་མོ་མཁན་འགའ་ཞིག་གིས་འཁྲུལ་འཁོར་གྱི་སློབ་དཔོན་ཞིག་གི་ཁྱིམ་དུ་གནས་བཅས་པར་གྱུར་ལ།",
    "དེས་དེར་བཞད་གད་ཀྱི་བསམ་པས་འཁྲུལ་འཁོར་གྱི་བུ་མོ་ཞིག་མངགས་སོ།",
    "དེས་བྲན་མོ་འདི་ནི་བདག་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་ཡོངས་སུ་ལོངས་སྤྱོད་པའི་ཕྱིར་བཏང་བ་ཞིག་གོ་སྙམ་དུ་བརྟགས་ཏེ་ལག་པ་ནས་བཟུང་ནས་དྲངས་པས་ཤིང་གི་ཐང་པོ་ཞིག་ཏུ་གྱུར་ཏེ།",
    "དེ་མཐོང་ནས་འཁྲུལ་འཁོར་གྱི་སློབ་དཔོན་ཨེ་མ་ཀྱི་ཧུད་བརྟེན་ངས་པ་ལས་འཁྲུལ་འཁོར་ལ་རེག་པའི་རི་མོ་མཁན་གྱིས་ངོ་ཚས་བདག་ཉིད་འགེགས་ཏེ་བསད་དོ་སྙམ་དུ་སེམས་པར་གྱུར་ཏོ།",
    "དེའི་ཕྱིར་དེ་ལྟར་ན་ཇི་ལྟར་འགལ་བའི་མི་རྣམས་ལ་མཛའ་བ་ཡུན་རིང་པོར་གནས་པ་ཡོད་པ་མ་ཡིན་པ་དེ་བཞིན་དུ་རྣལ་འབྱོར་པ་ལ་ཡང་ཕྱི་དང་ནང་གི་དངོས་པོ་རྣམས་ལ་སྐྱོན་དུ་མཐོང་བ་ཉིད་ཀྱི་ཕྱིར་ཇི་ལྟར་ཐམས་ཅད་དུ་འདོད་ཆགས་དང་བྲལ་བ་མི་སྲིད།",
    "དེ་ལ་འབྲེལ་ན་ཞེས་བྱ་བ་ནི་ཀུན་འབྱུང་གི་བདེན་པའོ།",
    "དེས་བྱུང་ཚུལ་དེ་ཁུ་བོ་དེ་ལ་གོ་བར་བྱས་པས་དེས་ཁྱོད་ཀྱིས་དོན་དུ་གཉེར་བས་མང་དུ་བཏང་ན།",
    "དེ་ནས་རེ་ཞིག་ན་རེངས་པ་དང་།",
    "ཆགས་པར་འགྱུར་བའི་དངོས་པོ་དེ་ཡང་རང་གི་ངོ་བོས་མ་གྲུབ་སྟེ།",
    "འདི་ལྟར་གཅིག་གི་ཆགས་པར་བྱ་བ་གང་ཡིན་པ་དེ་ཉིད་གཞན་གྱིས་སྡང་བར་བྱ་བ་དང་།",
    "གལ་ཏེ་རང་གི་ངོ་བོས་ཆགས་པར་བྱ་བའི་དངོས་པོར་གྱུར་ན་ནི།",
    "དེའི་ཡུལ་ལ་འདོད་པ་རང་གི་ངོ་བོས་མ་གྲུབ་པའི་ཕྱིར་སྟོང་པ་ཡིན་ཞིང་།",
    "མ་དང་ཆུན་མ་དང་བྲན་མོ་བཞིན་ནོ།",
    "དེ་ལ་མ་དེ་ནི་གང་གི་ཚེ་རང་གི་བུ་མཐོང་བ་དེའི་ཚེ་དགའ་བར་འགྱུར་ཞིང་ཆུན་མ་དེ་ནི་དེ་མཐོང་ནས་སྡུག་བསྔལ་བ་ཉིད་དུ་འགྱུར་ལ།",
    "བྲན་མོ་མཐོང་ན་བར་མར་གནས་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་ན་འདོད་ཆགས་ལ་སོགས་པ་རྣམས་ཀྱི་དམིགས་པ་ལ་རང་གི་ངོ་བོས་གྲུབ་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ཉོན་མོངས་པའི་ཀུན་ནས་ཉོན་མོངས་པའི་རྒྱུ་ནི་ཡུལ་རྣམས་ལ་ཚུལ་བཞིན་མ་ཡིན་པའི་རྟོག་པ་སྟེ།",
    "རྟོག་པ་མེད་པར་ཡོད་པ་ཉིད་མེད་པ་དེ་དག་ནི་གོར་མ་ཆག་པར་ཐག་པ་བསྡོགས་པ་ལ་བརྟགས་པའི་སྦྲུལ་ལྟར་རང་གི་ངོ་བྷ་བོས་མ་གྲུབ་པར་ངེས་སོ།",
    "གང་ཞིག་འདོད་ཆགས་ལ་སོགས་པ་རྣམས་ལ་རང་གི་ངོ་བོས་གྲུབ་པར་ཁས་ལེན་པ་དེ་ནི་ངེས་པར་རང་གི་ངོ་བོས་གྲུབ་པ་དང་འགལ་བར་རྟོག་པ་ལ་ལྟོས་ཏེ།",
    "དེ་ལྟར་ན་འཐད་པ་དང་བཅས་པའི་ལུང་གི་སྣང་བས་སེམས་ཀྱི་རྒྱུད་གསལ་བར་བྱས་པའི་ཕྱིར་མཁས་པ་རྣམས་རང་གི་ངོ་བོས་མ་གྲུབ་པ་ལ་རྟོག་པས་བསྐྱེད་པ་ཉིད་ཁས་ལེན་པར་མི་བྱེད་ཀྱི།",
    "བསམ་གཏན་པ་འགའ་ཞིག་བདག་གི་མགོ་ལ་ཐོད་པ་ཞིག་འཇར་རོ་སྙམ་དུ་སེམས་རྣམ་པར་འཁྲུལ་བར་གྱུར་པ་དང་།",
    "དེ་ལ་འགའ་ཞིག་གིས་འདི་ཁྱོད་ཀྱི་མགོ་ལས་ལྷུང་ངོ་ཞེས་ཐོད་པ་གཞན་ཞིག་བསྒྱུར་བས་དེ་དེ་ལྟར་རོ་སྙམ་དུ་རྟོགས་ནས་རྣལ་མར་གྱུར་ཏེ།",
    "འདི་ལྟར་བུད་མེད་ནི་སྐྱེས་པའི་ཡུལ་ཅན་གྱི་འདོད་ཆགས་ཀྱིས་སྐྱེས་པ་དང་ལྷན་ཅིག་བཅིངས་པས་སྐྱེས་པ་ལས་མི་འདའ་ལ།",
    "སྐྱེས་པ་ཡང་བུད་མེད་ཀྱི་ཡུལ་ཅན་གྱི་འདོད་ཆགས་ཀྱིས་བུད་མེད་དང་ལྷན་ཅིག་བཅིངས་པས་བུད་མེད་མི་གཏོང་བ་ཡིན་ནོ།",
    "དེ་ལྟར་འདོད་ཆགས་རྟོག་པ་ལ་ལྟོས་ཏེ་སྐྱེ་བ་ཉིད་ཀྱི་ཕྱིར་རང་བཞིན་གྱིས་མ་གྲུབ་པ་དེ་བཞིན་སྐྱེས་པ་དང་བུད་མེད་དག་ཀྱང་རང་གི་ངོ་བོས་མ་གྲུབ་པའི་ཕྱིར་ན་དོན་འགའ་ལ་ཡང་དོན་འགའ་ཞིག་དང་བཅིངས་པ་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་པས་བཅིངས་པའི་རྒྱུ་ཅན་ཡིན་པའི་ཕྱིར་འདོད་ཆགས་རང་གི་ངོ་བོས་གྲུབ་པ་མ་ཡིན་ནོ།",
    "དེའི་ཚེ་རང་གི་ངོ་བོ་ལ་གཞན་དུ་འགྱུར་བ་མེད་པའི་ཕྱིར།",
    "གྲོལ་བ་མེད་པ་ཁོ་ནར་འགྱུར་བ་ཞིག་ན་རྣམ་པར་གྲོལ་བ་ཡང་ཡོད་པས་འདོད་ཆགས་ལ་རང་གི་ངོ་བོས་འཆིང་བའི་རྒྱུ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་ལྟར་རྣམ་པར་དཔྱད་པས་ཉོན་མོངས་པ་རྣམས་ལྡོག་ན་ནི་ཅིའི་ཕྱིར་ཕལ་ཆེར་ཉོན་མོངས་པ་ཕམ་པར་མ་བྱས་པ་དག་ལྟར་སྣང་ཞེ་ན།",
    "ཐེ་ཚོམ་ཟ་བ་ཙམ་ཞིག་གིས།",
    "དེ་ནི་གལ་ཏེ་འདི་ལྟར་ཡིན་ནམ་སྙམ་དུ་དམིགས་པ་ན་དེའི་ཚེ་དེ་རིམ་གྱིས་ཉོན་མོངས་པའི་རྐུན་པོ་གཅོད་པའི་རྒྱུར་འགྱུར་རོ།",
    "དཔེར་ན་བཞོན་པ་ཆད་པའི་དེད་དཔོན་སྲིན་མོས་བཟུང་སྟེ་ཁྱིམ་ཐབ་ཉིད་དུ་བསྟེན་ཅིང་དེས་ཁྱོད་ཀྱིས་ནམ་ཡང་ལྷོ་ཕྱོགས་སུ་འགྲོ་བར་མི་བྱའོ་ཞེས་ལྷོ་ཕྱོགས་བཟློག་པ་དང་།་",
    "དེ་ཡང་རྟའི་རྒྱལ་པོ་འབའ་ལ་ཧ་ཀ་དང་ཕྲད་ནས་དེ་ནས་སྲིན་མོ་དེ་ལས་ཐར་ཅིང་རྒྱ་མཚོའི་ཕ་རོལ་དུ་ཕྱིན་ནོ།",
    "ཡང་ཇི་ལྟར་སྐྱེས་བུ་འགའ་ཞིག་གིས་རིག་སྔགས་གཉིས་གྲུབ་བོ།",
    "དེ་ནས་དེས་མཛའ་བོ་འགའ་ཞིག་ལ་ཁྱོད་རིག་སྔགས་གཉིས་པོ་འདི་ནོས་དང་།",
    "ཁྱོད་ལ་ཕན་པར་འགྱུར་གྱི་ཞེས་སྨྲས་པ་ལས་དེས་མ་མནོས་སོ།",
    "མཚན་མོ་དགེ་ཚུལ་བཏུང་བྱ་མ་ཡིན་པ་ལ་བསྔགས་པ་བཞིན་ནོ།",
    "ད་ནས་དེ་ལ་དེས་འདི་ནི་དགེ་སློང་རྣམས་ལ་རུང་བ་མ་ཡིན་ན་ཁྱོད་ཇི་ལྟར་འཐུང་ཞེས་བརྗོད་དོ།",
    "དགེ་ཚུལ་གྱིས་ཀྱང་གང་གི་ཚེ་ཁྱོད་ཆུ་ཉིད་དོ་སྙམ་དུ་བྱས་ནས་འཐུང་ན་དེའི་ཕྱིར་འདི་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད་ཅེས་སྨྲས་སོ།",
    "དོན་དམ་པར་རང་བཞིན་སྟོང་པ་ཉིད་ཁོང་དུ་ཆུད་པས་ཐམས་ཅད་དུ་མ་ཆགས་པ་དང་ལྡན་ཞིང་ཚོར་བ་དག་ལ་སྲེད་པ་མེད་པ་ལ་སྲེད་པའི་རྐྱེན་ཅན་ལེན་པ་ལ་སོགས་པ་རྒྱུ་འགགས་པ་དང་།",
    "གལ་ཏེ་དེ་ལྟར་དངོས་པོ་ཐམས་ཅད་སྟོང་པའི་ཕྱིར་དོན་དམ་པའི་བསྙད་པ་ལ་ཅི་ཡང་ཡོད་པ་མ་ཡིན་ན་ནི་དེའི་ཚེ་ཐམས་ཅད་དངོས་པོ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "ཁྱོད་ལ་འཇིགས་པ་སྐྱེ་འགྱུར་གྲང་།",
    "ཁྱོད་ལ་རང་ཕྱོགས་ཆགས་ཡོད་ཅིང་།",
    "གཞན་ཡང་དག་པ་མ་ཡིན་ནོ་སྙམ་༡༡༡ བརྩམདུ་རིག་ནས་གཞན་གྱི་ཕྱོགས་ལ་ཁྱོད་མི་དགའ་ན་ནི་དེའི་ཕྱིར་མྱ་ངན་ལས་འདས་པར་མི་འགྲོ་སྟེ་  རྗེས་སུ་ཆགས་པ་དང་ཁོང་ཁྲོ་བ་བཅོམ་ཞིང་གཉིས་ལས་སྤྱོད་པ་ལས་ནི་མྱ་ངན་ལས་འདས་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་དག་བདག་གི་ཉིད་གནས་མི་འགྱུར་ཞིང་།",
    "ཉེ་བར་འཚེ་བ་ཐམས་ཅད་དང་བྲལ་བའི་ཕྱིར་མྱ་ངན་ལས་འདས་པ་བདེ་བ་དམ་པ་ཡིན་མོད་ཀྱི།",
    "གང་གི་ཕྱིར་བྱ་བ་ཐམས་ཅད་ལ་བྱེད་པ་ལོག་ཅིང་བསམ་ཁྲལ་མེད་པས་མྱ་ངན་ལས་འདས་པ་ཐོབ་པ་དེའི་ཕྱིར་མྱ་ངན་ལས་འདས་པ་ཐོབ་པ་སླའི།",
    "གང་གི་ཚེ་ཁྱད་པར་ཅུད་ཟད་ཀྱང་མི་འདོད་པ་དེའི་ཚེ་ན་དེ་རྐྱེན་ཐམས་ཅད་དོན་དུ་མི་གཉེར་བར་འགྱུར་རོ།",
    "གལ་ཏེ་མི་བྱེད་ན་མྱ་ངན་ལས་འདའ་བར་འགྱུར་ན་ཅིའི་ཕྱིར་ཁྱོད་ཀྱིས་བསྟན་བཅོས་འདི་ལས་མི་རྟག་པ་ཉིད་ལ་སོགས་པའི་དོན་སྟོན་པར་བྱེད་ཅེ་ན།",
    "གཞན་ཡང་ཕྱུག་པོ་རྣམས་ཀྱིས་ནི་ཡུལ་གྱི་བདེ་བའི་ལོངས་སྤྱོད་མོད་པའི་ཁྱིམ་དག་སྤོང་བ་དང་།",
    "ཡོད་པ་མ་ཡིན་པའི་ཕྱིན་ཅི་ལོག་གི་མཐོང་བར་ཕྱིན་ཅི་ལོག་རྣམས་ནི་གཏི་མུག་ཆེ་བའི་ཕྱིར་གང་གིས་ན་མྱ་ངན་ལས་འདས་པ་སྒྲུབ་པར་འགྱུར་བ་དེ་ལྟར་མི་འཇུག་གོ།",
    "གང་གིས་ཤེས་དེ་མཁས་པ་ཡིན།",
    "དེ་ལྟར་ན་རིམ་པའི་སྒོ་ནས་གང་ཞིག་གིས་ཐམས་ཅད་བཟློག་པའི་ཐབས་ཤེས་པ།",
    "དངོས་པོ་གཅིག་གི་ལྟ་པོ་གང་།",
    "དེ་བཞིན་དུ་མིག་གི་སྐྱེ་མཆེད་ཀྱི་རང་བཞིན་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ཉིད་སྐྱེ་མཆེད་བཅུ་གཉིས་ཆར་གྱི་ཡང་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་མིག་གི་ཁམས་ཀྱི་རང་བཞིན་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ཉིད་ཁམས་བཅོ་བརྒྱད་ཆར་གྱི་ཡང་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་དངོས་པོ་དང་ཡུལ་དང་དུས་དང་རྟེན་གྱི་དབྱེ་བས་ཐ་དད་ཅིང་རབ་ཏུ་དབྱེ་བ་མཐའ་ཡས་པ་རྣམས་ལས་དངོས་པོ་གཅིག་གི་རང་བཞིན་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ཉིད་དངོས་པོ་ཐམས་ཅད་ཀྱི་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "གཅིག་གིས་ཐམས་ཅད་ཤེས་འགྱུར་ཞིང་།",
    "གཅིག་གིས་ཐམས་ཅད་མཐོང་བར་འགྱུར།",
    "བདག་གི་འདུ་ཤེས་ཤེས་པར་ལྟར།",
    "འདི་ནི་མི་འགལ་ཏེ་གང་གི་ཕྱིར།",
    "རབ་ཏུ་བྱུང་ནས་སྡུག་བསྔལ་དེ་ཉིད་འདོད་པ་ཁྱོད་ནི་སྐྱེས་བུ་བླུན་པོ་ཞིག་གོ་ཞེས་སྨད་པ་མཛད་དོ།",
    "དེ་ནི་ལྷག་པར་མ་མོས་པས་བཅོམ་ལྡན་འདས་ཀྱིས་སྟོང་པ་ཉིད་སྤོང་བར་འགྱུར་རོ།",
    "ཡང་ན་སྟོང་པ་ཉིད་ཀྱི་དོན་ནི་ཐམས་ཅད་མེད་པའི་དོན་དུ་ལོག་པར་ཡོངས་སུ་བརྟགས་ན་ལོག་པར་ལྟ་བས་ངན་སོང་དུ་འགྲོ་བར་འགྱུར་རོ།",
    "འདིར་གནས་མ་ཡིན་པ་དག་ལ་སྟོང་པ་ཉིད་སྦྱོར་བ་ཡང་དེ་དག་གི་དོན་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "དེ་ནས་དེས་དུག་གིས་རྣམ་པར་འགྱུར་བ་ཞིག་ལ་བཏང་བ་དང་དེ་ཡང་ཞི་བར་གྱུར་ཏོ།",
    "དཔེར་ན་ཀླ་ཀློ་སྐད་གཞན་མི་ཤེས་པ་ཉིད་ཀྱི་ཕྱིར་རང་གི་སྐད་ཁོ་ནས་བསྟན་པར་བྱ་བ་ཡིན་པ་བཞིན་དུ་འཇིག་རྟེན་ཡང་འཇིག་རྟེན་པའི་དངོས་པོ་རྣམ་པར་གཞག་པའི་སྒོ་ནས་དེ་ཁོ་ན་ཉིད་ལ་གཞུག་པར་ནུས་སོ།",
    "གཞན་ཡང་རེ་ཞིག་ཁྱོད་ཉིད་ཀྱིས་རྣམ་པར་སྤྱོད་པ་དང་།",
    "དེ་གཉིས་ཆར་ཡང་དགེ་སློང་དེའི་གན་དུ་སོང་བར་གྱུར་ཏོ།",
    "ཡང་ན་དཔེར་ན་འགའ་ཞིག་གིས་ཕས་ཡུལ་གཞན་ནས་བུ་མོ་ཞིག་བླངས་ལ།",
    "དེ་ལ་མས་ཁྱོད་ཀྱི་ཕའི་གྲོགས་པོ་གནོད་སྦྱིན་འདི་ཞེས་བྱ་བ་དེ་དོན་དུ་གཉེར་བར་གྱིས་ལ་བུ་མོ་དེ་བལྟ་བར་བྱ་བའི་ཕྱིར་སོང་ཤིག་ཅེས་སྨྲས་པ་དང་།",
    "ལས་༣དེ་ནས་གནོད་སྦྱིན་དེས་དེ་གཞལ་མེད་ཁང་གི་ནསནམ་མཁའ་ལ་ཁྱེར་ནས་འོངས་པ་དང་།",
    "དེ་ལ་གནོད་སྦྱིན་དེས་བུ་སོང་ལ་འདི་སྡངས་ཤིག་ཅེས་སྨྲས་ལ།",
    "བདག་གིས་འདིའི་གཟི་བྱིན་མི་བཟོད་དོ་ཞེས་སྨྲས་སོ།",
    "བུ་མོ་དེ་མཐོང་ནས་གནོད་སྦྱིན་དེ་ལ་འདོད་པའི་འདོད་ཆགས་སྐྱེས་ཏེ་དེས་དེ་བཟུང་ངོ།",
    "ཁྱེའུ་དེ་ཡང་འདི་ཡུན་རིང་པོར་ཐོགས་པར་བྱེད་དོ་སྙམ་སྟེ་རང་ཉིད་སོང་བ་དང་།",
    "དེ་ཉིད་ཀྱིས་བཟུང་བའི་བར་དུ་མཐོང་ནས་དེས་དེ་ལ་འདི་ཐོང་ཤིག་ཅེས་འདི་ནི་ཁྱོད་ཀྱི་མནའ་མ་ཡིན་ནོ་ཞེས་ཞུས་པས་དེས་མ་བཏང་བར་གྱུར་ཏོ།",
    "དེ་ལྟར་ན་འགའ་ཞིག་འགའ་ཞིག་གི་གཉེན་པོར་འགྱུར་ཏེ།",
    "ཡོད་པ་དང་མེད་པ་ལ་སོགས་པའི་བསྟན་པ་འདི་རྣམས་ལས་ཀྱང་ནང་གི་ཟླ་བདག་ཉིད་དུ་སེམས་པ་ལ་ཞུགས་པའི་ཕྱིར་ན་གཉི་ག་མ་ཡིན་པར་བསྟན་པ་གང་ཡིན་པ་དེ་དོན་དམ་པའི་བསྟན་པ་ཡིན་ལ།",
    "གང་གི་ཕྱིར་ཡེ་ཤེས་མཐོང་བ་རྫོགས་པ་ཡོད་ན་མྱ་ངན་ལས་འདས་པ་འཐོབ་ལ།",
    "མ་རྫོགས་ན་བཟང་འགྲོ་ཡིན་པའི་ཕྱིར་མཁས་པས་རྟག་ཏུ་ནང་གི་བདག་ཉིད་བསམ་པ་ལ་བློ་སྦྱང་དགོས་སོ།",
    "དེ་ལ་དགེ་སློང་འགའ་ཞིག་གིས་ངེད་ཅག་ལ་སྐྱེས་རངས་ཤིག་ལོང་ཤིག་ཅེས་སྨྲས་པས།",
    "དེས་དེ་སྤངས་ཏེ་བསླབ་པའི་གཞི་གཅིག་བླངས་ནས་སོང་སྟེ་མཚན་མོ་རྒྱལ་པོའི་གྲྭ་སའི་ཁབ་ཏུ་རྐུ་བའི་ཕྱིར་ཞུགས་པ་དང་།",
    "དེས་ཀྱང་དེ་ལ་བཙུན་མོ་རྒྱན་ཐམས་ཅད་ཀྱིས་ཀླུབས་པ་བཙལ་ཞིང་རི་མོར་བྱས་པ་ལྟ་བུ་སྟེ།",
    "དེ་བཞིན་དུ་ནང་གི་བདག་ཉིད་འདི་བསམས་ན་མྱ་ངན་ལས་འདས་པའི་འབྲས་བུ་ངེས་པར་ཐོབ་བོ།",
    "ཨ་མ་ཟོས་ཏེ་འཛུགས་པ་བཞིན་ནོ།",
    "གང་ཞིག་ཀཟན་ཨ་མྲའི་འབྲས་བུ་སྨིན་པ་ཟོས་ཟིན་པར་བྱས་ནས་ས་བོན་མ་བརླག་པར་འཛུགས་པ་དེས་འཕྲལ་དུ་ས་བོན་མྱང་བའི་འབྲས་བུ་མི་འཐོབ་ཀྱི།",
    "གལ་ཏེ་དེ་ལྟར་དེ་ཁོ་ན་ཉིད་ཤེས་པ་ཡོད་ན་ཅིའི་ཕྱིར་གྲོལ་བ་དག་མི་སྣང་ཞེ་ན་ལ་ལར་སྣང་མོད་ཀྱི།",
    "དེ་བཞིན་དུ་བདེ་བར་གཤེགས་པའི་བསྟན་པ་འདི་ན་ཡང་མྱ་ངན་ལས་འདས་པ་འདོད་པ་ཡོད་མོད་ཀྱི།",
    "གཏུམ་མོ་ལྕགས་ལྡག་པ་བཞིན་ནོ།",
    "ཇི་ལྟར་གདོལ་པ་མོ་རྐུན་བཙུགས་པ་ཞིག་ཉེས་པ་དེ་དང་བྲལ་བ་ཡིན་དུ་ཟིན་ཀྱང་།",
    "ཁོ་མོ་ནི་གཏུམ་པོ་ཉིད་ཀྱིས་སྨེ་བའི་རང་བཞིན་ཅན་ཞིག་སྟེ།",
    "གང་དེ་ལྟར་དུས་ཡུན་རིང་པོར་ཞུགས་པའི་ཉོན་མོངས་པའི་ཚོགས་འདི་ལ་ཟད་པ་ཡོད་དོ་ཞེས་བྱ་བ་འདི་ཇི་ལྟར་ངེས་པར་ནུས་ཤེ་ན།",
    "དེས་དེ་ཡང་ཡོངས་སུ་དོར་བ་བཞིན་དུ་རྣལ་འབྱོར་པ་ཡང་ལུས་ཡོན་ཏན་དང་བྲལ་བ་ཐོས་པ་ཙམ་གྱིས་འདོད་ཆགས་སྐད་ཅིག་ཙམ་མི་གནས་པར་མཐོང་ནས་བདག་གིས་ལམ་འདིའི་སྒོ་ནས་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་གཏན་བཟློག་པར་བྱ་བར་ནུས་སོ་ཞེས་ལམ་དེ་ཉིད་གོམས་པར་བྱེད་དོ།",
    "ཉོན་མོངས་པ་དེ་དག་ཀྱང་ཡེ་ཤེས་ཀྱི་མེས་བསྲེག་པ་ལ་དངོས་པོ་མེད་པར་ཉེ་བར་འགྲོ་སྟེ།",
    "འགྲོ་བ་སྟོང་པར་གཟིགས་མོད་ཀྱང་།",
    "ཡུན་རིངས་ཁྱེད་ཉོན་མོངས་པ་གང་།",
    "འདི་ནི་ཁྱོད་ཀྱི་དཀའ་སྤྱོད་ཆེན་པོའོ།",
    "ཇི་སྐད་དུ་བཅོམ་ལྡན་འདས་ཀྱིས་རབ་འབྱོར་མིག་ནི་བདག་དང་བདག་གི་བ་དང་།",
    "འཇིག་པ་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་མིག་ནི་མིག་གིས་སྟོང་པ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཇི་ལྟར་དེ་བཞིན་གཟིགས་དེས་ན།",
    "གང་གི་ཕྱིར་འདི་དེ་ལྟར་ཡིན་པ་དེའི་ཕྱིར།",
    "རྣམ་པ་གཅིག་ཏུ་ན་ཚོར་བ་གསུམ་མྱོང་བར་འགྱུར་བའི་ལས་ཡུལ་དང་དུས་དང་ལུས་ཀྱི་གནས་སྐབས་ཀྱི་ཁྱད་པར་གྱིས་མྱོང་བར་བྱ་བ་རྣམས་ལ་དེ་དག་མེད་པར་ལས་ཀྱི་འབྲས་བུ་ཡང་དག་པར་མྱོང་བ་མེད་པས་དེའི་དོན་དུ་ཕྱི་དང་ནང་གི་དངོས་པོ་དག་སྐྱེ་བའི་ཕྱིར་དངོས་པོ་ཐམས་ཅད་འབྲས་བུའི་དོན་དུ་སྐྱེ་བའི་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་རྣམ་པར་གནས་པ་ནི་མ་ཡིན་ཏེ།",
    "དངོས་པོ་ཐམས་ཅད་སྟོང་པ་ཉིད་འདི་ཡང་སྟོན་པ་གཞན་གྱི་ཚིག་གིས་མ་བསྟན་ཏོ་ཞེས་བཤདཔ་ནི་དེའི་ཕྱིར།",
    "རང་ཉིད་ལ་འབྲས་བུའི་དོན་མ་གྲུབ་པའི་ཕྱིར་ལ་གཞན་ལ་གྲུབ་པ་གཏན་ཚིགས་སུ་ཁས་ལེན་ན་ཧ་ཅང་ཡང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་གི་ལྟར་ན་གཉི་ག་ལ་གྲུབ་པའི་སྒོ་ནས་རྗེས་སུ་དཔག་པས་གནོད་པ་མི་སྲིད་པའི་ཕྱིར་རང་ལ་གྲུབ་པས་ཀྱང་རྗེས་སུ་དཔག་པས་གནོད་པ་ཡོད་དོ་ཞེས་འདོད་པ་དེ་ལྟར་ན་ཡང་དོན་སྟོན་པ་ལ་མི་མཁས་པ་ཉིད་དུ་འགྱུར་ཏེ།",
    "གཞན་ཡང་ནམ་མཁའ་ཡང་མིག་གི་རྣམ་པར་ཤེས་པ་དང་མྱུ་གུ་བསྐྱེད་པ་ལ་རྒྱུ་ཉིད་དུ་བརྗོད་པའི་ཕྱིར་དང་།",
    "གང་ཞིག་བླུན་པ་ཉིད་ཀྱི་དངོས་པོ་མ་ཡིན་པ་རི་བོང་གི་རྭ་ལྟར་ཡོད་པ་མ་ཡིན་པ་ལ་དངོས་པོ་ཡོད་པ་མ་ཡིན་པར་མི་རྟོགས་པ་དེ་ཡང་སྐྱེ་བོ་སྤྱི་ལ་གྲགས་པས་བརྗོད་པར་འདོད་པའི་དོན་འཛིན་པར་བྱེད་དུ་གཞུག་པར་ནུས་པ་ཁོ་ནའོ།",
    "འཇིག་རྟེན་པ་གང་ཞིག་རང་གི་མཚན་ཉིད་དུ་སྒྲོ་བཏགས་ནས་མི་རྟོག་པ་ཉིད་དུ་རྟོགས་པ་དེས་ནི་དངོས་པོར་བརྫུན་པ་དང་།",
    "འདིར་ཁ་ཅིག་དག་ན་རེ་གང་ཞིག་འབྲས་བུའི་དོན་དུ་སྐྱེས་པ་དེ་ནི་རྟག་པ་མ་ཡིན་པ་ནི་བདེན་མོད་ཀྱི།",
    "དེ་དག་གི་ཡོད་པ་ཉིད་དང་རྟག་པ་ཉིད་ཐུགས་སུ་མ་ཆུད་པས་དེ་བཞིན་གཤེགས་པ་ཕྱིན་ཅི་མ་ལོག་པ་གཟིགས་པ་ཡང་མ་ཡིན་ནོ་ཞེས་འཛེར་ཏེ།",
    "དེ་དག་གི་ལུགས་ཀྱང་མི་རིགས་པ་ཉིད་དུ་བརྗོད་པའི་ཕྱིར་སློབ་དཔོན་གྱིས།",
    "གང་གི་ཕྱིར་འདི་དེ་ལྟར་ཡིན་པ།",
    "གང་གི་ཚེ་དེ་ལྟར་གཞན་གྱིས་ཀུན་བརྟགས་པའི་དངོས་པོ་རྟེན་ཅིང་འབྲེལ་པར་མ་བྱུང་བ་དག་ལ་ཡོད་པ་ཉིད་དང་རྟག་པ་ཉིད་དག་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་དེ་བཞིན་གཤེགས་པ་ཕྱིན་ཅི་མ་ལོག་པར་གཟིགས་པ་ཉིད་དུ་གྲུབ་བོ།",
    "དེའི་ཕྱིར་དེའི་འབྲས་བུ་དམིགས་པའི་ཕྱིར་རེ་ཞིག་བདག་ཡོད་དོ།",
    "གང་གི་ཕྱིར།",
    "གང་གི་ཕྱིར་འདི་དེ་ལྟར་ཡིན་པ།",
    "གང་གི་ཕྱིར་བུམ་པ་དང་བདེ་བ་ལ་སོགས་པ་བྱས་པ་ལ་ཡོད་པ་ཉིད་དམིགས་ཏེ།",
    "གང་གི་ཕྱིར།",
    "སོ་སོའི་སྐྱེ་བོ་དག་གིས་རྟོག།",
    "འདི་ལྟར་དངོས་པོའི་རང་བཞིན་ལ་མཁས་པ་རྣམས་ཀྱིས་ནི་ནམ་མཁའི་མིང་སྦྱོར་བ་ན་ཇི་ལྟར་ས་ལ་སོགས་པའི་བརྗོད་པ་དག་ལ་སྲ་བ་ལ་སོགས་པ་ལྟར་འཇིག་རྟེན་པའི་ཤེས་པས་ཀྱང་རང་གི་ངོ་བོས་བརྗོད་པར་བྱ་བ་ཅུང་ཟད་ཀྱང་མི་དམིགས་ན།",
    "དངོས་པོའི་རང་བཞིན་མཁྱེན་པ་ལ་གནས་ཤིང་ཕྱི་ནང་གི་བདག་ཉིད་ཅན་གྱི་དངོས་པོར་དམིགས་པ་མི་མངའ་བ་རྣམས་ཀྱིས་དེའི་རང་གི་ངོ་བོ་དམིགས་པར་འགྱུར་བ་ལྟ་ཅི་སྨོས།",
    "མ་སྐྱེས་པ་འདི་ཡོད་པ་མ་ཡིན་པ་ཉིད་དུ་བསྟན་པས་དོན་གྱིས་དེའི་རྟེན་ཅན་བརྟེན་པས་ཐམས་ཅད་མི་སྲིད་པ་དེ་ཡང་བསྟན་པ་ཡིན་མོད་ཀྱི།",
    "ནམ་མཁའ་ནི་ནམ་མཁའི་ཆ་ཤས་གང་དག་ཡིན་པ་དེ་དག་གི་ཆ་ཤས་ཅན་དུ་འགྱུར་ལ།",
    "དེ་རྣམས་ལ་ཉེ་བར་སྦྱོར་བ་དེ་ནི་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་འགྱུར་རམ་ཕྱོགས་གཅིག་གིས་ཡིན་གྲང་ན།",
    "དེ་ལ་རེ་ཞིག་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་ནི་མ་ཡིན་ཏེ།",
    "བུམ་པ་ལ་སོགས་པ་རྣམས་ཀྱང་རེ་རེ་ཞིང་ཐམས་ཅད་ན་ཡོད་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ས་བོན་ལ་སོགས་རྐྱེན་རྣམས་ཡོད་ཀྱང་ཐམས་ཅད་ཀྱི་ཚེ་མྱུ་གུ་ལ་སོགས་པ་སྐྱེ་བ་མ་དམིགས་ལ་ཅི་སྟེ་འགའ་ཞིག་གི་ཚེ་དམིགས་ཤིང་དེ་གནས་པ་དང་འགལ་བའི་དུས་ཉེ་ན་ཡང་ལྡོག་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་དེ་ཡོད་ཀྱང་རེས་འགའ་བྱ་བ་བྱེད་པ་དག་ལ་བྱ་བ་ལོག་པ་ཉིད་དུ་རྟོག་ན།",
    "དེ་ལྟ་ན་ཡང་ས་བོན་ལ་སོགས་པ་རྣམས་ལྟར་དེའི་རུང་བའི་བདག་ཉིད་ཀྱི་ཁྱད་པར་དེ་རེས་འགའ་བ་ཉིད་ཡིན་པའི་ཕྱིར་མི་རྟག་པར་འགྱུར་བ་ལ།",
    "ཞེས་སྨྲ་བ་ཁ་ཅིག་ཏ་དག་གིས་དུས་རྟག་པར་རྟོགས་པ་དེ་དག་འདིར་འགོག་པར་བྱེད་དེ།་",
    "གང་གི་ཕྱིར།",
    "འབྲས་བུ་ཉིད་དུ་ཐལ་བར་འགྱུར།",
    "ཏ་དེའི་ཕྱིར་དེ་ལྟར་ན་རྒྱུ་དང་འབྲས་བུ་དངོས་པོ་རྣམ་པར་གནས་པ་མེད་པའི་ཕྱིར་གཉི་ག་ལ་ཡང་རང་གི་ངོ་བོས་གྲུབ་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "འདི་ལྟར་ས་བོན་ཡོད་ན་མྱུ་གུ་འབྱུང་གི་མྱུ་གུ་ཡོད་ན་ས་བོན་ནི་མ་ཡིན་ཏེ།"
  ]
}