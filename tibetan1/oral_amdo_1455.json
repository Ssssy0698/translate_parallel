    "ཧཱུཾ་མཛད་ཀྱི་ང་རྒྱལ་གྱིས་དཀྱིལ་འཁོར་དུ་ཞུགས་ནས་གཙོ་བོའི་དམ་རྒྱས་ཛ་ཧཱུཾ་བཾ་ཧོ་བརྗོད་དེ་གཙོ་བོ་དང་དབྱེར་མེད་པར་མོས།",
    "ཕྱག་རྒྱ་དེ་གཉིས་སུ་བྱས་ལ་མཛུབ་མོ་གཉིས་ཀྱིས་གོ་བགོ་ཞིང་སརྦ་མུ་ཏཱཾ་མེ་དྲི་དྷི་ཀུ་རུ་ཝ་ར་ཀ་ཝ་ཙེ་ན་ཁཾ་ཞེས་དང་།",
    "མཐར་མཉམ་པའི་ཐལ་མོ་རྟིང་པ་བརྡབས་ལ་ཨོཾ་བཛྲ་དུ་བྱ་ཧོས་མཉེས་པར་བྱས་ཏེ་ཡིག་བརྒྱས་ལྷག་ཆད་བསལ་ནས།",
    "བདག་གིས་ཆོ་ག་མ་ཚང་བ་གང་དག་བགྱིས་པ་དེ་དག་བཟོད་པར་མཛོད་ཅིག།",
    "སོགས་དང་རྡོ་རྗེ་བསྡམས་པ་ལས་གུང་མོ་གཉིས་བསྙམས་ཏེ་གཤིབས་ལ་བསྒྲེང་བ་སེམས་མ་རྡོ་རྗེ་མའི་ཕྱག་རྒྱ་སྤྱི་བོ་ནས་གྱེན་དུ་བཀྲོལ་ལ་ཨོ་བཛྲ་མུཞེས་ཡེ་ཤེས་པ་གཤེགས།",
    "བསྡུ་བའི་སྔགས་རྒྱས་དམ་ཚིག་པ་རང་ལ་ཐིམ་པར་གྱུར་ཞེས་མོས།",
    "ཨོཾ་བཛྲ་ཀརྨ་ཀཾ་སོགས་བྱང་གི་སེམས་དཔའ་བཞིའི་སྔགས་རྒྱས་བསྲུངས་ལ་མཎྜལ་དབུལ་བ་དང་གླེག་བམ་ཀློག་པ་སོགས་བྱའོ།",
    "ག་བུར་གུར་གུམ་ཙན་དན་དཀར་དམར་གླ་རྩི་སྟེ་དྲི་ལྔའམ་དྲི་བཟང་གི་ཆུས་བཀང་ཞིང་།",
    "ཞེས་མོས།",
    "འདབ་མ་དང་འབྲས་བུ་དྲི་ཞིམ་པོའི་ཤིང་གིས་ཁ་བརྒྱན།",
    "དེའི་སྟེང་དུ་རྡོ་རྗེ་མེ་ཏོག་གི་ལྕུག་མའི་གཟུང་ཐག་དང་བཅས་པ་བཀོད།",
    "ཉེ་འཁོར་ཀུན་དྲི་བཟང་གིས་བྱུགས་མེ་ཏོག་སིལ་མ་བཀྲམ།",
    "ངན་སོང་སྦྱོང་རྒྱལ་དཀར་དམར་སོགས་རྒྱབ་ཡོལ་ཅན་དུ་གྱུར་གྱི་བར་དང་དེ་བཞིན་དུ་གྲྭ་བཞིའི་གདན་ལ་རིམ་བཞིན་ཨོཾ་བུད་དྷ་ལོ་ཙ་སོགས།",
    "གཞལ་ཡས་ཁང་ཕྱི་མའི་ལྷ་སྣམ་ནང་མའི་གདན་ལ་རྩ་རིག་ལས་བསྐལ་བཟག་གི་སེམས་དཔའ་བསྐྱེད་པ་ནས།",
    "སྒོ་བཞིའི་གདན་ལ་རྩ་རིག་ལས་ཁྲོ་བོ་བཅུ་དྲུག་གི་བར་དང་།",
    "བདག་གི་མཆོད་ཡོན་བཞེས་ནས་ཀྱང་།",
    "དེ་བཞིན་བདག་གིས་ཁྲུས་བགྱིའོ།",
    "ཨོཾ་བཛྲ་ས་ཏྭ་ཧཱུཾ་གིས་མཆོད་ཡོན་ཕུལ་ཏེ་རིགས་གསུམ་སྤྱིའི་སྔགས་རྒྱས་གནས་གསུམ་བྱིན་གྱིས་བརླབ།",
    "གཡོན་དེ་བཞིན་གཤེགས་པའི་ཁུ་ཚུར་བཀན་ལ་གཡས་པའི་མཐེབ་མཛུབ་ཀྱིས་མཐེའུ་ཆུང་ནས་བརྩམས་ཏེ་ཕྱེ་ནས་ཐལ་མོ་ཁོང་སྟོང་དུ་བྱས་པ་ནི་སྐལ་བཟང་རྣམས་ཀྱི་དམ་རྒྱ་དང་།",
    "ལག་པ་གཉིས་ཐལ་མོ་སྦྱར་ལ་སོར་མོ་ཀུན་གྱིས་ཀུན་ནས་གང་བའི་མཛོད་ལྟར་གནས་པ་ལས་ལག་པ་གཉིས་བཀྱེད་ནས་མཐེ་བོང་མཐེའུ་ཆུང་རྩེ་སྤྲད་དེ་སོར་མོ་རྣམས་བརྐྱང་བ་ཉན་ཐོས་ཀྱི་དང་།",
    "ལག་པ་གཉིས་ཐལ་མོ་སྦྱར་ནས་སོར་མོའི་རྩེ་མོ་རིམ་བཞིན་མཚན་མར་བསྡུས་ནས་ཁ་སྦྱོར་དུ་བྱས་ཏེ་མཐེ་བོང་གཉིས་བསྒྲེང་ནས་བསྐུམ་པ་རང་རྒྱལ་གྱིའོ།",
    "ཡང་ན་རྡོ་རྗེ་བསྡམས་པ་ལས་ཁུ་ཚུར་བཅངས་ཏེ་བསྟན་པ་ཉན་རང་ཐུན་མོང་གིའོ།",
    "རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་ལ་གུང་མོ་གཉིས་རྩེ་སྤྲད་དེ་བརྐྱང་ཐ་མ་བཞི་སོ་སོར་བསྒྲེང་བ་ཁྲོ་བོའི་དང་།",
    "ཐལ་མོ་བརྐྱང་བའམ་ཐལ་མོ་པདྨ་ལྟར་བྱས་པའི་འཇིག་རྟེན་པ་སྤྱིའི་དམ་རྒྱའོ།",
    "བདག་གིས་གུས་པས་བཤམས་པ་འདི།",
    "ཞེས་དང་རྡོ་རྗེ་ཐལ་མོ་ཁ་ཕྱེ་བའི་རྒྱས།",
    "རོལ་མོ་དབྱངས་སྙན་ཡིད་འོང་ལྡན།",
    "ཅེས་དང་རོལ་མོ་བྱ་ཞིང་།",
    "ཨོཾ་བཛྲ་གྷཎྜ་ར་ཎི་ཏ་པྲ་ར་ནི་ཏ་སཾ་པྲ་ར་ཎི་ཏ་སརྦ་བུད་དྷ་ཀྵེ་ཊ་པྲ་ཙ་ལི་ཏེ་པྲཛྙཱ་པཱ་ར་མི་ཏཱ་ནཱ་ད་སཾ་བྷ་ཝེ་བཛྲ་དྷརྨཱ་ཧྲི་ད་ཡ་སནྟོ་ཥ་ནི་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཧོ་ཨ་ཁཾ་སྭཱ་ཧཱ།",
    "ཞེས་དང་ཁུ་ཚུར་གཉིས་ཀྱིས་སྙན་ཆ་འདོགས་པའི་ཚུལ་གྱིས་རད་ན་མུ་ཀུ་ཊཾ་གི་གནས་སུ་རད་ན་ཀུནྜ་ལི་སྦྱར་བ་སོགས་འགྲེ།",
    "ཐུགས་མཚན་དཔལ་བེ་མཛེས་བྱེད་སེ་མོ་དོ།",
    "གཡོན་ཁུ་ཚུར་ལས་མཐེབ་བོང་བསྒྲེང་བའི་རྩེར་གཡས་ཀྱི་ཐལ་མོ་ཁ་སྦུབ་པས་ཙྪ་ཏྲཾ་ག།",
    "ལག་པ་གཉིས་བརྐྱང་ལ་སྲིན་ལག་གི་ཚིགས་དབུས་མ་བཀུག་པ་ནམ་མཁར་བཏེག་ལ་དྷུ་ཛ།",
    "རིན་ཆེན་རྒྱན་འོད་ལྡན་པའི་བླ་རེ་བྲེས།",
    "གཡོན་མཉམ་བཞག་གཡས་ཁ་ཐུར་དུ་བསྟན་ཏེ་བླ་རེ་བྲེ་ཚུལ་དང་བི་ཏཱ་ནཾ།",
    "ཕྱག་རྒྱ་སྔ་མ་ལས་གྲུ་བཞི་པའི་ཚུལ་དང་ཨ་མ་ཡ་ཙ་ཏུར་པྲ",
    "འདོད་པའི་འདམ་གྱི་མ་གོས་པད་མོ་མཆོག་ཁུ་ཚུར་གཉིས་མེ་ཏོག་འཐོར་བའི་ཚུལ་དང་པུཥྤ།",
    "ཐལ་མོ་གཉིས་བརྐྱང་བས་ན་བཟའ་འབུལ་ཚུལ་དང་དང་ཝསྟུ།",
    "ལག་པ་གཉིས་འཁྲིག་མ་བསྣོལ་ཏེ་རྒྱབ་སྦྱར་བའི་སོར་མོ་རྣམས་གཅིག་ལ་གཅིག་འཁྱུད་དེ་མཐེབ་བོང་གཉིས་ལག་མཐིལ་དུ་བཀུག་ལ།",
    "འབྱོར་བ་ཕུན་སུམ་ཚོགས་པར་ཤོག་ཁུ་ཚུར་ལས་མཛུབ་མོ་གཉིས་ཀྱི་ཚིགས་བཅག་སྟེ་མཐེ་བོང་གཉིས་དང་རྩེ་སྤྲད་ལ་གོང་བཞིན་ལས་ཙཀྲའི་གནས་སུ་མ་ཎི།",
    "བཙུན་མོ་རིན་ཆེན་འདི་ཕུལ་བས།",
    "རྡོ་རྗེ་ཐལ་མོ་ལས་མཛུབ་མོའི་རྩེ་མོ་གཉིས་གུང་མོ་མཉམ་པའི་ཚིགས་སུ་སྦྱར་ལ་སྟྲཱི།",
    "རྡོ་རྗེ་བསྡམས་པ་ལས་གུང་མོ་མཐེབ་བོང་མཐེའུ་ཆུང་རྣམས་སོ་སོར་གཤིབས་ཏེ་བསྒྲེང་ལ།",
