    "དེ་ཉིད་དཔྱད་པར་བྱ་བ་ཡིན་ཏེ།",
    "གལ་ཏེ་སྐྱེས་པ་ཙམ་གྱིས་དོན་རིག་པ་ཡིན་ན་མིག་ཀྱང་དེས་རིག་པར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་འབྲས་བུ་མཐོང་བ་ལས་རྗེས་སུ་དཔག་པས་དོན་རྗེས་སུ་དཔག་པར་བྱ་བ་དེ་བཞིན་དུ་མིག་ཀྱང་ཡིན་པས་དེ་ཡང་དེས་རིག་པ་དང་།",
    "དེ་ཉིད་དེའི་རྣམ་པར་བརྟག་པར་འགྱུར་རོ།",
    "བཞིན་ལྟར་གཟུགས་བརྙན་གྱིས་སྣང་བ་ཡིན་ནོ་ཞེས་བརྟག་པར་བྱའོ།",
    "གལ་ཏེ་དེ་ལྟ་ཡིན་པ་དེ་ལྟ་ན་ཡང་བར་དང་བཅས་པ་དག་ལ་བར་མེད་པར་གཟུང་བའི་ཕྱིར་འཁྲུལ་པ་ཉིད་དོ།",
    "དེའི་ཕྱིར་དངོས་པོ་བར་མེད་པ་ཉིད་དུ་བརྟག་པར་བྱ་བ་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་བཞིན་དུ་དངོས་པོ་ཆ་མེད་པ་ཉིད་དུ་ཡིན་པས་རྡུལ་ཕྲ་རབ་ཏུ་གྲུབ་པོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "སྒྲུབ་པར་བྱེད་པ་ནུས་མ་ཡིན།",
    "འཁྲུལ་པ་ཉིད་ནི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "སྒྲུབ་པར་བྱེད་པའི་དོན་ནི་མི་འཁྲུལ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འཁྲུལ་པ་ཡིན་ཡང་སྒྲུབ་བྱེད་ཡིན་ན་ནི་ཐམས་ཅད་ཀྱི་སྒྲུབ་པར་བྱེད་པ་ཡིན་པར་འགྱུར་རོ།",
    "སྒྲུབ་པར་བྱེད་པ་ནི་ཡོད་པ་ཉིད་འཇོག་པར་བྱེད་པ་ཡིན་ན།",
    "དེའི་ཕྱིར་རྣམ་པར་ཤེས་པའི་སྔོན་པོ་ལ་སོགས་པའི་རང་བཞིན་ཙམ་གྱིས་དོན་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་མ་ངེས་པ་ཡིན་ནོ།",
    "དེ་དག་ཕན་ཚུན་རིག་པར་བྱེད་པའི་དངོས་པོ་ནི་མ་ཡིན་ནོ།",
    "དོན་མཚུངས་ཅན་གྱི་རྣམ་པར་ཤེས།",
    "འོ་ན་ནི་དེའི་ཚེ་ཡུལ་མཚུངས་པའི་ཤེས་པ་དེ་མ་ཐག་པ་ཡུལ་ཡིན་པར་འགྱུར་རོ།",
    "འོན་ཏེ་གང་ལས་སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པར་སྐྱེ་བ་རྣམ་པ་དེ་དང་ལྡན་པའི་ཡུལ་ཡིན་ནོ།",
    "དེ་ལྟར་མ་ཡིན་ན་སྔོན་པོའི་རྣམ་པ་ཅན་གྱི་དེ་མ་ཐག་པ་ལས་སེར་པོར་ཤེས་པར་མི་འགྱུར་རོ།",
    "དེས་ན་སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པ་དེ་མ་ཐག་པས་བྱས་པའི་མ་ཡིན་ནོ་ཞེས་རྟོགས་པས་དེ་ཡུལ་ཉིད་མ་ཡིན་ནོ།",
    "མྱོང་བ་ནི་དྲན་པའི་ཡུལ་ཡིན་པར་འདོད་པ་ཉིད་དོ།",
    "རྟོགས་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "སྔར་གྱི་སྔོན་པོ་ཉམས་སུ་མྱོང་བ་ལས་བསྒོམས་པའི་སྟོབས་ཀྱིས་གསལ་བར་སྣང་བ་སྐྱེད་པ་གང་ཡིན་པ་དེའི་ཡུལ་སྔ་མ་ཡིན་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་དེ་སྐྱེད་པར་བྱེད་པ་ཡིན་ཞེ་ན།",
    "བར་དུ་ཆོད་ཀྱང་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་འདི་ནི་བསྟན་ཟིན་ཏེ།",
    "ཡང་ན་རྣམ་པར་རྟོག་པའི་རྣམ་པ་ཉིད་གོམས་པ་ལས་གསལ་བར་སྣང་བའི་སྐྱེད་པར་བྱེད་པ་ཡིན་པས་ཡུལ་དུ་འགྱུར་རོ།",
    "ཞེས་བྱ་བའི་རིགས་པས་དོན་གྱི་རྣམ་པ་འདི་ནི་བསྒོམས་པའི་སྟོབས་ཀྱིས་རིགས་མཐུན་པ་ལས་ཡིན་པར་གནས་པའི་དོན་དུ་རྟོགས་པ་དེ་ནི་མི་རིགས་སོ།",
    "དེས་ན་དེ་མ་ཐག་པའི་ཤེས་པ་ཉིད་ཡུལ་ཡིན་པར་འགྱུར་རོ།",
    "ངེས་པར་ནི་དོན་ལས་གཞན་དུ་མི་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "དོན་ཉམས་སུ་མྱོང་བ་མེད་པར་ནི་དོན་ནོ་ཞེས་ངེས་པར་རིག་པ་མ་ཡིན་ཏེ།",
    "ཉམས་སུ་མྱོང་བས་དོན་རྣམ་པར་གནས་པ་ནི་མ་ཡིན་གྱི།",
    "གལ་ཏེ་ལྟ་བ་ཙམ་ནི་རྣམ་པར་འབྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེས་ན་ངེས་པ་ཁོ་ནས་དོན་དང་དོན་མ་ཡིན་པ་རྣམ་པར་འབྱེད་དོ་ཞེ་ན།",
    "གལ་ཏེ་དེ་ལྟ་ན་ནི་ངེས་པ་ཡང་རྣམ་པར་འབྱེད་པར་བྱེད་པར་མི་འགྱུར་ཏེ།",
    "ཟླ་བ་གཉིས་སུ་ཤེས་པ་ནི་ཟླ་བ་གཅིག་ཏུ་ངེས་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "ཅི་སྟེ་གོམས་པ་ལས་ངེས་པ་ནི་བྱེ་བྲག་ཏུ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "སོ་སོར་ངེས་པར་ཉམས་སུ་མྱོང་ན་ངེས་པ་དེ་གོམས་པ་ལ་འགྱུར་བ་ཡིན་ནོ།",
    "འདྲི་བ་ཐུག་པ་མེད་པར་འགྱུར།",
    "འོ་ན་ཇི་ལྟར་མངོན་སུམ་དུ་སོ་སོར་རིག་པར་བྱ་བའི་དོན་དགག་པར་ནུས།",
    "ཡང་ན་རྣམ་པར་ཤེས་པ་ལྐོག་ཏུ་གྱུར་པས་ན་གང་ཞིག་མྱོང་བ་དེ་ནི་དོན་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "གལ་ཏེ་དེ་ལྟ་ན་དེའི་མྱོང་བ་དེ་བདག་ཉིད་ཡིན་པར་འགྱུར་ཏེ།",
    "གཞན་ལ་རིག་པར་བྱ་བ་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་མངོན་སུམ་གྱིས་རིག་པར་བྱ་བ་ཡིན་གྱི།",
    "གལ་ཏེ་དེའི་རང་བཞིན་ཉིད་རྟོགས་པས་ཐ་དད་པར་རྣམ་པར་བཞག་ནས་དེ་ལྟར་ཐ་སྙད་བྱེད་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་སྔོན་པོ་ལ་སོགས་པ་གཞན་གྱིས་རིག་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "ཡང་ན་གལ་ཏེ་དོན་མྱོང་བ་མེད་ན་ཕྱི་རོལ་གྱི་ཡུལ་ཕྱོགས་དང་འབྲེལ་པར་སྤྱོད་ཡུལ་དུ་འགྱུར་བ་འདི་ཇི་ལྟར་བྱ་ཞེ་ན།",
    "མངོན་སུམ་དུ་སོ་སོར་རིག་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་མྱོང་བར་བྱ་བ་མེད་པར་དེ་ལྟར་བརྗོད་ཟིན་ཏོ།",
    "འདི་ནི་འོག་ནས་འཆད་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བུར་ནི་ངེས་པར་འགྱུར།",
    "ཐ་དད་པར་བསྙད་པ་ཙམ་གྱིས་ནི་ཐ་དད་པ་མ་ཡིན་ཏེ།",
    "བདག་ཉིད་ལ་ནི་བྱེད་པར་འགལ་བ་ཡང་ཡིན་ཏེ།",
    "བུམ་པ་ཡང་སྒྲོན་མས་གསལ་བར་ནི་བྱས་པ་མ་ཡིན་ཏེ།",
    "གསལ་བར་བྱས་པ་ཡིན་མིན་ཡང་།",
    "མིག་ལ་སོགས་པའང་འདོད་པར་བྱ།",
    "སྒྲོན་མ་ལ་སོགས་པས་བུམ་པ་གསལ་བར་བྱས་སོ་ཞེས་ཐ་སྙད་དུ་བྱེད་པ་དེ་བཞིན་དུ་མིག་ལ་སོགས་པ་ལས་ཀྱང་དེ་ལྟར་སྐྱེས་པས་ཐ་སྙད་དུ་བྱེད་པ་ཡིན་ནོ།",
    "འདི་ཀུན་ཐམས་ཅད་ཉམས་པར་འགྱུར།",
    "ཆད་པ་ནི་ཁྱད་པར་ཅན་དུ་སྐྱེད་པ་ཡིན་པས་དེ་ཉིད་ཀྱིས་དེ་ཉིད་སྐྱེད་པ་མ་ཡིན་ཏེ།",
    "དེ་དག་ལས་ཞེས་བརྗོད་པར་བྱ་བ་ཡིན་ན།",
    "དེས་ན་གཞན་གྱིས་འདི་སྐད་ཅེས་རང་གསལ་བར་བྱེད་པ་ཉིད་ནི་མ་མཐོང་ངོ་ཞེས་བརྗོད་པར་བྱ་བ་ཡིན་ལ།",
    "ཚོར་བྱ་ཚོར་བྱེད་འཐད་པར་དཀའ།",
    "དེ་ལྟ་མ་ཡིན་པར་འགྱུར།",
    "དེའི་ཚེ་ནི་གསལ་བྱ་དང་གསལ་བྱེད་དག་ཁྱད་པར་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་དེའི་བྱེད་པ་ལ་རིམ་གྱིས་རྟོགས་པའི་ཁྱད་པར་ཡོད་པ་ཡིན་ཏེ།",
    "དེ་ཡི་ཁྱད་པར་རྟོགས་པ་ཡིན།",
    "དེ་ལྟར་སྐྱེས་པར་ཅིས་མི་འདོད།"
