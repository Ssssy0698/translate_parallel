    "རིལ་པོ་གཅིག་ཏུ་སྣང་བ་ནི་རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་ཤེས་པ་ཡིན་ལ།",
    "ཞེས་གསུངས་ཏེ།",
    "དཔྱད་པར་འདི་ལ་ཡིད་ཀྱིས་ནི།",
    "དེའི་ཚེ་ཡིད་ཉིད་ཀྱི་ཡུལ་དཔྱོད་པར་འགྱུར་རོ།",
    "འདིའི་རྗེས་སུ་འབྲངས་ནས་དེ་ཡང་རྣམ་པར་འགྱུར་བ་ཤེས་པར་བྱའོ་ཞེ་ན།",
    "རྣམ་པར་འགྱུར་བའི་ཕྱིར་འདི་བཞིན་ནོ་ཞེས་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "ལོག་ཀྱང་ལྡོག་པར་མི་འགྱུར་ཞིང་།",
    "དེ་མིག་རྣམ་པར་འགྱུར་བ་ཡོད་ན་ཡང་ལྡོག་པར་ཇི་ལྟར་འགྱུར།",
    "ལོག་ཀྱང་ལྡོག་པར་མི་འགྱུར་རོ།",
    "ཆུར་འཁྲུལ་པ་ནི་གཞན་གྱི་རྒྱུད་ལ་འཇུག་པར་མ་མཐོང་སྟེ།",
    "སྦྲུལ་དུ་འཁྲུལ་པ་ཡང་མཐོང་བ་དྲན་པ་ལ་ལྟོས་པར་ནི་མ་མཐོང་སྟེ་ནག་པོ་ལ་སོགས་པ་ནི་དང་པོ་ཉིད་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལ་ནག་པོ་ལ་སོགས་པར།",
    "གཞན་དག་ནི་ཡིད་ཡིན་པའི་ཕྱིར་རྟོག་པ་དང་བཅས་པར་སེམས་པ་ཡིན་གྱི།",
    "འདི་ལྟར་རྟོག་པ་མེད་པ་གཅིག་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ཙམ་ཞིག་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པ་དང་།",
    "འོ་ན་ནི་གསལ་བར་སྣང་ཡང་ཟླ་བ་གཉིས་ལ་སོགས་པའི་བློ་ཡིད་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "བསྒོམས་པ་མེད་པར་ཡང་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཆུ་ལ་སོགས་པར་འཁྲུལ་པའི་ཡིད་གང་ཡིན་ཞེ་ན།",
    "ཕན་འདོགས་པ་དང་གནོད་པ་བྱེད་པར་སྣང་བའོ།",
    "སློབ་དཔོན་གྱིས་རྣམ་པར་རྟོག་པ་དང་།",
    "འཁྲུལ་པ་ནི་ཡིད་ཀྱི་འཁྲུལ་པའི་ཡུལ་ཡིན་ནོ་ཞེས་བྱ་བར་རྣམ་པར་གནས་སོ།",
    "ལྷག་པར་གྱུར་པས་ཡིད་ཀྱི་ལྷག་པར་རྣམ་པར་རྟོག་པ་གང་ཡིན་པ་དེར་འཁྲུལ་པ་ཡིན་ནོ།",
    "བརྗོད་པ་ལ་སོགས་པ་དག་ནི་ཡིད་ཉིད་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ཞེན་པའི་བདག་ཉིད་ཅེས་བྱ་བ་བསྟན་པར་བྱ་བ་མ་ཡིན་པར་འགྱུར་རོ།",
    "བརྗོད་པ་མེད་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱའོ་ཞེ་ན།",
    "དེ་ནི་མི་རིགས་ཏེ་འཁྲུལ་པ་མེད་པ་ཉིད་ནི་བརྗོད་པར་རིགས་ཏེ།",
    "འདི་ལྟར་འདི་མཚན་ཉིད་ཡིན་པར་འགྱུར་རམ།",
    "དོན་མེད་པར་གཞན་གྱིས་བརྗོད་པ་ཅི་བྱ།",
    "དེས་ན་དེ་རྣམ་པར་བཅད་པའི་ཕྱིར་ངེས་པར་མཚན་ཉིད་གཞན་དུ་བརྗོད་པར་བྱའོ།",
    "བདེ་བར་གཤེགས་པ་རྣམས་ཀྱི་མཚན་ཉིད་ནི་རྣམ་པར་ཤེས་པར་སྨྲ་བ་དང་།",
    "མཚན་ཉིད་བྱས་ན་སྐྱོན་ཅི་ཡོད།",
    "གཞན་ལ་མིས་ཡང་མེད་པར་འགྱུར།",
    "འཇིག་རྟེན་ན་རབ་ཏུ་གྲགས་པའི་མངོན་སུམ་ནི་འདི་ཙམ་ཞིག་ཡིན་ལ་རྣམ་པར་དཔྱད་ན་ནི་མི་འཐད་དོ།",
    "རྡུལ་ཕྲ་རབ་ཉིད་སྐྱེད་པར་བྱེད་པ་ཡིན་པས་དེ་དག་དམིགས་པ་ཉིད་ཡིན་ན་ནི་མིག་ལ་སོགས་པས་མ་ངེས་སོ།",
    "དུས་མཚུངས་པ་དེ་ནི་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་དུས་མཚུངས་ཀྱང་སྐྱེད་པར་བྱེད་པ་ཡིན་ན།",
    "ཅི་སྟེ་སྔར་ཡོད་པ་སྐྱེད་པར་བྱེད་པ་ཡིན་ན་དེ་ཡང་མ་གྲུབ་པོ།",
    "ཤེས་པ་མེད་པར་མཚོན་པ་མིན།",
    "མ་རྟོགས་པ་དེ་ཇི་ལྟར་འདི་འཇུག་པར་བྱེད་པ་ཡིན།",
    "ཅི་སྟེ་མངོན་སུམ་ཉིད་ཀྱིས་རྣ་བ་ལ་སོགས་པ་འཇུག་པ་རྟོགས་ན་འོ་ན་ནི་དེ་མངོན་སུམ་དེའི་མཚན་ཉིད་བརྗོད་པར་བྱ་སྟེ།",
    "ལྟ་བ་དང་ཁྱད་པར་གྱི་ཤེས་པ་ཡིན་ནོ་ཞེའོ།",
    "རྟོག་པ་རིགས་པར་མི་ལྡན་ཏེ།",
    "ཐུག་མེད་བཟློག་པ་མེད་པར་འགྱུར།",
    "དེ་ནི་མེད་དེ་བྱ་བ་སྒྲུབ་པར་བྱེད།",
    "དེ་ལྟར་ཡང་མ་ཡིན་ཏེ་དེའི་ཕྱིར་བྱ་བ་གང་གང་ལས་འགྲུབ་པར་མཐོང་བ་དེ་ཉིད་དེ་ལ་སྒྲུབ་པར་བྱེད་པ་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ནོ།",
    "དེས་ན་རྣམ་པར་གཞག་པར་འདོད་པའི་དོན་བཞིན་དུ་ཐམས་ཅད་རྣམ་པར་འཇོག་པའམ།",
    "མ་ཡིན་ན་ནི་རྣམ་པར་མ་བཞག་པ་བཞིན་དུ་རྣམ་པར་བཞག་པར་འོས་པ་ཡང་མི་འགྱུར་ཏེ་དེ་ལ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "རྟོགས་བྱེད་མིན་པར་ཅིས་མི་འདོད།",
    "སྤྱད་བྱའི་དངོས་པོ་རྟོགས་པར་བྱེད།",
    "ལོངས་སྤྱོད་ལེགས་པར་རྣམ་པར་གནས།",
    "བདེ་བ་དང་སྔོན་པོ་ལ་སོགས་པའི་ཞེན་པའི་རང་བཞིན་གྱི་བློས་བདག་དེ་ལྟར་རྣམ་པར་འཇོག་གོ་ཞེ་ན།",
    "བློ་དེ་གང་ཡིན་ཞིང་ཞེན་པ་གང་ཡིན་ལ་སྐྱེས་བུ་ཡང་གང་ཞིག་ཡོད་པ་བརྗོད་པར་བྱའོ།",
    "བློས་དོན་གྱི་རྣམ་པ་རྟོགས་པ་དེས་ན་ཡུལ་རིང་པོ་མ་ཡིན་པར་རྟོགས་སོ་ཞེ་ན།",
    "ཡུལ་ཐག་རིང་པོ་ཞེས་བྱ་བར་མི་རྟོགས་ཤིང་དེའི་རྣམ་པ་ཅན་གྱི་བློ་ལས་མ་རྟོགས་པའི་དོན་ཞེས་ཀྱང་མི་རྟོགས་པར་འགྱུར་རོ།",
    "བདག་ལྐོག་ཏུ་གྱུར་ཅིང་བློ་ཡང་ལྐོག་ཏུ་གྱུར་པའི་ཕྱིར་འགྲོ་བ་ལྡོངས་པར་འགྱུར་རོ།",
    "བྱེད་པ་མེད་པར་ཅི་ལྟར་མཐོང་ཞེ་ན།",
    "དེ་ལྟ་མ་ཡིན་ཏེ་གལ་ཏེ་རྣམ་པར་མ་གྱུར་ན་འཕོས་པའི་དོན་ཅི་ཡིན།",
    "དོན་དམ་པར་ཡུལ་གྱི་རབ་ཏུ་དབྱེ་བ་ནི་མེད་དེ་འགྲོ་བ་ནི་གཙོ་བོ་དང་སྐྱེས་བུ་ཙམ་གྱི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "འདི་ཡང་ཕྱིས་རྣམ་པ་གཞན་དུ་བསྟན་པར་བྱ་སྟེ།",
    "ཐ་དད་པར་ངེས་བྱེད་མ་ཡིན།",
    "དེ་ནི་དེའི་བྱེད་པ་པོའམ་ཤེས་པར་བྱེད་པ་ཉིད་ཀྱིས་ངེས་པར་བྱེད་པ་ཡིན།",
    "བྱེད་པ་པོ་ཉིད་ཀྱིས་ངེས་པར་བྱེད་པ་ནི་མི་འཐད་དེ།",
    "འོན་ཏེ་ཤེས་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་ངེས་པར་བྱེད་པ་ཡིན་ན་དོན་མ་ཤེས་ན་ཅི་ལྟར་ཤེས་པར་བྱེད་པ་ཡིན་ཤེས་པར་བྱེད་པ་ལས་ཤེས་པ་ངེས་ལ་ཤེས་པ་དེས་ན་ཤེས་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་ཕན་ཚུན་རྟེན་པའི་སྐྱོན་དུ་འགྱུར་རོ།",
    "སྣང་བ་བཞིན་དུ་ཤེས་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "མ་ཡིན་ཏེ་དེ་ཤེས་པར་བྱ་བ་ལ་ཡང་ཤེས་པར་བྱེད་པ་གཞན་དགོས་པའི་ཕྱིར་ཐུག་པ་མེད་དོ།",
    "ཐམས་ཅད་དུ་སྣང་བ་ཤེས་པར་བྱེད་པ་ཡང་མ་ཡིན་ནོ།",
    "སྣང་བས་ཤེས་པར་བྱས་ན་ཡང་མིག་ལ་སོགས་པས་ཅི་བྱ།",
    "ཐ་དད་པར་ནི་བྱེད་ན་ཡང་།",
    "སྒྲུབ་པར་བྱེད་པ་གཞན་ཡིན་ན།",
    "དེའི་རྣམ་པ་ཅན་གྱི་རིག་པ་ནི་འདི་ནི་སྔོན་པོའམ་སེར་པོ་ཡིན་ནོ་ཞེས་དོན་རྣམ་པར་འཇོག་པར་བྱེད་དོ།",
    "ཇི་ལྟར་ཤེས་པ་རྣམ་པ་དང་ལྡན་པ་དེ་ལྟར་ཡང་འོག་ནས་བསྟན་པར་བྱའོ།",
    "སྒྲུབ་པར་བྱེད་པ་གཞན་ཡིན་ན་ན་རིག་པ་ལས་དེ་དང་འབྲེལ་པར་མི་འགྲུབ་པོ།",
    "མངོན་དུ་བྱེད་པ་ཉིད་ལས་ངེས་པར་འགྱུར་རོ་ཞེ་ན།",
    "དོན་དེ་ཇི་ལྟར་མངོན་དུ་བྱས།",
    "མངོན་དུ་བྱེད་པ་དོན་ཡིན་པར་འཐད་པ་ཡང་མ་ཡིན་ཏེ།",
    "དོན་གྱི་རང་བཞིན་ནི་དོན་གྱི་སྒྲུབ་བྱེད་ཡིན་ལ་མྱོང་བའི་རང་བཞིན་ནི་མྱོང་བའི་སྒྲུབ་བྱེད་ཡིན་པས་དེའི་རྣམ་པ་ཉིད་ཐམས་ཅད་ཀྱི་སྒྲུབ་བྱེད་ཡིན་པར་འགྱུར་རོ།",
    "འབྲས་བུ་དོན་གཞན་ཡིན་པར་སྨྲ་བ་རྣམས་ལ་ཐམས་ཅད་འཐད་པར་དཀའ་བའི་ཕྱིར།",
    "དོན་གྱི་རྣམ་པ་ཉམས་སུ་མྱོང་བ་མ་རྟོགས་པར་ནི་དོན་རྟོགས་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "འབྲས་བུ་དོན་གྱི་རྣམ་པར་རིག་པ་ཡང་དོན་རིག་པ་ཡིན་པའི་ཕྱིར་འགལ་བ་ཅི་ཡོད།",
    "དོན་གྱི་རྣམ་པ་འཛིན་པ་དེ་ཉིད་ལ་རིག་པར་བྱེད་པ་ཞེས་ཐ་སྙད་འདོགས་སོ།",
    "བྱེད་པ་དང་བཅས་པར་རིག་པས་རྣམ་པར་གཞག་པ་ཡིན་ཞིང་དེ་ཡང་དོན་གྱིས་རྟོགས་པ་ཉིད་ཡིན་ལ།",
    "དོན་དམ་པར་ནི་དེ་དང་དེ་མ་ཡིན་པའི་རྣམ་པ་ཅན་གྱི་ཤེས་པ་གཞན་དང་གཞན་ཉིད་དེ།",
    "རིགས་མཐུན་སྔ་མའི་རྣམ་པར་ཤེས།",
    "ལྡོག་པར་རྣམ་རྟོག་ས་བོན་ཏེ།",
    "གལ་ཏེ་དེའི་རྣམ་པ་ཅན་གྱི་ཤེས་པ་དེས་བསྐྱེད་ན་དོན་དེ་ཉིད་དེ་ལ་བྱེད་པར་འགྱུར་གྱི་དོན་ལ་ནི་ཤེས་པས་མ་ཡིན་ན།",
    "འདི་ལ་ཡང་མྱ་ངན་ལ་སོགས་པར་མཐོང་བ་ཉིད་དོ།",
    "དོན་ནི་གནས་པར་འགྱུར་ན་འདིར།",
    "དེའི་ཕྱིར་དོན་གྱི་རྣམ་པ་ཉིད་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཁྱད་པར་གྱི་ནི་བློ་དེ་དག།",
    "དེ་ལས་གཞན་རིག་ལ་སོགས་པའི་ཁྱད་པར་ཅན་གྱི་དངོས་པོར་ངེས་པའི་བདག་ཉིད་ཅན་ནི་འབྲས་བུ་ཡིན་ནོ།",
    "དོན་སོ་སོར་ངེས་པར་རྣམ་པར་གཞག་པ་ནི་རྣམ་པའི་སྟོབས་ཉིད་ཀྱིས་ཡིན་གྱི་གཞན་ལས་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ལྟ་བའི་རྣམ་པར་ཤེས་པ་སོ་སོར་ངེས་པའི་རྣམ་པ་ལ་མི་བརྟེན་ན་ཅི་ལྟར་འདི་འདིའི་ལྟ་བ་ཡིན་ཞེས་བྱ་བར་འགྱུར།",
    "སོ་སོར་ངེས་པའི་དོན་རྣམ་པར་འཇོག་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་ཡི་སྒྲུབ་བྱེད་དམ་པར་འདོད།",
    "རྒྱུ་ཐམས་ཅད་བྱ་བ་ལ་ཉེ་བར་སྦྱོར་ཡང་དེ་ཇི་ལྟར་ཁྱད་པར་དུ་འཕགས།",
    "བྱ་བ་སྒྲུབ་པར་བྱེད་པ་ཙམ་ནི་མ་ཡིན་ཏེ།",
