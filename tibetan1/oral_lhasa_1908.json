    "ཀུན་མཁྱེན་ཀརྨ་བཛྲའི་གསུང་འབུམ།",
    "དྲན་པ་ཉམས་ན་མི་སྐྱེ་བར་ཉི་ཟླ་ཁ་སྦྱོར་ལས་གསུངས་སོ།",
    "ཀུན་མཁྱེན་ཀརྨ་བཛྲའི་གསུང་འབུམ།",
    "གཞི་སྣང་ལྷུན་གྲུབ་གྱི་སྣང་བ་བུ་ལྟ་བུ་དེ་ཐིམ་ན་རང་བཞིན་མེད་པར་སངས་རྒྱ་བའོ།",
    "དེ་ལ་གསང་ལམ་ཁྱད་པར་ཅན་འདི་ཡོད་དེ།",
    "ཕྱོགས་གང་དུའང་མ་ལྷུང་བའི་སྟོང་གསལ་སྒྲིབ་གཡོགས་དང་བྲལ་བར་འཆར་བས་དེ་ངོས་ཟིན་པར་བྱས་ཏེ་གཤིས་ཐོག་ཏུ་བཅས་བཅོས་མེད་པར་བཞག་པས།",
    "དང་པོ་ནི་གཞི་སྣང་ཤར་བ་དེ་ལ་ཁ་ཕྱིར་བལྟས་ཀྱི་ཤེས་པས་མ་བསླད་པར་རང་སྣང་དུ་རིག་པ།",
    "སྐྱེས་བུ་རྣམས་ཀྱི་རྣམ་པར་ཤེས་པ་འོད་གསལ་ལ་ཐིམ་པ་ཞེས་བྱ་སྟེ།",
    "ཞེས་དེའི་ཚེ་དུས་མ་འགྱུར་པར་སྣང་བ་འགྱུར་ནས་ཕྱི་ས་རྡོ་རི་བྲག་རྩི་ཤིང་ནགས་ཚལ་ཉི་ཟླ་དང་བཅས་པའི་བརྟན་གཡོའི་སྣང་བ་ནི་ནུབ།",
    "ཀུན་མཁྱེན་ཀརྨ་བཛྲའི་གསུང་འབུམ།",
    "ཤེས་རབ་ཡུལ་གྱི་སྣང་བ་རྣམ་པར་རིག།",
    "ཞེས་བསྟན་འཛིན་གྱི་ཞག་ལྔར་འཆར་བར་གསུངས།",
    "གྲོགས་སུ་གྲོལ་ལོང་ཡོད་པར་འཆར་ཞིང་།",
    "ཞེས་རང་བཞིན་གྱིས་བསམ་གཏན་ཁག་ཕེབས་ནས་སྣང་བ་མཆེད་པ་རང་སྣང་དུ་ངོས་བཟུང་བས།",
    "གསུམ་པར་གྲོལ་ཐོག་ཏུ་ཀ་དག་ཏུ་ཐིམ་པའི་མིང་བཙན་ས་ཟིན་པས་དེ་ཕན་ཆད་ཀྱི་སྣང་བ་གང་ཡང་མེད་དོ།",
    "སྣང་བ་དེ་དག་སྐུའི་རྣམ་པར་རང་ཤར་ཏེ་སྐུ་དེ་དག་ཀྱང་མི་ཚེ་བ།",
    "བཞུགས་ཚུལ་དང་།",
    "ཞེས་པས་ཁྲོ་བོའི་རྣམ་པར་ཤར་བའི་ཚེ།",
    "མཚོན་ཆའི་རྣམ་པར་ཟུག་པའི་ཟེར་གྱིས་འཇིག་པ་སྟེ།",
    "སྐུ་ཡིས་སྣང་བས་སྐྲག་པར་བྱེད།",
    "ད་ལྟ་ངོ་མ་འཕྲོད་ན་སྒོམ་སྒྲུབ་ཇི་ཙམ་བྱས་ཀྱང་སངས་མི་རྒྱའོ།"
  ]
