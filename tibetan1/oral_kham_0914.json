    "ཁྱེད་ཀྱིས་འདིའི་སྔོན་ལ་མི་ཞིག་ལ་ཁ་བརྡ་བྱེད་བཞིན་འདུག་ངས་ཐེངས་མ་ཁ་ཤས་ཤིག་ལ་ཁ་པར་བཏང་བ་ཡིན།",
    "ཁྱེད་ཀྱིས་ང་ལ་ཉོས་པའི་ལེགས་སྐྱེས་དེ་ཚོ་དངོས་གནས་ཡག་པོ་འདུག་ཐུགས་རྗེ་ཆེ།",
    "ངས་སྒུག་ནས་འདུག་བརྒྱ་དང་ཉེར་བདུན།",
    "ང་རང་རྨོན་ངྒོ་ནས་ཡོང་བ་ཡིན།",
    "ཨ་ཅག་དེས་ཁོ་རང་ལ་གང་ཐུབ་ཅི་ཐུབ་ཀྱིས་རོགས་བྱེད་རྒྱུར་ཁས་ལེན་བྱས་པ་མ་ཟད།",
    "བློ་བཟང་དང་ཀུན་དགའ་གཉིས་ཀྱིས་ཁོ་གཉིས་ཀྱི་ཁང་ཆུང་དེ་ཡི་འགྲམ་ནས་བག་ལེབ་བཟོ་སའི་ཐབ་ཁ་ཞིག་དང་རང་གཉིས་ལ་ཁ་ལག་བཟོ་སའི་ཐབ་ཆུང་ཞིག་བཅས་བཟོས་ཚར་རྗེས།",
    "འུ་གཉིས་ལ་དགོས་པའི་ཅ་དངོས་ཁ་ཤས་ཤིག་ཀྱང་འདུག་དེ་དག་ལ་ཡང་སྐད་ཆ་ཞིག་དྲིས་ཏེ་འོང་།",
    "རྩིས་རྒྱག་པ་སོགས་ལ་ཡང་དཀའ་ངལ་མི་འདུག་འུ་གཉིས་ཀྱི་ཧིན་སྒོར་ཁྲི་གཅིག་ཡོད་པ་དེ་ངས་ཨ་ཅག་ལ་དེ་ལ་བཅོལ་ནས་བཞག་ཡོད།",
    "ཡོད་ན་ཁོ་རང་ནི་བག་ལེབ་བཟོ་མཁན་ཡིན་པ་དང་།",
    "ཁ་སྣོན་གཅིག་གཉིས་ཤིག་སྤྲད་ན་ག་འདྲ་འདུག་ཟེར་ནས་དྲིས་དུས།",
    "དེས་ན་ཉེ་ཁོར་གྱི་ཡུལ་མིའི་ཆེད་དུ་བྲིས་པ་མིན་འགྲོདེ་ཡིན་ན་ཧིན་རྡུ་མི་འབྲི་བར་དབྱིན་ཡིག་འབྲི་དོན་གང་ཡིན་ནམ།",
    "ངས་འདི་ནས་འུ་གཉིས་ལ་ཕྱེད་ཀ་ཕྱེད་ཀ་བཟོས་ན་ག་འདྲ་འདུག་ཟེར་ནས་དྲིས་པར།",
    "ཁོ་རང་དངོས་གནས་མི་ཡག་པོ་ཞིག་ཡོད།",
    "ཕ་མ་གཉིས་རྒྱ་གར་ནས་འདུག་རྩིས་ཡོད་རབས་སོགས་མི་ཉུང་བ་ཞིག་ཁ་བརྡ་བྱས།",
    "སང་ཉིན་ཁྱེད་རང་རྒྱ་གར་གྲོང་བརྡལ་དུ་འགྲོ་རྒྱུ་ཡིན་ནམ།",
    "ང་རང་ལ་རོགས་རམ་ཡང་མི་ཉུང་བ་ཞིག་བྱེད་མྱོང་ཡོད།",
    "དེ་མིན་དམིགས་བསལ་གྱིས་དོགས་པ་གང་ཡང་བྱེད་ཀྱི་མི་འདུག་ལ།",
    "ད་ལྟ་ཆུང་དྲགས་པས་སློབ་ཐུབ་ཀྱི་མི་འདུག་རྗེས་མ་ག་ལེར་བྱས་ནས་སློབ་འདོད་ཡོད།",
    "ནམ་ཞིག་ང་ཡང་ཁྱེད་རང་ཡོད་སའི་ཕྱི་རྒྱལ་དེ་རུ་སླེབས་ཐུབ་པ་ཡིན་ན།",
    "ང་རང་ལྟ་བུ་ཞིག་ཁྱེད་རང་ལ་འཚམ་པོ་མེད་པ་དང་།",
    "ད་ནངས་ཞོགས་པ་ཁྱེད་རང་ལ་ཁ་པར་ཐེངས་མང་བོ་ཞིག་བརྒྱབ་ཀྱང་།",
    "ཁ་པར་གཏན་ནས་ལེན་གྱི་མི་འདུག་དེ་ནས་ངེད་གཉིས་ཁྱེད་རང་ཡོད་སར་སྐད་ཆ་འདྲི་རུ་ཡོང་བ་ཡིན།",
    "ཁོ་རང་བུ་གཅིག་པོ་ཡིན་དུས།",
    "ཁོ་རང་བྲེལ་བ་ཆེ་སྒང་ཡིན་སྟབས།",
    "ང་རང་ཡང་ལས་ཀ་ཞིག་ཡོད་དུས།",
    "མི་འགྲོ་ན་ང་དེར་འགྲོ་འདོད་འདུག་ཁྱེད་འགྲོ་ཡི་ཡིན་ན།",
    "གང་དགའ་གང་སྐྱིད་བྱས་དང་ངས་ཁྱེད་རང་ལ་ལམ་ཁ་ཕྱེ་ཡོད།",
    "ཁྱེད་རང་ཡོང་རྒྱུ་ཡིན་ན།",
    "ད་དུང་ནམ་ལངས་རྒྱུར་ཆུ་ཚོད་ཁ་ཤས་ཤིག་འདུག་སྟབས།",
    "རང་རང་ས་ནས་ཁ་རོག་འགྲོ་དུས་སུ།",
    "ཁྱེད་རང་ག་དུས་འདིར་སླེབས་པ་ཡིན།",
    "འདིར་སླེབས་ནས་ཉི་མ་ཁ་ཤས་ཤིག་འགྲོ་བཞིན་འདུག་ད་ལྟ་གང་དུ་བསྡད་ཡོད།",
    "ཁོས་ཀྱང་གཞི་ནས་ཁོ་རང་ལ་ཡང་ལུས་འབྲེལ་གྱི་གོ་སྐབས་ཤིག་ཐོབ་པ་ཤེས་ཀྱང་།",
    "ངས་གོ་ཐོས་ཡིན་ན་ཁྱེད་རང་ཕ་ཡུལ་དུ་འགྲོ་རྒྱུ་ཡིན་ཟེར་གྱི་འདུག་ཟེར།",
    "སང་ཉིན་ང་རང་ཁྱེད་མ་བུ་གཉིས་སྐྱེལ་དུ་ཡོང་།",
    "ང་རང་ཕྱིར་ཕྱི་རྒྱལ་དུ་སླེབས་ཡོད།",
    "ད་ང་རང་ལ་སེམས་ཐག་མི་ཆོད་སའི་དོན་དག་གང་།",
    "དོན་དག་དེ་འདྲ་མི་བྱུང་བར་ངས་ཁྱེད་རང་ལ་ཡིད་ཆེས་བྱེད་རྒྱུ་ཡིན།",
    "ཁོ་རང་ལ་དགོས་མཁོ་ཡོད་པའི་གྱོན་ཆས་སོགས་ལ་ཡང་དོ་སྣང་བྱེད་པའི་སྒང་ལ་བློ་བཟང་ལ་སྐད་ཆ་དྲིས་ཏེ།",
    "འུ་གཉིས་དགའ་རོགས་བྱས་ཏེ་འདུག་ཁྱེད་ངའི་རྒྱལ་ཁབ་ཏུ་ལྟ་སྐོར་ལ་འགྲོ་འདོད་འདུག་གམ།",
    "ཕུ་བོ་ང་རང་དེ་རིང་ཁྱེད་ལ་ཆེད་དུ་ཐུག་འཕྲད་བྱེད་དུ་ཡོང་བ་ཡིན་ལ།",
    "ཁོ་རང་ལ་གྱོན་པ་ཡང་མི་ཉུང་བ་ཞིག་གསར་དུ་ཉོས་པ་དང་།",
    "འུ་གཉིས་དོ་ནུབ་འདི་ནས་འདུག་ཐབས་ཤིག་ཡོང་སྲིད་བཅས་དྲ་ཁང་དུ་འཛུལ་རྩིས་བྱས་དུས།",
    "བློ་བཟང་རང་ཉིད་ཀྱི་ལག་པར་ཧིན་སྒོར་གཅིག་སྟོང་ལས་བརྒལ་བ་ཞིག་མ་གཏོགས་མེད་པ་ཡིན་དུས།",
    "ད་ལྟ་ང་རང་གནམ་གྲུའི་ནང་དུ་ཡོད།",
    "ཁོ་རང་ཆེས་དགའ་སའི་ཡུལ་དེ་དག་ལ་བརྩོན་ལེན་བྱེད་རྒྱུ་བཞག་ནས་རང་ཉིད་ཀྱི་ཆེས་མི་འདོད་པའི་ལམ་ཕྲན་དེར་ཞུགས་ཉིན་ནས།",
    "ཉིད་ཀྱི་ཟབ་གཏེར་རྣམ་གྲངས་མང་དུ་བཞུགས་པར་འདུག་ཀྱང་།",
    "སྔོན་ཆད་ཁྱེད་ལ་གྲུབ་ཐོབ་ཀྱི་མཚན་མི་འདུག།",
    "གཏེར་ཆེན་མཆོག་གྱུར་གླིང་པ་ལ་སོགས་པ་ཕྱིས་བྱོན་ཚད་ཐུབ་ཀྱི་གཏེར་ལུང་རྣམས་སུ་བེ་རོ་ཙ་ནའི་རྣམ་འཕྲུལ་དུ་ཡང་ནས་ཡང་དུ་ལུང་བསྟན་ཅིང་།",
    "ཐུགས་གཏད་ཕྱོགས་ལ་བླ་ཆེན་ཞིག་ལས་ཀྱང་ཐུགས་རྩིས་ཆེ་བར་འདུག་ཅིང་།",
    "མང་སོ་བའི་ཡང་གཏེར་འདི་སྐོར་གཏན་ནས་ཕབ་མ་གྲུ་བས་མི་བཞུགས་འདུག།",
    "༨ ཕྱི་མ་ཉི་ཟླ་ཀློང་གསལ་གྱི་དག་སྣང་འཇའ་ལུས་འོད་ཕུང་རང་གྲོལ་གྱི་གཞུང་ལྡེབ།",
    "ཞེ་དྲུག་དུས་སུ་ཤིན་ཏུ་འཕྲང་དམ་པས",
    "ད་དུང་དབུགས་རྔ་ནི་ཆད་ཐུབ་པ་མི་འདུག།",
    "གསང་བའི་བདག་པོ་དངོས་སྣང་ལོ་ཆེན་བེ་རོ་ཙ་ན་ཉིད་ཐུགས་རྗེ་ཡས་སྤྲུལ་གྱིས་བྱོན་པ་ཡིན་ཏེ།",
    "༣ བྱང་གཏེར་རིག་འཛིན་རྒོད་ཀྱི་ལྡེམ་འཕྲུ་ཅན་དངོས་གྲུབ་རྒྱལ་མཚན་གྱི་བཀའ་བརྒྱད་དྲག་པོ་རང་བྱུང་རང་ཤར་གྱི་བརྒྱུད་འདེབས་དང་སྔོན་འགྲོ་ལྡེབ།",
    "༨ ཟུར་མཁར་ཨ་ཇོ་དཔའ་བོ་དང་།",
    "༡༤ བཅས་འཇམ་མགོན་གསུང་རྣམས་སོ། ། གསུམ་པ་སློབ་དཔོན་ཆེན་པོ་བེ་རོ་ཙ་ནའི་བཀའ་སྲོལ་ལ།",
    "སྟོན་པ་ལོངས་སྤྱོད་རྫོགས་སྐུ་དང་འཁོར་རྒྱུད་གཞན་གྱིས་བསྡུས་པའི་ཕྱིར་ཕྱེད་སྣང་རང་བཞིན་སྤྲུལ་པ་ཞེས་ཉི་ཟླ་ཁ་སྦྱོར་ཆེན་པོའི་རྒྱུད་སོགས་ལས་གསལ་བ་བཞིན་ནོ།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན་རྣམས་ལ་བཀའ་བབས་པ་དག་གོ་༧།",
    "བཟོད་པར་མ་ནུས་བརྟན་གཡོའི་ཁམས་ཀྱང་རང་མཚན་འཛིན་པའི་མཐུ་སྨད་ནས།",
    "ཆོ་འཕྲུལ་རྩལ་དང་རང་སྣང་བའོ།",
    "པ་གོར་བེ་རོ་ཙ་ན།",
    "བཀའ་བརྒྱད་གསང་རྫོགས་དང་རང་ཤར་གཉིས་ཀ་ཞལ་མཐུན་པར་གསུངས་ཏེ།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "གཞན་ཡང་རིག་འཛིན་རྒོད་ཀྱི་ལྡེམ་ཕྲུ་ཅན་གྱི་བཀའ་བརྒྱད་རང་བྱུང་རང་ཤར་སོགས་གཏེར་ཁ་གཞན་ལས་ཀྱང་རྒྱ་ཆེར་བྱུང་ངོ།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན།",
    "གཡོན་ཕྱོགས་ནས་གླེགས་བམ་ཞིག་བླངས་ཏེ་བསྟན་པ་ཤེར་ཕྱིན་སྡུད་པའི་རྒྱ་དཔེར་འདུག།",
    "རྣམ་སྣང་སྤྲུལ་པའི་ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "འཇམ་དཔལ་ཁྲོས་པ་སྨིན་གཏེར་གཤིན་རྗེ་དྲེགས་འཇོམས་ཀྱི་སྒྲུབ་མཆོད་དང་འབྲེལ་བའི་ལོ་མཇུག་དུས་རིམ་ཆེ་ཆུང་།",
    "སློབ་དཔོན་འཇམ་དབྱངས་གྲགས་པའི་ཞལ་ནས་ཁྱེད་སློབ་དཔོན་འཇམ་དཔལ་བཤེས་གཉེན་གྱི་རྣམ་འཕྲུལ་དུ་སྣང་ཞིང་སྔོན་གསར་མ་ལ་མཁས་གྲགས་ཆེན་པོ་ཐོན་འདུག་ཀྱང་།",
    "༦ ཕྱི་མ་ཉི་ཟླ་ཀློང་གསལ་གྱི་དག་སྣང་འཇའ་ལུས་འོད་ཕུང་རང་གྲོལ་གྱི་རྩ་གཞུང་སྐོར་ལྡེབ།",
    "༡༣ བཅས་འཇམ་མགོན་གསུང་ཁྲིགས་རྣམས་སོ། གསུམ་པ་སློབ་དཔོན་ཆེན་པོ་བེ་རོ་ཙ་ནའི་བཀའ་སྲོལ་ལ།",
    "༣ འདིར་མཛད་པ་པོ་དངོས་སུ་མ་སྨྲོས་པ་རྣམས་གཏེར་གཞུང་རང་ཡིན་ནོ།",
    "རྒྱན་དྲུག་རྗེས་འབྲངས་དང་བཅས་པའི་གཞུང་བཟང་པོ་སྔ་འགྱུར་འདི་ཙམ་གདའ་བས།",
    "ཁ་ན་མ་ཐོ་བ་མེད་པའི་གནས་། ན་འདུག་མ།",
    "འདུག་པའི་ཚེའང་བྲམ་ཟེ་དང་།",
    "བདེན་པའི་བྱིན་གྱི་རླབས་དེས་རིའི་རྒྱལ་པོ་རི་རབ་འདི་ནམ་མཁའ་བར་སྣང་དེ་ཉིད་དུ་འདུག་ཅིག་ཅེས་སྨྲས་པ་དང་།",
    "དེ་ནས་རིའི་རྒྱལ་པོ་རི་རབ་དེ་ནམ་མཁའ་བར་སྣང་དེ་ཉིད་དུ་འདུག་གོ།",
    "ཀ་པ་གཅིག་པའི་ཁང་བཟང་ཞིག་ལ་འདུག་ས་བྕུའམ།",
    "མི་ལ་ལ་ཞིག་རྒྱལ་པོའི་སྟན་ལ་འདུག་ན།",
    "མ་མའི་པང་པ་ན་འདུག་པ།",
    "ཀུན་ནས་རབ་ཏུ་མཛེས་པར་འདུག་ལོང་བ་རྣམས་ཀྱིས་མིག་ཀྱང་ཐོབ།",
    "ལྷ་དང་ལྷ་མིན་འགྲོ་བ་རྣམས་ནི་འདིར་བརླག་གོ་རྒྱལ་བས་བདུད་རྩི་འདུས་མ་བྱས་པ་བརྙེས་སྙམ་དུ།",
    "ཨཱརྱ་ཏ་ཐཱ་ག་ཏ་གུ་ཎ་ཛྙཱ་ན་ཨ་ཙིན་ཏྱ་བི་ཥ་ཡ་ཨ་བ་ཏཱ་ར་ནི་རྡེ་ཤ་ནཱ་མ་མ་ཧཱ་ཡཱ་ན་སཱུ་ཏྲ།",
    "སེང་གེའི་ཁྲི་ལ་། བཞུགས་པ་གདའ།",
    "གཞན་མུར་འདུག་དང་།",
    "མེད་པ་མ་ཡིན་པའི་མིང་དང་གཅིག་མ་ཡིན་པའི་མིང་རྣམ་པ་ཐམས་ཅད་མ་ཡིན་པའི་མིང་རང་བཞིན་གྱིས་བརྗོད་དུ་མེད་པའོ།",
    "དེའི་ཚེ་ན་མཆོད་སྦྱིན་གྱི་གནས་དེར་བྲམ་ཟེ་དུམ་བུ་བྱིན་ཞེས་བྱ་བ་ཞིག་རྒན་གྲལ་དུ་འདུག་སྟེ་མཆོད་སྦྱིན་བྱེད་དོ།",
    "པདྨ་ཨུཏྤལ་གཡོ་བའི་མིག་ཆུ་སྐྱེས་ཐོགས་ཤིང་སྒོ་ན་འདུག་དེ་ཡིས་བྲམ་ཟེའི་ཁྱེའུ་མཐོང་ནས།",
    "དེ་ནས་བྲམ་ཟེའི་ཁྱེའུ་སྤྲིན་གྱིས་པགས་པ་བླངས་ནས་ལམ་ལས་བཟུར་ཏེ་ལམ་གོལ་བར་འདུག་ནས་བདེན་པའི་ཚིག་འདི་བྱས་སོ།",
    "དེའི་ཚེ་དེའི་དུས་ན་བྲམ་ཟེ་དུམ་བུ་བྱིན་ཞེས་བྱ་བར་གྱུར་པ་གང་རྒན་གྲལ་དུ་འདུག་སྟེ་སྦྱིན་སྲེག་བྱེད་པ་དེ་གཞན་ཞིག་ཡིན་སྙམ་དུ་སོམ་ཉི་འམ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་གོ་དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་མཁྱེན་བཞིན་དུ་བྱིས་པ་དེ་དག་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔ་ན་འདུག་པར་གྱུར་ཏེ་དེའི་ཤར་ཕྱོགས་ཀྱི་ངོས་སུ་ནི་གསེར་གྱི་ཀ་བ་བརྒྱད་ཁྲི་བཞི་སྟོང་ཟུག་པར་གྱུར།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་མགོ་བོས་ཕྱག་བཙལ་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ་ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་རབ་འབྱོར་གྱིས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཤོས་གསོལ་བ་དེ་ལྟར་ཡང་གདའ་ལ་ཁོང་དུ་ཆུད་པའང་མི་མངའ་སྟེ།",
    "ལ་ལར་ནི་ཟན་ཟ་ཞིང་འདུག་པ་ཙམ།",
    "དུས་ཚོད་ནི་ཇི་ཙམ་དུ་གདའ།",
    "ཇི་ལྟར་འོད་སྲུང་སྟེང་ན་འདུག་པ་ལྟར།",
    "འདུག་པ་དང་།",
    "དེ་དག་ཕན་ཚུན་འགྲན་པས་རང་རང་བརྒྱན་པར་བྱེད་དེ།",
    "འདུག་ནས་ཀྱང་སྐྱེ་བོ་ཕལ་པོ་དེ་དག་ལ་ཚིགས་སུ་བཅད་དེ་སྨྲས་པ།",
    "རྒྱ་མཚོ་མི་གཡོ་དགུང་ཟླ་ལྷུང་ཡང་གདའ།",
    "ཞུགས་ནི་ཆབ་གྱུར་ཆབ་ནི་ཞུགས་གྱུར་གདའ།",
    "གསེར་མ་ཞགས་པས་གཟུང་བར་རྡོ་ཐོགས་གདའ།",
    "གུས་པ་དང་བཅས་པས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་གོ།",
    "ལྷ་ངེར་འདུག་པའི་ཤིང་དེའི་མིང་ཅི་ཞེས་བྱ།",
