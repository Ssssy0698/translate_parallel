    "སོ་སོར་རྟོག་དང་རང་བཞིན་ཉིད་སྟོབས་ལས།",
    "བུ་སྨད་དང་འགྲོགས་ཙ་ན་སྲེད་པ་དང་བྲལ་བས་དགའ་བ་དང་མི་དགའ་བ་དང་བྲལ་བ་དང་།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ངེས་པ་དང་།",
    "དེ་བཞིན་དུ་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ས་སྤང་བ་དང་།",
    "ཡང་རང་བཞིན་བཅུ་སྟེ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ཡིད་ལ་བྱེད་པ་ཐམས་ཅད་དང་རྙེད་པ་དང་བཀུར་སྟི་དང་གྲགས་པ་ལ་དགའ་བ་ཐམས་ཅད་དང་།",
    "མིང་དེའང་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་ཞིང་རང་བཞིན་གྱིས་གཡོ་བ་མེད་པ་སྟེ།",
    "སྒྲུབ་ཅིང་འདུག་པ་ན་ཁྱིམ་ལ་ལྟ་བ་མེད་པའོ།",
    "གང་རང་བཞིན་གྱིས་སྟོང་པ་དེ་གདགས་སུ་མེད་པའོ།",
    "དེའི་ཕྱིར་བློ་དེའི་ཡུལ་དང་རང་གཞན་མཐའ་དག་ནི་འཁྲུལ་ངོར་བདེན་པར་ཟད་པས་ན་བློ་ནི་ཀུན་རྫོབ་ཡིན་པར་བརྗོད་ཅེས་གསུངས་པ་སྟེ།",
    "བློས་མ་བཞག་པར་གྲུབ་པ་དང་རང་མ་གྲུབ་བཞིན་དུ་བློས་བཞག་པ་ཙམ་དག་ཕན་ཚུན་རྣམ་པར་གཅོད་པའི་འགལ་བ་ལས་གཉིས་ཁོ་ནར་གྲུབ་ཅིང་གཞན་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "གསུངས་ཞེས་བྱ་བ་ནི་བདེན་པའི་དབྱེ་བ་འདིའང་རང་དགར་བཞག་པ་མ་ཡིན་གྱིས།",
    "ལྷོ་དང་ལྷ་མིན་འགྲོ་བ་རྣམས་ནི་འདིར་བརླག་གོ།",
    "བསམ་དང་བྲལ་ཞིང་རང་བཞིན་སྟོང་།",
    "དེ་ནི་འཆག་འདུག་འགྲེང་ཞིང་གནས་པའི་ཚེ།",
    "ལེགས་སྤོང་རང་གཞན་དོན་ཀུན་མྱུར་བར་འགྲུབ།",
    "ས་ཆེན་པོའི་འབྲུ་ལྟར་ཉན་ཐོས་དང་རང་རྒྱལ་དམིགས་པ་ཅན་ཐམས་ཅད་ཀྱིས་ཟག་པ་མེད་པ་རྣམ་པར་གྲོལ་བའི་འབྲས་བུ་དང་།",
    "འདོད་ཆགས་ཞེ་སྡང་རང་བཞིན་སྟོང་པ་ཉིད།",
    "གཉིས་པ་ལྟར་ན་རིགས་པའི་ལམ་བཏང་བ་དང་རང་དགའ་སྨྲ་བ་སྟེ།",
    "འདིར་ཉམས་སུ་མྱོང་བའམ་རྣམ་པར་རྟོག་པ་ལའང་རུང་སྣང་བ་ཙམ་འགོག་ན་ནི་ཐམས་ཅད་དུའང་རང་རིག་པ་དང་གཞན་རིག་པའི་མངོན་སུམ་གྱིས་གནོད་པར་འགྱུར་བས་ན་སྣང་བ་ཙམ་ནི་གང་ཡང་དགག་བྱ་མ་ཡིན་གྱི།",
    "དེ་ལྟར་ན་བརྟགས་ཤིང་དཔྱད་ནས་འཇུག་པ་དང་མ་བརྟགས་པའི་ཚུལ་མི་མཐུན་པས་མི་སྣང་བར་བརྗོད་པ་ཡང་རང་དགར་ཟད་དེ།",
    "རང་ཉིད་གསལ་བ་ཙམ་མྱོང་རང་རིག་སྟེ།",
    "གཅིག་དང་དུ་མ་མེད་པ་དང་རང་བཞིན་མེད་པ་ཉིད་ཀྱང་བྱས་པ་དང་མི་རྟག་པ་ལྟར་ལྡོག་པ་ལ་བལྟོས་པའི་ཐ་དད་པ་བློའི་ཡུལ་དུ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཡང་རང་བཞིན་བདེན་པ་ལ་ནི་འགྱུར་མེད་ཀྱིས་ཁྱབ་ལ།",
    "གཞན་ཡང་རང་བཞིན་བྱས་མིན་བལྟོས་འགལ་ཕྱིར།",
    "རང་དང་གཞན་གྱིས་ཡང་དག་པར་ཡོད་པར་སྨྲས་པའི་དངོས་པོ་ཐམས་ཅད་ལའང་རང་ལ་སོགས་པ་ལས་སྐྱེ་བ་མེད་པས་སོ་ཞེས་ཁྱབ་བྱེད་མི་དམིགས་པའོ། ། འདིའི་མ་གྲུབ་པ་སྤོང་བ་ན།",
    "འོན་ཀྱང་རང་བཞིན་གྱིས་མེད་པ་དང་ཡོད་པ་ལ་ནི་རིམ་གྱིས་ཀྱང་ཡོད་པ་དང་མེད་པ་འགལ་བ་ཉིད་དོ་ དེས་ན་སློབ་དཔོན་གྱིས།",
    "དེས་ན་ནུས་པ་སོ་སོར་ངེས་པ་ཁས་བླངས་ཀྱང་རང་བཞིན་འགལ་བ་ནི་བྱ་བར་ནུས་མི་སྲིད་དེ།",
    "འཇུག་ཐོགས་པ་དང་རང་བཞིན་ཁྱད་པར་མེད་པའི་རྣམ་རྟོག་ཡིན་པའི་ཕྱིར།",
    "ཁྱད་པར་དུའང་རང་དང་གཞན་ལ་སྡུག་བསྔལ་གྱི་རྒྱུན་མི་ཉུང་བར་འཕེལ་བའི་རྒྱུ་ལོག་པའི་བསྟན་བཅོས་བྱེད་པ་དང་དེའི་རྗེས་སུ་འཇུག་པ་རྣམས་ལ་དེ་ལྟར་དེ་ཁོ་ན་མཆོག་གཏན་ལ་ཕེབ་པ།",
