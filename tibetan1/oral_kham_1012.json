    "ཕྲན་ཡར་ཙམ་སླེབས་དུས་མི་གཉིས་ཕྱི་རྗེས་ནས་རྒྱུགས་ཡོང་སྟེ་སྐད་འབོད་དང་ལག་གཡུག་བྱེད་འདུག་པར།",
    "རྒྱ་དམར་ནི་བསྟན་དགྲ་ངོ་མ་ཡིན་འདུག་བསམ་ཡིད་ཆེས་བྱུང་།",
    "དེ་ནས་རི་མགོར་འགྲིམ་སྟེ་ཇག་ཚོ་ཆུང་ཆུང་ཞིག་བྱུང་འདུག་རྒྱ་དམར་དམག་འཐབ་ཐེངས་གཉིས་པ་བྱེད་པའི་མགོ་དང་པོ་དེ་ཡིན།་",
    "ཐག་རིང་ཙམ་མི་འགྲོ་བ་ཅི་ཡིན་ཟེར་ནས་ངུ་ཡི་འདུག་ཟེར།",
    "དེ་འདྲའི་ཆ་རྐྱེན་གང་ཡང་མི་འདུག་རྩ་བའི་ས་ཆ་སྤངས་ལྗོངས་རྒྱ་ཆེ་བར་ནས་ནགས་ཚལ་སྟུག་པོས་བརྒྱན་པ།",
    "བོད་གཞུང་དམངས་མཉམ་སྦྲེལ་ཡག་པོ་ཞིག་བྱས་ཏེ་ལོ་འགའ་ཤས་རིང་རང་ས་རང་སྲུང་ཐུབ་པ་ཞིག་བྱུང་ན།",
    "ས་རུབ་རྗེས་ཡུལ་དམག་རང་རང་སོ་སོས་སྣང་བ་གང་ཤར་གྱིས་རྒྱ་རོ་རྣམས་ཀྱི་མེ་མདའ་དང་།",
    "སྡུག་བསྔལ་མི་འདོད་པ་གཅིག་གྱུར་ལོས་ཡིན།",
    "རྒྱ་དམག་གྲངས་༢ ལྷག་ཙམ་གྱི་རྒྱ་རོ་བདག་མེད་དུ་གཡུག་འདུག་པ་དང་།",
    "མདའ་ཡང་༡ སྐོར་ཡུལ་མི་ཚོས་ཐོབ་ལུགས་ཟེར་འདུག་པར།",
    "འགྲོ་བ་མིས་མི་སྲོག་ལ་འཚེ་བ་བྱེད་པའི་སྡིག་ལས་རྔམ་ཆེ་བ་དེ་འདྲ་རང་གཞན་གཉིས་ངལ་འདི་ཕྱི་འཕྲལ་ཡུན་དུ་དཀའ་ངལ་མང་པོའི་ནང་ལྷུང་ངེས་པས་ཞེས་འཁོད་འདུག་ཟེར།",
    "ཁྱེད་རང་ཇག་པ་གནང་ལོན་གྱིས།",
    "དེ་ནས་ཕར་ཙམ་འབྲེལ་བ་བྱེད་ཐུབ་ན་རྒྱ་གར་དང་།",
    "རྒྱལ་ཁབ་དེ་དག་ནས་ཀྱང་དོ་སྣང་ཙམ་མེད་པ་ཡིན་བཟོ་མི་འདུག་དེ་དག་ལ་རྒྱབ་རྟེན་ཞིག་འཚོལ་ཐུབ་ན།",
    "ཁོང་རང་ནས་རྒྱ་དམར་ལ་དངོས་སུ་ངོ་རྒོལ་བྱ་རྒྱུའི་དགོངས་པ་ཐག་ཉེ་རུ་ཕྱིན་པའི་རྣམ་འགྱུར་ཐོན་འདུག་པ་དང་།",
    "མུ་མཐུད་འཁྲུག་སྟེ་སྔ་རྗེས་སུ་རྒྱ་དམག་༦ མ་ཟིན་ཙམ་བསད་འདུག་ཟེར་བ་བྱུང་ཡང་།",
    "ཚེ་ཕུན་གཙོས་མི་གྲངས་༣༧ བསད་ཤོར་འདུག་ཉིན་གྲངས་ཁ་ཤས་རྗེས་སུ།",
    "སུ་ཡུལ་དམག་ཐོག་དམག་སྣ་དྲངས་ནས་མདུན་མཆོང་རྒྱག་མཁན་དཔའ་ངར་ཆེ་བའི་མི་དེ་ཨ་ངག་ཐོག་ཚུར་ཤོར་འདུག་མེ་མདེའུ་ལྔ་བསྟུད་མར་བརྒྱབ་ཀྱང་།",
    "རྒྱ་དམག་ཀྱང་ཕོན་ཆེན་དཀར་མཛེས་ཕྱོགས་སུ་ཕྱིར་ལོག་བྱས་འདུག་དེ་ནས་ཕྱི་ལོ་༡༩༥༨ བོད་ས་ཁྱི་ལོའི་ཟླ་དང་པོའི་ནང་ནམ་ཟླ་ཞན་པའི་སྐབས་ཡིན་ཀྱང་།",
    "མདེའུ་དོ་གྲངས་༤༤ བཅས་ཐོབ་ནས་རི་མགོ་ཁག་ལ་ཡོད་པ་རྣམས་ཀྱིས་བགོ་བཤའ་བྱས་འདུག་འོན་ཀྱང་མཐའ་མ་དེར་གནམ་སའི་དྲག་མཚོན་ཆར་བཞིན་འབབ་པའི་འོག་ནས་ཡུལ་དམག་དང་།",
    "འདུག་མེ་མདའ་དང་མདེའུ།",
    "ནང་ཆེན་གྱི་ས་མཚམས་འཇམ་ཆུ་ཁ་བར་ཤར་བསྐྱོད་བྱས་འདུག་ཡང་ཉིན་གཅིག་ལ་དགེ་སྨད་ཕུར་པ་དང་།",
    "ཧོར་ཚོ་སོ་དགུའི་ཁོངས་བཅས་སུ་འབྲེལ་བ་ཡག་པོ་དགོས་སྟབས་ཁྱེད་རང་སྔོན་བསྐྱོད་བྱ་གལ་ཐོག་ལྷ་ལྡན་རྒྱལ་ཁབ་ཕྱོགས་ཀྱི་ཁམས་རིགས་ཚོས་ཇི་བྱེད།",
    "སེམས་ལའང་སྐྲག་འཚབ་སྐྱེས་འདུག་ཀྱང་བྱ་ཐབས་ནི་ཟད།",
    "ཟུར་དེར་ཆུ་ཡང་འདུག་པར་སེམས་དགའ་ཡ་ལེ་བའི་ངང་ནས་ཞོགས་ཇ་ཞིག་བཀོལ་ནས་བཏུང་།",
    "འཇམ་དབྱངས་རྡོ་རྗེ་ཅན་བདེ་འབྱོར་བྱུང་འདུག་པ་དང་།",
    "ཇོ་བོ་ལོཀེ་ཤྭ་རའི་མདུན་བཅས་སོ་སོར་གསེར་ཀོང་གསར་བཞེངས་འབུལ་བཤམས་ཀྱིས་མཛད་སྒོ་ཁག་བཅས་ལེགས་གྲུབ་ཟིན་ཐོག་ཚང་མ་ཚ་ཚ་འུར་འུར་དུ་ཡོད་པ་ལྟ་བུ་དང་རུག་རུག་འདུས་འདུས་ཤ་སྟག་བྱེད་འདུག་ཕྲན་ངོ་ལྟོས་ཚང་མས་ཇོ་ཤཱཀ་རྣམ་གསུམ་ལ་གསེར་ཕུལ་བ་དང་།",
    "ཆབ་བདག་བཅས་སྔར་བཞིན་འདུག་ཅིང་།",
    "ཆང་གཞས་གཏོང་བ་སོགས་ཅི་ཡང་བྱེད་ཀྱི་འདུག་ཅིང་།",
    "དགའ་བའི་རྣམ་འགྱུར་ཚོད་མེད་ཀྱི་སྒོ་ནས་ང་རང་ནས་ཁྱེད་ཀྱི་དངུལ་སྐྱིན་སྤྱད་དུ་ཡོང་བ་ཡིན།",
    "ཐེངས་གསུམ་ཡོང་བ་ཡིན་ཀྱང་ཐུག་མ་བྱུང་འབུལ་ས་རྙེད་པ་མི་འདུག་བསམ་ནས་སེམས་ཁྲལ་ཕྲན་བུ་བྱུང་ཞེས་སོགས་ཟེར་བས་རང་ཉིད་སེམས་དགའ་ལྷོད་གཉིས་ཀར་གྱུར་པ་དང་།",
    "ཁོ་རང་གདོང་གཤིས་འགྱུར་ཏེ་ང་དམག་ཁོངས་སུ་མི་ཞུགས་ཀ་མེད་བྱུང་ཡང་སེམས་ལ་འགྱུར་བ་གཏན་ནས་མེད་ཟེར་བྱུང་།",
    "ད་ཁྱེད་རང་སེམས་སྐྱིད་པོ་གྱིས།",
    "མཁའ་འགྲོ་གཡང་དགའ་ཟེར་བའི་གཡོག་པོ་མི་གཉིས་བཅས་དང་དོས་རྒྱབ་༢ སྐོར་ཡོད་པ་རི་བོ་ཆེར་ཕྱིར་བསྐྱོད་བྱེད་ཀྱི་འདུག་པ་དེ་ཚོའི་མཉམ་དུ་སྐད་ཆ་བྱས་ཏེ་ནག་ཆུ་ནས་སོག་ཙན་དན་དགོན་བར་བདལ་ཁལ་གླས་ཏེ་ཤར་རྒྱག་ཕྱིན་པ་ཡིན།",
    "དེ་ཚོ་ལོས་ཡིན་གང་དྲག་བྱེད་ཆོག་ཚང་མ་གཅིག་གྱུར་ཡིན་པ་ནི་བརྗོད་མ་དགོས།",
    "ང་རང་བོད་རིགས་ཤིག་ཡིན་སྟབས་བོད་རིགས་ལ་དགའ་བ་དང་།",
    "མི་ལ་ན་ཤི་ཡོང་བཟོ་མི་འདུག་སྟེ།",
    "བུ་འཛུམ་དཔོན་བཅས་ལ་འབྲེལ་ལམ་ཐུབ་འདུག།",
    "ལམ་འགྲོ་ཆེ་བས་མང་པོ་ཟས་མ་ཐུབ་པ་ཡིན་འདུག་རྗེས་སུ་ངོས་ཀྱི་གནས་སྟངས་ཆ་ཚང་ཤེས་པ།",
    "མགྱོགས་པོར་ཤོག་ཅེས་འཁོད་འདུག་ད་དུང་ཡིག་དོན་ཁག་ཁ་ཤས་ཤིག་དེ་དུས་ནས་དྲན་མི་གསལ་ཀློག་ཚོར་བ་དང་སྔར་རྒྱུན་ཤོག་ཆག་བརྒྱབ་སྟེ་མདུན་ལྕོག་སྒང་དེར་བཞག་པ་ཡིན།",
    "དེ་མིན་འགྲོ་ཐབས་མེད།",
    "རྩ་བའི་ཛ་དྲག་ཆེ་བའི་སྐབས་སུ་རྨི་ལམ་བལྟས་ནས་འགྲོ་འདུག་བྱ་དགོས་ཆགས་པ་དོན་ཐོག་ཏུ་འཁེལ་བ་ཡང་མང་པོ་ཡོད།",
    "བཀྲ་གཅེས་གསུམ་ཀ་ངོ་ཤེས་ཀྱི་འདུག་ཅིང་།",
    "ཁོ་རང་སྐོར་མི་རྟ་གོ་ཧྲག་རྣམས་རི་མགོ་ཁག་ལ་འཇབ་སྟེ་རྒྱ་དམག་ཐོག་དགྲ་ཤོག་རྒྱག་བྱེད་མུར།",
    "གྲི་མདུང་རིགས་བསྡུ་འབུལ་བྱ་དགོས་ཞེས་རྒྱ་དམར་གྱིས་ལས་འགོ་བཙུགས་འདུག་དེ་སྐབས་སུ་དཔོན་རུ་སྨད་མའི་དཔོན་གྲགས་པ་རྣམ་རྒྱལ་བུ་སྤུན་དང་།",
    "སྦག་སྦག་བཅས་མང་པོ་ཐོབ་ཡོད་འདུག་ཅིང་།",
    "མཐར་འཕྲོས་རྣམས་བྲོས་ཐར་ཙམ་བྱུང་འདུག།",
    "རྨས་སྐྱོན་བྱུང་བ་མང་པོ་འདུག་ཟེར།",
    "འཕྲོས་རྒྱ་དམག་བཞི་བཅུ་ནས་ལྔ་བཅུ་ཡས་མས་ལས་ལྷག་མི་འདུག་ཟེར་བ་བྱུང་ཡང་།",
    "མཐའ་གཅིག་ཏུ་གྲངས་ཚད་གཏན་འཁེལ་མི་ཐུབ་པར་ཚོད་དཔག་བྱས་པ་ལོས་ཡིན་ཀྱང་།",
    "རྒྱ་བོད་གཉིས་ཀྱི་མི་རོ་བདག་མེད་ཀྱིས་ཡུལ་ལུང་ཁེངས་འདུག་ཟེར་ཆོག་པ་དང་།",
    "ཁོ་རང་བྲག་རྡོའི་བར་གསེང་དུ་དེ་མུར་སྐྱོན་མེད་དུ་ལྷགས།",
    "རིམ་བཞིན་ལྕགས་ར་དཔལ་འབར་ཕྱོགས་སུ་མཐའ་མར་སླེབས་འདུག་པ་ལས།",
    "འུ་ཐུག་དུས་གྲོད་ཁོག་སྟོང་པ་ཆགས་སྟབས།",
    "རྟ་ཞོན་པ་ལས་རྐང་ཐང་དུ་བསྐྱོད་ན་དགའ་བ་འདུག་དེ་འདྲར་བྱས་ཏེ་ཉིན་མང་ཕྱིན།",
    "ཉིན་གྲངས་༡༧ འགོར་འདུག་དེབ་ལྔ་པ།་",
    "ག་དུས་ཡིན་ནའང་ཁོ་རང་བོད་མི་ཇག་པ་ཡོད་ས་ཞིག་ཏུ་སྐྱེལ་རོགས་བྱ་ཐབས་ཟེར་བ་དང་།",
    "ཁོ་རང་ཕ་ཡུལ་ནས་ཕ་མ་ཕྱུག་པོའི་བུ་ཕྲུག་ཡིན་པ་དང་།",
    "རྒྱ་དམག་བརྒྱ་ཕྲག་བརྒལ་བ་བསད་ཡོད་འདུག་ཅིང་།",
    "སྦག་སྦག་བཅས་སྣེ་འཛོམས་ལྟ་བུ་ཐོབ་ཡོད་འདུག་ཀྱང་།",
    "རྒྱུ་དངོས་རྟ་ཟོག་ཀྱང་མང་ཙམ་ཤོར་འདུག་ཅིང་།",
    "ལག་འབོམ་བཅས་གྲངས་མང་ཐོབ་འདུག་དེ་སྐབས་ལམ་འགྲོ་ཆེ་ཤོས་ཤིག་ལ་འཇུ་ཆུང་བུ་སྲི་ཐར་དགྲ་འདུལ་དང་།",
    "ས་ཡུལ་རྒྱུས་སྟོན་མཐུན་འགྱུར་གང་དགོས་ལྷོད་མེད་བྱས་འདུག་ཅིང་།",
    "ད་ནི་བསམ་བློ་ཇི་ལྟར་བཏང་ཡང་དཀའ་ངལ་རང་འཕྲད་ཀྱི་འདུག་རྒྱ་རྟ་ཁ་ཤས་དང་།",
    "ཁོང་རྣམ་པ་ཕན་ཚུན་གཉིས་ཀས་བསམ་བློ་གསར་པ་གཏོང་དགོས་ངེས་ཡིན་པ་ཁས་ལེན་གྱི་འདུག་ལྷག་པར་དུ་སྟག་ཕྲུག་དཔོན་རྒན་ནི་དགོངས་པ་རྒྱ་ཆེ་བཞེས་མཁན་ཞིག་དང་།",
    "རྒྱ་དམར་གྱིས་དོགས་པ་བྱེད་ཀྱི་ཡོད་ཚོད་འདུག་ཟེར།",
    "རྒྱ་གར་དུ་འགྲོ་བའི་མཐུན་རྐྱེན་ཚང་ཐུབ་པ་ཁག་པོ་བྱེད་འདུག་མར་ཡོད་པ་རྣམས་ཕྱིར་བཙོང་གང་ཐུབ་ཀྱིས་མེ་མདའ་དང་།",
    "བྱ་ཆུང་དགེ་འཕན་གཉིས་ལས་དེ་མིན་ཚང་མ་ཤི་སྐྱོན་གྱུར་འདུག་ཁམས་འབྲི་ཆུ་ཤར་བརྒྱུད་ཀྱི་གནས་སྟངས་ཐུང་ཙམ་བཀོད་པ།",
    "རྫོགས་ཆེན་ཡིད་བཞིན་ནོར་བུ་མཆོག་ནས་ང་ཡིན་གསུངས་འདུག་ཀྱང་སྐུ་ལུས་གཡོན་གྱི་ནུ་མ་ཡོད་པའི་ཟུར་གྱི་རྩིབ་མའི་སྟེང་ནས་གྲི་རྨས་ཧ་ཅང་ཆེན་པོ་བྱས་ཚར་འདུག་བློ་ཕམ་ཤིན་ཏུ་ཆེ་བའི་ངང་ནས་གཟིམ་ཆུང་ནང་དུ་ཡོད་པའི་རྒྱ་དཔོན་༨ ཡོད་པ་ཚང་མར་གྲི་བཙུགས་ཏེ་བསད།",
    "རྒྱ་ཀོང་རྫིས་རྨིས་མནའ་མ་འགྲོ་སའི་འབྲོག་ཚང་ཉེ་སྐོར་བཅས་ཕ་ཁུ་བུ་ཚ་ཡོད་ཚད་ཁྱིམ་གཞིས་དང་བཅས་ཡུལ་བྱོལ་དུ་ཕྱིན་འདུག་རྫོགས་ཆེན་དགོན་དུ་རྒྱ་ཀོང་འབག་ཐར་ཟེར་བ་དེ་ན་ནས་འགྲོ་མ་ཐུབ་པར་གྲྭ་ཤག་ནང་དུ་གབ་སྟེ་བསྡད་འདུག་ཀྱང་།",
    "ཁོང་ལ་རྟ་འགྲོས་མ་ཧ་ལས་པ་གཉིས་འདུག་གྲ་བཞི་དམག་སྒར་གྱི་གཡས་ཟུར།",
    "སེ་རའི་མདུན་ཕྱོགས་དེར་ས་སྟོང་རྒྱ་ཆེ་ཡོད་པ་དེར་རྟ་འགྲོས་མ་འགྲོས་གཏོང་དུ་འགྲོ་བ་དང་ཆབས་ཅིག་མེ་མདའ་ཚ་ཁ་ཡང་ལྟ་ཡི་འདུག་པར།",
    "དེའི་སྐུ་མཆེད་ཡིན་འདུག་གནམ་རུའི་ཕྱོགས་སུ་ཡོང་ན་རོགས་པ་གང་དགོས་བྱེད་ཐུབ་པ་དང་།",
    "བྱེད་ཆོག་ཅེས་ཡང་ཡང་བརྗོད་འདུག་དེ་འདྲའི་མུ་ནས་བོད་ས་ཁྱི་ཟླ་༡༢ ཚེས་༢༩ དགུ་གཏོར་གྱི་འཆམ་དང་།",
    "ཉམ་དམའ་བའི་ཚོར་སྣང་རང་བཞིན་དུ་གྱུར།",
    "ཁྱེད་རྣམས་ཚང་མ་དེའི་གོང་དུ་མཚུར་ཕུར་འབྱོར་ངེས་བྱ་དགོས་ཞེས་ཕེབས་འདུག་ཕྲན་རྣམས་དེ་དོན་མཚུར་ཕུར་འགྲོ་རྒྱུའི་ཐག་བཅད་དེ་གྲ་སྒྲིག་བྱས།",
    "དེ་ནས་མི་ཚང་མས་ཕྲན་ལོ་ན་ཆུང་ཡང་འགོ་ཁྲིད་ཁྱེད་རང་ནས་བྱ་དགོས་ལུགས་ནན་བརྗོད་བྱེད་འདུག་ཅིང་།",
    "ཤར་སྒོའི་མདུན་དུ་ཁམས་རིགས་མང་དག་ཡོད་འདུག་ཅིང་།",
    "རྣམ་ཀུན་དམག་དཔོན་ཐན་ཀོན་སན་ཁོང་རང་བཅར་ན་མ་གཏོགས་དམའ་རིམ་བང་མིའི་ལན་ཕྲིན་འབྲེལ་ཡོད་བརྒྱུད་ནས་ཞུ་ཡི་ཡོད།",
    "དགོངས་བསྐོར་ཞུས་ཏེ་ཕྱི་ཟླ་༣ ཚེས་༡ ཉིན་ཆིབས་བསྒྱུར་གནང་རྒྱུའི་འཕྲིན་ལན་སྤྲད་འདུག་ཕྱི་ཚེས་༨ ཉིན་རྒྱ་མིའི་ལས་བྱེད་གཉིས་སྐུ་སྲུང་མདའ་དཔོན་སར་ཡོང་སྟེ་དམག་དཔོན་ཕུའུ་ཟེར་བ་ནས་ཁྱེད་རང་འབོད་འགུག་ཆེད་བཏང་ལུགས་གཅིག་རྗེས་གཉིས་མཐུད་དུ་བརྗོད་དེ་མཉམ་བསྐྱོད་བྱ་དགོས་བྱུང་བར།",
    "ཡང་གནས་ཚུལ་གཞན་ཞིག་ཀྱང་འདུག་པ་ནི།",
    "ཕྲན་གྱིས་ཀྱང་དེ་རང་ལོས་ཡིན་བསམ་པ་བྱུང་།",
    "རྡོ་རྗེ་དཀྲོག་དཀྲོག་ཟེར་བའི་ལྷ་ས་བཞུགས་ཁྲི་ཁ་ཟེར་སའི་ཕྱོགས་དེར་བསྐོར་སྲུང་དམག་སྒར་པུ་ལི་སི་གྱི་རྒྱབ་ཕྱོགས་དེར་ཚོང་ཁང་ཆེན་པོ་བཟུང་མཁན་གྱི་མི་ཞིག་ཡོད་པ་དེ་ནོར་གླིང་ལྷོ་སྒོའི་རྒྱབ་སྐུ་སྲུང་དམག་སྒར་གྱི་སྒོའི་འགྲམ་དེར་ཞོན་རྟ་ནག་པོ་ཞིག་ཉར་ནས་བསྡད་འདུག་པར།",
    "འོན་ཀྱང་གསར་པ་རྣམས་ལ་དོགས་གནས་ཡོད་སྟབས་རྙིང་པ་ཚོས་ངོས་ལེན་བྱེད་ཀྱི་མེད་པ་ཡིན་འདུག་ཟེར་མཁན་བྱུང་།",
    "དེར་བཅར་བས་གོས་ཆེན་སེར་པོ་གྱོན་པའི་བོད་ཀྱི་སྐུ་དྲག་གཉིས་བཞུགས་པའི་འགོ་མ་དེ་ལྷ་ཀླུ་ཡིན་འདུག་དེ་ནས་ཕྲན་གྱིས་དམག་སྤྱི་རྙིང་པའི་གྲས་མཁན་ཆུང་རྟ་ར་བས་བཀའ་མངགས་གནང་དོན་ཇི་བཞིན་ཞུས་པ་ཡིན།",
    "སྐབས་དེ་དུས་ཁོང་རྣམ་པ་ནོར་གླིང་ནས་ཕྱི་ལོག་ཏུ་ཕེབས་ཐུབ་པའི་དོན་དེ་མ་འགྲུབ་ན་འགྲིགས་ཐབས་མི་འདུག་པ་ལས།",
    "དེ་ནི་ཁོང་རྣམ་པ་འདྲ་མཉམ་ལས་ལྷ་ཀླུར་དམིགས་བསལ་གྱི་མཐོང་ཚུལ་མི་ཡོང་ཆེད་ཡིན་ཚོད་འདུག་ལམ་སེང་བསྐོར་བ་བརྒྱབ་སྟེ་གཞན་རྣམས་འཚོལ་དུ་ཕྱིན་པས།",
    "ཐོན་པ་མཁན་ཆུང་བྱམས་པ་མཁས་གྲུབ་ཞུ་བ་གཉིས་ཕེབས་ཀྱི་འདུག་ལམ་སེང་ཕྱིར་ཕེབས་གནང་རོགས་ཞུས་པར།",
    "ལོག་བྱེད་མཁན་མང་པོ་ཡོང་འདུག་པ་དང་།",
    "མི་ཡང་ཉུང་དུ་ཕྱིན་པར་བརྟེན་ཇི་འདྲ་ཞིག་ཡིན་བསམ་ནས་གོ་མཛོད་ཁང་པའི་སྦུག་ཏུ་ཕྱིན་པས་ཁང་པ་ཕྱི་ནང་གཉིས་འདུག་པ་སྟོང་པར་གྱུར།",
    "ངོས་རང་སྔ་པོར་དམག་སྤྱི་ཁང་དུ་བཅར་བས་སྔར་ལས་བྲེལ་འཚུབ་ཆེ་བ་ཞིག་བྱ་ཡི་འདུག་པར།",
    "ཤོད་མཁན་དང་པོ་དེ་མེད་ན་གཉིས་པ་དེར་ཡང་ཧ་ལས་པའི་ཁ་བདེ་པོ་དང་མགོ་འཚོས་པོ་འདུག།",
    "ཁྱེད་རང་རྣམས་ཀྱིས་འཁུར་བླངས་པའི་དོན་རྐྱེན་ཚང་མ་ངོས་འཛིན་ཡག་པོ་དང་།",
    "འདོད་བློ་ཚིམས་པར་ལོས་ཡིན་བསམ་པ་བྱུང་།",
    "མེ་ཤིན་ལྷན་ཁ་ཤས་ཤིག་ཤིང་སྒམ་ཁ་ཕྱེ་ནས་བརྟག་དཔྱད་བྱེད་ཀྱི་ཡོད་པ་ལྟ་བུ་བྱས་ཏེ་འདུག་དུས་ཚོད་ཛ་དྲག་འདི་འདྲའི་སྐབས་སུ་མི་ལ་ངོ་ཆེ་ཆུང་དང་།",
    "རང་སྲོག་འབེན་བཙུགས་དགོས་དོན་མི་འདུག་ཅེས་བརྗོད་པར།",
    "ལན་འདེབས་བྱེད་མཁན་སུ་ཡང་མི་འདུག་དེ་འདྲ་ཞིག་ནས་དཀར་མཛེས་པད་མ་རྣམ་རྒྱལེ་ཡང་དེར་སླེབས་ཏེ་ཁོང་ཡང་བློར་མི་བབས་པ་བྱུང་སྟེ་ཕྲན་ལ་ཁྱེད་རང་ལ་གང་དགོས་ཀྱི་ཡོད་ཟེར།",
    "ཁོང་རྣམས་ལ་རྟ་དང་མེ་མདའ་གཉིས་ཀ་འདུག་ཅིང་།",
    "རྩ་བའི་རང་ཁྱིམ་དང་བྲལ་བའི་མི་ཞེ་གཅིག་ཡིན་འདུག་དེ་ནས་ཉིན་གུང་རྒྱབ་ཙམ་དེར།",
    "དེ་མིན་ནོར་གླིང་ལྷོ་ཕྱོགས་ལྕགས་རི་བཙན་པོ་འདུག་སྟབས་ལམ་དེ་ནས་རྒྱ་དམག་འཛུལ་མི་ཤོར་བའི་ཡིད་ཆེས་བྱས་ཏེ་ཡོད།",
    "བཀོད་ཁྱབ་འདི་ཡིན་ཟེར་བ་ཡང་མི་འདུག་ཅིང་།",
    "རང་ཉིད་ཤི་ནའང་འགྱོད་པ་མེད་ཅེས་ཡང་ཡང་ཟེར་གྱི་འདུག་དེའི་རྗེས་ནོར་གླིང་དུ་མེ་སྒྱོགས་དང་པོ་འཕངས་ཡོང་དུས་ཁོ་རང་མི་རྟ་གཉིས་ཀ་སྐུ་སྲུང་དམག་སྒར་གྱི་རྒྱལ་སྒོའི་རྩ་དེར་བསད་འདུག་ཟེར།",
    "ཨ་ཙི་ཨ་ཙི།",
    "འདིར་བསྡད་པ་ལས་དེ་གར་ས་སྲུང་དུ་ཕྱིན་ན་གལ་ཆེ་བ་འདུག་སྙམ་སྟེ།",
    "ཞིབ་ཕྲར་བལྟས་པར་རྒྱ་དམག་གཅིག་ཁ་སྦུག་ཏུ་རིལ་བཞིན་འགུལ་ཙམ་འགུལ་ཙམ་བྱེད་ཀྱི་འདུག་ཕྲན་གྱིས་དེར་མེ་མདའ་ཞིག་བརྒྱབ་པས་དེ་མ་ཐག་འགུལ་བསྐྱོད་ཆེན་པོ་བྱས་བྱུང་།",
    "མདེའུ་བཅས་ཁུར་བའི་སྐབས་མེ་སྒྱོགས་རྒྱག་བཞིནཡོད་ནའང་ཤི་སྐྱོན་མ་བྱུང་ལུགས་རྗེས་སོར་ཤོད་ཀྱི་འདུག།",
    "འོན་ཀྱང་མུ་མཐུད་ནས་མི་རྣམས་ཆུ་འཕྱུར་བ་ལྟར་ཡོང་རྒྱུ་འདུག་སྟབས་གང་འཚམས་ནས་གཙང་ཆུའི་འགྲམ་དུ་མི་མང་པོ་སླེབས།",
    "རོགས་རྣམས་ཀྱིས་ཇ་དང་རྩམ་པ་བཟའ་ཆོག་ཏུ་སྒུག་ནས་རྟ་རྣམས་བཟུང་སྟེ་འདུག་པར།",
    "འཛིང་པ་འཇམ་དབྱངས་རྡོ་རྗེ་ཞེས་ལོ་ཆུང་ཞིག་ཡོད་པ་ཁོང་གཉིས་དེར་སྔོན་དུ་འབྱོར་འདུག་ཚང་མ་ཤི་གསོན་འཕྲད་པའི་སྤྲོ་སྣང་སྐྱེས།་",
    "བརྒྱ་དཔོན་བསྟན་པ་དར་རྒྱས་ཅན་གོང་ས་མཆོག་ཕེབས་སྐྱེལ་དུ་བཅར་འདུག་པ་དང་།",
    "དེ་གཉིས་སྒོ་ཕྱེས་ནས་མི་མང་ལ་བརྔོ་འཐག་བྱེད་དུ་བཅུག་ཇ་དང་མར་འཚོལ་སྒྲུབ་བྱ་ཡུལ་མི་འདུག་པར།",
    "དེ་དགོང་རང་སྐུ་ཆས་རྣམས་གཙང་པོ་ཕ་རིར་གྲུ་ཐོན་ཐུབ་པ་དང་།",
    "ཡར་བལྟ་ཕྱིར་བལྟ་བྱས་ཀྱང་སུ་ཡང་མི་འདུག་པར་དྲེལ་གཉིས་ཁྲིད་དེ་མགྱོགས་པོར་ཡོང་བར།",
    "ལང་གོང་ནས་བྲོས་ཚར་འདུག་དེ་ནས་ལུང་པའི་ཕུ་གམ་པ་ལ་འདབས་ནས་གྱེན་དུ་བྲོས།",
    "ཟ་རྒྱུ་ནི་གང་དུ་ཕྱིན་ཀྱང་རང་ཟས་ལྟ་བུ་བྱས་ཏེ་ཟ་བ་དང་།",
    "དེ་ནུབ་ས་རུབ་ཙམ་དུ་ཡར་འབྲོག་མཚོ་འགྲམ་དུ་གྲོང་པ་རྒྱ་ཆེ་ཙམ་ཞིག་འདུག་པ་དེར་འབྱོར་དུས།",
    "རྟ་རྣམས་ཡོད་སར་ཡང་མེ་སྒྱོགས་བརྒྱབ་འདུག་ཀྱང་སྐྱོན་ཆེ་བ་བྱས་མི་འདུག་རི་དྭགས་གླ་བ་འགའ་ཤས་སྒྱོགས་མདེལ་འབར་རྫས་ཀྱིས་བསད་པ་དང་།",
    "གུས་པ་རྒྱལ་རྩེ་དམག་ཤོག་ནས་འཇབ་སྒྲུག་བྱས་ཏེ་རྒྱ་དམག་ལ་རྒོལ་འཛིངས་ཤུགས་ཆེ་ཞུས་ཀྱང་ཡ་ངོ་མ་ལོན་ནས་དེ་ནུབ་དམག་མང་ཁ་འཐོར་གྱིས་མང་ཆེ་གྲི་གུ་ཐང་དུ་རིམ་འབྱོར་ཐུབ་ཅེས་བྲིས་པ་ལས་དངོས་ཡོད་བྲིས་མི་འདུག་དེར་བརྟེན་ཕྱི་ལོ་༡༩༨༨ ལོར་ཁོང་རང་མའི་སོར་བདེ་སྐྱིད་སླར་གསོའི་གཞིས་འགོ་དང་།",
    "ཁྱི་དགའ་ནས་ཁོ་རང་གྲོང་པའི་ནང་འཇོག་རོགས།",
    "རྒྱ་དམག་ནི་འབྱོར་མི་འདུག་ཀྱང་།",
    "ཐང་གཞུང་དེར་སྤུ་ཕྲུག་དམར་པོ་གྱོན་མཁན་གྱི་གྲྭ་སའི་རྡོབ་རྡོབ་ཅེས་པ་རྡོབ་སྐྲ་རིང་པོ་ཡོད་མཁན་ཞིག་གན་ཀྱལ་དུ་འགྲིལ་ཏེ་ཤི་འདུག་སྣ་ར་ཞིག་ཕྱི་རྒྱབ་ཏུ་གཡུག་པ་ལྟ་བུ་བྱས་འདུག་སྟབས་ཕལ་ཆེར་ནང་འཛིང་ཤོར་བ་མིན་ནམ་སྙམ།",
    "ཐུགས་ཁག་ཡེ་ནས་མི་འདུག་ཀྱང་།",
    "དེ་རྗེས་ཁོང་ཕེབས་རྒྱུ་རྩ་བ་ནས་མི་འདུག་ཅིང་།",
    "ཡག་ཉེས་གཉིས་ཀྱི་ས་མཚམས་ཡིན་ཟེར་འདུག་ཅེས་ལན་འཕྲིན་བསྐྱེལ་བྱུང་།",
    "དེ་འདྲ་ཞིག་ནས་འོད་གསལ་ཟེར་བ་ཞིག་ཡོད་པ་དེ་ལ་ཁོང་རང་སྒེར་གྱི་གླ་རྩི་རྟ་སྒོ་གཉིས་ཡོད་པ་འགེལ་དྲེལ་ཨ་འདོ་ཞིག་ལ་བཀལ་བ་དེ་རྟ་ཐོག་ནས་ཁྲིད་དེ་འགྲོ་ཡི་འདུག་ཁོ་དང་ཐུག་མ་ཐག་ལམ་ལྟག་དེབ་ལ་ཡ།",
    "ལམ་འོག་ཀྱང་ཞིང་ཁ་ཡིན་འདུག་པ་དང་།",
    "ཡར་ཙམ་དེ་ནས་ཐོ་ཤོབ་ཐོ་ཤོབ་ཅེས་པའི་སྒྲ་ཞིག་འདུག་དེར་ཕྱིན་པར།",
    "སྐབས་དེ་དུས་ཡོད་པའི་མི་ཞིག་སུད་སིར་གཞིས་ཆགས་སུ་ཡོད་འདུག་པར།",
    "བླ་བྲང་དེའི་ནང་མི་སུ་ཞིག་མི་འདུག་ཅིང་།",
    "སྒོ་རའི་ནང་གཡག་ཉི་ཤུ་སྐོར་ཞིག་འདུག་རྩམ་པ་རྩ་བ་ནས་མི་འདུག་ཀྱང་།",
    "ཕྱུ་ར་བཅས་འདུག་པ་བཟས།",
    "དངོས་ནོར་མང་པོ་འདུག་ཀྱང་ཅི་ཡང་ཁུར་དུ་བཅུག་མེད།",
    "དེ་དག་ནི་དམག་ལམ་དུ་འཁེལ་བའི་ཡུལ་མི་རྣམས་ཀྱི་རྒྱུ་ཟས་སྦས་སྐུང་བྱེད་མཁན་ཡིན་འདུག་དེ་ཕྱོགས་སུ་མི་སུ་ཞིག་ཡོང་མ་མྱོང་བ་ཡིན་ཚུལ་ཟེར།",
    "ད་དུང་རི་མགོ་མཐོན་པོར་ཡོད་འདུག་པར་རི་རྩེ་བར་དུ་ཕྱིན།",
    "གང་འཚམས་ནས་ཁོང་གཉིས་ཀྱིས་དྲེལ་གཉིས་ཀ་ཐོབ་འདུག་ཟེར་ནས་རྡོ་ལག་བརྒྱུད་ཀྱི་ལན་བརྡ་འཕྲོད་བྱུང་།",
    "མཚམས་འདིར་སྐུ་སྒེར་དྲུང་ཆེ་རྟ་ར་ལགས་ཀྱིས་རི་རྩེ་འདིར་མི་གྲངས་ག་ཚོད་ཡོད་པ་གྲངས་ཁ་གསལ་ན་ལེགས་ཞེས་མཆན་བུ་བཀོད་གནང་འདུག་པ་ལྟར།",
    "རི་ཁུག་དེ་ནས་ཕར་ཙམ་ཕྱིན་པས་ཉག་ཁ་ཞིག་ཏུ་སླེབས།",
    "ཐད་ཀྱི་རི་བོའི་གཡས་ངོས་གངས་རི་དཀར་རྐྱང་ཡིན་པའི་ལུང་པ་རིང་པོ་ཞིག་འདུག་པ།",
    "རྫ་རིའི་འདབས་ཀྱི་ཉེ་ཙམ་དུ་སྨྲ་ངོས་ཀྱི་འོབ་ལྟ་བུ་ཞིག་འདུག་པ་མཐོང་།",
    "ལག་འཛིང་བྱས་ནས་རྒྱ་མི་ཁ་ཤས་ཀྱང་བསད་འདུག་ཟེར།",
    "ཧོར་ཕྲུག་འཇམ་དབྱངས་ཚེ་རིང་ནས་ཕྱིང་ཤུབ་ནང་ཇ་སོབ་གང་འཚམས་ཤིག་རྟ་ཤད་བྱས་འདུག་པ་དེས་ཀྱང་ཕྲན་བུ་ཕན།",
    "རྟ་སྒ་གཡུག་ས་ཟུར་དུ་མེད་པས་འགྲོ་ལམ་འགག་ཐུབ་པ་སོགས་དེ་འདྲའི་ལམ་བགྲོད་དེ་འགྲོ་སྐབས་མི་རྟ་གཉིས་ཀྱི་བསམ་ཚུལ་ལ་ཁྱད་པར་མི་འདུག་ཀྱང་།",
    "རྡོ་ཤིང་ལ་ཐུག་དུས་འདྲེད་ཐག་ཤོར་དོགས་ཀྱིས་མྱུར་མགྱོགས་འཚམས་པ།",
    "ནོར་གླིང་དུ་བསྐྱོད་ཉིན་སྟོད་ཐུང་དེ་གྱོན་མི་འདུག་ཅིང་།",
    "རྒྱ་སུག་ཀརྨ་རྡོ་རྗེ་ནང་མི་སོགས་མཚོ་སྣ་ནས་ཤ་འུག་ཟེར་བའི་ས་ལམ་བརྒྱུད་བདེ་འབྱོར་བྱུང་འདུག་པར།",
    "དེ་ནས་དམག་མི་ཚོས་འགྲོ་དགོས་པའི་སྐུལ་འདེད་ཡང་ཡང་བྱེད་འདུག་པར།",
    "གླང་ཤ་ཐེངས་གཅིག་བཟའ་བ་ལ་རྒྱ་གར་ཡུལ་མིས་མ་ཤེས་ན་ད་དུང་མི་ཤེས་པའི་ཐབས་གནང་གལ་ཐོག་དུས་རྒྱུན་དུ་གླང་ཤ་ཡང་ཡང་བེད་གཅོད་མི་བྱེད་པའི་འབད་བརྩོན་གནང་དགོས་གལ།",
    "ཡང་ན་བརྟེན་གཞི་གང་ཡང་མེད་ཀྱང་རང་འཚོ་གནས་སྡོད་ཐུབ་ཐབས་ཡོང་མིན་ལྟ་ཆེད་ཀ་སྦུག་ཏུ་ཕྲན་དང་རོགས་མི་འཇམ་དབྱངས་རྡོ་རྗེ་བཅས་ཡོང་།",
    "ད་ནི་བྱིན་རྟེན་དང་དམ་རྫས་བསྐུར་ཐབས་ཡོང་བ་ཞེས་གསུངས་འདུག་ཅིང་།",
    "ཁྱེད་རང་མ་མད་གཉིས་ཀྱང་རྒྱུན་རིང་མ་བསྡད་ན་ལེགས།",
    "ཕུན་ཁང་ལྷ་ལྕམ་ཟེར་བ་དེའི་ཨབ་ཕྲུག་ངོ་འགྲོ་ཆེ་ཤོས་གྲས་ཡིན་འདུག་ཟླ་བ་མང་པོར་ལས་ཀ་མཉམ་དུ་བྱས་སྟབས་ཕུན་ཁང་ལྷ་ལྕམ་དང་།",
    "ར་སོ་གྷི་རི་བཅས་སུ་བབས་ཚུགས་སྣེ་ལེན་རིམ་འཛུགས་བྱས་ཡོད་འདུག་དེ་འདྲའི་མུ་ནས་རིམ་བཞིན་འབྲས་ལྗོངས་སུ་ལམ་བཟོ་བྱེད་མཁན་ཡང་ཇེ་ཉུང་དུ་ཕྱིན་པ་དང་།",
    "ཤད་གུག་ནང་གསལ་རྣམས་དངོས་འབྲེལ་མིན་འདུག་པས་འཐེན་ན་སྙམ་ཞེས་མཆན་བཀོད་གནང་འདུག་པར།",
    "དེར་ཡོད་ཀྱི་མི་ཐམས་ཅད་ཧ་ལས་ཧོན་འཐོར་བའི་བྱ་བ་ནག་པོ་དེ་བྱུང་འདུག་ཅིང་།",
    "འབོམ་བཅས་ཐོབ་མཁན་ཡང་བྱུང་འདུག་གླིང་གཤིས་བརྒྱ་དཔོན་འཆི་མེད་རྡོ་རྗེ་ཅན་གཙོ་བོ་ཡིན་ཅིང་།",
