    "དོན་དག་གོ་རྒྱུ་ཕར་བཞག་ནས་སྔོན་ལ་ཚིག་ཆ་ཚང་ཞིག་མཇལ་བའི་གོ་སྐབས་ཤིག་ཀྱང་མི་འདུག།",
    "དེང་སང་བྱ་རྒོད་ཕུང་པོའི་རི་ལ་ག་དུས་ཕྱིན་ཀྱང་གནས་སྐོར་ལ་འགྲོ་ཆོག་པས།",
    "ཇོ་བོ་མཇལ་བར་ཕྱིན་པའི་སྐབས་ལ་ཇོ་བོའི་བཞུགས་ཁྲི་སྟོང་པ་ཞིག་མ་གཏོགས་དེའི་སྟེང་ལ་ཇོ་བོའི་སྐུ་གཏན་ནས་མཇལ་མི་འདུག།",
    "མིའི་སྣང་བར་འདྲ་མི་འདྲ་ཞིག་ཡོང་རྒྱུ་ཏན་ཏན་འདུག།",
    "ལྟ་སྐྱོར་བྱས་བལྟས་ནའང་དེ་ག་ཁོ་ན་འདུག་ཅེས་ཟེར།",
    "ཡིན་ན་ཡང་རང་རྣམ་དག་ལ་དེ་འདྲ་ཨེ་ཡོད་སྙམ།",
    "པར་རྒྱག་རྒྱུ་བྱུང་མི་འདུག།",
    "འདིར་ལག་པ་གཏན་ནས་མ་འཆང་བར་བདུན་ཕྲག་གཅིག་ལ་ཞོག་གསུངས་འདུག།",
    "གང་ལྟར་ན་བཟའ་རྐྱང་རྐྱང་ལྷག་པ་མ་གཏོགས་གཞན་ཅི་ཡང་མེད་པར་ཡལ་འདུག།",
    "དེ་ནས་མེ་མདའ་བརྒྱབ་ནས་བཀྲོངས་འདུག།",
    "ནུབ་ཕྱོགས་ཟ་ཧོར་ཟེར་བ་གཉིས་ཕལ་ཆེར་ཡོད་འདུག།",
    "ཀྲུང་ཟེར་ན་དཀྱིལ་ཟེར་གྱི་ཡོད་པས་དཀྱིལ་རྒྱལ་ཟེར་གྱི་མི་འདུག་གམ།",
    "ལོ་གཅིག་ང་བྷང་ག་ལའི་མི་ཞིག་ལ་ཐུག་བྱུང་བས་ཁོ་ལ་རྒྱུས་མངའ་ཅུང་ཙམ་འདུག།",
    "རྒྱ་ནག་ལ་ནང་པའི་གཞུང་མང་པོ་ཡོད་ཚོད་འདུག།",
    "ད་དུང་རང་ཉིད་ཇེ་སྐྱིད་དང་དགའ་བ་དང་མགུ་བ་ཡོང་བ།",
    "འདི་འདྲའི་གསུང་སྲོལ་ཞིག་འདུག།",
    "བེ་རོ་ཙ་ན་ནམ་མཁའ་དག་དང་མཉམ།",
    "བོད་ལ་ཕན་ཐོགས་པའི་པཎྚཏ་གཞན་ནི་མི་འདུག།",
    "དེ་ཁྱེར་ནས་བླུས་པས་ཀྱང་ད་དུང་མགོ་བོའི་ཚོད་དེ་ཚང་མི་འདུག་བྱས་ནས་ཁོས་མ་ཉན།",
    "ངས་ཁོ་ལ་དམག་བརྒྱབ་ནས་བཟློག་ཐབས་བྱས་ན་ནི་ཟློག་ནུས་པར་འདུག་ན་ཡང་།",
    "པཎྜི་ཏ་གདན་འདྲེན་མི་ཞུ་པར་ཁྱེད་རང་གར་ལོག་རྒྱལ་པོའི་འོག་ཏུ་ཞུགས་ཟེར་བ་ལ་ནི།",
    "དེ་ནས་གསེར་ཁྱེད་རང་ཙམ་པ་ཞིག་འཁྱེར་ཡོང་དགོས་ཟེར་བ་ལ་གསེར་བཙལ་བས་ཁྱེད་ཀྱི་སྐུ་ལུས་ཙམ་དང་མཉམ་པ་ཞིག་རྙེད།",
    "ད་འདིས་བོད་ཀྱི་མི་ནོར་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་ནས་འདུག་ལགས་ཀྱི།",
    "དེ་ལྟར་ནག་ཚོ་དཔོན་གཡོག་རྣམས་ལ་ལམ་བར་གྱི་འཇིགས་པ་མང་དུ་བྱུང་བ་རྣམས་འབྲོམ་རང་ཉིད་ཀྱི་སྤྲུལ་པའི་རྣམ་པ་མང་པོས་བསལ་ཏེ་རིམ་གྱིས་བྲི་ཀ་མ་ལ་ཤཱི་ལའི་སྒོ་སྤེའི་འོག་ཏུ་བྱོན་གསུངས་འདུག།",
    "ཁྱེད་རང་རྣམས་བློ་ཕབ་སྟེ་གཟིམས་ཟེར་བ་ལ།",
    "ངོ་མི་ཤེས་པ་འདུག།",
    "ད་ལྟ་ཁོ་རང་ལ་གསེར་སྲང་ཕྱེད་ཕུལ་ལ།",
    "ངལ་གསོ་སྐོར་གསུམ་དེ་དག་ལམ་རིམ་ཇི་ལྟ་བ་བཞིན་འདུག།",
    "གང་ཟག་གཅིག་ལ་དང་པོ་ནས་རྫོགས་པ་ཆེན་པོ་ཨ་ཏི་ཡོ་ག་བསྟན་པ་ཕལ་ཆེར་ཡིན་ཚོད་མི་འདུག།",
    "རྟག་ཏུ་དམན་ས་བཟུང་ནས་བཞུགས་མཁན་ཞིག་ཡིན་ཚོད་འདུག།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "དེ་ལྟ་བུའི་སྒོ་ནས་གཞན་དོན་གཟུགས་སྐུ་ཞེས་པ་ལ་གོ་བ་ཞིག་མི་འདུག་གམ།",
    "དེ་ལམ་རིམ་ཆུང་ངུའི་སྡོམ་ལྟ་བུ་ཞིག་འདུག།",
    "དོལ་རྒྱལ་ཚོགས་པའི་ལས་ཀ་བྱེད་མཁན་ཁ་ཤས་གྱོང་པོ་འདུག།",
    "ཉེ་བའི་ཆ་ལ་ཡང་རྒྱ་གར་ནང་གཞིས་འགོ་ཉེས་རྡུང་བཏང་འདུག།",
    "གཞན་རྗེས་སུ་འཛིན་པ་ལ་དེ་ལས་ཀྱང་ལོས་ཡིན།",
    "ཧམ་སེམས་དང་རང་གཤིས་ཆེན་པོ་ཡོད་པ་ལྟ་བུ།",
    "བསོད་སྙོམས་ལེན་རྒྱུའི་ཕྱག་ལེན་སོགས་འདུག།",
    "ས་སྐྱ་ནི་མ་གཏོགས་པའོ་ཞེས་མཆན་ཞིག་འདོགས་དགོས་གྲབས་དགོས་གྲབས་བྱེད་ཀྱི་འདུག།",
    "རྒྱལ་བའི་དགོངས་པ་བདེ་བླག་ཏུ་རྙེད་པའི་ཆེ་བ་ཞེས་སྦྱར་སྟངས་ཀྱང་འདུག།",
    "ཀེའུ་ཚང་ལམ་རིམ་དུ་འདིའི་བཀའ་དགོངས་འགྲེལ་གྱི་དོན་རྣམས་ལམ་གྱི་རིམ་པར་གཅིག་ཏུ་སྒྲིལ་ནས་བདེ་བླག་ཏུ་རྟོགས་པར་བྱེད་པའི་ལམ་རིམ་གྱི་མན་ངག་འདི་ལྟ་བུ་ལ་བརྟེན་ནས་གོ་བ་ཞེས་འདི་འདྲ་ཞིག་གསུངས་འདུག་པ་དེ་ཡང་གོ་རྒྱུ་ཡག་པོ་འདུག།",
    "ཕ་རོལ་འཇོམས་པ་དང་རང་ཕྱོགས་སྐྱོང་བའི་མཚོན་ཆ་གཏན་ནས་མེད་པ་དེ་ངོ་མཚར་སྐྱེ་འོས་པ་ཡིན།",
    "དེང་སང་རྒྱ་གར་ལ་ནང་པ་ཤུལ་མེད་བྱས་འདུག་གམ་མུ་སྟེགས་པ་ཤུལ་མེད་བྱས་འདུག།",
    "དེ་སྐྱིད་པོ་འདུག།",
    "སེམས་ཀྱི་ནང་ནས་སྤྲོ་ཤུགས་ལྟ་བུ་སླེབས་པ་ཡིན་ན་དཀའ་ངལ་བྱུང་བ་དང་ཐང་ཆད་རྒྱུ་གཏན་ནས་མི་འདུག།",
    "སྔོན་གྱི་བག་ཆགས་ཀྱིས་མིན་ནམ་ཅུང་ཙམ་ཅུང་ཙམ་ཕན་པ་ལྟ་བུ་འདུག།",
    "དེང་སང་གནས་དེ་དག་ལ་གང་ཡང་མི་འདུག།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "ཡང་དྷཱི་གསོག་པ་མི་བརྗེད་པའི་གཟུངས་བསྒྲུབ་པ་ལྟ་བུར་ཕན་གྱི་འདུག།",
    "ཡང་ཡང་བལྟས་ན་སེམས་ལ་ངེས་ཆ་ཇེ་བརྟན་ཇེ་བརྟན་དུ་འགྲོ་བའི་ཁྱད་འདུག།",
    "གཙོ་བོ་གཙོ་བོ་མི་བརྗེད་པའི་ཐབས་གོམས་འདྲིས་ལ་རག་ལས་འདུག།",
    "རྗེས་སུ་ལོ་ཤས་ཕྱིན་ཏེ་བརྗེད་ཐོ་ཀློག་པ་ན་ཅི་ཡིན་མི་ཤེས་པ་དེ་འདྲ་ཡོང་གྲབས་ཡོང་གྲབས་བྱེད་ཀྱི་འདུག།",
    "དེ་ངོ་མཚར་བ་མི་འདུག་གམ།",
    "གཞན་ཆུང་ངུ་རྣམས་ཟིལ་གྱིས་མནན་ནས་བློ་སྤོབས་ཤིག་སླེབས་ཀྱི་མི་འདུག་གམ།",
    "གར་ལ་བལྟ་བའི་ཁྲོད་ན་འདུག་པ་ཞིག།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "ང་ལ་མཚོན་ན་ང་རང་གཅིག་པུར་ལམ་རིམ་ཆ་ཚང་ཞིག་ཀློག་པ་དང་།",
    "དེར་གནོད་པ་སྐྱེལ་མཁན་གྱི་བདུད་རྣམས་ཕར་བསྐྲད་དགོས་ཟེར་ན་ང་དེ་ཧ་ཅང་འགངས་ཆེན་པོས་བྱས་འདུག་པས་བདེན་འཛིན་རང་གཅེས་འཛིན་གཉིས་པོ་ཇེ་བརྟན་ཇེ་བརྟན་དུ་འགྲོ་བ་ལྟ་བུ་ཞིག་མི་འདུག་གམ།",
    "ཀུན་མཁྱེན་ཀློང་ཆེན་པའི་མཛོད་བདུན་དུ་ཡང་རྒྱ་དཔེའི་ལུང་འདྲེན་མང་པོ་གནང་འདུག།",
    "ཡང་ང་རང་ཉིད་ལྟ་བུར་མཚོན་ན་དང་པོར་དཀའ་ས་ནས་བསླབ་ན་ད་གཟོད་དད་པ་སྐྱེ་བ།",
    "དེ་མི་འདུག་ན་སྟོན་པ་བཀའ་དྲིན་ཅན་གྱི་བཀའ་ཡིན་ན་ཡང་།",
    "རིམ་གྱིས་རིམ་གྱིས་མདུན་ལམ་ཆེན་པོ་ཡོད་པ་ཞིག་ཡིན་བསམ་པ་སྐབས་སྐབས་དྲན་གྱི་འདུགགང་ལྟར་དུས་རབས་ཉི་ཤུ་པ་དེའི་ནང་ཤུགས་འདྲ་མི་འདྲ།",
    "བསམ་གྱིས་མི་ཁྱབ་པ་ཡིན་ན་ཡང་གང་ཐུབ་ཐུབ་ཀྱིས་དཔྱད་ཐུབ་ན་ཡག་པོ་འདུག།",
    "དངོས་གནས་ཡག་པོ་འདུག་བསམ་པའི་སེམས་ལ་ངེས་པ་སྐྱེ་བ་འདྲ་ཞིག་ཀྱང་འོང་།",
    "དེ་ཉིད་མ་མཐོང་རང་འགར་རྒྱུ་བ་ཡི།",
    "སྟབས་ལེགས་པོ་འདི་འདྲ་ཞིག་འཛོམས་པའི་སྐབས་ལ་གང་ཐུབ་ཐུབ་ཀྱིས་ཉམས་ལེན་ལེགས་པོ་བྱས་ཏེ་རང་རང་སྒེར་ལ་མཚོན་ནའང་།",
    "བོད་པའི་ནང་ལ་ཡང་དེང་སང་ཡོང་གྲབས་ཡོང་གྲབས་བྱེད་ཀྱི་འདུག།",
    "ཆས་ཡ་མ་ཟུང་གོན་པའི་ཡ་མཚན་པོ་དེ་འདྲ་འདུག།",
    "ཁོང་ལ་རིན་ཐང་གང་ཡང་མི་འདུག།",
    "རྒྱ་མི་གུང་ཁྲན་འོག་ཏུ་འདུག་སྐབས་སྐད་ཆའི་ཚིག་ལེགས་ཉེས་དང་།",
    "བཅོམ་ལྡན་འདས་ལ་དབུ་ཞྭ་མི་འདུག།",
    "དེའི་རྗེས་འབྲངས་རྒྱན་དྲུག་མཆོག་གཉིས་ཚོས་དབུ་ཞྭ་དམར་པོ་ཞིག་བཞེས་ཀྱི་འདུག།",
    "ནོར་འཁྲུལ་བྱས་མི་འདུག་གམ།",
    "རང་ཅག་བོད་སྤྱི་པའི་དོན་དག་དེ་ལྟ་བུ་ཞིག་ཏུ་གྱུར་འདུག།",
    "དམར་ཁྲིད་མྱུར་ལམ་གྱི་ས་བཅད་ནང་ལ་ཡང་བསྟེན་པའི་ཕན་ཡོན་དང་མ་བསྟེན་པའི་ཉེས་དམིགས་སྔོན་ལ་གསུངས་འདུག།",
    "ཞེས་ཐག་ཆོད་པ་གསུངས་མི་འདུག་གམ།",
    "སྤྱན་སྔ་པ་རུག་པ་ན་བཞུགས་ཙ་ན།",
    "དེ་ཡི་སྔོན་འགྲོ་དད་པ་ཡིན་གསུངས་འདུག།",
    "ངས་ཤེས་ཀྱི་མི་འདུག་སྟེ་ལྟ་བའི་ཐོག་ནས་བསམ་བློ་བཏང་ན་ད་གཟོད་ངེས་ཤེས་རྙེད་པ་ལྟ་བུ།",
    "དེ་ནས་དལ་འབྱོར་བསམ་ན་རིགས་ཁ་ཤས་ལྷོད་ཤིག་ཤིག་ཆགས་འགྲོ་བ་ཞིག་ཡོད་ཚོད་འདུག་གོང་དུ་ཞུས་པ་བཞིན།",
    "དངོས་པོའི་གནས་ཚུལ་གང་ཡིན་ཡང་རང་ལ་དགོས་པ་དང་ཕན་ཐོགས་ཤིག་ཡོད་ན་བསྒོམ་ཆོག་པ།",
    "བཤགས་པ་ཕུལ་བ་དེ་འདྲ་གནང་འདུག།",
    "ད་དུང་རང་ལ་ཡོད་པའི་རྣམ་དཔྱོད་དེ་ལམ་ལོག་པ་ལ་བེད་སྤྱད་ནས་རང་གཞན་ཚང་མ་ཕོངས་ལ་སྦྱོར་བ་ཡང་འོང་།",
    "ཐུན་དང་ཐུན་མཚམས་གཉིས་ཕྱེ་ཞེས་པ་ཡག་པོ་འདུགཐུན་གྱི་གནས་སྐབས་སུ་སེམས་ལ་དཔྱད་པ་བཏང་།",
    "འདི་ལོས་ཡིན་བསམས་པ་ལྟ་བུའི་ངེས་པ་རྙེད་རྒྱུ་ཡོད།",
    "བསྐལ་ཆེན་གྲངས་མེད་གསུམ་ཞེས་པ་འདི་སེམས་ལ་ཕན་པོ་ཞིག་འདུག་ལྷག་པར་དུ་ཡང་།",
    "སྤྱོད་ལམ་འདུག་སྟངས་ལ་ཅུང་ཟད་ཁྱད་པར་འདུག།",
    "ང་ལ་མཚོན་ན་བསམ་བློ་གཏོང་རྒྱུ་ལ་ཉལ་ན་བསམ་བློ་འཁོར་ཆེ་བ་ལྟ་བུ་འདུག།"
  ]
}