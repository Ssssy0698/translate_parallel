    "གང་གི་ཐུགས་བརྩེས་ཉེར་བཟུང་ནས།",
    "འཇིག་རྟེན་པ་རྣམས་བདག་གིས་འཁུར་མིན་གྱིས།",
    "དེ་ནི་བདག་གི་འཁུར་ཆེན་དག་ཏུ་འབྱུང་།",
    "སྡོམ་པ་གསུམ་གྱི་རབ་ཏུ་དབྱེ་བ་བློ་ཀ་སྟོང་གི་བདག་ཉིད་ཅེས་བྱ་བ།",
    "གངས་ཅན་གྱི་སྐྱེ་བོའི་བློ་གྲོས་རྒྱལ་མཚན་གྱི་རྩེ་མོའི་རྒྱན་དུ་གྱུར་པ།",
    "ནམ་མཁའི་མཐའ་ལྟ་བུ་ལ་ཁོ་བོའི་བློ་གྲོས་བུང་བའི་བགྲོད་པ་ལྟ་བུས་དཔག་པར་མི་ནུས་མོད་ཀྱི།",
    "གསུང་གི་བདུད་རྩིའི་བཅུད་ཅུང་ཟད་མྱངས་པ་དང་།",
    "གུས་པས་སྤྱི་བོའི་ཅོད་པན་དུ་འཛིན་པ་བསྟན་པའི་སྦྱིན་བདག་ཆེན་པོ་རབ་བརྟན་ཀུན་ཏུ་བཟང་པོ་སྐུ་མཆེད་ཀྱི་གསུང་གིས་ཡང་ཡང་བསྐུལ་བ་དང་།",
    "ཁྱུང་གི་རིགས་སུ་སྐྱེས་པའི་བན་རྒན་རིན་ཆེན་རྒྱལ་མཚན་དཔལ་བཟང་པོས།",
    "ཆུ་མོ་ཡོས་བུའི་ལོ།",
    "ཐ་སྐར་ཟླ་བའི་ཚེས་གྲངས་བཟང་པོ་དགའ་བའི་ཚེས་བཅུ་གཅིག་གི་ཉིན་ལེགས་པར་གྲུབ་པའོ།",
    "བསྟན་ལ་ཞུགས་པའི་གང་ཟག་འགའ་ཞིག་གིས།",
    "རྣམ་པར་རྒྱལ་མ་ལ་བསྐུལ་ཞིང་གསོལ་བ་འདེབས་པའི་ཚིག་དབྱངས་ཅན་དམར་མོའི་བསྟོད་པའོ།",
    "ཕག་མོ་ཤེས་རབ་གསལ་བྱེད་ཀྱི་བསྟོད་སྒྲུབ་བཞུགས།",
    "ཇོ་བོ་རྗེ་ལྷ་གཅིག་ནས་བརྒྱུད་པའི་གདམས་པ་ཟབ་མོ་ཉམས་སུ་ལེན་ཚུལ་གྱི་དབུའོ།",
    "དཔོན་ནམ་མཁའ་བཟང་པོའི་ཞུ་ཡིག་གི་ལན་གྱི་དབུའོ།",
    "བཀྲ་ཤིས་འཕགས་པའི་ཞུ་ཡིག་གི་ལན་གྱི་དབུའོ།",
    "དབྱངས་ཅན་དམར་མོའི་སྒྲུབ་ཐབས་བསྟོད་པ་དང་བཅས་པ་བཞུགས་པའི་དབུའོ།",
    "སྒྲོལ་མ་དཀར་མོའི་སྒྲུབ་ཐབས་བཞུགས་པའི་དབུ་ལགས་སོ།",
    "ཁྱོན་བསྡོམས་༤༡མོད།",
    "༧༢ རིཊ་ལྔའི་སྡོམ་གཟུང་བའི་ཚིག་གི་འགྲེལ་པ་དམ་ཚིག་གི་ཆུ་རྒྱུན་ཞེས་བྱ་བ་དོན་གསལ་ཞིང་གོ་བདེ་བར་བདོག་སཱཙྪའདེབས་པའི་ཕྱག་ལེན་བཞུགས་པའི་དབུ་ཕྱོགས་ལགས་སོ།",
    "གཞལ་ཡས་ཁང་གི་གསལ་བྱེད་ཉི་མའི་འོད་ཟེར་བཞུགས་པའི་དབུ་ཕྱོགས་ལགས་སོ།",
    "གསང་བ་འདུས་པའི་ཁྲིད་ཡིག་ཟ་མ་ཏོག་གི་ལྷན་ཐབས་ཕྱོགས་གཅིག་ཏུ་བཀོད་པ་བཞུགས་པའི་དབུའོ།",
    "ཕག་མོ་གཞུང་དྲུག་གི་ལྷ་གསུམ་ལ་བསྟོད་པའོ།",
    "ཕག་མོ་གཞུང་དྲུག་གི་མངོན་རྟོགས་བཞུགས་པའི་དབུའོ།",
    "གཞུང་དྲུག་གི་ཞལ་གདམས་སྣ་ཚོགས་བཞུགས་པའི་དབུའོ།",
    "གཞུང་དྲུག་གི་ཁྲིད་ཡིག་ངོ་སྤྲོད་བཞུགས་ལགས།",
    "དྲག་པོའི་སྦྱིན་སྲེག་གི་སྟག་བརྟག་ཐབས།",
    "ཀུ་རུ་ཀུལླེ་དམར་མོའི་སྒྲུབ་ཐབས་ལས་ཚོགས་ཚང་ལ་ཟབ་པར་ཡོད་པའི་དབུའོ།",
    "༡༡༥ ཁ་བྱུང་མེད་པའི་ཤོག་བུ་གཅིག་ཁྱོན་བསྡོམས་༦༡༨ཚོད།",
    "ཡིད་ཆེས་ལུང་གི་ཚོམས་ཐོར་བུ་སྣ་ཚོགས་བཞུགས་སོ།",
    "ཁྱོན་བསྡོམས་ཡོད།",
    "ཁྱོན་བསྡོམས་༣༣༣ཡོད། གསུང་འབུམ་པོད་ལྔ་པའི་དཀར་ཆག།",
    "ཁྱོན་བསྡོམས་༢༢༢ཡོད།",
    "དབར་རྒྱུན་སྦྱིན་བདག་ཆེན་མོ་ནི།",
    "བདག་གིས་སུ་ནི་འདི་བགྱིས་སོ།",
    "ཚིག་གི་སྤྲོས་པ་མ་ལུས་གྲོལ།",
    "རང་གི་ཡེ་ཤེས་མཐུ་ཡི་མཚན།",
    "ཀུན་དུ་བཟང་པོའི་སེམས་ཞེས་བྱ་བ་རྡོ་རྗེ་ལྟར་མི་ཤིགས་པ་དེའི་རྒྱུའི་གནས་སྐབས་ན་གནས་པ་དེའི་རིགས་ཀྱི་བདག་ཉིད་དང་བཅས་པར་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པ་ཐམས་ཅད་ཀྱི་སེམས་ཀྱི་རྒྱལ་པོ་ལྟ་བུར་རང་གི་སེམས་ཀྱི་བདག་ཉིད་བསྟན་ཏོ།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་ཀུན་དུ་བཟང་པོ་དེ་ཉིད་རང་གི་ངོ་བོའི་བྱེ་བྲག་གིས་མི་བསྐྱོད་པ་དང་།",
    "དེ་རྣམས་ལས་ཀྱང་ཇི་ལྟར་གནས་པའི་རིམ་པ་བཞིན་དུ་རང་གིས་རྟོགས་པའི་མཐུའི་ཁྱད་པར་གྱི་ངོ་བོ་དེ་བཞིན་ཉིད་དང་།",
    "བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་ཞེས་བྱ་བ་རྣམས་སུ་རང་གི་ངོ་བོ་ཐ་དད་པར་བསྟན་ཏོ།",
    "རྡོ་རྗེ་དགའ་བ་ལ་སོགས་པ་ཕལ་ཆེར་རང་གི་མིང་དང་སྔགས་ཀྱི་ཚིག་དང་།",
    "དཔེ་མེད་པའི་སྐུའི་ཆ་ལུགས་འཛིན་པ་རང་གི་ངོ་བོའི་བྱེ་བྲག་ཏུ་བྱིན་གྱིས་བརླབས་ཏེ་གནས་སོ།",
    "སྐྱེ་བོ་ཕོངས་པའི་བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་མཛད་པ་ལ་སོགས་པ་བདེ་བར་གཤེགས་པ་མཐའ་དག་གི་ཡོན་ཏན་གྱི་ཁྱད་པར་མཐའ་ཡས་པའི་རང་བཞིན་རྣམས་ཁྱད་པར་མེད་པར་ཡང་དག་པར་བསྐྱེད་དོ།",
    "ཁྱོད་ནི་ཐམས་ཅད་གཟིགས་པའི་ཡབ།",
    "དེ་བཞིན་གཤེགས་རྣམས་ཁྱོད་ལ་བརྟེན།",
    "གང་གི་ཕྱིར་དངོས་གྲུབ་ཁྱད་པར་ཅན་ཇི་ལྟར་འདོད་པའི་བདེ་བ་འབྱུང་རྣམས་ཀྱང་དེ་དག་དང་མཉམ་པར་ལྡན་ན་བདེ་བ་ཉིད་ཀྱིས་དེའི་གོ་འཕང་མྱུར་དུ་ཐོབ་སྟེ།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་དེའི་ཕྱིར་སྒྲུབ་པའི་ཐབས་སུ་རང་གིས་བརྟགས་པའི་ལྷའི་ངོ་བོ་ཉིད་ཀྱི་བྱེ་བྲག་ཏུ་གྱུར་པ་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་བཞི་འདིར་བསྟན་ཏེ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "ཇི་སྐད་དུ་རེ་ཞིག་འདི་ཉིད་ལས།",
    "རྒྱལ་པོའི་ཕྱག་རྒྱ་མཆོག་གི་རྟགས།",
    "གང་དག་གིས་དེ་རྟོགས་ནས་རྣམ་པར་དག་སྟེ།",
    "ཕྱག་རྒྱ་དེ་ཡང་འདིར་སྐུ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་ཕྱག་རྒྱ་ཆེན་པོ་ཞེས་བྱ་བ་དང་།",
    "ལྷ་དེ་བྱེ་བྲག་མེད་པར་བསམ་མོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ངོ་བོ་གཟུགས་སམ་དེ་བསྒོམས་པ་ལས་བྱུང་བ་ནི་གཟུགས་ཀྱི་ལྷ་མོའི་ཕྱག་རྒྱ་ཆེན་པོ་ཞེས་བྱའོ།",
    "དེའི་རྗེས་སུ་མཐུན་པར་ལྷ་མོ་དེ་རྣམས་ཀྱི་སྐུ་དྲན་པར་བསྐྱེད་པའི་ཕྱིར་བསྟན་པར་རིག་པར་བྱའོ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་དེ་དག་ཐམས་ཅད་ཀྱང་ཕྱི་ནང་གི་བྱེ་བྲག་གིས་རྣམ་པ་གཉིས་སུ་རིག་པར་བྱ་སྟེ།",
    "དེ་ལས་གཞན་པ་ལྷའི་སྐུའི་གཟུགས་བརྙན་ཡིད་ཀྱིས་བསམས་པ་ནི་ནང་གི་ཡིན་ཏེ།",
    "དེ་ལ་དམ་ཚིག་གི་ཕྱག་རྒྱ་མཚན་མ་སོར་མོ་བཀོད་པའི་བདག་ཉིད་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "དེ་རང་གི་ཡུལ་གྱི་དེ་ཁོ་ན་ཉིད་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།"
