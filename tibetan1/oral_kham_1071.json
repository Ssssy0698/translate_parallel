    "རྗེས་སུ་མ་འབྲེང་རང་ཞལ་ལྟོས།",
    "ཇི་ལྟར་འདུག་པ་དེ་གར་ཞོག།",
    "ལས་མི་དགེའི་ཞེན་པ་ལོག་ཙ་ན།",
    "ཚེ་འདི་ལས་ཞེན་པ་ལོག་ཙ་ན།",
    "༤༣རང་དོན་ལས་ཞེན་པ་ལོག་ཙ་ན།",
    "གཟུང་འཛིན་ལས་ཞེན་པ་ལོག་ཙ་ན།",
    "བདེ་བའི་སྟན་ལ་ལེགས་འདུག་སྟེ།",
    "གང་ཡང་མི་སྤང་རང་བཞིན་ཤེས་པ་ཡིས།",
    "གེགས་སེལ་བོགས་འདོན་དེ་ལྟར་གདའ།",
    "རྗེ་ཁྱེད་རང་མཁྱེན་ཞེས་ལིངས་སྐྱུར་བྱ།",
    "དེ་ཙ་ན་ཐམས་ཅད་གཞུག་མ་དངོས།",
    "ཞི་བདེ་དོན་གཉེར་གྱི་བློ་འདུག་ན།",
    "དེ་རྗེས་སུ་མི་འབྲང་རང་ཞལ་ལྟར།",
    "བལྟས་ཙ་ན་ཅི་ཡང་མཐོང་དུ་མེད།",
    "འདྲེ་ཟ་མཁན་འདུག་ན་དེ་ལ་བྱིན།",
    "ན་ཚ་དེ་ཅི་འདུག་ཆུ་རྡར་ཆོད།",
    "སེམས་ལྷོད་ཀྱིས་གློད་དང་རང་སར་ཞི།",
    "རང་རང་སེམས་ཀྱིས་སེམས་དང་དེར་བསླད་པའི།",
    "དེང་སང་རང་མགོ་སུ་གྲུང་འགྲན་པའི་དུས།",
    "དྲས་ཅི་ཡང་རྒྱག་ཏུ་མི་འདུག་པས།",
    "གང་ལའང་བཅོས་སླད་མི་བྱ་ཇི་ལྟར་འདུག་པར་བཞག།",
    "འོན་ཀྱང་དེང་སང་སེར་དམག་དར་ཆེས་པས་བསྟན་པ་ལ་གནོད་པར་འདུག་པས་དེ་མི་བྱེད།",
    "བསྟན་པའི་ཕྱི་རྒྱ་སྲུང་བའི་དུས་ལ་བབ་འདུག་གོ།"
  ]
}