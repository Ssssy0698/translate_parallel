    "དེ་ལ་གསང་སྔགས་ལུང་གི་སྒོ་བཞི་ནི།",
    "དོན་དམ་གསལ་འདེབས་བརྗོད་པ་ཚིག་གི་སྒོ།",
    "ཧཱུྃ་ཧྲཱི་ཕྱི་སྣོད་དག་པ་རབ་འབྱམས་སོགས་ཀྱི་ཚིག་གིས་གསལ་བཏབ་བོ།",
    "དངོས་སུ་འབྱོར་བ་དང་ཡིད་སྤྲུལ་ལྷ་མོ་རྣམས་ཀྱིས་ཉེར་སྤྱོད་བདུན་དང་།",
    "དབུ་ཞྭའི་རྒོད་ལྡེམ་ནས་གདན་ཁྲིའི་བར་རྒྱན་གྱི་ཆ་ཤས་རེ་རེ་ཞིང་གསལ་བཏབ་ཀྱིན་བསྒོམས་པས་དེ་དང་དེ་རེ་རེ་ལའང་སེམས་ཟིན་ཏེ་སོ་སོའི་གསལ་སྣང་ཁྱད་པར་ཅན་མ་འདྲེས་པར་ཕྲ་ཞིབ་མ་སྐྱེས་ཀྱི་བར་དུ་འབད་པས་བསྒོམས་ཤིང་།",
    "བསྐྱེད་པའི་གནས་སྐབས་དེ་དག་ཐམས་ཅད་དུ་སྐྱོན་ཀུན་ཟད་ཡོན་ཏན་ཀུན་རྫོགས་རྒྱལ་བ་ཀུན་གྱི་སྤྱི་གཟུགས་གུ་རུ་རྡོ་རྗེ་ཐོད་ཕྲེང་དེ་ཉིད་ངའོ་སྙམ་པས་ང་རྒྱལ་བཟུང་ཞིང་ལྷ་སྐུ་རང་གི་རིག་རྩལ་ལས་གཞན་དུ་མ་གྲུབ་པའི་ངེས་ཤེས་ཁྱད་པར་ཅན་མ་སྐྱེས་ཀྱི་བར་དུ་བསྒོམ་སྟེ།",
    "གཞི་དུས་སུ་གདོད་མ་རང་བྱུང་གི་ཡེ་ཤེས་ལ་ཉེས་སྐྱོན་གྱིས་གོས་མ་མྱོང་བ་དང་།",
    "དེ་ལས་གོ་ལྡོག་པ་སོགས་ཆེ་ཆུང་མ་ངེས་པ་ལ་རྩལ་སྦྱངས་པས་གཞལ་ཡས་ཡུངས་འབྲུ་ཙམ་པ་ཆེར་མ་སོང་ཞིང་།",
    "འོད་ཟེར་རྣམས་ཚུར་འདུས་བདག་ལ་ཐིམ་པས་མཆོག་ཐུན་མོང་གི་དངོས་གྲུབ་རྣམ་གཉིས་ཐོབ།",
    "པདྨ་ཞེས་རྒྱ་སྐད་སོར་བཞག་གི་མཚན།",
    "དེ་ཡང་མཁའ་འགྲོའི་བརྡར་དྷ་ཀིནཱི་ཞེས་སུ་སོང་བའོ།",
    "གཉིས་པ་བྱེ་བྲག་གི་བཟླས་པ་ལའང་།",
    "དང་པོ་རིགས་བདག་གི་ཐུགས་ཀར་ཟླ་སྟེང་ཧྲཱི་དམར་པོའི་མཐར་སྔགས་ཀྱིས་གཡས་སུ་བསྐོར་བ་ལས་འོད་ཟེར་འཕྲོས།",
    "སྲིད་དང་ཞི་བའི་ཚེ་བཅུད་དང་དཔལ་ཡོན་ཐམས་ཅད་བདུད་རྩི་འོད་ཟེར་དང་བཅས་པའི་རྣམ་པར་བཀུག་ནས་ཕྱག་གི་ཚེ་བུམ་དུ་ཞུགས་པ་གང་བའི་ཚུལ་གྱིས་ལུད་དེ་རང་གི་སྤྱི་བོ་ནས་ཞུགས།",
    "ཨ་མཱ་ར་ཎི་ཞེས་ཨ་ཐུང་དགག་པའི་སྒྲ་ཡིན་ཅིང་།",
    "སུ་ལེགས་པ་ནི་སྦྱིན་པའི་སྒྲར་སོང་ན་ལེགས་པ་བྱིན་ཅིག་ཅེས་བྱ་བར་འགྱུར་རོ།",
    "གསུམ་པ་ལས་སྦྱོར་ལའང་མཆོག་གི་ལས་སྦྱོར་དང་ཕལ་པ་གཉིས།",
    "ལས་བཞི་ཐུན་མོང་དུ་བསྒྲུབ་པ་ཡབ་ཀྱིས་ཡུམ་བསྐུལ་བ་ལ།",
    "མཁའ་གསང་གི་ལམ་བརྒྱུད་དེ་ཡུམ་གྱི་ཐུགས་སྲོག་ལ་ཐིམ་པས་དགྱེས་པ་བསྐྱེད།",
    "དཀར་མོས་ཞི་བ་སོགས་ལས་བཞི་རྩོལ་མེད་དུ་བསྒྲུབ་པར་བསམ།",
    "རྡོ་རྗེ་ཕག་མོ།",
    "ཁྲོ་མོ་ནག་མོ་ཞེས་དང་།",
    "གཉིས་པ་ཐུན་མོང་གི་ལས་ཐམས་ཅད་ཀྱི་གཙོ་བོའམ་རྟེན་དུ་གྱུར་བ་ཚེ་སྒྲུབ་པའི་སྒོ་ནས་རང་ངམ་གཞན་ལ་ཕན་འདོགས་པར་བྱེད་པ་ལ་བསྒོམ་བྱའི་དམིགས་པ་བསྟན་པ་དང་།",
    "རང་ཉིད་ཀྱི་ཕྱག་གི་ཐོད་པ་ཚེ་ལྷ་ཡུམ་གྱི་ངོ་བོ།",
    "དེ་གཉིས་ལས་ལྷ་མོ་མགྱོགས་མ།",
    "རང་གི་ཚེ་ཆད་ཉམས་ཡར་བརྐུས་ཐམས་ཅད་རྡོ་ཁབ་ལེན་གྱིས་ལྕགས་ལྟར་བསྡུས་ཏེ་སྤྱི་བོ་ནས་ལུས་ལ་བསྟིམ།",
    "རང་རྡོ་རྗེ་ཐོད་ཕྲེང་གི་སྐུ་རྐྱང་པ་ཙམ་དུ་གསལ་བའི་སྟོང་ར་འོད་ཀྱི་རང་བཞིན་གྱི་དབུས་སུ།",
    "རང་གི་སྣ་བུག་ནས་ཞུགས།",
    "ལྟེ་བའི་གཏུམ་མོ་ཨ་ཤད་ཀྱི་རྣམ་པ་ཅན་ལ་རེག་པས་མེ་འབར།",
    "མེ་ལྕེ་ཇེ་ཆེར་སོང་བས་སྤྱི་བོའི་ཧཾ་ཞུ་བའི་འབར་འཛག་གིས་དྲང་བའི་བདེ་བ་ལ་སེམས་གཏད་ནས་དམིགས་པ་དང་སྦྱར་བའི་བུམ་ཅན་ཅི་ནུས་སུ་འཛིན་པའོ།",
    "ཐིག་ལེ་ནཱ་ད་ཤིན་ཏུ་ཕྲ་བ་སུམ་འཁྱོགས་ལ་ཐིམ།",
    "རང་གི་སེམས་གདོད་མའི་སྟོང་པ་ཆེན་པོ་སྐྱེ་འགག་གནས་གསུམ་དང་བྲལ་བ་གཅིག་ཏུ་བསྲེས་ལ་མཉམ་པར་བཞག་ཐུན་ལས་ལྡང་བ་ན་ཆུ་ལས་ཆུ་བུར་བརྡོལ་བ་ལྟར་ཟུང་འཇུག་གི་དབྱིངས་ལས་བདག་ཉིད་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོར་བཞེངས་ནས་སྣང་གྲགས་རྟོག་ཚོགས་ཐམས་ཅད་ལྷ་སྔགས་ཡེ་ཤེས་ཀྱི་རོལ་པར་བལྟས་ལ།",
    "ཚུལ་དེའི་རྨད་བྱུང་རྟེན་འབྱུང་གིས།",
    "དང་པོ་དམ་ཚིག་གི་བྲིས་སྐུ་འབྲི་བ་ནི།",
    "ཡིད་དུ་འོང་བའི་གཞོན་ནུ་མ་དག་གི་འདོམ་དཀྲིས་སམ།",
    "ཞལ་ཐང་གི་མཐའ་རྒྱན་སོགས་ཀྱང་ཁ་དོག་དམར་པོ་གཙོ་བོར་བྱ།",
    "སྐྱེ་མོས་ཚལ་དང་མེ་ཏོག་གི་ལྗོངས་སོགས་ནས།",
    "དེ་ཡང་བསྙེན་པ་མ་ཐེམས་པའི་སྐྱོན་དང་ཐེམས་པའི་ཡོན་ཏན་ཤེས་པའི་སྒོ་ནས་སྤྲོ་བ་དྲག་པོས་བསྙེན་པ་ཉིད་ཇི་ལྟར་ཡིན་པའི་གོ་དོན་ཕྱིན་ཅི་མ་ལོག་པར་བྱས་ནས་ཡེ་ཤེས་ལྷའི་ཐུགས་ཉེ་བར་གྱུར་པའི་མཚན་མ་མ་མཐོང་གི་བར་དུ་བརྩོན་པ་མི་ལྷོད་པར་བྱའོ།",
    "སྲོག་འཁོར་མུ་ཁྱུད་བདུན་བསྐོར་བའི་ལྟེ་བ་སོར་བཞི་ཙམ་ལ་གཙོ་མོའི་སྐུ་གཞུང་གི་མངོན་རྟོགས་དང་མཐུན་པར་བྲི།",
    "ཨོཾ་པདྨ་ཌཱཀི་ནཱི་ཀུ་རུ་ཀུལླེ་ཧྲཱི་སྭཱ་ཧཱ་ཞེས་པའི་འབྲུ་བཅུ་གསུམ་པ་འདི་གཙོ་མོའི་དབུ་ཡི་སྟེང་དུ་ཨོཾ་ནས་བརྩམས་ཏེ་གཡོན་བསྐོར་ཡིག་ངོ་ནང་བསྟན་དུ་བྲི་ཚར་གཅིག་གམ་མུ་ཁྱུད་དང་བསྟུན་ཏེ་ཚར་ཅི་ཤོང་བྲིས་ཀྱང་རུང་ངོ།",
    "གོང་གི་སྒྲུབ་སྔགས་ཀྱི་རྗེས་སུ།",
    "ཞེས་པའི་མཐར་འདོད་གསོལ་རྒྱས་བསྡུས་རང་གིས་ཇི་ལྟར་འདོད་པ་བྲི།",
    "ཡི་གེའི་དབུ་དང་བསྐོར་ཕྱོགས་ནང་གི་བསྙེན་སྔགས་དང་འདྲ།",
    "ཡུ་བ་དང་རྩེ་མོ་བཅས་པདྨ་དམར་པོ་ལས་བྱས་པའི་ལྕགས་ཀྱུ་རྩེ་མོ་ནང་དུ་བསྟན་ནས་གཡོན་བསྐོར་དུ་བྲི།",
    "འདིའི་དབུ་འཛིན་པ་ཧྲཱི་ཡིག་གི་མདུན་ནས་གཡས་བསྐོར་བྱ།",
    "ཁ་ཅིག་གིས་ནང་གི་ས་བོན་གྱི་དབུ་ནས་བསྐོར་བའི་ཕྱག་སྲོལ་འདུག་པས་ལྟེ་བར་ལྷ་སྐུ་ཅན་ལ་དེ་ལྟར་དང་།",
    "སརྦ་སིདྡྷི་སོགས་གོང་གི་ཤམ་བུ་དང་འདོད་གསོལ་ཅི་རིགས་བྲི།",
    "བདག་གི་རྣལ་འབྱོར་ལ་གནས་པའི་བཟླས་པ་ཅི་རིགས་དང་མཆོད་བསྟོད་བྱས་ནས་མདུན་གྱི་རྟེན་རྣམས་ལ་དམིགས་ཏེ།",
    "ཁབ་མིག་ནས་སྲད་བུ་དམར་པོ་དྲངས་ཏེ་བྲིས་སྐུའི་ཕྱག་གི་མདེའུའི་ཐད་དུ་གདགས་པར་བྱའོ།",
    "སྦྱིན་སྲེག་གིས་ལས་ལ་སྦྱར་བ།",
    "གཉིས་པ་སྦྱིན་སྲེག་གི་ལས་སྦྱོར་ནི་གཞུང་དུ་གསལ་ལ།",
    "མཆོག་གི་ལས་སྦྱོར་ནི།",
    "ནམ་མཁོ་བའི་དུས་སུ་རལ་གྲི་ཕྱུང་བརྡེག་གི་དཔེ་བཞིན་གྲུབ་ངེས་ཀྱི་གདིང་ཚོད་དང་ལྡན་པར་བྱ་སྟེ།",
    "ཐུན་མོང་གི་གྲུབ་པ་བརྒྱད་སྒྲུབ་པ་རྣམས་ནི་གཞུང་གིས་གསལ།",
    "དེའི་དམིགས་བཟླས་རྫས་རྣམས་གཞུང་གིས་གསལ་ཞིང་འདོན་ཆ་ཟུར་དུ་ཤེས་པར་བྱའོ།",
    "གདོན་སྲུང་གི་རྫས་ལ།",
    "དེ་བོད་དུ་འབྱོར་དཀའ་བས་མཛོ་མོ་ཤིང་གི་བར་ཤུན་གྱིས་ཆོག་སྐད་འདུག་གསུངས་སོ།",
    "དཔལ་གྱི་སྒོ་ཞེས་པ་ས་འོག་གི་བུག་པའི་མིང་སྟེ་དེར་འཇུག་ནུས་ན་ལྷ་མིན་དང་གནོད་སྦྱིན་གྱི་སྲུ་མོ་སོགས་ཀྱིས་བཅུད་ཀྱི་ལེན་དང་གཏེར་སྦྱིན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "པདྨ་ཅན་ནི་བུད་མེད་རིགས་ལྔའི་ནང་ཚན་གྱི་པདྨ་ཅན་ཏེ་བརྟག་ཐབས་སོགས་གཞན་ན་གསལ་བ་བཞིན་ནོ་ དེའི་དང་པོའི་རྡུལ་ནི་ཐོག་མར་བབ་པའི་པདྨ་རཀྟའོ།",
    "དེའི་བརྟག་ཐབས་རྒྱུད་རྣམས་སུ་གསལ་ཞིང་གནམ་སྟོང་གི་དུས་སུ་ཚིལ་ཆེན་གྱི་མེ་སྦར་ལ་བྱ་རྒོད་ཀྱི་རྐང་སྦུབས་ནས་བལྟས་པས་གྲིབ་མ་བདུན་འཆར་བ་དེའི་ལུས་ཀྱི་གནས་གང་རུང་དུ་གི་ཝཾ་ལྟར་ཆགས་པ་ནི་རོ་ཙ་ན་སྟེ་དེ་རྙེད་ན་མཁའ་སྤྱོད་ཀྱི་རྫས་མཆོག་ཡིན་ནོ།",
    "དྲིའི་རྫས་ནཱ་གི་གླ་རྩི།",
    "ཁྲོས་པའི་ཁྲོ་གཉེར་དང་བཅས་དཔུང་གི་ཚོགས།",
    "རྡོ་རྗེ་འཆང་གིས་རྗེས་སུ་གནང་བ་ཡི།",
    "འདི་ལྟ་བུ་བྲིས་ཤིག་པའི་གསུང་གི་རྗེས་སུ་གནང་བ་ལ་བརྟེན་ནས་བདག་མི་ཕམ་རྣམ་པར་རྒྱལ་བའམ་པདྨ་བཞད་པ་རྩལ་གྱིས་རྒྱལ་ཟླའི་དམར་ཕྱོགས་ཀྱི་ཚེས་བཅུ་ལ་གྲུབ་པར་བགྱིས་པ་འདིས་མཐའ་ཡས་པའི་འགྲོ་བ་ཀུན་གྱིས་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་རང་གཟུགས་བདེ་ཆེན་ལྷན་ཅིག་སྐྱེས་པའི་ཌཱཀི་ནཱིའི་གོ་འཕང་མྱུར་དུ་ཐོབ་པར་གྱུར་ཅིག།",
    "ན་མོ་གུ་རུ་མཉྫུ་གྷོ་ཥཱ་ཡ།",
    "རྟེན་གནས་དུས་དང་ཡོ་བྱད་ཆོ་ག་ཕུན་སུམ་ཚོགས་པ་ལྔ་ཡི་ཐོག་མར་གང་གིས་སྒྲུབ་པ་པོ་རྟེན་གྱི་གང་ཟག་ནི།",
    "སྒྲུབ་པ་ཆུད་མི་ཟ་བ་དམ་ཚིག་དང་སྡོམ་པ་ཉིད་ལ་རག་ལས་པར་ཡིད་ཆེས་པས་སྲུང་སྡོམ་སྲོག་གི་ཕྱིར་ཡང་མི་གཏོང་བ་དང་།",
    "དེའི་རྩལ་ལས་སྣང་སྲིད་དཀྱིལ་འཁོར་གསུམ་དུ་ཡིད་ཆེས་པ་ཟབ་མོའི་ལྟ་བ་དང་ལྡན་པའི་སྒོ་ནས།",
    "སྔགས་ཀྱི་སྟོབས་བསྐྱེད་པའི་མཐུན་རྐྱེན་ཐབས་ཟབ་མོ་རྣམས་ཀྱང་ཚོགས་པར་བྱས་ན་མྱུར་དུ་འགྲུབ་པར་བྱེད་པ་ཡིན་པས་དེ་ལྟ་བུ་སྤྱིར་བཏང་ནས།",
    "ཡི་དམ་ཁྲོ་བོའི་རིགས་གང་ལ་ཡང་ཞི་བར་བསྙེན་པ་སྔོན་དུ་སོང་ན་དགེ་ཞིང་ཤིས་པར་གསུངས་པས།",
    "མཚམས་གྲོལ་གྱི་བར་དུ་ཡེངས་མེད་ཀྱི་ཏིང་འཛིན་གཙོ་བོར་བྱས་ཏེ་སྒོ་གསུམ་ཆུན་གཅིག་དྲིལ་གྱི་ཐུན་རེ་རེ་བཞིན་སྔ་མ་ལས་ཕྱི་མ་ཇེ་བཟང་ཇེ་བཟང་གི་ཁྱད་པར་དུ་གྱུར་པ་ཞིག་བྱའོ་སྙམ་པའི་དམ་བཅའ་ལྷོད་མེད་ཀྱིས་བྱ་བ་མཐར་འདོན་པ་གལ་ཆེ་ཞིང་།",
    "གཞན་ཡང་ནང་གི་མཚམས་བཅད་སོགས་སྒྲུབ་ཆེན་གྱི་ཡན་ལག་དག་ཀྱང་གྲུབ་ན་ལེགས།",
    "རང་ཁ་ལྷོར་ཕྱོགས་ཏེ་འདུག་ཅིས་ཀྱང་གནས་ཁང་གི་སྟབས་མ་བདེ་ན་ཡིད་ཀྱིས་མོས་པ་ཙམ་བསྒྱུར།",
    "བསྡུ་ན་སྟེགས་བུ་རཀ་ཏས་བྱུགས་པའི་སྟེང་དུ་འབྲུ་ནག་ཁྲག་གིས་སྤག་པའི་ཚོམ་བུ་བཀོད་པའི་དབུས་སུ་གཏོར་མ་སོགས་བཤམ་པར་བྱ་སྟེ།",
    "བྱང་ཤར་དུ་མཚམས་འཛིན་གྱི་མེ་ཏོག་དེ་ནས་རིམ་བཞིན་གཡས་སྐོར་དུ་ཁྲག་གི་མཆོད་ཡོན།",
    "དུག་གི་མེ་ཏོག་སྔོན་པོ་སོགས་ཐུན་མོང་གི་ཉེར་སྤྱོད་དང་ཆུ་གཉིས་ཀྱང་བཤམ།",
    "མེད་ཀྱང་ཆོག་བམ་བསྐང་གི་མདུན་དུ་གཡག་ལུག་ར་གསུམ་གྱི་གཟུགས་བརྙན་བཀོད་པ་མདངས་བསྐང་དང་།",
    "མཆོད་གཏོར་འདོད་ཡོན་ལྷ་མོ་དྲུག་ཏུ་བསྐྱེད་པ་འདི་པའི་ལུགས་སོ།",
    "ཨཱ་མི་རྟོག་ངང་ལས་སོགས་ཚིགས་བཅད་གཅིག་གིས་སྤྱན་དྲངས་ལ་བསྟིམ།",
    "གཏོར་བསྔོ་སོགས་དགོང་མོའི་ཆགས་མེད་རྣམས་བར་དེར་མཛད།",
    "དེ་རྗེས་སྲོད་ཐུན་ལ་ལས་བྱང་རེ་གཏོང་ཞིང་ཚོགས་འཁོར་རེ་མཛད་ན་ལེགས་པས་ལས་གཞུང་བསྲང་།",
    "གཏེར་སྲུང་གསོལ་ཞིང་ཚོགས་བྱ་སྟེ་ལས་གཞུང་བསྡུ།",
    "ནུབ་རེ་བཞིན་ཚོགས་མི་གཏོང་ན་བདུན་མཚམས་སོགས་སུ་བཏང་བས་ཆོག་ལ་གཏེར་སྲུང་གི་གསོལ་ཁ་ནི་རྒྱུན་དུ་བྱའོ།",
    "ཤ་ཁྲག་གི་གཏོར་མ་བཤམས་ལ་བསྔོ།",
    "ནང་སྐོར་གསུང་གི་དྲག་སྔགས།",
    "དེ་རེ་རེ་ལའང་།",
    "ཕྲིན་ལས་བཞིའི་དམིགས་པ་དང་བཞི་རེར་ཡོད་ཀྱང་དམིགས་པ་བཞི་པོ་དེ་དག་ཐུན་རེ་རེ་བཞིན་དུ་ཆ་ཚང་རེ་བྱེད་པའི་ལུགས་ཡོད་ཀྱང་།",
    "དེ་དག་ཀྱང་བློས་བཅོས་པའི་ཀུན་བཏགས་ཙམ་མིན་པར་གཞི་འབྲས་དབྱེར་མེད་རང་བྱུང་གི་ཡེ་ཤེས་ཆེན་པོའི་རང་རྩལ་རྟགས་ཀྱི་ཕྱག་རྒྱར་སྣང་བའི་རྣམ་དག་དང་བཅས་པའི་ཏིང་འཛིན་ཆུ་བོའི་རྒྱུན་གྱི་རྣལ་འབྱོར་ལ་གནས་པ་ནི་ཐོག་མཐའ་བར་གསུམ་ཀུན་ཏུ་གལ་ཆེའོ།",
    "བདག་གི་ཐུགས་ཀའི་ཐུགས་སྲོག་སྔགས་ཕྲེང་དང་བཅས་པ་ལས་འོད་ཟེར་སྔར་ལྟར་འཕྲོས་པ་ཐུགས་ཀ་ནས་ཕྱིར་ཕྱུང་ཚེ་ལྕགས་ཀྱུའི་རྣམ་པ་ཅན་དུ་གྱུར་པ་དཔག་ཏུ་མེད་པས་ཛབ་ཁང་གི་ལྷ་ཚོགས་ཀྱི་ཐུགས་རྒྱུད་བསྐུལ།",
    "ཨཱ་ལི་ཀཱ་ལིའི་རྣམ་པ་རང་སྒྲ་སྒྲོགས་པ་དཔག་ཏུ་མེད་པར་བྱུང་ནས་རང་གི་མགྲིན་པར་ཐིམ་པས་ངག་སྔགས་ཀྱི་སྒྲ་དབྱངས་འབྲུག་སྟོང་ལྟར་ལྡིར་བའི་གྲགས་སྟོང་གཞོམ་མེད་ཡན་ལག་དྲུག་ཅུ་དང་ལྡན་པའི་གསུང་གི་དངོས་གྲུབ་མ་ལུས་པ་ཐོབ།",
    "ཡང་རང་གི་ཐུགས་ཀའི་འོད་ཀྱིས་མདུན་བསྐྱེད་བསྐུལ་ཞིང་དེའི་འོད་ཀྱིས་མ་དག་པའི་སྣོད་བཅུད་ཐམས་ཅད་སྦྱངས།",
    "རང་གི་རྟེན་དང་བརྟེན་པ་ལ་སོ་སོར་ཐིམ་པས་གཟི་བརྗིད་རྒྱས་པར་བསམ་མོ།",
    "རང་གི་ཐུགས་ཀའི་སྔགས་ཕྲེང་ལས་འོད་མཐིང་ཤས་ཆེ་བ་འཕྲོས།",
    "ལྗགས་དང་དུང་ཁང་གི་འགྲོ་ལུགས་སྔར་ལྟར་ལ།",
    "རང་གི་བླ་ཚེ་བརྐུས་འཕྲོག་ཡར་བ་ནི་ཡིག་དང་འོད་དང་བདུད་རྩིའི་རྣམ་པ་དང་།",
    "ཤྲཱི་ཡ་མཱནྟ་ཀ་ས་མ་ཡ་སྟྭཾ་ཧོ་ཞེས་འཛབ་ཁང་གི་ལྷ་བདག་ཉིད་ལས་ལོགས་སུ་མེད་ཀྱང་ཆུ་ཟླ་ལྟར་གསལ་བ་ལ་རིག་པའི་མེ་ཏོག་འཐོར།",
    "ལྷུན་གྲུབ་རང་བཞིན་གནས་པའི་སོགས་ཀྱིས་དངོས་གྲུབ་བླངས་ཏེ་མདུན་གྱི་ལྷའི་གནས་ལྔའི་ཡི་གེ་ལྔ་ལས་འོད་ལྔ་བྱུང་བ་རང་གི་གནས་ལྔར་ཐིམ་པས་དངོས་གྲུབ་ཐམས་ཅད་ཐོབ་པར་བསམ།",
    "ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀའི་ཧཱུྃ་གི་མཐར་འབྲུ་བཅུ་གཉིས་པ་ཁ་དོག་མཐིང་གས་བསྐོར་བ་ལས་འོད་ཟེར་འཕྲོ་འདུ་ཐམས་ཅད་སྤྱི་བསྙེན་དང་འདྲ་ཞིང་ཐུགས་ཀ་ཙམ་དུ་མ་ཟད་བ་སྤུའི་བུ་ག་ཐམས་ཅད་ནས་འཕྲོ་བ་དམིགས་བསལ་ལོ།",
    "གསུམ་པ་ནང་སྐོར་གསུང་གི་དྲག་སྔགས་ལ་གཞན་ཐམས་ཅད་སྐུ་བསྙེན་ཇི་ལྟ་བ་ལ་བ་སྤུའི་བུ་གའི་ཚབ་ཏུ་ལྗགས་ཀྱི་རྩེ་མོ་ལས་འོད་ཟེར་མེའི་ཚྭ་ཚྭ་འཕྲོ་བ་དམིགས་བསལ་ལོ་ གཞན་བཞི་པོ་ཁ་བསྒྱུར་ཏེ་ཨེ་མྱག་སོགས་འབྲུ་བརྒྱད་པ་ཉིད་ཨཱ་ཀོའི་ཚབ་ཏུ་བྱའོ།",
    "དུང་ཁང་གི་ཨོཾ་གྱི་མཐར་སྐུ་སྔགས་འབྲུ་བཅུ་གཉིས་པ་དཀར་པོ།",
    "ཨཱ་ཀྲོ་འབྲུ་བཅུ་བདུན་པ་གོང་བསྙེན་ཡིན་ཏེ་འདི་སོང་ན་འཚུབ་ཆུང་ཞིང་བྱིན་ཆེ་བ་ཡིན་པས།",
    "དེ་ནས་སྐུ་ཡི་སྔགས་དྲག་པོ་སྔགས་ཀྱི་འབྲུ་བཅུ་གཉིས་པ་དེ་ནི་ཞལ་གྱི་དམོད་པ་དྲག་པོ་མངོན་དུ་ཕྱུང་བ་གསང་ཆེན་རིགས་གཅིག་ཏུ་དྲིལ་བའི་སྔགས་ཐམས་ཅད་ཀྱི་རྩ་བ་ཡིན་ཏེ་ཀུན་གྱི་མགོ་ལ་བགྲང་བར་བྱའོ།",
    "ཞེས་གསུངས་པ་ལྟར་བསྙེན་ཚད་འབྲུ་འབུམ་དུ་གསུངས་ཀྱང་གཞན་ཀུན་བཟླ་ན་འབུམ་གཅིག་གིས་ཀྱང་ཆོག་པར་གསུངས།",
    "ལས་རུང་ཙམ་དུ་ཐམས་ཅད་བཟླ་ན་འབུམ་རེ་རེ་དང་།",
    "རྒྱས་པར་ན་འབུམ་ཕྲག་བཅུ་རེ་བཟླ་བར་བྱ་སྟེ།",
    "རུས་སྦལ་གྱི་ཐུགས་ཀར་འཁོར་འདས་སྲོག་གི་དྭངས་མ་རྒྱ་གར་གྱི་ཡི་གེའི་གཟུགས་ཅན་གྱི་ཨེ་མཐིང་ག་དང་དེའི་ནང་ཀ་མཐིང་སྐྱ་འདི་ལྟ་བུ།",
    "བྱ་ཁྱུང་གི་ཐུགས་ཀར་ཁྲོཾ།",
    "སོ་སོའི་ས་བོན་གྱི་མཐར་ཨྱེ་རིང་གི་རཀྴ་མོནྟ་ཡན་རྫོགས་པའི་མཚམས་སུ་གནོད་བྱེད་ཨ་མུ་ཀ་མྱགས་ཐུམ་རིལ།",
    "ནང་དུ་འདོད་ཆགས་ཀྱི་ཁྲག་མཚོ་འཁྱིལ་ཞིང་ཞེ་སྡང་གི་མེ་འབར་བ།",
    "ཕྱི་ན་གཏི་མུག་གི་མུན་པ་འཐིབ་པ།",
    "ཉམ་ཐག་མྱ་ངན་གྱི་འདུག་སྟངས་ཅན་ཡན་ལག་སྦྲུལ་དང་ལྕགས་སྒྲོག་གིས་བསྡོམས་པ་འཆོར་བ་མེད་པར་བསམས་ལ།",
    "ཨ་མུ་ཀ་ཞེས་པ་དམིགས་བྱའི་དགྲ་བགེགས་སྤྱི་ཡི་མིང་དོད་ཡིན་པས་སྟོང་སྲོག་དེ་དང་།",
    "ཞི་བར་བསྙེན་པ་ཐེངས་ནས་རྒྱུན་ཛབ་སོགས་ཐམས་ཅད་ལ་སྤྱང་མོ་བཏགས་པ་འདི་ལེགས་ཞེས་རིག་འཛིན་གོང་མ་དག་གསུངས།",
    "བྱེ་བྲག་ཏུ་ཕ་རོལ་གྱི་སྟོབས་གཞོམ་པ་ལ་སོགས་པའི་ཆེད་དུ་སྲོད་དང་ཐོ་རངས་བརྒྱ་རྩ་རེ་བཟླ་བར་བྱའོ།",
    "མ་གྲུབ་ན་ཤིང་ལྕགས་ཀྱི་ཧོཾ་ཁུང་ངམ་ལྕགས་སླང་ལྟ་བུར་སྟོང་སྲོག་སྤྱང་མོ་དྲུག་གི་འཁོར་ལོ་ལས་གཟིར་སྤྱང་ཅན་ཚད་ལྡན་བྲིས་པ་སྤྱང་ཁྲུས་རྫས་བྱུག་སོགས་ལག་ལེན་ལྟར་བྱས་པ་བཅུག་ཐུན་རེ་ལ་ལས་གཞུང་བསྲངས་ཏེ་ཨེ་རིང་རྣ་ལམ་བརྒྱ་ཕྲག་ཙམ་རེ་བཟླས་མཆོད་བསྟོད་བྱས་ཟིན་པ་དང་།",
    "བྲུབ་ཁུང་ལིང་ག་བསྐྱེད་པ་དགུག་གཞུག་ལྷ་དབྱེ་སོགས་རྒྱས་བསྡུས་ཅི་རིགས་སོང་ནས།",
    "ཁོའི་སྲོག་གི་ངོ་བོ་ཁྲག་གི་སྦལ་པ་བྱེའུ་ལན་པའི་མགོ་བོ་ཙམ་ཞིག་གི་ནང་ན་རྒྱ་གར་གྱི་ཡི་གེ་ཡ་དམར་ནག་གི་དབུས་ན་མ་དང་མའི་མིག་ན་ནྲྀ་ལྗང་གུ་ཞིག་གནས་པ་ལ།",
    "ཁོའི་སྲོག་གི་ངོ་བོ་ནྲྀ་རུ་གནས་པ་དང་།",
    "གང་ལྟར་ཀྱང་ཞག་བདུན་དགུ་སོགས་བསད་རྟགས་བྱུང་གི་བར་བྱས་ནས།",
    "སྟོང་སྲོག་འཁོར་ལོའི་ལྟེ་བ་གྲུ་གསུམ་ནང་གི་ལིངྒ་དེ་གྲིས་དྲས་ཏེ་བཏོན་ལ་དྲག་པོའི་སྦྱིན་སྲེག་གམ།",
    "ལྟེ་ལིང་བཏོན་པའི་སྟོང་སྲོག་འཁོར་ལོ་དེ་སྲུང་བའི་ཕྱིར་རང་གི་མལ་སྟེང་དུ་བླ་བྲེ་ལྟར་ཕུབ།",
    "དེ་ལྟར་བསྙེན་སྒྲུབ་ལས་ཀྱི་སྦྱོར་བ་དེ་དག་གི་སྐབས་སུ་བསྙེན་པ་དང་།",
    "བསད་བཟློག་གི་གྲུབ་རྟགས་རྣམས་རྟགས་ཚད་ཀྱི་ཡི་གེ་བཞིན་དུ་ཤེས་པར་བྱས་ལ་བསྲུང་བསད་བཟློག་པའི་ལས་མཐའ།",
    "དེ་ཡང་རྩ་བསྙེན་དང་ཁ་སྐོང་གི་སྦྱིན་སྲེག་དང་བཅས་པ་སོང་ན་ལེགས་ཤིང་ཚུལ་དེ་ལྟ་བུས་ལྷ་ཡི་དངོས་གྲུབ་གྲུབ་པའི་རྟགས་རྫོགས་ཤིང་།",
    "གྲངས་ཀྱི་བསྙེན་པ་ཡོངས་སུ་རྫོགས་པའི་ཚེ་སང་མཚམས་གྲོལ་བའི་དེ་རིང་གི་དགོང་མོར་དངོས་གྲུབ་ཀྱི་རྫས་བམ་ཆས་སུ་བཅུག་པ་ཡོད་ན་དེས་འཐུས།",
    "ལས་བྱང་གཞུང་བསྲང་ཚོགས་ཐ་མ་ཡན་བཏང་།",
    "སྟོང་པའི་ངང་ལས་ཚེ་འབྲང་གི་རྣམ་པ་ལ་དབུས་སུ་ཚེ་དཔག་མེད་དམར་པོ་གོས་དཀར་མོ་དང་འཁྲིལ་བ་མཉམ་བཞག་གིས་བུམ་པ་འཛིན་པ།",
    "ཤར་དུ་དབྱིངས་ཕྱུག་མ་སྔོན་མོ།",
    "ལྷོར་མཱ་ཀི་སེར་མོ།",
    "དེ་ནས་དངོས་གྲུབ་བསྡུ་བ་ནི་བདག་ཟིལ་གནོན་དུ་གསལ་བའི་སྐུ་གསུང་ཐུགས་ཡོན་ཏན་ཕྲིན་ལས་ལྔའི་ས་བོན་ལས་འོད་གློག་གི་ཞགས་པ་ལྟར་རྣོ་ཞིང་མྱུར་བ་སྤྲོས་ནས་འཁོར་འདས་ལམ་གསུམ་གྱི་དཔལ་ཡོན་དྭངས་བཅུད་ཚེ་སྟོབས་རྣམས་དངོས་གྲུབ་ཀྱི་རྫས་ལ་ཐིམ་པར་བསམས་ལ།",
    "དེ་འོད་དུ་ཞུ་ནས་རང་གི་ལུས་ངག་ཡིད་ལ་ཐིམ་པས་དངོས་གྲུབ་མ་ལུས་པ་ཐོབ་པར་བསམས་ལ་དངོས་གྲུབ་བསྐུལ་བའི་ཚིག་དང་སྔགས་ཚིག་གིས་རྫས་རྣམས་གནས་གསུམ་དུ་རེག་ཅིང་མྱང་བར་བྱ།",
    "དེ་ལྟར་བསྙེན་སྒྲུབ་དེ་དག་གི་མི་མཐུན་པ་སྤང་ཞིང་མཐུན་པའི་རྐྱེན་སྔགས་ཀྱི་ནུས་པ་བསྐྱེད་པའི་རིགས་ལ་འབད་པས་སྔགས་ཀྱི་འབྲས་བུ་མྱུར་དུ་འབྱིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "ཐུགས་མཚམས་མ་གྲོལ་བར་ཉོན་མོངས་དྲག་པོས་བར་བཅད་པ་སྟེ་མཚམས་གསུམ་རལ་བ་སྤང་།",
    "སྨ་ར་དང་ཨག་ཚོམ་མི་བྲེག་རང་གི་ཉལ་མལ་དུ་གཞན་མི་གཏོང་།",
    "དུས་ལ་བཟླས་ཞེས་བསྙེན་ཐུན་གྱི་དང་པོ་ནས་ཐ་མའི་བར་ངེས་ཅན་ཁྲིགས་ཆགས་སུ་བསྟར་བ་ལས་རང་གི་དལ་ཁོམ་དང་བསྟུན་པའི་ཐུན་དང་བཟླས་ཚད་གང་བབ་བྱས་པས་མི་འཐུས་སོ།",
    "རྫུན་སོགས་ལུས་ངག་གི་སྤྱོད་ལམ་དང་།",
    "རྒྱུན་དུ་བསགས་སྦྱོང་གི་རིགས་དང་སྦྱིན་སྲེག་ལ་སོགས་པའི་ཐབས་ཁྱད་པར་ཅན་གྱིས་སྔགས་ཀྱི་གཟི་བྱིན་དང་སྟོབས་བསྐྱེད་པར་བྱའོ།",
    "ཐ་མ་གསང་སྔགས་ཀྱི་བཟླས་པ་ཚད་དང་ལྡན་པར་སོང་བའི་སྒྲུབ་པ་པོས་བྱ་བ་ཡིན་ཏེ།",
    "ཁྱད་པར་དུ་དྲག་པོའི་ལས་བསྒྲུབ་པ་ལ་ཨུར་མོ་ལས་དྲུག་ཏུ་གྲགས་པ།",
    "བསྙེན་སོང་རྣམས་ཀྱི་རྒྱུན་གྱི་ཡི་དམ་ལ།",
    "ཟླ་སྒྲུབ་ཞག་གིས་བཤིག་པ།",
    "དང་པོ་རང་གི་སྔགས་ཀྱི་འོད་ཟེར་གྱིས་སྒོ་གསུམ་གྱི་སྒྲིབ་པ་སྦྱངས།",
    "འོད་སླར་འདུས་པས་འཁོར་འདས་ཀྱི་དྭངས་བཅུད་རང་ལ་འདུས་ཏེ་གཞོམ་མེད་ཡེ་ཤེས་ཀྱི་སྐུ་ཤིན་ཏུ་བརྗིད་པ་ལ་བ་སྤུ་ཐམས་ཅད་རྡོ་རྗེའི་ཁྲོ་ཆུང་གིས་གཏམས་ཤིང་།",
    "ཡེ་ཤེས་ཀྱི་འོད་ཟེར་འདུས་པའི་རྡོ་རྗེའི་མཁར་མགར་གྱི་སོལ་མལ་ལ་ལྕགས་ཞུན་ཁོལ་བ་ལྟ་བུའི་ཚྭ་ཚྭ་འཕྲོ་ཞིང་གཅོད་བྱེད་མཚོན་ཆའི་འཁོར་ལོ་མང་པོ་འཕྲོས་པས་གླགས་ལྟ་བ་ཐམས་ཅད་བུན་བུན་ཚིག་ཅིང་མྱལ་མྱལ་གཏུབས་པས་གང་གིས་མི་ཚུགས་པར་བསམས་ལ་སྔགས་བཟླ་བའོ།",
    "གཉིས་པ་གཞན་འཇོམས་པ་ལ་དཀྱིལ་འཁོར་གྱི་ལྷ་དང་སྤྲུལ་པའི་ཁྲོ་བཅུ་ཞལ་ཕྱིར་གཟིགས་ཏེ་སྔགས་སྒྲ་འབྲུག་སྟོང་ལྟར་བསྒྲགས་པའི་ཞལ་ནས་སྔགས་ཀྱི་འོད་ཟེར་འཕྲོ་ཞིང་འབར་བས་རྩ་སྤུར་མེ་ལ་བསྲེག་པ་ལྟར་ཕ་རོལ་པོ་ཐལ་བ་བུན་བུན་སོང་བར་བསམས་ལ་ཨྱེ་རིང་ཨེ་ཐུང་བཟློག་ཤམ་ཅན་བཟླའོ།",
    "སྔགས་ཀྱི་འོད་ཟེར་མཚོན་ཆ་གནམ་ལྕགས་དང་སྤུ་གྲིའི་སོ་ལྟ་བུས་མྱལ་མྱལ་གཅོད་པར་བསམ་མོ།",
    "དེ་ལ་སྤྱང་མོ་དྲུག་ལས་དང་པོ་གཟིར་བ་ནི།",
    "ཨྱེ་རིང་གི་མཐར་གཟིར་བའི་གཡུ་སྤྱང་འདི་བཏགས་སོ།",
    "ཨ་མུ་ཀ་མྱག་ཐུཾ་རིལ།",
    "འདི་ལ་དགྲ་བགེགས་དམིགས་བསལ་ཡོད་ན་དེའི་མིང་ཨ་མུ་ཀའི་ཚབ་ཏུ་གཞུག་མེད་ན་གང་ལ་དམིགས་ནས་ཨ་མུ་ཀ་ཞེས་བརྗོད་པས་ཆོག་གོ།",
    "དེ་བཞིན་སྤྱང་མོ་ཀུན་ལ་འགྲེ།",
    "བཤིག་པ་གཡུ་ཡི་སྤྱང་མོ་འདི་སྔགས་ཤམས་ལ་བཏགས་ནས་བཟླའོ།",
    "ཨ་མུ་ཀ་དུ་རཾ་ཏྲི་ཡཾ་འདྲིད་ཕྱུང་སྲོག་ལ་གཟིར་མནན་ཕྱུང་།",
    "ཞེས་ཟུག་པ་དབྱུང་བའི་སྤྱང་མོ་འདི་བཏགས་ལ་བཟླས་སོ།",
    "གཏོར་མ་འཕང་བ་ལ་ཁྱིས་རུབ་པ་བཞིན་དགྲ་པོའི་ཤ་ཁྲག་ཧབ་ཐོབ་ཏུ་ལྷག་མ་མེད་པར་ཁྱེར་ཏེ་སྟོང་ཧ་རེ་སོང་བར་བསམས་ལ།",
    "ཨ་མུ་ཀ་མནྟྲ་དུཾ་མ་ཧཱ་རག་དུ་རཾ་ཐུམས་རིལ་རྦད",
    "ཨ་མུ་ཀ་ཨེ་ནན་ཡཾ་བཟློག་འདྲིད་བྷྱོ་ཨེ་ཧུར་ཐུམ་ཛ་ཁཾ་ཤག་རོ་མྱགས་མུགས་ཏི་རྦད་ཡ",
    "རི་རབ་སྟོང་ལས་ཀྱང་ལྗིད་ཆེ་བའི་གནམ་ལྕགས་ཀྱི་ཕུར་བུས་ཐལ་བྱུང་དུ་ཕུག་སྟེ་འོག་གཞི་ལ་གཟེར་བཏབ་པས་བསྐལ་པའི་བར་དུ་གཡོ་འགུལ་ཙམ་ཡང་མེད་པར་མནན་ཞིང་ཕུར་བུ་ལས་དུག་དབལ་མི་བཟད་པ་འཕྲོས་པས།",
    "ཨ་མུ་ག་བྷི་ཏཾ་སྟྭམྦྷ་ཡ་ནན་ཨེ་ཧུར་ཐུཾ་ཛ་ཁཾ་ཤག་རོ་མྱགས་མུགས་ཏི་རྦད་ཡ་ཞེས་པ་མནན་པའི་གཡུ་སྤྱང་འདི་སྔགས་ཤམ་ལ་བཏགས་པ་བཟླའོ།",
    "དེ་ལྟར་སྔགས་ཤམས་ཀྱི་གཙོ་བོ་སྤྱང་མོ་དྲུག་པོ་འདི་ནི་ཞེ་སྡང་ཁྲོས་པའི་གཞུ་བཅག་པ་ཡིན་ལ་གཞན་དུ་རྒྱས་པར་ཕྱེ་ན་སྤྱང་མོ་བཅུ་བཞི་སོགས་སྔགས་ཀྱི་ལས་ཤམ་མདེའུ་ཁ་སྒྱུར་ཚུལ་ཤིན་ཏུ་མང་པོ་ཡོད་པ་གཞུང་ལས་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་བསྲུང་བཤིག་བསད་བཟློག་མནན་དཀྲུག་གི་ལས་དྲུག་པོ་འདི་ལས་འཕྲོས་པའི་ལས་ཁོལ་བུ།",
    "ཨུར་མོ་གྱང་འགྱེལ་གྱི་ལས་བཞི་དང་།",
    "བཤིག་པའི་ལས་བཞི་མནན་པའི་ལས་བཞི་ལ་སོགས་པ་མན་ངག་གི་རིམ་པ་ཤིན་ཏུ་མང་པོར་བཞུགས་པ་དག་ཀྱང་ཤེས་པར་བྱའོ།",
    "ཨུར་མོ་ལས་དྲུག་གི་ལས་དང་པོ་གཉིས་སྒྲུབ་པའི་སྐབས་སུ་སོང་ནས།",
    "བཞི་པའི་གཡུ་སྤྱང་དྲུག་གི་གཟིར་བ་སོང་།",
    "སྦྱིན་སྲེག་གི་ཐལ་བ་ཆ་གཅིག་ལིང་ག་ཆ་གཅིག་དང་མཉམ་དུ་མནན་པའི་ཆས་བྱའོ།",
    "དེ་ཡང་སྟོང་སྲོག་འཁོར་ལོ་སྟེང་དུ་བཀོད་ནས་མེ་ལྕེས་མི་རེག་པར་བྱས་ལ་ཉིན་གུང་དྲག་པོའི་སྦྱིན་སྲེག་གྲུབ་ནས་དེའི་དགོང་མོར་དངོས་གྲུབ་བླང་།",
    "ཕྱིར་ནང་ཡང་ལས་གཞུང་བསྲངས་ལ་ཨྱེ་རིང་བྱས་པ་བཤིག་པའི་སྤྱང་མོ་ཅན་དང་།",
    "དེའི་ཚེ་ལས་གཞུང་གི་བཟླས་པ་མཆོད་བསྟོད་དང་སྨད་ལས་ཀྱི་ཨེ་ཁང་དགུག་གཞུག་ལྷ་དབྱེ་བར་སོང་ནས།",
    "གསལ་བ་གསུམ་ལྡན་གྱི་ཏིང་འཛིན་དང་ལྡན་པས་བསད་སྔགས་ཅུང་ཟད་བཅས་བསྒྲལ་བསྟབ་བྱས་རྗེས་བཟློག་བསྐུལ་བྱས་ལ་བཟློག་དམིགས་སྦྱར་བའི་སྒོ་ནས་བཟློག་པ་གཡུ་སྤྱང་གི་ཤམ་ཅན་ཅི་འགྲུབ་རེ་བཟླས་ནས་བཟློག་པ་འདོན་ཞིང་ལས་གཞུང་གཞུང་བཞིན་བསྡུ།",
    "ཡར་ལོག་ནས་སྒོ་དྲུང་དུ་གཏོར་གཞོང་ཁ་སྦུབ་དམ་སྲི་དགྲ་བགེགས་བཀུག་ལ་མནན་པ་གཡུ་སྤྱང་གི་སྔགས་དམིགས་སྦྱར་རྗེས་བྲོ་བརྡུང་ལ་གཏོར་གཞོང་དུ་ནས་འཐོར་བཀྲ་ཤིས་བརྗོད།",
    "དེ་རྗེས་ཉི་མ་གཅིག་ཙམ་ལ་ལས་གཞུང་བསྲངས་ནས་གསང་ལམ་དགག་པའི་སྤྱང་མོའི་བཟླས་དམིགས་སྦྱར།",
    "མིན་ཀྱང་ཐལ་བ་དང་ལིང་ག་གཏད་དམིགས་སུ་ཆོ་ག་བཞིན་ཏུ་མནན་ལ་མནན་པའི་གཡུ་སྦྱང་ཞག་གཅིག་ཙམ་བཟླ་ཞིང་རྡོ་རྗེའི་བྲོ་ཡི་ལས་རྒྱས་པར་བྱའོ།",
    "དེ་དག་གིས་ལས་ལྔ་པ་དང་བཞི་པ་སོང་ཞིང་དྲུག་པ་ནི་སྐབས་འདིར་བྱ་དགོས་པ་མ་ཡིན་ནོ།",
    "གསུམ་པ་བསྙེན་སྒྲུབ་ཀྱི་སྐབས་སུ་མཆོད་སྒྲུབ་བརྟེན་སྐོང་གི་རྫས་དང་།",
    "དེ་དག་གི་ཚུལ་རྒྱས་པ་ནི་པད་གནུབས་ཀྱི་མན་ངག་ལྕགས་འདྲ་སྡིག་གི་དཔེ་པོད་སོགས་ལས་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་གཙོ་གིང་གི་དྲག་སྔགས་དང་།",
    "དགེའོ། ། དཔལ་ཚེ་བདག་བསྙེན་ཡིག་གི་ལྷན་ཐབས་དངོས་གྲུབ་སྒོ་འབྱེད་བཞུགས་སོ།",
    "སྟེང་དང་ནང་གི་ཟུར་དང་བཤོས་བུ་དྲུག་རྩ་ལྷ་གཞན་དང་གཤེད་བཞི།",
    "མོན་བདུད།",
    "ནང་གི་གྲི་རིས་ལ་ཚོན་བཀྲ་བྱ།",
    "གཙོ་གཏོར་གྱི་རྩེ་མོ་ཅུང་བཅད་པ་ལ་ནོར་བུ་འབར་བའི་རྒྱན་སྤྲོས་དང་གཙོ་འཁོར་གྱི་གཏོར་མའི་ཕྱི་ཡི་ཁྱུད་སྐོར་དང་།",
    "འཁོར་དྲུག་དང་མདུན་གྱི་འབུར་ཐབས་ཀྱི་རྩེ་མོར་མེ་རིས་བརྒྱན་པ་སོགས་ཞིབ་པར་མཐོང་རྒྱུན་ལྟར་བྱ།",
    "སྔར་གྱི་དཔེ་རིས་རྣམས་སུ་གཙོ་གཏོར་གྲུ་གསུམ་རྩེ་མོ་ཟང་ཡག་ཏུ་བྱས་པའི་རྩེར་ཉི་ཟླ་མེ་རིས་བརྒྱན་པར་བྱས་པ་འདུག་གོ།",
    "འོག་ཏུ་ལིང་ག་བཞག་པ་འཐེབ་སྐྱུ་གྲངས་མང་དང་ཤ་ཁྲག་གིས་བརྒྱན་ལ་མེ་རིས་རྒྱན་སྤྲས་བྱས་པས་ཆོག་གོ།",
    "བམ་གྱི་པུས་མོའི་བར་དུ་ཚིལ་ཆེན་གྱི་མར་མེ་དང་།",
    "གཡས་གཡོན་རྒྱབ་ཏུ་གཡག་ལུག་ར་གསུམ་གྱི་གཟུགས་བརྙན་མདངས་བསྐང་གི་རྟེན་དུ་འགོད་པར་བྱ།",
    "མཐིང་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་གསུམ་འཁོར་ལོ་རལ་གྲི་རྡོ་རྗེ།",
    "རྒྱན་ལྷ་བརྒྱད་སྤྲུལ་པ་གསུམ་གཤེད་བཞི་མོན་བདུད་འཆི་བདག་བཅུ་གཉིས།",
    "དགོང་མོ་ཉལ་ཁར་དེ་བཞིན་དམིགས་ནས་འབྲུ་གསུམ་མི་གདག་པར།",
    "འདི་ནི་ཨཱ་ལི་ཀ་ལིའི་མན་ངག་ཟབ་མོ་སྔགས་གྲུབ་པའི་ཐབས་ཁྱད་པར་ཅན་ནོ།",
    "བན་སྔགས་བོན་དགྲས་བདག་གི་ངག་བཅིངས་ན།",
    "བདག་གི་ལྕེ་སྟེང་རྃ་ཡིག་དམར་པོ་བསམ།",
    "དེ་ཡི་ངང་ལས་ལྕེ་ནི་གང་གིས་ཀྱང་།",
    "དེས་ན་འདི་རྣམས་ལྷ་གང་སྒྲུབ་ཀྱང་མན་ངག་ཟབ་མོ་གསང་བའི་རྒྱ་ཅན་ཡིན་པས་ཉམས་སུ་བླང་བར་བྱའོ།",
    "དེ་ལ་ཛབ་བཟླ་བའི་ཚེ་ཞག་གི་གྲངས་སམ་སྔགས་རང་གི་གྲངས་དུམ་ལྔ་བཅད་དེ་བསྙེན་དམིགས་སོགས་བྱེད་ཚུལ་བསྙེན་ཡིག་ལྟར་ལ།",
    "དམིགས་པ་སྔ་མ་སྔ་མ་སོང་ཟིན་རྣམས་ཅུང་ཟད་བསྒོམས་ནས་སྐབས་ཀྱི་དམིགས་པ་ལ་བཟླས་པའི་དངོས་གཞིར་འཛིན།",
    "དེ་ཡང་ཨྱེ་རིང་གི་སྔགས་འདིར།",
    "ཨ་ཡེ་ལྟ་བུར་འདོན་པར་མི་བྱའོ།",
    "རྩ་བའི་ཨེ་ཐུང་ནི་ཕལ་ཆེར་འབྲུ་གསུམ་བཏགས་པ་ཅན་གཞུང་ན་སྣང་ལ་ཨེ་རིང་ལ་མ་བཏགས་ན་ཆད་སྐྱོན་མེད་ཀྱང་མན་ངག་གི་འབྱིན་འཇུག་ཡིན་པས།",
    "ཡམརཀཥ་ཞེས་ཕྲལ་ཏེ་བཀླག་གི།",
    "མན་ངག་གི་འབྱིན་འཇུག་དང་སྒྲ་ཡི་འདོན་ཐང་བསྒྱུར་བ་ནི་རྣལ་འབྱོར་དམ་པའི་ཡུལ་ཏེ་བསམ་གྱིས་མི་ཁྱབ་ལ་དེ་དག་གི་ནུས་པའི་ཁྱད་པར་ཀྱང་སོ་སོར་འབྱུང་སྟེ་ཕལ་པས་ཤེས་མི་ནུས་པས་རིག་འཛིན་རྣམས་ཀྱི་མན་ངག་ལ་བརྟེན་པར་བྱ་བ་ནི་སྤྱིར་གཅེས་སོ།",
    "ཡིད་ཏིང་འཛིན་བརྟན་ཞིང་བདེ་གསལ་མི་རྟོག་གི་ཉམས་དང་།",
    "ཁ་སྐོང་གི་སྦྱིན་སྲེག་ནི་སྔགས་ཚན་སོ་སོའི་རྫོགས་མཚམས་སུ་སྒྲུབ་པར་འདོད་ན་རྡོ་ལེབ་སོགས་ཀྱི་སྟེང་དུ་ས་བཟང་པོ་ལས་བརྩིགས་ཐབས་ཕན་ཚུན་དུ་ཁྱེར་རུང་བ་ཞིག་ཐབ་ཁུང་དང་མུ་རན་ཁ་ཁྱེར་བཅས་པ་ཚད་ལྡན་བྱས་ལ་རྫས་ཚོགས་པར་བསགས་ནས་སོ་སོའི་མཐར་སྒྲུབ་ཁང་དེའི་བར་ཁྱམས་སོགས་གང་བདེར་སྔགས་སོ་སོའི་ཁ་སྐོང་གི་སྦྱིན་སྲེག་བྱས་ན་མཆོག་གོ།",
    "ཨོཾ་ཨཱ་ཨུཥྞཱི་ཥ་བཛྲ་ཙཀྲ་ཝ་ཏི་སརྦ་ལོ་ཀི་ཀ་ལོ་ཀོཏྟ་ར་ཡནྟྲ་མནྟྲ་ཏནྟྲ་ཧ་ན་ཧ་ན་ད་ཧ་ད་ཧ་པ་ཙ་པ་ཙ་ཀུ་རུ་ཀུ་རུ་མུ་རུ་མུ་རུ་ཨཱ་བ་ཤ་ཡ་ཨཱ་བེ་ཤ་ཡ་ཨ་ཨཱ་གནོད་བྱེད་ཨ་མུ་ཀ་མཱ་ར་ཡ་མཱ་ར་ཡ",
    "འདི་ནི་གཞུང་གི་ཨུཥྞཱི་ཥའི་ཕྱིར་བཟློག་གྲི་ཐོགས་ཤན་པ་ཁ་བསྒྱུར་ཞེས་ཤིན་ཏུ་ཟབ་པ་དེ་ཡིན་ལ་རྦོད་གཏོང་གི་ལྟས་བྱུང་ན་ཕྱིར་ཟློག་འདི་ལྷག་པར་ཟབ་པས་དོན་གྱི་སྲུང་བའང་ཡིན།",
    "གཉིས་པ་སྲུང་འཁོར་དྲུག་གི་དམིགས་པ་ནི།",
    "གཡོན་དུ་མ་སོགས་མོ་རིགས།",
    "བདག་གི་སྐུ་ལས་འོད་ཟེར་འཁོར་ལོ་རལ་གྲི་རྡོ་རྗེ་བེ་ཅོན་གཏུན་ཤིང་ལ་སོགས་བསམ་གྱིས་མི་ཁྱབ་པ་འཕྲོས།",
    "ཚུར་འདུས་པས་ཕྱག་མཚན་གྱི་གུར་ཁང་གི་ཕྱི་ལ་རྡོ་རྗེའི་ས་གཞི་ར་བ་དྲྭ་བ་གུར་བླ་རེ་གོ་གསེང་མེད་པར་གྱུར།",
    "དེ་བཞིན་དུ་འཁོར་ལོ་རྩིབས་བཞི་ནས་སྟོང་གི་བར་སྣ་ཚོགས་འཕྲོས་འདུས་རྡོ་རྗེའི་གུར་གྱི་ཕྱི་རོལ་འཁོར་ལོའི་གུར་ཁང་།",
    "དེའི་ཕྱི་རོལ་མེ་དཔུང་མཐའ་ཡས་པ་འཕྲོ་འདུས་མེ་དཔུང་གི་གུར་ཁང་རབ་ཏུ་འབར་བས་མཚམས་བཅད་དེ་ཅིས་ཀྱང་མི་ཕྱེད་པར་དམིགས་པར་བྱའོ།",
    "གསུམ་པ་རང་གི་དཔྲལ་བའི་ཨཱོཾ་ཇེ་ཆེར་སོང་བ་ལུས་ཀྱི་ཕྱི་ནས་གུར་ལྟ་བུར་གྱུར།",
    "མགྲིན་པའི་ཨཱ་ཡང་དེ་བཞིན་ཇེ་ཆེར་སོང་ནས་ཨཱོཾ་གྱི་ནང་དུ་གུར་ལྟ་བུར་གྱུར།",
    "ཐུགས་ཀའི་ཧཱུྃ་གིས་མགྲིན་པ་ནས་ལྟེ་བའི་བར་ཁྱབ་པར་བསྒོམ་མོ།",
    "བཞི་པ་ཧཱུྃ་དེའི་ནང་དུ་རང་ཉིད་སྤྱན་རས་གཟིགས་གང་ཡང་རུང་བ་བསྒོམ།",
    "དེའི་ཐུགས་ཀར་འཇམ་དབྱངས་དེའི་ཐུགས་ཀར་ཕྱག་རྡོར་དེའི་ཐུགས་ཀར་རང་སེམས་ཕྱག་རྒྱ་ཟིལ་གནོན་དུ་བསྒོམ་མོ།",
    "ལྔ་པ་རང་གི་ལུས་འདི་སྤྱི་བོ་སྣ་ཚོགས་རྡོ་རྗེ།",
    "སོ་དང་སེན་མོ་མེ་རི་འབར་བའི་རང་བཞིན་དུ་བསྒོམ་མོ།",
    "དེ་ཡང་སྟོང་སྲོག་ཅེས་གནོད་བྱེད་ཐམས་ཅད་ལ་སྤྱིར་བཏང་དུ་སྦྱར་ཆོག་པ་ཨ་མུ་ཀ་ཞེས་པ།",
    "བོད་སྐད་དུ་ཆེ་གེ་མོའམ་འདི་ག་ཞེས་པ་ལྟ་བུ་གང་ལ་དམིགས་པ་དེའི་བཏགས་སྲོག་ཡིན་པས་སྤྱི་ཁྱབ་ཏུ་དེ་ཁོ་ནས་འཐུས་ཏེ།",
    "ཞེས་གསུངས་པ་ལྟར་གནོད་བྱེད་ཐམས་ཅད་གཅིག་ཏུ་སྤོམས་ནས་དེ་ལ་དམིགས་ཏེ་ཨ་མུ་ཀ་ཞེས་བརྗོད་པར་བྱའོ།",
    "སྤྲོས་བཅས་རྫས་ཀྱི་སྐབས་སུ་མཆོད་རྟེན་བཅས་ཆོག་དང་མཆོག་ཕག་གི་འཁོར་ལོ་དང་མུན་དམག་བསྡུ་བའི་འཁོར་ལོ་སོགས་ནི་ལྕགས་འདྲ་སྡིག་གི་གཞུང་དང་དཔེའུ་རིས་དང་ཕྱག་ལེན་ལས་ཤེས་དགོས་ལ་འདིར་སྟོང་སྲོག་སྤྱང་མོ་དྲུག་གི་འཁོར་ལོ་ཞེས་པ་ནི།",
    "དེའི་ཟླ་གམ་གསུམ་ལ་ཕ་རོལ་གྱི་ལྷ་སྲུང་གི་མིང་དང་རང་གཤེད་དབབ་པའི་སྤུ་གྲི་འབྲི།",
    "ནང་གི་མུ་ཁྱུད་དང་པོ་ལ་འཁོར་ལོ་རྩིབས་བརྒྱད་བྲི།",
    "ཕྱིའི་མུ་ཁྱུད་གཉིས་པོ་ཆ་མཉམ་པར་ཉེར་བརྒྱད་ཉེར་བརྒྱད་དུ་བཅད་པས་རེའུ་མིག་ང་དྲུག་པར་བྱས་ལ།",
    "ཕྱི་ནང་གི་མུ་ཁྱུད་ལ་ཡིག་འབྲུ་གཉིས་སོགས་དང་ལྔ་ལྟ་བུ་བཅད་མཚམས་ལ་དཔགས་ཏེ་གང་འོས་སུ་བྲི།",
    "གྲུ་གསུམ་ནང་གི་ལིང་ག་ནི།",
    "འཁོར་ལོའི་ཨེ་རིང་གི་ཤམ་བུ་ཡང་གཟིར་སྤྱང་བྲི།",
    "ཟླ་གམ་གསུམ་ལ་གནོད་བྱེད་ཨ་མུ་ཀ་ལྷ་སྲུང་དང་བཅས་པའི་ནུས་པ་ཟློག་ཅིག།",
    "ནུས་པ་ཆོམས་ཤིག་ཅེས་བསྒྱུར་བའི་དམོད་ཚིག་ཚན་གསུམ་པོ་ཚར་གཅིག་བྲིས་པས་འཐུས་སོ་ བྲིས་ཚར་ནས་འབྱུང་ལྔས་ལིང་ཁྲུས་བྱ།",
    "ཉིན་མོ་ཨེ་མྱགས་འབྲུ་བརྒྱད་ཀྱི་ཤམ་དུ།",
    "དེ་བཞིན་མཚན་མོར།",
    "གུང་གཉིས་དང་ཐོ་རེངས་དང་སྲོད་དེ་བཞི་ལ་གདབ་ལས་བྱ།",
    "བླ་འགུག་སོགས་ལས་གང་བྱེད་ལ་ཕྲིན་ལས་ཀྱི་སྤྲུལ་པ་མོན་པ་བཞི་བསྐུལ་བ་དང་།",
    "ཡུལ་དུས་བརྒྱད་དག་པ་མོན་བདུད་ཡབ་ཡུམ།",
    "ལྟོ་བ་ཁྲག་ཁྱམས་ལ་འོབས་སྲུང་བཅུ་དྲུག་དང་ཤ་ཟ་ཀིཾ་ཀང་མ་མོའི་ཚོགས་ལ་སོགས་པ་འཁོར་གྱི་ཚོགས་ཀུན་ནས་གནས་པ།",
    "བདག་གི་ཐུགས་ཀའི་འོད་ཀྱིས་མདུན་བསྐྱེད་ཀྱི་ཐུགས་དམ་བསྐུལ་ཞིང་བདག་མདུན་གཉིས་ཀའི་གནས་ལྔར་སྐུ་གསུང་ཐུགས་ཡོན་ཏན་ཕྲིན་ལས་ལྔའི་ས་བོན་ལས་འོད་གློག་གི་ཞགས་པ་ལྟར་རྣོ་ཞིང་མྱུར་བ་སྤྲོས་པས་འཁོར་འདས་ལམ་གསུམ་གྱི་དཔལ་ཡོན་དྭངས་བཅུད་ཚེ་སྟོབས་རྣམས་འུབ་ཀྱིས་བསྡུས་ནས་དངོས་གྲུབ་ཀྱི་རྫས་ལ་ཐིམ་པར་བསམས་ལ།",
    "ཕྱོགས་བཞིར་ཤར་དུ་དབྱིངས་ཕྱུག་མ་སྔོན་མོ།",
    "ལྷོར་མཱ་མ་ཀི་སེར་མོ།",
    "ཞེས་བཟླས་མཐར་མཆོད་བསྟོད་བྱ་ཞིང་ཚེ་ཡི་ལྷ་རྣམས་འོད་དུ་ཞུ་ནས་དངོས་གྲུབ་ཀྱི་རྫས་དེ་དག་གི་རྣམ་པར་གྱུར་པར་བསམ་མོ།",
    "དེ་ལྟར་ལེགས་པར་བསྒྲུབས་ནས་ཐོ་རེངས་ཀྱི་དུས་སུ་མདུན་དཀྱིལ་བཾ་གྱི་ལུས་ལ་བཀོད་པའི་ལྷ་ལ་མཆོད་བསྟོད་བྱ་ཞིང་།",
    "བདག་གི་ཐུགས་ཀའི་འོད་ཀྱིས་མཁའ་ཁྱབ་ཀྱི་རྒྱལ་བ་སྲས་དང་བཅས་པ་དངོས་གྲུབ་སྩོལ་བའི་ཆེད་དུ་བསྐུལ་བས་ཏིལ་གྱི་གང་བུ་ཁ་ཕྱེ་བ་ལྟར་མདུན་གྱི་ནམ་མཁར་བྱོན་པར་བསམས་ལ་དངོས་གྲུབ་བསྐུལ་བའི་ཚིག་འདི་བརྗོད་དོ།",
    "གསུང་གི་དངོས་གྲུབ་འགག་མེད་བརྗོད་དང་བྲལ།",
    "མོས་བཞིས་ཁམས་གསུམ་སྲིད་གསུམ་ལྷ་མི་ནོར།",
    "སླར་ཡང་དངོས་གྲུབ་ཀྱི་རྫས་འོད་ཀྱི་རྣམ་པས་རང་ལ་ཐིམ་པས་སྒོ་གསུམ་ཆ་མཉམ་གྱི་སྒྲིབ་པ་དག་ནས་བདེ་ཆེན་ཡེ་ཤེས་རྡོ་རྗེ་རྒྱལ་བ་ཐམས་ཅད་དང་མཉམ་པ་ཉིད་དུ་གྱུར་པ་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་ཐོབ་པར་བསམས་ལ།",
    "ལན་གསུམ་མམ་གཅིག་གིས་དངོས་གྲུབ་བླངས།",
    "འཆལ་བ་ངག་གི་སྒྲིབ་པ་སྦྱང་དུ་གསོལ།",
    "ཨོཾ་ཡ་མཱནྟ་ཀ་ཙིཏྟ་སིདྡྷི་ཧཱུྃ་ཞེས་བརྗོད་སླར་ཡང་གནས་གསུམ་དུ་རེག་ཅིང་ཁར་མྱང་ལ།",
    "སྒྲུབ་གཏོར་དང་ཚེ་འབྲང་སོགས་དངོས་གྲུབ་ཀྱི་རྫས་གཞན་ཀུན་ཀྱང་གནས་གསུམ་དུ་རེག་ཅིང་མྱང་།",
    "གཞུང་ཆོག་སྒྲིག་གི་རིམ་པའང་གསར་རྙིང་གི་མཁས་གྲུབ་དུ་མས་མཛད་པ་ཡོད་པ་རྣམས་གང་ལྟར་ཉམས་སུ་བླངས་ཀྱང་དོན་དང་ལྡན་པ་ཡིན་མོད་ཀྱང་།",
    "དེ་ལྟ་བུའི་ལྟ་བ་ཟབ་མོའི་གདིང་གིས་ཟིན་པའི་བསྐྱེད་རིམ་རྣམས་ཀྱང་ལྷུན་གྲུབ་སྣང་སྟོང་ཟབ་མོའི་བསྐྱེད་རིམ་ཞེས་རྫོགས་རིམ་དང་རོ་གཅིག་ཏུ་འགྱུར་རོ།",
    "ཞིང་གི་སྒོ་འགེགས།",
    "ཁྱུང་གི་ཡ་ཕུབས།",
    "དེའི་ཕྱོགས་ཀྱི་ཟླ་གམ་གསུམ་ལ་སྤྲུལ་པ་གསུམ་རྡོ་རའི་ཕྱི་རོལ་དུ་ཕྱོགས་བཞིར་ཐོད་མཁར་བཞི་ལ་གཤེད་ཆེན་བཞི་འཁོར་ལོའི་རྩིབས་བརྒྱད་ལ་ལྕགས་མཁར་བརྒྱད་དུ་མོན་བདུད་ཡབ་ཡུམ།",
    "གཉན་རྭ་ཡི་དུག་ཅན་ལྕོང་མོ་ཁྲི།",
    "དེ་སྟེང་པད་ཉི་ཟླ་བའི་གདན་ལ་ཟིལ་གནོན་ཉིད་གཞུང་གི་མངོན་རྟོགས་བཞིན་བསྒོམ་མོ།",
    "ཡུམ་བེ་ཏཱ་ལི་མཐིང་ནག་ཁྲོ་མོའི་ཆས་ཅན་གཡས་ཙིཏྟ་གཡོན་བྷན་དམར་སྟོབ་པའོ།",
    "ཉི་ཟླ་འབར་བའི་སྤྱན་བགྲད་ཅིང་ཁྲོས་པའི་ཞལ་ཐུར་དུ་གཟིགས་པ།",
    "དཔུང་གཡོན་བདུད་རྩི་འཁྱིལ་པ་ལྔ་མཐིང་ནག་ཞལ་ནང་དུ་གཟིགས་ནས་སྲུང་བའི་ལས་མཛད་པ།",
    "དཔྱི་གཉིས་ཀྱི་བར་དུ་ཁམས་གསུམ་རྣམ་རྒྱལ་གསང་གནས་སུ་སྟོབས་པོ་ཆེ་ལྔ་ལྗང་ནག་ཞལ་ཕྱིར་གཟིགས་ནས་ཕ་རོལ་གྱི་བྱས་པ་བཤིག་པའི་ལས་མཛད་པ།",
    "མ་ཧེ་སྔོ་ནག་གི་གདན་ལ་འགྱིང་བ་ཡུམ་སྲིན་མོ་གསོད་བྱེད་མ་ཏྲི་ཤུལ་དང་ཐོད་ཁྲག་ཐོགས་པ་གཡོན་དུ་གསུང་སྤྲུལ་སྲོག་བདག་དམར་པོ་ཞལ་གཅིག་ཕྱག་བཞི་པ།",
    "ཡུམ་སྲིན་མོ་རོ་ལངས་སྤུ་གྲི་དང་ཐོད་པ་འཛིན་པས་འཁྱུད་པའོ།",
    "སྟེང་གི་ཞལ་གསུམ་དབུས་ཁྱུང་གཡས་རྨ་བྱ་གཡོན་དུར་བྱའི་མགོའོ།",
    "ཞིང་ཆུང་གི་རྒྱལ་མཚན་འཛིན་པ།",
    "སྟག་ལྤགས་རློན་པས་སྨད་དཀྲིས་ཐོད་སྦྲུལ་སོགས་དུར་ཁྲོད་ཆས་ཀྱིས་བརྒྱན་པ་བདུད་མོ་གསོད་བྱེད་ཙིཏྟ་དང་ཐོད་ཁྲག་ཐོགས་པ་མི་ལྤགས་གྱོན་པས་འཁྱུད་པའོ།",
    "ཐོད་མཁར་བཞི་ལ་ཤར་དུ་དྲེད་མོང་ལག་རྡེབ་ཀྱི་གདན་ལ་ཡ་མ་རཱ་ཛ་སྨུག་ནག་ལྷོར་དོམ་ནག་གི་སྟེང་དུ་མྱོས་བྱེད་འབར་བ་སེར་ནག་ནུབ་དྲེལ་རྟ་ལ་ཀླུ་བདུད་ཨཪྱ་དམར་ནག་བྱང་རྔ་མོང་གདོང་སེར་ལ་རལ་པ་ཚར་དགུ་ལྗང་ནག་བཞི་ཀའང་ཐོད་སྦྲུལ་གྱིས་བརྒྱན་པ་གཡས་འཁོར་ལོ་གཡོན་བེ་ཅོན་འཛིན་པ།",
    "སྲིན་མོ་ནག་མོ་ཨེ་ཀ་ཛཱ་ཊི་བདུད་མོ་ནག་མོ་གནོད་སྦྱིན་ནག་མོ་རྣམས་རིམ་བཞིན་ཡབ་ལ་འཁྱུད་ཅིང་ཐོད་ཁྲག་སྟོབ་པའོ།",
    "འཁོར་ལོ་རྩིབས་བརྒྱད་ཀྱི་ཤར་གྱི་ལྕགས་མཁར་ལ་དུང་གི་མོན་པ་སེང་གེའི་མགོ་ཅན་མོན་མོ་བླ་རྐུན་རྔམ་པའི་གདོང་ཅན་གྱིས་འཁྱུད་པ་ལྷོར་ལྕགས་ཀྱི་མོན་པ་སྟག་གི་མགོ་ཅན་མོན་མོ་གཡུའི་རལ་པ་ཅན་གྱིས་འཁྱུད་མ།",
    "ནུབ་ཏུ་བསེའི་མོན་པ་དྲེད་ཀྱི་མགོ་ཅན་མོན་མོ་ཚེ་འཕྲོག་ཁྲག་རལ་ཅན་གྱིས་འཁྱུད་པ།",
    "ཡུམ་བཞི་ཁྲོ་མོ་ཙིཏྟ་ཐོད་ཁྲག་འཛིན་པའོ།",
    "བྱང་ཤར་དུ་རལ་པ་སྤྱིར་བཅིངས་ལྗང་ནག་གཡས་ཞགས་པའམ་ཁྲམ་ཤིང་ཅན་ཡུམ་ནག་མོ་མྱོས་བྱེད་དབུགས་སྡུད་མས་འཁྱུད་པ་ཡབ་རྣམས་ཀྱི་གཡོན་ཁྲམ་ཤིང་།",
    "མོན་བདུད་ཡབ་ཡུམ་ཐམས་ཅད་ཤིན་ཏུ་རྔམ་པ་མེ་ལྕེ་གློག་དང་སྐར་མདས་བརྒྱན་པའོ།",
    "བར་ཁྱམས་སུ་ཕོ་གཤེད་མོ་གཤེད་ཤ་ཟ་ཀིཾ་ཀང་མ་མོ་སོགས་དྲེགས་པ་ཅན་རྣམས་གདུག་ཅིང་གཏུམ་པའི་ཚུལ་ཅན་མཚོན་ཆ་སྣ་ཚོགས་འཛིན་པའོ།",
    "དེ་མ་བྱང་གི་བར་དུ་ཚིག་རིས་ཡིད་ལ་བྱེད་ཅིང་འདོན་ལ།",
    "བློ་ཆུང་དང་པོ་པས་རིམ་གྱིས་མཚན་མ་ཕྲ་མོ་ཡན་ཆད་གསལ་འདེབས་ཤིང་ཞེས་སོགས་གསུངས་པ་ལྟར།",
    "ཡིད་ལ་ངེས་པོ་མེད་ན་དོན་དེ་གསལ་འདེབས་བྱེད་ལས་བྱང་གི་མངོན་རྟོགས་ཀྱི་ཚིག་ལ་ལྟོས་པས་ལས་བྱང་རྒྱས་པ་ལྟར་འདོན་སྒོམ་སྦྲག་ཅིང་།",
    "ཡང་ནས་ཡང་དུ་འདྲིས་པར་བྱས་པས་མཐར་རང་གིས་གོམས་པ་མ་རྙེད་པར་གསལ་འདེབས་དགོས་ཀྱི་ལྷའི་རྒྱན་ཆ་ཕྱག་མཚན་ཙམ་ཡང་མི་ཤེས་པ་ན་བསྐྱེད་རིམ་ཇི་ལྟར་བསྒོམ་སྟེ།",
    "ནྲི་བཀྲག་མདངས་མེ་རེ་བ་ཁབ་ལེན་གྱི་ལྕགས་ཕྱེ་ལྟར་ཕུར་རྩེས་ཙེན་གྱིས་བླངས་ཏེ།",
    "རང་གི་ཐུགས་ཀའི་རུས་སྦལ་གྱི་སྲོག་ཡིག་ཨེ་ཀ་ལ་ཐིམ།",
    "དེ་ནས་བདེ་སྟོང་ནང་གི་ཚོགས་ལ་རོལ།",
    "བདག་གི་ཐུགས་ནས་ཛ་ལས་ཊཱ་ཀི་རཱ་ཛ་སྤྲོས་པས་ལྷག་མགྲོན་དཀྱིལ་འཁོར་གྱི་ཁྱམས་སུ་དགུག་མཛུབ་མོ་དང་གུང་མོ་མཐེ་བོང་རྣམས་སོ་སོར་སྦྱར།",
    "སྲིན་ལག་དང་མཐེའུ་ཆུང་བརྐྱང་བ་འབར་བ་ལྟར་བྱས་པ་བྱ་ཁྱུང་གི་ཕྱག་རྒྱ་བཅས་ལ།",
    "ཨོཾ་ཤྲཱི་མཉྫུ་ཀྲོ་དྷ་སོགས་བརྗོད་ཅིང་རང་ཉིད་ཀྱི་རྡོ་རྗེའི་གཤོག་པ་ལས་འོད་ཟེར་མེའི་ཚྭ་ཚྭ་ལྟ་བུ་འཕྲོས་པས་དྲེགས་བྱེད་ཀྱི་ཚོགས་མ་མོ་མཁའ་འགྲོ་འབུམ་དང་བཅས་པ་ཟིལ་གྱིས་མནན་ཏེ་འདར་ཡེད་ཡེད་བཀའ་ཉན་པར་བསམ།",
    "གང་དུ་བྱ་བའི་གནས་སུ་བདག་བསྐྱེད་རྫོགས་པའམ་སྐད་ཅིག་གི་ལྷའི་རྣལ་འབྱོར་གྱིས་སྔགས་ཅུང་ཟད་བཟླས།",
    "ཨོཾ་ཧ་ན་ཧ་ན་ཀྲོདྷ་ཧཱུྃ་ཕཊ་ཅེས་བརྒྱ་རྩ་བརྒྱད་བཟླས་པ་ཀུན་རྫོབ་ཀྱི་སྦྱང་བ་དང་སྟོང་པར་བསམ་པ་དོན་དམ་གྱིས་སྦྱང་བ་གཉིས་བྱས་ཏེ་ལས་སྔགས་བཟླ་བཞིན་དུག་ཁྲག་གིས་ཆག་ཆག་གདབ།",
    "ལོགས་ཐིག་བཅས་པའི་ཡེ་ཐིག་སྟེང་གི་མཁའ་ལ་གདབ།",
    "འོབས་ཁུང་གི་གཞི་ནག་པོ་གྲུ་གསུམ་དམར་ནག་གམ།",
    "ལྕགས་མཁར་བཅུ་གཉིས་ནི་ཕྱོགས་བཞིར་གཉིས་རེ་མཚམས་བཞིར་རེ་རེ་སྟེ་གྲུ་གསུམ་པའི་རྩེ་མོ་ནང་བསྟན་བྱ།",
    "འོབས་ཁུང་བཅུ་དྲུག་ནི་ཕྱོགས་མཚམས་བརྒྱད་དང་ཕྱོགས་བཞིའི་གཡས་གཡོན་དུ་རེ་རེ་སྟེ་གྲུ་གསུམ་རྩེ་མོ་ཕྱིར་བསྟན་དུ་བྲིའོ།",
    "དེ་ལྟར་ལེགས་པར་བྲིས་ནས་བྲ་བོ་ཁྲག་གིས་སྤགས་པས་ཚོམ་བུ་གཞུང་གི་ལྷ་གྲངས་ལྟར་འགོད་པར་བྱའོ།",
    "མཚམས་བཞིར་རྒྱན་ལྷ་ཡབ་ཡུམ་ཟུང་རེ།",
    "དེའི་ཕྱི་རོལ་གྱི་ཟུར་བཞིར་གྲུ་གསུམ་རྩེ་ནང་བསྟན་སུམ་བརྩེགས་རེ་རེར་འཆི་བདག་བཅུ་གཉིས།",
    "ནུབ་ཏུ་མ་མོ་བརྒྱད།",
    "སྲིད་པ་ལུགས་འབྱུང་གི་གཏོར་སྟེགས་སམ།",
    "ལྕགས་ཀྱི་མཉྫིའི་ཁར་ལྕགས་སླང་བུག་རྡོལ་མེད་པར་བཟློག་གཏོར་ཁྲོ་ཞལ་ཅན་འཁོར་རྩ་ལྷ་དྲུག་གི་གྲངས་ཀྱིས་བསྐོར་བའམ།",
    "བཟློག་པའི་འཁྲུལ་འཁོར་གང་རུང་བྲིས་པ་ཡོད་ན་གཏོར་མར་གཞུག་གཏོར་ཆེན་གྱི་འོག་ཏུ་མཉྫིས་བཏེགས་པའི་ཟོར་ཀོང་གཅིག་དཀྱིལ་འཁོར་གྱི་མཐའ་རྡོ་རྭའི་སྟེང་གི་ཕྱོགས་མཚམས་ཀུན་དུ་ཟོར་ཀོང་སྦྱིན་བདག་གི་ལོ་གྲངས་སམ།",
    "དེ་ཡང་དུར་ཁྲོད་དང་རི་སུལ་འདྲེ་ཅན་གཡུལ་བཀྱེ་ཕུང་ཤུལ་སོགས་དྲག་པོའི་ས་སྣ་བྲ་བོ་ནས་ནག་གི་ཕྱེ་བསྲེས་ནས་དུག་ཁྲག་གི་ཆུས་སྦྲུས་པ་ལས་གྲུབ་པའི་ཀོང་བུ་གྲུ་གསུམ་སོར་བཞི་པ་ཁ་རིས་དམར་པོ་གཞུང་ནག་པོ་ལོགས་གསུམ་ལ་བྷྱོ་ཟློག་རྦད་གསུམ་ཁྲག་གིས་བྲིས་པའི་ནང་གྲུ་གསུམ་བྲུས་པར་རྫས་བླུགས།",
    "དེ་སྟེང་དབུས་སུ་ཁྲག་ཀོང་གྲུ་གསུམ་སྟེང་ཁྲག་གཏོར་གྲུ་གསུམ་ཁྲག་གིས་སྦག་པ་དང་།",
    "ཀོང་བུའི་ནང་དུ་ཟོར་རྫས་སྤོས་རེང་།",
    "རམ་གྱི་ཕྱི་མོ་ལྕགས་ཟངས་རྡོ་ཕྱེ་དུག་ཁྲག་གི་ཆུས་བྱུགས་པ།",
    "ཡུགས་སའི་འཕང་གིས་རྩང་བྱས་པ་དགོས་ཀྱང་དེ་ལྟར་མ་གྲུབ་ན་གོང་གི་རྫས་ནང་དུ་བསྡུས་ཀྱང་ཆོག་པར་གསུངས།",
    "ཟོར་ཀོང་གི་ཁ་ཁྱེར་གཡས་སུ་མདའ་བཀྲ།",
    "གཡོན་དུ་བྲག་ནག་གི་མཚེ།",
    "འདིའི་རྫས་རེ་རེ་བཞིན་དུ་དྲེགས་པའི་གདུག་པ་བཟློག་པའི་ནུས་པ་སོ་སོར་ཡོད་པར་གཞུང་གཞན་ལས་གསུངས་སོ།",
    "མི་བསད་ཀྱི་རྦབ་རྡོ་གང་རིགས་བྱ་སྒོང་ཙམ་ལྔ་ལ་ཁྲག་གིས་བྷྱོ་ཟློག་རྦད་གསུམ་བྲིས་པ་དང་།",
    "དེ་བཞིན་སྐྱེར་པའི་མདའ་ལ་འུག་པ་སྲིན་བྱ་ཁྲག་གསུམ་གྱི་སྒྲོ་སྤྲད་པ་གྲི་ལྕགས་ཀྱི་མདེའུའི་རྩེར་ཁྲག་གིས་བྱུགས་པ།",
    "ལོགས་ལ་སྔགས་བཟློག་ཤམས་བཅས་ཁྲག་གིས་བྲིས་པ་ལྔ་དལ་གྱི་གཡས་དང་།",
    "ཁྲག་གི་ཨརྒྷཾ།",
    "གཞན་ཡང་ནུབ་རེ་བཞིན་གཏོང་རྒྱུའི་བཟློག་པའི་ཐུན་གཏོར་ཟུར་གསུམ་འཁོར་དྲུག་པ་ཁྲག་ཡུངས་ཀྱིས་བརྒྱན་པ་དང་བཟློག་པ་སོགས་ཀྱི་ཕྲིན་བཅོལ་དུས་འབུལ་རྒྱུའི་གཏོར་ཆུང་གྲངས་མང་།",
    "དཀྱིལ་འཁོར་གྱི་རྒྱབ་ཕྱོགས་སུ་མཐོ་བར་བྱས་པའི་བང་རིམ་གཉིས་ཀྱི་དང་པོར་ཚེ་བདག་གི་སྒྲུབ་གཏོར།",
    "བང་རིམ་དེའི་གཡོན་དུ་རྡོ་རྗེ་རྒྱ་གྲམ་དམར་པོའི་སྟེང་བཙན་བཤོས་དམར་པོ་གྲུ་གསུམ་བདུད་བཤོས་གྲུ་བཞི་རྩེ་རྒྱལ་ཅན་གཉིས་ཤ་ཁྲག་གིས་བརྒྱན་པ་རྩ་བཟུང་ཟན་ལེབ་གཅིག་གིས་དཀྲིས་པ་བཤམ།",
    "སྤྱིར་རྙིང་གཞུང་རྣམས་སུ་བདག་མདུན་ཆོ་ག་གཅིག་གིས་མཉམ་དུ་བསྐྱེད་པ་དང་།",
    "བདག་བསྐྱེད་སོང་ནས་དེའི་རྗེས་སུ་མདུན་དཀྱིལ་བསྐྱེད་པ་བྱས་ལ་བདག་མདུན་སྟབས་གཅིག་སྤྱན་དྲངས་པ་སོགས་ཐུན་མོང་དུ་བྱས་ནས་བཟླས་པ་སྟབས་གཅིག་བྱ་བ་དང་།",
    "བདག་བསྐྱེད་བཟླས་པ་བཅས་སོང་ནས་མཆོད་བསྟོད་བྱས་ལ།",
    "དེར་མ་ཟད་ཚིག་ཟིན་ལ་མེད་ཀྱང་མདུན་གྱི་ཟོར་རྫས་རྣམས་ལས་མཚོན་ཆའི་ཆར་འཕྲོ་ཞིང་ཟོར་བདག་གི་ཚོགས་སྤྲུལ་པ་ཡང་སྦྲུལ་གྲངས་སྤྲུལ་མེད་འཕྲོ་བས་བཟློག་པའི་ལས་མཛད་པ་དང་།",
    "དུར་ཁྲོད་ནང་མཆོད་ཀྱི་ཚེ་ནང་གི་མར་མེ་སྦར།",
    "ཉོན་མོངས་དུག་ལྔའི་བདུད་རྩི་ཆེན་པོ་སོགས།",
    "དེ་ལྟར་བཟླས་པའི་བར་སོང་ནས།",
    "ཨཱ་ཀྲོ་དང་སྐུ་གསུང་ཐུགས་སྔགས་ཨེ་རིང་རྣམས་བརྒྱ་རེའམ་སྐབས་དང་སྦྱར་ཏེ་བཟླས་ནས་སྟོང་ཚིག་གི་མཆོད་བསྟོད་བྱ།",
    "མཐར་བཟློག་སྤྱང་གི་ཤམ་བུའི་དུས་ཐལ་མོ་ལན་གསུམ་བརྡབ།",
    "རྃ་ཡྃ་ཁྃ་གིས་སྦྱང་།",
    "ཨོཾ་ཨཱ་གིས་བྱིན་གྱིས་བརླབས་ལ།",
    "གཏོར་བཟློག་གི་སྐབས་སུ་ཐམས་ཅད་རྫོགས་པར་འདོན།",
    "ཐལ་བ་བཞིན་དུ་རབ་ཏུ་རློག།",
    "དེ་ཡང་མི་རྟ་ཁྱི་གསུམ་བསད་མྱོང་གི་རྭ་ཡིན་ན་ངར་འདོན་མི་དགོས།",
    "རཀྟ་བྲན་ཨེ་རིང་ཚར་གཅིག་གིས་བྲུབ་ཁུང་དང་གཟུགས་བརྙན་དགྲ་བགེགས་སུ་བསྐྱེད་ལ་སྤྲུལ་པ་སྤྲོ།",
    "མི་གསོད་མྱོང་བ་ཞིག་ལ་གཏད་ནས་དེས་རྭ་ཟོར་གྱི་རྩེ་མོས་གཟུགས་བརྙན་གསུམ་པོ་དུམ་བུར་གཏུབ།",
    "ནང་དང་རྩེར་དུག་ཁྲག་གིས་བྱུགས་ཤིང་།",
    "ཞེས་ཅི་རིགས་བརྗོད་པས་མོན་པ་ཕོ་མོ་རྣམས་ཀྱིས་དུག་མཚོན་གྱི་ཆར་དབབ་པར་བསམ།",
    "འདིའི་སྔགས་གཞུང་གི་ཐུན་ཟོར་སྒྲུབ་པ་ལྟར་བྲིས་པ་སྟེ་གཞན་དང་ཅུང་མི་འདྲ་ཡང་འདི་ཁོ་ན་དག་ཅིང་ཟབ་བོ།",
    "ཁྲག་གིས་གར་བླན་པའི་སར།"
  ]
}