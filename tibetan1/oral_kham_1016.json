    "འཆད་ཚུལ་འདི་ཤིན་ཏུ་ལེགས་སྙམ་པ་ཡིད་ལ་བཅག་པ་ཡིན་འདུག་ཀྱང་།",
    "རྒྱུ་ཡང་རང་བཞིན་གྱིས་གྲུབ།",
    "དཔེ་ཅན་ས་མྱུག་དུས་མཉམ་དུ་མེད་པ་ཡིན་པས་དཔེ་དོན་མི་འདྲའོ།",
    "འཇིག་རྟེན་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཞན་སྐྱེ་མེད་པས་འཇིག་རྟེན་པས་མི་གནོད་པའི་ཚུལ་གཉིས།",
    "གཉིས་པ་འཇིག་རྟེན་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱི་གཞན་སྐྱེ་མེད་པར་སྟོན་པ།",
    "ཡང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཅིག་ཡིན་ན།",
    "ཀུན་རྫོབ་ཏུ་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་བཀག་པ་དང་།",
    "གཉིས་པ་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱིས་སྐྱེ་པ་དགག་པའི་ཕན་ཡོན་ལ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཡོད་པར་དམིགས་ཀྱང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་དེ།",
    "དེ་ཞིན་ད་ལྟ་འགགས་ཤིང་རང་བཞིན་ཡོད་པ་མིན་པའི་ལས་ལས་ཀྱང་ནི་འབྲས་བུ་རྗེས་སུ་བསྐྱེད་པ་ཡོད་པ་ཡིན་ནོ།",
    "གཱང་ཚེ་ང་ཡི་ལུང་ལ་རྨི་ལམ་ན་ཡང་ཡུལ་གླང་པོ་ཆེ་མེད་པ་ལྟར་དེའི་རྣམ་པ་ཅན་གྱི་ཡུལ་ཅན་གྱི་སེམས་ཀྱང་རང་བཞིན་གྱིས་མ་སྐྱེས་པའི་ཕྱིར།",
    "འཁོར་ལོས་བསྒྱུར་དང་རང་བྱུང་གཉིས།",
    "ཞར་བྱུང་རང་ལུགས་ལ་རང་རིག་མེད་ཀྱང་དྲན་པ་སྐྱེ་ཚུལ་གཉིས།",
    "རྒྱུ་ཡང་རང་བཞིན་མེད་པར་བསྟན་པ་གཉིས།",
    "གཉིས་པ་རྒྱུ་དེ་ཡང་རང་བཞིན་མེད་པར་བསྟན་པ་ནི།",
    "དགག་བྱ་བདེན་གྲུབ་ཀྱིས་སྟོང་པ་ལྟ་བུའི་ཚུལ་དུ་བསམ་འདུག་ཀྱང་།",
    "གདོད་ནས་ཞི་ཞིང་རང་བཞིན་གྱིས་སྐྱེ་བ་དང་བྲལ་ཞིང་རང་བཞིན་གྱིས།",
    "རྒྱུ་དང་དུས་དང་རྡུལ་དང་རང་བཞིན་དང་སྐྱེས་བུ་དང་སྲེད་མེད་བུ་ལ་སོགས་དང་བདག་དང་གཞན་དང་གཉིས་ཀ་ལས།",
    "དེ་གྲུབ་ཀྱང་དེ་དང་རང་མཚན་གྱིས་གྲུབ་པ་དང་མི་འདྲ་ན་ཇི་ལྟར་མི་འདྲ།",
    "གཟུགས་ཁོ་རང་བདག་མ་ཡིན་ལ་བདག་ནི་གཟུགས་ལྡན་མིན་ཞེས་རྟེན་བརྟེན་པར་མིན་ཡང་རང་བཞིན་གྱི་ལྡན་པ་མིན་ནོ།",
    "ཐོབ་པ་དང་མངོན་རྟོགས་ནི་འཇིག་རྟེན་ཐ་སྙད་དུ་ཡིན་ལ་རྒྱུན་ཞུགས་སོགས་བཞི་དང་རང་རྒྱལ་བྱང་སེམས་ཀྱང་འཇིག་རྟེན་ཐ་སྙད་དུ་ཡིན་གྱི།",
    "ཇི་ལྟར་བརྗོད་ཀྱང་རང་བཞིན་མེད་པའི་ཕྱོགས་སུན་འབྱིན་མི་ནུས་པའི་ཚུལ་གྱིས་མཇུག་བསྡུ་བ་གསུམ།",
    "རང་རྒྱུད་པས་དོན་དམ་དཔྱོད་པ་དེས་ཐ་སྙད་ཙམ་དུ་ཡང་རང་བཞིན་གྱིས་མ་གྲུབ་པ་ཅིས་མི་རྟོགས།",
    "སྤོབས་སོགས་བཞི་པོ་ཤེས་བྱ་ཀུན་ལ་ཐོགས་མེད་འཇུག་པ་རང་རང་ཆད་པ་མེད་ཅིང་ཟད་པ་མེད་པའི་མཚན་ཉིད་ཅན་ནོ།",
    "རང་བཞིན་ནི་ཁོ་རང་ཙམ་ལས་དགག་བྱ་དོར་བའི་འཛིན་སྟང་ཕར་ཆེར་འདྲ་ལ།",
    "བྱང་སེམས་དེའི་ལུས་དེ་དང་འཚམས་པར་འདུག་གོ།",
    "ཏིང་ངེ་འཛིན་དེ་ཐོབ་མ་ཐག་པདྨ་དེ་ལ་འདུག་པར་སྣང་ངོ།",
    "དེ་དེ་ལ་འདུག་པ་དང་།",
    "དེ་ཡང་རང་འགྲེལ་ལས།",
    "འཇིག་རྟེན་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པའི་གཞན་སྐྱེ་མེད་པས་འཇིག་རྟེན་པའི་མི་གནོད་པའི་ཚུལ་གཉིས།",
    "གཉིས་པ་འཇིག་རྟེན་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱི་གཞན་སྐྱེ་མེད་པར་སྟོན་པ།",
    "གཉིས་པ་ཀུན་རྫོབ་ཙམ་དུའང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པར་སྟོན་པ་ལ།",
    "ཀུན་རྫོབ་ཏུ་ཡང་རང་བཞིན་གྱི་སྐྱེ་བ་བཀག་པ་དང་།",
    "གཉིས་པ་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་དགག་པའི་ཕན་ཡོན་ལ།",
    "ཞར་བྱུང་རང་ལུགས་ལ་རང་རིག་མེད་ཀྱང་དྲན་པ་སྐྱེ་ཚུལ་གཉིས།",
    "རྒྱུ་ཡང་རང་བཞིན་མེད་པར་བསྟན་པ་དང་གཉིས།",
    "གཉིས་པ་རྒྱུ་དེ་ཡང་རང་བཞིན་མེད་པར་བསྟན་པ་ནི།",
    "ཇི་ལྟར་བརྗོད་ཀྱང་རང་བཞིན་མེད་པའི་ཕྱོགས་སུན་འབྱིན་མི་ནུས་པའི་ཚུལ་གྱིས་མཇུག་བསྡུ་བ་གསུམ།",
    "བདེ་བླག་དུས་གཅིག་གཞལ་བའི་སྟོབས་ཤུགས་ཞན།",
    "དེས་ན་གཞུང་རྣམས་སུ་བདེན་གྲུབ་དང་རང་མཚན་གྱིས་གྲུབ་པ་སོགས་ལ་ཁྱད་མེད་དུ་དགག་པ་དང་།",
    "དེ་ལྟར་ཐ་སྙད་དུ་སེམས་ཉིད་སྣང་བ་སྣ་ཚོགས་པར་སྣང་ཡང་སེམས་ཀྱང་རང་བཞིན་གྱིས་བདེན་པར་མེད་པས་ན།",
    "ཉི་མ་སྒྲ་གཅན་གཟའ་བྲལ་ལྷང་ངེར་འདུག་པ་དང་།",
    "རང་རང་ལ་གྲགས་ཤིང་གྲུབ་པའི་སྣང་ཚུལ་སྣ་ཚོགས་ཡོད་པའི་རང་ངོའི་སྣང་བ་དེ་དག་ཐད་ཀ་རང་སར་སྤྲོས་བྲལ་དུ་གཏན་ལ་འབེབས་པ་ཡིན་གྱི།",
    "ཀུན་གཞི་དང་རང་རིག་ཐ་སྙད་ཙམ་དུ་ཁས་ལེན་པའི་ལུགས་ལ་རྣམ་པ་ཀུན་ཏུ་མི་འཇུག་པར་ཤེས་པར་བྱ་སྟེ།",
    "བདེན་གཉིས་སོ་སོ་རང་ས་ན་འདུག་པ་ལྟ་བུའི་ཐ་དད་དུ་ཞེན་པ་ཞིག་ནས།",
    "རང་རྒྱུད་པས་ཀྱང་རང་མཚན་གྱིས་གྲུབ་པ་དོན་དམ་དཔྱད་བཟོད་དུ་བསྒྲུབ་པ་མིན་པས།",
    "དེ་སྐད་དུའང་རང་འགྲེལ་ལས།",
    "གཞུང་འདིར་ཡང་རང་འགྲེལ་ལས།",
    "ཡང་རང་རྒྱུད་དུ་སྦྱོར་ཡང་རུང་སྟེ།",
    "དེས་ན་དམིགས་པ་ཉིད་ཐད་ཀ་རང་ས་ན་ཡིན་ཡིན་ལྟར་སྣང་འདུག་པ་སྟེ།",
    "རིལ་པོ་གཅིག་མིན་ཀྱང་རུང་རང་བཞིན་ནམ་རྒྱུད་ལྟ་བུ་གཅིག་ཡིན་པས་གནས་སྐབས་ཐ་དད་ནའང་རྟག་པ་ཡིན་པ་ཅི་འགལ་སྙམ་དུ་སེམས་པ་སྟེ།",
    "འདི་ལ་འགྲེལ་ལུགས་སྣ་ཚོགས་མཛད་འདུག་ཀྱང་གཞུང་དོན་མ་ནོར་བ་འདི་ཁོ་ནའོ།",
    "སོ་སོར་བརྟགས་པའི་སྟོབས་ཀྱིས་ཁེགས་པ་མིན་ཡང་རང་བཞིན་གྱི་རྐྱེན་མ་ཚང་བས་གང་སྐྱེ་བ་མིན་པ་ལ་དེ་མ་སྐྱེས་པའི་ཆ་དེ་ག་ལ་དངོས་པོ་དེ་སྐྱེ་བའི་གེགས་བྱེད་པའི་འདུས་མ་བྱས་སོ་སོར་བརྟགས་མིན་ཞེས་རྫས་སུ་རློམ་པ་དང་།",
    "འབྲས་བུ་མི་བསྐྱེད་ཀྱང་རང་བཞིན་གྱིས་རྟག་པར་འདོད་པ་བྱེ་སྨྲའི་ལུགས་ལའང་མི་འཐད་པ་ཡོད་ཅེས་གོང་མ་དང་ཕྱོགས་སྦྱར་ཏེ།",
    "ཡུལ་ཁོ་རང་རྟག་པ་ཡིན་པའམ་གཅིག་བདེན་ཡིན་ན།",
    "ཤེས་པ་མིན་པ་བུམ་པ་མིན་པ་སོགས་ཁོ་རང་མིན་པའི་ཤེས་བྱའི་ཆ་ཇི་སྙེད་ཡོད་པ་དེ་སྙེད་ཀྱི་གྲངས་སུ་དབྱེར་རུང་ལ།",
    "དངོས་མེད་ཁོ་རང་རང་རྐྱ་ཐུབ་པར་གཞིར་བཞག་ལ་དགག་སྒྲུབ་མི་བྱེད་པར་བསྟན་ན་དོན་དམ་པར་མ་གྲུབ་པ་ལྟ་ཅི་སྨོས།",
    "དེ་ལ་བློས་དམིགས་ནས་བདག་དང་སྐྱེས་བུ་ལ་སོགས་པའི་རྣམ་གྲངས་ཀྱིས་བརྗོད་ཅིང་རང་རྒྱུད་དུ་གཏོགས་པ་གང་ཡིན་པ་དེ་ལ།",
    "སེམས་པ་ལ་སོགས་པའི་སེམས་བྱུང་རྣམས་ཀྱང་རང་བཞིན་མེད་པར་བདེ་བླག་ཏུ་ཤེས་ནུས་སོ།",
    "མ་ཡིན་པར་བརྗོད་པ་ཞེས་གཟུང་འཛིན་གྲངས་མཉམ་འགོག་པའི་རིགས་པ་བསྟན་འདུག་པ་འདིས་གཟུང་འཛིན་གྲངས་མཉམ་འདོད་ཚུལ་གཞན་གྱི་ལུགས་དགག་པའི་ཤུགས་ཀྱིས།",
    "དེ་ལ་སྐབས་འདིར་ཕལ་ཆེར་རྟོག་པ་དང་རྟོག་མེད་ཀྱི་བྱེད་པ་འདྲེས་ཏེ་ཚུལ་བཞིན་སྨྲ་བ་དཀོན་པར་འདུག་ནའང་།",
    "དེས་ན་དོན་བུམ་པ་ལྟ་བུ་མངོན་སུམ་མཐོང་བ་ལས་ཀྱང་རང་བློ་རང་ལ་ལྐོག་ཏུ་མ་གྱུར་པ་འདི་རང་རིག་པའི་བདག་ཉིད་མིན་ན་བློས་ཡུལ་རིག་པའམ་མྱོང་བ་ཐམས་ཅད་མི་སྲིད་པས་རང་རིག་ཆེས་འཐད་དོ།",
    "དེ་ཕྱིར་དྲན་པ་ནི་འདས་པའི་ཡུལ་ཅན་ཁོ་ན་ཡིན་པས་མདུན་ན་འདུག་པའི་དངོས་པོ་ལའང་ཤིན་ཏུ་གསལ་བར་མི་རྟོག་སྟེ་ད་ཡུལ་ཅན་མིན་པའི་ཕྱིར་རོ།",
    "ཡུལ་ཁྲ་བོས་ཀྱང་རང་འཛིན་མིག་ཤེས་ལ་སྔོ་སེར་སོགས་ཡུལ་ལ་ཇི་སྙེད་ཡོད་པའི་རྣམ་པ་གཏད་ལ་ཤེས་པའང་དེ་སྙེད་ཀྱི་རྣམ་ལྡན་དུ་སྐྱེ་བར་འདོད་པ་སྟེ།",
    "ཅིག་ཅར་ཁོ་རང་བརྗོད་ཀྱང་རུང་སྟེ་དོན་དུ་དངོས་པོའི་རང་བཞིན་གཅིག་པུ་དེ་ལས་མ་འདས་སོ།",
    "རང་འགྲེལ་ན་ཕྱོགས་སྔས་བརྗོད་པའི་ཤྭ་ལོ་ཀ་གཉིས་བཀོད་འདུག་པའང་དེ་ཡིན་ནོ།",
    "ལམ་སྦྱོང་དཀའ་ཐུབ་ཀྱིས་གྲོལ་བ་མེད་ཀྱང་རང་བཞིན་ཤི་བ་ན་ཐམས་ཅད་གྲོལ་བ་གཅིག་པའི་དབྱིངས་སུ་གནས་པའི་རྒྱུ་འབྲས་མེད་པའི་ཚུལ་ཤེས་ན་གྲོལ་བའི་ཆེད་དུ་ངལ་དུབ་སོགས་ལ་མི་བརྟེན་པའི་རྒྱང་འཕེན་གྱི་གཞུང་བསྟན་པ་དོན་མེད་མིན་པའི་ཚུལ་ཏེ་དེ་ལྟར་འདོད་དོ།",
    "སྐབས་འདིར་སྔོན་གྱི་རྣམ་རིག་སྨྲ་བའི་སློབ་དཔོན་ཁ་ཅིག་དུས་ཅིག་ཅར་རིགས་མཐུན་པའི་ཤེས་པ་དུ་མ་སྐྱེ་བར་འདོད་པ་ནི་ཐ་སྙད་དུའང་མི་འཐད་ལ།",
    "ཡུལ་ཅན་གྱི་ཤེས་པས་ཀྱང་རང་སྟོབས་ཀྱི་ཡུལ་དེ་ལ་མེད་པའི་དངོས་པོ་དེ་ཤེས་པར་བྱར་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེའང་རྟའི་རྭ་ཅོ་ལ་ཁོ་རང་སྣང་བའི་ཤེས་པ་བསྐྱེད་པའི་ནུས་པ་མེད་པས།",
    "གཉིས་སྟོང་རང་གསལ་གྱི་རྣམ་པ་ཅན་དུ་འདོད་པ་ཁོ་རང་རྣམ་པ་མེད་པ་ཡི་ཚུལ་ཉིད་ཀྱིས་མྱོང་བར་འགྱུར་རིགས་ནའང་།",
    "དེའང་མིག་ཤེས་ལྟ་བུ་ལའང་གཟུགས་ཀྱི་རྣམ་པ་མཐའ་དག་མ་དམིགས་ན་མིག་ཤེས་ཁོ་རང་འདིའོ་ཞེས་གཟུང་བར་མི་ནུས་པ་དེ་བཞིན་རྣམ་པ་མེད་པའི་ཤེས་པ་རྐྱང་པ་ཉམས་སུ་མྱོང་བ་མེད་དེ།",
    "ཞིག་པ་ཁོ་རང་རྒྱུ་ལས་མ་བྱུང་བའི་དངོས་པོར་འགྱུར་བ་སོགས་གནོད་པ་མཐའ་ཡས་པ་དེས་ན་རྒྱུ་ཞིག་ནས་མེད་པའི་ཆ་ལ་ཞིག་པ་ཞེས་བཏགས་པ་ཡིན་གྱི།",
    "རྣམ་པ་སྣ་ཚོགས་སུ་སྣང་ཡང་རང་བཞིན་མེད་པ་ཞིག་ཡིན་ནོ་། དེས་ན་རང་བཞིན་མེད་པར་དཔྱད་པ་དེས་ཀྱང་ཀུན་རྫོབ་ཀྱི་ཡིན་ལུགས་ལ་ཟློག་ཕྱོགས་སུ་སྒྲོ་འདོགས་པ་སེལ་བ་ཡིན་པས་ཀུན་རྫོབ་ཀྱི་ཡིན་ལུགས་གསལ་བར་བྱས་པ་ཡིན་ཏེ།",
    "དེའང་རང་མིན་པ་བསལ་བའི་ཚུལ་གྱིས་དེའི་ངོ་བོ་ཤེས་པར་བྱ་བ་རྣམ་བཅད་དང་།",
    "ཁོ་རང་ལའང་དེ་གཏན་མེད་དུ་ཤེས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "འདས་པའི་དུས་ནའང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་། འདས་པ་སྟེ་ངོ་བོ་མེད་པའི་སླད་དུའོ།",
    "དེ་སྐད་དུའང་རང་འགྲེལ་གྱི་མཇུག་རྩོམ་དུ།",
    "རྒྱན་དྲུག་རྗེས་འབྲངས་དང་བཅས་པའི་གཞུང་བཟང་པོ་སྔ་འགྱུར་འདི་ཙམ་གདའ་བས།",
    "དེའང་རང་འགྲེལ་ལས།",
    "སླར་ཡང་རང་འགྲེལ་དང་དཀའ་འགྲེལ་གཉིས་ལའང་བལྟ་བར་བྱས་ན་ལེགས་སོ།",
    "དེ་ཁོ་རང་དེ་ལྟར་མིན་ནོ་སྙམ་ན།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "འདི་འདྲའི་ལུགས་དེ་རྒྱལ་བསྟན་སུན་འབྱིན་དང་རང་ཕྱོགས་ཕུང་བྱེད་དང་།",
    "གཞན་སྟོང་པ་རྣམས་ཀྱིས་ཀྱང་ཧ་ཅང་ང་སྤྲོས་པས་ཆོག་པར་འདུག་གོ།",
    "དེ་བློ་ལ་མ་ཤར་ནས་དོན་མེད་ཀྱི་སྨྲ་བ་བརྗོད་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་ནས་ཕྱི་དོན་དུ་གྱུར་པའི་གཟུགས་དང་བེམ་པོ་སོགས་མེད་། ཅེས་ཤེས་བྱ་ཀུན་ལ་སྦྱར་ཤེས་ན་ལེགས་འདུག་པས།",
    "རྟོག་བཅས་ཀྱི་ཤེས་པའང་ཕྱི་རོལ་ཡུལ་ལ་ལྟོས་ཏེ་རྟོག་བཅས་ཡིན་ཀྱང་ནང་རང་རིག་པའི་ཆ་ནས་རྟོག་མེད་ཡིན་པ་འགལ་བ་མེད་དོ།",
    "འདི་རྣམས་དོགས་པའི་གནས་སུ་འདུག་པས་དེ་ལྟར་བཅད་པའང་དོན་ཡོད་དོ།",
    "ཨོཾ་བཛྲ་ཨ་ཙ་ན་ཤྲ་ཧེ་ཧཱུྃ་ཕཊ།",
    "དེ་ནས་སློབ་དཔོན་ཞལ་བསིལ་གྱི་བུམ་པས་ཁ་བཤལ་ནས་གདོང་བཀྲུས་ཏེ་ཉེ་བར་འདུག་ལ།",
    "སྔ་མ་བཞིན་དུ་རང་ངམ་གཞན་གྱི་གཏོར་མའི་ལས་ལག་པ་གཉིས་ཀྱིས་བྱས་ནས་མི་སྨྲ་བར་འདུག་པར་བྱའོ།",
    "དེ་ནས་སློབ་དཔོན་ལངས་ནས་དཀྱིལ་འཁོར་གྱི་ཤར་དུ་ཉེ་བར་འདུག་པར་བྱའོ།",
    "ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་པའི་རིམ་པས་བསྟོད་པ་ལ་སོགས་པ་བྱའོ།",
    "ཨོཾ་པདྨ་ལོ་ཙ་ནི་ཧཱུཾ།",
    "སླར་ཡང་ཉེ་བར་འདུག་སྟེ་ཡང་དག་པར་བསྟོད་ནས་ཨོཾ་བཛྲ་མུ་ཞེས་བཟླས་ཏེ་རོལ་",
    "དེས་ན་འཁོར་འདས་ཀྱི་རྩ་བར་འདུག་པས་རྩ་རྒྱུད་ཅེས་བྱའོ།",
    "དེ་ཙ་ན་བདུད་ཀྱིས་ལུང་སྟོན་པ་འབྱུང་སྲིད་པས།",
    "དེ་རྣམས་ཀྱིས་བདེ་བ་ཆེན་པོའི་ཏིང་ངེ་འཛིན་སྐྱོན་མེད་གསུམ་ལ་སྒྲིབ་པར་འདུག་པས་བདེ་ཆེན་གྱི་སྒྲིབ་པ་ཞེས་བྱའོ།",
    "ཡང་ནམ་མཁའ་མཐོང་སར་འདུག་སྟེ་ནམ་མཁའ་གསལ་བར་དམིགས་ལ་མེ་དང་ཉི་མའི་འོད་མི་ཡོང་བར་བྱས་ལ།",
    "རྩ་སྦུབས་སྟོང་པར་འདུག་པའི་ཧ་ཅང་ལྟོགས་པ་དེ་རྣམས་ནི།",
    "བདག་གཞན་ཡང་དེ་ན་འདུག་པ་མཐོང་སྟེ།",
    "བདག་གཞན་ཡང་དེར་འདུག་པ་མཐོང་།",
    "བདག་ཉིད་སྲིན་པོར་འདུག་པ་དང་།",
    "དེ་ཙ་ན་བདེ་བའི་ཉམས་མྱོང་ཆུང་བས་དགའ་བའི་ཡེ་ཤེས།",
    "ས་ཆེན་འདི་ནི་དགའ་ཞིང་རངས་ལ་མགུ།",
    "དེ་ཙ་ན་སྦ་བ་སྦུབས་སུ་ནུབ།",
    "ཤིང་གཉིས་ཀྱི་བར་དུ་རང་བཏགས་ཏེ་འདུག་གོ།",
    "ཁྱེད་རང་རྣམས་སྔར་བཞིན་དུ་བྱ་གསོད་པའི་ལས་ཀ་མ་གཏོང་བར་སྒྲུབས་ཤིག་ཅེས་ཟེར་ནས་བྱ་གསོད་པ་ལས་བཟློག་པར་མ་ནུས་པར།",
    "དེའི་ཞབས་ལ་འཁོར་ལོའི་མཚན་འདུག་པ་རྒྱལ་བུས་མཐོང་ནས་འདི་རབ་ཏུ་མ་བྱུང་ན་ངེས་པར་སྟོང་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོར་འགྱུར་རོ་སྙམ་སྟེ།",
    "དེའང་རིའི་རྒྱལ་པོ་རི་རབ་ནི་གསེར་གྱི་རི་བདུན་གྱིས་བསྐོར་བས་དེ་དག་ལ་ཆ་ཞིང་འདུག་པར་བྱེད་དེ།",
    "དེ་ལྟར་ང་ལས་ནུས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་ནང་ན་འདུག་ང་ལ་བརྒྱ་བྱིན་སུམ་ཅུ་རྩ་དྲུག་ཤི་འཕོས་པ་ལོན་ནོ།",
    "སྟན་ཕྱེད་ལ་ནི་རྒྱལ་པོ་འདུག།",
    "གསེར་གྱི་རི་བདུན་ནས་སུམ་ཅུ་རྩ་གསུམ་པའི་གནས་སུ་བརྒྱ་བྱིན་གྱི་སྟན་ཕྱེད་ལ་འདུག་སྟེ།",
    "གཤེགས་པ་ན་ཕྱི་བཞིན་འགྲོ་ལ་བཞུགས་པ་ན་མེ་ཏོག་དེ་དག་ཀྱང་འདུག་པར་གྱུར་ཏོ།",
    "བརྒྱ་བྱིན་གྱིས་ལོང་ཞིང་ལྐུགས་པ་ཞིག་ཏུ་སྤྲུལ་ཏེ་སྒོ་ཁང་དུ་འདུག་ནས་བསླངས་པ་དང་།",
    "གལ་ཏེ་ལྡོག་པར་གྱུར་གདའ་ཡི།",
    "ད་ནི་ལམ་རབ་ཏུ་རིང་པོར་འགྲོ་བ་སྡུག་བསྔལ་ན་འདིར་འདུག་སྨྲས་པ་ན།",
    "རི་དེ་ནི་རོང་རོང་དང་ཟད་ཟེད་དུ་འདུག་པ།",
    "འདི་ལྟར་དཀའ་ཐུབ་ཀྱི་ནགས་ན་འདུག་པའི་བུ།",
    "དེ་ནས་བུའི་མ་རི་ལ་འདུག་པ་ཡང་རྐང་མཐིལ་གཡོན་པ་གཡའ་བ་དང་།",
    "བདག་སྡོད་པ་ན་གཉིས་ཀ་གཡས་གཡོན་དུ་འདུག་ནས་ཕྲག་པ་དང་གོས་ལ་རྡུལ་གོས་པ་རྣམས་ལ་འཕྱི་ཞིང་སྨུག་པར་བྱེད་ན།",
    "བྱིས་པ་གཉིས་ཤིན་ཏུ་བཀྲེས་སྐོམ་གྱི་ན་འདུག་པ་ལ་བརྒྱ་བྱིན་གྱིས་ལྷའི་དྲི་བསུང་སྤྲུལ་ཏེ།",
    "དེ་ག་ལ་འདུག་པ་བདག་ལ་སྟོན་ཅིག་ཅེས་པ་དང་།",
    "སླར་ཡང་རང་ཉིད་ཟའམ་ཅི།",
    "དམན་པའི་བཞིན་གྱིས་དེའི་དྲུང་དུ་འདུག་པ་དང་།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་ནི་ཞིག་ནས་འདུག་གོ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་ནི་ཆགས་ནས་འདུག་གོ་ཞེས་གསུངས་སོ།",
    "མེ་ཏོག་དུས་ཀྱི་རྗེས་འབྲང་བས།",
    "མགྲོན་པོའི་བདག་པོ་དང་ལྷན་དུ་འདུག་ནས་ནམ་གྱི་ཆ་སྨད་ལ་པདྨའི་རྩ་ལག་ཅན་འགྲོའོ་ཞེས་སྨྲས་ནས།",
    "དེའི་སྟེང་ན་མེ་འབར་བ་འདུག་པ་མཐོང་བ་དང་།",
    "རྒྱ་མཚོར་གཏོགས་པ་དེར་འདུག་གོ།",
    "ཡང་ཡི་དྭགས་འགའ་ཞིག་ནི་ལུས་ཤིང་སྐམ་འདྲ་ཞིང་གནག་ལ་སྐུ་རིང་པོས་གཡོགས་ཏེ་མུན་ཁྲོད་དུ་འདུག་ལ།",
    "ཡང་རང་གཞན་གྱི་བུ་ཚ་བསད་པ་དང་།",
    "གསེར་གྱི་རྒྱལ་པོ་ལྷམ་མེར་འདུག་པ་དང་།",
    "ཧ་ཧ་ཞེས་བྱ་བའི་སྒྲ་དང་བཅས་པས་རི་རབ་ཀྱི་ཁོང་གསེང་དུ་སྒྲ་གཅན་གུང་དུ་འདུག་པ་དེར་རྒྱུག་གོ།",
    "མི་འཐབ་པའི་དུས་སུ་རི་རབ་ཀྱི་ངོས་ལ་འདུག་པ་ན།",
    "ཉི་མའི་འོད་ཀྱིས་སྒྲ་གཅན་གྱི་མིག་ལ་ཕོག་དུས་ལག་པས་བསྒྲིབས་པ་ན་རྟོག་གེ་བ་དག་གཟས་བཟུང་ངོ་ཞེས་སྨྲའོ།",
    "སྒྲ་གཅན་ནི་དང་པོ་ཁོ་ན་ལ་འདུག་སྟེ།",
    "མགོ་བདུན་པོ་ནི་ཝཱ་རཱ་ཎ་སཱིར་སླེབས་པར་བྱས་ཏེ་འདུག་གོ།",
    "ཆུ་ཀུན་ཐ་མལ་འདུག་པས་རབ་ཏུ་གཡོས།",
    "འདི་ལྟར་གདའ་བ་རྒྱ་མཚོ་གང་ཞིག་ལགས།",
    "དེ་ལྟར་གདའ་བའི་རྒྱ་མཚོ་འདི་གང་ལགས།",
    "གང་ཡང་རང་རྒྱལ་དང་ནི་གཉིས་པ་དང་།",
    "འདི་དག་རིགས་དང་རང་བཞིན་དེ་ལྟར་ལགས།",
    "རྒྱལ་པོའི་ཟས་བྲེའུ་གང་ལས་མི་འདུག་ནས།",
    "དེ་མ་བྱུང་ན་དྲི་ཟའི་མིང་ཡང་དོན་མེད་པར་འགྱུར་རོ་བྱས་པས་ཁོ་རང་རབ་ཏུ་སྐྱེངས་ཤིང་ཞུམ་པའི་ཚེ་འདི་སྐད་ཅེས་འདི་ལྟ་བུ་དག་ཤེས་ཀྱང་དགོས་པ་ཅི་ཡོད།",
    "སློབ་དཔོན་ཀླུ་སྒྲུབ་ལ་སོགས་པའང་བསྟན་བཅོས་ཀྱི་སྔོན་དུ་མཆོད་བརྗོད་མཛད་ཅིང་འདུག་ལ།",
    "འདུག་ཀྱང་རུང་།",
    "དེའང་རང་དོན་སྤངས་རྟོགས་གཉིས་མངའ་བས་རྒྱལ་བ།",
    "སྤྱོད་ཀྱང་ཉན་ཐོས་ས་དང་རང་རྒྱལ་སེམས་བསྐྱེད་ན།",
    "འདུག་ན་བདག་འདུག་གོ་ཞེས་བྱ་བར་རབ་ཏུ་ཤེས་སོ།",
    "འཇིག་རྟེན་བདེ་དང་རང་སྲོག་ལ།",
    "ཡང་བི་རོ་ཙ་ན་རཀྵི་ཏས།",
    "ལྟེང་ཀ་གསུམ་ན་འདུག་པའི་ཉ་བཞིན་ནོ།",
    "གཉིས་མེད་ཀྱང་རང་རིག་པར་མར་མེ་བཞིན་ཞེ་ན།",
    "ཁྱེད་རང་རྒྱུད་པར་འདོད་ལ།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ་དང་།",
    "བདག་ཀྱང་རང་བཞིན་དེ་ལས་མ་འདས་པས།",
    "ཁ་འཐོར་མི་ཡུལ་བྱ་དང་རི་དགས་སོགས་ རྔོན་པས་གཙེ་ཞིང་རང་རང་གནོད་པས་ཉེན།",
    "མཐུ་སྟོབས་ཉམས་པས་འགྲོ་འདུག་བསྒུལ་བསྐྱོད་དཀའ།",
    "རང་རང་ས་དེར་ལྡན་པར་ཤེས་པར་བྱ།",
    "རིགས་བེ་། དང་རང་བཞིན་ཀུན་སྤྱོད་སྐལ་པ་ངན།",
    "མཐར་ཡང་རང་ཉིད་ལུས་ཅན་ཀུན་གྱི་སྐྱབས།",
    "རང་རང་བདེ་བས་གནས་ཏེ་མ་དགའ་བ་བསྒོམ།",
    "རང་རང་གཞུང་ནས་གསུངས་པའི་ལུང་མནོས་ཏེ།",
    "དེ་ཡང་རང་སེམས་རྣམ་དག་ཚུལ་ལ་བསླབ།",
    "སུས་ཀྱང་མི་མཐོང་ཁོ་བོ་གང་ན་འདུག།"
  ]
