    "ཕལ་མོ་ཆེས་ནི་ཕ་རྒྱུད་མ་རྒྱུད་གཉིས་ལས་གཉིས་སུ་མེད་པའི་རྒྱུད་མཆོག་ཏུ་གྱུར་པའོ་སྙམ་དུ་བསམས་ནས།",
    "ཐབས་ཤེས་ཕྱོགས་རེ་བའི་རྒྱུད་གཉིས་འགལ་བར་འདུག་སྙམ་དུ་བཟུང་ནས།",
    "དེ་ལ་རྣལ་འབྱོར་མ་བླ་ན་མེད་པ་དང་རྣལ་འབྱོར་ཕ་བླ་ན་མེད་པ་གཉིས་ཀའི་རྣལ་འབྱོར་གྱི་དོན་ནི་ཐབས་ཤེས་ཕྱོགས་རེ་བ་མིན་པར་ཐབས་ཤེས་མཉམ་པར་སྦྱོར་བར་གསུངས་པའི་ཐབས་ནི་ལྷན་ཅིག་སྐྱེས་པའི་བདེ་བ་ཆེན་པོ་ཡིན་ལ།",
    "རང་གི་ངོ་བོས་ནི་ཐམས་ཅད་ཤེས་རབ་དང་ཐབས་ཀྱི་བདག་ཉིད་ཅན་རྣལ་འབྱོར་གྱི་རྒྱུད་ཉིད་དེ།",
    "དེ་གཉིས་བདེ་སྟོང་གི་ཐབས་ཤེས་ལ་བལྟོས་ན་རེ་རེ་བའི་རྒྱུད་ཡིན་པ་འགོག་གི།",
    "བདེ་བ་ཆེན་པོ་མ་རྒྱུད་ཀྱི་ཐུན་མོང་མ་ཡིན་པའོ་སྙམ་པ་དང་།",
    "དེ་བཞིན་བདག་གིས་ཅུང་ཞིག་བརྗོད།",
    "རྒྱུད་གཉིས་པོ་གང་གི་ལམ་དུ་འཇུག་ཀྱང་བདེ་སྟོང་གི་ཐབས་ཤེས་གཉིས་ངོ་བོ་དབྱེར་མེད་དུ་རྒྱུད་ལ་སྐྱེད་པ་ཞིག་མེད་མི་རུང་དུ་ཤེས་དགོས་ལ།",
    "དེའི་འཇོག་ཚུལ་རེ་ཞིག་དྲི་མེད་འོད་ལས་གསུངས་པ་ནི།",
    "ཁམས་དག་པ་ལས་ཤེས་རབ་ཏུ་བཞག་པའི་ལྷ་མོའི་སྒོ་ནས་ཐབས་ཤེས་སོ་སོ་བའི་རྒྱུད་དུ་བཞག་ལ།",
    "ལྷ་ཕོ་མོའི་སྒོ་ནས་ཐབས་ཤེས་ཀྱི་རྒྱུད་དུ་འདོད་ཚུལ་ཡང་དེ་ཉིད་ལས།",
    "ཞེས་ལྷ་དམ་ཚིག་པ་ལ་ཡེ་ཤེས་པ་འགུག་པ་ལ་སོགས་པའི་བྱ་བ་བྱེད་པ་ལ་ལྷ་མོ་རྣམས་རྒྱུ་ཞིང་ལྷ་ཕོ་རྣམས་མི་རྒྱུ་བ་ཤེས་རབ་དང་།",
    "རྒྱུད་གཉིས་སུ་འཇོག་ཚུལ་ལྷ་ཕོ་མོའི་སྒོ་ནས་བཞག་པ་དེ་ཡང་ཤས་ཆེ་ཆུང་ལ་དགོངས་ཀྱི་ངེས་པ་ནི་མིན་ཏེ།",
    "དེ་བཞིན་དུ་ལྷ་མོས་དགུག་གཞུག་སོགས་མི་བྱེད་པའི་མ་རྒྱུད་ཀྱི་གཞུང་ཚད་ལྡན་ཡང་ཡོད་པ་དང་།",
    "རྒྱུད་གཉིས་ཀའི་ཐུན་མོང་གི་རྣམ་གཞག་སྟོན་པའི་རྒྱུད་འགའ་ཞིག་ལ་དེ་གཉིས་ཀ་སྟོན་པ་ཡང་མི་འགལ་བའི་ཕྱིར་རོ།",
    "འདི་འདྲའི་རིགས་ལ་ཁ་ཅིག་ན་རེ།",
    "དེ་དག་ལ་ཕོ་མོའམ་ཐབས་ཤེས་ཀྱི་དོན་གྱི་ལྡོག་པ་ཅི་ཡང་མི་སྣང་བའི་ཕྱིར་རོ།",
    "བཙུན་མོ་རྣམས་ནི་བསྡུ་བའི་ཕྱིར།",
    "ཞེས་གསུངས་པའི་དང་པོ་བཞིས་དེ་བཞིན་གཤེགས་པ་མཁའ་འགྲོ་མའི་སྐུར་སྟོན་ཞིང་མོས་གཙོ་བྱས་པའམ།",
    "འཁོར་མོ་ཚོགས་ཤས་ཆེ་བས་བསྐོར་བ་ནི་མ་རྒྱུད་དང་།",
    "བཙུན་མོ་རྣམས་ནི་བསྡུ་བའི་ཕྱིར།",
    "བདག་གིས་བསྒྲལ་བར་བྱའོ་ཞེས།",
    "ཅི་ཕྱིར་བཙུན་མོ་རྣམས་བོར་བྱ།",
    "འོ་ན་རྡོ་རྗེ་གུར་དུ་བུད་མེད་ཇི་ལྟར་བསྡུ་ཞེས་འདྲི་བའི་དྲིས་ལན་གྱི་དོན་གང་ཡིན་སྙམ་ན།",
    "རེ་ཞིག་ལྟ་བ་ལོག་པས་ཀྱང་ལམ་འདི་ལ་བརྟེན་ནས་མཆོག་སྒྲུབ་ཏུ་ཡོད་པས།",
    "དེ་ཉིད་མོ་གཟུགས་བསྡུ་ཕྱིར་རོ།",
    "དང་པོར་རྒྱུད་རྒྱས་པ་འབུམ་ལྔ་གསུངས་པའི་ཕྱི་ནས་དེ་ལས་བསྡུས་ནས་རྣལ་འབྱོར་མའི་རྒྱུད་གུར་གསུངས་པ་དེ་བུད་མེད་བསྡུ་བའི་ཕྱིར་དུ་ཡིན་ཞེས་གསུངས་སོ།",
    "ཚུལ་དེ་ཡང་རྒྱུད་གཉིས་ཀ་ལ་ཡོད་མོད་ཀྱང་།",
    "གསང་བ་མཆོག་གིས་དགྱེས་པ་སོགས་གླེང་གཞིར་བྱས་པ་མ་རྒྱུད་གྱི་དོན་དུ་བཞེད་ཟེར་བ་ནི་དེའི་བཞེད་པ་མིན་ཏེ།",
    "ཕལ་ཆེ་བ་ལ་ཐབས་དང་ཤེས་རབ་ཀྱི་རྒྱུད་དུ་འཇོག་པའི་ཕོ་མོའམ་ཐབས་ཤེས་ཀྱི་དོན་གྱི་ལྡོག་པ་ཅི་ཡང་མི་སྣང་ལ།",
    "རྒྱུད་འདི་གཉིས་ལ་བསྐྱེད་རིམ་གྱི་སྐོར་ནས་ཀྱང་སོ་སོར་འཇོག་པའི་ཕལ་པའི་ཁྱད་པར་ཡང་འདོད་མོད་ཀྱང་གཙོ་བོར་རྫོགས་རིམ་གྱི་སྒོ་ནས་ཁྱད་པར་གཞག་དགོས་སོ།",
    "དེ་ལ་བལྟོས་ནས་ནི་ཤས་ཆེ་ཆུང་གི་སྒོ་ནས་ཀྱང་གཞག་ཏུ་མི་རུང་སྟེ།",
    "གང་དང་དེ་གཉིས་འབྲེལ་བས་གང་གི་ཕྱིར་དོན་དམ་པའི་དེ་ཁོ་ན་སྟོང་པ་ཉིད་ལ་ཕྱག་རྒྱ་ཆེན་པོའི་སྦྱོར་བས་རབ་ཏུ་འཇུག་པའི་ཚུལ་སྟོན་པ་དེའི་ཕྱིར་གུར་ལ་སོགས་པ་ལ་རྣལ་འབྱོར་མའི་རྒྱུད་ཅེས་བྱའོ།",
    "འོད་གསལ་སྒྱུ་མ་བདག་གིས་ནི།",
    "གང་གིས་ན་སྟོན་པ་བདག་གིས་སོ།",
    "གང་གིས་སྒྲུབ་ན་རྒྱུད་དེར་གསུངས་པའི་དེ་དང་དེའི་ཆོ་གའི་དབྱེ་བ་སྟེ་ཁྱད་པར་ལེགས་པར་ཤེས་པས་སོ།",
    "དེ་ནས་ཕྱིར་ལ་ལྡང་བའི་རིམ་པ་ལས་ལུགས་ལྡོག་གི་སྟོང་པ་བཞིའི་སྒོ་ནས་སྟོང་པའི་ཡེ་ཤེས་སྐྱེ་ཚུལ་དང་།",
    "ཁྱད་པར་དེ་གཉིས་ནི་ཕ་རྒྱུད་དང་མ་རྒྱུད་ཀྱི་གཙོ་བོ་རེ་ལ་ཚད་ལྡན་གྱིས་བཀྲལ་བའི་ཚུལ་སྣང་ན།",
    "གང་གིས་ལེགས་པར་ཤེས་ན་ནི།",
    "ལྷ་མོ་བཞིས་ཞུས་བརྒྱ་བདུན་ཅུ།",
    "ལྷ་མོ་བསྟན་བཅོས་ལྔ་བརྒྱ་བདུན།",
    "འདི་རྣམས་དགོངས་པའི་བྱེ་བྲག་གིས།",
    "དེ་བཞིན་ཞེ་སྡང་གཏི་མུག་གི།",
    "ཞེ་སྡང་གི་ཐབས་རྒྱུད་ནི་གཤིན་རྗེ་གཤེད་ལ་སོགས་པའི་རྒྱུད་དང་།",
    "གཏི་མུག་གི་ཐབས་རྒྱུད་ནི་རྡོ་རྗེ་ཨ་ར་ལི་ལ་སོགས་པའི་རྒྱུད་ཡིན་ཞེས་བོད་ཀྱི་མཁས་པ་དག་གསུང་ངོ།",
    "སྟོང་ཕྲག་གི་གྲངས་རྣམས་ནི་ཤློ་ཀ་ཡིན་ནོ།",
    "ཁ་ཅིག་གིས་མཆོག་ཏུ་བསྒྱུར་ཡང་།",
    "གཞན་ཡང་ལེའུ་རེ་རེའི་སྔ་ཕྱི་ལ་ཡང་དེ་ལྟར་གཞག་དགོས་པ་སོགས་ཀྱི་སྐྱོན་ཡོད་ལ།",
    "རྩ་རྒྱུད་ལེའུ་བཅུ་བདུན་པོ་ཐམས་ཅད་ཀྱི་ཐུན་མོང་གི་དོན་དང་ལེའུ་སོ་སོའི་དོན་དཀའ་ཞིང་སྦས་པ་རྣམས་གསལ་བར་འབྱེད་པས་འདུས་པ་ཕྱི་མ་ཞེས་ཟེར་བས།",
    "རིམ་ལྔ་ལས་ལྷ་མོ་བཞིས་ཞུས་དང་།",
    "ལྷ་མོ་བཞིས་ཞུས་ནི་དེའི་འགྲེལ་པ་ལས་ཐམས་ཅད་གསང་བའི་མཆོག་ཅེས་བྱ་བ་སྟོང་ཕྲག་གཅིག་བཞུགས་པའི་རྒྱུད་ཕྱི་མ་ཡིན་ཞེས་ཟེར་རོ།",
    "རྒྱུད་ཀྱི་ཐུན་མོང་གི་དོན་འཆད་པ་ནི་དཔལ་གསང་བ་འདུས་པ་རྣལ་འབྱོར་གྱི་རྒྱུད་ཅེས་པའི་མཚན་དོན་དང་ཐབས་རྒྱུད་ཀྱི་དབྱེ་བ་དང་རྒྱུད་སྤྱིའི་སྡོམ་ལ་དྲིས་ལན་མཛད་པ་རྣམས་ཡིན་ལ།",
    "དེ་དག་ནི་རིམ་གཉིས་སོ་སོར་མ་ཕྱེ་བར་རིམ་གཉིས་ཐུན་མོང་གི་བསྙེན་སྒྲུབ་ཡན་ལག་བཞི་བསྟན་ལ།",
    "འགྲེལ་པའི་དོན་དཔལ་གྱི་དྲིས་ལན་དུ་ལེའུ་བཅུ་དྲུག་གིས་བསྙེན་སྒྲུབ་བཞི་འཆད་པ་བྱུང་བས་ལེའུ་སོ་སོའི་དྲིས་ལན་རྣམས་དེར་འདུ་ཞིང་།",
    "འདི་ལ་ནི་ལེའུ་བཞི་བཞིས་བསྙེན་སྒྲུབ་ཡན་ལག་རེ་རེ་བསྟན་པར་འགྲོ་ཚུལ་དཀའ་བས་དེ་ལེགས་པར་ཐོན་པ་དང་།",
    "རྒྱུད་འདིར་ལེའུ་བཅུ་བདུན་པོ་སོ་སོས་དོན་འདི་སྟོན་པ་བསྡུས་པ་རེ་གསུངས་ཤིང་།",
    "དེས་ན་འདིས་རྩལ་དུ་བཏོན་ནས་རྩ་རྒྱུད་འཆད་པ་ཡང་རིམ་པ་དེ་དག་གི་སྒོ་ནས་ཡིན་ནོ།",
    "སྤྱིར་ལེའུ་རེ་བརྒྱད་དུ་འགྲེལ་པར་བྱས་སོ།",
    "སྤྱིར་ལེའུ་རེ་བརྒྱད་དུ་བྱས་སོ།",
    "མཚན་ཉིད་དང་བྲལ་སྐད་ཅིག་གི།",
    "སྤྱིར་ལེའུ་རེ་བདུན་དུ་བྱས་སོ།",
    "ཞི་བ་འོད་ཀྱིས་བསྒྱུར་བའི་ལེའུའི་གཅོད་མཚམས་དེ་ཉིད་གཞུང་གི་དོན་དུ་སྣང་སྟེ།",
    "དེ་ཡང་ཕལ་མོ་ཆེ་འདུས་པའི་དོན་གྱི་མཐའ་གཅོད་པའི་ཡན་ལག་ཏུ་སྣང་ངོ།",
    "ཞེས་སོགས་ཚིགས་བཅད་བཞི་བཅུའི་ཚིགས་བཅད་རེས་ཡི་གེ་རེའི་དོན་འཆད་པ་འདི་ཡིན་ནོ།",
    "གཞུང་དེ་དག་གིས་ལུས་དབེན་དང་།",
    "གང་གིས་གཙོ་བོ་སྒྲུབ་པ་པོ་མཐོང་རེག་པ་དང་།",
    "གང་གི་དུས་སུ་གནས་པ་དེར།",
    "དམར་ནག་གི་རྒྱུད་གཉིས་ལས།",
    "འདུས་པ་གང་གིས་མི་ཤེས་པ།",
    "གཉིས་པ་ལས་རྒྱ་ལ་བརྟེན་ནས་རང་གི་རང་བཞིན་དེ་ཁོ་ན་ཉིད་མཚོན་པར་བྱེད་པ།",
    "དེ་ལས་གང་གིས་ལྷའི་འཁོར་ལོ་ཡོངས་སུ་རྫོགས་པར་གྱུར་པ་དེ་ཙམ་ཉིད་ཅིག་བསྟན་པའི་ཕྱིར།",
    "དེས་ན་དེའི་དོན་ནི་གཤེགས་པ་གཤེགས་མ་དང་སེམས་དཔའ་སེམས་མའི་འཁོར་གང་གིས་དཀྱིལ་འཁོར་གྱི་ལྷ་རྫོགས་པ་དེ་ཙམ་ཞིག་གླེང་གཞིར་བསྟན་ཞེས་པའི་དོན་ཡིན་ལ།",
    "དེ་དག་གིས་དངོས་སུ་སྨོས་པའི་བྱང་སེམས་ཀྱི་འཁོར་རྫོགས་ཞེས་པའི་དོན་ནོ།",
    "ཡེ་ཤེས་ཞབས་ལུགས་ཀྱི་སྦྱོར་དྲུག་གི་གཞུང་རྣམས་ལས་ཀྱང་སོར་བསམ་གཉིས་བསྐྱེད་རིམ་དུ་བསྟན་ཏོ།",
    "འདི་ལ་རྒྱུད་ཕྱི་མ་ལས་ཐུན་མོང་གི་བསྙེན་པ་རྡོ་རྗེ་བཞི་དང་།",
    "མཆོག་གི་བསྙེན་པ་ཡན་ལག་དྲུག་ཏུ་གསུངས་པའི་དོན་མཆོག་གི་བསྙེན་པ་དང་བསྐྱེད་རིམ་གཉིས་འགལ་བར་འདོད་པ་མིན་ནོ།",
    "ཁྱད་པར་དུ་ཞལ་ལུང་དང་གྲོལ་བའི་ཐིག་ལེ་གཉིས་ལ་བརྟེན་པའི་མན་ངག་གིས་རྩ་རྒྱུད་ཀྱི་གཞུང་མང་པོས་རྫོགས་རིམ་བསྟན་ཚུལ་དང་།",
    "དེ་ཐོབ་པར་བྱེད་པའི་ཐབས་རྒྱུད་ལ་བཞི་ཡོད་པར་ལྷག་མ་ལེའུ་བཅུ་དྲུག་གིས་འཆད་དེ།",
    "དེ་དག་གི་རྗེས་འབྲང་རྣམས་ཀྱིས་གཞུང་ཇི་ལྟར་མཛད་པའོ།",
    "འདུས་པའི་རྒྱུད་ཀྱི་འགྲེལ་པ་འཕགས་པས་མཛད་ཟེར་བ་ད་ལྟ་འདུག་པ་འདི་ནི་བོད་ཀྱི་མཁས་པ་དག་པཎྜིཏ་ཞིག་གིས་བོད་དུ་བྱས་པ་ཡིན་ཞེས་གསུངས་ལ།",
    "རྒྱལ་བ་མཆོག་གི་བདེར་གཤེགས་ཉིད་བསྒོམས་པས་ནི་སད་གྱུར་པ།",
    "བདག་གི་གནས་ན་རབ་གནས་མགོན་པོ་ཡེ་ཤེས་ཞབས་ལ་སོགས།",
    "སློབ་དཔོན་རང་གི་གཞུང་དང་ཡང་མི་མཐུན་པས་ཁ་གཡར་དུ་བཞེད་པ་ལྟར་འཐད་པར་མཐོང་ངོ།",
    "རྡོ་རྗེ་བཟླས་པའི་རིམ་པ་ལ་སོགས་པ་རིམ་པ་ལྔའི་གཞུང་འདི་རྣམས་ལོ་ཆེན་གྱི་འགྱུར་ལ་རིམ་པ་ལྔ་པ་ཞེས་པའི་གཞུང་གཅིག་གི་ལེའུ་ལྔར་ཡང་མཛད་ལ།",
    "ཟུང་འཇུག་གི་མཇུག་ཏུ་རིམ་པ་ལྔ་བརྩམས་པའི་བསྔོ་བ་མཛད་པས་འཕགས་པ་ཉིད་ཀྱིས་མཛད་པའི་རིམ་པ་ལྔ་ངེས་པར་ཡོད་དོ།",
    "འདི་ལ་རིམ་པ་གཞན་གསུམ་ལ་མཆོད་བརྗོད་དང་བརྩམ་པར་དམ་བཅའ་རེ་ཡོད་ཀྱང་བསྔོ་བ་མེད་ལ།",
    "རིམ་པ་ཐ་མའི་མཇུག་ཏུ་བསྔོ་བ་ཐུན་མོང་དུ་མཛད་ཅིང་།",
    "རོ་བསྲེག་གི་ཆོ་ག་གཉིས་ལའང་བོད་ཀྱི་མཁས་པ་དག་བརྟག་པའི་གནས་སོ་ཞེས་བཞེད་དོ།",
    "རིམ་པ་ཁོངས་སུ་བསྡུ་བ་ནི་བོད་ཀྱི་མཁས་པ་དག་ཀླུ་བྱང་གི་ཡིན་པར་བཞེད་ལ།",
    "ཆག་ལོ་ཙྪ་བ་ཀླུ་བྱང་དང་མཚན་མཐུན་པ་ཅིག་གིས་བྱས་པར་བཞེད་དོ།",
    "བསྐྱེད་རིམ་ནས་ཟུང་འཇུག་གི་བར་གྱི་རིམ་པ་དྲུག་ཏུ་ཡང་དྲུག་དྲུག་སྡུད་པ་ཡིན་ཟེར་ནས།",
    "དཔལ་གྱི་རི་བོའི་རྩེ་མོར་ནི།",
    "ནཱ་རོ་པ་ལ་བོད་ཁ་ཅིག་གིས་ཁ་གཡར་བྱས་པར་སྣང་ངོ།",
    "མར་ལུགས་ཀྱི་རིམ་ལྔའི་གདམས་ངག་གི་རྩ་བའི་གཞུང་དུ་འདོད་པར་བྱའོ།",
    "བྱིན་བརླབས་ལམ་འདི་ཐུན་མོང་མིན།",
