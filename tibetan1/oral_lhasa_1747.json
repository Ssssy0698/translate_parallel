    "ཀུ་ཥི་དང་རཉྫི་ལས་རབ་ཏུ་སྦྱོར་བའི་ལས་ལ་བྱེད་པ་པོ་ཉིད་དང་བརྗོད་པར་འདོད་པ་ལ་ཤྱན་དང་པ་རསྨེའི་ཚིག་ཡང་ན་འགྱུར་ཏེ།",
    "དུ་ཧི་ལས་ལས་ལ་བྱེད་པ་པོ་བརྗོད་པར་འདོད་པ་ལ་ཡ་ཀ་མི་འགྱུར་ཏེ།",
    "ཤ་ཡིག་ནི་ཤཔ་ཤྱན་ལས་སོ་ཞེས་པའི་ཁྱད་པར་གྱི་དོན་ཏོ།",
    "ཨད་སོགས་རྣམས་ལས་ཤཔ་འཇིག་པར་འགྱུར་ཏེ།",
    "འཇིག་པར་འགྱུར་ཏེ།",
    "དྷི་ཞེས་པར་བསྒྱུར་བར་འགྱུར་རོ།",
    "པ་རོཀྵ་ལའང་དེ་བརྗོད་འདོད་མ་ཡིན་པ་རྟོགས་པར་བྱའོ།",
    "དྲན་པར་བྱེད་པའི་དོན་ལ་ཡཏ་མ་ཡིན་པ་ལས་ལྲྀཊའོ།",
    "གཉི་ག་ཡང་དྲན་པར་བྱེད་པའི་དོན་ཅན་གྱི་ཕྱིར་རྣམ་པར་བརྟག་པའོ།",
    "ཡུལ་དུ་བྱས་པ་ལའོ།",
    "བྱུང་བ་དེ་རིང་མ་ཡིན་པ་ཡུལ་དུ་བྱས་པ་ལྐོག་ཏུ་གྱུར་པའི་དོན་ལ་འཇུག་པའི་བྱིངས་ལ་ལང་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་གྱིས་རྣམ་པར་ཤེས་པར་འདོད་པ་དེས་ན་འདིར་མི་འགྱུར་ཏེ།",
    "འདོད་པར་བྱེད་པ་ལ་བྱུང་བ་བཞིན་ཡང་ངོ།",
    "བྱུང་བའི་ཁྱད་པར་བརྗོད་འདོད་མེད་པའི་ཕྱིར་ལང་དང་ལིཊ་དག་མི་འགྱུར་བའོ།",
    "མྱུར་བར་བརྗོད་པ་སྦྱོར་བ་ལ་འདོད་པར་བྱེད་པའི་དོན་ལ་ལྲྀཊ་འགྱུར་ཏེ།",
    "མ་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱ་བ་ལ་ལྲྀཊ་སྨོས་པ་ནི།",
    "མ་ཐོབ་པ་ཐོབ་པར་འདོད་པའི་བསམ་པ་ལ་བརྗོད་དེ།",
    "བསམ་པ་དེ་བརྗོད་པ་ནི་འདོད་པར་གྱུར་པ་སྟེ།",
    "བྱུང་བ་དེ་རིང་མ་ཡིན་པ་ལ་ལང་བྱས་པ་དང་།",
    "བྱ་བ་རབ་ཏུ་བཅིངས་པ་ཉེ་བ་ལང་བགྲོད་བཞིན་པ་དེ་རིང་མ་ཡིན་པ་ལ་བྱས་པ་དེ་དག་མི་འགྱུར་ཏེ།",
    "གཞན་ལ་རབ་ཏུ་རྣམ་པར་འབྱེད་པ་དེ་རིང་མ་ཡིན་པ་དག་ལ་བྱས་པ་དེ་མི་འགྱུར་ཏེ།",
    "ཡོ་མ་དྷྭཱ་ནི་ར་བ་དྷི་ཀོ་གནྟ་བྱསྟ་སྱ་ཡ་ད་བ་ར་མ་ཧིཙྪ་ཏྲཱཏ།",
    "སྨད་པ་ལ་ཀ་ཐཾ་ལ་ལིངའོ་ཞེས་འཆད་པར་འགྱུར་རོ།",
    "བྱུང་བ་ལ་རྣམ་པར་བརྟག་པ་འཆད་པར་བྱེད་དོ།",
    "སྨད་པ་རྟོགས་པར་བྱེད་པ་ལ་དུས་ཐམས་ཅད་དུ་ཀ་ཐཾ་གྱི་སྦྱོར་བ་ནི་བྱིངས་ལས་ལིང་ཡང་ན་འགྱུར་ཏེ།",
    "ཡང་ན་ཞེས་པ་རྗེས་སུ་འཇུག་པས་དུས་ཇི་ལྟ་བ་བཞིན་མ་བྱས་པའི་རྐྱེན་རྣམས་འགྱུར་རོ།",
    "སྨད་པ་རྟོགས་པར་བྱེད་པ་ལ་ཨ་བི་དང་ཛཱ་ཏུ་དག་དང་ཀ་ཐམ་གྱི་སྒྲ་སྦྱོར་བ་ན་ལཊ་འགྱུར་ཏེ།",
    "ངོ་མཚར་བ་ལ་འཇུག་པ་ན་ཡ་དེ་བརྗོད་པར་བྱ་བ་ལ་ལིང་འགྱུར་ཏེ།",
    "དྲི་བ་དང་སྒྲིབ་པ་ལ་ཡང་རྟོགས་པར་བྱའོ།",
    "ནུས་པའི་དོན་གྱི་ཡུལ་ལ་སྲིད་པ་རྟོགས་པར་བྱེད་པ་ལ་ལིང་འགྱུར་ཏེ།",
    "སྔ་མས་རྟག་ཏུ་ཐོབ་པ་ལ་རྣམ་པར་བརྟག་པའི་དོན་དུ་བརྗོད་དོ།",
    "མི་ཐོབ་པ་ཐོབ་པར་བྱེད་པའི་ངེས་པར་སྦྱོར་བ་ནི་ཆོ་ག་སྟེ།",
    "བཀུར་སྟི་སྔོན་དུ་འགྲོ་བས་ལྷག་པར་འདོད་པའི་ཚུལ་དང་།",
    "དེ་ལ་བསྒོ་བ་ལ་སོགས་པ་ལ་ལོཊ་ཉིད་འཆད་པར་བྱེད་དོ།",
    "ཡང་དག་པར་རབ་ཏུ་འཛིན་པ་ཇི་ལྟ་བ་དེ་ལྟར་བྱ་བའི་ཚུལ་དང་།",
    "དེ་ཡང་སྤྲིང་བསྐུལ་ལ་སོགས་པ་རྟོགས་པར་བྱེད་པ་རྣམས་ལའོ།",
    "ལྷག་པར་ཚོལ་བ་ལའོ།",
    "ལྷག་པར་ཚོལ་བ་ལ་སྨའི་སྒྲ་སྦྱོར་བ་ན་ལོཊ་ཉིད་འགྱུར་ཏེ།",
    "བྱ་བའི་ཁྱད་པར་ལས་དུས་གཞན་དུ་གྱུར་པ་ལ་ཡང་རྣམ་པ་གཞན་དུ་མ་བྱས་སོ།",
    "དེ་བཞིན་དུ་བར་མ་དང་ཕྱི་མ་དག་ལ་ཡང་དཔེར་བརྗོད་པར་བྱའོ།",
    "བྱ་བའི་ཁྱད་པར་ཀུན་སྡུད་པ་ལ་ཡང་དེ་དང་མཚུངས་པའི་བྱ་བ་ཉིད་རྗེས་སུ་སྦྱར་ཏེ།",
    "ཀ་ལ་སོགས་རྣམས་རབ་ཏུ་སྦྱོར་བ་ན་བྱུག་འདོད་པ་རྟོགས་པར་བྱེད་པའི་འབྱུང་འགྱུར་ལ་ལཊ་ཡང་ན་འགྱུར་ཏེ།",
    "ལའི་གནས་སུ་དེ་མ་ཐག་ཏུ་འཆད་པར་འགྱུར་བའི་ཏིཔ་ལ་སོགས་པ་རྣམས་འགྱུར་རོ།",
    "གཅིག་དང་གཉིས་དང་མང་པོ་རྣམས་ལའོ་ཞེས་པ་སྤྱིར་བཏང་བ་རིག་པར་བྱའོ།",
    "དེ་ལ་བྱས་པའི་ལའི་གནས་སུ་ཏཱ་ལ་སོགས་པ་དགུ་སྔ་མ་བཞིན་དུ་འགྱུར་ཏེ།",
    "ཨཱང་སྔོན་མའི་ད་དཱ་ཏི་ལས་ཏ་ལ་སོགས་པར་འགྱུར་རོ།",
    "བྱེད་པ་པོར་བསམས་པར་འགྱུར་རོ།",
    "ཨཱང་སྔོན་མའི་ནོ་ཏི་དང་བྲཙྪ་ལ་ཏ་ལ་སོགས་པར་འགྱུར་ཏེ།",
    "ཀུན་དུ་འབོད་པར་བྱེད་ཅེས་པའི་དོན་ཏོ།",
    "སམ་སྔོན་མའི་ཀྲཱི་ཌ་ཏི་ལས་ཀཱུ་ཛ་ན་མིན་པ་ལ་འཇུག་པ་ན་ཏ་ལ་སོགས་པར་འགྱུར་ཏེ།",
    "སུཊ་ངེས་པར་བསྟན་པ་ཅི་ཞེ་ན།",
    "སྨོན་པ་ལ་ནཱ་ཐ་ལས་ཏ་ལ་སོགས་པར་གྱུར་ཏེ།",
    "ཀུན་དུ་ཡིད་ཆེས་པར་བྱེད་པའི་ཕྱིར་ཚིག་བརྗོད་པ་དང་།",
    "ཤ་པ་རྣམས་ལས་ཤེས་པར་འདོད་པ་ལ་ཞེས་པ་ཡང་དག་པར་རབ་ཏུ་སྦྱིན་པ་ལ་བཞི་པའོ།",
    "བསྒྲུབ་བྱ་ངེས་པར་བསྟན་པ་ནི་དམ་བཅའོ།",
    "རྩོདཔའི་ཚིག་ངེས་པར་མཚོན་པ་ནི་སྠེ་ཡ་སྟེ།",
    "འདུས་བྱས་ཐམས་ཅད་སྐད་ཅིག་མ།",
    "རྒོལ་བ་དང་ཕྱིར་རྒོལ་བ་གཉིས་ཀའི་འདོད་པ་རིག་པར་བྱེད་པ་ནི་ཏིཥྛ་ཏེའོ།",
    "ཨུད་ལས་སྟེང་མ་ཡིན་པར་སྤྱོད་པ་ལའོ།",
    "ཨུད་སྔོན་མའི་ཏིཥྛ་ཏི་ལས་སྟེང་མ་ཡིན་པར་སྤྱོད་པ་ལ་འཇུག་པ་ལ་ཏ་ལ་སོགས་པ་འགྱུར་ཏེ།",
