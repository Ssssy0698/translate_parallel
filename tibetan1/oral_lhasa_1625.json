    "གཞན་གྱི་འབྲས་མིན་ཁྱད་པར་ཅན།",
    "དེའི་ཕྱིར་རྟག་པ་ལ་འཇུག་པའི་ཤེས་པའི་དངོས་པོ་དུས་མཚུངས་པ་ཅན་དུས་ཐ་དད་པ་ཉིད་དུ་རྟག་པ་འཛིན་པར་མི་འགྱུར་ཏེ།",
    "གཞན་གྱིས་འཛིན་པ་དོན་མེད་པར་འགྱུར་རོ།",
    "གྲོགས་བྱེད་པ་གཞན་གྱིས་འབྲས་བུ་མ་ཡིན་པའི་ཁྱད་པར་ཏེ་གང་ལ་ཕུལ་དུ་མ་བྱུང་བ་ཡོད་པ་དེ་ནི།",
    "དེ་ལ་ལྟོས་པར་འགལ་བ་སྟེ།",
    "ཐ་མི་དད་པར་ཡང་མ་ཡིན་ཏེ།",
    "དེར་ཡིད་ལོག་པར་བསྟན་པ་ནི་མ་ཡིན་ཏེ།",
    "མངོན་སུམ་དུ་བྱེད་པ་དང་མངོན་སུམ་དུ་མི་བྱེད་པའི་རིག་པའི་མ་གཏོགས་པར་གཟུགས་རྟོགས་པ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "གཟུགས་མཐོང་བའི་དེ་མ་ཐག་པའི་ཡིད་སྒྲ་ལ་སོགས་པ་ཡོངས་སུ་གཅོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ངེས་པར་འཛིན་པར་འདོད་པ་ཡིན།",
    "སྐད་ཅིག་སྔ་མའི་རྗེས་ཐོགས་པའི་སྐད་ཅིག་གཉིས་པ་འཛིན་པ་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡིན་གྱི།",
    "འདི་ལ་རྩོད་པར་བྱེད་དེ།",
    "ལྷན་ཅིག་བྱེད་པར་ཇི་ལྟར་འགྱུར།",
    "ཡིད་སྐྱེད་པ་ལ་དོན་གཅིག་བྱེད་པར་འགྱུར་གྱི།",
    "ཇི་ལྟར་དུས་མཚུངས་པ་མེད་པར་བྱ་བ་བྱེད་པའི་དུས་ཅན་གྱི་དོན་ཡིན།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་དུས་མཚུངས་པ་ཅན་གྱི་དོན་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དོན་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལས་དུས་སྔ་མ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "དུས་མཚུངས་ན་ནི་སྔར་མེད་པར་འགྱུར་ལ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ནི་སྔར་མེད་པའི་དོན་ལས་སྐྱེ་བ་མ་ཡིན་ཏེ།",
    "རྒྱུ་ཐམས་ཅད་ནི་འབྲས་བུ་སྐྱེ་བ་ལས་སྔ་བར་ཡོད་པ་དེ་བས་ན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་དོན་ཏེ།",
    "ཤེས་ལ་རྣམ་པར་གཏོང་ནུས་པ།",
    "ཤེས་པས་སྣང་བ་བྱས་པ་མ་ཡིན་པ་མ་ཡིན་ནམ།",
    "འོ་ན་རྣམ་པར་རྟོག་པའི་རང་བཞིན་མངོན་སུམ་མ་ཡིན་པར་འགྱུར་བ་མ་ཡིན་ནམ་ཞེ་ན།",
    "འདི་ལ་རྩོད་པར་བྱེད་དེ།",
    "རྣམ་པར་རྟོག་པའི་ངོ་བོ་ཉིད་རྟོག་པ་མེད་པ་མ་ཡིན་པའི་ཕྱིར།",
    "དོན་གྱི་ངོ་བོ་ཉིད་ལ་རྟོག་པ་མ་གཏོགས་པར་རྟོག་པའི་ངོ་བོ་ཉིད་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "བརྡ་བྱེད་པར་ནི་ནུས་མེད་ཅན།",
    "བདེ་བ་ལ་སོགས་པའི་བདག་ཉིད་གང་ཞིག་ལ་བརྡ་བྱེད་པར་མི་ནུས་པ་ཡོད་པ་དེ་ནི་དེའི་བདག་ཉིད་ཡིན་ནོ།",
    "དེ་ལྟ་བུར་གྱུར་པའི་བདེ་བའི་བདག་ཉིད་དེ་ལ་བརྗོད་པ་དང་འབྲེལ་པར་འཇུག་པ་ག་ལ་ཡོད།",
    "བདེ་བ་ལ་སོགས་པ་སྔོན་གྱི་ངོ་བོའི་རྣམ་པ་ཅན་དུ་རིག་པར་བྱ་བའི་ཕྱིར།",
    "ཇི་ལྟར་འདྲེར་རུང་བར་ཤེས་པ་ཡིན་པ་བདེ་བ་དང་སྒྲའི་རྣམ་པ་དག་ནི་དུས་མཚུངས་པར་སྣང་བས་འདྲེར་རུང་བར་སྣང་བ་མ་ཡིན་ན།",
    "འོན་ཏེ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་རྟོག་པ་དང་བཅས་པར་ཤེས་པར་བྱ་བའོ་ཞེ་ན།",
    "འོ་ན་དེ་ལྟ་ན་དོན་ལ་ཡང་ཤེས་པ་རྟོག་པར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་རྟོག་པར་འགྱུར།",
    "འོན་ཏེ་ཤེས་པའི་རྣམ་པ་ལ་དོན་གྱི་རྣམ་པར་སྒྲོ་འདོགས་པས་རྟོག་པ་དང་བཅས་པ་ཉིད་དུ་བརྗོད་ན་ནི།",
    "དོན་དམ་པར་ནི་རིག་པ་ཐམས་ཅད་རྟོག་པ་མེད་པ་སྟེ།",
    "འོན་ཏེ་རིག་པར་བྱ་བ་ཡིན་པས་བདེ་བ་ལ་སོགས་པས་རང་རིག་པའོ་ཞེ་ན།",
    "བུམ་པ་ལ་སོགས་པ་ནི་དོན་གཅིག་ལ་འདུ་བའི་ཤེས་པས་ཤེས་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "དེ་བས་ན་དེ་དག་ཆོད་པར་སྣང་བའོ་ཞེས་བྱེ་བྲག་པ་ཁ་ཅིག་ཟེར་བ་འདི་ལ་ལན་བཏབ་པ།",
    "རྣམ་པར་ཤེས་པ་ལས་ཐ་དད་པར་བདེ་བ་ལ་སོགས་པ་འཛིན་པ་མ་ཡིན་པ་དེ་བས་ན་མངོན་སུམ་ནི་ཐ་དད་པར་བསྒྲུབ་པ་མ་ཡིན་ནོ།",
    "འོན་ཏེ་རྗེས་སུ་དཔག་པས་བདེ་བ་ལ་སོགས་པ་ཤེས་པ་ལས་ཐ་དད་པར་རྟོགས་སོ་ཞེ་ན།",
    "གལ་ཏེ་འདིར་བདེ་བ་ལ་སོགས་པ་རྒྱུ་ཐ་དད་པའི་རྟགས་བསྟན་པར་ནུས་ན་རྗེས་སུ་དཔག་པར་ནུས་ཏེ།",
    "ངེས་པར་འབྲས་བུ་ཐ་དད་པ་ནི་རྒྱུ་ཐ་དད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།"
  ]
}