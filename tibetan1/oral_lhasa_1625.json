    "དེའི་དེ་ཁོ་ན་ཉིད་ཤེས་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "དེའི་དེ་ཕྱིན་ཅི་ལོག་ཏུ་སྣང་བ་ལས་ཡང་དག་པ་མ་ཡིན་པར་ཤེས་པ་ཡིན་ཏེ།",
    "དེ་བས་ན་དེ་ཁོ་ན་ཉིད་དུ་གྱུར་པའི་དོན་སྟོང་པ་ཉིད་ཀྱི་མཚན་ཉིད་ཅན་ལ་ལྟོས་པར་མི་བྱེད་པའི་བཏང་སྙོམས་ཅན།",
    "དེ་བཞིན་གཤེགས་པ་གང་ཡིན་པ་དེ་དབེན་པར་མཐོང་བ་ཅན་གྱི་མགོན་པོས།",
    "ཕྱི་རོལ་གྱི་དོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཕུང་པོ་ལ་སོགས་པ་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་མ་ཡིན་གྱི།",
    "འོན་ཏེ་དེ་ཁོ་ན་ཉིད་མཐོང་བ་ཕྱི་རོལ་གྱི་དོན་ཇི་ལྟར་སྟོན་པར་འགྱུར་ཏེ།",
    "ད་ནི་སྣ་ཚོགས་བརྟེན་ནས་ཀྱི་ལན་གདབ་པར་བྱ་སྟེ།",
    "སྣ་ཚོགས་པའི་རྣམ་པར་སྣང་བ་ཡིན་ཡང་གཅིག་པ་ཉིད་དེ།",
    "ཐ་དད་པར་བསྟན་པར་མི་ནུས་པའི་ཕྱིར་སྙམ་བསམས་ནས་སྨྲས་པ།",
    "འབྱེད་པས་དོན་ལ་འཇུག་པར་འགྱུར།",
    "དེ་བས་ན་འབྱེད་པར་བྱ་བར་མི་ནུས་པའི་ཕྱིར་སྣ་ཚོགས་པར་སྣང་བ་ནི་གཅིག་པ་ཉིད་ཡིན་ནོ།",
    "ཉིན་པར་ཉི་མའི་འོད་དང་ལྷན་ཅིག་མཐོང་བ་ནི་གཅིག་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "འོ་ན་དེ་ཉིད་ཀྱི་ཤེས་པས་གཞག་པ་མ་ཡིན་ཏེ་མ་རྟོགས་པར་གྱུར་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་སྔོན་པོའི་རྣམ་པ་སྔར་སེར་པོའི་རྣམ་པ་དང་ལྷན་ཅིག་འཛིན་ལ་ད་ལྟ་ནི་ཡན་གར་བར་སྣང་བའི་ཕྱིར་འབྱེད་པར་བྱེད་པ་ཡོད་དོ་ཞེ་ན།",
    "དེ་ལྟར་ཤེས་པར་བྱ་བ་ལ་ཤེས་པའང་དེ་ལྟར་འགྱུར་བ་ཡིན་ཏེ།",
    "གཞན་དུ་སྔོན་པོའི་རྣམ་པ་གཅིག་པུ་དང་ལྡན་པར་སྣང་བར་འགྱུར་བའི་ཤེས་པ་དེ་དེ་བཞིན་དུ་རྣམ་པ་གཉིས་དང་ལྡན་པ་དང་།",
    "དེ་ལྟར་གཞན་དང་གཞན་ཡིན་པར་རྟོགས་པར་བྱའོ།",
    "འདིར་སྔ་ཕྱིའི་ཤེས་པ་དག་གཅིག་མ་ཡིན་པས་ཐ་དད་པར་རིག་པར་བྱ་སྟེ།",
    "འོན་ཏེ་སྔར་གྱི་ཉམས་སུ་མྱོང་བས་དྲན་པས་ཤེས་པར་བྱེད་དོ་ཞེ་ན།",
    "ཉམས་སུ་མྱོང་བས་བྱས་པའི་དྲན་པ་སྐྱེས་པས་མྱོང་བ་རྟོགས་པ་མ་ཡིན་ཏེ།",
    "སྔར་ཉམས་སུ་མྱོང་བ་མཐོང་བ་ནི་དྲན་པ་དོན་མེད་པར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་ཐ་དད་པར་སྣང་བ་ཅན་ཤེས་པ་ལ་གནས་པའི་སྣ་ཚོགས་པ་ནི་གཅིག་པ་ཉིད་དེ།",
    "ཐ་དད་པར་བྱ་བར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་ཕྱི་རོལ་ཡང་ཐ་དད་པར་བསྟན་པར་མི་ནུས་པས་གཅིག་ཏུ་འགྱུར་རོ་ཞེ་ན།",
    "རང་རིག་པ་ཉིད་གཅིག་པུ་གཉིས་སུ་མེད་པར་གནས་སོ།",
    "གཟུང་བ་དང་འཛིན་པའི་བྱེ་བྲག་ཇི་ལྟར་མེད་པར་འགྱུར་བ་དེ་ལྟར་འཆད་པར་འགྱུར་རོ།",
    "དེ་ཚེ་བྱེ་བྲག་མེད་པར་འགྱུར།",
    "དེའི་ཤེས་པ་ལ་གནས་པའི་སྣ་ཚོགས་སུ་སྣང་བ་བཞིན་ཐ་དད་པ་མེད་པར་འགྱུར་རོ།",
    "ཐ་དད་པར་མཐོང་བ་མེད་ན་ནི་སྣམ་བུ་ཁྲ་བོའི་གཟུགས་ཤེས་པའི་ངོ་བོ་ཉིད་ཁོ་ནར་འགྱུར་ཏེ།",
    "སྣམ་བུ་ཁྲ་བོའི་གཟུགས་ཐ་མི་དད་པར་འགྱུར་རོ།",
    "དེ་སྐད་དུ་ཡང་ཤེས་པ་བཞིན་ཡན་ལག་ཅན་ཐ་མི་དད་པའི་བདག་ཉིད་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "མ་མཐོང་བར་གྱུར་པ་ནི་ཡོད་པའོ་ཞེས་ཐ་དད་པར་མི་ནུས་ལ།",
    "ཡན་ལག་ཅན་མེད་ན་ཐ་མི་དད་པའི་ཡན་ལག་ཐམས་ཅད་པའི་ཡན་ལག་ཅན་ནོ་ཞེས་བརྗོད་པར་མི་ནུས་སོ།",
    "དེའི་ཕྱིར་ཕྱི་རོལ་ཁས་བླངས་ནས་ཅིག་ཅར་དུ་མ་མཐོང་བར་འདོད་པར་བྱའོ།",
    "གཟུང་བ་གཞན་ལ་འཇུག་པར་ནུས་པ་མ་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དོན་དམ་པར་རང་རིག་པ་ཙམ་ཡིན་གྱི།",
    "མཐོང་བས་བརྟེན་པར་བྱ་བར་རྡུལ་ཕྲ་རབ་ཇི་ལྟར་འགྱུར་ཏེ།",
    "རྒྱུ་ཡི་དངོས་པོ་མ་གཏོགས་པར།",
    "མཐོང་བའི་རྒྱུ་ཉིད་ལས་མ་གཏོགས་པར་གཟུང་བར་བྱ་བའི་དོན་གཞན་ཅི་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཤེས་པས་ཅིག་ཅར་དུ་མ་འཛིན་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "ལྐོག་ཤལ་སོགས་སྣང་མེད་པར་ནི།",
    "ནོག་དང་ལྐོག་ཤལ་ལ་སོགས་པའི་ཡན་ལག་རྣམས་མཐོང་བ་མེད་པར་ནི་བ་ལང་ངོ་སྙམ་པའི་ཤེས་པ་སྐྱེ་བ་མ་ཡིན་ནོ།",
    "ལྷན་ཅིག་རྟོགས་པར་འདོད་ན་ནི།",
    "འོན་ཏེ་ཡོན་ཏན་ཏེ་རྭ་ལ་སོགས་པའི་ཁྱད་པར་དང་།",
    "དེ་ལྟ་ན་འོ་ན་ནི་རྭ་ལ་སོགས་པ་ཁྱད་པར་ཉིད་ཀྱིས་གནས་པའི་ཡན་ལག་དེ་ཉིད་དང་ལྷན་ཅིག་བ་ལང་འཛིན་པའི་ཕྱིར།",
    "དཀར་པོ་ལ་སོགས་པའི་ཡོན་ཏན་དང་ལྡན་པའི་བ་ལང་ཡང་ཅིག་ཅར་འཛིན་པར་མི་འགྱུར་རོ།",
    "དཀར་པོ་ལ་སོགས་པའི་ཡོན་ཏན་གྱི་ཡན་ལག་ཐམས་ཅད་ནི་འབྲེལ་པའི་ཕྱིར་དེའི་ཁྱད་པར་ཅན་གྱི་བ་ལང་དང་ལྷན་ཅིག་ཉིད་ཅིག་ཅར་སྣང་བར་འགྱུར་རོ་ཞེ་ན།",
    "ཁྱད་པར་ཅན་དང་ཁྱད་པར་དག།",
    "དེ་ཉིད་ཀྱིས་དེ་འཛིན་པར་འགྱུར།",
    "ཁྱད་པར་ཅན་དང་ཁྱད་པར་ནི་དངོས་པོ་ལ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་དེ་ཉིད་ཁྱད་པར་ཅན་དུ་ཡང་ཤེས་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་དང་ཁྱད་པར་ཅན་དེ་དག་བརྗོད་པར་འདོད་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར།",
    "ཡན་ལག་ཉིད་དུ་གྱུར་པའི་ཁྱད་པར་གང་ཡིན་པ་ཁྱད་པར་ཉིད་དུ་བརྗོད་པར་འདོད་པས་གཟུང་བའི་རྫས་གང་ཡིན་པ་དེ་ཁྱད་པར་དེ་ཉིད་དང་ལྷན་ཅིག་འཛིན་པར་འགྱུར་གྱི།",
    "ཁྱད་པར་ཐམས་ཅད་ཅིག་ཅར་འཛིན་པ་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "བརྗོད་པར་འདོད་པ་རིམ་གྱིས་འཇུག་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་ཡོན་ཏན་དང་རིགས་ལ་སོགས་པ་ཐ་དད་པར་བྱེད་པ་ཡང་ཅིག་ཅར་འཛིན་པ་མེད་པའི་ཕྱིར་བ་ལང་དང་རྟ་ལ་སོགས་པའི་དངོས་པོ་གཞན་དང་གཞན་མཐོང་བའི་སྐྱེ་བོའི་བློ་རྣམ་པ་ཅིག་པ་ཅན་དུ་འགྱུར་རོ།",
    "ཕྱིས་ནི་ཡོན་ཏན་དང་རིགས་ལ་སོགས་པ་ཐ་དད་པ་འཛིན་པའི་ཕྱིར་བ་ལང་དང་དཀར་པོ་དང་འགྲོ་བ་ཞེས་བྱ་བ་རྫས་སྣ་ཚོགས་པར་གཏོགས་པར་འགྱུར་རོ་ཞེ་ན།",
    "དག་པར་མཐོང་བ་ལས་ཕྱིས་རིགས་དང་ཡོན་ཏན་དང་བྱ་བ་ཐ་དད་པས་གཞག་པའི་སྣ་ཚོགས་པ་རྟོགས་པ་ཡིན་ཡང་བླ་སྟེ།",
    "དེ་ལྟ་ན་ཡང་དང་པོ་དག་པར་སྣང་བས་གཅིག་པ་ཉིད་དུ་རྫས་མཐོང་བ་ན་ཕྱིས་གཟུགས་ལ་སོགས་པ་འཛིན་པའི་ཕྱིར་གཟུགས་ལ་སོགས་པ་དེ་དག་འབྲེལ་པ་ཅན་གྱི་རྫས་འཆོལ་བར་འགྱུར་ཏེ།",
    "འདི་ལྟར་གཅིག་པར་གཟུང་བའི་དངོས་པོ་ཕྱིས་ཡོན་ཏན་ལ་སོགས་པ་དུ་མ་ཉིད་དུ་སྦྱོར་བའི་ཕྱིར།",
    "ཁྱད་པར་དུ་མ་ཡང་གཅིག་ཏུ་འགྱུར་རོ།",
    "ཁྱད་པར་འཛིན་པའི་དུས་ན་རྫས་མི་འཛིན་པའི་ཕྱིར་དང་།",
    "དེ་ལྟར་ཡོན་ཏན་དང་ཡོན་ཏན་ཐ་དད་པར་སྨྲ་བ་ལ།",
    "ཅིག་ཅར་དུ་མ་འཛིན་པར་འགྱུར།",
    "ཞེས་བརྗོད་ནས་གྲངས་ཅན་གྱི་ལྟ་བ་ལ་ཡང་བརྗོད་པར་བྱ་བའི་ཕྱིར།",
    "ཅིག་ཅར་དུ་མ་འཛིན་པར་གྲུབ།",
    "དེ་ཙམ་རྣམས་ཀྱི་བཀོད་པའི་ཁྱད་པར་ཏེ།",
    "རྨོངས་པའི་བདག་ཉིད་ཅན་གྱི་ཁྱད་པར་ཡིན་ནོ།",
    "སྒྲ་ལ་སོགས་པ་འཛིན་པ་ན་བདེ་བ་ལ་སོགས་པ་དུ་མ་ཅིག་ཅར་འཛིན་པ་གྲུབ་པར་འགྱུར་བའམ།",
    "དེ་ཙམ་ལྔ་ཡང་བུམ་པ་ལ་སོགས་པར་སྣང་བ་ལ་གྲུབ་པ་ཡིན་ནོ།",
    "བདེ་བ་ལ་སོགས་པའི་མེད་པར་སྒྲ་ལ་སོགས་པའི་འབྲས་བུ་འཛིན་ན་གྲངས་ཅན་ལ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་སྒྲ་ལ་སོགས་པ་ཡོངས་སུ་གཅོད་པ་ན་གདོན་མི་ཟ་བར་བདེ་བ་དང་སྡུག་བསྔལ་དང་རྨོངས་པར་སྣང་བ་ཡིན་ནོ།",
