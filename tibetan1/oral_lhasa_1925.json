    "ཇི་ལྟར་བདག་དང་ཕ་རོལ་གྱི་དོན་དུ་སྦྱོར་བར་བྱེད་པ་ནི་འབྲས་བུ་མཚུངས་པར་འདོད་པ་ཡིད་ལ་བྱེད་པ་ཞེས་བྱ་སྟེ།",
    "དེས་ཀྱང་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཁམས་རྒྱས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འབྲས་བུ་མཚུངས་པར་འདོད་པ་ཇི་ལྟར་ཡིད་ལ་བྱེད་ཅེ་ན།",
    "དེ་བས་ན་འབྲས་བུ་མཚུངས་པར་འདོད་པའི་ཡིད་ལ་བྱེད་པར་འདོད་པ་ཞེས་བྱའོ།",
    "ཇི་ལྟར་ན་དེ་ཁོ་ནའི་དོན་རྟག་ཏུ་རྟོགས་པར་བྱ་ཞེ་ན།",
    "ཡིད་ལ་བྱེད་པ་དེས་ཀྱང་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཁམས་རྒྱས་པར་བྱེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་དུ་ཐམས་ཅད་རིམ་བཞིན་དུ་ཤེས་པར་བྱེད་དོ་ཞེས་བྱ་བ་ལ།",
    "དེ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་སྤྱོད་པའི་དུས་ན་བདག་ལ་མཐུ་རྣམ་པ་བཞི་ཡོད་པར་མཐོང་ནས་དགའ་བ་ནི་མཐུའི་དགའ་བ་ཡིད་ལ་བྱེད་པ་ཞེས་བྱ་སྟེ་མཐུ་རྣམ་པ་བཞི་ནི་འོག་ནས་འབྱུང་ངོ།",
    "དེ་བས་ན་ངེས་པར་མི་སྐྱོ་བ་ཡིད་ལ་བྱེད་པའི་རྗེས་ལ་མི་མཐུན་པ་དང་།",
    "མི་༡༤རྣམ་པ་བཞི་ཡོད་པར་མཐོང་ནས་དགའ་བ་ནི་མཐུའི་དགའ་བ་ཡིད་ལ་བྱེད་པ་ཞེས་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྦྱིན་པས་ནི་སེར་སྣ་སེལ་ིནུས་པར་མཐོང་།",
    "བཟོད་པས་ནི་ཁོང་ཁྲོ་བ་སེལ་ནུས་པར་མཐོང་།་",
    "བརྩོན་འགྲུས་ཀྱིས་ནི་ལེ་ལོ་སེལ་ནུས་པར་མཐོང་།",
    "བསམ་གཏན་གྱིས་ནི་སེམས་གཡེང་བ་སེལ་ནུས་པར་མཐོང་།",
    "ཤེས་རབ་ཀྱིས་ནི་རྟག་པ་དང་ཆད་པར་འཛིན་པ་ལ་སོགས་འཆལ་བའི་ཤེས་རབ་སེལ་ནུས་པར་མཐོང་སྟེ།",
    "བསམ་གཏན་དང་ཤེས་རབ་གཉིས་སྤྱད་པས་ནི་ཡེ་ཤེས་ཀྱི་ཚོགས་སོགས་པར་མཐོང་།",
    "བདག་དང་གཞན་ལ་ཕན་འདོགས་པར་མཐོང་སྟེ་ཇི་ལྟ་ཞེ་ན།",
    "མི་ཚངས་པར་སྤྱོད་པ་ལ་སོགས་པའི་རྒྱུ་ལས་བྱུང་བའི་བརྡེག་པ་དང་བཅིང་བ་ལ་སོགས་པ་མེད་པར་གྱུར་པས་བདག་ལ་ཕན་བཏགས་སོ།",
    "གཞན་གྱི་སྲོག་དང་ནོར་དང་ཆུང་མ་ལ་གནོད་པ་མ་བྱས་པས་གཞན་ལ་ཕན་བཏགས་སོ།",
    "གནོད་པ་བྱེད་པ་ལ་ལན་མ་བྱས་པས་གཞན་ལ་ཕན་བཏགས་སོ་། བརྩོན་འགྲུས་ལ་ཉན་པ་དང་།",
    "སེམས་ཙམ། མི་༡༤ལྷ་དང་མིའི་ལུས་ཐོབ་པར་འགྱུར།",
    "བཟོད་པས་ནི་འཁོར་གཡོག་ཕུན་སུམ་ཚོགས་པར་འགྱུར།",
    "བརྩོན་འགྲུས་ཀྱིས་ནི་ལས་ཀྱི་མཐའ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར།",
    "ཤེས་རབ་ཀྱིས་ནི་རིག་པའི་གནས་ཐམས་ཅད་ལ་མཁས་པར་འགྱུར་ཏེ།",
    "འདི་ནི་རྣམ་པར་སྨིན་པའི་འབྲས་བུའོ།",
    "ངེས་པར་མི་སྐྱོ་བ་ཡིད་ལ་བྱེད་པ་ནི།",
    "སེམས་ལ་སྐྱོ་བ་མེད་པ་ནི་ངེས་པར་མི་སྐྱོ་བ་ཡིད་ལ་བྱེད་པ་ཞེས་བྱའོ།",
    "ཅིའི་ཕྱིར་ངེས་པར་མི་སྐྱོ་བ་ཡིད་ལ་བྱེད་ཅེ་ན།",
    "ཉེས་པ་མེད་པར་ཡང་ཉེས་པར་བྱེད་ལི།",
    "གཉེན་པོ་སྦྱིན་པ་ནས་ཤེས་རབ་ཀྱི་བར་དག་སྒྲུབ་པར་ཡིད་ལ་བྱ་བ་རྣམ་པ་བཞི་ཡོད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྦྱིན་པ་ལ་སོགས་པ་མི་མཐུན་པ་སེར་སྣ་ལ་སོགས་པ་བཤགས་པ་དང་ཞེས་བྱ་བ་ལ།",
    "དེ་དག་བྱུང་ིན་ཡང་སོ་སོར་བཤགས་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡང་དག་པར་བླང་བ་ཡིད་ལ་བྱེད་པ་དང་།",
    "དེས་མཚོན་པར་བྱ་བའི་དངོས་པོ་ལ་ནི་དོན་ཞེས་བྱ་སྟེ།",
    "འདང་བ་དང་དང་བས་རྒྱུ་བྱས་ནས་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་འདི་དག་རྒྱུར་གྱུར་པ་སྤྱད་ན་ནི་དེའི་འབྲས་བུ་གདོན་མི་ཟ་བར་འཐོབ་པར་འགྱུར་རོ་ཞེས་ཡིད་ཆེས་པ་ནི་དང་བའི་ཡིད་ལ་བྱེད་པ་ཞེས་བྱའོ།",
    "དེ་དག་ཡང་དག་ིཔར་ལེན་པ་ཡིད་ལ་བྱེད་པའོ།",
    "བསྒྲུབས་པ་ལས་བརྩམས་ནས་གོ་ཆའི་ཡིད་ལ་བྱེད་པ་སྟེ་་སྦྱིན་པ་ལ་སོགས་པ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་གོ་ཆ་བགོས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་བསྒྲུབ་པའི་ཆེད་དུ་བྱས་ནས་དེ་དྲུག་བསྒྲུབ་པ་ནི་གོ་ཆ་ཡིད་ལ་བྱེད་པ་ཞེས་བྱ་སྟེ།",
    "ཡང་དག་པར་སྒྲུབ་པར་ཤོག་ཤིག་ཅེས་སྨོན་པར་དགའ་བའོ་ཞེས་བྱ་བ་ལ།",
    "གདམས་པ་དང་བསྟན་པ་ཐོབ་པའི་ཕྱིར་གོ་ཆ་གྱོན་པར་བྱེད་དོ།",
    "རོ་མྱོང་བར་བྱེད་པའི་སྒོ་ནས་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་རྫོགས་པར་བྱ་བ་ལ་སྦྱོར་ཞིང་ཡིད་ལ་རྟོག་པ་ནི་ཐབས་དང་ལྡན་པའི་ལས་ཡིད་ལ་བྱེད་པ་ཞེས་བྱའོ།་།",
    "དེ་ལ་གཞན་གྱི་ནོར་དང་སྲོག་དང་ཆུང་མ་ལ་གནོད་པ་མ་བྱས་ཏེ།",
    "སྲོག་གཅོད་པ་དང་མ་བྱིན་པར་ལེན་པ་ལ་སོགས་པ་བསྡམས་ཏེ།",
    "བཟོད་པ་ལ་ཡང་བཟོད་པ་ལ་གནས་པ་རྣམས་བརྡེག་པ་ལ་སླར་མི་བརྡེག་པ་ལ་སོགས་པ་མི་འཇིགས་པ་སྦྱིན་པར་བྱེད་པ་ནི་བཟོད་པའི་སྦྱིན་པ་ཞེས་བྱའོ།",
    "གཞན་གྱིས་གནོད་པ་བྱས་ཀྱང་ཞེ་མི་ིསྡང་བ་ནི་བཟོད་པའི་བཟོད་པའོ།",
    "དམིགས་པར་བྱ་བ་ལ་སེམས་རྩེ་གཅིག་པ་ནི་བསམ་གཏན་གྱི་བསམ་གཏན་ནོ།",
    "དོན་མཐུན་པ་དང་དོན་སྤྱོད་པར་སྤྱོད་པའི་མཚན་ཉིད་དུ་བཞག་སྟེ།",
    "སྦྱིན་པ་ལ་སོགས་པའི་སྟོབས་དང་བྱམས་པར་བྱེད་པ་དང་ཞེས་བྱ་བ་ལ།",
    "མ་བྱས་སྨད་དང་ངོ་ཚ་དང་།",
    "དེ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡེ་མ་བྱས་པ་དང་།",
    "རྫོགས་པར་མ་བྱས་པ་ནི་མ་བྱས་པ་ཞེས་བྱའོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ཕྱིན་ཅི་ལོག་ཏུ་བྱས་པ་ལ་ནི་སྨད་པ་བྱས་པ་ཞེས་བྱ་སྟེ།",
    "དེ་ལྟར་ཡེ་མ་བྱས་པ་དང་།",
    "རྫོགས་པར་མ་བྱས་པ་དང་།",
    "སྨད་པར་བྱས་ན་མཚར་བྱས་ཞེས་ངོ་ཚ་ཞིང་འགྱོད་པ་ནི་ངོ་ཚ་བ་ཡིད་ལ་བྱེད་པ་ཞེས་བྱའོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ཐམས་ཅད་ནས་ཐམས་ཅད་དུ་ཅུང་ཟད་ཀྱང་མ་བྱས་པའོ།",
    "ལོག་པར་སྤྱོད་པ་ཞེས་བྱ་བ་ལ།",
    "ཤན་པ་ལ་མཚོན་སྦྱིན་པར་བྱེད་པ་དང་།",
    "བརྐུས་ནས་སྦྱིན་པ་དང་གཡོ་དང་སྒྱུས་བྱིན་པ་ནི་ལོག་པར་སྦྱིན་པ་ཞེས་བྱའོ།",
    "དེ་ལྟར་མ་བྱས་པ་དང་།",
    "ཡོངས་སུ་རྫོགས་པར་མ་བྱས་པ་དང་།",
    "སྨད་པར་བྱས་པར་མཐོང་ནས་སེམས་ལ་གནོད་པ་ནི་ངོ་ཚ་བ་ཞེས་བྱའོ།",
    "དེ་ལྟར་ངོ་ཚ་ནས་མ་བྱས་པ་དང་།",
    "བྱས་པ་དེ་སྤངས་ཏེ།",
    "བྱེད་པ་དང་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ལ་འཇུག་པར་བྱེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྨད་པ་དང་ལོག་པར་བྱ་བ་ལས་ནི་ལྡོག་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡུན་མི་རིང་བར་འགྱོད་པར་བྱེད་དོ་ཞེས་བྱ་བ་ལ།",
    "གལ་ཏེ་འགྱོད་པ་ཞིག་བསྐྱེད་ན་ཡང་རྒྱུན་དུ་འགྱོད་པ་བསྐྱེད་པར་མི་བྱ་སྟེ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྨད་པ་བྱས་པ་ནི་མཚར་བྱས་སོ་སྙམ་ཐང་ཅིག་གཅིག་འགྱོད་པ་བསྐྱེད་ནས་འགྱོད་པ་སྤོང་ངོ།",
    "སྦྱིན་པ་ལ་སོགས་པ་ཡེ་མ་བྱས་པ་དང་།",
    "རྫོགས་པར་མ་བྱས་ནས་འགྱོད་པར་གྱུར་ན་འགྱོད་པ་དེ་བཟློག་སྟེ།",
    "སྦྱིན་པ་ལ་སོགས་པ་བྱས་པ་དང་།",
    "རྫོགས་པར་བྱ་བའི་ཕྱིར་གུས་པར་བྱ་བ་དང་།",
    "རྒྱུན་དུ་བསྒྲུབ་པ་ལ་འཇུག་པར་བྱའོ།",
    "ལོག་པར་བྱས་པ་ལ་ཕྱིས་ལོག་པ་ལ་འཇུག་པར་མི་བྱའོ་ཞེས་ལྡོག་པར་བྱ་སྟེ།",
    "དེ་ལྟར་ན་ཡང་ཐེ་ཚོམ་ཡང་ལྡོག་པར་འགྱུར་རོ།",
    "འཇིག་རྟེན་རིག་པར་བྱས་པ་ལས་བརྩམས་ནས་བརྗོད་པ་ཡིད་ལ་བྱེད་པ་སྟེ་ཞེས་བྱ་བ་ལ།",
    "སྟོན་སྐྱོབ་དེ་ཉིད་ཇི་ལྟར་སྣོད་དུ་གྱུར་པའི་ཕྱིར་འཇིག་རྟེན་ལ་བརྗོད་པར་འདུ་བྱེད་པའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།་",
    "གཉིས་པོ་དེ་ནི་རྟོག་པར་འགྱུར།",
    "དབུལ་པོ་ལ་སོགས་པར་གྱུར་པར་མཐོང་སྦྱིན་པ་ལ་སོགས་པ་གཉེན་པོའི་ཕྱོགས་ལ་ནི་ཡོན་ཏན་དུ་རྟོགས་ཏེ།",
    "ཕྱུག་པོ་ལ་སོགས་པར་འགྱུར་བར་མཐོང་བ་ནི་རྟོག་པ་ཡིད་ལ་བྱེད་པ་ཞེས་བྱའོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་རྫོགས་པར་བྱ་བའི་ཕྱིར།",
    "མི་རྟོག་པར་འདོད་པ་ཡིད་ལ་བྱེད་པ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པའི་ཕྱིར་ཐབས་མཁས་པ་ལ་འདོད་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའི་ཐབས་ཡིན་ནོ།"
