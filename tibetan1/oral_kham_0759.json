    "དེའི་མདུན་དུ་བེ་ཀངྐ་ཏའི་ཞུགས་བུས་ལ་ཁྲག་དང་བསྲེས་པའི་ཡུངས་ཀར་གྱིས་ལན་བརྒྱ་སྟོང་སྦྱིན་སྲེག་བགྱིས་ན་དེའི་འོག་ཏུ་གྲིབ་མ་གདའ་ཞིང་གྲུབ་པར་འགྱུར་རོ།",
    "དེ་ནས་མི་གདའ་བར་འགྱུར་རོ།",
    "མེ་ཏོག་དཀར་པོས་ཀྱང་སླར་བཏང་ན་དེ་ནས་མི་གདའ་བར་འགྱུར་རོ།",
    "དུ་བ་འཐུལ་ན་མི་གདའ་བར་འགྱུར།",
    "དུ་བ་འཐུལ་ན་ནི་མི་གདའ་བར་འགྱུར་རོ།",
    "སིདྡྷི་ལོ་ཙ་ནི།",
    "མར་གྱི་ངོ་ཞག་བརྒྱད་ལ་ལག་ན་རྡོ་རྗེའི་མདུན་དུ་ཀ་ར་བཱི་རའི་མེ་ཏོག་དུས་གསུམ་དུ་བརྒྱ་རྩ་བརྒྱད་ཞག་བདུན་གྱི་བར་དུ་སྦྱིན་སྲེག་བྱས་ན་ཁྲག་འཛག་པར་འགྱུར་རོ།",
    "དེའི་འོག་ལོགས་སུ་སྒྲུབ་པ་པོ་སྙིམ་པ་ཟེད་ཅིང་འདུག་པར་བྱའོ།",
    "མི་སྨྲ་བར་འདུག་ཅིང་དུས་གསུམ་དུ་ཁྲུས་བྱའོ།",
    "ས་ལ་དཀྱིལ་འཁོར་གྲུ་བཞིར་བརྐྱང་ནུལ་དུ་བྱུགས་ལ་ཀུ་ཤའི་སྟན་བཏིང་ལ་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ནས་གཙང་སྦྲ་དང་།",
    "ནུབ་ཕྱོགས་ཕྱོགས་པ་དེ་འདུག་བཞིན།",
    "ནུབ་ཕྱོགས་ཕྱོགས་པ་དེ་འདུག་བཞིན།",
    "བྱ་རོག་ས་ལ་འདུག་ནས་ནི།",
    "སྲེད་མེད་བུ་ཡང་ལྷོ་ཕྱོགས་འདུག།",
    "དྲན་པ་ཙམ་གྱིས་མྱུར་དུ་མདུན་ན་འདུག་པར་འགྱུར་རོ།",
    "ལྷགས་ནས་ཁྱབ་འཇུག་ནི་བཅོམ་ལྡན་འདས་ཀྱི་གློ་གཡོན་ཕྱོགས་སུ་འདུག་གོ།",
    "ལྷ་ཆེན་པོ་ནི་གཡས་ཕྱོགས་སུ་འདུག་གོ།",
    "སྨིན་དྲུག་མ་ནི་འཛེམ་བཞིན་དུ་རྒྱབ་ལོགས་སུ་འདུག་གོ།",
    "དཀའ་ཟློག་མ་ནི་མདུན་ཕྱོགས་སུ་འདུག་གོ།",
    "ཚོགས་རྣམས་ནི་གཡོན་ཕྱོགས་སུ་འདུག་གོ།",
    "སཏྱ་པཱ་ཙ་ནེ་ན་ས་ཏྱ།",
    "ཡི་དགས་དེས་འོ་ཐུག་འཐུངས་ནས་འཆི་བར་འགྱུར་ཏེ་དེའི་ལག་ན་ལྡོང་རོས་འདུག་པ་བླངས་ནས་དེ་ཐོགས་པས་ལག་ན་རྡོ་རྗེ་དང་མཐུ་སྟོབས་མཉམ་ཞིང་བསྐལ་པར་གནས་པར་འགྱུར་རོ།",
    "དེ་ནས་རིག་སྔགས་འཆང་བ་རྩྭ་ཀུ་ཤའི་སྟན་གྱི་སྟེང་དུ་འདུག་པའི་ལག་པ་གཡས་པས་མནན་ལ་འབར་བར་གྱུར་གྱི་བར་དུ་བཟླས་བརྗོད་བྱས་ན་འགྲུབ་པར་འགྱུར་ཏེ།",
    "གསང་ཆེན་དང་བཅས་པ་དེའི་ལག་ཏུ་འདུག་པར་འགྱུར་ཏེ།",
    "ཁྲོས་བཞིན་དུ་མཚན་གཅིག་འདུག་པའི་སྟེང་དུ་ལག་པས་མནན་ཏེ་བཟླས་བརྗོད་བྱས་ན་དེ་མ་ཐག་ཏུ་དགྲ་མེད་པར་འགྱུར་རོ།",
    "སྐྲ་གྱེན་དུ་འགྲེང་ལ་ས་ལ་ལྟ་ཞིང་འདུག་པ་བྲིས་ཏེ།",
    "བཞི་པ་ནི་ཆུས་བྱས་ལ་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ནས།",
    "ལག་ན་རྡོ་རྗེ་ལ་ལྟ་ཞིང་འདུག་པར་བྲིའོ།",
    "ལྷ་ཆེན་པོ་ནི་བཅོམ་ལྡན་འདས་ཀྱི་གློ་གཡོན་ཕྱོགས་སུ་འདུག་གོ།",
    "སྤྱན་ནི་གཡས་ཕྱོགས་སུ་འདུག་གོ།",
    "དྲུག་མ་དང་དཀའ་བཟློག་མ་ནི་རྒྱབ་ལོགས་སུ་འདུག་སྟེ།",
    "གདོང་དྲུག་པ་རྡོ་རྗེ་གསུམ་པ་འདུག་པར་ཡིད་ཀྱིས་བསམས་ལ།",
    "ཨོཾ་ལོ་ཙ་ནི་པྲ་བ་རི་བྷྲ་མ་རི་ནི་སུམྦྷ།",
    "དགྲ་བསད་པར་འདོད་ན་དགྲ་གང་ན་འདུག་པ་དེ་ལོགས་སུ་ཁ་བལྟས་ཏེ་ཞག་བདུན་གྱི་བར་དུ་དུས་གསུམ་དུ་ལན་བརྒྱད་བརྒྱ་བརྒྱད་བརྒྱ་བཟླས་བརྗོད་བྱས་ན་ཞག་བདུན་གྱི་ཉིན་པར་དགྲ་འཆི་བར་འགྱུར་རོ།",
    "དྲག་ཤུལ་ལ་ནི་རྐང་པས་རྐང་པ་མནན་ཏེ་འདུག་པར་བྱའོ།",
    "དེ་ནས་མེའི་དབུས་སྔོ་བྲ་ངེར་འདུག་པ་དང་།",
    "བདག་འདུག་པ་དང་བགེགས་ཐམས་ཅད་མི་འབྱུང་ཞིང་རིག་སྔགས་ཀྱང་འགྲུབ་པར་འགྱུར་རོ།",
    "རིག་སྔགས་འདི་ཞག་བདུན་གྱི་བར་དུ་དབེན་པར་འདུག་ལ་གཅེར་བུ་འམ་ཡང་ན་ཁྱེད་རིངས་སུ་བྱས་ཏེ།",
    "ལག་ན་རྡོ་རྗེ་ཡང་རིག་སྔགས་ཐམས་ཅད་ཀྱིས་བསྟོད་ཅིང་འདུག་པར་བྲིའོ།",
    "བསྲེག་པའི་རང་བཞིན་ཅན་གྱིས་ལག་ན་རྡོ་རྗེ་གཙོ་བོར་བྱས་ནས་དེ་བཞིན་གཤེགས་པ་ཤཱཀྱ་ཐུབ་པའི་སྤྱན་སྔར་འདུག་གོ།",
    "གཅིག་ལ་གཅིག་ངོས་སྦྱར་ནས་གཡོན་པའི་མཐེའུ་ཆུང་སྟེང་ན་འདུག་པའི་ཚིགས་ཀྱི་སྲུབས་བཞག་སྟེ།",
    "མཱ་མ་ཀཱིའི་ཕྱག་རྒྱའི་ཚོགས་བྲིས་པ་གང་ན་འདུག་པ་དེ་ན་ང་ཕོ་ཉ་མ་རྣམས་ཀྱི་ཚོགས་ཀྱིས་བསྐོར་བ་ཡང་གནས་སོ།",
    "ཀུ་ཤའི་སྟན་ལ་འདུག་སྟེ་རྡོ་ལེབ་ཤིན་དུ་བཀྲུས་པ་ལ་དབྱིག་དང་གསེར་བཀྲམ་ནས།",
    "རྒྱལ་བའི་སྟེགས་བུའི་སྟེང་དུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ཀྱི་ཆང་ཟུངས་དྲང་པོར་འདུག་པར་བྱའོ།",
    "རྡོ་རྗེ་རྟགས་ཀྱི་ནི་དེ་ཉིད་ལ་དབུས་ནས་འབྲས་བུ་འདུག་པ་ཡིན་ནོ།",
    "དེའི་གཡས་ལོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་དྲང་བོར་བྱས་ལ་པད་མའི་སྟེང་ན་འདུག་པར་བྲིའོ།",
    "སྡོང་བུ་དང་བཅས་པར་འདུག་པར་བྱས་ལ།",
    "དེའི་གཡོན་ལོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་པ་ཁ་གཉིས་པ་དབུས་དྲང་པོར་འདུག་པར་བྲིའོ།",
    "མཆེ་བའི་སྟེགས་ནི་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ཀྱི་ཆང་ཟུངས་དྲང་པོར་འདུག་པར་བྲིས་ལ།",
    "དེའི་གཡས་ལོགས་སུ་པད་མ་ཁ་མ་བྱེ་བ་ལ་མཆེ་བའི་ཕྱིར་དགུ་པོར་འདུག་པར་བྲིའོ།",
    "དེ་གཉིས་ཀྱི་བར་ན་རྡོ་རྗེ་གསུམ་ཁ་གཉིས་པ་དབུས་ནས་འབྲས་བུ་འདུག་པ་སྦྲུལ་གྱི་མཇུག་མའི་སྟེང་ན་འདུག་པར་བྱའོ།",
    "ཞགས་པའི་ནི་སྟེགས་བུའི་སྟེང་དུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ནས་འབྲས་ལྟར་འདུག་པར་བྱའོ།",
    "དེའི་གཡོན་ལོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ནས་འབྲས་བུ་འདུག་པར་བྱའོ།",
    "དབྱུག་པའི་སྟེགས་བུའི་སྟེང་དུ་དབྱུག་པ་སླ་གོར་ཞོ་ཤའི་ཤིང་ལྟར་འདུག་ཅིང་།",
    "དེའི་གཡས་ལོགས་སུ་རྡོ་རྗེ་རྩེ་གསུམ་ཁ་གཉིས་པ་དབུས་ནས་འབྲས་བུ་འདུག་པར་བྱའོ།",
    "དགེ་སློང་གཅིག་ཤོས་ནི་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་དུ་གཞུག་ཅིང་གཟུགས་བཟང་མ་བཟླས་བརྗོད་བྱེད་བཞིན་དུ་གཞུག་པར་བྱའོ།",
    "ང་གང་ན་འདུག་པ་དེ་ན་ཕྱག་རྒྱ་གནས་ལ།",
    "ཕྱག་རྒྱ་གང་ན་གནས་པ་དེ་ན་ང་འདུག་སྟེ།",
    "དེ་ལྟར་འདུག་བཞིན་དུ་བཀུག་པ་ནི་རྡོ་རྗེ་གདུ་བུའི་ཕྱག་རྒྱའོ།",
    "རྟག་ཏུ་འདུག་པར་བྱ་བ་ཡིན།",
    "བདག་ཉིད་གཡོན་ཕྱོགས་ངོས་ལ་འདུག།",
    "དངོས་གྲུབ་སྒོ་དྲུང་འདུག་པར་བྱ།",
    "འདུག་ནས་སྒྲ་ཆེན་གདོན་པར་བྱ།",
    "དེ་ཡི་སྟེང་དུ་འདུག་ནས་ནི།",
    "འདུག་ནས་ཀྱང་ནི་བཟླས་བརྗོད་བྱ།",
    "རྟག་ཏུ་ཀུ་ཤའི་མལ་སྟན་འདུག།",
    "དེ་ནས་ཀུ་ཤའི་སྟན་འདུག་ཅིང་།",
    "རྟག་ཏུ་ཤར་ཕྱོགས་ཁ་བལྟ་འདུག།",
    "དག་པས་ཤར་ཕྱོགས་བལྟས་ཏེ་འདུག།",
    "ཤིན་ཏུ་མཉམ་བཞག་དུས་གསུམ་དུ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་རྟག་ཏུ་ཞམ་འབྲིང་ན་འདུག་ཅིང་གཡོན་ཕྱོགས་ན་གནས་པ།",
    "ཤར་ཕྱོགས་བལྟ་ཞིང་འདུག་པར་བྱ།",
    "མཆོག་རྣམས་ཀྱི་ནི་མདུན་དུ་འདུག།",
    "ཤིན་དུ་མཉམ་བཞག་དུས་གསུམ་དུ།",
    "རྒྱན་སྣ་ཚོགས་ཀྱིས་བརྒྱན་པ་པད་མ་རྩ་བ་དམར་པོའི་སྟེང་ན་འདུག་སྟེ་ལག་པ་གཡོན་པ་ན་པད་མ་བསྒྲེང་སྟེ་འཛིན།",
    "ལག་པ་གཡས་པ་དབུགས་འབྱིན་པའི་ཚུལ་དུ་འདུག་པ་བྲི།",
    "ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་ནས།",
    "གཟུགས་ཀྱི་དྲུང་དུ་འདུག་ནས་ནི།",
    "དེ་བཞིན་གཟུགས་ཀྱི་དྲུང་འདུག་ཅིང་།",
    "པཱ་ཙ་ནི་ན་བཱ་ཙ་ནེ་ན་སཏྱེ་ན་བཛྲེ་ཎ།",
    "ཚུལ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་ལ་བཟླས་བརྗོད་བྱེད་ཅིང་མིང་བརྗོད་པར་བྱའོ།",
    "འདུག་པ་དང་ཉལ་བ་མེད་ལ།",
    "ང་དང་ཁ་ཚས་བྱས་པ་གཉིས་ཀ་འདུག་བཞིན་དུ་ཅིའི་ཕྱིར་འགགས་ཞེས་སྨྲ།",
    "ལྔ་ཕུང་བར་མ་ཡང་རང་སྐྱེ་བ་མ་ཡིན་ཏེ།",
    "རིགས་ཀྱི་བུ་དཔེར་ན་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་འདུག་པའི་གནས་ན།",
    "ནུབ་གཅིག་འདུག་པར་གནོང་ཞིག་དང་སད་ན་སྔར་འགྲོའོ།",
    "དེ་ལྟར་མི་འཇིགས་ཡང་དག་ན་ལྟ་ལེགས་ཀྱིས་འདུག་ལ་རག་གོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་བྱིན་གྱི་རླབས་ཀྱིས་སྒོ་ཡང་རང་བྱེ་བར་གྱུར་ཏོ།",
    "ཀླུང་པ་ལ་ཞེས་བྱ་བའི་འགྲམ་དུ་འདུག་གོ།",
    "སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་མི་འདུག་པ་དང་ལྷ་སྐྲ་དེ་དམིགས་པས་མདྲན་རྭ་ཕྱང་ནས་དེ་ལ་བསྟོད་སྨད་བྱས་པས་དགའ་སྡུག་སོགས་འདུག་གམ་མི་འདུག་བལྟ།",
    "དེས་ཀྱང་མ་བྱུང་བ་གཉིད་ལོག་དུས་སུ་རྦ་རླབས་གཉིས་ཅུང་ཟད་མནན།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུྃ་ཕཊ།",
    "རྒྱ་རྐྱེན་ཚོགས་པ་ལས་སྣང་ཡང་རང་བཞིན་མ་གྲུབ་པ་ནམ་མཁའི་འཇའ་ཚོན་ལྟ་བུ།",
    "སྤྲིན་ལ་སོགས་པ་སྣ་ཚོགས་པའི་སྣང་བ་ལྟར་འདུག་ཀྱང་།",
    "གོས་གསར་པ་བྱོན་ལ་ཤར་དུ་ཕྱོགས་པས་འདུག་སྟེ།",
    "སྒྲོལ་མ་ལ་དོན་གྲུབ་སྟེ་རྒྱས་འདེབས་ཀྱི་ལྷ་རྣམས་ཀྱང་རང་འདྲའི་ཡུམ་ལ་འཁྱུད་པ་ཡེ་ཤེས་པ་དང་གཉིས་སུ་མེད་པར་གྱུར་པར་དམིགས།",
    "ཚོགས་ཞིང་རང་ལ་ཐིམ་པར་གྱུར།",
    "སླར་ཡང་རང་ཉིད་དགྱེས་པ་རྡོ་རྗེ་ཞལ་གཅིག་ཕྱག་གཉིས་བའི་རྣམ་པར་གྱུར།",
    "དང་པོའི་ཕྱག་གཉིས་རང་རང་རྟགས་མཚན་ལྡན།",
    "ཐིག་རྫོགས་པར་གདའ་མི་དུས་ན་ཐེག་ཆེན་བརྒྱད་དང་རྩ་ཐིག་ཟླུམ་ཐིག་རྣམས་གདབ་པའི་ཚུལ་བྱའོ།",
    "ཀརྨ་ཎི་ཨྰཏྠཱ་ནཾ་ནིརཏ་ཡཱ་དཀྱིལ་མརྦ་ཏ་ཐྰ་ག་ཏ་བཛྲས་ཏཱ་བེ་རོ་ཙ་ན་བཛྲ་རཏྣ་བཛྲ་དྷརྨ་བཛྲ་ཀརྨ་ཨ་ངྷིཥྛ་ཨ་བྷིཥིཉྩ་པྲ་ཝནྟ་ཡ་ཀརྨ་ཀུ་རུ་ཧཱུཾ།",
    "ཨོཾ་རུ་རུ་སྦ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "དེ་ལ་འདུག་ན་བདག་ཅག་ཡིད་རབ་དང་།",
    "སླར་ཡང་རང་ཉིད་སྒྱུ་མ་ལྟ་བུ་ཧེ་རུ་ཀ་དགྱེས་པ་རྡོ་རྗེ་མཐིང་ནག།",
    "རྣམ་སྣང་རང་བཞིན་རིན་ཆེན་གཞལ་མེད་ཁང་།",
    "ལོ་ཙ་ན་ད་ཤ་ཡེ།",
    "མེ་ཏོག་དབུལ་ཞིང་བསྐང་ཆ་སོགས་དཀྱིལ་ཆོག་སྤྱི་འགྲོ་ལྟར་བྱེད་པ་བོད་ལ་ལར་འདུག་ཀྱང་།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལེ་ཙ་ན་ཨཎྜ་ཨནྟ་སྭ་དྷ་ནི་སྭཱ་ཧཱ།",
    "སྙན་པའི་གསུང་དབྱངས་དབྱངས་ཀྱིས་གྲངས་མེད་འགྲོ་བ་དེ་དག་ཐེ་ཚོམ་རང་རང་སྒྲ་སྐད་སྐད་དུ་དུས་གཅིག་གཅོད།",
    "གཅིག་པུར་འདུག་ཚེ་གྲོགས་ཀྱི་མཆོག།",
    "འདི་ཡང་རང་བཟོ་མ་ཡིན་པར་རྒྱུད་ཉི་ཟླ་ཁ་སྦྱོར་དང་།",
    "དེང་སང་རང་ལ་ཕན་པ་ཨེ་འདུག་སོམས།",
    "དེང་སང་དེ་ཡིས་ཕན་པ་ཨེ་འདུག་སོམས།",
