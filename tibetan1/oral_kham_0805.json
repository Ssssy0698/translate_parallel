    "ཉང་ཆུ་ཞེས་འབྲི་སྲོལ་ཀྱང་འདུག་ཡར་ལྷ་ཤམ་པོ་ནི་སྲིད་པའི་ལྷ་དགུའི་གྲས་ཀྱི་གཅིག་ཡིན།",
    "གཞའ་པྱི་ན་ཕྲན་དང་ང་རང་ཞེས་པའི་དོན།",
    "གླང་ནི་མཚང་མིང་དུ་འདུག་པ་གསལ།",
    "གཞན་ཡང་ཡུལ་གྲུ་དུ་མར་བྱུང་འདུག་པ་རྣམས་དང་ཆ་མཐུན་པ།",
    "འབྲས་སྤུངས་གླིང་བསྲེ་བྱས་པར་ཁྱད་མེད་ཅིག་དགོས་རྒྱུར་འདུག་ཀྱང་།",
    "ཁས་བླངས་ཐོག་ཏུ་ཁེལ་བ་མི་གདའ་འོ།",
    "ཁྱད་ཨེ་འདུག་ཀུན་སློང་སེམས་ལ་དྲིས།",
    "འདུག་སྟངས།",
    "ཞེས་པའི་ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ནས་ཁ་ཆེ་ཟླ་མངོན་ལ་གསན་ནས་བསྒྱུར་ཏེ་མངའ་བདག་རྒྱལ་པོར་ཕུལ་བ།",
    "ཞེས་པའི་དོགས་གནས་ཀྱང་རང་སར་གྲོལ་ལམ་སྙམ་ཞིང་མིན་ན་ཐུགས་ཞེན་མཛད་ཡུལ་གྱི་བཀའ་བརྒྱུད་པའི་མགོ་ལ་ཆུ་དྲངས་ཀྱི་དོགས་སོ།",
    "མ་དད་པའི་ཁྱིམ་པ་སུན་འབྱིན་གྱི་རྒྱུར་འགྲོ་བ་འདུག་བསམས།",
    "མ་བསྒྲིགས་སྣེ་གཞན་གཅོད་པའི་སྲོལ་ཡོད་འདུག་པར་ད་ཆ་རུང་ཁང་དུ་ཇ་ཁྲ་འདངས་པ་ཡོད་པས་དེ་རིགས་དཀྲིག་ཆག་མི་དགོས།",
    "བར་སྐབས་སུ་སྣ་ཚོགས་ཤིག་བྱུང་ཡོད་འདུག་པས་ད་ནས་བཟུང་ཁམས་སོག་དང་གཞིས་དགོན་ཡོད་པའི་རིགས་ཀྱིས་གཞི་བ་བྱས་མི་ཆོག་དབུ་ཕར་གྱི་བསླབ་གཉེར་ཆགས་ངེས་པར་མ་གཏོགས་མིང་བཏགས་ཀྱི་རིགས་མི་སྟེར།",
    "རང་རང་སྤངས་རྟོགས་དབྱཪ་སྐྱེས་མྱུ་གུའི་དཔྱིད།",
    "གོང་གསལ་ལོ་རྟ་རྟ་ལོ་ཚུན་ལ་སྒེར་ཤག་གསར་རྒྱག་བྱས་རིགས་རྣམས་ཀྱང་ཕུགས་གྲྭ་ཚང་རང་དུ་འཇགས་པ་བྱེད་པ་མ་གཏོགས་ཚོང་སྒྱུར་གྱི་རིགས་མི་བྱེད།",
    "ཁས་བླངས་ཐོག་ཏུ་འཕེལ་བ་མི་གདའ་འོ།",
    "ཇ་རོ་ཐབ་གཡོག་པས་ཁྱེར་ན་ཇ་མི་ཐོན་པའི་རྐྱེན་ཡོང་བ་འདུག་པས།",
    "ཚོགས་ཀྱི་སྐབས་ཀ་བ་དང་ཞལ་བ་ལ་སྙེ་བ་སོགས་འདུག་ལུགས།",
    "སྐབས་སུ་མ་བབས་པར་ཟུར་དུ་འདུག་པ་དང་།",
    "ཁྱད་པར་སྔགས་ནུས་ཉམས་པའི་སྒོག་བཙོང་སོགས་དྲི་ངན་པའི་ཟས་ཀྱི་རིགས་ལོངས་མི་སྤྱོད་ཅིང་ཐ་མི་ཁ་འདི་མྱོང་འགྱུར་དྲི་ངན་གྱི་རིགས་སུ་འདུག་པས་སུ་ཐད་ནས་འཐེན་མི་ཆོག་རྒྱུན་དུ་ཤག་སོ་སོར་མི་ཡན་གྱི་རིགས་ཞག་སྡོད་སོགས་བསྟེན་སྒོར་བྱེད་ས་མེད།",
    "མགོན་དེའི་གདམས་པའི་བཅུད་ཀྱིས་ཚིམ་པར་མཛད་པའི་མཁས་གྲུབ་ཆེན་པོ་གུང་རུ་བ་རྒྱལ་མཚན་བཟང་ལ་སོགས་པའི་དམ་པ་དུ་མས་མཉེས་བཞིན་དུ་རྗེས་སུ་བཟུང་བའི་ལུང་དང་རྟོགས་པའི་ཡོན་ཏན་རྒྱ་མཚོའི་མངའ་བདག་དུས་གསུམ་གྱི་བྱུང་བ་དང་།",
    "གཞན་དུ་ཞུགས་ནས་བློས་མ་བཏང་བ་སོགས་མ་ཡིན་པར་ཀུན་སློང་རྣམ་པར་དག་པ་འདུག་ན་འཇུག་ཅིང་།",
    "སྒོག་ཙོང་འཛུགས་པ་སོགས་བྱས་མི་ཆོག་མེ་ཏོག་འཛུགས་རྒྱུ་ཡང་ཐུགས་དམ་བཤའ་མ་བྱེད་མིར་གཡེང་བའི་རྒྱུར་འདུག་པས་མི་བྱེད།",
    "ཡང་ན་རང་རང་ནས་བསྙུང་གནས་གཏོང་ཞིང་།",
    "སྔོན་བཅོམ་ལྡན་འདས་ཞལ་བཞུགས་དུས་ཀྱི་སྐྱེ་བོ་རྣམས་རང་བཞིན་དྲང་བས་བར་ཆད་དྲིས་ན་ལན་དྲང་པོར་འདེབས་པ་ཡིན་འདུག་ཀྱང་།",
    "རྡོར་དྲིལ་སོགས་ལྷའི་ངོ་བོར་བསྐྱེད་པས་རྟེན་གསུམ་དང་ཁྱད་མེད་པས་གུས་པར་བྱས་ནས་མདུན་དུ་དྲིལ་གདན་གྱི་ཐེབས་སུ་བཞག་ནས་ཡར་ལང་མར་འདུག་སྐབས་སོགས་སུ་ཡང་འགོམ་ཡུག་དང་།",
    "དེ་མཚུངས་རྗེས་སུ་གསར་འཛུགས་རིགས་བྱུང་ན་ཡང་སྔོན་ཡོད་རྣམས་མ་ཉམས་པ་ཞིག་བྱེད་ཅིང་གསར་འཛུགས་དགོས་གལ་ཆེ་ངེས་ལས་ཧ་ཅང་རྣམ་གྲངས་མང་བ་མང་པོ་བཙུགས་པ་རྣམས་སྔོན་ཡོད་རིམ་པས་ཉམས་པའི་རྒྱུར་འདུག་པས་གང་ཅི་ཚོད་ཟིན་པ་བྱེད།",
    "སྐད་བཟང་པ་ཞུ་མི་བྱུང་ཚེ་རྟགས་ཆ་ལུགས་སོགས་བྱིངས་སྤྱི་འགྲེ་ལྟར་ལ་སྐད་སོགས་བབས་སུ་འབྲེལ་མིན་ལས་སྣེ་རྣམས་ནས་བརྟག་ཞིབ་ནན་ཏན་གྱི་འོས་ངེས་འདུག་ཚེ་དམིགས་བསལ་འཇུག་སྒོའི་སྐོར་སོགས་ཟུར་གསལ་ལྟར་བྱེད།",
    "ལས་སྣེ་གྲ་བགྲེས་སོགས་ནས་ཀྱང་རང་ཉིད་བཟང་པོའི་ཚུལ་ལས་མི་འདའ་བའི་ཐོག་གཞན་དག་ཀྱང་ལྷག་བསམ་རྣམ་པར་དག་པས་ཀུན་ནས་བསླངས་ཏེ།",
    "གཞི་གསུམ་གྱི་ཕྱག་ལེན་འདི་ཙམ་ལ་ཐུག་འདུག་པས།",
    "སྦྱིན་བདག་སོ་སོས་རང་རང་ལ་འཕངས་པའི་གོ་རིམ་ལྟར་འཛིན།",
    "ཨ་ར་པ་ཙ་ན།",
    "ཀྱི་སྦྱིན་པའི་སྒོ་ནས་སྐྱེ་རྒུ་མཐའ་དག་དུས་མིན་གྱི་འཆི་བའི་གཡུལ་ལས་རྒྱལ་ཞིང་།",
    "ཀོ་ལྤགས་ལས་བྱས་པའི་སྟན་ལ་འདུག་ནས་ཟས་ལ་ལོངས་སྤྱོད་པ་དང་།",
    "རང་དོན་དང་གཞན་དོན་བསྙད་ཕྱོགས་སུ་འགྲོ་མི་འགའ་ཞིག་ལ་དཀོར་སྐལ་སྤྲོད་པ་སོགས་ཉམས་ཆག་ཕྲན་བུ་ཡོད་ཚོད་འདུག་པ།",
    "ཞེས་པ་ལྟར་ན་བླ་ན་མེད་པའི་རྙེད་པའི་མཆོག་རྙེད་པར་འདུག་རུང་།",
    "བདག་དང་བདག་འདྲའི་གང་ཟག་ལ་ཁེ་བས་ཉེན་ཆེ་བར་གདའ།",
    "དཀྱིལ་ཁང་པར་སྔར་ལམ་དུ་ལོ་ཁོངས་སྤྱི་བསྐྱུར་ཞུ་མཁན་ཇི་ཡོད་ལ་རྒྱུགས་བསྡུར་གྱིས་ཐོན་སུ་བཟང་ལ་སྤྲོད་པ་ཞིག་ཡོད་འདུག་ཀྱང་དེ་ལྟར་བྱས་ཚེ།",
    "གཙོ་ཆེར་གྲྭ་ཚང་འདི་བཞིན་རྒྱུད་གྲྭ་ཞེས་པའི་མཚན་དོན་དང་མཐུན་པ་ཞིག་དགོས་རྒྱུཪ་འདུག་ཀྱང་དེང་སྐབས་རྒྱུད་ཀྱི་འཆད་ཉན་ལྟར་སྟར་མ་ཆད་ཙམ་ལས་མི་འདུག་པ་ཕྱིན་ཆད་འདི་མུར་ལུས་ན་གསང་སྔགས་ཀྱི་བསྟན་པ་ཉམས་པས་པའི་རྒྱུར་འདུག་པས་ད་ནས་བཟུང་འཆར་ཅན་རྡུལ་ཚོན་གྱི་དཀྱིལ་འཁོར་སྒྲུབ་མཆོད་ཡོད་སྐབས་དང་དགུ་གཏོར་སོགས་འཆར་འཕར་གཏོར་རྒྱག་སྐབས་འཆར་ཅན་དང་དམིགས་བསལ་གྱི་སྦྱིན་སྲེག་ཡོད་དུས་དང་།",
    "དགུ་བཅུ་ཇི་ལྟར་ཡོད་ཀྱང་རྩེ་དྲུང་རྣམས་ནང་མའི་ཟླ་ཁོངས་ནས་མི་ལྕོགས་པ་མི་འདུག་གཤིས་སྒེར་དུ་དགོངས་ཆེན་འཕར་གཏོང་མི་བྱེད་ཅིང་།",
    "ངོས་ཕྱོགས་འགྲོའི་རྟ་གྲལ་སྐབས་དང་སོ་སོ་རང་རང་ཕྱོགས་ཐོན་སྐབས་ཀྱང་སྐོར་ལམ་གྱི་རྟ་བཞོན་པར་མ་སླེབས་བར་གྱོན་མི་ཆོག་ཅིང་།",
    "དེ་ནས་གྱོན་ཏེ་འགྲོ་རྒྱུ་དང་ཚུར་ལམ་ཡང་སྐོར་ལམ་དུ་རྟ་བབས་པ་དང་ཆབས་ཅིག་ཕུད་དེ་དེའི་ནང་ཚུན་གྱོན་མི་ཆོག་ད་ཕན་གླིང་སྲུང་པ་དང་དགུ་གཏོར་སོགས་ཀྱི་ཡར་གསོལ་བ་རྣམས་ནས་སྟོད་གོས་གྱོན་ལམ་འདུག་པ་འདི་ཡང་ཕྱིན་ཆད་མི་བྱེད།",
    "འགའ་ཞིག་གཟུགས་གཅོང་ལ་སྙད་པའི་དགོངས་ཞུ་བྱེད་པ་སོགས་ཡོད་འདུག་པ་འདི་དག་བལྟས་ངན་ལ་རང་གསང་མེད་པར་བྱུར་ལ་ངོ་སོ་ཡིན་པས་ཆེ་འབྲིང་གསུམ་སུས་ཀྱང་ཆང་ལ་དགོངས་པ་ཞུ་སྟེར།",
    "གྲྭ་ཚོགས་ཆེ་བའི་བར་ཆད་དུ་འདུག་པས་མི་བྱེད།",
    "དེར་མ་ཟད་སློབ་དཔོན་གསར་པ་ཁྲི་འདོན་སྐབས་དང་བསྟན་འབར་མ་རྣམས་ལ་ཕེབས་རྒྱུན་འདུག་པ་འདིས་ཀྱང་རིག་པས་འགྲུབ་ཅིང་།",
    "དུའང་ཟུར་བཞི་སྐུ་རིམ་ལ་ཕེབས་ནས་བསྔོ་ཡིག་ཡོད་སྐབས་གསུང་བསྔོ་གནང་བའང་གསལ་བར་དྲན་པ་བཅས་ཕེབས་ལམ་ཡོད་ངེས་ཡིན་འདུག་པས།",
    "འགའ་ཞིག་གྲྭ་སར་སྡོད་མ་འདོད་པས་ཆེད་དུ་སྡོད་པ་སོགས་གྲྭ་ཚོགས་ལ་གནོད་འགལ་ཆེ་བར་འདུག་པས།",
    "དགག་བྱ་ཆེ་བར་འདུག་པས་ཕྱིན་ཆད་བླ་བྲང་སྤྱི་ས།",
    "སྔོན་དུས་སློབ་དཔོན་ཟུར་པ་རྣམས་ལ་སྐལ་འཕར་ཡོད་པ་བར་སྐབས་ཆག་འདུག་ཀྱང་།",
    "ཕོགས་འགྱེད་དགོངས་པའི་སྐོར་བར་སྐབས་བྱེར་གཞིག་ཅི་ཆེ་བྱུང་འདུག་པས་ཕྱིན་ཆད་རྒྱལ་རྩེ་དང་།",
    "སྒྲིག་རྒྱུགས་ཆོག་པ་སོགས་ཞུ་དགོས་པ་སུས་བཙུགས་མེད་པའི་སྲོལ་ཞིག་དར་འདུག་པ་སྟེ་ཕར་འགྲོ་ཁར་དགོངས་པ་ཞུ་རྒྱུ་དང་།",
    "ཚུར་སླེབས་ནས་སྒྲིག་རྒྱུགས་ཆོག་པའི་གནང་བ་ཞུ་རྒྱུ་བཅས་སྒྲིག་ལམ་ལ་ཕན་པའི་ལེགས་ཆ་ཡིན་འདུག་ཀྱང་།",
    "སྔོན་དུས་ཐོས་བསམ་གླིང་པ་དང་དཀྱིལ་ཁང་པ་གཉིས་འགྱེད་ཀྱི་མཛད་སྒོ་ཕྱོགས་མཚུངས་ཡིན་འདུག་ཀྱང་དེང་སྐབས་དཀྱིལ་ཁང་པ་སྔ་སར་གནས་ཡོད་ཚོད་མི་འདུག་རུང་།",
    "ཐོས་བསམ་གླིང་པ་ད་ལྟའང་སྔར་གནས་ཡིན་འདུག་པས་ཕྱིན་ཆད་ཀྱང་ཇི་སྲིད་བར་ད་ལྟ་ལྟར་བྱེད་པ་ལས་གྲ་ཚང་གཞན་ལུགས་ལ་ངན་འགྲན་མི་བྱེད།",
    "རྟེན་མེད་པའི་སྐྱ་བོ་སོགས་ཁུངས་ལུང་མེད་པའི་མི་རིགས་གཡོག་ཏུ་སྒོར་བསྐྱིལ་བྱེད་རྒྱུ་འདི་རང་གཞན་ཐམས་ཅད་ལ་རྐུན་ཤོར་གྱི་རྒྱུར་འདུག་པས་འདི་ཡང་གཏན་ནས་མི་བྱེད།",
    "ལས་བྱེད་རྣམས་ནས་ཀྱང་རང་ཉིད་ལ་ལྟོས་པ་རྣམས་སྐྱོབ་དགོས་པར་བརྟེན།",
    "མཐར་ཡང་རང་བཞིན་མེད་པའི་གསུང་ཐོབ་པར་འགྱུར།",
    "རྒྱ་ཆེ་ཞིང་རང་མཚན་ཐ་དད་དུ་གནས་པས་ན་ཁམས་ཞེས་བྱའོ།",
    "དཀར་པོ་རང་འོད་དང་རང་ཟེར་ལས་བརྡོལ་བ་ལས་ཡོད་ཁམས་སྲིད་པའི་རྒྱལ་པོ་ཞེས་བྱ་བ་གསལ་ཞིང་སྲིད་དོ།",
    "གཅིག་ཆད་པར་འདུག་པས་བདུད་རབས་ལ་སོགས་ཀྱིས་ཁ་བསྐང་ངོ།",
    "ཞིག་ནས་འདུག་པ་དེ་བཞིན་འབྱུང་།",
    "འདྲེ་དང་མི་ཡང་རང་བཞིན་བསྐལ།",
    "ཇི་སྐད་དུ་ངང་དང་རང་བཞིན་བདག་ཉིད་ཆེན་པོ་གསུམ།",
    "གངས་རི་མཆོད་རྟེན་གྱི་ཚུལ་དུ་འདུག་པ་ཏི་སེ་ཡོད་དོ།",
    "ཉི་ཟླ་གཟའ་སྐར་གྱི་རྒྱུ་དང་རང་བཞིན་གང་ཞེ་ན།",
    "མཚན་ཉིད་ནི་ཤེས་པས་མ་ཟིན་པ་དང་རང་ལ་བརྟེན་པའི་གནས་སུ་རུང་བ་གཞི་མཐུན་པའོ།",
    "དེ་བཞིན་དུ་གོང་མ་ལྔ་ལ་ཡང་རང་ལོ་དྲུག་བདུན་བརྒྱད་དགུ་བཅུ་ལའོ།",
    "ཕྱི་མཐར་ཐུག་པར་འདུག་པ་ཡིན།",
    "སྣོད་བཅུད་ཐམས་ཅད་ཕྲ་རབ་རྡུལ་དུ་འདུག་པ་མཐོང་།",
    "མ་བཅིང་རང་གྲོལ་རྒྱ་མ་ཆད།",
    "ཕྱི་མཚན་ཉིད་ཀྱི་སྐད་དུ་ངང་དང་རང་བཞིན་བདག་ཉིད་ཆེན་པོ་དང་།",
    "དེས་ན་ཡོན་ཏན་གྱི་ལྡོག་པའི་སྒོ་ནས་དང་བསྐྱེད་བྱ་སྐྱེད་བྱེད་དང་རང་དང་གྲོགས་ལ་སོགས་ཀྱི་སྒོ་ནས་ཕན་ཚུན་གཙོ་འཁོར་ལ་སོགས་སུ་རྣམ་པར་བཞག་གོ།",
    "ཞེས་པ་སྲིད་པའི་མཛོད་ཕུགས་ཀྱི་གཞུང་ལས་དུག་ལྔའི་རྒྱུ་དང་རང་བཞིན་དང་བྱེད་ལས་ལ་སོགས་ཕྲ་རྒྱས་སུ་བསྟན་པའོ།",
    "དེ་བཞིན་ཉིད་ལ་ངོ་བོ་དང་རང་བཞིན་དང་རྣམ་པ་དེ་བཞིན་ཉིད་ལས་གཡོ་བ་མེད་པ་གསུམ་དང་།",
    "དམིགས་པ་ནི་རང་རང་ཕྱི་སྣང་སྲིད་མཛོད་ཕུགས་ཀྱི་གཞུང་དང་འགྲེལ་བ་འཕྲུལ་གྱི་སྒྲོན་མེ།",
    "གནས་དང་རང་བཞིན་སྡུག་པ་དང་།",
    "བཏང་སྙོམས་སུ་གནས་པ་དང་བར་མའི་རང་བཞིན་དུ་འདུག་པའི་ཚོར་བ་ནི་དམིགས་པ་དང་།",
    "ཅི་བཞིན་པ་དང་རང་བཞིན་དང་།",
    "ཚུལ་ནི་མེས་འཇིག་དུས་དང་པོ་མན་ཆད་དང་།",
    "མཚོན་བྱ་ནི་སྤྱི་དང་རང་མཚན་མ་འདྲེས་པར་རྟོགས་པའི་རིག་པ་སོགས་སོ།",
    "གང་ནི་སྤྲོས་པའི་མཚན་མ་ཐམས་ཅད་དང་བྲལ་ཞིང་རང་བཞིན་མེད་པའི་གསུང་ཕུལ་ཕྱིན་དང་ལལྡན་ཏེ།",
    "ཀཱི་ལ་ཡའི་སྒྲ་སྒྲོགས་པ་དང་བཅས་པ་སྐྱེས་འདུག་པ་རུ་དྲས་མཐོང་མ་ཐག་འཁོར་དང་བཅས་པ་རྣམས་བརྒྱལ་ནས་འགྱེལ།",
    "དུས་ཉི་མ་རྩེ་ཤར་ཙ་ན་སྲས་གཅིག་བཙས་པ་དང་།",
    "དེ་ནས་ལོ་བཅུ་ལོན་ཙ་ན་ཕྱིར་ཤོར་བ་དང་།",
    "བློན་པོ་གྷ་རུ་དེ་ཝ་གཞོན་ཙ་ན་བུ་མ་སོས།",
    "དེའི་ནང་ན་ཁྱེའུ་མདངས་དང་ལྡན་པ་ཞིག་སྐྱེས་ནས་འདུག་སྟེ།",
    "གཞན་གྱི་ཟླ་བ་ལས་དེའི་ཞག་སྐྱེད་ཆེ་བས་འདིས་རྒྱལ་པོའི་གདུང་འཚོབ་པར་འདུག་ཟེར་ཏེ།",
    "ཡང་བདུད་ཤོར་བ་གཞོན་ནུ་འདུག་ཟེར་ནས་རི་བཤུས་ནས་བཏོན་ནོ།",
    "རྡོ་རྗེ་ཕུར་བུའི་དལ་གསུམ་འདུག་པ་བསྟན་ནོ།",
    "དེ་ནས་ཁ་ལ་རོང་སྒོར་སླེབ་ཙ་ན།",
    "གྲོ་དང་། ། གདའ་ཟེར་རོ།"
  ]
}