    "ཚིགས་སུ་བཅད་པ་ལ་བརྟན་ཅིང་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་དོ།",
    "བཀྲེན་པའི་ཚུལ་དུ་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་དེ།",
    "ཉུང་དུ་ལས་ཀྱང་ཕལ་ཆེར་སྦྱིན་པར་བྱེད་ན།",
    "ཡིད་ཆེས་པར་བྱས་ལ།",
    "གཞན་དག་ལ་གླགས་བཅལ་བའི་ཕྱིར་སྦྱིན་པ་སྦྱིན་པར་ཡང་མི་བྱེད་དོ།",
    "གཞན་དག་ལ་དབྱེ་བ་སྦྱིན་པ་སྦྱིན་པར་མི་བྱེད་དོ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཡོངས་སུ་གཏོང་བའི་སྔོན་དུ་འགྲོ་བས།",
    "བདག་ཉིད་སྙོམ་ལས་མེད་པར་བསྟེན།",
    "གཞན་དག་སྦྱིན་དུ་འཇུག་ཅིང་མངག་པར་མི་བྱེད་དོ།",
    "སྦྱིན་པར་བྱ་བའི་དངོས་པོ་ཐམས་ཅད་སྦྱིན་པར་བྱེད་དོ།",
    "གཞན་པ་དག་ལ་གཙོ་བའི་ཕྱིར་གཞན་དག་ལ་སྦྱིན་པ་སྦྱིན་པར་མི་བྱེད་དོ།",
    "བསྐྲད་པའི་ཕྱིར་སྦྱིན་པ་སྦྱིན་པར་མི་བྱེད་དོ།",
    "བདག་དང་ཕ་རོལ་ལ་རུང་བ་སྦྱིན་པར་བྱེད་ཀྱི་མི་རུང་བ་ནི་མ་ཡིན་ནོ།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་ཀྱི་ཚུལ་བཞིན་མ་ཡིན་པར་མི་བྱེད་དོ།",
    "སེམས་མ་གཡེངས་པས་སྦྱིན་པར་བྱེད་ཀྱི་སེམས་གཡེངས་པས་ནི་མ་ཡིན་ནོ།",
    "སྦྱིན་པ་བརྒྱངས་ཏེ་སྦྱིན་པར་མི་བྱེད་ཀྱི་ལ་གོར་དུ་མྱུར་དུ་སྦྱིན་པར་བྱེད་དོ།",
    "སྦྱིན་པ་ན་ཤེས་རབ་ཅན་གྱི་སྦྱིན་པ་ཁོ་ན་སྦྱིན་པར་བྱེད་དོ།",
    "སློང་བ་དེ་ལ་འདི་སྐད་དུ་སྡུག་པ་ཉིད་ལ་སྦྱིན་པར་བྱ་བའི་དངོས་པོ་འདི་ངས་སྔ་ནས་བཏང་ཟིན་ཏེ།",
    "ཡང་དག་པར་མགུ་བར་བྱས་ཤིང་བག་ཕེབས་པར་བྱས་ཏེ།",
    "ནོར་མི་འགོད་ཅིང་དགའ་བར་བྱ་བས་རིགས་ཀྱི་བུ་འདི་བདག་ཅག་ལ་སེམས་དགའ་བར་འགྱུར་སྙམ་སྟེ་དེ་བཞིན་དུ་བྱེད་པར་འགྱུར་རོ།",
    "འབྲིང་ལ་བརྟེན་ནས་ཆེན་པོ་ཐོབ་པར་འགྱུར་རོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་གང་དག་ཆགས་པའི་རང་བཞིན་ཅན་དང་།",
    "འདོད་པས་ཕོངས་པར་གྱུར་ན།",
    "དེའི་ཐད་དུ་འོངས་ན་ཡང་དེའི་བསམ་པ་རྟོགས་ནས་དེའི་ཉེས་པར་སྤྱོད་པ་གཞན་དག་ལ་ཡང་འཆབ་པར་བྱེད་ན་དེ་ཉིད་ལྟ་ལ་ཅི་སྨོས།",
    "དེའི་འདོད་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་ལ།",
    "ཅི་ནས་ཀྱང་དེ་སྐྱེད་པར་མི་འགྱུར་བ་དང་།",
    "ཕྱིས་རྟོགས་པར་གྱུར་ན་ཡང་འདྲིད་པའི་གང་ཟག་དེ་ལ་གཞི་དེས་གླེང་པའམ།",
    "དྲན་པར་མི་བྱེད་ལ།",
    "དེའི་སྒྱུ་ཐབས་ཀྱིས་མ་བྱིན་པར་ལེན་པ་དེ་དག་ཐམས་ཅད་ལ་ཡང་བསམ་པས་རྗེས་སུ་དགའ་བར་བྱེད་དེ།",
    "བདོག་པ་རྣམས་ཤེས་རབ་ཅན་གྱི་སྦྱིན་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "སེར་སྣ་ཅན་རྣམས་ཀྱང་སྦྱིན་པ་བྱེད་པར་འདོད་པར་གྱུར་ན།",
    "སྦྱིན་པ་དེ་ཡང་སློང་བ་རྣམས་ལ་ལེགས་པར་སྦྱིན་པར་བྱེད་དོ།",
    "མི་མཐུན་པའི་ཕྱིར་སྦྱིན་པ་དེ་ཉེས་པར་བྱིན་པར་འགྱུར་པ་གང་ཡིན་པ་དེ་མེད་པར་འགྱུར་རོ།",
    "མི་བདོག་བཞིན་དུ་ཤེས་རབ་ཅན་གྱི་སྦྱིན་པ་སྦྱིན་པར་བྱེད་པ་ཡིན་ནོ།",
    "གླེགས་བམ་དུ་བྱས་པ་ལ་ཡང་སྦྱིན་པར་མི་བྱེད་དོ།",
    "སྦེད་པར་འདོད་པའམ།",
    "དེ་ཤེས་པས་དོན་དུ་གཉེར་བ་མ་ཡིན་པ་ལ་ཡང་སྦྱིན་པར་མི་བྱེད་དོ།",
    "ཤེས་པར་འདོད་པ་ལ་ནི་གལ་ཏེ་གླེགས་བམ་བདག་ལ་དགོས་པའི་དོན་བྱས་ཟིན་ན།",
    "དེ་ལ་ཅི་བདེར་སྦྱིན་པར་བྱེད་དོ།",
    "ཡང་ན་ནི་གཞན་བྲིས་ཏེ་སྦྱིན་པར་བྱེད་དོ།",
    "མི་འདོད་པ་ཁོ་ན་མ་ཡིན་གྲང་སྙམ་དུ་བརྟག་པར་བྱའོ།",
    "ཡེ་ཤེས་ཀྱི་ཚོགས་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་རམ།",
    "འགྱོད་པར་ཡང་མི་འགྱུར།",
    "སློང་བ་པོའི་འདོད་པ་ཡོངས་སུ་རྫོགས་པར་བྱེད་དོ།",
    "གལ་ཏེ་འོས་མ་ཡིན་པར་མཐོང་ན་ནི་དེས་རྟོག་པ་དེ་ཉིད་ལ་བརྟེན་ནས།",
    "ཁྱེད་ལ་སྦྱིན་པ་གནང་བ་མེད་དོ་ཞེས་དེ་ལ་ཚིག་འཇམ་པོས་གོ་བར་བྱས་ཏེ་གཏོང་བར་བྱེད་དོ།",
    "བཀུར་སྟི་བྱས་ནས་གཏོང་པར་བྱེད་དོ།",
    "བདག་ཅག་ལ་སྦྱིན་པར་མི་འདོད་པ་མ་ཡིན་གྱི།",
    "ཤེས་རབ་ཅན་གྱི་སྦྱིན་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "རབ་ཏུ་དབྱེ་བ་ལས་ཀྱང་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་ནས་སྦྱིན་པར་བྱེད་དེ།"
  ]
