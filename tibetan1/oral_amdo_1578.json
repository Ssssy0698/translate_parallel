    "ཁོ་ད་སྐབས་ཅི་འདྲ་རེད་ཅེས་དྲིས།",
    "ངས་ཁོ་ལ་ཅིག་འགྲིག་གིན་མེད་པ་འདྲ་ཞེས་བཤད།",
    "ངས་ཁོ་ངོ་ཤེས་ནས་ལོ་ངོ་བཅུ་ལྷག་འགོར་སོང་བའི་ལོ་ཟླའི་ཁྲོད་ཁོ་རྒྱུན་ལྡན་ཡིན་པའི་དུས་སྐབས་ཤིག་མི་འདུག་ཁོ་ད་སྐབས་ད་དུང་དེ་འདྲ་ཞིག་རེད་ཟེར་གྱིན་འདུགཁོ་དང་མཉམ་དུ་ཡོང་བའི་མི་དེ་གཉིས་སྐད་གདངས་ཆེན་པོས་ངང་གད་མོ་དགོད་ཀྱིན་འདུགཡོ་ཧན་གྱིས་ཡ་ཡ།",
    "ཁོས་ཇེ་ཁི་ཡི་སྦྱོར་བརྡར་བྱེད་པར་འགན་ཁུར་བཞིན་ཡོད་པ་རེད་ཅེས་ཕན་ཚུན་ངོ་སྤྲོད་ཀྱི་ཚུལ་དུ་སྐད་ཆ་འགའ་བཤད།",
    "ངས་ཁྱེད་གཉིས་ངོ་ཤེས་པས་ཧ་ཅང་དགའ་པོ་བྱུང་སོང་ཞེས་བཤད།",
    "དེ་ནས་ང་ཚོ་ཚང་མ་ཐོག་ཁང་གི་སྟེང་དུ་སོང་བ་ཡིན།",
    "ཡོ་ཧན་གྱིས་ཧོ་ཀིན་གང་ན་བསྡད་ཡོད་པ་རེད་ཅེས་དྲིས།",
    "ནང་དུ་གྲགས་འགུལ་ཅི་ཡང་མི་འདུགངས་ཁོ་ཕལ་ཆེར་གཉིད་སོང་བ་འདྲ་ཞེས་བཤད།",
    "ཁོ་ཉིན་དཀར་གཉིད་འདུག་དགོས་དོན་ཅི་རེད།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "བའི་ནང་དུ་འཛུལ་སོང་།",
    "ཡོ་ཧན་གྱིས་ཇེ་ཁི་ཞེས་ཁོས་གམ་ནས་འབོད་ཀྱིན་འདུག་ཇེ་ཁིའི་མགོ་བོ་དེ་བས་ཀྱང་སྔས་མགོ་བར་དུ་བརྫངས་དེ་ཁ་སྦུབ་ནས་ཉལ་འདུག་ཡོ་ཧན་གྱི་མགོ་བོ་སྒུར་ནས་ཁོའི་དཔུང་བའི་ཐོག་ཏུ་རེག་གིན་འདུག་ཇེ་ཁིའི་མགོ་བོ་ཡར་བཏེགས་བྱུང་།",
    "ཁོའི་ངོ་གདོང་གི་ཁ་སྤུ་སོགས་གཞི་ནས་བཞར་མེད་ཅིང་།",
    "ཁོས་ཡོ་ཧན་ལ་ཁྱོད་ཀྱིས་ང་གཉིད་དུ་མི་འཇུག་དོན་ཅི་ཡིན་ཞེས་དྲིས།",
    "ཇེ་ཁིས་མགོ་བོ་བཏེགས་ནས་ཁྱེད་ཚོ་མཐོང་བས་ཧ་ཅང་དགའ་བོ་བྱུང་སོང་ཞེས་བཤད།",
    "ཁྱོད་ཀྱི་སྣང་བར་ཚོར་བ་ག་འདྲ་འདུག་ཅེས་དྲིས།",
    "ཇེ་ཁིས་ཧ་ཅང་ཡག་པོ་འདུག་ངས་ད་དུང་ཅི་ཞིག་བསམ་དགོས་པ་རེད་དམ་ཞེས་ལན་བཏབ།",
    "སི་ཏན་ཧྥེའར་ཐི་ཡིས་ཁྱོད་ཀྱི་ངོ་མདངས་ཡག་པོ་འདུག་ཅེས་བཤད།",
    "ཁྱོད་ཀྱིས་ཇེ་ལིའུ་དང་ངེད་གཉིས་ཁོ་ཚོའི་འགྲམ་ནས་གྲོས་མོལ་བྱེད་ཀྱིན་ཡོད་པ་ཡིན་ནམ་ཞེས་དྲིས།",
    "ཁྱོད་རང་ངའི་བདག་གཉེར་བ་རེད།",
    "ཁྱོད་ཀྱིས་ངོ་འབག་གོན་ཡོད་པ་ཡིན་ནམ།",
    "ངས་ཁྱོད་རང་ངའི་གམ་དུ་ཡོད་ན་འདོད་པའི་སྐབས་སུ་ཁྱོད་རང་ཅིའི་ཕྱིར་ཕྱི་རུ་མི་ཡོང་བ་ཡིན་ཞེས་ཁོ་ལ་དྲིས།",
    "ཁོ་འདིར་ཡོང་ནས་ཅུང་ཙམ་ལ་འདི་ནས་འདུག་མྱོང་བ་རེད་ཅེས་ལན་བཏབ།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ཇེ་ཁི་ཡིས་ཁྱོད་འགྲོ་འདོད་ན་སོང་དང་ཆོག་མོད།",
    "འདི་ན་མི་གཅིག་གིས་ཀྱང་ཁྱོད་སྒོ་རུ་སོང་ཞེས་འདེད་ཀྱིན་མེད་ཅེས་བཤད།",
    "ཧོ་ཀིན་གྱིས་ང་འགྲན་རའི་ནང་དུ་ཡོང་བ་མཐོང་བས་ང་ཚོའི་འགྲན་སྡུར་གྱི་མཚམས་འདི་ནས་འཇོག་པར་བྱེད།",
    "ཁོ་ཚོའི་ཐག་པའི་འཁོར་རྒྱ་ལས་ཕྱིར་བུད་ཅིང་ཧོ་ཀིན་དང་མཉམ་དུ་ངའི་འགྲམ་དུ་སླེབས་བྱུང་།",
    "ཡོ་ཧིན་དང་མཉམ་དུ་ཡོང་བའི་གསར་བུ་དེ་གཉིས་ཅི་ཞིག་བྱེད་དུ་ཡོང་བ་རེད།",
    "ཁྱོད་ཀྱི་ཁོ་ཚོ་ངོ་མི་ཤེས་སམ་ཞེས་དྲིས།",
    "ངས་ང་རང་དེར་ཁ་བྲལ་ནས་དུས་ཡུན་ངེས་ཅན་ཞིག་འགོར་སོང་ཞེས་བཤད།",
    "སྤྲོ་སྐྱིད་ལྡན་པའི་སི་ཏན་ཧྥོའེར་ཐི་ཞེས་པ་དེ་ཉོ་ཚོང་མཁན་རྩེ་གྲས་ཤིག་རེད་ཅེས་བཤད།",
    "ཁྱོད་ཀྱི་སྐད་ཆའི་ནང་དོན་དེ།",
    "ང་ཚོས་དུས་ཚོད་ཕྱེད་ཙམ་ལ་སྒུག་ན་ད་གཟོད་ང་ཚོར་ཐུག་ཅེས་པ་ཡིན་ནམ་ཞེས་དྲིས།",
    "རེད།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ཧོ་ཀིན་གྱིས་དེ་ན་ང་ཚོ་གཞུང་ལས་ཁང་དུ་འགྲོ།",
    "ང་ཚོས་ཆང་ཉུང་ངུ་ཞིག་འཐུང་ཞེས་བཤད།",
    "མཱ་ཀིན་དང་ཡོ་ཧན་གཉིས་ནི་རང་རང་གི་རྐུབ་སྟེགས་སྟེང་དུ་བསྡད་ནས་ཡོད།",
    "སི་ཏན་ཧྥོའེར་ཐི་ཁོ་གཉིས་ཀྱི་གམ་དུ་ལངས་ནས་འདུགཧོ་ཀིན་གྱིས་ཁྱེད་ཚོ་ནི་དངོས་གནས་ལྐོག་གྱུར་གྱི་གསར་བུ་ཏག་ཏག་རེད་ཅེས་བཤད།",
    "ཁྱོད་བདེ་མོ་ཡིན་ནམ་ཞེས་དྲིས།",
    "ཁྱོད་བདེ་མོ་ཡིན་ནམ་ཞེས་དྲིས།",
    "ཁོ་མི་གཞན་པ་དག་གི་ཉེ་འགྲམ་ན་མེད་ལ།",
    "ཇེ་ཁུ་དང་ངེད་གཉིས་ཀྱིས་ཕོར་བ་གང་རེ་འཐུང་པ་ཡིན་ལ།",
    "གཞན་དག་གིས་ཕལ་ཆེར་ཕོར་བ་གཉིས་གསུམ་རེ་འཐུང་སོང་།",
    "ང་ཚོར་ད་དུང་མང་པོ་ཞིག་ཡོད་ཅེས་ལན་བཏབ།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ཇེ་ཁི་བར་ཁྱམས་ཀྱི་ནང་དུ་ལངས་ནས་འདུག་ཁོ་ཚོས་ལག་བརྡ་གཏོང་ཞོར་དུ་བདེ་མོར་བཞགཇེ་ཁིས་བདེ་མོ་གྱིས་ཞེས་བཤད།",
    "ང་ཚོས་ནུབ་ཟས་ཟ་བའི་འགོ་བརྩམས་པ་དང་།",
    "ང་ཚོ་བར་ཁྱམས་ཀྱི་ནང་དུ་ཡོང་བ་ན།",
    "ས་སྔ་མོ་ནས་རུབ་ཚར་འདུགཇེ་ཁིས་ཇེ་ལེའུ་ཕྱི་རོལ་ཏུ་འཆམ་འཆམ་ལ་འགྲོ་འདོད་དམ་ཞེས་ང་ལ་དྲིས།",
    "ང་ཚོས་ལྭ་བ་གོན་ནས་ལམ་ལ་ཆས་པ་ཡིན།",
    "ངེད་གཉིས་ཀྱིས་ལམ་དེ་བརྒྱུད་ནས་ཕལ་ཆེར་དུས་ཚོད་གཅིག་དང་ཕྱེད་ཙམ་ལ་སོང་བ་ཡིན།",
    "ཁོས་འདི་ལྟར་སོང་ན་དེའི་མིང་ལ་འཆམ་འཆམ་དུ་འགྲོ་ཟེར་བ་ཡིན་ནམ།",
    "དེ་བས་ཕྱིར་སོང་ནས་ཧོ་ཀིན་བཙལ་ན་འགྲིག་ཅེས་བཤད།",
    "ང་ཚོས་རི་བོ་ཆུང་ཆུང་ཞིག་བརྒལ་ནས།",
    "གནས་དེ་གའི་ལམ་ཕྲན་ཞིག་བརྒྱུད་ནས་ཧོ་ཀིན་སྡོད་སའི་ཕྱོགས་སུ་སོང་བ་ན།",
    "རི་བོ་ཆུང་ངུ་ཞིག་གི་གམ་དུ་ཡོད་པའི་ཁང་བའི་ནང་གི་གློག་འོད་ཀྱང་གསལ་ལ་མ་གསལ་པ་ཞིག་མཐོང་ཐུབ་ཅིང་།",
    "ངེད་གཉིས་ཁང་བའི་འགྲམ་དུ་ཐོན་སྐབས་ཧོ་ཀིན་ཁང་བའི་སྒོ་ཁར་ལངས་ནས་འདུགཧོ་ཀིན་གྱིས་འཆམ་འཆམ་དུ་སོང་བ་སྐྱིད་སོང་ངམ་ཞེས་དྲིས།",
    "ཇེ་ཁིས་ཧ་ཅང་སྐྱིད་པོ་བྱུང་སོང་།",
    "ཁྱོད་ཀྱིས་ཅི་ཞིག་བྱེད་དགོས་སམ་ཞེས་ཁོ་ལ་དྲིས།",
    "ཇེ་ཁི་ཡིས་ཇེ་ལིའུ་ཉིས་ཐོག་གི་ཁང་བའི་ནང་དུ་ཤོག་ཅེས་བཤད།",
    "ངེད་གཉིས་ཐོག་ཁང་ནང་དུ་སོང་བ་དང་།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ཇེ་ཁི་ཡིས་འདི་ནི་འཚོ་བ་རེད་ཅེས་བཤད།",
    "ཁྱོད་ཀྱིས་བསམ་ན་ངས་ཅི་ཞིག་བྱེད་འདོད་ཀྱིན་ཡོད་དམ།",
    "སྐྱུག་གི་སྙམ་གྱིན་ཡོད་དམ།",
    "ཧོ་ཀིན་གྱིས་ངས་ཁྱོད་ལ་སྤྱིང་བཏང་གི་དྲི་བ་ཞིག་བཏོན་པ་ཙམ་ཡིན་ཞེས་བཤད།",
    "ཁྱོད་ཀྱིས་ཅི་ཞིག་བྱེད་དམ།",
    "ངས་ཁྱོད་ལ་ཆང་ཕོར་བ་གང་འཐུང་རོགས་བྱེད།",
    "ཇེ་ཁི་ཡིས་ཆང་ཕོར་བ་དོ་བླུག་ནས་ཁྱོད་ཀྱིས་ལྟོས་དང་།",
    "དོ་ནུབ་ངས་དལ་མོ་དང་ཁོམ་པོ་ཡོད་པའི་སྒོ་ནས་འཐུང་དགོས་ཞེས་བཤད།",
    "ཇེ་ཁི་ཡིས་དེ་ཆོག་གི་ངས་ཀྱང་དེ་ལྟར་བྱས་ན་ཅུང་འགྲིག་པར་འདོད་ཡོད་ཅེས་བཤད།",
    "ཁྱོད་ཀྱིས་ད་དུང་ཆང་ཕོར་གང་འཐུང་མི་འདོད་དམ།",
    "ཇེ་ཁིས་ཡིས་ད་དུང་ཕོར་བ་གང་འཐུང་དང་ཞེས་ཟེར་གྱིན་འདུག་མོད།",
    "ཁོས་ང་ཆང་འཐུང་བར་དགའ་བ་ཁྱོད་ཀྱིས་ཤེས་སྲིད།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ཁོས་དྲག་རྩལ་གྱི་ཆེད་དུ་རང་ལ་ཐོབ་འོས་པའི་དངོས་པོ་མང་པོ་ཞིག་ཤོར་སོང་བ་ཁྱོད་ཀྱིས་ཤེས་སྲིད་ཅེས་བཤད།",
    "ངས་ང་ལ་ཐོབ་འོས་པའི་དངོས་པོ་མང་པོ་ཞིག་ཤོར་སོང་བ་ཁྱོད་ཀྱིས་ཤེས་སྲིད།",
    "ཁྱོད་ཀྱི་སྐད་ཆ་དེའི་ནང་དོན་ཅི་ཞིག་ཡིན་ནམ།",
    "དེ་ངའི་བུ་མོ་དག་ལ་མཚོན་ན་ཕན་པ་ཅི་ཡང་ཡོད་པ་མ་རེད།",
    "དེས་ངའི་བུ་མོ་དག་ལ་ཕན་ཅི་ཡང་ཐོག་པ་མ་རེད་ཅེས་བཤད།",
    "ཇེ་ཁི་ཡིས་ངས་ཁོ་མོ་ཚོའི་ཆེད་དུ་སྒོར་མོ་མི་ཉུང་བ་ཞིག་བསགས་ཡོད་ཅེས་བཤད།",
    "ཆང་ཕོར་ནང་གི་ཆང་ཡང་ཟད་ལ་ཉེ།",
    "ཇེ་ཁི་ཡིས་ཆང་ཕོར་ནང་དུ་ཆུ་ཉུང་ངུ་ཞིག་བསྣན་སོང་།",
    "ཁོས་ངས་རང་གི་ཆུང་མ་དྲན་གྱིན་ཡོད་པ་ཁྱོད་ལྟ་བུ་ཞིག་གི་བློ་ཡུལ་དུ་ལེའུ་དྲུག་པ།",
    "གཞི་ནས་ཤོང་དཀའ་བ་ཁྱོད་ཀྱིས་ཤེས་སམ་ཅེས་ང་ལ་བཤད།",
    "ཁྱོད་ཀྱིས་དེ་འདྲའི་ཚོར་བ་དེ་རྩ་བ་ནས་སེམས་སུ་འཆར་ཐུབ་མི་སྲིད།",
    "ཤོག་ད་རུང་ཆང་ཕོར་གང་རེ་འཐུང་།",
    "ཁྱོད་རང་ཧ་ཅང་རྒྱུན་ལྡན་གྱི་ཚུལ་དུ་གནས་འདུག་ཁྱོད་ཀྱིས་ཚོར་བ་དེ་ཅི་འདྲ་ཞིག་ཡིན་པ་གཞི་ནས་ཤེས་མི་སྲིད་ཅིང་།",
    "མི་སུ་ཞིག་གིས་ཀྱང་ཚོར་བ་དེ་ཅི་འདྲ་ཞིག་ཡིན་པ་གཞི་ནས་ཤེས་མི་སྲིད།",
    "ངས་ཁྱོད་ཀྱི་ཆུང་མས་ཚོར་བ་དེ་ཅི་འདྲ་ཞིག་ཡིན་པ་ཤེས་སྲིད་ཅེས་བཤད།",
    "ཚོར་བ་དེ་ཅི་འདྲ་ཞིག་ཡིན་པ་མོས་དངོས་གནས་ཤེས་སྲིད་ཅེས་བཤད།",
    "ངས་ཆང་གི་ནང་དུ་ཆུ་ཉུང་ངུ་ཞིག་བསྲེས་ཞེས་ཁོ་ལ་བཤད།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "མིག་མདངས་ཀྱང་ཅུང་ཉོབ་པོ་ཙམ་དུ་གྱུར་འདུགངས་ཇེ་ཁི་ད་ཁྱོད་རང་སྐྱིད་པོ་ཞིག་གཉིད་ཅེས་བཤད།",
    "ཁྱོད་ཀྱིས་སྒོར་མོ་གསོག་ན་འདོད་དམ།",
    "ཇེ་ཁིའི་ལག་གི་ཕོར་བ་མདུན་ཅོག་གི་སྟེང་དུ་བཞག་ནས་ང་ད་སྐབས་ཅུང་ཙམ་ཡང་བཟི་མེད།",
    "ཁྱེད་ཀྱིས་མཐོང་སོང་ངམ།",
    "ངས་ཁོའི་སྟེང་དུ་སྒོར་ག་འདྲ་ཞིག་རྒྱལ་དུ་བཞག་ཡོད་པ་ཁྱོད་ཀྱིས་ཤེས་སམ།",
    "དེ་ནི་སྒོར་མོ་ཉུང་ངུ་ཞིག་མིན་པ་ཁྱོད་ཀྱིས་ལོས་ཤེས།",
    "སྒོར་ཁྲི་གཉིས་དང་སྟོང་ལྔ་རེད།",
    "ཁོའི་ལག་ནས་སྒོར་མོ་ཉུང་ངུ་ཞིག་ལེན་ཞེས་བཤད།",
    "ངས་ཅི་ཕྱིར་དེ་ལས་ཀྱང་མཐོ་བའི་སྒོར་མོ་ཞིག་བླངས་ན་མ་ཆོག་པ་རེད་ཟེར་གྱིན་འདུག་ལེའུ་དྲུག་པ།",
    "ངས་ཆང་གི་ནང་དུ་ཆུ་ཉུང་ངུ་ཞིག་བསྲེས་ཞེས་བཤད།",
    "ངས་ཅི་ཕྱིར་འགྲན་སྡུར་འདིའི་ཐོག་ནས་འདི་ལས་མཐོ་བའི་སྒོར་མོ་ཞིག་བླངས་ན་མི་ཆོག་པ་རེད་ཅེས་བཤད།",
    "ཇེ་ཁིས་ང་འདི་ནས་གཟའ་འཁོར་གཅིག་ཙམ་ལ་གཉིད་མ་ཁུག་པ་རེད།",
    "ང་གཞི་ནས་གཉིད་ཁུག་གྱིན་མི་འདུག་གཉིད་མི་ཁུག་པའི་སྐབས་ཀྱི་ཚོར་བ་དེ་ཁྱོད་ཀྱི་བློ་ཡུལ་དུ་གཞི་ནས་ཤོང་དཀའ་བར་འདུག་ཟེར།",
    "དེ་འདྲ་ཞིག་ཡིན་སྲིད་པ་རེད།",
    "གཉིད་མི་ཁུག་པ་ནི་དེ་འདྲ་ཞིག་རེད།",
    "ཅི་ལྟར་བྱས་ཀྱང་གཉིད་ཁུག་ཐབས་མི་འདུག་གལ་སྲིད་ལོ་འདི་དག་གི་ཁྲོད་དུ་ཁྱོད་རང་གཉིད་མ་ཁུག་པ་ཡིན་ན།",
    "དེ་ནི་དངོས་ནས་མི་ལེགས་པའི་གནས་ཤིག་རེད།",
    "ཁྱོད་ཀྱིས་གཉིད་མི་ཁུག་པའི་སྐབས་ཀྱི་ཚོར་བ་དེ་ཅི་འདྲ་ཞིག་ཡིན་པ་གཞི་ནས་ཤེས་མི་སྲིད།",
    "ངས་ཆང་གི་ནང་དུ་ཆུ་ཉུང་ངུ་ཞིག་བསྲེས་ཞེས་བཤད།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ཁོ་སྔར་བཞིན་གཉིད་མི་ཁུག་མཇུག་མཐར་གང་ལྟར་ཀྱང་དེ་འདྲ་ཞིག་ཏུ་གྱུར་སོང་།",
    "ངས་ཁོ་ལ་ཁྱོད་གཉིད་སྐྱིད་པོ་ཞིག་ཡོང་སྲིད་ཅེས་བཤད།",
    "ཇེ་ཁིས་སང་ཉིན་ཐུག་ཁྱོད་ནི་ངའི་འཇིག་རྟེན་འདིའི་ཆེས་བཟང་བའི་གྲོགས་པོ་གཅིག་པུ་དེ་ཡིན་ཞེས་བཤད།",
    "ངས་ཁོ་ལ་ཆོག་གི་སང་ཉིན་ཐུག་ཅེས་བཤད།",
    "ཇེ་ཁིས་ཁྱོད་ནི་ངའི་ཆེས་བཟང་བའི་གྲོགས་པོ་གཅིག་པུ་དེ་ཡིན།",
    "མགོ་ཡར་བཏེགས་ནས་ཁྱོད་ཀྱིས་རང་གི་མཛའ་བོ་གཉིད་དུ་བཅུག་བཞག་པ་ཡིན་ནམ་ཞེས་དྲིས།",
    "དེ་འདྲ་ཞིག་རེད།",
    "ད་ང་ཡང་སོང་ནས་གཉིད་རྒྱུ་ཡིན་ཞེས་ལན་བཏབ།",
    "ཞོགས་པའི་དུས་ཚོད་བརྒྱད་ཙམ་གྱི་སྟེང་དུ་ང་རང་ཐོག་ཁང་ནས་མར་བབས་ཏེ་ཟ་མ་ཟ་རུ་སོང་བ་ཡིན།",
    "ང་རང་ཉིད་ཀྱི་ཁང་བའི་ནང་དུ་སོང་ནས།",
    "ཇེ་ཁི་ཞོགས་ཟས་ཟ་སའི་མདུན་ཅོག་གི་འགྲམ་དུ་བསྡད་འདུག་ཧོ་ཀིན་ཡང་ཞོགས་ཟས་ཟ་སའི་ཁང་བའི་ནང་དུ་ཡོང་ནས་མདུན་ཅོག་གི་འགྲམ་དུ་བསྡད་འདུགངས་ཇེ་ཁི།",
    "དེ་རིང་གི་ཚོར་བ་ག་འདྲ་ཞིག་རེད་དམ་ཞེས་དྲིས།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "དེ་འདྲ་ཞིག་རེད།",
    "ཧོ་ཀིན་གྱིས་མདང་ནུབ་གཉིད་ཁུག་སོང་ངམ་ཞེས་དྲིས།",
    "ཇེ་ཁི་ཡིས་གཉིད་ཅུང་ཙམ་ཁུག་སོང་།",
    "ངའི་ལྕེ་ཅུང་ཙམ་ཇེ་ཆེ་རུ་འགྱུར་སོང་བ་འདྲ།",
    "ཧོ་ཀིན་གྱིས་དེ་བཟང་གི་དེ་ནི་ཨ་རག་དཀར་པོ་འཐུང་བས་རེད་ཅེས་བཤད།",
    "ཇེ་ཁི་ཡིས་ཉིན་གུང་གི་ཟ་མ་མ་ཟོས་སྔོན་དུ་འགྲོ་འདོད་ཡོད།",
    "དུས་ཚོད་བཅུ་གཅིག་གི་མེ་འཁོར་གྱི་ནང་དུ་འགྲོ་འདོད་ཡོད་ཅེས་བཤད།",
    "ཧོ་ཀིན་སྒོ་རུ་བུད་སོང་།",
    "ང་མདུན་ཅོག་གི་གམ་དུ་བསྡད་ན།",
    "ཁོས་རྒུན་འབྲུམ་རྡོག་གཅིག་ཟོས་རྗེས་རང་གི་ཁེམ་བུས་སྟེང་དུ་སྐྱུག་པ་དང་།",
    "ཁྱོད་ཀྱི་མདངས་ནུབ་ཆང་དཀར་ཉུང་ངུ་ཞིག་འཐུང་སོང་།",
    "ཧོ་ཀིན་གང་ལ་བུད་སོང་ཞེས་དྲིས།",
    "ཇེ་ཁིས་མོ་ལ་ཁྱོད་ཀྱིས་ང་ལ་འོ་མ་ཕོར་བ་གང་ཁྱེར་ཤོག་ཅེས་བཤད།",
    "མོ་དལ་མོས་ངང་བུད་སོང་།",
    "དེ་ནི་སྒོར་མོ་ཉུང་ངུ་ཞིག་མིན་པ་ཁྱོད་ཀྱིས་ཀྱང་ལོས་ཤེས།",
    "ཇེ་ཁིས་དོན་དག་འདིའི་སྟེང་ནས་ངའི་ཚོར་བའང་དེ་འདྲའི་རྒྱུན་ལྡན་ཞིག་མ་རེད་ཅེས་བཤད།",
    "དེའི་ཕྱོགས་ནས་ཁོ་ཚོས་གྲོས་མོལ་བྱས་ཚར་ཡོད་པ་རེད་ཅེས་བཤད།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "འདི་ཁོ་ལ་མཚོན་ན་སྒོ་མོ་མང་པོ་ཞིག་གི་རིན་ཐང་ཡོད་པ་རེད།",
    "ངས་སྒོར་མོ་ཁྲི་ལྔ་ནི་ཁ་གྲངས་ཉུང་ངུ་ཞིག་མིན་པ་ཁྱོད་ཀྱིས་ལོས་ཤེས་ཞེས་བཤད།",
    "ཁྱོད་རང་ནང་དུ་འཛུལ་ཐུབ་སོང་ཚེ།",
    "ཁྱོད་ལ་གོ་སྐབས་ཡོད་སྲིད།",
    "འགྲན་སྡུར་འདི་ལས་ངས་ཡོད་ཚར་སོང་བ་རེད།",
