    "ར་བའི་ཁར་བསྐོར་ཏེ་བསྲུངས་ནས་འདུག་པ་སྟེ།",
    "གནས་ནི་འདུག་ས་དང་།",
    "ཨ་ཙི་ནི་སྐྲག་པའི་ཚིག་གོ།",
    "གན་དྷེའི་ཐེའུ་ནི་གན་ཡོག་དུས་ཀྱི་འཁོར་ལོ་ནི་དུས་ཚོད་ལྟ་བའི་འཁོར་ལོ།",
    "རུ་འདྲེལ་ཞེས་བྱ་བ་ནི་རྭ་ཐད་གར་འདུག་པའོ།",
    "གུད་དུ་འདུག་ནི་ལོགས་སུ་འདུག་པ།",
    "འོ་བཟེ་ནི་འགྲོ་འདུག་ཡང་ཞིང་སྒྲིན་པོ།",
    "ཙོ་ཙ་ནི་ཤིང་ཐོག་ཀུ་ཤུ་སྟེ།",
    "རང་འགྲོ་འཆག་ཉལ་འདུག་ཐམས་ཅད་དུ།",
    "ནང་རང་སེམས་ཁོ་ནའི་འཕྲུལ་ཡིན་པས།",
    "ཁོ་རང་ཚུགས་མི་ཐུབ་འཇའ་ལྟར་ཡལ།",
    "བཟོད་གླགས་འདུག་གམ་སོམས་ལ།",
    "སྤྱོད་ལམ་འགྲོ་འཆག་ཉལ་འདུག་ཀུན་ཏུ།",
    "ནང་རང་དོན་འཁྲི་བ་གྲྭ་མ་ཉམས།",
    "ཁྱེད་བཟོད་གླགས་འདུག་གམ་ཞིབ་ཏུ་སོམས།",
    "མི་རྟོག་པ་དང་རང་བཞིན་གྱིས།",
    "རྣམ་པར་རྟོག་དང་རྣལ་འདུག་དང་།",
    "རྣལ་དུ་འདུག་པའི་དམིགས་པ་དང་།",
    "དེ་བཞིན་དུ་གནས་ཡོངས་སུ་གྱུར་བ་ལ་ཡང་རངབཞིན་གྱིས་འོད་གསལ་པ་གང་ཡིན་པ་དེ་སྔར་མེད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་བྱེ་བྲག་ཏུ་གྱུར་བ་གཞན་ཉིད་དུ་སྣང་བས།",
    "དེ་ཡང་རང་བཞིན་གྱིས་འོད་གསལ་པ་ཉིད་ལ་སྟེ།",
    "མི་རྟོག་པ་དང་རང་བཞིན་གྱིས།",
    "རྣལ་དུ་འདུག་པའི་དམིགས་པ་ནི།",
    "རྣལ་དུ་འདུག་པའི་དམིགས་པའོ།",
    "གནས་ཁྱད་པར་ཅན་དུ་འདུག་ནུས་ན།",
    "གྱིས་མཆོད་སྟེགས་སུ་བཞུགས་བཅུག་པར་དེ་ཧ་ཅང་མི་མཛའ་བར་འདུག་པས།",
    "ཡུན་རིང་བོར་འདུག་ནུས་ཤིང་མི་ངལ་བ།",
    "དེའི་རྗེས་སུ་དཔལ་ལྡན་བས་རྩ་ཤེའི་འགྲེལ་བ་ཚིག་གསལ་མཛད་ནས་འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱི་དགོངས་པ་ལ་འགྱུར་དུ་གནས་ཤིང་རང་རྒྱུད་མི་འཐད་པའི་གསལ་ག་བཏོན་ནས་ཤིང་རྟའི་སྲོལ་གྱེ་བ་ཡིན་ལ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "ངེ་བཞིན་དུ་ཇི་དོན་ཡོད་ཅིང་རང་རིག་ཞལ་གྱིས་མི་བཞེས་པས་གྱེ་བྲག་སྨྲ་བ་དང་གྲུབ་མ་འ་མག་ན་པར་འདོད་པའང་ཤིན་ཏུ་མི་རིགས་ཏེ།",
    "བདག་རང་བཞིན་མེད་པར་རྟོགས་པ་ན་དེའི་གདགས་གཞི་སུང་བོ་ལྔ་ཡང་རང་བཞིན་གྱིས་ཡོད་པར་འཛིན་པ་སྡོག་པར་འགྱུར་རྟེ།",
    "བདས་མེད་པ་དང་རང་བཞིན་མེད་པ་ཞེས་པའི་དོན་ངེས་པ་ལ་གང་མེད་རྒྱུའི་བདག་དང་རང་བཞིན་དེ་ལེགས་པར་ངོས་ཟིན་དགོས་ཏེ།",
    "ངར་འཛིན་གན་སྐྱེས་ཀྱིས་ང་རང་བཞིན་གྱིས་གྲུབ་པར་འཛིན་ཚུལ་རྩད་གཅོད་དགོས་པས་བློ་ལྷན་སྐྱེས་ལ་ངའི་སྣང་ཚུལ་དང་།",
    "འཛིན་ཚུལ་ཇི་ལྟར་འདུག་བརྟགས་པ་ན།",
    "དེའི་ཚེ་ངར་འཛིན་ལྷན་སྐྱེས་ལ་ཇི་ལྟར་སྣང་སྒྲུན་འདུག་བལྟས་པ་ན།",
    "འཚོལ་དགོས་མི་འདུག་ལྟ་འཚོལ་མཁན་རང་ཡིན།",
    "ཞེས་སྟོང་བ་ཉིད་དེ་ཐག་རིང་བོ་ནས་འཚོལ་དགོས་མི་འདུག་སྟེ།",
    "ཡོད་པ་དང་རང་བཞིན་གྱིས་ཡོད་པ་སོ་སོར་ངོས་མ་ཟིན་པར་དགག་བྱ་ངོས་འཛིན་ཚུལ་མེད་པས་སོ།",
    "མཉམ་མེད་ཇོ་བོ་ཆེན་པོ་སོགས་དང་གྲུབ་ཆེན་ཏེ་ལོ་པ་དང་ན་རོ་པ་སོགས་ལས་རྩིས་ཀྱིས་མི་ལང་བ་ཞིག་མི་འདུག་གསུངས།",
    "འཇིག་རྟེན་ཏེ་ཕུང་བོའང་རང་བཞིན་གྱི་བདག་ཉིད་དང་།",
    "དེས་རང་བཞིན་མེད་པར་འཛིན་པ་མིན་གྱི་མེད་པ་དང་རང་བཞིན་མེད་པའི་ཁྱད་པར་མ་ཕྱེད་པ་ར་སཏན་མེད་དུ་འཛིན་པ་ཡིན་པས་ཕྱིན་ཅི་ལོག་ཏུ་དྲངས་བྱས་ན་བདེ་བར་སེམས་མས་གསུངས།",
    "ལྟ་བ་ལ་ཐོགས་འདུག་མེད་དོ་དིང་རི་བ།",
    "རང་བཞིན་གྱིས་མ་ཞེས་བརྗོད་བའི་རང་བཞིན་ཞེས་པ་དེ་མ་ཐོས་པར་མ་སྐྱེས་པར་བཟུང་འདུག་པ་རྣ་བ་མེད་པ་དང་།",
    "ཡང་དེ་དག་མ་སྐྱེས་ཞེས་པ་རྣམས་ཀྱང་རང་བཞིན་གྱིས་མེད་པ་དང་དོན་དམ་པར་མ་སྐྱེས་ཟེར་དགོས།",
    "དེའི་གཉེན་པོ་སྟོང་བ་ཡང་རང་བཞིན་གྱིས་ཡོད་པར་འགྱུར་ན།་",
    "རང་བཞིན་མེད་པར་བརྗོད་པའི་ཚིག་ཀྱང་རང་བཞིན་མེད་པས།",
    "དངོས་པོ་རྣམས་ཀྱང་རང་བཞིན་གྱིས་མེད་ན།",
    "རང་བཞིན་ལ་མ་བཅོས་པ་དགོས་པ་བྱས་པ་ཡིན་བ་དང་རང་བཞིན་ཡིན་བ་གཉིས་གཞི་གཅིག་ལ་འདུར་མི་རུང་ངོ།",
    "ལ་རང་གཉིས་རིགས་པས་དཔྱད་བཟོད་དུ་དོན་དམ་དུ་སྨུབ་པར་འདོད་པ་འདྲ་ཡང་རང་ངོས་ན་ཐུབ་མ་གྲུབ་འདོད་པ་མི་མཚུངས་པ་ནི།",
    "གཞན་ཡང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་འདོད་པ་དེའི་ལུགས་ལ་འདི་ལྟར།",
    "འདོད་པ་ཡོད་ཀྱང་རང་ལ་དམ་བཅའ་དང་རང་ཕྱོགས་མེད་ལ།",
    "ཡོད་པ་དང་རང་བཞིན་གྱིས་ཡོད་པ།",
    "དངོས་སུ་ཁོ་རང་ལུགས་ཀྱིས་རང་རྒྱ་གྱུ་བ་པའི་རྫས་ཡོད་ཁས་བླངས་ཞེས་འདོད་མི་རུང་སྟེ།",
    "ཞེས་ཐ་བ་ལ་དངོས་སུ་དབྱུག་པ་སོགས་ཀྱི་གནོད་གྱེད་མ་བྱུང་ཕྱིན་རིགས་པས་གནོད་བ་འབབ་དཀའ་བར་འདུག་གོ།",
    "ཞི་འཚོ་ཡབ་མས་སོགས་ཀྱང་རང་མཚན་གྱིས་ཐུབ་བ་ལ་མ་འཁྲུལ་བར་བཞེད་དེ།",
    "སྔ་མ་ཡིན་ན་རྟགས་ཀྱི་དོན་ཀུན་རྫོབ་ཏུ་ཡོད་པ་ཁྱེད་རང་ལ་མ་ཆུབ།",
    "དེ་ཡང་རང་ཁྱུད་པ་མན་ཆད་ཀྱིས་རྟགས་ཀྱི་ཚུལ་གསུམ་རང་ངོས་ནས་གྲུབ་པ་ཞིག་མེད་ན།",
    "ཡན་ལག་ཅན་གྱི་ཤིང་རྟ་རང་བཞིན་གྱིས་མེད་ན་ཤིང་རྟའི་ཡན་ལག་ཀྱང་རང་བཞིན་གྱིས་མེད་པ་ཁོ་དར་འགྱུར་ཏེ།",
