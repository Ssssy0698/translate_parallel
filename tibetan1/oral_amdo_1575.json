    "རིགས་པའི་གཞུང་སྒྲ་སྦྱོར་བྱེད་མཁན་གྱི་ལས་ཀའི་སྐོར་ཡིག་ཐོག་ཏུ་ལུགས་ཀྱི་ཐོག་ནས་རྒྱས་པར་གླེང་བར་མི་སྤོབས་བཀོད་དེ་བརྗོད་པ་ཧ་ཅང་མཐོང་དཀོན་པ་འདིར་རང་ཉིད་ལོ་ཤས་རིང་གློག་བརྙན་སྒྲ་སྦྱོར་གྱི་པས་གཟུར་གནས་སྐྱེས་བུ་དག་གི་དཔྱད་པ་ལག་ལེན་དངོས་ནང་ཐོབ་པའི་མྱོང་ཚོར་གང་དྲན་འཚལ།",
    "དངོས་སུ་སྒྲ་སྦྱོར་བྱེད་སྐབས་ཀྱང་མི་གདངས་སྤྱད་ནས་མི་སྣའི་སེམས་ནང་གི་སྐད་ཆ་ཇི་སྣའི་ཕྱི་ཚུལ་གྱི་སྐད་གདངས་དང་།",
    "གློག་བརྙན་ནང་གི་མི་སྣས་ཆུ་ཏོ་འགྲིགས་པར།",
    "སྒྲ་སྦྱོར་མཁན་གྱིས་མི་སྣ་དེ་ཚོར་བྱུང་བའི་བདེ་སྡུག་རྣམས་རང་ཉིད་ལ་ངེས་པར་དུ་རང་ཉིད་ཀྱིས་བརྗོད་དགོས་པའི་སྐད་བྱུང་བ་ལྟ་བུའི་མྱོང་ཚོར་གྱི་ཐོག་ནས།",
    "བློ་མཐུན་འགའ་ཞིག་གི་བསམ་འདོན་རྒྱུ་ལྟ་ཞོག་ཐ་ན་ཁ་གདངས་བཙུམ་དང་སྐད་པར།",
    "སྒྲ་སྦྱོར་མཁན་ཚོར་རང་མི་རིགས་ཀྱི་སྐད་པའི་ཁ་བདེ་ལྕེ་བདེ་ཞིག་ཡིན་ན་དེས་ཏན་ཏན་གློག་ཡིག་གི་ཚིག་མཛོད་ཕུན་སུམ་ཚོགས་པོ་ཞིག་ཡོད་བརྙན་སྒྲ་སྦྱོར་མཁན་ཡག་པོ་ཞིག་བྱེད་ཐུབ་སྙམ་གྱི་དགོས་པ།",
    "དཔེར་ན་རྒྱ་སྐད་ཀྱི་ཡོད་པ་རེད།",
    "གང་ལགས་ཤེ་ན་ཁྱོད་ཀྱིས་རྒྱུན་དུ་འཚོ་བའི་ནང་བཞད་གད་སློང་སྐབས་ཀྱི་དགོད་སྒྲའམ།",
    "གློག་བརྙན་ཚེ་ལས་འདས་ཏེ་དུས་ནམ་ཡང་རང་ཉིད་དང་ཁ་ནང་གི་མི་སྣའི་དགོད་སྒྲའམ།",
    "ཐ་ན་ལྟད་མོ་ཡོད་པས་རེད།",
    "མི་ཀུ་རི་ཡའི་སྒྲུང་གཏམ་གློག་བརྙན་བུ་མོ་མེ་ཏོག་ཞིག་གིས་ཧ་ཅང་དགོད་བྲོ་བའི་བསྟན་བཤིག་གཙོང་མཁན་ཞེས་པ་ལྟ་བུ་བལྟ་སྐབས།",
    "མི་རྣམས་དགོད་ཤོར་ནས་དབུགས་ཀྱང་བརྙན་ནང་གི་མི་སྣའི་སྡུག་བསྔལ་ལ་བསམ་བློ་གཏོང་དཀའ་ལ།",
    "ཞིག་ཡོད་པ་སྨོས་མེད་རེད།",
    "ཡང་རང་ཉིད་ཀྱི་སོའི་ནང་གི་མི་སྣའི་རང་གཤིས་དང་བདེ་སྡུག་འཚོ་བའི་ནང་འགོག་རྐྱེན་དང་།",
    "ཁོ་ཚོའི་སྐད་ཀྱི་ཆ་རེད།",
    "ལྟད་མོ་བའི་མིག་ལམ་དུ་འཆར་བའི་མི་སྣའི་ནས་མི་རྣམས་རྣ་ཅོག་ཀྲོང་ཀྲོང་བྱས་ཏེ་ཉན་ནས་གཟུགས་བརྙན་དང་།",
    "གཙོང་སྲིད་ཀྱི་རེད་ཅེས་པའི་སྐད་ཆ་དེ་ཤོད་དང་པོ།",
    "མི་སྣའི་སེམས་གཟུགས་བརྙན་སོགས་གསལ་པོར་མཚོན་ཐུབ་པ་བཟང་དང་ཁ་རེ་ཁ་ཐུག་བསམ་ཕོད་ལ་ཤོད་ཕོད་པ་དཔེར་ན།",
    "ཉམ་ཆུང་སེམས་བཟང་བཅས་ཀྱི་གཤིས་གང་ཅིར་འགྱུར་ལྡོག་སྣ་ཚོགས་ཡོང་སྐབས་མི་སྣའི་བཟང་དེ་མངོན་སུམ་གསོན་རྗེན་དུ་ཐོན་ཐུབ་པ་རྣམ་འགྱུར་ལ་གཞིགས་ཏེ་སྒྲ་སྦྱོར་བས་ཀྱང་སྐད་གནང་ཡོད་པ་རེད།",
    "རྒྱ་ཆེའི་གཟིགས་མོ་བ་དཔེར་ན།",
    "གཞན་ཡང་འཁྲབ་ཚན་དེའི་ནང་གི་བྲན་།",
    "ཐོག་མ་ཁྱིམ་ཚང་གི་ཆ་རྐྱེན་གནས་བབས་བྲན་གཡོག་ཡིན་པའི་རང་གཤིས་བཟང་ལ་ལང་ཚོ་དར་བའི་གཞོན་ནུ་མ་དེའི་གཤིས་དང་།",
    "ཨ་མའི་ལད་ཟློས་ཀྱིས་བུ་མོ་ཁྱིམ་ཚང་གི་མི་སྣའི་འབྲེལ་བའི་ཐད་བསམ་ཡུལ་འདིའི་ན་ཚ་སྡུག་ཏུ་སྡུག་ཏུ་འགྲོ་ཡིས་ཞེས་པའི་ལས་འདས་པའི་གནས་ཚུལ་འཕྲད་པ་སྟེ།",
    "དེ་ནི་སྒྲ་སྦྱོར་རེད།",
    "རྣམ་འགྱུར་ལ་གཞིགས་ཏེ་རང་ཤས་དང་དགོད་སྒྲ་གཅིག་གིས་ཀྱང་མི་སྣའི་སེམས་ཉིད་ཀྱི་སྐད་ཆའི་ཤོད་སྟངས་དང་།",
    "མེར་བསྲེགས་བཏང་ན་ཡག་ཤོས་རེད་ཞེས་པའི་སྐད་ཆ་དེའི་བརྗོད་ཡོད་པ་རེད།",
    "སྒྲ་སྦྱོར་གནང་མཁན་ཚོས་དོ་རང་ལྗོངས་ཀྱི་རིག་རྩལ་ལས་རིགས་ཁག་གི་ནང་སྣང་གནང་དགོས་པ་ནི་དངོས་སུ་སྒྲ་སྦྱོར་བྱེད་ནས་དྲིལ་བསྒྲགས་ཀྱི་ནུས་པ་ཆེ་ཤོས་དང་།",
    "སྐབས་རེ་ཁྱེད་ཀྱི་དགོད་སྒྲ་མཇུག་མ་ཚང་མར་བསྐོར་བསྐྱོད་འཁྲབ་སྟོན་ཐེངས་རེ་བྱེད་སྒྲིལ་གོང་ལམ་སེང་གློག་བརྙན་ནང་གི་མི་སྣའི་ངུ་སྒྲ་པར་བསྐྱོད་རྒྱུ་དེ་དཀའ་ངལ་ཧ་ཅང་ཆེན་པོ་ཞིག་སྒྲ་སྦྱོར་བྱེད་དགོས་པ་དུས་གཅིག་ཏུ་འཁེལ་བར་རེད།",
    "འཁྲབ་གང་མང་གཟིགས་འབུལ་ཐུབ་རྒྱུའི་རེ་བ་དང་རྒྱ་ཚན་ནང་གི་མི་སྣ་སོ་སོས་བོད་སྐད་ཀྱི་ཐོག་ནས་ཤོད་ཆེའི་གཟིགས་མོ་བ་ཚོས་སྒྲ་སྦྱོར་སྒྱུར་བཟོའི་ལས་ཀྱི་ཡོད་པ་ལྟ་བུ་སྣང་ཞེས་བསྔགས་བརྗོད་གནང་ཀའི་ནང་སྐྱོན་དང་ནོར་འཁྲུལ་ཡོད་རིགས་ལ་རྩ་གི་ཡོད་པ་རེད།",
    "གློག་བརྙན་རེ་བ་ཞུ།",
    "དེ་དག་ད་ལྟའི་ན་གཞོན་ཚོས་གླེང་རྒྱུའི་གཞི་དང་དེ་ཡང་མ་སྐྱིད་པ་ཞེས་པའི་མིང་ཚིག་ངོམས་རྒྱུའི་རྒྱུ་ལ་བརྩིས་ནས་དཀའ་ཚེགས་ཤིན་ཏུ་འདི་བཞིན་དང་ཐོག་གཞོན་ནུ་ཕོ་མོ་ལ་ལར་མཚོན་ཆེ་བའི་མི་ཚེའི་ཤུལ་ལམ་ཐོག་བསྐྱོད་བཞིན་མཆིས།",
    "ཕྲ་ཆུང་ཀྱིས་འབོད་སྐུལ་འོག་འཛམ་གླིང་ཡུལ་གྲུ་ཀུན་གྱིས་མིག་ལས་ཁོག་ཏུ་སྦས་པའི་བརྩེ་དུང་གི་འདུན་པ་དོ་སྣང་ཆེན་པོས་ས་ཆ་འདིར་ཡུལ་སྐོར་སྤྲོ་འཆམ་དང་འདོད་པ་ཆེ་རུ་ཕྱིན་ནས་རིམ་བཞིན་འཇིག་དང་།",
    "མ་སྐྱིད་པའི་ལམ་དུ་ཞུགས་པ་དང་གཞོན་ནུ་ཁག་ཕྱོང་སྐདངཨར་ལྡང་བདག་གི་ཤེར་རྟོགས་རིག་པའི་ལྟ་ཚུལ་འཕེལ་རྒྱས་སྐོར་ལས་འཕྲོས་པའི་གཏམ།",
    "པ་ཡིན་པས་འདིར་སྟོན་མཇུག་གི་སྐད་ཅིག་མ་ཉིད་བྱམས་བརྩེའི་བདག་ཉིད་ཅན་གྱི་ཁུང་ཙི་སོགས་སྤྱད་དེ་བདག་གི་རྩོམ་འབྲིའི་ལྟ་ཚུལ་དེ་མུ་མཐུད་ཞུ་ལྟ་བུ།",
    "ཁྱད་པར་དུ་གཞོན་ནུའི་དུས་སུ་སྙན་ཚིག་གི་ངེས་ཡིན་པས་བློ་རིག་སྒྲིམས་ཏེ་གསན་བསིངས་རོལ་རྩེད་ལ་སྤྲོ་བས་བརྟས་ཤིང་མནོ་སེམས་ཀྱི་ཁྲོད་ཡོད་པར་ཞུ།",
    "ཁོ་བོར་འཇིན་རྟེན་གྱི་བསམ་བློའི་བང་ཆེས་ཉུང་ཉུང་རེད།",
    "འབྲི་བར་འཚེར་སྣང་བྱེད་དགོས་དོན་སྤུ་ཙམ་ཡང་རྟོགས་རིག་པའི་བསམ་བློ་ལས་གཞན་གང་གི་ནུས།",
    "གང་ལྟར་མིའི་རིགས་ཀྱི་རྩོམ་པ་པོ་མང་དགོས་མོད།",
    "ས་ཕྲར་གྱི་སྐྱུག་བྲོ་བའི་གཞོན་དུས་ཀྱི་ལང་ཚོའི་ཁེངས་སེམས་དང་སློབ་བུ་སེམས་ཧྥུ་རའ་ཙར་གྱི་གསེར་གྱི་ཡལ་འདབ།",
    "ཁ་ཤས་ཀྱི་དཔོན་དུ་གྱུར་པའི་ང་རྒྱལ་གྱིས་སྙན་ཚིག་རྡོབ་སི་ཐེ་ཝེ་སི་ཁད་ཀྱི་ས་འོག་ཁང་པའི་ནང་གི་དང་སྒྲུང་རྩོམ།",
    "བོད་དུ་དེང་རབས་རྩོམ་རིག་གི་འགོ་བརྩམས་པ་ནས་ག་དུས་ཡིན་རུང་གསར་གཏོད་ཀྱི་སྒོ་བྱང་ལེན་ཅི་མི་བཏུབ།",
    "ཁྱེད་ཀྱིས་གནའ་རབས་ཡིན་ངེས་མོད།",
    "འོན་ཏེ་ང་ཚོས་གསར་གཏོད་བྱས་པ་ཧིན་རྡུ་ཡི་སྙན་ཚིག་གི་རྩེད་འཇོ་མཇུག་བསྒྲིལ་ཞིང་མ་ཡིན་ཏེ་དེའི་སྲོལ་འབྱེད་པ་ཨ་རི་བ་ཧད་ཕྲལ་རང་གཤིས་ཀྱིས་སྐྲུན་པའི་སྙན་ཚིག་ཨེ་ཤ་གླིང་དུ་མན་ཡིན་པར་སུས་ཀྱང་བསྙོན་མི་ནུས་པའི་ཕྱིར།",
    "ངས་རང་ཉིད་ཀྱི་ཚེ་སྲོག་གི་ལྟ་ཚུལ་དང་དེའང་དད་མོས་ཀྱི་ཐག་གཅོད་བྱས་ཡོད་པ་རེད།",
    "ང་ཚོ་འཇིག་གཏམ་འདིར་ཆ་འཇོག་ཅིག་གང་དུ་ཡོད།",
    "ཤེས་བྱས་དབུལ་བའི་གངས་ཅན་པ་མང་ཤོས་ཀྱི་དད་མོས་གཞན་ཞིག་ཏུ་གྱུར་ཡོད་པ་རེད།",
    "དུས་ནམ་ཡང་ཟང་དེར་རྨོངས་དད་ཤས་ཆེ་བས་ཚེ་སྲོག་གི་རིན་ཐང་ཟིང་ལང་ལོང་གི་བྱ་གཞག་མང་པོས་ཁོ་ཚོའི་བློ་དང་སྦྲེལ་ཐུབ་མེད་ལ།",
    "ཚེ་སྲོག་གི་རྨོངས་དད་ནི་ཁོ་སེམས་ལ་ཁ་ལོ་བསྒྱུར་བཞིན་ཡོད་པ་དང་དེ་ནི་ཁོ་ཚོར་མཚོན་ན་འཚོ་སྡོད་ཀྱི་སྔོན་འགྲོའི་ཆ་རྐྱེན་ཞིག་ཚོའི་མི་ཚེ་ཧྲིལ་པོའི་སྡོམ་ཚིག་ཀྱང་རེད།",
    "སྟག་བཙན་གདོང་གཟིགས་ཀྱིས་རྟ་མཛོ་སོགས་བགོ་བཤའ་ལམ་ལུགས་ལུགས་རིམ་བཞིན་ཉམས་དམས་སུ་གྱུར་བ་དང་།",
    "རིམ་པ་དང་འདིར་ངེད་ཅག་གིས་གསར་གཏོད་བྱས་པ་དག་ཀྱང་གནའ་བོའི་ཚན་རིག་ཅིག་མ་ཡིན་ནམ།",
    "ང་ཚོས་ཡར་བསམ་བློ་བ་ཚོའི་རླབས་ཆེན་གྱི་རང་གཤིས་དང་དམིགས་བསལ་གྱི་དགེ་མཚན་དུ་ངོས་འཛིན་བྱེད།",
    "རྗེས་དཔག་གི་རིག་པས་གཞིགས་ལ་གཟིགས་གནང་ཡོད་པ་ཞུའོ།",
    "འཕེལ་རྒྱལ་ཕམ་ཐག་གཅོད་བྱ་རྒྱུ་དེ་རེད།",
    "ཉེ་སོགས་དཔྱད་རྩོམ་ལ་གཟིགས་ཚེ་གསལ་བས་འདིར་རབས་སུ་ཚན་རྩལ་འཕེལ་རྒྱས་ཕྱིན་པ་དེས་སྔར་ཡང་སྒྲུབ་བྱེད་དེ་ཙམ་བྱའོ།",
    "རང་མི་རིགས་ཀྱི་རིག་པའི་མིའི་རིགས་ཀྱི་མདུན་དུ་བཀྲམས་པས་གཞི་ནས་གནས་གང་ཡིན་རུང་རྩ་བརླགས་སུ་མི་གཏོང་བར་མིའི་རིགས་ལ་དཔྱོད་གླེང་བྱེད་པའི་ཆ་རྐྱེན་ཞིག་རྒྱུན་འཛིན་དམ་པོ་དང་དེང་དུས་གསར་དུ་དར་སྐྲུན་པ་རེད།",
    "མ་གཞིར་ང་ཚོས་ཕྱི་རོལ་འཇིག་རྟེན་གྱི་ཤེས་བྱ་གསར་པ་ལ་གདེང་གནས་ཀྱི་མ་ལག་ཧྲིལ་པོ་རྒྱུད་འཛིན་གྱི་འདུ་ཤེས་འཇོག་ཅི་ཡང་མི་བྱ་བར་ནམ་ཡང་གནའ་བོའི་ཤེས་སྤྱད་དེ་དར་སྤེལ་བྱ་བཞིན་ཡོད་ཀྱང་ཕྱོགས་གཞན་ཞིག་ནས་འཐུས་ཚང་སྒོས་དར་སྤེལ་བྱེད་པར་ཡང་བྱ་དེའི་སླད་དུ་འབད་འབད་དུང་དུང་བྱེད་ཀྱི་ཡོད་པ་མ་ཟད་གནའ་བོའི་ཤེས་བྱ་དེའང་འགྱིག་བྱི་རིལ་འཇིགས་སྣང་མངོན་གསལ་ཞིག་བྱུང་འདུག་ལྷག་ནང་ལྟར་འགྲམ་སོ་གཉིས་དབར་དུ་བཙིར་གནོན་པར་དུ་བོད་ཀྱི་དེང་རབས་ན་གཞོན་ཚོས་རིག་བྱ་རྒྱུ་ལས་བྲོ་བ་གསར་བ་ཞིག་འདོན་མི་ནུས་པས་གནས་ཀྱི་རྣམ་གཞག་གསར་པར་བསམ་བློ་གཏོང་མི་ཕོད་པ་དེས་བོད་མིའི་ཤེས་རབ་ཀྱི་སྐྱོན་མང་པོ་རེད།",
    "ཕ་ཞིག་ལ་བུ་གཅིག་ཡོད་པ་དེས་ཉིན་ཞིག་ཕའི་རྒྱུ་ནི་འཇིག་རྟེན་གྱི་ཆེས་གླེན་རྟགས་ཤིག་ཡིན་མོད།",
    "ང་ཚོ་ནི་རྟོག་འཇུག་གི་དུས་ཤེས་བྱ་ནི་ཤ་ཁྲག་གདོས་བཅོས་ཀྱི་ཕུང་རབས་ཤིག་གི་ཁྲོད་གནས་ཡོད་པས་རྟོག་འཇུག་བྱ་བོའི་ཚོར་ཤེས་ཕན་ཚུན་ལ་ཤུགས་རྐྱེན་ཐེབས་འོག་རྒྱུ་ནི་ང་ཚོའི་ལས་འགན་གཙོ་བོ་ཞིག་ཡིན་པ་དང་།",
    "བླ་སྲོག་གི་སྣང་ཚུལ་ཞིག་སྟེ།",
    "ས་ཕྲར་ཧྥ་རེན་སིའི་ཤེར་རྟོགས་རིག་པ་བ་དང་རྩོམ་པ་པོ།",
    "ཧུ་ཀོལ་ཧྥ་རེན་སིའི་རྩོམ་པ་པོ་དང་སྙན་ངག་པ།",
    "རེབ་ས་ཚེ་རིང་རྒྱལ་ནས།",
    "དམན་དམན་ཉམས་ཆུང་བློ་དམན་བདག་གིས་སྙན་རྩོམ་ལྷ་རྫས་དར་དཀར་རིང་མོ་ཡིས།",
    "མཛེས་མཛེས་ཆུ་སྐྱེས་པད་མོའི་འདབ་སྟོང་ཟེའུ་འབྲུ་ལྷུག་པོར་བཞད་པའི་ཚེ།",
    "མཚར་མཚར་འཇིག་རྟེན་བདག་ཏུ་བཟུང་བའི་བྱེད་པོ་དག་གི་བླ་འདར་ཞིང་།",
    "མཐུན་མཐུན་བོད་འབངས་ཕྲག་བརྒྱའི་དཔུང་གིས་དཔྱིད་དཔལ་བཞད་པར་བྱས།",
    "འབུངས་འབུངས་དབུལ་ཕོངས་ཕྱུག་བསྒྱུར་དག་ལ་མི་འདོད་གཡོན་གྱི་ཞྭ་མོ་གྱོན།",
    "མཐུན་མཐུན་མང་ཚོགས་རྨ་བྱ་སྔོན་མོའི་ཟློས་གར་རྩེན་པའི་སྐལ་བ་ལྡན།",
    "མཛེས་མཛེས་ནོར་མཛིན་ཁྱོན་ལ་དཔྱིད་དཔལ་གསར་དུ་བཞད་པའི་སྙན་པ་གྲགས།",
    "དཀར་དཀར་གངས་རིའི་ལྗོངས་ཀྱི་བཟོ་ཞིང་ལས་རིགས་གང་དང་གང་གི་ཐད།",
    "ཆེ་ཆེ་དེའུ་འབུར་མང་ཞིང་ཀྱག་ཀྱོག་ཕྲ་བའི་བཤུལ་ལམ་རིང་མོ་ལ།",
    "བཀང་བཀང་ནོར་འཛིན་ཁྱོན་ལ་ཡོངས་གཏམས་རྒྱ་མཚོ་ཆེན་པོའི་ལྟོ་བ་རུ།",
    "འཁྱུག་འཁྱུག་གཡུ་འབྲུག་སྔོན་མོ་རྒྱུ་འདྲའི་དྭངས་གཙང་ཉལ་འགྲོའི་ལྟོ་བ་རུ།",
    "དགའ་དགའ་གདོང་ལ་སྤྲོ་འཛུམ་རྒྱས་པའི་ཕྱུགས་རྫིའི་ངག་གི་གླུ་གཞས་དེ།",
    "གང་གིས་བདག་ལ་ལུང་རིག་ཤེས་བྱ་དང་།",
    "ཐོགས་རེག་བཀག་ཙམ་མེད་པ་ནམ་མཁའི་མཚན་ཉིད།",
    "འཕྲོ་མ་ཤོག་གྲངས་ལ་གཟིགས་། ཨ་ཁུ་ཁྲོ་ཐུང་གི་སྐུ་མཁར།",
    "མཁར་གྱི་བར་མཚམས་རེ་ན་རྡོ་མཁར་དུམ་བུ་རེ་ཆུའི་ལྷོ་བྱང་གཉིས་ཀའི་འགྲམ་གྱི་རི་ངོས་གཡང་།",
    "དེ་ལ་སྤྱིར་བཏང་མིན་པའི་ངག་རྒྱུན་ལས་གླིང་རྗེ་གེ་སར་རྒྱལ་པོའི་ཨ་ཁུ་ཁྲོ་ཐུང་མཛེས་ཉམས་ཤིག་ཡོད་པ་རེད།",
    "ཨ་ཁུ་ཁྲོ་ཐུང་གི་སྐུ་མཁར་ལུང་པའི་མཐིལ་ནས་རྨ་ཀླུང་གསེར་ལྡན་ཆུ་བོས་འུར་སྒྲ་དང་ལྡིར་སྒྲ་བསྒྲགས་བཞིན་རྒྱུ་བ་དང་།",
    "ད་ལྟའི་དུས་ན་མཁར་འདིའི་མིང་ལ་ཨ་ཁུ་ཁྲོ་ཐུང་གི་སྐུ་འདིའི་ནུབ་བྱང་ཕྱོགས་ཀྱི་ཐེམ་ཐོག་སྟེ་རྨ་ཆུ་དང་ཁོ་མཁར་རམ་ཁོབ་མདའི་རྡོ་མཁར་ཞེས་ཤོད་སྲོལ་ཆུ་གཉིས་ཀ་འདྲེས་མཚམས་ཀྱི་ས་ངོས་ནི་ཅུང་ཟད་བདེ་ཞིང་།",
    "ས་ཁྱོན་ཅུང་ཟད་ཡངས་པ་ཞིག་ཀྱང་ཡོད་པ་རེད།",
    "ཨ་ཁུ་ཁྲོ་ཐུང་གིས་སྔོན་ཆད་གླིང་ཡུལ་གྱི་དོན་ཡིན།",
    "འབྲོག་པའི་འཚེར་ས་ཧ་ཅང་ཡག་པོ་ཞིག་ཡིན་གླིང་གི་རྒྱལ་སྲིད་ཀྱང་བསྐྱངས་མྱངས་སྟབས།",
    "ས་ཞིང་གི་བང་མཚན་གསོལ།",
    "རྗེས་སོར་ཁོང་གི་ཚ་བོ་གེ་སར་གྱིས་རིམ་ཚང་མ་རྡོ་ལས་བརྩིགས་པ་ཤ་སྟག་རེད།",
    "ཨ་ཁུ་ཁྲོ་ཀྱིས་མཉམ་མ་བཞག་པར་ནས་འབྲུ་ས་ཐོག་ལ་ཐུང་གིས་གེ་སར་ལ་ཕྲག་དོག་བྱས་པར་མ་ཟད།",
    "ལོ་རྗེས་མར་ས་དེ་ནས་འབྲུའི་སྙེ་མ་སྐྱེས་གདུག་རྩུབ་ཀྱི་བསམ་པ་འཆང་ནས་འཛམ་གླིང་གི་ཤིང་།",
    "རོ་མངར་བ་དམངས་ལ་སྡུག་བསྔལ་ཚབས་ཆེན་མྱོང་རུ་བཅུག་ཞིག་རེད།",
    "འབྲིང་རྒྱུད་ཅེས་ཚོ་ཤོག་ནམ་ཟླར་འགྱུར་ལྡོག་བྱུང་ནས་ལོ་བརྒྱ་ཕྲག་གསུམ་ཡོད་པའི་ནང་ཚན་ཆེ་རྒྱུད་ཚང་གི་མ་འགའ་ཞིག་འདས་ཟིན་ཞིང་།",
    "ཨ་ཁུ་ཁྲོ་བ་རྒྱལ་པོའི་དཔོན་ཁྲོ་ཐུང་ཡིན།",
    "དེའི་དུས་སུ་ཁྲོ་ཐུང་གི་ང་རྒྱལ་སྐུ་མཁར་ལ་ཡང་འཕོ་འགྱུར་ཆེན་པོ་ཞིག་བྱུང་མྱོང་།",
    "ས་འདིའི་མི་བགྲེས་སོང་རྣམས་ཀྱིས་དུས་རྒྱུན་པར་ཁོས་སེམས་ལ་ང་མིན་སུ་ཡིན་སྙམ་གྱི་ཡོད།",
    "འོན་ཀྱང་ཨ་ཁུ་ཁྲོ་ཐུང་གིས་མི་པའི་ཁྲོ་ཐུང་གི་སྐུ་མཁར་ནི་ཤོམ་ར་ཆེ་ཞིང་རྒྱས་སྤྲོས་དམངས་མང་ཚོགས་ལ་གཉའ་གནོན་དང་བཤུ་སྤྱོད་རུལ་དུ་གྱུར་པའི་མཁར་ཞིག་ཡིན།",
    "ཨ་ཁུ་ཁྲོ་ཐུང་གི་མཁར་ཅིང་།",
    "མཁར་ནང་གི་བྲན་རྗེས་ཤུལ་གྱི་མཐའ་བསྐོར་གྱི་རིའི་ངོགས་ན་བཟོ་གཡོག་དང་རང་གི་མངའ་འོག་གི་མི་སེར་རྣམས་དབྱིབས་ལེགས་པོ་མིན་པའི་སྐས་ཞིང་མང་བོ་བང་ཀྱིས་ངོ་རྒོལ་བྱས་སྟབས།",
    "མཁར་འདི་ཡང་རང་ཤུགས་ཀྱིས་སྟོབས་བར་གྱུར་ནས་ད་ལྟའི་བར་དུ་སྐྱིད་པོ་ཞིག་རེད།",
    "བདག་པོ་རྒྱག་མཁན་ཞིག་བྱུང་མེད་པ་རེད།",
    "མིང་ལ་བདེ་ནང་གི་རབ་ཁ་ཟེར་བའི་ཁོག་དང་།",
    "ས་ཕག་གི་ཡོ་བྱད་སོགས་གནའ་ས་ཁུག་ཅིག་ལ་སླེབས་ཐུབ།",
    "དེ་ནི་རྨ་ཆུའི་རབ་ཁ་རྫས་འདྲ་མིན་སྣ་ཚོགས་ས་འོག་ནས་ཐོན་རྒྱུ་ཡོད་རེད།",
    "ཤིང་གི་གྲུ་བོ་ཆེ་སྣ་ཚོགས་བྱུང་བར་མ་ཟད།",
    "རྒྱུ་འཇིམ་པ་ལས་བཟོས་འདི་ནི་ཨ་ཁུ་ཁྲོ་ཐུང་གིས་གཙོ་བྱས་པའི་གླིང་གི་མཐོ་པའི་ལྷ་སྐུའི་གཟུགས་བརྙན་དང་ཚ་ཚ་སོགས་ཀྱང་།",
    "དམན་བར་མའི་མི་རྣམས་རྒྱུ་འགྲུལ་བྱེད་པའི་ཡོ་བྱད་མེད་དུ་མི་རུང་བ་ཞིག་རེད།",
    "དབྱར་གྱི་དུས་ལ་རྡོ་མཁར་གྱི་ཕྱི་ནང་གཉིས་སྔོན་ཕྱོགས་ཀྱི་རྩྭ་ཧྥུ་ཧྥང་ཇག་དམག་གིས་ཤིང་གྲུ་ཀར་རྩྭ་མཐུག་པོ་སྐྱེས་ཤིང་།",
    "རི་སྐྱེས་ཀྱི་མེ་ཏོག་སྣ་ཆེན་པོ་དེ་མེ་བསྲེགས་བཏང་བ་རེད།",
    "དེར་དོ་སྣང་དང་དྲི་མོལ་ཞིག་བྱུང་ན་སྙམ་པས་མི་འཚམ་ཟློས་འགལ་ཅི་ཡོད་ཀྱང་རྣམ་དཔྱོད་ཀི་ཏ་ཀས་གྲུངས་པ་མཛོད་པའི་དགོངས་འཆར་བཅས།",
    "བཅོལ་ཞིང་རིགས་པའི་གཞུང་ལུགས་ཅན་དུ་འགྱུར་ཡང་མཁས་པ་འགའ་རེས་གསལ་ཁ་མེད་པར་བ་དང་།",
    "དེ་བཞིན་གནམ་སྐས་སམ་རྨུ་ཐག་གི་མཚོན་ནང་འཁོད་པ་ལྟར་ན།",
    "གནའ་སྔ་མོའི་ཚེ་ན།",
    "ནགས་ཚལ་སྟུག་པོར་སྐྱེས་པའི་ཁྲོད་སྤྲ་སྤྲེའུ་ཁྱུ་ཚོགས་རྒྱུ་ཞིང་ལྷིང་སྐབས་བན་དེ་ཞིག་གིས་གནམ་ས་རི་ཀླུང་ཉི་ཟླ།",
    "ཐང་ཡིག་གསར་མ་ཐུ་བོན་ནག་ཅེས་དམོད་ཅིང་འབེབས་པ་ཡིན།",
    "བསྐལ་པ་ཡ་ཐོག་གི་དུས་སུ་མི་རྣམས་ཀྱིས་བཀོད་ཡོད་པ་དང་།",
    "ཀུམ་པོ་ནི་བཅུ་ཆ་ལས་བཞི་ལྔ་རེ་སྲིད།",
    "ལོ་རྗེ་བསྔོ་སྨོན་སོགས་མཚོན་པར་བྱེད་ཀྱི་ཡོད་པ་དེ་རྒྱུས་ཡིག་རྙིང་ཁ་ཤས་ནང་ཁྲི་སྲོང་ལྡེ་བཙན་སྐུ་མྱ་རེད།",
    "ཐེངས་འདིའི་དུར་མཆོད་འདུན་མ་ཆུང་ངུ་རེ་བསྡུ་སྟེ་ལུག་ཁྱི་སྤྲེལ་གསུམ་མཛད་སྒོར་ཞུགས་མཁན་ཡེ་གཤེན།",
    "ཐོག་མར་སྲོག་ཆགས་དེ་དག་གི་གཤེན།",
    "ཐང་ཡིག་གསར་མ་ཐུ་བྷོད་གླེགས་བམ་ཁ་ཅིག་གིས་བཏུབ་ཟིན་པའི་ཤ་རྣམས་ཁག་བགོས་ནང་ལུགས་ལ་འདྲེ་དང་མོ་མ་གཙིགས་སུ་ཆེ་འདོན་འཇུག་བྱེད་པ་སོགས་ལས་བགོས་ཁ་གསལ་ཞེས་འཁོད་པ་དང་རུས་སྦལ་ཤུན་གྱི་ཡིག་ཚང་གྱིས་སྒྲུབ་ཡོད་པར་མངོན།",
    "དཔྱིད་འབུད་སོགས་བྱེད་རྒྱུ་ནི་གང་དེའི་བྱ་འགུལ་གྱི་གཙོ་ཀའི་དུས་སུ་ཡུ་མོའི་བྱིན་འབྲེག་ཟེར་བ་ཤ་བ་ཡུ་མོ་བོར་གྲུབ་པ་ཡིན།",
    "བཞིའི་རྐང་ལག་ལྷུ་ལག་ཕྲལ་ནས་བསད་པའི་ཤ་དུས་སྔ་མའི་བོན་པོ་རྣམས་ཀྱིས་སྐྱེ་བ་སྔ་ཕྱི་ཁྲག་གི་དམར་མཆོད་བྱེད་པ་སོགས་ཡོད་ལ།",
    "མི་དང་ནོར་དུ་གྲགས་པའང་དོན་དངོས་ཐོག་རུས་གཤེན་ཡིན་ཕྱུགས་བདེ་ཞིང་འཕེལ་བར་བྱེད་པ་མ་ཟད་ཐ་ན་པའི་བྱིས་པ་ལོ་བཅུ་གསུམ་ལོན་པ་ཞིག་འདྲེས་ཁྲིད་མོ་དང་རྩིས་ཀྱི་ལེགས་ཉེས་ཀྱི་ལམ་སྟོན་པ་དང་།",
    "དེ་ལོ་བཅུ་གསུམ་གྱི་བར་དུ་བོད་ཁམས་ཀུན་ཏུ་སོང་།",
    "ཡིན་མིན་གྱི་ཐེ་ཚོམ་སེལ་བ་དང་སྲིད་དང་རྟེན་བ་ལས་ལོ་ཉི་ཤུ་རྩ་དྲུག་ལ་མིའི་ནང་ཚུད་པ་དེས་འཛུགས་པ་ཚུན་ཆད་ཚང་མ་བོན་གྱི་མོ་མ་དང་།",
    "ཡུལ་འདི་དང་འདི་ལྟ་བུ་ཡོད་ཅིང་ཕན་གནོད་འདི་ཁོ་ཚོའི་མོ་ཕྱུ་པྲ་ཕབ་ཀྱི་བྱ་བྱེད་ལ་ལྟོས་སམ་བརྟེན་དང་འདི་ལྟ་བུ་བྱེད།",
    "སྔོན་མའི་འདྲེ་དང་མོ་མ་གཙིགས་སུ་ཆེ།",
    "རང་གི་ལུགས་སམ་སྲོལ་ལ་དྲག་པོའི་གཡུལ་འཐབ་འགྱེད་པའི་གནས་བབས་དང་བསྲེས་ཤིང་འདྲེས་པར་བྱས་ནས་བོན་པོ་གསར་པ་དང་།",
    "ཁ་ཅིག་གིས་ནི་རྒྱལ་བའི་གསུང་དད་པ་ཞིག་ཡིན་པ་ཁས་མི་ལེན་པ་མ་ཟད།",
    "བོ་དྷི་མོའི་ལུགས་སྲོལ་ཞིག་ཡིན་ཞིང་།",
    "ཕྱུ་གཡང་འགུག་ཞིང་ནོར་ལ་འགྱུར་ལྡོག་ཆེན་པོ་བྱུང་ཡོད་མོད།",
    "ཤུགས་རྐྱེན་ཐེབས་ཚད་ཀྱང་མི་རྒྱུན་ཉམས་མེད་དུ་ཉར་ཡོད་པ་ལྟ་བུ་རེད།",
    "ཤར་རྒྱུད་ཀྱི་འཇང་དང་རྒྱལ་མོ་རོང་བོད་རིགས་ཡོད་པ་མ་ཟད།",
    "ཟི་ཁྲོན་རྔ་བ་དཀྲུག་གི་ཡོད།",
    "ཐོན་སྐྱེད་ངལ་རྩོལ་དང་ཁ་བྲལ་མེད་པ་ལྟ་བུ་རེད།",
    "༥གངས་རིའི་ལང་ཚོ་འཛུམ་པའི་ཞིང་ཁམས་ཀྱི།",
    "གཟིགས་པ་ཇི་བཞིན་བརྗོད་པར་མི་ནུས་པའི།",
    "༨རང་གི་ཆ་ཤས་ལ་ལྟོས་གྲུབ་པ་ཡི།",
    "ལྷག་པར་དུ་སྤྱི་ལོའི་དུས་རབས་དེ་རྗེས་བོད་ལྕགས་ཁྱི་ལོ་སྤྱི་ལོ་ལོར་ཐང་གི་གོང་བདུན་པའི་འགོ་ནས་བཟུང་ཐང་བོད་རྒྱལ་རབས་མ་ཀྲུང་ཙུང་གི་རྒྱལ་རྒྱུད་ཚ་མོ་ཀིམ་ཤིང་ཀོང་ཇོ་བོད་གཉིས་བར་གཉེན་ཚན་གྱི་འབྲེལ་བ་བཙུགས་སྟེ།",
    "ཀྱི་བཙན་པོ་ཁྲི་ལྡེ་གཙུག་བརྟན་གྱི་བཙུན་མོར་མཐའ་མཚམས་ཀྱི་འཁྲུགས་གཞི་ལྷིང་འཇགས་།",
    "སྲས་གཞན་དག་རེས་ཀྱི་གནས་ཚུལ་མང་དག་ཅིག་བྱུང་མྱོང་བ་ལྟར།",
    "རྒྱལ་རབས་རྦ་བཞེད་སོགས་ཀྱི་ནང་གྲས་ཡིན་པའི་རྦ་བཞེད་དང་བསྟན་པ་ཕྱི་དར་རྒྱ་བཟའ་གྱིམ་ཤིང་ཀོང་ཇོ་ཐང་གི་གོང་མ་རང་ཉིད་གྱི་འགོ་ཚུགས་ཙམ་ལ་བྱོན་པའི་གསང་སྔགས་སྔ་ཀྱི་སྲས་མོ་ཡིན་པ་དང་།",
    "སྲས་མ་རི་སྟག་མོ་ཚང་དུ་འཛུལ་བ་ལྟ་བུར་ཡོད་པ་དེ་ཁྲི་སྲོང་ལྡེ་བཙན་དགུང་ལོ་ལྔ་ལས་ཕེབས་མེད་པ་ཡིན་པ་དང་།",
    "ལྕགས་པོ་རིའི་སྣེ་མོ་གཉིས་ལ་མཆོད་རྟེན་རེ་དང་།",
    "རི་ཡིན་པའི་ཐོག་དེར་མཆོད་རྟེན་མ་བརྩིག་པར་རྟེན་རེ་དང་།",
    "ལྕགས་གཉིས་ཀྱི་བར་རྒྱ་མོ་བཟའ་ཕྱི་མས་བཅད་ཡས།",
    "མང་ཚོགས་འགྲིམ་ལྕགས་ཐག་རྔ་གདང་དྲིལ་བུས་སྦྲེལ་དགོས་པ་འགྲུལ་བར་མ་ཆད་པར་ཡོད་པ་དང་།",
    "ཤིང་བཟོ་བ་གཙང་དུ་ལོག་རྒྱུར་བྲེལ་བ་བྱས་པའི་རྐྱེན་གྱིས་ཚིག་རྟེན་འོག་གི་གཞུང་སྒོ་ཆེན་མོའི་གནམ་རྒྱན་གྱི་རྨང་བརྟན་པོ་མ་བྱུང་བར་བརྟེན་གས་སྐྱོན་ཆེན་པོ་དབུས་སུ་ཚེ་དཔག་མེད་ལྷ་དགུའི་དཀྱིལ་འཁོར་ཐེབས་ནས་ཡང་བསྐྱར་ལོ་དེའི་རྗེས་མ་མེ་ལུག་དང་།",
    "ཟུར་བཞིར་ངན་སོང་སྦྱོང་རྒྱུད་ཀྱི་དཀྱིལ་ལོར་ཉམས་གསོ་མཛད།",
    "གནས་བཅས་ཀྱི་སྐུ་འབུམ་རེ།",
    "བཟོ་བཀོད་མཛེས་བཞིའི་གནོད་བཟློག་གི་འཁོར་ལོ།",
    "གསེར་བརྟུལ་མ་ཞོ་ཚུད་ཡོད་པ་རེད།",
    "བསྐྱར་བསྐྱར་བཞེངས་བྱས་པའི་རྒྱུ་ཆ་རྣམས་ཆེད་མངགས་བཞེངས་བྱས་པའི་མཆོད་རྟེན་གྱི་སྤྱིའི་རྒྱ་ཁྱོན་སྤྱི་ཁྲི་སྤྲུགས་རྒྱབ་པའི་རྒྱ་རྡོ་སྤུས་ལེགས་དང་ཨར་འདམ་ངོས་སྙོམས་གྲུ་བཞི་མ་ལྷག་ཡོད་པ།",
    "འཁྲུག་གཟུངས་བྲག་སྒོ་ཀཀྱི་མཆོད་རྟེན་བསྐྱར་བཞེངས་བྱས་བཅས་ཆ་ཚང་རེ་དང་།",
    "དངོས་ར་གསལ་པོ་འཕྲོད་པ་རེད།",
    "ས་བཅུད་དང་ཡུལ་བཅུད་ཀྱི་གཡང་བུམ་སོགས་གྲངས་ཡོད་པ་དང་ཡང་ཚོགས་སོགས་འབྲེལ་ཡོད་ཚན་པའི་འགན་ཁུར་བའི་མཆོད་རྟེན་གྱི་སྲོག་ཤིང་རྭ་སྒྲེང་གི་ཤུག་སྡོང་སྤུས་ནུས་ལྡན་གྱི་རོགས་རམ་གནང་བྱུང་བར་ཐུགས་རྗེ་ལེགས་གསུམ་ལ་གཟུངས་སྔགས་འབྲིས་པར་གསེར་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "རྡོ་རིང་དེ་གཉིས་སྤོ་ཡུལ་ཁང་པ་གསར་རྒྱག་བྱས་པའི་སྤྱིའི་ཁྱོན་ལ་སྤྱི་ཁྲི་གྲུ་བཞི་མ་དང་།",
    "མཐོ་ཚད་ལ་སྤྱི་ཁྲེ་ལྷག་ཡོད་པ་རེད།",
    "ལན་བཅུ་ཡོངས་སུ་རྫོགས་པའི་ལས་དོན་གྱི་མིང་བྱང་ཞེས་པའི་རྡོ་རིང་དེ་ནི་སྤྱི་ལོ་བོད་རབ་བྱུང་པའི་ཆུ་གླང་ལོར་རྒྱ་ནག་གོང་མ་ཆན་ལུང་གི་གོང་མའི་དམག་དཔུང་འབོར་ཆེན་ཞིག་བོད་ལ་དཔུང་འཇུག་བྱས་ཏེ་གོར་དམག་བཙན་འཛུལ་པ་བོད་ནས་མཐར་སྐྲོད་བཏང་བ་དང་།",
    "གོང་མ་ཆན་ལུང་གི་ཕྱག་བྲིས་ཕྱག་སྟར་མ་གནང་བ་དེ་རེད།",
    "གོང་མ་གཉིས་པོས་སྔ་རྗེས་སུ་གནང་བའི་ཕྱག་བྲིས་ནང་སྐབས་དེ་དུས་ཀྱི་གནས་ཚུལ་རྣམས་རྒྱ་བོད་སོག་གསུམ་གྱི་ཡིག་རིགས་ཀྱི་ཐོག་ནས་རྡོ་རིང་དེ་གཉིས་ཀྱི་རྒྱབ་མདུན་ལ་བཀོད་ཡོད་པ་རེད་ལན་བཅུ་ཡོངས་སུ་རྫོགས་པའི་ལས་དོན་གྱི་མིང་བྱང་ཞེས་པའི་རྡོ་རིང་གི་སྤྱིའི་མཐོ་ཚད་ལ་སྤྱི་ཁྲེ་༣ ལྷག་ཙམ་དང་ཞེང་ཚད་ལ་སྤྱི་ཁྲེ་ཡོད་པ་དང་།"
  ]
}