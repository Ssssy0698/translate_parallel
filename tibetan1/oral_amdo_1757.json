    "སྲིན་མོ་རྡོ་རྗེ་ལྟ་བུ་སྟེ་ཞེས་བྱ་བ་དང་།",
    "སྲིན་མོ་བུམ་ལྟས་མ་ཞེས་བྱ་བ་དང་།",
    "སྲིན་མོ་འཇིག་སུ་རུང་བ་ཞེས་བྱ་བ་དང་།",
    "སྲིན་མོ་ཞི་བ་མ་ལྟ་བུའི་སེན་མཅན་ཞེས་བྱ་བ་དང་།",
    "བཅོས་ལྡན་འདས་ག་ལ་བ་དེར་སོང་སྟེ་ལྷགས་ནས།",
    "བཅོམ་ལྡན་འདས་དེར་སོང་སྟེ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་སོང་སྟེ་ལྷགས་ནས།",
    "སྲིན་མོ་བཞི་གང་ཡིན་པ་དེ་དག་ཀྱང་ཕྱོགས་བཞི་ནས་ལྷགས་སྟེ།",
    "གཅིག་ཏུ་འདུས་ནས་བཅོམ་ལྡན་འདས་གལ་བ་དེར་སོང་སྟེ་ལྷགས་ནས།",
    "ཀཙལ་ཀི་ལྟར་རེག་ན་བདེ་བར་གྱུར་ཅིང་།",
    "སྤུག་གི་ཁ་ཁྱེར་གྱིས་རྣམ་པར་ཕྱེ་བ།",
    "སྐར་ཁུང་གི་རྒྱན་ཏེ།",
    "དྲི་མཆོག་གིས་ཕྱོགས་དེ་བཀྲམ་པར་གྱུར་ཏེ།",
    "ཐམས་ཅད་དང་ལྡན་པའི་འཁོར་ལ་གཟིགས་ནས།",
    "གླང་པོ་རྣབ་ཁྱོད་ཚུར་ཤོག།",
