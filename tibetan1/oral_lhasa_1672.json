    "དེ་ལྟར་རྩད་བཅད་པས་སྔ་མ་དེ་བཞིན་དུ་དེ་ཡང་དེ་ལྟར་བདེ་སྡུག་མྱོང་བའི་ཚོར་བ་ལས་བྱུང་བ་ཡིན་པར་ཤེས་ཏེ།",
    "དེ་དག་ནི་འབྲས་བུ་ནས་དཔྱད་པས་རྒྱུ་ངོས་ཟིན་ནས་དེ་ཉིད་ཀྱང་དགག་པ་མེད་པར་ཤེས་པས་མི་ལྡང་བར་གྲོལ་བ་ནི།",
    "རབ་ཏུ་འབྱེད་པ་མེད་པར་མངོན་དུ་མི་བྱེད་པས་སྤོངས་བ་ནི་སྔ་མ་བློ་ཆུང་བ་དང་།",
    "རྒྱུན་དུ་དྲན་པར་བྱ།",
    "དྲོད་དང་རྟགས་དང་ཆོ་འཕྲུལ་དང་མངོན་ཤེས་དང་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་རྣམས་འབྱུང་ངོ།",
    "དེ་ནས་རྣམ་པ་ཐམས་ཨ་ཁཡསམ་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱིས་ཇི་ལྟ་བ་དང་ཇི་སྙེད་པ་ཐམས་ཅད་གསལ་བར་མཁྱེན་ཏོ།",
    "དེ་ལྟར་དྲོད་རྟགས་བྱུང་ནས་ཡེ་ཤེས་ཤར་བས་སྒྲིབ་པ་འདག་པའི་ཚུལ་ནིམབཀའ་ཏིང་ངེ་འཛིན་ལ་བརྟན་པ་ཐོབ་པ་དེས་ན་ཡོན་ཏན་ལྔ་སྐྱེས་པ་དེ་ཡི་མཐུ་དང་རྩལ་གྱི་ཁྱད་པར་གྱིས།",
    "སྒྲིབ་པར་གྱུར་པའི་མུན་པའི་ཁམས་དེ་དག་ཐམས་ཅད་རང་བཞིན་མེད་པའི་དབྱིངས་ཀྱི་ངང་དུ་ཕྱགས་ཏེ་དག་པར་འགྱུར་རོ།",
    "དེས་ན་དོན་དུ་གཉེར་བའི་དགོས་པ་ཡང་དཔེ་ཇི་ལྟར་ན་མར་མེས་མུན་པ་བསལ་བར་བྱས་ན།",
    "དེ་ལྟར་དོན་ཆེན་པོ་དེ་ལ་ཡང་དྭག་པར་ལྟོས་ལ་རྟོགས་པར་གྱིས་ཤིག་པའོ།",
    "ཞེས་པའི་བར་གྱིས་བསྟན་ཏེདེའི་ཕྱིར་དོན་མ་ངེས་པར་ཚིག་གམ་སྒྲའི་ཕྱིར་བློ་འབྲངས་པས་བློ་གྲོས་རྙིང་འདུས་བསྟན་བཅོས་པ་ཞིང་རྣམ་པཔར་གཡེང་བའི་དམུ་རྒོད་དག།",
    "དེས་ན་ཏིང་འཛིན་ཁྱད་པར་འདི།",
    "རྒྱུ་འབྲས་གཉིས་མེད་ལ་སྦྱོར་བས་རག་ལུས་པར་མི་བྱེད་དོ།",
    "གོལ་ས་རྣམས་ཀྱང་གཞིག་དཔྱད་མེད་པར་ཁེགས་ཏེགང་ཞེ་ན།",
    "རྟོག་ན་དོན་དུ་རྟོག་ཀྱང་འདུས་བསྟན་བཅོས་པ་བདུད་ཡིན་པསམཉམ་པ་ཆེན་པོའི་ཏིང་ངེ་འཛིན་གྱི་རོ་དེ་ལ་དེ་ལྟར་མ་ཆགས་པས་ན་གཟུགས་མེད་ཀྱི་ཁམས་སྣང་བ་མེད་པར་ག་ལ་འགྲོ་སྟེ་མི་འགྲོ་བས་གོལ་ས་མེད་དོ།",
    "རིག་པ་ཅིར་ཡང་མ་བསམ་ན་མ་གཡོས་པ་ལ་བསམ་དཔྱད་བྱས་པས་རིག་པའི་རྒྱ་མཚོ་མབཀའ་རྙོགས་ཏེརྟོག་དཔྱོད་ཀྱི་རྙོག་མ་མ་སངས་ན་མི་མཐོང་བའི་ཕྱིར་རོ།",
    "ཅེས་པ་ནས་དེ་ལས་ངེས་པར་གོལ།",
    "ཞེས་པའི་བར་གྱིས་བསྟན་ཏེསྒོ་གསུམ་བཅོས་པའི་སྐྱོན་འཆད་པ་ནིའདིར་ཡེ་ཤེས་ཆེན་པོ་བསྒོམ་བསམ་སྤྱོད་ཡུལ་དམིགས་སུ་མེད་པའི་རང་འགྱུར་སྔ་གསལ་རིག་པ་གཉིས་མེད་ཆེན་པོ་ལ་དུས་གསུམ་དུ་དམིགས་པའི་འདུ་ཤེས་མེད་པར་བཏང་སྙོམས་ཆེན་པོའི་རྣལ་འབྱོར་པ་ཉིད་ནི་གང་དུའང་མ་གཡོས་པས་མ་བཅོས་རྣལ་མ་ཇི་བཞིན་པ་ཉིད་དང་བྲལ་བ་མེད་པར་ཡེ་ནས་ཡིན་བཞིན་དུ།",
    "ཆད་པར་གྱུར་ཏོ།",
    "ཞེས་བོས་ནས་དྲི་བ་གཉིས་དྲིས་པ་ལ་ལེགས་པ་འགྲེལགཉིས་གནང་སྟེགང་དུ་དྲི་བ་དམ་པ་འདི་ནི་རང་དོན་དུ་ཡང་ལེགས་སོ།",
    "དེ་ཉིད་ཇི་ལྟར་ཤེས་པར་བྱ་བའི་ལན་བསྟན་ཏེ།",
    "ཚིག་ལྷག་མ་དང་བཅས་པ་ནི་དོན་དེ་ཉིད་རྒྱས་པར་སྟོན་པའི་ཁུངས་མཚོན་པའོ།",
    "གང་དེའི་ཚེ་སྡུད་པ་པོ་གསང་བའི་བདག་པོ་ཕྱག་ན་རྡོ་རྗེ་ཁྲོ་བོ་གསང་བའི་སྐུའི་འཁོར་དེར་འདུས་པར་གྱུར་པས།",
    "འདི་འདྲར་མ་དམིགས་ལགས་སོ།",
    "ཡུལ་དུ་བྱེད་པས་ཡང་དག་པར་མ་རྙེད།",
    "ཟབ་ཅིང་དཔག་པར་དཀའ་བས་བློ་ཡིས་བསྙགས་པས་མ་སླེབསབགྲོད་ཀྱང་ཡངས་པས་མ་ཁྱབ་ལགས་ནའདི་ཉིད་གནས་གང་ན་མཆིས།",
    "ཞེས་པ་ནསབླུན་པོའི་ཆེད་དུ་ཤེས་པར་གྱིསཞེས་པ་ཡན་ཆད་དོ།",
    "ས་བཅད་ལུགས་གཅིག་ལསྟོད་ཀྱི་འཁྲུགས་མེད་པར་བྱས་ལ།",
    "རྟོགས་པར་བྱ་བའི་ཐབས་བསྟན་པའི་ཆེད་དུདེ་བཞིན་དུ།",
    "དེ་ཉིད་ཤེས་པར་བྱ་བའི་ཕྱིར་རྒྱས་པར་དྲིས་པ་ནི།",
    "དེ་ལྟ་བུའི་མུན་པ་འདི་ཉིད་རྒྱུ་ཅི་ལས་བྱུང་བ་ལགས།",
    "ཅིའི་ཕྱིར་འཐིབས་ཀྱི་ལན་རྟོགས་པར་དཀའ་བས་མཐར་ལམ་པས་ཀྱང་མ་མཐོང་། བར་བསྟན་པ།",
    "ཞེས་པའི་བར་གྱིས་བསྟན་ཏེདྲི་བའི་ལན་སྤྱི་དང་ཁྱད་པར་ལས།",
    "ཆ་གཅིག་ཏུ་ཤེས་པར་བྱ་བའི་དོན་བསྟན་པའི་ཕྱིར།",
    "ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་ཡིན།",
    "རྐང་པ་ཕྱི་མ་གཉིས་ཀྱིས་བསྟན་པར་བཞེད་ནས།",
    "རྒྱུད་གང་དུ་འཐིབས་པར་བསྟན་པ་ཡིན་ཀྱང་།",
    "དེ་ལྟར་རྟོགས་པར་དཀའ་བ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "དེས་ན་མེད་པས་མ་དམིགས་པར་ཡང་ངེས་སོ།",
    "དེས་ནས་བགྲོད་དུ་མེད་པར་མུན་པའི་རང་བཞིན་དང་ཆ་གཅིག་ཏུ་གྱུར་པའོ།",
    "མྱུར་བས་མ་སླེབ་པར་ངེས་པའང་ཡིན་ནོ།",
    "ཚུལ་དེའི་ཕྱིར་ཡངས་པས་མ་ཁྱབ་པར་ཡང་གསལ་ལོ།",
    "བསམ་གཏན་བཞིའི་ཏིང་ངེ་འཛིན་མངོན་དུ་བྱེད་ཅིང་དེ་ལ་ཉོན་ཡིད་ཀྱིས་བདག་ཏུ་འཛིན་སྔ་པའི་འདུ་ཤེས་དང་མ་བྲལ་བ་ཉིད་གཟུགས་ཀྱི་ཁམས་ཀྱི་མ་རིག་པར་ངེས་སོ།",
    "ཆེད་དུ་ཤེས་པར་གྱིས།",
    "གང་ཡུལ་གྱི་བྱེ་བྲག་ཤེས་པར་བྱེད་པའི་ཤེས་པ་དངོས་པོ་ལ་རིག་ཅིང་རྟོག་པའི་ངོ་བོ་ནི་མུན་པའི་མཚན་ཉིད་དེ།",
