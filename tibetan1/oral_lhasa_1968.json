    "ཐམས་ཅད་བྱེད་ཤེས་པ་ཀུན་མཁྱེན་ཡིན་པ་དགག་པ་དང་།",
    "རྐྱེན་ལ་ལྟོས་ནས་ཡུལ་འཇལ་ན་རྟག་པར་འགལ་བའི་ཕྱིར་རོ།",
    "རྟག་པ་རྒྱུ་རྐྱེན་ལ་ལྟོས་པར་མི་རུང་བའི་ཕྱིར།",
    "རྟག་པ་ལ་རྐྱེན་གྱི་རྣམ་པ་འགས་ཀྱང་ཕན་གདགས་པར་བྱ་བ་མིན་པའི་ཕྱིར།",
    "དབྱིབས་ཀྱི་ཁྱད་པར་དང་ལྡན་པའི་ཕྱིར་བུམ་སོགས་བཞིན།",
    "དངོས་པོ་འདི་དག་ཐམས་ཅད་བློ་སྔོན་དུ་བཏང་ནས་བྱེད་པ་པོ་ཡོད་པར་གྲུབ་ལ།",
    "དེ་ཡང་ཕྱི་རོལ་པ་དག་ཐམས་ཅད་མཁྱེན་པའི་དོན་ཐམས་ཅད་བྱེད་ཤེས་པ་ལ་འདོད་པ་ཡིན་ཏེ།",
    "འཇིག་རྟེན་པ་དག་ལག་བཟོའི་རིགས་མང་དུ་བྱང་ཞིང་བྱེད་ཤེས་པ་དག་ལ་ཀུན་མཁྱེན་ཞེས་ཐ་སྙད་བྱེད་པ་ལྟར་རོ།",
    "ཁ་ཅིག་ནི་ཚངས་པས་བྱས་པར་སྨྲ།",
    "ཐམས་ཅད་བྱེད་པ་པོ་ཀུན་མཁྱེན་ཡིན་པ་བཀག་ནས།",
    "དེས་རིགས་ཅན་གཞན་ཡང་ཁེགས་པར་བསྟན་པའོ།",
    "སྐྱེས་བུས་བྱས་པར་སྒྲུབ་པ་དེ།",
    "རང་བྱེད་པ་པོའི་སྐྱེས་བུའི་རྩོལ་བ་ཡོད་མེད་ཀྱི་རྗེས་སུ་འགྲོ་ལྡོག་བྱེད་པ་རྫ་བུམ་སོགས་དང་མཚུངས་པའི་དབྱིབས་ཁྱད་པར་བ་རྟགས་སུ་འགོད་པ་ཡིན་ནམ།",
    "དབྱིབས་ཞེས་པ་སྒྲ་དེ་ཉིད་འཇུག་པར་མཚུངས་པར་དབྱིབས་ཙམ་དུ་ཐ་དད་མེད་པའི་ཕྱིར།",
    "རྫ་བུམ་བཞིན་དུ་རི་བོ་ཡང་སྐྱེས་བུའི་རྩོལ་བས་བྱས་པར་རྗེས་སུ་དཔོག་པ་གང་ཡིན་པ་དེ་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་མིན་ན་རྫ་མཁན་གྱིས་བུམ་པ་ལ་སོགས་འཇིམ་པ་ཡི་རྣམ་འགྱུར་འགའ་ཞིག་བྱེད་པ་དག་དང་འཇིམ་པའི་རྣམ་འགྱུར་ཙམ་དུ་རིགས་མཚུངས་པའི་ཕྱིར་གྲོག་མཁར་ཡང་རྫ་མཁན་དེས་བྱས་པར་གྲུབ་པ་ཉིད་དུ་འགྱུར་རོ།",
    "དབྱིབས་ཙམ་འགོད་ན་ཁྱབ་པ་མ་ངེས་སོ་ཞེས་བྱས་པ་ལ།",
    "ཚུལ་འདི་ནི་རྟགས་སུ་བཀོད་པའི་སྤྱི་དང་ཁྱད་པར་ལ་བརྟགས་ནས་སྐྱོན་བརྗོད་པའི་ཕྱིར་འབྲས་མཚུངས་ཀྱི་ལྟག་ཆོད་ཡིན་ནོ་ཞེ་ན།",
    "འབྲས་མཚུངས་ཀྱི་ལྟག་ཆོད་ངོས་གཟུང་བའི་སྒོ་ནས་དེ་གཉིས་མི་མཚུངས་པར་སྟོན་པ་ནི།",
    "སྒྲའི་བྱས་པ་རྟགས་སུ་འགོད་ན་དཔེ་རྟགས་ཀྱིས་སྟོང་པར་འགྱུར་ཞིང་བུམ་པའི་བྱས་པ་རྟགས་སུ་འགོད་ན་རྟགས་སྒྲ་ལ་མ་གྲུབ་པར་འགྱུར་རོ་ཞེས་སྐྱོན་བརྗོད་པར་བྱེད་པ་དེ་ནི།",
    "འབྲས་མཚུངས་ཀྱི་ལྟག་ཆོད་ཡིན་པར་འདོད་དེ།",
    "སྒྲའི་བྱས་པ་དང་བུམ་པའི་བྱས་པ་གཉིས་ཀ་ལ་རྗེས་སུ་འགྲོ་བའི་འབྲས་བུ་བྱས་པ་སྤྱི་ཙམ་དེ་ཉིད་སྒྲུབ་བྱེད་དུ་བཀོད་ཅིང་།",
    "དེ་ཉིད་ཀྱང་སྒྲ་མི་རྟག་པར་སྒྲུབ་པར་བྱེད་པའི་རྟགས་ཡང་དག་ཡིན་པ་ལ་འབྲེལ་བ་ཅན་སྒྲ་བུམ་ཉིད་ཐ་དད་པའི་ཕྱིར་དེ་གཉིས་ཀྱི་བྱས་པ་ཡང་ཐ་དད་དུ་བརྟགས་ནས་སྐྱོན་བརྗོད་པའི་ལྟག་ཆོད་ཡིན་པའི་ཕྱིར།",
    "བྱས་པ་ཙམ་དེ་སྒྲུབ་ཀྱི་རྟགས་ཡང་དག་ཡིན་ཏེ།",
    "བསྒྲུབ་བྱ་མི་འགྲུབ་པར་སྟོན་གང་།",
    "ཞེས་གསུངས་པ་ནི།",
    "དེ་ཡང་བུམ་པའི་བྱས་པ་སྒྲ་ལ་མེད་ཅེས་རྩོད་ན་མ་གྲུབ་པ་ལྟར་སྣང་བ་དང་སྒྲའི་བྱས་པ་བུམ་པ་ལ་མེད་ཅེས་རྩོད་ན་འགལ་བ་ལྟར་སྣང་བ་དང་།",
    "དེ་ལྟར་འབྲས་མཚུངས་ཀྱི་ལྟག་ཆོད་ནི་བསྒྲུབ་བྱ་སྒྲུབ་ནུས་ཀྱི་སྤྱི་རྟགས་སུ་བཀོད་པ་ལ་ཁྱད་པར་ཐ་དད་ལ་བརྟགས་ནས་སྐྱོན་བརྗོད་པ་ཡིན་ཞིང་འདིར་ནི་དབྱིབས་ཀྱི་སྤྱི་དང་ཁྱད་པར་གང་རྟགས་སུ་བཀོད་ཀྱང་བསྒྲུབ་བྱ་སྒྲུབ་མི་ནུས་ཤིང་།",
    "དབྱིབས་ཀྱི་སྤྱི་རྟགས་སུ་བཀོད་པ་ལ་ཁྱད་པར་ལ་བརྟགས་ནས་སྐྱོན་བརྗོད་པ་མ་ཡིན་གྱི་སྤྱི་དང་ཁྱད་པར་གང་རྟགས་སུ་བཀོད་ཅེས་བརྟགས་ནས་སྐྱོན་བརྗོད་པ་ཡིན་པའི་ཕྱིར་མཚུངས་པ་མ་ཡིན་ནོ།",
    "སྐྱེས་བུའི་རྩོལ་བས་བྱས་པའི་རྫ་བུམ་སོགས་དབྱིབས་ལྡན་ཙམ་དུ་མཚུངས་པའི་ཕྱིར་ཞེས་རྟགས་སུ་འགོད་ན་ཁྱབ་པ་མ་ངེས་པའི་ཚུལ།",
    "དེ་དག་དང་དབྱིབས་ཙམ་གྱི་སྒྲ་འཇུག་པར་མཚུངས་པའི་ཕྱིར་ཞེས་རྟགས་སུ་འགོད་ན་ཁྱབ་པ་མ་ངེས་པའི་ཚུལ་སྟོན་པ་ནི།",
    "དཔེར་ན་ངག་ལ་སོགས་པ་ལ་གོའུ་ཞེས་པའི་སྒྲ་མཐོང་བ་ཉིད་ཀྱི་ཕྱིར་ནས་རྭ་ཅན་ཡིན་པར་དཔོག་མི་ནུས་པ་བཞིན་ནོ།",
    "དབྱིབས་ལྡན་ཙམ་དུ་མ་ཟད་སྐྱེས་བུས་བྱས་པའི་དབྱིབས་ལྡན་གྱི་སྒྲ་སྦྱོར་བ་ཙམ་གྱིས་ཀྱང་སྐྱེས་བུས་བྱས་པར་མི་འགྲུབ་སྟེ།",
    "གསུམ་པ་དེས་རིགས་ཅན་གཞན་ཡང་ཁེགས་པར་བསྟན་པ་ལ།",
    "སེར་སྐྱ་པ་ལ་སོགས་པ་གཅེར་བུ་པ་རྣམས་ཀྱི་སྒྲུབ་བྱེད་ལྟར་སྣང་གཞན་དག་དཔྱད་པ་བྱས་ནས་འགོག་ནུས་པར་བསྟན་པ་ཡིན་ནོ།",
    "བློ་བདེ་ནི་མི་རྟག་པ་རང་ལ་སོགས་པའི་སྐྱེ་ལྡན་ཡིན་པའི་ཕྱིར་ཡང་སེམས་མེད་པ་དང་སོགས་པས་བེམ་པོ་ཡིན་པར་སྒྲུབ་པ་དང་།",
    "ཤུན་པ་བཤུས་ན་འཆི་བའི་ཕྱིར་ཤིང་སེམས་ལྡན་ཡིན་པར་སྒྲུབ་པ་ལྟ་བུའོ།",
    "དེས་ན་ངོ་བོ་དང་ཁྱད་པར་གཉིས་ལས་ངོ་བོ་གཙོ་ཆེ་ཞིང་མིང་དང་དོན་གཉིས་ལས་དོན་གཙོ་ཆེ་བ་རིམ་བཞིན་དཔེའི་སྒོ་ནས་སྟོན་པ་ནི།",
    "གཏན་ཚིགས་ལ་ངོ་བོ་དང་ཁྱད་པར་གཉིས་ལས་ངོ་བོ་གཙོ་བོ་ཡིན་ཏེ།",
    "པེར་ན་བྱས་པའི་ངོ་བོ་སྒྲའི་སྟེང་དུ་འགོད་ཚུལ་དང་མཐུན་པར་གྲུབ་ན།",
    "ཁྱད་པར་ནམ་མཁའི་ཡོན་ཏན་དང་དོན་གཅིག་ལ་འདུ་བའི་བྱས་པ་སྒྲའི་སྟེང་དུ་མ་གྲུབ་ཀྱང་གནོད་བྱེད་མིན་པ་བཞིན་ནོ།",
    "འདི་དག་ཀྱང་རྒྱས་པར་འོག་ཏུ་འཆད་པར་འགྱུར་རོ།",
    "དོན་དེ་ཉིད་འཁྲུལ་བ་དང་འགལ་བ་མ་གྲུབ་པ་ལ་སོགས་པ་ཡིན་ན་སྒྲ་ནི་འཁྲུལ་པ་མེད་ན་ཡང་སྒྲུབ་བྱེད་སྐྱོན་ལྡན་དུ་ཤེས་པར་བྱ་སྟེ།",
    "ལག་པ་དང་ལྡན་པའི་ཕྱིར་ཞེས་སྒྲུབ་བྱེད་དུ་བཀོད་ན་ཁྱབ་པ་འཁྲུལ་པར་འགྱུར་བ་བཞིན་ནོ།",
    "སྣ་ཚོགས་འདི་དག་འབྱིན་པར་བྱེད།",
    "ཁྱེད་ཀྱིས་འབྲས་བུ་ལ་ཕན་འདོགས་པའི་རྒྱུ་འབྲས་ཀྱི་ནུས་པ་ཉིད་ཀྱང་རྟོགས་པར་དཀའ་སྟེ།",
    "འབྲས་བུ་ཐམས་ཅད་ལ་རྒྱུ་རྣམས་ཐུག་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ས་སོགས་ཀྱིས་མྱུ་གུ་མི་སྐྱེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཁྱད་པར་མེད་པ་རྟགས་མ་གྲུབ་སྟེ།",
    "ཞིང་དེ་ལྷག་པར་རྨོ་བ་སོགས་སོ་ནམ་ལེགས་པར་བྱས་པ་ན་འབྲས་བུ་དེ་ཡི་ཁྱད་པར་ཕུལ་དུ་བྱུང་བ་མཐོང་བའི་ཕྱིར་རོ།",
    "ཁོ་བོ་ཅག་ནི་ཐམས་ཅད་བྱེད་ཤེས་པ་ཀུན་མཁྱེན་དུ་མི་འདོད་ཀྱི།",
    "སྔར་ནི་ཐམས་ཅད་བྱེད་ཤེས་པ་ཀུན་མཁྱེན་གྱི་མཚན་ཉིད་དུ་འདོད་པ་བཀག་ཅིང་།",
    "འདིས་སྲིན་བུའི་གྲངས་དང་རྒྱང་རིང་པོ་སོགས་མཐོང་བ་ཀུན་མཁྱེན་གྱི་མཚན་ཉིད་དུ་འདོད་པ་བཀག་སྟེ།",
    "བླང་དོར་གྱི་གནས་མ་ལུས་པ་མངོན་སུམ་དུ་མཁྱེན་པ་གྲོལ་བ་དོན་གཉེར་ལ་ཉེ་བར་མཁོ་བའི་ཀུན་མཁྱེན་གྱི་མཚན་ཉིད་དུ་སྒྲུབ་པར་མཛད་པ་ཡིན་ནོ་ཞེས་ཤེས་པར་བྱའོ།",
    "ཀུན་མཁྱེན་ཚོལ་བའི་ཚུལ།",
    "གྲོལ་བ་དོན་གཉེར་ལ་ཉེ་བར་མཁོ་བའི་ཀུན་མཁྱེན་ངོས་གཟུང་བའོ།",
    "སྲིན་བུའི་གྲངས་མ་ལུས་པར་མཁྱེན་པ་ཡིན་མིན་ཐོག་མར་དཔྱད་པར་མི་བྱ་སྟེ།",
    "འོ་ན་དེ་ལྟར་དཔྱད་པའི་ཚེ་སྟོན་པར་འཛིན་པའི་སྔོན་དུ་དེ་ལ་བྱང་གྲོལ་གྱི་ལམ་མཁྱེན་པའི་ཡོན་ཏན་ཡོད་པར་ཤེས་སམ་མི་ཤེས།",
    "མི་ཤེས་ན་བསྟེན་པར་བྱ་བ་དང་བསྟེན་པར་བྱ་བ་མ་ཡིན་པའི་རྣམ་དབྱེ་མི་བྱེད་པར་ཐོག་མར་གང་ཕྲད་པ་དེ་བསྟེན་པར་རིགས་སོ་ཞེ་ན།",
    "སྲིན་བུའི་གྲངས་ཐམས་ཅད་རིག་པར་མཛད་པ་ཙམ་གྱིས་གྲོལ་བ་དོན་གཉེར་གྱི་འདོད་པ་རྫོགས་པ་མ་ཡིན་ཞིང་།",
    "འདོད་པའི་དེ་ཉིད་བདེན་བཞིའི་གནས་ལུགས་མངོན་སུམ་དུ་མཐོང་བ་གྲོལ་བ་དོན་གཉེར་ལ་ཉེ་བར་མཁོ་བའི་ཀུན་མཁྱེན་གྱི་མཚན་ཉིད་ཡིན་པར་རིགས་སོ།",
    "ཚུར་ཤོག་བྱ་རྒོད་སྟོན་པར་བསྟེན་པར་གྱིས་ཤིག་འདིས་ནི་སྲིན་བུའི་གྲངས་དང་རྒྱང་རིང་པོ་སོགས་མཐོང་བ་གྲོལ་བ་དོན་གཉེར་ལ་ཉེ་བར་མཁོ་བའི་ཀུན་མཁྱེན་གྱི་མཚན་ཉིད་དུ་འདོད་པ་འགོག་པ་ཡིན་གྱི།",
    "ཀུན་མཁྱེན་གྱིས་དེ་དག་མཁྱེན་པ་དང་དེ་ལྟ་བུ་མཐོང་བའི་ཀུན་མཁྱེན་ཡོད་པ་འགོག་པ་ནི་མ་ཡིན་ནོ།",
    "མཐའ་དག་སྡུག་བསྔལ་ལས་སྒྲོལ་བར་འདོད་པའི་ཐུགས་རྗེ་ཆེན་པོ་དེ་ཐམས་ཅད་མཁྱེན་པ་སྒྲུབ་པར་བྱེད་པ་ལ་དང་པོར་སྔོན་དུ་འགྲོ་དགོས་ཏེ།",
    "གོམས་པ་གྲུབ་པ་མེད་པར་འདོད།",
    "ཆང་དང་མྱོས་པར་བྱེད་པའི་ནུས་པ་བཞིན་དུ་བློ་ལུས་ཀྱི་བདག་ཉིད་དུ་གྱུར་པའི་སྒོ་ནས་ལུས་ལ་བརྟེན་པ་དང་།",
    "དེ་ལྟར་བརྟེན་ཚུལ་གསུམ་གྱི་སྒོ་ནས་བློ་ནི་ལུས་ཁོ་ན་ལ་བརྟེན་པར་འདོད་དོ།",
    "ལུས་ཁོ་ན་ལ་བརྟེན་པར་མ་གྲུབ་ན།",
    "ལུས་ཞིག་ན་བློ་རྒྱུན་འཆད་པར་ཁྱབ་པ་མི་འགྲུབ་པར་དོགས་པས་ཡིན་ནོ།",
    "དགྲ་བཅོམ་པའི་འཆི་སེམས་བཞིན་ཞེས་པ་དེ་འགོག་པར་བྱེད་དོ།",
    "ལུས་ཀྱི་ཕུལ་བྱུང་འགྲིབ་མེད་པར།",
    "བློ་ལུས་ཀྱི་ཡོན་ཏན་ཡིན་པའི་སྒོ་ནས་དུས་མཉམ་པའི་རྟེན་དང་བརྟེན་པར་འདོད་པ་འགོག་པ་ལ་གཉིས་ལས།",
    "སྣོད་ལ་ཆུ་བརྟེན་པར་ལྟར་ལུས་གཞི་དང་།",
    "བློ་དེ་ལ་གནས་པ་པོ་ཡིན་པའི་སྒོ་ནས་དུས་མཉམ་པའི་རྟེན་དང་བརྟེན་པར་འདོད་པ།",
    "ལུས་ཞིག་ན་ལུས་ལ་བརྟེན་པའི་རྣམ་པར་ཤེས་པ་ཡུལ་ལ་གནས་པ་ཡང་འཇིག་པར་འགྱུར་རོ།",
    "ལུས་ཀྱི་ཕུལ་བྱུང་འགྲིབ་མེད་པར།",
    "བློ་ལུས་ཀྱི་བདག་ཉིད་ཡིན་པའི་སྒོ་ནས་ལུས་ལ་བརྟེན་པར་འདོད་པ་འགོག་པ་ནི།",
    "ཇི་ལྟར་སེམས་ལ་བརྟེན་བྱས་ནས།",
    "དེ་ལྟར་སྐྱེ་བ་ཕྱི་མ་མེད་པ་སྒྲུབ་བྱེད་དང་བཅས་པ་རྒྱས་པར་བཀག་ནས།",
    "རྒྱས་པར་བཤད།",
    "ཡིད་བློ་ལུས་ལས་སྐྱེ་ན་སྐྱེ་བ་སྔ་ཕྱི་ཁས་ལེན་རིགས་པར་བསྟན་པའོ།",
    "དེས་ན་རྒྱུ་ཚོགས་ཁྱད་པར་མེད་པའི་ཕྱིར་ཐ་མལ་པའི་འཆི་སེམས་ཐ་མས་ཀྱང་།",
    "རང་འབྲས་རིག་པ་ཕྱི་མ་མཚམས་སྦྱོར་བ་ཡོད་པར་གྲུབ་པ་ཡིན་ནོ།",
    "གང་དུ་དྲོད་གཤེར་སྐྱེས་ལ་སོགས་པའི་སྐྱེ་བོ་སྣ་ཚོགས་སྐྱེ་བར་མི་འགྱུར་བའི་ས་སོགས་ཀྱི་ཆ་དེ་འགའ་ཡང་མེད་པར།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ངེས་པར་ལུས་ཉེར་ལེན་དུ་བྱས་པ་ལས་སྐྱེ་དགོས་པ་འགོག་པ་ཡིན་ནོ།",
    "ཅེས་སོགས་ཀྱི་སྐབས་སུ་ཐ་མལ་པ་སྐྱེས་མ་ཐག་པའི་རིག་པ་དང་པོ་དེ་ཉིད་སྲིད་པ་གྲོགས་སུ་ཡོད་པའི་རིག་པ་སྔ་མ་ལས་སྐྱེས་པར་བསྒྲུབས་ནས།",
    "ཁོ་ན་ཉིད་བསྡུས་པའི་འགྲེལ་པར།",
    "ཐ་མལ་པ་འཆི་བའི་སེམས་ཀྱང་འདོད་ཆགས་དང་བཅས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་གཞན་གྱི་རྟགས་སོ་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "འདོད་པ་དེ་ལྟར་ནའང་ཕན་ཚུན་རྒྱུ་ཉིད་ཡིན་པར་འགྱུར་བས།",
    "གསུམ་པ་ལུས་སེམས་ཀྱི་རྒྱུ་ཡིན་ན་སྐྱེ་བ་སྔ་ཕྱི་ཁས་ལེན་རིགས་པར་བསྟན་པ་ནི།",
    "རྟག་པ་རྐྱེན་གྱིས་ཁྱད་པར་དུ་བྱར་ཡོད་པ་ཅན་མིན་པའི་ཕྱིར་རོ།",
    "ཡིད་བློ་སྔ་མ་རིམ་ཅན་གྲོགས་སུ་ཡོད་པ་ལ་ལྟོས་ནས་ལུས་ཀྱིས་ཡིད་བློ་ཕྱི་མ་རིམ་ཅན་བསྐྱེད་པར་བྱེད་པའི་ཕྱིར།",
    "ལུས་སྔ་མ་ཉེར་ལེན་དུ་ཡོད་པ་ལ་ལྟོས་ནས་ཡིད་བློ་སྔ་མས་ཡིད་བློ་ཕྱི་མའི་ལྷན་ཅིག་བྱེད་རྐྱེན་བྱེད་དགོས་པར་འགྱུར་ལ།",
    "ཚུལ་དེ་འཆི་ཁའི་གནས་སྐབས་ལའང་མཚུངས་པའི་ཕྱིར་སྐྱེ་བ་ཕྱི་མའང་ཡོད་པར་འགྱུར་རོ།",
    "དེ་བས་ན་ལུས་ཀྱིས་ཡིད་བློའི་རྟེན་བྱེད་པར་ཁས་ལེན་ན།",
    "རྟགས་མ་ངེས་པར་བསྟན་པ་དང་།",
    "དཔེ་མ་གྲུབ་པར་བསྟན་པ་དང་།",
    "འབྲས་བུ་ལྡོག་པའི་རྒྱུ་ཁྱད་པར་ཅན་ངོས་གཟུང་བའོ།",
    "ཐ་མལ་པ་འཆི་ཁའི་སེམས་ཀྱང་འཆི་སེམས་ཡིན་ནོ་ཞེས་པའི་རྟགས་ལསའཆི་སེམས་ཐ་མས་རིགས་འདྲ་ཕྱི་མ་མཚམས་སྦྱོར་བ་མི་སྲིད་པར་གྲུབ་ལ།",
    "དེའི་ཕྱིར་སྐྱེ་བ་ཕྱི་མ་དང་སྔ་མ་དག་མེད་པར་གྲུབ་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ཐ་མལ་ལྷ་སྦྱིན་འཆི་ཁའི་ཐ་མ་ཡི་ནི་སེམས་དེ་སེམས་གཞན་དང་མཚམས་སྦྱོར་བ་ལ་འབྲེལ་བ་ཅི་ཞིག་ཡོད་དེ་ཅིའང་མེད་པའི་ཕྱིར་རོ།",
    "གཉིས་པ་ལ་དཔེ་མ་གྲུབ་པར་བསྟན་པ་ནི།",
    "འདི་ཉིད་སློབ་དཔོན་གྱི་དགོངས་པར་མངོན་ཏེ།",
    "འོ་ན་དགྲ་བཅོམ་ཐོབ་པ་ན་རིག་པ་རྒྱུན་ཆད་པར་འགྱུར་བའི་ཕྱིར།",
    "ཇི་ལྟར་ཆུ་ལ་བརྟེན་པའི་ཡོན་ཏན་དྲོད་དེ་ཉིད་འཕེལ་བར་གྱུར་པ་ཙམ་གྱིས་རྟེན་ཆུ་བསྐམས་ཏེ་མཐར་བརྟེན་པ་དྲོད་དེ་ཉིད་ལྷག་པར་འཕེལ་བའི་སྟོབས་ཀྱིས་རྟེན་ཆུ་དེ་ཉིད་རྒྱུན་ཆད་པར་འགྱུར་བ་ལྟར།",
    "མར་མེ་ཤི་བ་བཞིན་དུ་མྱ་ངན་ལས་འདས་པ་ནི་ཕྱི་རོལ་གྱི་ཚུལ་ལ་ཡིན་གྱི་དོན་དམ་པར་ནི་མིན་ནོ་ཞེས་འཆད་ལ།",
    "ཉེས་པ་ཐམས་ཅད་ཟད་ཀྱང་སྐྱོན་ཅན་མིན་པའི་སེམས་ནི་རྣམ་པར་ཆད་པར་འོས་པ་མ་ཡིན་ནོ།",
    "གཅོད་བྱེད་གཅད་པར་བྱ་བ་ནི།",
    "ཞེས་གསུངས་པ་ལྟར་རོ།",
    "དེ་ཡི་སེམས་ནི་རྣམ་པར་གྲོལ།",
    "རིགས་པའི་སྒྲུབ་བྱེད་མི་འཐད་པར་བསྟན་པ་ནི།",
    "དེ་ཉིད་ཐ་མལ་པའི་འཆི་སེམས་མཚམས་སྦྱོར་བ་མེད་པར་སྒྲུབ་པ་འདིར་ནི།",
    "སྒྲུབ་བྱེད་དུ་ཅིས་མ་བརྗོད་དེ་དེ་ཉིད་ཀྱི་སྒྲུབ་བྱེད་དུ་ཡང་བརྗོད་རིགས་པར་ཁྱད་པར་མེད་པར་འགྱུར་ལ།",
    "གཏན་ཚིགས་ལྟར་སྣང་དུ་བསྟན་པའི་སྐྱོན་དེ་ཉིད་འདིར་ནི་ཅིས་མི་བརྗོད་དེ་འདི་ལ་ཡང་བརྗོད་པར་རིགས་པ་ཡིན་ནོ།",
    "ལུས་དེ་ཉིད་སེམས་ཀྱི་ལྡོག་བྱེད་ཀྱི་རྒྱུ་ཁྱད་པར་ཅན་ཡིན་ན།",
    "ཉེར་ལེན་ཡིན་པ་འོག་ཏུ་འགོག་པར་འགྱུར་ཞིང་།",
    "དེ་ལྟ་ན་གཟུགས་དེ་འཛིན་པའི་མིག་བློ་བཞིན་དུ་གཟུགས་གསལ་བར་འཛིན་པར་འགྱུར་བའི་ཕྱིར།",
    "དུག་ལ་སོགས་པས་ལུས་ཉམས་པར་བྱས་པ་ན།",
    "དེ་ནི་ལུས་བདག་རྐྱེན་དུ་བྱས་པའི་སྒོ་ནས་འགྱུར་བ་མ་ཡིན་གྱི།",
    "དོན་ནམ་དམིགས་ཡུལ་དུ་བྱས་པ་ཉིད་ཀྱི་སྒོ་ནས་འགྱུར་བ་ཡིན་ནོ།",
    "གསུམ་པ་འབྲས་བུ་ལྡོག་པའི་རྒྱུ་ཁྱད་པར་ཅན་ངོས་གཟུང་བ་ནི།",
    "དེའི་ཕྱིར་ཐ་མལ་པའི་འཆི་སེམས་ལས་རང་འབྲས་རིག་པ་ཕྱི་མ་འབྱུང་ངེས་ཡིན་པར་སྒྲུབ་ནུས་པས་སྐྱེ་བ་ཕྱི་མ་ཡོད་ངེས་སུ་འགྲུབ་པ་ཡིན་ནོ།",
    "དགག་སྒྲུབ་རྒྱས་པར་མ་བྲིས་སོ།",
    "ལུས་ཁོ་ན་བློའི་ཉེར་ལེན་མིན་པའི་སྒོ་ནས་བློ་ལུས་ལ་བརྟེན་པར་འདོད་པ་དགག།",
    "བློ་ལུས་ཀྱི་ཡོན་ཏན་ཡིན་པའི་སྒོ་ནས་ལུས་སེམས་དུས་མཉམ་པའི་རྟེན་དང་བརྟེན་པར་འདོད་པ་དགག།",
    "བློ་ལུས་ཀྱི་བདག་ཉིད་ཡིན་པའི་སྒོ་ནས་ལུས་ལ་བརྟེན་པར་འདོད་པ་དགག་པའོ།",
    "དེ་དག་ཡིད་བློའི་ངེས་པའི་རྒྱུ་ཁྱད་པར་ཅན་ཡིན་པའི་ཕྱིར།",
    "འདི་ལྟར་སླར་མི་འགྱུར་བར་འགའ་ཞིག་ནི་ལ་ལར་འགྱུར་བ་བསྐྱེད་པར་བྱེད་པ་ཡོད་དེ་དཔེར་ན་ཤིང་ལ་མེ་བཞིན་ནོ།",
    "དང་པོས་བྱས་པའི་འགྱུར་བ་ཆུང་ཡང་ལྡོག་པ་མིན་ཏེ།",
    "ཉེར་ལེན་རྣམ་པ་གཞན་དུ་འགྱུར་བ་མེད་པར་ནི་ཉེར་ལེན་ཅན་དག་འགྱུར་བར་ནི་བྱེད་པར་མི་ནུས་ཏེ།",
    "དཔེར་ན་འཇིམ་པར་འགྱུར་བ་མེད་པར་རྫ་བུམ་སོགས་བཞིན་ནོ།",
    "དེ་ཉིད་ལོག་པའི་སྒོ་ནས་སྟོན་པ་ནི་དངོས་གང་འགྱུར་བ་མེད་པར་ནི་དངོས་པོ་གང་ཞིག་རྣམ་འགྱུར་བ་དེ་དེའི་ཉེར་ལེན་དུ་མི་རིགས་ཏེ་བ་ལང་བ་མིན་ལ་སོགས་བཞིན་ནོ།",
    "དེའི་ཕྱིར་ལུས་སེམས་ཀྱི་ཉེར་ལེན་ཡིན་པར་མི་འཐད་དོ།",
    "འོ་ན་བ་ལང་དང་བ་མིན་བཞིན་དུ་ལུས་སེམས་ཚོགས་པ་གཅིག་ཏུ་ཡང་མི་གནས་པར་འགྱུར་རོ་ཞེ་ན།",
    "གཉིས་པ་བློ་ལུས་ཀྱི་ཡོན་ཏན་ཡིན་པའི་སྒོ་ནས་ལུས་སེམས་དུས་མཉམ་པའི་རྟེན་དང་བརྟེན་པར་འདོད་པ་དགག་པ་ལ།",
    "དེས་རིགས་ཅན་གཞན་ཡང་ཁེགས་པར་བསྟན།",
    "གྲུབ་ཟིན་མི་འཇིག་པར་ཡོད་པའི་གནས་རྒྱུ་ནི་དུས་མཉམ་པའི་རྟེན་ཡིན་ནོ་ཞེ་ན།",
    "ད་ནི་ཡིད་བློ་མི་འཇིག་པའི་རྟེན་ཡིན་པར་དགག་པར་བྱ་སྟེ།",
    "གྲུབ་ཟིན་ལུས་ཀྱིས་མི་འཇིག་པར་བྱས་པའི་ཕྱིར།",
    "གལ་ཏེ་དེ་འཇིག་རྒྱུ་ལས་འཇིག་པར་འདོད་པས་རྟག་པ་མིན་ནོ་ཞེ་ན།",
    "འཇིག་རྒྱུ་དང་མ་ཕྲད་ན་གྲུབ་ཟིན་མི་འཇིག་པར་གནས་པས་གནས་རྒྱུ་གཞན་མི་དགོས།",
    "ཕྲད་ན་གནས་པར་བྱེད་མི་ནུས་པར་འཇིག་པའི་ཕྱིར།",
    "འཇིག་རྒྱུ་དང་མ་ཕྲད་པར་ཡང་འཇིག་པ་སྲིད་པའི་ཕྱིར།",
    "གཉིས་པ་དེས་རིགས་ཅན་གཞན་ཡང་ཁེགས་པར་བསྟན་པ་ནི།",
    "གསལ་བ་ལ་སོགས་པ་ལ་བརྟེན་ནས་རིགས་ལས་སོགས་པ་གྲུབ་ཟིན་རྣམ་པར་གནས་པ་ཉིད་ཡིན་པ་བསལ་བ་ཡིན་ཏེ།",
    "གལ་ཏེ་ཕྱིས་རྒྱུ་གཞན་ལས་དངོས་པོ་དེ་འཇིག་ན་དེའི་མི་འཇིག་པར་གནས་པའི་རྒྱུས་ཅི་ཞིག་བྱ་ཞིང་།",
    "ཕྱིས་རྒྱུ་དོན་གཞན་དེ་མེད་པར་འཇིག་ན་ཡང་གནས་པའི་རྒྱུ་རྣམས་ནུས་པ་མེད་པ་ཡིན་ཏེ།",
    "དེ་གཉིས་ཀ་ལའང་གནས་རྒྱུས་གནས་པར་བྱེད་མི་ནུས་པར་འཇིག་པའི་ཕྱིར་རོ་ཞེས་པས་འཇིག་ན་གནས་རྒྱུས་གནས་པར་བྱེད་པ་བཀག་ནས།",
    "རྟག་དངོས་ཀྱི་རྟེན་བཅས་ཐམས་ཅད་མི་འཇིག་པར་གནས་པ་དང་ལྡན་པས་ཁྱབ་པའི་ཕྱིར།",
    "གལ་ཏེ་རང་འཇིག་ངང་ཚུལ་དག་ཡིན་ན་དེ་མི་འཇིག་པར་གནས་པར་བྱེད་པའི་རྒྱུ་དོན་གཞན་གང་སྟེ་དེས་མི་འཇིག་པར་བྱེད་མི་ནུས་ལ།",
    "དེའི་ཕྱིར་ལུས་ཡིད་བློ་གྲུབ་ཟིན་མི་འཇིག་པར་གནས་པའི་རྟེན་དུ་དགོས་ནུས་མེད་དོ།",
    "ལུས་ཞིག་པ་ན་ལུས་ལ་བརྟེན་པའི་རྣམ་པར་ཤེས་པ་ཡུལ་ལ་གནས་པ་ཡང་འཇིག་པར་འགྱུར་རོ།",
    "ལུས་ཀྱི་ཕུལ་དུ་བྱུང་བ་དང་འགྲིབ་པ་ལ་ལྟོས་པ་མེད་པར་བློ་སྔ་མ་ཡི་གོམས་པ་ལ་སོགས་འདུ་བྱེད་པའི་ཁྱད་པར་གྱི་ཤེས་རབ་ལ་སོགས་པ་ཕུལ་དུ་བྱུང་བ་དང་འགྲིབ་པ་དག་ཏུ་འགྱུར་བ་ཡིན་ལ།",
    "བཅུད་ལེན་སོགས་ཀྱིས་ལུས་རྒྱས་པར་བྱས་པ་ལས་ཤེས་རབ་སོགས་ཁྱད་པར་དུ་འགྱུར་བ་ཡོད་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "དེ་ལས་ཀྱང་ཤེས་རབ་སོགས་འདི་ཅུང་ཟད་ཁྱད་པར་དུ་འགྱུར་བ་ཡོད་དེ།",
    "དེའི་ཕྱིར་དེ་ལྟ་བུ་སྲིད་པར་གྲུབ་པས་ཡིད་བློ་ལུས་ལ་དངོས་སུ་བརྟེན་པར་མི་འགྲུབ་བོ།",
    "གསུམ་པ་བློ་ལུས་ཀྱི་བདག་ཉིད་ཡིན་པའི་སྒོ་ནས་ལུས་ལ་བརྟེན་པར་འདོད་པ་དགག་པ་ནི།",
    "དེ་ཡང་རྒྱང་ཕན་འཕེན་ནི་ལུས་རྟག་པར་འདོད་པ་ཡིན་ལ་དེ་དང་བློ་རྫས་གཅིག་པའི་སྒོ་ནས་བློ་ལུས་ལ་བརྟེན་པར་འདོད་པ་ཡིན་ཞིང་།",
    "ལྷ་སྦྱིན་གྱི་ལུས་དང་ཡིད་བློ་ཐ་དད་མེད་པའི་ཕྱིར།",
    "ཕ་མའི་ལུས་བུའི་ཡིད་ཀྱི་ཉེར་ལེན་ཡིན་པར་སྨྲས་པ་ལ་འགལ་བ་སྟོན་པ་སྟེ།",
    "བདེ་བ་ཐོབ་པར་འདོད་པ་དང་སྡུག་བསྔལ་འདོར་བར་འདོད་པའི་སྲེད་པས་མངལ་ལ་སོགས་པའི་དམན་པའི་གནས་ཡོངས་སུ་ལེན་ཏེ།",
    "བདེ་བ་ཐོབ་པར་འདོད་པས་ཡིན་ན་སྡུག་བསྔལ་གྱི་གནས་རང་དགར་ལེན་པ་མི་འཐད་དོ་ཞེ་ན།",
    "དེར་མ་ཟད་བར་མ་དོར་འདའ་བ་ལ་སོགས་པའི་ཞུགས་འབྲས་ཀྱི་རྣམ་གཞག་ཐམས་ཅད་ཀྱང་ཆེས་ཉམས་པར་འགྱུར་རོ།",
    "ལུས་ཅན་ཡིན་ཡང་ཕྲ་བའི་ཕྱིར་ཞེས་པའི་འགྲེལ་པར་སྲིད་པ་བར་མ་དོའི་ལུས་ནི་ལས་ཀྱི་ནུས་པ་ལས་ཤིན་ཏུ་དྭངས་པ་ཉིད་དུ་སྐྱེས་པས་རྣལ་འབྱོར་བ་ཙམ་གྱིས་རྟོགས་པར་བྱ་བ་ཡིན་ནོ།",
    "དཔྱད་གསུམ་གྱིས་དག་པའི་ལུང་འབའ་ཞིག་ལ་བརྟེན་ནས་དཔག་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "ལྔ་པ་རྟེན་ལུས་ལ་རྣམ་པར་དཔྱད་པའི་སྒོ་ནས་ཡིད་ཤེས་ལུས་ཁོ་ན་ལས་སྐྱེ་བ་སྤྱིར་དགག་པ་ལ།",
    "འདིར་ཡན་ལག་ཅན་ཆ་མེད་འགོག་པའི་རིགས་པ་གསུངས་པ་འདི་དག་ཀྱང་།",
    "ན་ཀྱང་འདིར་དོགས་པའི་མཐའ་ཆོད་པར་བྱ་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཁས་ལེན་ཚུལ་བྱེ་བྲག་པ་དང་མཚུངས་ཀྱང་ཕྱོགས་སྔ་མ་རུ་རྒྱང་ཕན་འཕེན་འོང་བ་ཡིན་པར་ཤེས་པར་བྱ་ཞིང་།",
    "འདི་ཉིད་བྱེ་བྲག་པའི་འདོད་པ་འགོག་པ་ལ་ཁ་འཆམ་བྱས་ནས་འགོག་པའི་ཚུལ་ནི།",
    "ཅིག་ཤོས་ངེས་པར་ཡོད་པའི་ངེས་པ་གང་སྟེ་ངེས་པ་དེ་འདྲ་མི་འཐད་པས་འབྲས་བུ་ཡོད་པས་རྒྱུ་ཡོད་པར་སྒྲུབ་པ་མི་འཐད་པར་འགྱུར་རོ།",
    "མགོ་བོའི་ཡན་ལག་ཅན་དང་ལག་པའི་ཡན་ལག་ཅན་ལ་སོགས་པ་དག་སོ་སོར་མེད་པར་གཅིག་ཏུ་འགྱུར་ཏེ།",
    "ལུས་ཀྱི་རྡུལ་ཕྲན་དེའི་རྒྱུ་ཡིན་པ་འགོག་པའི་ཕྱོགས་གཉིས་གསུངས་ནས་ལུས་རགས་པ་ཆ་བཅས་དེའི་རྒྱུ་ཡིན་པ་འགོག་པའི་ཕྱོགས་མ་གསུངས་པ་ཡང་འདིར་ལུས་རྟག་དངོས་དེའི་རྒྱུ་ཡིན་པ་འགོག་པའི་སྐབས་ཡིན་ལ།",
    "རྟག་དངོས་ལ་ཆ་བཅས་ཀྱི་དོགས་པ་གཅོད་མི་དགོས་པས་མ་གསུངས་པ་ཡིན་ཏེ།",
    "གཞན་དུ་ན་མཐའ་མ་ལུས་པར་ཁེགས་པའི་དོགས་གཅོད་དུ་འགྱུར་རོ།",
    "ཡན་ལག་ཅན་གཡོ་ན་ཡན་ལག་ཀྱང་གཡོ་དགོས་པས་ལག་སོགས་གཅིག་གཡོ་ན་ཐམས་ཅད་དག་གཡོ་བས་ཁྱབ་པར་འགྱུར་བའི་ཕྱིར།",
    "གཞན་དུ་ན་གཡོ་བའི་ཡན་ལག་ཅན་གཅིག་དང་མི་གཡོ་བའི་ཡན་ལག་ཅན་གཅིག་ཐ་དད་དུ་གྲུབ་པར་འགྱུར་བས་ཡན་ལག་ཅན་ཆ་མེད་ཅིག་ཡིན་པ་ཉམས་སོ་ཞེས་པ་ནི་བྱ་བ་ལ་བརྟེན་པའི་འགལ་འདུའོ།",
    "ལག་པའི་ཡན་ལག་ཅན་ལྟ་བུ་གཅིག་གོས་ཀྱིས་བསྒྲིབས་པ་ན་རྐང་པའི་ཡན་ལག་ཅན་སོགས་ཐམས་ཅད་དག་བསྒྲིབས་པར་འགྱུར་བའམ་འོན་ཏེ་མ་བསྒྲིབས་ན་རྐང་པའི་ཡན་ལག་ཅན་མཐོང་བར་འགྱུར་ཏེ།",
    "དེའི་ཚེ་མ་བསྒྲིབས་པར་གནས་པའི་ཕྱིར་རོ།",
    "སྔོན་པོ་སྣང་བ་དང་དེ་མིན་པར་སྣང་བའི་ཡན་ལག་ཅན་ཆ་གཉིས་བྱུང་བའི་ཕྱིར་ཡན་ལག་ཅན་ཆ་མེད་གཅིག་ཡིན་པ་ཉམས་སོ་ཞེས་པ་སྟེ།",
    "དེས་རིགས་ཅན་གཞན་ཡང་ཁེགས་པར་བསྟན་པ་དང་།",
    "སྔ་མའི་གནས་སྐབས་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་དང་རྡུལ་ཕྲ་རབ་ཡིན་པའི་ཕྱིར་ཞེ་ན།",
    "དེའི་ཚེ་རྡུལ་ཕྲན་ཡིན་ཀྱང་རྡུལ་ཕྲན་དུ་ཐ་སྙད་མི་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པར་འཆད་པ་དོན་མ་ཡིན་ནོ།",
    "གཉིས་པ་དེས་རིགས་ཅན་གཞན་ཡང་ཁེགས་པར་བསྟན་པ་ནི།",
    "དེ་མེད་ཀྱང་རྡུལ་ཕྲན་བསགས་པས་བྱ་བ་དེ་དག་བྱེད་པར་གྲུབ་པའི་ཕྱིར།",
    "ཡན་ལག་ཅན་དོན་གཞན་མེད་པའི་རྒྱུ་དུ་མས་འབྲས་བུ་གཅིག་བྱེད་མི་སྲིད་པར་ཁས་བླངས་པ་ཉམས་སོ།",
    "ཡོན་ཏན་ལ་ཡོན་ཏན་གཉིས་པ་མི་བརྟེན་པས་དེ་ལ་རིང་པོའི་ཡོན་ཏན་བརྟེན་པར་མི་འཐད།",
    "གཞན་ལ་དངོས་མིང་དུ་འཇུག་པའི་ཁྱད་པར་ཅི་ཞིག་ཡོད།",
    "དེས་ན་སྒྲ་རྟོག་ཐ་དད་འཇུག་པའི་རྒྱུ་རྫས་གཞན་ངེས་པར་དགོས་པ་མ་ཡིན་ཏེ།",
    "བུམ་པའི་རྡུལ་རྫས་བརྒྱད་པོ་དེ་ཡི་མཚུངས་པའི་འབྲས་བུ་ཆུ་སྐྱོར་བའི་རྒྱུན་མིན་པ་ནི་རྣམ་པར་གཅོད་པའི་ཚོགས་པ་ལ་བུམ་པ་ཞེས་བརྗོད་པའི་སྒྲ་དངོས་མིང་དུ་འཇུག་པར་འགྱུར་བའི་ཕྱིར།",
    "བུམ་པའི་སྒྲ་ནི་འཇུག་པར་འགྱུར།",
    "ཆུ་སྐྱོར་གྱི་དོན་བྱེད་ནུས་པ་ཡིན་ན་བུམ་པའི་སྒྲ་དོན་མཐུན་འཇུག་པས་ཁྱབ་པར་བསྟན་ལ།",
    "གཟུགས་སོགས་ནུས་པའི་ཁྱད་པར་ནི་ཞེས་པས་རང་འབྲས་མིག་ཤེས་ཀྱི་གཟུང་དོན་བྱེད་ནུས་པ་སོགས་ལ་གཟུགས་སོགས་ཀྱི་སྒྲ་འཇུག་པ་ཡིན་གྱི་བུམ་པའི་སྒྲ་འཇུག་པ་མིན་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "ཙན་དན་གྱི་དྲི་ཞེས་བརྗོད་པ་ལྟ་བུ་གཞན་ལའང་དེ་ཁོ་ན་བཞིན་དུ་མཚུངས་པར་བརྗོད་པར་བྱའོ།",
    "འོན་ཀྱང་ལུས་ཀྱི་རྡུལ་ཕྲན་ཡིད་བློའི་ཉེར་ལེན་ཡིན་ནོ་ཞེས་བྱ་བའི་ཕྱོགས་ལ་ད་དུང་ཁོ་བོ་ཅག་བརྟེན་པར་བྱེད་དོ་ཞེ་ན།",
    "གལ་ཏེ་ཉེར་ལེན་ལུས་ཀྱི་རྡུལ་དུ་མ་ཅིག་ཅར་ཉེ་ཡང་རྐྱེན་ཁྱད་པར་ཅན་དབུགས་དུ་མ་ཅིག་ཅར་མེད་པས་ཡིད་བློ་དུ་མ་ཅིག་ཅར་མི་སྐྱེ་བ་ཡིན་ནོ་ཞེ་ན།",
    "ནུས་པའི་ཁྱད་པར་འགྱུར་བ་མེད་པའི་ཕྱིར་རོ།",
    "རྣམ་མེད་དུ་ཤེས་ན་ཡིད་བློ་དེས་དོན་སྔ་ཕྱི་དུ་མ་དེ་ནི་ཅིག་ཅར་ཉིད་དུ་ཤེས་པར་འགྱུར་ཏེ།",
    "ཡུལ་གྱི་རྣམ་པ་འཆར་མི་དགོས་པར་དངོས་སུ་ཤེས་ན།",
    "ཡང་ན་རིམ་གྱིས་ཀྱང་ཤེས་པར་མི་འགྱུར་ཏེ།",
    "གཉིས་ཀའི་ཚེའང་རྣམ་པ་མ་ཤར་བར་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "དབུགས་ལ་དྲག་ཞན་ཡོད་པ་བཞིན་དུ་དེའི་ཚེ་ཤེས་པ་ལ་ཡང་གསལ་མི་གསལ་སོགས་ཀྱི་ཁྱད་པར་ཡོད་པར་འགྱུར།",
    "དེ་མ་ཐག་རྐྱེན་གྱི་ནུས་པ་མེད་པར་བྱས་ནས་དེའི་ཚེ་དོན་གཞན་སྒྲ་མི་འཛིན་པ་མཐོང་བའི་ཕྱིར།",
    "པས་སེམས་འབའ་ཞིག་ཤི་བའི་འོག་ཏུ་ཡན་གར་བར་གནས་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་ཚུལ་དེ་ལ་གནོད་བྱེད་མེད་པར་མ་ཟད་སྒྲུབ་བྱེད་ཡོད་པ་ཡིན་ཏེ།",
    "དེས་ན་ལུས་དང་དབུགས་ལ་སོགས་པ་ཡིད་བློའི་ཉེར་ལེན་མིན་པར་གྲུབ་པས།",
    "སྒྱུ་ལུས་དང་བྲལ་བའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པས་ཐ་མ་ནི་འཆི་ཁའི་སེམས་རྣམས་ཀུན་རིགས་འདྲ་ཕྱི་མ་མཚམས་སྦྱོར་བ་མེད་པར་འགྲུབ་པ་མིན་པ་དེའི་ཕྱིར་དང་།",
    "བརྩེ་བ་དང་ཤེས་རབ་ལ་སོགས་པ་གོམས་པར་བྱས་པ་ལས་ཅུང་ཟད་ཁྱད་པར་དུ་འགྱུར་ན་ཡང་ཚད་ཙམ་གྱི་རང་བཞིན་ལས་འདས་ནས་མཐའ་མེད་དུ་འཕེལ་བར་འགྱུར་བ་མིན་ཏེ།",
    "དཔེར་ན་མཆོངས་པ་གོམས་པས་ཅུང་ཟད་ཁྱད་པར་དུ་འགྱུར་ཡང་མཐའ་མེད་དུ་མི་འཕེལ་བ་དང་།",
    "ཆུའི་དྲོད་ཅུང་ཟད་ཁྱད་པར་དུ་འགྱུར་ཡང་མཐར་དམར་འབར་བར་འགྱུར་བ་མིན་པ་བཞིན་དུའོ་ཞེ་ན།",
