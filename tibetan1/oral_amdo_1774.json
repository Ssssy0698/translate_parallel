    "རེག་པ་དང་ད་ལྟར་བྱུད་བར་མ་སྦྱོར་མི་འབྱེད་དེ།",
    "རང་གི་མཚན་ཉིད་མེད་པ་ཉིད་དང་།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་དང་སྔོན་གྱི་མགྲྭར་མི་སྤྱོང་གི་འབྱེད་དེ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་དང་ཕྱི་མའི་མཐང་གི་སྦྱོར་མི་འབྱེད་དེ།",
    "བསམ་གཏན་རྣམས་དང་ད་ལྟར་བྱུང་བར་གི་སྤྱོད་པ་འབྱེད་དེ།",
    "ཕྱི་མའི་མཐད་གི་སྦྱོར་མི་འབྱེད་དེ།",
    "དེ་ནི་འདི་ལྟརེད་ལྟར་བྱུང་བ་ཉིད་ཀྱང་ཡང་དག་བར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "དལྟར་བྱུང་བར་གི་སྦྱོར་མི་འབྱེད་དེ།",
    "རེག་པ་དང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུས་སྦྱོར་མི་འབྱེདདོ།",
    "དེ་ནི་འདི་ལྟརི་རེག་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་སྟེ།",
    "དེ་དེ་ལྟར་མིག་གི་ཁམས་ཉིད་ཀྱང་ཡང་དག་པར་རྗེསས་མི་མཐོང་སྟེ།",
    "མིག་གི་ཁམས་དང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་སྦྱོར་བའམ།",
    "དེ་ནི་འདི་ལྟར་མིག་གི་རྣམ་པར་ཤེས་པའི་ཁམས་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་སྟེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པའི་ཁམས་དང་།",
    "ལྕེའི་ཁམས་དང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་གི་སྲོང་མི་འབྱེད་དེ།",
    "དེ་ནི་འདི་ལྟར་རེག་བྱའི་ཁམས་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུམ་སྦྱོར་མི་འབྱེད་དེ།",
    "དེནི་འདི་ལྟར་རུང་གི་ཁམས་ཉིད་ཀྱང་ཡང་དག་བར་རྗེས་སུ་མ་མཐོང་སྟེ།",
    "ང་གི་ཁམས་དང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་སྦྱོར་བ་འམ།",
    "དེ་ནི་འདི་ལྟར་རེག་པ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་སྟེ།",
    "རེག་པ་དང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་སྦྱོར་བ་བམ།",
    "ལེན་པ་དང་ཐམས་ཅད་མཁྱེནཔ་ཉིད་དུ་མི་སྦྱོང་གི་འབྱེད་དེ།",
    "དེ་ནི་འདི་ལྟར་འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མོ་མགྲོང་སྟེ།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པ་སོང་བ་ལ་དང་།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་མི་སྦྱོང་གི་འབྱེད་དོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་།",
    "དེ་ནི་འདི་ལྟར་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་སྟེ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དང་།",
    "སོས་ཡང་དག་པར་རེག་པ་རྣམས་དང་།",
    "ཚོར་བ་དངོས་པོ་མེད་ཅེས་བྱ་བར་སྦྱོར་རེ་འདུཤེས་དངོས་པོ་མེད་ཅེས་བྱ་བར་མི་སྤྲོངན།",
    "སྣ་དངོས་པོ་མེད་ཅེས་བྱ་བར་གི་སྐོར་རོ།",
    "རེག་དངོས་པོ་མེད་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་དངོས་པོ་མེད་ཅེས་བྱ་བར་མི་སེར་རེ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དངོས་པོ་མེད་ཅེས་བྱ་བར་མི་སྤྱོར་རོ། ། མིག་གི་འདུས་ཏེ་རེག་པ་དངོས་བ་ཡོད་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པ་དངོས་པོ་མེད་ཅེས་བྱ་བར་མི་སྲིདརོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མ་སྦྱོར་རོ།",
    "རྣ་བདེ་འདུས་ཏེ་རེག་པ་དངོས་པོ་མེད་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མེ་སྦྱོར་དེ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་དངོས་པོ་མེད་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མི་སྤྱིར་རོ།་",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་དངོས་པོ་མེད་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མི་སྤྱོད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་དངོས་པོ་མེད་ཅེས་བྱ་བར་མི་སྟེར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་དངོས་པོ་མེད་ཅེས་བྱ་བར་མི་སྤྱོད་རོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དངོས་པོ་ཡོད་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དངོས་པོ་མེད་ཅེས་བྱ་བུར་མི་སྦྱོར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དངོས་དེ་ཡོད་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "སྨྲ་བོའི་བདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་དངོས་པོ་མེད་ཅེས་བྱ་བར་ས་སྦྱོར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་བ་ཀྱིས་ཚོང་བ་དེངས་པོ་ཡོད་ཅེས་བྱ་བར་སྦྱོར་རོ།",
    "རེག་མི་རྟག་ཅེས་བྱ་བར་མེ་སྦྱོར་རོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་རྟག་ཅེས་བྱ་བར་མི་སྤྱིར་རོ། ། མིག་གི་རྣམ་པར་ཤེས་བ་མི་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར།",
    "ཡདེ་ཀྱི་རྣམ་པར་ཤེས་པ་མི་རྟག་ཅེས་བྱ་བར་མི་སྦྱོརརོ་མིག་འདུས་ཏེ་རེག་པ་རྟག་ཅེས་བྱ་བར་མེ་སྦྱོར་རོ།",
    "མིག་གི་འདུས་ཏེ་རེག་བ་མི་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་བ་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་མི་རྟག་ཅེས་བྱ་བར་མི་སྤྱིར་རོ།་།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་བ་རྟགཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏྲེ་རེག་པ་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "པདིཀྱི་འདུས་ཏེ་རེག་པ་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ཡུད་ཀྱི་འདུས་ཏེ་རེག་པ་མི་རྟགཅེས་བྱ་བར་མི་སྤྱོད་དོ།",
    "མིག་གི་འདུས་ཏེ་རེག་པའིརྐྱེན་གྱིས་དྲོར་བ་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིསཚོར་བ་རྟགཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་མི་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "སྣ་ལ་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ནོར་བ་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་མི་རྟག་ཅེས་བྱ་བར་མི་སྤྱིར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་རྟག་། ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་མི་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་རྟག་ཅེས་བྱ་བར་མི་སྤྲོར་རོ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་རྟག་ཅེས་བྱ་བར་མི་ཕྱིར་རོ།",
    "རྣམ་པར་ཤེས་པ་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རེ།",
    "རྣམ་པར་ཤེས་པ་མི་རྟག་ཅེས་བྱ་བར་མི་སྤྱིར་རེ།",
    "རེག་པ་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "རེག་བ་མི་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ཚོར་བམི་རྟགཅེས་བྱ་བར་མི་སྦྱོར་རེ།",
    "སྲིད་པ་མི་རྟག་ཅེས་བྱ་བར་ནི་སྦྱོར་རེ།",
    "རང་གི་མཚན་ཉིད་སྟོད་བ་ཉདེ་མི་རྟག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "མཚན་མ་མེད་པ་མི་རྟག་ཅེས་བྱ་བར་མོ་སྦྱོར་རོ།",
    "དགྲ་བཅོམ་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་མི་བྱེད་རེ།",
    "མགི་བདེའོ་ཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་བདེའོ་ཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "མག་གི་རྣམ་བར་ཤེས་བ་སྡུག་བསྔལ་ལོཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "སྣཔའི་འདུས་ཏེ་རེག་པ་སྡུག་བསྔལ་ཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་བ་དེའོཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་སྡུག་བསྔལ་ལ་ཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ཡད་ཀྱི་འདུས་ཏེ་རེག་པ་སྡུག་བསྔ་ལ་ལོ་ཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "མགེ་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེའོ་ཞེས་བྱ་བར་མི་སྤྱིར་རོ།",
    "མ་ག་གི་འདས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྡུག་བསྔལ་ལཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "རྣ་བ་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་རེ་ཞེས་བྱ་བར་མིསྦྱོར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་སཱའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེའོ་ཞེས་བ་བར་མི་སྟེར་རོ།",
    "མའི་འདས་རེག་ལེ་༤སྤྱིའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདེ་བོ་ཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྡུག་བསྔལ་ལོ་ཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ོལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཙརྒྱན་གྱིས་ཚོར་བ་བདེའོཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྡུག་བསྔལ་ལ་ཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་འདི་འོཞེས་བྱ་བར་མི་སྦྱར་རོ།",
    "འདི་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་སྡུག་བསྔལ་ལོ་ཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "སའི་ཁམས་བདེ་ཞེས་བྱ་བར་མི་སྦྱོར་རེད།",
    "རྒ་ཤི་བདེའོ་ཞེས་བྱ་བར་མི་སྤྲེར་རེ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཞེས་བད་ལོཞེས་བྱ་བར་མི་སྦྱོར་རེ།",
    "མཐར་གྱིས་གནས་པའི་སྙེམོས་པར་འཇུག་པ་དགུ་བདེའོ་ཞེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ཕྱིར་མི་འོང་བའི་འབྲས་བུ་སྡུག་བསྔལ་ལེ་ཞེས་བྱ་བར་རེ་སྦྱོར་རོ།",
    "ཁྱོརབ་བདག་ཅེས་བྱ་བར་མི་སྦྱོར་རེ།",
    "མགི་ཟདག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "རྣ་བ་བདག་མེད་ཅེས་བྱ་བར་མི་སྤྱོད་རེ་ས་བདག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལྕེ་བདག་མེད་ཅེས་བྱ་བར་མི་སྐྱ་རེ།",
    "པ་བདག་རེད་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ར་ག་གེ་འདུས་ཏེ་རེག་པ་བདག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "མག་གི་འདུས་ཏེ་རེག་པ་བདག་མེད་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "ལྟ་བའི་འདུས་ཏེ་རེག་པ་བདག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "རྣ་བའིའདུས་ཏེ་རེག་པ་བདགམེད་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་བདག་ཅེས་བྱ་བར་མི་སྦྱོར་རེར།",
    "འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདག་ཅེས་བྱ་བརམི་སྦྱོར་རོ།",
    "མག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདག་མེད་ཅེས་བྱ་བར་མི་སྤྱིར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདག་ཅེས་བྱ་བར་མི་སྲེར་རོ།",
    "རྣབའི་འདུས་ཏེ་རེག་པའེ་སྐྱེ་གྱིས་ཚོར་བ་བདག་ཅེས་བྱ་བ་ནི་སྦྱོར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་གྱིས་ཚོར་བ་བདག་ཅེས་བྱ་བར་མི་སྦྱོར་རོ།",
