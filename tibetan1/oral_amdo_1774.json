    "སེམས་ཀྱི་དམིགས་པ་ཞེ་ངན་ཅི་བྱས་པ་ཐམས་ཅད་ཁྱེད་རྣམས་ཀྱི་མི་མཁྱེན་ཅིང་མི་གཟིགས་པ་སྐད་ཅིག་ཀྱང་མེད་པས།",
    "བྱད་མ་གདུག་པ་ཅན་རྣམས་ནས་རྫས་སྔགས་ཏིང་འཛིན་རྦད་འདྲེ་རྦོད་གཏོང་ངན་གཡོ་འཕྲུལ་གསུམ་ཅི་དང་ཅི་བགྱིས་པ་ཐམས་ཅད་ལོ་ཟླ་ཞག་དང་ཟ་མ་མ་འགྱངས་པར་བྱད་མ་ལྷ་སྲུང་འཁོར་དང་བཅས་པ་ཐམས་ཅད་ཀྱི་སྟེང་དུ་རང་གཤེད་རང་ལ་བཟློག་ནས་ལུས་ངག་ཡིད་གསུམ་ཐལ་བའི་རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་གྱུར་ཅིག་རཾ་ཡཾ་ཁཾ་ཨོཾ་ཨཱ་ཧ་ཱུྃ།",
    "སྟེང་གི་སྤྱི་གཙུག་ནས་ཀྱང་འོད་གཟེར་བྱེ་བ་ཁྲག་ཁྲིག་ཁརྒྱ་སྟོང་དྲུག་བཅུདྲུག་བཅུ་བྱང་།",
    "རྔཤར་ཕྱོགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་གང་གའི་ཀླུང་གི་བྱེ་མ་སྙེད་སྣང་བ་ཆེན་པས་ཁྱབ་པར་བྱས་སོ།",
    "ལྡེ་ཡུགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའ་ཀླུང་གི་བྱེམསྙེད་སྣང་བ་ཆེན་པོས་ཁྱབ་པར་བྱས་སྲོ།",
    "བྱང་ཕྱོགས་སུ་འཇིགརྟེན་གྱི་ཁམས་གང་གའི་ཀླུང་གི་བྱེ་མ་སྙེད་སྣང་བ་ཆེན་པོས་ཁྱབ་བར་བྱས་ས།",
    "སུ་འཇིག་རྟེནགྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་སྣང་བ་ཆེན་པས་ཁྱ་བ་པར་བྱས་སོ།",
    "ཀ་སུའང་ད་ཀ་ལྟར་རེག་ན་བདེ་བར་གྱུར་པ།",
    "དེ་དག་ལ་ཕུགས་ཀྱི་འཇག་རྟེན་གྱི་ཁམས་གང་གའི་ཀླུང་གི་བྱམསྙེད་པ་ལ་ཀ།",
    "སྟེང་གི་ཕྱོགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་སྣང་བ་ཆེན་པོས་བྱ་བ་བར་བྱས་ས།",
    "འོད་དེས་གང་ལ་རེག་པར་གྱུར་པ་དེ་དག་ཐམས་ཅད་ཀྱང་།",
    "ལྷ་ཕྱོགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའ་ཀླུང་གི་བྱེ་མ་སྙེད་སྣང་བ་ཆེན་པོས་ཁྱབ་པར་བྱསས།",
    "བྱང་ཤར་གྱི་ཕྱོགས་འཚམས་སུ་ཁད་གདེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་སྣང་བ་ཆེན་པོས་ཁྱབ་པར་བྱསས།",
    "སྡོང་གི་ཕྱོགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་སྣང་བ་ཆེན་པོས་ཁྱ་བ་བར་བྱས་ས།",
    "བོད་དེས་གང་ལ་རེག་པར་གྱུར་པ་དེ་དག་ཐམས་ཅད་ཀྱང་།",
    "ཤར་ཕྱོགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་བང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེང་སྣང་བརྟེན་པས་ཁྱབ་པར་མཛད་ང་།",
    "ནུབ་བྱང་ག་ཕྱོགས་མཚམས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱང་།",
    "འོག་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱང་།",
    "སྟེང་ག་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱབ་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱང་།",
    "ཤར་ཕྱོགས་ཀྱི་ཁའཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱང་རབ་ཏུསྣང་བར་གྱུར་ཏོ།",
    "ཁྱུང་ལྷ་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གོང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱང་རབ་ཏུ་སྣང་བར་གྱུར་ཏེ།",
    "བྱང་ཤར་གྱི་ཕྱགསམཚམས་ཀྱི་འཇིག་རྟེན་གྱི་ལེགས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱང་ར་བ་རུསྣང་བར་གྱུར་ཏོ།་།",
    "སྟེང་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སེངོ་ཀྱང་རབ་ཏུ་སྣང་བར་གྱུར་ཏེ།",
    "ཤར་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཀྱ།",
    "དེནས་ཤར་ཕྱོགས་ལེགས་སུ་འཇུག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་འདས་པ་ཀུན་གྱི་ཕ་རོལན།",
    "བ་དན་དག་གིས་རིམ་གྲོར་བྱ་བ་དད།",
    "དེ་ནས་ལ་ཕྱོགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་གང་གའི་ཀླུང་གི་བེམསུད་འདས་པ་ཀུན་གྱི་ཕ་རོལ་ན།",
    "བུ་མོའི་གཟུགས་སུ་འདུག་པ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོད་དུ་མ་དད་འགྲོགས་ཏེ།",
    "བདན་དག་གིས་རིམ་གྲོར་བྱ་བ་དང་།",
    "དེ་ནས་བད་མེ་དེ་དག་གིས་འཇིག་རྟེན་གྱི་ཁིམས་དེ་དག་ཐམས་ཅད་རྒྱས་པར་ཁྱབ་པར་གྱུར་ཏེ།",
    "བུ་མོའི་གཟུགས་སུ་འདུག་བ་དེ་དག་གིས་ཀ་ཨ།",
    "དེནས་ནུབ་ཕྱོགས་ལོགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་གང་གའི་ཀླུང་གི་བྱམསྙེད་འདས་ཀུན་གྱི་ཕ་རོལ་ན།",
    "རིགས་ཀྱི་བུ་འདི་ནི་ཤར་ཕྱོགས་ལེགས་སུ་འཇིག་རྟེན་གྱི་ཁམས་གད་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་འདས་བ་ན།",
    "བུ་མོའི་གཟུགས་འདུག་པ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་དུམ་དད་འགྲོགས་ཏེ།",
    "བ་དན་དག་གིས་རིམ་གྲོར་བྱ་བ་དང་།",
    "བུ་མོའི་གཟུགས་སུ་འདུག་པ་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་དུ་མ་དང་འགྲོགས་ཏེ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་དགྲ་བཅོམ་པ་པད་དགཔར་རྫོགས་པའི་སངསརྒྱས་ཤཱཀྱ་ཐུབ་པས་པདམོ་དེ་དག་བཞེསནས།",
    "སྟེང་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམསགངྒའི་ཀླུང་གི་བྱེམསྙེད་པ་དེ་དགགི།",
    "ཁགཆགས་ཀྱི་མཚམས་སྦྱོར་བའི་ཉོན་མོདས་པ་ཐམས་ཅདཔྱོད་བར་འདོད་པའི་བྱ་དཆུབ་སེམས་དཔའ་སེམས་དཔའ་ཆེན་པོས་ཤེསརབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཝབཙན་པར་བྱེ་སྟེ།",
    "དང་འ་ཆེན་ནུབ་བྱང་གི་ཕྱོགསམཚམས་ཀྱི་འཇིག་རྟེནགྱི་ཁམསགངྒཱའི་ཀླུང་གི་བྱེམསླེད་དགོན།",
    "བ་དན་གཅིག་གིས་རིམ་གྲོར་བྱ་བར་འདོད་པ་དང་།",
    "དར་འ་ས་ནས་མས་དཔའཚན་པོ་འགགེ་ཕྱོགསཀྱི་འཇིགརྟེན་གྱི་ཁམས་གའི་ཀླུང་གི་བྱེ་མ་སྙེད་དགན།",
    "དཅིག་བཞུགས་པ་དེ་དག་ཐམས་ཅད་བསོད་ནས་གཅིག་གིས་ཁྱེད་པར་བྱ་བར་འདོད་པ་དང་།",
    "བྱངརབསེམས་རབ་སེམས་དཔའ་ཆེན་པོསྟེང་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམསགངྒའི་ཀླུད་གི་བྱེ་མ་སྙེད་དགན།",
    "ཇི་སྙེད་ཅིག་བཞུགས་བདེ་དག་ཐམས་ཅད་བསོད་སྙོམས་གཅིག་གིས་ཁྱེད་ངན་བྱ་བར་འདོད་པ་དང་།",
    "འདོད་པ་རྣམས་ནི་དུག་གི་ལམ་ལྟ་བུའོ།",
    "དེ་དག་གིས་མྱོས་པར་འགྱུར་བ་ཡང་མེད།",
    "ཤེས་རབ་ཀྱི་པཱརེལ་ཏུ་ཕྱིན་པ་ལ་སྤྱད་པར་བགྱི།",
    "འདི་ལྟ་སྟེ་འདུ་བྱེད་ཅེས་བྱ་བ་འདི་ཡང་མདེ་ཙམ་མོ།",
    "འགྲིབ་པ་མེད་པ་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པ།",
    "བདག་བདགཅེས་བྱ་བ་ནི་ཐ་སྙད་དུ་བརྗོད་མོད་ཀྱི།",
    "སྐྱེས་བུ་སྐྱེས་བུ་ཞེས་བྱ་བནི་ཐ་སྙད་དུ་བརྗོདམོདཀྱི།",
    "ཤེད་བདག་ཤེད་བདགཅེས་བྱ་བནི་ཐ་སཱད་དུ་བརྗོད་མོད་ཀྱི།",
    "བྱེད་པ་དེ་བྱེད་པ་པོཞེས་བྱ་བནི་ཐ་སྙད་དུ་བརྗོད་མོད་ཀྱི།",
    "ཚེར་བ་དེ་ཚོར་བ་དེ་ཞེས་བྱ་བནི་ཐ་སྙད་དུ་བརྗོད་མོད་ཀྱི།",
    "མིང་གང་གིས་ཐ་སྙད་དུ་བརྗོད་པའི་མིང་དེ་ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་སྟེ།",
    "བུ་རམཤིང་གི་ཚལ་ལམ།",
    "སྟོང་གི་ཆར་ཡང་ཉེབར་མི་འགྲེལ།",
    "བརྒྱ་ཕྲག་གང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "བྱེ་བ་ཁྲག་ཁྲིགསྟེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "ཁྲིག་བརྒྱ་ཕྲག་སྟོང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོ།",
    "མོ་འགལ་གྱི་བུ་ལྟ་བུ་ཤ་སྟག་གིས་ཡོངས་སུ་གང་བ་ལྟ་ཞོག་གི།",
    "བྱེ་བ་སེང་གིཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "བྱེ་བ་ཁྲག་ཁྲིགསྟོང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་ཕྲག་སྟོང་གི་ཆར་ཡང་ཉེ་བརམི་འགྲོའི།",
    "ཤ་ར་དྭ་ཏིའི་བུ་ཤར་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གྲང་གཱའིཀླུང་གི་བྱེ་མ་སྙེད་ཅིག་དགེ་སློང་ཤ་ར་དྭ་ཏིའི་བུ་དང་།",
    "མི་འགྲལ་གྱི་བུ་ལྟ་བུ་ཤ་སྟག་གིས་ཡོངསསུ་གང་བར་གྱུར་ཀྱང་།",
    "བྱེ་བ་སྟོང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "སྟེང་གི་ཆར་ཡང་ཉེ་བར་འགྲེའོ།",
    "བྱེ་བ་ཁྲག་ཁྲིག་སེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་ཕྲག་སྟེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "ཤར་དུ་ཏཱིའི་བུ་ཤར་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེམ་སྙེད།",
    "དགེ་སློང་ཤ་ར་དྭ་ཏིའི་བུདང་།",
    "མོ་འགལ་གྱི་བུ་ལྟ་ཤ་སྟག་གིས་ཡོངས་སུ་གང་བར་ལྟཞོག་གོ།",
    "ཤ་ར་དྭ་ཏིའི་བུ་གལ་ཏེ་ལྷོ་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཅིག།",
    "བྱེ་བ་སྟེང་གི་ཆར་ཉེ་བར་མི་འགྲོའོ།",
    "བྱེ་བ་བརྒྱ་ཕྲག་སྟེང་གི་ནར་ཡང་ཉེ་བར་མི་འགྲོ།",
    "བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་ཕྲགསྟོང་གིར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "ཤ་ར་དྭ་ཏིའི་བུ་ལྕེ་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གའི་ཀླུང་གི་བྱེ་མ་སྙེད།",
    "ཤ་ར་དྭ་ཏིའི་བུ་གལ་ཏེ་ནུབ་ཕྱོགས་ཀྱིའཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཅིག།",
    "དགེ་སློང་ཤ་ར་དྭ་ཏིའི་བུདྲང་།",
    "སོང་གིན་ཡང་ཉེ་བར་མི་འགྲེའོ།",
    "བརྒྱ་ཕྲག་སྟོང་གི་ཆར་ཡང་ཉེ་བརམ་འགྲོག།",
    "བྱེ་བ་སྟོང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲེལ།",
    "བྱེ་བ་བརྒྱ་བྲག་སྟེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲེའོ།",
    "ཤར་དུ་ཏིའི་བུནུབཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད།",
    "མེ་འགལ་གྱི་བུ་ལྟ་བུ་ཤ་སྟག་གིས་ཡོངས་སུ་གང་བལྟ་བཞེག་གི།",
    "ཤ་ར་དྭ་ཏིའི་བུ་གལ་ཏེ་བྱང་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེམ་སྙེད་ཅིག།",
    "སྟོང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲེའོ།",
    "བརྒྱ་ཕྲག་སྟེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲེའ།",
    "བྱེ་བ་བརྒྱ་ཕྲོག་སྟེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲེའོ།",
    "བྱེ་བ་ཁྲག་ཁྲིག་སྟེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་ཕྲག་སྟེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲེའོ།",
    "ཤ་ར་དྭ་ཏིའི་བུ་བྱང་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གའི་ཀང་གི་བྱེ་མ་སྙེད།",
    "དགེ་སློང་ཤ་ར་དྭ་ཏིའི་བུདང་།",
    "ཤ་རཏིའི་བུ་གལ་ཏེ་བྱང་ཕྱོགས་མཚམས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་ཅིག།",
    "མེའགལགྱི་བུ་ལྟ་བུ་ཤསྟག་གིས་ཡོངས་སུ་གང་བར་གྱུར་ཀྱང་དེ་དག་གི་ཤེས་བ།",
    "བརྒྱ་ཕྲགསེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "བྱེ་བ་ཁྲག་ཁྲིག་སྟེང་གི་ཆ་ཡང་ཉེ་བར་མ་འགྲེའོ།",
    "ཤ་ར་དྭ་ཏིའི་བུ་བྱང་ཤར་གྱི་ཕྱོགས་མཚམས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེ་མ་སྙེད།",
    "ཚེ་འགལ་གྱི་བུ་ལྟ་བུ་ཤ་སྟག་གིས་ཡོངས་སུ་གང་བ་ལྟ་ཞོག་གི།",
    "ཤ་ར་དྭ་ཏིའི་བུ་ཤར་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གང་གཱའི་ཀླུང་གི་བྱེམསྙེད་ཅིག།",
    "དེ་དག་གི་ཤེས་རབ་ཀྱིས།",
    "སྟེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "བརྒྱ་ཕྲགསྟེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "བྱེ་བ་ཁྲག་ཁྲག་སྟེང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲེའོ།",
