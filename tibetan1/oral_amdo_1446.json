    "ཉོན་མོངས་པ་དང་གཞན་མཐུན་པས།",
    "སྡིག་དང་ཉོན་མོངས་རྣམ་སྦྱོང་ཡིན།",
    "འབད་པ་མེད་ན་ངན་སོང་འགྲོ།",
    "རྟག་ཏུ་དྲན་པ་དང་ཤེས་བཞིན་དཔྱད་པར་བྱའོ་ཞེས་གང་གསུངས་པ་དེ་ལ་དྲན་པ་ནི་རང་གི་མིང་གིས་རང་གི་ངོ་བོ་བསྟན་ཏེ།",
    "དེའི་རང་གི་ངོ་བོ་བསྟན་པའི་ཕྱིར།",
    "སྦྱིན་པ་ནི་སྤྱིར་རྣམ་པ་གསུམ་མོ།",
    "དགེ་སློང་དག་དགེ་སློང་འདིས་ས་ཇི་ཙམ་ཞིག་ནོན་པའི་འོག་ཏུ་དཔག་ཚད་བརྒྱད་ཁྲི་བཞི་སྟོང་ན་གསེར་ལས་གྲུབ་པ་ལ་ཐུག་པའི་བར་ན་རྡུལ་ཕྲན་ཇི་སྙེད་ཡོད་པ་དེ་སྙེད་དུ་དགེ་སློང་འདིས་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་སྲིད་སྟོང་འགྱུར་དུ་ཡོངས་སུ་སྤྱོད་པར་འགྱུར་ཞེས་བྱ་བ་ནས་ཚེ་དང་ལྡན་པ་ཉེ་བ་འཁོར་གྱིས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེའི་ཕྱིར་བཟོད་པ་ནི་བཟོད་པ་སྟེ།",
    "ཉེ་བར་མ་ཞི་བ་ཉིད་ནི་རྟག་ཏུ་ཞེ་སྡང་གི་མེ་འབར་བའི་ཕྱིར་རོ།",
    "གང་གིས་ཁྲོ་བར་བྱེད་པ་ལ་བདེ་བ་ཐོབ་པ་ཉེ་བར་ཞི་བའི་རྒྱུ་དེ་ནི་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཇི་སྐད་དུ་གསུངས་པའི་རྣམ་པས་གང་གི་ཕྱིར་སྡུག་བསྔལ་སྐྱེད་པར་བྱེད་པ་དེའི་ཕྱིར།",
    "འདོད་པ་དང་མི་འདོད་པ་ནི་བདག་དང་བདག་གིར་འཛིན་པ་ལས་བྱུང་བ་སྟེ།",
    "བདག་དང་བདག་གི་ལ་བདེ་བ་བསྒྲུབ་པ་ནི་འདོད་པ་སྟེ།",
    "དེ་ལྟར་ན་ཟས་ནུས་པ་དང་ལྡན་པ་ཡིད་མི་བདེ་བ་ཉིད་ལ་བརྟེན་ནས་སྟོབས་ཡོད་པ་དང་ཞེ་སྡང་གིས་བདག་འཇོམས་སོ་སྙམ་དུ་ངེས་པར་བྱས་ནས་དེ་རྒྱས་པའི་རྒྱུ་ཉིད་དང་པོར་གཞོམ་པར་བྱའོ།",
    "གང་གི་ཕྱིར་བདག་ལ་གནོད་པ་མ་གཏོགས་པ་ཞེ་སྡང་གི་དགྲ་འདི་ལ་ཉིན་དང་མཚན་དུ་གཞན་ཅུང་ཟད་ཀྱང་བྱ་བ་མེད་དོ།",
    "གཞན་ཞིག་གིས་གནོད་པ་བྱེད་པ་ལ་ཇི་མི་སྙམ་པའི་བཟོད་པའོ་ཞེས་སོ།",
    "དེ་དག་གིས་ནི་ཡིད་མི་བདེ་ལ།",
    "གང་ནང་གི་མྱ་ངན་དང་སྨྲེ་སྔགས་འདོན་པ་དང་།",
    "དེ་བས་ན་གལ་ཏེ་བདག་གི་མགོ་གཅོད་ན་དེ་ལྟ་ན་ཡང་བདག་གིས་དགའ་བ་དཀྲུག་པར་མི་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་ལ་དགའ་ཞིང་མོས་པས་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་བརྗོད་དོ།",
    "དེ་ལ་སྡུག་བསྔལ་མི་བཟོད་པ་དེ་རེ་ཞིག་ཟློག་པར་བྱེད་པ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེའི་ཕྱིར་ཀྱེ་སེམས་སྡུག་བསྔལ་ཉམས་སུ་མྱོང་བར་བྱ་བའི་ཕྱིར་བརྟེན་པར་གྱིས་ལ་སྡང་བ་ལ་གནས་བརྟན་པར་མ་བྱེད་ཅིག།",
    "སྡུག་བསྔལ་ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོ་ཙམ་ཉམས་སུ་མྱོང་བར་བྱ་བའི་དངོས་པོ་གང་ཞིག་གོམས་པའི་སྤྱོད་ཡུལ་དུ་མི་འགྱུར་བ་དེ་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་ཏེ་ཐམས་ཅད་ནི་གོམས་པས་བདག་གིར་བྱ་བ་ནུས་སོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "རྩ་ལྕག་གིས་གཞུས་སམ།",
    "ལྕག་གིས་གཞུས་ཀྱང་བདེ་བའི་འདུ་ཤེས་ཉེ་བར་གནས་པ་དང་།",
    "དུག་གི་སྣོད་ལྟར་བདུགས་སམ།",
    "ཡང་གཞན་དུ་རང་གི་སེམས་བརྟན་པར་བྱ་བའི་ཕྱིར།",
    "སེམས་བཟེ་རེ་ཅན་ལ་ནི་སྡུག་བསྔལ་ཤིན་ཏུ་ཆེར་གནོད་པར་འགྱུར་ཏེ།",
    "འདི་ལྟར་སྐྱེས་བུ་དཔའ་བོ་ལ་ལ་གཡུལ་ངོའི་སར་བདག་གི་ཁྲག་མཐོང་ཡང་ལྷག་པར་དཔའ་བ་བརྟན་པར་བྱེད་དོ།",
    "གང་གི་ཕྱིར་ཉོན་མོངས་པའི་དགྲ་རྣམས་དང་ཐབས་ཅིག་ཏུ་གཡུལ་འགྱེད་པར་རྩོམ་པ་ན།",
    "གནོད་པ་ནི་མོད་པ་ཉིད་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ན་གཟུགས་དང་ལང་ཚོ་དང་ནོར་ལ་སོགས་པས་བྱས་པའི་དྲེགས་པ་སེལ་བར་བྱེད་དེ་ཉམས་པར་འགྱུར་བ་དང་།",
    "དེ་ལྟ་མོད་ཀྱི་དེ་དག་ལ་ནི་བདག་མི་ཁྲོ་སྟེ་སེམས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་དག་ཀྱང་སྔོན་གྱི་ལས་ལ་རག་ལས་པའི་ཕྱིར་རང་གི་རྒྱུ་ཚོགས་པ་རབ་ཏུ་འཁྲུགས་པར་གྱུར་པས་སྡུག་བསྔལ་བསྐྱེད་པ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་འདི་དག་ཐུན་མོང་དུ་རྒྱུ་དང་རྐྱེན་ལ་རག་ལས་པ་ཡིན་ནོ།",
    "རྐྱེན་རྣམས་ཚོགས་པ་དེ་དག་ཀྱང་རང་གི་འབྲས་བུ་བསྐྱེད་པ་ན་ལེགས་པར་བསམས་ནས་མི་སྐྱེད་དེ།",
    "དེས་བསྐྱེད་དེ་ཡང་སྟེ་འབྲས་བུ་ཡང་ཚོགས་པ་འདི་དག་གིས་བསྐྱེད་དོ་ཞེས་སེམས་པ་ཡིད་ལ་བྱེད་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དེ་ཉིད་ནི་རང་ཉིད་དེ།",
    "གང་གི་ཕྱིར་མ་སྐྱེས་པར་ནི་དེ་སྟེ་གཙོ་བོ་ལ་སོགས་པ་སྔ་ནས་ཡོད་པ་མ་ཡིན་པ་ཉིད་ཡིན་ལ།",
    "མེད་པ་ཡང་མོ་གཤམ་གྱི་བུ་ལ་སོགས་པ་ལྟ་བུ་ཡིན་ན་སྐྱེ་བར་འདོད་པར་གྱུར་པ་གང་ཡིན།",
    "ཡོངས་སུ་འགྱུར་བ་དང་གསལ་བའི་གནས་སྐབས་དེ་དེའི་རང་བཞིན་ཡིན་ན་དེ་ཡང་སྐྱེ་བར་ཐལ་བར་འགྱུར་རོ།",
    "གང་གི་ཚེ་འདི་གཙོ་བོས་གཏད་པའི་ཡུལ་ལ་ལོངས་སྤྱོད་པའི་ཕྱིར་འཇུག་པ་ཡིན་ནོ་ཞེས་འདོད་ན།",
    "ལྡོག་ན་ཡང་མི་རྟག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་གིས་ན་རྐྱེན་གཞན་དང་ཕྲད་པ་དེ་ལ་བྱ་བ་རྣམ་པར་འཇོག་པར་བྱེད་པ་ཡིན།",
    "གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གི་ཕྱིར་ཐམས་ཅད་བརྟེན་ནས་སྐྱེས་པ་དེའི་ཕྱིར་མི་མཛའ་བ་དང་ཅིག་ཤོས་གནོད་པ་བྱེད་པ་རྐྱེན་ལས་གྱུར་ཏོ་ཞེས་བདེ་བ་ཉིད་དུ་དམིགས་པར་བྱའོ།",
    "གྱོ་མོ་དང་།",
    "བགྲོད་པར་བྱ་བ་མ་ཡིན་པ་གཞན་གྱི་བུད་མེད་དང་ནོར་ལ་སོགས་པ་ཐོབ་པར་འདོད་པའི་དོན་དུའོ།",
    "ཉོན་མོངས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "ཤ་ཟ་བཞིན་དུ་ཉོན་མོངས་པས་སྨྱོ་བར་བྱས་པ་གནོད་པ་བྱེད་པ་དེ་དག་རང་ལ་གནོད་པའམ།",
    "དེ་ལྟར་ཡང་རང་གི་སེམས་བཟློག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེའི་ཚེ་ཁྱོད་ཀྱི་རང་བཞིན་ལ་ནི་ཅི་སྟེ་གཞན་ལ་གནོད་པ་བྱེད་ཅེས་བརྒལ་ཞིང་བརྟག་པར་མི་རིགས་སོ་ཞེས་ཡོངས་སུ་བརྟགས་ནས་བྱ་སྟེ།",
    "དེ་དག་ལ་བདག་གིས་ཞེ་སྡང་བར་མི་རིགས་ཏེ།",
    "གཞན་དུ་དེ་མེད་ན་དེའི་རང་བཞིན་ཉིད་ཉམས་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བདག་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གནོད་པ་དེ་ནི་བདག་གི་ལས་ཀྱི་འབྲས་བུ་སྨིན་པའི་ཕྱིར་རོ་སྙམ་དུ་དགོངས་པའོ།",
    "གང་ཞིག་གང་གི་རྒྱུ་ཡིན་པ་དེ་ལས་དེ་འབྱུང་སྟེ།",
    "འདི་ལྟར་གནོད་པ་བྱེད་པ་དེའི་མཚོན་རལ་གྲི་ལ་སོགས་པ་དང་བདག་གི་ལུས་ཏེ།",
    "བདག་གིས་ཤུ་བ་སྨིན་པ་ལུས་ཀྱི་རྣམ་པ་འདི་བཟུང་བ་སྟེ།",
    "དེའི་ཕྱིར་ན་རང་གི་ལུས་ཀྱི་སྡུག་བསྔལ་གང་ཡིན་པ་དེ་ནི་རང་གི་ཉེས་པ་ལས་གྱུར་པ་འདི་ཡིན་ནོ།",
    "བདག་ཉིད་ལ་གནོད་པའི་དོན་དུ་རང་གིས་མཚོན་བྱ་འདུས་བྱས་པ་ལྟ་བུ་ཡིན་པས་གཞན་ལ་བདག་ཁྲོ་བ་མི་རིགས་སོ་ཞེས།",
    "ནགས་ཚལ་དེ་ན་གནས་པའི་བྱ་རྒོད་དང་འུག་པ་དང་ཁྭ་ལ་སོགས་པའི་བྱ་རྣམས་ཇི་ལྟ་བ་བཞིན་དུ་རང་གི་ལས་ཀྱིས་བསྐྱེད་པ་སྡུག་བསྔལ་གྱི་རྒྱུར་གྱུར་པ་སྟེ།",
    "རང་གི་ལས་ཀྱིས་འདི་བསྐྱེད་པ་ཡིན་པས་གང་ཞིག་ལ་ཁྲོ་བར་བྱ།",
    "བདག་གི་ལས་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གི་བདག་གི་ལས་ཀྱིས་བསྐུལ་བྱས་ནས་ཏེ།",
    "ང་ནི་འདི་དག་གིས་མ་བརླག་གོ།",
    "གལ་ཏེ་ཁྱོད་གནོད་པ་བྱེད་པ་མ་ཡིན་ནམ།",
    "སླར་གནོད་པ་བྱེད་པ་ལས་ལོག་པའི་མཐར་ཐུག་པ་དེ་དག་ནི་བདག་གི་བསམ་པའི་ཆེ་བའི་བདག་ཉིད་ཡིན་ཏེ།",
    "རེ་ཞིག་བདག་ཉིད་གཅིག་པུས་ཁྱེད་ཅག་གཞན་ནི་མ་བསྲུངས་ལ།",
    "དེ་དག་གིས་དེ་དག་གི་ཡོན་ཏན་དང་སྐྱོན་ལ་ཅུང་ཟད་ཀྱང་ལྷག་པའམ་མ་ཚང་བར་འགྱུར་བ་མེད་དོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་ཁྱོད་ཀྱི་བདག་ཉིད་བསྲུང་བ་ཡང་མི་རིགས་པ་ཡིན་ཏེ་ཕན་འདོགས་པ་བྱས་པ་ཤེས་པའི་ཕྱིར་རོ་ཞེས་དོགས་པ་ལ།",
    "བརྡེགས་ཀྱང་བདག་གིས་སླར་བརྡེག་པར་མི་བྱ་བ་དང་།",
    "གང་གི་ཕྱིར་འདི་ནི་ལུས་ལ་ཅུང་ཟད་ཀྱང་གནོད་པ་བྱེད་པར་མིན་པ་དེའི་ཕྱིར་ན་སེམས་ཁྱོད་རྒྱུ་ཅིའི་ཕྱིར་ཁྲོ་བར་བྱེད།",
    "འོན་ཏེ་གལ་ཏེ་བརྙས་པ་ལ་སོགས་པ་ལ་ལུས་ལ་གནོད་པར་བྱེད་པ་མ་ཡིན་མོད་ཀྱི།",
    "དེ་ལྟ་མོད་ཀྱི་འདི་དཔྱད་པར་བྱའོ།",
    "གང་གི་ཕྱིར་འཇིག་རྟེན་མ་དད་པ་དེ་ལ་བདག་མི་དགའ།",
    "བདག་གི་རྙེད་པ་འདི་ཉིད་དུ་ཡང་ཉི་མ་སོ་སོར་ངེས་པར་འདོར་ཏེ།",
    "རྙེད་པ་གང་ཡིན་པ་དེ་མེད་པས་ཉི་མ་འདི་ཉིད་དུ་བདག་ཤི་བ་ནི་རུང་གི་གཞན་ལ་གནོད་པ་བྱས་པའི་སྒོ་ནས་རྙེད་པ་རྙེད་པས་ལོག་འཚོ་ཡུན་རིང་ནི་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་འཚོ་བའི་མཐའ་ནི་འཆི་བ་ཡིན་ནོ་ཞེས་གསུངས་པས་དུས་མང་པོ་ཞིག་ཏུ་འཚོ་ཡང་ངེས་པར་འོངས་པར་འགྱུར་རོ།",
    "འདི་དག་གིས་ཀྱང་ཁྱད་པར་མེད་པ་ཡིན་ནོ་ཞེས་ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱིས་བསྟན་པ།",
    "འདི་དག་གིས་ཀྱང་རྙེད་པ་དང་མ་རྙེད་པ་ལ་ཁྱད་པར་འགའ་ཡང་མེད་དོ་ཞེས་བསྟན་པ།",
    "རྐེད་པའི་སྲད་བུ་ཙམ་ཡང་མ་ལུས་པས་སྒྲེན་མོ་སྟེ།",
    "ཇི་སྟེ་འདི་ལྟར་ཇི་ཞིག་ལྟར་དུས་ཡུན་རིང་པོ་དེ་སྲིད་དུ་རྙེད་པས་འཚོ་བར་འགྱུར་ན་དེ་ཙམ་ཞིག་བདག་གི་དགོས་པ་ཡིན་ནོ་ཞེ་ན།",
    "གང་གི་དོན་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འོ་ན་དེ་ལྟ་མོད་ཀྱི་རྙེད་པའི་བར་ཆད་བྱེད་པའི་ཕྱིར་བདག་ལ་བསྔགས་པ་མ་ཡིན་པར་སྨྲ་བ་རྣམས་ལ་ཁོང་ཁྲོའི་སེམས་སྐྱེ་བ་ནི་མ་ཡིན་ཏེ།",
    "ཁྱོད་བཟོད་ན་ནི་བཟོད་པ་སྐྱེ་ནའོ་ཞེས་རང་གི་སེམས་ཉིད་ལ་འདྲི་བའོ།",
    "ཉོན་མོངས་སྐྱེ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "གལ་ཏེ་ཁྱོད་མ་དད་པ་གཞན་ལ་རག་ལས་པ་གང་ཡིན་པ་དེ་ལ་བཟོད་པ་ཡིན་ན།",
    "དེ་རྣམས་ལ་བདག་གི་ཞེ་སྡང་མི་རིགས་སོ།",
    "དེ་བས་ན་སྐུ་གཟུགས་ལ་སོགས་པ་འཇིག་པར་བྱེད་པ་རྣམས་ལ་ཞེ་སྡང་གི་སེམས་བསྐྱེད་པར་མི་བྱའོ།",
    "དེ་བས་ན་གང་ཞིག་གང་གི་སྐྱེ་བའི་གནས་ཡིན་པ་དེ་ནི་དེ་ཉིད་དུ་འབྱུང་གི།",
    "དཔེར་ན་འདམ་བུ་འདམ་སྐྱེས་འབྱུང་གི་སྐམ་ལ་ནི་མ་ཡིན་པ་ལྟ་བུའོ།",
    "ད་ནི་གཉི་ག་ལ་ཡང་ཐུན་མོང་དུ་སུན་དབྱུང་བའི་ཕྱིར་སུ་ལ་ཡང་ཁྲོ་བར་མི་རིགས་སོ་ཞེས་བརྗོད་པར་བྱ་བའི་ཕྱིར།",
    "དབྱུག་པ་ལ་སོགས་པས་བརྡེག་པའམ་བརྒྱད་བཀག་སྨྲ་བའི་ཉེས་པ་དེ་རང་གིས་བྱས་པ་ཡིན་ཏེ།",
    "རང་གིས་བྱས་པའི་ལས་དང་འབྲས་བུའི་འབྲེལ་པ་མི་གཉེར་བ་སྟེ།",
    "འདི་དག་གཉི་ག་ཡང་ཐུན་མོང་དུ་ཉེས་པ་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཡང་བདག་གི་ཚུལ་ཉིད་ལ་བསམས་ཏེ་ཁོང་ཁྲོའི་སེམས་བཟློག་པར་བྱའོ་ཞེས་གསུངས་པ།",
    "གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་གང་གི་ཕྱིར་ཏེ།",
    "ཅི་སྟེ་དེ་བཞིན་དུ་འབྲས་བུ་དེ་དག་གི་རྒྱུའི་ལས་བྱས།",
    "གང་གིས་ཞེས་བྱ་བ་འདི་ནི་འཇིག་རྟེན་པའི་སྨྲ་བའི་ཚུལ་ལོ།",
    "ཡང་ན་གང་གི་ཕྱིར་ལས་ལ་ནུས་པ་ཡོད་པའི་རྒྱུས་འཁྱལ་བ་དང་།",
    "དེ་ལྟ་ན་དེའི་འབྲས་བུ་བཟློག་པའི་དོན་དུ་འདི་ལ་གཞན་དུ་བདག་གིས་བྱར་ཅི་ཡོད་སྟེ།",
    "འབྲས་བུ་བསྐྱེད་པ་ལ་ཕྱོགས་པའི་ལས་ལ་གང་གིས་ཀྱང་བཟློག་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "གང་གིས་རྣམ་པ་དེ་ལྟ་བུའི་ནུས་པ་ཐོབ་པར་བྱས་ནས་ཡང་དག་པའི་ལམ་དུ་ཞུགས་པར་གྱུར་པ་ན་ཐམས་ཅད་ཕན་ཚུན་གཅིག་ལ་གཅིག་བྱམས་པའི་སེམས་དང་ཕན་པ་དང་བདེ་བ་བསྒྲུབ་པ་ལ་བརྩོན་པར་འགྱུར་བའི་རྣམ་པ་དེ་ལྟ་བུས་བརྩོན་འགྲུས་བརྩམ་མོ།",
    "ཁྱིམ་དེ་ནས་ཁྱིམ་གཞན་དུ་མེ་སོང་ནས་གང་ན་རྩྭ་དང་ཤིང་ལ་སོགས་པ་ལ་མཆེད་པར་བྱེད་པ་འཕེལ་བར་འགྱུར་བ་ན་དེའི་ནང་དུ་ཆུད་པའི་རྫས་གཞན་དག་ཀྱང་ཚིག་པར་དོགས་པས།",
    "ཆགས་པའི་གནས་སུ་གྱུར་པའི་དངོས་པོ་དེ་དེའི་མོད་ལ་ནི་དུས་གཞན་དུ་མི་འགོང་བར་ཡོངས་སུ་དོར་ཏེ།",
    "གཞན་དུ་ན་ཁྱིམ་གཞན་དུ་སོང་བའི་དངོས་པོ་བཞིན་དུ་ཞེ་སྡང་གི་མེས་དེ་ཡང་སྲེག་པར་བྱེད་དོ།",
    "ཇི་སྟེ་བདག་གིས་སྡུག་བསྔལ་ཤིན་ཏུ་ཆུང་ངུ་ཡང་བཟོད་པར་ནུས་སོ་ཞེ་ན།",
    "ཁུ་ཚུར་དང་ཐལ་ལྕག་དང་བོང་བ་ལ་སོགས་པས་བསྣུན་པར་བྱས་པའི་སྡུག་བསྔལ་ཅུང་ཟད་ཙམ་ཡང་དེ་ལྟར་བཟོད་པར་ཏེ་བརྟེན་པར་མི་ནུས་ཤིང་མི་ལྕོགས་ན་དེ་འདིར་ཁྱོད་ལ་འདྲི་བར་བྱ་སྟེ།",
    "གཞན་ཡང་གལ་ཏེ་བརྟེན་པར་མི་ནུས་པ་དེ་ལྟར་ཡིན་མོད་ཀྱི་ཁྱོད་ཀྱིས་དེའི་རྒྱུའི་ལས་བྱས་པས་མི་འདོད་ཀྱང་སྡུག་བསྔལ་དུ་འབབ་པར་འགྱུར་གྱི་འབྲས་བུ་ཅུང་ཟད་ཀྱང་མི་འབྱུང་ལ།",
    "དབྱུག་པ་དང་བརྩལ་བ་ལ་སོགས་པའི་རྒྱུ་རྣམས་ཀྱིས་གཟིར་བ་བདག་གིས་མྱོང་བར་བྱས་ཀྱང་དེ་བཞིན་དུ་སྡུག་བསྔལ་ཉམས་སུ་མྱོང་བ་ཡང་བདག་གིས་རང་གི་དོན་མཐོང་བ་དང་མ་མཐོང་བའི་འབྲས་བུ་བསྒྲུབ་པའམ།",
    "བདག་གིས་ཕ་རོལ་དག་གི་དོན་ཕན་པ་དང་བདེ་བ་བསྒྲུབ་པའི་མཚན་ཉིད་མ་བྱས་སོ་སྟེ་མ་བསྒྲུབས་སོ།",
    "གཞན་གྱི་ཡོན་ཏན་ཐོས་པ་ན་ཕྲག་དོག་གི་དྲི་མ་བཀྲུ་བར་བྱ་བའི་ཕྱིར།",
    "ཡོན་ཏན་ལྷག་པ་ཡོད་པར་བསྟོད་པས་གལ་ཏེ་དགའ་བའི་བདེ་བ་འབའ་ཞིག་ཐོབ་ན་དེའི་ཚེ་ཀྱེ་ཡིད་ཁྱོད་ཀྱང་དེའི་ཡོན་ཏན་ཡང་དག་པར་བརྗོད་ནས་ཅི་སྟེ་དགའ་བའི་བདེ་བ་ཉམས་སུ་མྱོང་བར་མི་བྱེད།",
    "ཅིའི་ཕྱིར་དགོས་པ་མེད་པར་དེ་ལ་ཕྲག་དོག་གི་མེ་འབར་བས་རང་གི་རྒྱུད་བུད་ཤིང་ལྟ་བུར་བྱེད།",
    "ཁྱོད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འོན་ཀྱང་བསྟོད་པ་བྱེད་པའི་བདེ་བ་དེ་བདག་གིས་བསྟན་པར་མི་ནུས་སོ་ཞེ་ན།",
    "བདེ་འགྱུར་ཞེས་པ་ནི་དེ་ལྟ་བས་ན་དགོངས་པ་འདིས་ཁྱོད་གལ་ཏེ་གཞན་གྱི་ཡོན་ཏན་བསྟོད་པའི་དགའ་བ་ལས་བྱུང་བའི་བདེ་བ་གང་ཡིན་པ་འདི་མི་འདོད་ན་དེའི་ཚེ་ཤིན་ཏུ་དོགས་པར་ལྷུང་བར་འགྱུར་བ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དེས་ཀྱང་དེ་ལ་བདེ་བ་ཉིད་དུ་བསྒྲུབ་པར་འགྱུར་ཏེ།",
    "གཞན་ཡང་འདི་ནི་ཁྱོད་ཀྱི་ལོག་པའི་ལན་ཡིན་ནོ་ཞེས་བསྟན་པ།",
    "རང་གི་ཡོན་ཏན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་འགའ་ཞིག་ཁྱོད་ལ་ཡོན་ཏན་རྗོད་པར་བྱེད་ན་ནི་དེའི་ཚེ་གཞན་དེ་ལ་མི་འདོད་ཀྱང་བདེ་བར་འདོད་ལ་ཇི་སྟེ་གཞན་གྱི་ཡོན་ཏན་གྱི་རྗེས་སུ་བསྔགས་པ་བྱེད་པ་ནི་དེའི་ཚེ་ཕྲག་དོག་གི་དྲི་མ་དང་ལྡན་པའི་ཡིད་ཀྱིས་རང་གི་བདེ་བ་ཡང་མི་འདོད་བྱེད།",
    "གཞན་གྱི་བདེ་བ་ལྟར་རེ་ཞིག་ཞོག་ཅིག་ཅེས་བྱ་བ་ནི་འང་གི་སྒྲའོ།",
    "དེ་བས་ན་ཁྱོད་ཀྱི་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པ་ལ་ཕྲག་དོག་པ་ཉིད་ཡིན་ཏེ།",
    "གལ་ཏེ་ཁྱོད་བདེ་བ་འདི་མི་འདོད་ཅེས་གང་གསུངས་པ་དེ་ལ་ཁྱད་པར་སུན་འབྱིན་པ།",
    "ཡང་ན་དེ་ལྟར་གྱུར་མོད་བདག་གིས་བདེ་བ་དེ་མི་བཟོད་པ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཁྱོད་ཀྱི་གཉེན་གྱིས་འཚོ་བ་སྟེ།",
    "ཁྱོད་ཀྱི་བཟའ་ཡིས་འཚོ་བ་གང་ཡིན་པ་སྟེ་རྣམ་པ་དེ་ལྟ་བུའི་སྐྱེས་བུས་རྙེད་གྱུར་ན་སྟེ།",
    "གང་གི་ཕྱིར།",
    "བདག་གིས་དེ་རིང་སྐྱོབ་པ་ཐམས་ཅད་ཀྱི།",
    "དངོས་པོ་དེ་ཁྱོད་ལ་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཁྱོད་ལ་དགོས་པ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "གཞན་ཡང་རེ་ཞིག་འདི་ལྟར་ཡང་བརྟག་པར་བྱའོ་ཞེས་བསྟན་པ།",
    "འོན་ཏེ་གང་ལ་བརྟེན་ནས་འདི་དག་གི་དད་པ་སྐྱེ་བ་དེ་འགྲོ་བ་འདི་དག་བདག་ལ་མ་དད་པར་གྱུར་ཅིག་ཅེས་རང་གི་ཡོན་ཏན་དོར་བའམ།",
    "རྣམ་པ་གང་གིས་འདིར་ཁྱོད་མགུ་བར་མི་འགྱུར་བར་སྨྲོས་ཤིག།",
    "རྙེད་པར་འགྱུར་བ་འཛིན་པ་ལ་ཡང་ཀུན་ཏུ་དེ་ཁྱོད་ལ་མེད་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གནོད་པ་གང་གསུངས་པའི་ཕྱིར།",
    "འོན་ཏེ་བདག་ལ་ནི་མེད་པ་དེའི་ཚེ་གཞན་ལའང་བྱུང་བར་མ་གྱུར་ཅིག་སྙམ་སྟེ་དེ་དག་བདག་གི་རྒྱུ་ཡིན་ནོ་ཞེ་ན།",
    "དེའི་ཕྱིར་ཁྱོད་ནི་རང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་དགྲ་བོ་ཞེ་སྡང་གི་ཡུལ་དུ་གྱུར་པ་ལ་ཁྱོད་འདོད་པ་ཙམ་གྱིས་མི་དགའ་བ་མི་འདོད་པ་བྱུང་ཞིང་སྐྱེས་ན་རེ་ཞིག་དེ་ལ་མི་འདོད་པ་བྱུང་ཡང་གྱུར་མོད།",
    "ཁྱོད་ལ་དེ་ཙམ་ཞིག་གིས་ཅིར་འགྱུར།",
    "ཡང་གཞན་ལ་གྱུར་རུང་མ་གྱུར་རུང་བདག་གི་ཅུང་ཟད་དེ་ཙམ་ཞིག་གིས་དགོས་པ་ཡིན་ཞེས་གཞན་གྱི་བསམ་པའི་དོགས་པ་བསུ་བ།",
    "ཁྱོད་ཀྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "དེ་ལྟར་གྱུར་དུ་ཟིན་མོད་ཅེས་ཁས་བླངས་ནས་ཀྱང་བརྗོད་པར་བྱ་བ་ཡིན་པས་ན།",
    "ཉོན་མོངས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གི་ཕྱིར་འདི་ནི་སྟེ་རྣམ་པ་འདི་ལྟ་བུ་གཞན་ཕུང་ན་རུང་སྙམ་པའི་སེམས་མཆིལ་པ་མི་བཟད་གཟེ་བ་ཆེར་འཇིགས་པར་བྱེད་པའོ།",
    "ཉོན་མོངས་ཉ་བས་བཏབ་པའི་སྟེ།",
    "ཉོན་མོངས་པ་ཉིད་ཉ་བ་བཞིན་དུ་སྤྱོད་པ་ཡང་ཡིན་པས་ཉ་བ་སྟེ་དེས་བཏབ་པ་ནི་བཏབ་པའོ།",
    "རང་གི་དོན་དུ་འགྱུར་ན་ནི་འདི་དག་འགྱུར་ལ་རང་དོན་ཤེས་པ་ནི་ཤེས་རབ་དང་ལྡན་པ་སྟེ།",
    "གལ་ཏེ་རང་གི་དོན་ཤེས་པ་ཡིན་ན་ཡང་དེ་ལྟ་མོད་ཀྱི་རང་གི་དོན་ཤེས་པའི་ཐབས་མ་ཡིན་པའི་ཕྱིར་ལོགས་ཤིག་ཏུ་མ་བསྟན་ཏོ།",
    "ཡིད་བདེ་བ་ནི་སེམས་བདེ་བ་སྟེ་དེ་ཙམ་ཞིག་འདོད་ན་ནི་ཆང་དང་རྒྱན་པོ་དང་སྨད་འཚོང་མ་དང་གཞན་གྱི་བུད་མེད་ལ་སོགས་པ་བསྟེན་པར་བྱ་དགོས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་དེ་དག་བྱིས་པའི་རྩེད་མོ་དང་མཚུངས་སོ་ཞེས་ཉེ་བར་བསྟན་པ།",
    "བྱིས་པ་ཁ་ཅིག་རྡུལ་ལས་བྱས་པའི་ཁང་བུས་ཤིན་ཏུ་དགའ་ཞིང་ཡོངས་སུ་རྩེ་བ་ན་འགའ་ཞིག་གིས་དེ་བཤིག་པ་དང་།",
    "རང་གི་སེམས་ནི་སྡུག་བསྔལ་ཞུགས་པས་བྱིས་པ་བཞིན་སྣང་སྟེ།",
    "རྣམ་པར་དཔྱད་ན་འདིར་ཡང་བདག་གི་དངོས་པོར་གྱུར་པ་སུས་ཀྱང་བཤིག་པ་མེད་དོ་ཞེས་བརྟག་པར་བྱའོ།",
    "རེ་ཞིག་ཅེས་བྱ་བ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "སྒྲ་དེ་བདག་ལ་བསྟོད་སེམས་ཏེ་བདག་གི་བསྔགས་པ་བརྗོད་པའི་བསམ་པ་ཡོད་མི་སྲིད་དེ་དེ་མི་འབྱུང་ངོ།",
    "དེ་བས་ན་ཤས་ནི་གཞན་གྱི་རྒྱུད་ལ་ཡོད་པའི་དགའ་བ་དེ་དེ་ལས་ཅུང་ཟད་ཙམ་སྟེ་བདག་གིས་མི་འཐོབ་བོ།",
    "བདག་ཉིད་ཀྱང་དེ་ལྟར་བསྟན་པའི་རིམ་པས་མི་འཐད་ཅིང་འབྲེལ་པ་མེད་པས་དེ་དག་གི་ནི་བྱིས་པའི་རྩེད་མོ་འབའ་ཞིག་ཏུ་ཟད་དོ།",
    "དེ་དག་ཙམ་དུ་མ་ཟད་ཀྱི་འོན་ཀྱང་ཡོན་ཏན་ལྡན་ལ་ཕྲག་དོག་དང་སྟེ་བདག་གི་ཡོན་ཏན་ལྷག་པར་བྱའོ་སྙམ་པ་དེས་གཞན་གྱི་ཡོན་ཏན་སྦེད་པའི་ཕྱིར་རམ།",
    "གང་གི་ཕྱིར་བཟོད་པ་སྟེ་སྲོན་པ་དང་མཚུངས་ཤིང་མཉམ་པའི་དཀའ་ཐུབ་ནི་ལེགས་པར་སྤྱོད་པ་ཡོད་པ་མ་ཡིན་ན་སྟེ།",
    "སློང་མོ་པ་སློང་བར་བྱེད་པས་སྦྱིན་པའི་གེགས་བྱེད་པ་མ་ཡིན་པར་བརྗོད་དེ།",
    "གང་གི་ཕྱིར་དེ་ནི་སྦྱིན་པའི་རྒྱུ་ཉིད་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཕར་གནོད་པ་མ་བྱས་ན་སྟེ།",
    "གང་གི་ཚེ་ཇི་ཞིག་ལྟར་གནོད་པ་བྱེད་པ་དང་ཕྲད་ན་དེའི་ཚེ་ཁྱིམ་དུ་བྱུང་བའི་གཏེར་བཞིན་དུ་ངལ་བ་མ་བྱས་པར་ཐོབ་པའི་དགྲ་ལ་བདག་གིས་འདོད་པར་བྱའོ།",
    "རྣམ་པ་དེ་ལྟ་བུར་སྐྱེས་བུ་མཆོག་གི་དོན་ལ་གྲོགས་བྱེད་པ་ལ་བྱས་པ་ཤེས་པའི་ཕྱིར་བདག་ལེན་དུ་ཕན་གདགས་པར་རིགས་པ་ཡིན་ནོ་ཞེས་ཉེ་བར་བསྟན་པ།",
    "འདི་དང་བདག་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གི་ཕྱིར་དེ་ལ་འདིས་གྲོགས་སུ་བྱས་པས་རྒྱུ་ཉིད་ཡིན་གྱི་གེགས་མ་ཡིན་པ་དེའི་ཕྱིར་བདག་གིས་བཟོད་པ་གོམས་པར་བྱས་པ་དང་།",
    "དེ་ལ་རྒྱུ་གསུངས་པ་ནི་གང་གི་ཕྱིར་ཞེས་སོ།",
    "འོན་ཏེ་གཞན་དུ་གྱུར་མོད་ཅེ་ན།",
    "ཞེ་སྡང་གི་རྒྱུའི་དྲི་ཡང་མེད་དོ།",
    "ཞེ་སྡང་གི་སེམས་ལོག་པ་ལས་ནི་བཟོད་པ་ཞེས་བརྗོད་དེ།",
    "དེའི་ཕྱིར་གང་གི་བསམ་པ་ལ་བརྟེན་ནས་བཟོད་པ་སྐྱེ་བ་དེ་ནི་བཟོད་པའི་རྒྱུ་ཡིན་གྱི།",
    "དེ་ལྟ་བས་ན་ཚོགས་ལ་མཁོ་བའི་རྒྱུ་དག་ལ་རང་གི་ངོ་བོ་དཔྱད་པས་ཅི་ཞིག་བྱ་སྟེ།",
    "དེ་ལྟར་ཐུན་མོང་མ་ཡིན་པའི་ཡོན་ཏན་བརྗོད་ནས།",
    "ཡང་དེ་དག་གི་ཁྱད་པར་དུ་བྱེད་པ་གསུངས་པ།",
    "ཡོན་ཏན་རྣམས་ལ་གཙོ་བའི་ཕུང་པོ་གཅིག་པུ་མངའ་བའི་བཅོམ་ལྡན་འདས་གང་ཡིན་པ་དང་དེ་དག་གི་ཡོན་ཏན་ཤས་ཙམ་ནི་རྡུལ་ཕྲ་རབ་ཙམ་ཡང་སྟེ།",
    "ཡོན་ཏན་ཕྲ་མོ་ཡང་ཞེས་བྱ་བའི་དོན་ཏོ།",
