    "འདོགས་ཅན་བཞི་དང་རྗེས་འཇུག་བཅུ་ནི་རིམ་པ་བཞིན་མིང་གཞི་དག་གི་སྒྲ་གདངས་གཞན་དུ་སྒྱུར་བྱེད་དང་།",
    "དེ་དག་རང་རང་གི་འཇུག་ཡུལ་རྗེས་འཇུག་དག་ལ་སྦྱར་པ་དང་མ་སྦྱར་བའི་སྒྲ་རྩོལ་ལ་ཁྱད་པར་ཆེ་བ་དང་བཞི།",
    "བོད་ཡིག་ཚེག་ཁྱིམ་གཅིག་གི་བཀླག་གདངས་ནི་དེ་ཉིད་འགྲུབ་བྱེད་ཀྱི་ཡི་གེ་དུ་མ་ལྷན་འདུས་ཀྱི་སྒྲ་གདངས་དེ་རང་ཡིན་པ་ལས།",
    "རྗེས་འཇུག་ཡི་གེ་བཅུ་པོ་ནི་ཚེག་ཁྱིམ་གཅིག་གི་སྒྲ་གདངས་ཧྲིལ་པོའི་རྟེན་གཞི་རུ་མ་ཟད།",
    "མིང་མཐའི་ཆ་ཤས་དང་ཚིག་ཕྲད་དག་གི་འདྲེན་བྱེད་ཀྱང་ཡིན་པས།",
    "ཅིག་དངོས་ཤུགས་གང་རུང་དུ་མེད་པ་མི་སྲིད་པ་དང་གཅིག་མིང་རེ་རེ་ནས་ངེས་ཀྱང་ཚིག་གི་སྦྱོར་བ་ཕལ་ཆེ་བ་ནི་ཚིག་ཕྲད་ལའང་ལྟོས་པས།",
    "མིང་གི་སྒྲིག་རིམ་ནི་བསམ་བློ་གཏོང་རིམ་ལྟར་སྦྱར་ཞིང་།",
    "མིང་གི་སྔ་ཕྱི་ལ་གསལ་བྱ་གསལ་བྱེད་ཀྱི་ཁྱད་པར་གསལ་བས།",
    "མིང་གི་སྒྲིག་རིམ་ལས་དོན་གྱི་བསྟན་རིམ་རྟོགས་དགོས་པ་དང་བཞི།",
    "ཚིག་གི་ཆ་ཤས་སྔ་མ་སྔ་མ་མཐའ་ལ་བསྡུ་ཞིང་།",
    "སྐད་ཆ་ཞིག་གི་གྲུབ་ལུགས་ལ་ཞིབ་ཆ་ཇི་ལྟར་ཡོད་ན་བརྗོད་དོན་གྱི་ཞིབ་ཆ་དེ་ལྟར་ཆེ་ཞིང་།",
    "རང་རེའི་སྐད་ཆ་འདིའང་བརྗོད་དོན་སྟོན་པའི་ནུས་པ་ཆེས་ཆེར་འཕགས་པ་ཞིག་ཡིན་པ་ཤེས་པར་བྱའོ།",
    "དེང་གི་དུས་སུ་ཕྱི་ནང་དཔྱོད་ལྡན་འགས།",
    "བསྟན་བཅོས་དེ་ཡི་ཚིག་གི་སྦྱོར་བ་དང་།",
    "ཚིག་གི་རྩ་བ་ཕྲད་ཀྱི་སྦྱར་གཞི་དང་།",
    "མིང་གང་ཚིག་གི་དོན་གྱི་གཞི་མ་སྟེ།",
    "གི་སོགས་སྒྲ་ཡིས་མིང་གི་ངོ་བོ་དང་།",
    "གིས་སོགས་སྒྲ་ཡིས་བྱེད་པོ་སྒྲུབ་བྱེད་ན།",
    "གང་ཞིག་མིང་གི་ཐོག་མཐར་འབོད་བྱེད་ཀྱི།",
    "གི་སོགས་བསྟན་བྱ་འགལ་བའི་མིང་ལ་སྦྱོར།",
    "ཚིག་གི་སྦྱོར་ལུགས་ལས་བྱས་ཕྲད་ཀྱིས་མིན།",
    "ཐོབ་པ་ཐོ་བ་དོན་མཚུངས་བཙུན་མོ་དང་།",
    "བརྡ་སྤྲོད་རྩ་གཞུང་མཆོག་གི་དངོས་ཤུགས་ཀྱི།",
    "ཏིང་འཛིན་ཞི་ཉིད་རིག་ཅིང་གཟིགས།",
    "ཉོན་མོངས་ཚོགས་བཅོམ་མགོན་པོ་མཆོག།",
    "ཐོན་མིས་རྒྱ་གར་དུ་ལོ་ག་ཚོད་ལ་སྦྱངས་པ་བྱས་པ་རེད།",
    "ཐོན་མི་རྒྱ་གར་དུ་ཕར་ཚུར་འབྱོན་བཞུད་ཀྱི་ལོ་གཉིས་དང་བཅས་པས་ཁྱོན་བསྡོམས་ལོ་གྲངས་བདུན་ཕྱིན་པ་ཤེས་སོ།",
    "སློབ་དཔོན་ཐོན་མིས་བརྡ་སྤྲོད་པའི་བསྟན་བཅོས་བརྒྱད་བརྩམས་པ་གང་གིས་ཤེས།",
    "སུམ་ཅུ་པའི་བསྟན་བཅོས་འདི་ནི་དུས་རབས་གང་གི་ནང་ལ་བྱུང་བ་ཡིན།",
    "བོད་ཀྱི་སྔ་རབས་མཁས་པའི་གྲས་སུ་བསྟན་བཅོས་འདི་ཉིད་བཙན་པོ་སྲོང་བཙན་སྒམ་པོའི་སྐུ་དུས་སུ་སློབ་དཔོན་ཐོན་མི་སམྦྷོཊ་མཆོག་གིས་མཛད་པ་ལ་བཞེད་ལུགས་མི་མཐུན་པ་མེད་ཀྱང་།",
    "དེང་གི་དུས་འདིར་རྒྱལ་ཁབ་ཕྱི་ནང་གི་དཔྱོད་ལྡན་འགའ་རེས་བསྟན་བཅོས་འདིའི་ཚིག་སྦྱོར་དང་།",
    "གསུམ་དུ་ན་བསྟན་བཅོས་དེར་རྗེས་འདུག་བཅུ་པོ་མ་ཞུགས་ན་མིང་གི་སྦྱོར་བ་མེད་པར་བསྟན་པ་བཞིན་ཕྱིས་སུ་རིམ་གྱིས་ཉམས་པར་གྱུར་པ།",
    "ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་རིང་ལ་བཞེངས་པའི་ཀོང་པོ་དེ་མོའི་བཀའ་གཙིགས་སུ།",
    "ཞེས་པ་ལྟ་བུ་རྗེས་འཇུག་འ་མཐའ་ཅན་རེ་འགའ་བྱུང་ཡང་།",
    "ཁྲི་གཙུག་ལྡེ་བཙན་རིང་གི་རྡོ་རིང་དག་ཏུ་འ་མཐའ་གཅིག་ཀྱང་མ་བྱུང་བས།",
    "ལྔ་རུ་ན་སུམ་ཅུ་པ་རུ་དགག་སྒྲ་ལ་སྟྲཱི་ལིངྒ་ཞེས་བཏགས་པ་མིང་གི་ཡ་མཐར་སྦྱོར་བར་བསྟན་པ་བཞིན་མིན་སྒྲ་གནའ་བོའི་སྐད་ལ་མེད་པ།",
    "ཞེས་དགག་སྒྲའི་ཕྲད་གང་ཡིན་པ་དེ་ནི་མིང་དག་གི་ཐོག་མར་སྦྱོར་བར་བསྟན་པ་ལས།",
    "གནའ་བོའི་རྡོ་རིང་གིས་གཙོས་པའི་ཡིག་རྙིང་དག་ཏུ་མིན་སྒྲ་མེད་པར།",
    "གང་གི་སྐད་ཆའི་སྦྱོར་བ་གཞིར་བྱས་པ་ཤེས་ན།",
    "བསྟན་བཅོས་དེ་ཉིད་ཀྱི་བྱུང་དུས་ངང་གིས་གསལ་ཞིང་།",
    "ཚིག་གི་སྦྱོར་བ་ནི་གནའ་བོའི་བསྟན་བཅོས་གཞན་དག་ལ་འགྱུར་བཅོས་མཛད་པའི་དུས་སུ་དེའང་ཐག་ཞར་འབྲེང་འདྲུད་ཀྱི་དཔེ་བཞིན་སྐད་གསར་བར་བཅོས་ཀྱང་།",
    "ཁོང་གིས་བསྟན་བཅོས་འདི་དང་གཞུང་གཞན་པ་དག་གི་འབྲེལ་བ་ལ་བཞེད་དགོངས་ཅི་འཆིང་བ་མི་ཤེས་ཀྱང་།",
    "སི་ཏུ་མཆོག་གིས་ནི་ཕྱི་མའི་ལུགས་བཞིན་བཀྲལ་ཏེ།",
    "མོ་ཡི་ཡི་གེའི་ནང་ནས་ནི།",
    "ཅེས་པའི་དོན་རྣམས་སྔོན་དུ་མ་སོང་བར་གྲངས་ཀ་ཙམ་གྱིས་ཡི་གེ་རེ་རེ་བ་གསལ་བར་ཤེས་ཐབས་མེད་ཅིང་།",
    "རྟགས་འཇུག་གི་སྐབས་ཀྱི་རྟགས་ཀྱིས་དབྱེ་བྱའི་ཡི་གེ་དག་ངོས་འཛིན་ཐབས་མེད་པའི་ཁར།",
    "དེ་དག་གི་རྩ་བ་དབྱངས་གསལ་གཉིས་རྣམ་གྲངས་དང་བཅས་པ་ཞིབ་ཏུ་བསྟན་པའི་ཐོག་ཏུ།",
    "སུམ་ཅུ་པ་དང་དེ་དག་གི་འབྲེལ་བ་གླེང་ཐབས་བྲལ་ཀྱང་།",
    "སུམ་ཅུ་པ་ནི་རྟགས་འཇུག་གི་རྟེན་གཞི་ཡིན་པས།",
    "དེ་སྔར་བོད་དུ་ཡི་གེ་འབྲི་ཀློག་གི་སྲོལ་བྱུང་ཞིང་།",
    "ལྕེ་ཁྱི་འབྲུག་གི་སྒྲའི་གནས་བརྒྱད་རྩ་འགྲེལ་གཉིས།",
    "གནས་བརྒྱད་ཆེན་མོ་དང་།",
    "གལ་ཏེ་དཀར་ཆག་ཏུ་བསྡུས་པའི་བསྟན་བཅོས་གཞན་དག་གི་པར་གཞི་ནི།",
    "དུས་རབས་གང་ཞིག་གི་ནང་དུ་བསྒྱུར་ཅིང་བརྩམས་པར་མཛད་པ་བཞིན་བརྡ་རྙིང་གི་རྣམ་པར་གནས་ཤིང་།",
    "སུམ་རྟགས་གཉིས་ཀྱི་བསྟན་བྱ་དུས་རབས་གང་གི་སྐད་ཆའི་སྦྱོར་ལུགས་དང་མཐུན་མིན་ལ་དཔྱད་དེ།",
    "པཎ་ཆེན་ཤཱཀྱ་མཆོག་ལྡན་སོགས་མཁས་པ་ཆེན་པོ་བཅུའི་མཚན་རེ་རེ་བཞིན་བགྲངས་ཏེ་དེ་དག་གིས་མཛད་པའི་བསྟན་བཅོས་ཀྱང་ཡོད་པར་གསུངས་ཀྱང་།",
    "སུམ་ཅུ་པ་དང་རྟགས་ཀྱི་འཇུག་པ་གཉིས་ནི་འགྲེལ་པ་ཆེས་མང་བའི་བོད་ཡིག་གི་བསྟན་བཅོས་དག་ཡིན་པ་ཁོ་ནས་ཀྱང་བསྟན་བཅོས་འདི་དག་གི་འཕྲིན་ལས་གནའ་ནས་ད་བར་མ་ཉམས་ཤིང་།",
    "ལྔ་རུ་ན་བོད་ཡིག་གི་རྣམ་གྲངས་དང་སྦྱོར་ལུགས་གང་འདྲར་གནས་པ་རྟོགས་པ་དང་།",
    "བཅུ་རུ་ན་བོད་ཡིག་གི་ཡི་གེ་མིང་ཚིག་གསུམ་གྱི་འབྲེལ་བ་དང་དེ་དག་གིས་བརྗོད་དོན་སྟོན་ལུགས་ཀྱི་ཁྱད་པར་རྟོགས་པ་བཅས་ཀྱིས་གཙོས་པའི་ཕན་ནུས་མང་པོ་ཡོད་པས།",
    "རང་གི་ཚོགས་པ་ཐུན་མོང་པ་ལ་གྲུབ་པའི་སྐད་ཆ་བརྗོད་ཤེས་པ་དང་།",
    "དཔའ་རིས་བློ་གྲོས་རབ་གསལ་མཆོག་གི་ཞལ་ནས།",
    "སུམ་རྟགས་ལ་སོགས་གཞུང་གིས་ཅི་ཞིག་བགྱིད།",
    "ཅེས་པས་བསྟན་པ་བཞིན་རང་གི་ལྟོ་རྒྱབ་ཀྱི་འཚོ་བ་ཁོ་ན་དོན་དུ་གཉེར་པ་རྣམས་ལ་བརྡ་སྤྲོད་སོགས་རིག་པའི་གཞུང་ལུགས་བསླབ་མི་དགོས་ཀྱང་།",
    "མིང་གི་སྦྱོར་ལུགས་གཏན་དུ་ཆགས་པ།",
    "ངག་ནས་ངག་ཏུ་བརྒྱུད་ཅིང་ཡུལ་གྲུ་བྱེ་བྲག་པ་གཅིག་གི་སྐད་ཆ་ཁོ་ནར་བརྟེན་པའི་ངག་ཐོག་གི་རྩོམ་རིག་ལ་སུམ་རྟགས་ཀྱི་གཞུང་ལུགས་མ་ཤེས་ཀྱང་གནོད་པ་ཆེན་པོ་མེད་པ་བདེན་ཡང་།",
    "གནའ་དེང་གི་སྐད་ཆའི་གཟུངས་ཐག་ལྟ་བུར་གྱུར་པའི་བསྟན་བཅོས་འདི་རིགས་དང་།",
    "འདི་དག་གི་ལྷན་ཐབས་ལྟ་བུའི་བསྟན་བཅོས་གཞན་ལའང་སྦྱང་ན།",
    "ཞེས་པ་ལྟ་བུའི་དོན་ཞིབ་མོ་བསྟན་བཅོས་དེ་དག་རང་དུ་རྟོགས་ཐབས་བྲལ་པ་དང་།",
    "བཙན་པོའི་བཀའ་ལུང་ཡུལ་ལུང་གི་སྐད་ཆས་བཀག་རྒྱ་མེད་པར་ཀུན་ལ་ཁྱབ་པ་བཅས་ཀྱི་ཕྱིར་དུ།",
    "སུམ་ཅུ་པའི་རྩ་བར་ཚིག་ཕྲད་དག་གི་གྲུབ་ལུགས་དང་འཇུག་དོན་བསྟན་པའི་སྐབས་སུ།",
    "མིང་གང་གི་ནི་མཐར་སྦྱར་བ།",
    "གང་མིང་གི་ནི་ཡ་མཐའ་རུ།",
    "གང་མིང་གི་ནི་མ་མཐའ་ན།",
    "ཞེས་པ་སོགས་ཚིག་ཕྲད་གང་ཞིག་མིང་གི་སྔ་རྗེས་གང་ལ་སྦྱར་ནས་དོན་ཅི་ཞིག་སྟོན་པ་ལ།",
    "འབྱུང་ཁུངས་བཅས་སྔ་ཕྱིར་དཀྱུས་གཅིག་ཏུ་བསྟན་པའི་ཚིག་ཕྲད་དག་གི་སྐབས་སུ་ཚིག་དོན་གོང་འོག་གི་བརྗོད་འབྲེལ་ལས་དེ་དག་ཀྱང་མིང་ལས་གཞན་དུ་སྦྱར་ཡུལ་ཡོད་པ་མ་ཡིན་པ་དོན་གྱིས་བསྟན་ཕྱིར།",
    "གཉིས་སུ་ན་མིང་གི་འབོར་སུམ་ཅུ་པའི་སྐོར་གྱི་དྲི་བ།",
    "མིང་གང་གི་སྔོན་དང་རྗེས་ལ་སྦྱོར་ཐབས་རིགས་གཉིས་ཡོད་པ་གསལ་བར་བྱེད་པ་དང་།",
    "ལྔ་རུ་ན་ཚིག་ཕྲད་གང་ཞིག་ཅི་ལྟར་སྦྱོར་བ་མིང་གི་ཁྱད་པར་ལ་བལྟ་དགོས་ཕྱིར།",
    "དེ་ཕྱིར་དང་པོ་འདི་ཉིད་བསླབ་ཅེས་པ་ལྟར་མིང་གི་འབོར་གྲངས་ངེས་ཅན་ཞིག་ལ་བློ་འབྱོངས་པའི་རྗེས་སུ།",
