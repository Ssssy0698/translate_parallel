    "ཏ་ཡིག་གིས་གྲུབ་པ་ཏུ་ཏེ་ཏོ་ཏམ་དང་།",
    "དེང་གི་དུས་འདིར་ལྗར་པན་གྱི་མཁས་པ་ཁ་ཅིག་གིས་བསྟན་བཅོས་འདི་ནི་མི་གཅིག་གིས་མཛད་པ་མ་ཡིན་པར།",
    "གཅིག་ཏུ་ན་ཚིག་ཕྲད་ཀྱི་འབྱུང་གཞི་རྗེས་འཇུག་གི་ཡི་གེ་ཡིན་པར་བསྟན་པ།",
    "མིང་གང་གི་ནི་མཐར་སྦྱར་པ།",
    "ཞེས་པ་སོགས་ཚིག་ཕྲད་ཕལ་ཆེ་བའི་གྲུབ་ལུགས་རྗེས་འཇུག་གི་སྒོ་ནས་བསྟན་པ་ནི།",
    "བོད་སྐད་ཀྱི་ཚིག་ཕྲད་དག་ནི་མིང་སྔ་མའི་རྗེས་འཇུག་གི་སྒྲ་རིང་དུ་བསྲིངས་པ་ལ།",
    "མིང་དང་ཚིག་གི་སྦྱོར་བ་འཕྲད་བྱེད་ཀྱི་ཚིག་ཕྲད་དག་ནི་དུས་གཅིག་ལ་མཉམ་དུ་བྱུང་བ་མ་ཡིན་པར།",
    "ཐོག་མར་མིང་གང་ཞིག་གི་བསྟན་བྱ་རྫོགས་པར་བསྟན་དགོས་ན།",
    "མིང་དང་ཚིག་གི་ཁྱད་པར་བསྟན་བྱ་རྫོགས་མ་རྫོགས་པ་ལ་བལྟ་དགོས་པ་བསྟན་ཏེ།",
    "བྱེད་སྒྲ་དག་མིང་གི་བར་མཚམས་སུ་སྦྱར་ཏེ།",
    "ཚིག་གི་སྦྱོར་བ་གཞན་དང་སྦྲེལ་བ་ལ་རྒྱན་སྡུད་དང་།",
    "ཨི་ལྡན་གྱི་ཕྲད་སོགས་ནི་ཚིག་གི་འགྲུབ་རྒྱུ་དང་།",
    "བཞི་རུ་ན་ཚིག་གི་བརྗོད་འདོད་ཀྱི་ཀུན་སློང་ནི་ཚིག་ཕྲད་ཕལ་བས་བྱེད་པ་བསྟན་པ།",
    "རྟ་བདག་གིས་རྟ་ཕོ་རྒྱང་དུ་ཁྲིད།",
    "རྟ་བདག་གིས་རྟ་ཕོ་རྒྱང་དུ་ཁྲིད་དོ།",
    "རྟ་བདག་གིས་རྟ་ཕོ་རྒྱང་དུ་ཁྲིད་དམ།",
    "རྟ་བདག་གིས་རྟ་ཕོ་རྒྱང་དུ་ཁྲིད་དང་།",
    "རྟ་བདག་གིས་རྟ་ཕོ་རྒྱང་དུ་ཁྲིད་ཀྱང་།"
