    "དཔེར་ན་རང་བཞིན་གྱིས་དག་པའི་ཤེལ་དག་ནི་དག་པར་བྱེད་པའི་འདུ་བྱེདགཞན་ལ་བལྟོས་པ་མེདཔ་བཞིན་ནོ།་",
    "ད་དུང་ལན་བཞིའི་བར་འདོད་དོན་སྒྲུབ་པར་བྱེད་ཆོག་བསགལ་ཏེ་ཚུལ་བས་ག་ནངན་པས་བུ་བསྐྱེད་པའི་བྱ་བ་བྱའོ་སྙམ་ཞིང་།",
    "ཀུན་དཱིས་དབེན་པར་རྒྱལ་བོ་ལ་དོན་དེ་སྒྲུབ་པ་དང་།",
    "བྱསནས་མཚོན་ཆའི་སྦྱོར་བ་བསླབས།",
    "རྒྱལ་པོས་སྨྲས་བ་སྒྱུའདི་ཤའི་ཉམས་བརྒྱརཚིས་ལ་སོ་སོར་བཞག་སྟེ་ཆུ་བསིལ་བས་ཡང་ཡང་གཏོར་ཅིག་ཟེར་བ་ལྟར་བྱས་པས།",
    "འཐབཔར་འདོད་དེ་གནས་པ་ལ།",
    "ཁ་ཡང་ཡོངས་སུ་སྐེམ་པར་བྱེད།",
    "ཞེས་སོགས་སྨྲསསའཐུབ་པར་མི་བྱེད་དོ།",
    "འཚིག་དང་སྐྱོན་བཅུ་སྤང་བ་བཅས་ལེའུ་གསུམ་གྱིས་བསྟན་པ་འདིས་སྙན་ངག་ལེགས་པར་མ་སྦྱར་སྒྱུབའི་སྐྱོན་དང་།",
    "ཁམས་འགྲེལ་འདི་ནི་རྩོམ་པ་པོ་མཁྱེན་རབ་དང་གསུང་གསལ་ཞིང་།",
    "ཁྱད་པར་སྙན་པར་སྨྲབའི་ངག།",
    "རྒྱལ་བ་རིག་འཛིན་རྒྱ་མཚོའི་དགོངས་པའི་གསང་མཛོད་བརྡོལ་ནས་ལེགས་པར་སྩལ་བ་ཚིག་དོན་གྱི་ཆ་ཤས།",
    "༢༦ དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་བསྟན་བཅོས་ཀྱི་འགྲེལ་པ་འོད་ཟེར་ཕྲེར།",
    "༡༧ ཉི་ཤུ་པའི་ཚིག་ལེའུ་བྱས་པའི་མཆན་འགྲེལ།",
    "སུམ་པའི་ཚིག་ལེའུར་བྱས་པའི་མཆན་འགྲེལ།",
    "མང་ཐོས་མཁྱེན་པའི་ལྟོ་ཁར་བསྐྱིལ་བ་ལས།",
    "འཁོར་གསུམ་རྫོགས་པའི་རྡུལ་དང་མ་འདྲེས་པར།",
    "འཇམ་དཔལ་མཆོག་སྦྱིན་རྡོ་རྗེས་རྗེས་སུ་འཛིན་པར་ཤོག།",
    "ཕྱོགས་ལས་རྣམ་རྒྱལ་དངོས་གྲུབ་ཐམས་ཅད་ཐོབ་པར་ཤོག་བ།",
    "དྲན་པར་བྱ་བའི་ཕྱིར་ནི་བྲི་བར་བྱ།",
    "འདིར་དེ་ཁོ་ན་ཉིད་རྣམ་པ་བཅུ་ནི་གཙོ་བོ་ཡིན་པས་ཡང་དག་པར་བརྗོད་པར་བྱ་བ་ཡིན་ལ།",
    "རྡོ་རྗེ་འཁོར་ལོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་རྡོ་རྗེ་འཁོར་ལོས་རབ་ཏུ་སྤྲས་པའི་ཆ་བྱད་སྣ་ཚོགས་འཆང་པའི་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་རིགས་དང་ལྡན་པ་རྣམས་ཀྱི་ཆ་ལུགས་བསྒྱུར་བ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་སྤྲས་པའི་རྣམ་པར་སྣང་མཛད་ཀྱི་སྤྲུལ་པས་ཞེས་བྱ་བའི་བར་དུའོ།",
    "མདུན་གྱིས་བལྟས་པ་ཞེས་བྱ་བ་ནི་གཙོ་བོར་བྱས་པའོ།",
    "སྟང་སྟབས་ཀྱིས་ཞེས་བྱ་བ་ནི་གཡས་བརྐྱང་བ་ལ་སོགས་པའི་སྟང་སྟབས་རྣམས་ཀྱིས་མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་རྣམ་པར་འཇིག་པ་ཡིན་པས་ན་སྟང་སྟབས་ཀྱིས་རྣམ་པར་རྒྱལ་བའོ།",
    "དེ་ལྟ་བུའི་རོལ་བས་བཞད་པ་སྟོན་བའི་རྣམ་པར་འཕྲུལ་པ་ཏིང་ངེ་འཛིན་གང་དུ་སྟོན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་སྟོན་པའི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེ་ལའང་དེ་སྐད་ཅེས་བྱ་སྟེ་དེ་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "དང་པོ་ཁོ་ནར་ས་ཡོངས་སུ་གཟུང་བར་བྱའོ་ཞེས་བྱ་བ་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "དེ་ནས་དེ་དག་ཡང་དག་པར་བསྡུས་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་གཅིག་ཏུ་གྱུར་བར་བྱས་ནས།",
    "མྱུར་བ་ཉིད་དུ་རྡོ་རྗེའི་འགྲོས་ཀྱིས་དཀྱིལ་འཁོར་གྱིས་ཀུན་དུ་བསྐོར་ནས་གདུག་པ་ཅན་ཐམས་ཅད་བསྐྲད་པར་བྱ་སྟེ།",
    "དེ་ལྟ་བུས་ནི་ས་གཞི་ཡོངས་སུ་གཟུང་བ་བྱས་པར་གྱུར་པ་ཡིན་ནོ།",
    "ལྷག་མ་རྣམས་ལ་ནི་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "རྡོ་རྗེ་གར་ནི་རྡོ་རྗེ་དང་གར་བྱས་པས་ལག་པ་གཡོན་པ་བརྐྱང་ལ།",
    "དེའི་རྩ་བར་གཡས་པ་བ་དན་གསུམ་པར་བྱས་པས་འདི་འཛིན་པའོ།",
    "རྡོ་རྗེ་འཇིགས་སུ་རུང་བ་ནི་ཁའི་སྟེང་ནས་འོག་ཏུ་ལག་པ་བརྐྱང་ནས་དེ་ཉིད་འཇིགས་བྱེད་ཀྱི་ཚུལ་དུ་བྱས་པའོ།",
    "རྡོ་རྗེ་གར་སྔོན་དུ་འགྲོ་བས་ལག་པ་གཉིས་ཀ་དཀུར་བརྟེན་ལ་མགོ་གཡོན་དུ་འདུད་པར་བྱས་པའོ།",
    "རྡོ་རྗེ་མཆེ་བ་ནི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཐེའུ་དག་བཟློག་ལ་ཁའི་གྲྭ་མཆེ་བལྟར་བྱས་ནས་ལྕེ་བསྐྱོད་ཅིང་ཁྲོ་བའི་ལྟ་བས་བལྟ་བའོ།",
    "སྟང་སྟངས་དེ་རྣམས་ཀྱིས་ཁྲོ་བོ་འབྱིན་པ་སྔོན་དུ་འགྲོ་བས་བགེགས་ཐམས་ཅད་རྣམ་པར་གཞོམ་པར་བྱའོ།",
    "འདི་ཉིད་འཁོར་ལོ་ཐམས་ཅད་ལ་སྦྱར་བར་བྱའོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་སྔགས་ཀྱི་ཆོ་ག་འདི་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ཚོན་རྣམས་ལ་ཡང་ཅི་རིགས་པར་བྱའོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཉིས་པར་ནི་སྔོན་པོ་དང་།",
    "འཁོར་ལོའི་ལྟེ་བ་ལ་ནི་སེང་གེའི་གདན་ལ་གནས་པའི་པདྨ་དང་ཟླ་བའི་གདན་ལ་བཞུགས་པའི་རྣམ་པར་སྣང་མཛད་དགོད་པར་བྱའོ།",
    "འཁོར་ལོའི་བྱང་ཤར་ལ་སོགས་པར་ནི་སྤྱན་ལ་སོགས་པའོ།",
    "རིམ་པ་གཉིས་པའི་ཤར་ཕྱོགས་ལ་སོགས་པར་ནི་རྡོ་རྗེ་སེམས་མ་ལ་སོགས་པའོ།",
    "རྩ་བའི་བུམ་པ་ལ་རྣམ་པར་སྣང་མཛད་ཀྱི་སྔགས་སྟོང་རྩ་བརྒྱད་བཟླས་ཤིང་ཡི་གེ་ཧཱུཾ་བརྒྱ་རྩ་བརྒྱད་བཟླ་བ་དང་ལྷག་མ་རྣམས་ཀྱི་བུམ་པ་བཞི་ལ་ནི་སྤྱན་ལ་སོགས་པ་བཞིའི་སྔགས་བཟླ་བ་དང་།",
    "དེ་ནས་ལུས་ཁྲུས་བྱས་ཤིང་གོས་ལ་སོགས་བའི་རྒྱན་གྱིས་བརྒྱན་ལ་བདག་པོའི་སྦྱོར་བ་དང་ལྡན་པའི་རྣལ་འབྱོར་དམ་པས་ལྷའི་འཁོར་ལོ་ཐམས་ཅད་དང་བདག་ཉིད་ནང་དུ་བསྒོམས་ལ།",
    "སྒོ་ཕྱེ་ནས་གནས་ཇི་ལྟ་བ་བཞིན་དུ་བུམ་པ་ལགས་པར་བཞག་ལ།",
    "དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་སྔ་མ་བཞིན་དུ་ཕྱུང་སྟེ་རང་གནས་སུ་གནས་པར་བྱས་ལ།",
    "དེ་ནས་ལངས་ནས་ཕུར་བུ་དང་ར་བ་ལ་སོགས་པས་གནས་སྲུང་བ་བྱས་ལ་པདྨའི་གདན་དང་།",
    "ལན་གསུམ་གྱི་བར་དུ་རྡོ་རྗེའི་གླུ་བླངས་པས་ཡང་དག་པར་བསྟོད་ནས་ཕྱག་བྱས་ཏེ།",
    "དེའི་འོག་ཏུ་དངོས་གྲུབ་ཀྱི་ཕྱིར་གསོལ་བ་བཏབ་ནས་བདག་ཉིད་འཇུག་པ་ལ་སོགས་པ་རྫོགས་པར་བྱའོ།",
    "ཡི་གེ་ཨ་དང་གླེགས་བམ་སྦྱིན་ཞིང་ཨ་དང་དྲིལ་བུ་སྦྱིན་ལ་རྗེས་སུ་གནང་བ་སྦྱིན་པར་བྱ་བའི་ཕྱིར་འཁོར་ལོ་རྐང་པ་གཉིས་ཀྱི་བར་དུ་བཞག་ནས་ལག་པ་གཡས་པར་དུང་བྱིན་ཏེ།",
    "གསང་སྔགས་ཀྱི་རིམ་པར་ཕྱེ་བ་བསྟན་པར་བྱ་བའི་ཕྱིར་དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་རྣམ་པར་འཕྲུལ་པ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ཏིང་ངེ་འཛིན་གྱི་མཚན་ཉིད་དོ།",
    "དེ་ཉིད་མི་ཕྱེད་པས་ན་རྡོ་རྗེ་སྟེ་ཏིང་ངེ་འཛིན་གང་ལ་དེ་སྐད་ཅེས་བྱ་བ་དེ་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "གཡོན་ནི་དཀར་པོ་སྟེ་དེ་རྣམས་ཀྱིས་རྣམ་པར་མཛེས་པའོ།",
    "འོག་ཏུ་ནི་ཀུན་དུ་དྲག་པོ་དང་ཁྱབ་འཇུག་ལ་སོགས་པའི་ལྷ་རྣམས་བྲེད་ཅིང་སྐྲག་པར་བྲིའོ།",
    "དབུ་རྒྱན་ཐམས་ཅད་མཁྱེན་པས་བརྒྱན།",
    "ཟླ་བའི་གཟུགས་ཞེས་བྱ་བ་ནི་པདྨའི་གདན་ལ་བཞུགས་པའོ།",
    "མི་འཁྲུགས་བཞུགས་ཞེས་བྱ་བ་ནི་མི་བསྐྱོད་པས་བརྒྱན་པའོ།",
    "གནས་དང་གནས་མ་ཡིན་པ་མཁྱེན་པ་ལ་སོགས་པ་སྟོབས་བཅུས་བརྒྱན་པའོ།",
    "བྱམས་པའི་ཞལ་གསུམ་ནི་རྣམ་པར་སྣང་མཛད་དང་འདྲའོ།",
    "མ་ཧེའི་འོག་ཏུ་པདྨའི་གདན་བྱས་པ་གང་ཡིན་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱ་བའོ།",
    "སྐུ་གསུམ་ལ་ནི་རྣམ་པར་བཞུགས།",
    "འཇམ་པའི་དཔལ་གྱིས་ལེགས་པར་བརྒྱན།",
    "བཞི་པ་ནི་མདུན་དུ་གནས་པར་ཤེས་པར་བྱའོ།",
    "ཁྲོ་བོ་གཞན་གྱིས་མི་ཐུབ་པའི་ཞལ་རས་གསུམ་ནི་རྣམ་པར་སྣང་མཛད་དང་འདྲའོ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་ནང་ན་བཞུགས།",
    "ཞེས་བྱ་བ་ནི་ཉི་མའི་འོད་ཀྱི་དཀྱིལ་འཁོར་ལ་བཞུགས་པའོ།",
    "སློབ་དཔོན་ལ་ལ་དག་ནི་རོལ་པའི་སྟང་སྟབས་ཀྱིས་བཞུགས་པར་འདོད་དོ།",
    "ལྷག་མ་ནི་རོལ་པའི་སྟང་སྟབས་ཀྱིས་བཞུགས་སོ།",
    "ཞལ་གསུམ་ནི་རྣམ་པར་སྣང་མཛད་དང་འདྲའོ།",
    "པདྨའི་གདན་ལ་བཞུགས་པ་ཞེས་བྱ་བ་ནི་ཞབས་གཡས་པ་པདྨའི་གདན་ལ་བརྟེན་པས་བཞུགས་སོ།",
    "ཞེས་བྱ་བ་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "དེ་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "འཇམ་པའི་རྡོ་རྗེའི་རྣལ་འབྱོར་པས་མདུན་དུ་ཀྵཾ་ལས་བྱུང་བའི་གནོད་སྦྱིན་མ་བསྐྱེད་ལ་དེ་དང་སྙོམས་པར་འཇུག་པ་ལས་ཡང་དང་ཡང་དུ་དེ་ཉིད་སྤྲོས་ནས་ནམ་མཁའ་གང་བར་བསྒོམས་ལ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གསང་སྔགས་ཀྱི་ཡེ་ཤེས་རྣམ་པར་བསྒྱིངས་པ་རིམ་པར་ཕྱེ་བ་སྟོན་ཏེ།",
    "དེ་ཉིད་མཆོག་སྟེ་ཏིང་ངེ་འཛིན་གང་ལ་དེ་སྐད་ཅེས་བྱ་བ་དེ་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "དས་རྣམ་པར་སྣང་མཛད་ཀྱི་གཟུགས་སུ་བྱུང་བ་སྟེ།",
    "དེ་བཞིན་དུ་འོག་མ་རྣམས་ལ་ཡང་ཅི་རིགས་པར་རྗེས་སུ་སྦྱར་བར་བྱ་སྟེ།",
    "ཞི་བ་རྣམས་ལ་ཡང་། སྲོག་སྦྱིན་པར་བྱེད་ཅིང་མ་གྲུབ་པ་རྣམས་ལ་གྲུབ་པ་སྩོལ་བར་འགྱུར་རོ།",
    "རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཏིང་ངེ་འཛིན་གང་ལ་དེ་སྐད་ཅེས་བྱ་བ་དེ་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "དེ་སོ་སོར་རྟོག་པའི་མཚན་ཉིད་ཅན་གྱི་པདྨས་ཆགས་ཤིང་མཉེས་པར་བྱས་པས་ག་ར་དེས་རྣམ་པར་འཕྲུལ་པའོ།",
    "སྣ་ཚོགས་རྡོ་རྗེ་སྤྱི་བོར་གནས་པར་བྱས་ནས་བཟླས་པ་ལ་སོགས་པ་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ན་སྲུང་བ་ཆེན་པོ་མཛད་པར་འགྱུར་རོ།",
    "དེ་རྣམས་ཁོང་དུ་ཆུད་པར་བྱས་པ་ལས་བསྐྱེད་པ་ནི་དོན་ཡོད་རྡོ་རྗེ་ཅན་ནོ།",
    "ཞེས་བྱ་བ་ལ་དེས་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "ཐོད་པར་བཞག་ལ་དེ་དགུག་པ་དང་།",
    "གཞུག་བ་དང་བཅིང་བ་བྱས་ལ་རྐང་པ་གཡོན་པས་མནན་ཏེ།",
    "བསྐུལ་བ་དང་བཅས་པར་ཇི་སྲིད་དུ་ཁུགས་པར་གྱུར་པ་དེ་སྲིད་ཀྱི་བར་དུ་བཟླས་བརྗོད་བྱའོ།",
    "ཁྲོ་བོ་དང་སྤེལ་བའི་བསྒྲུབ་པར་བྱ་བའི་མིང་བྲིས་ནས་གཟུགས་བརྙན་གྱི་གནས་ལྔའི་ནང་དུ་བཅུག་ལ།",
    "རྡོ་རྗེ་ཚོགས་ཀྱི་བདག་པོ་བཀུག་ནས་ལེགས་པར་མཆོད་དེ།",
    "ཏིང་ངེ་འཛིན་གང་ལ་དེ་སྐད་ཅེས་བྱ་བ་དེ་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "བསམ་ཞེས་བྱ་བ་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "རྟ་མགྲིན་གྱི་རྣལ་འབྱོར་པས་ལག་པ་གཡས་པ་ལས་བྱུང་བའི་པདྨ་དཀར་པོ་འདབ་མ་བརྒྱད་པ་གནས་པར་བསམས་ལ།",
    "དེའི་ལྟེ་བ་ལ་གནས་པའི་ཡི་གེ་ཧ་འོད་ཟེར་འབར་བ་ལས་བསྒྲུབ་པར་བྱ་བའི་སྟེང་དུ།",
    "དེ་ལས་བྱུང་བའི་རྡོ་རྗེ་ནི་ཁྲོ་བོའི་མཚན་ཉིད་ཅན་གྱི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེ་ལ་སྙོམས་པར་ཞུགས་ཤིང་དམིགས་པ་ལ་སེམས་རྩེ་གཅིག་ཏུ་གྱུར་ལ་མངོན་རུ་མཛད་ཅེས་བྱ་བའི་བར་དུའོ།",
    "ངེས་པར་གསོད་པར་བྱེད་དོ།",
    "ཆར་པ་ཆེན་གཅོད་པར་འགྱུར།",
    "ཞེས་པ་ནི་སྟོབས་པོ་ཆེའི་སྦྱོར་བ་དང་ལྡན་པས་ཁྲོ་བོ་མཚོན་ཆ་འབར་བ་ཐོགས་པ་ཕྱུང་ནས་སྤྲིན་རྣམས་བསྲེགས་པར་གྱུར་ཅིང་།",
    "ཆུ་རྣམས་སྐམས་པར་བསམས་ལ་ཁྲོ་བས་བཟླས་ན་ཆར་ཆེན་པོ་གཅོད་པར་འགྱུར་རོ།",
    "གདངས་ཀ་ཅན་གྱི་ཀླུའི་གཟུགས་གྲོག་མཁར་གྱིས་ལས་བྱས་ནས་དགུག་པ་ལ་སོགས་པ་སྔོན་དུ་འགྲོ་བས་མནན་ལ་ཆར་ཕོབ་ཅིག་ཅེས་བསྐུལ་ཏེ་དེ་བཞིན་དུ་བཟླས་བརྗོད་བྱས་ན་ཆར་འབབས་པར་འགྱུར་རོ།",
    "བཀུག་ནས་ནི་ཞེས་པ་ནི་འདོད་པའི་རྒྱལ་པོའི་ཏིང་ངེ་འཛིན་དང་ལྡན་པས་རྐང་པ་གཡས་པར་སྣ་ཚོགས་རྡོ་རྗེ་འབར་བ་དགོད་པས་བཀུག་ནས་བསྒྲུབ་པར་བྱ་བའི་མཚན་མ་མནན་ཏེ་ཁྲོ་གཉེར་རིམ་པར་བསྙེར་ཞིང་ཁྲོས་པས་བསྐུལ་བའི་ཚིག་དང་བཅས་པར་གསང་སྔགས་བཟླས་པ་བྱས་ན་ངེས་པར་ཁུགས་པར་འགྱུར་རོ།",
    "ཁྲོ་བོའི་རྒྱལ་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལ་མི་གཡོ་བའི་སྦྱོར་བ་དང་ལྡན་པས་དེ་ཉིད་མནན་ལ་ཞགས་པས་བཅིངས་ལ་དྲང་བར་བྱའོ།",
    "སྐུ་གསུམ་རྡོ་རྗེ་ནི་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་དོ།",
    "དེའི་ཡེ་ཤེས་འབར་བའི་འོད་ཟེར་ལྟ་བུ་དེ་ལས་གནོད་མཛེས་ཀྱི་བདག་ཉིད་ཅན་ནི་རྡོ་རྗེ་སྟེ་དེ་ལ་དམིགས་པའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ངོ།",
    "རྡོ་རྗེའི་། སྔགས་ཀྱི་གཟུགས་ཀྱིས་དེ་རྣམ་པར་བསྒྱིངས་པ་ཉིད་ནི་དགའ་སྟོན་ཏེ།",
    "ཞེས་བྱ་བ་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "རྡོ་རྗེ་བདུད་རྩི་ཞེས་བྱ་བའི་ཁྲོ་བོའི་སྦྱོར་བས་དེ་འོངས་པར་རྣམ་པར་བསམས་ལ་དེའི་གསང་སྔགས་ལན་བཅུ་བརྗོད་ན།",
    "ངེས་པར་ཁུགས་པར་འགྱུར་རོ།",
    "གཞོན་ནུ་མ་དག་ངེས་པར་ཁུགས།",
    "ཁུགས་ཞེས་བྱ་བ་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "དེ་ལས་བྱུང་བའི་རྣམ་པར་རྒྱལ་བའི་རྡོ་རྗེ་ནི་དྲག་པོའི་རྡོ་རྗེ་སྟེ་དེ་ལ་དམིགས་པའི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེ་ལའང་དེ་སྐད་ཅེས་བྱའོ།",
    "ཉེ་བར་སྤྱོད་པར་བྱེད་ཅེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་སྦྱོར་བ་དང་ལྡན་པས་ཞལ་གསུམ་པ་ཐོད་པ་དང་།",
    "དེའི་རྣམ་པར་རྒྱལ་བ་ནི་ཁྲོ་གཉེར་ཅན་གྱི་བདག་ཉིད་ཅན་ནོ།",
    "འདི་ལ་ཡང་དེ་བཞིན་དུ་བཀུག་ནས་སྤྱད་པར་བྱའོ།",
    "དེ་རྣམས་ཀྱིས་བསྒྲུབ་པར་བྱ་བ་གསོད་པར་བསྒོམས་ལ་ཁྲོ་བོའི་ཚིག་ཏུ་འདོན་པས་གསང་སྔགས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ལ་གསད་པར་བྱའོ།",
    "ཁྲོ་བོའི་སྦྱོར་བ་དང་ལྡན་པས་མི་རུས་ཀྱི་ཕུར་བུ་སོར་བརྒྱད་པ་དེའི་གསང་སྔགས་བརྒྱ་རྩ་བརྒྱད་བཟླས་པ་དང་བཅས་པས་བསྒྲུབ་པར་བྱ་བའི་རྐང་རྗེས་ཀྱིས་ལས་དེའི་གཟུགས་བརྙན་བྱས་ཏེ།",
    "ངེས་པར་སྐྲོད་ཅེས་བྱ་བ་ནི་ཡན་ལག་མ་ཉམས་པའི་ཐོད་པ་བླངས་ལ་ཁྲོ་བོའི་སྔགས་དང་སྤེལ་བ་བྱས་ནས་འདིར་བསྒྲུབ་པར་བྱ་བའི་མིང་བྲིས་ལ་རྡོ་རྗེའི་ཚིག་དག་བཟླས་ནས་དགྲའི་སྒོ་ཁའམ་ཡུལ་གྱི་དབུས་སུ་སྦས་ན་ངེས་པར་སྐྲོད་པར་བྱེད་དོ།",
    "དེ་བཞིན་དུ་ཏ་ལའི་ལོ་མའམ་དུར་ཁྲོད་ཀྱི་རས་ལ་བྲིས་ནས་དགྲའི་ཁྱིམ་སྒོ་ལ་སོགས་པར་སྦས་ན་འཆི་བའམ་སྐམས་པར་འགྱུར་རོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་རྣམ་པར་འཇིག།",
    "སྐུ་རྡོ་རྗེ་ལ་སོགས་པ་བསྟན་པར་བྱ་བའི་ཕྱིར་དང་དེའི་ཕུར་བུ་ཉེ་བར་བརྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་སྐུའི་ཡེ་ཤེས་ནི་རྣམ་པར་སྣང་མཛད་དེ།",
    "ཞེས་བྱ་བ་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ་ཕུར་བུའི་དབྱིབས་ཀྱི་ཕྱག་རྒྱ་རྣམ་པར་སྣང་མཛད་དུ་གྱུར་པར་བསམས་ལ་ཡིད་ཉིད་ཀྱིས་བཀུག་ནས་གསང་སྔགས་འདོན་པ་སྔོན་དུ་འགྲོ་བས་ཕུར་བུས་གདབ་པར་བྱའོ།",
    "སྦྱོར་བའི་ཆེ་བའི་བདག་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "གཞན་དུ་བྱས་ན་བརླག་པར་འགྱུར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་ཐུགས་ཀྱི་ཡེ་ཤེས་ཆེན་པོ་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་དེ།",
    "དེའི་རྣམ་པར་བསྒྱིངས་པ་སྟོན་པའི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེ་ལ་ཡང་དེ་སྐད་ཅེས་བྱའོ།",
    "གསང་བའི་ཚིག་ནི་རྣམ་པར་སྣང་མཛད་ཀྱི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་རྡོ་རྗེ་ཡེ་ཤེས་ངེས་པར་འཆི་བས་རྡོ་རྗེ་ཡེ་ཤེས་སོ།",
    "མངོན་སྤྱོད་ལ་ཡང་བསམ་པའི་ཁྱད་པར་གྱིས་རྡོ་རྗེ་ཕུར་བུས་གདབ་པ་ཇི་ལྟ་བ་བཞིན་དུ་སྦྱར་བར་བྱའོ།",
    "དེ་ལ་འདིར་འོད་ཟེར་ཅན་གྱི་སྦྱོར་བ་དང་སྔགས་དང་ཕྱག་རྒྱར་བཅས་པས་རྣམ་བར་འཚེ་བར་བྱེད་པ་རྣམས་ཀྱི་ཁ་དང་མིག་བཙེམས་ལ་དེ་རྣམས་ལྐུགས་པ་དང་ལོང་བར་གྱུར་པར་བསམས་ན་ཆོམ་རྐུན་དང་སྣང་བ་རྣམས་བཅིངས་པར་འགྱུར་རོ།",
    "ཞི་བར་འགྱུར་ཞེས་བྱ་བ་ནི་དོན་ཡོད་རྡོ་རྗེའི་སྦྱོར་བ་དང་ལྡན་པས་རི་ཁྲོད་ཀྱི་ལོ་མ་ཅན་སྤྱན་དྲངས་ལ་དེའི་ཞལ་དུ་པདྨ་དཀར་པོ་དང་མར་སྲང་བསྲེས་པའི་ཏིལ་དང་འོ་མ་ལ་སོགས་པ་ཇི་ལྟ་བ་བཞིན་དུ་སྦྱིན་སྲེག་བྱས་ལ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ཉིད་ལས་གཡོན་པའི་མཐེ་བོ་ནང་དུ་བཅུག་པ་ནི་དེ་བཞིན་དུ་གསུངས་སོ།",
    "གཡོན་པ་དེ་བཞིན་བཞག་ལ་གཡས་པ་མཆོག་སྦྱིན་ལྟར་བྱས་པ་ནི་རིན་ཆེན་འབྱུང་གནས་ཀྱིའོ།",
    "ལག་པ་གཉིས་པང་པར་བཞག་སྟེ་བསམ་གཏན་གྱི་ཚུལ་དུ་སྦྱར་བ་ནི་འོད་དཔག་མེད་ཀྱིའོ།",
    "ལག་པ་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་རྒྱབ་ཏུ་ལག་པ་གཡས་པ་རྡོ་རྗེ་ཁུ་ཆུར་དུ་བྱས་ལ།",
    "ལག་པ་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་རྩེ་གསུམ་པ་བྱས་ལ་གཡས་པའི་རྡོ་རྗེ་བརྡེག་པའི་ཚུལ་དུ་གཏེག་པ་ནི་སྟོབས་པོ་ཆེའིའོ།",
    "ལག་པ་གཡོན་པ་པང་པར་གནས་པར་བྱས་ལ་གཡས་པ་གླང་པོའི་སྣ་ལྟར་བྱས་པ་ནི་སྤོས་ཀྱི་གླང་པོ་ཆེའིའོ།",
    "གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་པང་པར་བཞག་ལ་གཡས་པས་སེ་གོལ་གཏོགས་པའི་ཚུལ་དུ་བྱེད་པ་ནི་སྤོབས་པ་བརྩེགས་པའིའོ།",
    "ཞུ་བའི་ཚུལ་དུ་བྱེད་པ་ནི་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བའི་ཕྱག་རྒྱ་སྟེ།",
    "ལག་པ་གཉིས་སྤྱི་བོར་སྦྲུལ་མགོའི་གདེངས་ཀའི་ཚུལ་དུ་བྱས་ལ་ཕུཊ་ཅེས་བརྗོད་པ་ནི་དུག་སེལ་མའི་སྟེ་དུག་སེལ་མ་འདི་ཉིད་ཀྱི་སྦྱོར་བས་དུག་བསལ་བར་བྱའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཐེའུ་ཆུང་གཉིས་ཁའི་གྲྭ་གཉིས་སུ་བཟློག་སྟེ་མཆེ་བར་བྱས་ལ་ལྕེ་བསྐུལ་ཞིང་ཁྲོ་བོའི་ལྟ་བས་ལྟ་བར་བྱེད་བ་ནི་རྡོ་རྗེ་མཆེ་བའི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཟློག་ནས་བསྣོལ་ལ་མཚན་ཁུང་དུ་བསམས་ཏེ་ཁྲོ་བོའི་ལྟ་བ་དང་ལྡན་པ་ནི་གདོན་ཐམས་ཅད་སྐྲག་པར་བྱེད་པའི་ཕྱག་རྒྱའོ།",
    "གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་སྡིགས་མཛུབ་བྱས་པ་ནི།",
    "ལག་པ་གཉིས་ལུ་གུ་རྒྱུད་དུ་བྱས་ལ།",
    "གཡས་དང་གཡོན་དུ་བརྐྱང་བའི་ཚུལ་དུ་བྱས་ལ།",
    "སྟེང་དང་འོག་དང་ངོས་གཉིས་སུ་མདའ་འཕེན་པར་བྱེད་པ་ནི་རྡོ་རྗེ་མདའི་ཕྱག་རྒྱ་སྟེ་འདི་དང་ཧཱུཾ་ཕཊ་། ཅེས་བྱ་བས་གཞན་གྱི་དབུང་གཞིག་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མཉེས་པར་བྱས་ལ་ཧོ་ཞེས་བྱ་བས་མཉེས་པར་བྱའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་མཐེའུ་ཆུང་གཉིས་ལུ་གུ་རྒྱུད་དུ་བྱས་ལ།",
    "གཡོན་པས་ཐོད་པ་གཟུང་བའི་ཚུལ་དུ་བྱས་ལ།",
    "གཡས་པས་མདུང་རྩེ་གསུམ་པར་བྱས་ནས་རལ་བ་ལ་ཟླ་བས་བརྒྱན་ཏེ་བཅིངས་ནས་མཚན་མ་བསྒྲེངས་པ་མིག་གསུམ་པ་ལ་གར་སྟབས་ཀྱིས་གར་བྱེད་པར་བདག་ཉིད་བསྒོམས་པ་ནི་བདེ་བྱེད་ཀྱི་ཕྱག་རྒྱའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྣ་ཆ་རྣམས་ནི་། གནས་ཇི་ལྟ་བར་བརྒྱན་པར་བྱ་བ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་རིགས་ལྡན་ནི་སྐྱེ་བ་དང་འགག་པ་དང་བྲལ་བས་བཅོམ་ལྡན་འདས་ལ་བསྟོད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མཐའ་མ་མེད་ཅིང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "སྐུ་གསུམ་གྱི་བདེ་བའི་སྒོ་ནས་ལྷ་ཐམས་ཅད་ལ་བསྟོད་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་ལྟ་བུ་ཞེ་ན་དངོས་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐོག་མར་རྣམ་པར་སྣང་མཛད་ནི།",
    "དེ་ཉིད་སྐྱེ་བ་མེད་པ་སྟོན་པས་སྤྲོས་པ་མེད་པར་སྟོན་པའོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་ཚུལ་མང་བ་དང་ལྡན་པ་གང་ཡིན་པ་དེ་ལྟ་བུ་གཞན་འགའ་ཡང་མཉམ་པ་མེད་པ་དང་བདེ་བ་ཆེན་པོའི་རང་བཞིན་གྱི་རྗེས་སུ་ཆགས་པས་བཞུགས་པ་སྟེ།",
    "ན་ཆུང་དག་དང་ལྷན་ཅིག་བཞད་ཅིང་རོལ་བ་ནི་བདེན་པ་མ་ཡིན་པས་ཀུན་རྫོབ་ཏུ་བཞུགས་པར་སྟོན་པའི་བར་དུའོ།",
    "གང་ཞིག་གླུ་འདི་ལེན་ཅིང་སྟོད་པར་བྱེད་པ་དང་།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སེམས་ནི་ལུས་ཀྱི་རྣམ་པ་ཡིན་ལ་ཞེས་བྱ་བ་ནི་དེ་ལྟ་བུའི་རྣམ་པར་སྣང་བ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་བདག་པོ་ལས་སྐྱེས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "གནས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ་འདི་དག་ག་ལས་ཤེས་ཤེ་ན།",
    "ཅེས་བྱ་བ་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "ཕུར་བུ་དང་རབས་སྲུང་བ་བྱས་ལ།",
    "བར་དུ་ཞེས་བྱ་བ་ནི་དབུས་སུ་བྱུང་བ་སྟེ་རྣམ་པར་སྣང་མཛད་ཀྱི་ཐུགས་ཀའི་ཟླ་བའི་དབུས་ན་གནས་པའི་གསང་སྔགས་ཀྱི་ཡི་གེ་ལས་ངེས་པར་བྱུང་བ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "ཡོངས་སུ་བརྟག་པ་ལ་སོགས་པ་རྣལ་འབྱོར་གཉིས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནི་འདི་ལྟར་སྟོན་པར་འགྱུར་ཏེ།",
    "དེ་ཉིད་ཡོངས་སུ་རྫོགས་པ་དེ་ལ་ཡི་གེ་ཨོཾ་མྱུ་གུར་བྱས་ནས།",
    "གཉི་ག་ཡང་ཞུ་བར་གྱུར་པར་བལྟས་ལ་སྤྱན་ལ་སོགས་པས་བསླང་བའི་གླུ་དང་ཡང་དག་པར་བསྐུལ་བ་སྔོན་དུ་འགྲོ་བར་བྱས་པ་དང་།",
    "སྐུ་དང་གསུང་དང་ཐུགས་བསྒོམ་བ་ཅི་བདེ་བ་ལ་གནས་པར་བྱའོ།",
    "ལས་ཀྱི་ཚོགས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལྷ་ནི་གང་ཡང་རུང་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "བདག་པོ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རྣལ་འབྱོར་གྱིས་ཞི་བ་ལ་སོགས་པའི་ལས་རྣམས་བྱ་བའོ།",
    "ཡམས་ལ་སོགས་པ་རྣམ་པར་གཞིག་པ་ལ་ནི་འོད་ཟེར་ཅན་དང་རི་ཁྲོད་ཀྱི་ལོ་མ་ཅན་གྱིས་སོ།",
    "ཞེས་བྱ་བ་ནི་སྙོམས་པར་འཇུག་པ་ལ་རྗེས་སུ་ཆགས་པའོ།",
    "ཞེས་བྱ་བ་ནི་སྔ་མ་བཞིན་དུ་སྤྲུལ་པར་བསམས་ཏེ་རྣམ་པར་སྣང་མཛད་ཀྱི་སྦྱོར་བས་བསྐུལ་བ་དང་བཅས་པ་དེའི་སྔགས་བརྗོད་ལས་སྤྱན་ནམ་སྐུལ་བྱེད་མ་ཕྱུང་སྟེ།",
    "ཞེས་བྱ་བ་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "རྡོ་རྗེ་བསྡིགས་པར་བརྩོན་པ་ཡིས།",
    "ཁྲོས་ནས་ནི་ཞེས་བྱ་བ་ནི་ཁྲོ་བོའི་ལྟ་བས་རྡོ་རྗེ་མེའི་ཆར་འབེབས་པར་མི་བསྐྱོད་པའི་རྣལ་འབྱོར་དང་ལྡན་པས་སྔ་མ་བཞིན་དུ་བསམ་པར་བྱ་ཞིང་བསྒྲུབ་པར་བྱ་བ་འཇིགས་པར་འགྱུར་བ་ལ་སྦྱར་བར་བྱའོ།",
    "སྦྱོར་བཞེས་བྱ་བ་ནི་ཕྱག་རྒྱ་ལ་སོགས་པའི་སྦྱོར་བས་སོ།",
    "རྐང་རྗེས་སའི་ཞེས་བྱ་བ་ལ་སོགས་བ་གསུངས་ཏེ།",
    "དགྲ་བོའི་ཚ་བ་བ་སྐྱེད་པར་བྱ་བའི་ཕྱིར་ཇི་སྐད་དུ་བསྟན་པ་བཞིན་དེའི་གཟུགས་བརྙན་བྱས་ལ།",
    "རྣམ་པར་ཤེས་པ་དགུག་པ་ལ་སོགས་པ་སྔོན་དུ་འགྲོ་བས་དུག་དང་སྐེ་ཚེ་ལ་སོགས་པས་བཀང་ནས་ཤིན་ཏུ་སྡུག་བསྔལ་བར་གྱུར་པ་ལ།",
    "དེ་ཡང་འདི་ལྟར་ཕུར་བུས་བཏབ་ནས་བསྐམ་པར་བྱ་སྟེ།",
    "ཆོ་ག་བཞིན་དུ་དགུག་པར་བྱ།",
    "བསྒྲུབ་བྱ་བསམས་ནས་ཞེས་བྱ་བ་ནི་རྡོ་རྗེ་ཁྲོ་བོ་ལ་ལས་ཞགས་པས་བཅིངས་ནས་ལྷོ་ཕྱོགས་སུ་ཁྲིད་པར་གྱུར་པ་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་བསྐུལ་ཚིག་སྔོན་དུ་འགྲོ་བས་རྡོ་རྗེ་སྲིན་པོས་བསྒྲུབ་པར་བྱ་བ་ཟོས་པར་བསྒོམས་ཤིང་།",
    "བྱ་རོག་དང་ཁྱི་ལ་སོགས་པས་ཀུན་ནས་བསྐོར་ནས་ཟ་ཞིང་འཐོག་པར་བསམས་སོ།",
    "དེ་ཉིད་ལ་ཕྱིའི་ཆོ་ག་བསྟན་པར་བྱ་བའི་ཕྱིར་དེའི་རྐང་རྗེས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཆར་དབབ་པའི་ཕྱིར་པདྨ་འདབ་བརྒྱད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྤྲིན་བཅད་ཅིང་གཏུབས་ལ་ཧཱུཾ་ཞེས་བྱ་བས་བསྡིགས་པ་ལ་བརྩོན་པར་བྱའོ།",
    "བགེགས་ཐམས་ཅད་རྣམ་པར་གཞིག་པའི་ཕྱིར་མེའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མིའི་བགེགས་གཞོམ་པར་བྱ་བའི་ཕྱིར་རྐང་རྗེས་ས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མེ་མཆེད་པ་བཟློག་པར་བྱ་བའི་ཕྱིར་སྟང་ཟིལ་ཁ་དོག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་ཐོག་ཐོག་བཟློག་པར་བྱ་བའི་ཕྱིར་ཞལ་རས་གསུམ་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ནམ་མཁའི་ཁམས་སུ་སྤྲིན་བཞིན་དུ་ཁྱབ་པར་བསམས་ནས་བསྒྲུབ་པར་བྱ་བའམ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་བཀའ་སྩལ་པ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "འདི་ཉིད་བསྐྱེད་པར་བྱ་བའི་ཕྱིར་ཀུན་རྫོབ་ཏུ་ཏེ་ཁོ་ན་ཉིད་རྣམ་པ་བཅུ་གསུངས་སོ།",
    "དེར་ལྕགས་ཀྱུས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་ཐོ་བས་ཕུར་བུའི་སྔགས་གདོན་བཞིན་རུ་གནས་ལྔར་ཕུར་བུས་གདབ་པར་བྱའོ།",
    "དབབ་པ་ལ་སོགས་པའི་ལས་བསྟན་པར་བྱ་བའི་ཕྱིར་དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་། པ་གསུངས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རྣལ་འབྱོར་པས་དབབ་པའི་སྣོད་སྐུལ་བྱེད་མ་ལ་སོགས་པའི་གཟུགས་སུ་རྣམ་པར་བསམས་ལ།",
    "རྡོ་རྗེ་བསྡམས་པ་དང་བཅས་པའི་དྲིལ་བུ་བསྐྱོད་ཅིང་གཟེངས་བསྟོད་པ་དང་བཅས་པར་གསང་སྔགས་བརྗོད་ན་འབར་བར་འགྱུར་རོ་ཞེས་གསུངས་སེ།",
    "དེ་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "མཐའ་མ་བསྒྲུབ་པར་བྱ་བའི་མིང་དང་ལྡན་པ་བྲིས་ལ།",
    "ད་ནས་དེར་དེའི་རྣམ་པར་ཤེས་པ་བཀུག་ནས་ཁམ་ཕོར་སེར་པོ་ཁ་སྦྱོར་གྱི་ནང་དུ་བཅུག་སྟེ་སྟེང་དུ་རྡོ་རྗེ་འཆང་བས་མནན་ལ་བསྐུལ་ཚིག་དང་བཅས་པར་ཧཱུཾ་བརྒྱ་རྩ་བརྒྱད་བཟླས་པའི་རྡོ་རྗེའི་སྐུད་པས་དཀྲིས་ལ་གཞག་པར་བྱའོ།",
    "རྡོ་རྗེ་སེམས་དཔར་གྱུར་ནས་རྡོ་རྗེ་ཆགས་པར་གྱུར་པའོ།",
    "འཛག་པར་བྱ་བའི་ཕྱིར་པདྨའི་ནང་དུ་ཞུགས་པའམ་ཡང་ན་འདོད་ཆགས་ཅན་མི་འཛག་པར་འགྱུར་བ་སྟེ།",
    "དེ་ལྟར་ན་འདིའི་འཛག་པར་འགྱུར་བའོ།",
    "མི་ཐོད་ལས་བྱས་ཅང་ཏེའུ་ལ།",
    "ཞེས་བྱ་བ་ནི་མི་ཐོད་ལས་བྱས་པའོ།",
    "རྣལ་འབྱོར་པ་འཁོར་ལོ་རྫོགས་པར་གྱུར་པས་བལྟས་པ་དང་།",
    "ལག་གཡོན་རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་ལག་པ་གཡོན་པ་རྡོ་རྗེ་རྩེ་གསུམ་པར་བྱས་པའོ།",
    "འབར་བའི་རྣམ་པར་བསྒྱུར་བར་བྱ།",
    "ཞལ་བཀང་ནས་ཞེས་གསུངས་པས་ལྷ་རྣམས་ཀྱི་ཞལ་གྱི་པདྨར་སྦྱིན་སྲེག་དབུལ་ལོ།",
    "ལྷའི་ང་རྒྱལ་སྔོན་དུ་འགྲོ་བས་ཐབས་དང་ཤེས་རབ་རོ་གཅིག་པ་མངོན་གསུམ་དུ་བྱས་ན་ཟག་པ་མེད་པའི་ཡེ་ཤེས་སྐྱེད་པ་ཡིན་ནོ།",
    "སྐུ་ལ་སོགས་པའི་དམ་ཚིག་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ལས་ལས་བྱུང་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤ་དང་རྐང་ལ་སོགས་པ་རྣམས་ནི་རྣམ་པར་སྣང་མཛད་དང་།",
    "མི་བསྐྱོད་པ་ལ་སོགས་པའི་ངོ་བོ་ཡིན་ཏེ་དེ་བས་ན་བསྟེན་པར་བྱའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ནི་སྒྲུབ་པ་ཆེན་པོ་བསྒྲུབ་པ་ལ་སོགས་པ་བསྟན་པ་ཡིན་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་ཏིང་འཛིན་གནས།",
    "འཁོར་ལོ་བསྒྲུབ་པར་བྱ་ཞེས་བྱ་བས་ནི་འདི་སྐད་སྟོན་པར་འགྱུར་ཏེ།",
    "འཁོར་ལོ་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར་སྟོན་དུ་བསྙེན་པ་བྱས་ལ།",
    "ཇི་སྲིད་དུ་ཞུགས་ནས་འབར་པར་གྱུར་པ་དེ་སྲིད་དུ་བསྒོམས་ལ།",
    "འདིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྤྱན་ལ་སོགས་པའི་གཟུགས་སུ་བསྟན་པར་བྱ་བའི་ཕྱིར་ས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་དག་ནི་སྙོམས་པར་འཇུག་པའི་བདག་ཉིད་ཅན་གྱི་རྣལ་འབྱོར་ནི་རྣལ་འབྱོར་ཆེན་པོའོ།",
    "འཇིག་རྟེན་རྡོ་རྗེ་འཛིན་པར་ཤོག།",
    "བསྔགས་འོས་གྲུབ་རིགས་ཞབས་རྡུལ་གཙང་མ་ཡིས།",
    "བསྟར་བྱས་ས་གཞི་མཛེས་པ་འདི་དག་ཀྱང་།",
    "ནེའུ་གསེང་ཟོལ་གྱིས་མཉམ་པར་འཁོད་པ་བཞིན།",
    "རི་བྲག་ཚུལ་གྱིས་ཕྱོགས་ཕྱོགས་མཛེས་པར་བརྒྱན།",
    "རང་བྱུང་སྙན་པར་སྒྲོག་པ་བུང་བའི་ཁྱུ།",
    "བཟུང་བའི་གནས་བྲག་མཁར་དགོན་ཞེས་པར།",
    "མ་ལ་སོགས་པ་དང་ལེགས་པར་འབྲེལ་བའི་གཉེན་དང་།",
    "ཞེས་སོགས་ཀྱིས་གསལ་བར་བྱས་པ་ཡིན་ལ།",
    "ངོར་ན་བཞུགས་པའི་སྐབས་ཤིག་མནལ་ལམ་དུ།",
    "མཐར་རྒྱལ་ཁམས་ཐམས་ཅད་ཁྱབ་པ་རྨིས་གསུངས་པ་སོགས་ངོ་མཚར་གྱིས་གཏམ་གྱི་མཛེས་པར་བྱས་པ་ཡིན་ནོ།",
    "ཐུགས་ཀྱི་གཏིང་སྲབ་ཅིང་ཞལ་ཅུང་ཟད་སོར་བ་ཞིག་ཁབ་ཏུ་བཞེས་པ་ལས་ལྕགས་ཕོ་རྟའི་ལོ་ལ།",
    "འགྲོ་བ་ཡོངས་ཀྱི་འདྲེན་པ་དམ་པ་འདི་ཉིད་བཀྲ་ཤིས་པའི་དགེ་མཚན་དུ་མ་དང་བཅས་བལྟམས་པར་མཛད་ལ།",
    "དེ་ནས་དགུང་ལོ་དགུར་ཕེབས་པ་ས་ཕོ་སྟག་ལོ།",
