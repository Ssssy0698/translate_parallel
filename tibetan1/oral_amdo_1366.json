    "དེ་ལ་ཁྱོད་ཀྱིས་བརྐོས་པར་འོང་ངོ།",
    "གཡུང་དྲུང་གི་ཚལ་བའི་གྲོ་མ་བརྐོས་པས།",
    "ཤིང་ཟླ་བ་དྲུང་ཞིག་གི་རྩ་བ་ན་དུང་གི་རི་བོང་ཞིག་ཉལ་ནས་གདའ་བ་ལ།",
    "གཡུང་དྲུང་གི་གླིང་ལ་མཁར་བརྩིགས་པའི་ས་བལྟས་པས།",
    "སང་གི་ནངས་པར་ཕག་བུ་མནན་པས་ས་ཡང་མཁྱེན།",
    "གཡུང་དྲུང་གི་རི་རྩེ་མཐོ་བ་ལ་མཆིས།",
    "གཡུང་དྲུང་གི་ཚལ་ཁམས་ཆེན་པོ་དེ་ཁུམ་ནས་དེར་མཆིས་པས།",
    "གཡུང་དྲུང་གི་ཚལ་ཁམས་ཀྱི་དཀྱིལ་ནས།",
    "མི་འདུལ་དཔལ་བགྱིས་པ་ནི་མཚན་མོ་གཉིད་མེད་ནས་ཉིན་ཞིང་སེམས་མ་དགའ་བར་གྱུར་ནས།",
    "དེ་ནས་ལོ་གཅིག་ལོན་ནས་ཁོ་རང་གི་རྣ་བར་ཡང་ཐོས་ནས།",
    "ཁོ་རང་གི་སེམས་ལ་ན་ནིང་གི་ཚ་ཚས་ནོངས་སྙམ།",
    "དེ་ནས་བདག་ངན་པ་ཡང་ཟླ་བ་གསུམ་དུ་རེད་པས་གཉིད་མེད།",
    "དེ་ནས་རྨོངས་ན་རེ་ཤ་འགྱུར་ནས།",
    "ཀླུ་རུ་རྒྱལ་བས་ཁྱོད་སྤང་མི་བཏང་བར་ཆད།",
    "ད་ཁྱོད་གཉིད་མེད་པར་ཚ་བས་ཟིན་པ་ཡིན།",
    "བདག་གཡུང་དྲུང་གི་ཚལ་ཁམས་ཆེན་པོ་ནི་ས་དཀར་པོ་ཞིག་ལ་གནས་བཅས་ནས།",
    "བདག་མ་གིས་མི་འདུལ་དཔལ་དེ་ས་དཀར་པོ་ཞིག་ལ་གནས་བཅས་ནས་མཆིས་སོ་ཞེས་བྱས།",
