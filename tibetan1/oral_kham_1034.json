    "དེས་འདུག་བཞིན་དུ་སེམས་ཀྱིས་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེས་འདུག་བཞིན་སེམས་ཀྱིས་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "ཕྱོགས་ཆེས་མཐོན་པོར་འདུག་སྟེ་ཉན་དུ་གཞུག་པ་དག་བྱས་ལ།",
    "གལ་ཏེ་རང་འབའ་ཞིག་གམ་གཅིག་པུ་ཡིན་ན་སྟན་དེ་ལ་འདུག་སྟེ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ལྷག་མ་གཞན་གཉིས་པ་དང་བཅས་པ་ཡིན་ན་དེའི་མདུན་དུ་ཙོག་ཙོག་པོར་འདུག་སྟེ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "སེང་གེའི་ཁྲི་སོགས་ལ་འདུག་སྟེའོ།",
    "གལ་ཏེ་གནས་བརྟན་ཡིན་ན་ནི་གྲལ་གྱི་གཙོ་བོར་འདུག་པར་བྱ་སྟེ་ཞེས་སོ།",
    "དེ་སེང་གེའི་ཁྲི་ལ་ཡང་འདུག་ཏུ་རུང་ངོ།",
    "འདི་ལྟར་དེ་མེད་པ་ཉིད་ཀྱིས་ཀྱང་རང་གྲོལ་བར་འགྱུར་རོ་ཞེས་སྟོན་ཏོ་ཞེས་སོ།",
    "འདི་ལྟར་ཤིང་ལྗོན་པ་གཅིག་པུ་ཞིག་ཕྱོགས་ཕྱོགས་ཀྱི་མཚམས་འདོམས་པའི་དབུས་ན་འདུག་ན་ཤར་ཕྱོགས་པའི་ནུབ་ཕྱོགས་ཀྱི་མཚམས་ཀྱི་མུ་ཐུག་ཀྱང་དེ་ཡིན་པ་བཞིན་ཕྱོགས་གཞན་དུ་ཡང་མཚོན་ཏེ་གསུངས་སོ།",
    "ལ་ལར་སྔ་དྲོ་དང་གུང་ཚིགས་དང་ཕྱི་དྲོ་འདུག་པས་དེ་ལ་སྦྱར་བར་བྱའོ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་འོངས་ན་དེའི་ཕྱིར་བསྐོ་བའི་དུས་འབའ་ཞིག་ཏུ་མ་ཟད་རྣམ་པཐམས་ཅད་དུ་སྒྱུ་ཐབས་སམ་བགེགས་མི་བྱའོ།",
    "ཇི་ལྟར་དགག་དབྱེ་བྱ་བ་ཙོག་ཙོག་པོར་འདུག་ཅིང་ལྷམ་ཕུད་དེ།",
    "བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་བྱས་ཏེ་འདུག་པ་དེ་བཞིན་དུ་དགག་དབྱེ་བྱེད་པ་ཡང་འདུག་པར་བྱའོ།",
    "ཤིང་འདུག་པ་མ་ཡིན་གྱི།",
    "དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱི་ཞེས་སོགས་སྦྱར་བར་བྱའོ།",
    "དེ་དག་ནི་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དག་དང་རིས་མི་མཐུན་པ་ཡིན་པས་སོ།",
    "གྲྭ་དག་འཕྱངས་པའི་ཕྱིར་མི་མཉམ་པར་འདུག་པའམ་འཐག་པའི་ཚེ་བར་བར་དུ་རྒྱུ་སྤུན་མ་བཅུག་ཅིང་སེང་སེང་པོར་གྱུར་པའི་ཡ་ཡོར་མ་གྱུར་པ་དང་།",
    "ཁྱེར་ཏེ་བླ་གབ་མེད་པར་འདུག་པར་མི་བྱའོ།",
    "ཉམས་སུ་མ་མྱོང་བ་དང་ལྡན་པ་དེ་ལ་ནི་ཇི་སྲིད་དུ་སྲ་བརྐྱང་ཕྱུང་བ་དེས་མ་ཐོས་ཀྱི་བར་དུ་མཚམས་ཀྱི་ནང་ངམ་ཕྱི་རོལ་ན་འདུག་ཀྱང་རུང་སྟེ་སྲ་བརྐྱང་བཏིང་བ་དེའི་ཕན་ཡོན་རྗེས་སུ་འཇུག་གོ་སྟེ་ཡོད་དོ།",
    "དེ་ཡང་གནས་གང་ན་བྱིན་གྱིས་བརླབ་པར་བྱ་བའི་རྫས་འདུག་པ་དེའི་མཚམས་སུ་གཏོགས་པའི་རབ་ཏུ་བྱུང་བ་རྣམས་ནི་དེ་བྱིན་གྱིས་རློབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེས་ན་གནས་གཞན་དུ་ཤི་བ་དེའི་ཡོ་བྱད་མཚམས་འདི་ན་འདུག་པ་ནི་མཚམས་འདི་ན་གནས་པའི་དགེ་སློང་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབ་ཏུ་རུང་བ་ཉིད་དོ་ཞེས་སོ།",
    "དགེ་སློང་ཤི་བའི་ནོར་ཁྱིམ་པ་ལ་གཏམས་ཤིང་འདུག་པ་ལས་དགེ་སློང་ཕོངས་པས་བླངས་ཏེ་བྱིན་ན་ནི་ཉེས་མེད་དོ་ཞེས་འགྲེལ་ཆུང་གསུངས།",
    "དད་པ་སྦྱིན་པར་བྱ་བ་ཆུད་གཟན་པ་མི་བྱ་བར་འདི་ལྟར་སྟན་ནང་ཚངས་ཅན་ལ་འདུག་པར་བྱའོ།",
    "འདིར་སྟན་ནང་ཚངས་ཅན་ནི་དཔེ་ཙམ་དུ་ཟད་དེ་སྟན་གཞན་ལ་ཡང་འདུག་པར་བྱའོ་ཞེས་སོ།",
    "སྣམ་སྦྱར་དེ་ལ་ཉལ་བའམ་འདུག་པར་མི་བྱའོ།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་སྣམ་སྦྱར་མ་དྲས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་མུ་སྟེགས་ཅན་དག་ཉེ་བར་མི་འཁོད་ཀྱང་འཇུག་པ་དང་འདུག་པར་མི་བྱ་བར་ཡང་དེ་བཞིན་ནོ།",
    "རྐྱེན་དེ་ལྟ་བུ་ཡོད་ཀྱང་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེ་དག་ན་མུ་སྟེགས་ཅན་འཁོད་ན་ནི་སྣམ་སྦྱར་མེད་པར་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "ཁྱིམ་པའི་ཁྱིམ་གཞན་དུ་སྟན་གཞན་མེད་ན་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོ།",
    "ཀོ་ལྤགས་ཁོ་ན་ཡིན་པས་དེའི་ཕྱིར་ཀོ་ལྤགས་ཀྱིས་བརྒྱུས་པའི་ཁྲི་དང་ཁྲིའུ་ལ་སོགས་པ་ལ་ཡང་འདུག་པར་མི་བྱའོ་ཞེས་སོ།",
    "དུས་སུ་རུང་བའི་ནང་ན་འདུག་པའི་ཐུན་ཚོད་དུ་རུང་བ་དུས་སུ་རུང་བ་དང་མ་འདྲེས་པ་ནི་ཐུན་ཚོད་དུ་རུང་བ་ཉིད་དུ་ཡོངས་སུ་ལོངས་སྤྱད་དུ་རུང་ལ།",
    "དེ་བཞིན་དུ་ཐུན་ཚོད་དུ་རུང་བའི་ནང་ན་འདུག་པའི་ཞག་བདུན་པ་ཐུན་ཚོད་དུ་རུང་བ་དང་མ་འདྲེས་པ་ནི་ཞག་བདུན་པ་ཉིད་དུ་ཡོངས་སུ་ལོངས་སྤྱད་པར་རུང་བ་དང་།",
    "བུ་རམ་གོང་བུར་བསྒོང་བའི་ཕྱིར་འབྲས་ཕྱེའི་ནང་དུ་བཞག་སྟེ་གོང་བུར་གྱུར་པ་ན་ནི་འབྲས་ཕྱེའི་བག་ཆགས་པ་ཆུས་བཀྲུ་བས་ཞག་བདུན་པ་ཞེས་བྱ་བ་རང་ཁོ་འདུག་པའི་འཚོ་དྲེས་པ་ནི་འཚོ་ནའི་གྲངས་ཉིད་དུ་འགྲུབ་བོ།"
  ]
}