    "སྐྱེས་བུ་ཆེན་པོ་ཀུན་ལའང་ཚུལ་སྟོན་ནི་ཡིན་པ་གཞིར་བཅས།",
    "བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པའི་གསུང་གི་ལུང་འདྲ་མ་བཀླགས།",
    "མལ་གྲོ་འཆད་ཀ་བའི་བཀའ་བཅུ་པ་ཞིག་གིས་བསྐུལ་ནས།",
    "ཁོང་ཚོས་རབ་གནས་ལ་ཡོང་དགོས་ཚུལ་དང་།",
    "རང་རེའི་ལག་ནས་སྔ་ཕྱིར་མང་ཇ་འགྱེད་ཆས་སྤྱི་རྫས་སོགས་གང་གྲག་སྦྱར།",
    "གཞིས་ཐམས་ཅད་རྩིས་ཟེར་ནས་ཁོང་ཚོའི་རྒད་པོ་རང་དང་བུ་བཙུན་གཟུགས་དེ་སླེབས་བྱུང་།",
    "དེ་དང་ཁོང་ཚོ་ཕྱོགས་གཅིག་ཡིན་པས།",
    "ངམ་རིང་ཡུམ་སྲས་ཚོ་རང་གིས་ཕྱི་ཐག་གིས་སྐྱོང་དགོས་ཤིག་ནི་ཡིན་པར་འདུག།",
    "ཡུམ་སྲས་གཉིས་ཀ་ཕྱག་གཡོག་འགའ་རེ་དང་བཅས་པ་ལའང་།",
    "མགོ་ནག་གི་དད་པ་ཁ་དང་།",
    "ཚོང་འདུས་སུ་གཟིམས་དཔོན་ལྷུན་གྲུབ་སྔ་མོ་ནས་ངེད་ལ་བློ་གཏད་པ་ཡིན།",
    "ཉམས་དང་གཞིག་འཇུག་ཡོད་རློམ་རྣམས་ཀྱིས་གཟིགས་ན་ངོ་ཨེ་མཁྱེན་ནམ།",
    "ཁྱེད་དྲིན་ཆེ་ཞེས་ཡང་ཡང་གསུང་གིན་ཡང་འདུག།",
    "རོང་ཚོའི་ཡོང་སྒོ་རྣམས་ཞབས་དྲུང་རང་ལ་ཡོང་པ་གཞིར་བཅས།",
    "གཡོག་རིགས་ཀྱང་གཙང་སྦྲས་ཆོད་པ་ཡིན་མོད།",
    "སྣ་ཚོགས་ཤིག་གིས་ཟར་ཟིར་མང་པོ་རྒྱུན་ལྡན་དུ་མཛད་པ་ཞིག་བྱུང་།",
    "རོག་ཚོར་མི་ཕར་བསད་ཚུར་བསད་འགའ་རེ་བྱུང་།",
    "འོན་ཀྱང་ཚིག་རེ་ཚིག་གཉིས་ཀྱི་གོ་བ་ནས་ཀྱང་མང་དུ་ཕན་ཐོགས་པར་འདུག་ཅིག་སེམས་ལའང་ཕན་པ་དང་།",
    "སྨད་ཆ་འདི་ལ་བླ་ཆེན་ཡེ་ཤེས་དྲུང་གིས་ཟིན་བྲིས་ཀྱང་མཛད་ཐུབ་བོ།",
    "སྔར་གྱི་དེ་ནས་འགྱང་ཙམ་སོང་བ་ན།",
    "གྲོས་པ་ཚོའི་སྐྱོན་ནི་ཡིན་པར་འདུག།",
    "རྒྱལ་བའི་སྲས་ཀྱི་གཞུང་ལམ་ཆེན་པོ་ཟབ་ཅིང་རྒྱ་ཆེ་བ་དེ་འཆད་པའི་ལྷོངས་ནི་ཡིན་པར་འདུག།",
    "དེ་སྐབས་རང་དེ་མར་ཡུལ་བདག་པོ་རང་གི་དགོངས་གཏད་སྟོན་ཙམ་ཐུབ་འདི་ཁར་བཞུགས།",
    "ལམ་འབྲས་ཀྱང་ཞུ་འཕྲོ་ལ་བཞག་སྟེ་ཕེབས་དགོས་བྱུང་སོང་བ།",
    "སྔར་གཙང་པ་རང་གི་དགྲ་ཕྱོགས་ཀྱི་ཁུངས་རྣམས་ལྟ་ཅི་སྨོས།",
    "ཐམས་ཅད་སྟོང་སོང་པ་དེ་ཀ་ལ།",
    "ལུང་བསྟན་ཡིན་ཟེར་བའི་ཤོབ་རང་ཚིག་རེ་རེ་གཉིས་གཉིས་འདོན་ཞིང་།",
    "ཡེ་ཤེས་ཀྱི་སྤྱན་ཡོད་པ་གཅིག་གིས་གཟིགས་ན།",
    "མིག་གིས་མི་མཐོང་བའི་ཕྱོགས་ནས་རྒྱལ་ཕམ་གྱི་དཔུང་བྱེད་པ་ཁོ་ན་ཡིན་པ་གོ་དགོས།",
    "རྒྱ་གར་བ་མཁས་པ་རྣམས་ན་རེ།",
    "འབལ་ཐེའུ་སོགས་ཡིན་ཀྱང་བརྒྱ་འགྱུར་སྟོང་འགྱུར་གྱིས་གྲག་མོད།",
    "སྐྱེ་བོ་མི་ནག་པས་ཁ་འཇུག་བཀོད་ཁྱབ་བྱས་ཀྱང་བཟའ་སྒོ་དང་ཐོ་ཆོའི་སྤྱོད་པ་ལ་སོང་།",
    "གྲོས་ཕུགས་ཡིན་པའི་ཁུངས་རང་གི་བཀའ་ཕེབས་སྐུ་དོན་རྣམ་གྲངས་མང་པོ་དང་།",
    "སྔར་དེ་འདྲ་ཅི་ཡང་ཟེར་མ་མྱོང་བས་རང་རེས་ནི་ཡེ་མ་བྱས།",
    "དབྱར་སྨད་ཀྱི་དུས་ཟབ་ཆེན་རྒྱུ་གང་བཟང་ལ་དཔལ་དུས་ཀྱི་འཁོར་ལོའི་སྐུ་གསུང་ཐུགས་ཡོངས་རྫོགས་ཀྱི་དཀྱིལ་འཁོར་གྱི་བཀོད་པ་ཟབ་དཀྱིལ་ཆེན་མོར་གྲགས་པ་འདི་ཡང་བཞེངས།",
    "ཟབ་ཆེན་ཡུག་རིང་ཐུང་སྣ་ཚོགས་པ་བརྒྱ་སྐོར་ཞིག་སོང་།",
    "ད་རེས་ཤར་ཕྱོགས་མི་འགྲོ་བར་ཐག་བཅད་དོ།",
    "དཔལ་མགོན་པོའི་བཀའ་སོགས་རྗེས་གནང་མང་རབ་དང་བཅས་པ་གསན་སོང་།",
    "འདྲ་མོ་རུ་ཡང་གདའ།",
    "མཉམ་མེད་དཔལ་སྒམ་པོ་པ་རང་གི་དུས་དང་།",
    "ལོ་འདིའི་ནང་དུ་ཇོ་ནང་གི་ལྷ་ཁང་བདེ་བ་ཅན་དུ།",
    "ཁོང་རེ་ཞིག་སྡོད་པར་བྱས་ནས།",
    "ཞག་རེའི་ནང་དུ་ཐུན་རེ་ཙམ་བྱས།",
    "ལག་ལེན་ནག་པོ་འགྲོ་ཤེས་རེ་ཡང་ཉིན་རེ་བཞིན་བྲིས།",
    "བདེ་མཆོག་ནག་པོ་ལུགས་ཀྱི་རིམ་བཞི་ལམ་སློང་ཆེན་མོ་དང་།",
    "དགོངས་འགྲེལ་གྱི་བསྟན་བཅོས་ནི་མ་འགྱུར་བ་ཆེས་མང་མོད་ཚད་གཟུང་མི་ནུས་ལ།",
    "ཁ་ཅིག་མེད་ཀྱང་ཨའུ་རྩི་མོད།",
    "བོད་ཡུལ་འདིར་རང་རང་གི་བློ་གྲོས་ཀྱིས་རྒྱ་ཆེར་སྤེལ་བ་ཡང་མང་དུ་བྱུང་།",
    "འབད་རྩོལ་གྱིས་ཐོས་སྒོམ་བྱེད་ཚུལ་ཅི་རིགས་ནི་ཡོང་གིན་གདའ།",
    "རྒྱ་གཞུང་གི་ལུང་བཀའ་མ་ཆད་པ་ཡོད།",
    "རྫོགས་རིམ་ཟབ་མོ་ཕྱིས་བྱུང་བའང་ཡོད་དེ།",
    "གུང་ཐང་གི་མལ་རྣམས་ཕ་ལོག་བུ་ལོག་བྱས་པ།",
    "དུས་དེང་སང་མན་ངག་གི་རྒྱུན་དང་སྒྲུབ་བཀའ་ཡོད་པ་མ་ཐོས།",
    "རྒྱུད་འབུམ་ནང་གི་ལུང་ཙམ་མ་གཏོགས།",
    "ནན་ཏན་བྱ་མཁན་ནི་ཉིན་མོའི་སྐར་མ་བཞིན་ནོ།",
    "རང་རེས་ཕར་ནི་བརྡལ་པོར་གང་འགྲོ་འགྲོ་བཏང་།",
    "ལུང་རྐྱང་རེ་ཙམ་མ་གཏོགས།",
    "བདག་གིས་ནི་ཐོབ་ཀྱང་ལེགས་ལ།",
    "འབད་པས་བརྩལ་ནས་ཐོབ་ཀྱང་ཐོབ་པས་ང་རང་གི་མདུན་མ་རྩེ་ལ་ཕྱིན་པ་ལགས་སོ།",
    "མི་འདི་རྣམས་འཁྲུག་པ་རེ་ཙམ་རྒྱལ་བ་དང་།",
    "ཁ་མཆུ་རེ་ཙམ་ལེགས་པ་དང་།",
    "ས་ཆ་རེ་ཙམ་ཆོད་པ་ལ་མདུན་མ་ལེགས་སོ་ཟེར་གྱིན་གདའ་ན།",
    "དཔོན་མོ་བཞི་ཙམ་གྲུལ་བཏུབ་མ་བྱུང་།",
    "ལྕམ་དྲུང་གི་བགེགས་སྐྲོད་དེ་བྱས།",
    "ཧ་ཧ་ཧ་དགོད་རེ་བྲོ།",
    "སྨད་མི་ཤེས་ཀྱིས་སྨད་པ་ཟེར་བ་དེ་འདྲ་ཞིག་ཡོང་གིན་གདའ།",
    "རེ་ཞིག་ངན་སོང་སྤྱོད་རྒྱུད་ལས།",
    "གདོན་དང་ལོག་འདྲེན་དག་གིས་ཀྱང་།",
    "མི་གང་སྔགས་ཀྱི་རྒྱུད་དག་གི།",
    "སྟག་མོ་བུ་ཟན་ལྟ་བུར་འཇིགས་པ་དེ།",
    "མ་མོ་རྣམས་ཀྱི་ཁ་རུ་གདབ་བྱ་ཡིན།",
