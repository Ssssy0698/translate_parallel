    "མ་གིར་སླེབ་དུས་བོན་གོང་ནས་སོགས་གྲོས་པ་འགའ་རེ་དེ་དུས་ངེད་སླེབ་པ་ལ་མི་དགའ་བའི་རྣམ་འགྱུར་བྱེད་སླེབ་མི་ཡོང་བ་གཞིར་བཞག་གིས་འབོད་མཁན་བཏང་བ་ཡིན་འདུག་ནའང་།",
    "རང་རེའི་སེམས་ལ་ནི།",
    "ཡང་ད་རེས་བཤོལ་འདེབས་ངེད་ལ་རེ་དོན་རང་མེད་པ་འདྲ།",
    "འོན་ཀྱང་ཁོང་ཚོའི་ཟེར་ཚུལ་ཙམ་ནི་ཞུས།",
    "དེ་མཚམས་དབུས་ཕྱོགས་ཐེགས་མི་ཐེགས་ཐེ་ཚོམ་ལྡིང་དེ་བའི་ངང་ནས་དཔོན་གཡོག་རྣམས་ཕེབས་སོང་།",
    "སྣང་ཐང་གི་རྟེན་མཇལ་མ་བྱས་པར་ཡུན་རིངས་ལོན་པས་ཡར་ལམ་སྣར་ཐང་གི་རྟེན་མཇལ་བྱས།",
    "ཧོར་ཟླ་ལྔ་པའི་ཉེར་དགུ་གནམ་གང་ལ་རྒྱབ་རིའི་རྩེ་མོར་ཞག་སྡོད་བྱས་ཤིང་།",
    "འདི་རེས་ཀྱང་ཙམ་རྩམ་ཁལ་བརྒྱ་ལྷག་ཙམ་སོང་།",
    "གཞན་ཡང་ལོ་འདིའི་ནང་དུ་རྟག་བརྟན་གྱི་ལྷ་ཁང་ཤར་མ་གསུམ་གྱི་སྟེང་གི་ལོགས་བྲིས་དང་།",
    "བསྙེན་སྒྲུབ་གང་ཡང་མ་སོང་བའི་འཆོལ་པ་འགའ་ཞིག་ཚོགས།",
    "དགའ་སྟོན་ཡིན་ཟེར་མི་འགའ་ཞིག་གིས་ལྐོག་ཟས་གྲུབ་པ་དང་།",
    "རྟེན་བཞེངས་མཁན་རང་ལ་འབུལ་བ་འདྲ་ཡོང་ལ་རེ་ཞིང་།",
    "རྟེན་མཇལ་གཏོང་ནའང་མི་རྣམས་ཁ་སྟོང་གྲོང་སྟོང་ལ་ཐལ་བ་ཕྱུ་རེ་གཏོང་མཁན་དུ་མང་བ་འདུག་སྟེ།",
    "རྟེན་བཞེངས་ཆེ་ཙམ་རེ་བྱས་པ་ལ།",
    "རབ་གནས་དངོས་དེ་གསང་སྒྲོགས་སུ་མ་སོང་བ་རང་བྱས།",
    "ཟླ་ཕྱེད་ཙམ་ལ་རེ་རེ་གྲུབ་པ་སོགས་ཟླ་བ་གསུམ་ལྷག་ཙམ་གྱི་ཁོངས་སུ་ཐམས་ཅད་གྲུབ།",
    "ལོ་འདི་ནང་ཅུང་རི་བོ་ཆེ་ཞོལ་པ་སྐོར་ཐམས་ཅད་ཀྱང་རང་རེའི་འོག་ཏུ་བྱུང་།",
    "སྔར་མི་གྲོག་པོ་རང་ཚོས་ཡ་རི་མ་རི་ཅི་བྱེད་འདི་བྱེད་མེད་པ་བྱས་པ་ལ་དོན་འདོར་ཏེ་སྟོངས་སོང་།",
    "ངས་ཀྱང་ཁོང་རང་ཚོའི་འདོད་ཐོག་ཏུ་བཞག་པས།",
    "ཁོང་ཚོའི་སྦྱོར་དྲུག་དེ་ཟོ་གྱོ་ལེ་བ་ཞིག་ལས་མ་བྱུང་།",
    "ཡིན་ནི་རང་གིས་རང་ལ་བསླུས་གཏོང་བ་དེར་འདུག།",
    "དེ་བཞིན་དུ་མགོན་ཁང་ཆེན་མོའི་ལོགས་བྲིས།",
    "ཉིན་མོ་བས་ཀྱང་མཚན་མོ་སྲོད་ལ་མདངས་གསལ་བར་བྱུང་འདུག།",
    "དེ་རེས་མགོན་ཁང་གི་ལོགས་བྲིས་འདི་སྐབས་ཀྱང་།",
    "རི་མོ་བ་རྣམས་ངལ་དུབ་ཀྱང་མེད་ཅིང་།",
    "གཡོག་བུ་རྟ་མང་གིན་ཞེ་མྱང་།",
    "ཨ་རེ་རེ་ཨ་རེ་རེ།",
    "ཀྱིས་རྙེད་པ་གང་དྲག་བྱས་སྐབས་འདིར་ལི་ཏི་ཐུབ་སྐྱེལ་མ་བཏང་ནས་རྒྱ་གར་ལ་ཐེགས་སོང་།",
    "རྗེ་པཎ་ཆེན་དབེན་རྩ་ནས་ཀྱང་བྱང་ཁ་ལ་ཕེབས་སོང་བ་ལ་ཇ་ཞུས་འབུལ་མཁན་བཏང་།",
    "བར་སྐབས་དེར་ངན་སོང་སྦྱོང་རྒྱུད་རང་ཐང་སྤྱོད་རྒྱུད་ལུགས་དང་།",
    "གཙུག་ལག་ཁང་ཆེན་མོའི་སྒོ་ཁང་གི་སྒོ་སྒྲིགས་ཀྱི་ནང་ལ།",
    "ཁྲོ་རྒྱལ་ལྷ་ཁང་གི་གཙང་ཁང་དུ་དགྲ་གདོང་འཇིགས་གསུམ་གྱི་ལྷ་ཚོགས་བཀའ་སྲུང་དང་བཅས་པ་དང་།",
    "པའི་གདུག་པ་ཅན་འགའ་རེ་ཐུལ་འགྲོ་བའི་ལྟས་ཀྱང་བྱུང་།",
    "མཆོད་གཞིས་ཁོག་གི་ཁྱུ་འཛིན་ཐམས་ཅད་དང་།",
    "སྤྱིར་ངེད་ཀྱི་སྲོལ་ལ་རྩོམ་པ་ཆེ་བ་རེ་བྱེད་འདོད་ཡོད་ན།",
    "འདི་རེས་ཀྱང་དེ་སྐབས་སྣང་བ་ཐོབ་པ་ནི་ཡིན་ཀྱང་།",
    "ཁེབས་བཀབ་པ་བཞིན་དུ་ཡུད་རེ་གང་ཡང་མི་དྲན་པའི་རྣམ་པར་འགྲོ་བ་ཡང་ལན་འགའ་རེ་བྱུང་།",
    "ཕྱི་ལོགས་ནས་བུད་མེད་ཤིན་ཏུ་ཆེ་བ།",
    "གདོང་གི་དཔངས་ལའང་ཁྲུ་གསུམ་ཙམ་ཡོད་པ།",
    "ཧེ་ཧེ་ལགས་ཞེས་གད་མོ་རྒོད་པའི་ཚུལ་བྱེད་པ་ཞིག་མངོན་སུམ་དུ་བྱུང་།",
    "ལར་འདིའི་སྐབས་སུ་ཐོག་མ་ལུས་ལ་གཉན་ལྷོག་གི་འབུ་རུ་ཐེབས་ཤིང་།",
    "ཁྲིད་འཛུགས་ཁར་ཉིན་ཞིག་ལ་དྲག་སོང་།",
    "འདུལ་ལུང་ན་ལྷ་སྦྱིན་གྱི་ལྷོ་ཕྱོགས་པའི་སྒྱོགས་མཁན་ལ་མུ་ཏིག་གི་དོ་ཤལ་སྲང་བརྒྱ་སྟོང་རེ་བ་བྱིན་ཞེས་པ་དེ་ཡང་འདི་འདྲ་ཞིག་ཡིན་པ་འདུག་པ་སྙམ་པ་ཞིག་ཝལ་ཝལ་བྱུང་།",
    "སྟེང་ཐད་རང་ལ་འཇའ་འོད་སྒོར་མོ་སོགས་ཀུན་གྱིས་མཐོང་བ་དེ་ཡིན།",
    "འགའ་ཞིག་མེ་ཏོག་གི་ཆར་འདུག་ཀྱང་ཟེར།",
    "གང་ལྟར་ནའང་ཕྱི་ནང་གི་ལྟས་ཐམས་ཅད་ལེགས་པར་འདུག།",
    "ལྷའམ་མི་མཆོག་གི་སྐྱེ་བ་བརྙེས་པར་ཐག་ཆོད།",
    "དགུན་དུས་ཀྱི་གྲང་རེག་ཆེ་བས་འགྲོ་མི་ཐུབ་པར་བྱས་ནས།",
    "ད་རེས་མིན་པ་ཕྱིས་མི་འཕྲད་པར་གོ་བས།",
    "ཡར་ལམ་ཤུན་ཞབས་དྲུང་གིས་ཤོག་གསུངས་ནས་རོག་ཚོ་ལ་འགྲོ་རྩིས་ཡིན་ཡང་།",
    "ཞིང་གི་རྣམ་པར་ཞིག་ཡིན་པར་འདུག།",
    "དཀྱིལ་ཆོག་གི་ཕྱེད་ཙམ་སོང་།",
    "རང་རེས་སྒྲིག་པའི་ཟུང་འཇུག་རབ་གསལ་གྱི་འཛུག་ཁྲིད་དང་།",
