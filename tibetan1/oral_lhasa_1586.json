    "ཀུ་མུ་ཏ་ཟུམ་པར་བྱེད་པ་ལྟར།",
    "གདུལ་བྱ་མ་ཡིན་པའི་ཀུ་མུ་ཏ་ཟུམ་པར་བྱེད་པ་འདི་ལྟར་བྱའོ་སྙམ་པའི་རྣམ་པར་རྟོག་པ་མེད་པར་འཇུག་གོ།",
    "དཔེ་ཇི་ལྟར་རྒྱང་རིང་པོ་སྣང་བར་བྱེད་པས་རྒྱ་ཆེན་པོ་འོད་ཟེར་སྟོང་དང་ལྡན་པའི་ཉི་མ་ཤར་བའི་སྐབས་འདིར་དེའི་འོད་ཟེར་གྱིས་གླིང་བཞི་པའི་འཇིག་རྟེན་ཀུན་ཏུ་སྣང་བར་བྱས་ནས་འབབ་བོ།",
    "མཐར་ལོག་པར་ངེས་པ་ལའང་འབབ་བོ།",
    "བཞི་པ་དཔེ་ལས་ཁྱད་པར་འཕགས་པ་ནི།",
    "ཕྱོགས་བཅུའི་ཞིང་ཀུན་གྱི་ནམ་མཁའི་མཐིལ་ཁྱབ་པར་འོད་ཟེར་སྤྲོ་བའི་ནུས་པ་ཉི་མ་ལ་མེད་ལ།",
    "མི་ཤེས་པའི་མུན་པས་བཀབ་པའི་འགྲོ་བ་རྣམས་ལ་ཤེས་བྱའི་དོན་སྟོན་པར་མཛད།",
    "རྙེད་པར་དཀའ་བ་བསྟན་པའོ།",
    "ཇི་ལྟར་ནོར་བུ་རིན་ཆེན་དེ་སྦྱིན་སྙམ་པའི་རྟོག་པ་མེད་ཀྱང་ཇི་ལྟར་འདོད་པའི་ནོར་འབད་པ་མེད་པར་གཞན་དག་ལ་རབ་ཏུ་སྟེར་བ་ལྟར།",
    "དེ་བཞིན་དུ་ཐུབ་པས་འབད་མེད་དུ་ཇི་ལྟར་འོས་པར་དོན་མཛད་པའི་སྒོ་ནས་གཞན་གྱི་དོན་དུ་སྲིད་པ་ཇི་སྲིད་བར་རྟག་ཏུ་བཞུགས་སོ།",
    "རྒྱུན་མི་ཉམས་པར་བརྟན་པ་དང་།",
    "ཐུགས་མཁྱེན་བརྩེས་ཁྱབ་པ་དང་།",
    "རྣམ་པར་རྟོག་པ་མེད་པའི་ཐུགས།",
    "རྣམ་པར་རྟོག་པ་མེད་པའི་ཐུགས་ནི་གཏན་ཚིགས་སུ་འགོད་དོ།",
    "དེས་ན་རྟོག་པ་མེད་པར་དོན་བྱེད་པ་ལ་འབད་རྩོལ་མི་དགོས་པས་ཁྱབ།",
    "ས་གཞི་བཞིན་དུ་འབད་རྩོལ་མེད་པར་གཞན་དོན་བྱེད་པ་དང་།",
    "ཁྱབ་བདག་མཁྱེན་པ་དང་བརྩེ་བ་ཆེན་པོའི་ཐུགས་ཀྱིས་མཐའ་ཡས་པའི་འགྲོ་བ་ལ་ཐ་ན་གཟུགས་མེད་ཅིང་སེམས་ཕྲ་བ་སྲིད་རྩེའི་བར་དུ་ཁྱབ་པ་ནི་ནམ་མཁའ་ལ་ཁྱབ་པའི་སྤྲིན་གྱི་ཚོགས་དང་འདྲའོ།",
    "སྔ་ཕྱིའི་རིམ་པ་ཡང་འོག་ནས་བརྗོད་པར་འགྱུར་བ་འདི་ཡིན་ཏེ།",
    "མཁྱེན་བརྩེས་ས་སྟེང་སོགས་ཐམས་ཅད་དུ་ཁྱབ་ནས་དོན་བྱེད་པ་ནི་སྤྲིན་ཆེན་པོ་དང་མཚུངས་སོ།",
    "སླར་མི་ལྡོག་པར་སྨིན་པར་བྱེད་པའི་ཆ་ནས་ཉི་མའི་གཟུགས་བཞིན་ནོ།",
    "ཐོབ་ཅིང་རྙེད་པར་དཀའ་བའི་ཆ་ནས་སྒྲ་བརྙན་བཞིན་ནོ།",
    "ཐོབ་དཀའ་བའི་ཆ་ནས་སྒྲ་བརྙན་དཔེར་བྱས་ཀྱི།",
    "རྐྱེན་གྱིས་མ་བྱས་པའི་དཔེ་ནི་ནམ་མཁའ་དང་འདྲའོ།",
    "རྟོགས་པར་དཀའ་བ་དང་།",
    "ཤེར་ཕྱིན་གྱིས་མ་ཟིན་པའི་སྦྱིན་པ་ལས་ལོངས་སྤྱོད་ཙམ་སྒྲུབ་པར་བྱེད་ཅིང་།",
    "རྒྱལ་བ་ཉིད་ཀྱིས་མཁྱེན་པའི་ཡུལ་རྣམ་པ་བཞི་པོ་སྔར་ཇི་སྐད་བརྗོད་པ་འདི་ལ།",
    "བསམ་པ་སེམས་བསྐྱེད་ཁྱད་པར་ཅན།",
    "སྦྱོར་བ་སྦྱིན་སོགས་ཁྱད་པར་ཅན་དུ་སྒྲུབ་པའོ།",
    "སྤྲོས་པ་གཅོད་པའི་རིགས་པ་ལ་བརྟེན་ནས་བག་ཆགས་འབའ་ཞིག་པའི་བདག་ཉིད་ཀྱི་བར་གྱི་སྒྲིབ་པ་ཐམས་ཅད་དག་པར་བྱ་བའི་ཕྱིར་དང་།",
    "ཚིག་ཐོགས་མེད་དུ་མཁྱེན་པ་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པ་སྟེ།",
    "ཤེས་བྱའི་རྣམ་པ་ཐོགས་མེད་མཁྱེན་པ་སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པའི་འོད་ཀྱིས་ཤེས་བྱ་ཀུན་གསལ་བར་མཁྱེན་པའོ།",
    "དེ་ཁོ་ན་ཉིད་ཀྱི་མཆོག་ཇི་ལྟ་བ་ཐམས་ཅད་ཚུལ་བཞིན་དུ་ཀུན་མཁྱེན་ཉིད་ཀྱིས་མཁྱེན་གྱི་གཞན་གྱིས་ཤེས་པ་མིན་པ་དེའི་ཕྱིར།",
    "སྦྱར་ན་ཡང་དག་པའི་ལྟ་བ་ལ་འཇུག་པར་དཀའ་བའི་ཉེས་པ་ཡོད་དེ།",
    "དྲང་དོན་ལ་དེ་ཁོ་ན་ཉིད་ཀྱི་དོན་དུ་ངེས་པར་འཛིན་པའི་ཕྱིར་དང་།",
    "ཐོག་ལའང་ཤིན་ཏུ་འཇིགས་པར་མི་བྱ་སྟེ།",
    "དེ་རྣམས་ལས་ཚེ་ཕྱི་མར་མནར་མེད་རྣམས་ཀྱི་འགྲོ་བ་ཤིན་ཏུ་འཇིགས་པར་འགྲོ་བར་མི་འགྱུར་ལ།",
    "རང་བཞིན་གྱིས་རྣམ་པར་བྱང་བའི་ཁམས་དང་།",
    "ཀུན་མཁྱེན་གཉིས་པ་རོང་སྟོན་ཆེན་པོས་སྦྱར།",
    "སྨྲ་བའི་སེང་གེ་ཐམས་ཅད་མཁྱེན་པ་གཉིས་པས་དཔལ་ལྡན་གསང་ཕུར་སྦྱར་བའོ། བལ་ཡུལ་མཆོད་རྟེན་ཉེ་འདབས་ནས་རྒྱལ་ཡོངས་ས་ཆེན་ཞེས་པ་ལས།",
    "ཐུགས་རྗེའི་མཁྱེན་ཡངས་སྟོབས་བཅུའི་སྟོབས་ལྡན་ཞིང་།",
    "མ་ལུས་མཁྱེན་པའི་ཟླ་འོད་རབ་རྒྱས་པ།",
    "མཁྱེན་པའི་ཆུ་འཛིན་རོལ་པས་ལེགས་བཟུང་ཞིང་།",
    "མཁྱེན་པའི་ཆུ་གཏེར་གཏིང་མཐའ་མི་མངོན་ཞིང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ལེགས་པར་གསུངས་པའི་གླེགས་བམ་དུ་མ་ཞིག་སྤྲང་པོ་ཉི་མའི་དངོས་གྲུབ་ཀྱིས་བསྲེགས་པའི་ལྷག་མ་ཅུང་ཟད་རྙེད་པའི་དོན་བསྡུས་ནས་སྟོན་པ།",
    "ཡུལ་སྣ་ཚོགས་སུ་གང་ཟག་སྣ་ཚོགས་ལ་གསུངས་པའི་གླེགས་བམ་དུ་མ་ཡོད་པའང་།",
    "ཀཱ་རི་ཀཱ་ཚིག་ལེའུར་བྱས་པའོ།",
    "ངན་འགྲོའི་སྲིད་ལས་སྐྱོབ་པར་བྱེད་པ་གང་།",
    "སྐབས་འདིར་ཡིད་ཤེས་འཁོར་དུ་བྱས་སོ།",
    "འདི་ནི་དང་པོ་སྟོན་པས་གསུངས་ནས་དགྲ་བཅོམ་པ་བདུན་གྱིས་བསྡུས་པ་ཡིན་ཏེ།",
    "ལམ་བདེན་མ་གཏོགས་པའི་འདུས་བྱས་རྣམས་ནི་ཟག་བཅས་ཞེས་བྱ་སྟེ།",
    "ལམ་གྱི་བདེན་པ་དང་འདུས་མ་བྱས་རྣམ་པ་གསུམ་ཡང་ཡིན་ནོ།",
    "ཟག་པ་རྒྱས་པར་མི་འགྱུར་བའི་ཕྱིར།",
    "འདུས་མ་བྱས་གསུམ་པོ་དེ་ལ་ནམ་མཁའ་ནི།",
    "ལམ་མ་གཏོགས་པའི་འདུས་བྱས་རྣམས་ཞེས་གསུམ་པའི་འདུས་བྱས་དེ་དག་གང་ཞེ་ན།",
