    "རྒྱལ་པོ་ཕ་དང་སྲིང་མོ་སྤུན་དང་གཞོན་ནུ་བུ་མོ་རྣམས།",
    "སྲིང་མོ་དང་།",
    "དེ་དག་བདག་གི་ཆུང་མ་ལ་སོགས་གཡོག་ཚོགས་ལ།",
    "མི་ཡི་ཡུལ་དུ་བྲན་ཉིད་སྤངས་ནས་སྐད་ཅིག་གིས་ནི་དམའ་བར་འགྱུར།",
    "ཚིག་གི་ཡོན་ཏན་གཟུང་འོས་རྔ་སྒྲར་བཅས་ཤིང་ཚེ་རབས་ཀུན་དུ་ཕན།",
    "བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ནས་པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཐད་ནས་སོང་ངོ།",
    "དེ་རང་གི་ཁྱིམ་དུ་སོང་ནས་ཕ་མ་གཉིས་ཀྱི་རྐང་པ་ལ་ཕྱག་བྱས་ཏེ་ཐལ་མོ་སྦུག་སྦུག་པོར་སྦྱར་ནས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "དེ་ནས་སྤོབས་པའི་བློ་གྲོས་ཀྱིས་རང་གི་ཆུང་མ་པད་མ་གཡོག་འཁོར་དང་བཅས་པ་ལ་བསྒོ་བ།",
    "བླ་རེ་དྲེ་བ་དང་།",
    "དེ་གང་གིས་ཀྱང་ཅི་ཡང་མ་བྱིན་ནས།",
    "དེ་ཁྲོས་ཏེ་ཕྱིར་བྱུང་ནས་འདི་སྙམ་དུ་ཀྱེ་མ་སྡུག་བསྔལ་བ་བདག་ལ་གང་གིས་ཅི་ཡང་མ་བྱིན་པ་ནི།",
    "བདག་ལ་གང་དག་གིས་བཟའ་བ་དང་།",
    "ཡུལ་གཞན་ཞིག་ཏུ་སོང་ནས་ཕ་ཟད་ཚུ་ཟད་ཙམ་གྱི་ཕྱོགས་སུ་ཉལ་བར་གྱུར་ཏོ།",
    "གྲོགས་པོ་དག་ཁྱེད་ཅག་གིས་སྤྲིན་སྔོན་པོའི་དཀྱིལ་འཁོར་གྱིས་ཁེབས་པ་དགའ་ཞིང་གསལ་བའི་ཕྱོགས་དེ་མཐོང་ངམ།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "དེ་ནས་དེ་དག་གིས་མལ་གྱི་རྐང་རྟེན་ལ་རྐང་པ་བཞག་པ་དེ་སྟན་བཟང་པོ་ལ་འདུག་ཏུ་བཅུག་ནས།",
    "ནོར་བུ་ཅན་གྱི་རྔ་མའི་བསིལ་ཡབ་དག་གིས་གཡོབ་ཅིང་།",
    "རྒྱལ་པོའི་མིང་གིས་ཡོན་ཏན་ཐམས་ཅད་འབྱོར་ཅིང་ལྡན་པར་གྱུར་ལ།",
    "དགའ་དགུར་སྤྱོད་པ་དེ་འདི་སྙམ་དུ་འདི་གང་གི་མཐུ་ཡིན།",
    "བདག་གི་རྒྱལ་སྲིད་སྐལ་བ་བཟང་པོ་དང་ལྡན་པ་འདི་གང་གིས་བྱུང་བར་གྱུར་སྙམ་པ་དང་།",
    "རང་གི་ཁྱིམ་གྱི་བར་དུ་བར་དེར་བཅོམ་ལྡན་འདས་ཀྱི་ཐམས་ཅད་དང་ལྡན་པའི་ལམ་ཆག་ཆག་བཏབ་ཅིང་།",
    "སྐྱེད་མོས་ཚལ་ཆེན་པོས་ཡོངས་སུ་བསྐོར་བར་གཤེགས་སུ་གསོལ་ནས།",
    "བདག་གི་རྒྱལ་སྲིད་ཕུན་སུམ་ཚོགས་པ་འདི་ག་ལས་མཆིས་ལགས།",
    "དེས་དུས་གཞན་ཞིག་ན་རང་གི་ཁྱིམ་དུ།",
    "གཅིག་གི་མགོ་ཁྱེད་ཀྱིས་ཤིང་རྟའི་འཁོར་ལོས་ཆོད་པ་ཞེས་བྱ་བའི་བར་དུའོ།",
    "ཁྱོད་ཀྱིས་ནི་རྒྱལ་པོའི་དཔལ་ཐོབ་སྟེ།",
    "ཡིད་ནི་དུག་གི་རྩ་བ་ཡིན།",
    "ངག་ཡིད་དག་གིས་སྡིག་བྱས་པ།",
    "ཉོན་མོངས་པ་དག་དེ་ལྟར་འགྱུར།",
    "འཁོར་ལོས་སྒྱུར་སོགས་གོ་འཕང་གི།",
    "ཐམས་ཅད་ཐོབ་ནས་ཁྱོད་བཞིན་ནོ།་",
    "གཞན་སྟོང་ཕྲག་མང་པོ་ཞིག་གིས་ནི།",
    "གཙུག་ལག་ཁང་གི་སྐྱབས་ཤིག་ཏུ།",
    "རིགས་ཀྱི་བུ་མོ།",
    "༩༦ཀྲུང་གོའི་བོད་རིག་པ་ཞིབ་འཇུག་ལྟེ་གནས་ཀྱི་བཀའ་བསྟན་དཔེ་སྡུར་ཁང་གིས་དཔེ་བསྡུར་ཞུས།",
    "། རྣམ་འདྲེན་བཞི་པ་ཤཱཀྱའི་ཏོགདེབ་གོ་དྲུག་པའི་དཀར་ཆགསྐྱེས་རབས། གི་",
    "བཙུན་མོའི་འཁོར་ན་གནས་པའི་ལེའུ།",
    "བུད་མེད་ཀྱིས་གེགས་བྱས་པའི་ལེའུ།",
    "བཙུན་མོའི་འཁོར་སྨྲེ་སྔགས་བཏོན་པའི་ལེའུ།",
    "བཟོ་སྦྱངས་སྔོན་དུ་སོང་བའི་ལེའུ།",
    "ཨ་མྲ་སྐྱོང་མའི་ནགས་གཟིགས་པའི་ལེའུ།",
    "༤༣༦བསྡུར་འབྲས་རེའུ་མིག་༤༤༤ཕབ།",
    "༤༤༩བསྡུར་འབྲས་རེའུ་མིག་༤༤༩༣༣༩༡ སྦྱིན་པའི་གཏམ།",
    "༤༥༢བསྡུར་འབྲས་རེའུ་མིག་༤༥༢༣༣༩༢ སྲིད་པ་ལས་འདས་པའི་གཏམ།",
    "༤༥༥བསྡུར་འབྲས་རེའུ་མིག་༤༥༥༣༣༩༣ ཡོན་ཏན་བདུན་ཡོངས་སུ་བརྗོད་པའི་གཏམ།",
    "༤༧༣བསྡུར་འབྲས་རེའུ་མིག་༤༧༤༣༣༩༦ ཚོགས་ཀྱི་གཏམ།",
    "༤༨བསྡུར་འབྲས་རེའུ་མིག་༤༨༣༣༩༧ མི་ཁོམ་པ་བརྒྱད་ཀྱི་གཏམ།",
    "ཕྱག་གི་གཏམ།",
    "༥༢༢བསྡུར་འབྲས་རེའུ་མིག་༥༢༤༣༣༩༩ ཕྱིན་ཅི་ལོག་བཞི་སྤང་བའི་གཏམ།",
    "༥༣༡བསྡུར་འབྲས་རེའུ་མིག་༥༣༢༣༤ རྩོད་པའི་དུས་ཀྱི་གཏམ།",
    "༥༣༦བསྡུར་འབྲས་རེའུ་མིག་༥༣༦༣༤༡ དབེན་པའི་གཏམ།",
    "༥༥༥བསྡུར་འབྲས་རེའུ་མིག་༥༥༦༣༤༣ ཆེད་དུ་བརྗོད་པའི་གཏམ།",
    "༥༥༩བསྡུར་འབྲས་རེའུ་མིག་༥༥༩༣༤༤ མི་རྟག་པའི་དོན་གྱི་གཏམ།",
    "༥༦༡བསྡུར་འབྲས་རེའུ་མིག་༥༦༡༣༤༥ ལེགས་པའི་ལམ་བསྟན་པའི་གཏམ།",
    "༦༣༨བསྡུར་འབྲས་རེའུ་མིག་༦༣༩༣༤༧ མྱ་ངན་བསལ་བ།",
    "༦༦༨བསྡུར་འབྲས་རེའུ་མིག་༦༦༨༣༤༡༢ བཤེས་པའི་སྤྲིང་ཡིགསློབ་དཔོན་འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱིས་༦༦༩མཛད།",
    "༧༤བསྡུར་འབྲས་རེའུ་མིག་༧༦༣༤༡༤ རྒྱལ་པོ་ཆེན་པོ་ཀ་ནིས་ཀ་ལ་སྤྲིངས་པའི་སྤྲིང་ཡིག་༧༧སློབ་དཔོན་མ་ཏི་ཙི་ཏྲས་མཛད།",
    "ཞུ་ཆེན་གྱི་ལོ་ཙཱ་བ་བན་དེ་༡ བར་ན་རིན་ཆེན་མཆོག་གིས་བསྒྱུར།",
    "ཉོན་མོངས་པ་སྤོང་བའི་ལེའུ།",
    "༧༤༧བསྡུར་འབྲས་རེའུ་མིག་༧༤༨༣༤༡༧ བུ་ལ་སྤྲིང་བ།",
    "༩༣༤བསྡུར་འབྲས་རེའུ་མིག་༩༣༦ལོ་༣༤༢༣ ལྷོ་ཟ་མོ་ཚངས་དབྱངས་ལ་སྡུག་བསྔལ་གྱི་བྱེ་བྲག་བསྟན་པ་བཞུགས་སོ།",
    "༩༤༢བསྡུར་འབྲས་རེའུ་མིག་༩༤༢དེབ་གོ་དྲུག་པའི་དཀར་ཆག་༩༤༨༣༤༢༤ རྗེ་འབངས་དང་བོད་བཙུན་རྣམས་ལ་སྤྲིང་ཡིག་བཞུགས་སོ།",
    "༩༥༣བསྡུར་འབྲས་རེའུ་མིག་༩༥༥༣༤༢༥ དད་སྐྱེད་སྒྲོན་མ་བཞུགས་སོ།",
    "༩༧༧བསྡུར་འབྲས་རེའུ་མིག་༩༧༨༣༤༢༧ མྱ་ངན་མེད་པའི་སྒོ་ནས་ཀླུ་བཏུལ་བའི་ལེའུའོ།",
    "༩༩༩བསྡུར་འབྲས་རེའུ་མིག་༡༣༤༢༩ གནས་བརྟན་སྤྱན་དྲང་བ།",
    "༡༢༢བསྡུར་འབྲས་རེའུ་མིག་༡༢༥༣༤༢ བསྟན་པའི་གཏད་རབས་བཞུགས་སོ།",
    "༡༤༧བསྡུར་འབྲས་རེའུ་མིག་༡༤༩༣༤༣༢ ལི་ཡུལ་ལུང་བསྟན་པ་བཞུགས་སོ།",
    "༡༩༩བསྡུར་འབྲས་རེའུ་མིག་༡༡༦ག་། མཚན་མ་ཡང་དག་བླངས་ཀུན་ལས།",
    "བུདྡྷ་ཙ་རི་ཏ་མ་ཧཱ་ཀཱ་བྱ་ནཱ་མ།",
    "ནུས་མཐུ་རྗེས་མཚུངས་གཟི་བརྗིད་ལྷ་མོ་བདེ་སོགས་དང་།",
    "སྐྱེས་རབས། གི་",
    "ལྷ་དང་རབ་ཏུ་མཚུངས་པ་དེ་ཡི་ལྷ་མོ་དེ།",
    "རབ་ཏུ་བལྟམ་པཔའི་དུས་ནི་ཡང་དག་མངོན་གཟིགས་ཤིང་།",
    "བླ་རེ་ཉེ་བར་ཕུལ་བའི་གཟིམས་མལ་རབ་ཐོབ་སྟེ།",
    "བརྟུལ་ཞུགས་ལེགས་པར་འདུས་བྱས་ལྷ་མོ་དེ་ཡི་ནི།",
    "རི་བོང་གིས་མཚན་ཇི་ལྟར་མིག་དག་འཕྲོགས་པར་གྱུར།",
    "དེ་ནི་རང་གི་ལུས་ཀྱི་འོད་རབ་འབར་བ་ཡིས།",
    "འདི་ནི་བདག་གི་སྲིད་པའི་སྐྱེ་བ་ཐ་མ་ཞེས།",
    "སེང་གེའི་འགྲོས་འདྲ་ཕྱོགས་བཞི་དག་ཏུ་རྣམ་གཟིགས་ནས།",
    "ལུས་ལ་ཡང་དག་རེག་པས་བདེ་བ་བསྐྱེད་པའི་ཕྱིར།",
    "དཔལ་ལྡན་བླ་རེ་བྲེས་པར་གསེར་གྱིས་འབར་ཞིང་མཚན།",
    "གང་གི་མཐུ་ལས་མགོ་བོ་ཡིས་ནི་རབ་བཏུད་ཅིང་།",
    "གང་གིས་རབ་ཏུ་བལྟམས་ཚེ་རི་རྒྱལ་ཕུར་བུ་ཉིད།",
    "ཤར་དང་བྱང་གི་མཚམས་ཀྱི་ཁང་པའི་ཕྱོགས་གཅིག་ན།",
    "མི་བདག་བརྟན་པ་ཡིན་ཡང་རྣམ་པར་འགྱུར་ནས་སོང་།",
    "ལྷ་མོ་འཇིགས་པ་དང་ནི་དགའ་བས་གང་བར་འགྱུར།",
    "བུད་མེད་རྒན་མོ་རྣམས་ཀྱིས་བདེ་ལེགས་གྱུར་བྱས་ཤིང་།",
    "ཁྱོད་ཀྱི་སྒྲོན་མ་འདི་ནི་རིགས་ཀྱི་སྒྲོན་མ་སྟེ།",
    "འདི་ནི་ཁྱོད་ཀྱི་བུ་ཞེས་སྐྱེས་པར་གྱུར་པ་སྟེ།",
    "སྒྲོན་མའི་འོད་ཟེར་དག་གིས་མཚན་རྣམས་གང་གྱུར་པས།",
    "དེ་ལྟར་ཁྱོད་ཀྱི་སྲས་ནི་རྐང་གཉིས་རྣམས་ཀྱི་མཆོག།",
    "གང་གི་སྤྱན་དག་མི་འཛུམས་མིག་༧ གཟིར་རྣམ་པར་སྤངས་པ་སྟེ།",
    "འདི་ནི་ཀུན་ནས་གཟིགས་པའི་སྤྱན་མངའ་ཅི་ལ་མིན།",
    "འདིར་ཡང་བདག་གི་དཔེར་བརྗོད་དག་ནི་མཁྱེན་པར་མཛོད།",
    "དེ་དག་གི་སྲས་ཞི་བ་པ་ཝ་སངས་དང་ནི།",
    "ནུས་མེད་གནས་འཇོག་གིས་ནི་མ་བྱས་གྱུར་པ་གང་།",
    "ཚིག་གི་རྐང་པ་གྲོག་མཁར་གྱིས་ནི་དང་པོར་བསྐྱེད།",
    "ཁྱབ་འཇུག་གི་ནི་གྲགས་པའི་ལས་རྣམས་གང་ཡིན་པ།",
    "དེ་དང་དེ་དག་རྣམས་ནི་བུ་རྣམས་དག་གིས་བྱས།",
    "དེ་ནི་ས་བདག་བཙུན་མོའི་འཁོར་གྱི་ཉེ་ལོགས་སུ།",
    "དེ་ནས་ཐུབ་པ་གདན་ལ་གནས་པ་དེ་ལ་མི་སྐྱོང་གིས།",
    "བདག་གི་རིགས་ནི་རྗེས་སུ་བཟུང་ཕྱིར་ནོར་ལྡན་དེས།",
    "གང་ཞིག་བདག་ལ་གཟིགས་ཕྱིར་བཅོམ་ལྡན་ཉེར་གཤེགས་ལ།",
    "དེ་ལྟར་མི་སྐྱོང་གིས་ནི་དངོས་པོ་ཐམས་ཅད་ཀྱིས།",
    "སེམས་པ་རྗེས་འགྲོ་ཡེ་ཤེས་ལང་ཚོ་རྗེས་མཐུན་པ།",
    "ཁྱོད་ཀྱི་བློ་གྲོས་གཉེན་གང་དེ་ལྟར་བདག་ལ་ཡིན།",
    "དེ་དང་དེ་ནི་གང་གིས་མི་སྐྱོང་དྲང་སྲོང་དེས།",
    "དཀའ་ཐུབ་རྣམས་ཀྱིས་ཕྱུག་ཅིང་ནོར་རྣམས་དག་གིས་དབུལ།",
    "བདག་གི་ཉེ་བར་འོངས་ལ་དགོས་པ་གང་ཡིན་པ།",
    "བདག་གི་དེ་ནི་གསོན་མཛོད་དགའ་བར་ཉེར་སོང་ཁྱེད།",
    "ལྷ་ཡི་ངག་དག་བདག་གི་ཉི་མའི་ལམ་དུ་ཐོས།",
    "ལྷ་མོའི་པང་ན་ཞུགས་པ་མེ་ཡི་བུ་བཞིན་དུ།",
    "སྐྱེས་རབས། གི་",
    "གང་གི་ལུས་ནི་ལྷ་ལས་བར་ན་ཅུང་ཟད་ཅིག།",
    "རང་གི་སྐྱེ་བ་ངོ་མཚར་མང་པོའི་སྒྲོན་མ་སྟེ།",
    "གང་གི་དོན་ནི་མཆོག་ཏུ་འགྱུར་བར་སྨྲ་བ་སྟེ།",
    "བདག་གི་མྱ་ངན་ཆེད་དུ་སྐྱེས་པ་མིན་ནམ་ཅི།",
    "བདག་གི་སྙན་གྲགས་གཏེར་ནི་མི་ཟད་ཡིན་སྙམ་མམ།",
    "ངེས་པར་བདག་གི་རིགས་ཀྱི་ལག་ནོར་ཡིན་སྙམ་ཅི།",
    "བདག་གི་རིགས་ཀྱི་མྱུ་གུ་སྐྱེས་པ་མ་རྒྱས་པར།",
    "བདག་གིས་སྨྲས་པ་གང་དེ་ཐེ་ཚོམ་མེད་པ་དེ།",
    "འདི་ཡི་གཞན་གྱུར་མཚོན་མིན་བདག་གི་རྣམ་འགྱུར་ཏེ།",
    "འདི་སྐྱེས་བདག་གི་འགྲོ་བ་ལ་ནི་དུས་ཡིན་ནོ།",
    "ཡུལ་གྱི་བུད་ཤིང་ཅན་གྱི་འདོད་ཆགས་མེ་ཡིས་ནི།",
    "རང་གི་ལས་ཀྱི་ཞགས་པ་རྣམས་ཀྱིས་ཡོངས་དཀྲིས་ཤིང་།",
    "ཡོན་ཏན་རྒྱ་མཚོ་འདི་ལས་འཁྲུལ་གྱུར་བདག་གི་ནི།",
    "དེ་ལྟར་དོན་ཐོས་བཤེས་དང་བཅས་ཤིང་བཙུན་མོར་བཅས།",
    "རྣམ་པ་དེ་ལྟར་བདག་གི་བུ་ནི་འདིའོ་ཞེས།",
    "བློ་གྲོས་བྱས་པའི་སྲིང་མོའི་བུ་ཡང་མཐོང་ནས་ནི།",
    "ཡུལ་ལ་སོང་བའི་འཆིང་བ་རྣམས་ནི་རྣམ་སྤངས་ཏེ།",
    "མཆོག་གི་དགའ་བ་རབ་ལྡན་སྙོམས་པར་གྱུར་པའི་ཡིདི།",
    "རང་གི་སྲས་འཕེལ་ཕྱིར་ན་གཉིས་སྐྱེས་རྣམས་ལ་བྱིན།",
    "དཀར་པོའི་མེ་ཏོག་གིས་སྤྲས་ནོར་བུའི་སྒྲོན།",
    "དེ་ནས་གནས་བརྟན་སྐྱེ་མོ་རྗེས་འབྲང་སྲས་མགོན་མ།",
    "ལྷ་ཡི་བུ་མོ་རྣམས་ཀྱིས་བཀྲམ་བཞིན་དགའ་བར་གྱུར།",
    "ཀྱིའིསྐྱེ་དང་རྒ་བ་མཐོང་སོང་བདག་སྐྱེས་བདག་ཕམ་དེའི།",
    "ཡིད་ལ་རེ་བ་ཡི་རང་བཞིན་དུ་ཁུར་གྱུར་པ།",
    "སྐྱེས་རབས། གི་",
    "དཀྱིལ་འཁོར་འདི་ལ་ཉེ་བར་འོང་བར་མི་ནུས་པའི་། གངས་དང་ལྡན་པའི་གླང་ཆེན་ཆང་གིས་དྲེགས་དེ་རྣམས།",
    "དེ་བཞིན་གཞན་རྣམས་དག་གིས་བརྒྱན་བྱས་རྔོག་མ་འཕྱང་།",
    "འདི་ཡི་དགྲ་བོ་དབུས་གནས་ཉིད་དུ་སོང་གྱུར་པ།",
    "དབུས་གནས་གྱུར་པ་མཛའ་བཤེས་ཉིད་དུ་རབ་ཏུ་སོང་།་།",
    "ཁྱད་པར་དུ་ནི་བཤེས་གཉེན་བརྟན་པོར་སོང་བ་སྟེ།",
    "ཞིང་གི་ལས་ཀྱིས་ངལ་དུབ་བྱེད་པ་ཉུང་ངུས་ཀྱང་།",
    "དེར་ཡང་སྐྱེད་མོས་ཚལ་དང་ལྷ་གནས་དཀའ་ཐུབ་གནས།",
    "བདག་མོས་བདག་པོ་ལའམ་མོ་ཡིས་བདག་པོར་རུང་།",
    "དགའ་བའི་ཆེད་དུ་འདོད་ལ་འགའ་ཞིག་གིས་མ་བསྙེན།",
    "འདོད་པའི་དོན་དུ་ནོར་ནི་འགའ་ཞིག་གིས་མ་བསྲུངས།",
    "རང་གི་འཁོར་ལོ་ཕ་རོལ་འཁོར་ལོ་ལས་གྲོལ་ཏེ།",
    "དེ་ཕྱིར་མི་སྐྱོང་གིས་ནི་སྲས་པོ་དེ་ཡི་མཚན།",
    "སྐྱེས་རབས། གི་",
    "ལྷ་མོ་སྒྱུ་མ་ཡང་ནི་ལྷ་ཡི་དྲང་སྲོང་མཚུངས།",
    "མ་ཡི་ནུ་མོ་མདངས་མཉམ་པ་ཡི་རང་བཞིན་ལ།",
    "ལང་ཚོ་ཉིད་དང་རྗེས་སུ་མཐུན་པའི་རྒྱན་རྣམས་དང་།",
    "དེ་ནི་ལང་ཚོ་རྗེས་མཐུན་ཡུལ་ལ་ཉེ་སྤྱོད་པ།",
    "ལང་ཚོ་གཞོན་ནུ་ཤིན་ཏུ་འདས་ནས་ཡང་དག་པར།",
    "ལོ་མང་དག་གིས་རྟོགས་བྱ་ཉིན་ཞག་ཉུང་ངུ་ཡིས།",
    "མཆོག་གི་ལུས་ཀྱིས་སྣང་ཞིང་གསལ་བ་དེ་ཉིད་ནི།",
    "གང་གིས་མཐོང་མི་འགྱུར་ཞེས་རྗེས་སུ་བསམས་བྱས་ནས།",
    "གནས་དག་མི་སྐྱོང་གིས་ནི་དེ་ལ་རྣམ་པར་བསྟན།",
    "བུད་མེད་རྣམས་ཀྱི་སིལ་སྙན་རྒྱ་ཆེན་རྣམས་ཀྱིས་རྣམ་པར་གཤེགས།",
    "རྒྱགས་དང་རྩེ་དང་དགོད་པ་དངར་མོ་རྣམས་ཀྱིས་དང་།",
    "དེ་ལ་དེར་ནི་མི་མོ་རྣམས་ནི་དགའ་བར་གྱུར།",
    "དགའ་བས་དྲེགས་པའི་བུད་མེད་རྣམས་ཀྱིས་བཟུང་གྱུར་ལ།",
    "སྐྱེས་རབས། གི་༡༨༧གཞལ་མེད་ཁང་ནི་རྒྱབ་ནས་ས་ལ་མ་གཤེགས་སོ།",
    "མི་སྐྱོང་གིས་ཀྱང་དེ་ཉིད་བསྐྱེད་པའི་ཆེད་ལས་ནི།",
    "དེས་ནི་རང་གི་སྐྱེ་དགུ་རྣམས་ལ་ཇི་ལྟ་བར།",
    "འཚེ་བར་མི་བྱེད་ཁྲོ་བས་ཀྱང་ནི་གཟིགས་མ་ཡིན།",
    "དྲང་སྲོང་རྣམས་ཀྱིས་མཆོག་གི་བརྟུལ་ཞུགས་སྤྱད་གྱུར་ལ།",
    "གྲགས་འཛིན་མ་ནི་རང་གི་གྲགས་པ་འཛིན་མ་ལ།",
    "དེ་ནས་འདོད་པའི་བུ་མངའ་མཆོག་གི་ཡིད་ཆེས་ཏེ།",
    "གཟི་བརྗིད་སྟོང་གི་འོད་ཟེར་བཞིན་དུ་རབ་ཏུ་འཕྲོ།",
    "ཡབ་མེས་བཞིན་དུ་ཡུལ་རྣམས་ཀུན་ལ་གཟིགས་པར་གྱུར།",
    "གང་ལས་བདག་གི་བུས་ནི་བུ་ཡི་ངོ་མཐོང་ནས།",
    "བཙུན་མོའི་འཁོར་ན་གནས་པའི་ལེའུ་སྟེ་གཉིས་པའོ།",
    "དེ་ནས་རེ་ཞིག་དུས་ན་འཇམ་པོའི་རྩྭ་རྣམས་དང་།",
    "ཀླུ་རྣམས་དང་ནི་ངེས་ལྡན་སྐྱེད་མོས་ཚལ་རྣམས་ནི།",
    "དེ་ནས་བུད་མེད་སྐྱེ་བོ་རྣམས་ནི་དགའ་བ་ཡི།",
    "དགོངས་པ་མི་སྐྱོང་གིས་ནི་ངེས་པར་ཐོས་གྱུར་ནས།",
    "བརྩེ་བའི་ཕུན་སུམ་ཚོགས་པས་ལང་ཚོར་འོངས་པ་རུ།",
    "ལྟད་མོ་དག་ལ་རྣམ་པར་གཤེགས་པར་བཀའ་སྩལ་ཏོ།",
    "མགོ་ལ་ཉེ་བར་བསྣམས་ཏེ་ཡུན་རིངས་རྣམ་གཟིགས་ནས།",
    "སོང་ཅིག་ཅེས་ནི་ཚིག་གི་བཀའ་དག་སྩལ་ིགྱུར་ལ་། བརྩེ་བ་དག་ལས་དེ་ནི་ཡིད་ཀྱིས་མ་བཏང་ངོ།",
    "མི་མོ་རྣམས་ནི་ངེས་པར་ཞུགས་གནས་ཕྲ་རྣམས་ལས།",
    "བསྒོ་བྱ་སྐྱེས་ལས་བུད་མེད་རྣམས་ཀྱིས་ཐོབ་གྱུར་ནི།",
    "བལྟ་བར་འདོད་པས་ལྡིང་ཁང་ཤོང་དུ་སོང་བར་གྱུར།",
    "ཡ་མཚན་གྱུར་པས་དོགས་མེད་པར་ནི་ཡོངས་སུ་སོང་།",
    "གཞལ་ཡས་ཁང་གི་སྐས་ཀྱི་འོག་གི་སྒྲ་རབ་དང་།",
    "འགྲོ་བ་ངེས་པར་བཟུང་སྟེ་མྱུར་མིན་སོང་བར་གྱུར།",
    "དེ་ནས་ཁང་བཟངས་ལང་ཚོ་མ་རྣམས་ཀྱིས་ཁྱབ་ཅིང་།",
    "སྐྱེས་རབས། གི་་",
    "ལྷ་མོ་དང་བཅས་གཞལ་མེད་རྣམས་ཀྱི་ནམ་མཁའ་བཞིན།",
    "བུད་མེད་དེ་རྣམས་ས་ལ་འགྲོ་འདོད་ལྟར་མཛེས་ཤིང་།",
    "རྒྱལ་པོའི་སྲས་དེ་མཐོང་ནས་བུད་མེད་དེ་རྣམས་ནི།",
    "བདག་གི་སྲིད་པ་གཞན་མ་ཅུང་ཞིག་བརྟགས་པ་འདྲ།",
    "མི་རྣམས་ལས་ནི་ཐ་དད་དབྱིབས་ཅན་དེ་གཟིགས་ནས།",
    "འདི་ནི་རྒས་པ་ཞེས་བྱ་གང་གིས་འདི་བཅོམ་མོ།",
    "རིམ་གྱིས་ལུས་རབ་ལྡན་པའི་ལང་ཚོར་གྱུར་ནས་ཀྱང་།",
    "རིམ་གྱིས་དེ་ཉིད་ཁོ་ནས་རྒ་བར་ཉེ་བར་སོང་།",
    "དབུགས་ནི་རིང་དུ་བརྒྱུས་ནས་རང་གི་མགོ་བསྒུལ་ཞིང་།",
    "སྐྱེས་རབས། གི་༡༨༧འཁོགས་པ་དེ་ལ་སྤྱན་ནི་རྣམ་པར་ཞུགས་ནས་སུ།",
    "རྒ་བ་དང་བཅས་སྐྱེ་བ་དེ་རྣམས་གཟིགས་གྱུར་ནས།",
    "འདི་ལྟ་བུར་ནི་མངོན་སུམ་ཉིད་དུ་སོང་ཟིན་ཡང་།",
    "དེ་ལྟར་སོང་ལ་འདྲེན་པ་རྟ་རྣམས་ཕྱིར་ཟློག་ཅེལ།",
    "ཁྱོད་ནི་ཁྱིམ་ཉིད་དུ་ནི་སྐྱེས་པར་རབ་ཏུ་སོང་།",
    "སྐྱེད་མོས་ཚལ་གྱི་ས་ལ་བདེ་བ་ག་ལ་ཡོད།",
    "དེ་ནས་རྒྱལ་པོའི་སྲས་པོ་དེ་ཡི་བཀའ་ལུང་གིས།",
    "གང་གི་ཚེ་ན་དེ་ཡང་བདེ་བ་མ་ཡིན་ཏེ།",
    "ཟས་གཙང་རྒྱལ་པོའི་སྲས་པོ་ཅན་དེར་སོང་ཉིད་ཀྱིས།",
