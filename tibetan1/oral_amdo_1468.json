    "དྲང་སྲོང་ཆེན་པོ་ཁྱོད་རང་གི་འབར་བ་ཉིད་དུ་བཞུགས་ཏེ་བདག་ཇི་ལྟར་འདོད་པའི་སྦྱིན་སྲེག་བྱེད་པའི་བར་དུ་གནས་པར་གྱིས་ཤིག་ཅེས་སྨྲ་བར་བྱའོ།",
    "དེའི་འོག་ཏུ་རྡོ་རྗེ་སེམས་དཔའ་བཟླས་བརྗོད་བྱས་པའི་མཆོད་ཡོན་གྱི་སྣོད་བྱུག་སྤོས་གཙང་མ་དྲི་ཞིམ་པོ་དང་མེ་ཏོག་ཅན་གྱི་ཆུས་བཀང་བ་དག་གིས་གཡོན་རོལ་དུ་གཞག་གོ།",
    "རང་གི་མདུན་དུ་ཡང་དགང་གཟར་དང་བླུགས་གཟར་བཞག་ནས་རང་གི་ལྷའི་དམ་ཚིག་སེམས་དཔའི་རྣལ་འབྱོར་བདག་དང་མི་གཉིས་པར་གྱུར་པ།",
    "དེར་རང་གི་ལྷའི་དམ་ཚིག་གི་སེམས་དཔའ་བཅུ་སྟེ།",
    "རང་གི་ལྷའི་དམ་ཚིག་སེམས་དཔའ་བདག་ཏུ་གྱུར་པ་ཉིད་དུ་མངོན་དུ་བྱ་སྟེ།",
    "དེ་ནས་དེ་བཞིན་དུ་ཤིང་མངར་པོའི་ཡམ་སྲེག་ཤིང་རྩེ་མོ་གཉིས་མར་ལ་བཏགས་པ་ཅི་ལྟར་འདོད་པ་བསྲེགས་ལ་ཡམ་ཤིང་གིས་སྦར་བའི་མེ་ལ་མར་དང་བསྲེས་པའི་ཏིལ་བླུགས་གཟར་ཆུང་ངུའམ་གུང་མོ་དང་སྲིན་ལག་དང་མཐེ་བོས་བླངས་ཏེ་བསྲེག་གོ།",
    "ཐབ་དེ་དག་གི་དབྱིབས་ཀྱི་ཁྱད་པར་དེ་ལས་གསུངས་པ་གང་ཡིན་པ་དང་།",
    "བུད་ཤིང་དང་སྲེག་རྫས་དང་།",
    "རྡོ་རྗེའི་རིགས་ཀྱིས་རིགས་རྒྱས་པར་བྱ་བའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་ཀྱི་མར་དང་བསྲེས་པའི་འབྲས་ཀྱི་སྲེག་བླུགས་བྱས་ན་རིགས་ཀྱི་ནོར་དང་འབྲུ་དང་བུ་ཚ་ལ་སོགས་པ་དང་ལྡན་པ་འབྱོར་བའི་མཚན་ཉིད་རྒྱས་པར་འགྱུར་རོ།",
    "དེ་ལ་འདི་ནི་རྡོ་རྗེའི་རིགས་ཀྱིས་རིགས་རྒྱས་པར་བྱེད་པའི་མཚན་ཉིད་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་ཚེ་རིང་བའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་དག་འདི་ནི་རྗེས་སུ་ཆགས་པར་བྱེད་པའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་བཅིང་བའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "ཡམ་སྲེག་ཤིང་ཚ་བས་མེ་སྦར་ལ་འབྲས་བུ་ཁ་བའི་སྦྱིན་སྲེག་གིས་དགྲ་ལ་དྲག་ཤུལ་བྱའོ།",
    "དེ་ལ་འདི་ནི་དྲག་ཤུལ་སྤྱོད་པའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་འདོད་པའི་གཟུགས་ཅན་དུ་གྱུར་པའི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་མི་སྣང་བའི་སྤྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་རྡོ་རྗེའི་རིགས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པ་ནམ་མཁའ་ལ་འགྲོ་བའི་སྤྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "ལྕུག་མ་བྲེས་པ་ལྟ་བུ་ཕྲ་མོའི་གཟུགས་རྩ་བ་མེད་པར་སྐྱེའོ།",
    "དེ་ལ་འདི་ནི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "དེ་ལ་འདི་ནི་སྦྱིན་སྲེག་གི་རིག་སྔགས་སོ།",
    "ཧཱུཾ་བུདྡྷ་བ་ཤཾ་ཀ་རཱ་ཡ་སྭཱ་ཧཱ།",
    "དེ་ལ་སྒྲུབ་པ་པོ་གང་ཡང་རུང་བའི་སྦྱིན་སྲེག་གི་ལས་བྱེད་འདོད་པས་སྔར་སྨོས་པའི་རིམ་གྱིས་རྡོ་རྗེ་ཕྲ་མོའི་ཏིང་ངེ་འཛིན་མོས་པ་རབ་ཏུ་གོམས་པར་བྱས་པས་སྔར་སྨོས་པ་ཉིད་ཀྱིས་བདག་དང་མི་གཉིས་པར་གྱུར་པའི་རང་གི་ལྷའི་ཡེ་ཤེས་སེམས་དཔའི་རྣལ་འབྱོར་རབ་ཏུ་གོམས་པར་བྱའོ།",
    "བཅིངས་པ་དང་བསད་པ་རྣམས་ཉི་མ་རེ་རེ།",
    "རང་གི་ལྷའི་ཡེ་ཤེས་སེམས་དཔའ་ཉིད་ལ་གསོལ་བ་བྱས་ནས་ཉི་མ་རེ་རེའི་སྦྱིན་སྲེག་བཏང་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་བདག་གི་ཆོ་ག་ཉམས་པར་བགྱིས་པ་ལྟ་མཆིས་ན།",
    "དེ་བཞིན་དུ་མཚན་མོ་སྦྱིན་སྲེག་བྱས་སམ།",
    "རྟག་ཏུ་ཉི་མ་རེ་རེ་ཞིང་སྦྱིན་སྲེག་བྱེད་པ་ཇི་ལྟར་རིགས་པར་གཏང་བར་བྱ་བ་རིག་པར་བྱའོ།",
    "དེ་ལ་འདི་ནི་སྔོན་དུ་བསྙེན་པའི་སྦྱིན་སྲེག་བྱེད་པའི་ཚེ་དང་མཚན་མོ་བསྒྲུབ་པའི་སྦྱིན་སྲེག་བྱེད་པའི་ཚེའི་སྦྱིན་སྲེག་ཐམས་ཅད་བཏང་བའི་ཆོ་ག་སྟེ།",
    "དང་པོར་རེ་ཞིག་ཇི་ལྟར་འདོད་པའི་སྦྱིན་སྲེག་བྱས་ཟིན་ནས།",
    "དེ་ནས་ཇི་ལྟར་སྤྱན་དྲངས་པའི་རི་མོ་དང་།",
    "མཉེས་པར་བྱ་བ་རང་གི་ལྷའི་ཡེ་ཤེས་སེམས་དཔའི་མངོན་དུ་བྱ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཡི་གེ་བརྒྱ་པ་རྡོ་རྗེའི་ཚིག་གིས་སྔ་མ་བཞིན་དུ་ལན་ཅིག་བརྗོད་ལ།",
    "རྡོ་རྗེ་མེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་དང་དེའི་གསང་སྔགས་ཉིད་ཀྱིས་སླར་བཏང་ལ་ཡོ་བྱད་བསྲུང་བ་ཡང་སྔ་མ་བཞིན་དུ་བྱས་ལ་ལྡང་ངོ།",
    "སྤྱིན་སྲེག་གི་ཆོ་ག་བསྡུས་པའོ།",
    "ཚིག་གི་བདུད་རྩི་མཐུན་པ་རྣམས།",
    "སྒྲིབ་པ་ཟད་ཅིང་ཚོགས་ཡོངས་སུ་རྫོགས་པར་གྱུར་ཏེ།",
    "དེ་ལས་ཀྱང་བདག་གིས་འཆད་པའི་འགྲོ་བ་རྣམས་ལ་གྲགས་པར་འདོད་པའི་འཕགས་པ་རྣམས་ཀྱིས་རྟོགས་པར་ནུས་པའི་དངོས་གྲུབ་བྱིན་ཏེ།",
    "རྒྱུད་འདི་དག་གིས་གདུལ་བྱའི་རིགས་མཐུན་ཕྱོགས་གཅིག་ཏུ་སྐྱེས་པ་རྣམས་ལ་རིམ་གྱིས་གྲགས་པར་འགྱུར་ཏེ།",
    "ཐ་མར་ནི་ཕྱག་རྒྱ་ཆེན་པོ་མངོན་དུ་གྱུར་ཏེ་ཚེ་གཅིག་གིས་འབྲས་བུ་ཐོབ་པར་གླེང་ངོ།",
    "དེ་ནས་དེ་དག་གི་སྒྲུབ་ཐབས་དང་།",
    "སྐྱེས་བུ་མཁས་པ་རྣམས་ཀྱིས་གཟིགས་ན་དགྱེས་པ་སྐྱེ་བའི་རྒྱུར་འགྱུར་བ་ཙམ་ཞིག་བརྩམས་པ་ཡིན་ཞེའོ།",
    "སྒྲུབ་ཐབས་ཀྱི་རང་གཉེར་གྱིས་དཀྱུས་མགོ་མཇུག་གི་ས་བཅད་པ་དང་།",
    "ཚིག་གི་དོན་རིམ་པར་གཞོམ་པའི་ཐབས་བསྟན་པའོ།",
    "བདག་གི་དེ་ཁོ་ན་ཉིད་དང་།",
    "ལྷ་གཅིག་གི་ངོ་བོ་གང་ལ་ཡང་ཚང་བར་བཏུབ་པོ་ཞེས་གླེང་ངོ།",
    "ཁ་ཅིག་ན་རེ་བཞི་པོ་འདི་དག་ཀྱང་ངོ་བོ་གཅིག་པ་ཉིད་ལ་དཀྱིལ་འཁོར་གྱི་བྱེ་བྲག་གིས་སོ་སོར་གྱུར་ཏེ།",
    "གཞན་དག་ན་རེ་འོ་ན་དེ་ལྟར་མཚན་ཉིད་མི་མཐུན་པ་གཉིས་མིང་གཅིག་ཏུ་འདོད་པར་གྱུར་ན་ཡང་འགལ་ཏེ།",
    "དེའང་བདེན་པ་ལྟར་སྣང་མོད་ཀྱི།",
    "གཅིག་གི་འབྲས་བུར་གཅིག་གནས་པའི་ཕྱིར་ན་དེ་ལྟར་བརྗོད་ན་འགལ་བ་མེད་དེ།",
    "དེ་ལ་གཞན་དག་ན་རེ་དེ་ལྟར་རྟོག་པ་མི་མཐུན་པ་དག་མིང་གཅིག་ཏུ་བརྗོད་པར་རུང་ངམ་ཞེ་ན།",
    "དེ་ལ་ཡང་བདེན་མོད་ཀྱི་འོན་ཀྱང་དེ་གཉིས་འབྲེལ་པའི་མཚན་ཉིད་ཅན་ཡིན་ཏེ།",
