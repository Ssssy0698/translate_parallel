    "དམའ་བར་འདུག་སྨྲས་འདས་བཟླས་པ་ཡིས་ཡི།",
    "ཞེས་པ་སྡོམ་པ་ལེན་པའི་ཚུལ་སྟན་དམའ་བ་ལ་འདུག།",
    "ཐམས་ཅད་ལ་རྟེན་སྡོམ་པ་ཐོབ་ལ་མ་ཉམས་པ་ཤེས་པ་དང་རང་བཞིན་དུ་གནས་པའོ།",
    "དེ་ལ་ཡང་རང་རྒྱུད་ཀྱི་ཕུང་པོ་ལ་ཆགས་པ་དང་།",
    "རིགས་མཐོ་བས་ང་རྒྱལ་བ་དང་རྗེས་སུ་འབྲེལ་བར་གཞན་དམན་པ་དང་རང་ཉིད་མཆོག་ཏུ་འཛིན་པའི་སེམས་མཐོ་བ་དང་།",
    "བདག་ཏུ་འཛིན་པའི་འཛིན་སྟངས་ལ་འདུག་པ་མངོན་སུམ་མྱོང་བས་གྲུབ་པས།",
    "གཉེན་བཤེས་དགྲར་འགྱུར་བ་ལ་སོགས་པ་ངེས་པ་མེད་པ་སྣ་ཚོགས་ཉིད་དུ་འགྱུར་བ་མཆི་ཞིང་གདའ།",
    "སྐྱེ་བ་ལེན་པ་ཡང་རང་ཉིད་གཅིག་པུར་ལེན་པ་དང་།",
    "ལས་གསོག་པ་ཡང་རང་ཉིད་གཅིག་པུས་གསོག་པ་དང་།",
    "རྣམ་སྨིན་མྱོང་བ་ཡང་རང་ཉིད་གཅིག་པུས་མྱོང་བ་སྟེ།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་དང་།",
    "ཞེས་གསུངས་འདུག་པའི་ཕྱིར་ཟེར།",
    "འོན་ཀྱང་འཚོ་བཅངས་སུ་བྱིན་འདུག་ཨ་ལགསཔསཨསྐས་གྱིས་རློབ་བ་ལ་དགོས་མེད་དུ་མི་འགྱུར་ཏེ།",
    "ཀ་ལ་༤ ༥ ༩ འདུག་ཀཔ་ལ་གསནསྨྲ་ལག་སྐག་གཞི་སྨད་འདི་ཐད་ཤོག་༢༣༡ ལས།",
    "གཞན་དུ་འདུག་སྟེ་ལེན་པ་དང་།",
    "མདུན་དུ་མ་འདུག་པར་ལེན་པ་དང་།",
    "སྦྱོར་དུས་ལུས་ཀྱིས་ཚུལ་བཞིན་འདུག་པ་དང་།",
    "རང་རང་ལས་འཆགས་དེར་བརྟེན་འབྲས་བུ་ནི།",
    "ཐོག་མེད་ཀྱི་བག་ཆགས་གོམས་པ་འབའ་ཞིག་ལས་རང་རང་ཤུགས་ཀྱིས་བྱུང་བ་མ་ཡིན་གྱི།",
    "དེ་ལྟར་གསུངས་པ་སྐྱེས་བུ་དམ་པ་ཐམས་ཅད་ལ་མཐོང་ཐོས་ཙམ་ཡང་མི་འདུག་པའི་ཕྱིར་རོ།",
    "དངོས་པོའི་འཇིག་ཞིག་ཐམས་ཅད་དངོས་པོ་ཡིན་པར་ཁྱེད་རང་འདོད་ཅིང་ཞིག་དངོས་ལས་འབྲས་ཀྱི་རྟེན་གྱི་གང་ཟག་ཡིན་པར་རིགས་ན་འཇིག་དངོས་དེ་ཡིན་པ་ལའང་གནོད་བྱེད་མེད་ཅིང་སྒྲུབ་བྱེད་མཚུངས་པའི་ཕྱིར།",
    "སློབ་དཔོན་ཆེན་པོ་ཟླ་བ་གྲགས་པས་འཇུག་པ་རྩ་འགྲེལ་འདིར་རྒྱས་པར་བཀག་གདའ་བས་ཐར་འདོད་རྣམས་ལེགས་པར་སོམས་ལ་མིག་མེད་གཡང་ས་ཆེན་པོ་ལ་གོམ་པ་འདོར་བའི་རྗེས་སུ་མིག་ལྡན་དག་བག་གཟོབས་ཤིག་གངས་ཅན་གྱི་ཁྲོད་འདིར་བདག་ཐ་སྙད་དུ་ཡང་མེད་ཅིང་།",
    "གང་ཚེ་དེ་སྐད་སྨྲ་ཞིང་རང་ཕྱོགས་ཁོ་ན་རྣམ་འཇོམས་པ།",
    "དེས་ན་ཁོ་བོ་ཅག་སུན་འབྱིན་དབྱུང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་ཁས་མ་བླངས་པས་རང་ཚིག་ལ་འགལ་བ་མེད་ཅིང་།",
    "སྐྱེད་པར་བྱེད་པའི་རྒྱུ་༣༡༤ན་འབྲས་ལ་རང་བཞིན་ཡོད་པར་རྟོག་ནས་དཔྱད་རིགས་པ་ལྟར་གསལ་བྱེད་ཀྱི་རྒྱུ་འབྲས་ལའང་རང་བཞིན་ཡོད་པར་རྟོག་ནས་དཔྱད་རིགས་པར་མཚུངས་པ་དེ་ཉིད་འཇུག་པའི་གླགས་ཡོད་པའི་ཕྱིར་ཏེ།",
    "སུན་འབྱིན་དབྱུང་རང་བདེན་པ་སེམས་བསྐྱེད་དྲུག་པ་མངོན་དུ་གྱུར་པ།",
    "ཐ་སྙད་པར་ཡང་རང་ལུགས་སུ་བསྒྲུབ་བྱ་སྒྲུབ་བྱེད་གང་བཞག་པ་དེ་ཉིད་ཀྱི་སྤྲོས་པ་ཉེ་བར་མ་ཞི་བའི་ཕྱིར།",
    "རང་བཞིན་གྱིས་གྲུབ་པའི་རང་བཞིན་ནི་བདེན་པ་གཉིས་ཀར་ཡང་རང་བཞིན་དུ་མི་རུང་ངོ།",
    "དེ་ལྟར་བརྗོད་པའི་རང་བཞིན་དེར་རང་བཞིན་དུ་མ་གྲུབ་ཀྱང་རང་བཞིན་དུ་སྒྲོ་བཏགས་ནས་གཞན་བྱིས་པས་བཏགས་པའི་རང་བཞིན་དེ་བཟློག་པའི་དགོས་པའི་ཆེད་དུ་ཀུན་རྫོབ་ཐ་སྙད་དུའང་རང་བཞིན་དེ་ལྟ་༣༢༣ན་བུའི་ཞེས་སྒྲོ་སེམས་བསྐྱེད་དྲུག་པ་མངོན་དུ་གྱུར་པ།",
    "ཐ་སྙད་དུའང་རང་ལུགས་ཀྱིས་གྲུབ་པའི་རང་བཞིན་དང་།",
    "ཤེས་བྱ་དངོས་པོ་རང་རང་ལ་བདག་བདེན་ཡོད་པ་དེ་རྟགས་ཀྱི་དགག་བྱའི་བདག་ཤེས་བྱ་རང་རང་ལ་ཡོད་པ་དེ་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཀུན་རྫོབ་ཐ་སྙད་ཚད་གྲུབ་རང་རང་ངོ་བོས་མི་སྟོང་ཞིང་།",
    "རང་རང་རིས་མཐུན་ཕྱོགས་བཅུར་རྒྱས་པ་ལ།",
    "ཀུན་རྫོབ་བདེན་པར་རང་རང་ངོ་བོས་སྟོང་པས་རང་སྟོང་དང་།",
    "རྣམ་རྫུན་པས་ཀྱང་རང་ལུགས་སུ་རང་སྟོང་ཁས་མི་ལེན་ཅིང་།",
    "དེ་ཏིང་ངེ་འཛིན་དེ་ཐོབ་མ་ཐག་པདྨ་དེ་ལ་འདུག་པར་ཀུན་ཏུ་སྣང་ངོ།",
    "ཡེ་ཤེས་ཡོད་མེད་གང་ལའང་རང་ཉིད་ཞེ་འདོད་མེད་པའི་ཕྱིར་དང་།",
    "རང་སེམས་མངོན་དུ་གྱུར་ཙ་ན།",
    "གྲངས་མེད་གསུམ་ཡང་བརྫུན་པར་གདའ།",
    "ཀྭ་བློ་གཏད་འདུག་གམ་མི་འདུག་སོམས།",
    "འཕགས་པའི་མཉམ་གཞག་ཡེ་ཤེས་ཀྱི་ངོ་ན་ནི་བལྟོས་ནས་དང་བརྟེན་ནས་འབྱུང་མི་འབྱུང་དང་རང་བཞིན་གྱིས་ཡོད་མེད་དང་།",
    "དེ་ལྟར་འཇིག་རྟེན་གཞན་གྲགས་ཀྱིས་བརྗོད་ཀྱིན་༣༦༧ན་འདུག་པ་ལས།",
    "འོ་ན་བརྗོད་བྲལ་ལའང་འཇིག་རྟེན་པ་ཐམས་ཅད་བརྗོད་ཀྱིན་འདུག་པ་ཇི་ལྟར་ངས་ཤེས་སུ་ཡོད།",
    "རྒྱུན་མེད་པར་འདོད་ན་རྒྱུན་དེ་གཅོད་བྱེད་ཀྱི་གཉེན་པོའི་ཡེ་ཤེས་དེ་ཁོ་རང་ཡིན་ནམ་གཞན་ཞིག་ཡིན་ཅེས་དཔྱོད་པ་དང་།",
    "དགོངས་གཅིག་ལེའུ་དང་པོ་ལ་གཞན་འགྲེལ་དུ་བྱས་པ་དང་རང་རྐང་དུ་འགྲེལ་བ་གཉིས་ལས།",
    "ཞེས་བྲིས་གདའ་བ་དེ་ལྟར་ན་ཁྱེད་དཔོན་སློབ་ལ་འདིར་འགྱུར་ཏེ།",
    "ཁྱེད་འདོད་པའི་རྟགས་ཀྱི་དགག་བྱ་སྟོང་གཞིར་བཟུང་ནས་དེ་རང་རང་ངོ་བོས་སྟོང་པར་གཏན་ལ་དབབ་རིགས་པ་ལས་དེ་ལྟར་གསུངས་པ་མེད་ཅིང་།",
    "འདུག་མིན་འཕགས་ཡུལ་ས་ལའང་སྣང་བྱེད་དུ།",
    "ནུབ་ཕྱོགས་ན་བོད་སྟོན་གཅིག་ཡོད་པ་ང་རང་དངོས་ཡིན་གསུངས།",
    "ཁྱད་པར་ཁ་སང་ནས་ལྟ་རྟོག་མང་དུ་བྱས་པ་ཡོད་ཀྱང་དེ་རྣམས་དྲི་བ་མི་གནང་འདུག་པས་མངོན་མཁྱེན་གྱིས་དགོངས་པར་འདུག་ཟེར།",
    "འདི་ཇི་ཞིག་སྙམ་དུ་བསམ་པ་དེ་སེམས་ཤིང་འདུག་པར་གྱུར་ཏོ།",
    "དྲི་མས་ཕྱིར་མི་གོས་ཤིང་རང་བཞིན་རྣམ་པར་དག་པའི་གསེར་ཉིད་དུ་སྣང་སྟེ་གསེར་གྱི་དངོས་པོ་རྣམ་པར་དག་པའང་མེད་པར་གྱུར་པ་མ་ཡིན་པ་བཞིན་ནོ་ དཔེར་ན།",
    "རྟག་ཏུ་གསེར་ལྟར་རྣམ་པར་མཛེས་པར་གདའ།",
    "དེ་ནས་ལུས་བསྲང་སྟེ་འདུག་ནས་ཅི་འདོད་པ་དེ་བསམ་པར་བྱའོ།",
    "རང་རང་ཡུལ་ལ་རབ་ཏུ་འཇུག་པར་བྱེད།",
    "གནོད་སྦྱིན་འབུམ་ཕྲག་དུ་མ་དང་ལུས་ལྟར་མི་གདའ་བར་བགྱིས་ཏེ་ད་ལྟར་དང་།",
    "གནོད་སྦྱིན་འབུམ་ཕྲག་དུ་མ་དང་ལྷན་ཅིག་ཏུ་ལུས་མི་གདའ་བར་བགྱིས་ཏེ་དེར་མཆི་བར་བགྱིའོ།",
    "གཟུགས་རབ་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་པ།",
    "ལྷ་བྱེ་བ་ཁྲག་ཁྲིག་འབུམ་ཕྲག་དུ་མ་དག་ལུས་མི་གདའ་བར་བགྱིས་ཏེ།",
    "རྒྱུ་སྐར་རྣམས་ཀྱང་ཕན་ཚུན་མི་མཐུན་པར་གདའ་བར་འགྱུར།",
    "དགུང་ཟླ་འཆར་བ་ན་ཉི་མ་ལྟ་བུར་གདའ་བར་འགྱུར།",
    "གསེར་གྱི་རི་བོ་ལྟ་བུར་རབ་ཏུ་གདའ།",
    "གཤིན་རྗེའི་འཇིག་རྟེན་གྱི་སྡུག་བསྔལ་ཐམས་ཅད་ཤིན་ཏུ་རྒྱུན་ཆད་པར་འགྱུར་བར་ལུས་མི་གདའ་བར་བགྱིས་ཏེ།",
    "རྩྭ་བཏིང་བའི་སྟེང་དུ་འདུག་ནས་སྐུ་གཟུགས་རིང་བསྲེལ་ཅན་གྱི་མདུན་ནམ།",
    "ལུས་མི་གདའ་བར་བགྱི་སྟེ།",
    "རབ་ཏུ་འཆད་ཅིང་འདུག་བ་མཐོང་བར་འགྱུར།",
    "ཁ་ཏོན་བྱེད་ཅིང་བདེ་བར་རབ་ཏུ་འདུག།",
    "ཁྲི་དེ་ལ་ནི་འདུག་ནས་སུ།",
    "འདུག་དང་ཉལ་དང་ར་རོའི་ཚེ།",
    "གཞལ་མེད་ཁང་ན་འདུག་པ་ཡང་།",
    "སྔོན་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་དག་ལ་སྤྱད་སྐད་ཀྱང་མི་གདའ།",
    "ལྟེང་ཀ་དག་སྔོན་ཡོངས་སུ་བཏང་སྐད་ཀྱང་མི་གདའ།",
    "རུས་པ་དག་གཅིག་གདའོ།",
    "གཞོན་ནུའི་རིམ་གྲོ་པ་དག་གཞོན་ནུ་ཚོལ་ཞིང་མཆིས་ན་ཇོ་བོ་སྟོར་ཅེས་གདའོ།",
    "ལག་པ་བསྒྲེང་སྟེ་ངུ་ཞིང་འདུག། ། དེ་ནས་བློན་པོ་གཞན་ཞིག་ནི།",
    "འཇིག་རྟེན་ཁམས་རྣམས་ཀུན་ཏུ་རབ་ཏུ་གདའ།",
    "ནམ་མཁའི་མེ་ཏོག་གཉིས་ཡོད་མེད་ལ་ཐུག་འདུག་པའི་ཕྱིར།",
    "དེ་ཤེས་པ་ལ་བུམ་པ་ཤེས་དགོས་པར་འདུག་པས།",
    "རྟོག་པ་ལ་བུམ་སྤྱི་སྣང་བའི་རྣམ་པ་རྟོག་པའི་རྫས་སུ་ཁས་ལེན་པར་འདུག་པས།",
    "རྟོག་པའི་གཟུང་རྣམ་དེ་རྟོག་པའི་རྫས་དང་རང་མཚན་དང་།",
    "གཟུགས་བརྗོད་པའི་སྒྲས་མིང་རང་མཚན་དངོས་སུ་བརྗོད་ནས།",
    "སྒྲ་དེས་འཆད་ཉན་བྱེད་པའི་བློ་ཁོ་ན་དང་འབྲེལ་བའི་མིང་རང་མཚན་བརྗོད་པའི་ཕྱིར།",
    "གལ་ཏེ་དོན་རང་མཚན་དང་འབྲེལ་བ་དང་ལྡན་པའི་མིང་རང་མཚན་བརྗོད་ནའང་།",
    "དེ་ལྟ་ན་ཡང་རང་མཚན་གྱི་རྒྱུ་སྣང་བའི་མངོན་སུམ་ཡིན་ན།",
    "རང་ལ་སྣང་བ་ལྟར་གྲུབ་པ་དེ་ཡི་ངོ་བོས་སྟོང་ཡང་རང་མཚན་དེའི་ངོ་བོར་ཞེན་པ་ལྟར་མི་བསླུ་བ་ཡིན་པའི་ཕྱིར།",
    "ཡོད་པ་ཉིད་དང་རང་རྒྱུ་དང་།",
    "རྒྱུ་ནི་སྔར་ཡོད་ཀྱང་ཡོད་པ་ཉིད་དང་རང་རྒྱུ་དང་འབྲེལ་བར་བྱེད་པ་པོ་རྒྱུ་ཡིན།",
    "ཡིད་ཀྱི་རྟོག་པ་འབའ་ཞིག་ལའང་རང་ཡུལ་རིམ་ཅན་དུ་འཛིན་པ་མི་འགྱུར་ཏེ།",
    "ཤིན་ཏུ་ཕྲ་བ་ཞིག་འདུག་པས་ད་དུང་ཡང་དཔྱད་པར་བྱའོ།",
    "བརྡའི་དུས་ན་ཡང་ཤིང་རང་ཉིད་མཐོང་བའི་འབྲས་བུ་ཅན་སྔར་བསྟན་པའི་དོན་གྱི་གཞན་སེལ་དང་འབྲེལ་བའི་ཕྱིར།",
    "དེས་ན་སོ་སྐྱེའི་ཡིད་མངོན་རྒྱུན་ལྡན་དང་རང་རིག་མངོན་སུམ་གྱི་གཞལ་བྱར་འདོད།",
    "ཤེས་པ་ཡིན་ན་རང་མྱོང་རང་རིག་མངོན་སུམ་གྱིས་གྲུབ་དགོས་པར་གསུངས་པ་དེ་ལ།",
    "གཟུགས་ཀྱི་སྐྱེ་མཆེད་ཡིན་པས་ཁྱབ་པར་བསྟན་འདུག་པས།",
    "སྡུག་བསྔལ་ཡང་བཞག་དགོས་པར་འདུག་པས་འོག་ཏུ་དཔྱད་དོ།",
    "དེ་ཡང་རིག་བྱ་རིག་བྱེད་ཀྱི་རྣམ་པ་མེད་པའི་ཁ་ནང་ཁོ་ན་ལ་ཕྱོགས་པའི་འཛིན་རྣམ་ཞིག་ལ་འཇོག་མཁས་གྲུབ་ཐམས་ཅད་མཁྱེན་པས་ཤེས་པ་ཀུན་རང་མྱོང་རང་རིག་མངོན་སུམ་གྱིས་འགྲུབ་པར་བཤད།",
    "དེ་ལ་ཞིབ་ཏུ་བསམ་དགོས་པ་འདུག་སྟེ།",
    "གཟུགས་ཀྱི་ཆུང་བ་མཐར་ཐུག་པ་ཡང་རང་འཛིན་ཤེས་པའི་རྫས་ཡིན།",
    "རང་འཛིན་ཤེས་པའི་བདག་ཉིད་དང་རང་འཛིན་ཤེས་པའི་བག་ཆགས་སད་པ་ལས་སྣང་བ་ཡིན་གྱི་ཕྱི་རོལ་དོན་དུ་གྲུབ་པ་མེད་དོ།",
    "ཉེ་རིང་གང་ནས་བལྟས་ཀྱང་ཅིག་ཅར་མཐོང་དགོས་ཞེས་པ་སོགས་གསལ་བར་བཀོད་འདུག་པས།",
    "གཟུང་རྣམ་དང་འཛིན་རྣམ་གྱི་ཚུལ་གཉིས་སྒྲུབ་པར་བྱེད་པས་ཀྱང་རང་རིག་མངོན་སུམ་ཕལ་ཆེར་ཏེ་ཞར་རམ་ཤུགས་ལ་གྲུབ་པ་ཡིན་ཏེ།",
    "ཕྱི་མ་རྣམས་སྐྱེ་ས་མེད་ཅིང་རང་ལས་རྫས་གཞན་གྱི་མྱོང་བ་ཁེགས་པ་ཙམ་གྱིས་རང་རིག་ཡོད་པར་སྒྲུབ་མི་ནུས་ཏེ།",
