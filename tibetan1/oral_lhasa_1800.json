    "དེ་ལྟར་བྱས་ན་ཕྲུ་གུ་སྐྱེས་རྗེས་ཉེན་ཁ་ཅན་གྱི་ཁྲག་མང་བོ་བཞུར་བར་སྔོན་འགོག་བྱེད་ཐུབ།",
    "ཕའི་ཁམས་དཀར་དང་མའི་ཁམས་དམར་འདྲེས་ནས་མངལ་ཆགས་པར་མ་ཟད་བུ་སྣོད་དུ་འཛུལ་ནས་རིམ་གྱིས་སྐྱེ་འཕེལ་འབྱུང་།",
    "མིའི་གཟུགས་དབྱིབས་རགས་རིམ་ཙམ་ཆགས་ཤིང་མགོ་བོ་ལྷག་པར་ཆེ་ལ།",
    "ལྗིད་ཚད་ལ་ཁེ་ཙམ་ཡོད་པར་མ་ཟད།",
    "བྱིས་པར་ནུ་མ་སྣུན་བཞིན་པའི་སྐབས་སུ་ཟླ་མཚན་མ་བབས་པར་སླར་ཡང་མངལ་ཆགས་མཁན་ཡིན་ན།",
    "ལུས་ཕུང་སྐྲངས་པ་ལ་མཉམ་འཇོག་བྱས་ཏེ།",
    "མངལ་གནས་ཀྱི་ལག་པ་གཅིག་གྱེན་དུ་བསྲིངས་ཏེ་མངལ་གནས་རང་ཉིད་ཀྱི་ཐོད་པར་ཐུག་ཡོད་པ་དེ་སྦྲུམ་མའི་ཕྱི་ངོས་ནས་བརྟག་མི་ཐུབ་པར་ཡི་སྒྲ་རླབས་ཀྱིས་བརྟག་དཔྱད་བྱས་ན་གསལ་བོར་མཐོང་ཐུབ།",
    "ཡི་སྒྲ་རླབས་ཀྱིས་བརྟག་དཔྱད་བྱས་ན་གསལ་བོར་མཐོང་ཐུབ།",
    "ཚེས་སྔོན་དཔག་བྱས་པའི་ཕྲུ་གུའི་སྐྱེ་སྐར་ནི་ལོའི་ཟླ་བའི་ཚེས་ཡིན་པ་ལྟ་བུའོ།",
    "ཚེས་སྔོན་དཔག་བྱས་པའི་ཕྲུ་གུའི་སྐྱེ་སྐར་ནི་ལོའི་ཟླ་པའི་ཚེས",
    "ངལ་རྩོལ་ཚད་ལས་འདས་པ་བྱས་པ།",
    "དུས་བཅད་ལྟར་ཕྲུ་གུ་བཙའ་བའི་སྔོན་གྱི་བརྟག་ཞིབ་བྱས་ཏེ།",
    "རྒྱུ་ཞབས་ནས་ན་ཟུག་ལྡང་དུབ་བྱས་ནས་གཟེར་རྒྱག་པ།",
    "ལྷག་པར་དུ་མངལ་འཁྲི་བའི་དུས་རིམ་ཐོག་མའི་སྐབས་སུ་སྦྲུམ་བུའི་ལུས་ཁམས་དང་བུ་རོགས་ཆ་ཚང་མ་འོངས་པར་ལྷག་རོ་ལུས་པ་དང་།",
    "ཟླ་མཚན་འགག་པའམ་ཡང་ན་ཟླ་མཚན་རྒྱུན་ལྡན་མིན་པར་དུས་ངེས་མེད་དུ་འོང་བ་དང་།",
    "འོག་ཏུ་ཤོག་བུ་གཙང་མ་བཏིང་སྟེ་བཙའ་བའི་ཐབས་བྱེད་དགོས།",
    "ཁྲག་བབས་པ་ན་མི་འགྱངས་པར་བྱིས་པ་བཙའ་བའི་རྟགས་ཡིན་ལ།",
    "ཁྲག་འོང་ཚད་ཆ་སྙོམས་བྱས་ན་དཀར་ཡོལ་ཕྱེད་ཙམ་སྟེ་ཧའོ་ཧྲིན་ཡས་མས་ཙམ་ཡིན།",
    "ཐེངས་གཅིག་ལ་མར་དེད་ནས་ཕྱིར་ཐོན་མ་ཐུབ་ན་དུས་ཚོད་སྐར་མ་གཉིས་ནས་གསུམ་ཙམ་བསྡད་རྗེས་སླར་ཡང་དེད་ཆོག་སྐབས་དེར་ལག་པས་གསུས་པའི་སྟེང་དུ་འཕུར་འཕུར་བྱེད་མི་རུང་།",
    "དེ་ལྟར་བྱས་ན་བུ་རོགས་ཀྱི་ཆ་ཤས་བུ་སྣོད་ཀྱི་ངོས་ནས་བཀོག་སྟེ་ཁྲག་མང་བོ་ཤོར་ངེས་ཡིན།",
    "དེ་ལྟར་བྱས་ན་བུ་སྣོད་ཕྱིར་བསློགས་ནས་ཁྲག་མང་བོ་འབྱིན་ངེས་ཡིན།",
    "ཡང་ན་ཕྲུ་གུའི་ཀླད་པ་ནི་མི་དར་མའི་ཀླད་པ་ལས་སྙི་ཞིང་སྲ་མཁྲེགས་མིན་པས་རྗེས་སུ་བྱིས་པ་ལྐུག་པར་འགྱུར་ཉེན་ཆེ།",
    "དུག་བསལ་པའི་ལྟེ་ཐག་བསྡམས་བྱེད་ཀྱི་རས་རིང་ཚད་ཁྲུ་ཙི་གཉིས་དང་ཁ་ཞེང་ལ་ཚུན་གསུམ་ཙམ་ཡོད་པ་གྲ་སྒྲིག་བྱས་ཏེ་ཕྲུ་གུའི་ལྟེ་བ་བསྡམ་དགོས།",
    "གསུས་པ་གཤགས་ནས་ཕྲུ་གུ་བླངས་མྱོང་བའི་སྦྲུམ་མ་དང་ཡང་ན་གསུས་པ་གཤག་བཅོས་ཆེན་པོ་བྱས་མྱོང་བའི་སྦྲུམ་མ་དག་ཐེངས་དང་པོར་ཕྲུ་གུ་བཙའ་བའི་སྦྲུམ་མའི་ལོ་ཚོད་ཉི་ཤུར་མ་སླེབས་པ་དང་ཡང་ན་ལོ་ཚོད་སོ་ལྔ་ལས་བརྒལ་ཟིན་པའི་སྦྲུམ་མ་དང་།",
    "གཟེར་རྒྱག་པའི་བར་མཚམས་ཀྱི་དུས་ཚོད་དེ་དག་བེད་སྤྱོད་གང་ནུས་བྱས་ཏེ།",
    "སྐྱེས་མ་དང་གསར་བཙས་ཕྲུ་གུའི་བདེ་ཐང་ལ་འགན་ལེན་བྱེད་ཆེད་ངེས་པར་དུ་ཕྲུ་གུ་བཙས་རྗེས་ཀྱི་བདེ་སྲུང་བྱ་བ་ལེགས་པོར་བསྒྲུབ་དགོས།",
    "ལྷག་པར་དུ་ལྕགས་རྫས་ཞེས་པའི་འཚོ་བཅུད་དེ་བསྟེན་པ་གལ་ཆེའོ།",
    "གཙང་སྦྲ་ཡག་པོ་བྱས་ནས་རྒྱུན་དུ་ལུས་ཡོངས་ལ་ཆུ་དྲོ་འཇམ་གྱིས་བཀྲུ་དགོས།",
    "བཟའ་བཏུང་ལེགས་པོ་བསྟེན་ན་ན་ཚ་སྔོན་འགོག་བྱེད་ཐུབ་པར་མ་ཟད།",
    "དེ་བས་རྒྱུན་དུ་ནུ་མར་གཙང་སྦྲ་བྱེད་དགོས།",
    "ཕྲུ་གུར་ནུ་མ་ལྡུད་སྐབས་ནུ་མ་ཆུ་དྲོ་འཇམ་གྱིས་གཙང་མར་བཀྲུས་ཏེ་སེང་རས་རློན་པས་གཙང་མ་ཞིག་འབྱིད་དགོས།",
    "གལ་ཏེ་ནུ་རྩེ་ཐུང་ཐུང་ཡིན་ན་ཕྲུ་གུ་མ་བཙས་པའི་སྔོན་ལ་ནུ་རྩེ་ཆུ་གཙང་དྲོ་འཇམ་གྱིས་བཀྲུ་ཞིང་བཙིར་དགོས།",
    "ནུ་མར་གཙང་སྦྲ་བྱེད་དགོས་ལ་བསེར་བུ་ཆེ་སར་འགྲོ་མི་རུང་།",
    "ཐེངས་གཅིག་ལ་དུས་ཚོད་སྐར་མ་ཉི་ཤུ་ཡས་མས་སུ་ནུ་མ་བསྣུན་དགོས་པར་མ་ཟད།",
    "རྫས་འགྱུར་བརྟག་དཔྱད་ཀྱིས་ཟུངས་ཁྲག་ལ་བརྟག་དཔྱད་བྱས་ན་ཟུངས་ཁྲག་མར་ཆག་ཡོད་པ་ཤེས་ཐུབ།",
    "དེ་ལྟར་བྱས་ན་ཉེན་ཁ་ལས་སྐྱོབ་ཐུབ།",
    "གལ་ཏེ་བུ་རོགས་ལྷག་མ་བུ་སྣོད་དུ་ལུས་ཡོད་ན་ངེས་པར་དུ་གཤག་བཅོས་བྱས་ནས་གཙང་ལེན་བྱ་དགོས།",
    "ཕྲུ་གུ་བཙས་རྗེས་བུ་སྣོད་ཀྱི་འགྱུར་ལྡོགཕྲུ་གུ་བཙས་རྗེས་ཀྱི་བུ་སྣོད་རིམ་བཞིན་སྒྲིམ་སྡུད་བྱས་ཏེ།",
    "དེ་ལ་འཚོ་བཅུད་ཕུན་སུམ་ཚོགས་པ་ལྡན་པར་མ་ཟད་འགོག་ཤུགས་ལྡན་པའི་རྫས་རིགས་མང་བོ་འདུས་ཡོད་པས།",
    "ཉིན་གཉིས་པར་མལ་ཁྲིའི་སྟེང་དུ་ཙོག་པུར་བསྡད་ཆོག་ལ།",
    "ཚ་གདུག་ཕོག་པར་གཟབ་དགོས་ཤིང་།",
    "དགུན་ཁར་གྲང་ངར་ཕོག་པར་གཡོལ་དགོས།",
    "རང་ཉིད་ཀྱི་གཙང་སྦྲར་དོ་སྣང་བྱ་དགོས།",
    "ཤེལ་དེམ་ཆུང་ངུའི་ནང་བླུགས་ཏེ་བྱིས་པར་ལྡུད་དགོས།",
    "ཉིན་གསུམ་པར་ལག་པ་འདེགས།",
    "ཕྲུ་གུ་བཙས་པའི་རྗེས་སུ་འགུལ་སྐྱོད་འོས་མཚམས་བྱས་ཏེ།",
