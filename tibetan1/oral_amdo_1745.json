    "སྣ་ཚོགས་མཁའ་འགྲོ་དང་དེའི་འཁོར་རྣམས་ཀྱང་ནམ་མཁའ་ལྡིང་གི་སྟེང་དུ་གནས་པའོ།",
    "ཁྭ་གདོང་མ་ལ་སོགས་པ་བརྒྱད་པོ་འདི་དག་ཕྱོགས་སྐྱོང་བརྒྱང་རྣམས་ལ་གཡས་བརྐྱང་གིས་གནས་པའོ་ཞེས་པ་ནི་ཕྱོགས་གསུམ་པའོ།",
    "རང་རང་གི་འཁོར་རྣམས་ལ་དཀྱིལ་འཁོར་གྱི་རིགས་ཀྱི་བདག་པོ་ནི་འཁོར་ལོས་སྒྱུར་བ་དྲུག་གིས་སོ།",
    "ཨོཾ་ཤྲཱི་བུད་ྡྷཌཱ་ཀ་ཨ་ལ་ལ་ལ་བྷྲཱུཾ་ཨཱ་ཌཱ་ཀི་ནཱི་ཛཱ་ལ་སཾ་བ་རཾ་ཧཱུཾ་ཕཊ་སྭཱ་ཧཱ།",
    "དེའི་ཤར་དང་ལྷོ་དང་ནུབ་དང་བྱང་གི་རྩིབས་རྣམས་ལ་ཤིན་ཏུ་སྟོབས་བྱེད་དང་།",
    "རེངས་བྱེད་དང་།",
    "གཤིན་རྗེ་མཐར་བྱེད་དང་ཤེས་རབ་མཐར་བྱེད་དང་པདྨ་མཐར་བྱེད་དང་བགེགས་མཐར་བྱེད་ཅེས་བྱ་བ་མིང་གི་རྣམ་གྲངས་སོ།",
    "སྟེང་གི་རྩིབས་ལ་གཙུག་ཏོར་འཁོར་ལོས་སྒྱུར་བའོ།",
    "འོག་གི་རྩིབས་ལ་གནོད་མཛེས་རྒྱལ་པོའོ།",
    "དེའི་ཕྱེད་ཀྱིས་གསུང་གི་དཀྱིལ་འཁོར་རོ།",
    "པདྨའི་སུམ་ཆ་གཅིག་གིས་ཟེ་འབྲུའོ།",
    "སྟག་གི་པགས་པ་འཕྱང་བའི་གོས་བསྣམས་པ་ཞལ་བཞི་པ་ཕྱག་བཅུ་གཉིས་པའོ།",
    "ཕྱག་རེ་རེ་ལ་སོར་མོ་ལྔ་ལྔ་སྟེ།",
    "དེ་དག་རེ་རེ་ཞིང་ཚིགས་རྣམ་པ་གསུམ་གསུམ་མོ།",
    "དེ་ལ་མཐེ་བོང་སེར་པོ་མཛུབ་མོ་དཀར་པོ་གུང་མོ་དམར་པོ་སྲིན་ལག་ནག་པོ་མཐེའུ་ཆུང་ལྗང་གུའོ།",
    "ཁྲག་གིས་གང་བའི་ཐོད་པའོ།",
    "ལྷ་མོ་འདི་དག་ནི་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་འཇུས་པ་དམན་པའི་བཞིན་ཅན་ནོ།",
    "ཤར་གྱི་འདབ་མ་ལ་ནག་མོ་འབར་མ་ནི་ནག་མོ་ཕྱག་གཡས་པ་རྣམས་ཀྱིས་སྤོས་སྣོད་དང་ཙནྡན་གྱི་སྣོད་དང་གུར་གུམ་གྱི་སྣོད་དང་གླ་རྩི་དང་བཅས་པའི་ག་པུར་གྱི་སྣོད་དང་།",
    "ལྷོ་ཕྱོགས་ཀྱི་འདབ་མ་ལ་དམར་མོ་འབར་མ་དམར་མོ་གཡས་པ་རྣམས་ཀྱིས་མར་མེ་དང་དོ་ཤལ་དང་ཅོད་པན་དང་ལག་གདུབ་དང་།",
    "བཅུད་ལེན་གྲུབ་པའི་སྣོད་དང་ཤིང་ཐོག་གི་སྣོད་དང་བཟའ་བའི་སྣོད་འཛིན་པའོ།",
    "རིམ་པ་ཇི་ལྟ་བར་ནག་མོ་དང་དམར་མོ་དང་སེར་མོ་དང་།",
    "སྣ་ཚོགས་ཡུམ་ལ་སོགས་པའི་ལྷ་མོ་ཐམས་ཅད་ནི་ཕྱག་རྒྱ་ལྔ་དང་ལྡན་པ་ཕྱག་བརྒྱད་བ་ཞལ་བཞི་པ་སྤྱན་བཅུ་གཉིས་པའོ།",
    "དེ་ལ་སྣ་ཚོགས་ཡུམ་གྱི་ཤར་དང་ལྷོ་དང་ནུབ་དང་བྱང་གི་རིམ་པས་སེར་པོ་དང་དཀར་པོ་དང་།",
    "སྔོན་པོ་དང་དམར་པོའི་ཞལ་རྣམས་ཏེ་དེ་ལྟར་ལྷ་མོ་སེར་མོ་རྣམས་སོ།",
    "རིམ་པ་གཉིས་པ་དང་གསུམ་པ་དག་གི་ལྷ་རྣམས་ནི་ཕྱག་དྲུག་པ་ཞལ་གསུམ་པ་སྤྱན་དགུ་པ་རྣམས་སོ།",
    "གཡས་ལོགས་སུ་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བ་རྣམ་པར་སྣང་མཛད་ལྟ་བུ་རེག་བྱ་རྡོ་རྗེ་མ་ལ་འཁྱུད་པའོ།",
    "ཕྱོགས་བྲལ་རྣམས་ཀྱི་མེར་རེག་བྱ་རྡོ་རྗེ་མ་སྒྲོལ་མ་ལྟ་བུ་སྒྲིབ་པ་རྣམ་པར་སེལ་བས་སྙོམས་པར་ཞུགས་པའོ།",
    "སྒྲོལ་མ་ལ་སོགས་པའི་ལྷ་མོ་རྣམས་ནི་པདྨའི་གདན་གྱི་འདུག་སྟངས་ཀྱིས་བཞུགས་པའོ།",
    "ཤར་གྱི་སྒོ་ལ་ཁྲོ་བོ་ཤིན་ཏུ་སྟོབས་དོན་ཡོད་གྲུབ་པ་ལྟ་བུ་རེངས་བྱེད་མས་ཡང་དག་བར་འཁྱུད་པ་དེ་ཡང་སྤྱན་མ་ལྟ་བུའོ།",
    "ནུབ་སྒོར་རེངས་བྱེད་ནི་རྣམ་པར་སྣང་མཛད་ལྟ་བུ་ཤིན་ཏུ་སྟོབས་མ་ལ་འཁྱུད་པ་དེ་ཡང་སྒྲོལ་མ་ལྟ་བུའོ།",
    "བྱང་སྒོར་ང་རྒྱལ་བྱེད་ནི་ཆེ་དཔག་མེད་ལྟ་བུ་རྨོངས་བྱེད་མ་ལ་ཡང་དག་པར་འཁྱུད་པ་དེ་ཡང་གོས་དཀར་མོ་ལྟ་བུའོ།",
    "འོན་ཀྱང་ཁྲོ་བོ་འདི་རྣམས་ནི་གཡས་བརྐྱང་གིས་གནས་པའོ།",
    "ཁྲོ་བོའི་ལྷ་མོ་རྣམས་ནི་གཡོན་བརྐྱང་གིས་གནས་པའོ།",
    "དེ་ལ་ལྷ་མོ་རྣམས་ཀྱི་གདན་ནི་པདྨ་དཀར་པོ་དག་ལ་ཉི་མ་རྣམས་སོ།",
    "ལྷ་མོ་རྣམས་ཀྱི་གདན་ནི་པདྨ་དམར་པོ་དག་ལ་ཟླ་བའི་དཀྱིལ་འཁོར་རྣམས་སོ།",
    "དེ་དག་གི་རིགས་པ་ཡང་དྲི་མ་མེད་པའི་འོད་ལས་གསུངས་སོ།",
    "འདིར་འདབ་མ་ལ་གནས་པའི་ལྷ་མོ་བརྒྱད་དང་།",
    "ཤར་གྱི་འདོད་ཡོན་ལ་རྟ་བབས་ཀྱི་གཡོན་གྱི་ཀ་བའི་རྩ་བའི་གཡོན་པ་ལ་དྲི་ཆབ་མ་ནག་མོ་དྲིའི་དུང་ཕོར་ཕྱག་ན་འཛིན་པའོ།",
    "ལྷོའི་སྣམ་བུ་ལ་བདུག་སྦོས་མ་དམར་མོ་ཕྱག་ན་བདུག་སྤོས་ཀྱི་སྣོད་འཛིན་པའོ།",
    "མར་མེ་མ་དམར་མོ་ཕྱག་ན་མར་མེའི་མཆོད་སྡོང་འཛིན་པའོ།",
    "ནུབ་ཏུ་སྒེག་མོ་སེར་མོ་ཅོད་པན་སེར་པོ་འཛིན་པའོ།",
    "བཞད་མ་སེར་མོ་དོ་ཤལ་སེར་པོ་འཛིན་པའོ།",
    "བྱང་དུ་བདུད་རྩི་མ་ཞལ་ཟས་མ་ཞེས་བྱ་བའི་མིང་གི་རྣམ་གྲངས་ཅན་དཀར་མོ་ཕྱག་ན་འབྲས་བུ་དཀར་པོ་འཛིན་པའོ།",
    "བདུད་རྩིའི་འབྲས་བུ་ཞེས་མིང་གི་རྣམ་གྲངས་ཅན་ཕྱག་ན་བདུད་རྩི་དཀར་པོས་གང་བའི་སྣོད་འཛིན་པའོ།",
    "ལྷོར་འདོད་པ་མ་དམར་མོ་པདྨ་ཕྱག་ན་ལྡན་པའོ།",
    "ནུབ་ཏུ་སྒྲ་མ་སེར་མོ་རྔ་པ་ཊ་ཧ་བརྡུང་པའོ།",
    "བྱང་དུ་གླུ་མ་དཀར་མོ་རྡོ་རྗེ་འཛིན་མའོ།",
