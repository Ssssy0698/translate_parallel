    "ཞེས་བདེ་སྡུག་གི་རྒྱུ་གང་ཡིན་ཤེས་ནས།",
    "དེ་ན་གསུམ་འདུས་པའི་རེག་པ་ཡོད་པས་རེག་པ་དང་།",
    "ཉོན་མོངས་པ་གསུམ་གྱིས་ཀུན་ནས་བསླངས་ནས་ལས་གཉིས་བྱས་པས།",
    "སྡུག་བསྔལ་བདུན་འབྱུང་ལ་སྡུག་བསྔལ་དེ་དག་ལས་ཀྱང་ཉོན་མོངས་པ་གསུམ་པོ་འབྱུང་ཞིང་འཁོར་ལོ་བཞིན་དུ་འཁོར་ཏེ།",
    "ད་ནི་ཞར་བྱུང་གི་ཚུལ་གྱིས་འདི་ཡང་ཤེས་པར་བྱ་དགོས་ཏེ།",
    "དང་པོ་མ་རིག་སྲེད་ལེན་ཉོན་མོངས་པ་དེ་གསུམ་ལ་བརྟེན་ནས།",
    "བདག་གི་བ་མེད་པ།",
    "དེ་ལྟར་མིན་པར་གཞན་རྒྱུད་དུ་གྲུབ་པའི་ཀླུའི་གོ་འཕང་དེ་རང་གི་ལུས་སེམས་ཀྱི་གར་སྒྲུབ་པ་ཡིན་ཞེ་ན།",
    "ཁྱོད་ཀྱི་དཔེ་དེ་ཚོ་ཡོད་པར་མ་གྲུབ་པའི་ཕྱིར་ཏེ།",
    "རྨི་ལམ་གང་གི་ཚེ་ན་ཡང་དོན་ལ་བདེན་འཛིན་གྱི་སེམས་བདེན་པར་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར།",
    "ཇི་ལྟར་ཁྱོད་ཀྱི་གཉིད་སད་པ་ན་ངས་འདི་ལྟ་བུ་མཐོང་ངོ་སྙམ་པའི་དྲན་པ་དེ་འདྲ་ཕྱི་རོལ་གྱི་ཡུལ་དྲན་པ་ལ་ཡང་ཡོད་པའི་ཕྱིར།",
    "ཇི་ལྟར་སེམས་ཙམ་པ་ཁྱོད་ཀྱི་ཕྱི་རོལ་གྱི་ཡུལ་རྨི་ལམ་དུ་མ་སྐྱེས་པ་དེ་བཞིན་འདིར་ཡང་རིགས་པའི་ཕྱིར།",
    "ནང་གི་སྐྲར་སྣང་གི་བག་ཆགས་ཡོངས་སུ་སྨིན་པ་དང་མ་སྨིན་གྱི་ཁྱད་པར་ལས་ཡིན་ནོ་ཞེས་སྟོན་ཏེ།",
    "མོ་གཤམ་བུ་ལའང་ནུས་པ་དེ་ནི་ཡོད་པར་ཐལ།",
    "མོ་གཤམ་གྱི་བུ་མ་སྐྱེས་པས་ན་དེ་སྐྱེ་བའི་ནུས་པ་མེད་པ་བཞིན་ནོ།",
    "འོ་ན་སད་པའི་སྐབས་ཀྱི་ལོང་བ་ལ་འདིར་སྔོ་སོགས་སྣང་བའི་ཡིད་བློ་ཅིས་མི་སྐྱེ་སྟེ་སྐྱེ་རིགས་པར་ཐལ།",
    "ཇི་ལྟར་མིག་དང་གཟུགས་མེད་པར་ཡང་རྨི་ལམ་དུ་རང་གི་བག་ཆགས་ཡོངས་སུ་སྨིན་པ་ལས།",
    "གལ་ཏེ་ཁྱོད་སེམས་ཙམ་པ་ལྟར་རྨི་ལམ་གྱི་ཚེ་གཉིད་ཀྱི་རྐྱེན་དྲུག་པ་ཡིད་ཀྱི་ཤེས་པ་སྐྱེ་བའི་ནུས་པ་སྨིན་པ་ཡོད་ལ།",
    "དེ་ལྟར་ན་གཉིད་ཀྱི་རྐྱེན་གྱི་རྨི་ལམ་གྱི་ཚེའང་སྔོ་སོགས་མྱོང་བའི་དྲུག་ཡིད་སྐྱེ་བའི་ནུས་པ་མེད་པ་ཅིས་མི་རིགས་ཏེ་རིགས་པར་ཐལ།",
    "དྲུག་པའི་ཡེ་ཤེས་སྔོ་སོགས་ཉམས་མྱོང་གི་ནུས་སྨིན་ཇི་ལྟར་ལོང་བ་ལ་སད་པའི་སྐབས་འདིར་མེད་པ་ཉིད་མཚུངས་པའི་ཕྱིར།",
    "རྟེན་མེད་པའི་ཕྱིར་རུས་སྦལ་གྱི་སྤུའི་གོས་བཞིན་ཞེས་སོགས་གང་དང་གང་བཏབ་པ་དེ་དང་དེ་ནི་མཁས་པ་དག་གི་དམ་བཅའ་དང་མཚུངས་པར་བསྒྲུབ་བྱ་ལ་ནུས་པ་མེད་པར་མཐོང་བ་ནི་སེམས་ཙམ་པ་རྣམས་ཀྱི་རྩོད་པ་འདི་སེལ་བར་བྱེད་དོ།",
    "དེར་རྣག་ཁྲག་གི་དངོས་པོ་ཅུང་ཟད་ཀྱང་མེད་ལ།",
    "གཟུགས་དེའི་སྣང་བ་རྒྱ་ཆེར་སོང་བས་རྡོ་དུམ་སོགས་ཀྱི་གཟུགས་སྒྲིབ་པས།",
    "ཕྱི་དོན་བདེན་གྲུབ་པར་མི་འདོད་པ་དག་གི་ལུགས་ལྟར་ན།",
    "ཁ་དོག་གི་རྣམ་པ་གང་ལ་དང་པོ་རྟེན་པའི་གཟུགས་དང་མཚུངས་པའི་རྣམ་པར་སྐྱེའོ།",
    "རེག་བྱ་བཅུ་གཅིག་བདག་ཉིད་དོ།",
    "དེ་དག་གི་དབྱེ་བར་ཡ་མ་བརླ་ཡི་ཁྱད་པར་སྒྱུ་མའི་དཔེ་བཅུ་གཉིས་ལ་སོགས་བཀོད་པ་ནི་འགར་ཡང་མེད་དོ།",
    "རྡུལ་ཕྲ་རབ་ལ་གཟུགས་སོ་ཞེས་བཏགས་པའི་ཆ་ཚད་གྲུབ་ཞིག་ལ་གཟུགས་ཚད་གྲུབ་ཏུ་ཁྱེད་རང་གི་ཞེན་དོན་ཡིན་ཏེ།",
    "ཆུའི་ཁྱད་པར་ལ་ཡོད་པའི་ཁ་དོག་ཏུ་ཐལ།",
    "སྨིག་རྒྱུ་ཆུར་སྣང་དེ་སྨིག་རྒྱུ་ཆུར་སྣང་གི་གཟུགས་ཡིན་པ་གང་ཞིག།",
    "ཆུ་དེའི་གཟུགས་ཀྱི་ཆ་དེར་སྣང་ན་དེའི་ཁ་དོག་གི་ཆ་ཡང་དེར་སྣང་བའི་ཕྱིར།",
    "འདོད་ན་སྨིག་རྒྱུ་ཆུར་སྣང་དེ་འཁྲུལ་ཤེས་མ་ཡིན་པར་ཐལ།",
    "དེ་ཆུའི་ཁ་དོག་གི་གཟུགས་མངོན་སུམ་པ་སྣང་ཡུལ་དུ་བྱས་པའི་ཕྱིར།",
    "གཞན་ཡང་མངོན་སུམ་ལྟར་སྣང་མངོན་སུམ་ཡང་དག་ཡིན་པར་ཐལ།",
    "རྟགས་ལྟར་སྣང་རྟགས་ཡང་དག་ཡིན་པར་ཐལ།",
    "དེ་ནི་མིག་གིས་བལྟ་བར་མི་ནུས་ཞེས་སོགས་དང་།",
    "བརླན་ཅིང་གཤེར་བ་སྣོད་གང་གི་གོ་ས་ན་རྣག་ཁྲག་སྣོད་གང་ཡོད་དོ་ཞེས་ཀྱང་མི་སྨྲ་ཡི།",
    "གང་གི་ཚེ་ཡི་དྭགས་ཞིག་གཞི་དེར་ཉེ་བར་འོངས་པ་ན།",
    "ཡི་དྭགས་གཞི་དེ་ནས་སོང་བ་ན།",
    "ལས་ཀྱི་བདག་རྐྱེན་མ་ཚང་བས་རྣག་ཁྲག་གི་རྒྱུན་ཕྱི་མ་མི་སྐྱེ་ཞིང་མི་སོགས་ཀྱིས་ཆུར་མཐོང་ཚུལ་ཡང་དེ་དང་འདྲའོ།",
    "བརླན་གཤེར་ཕོར་གང་དང་ཆུ་གཞི་མཐུན་པ་མེད་དོ་ཞེས་པ་ནི་མཁས་པ་ནས་གནག་རྫི་མོའི་བར་གྱི་མྱོང་བ་དང་འགལ་བ་ཉིད་ཀྱིས་དེ་ལྟར་བརྗོད་པས་རང་ཉིད་གནག་རྫི་མོ་ལས་ཀྱང་བླུན་པར་སྟོན་པར་བྱེད་པ་ཉིད་དོ།",
    "ཡོད་ན་ཆ་ཅན་ཆ་ཤས་གསུམ་ཐལ།",
    "མེད་ན་རྒྱུ་གཅིག་གི་འབྲས་བུ་དུ་མ་བྱེད་པར་འགལ།",
    "དེའི་ཆ་ཤས་ཐམས་ཅད་ཚོགས་པའི་ཆ་ཅན་དེ་མ་ཡིན་པར་ཐལ།",
    "ཡོད་ན་དམིགས་སུ་རུང་བ་གང་ཞིག་འགྲོ་བ་རིས་དྲུག་གང་གིས་ཀྱང་མཐོང་བ་མེད་པའི་ཕྱིར།",
    "འགྲོ་བ་དྲུག་གིས་དེའི་ཆ་ཤས་སོ་སོ་ལས་ཆ་ཅན་དེ་མ་དམིགས་པའི་ཕྱིར།",
    "དེ་འདྲའི་ཆ་ཅན་དེ་ཀུན་མཁྱེན་ཡེ་ཤེས་ཀྱིས་ཡོད་པར་གཟིགས་སོ་ཞེ་ན།",
    "ཁྱོད་ཆ་ཤས་ཀྱི་རྫས་སོ་སོ་ལ་དབྱེར་མེད་དུ་ཡོད་རིགས་པར་ཐལ།",
    "ཁྱབ་པ་སོང་།",
    "མ་གྲུབ་ན་སྤྱི་བཏགས་ཡོད་མ་ཡིན་པར་ཐལ།",
    "ཡང་ཐལ་འགྱུར་སྔ་མ་ལ་འདོད་ལན་འདེབས་ན།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཆ་ཅན་གྲུབ་ཙམ་ནས་ཆ་ཤས་ཀྱང་གྲུབ་པར་ཐལ་བ་དང་།",
    "ཞེན་དོན་ལ་ཆ་ཤས་རྫས་དེ་གསུམ་གྱི་བདག་ཉིད་ཀྱི་ཆ་ཅན་དེ་ཆ་ཤས་སོ་སོ་ལ་དབྱེར་མེད་དུ་ཡོད་པར་འདོད་པ་དེའི་ཕྱིར་ཆ་ཅན་དེ་ཆ་ཤས་གསུམ་གའི་གཞི་མཐུན་དུའང་ཐལ་ཞིང་།",
    "ཡང་ཆ་ཅན་གྱི་གོ་སར་ཆ་ཤས་ཀྱང་ཡོད་པར་ཐལ།",
    "ཁྱོད་ཆ་ཤས་ཆུར་སྐྱེ་བ་ན་རྣག་དང་བདུད་རྩིར་ཡང་འབྲལ་མི་ཤེས་སུ་སྐྱེ་རིགས་པར་ཐལ།",
    "དེའི་ལས་ཀྱིས་བདག་རྐྱེན་བྱས་ནས་ཆ་ཤས་རྣག་ཁྲག་ཕྱིས་སྐྱེ་བ་མི་འཐད་པར་ཐལ།",
    "རྣག་སོགས་ཀྱི་ཆ་ཤས་གང་ཡང་དང་པོ་ནས་ཆ་ཅན་དེ་ལ་མེད་ན་ཆ་ཅན་དེ་ཆ་ཅན་དུ་གང་གིས་ཀྱང་མི་འགྲུབ་པའི་ཕྱིར།",
    "མ་གྲུབ་ན་ཡན་ལག་མེད་པའི་ཡན་ལག་ཅན་ཡོད་པར་ཐལ།",
    "ཆ་ཅན་དེ་ལས་ཆུ་སྐྱེ་བར་མི་རིགས་པར་ཐལ།",
    "ཁྱོད་སྐྱེ་བ་རང་གི་རིགས་འདྲ་སྔ་མའི་རང་རྒྱུད་ལས་སྐྱེ་མི་དགོས་པ་གང་ཞིག།",
    "ཆ་ཅན་གྱི་གཞིའི་གན་དུ་ཡི་དྭགས་འོངས་ན་རྣག་ཁྲག་གི་ཆ་ཤས་གསར་དུ་སྐྱེ་བའང་མ་གྲུབ་པར་འགྱུར་ལ།",
    "ཡང་འགྲོ་བ་གསུམ་ཀ་ཡང་མེད་པའི་ས་སྟེང་གི་ཆུ་རྒྱུན་ཆུ་རང་ག་བར་ཡོད་པའི་ཚེ་ཆ་ཅན་ལས་ཆ་ཤས་དེ་སྔ་བར་ཐལ།",
    "འདོད་ན་ཆ་ཅན་ལས་ཆ་ཤས་གསར་དུ་སྐྱེ་བ་མ་ཡིན་པར་ཐལ།",
    "ཁྱོད་ཆ་ཤས་མ་ཡིན་ཐལ།",
    "མིའི་བལྟ་བྱ་ལ་ཆུ་ཕོར་གང་དུ་སྐྱེས་པ་དེ་ཡི་དྭགས་ཀྱི་ལག་ཏུ་བླངས་ནས་འཐུང་བའི་ཚེ་ལས་ཀྱིས་རྣག་ཁྲག་གི་ཆ་ཤས་སུ་གསར་དུ་སྐྱེས་པའི་ཕྱིར།",
    "འདོད་ན་ཆ་ཤས་དང་ཆ་ཅན་གཞི་མཐུན་དུ་ཁས་ལེན་རིགས་པར་ཐལ།",
    "ཆ་ཤས་དང་ཆ་ཅན་ཐམས་ཅད་ཨ་མཉམ་དང་ཆ་མཉམ་དུ་མི་འདོད་བཞིན་ཁས་ལེན་དགོས་བྱུང་བའི་ཕྱིར།",
    "ཡང་འགྲོ་བ་གསུམ་གྱི་བལྟ་བྱ་ཆ་ཅན་ཐུན་མོང་བ་དེ་ལ་བལྟས་ཀྱང་དེ་མཐོང་མི་རུང་བའམ་མཐོང་མི་སྲིད་པ་ཐལ།",
    "དེ་དག་གིས་དེ་ལྟ་བར་རློམ་ཡང་བལྟ་བྱ་ཆ་ཅན་ཐུན་མོང་བ་དེ་མ་མཐོང་བར་བལྟ་བྱ་ཆ་ཤས་ཐུན་མོང་མིན་པ་དེ་སོ་སོར་མཐོང་བའི་ཕྱིར།",
    "ཁྱོད་ལ་འགྲོ་བ་གསུམ་པོས་བལྟས་ཀྱང་བལྟ་མ་ཐུབ་པའམ་དོན་ཐུན་མ་བལྟས་པར་ཐལ།",
    "ཁྱོད་ཀྱིས་བལྟ་བྱ་ཐུན་མོང་བ་དེ་མཐོང་མི་སྲིད་པའི་ཕྱིར།",
    "ཁྱེད་རང་གིས་བརླན་གཤེར་ཕོར་གང་ལྷ་སོགས་ཀྱིས་ལྟས་ཚེ་གསུམ་ག་བལྟ་བྱ་ཐུན་མོང་བར་སོང་ཞེས་སྨྲས་པས་དེ་བལྟ་བྱ་ཐུན་མོང་བར་ལྟ་བ་མི་སྲིད་པ་ཞིག་ཁས་ལེན་དགོས་བྱུང་བ་ཐུགས་དྲན་གྱིས་ཟིན་ལགས་སམ།",
    "མི་གཞན་གྱིས་ལག་པས་རེག་པ་ན་ཚ་ཞིང་བསྲེགས་པ་དང་ལྕགས་གོང་ལ་ཚ་བ་དང་མི་ཚ་བའི་རེག་བྱའི་ཆ་ཤས་གཉིས་ཡོད་པ་ལས།",
    "སྔགས་ཀྱིས་བཏབ་པའི་ལག་པས་མི་ཚ་བས་རེག་བྱ་མྱོང་གི་ཚ་བ་མ་མྱོང་ལ།",
    "མི་གཞན་གྱིས་ལག་པས་རེག་པའི་ཚེ་ཚ་བའི་རེག་བྱ་མྱོང་གི་མི་ཚ་བའི་རེག་བྱ་མ་མྱོང་བ་ལྟ་བུ་སྟེ།",
    "དེ་ཡང་ཟླ་བའི་འོད་ཟེར་དང་ཡི་དྭགས་ཀྱི་ལུས་གཉིས་དུས་སོས་ཀའི་ཚེ་འཚོགས་པ་ན་ཡི་དྭགས་ཀྱི་ལུས་ཀྱི་རྣམ་པར་ཤེས་པའི་གཟུང་ཡུལ་དུ་སོང་བའི་ཟླ་བའི་འོད་ཟེར་གྱི་ཆ་གཅིག་དེའི་ཚ་བའི་རེག་བྱར་སྐྱེས་ལ།",
    "དགུན་གྱི་དུས་ཉི་མའི་འོད་ཟེར་དང་ཡི་དྭགས་ཀྱི་ལས་འཚོགས་པ་ན་ཡི་དྭགས་ཀྱི་ལུས་ཤེས་ཀྱི་གཟུང་ཡུལ་དུ་སོང་བའི་ཉི་མའི་འོད་ཟེར་གྱི་རེག་བྱའི་ཆ་གཅིག་བསིལ་བའི་རེག་བྱར་སྐྱེས་པ་ཡིན་གྱི།",
    "ཡི་དྭགས་ཀྱི་ལས་དང་མ་ཚོགས་པའི་དུས་ཐམས་ཅད་ཀྱི་ཚེ་ཟླ་ཉིས་འོད་ཟེར་ལ་ཚ་གྲང་གི་རེག་བྱ་གཉིས་ཡོད་པར་ཁས་མི་ལེན་ལ།",
    "ལྕགས་གོང་དམར་འབར་ལ་སྔགས་བཏབ་པའི་ལག་པས་རེག་པ་ན་ལག་པ་མི་ཚིགས་པར་བསིལ་བར་སྣང་བ་དེ།",
    "དེ་ཚེ་ལྕགས་གོང་དམར་འབར་ལ་གྲང་རེག་སྐྱེས་པའི་མཐུས་མ་ཡིན་ཏེ།",
    "དཔེར་ན་བུལ་ཆུས་ལག་པ་ལ་བྱུགས་ནས་མེ་ལ་རེག་པ་ན་ལག་པ་མི་འཚིག་པ་བུལ་ཆུའི་མཐུ་ཡིན་གྱི།",
    "དེའི་ཚེ་བུལ་ཆུས་མེ་ལ་གྲང་རེག་གསར་དུ་སྐྱེས་པ་མ་ཡིན་པ་བཞིན་ནོ།",
    "ཁྱེད་ལྕགས་དམར་འབར་བ་ལ་ཚ་གྲང་གི་རེག་པ་གཉིས་ཡོད་པ་དེ་སྔགས་ནུས་ཅན་གྱི་ལག་པས་རེག་པའི་རྐྱེན་གྱིས་དམར་འབར་བའི་གྲང་རེག་གསར་དུ་བསྐྱེད་པར་བྱའོ།",
    "ཞེས་བསམ་པར་སྣང་མོད།",
    "དེ་ལྟ་ན་ལྕགས་གོང་དམར་འབར་བ་ལ་ཡོད་པའི་ཚ་གྲང་གི་རེག་པ་དེ་གཉིས་སྟོབས་མཉམ་དུ་ཡོད་དམ།",
    "དང་པོ་ལྟར་ན་ལྕགས་གོང་དམར་འབར་བ་དེར་སྔགས་བཏབ་མ་བཏབ་ཀྱི་ལག་པ་གང་དེར་བཅུག་ཀྱང་དེའི་ཚ་གྲང་གི་རེག་པ་གཉིས་ཅར་མྱོང་བར་ཐལ།",
    "དེའི་སྟེང་གི་རེག་པ་དེ་གཉིས་དངོས་དོན་ལ་སྟོབས་མཉམ་ཡིན་པའི་ཕྱིར་དང་།",
    "དེའི་ཚེ་སྔགས་ནུས་ཀྱི་དམར་འབར་བ་དེ་ལ་གསར་དུ་གྲང་རེག་བསྐྱེད་མི་དགོས་པའི་ཕྱིར།",
    "གཉིས་པ་ལྟར་ན་ལྕགས་གོང་དམར་འབར་བའི་གོ་སར་ཚ་གྲང་གི་རེག་པ་གཉིས་ལྷན་ཅིག་དེར་ཡོད་པ་མ་ཡིན་པར་ཐལ།",
    "ཚ་རེག་སྟོབས་ཅན་དང་གྲང་རེག་སྟོབས་ཆུང་ལྷན་གཅིག་མི་གནས་འགལ་ཡིན་པའི་ཕྱིར།",
    "དེར་གྲང་རེག་གཏན་མེད་པའི་ཕྱིར།",
    "དེར་གྲང་རེག་མེད་ལ།",
    "དེར་གྲང་རེག་གཏན་མེད་དོ་ཞེས་པ་འདི་གྲུབ་བོ།",
    "ཁྱེད་ལྟར་ན་ཆུ་འཁྱག་པའི་གོང་བུ་ལ་སྔགས་སོགས་ཀྱི་ཁྱད་པར་གྱིས་ཚ་རེག་བསྐྱེད་ནས་ལག་པ་ཚིག་པ་ཞིག་ཡོད་པར་ཐལ།",
    "ལྕགས་གོང་དམར་འབར་བ་ལ་སྔགས་ཀྱིས་གྲང་རེག་བསྐྱེད་ནས་ལག་པ་བསིལ་བར་ཉམས་སུ་མྱོང་བ་ཞིག་ཡོད་པ་དེ་འདིར་ཡང་མཚུངས་པའི་ཕྱིར།",
    "འདོད་ན་འཁྱག་གོང་གིས་ལག་པ་སྲེག་པའི་རྣམ་བཞག་འཇིག་རྟེན་ན་སྔར་མི་སྲིད་ཅིང་མ་གྲགས་པའི་གཏམ་སུ་ཞིག་གི་རྣ་བས་མཉན་པར་བྱེད་དེ།",
    "ཡང་ཁྱོད་ཀྱི་ཟླ་ཉི་འོད་བཅས་ཡི་དྭགས་ཀྱི་ལས་དང་ལྷན་ཅིག་འཛོམས་ན་ཚ་གྲང་གི་རེག་པ་གོ་ལོག་ཏུ་འགྱུར་ཞེས་བསམ་མོད།",
    "ཁྱོད་ཡི་དྭགས་ཀྱི་ལས་དང་འཚོགས་པ་ན་ཚ་ཟེར་ཅན་དང་བསིལ་ཟེར་ཅན་གྱི་ཁྱད་པར་དུ་བྱས་པ་མ་ཡིན་པར་ཐལ།",
    "ཁྱོད་ཉི་མ་དང་ཟླ་བ་མ་ཡིན་པར་ཐལ།",
    "ཟླ་བ་དང་ཉི་མར་ཐལ།",
    "འདོད་ན་ལྷ་མི་དང་མི་ལྷར་ཐལ།",
    "ཡང་རྩ་བར་འདོད་ན་སོས་ཀ་དང་དགུན་དུས་ཀྱི་ཟླ་ཉི་དེ་ཟླ་ཉི་ཡིན་པར་ཐལ།",
    "ངག་དོན་ཟླ་བ་ཚ་རེག་ཅན་དང་ཉི་མ་གྲང་རེག་ཅན་དུ་སྨྲ་དགོས་པ་འདི་འཇིག་རྟེན་དང་བསྟན་བཅོས་གང་དུའང་མ་གྲགས་ལ།",
    "ཡི་དྭགས་ཀྱི་ཆུ་ཀླུང་ལ་བལྟས་པས་རྣག་ཁྲག་ཏུ་སྣང་བ་དང་ཟླ་བ་ལ་བལྟས་པས་ཚ་རེག་ཅན་དུ་སྣང་བ་ནི་ལས་ཀྱི་ནུས་པས་འཁྲུལ་སྣང་དུ་ཟད་པ་ལས།",
    "དེས་ན་མི་ལ་སྣང་བའི་ཆུ་ཀླུང་གི་ཆ་དང་ཆ་ཅན་མིང་ཅིར་བཏགས་ཀྱང་དེའི་སྟེང་དུ་ཡི་དྭགས་ལ་སྣང་བའི་རྣག་ཀླུང་སོགས་མེད་དེ།",
    "དེ་ལ་ནི་རྣག་ཐིག་པ་འགའ་ཡང་མེད་ན་རྣག་གིས་གང་བའི་ཀླུང་ག་ལ་ཡོད་དེ།",
    "སུ་ཞིག་གི་ནི་ཆེད་དུ་བྱས།",
    "དགེ་མི་དགེ་སྤྱད་པའི་ལས་འབྲས་ལ་འཁྲུལ་སྣང་བཟང་ངན་ཙམ་ལས་བདེ་སྡུག་དངོས་སུ་མྱོང་མ་མྱོང་གི་ཁྱད་པར་ཅུང་ཟད་ཀྱང་མེད་པར་སྨྲ་དགོས་ལ།",
    "དེར་སྣང་གི་སྣང་ཆ་ཐམས་ཅད་ལ་འཁྲུལ་སྣང་དུ་སྔ་རབས་པའི་ཐལ་འགྱུར་བ་ཆེན་པོ་དག་བཞེད་མོད།",
    "འདིར་དེ་ཙམ་དུ་སྨྲ་ནའང་བྱིས་པ་དག་སྐྲག་པས་མཐའ་གཅིག་ཏུ་ཐལ་ཆེས་པར་འགྱུར་མོད།",
    "སོ་སྐྱེ་ཚུ་རོལ་ལས་མཐོང་བ་མེད་པ་ལ་ནི་ལས་དང་ཉོན་མོངས་པས་བསྐྱེད་པའི་འཁྲུལ་པ་འབའ་ཞིག་ལ་ལོངས་སྤྱོད་པའི་ཕྱིར་དང་།",
    "དོན་དམ་པ་ལ་མི་མོས་པ་གང་ཟག་ཏུ་བལྟ་བ་སྟེ་གང་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་སྟོང་པ་ཉིད་ལ་མོས་པ་མེད་པ་ནི་མུ་སྟེགས་པ་དག་དང་ཁྱད་པར་མེད་པ་ཡིན་ནོ།",
    "འཁྲུལ་སྣང་གི་གོ་མི་ཆོད་པར་ཐལ།",
    "དེ་ལྟ་ན་འཕྲལ་དང་ཕུགས་ཀྱི་འཁྲུལ་པས་བསྐྱེད་པའི་འཁྲུལ་སྣང་གཉིས་ཀས་འཁྲུལ་སྣང་གི་གོ་མི་ཆོད་ན་འཁྲུལ་སྣང་གོ་ཆོད་པོ་དེ་ངོས་འཛིན་པར་མཛོད་ཅིག།",
    "ཡང་དེ་པས་འདིར་ནི་ཆ་ཅན་བརླན་ཞིང་གཤེར་བ་གཅིག་གི་གོ་ས་ན་ཡུལ་དེར་ལྷ་མི་ཡི་དྭགས་ལ་སོགས་པ་ལས་དེ་དང་དེའི་རྐྱེན་ཅན་རྣམས་འཚོགས་པའི་དུས་འགའ་ཞིག་གི་ཚེ་ཆ་ཅན་དེ་ཆ་ཤས་རྣག་དང་བདུད་རྩི་དང་ཆུ་དྭངས་ཤིང་བསིལ་བ་རྣམས་དངོས་གནས་ལའང་ཡོད་པར་ཁས་ལེན་པ་ཡིན་ལ།",
    "དེ་ལྟ་ན་ཀླུང་གཅིག་གི་གོ་སར་རྫས་དེ་དག་དུ་མ་ཡོད་དགོས་པར་འགྱུར་བས་གཟུགས་ཅན་གཅིག་གིས་གཟུགས་ཅན་གཞན་གྱི་གོ་ས་མི་འགོག་པར་འགྱུར་ཞེས་སྨྲ་བ་ནི་རིགས་པའི་རྣམ་པ་མ་ཆགས་ཤིང་ཕྱོགས་སྔ་མའི་ནམ་མ་ལངས་པ་ལ་དགག་པའི་ཉི་མ་ཤར་བ་སྟེ།",
    "ཆ་ཅན་གཅིག་གི་གོ་ས་ན་ཆ་ཤས་དངོས་པོ་ཐ་དད་པ་དུ་མ་ཡོད་མི་སྲིད་པར་ཐལ།",
    "འདོད་ན་བུམ་པ་གཅིག་གི་གོ་སར་བུམ་པའི་ཆུ་དང་ཞབས་དང་ལྟོ་བ་སོགས་དུ་མ་གནས་པ་མི་སྲིད་པར་ཐལ་ཞིང་།",
    "བརླན་ཅིང་གཤེར་བ་ཕོར་གང་གི་གོ་ས་ན་ཆུ་དྭངས་ཤིང་བསིལ་བ་འོ་མ་དང་ཁྲག་ཆང་སྟེ་དངོས་པོ་ཐ་དད་པ་བཞི་དུས་གཅིག་ཏུ་ཡོད་པའི་ཕྱིར།",
    "བདག་གི་རྗེ་ཐམས་ཅད་མཁྱེན་པ་ནི།",
    "བརླན་གཤེར་ཕོར་གང་ལ་དུས་ཁྱད་པར་ཅན་དེ་འདྲའི་ཚེ་རྣག་དང་བདུད་རྩི་ལ་སོགས་པར་སྐྱེས་པའི་ཆ་ཤས་དུ་མ་དུས་གཅིག་ཏུ་ཡོད་པར་བཞེད་ཀྱི་བརླན་ཅིང་གཤེར་བ་ཕོར་གང་གི་གོ་ས་ན་རྣག་ཕོར་གང་དང་བདུད་རྩི་ཕོར་གང་ཆུ་དྭངས་ཤིང་བསིལ་བ་ཕོར་གང་ཡོད་པ་སོགས་དང་ཆུ་རྡུལ་གཅིག་གི་གོ་ས་ན་བདུད་རྩིའི་རྡུལ་གཅིག་དང་རྣག་ཁྲག་གི་རྡུལ་གཅིག་ཏུ་ཡོད་པ་སོགས་གཏན་མི་བཞེད་ཅིང་དེ་ལྟར་ཟུར་ཙམ་ཡང་མ་གསུངས་པས་དེ་ལྟར་གསུངས་སོ་སྙམ་ནས་གནོད་པ་སྟོན་ན་ནི་རང་ཉིད་སྟོན་པར་བྱེད་པ་ཙམ་དུ་ཟད་དོ།",
    "དང་པོ་ཆ་ཅན་བརླན་གཤེར་གཅིག་གི་གོ་སའི་ཡུལ་དེར་ལྷ་མི་སོགས་ལས་ཀྱི་རྐྱེན་འཚོགས་པ་ན་དེའི་ཆ་ཤས་ཆུ་དངོས་གནས་ལའང་ཡོད་ཅེས་འཆད་པ་དེ་ལ་འདི་འདྲི་སྟེ།",
    "ཆ་ཤས་རྣག་སོགས་གསུམ་གྱི་རྡུལ་ཕྲན་དངོས་གནས་ལའང་ཡོད་པ་མ་ཡིན་པར་ཐལ།",
    "གཟུགས་ཀྱི་རྡུལ་ཕྲན་གཅིག་གི་གོ་སར་གཅིག་ཤེས་མི་ཤོང་བའི་ཕྱིར།",
    "ཡང་ཁྱེད་བུམ་པ་གཅིག་གི་གོ་སར་བུམ་པའི་མཆུ་ཞབས་སོགས་གནས་མི་སྲིད་པར་ཐལ་བ་འཕངས་གདའ་བ།",
    "ཡང་ཁྱེད་ཀྱིས་རྗེ་ཐམས་ཅད་མཁྱེན་པ་བརླན་གཤེར་ཕོར་གང་གི་གོ་ས་ན་རྣག་ཆུ་བདུད་རྩི་ཕོར་གང་ཡོད་པ་གཏན་མི་བཞེད་ཅེས་དང་།",
    "དེའི་གོང་དུ་བརླན་གཤེར་ཕོར་གང་གི་གོ་འམ་ཡུལ་དེར་རྐྱེན་འཚོགས་ཚེ་ཆ་ཅན་དེའི་ཆ་ཤས་ཆུ་སོགས་དངོས་གནས་ལའང་ཡོད་པར་ཁས་ལེན་ཞེས་པའང་ཞེན་དོན་ལ་ཆེས་འགལ་བར་གོ་བས།",
    "འོ་ན་བརླན་གཤེར་ཆ་ཅན་གྱི་གོ་སའམ་ཡུལ་དེར་རྐྱེན་འཚོགས་པ་ན་ཆ་ཅན་དེའི་ཆ་ཤས་ཆུ་སོགས་གསུམ་དངོས་གནས་ལ་དེར་ཡོད་པ་མ་ཡིན་པར་ཐལ།",
    "རང་རང་གི་བློ་ངོ་ན་ཐད་ཀ་ཐད་ཀ་བདེན་པས་བརླན་གཤེར་གྱི་དངོས་པོ་གཅིག་ཉིད་ཡི་དྭགས་ཀྱི་ངོ་ན་རྣག་ཏུ་བདེན་མིའི་ངོ་ན་ཆུར་བདེན་ཞེས་སོགས་སུ་སྨྲ་བ་དེ་དག་ནི་གཅེར་བུ་པ་དང་མཚུངས་པར་ཆེས་བླུན་པོར་གོ་བར་བྱེད་པ་སྟེ།",
    "ཞེས་བྲིས་གདའ་བ་འདི་སུ་ཞིག་ལ་ཁྱེད་ཀུན་སློང་ཅི་ཞིག་གིས་སྡང་ཤུགས་ཀྱིས་སྨྲ་བ་ཡིན།",
    "འགྲོ་བ་ཐ་དད་པའི་ལས་སྣང་གི་ཆུ་རྣག་སོགས་རྨི་ལམ་གྱི་ཆུ་རྣག་ལྟར་མ་གྲུབ་པ་ཉིད་དུ་བསྟན་ཏེ།",
    "བུད་མེད་ལུས་ནི་གཅིག་ཉིད་ལས།",
    "རྒྱལ་བའི་ཁྲུ་ནི་གཅིག་དང་དུ་མ་དག་གིས་གཞལ་དཀའ་བ་དག་གིས་ཚད་གཞལ་བར་ཡང་མི་ནུས་པ་དང་།",
    "གལ་ཏེ་ཚད་འདི་བདག་གི་འདོད་པ་བརྗོད་ན་ལྷ་རྣམས་ཀྱིས་འདི་མེད་པ་པ་ཞེས་བརྗོད་པར་འགྱུར།",
    "འདི་ལ་སྐྱེ་བར་སྣང་བར་ནི་རྟེན་འབྱུང་ཙམ་དུ་རུང་མོད།",
    "འགྲོ་བ་དྲུག་ཀས་རློམ་ཚོད་ཐུན་མོང་དུ་བལྟ་བྱར་རློམ་ཞིང་སོང་ཚོད་ལ་གང་དུའང་ལྟ་བྱར་མ་སོང་བའི་གཞི་དེར།",
    "འོ་ན་སྐྱེ་བ་མེད་པ་དེ་དོན་དམ་པར་ཡིན་མོད།",
    "འོ་ན་ཐམས་ཅད་དོན་ལ་མ་གྲུབ་ཅིང་བཏགས་པ་ཙམ་དུ་ཟད་ན་བཏགས་པ་ཉིད་ཡོད་པ་ཉིད་ཀྱིས་དོན་ལ་ཡོད་པར་སོང་བས་ཚིག་ལ་མི་རྩོད་ཀྱི་དོན་གྲུབ་བོ་སྙམ་ན་མ་ཡིན་ཏེ།",
    "དེ་མི་བརྗོད་ན་དེའི་སྟེང་གི་རྟགས་ཀྱི་དགག་བྱའི་སྐྱེ་བ་མཚན་མ་བདེན་གྲུབ་པ་གཞན་པ་ཞིག་མེད་དོ་ཞེས་ནི་རྨི་ལམ་དུའང་སྨྲ་བར་བྱ་བ་མིན་ཏེ་རང་ལུགས་འདི་གོ་དཀའ་བར་དྭོགས་ན།",
    "སྐྱེ་བ་ལྟར་སྣང་བས་ལྟར་སྣང་གི་སྐྱེ་མཚན་དེ་ཀ་ཉིད་སྐྱེ་མེད་དུ་བརྗོད་ལ་དེ་ལྟ་ན་སྦྱོར་ངག་ཏུ་དྲིལ་ན།",
    "སྐྱེ་བ་རང་བདེན་པ་ཞིག་སྲིད་ན་སྲིད་ཆ་དེ་སྐྱེ་མེད་དང་མཚན་མེད་སོགས་སུ་མི་བརྗོད་ཀྱི་ཁྱད་གཞི་ཆུ་རང་གི་མཚན་མ་ཆུའི་མཚན་མའམ་བདེན་པ་བར་མ་གྲུབ་པའི་ཕྱིར་ན།",
    "ཞེས་གསུངས་པས་མཚན་མ་དང་སྐྱེ་བ་ཉིད་མཚན་མེད་དང་སྐྱེ་བ་མེད་པ་ལ་རང་ཚིག་འགལ་སྤང་དང་བཅས་ཏེ་རྒྱ་ཆེར་གསུངས་པ་ཉིད་ངེས་པའི་དོན་དྲང་བའི་དོན་ལས་རིང་དུ་སོང་བ་ཡིན་ཏེ།",
    "འོན་ཀྱང་མཆོག་གི་སྐལ་ཅན་དག་གི་ངོར་བརྩེ་བས་བརྗོད་ན་སྐྱེ་བ་རང་ལྡོག་གི་ཆ་རང་བདེན་པ་ཞིག་གདོད་ནས་སྐྱེ་བ་མེད་བྱས་ན་རང་ཚིག་འགལ་བ་དང་རིགས་པས་ཀྱང་གནོད་མོད།",
    "ཁྱོད་སྐྱེ་བ་ན་ལྟོས་དང་བཅས་རྟེན་དང་བཅས་ཏེ་སྐྱེ་དགོས་པའི་ཕྱིར།",
    "འོ་ན་དོན་ལ་མ་སྐྱེས་པ་ཞིག་ལ་སྐྱེ་མེད་དུ་སོང་བས།",
    "འོ་ན་གདོད་ནས་སྐྱེ་བ་མེད་པ་ལ་སྐྱེས་པ་དེ་སྐྱེ་མེད་དུ་བརྗོད་པར་སོང་ངོ་ཞེ་ན།",
    "དེས་ན་གནས་ཚུལ་སེམས་པ་ན་གང་ཡང་སྒྲུབ་པ་མེད་པ་ཉིད་ཀྱི་དགག་པ་མེད་པར་ཡང་ཤེས་པས་ལུང་རིགས་ཀྱི་དགག་སྒྲུབ་ཐམས་ཅད་དང་བྲལ་བའི་ཟབ་མོ་སྟོང་པ་ཉིད་ཀྱིས་ན་གོ་མྱོང་རྟོགས་སུ་མི་རུང་བའི་རྟོགས་པ།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་སྨིན་ཚུལ་ལ་མྱོང་ངེས་གསུམ་གྱི་རྣམ་པར་བཞག་པ་མི་རིགས་པར་ཐལ།",
    "དཔེར་ན་ཐག་རིང་ཞིག་གི་བུ་ལོན་དེ་བཅལ་དགོས་ན།",
    "ཁ་ཅིག་ན་རེ།",
    "ཁ་ཅིག་ན་རེ།",
    "དཔེར་ན་ཁ་དྲག་པོ་ཞིག་གི་བུ་ལོན་དེ་གནངས་ཁོ་ན་ལ་འཇལ་དགོས་པ་ལྟ་བུའོ།",
    "དཔེར་ན་ཁ་ཞན་པོ་ཞིག་གི་བུ་ལོན་དེ་དུས་དང་འཇལ་དགོས་པ་གཉིས་ཀ་མ་ངེས་ལྟ་བུའོ།",
    "ཉིད་དེང་སང་དབུས་གཙང་ན་གྲགས་པའི་རབ་འབྱམས་ཐམས་ཅད་ཀྱི་ཕྱི་མོ་ལགས་པས་མཛོད་ཀྱི་གྲ་སྐོར་སྦྲེལ་བའི་དུས་སུ།",
    "ཉོན་མོངས་རབ་དང་དྲག་པོ་དང་།",
    "ཞིང་གི་ཁྱད་པར་རོ།",
    "གང་དག་འགོག་བྱམས་ཉོན་མོངས་མེད།",
    "ཞེས་སྦྲེལ་གིན་སྣང་བས་དེའི་དུས་ཀྱང་ཐུགས་རྩེ་གཅིག་ཏུ་གཏད་པའི་བརྡ་དོན་ཞིག་མ་འཕྲོད་པ་ལགས་སམ།",
    "གཞན་ཡང་བསྐྱེད་རིམ་གྱི་སྒོ་ནས་སྔགས་ཀྱི་སྐུ་དང་རྫོགས་རིམ་གྱི་སྒོ་ནས་ཡེ་ཤེས་ཀྱི་སྐུ་སྒྲུབ་ཀྱང་སྒྲུབ་བྱེད་ཡང་དག་མ་ཡིན་པར་ཐལ།",
    "མ་གྲུབ་བོ་ཞེ་ན་གྲུབ་པར་ཐལ།",
    "དེའང་འདོད་ན་སློབ་དཔོན་བྱང་བཟང་གི་ཏིང་ངེ་འཛིན་གྱི་ཚོགས་ཀྱི་ལེའུ་ལས།",
    "འདི་ནི་བདག་ཏུ་ལྟ་བ་ལ་སོགས་པ་ཉིད་དང་འགལ་བར་འཇུག་པ་དེ་དག་གི་ཕྱིར་སྟོང་པ་ཉིད་ཀྱི་ཆེ་བ་བསྟན་པ་སྟེ།",
    "བརྟན་པ་ཐོབ་པའི་བསྐྱེད་རིམ་རྟོགས་པ་དང་བཅས་པའི་བསམ་གཏན་ཆེས་གསལ་སྣང་མཆེད་པ་ལྷ་སྣང་མངོན་དུ་འཆར་ནས་ཐུན་མོང་གི་དངོས་གྲུབ་ཀྱི་བྱ་བ་ཉི་ཚེ་འགྲུབ་པར་གསུངས་པ་ནི།",
