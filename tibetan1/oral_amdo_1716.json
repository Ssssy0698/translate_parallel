    "ཕན་སླད་རང་གི་སྤོབས་པས་གོ་ཚོད་རྣམས།",
    "དེ་ནས་ཕྱག་དང་བཅས་གྲལ་ལ་འཁོད་ནས་ཐུན་མོང་གི་ཁྲིད་རྣམས་ལ་སྐྱབས་སེམས་ཡན་ལག་བདུན་པ་སྔོན་དུ་འགྲོ་བས་མཎྜལ་ཕྱག་ལེན་ལྟར་ཚོམ་བུ་སོ་བདུན་མ་རེ་ཆགས་མེད་དང་།",
    "བདག་གི་རྒྱུད་སྨིན་ཅིང་གྲོལ་བར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "དེ་རྣམས་ཐུན་བསྒོམ་རེས་བཞིན་འགོ་འཛིན་གྱི་ཚུལ་དུ་ཐོག་མར་གཏོང་བ་སྟེ།",
    "སྡོམ་པ་རལ་བས་ངན་སོང་ལས་འགྲོ་ས་མེད་པ་དང་།",
    "འབྲས་བུ་བདེ་འགྲོ་སྤྱི་དང་ཁྱད་པར་དལ་འབྱོར་རྙེད་དཀའ་བར་བསམ་མོ།་",
    "རྒྱ་མཚོར་ཆེར་གཡེངས་གཉའ་ཤིང་གི།",
    "ཐ་ན་ལྕི་བའི་གོང་བུ་རེ་བཏེགས་པའི་འོག་ཏུ་སྲོག་ཆགས་ཅི་འདྲ་འདུག་ལྟོས་དང་།",
    "དེ་ལ་དཔག་ན་མི་ལུས་ཙམ་པོ་བ་ཞིག་ཀྱང་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོའི་ལུས་དང་མཉམ་འདུག་རིགས་མཐུན་བདེ་འགྲོའི་ལུས་རྟེན་ཙམ་ལ་བསམ་ན་དཔེར་ན་ཚོང་འདུས་ཆེན་པོར་རྒྱ་དཀར་ནག་མོན་ལྷོ་བལ།",
    "ཕྱི་མ་ཕན་ངན་སོང་དུ་སྐྱུར་བའི་རང་སྡུག་རང་གིས་སྒྲུབ་པའི་སྤྱོད་ངན་རྣམས་ལིང་གིས་བོར་བ་དཔེར་ན་དུག་སྦྲུལ་གྱི་གཟེབ་རྙེད་པ་དང་།",
    "དུག་གིས་སྦགས་པའི་ཟས་རྙེད་པ་ན།",
    "བདག་གིས་དགེ་གོམས་མ་བྱས་ན།",
    "ད་རེས་ཕུན་ཚོགས་རྐྱེན་ཀུན་འབྱོར་སྐབས་འདིར།",
    "ཅེས་གསུངས་པས་ཅང་ཤེས་ཀྱི་རྟ་མཆོག་ཡོད་དུས་ཤུལ་རིང་གི་ལམ་ཅི་བགྲོད་དང་།",
    "དཔའ་བོའི་དཔུང་ཚོགས་ཡོད་དུས་དགྲ་ཅི་འདུལ་དང་།",
    "དེ་ལྟར་རྙེད་དཀའ་བའི་དལ་འབྱོར་དེ་ཐོབ་ནས་ཡུན་རིང་དུ་གནས་པ་ཞིག་ཡིན་ན་རང་རེའི་འདོད་ཐོག་དོན་འགྲུབ་པ་ལགས་ཀྱང་དེ་འདྲ་ནི་མ་ཡིན།",
    "ཁ་ཅིག་ནི་ཐག་རིང་དུ་གྱེས་སོང་།",
    "དེ་བས་ཀུན་ཀྱང་མཉམ་པོར་འཛོམས་རིང་དུ་མི་རྟག་པ་ཡིད་ལ་བཞག་ནས་གཅིག་གིས་གཅིག་ལ་མི་འཐབ།",
    "རང་གི་ཚེ་སྟོད་ལ་ཁང་པ་གཅིག་ཏུ་འདུས་པའི་ཕ་མ་དང་།",
    "རང་གིས་ཕར་འཐབ་ཀྱང་ད་ལྟ་དགྲ་ཡི་ཚོགས་དེ་དག་གང་དུ་འདུག་དེ་བཞིན་དེང་དུས་ཐད་དུ་ལངས་པའི་དགྲ་འདི་དག་ཀྱང་མྱུར་དུ་འཆི་བ་ལས་འོས་མེད།",
    "རྒྱ་བོད་ཀྱི་ཚོང་འདུས་ཆེ་སར་ཉོ་ཚོང་གི་ཕྱིར་འཛོམ་པའམ།",
    "རྩེད་མོ་དང་སྟོན་མོའི་ཕྱིར་འདུས་པའི་སྐྱེ་བོ་བརྒྱ་སྟོང་མང་པོ་དེ་དག་ཀྱང་མྱུར་དུ་སོ་སོར་གྱེས།",
    "འཁོར་ལོ་ནོར་བུ་བཙུན་མོ་སོགས།",
    "ཆུ་ཡི་ལྦུ་བ་ལས་ཀྱང་ཉམས་ཆུང་བའི་བདག་གི་ལུས་འདི་རྟག་ཏུ་རེ་བ་མཚང་རེ་ཆེ།",
    "རང་རེའི་ལུས་ཤ་ཁྲག་གི་གོང་བུ་ཆུ་བུར་ལྟ་བུ་ལ་ས་ཞིང་གནས་ཁང་དངོས་རྫས་ཡོ་བྱད།",
    "བག་མེད་པར་བུད་མེད་ལ་འཁྲིག་པ་སྤྱོད་པའོ།",
    "འཆི་བདག་ཁོ་དགོང་ཀའི་གྲིབ་སོ་ལས་ཀྱང་མགྱོགས་པར་འོང་བས་ཞེ་རེ་འཇིགས་ཏེ།",
    "ཚེ་འདིའི་སྣང་བ་མདང་གི་རྨི་ལམ་འདྲ།",
    "དེའི་ཚེ་ཕན་དུ་རེ་བ་གང་གིས་ཀྱང་ཕན་མི་ནུས་ཏེ།",
    "ཕ་མ་ཁྱོད་ཀྱི་སྐྱབས་མ་ཡིན།",
    "དེ་དག་གིས་ནི་ཁྱོད་བོར་ནས།",
    "ཆུང་མ་ལྷ་ཡི་བུ་མོ་ལྔ་བརྒྱ།",
    "དེ་དག་གིས་སྲོག་བཟུང་བའམ།",
    "བརྟེན་པའི་གནས་ཁང་གིས་ཀྱང་མི་ཕན་ཏེ།",
    "དེ་ལས་ཀྱང་རང་གི་ལུས་འདི་ལ་ད་ལྟ་གཅེས་པར་བཟུང་སྟེ།",
    "བྱ་ཁྱི་དང་གཅན་སྤྱང་གི་ཁ་ཟས་བྱེད་པའམ།",
    "དེ་ལྟར་འཇིག་རྟེན་འདིར་འཆི་བ་ལ་སྟོངས་སུ་གྱུར་པ་ནི་ཅི་ཡང་མེད་མོད།",
    "དགེ་སྡིག་གི་འབྲས་བུ་ནི་ངེས་པར་རྗེས་སུ་འབྲང་བའི་ཚུལ།",
    "ཁྱོད་ཀྱིས་བྱ་བ་ཟིན་ནམ་ཞེས།",
    "ལང་ཚོ་ལྡན་པའི་ལུས་ཀྱང་མྱུར་དུ་འཇིག།",
    "ཞེས་གསུངས་པ་ལྟར་ལོང་མེད་མི་རྟག་ལྕག་གིས་རང་རྒྱུད་བསྐུལ་ཏེ།",
    "སང་བྱེད་དང་གནངས་བྱེད་ཀྱིས་ཕྱི་བཤོལ་དུ་མ་སོང་བར་སྡར་མའི་པང་དུ་སྦྲུལ་ཞུགས་པའམ།",
    "ཞིང་རྨོས་པ་རྣམས་ཀྱི་ནང་ནས་སྟོན་གྱི་ལོ་ཐོག་རྙེད་པ་ཉིད་མཆོགརྗེས་ཐམས་ཅད་ཀྱི་ནང་ནས་ཁྱུ་མཆོག་གི་རྗེས་མཆོག་འདུ་ཤེས་ཐམས་ཅད་ཀྱི་ནང་ནས་མི་རྟག་པ་དང་འཆི་བའི་འདུ་ཤེས་མཆོག་གོ།",
    "དེ་ལྟར་འཆི་བ་ཡོད་པ་བདེན་མོད།",
    "ནས་དགེ་སྡིག་གི་འབྲས་བུ་བསླུ་མེད་དུ་མྱོང་བའི་ཚུལ།",
    "དེ་ཡང་ཚེ་འདིར་བདེ་སྡུག་གི་རྣམ་པ་ཅི་བྱུང་ཡང་སྐྱེ་བ་སྔ་མའི་དགེ་སྡིག་གིས་བྱས་པ་ཡིན་ལ།",
    "ཕྱི་མ་ཕན་ཆད་དུ་བདེ་སྡུག་ཅི་འགྱུར་ཚེ་འདིའི་དགེ་སྡིག་སྤང་བླང་གིས་ཤེས་པ་ཡིན་ཏེ།",
    "༡ དགེ་སྡིག་གི་དབྱེ་བ།",
    "གཞན་ནོར་རྐུ་འཕྲོག་གིས་མ་བྱིན་པར་ལེན་པ་དང་།",
    "གཞན་གྱི་རྣ་བར་མི་སྙན་ཅིང་ཞེར་ཕོག་པའི་ཚིག་རྩུབ་མོར་སྨྲ་བ་དང་།",
    "གླུ་བྲོས་མཚོན་ཆགས་སྡང་བསྐྱེད་པའི་བྲེ་མོའི་གཏམ་སྣ་ཚོགས་སྨྲ་བ་ནི་ངག་འཁྱལ་བ་དང་།",
    "ཐོས་པ་ལ་སོགས་པ་ཕ་རོལ་ལ་ཁྲོ་བཞིན་དུ་བདག་གིར་གྱུར་ན་སྙམ་པ་དེའི་ཕྱོགས་མཐུན།",
    "མགོ་རྣམས་རེ་རེ་དག་ལ་ཡང་།",
    "དགེ་སློང་གི་ཕྱག་སྒྲུབ་པ་པོའི་ཟས།",
    "མེ་སྟག་ཆུང་ངུ་དག་གིས་ཀྱང་།",
    "ཁོག་པར་སོང་བའི་དུག་བཞིན་ནོ།",
    "མངོན་མཐོའི་བསམ་པས་འགྱུར་སྟོབས་ཆེ་འབྲིང་ཆུང་གསུམ་དུ་འགྱུར་བ་སོགས་ལྕི་ཡང་གི་རྣམ་བཞག་འདི་དག་ཞིབ་ཏུ་བརྩིས་ན་རྒྱ་ཆེའོ།",
