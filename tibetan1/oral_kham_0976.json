    "བརྒྱད་གཉིས་ལོན་པའི་རིག་མ་བདེ་བ་ཆེན་པོ་སྐྱེས་པ་བརྒྱད་པོ་ཉིད་དོ་ཤལ་དང་རྐང་གདུབ་ཀྱི་རྒྱན་གྱིས་བརྒྱན་ནས་དཀྱིལ་འཁོར་དུ་རང་དང་ལྷན་ཅིག་འདུག་པའི་ཆོ་གས་རབ་ཏུ་བཞུགས་ཏེ།",
    "གཞན་ཡང་རང་བྱུང་ལྷན་ཅིག་སྐྱེས་པའི་སྣོད་རོ་གཅིག་པར་ཆང་བདུད་རྩི་བཟང་བོས་བཀང་སྟེ།",
    "སྤྱིར་ཡང་རང་དང་གཞན་གྱིས་གྲུབ་པའི་མཐའ་རྒྱ་མཚོའི་ཕ་རོལ་ཏུ་སོན་པར་འགྱུར་རོ།",
    "ཏུ་མཁས་པ་གཅིག་ལྷ་རྟེན་ལ་ཕྱག་མི་བྱེད་པ་མི་སྲིད་པས་ཁྱེད་རང་རྣམས་ཕྲག་དོག་བྱེད་པ་ཡིན་ཏེ་འོང་ཟེར་ནས་མ་ཉན་པ་ལ་ཡང་ཡང་དུ་བསྙད་པས་རྒྱལ་བོ་ཡང་ཐེ་ཚོམ་དུ་གྱུར་ཏེ།",
    "མཆོད་གནས་རྣམས་སྤྱན་དྲངས་ནས་ཐམས་ཅད་ལྷ་རྟེན་ལ་ཕྱག་བྱེད་དགོས་ཟེར་བས་གཞན་རྣམས་ཀྱི་ཕྱག་བྱས་པས་སློབ་དཔོན་བརྒྱད་སྟོང་བའི་པོ་ཏི་ལ་ཕྱག་བྱེད་ཀྱིན་འདུག་ནས།",
    "ཕྱི་རོལ་ཏུ་འདུག་གསུངས་པས།",
    "འཇུག་གུ་སུག་བྱས་པའི་ཤུལ་ན་ཚུར་དབུགས་ངན་སྭ་སྭ་དྲི་ཆེན་འབུར་འབུར་བྱུང་བས་རུལ་ནས་འདུག་ཟེར་ནས་ལོག་པ་དང་།",
    "ཇོ་བོའི་རྡོ་རྗེ་ཡིན་ཟེར་བ་ཞིག་ཀྱང་རུ་མཚམས་ན་སྔགས་པ་གཡུང་སྟོན་བྱ་བ་ཞིག་ལ་འདུག་པས།",
    "དེ་འང་བླ་ཆེན་དང་བོ་ནས་བརྩོན་འགྲུས་དང་དཔྱད་པ་ཆེར་ཡོད་པས་ཨ་ཙ་ར་བྱུང་བ་ཀུན་ལ་ཟས་བྱིན་ཅིང་འཕྲལ་སྐད་བསླབས་པས་ཕར་གཤེགས་ཙ་ན་འཕྲལ་སྐད་ལོ་ཙཱ་བཞུགས་མི་དགོས་པ་ཞིག་མཁྱེན་སྐད།",
    "དེ་ནས་ཡུལ་དུ་བྱོན་དགོངས་ཙ་ན་ཤར་ཕྱོགས་ན་མཁས་པ་ནི་སྙན་པ་དང་གྲགས་པ་ཆེ་བས་ཕྱག་མཆོད་བྱ་བའི་ཕྱིར་བྱོན་པ་དང་།",
    "འདི་གསེར་དུ་འདུག་གམ་མི་འདུག་དྲིས།",
    "གསེར་དུ་འདུག་བྱས་པས་གཟོད་ཡིད་ཆེས་ནས།",
    "དེ་ཙ་ན་དྲོད་མ་ཡལ་བར་འདུག་ཟེར།",
    "བསླབ་བཏུས་ཤིག་ཀློག་བཏར་ལ་བཏང་བས་ཡབ་གཞན་དུ་བྱོན་ནས་ལོག་པའི་དུས་སུ་ཁོང་བྱིས་པའི་གསེབ་ན་འདུག་པ་ལ།",
    "དངོས་ལ་མི་གནང་བར་གདའ་བྱས་པས།",
    "ཇི་ལྟར་འདུག་གསུངས།",
    "གོས་ཀྱང་འཛག་མར་རྐྱང་གཅིག་ལས་མེད་པར་འཁྱགས་ཙ་ན་ཕྱུགས་མའི་སྐྱིབས་འཇོ་ཡིན་འོངས།",
    "སྔར་ལོ་བདུན་ཏེ་བཅུ་བདུན་བཞུགས་ཤིང་མི་གཞན་ལ་ཇི་འདྲ་ཡོད་དྲིས་ནས་ཁོང་ལ་འདི་འདྲའི་གདམས་ངག་གདའ་བྱས་ཙ་ན།",
    "བྱོན་ནས་བཞུགས་ཙ་ན།",
    "དེའང་ཁོང་གཉིས་འཆི་ཙ་ན་དུས་གཅིག་ཏུ་འཆི་བའི་དུས་མཛད་པས་དགྱེར་སྒོམ་འགྲོ་ཙ་ན་ངའི་རོ་འདི་རི་མཐོན་པོ་ཞིག་ལ་སྐྱོལ་ཅིག་གསུངས།",
    "ཁོང་མང་མཁར་གྱི་རི་ལ་སྒོམ་ཞིང་ཡོད་ཙ་ན།",
    "ལོ་ལ་སོགས་པ་མཁས་པ་དང་གྲུབ་པ་ཐོབ་པ་མང་དུ་བཞུགས་པ་གདའོ།",
    "དེ་ནས་ཡུལ་དུ་བཞུད་དགོངས་ཙ་ན།",
    "སྒོམ་མི་འདུག་སྤྲང་བོ་ཐེའུ་འདིས་བར་ཆད་གཅིག་ཀྱང་བྱེད་དུ་མ་འདོད་གསུངས།",
    "ཁོང་མི་ཞུ་བར་འགྲོ་བ་འདུག་གདམས་ངག་ནི་མ་ཚར།",
    "ཨ་ར་པ་ཙ་ན་འདི་སྒྲུབས་གསུངས་ནས་བསྒྲུབས་པས་ཟླ་བ་དྲུག་ནས་གྲུབ་སྟེ།",
    "ཁྲེ་ཚུར་ཁྲེ་འདུག་སྟེ་འདི་ཅི་ལགས་བྱས་པས་གསེར་རམ་བྱ་བ་ནོར་ཆེན་པོ་ལགས་སོ་ཟེར་ནས་གང་དགར་བཞག་འདུག་ཟེར།",
    "ཁོང་གྲོངས་ཙ་ན་ཐམས་ཅད་ཀྱིས་མཐོང་བར་ཚེས་བཅོ་ལྔའི་འོད་ལྟ་བུ་ཞིག་འདག་སྟེ་ཅི་ཡིན་བལྟས་པས།",
    "ཅུང་ཟད་བསྙེལ་ནས་ཉི་མ་གཅིག་ལ་སྙེལ་སོས་པ་སྙམ་བྱེད་ཙ་ན་མནལ་སད་པས་ནང་བར་རྨི་ལམ་དྲིས་པ་ན་འདི་ལྟར་བྱུང་ཞུས་པས།",
    "བཞུད་དགོངས་ཏེ་ཁྲེས་པོ་ཚུར་ཆོད་གྲགས་ཡོད་ཙ་ན།",
    "མ་ཤེས་ན་དགའ་བ་ཚོས་ཤེས་འདུག་གསུངས་ནས།",
    "ལྷགས་པས་ཤོག་བུ་ཁྱེར་བ་བླ་ཆེན་གྱི་གམ་དུ་བྱུང་ནས་འདི་ན་གདའ་ཞུས་པས།",
    "འོ་ན་སྤྱོད་ལམ་གྱི་ལུགས་འདི་དང་བཅས་པ་དང་རང་ནོར་བ་ཡིན་སྙམ་ནས་ལོག་པ་དང་།",
    "རང་ལ་མ་བྱུང་བའི་གདམས་ངག་འདུག་ནའང་མི་དགའ་སྙམ་ནས་ཚགས་མ་བྱས།",
    "བླ་ཆེན་དང་གང་དུ་མཇལ་བྱས་པས་བླ་ཆེན་གྱིས་མཚན་ཁར་བཞུགས་ཙ་ན་ཁྲིད་ལོ་གསུམ་བསྐྱངས་ཟེར།",
    "སྐུའི་བཀོད་པ་ཡིན་པར་འདུག་གོ།",
    "ད་དེ་ཙམ་འདོད་པ་མི་འདུག་ནས་བསྟེན་གསུང་།",
    "དེ་རྩ་བ་མཚལ་གྱིས་བྲིས་པ་ཞག་མར་འདུག་པ་དྲན།",
    "སྤྱིར་ངས་སྐྱེ་བདུན་ཙམ་དྲན་པ་རྨིས་གཉིད་སད་པ་དང་སྟོན་པ་སྦལ་སྟོན་གམ་ན་འདུག་པ་ལ་བཟླས་ཏེ་དཔེ་གཡེངས་པས་འགྲེལ་བ་སྟེ།",
    "འགའ་ཞིག་ལངས་ནས་དེ་ཉིད་ན་འདུག་འོག་ན་གཡང་ས་ཆེར་ཡོད་པའི་ལམ་ཡངས་པ་ཞིག་འདུག་པ་ལ།",
    "ཕྱི་ལ་ངོ་ཤེས་པ་དགའ་སྟོན་དང་གཞན་ལྔ་དྲུག་ཙམ་བསླེབས་འདུག་དེར་ཉག་དེའི་རྒྱབ་ནས་ཕྱོགས་དཀར་ལ་ཟླུམ་པ་ཡོད་ནས་སྨྲས་པ་དང་མནལ་སངས་ཏེ།",
    "ཞུས་བྱས་ལྟ་བུའི་བཟོད་པ་ཐོབ་པ་ལྔ་དྲུག་ཙམ་འོང་བར་འདུག་གསུངས།",
    "མདུན་ནརྡོ་དཀར་འཇམ་ཞིག་འདུག་པའི་དྲུང་ནའཁོང་ནས་འདིའི་སྟེང་དུ་ཞབས་བཞག་ན་མཁའ་སྤྱོད་དུ་འགྲོ་ཟེར་ཡང་ཞབས་མ་བཞག་པ་རྨི་གསུངས།",
    "གཡག་ཁྱུ་དེ་ཀ་ནཕར་འགྲོ་ཡིན་འདུག་ང་ཅིས་ཀྱང་དེར་སྐྱེས་ཟེར་དེའང་དུད་འགྲོའི་གནས་སྦྱོང་ཁོ་ན་བྱུང་ཟེར་མིང་དེ་ནས་ཀྱང་གཙོས་སུ་སྐྱེས་པ་མང་གསུངས།",
