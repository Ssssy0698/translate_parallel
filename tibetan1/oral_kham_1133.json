    "ཀུན་མཁྱེན་གུ་ཎས་ཕྱོགས་རིས་མེད་ཀྱང་རང་རྐང་བཟུང་ན་འཚེངས་ཞེས་གསུངས་དེ་བཞིན་དུ་འཇམ་དབྱངས་ས་པཎ་གྱིས།",
    "ཐེ་ཚོམ་དགོས་པ་མི་འདུག་ཅིང་།",
    "རྒྱལ་ཕྲན་གྱི་བློན་པོ་བགྱིད་པའི་རབ་ལ་ཞེས་འཁོད་འདུག་མི་རིགས་དངསྐྲུན་ཁང་།",
    "ཚོང་ལས་མི་དར་ཞིང་ཇག་རྒྱུགས་ལ་སྤྲོ་བ་བཅས་ཕན་ཚུན་འཕྲོག་བཅོམ་གྱིས་དུས་གདའ།",
    "ཕྱུགས་ལ་གཡང་ཆགས་ས་ཞིག་ནས་གནས་སྡོད་བྱེད་དགོས་ཞེས་པའི་ས་ཆ་དེ་འདི་ཡིན་པར་འདུག་དེ་ནས་ཁྱིམ་ཚང་བདུན་པོ་འདི་ས་ཆ་དེ་ནས་ས་ཁ་དྲོ།",
    "ཆུ་ཡོས་ལོ་ལ་ནུར་མའི་དཔོན་བློན་རྣམས་ཀྱིས་འཚམས་ཞུར་ཕུལ་ཐོག་དེང་ཕྱིན་ཁོ་རང་རྣམས་ཀྱིས་མགོ་བསྐྱར་འདོགས་བྱས་པ་ལགས་པས།",
    "ཨ་འདུས་ནི་མགོ་ལོག་ཨ་འབུམ་གྱིས་གཉན་མཁར་བ་གསུམ་ལ་དམག་འཁྲུག་རྒྱག་དུས་མགོ་བཏགས་ཤིང་།",
    "༡སྒེར་གཅོད་རང་བཞིན་དང་རང་ཚུགས་རང་བཞིན་ལྡན་པ།",
    "གནའ་མི་ཚོས་བརྩམས་གནང་མཛད་པའི་འདོགས་ར་དག་ཕྱི་རབས་པ་རྣམས་ཀྱིས་ཐོན་སྐྱེད་ངལ་རྩོལ་ནང་འགྲོ་ཞོར་འདུག་ཞོར་དུ་ངག་ནས་གྱེར་བ་ཞིག་དང་།",
    "དགུང་ཕྱི་དྲོའི་གྲིབ་ཆེན་ཁུག་དུས།",
    "རྔ་མ་གཡུག་དུས་ལྕགས་ཚན་འདྲ།",
    "རྨ་སྟོད་རྩེ་ལྷ་བཅུ་གསུམ་གདའ།",
    "རྨ་སྨད་མཐོན་པོ་དགུ་སྒྲིག་གདའ།",
    "རྨ་ཕུག་སེང་ཆེན་ཁོག་པ་གདའ།",
    "རྨ་ཉིན་བྲག་དཀར་དགུ་སྒྲིལ་གདའ།",
    "རྨ་ཀ་ལིའི་ལྷ་ཐང་གོང་མ་གདའ།",
    "རང་རང་དགྱེས་པའི་གདན་ཁྲིར་བཞུགས་སུ་གསོལ།",
    "གྱན་ཐང་ལ་བདེ་གསང་འཇིགས་གསུམ་དང་ཀུན་རིག་དུས་འཁོར་སོགས་ཡོད།",
    "བསྙེན་མཚམས་ལ་འདུག་ཅིང་།",
    "ཡང་ཞལ་ཤུལ་སྐུ་འཕྲེང་གསུམ་པའི་གསུང་རྩོམ་ནང་དུ་དཔལ་འཁོར་ལོ་སྡོམ་པའི་གནས་ཤེས་འཁོད་འདུག་ཡོངས་གྲགས་སུ་གནས་དེར་ཐོག་མར་སྒོམ་སྒྲུབ་མཛད་མཁན་ནི་རི་ཁྲོད་པ་ཁྲི་དཔོན་རྒྱ་མཚོ་དང་།",
    "ཨ་ལགས་དེས་མ་ཉན་ཅིང་ང་དཀོར་ཟན་འདི་འདྲར་གྱུར་འདུགསྐྱེས་པ་རྗེས་མར་ཁྱེད་ཚང་ལྟ་བུའི་རི་ཁྲོད་པ་ཞིག་ཏུ་འགྱུར་བར་ཤོག་ཅེས་ཐུགས་སྨོན་མཛད།",
    "མེ་ཏོག་ཐོགས་ཏེ་སྒོ་ཕྱོགས་འདུག།",
    "ལངས་སམ་འདུག་གམ་འགྲོ་ཡང་རུང་།",
    "འདིར་ཡང་རྡོ་རྗེ་སེམས་པའི་གནས་འདུགནས་ཐམས་ཅད་ཟོས་ཏེ་ཀུན་བྱས་ཀྱང་།",
    "སློབ་དཔོན་ནུབ་དང་ལྷོར་འདུག་ནས།",
    "མེར་འདུག་གཡས་ཕྱོགས་སྐོར་བ་ཡིས།",
    "དེ་ཡང་དཀྱིལ་དཀྲུངས་བཅས་ཏེ་འདུག་ལ་ཞེས་པ་ལསོགས་པའོ།",
    "རྒྱལ་པོ་ང་ལས་ནུ་འདའ་ཁར་ཡང་འཇིག་རྟེན་འདིར་ངོམས་པ་མེད་པ་འདི་ལས་བསླུ་ཚབས་ཆེ་བ་མི་འདུག་ཅེས་ཞལ་ཆེམས་བཞག་ཚུལ།",
    "འདོད་པ་ཅན་གྱིས་མ་ཚོར་བར་གདའོ།",
    "གནས་མལ་ཡང་འདུག་ས་འགྲིགས་ཙམ།",
    "སྐྱེ་བ་ཕྱི་མ་རྣམས་སུ་ཡང་རང་གཅིག་པུར་འགྲོ།",
    "རྨ་འབྲས་ཚ་བ་ཁོ་རང་སྡུག་བསྔལ་གྱི་རྟེན་ཡིན་པས་ཁྱབ་པ་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་ལོ།",
    "འོ་སྐོལ་ལ་གླང་ཐང་ངོ་ནག་པ་ཟེར་གྱིན་གདའ་ཞུས་པས།",
    "ང་རང་བཞིན་དང་ཚུགས་ཐུབ་ཏུ་གྲུབ་པ་འཛིན་པའི་འཇིག་ལྟ་དང་།",
    "ཅེས་པའང་རང་རྒྱུད་ལ་རྒྱུས་དགོས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེའི་ཚེ་གནོད་སྦྱིན་བོང་བུ་འཁོར་དེ་ཉིད་དུ་འདུས་ཤིང་འདུག་པར་གྱུར་ཏོ།",
    "དེ་ནས་རྨོན་པ་སྟོང་པོ་དེ་དག་གཉའ་ཤིང་དང་རུ་ཐག་བཅད་ནས་བཅོམ་ལྡན་འདས་གང་ན་བདེ་ལོགས་སུ་དོང་སྟེ་ལྷགས་ནས་བཅོམ་ལྡན་འདས་ཡོངས་སུ་བསྐོར་ཏེ་འདུག་གོ།",
    "ཡང་དག་པར་མགུ་བར་འགྱུར་བའི་གཏམ་རྣམ་པ་སྣ་ཚོགས་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལས་བྲམ་ཟེ་འདས་ལ་བྲམ་ཟེ་ཤིང་སཱ་ལ་ཆེན་པོ་ལྟ་བུ་ཨོ་ཏ་ལའི་བུས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "གལ་ཏེ་དགེ་སྦྱོང་གོ་ཏ་མ་ཀུན་དགའ་བར་ཞུགས་ན་ཀུན་དགའ་ར་བ་དང་ཆུམ་རུང་བར་འགྱུར་རོ་སྙམ་དུ་བསམས་ནས་སྒོ་བཅད་དེ་དཔྱང་ཐག་དང་ཆུ་སྣོད་སྦས་ནས་འདུག་གོ།",
    "ཡང་དག་པར་མགུ་བར་འགྱུར་བའི་གཏམ་རྣམ་པ་སྣ་ཚོགས་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ལྷ་གལ་ཏེ་མི་གདའ་བའི་ཕྱོགས་སུ་ཟླ་བ་གསུམ་བཞུགས།",
    "གང་ཞིག་འོངས་ན་དེ་ནི་ཆད་པར་གསད་དོ་ཞེས་དྲིལ་སྒྲོགས་སུ་བཅུག་ནས་ཟླ་བ་གསུམ་དུ་མི་སྣང་བའི་ཕྱོགས་ཤིག་ན་འདུག་གོ།",
    "དེ་དེ་ཉིད་དུ་འདུག་ནས་དེས་རྟ་ཅང་ཤེས་ལ་ནི་ཆས་ནས་བྲེའུ་ཆུང་དོ།",
    "མི་སྣང་བའི་ཕྱོགས་སུ་འདུག་གོ།",
    "ཤིང་རྟ་ལྔ་བརྒྱ་བ་དེ་རྣམས་ཀྱི་མདུན་དུ་འདུག་ནས་སྨྲས་པ།",
    "དེའི་ཚེ་རྒྱལ་པོ་བྲམ་ཟེ་མེས་སྦྱིན་བཀྲ་ཤིས་འོང་བ་ལ་སྡོང་ཅིང་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་རྒྱལ་པོ་བྲམ་ཟེ་མེས་སྦྱིན་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་དགེ་སློང་རབ་ཏུ་མང་པོས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་དགེ་སློང་དེས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེའི་ཚེ་བཅོམ་ལྡན་འདས་དང་ཧ་ཅང་ཡང་མི་རིང་བ་ཞིག་ན་གནག་རྫི་དགའ་བོ་ཞེས་བྱ་བ་འདུག་པར་གྱུར་པ་ཁར་བལ་བརྟེན་ནས་གནག་སྐྱོང་ཞིང་འདུག་པ་ལས་དེའི་ཁར་བས་སྦལ་པ་ཞིག་བརྫིས་སོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་གནག་རྫི་དགའ་བོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཁ་ཅིག་ནི་གོ་བགོས་ནས་འདུག་གོ།",
    "དེའི་ཚེ་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་འཁོར་དེ་ཉིད་དུ་འདུས་ཤིང་འདུག་པར་གྱུར་ཏོ།",
    "དེང་སྐབས་མདའ་རྩེད་ནི་རོལ་རྩེད་ཀྱི་རྣམ་པ་ཞིག་ཏུ་གྲུབ་འདུག་མདའ་གཞུའི་གྲུབ་ཚུལ་ལ་སྤྱིར་བཏང་དུ་རྩི་མདའ་དང་རྩི་གཞུ།",
    "དེང་དུས་སུ་ཡུལ་ལུང་སོ་སོར་བཟོ་རྩལ་ཁྱད་དུ་འཕགས་པའི་གའུ་གང་མང་ཞིག་འདུག་ལ།",
    "སྙན་ཞེས་མིང་ཐོགས་སྟངས་ཀྱི་ཐད་ནས་བཞེད་ཚུལ་མི་མཐུན་པ་གཉིས་འདུག་སྟེ།",
    "གཞན་ཡང་མཁས་པ་འགས་རག་དུང་དང་གླིང་བུ་སོགས་ལ་དྭགས་སུ་གསར་བཟོ་མཛད་དེ་པཎྜི་ཏ་སྤྱན་འདྲེན་ཞེས་གསུངས་འདུག་པས་དཔྱད་པར་ཞུ།",
    "དེ་ནི་ཞང་ཞུང་མང་ཡུལ་གྱི་ནང་མའི་གླུ་ཞེས་པའི་དོན་ཡིན་པར་གྲགས་འདུག་དེ་ལས་མང་ཡུལ་ཞེས་པ་དེ་ནི་བོད་ལྗོངས་མངའ་རིས་སྤུ་ཧྲེང་ནས་གཙང་ངམ་རིང་དང་།",
    "སྤྱིར་རྒྱ་གར་སོགས་སུ་ཁུངས་ཅི་འདྲ་ཡོད་པ་མ་ཤེས་ལ་བལ་པོའི་སྤྲང་པོ་རྣམས་ལ་ཐོགས་སྲོལ་ཡོད་པར་འདུག་བོད་དུ་འཁར་རྔ་དང་འདི་གཉིས་བོན་པོའི་ལག་ཆ་ཉིད་དུ་འདོད་ཀྱང་།",
    "སྤྲང་པོའི་སྐྱིད་སྡུག་ཁྱེད་རང་མཁྱེན།",
    "སྟེང་ཕྱོགས་ལྷ་ལའང་མི་འདུག།",
    "སྟོབས་དང་ཤུགས་ཀྱིས་ཁེངས་འདུག་གར་སྟབས་ནི་རྐང་པ་སར་རྡེག་པ་དང་སར་འདྲུད་པ།",
    "སྤྲུལ་པ་ཉེར་གཅིག་དུས་གཅིག་འབྱུང་ལུང་བསྟན",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན།",
    "ལོ་དྲུག་དུས་སུ་ཡི་གེ་འབྲི་ཀློག་བསླབས།",
    "སྔར་ངའི་ཁང་པ་ཡོད་སར་ཁྱེད་ཚོས་འདུ་ཁང་བཞེངས་འདུག་ཨ།",
    "དེ་རྗེས་དགོན་ནང་དུ་གུ་རུའི་སྐུ་འདྲ་ཞིག་བཞེངས་པའི་ཐུགས་ཀར་བཞུགས་སུ་གསོལ་ནས་དུས་འགྱུར་གྱི་སྔོན་བར་ཡོད་པར་འདུག་གོ།",
    "འདི་ལྟར་བྱས་ན་ཅི་འདྲ་འདུག་སོགས་སྐད་ཆ་མང་པོ་ཞིག་བཤད།",
    "ཁོ་རང་དོང་དུ་ལྷུང་བར་གྱུར་པས་ཁོང་ལ་དད་ནས་དབུ་བླར་བཀུར་བར་བྱས་སོ།",
    "གུ་རུ་སྣང་སྲིད་ཟིལ་གནོན་གྱི་སྐུ་ཞིག་བཞེངས་དགོས་པར་འདུག་གསུངས།",
    "ཕུད་ཀོང་རང་ཤུགས་ཀྱིས་ཡར་འཕར་ཞིང་སར་བརྡབ་པས།",
    "ཁོ་རང་ཇི་ལྟར་འཆི་མི་ཤེས་པར་འདུག།",
    "དེ་རིང་ནི་གཞི་བདག་ཐམས་ཅད་ཡུལ་གཞན་དུ་འགྲོ་བར་འདུག།",
    "ཁྱད་པར་དགུང་གྲངས་གསུམ་ཙམ་གྱི་སྐབས་ཉིན་ཞིག་ཕྱི་རོལ་ནས་གར་བྱུང་མེད་པར་མཆོད་མེ་སྐོང་བུ་ཞིག་བསྣམས་ནས་ཁྱིམ་དུ་ཕ་མ་སོགས་ལ་སྤྲད་པས་གང་ནས་ཁྱེར་ཡོང་དྲིས་པར་ད་དུང་མང་པོ་འདུག་ཅེས་སླར་ཡང་གཉིས་བསྣམས་ཕེབས་པས།",
    "ངོ་མཚར་རྨད་བྱུང་རང་སྣང་དག་པའི་ཞིང་",
    "དེའི་འབྲས་བུར་གནས་པ་བརྒྱད་ཀྱི་ཉན་ཐོས་དང་རང་རྒྱལ་དགྲ་བཅོམ་པའི་དགེ་སློང་རྣམས་ངུར་སྨྲིག་གདིང་བའི་གདན་ལ་བཞུགས་པ་དང་།",
    "གཡོན་དུ་འབངས་ལོ་ཆེན་བེ་རོ་ཙ་ན་གངས་ཅན་གྱི་མིག་གཅིག་པུ་རབ་ཏུ་བྱུང་བའི་ཆ་ལུགས་ཅན།",
    "ཕྱི་རོལ་དུ་བོད་ཀྱི་གྲུབ་ཆེན་རྗེ་འབངས་ཉི་ཤུ་རྩ་ལྔ་རང་རང་རབ་བྱུང་དང་སྔགས་པའི་ཆ་ལུགས་སོ་སོཪ་མ་འདྲེས་ཐ་དད་དུ་བཞུགས་པའོ།",
    "དེ་སྟེང་རང་སེམས་དང་མ་ལྔ་ལྡན་གྱི",
    "འདུག་གམ་འགྲོ་འཆག་ཟ་ཉལ་ལྡང་",
    "སྤྲུལ་པ་ཉེར་གཅིག་དུས་གཅིག་འབྱུང་ལུང་བསྟན",
    "༡༡༤འདུག་པ་པ་རྣམས་ཀྱི་འབྱུང་པོ་ཐམས་ཅད་པའི་གཏོར་མ།",
    "༡༡༡༤ཨ་ར་པ་ཙ་ནའི་གཏོར་མ།",
    "རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱང་རང་བཞིན་གྱིས་ལྐོག་ཏུ་གྱུར་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཅི་ལྟར་ཡང་ཡོད་པ་མ་ཡིན་ཞིང་དེ་ཙམ་གྱི་རྗེས་སུ་འབྲེལ་པར་མ་གྲུབ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་དང་འགྲོ་དང་ལྡང་དང་འདུག་པ་དང་།",
    "དེ་ཡང་རང་དོན་ཙམ་ལ་བརྩོན་ཞིང་བདེན་པ་བསྟན་པ་ཉིད་ཀྱི་དོན་བྱེད་ལ།",
    "འགྲོ་བ་འདི་ཡང་རང་བཞིན་མེད།",
    "ལྡང་ངམ་ཡང་ན་འདུག་པ་འམ།",
    "སེམས་དང་རང་རིག་པ་འགོག།",
    "གཞི་དང་རང་བཞིན་རྒྱུ་ཡིན་ཏེ།",
    "ཉལ་ལམ་ཡང་ན་འདུག་པ་འམ།",
    "སེམས་དེ་ཡང་རང་བཞིན་མེད་པར་ཤེས་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "ཟ་བ་དང་འདུག་པ་དག་བག་མེད་པར་མི་བྱའོ།",
    "ཁྲུས་དང་རྟེན་ལ་ཕྱག་དུས་དང་སྐབས་སུ་བྱའོ།",
    "མེད་ན་ཡང་རང་ཡི་དམ་གྱི་ལྷ་གང་ཡིན་པ་དེར་བསྒོམས་ལ།",
