    "འདོད་ན་ཤེས་བྱ་མིན་པར་དང་།",
    "བསྒྲུབ་པར་བྱ་བ་ལྡོག་པས་སྒྲུབ་པར་བྱེད་པ་མེད་པས་བསྒྲུབ་པར་བྱ་བ་མེད་པ་ལ་ཁྱབ་པར་འགྱུར་རོ་ཞེས་དང་།",
    "དེ་ནི་ཡོད་པར་དགོས་འགྱུར་ཏེ།",
    "དེ་བས་ན་རྗེས་སུ་འགྲོ་བ་མེད་པར་ཡང་ལྡོག་པ་ཡོད་པར་ངེས་པ་ཡིན་ནོ།",
    "ལྡོག་པ་མེད་པར་ངེས་པ་ཡང་རྗེས་སུ་འགྲོ་བ་ཡོད་པར་ངེས་པ་ཡིན་ནོ་ཞེས་སོ།",
    "མེད་ན་མི་འབྱུང་ཡིན་པར་བརྗོད།",
    "བར་མ་ནི་ལྡོག་པ་ངེས་པ་ལྡོག་འབྲེལ་ངེས་པ་ཡིན་ཞིང་དེ་ཡིན་ན་རྗེས་འགྲོ་ངེས་པ་ལ་དགོངས་ཀྱི་ལྡོག་པ་གྲུབ་པར་རྗེས་འགྲོ་གྲུབ་པས་ཁྱབ་པ་མིན་ཏེ།",
    "ལྡོག་པར་བྱའི་མཚན་ཉིད་ཀྱི་ལྡོག་པ་རབ་ཏུ་གྲུབ་བོ་ཞེས་དང་།",
    "གཏན་ཚིགས་དེའི་ཕྱིར་ལྡོག་པ་བཀག་པ་ན་མཐུན་པའི་ཕྱོགས་ལ་རྗེས་སུ་འགྲོ་བ་འགུགས་པར་བྱེད་དོ་ཞེས་སོ།",
    "འབྲེལ་བ་མཐུན་དཔེ་ལ་གྲུབ་ཟིན་པ་ལ་ལྡོག་ཁྱབ་བསྟན་པར་བྱ་བ་ཡིན་ཏེ།",
    "མི་མཐུན་པའི་ཕྱོགས་ལ་ངེས་པ་དང་ལྡན་པར་ལྡོག་པ་ཡང་འབྲེལ་པ་ཉིད་ལས་མཐུན་པའི་ཕྱོགས་ལ་ངེས་པ་དེ་ཉིད་ལས་ཡིན་ལ་ཞེས་དང་།",
    "མེ་མེད་ན་དུ་བ་མེད་དོ་ཞེས་ཤུགས་ཀྱིས་ལྡོག་པ་འགྲུབ་པར་ལྟ་ག་ལ་འགྱུར་ཞེས་སོ།",
    "མ་ཐག་ཏུ་བྱུང་བ་མེད་པར་བསྟན་པར་བྱའི།",
    "དེས་དེ་ལྟར་གྲུབ་བཞིན་དུ་སླར་བསྣན་པའི་ཕྱིར་ཡང་སྨོས་པའི་དགོས་པར་འགྱུར་ཏེ།",
    "དེས་བསྣན་ནས་སྨོས་པར་དགོས་པ་སྤང་བའི་ཕྱིར་ཡང་གཏགས་སོ།",
    "གཙོ་བོ་ཉིད་གཙོ་བོ་བྱ་བ་ཡིན་པར་ཤེས་པའི་དོན་གྱི་ཤུགས་དང་།",
    "གཞན་ལྡན་རྣམ་གཅོད་ཀྱིས་ཁྱད་པར་དུམ་བྱས་པའི་ཕྱིར་ཏེ།",
    "སྒྲ་མི་རྟག་སྒྲུབ་ཀྱི་རྟགས་ཡང་དག་བྱས་པའི་གོ་བྱར་བློ་མ་གཟུང་བའི་ཚེ་ན།",
    "བསྒྲབ་པར་བྱ་བ་དང་རིགས་མཐུན་པ་ལ་ཡོད་པ་ཞེས་དང་།",
    "དོན་མཐུན་པ་ནི་དེས་བྱས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ་ཞེས་སོ།",
    "སྒྲ་མི་རྟག་སྒྲབ་པ་ལ་བྱས་པ་བཀོད་པ་ལྟ་བུའི་མཐུན་ཕྱོགས་ནི་རྟགས་ཁྱབ་བྱེད་དུ་ཡོད་པའོ།",
    "བྱས་པས་སྒྲ་རྟག་པར་བསྒྲུབ་པ་ན།",
    "བྱས་པས་མི་རྟག་པར་བསྒྲབ་པ་ན་ནམ་མཁའ་ལྟ་བུ་མེད་པའི་མི་མཐུན་ཕྱོགས་གསུམ་སྟེ།",
    "མི་མཐུན་ཕྱོགས་ཡིན་ན་སྒྲ་མི་རྟག་བསྒྲབ་ལ་ཚུལ་གསུམ་ཚང་བ་དེ་ལ་ཤེས་བྱས་ཁྱབ་བམ་མ་ཁྱབ།",
    "ཤེས་བྱ་དེ་མི་མཐུན་ཕྱོགས་ཡིན་ཞིང་ཤེས་བྱས་ཁྱབ་པས་ཉེས་པ་དང་པོ་ནི་མེད་ལ།",
    "བྱས་པ་སྒྲ་མི་རྟག་བསྒྲབ་ཀྱི་རྟགས་ཀྱི་ཐ་སྙད་དུ་བསྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ཡིན་པས་སོ།",
    "ཤེས་བྱས་ཁྱབ་ཀྱང་རྟགས་འགོད་ཚུལ་ལྟར་དང་།",
    "ཆུ་མིག་པས་ཤེས་བྱའི་རང་ལྡོག་ལ་བརྟེན་པར་མ་ཞུགས་ཤིང་།",
    "དེ་བཞིན་དུ་བྱས་པས་སྒྲ་མི་རྟག་པར་སྒྲུབ་པ་ན་ཤེས་བྱ་དང་གཞལ་བྱ་སོགས་གཞན་པའི་མི་མཐུན་ཕྱོགས་ཡིན་ཏེ།",
    "གཏན་ཚིགས་ཐིགས་པའི་འགྲེལ་པར།",
    "འདི་ལྟར་དེ་དག་ལ་བྱས་པ་ཉིད་མི་འཇུག་སྟེ་ཞེས་སོ།",
    "དཔེར་བུམ་པ་དེ་བྱས་པ་སྒྲ་མི་རྟག་པའི་རྟགས་ཀྱི་ཐ་སྙད་དུ་བསྒྲུབ་པ་ན་མཐུན་ཕྱོགས་ཀྱི་རྫས་ཀྱང་ཡིན།",
    "རྗེས་དཔག་མངོན་སུམ་གྱི་ངོ་བོ་མིན་པར་བསྒྲུབ་པ་ལ་རྟོག་བྲལ་མ་འཁྲུལ་བའི་ངོ་བོ་མིན་པ་རྟགས་སུ་བཀོད་པ་ན།",
    "རང་རིག་མངོན་སུམ་གྱི་ངོ་བོ་ཡིན་པར་བསྒྲུབ་པའི་མཐུན་ཕྱོགས་ཁོ་ན་ཡིན་པའི་ཕྱིར།",
    "རང་རིག་མངོན་སུམ་གྱི་ངོ་བོ་ཡིན་པར་སྒྲུབ་པ་ལ་རྟོག་བྲལ་མ་འཁྲུལ་བ་རྟགས་སུ་བཀོད་པ་དེ་རང་ལྡོག་ལ་བརྟེན་པར་བསྒྲུབ་པའི་བསྒྲུབ་ཚུལ་ཡིན་ཞིང་དེ་སྒྲུབ་ཀྱི་མཐུན་ཕྱོགས་ཁོ་ན་ཡིན་པའི་ཕྱིར་དང་།",
    "གཅིག་ལ་ངེས་པར་གྲུབ་ན་ནི།",
    "གཞན་ལས་ལྡོག་པ་གྲུབ་པར་འགྱུར།",
    "མཐུན་པའི་ཕྱོགས་ཀྱི་སྒྲས་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་གང་ཇི་སྙེད་པ་དེ་ཐམས་ཅད་ནི་མི་མཐུན་པའི་ཕྱོགས་ཡིན་ནོ་ཞེས་དང་།",
    "དེ་ལ་ཡོད་པར་གྲུབ་པ་སྡུད་པའི་ངེས་པར་གཟུང་བས་གཞན་རྣམ་པར་གཅོད་པ་ཡིན་ཏེ་ཞེས་སོ།",
    "དེའི་འགྲེལ་པར།",
    "བྱས་པའམ་རྩོལ་བ་ལས་བྱུང་བས་སྒྲ་རྟག་པར་སྒྲུབ་པ་ན་ཕྱོགས་ཀྱང་མི་མཐུན་པའི་ཕྱོགས་སུ་འགྱུར་རོ་ཞེས་སོ།",
    "རྟགས་ནི་མཐུན་པར་བྱེད་པ་པོ་ཡིན་པས་ཡང་དག་ལ་མཐུན་ཕྱོགས་སུ་འགྱུར་བ་ཡིན་ནོ།",
    "ཁྱབ་པ་མ་གཟུང་ན་གཉིས་ཀ་ལ་ཐེ་ཚོམ་ཟ་བས་མ་ངེས་པར་བྱེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "གལ་ཏེ་ཕུང་པོ་གཞན་ཡོད་ན་ནི་དེའི་ཚེ་བདག་མེད་པ་ནི་གདོན་མི་ཟ་བར་བདག་དང་བཅས་པར་འགྱུར་རོ་ཞེས་བྱའི་ངེས་པར་མི་འགྱུར་ཏེ།",
    "རྣམ་གྲངས་ཀྱིས་གཉིས་ལས་གཅིག་ལ་ངེས་པར་མཐོང་ན་ཐེ་ཚོམ་དུ་འགྱུར་གྱི།",
    "དེ་ལྟ་ན་ཡང་གཞལ་བྱ་དེ་མི་རྟག་པ་མིན་པར་ཎྞཾངེས་ཤིང་ཕྱོགས་གཉིས་ལ་གཞན་པ་མི་སྲིད་པའི་ཕྱིར།",
    "ཚིགས་འགའ་ཡང་མ་ངེས་པར་མི་འགྱུར་རོ་ཞེས་སོ།",
    "ཕྱོགས་གཉིས་རུང་ལ་ཡོད་ཀྱང་ཡོད་པ་ཁོ་ནར་མ་ངེས་པར་བཞག་སྟེ།",
    "བདག་ཉིད་ལ་ཡོད་པར་འགྱུར་། ཞེས་སྤྱིར་ཡོད་པར་ངེས་པ་ཡིན་ཡང་འདི་ཙམ་གྱིས་ནི་འགའ་ཞིག་ལ་རྗེས་སུ་འགྲོ་བའམ།",
