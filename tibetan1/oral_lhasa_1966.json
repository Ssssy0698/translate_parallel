    "སྤྱི་བློ་དེ་ནི་སྤྱི་ནི་འབའ་ཞིག་གཟུང་དོན་དུ་བྱས་པ་ལས་སྐྱེ་བ་མ་ཡིན་ཏེ།",
    "བྱེ་བྲག་པས་གསལ་བ་རྣམས་ལ་སྤྱི་དོན་གཞན་མཐོང་བའི་སྒོ་ནས་ཐ་སྙད་འདོགས་པར་ཁས་བླངས་པས་སོ།",
    "གཉིས་པ་དེའི་སྐྱོན་སྤོང་རིམ་པར་དགག་པ་ནི།",
    "དེ་ལྟ་ན་ཡང་སྔར་དུ་མས་འབྲས་བུ་གཅིག་མི་སྐྱེད་པར་ཁས་བླངས་པ་དང་ནང་འགལ་སྟོན་པ་ནི།",
    "སྔར་ནི་སྤྱི་རྫས་གཞན་མེད་པའི་གསལ་བ་རྣམས་ཀྱིས་འབྲས་བུ་སྤྱི་བློ་གཅིག་མི་སྐྱེད་པར་སྨྲས་པ་ཡིན་ཞིང་།",
    "སྤྱི་རྟག་དངོས་ཁོ་ནས་ཀྱང་སྤྱི་སྐྱེད་པར་ཁས་བླངས་པ་དང་།",
    "གསལ་བ་སོ་སོ་དེ་དག་མེད་པར་ཡང་།",
    "སྤྱི་རྫས་གཞན་གྱིས་ཀྱང་གསལ་བ་ལ་མ་ལྟོས་པར་སྤྱི་བློ་མི་སྐྱེད་དེ།",
    "དཔེར་ན་ཐགས་བཟང་མེད་པར་རས་ཡུག་མི་འཐག་ལ།",
    "དེས་ན་དེ་དག་སོ་སོ་མེད་པར་ཡང་།",
    "དེ་ལྟར་ན་སྔར་གསལ་བ་ལ་མ་ལྟོས་པར་རང་ཉིད་རྐྱང་པས་སྤྱི་བློ་སྐྱེད་མི་ནུས་པ་གསལ་བས་གྲོགས་བྱས་ནས་སྤྱི་བློ་སྐྱེད་ནུས་སུ་སྐྱེད་པའི་ཕྱིར།",
    "དེ་ལྟ་ན་སྤྱི་རྟག་དངོས་ལ་མ་ལྟོས་པར་གསལ་བ་དེ་དག་སྤྱི་རྟག་དངོས་དེ་གཅིག་པུ་ལ་ཕན་ན་ཇི་ལྟར་དེ་ལ་མི་ལྟོས་པར་སྤྱི་བློ་གཅིག་ཉིད་ལ་ཕན་པ་མིན་ཞེས་ཏེ།",
    "འདིར་སྤྱི་རྟག་དངོས་གྲོགས་སུ་ཡོད་པ་ལ་མ་ལྟོས་པར་གསལ་བ་དུ་མས་སྤྱི་རྟག་དངོས་གཅིག་ལ་ཕན་འདོགས་པར་ཁས་བླངས་པ་ནང་འགལ་ཞེས་བྱ་བའི་དོན་ནོ།",
    "འདི་ལྟར་གསལ་བ་དེ་དག་མཚུངས་པར་འཛིན་པའི་བློའི་གཟུང་བྱ་ཡིན་ན་ནི།",
    "དེ་དག་ལ་སྤྱི་རྟག་དངོས་གཅིག་ཀྱང་ཡོད་ན་མཚུངས་སོ་ཞེས་འཛིན་པར་རིགས་པ་ཡིན་གྱི།",
    "མཚུངས་པར་འཛིན་པ་མི་རིགས་སོ།",
    "དེས་ན་གསལ་བ་རྣམས་མཚུངས་པར་འཛིན་པ་ཉིད་ཀྱིས་དེ་དག་ལ་རྗེས་སུ་འགྲོ་བའི་སྤྱི་རྟག་དངོས་ཡོད་པར་གྲུབ་ཅིང་།",
    "དེའི་ཕྱིར་དེ་ཉིད་སྤྱི་བློའི་གཟུང་དོན་དུ་གྲུབ་པས་གསལ་བ་མིན་པར་གྲུབ་སྟེ།",
    "གལ་ཏེ་བུམ་གསལ་རྣམས་འབྲས་བུ་རིགས་གཅིག་བྱེད་པར་མཚུངས་པའི་ཆ་དེ་ཉིད་བུམ་གསལ་རྣམས་ལ་རྗེས་སུ་འགྲོ་བའི་སྤྱི་རྫས་གཞན་ཡིན་ནོ།",
    "བུམ་གསལ་དེ་རྣམས་ལ་རྫས་གཞན་པའི་འབྲས་བུ་རིགས་གཅིག་བྱེད་པར་མཚུངས་པའི་ཆ་བུམ་གསལ་རྣམས་རྗེས་སུ་འགྲོ་བའི་དངོས་པོ་ཡོད་ན་བློ་མ་འཁྲུལ་བ་ལ་སྣང་དགོས་པ་ལ་དེ་འདྲ་མ་མཐོང་བའི་ཕྱིར་དང་།",
    "བུམ་གསལ་རྣམས་འབྲས་བུ་རིགས་གཅིག་བྱེད་པར་མཚུངས་པའི་ཆ་ལ་སོགས་པའི་གཞན་སེལ་བའི་སྤྱི་རྣམས་རྫས་སུ་གྲུབ་པ་སྔར་བཀག་ཟིན་པའི་ཡང་ཕྱིར་རོ།",
    "འདི་དག་རིགས་པ་རྣམ་གྲངས་པར་སྟོན་པའི་ཚིག་གོགཞན་དག་གསལ་བ་རྣམས་ལས་རྫས་གཞན་པའི་སྤྱི་ཡོད་པ་སྔར་རྗེས་འགྲོ་གཞན་ནི་སྣང་བ་མེད།",
    "ཅེས་པར་བཀག་ཟིན་པའི་ཕྱིར་ཞེས་འཆད་པ་ནི་ཤིན་ཏུ་མི་འཐད་དེ།",
    "དངོས་མ་མཐོང་ཕྱིར་ཞེས་པས་བསྟན་པའི་རིགས་པ་ལ་ཁྱད་པར་ཅུང་ཟད་ཀྱང་མེད་པའི་ཕྱིར།",
    "འོ་ན་རིགས་པ་སྔ་མ་དང་འདི་ལ་ཁྱད་པར་མེད་ན་ཟློས་སྐྱོན་མི་འབྱུང་ངམ་ཞེ་ན།",
    "དགག་བྱ་ལ་ཁྱད་པར་ཡོད་པའི་ཕྱིར་རོ།",
    "བུམ་པའི་བརྡ་ལས་དོན་བུམ་པ་ལ་མི་བསླུ་བ་ཡོད་པར་འདོད་དེ།",
    "བུམ་སྒྲ་དེ་རང་ལ་སྣང་བ་ལྟར་གྱི་གཟུང་དོན་མེད་པ་ཅན་གྱི་བུམ་པའི་རྟོག་བློ་སྐྱེད་པར་བྱེད་འང་ཡིན་ལ།",
    "ལྔ་པ་སྒྲ་རྟོག་དེ་མིན་རྣམ་པར་བཅད་པའི་སྒོ་ནས་ཡུལ་ལ་འཇུག་པ་ལ་རྩོད་པ་རྒྱས་པར་སྤང་བ་ལ།",
    "ཤིང་འཛིན་རྟོག་པས་ཤིང་གོ་བ་ལ་དེའི་སྔོན་དུ་ཤིང་མ་ཡིན་རྣམ་པར་བཅད་པ་ཤེས་དགོས།",
    "གཅད་བྱ་ཤིང་མ་ཡིན་མ་ཤེས་པར་དེ་བཅད་པ་མི་ཤེས་པས་ཤིང་མ་ཡིན་ཤེས་དགོས།",
    "ཤིང་མ་ཡིན་ཤེས་པ་ཡང་ཤིང་རྣམ་པར་བཅད་པའི་སྒོ་ནས་ཤེས་དགོས་ཤིང་།",
    "དེས་ན་ཤིང་དང་ཤིང་མིན་གཉིས་གང་རུང་གཅིག་སྔར་འཛིན་པ་མེད་ན་གཉིས་མི་འཛིན་པར་འགྱུར་བ་དེའི་ཕྱིར་ན།",
    "གཞན་སེལ་ལ་བརྡ་འདོགས་པ་མི་སྲིད་པས་སྤྱི་དངོས་པོ་བ་སྣང་ཡུལ་དུ་བྱས་པའི་སྒོ་ནས་སྒྲུབ་པའི་ཚུལ་གྱིས་བརྡ་འདོགས་པ་འཐད་དོ་ཞེས་ཁ་ཅིག་སྨྲའོ།",
    "ཤིང་མིན་རྣམ་པར་གཅོད་དམ་གཅོད་པ་མིན།",
    "གལ་ཏེ་རྣམ་པར་གཅོད་དོ་ཞེ་ན།",
    "གལ་ཏེ་གཞན་ཤིང་མ་ཡིན་བཀག་ནས་ཤིང་མི་སྒྲུབ་པར་མདུན་ན་གནས་པའི་ཤིང་སྤྱི་གཅིག་གཅིག་རབ་ཏུ་བསྟན་ནས་འདི་ཤིང་ཡིན་ཞེས་བརྡ་བྱེད་ལ།",
    "ཕྱིས་ཐ་སྙད་འདོགས་པའི་ཚེ་ན་ཡང་དེ་མིན་བཅད་པ་ལ་མི་ལྟོས་པར་ཤིང་དེ་རྟོགས་པར་འགྱུར་ལ།",
    "དེ་ཡོངས་སྤངས་ནས་འཇུག་པར་ནི།",
    "ཕྱི་རོལ་གྱི་ཡལ་ག་ལོ་འདབ་དང་ལྡན་པ་དང་ངོ་བོ་གཅིག་འདྲར་སྣང་བའི་སྒོ་ནས་བདག་ཉིད་ཀྱིས་ཡལ་ག་ལོ་འདབ་དང་ལྡན་མི་ལྡན་རིགས་སོ་སོར་ཐ་དད་པར་ནི་ཤེས་པར་འགྱུར་བས་དེ་ལྟར་སྣང་བའི་རྟོག་པའི་སྣང་ཡུལ་དེ་སྒྲ་དོན་དུ་བྱས་ནས་ཡལ་ག་ལོ་འདབ་དང་མི་ལྡན་པ་ལས་ཐ་དད་པར་སྣང་བ་ལ་ཤིང་ཞེས་པའི་སྐད་སྦྱོར་ཏེ།",
    "ཤིང་སྒྲ་སྦྱར་བ་དེ་ལས་ཡལ་ག་ལོ་འདབ་དང་ལྡན་པ་དེ་རྟོགས་པར་འགྱུར་བའི་བློ་རྟག་པ་རང་ལ་སྣང་བ་ཕྱི་རོལ་གྱི་ཡལ་ག་ལོ་འདབ་དང་ལྡན་པ་མ་ཡིན་ཀྱང་སྣང་བཏགས་གཅིག་ཏུ་འཁྲུལ་བས་རང་ལ་སྣང་བ་དང་ཕྱི་རོལ་གྱི་དངོས་པོ་གཅིག་ལྟར་རྟོགས་པ་ཡིན་ནོ།",
    "དེ་ལ་ཤློ་ཀ་དང་པོས་ཤིང་བརྡ་མ་བྱས་པའི་སྔ་རོལ་ནས་ཤིང་བརྡ་སྦྱོར་བ་པོའི་མངོན་སུམ་གྱིས་ཡལ་ག་ལོ་འདབ་དང་ལྡན་མི་ལྡན་རིགས་སོ་སོར་རྣམ་པར་འབྱེད་ནུས་ཞེས་བསྟན་ལ།",
    "བློ་ཀ་ཕྱི་མས་བརྡ་སྦྱོར་རྟོག་པའི་ངོ་བོ་དང་འཛིན་སྟངས་ཀྱི་ཁྱད་པར་བསྟན་ཅིང་།",
    "བརྡ་སྦྱོར་རྟོག་པ་དེའི་སྣང་ཡུལ་ཡལ་ག་ལོ་འདབ་དང་མི་ལྡན་པ་ལས་རིགས་ཐ་དད་པར་སྣང་བའི་གཞན་སེལ་ལ་བརྡ་སྦྱོར་ཞེས་བསྟན་ཅིང་།",
    "དེ་ནས་རྐང་པ་གཉིས་ཀྱིས་དེ་ལྟར་བརྡ་སྦྱོར་བའི་སྒྲ་དེ་ལ་བརྟེན་ནས་ཡལ་ག་ལོ་འདབ་དང་ལྡན་པ་རྣམས་ལ་ཤིང་ངོ་སྙམ་པའི་རྟོག་པ་སྐྱེས་པའི་རྟོག་པ་ལ་རང་ལ་སྣང་བ་ཕྱི་རོལ་གྱི་ཤིང་ལྟ་བུར་སྣང་བའི་སྒོ་ནས་ཕྱི་རོལ་གྱི་ཤིང་རྟོགས་པར་འགྱུར་ལ།",
    "བུམ་པ་སོགས་བརྗོད་པའི་སྒྲ་ལ་གཅད་བྱ་ཡོད་པའི་སེལ་བས་འཇུག་པར་རིགས་སུ་ཆུག་ཀྱང་།",
    "ཤེས་བྱ་གཞལ་བྱ་སོགས་བརྗོད་པའི་ཚིག་ལ་རྣམ་པར་གཅད་བྱ་ཤེས་བྱ་མ་ཡིན་པ་སོགས་མེད་པའི་ཕྱིར།",
    "སེལ་འཇུག་ཏུ་མི་འཐད་པས་རྗོད་བྱེད་ཀྱི་སྒྲ་ཀུན་རྣམ་པར་བཅད་པའི་སྒོ་ནས་འཇུག་པ་མི་འཐད་དོ་ཞེ་ན།",
    "ཉན་པ་པོའི་བློ་མི་འདོད་པའི་དོན་འགའ་ལས་རྣམ་པར་བཟློག་ནས་འདོད་པའི་དོན་འགའ་ཞིག་འཇུག་པར་བྱ་བའི་ཕྱིར་དུ་རྗོད་བྱེད་ཀྱི་སྒྲ་ནི་རབ་ཏུ་སྦྱོར་བར་བྱེད་དེ།",
    "འདི་ལྟར་བུམ་པར་ཆུ་འོན་ཅིག་ཅེས་བརྗོད་པའི་ཚིག་དེ་ལ།",
    "བུམ་པ་ལས་གཞན་སྙིམ་པ་ལ་སོགས་པར་ཆུ་ཁྱེར་བ་འོང་བ་དང་།",
    "གཞན་དུ་ན་སྙིམ་པ་སོགས་སུ་ཆུ་ཁྱེར་འོང་བ་གཅད་པར་མི་འདོད་ན།",
    "ཕྱག་དར་སོགས་གང་ཡང་རུང་བ་ཁྱེར་འོང་བ་བཅད་པར་མི་འདོད་ན།",
    "ཅིའང་ཁྱེར་མི་འོང་བ་གཅོད་པར་མི་འདོད་ན་འོན་ཅིག་ཅེས་པའི་ཚིག་སྦྱར་བ་དོན་མེད་པས་སོ།",
    "སྤྱིར་གནས་སྐབས་ལྔ་བྲལ་གྱི་ཚིག་ཐམས་ཅད་མི་འདོད་པའི་དོན་ལ་ཉན་པ་པོའི་བློ་འཇུག་པ་རྣམ་པར་གཅོད་པ་ཡིན་པ་ངེས་ན།",
    "ཉན་པ་པོའི་བློ་མི་འདོད་པའི་དོན་ལ་འཇུག་པ་རྣམ་པར་གཅོད་པ་འགའ་ཞིག་ཡོད་པས་ཤེས་བྱ་མ་ཡིན་པ་སོགས་མེད་ཀྱང་།",
    "ཤེས་བྱ་སོགས་བརྗོད་པའི་ཚིག་རྣམ་པར་གཅོད་པའི་ཡུལ་ཅན་ཡིན་པ་མི་འགལ་ལོ་ཞེས་བྱ་བའོ།",
    "དེ་ཉིད་བརྗོད་པའི་སྒྲ་གཞན་སེལ་མ་ཡིན་པ་རྣམ་པར་བཅད་པའི་སྒོ་ནས་སྦྱོར་རམ་མི་སྦྱོར།",
    "གལ་ཏེ་སྦྱོར་ན་གཞན་སེལ་མ་ཡིན་པ་རྣམ་པར་བཅད་པ་ལ་སྒྲ་སྦྱོར་བ་ལའང་དེ་མིན་བཅད་བྱ་ལ་སྒྲ་སྦྱོར་དགོས་ཤིང་།",
    "དེ་ནས་རྐང་པ་གསུམ་གྱིས་དེ་ཉིད་སློབ་དཔོན་གྱི་དགོངས་པར་བསྟན་པའི་ཕྱིར།",
    "ཞེས་ཤེས་པར་བྱ་བའི་ཕྱིར་དུ།",
    "གཞན་སེལ་ལ་བརྡ་སྦྱོར་བ་ན་བརྡ་དེ་ལས་ཐ་དད་པའི་གཞན་སེལ་མ་ཡིན་པ་རྣམ་པར་བཅད་པ་ལ་སྒྲ་གཅིག་སྦྱོར་དགོས་ཏེ།",
    "དེ་ལས་ཐ་དད་པའི་དེ་མིན་རྣམ་པར་བཅད་པ་ལ་སྒྲ་གཅིག་ཟུར་དུ་སྦྱར་དགོས་ན།",
    "གཞན་སེལ་མ་ཡིན་པ་རྣམ་པར་གཅོད་པའི་སྒྲས་གཞན་སེལ་གོ་བར་བྱེད་ནུས་ཤིང་།",
    "འོན་ཀྱང་རྟོག་པ་ལ་ཤིང་མ་ཡིན་ལས་ལྡོག་པར་སྣང་བ་འདི་ལའང་།",
    "དེའི་ཕྱིར་དེ་ལ་སྒྲ་སྦྱོར་བ་ནའང་དེ་མིན་རྣམ་པར་བཅད་པའི་སྒོ་ནས་སྒྲ་སྦྱོར་གྱི་དེ་འདྲའི་སྒྲ་དོན་དེ་ལ་ནི།",
    "སྤྱི་དོན་གཞན་འགའ་ཡིས་ཁྱད་པར་དུ་བྱས་པའི་སྒོ་ནས་སྒྲུབ་པས་རྟོགས་པར་འགྱུར་བ་འགའ་ཡང་མེད་དོ།",
    "ཤིང་ཞེས་པའི་སྒྲ་རྣམས་ལས་ཤིང་མ་ཡིན་ལས་ལྡོག་པར་སྣང་བ་བློའི་གཞན་སེལ་དེ་དངོས་སུ་རྟོགས་པ་ཉིད་ཀྱིས་གཞན་ཤིང་མ་ཡིན་ལས་ལྡོག་པའམ་ཤིང་མ་ཡིན་པར་བཅད་ཙམ་གྱི་མེད་དགག་དེ་ཤུགས་ལ་རྟོགས་པར་འགྱུར་བ་ཡིན་པས་དེ་དེའི་དངོས་ཀྱི་སྒྲ་དོན་མ་ཡིན་ལ།",
    "དེ་ལྟར་ཤིང་མ་ཡིན་ལས་ལྡོག་པར་སྣང་བ་སོགས་ཀྱི་གཞན་སེལ་ལ་སྒྲ་སྦྱོར་བ་ནི།",
    "དེ་མིན་བཅད་པ་གོ་བར་བྱེད་པའི་སྒྲ་ཐ་དད་གཉིས་གཉིས་སྦྱོར་དགོས་པའང་མ་ཡིན་གྱི་གཞན་སེལ་དེ་དང་དེ་མིན་གཉིས་ཕན་ཚུན་གཅིག་ལ་གཅིག་ཡོད་པ་མ་ཡིན་པར་རྣམ་བཅད་ཡོངས་གཅོད་ཀྱི་སྒོ་ནས་དངོས་སུ་འགལ་བས་གཅིག་དངོས་སུ་བརྗོད་པའི་སྒྲ་དེས་ཅིག་ཤོས་བཅད་པའང་གོ་བར་བྱེད་ནུས་པའི་ཕྱིར།",
    "ཐ་དད་ཁྱད་པར་མཚུངས་པ་ཡི།",
    "རྣམ་པར་སྣང་བ་ཅན་ལ་བརྡ་འགོད་པའི་ཚུལ་དེ་ཉིད་སློབ་དཔོན་གྱི་དགོངས་པ་ཡང་ཡིན་ནོ།",
    "གཞན་ལས་ལྡོག་པ་ཡི་དངོས་པོ་དེའི་ཆ་འགའ་ཞིག་རྟོགས་པར་འགྱུར་རོ།",
    "ཞེས་པ་དང་སྒྲས་ནི་དོན་གཞན་ལས་ལྡོག་པ་ཡིས་ཁྱད་པར་དུ་བྱས་པའི་ཁྱད་པར་དག་གོ་བར་བྱེད་དོ།",
    "དེ་འདྲའི་སྒྲ་གཉིས་བྱེད་དགོས་པར་བསྟན་པའང་མ་ཡིན་ཏེ།",
    "ཤིང་དང་ཤིང་མ་ཡིན་ཕན་ཚུན་ཡོད་པ་མིན་པའི་དངོས་འགལ་ཡིན་པས་གཅིག་ཡོངས་གཅོད་དུ་གོ་ན་ཅིག་ཤོས་རྣམ་པར་བཅད་པ་འདི་གོ་བས་ཁྱབ་པའི་ཕྱིར་རོ།",
    "རྟོག་པ་ལ་ཤིང་མ་ཡིན་ལས་ལྡོག་པར་སྣང་བ་འདི་དོན་དམ་པར་གྲུབ་པ་མིན་ཏེ།",
    "ཤིང་མ་ཡིན་ལས་ལྡོག་པར་སྣང་བ་བདེན་པར་མ་གྲུབ་པ་ལས་གཞན་དུ་གྲུབ་ན།",
    "གཞུང་འདི་དག་དེའི་ལན་དུ་འཆད་པར་བྱེད་དོ།",
    "དེ་ལྟ་ན་རྩོད་པ་གཅིག་བསྐལ་པའི་བར་དུ་བརྒྱུད་ནས་སྤང་དགོས་པར་འགྱུར་ཏེ།",
    "འདི་ལྟར་སྔར་རང་མཚན་སྒྲ་དོན་མ་ཡིན་པར།",
    "དེ་བཞིན་དུ་གསལ་བ་རྣམས་ལ་རྗེས་སུ་འགྲོ་བའི་སྤྱི་དོན་གཞན་ཡོད་པ་ལ་གནོད་བྱེད་དང་མེད་པའི་སྒྲུབ་བྱེད་ཀྱང་རྒྱས་པར་བསྟན་ཅིང་།",
    "དེ་འདྲ་སྒྲ་དོན་ཡིན་པའང་རྒྱས་པར་བཀག་ཟིན་ཏོ།",
    "སྔར་གྱི་དོན་གཞན་སྒྲའི་ཡུལ་ཡིན་པར་སྨྲ་བ་དང་།",
    "ཞེས་གསུངས་སོ།",
    "ཐ་དད་ཁྱད་པར་མཚུངས་པ་ཡི།",
    "རྣམ་པར་སྣང་བ་ཅན་ལ་འགོད།",
    "དེ་ཉིད་ཤིང་ཞེས་པའི་སྒྲ་དོན་ཡིན་ནོ་ཞེས་བྱས་པ་ལ་རྩོད་པར་བྱེད་ཅིང་།",
    "ཤིང་གསལ་སོ་སོའི་ཤིང་མ་ཡིན་ལས་ལྡོག་པར་སྣང་བའི་ཆ་ཐམས་ཅད་ཆ་ཐ་དད་མེད་དགོས་སྙམ་པའོ།",
    "དེ་བཞིན་དུ་སྒྲ་དང་བུམ་པ་ལ་སོགས་པ་མི་རྟག་པའི་གསལ་བ་ཐམས་ཅད་ལའང་མི་རྟག་པ་མ་ཡིན་པ་ལས་ལོག་པར་སྣང་བ་དེ་ནི་ཁྱད་མེད་དུ་རྗེས་སུ་འགྲོ་ན།",
    "བུམ་པ་ལ་སོགས་པའི་གསལ་བ་གཞན་རྣམས་ཀྱི་སྟེང་དུའང་མི་རྟག་པ་མ་ཡིན་པ་ལས་ལོག་པར་སྣང་བ་དེ་ཉིད་བསྒྲུབས་པར་འགྱུར་བས་གསལ་བ་གཞན་མི་རྟག་པར་སྒྲུབ་པའི་རྟགས་ཐམས་ཅད་དོན་མེད་པར་འགྱུར་རོ།",
    "མཚམས་ཇི་ལྟར་སྦྱོར་བའི་ཚུལ་གསུངས་པའི་དགོངས་པ་དཔྱིས་ཕྱིན་པ་ཡིན་ནོ།",
    "སྒྲ་དང་འདྲེས་པར་རྟོག་པ་ལ་སྣང་བའི་དོན་རྟག་པ་ལྟ་བུ་གཅིག་སྒྲ་ལ་གཅོད་པ་ན།",
    "སྒྲ་མི་རྟག་པར་བརྗོད་པའི་སྒྲའམ།",
    "དེས་ན་ཁོ་བོ་ཅག་ནི་སྒྲ་བུམ་སོགས་ཐམས་ཅད་ལ་མི་རྟག་པ་མ་ཡིན་པ་ལས་ལྡོག་པར་སྣང་བ་དེ་ཉིད་ཁྱད་མེད་དུ་རྗེས་སུ་འགྲོ་ཞིང་།",
    "ཇི་སྐད་དུ་བརྗོད་པའི་བློའི་སྣང་བ་ལ་བརྟེན་པ་ཉེས་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་སོགས་གསུངས་སོ།",
    "ཞེས་པ་ལ་འབྲས་བུ་དུ་མ་དང་རྟེན་གཅིག་ལ་འཇུག་པར་འགྱུར་བ་ཡིན།",
    "སྤྱི་རྟག་དངོས་སྨྲ་བ་ལ་མི་འཐད་པར་བསྟན་པ་ནི།",
    "ཨུཏྤ་ལ་བརྗོད་པ་དང་སྔོན་པོ་བརྗོད་པའི་སྒྲ་གཉིས་རྣམ་གྲངས་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཨུཏྤ་ལའི་སྒྲས་ཀྱང་ཨུཏྤ་འལ་མ་ཡིན་པ་རྣམ་པར་གཅོད་པ་གཅིག་གཅིག་སྟོན་པ་ན།",
    "དེ་ལྟ་བུའི་སྒྲ་ནི་མེ་ཏོག་དང་ཨུཏྤ་ལ་དང་སྔོན་པོ་མ་ཡིན་པ་རྣམ་པར་གཅོད་པར་བྱེད་པ་ན།",
    "དེ་ཡང་གཞི་མཐུན་དུ་འཇོག་པ་ལ་ཨུཏྤལ་སྔོན་པོའི་བྱེ་བྲག་ཏུ་གྱུར་པའི་མེ་ཏོག་གཅིག་གཞིར་བྱས་ནས་དེ་ཨུཏྤལ་དང་སྔོན་པོའི་གཞི་མཐུན་དུ་འཇོག་པ་ན་རྟོག་པ་ལ་མེ་ཏོག་ཁྱད་གཞི་དང་།",
    "སྔོན་པོ་ཡང་ཡིན་པར་དངོས་པོ་ལ་གནས་པའི་སྒོ་ནས་ལྡོག་པ་གཉིས་པོ་དེ་ལྡན་པ་གཅིག་དགོས་སོ།",
    "དཔེར་ན་བྱས་པ་དང་བྱས་པ་བཞིན་ནོ།",
    "གཞི་མཐུན་དུ་དོན་དམ་པར་མ་གྲུབ་བོ་ཞེས་བསྟན་པའི་སྒོ་ནས་གཞི་མཐུན་དུ་འཇོག་བྱེད་ཀྱི་བློ་རྟོག་པ་ཡིན་པར་སྟོན་པ་ནི།",
    "དེ་ལྟར་གཞག་པའི་གཞི་མཐུན་དོན་དམ་དུ་མ་གྲུབ་པའི་རིགས་པ་སྟོན་པར་བཞེད་ནས།",
    "ཞེས་གསུངས་སོ།",
    "བུམ་པ་ལྟོ་ལྡིར་བ་ཡིན་པར་དངོས་ལ་གནས་པས་བརྡ་ལ་བྱང་བ་དག་ལ།",
    "མེ་ཏོག་དེ་ཨུཏྤ་ལ་དང་སྔོན་པོའི་གཞི་མཐུན་ཡིན་པར་དངོས་པོ་ལ་གནས་ན་མེ་ཏོག་དེ་ཨུཏྤ་ལའོ་ཞེས་བརྗོད་པ་ན།",
    "དེ་སྔོན་པོ་ཡིན་པར་ཡང་སྣང་དགོས་ལ།",
    "དེ་སྔོན་པོའོ་ཞེས་བརྗོད་པ་ཙམ་གྱིས་དེ་ཨུཏྤ་ལ་ཡིན་པར་ཡང་སྣང་དགོས་པས།",
    "ཞེས་པའི་དོན་དུ་འཆད་པར་བྱེད་དོ།",
    "ཊཱིཀ་བྱེད་གཞན་དག་སྤྱི་དངོས་པོ་བ་དོན་གཞན་གཅིག་ནི་སྒྲས་རྗོད་པར་བྱེད་པ་མིན།",
    "གཞན་ལུགས་ཀྱི་གཞི་མཐུན་ཡོན་ཏན་དོན་གཞན་ལྡན་པའི་སྒོ་ནས་འཇོག་པར་འདོད་པ་བཀག་ནས།",
    "གཞན་ལ་མི་འཐད་པར་བསྟན་པའི་སྒོ་ནས་གཞན་དག་ལུགས་འདི་ལ་གཞུག་པའི་ཆེད་ཡིན་ནོ།",
    "གཞན་ལུགས་ལ་སྤྱི་གཞི་མཐུན་མི་སྲིད་པར་འགྱུར་བའི་ཚུལ་སྟོན་པ་ལ།",
    "སལ་བ་ཐམས་ཅད་རྫས་གཅིག་པར་འདོད་པའི་ཕྱོགས་ལ་སྤྱི་གཞི་མཐུན་མི་རུང་བར་སྟོན་པ་ནི།",
    "སྤྱི་གསལ་ལ་སྒྲ་ཡང་ཐ་དད་དུ་འཇུག་པར་མི་འགྱུར་བས་གཞི་མཐུན་གྱི་སྒྲ་བློའི་ཐ་སྙད་ཐམས་ཅད་རྒྱུན་ཆད་པར་འགྱུར་ཏེ།",
    "ཞེས་གསུངས་པ་ལྟར་སྤྱི་ཡང་མི་འཐད་པར་བསྟན་པ་ནི།",
    "དེ་བས་ན་སྤྱིའི་ཐ་སྙད་ཐམས་ཅད་ཀྱང་རྒྱུན་ཆད་པར་འགྱུར་ལ།",
    "སྔོན་པོ་སེར་པོ་ལ་རྗེས་སུ་མི་འགྲོ་བས་སྤྱི་གཞི་མཐུན་མི་འཐད་པར་འཕེན་ནུས་མི་ནུས་སོམས་ཤིག་བྱེ་བྲག་པ་སྤྱི་གསལ་རྫས་གཞན་ཁས་ལེན་པ་ལ་དེ་དག་མི་འཐད་པར་སྟོན་པ་ནི།",
    "ཀྱང་ཞེས་པས་གསལ་བ་དང་སྤྱི་རྫས་གཞན་ཡིན་ན་སྤྱིའི་ཐ་སྙད་མི་འཐད་པར་མ་ཟད།",
    "ཆུ་སྐྱོར་བ་དེ་ཡི་འབྲས་བུ་མེད་པ་ཅན་ལས་ལྡོག་པར་རང་རྒྱུ་ལས་སྐྱེས་པ་ཅན་ཡིན་པའི་ཕྱིར།",
    "དེ་མིན་མ་བཅད་ན་མི་འདོད་པའི་དོན་ལ་མ་འདྲེས་པཔར་བསྟན་མི་ནུས་པའི་ཕྱིར་དང་།",
    "གལ་ཏེ་དེ་མིན་བཅད་པ་ལ་མ་ལྟོས་པར་རང་མཚན་ཁོ་ན་ལ་བརྡ་སྦྱོར་བ་སྔར་ཡང་བཀག་ཟིན་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "དོན་གསལ་བ་རྣམས་ལ་དེ་འདྲའི་སྤྱི་གཅིག་ཐ་དད་མེད་པའམ་མཚུངས་པར་ཡོད་པ་ལ་ཡང་སྒྲ་ཡི་བྱེ་བྲག་ཐ་དད་ཁོ་ན་སྦྱོར་བ་མི་རིགས་པས་བ་ལང་ཞེས་པའི་སྤྱི་སྒྲ་གཅིག་སྦྱར་བ་ཡིན་གྱི།",
    "ཊཱིཀ་བྱེད་གཞན་དག་འབྲས་བུ་རིགས་གཅིག་བྱེད་པར་མཚུངས་པ་དེ་ཉིད་གསལ་བ་རྣམས་ལས་རྫས་གཞན་པའི་སྤྱིར་འདོད་ནའང་།",
    "ཞེས་པ་ལས་དགག་བྱ་དང་འགོག་བྱེད་གཉིས་ཀ་ལ་ཁྱད་པར་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "བདུན་པ་རྟོག་པའི་སྣང་ཡུལ་དང་སྒྲ་དོན་དུ་གྱུར་པའི་སྤྱི་དངོས་པོ་བ་ཡོད་པ་རྒྱས་པར་དགག་པ་ལ།",
    "འོན་ཏེ་སྒྲོན་མེས་གཟུགས་ལྟར་གསལ་བས་སྤྱི་གསལ་བར་བྱས་པ་ཡིན།",
    "འཁར་གཞོང་ལ་རྒྱ་ཤུག་བརྟེན་པར་མཐོང་ངོ་ཞེ་ན།",
    "མི་འཇིག་པར་གནས་པའི་རྟག་པ་ཡིན་པའི་ཕྱིར།",
    "ཐ་དད་མིན་པ་བྱེད་ཅེས་རྣམ་པར་དཔྱོད་པས་བཅད་ན་དེ་གཉིས་ཀ་མི་རིགས་པ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "དེ་ཡང་རྫས་ཐ་དད་ན་སྤྱི་གནས་པ་མིན་པར་འགྱུར་རོ།",
    "དོན་གཞན་གནས་པའི་རྟེན་ཡིན་ན་རྒྱུ་ཡིན་དགོས་པར་མ་ཟད།",
    "སྤྱིར་གསལ་བྱ་གསལ་བྱེད་ཀྱི་ཚུལ་དེ་ལྟར་ཡིན་པ་ལ་སྤྱི་འདི་ནི་སྔ་ནས་རང་འཛིན་སྤྱི་བློ་སྐྱེད་རུང་ཉིད་དུ་ཡོད་པ་ཡིན་ན་དེར་འགྱུར་བ་གསལ་བས་གསལ་བར་བྱས་པ་དེ་ལ་ལྟོས་པར་མི་རུང་ཞིང་།",
    "དེར་འགྱུར་བ་གསལ་བ་དེ་ལ་ལྟོས་པར་མི་རུང་སྟེ།",
    "དེས་ན་སྤྱི་དེ་ནི་སྤྱི་དེ་དང་ལྡན་པའི་གསལ་བས་གསལ་བར་བྱས་པ་ལས་རང་འཛིན་སྤྱི་བློ་སྐྱེད་པ་གང་ལས་ཡིན་ཏེ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་གསལ་བས་སྤྱིའི་ངོ་བོ་གསལ་བར་བྱས་པའི་སྒོ་ནས་སྤྱི་བློའི་ཡུལ་དུ་སྤྱི་གསལ་བ་མ་ཡིན་གྱི།",
    "གསལ་བ་དེ་སྤྱིའི་གསལ་བྱེད་དུ་མི་འཐད་པར་མ་ཟད།",
    "འདི་བ་ལང་ངོ་སྙམ་པའི་སྤྱི་ཡི་བློ་གྲོས་སྐྱེ་བ་ཇི་ལྟར་ཡིན་ཏེ་མི་འཐད་པར་འགྱུར་རོ།",
    "གཞན་ཡང་གྲངས་ཅན་འདོད་པ་ལྟར་སྤྱི་དེ་གཞན་གསལ་བ་རྣམས་ལ་རྫས་གཞན་ཉིད་མིན་པར་རྫས་གཅིག་ཡིན་ན་སྤྱི་དེ་ལ་ཆ་ཤས་མེད་པས་སྤྱི་གསལ་གཅིག་ཏུ་འགྱུར་ཞིང་།",
    "སྤྱི་གསལ་རྫས་གཞན་ཉིད་ཡིན་ན་ཡང་སྤྱི་གསལ་བ་ལ་བརྟེན་པའམ་རྗེས་སུ་འགྲོ་བ་མིན་པར་འགྱུར་ཏེ།",
    "པེ་ལུ་ཀ་གཉིས་དེའི་དོན་ལ་མི་མཐུན་པར་སྨྲ་བ་ནི།",
    "ལུ་ཀ་ནི་གསལ་བ་ཡོད་མེད་ཀྱི་ཡུལ་ཀུན་ན་ཁྱབ་པར་འདོད་ལ།",
    "གཉིས་ཀའང་སྤྱི་རྟག་དངོས་མེད་གསལ་བ་རྣམས་དང་རྫས་གཞན་དུ་འདོད་པ་སོགས་ལ་ཁྱད་པར་མེད་དོ།",
    "སྤྱི་གསལ་བ་སྔ་མ་ལ་ཡོད་པར་ཁས་བླངས་ན།",
    "ཕྱི་མ་ལ་ཡོད་པར་ཁས་བླངས་ན་སྔ་མ་སྤྱི་མེད་དུ་འགྱུར་བ་འདི་ལྟ་བུའི་སྤྱིའི་འཇོག་ཚུལ་ནི།",
    "གལ་ཏེ་སྤྱི་མཐོང་བ་ནི་གསལ་བས་གསལ་བར་བྱས་པ་ལ་ལྟོས་པས་གསལ་བ་མེད་པའི་ཡུལ་གྱི་སྤྱི་མཐོང་བ་དང་།",
    "དེ་ཡིན་ན་གསལ་བ་མ་རྟོགས་པར་སྤྱི་མི་རྟོགས་དགོས་པའི་ཕྱིར་ཏེ།",
    "གསལ་བྱེད་སྔར་རྟོགས་པ་མ་ཡིན་ན་དེའི་གསལ་བྱ་ཡང་དག་པར་རྟོགས་པ་མིན་པའི་ཕྱིར།",
    "གསལ་བ་མ་རྟོགས་པར་སྤྱི་མི་རྟོགས་པ་འདོད་དོ་ཞེ་ན།",
    "རྟོགས་ཚུལ་གོ་ལྡོག་པར་འདོད་དེ།",
    "ཐ་དད་མེད་པའི་དོན་སྤྱི་རྫས་གཞན་མེད་པར་ཡང་འབྲས་འཚེད་པའི་སྐྱེས་བུ་དུ་མ་འཚེད་པ་པོ་ལ་སོགས་པའི་བརྗོད་པ་དང་སྤྱི་བློ་འཇུག་པ་ཡིན་པའི་ཕྱིར།",
    "ཀྱང་ཞེས་པས་ལས་ཀྱི་སྤྱིའང་མི་གནས་པར་སྟོན་པ་ཡིན་ནོ།",
    "འང་ཞེས་པས་ལས་དང་ལས་ཀྱི་སྤྱི་དེ་འདྲའི་རྒྱུ་ཡིན་པར་མ་ཟད།",
    "དཔེར་ན་ཡོད་པ་ཉིད་སྤྱི་སྐྱེས་ཙམ་ནས་འཕྲོད་འདུས་འབྲེལ་བྱས་དེ་དག་ལ་དང་པོ་ནས་ཡོད་པའི་སྒྲ་བློ་འཇུག་པ་སོགས་བཞིན་དུའོ།",
    "ཕྱིས་ཀྱང་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟར་འཇུག་པའི་དངོས་རྒྱུ་ཐོགས་མེད་དུ་ཁས་བླངས་པའི་སྤྱི་དེ་ཡོད་པ་ལ་སྔར་དང་ཕྱིས་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "ཁྱད་པར་མེད་པའི་རྟག་པ་ཡིན་པའི་ཕྱིར།",
    "འདི་ནི་བྱ་བས་ཕུལ་དུ་བྱུང་བའི་ཁྱད་པར་བྱ་བ་ཡོད་དོ་ཞེ་ན་ཡང་།",
    "ཡང་ཡིད་ཀྱི་ཤིང་རྟས་བྱས་པ་ཡིན་ཟེར་བའི་འབྲེལ་བ་དང་ཊཱིཀ་བྱེད་ཁ་ཅིག་འདུ་བྱེད་ཐམས་ཅད་སྐད་ཅིག་མ།",
    "ཁྱད་པར་དུ་བྱར་མེད་པ་ལ་ལྟོས་པ་ཅི་ཞིག་ཡོད།",
    "ཞེས་གསུངས་པས་སོ།",
    "ཞར་ལ་རིགས་པ་དེས་གཅེར་བུ་པའང་ཁེགས་པར་བསྟན་པའོ།",
    "ཤི་ནས་བདག་རྒྱུན་ཆད་པར་འདོད་མི་འདོད་ཀྱི་ཁྱད་པར་མ་གཏོགས།",
    "གཉི་གའང་བདག་ཡོད་པར་འདོད་པ་ཤ་སྟག་གོ།",
    "སྤྱོད་པ་བ་ལ་སོགས་པ་ནི་རྟག་པར་ལྟ་བ་ཡིན་ལ།",
    "རྒྱང་ཕན་པ་ལ་སོགས་པ་ནི་ཆད་པར་ལྟ་བ་ཡིན་ཞིང་།",
    "ཤེས་བྱ་ཐམས་ཅད་ཉི་ཤུ་རྩ་ལྔར་གྲངས་ངེས་པར་འདོད་ལ།",
    "རྩ་བའི་རང་བཞིན་རྣམ་པར་འགྱུར་མིན་ལ།",
    "བཅུ་དྲུག་པོ་ནི་རྣམ་པར་འགྱུར་བ་སྟེ།",
    "བདག་དང་གཙོ་བོ་སྒྲུབ་པའི་རིགས་པ་དག་བརྗོད་པར་བྱ་སྟེ།",
    "ལོངས་སྤྱད་པར་བྱ་བའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རོ།",
    "རྨོངས་པ་ལམ་དུ་བྱ་བ་རིག་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་གཙོ་བོས་ནི་བློ་སྐྱེད་པར་བྱེད་དོ།",
    "གསལ་བ་རྣམས་ནི་འགྲོ་བ་ཡིན་ཏེ་འཇིག་པའི་ཚེ་གཙོ་བོའི་ངང་དུ་ཐིམ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་སུས་ཀྱང་བྱེད་པར་མི་འགྱུར་རོ།",
    "ཁྱད་པར་ཚད་ཕྱིར་རྗེས་འགྲོའི་ཕྱིར།",
    "ཁྱད་པར་རྣམས་ལ་ཚད་ཡོད་པའི་ཕྱིར་རོ།",
    "འཇིག་རྟེན་འདི་ན་གང་ལ་བྱེད་པ་པོ་ཡོད་པ་དེ་ལ་ཚད་ཡོད་པར་མཐོང་སྟེ།",
    "དེའི་ཕྱིར་གང་ལས་ཚད་དང་ལྡན་པའི་གསལ་བ་སྐྱེ་བར་བྱེད་པའི་གཙོ་བོ་ཡོད་པར་རྗེས་སུ་དཔག་པ་ལས་བསྒྲུབ་པར་བྱའོ།",
    "ཁྱད་པར་རྣམས་རྗེས་སུ་འགྲོ་བ་མཐོང་བའི་ཕྱིར་རོ།",
    "གང་རིགས་དང་ལྡན་པར་དམིགས་པ་ཡང་ཡིན་པ་དེ་ནི།",
    "དཔེར་ན་བུམ་པ་དང་ཁམ་ཕོར་ལ་སོགས་པའི་ཁྱད་པར་འཇིམ་པའི་རིགས་དང་ལྡན་པ་དེ་དག་ནི་འཇིམ་པའི་བདག་ཉིད་ཀྱི་རྒྱུ་ལས་བྱུང་བ་བཞིན་ནོ།"
  ]
}