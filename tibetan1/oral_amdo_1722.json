    "མྱང་རོ་ཁྱོང་དཀར་ན་གཙང་གི་རྗེ་བོ་ཐོང་དཀར་བློན་པོ་གནང་།",
    "གླིང་སྨད་པས་རྨ་ཆུ་སྔོན་མོའི་ཉིན་སྲིབ་བརྒྱུད་ནས་དབུ་བའི་ཚྭ་མཚོ་ཚུན་ཆད་ཁྲི་ཤོར་རྒྱལ་མོ་ཡན་ཆད་ཀྱིི་ས་བཟུང་།",
    "ཡེ་སེང་དང་ཡེ་སྨོན་ཟེར་བ་ནི་བོད་ཀྱི་ཐོག་མའི་དུས་ཀྱི་རུས་མིང་གི་གྲས་ཡིན་པ་དང་།",
    "དེ་ཡང་ཐོག་མར་སློབ་དཔོན་ཤེས་རབ་གོ་ཆས་བརྩམས་པའི་ལྷ་ལས་ཕུལ་བྱུང་གི་བསྟོད་འགྲེལ་དུ་སྔོན་སྐྱབས་སེང་གི་བུ་ལྔ་དང་སྒྲ་ངན་དཔུང་ཚོགས་བཅུ་གཉིས་འཐབ་པ་ན།",
    "ལྷ་ལས་ཕུལ་བྱུང་གི་བསྟོད་འགྲེལ་ཤེས་རབ་གོ་ཆས་མཛད་པར།",
    "སྔོན་སྐྱབས་སེང་གི་བུ་ལྔ་དང་སྒྲ་ངན་དཔུང་ཚོགས་བཅུ་གཉིས་འཐབ་པ་ན།",
    "དེའི་བསྟན་དོན་ནི་རྒྱ་གར་གྱི་རུ་པ་ཏི་དཔུང་ཚོགས་ཤིག་བོད་མིའི་གྲས་སུ་ཞུགས་ཡོད་པ་ཙམ་ཁས་བླངས་པ་ལས།",
    "ཡང་དེབ་ཐེར་དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་ལས་ཀྱང་།",
    "རུ་པ་ཏི་དཔུང་ཚོགས་བོད་མིའི་གྲས་སུ་ཞུགས་ཡོད་པ་ཡིན་ནའང་བོད་མིའི་རུས་རྒྱུད་ཀྱི་ཁུངས་མིན་པར་བསྟན་ཡོད།",
    "རུ་པ་ཏི་ནི་རི་ཁ་བ་ཅན་གྱི་ཁྲོད་དུ་སོང་ནས་བོད་ཀྱི་རྗེ་བོར་མཛད་ཟེར་མཁན་འགའ་རེ་བྱུང་ཡོད་པ་དེ་རེད།",
    "དེ་ལ་ཁྱོད་ཀྱིས་ཞིབ་མོར་སོམས་དང་།",
    "བཞི་ན་བོོད་མི་རྣམས་ཀྱི་དད་མོས་བྱེད་ལུགས་དང་བསམ་པའི་ཀུན་སློང་གི་འཁྱེར་སོ་ལ་ཆ་རྒྱུས་མེད།",
    "དེ་འདྲའི་ཆ་མེད་རྒྱུས་མེད་ཀྱི་རྒྱ་གར་ཡུལ་བྱོལ་བ་ཞིག་བོད་དུ་ཞུགས་ནས་བོད་གྱི་རྗེ་བོ་བྱེད་པ་ནི་ཤིན་ཏུ་ནས་འབྱུང་དཀའ་བ་ཞིག་རེད།",
    "ལྕང་གླང་རོལ་བའི་རྡོ་རྗེས་བརྩམས་པའི་ཡུམ་བུ་གླ་སྒང་གི་དཀར་ཆག་ལས།",
    "སྤོ་བོའི་ཡུལ་དུ་བྱ་མོ་བཙུན་བྱ་བའི་བུད་མེད་ཅིག་ལ་བུ་སྤུན་དགུ་སྐྱེས་པ་ལས་ཆུང་ཤོས་དེ་ལ་ཨུ་བེ་ར་ཟེར་བ།",
    "ཡར་ལུང་གི་མི་རྣམས་ཀྱིས་བོད་ཀྱི་རྒྱལ་པོ་གསར་པ་འོས་པའི་མི་འཚོལ་བ་དང་བྱང་ལམ་གཡའ་མོ་གོང་ཟེར་བ་དེར་ཐུག་ནས།",
    "ཁོ་ཚོས་ཁྱོད་སུ་ཡིན།",
    "འོ་ན་ཁྱོད་ལ་མཐུ་རྩལ་ནུས་པ་གང་འདྲ་ཡོད་ཅེས་དྲིས་པས།",
    "འོ་ན་ཁྱོད་ཀྱིས་བོད་ཀྱི་རྒྱལ་པོ་བྱེད་དགོས་ཟེར་ནས་གཉའ་བར་ཁྲི་བྱས་ནས་བཏེགས་ཏེ་རྒྱལ་པོར་བསྐོས་པས་མིང་ལ་གཉའ་ཁྲི་བཙན་པོ་ཞེས་སུ་གྲགས་ཞེས་བྱུང་བ་ལྟར་བོད་རྗེའི་ཐོག་མ་སྤོ་བོའི་ཡུལ་གྱི་མི་ཡིན་པ་ལས།",
    "ཡང་རྒྱ་ནག་གི་ཡིག་ཚང་དུ་བྱུང་བའི་ཁ་ཅིག་གིས།",
    "འཇང་པ་དེ་དག་གནའ་སྔ་མོ་ཞན་ཕེའི་རིགས་ལས་མཆེད་པ་སྟེ།",
    "བོད་འདི་འཇང་པ་ལས་འཕེལ་བའི་མི་རྒྱུད་རེད་ཅེས་དྲངས་ཡོད།",
    "དེང་སང་ཁ་ཅིག་གིས།",
    "ད་སྐབས་ཙང་ཙུའུ་ཟེར་བ་འདི་ནི་དེའི་ནང་གི་ཆ་ཤས་ཤིག་རེད་ཅེས་འཆད་འདུག་འོན་ཀྱང་ཞིབ་ཏུ་བསམས་ཤིང་བརྟགས་ན།",
    "རྒྱ་ཡིག་གི་དེབ་ཐེར་ནང་དུ་བྱུང་བའི་འཇང་པ་དེ་ནི་དུས་རབས་དང་པོའི་ཡས་མས་ནས་བོད་དང་ཉེ་སར་ཡོད་པའི་མི་རིགས་ཤིག་ཡིན་དགོས་ཏེ།",
    "བཙན་པོ་དབྱརད་གླིང་གི་འོལ་ཕྱག་ན་བཞུགས་ཤིང་།",
    "གླིང་སེང་ཆེན་རྒྱལ་བོའི་སྒྲུང་གི་ནང་དུའང་འཇང་གླིང་གཡུལ་འགྱེད་ཟེར་བ་ཡང་ཡོད་དེ།",
    "འཐབ་རྩོད་དམ་འཁྲུག་ལོང་མང་པོ་བྱུང་བ་འདུམ་ལ་བརྟེན་ནས་ཕན་ཚུན་འདྲེས་ཡོད་པ་ནི་ཟིན་བྲིས་དག་གི་ནང་དུ་མཐོང་རྒྱུ་ཡོད།",
    "ལོ་སྟོང་ཚོ་དུ་མའི་ཡར་སྔོན་དུ་མི་ཡི་འགྲོ་བ་ཡོད་དམ་མེད་ཅེ་ན།",
    "སུས་ཀྱང་ཀློག་ཐབས་མེད་པར་ཁས་ལེན་བྱེད་དགོས་པ་ཞིག་རེད།",
    "དེ་ནི་རྡོ་ཆས་སྤྱོད་པའི་དུས་ཀྱི་མིའི་རིགས་ཀྱི་རུས་པ་རེད་ཟེར།",
    "གཞན་ཡང་ཉེ་ལམ་ལོ་འགའི་རིང་མཚོ་སྔོན་དང་ཁམས་ཕྱོགས་སུའང་ས་འོག་ནས་ཐོན་བཞིན་ཡོད་པའི་གནའ་རྫས་རྣམས་རྡོ་ཆས་སྤྱོད་པའི་དུས་རབས་གསར་མའི་རིང་གི་ཡིན་པར་ར་འཕྲོད།",
    "ད་སྐབས་རྟོོག་ཞིབ་རུ་ཁག་གིས་ཚན་རིག་གི་སྒོ་ནས་འགྱུར་རྡོ་ལ་རྟོག་དཔྱོད་བྱས་པ་ལས་བྱུང་བའི་སྡོམ་ཚིག་གི་ཐོག་ནས།",
    "དངོས་དོན་དེ་དག་གི་ཐད་ནས་བོད་མི་རྒྱ་གར་ལས་མཆེད་ཅེས་པའི་ལུང་ཚིག་ལ་མཐའ་དཔྱོད་བྱས་ཡོད་པས་མ་ཚད།",
    "ཀློག་པ་པོའི་ཐུགས་ཡིད་ཚིམས་པ་ཞིག་ཡོང་རྒྱུ་ཕར་བཞག་འཆལ་འཆོལ་དུ་སོང་བའང་ཤིན་ཏུ་མང་པོ་ཡོད་ངེས་པས།",
    "ཀློག་པ་པོ་རྣམས་ཀྱིས་རིན་བྲལ་གྱི་སློབ་སྟོན་དགོངས་འཆར་ལྷུག་པོར་ཡོང་བའི་རེ་འདུན་ཞུ་རྒྱུ་ཡིན།",
    "དེ་ལྟར་སྐྱབས་འོས་ཁྱོད་ཀྱིས་ལུས་ཅན་རྣམས།་",
    "རང་གི་ཕུང་པོ་ལ་དམིགས་ནས་ང་དང་ང་ཡིར་འཛིན་པའི་འཇིག་ཚོགས་ལ་ལྟ་བའི་རི་བོའི་སུལ་དུ་གནས་བཅས་ཏེ།",
    "ཕྱི་སེང་གིའི་འཇིགས་པ་ལས་བསྐྱབ་པའི་ཕྱིར་དུ་གསོལ་བ་འདེབས་པ་སྟེ།",
    "སྔོན་ཡང་ཤིང་འཐུན་ཞིག་ནགས་སུ་སོང་བ་སེང་གེ་མ་བཀྲེས་པ་དང་འཕྲད་ནས་ཁར་ཐོགས་ཏེ་ཟ་བར་བརྩམས་པ་ན།",
    "བུད་མེད་ཤིང་ལོའི་གོས་ཅན་ཞིག་བྱུང་བས་སེང་གེའི་ཁ་ནས་བླངས་ཏེ་ཚོང་དུས་སུ་བཞག་པ་ལྟར་རོ།",
    "གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱའི་འདོད་ཡོན་ལྔ་དང་།",
    "རང་གི་དཔྲལ་བའི་མྱོས་བྱེད་ཀྱི་བུམ་པ་ནས་བབས་པའི་ཆུ་འཐུངས་བས་མ་གོ་བོ་འཐོམས་པའི་འཐུས།",
    "ཕྱིན་ཅི་ལོག་གི་ལམ་དུ་ཞུགས་ནས།",
    "སྔོན་ཡོང་བུ་མོ་ཞིག་མེ་ཏོག་འཐུ་དུ་སོང་བ་གླང་ཆེན་གཏུམ་པའི་སྣས་བཅིངས་ཏེ་མཆེ་བ་བསྣུན་པར་བརྩམས་པ་ན།",
    "གདུག་པའི་དུག་གིས་མྱུར་དུ་ཁྱབ་བྱེད་པའི།",
    "སྔོན་ཡང་སྨད་ཚོང་མ་ཞིག་མུ་ཏིག་གི་དོ་ཤལ་ལྔ་བརྒྱ་སྟར་བའི་ཚོང་དཔོན་ཞིག་གི་ཁྱིམ་དུ་ཆས་པའི་ལམ་དུ་ཤིང་ལ་གནས་པ་དུག་སྦྲུལ་ལུས་ལ་འཁྲིལ་པའི་ཚེ།",
    "སྔོན་ཡང་ཡུལ་བྷ་རུ་ཀཙཛའི་ཚོང་དཔོན་ལོངས་སྤྱོད་དང་ལྡན་པ་ཞིག་རྔ་མོང་སྟོང་དང་།",
    "དྲུག་པ་སེར་སྣ་དང་ལྕགས་སྒྲོག་གི་འཇིགས་པ་ལས་སྐྱོབ་པར་གསོལ་བ་ནི།",
    "ཕྱི་ལྕགས་སྒྲོག་གི་འཇིགས་པ་ལས་བསྐྱབ་པར་གསོལ་བ་སྟེ།",
    "སྔོན་ཡང་རྐུན་པོའི་༡༨༣ དཔོན་ཞིག་གིས་རྒྱལ་པོའི་མཛོད་ཕུག་སྟེ་ཞུགས་པས་ཆང་གི་བུམ་པ་དང་ཕྲད་པ་འཐུངས་བས་བཟི་ནས་གཉིད་དུ་སོང་བ་བདག་པོས་རིག་སྟེ།",
    "བཙོན་རར་ལྕགས་སྒྲོག་གིས་བཅིངས་ཤིང་སྡུག་བསྔལ་འཕྲད་པ་ན།",
    "ལན་ཅིག་ནུབ་རེ་བཞིན་ཕྱི་རོལ་དུ་སོང་བའི་དགེ་སློང་རེ་རེ་ཤི་ནས་ཚོགས་པ་བྲི་ཞིང་།",
    "ནུབ་གཞན་པར་དགེ་ཚུལ་ཞིག་གིས་ཕྱི་རོལ་དུ་ཕྱིན་པས།",
    "ལྷ་མོ་ནག་མོར་རལ་གྲི་ཐོགས་པ་ཞིག་གིས་ཤ་ཟ་ལ་བསྡིགས་པས།",
    "ཤ་ཟ་དེས་ས་འོག་ནས་ལྕགས་བུམ་མུ་ཏིག་གིས་གང་བ་ཕྱུངས་ནས།",
    "ཁྱོད་ལ་བསྟོད་ཅིང་གསོལ་བ་བཏབ་པའི་མཐུས།",
    "རང་གི་འདོད་དོན་འགྲུབ་པར་སྨོན་པའོ།",
    "གཉིས་པ་རང་གི་འདོད་དོན་འགྲུབ་པར་སྨོན་པ་ལ་གསུམ།",
    "རང་དོན་སྒྲུབ་ལ་ནམ་ཡང་མི་རེ་ཞིང་།",
    "ལྷའི་མིག་༡༨༨ གི་མངོན་ཤེས།",
    "གསུམ་པ་མཇུག་གི་དོན་ནི།",
    "ཅེས་རྗེ་བཙུན་སྒྲོལ་མའི་བསྟོད་པ་ལེགས་བྲིས་མར་གྲགས་པའི་འགྲེལ་པ་འདི་ཡང་འདི་ནང་གི་རྣམ་གཡང་དོར་ནས་གཏན་བདེ་སྒྲུབ་པ་ལ་རྩེ་གཅིག་ཏུ་གཞོལ་པ་དཀར་བའི་ས་ཅེས་ཚེ་རིང་དོན་གྲུབ་ལགས་ནས་སྔ་ཕྱིར་ནན་ཆེན་པོས་བསྐུལ་དོར་དགེ་སློང་དྷརྨ་བྷ་དྲས་གསེར་འཕྱང་བ་ལོར་དངུལ་ཆུར་སྦྱར་བའོ།",
