    "རང་གི་ངག་ཏུ་ཅི་བརྗོད་པ་དང་།",
    "འོན་ཀྱང་འདི་ཉིད་ཞུ་དག་གི་ལས་རིམ་ཁྲོད་དཔེར་ན་ཕྱོགས་མཚམས་ཀྱི་ཕྱོགས་དང་།",
    "དེ་ནི་བྲིས་པས་ཆད་ལྷག་གི་སྐྱོན་ལས་སྔར་གྱི་འབྲི་སྲོལ་ལམ་ཡང་ན་བརྡ་རྙིང་སོགས་གང་ཡང་ཡིན་ཚོད་མི་འདུག་པས་ཕལ་ཆེར་གཅིག་གྱུར་གྱིས་བཅོས་ཡོད།",
    "ང་ཚོས་འདིར་བརྡ་རྙིང་ངམ་གནའ་བོའི་འབྲི་སྲོལ་ཞིག་ཡིན་པར་བསམ་ནས་རང་སོར་བཞག་ཡོད་པས་ཁྱེད་ཀློག་པ་པོ་རྣམ་པས་ཞུ་སྒྲིག་པས་སྣང་ཆུང་དུ་གཏོང་འདུག་པའི་དགོངས་ཚུལ་མི་བཞེས་པར་ཞུ་རྒྱུ་ཙམ་མ་ཟད།",
    "ཁྲི་བདེ་མཆོགསྐྱིད་སྲས་དགེ་ལེགས་ཉི་མ་བཅས་རྣམ་པ་བཞི་པོས་གོང་གསལ་གཡུང་དྲུང་ལས་རྣམ་པར་དག་པའི་རྒྱུད་འདི་ཕུད་གཞན་ད་ལན་ང་ཚོས་དཔར་བསྐྲུན་ཞུས་པའི་དེབ་ཆ་ཚང་ཞིབ་ཕྲའི་ཞུ་དག་རོགས་རམ་གནང་བ་དང་།",
    "སྐབས་སོ་གསུམ་པའི་གཡུང་དྲུང་བོན་གྱི་རྒྱུན་ལས་ཐུན་མོང་ནས།",
    "དེ་ཁ་དོག་ལྗང་གུ་བྱ་བ་ལ་ནན་ཏན་གྱིས་ཡེ་ཤེས་ཀྱི་ངོ་བོ་གཟི་བརྗིད་ཀྱིས་འབར་ཞིང་འོད་དུ་ཞུནས་ཡེ་ཤེས་ཀྱི་གི་འགྱུར།",
    "གསེལ་དཀར་མོ་བཞིན་དུ་གཟི་བརྗིད་ཀྱིས་འབར་ཞིང་བཟླས་པ་བྱའོ།",
    "ཚོན་དོས་མ་ལུང་གི་ནང་དུ་འཁོར་ལོ་རྩིབས་བརྒྱང་བྲིའོ།",
    "གུར་ཀུམ་ལ་སོགས་པ་རྫུས་དྲི་ཞིམཔོ་ཐམསཅད་དང་ནང་གི་བདུང་རྣམ་པ་ལྔ་དང་།",
    "གཞན་ཡང་ཧོམ་ཁུང་གི་ཕྱོགས་བཞི་དང་།",
    "འོད་ཟེད་གྱི་སྤྲིན་གྱིས་རེག་པའི་ཚུལ་གྱིས་བྱིན་གྱིས་བརླབས་ཏེ།",
    "རྩེ་མོར་འཁོར་ལོས་བརྒྱན་པར་བྱའོ།",
    "དེའི་འོག་ཏུ་སྒྲུབ་པ་པོས་དང་པོ་མདུན་དུ་སྨོས་པའི་ཚོ་གའི་བཞིའི་ཚུལ་གྱིས་གསུང་གི་རིགས་སྣང་བ་མཐའ་ཡས་ཀྱི་སྐུ་ཕྱག་རྒྱར་གྱུར་པར་བྱའོ།",
    "ཧོམ་ཁུང་གྲུ་བཞི་ལ་ཕྱོགས་རེ་རེ་ཁྲུ་རེ་རེ་དང་སེར་རེ་རེའོ།",
    "ཧོམ་ཁུང་གི་ཁའི་བདེ་རིམ་སོང་ལྟར་བྱའོ།",
    "དེ་ནས་མཆོད་རྫས་ཕྱི་ནང་གི་བསྟན་པར་བྱ་སྟེ།",
    "གསེར་དང་བྱུ་རུ་དང་དུང་གི་ལྟ་བ་དང་།",
    "དེ་ནས་རས་དམར་པོ་ཡུག་གིསཱམགུལ་ཆིངས་བྱའོ།",
    "གཡསུ་འཁྱིལ་བའི་རི་མོ་ཡོད་པ་དང་།",
    "དེའི་འོག་ཏུ་ཕྱིའི་མི་ལྕ་མདུན་དུ་སྨོས་པའི་འཁོར་ཉྩཕུན་སུམ་ཚོགས་པ་དང་བཅས་པ་འོད་གཟེར་གྱི་སྤྲིན་གྱིས་རེག་པའི་ཚུལ་གྱིས་བྱིན་གྱིས་བརླབས་ཏེ།",
    "དེའི་ཡུ་བའི་རྩ་བ་དང་དཀྱིལ་དང་རྩེ་མོ་བྲོ་པོའི་རྩེ་དགུས་བརྒྱན་པར་བྱ་དེནས་དགང་གཟར་དང་བླུགས་གཟརམ་རྙེད་ནཱ།",
    "དེ་ལྟར་དད་པ་མེད་པའི་སེན་མོ་ཙམ་གྱི་དོན་དུ་གསུངས།",
    "ས་བོན་དེཔས་ཁྲོ་བོའི་རྒྱལ་པོ་ཨ་མྲྀ་ཏ་ཀུཎྜལི་སྐུ་ཕྱག་རྒྱ་བསྐྱེད་པའོ།",
    "ཞེསྡང་གི་སེམས་རྩེ་གཅིག་པར་བྱ་བ་ཡི།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རིགས་ལྔའི་བྱེ་བྲག་གི་དེ་བཞིན་གཤེགས་པ་དང་།",
    "དེ་ལ་དམ་ཚིག་གི་དོན་དུ་གསུངས།",
    "རྡོ་རྗེའི་སྐུའི་བྱེ་བྲག་གིས།",
    "དེ་ལྟར་གཙུག་ཏོར་མཆིག་གི་དོན་དུ་གསུངས།",
    "ཤེས་རབམ་དེ་ཡི་ཤེས་ཀྱི་ལྷ་མོ་མམ་དྲང་གཉིས་མེད་པའི་ངོ་བོར་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "སྐྱེད་འ་མོས་ཚལ་ལ་སོགས་པ་གནས་གང་ཡང་རུང་བ་ཡིད་དུ་འོང་བར།"
  ]
}