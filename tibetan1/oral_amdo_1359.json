    "བོད་རང་བཙན་ཐོབ་པའི་སྐབས་སུ་ང་ཁྱེད་རང་ཚོར་ཐུག་འཕྲད་དུ་ཡོང་དུས།",
    "ཁོང་ཚོས་དེ་ཀུ་རེ་ཆེན་པོ་མཐོང་བ་རེད།",
    "ཡིན་ན་ཡང་ཁོ་ཚོས་ཚོགས་ཁང་ནས་འབུ་ཞིག་བཟུང་སྐབས་ཁོང་ཚོས་དེ་སྦར་མོའི་ནང་བཟུང་ནས་ཕྱི་ལོགས་སུ་གློད་ཀྱི་རེད།",
    "ཨ་མི་རི་ཀ་བ་ཚོས་ཧོ་ལི་ཝོ་ཌི་ཡི་གློག་བརྙན་རྣམས་ཁོང་ཚོར་འཁྱེར་ཡོང་།",
    "བོད་མི་ཚོས་ནུབ་ཕྱོགས་པ་དང་དམག་གི་ལྟད་མོ་དཔེར་ན།",
    "ལྟ་བུ་ལ་ཧ་ཅང་དགའ་བོ་བྱེད་ཅིང་འཐབ་འཛིང་ཅི་ཙམ་གྱིས་མང་ན་དེའི་ཚོད་ཀྱིས་ཁོང་ཚོ་དགའ།",
    "ཁམས་པ་རྣམས་མོ་ཊའི་ཁ་ལོ་བསྐོར་བྱེད་ཀྱི་རྒྱབ་ཏུ་ཡོད་པ་ལ་བསམ་བློ་ཞིག་ཐོངས་དང་།",
    "ཁོང་ཚོས་འབྱུང་སྲིད་པའི་གོད་ཆག་རྣམས་དགོད་བྲོ་པོ་ཞིག་ཏུ་མཐོང་གི་རེད།",
    "ཇཱོན་གྷི་རེན་ནེ་ད་ཆ་མེག་ཀར་ཐེ་ཡི་ལས་རོགས་ཡིན་ཅིང་།",
    "ཡང་ཡང་དམག་སྒར་ཧེལ་ལ་འགྲུལ་བཞུད་བྱས་ཡོད་པ་རེད་ལ།",
    "ང་ཚོ་ནི་འཆར་གཞི་བཟང་པོ་ཞིག་གི་ནང་དུ་འབྲེལ་བ་བྱུང་ཡོད་པ་དེ་ནི་སྐལ་བ་བཟང་བོ་ཞིག་ཡིན་པ་ང་ཚོས་ཤེས་ཀྱི་ཡོད།",
    "མེག་ཀར་ཐེ་ལྟར་ན་བོད་མི་ཚོ་ནི་ལམ་སེང་དེ་ལ་དགའ་བོ་བྱུང་བ་རེད།",
    "ལྕགས་དང་ཤིང་གིས་བཟོས་པའི་སྦུ་གུ་སྟབས་བདེ་རིང་ཚད་ལ་ཕི་ཊི་ལྔ་ཙམ་ཞིག་ལ་འཕུར་མདེལ་ཁྱིམ་བཟོས་ཀྱི་འབར་རྫས་ཡོད་པ་ཞིག་བཟོས་པ་དེར་ཡང་ན་འབར་རྫས་དང་མེ་ལྕེ་གང་རུང་མགོ་ལ་སྦྱར་བ།",
    "ཅུང་ཐག་རིང་སའི་དམིགས་འབེན་ལ་འཕེན་པ་དང་བཟོ་ཐུབ་པ་བཅས་རེད།",
    "དེ་ནི་འབེན་དམིགས་ཀྱི་མཚོན་ཆ་ལས་ཁྱོན་ཆེ་སྟོར་བའི་མཚོན་ཆ་བཞིན་དུ་ལམ་ལྷོང་ཧ་ཅང་ཆེ་བ་ཡོད་ན་ཡང་།",
    "དེས་ད་དུང་སེམས་ཁམས་ཀྱི་མཚོན་ཆ་ལྟ་བུ་ཞིག་གི་ནུས་པ་ཡང་ཐོན་ལ།",
    "དགུང་མོ་གཅིག་ལ།",
    "མདའ་འཕེན་མཐའ་མ་དེ་ཐུར་དུ་ཕྱིན་སོང་ལ།",
    "དེ་ནས་གཡས་ཕྱོགས་སུ་ཆེ་ཙམ་དཀྱོགས་ནས་ཐག་རིང་གི་རི་ངོགས་ཤིག་ཏུ་ཡལ་བར་གྱུར།",
    "སྐྱིན་ཚབ་ནི་ཨ་སྒོར་སྟོང་ཕྲག་༢༥ རེད།",
    "དམག་སྒར་ཧེལ་དུ་བོད་དང་ཨ་རིའི་དུས་ཆེན་གལ་ཆེ་བ་ཚོ་ནི་འགན་ཁུར་དང་བཅས་སྲུང་བརྩི་བྱས་པ་རེད་ལ།",
    "ཁོང་ཚོའི་ཕ་ཡུལ་དུ་ཁོང་ཚོ་ལ་སྒུག་བཞིན་པའི་ལྡུམ་རྭགཅིག་ཀྱང་མེད།",
    "བཅིངས་འགྲོལ་དམག་གིས་མཐའ་གཅིག་ཏུ་བཙན་གནོན་བྱས་ཡོད།",
    "ལྷ་སའི་ལྷོ་ཕྱོགས་ན་ཆུ་བཞི་སྒང་དྲུག་གིས་མུ་མཐུད་ནས་འཐབ་འཁྲུག་རྒྱག་བཞིན་ཡོད།",
    "གྲངས་འབོར་དེ་ཚོ་ནི་ཧ་ཅང་ཚད་ལས་བརྒལ་བ་ཞིག་རེད།",
    "དམག་འཐབ་འཕར་མ་རེ་རེའི་སྐབས་སུ་མགོན་པོ་བཀྲ་ཤིས་དང་ཁོའི་དམག་མི་རྣམས་ཀྱིས་རང་ཕྱོགས་ལ་ཤི་རྨས་བྱུང་བ་ཇེ་མང་དུ་སོང་བ་མཐོང་ཞིང་།",
    "ཁོང་ཚོའི་བཙན་ས་རྣམས་ཀྱང་འཇིགས་དངངས་ཇེ་ཆེར་སོང་།",
    "ང་ཚོས་ཅི་ཡང་ཤེས་ཀྱི་མེད།",
    "ཐ་ན་ང་ཚོས་ལྷ་ས་རུ་སྤྱི་ཡོངས་ཀྱི་གྱེན་ལོག་བྱུང་བ་ཡང་ཤེས་ཀྱི་མེད།",
    "ཐུབ་བསྟན་གྱི་སོ་ལྟ་བ་རྣམས་ཉིན་གཅིག་སླེབས་ནས་རྒྱ་དམག་ཕོན་ཆེ་ཞིག་རྒྱ་མིའི་ལམ་ཁ་གསར་པ་བརྒྱུད་ནས་ཐད་ཀར་དམག་སྒར་ལ་གཏད་ནས་ཡོང་གིན་འདུག་ཟེར།",
    "དེ་ནི་རྒྱ་མིའི་ལྐོག་བྱུས་ཤིག་རེད།",
    "བཅིངས་འགྲོལ་དམག་གི་ཕར་རྒོལ་གྱི་དམག་དཔུང་ལྟེ་བ་དེ་ཕར་ལྷོ་ངོས་སུ་ཡར་ཀླུང་གཙང་པོ་རྒྱུད་དུ་སོང་ཞིང་།",
    "ཐུབ་བསྟན་གྱིས་ཧ་ལམ་འཕྱིས་དྲགས་དྲགས་ཀྱི་བར་དུ་མགོ་སྐོར་དེ་ཤེས་མེད་པ་རེད།",
    "འོག་ན་རྒྱ་དམག་རྣམས་ཕྱོགས་གསུམ་ནས་ཡོང་བཞིན་པ་ང་ཚོས་མཐོང་ཐུབ་ཀྱི་འདུག་རྒྱ་མིས་ང་ཚོའི་གནས་ཕྱོགས་དེ་རྙེད་ནས་མེ་སྒྱོགས་ཆེན་པོ་སྤྱད་དེ་རི་ངོགས་སུ་སྒྱོགས་མདེལ་འཕེན་མགོ་བཙུགས།",
    "དེ་ནི་ཞོགས་ཀའི་ཆུ་ཚོད་བཅུ་གཅིག་ཙམ་རེད།",
    "ང་ཚོས་རང་གི་མེ་མདའ་སྤྱད་ནས་ཁོ་ཚོའི་ཐོག་མེ་མདའ་རྒྱག་མགོ་བཙུགས།",
    "ཕྱི་དྲོའི་དུ་ས་ཚོད་ཚང་མ་རྒྱ་མིའི་མེ་མདའ་འཕྲུལ་འཁོར་ཅན་གྱིས་ཁེངས་སོང་།",
    "དུས་ཚོད་དེར་གལ་སྲིད་ང་ཚོ་ལ་སྐུད་མེད་ཁ་པར་ཞིག་ཡོད་ན་ལ།",
    "ད་ཕྱིར་བལྟས་བྱས་ན་ང་ཚོ་སུ་རུང་ཞིག་གསོན་ཐུབ་པ་བྱུང་བ་ནི་རྫུ་འཕྲུལ་ཞིག་རེད།",
    "ནུབ་ཕྱོགས་སུ་ཉི་མ་གཉིས་རིང་རྟ་ཐོག་སོང་རྗེས་དེར།",
    "ཁོང་གིས་མགྱོགས་མྱུར་གྱིས་ཐག་གཅོད་ཅིག་བྱེད་དགོས་བྱུང་།",
    "རྒྱ་མིའི་གནམ་གྲུ་ཚོས་ཞིབ་རྟོག་གི་འཕུར་སྐྱོད་བྱེད་ཀྱིན་ཡོད་ལ།",
    "མཚམས་རེར་ཏག་ཏག་རང་གི་མགོ་སྟེང་དེར་འཕུར་གྱིན་ཡོད།",
    "ཁོང་དང་ཁོང་གི་དམག་མི་རྣམས་ཀྱིས་དུས་ཚོད་མང་ཆེ་བ་རྟ་བགྲོད་བྱེད་རྒྱུ་ལས་ཡིབ་རྒྱུ་ལ་གཏོང་གི་ཡོད།",
    "ལམ་ཁ་དེ་བོད་ནང་ཧ་ཅང་བགྲོད་དཀའ་ཚུལ་གྱི་གྲགས་པ་ཆེ་ལ་མང་པོ་བརྒྱུད་དགོས་པ་ཙམ་ལས་ཁོང་ཚོ་ལ་གང་ཞིག་གིས་ངང་སྒུག་བྱས་ཡོད་མེད་གཅིག་ཀྱང་ཤེས་ཀྱི་མེད།",
    "དེ་ནི་ཐབས་སྡུག་ཅིག་རེད།",
    "ང་ཚོས་རང་གི་བཞོན་རྟ་རྣམས་བཞག་ནས་འགྲོ་དགོས་བྱུང་།",
    "ང་ཚོའི་མང་པོ་ཞིག་ནི་རང་གི་ནང་མི་དང་མཉམ་དུ་ཡོད།",
    "ང་ཚོ་བགྲོད་དགོས་པའི་གཙང་པོ་ཁ་ཤས་ཡོད།",
    "ང་ཚོ་ནི་ནམ་རྒྱུན་ནས་རློན་པ་ཡིན།",
    "ང་ཚོ་ཙ་རིའི་ཀྱིང་ཧོར་རྟ་ཟེར་བའི་རྒྱ་གར་གྱི་ས་མཚམས་ལ་འབྱོར་དུས་ང་ནི་རྐང་རྗེན་མ་ཡིན་ཞིང་ང་ཚོའི་གྲོགས་པོ་མང་པོ་ཤི་ཚར་བ་རེད།",
    "དེ་ནི་ངའི་དམག་མི་ཙམ་ཞིག་མ་རེད།",
