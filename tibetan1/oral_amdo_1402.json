    "སྤྱོད་པ་ཡིན་པར་ངེས་ཀྱིས་བླང་དོར་རེས་མ་བྱེད།",
    "སྤྱོད་པ་བླང་དོར་རེ་དོགས་རེས་བྱེད་ན།",
    "འབྲས་བུ་ཡིན་པར་ངེས་ཀྱིས་རང་གི་སེམས་ལ་ལྟོས།",
    "རང་གི་སེམས་སུ་འདུས་ནས་གདའ་འོ་ཨང་གེ་སྟོན་པ་བ།",
    "དེའི་ཚེ་ཇེ་འཇིགས་ཇེ་འཇིགས་ལ་སོང་སྟེ།",
    "བསོད་སྙོམས་མཛད་དེ་གཏུམ་མོའི་ཁྲིད་ཞུས་ནས་བསྒོམས་ནས།",
    "ཁྱོད་དགེ་སྦྱོར་ལ་བརྩོན་རབ་འདུག་པས་རས་ཐུབ་ཏུ་པས།",
    "གཏུམ་མོ་ཤིང་གཤགས་ལ་མེ་སྦར་རུང་བ་ཡིན་གསུངས་ནས།",
    "དེ་ནས་ཞག་བདུན་བསྒོམས་པའི་རྡོ་བ་ལྟར་སོང་ནས་འདུག་ཞག་བདུན་གྱི་ནངས་པར་རྒྱལ་ཚེ་བདེ་དྲོད་རང་འབར་ལ་སོང་།",
    "དབུའི་སྟེང་ན་ཟླ་བའི་དཀྱིལ་འཁོར་རེ་རེ་འདུག་པ་མཐོང་།་",
    "ཡང་དགོང་མོ་ནས་སྲོད་ཅིག་གི་བར་ལ་དམྱལ་ཁམས་ཐམས་ཅད་དང་།",
    "ཡང་ཉིན་གཅིག་འདོད་ལྷ་རིགས་དྲུག་གི་ལྷ་རྣམས་གསལ་བོར་མཐོང་བ་ལ།",
    "གཟའ་དེ་རྟ་རྔ་ཕྲ་མོ་ཙམ་དུ་འདུག་པར་མཐོང་།",
    "སྐྱོན་དང་ཡོན་ཏན་གང་ཡང་མིན་སྒོམས་གསུངས་པ་དེ་ནས་འབད་དེ་བསྒོམས་པས་ཞག་བཅུ་བཞི་ནས་མཚན་ཐོག་ཅིག་ལ་རང་ལུས་ནམ་མཁའི་ས་ཁམས་ཁྱབ་པ་ཙམ་ཞིག་རེད་འདུག་པ་ལ།",
    "ནམ་ལངས་ནས་སྒོམ་ཐག་བཀྲོལ་ཙ་ན་ཐམས་ཅད་ཡལ་ནས་སོང་།",
    "གསུངས་ནས་མཆོག་གི་གཏུམ་མོ་གནང་ནས་བསྒོམས་པས།",
    "ཉིན་གཅིག་ཙ་ན་གུང་ཐང་གི་ལུང་བོ་ཐམས་ཅད་དུད་པས་གང་ནས་བབ་འདུག་ཅི་ཞིག་མུན་ནག་ཏུ་སོང་།",
    "དེ་གར་སྡོད་ལ་སྒོམས་གསུངས་ནས་སྟེང་གེགས་སེལ་བའི་གདམས་ངག་དེ་གནང་བས་ནམ་ལངས་པ་ལྟར་སོང་།",
    "ཡང་ནུབ་གཅིག་རང་གི་ལུས་འདི་ཤ་ཡེ་མེད་པའི་ཀེང་ན་རུས་རྩ་མང་པོས་སྦྲེལ་ནས་འདུག་པར་མཐོང་།",
    "སྐྱ་རེངས་ཐ་མ་ཤར་བའི་ཚེ་གཉིད་ཐུམ་ཕྲན་ཙམ་ཞིག་སོང་བ་ལ།",
    "རྗེ་བཙུན་གྱི་ཞལ་ནས་ཁྱོད་ལ་རྣམ་རྟོག་ཅིག་སྐྱེས་ནས་འདུག་པ་ད་ནངས་ངའི་ཉམས་ལ་བྱུང་གིས།",
    "ཡིད་བཞིན་ནོར་བུ་གཙུག་གིས་བརྒྱན།",
    "དོནཀྱང་མོས་གུས་དྲག་པོའི་མཐུས།",
    "དགུང་ད་ནངས་སྐྱ་རེངས་ཐ་མ་ལ།",
    "གཉིད་ཐུན་ཕྲས་ཙམ་ཞིག་ཐལ་བ་ལས།",
    "ཆུ་རློན་རེ་དཀར་འཕྱང་བ་ལ།",
    "སུམ་གལ་ཁྲ་བོ་དོར་གཅིག་གིས།་",
    "བུ་ཁྱོད་ཀྱིས་རྨིས་པའི་རྨི་ལམ་གྱི་མཚན་ལྟས་དེ་རྣམས།",
    "གནས་པ་ཟབ་མོ་ཆུ་རྒྱུན་མངའ།",
    "བུ་ཁྱོད་གསན་རྒྱུ་ཆུང་ངམ་རྫུ་བ་ལགས།",
    "འོན་ཀྱང་ད་རེས་མཚན་བལྟས་ཏེ།",
    "རྒྱ་མོའི་དར་ཆག་བཏབ་པ་དེ།",
    "ནང་གི་འབྲས་དཀར་ས་ལུ་དེ།",
    "འགྲོ་བའི་རེ་འདོད་སྐོང་བའི་བརྡ།",
    "ཁྱོད་ཀྱིས་ཕྱུགས་རྫི་བྱ་སྙམ་པ།",
    "ཁྱོད་ཀྱི་འཁོར་དུ་འདུ་བའི་བརྡ།",
    "བདེ་དྲོད་གཏུམ་མོ་ཡེ་ཤེས་མེས།",
    "ཁྱེད་དགེ་སློང་གི་ཐུགས་ལ་དེ་ལྟར་ཞོག།",
    "བུ་ཁྱོད་ལ་ཡང་སེམས་ཀྱི་ངོ་བོ་མ་བཅོས་པར་མཐོང་བའི་རྟོགས་པ་ཁྱད་པར་ཅན་ཞིག་དེའི་དུས་སུ་འཆར་བ་ཡིན་ཏེ།",
    "ལར་ཁྱོད་སྒོམ་ཆེན་གཤའ་མ་ཞིག་བྱེད་བསམ་ན།",
    "བུ་ཁྱོད་རང་ལ་ཡང་སེམས་ཀྱི་ངོ་བོ་མ་བཅོས་པར་མཐོང་བའི་རྟོགས་ནག་པོ་ཡང་དག་པ་རྒྱུད་ལ་སྐྱེ་བས་དེའི་དུས་སུ་ཚོགས་པ་སྐྱོངས།",
    "ད་ང་དང་འགྲོགས་མི་དགོས་པས་སོང་ཞིག་སྤྲུལ་པ་དང་སྒྱུར་བ་ལ་སོགས་ཆོ་འཕྲུལ་དང་།",
    "མཆོག་ཐུན་མོང་གཉིས་ཀའི་དངོས་གྲུབ་ཐོབ་ནས་འོང་གིས།",
    "རི་དེའི་མགུལ་ན་ཁྱོད་ཀྱི་གདུལ་བྱ་སྣོད་དང་ལྡན་པ་ཡོད་པས།",
    "བུ་སྟོན་པ་ཁྱོད་དབུས་སུ་བཞུད་མ་བཞུད།་།",
    "རེས་འགའ་ཟས་ཀྱི་སྣང་བ་འཆར།",
    "རེས་འགའ་གོས་ཀྱི་སྣང་བ་ས་འཆར།",
    "གོས་སུ་གཏུམ་མོའི་བདེ་དྲོད་གྱོན།",
    "རེས་འགའ་ནོར་གྱི་སྣང་བ་འཆར།",
    "རེས་འགའ་ཡུལ་གྱི་སྣང་བ་འཆར།",
    "རེས་འགའ་གྲོགས་ཀྱི་སྣང་བ་འཆར།",
    "རྩེ་མོ་རིན་ཆེན་བྲོག་ཞུ་འདྲ།",
    "ཁྱོད་དེ་རུ་སོང་ལ་འགྲོ་དོན་སྒྲུབས།",
    "བུ་ཁྱོད་ཀྱིས་འགྲོ་དོན་འགྲུབ་སྟེ་མཆི།",
    "ཞེས་གསུངས་ནས་ཁྱོད་ཀྱི་མིང་ཡང་དགེ་སློང་རྡོ་རྗེ་འཛིན་པ་ཆེན་པོ་འཛམ་གླིང་གྲགས་པ་ཞེས་བྱ་བ་ཡིན་ནོ་གསུངས།",
    "རྗེ་ནཱ་རོ་བའི་གདམས་པ་ཐུན་མོང་མ་ཡིན་བ་རྣམས་རྫོགས་པར་ཞུས།་",
    "དེ་ཡང་ལྕམ་ལྷན་ཅིག་སྐྱེས་པའི་སྒྲོན་མ་ཡོན་བདག་མོས་རྗེ་བཙུན་གྱི་ཕྱག་དཔེའི་གཉེར་མཛད་པ་ཡིན་ཏེ།",
    "རྗེ་བཙུན་གྱི་ཀ་དཔེ་ལ་སོགས་པ་གདམས་ངག་གི་ཕྱག་དཔེ་རྣམས་རྩད་ཆོད་དེ།",
    "དང་པོ་ཁྱོད་འོང་ཁར་ཡང་མཚན་རྟགས་གསལ་པོ་འདི་ན་ཡོད་པའི་ཚེ་ཡང་ང་དང་ཁྱོད་གཉིས་བང་བྱུང་ལ།",
    "འགྲན་པས་ཁྱོད་སྔོན་ལ་ཐལ་ཏེ།",
    "ཕྱག་གིས་ཕ་བོང་བརྡབས་པས་རྡུལ་ཕྲ་རབ་ཏུ་སོང་སྟེ།",
    "དེ་ལྟར་རྗེ་བཙུན་གྱི་དྲུང་དུ་ཟླ་བ་བཅུ་གསུམ་བཞུགས་ནས་དགུང་ལོ་སོ་གཉིས་པ་སྟག་གི་ལོ་ལ་དབུས་སུ་འབྱོན་པར་བརྩམས་ཏེ།",
    "དེ་ནས་ཤིང་སྟག་པའི་ནགས་ཡོད་པའི་ལུང་བ་ཞིག་གི་ཆུ་ལ་རྡོ་ཟམ་ཆུང་ཆུང་ཞིག་ཡོད་པའི་ས་བར་དུ་སྐྱེལ་ཐུང་མཛད།",
    "ཁྱོད་ཁྲེས་པོ་ཕོག་ལ་འདིར་སྡོད་ཅིག་གསུངས་ནས།",
    "བུ་ཁྱོད་ལ་ཡང་བར་སྐབས་སུ་དགེ་སྦྱོར་འཕེལ་འགྲིབ་བྱུང་ན་གདམས་ངག་འདི་དགོས་པ་ཡིན་གསུངས་ནས།",
    "ལར་ཁྱོད་ལ་སྒོམ་ཆེན་པ་མཐར་ཐུག་པ་ཞིག་འོང་བར་འདུག་གསུངས་ནས།་",
    "ཚེ་གཅིག་ལུས་གཅིག་གིས་སངས་རྒྱུ་བྱ་བ་ཤེས་བྱ་ལ་མི་སྲིད།",
    "ཐབས་ཁྱད་དུ་བསད་པས་ཆད་ལྟ་རུ་སོང་ཟེར་བ་ཡོད།",
    "བྲིན་དང་བུ་ཁྱོད་ཀྱིས་ཡོས་བུ་ལོ་རྟའི་ཟླ་བའི་ཚེས་བཅུ་བཞི་ལཱསྙེ་ནམ་གྱི་རི་ལ་སླེབ་པར་གྱིས་ཤིག་གསུངས་ནས་དྭགས་པོའི་སྐྱེལ་མགུར་འདི་གསུངས་མོ་པཨཱཀྵིས།",
    "བུ་རེ་དོགས་མེད་པའི་ངང་ལ་ཞོག།",
    "ཁོ་བོའི་གན་ནས་བྱ་རྒོད་སེར་པོ་ཞིག་དབུས་སུ་འཕུར་ཏེ་སོང་།",
    "རི་ཆེན་པོ་ཞིག་གི་རྩེར་བབས་པ་ལས།",
    "དར་ཅིག་ནས་སོ་སོར་གྱེས་ཏེ་སོང་།",
    "དུར་བ་རེ་རེ་ལ་ཡང་ངུར་བ་གཡོག་ལྔ་བརྒྱ་ཙམ་རེ་འདུས་ནས།",
    "ལུང་བའི་ནང་ཐམས་ཅད་དུར་བས་སེར་ཉོགས་ཀྱིས་གང་ནས་སོང་བ་རྨིས།",
    "ཚགས་ལྷམ་དགུར་མོ་གསོལ་བ་ལ་སོགས་ཏེ།",
