    "འོན་ཏེ་དོན་བྱེད་པ་དང་བྲལ་བས་ངོ་བོ་ཉིད་ཀྱིས་མེད་པའི་རི་བོང་གི་རྭ་ལ་སོགས་པ་མེད་པ་ཡིན་ན།",
    "དེ་ལྟ་ན་རང་གི་མཚན་ཉིད་ཀྱང་ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པར་ཅི་སྟེ་ཁས་མི་ལེན།",
    "རང་གི་མཚན་ཉིད་ནི་རྟག་པ་མ་ཡིན་པའི་ཕྱིར་ཡོད་པ་དང་འབྲེལ་པས་ཡོད་པར་ཁས་ལེན་ན།",
    "རང་གི་མཚན་ཉིད་འབྲས་བུ་ཡིན་པས་རྒྱུ་ལས་སྐྱེས་པའི་ཕྱིར་ཡོད་པ་ཡིན་ལ།",
    "དེའི་ཕྱིར་དོན་གྱི་བྱ་བ་བྱེད་པའི་རང་གི་མཚན་ཉིད་ཁོ་ན་ཡོད་པ་སྟེ།",
    "ཡོད་པ་ཉིད་མངོན་སུམ་ལ་སྣང་གི།",
    "རང་གི་མཚན་ཉིད་ཁོ་ན་སོ་སོར་ངེས་པར་ཉམས་སུ་མྱོང་བ་ཡིན་གྱི།",
    "དེ་བས་ན་མངོན་སུམ་ལ་ཐུན་མོང་མ་ཡིན་པ་དང་དོན་བྱེད་པའི་དངོས་པོ་གང་སྣང་བ་དེ་ཉིད་དོན་དམ་པར་ཡོད་པ་ཡིན་ལ།",
    "དེ་ལྟ་མོད་ཀྱི་དངོས་པོ་དོན་བྱ་བ་བྱེད་ནུས་པ་ཅུང་ཟད་ཀྱང་སྣང་བ་མེད་ན།",
    "དེ་ལ་རེ་ཞིག་རྟག་པ་ལ་ནི་དོན་བྱེད་ནུས་པ་མེད་དེ།",
    "ཧ་ཅང་ཐལ་ཆེས་སོ་ཞེས་ལེའུ་གཉིས་ཀར་བསྟན་ཏོ།",
    "འོན་ཏེ་ཁྱབ་པ་ནུས་པར་མ་གྱུར་མོད་ཀྱི།",
    "འོན་ཏེ་སོ་སོར་ངེས་པའི་དངོས་པོ་ཡོད་ན་དངོས་པོ་གཞན་སྐྱེ་བས་ཐལ་ཆེས་པ་མེད་དོ་ཞེ་ན།",
    "འོན་ཏེ་རྒྱུན་ལ་རྒྱུ་དང་འབྲས་བུ་འཇོག་པ་དེ་བས་ཐལ་ཆེས་པ་མེད་དོ་ཞེ་ན།",
    "སྐད་ཅིག་མ་རྣམས་ནི་ནུས་པ་མེད་པའི་ཕྱིར་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "གཞན་ཡང་རྒྱུན་ལ་འབྲས་བུ་ཉིད་དུ་འཇོག་ན་སྐད་ཅིག་མ་ཉིད་རྒྱུན་གཞན་དུ་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལ་རེ་ཞིག་ཤེས་པ་གཞན་གྱིས་ཤེས་པ་འབྲས་བུ་ཉིད་དུ་ཤེས་པ་ནི་མ་ཡིན་ཏེ།",
    "ཤེས་པ་རང་གི་རིག་པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་རོ།",
    "གཅིག་གིས་དངོས་པོ་སྔ་ཕྱིའི་རང་བཞིན་དུ་ཤེས་པ་མ་ཡིན་ཏེ།",
    "དེ་དག་གིས་ཀྱང་རྟག་པ་ཤེས་པ་ནི་མ་ཡིན་ཏེ།",
    "གང་གི་ཚེ་འབྲས་བུའི་ཤེས་པ་ཡོད་པ་དེའི་ཚེ་རྒྱུའི་ཤེས་པ་མེད་པས།",
    "འོན་ཏེ་སྔ་མ་ཉིད་དུ་རྗེས་སུ་དཔག་པས་ཤེས་ཤིང་རང་གི་ངོ་བོ་ཉིད་ནི་རང་རིག་པས་ཤེས་སོ་ཞེ་ན།",
    "རི་བོང་གི་རྭ་ལ་ཡང་རྒྱུ་ཡོད་པར་འགྱུར་རོ།",
    "རི་བོང་གི་རྭ་མེད་ལ་སྔ་ན་མེད་པ་མེད་པའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོ་ཉིད་ལས་ཡིན་གྲང་།",
    "འོན་ཏེ་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་བྱེད་པ་ཡིན་ན།",
    "དེའི་ཚེ་འབྲས་བུ་ཡང་རང་གི་ངོ་བོས་རྒྱུར་འགྱུར་བས་བྱེད་པ་གཞན་བརྟགས་ཏེ་ཅི་ཞིག་བྱ།",
    "འདི་ལྟར་རྒྱུ་འབྲས་ཀྱི་དངོས་པོ་རྗེས་སུ་འགྲོ་ལྡོག་དག་གིས་རྟོགས་པ་སྟེ།",
    "འོན་ཏེ་དུས་གཞན་དུ་དེ་ཉིད་ལས་འབྱུང་གི་གཞན་ལས་མ་ཡིན་ཞེ་ན།",
    "དེའི་ཕྱིར་འདི་དག་ནི་འབྲས་བུ་འདི་དག་ནི་རྒྱུའོ་ཞེས་ཤེས་པ་འདི་ནི་བརྟགས་པ་ཙམ་མོ།",
    "གང་གི་ཕྱིར་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་རྟོགས་པ་མེད་ཅེས་བརྗོད་པ་མ་ཡིན་ནམ།",
    "མོས་པ་ཙམ་གྱིས་ཐ་སྙད་གྲུབ་སྟེ།",
    "ཀུན་རྫོབ་ཅེས་བྱ་བ་ནི་ལོག་པའི་ཤེས་པ་ལ་སྣང་བ་ཙམ་ལྷག་པར་མོས་པའི་རང་བཞིན་ཏེ།",
    "དེས་ན་ཐོག་མ་མེད་པའི་བག་ཆགས་ལས་སྐྱེས་པ་སྣང་བ་ཉིད་འབའ་ཞིག་ཙམ་མོ།",
    "དེའི་ཕྱིར་ནང་གི་ནུས་པ་ཡོད་ཀྱི།",
    "རིང་དུ་ཞིག་པ་ཡང་སྐྱེ་བར་ཐལ་བར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གང་སྨྲས་པ་དེ་ཐམས་ཅད་སྐབས་བཞིན་དུ་དགག་པར་བྱའོ།",
    "འདིར་རང་ལས་རང་གི་ངོ་བོ་རྟོགས་ཞེས་བྱ་བར་བསྟན་ཏོ།",
    "གལ་ཏེ་ཤེས་པ་ལས་སྔར་དོན་ཡོད་པར་མི་རྟོགས་པ་དེ་ལྟ་ན་ཡང་མིག་གི་རྣམ་པར་ཤེས་པ་མེད་པར་མཐོང་བའི་ཕྱིར།",
    "མིག་གི་ཤེས་པ་ནི་དེ་ལྟར་ཐམས་ཅད་དུ་སྐྱེ་བ་མ་ཡིན་པ་དེ་བས་ན་དོན་ཡོད་པར་རྟོགས་པར་རིགས་སོ།",
    "ནང་གི་རྒྱུ་ཙམ་ལས་ཡོད་པའི་ཕྱིར་རོ།",
    "དེ་ནི་བ་ལང་ཉིད་མེད་པར་རྟ་ལས་བ་ལང་གི་བློ་མེད་དོ་ཞེས་བྱ་བ་ནི་མི་རུང་སྟེ།",
    "འོན་ཏེ་བ་ལང་གི་རྟོགས་པའི་རྒྱུ་བག་ཆགས་སད་པའི་ནུས་པ་མེད་པའི་ཕྱིར།",
    "རྟ་ལ་བ་ལང་གི་བློ་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་གིས་སྤྱི་ཡོད་པ་དང་མེད་པར་འཇལ་བ་དེས་མཚུངས་པ་ཉིད་ཀྱི་རྣམ་པར་ཤེས་པ་གཅིག་པུ་སྤྱི་ཡིན་གྱི།",
    "འོན་ཏེ་རབ་རིབ་ཀྱིས་ཉམས་པ་ལས་སྐྲ་ཤད་མེད་ཀྱང་མིག་གིས་མཐོང་བ་ཡིན་ནོ་ཞེ་ན།",
    "འོ་ན་ནི་སྤྱི་ཡང་ཕྱིན་ཅི་ལོག་གི་འདུ་བྱེད་པ་ལ་སད་པ་ལ་སྣང་བའི་ཕྱིར་མེད་པར་འགྱུར་རོ།",
    "ནང་གི་ཡན་ལག་ངོར་འཇུག་ཕྱིར།",
    "དེ་དག་གི་བློ་གང་ཡིན་པ་ནི་བློ་སྟེ།",
    "བརྡ་ལ་རྩོལ་བ་ཉིད་ནང་གི་རྒྱུ་སྟེ།",
    "གཟུགས་དང་རེག་བྱ་དམིགས་ན་ཡང་ཐོག་མ་མེད་པའི་བག་ཆགས་ཀྱི་སྟོབས་ཀྱིས་དུས་ཕྱིས་གཅིག་པ་ཉིད་དུ་ལྷག་པར་ཞེན་ནས་བུམ་པའོ་སྙམ་པའི་ཤེས་པ་སྐྱེའོ།",
    "ཅི་སྟེ་མིག་གིས་རྟོགས་པའི་ཡན་ལག་ཅན་གྱི་རྫས་གང་ཡིན་པ་དེ་ཉིད་རེག་པས་ཀྱང་རྟོགས་པ་སྟེ།",
    "མཐོང་བ་དང་རེག་པའི་སྒོ་ནས་རྫས་གཉིས་སོ་ཞེ་ན།",
    "མིག་གི་ཤེས་པས་གཉིས་སུ་རྟོགས་པ་ནི་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་བུམ་པ་དང་སྣམ་བུའི་དངོས་པོའི་དམར་པོ་ཉིད་རྟོགས་པ་དང་།",
    "ཇི་ལྟར་གང་ན་གཟུགས་ཡོད་པ་དེ་ཉིད་ན་རེག་པ་ཡོད་པར་རྟོགས་ཤེ་ན།",
    "དཔེར་ན་དཔུང་གི་ཚོགས་ལ་གང་ན་རྒྱལ་པོ་བཞུགས་པ་དེ་ཉིད་དུ་སྐྱེས་བུ་ལ་སོགས་པ་རྣམས་ཡོད་པར་ཐ་སྙད་དུ་གྲགས་ཀྱི།",
    "དེའི་ཕྱིར་གཟུགས་དང་རེག་བྱ་དག་ཚོགས་པ་གཅིག་ལ་རག་ལས་པས་མི་འཁྲུལ་པ་ཡིན་གྱི།",
    "ཐལ་བའི་ཉེས་པ་ཡོད་མ་ཡིན།",
    "དོན་ཉིད་སྤྱིའི་རང་བཞིན་གྱིས་རང་གི་མཚན་ཉིད་ཀྱི་བདག་ཉིད་ཤེས་པ་ནི་སྤྱིའོ།",
    "གལ་ཏེ་རང་གི་མཚན་ཉིད་ཡིན་ན་དེའི་ཚེ་དོན་བྱ་བ་བྱེད་པའི་ཕྱིར་ཇི་ལྟར་སྤྱི་ཡིན་ཏེ།",
    "རང་གི་མཚན་ཉིད་མངོན་སུམ་དུ་དོན་བྱེད་ནུས་པ་ཡིན་ལ།",
    "སྤྱི་མེད་པའི་སྐྱོན་དུ་ཐལ་བ་མེད་དེ།",
    "སྐྲ་ཤད་ལ་སོགས་པ་དེ་ནི་རང་གི་མཚན་ཉིད་ཁོ་ནའོ།",
    "གསལ་བ་ཉིད་ཀྱིས་དོན་ཉིད་ཡིན་པས་རང་གི་མཚན་ཉིད་སྣང་བ་ཡིན་ན་ཇི་ལྟར་སྐྲ་ཤད་ལ་སོགས་པ་དོན་མེད་པ་ཡིན།",
    "གལ་ཏེ་དེ་ལྟར་ན་རང་རིག་པ་རང་གི་མཚན་ཉིད་ཀྱི་ཡུལ་ཅན་དང་རྟོག་པ་དང་བཅས་པའི་ཤེས་པ་སྤྱིའི་ཡུལ་ཅན་ཡིན་ན།",
    "དོན་དུ་ཐལ་བར་འགྱུར་ཞེ་ན།",
    "སྤྱི་ཡང་དོན་གྱི་ངོ་བོ་ཉིད་དང་གསལ་བའི་ངོ་བོ་ཉིད་དུ་ཐལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "རང་གི་མཚན་ཉིད་ཀྱང་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་དང་གསལ་བ་ཡིན་ནོ།",
    "ཁྲ་བོ་དང་ནག་པོ་ལ་སོགས་པ་ཐམས་ཅད་ལ་བ་ལང་གི་རྣམ་པ་མཚུངས་པའི་ངོ་བོ་ཉིད་སྣང་བར་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་གཟུགས་ལ་སོགས་པ་ཉིད་ཁྱད་པར་མེད་པ་ནི་སྤྱི་སྟེ་རྗེས་སུ་དཔག་པའི་ཡུལ་མ་ཡིན་ནམ།",
    "འདི་ལྟར་གདོན་མི་ཟ་བར་རང་གི་མཚན་ཉིད་རྗེས་སུ་དཔག་པའི་ཡུལ་ཡིན་ཏེ།",
    "ཇི་ལྟར་གང་ཚེ་རྗེས་སུ་དཔག་པས་རྣམ་པ་ཙམ་ཡུལ་དུ་བྱེད་ན་དེའི་ཚེ་རང་གི་མཚན་ཉིད་མི་ཤེས་པས་འཇུག་པར་མི་འགྱུར་ལ།",
    "གང་གིས་ན་འབྲས་བུ་མེད་པས་སྐྱེ་བ་མེད་པ་ཡིན་ཞེ་ན།",
    "གང་གི་ཚེ་ན་སྨྲ་བ་པོ་དང་འབྲེལ་པ་ཡིན་ནམ།",
    "རང་གི་ངོ་བོ་ཉིད་སྣང་བ་ན་ཤེས་པ་དངོས་པོ་འཛིན་པ་ཡིན་གྱི་གཞན་དུ་ནི་མ་ཡིན་ནོ།",
    "འོན་ཀྱང་མིང་གི་ཚུལ་ལས་ཡིན་པས།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འོན་ཏེ་གང་གི་ཤེས་པའི་རྣམ་པ་ཉིད་སྒྲ་ལས་རྟོགས་ཀྱི།",
    "དོན་ལ་མི་རེག་པར་འདོད་པ་དེའི་ཡང་ཕྱི་རོལ་ལ་ཇི་ལྟར་འཇུག་པར་འགྱུར་ཞེ་ན།",
    "འདི་ལྟར་བག་ཆགས་སད་པ་ལས་བློ་སྐྱེ་བར་འགྱུར་བ་ནི་རང་གི་རྣམ་པ་ཉིད་ཁྱད་པར་ཅན་གྱི་ཡུལ་དུ་དོན་བྱ་བ་བྱེད་པར་སེམས་པས་སྐྱེ་བོ་འཇུག་པར་མཐོང་བའི་ཕྱིར་ཅུང་ཟད་ཀྱང་འགལ་བ་མེད་དོ།",
    "རང་གི་ངོ་བོ་ཉིད་དུ་འཛིན་པ་གཞན་གྱི་ངོ་བོ་ཉིད་དུ་རྟོགས་པའོ་ཞེས་བརྗོད་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "ཐལ་ཆེས་པའི་ཕྱིར་རོ།",
    "འོ་ན་ཇི་ལྟར་མིག་གི་ཤེས་པ་ལ་དེའི་བདག་ཉིད་དུ་གྱུར་པའི་སྔོན་པོ་ཉིད་སྣང་བ་ཡིན་གྱི།",
    "མིང་གི་རྣམ་པ་ཅན་ཤེས་པ་ལ་ཕན་འདོགས་པའི་མིང་ལ་སོགས་པ་གཞན་ཡོད་དོ་ཞེ་ན།",
    "རེས་འགའ་བའི་ཤེས་པས་དེའི་རྣམ་པ་ཅན་གྱི་ཤེས་པ་ལ་ཕན་འདོགས་པ་ཕྱི་རོལ་གྲུབ་པ་སྟེ།",
    "ཅུང་ཟད་ཀྱང་རང་གི་རྣམ་པ་ཅན་ནི་མ་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་འཁྲུལ་པ་ཡིན།",
    "དེས་ན་རྨི་ལམ་ལ་སོགས་པ་ན་ཡང་ཕྱིན་ཅི་ལོག་ཏུ་སྣང་གི།",
    "འདི་ཉིད་དྲན་པས་མོས་པ་སྟེ་དེ་ཡང་སྔར་བཟློག་ཟིན་ཏོ།",
    "རང་གིས་ཤེས་ཕྱིར་དེ་ཤེས་ཡིན།",
    "གལ་ཏེ་གཉིད་ཀྱི་སྟོབས་ཀྱིས་སྔོན་པོ་བདེན་པར་རྨི་ལམ་དུ་མཐོང་ན་ནི་དེ་ལྟ་ན་གཉིད་ལོག་པ་གཞན་དག་གིས་ཅིའི་ཕྱིར་མི་མཐོང་བ་ཡིན།",
    "གཟུང་བའི་ཚུལ་གྱིས་རིག་པ་ནི་མ་ཡིན་ཏེ་རང་གི་ངོ་བོ་ཉིད་དུ་འཛིན་པའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོ་ཉིད་ཀྱིས་སྔོན་པོ་ལ་སོགས་པ་དེ་མྱོང་བ་ཡིན་གྱི་གཟུང་བར་ནི་མ་ཡིན་ནོ།",
    "མིང་ལ་སོགས་པ་ཡང་གཞན་གྱིས་མི་ཤེས་པས་རང་གིས་མྱོང་བ་ཡིན་པ་དེ་བས་ན་སྒྲའི་སྟོབས་ལས་སྐྱེས་པ་ནི་ཤེས་པ་ཉིད་ཡིན་གྱི།",
    "འོན་ཏེ་དོན་གྱི་ནུས་པ་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་གིས་མཐོང་བ་སྟེ།",
    "འདི་ལྟར་སད་པ་ན་མཐོང་བའི་དོན་སྣང་བ་གང་ཡིན་པ་དེ་སྔར་གཞན་གྱིས་མཐོང་བ་དང་རང་གིས་ཀྱང་རྗེས་སུ་དཔག་པས་ཤེས་པ་དང་།",
    "ལོག་པར་སྣང་བར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཐལ་བར་མི་འདོད་ན།",
    "འོན་ཏེ་སྒྲའི་སྟོབས་ཀྱིས་སྤྱི་ཙམ་འཛིན་པར་འགྱུར་གྱི་སྒྲའི་ཡུལ་རང་གི་མཚན་ཉིད་ནི་མ་ཡིན་པ་དེ་བས་ན་སྤྱི་འཛིན་པའི་ཕྱིར།",
    "འདི་ལྟར་གལ་ཏེ་སྒྲས་རང་གི་མཚན་ཉིད་བརྗོད་པ་ན་དེའི་ཚེ་སྐྱོན་འདིར་འགྱུར་གྱི་སྤྱི་ཙམ་བརྗོད་བྱ་ཡིན་པ་ལ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "ཡང་ན་སྤྱི་ཡན་གར་བ་འཛིན་ན་གསལ་བ་དེ་དག་གི་སྤྱིར་མི་འགྱུར་ཞིང་གསལ་བའི་གསལ་བྱར་ཡང་མི་འགྱུར་ཏེ།",
    "གང་གིས་ཐམས་ཅད་དུ་སྣང་བར་འགྱུར་བའི་སྤྱི་རྟག་ཏུ་མཐོང་བ་ཡིན་ཞེ་ན།",
    "འོན་ཏེ་རེས་འགའ་ནུས་མེད་ན།",
