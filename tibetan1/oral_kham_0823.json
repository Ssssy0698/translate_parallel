    "ཡིན་ན་ཡང་ང་རང་དེ་དག་དང་མཉམ་དུ་བསྡད་དེ་ཤུགས་རྒྱག་རྒྱུ་ཞིག་མ་བྱུང་ཡང་།",
    "ཕྱོགས་གཞན་ཞིག་ནས་བསམ་བློ་གཏོང་དུས་གང་ལ་གང་འཚམས་གོ་ཆོད་ཡོད་བསམ་ནས་སྤྲོ་བ་འཕེལ་གྱི་འདུག་ཡིན་ནའང་གཙོ་ཆེ་ཤོས་བོད་ནང་རྒྱ་མིས་བཙན་འཛུལ་བྱས་པ་ནས་བཟུང་དུས་ད་ལྟ་བར་དུ་དངོས་གནས་གཏོར་བཤིག་དང་།",
    "ཁ་ཤས་ཀྱིས་ས་ཡ་ཉི་ཤུ་སླེབས་པ་བརྗོད་ཀྱི་འདུག་གང་ལྟར་ཡུལ་མི་ས་ཡ་གསུམ་ཡོད་སར་རྒྱ་མི་ས་ཡ་བཅོ་ལྔ་ལས་བརྒལ་བ་ཞིག་སླེབས་ཡོད།",
    "ང་རང་ལ་ཆ་བཞག་ན།",
    "དངོས་གནས་བྱས་ན་རྒྱ་མིའི་མི་འབོར་ཤིན་ཏུ་ཆེན་པོ་ཡོད་པས་ཁོ་རང་སྣུབ་སྐྱེ་སྒོ་མང་ཙམ་བཀགཚུར་ཕྱོགས་ང་ཆོ་རྭ་ད་པ་དང་།",
    "སོག་པོ་སོགས་དངོས་གནས་མི་གྲངས་ཉུང་ཉུང་ཡིན་པས་གནས་སྐབས་སྐྱེ་སྒོ་མ་བཀག་པར་བཞག་ན་འོས་པོ་འདུག་ཀྱང་།",
    "འོན་ཀྱང་ད་ལྟ་ཉུང་ཤས་ཡོད་པ་དེ་ཚོའི་གྲ་ས་ཀྱིས་བར་ལམ་བྲིས་པའི་རྩོམ་དེབ་འདྲ་མིན་མང་པོ་ཐོན་པ་དེ་ཚོར་ལྟ་དུས་དངོས་གནས་བསམ་བློ་མང་པོ་བཏང་སྟེ་ཧུར་ཐག་བྱས་འདུག་མངོན་གསལ་དོད་པོའི་སྐད་ཆ་ཤོད་ས་མེད་ཀྱང་།",
    "སོ་སོའི་མི་རིགས་ཀྱི་རིག་གཞུང་གཏིང་ཟབ་ཡོད་པ་འདིའི་རྣམ་པ་གཟེངས་སུ་ཐོན་པ་ཡོང་བའི་དོན་ལ་ཚང་མས་ཧུར་བསྐྱེད་བྱས་པར་ང་རང་དགའ་པོ་བྱུང་།",
    "ང་རང་མ་ཤི་བར་དུ་བོད་རྒྱ་ཆེའི་མི་མང་དང་།",
    "དེ་ལྟར་བྱས་ཏེ་ཉམས་མྱོང་རིམ་པས་གསོག་ཐུབ་པ་ཞིག་བྱུང་ན་ཡག་པོ་འདུག་གང་ལྟར་དངོས་ཡོད་གནས་ཚུལ་ལ་ང་རང་ལོ་ན་དྲུག་ཅུར་སླེབས་རྒྱུར་ཐག་ཉེ་ཞིང་།",
    "ཉེན་ཁ་མི་འདུག་གམ།",
    "ང་རང་མ་ཤི་གོང་ནས་དེའི་ཐད་རྒྱུས་མངའ་ཆ་ཚང་ཡོད་པ་ཞིག་དང་།",
    "ད་དུང་དེ་ལ་ས་ཕག་རྩིག་ཟེར་བའི་མིང་གསར་པ་ཞིག་ཀྱང་བཏགས་འདུག་མ་ཆང་བརྒྱབ་སྟེ་བསྡད་ན་ཡག་པོ་མེད།",
    "ལྟོ་གོས་ལ་འཐུས་ཤོར་འགྲོ་རྒྱུ་སྨོས་མེད་ཁར་ཕར་ཕྱོགས་རྒྱ་མི་ལའང་ངོ་ཚ་བ་མི་འདུག་གམ།",
    "ད་ལྟ་རྒྱ་མི་ཡོད་བཞིན་པའི་སྐབས་ལ་རྒྱ་མིས་འགྲིགས་ཀྱི་མི་འདུག་ཅེས་བརྗོད་དེ་སྐད་བརྒྱབ།",
    "དཔེར་ན་ང་རང་ལ་ཆ་བཞག་ན།",
    "ང་རང་ཅེས་མཉམ་དུ་བསྡད་ནས་མཉམ་ཟ་མཉམ་འཐུང་བྱས་ཏེ་བོད་པའི་ངོས་ནས་རྒྱ་ནག་ལ་ཁེ་ཕན་སྤྲོད་དགོས་པ་སྤྲད།",
    "ཡིན་ནའང་མི་ཁ་ཤས་ཀྱི་ངའི་གྲོས་འཆར་འདི་ཕྲན་བུ་རིན་ཐང་ཆུང་དྲགས་འདུག་ཅེས་བརྗོད་ཀྱི་ཡོད།",
    "སྔོན་མ་ལས་བསྡོམས་བྱས་པ་དེ་ནས་ད་ལྟ་བར་དུ་ལས་ཀ་མང་པོ་ཞིག་བྱས་དང་བྱེད་བཞིན་པ་རྣམས་ཡག་པོ་བྱུང་འདུག་འདི་གའི་ལས་ཀ་བྱེད་མཁན་ཚོ་དང་།",
    "དེ་ལས་སུད་ཀྲར་ཚོང་བར་ཕྱིན་པ་ཡིན་ན་དེས་སྐབས་འཕྲལ་དངུལ་ལམ་སེང་བཟོ་ཐུབ་ཀྱི་འདུག་བསམ།",
    "དེའི་ཐོག་ནས་སྒོར་བེད་གང་འདྲ་ཞིག་སྤྱད་དགོས་ཀྱི་འདུག་གམ།",
    "གཙོ་བོ་ལས་འབྲས་ཀྱི་འཕེན་ཤུགས་ཡིན་འགྲོ།",
    "ལྷག་པར་དུ་རྒྱ་མིའི་ལས་བྱེད་བོད་མིའི་ནང་ནས་བརྒྱ་ཆ་དགུ་བཅུ་གོ་དགུ་སོ་སོའི་མི་རིགས་ཀྱི་དོན་དག་བསམ་བསྡད་མཁན་ཡིན་པ་གསལ་པོ་འདུག་ཕྱི་ལ་བཅིངས་དཀྲོལ་དམག་མིའི་ཆས་གོས་གྱོན་པ་དང་།",
    "དེས་ན་ཚང་མས་དུས་རྒྱུན་ལྡན་ནས་སྤྱི་དོན་ལ་དོ་སྣང་བྱས་ནས་ཤེས་པ་བྱེད་རྒྱུ་གལ་ཆེན་པོ་འདུག་ལྷོད་ཡངས་བྱས་ན་མི་འགྲིགས།",
    "བོད་དེ་ཤོར་རྒྱུའི་ཉེན་ཁ་འདུག་བསམ་པའི་དངངས་སྐྲག་སླེབས་པར་བརྟེན་རྒྱ་མིས་ཚུདགས་གཅིག་ནས་བོད་ནང་རྒྱ་མི་ཕོན་ཆེ་གཏོང་བ་དང་།",
    "དེ་སྔ་ཡིན་ན་ང་རང་ལ་བསམ་འཆར་གསར་པ་ཞིག་བྱུང་ན།",
    "གནས་ཚུལ་དེ་ལ་གཞིགས་པའི་བསམ་བློ་གཏོང་རྒྱུ་གང་འདུག་གམ།",
    "སྡུག་སྐད་རྒྱག་མཁན་ཤ་སྟག་མ་གཏོགས་མི་འདུག་བོད་མི་མཐོ་རིམ་མི་སྣ་ནས་བཟུང་།",
    "ནན་ཙམ་བྱེད་དགོས་ཀྱི་འདུག་ལྷག་པར་འཁྲུག་རྩོད་ཀྱི་གནས་ཚུལ་བྱུང་བ་ཡིན་ན།",
    "གཤིས་ཀ་ལ་གཞིགས་ནས་སོ་སོ་སྐྱ་བོ་བྱས་ནས་བོད་སྤྱི་པ་ལ་ཕན་ཐོགས་ཆེ་བ་འདུག་ན།",
    "བྱེད་སྟངས་གང་དགའ་བ་འདུག་སྨིན་པོ་ཞིག་ཡོང་བ་བྱེད་དགོས།",
    "དཔེར་ན་འདི་འདྲ་དཔེ་མི་སྲིད་ཅེས་པ་དང་།",
    "ང་ཡིད་ཆེས་ཀྱི་མི་འདུག་ཟེར་བ་དང་།",
    "ཨའུ་འདི་ཡ་མཚན་ཞིག་འདུག་བསམ་པ་ཞིག་བློ་ལ་འཆར་རྒྱུ་དང་།",
    "འདི་འདྲ་ཞིག་ཡིན་འདུག་བསམ་པའི་ཚོད་དཔག་གང་འཚམས་བྱེད་ཐུབ་པ་ཞིག་ཡོད།་",
    "ང་རང་ལ་ཆ་བཞག་ན་སྟོན་པ་བཀའ་དྲིན་ཅན་གྱི་རྗེས་འབྲངས་ཀྱི་དགེ་སློང་ཕལ་པ་ཞིག་ཡིན་བསམ་པའི་བསམ་བློ་རྨི་ལམ་ཚུན་ཆད་ལ་བཏང་ནས་སྡོད་ཀྱི་ཡོད།",
    "ཕུ་ཐུང་གྱོན་མཁན་དེ་འདྲ་མང་པོ་ཞིག་འདུག་ཅེས་སྐད་བརྒྱབ་པ་མ་གཏོགས།",
    "ཕྱི་དྲོ་ར་བཟི་སྟེ་སྡོད་མཁན་དེ་འདྲ་འདུག་ཅེས་བརྗོད་ཀྱི་འདུག་དེ་ནི་དཔེ་མི་སྲིད་པའི་བློ་ཕམ་གྱི་གནས་ཚུལ་ཡིན།",
    "འདི་ལ་ཡིད་གཟབ་བྱ་རྒྱུ་ཤིན་ཏུ་གལ་ཆེན་པོ་འདུགདེ་ནས་མི་མང་སྤྱི་བྱིངས་ཡ་རབས་སྤྱོད་བཟང་དང་།",
    "བལ་ཡུལ་ནང་སྐུ་ཚོང་རྒྱག་མཁན་དེ་འདྲ་ཡོད་པ་ཐོས་ཀྱི་འདུག་རྒྱ་གར་ནང་དེ་འདྲ་ཡོད་མེད་མི་ཤེས།",
    "སྨད་ཕྱོགས་ཀྱི་ས་ཆ་ཁ་ཤས་ལ་དངོས་སུ་བཙུགས་འདུག་དེ་ཚོར་གོང་བཞིན་རྗེས་སུ་ཡི་རངས་དང་བསྔགས་བརྗོད་ཡོད།",
    "ཁྱེད་རང་དེར་རྒྱུགས་ཞེས་བཀོད་པ་བཏང་ནས་བྱུང་བ་མིན་ལ།",
    "བསམ་བློ་གུ་ཡངས་བཏང་འདུག་ཅེས་བསྔགས་བརྗོད་དང་རྒྱབ་སྐྱོར་བྱེད་མཁན་མང་པོ་བྱུང་།",
    "དེ་འདྲ་ཡིན་དུས་ང་རང་ངོས་ནས་ཆ་བཞག་ནའང་སྐལ་པ་བཟང་པོ་བྱུང་།",
    "ལྷ་ཡང་དམ་ཚིག་གཙང་མ་དགོས་པ་གལ་ཆེན་པོ་འདུག་བར་ལམ་ངས་སྲུ་ང་སྡུ།་",
    "གཅིག་བྱས་ན་བཤེས་གཉེན་བསྟེན་ཚུལ་གྱི་སྐད་ཆ་ཡིན་འགྲོ་སྟེ།",
    "མི་དེས་ཁ་ཡང་ཕྲན་བུ་གདངས་ནས་བསྡད་འདུག་གཅིག་བྱས་ན་འཁྲིས་ལ་སྡོད་མཁན་ཚོས་ཧར་ཧར་ཟེར་བ་གོ་མེད་དམ་བསམ་པ་བྱུང་།",
    "བྱ་སྤྱོད་འདི་ཚོ་ཡག་པོ་མི་འདུག་འདྲ་ཆགས་པོ་ཡང་མི་འདུགང་རང་༦༦་",
    "བག་མེད་བྱས་ནས་བསྡད་པ་ཡིན་ན་ཡག་པོ་མི་འདུགཅེས་བཀའ་༣༥༥།",
    "ལོ་སུམ་ཅུ་སོ་ལྔ་ལྷག་ཙམ་རིང་ག་དུསཡིན་ཡང་དབུས་གཙང་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་བཀའ་དང་མ་འགལ་བ་ཞིག་ངོ་ཐོག་བྱེད་ཀྱི་འདུག་གམ་མི་འདུག་བསམ་བློ་བཏང་བ་ཡིན་ན།",
    "དྭང་བ་འདྲེན་པ་གནང་རྒྱུ་དེ་ཧ་ཅང་གལ་ཆེན་པོ་འདུག་དེ་ཚོའི་གྲས་ཡག་པོ་མ་བྱུང་ན།",
    "ཧ་ཅང་ཡག་པོ་འདུག་ངེས་པར་དུ་བསམ་བློ་གཏོང་དགོས།",
    "དེ་སྔ་ཕན་ཆད་ལོ་མང་པོའི་ཉམས་མྱོང་བྱུང་བ་དེ་དག་གཞི་ལ་བཞག་ནས་ད་དུང་ཡར་རྒྱས་གང་འདྲ་གཏོང་དགོས་ཀྱི་འདུག་བསམ་བློ་གཏོང་དགོས།",
    "ཡང་ཚུརཕྱོགས་འདིར་སྤྱི་པའི་སྒྲིག་འཛུགས་ནང་ལ་ལས་ཀ་བྱེད་མཁན་ཚོས་ཀྱང་རང་ཉིད་ལ་འགན་ཆེན་པོ་ཞིག་ཡོད་བསམ་པའི་ཐོག་ནས་ཕོགས་ལེན་ཐུབ་ཙམ་དང་།",
    "དེ་ཡག་པོ་མི་འདུག་གཟབ་གཟབ་བྱེད་དགོས།"
  ]
}