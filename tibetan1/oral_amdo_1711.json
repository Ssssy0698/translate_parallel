    "ལང་ཚོ་ཡོལ་བའི་མཛའ་གྲོགས་རྒན་པོ་ཁྱོད།",
    "ལོ་མང་ཐལ་བའི་སྡོང་སྐམ་རྗེས་འགྲོ་སྟེ།",
    "དཔེའི་སྐབས་སུ་རྩི་ཤིང་གི་ཤིང་ལ་གོ་བ་ལྟ་བུའི་དཔེ་བརྗོད་འདི་གསུངས་སོ།",
    "ཁོང་གི་སྙན་འགྲེལ་ལས།",
    "ཟླ་བ་ཁྱོད་གདོང་མཚུངས་ཞེས་པ།",
    "བརྗོད་འདོད་བདག་གི་ཡིད་ལ་ཡོད།",
    "རང་ཅག་གི་ཁྲིད་བྱའི་གཞུང་དང་སྙན་ངག་སྤྱི་དོན་སོགས་སུ་དཔེ་དང་དཔེ་ཅན་གཉིས་མཚུངས་པར་སྦྱར་ན་སྐྱོན་ཡོན་ཅི་ཡོད་ཀྱང་ཞེས་འགྲེལ་ཡོད་ཀྱང་བདག་གིས་མཚན་ཉིད་བཞག་ཚེ་འདམ་ང་ཅན་དུ་བྱས་པས་གང་ཞིག་འགྲིག་མིན་དཔྱདབསྟན་པའི་སྒྲོན་མེའི་དཔེ་བརྗོད་དེ་སྔ་མའི་ལུགས་ལྟར་བྱས་འདུག་གོ།",
    "ཕུལ་བྱུང་གི་དཔེར་དེ་ལས་གཞན་པའི་མི་མཚུངས་ཚུལ་མེད་པ་འུད་ཆེན་པོས་བརྗོད་དགོས་པ་དང་།",
    "སྤྱིར་ཡིན་ན་དཔེ་དོན་དམན་ལྷག་ལྟ་བུར་འདུག་མོད།",
    "དཔེ་བརྗོད་གཞན་དང་གཞན་ནའང་དེ་ལྟར་བྲིས་པ་རེ་འདུག་མོད།",
    "ཟླ་བ་པདྨ་དག་གིས་ནི།",
    "མཛེས་པ་ལས་འདས་ཁྱོད་ཀྱི་གདོང་།",
    "ཞལ་འདི་ལས་ནི་རྩུབ་མོའི་ཚིག།",
    "ཕྱི་མར་སྲིད་མིན་གྱི་དཔེའམ་ཡང་ན་འབྱུང་མིན་གྱི་དཔེ་ཞེས་འབྱུང་དངོས་མི་སྲིད་པ་ཞིག་ལ་སྦྱོར་དགོས་ཕྱིར་རྣམ་དབྱེ་ལྔ་བའི་ཕྲད་ཅིག་ཀྱང་ངེས་པར་ཐོན་དགོས་པར་གསུངས་མོད།",
    "སྐ་རགས་ལ་སོགས་པའི་ཁྱད་པར་ཐ་དད་པ་ལྟར་འདིར་ཡང་རྣམ་འགྱུར་གྱི་གནས་སྐབས་མི་མོའི་གདོང་གི་རྣམ་པར་སྣང་བ་མ་གཏོགས་ངོ་བོ་དཔེ་ཟླ་བ་དང་པད་མ་དག་ཡིན་པར་བརྗོད་པའི་ཚིག་སྦྱོར་རོ།",
    "སྤྱིར་སྙན་ངག་གི་རྒྱན་གང་ཡིན་ཡང་ངག་དོན་དུ་མ་གྲུབ་པ་ཞིག་མེད་དེ།",
    "ལྔ་བ་བཅས་ཀྱི་ཕྲད་སོགས་གང་རུང་རེ་ངེས་པར་ཚིག་ཟིན་ལ་ཐོན་དགོས་ཕྱིར།",
    "མཚུངས་སྦྱོར་གྱི་དཔེ་དཔེ་དོན་གཉིས་བྱ་བའི་ཆོ་ག་རིགས་གཅིག་ཏུ་བསྡུས་ཏེ་མཚུངས་པ་ཤུགས་ལས་རྟོགས་དགོས་ཕྱིར་དཔེ་དོན་དམན་ལྷག་གི་ཁྱད་པར་ཚིག་ཟིན་ལ་དངོས་སུ་མི་བརྗོད་ལ།",
    "མཚུངས་གསལ་གྱི་སྒྲ་རྣམས་དཔེ་རྒྱན་གྱི་མཇུག་ཏུ་བཀོད་འདུག་མོད།",
    "བོད་མཁས་སོགས་ཀྱིས་རྩ་བས་དངོས་བསྟན་རེ་ལྔར་འདོད་དོ།",
    "འདི་ནི་ལྷུག་པ་དག་གི་གསོས།",
    "གསུངས་པ་ལྟར་སྙན་ངག་གི་ཚིགས་བཅད་ལྷུག་སྐབས་གང་ཡིན་ཡང་ཚིག་སྡུད་བྱེད་ཚུལ་ལ་མཁས་དགོས་པ་རྩ་བའི་ཆ་རྐྱེན་ཡིན་ལ།",
    "དེ་ལྟ་བུའི་ཚིག་སྡུད་ལ་རྒྱ་གར་དུ་དབྱེ་བ་དྲུག་གསུངས་པའི་ནང་གི་འབྲུ་མང་བོའི་ཚིག་སྡུད་ནི་དོན་གཞན་སྟོན་བྱེད་ཀྱི་བསྡུ་བ་ཡིན་ཡང་།",
    "ཚུལ་འདི་དཔེ་དོན་མཚུངས་པར་སྦྱོར་ཆེད་ཡིན་ལ་འོག་གི་གཟུགས་རྒྱན་དང་མི་ནོར་བའི་ཁྱད་པར་འབྱེད་བྱེད་ཀྱང་ཡིན་ནོ།",
    "གསུམ་པ་གཟུགས་རྒྱན། དོན་རྒྱན་གསུམ་པ་གཟུགས་རྒྱན་ནི་འུད་ཀྱིས་བརྗོད་པ་ཐལ་མི་ཆེ་ལ་སྙན་ངག་གི་ཉམས་ཕུན་སུན་ཚོགས་པ་དང་ལྡན་པའི་རྒྱན་ཞིག་སྟེ།",
    "རྩོམ་པ་བོ་གང་ཡིན་ཡང་རང་རང་ལ་ཐུན་མིན་གཤིས་ཀ་དང་ཁྱད་འཕགས་ཀྱི་རྩོམ་གཤིས་རེ་ཡོད་དེ།",
    "ཁྱོད་ནི་རྣམ་དཔྱོད་ལུས་མཛེས་ཤིང་།",
    "འོན་ཀྱང་སྔོན་སོང་དཔེ་རྒྱན་སོ་གཉིས་དང་གཏན་ནས་མི་འདྲ་སྟེ།",
    "གོང་དུ་སོང་ཟིན་པའི་འབྲུ་མང་བོའི་ཚིག་སྡུད་སྐབས་དཔེ་དོན་གཉིས་ཀྱི་མཚུངས་སྒྲ་བསྡུ་ཕྱིར་དཔེ་སྔོན་དང་དཔེ་ཅན་མཇུག་ལ་སྦྱོར་དགོས་པས་ནོར་དོགས་མེད།",
    "མིག་གི་ཨུཏྤལ་སྔོན་པོ་ཅན།",
    "ཁྱོད་ཀྱི་གདོང་གིས་སྐྱེ་བོ་ནི།",
    "ཁྱོད་གདོང་མཆུ་ཡི་ཡལ་འདབ་གཡོ་ལྟ་བུའི་བྱེད་ལས་ཀྱི་ཚིག་དང་ལྡན་དགོས་ཤིང་།",
    "མིག་གི་ཨུད་པལ་སྔོན་པོ་ཅན།",
    "བོད་མཁས་སོགས་མཁས་པ་ཁ་ཅིག་གིས།",
    "རྩ་བའི་ཡན་ལག་གཟུགས་ཅན་གྱི་དཔེ་བརྗོད་དུ་གསལ་བའི་མཛེས་མའི་མིག་ཀྱང་ངོ་གདོང་གི་ཆ་ཤས་ཙམ་ལས།",
    "ཁོང་གིས་བཞེད་པའི་ཡན་ལག་དངོས་མ་ཡིན་པའི་ཕྱིར་རོ། འཇམ་གྲགས་ཀྱིས་བསྟན་པའི་སྒྲོན་མེའི་དཔེ་བརྗོད་འགྲེལ་སྐབས།",
    "བསྟན་པའི་སྒྲོན་མེའི་དཔེ་བརྗོད་ཀྱི་བདེ་ལྡན་ཞིང་གི་གཙོ་ཞེས་པས་བདག་པོའམ་ལྡན་པའི་རྐྱེན་གསལ་བོར་གོ་ནུས་པ་ཡིན་ནོ། གཟུགས་རྒྱན་བརྒྱད་པ་དང་དགུ་བར་འོས་པའི་གཟུགས་ཅན་དང་མི་འོས་པའི་གཟུགས་ཅན་ནམ།",
    "བོད་མཁས་དང་ལྔ་བ་ཆེན་མོ་སོགས་ཀྱིས་དེ་ལྟར་མི་བཞེད་པས་འདིར་ཡང་དེ་ལྟར་རོ། བཅུ་བ་མི་མཉམ་པའི་གཟུགས་ཅན་ལ་གཞུང་འགའ་རེར་བརྟེན་པ་མི་མཉམ་པའི་གཟུགས་ཅན་ཡང་ཟེར།",
    "འགའ་རེ་གཏན་ནས་གཟུགས་སུ་མ་བཀོད་པར་མཐོ་དམན་གྱི་ཚུལ་དུ་བཀོད་པ་ནི་བཅུ་བ་དང་།",
    "ཞེས་གསུངས་མོད།",
    "དཔེ་ཅན་རང་གི་ཁྱད་གཞི་གཙོ་བོ་གཅིག་པོ་དེ་ལ་འབྲེལ་དགོས་ཤིང་།",
    "དཔེ་ལ་དངོས་པོ་གཅིག་གི་སྟེང་དུ་འབྲེལ་དགོས་པའི་ངེས་པ་མེད།",
    "གྲོགས་མོ་ཁྱོད་ཀྱི་གདོང་པད་ནི།",
    "ཞེས་དཔེ་ཅན་བུད་མེད་མཛེས་མའི་གདོང་པདྨའི་གཟུགས་སུ་དཀོད།",
    "དཔེའི་གཟུགས་ཅན་སྐབས་ཐོག་མར་དཔེ་ཅན་དེ་ཉིད་དཔེ་གང་རུང་གི་གཟུགས་སུ་བཀོད་རྗེས།",
    "དེ་བཞིན་དུ་བསྟན་པའི་སྒྲོན་མེའི་དཔེ་བརྗོད་ཀྱང་གཟུགས་རྒྱན་དུ་མི་འགྲོ་བར་སྨྲ་མཁན་འདུག་མོད།",
    "སྒྲ་མི་དགོས་སོ། སྙན་ངག་ལ་མཁྱེན་པའི་བློ་མིག་ཡངས་ཤིང་མོས་པ་ཆེ་བ་རྣམས་ཀྱིས་ལེགས་པར་དཔྱད་ན་འཇིག་རྟེན་ཁམས་ཀྱི་བརྗོད་བྱ་ལ་མཐའ་མེད་པ་བཞིན་དུ་རྩ་བར་མ་བསྟན་པའི་གཟུགས་རྒྱན་ཡང་མཐའ་མེད་པ་འབྱུང་སྟེ།",
    "རྫས་བརྗོད་པ་བར་གྱི་གསལ་བྱེད་གཉིས་བསྣན་པས་ཁྱོན་དབྱེ་བ་བཅུ་བཞི་ཡོད་དོ།",
    "པའི་ཚིག་གི་ཉམས།",
    "རང་བཞིན་བརྗོད་པ་ལ་ལྟོས་ན་ཅུང་ཟད་འཁྱོག་པའི་རྒྱན་གྱི་ཕྱོགས་སུ་གཏོགས་པ་ཞིག་ཡིན།",
    "གསལ་བྱེད་ཀྱི་ཚིག་གཅིག་གིས་ཤོ་ལོ་ཀ་གཅིག་པོའི་བརྗོད་དོན་གསལ་ཐུབ་པ་ཞིག་ངེས་པར་དུ་དགོས་སོ།",
    "མཇུག་ཏུ་གནས་ཞེས་པའི་གསལ་བྱེད་ཀྱི་ཚིག་གཅིག་གིས་གསལ་བར་བྱས་ཡོད་པ་ལྟ་བུའོ། རྩ་བར།",
    "ཞེས་སོགས་གསུངས་པ་ལྟར་གསལ་བྱེད་ཀྱི་རྒྱན་ཡང་རང་གི་རྣམ་དཔྱོད་ཀྱི་རྩལ་ལ་བརྟེན་ཏེ་མང་དུ་དབྱེ་ཆོག་པས།",
    "ཞེས་པ་ལས་འཕྲོས་ཏེ་བོད་མཁས་དང་འབྲུག་ཁམས་སྤྲུལ་སོགས་མང་བོ་ཞིག་གིས།",
    "ཀུ་ཊ་ཛོངྒནི་དུག་མོ་ཉུང་གི་ཤིང་།",
    "དོན་དུག་མོ་ཉུང་གི་ཤིང་ཡིན་པས།",
    "དུག་མོ་ཉུང་གི་ཤིང་ཞེས་པ་ནི་ཤིང་གཞན་ལ་འཁྲིས་ནས་སྐྱེ་ཞིང་མེ་ཏོག་སེར་ཆུང་།",
    "དྲུག་པ་འགོག་པའི་རྒྱན། དོན་གང་རུང་ཞིག་སྒྲུབ་པར་ཐབས་སམ་རྣམ་གྲངས་གང་རུང་གི་སྒོ་ནས་དངོས་ཤུགས་ཅི་རིགས་སུ་འགོག་པར་བྱེད་པ་དེ་ནི་འགོག་རྒྱན་གྱི་ངོ་བོ་ཡིན་ལ།",
    "ཁོང་གི་དྲི་ཚིག་དབྱངས་ཅན་མགྲིན་བརྒྱའི་ང་རོར་ཡང་།",
    "རིན་སྤུངས་པ་དང་ལྔ་བ་ཆེན་མོ།",
    "བོད་མཁས་པ་སོགས་མཁས་པ་ཕལ་མོ་ཆེས།",
    "ལྔ་བ་ཆེན་མོ་སོགས་ཀྱི་བཞེད་ཚུལ་འདི་ཤོང་དཔང་རྣམ་གཉིས་ཀྱི་དགོངས་པར་གནས་སོ་ཚངས་སྲས་བཞད་སྒྲར་བསྔགས་བརྗོད་ཀྱི་མེ་ཏོག་འཐོར་བའང་ཆེས་ཆེར་དོན་ལ་གནས་པར་སེམས་སོ། འགོག་རྒྱན་གཉིས་པར་མངོན་གྱུར་རམ་ད་ལྟ་བ་འགོག་པའང་ཟེར་ཏེ།",
    "མིག་གིས་མཐོང་བཞིན་པ་དང་རྣ་བས་ཐོས་བཞིན་པ་ལྟ་བུའི་བྱ་བ་མངོན་གྱུར་བ་ཞིག་འགོག་པས་སོ།",
    "ད་ལྟའི་བྱེད་སྟངས་སོགས་ལ་བལྟས་ན་མ་འོངས་པར་འབྱུང་འགྱུར་རམ་འབྱུང་ངེས་ཀྱི་དོན་ཞིག་འགོག་པས་སོ། མ་གུས་པ་དང་རྗེས་གནང་གིས་འགོག་པ་གཉིས་ལ་དགག་ཚིག་དངོས་སུ་མ་སྨྲས་ཀྱང་།",
    "རྗེས་གནང་གི་སྐབས་དོན་གྱིས་ཐབས་གཞན་གྱི་སྒོ་ནས་བཀག་ཡོད་པ་དང་།",
    "ཁྱོད་ཉིད་བགྲོད་པས་བདག་ལ་ནི།",
    "འདི་ལ་ཁྱོད་ནི་དོགས་མི་འཚལ།",
    "བདག་ནི་གསོན་རེ་སྟོབས་དང་ལྡན།",
    "རང་གི་གནས་སྐབས་སྨྲས་པ་ལགས།",
    "ཞེས་བྱ་བ་དེ་བསྒྲུབ་པར་མ་གུས་པའི་ཚུལ་འཆི་བ་ལ་མི་དགའ་བའི་ཚིག་ཉམས་ཀྱིས་བཀག་ཡོད་པ་ལྟ་བུའོ། རྩུབ་མོས་འགོག་པ་དང་ཁྲོ་བས་འགོག་པ་གཉིས་གང་ཡིན་ཡང་བྱ་བ་དེ་འདྲ་ཞིག་བསྒྲུབ་པར་མི་འཐད་པའི་ཚིག་བཙན་པོ་དང་ངན་པ་ཞིག་བརྗོད་པའི་ཆ་ནས་འདྲ་ཙམ་ཡོད་ཀྱང་།",
    "རྩུབ་མོའི་སྐབས་བྱ་བ་དེ་འགོག་ཕྱིར་ཚིག་རྩུབ་མོ་དང་ཆོད་ཅན་སྨྲས་པ་ཙམ་ལས་ཁོང་ནས་ཁྲོ་བ་མིན་ལ།",
    "གཤེད་མའི་ཕྱོགས་ཀྱིས་བལྟས་ན་ནི་ང་རྒྱལ་ལམ་དྲེགས་པས་འགོག་པའོ་གསུངས་པ་སྐབས་དོན་དང་མ་འབྲེལ་སྙམ་མོ། མྱ་ངན་གྱིས་འགོག་པ་དང་འགྱོད་པས་འགོག་པ་གཉིས་གདུང་སེམས་དང་སྐྱོ་བའི་རྣམ་པས་བྱ་བ་དེ་འགོག་པ་ལ་འདྲ་ཙམ་ཡོད་ཀྱང་།",
    "མྱ་ངན་གྱི་ཚིག་དང་འགྱོད་པའི་ཚིག་གིས་ཁྱད་པར་འབྱེད་དགོས་པ་ཚངས་སྲས་བཞད་སྒྲར་གསུངས་ལ།",
    "གསུངས་པ་ལྟར་རྩ་བས་དངོས་བསྟན་མ་ཡིན་པའི་ཕྱིན་ཅི་ལོག་གི་འགོག་པ་དང་།",
    "བདུན་པ་དོན་གཞན་བཀོད་པའི་རྒྱན། དོན་གཞན་བཀོད་པའི་རྒྱན་ནི་སྐད་ཆའི་སྒྱུ་རྩལ་དང་ཚིག་གི་ནུས་པ་ཆེས་ཆེར་ཐོན་པའི་རྒྱན་ཞིག་སྟེ།",
    "ཐམས་ཅད་མནན་ཡང་ཁྱོད་ཀྱིས་ནི།",
    "མཁས་པ་མང་བོ་ཞིག་གིས་ཀྱང་ལུགས་དེ་མཆོག་ཏུ་འཛིན་ཡང་།",
    "སྤྱིར་རྒྱུན་རིང་གི་བྱ་བ་ཞིག་དུས་ཐུང་ངུའི་ཡུན་ལ་བསྒྲུབ་མི་ཐུབ་ཀྱང་སྐབས་འདིར་བསྒྲུབ་ཐུབ་པས་མི་འགལ་བར་བརྗོད་པ་ལྟ་བུའོ།",
    "ཞེས་སྒྲ་སྦྱར་ཞིག་བྱུང་མོད།",
    "གོང་གི་སྦྱར་བ་ཡིན་ན།",
    "ལུས་ཅན་འགའ་ཞིག་གི་ངོར་འོས་སོ་ཞེས་སྒྲུབ་བྱེད་ཅིག་འགོད་དགོས་པས།",
    "བཞི་བར་གཅིག་སྟེ་ཁྱོན་རྩ་བས་དངོས་བསྟན་གྱི་ལྡོག་པ་ཅན་བཅུ་ཡོད་དོ། རྒྱན་འདིར་དཔེ་དོན་གཉིས་ངེས་པར་དུ་དགོས་པས་ཁ་ཅིག་གིས་དཔེ་རྒྱན་ལས་ལོགས་སུ་མེད་དོ་ཞེ་ན།",
    "དཔེ་དོན་གཉིས་ཡོད་པ་ཙམ་གྱིས་དཔེ་རྒྱན་དུ་འགྱུར་ན་གཟུགས་རྒྱན་དང་དོན་གཞན་བཀོད་པའི་རྒྱན་སོགས་མང་བོ་ཞིག་དཔེ་རྒྱན་དུ་ཐལ་བས་མི་འཐད་ལ།",
    "དབྱངས་ཅན་ལྷ་མོའི་ཞལ་དང་སྟོན་ཀའི་ཟླ།",
    "ཁྱོད་ཀྱི་གདོང་དང་པདྨ་སྟེ།",
    "ཁྱོད་གདོང་ཁྱོད་ལ་བརྟེན་པའོ།",
    "ཞེས་གནས་སའམ་རྟེན་སའི་ཁྱད་པར་གྱིས་མི་མཚུངས་པར་བརྗོད་པ་གཙོ་བོ་ཡིན་ལ་དཔེ་ཡང་གཅིག་གིས་ཆོག་གོ།",
    "ཕུལ་བྱུང་གི་དཔེ་དང་རྟེན་ལྡོག་གཉིས་ཀྱི་ཁྱད་པར་ཚངས་སྲས་བཞད་སྒྲ་ལས།",
    "ཕུལ་བྱུང་གི་དཔེ་ལ་དཔེ་དང་དཔེ་ཅན་གཉིས་གང་དུ་མཐོང་བའི་གནས་ཐ་དད་པ་ཙམ་མ་གཏོགས་སྒོ་ཀུན་ནས་མཚུངས་ཞེས་དཔེ་དོན་ཕན་ཚུན་མཚུངས་པ་གཙོ་བོར་སྟོན་པ་དང་།",
    "ལང་ཚོ་ལས་བྱུང་ན་ཆུང་གི།",
    "ཅེས་འདོད་ལྡན་གྱི་སྐྱེ་བོ་ཞིག་མཛེས་མའི་ལང་ཚོའི་མཛེས་སྡུག་གིས་མྱོས་ཏེ་རྨོངས་པའི་མུན་པར་གྱུར་བ་དང་སྤྱིའི་མུན་པ་གཉིས་མུན་པའི་རང་བཞིན་དུ་གྱུར་བ་སྟེ་བྱེད་ལས་ཀྱི་སྒོ་ནས་རིགས་སུ་མཐུན་ཀྱང་།",
    "དཔེ་རྒྱན་སྐྱོན་གྱིས་རེག་མིན་དེ་བས་ན།",
    "འོན་ཀྱང་བོད་མཁས་དང་ལྔ་བ་ཆེན་མོ་སོགས་མཁས་པ་ཕལ་མོ་ཆེས་རྒྱན་ཐ་དད་པ་གསུམ་དུ་འདོད་པ་ནི་ཤིན་དུ་ལེགས་ཏེ།",
    "རྒྱན་རང་རང་གི་ནང་གསེས་ཀྱི་བརྗོད་བྱའི་སྒོ་ནས།",
    "དེས་ན་སྲིད་རྒྱན་གསུམ་ག་འབྲས་བུ་རང་གི་ངོ་བོ་ལ་སྦྱར་དགོས་པའི་ཆ་ནས་འདྲ་ཡང་།",
    "བཅུ་བ་བསྡུས་བརྗོད་ཀྱི་རྒྱན། བསྡུས་བརྗོད་ཀྱི་རྒྱན་དང་གབ་ཚིག་གི་རྒྱན།",
    "སྦྱར་བའི་རྒྱན་འགའ་རེ་བཅས་ནི་རྩོམ་པ་བོས་གང་བརྗོད་པར་འདོད་པའི་བརྗོད་དོན་དངོས་ཐད་ཀར་མི་སྟོན་པར།",
    "ཀུ་རེ་དང་རྩེད་མཚར་བཅས་ལ་བཀོལ་ན་ཤིན་ཏུ་འཚམ་པ་ཞིག་གོ། བསྡུས་བརྗོད་ཀྱི་རྒྱན་ལ་ཡུལ་དབུས་འགྱུར་གྱི་མཁས་པ་རྣམས་ཀྱིས་སྒྲ་ཙམ་གྱི་རྒྱན་ཡང་ཟེར་ཞེས་རིན་སྤུངས་སྙན་འགྲེལ་དུ་གསུངས་སོ།",
    "བསྡུས་བརྗོད་ཀྱི་རྒྱན་དང་གབ་ཚིག་གི་རྒྱན་གཉིས་ཀ་བརྗོད་བྱ་གབ་པ་སྟེ་སྦས་པའི་ཆ་ནས་འདྲ་ཙམ་ཡོད་ཀྱང་།",
    "གབ་ཚིག་གི་རྒྱན་ལ་དཔེ་ཅན་ལས་གཞན་པའི་དཔེ་ཞིག་འགོད་དགོས་པའི་ངེས་པ་མེད་ལ།",
    "བཅུ་གཅིག་པ་ཕུལ་བྱུང་གི་རྒྱན། རྩ་བར།",
    "དཔེ་རྒྱན་སོགས་རྒྱན་གཞན་ལའང་ཕུལ་བྱུང་གི་ཉམས་འདྲེས་ན་ཆེས་མཛེས་པར་འགྱུར་ཚུལ་གསུངས་པ་ལྟར་ཕུལ་བྱུང་གི་རྒྱན་འདི་ནི་འཇིག་རྟེན་ན་གྲགས་པའི་གནས་ཚུལ་གྱི་མཚམས་ལས་བརྒལ་བའི་འུད་ཉམས་ཆེན་པོས་བརྗོད་དོན་དེ་ཉིད་ཆེས་ཕུལ་དུ་བྱུང་བར་བརྗོད་དགོས་པས།",
    "རང་བཞིན་གྱི་རྒྱན་ཇི་ལྟ་བ་བཞིན་གྱི་དངོས་པོའི་ངོ་བོ་བརྗོད་པར་ཡང་ཁྱད་པར་བརྗོད་པའི་སྒོ་ནས་ཕུལ་བྱུང་གི་རྒྱན་དང་ལྡན་ན་མཛེས་ཀྱི།",
    "འཁྱོག་པོར་བརྗོད་པ་དཔེ་དང་གཟུགས་ཅན་ལ་སོགས་པ་ལྟ་ཅི་སྨྲོས།",
    "ཞེས་གསུངས་པར་རིན་སྤུངས་སྙན་འགྲེལ་དུ་རང་བཞིན་བརྗོད་པའི་རྒྱན་དང་ཕུལ་བྱུང་གི་རྒྱན་གྱི་གཞི་མཐུན་ཡོད་པར་འགྲེལ་ཏེ།",
    "རང་བཞིན་བརྗོད་པའི་རྒྱན་ལའང་ཕུལ་དུ་བྱུང་བའི་སྙན་ངག་གི་ཉམས་དང་ལྡན་དགོས་ཤིང་།",
    "ཅེས་གསུངས་པ་ལྟར་རོ། ཕུལ་བྱུང་གི་དཔེ་དང་ཕུལ་བྱུང་གི་རྒྱན་གཉིས་ཀར་འུད་ཉམས་ཐོན་དགོས་པའི་ཆ་ནས་འདྲ་ཙམ་ཡོད་ཀྱང་།",
    "ཐེ་ཚོམ་པའི་དཔེ་དང་ཐེ་ཚོམ་ཕུལ་བྱུང་གི་རྒྱན་གཉིས་ཀར་ཐེ་ཚོམ་པའི་བློ་ཞིག་སྐྱེས་པ་སྐད་དུ་བརྗོད་དགོས་པའི་ཆ་ནས་འདྲ་ཙམ་ཡོད་ཀྱང་།",
    "དཀའ་ཐུབ་པ་ཞིག་གི་ཆེ་བ་བརྗོད་ཕྱིར།",
    "ངེས་པ་ཕུལ་བྱུང་ནི་ཐེ་ཚོམ་ཕུལ་བྱུང་གི་བྱེ་བྲག་ཏུ་གསུངས་པ་མི་འཐད་དེ།",
    "གཞུང་གི་ཚིག་ཟིན་གཙོ་བོར་བྱས་ནས་གྲགས་པ་ཕུལ་བྱུང་ཞེས་འཆད་འདུག་ནའང་།",
    "ཁྱོད་ཀྱི་གྲགས་པའི་ཕུང་བོ་ནི།",
    "ཞེས་རྒྱལ་བོ་ཞིག་གི་གྲགས་སྙན་ལ་སྦྱར་ཡོད་ཀྱང་།",
    "དཔེའི་རྗེས་སུ་སོང་བའི་ཕུལ་བྱུང་།",
    "རབ་རྟོག་གི་ཕུལ་བྱུང་།",
    "བཅུ་གཉིས་པ་རབ་རྟོག་གི་རྒྱན། རབ་རྟོག་གི་རྒྱན་ནི་བརྗོད་བྱ་སེམས་ལྡན་ནམ་སེམས་མེད་ཀྱི་དངོས་པོ་གང་ཡང་རུང་བ་ཞིག་གི་གནས་ཚུལ་ལམ་རྣམ་པ་དངོས་དེ་རབ་རྟོག་གསལ་བྱེད་ཀྱི་སྒྲ་དང་ལྡན་པའི་སྒོ་ནས་རྣམ་པ་གཞན་ཞིག་གི་ངོ་བོར་སྒྲོ་བཏགས་ནས་བརྗོད་པའི་འཁྱོག་བརྗོད་ཀྱི་རྒྱན་སྙན་ངག་གི་ཉམས་ཕུན་སུམ་ཚོགས་པ་ཐོན་བྱེད་ཅིག་སྟེ།",
    "སྒྲོ་བཏགས་དང་འཁྱོག་བརྗོད་སོགས་བསམ་བཀོད་ཕུན་སུམ་ཚོགས་པའི་ཐབས་རྩལ་དང་ལྡན་པ།",
    "རབ་རྟོག་གི་རྒྱན་ལ།",
    "བརྗོད་བྱའི་དངོས་པོ་དེ་རང་གི་གནས་ཚུལ་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པའི་ཚུལ་ནི།",
    "རབ་རྟོག་གི་ས་བོན་ཡིན་ཞིང་།",
    "དེ་ལ་བརྟེན་ནས་དངོས་པོ་དེའི་བྱ་བའི་གནས་ཚུལ་གཞན་ཞིག་ཏུ་སྒྲོ་བཏགས་ཏེ་འཁྱོག་པོར་བརྗོད་པ་ལ་རབ་རྟོག་ཅེས་ཟེར་བས་ན།",
    "རབ་རྟོག་གི་རྒྱན་འདིའི་སྐབས་སུ་སྒྲོ་འདོགས་ཚུལ་ཁྱད་པར་བ་ཞིག་དགོས་པར་གསུངས།",
    "ཞེས་གསུངས། རབ་རྟོག་གི་རྒྱན་གསུམ་དོགས་གཅོད་དང་བཅས་པ་བསྟན་པའི་མཇུག་ཏུ།",
    "ཏིང་འཛིན་རབ་རྟོག་གི་དཔེ་བརྗོད་ལ་རྩ་བར།",
    "ཞེས་འདི་ཡང་ངོ་རབ་རྟོག་གི།",
    "ཞེས་པ་འདི་ཡང་ངོའི་སྒྲས་སེམས་མེད་རབ་རྟོག་གི་བྱེ་བྲག་ཡིན་གསུངས་པ་ཤིན་ཏུ་ལེགས་ཏེ།",
    "དོན་འདི་ལ་བསམ་ན་རབ་རྟོག་གི་རྒྱན་ཐམས་ཅད་ཏིང་འཛིན་རབ་རྟོག་ལས་མ་འདས་མོད།",
    "དེ་འདྲའི་རིགས་པས་དོགས་མཐའ་ཡང་ལེགས་པར་སེལ་ཐུབ་པར་འདུག་མོད།",
    "བཅུ་གསུམ་པ་རྒྱུའི་རྒྱན། སྤྱིར་སྙན་ངག་དང་སྐར་རྩིས་སོགས་རིག་པའི་གཞུང་ལུགས་གང་ཡིན་ཡང་འཇིག་རྟེན་ན་ཡོངས་སུ་གྲགས་པའི་གཏམ་དང་རྒྱུ་འབྲས་ཀྱི་རྣམ་བཞག་སོགས་དངོས་པོའི་གཤིས་ལུགས་དག་ནི་ངེས་པར་དུ་ཁས་ལེན་དགོས་པ་སྨྲོས་མེད་ཡིན་མོད།",
    "རང་རང་གི་གཞུང་ནས་བསྟན་པའི་ཐུན་མིན་བརྡ་ཆད་དང་ཐུན་མིན་གྱི་བརྗོད་སྟངས་ཀྱང་ངོ་མཚར་བ་ཡོད་དེ།",
    "གོང་གི་གཉིས་པ་ཤེས་བྱེད་ཀྱི་རྒྱུ་ལ་ཕྱི་ཤེས་བྱེད་ཀྱི་རྒྱུ་དང་ནང་ཤེས་བྱེད་ཀྱི་རྒྱུ་གཉིས་ཏེ་ཁྱོན་དངོས་པོའི་རྒྱུ་ལ་ནང་གསེས་དབྱེ་བ་དྲུག་ཡོད་དོ།",
    "སྤངས་ནས་མེད་པའི་བྱེད་རྒྱུ་དང་བཞི་སྟེ་ཁྱོན་དངོས་མེད་ཀྱི་རྒྱུ་ལ་དབྱེ་བ་ལྔ་ཡོད་དོ།",
    "དོན་དྲིལ་ན་རྒྱུ་གཅིག་གིས་འབྲས་བུ་བསྐྱེད་ལུགས་གོ་ལྡོག་པའོ།",
    "འགྱུར་བྱེད་རམས་ཀྱིས་འབྲས་བུ་གནས་སྐབས་གཞན་སྔོན་པོར་སོང་བ་ནི་རྣམ་འགྱུར་ཏེ།",
    "འདི་དག་གི་སྐོར་འགྲེལ་བ་ཕལ་ཆེར་ལ་མི་གསལ་ཞིང་།",
    "འགའ་ཞིག་ཏུ་རྟོག་བཏགས་ཀྱིས་ལོག་པར་འཕྱམ་པ་ཡང་སྣང་མོད།",
    "དོན་དུ་ནི་ཤེས་བྱེད་ཀྱི་རྒྱུ་ལ་དཔེར་བརྗོད་གཉིས་མཛད་པ་ཕྱི་ནང་གི་བརྗོད་བྱ་ལ་ལྟོས་ན་ཐ་དད་ཀྱང་།",
    "ལྔ་བ་ཆེན་མོ་དང་བོད་མཁས་སོགས་ཀྱིས་བཞེད་པ་ལྟར་བརྗོད་བྱ་ཐ་དད་པ་ལ་ལྟོས་ནས་རྒྱན་སོ་སོར་འདོད་དགོས།",
    "གི་སྒོ་ནས་སྙན་ངག་གི་སྐབས་འདིར་དངོས་བོ་མེད་པའང་ཡིན་ལ་རྒྱུ་ཡང་ཡིན་པས་དངོས་མེད་ཀྱི་རྒྱུ་ཡང་བྱ།",
    "མེད་ན་མི་འབྱུང་གི་ཐ་སྙད་ཙམ་གྱི་བརྗོད་ཚུལ་འདི་ལྟ་བུའི་སྒོ་ནས།",
    "དངོས་མེད་ཀྱི་རྒྱུས་དངོས་པོ་ཡོད་པ་དང་མེད་པའི་འབྲས་བུ་སྐྱེད་པ་ལྟ་བུ་ཐ་སྙད་ཀྱི་ཚིག་གི་སྦྱོར་བ་ཙམ་དེ་སྙན་ངག་མཁན་རྣམས་ཀྱིས་ཡིད་དུ་འོང་བའི་རྒྱན་གྱི་གྲས་སུ་བཞག་པ་ཡིན་ནོ།",
    "ལུང་སྔ་ཕྱི་འདི་དག་གི་གོ་དོན་ལ་ངེས་པ་རྙེད་ན་དངོས་མེད་ཀྱི་རྒྱུའི་རྒྱན་གྱི་ངོ་བོ་བདེ་བླག་ཏུ་རྟོགས་པར་འགྱུར་རོ། དངོས་མེད་ཀྱི་རྒྱན་དང་བོ་ལ་སྔ་ནས་མེད་པའི་བྱེད་རྒྱུའམ་སྔོན་མེད་པའི་བྱེད་རྒྱུ་ཞེས་ཀྱང་བྱ་སྟེ།",
    "སྔོན་ཆད་མེད་པའི་རྒྱུ་ཞིག་གིས་འབྲས་བུ་གཞན་ཞིག་བསྐྱེད་པར་བརྗོད་པས་སོ། དངོས་མེད་ཀྱི་རྒྱན་གསུམ་པ་ཕན་ཚུན་མེད་པའི་བྱེད་རྒྱུ་ནི་དངོས་པོ་གཅིག་ལ་གཅིག་མི་གནས་ཤིང་ཕན་ཚུན་ཡིན་པ་མེད་པའི་དངོས་མེད་ཀྱི་རྒྱུས་འབྲས་བུ་གཞན་ཞིག་བསྐྱེད་པའི་ཚིག་ཉམས་དང་ལྡན་པ་ཞིག་ལ་ཟེར་རོ།",
    "མགྲོན་པོ་རྣམས་ཀྱི་བུད་མེད་ནི།",
    "ཏིལ་བཅས་ཁྱོར་ཆུ་སྦྱིན་བྱར་འགྱུར།",
    "དགག་ཚིག་ཡོད་ཀྱང་འབྲས་བུ་འཁྲུངས་པའི་དོན་ཁོ་ནར་སོང་ན་དངོས་མེད་དུ་མི་འགྱུར་བ་དང་།",
    "འགྲེལ་བ་ཕལ་ཆེར་ལ་དེ་ལྟར་སྣང་མོད།",
    "གཞུང་གི་དགོངས་པར་འགྲོ་བའི་དཔེར་བརྗོད་བགྱིས་པ་ནི།",
    "བཅུ་བཞི་བ་ཕྲ་མོའི་རྒྱན། སྤྱིར་རང་རིགས་ལ་གཞུང་ལུགས་དང་གོམས་གཤིས་སྣ་ཚོགས་པའི་ལམ་ནས་བརྡ་མཚོན་ནམ་བརྡ་ཐབས་སྒྱུ་རྩལ་མཚོན་ཚུལ་ཕུན་སུམ་ཚོགས་པ་ཞིག་ཡོད་ལ།",
    "ནང་སེམས་ཀྱི་འཆར་སྣང་འགའ་ཞིག་ངག་ཏུ་མ་བརྗོད་ཀྱང་ལུས་ཀྱི་རྣམ་འགྱུར་སོགས་ཕྲ་བའམ་ཆུང་བ་ཙམ་གྱིས་ཕ་རོལ་བོར་གོ་བ་བསྐྱེད་ཐུབ་པའི་ཕྲ་མོའི་རྒྱན་འདི་ནི་ངག་རིག་གི་ལམ་ནས་བརྡ་ཐབས་སྒྱུ་རྩལ་མཚོན་པའི་རྒྱན་ཁྱད་པར་དུ་འཕགས་པ་ཞིག་ཡིན་ཏེ།",
    "འདི་འདྲའི་ཕྲ་མོ་དེ་མཚོན་བྱེད་ཀྱི་རྣམ་འགྱུར་སྣ་ཚོགས་ངག་གི་སྦྱོར་བར་བཀོད་པ་ལ་བརྟེན་ནས།",
    "མཚོན་བྱ་ཤུགས་ལ་རྟོགས་ནུས་པའི་ཚིག་སྦྱོར་གྱི་རྒྱན་ལ་ཕྲ་མོའི་རྒྱན་ཞེས་བྱའོ།",
    "ཕྲ་ཕྱིར་ཕྲ་མོ་ཞེས་པར་བརྗོད།",
    "ཟུར་གྱི་ཕྲ་མོ་དང་རྣམ་པའི་ཕྲ་མོ་གཉིས་གང་ཡིན་ཡང་བསམ་བྱའི་དོན་ནམ་བརྗོད་བྱའི་དོན་དེ་ཉིད་ཚིག་གི་སྒྲས་ཟིན་གྱི་ངག་ལ་མ་ལྟོས་པར་ཕྱི་ལུས་ཀྱི་ཉམས་འགྱུར་རམ་བརྡ་ཐབས་གཞན་ཞིག་གིས་མཚོན་པར་བྱེད་པ་སྟེ།",
    "ཟུར་ཞེས་པ་ནི་ནང་གི་བསམ་པ་འགའ་ཞིག་ཤེས་པར་བྱ་བའི་དོན་དུ་དངོས་སུ་མ་བརྗོད་པར་བློ་སྔོན་དུ་བཏང་བའི་བརྡ་ཐབས་ཀྱིས་སྟོན་པ་དང་།",
    "རྣམ་པ་ཞེས་པ་བློ་སྔོན་དུ་མ་བཏང་ཡང་སེམས་ཀྱི་འགྱུར་བ་དང་རྗེས་སུ་མཐུན་པའི་རྣམ་འགྱུར་ལུས་ལ་ངང་གིས་གསལ་བའི་སྒོ་ནས།",
    "ཡང་བཞིན་གྱི་རྣམ་འགྱུར་ཙམ་ཕྲ་མོའི་རྒྱན་དུ་འདོད་ན།",
    "འདིར་ནི་གདོང་སོགས་ལུས་ཀྱི་ཕྱིའི་རྣམ་འགྱུར་ཤིན་ཏུ་ཕྲ་མོ་ཙམ་བརྗོད་པས་ནང་གི་བསམ་པ་ཕྲ་མོ་དེ་སྟོན་པ་ཡིན།",
    "ཕྲ་མོའི་རྒྱན་ལ་ནི་བསམ་དོན་སྒྲས་མ་ཟིན་པར་ཕྱིའི་བརྡ་ཐབས་ཙམ་གྱིས་མཚོན་ཞིང་རྟོགས་པར་བྱེད་པ་ཞིག་ཡིན་པས།",
    "བརྡ་འམ་མདངས་ཙམ་ཞིག་གིས་དོན་སྟོན་ཁྱད།",
    "བཅོ་ལྔ་བ་ཆའི་རྒྱན། བརྗོད་བྱའི་དངོས་པོ་ཞིག་གི་ང་རང་བཞིན་དངོས་དེ་བསྟན་ན་མི་མཛེས་པ་དང་མི་འོས་པ་སྐྱོན་མཚང་གི་རྣམ་པ་ལྟ་བུར་གྱུར་གཤིས་རང་བཞིན་དངོས་སྦ་དགོས་པ་བསྒྲིབ་བྱའི་དོན་དང་།",
    "འདིར་ཆ་ཞེས་པ་ལ་ཆ་འགྲིག་གི་ཆ་དང་ཆ་ཤས་ཀྱི་ཆ་ཞེས་གོ་ཚུལ་གཉིས་ཡོད་ཀྱང་།",
    "ལྔ་བ་ཆེན་པོས་ཆ་འགྲིག་གི་ཆ་དང་།",
    "གཉིས་པར་སྨད་པའི་ཆའི་རྒྱན་དང་བསྟོད་པའི་ཆའི་རྒྱན་གཉིས་ཏེ་ཁྱོན་ཆའི་རྒྱན་ལ་ནང་གསེས་དབྱེ་བ་བཞི་ཡོད་དོ། འོས་པའི་ཆའི་རྒྱན་ནི་བསྒྲུབ་བྱ་དང་སྒྲུབ་བྱེད་གཉིས་ཀ་འོས་པ་ཞིག་དང་མི་འོས་པའི་ཆའི་རྒྱན་ནི་བསྒྲུབ་བྱ་མི་འོས་ཤིང་སྒྲུབ་བྱེད་འོས་པ་ཞིག་གོ། ཁམས་འགྲེལ་ལས།",
    "དཔང་ཊཱིཀ་ཏུའང་གསལ་མོད་ཀྱང་།",
    "བོད་རྣམས་ཀྱིས་སྔ་མ་ནི་ཆགས་པ་དང་བསིལ་བ་གཉིས་ཀ་སྤུ་ལོང་གི་རྒྱུར་འོས་པས་ན་འོས་པའི་ཆ་དང་།",
    "ཞེས་གསུངས་མོད།",
    "ཡང་རྟོགས་དཀའ་བའི་རྒྱན་རེ་རེ་ལ་དཔེ་བརྗོད་གཉིས་རེ་འཇོག་ནའང་ཧ་ཅང་ཐལ་ཆེས་སོ།",
    "དེ་ལྟར་བསྟན་ཟིན་པའི་རྒྱུ་དང་ཕྲ་མོ་ཆའི་རྒྱན་ཏེ་གསུམ་པོ་འདི་འགྲེལ་བྱེད་འགའ་ཞིག་གིས་རྒྱུ་རྒྱན་གྱི་བྱེ་བྲག་ཏུ་འདོད་ཀྱང་།",
    "བཅུ་དྲུག་པ་རིམ་པ་ཅན་གྱི་རྒྱན། དངོས་པོ་འགའ་ཞིག་སྔོན་ལ་གང་བསྟན་པ་རྣམས་གྲངས་དང་རིམ་པ་མ་ནོར་བར་ཁ་དོག་དང་བྱེད་ལས་གྲངས་དང་གནས་ཡུལ་ལྟ་བུ་སོགས་རེ་རེར་སྦྱོར་དུ་ཡོད་པ་ཞིག་ལ་རིམ་པ་ཅན་གྱི་རྒྱན་ནམ་གྲངས་བཞིན་གྱི་རྒྱན་ཞེས་བྱའོ།",
    "ཁྱོད་ཀྱི་འཛུམ་མིག་གདོང་མཛེས་ནི།",
    "པདྨ་དང་གསུམ་པོ་ལས་བརྐུས་པར་ངེས་སོ་ཞེས་གཟུགས་ཅན་མ་སྟེ་བུད་མེད་མཛེས་མ་ལ་འབོད་པ་སྐད་དུ་བྱས་ཡོད་དོ།",
    "ངེས་སོ་ཞེས་པ་རབ་རྟོག་གསལ་བྱེད་ཀྱི་སྒྲ་ཡིན་པས་བོད་ཀྱི་མཁས་པ་ཕལ་ཆེར་གྱིས་ཀྱང་དེ་ལྟར་དཔེ་རྒྱན་དང་རབ་རྟོག་གི་རྒྱན།",
    "དཔེ་རྒྱན་དང་རིམ་པ་ཅན་གཉིས་ལ་དོགས་གཅོད་ཀྱང་གནང་དགོས་བྱུང་མོད་རྒྱན་གསུམ་བསྲེས་ན་འོག་གི་རབ་སྤེལ་གྱི་རྒྱན་དང་ཁྱད་པར་མེད་འགྲོ་ཞིང་།",
    "འདིར་རབ་རྟོག་གསལ་བྱེད་ལ་ཀྱི་སྒྲ་སྦྱར་བས་རབ་རྟོག་གི་རྒྱན་ཞར་ལ་ཐོན་པ་ཡིན་གྱི།",
    "དེར་དབྱེ་ན་དངོས་ཐོབ་ཀྱི་དགའ་བ་དང་གཟུགས་བརྙན་གྱི་དགའ་བ་གཉིས་ཡོད་དོ། དགའ་བའི་རྒྱན་ནི་ནང་སེམས་ལ་སྤྲོ་བ་འཕེལ་བའི་ཚུལ་སྙན་ངག་གི་ལམ་དུ་དྲངས་པ་ཙམ་ལས་སྤྲོ་ཉམས་ལུས་ངག་ཏུ་ཤར་བའི་ཚུལ་བརྗོད་མི་རུང་སྟེ།",
    "འོག་གི་སྒེག་པའི་ཉམས་དང་འདྲེས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འཕགས་ཀྱི་དགའ་བའི་རྒྱན་ཞེས་མིང་བཏགས་མོད་རེ་བ་མེད་ཅེས་བརྗོད་ན་མི་ལེགས་ཚུལ་ཚངས་སྲས་བཞད་སྒྲར་གསུངས་ལ།",
    "ཕུལ་བྱུང་གི་དགའ་བ་ཞེས་འདྲེས་མའི་རྒྱན་མང་ཙམ་གསུངས་སོ།",
    "གཟེངས་བསྟོད་པ་དང་དཔའ་ཞུམ་པ་སོགས་ཀྱི་ཚོར་བ་ཞིག་ངང་ངམ་ཤུགས་ཀྱིས་སྟེར་ཐུབ་པས་དེ་ལ་སྙན་ངག་གི་ཉམས་ཞེས་བརྗོད་པ་ཡིན་ནོ།",
    "ལོ་ཙཱ་བ་རིན་ཆེན་དཔལ་གྱིས་ནང་གི་ཉམས་བརྒྱད་དང་ཕྱིའི་ཉམས་བརྒྱད།",
    "སློབ་དཔོན་ར་བྷ་བས་ཉམས་བཅུ་ལ་སོགས་པ་ནང་གསེས་དབྱེ་བ་འབྱེད་ཚུལ་ཡང་མང་དུ་བྱུང་མོད་འདིར་བསྟན་གྱི་ཉམས་བརྒྱད་པོར་དོན་གྱིས་འདུ་བ་ཡིན་ནོ།",
    "དགོད་དང་དྲག་ཤུལ་འཇིགས་སུ་རུང་བ་སྟེ་གསུང་གི་ཉམས་གསུམ།",
    "འོ་ན་དེ་དང་རྣམ་པའི་ཕྲ་མོ་ལ་ཁྱད་པར་མེད་དོ་ཞེ་ན་ཡོད་དེ།",
    "རྣམ་པའི་ཕྲ་མོ་ནི་དངོས་དོན་མ་བརྗོད་ལ།",
    "ཞེས་གསུངས་པ་ལྟར་རོ། ཉམས་བརྒྱད་ཀྱི་མཚན་ཉིད་སོགས་གཞུང་གཞན་དང་གཞན་དུའང་གསུངས་མོད་ས་པཎ་མཁས་འཇུག་དང་ཁམས་འགྲེལ་ལས་བསྟན་པ་ནི་ཤིན་ཏུ་གསལ་ཏེ།",
    "ཞེས་གསུངས་ཏེ་གཟུགས་དང་ལང་ཚོ།",
    "འདི་ལ་ཞིབ་པར་ཕྱེ་ན་ནང་གི་སྒེག་པ་དང་ཕྱིའི་སྒེག་པ།",
    "ཕྱི་མ་ལའང་རིགས་མང་དུ་ཡོད་པ་ལས་སྐབས་འདིའི་བསྟན་དོན་ནི་བུད་མེད་ཀྱི་འབྱོར་བའི་སྒེག་པ།",
    "དགའ་བ་རྒྱས་པའི་ཆ་ནས་གོང་གི་དགའ་བའི་རྒྱན་དང་སྒེག་རྒྱན་གཉིས་འདྲ་ཡང་།",
    "ནང་གི་སེམས་མི་སྤྲོ་ཞིང་ཞུམ་པ་ལྟ་བུ་ལ་དཔའ་བའི་ཉམས་མི་འོངས་ཤིང་།",
    "དེ་ལ་ཡང་ལུས་ངག་གི་རྣམ་འགྱུར་དང་འགྲོ་འོང་ལ་སོགས་པའི་སྤྱོད་ཚུལ་གྱིས་གཞན་ལ་འཕྱ་བའམ་ཀུ་རེའི་ཉམས་ཀྱིས་དགོད་ཁ་སློང་ཚུལ་སྣ་ཚོགས་ཤིག་ཡོད་དོ།",
    "རང་བཞིན་གྱིས་གད་མོ་འབྱིན་པ་ནི་བླུན་པོ་ངོ་ཚ་མི་ཤེས་པའི་རྣམ་འགྱུར་ལས་ཕལ་ཆེར་འབྱུང་ལ།",
    "དེ་ལའང་ལུས་ངག་ལས་བྱུང་བ་ནི་ནང་གི་དང་།",
    "ཡང་ན་ཁེངས་པ་ལྟ་བུའི་དོན་དུ་གསུངས་པས་དེའི་ཉམས་དང་ངོ་མཚར་འཕེལ་བ་རྨད་བྱུང་གི་ཉམས་གཉིས་ཁྱད་པར་ཆེ་སྟེ།",
    "འོན་ཀྱང་སྐབས་འགར་དམིགས་བསལ་ལྟ་བུས་རྨད་བྱུང་གི་དོན་དུ་གོ་བའང་ཡོད་ཚུལ།",
    "སྐབས་འདིར་ཉམས་གཞན་དུ་འཁྲུལ་སོ་ཆེ་བས་རྨད་བྱུང་གི་ཉམས་ཞེས་བརྗོད་ན་ལེགས་སོ།",
    "འཇིགས་པ་འཕེལ་བ་འཇིགས་རུང་གི་ཉམས་ནི།",
    "སྐྲག་ཅིང་འདར་བ་སོགས་ཀྱི་ཉམས་ཐོན་པའི་ཚུལ་གསལ་བོར་བརྗོད་པ་ཞིག་ལ་འཇིགས་རུང་གི་ཉམས་ཞེས་བྱའོ།",
    "འདི་ཡི་ཕྱིར་དུ་ཁྱོད་ཀྱིས་ནི།",
    "བདག་གི་རལ་གྲི་ཕྱིར་ཕྱོགས་རྣམས།",
    "ཞེས་སྐྱེས་བུ་དཔའ་སྤོབས་ཀྱིས་ཁེངས་ཤིང་དྲེགས་པ་ཞིག་གིས་བརྗིད་ཆགས་ཤིང་གཟེངས་མཐོ་བའི་གཟི་བརྗིད་ཅན་གྱི་ཚིག་སྨྲས་ཏེ་ཕ་རོལ་བོ་ཉམས་སྨད་པར་བྱས་པ་ལྟ་བུ་ཞིག་ལ་གཟི་བརྗིད་ཅན་གྱི་རྒྱན་ཞེས་བྱའོ།",
    "ཉམས་ལྡན་ནི་ནང་སེམས་ལ་དགའ་བ་སོགས་ལས་བསྐྱེད་པའི་ཕྱིའི་ལུས་ལ་སྒེག་སོགས་ཉམས་བརྒྱད་པོའི་གང་རུང་ཞིག་གི་རྣམ་འགྱུར་ཐོན་པ་ཚིག་གི་ལམ་ནས་གསལ་བོར་བརྗོད་པ་དང་།",
    "གཟི་བརྗིད་ཅན་ནི་ནང་སེམས་ལ་ཁེངས་དྲེགས་སམ་ང་རྒྱལ་འཕེལ་བའི་ཚིག་གི་ཉམས་ཐོན་པ་སྟེ།",
    "འདི་ལའང་རྩ་བར་རྒྱན་གྱི་ངོ་བོའི་ཆ་ནས་ནང་གསེས་དབྱེ་བ་མ་གསུངས་མོད།",
    "འདི་བསྡུས་བརྗོད་ཕྲ་མོ་ཆ་གསུམ་དང་འདྲེས་པར་མི་འགྱུར་ཏེ།",
    "འབྲུག་གི་སྒྲ་ནི་གྲགས་པར་གྱུར།",
    "ཉེར་གཉིས་པ་རྒྱ་ཆེ་བའི་རྒྱན། རྩོམ་པ་བོས་གང་བརྗོད་པར་འདོད་པའི་བསྔགས་ཡུལ་དེའི་བསམ་པའམ་འབྱོར་བའི་ངོ་བོ་གཞན་ལས་ཁྱད་པར་དུ་འཕགས་ཤིང་རྒྱ་ཆེ་བར་སྟོན་པའི་ངག་གི་སྦྱོར་བ་ཞིག་ལ་རྒྱ་ཆེ་བའི་རྒྱན་ཞེས་བྱ་སྟེ།",
    "དེ་ལྟར་མ་གསུངས་པར་རྒྱན་གཉིས་སུ་ཁས་བླངས་འདུག་པས་ཁོང་རང་གི་རྒྱན་གྱི་ངོས་འཛིན་གནང་སྟངས་ལའང་ནང་གལ་ཞིག་དོན་གྱིས་བྱུང་བར་མངོན་ནོ། ལེའུ་དང་བོའི་སྐབས་སུའང་རྒྱ་ཆེ་བའི་རྒྱན་བསྟན་མོད།",
    "ལུས་ཕྲ་ཁྱོད་གདོང་རི་བོང་ཅན།",
    "ཞེས་བཏགས་ཁྱོད་གདོང་བསམ་པ་ཡིས།",
    "ཟླ་བའི་རྗེས་སུ་བདག་གིས་བསྙེགས།",
    "འགལ་བའི་རྒྱན་སོགས་མང་བོ་ཞིག་གི་ནང་དུ་སྦྱར་བའི་རྒྱན་ཆེད་དུ་བཀོད་པའམ་ཡང་ན་ཞར་ལ་བྱུང་བ་ལྟ་བུའང་དུ་མ་ཞིག་ཡོད་དོ།",
    "ཐ་དད་ཚིག་འདྲའི་སྦྱར་བ་སྟེ་རྗོད་བྱེད་ཚིག་གི་སྒོ་ནས་གཉིས་དང་།",
    "འགལ་བ་ཅན་གྱི་སྦྱར་བ་བཅས་བརྗོད་བྱ་དོན་འབྲེལ་གྱི་སྒོ་ནས་བདུན་ཏེ་ཁྱོན་དབྱེ་བ་དགུ་ཡོད་དོ། ཚིག་ཐ་དད་མིན་པའི་སྦྱར་བའི་དཔེ་བརྗོད་ལ་རྩ་བར།",
    "ཚིག་གི་གཟུགས་གཅིག་ལ་གཅོད་མཚམས་ཀྱང་ཐ་མི་དད་པའམ་གཅོད་མཚམས་གཅིག་གི་སྒོ་ནས་རྒྱལ་བོ་དང་ཟླ་བ་གཉིས་ཀྱིས་འཇིག་རྟེན་གྱི་ཡིད་འཕྲོག་པར་བརྗོད་པའོ།",
    "སྦྱར་རྒྱན་དང་བོ་དང་གཉིས་པ་ནི་གཙོ་བོ་རྗོད་བྱེད་ཚིག་གི་སྒོ་ནས་རྒྱན་གྱི་ཁྱད་པར་འབྱེད་དགོས་པ་ཡིན་ལ།",
    "བསྟན་པའི་སྒྲོན་མེའི་དཔེ་བརྗོད་དེ་གཅོད་མཚམས་ཀྱི་སྒོ་ནས་ཤོ་ལོ་ཀ་གཞན་ཞིག་གི་གཟུགས་སུ་བསྒྱུར་ཞིང་དོན་གཞན་ལ་སྤྱོར་ཆོག་པ་ནི།",
    "སྐད་གཉིས་ཀ་ལའང་མཉམ་ཉིད་དཔེ་ལ་སྐྱེད་ཚལ་དང་བུ་མོ་ལྟ་བུའི་དཔེ་དོན་མཚུངས་པར་སྨོས་པ་དང་།",
    "འགལ་བའི་ལས་ཅན་གྱི་སྦྱར་བའི་སྐབས་ངེས་པར་དུ་དཔེ་དོན་གཉིས་ཀྱི་བྱ་བ་འགལ་བ་རྒྱས་ནུབ་དང་ཤི་གསོན་ལྟ་བུ་ཞིག་ལ་སྦྱོར་དགོས་ཤིང་དཔེ་ཡང་གཅིག་གིས་ཆོག་པ་ཡིན།",
    "ལྡོག་ཅན་སྦྱར་བར་ཐལ་ཞེས་འཕེན་པ་འཁྲུལ།",
    "ཉེར་ལྔ་བ་ཁྱད་པར་བརྗོད་པའི་རྒྱན། རྩོམ་པ་བོས་གང་བརྗོད་པར་འདོད་པའི་དངོས་པོ་དེ་གཞན་ལས་ཁྱད་པར་དུ་འཕགས་ཤིང་ངོ་མཚར་བ་སྟོན་ཕྱིར་དེའི་རྒྱུ་འགའ་ཞིག་ལ་རིགས་བྱ་བ་ཡོན་ཏན་རྫས་རྒྱུ་རེ་འགའ་བཅས་གང་རུང་ཞིག་མ་ཚང་ཡང་།",
    "འདི་དག་ལྷ་ཡི་བུ་མོ་མིན།",
    "དེ་ལྟ་མོད་ཀྱི་ཚངས་པའི་ཡང་།",
    "བརྗོད་འདོད་ཀྱི་དངོས་པོ་གང་ཡང་རུང་བ་ཞིག་གི་རྒྱུའི་ཚོགས་པ་རྣམས་མ་ཚང་ཡང་དེ་ཚང་བ་དང་ཁྱད་མེད་པའི་དངོས་པོ་གང་གི་དངོས་རྒྱུ་ཁོ་ནའི་གཟི་བརྗིད་ཁྱད་པར་དུ་འཕགས་པར་བརྗོད་ནས།",
    "མང་བོའི་དཔེ་རྒྱན་ཙམ་དུ་སོང་མིན་ནམ།",
    "ཞེས་དོགས་སློང་དང་དེའི་རང་ལན་ཡང་གསུངས་འདུག་མོད།",
    "སྤྱིར་བསིལ་བ་མཚོན་ནུས་པ་ལ་དཔེ་གཅིག་གིས་ཆོག་མོད་ཀྱང་།",
    "གཞི་གཅིག་གི་བྱེད་པ་འགལ་བ།",
    "གཞི་གཅིག་གི་བྱ་བའམ་ལས་འགལ་བ།",
    "འགལ་བར་འདོད་ཅིང་དེ་ནི་ལྔ་བ་ཆེན་མོའི་བཞེད་པའང་ཡིན་ཚུལ་གསུངས་མོད།",
    "དགྱེས་གླུར་རྒྱན་འདིའི་མིང་ལ་གཞི་གཅིག་གི་བྱེད་པ་འགལ་བ་ཞེས་གསུངས་པར་མ་ཟད།",
    "གཞི་དངོས་པོ་བྱེད་པ་བོ་དཔལ་ལྡན་ལྷ་མོ་གཅིག་བུས་དགྲ་ལ་འཇིགས་པ་སྟེར་བ་དང་།",
    "སྒྲུབ་པ་བོ་རྣལ་འབྱོར་བ་གའ་བ་བསྐྱེད་པར་བྱེད་པའི་བྱ་བ་འགལ་བ་གཉིས་འགྲོགས་པར་ལྡན་པར་བསྟན་ཡོད་དོ། གོང་གི་གཞི་ཐ་དད་པའི་བྱ་བ་འགལ་བ་དང་རྒྱན་འདི་གཉིས་ཀར་བྱ་བ་འགལ་བ་གཉིས་འགྲོག་པར་ལྡན་པ་སྟོན་ཚུལ་གྱི་ཆ་ནས་འདྲ་ཙམ་ཡོད་ཀྱང་།",
    "བུད་མེད་ལུས་ཀྱིས་སུ་མ་བཅོམ།",
    "ཁྱོད་ཀྱི་གཟུགས་ཀྱིས་བདག་ཅག་རྣམས།",
    "ཞེས་ཁྱད་གཞི་བུད་མེད་གཅིག་བུ་ལ།",
    "འདིར་ནི་གཞི་གཅིག་གི་སྟེང་དུ་པད་མ་དང་ཆུ་ཤིང་སོགས་རྫས་མང་བོ་སྤུངས་པས་མི་འདྲའོ།",
    "འབྲུ་མང་བོའི་ཚིག་སྡུད་མ་བྱས་ནའང་ཐུན་མིན་གྱི་རྫས་འགལ་བའི་དཔེ་བརྗོད་འཇོག་ཚུལ་ཡོད་དོ། ལྔ་བ་གཞི་གཅིག་གི་ལས་སམ་བྱ་བ་འགལ་བའི་སྐབས་བྱེད་པ་བོ་ཁྱད་གཞི་གཅིག་གི་སྟེང་དུ་བྱ་བ་གང་ཡིན་པ་དེ་མ་བྱས་ཀྱང་བྱ་བ་བྱས་པའི་ལས་དང་ལྡན་པའི་འགལ་བ་གཉིས་ལྷན་ཅིག་ཏུ་འགྲོག་པར་སྟོན་དགོས་པས་གོང་གི་གཞི་ཐ་དད་པའི་བྱ་བ་འགལ་བ་དང་གཞི་གཅིག་གི་བྱེད་པ་འགལ་བ་ལ་ཁྱད་པར་ཆེན་པོ་ཡོད་དེ།"
  ]
}