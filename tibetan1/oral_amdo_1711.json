    "ནང་བསམ་བློ་གནའ་དེང་གཞུང་ལ་མོས།",
    "ལྷ་གཉན་པོ་ཨ་མྱེ་ཁྱུང་མགོན་རེད།",
    "དགོན་དགའ་ལྡན་བཀྲ་ཤིས་འབྱུང་གནས་རེད།",
    "ནང་འཁྲུག་གི་འཁོར་ལོར་ཞེན་པ་ལོག།",
    "ཚན་རིག་གི་ངོ་མཚར་བློ་ལས་འགོངས།",
    "མ་བཟོད་ཟུག་རྔུ་འབྱིན་པའི་སྤྱང་མོའི་ཚོགས།",
    "གང་ན་མྱ་ངན་ཚིག་གི་སྦྱོར་བར་བརྩོན།",
    "ངོ་མཚར་བཅུ་ཕྲག་རིག་པའི་དབྱིག་གི་ནོར།",
    "ཕྱོགས་ཀྱི་བུ་མོའི་མགྲིན་གླུར་བརྫུས་པའི་མཐུས།",
    "༢ ང་ཚོ་མདུན་སྐྱོད་ཀྱི་ལམ་སྣེ་ཕྲ་མོར།",
    "འགག་མེད་ཚེ་སྲོག་ཕྲ་མོ་ཡི་རྒྱུ་བ།",
    "རང་གི་སྐད་དང་ཡི་གེ་ལས་མི་འདུག།",
    "འགྱོད་གདུང་གི་རྨ་ཁ་སོས་ཐབས་ཤིག་མ་བྱུང་།",
    "༢ ལག་གསེར་སྨྱུག་ཕྲ་མོ་འཁྱུག་འཁྱུག་གིས་རྩེན་ཏེ།",
    "ཤར་རྒྱ་ནག་ཐང་གི་རྒྱལ་ཁམས་ཀྱིས་མཚོན་པའི།",
    "ཕྱོགས་རྒྱལ་ཁབ་ཆེ་ཕྲ་སྟོབས་དཔུང་གིས་བཅོམ་མཛད།",
    "དོན་ཆེད་ཆུད་ཟོས་སུ་ཤོར་ན་ཡིད་རེ་ཕངས།",
    "མ་རྟོགས་ལོག་རྟོག་གི་སྒོ་མོ་རང་འགག་ཡིན།",
    "ཕ་མཐའ་མིག་གིས་མི་ཟིན་སྤང་ཐང་གི་རྒྱན་ཆར།",
    "བློ་དང་ལང་ཚོའི་བཀྲག་མདངས་འཚེར་བའི་གཞོན་སྐྱེས་ཚོགས།",
    "སེམས་སྐྱ་མོ་འཐོག་སའི་ཁ་བ་གངས་ཅན་པའི་ཆེད་དུ།",
    "སྡུག་ཐོད་ལ་བླངས་པའི་ལས་ཤིག་ང་ཅག་གིས་བསྒྲུབས་ཡོད།",
    "མི་རིང་མི་ཐུང་གི་གཏམ་རྒྱུད་སྐྱོ་བོ་ཡི་རང་མདངས།",
    "སྤྲིན་དཀར་ལེབ་མོ་ཡི་བང་རིམ་བརྩེགས་པ་ཡི་གདན་ལ།",
    "བརྩེ་འཛུམ་ལྷུག་ལྷུག་ཏུ་གྲོལ་བའི་ཚངས་ཆེན་གྱི་སྲས་མོ།",
    "ངོ་མཚར་ངག་རིག་གི་དགའ་སྟོན་ཟད་མེད་ཅིག་སྩོལ་དང་།",
    "༡ སྣ་ཚོགས་ལྟ་བའི་ཀློང་ནས་རང་གི་མི་ཚེའི་དམིགས་འདུན་བོར།",
    "རིགས་པའི་སེང་ཆེན་གང་མང་ཕྲག་དོག་དུག་གི་མདའ་མོས་བཀུམ།",
    "རིགས་ཀྱི་དེད་དཔོན་དག་ཀྱང་གཡོ་ལྡན་ཝ་མོས་གཡོག་ཏུ་བཀོལ།",
    "༢ གནའ་དེང་ཟུང་འབྲེལ་གྱི་ཐབས་མཆོག་ང་ཚོའི་དམིཊ་འདུན་ཡིན་ལ།",
    "མི་རིགས་ཡར་རྒྱས་ཀྱི་ལས་དོན་ང་ཚོའི་བགོ་སྐལ་ཡིན་པས།",
    "ལོ་ཟླ་ཉིན་ཞག་གི་རེས་མོས་ཉག་ཕྲན་ལྟོངས་ནས་ཤོར་འདྲ།",
    "ཚེག་ཁྱིམ་བཅུ་བཞི་བ་ནི་གོང་གི་ཚེག་ཁྱིམ་བདུན་པ་གཉིས་བསྲེས་པ་ལྟ་བུ་ལས་གཞན་མེད་པས་སྙན་འགྲེལ་དག་ནའང་ལོགས་སུ་དཔེ་བརྗོད་བཞག་མེད་དོ།",
    "རྩོལ་མེད་ཟླ་ཕོག་ཤར་ལ་གཡུཊ་ཏེ་སློང་མོའི་བརྟུལ་ཞུགས་དང་དུ་བླངས།",
    "འཇིགས་མེད་རྒྱལམཚན་ཕྱག་རྗེས་མཐོན་པོ་ཇོ་མོ་གླང་མའི་མཆེད་ཟླར་བཞེངས།",
    "རེ་རེར་དཔེ་བརྗོད་བཞག་མེད་དོ།",
    "ཞེས་གསུངས་པ་ལྟར་བརྗོད་བྱའི་དོན་གང་རུང་ཞིག་ཚིགས་བཅད་གཅིག་གི་ནང་དུ་རྫོགས་པར་སྟོན་ཐུབ་པ་ཞིག་སྟེ།",
    "རིགས་ལ་བྱ་ཚིག་གཅིག་གིས་ཆོག་ཅིང་འདུས་པར་དུ་མ་ཡོད།",
    "མཛོད་ནི་དེང་སང་གི་ཐོལ་རྩོམ་ལྟར་བརྗོད་བྱ་སྣ་མང་ལ་སྦྱོར་རུང་ཞིང་རྗོད་བྱེད་ཤོ་ལོ་ཀ་བཅུ་ཡས་མས་ཤིག་འཚམ་ལ།",
    "གྲོལ་བའི་སྐབས་ཀྱི་དཔེ་བརྗོད་དང་བོས་དབྱངས་ཅན་མར་བསྟོད་པ་ཆ་ཚང་ཞིག་ཚིགས་བཅད་གཅིག་གིས་རྫོགས་པར་བྱས་པ་དང་།",
    "དཔེ་བརྗོད་གཉིས་པས་དབྱངས་ཅན་མར་དངོས་གྲུབ་ཞུ་བའི་བརྗོད་དོན་ཆ་ཚང་ཞིག་ཚིགས་བཅད་གཅིག་གིས་རྫོགས་པར་བྱས་པའོ།",
    "བརྗོད་བྱ་དབྱངས་ཅན་མ་ལ་དད་པ་འཕེལ་བའི་ཚུལ་གཅིག་པོ་རྗོད་བྱེད་ཤོལ་ཀ་གསུམ་གྱིས་བརྗོད་དེ་མཇུག་ཏུ་དང་བ་འཕེལ་ཞེས་པའི་བྱ་ཚིག་གཅིག་གིས་གོང་སྨྲོས་ཐམས་ཅད་ཀྱི་དོན་གསལ་བར་བྱས་པའོ།",
    "ཞེས་གསུངས་པ་ལྟར་སྔོན་འགྲོ་ཤིས་བརྗོད་ཕྱག་བྱ་དངོས་པོ་ངེས་བསྟན་གསུམ་མམ་གང་རུང་རེ་དང་།",
    "ཚིག་གི་ཉམས་ལས་ཡིད་ཀྱི་འགྱུར་བ་བསྐྱེད་ནུས་པ།",
    "འདིར་ཞར་བྱུང་དུ་ཤེས་དགོས་པ་ཞིག་ནི་གོང་དུ་བསྟན་པའི་སྙན་ངག་ཆེན་པོ་རྣམས་ནི་སྙན་ངག་གི་བསྟན་བཅོས་ཡིན་གྱི་སྙན་ངག་གི་གཞུང་ལུགས་མ་ཡིན་ལ།",
    "རྒྱན་གྱི་བསྟན་བཅོས་དང་སྙན་ངག་གི་བསྟན་བཅོས་གཉིས་ལའང་ཁྱད་པར་ཆེན་པོ་ཡོད་དོ། ཚངས་སྲས་བཞད་སྒྲ་ལས།",
    "མཁས་པ་ལ་ལས་ལེའུ་བཅུ་དྲུག་གི་རང་བཞིན་ཅན་གྱི་གཞུང་ཆེན་པོ་ཡིན་དགོས་པར་གསུངས་ཀྱང་མཐའ་གཅིག་ཏུ་མ་ངེས་སོ།",
    "དགའ་སྐྱོ་ཆགས་སྡང་གི་འཚོ་བ།",
    "མཆིས་པ་ཐམས་ཅད་སྙན་ངག་གི་སྲོག་གམ་བརྗོད་བྱར་གཟུང་འོས་སོ།",
    "དེའི་ཕྱིར་སྙན་ངག་པའི་སེམས་ཁམས་ནི་འཇིག་རྟེན་ཆ་ཚང་ཞིག་གིས་གྲུབ་དགོས་ལ།",
    "ཆེས་མང་བོ་ཞིག་ཡོད་ཚད་འདོར་བའམ་ཡོད་ཚད་ཧྲིལ་གྱིས་ལེན་དགོས་པའི་འཁྲུལ་སྣང་གིས་བཟི་བར་གྱུར་བས།",
    "ད་ལྟ་ཁ་ཅིག་གིས་བསྟན་བཅོས་ཆེན་པོ་ལ་འཇུག་པའི་སྒོ།",
    "དགོས་མེད་ཀྱི་བྱ་བས་དུས་ཚོད་འཕྲོ་བརླག་ཏུ་མི་གཏོང་བ་སོགས་ཀྱི་དགེ་མཚན་དང་ལྡན་ཚུལ་ཤེད་ཀྱིས་སྨྲ་བར་བྱེད་མོད།",
    "བྱ་བ་གང་ཞིག་བསྒྲུབས་ཀྱང་སྦྱོར་དངོས་རྗེས་གསུམ་གྱི་གོ་རིམ་དང་དེའི་དགོས་པ་རེ་བརྗོད་རྒྱུ་ཡོད་པ་བཞིན།",
    "ཤེས་ནས་རྙེད་པའི་དད་དུང་གིས་བཀའ་དྲིན་གཟོ་བ།",
    "ལྷ་ལས་ཕུལ་བྱུང་གི་བསྟོད་པ་ལས།",
    "ཞེས་ཕྱི་ནང་གི་འགལ་རྐྱེན་ཕྲ་རགས་ལས་རྣམ་པར་རྒྱལ་ཚུལ་གསུངས་པ་ལྟར་དགེ་མཚན་དུ་མ་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "བསྟན་བཅོས་སྤྱིའི་སྔོན་འགྲོ་ཐུན་མོང་བ་ཁང་བའི་ནང་ལ་འཇུག་པའི་སྒོ་ལྟ་བུ་ཡིན།",
    "སྒོ་གསུམ་གྱི་དཔེ་བརྗོད་རང་ཅག་གི་ཁྲིད་བྱའི་གཞུང་དུ་གསལ་བ་ལྟར་རོ།",
    "རྡོ་ལ་རི་མོ་བྲིས་པ་ལྟ་བུར་ནི།",
    "ཡ་རབས་རྣམས་ནི་སྲོག་ནི་གཏོང་གི་དམ་བཅའ་མིན།",
    "གང་གིས་ན་བྱེད་པ་བོའམ་རྩོམ་པ་བོས།",
    "ཇི་ལྟར་བརྩམ་ན་རྒྱས་འབྲིང་བསྡུས་གསུམ་གང་རུང་གི་སྒོ་ནས་སོ།",
    "གདུལ་བྱར་དོན་དུ་འགྱུར་བའི་ཕྱིར་སྨོན་པ་སོགས་ཀྱང་ཁ་གཡང་དང་སྟོང་འདང་ཙམ་མ་ཡིན་པའི་ཚུལ་ལུང་རིགས་གཉིས་ཆར་གྱིས་བརྗོད་དུ་ཡོད་མོད།",
    "བར་འགྱུར་བས་སྔོན་གྱི་སློབ་དཔོན་ནག་མོའི་ཁོལ་སོགས་ཀྱི་བྱུང་བ་ལས་ངེས་པ་རྙེད་པར་བྱའོ། རྩ་བར།",
    "ལུས་ནི་རེ་ཞིག་འདོད་པ་ཡི།",
    "དོན་གྱི་རྣམ་བཅད་ཚིག་གི་ཕྲེང་།",
    "དོན་རྒྱན་སྒྲ་རྒྱན་གབ་ཚིག་གི་རྒྱན་གྱིས་རྣམ་པར་སྤྲས་སོ་ཞེས་ཁོ་བོའི་སློབ་དཔོན་གྱིས།",
    "སྙན་གཞུང་ལེ་ལོང་མར་སྙན་ངག་གི་སྲོག་ཅེས་དངོས་སུ་མ་བསྟན་པས་སྤྱིར་སྙན་ངག་ལ་སྲོག་མེད་པས་མ་ཁྱབ་པ་ནི་མང་དུ་རྩོད་མི་དགོས་པའི་གནས་ཤིག་གོ།",
    "དེ་ལ་སྲོག་གི་ཐ་སྙད་འདོགས་མཁན་རང་རེ་བོད་གཅིག་པུ་མིན་པར་འཛམ་གླིང་གི་སྙན་ངག་སྤྱིའི་ཁ་ཕྱོགས་ཤིག་ཡིན་འདུག་སྟེ།",
    "འཚོ་བ་དངོས་ཀྱིས་ཁོ་ལ་དྲན་བསླངས་པ་ལས་བྱུང་བའི་བསམ་བློ་ཞིག་རེད།",
    "ཚུལ་འདིར་བསམ་ན་རང་རེ་བོད་ཁ་བ་ཅན་གྱི་ལྗོངས་འདིར་དེ་འདྲའི་གཟེངས་སྐྱེས་ཐོབ་འོས་པ་མི་ཉུང་བ་ཞིག་བྱོན་འདུག་ཀྱང་།",
    "ས་སྐམ་ལ་སོགས་ལ་མོས་པ་མེད་ཕྱིར་ཆེད་དུ་འགྲན་རྩོད་དུ་མ་ཞུགས་པས་འཛམ་གླིང་ན་མིང་དུ་གྲགས་པའི་བོད་རིག་རྩོམ་པ་བོ་གཟེངས་སྐྱེས་དང་ལག་རྟགས་མཐོན་པོ་ཅན་ཞིག་མ་བྱུང་བ་ཡིན་ནོ་སྙམ།",
    "དེ་ལྟར་རྩོམ་རིག་གི་དགེ་མཚན་གཙོ་བོ་བརྗོད་བྱའི་སྟེང་ན་ཡོད་ཀྱང་རྗོད་བྱེད་ཚིག་གི་སྒྱུ་རྩལ་ཡང་མི་མཁོ་བ་མ་ཡིན་ཏེ།",
    "ཞེས་པ་ལྟ་བུར་དགོངས་མོད་ཀྱི།",
    "འབྲུག་ཁམས་སྤྲུལ་སོགས་མང་བོ་ཞིག་གིས་ཀྱང་དེ་བཞིན་དུ་འདོད་མོད།",
    "ཤིང་རྟའི་ལུས་དང་གཞལ་མེད་ཁང་གི་ལུས་ཞེས་བརྗོད་སྲོལ་ཞིག་ཚིག་ཟིན་ལ་ཐོན་མེད་ཀྱང་སྙན་ངག་གི་ལུས་དེ་ཤིང་རྟ་སོགས་ཀྱི་ལུས་ལ་དཔེ་བླངས་པའི་དགོངས་དོན་ནི་ཤིན་ཏུ་གསལ་བོད་ལ་ཡོད་མེད་ཀྱང་མི་ཤེས་ཤིང་།",
    "སྙན་ངག་གི་སྐབས་འདིའི་དཔེ་ལེན་ས་དེ་ཡང་ངེས་པར་སེམས་མེད་བེམ་པོ་ཞིག་ཡིན་དགོས་པའི་སྒྲུབ་བྱེད་ཅི་ཞིག་ཡོད་པ།",
    "པའི་མཁས་རློམ་ཅན་དུ་ཐལ་བ་དང་།",
    "ཁོང་རྣམས་ཀྱིས་སྙན་ངག་ལ་རྗོད་བྱེད་ལས་གཞན་པའི་བརྗོད་བྱ་ཞིག་དོན་གྱིས་ཁས་བླངས་འདུག་པས་ལྔ་བ་ཆེན་མོ་སོགས་ཀྱི་དགོངས་པ་དང་རྩ་བའི་ཆ་ནས་མཐུན་པར་མ་གྱུར་ཏམ།",
    "རྗོད་བྱེད་རྐང་བ་རིང་ཐུང་དང་གླུ་ཚིག་མགུར་ཚིག་གང་གི་སྒོ་ནས་བྲིས་ཀྱང་འགལ་བ་མེད་དེ།",
    "རིམ་གྱིས་སྙན་ངག་གི་ཉམས་འགྱུར་ལྡན་པའི་ཚིག་སྦྱོར་སྣ་ཚོགས་རྩོམ་པ་ལ་མཁས་པར་འགྱུར་བ་དང་།",
    "ལ་ལས་མདུན་ན་འདོན་དང་དོན་གཅིག་པར་བྱེད་མོད།",
    "མདུན་ན་འདོན་གྱི་ཐ་སྙད་འདི་རྒྱ་གར་ནས་བསྒྱུར་བ་ཞིག་སྟེ་རྒྱལ་བོའི་མདུན་དུ་སྐར་མའི་རྩིས་དང་རིག་བྱེད་འདོན་མཁན་དག་གི་མིང་ཡིན།",
    "ཡོད་མེད་སྐྱེ་འགོག་གི་གཏན་ཚིགས།",
    "མུ་བཞི་སྐྱེ་འགོག་གི་གཏན་ཚིགས།",
    "ཞེས་སློབ་དཔོན་དབྱུག་པ་ཅན་རང་ཉིད་ནི་ཐོག་མར་ཕ་རོལ་བོའི་ཆེ་བ་འདོན་པ་གཙོ་བོར་བྱེད་པའི་རྩོམ་སྟངས་ལ་ཐུགས་དགྱེས་མོད་བྷ་མ་ཧའི་རྩོམ་སྟངས་ཀྱང་མི་བཞེད་པ་མ་ཡིན་ནོ།",
    "སེང་དཀར་མོ།",
    "སེམས་སྐྱ་མོ་སོགས་བོད་ཀྱི་ཐུན་སྐད་ཆའི་སྒྱུ་རྩལ་མང་བོ་ཞིག་སྐད་རིགས་གཞན་གྱིས་ཇི་བཞིན་སྦྱོར་དཀའ་བ་ལྟ་བུའོ།",
    "སྡུག་འཕོ་འགྱུར་དང་རེ་སྐུལ་མཚོན་པ།",
    "ཁ་གསལ་ཞིང་ལྷོད་ཉམས་ཀྱིས་ཕྱུག་པ་སོགས་སྙན་ངག་གི་ཉམས་འདོན་ཚུལ་ལ་མཐའ་མེད་པ་ཡོད་དོ།",
    "དགའ་སྐྱོ་སོགས་ཉམས་བརྒྱད་ཐོན་ཚུལ་ནི་འོག་གི་དོན་རྒྱན་གྱི་སྐབས་སུ་འཆད་དོ།",
    "བཅད་ལྷུག་སྤེལ་གསུམ་གྱི་ཡ་གྱལ་ཚིག་ལྷུག་ནི་ལྷུག་རྩོམ་མ་ཡིན་ཞེས་སུ་ཞིག་གིས་བསྙོན་པར་ནུས།",
    "དེའི་ཕྱིར་གནའ་སྔ་མོའི་དུས་ནས་བོད་ལ་ངག་ཐོག་ལྷུག་རྩོམ་བྱུང་བ་བློན་པོ་རུ་ལས་སྐྱེས་ཀྱིས་རང་གི་མ་ཡུམ་ལ་བཏོན་པའི་དྲི་བ་དང་།",
    "འདི་ནི་ལྷུག་པ་དག་གི་གསོས།",
    "གབ་ཚིག་གི་རྒྱན་བཅས་ཀྱང་རེ་རེར་སྦྱོར་དུ་ཡོད་དེ།",
    "སྒྱུ་རྩལ་དང་ཐབས་བཀོད་སོགས་ལ་ཁྱད་པར་མེད་པ་མ་ཡིན་མོད།",
    "ངས་སྔར་སྐད་ཆའི་ལང་ཚོའི་གླེང་བརྗོད་དུའང་འབྲི་མྱོང་བ་ལྟར།",
    "ད་ལྟ་ང་ཚོས་འབྲི་བཞེངས་བྱེད་བཞིན་པའི་ལྷུག་རྩོམ་ནི་སྲོལ་རྒྱུན་གྱི་རྩོམ་ལུས་ཚིག་ལྷུག་གི་རྣམ་པར་གཞི་བཅོལ་ཞིང་།",
    "བྱ་དངོས་དང་ཚོར་འདུ་བདེན་པར་འབྲི་བ་ནི་གནའ་ནས་ད་ལྟའི་བར་ལྷུག་རྩོམ་གྱི་སྲོལ་དུ་གྱུར་ཡོད།",
    "དེབ་ཐེར་དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་སོགས་བཀླགས་ན་བོད་ལ་སྔོན་ལྷུག་རྩོམ་འབྲི་སྲོལ་ཡོད་མེད་ཀྱི་རྩོད་པ་རང་ཤུགས་ཀྱིས་ཞི་བར་འགྱུར་ངེས་ཏེ།",
    "ལྷུག་རྩོམ་འབྲི་སྲོལ་ནི་རང་རེ་ལ་གནའ་སྔ་མོ་ནས་ཡོད་མོད།",
    "དེང་སྐབས་ལྷུག་རྩོམ་ལ་རྗོད་བྱེད་ཚིག་གི་ཆ་ནས།",
    "མིང་གཉིས་དག་གིས་རིགས་གཅིག་མཚོན།",
    "ཞེས་གཏམ་དང་བརྗོད་པ་ནི་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་སུ་བཞེད་ལ།",
    "ལྔ་བ་ཆེན་མོས་ཀྱང་།",
    "ཚིགས་བཅད་ལྷུག་སྤེལ་བའི་སྤེལ་མ་སྟེ་གཉིས་ཀ་འདིར་སྙན་ངག་གི་ལུས་གསུམ་པར་བཞག་པ་ཡིན།",
    "ཚིགས་བཅད་ལྷུག་སྤེལ་གསུམ་པོར་སྐད་རིགས་བཞིས་བཅིང་དུ་ཡོད་པའང་ཤེས་དགོས་སོ། སྐད་རིགས་བཞི་སྙན་ངག་གི་ལུས་སུ་བཞག་པ་ལ།",
    "རྗོད་བྱེད་ཀྱི་སྒྲ་ཡིན་པས་ལུས་སུ་མི་འགྱུར་ན་བཅད་ལྷུག་སྤེལ་མ་གསུམ་པོ་ཡང་རྗོད་བྱེད་ཀྱི་ཚིག་ཡིན་པས་དེར་ཐལ།",
    "ཟུར་ཆག་གི་སྐད་དང་འབྲེལ་བའི་གཏམ་རྒྱུད་ཅིག་ཡོད་འདུག་སྟེ།",
    "ཟུར་ཆག་ནི་སྔོན་ལྷ་ཁྱབ་འཇུག་གིས་རྒྱ་གར་གྱི་ཡུལ་ཕྲན་ཞིག་ཏུ་བ་ལང་སྐྱོང་བའི་རྫི་བོ་བྱས་ཤིང་།",
    "ཆར་ཆེན་པོ་བབས་པའི་ཚེ་རི་བོ་བཏེགས་ནས་བ་ལང་གི་ཁྱུ་རྣམས་བསྲུང་བར་བྱས་པས།",
    "ཁྱབ་འཇུག་དང་བྲམ་ཟེ་རྣམས་ཀྱིས་བ་ལང་གི་བདག་པོར་བསྐོས་པའི་གཏམ་རྒྱུད་དང་།",
    "དེས་ཁྱབ་འཇུག་གི་མིང་ལའང་གོ་བིན་ད་བ་ལང་གི་རྫི་ཞེས་གྲགས་པ་སྟེ།",
    "སྐད་རིགས་བཞིའི་དབྱེ་བའང་མེད་པས་དེ་དེར་སྦྱར་བའི་བསྟན་བཅོས་འགའ་ཞིག་གི་མིང་ཙམ་སྨྲོས་ཀྱང་རྣམ་པ་གསལ་བར་མི་འཆར་བར་སྣང་ངོ།",
    "སྙན་ངག་གི་རང་མདངས་གསར་བ་ལས།",
    "མི་རིགས་རང་གི་སྐད་ཟུར་ཆག་པ་དང་གཞན་གྱི་སྐད་ཟུར་ཆག་པ་གཉིས་ཡོད།",
    "ཟུར་ཆག་གི་སྐད།",
    "སྒྲ་དོན་ཅི་རིགས་ཀྱི་སྒོ་ནས་བཅད་ལྷུག་སྤེལ་གསུམ་གྱི་ལུས་དེ་ཉིད་མཛེས་པར་བྱེད་པ་ལ་སྙན་ངག་གི་རྒྱན་ཞེས་བྱ་ལ།",
    "དེར་ཐུན་མོང་དང་ཐུན་མོང་མིན་པའི་རྒྱན་གཉིས་ཡོད་པ་ལས།",
    "ཐུན་མོང་བའི་རྒྱན་ལ་དོན་རྒྱན་དང་།",
    "གབ་ཚིག་གི་རྒྱན་བཅས་གསུམ་ཡོད།",
    "སྒྲ་དོན་ཅི་རིགས་ཀྱི་སྒོ་ནས་བརྗོད་དོན་གབ་པའམ་སྦས་ནས་སྟོན་པས་གབ་ཚིག་གི་རྒྱན་ཞེས་བྱ་སྟེ།",
    "གབ་ཚིག་གི་རྒྱན་འདི་ཡང་དོན་རྒྱན་དང་སྒྲ་རྒྱན་གཉིས་སུ་དོན་གྱིས་འདུ་བ་ཡིན་ནོ།",
    "གཞན་རྣམས་ལ་འཁྱོག་བརྗོད་ཀྱི་རྒྱན་ཞེས་ཀྱང་བྱའོ། རྒྱན་གྱི་བསྟན་བཅོས་མཚོ་བྱུང་དགྱེས་པའི་འཛུམ་ཟེར་ལས།",
    "དེང་སང་རྒྱལ་ཁབ་ཕྱི་ནང་གི་ཆེས་སྔོན་ཐོན་གྱི་རྩོམ་རིག་ཉིང་བཅུད་ཡོད་ཟེར་མཁན་རྣམས་ཀྱི་ལྗགས་རྩོམ་ཕལ་ཆེར་ཀྱང་ཚིག་རྒྱན་སྙན་ངག་གི་རིག་པ་སྤྱི་དང་།",
    "ཁྱད་པར་དོན་རྒྱན་གང་རུང་གི་བཀའ་དྲིན་ལས་ཁ་ཏཱའི་རོ་ཐག་དགུང་ལ་བསྙེགས་པ་ལས།",
    "དཔག་ཚད་འབུམ་ཕྲག་གི་ས་ནས་འཕངས་ཏེ་ཚུགས་ཐུབ་ཀྱི་མཛད་རྗེས་རླབས་པོ་ཆེ་བཞག་ཡོད་པ་མཐོང་ངོ།",
    "ཞེས་མཁྱེན་རྒྱ་ཡངས་པའི་གཏམ་ཞིག་བསྩལ་ཡོད་པ་ཆེས་ཆེར་བདེན་པར་བདག་གིས་སེམས་སོ།",
    "དྲང་བོའི་ངག་གིས་ཚིག་ཟིན་ལ་ཐོན་པར་བྱས་ཏེ་སྙན་ངག་གི་ཉམས་དང་ལྡན་པར་བརྗོད་པ་ལ་རང་བཞིན་བརྗོད་པའི་རྒྱན་ཞེས་བྱའོ།",
    "འབྲུག་ཁམས་སྤྲུལ་སོགས་ཀྱིས་མིང་གི་རྣམ་གྲངས་ལ་རིགས་ཀྱི་རྒྱན་ཞེས་ཀྱང་ཟེར་རོ། ༡ རིགས་རང་བཞིན་བརྗོད་པའི་སྐབས་ཀྱི་རིགས་ཞེས་པ་རིགས་རུས་ཀྱི་རིགས་དང་།",
    "ཞེས་གསུངས་མོད།",
    "བྱ་བའི་རང་བཞིན་དྲང་བོར་བརྗོད་ཡོད་ཕྱིན་ཚིག་ཟིན་ལ་ཕྲད་དེ་གཉིས་ངེས་པར་དུ་ཐོན་དགོས་དོན་མི་འདུག་སྙམ་སྟེ་ཕྲད་དང་རྣམ་དབྱེ་བསྡུས་པ་ཤིན་ཏུ་མང་བས་ཕྱིར་རོ། ༣ ཡོན་ཏན་རང་བཞིན་བརྗོད་པའི་སྐབས་དགྱེས་གླུར་གཟུགས་སྒྲ་དྲི་རོ་སོགས་འདོད་པའི་ཡོན་ཏན་ལྔ་ཁོ་ན་ལ་སྦྱོར་དགོས་ཚུལ་གསུངས་པར་མཁས་མང་གིས་ཁྱབ་ཆུང་བའི་སྐྱོན་ཡོད་པར་གསུངས་ལ།",
    "ཁ་ཅིག་གིས་རང་བཞིན་བརྗོད་པའི་རྒྱན་བཞི་ཀ་རིགས་ཅན་ཀུན་ལ་ཁྱབ་པའི་རྒྱན་དུ་གསུངས་པ་མི་འཐད་དེ།",
    "འདི་དག་གི་དོགས་གཅོད་དང་རྩ་ཚིག་གི་འགྱུར་གང་ཞིག་འགྲིག་མིན་སོགས་རང་ཅག་གི་ཁྲིད་བྱའི་གཞུང་ན་ཤིན་ཏུ་གསལ་བས་འདིར་མང་བོ་འབྲི་མི་དགོས་སོ།",
    "དཔེ་བརྗོད་གཉིས་པའི་སྐབས་དཔེ་ཅན་རྒྱལ་བའི་གསུང་གིས་སྒྲིབ་གཉིས་འཇོམས་པ་དང་།",
    "༨ ཕུལ་བྱུང་གི་དཔེ། དཔེ་ཅན་དེ་ཉིད་ཕུལ་དུ་བྱུང་བའམ་ཁྱད་པར་དུ་འཕགས་ཚུལ་སྟོན་ཕྱིར།",
    "དཔེ་དོན་གྱི་ཁྱད་པར་མེད་པ་མ་གཏོགས་ཕུལ་བྱུང་གི་རྒྱན་ཞེས་འོག་ཏུའང་འབྱུང་ངོ།",
    "༩ རབ་བཏགས་ཀྱི་དཔེ། དཔེ་ཅན་དེའི་མཚུངས་དཔེར་གྱུར་བའི་དཔེ་ཞིག་གིས་མཚུངས་ཚུལ་སྟོན་པ་ཡིན་མོད།",
    "འདི་ལ་རབ་རྟོག་གི་དཔེ་ཞེས་བྲིས་པའང་ཡོད།",
    "ཚིག་རྒྱན་རིག་པའི་སྒོ་འབྱེད་སོགས་གཞུང་འགའ་རེར།",
    "དཔེ་ཅན་མཐོང་བས་དཔེ་རུ་འཁྲུལ་བ་དང་སླར་ཡང་དཔེ་ཅན་དུ་འཁྲུལ་བར་བརྗོད་པ་ཞིག་དགོས་པར་གསུངས་མོད།",
    "ཁ་ཅིག་གིས་ཕན་ཚུན་དཔེ་དང་དབྱེ་བ་མེད་པར་འགྱུར་རོ་སྙམ་དུ་བསམ་པ་བྱུང་འདུག་མོད།",
    "ཕན་ཚུན་དཔེ་ནི་དཔེ་དང་དཔེ་ཅན་བརྗེ་ལེན་གྱི་ཚུལ་དུ་དཔེར་འགོད་རེས་བྱས་ནས་མཚུངས་པར་བརྗོད་པ་དང་།",
    "དཔེ་འདི་དང་གོང་གི་རྨད་བྱུང་གི་དཔེ་དེ་དཔེ་ཅན་ལས་ཅུང་ཟད་དམན་པའམ་ལ་དེ་ལ་མི་དོ་བ་ཞིག་འཇོག་པ་འདྲ་ཡང་།",
    "བོད་སྐད་ལ་ཇི་བཞིན་མི་འཚམ་པས་སྔོན་བྱོན་མཁས་པ་ཚོས་སྣམ་བུའི་ཐགས་ལ་ཟ་འོག་གི་རི་མོའི་དཔེ་རུ་གསུངས་པ་ནི་ཤིན་ཏུ་ཐུགས་མད་དོ།",
    "དཔལ་དང་ལྡན་དང་དྲི་བཟང་གིས།",
