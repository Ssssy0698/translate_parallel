    "དེའི་སྟེང་རང་ཉིད་དང་མ་བྱན་བཅས་བདུན་ཡོད།",
    "མི་རྟོག་པ་དང་རང་བཞིན་གྱིས།",
    "རྣམ་པར་རྟོག་དང་རྣལ་འདུག་དང་།",
    "རྣལ་དུ་འདུག་པའི་དམིགས་པ་དང་།",
    "དེས་ན་ལྡོག་པའི་རང་རྒྱུད་ཀྱང་རང་བཞིན་དང་འབྲས་བུར་བལྟའོ།",
    "ཕྱིན་ཅི་མ་ལོག་པ་འཆད་པ་ན་ཡུལདང་རང་བཞིན་དང་རྡོ་རྗེའི་ཚིག་བཅུདང་སྦྱར་བ་དང་དོན་བསྡུ་བ་རྣམ་པ་བཞིས་སྟོན་ཏོ།",
    "མྱོང་ནས་ཟད་པ་དང་རང་འབྲས་ཕྱུང་ཟིན་པས་འབྲས་བུ་དང་།",
    "རྣལ་དུ་འདུག་པའི་དང་།",
    "མི་རྟོག་པ་དང་རང་བཞིན་གྱིས།",
    "དངོས་པོ་མེད་པ་དེའི་དངོས་པོ་མ་ཡིན་པའི་སྟོང་པ་ཉིད་དང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་དོ།",
    "མི་རྟོག་པ་དང་རང་བཞིན་གྱིས།",
    "རྣལ་དུ་འདུག་པའི་དམིགས་པ་སྟེ།",
    "ཆ་དྲུག་ལ་ནི་འབུམ་ཕྲག་གཉིས་གཉིས་སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྤྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "ཚངས་དང་ཁྱབ་འཇུག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རྒྱལ་པོ་ལོ་ནི་མཐའ་དག་རྗེས་སུ་ཉིན་ཞག་དུས་སྤྱོར་ཆུ་ཚོད་དག་དང་ཆུ་ཡི་སྲང་རྣམས་ཏེ།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད།",
    "དེ་ལྟར་གཟའ་རྣམས་ཀྱི་ནི་རྒྱུ་བ་མཐའ་དག་དུས་ཀྱི་འཁོར་ལོ་དག་ལས་ཤིན་ཏུ་ངེས་པར་འགྱུར།",
    "དཀར་པོའི་མདའ་དང་ཆུ་གཏེར་ཟླ་བ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར།",
    "གང་ཞིག་མ་སྤྱད་ཕྱེད་ཀྱི་ཆུ་ཚོད་དེ་ནི་དུས་ཀྱི་ཉིན་ཞག་དུས་ལ་ཆ་དམན་ཟླ་བ་སྟེ།",
    "དེ་ལ་ཡུད་ཙམ་སུམ་ཅུ་རྣམས་དང་ཉིན་ཞག་དུས་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ན་སྟེ།",
    "ཡང་དག་དུས་སྦྱོར་ཐམས་ཅད་ཀྱིས་ཏེ་སླར་ཡང་གལ་ཏེ་རང་ལུས་གཡོན་གྱི་རྩ་ལས་གྱུར་པ་ན།",
    "རང་རང་ཡི་གེས་ཤེས་བྱ་རྣམ་གསུམ་ཁྱབ་བདག་བགྲོད་པ་རྣལ་འབྱོར་པ་ཡིས་སྟོང་པའི་དབྱེ་བས་སོ།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཇི་ལྟར་འགྲོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་བེེགས་ཀྱུ་ཡིས།",
    "ལག་པའི་རྒྱབ་ཀྱིས་སོད་ཅིག་ངེས་པར་རབ་ཏུ་བརྗོད་དེ་མངོན་དུ་ཕྱོགས་པས་འདུག་ཅིག་འདུག་ཅིག་གོ།",
    "ངེས་པར་འཇམ་པའི་མལ་སྟན་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནབ།་",
    "ཕྱི་ནས་ཤེས་རབ་ལ་སོགས་དྲུག་ནི་རབ་ཏུ་གསལ་བར་བདག་པོ་རང་རང་པདྨའི་གདན་ལའོ།",
    "གདེངས་ཅན་རིགས་དང་བཅས་པ་རང་རང་ཕྱོགས་ཀྱི་བཞོན་པར་གནས་པའི་ལྷ་རྣམས་རྡོ་རྗེ་གདན་གྱིས་གནས།",
    "ཀི་ང་ཁྱབ་འཇུག་དུས་ཏེ་འཕྲོག་བྱེད་ཅེས་དང་ནོར་སྦྱིན་དག་ཀྱང་སི་དང་འདིར་ནི་ངྐ་ཉིད་དོ།",
    "ཧཱུཾ་ཡིག་ཡེ་ཤེས་ལས་སྐྱེས་འཇིག་དུས་སྤྲིན་དང་མཚུངས་པ་རྩེ་ལྔ་འོད་ཟེར་དང་བཅས་དགོད་པར་བྱ།",
    "སྔགས་ཀྱིས་དགུག་པར་རབ་ཏུ་འགྱུར་ཏེ་གདོན་གྱི་ཚོགས་པ་མཐའ་དག་དུས་ཀྱི་སོས་ཟིན་རྗོད་པར་བྱེད།",
    "གཡས་པ་བརྐྱང་ཞིང་རང་རང་སྣོད་རྣམས་ཀྱིས་ནི་ལྷ་མིན་ཁྲག་འཐུང་སྐྲ་གྲོལ་གོས་དང་བྲལ་བ་སྟེ།",
    "སྣ་ཚོགས་དངོས་རྣམས་ཀྱིས་ཕྱེ་རྒྱལ་བ་དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཉིས་འགྱུར་མི་བདག་གཞན་རྣམས་ཚེས་ནི་བརྒྱད་གཉིས་དབྱེ་བ་ལ།",
    "རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྐང་པ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ།",
    "དེ་ཡི་དུས་སུ་རྒྱལ་པོའི་འགྲོ་བ་དག་ནི་རང་རང་ཚད་ཀྱིས་རྣམ་པར་ཉམས་པར་རབ་ཏུ་འགྱུར།",
    "ཉི་ཤུ་འགའ་ཞིག་ལྷག་པའི་བརྒྱ་ཕྲག་གང་ཞིག་དུས་དང་དགུ་ཡིས་མི་རྣམས་ཀྱི་ནི་འཇིག་རྟེན་ཚད།",
    "ལྷ་དང་རང་འཇིགས་ཕ་མེས་དང་།",
    "བྱེད་སྲིད་གསུམ་མཐའ་དག་དུས་ཀྱི་སྦྱོར་བ་དག་ལས་རབ་ཏུ་སྐྱེས།",
    "བརྒྱ་བྱེན་ལ་སོགས་པ་འདི་དག་མཚོན་ལྡན་འཁོར་གྱི་སྐྱེ་བོ་དང་བཅས་རང་རང་ཕྱོགས་ནི་སྲུང་ཞིང་སྐྱོང་བ་སྟེ།",
    "རང་རང་ལས་ལ་ཉེར་སྤྱོད་པས།",
    "རང་རང་རྒྱུ་བ་ལས་རབ་གྲུབ།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉི་མ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ནི་ཕྱོགས་རྣམས་བྱེད་ཅེས་པ་སྟེ།",
    "དེ་བཞིན་དུ་སྤེན་པ་ཡི་ཡང་མིག་བཅས་མིག་དང་ཉིན་ཞག་དུས་སུ་འགྱུར་ཏེ་རིམ་པ་འདི་ནི་སྔར་བརྗོད་པ་ཡིན་ནོ།",
    "དུས་ཀྱི་ཉིན་ཞག་དུས་ལ་སྟེ་ཉིན་ཞག་དྲུག་ཅུ་རྩ་བཞི་ལ་དེ་ནི་ཆ་དམན་ཟླ་བ་སྟེ་ཟླ་བའི་ཆ་ཉམས་པའོ་ཞེས་པའི་དོན་ཏོ།",
    "འདི་དག་རྣམས་ཀྱང་རང་བཞིན་གསུམ་སྟེ་གཡོ་བ་ལུག་ལ་སོགས་པ་དང་བརྟན་པ་གླང་ལ་སོགས་པ་དང་མཉམ་པ་གཉིས་ཀྱི་རང་བཞིན་འཁྲིག་པ་ལ་སོགས་པའོ།",
    "ཉིན་ཞག་དུས་ཐུན་བརྒྱད་ཀྱི་བདག་ཉིད་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ནར་འགྱུར་རོ།",
    "དེ་དག་ལས་ལྷན་ཅིག་སྐྱེས་པའི་སྐུ་ནི་པདྨ་གསུམ་ལ་རང་བཞིན་དང་རང་བཞིན་མེད་པའི་དབྱེ་བས་སོ།",
    "དེའི་ཕྱིར་གསང་བའི་པདྨ་དང་གཙུག་ཏོར་གྱི་པདྨ་དང་ལྟེ་བའི་པདྨ་ལ་རྣམ་པར་དག་པའི་སྒུ་ལྷག་པའི་ལྷ་སྟེ་རང་བཞིན་རྔེད་པ་མ་བརྟགས་པ་དང་རང་བཞིན་པྲ་ཕབ་པ་ལྟ་བུའོ།",
    "རིགས་པ་འདི་ལས་མངལ་ནས་སྐྱེས་པའི་བྱིས་པ་གང་ཞིག་དུས་མ་ཡིན་པར་འཆི་བར་འགྱུར་བ་༥།",
    "དེ་ཡི་དབུས་སུ་རང་རང་བསམ་པས་མི་བདག་ནི་བོད་པ་སྟེ།",
    "ཞེས་པ་དེབ་འདིའི་ལྡེབ་༥༩༨ང་༡འདི་༦ང་༡༥པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་པེ་སྔ་སྣར་རོལ་ཆད་འདུག་ཁྱེ་པེ་སྣར་གྱི།",
    "གཞན་ནི་ཡོད་པའི་ལུས་ལྔ་ཞེས་པ་ནི་ཁ་ཟས་ཅན་གྱི་ལུས་དང་འོད་ཀྱི་ལུས་དང་རང་བཞིན་ཅན་གྱི་ལུས་དང་།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་པར་༤གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཅི་ལྟར་འགྲོ་ཞེས་པ་ནི་འདིར་སད་པའི་དུས་སུ་སད་པའི་གནས་སྐབས་ཀྱི་མཚན་ཉིད་ཀྱི་བྱ་བ་དང་བཅས་ཤིང་།",
    "འོག་ཏུ་ཡེ་ཤེས་ཀྱི་ཁམས་ལས་སྐྱེས་པ་ཡིད་ནི་ཀུན་ཏུ་བཟང་པོ་ཁ་དོག་སྔོན་པོ་ཞལ་གསུམ་པ་ཕྱག་དྲུག་པ་ཁ་དོག་དུས་ཀྱི་འཁོར་ལོ་ལྟ་བུ་སྟེ་ཤར་གྱི་སྒོའི་གཡོན་དུ་ར་བའི་རྩིག་པ་ལའོ།",
