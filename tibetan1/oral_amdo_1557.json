    "ཁྱོད་ཅག་བློན་པོའི་ཚོགས་རྣམས་ཀུན་ཉོན་དང་།",
    "ཁྱོད་ཚོས་སྨྲས་པའི་གཏམ་དེ་ཅི་ཞིག་ཡིན།",
    "འཛམ་བུ་གླིང་གི་མཐའ་ལ་བྲོས་འགྲོ་སྙམ།",
    "གཙུག་གི་རྒྱུན་གཅིག་དྲི་མེད་ཀུན་ལྡན་དེ།",
    "མནྡེ་བཟང་མོ་སྲས་དང་བཅས་པ་ཡང་།",
    "གྲོང་མི་རྒན་གཞོན་ཁྱེའུ་ཕོ་མོའི་ཚོགས།",
    "མནྡེ་བཟང་མོ་ཡུམ་སྲས་ཀྱི་དགོངས་པ་ལ་ད་རྒྱལ་བུ་གསོད་པ་ལ་འཁྲིད་པ་འདུག་དགོངས་ནས།",
    "མནྡེ་བཟང་མོ་ཡུམ་སྲས་ཀྱི་དགོངས་པ་ལ།",
    "བྱ་བ་མང་པོ་ཁྱོད་ཀྱིས་བྱས་པས་ལན།",
    "མདུན་མ་མང་པོ་ཁྱོད་ཀྱིས་བསྒྲུབས་པས་ལན།",
    "བདུད་རི་ཆེན་པོ་དེ་ལ་ཁྱོད་རྒྱུགས་ལ།",
    "ད་ལྟ་སོང་ལ་ཡུལ་འདིར་མ་སྡོད་ཅིག་ཅེས་གསུངས་པས།",
    "མགོ་ལུས་མེད་པར་ཚེར་མའི་ལྕག་གིས་བྲབས།",
    "དད་ལྡན་བཞིན་དུ་ཉིན་མོ་བསྐོར་བ་བྱས།",
    "བརྐུས་པའི་ནོར་བཞིན་མཚན་མོ་དོང་དུ་སྦས།",
    "བདག་གིས་མྱངས་པའི་སྡུག་བསྔལ་འདི་ལྟ་བུ།",
    "དེ་ནས་ཡང་ཁོང་རང་གི་ནོར་ལྷག་མ་གང་ཡོད་རྣམས་ཀྱང་སྦྱིན་པར་བཏང་ནས།",
    "རྒྱལ་ཕྲན་དྲུག་ཅུས་གསེར་གྱི་དོང་ཙེ་རེ་རེ་ཕུལ།",
    "བློན་པོ་སུམ་སྟོང་གིས་དངུལ་གྱི་དོང་ཙེ་རེ་རེ་ཕུལ།",
    "ཕྱག་ན་ནོར་གཅིག་ཀྱང་མེད་པར་བྱས་ནས་མནྡེ་བཟང་མོ་ལ་སྨྲས་པ།",
    "བཟང་མོ་ཁྱོད་ནི་ང་ལ་ཉན་པར་གྱིས།",
    "ཁྱོད་རང་མ་བུ་བཞི་པོ་དེར་ལོག་ལ།",
    "བཟང་མོ་ཁྱོད་ནི་དེ་སྐད་མ་ཟེར་ཅིག་དགའ་བའི་ཡུལ་ཕྱོགས་སྐྱིད་པའི་ཕ་ཡུལ་ན།",
    "འཇིག་རྟེན་ལས་ནི་བྲན་གཡོག་ཕོ་མོས་བྱེད།",
    "ཉིན་མོ་མི་མེད་མཚན་མོ་འདྲེ་སོགས་མང་།",
    "ཁྱོད་ཚོ་དེ་རུ་ཚུགས་པའི་ས་མེད་པས།་",
    "ཡང་བནྡེ་བཟང་མོས་རྒྱལ་བུའི་ཕྱག་ནས་འཇུས་ཏེ་སྨྲས་པ།",
    "དེས་རིང་བཟང་མོ་སྲོག་དང་འབྲལ་བར་བྱེད།",
    "ཁྱེད་མེད་བདག་གི་བློ་གཏད་པ་སུ་ལ་བཅོལ།",
    "བཟང་མོ་ཁྱོད་ནི་བདག་ལ་ཉན་པར་གྱིས།",
    "འདོད་མི་བྱུང་ན་རང་གི་སྲོག་ཀྱང་སྟེར།",
    "དེ་དུས་ཁྱོད་ཀྱིས་སྦྱིན་པའི་གེགས་བྱེད་པས།",
    "དེ་བས་ཁྱོད་རང་མ་བུ་འདི་རུ་སྡོད།",
    "ཡང་བཟང་མོས་ཞུས་པ།",
    "དེ་ནས་རྒྱལ་བུས་བཟང་མོ་ཡུམ་སྲས་རྣམས་ཕྱག་ཕྱིར་འཁྲིད་པར་ཞལ་གྱིས་བཞེས་སོ།",
    "དགོས་འདོད་རེ་སྐོང་འབྲས་བུ་སྨིན་པའི་མ།",
    "ཡུམ་ཆེན་ཨ་མ་བདག་ལ་ཚུར་གསོན་དང་།",
    "བདག་གིས་ནོར་བུ་དཔུང་འཇོམས་དགྲ་ལ་བྱིན།",
    "དང་པོ་སྐྱེས་པའི་ཨ་མ་ང་ཡིན་མོད།",
    "མི་ལོ་བཅུ་གཉིས་རྒས་མོའི་ཚེས་མི་ཐུབ།",
    "ཁྱེད་མེད་བདག་གི་བློ་གཏད་སུ་ལ་བྱེད།",
    "དེ་ནས་ཡུམ་གྱི་ཐུགས་ལ་བདག་གི་བུ་འདི་ལམ་ཐག་རིང་པོ་ལ་འགྲོ་དགོས་པར་ངས་དུས་ན་བཀྲ་མི་ཤིས་པ་འདུག་དགོངས་ནས།",
    "བདག་གི་བུ་འདི་ལམ་དུ་ཞུགས་པའི་ཚེ།",
    "ལྷ་ཡི་བུ་མོས་བསིལ་གྲིབ་བྱེད་པར་ཤོག་མི་མེད་འཇིགས་པའི་རི་ལ་སྡོད་པའི་ཚེ།",
    "དེ་ནས་ཡུམ་དགེ་ལྡན་བཟང་མོས་ཐོག་དྲངས་བཙུན་མོ་ཕྱེད་དང་ཉིས་སྟོང་དང་།",
    "བདག་གི་ཡུམ་ཆེན་ལ་སོགས་བཙུན་མོའི་ཚོགས།",
    "དེར་ཡུམ་དགེ་ལྡན་བཟང་མོས་རྒྱལ་བུའི་ཕྱག་ནས་འཆང་སྟེ་སྨྲས་པ།་",
    "ཨ་མའི་དྲི་མེད་ཀུན་ལྡན་དོན་གྲུབ་དཔལ།",
    "ཚེ་འདིར་འགྲོ་བའི་ཉི་མ་ནུབ་ནས་སོང་།",
    "མི་འོས་འདི་འདྲའི་ལས་རིགས་བྱེད་དུ་བཅུག་བྱང་སེམས་ལྡན་པའི་བུ་ཁྱོད་ད་བྱོན་ལས།",
    "བུ་ཁྱོད་བསམ་པ་ཡིད་ལ་འཁོར་རེ་ཡོང་།",
    "དབྱར་གསུམ་གཡུ་འབྲུག་སྔོན་མོའི་སྐད་ཅིག་ཡོང་།",
    "དེ་དུས་བུ་ཁྱོད་དྲན་པའི་གསལ་འདེབས་བྱེད།",
    "མ་ངས་བུ་ཁྱོད་ཟེར་ཞིང་ལན་གསུམ་འབོད།",
    "བུ་ཁྱོད་ཨ་མ་ཟེར་ཞིང་ལན་གསུམ་འབོད།",
    "དགེ་ལྡན་བཟང་མོ་ཟེར་ཞིང་ལན་གསུམ་འབོད།",
    "དེ་དུས་བུ་ཁྱོད་དྲན་པའི་གསལ་འདེབས་བྱེད།",
    "མ་ངས་བུ་ཁྱོད་ཟེར་ཞིང་ལན་གསུམ་འབོད།",
    "བུ་ཁྱོད་ཨ་མ་ཟེར་ཞིང་ལན་གསུམ་འབོད།",
    "དགེ་ལྡན་བཟང་མོ་ཟེར་ཞིང་ལན་གསུམ་འབོད།",
    "དཔྱིད་གསུམ་ཁུ་བྱུག་སྔོན་མོའི་སྐད་ཅིག་ཡོང་།",
    "དེ་དུས་བུ་ཁྱོད་དྲན་པའི་གསལ་འདེབས་བྱེད།",
    "མ་ངས་བུ་ཁྱོད་ཟེར་ཞིང་ལན་གསུམ་འབོད།",
    "བུ་ཁྱོད་ཨ་མ་ཟེར་ཞིང་ལན་གསུམ་འབོད།",
    "དགེ་ལྡན་བཟང་མོ་ཟེར་ཞིང་ལན་གསུམ་འབོད།",
    "ཕྱི་མིག་ཅིག་གཟིགས་པས་སྐྱེལ་མི་རྣམས་ཐག་རིང་པོར་སླེབས་པ་མཐོང་ངོ།",
    "འབྱོར་ཚད་དཔག་མེད་རིན་ཆེན་གླིང་གི་ནོར།",
    "བདག་གིས་ཁྱེད་ལ་སྦྱིན་པ་བྱིན་ཡོང་ཨང་།",
    "དེ་ནས་ཡང་བྱོན་པས་དཔག་ཚད་གཅིག་གི་སར་ཕེབས་པ་དང་།",
    "དེ་ནས་རྒྱལ་བུ་རང་གིས་ལམ་སྣེ་དྲངས།",
    "སྲས་ལྕམ་སྲིང་གསུམ་བར་དུ་བཅུག་མནྡེ་བཟང་མོས་ལམ་རྒྱགས་དུམ་གཅིག་ཁུར་ནས་མཇུག་ཏུ་བྱོན་པསུ།",
    "དེའི་ཚེ་མནྡེ་བཟང་མོས་ཆུ་འདུག་པ་དེའི་རྩར་ཕྱིན་ནས།"
  ]
}