    "རེག་ལ་རྣམ་གསུམ་ཤེས་བྱས་ནས།",
    "མི་བསྐྱོད་པའི་ཚུལ་བསྙེས་པ་སྟེ་མི་བསྐྱོད་པའི་ངོ་བོར་མོས་ནས།",
    "བདག་གི་རིགས་ཏེ་རྡོ་རྗེའི་རིགས་ཀྱི་ལྷ་རྣམས་ལ་ནི་དབུལ་བར་བྱའོ།",
    "༦༣ན་གཟུགས་སྒྲ་རོ་ལ་སོགས་པ་ལྔ་རིགས་ལྔའི་ངོ་བོར་མོས་ཏེ།",
    "གཟུགས་སྒྲ་དྲི་སོགས་སྔགས་པ་ཡིས་ཤེས་རབ་ཀྱི་ལྷ་ཉིད་དུ་ནི་རྟག་ཏུ་བསྒོམ་མོ།",
    "དྲི་གོས་དཀར་མོ།",
    "རོ་སྒྲོལ་མར་བསྒོམ་ཞིང་མཱ་མ་ཀཱིས་རིགས་གཉིས་འཛིན་པ་ཡིན་པས་རེག་བྱ་ཡང་མཱ་མ་ཀིར་བསྒོམ་མོ།",
    "རེག་རེག་རྡོ་རྗེ་མར་བསྒོམ་མོ།",
    "གཟུགས་སྒྲ་དྲི་རོ་རེག་བྱ་ལྔ་པོ་རེ་རེ་ལ་ཡང་སྣང་བའི་ཡེ་ཤེས་ཀྱི་འབྲས་བུར་གྱུར་པའི་རང་བཞིན་གྱི་རྟོག་པའི་ཡུལ་དང་།",
    "དེ་ཐམས་ཅད་རྡོ་རྗེ་འཆང་གི་ངོ་བོར་བལྟས་ནས་མཉམ་གཞག་ཏུ་ཉམས་སུ་མྱོང་བའི་སྣང་མཆེད་ཐོབ་གསུམ་གྱི་ཡེ་ཤེས་ཀྱིས་རྒྱས་བཏབ་ནས་ལོངས་སྤྱད་པར་བྱ་བའོ།",
    "སྤྱི་དོན་དུ་གང་སོང་བ་དེ་ཉིད་ཀྱང་ཡིག་དོན་དུ་སོང་བའི་དོན་གྱིས་ཡིན་ནོ།",
    "རིགས་ནི་ཐ་མལ་པའི་ལུས་ངག་ཡིད་གསུམ་མོ།",
    "རིམ་གཉིས་ཐུན་མོང་བའི་སྙོམས་འཇུག་གི་ཆོ་ག།",
    "བསྐྱེད་རིམ་པའི་སྙོམས་འཇུག་གི་ཆོ་ག་བྱེ་བྲག་ཏུ་བསྟན་པའོ།",
    "རྣམ་སྣང་གི་རིགས་ཀྱི་སྒྲུབ་པ་པོས་ནི།",
    "དེ་བཞིན་གཤེགས་པའི་བཙུན་མོའི་༦༤བ་མཆོག་སྤྱན་མར་བསྒོམ་མོ།",
    "དེ་བཞིན་དུ་རིན་འབྱུང་གི་རིགས་ཀྱི་སྒྲུབ་པ་པོས་མཱ་མ་ཀཱི་དང་།",
    "རང་གི་གསང་གནས་མི་དམིགས་པའི་ངང་ལས་ཧཱུཾ་ལས་བྱུང་བའི་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པའི་རྭ་དབུས་མའི་ནོར་བུ་ལ་ཨོཾ་གྱིས་མཚན་ཞིང་བུ་ག་ཡི་གེ་ཕཊ་སེར་པོས་བཀག་པ།",
    "དེ་དག་གི་འབྲས་བུ་བསྟན་པའོ།",
    "དཀྱིལ་འཁོར་༦༥ན་རྗེས་དྲན་གྱིས་ཟུང་འཇུག་གི་དཀྱིལ་འཁོར་རྒྱལ་མཆོག་བསྟན་པ།",
    "འོད་གསལ་ལས་ཟུང་འཇུག་ལོངས་སྐུ་རྡོ་རྗེ་འཆང་གི་སྐུར་བཞེངས་པའོ།",
    "བདག་གི་རྡོ་རྗེ་ནི་ལྕེ་དང་།",
    "ལྕེ་རྩེ་ལྕེ་ཆུང་བའི་རྩེ་མོ་གཉིས་སྦྱར་ནས་དྲུད་པའོ།",
    "ཀླད་རྒྱ་ན་གནས་པའི་རང་གི་ཁུ་བའི་ཐིག་པ་ལྕེ་ཆུང་བའི་ལམ་ནས་བརྒྱུད་དེ་ལྕེའི་སྟེང་དུ་བབས་པ་ཡིས།",
    "རང་གི་ཁུ་བ་དག་རྣལ་འབྱོར་པས་ནི་རྟག་ཏུ་ཡུམ་གྱི་པདྨར་དབྱུང་ཞིང་།",
    "གསང་བའི་བདག་པོ་བློ་སྟེ་ཤེས་རབ་༦༦ན་རེག་བྱ་རྡོ་རྗེ་མ་དང་ལྡན་པ་ཀུན་ཏུ་བཟང་པོ་མི་བསྐྱོད་པ་ཐུགས་གང་ཡིན་པ་ལྟ་བུ་ནི།",
    "བདག་གི་སེམས་གཉིས།",
    "ཡུལ་དེ་ཁོ་ན་ཉིད་དང་ཡུལ་ཅན་བདག་གི་རོ་གཅིག་ཏུ་གྱུར་ཅིག་པའོ།",
    "ནམ་མཁས་ཏེ་དེ་ཁོ་ན་ཉིད་ཀྱི་དོན་དང་བདག་གི་སེམས་གཉིས་མཚུངས་པ་སྟེ་རོ་གཅིག་ཏུ་སྤྱོད་པར་འགྱུར་རོ།",
    "གིས་བརྗོད་བཞིན་པ་ན་ཐུགས་ཏེ་སེམས་ཇི་ལྟར་བརྗོད་པའི་སྐུའི་རྣམ་པར་ཡོངས་སུ་ཤེས་པ་ནི།",
    "ཞེས་ཡིད་ཀྱི་བཏགས་པ་ནི་གསུང་གི་སྐུ་ཡང་རྣམ་པར་བསྒོམ་མོ།",
    "དམ་ཚིག་གི་སྐད་དོད་ས་མ་ཡ་ལ་ས་མ་ཏ་ཞེས་བྱས་ན་མཉམ་པ་ཉིད་ཅེས་པ་སྟེ།",
    "དགོངས་པ་གང་གི་ཕྱིར་དུ་ན།",
    "མཆོག་གི་དངོས་གྲུབ་རབ་ཏུ་ཐོབ་པར་འགྱུར་རོ།",
    "བསྐྱེད་རིམ་པའི་ལྷག་མོས་འོད་གསལ་དུ་སྡུད་པ་དང་།",
    "ཤེར་ཕྱིན་དང་མ་སྐྱེས་པ་རྗེས་དྲན་གྱིས་འོད་གསལ་དུ་ཞུགས་ནས་ཟུང་འཇུག་གི་སྐུར་ལྡང་ཚུལ་བསྟན་པ་དང་།",
    "དེ་ལ་ཤེས་རབ་ནི་སྣང་མཆེད་ཐོབ་གསུམ་མོ།",
    "འོད་གསལ་དེ་རིལ་འཛིན་དང་རྗེས་གཞིག་གི་བསམ་གཏན་གཉིས་ཀྱི་སྒོ་ནས་རྗེས་སུ་དྲན་པ་ཇི་ལྟར་བསྒོམ་ཞེ་ན།",
    "དོན་གྱི་འོད་གསལ་གྱི་དོན་གཉིས་སྣང་གི་སྤྲོས་པ་མེད་པས་ཟག་པ་མེད་པའོ།",
    "ཟུང་འཇུག་གི་སྐུ་དེ་ཡང་ཇི་ལྟ་བུ་ཞེ་ན།",
    "སྡུག་བསྔལ་ཉེ་བར་ཞི་ཞིང་ཉོན་མོངས་པ་མ་ལུས་པར་སྤངས་པས་ཤིན་ཏུ་དྲི་མ་མེད་ཅིང་།",
    "ལུས་ཀྱི་རེག་པར་བྱ་བ་མ་ཡིན་པས་ནམ་མཁའ་བཞིན་ནོ།",
    "བུད་མེད་སེམས་ནི་རབ་ཏུ་བསྟེན་པ།",
    "སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེ་གསུམ་དབྱེར་མི་ཕྱེད་པའི་རྡོ་རྗེ་འཆང་གི་གོ་འཕང་ཚེ་འདི་ཉིད་ལ་ཐོབ་པར་འགྱུར་རོ།",
    "སྡུད་པ་པོའི་ཚིག་གིས་མཚམས་སྦྱར་བ།",
    "སྡུད་པ་པོའི་ཚིག་གིས་སྟོན་པའི་གསུང་ལ་འཇུག་པ་དང་།",
    "མཚན་དཔེས་བརྒྱན་པའི་གཟུགས་བཟང་ཞིང་ལང་ཚོ་གཞོན་པས་བརྒྱན་པ་ནི།",
    "བྱོལ་སོང་གི་སྐད་དོད་ཏིར་ཏི་ཀ་ཞེས་པ་ལོག་ན་ཡོད་པ་ལ་ཡང་འཇུག་པས།",
    "དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་ལས་ལོགས་ན་ཡོད་པའི་འཁོར་གྱི་ལྷ་རྣམས་ཀྱང་རྡོ་རྗེ་འཆང་གི་ངོ་བོར་རབ་ཏུ་བརྟག་པར་བྱའོ།",
    "རྒྱལ་བ་རྡོ་རྗེ་འཆང་གི་རིགས་སུ་སྐྱེས་པའི་སྔགས་པ་དང་།",
    "ཉིན་རེ་བཞིན་རབ་ཏུ་བྱའོ།",
