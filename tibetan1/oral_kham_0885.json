    "རང་རང་མཐུན་པའི་འདོད་ཡོན་དང་།",
    "རང་རང་རིགས་ཀྱི་སྡུག་བསྔལ་དང་།",
    "ཨ་བྷི་ཥེ་ཙ་ནི།",
    "རང་རང་བློ་དང་མཐུན་པ་ཡི།",
    "རང་རང་མཐུན་རྫས་ལོངས་སྤྱོད་ཀྱི།",
    "རང་རང་གནས་སུ་འགྲོ་བར་གྱིས།",
    "ས་བདག་དང་གཉན་རྣམས་ཀྱང་ཀླུའི་འཁོར་དུ་གཏོགས་པར་གྱུར་པ་གཞུང་མང་པོར་གསུངས་འདུག་པས།",
    "དིང་རིར་ས་གནས་གཞན་ནས་རང་རང་ཐོན་ཁུངས་ཚོང་འཁོས་སུ་ཡོང་མཁན་ལྷ་རྩེ་ནས་བོད་སྣུམ་དང་།",
    "ཕྱིས་ཀྱང་རྒན་རབས་ཚོས་སྔོན་མ་གྲོགས་རྣམ་གྱིས་བཀའ་སློབ་གནང་བ་དེ་ཚོ་ཡང་དག་པ་དང་བཀའ་དྲིན་བསྐྱངས་འདུག་ཞེས་ཤོད་ཀྱི་འདུག་གྲགས་པ་རྣམ་རྒྱལ་གྱིས་བཀའ་བླའི་ལས་བྱ་བྱེད་སྐབས་སྤྱིར་ན་བོད་གཞུང་ལ་ལྷག་བསམ་ཆེ་བ་དང་།",
    "གོང་གསལ་མཁན་དྲུང་དེས་བསྡུས་པའི་གོ་ལག་དེ་རྣམས་གྲགས་རྣམ་གྱིས་ཚོ་པ་སོ་སོར་ཕྱིར་སྤྲོད་བྱས་ཐོག་འཆི་མེད་ཤེ་འབྲི་ལ་བསྒྱུར་ཏེ་ཁྲལ་ནག་རྒྱུན་འབྱར་གྱིས་ལོ་ལྟར་ཤེ་མར་ཡང་འཇལ་སྒྲུབ་བྱེད་དགོས་པ་དེ་ལ་མི་སེར་ནས་མེ་ཤེ་ཞེས་ཟེར་སྲོལ་ཡོད་འདུག་གཞན་ཡང་ཡུལ་གྱི་འབོ་བྲེ་རྒྱ་གསུམ་སྔོན་མ་གཅིག་མཐུན་མེད་པ་དེ་རྗེས་སུ་ས་རྟ་གསར་བཟོས་ཟེར་བའི་ཡི་གེ་ཡོད་པའི་འབོ་བྲེ་རྒྱ་གསུམ་གྱི་ངོས་ལ་ཧོར་སྤྱིའི་ལས་ཐམ་འབྱར་མ་ཤོག་ཁ་སོ་སོར་བཀྲམ་པ་དེ་དག་ལ་གཅིག་མཐུན་གྱི་རྩ་བའི་ཚད་གཞི་འཛིན་དགོས་པ་དང་།",
    "དཔེར་ན་ཀྲོག་ཇིས་མགོ་ཟེར་བ་ཞིག་ཡོད་པ་དེས་རྣམ་ཀུན་ཁོ་རང་དཔའ་བོ་ཡིན་ཟེར་ཞིང་།",
    "རྒུན་ཆང་ཕུལ་ཏེ་ང་རང་དཔའ་ཤོད་དུ་མ་ཉེས་ཁ་གཡོག་བཀལ་ནས་ཆགས་ཐབས་མེད་ལུགས་མང་པོ་ཞུས།",
    "སེར་འདོན་རྒྱ་ཆུང་ཤོས་དང་འཁོས་ཞན་ཉམས་ཐག་ཐོག་འཁྲི་འཁེལ་བྱུང་ཐོག་ཕོགས་ཁང་ནས་འབྲུ་འབབ་རྣམ་གྲངས་ཚང་འཕྲལ་དུ་བསྡུ་ལེན་གྱིས་དམག་ཕོགས་རྒྱབ་ཆོག་ཨང་གསར་དགོས་ལུགས་ནན་བརྗོད་བཅས་བྱས་པར་བརྟེན་འབྲུ་ཁལ་ཙམ་སྔོན་ནས་བསྡུས་ཟིན་འདུག་དེ་འཕྲོས་འབུལ་རྒྱུ་ལྟ་ཅི།",
    "མེ་མདའ་རིང་མདའ་རྙིང་པ་སྐྱོན་ཡོད་བཅས་འདུག་པ་གཞུང་ལེན་བྱས་ཐོག་འདི་དག་ཇི་ལྟར་ཞུ་འགབ་ཆེ་མིན་སྐོར་ཨ་དྲུང་ཕྱིར་ལོག་གདོང་སྙན་འབུལ་ཞུས།",
    "ཡི་གེ་འདྲ་མིན་སྣ་ཚོགས་ལ་རང་རང་སོ་སོས་རང་མཚམས་ཀྱིས་མཆན་བཀོད་བྱས་འདུག་པའི་ནང་རྟ་ཁལ་མང་བར་ནས་སྐོར་དང་།",
    "བརྡ་འདེད་བྱེད་ཐབས་བྲལ་བ་ཞིག་འདུག་ཡི་གེ་དང་།",
    "ལྡིང་དཔོན་རིམ་ཅན་ཡིན་འདུག་པས་སྐབས་དེར་འདུ་ཁོངས་ཚང་འཛོམས་སར་ད་ལམ་རིང་གཙོ་དྲག་དང་།",
    "རྟ་སློག་ཅིག་ཀྱང་མཉམ་འཁྲིད་བྱས་འདུག་དེ་འཕྲལ་མི་སེར་ལྡིང་རྒན།",
    "ཤོར་འཇལ་འབོ་བསྡུར་རྒྱག་སྐབས་བྲེ་དོ་ལྷག་ཙམ་ཧེ་བག་རྒྱུགས་འདུག་པས།",
    "སྣང་ཆུང་ལྷོད་གཡེང་གཏན་ནས་མེད་པ་དགོས་རྒྱུ་ཞེས་འཁོད་འདུག་བཀ།",
    "རང་རང་བརྟུལ་ཞུགས་དག་ལས་ཕྱིར་བསྐྱོད་དེ།",
    "གང་ཤར་ལྟ་རྙིང་མ་རྣམས་ལ་བྱུང་ནས་གདའ།",
    "ལམ་དེ་ལ་གོལ་ས་མི་འདུག་གོ།",
    "ཡུད་ཙམ་འདུག་པའི་ངེས་པ་མ་མཆིས་ཤིང་།",
    "གཏན་བདེའི་ས་བོན་ཅུང་ཟད་བཏབ་འདུག་གམ།",
    "འདུག་སྟངས་ཀྱི་ངེས་པ།་",
    "སྐུ་དེ་དག་ལས་ལྷན་ཅིག་སྐྱེས་པའི་སྐུ་ནི་པད་མ་གསུམ་ལ་རང་བཞིན་དང་རང་བཞིན་མེད་པའི་དབྱེ་བས་བཞུགས་སོ།",
    "རྡོ་རྗེའི་འདུག་སྟངས་ལ་སོགས་པ་ནི་འཆད་པར་འགྱུར་བ་ལས་བརྗོད་པར་བྱའོ།",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཇི་ལྟར་འགྲོ་ཞེས་པ་ནི་འདིར་སད་པའི་དུས་སུ་བདག་དེ་སད་པའི་གནས་སྐབས་ཀྱི་མཚན་ཉིད་ཀྱི་བྱ་བ་དང་བཅས་ཤིང་དང་ཡིག་ལས་རྟག་པ་ཡང་ཡིན་ན་དེའི་ཚེ་བདག་གཉིད་ལོག་པའི་དུས་སུ་བྱ་བ་དང་བྲལ་བ་རྨོངས་པ་ཉིད་དུ་ཇི་ལྟར་འགྲོ་བྱ་བ་དང་བཅས་པར་རྟག་པའི་ཕྱིར་རོ།",
    "ཕྱག་རྒྱ་བྱ་བ་འདུག་སྟངས་དང་།",
    "ཕྱག་རྒྱ་འདུག་སྟངས་སྟངས་སྟབས་དང་།",
    "གལ་ཏེ་འཆད་པར་འགྱུར་བའི་འདུག་སྟངས་བཅིངས་ནས་ཐུན་ཚོད་གཅིག་ཏུ་སྦྱིན་སྲེག་བྱེད་པར་མི་ནུས་ན་དེའི་ཚེ་ཐུན་ཕྱེད་གཅིག་སྦྱིན་སྲེག་བྱས་ནས་བསྒྲུབ་པར་བྱ་སྟེ་གཉི་ག་གསུངས་སོ།",
    "འདུག་སྟངས་ཀྱི་ངེས་པ། ད་ནི་ཞི་བ་ཞེས་པ་ལ་སོགས་པས་ཞི་བ་ལ་སོགས་པའི་ལས་བསྒྲུབ་པའི་དོན་དུ་འདུག་སྟངས་རྣམས་གསུངས་ཏེ་འདིར་ཞི་བ་ལ་སོགས་པ་ལ་རིམ་པས་འདུག་སྟངས་རྣམས་སུ་འགྱུར་རོ།",
    "རྒྱས་པ་ལ་རྡོ་རྗེའི་འདུག་སྟངས་ནི་རྐང་པ་གཡས་པ་བརླ་གཡོན་པའི་སྟེང་དང་གཡོན་པ་ཡང་བརླ་གཡས་པའི་སྟེང་དུ་སྟེ་ཐད་ཀར་གན་རྐྱལ་གྱིས་སོ་ཞེས་པ་ནི་རྡོ་རྗེའི་འདུག་སྟངས་སོ།",
    "ཞེས་པ་ནི་ལྷ་མིན་གྱི་འདུག་སྟངས་སོ།",
    "འདུག་སྟངས་ཀྱི་དབྱེ་བ་རྣམ་པ་བརྒྱད་ཀྱི་ངེས་པའོ།",
    "མ་འདུག་སྟེ་ཐིག་གདབ་པར་བྱ་འོ།",
    "དེ་ནས་སློབ་དཔོན་དཀྱིལ་འཁོར་གྱི་ཤར་དུ་དཀྱིལ་འཁོར་ལ་མངོན་དུ་ཕྱོགས་པས་འདུག་སྟེ་ཁ་",
    "ད་ངའི་སྙན་ངག་ལ་ཉན་མཁན་གཅིག་ཀྱང་མི་འདུག་ཅེས་པའམ།",
    "ང་ལ་སྙན་ངག་རྩོམ་པའི་བློ་གྲོས་འདི་ཙམ་གནང་བ་དེ་དྲང་པོ་བྱས་མི་འདུག་གལ་ཏེ་ང་ལ་སྙན་ངག་རྩོམ་པའི་བློ་གྲོས་འདི་ཙམ་གནང་བ་ཡིན་ན།",
    "དགུ་ཆ་ཚང་སྟེར་ཐུབ་མཁན་ཞིག་འདུག་ན་རྩོམ་རིག་དེ་ཕུན་སུམ་ཚོགས་པ་ཞིག་ཡིན་ལ།",
    "མི་རིགས་འདི་གཉིས་ལ་ག་དུས་འབྲེལ་བ་བྱུང་བ་ཡིན་ནམ།",
    "དེའི་དབྱིན་ཇིའི་འགྱུར་བཅས་ཕྱི་ལོ་༡༩༥༦ ལོར་རོམ་ནས་དཔར་འདེབས་བྱས་འདུག།",
    "ཞེས་བཀོད་འདུག་པ་ལ་གཞིགས་ན་རྒྱ་དཔེ་འགའ་ཞིག་ཏུ་བློཀ་བདུན་ཅུ་པ།",
    "ད་ལྟ་བཞུགས་པའི་རྒྱ་དཔེར་ཚན་པ་ཆུང་ངུ་སོ་གཉིས་སུ་དབྱེ་འདུག་རུང་།",
    "བོད་སྐད་དུ་དེ་འདྲའི་ཚན་པ་མ་ཕྱེ་བར་འདུག།",
    "དབྱིག་གཉེན་གྱིས་དོན་གྱི་གནས་བདུན་དུ་བསྡུས་ཏེ་བཀྲལ་འདུག་པ་འདི་ལྟ་སྟེ།",
    "མི་ཆུད་པ་ཅི་རིགས་ཤིག་འདུག་ནའང་།",
    "རྐྱེན་ངན་དགེ་གྲོགས་ཟེར་བ་དོན་ལ་གནས་པ་འདུག་སྙམ་པ་བྱུང་།",
    "འོན་ཀྱང་ངོས་ཀྱི་མཐོང་སྣང་དུ་འཕགས་བོད་ཀྱི་མཁས་གྲུབ་ཕལ་ཆེར་དེ་འདྲའི་ཐུགས་ཕམ་མ་བྱུང་བ་མེད་པ་ལྟ་བུ་ཞིག་འདུག་སྟེ།",
    "ཞེས་སྡུག་སྐད་ཆེན་པོ་སྐྱོན་དགོས་བྱུང་འདུག།",
    "ཡང་ན་ཁོ་རང་ལས་སྙན་ངག་རྩོམ་པའི་རིག་རྩལ་དེ་ཕྱིར་བཞེས་གནང་རྒྱུ་དང་།",
    "ཞེས་བསྟིང་ཚིག་བརྗོད་འདུག་པ་དང་།",
    "ཞེས་སྡུག་སྐད་ལྷང་ལྷང་སྐྱོན་འདུག་པ་ནོ་བལ་ཞེས་བྱ་༦ སྤྱོད་འཇུག་ལེའུ་བཅུ་པ།",
    "དེའི་ནང་ནས་ཀྱང་ཚིགས་བཅད་ཀྱི་རྩོམ་འགྲོས་ཧ་ཅང་ལེགས་པ་ཞིག་འདུག་སྟེ།",
    "ཆུ་བོ་གངྒཱ་ཞེས་པ་གང་འདྲ་ཞིག་འདུག་དྲིས་པར་ཟམ་པའི་སྒང་ནས་མར་བལྟས་ན་ཆུ་བོའི་བབས་ཕྱོགས་གང་དུ་ཡིན་མིན་མི་ཤེས་པ་ཞིག་འདུག་སོགས་བྱིས་པ་ངོ་མཚར་བསྐྱེད་པའི་གཏམ་དུ་མ་ཐོས་ཤིང་།",
    "ཞེས་པའི་བློཀ་གཉིས་འདུག་པ་ཧ་ཅང་ཡིད་ལ་འཐད་པས་ལན་འགའ་བཀླགས་པ་དང་།",
    "ཁོ་བོའི་ཡོངས་འཛིན་དམ་པ་དེས་ཀྱང་གནས་ཡིག་འདི་ཧ་ཅང་ཡག་པོ་འདུག་ཅེས་མཉེས་མཉེས་མཛད་པ་ད་ལྟའང་དྲན།",
    "ཤོག་ལྡེབས་བཞི་བརྒྱ་ལྷག་ཙམ་ཞིག་ཡོད་འདུག་སྟེ།",
    "འདིའི་ནང་གཙོ་ཆེ་བོད་དུ་བཞུགས་པའི་ལེགས་སྦྱར་གྱི་རྒྱ་དཔེ་རིན་ཐང་བྲལ་བ་དེ་རྣམས་ཀྱི་དཀར་ཆག་བཀོད་འདུག་པར་བརྟེན་འདི་གའི་གཙུག་ལག་སློབ་ཁང་ནས་དཔར་འགྲེམས་བྱེད་རྒྱུ་འོས་འཚམས་ཡིན་ཚུལ་སྐུ་ངོ་ངག་དོན་གྱིས་གསུངས་པ་དེ་བཞིན་ཐུགས་ཤིན་ཏུ་མད་པ་དང་།",
    "གནས་ཚུལ་ཧ་ཅང་གལ་ཆེ་མང་པོ་འདུག་པ་མ་ཟད།",
    "སྐབས་དེར་ཁོ་རང་དགུང་ལོ་སོ་གཉིས་སོན་པས་འཁྲུངས་ལོ་རབ་བྱུང་བཅོ་ལྔ་པའི་ཆུ་སྟག་ཕྱི་ལོ་༡༩༢ ཡིན་པ་བཅས་གསལ་བར་གྲུབ་པས།",
    "བརྩོན་ཁང་དུ་བཞུགས་ལོ་སོགས་ཀྱི་ལོ་ཚིགས་ལ་ངེས་བརྟན་སུ་ལའང་མི་འདུག་ན།",
    "གཞུང་འདིའི་ནང་བོད་དུ་བཞུགས་པའི་རྒྱ་དཔེའི་དཀར་ཆག་བཀོད་གནང་མཛད་པ་དེ་དག་དུས་ཡུན་ཐུང་ངུའི་ནང་བྲེལ་འཚབ་ཀྱིས་བྲིས་པས་ཡིན་ནམ་གང་ལྟར་དཔྱད་དགོས་པ་འགའ་ཞིག་འདུག་ཅིང་།",
    "ཞེས་བཀོད་འདུག་ཀྱང་།",
    "རང་འགྲེལ་རྟོག་གེ་འབར་བ་གཉིས་ཀ་གླེགས་བམ་གཅིག་ཏུ་བཞུགས་པ་ཞིག་ཡིན་འདུག།",
    "ཤོག་གྲངས་༡༥ གསལ་བ་དེར་རཱཧུལ་གྱི་ཐོའི་ནང་ཆ་མ་ཚང་ཞེས་བྲིས་འདུག་ཀྱང་།",
    "༧ ཞེས་བཀོད་འདུག་པ་འདི་ཡང་།",
    "ཞེས་འཁོད་འདུག་ཀྱང་།",
    "དཔེ་འདིའི་སྔ་ལོགས་ཉིད་དུ་ཀུམཱརཙནྡྲས་མཛད་པའི་བཛཱབྷེརཏནྡྲཔཎྜིཀ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་རྒྱུད་ཀྱི་དཀའ་འགྲེལ་རཱཧུལའི་དཔེ་ཐོར་འཁོད་འདུག་པ་དེ་འདིར་མི་གསལ་བས་དཔེ་གཉིས་མཉམ་བསྲེས་ཀྱིས་ནོར་བར་སྣང་།",
    "ལྷག་མ་གསུམ་མཛད་བྱང་མེད་པར་གསལ་འདུག་ཀྱང་།",
    "རཱཧུལའི་དཔེ་ཐོར་སྐད་ཅིག་འཇིག་པར་གྲུབ་པ་མ་གཏོགས་གཞན་རྣམས་རཏྟཀིརྟིས་མཛད་པར་བྱས་འདུག།",
    "གཉིས་མེད་ཀྱི་སེམས་དཔྱོད་པའི་རབ་བྱེད་ཅེས་པ་དེ་རཱཧུལ་གྱི་ཐོར་རཏྟཀིརྟིས་མཛད་པ་བྱས་འདུག་ཀྱང་།",
    "ཡན་ལག་ཅན་མེད་པ་ཡང་རཱཧུལའི་དཔེ་ཐོར་རཏྟཀིརྟིས་མཛད་པར་བྱས་འདུག་ཀྱང་།",
    "ཞེས་གདུངས་ཡུས་ཆེན་པོ་མཛད་འདུག་པ་ལྟར་སྐྱེས་མ་ཐག་ཏུ་མ་ཤི་ཡང་།",
    "ཡལ་ཟིན་འདུག།",
    "དམངས་སྒྲའི་ཤན་ད་བར་མ་ཞུགས་འདུག་པ་སྟབས་ལེགས་སྙམ།",
    "འབོད་བསྐུལ་དེའི་གྲུབ་འབྲས་ཐུགས་བློ་ཁེངས་པ་ཞིག་དུས་ཡུན་འོས་འཚམས་ནང་མ་བྱུང་ཚེ།",
    "བཙོན་འཇུག་སྡུག་སྦྱོང་མནར་གཅོད་ཇི་ཙམ་བྱུང་ཡང་རང་ངོས་ནས་གནོད་ལན་གནོད་པས་འཇལ་བ་དང་།",
    "བྱས་ཀྱང་རང་ཤི་རྒྱབ་པ་ཙམ་ལས་མེད་ཚུལ་དགོངས་མཁན་མང་རུང་།",
    "ད་ཡང་གཅིག་འགལ་བཞག་ཟེར་གྱི་འདུག་ཅེས་སུན་སྣང་བྱས་ནས།",
    "དེ་ནི་མི་རྣམས་ལོ་ན་ཆུང་ངུ་ནས་བསམ་བློའི་གོམས་གཤིས་ཀྱི་ནང་རང་བཞིན་གྱིས་འཇགས་པ་ཞིག་མ་བྱུང་ན་མི་ཡོང་།",
    "ཚིག་མཛོད་འགའ་ཤས་ནང་དྭོགས་གཅོད་ཀྱང་བྱས་འདུག་ཅིང་།",
