    "ཚོང་ར་དང་ཁྱིམ་གྱི་བར་ལ་ཕལ་ཆེར་ལེ་དབར་བཞི་ཙམ་འདུག་ལ།",
    "ངས་ཕྱོགས་བཞིར་བལྟས་ཙ་ན་ཚོང་རར་འབྲས་འཚོང་མཁན་མང་བོ་འདུག་ལ།",
    "འབྲས་འཚོང་མཁན་གྱིས་གོང་དམའ་འདུག་བསམ་ནས་རིན་གཏམ་རྒྱུ་བྱས།",
    "ང་རང་ཅུང་ཟད་ངོ་གནོང་བར་བྱས།",
    "གོན་པའང་རྒྱབ་ལ་འབྱར་འདུག་ཅིང་།",
    "ང་རང་འཁྱག་བག་བཟའ་བར་ཧ་ཅང་དགའ་ཞིང་།",
    "དེ་རུ་ཧད་ནས་མ་འདུག་ངས་ལག་ཕྱིས་དང་།",
    "ཡིན་ཡང་ང་རང་ཨ་ཐང་ཆད་དྲགས་པས།",
    "མིག་ཀྱང་རང་ལས་ལྷག་པའི་ཡུལ་འཛིན་པའི་ཕྱིར་ཡུལ་མ་ཕྲད་པ་འཛིན་པ་ཡིན་ཏེ།",
    "དེས་ན་ཉི་མ་དང་ཟླ་བ་ལ་སོགས་པ་ཐག་རིང་པོ་ན་འདུག་པ་ལ་ལྟ་བས་ནི་ཡུན་རིང་པོས་མཐོང་བར་འགྱུར་ལ།",
    "སྣ་མའི་མེ་ཏོག་ཀྱང་རང་ལ་ཡང་དྲི་ཞིམ་པ་ཉིད་དུ་མི་བྱེད་ལ་གཞན་ཡང་དྲི་ཞིམ་པ་ཉིད་དུ་མི་བྱེད་པའི་ཕྱིར་རོ།",
    "འགྲོ་བ་འདི་ཡང་རང་བཞིན་མེད།",
    "སྐྱེ་བའང་རང་དང་གཞན་གྱི་དངོས།",
    "དེ་འདུག་པ་ན་མུན་པ་མེད།",
    "མར་མེ་ལ་ཡང་མུན་པ་མེད་ལ་སྣེཕྱོགས་གང་ན་མར་མེ་དེ་འདུག་པ་དེ་ན་ཡང་མུན་པ་མེད་པས་མར་མེས་ཅི་ཞིག་སྣང་བར་བྱེད་དེ་ཅི་ཡང་སྣང་བར་མི་བྱེད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཕྱོགས་གང་ན་མར་མེ་དེ་འདུག་པའི་གཞན་གྱི་བདག་ཉིད་དག་རྗོཀྱང་མུན་པ་མེད་པའི་ཕྱིར་མར་མེས་སྣང་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "དེ་འདུག་པ་ན་མུན་པ་མེད།",
    "དེ་འདུག་པ་ན་མུན་པ་མེད།",
    "འདི་ན་འདུག་པ་དེ་གསལ་འགྱུར།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "དཔེར་ན་མར་མེ་བུམ་པ་མུན་ཁྲོད་ན་འདུག་པ་དམིགས་པར་བྱ་བའི་རྒྱུར་ལན་ཀྱང་།",
    "དཔེར་ན་སྣོད་ཆེན་པོ་ན་འདུག་པའི་ཞོ་ནི་ཞོ་ཡིན་པའི་ཕྱིར་སྣོད་ཆུང་ངུ་ན་འདུག་པའི་འོ་མའི་རྒྱུ་ཅན་མ་ཡིན་པ་དེ་བཞིན་དུ་འབྲས་བུ་སྔ་ན་མེད་པའི་ཞོ་ཡང་འབྲས་བུ་སྔ་ན་མེད་པའི་ཞོ་ཡིན་པའི་ཕྱིར་འོ་མའི་རྒྱུ་ཅན་མ་ཡིན་ནོ།",
    "དེ་ལ་བརྟག་པ་སྔ་མ་ལྟར་མི་འཐད་པར་བསྟན་པའི་ཕྱིར་དེ་ལ་གལ་ཏེ་བརྟག་པ་སྔ་མ་ལྟར་འདོད་ན་ནི་ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་གྱི་རྐང་པ་ལ་སོགས་པ་དག་དེའི་ཆ་ཤས་ལག་པའི་ཕྱོགས་ན་འདུག་པ་གང་ཡིན་ང་།་",
    "དཔེར་ན་ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་དེའི་ཆ་ཤས་ཡན་ལག་ལག་པའི་ཕྱོགས་ན་འདུག་པ་གང་ཡིན་པ་དེ་ནི།",
    "སྣམ་བུའི་ཡན་ལག་རྒྱུ་སྤུན་ལ་སོགས་པ་དེ་དག་ཏུ་མ་ཞུགས་པའི་ཕྱིར་ཡན་ལག་རྒྱུ་སྤུན་ལ་སོགས་པ་དེ་དག་ལྷས་བྱེན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་དེའི་ཆ་ཤས་ཡན་ལག་ལག་པའི་ཕྱོགས་ན་འདུག་པ་གང་ཡིན་པ་དེ་རྩོམ་པར་བྱེད་པ་མ་ཡིན་པ་༦དེ་བཞིན་དུ་ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་དེའི་ཆ་ཤས་ཡན་ལག་ལག་པའི་ཕྱོགས་ན་འདུག་པ་གང་ཡིན་པ་དེ།",
    "དེའི་ཡན་ལག་རྐང་པ་ལ་སོགས་པ་དེ་དག་ཏུ་ཡང་མ་ཞུགས་པའི་ཕྱིར་ཡན་ལག་རྐང་པ་ལ་སོགས་པ་དེ་དག་ཀྱང་ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་དེའི་ཆ་ཤས་ཡན་ལག་ལག་པའི་ཕྱོགས་ན་འདུག་པ་གང་ཡིན་པ་དེ་རྩོམ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "བརྟག་པ་ཕྱི་མ་ལྟར་འཐད་མི་འཐད་པར་བསྟན་པའི་ཕྱིར་ཅི་སྟེ་བརྟག་པ་ཕྱི་མ་ལྟར་འདོད་ན་ནི་ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་གྱི་བདག་ཉིད་ལག་པའི་ཕྱོགས་ན་འདུག་པ་གང་ཡིན་པ་དེ་དེའི་རྐང་པ་ལ་སོགས་པས་བརྩམས་ཞུཔ་མ་ཡིན་ཏེ།",
    "ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་གྱེ་བདག་ཉིད་ཡན་ལག་ལག་པའི་ཕྱོགས་ན་འདུག་པ་གང་ཡིན་པ་དེ་ཡང་ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་དེའི་ཡན་ལག་རྐང་པ་ལ་སོགས་པ་དེ་དག་ཏུ་མ་ཞུགས་པའི་ཕྱིར་ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་ཀྱི་བདག་ཉིད་ཡན་ལག་ལག་པའི་ཕྱོགས་ན་འདུག་པ་གང་ཡིན་པ་དེ་ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་དེའི་ཡན་ལག་རྐང་པ་ལ་སོགས་པས་བརྩམས་༥པ་མ་ཡིན་ནོ།",
    "འདིར་གྲངས་ཅན་དག་དང་དངོས་པོ་ཐམས་ཅད་རང་བཞིན་གཅིག་པར་སྒྲུབ་དུཔའི་ཚུལ་བྱིས་རྒྱུ་དང་འབྲས་བུ་དག་གཞན་ཉིད་མ་ཡིན་ཞིང་རང་བཞིན་གཅིག་པ་ཉིད་དུ་སྒྲུབ་པའི་གཞུང་སྟོན་ཏེ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གཅིག་པ་ཉིད་ཀྱི་ཕྱིར་འཇིམ་པ་ལས་གཞན་ཉིད་མ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "འདི་ལྟར་ཁྱེད་ཀྱི་གྲུབ་པའི་མཐའ་ལས་ཀྱང་རྒྱུ་དང་འབྲས་བུ་དག་དུས་ཐ་དད་པ་ཉིད་དུ་འདོད་པའི་ཕྱིར་རོ།",
    "རྒྱུ་དང་འབྲས་བུ་དག་དུས་མཉམ་པ་ཉིད་དོ་ཞེ་ན།",
    "དེ་ཉིད་རྗེས་སུ་དཔག་པ་བསྟན་པའི་ཕྱིར་གཉིས་པ་མེད་པར་ཡང་རང་ལས་གཞན་ཉིད་དུ་འགྱུར་ཏེ།",
    "གཉིས་པ་མེད་པར་ཡང་རང་ལས་གཞན་ཉིད་དུ་འགྱུར་ཏེ།",
    "ཁྱད་པར་དང་ལྡན་པས་སྤྱི་དང་ཁྱད་པར་ཉིད་དུ་འདོད་ན་སྤྱི་དང་ཁྱད་པར་མེད་པ་ཡང་རང་ལས་སྤྱི་དང་ཁྱད་པར་ཉིད་དུ་འགྱུར་ཏེ།",
    "དེ་ཡང་རང་བཞིན་ལུང་མ་བསྟན།",
    "ཡང་རང་བཞིན་ཀྱིས་ལུང་དུ་མ་བསྟན་པ་ཡིན་ནོ།",
    "མ་སྐྱེས་པ་ལ་ཆུད་ཟ་བར་མི་འགྱུར་རོ་ཞེས་གང་གསུངས་པ་ཁོ་བོ་ཅག་འདོད་པ་དེ་ནི་ཁྱེད་རང་ལ་མ་གྲུབ་པ་ཉིད་ཡིན་པས།",
    "དེའི་ཕྱིར་དེ་ནི་གཞན་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འདིར་ཡང་དུས་ཡོད་པར་སྨྲ་བ་དག་དུས་འདུས་བྱས་ཀྱི་དངོས་པོ་རྣམས་ལས་གཞན་ཡིན་པར་སྒྲུབ་པའི་གཏན་ཚིགས་ཡིན་ཏེ།",
