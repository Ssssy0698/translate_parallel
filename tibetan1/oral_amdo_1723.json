    "མིང་ལ་གཉའ་ཁྲི་བཙན་པོ་ཞེས་སུ་གྲགས་ཞེས་སྤོ་བོའི་ཡུལ་ལམ་སྤོ་མི་དེང་སང་སྤོ་མིས་ཤུན་ས་ཆའི་མི་བྱ་མོ་བཙན་གྱི་བུ་ཆུང་བ་ཨུ་བེ་ར་ཞེས་པ་དེ་བོད་ཀྱི་རྒྱལ་པོར་བསྐོས་ཚུལ་གསལ་བར་བརྗོད་ཚུལ་དེ་རིགས་ནི་ཡིད་རྟོན་རུང་བ་ཞིག་ལགས་སོ།",
    "མི་རྣམས་ཀྱིས་རང་ཉིད་ཀྱི་འདོད་བློ་ལྟར་སྒྱུར་ཐབས་མེད་པ་ཞིག་རེད།",
    "གཉའ་བར་ཁྲི་བྱས་བཏེགས་ནས་སྤྱན་དྲངས་མཁན་གྱི་མི་བཅུ་གཉིས་ཟེར་བ་དེ་ཡང་དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་སུ་བོན་པོ་སོགས་ཡོན་ཏན་ཅན་གྱི་མི་བཅུ་གཉིས་ཕྱུགས་སྐྱོང་བས་མཐོང་སྟེ་ཞེས་དང་།",
    "མི་དེ་དག་གིས་ཕྱོགས་སོ་སོ་ནས་ཕྱུགས་འགའ་རེ་དེད་དེ་མ་གྲོས་གཅིག་མཐུན་གྱིས་ཡུལ་ཡར་ལྷ་ཤམ་པོའི་ངོས་སུ་མཉམ་སྐྱོད་བྱེད་མི་སྲིད་པས་ན།",
    "རེ་ཞིག་ཤིང་ཁྲི་ལ་བཞག་ནས་མཐོན་པོར་བཀྱགས་ཏེ་གཉའ་བ་ལ་ཁུར་ནས།",
    "ཉིན་རེ་བཞིན་ས་ལ་བྱོན་པ་དང་མཚན་རེ་བཞིན་ནམ་མཁའ་ལ་གཤེགས་པ་དང་།",
    "ཡབ་རྣམས་རིམ་བཞིན་དུ་རྨུ་ཐག་ལ་འཇུས་ནས་རྨུ་སྐས་ལ་འཛེགས་ཏེ་ནམ་མཁའི་དབྱིངས་སུ་འཇའ་ཚོན་ཡལ་བ་ལྟར་སོང་བས་ན།",
    "ཁ་ཆེའི་མི་ཤུལ་དུ་ལུས་པ་ཞིག་ན་རེ།",
    "དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་སུ་བློན་པོ་ལོ་ངམ་དང་འཐབ་ཞེས་བློན་པོ་ཞིག་ཡིན་པར་དངོས་སུ་བྱུང་བ་དང་།",
    "དོན་ལ་འཕྱིང་ཡུལ་དར་ཐང་དང་དྲང་མོ་དྲང་ཆུང་རི་དང་གཡང་ཏེ་བླ་འབུབས་ཞེས་པ་ནི་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་ཡིན་ནམ་སྙམ་སྟེ་འགྲིག་མིན་དཔྱད་དགོས།",
    "གཉིས་ས་ཡི་ལེགས་དྲུག་གི་བང་སོ།",
    "དེ་དག་གི་བང་སོ་ནི་གཡའ་དང་སྤང་གི་མཚམས་སུ་བཏབ་ཅིང་།",
    "ཁྲི་ཐོག་རྗེ་བཙན་བཅས་གསུམ་ལ་འོག་གི་བཙན་གསུམ་ཟེར་ཏེ་བཙན་གསུམ་བང་སོ་གངས་དཀར་རྩེ་ལ་བཏབ།",
    "བདུན་སྟག་རི་གཉན་གཟིགས་ཀྱི་བང་སོ།",
    "ཡབ་ཡུམ་གསུམ་ཀ་འཕན་ཡུལ་ཟལ་མོའི་སྒང་དུ་གཤེགས་པར་སྣང་ཞིང་།",
    "བཙན་པོ་དེ་ཉིད་གཙང་གི་བར་སྣང་སྒང་དུ་འདས་ནས།",
    "བཅུ་གཉིས་ཁྲི་འདུས་སྲོང་གི་བང་སོ།",
    "བཙན་པོ་འདི་ཉིད་ལྗང་གི་ཡུལ་དུ་འདས་ནས་བང་སོ་ཁྲི་མང་སྲོང་མང་བཙན་གྱི་བང་སོའི་གཡོན་དུ་བརྩིགས་ཤིང་།",
    "ཁྲི་འདུས་སྲོང་གི་བང་སོའི་གཡོན་ན་ཡོད་ཅིང་།",
    "བང་སོ་ཁྲི་འདུས་སྲོང་གི་བང་སོའི་མདུན་དུ་བརྩིགས།",
    "དར་མ་འུ་དུམ་བཙན་ལྷ་ལུང་དཔལ་གྱི་རྡོ་རྗེས་ལྷ་སར་བཀྲོངས་ཏེ་བང་སོ་ཁྲི་འདུས་སྲོང་གི་བང་སོ་དང་སད་ན་ལེགས་མཇིང་ཡོན་གྱི་བང་སོའི་བར་དུ་བརྩིགས།",
    "འོག་གི་བཙན་ལྔ།",
    "ཅེས་རི་སྒང་གི་ཆེས་མཐོ་སར་བཏབ་པ་དང་།",
    "བང་སོ་གྲུ་བཞིར་རེའུ་མིག་དགུ་ཅན་གྱི།",
    "ཞེས་སྲོང་བཙན་སྒམ་པོའི་བང་སོ་ནི་རེའུ་མིག་ཅན་གྱི་བང་སོ་ལ་སོགས་པའོ།",
    "ནང་དུ་རེའུ་མིག་དགུ།",
    "དབུས་སུ་རིང་ཚད་ཁྲེ་ཙེ་བརྒྱད་ཙམ་ཡོད་པའི་བྱུ་རུའི་སྡོང་པོ་རྒྱུན་བཀང་གི་མཚོན་བྱེད་དུ་བྱས།",
    "བང་སོའི་སྒོ་མོ་ནུབ་ལ་གཏད།",
    "བང་སོའི་ཕྱིར་ས་སྨུག་པོ་དང་རྡོ་ཧྲུག་གིས་བཀབ་ནས་དེའུ་འབུར་ཞིག་ཏུ་གྱུར།",
    "གཙང་པོའི་འགྲམ་གཉིས་སུ་འོམ་བུ་ཤིང་གིས་ཁེངས་ཤིང་།",
    "གཡུལ་དུ་དཔའ་བ་རྣམས་ཀྱི་གདུང་རེད།",
    "བོད་ཀྱི་རྒྱལ་མོ་མཚན་མི་གསལ་བ་ཞིག་གི་སྐོར་བྲིས་ཏེ།་",
    "རྒྱལ་མོ་དེ་གྲོངས་པའི་ཚེ་ཤ་རུས་རྣམས་གསེར་ཕྱེ་དང་མཉམ་དུ་བསྲེས་ནས།",
    "ཆ་བཞེད་དུའང་གསལ་སྣང་གི་བུ་མོ་ཞིག་ཤི་བའི་རོ།",
    "དེ་དག་ལ་བལྟས་ན་གནའ་དུས་སུ་རང་རེའི་བོད་ཀྱི་ས་ཆར།",
    "བྲན་གཡོག་བདག་པོ་ཤི་སྐབས་བྲན་གཡོག་རྣམས་གང་བསམ་གྱིས་དུར་རྫས་སུ་གསོན་སྦས་བྱེད་པའི་སྲོལ་ནི་ཀྲུང་གོ་དང་ཕྱི་རྒྱལ་གང་ལ་ཡིན་རུང་སྣང་ཚུལ་ཐུན་མོང་བ་ཞིག་ཡིན་པ་ཕལ་མོ་ཆེས་འདོད།",
    "མོ་ཕྱུགས་སྟོང་ཕྲག་དུ་མ་ནས་མ་མཐར་རེ་རེ་ལས་མ་བྱུང་ཡང་བསད་ནས་དམར་མཆོད་འབུལ།",
    "གཤིན་པོས་རེག་པའི་མི་དང་ནོར་ཕྱུགས་གང་ཡིན་གཤིན་པོའི་རྟགས་བརྒྱབས་ན།",
    "འཛིན་པའམ་རེག་པའི་མི་རྣམས་ཁོ་ཚོའི་བྲན་གཡོག་བྱེད་དུ་འཇུག་པ་དང་།",
    "ནོར་ཟོག་སོགས་ཁོ་ཚོས་བདག་གིར་བྱས་ནས་སླར་བདག་པོར་མི་སྤྲོད་ཟེར་སྐད།",
    "དེ་ལྟར་མི་ཡུལ་དུ་གནས་ཀྱང་མི་གྲལ་དུ་མི་ཚུད་པའི་མི་དེ་དག་གི་ལས་འགན་ནི།",
    "སྨིན་དྲུག་གི་ཟླ་བའི་དཀར་ཕྱོགས་རྫོགས་པ་གཉིས་པའི་ཉིན་ཡིན་ཞིང་།",
    "མཆན་ཆ་དེའི་སྔ་ཉིན་ནས་བང་སོའི་དྲུང་དུ་དུང་འབུད་པ་བཏང་ནས།",
    "ཉི་མ་སང་གི་ཉིན་པར་སྲོང་བཙན་གྱི་བང་སོ་མཆོད་རྒྱུ་ཡིན་པས།",
    "དུར་སྲུང་རྣམས་ཐག་རིང་གི་ལུང་པར་སོང་ལ་ཡིབ་སྟེ་སྡོད་ཅིག་ཅེས་བརྡ་སྦྱར།",
    "ཡང་དུང་འབུད་དེ་དུར་སྲུང་རྣམས་ཤོག་ལ་རྫས་ལྷག་སོགས་ལ་ལོངས་སུ་སྤྱོད་ཅིག་ཅེས་བརྗོད་ནས་ཕྱི་མིག་མི་ལྟ་བར་རང་གནས་སུ་ལོག་དེ་ནས་བྱེས་ཀྱི་ལུང་པར་ཡིབ་ཏུ་སོང་བའི་གཤིན་པོ་རྣམས་སླར་འཁོར་ཏེ།",
