    "གོང་མ་ཆེན་ལུང་༢༡གི་དུས་དམག་དཔོན་ཨཱ་ཅང་ཇུན་དམག་དང་བཅས་པས་ལོ་བཅུ་གཉིས་ཀྱི་རིང་འཐབ་ནས་མངའ་འོག་ཏུ་བཅུག་ཅེས་བྱུང་།",
    "འགྲོ་སོང་ལ་དངུལ་སྲང་བྱེ་བ་བདུན་བཏང་།",
    "དམག་མི་དྲུག་ཁྲི་ཙམ་ཤི་རྨས་སུ་སོང་།",
    "གོང་མས་བདག་གི་རྒྱལ་སྲིད་ཀྱི་དམག་ལས་སུ།",
    "ཡུད་ཙམ་ཁྲོས་པའི་སྤྱན་གྱི་སྡང་མིག་གིས།",
    "རྒྱལ་མོ་ཚ་བ་རོང་ལ་དཔའ་རྩལ་སྟོབས་ཀྱི་ལངྐའི་གྲོང་ཞེས་བོད་མིས་བརྗོད་པ་ནི་ཆེ་བསྟོད་མིན་པར་འདྲ་ཐེངས་རེད་སྙམ་པའོ་ཞེས་བརྗོད་པ་ནི་དོན་ལ་གནས་པར་སེམས་སོ།",
    "དེ་ལྟར་རྒྱལ་མོ་རོང་གི་ས་ཆ་ནི་རི་བཙན་ས།",
    "གཙོ་བོ་སྒྲ་གདངས་དང་མིང་བརྡ་ཐ་སྙད་ཁག་ཅིག་དང་ཚིག་གྲོགས་སྦྱོར་སྟངས་སོགས་ཀྱི་ཐད་བོད་སྤྱི་འགྲོས་ཀྱི་སྐད་དང་ཁྱད་པར་ཆེ་ཙམ་བྱུང་མོད།",
    "རིན་ཆེན་བཟང་པོ་ཐོ་རེངས་སྐར་ཆེན་བཞིན།",
    "གངས་ལྗོངས་ཡི་གེའི་ཕྱི་མོ་སྲིད་པའི་མིག།",
    "དེ་ཡང་བོད་ཁ་བ་ཅན་གྱི་ལྗོངས་ཞེས་འཛམ་གླིང་གི་ཏོག་ཏུ་གྱུར་པའི་ས་མཐོའི་ཡུལ་ལྗོངས་ཆེན་པོ་འདིར།",
    "ཐོག་མའི་གྲུབ་འབྲས་དེ་ཙམ་ཞིག་དེ་བོད་མི་དམངས་ཀྱི་རེ་བ་དང་།",
    "འདང་གི་མེད་པ་མ་ཟད།",
    "ད་དུང་རྒྱང་ཁྱད་ཆེ་ཙམ་གནས་ཡོད་པར་སྙམ་མོ།",
    "ད་དུང་དུས་ཡུན་ངེས་ཅན་ཞིག་གི་བར་ཚོད་ལྟ་མི་བྱེད་ཀ་མེད་རེད།",
    "མར་ལེ་རིང་ལུགས་དང་མའོ་ཙེ་ཏུང་གི་དགོངས་པ་ལྟར་ན།",
    "བོད་ཡིག་གི་ཐོག་ཏུ་བསྒྱུར་ཐུབ་བམ་ཟེར་ན།",
    "སྦྱོར་ཀློག་ཅན་གྱི་བོད་ཀྱི་ཡི་གེ་འདི་ནི་སྒྲ་སྒྱུར་དང་དོན་སྒྱུར་གང་གི་ཐད་དུའང་ཐོགས་པ་མེད་ཅིང་།",
    "དེ་ཡང་རྒྱལ་མཆོག་ལྔ་པ་ཆེན་པོས་དེབ་ཐེར་དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་ལས་མཁའ་མེའི་སྲད་བུར་བརྒྱུས་པའི་ཀ་འཕྲེང་ལ།",
    "ནོར་བུའི་ཟོང་གིས་བཀང་ཡང་ཁུགས་སམ་ཅི།",
    "ཞེས་བསྔགས་པར་མཛད་པ་ནི་ཐུགས་ཤིན་ཏུ་མད་དོ་སྙམ་མོ།",
    "དེས་ན་ད་ལྟ་ང་ཚོའི་མདུན་དུ་ལྷག་པའི་ཁ་ཚ་དགོས་གཏུགས་ཀྱི་ལས་འགན་ནི།",
    "ང་ཚོའི་མི་རིགས་འདི་ལ་རེ་བ་ཆེན་པོ་ཡོད་པར་མ་ཟད།",
    "དེ་རྗེས་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་བསྐྲུན་པའི་བོད་ཀྱི་སྤྱི་སྐད་སྐོར་གྱི་ཆེད་རྩོམ་ཕྱོགས་བསྒྲིགས།",
    "ཀྲུང་གོཨ་མི་རི་ཁ།",
    "མོ་ཨེར་ཏ་ཝིའི་ཡ།",
    "ནང་གི་བཀའ་གླེགས་མི་ཞིག་ཅེས་པའི་གཏམ་དཔེ་ལྟར་གཞན་ལ་ངོམ་ངོམ་བྱས་ནས་སྟོན་རྒྱུ་ཡོད་པ་འདི་ནི།",
    "ཞེས་པའི་དཔེ་ལྟར་གྱུར་པ་རེད་སྙམ།",
    "མི་རིགས་གང་ཞིག་ལ་མཚོན་ནའང་ཡུལ་སྐད་ཐ་དད་པ་དུ་མ་མཆིས་རུང་སྐད་ཆ་གཅིག་གྱུར་ཏེ་ཐུན་མོང་གི་སྤྱི་སྐད་ངེས་སྲོལ་ཅན་དུ་གྱུར་པ་ཞིག་ཡོད་དགོས་པ་དེ་ནི།",
    "དེ་ནི་ཇི་འདྲའི་ངོ་གནོང་དགོས་པ་ཞིག་དང་བློ་ཕམ་དགོས་པ་ཞིག་རེད་ཨང་།",
    "ལྷ་སར་ཡོང་བའི་གནས་བསྐོར་བ་དང་ཚོང་པ་སོགས་ཀྱིས་གང་ཐུབ་ཅི་ཐུབ་ཀྱིས་དབུས་གཙང་སྐད་དང་མཐུན་ཐབས་བྱས་ཏེ་ཀུན་གྱིས་གོ་ཐུབ་པའི་སྐད་ཆ་ཞིག་བེད་སྤྱོད་བྱས་པ་དང་།",
    "འཛམ་གླིང་རྒྱལ་ཁབ་ཁག་གི་སྔོན་ཐོན་མི་རིགས་ཁག་ཚང་མ་སྲོལ་རྒྱུན་ནས་དེང་རབས་ཅན་དུ་འཕེལ་འགྱུར་སོང་བར་ལམ་སྣ་གསུམ་ལས་བརྒྱུད་མེད་དེ།་",
    "འཕེལ་ལམ་གཅིག་ནི་བཟོ་ལས་ཅན་ནས་ཁྱོན་ཡོངས་དེང་རབས་ཅན་དུ་འགྱུར་བ་དང་།",
    "འཕེལ་ལམ་སྔ་མ་གཉིས་ལ་འགྲོ་རྒྱུ་ང་ཚོར་ཆ་རྐྱེན་ལྡན་མེད་ལ་ལྡན་ཀྱང་འགྲོ་འདོད་མེད།",
    "འཕེལ་ལམ་ཕྱི་མ་དེ་ང་ཚོས་མ་དཔེ་བྱས་ཆོག་ཅེས་གསུངས།",
    "རང་བྱུང་ཚན་རིག་གི་གོ་དོན་བསྟན་ཐུབ་བམ་མི་ཐུབ་ཟེར་ན།",
    "དེ་དག་འཇིག་རྟེན་འདིར་དར་འགོ་ཚུགས་པ་ནས་བཟུང་ང་ཚོས་བསྒྱུར་བ་དང་རྩོམ་པ་ལ་སོགས་པའི་འབད་བརྩོན་བྱས་ཡོད་ཚེ།",
    "ཧ་ལམ་འཛམ་གླིང་མི་རིགས་ཁག་གི་སྐད་ལྟ་བུར་གྱུར་ཡོད་སྟབས།",
    "ཐ་སྙད་དཀོན་པའི་དཀའ་ངལ་དེ་ཙམ་མེད་ཚོད་རེད།",
    "སྒྲ་སྒྱུར་ཞེས་པ་ནི་མི་རིགས་ཁག་གི་སྤྱིའི་ཐ་སྙད་ལྟ་བུར་གྱུར་ཡོད་པ་རྣམས་སྒྲ་རང་སོར་བཞག་ནས་སྒྲ་སྒྱུར་བྱེད་པར་ཟེར།",
    "ང་ཚོ་ནམ་ཡང་སྔོན་ཐོན་མི་རིགས་ཀྱི་རྗེས་ཟིན་ཐབས་བྲལ་བར་ངེས་པས།",
    "དེ་ཡང་སྤྱིར་བོད་རིགས་ཀྱི་ཡུལ་སྐད་ལ་དེང་སང་དབྱེ་བ་གསུམ་མམ་ཡང་ན་དབྱེ་བ་ལྔ་ཡོད་ཟེར་བ་གོ་ཐོས་བྱུང་མོད།",
    "ལུང་པ་རེ་ལ་སྐད་རེ་ཟེར་བའི་དཔེ་ལྟར་གྱུར།",
    "རིང་པོར་མི་ཐོགས་པར་ཕན་ཚུན་གླེང་མོལ་ཅི་བདེར་ཆོག་པ་དང་།",
    "རང་ཉིད་མི་གཅིག་རྒྱལ་མོ་ཚ་བའི་རོང་དུ་སྤྲུགས།",
    "རྗེས་སུ་ཁོང་བོད་དུ་ཡར་བྱོན་སྐབས་སུའང་དེར་རྗེ་བེ་རོ་ཙ་ནས་རྒྱལ་མོ་ཚ་བ་རོང་གི་རྒྱལ་བློན་རྣམས་དང་།",
    "རྒྱལ་མོ་རོང་དུ་གཡུང་དྲུང་ལྷ་ལྡིང་སོགས་ཡོད་པ་དུས་ཕྱིས་རྒྱ་ནག་གོང་མའི་དམག་གིས་བཤིག་ནས་ལྷ་ལྡིང་དུ་དགའ་ལྡན་བྱ་བའི་དགེ་ལུགས་པའི་དགོན་གསར་འཛུགས་པར་མཛད།",
    "རྒྱལ་མོ་རོང་ཞེས་པའི་མིང་གི་འབྱུང་ཁུངས་ནི།",
    "ཡུལ་དེར་ལྷ་མོ་གྲུབ་པའི་རྒྱལ་མོའི་གནས་རི་སྟེ་གཞི་བདག་དམུ་རྡོ་ཞེས་པའི་གནས་ཡུལ།",
    "ཆུ་དེའི་མིང་ལ་རྒྱལ་མོ་རྔུལ་ཆུ་ཟེར།",
    "དེ་ནས་མི་རབས་མང་དུ་སོང་སྐབས་རྒྱལ་པོ་སྩ་བན་ཐར་ལ་སྲས་གསུམ་ཡོད་པ་སོ་སོར་གྱེས་ནས་སོ་མང་དང་།",
    "འདིར་སྐབས་སུ་བབ་པའི་བརྗོད་དོན་རྒྱལ་རོང་གི་ཡུལ་སྐད་དེ་ཅི་འདྲ་ཞིག་ཡིན་ཞེ་ན།",
    "བོད་གཞན་དག་དང་ཐུག་འཕྲད་ཆེར་མེད་པར་དུས་ཡུན་རིང་པོར་སོང་བས་རིམ་གྱིས་འགྱུར་སོང་བ་ཡིན་ཏེ་ད་དུང་ཁོ་ཚོའི་སྐད་ཀྱི་ནང་དུ་བོད་སྐད་ཤིན་ཏུ་མང་ལ།",
    "རྒྱལ་རོང་གི་ཡུལ་སྐད་དུ།",
    "བོད་ཡིག་གི་འབྲུ་འདེད་བྱེད་ལུགས་དང་ཡི་གེ་ཀློག་སྟངས་སོགས་ལ་སྒྲ་ཧ་ཅང་དག་པོ་ཐོན་པ་སྟེ།",
    "དེ་དག་གི་ཡུལ་སྐད་བཅས་ལའང་གྱོང་ཉམས་ཆེ་ཙམ་ལས་འཕུལ་རྟེན་སོགས་ཀྱི་ཟུར་དག་པར་འདོན་པ་བྱུང་བར་མངོན་སུམ་གྱིས་གྲུབ་ཅེས་གསུངས་པ་དེ་དོན་ལ་གནས་པ་ཡིན།",
    "དེས་ན་སྔར་བོད་ཀྱི་བརྡ་རྙིང་ལའང་མིང་གི་སྔོན་དུ་དེ་སྒྲ་འཇོག་པའི་སྲོལ་ཡོད་པར་སྣང་སྟེ།",
    "མིང་རྐྱང་གི་སྔོན་དུ་དེ་སྒྲ་ཞིག་བཞག་ནས་དེ་བོད་དམ་དེ་སྤུ་ཞེས་པའི་སྒྲ་སྒྱུར་ཡིན་པར་མངོན་ཏེ།",
    "རྒྱལ་རོང་གི་སྐད་དུ་ས་བདག་དཔོན་པོའམ་རྒྱལ་པོའི་ཞེ་ས་ལ་དེ་སྤུ་ཟེར།",
    "དེ་ཆུ་རེད།",
    "དེ་རི་རེད་ཅེས་རེ་རེ་བཞིན་དེ་སྒྲ་བཞག་ནས་སློབ་པ་དང་།",
    "སུམ་ཅུ་པའི་རྩ་བར་མིང་གི་ཐོག་མའི་དེ་སྒྲ་ནི་ཞེས་མིང་གི་ཐ་སྙད་ཀྱི་སྔོན་དུ་དེ་སྒྲ་འཇོག་སྲོལ་ཡོད་པར་གསུངས་པས་ན།",
    "མི་རེ་གཉིས་ཀྱིས་རྒྱལ་རོང་སྐད་ལ་དེ་རྣ།",
    "དེ་ཁ་ཞེས་དེ་སྒྲ་མང་པོ་འདུག་པས་བོད་སྐད་དང་འདྲ་གི་མི་འདུག་ཟེར་བ་ནི་རྒྱུས་མེད་ཀྱི་རྒྱུས་གཏམ་ཞིག་ཏུ་མི་འགྱུར་གྲོང་།",
    "ཟེར་བ་འཛེར་བ་འཚེམ་པ་ཀ་འདྲུབ་སོ་པ་བྱ་ར་བ་ཀ་འཛེར་འདྲུབ་པ་ཀ་ནི་བྱ་ར་རང་རེ་འམ་འུ་བུ་ཡུ་བུ་དོང་ངམ་བུ་ག་སྦུག་གུ་ཁོལ་སྦུག་ཇུ་བོ་ཇུ་མི་ངལ་བ་ཉེལ་བ་ཉེལ་བ་ཚོད་མ་གཡར་བ་ཞིང་པ་བང་སོ་སྐུ་རུམ་བརྙན་པ་ཆུང་པ་ཁུ་སྐྱུར་དེ་བརྙན་ཚུང་པ་མདད་མདད་ཨ་ཕྱི་མེས་མོ་ཨ་ཕྱི་དམག་མི་ཐམས་ཅད་དམག་སྤྱི་གང་བྱ་གང་ལདམག་སྤྱི་གང་བྱ་གང་ལ་།",
    "སྐུ་ཚིག་ཁུས་འདེབས་པ་ནམ་ནམ་ཞར་ཞར་མེད་པ་འཐད་པ་ནམ་ཡང་དེ་མྱིག་ཀེ་གཡང་དེར་ཚིག་ཀེ་ང་ཁུས་ལོར་ཞ་ཞར་ཀེ་རྨེད་ཀེ་འཐད་ཀ་འཇུད་ཟུར་གུར་བུ་ལི་ཁ་འུབས་འདུས་འཇུད་པ་མེད་པ་གཏད་པ་འཇུག་པ་ཟུར་གྲུ་བཞི་འདུས་པ་བཅད་པ་མེས་པོ་ཟུར་གུར་བུ་འུབས་པ་ཀ་དབྲལ་དབྲལ་བ་མྱེས་པོ་ཨ་མྱེས་ཀི་འདྲེང་རིང་བ་གཡར་བ་དངུལ་སོགས་སྒོག་པ་ཐང་ཆད་པ་འདྲིང་བ་སྐྱི་བ་ཀུན་དོང་ག་ཆད་ཀོ་ཅོག་བགོམ་པ་ཅོ་རེ་གཅི་བ་ཀུན་དོང་ཀ་ཆད་ཀོ་ཅེ་ཀ་བགོམ་ཀེ་ཅོ་རེ་དེ་གཅི་ཁྱོན་ཆེ་བ་ལྟས་ངན་ཡོད་པ་གཏོས་ཆེ་བ་ཐན་བདོག་པ་ཚང་མ་ཅེན་ནེ་གཙིགས་ཆེ་བ་བཙབས་པ་ཚོ་ཚིས་གཅེས་སྤྲས་ཆེ་བ་ཞིབ་མོར་མརྡུངས་པ་འཚོ་ཐབས་འཚིག་པ་འདི་བདེན་པ་ཀེ་གཏོས་ཐན་བདོག་ཀེ་ཙེན་ནེ་ཀ་ས་གཙིགས་གཙིགས་ཀ་བཙབས་ཀེ་ཚིས་ཀེ་གཞོབ་འུ་འདི་གཤའ་གཤའ་དེ་སྤུ་འང་འདི་ཀ་སི་རྙིང་གཞོབ་པ་འུ་ནི་གཤའ་མ་རྒྱལ་པོ་སྤུ་རྒྱལ་འུ་ནས་རྙིང་པ་དེ་ནས་བརྐྱངས་པ་གཙོ་བོའམ་བཟང་བ་རྫུན་ཚིག་།",
    "འོ་ན་དེང་སང་གི་རྒྱལ་རོང་ཡུལ་སྐད་དང་བོད་སྤྱི་འགྲོས་ཀྱི་སྐད་ལ་ཁྱད་པར་ག་འདྲ་ཞིག་ཡོད་ཅེ་ན།",
    "སྤྱིར་རྒྱལ་རོང་སྐད་ཀྱི་ཐ་སྙད་ཆེས་མང་བ་ནི་དེང་སང་གི་བོད་སྤྱི་འགྲོས་ཀྱི་སྐད་ངོ་མ་ཡིན་ཞིང་།",
    "ཀ་ཁ་ཀ་ཁ་ཀག་དེ་ཀག་དཀར་ཡོལ་དཀར་ཡོལ་ཀླུང་ཉེ་ཀླུང་རྐུན་མ་རྐུན་མོ་དེ་སྐྱོན་དེ་སྐད་སྐདདཀའ་ཁག་སྐར་ཆེན་ཀེ་ས་ཁ་སྐར་ཅེན།",
    "ངོ་ཤེས་པ་དངུལ་སྤྱད་མངོན་ཤེས་རྔ་གཡབ་སྔོག་པ་ངན་པ་ཀི་ང་མི་ཤེས་བོང་དངུལ་ཨེ་སྤྱད་ངོན་ཤེས་རྔ་གཡབ་ཀ་སྔོག་ང་ཉེ་ངང་པ་ངོ་ཆེན་བོང་དངུལ་མངོན་སུམ་རྔ་མོང་དངུལ་མངོན་སུམ་རྔ་མོང་སྔ་རབས་སྔ་རབས་བྱ་ཚིག་གི་སྐོར།",
    "གཅིག་ག་ཉིས་གསུམ་གུར་བུ་ལི་བདུནབརྒྱུད་དགུ་བཅུ་གཅིག་བཅུ་གསུམ་གྲངས་ཚིག་གི་སྐོར།",
    "ཅོང་དགུ་ཉི་ཤུ་སྟོང་ཚོ་ཀི་དྲུག་བརྒྱུད་བཅུ་ཅ་གཉིས་ཅ་བུ་ལི་བཅོ་ལྔ་རྩེ་ལྔ་ཅེ་དྲུག་ཅོང་བརྒྱད་བཅུ་བདུན་བཅུ་དགུ་ཀི་གཉིས་བཅུ།",
    "བརྒྱ་བར་ཡ་སྟོང་ཚོ་འབུམ་ཁམ་གང་རྒྱུ་གང་དེ་ཁམ་གཅིག་དེ་རྩ་དེ་མཐོ་འབུམ་ཐེར་དེ་སྲུང་དེ་རྩ་དེ་ཕེག་དེ་བརྒྱུངས་དེ་ཐིག་དེ་ཁ་དེ་སྤུ་སོར་གཉིས་བྲེ་གང་སྲང་གང་རྒྱུ་ཕྱེད་འདོམ་གང་ཐིག་གཅིག་ཁ་གང་སྤར་གང་སོར་གཉིས་དེ་བྲེ་དེ་ཁེར་དེ་འབོ་ཕྱེད་སོར་གསུམདེ་ཕྱེད་སོར་གསུམ།",
    "ད་དུང་རྒྱལ་རོང་གི་ཡུལ་སྐད་ལ་ཞེ་སའི་སྐད་ཀྱང་ཆ་ཚང་ཞིག་ཡོད་པའི་མཚོན་བྱེད་ཁ་ཤས་བྲིས་ན་འདི་ལྟར་ཏེ།",
    "ཞེ་སའི་ཚིག་གི་སྐོར།",
    "གཡའ་རྫ་མཐོན་པོའི་རྩེ་མོ་ནས།",
    "ཐོག་མར་སྐད་གཞིར་བཞག་ནས་ཡི་གེ་བཟོས་པ་ཡིན་པས་སྐད་གཙོ་བོ་ཡིན་མོད།",
