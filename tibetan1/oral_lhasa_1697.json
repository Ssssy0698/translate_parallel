    "གང་བསྒྲུབ་བྱ་དང་མཚུངས་པ་དེ་ནི་གཏན་ཚིགས་མ་ཡིན་པརའགྱུར་ཏེ།",
    "དེ་གྲུབ་པ་ན་དངོས་པོ་རྣམས་གཅིག་པཉིད་དམ་གཞན་པ་ཉིད་གདོན་མི་ཟ་བར་གྲུབ་པར་འགྱུར་རོ་ཞེ་ན།",
    "འདི་ལབྲྗོད་པ་ཡོད་པ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "དེའི་ཚེ་འདིར་གཏནཚིགས་བྲྗོད་པར་བྱ་དགོས་སོ།",
    "གལ་ཏེ་ཡོད་པ་ཉིད་དུའགྱུར་ན་དེའི་བསྒྲུབ་བར་བྱ་བ་དང་མཚུངས་པར་འགྱུར་རོ།",
    "འོནཏེ་ཡོད་པ་ཉིད་ལས་གཞན་པ་ཁོ་ན་ཡིན་པ་དེའི་ཚེ་ཡང་དམ་བཅའཉམས་པར་འགྱུར་ཏེ།",
    "འདིར་དོན་གྱི་ཤུགས་ཀྱིས་སྔར་མི་ཞིམ་པརརྟོགས་པ་བཞིན་ནོ་ཞེ་ན།",
    "མེད་པ་ཉིད་དུ་བསྒྲུབ་པར་བྱབའོ།",
    "འདི་སྙམ་དུ་དངོས་པོ་རྣམས་མེད་པ་ཡིན་ནོ་ཞེས་དམབཅའ་བ་འདི་གཏན་ཚིགས་ཉིད་ལས་ཡིན་པར་འདོད་དོ།",
    "དེ་ལྟ་ནབསྒྲུབ་པར་བྱ་བ་དང་མཚུངས་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་མེད་པ་ལསགཞན་ཁོ་ན་ཡིན་ན་ནི་དེའི་ཚེ་དམ་བཅའ་བ་ཉམས་པར་འགྱུར་ཏེ།",
    "འདི་ཡངརྒྱུ་དགག་པ་བྱས་པ་ཉིད་ཀྱིསའབྲས་བུ་བཀག་པའི་ཕྱིར་རོ།",
    "ཤུགས་ཀྱིས་རྒྱུ་དང་འབྲས་བུ་གཉིག་ཡང་ཁས་བླངས་པར་འགྱུར་ཏེ།",
    "འདིརགལ་ཏེ་འདོད་པས་གྲུབ་པར་འགྱུར་ན་ནི།",
    "རིགས་པ་དངབྲལ་བ་ཉིད་ཀྱིས་བསྟན་བཅོས་རྣམས་ལ་བྲྗོད་པར་བྱ་བ་ཡོད་པརསྨྲ་བ་པོ་ནི་མི་རྙེད་དོ།",
    "ཁ་ཅིག་ཏུ་གྲིགསཔ་ཡང་བྲྗོད་པར་བྱ་སྟེ།",
    "ངེད་ཀྱི་ཕྱོགས་ཀྱངགྲུབ་པར་འགྱུར་རོ།",
    "དཔེར་ན་མེ་ནི་གཉིག་ལ་སྲེགཔར་བྱེད་ཀྱི།",
    "གལ་ཏེ་གཏནཚིགས་ལས་གཞལ་བྱ་གྲུབ་ན་ནི་དེའི་ཚེ་ཕ་རོལ་ཕོས་ཀྱང་གཏནཚིགས་བྲྗོད་པར་བྱ་དགོས་ཏེ།",
    "གཉི་ག་འགྲུབ་པར་ཡང་མི་འདོད་དེ།",
    "དེ་བས་ན་སྒྲནི་རྟག་པར་གྲུབ་པོ་ཞེས་བྱའོ།",
    "དེ་བཞིན་དུ་གཞན་ཡང་བྲྗོད་པརབྱ་སྟེ།",
    "སྒྲ་མི་རྟག་སྟེབྱས་པའི་ཕྱིརབུམ་པ་བཞིན་ནོ།",
    "སྐྱེས་བུའི་རྩོལ་བ་ལས་ཡང་དག་པར་སྐྱེ་བཞིན་པ་ནི་བྱས་པའོ།",
    "དེ་འགྲུབ་པའི་རྒྱུ་དང་འབྲས་བུ་དག་ཀྱངའགྲུབ་པར་འགྱུར་རོ་ཞེ་ན།",
    "རང་བཞིན་བྲྗོད་པར་བྱའོ།",
    "ཅིསྟེ་ཤེས་པའི་རང་བཞིན་ཡིན་པར་སྨྲན་ནི་དེའི་ཚེ་རྟག་པ་མ་ཡིནཔར་འགྱུར་ཏེ།",
    "ཅི་སྟེ་ཤེསཔལས་གཞན་ཡིན་པ་དེ་ལྟ་ན་ནི་མི་ཤེས་པར་འགྱུར་རོ།",
    "ཤེས་པ་སེམས་དང་ལྡན་པར་སྨྲ་བ་རྣམས་ཀྱི་བདག་མེད་པ་ཁོན་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་བདག་མེད་པར་ཡང་འགྱུར་ཏེ།",
    "གལ་ཏེ་ཡང་སེམས་པ་དེ་ཉིད་དངསེམས་པ་དེ་ཉིད་དང་ལྡན་པར་འགྱུར་ན་ནི་དེའི་ཚེ་བདག་མེད་པཉིད་དུ་ཡང་འགྱུར་ཏེ།",
    "བུམ་པ་ཞིག་ན་ཐམས་ཅད་དུ་ཐམས་ཅད་འཇིག་པར་འགྱུར་ཏེ་ཧ་སྟཞིག་ན་ཀརྞ།",
    "ཀརྞ་དང་པ་ན་ཉིད་བྲྗོད་པར་འགྱུརབ་དེ་བཞིན་དུ།",
    "ཡོད་པ་ཞེས་བྲྗོད་པས་བུམ་པ་དང་གཅིག་ཉིད་བྲྗོདཔརའགྱུར་ཏེ།",
    "གཞན་པ་ཉིད་ཡིན་ན་ཡོད་པ་དང་གཅིག་པ་དངབུམ་པརྣམས་མ་འདྲེས་པ་ཡིན་ཏེ།",
    "ཁྱད་པར་དང་།",
    "འདིར་གཞན་པ་ཉིད་ཡིན་ན་ཡོད་པ་དང་གཅིག་པ་དང་བུམ་པ་རྣམསདངོས་པོ་མེད་པར་འགྱུར་རོ།",
    "འཛིན་པར་མིནུས་སོ།",
    "འདི་ལ་བྲྗོད་པར་བྱ་སྟེ།",
    "བུམ་པ་མེད་པར་འགྱུར་ཏེ།",
    "རྩིག་པ་ལ་སོགས་པརྣམས་ཀྱིས་བསྒྲིབས་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་གལ་ཏེ་མཐོང་བཉིད་མེད་ན་ཡང་བུམ་པ་མེད་པར་མི་འགྱུར་ན།",
    "མཐོང་བ་ཞིག་པས་བུམ་པ་ཡང་འཇིག་པར་འགྱུརཏེ་དེ་ལ་བུམ་པ་དང་མཐོང་བ་ནི་གཅིག་པའོ་ཞེས་གང་བྲྗོད་པདེ་ནི་མ་ཡིན་ནོ།",
    "འོན་ཀྱང་གང་འདི་ལ་སྐྱེ་བཞེས་འཛིན་པ་ནི་རྒྱུལས་བྲ་བའི་བདག་ཉིད་དུ་ཡོད་པའི་ཕྱིར་བྱེད་པ་ཡིན་ནོ།",
    "ཐ་ག་པ་ལ་སོགས་པ་རྣམས་མེད་པར་འགྱུར་རོ།",
    "དེ་མེད་ན་ཐམས་ཅད་མེད་པར་འགྱུར་ཏེ།",
    "དེའི་ཚེ་འདས་པ་དང་མ་འོངསཔ་ཡང་མེད་པར་འགྱུར་ལ།",
    "འདིའི་ཕྱིར་ཡངའབྲས་བུ་མེད་པར་སྨྲ་བ་ཡིན་ནོ།",
    "དེ་གྲུབ་པའི་ཕྱིར་ཡང་འབྲས་བུཡོད་པ་དང་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "འདི་ལྟར་ཡོད་པའི་བུམ་པ་འཇིམ་གོང་ལ་སོགས་པ་རྣམས་ཀྱིསསྐྱེད་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "ཐག་པ་ལ་སོགས་པས་རུས་སྦལ་གྱི་སྤུའི་གོསསྐྱད་པརབྱེད་པ་མ་ཡིན་ཏེ་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྐྱེ་བར་མི་འགྱུར་ན་དེའི་ཚེ་འདུས་བྱས་གྱིམཚན་ཉིད་མེད་པར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིརའདུས་བྱས་ནི་ཡོད་པ་སྟེ།",
    "དེ་ཡོད་པའི་ཕྱིར་ཐམས་ཅད་འགྲུབ་པརའགྱུརརོ་ཞེ་ན།",
    "འདུས་བྱས་མེད་དོ།",
    "རྩོད་པ་པོ་ལས་བྲྗོད་པར་བྱ་སྟེ།",
    "དེ་ལས་མ་གཏོགས་པགཞན་འདུས་བྱས་ཉིད་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེ་བས་ན་འདུས་བྱས་ནི་མེད་དོ།",
    "འདུས་བྱས་བཀག་པའི་ཕྱིར་འདུས་མ་བྱས་ཁས་བླངས་ལདེ་ཁས་བླངས་པའི་ཕྱིར་འདུས་བྱས་འགྲུབ་སྟེ།",
    "ཐམས་ཅད་ནི་ཟླཡོད་པར་དམིགས་ཏེ།",
    "དེབཞིན་དུ་འདུས་བྱས་དང་འདུས་མ་བྱས་ཀྱང་ཡིན་པར་བྱ་སྟེ།",
