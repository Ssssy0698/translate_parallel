    "འདི་ནི་འབྲས་བུ་ཐ་མི་དད་པར་བརྗོད་དོ།",
    "དེས་ན་རྒྱུ་ཐ་དད་པར་མི་རྟག་གོ་སྙམ་དུ་དགོངས་པའོ།",
    "དུ་བ་ནི་དེ་ལྟ་བུར་གྱུར་པ་གཞན་ལས་མ་ཡིན་པའི་ཕྱིར་རྒྱུ་ཐ་དད་པར་མཐོང་བ་ལས་འབྲས་བུ་ཐ་དད་པར་རྗེས་སུ་དཔོག་པར་འགྱུར་བ་ལ་རག་གོ།",
    "སྐྱེ་བ་གཞན་གྱིས་གོམས་པ་ཁོ་ནས་བྱས་པ་ཡིན་ནོ་ཞེས་གནས་སོ།",
    "གལ་ཏེ་འདུས་བྱས་པ་འདི་འཇིག་རྟེན་ཕ་རོལ་གྱི་གོམས་པས་བྱས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་མི་དམིགས་པས་གནོད་པ་མ་ཡིན་ནམ་སྙམ་ན།",
    "དེ་ཞེས་གསུངས་སོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཞེས་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་འདིར་ཞེས་གསུངས་སོ།",
    "དཔེར་ན་སྔར་སྐྱེས་པ་འཕེལ་བ་ལ་སོགས་པ་མེད་པར་མ་ཧེ་དེ་ལྟར་ཐ་སྙད་བྱེད་པ་ཙམ་བཞད་གད་ཀྱི་གནས་ཡིན་པ་དེ་བཞིན་དུ་སྔོན་གོམས་པ་མེད་པ་ཉིད་དུ་སྐྱེ་བ་དང་པོའི་འདུ་བྱེད་པ་ལ་སོགས་པ་ལ་དེ་ལྟར་ཐ་སྙད་ཙམ་བྱེད་པ་ལ་བཞད་གད་ཀྱི་གནས་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "དེས་ན་ཁྱད་པར་དེ་ལྟ་བུ་སེམས་པ་ཡིན་ནོ་སྙམ་པས་ཕན་ཚུན་ཞེས་སྨྲས་སོ།",
    "ནམ་གྱི་སྒྲས་ནི་བརྗོད་པའི་ཕྱོགས་མི་འདོད་པར་ཕྱོགས་གཞན་ཁས་བླངས་པའི་དོན་ཏོ།",
    "གལ་ཏེ་བལྟར་རུང་བར་ཁས་བླངས་ན་སྐྱོན་འདིར་འགྱུར་གྱི་མཚོན་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་ཡིན་ན་ཉེས་པ་འདིར་ཅི་ལྟར་འགྱུར་སྙམ་ན།",
    "དེ་ལྟ་ཡིན་ན་ཞེས་བྱ་བ་ཁྱད་པར་བལྟར་མི་རུང་བ་ཡིན་ནའོ།",
    "མཐོང་བ་ཞེས་བྱ་བ་ནི་རྒྱུ་ཉིད་དུ་ངེས་པར་རྟོག་པའོ།",
    "བརྟག་པར་བྱ་བ་ནི་ངེས་པར་བྱ་བའོ།",
    "གལ་ཏེ་འགའ་ཞིག་ལ་གོམས་པ་རྒྱུར་མཐོང་བ་ནི་དེ་ལྟ་ན་ཡང་ཡོངས་སུ་གྱུར་པའི་ཁྱད་པར་ཉིད་ཅི་སྟེ་མི་རྟག་སྙམ་ན།",
    "མ་མཐོང་བ་རྟོག་ན་ནི་ཞེས་གསུངས་ཏེ།",
    "དེའི་ཚེ་དུ་བ་ཡང་སའི་ཡོངས་སུ་འགྱུར་བའི་ཁྱད་པར་ཉིད་ཀྱིས་བསྐྱེད་པར་འགྱུར་གྱི་མེས་བསྐྱེད་པར་ནི་མི་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་འཆད་པར་འགྱུར་བ་དག་ལ་ཡང་ཅི་རིགས་པར་དཔག་པར་བྱའོ།",
    "སྔ་མ་སྔ་མའི་ཞེས་གསུངས་སོ།",
    "དཔེ་འདི་ཡང་ཤིན་དུ་རྙེད་སླའོ་སྙམ་དུ་དགོངས་ནས་དཔེར་ན་རྨི་ལམ་ལུས་ལ་ནི་ཞེས་གསུངས་སོ།",
    "སད་པའི་ལུས་རྣམ་པར་འགྱུར་བ་ནི་ཚིག་འཆོལ་པ་དང་འདིར་བ་ལ་སོགས་པའོ།",
    "དེ་བཞིན་སྐྱེ་བ་གཞན་དུ་ཡང་སྐྱེ་བ་གཞན་དུ་བྱས་པའི་གོམས་པ་ལས་ལུས་རྣམ་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་ལྟའོ།",
    "བདེན་དང་བདེན་མིན་ཞེས་བྱ་བ་ཞེས་གསུངས་སོ།",
    "དུ་བ་ལ་ནི་སྐད་ཅིག་སོ་སོ་ལ་འོག་ནས་འོག་ཏུ་ལ་འགྲིབ་པ་ཡོད་པའི་ཕྱིར་ཉེ་བར་ལོག་པ་མ་ཚང་བས་ན་ཟད་པར་འཐད་པ་ཡིན་ནོ།",
    "ཁྱད་པར་ལྷག་དང་ལྷག་དམིགས་པའི་ཕྱིར་ཏེ།",
    "སེམས་ལས་ནི་འགལ་བ་ཡང་འགའ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་ཕྱིས་འཆད་པར་འགྱུར་རོ།",
    "དེས་ན་རྨི་ལམ་གྱི་ལུས་བཞིན་དུ་མཐར་ལུས་དང་ངག་ཉིད་གཏན་ཆད་པར་འགྱུར་གྱི་སེམས་ནི་མ་ཡིན་ནོ།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བས་རྒྱུ་དང་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་གྱུར་ན་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་མེད་པར་ཅི་ལྟར་འགྱུར་ཞེ་ན།",
    "ལན་དུ་དེ་མེད་ན་མེད་དོ་ཞེས་བྱ་བ་ག་ལས་ཞེས་གསུངས་ཏེ།",
    "དེ་ཡོད་ཀྱང་འབྲས་བུ་མེད་པར་ཁས་བླངས་པའི་ཕྱིར།",
    "དེ་ཡོད་ན་ཡོད་པ་ལ་དེ་ལྟར་བརྗོད་པར་ནུས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་དེར་ཁྱེད་ཀྱི་ལན་གང་ཡིན་པ་དེ་ཉིད་འདིར་ཡང་འགྱུར་རོ་ཞེས་བྱ་བར་རིགས་པ་ཡིན་ནོ།",
    "འདིས་ནི་ཡང་དག་པའི་ཐ་སྙད་ལ་ལྟོས་ནས་རྒྱུ་དང་འབྲས་བུ་དག་ཕན་ཚུན་ཁྱབ་པར་བསྟན་ཏོ།",
    "དོན་དམ་པ་ལ་ལྟོས་ནས་རྩོད་པ་དོགས་པར་བྱེད་པ་ནི་དེ་ལྟར་ཞེས་བྱ་བ་སྟེ་ཁྱབ་པར་རོ།",
    "གལ་ཏེ་ཁྱད་པར་ཞེས་བྱ་བ་ནི་གྲུབ་པའི་མཐའོ།",
    "ཁ་ཅིག་གཅིག་ལས་འགའ་ལ་ཡང་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་མཐོང་བ་མེད་དོ་ཞེས་ལས་ཀྱི་དྲུག་པ་གཞི་ཐ་དད་པར་བྱ་སྟེ་འདོན་ཏོ་ཞེས་བྱ་བ་ནི་ཕྱིར་གྱི་དོན་ཏོ།",
    "དོན་དམ་པར་ནི་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "འཁྲུལ་པ་ཡིན་གྱི་འོག་ཏུ་ཞེས་གསུངས་སོ།",
    "དེ་ལ་མ་ལྟོས་ན་ནི་འཇིག་རྟེན་ཕ་རོལ་བསྙོན་པ་བས་བསྒྲུབ་པ་ཉིད་བསྡམ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཉི་གའི་མཚན་ཉིད་ཅན་གྱི་འབྲས་བུ་ཕན་པ་མཐའ་དག་དང་མཐོང་བའི་ཡོན་ཏན་སྐྱེ་བོ་དམ་པ་དེ་དག་ཉམས་པར་བྱེད་པ་ཉིད་ཡིན་ནོ།",
    "འཇིགས་སུ་རུང་བའི་རྣམ་པ་ནི་རྟོག་པར་མི་འདོད་དོ།",
    "གལ་ཏེ་མིག་ལ་སོགས་པའི་འཇིག་རྟེན་ཕ་རོལ་སྒྲུབ་པར་བྱེད་པ་ནོར་བ་ཡང་ཇི་ལྟར་འདོད།",
    "འདི་ལྟར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་སྐད་དུ་ཡང་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་ལས།",
    "སྣང་བའི་རྣམ་པར་ཤེས་པ་ནི།",
    "ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་སྔོན་པོ་ལ་སོགས་པ་གསལ་བ་ཉིད་ཀྱིས་རྣམ་པར་རིག་པའི་ནང་དུ་འདུས་པར་རིགས་ཀྱི།",
    "དེ་སྣང་བ་ལ་སོགས་པ་རྣམ་པར་གཞག་གོ།",
    "དེ་ལྟ་ན་ནི་དེ་ཁོ་ན་བཞིན་དུ་ཐ་མ་ཡང་མེད་པར་འགྱུར་བས་ན།",
    "ཅི་སྲིད་ཅེས་གསུངས་སོ།",
    "དེ་ལྟར་རྣམ་པར་རིག་པ་ཙམ་ལ་གནས་པ་ལ་མིག་ལ་སོགས་པའི་འཇིག་རྟེན་ཕ་རོལ་སྒྲུབ་པ་འགལ་བ་མེད་དོ་ཞེས་གནས་སོ།",
    "མིག་ལ་སོགས་པ་བདེན་པ་ཉིད་དམ་ཞེས་གསུངས་ཏེ།",
    "ཡང་ན་མིག་ལ་སོགས་པ་རྣམ་པར་ཤེས་པའི་རང་བཞིན་དུ་བདེན་པ་ཉིད་དམ།",
    "གཉི་ག་ལ་ཡང་སེམས་ནི་རྒྱུན་མི་འཆད་པར་གྲགས་པ་དང་མིག་ལ་སོགས་པ་རྣམས་ཀྱང་མཐའ་མེད་པའོ་ཞེས་བྱ་བ་ནི་བསྡུས་པའི་དོན་ཏོ།",
    "ཐོག་མ་མེད་པ་ཉིད་རྣམ་པར་གནས་པ་ནི་སྔ་མ་བཞིན་ནོ།",
    "རྗེས་སུ་མཐུན་པའི་ཁྱད་པར་ལ་སོགས་པ་ལ་དམིགས་པ་མེད།",
    "སྲ་བ་ཉིད་ལ་སོགས་པས་ཞེས་བྱ་བས་ནི་འཇམ་པ་ཉིད་དམ་དྲི་ང་བ་ཉིད་ལ་སོགས་པ་ཅི་ལྟར་མཐོང་བའི་ཁྱད་པར་རྣམས་སྡུད་པའོ།",
    "དེའི་རྣམ་པར་འགྱུར་བ་ཤིང་ལ་སོགས་པ་ནས་སོ།",
    "དྲོད་གཤེར་ལས་སྐྱེས་པ་ཡང་སའི་རྣམ་པར་འགྱུར་བ་ཉིད་མངལ་དུ་སྐྱེ་བ་ཡིན་ནོ།",
    "འོན་ཏེ་ཞེས་བྱ་བས་ནི་སའི་རྣམ་པར་འགྱུར་བའི་རྣམ་པར་དབྱེ་བས་སྲོག་ཆགས་ཀྱི་རྒྱུ་ཡིན་ཞེས་སྟོན་པའོ།",
    "དེ་བཞིན་དུ་ལུས་སྔོན་པོ་ལ་སོགས་པ་ཡང་རིག་པར་བྱའོ།",
    "འོན་ཏེ་རྒྱུ་རིགས་མཚུངས་པ་ཉིད་ལས་སྲོག་ཆགས་རྣམས་ཀྱི་རྣམ་པ་ཐ་དད་པར་འགྱུར་རོ་སྙམ་ན།",
    "འདུས་བྱས་པ་ལས་ནི་ཐ་དད་པར་འགྱུར་སྲིད་པ་ཡིན་ཏེ།",
    "དེས་ན་གལ་ཏེ་མཐོང་བའི་ཁྱད་པར་ཡོངས་སུ་རྟོགས་པར་ཁས་ལེན་ན།",
    "གཞན་ཐམས་ཅད་ཀྱང་འགྱུར་ཏེ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་ལས་འདས་ནས་རིང་དུ་ལོན་པ་ཡང་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བརྗོད་ཟིན་ཏོ།",
    "གཡོ་བག་ཅན་མ་ཡིན་པའི་རྣམ་པར་དབྱེ་བར་མི་འགྱུར་རོ།",
    "བློའི་འདུ་བྱེད་པ་ལས་རྣམ་པར་དབྱེ་བར་འགྱུར་རོ་ཞེ་ན།",
    "བློ་ཡང་རྣམ་པ་ཐམས་ཅད་དུ་འགགས་པར་མཐོང་བའི་དེར་ཚུལ་ཇི་ལྟར་ཡིན།",
    "གང་ལས་དེ་རྣམས་ཉམས་པས་ཡིད་ཀྱི་བློ་ཉམས་པར་དོགས་པའམ།",
