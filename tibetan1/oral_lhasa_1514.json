    "ངེས་གཟུང་མི་དགོས་པར་སྤང་བའོ།",
    "ཅིས་ཏེ་གྲུབ་པར་བསྟན་པ་ཡིས།",
    "སྤྱིའི་མཚན་ཉིད་ཀྱི་ཡུལ་ཅན་མ་ཡིན་པའི་རྗེས་སུ་དཔག་པ་ནི་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "དེ་ལས་གཞན་འགའ་ཞིག་བསྒྲུབ་བྱ་ཡིན་ན་ནི་སྤྱིར་མི་འགྱུར་ཞེས་གསུངས་སོ།",
    "དེ་བསྒྲུབ་པར་མི་ནུས་སོ་ཞེ་ན།",
    "བལྟོས་པ་མེད་པར་མ་ཁྱབ་དང་།",
    "རྒོལ་བས་ངག་ཏུ་མ་བརྗོད་ཀྱང་ཤེས་འདོད་དང་དཔག་འདོད་ཀྱི་རིགས་གཞུང་རྒྱ་མཚོ་ཡུལ་དུ་བྱས་པ་འགའ་ཞིག་བསྒྲུབ་བྱ་མ་ཡིན་པ་སེལ་བར་བྱེད་པའི་ཕྱིར།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པར་གྱུར་པ་འགལ་བའི་དོན་གྱིས་མ་བསལ་བ་ནི་ཕྱོགས་ཡིན་ནོ་ཞེས་པ་འདིས་ཕྱོགས་ཀྱི་སྐྱོན་ཇི་ལྟར་སེལ་ཅེ་ན།",
    "འདོད་པར་གྱུར་པ་ཞེས་བྱ་བ་ནི་བྱུང་བར་གྱུར་པའི་དུས་བརྗོད་པ་ནི་ཋའི་རྐྱེན་ཉིད་ཡིན་པས།",
    "བསྒྲུབ་བྱ་ཉིད་དུ་འདོད་པར་འགྱུར་བ་ལ་མི་འཇུག་པས་ན་དེ་ཉིད་ཀྱིས་དེ་བཟློག་པའི་ཕྱིར་སྐྱོན་མེད་དོ་ཞེས་གསུངས་པ་ལྟར་རིགས་སྐོར་ཚིག་ཕྲད་མ་གསུངས་ཀྱང་སྐྱོན་མེད་དོ།",
    "གྱུར་པའི་ཚིག་ནི་དཔག་འདོད་ཀྱི་ཡུལ་དུ་བྱས་ཟིན་པའི་ཚིག་༡ ཡིན་པའི་ཕྱིར།",
    "འདོད་པར་གྱུར་པའི་ཚིག་དག་ལ།",
    "བསྒྲུབ་ཚུལ་དེ་ལ་ཀུན་ལས་བཏུས་དང་རིགས་པའི་སྒོ་གཉིས་ལ་ཁྱད་པར་ཡོད་པ་མ་ཡིན་ཀྱང་།",
    "མིའི་རྐྱེན་དེས་གཏན་ཚིགས་སྒྲུབ་ལ་སོགས་བའགོག་པ་ཉིད་དོ་ཞེས་གསུངས་སོ།",
    "རང་ཉིད་དང་བདག་ཉིད་ཀྱི་འདོད་པ་ཞེ་ཚིག་གཉིས་ཀྱིས་བསྟནབཙོག་ནལ་བའཨཔ་མེད་པར་ཐོབ་དེས་དཔག་འདོད་ཀྱི་ཡུལ་དུ་བྱས་པའི་བསྒྲུབ་བྱ་ཉིད་དུ་བསྟན་པཡིན་པའི་ཕྱིར།",
    "ཆུ་བསྒྲུབ་བྱ་བརྗོད་མི་དགོས་ཀྱང་དེའི་མཚནཉིད་བརྗོད་པར་བྱ་བ་ཡིན་ཏེ།",
    "རྒོཔལས་སྒྲུབྱེད་འགོད་པར་ཁས་བླངས་པའི་ཚོགས་དོན་བསྒྲུཅད་གཟུང་ངོ་ཞེས་རིག་པར་བྱབའི་ཕྱིར་ཚིག་བཞི་སྨོས་སོ།",
    "མ་བསལ་བའི་འོག་ནས་འཆདཔར་འགྱུར་རོ།",
    "མི་འདོད་པའི་སྤྱི་བཀགཔསམིགནོདཔར་བསྟན་པའོ།",
    "གཏམ་སྨྲས་ཀྱང་ཞེ་འདོད་བསྒྲུབ་བྱ་ཡིན་པ་དེ་ནི་ཇི་ལྟརམཞེའདོད་ལབའི་བསྒྲུབ་པརཁྱབ་ཉིད་དུ་འདོད་པ་ཡིན་ནོ་ཞེས།",
    "ཁྱདཔར་ཞེསསོགས་ཏེ།",
    "རྟགས་གངལས་བསྒྲུབ་བྱ་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "དཔེ་། གང་ལས་ཀྱད་ཁྱབ་པ་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "རྗེས་འཕོ་མེདཔའིསྐྱོན་མེད་པར་འདོད་པ་དགག་པའོ།",
    "འདོད་པའི་བསྒྲུབ་བྱ་ལ་གནོད་པར་བྱེད་པའང་མི་འགྱུར་ཏེ།",
    "ཕྱིན་ཅི་ལེག་ཏུ་མི་རྟག་པ་དུ་མའི་དོན་བྱེད་པ་བསྒྲུབ་བྱ་ཡིན་པར་གྲུབ་པར་འགྱུར་བའམ་བསྒྲུབ་བྱ་འགྲུབ་བའི་དོན་མེད་པར་འགྱུརཏེ་དོབ་བྱེད་པ་གཉིས་ལསམེད་ལ།",
    "ལྷས་བྱིན་ཞེས་གཉིས་ཀ་ལད་ཕྱིརོལ་གྱི་དོན་ལྡན་དུ་མཚུངས་པར་འདོད།",
    "རྒྱས་པར་བཤདཔའོ།",
    "རྒྱུད་འཕེན་པས་སྐྱེ་བ་སྔ་ཕྱི་མེད་པར་སྨྲས་པ་ལ།",
    "ལུས་ཀྱི་བ་བཅས་ཀྱི་ཁྱད་པར་བསྒྲུབ་བྱར་འཕེན་པ་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ལུས་ཀྱི་ཟླ་བཅས་སྐབས་ཀྱི་བསྒྲུབ་ཏམ་ཡིནནསྐྱོན་དུ་མ་ཡོད་པ་དེསན་གྲུབབ་ལུས་ཀྱི་ཟླ་བཅས་བསྒྲུབ་བྱར་འཐེན་དགོས་པའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པ་རྟགསཀྱིནུས་པས་ཁྱབ་པའི་ལུས་ཀྱི་ཟླ་བཅས་ལ་སོགས་པའི་དོན་གྱི་རྣམ་པ་ཇི་སྙེད་པ་དེ་ཐམས་ཅདནི་དཔེ་ལ་རྗེས་འགྲོམེད་དོ་ཞེས་སུན་འབྱིན་པས་ཀྱང་གནོད་པ་ཡིནནོ།",
    "ཚདེས་ཕྱོགས་དང་མཐུནཕྱོགས་གང་རུང་མ་གྲུབ་པར་བསྟན་པའོ།",
    "དཔེར་ནལྷ་སྦྱིན་བནཟ་བ་ན།",
    "ལྷ་སྦྱིན་དང་མཆོད་སྦྱིན་གངསང་རུང་བ་ཞིག་བྱའོ་ཞེས་བྱ་བ་ལྟ་བུ་བརྗོད་པར་ནུས་པ་ཡིན་གྱི།",
    "༤ སྤྱི་སྒྲ་འཇུག་པམེད་པས་བཏགས་པའི་སྤྱི་བསྒྲུབ་པར་ནུས་པམ་ཡིན་ནོ།",
    "ལུགསྤྱི་ཟླ་བཅས་མི་སྲིད་པར་ངེས་པའི་ཤུགས་ཀྱིས་སོ།",
    "དེབསྒྲུབ་པར་མི་འཐད་པའོ།",
    "དཔེར་ན་ལྷ་སྦྱིན་དངམཆོད་ན་དག་ལསགང་ཡང་རུང་བགཅིག་འཐན་སྦྱིན་པར་བྱ་བ་ཡིན་ཏེ།",
    "ལྷ་སྦྱིན་ཞེས་སོགས་ཏེ།",
    "གཙལ་ཏེམཆོདསྦྱིནནལ་ལྷ་སྦྱིན་འབའ་ཞིག་ལ་ཟན་སྦྱིན་པར་བྱ་བ་མ་ཡིན་ནོ་སྙམ་དུ་བསམ་པའི་ཕྱིར་སྐྱོན་མེད་དོ་ཞེ་ན།",
    "དེ་འི་ཕྱིར་ཞེས་སོགསཏེ་ལུས་བུམགཉིསཀམི་སྲིདན་གང་ཡང་བཀྐཱཚད་བའི་སྤྱི་ཡང་མི་སྲིད་པ་དེའི་ཕྱིར་ལུས་མ་གཉིས་ལས་གང་ཡང་རུང་བ་ཞིག་བུམ་པའི་ཟླ་བོར་ཡོངས་སུ་བཟུང་ཡང་རིགས་པ་དང་མི་འགལ་བ་ཡིན་ན་གང་ཡང་རུང་བའི་ཟླ་བོ་དང་བཅས་པ་ཞེས་སྨོས་པ་འདིནུས་པར་འགྱུར་ཏེ།",
    "གཉིས་པ་བཏགས་པའིསྤྱི་བསྒྲུབ་པར་མི་འཐད་པ་ནི།",
    "ཕྱོགས་དང་མཐུན་ཕྱོགས་གང་རུང་གཅིག་ཏུ་མ་ངེས་པར་གཉིས་ཀར་ཡང་སྲིད་པར་མི་འགལན་སྒདེ་ཕྱོགས་དང་མཐུན་ཕྱོགས་གང་རུང་དེ་ལྟར་འགྱུར་གྱི།",
    "དེལྟར་མ་ཡིན་པར་ཕྱོགས་ཁོ་ནར་ངེས་པའི་ཕྱིར་རོ།",
    "གང་རུང་དུ་རྣམ་པར་བརྟག་པ་དང་གཅིག་ཏུ་སོར་ངེས་པ་འགལ་བའི་ཕྱིར་རོ།",
    "རིའམ་ཤད་ལ་ནི་དོགསཔར་འགྱུར་བ་མ་ཡིན་པ་བཞིན་ནོ།",
