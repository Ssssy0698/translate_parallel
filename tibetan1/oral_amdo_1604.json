    "དངོས་དངོས་པོ་དང་དངོས་པོ་མེད་པར་སྟོན་པའི་རྗེས་སུ་དཔག་པ་མེད་པ་ཁོ་ནའི་ཕྱིར་དེ་བསྒྲུབ་པར་མི་འདོད་པས་ཁོ་བོ་ཅག་གི་འདོད་པ་ཁོ་ན་འགྲུབ་པར་འགྱུར་གྱི།",
    "རང་གི་ཕྱོགས་སྒྲུབ་པ་ནི་མ་ཡིན་ནོ།",
    "ཞེས་བྱ་བའི་ཚིག་གི་ལྷག་མའོ།",
    "འདི་དག་ལ་རྐྱེན་ཉིད་མེད་དོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཏོ།",
    "གང་གི་ཕྱིར་འདིར་རྐྱེན་རྣམས་འབྲས་བུ་སྐྱེ་བའི་སྔོན་རོལ་དུ་རྐྱེན་མ་ཡིན་པ་ཉིད་དུ་བསྟན་པས་འབྲས་བུ་སྐྱེ་བའི་དུས་ན་ཡང་རྐྱེན་མ་ཡིན་པ་ཉིད་དུ་བསྟན་བཅོས་མཛད་པ་སྟོན་པར་བཞེད་དོ།",
    "དོན་དམ་པར་དེ་དག་གི་རྐྱེན་རྣམས་ནི་ནང་གི་སྐྱེ་མཆེད་རྣམས་སྐྱེད་པར་བྱེད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "དཔེར་ན་རི་བོང་གི་རྭ་བཞིན་ནོ་ཞེས་ཟེར་རོ།",
    "མེད་ན་གང་གིས་རྐྱེན་དུ་འགྱུར།",
    "འདི་ན་ནམ་མཁའ་མེ་ཏོག་ལ་སོགས་པ་མེད་པ་གང་གི་རྐྱེན་མ་ལུ་ཏའི་ལྷུག་མ་དག་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་དག་ནི་ནམ་མཁའི་མེ་ཏོག་དང་རི་བོང་གི་རྭ་གང་གི་རྐྱེན་ཀྱང་མ་ཡིན་ནོ་ཞེས།",
    "དེ་དག་གི་འབྲས་བུ་མེད་པའི་ཕྱིར་དཔེར་ན་ནམ་མཁའི་མེ་ཏོག་མེད་པའི་ཕྱིར་ནམ་མཁའ་བཞིན་ནོ།",
    "སྔ་ན་མེད་པའི་ཕྱིར་རོ་ཞེས་ཟེར་བ་དེ་དག་གི་ཕྱིར།",
    "མེད་ན་གང་གི་རྐྱེན་དུ་འགྱུར།",
    "སབ་མ་ལ་སོགས་པ་མེད་པ་ཉིད་ཡིན་ན་ཡང་མེད་པ་གང་གི་རྐྱེན་དུ་འབྲས་བུ་ལ་སོགས་པ་འདོད་དེ།",
    "གང་གི་ཕྱིར་ཡང་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཏོ།",
    "ཡོད་ན་ཡང་མྱུ་གུ་རང་གི་བདག་ཉིད་ཀྱིས་ཡོད་པ་ལ་ནི་ཐ་སྙད་དུ་ཡང་འབྲས་བུ་ལ་སོགས་པ་རྐྱེན་ཡིན་པར་མི་འདོད་དེ།",
    "དེ་དག་གི་གསལ་བ་ཡང་བསལ་ཟིན་པའི་ཕྱིར་དང་།",
    "མ་སྐྱེས་པའི་ཕྱིར་ནི་ཡོད་པ་མ་ཡིན་པས་དེའི་ཕྱིར་ཁོ་བོ་ཅག་གི་ཕྱོགས་ལ་ཇི་སྐད་སྨྲས་པའི་བསྒྲུབ་པའི་གནོད་པ་མེད་དོ་ཞེས་ཟེར་རོ།",
    "དོན་དམ་པར་མིག་ལ་སོགས་པར་དེ་དག་མིག་གི་རྣམ་པར་ཤེས་པ་དང་།",
    "མྱུ་གུ་དེ་དག་གི་རྐྱེན་མ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་དག་གི་འབྲས་བུ་ཡོད་པ་དང་མེད་པ་ཉིད་དུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར།",
    "དེ་ལྟར་རེ་ཞིག་རྐྱེན་རྣམས་སྤྱིར་དགག་པ་བསྟན་ནས།",
    "འོ་ན་བསྐྱེད་པར་བྱ་བ་སྐྱེ་བ་ནི་ཚོགས་པ་ལ་རག་ལས་པའི་ཕྱིར་བསྐྱེད་པ་ཉིད་ནི་གཅིག་པུ་མ་ཡིན་ནོ་ཞེ་ན་སྐྱེ་བ་དགག་པའི་ཕྱིར་དེ་མི་འཐད་པ་ནི་འདོད་མོད་ཀྱི།",
    "ནང་གི་སྐྱེ་མཆེད་རྣམས་སྐྱེད་པར་བྱེད་པ་རྒྱུ་ལ་སོགས་པ་ནི་ཡོད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "འདིར་ཁྱོད་ཀྱི་གཏན་ཚིགས་ཀྱི་དོན་དུ་འདོད་པ་གང་ཡིན།",
    "གཞན་དག་ན་རེ།",
    "གཞན་དག་ན་རེ་དོན་དམ་པར་དངོས་པོ་རྣམས་སྐྱེ་བ་ཁོ་ན་ཡིན་ཏེ།",
    "དེ་ལྟར་རེ་ཞིག་རྒྱུའི་རྐྱེན་གྱི་རྐྱེན་ཉིད་མི་རིགས་སོ།",
    "འདི་ཞེས་བྱ་བ་ནི་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་བྲོ་ལ་བཞག་པ་བསྟན་པའོ།",
    "དམིགས་པ་གང་གིས་སྐྱེ་བ་ན།",
    "འགའ་ཞིག་གིས་དམིགས་པར་བྱེད་པ་མ་ཡིན་པའི་དམིགས་པ་ཉིད་ཡོངས་སུ་བརྟགས་པ་ཡང་མི་འཐད་པའི་ཕྱིར།",
    "འདི་ལ་དམིགས་པ་མེད་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཏེ།",
    "གལ་ཏེ་གཟུང་བ་ནི་དམིགས་པའོ་ཞེས་དེ་དག་གི་དོན་ལ་རྟོག་ན་ཡང་སེམས་དང་སེམས་ལས་བྱུང་བའི་གཟུང་པ་ཉིད་འགོག་པར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "སེམས་དང་སེམས་ལས་བྱུང་བའི་ཚོགས་འགག་པ་དེ་དེ་མ་ཐག་པའི་རྐྱེན་ཡིན་པར་འདོད་ན་དེ་ཡང་ཚོགས་སྐྱེ་བར་འདོད་པའི་རྐྱེན་ཉིད་དུ་མི་རིགས་ཏེ།",
    "འགག་བཞིན་པ་རྐྱེན་ཉིད་དུ་རྟོག་ན་ཡང་ཁ་ཅིག་ན་རེ།",
    "འདིར་ཁོ་བོ་ཅག་གི་ཕྱོགས་ལ་ནི་དོན་དམ་པར་སྐྱེ་བ་མེད་པར་བསྟན་པས་དངོས་པོ་རྣམས་རང་གི་བདག་ཉིད་མ་ཐོབ་ཅིང་།",
    "དེ་དག་གི་དཔེའི་སྐྱོན་སྔ་མ་བཞིན་ནོ།",
    "དོན་དམ་པར་མིག་ལ་སོགས་པ་ནང་གི་སྐྱེ་མཆད་དག་སྒྲུབ་པར་བྱེད་པའི་རྐྱེན་རྣམས་ཡོད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "མེད་ན་གང་གིས་རྐྱེན་དུ་འགྱུར།",
    "འོན་གང་གི་ཚེ།",
    "རྐྱེན་རྣམས་ལ་མེད་དོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཏོ།",
    "དོན་དམ་པར་ནང་གི་དངོས་པོ་རྣམས་ཀྱི་རྐྱེན་རྣམས་ཡོད་པ་ཁོ་ནར་བཟུང་སྟེ།",
    "དོན་དམ་པར་འབྲས་བུ་རྐྱེན་ལས་བྱུང་བ་། མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཏོ།",
    "འབྲས་བུ་ནི་འབྲས་བུའི་ངོ་བོ་ཉིད་མི་འདོར་བས་དེ་མ་བཀག་པའི་ཕྱིར་གཞན་གྱིས་ཀྱང་བརྗོད་པར་ནུས་ཏེ་དོན་དམ་པར་ནང་གི་སྐྱེ་མཆེད་རྣམས་ཀྱི་རྐྱེན་རྣམས་ཡོད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "ཁོ་བོ་ཅག་གིས་རྐྱེན་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་རྐྱེན་གྱི་ངོ་བོ་ཉིད་དགག་པ་ཙམ་བསྟན་པ་ཡིན་ཏེ།",
    "རྐྱེན་མ་ཡིན་པ་རྣམས་རྐྱེན་གྱི་ངོ་བོ་ཉིད་དུ་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཏོ།",
    "ཁྱོད་ཀྱིས་རྣམ་གྲངས་དེས་ཀྱང་འདི་ལྟར་རིག་པར་བྱ་སྟེ།",
