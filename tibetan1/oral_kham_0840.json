    "པའམ་ནམ་མཁའ་ལྟ་བུའི་སྟོང་པར་འདུག་དང་།",
    "རྣམ་རྟོག་གང་སྣང་བའི་འཆར་སྒོ་རྣམས་བརྟགས་པའི་ཚེ་དབྱིབས་ཁ་དོག་དང་ངོས་བཟུང་མི་འདུག་ཅིང་།",
    "སྣང་བ་ཡང་སྣང་ཆ་མ་འགག་པར་སྣང་ཙམ་ལས་ཨ་འཐས་ཀྱི་བདེན་འཛིན་མེད་པ་བཀྲག་མེད་ལྟ་བུ་འདི་འདྲ་ཞེས་བརྗོད་པར་དཀའ་བ་ཞིག་འདུག་པར་གོ་ན་མྱོང་བ་སྐྱེས་པ་ཡིན་པས།",
    "རྣམ་རྟོག་སྣ་ཚོགས་པ་རྣམ་པ་ཅིར་སྣང་ཡང་ངོ་བོ་ངོས་བཟུང་མེད་པ་སྣང་སྟོང་དུ་མྱོང་ཞིང་རང་ཤར་རང་གྲོལ་དུ་རིག་སྟེ།",
    "དེ་བཞིན་དུ་སྐྱིད་པའི་རྟོག་པ་ཞིག་དང་སྡུག་པའི་རྟོག་པ་ཞིག་སྤྲོས་ལ་དེ་གཉིས་ཀྱི་ངོ་བོ་ལ་ཁྱད་ཅི་འདུག་བལྟ་བ་སོགས་རྒྱབ་བསྣོལ་གྱི་རྟོག་པ་ཡང་ཐག་ཆོད་པར་བྱའོ།",
    "དེའི་བྱུང་གནས་འགྲོ་གསུམ་གོང་བཞིན་བརྟག་གཟུགས་སྣང་དང་སེམས་གཉིས་ཐ་དད་དུ་འདུག་གམ་གཅིག་ཏུ་འདུག་ཐ་དད་ན་ཕན་ཚུན་ནམ་ཕྱི་ནང་ངམ་སྟེང་འོག་ལྟ་བུར་འདུག་གམ།",
    "ལོག་ཤེས་འདུག་ན་གནོད་བྱེད་གཏོང་ཞིང་ཕྱོགས་བསྟན་ཏེ།",
    "དེ་གཉིས་རང་ལ་བཟང་ངན་དང་སྟོང་མི་སྟོང་དང་ངོ་བོ་གྲུབ་མ་གྲུབ་དང་ངོས་བཟུང་ཡོད་མེད་ཀྱི་ཁྱད་པར་ཅི་འདུག་ལ་སོགས་པ་བརྟག་ཁྱད་པར་མེད་ན་གཅིག་ནས་ཁྱད་པར་མེད་དམ་ཐ་དད་ཀྱང་མཚུངས་ནས་ཁྱད་པར་མེད་བརྟག་གཅིག་ན་ཐོག་མཐའ་བར་གསུམ་གང་དུ་གཅིག་བརྟག་མཚུངས་ན་ཇི་ལྟར་མཚུངས་ལ་སོགས་པ་བརྟག་དཔྱད་བྱེད་དུ་བཅུག་ལ་ཉམས་བལྟ།",
    "ལོག་ཤེས་འདུག་ན་མཐའ་བཀག་ཅིང་ཕྱོགས་བསྟན་ལ་སླར་བརྟག་ཏུ་བཅུགལྷན་ནེར་གནས་པ་དང་ཡེར་གྱིས་འགྱུར་པ་གཉིས་རྒྱུད་ཐ་དད་དུ་འཛིན་པ་ལས་ལོག་སྟེ།",
    "དེ་གཉིས་གང་བྱུང་ཡང་དགག་སྒྲུབ་སྤང་བླང་མི་དགོས་པར་གནས་ན་གནས་ཐོག་འགྱུར་ན་འགྱུ་ཐོག་དེ་གསལ་སྟོང་རང་གྲོལ་དུ་ངེས་ཤེས་སྐྱེ་དགོས་པ་ཡིན་ནོ།",
    "མཐར་སུས་ཀྱང་བཀག་པ་མེད་པར་རང་སངས་རང་དག་རང་གྲོལ་ལྟ་བུར་འདུག་པ་མྱོང་སྟེ།",
    "དེ་གཉིས་འདིར་བརྗོད་པ་སྔ་ཕྱི་ཡོད་ཀྱང་དོན་ལ་ཞི་གནས་དེ་དང་ལྷག་མཐོང་དེ་ཐ་དད་དུ་མེད་པར་ཞི་གནས་དེ་ཡང་ངོས་བཟུང་མེད་པའི་རང་རིག་རང་གསལ་གྱི་ལྷག་མཐོང་དེར་འདུག་གམ།",
    "རྣམ་རྟོག་དེ་ཡང་ངོས་བཟུང་མེད་པའི་གསལ་སྟོང་དུ་རྗེན་ནེ་འདུག་གམ།",
    "སེམས་ཉིད་ལྷན་སྐྱེས་ཀྱི་ངོ་བོ་དང་ཁྱད་མེད་པ་དེ་ཀར་འདུག་གམ་ལྟོས་དང་ཞེས་དར་ཅིག་བལྟར་ངེས་དོན་ཕྱག་རྒྱ་ཆེན་པོའི་ཁྲིད་དེ་ཉིད་གསལ་བ།",
    "། བཅུག་གསལ་སྟོང་དུ་འདུག་ཁྱད་མི་སྣང་ཟེར་ཡང་།",
    "རྣམ་རྟོག་དེ་སངས་ནས་གསལ་སྟོང་དུ་འདུག་གམ་རྣམ་རྟོག་དེ་ཚུར་སྒོམ་ལ་བཞག་པས་གསལ་སྟོང་དུ་འདུག་གམ་རྣམ་རྟོག་ལམ་མེ་བ་དེ་ཀ་གསལ་སྟོང་དུ་འདུག་དྲིས་པས།",
    "དེས་ན་གནས་པ་དང་འགྱུ་བ་ལ་ཁྱད་འདུག་གམ་རྟོག་པ་དང་མ་རྟོག་པ་ལ་ཁྱད་འདུག་གམ།",
    "མི་རྟོག་པར་ལྷན་གནས་པ་ལ་བཟང་རྒྱུའམ་དགའ་རྒྱུ་དང་རྣམ་རྟོག་ཡེར་གྱིས་འཕྲོས་པ་ལ་ངན་རྒྱུའམ་མི་དགའ་བ་དགོས་པ་འདུག་གམ།",
    "ཤར་བ་དེ་ལ་ཅེར་གྱིས་བལྟས་པའི་ཚེ་སྣང་བ་ངོས་བཟུང་མེད་པར་གསལ་སྟོང་དུ་འདུག་གམ།",
    "སྣང་བ་ཤར་བའི་རྣམ་པ་དེ་འགགས་ནས་གསལ་སྟོང་དུ་འདུག་གམ།",
    "སྟོང་དུ་འདུག་གམ།",
    "རྣམ་པ་སྣང་བ་དེ་ཀ་གསལ་སྟོང་དུ་འདུག་དྲིས་པས་སྔ་མ་གཉིས་ལྟར་ཟེར་ན་སྔར་བརྡར་ཤ་མ་ཆོད་པ་ཡིན་པས་སླར་སྒོམ་དུ་བཅུག་ལ་ཐག་བཅད།",
    "གཟུགས་ཀྱི་རྣམ་པ་ལམ་སྣང་བ་དེ་ཀ་སྣང་ཆ་མ་འགགས་པར་སྣང་ཙམ་ལས་ངོས་བཟུང་མེད་པར་གསལ་སྟོང་དུ་འདུག་པ་མྱོང་ན།",
    "གཞན་དག་ལ་དགག་པ་བྱ་བ་མིན་ཀྱང་རང་ལ་ཡིད་གཏོད་པ་དག་ལ་གོ་བ་བསྐྱེད་པའི་ཕྱིར་ཅུང་འདི་བརྗོད་པར་བྱ་སྟེ།",
    "ཡང་སྣང་བ་གསལ་མི་གསལ་གྱི་ཚོར་བ་མེད་པའི་དྲན་མེད་དུ་འདུག་པ་ལ་སྒོམ་དུ་བཟུང་ན་ལུང་མ་བསྟན་དུ་ཡེངས་པ་སྟེ་འདི་ཡིན་མེད་དོ།",
    "ཐ་མལ་གྱི་ཤེས་པ་ནི་སེམས་ཀྱི་རང་བབས་ཅི་འདུག་དེ་ཀ་ཡིན་ཏེ།",
    "སྟོང་ཆམ་མེ་བའམ་བདེ་ལྷམ་མེ་བའམ་འཚུབ་ཟིང་ངེ་བ་ཅི་འདུག་ནའང་མ་ཡེངས་པ་ལས་བསྒྱུར་དགོད་བཅས་བཅོས་བྱ་མི་དགོས་སོ།",
    "སྣང་བ་བཀྲག་མེད་དུ་རང་བཞིན་མེད་པར་སྣང་བ་དང་རང་དང་སྣང་བ་སྟོང་པར་ངེས་དོན་ཕྱག་རྒྱ་ཆེན་པོའི་ཁྲིད་དེ་ཉིད་གསལ་བ།",
    "སེམས་མ་ཡེངས་ཤིང་གུ་ཡངས་སང་ངེ་བའི་ངང་ནས་རྣམ་རྟོག་ཕྲ་རགས་དུ་མ་སྤྲོས་ཏེ་དེ་ལ་འཛིན་མེད་དུ་བལྟ་ཞིང་ཕྲ་རགས་དེ་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "དེ་དང་སེམས་གནས་པའི་ངོ་བོ་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "སྒོམ་གྱི་ངོ་བོ་དེ་སྐྱེ་འགག་ངོས་བཟུང་མེད་པ་བློ་འདས་ཡིན་སྙམ་པས་མི་ཆོག་པས་སེམས་མ་ཡེངས་ཤིང་གུ་ཡངས་སང་ངེ་བའི་ངང་ནས་སྒོམ་གྱི་ངོ་བོ་ལ་འཛིན་མེད་དུ་ལྷང་བལྟས་ལ་ཅི་འདྲ་འདུག་ཡང་ཡང་བལྟ།",
    "ཅི་ཡང་ཡིད་ལ་མི་བྱེད་སྙམ་པའི་འདུན་པ་ཡང་མེད་པར་ཐ་མལ་གྱི་སེམས་བཅོས་མེད་ཁ་མ་དེ་ཀར་སྡོད་ལུགས་ཅི་བདེ་བྱས་ལ་འདུག་རང་ཁ་མའི་རྣམ་རྟོག་དང་སྣང་བ་ཅི་ཤར་ཡང་བློས་བཅོས་བསྒྱུར་མི་བྱ་བར་གང་དགར་བཏང་།",
    "དེ་ལྟར་ཞག་འགའི་བར་དུ་ཡིད་བྱེད་ཐམས་ཅད་བོར་ལ་རང་ཁར་འདུག་ཏུ་བཅུག་སྟེ་ཉམས་བལྟ།",
    "ཐ་མལ་གྱི་སེམས་གང་འདུག་ཅི་ཤར་སྐྱེ་འགག་མེད་པ་སྤང་བླང་མེད་པ་བྲལ་ཐོབ་མེད་པ།",
    "ཕྱིས་སྒྲུབ་བརྒྱུད་པ་རྣམས་ཀྱིས་ལམ་ཁྱེར་དྲུག་དམིགས་བསལ་དུས་ཕྱེ་བ་རྩལ་སྦྱོང་དུ་ལེགས་པ་འདུག་ཅིང་བློ་རིགས་ཕལ་ཆེར་ལ་ཁྱད་ཆེ་བར་སྣང་བས་དེ་ལྟར་དུ་བྱས་པ་སྟེ་མིང་གཞན་རོ་སྙོམས་ཞེས་ཀྱང་གྲགས་སོ།",
    "བློ་ལས་སུ་མི་རུང་བ་སོགས་འདུག་ན་སྐྱེས།",
    "མཉམ་ཉིད་དུ་འདྲེས་རྒྱུ་དང་འདྲེས་པའི་མྱོང་འཛིན་ངེས་ཤེས་ཀྱི་འཛིན་པ་འདུག་ན་ངོ་བོ་མ་མཐོང་།",
    "དེ་ལྟར་བསྐྱངས་པས་ཉམས་དང་མྱོང་བའི་དྲི་མ་ཐམས་ཅད་ལམ་གྱི་རྟོགས་པ་དང་རང་བཞིན་གྱི་གནས་ལུགས་འདྲེས་ནས་མཉམ་རྗེས་དང་དྲན་པས་ཟིན་མ་ཟིན་མེད་པའི་སྒོམ་མེད་ཀྱི་རྟོགས་པ་འཆར་རོ།",
