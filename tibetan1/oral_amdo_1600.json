    "བདག་གི་ཚེ་འདིའི་མ་སྨྱོ་ནས་བདག་ལ་མཚོན་འདེབས་པ་སོགས་བྱེད་དུ་བྱུང་ན།",
    "ངེས་པར་བདག་གི་མ་འདི་སྡུག་བསྔལ་རྒྱུ་འབྲས་ལས་ལྡོག་པའི་ཐབས་བཙལ་ནས།",
    "མེད་པ་ལ་ཡོད་པར་འཛིན་པ་ལ་སོགས་པའི་འཁྲུལ་སྣང་གིས་ངན་སོང་གསུམ་པོའི་སྡུག་བསྔལ་དཔག་ཏུ་མེད་པ་མྱོང་དགོས་པར་འདུག་པ་འདི་རྣམས་ཀྱིས་སྤྲོས་བྲལ་གྱི་ལྟ་བ་རྟོགས་ན་ཅི་མ་རུང་།",
    "དེ་དག་གི་སྤྱོད་པ་ལ་བསླབ་པ་དང་གསུམ་གྱི།",
    "དེ་དག་གི་རྒྱུ་དང་འབྲས་བུར་བཅས་པའི་སྡུག་བསྔལ་ཐམས་ཅད་བདག་ལ་སྨིན་པར་གྱུར་ཅིག་སྙམ་དུ་བསམས་པས།",
    "དེ་དག་གི་སྡུག་བསྔལ་ཐམས་ཅད་སྐྲ་གྲིས་བཞར་བ་ལྟར་ནག་ཕུང་གིས་འདུས།",
    "བདེ་ཆེན་དུ་ཁྲིག་ཁྲིག་སོང་སྙམ་པ་དེ་ལྟ་བུའི་འདུན་པ་ཡང་ནས་ཡང་དུ་བྱ་ཞིང་།",
    "གསུམ་པ་དེ་དག་གི་སྤྱོད་པ་ལ་བསླབ་པ་ནི།",
    "མིག་གི་རྫི་མ་མི་འཁྲབ་པ།",
    "འདབ་མ་བཞིའི་དབུས་སྔོ་ཞིང་མཐའ་ཡལ་གྱིས་སོང་བ།",
    "ཁྱད་པར་མིག་ལ་རྣམ་རྟོག་གི་མདུན་གྱི་རྟེན་མེ་ཏོག་སྔོན་པོ་དེའི་སྟེང་དུ་ཅེ་རེ་བལྟས་ནས་འཇོག།",
    "འགུལ་ན་སེམས་གནས་དུས་མི་འོང་བས་ཀྲབ་ཀྲབ་དང་ཧྲིག་ཧྲིག་ཏུ་ཡེ་མ་སོང་བར་བྱ།",
    "སེམས་མེ་ཏོག་གི་སྟེང་དུ་གནས་བྱུང་བ་དང་ལྷོད་དེ་གཞག་གསུམ་པ་ཐ་མར་རང་སོ་གཟུང་བ་ནི།",
    "དེ་ལྟར་བྱས་པས་རྣམ་རྟོག་ཇེ་མང་ལ་སོང་ན་ཐོལ་སྐྱེས་རྦད་ཆོད་དུ་བྱ་སྟེ།",
    "རྣམ་རྟོག་གི་རང་ཞལ་བལྟ་བ་ཞེས་བྱ་བ་རྣམ་རྟོག་ཁོ་རང་གི་ངོ་བོ་ལ་ཆེད་དུ་བལྟས་པས།",
    "རྗེས་མེད་དུ་ཡལ་གྱིས་སོང་བ་དེ་ཀའི་ངང་དུ་གློད་པ་དེ་གཉིས་སེམས་ལ་གང་བདེར་བྱས་པས་ཆོག་གསུངས།",
    "འདིར་ཞི་གནས་དགའ་མོ་སྐྱེས་ན་ལམ་ཕྱི་མ་རྣམས་རིམ་བཞིན་སྐྱེ་སླ་བས་འབད་རྩོལ་གྱི་ས་ལ་བསྒོམ་མཛོད་གསུངས།",
    "སེམས་གནས་ཆ་དེའི་དཀྱིལ་ན་བདེན་པར་མེད་སྙམ་པའི་དྲན་པ་ཧྲིག་གེ་བ་ཞིག་དགོས་གསུངས་མོད།",
    "རང་གི་གཞུང་རྣམས་ལས་ཇི་ལྟར་མྱུར་ཡང་བསྐལ་པ་གྲངས་མེད་པ་གསུམ་འགོར་བར་གསུངས་ལས།",
    "གྲངས་མེད་རེ་རེའི་བར་ལ་སྡུག་བསྔལ་འདི་མྱོང་དང་འདི་མ་མྱོང་ཚད་གཟུང་མི་འདུག་པས།",
    "གསུང་གི་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པ་ནི།",
    "ཚེར་མའི་རྩེ་མོ་རྣོ་བ་ཡན་ཆད་ཀྱི་སྣོད་བཅུད་ཕྲ་རགས་ཐམས་ཅད་ཀྱི་རྒྱུ་རྐྱེན་ཇི་ལྟ་བ་མ་འདྲེས་པར་ལག་མཐིལ་དུ་སྐྱུ་རུ་ར་བཞག་པ་ལྟར་མཁྱེན་པ་ཡིན་ལ།",
    "ནས་བཟུང་ནས་བུམ་ནང་གི་ལྷའི་སྐུ་ལས་བདུད་རྩི་བབས་པར་བསམས་ལ་བཟླས་པ་ཅི་འགྲུབ་དང་།",
    "བཟླས་པ་བྷཱ་ཡ་ནའི་དམོད་པ་འདོར་བ་ཡན།",
    "གཏང་རག་གི་ཚུལ་དུ་གཏོར་སྒྲུབ་གང་ཟབ་གནང་གིན་འདུག་ལགས།",
    "གང་གི་སྲིན་ལག་རྩ་བ་ལ།",
    "རིན་ཆེན་འབྱུང་གི་རིན་ཆེན་ཉིད།",
    "འཁོར་ལོའི་རི་མོ་ཅན་རྣམ་སྣང་།",
    "སེར་བ་དང་ནོར་བུའི་རི་མོ་ཅན་རིན་འབྱུང་།",
    "སྣ་ཚོགས་རྡོ་རྗེའི་རི་མོ་ཅན་ནི་དོན་ཡོད་གྲུབ་པའི་རིགས།",
    "སྤང་བྱ་ནི་ཉོན་མོངས་པ་ལྔ་སྟེ།",
    "ཐབས་མཁས་པས་ཟིན་མ་ཟིན་གྱི་ཁྱད་པར་མ་གཏོགས་ཁོ་རང་གི་ངོ་བོ་ལ་བཅིང་གྲོལ་ཅིའང་མེད་ལ།",
    "སྤང་བྱ་བུད་ཤིང་ཇི་ཙམ་སྟོབས་ཆེ་བ་བཞིན།",
    "རྣམ་སྣང་གི་རིགས་ཅན་དེས་དཔལ་ཀྱེ་རྡོ་རྗེ་ལམ་དུ་བྱས་པའི་ཚེ།",
    "ཆུ་ལུད་དང་འཕྲད་ན་མྱུ་གུ་སྐྱེ་རུང་གི་ནུས་པ་ཡོད་པ་ལྟར།",
    "བྱམས་གླིང་པས་དགག་པ་བྱས་པའི་རྩོད་ལན་པཎ་ཆེན་ཤཱཀ་མཆོག་གིས་མཛད་པ་དེ་ཤིན་ཏུ་ལེགས་པ་ཡིན་གསུངས་སོ།",
    "ཅིར་སྣང་བདེ་ཆེན་དུ་ཤར་བ་དེ་ལ་གང་ཟག་གི་བདག་ལྟ་བུར་ལོག་པར་རྟོག་པ་དགག་པའི་ཕྱིར་དང་།",
    "བདག་གི་རྒྱུད་ལ་མཐུན་རྐྱེན་ཚོགས་གཉིས་རྫོགས་པ།",
    "གང་གི་མཆོད་རྫས་མ་སོགས་རྟགས་མ་བྱུང་བར་དུ་འབད།",
    "ཟླ་གདན་སྟེང་གི་ཧཱུཾ་ཡིག་ལས་བདུད་རྩི་ཤེལ་དཀར་གྱི་ཞུན་མ་ལྟར་བབས།",
    "ཤུལ་རྣམས་བདུད་རྩིས་སྐྱ་མེར་གྱིས་གང་བའི་དམིགས་པ་གསལ་སེང་ངེ་བ་དང་བསྟུན་ཏེ་སྔགས་ཚར་རེ་བཟླ།",
    "གདོན་ཕོ་མོ་སོགས་རིགས་བརྟགས་ལ་བདུད་རྩི་བསིལ་བ་དང་ཚ་བ་སོགས་དམིགས་པ་བསྒྱུར་ཞིང་བཟླ།",
    "གཏན་ཚིག་གང་གིས་ཀྱང་བསྟན་པར་མི་ནུས་ཏེ།",
    "རང་གིས་རང་ལ་མཚོན་དེ་ཤེས་པར་བྱོས།",
    "གཟུགས་སོགས་ཕྱིའི་སྐྱེ་མཆེད་ནི་ལྷ་མོ་དྲུག་ཚིགས་ཆེན་བརྒྱད་ལ་སོགས་པ་ནི་ཁྲོ་བོ་བཅུ་ཡིན་ལ།",
    "གང་གི་དྲིན་གྱིས་བདེ་ཆེན་ཉིད།",
    "དཔེ་འཇིག་རྟེན་ན་ཡིད་བཞིན་གྱི་ནོར་བུ་ཁྱད་པར་འཕགས་པ་ཡིན་མོད།",
    "དེས་ཚེ་འདིའི་བདེ་སྐྱེད་ཙམ་ལས་ཕྱི་མ་ཉན་རང་གི་རྣམ་གྲོལ་ཙམ་ཡང་འབྱིན་མི་ནུས་ན།",
    "ནང་གི་དབྱེ་བ་འདི་ཉིད་ནི།",
    "རང་ཉིད་གང་དུ་གནས་པའི་ས་ཕྱོགས་དེ་ཉིད་དག་གསལ་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་ལས་གྲུབ་པའི་གཞལ་ཡས་ཁང་གྲུ་བཞི་སྒོ་བཞི་རྒྱན་རྟ་བབས་དང་བཅས་པ་ཚད་དང་མཚན་ཉིད་ཡོངས་སུ་རྫོགས་པ་ཤིན་ཏུ་མཐོ་ཞིང་ཡངས་པ་སྟོང་གསུམ་གྱི་ཁྱོན་དང་མཉམ་པ།",
    "ནོར་བུའི་ཏོག་ཚངས་པའི་འཇིག་རྟེན་ན་ཡེར་རེ་བའི་རྣམ་པ་ཅན།",
    "གང་གི་དྲིན་གྱིས་བདེ་ཆེན་ཉིད།",
    "བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཞེས་པ་བརྒྱ་ཙམ་རེ་དང་།",
