    "དགྲ་འདྲེ་དང་གཅན་གཟན་ལ་སོགས་པས་རྨུགས་ཏེ་འཇིགས་སྐྲག་གི་སྣང་བ་ཤར་བ་ལྟ་བུ་གང་རྨིས་པ་ཞིག་གསལ་གདབ།",
    "ཆགས་སྡང་གི་སྣང་བ་དེ་དང་དེ་དག་ཤར་མོད།",
    "གཉིད་སད་པའི་ཚེ་ཆགས་སྡང་སྐྱེ་བའི་ཡུལ་དེ་དག་གིས་ས་ཕྱོགས་དེར་འོངས་བ་ལྟ་ཅི་སྨོས།",
    "ཆགས་སྡང་གི་རྟོག་པ་སྣ་ཚོགས་སྐྱེ་འདུག་པ་འདི་དང་རྨི་ལམ་ལ་ཁྱད་པར་སྤུ་ཙམ་མེད་དེ།",
    "བདེ་སྡུག་གི་ཚོར་བ་མྱོང་བ་མཉམ་འདུག་སྙམ་དུ་བསམ།",
    "མཉམ་གཞག་གི་རྩིས་ཟིན་པའི་སྤྱོད་ལམ་ཐམས་ཅད་དེ་དང་མ་བྲལ་བར་ཉམས་སུ་བླང་བ་དང་གསུམ་ལས།",
    "འདི་དག་གིས་མྱུར་དུ་སེམས་ཀྱི་གནས་ལུགས་རྟོགས་པར་གྱུར་ཅིག་སྙམ་པ་དུང་དུང་བསྒོམ།",
    "གསུམ་པ་མཉམ་གཞག་གི་རྩིས་ཟིན་པའི་སྤྱོད་ལམ་ཐམས་ཅད་དེ་དང་མ་བྲལ་བར་ཉམས་སུ་བླང་བ་ནི།",
    "ང་རང་གི་སེམས་གསལ་སྟོང་ཟུང་འཇུག་ཡིན་སྙམ་དུ་བརྗོད་བྲལ་དུ་འཇོག་དེས་མཚོན་པའི་གཉེན་ལ་ཆགས་སེམས།",
    "རང་གི་སེམས་སུ་ཐག་གཅད་ཅིང་དེ་གའི་ངང་དུ་ཆམ་ཆམ་འཇོག་པར་བྱེད།",
    "ཆགས་སྡང་སྣ་ཚོགས་སྐྱེས་མོད།",
    "རང་གི་སེམས་ཉིད་དེར་ཤར་བ་ཡིན་གྱི།",
    "གཉིས་པ་ཡན་ལག་གི་དཔེ་བཞི་ནི།",
    "རབ་རིབ་ཅེས་པ་མིག་མི་གསལ་བའི་རིགས་ཁ་ཅིག་གིས་བལྟས་པ་ན།",
    "ཤིང་བུ་ཕྲ་མོའི་རྩེ་ལ་མེ་སྦར་བ་དེ་སྐྱེས་བུའི་རྩོལ་བས་མྱུར་དུ་བསྐོར་བ་ན།",
    "དེའི་ཚེ་མེ་ཕྲ་མོ་དེ་རང་སྒོར་མོ་ཞིག་ཏུ་གྱུར་ཏེ་མེད་པ་བཞིན་ནོ།",
    "དེ་ལྟར་ཤར་བའི་འཁྲུལ་སྣང་ཐམས་ཅད་དཔེ་བརྒྱད་པོ་དེ་ལ་བརྟེན་ནས་རང་གི་སེམས་སུ་བསྒྲུབ་པའི་ཕྱིར།",
    "དེ་ལྟར་སྣང་བ་ཐམས་ཅད་རང་གི་སེམས་ཡིན་ན།",
    "བུད་མེད་ལ་སོགས་པའི་སྣང་བ་སྣ་ཚོགས་སུ་ཤར་བ་ལ།",
    "ཆགས་སྡང་གི་རྟོག་པ་ཇི་སྙེད་སྐྱེས།",
    "ཡུན་ཡང་ཅུང་ཟད་ལས་མ་སོང་མོད།",
    "སྣང་བ་འདི་གར་སོང་ཆ་མེད་ལ་སོང་།",
    "ཆགས་སྡང་གི་སྣང་བ་ཇི་སྙེད་པ་རྒྱུ་རྐྱེན་ཚོགས་པའི་ཚེ་འཆར།",
    "དུ་ཟླ་བའི་གཟུགས་བརྙན་རེ་རེ་འཆར་ཞིང་།",
    "རྟ་གདོང་གི་མེ་བརྡབས་པ་དང་།",
    "གཉིས་པ་ཡན་ལག་གི་དཔེ་ནི།",
    "དེར་དབྱར་གྱི་དུས་མཚན་མོར་ཆར་བབས།",
    "གང་ལྟར་ཡང་མཚན་མོ་ཆར་བབས་པ་དང་།",
    "ཁ་དོག་ལྔ་ལྡན་མ་འདྲེས་པར་གསལ་བ་ཞིག་འཆར་མོད།",
    "དྲུང་དུ་ཕྱིན་པ་ན་ཡང་གར་སོང་མེད་པ་བཞིན།",
    "དེ་ལྟར་སྣང་བ་སྣ་ཚོགས་སུ་སྣང་ཡང་དེ་དག་གི་ངོ་བོ་གང་དུའང་མ་གྲུབ་པར་གཏན་ལ་དབབ་པའི་ཕྱིར།",
    "སྔ་མ་ལ་མ་བརྟེན་པར་ཕྱི་མ་མི་འབྱུང་མོད།",
    "དེའི་ནང་དུ་རང་གི་བྱད་བཞིན་ལམ་གྱིས་འཆར་ལ།",
    "ཐེལ་ཚེ་ལ་མ་བརྟེན་པར་འཇིམ་པར་རི་མོ་མི་དོད་ལ།",
    "ཐེལ་ཚེའི་རི་མོ་འཇིམ་པའི་སྟེང་དུ་འཕོས་པ་མེད་པའོ།",
    "གཉིས་པ་ཡན་ལག་གི་དཔེ་ནི།",
    "དེ་ཇི་ལྟ་བ་བྲག་གི་དཀྱིལ་དུ་ལྷང་གིས་འབྱུང་།",
    "དེ་ཉིད་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་དཔེ་བརྒྱད་ཀྱིས་གཏན་ལ་འབེབས་པར་བྱེད་པ་ལས།",
    "སོ་སོ་རང་རིག་ཡེ་ཤེས་ཀྱིས་སྤྱོད་ཡུལ་བའི་ཚུལ་དུ་ཁོ་རང་གིས་ཁོ་རང་ངོ་ཤེས་པའི་ཚུལ་གྱིས་ཉམས་སུ་མྱོང་ཡང་།",
    "ཐམས་ཅད་མཁྱེན་པ་ཚིག་གིས་དབུལ་བ་རྒྱལ་གྱུར་ཅིག་ཅེས་གསུངས་པ་ལྟར་གནས་ལུགས་ལ་བརྗོད་དུ་མེད་ཀྱང་།",
    "ལྐུགས་པའི་རྨི་ལམ་ཞེས་པ་ལྐུགས་པ་ལ་རྨི་ལམ་གསལ་པོ་བྱུང་བ་ཁོ་རང་གིས་ཉམས་སུ་མྱོང་ཡང་།",
    "མཆན་ཁུང་ལ་སོགས་པར་རང་ངམ་གཞན་གྱིས་རེག་པའི་རྐྱེན་གྱིས་གཡའ་བའི་རེག་བྱ་ཉམས་སུ་མྱོང་ཡང་།",
    "གཉིས་པ་ཐུན་མོང་མ་ཡིན་པའི་དཔེ་བཞི་ནི།",
    "དེའང་རྐྱེན་གཞན་ཕྱག་རྒྱ་ལ་མ་ལྟོས་པར་རང་གི་ལག་པས་གསང་བའི་རྩ་བསྒུལ་བ་ལས་སྐྱེས་པའི་བདེ་བ་ཉམས་སུ་མྱོང་ཡང་བརྗོད་མི་ཤེས་པ་ལྟ་བུའོ།",
    "མགྲིན་པའི་གཡས་གཡོན་རོ་རྐྱང་གི་རྩ་གནས་པ་སྟེ།",
    "འཁོར་གྱི་ལྷ་མོ་དབྱུང་བ་དང་།",
    "རྒྱུ་རྡོ་རྗེ་འཛིན་པ་ཞུ་བའི་སྐབས་ཀྱི་སྙོམས་འཇུག་གི་བདེ་བ་སྐྱེས་པ་དེ་ཉམས་སུ་མྱོང་ཞིང་བརྗོད་དུ་མི་ཤེས་པ་ལྟ་བུའོ།",
    "གཉིད་དུ་མ་སོང་བར་རྨི་ལམ་མི་འབྱུང་ལ།",
    "བརྗོད་བྲལ་དུ་བསྒྲུབ་པའི་དཔེ་རྦ་རླབས་རྣམས་རེ་རེའང་དོན་བཞི་བཞི་ཚང་བར་ཐག་གཅད་ཅིང་ཉམས་སུ་ལེན་པར་བྱེད།",
    "དེ་ལྟར་ན་ཐུན་མོང་མ་ཡིན་པའི་དཔེ་བཞི་ལ་བརྟེན་ནས་ཉམས་སུ་མྱོང་བ་ནི་གོ་ཡུལ་ཙམ་མ་ཡིན་པར་རང་གིས་ཉམས་སུ་མྱོང་བའི་ཕྱིར་མཚོན་བྱེད་དཔེའི་ཡེ་ཤེས་ཡིན་ལ།",
    "བརྗོད་བྲལ་དུ་བསྒྲུབ་པའི་ཐུན་མོང་གི་དཔེ་བཞིས་གཏན་ལ་ཕབ་པའི་ལྟ་བ་ཐམས་ཅད་ཀྱང་དོན་སྤྱིའམ།",
    "དེས་ན་ནམ་མཁའི་ཟླ་བ་དངོས་སུ་མཐོང་བས་དེ་དག་གི་སྒྲོ་འདོགས་ཐམས་ཅད་གྲོལ་བ་ལྟར་མཚོན་བྱེད་དཔེའི་ཡེ་ཤེས།",
    "རྟོགས་པའི་ཁྱད་པར་ཟླ་བའི་དཔེ་ཡིས་བསྟན་པའི་དོན་ཚེས་གཅིག་གི་ཟླ་བ་མཐོང་བ་དེ་ཟླ་བ་མཐོང་བ་ཡིན་མོད།",
    "རྒྱུ་དུས་ཀྱི་ལྟ་བ་ཁོ་རང་ཡང་བཟང་རྟོག་ངན་རྟོག་གིས་ཁྱད་པར་ཙམ་མ་གཏོགས་རྣམ་རྟོག་རང་གི་རང་བཞིན་ལས་མ་འདས་པས་དེའི་དུག་བསྐྱེད་རིམ་གྱིས་སེལ།",
    "དེ་རེ་རེའང་རེ་རེ་ནས་འཁོར་འདས་དབྱེར་མེད་དུ་གཏན་ལ་འབེབས་པ་ཡིན་ལ།",
    "རྟེན་ཕྱི་དོན་དུ་གྲུབ་པ་མེད་མོད།"
  ]
}