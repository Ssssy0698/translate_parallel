    "ལ་ལམ་བཅས་པར་འབོམ་བཞག་དགོས་འདུག་ཅིང་།",
    "བོད་དམག་རྣམས་བཙན་པའི་ཆེད་ཉུང་ཐར་མེ་ལི་༢ སར་ཕྱིར་འཐེན་བྱ་དགོས་འདུགསྐབས་ལམ་སེངས་བརྡའ་བཏང་ཐབས་ཀྱི་གྲ་སྒྲིགས་བྱ་རྒྱུ་ཤིན་ཏུ་གལ་ཆེ།",
    "ཁྱེད་རང་ནས་གཞུང་བསམ་བཟོལ་མེད་ཀྱིས་དབྱིན་ཟླ་༡ཏ་རིག་༡༧ཉིན་དམག་སྤྱི་ཁང་ནས་བྱེད་སྒོའི་སྐོར་བསམ་འཆར་ལེགས་སློབ་གནང་བ་ཐུགས་རྗེ་ཆེ་དོན་ལྟར་སེམས་བཅང་ཞུས་ཆོག་པ་ཞུ།",
    "མི་དམངས་དམག་དཔུང་མི་དམངས་ལ་དགའ་བས་མི་དམངས་ཨ་ཏྟཱར་ཀྱིས་ཀྱང་རང་ཤུགས་སུ་དམག་བཀུར་བྱེད།",
    "སྤྱི་ཁྱབ་དམག་སྤྱི་ཀྲུའུ་ཏེའི་ལུང་བསྟན་དངོས་གནས་ཐིག་པོ་འདུག་ཅེས་གསུངས།",
    "ཡིན་ནའང་གོ་ཐོས་ལ་ཁ་སྣ་ཚང་མར་ཁྲག་བཞུར་གྱི་འདུག་ཟེར་ཞེས་ངོས་ལེན་བྱས།",
    "དྭངས་གསལ་སྤྲིན་བྲལ་ནམ་ཟླ་ག་དུས་འོང་།",
    "བརྩོན་འགྲུས་རྣམ་རྒྱལ་གྱིས་ཤའུ་ལའི་དམག་འཐབ་ནང་རང་སྲོག་བློས་བཏང་ཡོད།",
    "དེའི་ནང་བོད་ལྗོངས་འདི་ཀྲུང་གོའི་མངའ་ཁོངས་ཡིན་པ་སོགས་ཀྱི་ནང་དོན་བྲིས་འདུག་ཅེས་གསུངས།",
    "འདི་ལྟར་བྱས་ན་འགྲིག་པ་འདུག་གམ།",
    "འོན་ཀྱང་ཁྱིམ་དུད་སོ་སོས་བླངས་པའི་ཁྲལ་ཞིང་དང་རང་ཁྱིམ་གྱི་རྨན་ཕྱུགས།",
    "ཞིང་བྲན་དབུལ་པོ་བཅས་སུ་ཕྱེ་འདུག་ཅེས་བརྗོད།",
    "ཡིན་ནའང་བློ་ཡུལ་ལས་འདས་པ་ཞིག་གྱིས་ལགས་སོ་ཟེར་ཁས་བླངས་འདུག་སྐྱེ་མེད་འཆི་མེད་ཀྱི་ནི་༡༩༥༦ལོའི་དགུན་ཁར་ཁ་བ་ཆེན་པོ་བབས་ནས་ཚུལ་དུ་བླངས་པའི་ཟོག་ཚང་མ་ཤི་བ་མ་ཟད།",
    "སྐུ་དྲག་རྣམས་ཀྱི་བུ་ལོན་གཏོང་ཡུལ་ནི་སྤྱིར་བཏང་རང་ཉིད་ཀྱི་མངའ་འོག་གཞིས་ཀའི་འབངས་རྣམས་ཡིན།",
    "ལོ་རབས་ལྔ་བཅུ་པའི་དུས་འགོ་ལ་སྐྱེད་ཆེའི་བུན་བདག་འགའ་རབ་བརྟན་གྱི་ཁྱིམ་དུ་འོངས་ནས་རྒྱུ་ནོར་འཕྲོག་པ་ཐེངས་༨ བྱུང་འདུག་ཁོ་ཚོས་ལུག་དང་།",
    "རྦབ་རྡོ་གྱེན་དུ་རིལ་བ་དཔེ་མི་སྲིད།",
    "བས་དེ་དག་དུས་ནམ་ཡང་བརྗོད་དཀའ་བར་གྱུར།",
    "ཁྲེན་བ་ཀ་ཏནརྙིང་པཙུང་ལེས་པར་བླངས། འདུག་ཁྱིམ་ནང་ད་དུང་སྒྲ་སྡུད་འཕྲུལ་འཁོར་དང་།",
    "ལག་ལ་རོ་ལེག་ཁེ་སི་དང་ཨོ་སྨི་ཁ་ལ་སོགས་པའི་འཛམ་གླིང་ཐོག་གྲགས་ཅན་གྱི་ཆུ་ཚོད་འཁོར་ཁོ་ཚོས་ཇ་བསྲུབ་མ་འཐུང་ཞིང་དཀར་ཡོལ་སྤུས་གཙང་ལོ་བཏགས་འདུག་དངུལ་གྱི་ཁ་གཅོད་ཅན་སྤྱོད་པ་དང་བཟའ་བཏུང་ལོངས་སུ་སྤྱོད་དུས་དངུལ་གྱི་ཡོ་ཆས་སྣ་ཚོགས་སྤྱོད་བཞིན་ཡོད།",
    "བཅིངས་འགྲོལ་དམག་དེ་ཚོས་རང་སྲོག་ཤོར་བར་མ་འཛེམས་པར་ཆུ་ལོག་དེའི་ནང་མི་གྲངས་ག་ཚད་སྐྱོབ་ཡོད་པ་རྩིས་གྲངས་མི་ཆོད་ཅེས་བྲིས་འདུགསྐབས་དེར་རྒྱལ་རྩེ་ཕྱོགས་ཀྱི་བོད་རིགས་རྣམས་ཀྱིས་ཆུ་ལོག་འདི་གལ་ཏེ་བཅིངས་འགྲོལ་མ་བཏང་གོང་དུ་བྱུང་བ་ཡིན་ན།",
    "དེ་འདྲ་ཡིན་ནའང་ཞྭ་སྒབ་པ་དང་སྐུ་ཞབས་ཧྲན་ཕུ་རག་གཉིས་ཀྱིས་ཡང་གནས་ཚུལ་དེའི་ཐད་ལ་བདེན་རྫུན་གོ་ལོག་པའི་རྫུན་གཏམ་མང་པོ་གླེང་འདུགཞྭ་སྒབ་པས་བོད་མི་དམངས་ཀྱིས་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་རྒྱ་ནག་ཏུ་ཕེབས་པར་ཧ་ཅང་ངོ་རྒོལ་བྱེད་ཅིང་།",
    "མའོ་ཀྲུའུ་ཞིས་ཡིད་མཐུན་གནང་ནས་ཡག་པོ་འདུག་ཧ་ཅང་ཡག་པོ་འདུག་ཅེས་གསུངས།",
    "བོད་ལྗོངས་མི་དམངས་ཀྱིས་ཁོང་ཁྲོ་ཆེན་པོས་ཀྲུང་གོའི་མི་ལ་རྒོལ་གཏམ་སྒྲོག་ཅིང་རྔམ་སྟོན་ཡང་བྱས་ཞེས་འཁོད་འདུག།",
    "ད་ལྟ་འདི་གར་ཕྱི་ནང་གང་ནས་བྱ་དཀའ་བྱེད་གཏད་ཆེན་པོ་འདུག་རུང་ཐབས་མཁས་ཀྱིས་ཡར་ཐོན་བསམ་བློ་ཡོང་བ་དང་།",
    "ཀྲུང་གོའི་དཔྱད་ཡིག་ལྟར་ན་མི་ཁྲི་ཚོ་༨༧དམར་གསོད་བཏང་ཞེས་བཀོད་འདུག་སྐབས་འདིར་ཞྭ་སྒབ་པས་བརྗོད་པ་ནི་ལྷ་སའི་གཡུལ་འགྱེད་ཡིན་པ་དང་།",
    "ང་རང་ནི་ཉམ་ཐག་མི་འཁྱར་གྱི་ས་ནས་གཏམ་རྒྱུད་འཚོལ་བསྡུ་མི་བྱེད་ལཐབས་མེད་བྱུང་།",
    "ཞྭ་སྒབ་པ་དང་སྐུ་ཞབས་ཧྥན་ཕུ་རག་གཉིས་ཀྱི་དཔེ་དེབ་ཏུ་ཀྲུང་གོ་བ་དང་བོད་མི་ཟེར་བ་གཉིས་འཐབ་རྩོད་བྱེད་པའི་ཕྱོགས་གཉིས་སུ་བྱས་ནས་བྲིས་འདུག་ཞྭ་སྒབ་པའི་བོད་ཀྱི་སྲིད་དོན་རྒྱལ་རབས་སུ་ལྷ་སའི་ཟིང་ཁ་ན་ཏ་ཐམ་ཀ་རུན་ཧྲུའི་དེང་རབས་ཀྱི་བོད་ལྗོངས་དབུ་བརྙེས་པ་ཞེས་པ་རྒྱུ་ཡིག་ཤོག་ངོས་༢ ༡༦པ་ནས་༢༡༧པའི་བར་གསལ།",
    "རྗེས་སུ་ཁོ་རང་འཕན་པོ་ནས་བྲོས་བྱོལ་ཡོང་བ་ཡིན་ཞེས་ངོ་ལོག་ཟིང་འཁྲུག་པའི་ནག་ཉེས་ཐེར་འདོན་བྱས།",
    "དགྲ་བོས་བསྟུད་མར་གྲི་ཐེངས་དགུ་བརྒྱབ་སྟབས་གཟི་བརྗིད་ལྡན་པའི་ངང་རང་སྲོག་བློས་བཏང་།",
    "ཁེ་ལས་ཚན་པ་བཅས་ལ་འཇབ་རྒོལ་དང་རང་འདོད་ལྟར་ལམ་བཀག་ནས་རླངས་འཁོར་འཕྲོག་བཅོམ་དང་།",
    "སོ་སོས་ལས་ཀ་ཡག་པོ་བྱས་ན་གང་ལའང་སེམས་ཁྲལ་བྱེད་དགོས་མི་འདུག་ཅེས་གླེང་།",
    "དགྲ་དང་རང་ཕྱོགས་བར་གྱི་དབྱེ་བ་གསལ་པོར་འབྱེད་པ།",
    "དེང་སང་ཞིང་པ་ཁྱིམ་དུད་གཅིག་ལ་འབྲུ་རིགས་རྒྱ་མ་ཁྲི་ཁ་ཤས་ལོན་གྱི་འདུག་ན།",
    "བོད་ལ་འགྱུར་བ་དངོས་གནས་ཆེན་པོ་བྱུང་འདུག་ཅེས་གསུངས་མྱོང་ཡོད།",
    "དངོས་གནས་ད་ཆ་སྔར་དང་བསྡུར་ས་མི་འདུགམི་ཡུལ་གསར་པ་བརྗེས་པ་ལྟར་དུ་སྣང་།",
    "ད་གནས་ཡིད་ཚིམ་བྱ་དགོས་པར་འདུག་ལ།",
    "ད་དུང་རང་བྱུང་ལས་འདས་པའི་སྟོབས་ཤུགས་སམ་དངོས་གཟུགས་ལྷ་དང་།",
    "༡་༥༧ལོར་དམག་ལ་ཞུགས་རྗེས་སློབ་སྦྱོང་ལ་བརྩོན་འགྲུས་དང་ཁོང་རང་ལས་ཀ་ཧུར་ཐག་བྱས་ཤིང་།",
    "ཐ་ན་བོན་པོའི་སྟོབས་ཤུགས་ཀྱང་རང་ཁོངས་སུ་བསྡུ་བསམ་གྱི་ཡོད་པ་དང་།",
    "ཁོས་ཡང་རང་ཚུགས་ཀྱི་ཆབ་སྲིད་དངོས་གཟུགས་ཤིག་ཡིན་པའི་ཐོག་ནས་བོད་རྒྱལ་ཁབ་ནི་སྔར་མུས་སུ་གནས་པ་དང་།",
    "ཧིན་རྡུ་བས་ཀྱང་རང་ཉིད་ཀྱི་དམག་དོན་སྟོབས་ཤུགས་ཉུང་འཕྲི་ཆེན་པོ་ཞིག་གཏོང་ཐུབ།",
    "མགོ་རྐུབ་གཉིས་བཅད་ནས་ཁོ་རང་ལ་ཕན་ཐོགས་པ་རྣམས་ལུང་འདྲེན་བྱས་པ་མ་གཏོགས་ཕན་མི་ཐོགས་པ་རྣམས་ལུང་འདྲེན་བྱེད་ཀྱི་མེད་ཅིང་།",
    "རྡོ་རྗེ་ཚེ་བརྟན་ལགས་སོགས་པའི་འགོ་ཁྲིད་བློ་མཐུན་རྣམས་ཀྱིས་ཀྱང་ཐུགས་འཁུར་དཔེ་མི་སྲིད་པ་གནང་ནས་ཁྲིད་སྟོན་གྱི་རང་བཞིན་ལྡན་པའི་དགོངས་འཆར་ཧ་ཅང་མང་པོ་བསྩལ་གནང་བྱུང་།",
    "ངན་སེམས་བསྐྱེད་པའི་གྲངས་བཞིན་ཏེ་ཞེས་འདིར་སྐྱེས་བུ་སྟོབས་ལྡན་གྱིས་སེ་གོལ་གཅིག་བརྡབ་པའི་ཡུན་དྲུག་ཅུ་རྩ་བཞིར་བགོས་པའི་ཡུན་གཅིག་དུས་མཐའི་སྐད་ཅིག་མ་སྟེ།",
    "པའི་འབྲས་བུ་བཟང་ལ་མང་བའི་ལྗིད་ཀྱིས་ཡལ་ག་རྣམས་དུད་པ་སྟེ་དམའ་བར་འདུག་པ་དང་།",
    "ང་རང་བདག་པོ་ཡིན་སྙམས་ནས།",
    "དེ་ནས་མནར་མེད་དུ་འགྲོ་དགོས་པར་འདུག་ཟེར།",
    "ད་ཅི་བཀང་ན་ད་མེད་པ་མི་སྲིད་ང་འཁྲུལ་འདུག་བརྟག་པར་བྱ་སྙམ་སྟེ་རྡོ་གཅིག་དེར་བཞག།",
    "འདི་འདྲ་མི་སྲིད་ང་འཁྲུལ་འདུག་འོན་ཀྱང་བརྟག་པར་སྙམ་སྟེ།",
    "ཡང་གངྒཱ་ལ་བཏུང་ངོ་སྙམ་པས་དེ་ཡང་སྐམ་ནས་འདུག།",
    "སྐོམ་གྱིས་གདུང་བཞིན་ཉལ་ནང་བར་བལྟས་ཚེ་ཆུ་ཟངས་ཆུས་བཀང་བའི་ནང་དུ་རྡོ་བཅུག་འདུག།",
    "འདུག་པའི་གནས་དང་ཉལ་བའི་མལ་འདོད་པ་ལ་གནས་དང་མལ་བཟང་པོ་དང་།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "འདུག་ཀྱང་རུང་།",
    "གཉིས་པ་འདི་ཡང་འཐད་ཕྱོགས་སུ་མཛད་པ་འདུག་ཀྱང་མཐོང་ལམ་གྱི་བདེན་པ་བདག་མེད་གཉིས་རྟོགས་ཚེ་ཀུན་རྫོབ་བྱང་སེམས་བཏང་བར་ཇི་ལྟར་འཐད་སྙམ་པ་སོགས་གང་ལའང་དཔྱད་གཞི་ཆེ་ཡང་དགོངས་པར་བསླང་བར་བྱོས་ཤིག།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "དུས་གང་ཚེ་བདག་དང་རང་ཕྱོགས་ལ་ཡོན་ཏན་བརྗོད་པས་བསྟོད་པ་ལྷུར་ལེན་པའམ།",
    "ཁྲི་དང་མལ་སྟན་སྣོད་སྤྱད་ལ་སོགས་པ་ལ་འདུག་པ་དང་ལེན་པ་ལ་སོགས་པའི་ཚེ་བབ་ཅོལ་དུ་སྟེ་མ་བརྟག་པར་སྒྲ་དང་བཅས་པར་མི་འདུག་ཅིང་མི་དོར་རོ།",
    "དུས་རྟག་ཏུ་རང་སྐྱོན་ལ་བསམ་ནས་གཅོམ་ཞེས་པ་བྱ་བ་གང་ལའང་འུར་ཆེན་པོ་གཞན་གྱིས་མཐོང་ཐོས་སུ་མི་འགྱུར་བའམ་མེད་པས་སྐྱུང་བ་ལ་དགའ་བར་བྱ་དགོས་ཏེ་དགོན་རི་ཁྲོད་སོགས་གང་དུ་འདུག་ཀྱང་སུས་ཀྱང་མཐོང་ཐོས་མེད་པ་ཞིག་དགོས་སོ།",
    "ཁྱིམ་ལ་སོགས་པར་གང་དུ་འདུག་པའི་ཚེ་རྐང་པ་གཉིས་བརྐྱང་ཏེ་མི་འདུག་ཅིང་ལག་པ་བཀྲུ་བའི་ཚེ་ལག་གཉིས་མཉམ་པར་མི་མཉེའོ་སྟེ་ཕན་ཚུན་རིམ་གྱིས་བཀྲུའོ།",
    "ལམ་སོགས་འཇིགས་པ་བརྟགས་སོགས་དང་འདུག་པའི་ཚེ།",
    "རི་ཁྲོད་སོགས་སུ་འདུག་ཚེ།",
    "གལ་ཏེ་དཀར་ཡོལ་བཅག་པ་ལྟ་བུ་ལ་སོགས་པ་བཅོས་སུ་མེད་ན་ནི་བཅོས་སུ་མེད་པས་དེ་ལ་མི་དགའ་བྱས་པས་ཅི་ཞིག་ཕན་ཏེ་མི་ཕན་པར་མ་ཟད་སླར་ཡང་རང་གཞན་འཁྲུགས་པའི་སྡུག་བསྔལ་གྱིས་གནོད་པར་འགྱུར་བས་སོ།",
    "དེ་ལ་གནོད་པ་གཞན་སུ་ལ་ཁྲོ་སྟེ་ཁྲོ་བར་མི་རིགས་ཤིང་རང་ལ་ཁྲོ་བར་རིགས་པ་ཉིད་དོ།",
    "བཙའ་བ་ལ་སོགས་པའི་ཚེ་མ་རྒན་དང་རང་གཉིས་ཀར་འཆི་བའམ་འཆི་བར་འགྱུར་བ་ལྟ་བུའི་སྡུག་བསྔལ་ཆེན་པོ་འབའ་ཞིག་བསྐྱེད་པར་ཟད་ཀྱི་དལ་འབྱོར་ཐོབ་པའི་དགོས་པ་ཅི་ཡང་མ་གྲུབ་བོ།",
    "གང་དུ་འདུག་ཀྱང་དགོས་མཛའ་མི་འཚོལ་ཞིང་།",
    "ཤི་བས་རོ་རྣམ་པར་འཐོར་བའི་རུས་པའི་གོང་བུ་འབའ་ཞིག་མཐོང་བར་གྱུར་ནས་ནི་དུར་ཁྲོད་དུ་ནི་ལྟ་ཞིང་འདུག་པར་མི་འདོད་པས་ཡིད་འབྱུང་ཞིང་མི་དགའ་བར་བྱེད་ན།",
    "འདི་ལྟར་ཤིན་ཏུ་ཆེ་བའི་ཡོན་ཏན་གང་བས་འདི་ཉིད་ཁོ་རང་ཡང་དམན་པར་འགྱུར་བ་ད་ཡོད་ཅིང་།",
    "དང་རང་མི་རིག་པ་ལ་སོགས་པའི་འདོད་པའི་ཁྱད་པར་མང་ཞིང་བདེན་གཉིས་ཀྱི་འཇོག་ཚུལ་ཡང་།",
    "དེ་ལ་མུན་པ་དེར་ལག་པས་ཉུག་ཅིང་སྤྲུལ་བཙལ་ཡང་སྦྲུལ་དང་ལག་པ་མ་ཕྲད་ཀྱང་ད་རུང་སྦྲུལ་འཛིན་མི་ལྡོག་པར་ཡིད་སྐྲག་ཏིང་ངེ་འདུག་པ་བཞིན་དུ་མགོ་བོ་བདག་ཡིན་ནམ།",
    "དཔེ་དག་ཀྱང་རང་ཉིད་མ་གྲུབ་པ་སྒྲུབ་བྱེད་དུ་བཀོད་པ་ཡིན་གྱི་དེས་མི་འགྲུབ་བོ།",
    "ཐ་ནའང་རང་ཉིད་ཉེར་འཚེ་ལས་ངེས་པར་བསྲུང་ཐུབ་པར་གསུངས།",
    "བེ་རོ་ཙ་ན་ནམ་མཁའི་མཐའ་དང་མཉམ།",
    "རྗེ་འབངས་ཉེར་ལྔའི་མཚན་དང་མཛད་པའི་གཙོ་པོ་ཁག་ལོ་ཆེན་བེ་རོ་ཙ་ན་དང་།",
    "བི་རོ་ཙ་ན་ནམ་མཁའི་མཐའ་དང་མཉམ།",
