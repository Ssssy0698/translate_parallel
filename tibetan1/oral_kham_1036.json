    "བར་སྐོར་གྱི་མི་ཚོགས་ཁྲོད་དུ་ཁོ་ནི་ག་དུས་ཡིན་རུང་མི་ཧྲེང་ཁེར་བུར་དལ་པོས་འགྲོ་མཁན་དེ་ཡིན།",
    "གྲོད་པ་རྒྱགས་པ་ཞིག་འདུག་ད་རྒད་པོ་ལོ་ན་མཐོ་ལ།",
    "སྦྱིན་བདག་གཟིམ་སར་ཕེབས་རྗེས་ཁང་ཆུང་ནང་རང་ཉིད་གཅིག་པུ་ཡིན་པས་གཡང་འཛོམས་ཀྱིས་ཁོ་ཚོ་མེད་པའི་སྐབས་དང་བསྟུན་ཏེ་སྒེའུ་ཁུང་དང་།",
    "གཉིད་ལ་ཤོར་འདུག་ཅེས་ཤོད་ཀྱིན་འཚབ་འཚུབ་ངང་མལ་ལས་ལངས།",
    "གཡང་འཛོམས་ཀྱིས་སྔོན་ལ་ཨ་ཅག་ལགས་ཁྱེད་རང་ཞལ་ལག་ཡག་པོ་མཆོད་གནང་།",
    "འོང་ཡོང་རང་བློ་ཁ་རྫོགས་པ་ཡོད།",
    "བསྟན་འཛིན་ལྷ་མཛེས་ཀྱིས་དོ་ནུབ་དགོང་ཟས་བཟའ་འདོད་མི་འདུག་ཟེར་གྱིས་ཞེས་བཤད།",
    "དེ་ཉིན་གཟའ་ཉི་མ་ཡིན་པས་སྦྱིན་བདག་མ་སྨད་གཉིས་ཕྱི་ལ་ཐོན་ཕྱིན་ཏེ་ཁང་པ་ཆེན་པོ་དེའི་ནང་སླར་ཡང་ཁྱི་སེང་ཕྲུག་དང་གཡང་འཛོམས་གཉིས་ལས་མ་ལྷག་དུས་དེ་ནི་ཚ་དྲོད་ཆེ་བའི་སོས་ཀའི་དུས་ཡིན།",
    "ཨ་ཅོར་རློན་པ་ཞིག་གྱོན་ཏེ་སྒོ་རའི་ནང་ཡུད་ཙམ་བསྡད་ཀྱང་རང་ཉིད་གཅིག་མེ་ཏོག་དད་རྨི་ལམ།",
    "ལོ་གསར་པའི་ནང་བྲེལ་བྲེལ་འཚུབ་འཚུབ་ངང་འགྲོ་དགོས་པའི་རྣམ་རྟོག་ལ་རྩིས་ཏེ་ངེས་པར་དུ་ཉི་ཤུ་བརྒྱད་གོང་རང་ཁྱིམ་དུ་འབྱོར་བ་བྱེད་ཀྱི་ཡོད།",
    "བསྟན་འཛིན་ཉིན་ཤས་གོང་ལྷ་སའི་རྒྱ་ལམ་སྟེང་རླངས་འཁོར་གྱིས་བརྫིས་ཏེ་ལྔ་ལམ་དུ་ཕྱིན་འདུག་ཟེར།",
    "ངས་གཡང་འཛོམས་ནང་ལས་ཁོ་ནར་མགོ་འཁོར་ཏེ་ཐ་ན་ཞོགས་ཇ་འཐུང་བའི་དུས་ཚོད་མེད་པར་བསམས་ཏེ་དེ་འདྲ་དཔེ་མི་སྲིད།",
    "ཁྱེད་རང་གཉིས་ལ་གཅིག་ལྟོས་དང་།",
    "དེ་ལས་རང་དགོང་ཟས་ཀྱང་བཟས་མེད་པས་བག་ལེབ་འདུག་ན་ཟས་ཏེ་ཉོལ་སྡོད།",
    "དེར་བརྟེན་ང་རང་འདི་ནས་འགྲོ་རྒྱུ་ཡིན།",
    "དེ་རྗེས་མགོ་བོ་གཡུག་ཙམ་དང་དཔུང་པ་རོང་ཙམ་བྱས་ཏེ་གང་འདྲ་འདུག་གམ།",
    "སྒྲོལ་དཀར་གྱིས་ཁོ་ལ་བཅོས་མའི་འཛུམ་ཞིག་བསྟན་ཏེ་དེ་རིང་ང་རང་སེམས་སྐྱིད་པས་ཡིན་ཞེས་བཤད།",
    "རྗེས་མ་དུས་ཚོད་བྱུང་ན་ངས་ཁྱེད་རང་ལ་དབུ་སྐོར་ཡག་པོ་ཞུས་ཆོག་ཅེས་བཤད།",
    "དེ་བྱེད་འདོད་ཀྱང་མི་འདུག་ངས་འཇོན་པ་ནི་ཤུགས་ལས་དང་།",
    "ཚོང་ཁང་འདུག་གང་ལྟར་ངས་དེ་རིང་ནས་བཟུང་ཚང་མར་༦ ཨ་ཅག་ཅེས་འབོད་ཀྱི་ཡིན་ཞེས་བཤད།་",
    "ཉིན་ཉི་ཤུ་རྩ་ལྔ་ལས་ཕྱིན་མི་འདུག་ཀྱང་གླ་ཆ་ཚང་མ་འཁྱེར་རྒྱུགས།",
    "ཁོ་ཚོ་ར་བཟི་ལུག་འགྱེལ་མ་བྱས་གོང་རང་ལ་ཐོབ་འོས་པའི་དངུལ་བསྡུ་ཐུབ་ཀྱི་ཡོད།",
    "ཁྱེད་ཀྱིས་མཆོད་ཆང་མང་པོ་མཆོད་ཐུབ་ཀྱི་མི་འདུག་ངས་ཁྱེད་ལ་ཆབས་ཅིག་བཀྱག་ཆོག་ཅེས་ཁོ་ལ་ཆུ་གྷི་ལ་སི་གང་བླུགས།",
    "ཡིན་ནའང་རང་ལ་འདི་ཡོད་དམ།",
    "ཁྲ་ཞིང་སྒོར་བའི་མིག་གཉིས་ལ་ཡང་ག་དུས་འཁོར་མིན་མ་ཤེས་པའི་མཆི་ཞག་ཅིག་འཁོར་ཡོད།",
    "དེང་སང་ངའི་གཟུགས་པོ་བདེ་པོ་རང་མི་འདུག་མདང་ནུབ་མཚན་གང་ཚ་བ་བརྒྱབ་སྟེ་གཉིད་མེད།",
    "ང་ནི་སེམས་ཁྲལ་གྱིས་ཤི་གྲབས་བྱེད་ཀྱི་འདུག་ཅེས་བཤད།",
    "རྣ་བར་ཁོ་ཚོའི་སྐད་ཆ་དག་གོ་བ་ལྟ་བུ་བྱེད་ཀྱི་འདུག་ཅེས་བཤད།",
    "འོན་ཏེ་ཁོ་ནི་སེམས་ཐང་ཐང་མེད་པ་འདྲ་པོ་འདུག་ཁོས་རང་ལ་ནུས་པ་མེད་པ་ཤེས་བཞིན་དུ་ང་མཚན་གང་ཕུར་མཉེད་བཏང་སྟེ་སྡུག་པོ་བཏང་བྱུང་།",
    "དེ་དང་བསྟུན་ཏེ་ཕ་ཡུལ་དྲན་པའི་སེམས་ཀྱང་རང་སར་ཤི།",
    "ལོག་སའི་ཁྱིམ་ཞིག་ཡོང་བ་འདུག་སྙམ་སྟེ་སྤྲོ་བ་ཆེན་པོས་དང་ལེན་བྱས།",
    "འུ་ཐུག་དུས་འཚོང་ཞོག་ཡོད་དུས་རྒྱན་ཆ་དང་།",
    "དུས་ནམ་ཞིག་མི་ཡུལ་འདི་ནས་བྲལ་དགོས་མིན་འཆ་མི་འཚལ་བས་མི་ཡུལ་འདིར་གསོན་པོར་སྡོད་རིང་རང་ལ་བདག་པ་དང་།",
    "ག་དུས་སླེབས་མིན་མི་ཤེས་པར་ནམ་དུས་ནི་སོས་ཀ་སླེབས་པ་མ་ཟད།",
    "དེ་ལས་སྤྲོད་ཕོད་པ་མི་འདུག་ཅེས་བཤད།",
    "རྣ་ཅོག་ཡང་ཟིན་ཏེ་གཉན་ཁ་འཇགས་པའི་ཐབས་ཤེས་མི་འདུག་གལ་ཏེ་ཚ་བ་མ་འཇགས་པར་མེ་ཏོག་དང་རྨི་ལམ།",
    "ད་ཉམས་ཆུང་འཁོས་ཞན་ང་གཅིག་པུས་གླགས་ཁ་བ་མི་འདུག་ཅེས་བཤད།",
    "སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྠ་ས་དྷ་ནི་སྭ་ཧཱ",
    "བེཌཱུརྻའི་ཡི་གེ་ཏཾ་གསུམ་འདུག་པ་གནང་ནས།",
    "མཉམ་བཞག་དུས་གཅིག་ཐོ་རངས་རྔ་བརྡུངས་ཚེ།",
    "སྐུ་མཚམས་ཤིན་ཏུ་དམ་པར་བཅད་ཀྱང་ལོ་ཙྪ་བ་དངོས་སུ་འདུག་པ་གསན་ནས།",
    "རྒྱ་གན་ཁོ་ཁས་ལེན་ཞིང་འདུག་གྱིས་ཤིག་གསུངས།",
    "འདི་འདྲའི་མཐའ་ནས་ཕར་ཡུལ་དུ་ལྡོག་དུས་ཕལ་ཆེར་མི་ཡོང་སྙམ་པ་ཡང་བྱུང་།",
    "གནས་པོས་བླ་ཚེ་བརྐུས་པ་ལ་སོགས་པའི་བར་ཆད་མང་པོ་འདུག་གོ།",
    "བྲུན་ཤོར་བའི་རྗེས་མང་པོ་འདུག་གོ།",
    "མཆོད་རྟེན་གཅིག་འདུག་པ་བྲང་ཁང་དུ་སྤྱན་དྲངས་ཏེ་ཕྱག་མཆོད་བྱས་ནས་བར་ཆད་མེད་པར་གསོལ་བ་བཏབ།",
    "འདིར་འོངས་པས་ཅི་ཡང་མི་འདུག་སྟེ།",
    "སྤྱན་འདྲེན་དུ་ཆས་པར་འདུག་གོ།",
    "ལོ་ཙྪ་བས་ཞག་བཅུ་གསུམ་ན་འབྱོན་པར་འདུག་པའི་ཚད་ཤེས་པར་བྱུང་སྟེ།",
    "དེ་ཀ་འདིར་འདུག་གོ།",
    "ཤ་ཁ་ར་ཕུལ་གང་བསྐུར་འདུགཕྱག་རིས་དེ་བསྒྱུར་བས།",
    "ཞེས་བྱ་བ་འདུག་གོ།",
    "འདི་ནི་བཙུན་ཆུང་ལྟ་བུ་གཅིག་འདུག་པས།",
    "འགྲོ་གསུང་བའི་ཐོ་ལ་མ་ཆུད་ན་ནི་རྒྱ་གར་བ་ཟ་འདོད་པ་མང་པོས་ཐུགས་ནུར་བ་ཚེགས་མི་འདུག་པས་བློ་མ་བདེ་བ་ལས།",
    "ཤིན་ཏུ་རིང་དུ་སྦྱངས་པའི་ལས་ཅན་དུ་འདུག་པས་མ་ཧཱ་ལོ་ཙྪ་བ་ཞེས་བརྗོད་ཅིག་གསུངས།",
    "བི་ཀྲ་མ་ཤཱི་ལའི་བྱི་དོར་བྱེད་མཁན་དང་དུས་མཚུངས་སུ་འདུག་གསུངས།",
    "ཡང་སྐྱེ་བ་གཉིས་སམ་གསུམ་ན་ཁྱེད་ལ་བརྟེན་པའི་ལས་དག་པར་བྱ་དགོས་ཤིང་འོང་སྟབས་གཉིས་དག་པར་བྱེད་པར་འདུག་གོ་གསུང་སྐད།",
    "རིང་བསྲེལ་གཅིག་ལ་ལྔར་འཕེལ་འདུག་གསུངས་ནས།",
    "ཕྱིའི་རྒྱ་མཚོ་ནས་ནོར་བུ་ལོངས་ན་རྫོངས་ཚར་རམ་གཞན་དུ་དཀའ་བར་འདུག་གསུང་།",
    "ལུང་ལས་སྤྱིར་བསྟན་ཞེས་ལེའུ་ཟུར་དུ་མ་བསྟན་ཀྱང་རང་བཟོའི་སྐྱོན་མེད་དེ།",
    "ཊཱིཀྐཱར་ཁང་པ་ཁང་ཆེན་བརྩིགས་པར་གཏོགས་པའི་ཁ་ན་མ་ཐོ་བ་ནི་དེ་རྩིག་དུས་སྲོག་ཆགས་གསོད་པའི་བླངས་འདས་སུ་འདོད་པ་ལ་འོ་ན།",
    "དགྲ་བཅོམ་པ་ཐོབ་ནས་སྔོན་གྱི་གྲལ་ཇི་ལྟ་བ་བཞིན་ལ་འདུག་པར་བྱའོ།",
    "ཤེས་ལྡན་བདག་ཅག་འབའ་ཤིག་ལ་འདུག་པ་དང་བྱ་བ་དང་གསོ་སྦྱོང་ཡོད་༣བ་དམ།",
    "དེང་ཕྱིན་ཆད་འདུག་པ་དང་།",
    "སྙམ་དུ་བསམ་སྟེ་འདུག་ལ་ཞེས་སོགས་གསུངས་པའི་ཕྱིར།",
    "བྱིན་གྱིས་བརླབས་པས་ཕྱིར་བཅོས་ཏེ་ལས་ཀྱི་གནས་སུ་འདུག་པར་བྱའོ།",
    "གསོ་སྦྱོང་འདུག་ནས་བྱེད་ཀྱང་ཆོམ་རྐུན་སོགས་ཀྱིས་འཇིགས་ན་ཐམས་ཅད་འགྲོ་བཞིན་དུ་ཆོག་པའི་ཕྱིར་ཏེ།",
    "འབའ་ཞིག་ན་འདུག་སྟེའོ།",
    "དེ་དག་དུས་ནམ་དགོས་སུ་བྱེད་པའི་ཕྱིར།",
    "དེ་ཡོལ་གང་ཞིག་དུས་རུང་ཟ་བྱེད་དེ།",
    "དགུན་ཟླ་ཐ་ཆུང་རང་བཞིན་ཡིན།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་བརྗོད།",
    "ལ་ལར་ཀློག་པ་དང་ཁ་ཏོན་དང་འདུག་པ་དང་བཅག་པ་དག་ལས་གང་ཡང་རུང་བ་བྱ།",
    "ལ་ལར་སྔ་དྲོ་དང་གུང་ཚིགས་དང་ཕྱི་དྲོ་འདུག་པས་དེ་ལ་སྦྱར་བར་བྱའོ།",
    "ལུང་ལས་མཚམས་བཅད་པའི་གནས་དེར་དགེ་སློང་རྣམས་ཀྱིས་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱའོ།",
    "མནོས་པ་དང་རང་བྱེད་པ་དང་དེའི་མཇུག་དག་ཏུ་གོ་རིམ་བཞིན་དུ་གདིང་བར་འགྱུར་རོ།",
    "ལ་ལས་དངོས་མཇུག་ནོར་འདུག་གོ།",
    "ཆོ་གས་དང་རང་འཇུག་ལ་རྣམས།",
    "རྡོ་རྗེ་གདན་དང་ཡུལ་འདི་བཞི་བར་དཔག་ཚད་བཅུ་ཡོད་པར་ལོ་ཆེན་མང་པོས་འདོད་ཀྱང་རང་ལུགས་བཅུ་དྲུག་ཡོད་པར་བྱ་སྟེ།",
    "ཁྱིམ་གཞན་དུ་གཞན་མེད་ན་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོ།",
    "མཐའ་འཁོབ་ཏུ་ཀོ་ལྤགས་ཀྱི་གདན་ལ་འདུག་ཉལ་སོགས་རུང་ལ་དམིགས་ཀྱིས་བསལ་ན།",
    "ཡུལ་དབུས་སུ་སྟན་གཞན་མེད་ན་འདུག་རུང་བ་དང་།",
    "ཤིང་ཀན་ཙ་ན་དང་ཀ་པི་ཏན་དང་སོགས་བྱུང་།",
    "གསུམ་པ་ནི་གདིང་བ་དང་བཅས་སྟན་ནམ་རྩ་བམ་སོགས་ལ་འདུག་པའི་ཕྱིར།",
    "དགེ་སློང་དག་བཏུང་བ་བརྒྱད་པོ་འདི་དག་དུས་སུ་བྱིན་ལེན་བྱས།",
    "དེ་ལ་བཏུང་བ་བརྒྱད་པོ་དེ་གང་རུང་ཅིག་དུས་སུ་བྱིན་ལེན་བྱས་ལ།",
    "བཏུང་བ་བརྒྱད་པོ་འདི་དག་དུས་སུ་བྱིན་ལེན་བྱས་ལ།",
    "བཏུང་བ་བརྒྱད་པོ་འདི་དག་དུས་སུ་བྱིན་ལེན་བྱས།",
    "བཏུང་བ་བརྒྱད་པོ་འདི་དག་དུས་མ་ཡིན་པར་བྱིན་ལེན་བྱས།",
    "མི་འདུག་པར་འགྲེང་བ་ནི་ཁ་སྐོང་བ་ཉིད་མ་ཡིན་ནོ།",
    "མི་འདུག་བར་འགྲེང་བ་ནས་འཁྲུལ་བཅས་པར་དང་ལྡན་པས་དེ་བྱ་མི་རུང་བའི་ཕྱིར།",
    "འདུག་པ་དང་།",
    "ཐམས་ཅད་ལ་འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར།",
    "འདུག་པ་ཉིད་ཀྱིས་སོ།",
    "མི་འདུག་པར་འགྲེང་བ་ནི་ཁ་བསྐོང་མ་ཡིན་ཏེ།",
    "ཟས་ཀྱི་གྲལ་ན་འདུག་པ་མ་གཏོགས་སོ།",
    "གཅི་བ་བྱེད་པ་དང་ཁྱིམ་གཞན་ན་འདུག་པའོ།",
    "གཙུག་ཕུད་བཞག་དུས།",
    "མདུན་དུ་ཙོག་པུར་འདུག་པ་ལ།",
    "སྟོན་པ་དང་རང་ལ་ཕྱག་གསུམ་གསུམ་འཚལ་དུ་བཅུག།",
    "ཁྱེད་རང་ལས་གྲིབ་མ་སོར་གཅིག་ཡན་ཆད་ཀྱི་རྒན་པའི་དགེ་ཚུལ་སོགས་བསྙེན་བཀུར་གྱི་གནས་དང་།",
    "བསྒྲུབ་བྱ་ཙོག་པུར་འདུག་པའི་རྒྱབ་ཏུ་འགྲེང་སྟེ་འདུད་པ་དང་བཅས་པས་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "དེ་ནས་བསྒྲུབ་བྱ་ཕ་གུ་དང་རྩྭའི་སྟེང་དུ་ཙོག་པུར་འདུག་ཏུ་བཅུག་པ་འདི་སྐད་ཅེས།",
    "ཁྱེད་རང་ལ་གྲིབ་མ་སོར་གཅིག་ཡན་ཆད་ཀྱི་རྒན་པའི་དགེ་སློང་རྣམས་བསྙེན་བཀུར་གྱི་གནས་ཡིན།",
    "ལུང་རྒྱུན་ཡང་ཡོད་འདུག་ཀྱང་།",
    "ལག་མཐིལ་སྤུ་ཉག་གཅིག་འདུག་པ།",
    "གསུམ་པོ་དེ་དང་རང་ཉིད་བསྟན་པས་སོ།",
    "སྔར་གྱི་ཉི་ཤུའི་སྟེང་དུ་རང་རང་བསྟན་པས་སོ།",
    "འདི་སྲ་བར་འདུག་སྙམ་དུ་ངེས་པ་ལྟ་བུའོ།",
    "འགོག་པ་གཉིས་ཀྱི་ཐོབ་པ་ཡོད་ཅིང་རང་རྒྱུད་ཀྱིས་བསྡུས་སོ།",
    "མ་ཐོབ་པ་ཡང་རང་རྒྱུད་དུ་གཏོགས་པ་དང་རྒྱུད་ཀྱིས་བསྡུས་པའི་ཡིན་གྱིགཞན་རྒྱུད་ཀྱི་ཐོབ་པ་དང་།",
    "༥༡སེམས་ཀྱི་རྗེས་འཇུག་དུས་དང་ནི།",
    "དེ་ཡང་རང་དང་ས་གཅིག་པའི་རྒྱུ་ཡིན་ཏིཏི་གྱི་རིགས་གཅིག་པ་མི་དགོས་སོ།",
    "ཕྱི་མས་ནི་ཕྱིས་ཙ་ན་འབྲས་བུ་སྐྱེད་པའི་ཕྱིར།",
