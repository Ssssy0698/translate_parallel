    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྤྱན་སྔར་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་གནས་ཏེ་བཀའ་ནོད་ཅིང་འདུག་གོ།",
    "གདོན་ཆེན་པོ་ཕྱུང་ནས་བཀའ་ནོད་ཅིང་འདུག་པར་བསམ་པར་བྱའོ།",
    "ཕྱག་བཞི་བྱས་ནས་ཕྱག་རྒྱ་ཆེན་པོ་ཇི་ལྟ་བ་བཞིན་དུ་བཅིངས་ནས་རྡོ་རྗེ་བདག་ཉིད་ཅན་དང་རང་བཞིན་གྱིས་དག་པ་དང་།",
    "དེ་ནས་དེས་གཡོན་བརྐྱང་བའི་གནས་པ་ཉིད་ཀྱིས་འདུག་ལ།",
    "ཟླུམ་པོའི་འདུག་སྟངས་བཅས་ནས་དེ་བཞིན་དུ་བགེགས་རྣམས་བསྐྲད་པར་བྱའོ།",
    "ཟླུམ་པོའི་འདུག་སྟངས་དང་།",
    "ས་གའི་འདུག་སྟངས་རྣམས་ཀྱིས་བགེགས་རྣམས་ངེས་པར་བསྐྲད་། པར་བྱས་ནས།",
    "དེ་ནས་རྡོ་རྗེའི་འདུག་སྟངས་ཕྱེད་ཀྱིས་འདུག་ལ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ལ་ཡིད་ཀྱིས་དཀྱིལ་འཁོར་ཐམས་ཅད་ཡོངས་སུ་བརྟག་པར་བྱས་ནས་ནམ་མཁའི་ཕྱོགས་ནས་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་དགུག་པ་དང་།",
    "དེ་ནས་དབུས་སུ་འདུག་ནས་ནི།",
    "རྐང་པ་གཡས་པ་བརྐྱང་བའི་ཚུལ་གྱིས་འདུག་ནས།",
    "ཆུ་ལྷའི་ཕྱོགས་སུ་རྐང་པ་མཉམ་པས་འདུག་ལ།",
    "གཡོན་པ་བརྐྱང་བའི་གནས་པས་འདུག་ལ།",
    "རྐང་པ་མཉམ་པར་གནས་པས་འདུག་ལ།",
    "མདུན་དུ་འདུག་ནས་ཚིག་འདི་སྐད་དུ་གསལ་བར་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ནས་ཧཱུཾ་བཞིས་ཕུར་བུ་བཏོན་ལ་ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏི་ཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སཱ་ཧཱ་ཞེས་བྱ་བ་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པའི་འོ་མས་ཕུར་བུ་དང་།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་སའི་དབུས་སུ་འདུག་ལ།",
    "ཡང་ཤར་ལྷོ་མཚམས་ཀྱི་ཆལ་འདུག་ནས།",
    "ཡང་ལྷོ་ནུབ་མཚམས་སུ་འདུག་ལ་བྱང་ཤར་མཚམས་སུ་སྲད་བུ་བརྐྱང་སྟེ་ཐིག་གདབ་པར་ཤེས་པར་བྱའོ།",
    "ལྷོ་ཕྱོགས་ཀྱི་ཆར་འདུག་ལ་བྱང་དུ་བལྟས་ཏེ་ཐིག་གདབ་པར་བྱའོ།",
    "བྱང་ཕྱོགས་ཀྱི་ཆའི་ཀ་བའི་ཐིག་ནི་ནུབ་ཕྱོགས་སུ་འདུག་ལ་ཤར་། གྱི་ཕྱོགས་སུ་བལྟས་ཏེ་གདབ་པར་བྱ་སྟེ།",
    "ལྷོ་ཕྱོགས་ཀྱི་ཆའི་ཀ་བའི་ཐིག་ནི་ཤར་ཕྱོགས་ཀྱི་ཆར་འདུག་ལ་ནུབ་ཏུ་བལྟས་ཏེ་གདབ་བོ།",
    "དེ་ནས་ཡང་མདུན་དུ་འདུག་ལ་དེ་ཁོ་ན་ཉིད་འདི་ལན་ཅིག་བརྗོད་པར་བྱ་སྟེ།",
    "ཕྱི་རོལ་གྱི་དཀྱིལ་འཁོར་གྱི་ནང་དུ་སྣ་ཚོགས་པདྨའི་སྟེང་དུ་ཕྱག་རྒྱ་ཆེན་པོས་འདུག་ལ།",
    "གདན་དེ་ལ་དཔལ་རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱ་ཆེན་པོར་འདུག་ནས།",
    "ཨོཾ་རུ་རུ་ཨཕུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སཱ་ཧཱ།",
    "ཨོཾ་བྷ་ག་ཝ་ཏི་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦ་ཨར་ཐ་སཱ་དྷ་ནེ་སཱ་ཧཱ་ཞེས་པའོ།",
    "ཨོཾ་བྷ་ག་ཝ་ཏི་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་། ཏིཥྛ་སིངྦྷ་ལོ་ཙ་ནི་སརྦ་ཨ་རྠ་སཱ་དྷ་ནེ་སཱ་ཧཱ།",
    "དང་པོ་ཁོ་ནར་ཡིད་དུ་འོང་བའི་གནས་སྒྲའི་ཚེར་མ་ལ་སོགས་པ་དང་བྲལ་བར་སྟན་ཤིན་ཏུ་འཇམ་པོ་ལ་འདུག་སྟེ།",
    "བཀྲ་ཤིས་ཀྱི་འདུག་སྟངས་དང་།",
    "སེང་གེའི་གདན་གྱི་སྟེང་དུ་འདུག་པར་བྱའོ།",
    "དེ་ནས་འདུག་ལ་གསོལ་བ་གདབ་པར་བྱ་སྟེ།",
    "དེར་ཞུགས་ནས་འདུག་སྟེ་གནས་ཇི་ལྟ་བ་བཞིན་དུ་མདུན་དུ་གཞལ་ཡས་ཁང་ཆེན་པོ་བསམས་ཏེ།",
    "འགྲེང་ངམ་ཡང་ན་འདུག་ཀྱང་རུང་།",
    "མི་སྨྲ་བས་འཇམ་ཞིང་ཤིན་ཏུ་བདེ་བའི་སྟན་ལ་པདྨའི་འདུག་སྟངས་ཀྱིས་འདུག་པ།",
    "འདུག་པའམ།",
    "བསམ་གཏན་བཞིའི་རིམ་བཞིན་དམིགས་ནས་འོག་མིན་གྱི་གནས་སུ་འདུག་སྟེ་མི་གཡོ་བའི་ཏིང་ངེ་འཛིན་ལ་དམིགས་ཏེ།",
    "བསྐྱེད་པའི་རིམ་པས་འདུག་ནས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་གནས་སུ་རྡོ་རྗེ་སེམས་དཔའ་བསྒོམས་ལ།",
    "དེ་ནས་དེ་ལ་རྡོ་རྗེ་ཕྱེད་མའི་འདུག་སྟངས་ཀྱིས་འདུག་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་དམ་ཚིག་སེམས་དཔར་བསྐྱེད་ཀྱང་རུང་སྟེ་འདིར་རྣམ་པར་སྣང་མཛད་ཀྱི་གནས་སུ་འདུག་ལ་རྣམ་པར་སྣང་མཛད་དུ་གྱུར་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ནས་སློབ་དཔོན་ཁྲུས་བྱས་ནས་མཉམ་པར་འདུག་སྟེ།",
    "ཨོཾ་ག་ག་ནེ་ག་ན་ལོ་ཙ་ནེ་ཧཱུཾ།",
    "ཨོཾ་གེ་ག་ནེ་གེ་ག་ན་ལོ་ཙ་ནེ་ཧཱུཾ།",
    "དེ་ནས་ཐུགས་ཀར་བྱོན་ནས་མི་བསྐྱོད་པའི་མདུན་དུ་འདུག་ནས་བཀའི་ལམ་ཞུ་བར་། བསམ་པར་བྱའོ།",
    "གདོད་ནས་དག་ཅིང་རང་བྱུང་ང་།",
    "དེའི་རྗེས་ལ་ཡོལ་བའི་ནང་དུ་འདུག་ནས་འཁོར་ལོས་སྒྱུར་པའི་ཚུལ་དུ་བཟུང་ལ།",
    "འགྲོ་བ་འདི་ཡང་རང་བཞིན་མེད།",
    "རུ་དྲ་མ་ན་ཡ་བི་ཥྞུ་མཱ་ན་ཡ་ཙ་ནྡྲ་སཱུ་རྱ་མ་ན་ཏྲེ་ལོ་ཀྱཱ་དཧི་པ་ཏི་མ་ན་ཡ།",
    "དེ་ནས་ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦཱ་རྠ་སཱ་དྷ་ནི་སཱ་ཧཱ།",
    "དུས་གཏན་གྱི་འདུན་མའི་བཟོ་ཐེས་འཆོར་བར་འདུག་པས།",
    "བསགས་སྦྱངས་ཀུན་གྱི་མཐར་ཐུག་གོ། ། གཉིས་པ་སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ་ནི།",
    "འདུག་ས་འདི་ཉིད་དུ་ཐོབ་པར་མཛད་དུ་གསོལ།",
