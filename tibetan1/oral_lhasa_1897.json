    "སླར་ལྡོག་༩པར་བྱེད་པའི་རྒྱུ་གང་ལགས་རྐྱེན་གང་ལགས།",
    "ཀྱེ་ཀླུའི་བདག་པོ་དག་སྲོག་ཆགས་བརྒྱ་༧སྟོང་ཕྲག་མང་པོ་སྲོག་༡༡འགགས་པས་འགག་པར་འགྱུར་བའོ།་།",
    "དེ་ནས་ཀླུའི་རྒྱལ་པོ་རྒྱ་མཚོས་སྐད་ཅིག་ཐང་ཅིག་༡༢ཡུད་ཙམ་དེ་ལ་རྫིང་བུ་ཆར་གྱི་རྒྱུན་གྱི་ཆུས་བཀང་ནས་བདེ་བས་ཚིམ་པར་བྱས་སོ།",
    "དེ་ནས་ཕྱོགས་དེར་གོ་སྐབས་ཆེན་པོ་བྱུང་བར་གྱུར་ནས་ས་ཕྱོགས་དེར་བཅོམ་ལྡན་འདས་འཁོར་ཆེན་པོས་ཀུན་ནས་བསྐོར་ཏེ་མདུན་དུ་བདར་བའི་དབུས་ན་བཞུགས་སོ།",
    "དུས་མ་ལགས་པའི་ཆར་དང་།",
    "ཚ་བ་མ་མཆིས་པར་བགྱིད་པ་དང་།",
    "ཀླུ་ཐམས་ཅད་ཀྱི་མགོ་ཚལ་པ་བདུན་དུ་འགས་པར་འགྱུར་རོ།",
    "རྒྱལ་པོ་ཆེན་པོ་དག་ཀླུ་གནོད་པར་སེམས་པ་དང་།",
    "བཅོམ་ལྡན་འདས་དེང་༢སླན་ཆད་མཐུན་དདཔར་བགྱིད་དོ།",
    "ལོ་ཏོག་ཐམས་ཅད་ཡོངས་སུ་རྒྱས་པར་བགྱིད་དོ།",
    "འབྲས་བུ་ཐམས་ཅད་འགྲུབ་པར་བགྱིད་དོ།",
    "བདེན་པའི་དམ་ཚིག་ལ་གནས་པར་བགྱིད་དོ།",
    "བཅོམ་ལྡན་འདས་རིག་པའི་རྒྱལ་པོ་༨འདི་དྲན་པ་ཙམ་གྱིས་ཀྱང་བདག་ཅག་ཐམས་ཅད་ཀྱི་༩ཆར་གྱི་རྒྱུན་འབབ་༧པར་བགྱིད་དོ།",
    "དྲན་པ་ཙམ་གྱིས་ཀྱང་ཧ་ཅང་ཆར་ཆེ་བ་བཟློག་༡་པར་བགྱིད་དོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ་ལས་ལོག་པར་མི་བགྱིད་དོ།",
    "བཅོམ་ལྡན་འདས་དེའི་ཚེ་རིག་པ་འཛིན་པས་མནས་བསྒག་༦༧པའི་གཟུངས་ཀྱི་སྔགས་ཀྱི་ཚིག་འདི་ཐོག་༧མ་ཉིད་དུ་ལན་བདུན་དུ་བརྗོད་པར་བགྱིའོ།",
    "བཅོམ་ལྡན་འདས་དེའི་ཚེ་བདག་ཅག་ཐམས་ཅད་ཀྱི་ཁང་ཁྱིམ་མཐའ་དག་ཞུགས་འབར་བར་གྱུར་༡༢བདག་ཤི་ཀེང་རུས་ཀྱི་ལྷག་མ་ཙམ་ཞིག་ལུས་ནས་ཡོངས་སུ་ཐར་བར་མ་གྱུར་གྱི་བར་དུ་དུམ་བུ་དུམ་བུར་འཆད་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་བདག་ཅག་ཐམས་ཅད་ཀྱི་མི་མྱུར་བར་ཆར་གྱི་རྒྱུན་འབེབས་༡་པར་བགྱིད་དོ།",
    "བུ་དང་ཚ་བོར་བཅས་ཏེ་འགུམ་པར་མཆིའོལ།",
    "རྒྱལ་པོ་ཆེན་པོ་དག་ཕྱི་མའི་ཚེ་ཕྱི་མའི་དུས་ན་ཀླུ་མི་བགྲུངས་པ་མ་རུངས་པ་༡༨གཏུམ་པ་གནོད་པར་བྱེད་པ་དག་འབྱུང་སྟེ།",
    "དེའི་ཚེ་མནའ་འདིས་འཇིགས་པར་འགྱུར་སྐྲག་པར་འགྱུར་དུས་དུས་སུ་ཆར་གྱི་རྒྱུན་ནི་ལེགས་པར་འབེབས་སོ།",
    "བ་སེར་སྐྱའི་ལྕི་བ་དང་འཇིམ་པར་བསྲེས་པའི་༡་ཀླུའི་རྒྱལ་པོ་མགོ་དགུ་གདེངས་ཀ་ཅན་ལུས་དབྱིབས་དགུ་བར་བྱས་ཏེ་ཐམས་ཅད་ཀྱི་མགོ་ལ་ཡང་ཡིད་བཞིན་༡་ནོར་བུ་བྱའོ།",
    "མགོ་གཉིས་པ་མགོ་ལྔ་པར་བྱའོ།",
    "ལུས་དག་ལ་སྤོས་སྣ་ཚོགས་ཀྱིས་བྱུག་པར་བྱའོ།",
    "གུར་གུམ་རྣམས་ཕྱེ་མར་བྱས་ཏེ་གཏོར་བར་བྱའོ།",
    "དར་དང་བ་དན་གྱིས་བརྒྱན་པར་བྱའོ།",
    "པོག་དཀར་པོ་རྣམས་དང་སྦྲང་༤རྩི་དང་བསྲེས་ཏེ་སྔགས་ལན་ཉི་ཤུ་རྩ་གཅིག་བཟླས་ཏེ་ཀླུ་རྣམས་ལ་བདུག་པར་བྱའོ།",
    "གལ་ཏེ་དེ་མ་ཐག་མ་ཕབ་ན་ཀླུ་དེ་དག་ཐམས་ཅད་ལུས་ཞིག་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་མ་ཐག་ཏུ་མ་༥ཕབ་ན་ཀླུ་ཐམས་ཅད་ཀྱི་ལུས་ལ་ཤ་བཀྲ་འབྱུང་ཞིང་མཛེས་བཏབ་པར་འགྱུར་ལོང་བར་འགྱུར་རོ།",
    "གལ་ཏེ་འཕྲལ་དུ་མ་ཕབ་ན་དེའི་ཕྱིར་མཀླུའི་ཁྱིམ་ཆུ་ཐམས་ཅད་བསྐམས་པར་ཚའགྱུར་རོ།",
    "སྔགས་འདི་བྲིས་ཏེ་དེར་གདགས་པ་༡༨བྱས་ན་ཇི་སྲིད་དུ་རྒྱལ་མཚན་མ་བསྡུས་པ་དེ་སྲིད་དུ་སྣ་ཀླུ་ཐམས་ཅད་ཆར་འབེབས་སོ།",
    "བག་ཕྱེ་ལས་ཀླུ་མགོ་དགུ་པའི་གཟུགས་བྱས་ལ་ལུས་མཚལ་གྱིས་ན་བསྐུ་བར་བྱའོ།",
    "དཀྱིལ་འཁོར་གྲྭ་སྒྱུ་༡བཞི་བྱས་ཏེ་དབུས་སུ་ཀླུའི་གཟུགས་བཞག་ལ་མེ་ཏོག་སིལ་མས་གཏོར་རོ།",
    "གལ་ཏེ་ཆར་གྱི་རྒྱུན་ལེགས་པར་མ་ཕབ་ན་འཕྲལ་དུ་སྲོག་མ་རུང་བར་༤འགྱུར་རོ།",
    "དེའི་འོག་ཏུ་བལ་པོ་སེའུའི་༧ལྷུག་མས་བསྡིགས་ན་༨ལྡང་ཞིང་ལྕེ་སྟོན་པར་འགྱུར་༩།",
    "ཡུངས་ཀུར་ལ་༡་སྔགས་བརྒྱ་རྩ་བརྒྱད་ཡོངས་སུ་བཟླས་པ་བྱས་ཏེ།",
    "སད་དང་སསེར་བ་འབབ་པའི་ཚེ་སྔགས་འདི་དྲན་པར་བྱའོ།",
    "བརྗོད་པར་བགྱིའོ།",
    "གཙང་མར་བགྱིས་ལ།",
    "ནམ་མཁའི་དཀྱིལ་དེ་ཁེབས་པར་ཆར་གྱི་རྒྱུན་འབེབས་སོསེར་བ་འབབ་པའི་དུས་སུ་ཡུངས་ཀུར་༡དང་།",
    "ཀླུ་ཐམས་ཅད་ཀྱང་གཅོད་པར་འགྱུར་རོ།",
    "སྦྱིན་སྲེག་༡་བྱས་མ་ཐག་ཏུ་ཆར་གྱི་རྒྱུན་ཆེན་པོ་འབབ་པར་འགྱུར་རོ།",
    "ཡུངས་གར་༡༢ལ་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པ་བྱས་ཏེ་ནམ་མཁའ་ལ་གཏོར་ན་ཆར་ཆེན་པོ་ཟློག་༡་པར་འགྱུར་རོ།",
    "ལུས་དྲི་མི་ཞིམ་པར་འགྱུར་རོ་༡།",
    "འཇིག་རྟེན་གསུམ་སླུ་དབར་བགྱིད་པ་ལགས་སོ།་།",
    "རྣམ་ཐོས་ཀྱི་བུ་ནི་གཞི་ལ་བཞུགས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཚངས་པའི་ཁང་པ་བརྩེགས་པར་བཞུགས་པ་དང་།",
    "མུ་ཏིག་དམར་པོ་ཐ་དད་པ་མང་པོས་བརྒྱན་པའི་སེང་གེའི་ཁྲི་ལ་བཞུགས་པ།",
    "དེ་བཞིན་གཤེགས་པའི་བྱིན་གྱི་རླབས་ཀུན་ཆེན་པོས་བྱིན་གྱིས་བརླབས་པ་དང་ལྡན་པས་བཞུགས་ཏེ།",
    "རྩ་གཉིས་དང་དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུ་ཚམངའ་བ་འོད་འདོམ་གང་བས་ནི་སྐུ་ལེགས་པར་བརྒྱན་༡༡།་",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་ནི་ཤིན་ཏུ་རྣམ་པར་དག་ཅིང་ཤིན་ཏུ་དྲི་མ་དང་སྐྱོན་མེད་པའི་འོད་ནི་གསལ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཚའཁོར་ཆེན་པོ་འདུས་པར་མཁྱེན་ནས་སྐུ་ལས་༡་འོད་ཟེར་སྣ་ཚོགས་ཕྱུང་སྟེ་འོད་ཟེར་གྱི་སྣང་བ་དེས་ཕྱོགས་བཅུ་ཀུན་དུ་ཁྱབ་པར་མཛད་དོ།",
    "ཡལ་ག་ཡང་འཛམ་བུའི་གླིང་ན་མེད་པར་བྱས་ཏེ་མ་རུང་བར་བྱས་ན།",
    "བཅོམ་ལྡན་འདས་ཀླུ་གནོད་པར་སེམས་པ་གཏུམ་པོ་རྣམས་ཀྱིས་འཛམ་བུའི་གླིང་རྣམ་པར་བཤིག་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡོན་ཏན་གྱི་ཁྱད་པར་གྱི་ཚོ་བྱིན་གྱིས་བརླབས་ནལ་ལྟོས་ཤིག།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ནམ་མཁའ་ལྡིང་བསྒྱིངས་༩པས་རྣམ་པར་བལྟས་༡་ཚོཔ་ཞེས་བྱ་བ་ཀུན་ནས་མེ་ལྕེ་འབར་བའི་འཕྲེང་༡༡བ་ཅན་རྣམ་པར་འཕྲུལ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ།",
    "སྙོམས་པར་ཞུགས་མ་ཐག་ཏུ་སྐུ་ཕྲག་པ་གཉིས་རབ་ཏུ་འབར་ཏེ།",
    "དེ་ནས་ཀླུའི་རྒྱལ་པོ་ཆེན་པོ་ཀུན་ནས་གདུགས་ཀྱིས་༡་རྣམ་པར་༧བསྐོར་བས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་གཏུགས་ཏེ་འདི་སྐད་ཅེས་གསོལ་ཏོ།་།",
    "བཅོམ་ལྡན་འདས་ནིདྲོག་ལགས་སོ།",
    "བདེ་བར་གཤེགས་པ་ཚིག་ལགས་སོ།",
