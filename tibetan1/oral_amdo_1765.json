    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ནི་ཟབ་པ་མ་ཡིན།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ནི་ཟབ་པ་མ་ཡིན།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ནི་ཟབ་པ་མ་ཡིན། ༺འབུམ་ཆ་",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་རང་བཞིན་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་རང་བཞིན་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་རང་བཞིན་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་རང་བཞིན་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་རང་བཞིན་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་རང་བཞིན་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "རེག་པ་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན།",
    "སྐྱེད་མཆེད་དྲུག་གི་རང་བཞིན་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "རེག་པའི་རང་བཞིན་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ནི་ཟབ་པ་མ་ཡིན་ཕྲ་བ་མ་ཡིན་ནོ།",
    "རེག་ཏུ་བཏགས་པ་མྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པར་བཏགས་པ་མྱེད་དོ།",
    "སྣའི་འདུས་ཏེ་རེག་པར་བཏགས་པ་མྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པར་བཏགས་པ་མྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པར་བཏགས་པ་མྱེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པར་བཏགས་པ་མྱེད་དོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བར་བཏགས་པ་མྱེད་དོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བར་བཏགས་པ་མྱེད་དོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བར་བཏགས་པ་མྱེད་དོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བར་བཏགས་པ་མྱེད་དོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བར་བཏགས་པ་མྱེད་དོ།",
    "རེག་པར་བཏགས་པ་མྱེད་དོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དུ་བཏགས་པ་མྱེད་དོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་རབ་འབྱོར་ཀྱི་སེམས་ཀྱི་ལྷའི་བུ་དེ་དག་གི་སེམས་ཀྱི་རྣམ་པར་རྟོག་པ་སེམས་ཀྱིས་ཡོངས་སུ་ཤེས་ནས་ལྷའི་བུ་༺འབུམ་ཆ་",
    "དེ་ནས་ལྷའི་བུ་དེ་དག་གིས་ཚེ་དང་ལྡན་པ་རབ་འབྱོར་ལ་དི་སྐད་ཅེས་སྨྲས་སོ།",
    "རེག་ཀྱང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "རེག་པ་ཡང་རྨྱི་ལམ་ལྟ་བུ་སྒྱུ་མ་ལྟ་བུའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱང་༺འབུམ་ཆ་",
    "དེ་ནས་ལྷའི་བུ་དེ་དག་གིས་ཚེ་དང་ལྡན་པ་རབ་འབྱོར་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཚེ་དང་ལྡན་པ་མོའུ་གལ་གྱི་བུ་ཆེན་པོ་དང་།",
    "ཚེ་དང་ལྡན་པ་བྱམས་གང་གི་བུ་དང་།",
    "རེག་བྱ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་རེག་བྱ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རེག་བྱ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་རེག་བྱ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རེག་བྱ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་རེག་བྱ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རེག་བྱ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་རེག་བྱ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རེག་བྱ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་རེག་བྱ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རེག་བྱ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་རེག་བྱ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རེག་བྱ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་རེག་བྱ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་མྱིག་གི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་མྱིག་གི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་མྱིག་གི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་མྱིག་གི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་༺འབུམ་ཆ་",
    "འགག་པ་མྱེད་པ་མྱིག་གི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་མྱིག་གི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་མྱིག་གི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་མྱིག་གི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་སྣའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ལྕེའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ། ༺འབུམ་ཆ་",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་སྣའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ལྕེའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ། ༺འབུམ་ཆ་",
    "སྣའི་འདུས་ཏེ་རེག་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་སྣའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ལྕེའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་སྣའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ལྕེའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར། ༺འབུམ་ཆ་",
    "འགག་པ་མྱེད་པ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་སྣའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ལྕེའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་སྣའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ལྕེའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་༺འབུམ་ཆ་",
    "ཞི་བ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་སྣའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ལྕེའི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་༺འབུམ་ཆ་",
    "སྟོང་པ་ཉིད་ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་༺འབུམ་ཆ་",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ། ༺འབུམ་ཆ་",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་འགག་པ་༺འབུམ་ཆ་",
    "འགག་པ་མྱེད་པ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་སྣའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་བྱུང་བའི་ཚོར་བ་ཞི་ཞེས་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།"
  ]
}