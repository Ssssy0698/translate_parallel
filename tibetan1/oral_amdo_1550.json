    "ཅིའི་ཕྱིར་བདག་འདི་ཁོ་ན་ལྟར་བདག་མ་རུང་བར་གྱུར་སཱ་མམོ།",
    "ཐམས་ཅད་གཟིགས་པ་ཡིན་པས་ན།",
    "དེས་ན་དབངཔོའམགོས་སྟན་དེ་ཉིད་ལ་འདུག་བཞིན་དུ་འཇིག་ཚོགས་ལ་ལྟ་བའི་རིའི་རྩི་མོམཐོནཔོཉི་ཤུ་ཡེ་ཤེས་རྡོ་རྗེས་བཅོམནས་རྒྱུན་ཏུ་ཞུགས་པའིའབྲས་བུ་མངོན་སུམ་དུ་བྱས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ད་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལཔ་བཞིནངུ་འཚལ་ལོཞེས་གསོལ་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཐ་༨ནས་སོད་སྐ་དེ་ཡངས་པ་ཅན་དུ་སོང་ནས།",
    "ལྡནའདས་ག་ལ་བ་དེ་ལོགས་སུཐལ་ནོ་སྦྱར་བ་བཏུད་དེ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐ་དཅེས་གསལ་ཏོ།",
    "ར་ཏུ་ཀྱང་བ་དང་བསྟན་པར་སྡུག་ས་ཤིང་དགེ་སློངགི་དངོས་པོ་འཐོབ་ཏུ་རུང་ན།",
    "དེདག་གི་སཀྱངབརྩོན་པ་དང་བསྒྲུབ་པ་དང་འབད་པས་ཉོན་མོངས་པ་ཐམ་ག་ཅད་སྤངས་ནག་དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་དུ་བྱས་སོ།",
    "ལིཙ་ལྔ་བརྒྱ་བཅོམ་ལྡན་འདས་ཀྱི་བསྟནཔ་ལ་རབ་ཏུ་བྱུང་ནས་ནམོངས་པ་ཐམས་ཅད་སྤངས་ཏེ།",
    "དགྲ་བཅོམ་པ་ཉིད་མངོན་སྙམ་དུ་བགྱིས་པ་ལ་གཟིགས།",
    "ཀ་ཡུང་དྲུང་གི་མཐར་ཐུག་པ་གྲུབ་པ་དང་བདེ་བའི་མྱ་ངནལས་འདས་པལ་བཀོང་དོ།",
    "རྒྱལ་བོའི་ཁབ་ཏུག་ཤགས་ཏེ་འོད་མའི་ཚལ་བཞེས་ནས་དགེ་སློང་ཤཱ་རིའི་བུདདམོདགལ་གྱི་བུ་གཉིས་རབཏུ་བྱུང་སྟེ་བསྟན་པ་རྒྱས་པར་མཛད་ནས།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་གཙོབོལ་འོས་པདད་དགྲབཅོམ་པལའོས་པའི་ཚིགས་སུ་བཅད་པ་དག་གིས།",
    "ལྷའི་དབད་པོ་བརྒྱ་བྱིན་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་ལྷའི་དབདཔོ་བརྒྱ་བྱིན་ལ་འདི་སྐདཅས་སྨྲས་སོ།",
    "ཁྱོད་ཀྱིས་བཅོམ་ལྡནའ་དས་ལྟར་འགྲོ་བ་དང་བསྙེན་བཀུརབྱ་བའི་དུས་ལ་བབ་པོ།",
    "དེ་དག་གི་སྦྱོར་བ་ནི་ཕྲགཤོག་དད་སེར་སྣ་ལགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པའི་དོན་དེ་བདག་གིསརྟོགས་ནས།",
    "བཅོ་མ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པའི་དོན་འདི་བདག་གིས་རྟོགས་ནས།",
    "བཙེམལྡན་འདས་ཀྱིས་བཀའ་སྩལ་བའི་དོན་འདི་བདག་གིས་རྟོགསནས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པའི་དོན་འདི་བདག་གིསརྟོགས་ནསཨོམ་ཉལསརྒལ་ཏེཐེ་ཚོ་མ་དང་ཕྲལ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིསབཀའ་སྩ་ལ་པའིདོན་འདིབདག་གིས་རྟོགས་ནས།",
    "ཀོ་ཤི་ཀ་སྤྲོས་པ་འགོག་པར་འགྱུརབའི་ལམ་ལ་ཞུགས་པའིདགེ་སློདགི་སོ་སོར།",
    "ཀོ་ཤིཀ་མིག་གིས་ཤེས་པར་བྱ་བའི་གཟུགས་རྣམས་ལ་ཡང་བསྟེན་པར་བྱ་བདང་བསྟེན་པརབྱ་བ་མ་ཡིན་བརྣམ་པ་གཉིས་ཡོདད།",
    "མིག་གིས་ཤེས་པར་བྱ་བའིགཟུགས་གང་ཡིན་པ་རྣམས་བསྒྲུབས་ཏེག་ནས་པར་འོས་པ་ནི་བསྟནཔརབྱའོ་ཞེས་ང་ཟེར་རོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པའི་དོན་འདི་བདག་གིས་རྟོགསནས་སོམ་ཉལ་བརྒལཏེ་ཐེཙོ་བ་དང་བྲལ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་བའི་དོན་འདི་པ་དག་གིགརྟོགས་ཏེ།",
    "དེ་ལུད་པ་སྟན་པའི་དུམ་མཁྱེན་ནས་དྲན་པ་དང་ཤེས་བཞིན་དང་ལྡན་པས་བསྒྲུབ་པར་བྱའོ་ཞེས་ཁྱོདགསུད།",
    "དེལ་ཡིད་མི་བདེ་བའི་ལུས་དང་བཏང་སྙོམས་ཀྱི་ལུས་བསྒྲུབས་ཏེ་གནས་པ་བགྱི་བའའོས་ལགས་པར་ཤེས་པ་གལགས་པ་དེ་ནི་དེའི་སྐབས་སུ་དེ་བཞིན་གཤེགས་པས་དེ་ལུང་བསྟན་པའི་དུས་མཁྱེན་བླློ་ནས་དྲན་པ་དང་ཤེས་བཞིན་དང་ལྡན་པས་བསྒྲུབ་བར་བྱའོཞེས་ཁྱོད་ག་སུད་སྟེ།",
    "ཀྱིས་བཀའ་སྩལ་པའི་དོན་འད་བདག་གིས་རྟོགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩ་ལ་བའི་དོན་འདི་བདག་གིས་རྟོགས་ནས།་",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པའི་དོན་འདི་བདག་གིས་རྟོགས་ནས་སོམ་ཉི་ལས་རྒལ་ཏེ་ཐེ་ཙི་ཡ་དང་བྲལ་ལགས་སོ།",
    "སོ་སེར་གྱེས་པ་དེ་དག་གི་ནང་ནས་ལྷ་ཆེ་བར་གྲགས་སོ་འཚལ་གནས་ནས་འཆི་འཕོརེ་མི་སྣང་བར་གྱུར་ནས།",
    "དེ་དག་གིས་བདག་ལ་ཁྱོད་སུ་ཡིན་ཞེས་འདྲི་བར་བགྱིད་དེ།",
    "ཀྱེ་མ་བདག་གིས་བརྒྱ་བྱིན་མཐོད་དོ།",
    "རྒྱལ་བ་ཁྱོད་ཀྱིས་བདུད་ཀྱང་བཏུལ།",
    "ཁྱོད་ཀྱིས་བག་ཉལ་བཅད་ནས་ཀྱང་།",
    "ཁྱོད་ལས་ལྷག་པ་ཡོང་མ་མཆིས།",
    "གང་ཟག་ཁྱོད་ཀྱི་ཟླ་མ་མཆིས།",
    "བདག་གི་ཡིད་ནི་སྡོམ་ལ་དགའ།",
    "ལ་ན་ཅིག་བྱར་འོང་བར་འགྱུར་བའི་རེ་བ་ཡང་བདག་ལ་མཆི་མ་ལགས་སོ།",
    "བཅོམ་ལྡན་ཁྱོད་ཀྱིསགཞན་ལ་མེད།",
    "ཁྱོད་ཀྱི་བསྟན་ལས་གཞན་ལ་མེད།",
    "བདག་གིས་ཆེ་རིང་ཐོབ་ལགས་ཀྱིས།",
    "དེནས་ལྷའིདབ་ད་པོ་བརྒྱ་བྱིན་གྱིས་བདེན་པ་མཐོད་ནས་དགའ་ཞིང་མགུ་ལ་རབ་ཏུ་དགའ་ཞིང་ཡིད་རངས་ཏེ་དགའབ་དང་ཡིདབད་བ་སྐྱམ་ནས་སྟན་ལས་ལངས་ཏེ་བླ་གེས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ནས་བཅོམ་གྱཏུ་ལན་འའདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུདད།",
    "བུ་ཁྱོདནི་བདག་ལ་ཕན་པ་དང་།",
    "གྲོགས་པོ་དག་བདག་གིས་སྡོན་ཆད་མི་མཇེད་ཀྱི་བདག་པོ་ཚངས་པ་ལ་དུས་གསུམ་དུ་ཚངས་པ་ལ་འོམ་པའི་འདུང་བ་བྱེད་པ་གང་ཡིན་པདེ་ནི་བདག་གིས་ཕྱིན་ཆདབཅོམ་ལྡན་འདས་འདིའདིལ་ཚངས་པ་ལ་འོས་བའི་འདུད་པས་འདུད་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་གྱ་གལ་བདེ་ལེགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་ནས་ཕུས་མོགཡས་པའི་མྷངས་ལ་བཙུགས་ཏེ།",
    "དེས་གང་གི་ཚེ་བླ་ན་མེད་པའི་ཡེ་ཤེས་བརྙེས་ནས།",
    "བདག་ཅག་གིས་སྟོན་པ་འདི་ལྟ་བུ་མཉེས་པར་བྱེད་པར་གྱུར་ཅིག།",
    "ཡི་ག་དང་བྲམཟེའི་སྦྱོད་ལ་མདང་སྐྱོདཔ་དང་ཨོམ་ཞེས་བྱ་བ་དང་བྷོ་ཞེས་བྱ་བ་དང་གཙང་སྦྲ་དང་ཆོག་དང་ཐལ་བ་བླང་བ་དང་རིལ་བ་ཐོགས་པ་དདངས་བརྗོད་ཀྱི་རིག་བྱེད་དང་མཆོད་སྦྱིན་གྱི་རིག་བྱེད་དང་སྟན་། ཚིག་གི་རིག་བྱེ་དདང་སྲིད་སྲུད་གི་རེ་གི་བྱེད་དད་མཆོད་སྐྱིན་བྱ་བ་དང་མཆོད་སྦྱིན་བྱེད་དྲུགཞག་པ་དར་སྐྱིན་པ་དང་བླང་བ་དང་ཁ་ཏོན་དུ་བྱ་བ་དང་ཁ་ཏོན་སློབ་པ་གཞུག་པའི་ཐབས་བསླབས་ནས།",
    "བདག་གིས་འདི་ཡུལ་གཞན་དུ་གཏད་པར་བྱའོ་སྙམ་ནས་བྲམ་ཟེད་ལ་སྙས་པ།",
    "ཁྱོད་ཀྱིས་བདག་བླངས་ཏེ་ཅི་བགྱིས།",
    "བདག་ཅག་བྲམ་ཟེ་རྣམས་ལ་སློངས་མོས་འཚབ་ཡང་ཡོད་ཀྱིས་འདག་ཡུལ་གཞན་དུ་སོང་ལ་ནོར་བཙལ་ཏེ།",
    "བྲམ་ཟེ་ཁྱོད་ཀྱི་ནོར་འདི་ཡིན་གྱིས།",
    "རང་གི་ཁྱིམ་དུ་སོང་ན།",
    "བླ་གོས་ཕྲག་པགཅིག་ཏུགཟར་ནས་བཅོམ་ལྡནའདས་ག་ལ་བ་དང་ལོགས་སུ་ཐལ་མོ་སྦྱར་བབཏུདད།",
    "དེས་ཕྱིན་ཅད་བདག་གིས་སེ་མས་ཅན་རྣམས་ལ་ཐམས་ཅད་སྦྱིན་ནོ་ཞེས་དམ་བཅ་ས་སོ།",
    "དེ་དག་གིས་ངུས་ངུས་སུ་ཆར་གྱི་རྒྱུན་ལེགས་པར་འབེབས་ཤིང་འབྲུན་མས་རྒྱས་པར་བྱེད་དོ།",
    "དཔུང་གི་ཚོགས་ཡན་ལག་བཞི་གོ་བསྐོན་ཏེ།",
    "འཇིག་རྟེན་ཕ་རོལ་དག་གིས་འཛེམ་པར་མི་རྣམས་ཀྱིས།",
    "བདག་གིས་དེའི་ཐང་ངུ་འགྲོ་བར་བྱའོ།",
    "དེའི་ཐད་དུ་སོངདང་བདག་གི་ནོར་དེ་ལས་འོང་ངོ་སྙམ་ནས་བཱ་རཱ་ཎ་སིར་སོང་།",
    "དེས་ནགས་ཀྱིནང་དུགནས་བཅས་སོ་ཞེས་ཁྱོད་ཀྱིས་མཐོས་སམ།",
    "དེ་ནས་དེས་ཐོས་མ་ཐག་ཏུ་བྲམཟོ་ད་རེ་ཐག་ཆ་ད་ནས་བརྒྱལ་ཏེ་ས་ལ་འགྱེལ་ཏོ།",
    "ངས་ཁྱོད་ཀྱི་དབུལ་བ་གཅད་པར་བྱའོ།",
    "བྲམ་ཟེ་ཁྱོད་ཚུར་ཤོག།",
    "དཆིངས་ཏེ་ཁྲིད་དེ་སོང་ཤིག།",
    "དནསབྲམ་ཟེ་ན་རེ།",
    "འདི་བདག་གིས་དཀའ་བ་ཀྱི་ནགས་ཚལ་ན་གནས་པ་ལས།",
    "ཁྱོད་ནི་རྒྱལ་པོའི་འོམ་ལགས་ཀྱི།",
    "དེས་དེ་ལ་དཔུང་གི་ཚོགས་དང་དཀོརམཛོད་རྣམས་ཕུལ་ནས་བཟོད་པར་གསོལ་ཏེ།",
    "དེདནས་ཀུན་དགའ་བོ་སོང་སྟེ།",
    "དེནས་དེ་དག་གིས་བསམས་པ།",
    "འདི་ཉིད་ཀྱི་བུ་ཡིན་གོང་མ་ཆག་སྐམ་མོ།",
    "བྱ་རྒོད་ཀྱི་ཕུང་པོའར་ལེས་ཐལ་ནས།",
    "འདིས་ནི་ཁྱོད་འཚོ་བ་དདཔར་ནུས་སོ་ཞེས་ཟེར་རོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བདེན་པས་བསྐལ་པས་མོས་པར་མཛད་དོ་ཞེས་འཛར་ཏོ།",
    "བཙུན་པ་ལྷས་བྱིན་ནི་དུ་མི་གཟོཟོ་དང་བྱས་པ་མཚོར་བ་དང་བྱས་པ་ཆུད་གསོན་པ་ལ་གཟིགས།",
    "ཀྱེ་གྲོགས་པོ་བདག་ཅག་གི་སྐྱབས་གྱིས་ཤིགཅེས་སོ།",
    "གྲོགས་བོ་ཁྱོད་ཉོན་མོངས་པར་མ་བྱེད་ཅིག།",
    "དས་ཁྱོད་ལ་དྲིན་ལ་ལན་ཀླན་པར་བྱ་སྟེ།",
    "གྲོགས་པོ་ཁྱོད་དཀའ་བས་འཚོ་བ་འདིལྟ་བུ་ཞིག་གིས་འཚོ་ཞིང་འདུག་གམ།",
    "མི་དེ་སོང་སྟེ་རྒྱལ་པོལ་གསོལ།",
    "རྒྱན་རྣམས་ཀྱང་ཕྲོགས་ནས་ཁྲི་མོ་ན་རུ་བཅུག་གོ།",
    "ཁྱོད་ཀྱིས་དའོངས་ནས་འདི་སྐད་དུ་ཡང་ན་མེར་མཆོངས་ཤིག།",
    "དེ་ནས་ཁྱོད་ཀྱིས་ངལ་འདི་སྐང་ངུ།",
    "དོནས་ཁྱོ་རྨོས་པ་འོ་མ་དང་ཞོ་དང་མར་དང་ཞུན་མར་དང་མར་གྱི་ཉིད་ཁུས་བསྐྱེད་བསྲིས་ཏེ།",
    "དེ་གང་གི་ཚེ་ཆེར་སྐྱེས་པ་དེའི་ཚེ་ཡི་གེ་དང་ཁོང་བཙ་ས་དང་ཤོ་ད།",
    "ཁྱིམ་བདགགིས་སྨྲས་པ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་པ་དེང་སོང་ཏེ།",
    "བཙོམ་ལྡན་འདས་ག་ལབ་དེར་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་ནས་དགྲབཅོ་མཔ་ཉིད་མངོན་སུམ་དུ་བགྱིས་ཏེ།",
    "བདག་གིས་འདི་ལ་གནོད་པ་བྱས་པའི་ལས།",
    "དཀར་ཀྱི་བསྟན་པ་ལ་རབ་དུ་བྱུང་ནས་ཉོན་མོངས་པ་ཐམ་སཅད་སྦངས་ཏེ་དགྲ་བཅོམ་པ་འདི་མངོན་སུམ་དུ་བྱས་སོ།",
    "དེ་དག་གིསབསམས་པ།",
    "དེ་ནས་ཕྱི་ཞིག་ན་མཆོད་སྦྱིན་བྱེད་པ་དེར་ལྡེདསན་གནས་པའ་བྲ་མ་ཟེ་དད་མཐལནགནས་པའི་བྲམ་ཟེ་ཡོན་གྱི་ཕྱིར་འདུས་པ་རྣམས་འཐབ་མོ་བྱུད་ནས།",
    "དེ་བྲམ་ཟེ་དག་གིས་བཟུང་ནས་ཁུ་ཚུར་དང་རྡོག་པ་དག་གིས་ཤིན་ཏུ་ཞེནཔར་བརྡེགས་ཏེ་བོར་རོ།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོག་སུ་ཐལ་མེ་སྦྱར་བ་བཏུད་དེ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐདཅེས་གསོལ་ཏོ།",
    "རེས་འགའ་ནི་གྲོད་མ་གོངཁྱེར་ལྟར་འགྲོའོ།",
    "ཁྱབ་འཇུགདེ་བདག་ཅག་གི་མཆོད་སྦྱིན་ག་གནས་འདིར་བྱུང་ངོ་ཞེས་ཟེར་རོ།",
