    "སྔོན་པོ་རགས་པར་འདོད་པ་དང་།",
    "བློ་མ་འཁྲུལ་པ་ལ་ཆ་བཅས་སུ་དངོས་སུ་སྣང་མི་སྲིད་པར་འདོད་པ་རྣམས་འགལ་ལོ་ཞེ་ན།",
    "སྔོན་པོ་རགས་པ་ཡིན་པར་སྔོན་འཛིན་མིག་ཤེས་ལ་སྣང་བ་མ་ཡིན་པའི་ཕྱིར།",
    "རྫས་སུ་མ་གྲུབ་པས་ཁྱབ་པར་ཁས་བླངས་ནས།",
    "འདི་ནི་ནང་འགལ་ངོ་མི་ཤེས་པར་ཟད་དེ།",
    "དེ་ལྟ་མ་ཡིན་པར་རང་ཆ་བཅས་ཡིན་ཞིང་།",
    "རགས་པར་སྣང་བ་དེ་འདྲར་བྱེད།",
    "རྒྱུན་ཡིན་རྫས་སུ་མ་གྲུབ་པས་ཁྱབ་པར་འདོད་པ་ལ།",
    "འདིར་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "སྒྲ་སྐད་ཅིག་མ་གཅིག་ལས་མེད་པར་འདོད་དགོས་སོ།",
    "དེ་ལྟ་མིན་པར་སྐད་ཅིག་དུ་མ་ཆ་ཤས་སུ་ལྡན་པའི་རྒྱུན་ཡང་མ་ཡིན་ན།",
    "དུས་མཐའི་སྐད་ཅིག་མ་དུ་མ་མི་སྲིད་པར་ཁས་ལེན་དགོས་པས་དུས་མཐའི་སྐད་ཅིག་མ་ཡིན་པ་གཅིག་ལས་མི་སྲིད་པར་འགྱུར་རོ།",
    "དུས་མཐའི་སྐད་ཅིག་མ་བརྒྱ་པོ་དུས་མཐའི་སྐད་ཅིག་མ་གཅིག་དང་ཡུན་རིང་ཐུང་མཉམ་པར་འགྱུར་རོ་ཞེ་ན།",
    "རྟག་པར་འགྱུར་ཞེས་པའང་རིགས་པ་ལྟར་སྣང་སྟེ།",
    "མ་ཁྱབ་ན་སྐད་ཅིག་མ་ཡིན་ན་འཇིག་པས་ཁྱབ་པར་འདོད་པ་དང་འགལ།",
    "བུམ་གཟུགས་སྐད་ཅིག་ཆ་མེད་མ་ཡིན་དགོས་པར་འགྱུར།",
    "དེ་བས་ན་དངོས་པོའི་མཚན་གཞི་མེད་དོ་ཞེས་སྨྲ་མ་ནུས་པར་ཟོལ་སྨྲ་འདི་ལྟ་བུ་ཁས་ལེན་པ་ལས་ནི།",
    "དེའི་ཕྱིར་སྒྲ་རྟག་པར་ཁས་ལེན་དགོས་པ་བྱུང་སྟེ།",
    "ད་ནི་ཡུལ་དུས་རང་བཞིན་འདྲེས་པར་འཛིན་པའི་བློའི་འཛིན་སྟངས་ཀྱི་བཟློག་ཕྱོགས་ཡིན་ལ་ཡུལ་དུས་རང་བཞིན་འདྲེས་པར་འཛིན་པའི་རྟོག་པའི་འཛིན་སྟངས་ལ་ཡང་།",
    "དེས་ན་ཡུལ་དུས་རང་བཞིན་འདྲེས་འཛིན་གྱི་རྟོག་པའི་འཛིན་སྟངས་ལ་སྔ་དྲོའི་ཀ་བ་དེ་ཉིད་ཕྱི་དྲོ་ཡོད་པར་འཛིན་པ་དང་།",
    "སྤྱི་ཡིན་ན་དངོས་པོ་ཡིན་པར་འགལ་ཞེས་པའི་རིགས་པ་དང་།",
    "དེ་དག་ཡིན་ན་རང་མཚན་མིན་པས་ཁྱབ་པར་སྟོན་པ་མ་ཡིན་ཏེ།",
    "སྤྱི་ཡིན་ན་སྒྲོ་བཏགས་ཡིན་དགོས་པར་འགྱུར་ལ།",
    "ཁོ་ཡིན་པ་དུ་མ་ཡོད་ན་ཁོ་སྒྲོ་བཏགས་ཡིན་དགོས་པར་འགྱུར་བས།",
    "ཁོ་རྫས་སུ་གྲུབ་ན་ཁོ་ཡིན་པ་འཇིག་རྟེན་ན་གཅིག་ལས་མེད་དགོས་པར་འགྱུར་རོ།",
    "དོན་བྱེད་ནུས་ན་རང་མཚན་ཡིན་པས་ཁྱབ་པར་བསྟན་ལ།",
    "བྱས་པ་སྒྲ་མི་རྟག་སྒྲུབ་ཀྱི་མཐུན་དཔེ་བུམ་པ་དང་།",
    "སྤྱིས་ཀྱང་སྒྲུབ་པར་བྱེད་པ་ལ།",
    "སྤྱི་མཚན་མ་ཡིན་ནོ་ཞེས་ཤེས་པར་གྱིས་ཤིག།",
    "ཞེས་སོགས་ཀྱང་དེ་ལྟར་དུ་ཤེས་པར་བྱའི།",
    "ཚེས་གཅིག་ཡོད་ཀྱང་ཚེས་གཅིག་རྫོགས་པར་གྲུབ་པ་མ་ཡིན་ལ།",
    "ཚེས་གཉིས་ཀྱི་སྔ་དྲོའི་སྔ་ལོགས་ཙམ་དུ་ཚེས་གཅིག་རྫོགས་པར་གྲུབ་ཀྱང་།",
    "དེའི་སྐད་ཅིག་གཉིས་པར་ཚེས་གཅིག་ཞིག་པའི་ཕྱིར་དང་།",
    "རང་གྲུབ་དུས་ལས་དུས་གཉིས་པར་མི་སྡོད་པ་ཉིད་སྐད་ཅིག་མའི་དོན་ཡིན་པའི་ཕྱིར་རོ།",
    "འདིས་རྒྱུན་ལྡན་གྱི་དངོས་པོ་ཀུན་ལ་མཚོན་ཏེ་ཤེས་པར་བྱའོ།",
    "གསེར་བུམ་བུམ་པར་འཛིན་པའི་རྟོག་པ་ལ།",
    "གསེར་བུམ་ཡང་བུམ་པར་སྣང་ཞིང་།",
    "དེ་ཡང་གསེར་བུམ་བུམ་པར་སྣང་བའི་སྣང་བ་དང་།",
    "བུམ་འཛིན་རྟོག་པ་ལ་གསེར་བུམ་བུམ་པར་སྣང་བ་དེ་ཡང་སྒྲ་དོན་ཡིན་ལ།",
    "རང་ལ་སྣང་བ་དེ་ཉིད་བུམ་པ་ཡིན་ལས་ལོག་པར་སྣང་བ་དེ་ཡང་སྒྲ་དོན་ཡིན་ནོ།",
    "རྟོག་པ་དེ་ལ་གསེར་བུམ་བུམ་པར་སྣང་བ་བཞིན་དུ།",
    "ཡུལ་ལ་འཇུག་པའི་ཚེ་གསེར་བུམ་བུམ་པར་སྣང་བ་ཕྱི་རོལ་གྱི་དོན་དུ་མེད་པ་དེ་ལ་ཞེན་ནས་ཕྱི་རོལ་གྱི་དོན་ལ་འཇུག་པ་ཡིན་ཡང་།",
    "སྣང་ཚུལ་ལ་གསེར་བུམ་བུམ་པར་སྣང་བ་དེ་དང་།",
    "བུམ་མིན་ལས་ལོག་པར་མེད་ཀྱང་བུམ་མིན་ལས་ལོག་པར་སྣང་བས་སྣང་ཡུལ་ལ་འཁྲུལ་བར་འཇོག་ལ།",
    "བུམ་པའོ་སྙམ་པ་དང་བུམ་པ་མ་ཡིན་པ་ལས་ལོག་པའོ་སྙམ་དུ་ཞེན་པ་མེད་པས་ཞེན་ཡུལ་ལ་འཁྲུལ་པར་མི་འཇོག་པ་ཡིན་ནོ།",
    "བུམ་འཛིན་རྟོག་པ་ལ་ཤར་བའི་བུམ་པའི་གཟུགས་བརྙན་ལ་ཕྱི་རོལ་བུམ་པར་སྒྲོ་བཏགས་པའི་ཆ་ལ་བུམ་པའི་སྒྲ་དོན་དུ་འདོད་པའང་མི་འཐད་དེ།",
    "རང་ལ་བུམ་པར་སྣང་བ་དེ་ལ་ཟེར་བ་ཡིན་ན།",
    "དེ་ཕྱི་རོལ་བུམ་པར་སྒྲོ་བཏགས་ཞེས་པའི་དོན་གང་ཡིན།",
    "རྟོག་པས་ཕྱི་རོལ་བུམ་པར་ཞེན་པ་ལ་བྱེད་ན།",
    "བུམ་འཛིན་རྟོག་པས་རང་ལ་བུམ་པར་སྣང་བ་དེ་ཕྱི་རོལ་བུམ་པར་ཞེན་པ་མེད་པའི་ཕྱིར་ཏེ།",
    "དེས་ན་རྟོག་པ་དེས་རང་ལ་བུམ་པར་སྣང་བ་ལ་ཞེན་ནས་ཕྱི་རོལ་བུམ་པ་འཇུག་པ་ཡིན་གྱི།",
    "རང་ལ་བུམ་པར་སྣང་བ་དེ་ཕྱི་རོལ་གྱི་བུམ་པར་ཞེན་ནས་འཇུག་པ་མ་ཡིན་ནོ།",
    "སྒྲོ་བཏགས་པའི་དོན་བུམ་པ་སྣང་བ་དེ་ཕྱི་རོལ་བུམ་པར་མེད་ཀྱང་།",
    "ཕྱི་རོལ་བུམ་པར་སྣང་བ་ལ་བྱེད་ན།",
    "དེའི་ཕྱིར་བུམ་འཛིན་རྟོག་པས་རང་ལ་སྣང་བ་ཕྱི་རོལ་བུམ་པར་སྒྲོ་བཏགས་ཟེར་དགོས་པས།",
    "དེ་ཡང་རྟོག་པ་ལ་གསེར་བུམ་བུམ་པར་སྣང་བ་དེ་སྒྲ་དོན་ཡིན་ཀྱང་།",
    "རྟོག་པ་ལ་བུམ་པར་སྣང་བ་ཡིན་པ་ལ་སྒྲ་དོན་ཡིན་པས་ཁྱབ་པ་ནི་མ་ཡིན་ཏེ།",
    "གསེར་བུམ་རྟོག་པ་ལ་བུམ་པར་སྣང་བའི་ཕྱིར་རོ།",
    "བུམ་པ་ཡིན་ན་བུམ་པའི་སྒྲ་དོན་ཡིན་པར་འགལ་བའི་ཕྱིར་རོ།",
    "བུམ་གསལ་རྣམས་དེའི་བྱེ་བྲག་ཡིན་པར་འགལ་བ་མ་ཡིན་ཏེ།",
    "རྟོག་པ་ལ་བུམ་པར་སྣང་བ་དེ་བུམ་པའི་སྒྲ་དོན་ཡང་ཡིན་ལ།",
    "རྟོག་པ་ལ་བུམ་པར་སྣང་བ་དེ་ཉིད་བུམ་གསལ་རྣམས་ལ་རྗེས་སུ་འགྲོ་བའི་སྤྱི་དངོས་མེད་དུ་གྱུར་པ་ཡིན་ནོ།",
    "སྤྱི་མཚན་ཡིན་ན་སྤྱི་ཡིན་པར་ཡང་མི་འགལ་ལོ།",
    "དེས་ན་རྟོག་པ་ལ་གསེར་བུམ་བུམ་པར་སྣང་བ་སྒྲ་དོན་ཡིན་ཡང་།",
