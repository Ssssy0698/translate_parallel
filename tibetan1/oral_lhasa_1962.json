    "བྱས་པའི་ཁྱབ་པ་སྒྲུབ་པ་ལ་ལྟོས་མེད་ཀྱི་རྟགས་དང་གནོད་པ་ཅན་གྱི་རྟགས་གཉིས་འགོད་དགོས་སོ།",
    "དེ་ཡོད་ན་རྟག་པར་འགལ་བའི་ཕྱིར།",
    "མེད་ན་འབྲས་བུ་རྣམས་རིམ་གྱིས་བསྐྱེད་པར་འགལ་ལོ།",
    "དེ་ལྟར་དུ་བྱས་པ་ལ་འོ་ན།",
    "རིམ་དང་ཅིག་ཅར་དུ་དོན་བྱེད་པས་སྟོང་པའི་རྟགས་ཀྱིས་རྟག་པའི་བསལ་བའི་དབྱེ་བ་མ་ལུས་པ་བྱས་སྟོང་དུ་ངེས་ནུས་སམ་མི་ནུས།",
    "ནུས་ན་ཁྱབ་པ་ངེས་ནུས་ན་བསྒྲུབ་བྱ་ངེས་པ་དང་བྱས་པའི་རྟགས་ཀྱིས་མི་རྟག་པའི་ཁྱབ་པ་ངེས་ན་མི་རྟག་པའི་གསལ་བའི་དབྱེ་བ་མ་ལུས་པར་མི་རྟག་པར་ངེས་པར་འགྱུར་རོ་ཞེས་ཟེར་ན།",
    "ཁྱབ་བྱེད་ལ་ཡོད་པར་ངེས་ན་ཁྱབ་བྱ་ལ་ཡོད་པར་མ་ངེས་པའི་ཕྱིར་ཟེར་ན།",
    "བྱས་པ་མི་རྟག་པ་ལ་ཡོད་པར་ངེས་པ་དེ་ལ་རྟག་མི་རྟག་དངོས་འགལ་དུ་ངེས་པ་དང་བྱས་པ་ངེས་པ་དང་།",
    "རང་བཞིན་གྱིས་གཅིག་དང་ཐ་དད་དུ་ཡོད་པར་སྒྲོ་འདོགས་པའི་སྒྲོ་འདོགས་དེ་གཉིས་ཀ་སྒྲོ་འདོགས་ཀུན་བཏགས་ཡིན་ལ།",
    "དེ་གཉིས་ཀྱི་དངོས་གཉེན་དུ་གྱུར་པའི་རང་བཞིན་གྱིས་གཅིག་དང་ཐ་དད་དུ་མ་གྲུབ་པའི་ཕྱིར་ངེས་པའི་བློ་དེས་ལྷན་སྐྱེས་ཀྱི་འཛིན་སྟངས་སུ་གྱུར་པའི་རང་བཞིན་གྱིས་ཡོད་པ་ཁེགས་པར་འགྱུར་རོ།",
    "རང་བཞིན་གྱིས་གཅིག་ཏུ་གྲུབ་པས་སྟོང་པར་རྟོགས་པའི་བློ་ནི།",
    "ཐ་སྙད་དུ་སྟོང་པར་རྟོགས་པའི་བློ་ནི་བཞིའི་ནང་ནས་སྟོང་པའི་རྣམ་པ་ཡིན།",
    "དེས་ན་རང་བཞིན་གྱིས་ཡོད་པར་སྒྲོ་འདོགས་པ་བདག་འཛིན་ལྷན་སྐྱེས་ཡིན་ཅིང་།",
    "བདག་རང་བཞིན་གྱིས་ཡོད་པར་འཛིན་པའི་བློ་དེ་དངོས་པོའི་གནས་ལུགས་ལས་འཛིན་སྟངས་ཕྱིན་ཅི་ལོག་ཏུ་ཞུགས་པའི་བློར་གྲུབ་སྟེ།",
    "དེ་དང་འཛིན་སྟངས་དངོས་སུ་འགལ་བའི་གནོད་བྱེད་ཀྱི་གཉེན་པོ་སྟོབས་ལྡན་ཡོད་པར་གྲུབ་ཅིང་།",
    "དེ་ཉིད་ནི་བདག་མེད་རྟོགས་པའི་ཤེས་རབ་ལས་འོས་གཞན་མེད་པར་གྲུབ་པས།",
    "ཤེས་པའི་ཡ་མཐའ་ཐོགས་མེད་དང་མ་མཐའ་ཐོགས་མེད་དུ་བསྒྲུབ་པའི་སྒོ་ནས་སྒྲུབ་པར་བྱེད་ལ།",
    "དེ་ལྟ་བུ་རྟག་པ་ལ་མེད་པའི་ཕྱིར་ན་མི་རྟག་པ་ལས་འོས་གཞན་མེད་པར་གྲུབ་ལ།",
    "དེས་ན་སྐྱེ་བ་ཕྱི་མ་ཡོད་པར་གྲུབ་ཅིང་།",
    "སྐྱེས་བུ་འཆི་ཁའི་རྣམ་པར་ཤེས་པ་དེ་རང་འབྲས་རིག་པ་ཕྱི་མ་སྐྱེད་པ་ལ།",
    "དྲོད་ཙམ་མཐར་ཁོལ་བ་ཙམ་དུ་འགྱུར་གྱི་མཐར་ཇི་ཙམ་མེ་བཏང་བ་ལས་ཆུ་ལ་མེ་འབར་བ་ཞེས་སོགས་མི་སྲིད་པའི་ཕྱིར་སྐམས་ནས་མེད་པར་འགྲོ་བས་རྟེན་མི་བརྟན་པ་ཡིན་ནོ།",
    "གོམས་ནས་མཐར་རྒྱང་གྲགས་ཙམ་དང་དཔག་ཚད་སོགས་མཆོངས་ནུས་པ་མི་འབྱུང་ཞིང་སླར་ཡང་ལུས་ཀྱི་འབད་རྩོལ་སྐྱར་མ་ལ་མ་ལྟོས་པར་རྒྱང་ངེ་རྒྱང་ངེ་མཆོངས་པ་སོགས་མི་སྲིད་ཅིང་།",
    "མངོན་སུམ་ཉིད་ལེའུ་གཉིས་པའི་ཡན་ལག་ཏུ་ཤེས་པར་བྱ་བའི་ཆེད་ཡིན་ནོ།",
    "དེ་ལྟར་ན་ཐམས་ཅད་མཁྱེན་པ་བསྒྲུབ་པ་རྒྱུ་འགལ་དམིགས་ཀྱི་གཏན་ཚིགས།",
    "ཁྱད་པར་དག་ལྟོས་ཀྱི་རྟགས་དང་།",
    "འོ་ན་ཁྱད་པར་དེ་ལྟ་བུ་དང་ལྡན་པའི་གཏན་ཚིགས་ཀྱི་ངོ་བོ་ནི་གང་།",
    "དེ་ལ་གཞན་གྱི་དམ་བཅའ་ལྟར་སྣང་དང་དེའི་སྒྲུབ་བྱེད་ལྟར་སྣང་སོགས་བཀག་པའི་སྒོ་ནས་ཡང་དག་པའི་ལམ་ལ་འགོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "གཞན་འགོག་པར་མི་ནུས་སོ།",
    "རྟགས་དགོད་པར་བྱེད་ཅིང་།",
    "སྐྱོན་ཅན་འགོད་པར་མི་ལེགས་ཏེ་ཞེས་སྟོན་པ་ལ་སྒྲུབ་ངག་རྣམ་དག་བསྟན་ལ།",
    "ཀུན་སློང་རྣམ་པར་དག་པའི་སྒོ་ནས་འགོག་དགོས་ཀྱི།",
    "འགྲོ་བའི་ཡིད་ཀྱི་ཀུ་མུད་མཚོ་ལ་ཞི་བའི་ཟླ་འོད་ཀུན་མཁྱེན་ཡེ་ཤེས་ཀུན་ལ་ཇི་བཞིན་ཏུ་འཇུག་པ་ཀུན་ནས་སྟེར་བའི་དཔལ་ཡོན་ཅན།",
    "མཁྱེན་བརྩེ་དག་པའི་མཆེ་བ་ཆེས་དཀར་བ།",
    "ཀ་༡ དགོས་པ་ལ་ལོག་པར་རྟོག་པ་དགག་པ།",
    "དགོས་པ་དེ་ལྡན་གྱི་བསྟན་བཅོས་གཅེས་པར་བཟུང་བར་གདམས་པ།",
    "དགོས་པ་ལ་ལོག་པར་རྟོག་པ་དགག་པ་དང་།",
    "ཡུལ་གྱི་ཁྱད་པར་ལ་བལྟོས་ཏེ་དགོས་མེད་ཀྱི་ལོག་རྟོག་དགག་པ་དང་།",
    "དགོས་པ་ཡོད་ཀྱང་དམན་པར་འདོད་པ་དགག་པའོ།",
    "བྱིས་པ་ལ་ནི་བརྟེན་པར་འདོད།",
    "མངོན་དུ་མ་གྱུར་པ་ལ་རྟོག་གེར་བྱས་པའོ།",
    "ནང་རིག་པའི་བསྟན་བཅོས་མ་ཡིན་པར་འདོད་པ་ཡང་མི་འཐད་དེ།",
    "དེ་ཙམ་གྱིས་ནང་རིག་པར་མི་འགྱུར་ན།",
    "རིག་པའི་གནས་ལྔ་ལ་མཁས་པར་མ་བྱས་པར་ཐམས་ཅད་མཁྱེན་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "རིག་པའི་གནས་ལྔ་དག་ལ་བརྩོན་པར་མ་བྱས་ན།",
    "ཅེས་གསུངས་པ་ཡིན་ནོ།",
    "སུན་འབྱིན་པ་སྟོན་པར་བྱེད་པ་ཙམ་གྱི་གཏན་ཚིགས་རིག་པ་ཡིན་པས་ནང་རིག་པའི་བསྟན་བཅོས་མ་ཡིན་པར་འདོད་ན།",
    "ཞེས་གསུངས་པ་ལྟ་བུ་རྣམས་ཀྱིས།",
    "ཞེས་སོགས་གསུངས་པས་མི་སྣང་བ་མ་དམིགས་པའི་རྟགས་གསུངས་ཤིང་།",
    "གཉེན་པོ་སྐྱེས་པ་ནི་སྤང་བྱ་འགགས་པར་བསྟན་པས།",
    "ཡི་གེ་མངས་པར་འགྱུར་པས་མ་བྲིས་སོ།",
    "ལེགས་པར་བརྟགས་ལ་ང་ཡི་བཀའ།",
