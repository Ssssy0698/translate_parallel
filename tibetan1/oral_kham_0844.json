    "འདུག་བཟོད་ཡོད་ན་སྡོད།",
    "ཞེ་སྡང་རང་གཟུགས་ཧོར་བློན་ལ།",
    "སྒྲོམ་བུ་གར་པས་གར་འཆམས་འོང་བས་ལྟོས་ཟེར་བ་དང་ལྷན་དུ་དཔའ་བཟང་ཤན་པ་རྨེ་རུ་དེ་སྔར་ཧོར་རྒྱལ་བློན་རྣམས་ཀྱི་ལྷན་དུ་མ་འོངས་ནས་ཁོ་རང་གཅིག་པུ་རྗེས་ནས་ཁྲབ་རྨོག་གྱོན་འཁོར་གསུམ་བསྐོར།",
    "ཤེས་ཆེན་ཟེར་བ་དེ་འདྲ་ལོས་ཡིན།",
    "མི་སྤྲུལ་དགུ་རུ་སྤྲུལ་འདུག་ཟེར།",
    "གར་གནས་འདིར་འོང་མི་འདུག་ཟེར།",
    "ཇོ་རུར་དེ་བྱས་མི་འདུག་ཟེར།",
    "ཁོ་མེད་དུས་བསམ་པ་འགྲུབ་ལེ་ཡིན་ད་ཁྱེད་མཁར་དུ་བྱོན་གུར་རྗེ་དང་འཇལ་འཕྲད་མཛོད་ཟེར་བ་ལས་ང་འགྲོ་བའི་ལོང་ཁོམ་མི་འདུག།",
    "ཁྱེད་མི་གསུམ་འོང་ལེ་མ་བཟང་གདའ།",
    "རྐང་བྲེལ་ལེ་དོན་ཆེན་ཡོད་འདུག་ཟེར།",
    "མི་འདུག་འཛོམ་པ་འགྲོ་རྒྱུ་ཡིན།",
    "འཛོམ་པ་བྲག་ལ་བྲོས་སྤྲེའུ་ནག་ལ་བྲོས་པས་མི་འདུག་ཟེར་མ་རྙེད།",
    "འོ་ད་ལེགས་འདུག་བསང་ཤིང་འདི་ཚོ་མཐའ་སྐོར་དུ་སྤུངས་ལ་ཞོག།",
    "གཡག་རྒོད་ཧར་ཞོག་ཀྱི་ལེ་ཁ་བ་འབབ་འབབ་བུ་ཡུག་འཚུབ་པ་ལྟར་བྱུང་སྟེ་ཤོ་སྔོན་མ་ཚུགས་བབ་སྒར་བརྒྱབ་ཚར་དུས་རྗེས་མ་ད་རུང་གཡག་ལའི་ལ་མགོ་ནས་འོང་འདུག་པ་ཞིག་ཐོན་ཏེ།",
    "རྩྭ་ཟ་ལུགས་དང་བསྟུན་ནས་རྩྭ་རིན་བསྙོགས་ན་ལོས་ཡིན།",
    "ཤན་པ་མི་ཆུང་གཉིས་ནི་སྔར་ནས་བྲོས་ཏེ་ཐོན་ཚར་འདུག།",
    "གོ་བོ་ལྡིང་སྐོར་ཀྱི་ལེ་འདུག།",
    "རི་ངོ་དེ་ནས་ཁོང་རྣམས་ནས་ཅི་བྱ་མ་རྙེད་དེ་ཚུར་ལོག་པར་གདའོ།",
    "འཁོར་གསུམ་བསྐོར་དམར་རྐྱང་ཁ་ལ་མེ་འབར་ལ་ཞོན་ནས་འོང་བ་དང་ཁོང་གཉིས་ལམ་དུ་འཕྲད་པས་བསྡོང་ནས་བྱོན་ཏེ་སྒར་ཤུལ་དེར་ཐོན་པ་དང་ཤ་རོའི་ཕུང་པོ་ཆེན་པོ་ཞིག་འདུག།",
    "འོན་ཀྱང་ཁོ་རང་རང་བསམ་ལྟར་བྱེད་མི་འཇུག་གསུངས་པས།",
    "ཧོར་གྱི་བེ་ཐུལ་ཡ་མེད་འཆང་ལྷ་རྒོད་པོ་དེས་རྟ་སེང་གེ་རྩལ་ལྡན་གྱི་སྟེང་དུ་དབུ་དེ་བཀལ་ཁོ་རྟ་གྲོ་དཀར་འགྲོས་ཆེན་ལ་ཞོན་ཏེ་བཟུར་འདུག་ཞིག་བྱས་ནས་གླུ་འདི་བླངས་སོ།",
    "ང་རྒྱལ་པོ་སྟོབས་འབྱོར་ཅན་ལ་གྲི་རྣོ་ངར་འཛོམ་པ་ཞིག་དགོས་འདུག།",
    "དེ་ནས་ཡང་གུར་དཀར་ནས་ཚ་བོ་ཐང་རྙེད་འདི་ལག་རྩལ་ཅན་ཞིག་འདུག་པས་མཁར་གྱི་ཡང་ཐོག་ཏུ་གསེར་འཕྲུ་ཞིག་རྡུང་དགོས་སྙམས་ནས་ཕྱིར་ནང་ཡང་།",
    "ཕུང་འདྲེ་གུར་དཀར་རྒྱལ་པོ་དེས་སྟག་ཐུལ་མགོ་མཇུག་སློག་ཏེ་གྱོན་ནས་ཉལ་འདུག།",
    "སོ་ཁ་མེ་ལྕེ་འབར་འདྲ་འདུག།",
    "དེ་རིང་རྣོ་ངར་ཅི་འདུག་ལྟོས།",
    "ཞེ་སྐྱོ་བས་དུས་ཀྱང་རང་སྡུག་ཡིན།",
    "ཡ་རོ་སྡུག་ཁོ་ཐོན་ནས་ཨ་གནམ་ནི་བཀྲོངས་ཚར་འདུག་ངོ་ཞིག་མ་ཐུག་ཕ་ཕོ་ཟེར་ཏེ་བྲང་ལ་ཁུ་ཚུར་བརྒྱབ།",
    "ཕྱིའི་སྒོ་ལྕགས་བསྡམས་ནས་ཞག་འགའ་བཟང་བཙོན་དུ་བཞག་དེ་ཡི་ཕྱིར་ནང་མཁར་ལ་འཇའ་འོད་འཁྱིལ་ཞིང་འདུག་པས་སྟོབས་ཆེན་གྱི་བསམ་པར།",
    "གཡུ་འབྲུག་༥གློག་ཁྲིད་ང་རང་ཡིན།",
    "ལག་དམར་སྟོབས་ཆེན་ང་རང་ཡིན།",
    "བདེན་ཞེན་འཁྲུལ་པའི་རུ་ཏྲ་དེ་རིགས་དྲུག་རྒྱུད་ལྔའི་གཡང་སར་མི་གཏོང་བའི་ཐུགས་བསྐྱེད་ཁྱད་པར་ཅན་གྲུབ་པར་གདའོ།",
    "ད་ང་རང་བྲོས་པས་མི་ཐར་འཐབ་པས་མི་འོང་།",
    "ངོ་མ་ཤེས་ཐ་མ་རོང་ཚར་འདུག།",
    "ལས་ཆགས་ཕྱི་གཡོག་ལ་ང་རང་རྒྱུག།",
    "གཞི་འདུག་དགྲ་མེད་ལོངས་སྤྱོད་འཕེལ།",
    "སྐྱིད་པའི་ཉི་མ་ཤར་ཏེ་བཞུགས་པར་གདའ་ལགས་སོ།",
    "ཨོཾ་རུ་རུ་སཕུ་རུ་ཛྭ་ལ་ཏི་ཋཥ་སིདྡྷ་ལོ་ཙ་ན་སརྦ་ཨ་ཐར་སཱ་དྷ་ནི་སྭཱཧཱ།",
    "རང་རང་ཇི་ལྟར་འོས་པའི་གདན་ཁྲི་ལ།",
    "བརྟེན་ནས་འགྲོ་འདུག་སྤྱོད་ལམ་སྨྲ་བརྗོད་སོགས།",
    "རྣམ་པ་རང་རང་གནས་སུ་གཤེགས།",
    "དབེན་པའི་གནས་སུ་སྟན་བདེ་བ་ལ་འདུག་ནས་རྐང་པའི་མཐིལ་གཉིས་སྤྲད།",
    "དབེན་པའི་གནས་སུ་སྟན་བདེ་བ་ལ་འདུགནས་རྐང་པསིལ་ཀྲུང་བཅའ་ལག་པ་གཉིས་ཁུ་ཚུར་བཅ་ལ་སྐྱེལ་ཀྲུང་གཏད།",
    "གླང་ཆེན་ལྟ་བུའི་འདུག་སྟངས་ཀྱིས།",
    "དྲང་སྲོང་ཙོག་བུའི་འདུག་སྟངས་ཀྱིས་གནས་པའི་སྒོམ་ཐག་སྦྱར།",
    "ཅེས་པ་དང་རང་ལུས་ཕྲུ་མ་ཕུས་བཏབ་པ་ལྷ་སྐུའི་སྟོང་བསྒོམ་ལ་།",
    "དངོས་པོ་གཅིག་ཀྱང་མི་འདུག་སྙམ་པ་དང་།",
    "ནང་ཚང་ཅན་གྱི་གདན་ལ་འདུག་ཏེ།",
    "དཔེར་ནགསོད་སརའཁྲིད་པའི་དུད་འགྲོ་བཞིན་ལོ་ཟླ་ཞག་དུས་ཀྱི་གོམ་པ་གཅིག་འདོར་གཉིས་འདོར་ཚེ་ཡི་ཚད་ཇི་ཙམ་ཡོད་པ་དེ་འཛད་ནས་འཆི་བར་ཇིང་འགྲོ་བ་བཞིནནོ།",
    "ཇི་ལྟརབདགཉིད་བདེ་བར་འདུག།",
    "འགྲོ་འདུག་སྐབས་གཡང་ལ་ལྷུང་བ་ལྟ་བུའི་སྡུག་བསྔལ།",
    "མི་སྡིག་ཅན་འཆི་བ་མཐོང་ཙ་ན།",
    "མི་འབྲལ་འདུག་པར་འདོདཀྱང་འགྲོ་བར་ངེས།",
    "འགྲོ་བ་ཀུན་གྱི་ཐོད་དུ་བཀུར་བ་སོགས་དགེ་མཚནགྱི་རྟགས་ཉམས་དང་རྨི་ལམ་དངས་སོགས་གང་ལའང་རང་ཡིད་ཆེས་པའོ།",
    "བེ་རོ་ཙ་ན།",
    "སྙན་གྲགས་ཀུན་བཟང་རང་གྲོལ།",
    "རང་རང་རིགས་མཐུན་འཁོར་ཚོགས་དུང་འབུམ་དང་།",
    "ལས་ཅན་གྱི་གང་ཟག་རྣམས་དུག་གསུམ་སྐུ་གསུམ་དུ་གྲོལ་བའི་ཡིན་འདུག་སྙམ་པའི་གདེང་རྙེད་ན་སྦྱངས་འབྲས་ཟབ།",
    "དེ་ལྟར་རྡོ་རྗེའི་འདུག་སྟངས་ཡུན་། བསྲིང་བས་ལུས་འདར་བ་དང་།",
    "དེ་ནས་ཡེ་ཤེས་ལྷུན་གྲུབ་ལ་ཐིམ་པས་འོད་གསལ་ཕྱི་སྣང་བ་དེ་དག་དབྱིངས་སུ་ཐིམ་ནས་སྟོང་གསལནམ་མཁའ་ལྟ་བུའི་ངང་ལས་འཁོར་འདས་ཀྱི་སྣང་བ་ཐམས་ཅད་སྐད་ཅིག་ལ་གསལ་ཞིང་རང་སྣང་ལ་སྒྲོ་འདོགཆོད་པསགདོད་མའི་དབྱིངས་སུ་གྲོལ་བར་འགྱུར་རོ",
    "མིག་ཁྲོ་བོའི་སྤྱན་ལྟར་ཁྲ་ཧྲིག་གེ་འདུག་པ་དང་།",
    "བེམ་སྟོང་མིན་ཀྱང་རང་བཞིན་གྱི་སྟོང་པ་ནམ་མཁའ་དང་ལྔ།",
    "། ཡེ་ཤེས་དེ་རྣམསཀྱང་གཞན་གང་ནས་མ་བྱུང་རང་ལ་རང་ཆས་སུ་ཆིངས།",
    "ཡང་རང་སྣང་ལྷུན་གྲུབ་ཀྱི་སློབཞི་ལསཤར་སྒོ་དཀར་པོ་ཕྱེ་བའི་སྣང་བ་བྱུང་ན།",
    "ངོ་བོ་གཅིག་ཀྱང་མི་འདུག་སྙམ་པ་དང་།",
    "ནམཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "སློབ་དཔོན་སྟན་བདེ་བར་འདུག་སྟེ་སྔོན་འགྲོ་གཏོར་མར་ཆབ་བྲན།",
    "དངོས་གཞི་ལ་དཀྱིལ་འཁོར་པ་ལ་གསོལ་བ་གདབ་པ་ནི་སློབ་དཔོན་གྱིས་བགྱི་བར་གདའ་སྟེ།",
    "ཁྱེད་རང་རྣམས་ཁྲོ་རྒྱལ་རྟ་མཆོག་རོལ་པ་པདྨ་རཱ་ག་ལྟར་དམར་ཞིང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་གང་།",
    "དེ་ལྟར་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་དང་།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "ལིངྒ་ཕྱག་ལེན་བཞིན་བཤམས་པ་གུ་གུལ་གྱིས་བདུགས་ནས་བཞག་དེའི་ཉེ་བར་འདུག་པ་དང་།",
    "དེའང་བསམ་གཏན་གྱི་འདུག་སྟངས་ཀྱིས་གནས་ལ་སྐྱབས་སུ་འགྲོ་བ་དང་།",
    "ཡིན་ནའང་གང་འདྲ་ཞིག་དགའ་བ་འདུག་གམ།",
    "དེའི་ལན་དུ་གང་ཞིག་གནང་ན་ཡང་མ་འགྲིགས་པ་མི་འདུག་འོན་ཀྱང་གློ་དམག་སྒར་གྱི་སྐོར་ཡིན་ན།",
    "དེའང་རང་ཉིད་དང་ཐད་ཀའི་ལས་དོན་འབྲེལ་ཡོད་རྣམས་བྲིས་ཡོད།་",
    "ཟུར་བཀོད་ཁ་སྐོང་བཅས་བཞིའོ་ཞེས་གསལ་བཀོད་འདུག་པ་ལྟར་རིམ་བཞིན་འགོད་པར་བྱ་བ་ལ།",
    "འཇུ་བརྒྱ་རུ་ཟེར་བ་བཅས་ཡོངས་གྲགས་ཀྱི་གནས་ཚུལ་འདི་རིགས་གསལ་མི་འདུག་ཀྱང་།",
    "ཉག་རྐེད་ཀྱིས་ཡག་རྟགས་མི་འདུག་ཟེར་བའི་གཏམ་བརྗོད་དེ་ཕྱིར་ལོག་དེ་ནས་བཟུང་སྒོ་རུ་དང་།",
    "ཉག་དགྲས་མ་འཚེ་བའི་སྔོན་དུ་དཔལ་ས་སྐྱའི་གོང་མ་ཕྱོགས་ཀྱི་གླང་པོ་ཡང་གདན་ཞུ་ཐུབ་པ་བྱུང་འདུག་དེ་ལྟའི་སྲུང་མའི་ཚོགས་དང་།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་མི་ཚེར་དཔྱད་ན།",
    "འོ་ཞོ་ཚོད་མེད་བསྟེར་རྗེས་ཐོག་ཁ་ནས་དཀྱིལ་གྱི་རྡོ་ཅལ་སྟེང་དུ་གཡུག་དུས།",
    "རྐང་གྲི་མདུང་ཞེས་པ་རྣམས་འཇུ་ཆེན་གྱི་སྒོ་རའི་ནང་ཕར་འགྲོ་ཚུར་ཡོང་གཉིས་ཀའི་སྐབས་ཀྱི་གནས་ཚུལ་དྲན་སོས་ཀྱི་འདུག་དཔེར་ན།",
    "བྲག་འཕྲང་རིན་ཆེན་ཅན་མི་དྲུག་དུས་གཅིག་ལ་སྐེ་བཅད་དེ་བསད།",
    "མཐར་ཕན་ཚུན་དམག་དུས་བཟོས།",
    "ང་རང་རྒྱལ་ན་རྒྱལ་ངེས་ཡིན།",
    "ལྷ་རྒྱལ་གོང་ནས་ལྷུང་བཞིན་མེ་མདའ་ཕྲག་གོང་ནས་སྐོར་བཞིན་ཐང་ལ་ལྷུང་བ་དང་མེ་ར་ས་ལ་བཙུགས་ནས་ཉ་རྔའི་ཐོག་འགྲམ་པ་བཞག་སྟེ་འདས་འདུག་ཟེར།",
    "དང་པོར་མཚོན་མ་ཟུག་ཀྱང་སྐུ་ལུས་སུ་ཐུང་མདའ་ཉི་ཤུ་ཁ་གྲགས་ཅན་པ་བརྒྱབ་པས་སྐུ་གཟུགས་སྟོར་འདུག་ཟེར།",
    "རྒྱལ་སྲས་ཇི་གྱིམ་འཁོར་དང་བཅས་པ་གདན་ས་ས་སྐྱ་རང་དུ་ཕེབས་སྐྱེལ་དུ་མངགས་པར་མཛད་ཅེས་སོགས་བཀོད་འདུག་པ་འདི་དང་འདི་འདྲར་བལྟས་ན།",
    "ཨའུ་ཙམ་འདུག་ན་ངས་ཀྱང་ཞུ་གསུངས།",
    "མི་ཁོ་པ་ལ་ཉེ་གནས་གོ་ཆོད་བྱུང་བས་ལྷ་ཁང་འདི་ལྟ་བུ་བཞེངས་ཐུབ་འདུག་ཅེས་གསུངས་པ་དེ།",
    "ཡུལ་འདི་རང་དུ་བཞུགས་པ་ལས་གཞན་དུ་གདན་དྲངས་ཐུབ་ཀྱི་མེད་སྟབས་ཡུལ་ལ་གྱོང་མེད་པ་ཡོང་བ་འདུག་སྙམ་པའི་གྲོས་མཉམ་པས།",
    "ཡང་སྐབས་ཤིག་ལ་ངའི་རྨི་ལམ་དུ་ཕྱག་ནའི་རིགས་རྒྱུད་ཟེར་བ་གཉིས་ལས་མི་འདུག་ཡེ་ཤེས་འབྱུང་གནས་ཀྱི་རིགས་རྒྱུད་ཡིན་ཟེར་བ་ཤིན་ཏུ་མང་བ་འདུག་པ་ཞིག་རྨིས་ཞེས་གསུངས་པར་གྲགས།",
    "ཕྱིས་སུ་སེང་ངུ་གཡུ་མཚོར་རང་རང་ལས་སྐལ་དང་།",
    "དུས་ཀྱི་འགྱུར་རྟགས་སྣ་ཚོགས་ཤར་གྱི་འདུག་ཟེར།",
    "རང་བྱོན་ངོ་མཚར་ཅན་མང་པོ་མཇལ་རྒྱུ་ཡོད་པ་འཛོམས་ནང་རང་དུ་འགྲོ་ནས་བསྐོར་དགོས་ཤིང་།",
    "བསྟན་དགྲ་གུང་ཁྲན་གྱི་དགོན་ཆུང་འདིའི་ལྷ་ཁང་དང་བཅས་པ་རྩ་གཏོར་བྱས་འདུག་ཀྱང་།",
    "དེ་ཡང་རང་དགྲ་རང་གཤེད་ཡིན།",
    "དེ་ཡང་རང་དགྲ་རང་གཤེད་ཡིན་ཞེས་ཟེར།",
    "རྫ་ཁྲ་ཡག་རིག་དུས་གནའ་གཡག་དྲན།",
    "འདུག་སྐྱིད་མ་སྲུའི་རྩར་ན་ཡོད།",
    "འདུག་དགོས་པ་ཚེ་སྔོན་ལས་ལ་བསྐོས།",
    "འདུག་ཞོར་དུ་གཏོང་ཞིང་།",
    "འཛོམས་བདེ་བའི་ས་ཆ་གང་རུང་ལ་རང་རང་སོ་སོས་མེ་ཤིང་ཁུར་ནས་འདུས།",
    "འགྲོ་འདུག་སྤྱོད་གསུམ་གང་ཅིའི་སྐབས་གཟའ་དང་།",
    "རྒས་པོ་ང་རང་ལོ་༨༢ ཡིན།",
    "ད་དུང་རང་ལོ་༨༢ ཟིན་པའི་རྒས་པོ་བྱང་རིས་བུ་ཚེ་ཟེར་བ་དེས།",
    "ཟེར་བའི་དཔེ་ལྟར་ཡིན་པ་ཧ་གོ་དོན་རྟོགས་ཤིག་ཡོང་དུས་འགྱོད་ཀྱང་ཕྱིས་ཚར་བའི་གནས་ཚུལ་ཞིག་ཡིན་འདུག་དེས་ན་ད་དུང་ཡང་དཔེ་དོན་ཉམས་སུ་མ་བླངས་ན།",
    "གཤམ་མ་ནས་སྤྱང་ཀིས་ར་ལུག་གསོད་ཀྱི་འདུག་གོ་ཞེས་གསུང་སྟེ་ཕེབས།",
    "ར་ལུག་ཚང་མ་རུག་སྟེ་རང་རང་སོ་སོས་ཚང་མིན་བལྟས་པས་ཚང་ནས་ཡོད།",
    "སྒྲོལ་མ་ཉེར་གཅིག་བསླབ་ཀྱི་འདུག་པས།",
    "རྐྱེན་འདས་སུ་གྱུར་འདུག་ཅིང་།",
    "ང་རང་དང་།",
    "ད་ཆ་དྲན་པའི་སྐབས་སུ་རང་ཉིད་ཧ་ཅང་འགྱོད་པ་ཆེན་པོ་སྐྱེ་བཞིན་འདུག་ད་དུང་ཉིན་དེའི་རིང་ཁང་ཆུང་ཞིག་ཏུ་བཅུག་ནས་དེ་ཉིན་ཟ་འཐུང་ཅི་ཡང་སྤྲད་མ་བྱུང་།་",
    "ང་རང་ཡང་མཉམ་དུ་ཤི་བཞག་བསམ་གྱི་ཡོད།",
    "ཕྱི་ལོར་གྱང་ཁང་ཡང་རང་ཡུལ་དུ་ཕྱིར་ལོག་སྟེ་གནས་ཆགས།",
    "ཆེ་ཙམ་ཞིག་ཡོད་པའང་བརྗོད་སྲོལ་འདུག་འོན་ཀྱང་ས་ཆའི་དབྱིབས་ནས་བལྟས་ན།",
    "མདར་སིག་སིག་བྱེད་མཁན་ཡང་འདུག་མཛོ་ཁལ་རྣམས་ཆུ་ལ་གཏོང་དགོས།",
    "ཟངས་ཀྱི་ཞོ་པད་ཁུག་མ་ཞིག་ཁྱིམ་དུ་འདུག་པ་གཅིག་བྱས་ན་ཕན་ཐོགས་པ་ཡོང་སྲིད་སྙམ་སྟེ་ཁྱེར་ཡོད།",
    "མཛོ་ཆུང་ནི་ཐོག་མའི་བཞག་ས་ནས་ཕར་ཙམ་ཕྱིན་ཏེ་ཉལ་ནས་འདུག་ངོས་གཉིས་འཁྲིས་སུ་ཕྱིན་པར་དེ་འཕྲལ་ལང་སྟེ་དགའ་བའི་རྣམ་འགྱུར་གྱིས་མགོ་དཀྲུག་དང་།",
    "འབྲོག་པ་ཁྱེད་རང་སེམས་བཟང་པོ་ཡིན་བཟོ་མཐོང་བས།",
    "ངས་ཁྱེད་རང་ལ་སྟེར་ཆོག་རྗེས་སུ་འདིའི་དོན་དུ་འདི་གར་ཡོང་མི་ཐུབ་ཅེས་རྩྭ་ཆུ་བཟང་བའི་ས་ཆ།",
    "ངའི་སྦྲ་གུར་གང་ཡིན་ཤེས་ཀྱི་འདུག་གམ།",
    "ནང་དུ་འཛུལ་མ་ཐག་པའི་གདུང་མའི་ངོས་ནས་སྦྲུལ་ཆེན་པོའི་པགས་པ་བརྒྱངས་ནས་འདུག་པ།",
    "དེ་བཞིན་གཙུག་ལག་ཁང་དུ་གླང་ཆེན་མཆེ་བ་ཡང་གཅིག་འདུག་ཅིང་།",
    "དབུགས་ཀྱི་རྒྱུ་བ་ཙམ་ལས་མི་འདུག་དེ་ནས་གུར་འབོག་རྣམས་བརྩེགས།",
    "ཕྱི་ཡི་སྐོར་ལམ་དུའང་རང་བྱོན་མང་དུ་ཡོད།",
    "དཀྱིལ་ནས་ཀ་བ་མེད་པ་བརྗོད་སྲོལ་ལྟར་ཡིན་འདུག་པ་དང་།",
    "དེ་ནས་བསམ་ཡས་མཆིམས་ཕུར་གནས་ཀྱི་ལྟེ་བར་གུ་རུའི་སྒྲུབ་ཕུག་ཏུ་བྲག་དམར་ཀེའུ་ཚང་དུ་བེ་རོ་ཙ་ན་དང་།",
    "དབེན་རྩར་རྒྱལ་བ་མཆོག་དབྱངས་ཀྱི་རྟ་མགྲིན་སྒྲུབ་ཕུག་སོགས་ཡོད་འདུག་པར་མཇལ་མ་ཐུབ།",
    "ཇོ་བོ་རྗེའི་གཟིམ་ཕུག་ཏུ་འདྲ་སྐུ་བྱིན་ཅན་བཅས་ཡོད་འདུག་ཀྱང་མཇལ་མ་ཐུབ།",
    "ངོས་རང་ནས་རབ་བྱུང་རང་དགོན་ནས་ཞུས་ཟིན་སྟབས་བསྐྱར་ཞུ་མི་དགོས།",
    "གསང་མདར་ལོ་ཙཱ་བ་བློ་ལྡན་ཤེས་རབ་ཀྱི་སྐུ་གདུང་བཞུགས་སའི་ཁང་ཆུང་སོགས་ཡོད་འདུག་ཀྱང་མཇལ་མ་ཐུབ།",
    "མཚུར་ཕུ་དང་ཉེ་བར་གནས་གནང་དཔའ་བོའི་གདན་སར་ཞྭ་དམར་གྲགས་པ་སེང་གེའི་སྐུ་གདུང་སོགས་ཡོད་འདུག་ཀྱང་འདི་དག་མཇལ་མ་ཐུབ།",
    "གངས་ཡོད་མེད་ཀྱི་མཚམས་དེར་སྐྱེས་དམན་ཞིག་ཤི་ནས་རོ་དམར་ཧྲེང་དུ་འདུག་རྟ་དྲེལ་མང་པོ་གངས་ཀྱི་ནང་དུ་ཤི་འདུག་ནུབ་གངས་ལ་བརྒལ་ཏེ་རྔད་གྲོང་རྐེད་དུ་སླེབས།",
    "བློ་བདེ་བག་ཕེབས་ཀྱི་བདེ་སྐྱིད་དངོས་ནི་དེ་དུས་ཡིན་འདུག་བསམ་པ་དྲན་གྱི་འདུག་ཡུལ་ལྷ་གསོལ་བའི་སྐོར།",
    "སྐུ་ཕུང་རང་བཞིན་མེར་སྲེག་བྱས་ན་ཡུལ་ལྷ་གཞི་བདག་ལ་སོགས་པར་ཕོག་ཐུག་འགྲོ་ཉེན་ངོས་འཛིན་དང་།",
    "ཞག་དུས་བགོས་ཏེ་སོག་པོའི་གྱད་མི་བརྒྱད་དང་བསྡུར་ཚད་བྱེད་དུ་བཅུག།",
    "སྒམ་ཆེན་ཧ་ཁྲ་ཟེར་བའི་ཡུལ་ལྷ་རྫ་རི་མཐོན་པོ་དེས་དགུན་ཁའི་ཉི་མ་སྒྲིབ་ཀྱིས་འདུག་པར།",
    "གཅིག་འདས་གྲོངས་སུ་གྱུར་འདུག་པ་དང་།",
    "མ་འོངས་མི་རྒྱུད་ཉེ་ངོ་མི་འཕྲོད་པ་ཡོངས་དོགས་མེད་འདུག་པར།",
    "ཕྱི་ལོ་༡༩༥༩ ལོའི་ཟླ་གཉིས་པའི་ནང་རང་ལོ་༢༩ ཐོག་ནག་ཆུ་ནས་ལྷ་སར་སླེབས།",
    "འཕྲོས་རྣམས་ཕྱི་ལོ་༡༩༦ ཟླ་༡༡ པའི་ནང་རང་ལོ་༣༡ ཐོག་ལྷོ་ཕྱོགས་མའི་སོར་སྦེལ་ཀོབ་གཞིས་ཆགས་དང་པོའི་གྲས་སུ་བསྐྱོད་དེ་ས་རྡོ་བརྐོ་སློག་ཤིང་གཅོད་ལམ་བཟོ་བཅས་བྱེད་དགོས་པའི་བཅུ་དཔོན་ཞིག་བྱས།",
    "འཇིག་རྟེན་སྲིད་པའི་བྱས་བྱུང་རང་དང་འབྲེལ་ཡོད་སེམས་ལ་དྲན་ཚོད་ནི་འབྲི་ཚོད་མེད་པ་དང་།",
    "ཕྱི་ལོ་༡༩༩༥ ལོར་མཇལ་ཞུས་སྐབས་རྗེས་ལོར་ཕྱིན་ན་ཐུགས་བརྟག་ལེགས་པ་འདུག་ཅེས་བཀའ་འཁྲོལ་སྩལ་བར་བརྟེན་ལག་འཁྱེར་ཐོབ་ན་བསྐྱོད་རྒྱུའི་གཏན་འཁེལ་བྱས།་",
    "དེ་མ་ཐག་གཞུང་ཚབ་ཁང་ནས་ཁྱེད་རང་འཁོར་ཞག་གདན་ཞུ་གནང་མཁན་ནི།",
    "གྲུབ་པ་བརྙེས་ཏེ་གནམ་ལ་འཕུར་ནའང་འཇུ་ཆེན་ཐུབ་བསྟན་གྱིས་འཇའ་དྷུ་མིག་འཕྲུལ་བསྟན་གྱི་འདུག་ཟེར་ཡོང་།",
    "རྒྱ་རིགས་ལས་བྱ་གཉིས་བཅས་སྣེ་བསུར་སླེབས་འདུག་པར་ངོ་སྤྲོད་དང་།",
    "འགོ་ཁྲིད་ཅིག་ཡོད་སྐད་འདུག་ཀྱང་མཐོང་སར་མེད།",
    "གནས་སྟངས་འདི་འདྲའི་འོག་ཏུ་བསྡད་དགོས་པ་དེ་ཚོ་སྔོན་གྱི་ལས་འབྲས་ཤིག་ལོས་ཡིན།",
    "འོག་མིན་མཚུར་གྱི་གདན་སར་ལས་དོན་རུ་ཁག་འབྱོར་མི་འདུག་པར།",
    "བུམ་སྒྲུབ་ལྷ་ཁང་བཅས་གསར་བཞེངས་ཐུབ་འདུག་པ་དང་།",
    "གྲྭ་ཤག་ཕྱེད་ཆ་ཙམ་ས་སྟོང་དུ་གནས་འདུག་པས་སེམས་སྐྱོ་སྣང་ཅི་ཆེར་གྱུར།",
    "དེ་རྗེས་བཅིངས་འགྲོལ་དམག་དཔུང་འབྱོར་ཏེ་བཙན་གནོན་བྱས་འདུག་ཕྲན་ལའང་ཆབ་སྲིད་ཀྱི་ནག་ཞྭ་གཡོག་ཡོད་པ་རྗེས་སོར་གོ་ཤེས་བྱུང་།",
    "མཐའ་མར་རྒྱ་ནག་པེ་ཅིང་བར་གྱོད་འཛོམས་བྱ་དགོས་གྱུར་འདུག་སྔར་གྱི་རྫོགས་ཆེན་དགོན་ཤུལ་ཕྱེད་ཙམ་ཁང་པ་བསྐྱར་གསོ་ཐུབ་པ་ཞིབ་མཇལ་དང་།",
    "ཁྱེད་རང་ནས་ཀྲུང་དབྱང་ལ་དགོངས་འཆར་གསུང་དགོས་ཡོད་པའི་ལན་འབྱོར་ཡོད།",
    "དེ་རིང་ཁྱེད་རང་ལ་གང་གསུང་དགོས་ཡོད་ན་ང་ལ་གསུང་རོགས།",
    "ལོག་སྤྱོད་པ་ཟེར་བ་སོགས་ཡོངས་སུ་བསྒྲགས་འདུག་པ་མ་ཟད།",
    "ཁྱེད་རང་མ་ཕེབས་ཙམ་དེར།",
    "ཕྱི་ཉིན་འཐབ་ཕྱོགས་གཅིག་གྱུར་གྱི་ཚོགས་ཁང་ཆེན་པོར་སྣེ་ལེན་ཐོག་ལྷན་འཛོམས་སར་མི་གྲངས་༡༩ ཙམ་འདུག་པུའུ་ཀྲང་ངམ།",
    "ས་ཡ་བཞི་ཙམ་ལས་མེད་པ་ཡིན་འདུག་ཟེར།",
    "ཁྱེད་རང་ནས་ཀྱང་དགོངས་པ་བཞེས་དགོས།",
    "ཁྱེད་རང་གཏོང་ནའང་འགྲིགས།",
    "དེ་ཉིན་གླིས་ཙོ་མིན་ཡང་མཉམ་དུ་འདུག་པར།",
    "ལྟ་རྟོག་གནང་མཁན་ཡོད་བཟོ་འདུག་ཀྱང་བླ་གྲྭའི་རིགས་མེད་པ་འདྲ།",
    "འགྲོ་ལམ་བཟོས་འདུག་སོག་པོ་དང་།",
    "མཐོང་ཚུལ་ཡིག་ཐོག་དེབ་བཀོད་བྱེད་སྲོལ་འདུག་པ་ལྟར་བྱས།",
    "ལྷ་སར་ང་རང་ལ་ཁང་པ་ཞིག་ཡོད་དགོས་ཀྱི་འདུག་ཅེས་འདྲི་རྩད་བྱས།",
    "ཁྱེད་རང་ནས་ཀྲུང་དབྱང་དང་།",
    "ཉེ་ཆར་ཁྱེད་རང་མ་ཡོང་པའི་སྔོན་ཙམ་དེར།",
    "དེར་མ་ཟད་༡༩༨༤ ལོར་ཁྱེད་རང་སྐད་བསྒྱུར་ཡིན།",
    "ཁྱེད་རང་ནས་ཀྱང་དགོངས་པ་བཞེས་དགོས།",
    "ཁྱེད་རང་གཏོང་ནའང་འགྲིགས།",
    "ཡང་ན་ཧོང་ཀོང་རྩིས་ལེན་ཉེར་ཡོད་པ་བཅས་ས་གནས་དེ་ཕྱོགས་སུ་ཆ་རྐྱེན་ཚང་ཐབས་འབད་རྩོལ་བྱས་ན་ཇི་འདྲ་ཡོད་དམ་སྙམ་པ་འདུག་ཅེས་བརྗོད་པར།",
    "ཨ་ཁ་ཕམ་པ་ལ་དོན་མེད་རྙོག་གྲ་ཆེད་བཟོ་བྱུང་འདུག་སྙམ་པའི་འགྱོད་པ་ཆེན་པོ་བྱུང་།",
    "སྐད་སྒྱུར་བཅས་མི་གྲངས་༧ འདུག་ཕྱི་ལོ་༡༩༩༨ ཟླ་༣ ཚེས་༢༧།",
    "རྒྱ་མི་ཁོ་ཚོས་ཐུབ་བསྟན་ལ་བརྡ་ལན་དེ་འདྲ་ཞིག་འབྱོར་འདུག་ཅིང་།",
    "ཕྲན་གྱིས་ལག་འཁྱེར་བཟོ་རྒྱུར་དཀའ་ངལ་དུས་འགྱངས་བྱེད་འདུག་པར།",
    "ཁྱེད་རང་ལ་ལན་གསལ་རྗེས་ལུས་མེད་པར་སྤྲད་ཡོད་ཀྱང་།",
    "སྐུ་ཞབས་ལི་ཁྱེད་རང་ནས་མཁྱེན་གསལ་ཡིན།",
    "ཁོང་རང་དང་ཀྲུང་དབྱང་ཆབ་སྲིད་ཅུས་ཀྱི་དཔོན་པོ་མི་གཉིས་དང་།",
    "བཀའ་ཡིག་གནང་བའི་ཕྱིར་ལན་འབུལ་རྒྱུ་ཞུས་འདུག།",
    "ཁྱེད་རང་རྣམ་པར་ཕྲན་གྱིས་སྔ་རྗེས་སུ་བརྗོད་མྱོང་བ་ནི།",
    "༩༦ ལོ་ནས་ཁྱེད་རང་ལ་གཞུང་འབྲེལ་དང་།",
    "ཁྱེད་རང་རྣམ་པས་དོན་དངོས་ཐོག་དགོངས་ཟབ་གནང་དགོས་པ་ལས།",
    "འདི་སྐོར་གསལ་པོ་ཞིག་བྱུང་ན་ཡག་པོ་འདུག་ཅེས་ཟེར།་",
    "ཁྱེད་རང་རྣམ་པར་བཀའ་འདྲི་ཞུ་རྒྱུ་ཞིག་ལ།",
    "ད་ཆ་རིམ་བཞིན་དབྱེ་བ་ཆོད་དེ་ཕན་ཚུན་སོ་སོར་ཆགས་དུས་རྙོག་གྲའི་རྣོ་ངར་ཆུང་དུ་ཕྱིན་པ་ཡིན་འགྲོ།",
    "བར་ཟས་གྲོན་བརླག་རྒྱ་ཆེ་ཆུང་ཇི་འདྲ་ཡིན་མིན་གསུང་ན་གང་འདྲ་འདུག་ཟེར།་",
    "ཁུངས་རྩད་མི་ཐུབ་པ་རང་མི་འདུག་སྟེ།",
    "རོགས་དངུལ་ཁག་བཅས་ཀྱི་ཐོག་ནས་དངུལ་འབོར་ཕོན་ཆེ་གྲོན་བརླག་བྱུང་བ་ཡོད་འདུག་ཅེས་ཡོང་སྟངས་ཁ་ཤས་འགྲེལ་བརྗོད་བྱས།",
    "གསང་བའི་འབྲེལ་བ་འདི་མུར་ཕར་ཙམ་ཕྱིན་ན་ལེགས།",
    "གནས་སྐབས་རིང་གསང་བར་བསྡད་ན་ཡག་པོ་འདུག་གསང་བའི་ཐོག་འབྲེལ་བ་བྱ་རྒྱུ་གལ་ཆེན་པོ་ཡིན་ཟེར།",
    "གལ་ཏེ་ཐའེ་ཝན་གྱིས་ཟུར་གྱེས་ཀྱི་བྱ་སྤྱོད་སྤེལ་ན་ཀྲུང་དབྱང་ནས་དྲག་སྤྱོད་བྱ་རྒྱུ་ལས་མེད་སྐོར་སྙན་སེང་ཞུ་གལ་བརྗོད་འདུག་གུས་པས་མཇལ་བཅར་ཞུས་ཐོབ་ལྟར།",
    "ཧོང་ཀོང་ནས་སླར་བལ་ཡུལ་དུ་ཕྱིར་ལོག་བྱ་རྒྱུའི་ཐད་ལ་ཕྲན་བུའི་དཀའ་ངལ་འདུག་རུང་འབད་རྩོལ་བྱ་མུས་ཡིན་ཀྱང་།",
    "ལན་གསལ་ཞིག་ཡོང་རྒྱུ་ཡིན་ལུགས་བརྗོད་འདུག་ཅེས་ཟེར།",
    "ཐུབ་བསྟན་རྣམ་རྒྱལ་ཁྱེད་རང་ཕྱིས་འབྱུང་པེ་ཅིང་དང་།",
    "གསལ་པོ་བཟོ་ཐུབ་པའི་རྣམ་འགྱུར་བསྟན་གྱི་མི་འདུག་ཝང་ཤོན་ཧྲན་ནས།",
    "ཁྱེད་རང་ནས་ཀྱང་བཀའ་ལན་ཡོད་པ་བྱ་ཡི་ཡིན་གནས་གསུངས་ཡོད།",
    "ཁྱེད་རང་རྣམ་པས་མཁྱེན་གསལ་ཡིན།",
    "མ་ཕེབས་ན་ཡག་པོ་འདུག་ཅེས་བརྗོད་བྱུང་།",
    "ཨ་རི་སོགས་རྒྱལ་ཁབ་མང་པོའི་ནང་རྒྱ་མི་རིགས་གྲངས་མང་ཡོད་པ་རྣམས་ལ་མཐུན་འབྲེལ་གང་ཐུབ་དུས་རྟག་ཏུ་བྱ་ཡི་ཡོད་པའི་སྐོར་འགྲེལ་བརྗོད་གསལ་པོ་གྱིས་ཞེས་བཀའ་མངགས་ཕེབས་འདུག་ཁྱེད་རང་རྣམ་པས་ཐུགས་དོགས་རྩ་བ་ནས་གནང་དགོས་པ་མེད་ཅེས་སོགས་འགྲེལ་བརྗོད་བྱས་པར།",
    "ཐུབ་བསྟན་རྣམ་རྒྱལ་ཁྱེད་རང་ནས་བསམ་བློའི་འགན་ཁུར་ཡག་པོ་བྱས་ཡོད།",
    "ཁྱེད་རང་རྣམ་པས་ངོས་འཛིན་ཆ་འཇོག་སྣེ་གཅིག་མི་མཛད་པར།",
    "ཁྱེད་རང་ལ་གསལ་པོའི་ངང་ནས་ཞུས་ཡོད།",
    "ཁྱེད་རང་རྣམ་པའི་གསུང་ཕྱོགས་ལྟར་བྱས་ན།",
    "ད་ཆ་གང་འདྲ་ཞིག་བྱེད་མིན་ཁྱེད་རང་རྣམ་པའི་ཕྱག་ཏུ་ཡོད་པ་ལས་ངོས་ནས་ཨུ་ཚུགས་བྱ་རྒྱུ་ཅི་ཡང་མེད།",
    "ཕུགས་རྩ་གཙོ་བོ་ཨ་རིའི་དགོས་མཁོ་རང་ཡིན་པ་ངོས་འཛིན་བྱ་རྒྱུ་ལས་གཞན་མེད།",
    "མཚམས་དེར་ཝང་ཤོན་ཧྲན་ནས་ཅི་ཡང་མི་ཟེར་ནས་ཡུད་ཙམ་བསྡད་འདུག་མུ་མཐུད་དེ་ཕྲན་ནས།",
    "ཁྱེད་རང་ལ་ཕྲན་གྱིས་སྔ་ལོར་རྒྱལ་བ་ཀརྨ་པ་ཡང་ན་རྒྱ་གར་ནང་ཚུར་ཕེབས་ཐུབ་པ་གནང་གལ་དང་།"
  ]
