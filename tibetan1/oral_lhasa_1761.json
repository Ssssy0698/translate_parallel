    "ཁྱད་པར་གྱི་འདོད་པ་སྐྱེད་བྱེད་རྐྱེན་བཞི།",
    "རྒྱུ་རྐྱེན་འབྲས་བུ་ལ་ཕན་འདོགས་པར་ནུས་རུང་ཙམ་སྟེ་ངོ་བོ་སྐྱེད་པ།",
    "བདག་རྐྱེན་གེགས་མི་བྱེད་པ་ཙམ་སྟེ་འབྲས་བུའི་ཁྱད་པར་སྐྱེད་པ།",
    "བུམ་སྣང་དང་གོ་ས་ཐ་མི་དད་པར་ལྐོག་ན་ཡོད་དེ།",
    "འོན་ཀྱང་འདིས་བྲལ་བའི་རྫས་སོ་སོ་བར་ཡོད་པར་མི་འདོད་དོ།",
    "ཡང་དག་པའི་དོན་དམིགས་པར་བྱས་ནས།",
    "གཟུང་བ་རང་བཞིན་མེད་པར་ཤེས་པས་བདག་མེད་ཕྱེད་གཉིས་རྟོགས་པ་དང་།",
    "དེ་ཡང་སྐྱེ་བ་ལས་བྱུང་བ་སོགས་མ་རིག་པའི་བར་དུ་ཤེས་ཤིང་མ་རིག་པ་དེ་ནི་བདག་མེད་རྟོགས་པའི་ཤེས་རབ་ཀྱིས་སྤང་བར་རིག་ནས་ལམ་རང་རྒྱུད་ལ་བརྟེན་པར་བྱེད་དེ།",
    "གཟུང་བ་མེད་ན་དེ་འཛིན་ཡང་བདེན་པར་མེད་དེ་མགོ་མཉམ་པའི་ཕྱིར་དང་།",
    "དོན་དམ་པར་དབེན་མི་དབེན་མེད་པའི་ཕྱིར་དང་།",
    "ཁྱད་པར་རྣམ་བདེན་རྫུན་གྱི་ཚུལ་གཉིས་སུ་ཡོད་པ་ལས།",
    "མི་ལྡན་པའི་འདུ་བྱེད་ཉེར་གསུམ་པོ་གནས་སྐབས་ལ་བཏགས་པའི་བཏགས་ཡོད་ཙམ་སྟེ་རྫས་སུ་མེད་པར་འདོད།",
    "འདུས་མ་བྱས་གསུམ་གྱི་སྟེང་དུ།",
    "རྒྱུ་རྐྱེན་གྱིས་མ་བྱས་པ་བདག་མེད་པའི་དེ་བཞིན་ཉིད་དང་།",
    "ཀུན་བཏགས་ཀུན་རྫོབ་ཀྱི་བདེན་པར་འདོད་དོ།",
    "ཤེས་པ་རང་གསལ་ཙམ་ནི་འཁོར་འདས་ཀྱི་གཞིར་ཡོད་པས་དེ་དགག་པ་མིན་པས་ན་རྒྱལ་བའི་དགོངས་པ་མཐར་ཐུག་སེམས་ཙམ་གྱི་ཚུལ་འདི་ལས་གཞན་དུ་མེད་པར་འདོད།",
    "གྲུབ་པའི་མཐའ་དེ་དག་ལ་བརྟགས་ན་ཕྱི་དོན་བདེན་པ་མེད་པར་གྲུབ་ཀྱང་།",
    "གཟུང་ཆར་སྣང་བ་དང་འཛིན་ཆར་སྣང་བའི་ཤེས་པ་ཐ་དད་དེ་སྒོ་ང་བཙོས་པ་སྐམ་དུས་སེར་པོ་དང་དཀར་པོ་ཐ་དད་དུ་ཡོད་པ་ལྟར་སྔོ་སྣང་དང་སྔོ་འཛིན་གྱི་ཤེས་པ་ཐད་ཀར་ཆ་གཉིས་སུ་བདེན་པར་འཛིན་པས་སྒོ་ང་ཕྱེད་ཚལ་པའང་ཟེར་རོ།",
    "པས་རྣམ་པ་གཉིས་ཤེས་པ་གཅིག་ལ་སྣང་མི་སྲིད་པར་འདོད་པའོ།",
    "དེ་ལ་གསལ་ཞིང་རིག་པའི་རྟགས་ཀྱིས་ཕྱི་དོན་ཤེས་པར་བསྒྲུབ་ཚེ་རིག་བྱའི་དངོས་པོ་རང་དང་།",
    "རིག་པར་བྱ་བ་ཡིན་པ་ཙམ་གྱི་ཕྱི་དོན་ཡོད་པ་ལའང་འཇུག་པས་ཐེ་ཚོམ་དང་བཅས་ལ།",
    "དེ་ལ་ཕྱི་དོན་རྫུན་པར་གྲུབ་ཀྱང་།",
    "བདེན་པའི་ཤེས་པ་དང་གཅིག་པར་མི་གྲུབ་སྟེ།",
    "དེས་ན་ཇི་ལྟར་སྣང་བ་བཞིན་ཐ་སྙད་བྱེད་པ་ལས་གཞན་དུ་རྣམ་པར་བཞག་ན་སྐྱོན་གཞན་ཡང་།",
    "སེམས་རྣམ་པ་ཀུན་དང་བྲལ་བ་ཅི་ཡང་མི་རྟོག་པར་མྱོང་བ་རང་ཙ་",
    "དོན་མཛད་པར་སྣང་བ་གཟུགས་སྐུའོ་ཞེས་འདོད་དོ།",
    "དོན་དམ་པར་རང་རིག་པའང་མི་འགྲུབ་ལ།",
    "ཐ་སྙད་དུ་མེད་པའི་སྤྲོས་པ་དག་རབ་ཏུ་འགོག་པར་བྱེད་ཅིང་།",
    "རང་བཞིན་ལ་རྟག་ཏུ་མཉམ་པར་བཞག་བཞིན།",
    "དོན་དམ་པར་ཅིར་ཡང་མ་གྲུབ་པའི་ཕྱིར་སྒྱུ་མ་ཞེས་དམིགས་སུ་མེད་དེ།",
    "དོན་བྱེད་པར་སྣང་ཞིང་བདེན་པའི་ཕྱིར།",
    "དོན་དམ་པར་དཔྱད་ན་ཅི་ཡང་མི་རྙེད་པའི་ཕྱིར་སྟོང་པའོ།",
    "དཔེར་ན་དགྲ་ལ་ཞེ་སྡངསྐྱེས་ཚེ་ནམ་མཁའ་སྟོང་པར་ཤེས་པས་མི་ཕན་པ་བཞིན་ནོ།",
    "རིགས་པས་དཔྱད་ན་བདེན་པར་གྲུབ་པ་ཅུང་ཟད་མེད་པའི་སྟོང་པའམ་དོན་དམ་རྣམ་གྲངས་པ་གཉིས་མགོ་མཉམ་པར་སྒྲུབ་པས་ན་ཁས་ལེན་དང་བཅས་ཤིང་།",
    "དེ་ལྟར་བདེན་གཉིས་འགལ་མེད་དུ་ཤེས་པས་ཚོགས་གཉིས་བསགས་ཏེ་སྐུ་གཉིས་ཐོབ་པར་འདོད་དོ།",
    "སྣང་བ་ཉིད་མེད་པར་དེའི་སྟོང་པའང་མི་འགྲུབ་ལ།",
    "གཉིས་ཀ་བཏགས་པ་ཙམ་ལས་མ་གྲུབ་པར་མགོ་མཉམ་ཞིང་།",
    "ཡོད་མེད་ཡིན་མིན་གྱི་དམིགས་པ་དང་བཅས་པའི་སྤྲོས་པ་ཐམས་ཅད་འགོག་པར་བྱེད་དེ།",
    "མེད་པ་ཉིད་ཡོད་པ་དང་འགལ་བས་ན་ཡོད་པར་འགྱུར་མི་རུང་ངོ།",
    "དོན་བྱེད་པར་གཟོ་དུས་འགག་པའི་ཕྱིར་དང་།",
    "བུམ་པ་འཇིག་པར་ཡོད་ན་ཡོད་དུས་དང་མེད་དུས་གང་རུང་འཇིག་དགོས་ན།",
    "མི་འཇིག་པའམ་རྟག་པར་མེད་དེ།",
    "དེ་ལྟར་ནའང་ཐ་སྙད་དུ་སྣང་ཚུལ་མི་འགོག་པར།",
    "སྟན་བདེ་བ་ལ་སྐྱིལ་ཀྲུང་བྱས་ཏེ་སྐྱབས་སེམས་སྔོན་དུ་བཏང་ནས།",
    "གསལ་ལེ་སེང་ངེ་མ་ཡེངས་པར་འཕྲོ་འདུ་དང་བྲལ་བར་བཞག་པས།",
    "གཉིས་པ་ལྟར་ན་ཁས་ལེན་ཡོད་པའི་རྣམ་དབྱེ་རིགས་མཛོད་ལས་གསལ་བར་བསྟན་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "སྔགས་སུ་ནི་ཐམས་ཅད་དག་མཉམ་བདེན་པ་དབྱེར་མེད་དུ་ཤེས་པས་རྒྱུ་འབྲས་བླང་དོར་མེད་པར་སྤྱོད་ནུས་པས་ན་ལྟ་བ་མ་རྨོངས་པ་དང་།",
    "ཁྱད་པར་ཅན་གྱི་གསང་སྔགས་དེ་ལའང་ཡོན་ཏན་གྱི་ཆེ་བ་མཆོག་དང་ལྡན་པའི་རྒྱུད་རྣམ་པ་བཞི་དག་ཏུ་ཡོད་པ་སྟེ།",
    "དེས་བྱིན་གྱིས་བརླབ་པར་བྱ་བ་བདག་ནི་ཁོལ་པོ་ལྟ་བུ་སྟེ་རང་དོན་མ་རྫོགས་ཤིང་སྒྲིབ་པ་དང་བཅས་པས་ན་ལྷ་ལ་ལྟོས་པ་དང་བཅས་པའི་ཕྱིར་རོ།",
    "རླབས་འཇུག་པར་བྱེད་པའོ།",
    "གསུམ་པ་ནི་ཁྲུས་དང་གཙང་སྦྲ་ལ་སོགས་པའི་ཀུན་སྤྱོད་ཀྱང་ཅི་ལྟར་རིགས་པར་བརྩོན་པར་བྱེད་པའོ།",
    "དང་པོ་རྣལ་འབྱོར་ཕྱི་བའི་རྒྱུན་དུ་གཙང་སྦྲ་ལ་སོགས་པའང་ལམ་སྒྲུབ་པའི་གྲོགས་ཙམ་དུ་བྱེད་ཀྱང་།",
    "རང་དམ་ཚིག་པར་གསལ་བཏབ་ལ།",
    "གཞན་དག་པའི་ཞིང་ནས་ཡེ་ཤེས་ཀྱི་ལྷ་སྤྱན་དྲངས་ཏེ་བསྟིམས་ནས་གཉིས་མེད་དུ་བསྒོམས་པས་དངོས་གྲུབ་ཐོབ་པར་འདོད་པའོ།",
    "ལྷའི་སྐུ་གསུང་ཐུགས་དང་ཕྲིན་ལས་ཀྱི་བདག་ཉིད་ཕྱག་རྒྱ་བཞི་ཡི་ངོ་བོར་འབད་པས་བསྒྲུབས་པས་དེ་ཡི་ངོ་བོར་འགྲུབ་པའི་ངེས་པ་ཁྱད་པར་ཅན་གྱི་ལྟ་བ་དང་ལྡན་པའོ།",
    "ཐོག་མར་ཁྱད་པར་གྱི་དབྱེ་བ་ནི།",
    "གཞི་དང་ལམ་དང་འབྲས་བུའི་ཁྱད་པར་གསུམ་གྱིས།",
    "ཕྱི་པ་དང་ནང་པའི་གསང་སྔགས་ཀྱི་ཁྱད་པར་ཤེས་པར་བྱ་སྟེ།",
    "མཉམ་པར་སྤྱོད་པ་ནང་པའོ།",
    "འབྲས་བུ་གྲོལ་བ་དུས་ཀྱི་ཁྱད་པར་ནི་ཚེ་འདི་ལ་སངས་རྒྱ་བ་ནང་པ།",
    "ཁྱད་པར་ཅན་གྱི་སྔགས་ནང་པ་རྣལ་འབྱོར་ཆེན་པོ་དེ་དག་སྤྱི་ཡི་འདོད་པ་ནི།",
    "ཐབས་ཤེས་དང་བསྐྱེད་རྫོགས་ཀྱི་ཕྱོགས་དེ་གཉིས་ཀ་གཙོ་ཆེ་ཆུང་མེད་པར།",
    "ལྷུན་གྲུབ་རིག་འཛིན་གྱི་གོ་འཕང་ལ་རིམ་པར་འཇུག་གོ།",
    "སྣང་བའི་རང་བཞིན་གང་དུའང་མ་གྲུབ་པའི་རྫུན་པར་གནས་ལ།",
    "ཐུགས་རྗེ་ཀུན་ཁྱབ་སྤྲུལ་པའི་སྐུ་སྟེ་སྐུ་གསུམ་གྱི་བདག་ཉིད་དུ་ཡེ་ནས་བཞུགས་ཤིང་།",
    "སྔ་ན་མེད་པའི་ཁྱད་པར་ཅུང་ཟད་ཀྱང་།",
    "སེལ་བྱེད་འདི་ལ་འདྲིས་པར་བྱས་ནས་སླར།",
    "གཞུང་གཞན་གྱི་ཟེར་སྒྲོས་མ་བསྡུས་པར་རང་གཞུང་གཙང་མ་ལས།",
    "བི་མ་ལའི་མུ་ཏིག་ཕྲེང་འགྲེལ་སོགས་གཙོ་བོར་བཟུང་ནས་གསུངས་པ་ཡིན་ལ།",
    "གཟུགས་མེད་པ་གཟུགས་ཁམས་ཀྱི་སྟེང་དུ་གོ་རིམ་བཞིན་སོ་སོའི་ནམ་མཁའ་ལ་གནས་པར་གསུངས་པའང་།",
    "སྔགས་སུ་དག་པ་དབྱིངས་ཕྱུག་མ་དང་སྦྱར་བ་བཞིན་བརྟགས་ན་དབེན་པའི་སྣང་ཙམ་ལ་བྱ་བྱེད་འཐད་པའི་རྣམ་བཞག་འདིས་ཐ་སྙད་བདེ་ཞིང་དོན་དམ་ལ་འཇུག་པའི་ཚུལ་གསལ་བར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "ཆུར་ནི་སུམ་འགྱུར་ཀུན་ལ་ཤེས་པར་བྱ་ཞེས་གསུངས་པའི་དོན།",
    "སའི་དངོས་གཞི་ལས་ཀྱང་གྲང་དམྱལ་གྱི་བར་ཚད་འདི་བཞིན་གསུངས་ཤིང་།",
    "དེ་ལྟར་ན་འདི་ནས་ཡང་སོས་ཀྱི་བར་ལ་དཔག་ཚད་དྲུག་སྟོང་ཡོད་པར་མངོན་ནོ།",
    "དེ་ཡན་ཆད་བསྐལ་ཆེན་གྱིས་རྩི་བར་གསུངས་པ་མི་འདྲ་ཡང་།",
    "ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "ཆོམ་རྐུན་དང་མཐུ་སྟོབས་དང་བྲིད་པ་སོགས་ཀྱི་སྒོ་ནས་ཕ་རོལ་གྱི་ནོར་དོན་དུ་གཉེར་པ་ལྟ་བུ་མི་རིགས་པར་ཆགས་པའོ།",
    "ས་ཡི་དངོས་གཞི་ལས་བདུན་དུ་གསུངས་ཏེ་དང་པོ་བཅུ་གཅིག་བསྡོམས་པར་མཛད་པ་ཙམ་ལས་གྲངས་འདྲ།",
    "དེ་མི་བཟོད་པར་དྲག་ཏུ་སྨྲ་བ་རྩོད་པ།",
    "ཁྲོས་པས་ཚོགས་པར་དབྱུང་མི་རུང་བའི་སྐུར་པ་གླེང་བ་གཤེ་བ།",
    "སྡོམ་མིན་ཇི་སྲིད་འཚོ་བར་དུ་མི་དགེ་ལ་ཞུགས་པར་འདོད་པ་སྟེ།",
    "བར་མའི་སྡོམ་པ་ནི་ཟླ་བ་དང་ཞག་ལ་སོགས་པའི་བར་དུ་དགེ་མི་དགེ་ལ་འཇུག་པར་ཁས་ལེན་པའོ།",
    "གནས་བརྟན་ནི་བསྙེན་པར་རྫོགས་ནས་ལོ་བཅུའམ་བཅུ་ལས་ལྷག་པར་ལོན་པ་བརྟེན་མཁས་ཀྱི་ཡོན་ཏན་དང་ལྡན་པའོ།",
    "གསར་བུ་ནི་བསྟན་པའི་སྒོར་རབ་ཏུ་བྱུང་བའམ་བསྙེན་པར་རྫོགས་ནས་རིང་པོར་མ་ལོན་པ།",
    "བར་མ་ནི་བསྙེན་པར་རྫོགས་ནས་ལོ་ལྔ་ལོན་པ་ཕན་ཆད་ལྟ་བུ་སོགས་གནས་བརྟན་དུ་མ་སོན་ལ་གསར་བུ་ལས་རྒན་པ་རྣམས་སོ།",
    "བསྙེན་པར་རྫོགས་པར་བྱེད་པ་གཉིས་སོ།",
    "ཞོ་ཤས་འཚོ་བ་ནི་སྐབས་འདིར་རྒྱལ་པོ་ལ་ཞོ་ཤས་འཚོ་བ་ཞེས་གསུངས་པའི་རྒྱལ་པོ་སོགས་ཀྱི་མཐུ་ལ་བརྟེན་ནས་འཚོ་བའི་མིང་ངོ།",
    "ཁྱད་པར་འཕགས་པ་ལ་དམིགས་ནས་བདག་དེ་ལས་ཀྱང་འཕགས་སྙམ་པ་ང་རྒྱལ་ལས་ཀྱང་ང་རྒྱལ།",
    "དེ་ལ་སའི་དངོས་གཞི་ལས་ཤིན་ཏུ་མང་པོ་གསུངས་ཤིང་།",
    "ལེའུ་དྲུག་པར།",
    "ཞེས་གསུངས་ལ་ལུགས་འདིར་མེ་བདུན་དང་ཆུ་བདུན་ཀྱང་རིམ་བཞིན་དུས་གཅིག་ཏུ་བྱུང་བར་འཆད་པ་ཡིན་ནོ།",
    "སྣོད་མ་ཆགས་པར་བསྐལ་པ་གཅིག་དང་།",
    "དེའི་ལྷག་མ་བཞི་ནི་བཞི་ཚན་བཅོ་ལྔ་པར་བསྟན་པའོ།",
    "དང་པོ་བཞི་ནི་བཞི་ཚན་སོ་དྲུག་པར་བསྟན་ལ།",
    "ལྔ་པ་ནི་བསྟེན་པར་མི་བྱ་བ་བཞི་གསུངས་པས་གསལ་ལ།",
    "གཉིས་པར་དངོས་སུ་བསྟན་ཅིང་།",
    "བཞི་པ་ལྔ་པ་གཉིས་མ་དཔེར་ཆད་པ་ལ་ཁ་བསྣན་དུ་བྱས་པ་འདིར་བདུད་ལས་ལྷག་མ་མཐའ་དག་ཡོངས་སུ་རྫོགས་པར་འདུ་སྟེ།",
    "ཐོས་ནས་དོན་དེ་ཉིད་རྣམ་པར་གྲོལ་བ་འདི་ལྟ་སྟེ།",
    "ཐོས་ཙམ་མིན་པར་ཉམས་ལེན་པ་དང་།",
    "འདིར་ལེགས་བྱས་ཀྱི་ལས་ཀྱི་རྣམ་པ་ལ་མི་འགྱོད་པ་ཞེས་གཅིག་ཏུ་བགྲང་པ་ཙམ་མ་གཏོགས་གཞན་ཐམས་ཅད་འདྲའོ།",
    "འདི་འདྲའི་སྐོར་རྣམས་ཀྱང་ཀུན་མཁྱེན་ཆེན་པོ་ཉིད་ཀྱི་ཐུགས་ནས་རྩོམ་པར་མཛད་པས།",
    "རྒྱ་དཔེ་ཁྱད་པར་ཅན་དང་མཚུངས་པས་གསར་དུ་མ་བཅོས་པར་བཞག་ལ།",
    "ཕྱིར་མི་བཟློག་པར་ཉན་ཞིང་སྤྱོད་ལམ་གུས་པ་བཀར་བློ་བདེ་བའི་རྣམ་པ།",
    "ཕྱིར་གཡེང་ནང་སྡུད་ཀྱི་སྐྱོན་མེད་པར་རྣ་བ་གཏད་དེ་ཉན་པ་རྣ་བ་བླགས་ཏེ་ཉན་པའི་རྣམ་པ།",
    "བློ་གྲོས་ནི་མཉམ་པར་བཞག་པ་མིན་པའི་ཤེས་རབ་སྟེ་ཐོས་པའི་ཤེས་རབ་ཡིན་ལ་ཐོས་པ་དང་ལྡན་ན་བློ་ཆེ་བ་ལ་དགའ་བའམ།",
    "གུས་པར་དགའ་བའི་རྣམ་པ།",
    "དགེ་རྩ་ཆུང་ངུ་ཡང་དཔག་ཏུ་མེད་པར་སྤེལ་བ་དང་བསྟན་ལ་མ་ཞུགས་པ་འཛུད་པ་དང་།",
    "ཞུགས་པ་སྨིན་ཅིང་གྲོལ་བ་སོགས་ཐབས་མཁས་ཡིན་ལ་དེ་དང་ལྡན་པར་ཉན་པ་ནི་ཐབས་ལ་མཁས་པ་ཉན་པའི་རྣམ་པ།",
    "དོན་དམ་པར་སྐྱེ་བ་སོགས་དང་བྲལ་བའི་དེ་བཞིན་ཉིད་ཤེས་པ་མི་སྐྱེ་བ་ལ་མཁས་པའི་རྣམ་པ།",
    "སྡང་བ་དང་བྲལ་བའི་བྱམས་པས་ཀུན་ནས་ཁྱབ་པར་བྱེད་པ་བྱམས་པའི་རྣམ་པ།",
    "འདུས་བྱས་རྣམས་སྐྱེ་ཞིང་སྐད་ཅིག་གཉིས་པར་མི་སྡོད་པ་མི་རྟག་པའི་རྣམ་པ།",
    "ལས་དང་ལས་ཀྱི་རྣམ་སྨིན་ཡོད་པར་བལྟས་ནས་ཆུད་མི་གསོན་ཆུད་མི་གསོན་པའི་རྣམ་པ།",
    "དད་གཏོང་ཐོས་ཚུལ་ངོ་ཚ་ཁྲེལ་ཡོད་ཤེས་རབ་སྟེ་འཕགས་ནོར་བདུན་པོ་དེ་དག་ཐོས་པ་ཅན་དེ་ལ་འདུ་བར་འགྱུར་བས་ན་ཡང་དག་པར་འདུ་བའི་རྣམ་པའམ་འཕགས་ནོར་བདུན་ལ་བརྟེན་པའི་རྣམ་པ།",
    "པར་ཅན་མ་ཐོབ་པ་ལས་ཐོབ་པའམ།",
    "ཁ་ཅིག་ཆད་པར་སྨྲ་བ་བཞི་དོན་གཅིག་སྟེ།",
    "ཁ་ཅིག་ཆད་པར་སྨྲ་པས་ཀྱང་འགའ་ཞིག་རྟག་པར་འདོད་པས་སོ།",
    "དེ་ཡང་བདག་ཡོད་པར་བསྒྲུབ་པའི་གཏན་ཚིགས་དངོས་སུ་འགོད་མི་ནུས་པས།",
    "འདིར་ཞེ་འདོད་བདག་ལ་བསྙེགས་པ་མིན་པར་མིག་སོགས་ཀྱིས་མིག་སོགས་ལས་གཞན་པའི་དངོས་པོ་ལ་ཕན་འདོགས་པ་ཙམ་ཞིག་སྒྲུབ་ན་ནི་གྲུབ་ཟིན་སྒྲུབ་པར་འགྱུར་བ་ཙམ་དུ་ཟད་པས་ཞེ་འདོད་གྲུབ་པ་ལ་ཅི་ཡང་མི་ཕན་ལ།",
    "ཞེ་འདོད་ལྟར་བསྒྲུབ་པར་ནི་རྟགས་དེས་མི་ནུས་ཏེ་འབྲེལ་བ་མེད་པའི་ཕྱིར་རོ།",
    "དེས་ན་སྦྱོར་བ་དེ་དག་འགོད་ཚུལ་གྱིས་འགལ་བར་འགྱུར་བའི་ཚུལ་ཞིབ་པར་རྣམ་འགྲེལ་ལས་གསུངས་པ་བཞིན་ནོ།",
    "ཝ་དང་སེང་གེ་ལ་སྲོག་ཆགས་ཙམ་གྱི་རང་བཞིན་རྗེས་སུ་འགྲོ་ཡང་དེ་དག་གཅིག་མིན་པར་བསྟན་པ་ནི།",
    "དེ་དགག་སླད་འགྲེལ་པར།",
    "བསྐྱེད་པས་ཡོད་པར་སྒྲུབ་ན་ནི་འགལ་བའི་རྟགས་ཡིན་ཏེ་ཞེས་སོགས་དོན།",
    "ས་བོན་གྱིས་མྱུ་གུ་བསྐྱེད་པས་ས་བོན་ཉིད་ད་ལྟ་ཡོད་པར་སྒྲུབ་ན་འགལ་ཏེ།",
    "འབྲས་དུས་རྒྱུ་འགགས་ནས་སླར་སྐྱེ་མི་རུང་བས་དེ་མེད་པ་བཞིན་རྒྱུ་གཙོ་བོ་དེ་ད་ལྟ་འབྲས་དུས་ན་ཡོད་པར་མི་འགྲུབ་པའོ།",
    "སྔར་ལྟར་མིག་སོགས་གཞན་དོན་བྱེད་པར་བསྒྲུབ་པའི་རྟགས་དེ་དོན་མེད་ཚུལ།",
    "གྲངས་ཅན་ལུགས་ལ་འགགས་པ་ཞེས་པ་བསྐལ་པའི་དོན་ཙམ་ལ་འཛིན་པས་བསྐལ་པའི་དོན་ཙམ་ལ་འགགས་པའི་བརྡ་བརྗོད་པར་གོ་དགོས་སོ།",
    "བྱེ་བྲག་པ་ཡིས་ཐར་བར་ཤེས་ཅེས་གསུངས་ཀྱང་འགྱུར་ཁྱད་ལྟ་བུ་ལས་དོན་ལ་མི་འགལ་བས་མ་བཅོས་ཏེ།",
    "གྲུབ་ན་བྱ་མི་དགོས་པའི་རིགས་པས་མ་བྱས་པར་གསལ་ལོ་ཞེས་སོ།",
    "དུས་མཉམ་པར་ཕྲད་པ་མེད་དེ་གཅིག་ལ་གཉིས་མེད་པས་སོ་ཞེས་དང་།",
    "གཉིས་ཀ་ཚོགས་པ་ཞེས་པའང་བརྟགས་ན་རང་གཞན་རྫས་འགལ་བས་ཕན་ཚུན་འདྲེ་བ་མེད་པས་ན་དོན་དམ་པར་ཕྲད་པ་མི་སྲིད་དོ།",
    "ནམ་མཁའ་ན་སྒྲ་ཡོད་ན་རྟག་ཏུ་ཐོས་པར་འགྱུར་ཞིང་།",
    "ནམ་མཁའ་མེད་ཅེས་བྱ་བ་ནི་ལྕེ་རྐན་སོགས་སྒྲའི་རྐྱེན་ཉེ་བར་མི་གནས་པར་བྱེད་པའི་གེགས་ཡོད་པ་ལ་འཁྲུལ་བར་ཟད་ཀྱི།",
    "དངོས་པོ་ལ་སྒྲ་དང་གཞན་ཡང་མ་གྲུབ་པར་གསུངས་སོ་ཞེས་པའི་དོན།",
    "དོན་དམ་པར་སྒྲ་ལྕེ་རྐན་སོགས་ལས་ཀྱང་གྲུབ་པར་མི་འདོད་པས་སྒྲ་དང་གཞན་གཟུགས་སོགས་ཀྱང་བདེན་པ་མེད་པར་གསུངས་སོ།",
    "དེ་མིན་པར་རང་སྐྱེ་བར་ཡོད་པ་གཉིས་ཀ་མ་གྲུབ་ཅེས་སོ།",
    "ཁྱད་པར་ནི་དུ་མ་དང་དབྱེར་མེད་ན་དུ་མར་འགྱུར་བས།",
    "ཁྱད་པར་མི་རྙེད་དེ་ཆུ་དང་འདྲེས་པའི་འོ་མ་བཞིན་ནོ་ཞེས་པ་འདི་ཁྱབ་པ་མི་རྙེད་ཞེས་པའི་ཡི་གེ་ནོར་བ་ཡིན་ནམ།",
    "ཡང་ན་ལྡོག་པའི་བཀག་ལུགས་ཁྱབ་བྱེད་ཁྱབ་འཇུག་དང་ཁྱབ་བྱའི་ཁྱད་པར་མི་རྙེད་ཚུལ་དཔྱད་པ་ཡིན་ནམ།",
    "ཐ་སྙད་དུ་སྟོང་པས་མ་ཟིན་པའི་སྔགས་ཀུན་དོན་ཆུང་ཞེས་གསུངས་བ།",
    "ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "རྣམ་པ་བུམ་པར་ཡོད་པ་ལྟར།",
    "ཞེས་སོགས་དོན་ལྟོ་ལྡིར་བའི་རྣམ་པ་བུམ་པར་ཡོད་པའམ།",
    "གོང་བུ་འདི་རྣམ་པ་ལྟོ་ལྡིར་བའི་བུམ་པར་ཡོད་པ་ལྟར།",
    "དེས་ན་བུམ་པ་ཡང་སྣམ་བུའི་རྣམ་པར་དང་།",
    "འབྲས་བུ་ཐམས་ཅད་ལ་རྒྱུ་ཡོད་པར་ངེས་ཏེ།",
    "གང་དུ་མ་ཁྱབ་པ་དེར་གསར་དུ་འཕོ་རུང་བས་རྟག་པར་དེ་ན་མེད་པ་བདེན་ཀྱང་ཞེས་སོ།",
    "དེས་ན་གཟུགས་ཡོད་མེད་མཐོང་མི་མཐོང་འདྲེ་བཞིན་ཡོད་པར་མི་རུང་བ་ཉིད་དོ་ཞེས་པ།",
    "འགྲོ་འོང་སོགས་མེད་ན་བྱ་བ་བྱེད་པ་མི་འཐད་པར་བསྟན་པ་ལ།",
    "སྡོང་པོའི་རྩ་བ་སྐྲད་ཀྱིས་གར་ཆོད་པའམ་ཁྱབ་པ་ནི་རི་ཡིས་མེད་པར་ཕུལ་བའམ་དེད་པའི་ཕྱིར་རིས་ཤིང་ལ་མ་ཁྱབ་བོ།",
    "ས་འགལ་བས་མ་གྲུབ་པའི་ཕྱིར་ཞེས་པ་སྤྱིར་སྡོམ་བྱེད་བསྡམ་བྱ་ཕན་ཚུན་མ་ལྟོས་པར་མི་འགྲུབ་ལ།",
    "གཅིག་ཡོད་ཚེ་གཅིག་མེད་པས་ལྟོས་ནས་བཏགས་པ་ཙམ་ལས་དོན་དུ་མ་གྲུབ་པར་བསྟན་པའོ།",
    "འདི་སྐབས་ཤིང་ལ་སེམས་པ་མེད་ཅེས་བསྟན་པ་ནི་ཤིང་མི་གཅོད་པའི་སྡོམ་པ་སོགས་དོན་མེད་པར་བསྟན་པའི་སླད་དུའོ།",
    "རྡུལ་ཆ་ཕྲ་བ་ཡང་མེད་པའི་ཕྱིར་རོ་ཞེས་པ་འདིས་ཤིང་ལ་སེམས་མེད་པར་མ་ཟད་ཤིང་རྡུལ་ཕྲ་རབ་ཙམ་དུ་ཡང་དོན་དམ་པར་མེད་ཅེས་དགག་པའམ།",
    "རྡུལ་དུ་གྲུབ་པ་ནི་བེམ་པོ་ཡིན་པས་སེམས་མ་ཡིན་ཏེ་སེམས་རྡུལ་དུ་གྲུབ་པ་མེད་ཅེས་པ་ལྟ་བུའི་དོན་དུ་རུང་ཀྱང་འདིར་ཡིག་སྐྱོན་ཅུང་ཞུགས་པ་འདྲ་སྟེ་དཔེ་དག་པ་དང་བསྟུན་ནས་ངེས་པ་རྙེད་ན་བཅོས་པར་བྱའོ།",
    "ལྷས་བྱིན་ལ་མཆོད་སྦྱིན་དུ་རྟོག་པ་འཁྲུལ་པ་ཡིན་པར་མི་འཐད་དེ།",
    "འཇིག་རྟེན་ཕ་རོལ་མེད་པར་སྒྲུབ་པའི་གཏན་ཚིགས་དངོས་སུ་འགོད་མ་ནུས་ནས།",
    "དངོས་པོ་རྣམས་ནི་གཅིག་ཁོ་ན་མིན་པར་དུ་མ་སྲིད་པས་ན་དངོས་པོ་ཡིན་ཚད་རང་དང་ཅིག་ཤོས་སུ་བགྲང་རྒྱུ་ཡོད་པ་ཙམ་གྱི་གཉིས་བཅས་ཡིན་ལ།",
    "ལུས་ཞིག་ནས་ཀྱང་སེམས་མེད་པས་འཇིག་རྟེན་སྔ་ཕྱི་མེད་པར་གྲུབ་སྙམ་པའོ།",
    "དེ་ཡང་དེ་འདྲའི་སྐྱེས་བུའི་གཉིས་བཅས་རྐྱང་པར་སྨྲས་ན་དཔེ་ལ་རྗེས་འགྲོ་བསྟན་མི་ནུས་པས་འཇིགས་ནས།",
    "འདི་ལྟ་བུའི་ཟོལ་སྦྱོར་གྱི་རྟགས་དེས་ཞེ་འདོད་ནི་སྒྲུབ་པར་མི་ནུས་པས་ཅི་ཡང་མི་ཕན་ལ།",
    "བྱས་པའི་ཕྱིར།",
    "མི་རྟག་པ་ཙམ་སྒྲ་དང་བུམ་པའི་ཁྱད་པར་མ་བྱས་པར་སྒྲུབ་རུང་སྟེ་སྒྲ་བུམ་གཉིས་ཀའང་མི་རྟག་པར་ཁྱད་མེད་པས་ན་མི་རྟག་པ་དེ་གཉིས་ཀ་ལ་ཡོད་ཀྱང་།",
    "བུམ་པ་ལ་མི་རྟག་པ་ཡོད་པ་བཞིན་དུ་ལུས་བུམ་གང་རུང་ཞེས་པའང་ཡོད་པར་འགྱུར་དགོས་ན་དེ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "བརྗོད་བྱས་སྟོང་པ་བརྗོད་རྣམས་ཀྱི།",
    "ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "སླར་ཡང་དཔེ་དག་ངེས་མཐོང་ནས་དོན་ཇི་བཞིན་སློང་ནུས་པ་བྱུང་ན་འབྲུ་ཟུར་བཅོས་པར་གྱིས་ཤིག།",
    "ཉི་མ་མ་ཕོག་པར་གྲིབ་མ་ཅན་གྱི་ཆ་གཉིས་ཡོད་མི་ཤེས་ཏེ་ཡོད་ན་ཆ་གཉིས་སུ་འགྱུར་ལ།",
    "ཉི་འོད་ཕོག་པར་ཤར་གྱི་ཕུག་པ་ལྟ་བུའང་ཉི་འོད་མ་ཕོག་པ་བྱང་བལྟས་ཕུག་པ་བཞིན་དུ་འགྱུར་ཏེ་ཐམས་ཅད་དུ་ཉི་འོད་མ་ཕོག་པའི་ཕྱིར་རོ།",
    "མདའ་འཕང་བ་ལས་ཀྱང་མཁའ་རྒྱུའི་ཡི་དྭགས་སོགས་ཀྱིས་མགྱོགས་པར་གསུངས་པའི་ཚུལ་ལའང་།",
    "འགོམ་བྱ་འགོམ་བྱེད་ཀྱི་རྡུལ་བསྣོལ་ཏེ་འདའ་ཚུལ་དེ་བཞིན་དུ་དཔྱད་པས་ཆ་མེད་མི་གྲུབ་པར་ཤེས་སོ།",
    "རིགས་པ་དེས་དུས་ཆ་མེད་ཀྱང་དུ་མར་མཆེད་པས་མ་གྲུབ་པར་གཏན་ལ་ཕེབས་སོ།",
    "མདའ་དེས་ཅིག་ཆར་དུ་འགྲོ་བར་ནི་སྨྲ་བར་མི་ནུས་ཏེ་ལམ་རྣམས་མདས་འཇའ་ཚོན་ལྟར་ཁྱབ་པར་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་པ།",
    "ཚུར་ཁ་ནས་བལྟས་ན་ཕ་ཀིར་སྣང་ཞིང་གར་ཡང་ཁྱབ་པ་ལྟར་ཡིན་དགོས་ནའང་དེ་ལྟར་མ་ཡིན་པར་མཐོང་བའི་ཕྱིར་རིམ་ཅན་དུ་འགྲོ་བ་ཡིན་ནོ་ཞེས་སོ།",
    "དེ་ཡང་དཔེར་ན་ཡུངས་ཀར་གཉིས་གཅིག་ལ་གཅིག་ཕྲད་པར་གཤིབ་པའི་སྲུབ་མཚམས་དེར་གཅིག་བཞག་རུང་བ་བཞིན་དུ་རྡུལ་ཆ་མེད་གཉིས་གཤིབ་པའི་སྲུབ་ཏུ་གཅིག་བློས་བཞག་སྟེ་དཔྱད་པའོ།",
    "དེ་འདྲའི་སྐད་ཅིག་གསུམ་ལ་ཡུན་རིང་ཐུང་ཡོད་མེད་བརྟག་པས་སྐད་ཅིག་ཆ་མེད་མ་གྲུབ་ཚུལ་གཏན་ལ་ཕེབས་སོ།",
    "བདག་རྐྱེན་མེད་དེ་ཁྱད་པར་ཁོ་ན་སྐྱེད་ན་ཆ་ཤས་རྐྱང་པ་བསྐྱེད་བྱར་འགྱུར་ཞིང་ངོ་བོ་ལ་སྐྱེད་རྒྱུ་དང་རྣམ་དབྱེ་མེད་པར་འགྱུར་རོ་ཞེས་པ།",
    "ཁྱད་པར་ཁོ་ན་སྐྱེད་ན་ངོ་བོ་མེད་པའི་ཆ་ཤས་རྐྱང་བ་བསྐྱེད་དགོས་ན་དེ་མི་སྲིད་ལ།",
    "ངོ་བོ་བསྐྱེད་ན་རྒྱུ་རྐྱེན་དང་བདག་རྐྱེན་ཁྱད་མེད་དུ་འགྱུར་ཏེ་མཚན་ཉིད་ངོ་བོ་དང་ཁྱད་པར་ལ་ཕན་འདོགས་པ་ཞེས་བཞག་པ་དོན་མེད་དོ་ཞེས་སོ།",
    "ཤེས་པའི་སྐེ་འཇིག་གཉིས་རིམ་བཞིན་བུམ་པར་སྣང་བ་དང་མི་སྣང་བའི་རང་བཞིན་ཡིན་ལ།",
    "དེ་ལྟ་ན་ཤེས་པ་འདུས་བྱས་ཡིན་ལ།",
    "གཅིག་པུར་བདེན་པར་འདོད་པ་དགག་པའི་ཚུལ་གྱིས་ཤེས་པར་བྱའོ།",
    "དེ་ཡང་བུམ་པའི་བདེན་འཛིན་ལོག་ནས་ཀྱང་སྣང་ཙམ་གྱི་བུམ་པར་རྣམ་པར་འཇོག་སྟེ་དཔེར་ན་བུམ་པ་མིན་པ་སྣམ་བུ་སོགས་རྣམ་བཅད་ལ་ཁེགས་པས།",
    "དགག་བྱ་རྣམ་པར་ཆོད་ཚེ་བདེན་མེད་ཀྱི་རྟེན་འབྱུང་ཤུགས་ལ་གྲུབ་པས་སྣང་སྟོང་དབྱེར་མེད་ཆེན་པོར་ངེས་དོན་དུ་བཞུགས་པ་མ་ཤེས་ནས་དགག་རྐྱང་ཙམ་ལ་གནས་ལུགས་སུ་རློམ་པ་ལ།",
    "རྡུལ་ཕྲ་བ་བསྒྲུབ་པ་ལ་དེ་བས་རགས་པར་སྣང་བས་བསྒྲུབ་ཅིང་རགས་པའང་ཇེ་རགས་ཀྱིས་བསྒྲུབ་སྟེ་མཐར་མངོན་སུམ་སྣང་བ་འདིས་བསྒྲུབ་ན་ཅི་གནོད་དེ་མགོ་མཚུངས་སོ།",
    "ཀུན་རྫོབ་འཁོར་འདས་གཉིས་སུ་སྣང་བའི་ངོ་བོ་རང་བཞིན་མེད་པར་དབྱེར་མེད་ཙམ་ལ་དབྱེར་མེད་ཅེས་དང་།",
    "དོན་དམ་གཉིས་ཀ་གཞི་མ་གྲུབ་པས་དབྱེ་ཡུལ་ཀྱང་མེད་པར་འཛིན་པ་དག་ལ་གནོད་པ་སྟོན་པའི་ཆེད་དུ་སྣང་དུས་དབྱེར་མེད་ལ་སྣང་བཞིན་དབྱེར་མེད་མི་འཐད་ཅེས་བསྒྲུབ་དགོས་ནའང་།",
    "དོན་དམ་པར་གཉིས་ཀ་གཞི་མ་གྲུབ་པས་དབྱེ་བའི་ཡུལ་མེད་ཅེས་པའི་དོན་དུ་འདོད་པ་དང་།",
    "གཅིག་དོན་ལ་གནས་གཅིག་དོན་ལ་མི་གནས་པར་མ་ཤེས་ན་དངོས་པོའི་ཡིན་ལུགས་དང་དེ་མ་ཡིན་པའི་ཁྱད་མི་ཕྱེ་བས་ཐ་སྙད་ཀྱི་འཇོག་ཚུལ་ཡིན་གྱི།",
    "དངོས་དང་དངོས་མེད་འདུས་བྱས་ཡིན།",
    "མྱ་ངན་འདས་པ་འདུས་མ་བྱས།",
    "བརྗོད་པར་བྱ་བ་ལྡོག་པ་སྟེ།",
    "མི་སྣང་རིགས་ལ་གསར་རྩོམ་གྱིས་ཁ་བསྐང་སྟེ་བསྟན་བཅོས་ཆེན་པོ་འདི་ཞུས་དག་ལེགས་པར་མཛད་པའི་ཐུགས་བཞེད་ཤིན་ཏུ་ཐུགས་ལ་བརྣག་ན་ཡང་།",
    "ཕྱིས་བསྟན་བཅོས་རྩོམ་ཚེ་དབེན་པར་དཔེ་བལྟ་ཀློག་མ་མཛད་པར་ཐུགས་ནས་བརྩོམས་པར་གྲགས་པ་ལྟར་དོན་དུ་གནས་པས།",
    "འདི་འདྲའི་རིགས་ལ་དོན་གྱི་འགལ་བ་སྤུ་ཙམ་མེད་པར་མ་ཟད།",
    "ཕྱིས་ཀྱང་སུས་བཅོས་པར་མ་བྱས་ན་ལེགས།",
    "གཞན་ཁྱད་པར་ཅན་ཐ་སྙད་དུ་དགག་པ།",
    "སྤྱོད་པ་པར་ཤེས་པས་རང་མི་རིག་པར་དམ་བཅའ་བ་དང་།",
    "སླར་ཁུངས་ལྡན་གྱི་དཔེ་དག་རྙེད་ནས་ཡིད་ཆེས་ཀྱི་གདིང་ཐོབ་པ་བྱུང་ན་བློ་ལྡན་ལྷག་བསམ་ཅན་རྣམས་ཀྱིས་དཀའ་ཚེགས་ལ་མི་བལྟ་བར་ཆད་འཛུད་རྣམས་ཕྱུང་ལ་ཀུན་མཁྱེན་ཆེན་པོའི་རྡོ་རྗེའི་གསུང་སོར་འཛུད་པ་གལ་ཆེ་སྟེ།",
    "གཞན་ཕལ་པའི་ངག་དང་འདིའི་གསུང་མཆིང་བུ་དང་ནོར་བུ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "མེ་ཏོག་ཆར་པས་ས་གསུམ་མཛེས་པར་བྱས།",
    "འདི་ལ་བསྐྲུན་ན་སྐྲ་རྩེའི་ཟིལ་པར་མཚུངས།",
    "ལུང་དང་མཉམ་པར་ལྟ་བ་ཤིན་ཏུ་བསླུས།",
    "ཀུན་མཁྱེན་བརྒྱུད་པའི་བཞེད་སྲོལ་དྲི་མ་མེད།",
    "གཞུང་སྤྱི་འགྲེལ་སྐོར། ། ལེའུ་བཅོ་བརྒྱད་པའི་ཚིག་འགྲོལ་བཞུགས་སོ།",
    "བླེ་ཤེས་ཀྱི་མཁྱེན་ཆ་དང་ལྡན་པའི་མིང་སྟེ།",
    "འདི་ནི་མཁྱེན་ཆ་རིག་པའི་ངོས་ནས་བསྟན།",
    "རང་བཞིན་ཅན་དུ་བཞུགས་པའོ།",
    "ལམ་གྱི་བྱེད་རྩོལ་ལྟ་བུ་ལ་མི་ལྟོས་པར་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་སྟེ།",
    "དེས་ན་འདི་ནི་ཀུན་རྫོབ་དང་འདི་ནི་དོན་དམ་ཞེས་རྣམ་པར་དབྱེ་བའི་སྤྱོད་ཡུལ་ལས་འདས་པས་ན།",
    "འགྱུར་བའི་ཟུག་རྔུ་དང་བྲལ་བ་འགྱུར་བ་མེད་པའི་རང་བཞིན་ཅན་དོན་དམ་པའི་བདེན་པར་འདོད་དོ།",
    "ཞེས་གསུངས་པ་ལྟར་རྟོགས་པར་བྱ་སྟེ།",
    "མ་བརྟགས་མ་དཔྱོད་པར་བག་ཡངས་སམ་ཉམས་དགའ་བ་ཙམ་གྱི་སྤྱོད་ཡུལ་དུ་ནི་རྣམ་པ་སྣ་ཚོགས་པའི་རང་བཞིན་དུ་སྣང་བ་ནི་དཔེར་ན་མེད་བཞིན་སྣང་བ་སྒྱུ་མའི་ལེའུ་བཅོ་བརྒྱད་པའི་ཚིག་འགྲོལ།",
    "མཁྱེན་ཆ་འོད་གསལ་བའི་དོན་དམ་ཞེས་ཡེ་ཤེས་དང་འབྲས་བུའི་དོན་དམ་བསྟན་པའོ།",
    "དེའི་ཁྱད་པར་ནི་ཇི་ལྟ་བུ་ཞེ་ན།",
    "འདི་ཉིད་ལམ་རྐྱེན་ལ་མ་ལྟོས་པར་འཁོར་འདས་ཐམས་ཅད་ལ་ཁྱབ་པར་བཞུགས་པས་ན་རང་བཞིན་ལྷུན་གྱིས་གྲུབ་པའི་དཀྱིལ་འཁོར་ཡིན་ནོ།",
    "སྒྲིབ་པའི་དྲི་མ་ཀུན་ཡེ་ནས་མི་གནས་པའི་ཚུལ་གྱིས་རྣམ་པར་དག་ཅིང་།",
    "དྲི་མ་དེའི་རྒྱུ་རྣམ་པར་རྟོག་པའི་སྤྲོས་པ་མ་ལུས་པ་དང་བྲལ་བས་ན་མཐའ་འམ་ཕྱོགས་སུ་ལྷུང་བ་ཀུན་དང་བྲལ་བ་ནི་སྤྲང་བ་ཆེན་པོ་དང་།",
    "སྐུ་ལྔ་དང་འདུ་འབྲལ་མེད་ཀྱང་མན་ཤེལ་གྱི་རང་མདངས་རྐྱེན་དང་མ་ཕྲད་པ་ལྟར་སོ་སྐྱེའི་ངོར་མི་སྣང་ཞིང་བློས་བརྟག་དཔྱད་ཀྱིས་ཇི་བཞིན་རྟོགས་པར་མི་ནུས་པས་ཟབ་པའོ།",
    "འོད་གསལ་བའི་རང་གདངས་མཁྱེན་ཆ་ཡེ་ཤེས་མ་འགགས་པར་ཡོད་ཀྱང་།",
    "མཐའ་བཞིའི་རྣམ་པར་རྟོག་པའི་གཟེབ་ཏུ་མ་ཚུད་པར་སྤྲོས་པ་ཀུན་རྣམ་པར་ཞི་བའི་ངང་ཚུལ་ཅན་དུ་གནས་པས་ན་ཤིན་ཏུ་རྟོགས་པར་དཀའ་སྟེ།",
    "ལེའུ་འདིར་ཚུལ་དེ་ལེགས་པར་གཏན་ལ་ཕབ་པའོ།",
    "གང་ཐུགས་མཁྱེན་པའི་མཁའ་དབྱིངས་གཙང་མ་རུ།",
    "ལེགས་པར་བསྒྲིགས་ཀྱང་རིགས་པས་དཔྱད་པ་ན།",
    "མ་བཅོས་ལྷུག་པར་བརྗོད་པ་རྡོ་རྗེའི་གཏམ།",
    "དོན་ལ་ངེས་པར་རྟོན་པའི་བརྡ་དང་༡ལྡན།",
    "མཁྱེན་རབ་མཁའ་ལྡིང་རྒྱལ་པོའི་གཤོག་རླབས་ཀྱིས།",
    "ལེགས་པར་འདོམས་པས་སྐལ་བཟང་གདུལ་བྱའི་ཚོགས།",
    "ངེས་པའི་དོན་ལ་རྟོན་པར་མཛད་༣པ་ཉིད།",
    "རྟག་ཏུ་རྗེན་པར་སྟོན་པ་གཙོར་མཛད་པས།",
    "ཁྱད་པར་འཕགས་པའི་བརྡ་ཐབས་རྣམ་པ་བཞི།",
    "ལེགས་གནས་ལེགས་པར་བརྟགས་ན་ངེས་པར་མཐོང་།",
    "ངེས་པར་ནུས་པའི་ཡིད་ཆེས་དད་པ་ཡི།",
    "ཚུལ་འདིར་ཁུངས་ལྡན་དཔེ་བསྡུས་བྱས་ནས་སུ།",
    "རྫོགས་སྨིན་སྦྱངས་པ་མཐའ་རུ་ཕྱིན་པར་ཤོག།",
    "བསྟན་འཛིན་མཆོག་རྣམས་བསྐལ་བརྒྱར་འཚོ་བཞེས་ཤིང་།",
    "བསྟན་འགྲོའི་དགེ་ལེགས་འདབ་སྟོང་རྒྱས་པར་ཤོག།",
    "སྤར་བྱང་སྨོན་ཚིག་ཏུ་ཞུས་དག་བྱེད་པོ་མི་ཕམ་རྣམ་པར་རྒྱལ་བས་བྲིས་པ་དགེའོ།",
    "ལ་རབ་གསལ་ཐུབ་བསྟན་པདྨའི་དགའ་ཚལ་མཆོགདགར་བཞེད་དེས་རྫོགས་ལྡན་དང་པོའི་དུས་སྟོན་སླར་ཡང་དར་བར་བྱས།",
    "དེའི་རྩ་བ་ཅན་ཡིན་པར་ནང་པའི་གཞུང་སྤྱིས་འདོད།",
    "དེ་དོན་དམ་དཔྱོད་པས་གསར་དུ་མེད་པར་སྒྲུབ་མི་དགོས་ལ།",
    "འདི་ཐད་གཟབ་སྟེ་དཔྱིས་ཕྱིན་པར་གོ་བར་སླར་བྱའོ།",
    "དཔྱིས་ཕྱིན་པར་འཇམ་དཔལ་རྡོ་རྗེས་བྱིན་གྱིས་རློབས་ཤིག།",
    "དེ་ལྟ་མིན་ན་རྣམ་མཁྱེན་མི་འགྲུབ་བོ།",
    "བུམ་ཡོད་གཅིག་མིན་པའི་དཔེས་གསུངས་པ་ལྟར།",
    "གཞི་གཅིག་ལ་ཐ་སྙད་དུ་ཡོད་པ་དང་དོན་དམ་པར་མེད་པའི་ཡོད་མེད་དེ་གཉིས་མི་འགལ་སྟེ།",
    "དོན་དམ་པར་མེད་པ་འགལ་མེད་དོན་གཅིག་ཏུ་མི་སྒྲུབ་པར་ཡོད་མེད་འགལ་བར་འཛིན་ཏེ།",
    "དོན་དམ་པར་མེད་པའི་མེད་པ་གཉིས་གཞི་གཅིག་ལ་འགལ་མེད་དོན་གཅིག་ཏུ་རུང་སྟེ་མི་རུང་ན་དོན་དམ་པར་མེད་ཚད་ཐ་སྙད་དུ་ཡང་མེད།",
    "ཐ་སྙད་དུ་ཡོད་ཚད་དོན་དམ་པར་ཡང་མེད་པར་མི་འགྱུར་ན།",
    "དོན་དམ་དཔྱོད་པས་དགག་བྱའམ་མེད་པར་སྒྲུབ་བྱ།",
    "དཔྱོད་པས་དམིགས་སུ་མེད་པར་བསྒྲུབ་བྱ།",
    "དོན་དཔྱོད་ཀྱིས་མེད་པར་བསྒྲུབ་བྱ་ནམ་ཡང་མིན་ཏེ།",
    "ཐ་སྙད་དུ་མེད་པར་སྒྲུབ་པའི་རིགས་པ་དང་།",
    "དོན་དམ་པར་ཡོད་པའི་རིགས་པ་མི་སྲིད་པས་ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་འདིར་སུས་ཀྱང་དེ་ལྟར་ཟློག་སྟེ་སྨྲ་མི་ནུས་པ་ནི།",
    "བུམ་པ་ཡང་དག་པར་དམིགས་སུ་མེད་པ་དོན་དཔྱོད་ཀྱིས་ཡིན།",
    "བདེན་མེད་གྲུབ་ན་བུམ་པ་དོན་དམ་པར་མེད་པ་གོ་དགོས་མི་ཕམ་བཀའ་འབུམ།",
    "ཀྱི་དེ་གཉིས་ལ་དོན་དམ་པར་ཡོད་མེད་ཀྱི་ཁྱད་ག་ལ་ཡོད།",
    "དོན་དཔྱོད་མི་དགོས་པར་ཐ་དཔྱོད་ཀྱིས་གྲུབ་ཟིན་པ་ལ་དོན་དཔྱོད་ཀྱིས་ཅི་ཞིག་བྱ།",
    "དོན་དཔྱོད་མེད་པར་མི་འགྲུབ་ན།",
    "དོན་དཔྱོད་ཀྱིས་བུམ་པ་མེད་པར་མ་འགྲུབ་ན།",
    "མེད་པར་གྲུབ་ན་དེ་ཉིད་དོན་དམ་པར་སྟོང་པ་ཡིན་གྱི།",
    "དོན་དཔྱོད་ཀྱིས་དཔྱད་ན་ཐ་སྙད་དཔྱོད་པ་རི་རྭ་མེད་པར་གྲུབ་པ་ལྟར།",
    "ཇི་ལྟར་ཡེ་ནས་མ་སྐྱེས་པར་རྟོགས་ཀྱི།"
  ]
}