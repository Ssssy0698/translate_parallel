    "ཟེར་བ་ཡང་འདུག་ནམ་དགོས་པའི་དུས་སུ་རྫས་དེ་མུ་ཏྲའི་སྨིན་ཕྲག་ལ་བྱུག་ནས།",
    "ཁྱི་དཀར་པོའི་ཕོ་མཚན་སྤྲང་རྒོད་དང་སྦྱར་ནས་རྡོ་རྗེ་ལ་བྱུག་པས་སྦྱོར་བ་བྱས་ན་གཞན་ལ་མི་འཆོར་ཞིང་རང་དང་འབྲལ་མི་ཕོད་དོ།",
    "འདུག་པའི་གནས་ནི་གཞལ་ཡས་ཁང་དུ་བསྐྱེད་པའི་དབུས་སུ་པད་ཉི་རོའི་གདན་ལ་ཧིཡིག་དམར་པོ་ལས་འོད་ཟེར་འཕྲོ་འདུ་ཡོངས་སུ་གྱུར་པ་ལས་རང་ཉིད་དཔའ་བོ་རྟ་མགྲིན་དངོས་སུ་གསལ་ཞིང་དུར་ཁྲོད་ཀྱི་ཆས་ཅན་སྤྱི་གཙུག་ན་རྟ་ཞལ་འཚེར་བ།",
    "ཕྱག་རྒྱའི་ལུས་ཀྱི་འདུག་སྟངས་བཅུ་དྲུག་ཡོད",
    "ལྷ་ཡི་འདུག་སྟངས་འཁྲུལ་འཁོར་རྣམ་བཞི་ཡིས",
    "ལྷ་མིན་འདུག་སྟངས་བཞི་ཡིས་གསལ་ཉམས་སྐྱེ",
    "མི་ཡི་འདུག་སྟངས་བཞི་ཡིས་བདེ་ཉམས་སྐྱེདུད་འགྲོའི་འདུག་སྟངས་བཞི་ཡིས་མི་རྟོག་ཉམས",
    "ཉམས་སྣང་སེམས་ལ་འཆར་བས་འདུག་སྟངས་གཅེས",
    "དང་པོ་སྒེག་མཛེས་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "གཉིས་པ་འཇོལ་བག་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "ཡབ་ཀྱིས་ཕྱག་རྒྱའི་མགུལ་ནས་འཁྱུད་ཅིང་སྤྱོདགསུམ་པ་འགྱེང་ལྡེམས་ཞེས་བྱའི་འདུག་སྟངས་ནིཡུམ་ནི་སྔར་བཞིན་གན་རྐྱལ་གནས་པ་ཡི",
    "དེ་ནི་ལྷ་ཡི་འདུག་སྟངས་རྣམ་བཞི་སྟེ",
    "དང་པོ་སྡིག་མཆོག་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "གཉིས་པ་ཁྲོས་མ་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "གསུམ་པ་རྔམ་ཚུལ་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "བཞི་པ་འཇིགས་བྱེད་ཅེས་བྱའི་འདུག་སྟངས་ནི",
    "དེ་ནི་ལྷ་མིན་འདུག་སྟངས་རྣམ་བཞི་སྟེ",
    "ལྷག་པར་འོད་གསལ་ཉམས་མྱོང་སྐྱེ་བར་འགྱུརགསུམ་པ་མི་ཡི་འདུག་སྟངས་རྣམ་བཞི་ནི",
    "དང་པོ་གྱད་སྟོབས་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "གཉིས་པ་རོལ་པ་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "རིག་མ་གན་རྐྱལ་འདུག་པའི་རྐང་པ་གཉིས",
    "ཡུམ་ནི་གན་རྐྱལ་འདུག་པའི་རྐང་གཉིས་བསྐུམ",
    "དེ་ནི་མི་ཡི་འདུག་སྟངས་རྣམ་བཞི་སྟེ",
    "བདེ་ཉམས་ཏིང་འཛིན་ཆུ་བོའི་རྒྱུན་ལྟར་འཆར་བཞི་པ་དུད་འགྲོའི་འདུག་སྟངས་རྣམ་བཞི་ནི",
    "དང་པོ་མཁའ་ལྡིང་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "གཉིས་པ་སེང་གེ་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "གསུམ་པ་གླང་ཆེན་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "བཞི་པ་རུས་སྦལ་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "ཡུམ་ནི་ཁ་སྦུབ་རུས་སྦལ་ལྟར་འདུག་སྟེ",
    "དེ་ནི་དུད་འགྲོའི་འདུག་སྟངས་རྣམ་བཞི་སྟེ།",
    "ཡུམ་གྱིས་ཡབ་ཀྱི་མགུལ་ནས་འཛིན་ཅིང་སྤྱོདགཉིས་པ་རབ་བརྗིད་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "གསུམ་པ་དཔའ་རྟེན་ཞེས་བྱའི་འདུག་སྟངས་ནི",
    "བཞི་པོ་འདི་ཡང་མི་ཡི་འདུག་སྟངས་ཡིན",
    "སྙོམ་འཇུག་དུས་སུ་དམིགས་པ་མ་ཡེངས་པར",
    "དེ་ཐམས་ཅད་ཐ་མར་མི་རྟག་ཅིང་རང་བཞིན་མེད་པ་ནམ་མཁའི་ཁམས་ཡིན་ནོ།",
    "བཅུ་གཅིག་པ་རྡོ་རྗེ་འདུག་སྟངས་ནི།",
    "ལོ་ཟླ་ཞག་དུས་མ་འགྱངས་བར།",
    "དམིགས་པའི་རིག་བྱར་གྱུར་པ་ནི་དམིགས་པའི་རྐྱེན་གཞན་ཚང་བ་ཉིད་དང་རང་བཞིན་ཁྱད་པར་ཅན་ཏེ།",
    "མེད་པའི་ཐ་སྙད་སྒྲུབ་པའི་མི་དམིགས་པ་དེ་དག་ཐམས་ཅད་ལ་ཡང་རང་བཞིན་འགལ་བ་ལ་སོགས་པ་དམིགས་པ་དང་།",
    "དངོས་པོ་ཅི་ལྟ་བ་བཞིན་དུ་གནས་པར་འདུག་པ་བདག་དང་འབྲས་བུ་དང་མི་དམིགས་པ་དག་ལ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "དེ་དང་འབྲེལ་བ་ཅན་གྱི་རང་བཞིན་ཙམ་གྱི་རྗེས་སུ་འཇུག་པའི་རང་བཞིན་ཅན་དེའི་ཡུལ་ན་འདུག་པའི་རང་བཞིན་ཉིད་ཡིན་ནོ།",
    "མི་དམིགས་པ་འདི་དང་རང་བཞིན་དེ་ནི་ཕན་ཚུན་འགལ་བའི་དོན་དུ་བསྒྲུབས་པ་ཡིན་པས་གཅིག་ལ་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་དོ།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་ཆབ་སྲིད་དང་།",
    "སྤྱི་ལོ་༧༤ཤིང་འབྲུག་དུས་དེར་མཐའ་བཞིའི་རྒྱལ་ཕྲན་མང་པོ་བཙན་པོར་ངོ་ལོག་སྟབས་འདུས་སྲོང་མང་པོ་རྗེས་དཔུང་དམག་འཁྲིད་དེ་ཟིང་ཆ་ལྷིང་འཇགས་གཏོང་བར་ཕེབས།",
    "པ་གོར་བེ་རོ་ཙ་ན།",
    "མཐོ་ལྡིང་གཙུག་ལག་ཁང་ཆེན་བརྒྱ་རྩ་གཅིག་དུས་གཅིག་ཏུ་ཕྱག་བཏབ།",
    "དེ་མིན་སྦུག་དམ་སོགས་ཡིག་ཚང་རང་ནས་ཉར་ཚགས་ཆོག་པ།",
    "རྒྱལ་ཕྲན་སིལ་མ་བཞི་བཅུའི་མིང་ནི་དེབ་ཐེར་ཁག་ཚང་མར་གསལ་བར་འཁོད་མི་འདུག་པས།",
    "ཏཱ་ལ་བདུན་པ་བསྐལ་བཟང་རྒྱ་མཚོ་བོད་དུ་འཕན་པོ་ཨ་ཇོ།",
    "མཐོན་ལྡིང་གཙུག་དུས་རབས་བཅུ་གཅིག་ཨ་ཏི་ཤ་བོད་དུ་མ་བྱོན་གོང་ལག་ཁང་།",
    "དུས་མཚུངས་པར་རྟ་སྟོན་དང་ལྡེ་སྟོན་ཞེས་སྟོན་པའི་མཚན་ཡང་གཅིག་ཅར་གྲགས་པ་སོགས་སྒོ་གང་ས་ནས་མཐུན་ཆ་མི་ཉུང་བ་ཞིག་མཆིས་པ་ལ་དཔགས་ན་དེ་གཉིས་གཅིག་ཡིན་པར་ཁ་ཚོན་བཅད་ནའང་ཆོག་པ་ཙམ་འདུག་རུང་།",
    "དཔེ་ངོས་ཀྱི་རྣམ་པའང་ཤིན་ཏུ་མི་མཛེས་པ་ཞིག་ཆགས་ཀྱི་འདུགཡང་ད་ཕན་དཔེ་རྙིང་པར་སྐྲུན་གནང་བ་འགའ་ཞིག་ནི་སྔར་གྱི་ཡིག་རྙིང་ནང་འཁོད་པའི་ཚིག་དོན་ལ་ནོར་འཁྲུལ་དང་།",
    "དེ་ཡང་རང་བརྒྱུད་པ་དང་།",
    "གཞི་དང་རང་བཞིན་མཚན་ཉིད་དང་།",
    "དཔེར་ན་གྲུས་མི་བསྒྲལ་དུ་ཡོད་ཙ་ན་སྒྲོལ་བ་ལྟ་བུའོ།",
    "དགུ་ཁྲུགས་ཉེར་བདུན་ཁྲུགས་སུ་འགྲོའོ་བསྟན་པ་འདི་ལྟར་གདའ།",
    "བརྒལ་ལན་བསྟན་པ་ལ་འདི་ལྟར་དུ་གདའ།",
    "རྫུས་སྐྱེས་གཉིས་པོའི་མིང་བྱང་མ་བྱུང་ནས་ཁོ་རང་གཉིས་ལ་དྲིས་པས།",
    "ཤཱཀ་ཐུབ་ལ་སེམས་བསྐྱེད་ཙ་ན་གྲངས་མེད་གསུམ་གྱི་འགོ་མ་ཚུགས།",
