    "རང་དམ་ཚིག་པའི་གནས་གསུམ་དུ་ཨོཾ་ཨཱ་ཧཱུྃ་གིས་མཚན་པས་བགེགས་དང་བར་ཆད་བསྲུང་བར་བསམ།",
    "གང་གི་ཆེད་བརྗོད་བྱེད་བཞིན་ཚེ་འདས་ཀྱི་མིང་བཅུག་པའི་མཆོད་རྟེན་འབུམ་བཏབ།",
    "ཐལ་བ་སཱཙྪ་གདབ་པར་བྱའོ། དེ་ཡང་མདུན་བསྐྱེད་དམ།",
    "བཀྲ་ཤིས་ལྷ་མོ་བརྒྱད་ཀྱིས་བསྐོར།",
    "གཏོར་མའི་སྟེང་དུ་ཨ་ལས་ཟླ་དཀྱིལ་ལ་གནས་པའི་ཧཱུྃ་གི་འོད་ཟེར་དཀར་པོའི་ཚོགས་འཕྲོས་ནས་གཏོར་མ་ལ་ཐིམ་པས་གཏོར་མ་ཟག་མེད་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་ཟད་མི་ཤེས་པར་གྱུར།",
    "མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་སྩལ་དུ་གསོལ། གཏོར་མའི་མགྲོན་ཐམས་ཅད་རང་བཞིན་གྱི་གནས་སུ་གཤེགས་པར་གྱུར། འཕགས་པ་སྤྱན་རས་གཟིགས་སེང་གེ་སྒྲའི་སྒྲུབ་ཐབས་ཡིད་བཞིན་རེ་སྐོང་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ན་མོ་གུ་རུ་ལོ་ཀེ་ཤྭ་ར་ཡ།",
    "ནངས་པར་ལངས་ནས་དྲི་བཟང་གི་ཆུས་ཁྲུས་བྱས།",
    "སྟག་གི་པགས་པའི་ཤམས་ཐབས་ཅན།",
    "ཕྱག་གཡས་པུས་མོ་ལ་བརྟེན་ཏེ་བརྐྱང་བས་པདྨ་མེད་ཀྱང་ཆོག་པདྨ་དཀར་པོའི་སྟེང་ན་ཝཱ་རུ་ཎ་སྦྲུལ་དཀར་པོས་དཀྲིས་པའི་རྩེ་གསུམ་དཀར་པོ་མི་མགོ་ཅན་འཛིན་པ།",
    "བུད་མེད་ཀྱི་ལུས་སུ་མི་འགྱུར།",
    "ན་མོ་རཏྣ་ཏྲ་ཡཱ་ཡ།",
    "གལ་ཏེ་མ་གྲུབ་ན་ང་ཉིད་མཚམས་མེད་ལྔ་བྱས་པར་འགྱུར་ཞེས་འཕགས་པ་སྤྱན་རས་གཟིགས་ཀྱི་ཞལ་བཞེས་ཡིན་ནོ།",
    "བསྐལ་པ་སྟོང་དུ་ངན་སོང་དང་བུད་མེད་ཀྱི་ལུས་སུ་མི་འགྱུར།",
    "མཎྜལ་རེ་ལ་མེ་ཏོག་ཚོམ་བུ་ལྔ་ལྔ་བཀྲམ།",
    "སྤྲོ་ན་གཟུངས་ཀྱི་ནང་གི་བསྟོད་པ་དེ་འདོན།",
    "སྒྲིབ་པ་དང་རྒུད་པ་ཐམས་ཅད་ཟད་ཅིང་མཆོག་ཏུ་སྐལ་བ་བཟང་པོ་དང་ཡིད་ལ་འདོད་པའི་དངོས་གྲུབ་མཐར་ཐུག་གི་འབྲས་བུ་དཔལ་བདེ་བ་ཆེན་པོ་སྟེར་བས་ན་བདག་ལེགས་སུ་འདོད་པས་དང་དུ་བླང་བར་བྱའོ།",
    "ཐུགས་རྗེ་ཆེན་པོ་སྤྱན་གཟིགས་མཚན་བརྒྱ་རྩ་བརྒྱད་ལ།",
    "སྲིད་ལས་བརྒལ་ཞིང་ཚོགས་གཉིས་རྫོགས།",
    "ཉོན་མོངས་དག་པ་བྲམ་ཟེའི་མགོ།",
    "པདྨ་དག་གི་གདན་ལ་བཞུགས།",
    "བ་སྤུ་ཉག་མ་རེ་རེ་ཡང་།",
    "ལྷ་མོ་སྒྲོལ་མ་རྗེས་སུ་འབྲང་།",
    "ཀླུ་བདུད་འདུལ་མཛད་ཧཱུྃ་གིས་བསྟོད།",
    "ཨོཾ་ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་སྭཱ་ཧཱ།",
    "གང་གིས་བསྟོད་ཅིང་ཟློས་པ་དེའི་མཚམས་མེད་པ་ལྔ་བྱས་པའི་ལས་ཀྱི་སྒྲིབ་པ་ཐམས་ཅད་ཡོངས་སུ་བྱང་བར་འགྱུར་རོ།",
    "བསྐལ་པ་སྟོང་གི་བར་དུ་ངན་སོང་དང་བུད་མེད་ཀྱི་ལུས་སུ་མི་སྐྱེའོ།",
    "སྔོན་བཅོམ་ལྡན་འདས་རི་བོ་ཏ་ལའི་རྩེ་མོར་བཞུགས་དུས།",
    "རྒྱལ་པོ་དེའི་ཁང་པར་ཀླུའི་དུག་གིས་གང་ནས་འདུག་པ་ལ་གཟུངས་འདིས་དུག་ཕྱུངས་ཏེ་ཞི་བར་གསུངས།",
    "མངྒ་ལཾ། མི་འཇིགས་པ་སྦྱིན་བྱེད་མཆོག་ཏུ་ཟབ་པ་རིག་པའི་ལྷ་མོ་ལྔའི་སྒྲུབ་ཐབས་བཞུགས།",
    "ན་མོ་གུ་རུ་མཉྫུ་གྷོཥཱ་ཡ།",
    "འདིར་འཇིགས་མེད་རིག་པའི་ལྷ་མོ་ལྔའི་སྒྲུབ་ཐབས་ལས། དང་པོ་གདུགས་དཀར་མོ་སྒྲུབ་པར་འདོད་པས།",
    "འཕགས་པ་གཞན་གྱིས་མི་ཐུབ་པ་དཀར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས།",
    "མེ་དཔུང་འབར་བའི་དབུས་ན་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་ཤིང་།",
    "སརྦ་བུདྡྷ་ཨ་དྷིཥྛཱ་ན་ཨ་དྷིཥྛི་ཏེ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཨུཥྞཱི་ཥ་སི་ཏཱ་ཏ་པ་ཏྲེ་ཧཱུྃ་ཕཊ།",
    "ཕྱིར་ཟློག་ཆེན་མོ་རིག་སྔགས་རྒྱལ།",
    "སྔགས་དྲུག་ཕྱག་དྲུག་གི་བྱིན་གྱིས་བརླབས།",
    "འདིའི་རྗེས་གནང་ནི་རྒྱ་མཚོ་བཞིན་ནོ། གཉིས་པ་རྒྱལ་མཚན་རྩེ་མོའི་དཔུང་རྒྱན་གྱི་སྒྲུབ་ཐབས་ནི་སྔོན་འགྲོ་གོང་འདྲ་ལ།",
    "ཚུར་འདུས་ཡོངས་སུ་གྱུར་པ་ལས་བདག་ཉིད་གཡུལ་ལས་སྒྲོལ་བར་བྱེད་པའི་ཁྲོ་མོ་སེར་མོ་ཡིད་དུ་འོང་བའི་གཟུགས་ཅན།",
    "ཞལ་རེ་རེ་བཞིན་ཁྲོ་བའི་སྤྱན་གསུམ་དམར་ཟླུམ་མཛེས་པ།",
    "ཨོཾ་བྷ་ག་ཝ་ཏེ་དྷྭ་ཛཱ་གྲ་ཀེ་ཡཱུ་རེ་པ་ར་སེནྱ།",
    "རང་གི་ཐུགས་ཀར་གནས་པའི་དྷྭཾ་ཡིག་འབར་པའི་འོད་ཀྱིས་རང་ཉིད་རྒྱལ་མཚན་རྩེ་མོའི་དཔུང་རྒྱན་རྡོ་རྗེ་རོ་ལངས་མར་གྱུར་པ་མཐིང་ནག་དྲག་མོ།",
    "ཁྲོ་མོའི་ཆ་ལུགས་དང་རྒྱན་དང་ན་བཟའ་ཡོངས་སུ་རྫོགས་པ།",
    "མིང་པོ་གསུམ་གྱི་དམག་ཚོགས་བསྐུལ་པས་གདུག་པ་ཅན་ཐམས་ཅད་ཚར་བཅད་པར་བསམས་ལ་གོང་གི་སྔགས་བཟླའོ།",
    "ཚུར་འདུས་ཡོངས་སུ་གྱུར་པ་ལས་རང་ཉིད་སོ་སོར་འབྲང་མ་ཆེན་མོ་སེར་མོ་ཞལ་བཞི་ཕྱག་བརྒྱད་པ།",
    "ཨོཾ་མ་ཎི་དྷཱ་རི་བཛྲཱི་ཎི་མ་ཧཱ་པྲ་ཏི་ས་རེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་ཕཊ་སྭཱ་ཧཱ།",
    "སྟོང་པའི་ངང་ལས་པྃ་ལས་སྣ་ཚོགས་པདྨ་དང་ཨ་ལས་ཟླ་བའི་སྟེང་དུ་རང་སེམས་སྲྃ་དཀར་པོ་ལས་འོད་ཟེར་འཕྲོས་འདུས་རང་ཉིད་འཕགས་མ་སོ་སོར་འབྲང་མ་དཀར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས།",
    "སྤྲོ་བསྡུའི་དམིགས་པ་བཅས་གོང་གི་སྔགས་ཅི་ནུས་བཟླ།",
    "ཨོཾ་ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་སྭཱ་ཧཱ།",
    "སྒྲོལ་མ་རང་གིས་དམ་བཅས་པའི་གཟུངས་ཀྱང་ཅི་ནུས་སུ་འདོན།",
    "དཔལ་དང་སྐལ་པ་བཟང་པོ་དང་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་དངོས་གྲུབ་མ་ལུས་པ་ཇི་ལྟར་རེ་བ་བཞིན་དུ་རིང་པོར་མི་ཐོགས་པར་ཐོབ་པར་འགྱུར་རོ།",
