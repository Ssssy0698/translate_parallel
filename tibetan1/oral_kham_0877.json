    "དེ་ཡང་རང་གཞན་སུ་ཡིན་ཀྱང་བདེ་སྐྱིད་འདོད་པ་ཤ་སྟག་སྟེ།",
    "སྟོན་པ་བཀའ་དྲིན་ཅན་གྱི་རྗེས་འབྲང་དགེ་སློང་བསྟན་འཛིན་རྒྱ་མཚོ་ང་རང་ཡང་ཆགས་སྡང་ལ་སྐྱོན་དུ་བལྟས་ཏེ་ཐབས་ཤེས་ཀྱིས་ཉམས་ལེན་གང་ཐུབ་བྱེད་ཀྱི་ཡོད།",
    "དེས་ང་རང་ལ་ཕན་གྱི་འདུག་སེམས་ཞི་བདེ་བག་ཕེབས་ཇི་ཙམ་ཡོད་པ་དེ་ཙམ་གྱིས་བསམ་བློ་ཡང་མང་པོ་འཁོར་ཐུབ།",
    "བཀའལ་ལེགས་པར་རབ་ཏུ་བརྟགས་ཏེ་དངོས་པོའི་གནས་ཚུལ་དང་མཐུན་པར་འདུག་ན་དེ་ཉིད་ཁས་ལོངས།",
    "ང་ཕར་ཙམ་མ་ཤི་ན།",
    "འཇིགས་པ་ལྟ་བུ་ཞིག་ཐོག་ཏུ་བབས་ནའང་ང་ལ་ཉེན་ཁ་འདུག་སྙམ་པ།",
    "དེ་ལྟར་རང་རང་སོ་སོར་འདོད་མི་འདོད་དང་།",
    "ང་བདེ་བ་འདོད་ཀྱི་འདུག་ང་སྡུག་བསྔལ་འདོད་ཀྱི་མི་འདུག་ཟེར་བའི་ང་ཞིག་ཡོད།",
    "དེ་རིང་ངའི་གཟུགས་པོ་བདེ་པོ་འདུག་ཀྱང་སེམས་སྐྱིད་པོ་མི་འདུག་ཅེས་པ་དང་།",
    "དེ་རིང་སེམས་སྐྱིད་པོ་འདུག་ཀྱང་ལུས་བདེ་བོ་མི་འདུག་ཅེས་པ་ལྟ་བུའི་རིགས་གཉིས་ཡོད།",
    "འོན་ཀྱང་དེའི་ཚོད་ཀྱིས་དཀའངལ་ཅན་གྱི་རྣམ་འགྱུར་མི་འདུག་ཟེར་བཞིན་འདུག་བོད་པ་རྣམས་བཙན་བྱོལ་བར་གྱུར་ཏེ་ལོ་བཅུ་ཕྲག་འགའི་རིང་དཀའ་ངལ་སྣེ་མང་ཡོད་མིན་ལ་མ་ལྟོས་པར་བསམ་བློ་བག་ཕེབས་པ་དང་།",
    "ང་སྡིག་ཅན་ཡིན་པས་གྱོན་ཆས་དགོས་པ་མི་འདུག་ཅེས་བརྗོད་ན།",
    "འདི་དག་ཁྱེད་རང་མཁྱེན་མཁན་ཚོ་ནི་མཁྱེན་མཁྱེན་པ་ཡིན་པས།",
    "ང་ལ་ཆ་བཞག་ན་འདས་ཟིན་པའི་མི་ཚེ་ལ་ཕྱིར་བལྟ་བྱེད་སྐབས་ཅུང་དྲག་ཏུ་ཕྱིན་འདུག་ཁྱེད་ཅག་ཀྱང་འབད་བརྩོན་བྱས་ན་ཡར་རྒྱས་སུ་འགྲོ་སེམས་བཅོས་སུ་རུང་བ་དང་བཟོ་བཅོས་བྱེད་ཐབས།",
    "འདི་གར་གནས་པའི་སོག་པོ་འགའ་བཅས་མི་སྣ་མང་པོ་འཛོམས་འདུགདེས་ན།",
    "རང་རང་སོ་སོའི་སྒོ་གསུམ་གྱི་ལས་ལ་བརྟེན་ནས་བྱུང་བས་ལས་བཟང་པོ་ལ་བརྟེན་ནས་འབྲས་བུ་བདེ་བ་དང་།",
    "གནས་དེ་འདྲ་ཞིག་ལ་སྐྱེས་ཡོད་ནའང་རང་ངོས་ནས་དད་པ་མེད་པའམ།",
    "གཤའམའི་ཉམས་ལེན་ཇི་འདྲ་ཞིག་བྱུང་འདུག་སྙམ་དུ་དཔྱད་དགོས།",
    "རང་རང་སོ་སོས་འབད་བརྩོན་བྱ་དགོས་པ་ལས་རང་དགར་ཡོང་རྒྱུ་དཀའ།",
    "ང་ཐོས་དུས་ཙ་ན་བསམ་སྒོམ་བདོ།",
    "ང་བསམ་དུས་ཙ་ན་ཐོས་སྒོམ་བདོ།",
    "ང་སྒོམ་དུས་ཙ་ན་ཐོས་བསམ་བདོ།",
    "མཆོད་སྡོང་འོད་འཚེར་བ་ཞིག་ཡོང་གང་ཐུབ་གཙོ་བོར་བརྩི་བ་དེ་འདྲ་ཡང་འདུག་རང་ཉིད་ཆགས་ས་རྟེན་ས་ལྟ་བུར་གྱུར་ཏེ་ཡོད་པ་དེ་དག་བསམ་བློར་འཁོར་ཏེ་ཁ་ཏོན་དགེ་སྦྱོར་བྱེད་པར་འགལ་རྐྱེན་བྱེད་ཀྱི་མི་འདུག་གམ།",
    "དེང་སང་རང་ཅག་རང་ཡུལ་དང་བྲལ་ཏེ་ཡོད་ནའང་ཆགས་སྡང་སྐྱེ་བའི་ཡུལ་གསར་པ་ཞིག་བཟོས་ཏེ་བསྡད་ན་དགོས་པ་མེད།",
    "རྒྱ་གར་དུའང་རྗོད་མཁན་འདུག་དབེན་པའི་གནས་སུ་དད་རྫས་དཀོར་རྫས་ཀྱི་གྲིབ་དང་།",
    "སྤྱིར་ལྷ་ཁང་དང་རྡོ་རྗེ་གདན་ངོ་མ་ནི་རང་རང་སོ་སོའི་བསམ་བློའི་ནང་དུ་ཡོད་དགོས།",
    "སྒྲུབ་གནས་ངོ་མཚར་ཅན་ཞིག་དེ་ན་གདའ།",
    "ཚོགས་གསོག་ངོ་མཚར་ཅན་ཞིག་དེ་ན་གདའ།",
    "དུར་ཁྲོད་འཇིགས་སུ་རུང་བ་ཞིག་དེ་ན་གདའ།",
    "མའོ་ཙེ་ཏུང་ལ་སོགས་པའི་དཔོན་རིགས་ཇི་འདྲ་ཞིག་ཡིན་རུང་ཁོ་རང་འཆི་བའི་རྒྱལ་སྲས་ལག་ལེན་སོ་བདུན་མའི་བཀའཁྲིད་ཟིན་བྲིས་བཞུགས་སོ།",
    "ཏམཆོག་ཀྱང་རང་ཉིད་གཤེགས་པའི་ཚེ།",
    "དེ་ཚོ་ཡང་རང་ཉིད་ཀྱིས་བསྣམས་ཐབས་བྱུང་མེད།",
    "འཆི་བ་དེའང་རང་ཐོག་ལ་དུས་ནམ་འོང་ཆ་མི་འཚལ་བས་འཆི་བ་དེ་དུས་ནམ་ཞིག་ལ་སླེབ་སྙམ་དུ་སྡོད་དགོས།",
    "མི་ཚེ་འདིའི་ནང་རང་ཉིད་ཀྱི་དགའ་ཉེ་བློ་དཀར་གྱི་མཛའ་བཤེས་མི་ལོ་སུམ་ཅུ་བཞི་ཅུའི་རིང་འདྲིས་ཏེ་འབྲལ་མི་ཕོད་པ་ལྟ་བུ་ཞིག་ཡིན་ན་ཡང་འཇོག་རྒྱ་ལས་འོས་མེད་པས།",
    "མུ་གེ་བྱུང་ཙ་ན་ལོ་ཏོག་སྟེང་དུ་ཚང་མ་འདུས་ཡོང་བ་ལྟར།",
    "གང་ལྟར་རྣལ་འབྱོར་རྒྱུད་ཀྱི་ཉམས་བཞེས་ཡོད་ཚུལ་འདུག་དེ་ལྟ་ནའང་སྔགས་ལ་ཆ་མཚོན་ན།",
    "སྤྱིར་ན་འདུས་བྱས་ཡིན་ནོ་ཅོག་དུས་གཏན་དུ་འགྱུར་བ་མེད་པར་གནས་ཐུབ་པ་གཅིག་ཀྱང་མེད།",
    "རང་ཉིད་ཀྱང་རང་ལུས་ལ་སྐྱུག་བྲོ་དགོས་པ་དང་།",
    "ཐོག་མར་གཟུགས་བཟང་རང་གཞན་གྱིས་ཆགས་པའི་ཡུལ་དུ་གྱུར་པ་དེ་ཉིད་མཐར་སྡང་བ་སྐྱེ་བའི་ཡུལ།",
    "འོན་ཀྱང་རང་གཞན་སུ་འདྲ་ཞིག་ཀྱང་རྒྱུན་དུ་ཁོང་ཁྲོ་ལངས་བཞིན་སྡོད་མཁན་མི་སྲིད།",
    "བདེ་སྡུག་ནི་རང་རང་སོ་སོའི་ལས་ཀྱིས་བཟོས་ཤིང་།",
    "ང་རང་ལའང་ཕན་ཐོགས་པར་འདུག་སྙམ་དུ་ལོངས་སྤྱད་ན།",
    "གཅིག་པུར་འདུག་ཚེ་སེམས་ལ་བརྟག།",
    "ཚིག་ངན་ལྟ་བུ་ཐོན་གྲབས་བྱེད་ཀྱི་འདུག་པས་དེ་སྐབས་ངས་གཟབ་གཟབ་བྱེད་ཀྱི་ཡོད།",
    "མིང་གཞན་གྱིས་འབོད་སྲོལ་མེད་ཅེས་ཤོད་རྒྱུན་འདུག་པ་ནི་ཧ་ཅང་ལེགས།",
    "ཞེས་བརྗོད་འདུག་འདི་ཡག་པོ་མི་འདུག་གམ།",
    "ཆུ་ཚོད་སྦྲེལ་ཏེ་སྐད་ཆ་ཤོད་ཀྱིན་འདུག་པ་དེ་ཚོར་ཡ་མཚན་གྱི་འདུག་ལ།",
    "ད་དུང་དེའི་རྐང་པ་ཆག་འདུག་པས་ཟ་རྒྱུ་ལས་འོས་མེད་སྙམ་དུ་གསོད་པའི་ཉེན་ཁ་ཡོད།",
    "ཡ་རབས་དམ་པའི་སྤྱོད་བཟང་ལས་འདས་འདུག་སྙམ་དུ་བསམ།",
    "ཤེས་བཞིན་དུ་དུག་ཟོས་པའི་ཚུལ་དང་གཅིག་མཚུངས་སུ་འདུག་སྙམ་པ་ལྟ་བུའི་སྔར་བྱས་ལ་འགྱོད་པ་ཤུགས་དྲག་སྐྱེས་ཏེ།",
    "སྡོམ་པ་མེད་པ་ཁྱིམ་པ་མི་ནག་པ་ཕལ་པ་ཞིག་དང་མི་ཚེ་སྐྱེལ་སྟངས་གཅིག་མཚུངས་སུ་འདུག་ཤིན་ཏུ་ཐབས་སྐྱོ་བའི་ངང་ཚུལ་ལོ་སྙམ་དུ་བསམ་མནོ་ལེགས་པར་བཏང་བའི་སྒོ་ནས་བཤགས་སྡོམ་བྱ་བ་ཤིན་ཏུ་གལ་ཆེ།",
    "མནྜལ་གསོག་མཁན་དེ་འདྲ་འདུག་པ་ཤིན་ཏུ་ལེགས།",
    "འཆི་བ་ནི་ཀུན་གྱིས་མི་འདོད་པས་སུ་འདྲ་ཞིག་ཀྱང་རང་ཉིད་ཚེ་རིང་ཞིང་།",
    "རྐང་ལག་གཅོད་དགོས་འདུག་ནའང་བཅད།",
    "ལས་ཀ་ཞིག་བཙལ་ཀྱང་གླ་ཕོགས་ཉུང་ངུ་ལས་མི་འདུག་ཟེར་བ།",
    "གལ་ཏེ་དེ་ལྟར་བྱུང་ནའང་དེར་ཕྲུ་གུ་ཆགས་ཀྱི་མི་འདུག་ཟེར་བ་དང་།",
    "ང་རང་ཡང་ཉམས་ལེན་ཅི་ཐུབ་བྱེད་ཀྱི་ཡོད།",
    "ད་ལྟ་ངས་ང་རང་དཔེ་ལ་བཀོད་དེ་ཞུས་པ་ལྟར།",
    "ཤིན་ཏུ་རྙེད་སླའི་རྩྭ་ཁམ་འགའ་ལྟ་ཕྱུགས་ཀྱང་རང་ཉིད་ཟ།",
    "བཟང་ངན་ཅི་བྱུང་ཡང་ཁྱེད་རང་མཁྱེན་སྙམ་པའི་ཡིད་ཁྱེད་ཤེས་ཀྱི་བསམ་པས་སྐྱབས་སུ་འགྲོ་བ་དང་།",
    "བསྟན་པ་སྤྱི་ལ་ཕན་ཞིང་རང་ཉིད་ལའང་ཕན་འོང་།",
    "བློ་སྦྱོང་ནས་ཀྱང་རང་གཅེས་འཛིན་འདི་ནི་ཐན་དང་ལྟས་ངན་ཐམས་ཅད་ཀྱི་འབྱུང་གནས་ཡིན་ཞེས་གསུངས་ཡོད།",
    "སྟེ་ཡུལ་ནས་བྱུང་ཡང་ཡུལ་གཞན་དང་གཞན་དག་ཏུ་ནུས་པ་བརྟས་ཏེ་སླར་ཡང་རང་ཉིད་ལ་གནོད་པ་བྱེད་སྲིད།",
    "དེ་ལྟ་བུའི་ཚུལ་གྱིས་འགྲོ་འཆག་ཉལ་འདུག་དང་།",
    "ཇག་པ་དེ་རྣམས་བྲོས་ཕྱིན་འདུག་དེའི་ཚེ་རྒྱལ་སྲས་ཐོགས་མེད་བཟང་བོས་ཐུགས་ཞི་དུལ་བག་ཡོད་པའི་ངང་ནས་སྔོན་ལ་ཁྱེད་ཚོ་སྒུགས་དང་ཞེས་གསུངས།",
    "ཡང་ངའི་རང་མཚང་སྔོག་ཀྱིན་འདུག་སྙམ་པ།",
    "ཁོས་རང་ཉིད་དམའ་འབེབ་ཅིང་མཚང་འབྲུ་བར་འདུག་སྙམ་དུ་སྤྱིར་ཡུལ་དེར་ཁོང་ཁྲོ་བ་དང་།",
    "ང་ལ་ལྟོས་ཏེ་ཡོན་ཏན་གྱི་ཆ་གང་ནས་ཀྱང་ཁྱེད་རང་ལྷག་སྙམ་དུ་བསམ་གྱིན་ཡོད།",
    "དེང་སང་རང་ཅག་ལྟ་བུར་མཚོན་ན།",
    "གཟུགས་པོ་བདེ་ཐང་མེད་པའི་ཁར་སེམས་ཀྱང་མི་སྐྱིད་པར་འདུགད་ནི་ཁ་ཏོན་བྱས་ནའང་ཕན་པ་མི་འོང་།",
    "ང་རང་ལ་ཆ་བཞག་ནའང་འདི་ཉམས་ལེན་ཅི་ཐུབ་ཐུབ་བྱེད་ཀྱི་ཡོད།",
    "དེང་སང་རང་ཅག་རྒྱ་གར་ལ་བོད་ཀྱི་རྨི་ལམ་གཏོང་སྐབས།",
    "སླར་ཡང་བློས་འཛིན་ཚུལ་ཇི་འདྲར་འདུག་པ་དང་།",
    "དེ་མ་ཐོབ་ན་རང་ཉིད་གཞན་དོན་བྱེད་པ་ལས་ཉམས་པར་འདུག་དེ་ཡང་མངོན་མཐོའི་གོ་འཕང་ཐོབ་པ་ལ་རག་ལས་པས།",
    "རང་རང་སོ་སོའི་བསྟན་པ་བསྲེས་ལྷད་མེད་པ།",
    "སྐྱར་ཟློས་ཡང་ཟློས་བྱེད་དགོས་པ་མི་འདུག་གལ་ཆེ་ཤོས་སེམས་བཟང་པོ་བྱེད་དགོས་པ་དེ་ཡིན།",
    "ཤོ་སྦག་ཀྱང་བཅད་དེ་མི་གཤིས་ཧ་ཅང་འཇམ་པོར་གྱུར་འདུག་ཅེས་ཤོད་རྒྱུ་ཡོད་པ་ཞིག་བྱུང་ན་འགྲིག་པ་ཡིན།",
    "འགྱུར་བ་གང་ཡང་ཕྱིན་མི་འདུག་ཅེས་ཤོད་རྒྱུ་ཞིག་བྱུང་ན།",
    "སྒྲ་སྒྲོག་དུས་དང་ཡང་དག་ལྡན།",
    "དེས་ན་བསྡུས་དོན་ལ་མི་མཐུན་པ་བྱུང་བ་འགྱུར་གྱིས་མ་ཐོན་པ་མིན་གྱི་རྒྱུ་དཔེ་མི་མཐུན་པས་བྱུང་ཡང་རྒྱ་དཔེ་ཁ་ཅིག་ན་འདུག་པའི་འགྱུར་བཅོས་པ་དེ་ཤིན་ཏུ་ལེགས་པར་སྣང་ངོ།",
    "དེའི་ཚེ་ཡང་སྟོང་པ་གསུམ་དང་རང་བཞིན་རྣམས་སྤེལ་ཏེ་སྐྱེ་བ་མིན་གྱི་སྣང་བའི་རྗེས་སུ་སྐྱེ་བ་ཡིན་ནོ།",
    "གསལ་བ་འགའ་ཞིག་དུས་ཡིན་ཏེ།",
    "རྡོ་རྗེ་འཆང་རང་ཉིད་ཀྱི་སྐུ་གསུང་ཐུགས་རྡོ་རྗེ་གསུམ་མི་ཕྱེད་པ་ལས་ཕྱུང་ངོ།",
    "སྐབོས་གཞན་དུ་བསྟན་པ་ཡིན་ཞེས་སྦྱོར་རྒྱུར་འདུག་པ་ལ།",
    "ལུས་བསྐྱེད་པ་ཞེས་སོགས་ཀྱིས་གཞུང་དེའི་དོན་བསྟན་ཟིན་འདུག་པས་དེ་ལྟར་དུ་བདེའོ།",
    "གང་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་ཅུང་ཟད་ཀྱང་མེད་ན།",
    "ཤིན་ཏུ་དགྱེས་པས་ཁྱབ་པར་གྱུར་པ་ནི་དགྱེས་པས་ཁྱབ་པར་གྱུར་ཅིང་རངས་ཏེ།",
    "དེ་ཡང་རང་ལྷ་ཡབ་ཡུམ་དུ་གསལ་བའི་གསང་བའི་གནས་གཉིས་ཡེ་ཤེས་ཏེ།",
    "དེ་བོད་དུ་ཤིན་ཏུ་རྟོགས་དཀའ་བར་བྱུང་འདུག་ནའང་།",
    "མིང་མཐུན་ཡང་དོན་མི་གཅིག་པ་དུ་མ་འདུག་པའི་ཕྱིར་རོ།",
    "ག་དུས་གསུམ་དུ་སྟེ།",
    "ཀྲ་ཀ་ཙ་ནི་སོག་ལེ་སྟེ།"
  ]
}