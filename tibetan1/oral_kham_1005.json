    "སྒྲ་རྟག་པར་འཛིན་པའི་བློ་གང་ཞིག་དུས་ཕྱིས་སྒྲ་མི་རྟག་པར་འཛིན་པར་འགྱུར་བར་སྲིད་པའི་ཕྱིར།",
    "འཇུག་དུས་ཀྱིས་བརྗོད་བྱ་རྗོད་བྱེད་གཉིས་ལས།",
    "སྒྲ་ཐོས་པའི་ཉན་ཤེས་ཀྱི་རྗེས་སུ་བྱུང་བའི་རྟོག་པ་ལ་སྒྲ་འདིས་དོན་འདི་བརྗོད་པར་འདུག་གོ་སྙམ་པའི་རྗོད་བྱེད་དུ་སྣང་བ་ལ་དངོས་ཀྱི་རྗོད་བྱེད་དང་།",
    "འཇུག་དུས་ཀྱི་བརྗོད་བྱ་ལ་དངོས་དང་ཞེན་པ་གཉིས་སུ་ཕྱེ་བ་མེད་དེ།",
    "འཇུག་དུས་ཀྱི་རྗོད་བྱེད་ལ་གཉིས་སུ་ཕྱེ་བ་མེད་དེ།",
    "དངོས་པོ་ལ་རང་གཞན་གཉིས་སུ་ཁ་ཚོན་ཆོད་ཅིང་རང་ནི་གཞན་ལ་མ་འདྲེས་པར་གནས།",
    "གཅིག་ལ་འདུག་པ་འབྲེལ་པ་མེད།",
    "འདི་ནི་གཞན་དུ་འདུག་པ་ན།",
    "ཕྱིས་མུན་པ་ནུས་མེད་འགགས་པ་ཉིད་སྣང་བ་སྐྱེས་པ་ཡིན་པས་སྐྱེ་འགག་དུས་མཉམ་སྟེ།",
    "ཉེས་པ་ཁྱེད་རང་ལའང་མཚུངས་སོ་སྙམ་ན།",
    "སྔ་ཕྱི་གཉིས་ཀ་ཡང་རང་མཚན་ཡོད་མེད་གང་རུང་དུ་གཏོགས་པར་དོན་ལ་མཐུན་ཏེ།",
    "ངེས་ཤེས་དེའང་རང་སྟོབས་ཀྱིས་དྲངས་པ་ཡིན་ནམ།",
    "དེས་རང་རིག་མངོན་སུམ་ཐམས་ཅད་མཚན་ཉིད་མི་བསླུ་བ་ལའང་རང་ངེས་སུ་གྲུབ་སྟེ།",
    "འཇུག་ཡུལ་གྱི་ཐ་སྙད་ལ་ཡང་རང་ལས་ངེས་ཀྱིས་མ་ཁྱབ་སྟེ།",
    "དེའི་དོན་ཡང་རང་མཚན་གཞིར་བཟུང་བའི་ཚེ་སྔར་གྱི་མཚན་ཉིད་དེ་མ་ཚང་བའོ།",
    "དེ་ལྟར་ཡང་རང་འགྲེལ་ལས།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "འདི་ལྟར་ཁྱེད་རང་ཕྱི་དོན་ཡོད་པར་འདོད་པའི་ལུགས་ལ།",
    "བྱས་པ་སྒྲ་མི་རྟག་པར་བསྒྲུབ་པའི་རྟགས་ཡང་དག་ཏུ་འཛིན་པའི་རྟོག་ངོར་སྒྲ་དོན་དང་རང་མཚན་སོ་སོར་མ་ཕྱེ་བའི་བྱས་པ་ཙམ་རྟགས་ཡང་དག་ཡིན་ཏེ།",
    "ཡང་རང་འགྲེལ་ལས།",
    "དེ་ཡང་སྒྲ་དང་མི་རྟག་པའི་ཚོགས་དོན་བསྒྲུབ་བྱའི་མཚན་གཞི་ཡིན་ཅེས་བརྗོད་པའི་ཚེ་སྒྲ་དེ་ཡང་སྒྲ་དོན་དང་རང་མཚན་སོ་སོར་མ་ཕྱེ་བ་ཡིན་ཅིང་།",
    "མི་རྟག་པ་དེ་ཡང་སྒྲ་དོན་དང་རང་མཚན་སོ་སོར་མ་ཕྱེ་བ་ཡིན་ཏེ།",
    "སྒྲ་དོན་དང་རང་མཚན་སོ་སོར་མ་ཕྱེ་བ་སྟེ་གཞན་དུ་ཡང་ན་དངོས་ཀྱི་བརྗོད་བྱ་རྗོད་བྱེད་ཁོ་ནར་འགྱུར་ཞིང་།",
    "ལུགས་འདི་ལ་སྤྱིར་གཏན་ཚིགས་ཡང་དག་ལ་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་གཉིས།",
    "སེམས་མུན་པ་ལྟ་བུར་འདུག་པ་དང་།",
    "དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ་ནང་དུ་ཡང་དག་བཞག་ནས།",
    "གནས་ཚུལ་ལ་རྟ་གླང་རང་མཚན་པར་ཞེན་འཛིན་ཡོད་མེད་ཀྱི་ཁྱད་པར་བྱུང་བ་ལྟར།",
    "དེ་ལྟར་བཞག་དུས་ཀྱི་སེམས་ལ་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱིས་རྣམ་པར་འབྱེད་ཅིང་དཔྱོད་པའི་ཤེས་བཞིན་དང་དེ་ལས་གཞན་དུ་ཡེངས་མི་གཏོང་བའི་དྲན་པ་ཡོད་ན་ནི།",
    "ཁྱེད་རང་ལྟར་ན་ཞི་གནས་ཡིན་ན་མི་རྟོག་པ་ཡིན་དགོས་པ་དང་།",
    "དེ་ལྟར་དཔྱད་པས་དཔྱོད་བྱེད་ཀྱི་སོ་སོར་རྟོག་པ་ཉིད་ཀྱང་རང་ཞི་ནས་ཅིའི་ངོ་བོར་ཡང་མ་གྲུབ་པའི་མི་རྟོག་པར་གྱུར་པ་ནི་སྐབས་འདིའི་ལྟ་བ་དངོས་གཞི་ཡིན་ཏེ།",
    "ཤིང་དྲུད་པའི་མེས་ཤིང་སྲེགས་ནས་མེ་ཡང་རང་ཞི་བ་ལྟར།",
    "རང་རང་གཞུང་དང་གྲུབ་པའི་མཐའ་ཡིས་ནི།",
    "འདུག་ཅིང་འདུག་ཅིང་ཡང་གསོལ་བ་གདབ།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "འདུག་ནའང་བདག་འདུག་གོ་ཞེས་རབ་ཏུ་ཤེས་སོ།",
    "སྤྱོད་ལམ་དེས་འདུག་པ་མཐོང་ན་ཤིན་ཏུ་དང་བ་སྐྱེ་བ་དང་།",
    "འཕྲལ་ཇི་ལྟར་འདུག་དང་འདི་ལྟར་སྣང་སོགས་ད་ལྟའི་རྟོག་དཔྱོད་ཀྱང་ཡིད་ལ་མི་བྱེད་པར་སེམས་རང་གར་ལྷོད་དེ་ཤིག་གེ་བར་འཇོག་པ་ཡིན་ལ་འཇོག་ཚུལ་འདི་ནི།",
    "དེ་ལའང་དགག་སྒྲུབ་ཀྱི་བཅོས་སླད་མ་བྱས་པར་སེམས་ཀྱི་རང་བབས་ཇི་ལྟར་འདུག་པ་དེའི་ངང་ལ་ཆམ་མེ་ལྷོད་དེ་བཞག།",
    "དམིགས་པ་དེ་ལ་སེམས་རྣལ་དུ་འདུག་པར་མཐོང་བ་དེའི་ཚེ་རྩོལ་བ་གློད་ལ་བཏང་སྙོམས་སུ་བྱ་ཞིང་།",
    "དེའི་ཚེ་ཇི་སྲིད་འདོད་ཀྱི་བར་དུ་འདུག་པར་བྱའོ།",
    "སེམས་དེ་ལ་དབྱིབས་དང་ཁ་དོག་སོགས་ཇི་ལྟར་འདུག།",
    "ངོས་བཟུང་དང་རྣམ་འགྱུར་ཇི་ལྟར་འདུག་རྣམས་རིམ་པས་བརྟག་ཅིང་དཔྱད་པར་བྱ་སྟེ།",
    "མི་དང་དུད་འགྲོའི་བྱེ་བྲག་ལ་སོགས་པའི་དབྱིབས་སུ་འདུག་གམ་བརྟག།",
    "སེམས་དེ་སྟོང་པར་ངོས་བཟུང་རྒྱུའམ་དེའི་རྣམ་པ་ཅན་དུ་འདུག་གམ་གསལ་བའི་ངོས་བཟུང་དང་དེའི་རྣམ་པ་ཅན་དུ་འདུག་བརྟག།",
    "སྟོང་པར་འདུག་ན་ཅང་མེད་ཀྱི་སྟོང་པ་དང་བར་སྣང་ལྟ་བུའི་སྟོང་པ་ཇི་ལྟར་འདུག་བརྟག།",
    "འོད་དང་ཁ་དོག་མེད་པའི་རང་གསལ་དུ་འདུག་ལ་སོགས་པ་སྒོ་དུ་མ་ནས་བརྟགས་ཤིང་དཔྱད།",
    "ངོས་བཟུང་དང་རྣམ་འགྱུར་ཇི་ལྟར་འདུག་གཟུང་འཛིན་གྱིས་བསྡུས་པའི་ཕྱི་ནང་ཐམས་ཅད་དུ་དཔྱོད་པར་གསུངས་ཤིང་།",
    "མིང་ཡང་རང་བཞིན་མེད་པ་ཡིན།",
    "ཞེ་སྡང་ལྟ་བུའི་རྣམ་པ་ལ་ངོ་བོ་ངོས་བཟུང་རྒྱུ་འདི་ཡིན་མེད་པའི་ཕྱལ་ལེ་བ་ལྟ་བུ་ཞིག་ཏུ་འདུག་བརྟག།",
    "དེ་གཉིས་ཀྱི་རྣམ་པ་དང་ངོ་བོ་ལ་སོ་སོར་བརྟགས་ནས་མཐར་དེ་གཉིས་ལ་ངོ་བོ་བཟང་ངན་སོགས་ཀྱི་ཁྱད་པར་ཅི་འདུག་ལ་སོགས་པ་བརྟག་པར་བྱའོ།",
    "དེ་ནས་གཟུགས་སྣང་དང་སེམས་ཐ་དད་དུ་འདུག་གམ་གཅིག་ཏུ་འདུག།",
    "ཐ་དད་ན་དེ་གཉིས་ཕན་ཚུན་ནམ་ཕྱི་ནང་ངམ་སྟེང་འོག་སོགས་སུ་འདུག་བརྟག།",
    "དེ་ལྟར་འདུག་ན་རང་རྐྱ་ཐུབ་པའི་ངོ་བོ་གཉིས་སོ་སོར་གྲུབ་པ་འདུག་གམ།",
    "སེམས་གཟུགས་སྣང་དུ་སྣང་བ་ཙམ་དུ་འདུག་བརྟག།",
    "གནས་འགྱུ་གང་བྱུང་ཡང་དགག་སྒྲུབ་དང་སྤང་བླང་མི་དགོས་པར་ཐག་ཆོད་དེ་སེམས་གནས་ན་གནས་ཐོག་འགྱུ་ན་འགྱུ་ཐོག་དེ་ཀ་རང་སེམས་གསལ་སྟོང་རང་རིག་རང་གསལ་རང་ཤར་རང་གྲོལ་དུ་ངེས་ཤེས་སྐྱེ་དགོས་པ་ཡིན་ནོ།",
    "དེ་ཡང་རྣམ་རྟོག་དང་སྣང་བ་སྣ་ཚོགས་འཆར་བ་ནི་སེམས་ཉིད་འདི་ཀའི་རྩལ་སྣང་ཙམ་དུ་འདུག།",
    "དེ་རང་རིག་ཅིང་རང་གསལ་བ་གཉིས་ཚོགས་པའི་སེམས་ལ་སེམས་ཀྱིས་ཕྲིག་ཚུད་པའི་མྱོང་བ་རྙེད་པ་ལ་ལས་དང་པོ་པའི་ལྷག་མཐོང་དུ་འཇོག་པར་སྣང་སྟེ།",
    "སྤྱིར་སེམས་ཀྱི་གནས་ཚུལ་ལ་ངོ་བོ་དང་རང་བཞིན་དང་མཚན་ཉིད་དམ་རྣམ་པ་གསུམ་གྱི་ཐ་སྙད་བཞག་ཀྱང་དོན་དུ་སེམས་ཀྱི་ངོ་བོ་ཉིད་ལས་གཞན་མིན་ཏེ།",
    "དོན་ལ་སེམས་ཀྱི་ངོ་བོ་དང་རང་བཞིན་ཕྱོགས་མཐུན་པར་གསུངས་སོ།",
    "འཚོལ་མཁན་གྱི་བློའི་སྤྲོས་པ་ཉིད་ཀྱང་རང་ཞི་རང་ཟད་པ་ནི།",
    "དེ་ལྟར་ན་སེམས་རང་བཞིན་མེད་པ་དང་རང་བཞིན་གྱིས་དག་པ་མི་འཐད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རང་འོད་ལྟ་བུས་རང་རིག་ཅིང་རང་གསལ་བའི་ཤེས་པ་དེ་ཇི་ལྟར་ཡིན་སྙམ་ན།",
    "དེ་ལྟར་ན་རྣལ་འབྱོར་པའི་ཉམས་སྣང་ལ་ཅི་ཤར་ཡང་དེ་ཉིད་སོ་སོ་རང་རིག་དང་རང་བཞིན་འོད་གསལ་གྱི་དོན་དུ་གཏན་མི་རུང་སྟེ།",
    "མཚན་མར་སྐྱེས་པའི་སེམས་སྣང་རང་མཚན་པ་རང་དང་ལྷན་ཅིག་ཏུ་སྐྱེས་པའི་སྟོང་པ་དང་སྦྱོར་བ་སོགས།",
    "རང་རིག་ཅིང་རང་གསལ་བ།",
    "ཕྱོགས་སྔ་མ་ལ་སུན་འབྱིན་ཅི་ཡོད་པ་ཁྱེད་རང་ལ་བཟློག་པའི་ཕྱིར་དང་།",
    "ད་ལྟའི་སྣང་བ་ཅི་འདྲ་ཞིག་ཤར་ཡང་རང་སེམས་སྟོང་པ་ཉིད་སྒོམ་འགགས་པའི་རྩལ་སྤྱི་མཐུན་གྱི་ལས་མ་དག་བར་དུ་དེ་འདྲའི་སྣང་བ་ཙམ་དུ་ཤར་ལ།",
    "མ་བཟུང་མ་བཏང་རང་ག་ཉིད་དུ་ཞོག།",
    "བྱིང་རྨུགས་ཀྱིས་རྨོངས་པའམ་འཕྲོ་རྒོད་ཀྱི་རྟོག་པ་རང་མཚན་པས་གཡེངས་ནས་སེམས་ཀྱི་གནས་ཚུལ་ལམ་འདུག་ཚུལ་ལ་བསྒྲིབས་པར་མ་གྱུར་པའོ།",
    "དེ་ལྟར་ངོ་འཕྲོད་ན་ནི་དགག་སྒྲུབ་ཀྱི་བློས་མ་བཅོས་མ་བསླད་པའི་སེམས་ཀྱི་འདུག་ཚུལ་ལམ་གནས་ཚུལ་ཅི་ཡོད་པ་དེ་ཀ་ཐ་མལ་གྱི་ཤེས་པ་ཡིན་ཚུལ་དང་།",
    "སྐྱེ་བོ་ཙ་ནའི་ཤེས་པ་འདི།",
    "དེ་ལྟར་ཐ་མལ་གྱི་ཤེས་པ་དེ་ཉིད་རང་ངོ་ཤེས་ཤིང་རང་རིག་པའི་དྲན་པས་དོན་ཐོག་ནས་མ་ཡེངས་པའི་ངང་ནས།",
    "དེས་ན་སེམས་ཀྱི་རང་བབས་ཅི་འདུག་དེ་ཀ་རང་ངོ་ཤེས་པའི་དྲན་པས་སྐྱོང་བ་ལས་སྤྲོས་ནས།",
    "རང་ངོ་ཤེས་ཤིང་རང་རིག་པའི་དྲན་པ་དེ་ཉིད་མ་ཡེངས་པས་དེ་དག་ཐམས་ཅད་བཟོ་མ་བཅོས་པར་ལྷུག་པར་སྐྱོང་བ་ཡིན་གྱི།",
    "དེས་ན་གནས་ན་གནས་ཐོག་འགྱུ་ན་འགྱུ་ཐོག་སྣང་ན་སྣང་ཐོག་དེ་ཀ་རང་ངོ་ཤེས་ཤིང་རང་རིག་པའི་དྲན་པས་སྐྱོང་བ་ལས་གཞན་པའི་བསྒྱུར་བགོད་དང་བཟོ་བཅོས་བྱ་མི་དགོས་ཏེ།",
    "དགག་སྒྲུབ་ཀྱི་རྩོལ་བ་མི་བྱ་བར་མི་རྟོག་པར་འདུག་ཀྱང་རུང་།",
    "རྣམ་རྟོག་སྣ་ཚོགས་སུ་འཆར་ཀྱིན་འདུག་ཀྱང་རུང་།",
    "གཉིས་མེད་ཀྱི་ཡེ་ཤེས་རང་དུ་འདུག་ཨང་སྙམ་པའི་གོ་བ་བྱུང་ཙ་ན།",
    "རྣམ་རྟོག་སྣ་ཚོགས་དགག་ཏུ་མི་བཏུབ་པར་འཆར་བར་འདུག་ཙ་ན་གཉིས་མེད་ཀྱི་ཡེ་ཤེས་ཀྱང་དགག་ཏུ་མི་བཏུབ་པར་འཆར་རོ།",
    "རང་ངོ་ཤེས་ཤིང་རང་རིག་པའི་དྲན་པ་མེད་པས་མི་འོང་སྟེ།",
    "འོ་ན་འཇིག་རྟེན་པ་རྣམས་ཀྱང་རྣམ་རྟོག་རང་གར་འདུག།",
    "རྣལ་འབྱོར་པ་ཡང་རང་ག་ཐ་མལ་གྱི་ཤེས་པར་འདུག་པ་ལ་དེ་གཉིས་ཀྱི་ཁྱད་པར་ཅི་ཡོད།",
    "ཁྱད་པར་མེད་ན་འཇིག་རྟེན་པ་ཡང་རང་གྲོལ་དུ་མི་འགྲོའམ་སྙམ་ན།",
    "འོན་ཀྱང་རང་སའི་མཉམ་རྗེས་ཙམ་འབྱེད་དུ་རུང་བར་བཞེད་པ་ལས།",
    "དེ་ནི་རྗེས་ཤེས་དང་རྗེས་སྣང་རང་ཁ་བ་ཞེས་བྱ་བའི་འཁྲུལ་ཤེས་འབའ་ཞིག་ཡིན་ལ།",
    "གནས་ན་ལབ་ལོབ་འགྲོ་འདུག་ཀྱང་།",
    "འདིའི་སྐབས་སུའང་རང་སའི་དྲན་རྒྱུན་གོམས་པ་ལ་བརྟེན་ནས་མཉམ་རྗེས་འདྲེ་བ་ལྟ་བུ་འབྱུང་སྟེ།",
    "རང་བཞིན་བཞག་ཅེས་པ་སེམས་ཀྱི་རང་བཞིན་ནམ་འདུག་ཚུལ་ཇི་ལྟར་ཡོད་པ་དེ་ཀ་ལྟར་མ་བཅོས་པར་འཇོག་པ་སྟེ།",
    "མ་བཟུང་མ་བཏང་རང་ག་ཉིད་དུ་ཞོག།",
    "སེམས་གློད་ཤེས་ན་སེམས་ཀྱི་འདུག་ཚུལ་དང་བཅོས་མིན་གྱི་ངོ་བོ་ལ་སྒྲོ་འདོགས་གཅོད་པའི་ཐབས་ཤིན་ཏུ་ཟབ་པ་ཞིག་ཡིན་ཏེ།",
    "སེམས་གང་ཤར་ཅི་འདུག་དེ་ཀའི་ཐོག་ཏུ་ཞེ་འདོད་ཅི་ཡང་མི་བྱ་བར་རང་ལུགས་སུ་ལྷོད་གློད་པ་ན།",
    "སེམས་ཀྱི་གནས་ལུགས་སམ་འདུག་ལུགས་ཅི་ཡོད་པ་དེ་ཀ་རང་ལུགས་སུ་ཅི་བདེར་འཇོག་པ་སྟེ།",
    "དེ་གོམས་ཙ་ན་རང་ལ་ངེས་ཤེས་སྐྱེ་བ་ཡིན།",
    "ཁོ་རང་ཐོག་ཏུ་གློད་ལ་ཞོག།",
    "དེ་ལྟར་རྟོགས་པ་བརྟན་ཙ་ན།",
    "ཉིན་མཚན་ཐུན་མཚམས་འགྲོ་འདུག་སོགས།",
    "མཉམ་རྗེས་མཚན་ཉིད་པ་མེད་ཀྱང་རང་སའི་མཉམ་རྗེས་ཡོད་པ་ལས།",
    "རང་མེད་པ་ལྟ་བུ་དང་རང་དང་སྣང་བ་ཐམས་ཅད་སྟོང་པའི་རྣམ་འགྱུར་དུ་འཆར་བ་དང་།",
    "འདི་ཡིན་གསུངས་པ་ལ་འདི་དང་པོ་ནས་ངོ་ཤེས་ཐང་བ་ཅིག་འདུག་པ་ལ་སྙམ་པ་འོང་།",
    "ངོ་བོ་སྐྱེ་འགག་དང་བྲལ་ཞིང་རང་བཞིན་ངོས་བཟུང་མེད་པ།",
    "དེ་ལ་གོམས་ཙ་ན་རང་ལ་ངེས་ཤེས་སྐྱེ་བ་ཡིན།",
    "ཕྲ་རགས་དེ་གཉིས་ཀྱི་ངོ་བོ་ལ་ཁྱད་པར་ཅི་འདུག་ཡང་ཡང་བལྟ།",
    "དེ་ལ་སྒྲོ་འདོགས་ཆོད་ན་དེ་དག་དང་སེམས་གནས་དུས་ཀྱི་ངོ་བོ་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ།",
    "རྟོག་པ་དང་སྣང་བའི་འཆར་སྒོ་ཅི་ཤར་ཡང་དེ་དག་བཀག་པ་དང་འགགས་མི་དགོས་པར་རྣམ་པ་གསལ་བཞིན་དུ་ངོ་བོ་ངོས་བཟུང་མེད་པ་གསལ་སྟོང་སྣང་སྟོང་རང་རིག་ཉག་གཅིག་ཏུ་བློ་ཐག་ཆོད་པ་ཅིག་དགོས་ཏེ།",
    "དེ་གཉིས་ལ་ཕན་ཚུན་ནམ་ཕྱི་ནང་ལྟ་བུའི་གཉིས་སྣང་འདུག་ན་སྒྲོ་འདོགས་མ་ཆོད་པས་སླར་ཡང་ལེགས་པར་བརྟག་སྟེ།",
    "དེ་ལྟར་སྒྲོ་འདོགས་ཆོད་པ་ན་དེ་བཞིན་དུ་དུས་གསུམ་གྱི་ཤེས་པ་ལ་ཁྱད་པར་ཅི་འདུག་བལྟ་སྟེ།",
    "ད་ལྟའི་སེམས་ཇི་ལྟ་བུ་འདུག་བལྟས་པས་དུས་གསུམ་གྱི་སེམས་སྐྱེ་འགག་གནས་གསུམ་ལྟ་བུར་མཐོང་ན་སྐབས་དོན་ལ་ཕྲིག་མ་ཚུད་པས་སླར་ཡང་ལེགས་པར་བརྟག་སྟེ།",
    "རང་བྱུང་རང་གྲོལ།",
    "ཐ་མལ་གྱི་སེམས་གང་འདུག་ཅི་བྱུང་ཅི་ཤར་དེ་ཀ་སྒོམ་གྱི་རང་བཞིན་སྟོང་པའི་རྣམ་འགྱུར།",
    "ཟ་སྣོམ་ཁྱམ་དང་འགྲོ་དང་འདུག་པ་དང་།",
    "རང་བྱུང་རང་ཞི་ཆུ་ཡི་རྦ་རླབས་འདྲ།",
    "འོ་ན་དྲན་པས་མ་ཟིན་ཙ་ན་ངོ་བོ་མི་འོང་བར་རྟོག་པ་རང་ག་མ་དེ་དྲན་པས་ཟིན་པ་དང་སྔར་གྱི་རྣམ་རྟོག་ཚོ་འདག་གམ་མི་འདག།",
    "གལ་ཏེ་དྲན་ཡེངས་ལ་ཐོབ་ཤོར་གྱི་འཁུ་ཕྲིག་ཆེན་པོ་འདུག་ན་ད་དུང་སེམས་ཀྱི་རང་བཞིན་དང་གནས་ལུགས་རྒྱུན་མི་ཆད་པའི་ཚུལ་མ་རྟོགས་པས་ལ་བཟླ་ཅུང་ཟད་སྔས་པ་ཡིན་ཏེ།",
    "རྟོག་པ་དེ་ངོས་ཟིན་ཙམ་ཉིད་ནས་རྟོག་པ་ཇི་ལྟར་འདུག་པ་དེ་ཉིད་གྲྭ་མ་ཆག་ཟུར་མ་ཉམས་པ་དེ་ཀ་རང་ལ་དགེ་སྦྱོར་གྱི་ངོ་ཏི་བྱས་ཏེ།",
    "ཁོ་རང་ཐོག་ཏུ་གློད་ལ་ཞོག།",
    "གཞན་གྱིས་མ་བཙེར་ཡང་རང་ལས་ཀྱི་མི་བཟོད་པའི་སྡུག་བསྔལ་ཅི་རིགས་ཀྱིས་ཟིན་ནས་སྡུག་བསྔལ་བར་གྱུར་པ་མཐོང་བའམ།",
    "ཁྱེད་རང་ལྟར་ན་རྟོག་པ་གསལ་མི་གསལ་གྱི་ཁྱད་པར་དེ་ཀ་གོ་རྟོགས་ཀྱི་ཁྱད་པར་དུ་འགྱུར་དགོས་པས་གོང་དུ་སྨྲ་བ་དང་འགལ་བར་འགྱུར་བའི་ཕྱིར་དང་།",
    "སྔར་གྱི་ཉམས་དང་མྱོང་བའི་དྲི་མ་ཐམས་ཅད་དག་ནས་ལམ་གྱི་རྟོགས་པ་དང་རང་བཞིན་གྱི་གནས་ལུགས་འདྲེས་ཏེ་མཉམ་རྗེས་དང་དྲན་ཡེངས་མེད་པ་ཞིག་སྟེ།",
    "རྩེ་གཅིག་དུས་སུ་ངོ་བོ་རྟོགས།",
    "རོ་གཅིག་དུས་སུ་མཚན་ཉིད་རྟོགས།",
    "སེམས་ཀྱི་ངོ་བོ་དང་རང་བཞིན་གཉིས་ངོ་བོ་གཅིག་ལ་ལྡོག་པ་ཐ་དད་ཙམ་དུ་གསུངས་པས་ཁྱད་པར་མེད་དོ།",
    "དྲན་པས་ཟིན་ཙ་ན་སྐྱེ་མེད་ཀྱི་ངོ་བོ་མཐོང་བའི་སྒོམ་ཇི་ལྟ་བ་ཐོབ་པས་ཐོབ་པ་ཡོད་པ་དང་།",
    "རོ་གཅིག་དུས་སུ་མཉམ་རྗེས་འདྲེ།",
    "རྩེ་གཅིག་དུས་སུ་ཨ་འཐས་ཀྱི་རྒྱུ་འབྲས།",
    "རོ་གཅིག་དུས་སུ་ནམ་མཁའ་ལྟ་བུའི་རྒྱུ་འབྲས།",
    "གནས་འགྱུ་རོ་མཉམ་དུ་འདྲེས་ཤིང་རང་ངོ་ཤེས་པའི་དྲན་རིག་ཡོད་པ་ཞིག་དགོས་ཏེ།",
    "རྩེ་གཅིག་དུས་སུ་ངོ་བོ་རྟོགས།",
    "རང་མིན་པའི་དྲན་རྟོག་ཅིག་འདུག་གམ་ལྟོས་དང་།",
    "བདེ་གསལ་མི་རྟོག་པའི་ཉམས་ཀྱི་ངང་དུ་ས་ལེ་སིང་ངེ་གནས་ཀྱང་རང་རིག་པའི་ངེས་ཤེས་ཀྱི་ཕྲིག་མ་ཚུད་ན།",
    "དེ་ལ་གོམས་ཙ་ན་རང་ལ་ངེས་ཤེས་སྐྱེ་བ་ཡིན།",
    "མཚན་རྟགས་ལ་སོགས་པ་བྱུང་ནས་དེ་ལ་རློམ་སེམས་དང་དགའ་མི་དགའ་འདུག་ན་བདུད་ཞུགས་པ་ཡིན་པས།",
    "ལམ་གྱི་རྟོགས་པ་དང་རང་བཞིན་གྱི་གནས་ལུགས་འདྲེས་ནས།",
    "དེ་ལ་ད་དུང་གོམས་པར་བྱ་རྒྱུའམ་གསལ་དུ་འགྲོ་རྒྱུ་ཅུང་ཟད་ཅིག་འདུག་ཀྱང་ངོ་བོ་མ་མཐོང་།",
    "ལུས་སེམས་དང་སྣོད་བཅུད་ལ་མ་དག་པའི་སྣང་བ་དང་འཛིན་པ་ཅུང་ཟད་ཙམ་འདུག་ཀྱང་ཡོན་ཏན་མ་སྐྱེས།",
    "རིག་ཐོག་ན་གཉིས་སུ་འདུག་གམ་ལྟོས་དང་།",
    "ཨེམ་ཆེའི་ཨ་ཞང་།",
    "ཆེས་ཐོག་མར་ངས་ར་ཕིལ་མཐོང་སྐབས་ང་རང་ལོ་ན་བཞི་གསུམ་བཅུ་གཉིས་ལ་སོན་ཞིང་།",
    "བགྲང་བྱ་བཅུ་གཉིས་ཀྱི་འཕོ་མཚོ་མཐའ་འགྱུར་ནི་རྡོ་ཡི་ཁང་པ་གསར་པ་མང་པོ་ཞིག་གསར་བསྐྲུན་བྱས་འདུག་ལ།",
    "ངེད་ཀྱི་བློ་ཡུལ་ལས་འདས་པ་ཞིག་ལ་གྲུ་ཁང་རྙིང་པ་དེ་དང་གྲུ་རྣམས་ད་དུང་ཡང་འདིར་གནས་འདུག་ཀྱང་།",
    "ང་རང་ཁེར་རྐྱང་མཚོ་ཁ་རྒྱུད་ནས་སྐྱོ་བསངས་ལ་འགྲོ་དུས་གྲོང་རྡལ་ནས་གྱོན་པའི་ལྷམ་དེའི་འོག་ཏུ་བྱེ་མ་དེ་དག་ཀྱང་ཧ་ཅང་འཇམ་པའི་ཚོར་བ་ཞིག་སྦྱིན།",
    "འདི་རུ་གྲུ་ཁང་རྙིང་པ་དེའི་འགྲམ་དུ་མི་ཞིག་འདུག་ལ།",
    "ཁོ་རང་ལོ་ན་བཅུ་གཉིས་ཀྱི་རིང་ལ་ཧ་ཅང་རྒས་སུ་ཕྱིན་ཟིན་ལ།",
    "ང་རང་ཅི་ཞིག་སྒྲུབ་འདོད་པ་རྣམས་ངེད་ཀྱིས་ཞང་པོ་ལ་ཞུས་པ་ཡིན།",
