    "ནང་གི་རྐྱེན་སྟོབས་ལྡན་དང་འཚོག་ན་རྣམ་པ་གཞན་དུ་སྣང་སྲིད་པས།",
    "རྫུ་འཕྲུལ་གྲུབ་པས་རི་བྲག་ཟང་ཐལ་དང་།",
    "དེ་བཞིན་ནམ་མཁའ་ལ་དངོས་པོ་མེད་པས་འགག་པ་མེད་མོད་ཀྱི།",
    "གདུལ་བྱའི་གཞན་སྣང་གི་སྣང་བ་མུ་མེད་ཀྱང་དམིགས་པ་མེད་པར་རྩོལ་མེད་ལྷུན་གྲུབ་ཏུ་མཁྱེན་ནོ།",
    "དེ་ལྟར་ན་མཐར་ཐུག་གི་དོན་ལ་འཁོར་འདས་ཀྱི་སྣང་བ་ཐམས་ཅད་རང་སེམས་ཀྱི་རང་སྣང་ཡིན་ལ།",
    "ཁྱོད་ལ་མེ་ཚ་བར་མི་སྣང་ངམ།",
    "སྣང་ན་སྣང་བ་དེས་དེ་ལྟར་ཡིན་ནོ་ཞེས་བཞག་གི།",
    "ཡུལ་རང་གི་ངོ་བོས་ཚད་གྲུབ་ངེད་ཀྱི་ལུགས་ལ་མེད་དོ།",
    "གལ་ཏེ་མེ་ཚ་སྣང་བློ་ཡི་སྣང་བ་ཡིན་མོད།",
    "མེ་དེཡོད་པར་ཁྱོད་ཀྱིས་ཇི་ལྟར་ཤེས་ཞེས་དྲིའོ།",
    "བློ་གང་གིས་མི་ཤེས་པའི་ཡུལ་ནི་བློ་སྣང་མིན་ཞེས་བརྗོད་མི་རིགས་ཏེ།",
    "སྣང་མིན་པར་གང་གིས་འཇོག།",
    "བདག་མ་སྐྱེས་པའི་དུས་ནས་རང་གི་ཕ་མའི་ལུས་དང་ཁང་པ་སོགས་ཡོད་པ་སོགས་ཀྱི་ཕྱིར་ཞེ་ན།",
    "ཡུལ་ཅན་བློ་གང་གི་གང་སྣང་བ་མིན་པའི་མ་ཤེས་པའི་ཕ་མ་སོགས་ཀྱི་ལུས་ཡོད་ཟེར་རམ།",
    "དུས་ཐ་དད་ཀྱི་སྣང་ཡུལ་ཐུན་མོང་བ་མི་སྲིད་ལ།",
    "ཕ་མའི་ལུས་སོགས་དངོས་སུ་མཐོང་བའི་གང་ཟག་གཅིག་ཀྱང་མི་སྲིད་པར་ཐལ་ཟེར་ན་ཐམས་ཅད་ཐུན་མོང་བའི་སྣང་ཡུལ་ཞེས་པ་བློ་གང་གིས་མཐོང་ནས་འཇོག།",
    "རེ་ཞིག་ལས་མཐུན་པའི་བག་ཆགས་ཅན་ལ་བརྟན་པར་སོགས་རྟག་ཏུ་དེ་ལྟར་གནས་པའི་སྣང་བ་ཤར་ཁ་ནི་བདེན་ཀྱང་།",
    "ངེད་ཅག་གི་སྣང་ཡུལ་གཅིག་ཕྱི་དོན་ན་ཡོད་སྙམ་དུ་རྟོག་པས་བཏགས་ཀྱི་བཏགས་པ་ལྟར་ཡོད་དགོས་པ་མིན་མོད།",
    "རེ་ཞིག་ཕྱི་དོན་འདོད་པའི་ངོར་དེ་ལྟར་བཞག་དགོས་སོ།",
    "དེས་ན་ཇི་སྲིད་མཐུན་སྣང་གི་ཙ་",
    "སྐྱེ་བོ་འདྲ་སྣང་གི་བག་ཆགས་སམ་ལས་ཀྱི་ནུས་པ་དེ་ཉིད་ལ་སྣང་ཡུལ་དུ་ཞོན་པ་ཙམ་ཡིན་ནོ་དགེ། ། བློ་ལ་ཇི་ལྟར་སྣང་བའི་ཚུལ་བསླུ་མེད་དུ་མྱོང་བ་འདི་ལས་ཀུན་རྫོབ་ཅེས་བྱ་བ་ཅུང་ཟད་གཞན་དུ་མི་དགོས་ལ།",
    "དུག་གིས་ན་བ།",
    "སྣང་བ་དེས་བློ་མ་ཚིམ་པར་སྣང་བ་ལྟར་དོན་རང་ངོས་ནས་ཡོད་དགོས་ན་བདེན་གྲུབ་ཏུ་འགྱུར་མོད་དེ་མི་སྲིད་དོ།",
    "མི་རྟོག་པས་ནི་ཅིར་ཡང་མི་འཛིན་མོད་ཀྱི་རྟེན་འབྱུང་གི་སྣང་བ་མེད་པར་མི་རྙེད་དེ།",
    "ཡོད་ན་དོན་རང་གི་ངོ་བོ་ཉིད་ཡོད་པར་འགྱུར་ཞིང་།",
    "འོ་ན་ཡུལ་མེའི་ཚ་བ་ཐ་སྙད་དུ་རང་གི་ངོ་བོས་ཇི་ལྟར་མེད་སྙམ་ན།",
    "ཐ་སྙད་དུ་ཡུལ་ཡུལ་ཅན་གཉིས་ཀ་ཡོད་མོད།",
    "མེ་ལ་གནས་སུ་སོང་བ།",
    "ཟས་སུ་སོང་བ་སོགས་སྣ་ཚོགས་ཡོད་པའི་ཕྱིར།",
    "རྟོག་པ་དེའི་ངོར་བྱས་ཏེ་དེ་ལྟར་བརྗོད་ཀྱི་དོན་གྱི་རང་གི་ངོ་བོས་གྲུབ་པ་མིན་པའི་ཕྱིར་ཏེ།",
    "རང་གི་མཚན་ཉིད་ཀྱིས་མ་སྐྱེས་པའམ།",
    "འདི་རྟོགས་ནས་བལྟ་བྱ་ཐུན་མོང་བ་འདོད་པའི་ལུགས་ཀྱི་ཐ་སྙད་ཚད་གྲུབ་དང་།",
    "ཕྱི་དོན་ཚད་གྲུབ་འབའ་ཞིག་གིས་བསྒྲུབ་ན།",
    "སུའི་ལུགས་ཀྱི་དེའང་དེ་དག་གི་ངོར་འགྲུབ་སྟེ།",
    "གཉིས་སྣང་གི་སྤྲོས་པ་མི་མངའ་མོད།",
    "དེས་བདེན་གཉིས་དབྱེར་མེད་གཟིགས་པ་ཡིན་པས་མཁྱེན་གཉིས་ཡོད་དགོས་ལ།",
    "དེ་ལྟར་རྣམ་པར་བཞག་པའང་འགྲུབ་མོད་ཀྱི།",
    "ཟླ་བ་དངོས་མ་འཁྲུལ་བའི་སྣང་བར་འདོད་པའང་རྟེན་འབྱུང་གི་རིགས་པས་སྐྱེ་མེད་དུ་གྲུབ་པའི་ཕྱིར།",
    "མཉམ་རྗེས་ཐ་དད་མེད་པའི་གཟིགས་པ་དང་།",
    "བདེན་གཉིས་ཐ་དད་མེད་པའི་དུས་གཅིག་ཆར་གཟིགས་པ་དང་།",
    "མཁྱེན་གཉིས་ཐ་དད་དུ་མེད་པའི་གཟིགས་པ་ཡིན་པའི་ཕྱིར།",
    "འདིའི་གཟིགས་ཚུལ་འཕགས་པ་སློབ་པ་རྣམས་ཀྱིས་ཇི་བཞིན་གཞལ་མི་ནུས་ན།",
    "ཡིད་ཆེས་པའི་རིགས་པས་གཞི་དུས་ནའང་བདེན་གཉིས་འགལ་མེད་དོན་གཅིག་ཡིན་པའི་ཚུལ་གྱིས་མོས་པར་བྱའོ།",
    "ང་བདག་མེད་ཀྱང་བྱིས་པའི་ངོར་དེ་ཡོད་པ་ལྟར་སྣང་བ་གཟིགས་པ་མི་འགལ་བ་བཞིན་དུ།",
    "སྣང་སྲིད་སྐུ་དང་ཡེ་ཤེས་སུ་གཟིགས་ཀྱང་མ་དག་པའི་ངོར་སྡུག་ཀུན་ལྟར་སྣང་བ་དེ་ལྟར་གཟིགས་ནས་དེ་བསྟན་པ་མི་འགལ་ཏེ།",
    "འདིར་འབུམ་ཊིག་བལྟ་སྐབས་འབུམ་གྱི་གཞུང་ཚིག་ཞིག་གི་རྐྱེན་བྱས་ཏེ་དྲན་པ་བརྗེད་ཐོར་བྲིས་པའོ། ། ཡང་ཁ་ཅིག་ན་རེ།",
    "ཉན་ཐོས་པའི་ལམ་གྱི་རིགས་པས་དགག་བྱ་གང་ཟག་གི་བདག་འགོག།",
    "དེ་ལྡོག་པས་དེ་ལས་བྱུང་བའི་ཉོན་མོངས་ཐམས་ཅད་ཁེགས།",
    "འདུ་ཤེས་སོགས་འགག་པ་སེམས་གཏན་དུ་རྒྱུན་ཆད་པར་འདོད་མོད།",
    "དེ་དག་གི་དགག་བྱ་ཁེགས་པ་དེ་དག་ལྷག་མཐོང་གི་སྟོབས་ཀྱིས་ཡིན་གྱིགཞན་དུ་ན་འདུ་ཤེས་མེད་པའི་སྙོམ་འཇུག་ཐོབ་པས་རེ་ཞིག་སེམས་འགགས་ཀྱང་སླར་སྐྱེ་བ་དང་ཅིས་མི་འདྲ།",
    "རེ་ཞིག་ཚོགས་བདུན་འགག་ཀྱང་ཀུན་གཞི་ཡོད་པ་དེ་ལས་སླར་སྐྱེ་བར་འགྱུར།",
    "འདུ་ཤེས་མེད་པའི་སྙོམ་འཇུག་གིས་རེ་ཞིག་ཚོགས་དྲུག་ཁེགས་ཀྱང་ཀུན་གཞི་ལྷག་མར་ལུས་པ་དེ་ལས།",
    "ཀུན་རྫོབ་མི་གཟིགས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་བདེན་གཉིས་གཅིག་ཆར་གཟིགས་པའི་ཁས་ལེན་མེད་པར་འགྱུར་རོ།",
    "མ་ཆད་ན་དེ་རྣམ་མཁྱེན་གྱིས་མི་གཟིགས་དོན་ཅི་ཡོད་ན།",
    "གཟིགས་པའི་ཕྱིར་སྟོབས་བཅུ་པར་བཞག་སྟེ་ཁམས་སྣ་ཚོགས་དང་མོས་པ་སྣ་ཚོགས་སོགས་མཁྱེན་པ་ཀུན་རྫོབ་ཡིན་པའི་ཕྱིར།",
    "ཐོ་བུམ་དུས་མཉམ་པ་ལ་གཅིག་གཅིག་གིས་བསྐྱེད་པ་མིན་པ་ནི་འགྲུབ་མོད།",
    "ཕྲད་ན་ཕྲད་དུས་དེར་གཅིག་ཤོས་མེད་འདྲའོ་དཔྱོད། ཐལ་འགྱུར་པའི་ལུགས་ལ་རང་རིག་དང་ཀུན་གཞི་ཐ་སྙད་དུ་ཡོད་མེད་གང་ཁས་ལེན་ཟེར་ན།",
    "ཐ་སྙད་དུ་དེའི་རྣམ་བཞག་མེད་པའི་ཆ་ནས་མེད་པར་ཁས་ལེན་མོད།",
    "ཐལ་འགྱུར་ལུགས་ལ།",
    "ཚོགས་དྲུག་གིས་ཡུལ་དུས་ཤེས་པས་ཆོག་གི།",
    "རང་རིག་གི་ཐ་སྙད་མ་བྱས་ཀྱང་རུང་།",
    "ཡང་དག་པར་ན་མར་མེ་ལ་གསལ་བྱེད་གཞན་མི་དགོས་པར་གྲུབ་པ་ཡིན་མོད།",
    "རང་རིག་གི་ཐ་སྙད་བཏགས་པས་གྲུབ་པ་ནི་མི་འགོག་སྟེ་ཁེགས་མི་ནུས་ལ།",
    "བུམ་པ་བཟུང་བས་བུམ་མིན་སེལ་བ་ལྟ་བུ་མ་ཡིན་དགག་གི་གཞན་སེལ་ཏེ་བུམ་པ་ཀ་བ་མིན་པ་ལྟ་བུ།",
    "བུམ་པ་ལ་ཀ་བ་མེད་པ་ལྟ་བུ་མེད་དགག་གི་གཞན་སེལ་ལོ།",
    "ང་ཕྱོགས་འདིར་བུམ་མེད་སོགས་མེད་པ་བཞི་པོའང་དོན་གྱི་ངོ་བོ་མེད་དགག་གི་གཞན་སེལ་ཏེ་ཡོད་པ་སེལ་ལོ།",
    "ཕྱི་རོལ་རི་མོར་བྲིས་པ་སོགས་ལྷར་དམིགས་པའི་མཚན་མ་བཟུང་ནས་དེར་མཆོད་སོགས་ཀྱིས་ལས་འགྲུབ་པས་ན།",
    "ཕུང་ཁམས་རང་བཞིན་གྱིས་ལྷའི་གདན་ཡིན་པས་ནང་གི་དཀྱིལ་འཁོར་ཆེས་ཟབ་ལ།",
    "བྱ་བྲལ་དུ་སྤྱོད་པ་གསུམ་རྣལ་འབྱོར་པའི་བློ་གདེང་ལྟར་ཉམས་སུ་བླང་བ་ནི་ནང་ཟབ་མོའི་སྒྲུབ་པ་ཕྱི་ཡི་སྟོབས་ལས་འབུམ་འགྱུར་གྱིས་འཕགས་པ་ཡིན་པས་འདི་འདྲའི་ཚུལ་ལ་ངེས་ཤེས་ཁྱད་པར་ཅན་ཞིག་རྒྱུད་འགྲེལ་མཐོང་མ་ཐག་སྐྱེས་པས།",
    "རྫོགས་རིམ་ལ་རྡོ་རྗེ་འཆང་གིས་དབུགས་དབྱུང་བ་ཞེས་གསུངས།",
    "དང་པོ་འཇུག་ཤེས་དྲུག་གི་འཁོར་སེམས་བྱུང་།",
    "འཁོར་སེམས་བྱུང་ང་གཅིག་གི་ཁོང་ཅི་རིགས་པར་སོ་གསུམ་པོ་འདུ་ཞིང་།",
    "ཟླ་ཉི་མཚམས་ཀྱི་སྣང་བ་གསུམ་མོ།",
    "དོན་དམ་དབྱིངས་ཡེ་ཟུང་འཇུག་རང་བྱུང་གི་ཡེ་ཤེས་སུ་རྒྱུའམ་ཚུལ་གཅིག་པ་ཡིན་ཏེ།",
    "ཕན་ཚུན་གཅིག་གིས་གཅིག་བྱིན་གྱིས་བརླབས་ཤིང་དབྱེར་མེད་པ་ཡིན་ཏེ།",
    "སྤྲོས་པ་ཕྱོགས་རེ་ཆོད་པའི་རྣམ་གྲངས་པའི་དོན་དམ་དང་།",
    "གནས་ལུགས་བདག་ཉིད་ཆེན་པོར་བྱུང་གི་ཡེ་ཤེས་གཅིག་ཏུ་ངེས་པ་ཡིན་ཏེ།",
    "རང་གི་རང་བཞིན་ཅིར་ཡང་མ་གྲུབ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཚིག་རྩོམ་མཁས་པས་རྒྱ་གཞུང་གི་ཉམས་བཏོད་ན།",
    "ཟབ་མོ་ལྟ་བའི་སྣང་བ་མཆོག་སྤྲིན་འཕགས་པ་ཙ་",
    "ཡབ་སྲས་ཉིན་མོར་བྱེད།",
    "བརྡའ་སྤྲོད་རྒྱ་མཚོར་གཟིགས་པའི་སྤྱན་སྟོང་རྣམ་བཀྲ་ཕས་རྒོལ་སྤྲིན་སྐྱེས་ཀྱི།",
