    "བསྟན་བཅོས་ཀུན་ལས་བཏུས་པར་ནི།",
    "གཉིས་ལྡན་བསྐལ་པར་ཡང་དག་གྲགས།",
    "བཞི་འབུམ་རྩོད་དུས་ཤེས་པར་བྱ།",
    "ཞེས་གསུངས་ཤིང་།",
    "དཔལ་དུས་ཀྱི་འཁོར་ལོ་འདིར་ཇི་ལྟར་གསུངས་པ་ནི།",
    "གཟའ་རྣམས་སྟོང་པར་འཇུག་པའི་དུས།",
    "ཅེས་གསུངས་ཏེ།",
    "འཇིག་རྟེན་ཆགས་ཤིང་ཞིག་པའི་བྱ་བ་རྫོགས་ནས་སྟོང་པར་གནས་པའམ།",
    "ཡེ་ལེའི་བརྒྱ་ཞེ་དགུ་པར།",
    "དུས་བཞི་ཆེན་པོ་གཅིག་རྫོགས་པ་ན་གཟའ་ཐམས་ཅད་སྟོང་པར་བསྐུལ་བའམ་འཇུག་པར་འགྱུར་རོ་ཞེས།",
    "ཞེས་གསུངས་ཏེ།",
    "འཁོར་ལོ་ཅན་གྱི་དུས་བཞི་དང་བྱེད་པའི་དུས་བཞི་ཡུན་མི་མཚུངས་ཀྱང་ས་དུམ་བུ་འདིར་དུས་བཞི་ནི་དེ་གཉིས་མཉམ་དུ་རྫོགས་ཤིང་གཟའ་སྟོང་པར་འཇུག་ལ།",
    "རབ་བྱུང་ཞེས་པར་འགྱུར་བ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ནག་པའི་ཟླ་བ་ལ་སོགས་པར་ཡང་འགྱུར་རོ།",
    "སྒྲ་གཅན་གྱི་དུས་མེ་མེ་བཞིའི་༡༣༨སྟེང་དུ་གནས་པས་གཟའ་རྣམས་སྟོང་པར་ཞུགས་པའི་ཐ་སྙད་བྱེད་ལ་སླར་ལོ་ཟླ་གཟའ་སྐར་ཐམས་ཅད་ཀྱི་དང་པོ་ནས་ལོངས་སྤྱོད་ཀྱི་ངེས་པ་གསར་དུ་འཆར་བ་ཡིན་ནོ།",
    "དྲག་པོའི་དུས་ཀྱི་ལོ་ཆེན་གྱི་མཚམས་གང་ལ་ཡང་བྱེད་པའི་དྷུ་བ་སྟོང་མི་ནུས་པར་སྣང་ཡང་དེ་ནི་བྱེད་པའི་ལོངས་སྤྱོད་རགས་པར་བྱས་པའི་སྐྱོན་དུ་ཟད་པས་གནས་ཅུང་ཟད་སྟོང་མ་ནུས་ཀྱང་སྐྱོན་མེད་དོ།",
    "ཉི་མའི་རྟག་ལོངས་སོགས་སོ་སོར་བྱིན་ཏེ་རྐང་རྩིས་བྱས་པ་ན་སྟོང་པ་ལས་ལངས་མ་ཐག་པའི་ནག་པའི་དཀར་ཚེས་གཅིག་ལ་གཟའ་གཅིག་ཆུ་ཚོད་བཅོ་ལྔ།",
    "དྷུ་བ་སྟོང་རྗེས་རྟག་ལོངས་ཁོ་ན་སྟེར་གྱི་རྐང་རྩིས་མི་བྱེད་པར་བཞེད་པ་རྣམས་ནི་མི་རིགས་ཏེ།",
    "སྟོང་པ་ལས་ལངས་རྗེས་ལོངས་སྤྱོད་ཐམས་ཅད་སླར་འཆར་བར་གསུངས་ཀྱི་རྐང་ལོངས་སྟོངས་པར་མ་གསུངས་པའི་ཕྱིར་རོ།",
    "རྒྱུད་ལས་དངོས་སུ་གསུངས་པའི་སྟོང་འཇུག་དང་དུས་མ་མཚུངས་ཤིང་།",
    "ཞེས་གསུངས་ཏེ།",
