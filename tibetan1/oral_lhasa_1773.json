    "རྣམ་པར་ཤེས་པའི་ཁམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "དེ་ནི་མ་རིག་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "འདུ་བྱེད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མྱིང་དང་གཟུགས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "སྐྱེ་མཆེད་དྲུག་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ཚོར་བ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "སྲེད་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ལེན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "སྲིད་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "སྐྱེ་བ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "རྒ་ཤི་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "དེ་ནི་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "དེ་ནི་ནང་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ཕྱི་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "དངོས་པོ་མྱེད་པའི་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "གཞག་པ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "སྟོབས་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "རྣམ་པར་ཐར་བ་བརྒྱད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་དགུ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "བྱམས་པ་ཆེན་པོ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "དེ་ནི་རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "དགྲ་བཅོམ་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ཚོར་བ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "འདུ་ཤེས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "འདུ་བྱེད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མྱིག་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སྣ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ལྕེ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ལུས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ཡིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "གཟུགས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སྒྲ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "དྲི་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "རོ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སའི་ཁམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ཆུའི་ཁམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མྱེའི་ཁམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ནམ་མཁའི་ཁམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མ་རིག་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "འདུ་བྱེད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གཟུང་བ་དང་།",
    "མྱེད་པར་བྱ་བའི་༺འབུམ་ཆ་",
    "མྱིང་དང་གཟུགས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སྐྱེ་མཆེད་དྲུག་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ཚོར་བ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སྲེད་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ལེན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སྲིད་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སྐྱེ་བ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "རྒ་ཤི་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ནང་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ཕྱི་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་༺འབུམ་ཆ་",
    "སྟོབས་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "འཕགས་པའི་བདེན་པ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "བསམ་གཏན་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སྨོན་པ་མྱེད་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མྱི་འཇིགས་པ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཡོངས་སུ་གཟུང་བ་དང་། ༺འབུམ་ཆ་",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "བྱམས་པ་ཆེན་པོ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "དགྲ་བཅོམ་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་པ་ཡིན་ནམ།",
    "མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "ཚོར་བ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "འདུ་ཤེས་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "འདུ་བྱེད་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
    "མྱིག་ཡོངས་སུ་གཟུང་བ་དང་མྱེད་པར་བྱ་བའི་ཕྱིར་མྱི་སློབ་བོ།",
