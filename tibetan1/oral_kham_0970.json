    "དམ་བཅའ་ཆེན་པོ་བཞི་འདུག་སྟེ།",
    "སྐུ་རིམ་གྱི་མང་ཇ་སྒྲུབ་ཀྱི་གདའ།",
    "སྐུ་རིམ་གྱི་རྣམ་རྒྱལ་སྒྲུབ་པར་གདའ་ལགས་ཞེས་ཞུས་དུས།",
    "ཁོང་རང་རྣམས་ཀྱི་ཚོགས་རྫོགས་ཏེ་མཆི།",
    "འོད་གསལ་གྱི་སྣང་བ་རབ་འབྱམས་སུ་འདུག་པས།",
    "ཕྱི་ནས་གཞན་གྱི་ལན་ཁྱེར་འོང་བ་སོགས་མ་བྱེད་ཅིག་ལོ་འདོད་ལྗོན་ཤིང་ཆགས་ནས་འདུག།",
    "བ་གླང་བརྟུལ་ཞུགས་ཉམས་ནས་འདུག།",
    "ཁྱི་ཕག་སྤྱོད་པ་ནུབ་ནས་འདུག།",
    "མི་གཙང་རྐྱལ་པ་རལ་ནས་འདུག།",
    "ནན་ལྟར་མ་བཟང་བའི་ལྟས་འདི་བཞིན་འདུག་པས།",
    "ཀྥ་ཀློག་དུས་མཆུ་སྦྱོར་བས།",
    "འོག་ན་འདུག་པ་དེ་ལ་མགོར་ན་རོ་གུག་འགྲེང་ཀླད་ཀོར་ཏེ།",
    "གྷ་ཛྷ་ཌྷ་དྷ་བྷ་རྣམས་ཡིན་ལ་འདི་རྣམས་ཀློག་དུས།",
    "སྤངས་པའི་མིང་དཔེར་ན་ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷི་ལྟ་བུ་ལ་ཨོཾ་དོར་བའི་ཨ་དེ་ཉིད་བརྩི་བར་བྱ་བ་ཡིན་ལ།",
    "འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པའང་ད་ལྟར་དེ་ན་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་འདི་ལྟར་འོད་ཆེན་པོ་རབ་ཏུ་གདའ་བ་འདི་སུའི་ལྟས་སྔོན་དུ་བྱུང་བ་ལགས།",
    "དེ་བར་སྣང་ལ་ལུས་མི་སྣང་བར་འདུག་ནས།",
    "འདུག་པ་མེད་དོ།",
    "རྣམ་པའི་མཆོག་ཐམས་ཅད་དང་ལྡན་པའི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་མི་འཐོབ་པའི་ཚུལ་གྱིས་མ་ཐོབ་ཀྱི་བར་དུ་མི་འདུག།",
    "དེ་ལྟ་བུའི་དམིགས་པ་ཅན་གྱི་བཀའ་མཆིད་མི་གདའ་སྟེ།",
    "གང་ཟག་སྒེར་པ་མང་པོ་འདུག་དེ་ཚོའི་ནང་ནས་གཙོ་བོ་རྒྱ་གར་གཞུང་དང་མི་མང་།",
    "ཕྱི་ལོ་༢༨ ལོར་མཇུག་སྒྲིལ་བྱེད་འཆར་ཡོད་འདུག་བོད་མི་མང་དང་།",
    "གཞན་ཡང་རྒྱལ་ཁབ་མང་པོ་ཞིག་ནས་སྐབས་འཕྲལ་གདོང་ལེན་གནང་བར་ང་རང་ཧང་སངས་བྱུང་།",
    "ཆབས་ཅིག་དུས་དང་རྣམ་པ་ཀུན་ཏུ་དྲན་གསོ་ཞུ་རྒྱུ་ཡིན།",
    "དེང་སང་རང་ཅག་བོད་དང་བོད་ཆེན་པོར་བར་མ་རབ་བྱུང་དང་།",
    "སླར་ཡང་རང་སེམས་ལྷ་ཡི་ཐུགས་ཀ་ནས།",
    "པཎ་ཆེན་གོང་མས་མཛད་པའི་འབྲིང་པོ་ཞིག་སྣང་བ་ལ་མཆོད་སྦྱིན་གྱི་སྐོར་སོགས་འགའ་ཞིག་ནི་ཤིན་ཏུ་བསྡུས་འདུག་པས།",
    "ཚིག་སྦྱོར་དང་དག་ཆ་དེང་དུས་དང་མི་མཐུན་པ་ཅུང་མང་ཙམ་འདུག་པ་དང་།",
    "དེ་ཤིན་ཏུ་ཡིན་པ་འདུག་ཅེས་གསུངས།",
    "དང་པོ་ནི་ཚོགས་བསགས་པའི་བློ་ལྡན་དབེན་པར་གནས་ཏེ་བརྩོན་འགྲུས་བརྩམས་པས་ཨ་ར་པ་ཙ་ན་ལ་སོགས་པ་དང་ཏང་ཐ་ཨོ་ཨི་ཊི་མ་ཊི་ཀི་ཊི།",
    "འདྲིས་པ་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་བའི་ལམ་ལ་བློ་ལྡན་མངོན་སུམ་དུ་སློབ་པའོ།",
    "ཕྱི་མ་ནི་མདུན་ན་འདུག་པའོ།",
    "སྤྱིའི་དབྱེ་བ་ནི་དེ་དག་ཀྱང་ནས་ཏེ་སྐྱེས་བུ་ཟུང་བཞི་ནི་རྗེ་བཙུན་ཀྱིས་བཀའ་སྔ་མའི་ཐ་སྙད་ལ་བརྟེན་ནས་བསྟན་པ་འདི་ལ་འཇུག་པའི་རྒྱུར་ཉན་ཐོས་ཞུགས་གནས་བདུན་དང་རང་རྒྱལ་བའི་མིང་དུ་བཏགས་པར་ཟད་པས་མཚན་ཉིད་ནི་གཞན་ཁོ་ནའོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ལམ་གྱིས་ཐོབ་པར་བྱ་བའི་འབྲས་བུ་ནི་གཞན་ལ་བསྟན་པས་གཞན་གྱིས་ཐོབ་པ་སྟེ།",
    "ལུང་དང་རང་བཞིན་དང་འབྲས་བུའི་རྟགས་ལས་སམ།",
    "འདིས་ནི་རྟེན་དང་བརྗོད་བྱ་དང་འབྲས་བུ་དང་རང་བཞིན་བཞིའི་ཁྱད་པར་ཅན་གྱི་གདམས་ངག་སྟོན་ཅིག་ཅེས་གསུངས་པས་སྤྱིར་བསྟན་པ་སྟེ།",
    "ཐབས་ཀྱིས་ཞུམ་པར་བྱེད་པ་ནི་དཀའ་བའི་སྤྱོད་པ་ཡུན་རིང་པོས་སྐྲག་པར་བྱེད་ཅིང་རང་ཉིད་ཞི་བའི་འབྲས་བུ་མྱུར་དུ་འཐོབ་པ་ལ་སྦྱོར་བའོ།",
    "འདུག་པ་ནི་སྐྱིལ་ཀྲུང་ལ་སོགས་པས་སོ།",
    "མེད་པ་དང་སྟོང་པ་དང་རང་བཞིན་མེད་པ་དང་།",
    "སྙོམས་པར་བྱེད་པ་ནི་དེ་གསུམ་གཞན་དང་རང་ཉིད་ལ་ཕན་ཚུན་མེད་པར་ཡིད་ལ་བྱེད་པའོ།",
    "ཆེན་པོའི་འབྲིང་ལ་གཉིས་ལས་གཅིག་དུས་གསུམ་གྱི་འཕགས་པ་ཐམས་ཅད་སྐྱེད་པ་ཉིད་ནི་དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ནས་སོ།",
    "དེས་ན་རང་བཞིན་ཞེས་བྱ་བའང་ཐ་སྙད་ཙམ་དུ་ཟད་པས་ན་གང་རང་བཞིན་མ་ཡིན་པ་ཞེས་སོ།",
    "ཡང་ན་འབྲས་བུ་ནི་དང་རང་དོན་དང་གཞན་དོན་བཀའ་གདམས་དཔེ་དཀོན་གཅེས་བཏུས་ལས།",
    "གཞན་དོན་སྒྲུབ་པ་མ་ཚང་བའི་ནི་སྐྱེས་བུ་དཔའ་བོ་གོ་མཚོན་ཚང་བ་དགྲས་མི་ཚུགས་ཤིང་འཇོམས་པར་རནུས་པ་ལྟར་འདི་དང་མ་བྲལ་ན་མི་མཐུན་པའི་སྟེ་འཇོམས་ནུས་ཤིང་རང་དང་གཞན་གྱི་དོན་རྫོགས་པར་སྒྲུབ་ནུས་པ་སྟེ།",
    "ངོ་བོ་ཉིད་ཀྱང་རང་དང་གཞན་ལ་སོགས་པ་ལས་སྐྱེ་བ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ནས་ཏེ་ལམ་ཐམས་ཅད་མཐར་འབྱིན་པ་ལ་ནི་འདི་དག་དུས་གསུམ་དུའང་བགྲོད་པ་གཅིག་པའི་ཐབས་ཡིན་པས་སོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་དམིགས་པ་དང་བདག་པོ་དང་རང་བཞིན་གྱིས་ཞི་བའི་རྣམ་པ་གསུམ་གྱིས་སོ།",
    "དེས་གྲུབ་པའི་དོན་ནི་རབ་འབྱོར་དེ་ལྟར་ན་ནས་ཏེ་མི་དམིགས་པ་ལ་གནས་པ་བརྟན་པ་ལས་དངོས་པོ་མེད་པ་དང་རང་དང་གཞན་གྱི་དངོས་པོ་གནས་པར་བྱ་བར་མ་གྲུབ་པས་ཅི་ལའང་མི་གནས་པར་གནས་པའོ།",
    "རང་བཞིན་གྱིས་དབེན་པ་དང་རང་བཞིན་གྱིས་དག་པ་དང་མཐའ་དབུས་དང་བྲལ་བའོ།",
    "འབྲས་བུ་དམན་པ་གཞན་ལས་འདའ་བའི་ཚུལ་ནི་དེ་ཙམ་གྱིས་ནས་ཏེ་འབྲས་བུ་ཡོད་པར་བྱས་ནས་གཞན་གྱི་དོན་དུ་ཐོབ་པར་བྱ་ཞིང་རང་ཉིད་མངོན་དུ་མི་བྱེད་པས་འདའ་བར་བྱ་བ་ཡིན་པས་སོ།",
    "ཏིང་ངེ་འཛིན་གྱི་ཆེ་བ་དང་རང་བཞིན་ལ་ལེགས་པར་གདམས་པ་ཐོབ་པའོ།",
    "རྒྱུ་དང་རང་བཞིན་གསུམ་ལས་བརྩམས་ནས་བསྟོད་པར་བལྟའོ།",
    "ངོ་བོ་ལས་ཉན་ཐོས་དང་རང་རྒྱལ་བའི་ནི་མཐོང་ལམ་དང་ངེས་འབྱེད་གཉིས་གཉིས་སོ།",
