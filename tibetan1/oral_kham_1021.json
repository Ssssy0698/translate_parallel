    "མུ་སྟེགས་ཅན་ཀྱི་གནས་ཐམས་ཅད་ན་འདུག་པ་ཡང་སྣང་ལ།",
    "འདུག་འདོད་ན་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་རྒྱས་པར་བཀང་སྟེ།",
    "ད་བདུད་ཕྲུག་ཆམ་ལ་ཕབ་དགོས་གདའ།",
    "བདུད་མ་རུང་རང་དགར་སྤྱོད་པའི་ཚེ།",
    "ནར་ཐུག་འདུག་བསམ།",
    "དམག་འཁྲུག་ནི་ཕ་རོལ་ཆམ་ལ་ཕབ་པའི་ལག་ཆ་གཅིག་པོ་ཁོ་རང་མིན་པ་ཤེས་རྟོགས་ཐུབ།",
    "མིའི་རིགས་ཀྱིས་དམག་འཁྲུག་ནང་རང་རྒྱལ་གཞན་ཕམ་གྱི་རྒྱུ་དང་རྐྱེན་ལ་གདེང་འཇོག་རབ་དང་རིམ་པ་བྱས་ཡོད།",
    "དེ་བཞིན་དམག་ཕམ་པའི་རྐྱེན་ནི་ལྷ་ཀླུ་ཐུགས་ཁྲེལ་བྱུང་བའི་འགྲེལ་བརྗོད་བྱས་པ་སོགས་ལས་མཚོན་འདུག་གོ།",
    "དེ་དག་ནི་བོད་བཙན་པོའི་དུས་ཀྱི་བློན་པོའི་ངོ་བོ་དབྱེ་སྟངས་དང་འདྲ་མཚུངས་སུ་འདུག་སྟེ།",
    "བོད་ཀྱི་གནའ་བོའི་དམག་མིའི་ཡོང་ཁུངས་དང་དམག་སྐུལ་ལམ་ལུགས་སྐོར་གྱི་རྒྱུ་ཆ་ཆེས་མཐོང་རྒྱུ་དཀོན་པ་ཤིག་འདུག་ཡིན་ནའང་བོད་ཀྱི་སྲོལ་རྒྱུན་དམག་སྐུལ་ལམ་ལུགས་དེ་ནི་དམག་མི་འབངས་ཁྲོད་དུ་སྡོད་པ་སྟེ།",
    "གླིང་སྒྲུང་ནང་དུ་དམག་བསྡུའི་ལམ་ལུགས་སྐོར་ཞིབ་ཆ་གསལ་བ་ཞིག་ཆེས་མཐོང་རྒྱུ་དཀོན་པར་འདུག་ཡིན་ནའང་།",
    "གེ་སར་སྐྱེས་བུ་ང་རང་དང་།",
    "འབངས་དམག་དབྱེར་མེད་ཀྱི་བསམ་པ་དེ་དེ་བས་ར་སྤྲོད་བྱས་འདུག་ད་དུང་ཧོར་གླིང་གཉིས་གཡུལ་འཁྲུག་སྐབས།",
    "གླིང་སྟོད་གསེར་པ་མཆེད་བརྒྱད་གདའ།",
    "དམག་བསེ་ཁྲབ་ཅན་ལ་དགུ་བརྒྱ་གདའ།",
    "དམག་ཟངས་ཁྲབ་ཅན་ལ་བདུན་བརྒྱ་གདའ།",
    "དམག་ལྕགས་ཁྲབ་ཅན་ལ་ལྔ་བརྒྱ་གདའ།",
    "མནའ་ལ་འགྲེལ་བརྗོད་ཡང་རྒྱས་པར་བྱས་འདུག་སྟེ།",
    "དེ་ཡང་རང་ཅག་ཁ་བ་ཅན་གྱི་ཡུལ་འདིར་མཚོན་ཆ་ཐོག་མར་ག་དུས་བྱུང་ངམ་ཞེ་ན།",
    "ད་རུང་མདའ་སྒྲོའི་བར་སྤང་ལ་ཟུག་འདུག་དེའི་མདའ་ལན་བཀའ་བློན་འདན་མས་མདའ་གཅིག་གློག་འཁྱུག་པ་ལྟར་སྤྲིངས་བྱུང་བར།",
    "མི་གསུམ་ཙམ་གྱིས་ཕ་བོང་གཡག་རོ་སུམ་འགྱུར་ཙམ་གཉིས་བསྒྲིལ་འདུག་པ།",
    "ཞལ་དཀར་དབུ་ཁྱེར་འདུག་གཤིས་མདའ་འཕངས་ཀྱང་ཕོག་མི་ཡོང་།",
    "དབུ་དར་འཕྲུ་ཤ་ལེར་ཁྱེར་ཞིང་གདའ།",
    "འུ་ཐུག་དུས་དམག་ཐོག་ཏུ་སྤྱོད་པ་ཡང་ཡོད་དེ།",
    "ཕྱོགས་ཀྱི་དཔའ་རྟུལ་རྣམས་ཀྱང་ཡུད་ཙམ་དྲན་མེད་དུ་བརྒྱལ་བར་གདའོ།",
    "གེ་སར་གྱི་དམ་རྫས་དུག་གྲི་ནག་པོ་དེ་ལན་གསུམ་གཡུགས་རྗེས་གླང་ཆེན་རྣམས་ཐང་དུ་འགྱེལ་བར་གདའོ།",
    "མེ་དམར་ནག་རྩེགས་རྩེགས་ཡོང་བ་ཞིག་འདུག་ན་ཡིན་ཏེ་མ་འཁྲུལ་བར་བརྟག་དགོས་སོ།",
    "ཞེས་པ་ལས་སྒར་བཏབ་ས་ནི་ཐང་ཆེས་ཡངས་པོ་དེ་འདྲ་ཡིན་མ་དགོས་པ་གང་ཞིག་མེ་ཁ་སོགས་ལ་ཡིད་གཟབ་ཆེན་པོ་བྱེད་དགོས་པ་བསྟན་འདུག་དེ་བཞིན་ཞལ་ལྕེ་དེའི་ནང་སྒར་སྒྲིག་ལུགས་འཁོད་པར་དམག་ལས་ཀྱི་སྒར་ཐོབ་རྒྱབ་དེ་ལས་མ་འགལ་བར་སྒལ་ཕ།",
    "མདུན་སྒར་མདུན་ནས་བསྒྲིལ་ནས་ཤོག་སྒ་འབྲུ་ཤོག་དང་ཚ་ཞང་ཤོག་རང་རང་འབབ་ཚུལ་ཤམ་མཐུད་གྱིས།",
    "དམག་དོན་བསམ་བློ་དེའི་ཚད་གཞི་མི་དམའ་བ་བསྟན་འདུག་༣ དཔུང་འཇུག་བཀོད་པ།",
    "དགྲ་འདུག་ན་ཤ་གཞོག་ལ་ལན་ཐོངས།",
    "གུར་དཀར་རྒྱལ་པོ་ཁོ་རང་རྟ་པ་བརྒྱ་ཙམ་བྱས་ནས་ཤོར་བྱུང་།",
    "ཞེས་པ་ལས་ཧོར་ཤན་པ་མ་བསད་པའི་རྒྱུ་རྐྱེན་ཁ་གསལ་གོ་བདེར་བསྟན་འདུག་སྒྲུང་ནང་ད་དུང་འཁོད་པར་དེ་ནས་སེང་ཆེན་གྱིས་ཧོར་རི་ཐང་བཅུ་གཉིས་ཀྱི་མགོ་དཔོན་མི་དྲག་རྣམས་ལ་མཇལ་འཕྲད་གསུང་གླེང་ཞིབ་པར་མཛད་དེ།",
    "འགྲོ་འདུག་འཆག་གསུམ་གྱི་སྐབས་སུ་མཐོང་སྣང་དུ་གྱུར་ཚད་ལས་ལྟས་བཟང་ངན་བརྟག་པ་སོགས་ལས་མ་འོངས་བྱ་སྤྱོད་གང་རུང་སྤེལ་བའི་གཞི་འཛིན་ས་བྱེད་པ་སོགས་སྣང་།",
    "དགྲ་འདུག་ན་ཤ་གཞོག་ལ་ལན་ཐོང་།",
    "མེ་དམར་ནག་རྩེགས་རྩེགས་ཡོང་བ་ཞིག་འདུག་ན་ཡིན་ཏེ་མ་འཁྲུལ་བར་བརྟག་དགོས་སོ།",
    "བཟང་བསྟོད་ཉེས་སྨད་སོགས་ཀྱི་ཐབས་ལ་བརྟེན་ནས་དཔོན་དམག་ལ་ངར་སློང་སྐུལ་སློང་བྱེད་པ་སོགས་མང་དུ་ཡོད་འདུག་ཡིན་ནའང་།",
    "དགའ་སྐྱོ་འདྲེས་མའི་ལོ་བདུན་གྱི་དུས་ཡུན་ནང་ཁྱེད་རྣམ་པའི་ལུས་ཐོག་ནས་ང་རང་ལ་ཐོབ་པ་ནི་བསམ་པ་བརྗོད་ཀྱི་མི་ལངས་པའི་ཡོན་ཏན་ཞིག་ཡིན།",
    "དེ་བས་ན་འཆི་བདག་ཐམས་ཅད་གནས་ན་འདུག་ཅེསགསུངས་སོ།",
    "ཇི་ལྟར་པད་ཆུ་ལས་སྐྱེས་ཀྱང་རང་བཞིན་གྱིས་དག་པའི་ཕྱིང་ཆུའ་ཉེས་པས་མི་གོས་སོ།",
    "དེའི་བསྟན་པ་ལ་ཞུགས་པ་ཡིན་པའི་ཕྱིར་དེ་ལ་མངོན་ཕྱོགས་ནས་འདུག་པ་ཡིན་ནོ།",
    "མཆོད་རྟེན་ཁྲི་ལ་ལེགས་འདུག་པ།",
    "དེ་ལྟར་པདྨ་ལ་འདུག་པ་འམ།",
    "རྡོ་རྗེ་རྣོན་པོའི་གནས་སུནི་༢ལ་ཁྲིའི་སྟེང་དུ་ནོར་བུ་འདུག་པར་བྲིའོ།",
    "དགའ་བར་འགྱུར་ཞེས་བྱ་བ་ནི་མདུན་དུ་འདུག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "གང་དུ་འདུག་པ་ལ་གནས་པ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་པའོ།",
    "ནོར་བུའི་རིགས་ལ་ཡང་ལུས་ཀྱི་གནས་པ་ངེས་པ་མེད་པས་ན་ངལྟརའདུག་པར་ཀྱང་ལུང་བདེ་ལ།",
    "མཚམས་སུ་རང་རང་གནས་ཚད་ཀྱི།",
