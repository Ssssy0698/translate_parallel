    "བློ་བུར་དུ་མེ་བྱུང་བ་དེས་ཤིང་གཉིས་ཀ་བསྲེགས་ནས་ཐལ་བ་ཙམ་དུ་འགྱུར་བ་བཞིན།",
    "མཉམ་བཞག་གི་ངང་ནས་དགའ་སྐྱིད་ལྟ་བུའི་ཆགས་སྡང་ལྟ་བུའི་རྣམ་པར་རྟོག་པ་གསལ་ཞིང་ངར་དང་བཅས་པ་ཞིག་འཆར་དུ་བཅུག་སྟེ།",
    "འཁྲུལ་རྟོག་གི་བྱ་བ་ཨ་འཐས་ཀྱི་བདེན་འཛིན་མི་བསྐྱེད་ཅིང་།",
    "ཉོན་མོངས་ཡེ་ཤེས་ཆེན་པོ་སྟེ།",
    "གང་ཟག་གིས་རྟོགས་མ་རྟོགས་ལ་ལྟོས་དགོས་པར་སྣང་བས།",
    "རང་གི་འཁོར་འདས་དབྱེར་མེད་ཀྱི་སྒྲུབ་བྱེད་ཅི་ཡོད་པ་འདིའི་སྒྲུབ་བྱེད་དུ་མཚུངས་པའི་ཕྱིར་དང་།",
    "དེའི་མཚུངས་ལྡན་གྱི་རིག་པས་ཐབ་ཤེས་ཟུང་འཇུག་སོགས་ཟུང་འཇུག་གི་རྣམ་བཞག་ཐམས་ཅད་ཤེས་རབ་རྐྱང་པ་སོགས་ཡ་བྲལ་དུ་འགྱུར་བས་གནོད་བྱེད་ཤིན་ཏུ་མང་བའི་ཕྱིར་རོ།",
    "དེ་ལྟར་རྣམ་རྟོག་ཉོན་མོངས་ཐམས་ཅད་རང་ངོ་ཤེས་པ་ཙམ་གྱིས་རང་གྲོལ་བར་འགྱུར་བ་འདི་ལམ་གང་ཤར་ལ་སྤང་བླང་མེད་པ་ཉིད་དེ།",
    "སྤང་བྱ་སྤོང་བའི་ལམ་གཞན་ལས་དོན་དམ་པ་ལ་ཉེ་བ་ཡིན་མོད།",
    "དཔལ་མཆོག་གི་རྒྱུད་དུ།",
    "གང་དང་གང་གིས་འཆིང་འགྱུར་བ།",
    "དེ་ལ་རང་གི་ཤེས་པ་འདི་འདས་པའི་ཤེས་པའམ།",
    "ཤེས་པ་སྐད་ཅིག་མ་འདི་གཅིག་པུ་དུས་གསུམ་ཅར་གྱིས་བསྡུས་པར་ནི་བཞག་ཏུ་མེད་ལ་དུས་གསུམ་པོ་གང་རུང་ཞིག་གིས་བསྡུས་པའོ་སྙམ་ན།",
    "ཐམས་ཅད་ཀྱང་བདེན་པ་མ་ཡིན་པར་རང་གི་བློས་བཏགས་པ་ཙམ་དུ་ཟད་པས་སྐྱེ་བ་དང་འགགས་པ་དང་གནས་པ་ཅི་ཡང་གྲུབ་པ་མ་ཡིན་ནོ་ཞེས་ངེས་པའི་ཤེས་པ་སྐྱེ་བར་འགྱུར་རོ།",
    "ཞེས་སོགས་གསུངས་པ་ལྟར་རང་རིག་གིས་དཔྱད་པས་སྐྱེ་འགག་གནས་བྲལ་དུ་ཤེས་ཏེ།",
    "དེ་ལ་རང་གི་སེམས་འདི་ཡོད་པ་དངོས་པོར་གྲུབ་བམ།",
    "འདྲེ་ཁྱོད་པས་ངས་ཀྱང་མཐོང་བ་མེད་། ཅེས་སེམས་དངོས་མེད་དུ་གསུངས་པ་དང་།",
    "གང་གི་རྟེན་ཅིང་འབྲེལ་བར་འབྱུང་།",
    "དུ་མར་ངེས་ན་དེ་ཐམས་ཅད་ཀྱང་རང་གི་ངོ་བོ་སྟོང་པ་ཉིད་དུ་མཉམ་པར་ཇི་ལྟར་འགྱུར་བ་བརྟགས་པས་ཐ་དད་དང་བཅས་པ་དང་།",
    "ལུང་གི་དངོས་བསྟན་ལ་ཕྱོགས་གཅིག་ནས་གཞལ་ན།",
    "དེ་དག་གི་སྐབས་སུ་དཔྱོད་ཚུལ་གཞན་ཡང་།",
    "ནང་རང་གི་ལུས་ལ་བརྟེན་ནས་གནས་པ་བརྟག།",
    "རང་གི་ལུས་ལ་གནས་པ་སྙམ་བྱེད་ན།",
    "ལུས་ཀྱི་སྤྱི་གཙུག་ནས་རྐང་མཐིལ་གྱི་བར་གྱི་ལྷུ་དང་དུམ་བུ་ལ་གནས་སམ་མ་ལུས་སྤྱི་ཁྱབ་ཏུ་གནས་བརྟག་སྤྱི་ཁྱབ་ཏུ་གནས་ན་ཕྱི་ནང་གི་ཚུལ་དུའམ་འདྲེས་པའི་ཚུལ་དུ་གནས་བརྟག་འདྲེས་ན་སེམས་ཕྱིའི་གཟུགས་སོགས་ཡུལ་རྣམས་ལ་འཕྲོས་པའི་ཚེ་ཇི་ལྟར་སོང་སོགས་བརྟག་ངོས་བཟུང་དང་རྣམ་འགྱུར་ལ་སེམས་དེ་སྟོང་པར་ངོས་བཟུང་རྒྱུའམ་དེའི་རྣམ་པ་ཅན་དུ་འདུག་གམ།",
    "དེ་ཡང་དྲན་རིག་ཡོད་པའི་ཚེ་སིང་ངེ་ཡེ་རེ་བ་ལྟ་བུའི་ཉམས་སུ་མྱོང་རྒྱུ་ཅུང་ཟད་ཡོད་ལ།",
    "དེའི་ཚེ་རང་གི་སེམས་འདི་ཡིན་གྱི་ངོས་བཟུང་མེད་བཞིན་དུ་རང་གིས་རང་རིག་ཅིང་རང་གསལ་བ་དེའི་ངང་མ་ཤོར་བའི་དྲན་རིག་ཏུ་རེ་བརྟེན་ནས་སྐད་ཅིག་ཀྱང་མ་ཡེངས་པར་བསྐྱང་ངོ།",
    "ཀྱེ་མ་རང་ལ་རང་གིས་དེ་ཉིད་མཚོན་ཏེ་ལྟོས།",
    "ཁ་ཕྱིར་བལྟས་ཀྱི་ལུང་རིག་གི་དཔྱད་པ་མིན་པའི་ཕྱིར་དེ་དང་ཕྱོགས་མི་འདྲ་སྟེ།",
    "ཁ་ཅིག་མཁས་པའི་གཞུང་ལུགས་ལ་བརྟེན་ནས་ཐོས་བསམ་གྱི་དཔྱད་པ་འབའ་ཞིག་བྱེད་པ་དང་ཀུ་ས་ལིས་མན་ངག་ལ་བརྟེན་ནས་མཉམ་བཞག་འབའ་ཞིག་བྱེད་པར་སེམས་པ་སོགས་སྣང་མོད་ཀྱང་།",
    "སྤྱིར་གཉིས་ཀར་ཡང་གཉིས་ཀ་དགོས་ཤིང་སྒོམ་ཆེན་ལའང་དཔྱད་སྒོམ་དགོས་པ་ནི་ཡིན་མོད།",
    "སེམས་དེ་སེམས་གང་གིས་ནི་ཚོལ་བྱེད་པ།",
    "སེམས་གང་གིས་རྟོགས་པ་དེ་ཡང་ངོ་བོ་ཉིད་ཀུན་ཏུ་བཙལ་ན་སྟོང་པར་རྟོགས་ཏེ།",
    "ཞེས་སོགས་གསུངས་པས་གྲུབ་བོ། གཉིས་པ་ཐུན་མོང་མ་ཡིན་པའི་ཉམས་ལེན་བསྟན་པ་ནི།",
    "དེ་ལ་གོང་དུ་སྨོས་པ་རྣམས་ལ་ཐུན་མོང་གི་ཉམས་ལེན་ཞེས་བྱ་སྟེ།",
    "ཉན་རང་ཐེག་ཆེན་གསུམ་ཀའི་ཐུན་མོང་བའི་ལམ་ནི་ཞི་གནས་དང་ལྷག་མཐོང་ཡིན་ཏེ།",
    "རོ་གཅིག་སྒོམ་མེད་ཐེག་ཆེན་གཉིས་ཐུན་མོང་ཡིན་ཀྱང་ཐེག་དམན་ལས་ཐུན་མོང་མ་ཡིན་པས་ཐུན་མོང་མ་ཡིན་པའི་ཉམས་ལེན་ཞེས་སོ།",
    "རང་གི་སེམས་ཉིད་རྟོགས་ན་ཕྱག་རྒྱ་ཆེན་པོ་སྟེ།",
    "ཇི་ལྟར་སྣང་བ་འདི་ཡང་རང་གི་སེམས་ལས་ལོགས་ན་མེད།",
    "ཅེས་གསུངས་པ་ལྟར་སྣང་བ་ནི་རང་གི་སེམས་ཁོ་ནའི་གཟུགས་ཅན་ཏེ།",
    "རང་གི་སེམས་སྣང་ལས་གཞན་རང་རྐྱ་ཐུབ་པ་མེད་པར་ངོ་ཤེས་བསླབ་བཞིན།",
    "སྣང་བ་གང་སྣང་གི་ཡུལ་ཐོག་དེ་ཁར་གློད་ནས་བཞག་པ་ཉིད་ཀྱིས་ཕྱིའི་ཡུལ་སྣང་དང་།",
    "རང་གི་སེམས་ཞེས་གཉིས་སུ་དབྱེ་རུ་མེད་པར་རོ་གཅིག་ཏུ་འདྲེས་པར་འགྱུར་ཏེ།",
    "རྩ་ལྕུག་འཁྲི་ཤིང་ལ་སོགས་པ་། བདག་གི་དངོས་པོའི་རང་བཞིན་ལས།",
    "རོ་གཅིག་གི་དུས་དེ་དེར་ཤར་བས་སྣང་སྟོང་ལྷན་སྐྱེས་ཇི་བཞིན་པ་མངོན་དུ་འགྱུར།",
    "ཅིར་ཡང་མ་གྲུབ་བཞིན་དུ་ཅིར་ཡང་སྣང་གི་འདུག་པས་སྣང་སྟོང་ཟུང་འཇུག་གམ་རོ་གཅིག་པ་ཞེས་བྱ་སྟེ་དཔེར་ན་འཁྱག་པ་དང་ཆུ་བཞིན་ནོ།",
    "ཐམས་ཅད་ཀྱང་རང་གི་གྲོགས་སུ་འཆར་ཞིང་དེ་ཉིད་ཀྱི་རྩལ་འགག་ཏུ་ཡང་མེད་དེ།",
    "གར་མཁན་དག་དང་རི་མོ་བཟང་ལྟར་སྣང་།",
    "ཁམས་གསུམ་མ་ལུས་ཀུན་ཏུ་ཁྱབ་པར་སོང་།",
    "ཅེས་པ་དེ་ལྟར་སྤང་བྱ་ཉོན་མོངས་པ་ཟད་པས་སྤོང་བྱེད་གཉེན་པོ་ཟད་ནས་ལམ་ཆད་དེ།",
    "དེ་ལས་གོང་དུ་ཕུལ་ས་མེད་པ་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པ་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་དེ་ཁོ་ན་ཉིད་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་ཐོབ་པར་འགྱུར་རོ།",
    "ངག་གི་ལམ་འདས་ཡིད་ཀྱི་སྤྱོད་ཡུལ་མིན།",
    "རང་གིས་རང་ཉིད་མཚོན་ཏེ་ཤེས་པར་བྱོས།",
    "བདེ་སྟོང་ལྷན་སྐྱེས་ཞེས་སོགས་འབྱུང་མོད།",
    "ལྷན་སྐྱེས་གཉིས་པོ་ཆ་མཉམ་ཟུང་འཇུག་ཏུ་རྟོགས་པས་ནི་ཟུང་འཇུག་གི་རིམ་པ་མངོན་དུ་བྱས་པ་ཡིན་པས་ན།",
    "དེ་ནས་རོ་གཅིག་གི་རྣལ་འབྱོར་ཐོབ་ཚུན་བར་མ།",
    "རྣལ་འབྱོར་བཞི་པོ་རེ་རེ་བཞིན།",
    "ཉམས་མྱོང་གི་སྤུ་རིས་འབྱེད་པ།",
    "སེམས་ཉག་གཅིག་གི་སྟེང་དུ་གཏན་ལ་འབེབས་ལམ་གང་དུ་ཁྱེར་ན།",
    "རྩོལ་མེད་ཡང་དག་གི་དྲན་པ་ཞེས་དང་།",
    "རེ་དོགས་ཀྱི་ཐག་པ།",
    "རང་གི་ངོ་བོ་སྐྱེ་འགག་གནས་པ་དང་བྲལ་བར་ཤེས་པས་སོ།",
    "སྤང་བྱའི་ཉོན་མོངས་པ་དང་གཉེན་པོ་ཡེ་ཤེས་ཐ་དད་པར་གཟུང་ནས་དགག་སྒྲུབ་ཏུ་རྟོག་པ་སྟེ།",
    "དེ་དག་ལས་དང་པོ་པའི་དུས་སུ་གོ་བ་མོས་པས་སྤྱོད་པ་ཙམ་ན་ཉམས་སུ་མྱོང་བ།",
    "རང་རིག་གི་རྟོགས་པ་དེས་སྒྲའི་དོགས་གཅོད་མི་ནུས་པ་ཅི་ཡང་མེད་པས།",
    "རྟག་པར་དགྱེས་པའི་རོལ་མོ་མཐའ་དག་སྒྲིབ་བྲལ་རང་བཞིན་ཡེ་ཤེས་ཀྱི།",
    "དགེ་ལེགས་དཔལ་བཟང་གངས་ཅན་ཁྱད་ནོར། ། མཁས་གྲུབ་དགེ་ལེགཡ་དཔལ་བཟང་གི་གསུང་འབུམ་བཞུགས་སོ།",
    "སེར་གཙུག་ནང་བསྟན་དཔེ་རྙིང་འཚོལ་བསྡུ་ཕྱོགས་སྒྲིག་ཁང་གིས་བསྒྲིགས།",
    "༥༧། མཁས་གྲུབ་དགེ་ལེགས་དཔལ་བཟང་གི་གསུང་འབུམ་བཞུགས་སོ།",
    "སེར་གཙུག་ནང་བསྟན་དཔེ་རྙིང་འཚོལ་བསྡུ་ཕྱོགས་སྒྲིག་ཁང་གིས་བསྒྲིགས།",
    "ལྷ་རྣམས་ཡིང་ཀྱིས་བྲིས་པའི་རི་མོ་བཞིན།",
    "དཔལ་གསང་བ་འདུས་པའི་དཀྱིལ་ཆོག་གི་ངག་འདོན་གོ་སླ་བར་བརྗོད་པ་བཞུགས་སོ།",
    "འགྲེལ་ཆེན་དྲི་མ་མེད་པའི་འོད་ཅེས་བྱ་བའི་ནང་གི་ལེའུའི་དཀའ་གནས་རྣམས་ཀྱི་ཟིན་བྲིས་རགས་ཙམ་ཞིག་བཞུགས་སོ།",
    "རིགས་ལྡན་བཞེད་གཞུང་མིང་གི་ལྷག་མར་བྱས།",
    "སྐྱེད་མོས་ཚལ་ལམ་རི་བོ་དང་ནི་རྒྱལ་བ་མཆོག་གི་གནས་དང་ལྷ་ཡི་གནས་ནི་སྟོང་པ་དང་།",
    "དེ་ཡང་དགོས་པ་གང་གི་ཕྱིར་དུ།",
    "ཁ་ཅིག་ན་རེ།",
    "འཇིག་རྟེན་པའི་དངོས་གྲུབ་ཙམ་ཞིག་གི་རྒྱུར་འགྱུར་བ་ཡིན་ཏེ།",
    "རང་གི་ཚིག་ལ་ཅོ་འདྲི་བར་བྱེད་པ་ཡིན་ལ།",
    "ལེགས་ཚོགས་མཐའ་དག་གི་རྩ་བ་གཅོད་པ་ཡིན་ནོ།",
    "ཞེས་གསུངས་པ་ལྟར་རྫོགས་རིམ་དང་བྲལ་བའི་བསྐྱེད་རིམ་རྐྱང་པ་བསྒོམས་པས་གྲུབ་པ་འཇིག་རྟེན་པ་དག་འགྲུབ་ཀྱི་མཆོག་གི་དངོས་གྲུབ་ཆེན་པོ་ག་ལ་འགྲུབ་ཅེས་བྱ་བའི་དོན་ཡིན་ལ།",
    "དེ་བསྟན་བསྐྱེད་རིམ་བསྒོམས་པའི་དགོས་པ་ཕལ་པ་འཇིག་རྟེན་པའི་གྲུབ་པ་ཆེན་པོ་བརྒྱད་ལ་སོགས་པ་ཡིན་མོད་ཀྱི།",
    "མིའི་བདག་པོ་གཞན་ཡང་ལྷ་དང་ལྷ་མོ་རྣམས་ཀྱི་སྒྲུབ་ཐབས་སོ་སོ་རུ་དཀྱིལ་འཁོར་འདིར་ནི་དཔའ་བོ་གཅིག་པ་རྣམས་ཀྱིས་འགྱུར་ཏེ།",
    "དཀྱིལ་༤ན་འཁོར་གྱི་སྤྲོས་པ་རྒྱ་ཆེར་རྡོ་རྗེ་འཆང་གིས་གསུངས་པ་འདི་ཐམས་ཅད་སྣང་ཤས་ཀྱི་སྤྲོས་པར་གོ་སྟེ།",
    "མ་མ་ཀཱ་ཡ་ཝཱ་ཀ་ཙིཏྟ་ཛྙཱ་ན་བཛྲ་བཛྲ་ཨ་མྲི་ཏ་སྭ་བྷཱ་ཝཾ་ཀུ་རུ་ཀུ་རུ་སྐན་དྷ་དྷཱ་ཏཱ་ཡ་ཏ་ནཾ་ནིསཱ་བྷཱ་ཝཾ་སྭཱཧཱ།",
    "རང་གི་གཙུག་ཏོར་དུ་ཝཾ་ཡོངས་སུ་གྱུར་པ་ལས་རྡོ་རྗེ་ཟླ་བའི་དཀྱིལ་འཁོར་ཆ་བཅུ་དྲུག་ཡོངས་སུ་རྫོགས་པ།",
    "དེས་གཙུག་ཏོར་ནས་རྐང་སེན་གྱི་བར་རང་གི་ལུས་སྦྲུལ་ཤུན་པ་བརྗེས་པ་བཞིན་དུ་ལན་གསུམ་དོར་ཏེ།",
    "རང་གི་ལུས་ཟླ་བའི་དཀྱིལ་འཁོར་ལྟར་དཀར་བར་གྱུར།",
    "རང་གི་དཔྲལ་བར་ཨོཾ་དཀར་པོ་ལས་འོད་དཔག་མེད་དཀར་པོ་དཀར་ནག་དམར་བའི་ཞལ་གསུམ།",
    "ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་ཐོ་བ།",
    "ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་མེ་མདའརྡོ་རྗེ་ལྕགས་ཀྱུ།",
    "ཡད་ཀྱི་ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་རལ་གྲི།",
    "ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་འཁོར་ལོ།",
    "ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་རྡོ་རྗེ།",
    "ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་རྡོ་རྗེ།",
    "ཞེས་བརྗོད་ཅིང་ལག་པ་ཕན་ཚུན་མཉེས་ནས་རྣམ་པར་དག་པར་བསམ་མོ།",
    "རང་གི་ལག་པ་གཡོན་པའི་མཐེ་ཆུང་ནས་མཐེ་བོའི་བར་གྱི་རྩ་བའི་ཚིགས་ལྔ་ལ།",
    "རྩེ་མོའི་ཚིགས་ལྔ་ལ་ཧ་ཡ་ར་ཝ་ལ་སྟེ་དབྱངས་བཅོ་ལྔའི་བདག་ཉིད་ཀྱི་ཟླ་བའི་དཀྱིལ་འཁོར་ཤིན་ཏུ་གང་བ་ཆ་བཅོ་ལྔ་ཡོངས་སུ་རྫོགས་པར་གྱུར།",
    "ལག་པ་གཡས་ཀྱི་མཐེ་བོང་ནས་མཐེའུ་ཆུང་གི་བར་གྱི་རྩེ་མོའི་ཚིགས་ལྔ་ལ།",
    "གུང་མོ་གཉིས་མཉམ་དུ་བརྐྱང་པའི་རྒྱབ་སྐུ་རི།",
    "ཏུ་མཛུབ་མོ་གཉིས་ཕྱེད་འཁྱོག་པའི་ཚུལ་དུ་སྦྱར་ཏེ་བཞག།",
    "ཕྱག་རྒྱ་དེས་གཙུག་ཏོར་ནས་རྐང་སེན་གྱི་བར་ཡན་ལག་ཐམས་ཅད་ལ་རེག་ཅིང་།",
    "ལག་པ་གཉིས་ཁ་སྦྱར་བའི་མཐེ་བོང་ཟུང་གིས་གནས་དེ་དག་ཏུ་རེག་པར་བྱའོ།",
    "རྡུལ་ཚོན་གྱི་དཀྱིལ་འཁོར་འདྲི་བའི་གཞི་ལ་གནས་པའི་ཞིང་སྐྱོང་རེ་ཞིག་གནས་གཞན་དུ་གནས་པར་གསོལ་བ་འདེབས་པའི་ཆེད་ཡིན་གྱི།",
    "མངོན་རྟོགས་བསྒོམ་རེས་ཀྱིས་གནས་དེའི་ཞིང་སྐྱོང་གནས་གཞན་དུ་ལས་ས་ཡི་ཀྱང་།",
    "འོག་ཏུ་ས་ཆོག་གི་སྐབས་སུ་འཆད་པར་འགྱུར་པའི་བགེགས་ལ་ཕུར་གདབ་བྱེད་པ་ལ།",
    "རང་གི་དཔྲལ་བར་ཟླ་བའི་དཀྱིལ་འཁོར་དཀར་པོ་ལ་ཨོཾ་དཀར་པོ་ལས་རྡོ་རྗེ་དཀར་པོ་རྩེ་མོ་བཅུ་བདུན་པ།",
    "མགྲིན་པར་ཉི་མའི་དཀྱིལ་འཁོར་དམར་པོ་ལ་ཨཱ་དམར་པོ་ལས་རྡོ་རྗེ་དམར་པོ་རྩེ་མོ་སུམ་ཅུ་རྩ་གསུམ་པ།",
    "སེར་པོ་ལས་རྡོ་རྗེ་སེར་པོ་རྩེ་མོ་དྲུག་ཅུ་རྩ་ལྔ་པ།",
    "གསང་བར་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་སྔོན་པོ་ལ་ཀྵསྔོན་པོ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་མོ་སུམ་ཅུ་རྩ་གསུམ་པ།",
    "པུས་མོའི་ཚིགས་གཡོན་གཡས་ལ་རིམ་པ་བཞིན་དུ།",
    "རྡོ་རྗེ་སྔོན་པོ་རྩེ་མོ་སུམ་ཅུ་རྩ་གཅིག་པ་རེ་རེ།",
    "ལག་པ་གཡོན་པའི་མཐེའུ་ཆུང་ནས་བརྩམས་ཏེ་མཐེ་བོང་གི་བར་གྱི་རྩ་བའི་ཚིགས་ལྔ་ལ་རིམ་པ་བཞིན་དུ།",
    "ལག་པ་གཡས་པའི་མཐེ་བོང་ནས་བརྩམས་ཏེ་མཐེའུ་ཆུང་གི་བར་གྱི་རྩ་བའི་ཚིགས་ལྔ་ལ་རིམ་པ་བཞིན་དུ།",
    "དེ་བཞིན་དུ་ལག་པ་གཉིས་ཀྱི་སོར་ཚིགས་བར་པ་གཡོན་གཡས་རྣམས་ལ་ལུགས་ལྡོག་དང་ལུགས་འབྱུང་གིས་རིམ་པ་བཞིན་དུ།",
    "ལག་པ་གཉིས་ཀྱི་སོར་ཚིགས་དང་པོ་གཡོན་གཡས་རྣམས་ལ་ལུགས་ལྡོག་དང་ལུགས་འབྱུང་གིས་རིམ་པ་བཞིན་དུ།",
    "རྐང་པ་གཉིས་ཀྱི་རྩ་བའི་སོར་ཚིགས་གཡོན་གཡས་རྣམས་ལ་ལུགས་ལྡོག་དང་ལུགས་འབྱུང་གི་༨ན་རིམ་པ་བཞིན་དུ།",
    "རྐང་པ་གཉིས་ཀྱི་སོར་ཚིགས་བར་པ་གཡོན་གཡས་རྣམས་ལ་ལུགས་ལྡོག་དང་ལུགས་འབྱུང་གིས་རིམ་པ་བཞིན་དུ།",
    "རྐང་པ་གཉིས་ཀྱི་སོར་ཚིགས་དང་པོ་གཡོན་གཡས་རྣམས་ལ་ལུགས་ལྡོག་དང་ལུགས་འབྱུང་གིས་རིམ་པ་བཞིན་དུ།",
    "ཨོཾ་ཧཱུཾ་བི་ཤྭ་ཀཱ་ཡ་བཛྲ་བཛྲ་ཀཱུ་ཊཱ་གཱ་རཾ་ཀུ་རུ་ཀུ་རུ་སྭཱཧཱརྡོ་རྗེའི་རྭ་བ་སྟེང་འོག་ཕྱོགས་མཚམས་ཀུན་ཏུ་བར་མེད་པ་ཟླུམ་པོར་འདུས་པའི་དབུས་སུ་རྡོ་རྗེའི་ས་གཞི་ལ་རེག་གནས་པའི་ཁང་པ་བརྩེགས་པ་སྟེང་འོག་ཏུ་ཁྲུ་ཉིས་བརྒྱ་པ།",
    "ཁང་བརྩེགས་ཀྱི་ནང་གི་ཁྲོ་བོ་བཅུའི་གནས་སུ།",
    "སྟེང་དང་འོག་ཏུ་ཨ་ལས་སྟོང་པའི་དཀྱིལ་འཁོར་རེ་རེ།",
    "ལྷོ་དང་ལྷོ་ནུབ་ཏུ་རཾ་ལས་མེའི་དཀྱིལ་འཁོར་དམར་པོ་རེ་རེ།",
    "བྱང་དང་བྱང་ཤར་དུ་བཾ་ལས་ཆུའི་དཀྱིལ་འཁོར་དཀར་པོ་རེ་རེ།",
    "ནུབ་དང་ནུབ་བྱང་དུ་ལཾ་ལས་སའི་དཀྱིལ་འཁོར་སེར་པོ་རེ་རེ་གྲུབ་པར་གྱུར།",
    "ཞལ་རེ་རེའང་མཆེ་བ་གཙིགས་ཤིང་འཇིགས་སུ་རུང་བ།",
    "མོ་དཀར་པོ།",
    "གུང་མོ་དམར་པོ།",
    "ཨ་ཨཱ་ལས་གྲུབ་པའི་མི་རུས་ལས་བྱུང་བའི་རྡོ་རྗེ་ཕྱག་གདུབ་དག་གིས་ཕྱག་རྣམས་ལ་བརྒྱན་པར་གྱུར།",
    "བཛྲ་ནུ་བུ་རེ་ཧུཾ་ཧཱུྃ་ཕཊ་ཕཊ།",
    "ཧ་ཧཱ་ལས་གྲུབ་པའི་མི་རུས་ལས་བྱུང་བའི་རྡོ་རྗེ་རྐང་གདུབ་དག་གིས་ཞབས་རྣམས་ལ་བརྒྱན་པར་གྱུར།",
    "ཐལ་བས་ལུས་ཐམས་ཅད་ལ་བྱུགས་པར་གྱུར།",
    "ཀྵལས་བྱུང་བའི་རྐེད་པར་སྟག་གི་པགས་པའི་ཤམ་ཐབས།",
    "ཨོཾ་ཧཾ་ཀྵཏྲིཾ་ཤད་སྭ་ར་སཔྟ་ཧྲ་སྭ་དཱིངྒྷ་པྱཉྫ་ན་སྭ་བྷ་ཝ་དྱེ་ཏྱ་ཀུ་ལ་ཤ་ཏ་སི་རཾ་བྷི་རེ་མུ་ཎ་ཌ་མཱ་ལེ་སྐན་དྷ་ཨཱ་བ་ལཾ་ནི་སྐན་དྷེ་ཧུཾ་ཧཱུཾ་ཕཊ་ཕཊ།",
    "ཨོྃ་ཧཱུཾ་༡༡ཅཱ་བཛྲ་ཀ་ར་ཀོ་ཊ་བཛྲ་པད་མོ་བཱ་མ་དཀྵི་ཎ་ཀུཎྜ་ལ་ཡོ་ཏིཥྛ་ཏིཥྛ་ཧུཾ་ཧཱུྃ་ཕཊ་ཕཊ།",
    "ཏྲཾ་ཧྲཱི་ལས་བྱུང་བའི་ནོར་རྒྱས་དང་དུང་སྐྱོང་དམར་པོ་དག་གིས་གཡོན་དང་གཡས་པའི་ལག་གདུབ་བྱས་པ།",
    "ཧྭ་ཧྭ་ལས་བྱུང་བའི་མཐའ་ཡས་དང་རིགས་ལྡན་དཀར་པོ་དག་གིས་སྐ་རགས་དང་མགུལ་བ་བརྒྱན་པ།",
    "ཧཱྃ་དྲཱ་ལས་བྱུང་བའི་འཇོག་པོ་དང་པདྨ་ཆེན་པོ་སེར་པོ་དག་གིས་གཡོན་དང་གཡས་པའི་རྐང་གདུབ་བྱས་པའོ།",
    "ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་རྡོ་རྗེ།",
    "ཧཱ་ལས་བྱུང་བའི་གནོད་མཛེས་སྔོན་པོ་སྔོ་དམར་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་རྡོ་རྗེ།",
    "སྟེང་དུ་ཁང་བརྩེགས་ཀྱི་ནང་དང་འོག་ཏུ་རྡོ་རྗེའི་ས་གཞིའི་སྟེང་གི་རང་རང་གི་གདན་ལ་འཁོད།་",
    "ཡི་ལས་བགེགས་མཐར་བྱེད་ནག་པོ་ནག་དམར་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་རལ་གྲི།",
    "ཤར་དང་ཤར་ལྷོར་རང་རང་གི་གདན་ལ་འཁོད།",
    "ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་མེ་མདའ།",
    "ཞེས་བཀའ་བསྒོས་ནས་མིག་གཡོན་གཡས་ནས་ཕྱུང་སྟེ་ལྷོ་དང་ལྷོ་ནུབ་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "ལྕེ་དང་ཆུ་ལམ་ནས་ཕྱུང་སྟེ་བྱང་དང་བྱང་ཤར་དུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "སེར་དཀར་ནག་པའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་འཁོར་ལོ།",
    "ནུབ་དང་ནུབ་བྱང་དུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "སྦྲུསྦྲུལ་རྒྱན་དང་ཕྱག་རྒྱ་དྲུག་གིས་བརྒྱན་པ།",
    "ཞལ་རེ་རེ་ལ་དམར་ལ་ཟླུམ་པའི་སྤྱན་གསུམ་གསུམ་དང་ལྡན་པ།",
    "ཁང་བརྩེགས་ཀྱི་ཕྱི་རོལ་གྱི་སྟེང་དང་འོག་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "དམར་པོ་མིག་གཡོན་གཡས་ནས་ཕྱུང་སྟེ་ལྷོ་དང་ལྷོ་ནུབ་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "ནུམཱུ་ལས་ཟད་པར་ཆུ་གཉིས་དཀར་པོ་ལྕེ་དང་ཆུ་ལམ་ནས་ཕྱུང་སྟེ་བྱང་དང་བྱང་ཤར་དུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "རྭ་བ་གསུམ་གྱི་ཁྱོན་གྱི་ཚད་ཀྱིས་རྭ་བའི་ནང་གི་སྟེང་དང་འོག་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "སྣ་བུག་གཡོན་གཡས་ནས་ཕྱུང་སྟེ་ཤར་དང་ཤར་ལྷོར་རང་རང་གི་གདན་ལ་འཁོད།",
    "ལྷོ་དང་ལྷོ་ནུབ་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "ལྕེ་དང་ཆུ་ལམ་ནས་ཕྱུང་སྟེ་བྱང་དང་བྱང་ཤར་དུ་རང་རང་གི་གདན་ལའཁོད།",
    "ནུབ་དང་ནུབ་བྱང་དུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "རྭ་བ་གསུམ་གྱི་ཁྱོན་གྱི་ཚད་ཀྱིས་རྭ་བའི་ཕྱི་རོལ་གྱི་སྟེང་དང་འོག་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "ཤར་དང་ཤར་ལྷོར་རང་རང་གི་གདན་ལ་འཁོད།",
    "ལྷོ་དང་ལྷོ་ནུབ་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "བྱང་ཤར་དུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "ནུབ་དང་ནུབ་བྱང་དུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་ཤིང་།",
    "དེ་གཉིས་ཀྱིས་ངག་གི་ཁམས་བསྲུང་བའོ།",
    "རྭ་བ་ལྔའི་ཁྱོན་གྱི་ཚད་ཀྱིས་རྭ་བའི་ནང་གི་སྟེང་དང་འོག་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "ཤར་དང་ཤར་ལྷོར་རང་རང་གི་གདན་ལ་འཁོད།",
    "ལྷོ་དང་ལྷོ་ནུབ་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "བྱང་དང་བྱང་ཤར་དུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "ནུབ་དང་ནུབ་བྱང་དུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "རྭ་བ་ལྔའི་ཁྱོན་གྱི་ཚད་ཀྱིས་རྭ་བའི་ཕྱི་རོལ་གྱི་སྟེང་དང་འོག་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "ཤར་དང་ཤར་ལྷོར་རང་རང་གི་གདན་ལ་འཁོད།",
    "ལྷོ་དང་ལྷོ་ནུབ་ཏུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "ཡི་དྭགས་འུག་གདོང་ཅན་ལྕེ་དང་ཆུ་ལམ་ནས་ཕྱུང་སྟེ་བྱང་དང་བྱང་ཤར་དུ་རང་རང་གི་གདན་ལ་འཁོད།",
    "ཁྲྀ་ཀླྀ་ལས་བརྗེད་བྱེད་ཅེ་སྤྱང་གི་གདོང་ཅན་དང་།",
    "ཞེས་པའི་བར་རང་རང་གི་ཕྱག་རྒྱ་དང་བཅས་ཏེ་ལྷ་མོ་བཅུ་གཉིས་ཀྱིས་མཆོད།",
    "རང་རང་གི་ཡེ་ཤེས་པ་རྣམས་རང་རང་གི་དམ་ཚིག་པ་རྣམས་དང་རོ་མཉམ་དུ་གྱུར།",
    "རང་གི་དཔྲལ་བར་ཨ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཨོཾ་དཀར་པོ།",
    "སྔར་ལྟར་ལྷ་མོ་བཅུ་གཉིས་ཀྱིས་མཆོད།",
    "ཨཱ་ཨཱི་རཱྀ་ཨཱུ་ལཱྀ་བཛྲ་ཌཱ་ཀི་ནྱ་བཛྲ་ཨ་མྲྀ་ཏ་གྷ་ཊེ་ར་ཨ་བྷི་ཥིའུ་ཏུ་མཱཾ་སྭཱཧཱ།",
    "ཨོཾ་ཨཾ་ཨེ་རྀ་ཨུ་ལྀ་སརྦ་བུདྡྷ་བཛྲ་མུ་ཀུ་ཊཾ་མ་མ་པཉྩ་བུདྡྷ་ཨཱཏྨ་ཀཾ་བན་དྷ་ཡནྟུ་ཧུཾ་ཧཱུཾ་ཕཊ།",
    "ལྷ་རྣམས་ཀྱི་སྤྱི་བོར་རང་རང་གི་རིགས་ཀྱི་བདག་པོས་དབུ་བརྒྱན་པར་གྱུར་པ་ནི།",
    "ྐགཙོ་བོ་དང་སྟེང་གི་རྣམས་ལ་མི་བསྐྱོད་པ།",
    "ཁང་བརྩེགས་ནི་རྡོ་རྗེའི་ས་གཞི་ལ་མ་རེག་པ་སྟེ།",
    "ཁང་བརྩེགས་ཀྱི་ནང་གི་འོག་གཞི་རྡོ་རྗེའི་ས་གཞི་ཡིན་པས་དེར་བཞག་པ་ཉིད་ལ་རྡོ་རྗེའི་ས་གཞི་ལ་བཞག་པར་གསུངས་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དཀྱིལ་འཁོར་གྱི་ནང་གི་ལྷ་སྣམ་ལ་བཀོད་པ་ནི་མི་འགལ་བ་བཞིན་ནོ།",
    "འདིར་བཅོམ་ལྡན་འདས་དུས་ཀྱི་འཁོར་ལོའི་གཡོན་པ་དང་གཡས་པའི་ཕྱག་གི་མཚན་མ་གང་༡༨ན་ཡིན་པ་དེའི་རང་དུས་ཀྱི་འཁོར་ལོའི་སྒྲུབ་ཐབས་པདྨ་དཀར་པོའི་ཞལ་ལུང་།",
