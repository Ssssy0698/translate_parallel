    "དྲག་མ་སྟེ་བརྒྱད་ཀའང་སེར་མོ་ཕྱག་བཞིའི་གཡས་ན་པདྨ་དང་ཚངས་པའི་དབྱུག་པ།",
    "གཙོ་མོ་རྣམས་ཐམས་ཅད་ཀྱང་ས་གའི་སྟབས་ཀྱིས་བཞུགས་ཤིང་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་ལ་མངོན་དུ་ཕྱོགས་པ་ལ་ཡབ་རྣམས་ས་གའི་སྟབས་ཀྱིས་འཁྱུད་པ།",
    "འདབ་མའི་ལྷ་མོ་རྣམས་རང་རང་གི་གཙོ་མོ་ལ་མངོན་དུ་རེ་རེ་ཕྱོགས་པའི་ཚུལ་གྱིས་རོལ་པའི་སྟབས་ཀྱིས་བཞུགས་པ་ཐམས་ཅད་ཞལ་དུས་ཀྱི་འཁོར་ལོའི་སྒྲུབ་ཐབས་པདྨ་དཀར་པོའི་ཞལ་ལུང་།",
    "ཛྫཾ་དང་རྡོ་རྗེ་ལས་སྐྱེས་པའི་སྲིན་མོ་སེར་མོ་གཡས་ན་རྡོ་རྗེ་དང་མདའ།",
    "ཛྫིཾ་དང་སྣོད་ལས་སྐྱེས་པའི་རབ་གཏུམ་མ་སེར་མོ།",
    "ཁྲྀ་དང་ཞགས་པ་ལས་སྐྱེས་པའི་ཆུའི་ལྷ་མོ་དཀར་མོ།",
    "འྀ་དང་པདྨ་ལས་སྐྱེས་པའི་དཔལ་མོ་དཀར་མོ་གཡས་ན་པདྨ་དང་བགྲང་ཕྲེང་།",
    "མྲྀ་དང་དབྱུག་པ་ལས་སྐྱེས་པའི་ཕག་མོ་དམར་མོ།",
    "དྗེ་དང་མདུང་ཐུང་ལས་སྐྱེས་པའི་གཞོན་ནུ་མ་དམར་མོ་གདོང་པ་དྲུག་པ།",
    "ཏཱཾ་དང་དཔག་བསམ་གྱི་ཤིང་ལས་སྐྱེས་པའི་གློག་མ་ནག་མོ་གཡས་ན་དཔག་བསམ་གྱི་ཤིང་དང་ཡོངས་འདུའི་མེ་ཏོག།",
    "ཁྲྀ་རྡོ་རྗེ་མ་སྟེ་སྨིན་དྲུག་གི་ཟླ་བའི་ཚེས་ཀྱི་ལྷ་མོ་ཐམས་ཅད་སེར་མོ་གདོང་བཞི་པ།",
    "ཁྲྀ་དང་དབྱུག་པ་ལས་སྐྱེས་པའི་གོ་རི་དམར་མོ།",
    "ག་གི་གུ་གླི་གཾ།",
    "ཀླྀ་རྡོ་རྗེ་མ་སྟེ་ཆུའི་ཟླ་བའི་ཚེས་ཀྱི་ལྷ་མོ་ཐམས་ཅད་ནག་མོ་ཕྱག་བཞི་པ།",
    "གྲྭ་དང་རྩེ་གསུམ་ལས་སྐྱེས་པའི་གཤིན་རྗེ་མ་དཀར་མོ་གཡས་ན་རྩེ་གསུམ་དང་མདའ།",
    "ཏཱཾ་རྡོ་རྗེ་མ་སྟེ་དང་པོའི་ཟླ་བའི་ཚེས་ཀྱི་ལྷ་མོ་ཐམས་ཅད་དམར་མོ་ཕྱག་བཞི་པ།",
    "ཉ་རྡོ་རྗེ་མ་ལ་སོགས་པ་ནག་པའི་ཚེས་ཀྱི་ལྷ་མོ་ཐམས་ཅད།",
    "འདབ་མའི་ལྷ་མོ་རྣམས་རང་རང་གི་གཙོ་བོ་ལ་མངོན་དུ་ཕྱོགས་པའི་ཚུལ་གྱིས་རོལ་པའི་སྟབས་ཀྱིས་བཞུགས་པའོ།",
    "ལཱ་དང་འཁོར་ལོ་ལས་སྐྱེས་པའི་འོད་ཟེར་ཅན་སེར་མོ་ཞལ་གཅིག་ཕྱག་བཞི་པ།",
    "ཙུན་ད་དཀར་མོ་ཞལ་གཅིག་ཕྱག་བཞི་པ།",
    "རཱ་དང་མདའ་ལས་སྐྱེས་པའི་ཁྲོ་གཉེར་ཅན་དམར་མོ་ཞལ་གཅིག་ཕྱག་བཞི་པ།",
    "བྱང་སྒོའི་ཤིང་རྟའི་སྟེང་གི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "ཡཱ་དང་རལ་གྲི་ལས་སྐྱེས་པའི་རྡོ་རྗེ་ལྕགས་སྒྲོག་མ་ནག་མོ་ཞལ་གཅིག་ཕྱག་བཞི་པ།",
    "གཡོན་པ་གཉིས་ན་ཕུབ་དང་སྦྲུལ་འཛིན་པས་འཁྱུད་པ་སྤྲོས་ཏེ་ནུབ་སྒོའི་ཤིང་རྟའི་སྟེང་གི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "ཁྱད་པར་ནི་སྤྲོས་ཏེ་སྐུའི་དཀྱིལ་འཁོར་གྱི་སྟེང་གི་ཤིང་རྟ་ལ་གནས་པའི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "ཁ་ཊཱཾ་ག་འཛིན་པས་འཁྱུད་པ་སྤྲོས་ཏེ་སྐུའི་དཀྱིལ་འཁོར་གྱི་འོག་གི་ཤིང་རྟ་ལ་གནས་པའི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "སྒོའི་གཡོན་གཡས་ཀྱི་མེའི་དཀྱིལ་འཁོར་གྱི་སྟེང་གི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "མཐའ་ཡས་དཀར་པོ་ལ་ཚདང་སྒྱུ་དང་གྲི་གུག་ལས་སྐྱེས་པའི་ཕག་གདོང་མ་དང་བྱ་རྒོད་གདོང་མས་འཁྱུད་པ་སྤྲོས་ཏེ་བྱང་སྒོའི་གཡོན་གཡས་ཀྱི་ཆུའི་དཀྱིལ་འཁོར་གྱི་སྟེང་གི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "རླ་གླུ་དང་རྡོ་རྗེ་ལས་སྐྱེས་པའི་འཇོག་པོ་དང་པདྨ་ཆེན་པོ་སེར་མོ་ལ་སྒྱུ་དང་ལ་དང་གྲི་གུག་ལས་སྐྱེས་པའི་ཁྱི་གདོང་མ་དང་བྱ་རོག་གདོང་མས་འཁྱུད་པ་སྤྲོས་ཏེ་ནུབ་སྒོའི་གཡོན་གཡས་སུ་སའི་དཀྱིལ་འཁོར་གྱི་སྟེང་གི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "ཧཱུཾ་ཧཱུཾ་དང་བུམ་པ་ལས་སྐྱེས་པའི་རྒྱལ་བ་ལྗང་གུ་དང་རྣམ་རྒྱལ་སྔོན་པོ་ལ་ཧ་ཧ་དང་གྲི་གུག་ལས་སྐྱེས་པའི་རྡོ་རྗེ་མིག་མ་དང་སྔོན་མོས་འཁྱུད་པ་སྤྲོས་ཏེ་སྟེང་དང་འོག་ཏུ་ནམ་མཁའ་དང་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་ལ་འཁོད།",
    "སྒྱུ་དང་གྲི་གུག་ལས་སྐྱེས་པའི་ཁྱི་གདོང་མ་དང་བྱ་རོག་གདོང་མ་གཉིས་ནག་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གྲི་གུག་དང་ཐོད་པ་འཛིན་པ་ལ་ཧྰ་དྷཱ་དང་རྡོ་རྗེ་ལས་སྐྱེས་པའི་འཇོག་པོ་དང་པདྨ་ཆེན་པོས་འཁྱུད་པ་སྤྲོས་ཏེ་ཤར་དང་ཤར་ལྷོའི་དུར་ཁྲོད་ཀྱི་འཁོར་ལོའི་སྟེང་གི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "དང་སྒྱུ་གྲི་གུག་ལས་སྐྱེས་པའི་ཕག་གདོང་མ་དང་བྱ་རྒོད་གདོང་མ་གཉིས་དམར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གྲི་གུག་དང་ཐོད་པ་འཛིན་པ་ལ།",
    "མཐའ་ཡས་ཀྱིས་འཁྱུད་པ་སྤྲོས་ཏེ་ལྷོ་དང་ནུབ་ཀྱི་དུར་ཁྲོད་ཀྱི་འཁོར་ལོའི་སྟེང་གི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "གདོང་མ་དང་འུག་གདོང་མ་གཉིས་དཀར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གྲི་གུག་དང་ཐོད་པ་འཛིན་པ་ལཧྰ་ཅཱ་དང་བཀྲ་ཤིས་ལས་སྐྱེས་པའི་ནོར་རྒྱས་དང་དུང་སྐྱོང་གིས་འཁྱུད་པ་སྤྲོས་ཏེ་བྱང་དང་བྱང་ཤར་གྱི་དུར་ཁྲོད་ཀྱི་འཁོར་ལོའི་སྟེང་གི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "སྒྱུ་དང་སྒྱུ་གྲི་གུག་ལས་སྐྱེས་པའི་ལྕེ་སྤྱང་གདོང་མ་དང་མཁའ་ལྡིང་མ་གཉིས་སེར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གྲི་གུག་དང་ཐོད་པ་འཛིན་པ་ལ།",
    "ཧྱ་ཕྱྭ་དང་རྒྱལ་མཚན་ལས་སྐྱེས་པའི་སྟོབས་ཀྱིས་རྒྱུ་དང་པདྨས་འཁྱུད་པ་སྤྲོས་ཏེ་ནུབ་དང་ནུབ་བྱང་གི་དུར་ཁྲོད་ཀྱི་འཁོར་ལོའི་སྟེང་གི་པདྨའི་ལྟེ་བ་ལ་འཁོད།",
    "ཧ་ཧ་དང་གྲི་གུག་ལས་སྐྱེས་པའི་སྔོན་མོ་དང་རྡོ་རྗེ་མིག་མ་གཉིས་ལྗང་གུ་དང་སྔོན་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་ཀྱིས་གྲི་གུག་དང་ཐོད་པ་འཛིན་པ་ལ་ཧཱུཾ་ཧཱུཾ་དང་༤༧བ་བུམ་པ་ལས་སྐྱེས་པའི་རྣམ་རྒྱལ་དང་རྒྱལ་བས་འཁྱུད་པ་སྤྲོས་ཏེ་སྟེང་དང་འོག་གི་འཁོར་ལོའི་ལྟེ་བ་ལ་འཁོད།",
    "ཤར་ཕྱོགས་དུར་ཁྲོད་གཏུམ་མོ་ནས།",
    "བརྩམས་ཏེ་གཏུམ་མོ་གཞན་གྱི་བར།",
    "གཅིག་གིས་ལྷག་པའི་བཅུ་ཕྲག་རེ།",
    "རེ་དང་ལག་པ་ལས་སྐྱེས་པའི།",
    "ནམ་གྲུ་དཀར་སེར་ཐལ་སྦྱར་ལག།",
    "ཁྲུམས་སྟོད་ལྗང་གུ་ཐལ་སྦྱར་ལག།"
  ]
}