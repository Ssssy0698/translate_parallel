    "བཙུན་པ་ཚེ་དང་ལྡན་བ་ཀུན་དགའ་བོས་ལས་ཅི་ཞིག་བགྱིས་ན་ལས་དེའི་རྣམ་པར་སྨིན་པས་ཀོས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་ལ་རང་ཉིད་ཀྱིས་རྩིབས་བརྒྱ་མཆིས་པའ་ིགདུགས་བཟུང་ཞིང་རང་ཉིད་ཀྱིས་ཅོད་པན་དཀར་པོས་བཅིངས་ཏེ་བསྙེན་བཀུར་བགྱིས་ལགས།",
    "ཇི་ལྟར་ད་ལྟར་ཀྱང་འདི་ལ་ཀོ་ས་ལའི་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་རྩིབས་བརྒྱ་ཡོད་པའི་གདུགས་སྤྱི་བོར་བཟུང་ཞིང་རང་ཉིད་ཀྱིས་བསྙེན་བཀུར་བྱས་སོ།",
    "དེའི་ཚེ་འདི་ལྟ་བུའི་ཉན་ཐོས་ཆེན་པོ་གནས་བརྟན་གནས་བརྟན་རྣམས་བཅོམ་ལྡན་འདས་ཀྱི་ཉེ་འཁོར་ན་ཉེ་བར་བརྟེན་ཅིང་འདུག་པ་འདི་ལྟ་སྟེ།",
    "དེ་ནས་རྒྱལ་བུ་གཞོན་ནུ་དེ་གདུ་བུ་ཕྱུང་ནས་ལྷུང་བཟེད་ཀྱི་གཞིར་བཞག་པ་དང་དེ་ལ་ལྷུང་བཟེད་མི་གཡོ་བར་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ལྷ་སྦྱིན་གྱིས་ཚེ་དང་ལྡན་པ་འོད་སྲུང་སྟོབས་བཅུ་ལྡན་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ལྷ་སྦྱིན་ཡང་དགེ་སློང་ལྔ་བརྒྱ་ཙམ་དང་ལྷན་ཅིག་བཀད་སའི་གུང་ལ་འདུག་པར་བྱེད་དོ།",
    "ལྷ་སྦྱིན་ཡང་དགེ་སློང་ལྔ་བརྒྱ་ཙམ་དང་ལྷན་ཅིག་བཀད་སའི་གུང་ལ་འདུག་པར་བྱེད་དོ་ཞེས་ཐོས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས།",
    "དེའི་ཚེ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་བསིལ་ཡབ་ཐོགས་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་སྣམ་ལོགས་ན་བཅོམ་ལྡན་འདས་ལ་གཡོ་བཅིང་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་ལྟར་མཐུ་ཆེ་བ་འདུག་བཞིན་དུ་ལྷ་སྦྱིན་དང་།",
    "དྲུང་ན་འདུག་ཀྱང་མི་སྣང་བ་དག་ཡིན་ཏེ།",
    "དབྱེན་བྱེད་པར་འགྱུར་བའི་རྩོད་པ་ཡང་དག་པར་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་མ་འདུག་ཤིག།",
    "དབྱེ་ན་བྱེད་པར་འགྱུར་བའི་རྩོད་པ་ཡང་དག་པར་བླངས་ནས་རབ་ཏུ་བཟུང་སྟེ་མ་འདུག་ཤིག།",
    "དེས་ཁྲིའི་ངོས་སུ་རྒྱབ་གཏད་ནས་འདུག་གོ།",
    "བུ་འདི་ལྟར་འདུག་སྟེ་ཅི་བྱེད།",
    "དེ་ནས་དྲང་སྲོང་དེ་རྣམས་ཀྱིས་དྲང་སྲོང་གཅིག་བསྟི་གནས་སུ་འདུག་ཏུ་བཅུག་ནས་རྩ་བ་དང་འབྲས་བུའི་ཕྱིར་འཁྱམ་དུ་དོང་མ་ཐག་ཏུ་ཆོམ་རྐུན་པ་ལྔ་བརྒྱ་བསྟི་གནས་སུ་ལྷགས་ནས་དེ་རྣམས་ཀྱིས་ཤིང་དེ་མཐོང་སྟེ།",
    "དྲང་སྲོང་དེས་བསྡིགས་པ་ན་དེ་ཞུམ་ཞུམ་པོར་བྱས་ཏེ་འདུག་གོ།",
    "ཡུལ་མི་དང་བཅས་པས་ཡོངས་སུ་བསྐོར་ཅིང་འདུག་གོ།",
    "དེ་ཕན་པར་བྱ་བ་ལྷུར་ལེན་པས་དེའི་སྤྱོད་པ་དང་གནས་པ་ལ་རྟོག་ཅིང་འདུག་གོ།",
    "བུ་ཅིའི་ཕྱིར་སྡངས་བུ་མ་འཇིགས་པར་ཁོ་བོའ་དྲུང་ན་འདུག་ཤིག།",
    "གྲོགས་པོ་དོམ་དེ་གང་ན་འདུག་པའི་ཕུག་དེ་སྨྲོས་ཤིག།",
    "དེ་དེའི་པང་དུ་འདུག་ནས་ངལ་བས་དང་དུབ་པས་གཉིད་ལོག་གོ།",
    "དེ་གཉེན་རྣམས་ཀྱིས་ཁྱིམ་དུ་ཁྲིད་ན་དེ་བཞིན་དུ་བླ་ཞིང་འདུག་གོ།",
    "འདུག་མིན་འཆག་པ་ན་ཡང་མིན།",
    "མགོ་གདུགས་ལྟར་འདུག་པ།",
    "དེ་བྱས་པ་ཆུད་གཟོན་པའི་སྤྱོད་པ་རྗེས་སུ་དྲན་ནས་རྣ་བ་བཀག་སྟེ་འདུག་ནས་མ་བཏུབ་བོ།",
    "མགོ་བོ་གདུགས་ལྟར་འདུག་པ།",
    "བུ་སྦྱིན་པའི་བློ་བོར་ལ་འདུག་ཤིག།",
    "གལ་ཏེ་ལྡོག་པར་འགྱུར་གདའ་ཡིས།",
    "གདོན་མི་ཟ་བར་དཀའ་ཐུབ་ཀྱི་ནགས་སུ་འདུག་པའི་བུ་བྱིས་པ་འབྲས་བུ་དང་ཆུ་འཐུང་བ་ཡིད་དུ་འོང་བའི་མིག་ཏུ་སྡུག་པར་བྱེད་པ་གཉིས་ཐམས་ཅད་སྒྲོལ་གྱིས་སྐྱེ་བོ་སྡུག་བསྔལ་གྱིས་ཉམ་ཐག་པ།",
    "དེ་ནས་མི་དེ་འདི་སྙམ་དུ་སེམས་ཏེ་ཅི་ཁྱིམ་བདག་འདི་ཡང་ནས་ཡང་དུ་འདྲི་བ་བདག་ལ་ཀྱལ་ཀ་སྨྲ་བར་མི་འདོད་གྲང་སྙམ་དུ་བསམས་ནས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "དེའི་ཕས་འདུག་པའི་ཁང་པ་གསུམ་པོ་དགུན་གྱི་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཚེ་དང་ལྡན་པ་གྲོ་བཞིན་སྐྱེས་བྱེ་བ་ཉི་ཤུ་པ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་གྲོ་བཞི་སྐྱེས་བྱེ་བ་ཉི་ཤུ་པས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འདུག་ཤིག་དང་ཁྱེད་ཀྱི་དོན་དུ་ཁོ་བོས་རྒྱལ་པོ་ལ་གསོལ་བ་བྱའོ།",
    "དེ་ནས་དེས་རྒྱུན་ལུགས་ཆང་ཙམ་ན་ཐོས་པའི་ཉེན་ཀོར་དུ་འདུག་ནས་ཚིགས་སུ་བཅད་པས་གསོལ་བ།",
    "འདུག་པར་བྱེད།",
    "ཀུན་ཏུ་འཁྱུད་ན་འོན་ཀྱང་དེ་ངུ་སྟེ་འདུག་ཏུ་མི་བཏུབ་བོ།",
    "རྒྱལ་པོ་ཆེན་པོ་རྣམ་ཐོས་ཀྱི་བུའི་བུར་སྐྱེས་ཏེ་པང་དུ་འདུག་ནས་ལྷའི་བདུད་རྩིས་ལོངས་སྤྱོད་བར་བྱེད་དོ།",
    "ཆུས་གཏོར་ནས་དབུགས་སླར་བྱུང་ནས་མྱ་ངན་གྱི་ཁང་པར་ཞུགས་ཏེ་འདུག་གོ།",
    "བྱ་རོག་དེ་གསེར་གྱི་ཞྭའི་ཆེ་དུ་དེའི་མདུན་དུ་འདུག་ནས་སྐད་སྙན་པ་སྙན་པར་ཕྱུང་བ་དང་དེ་ནས་དེས་དེ་ལ་གསེར་གྱི་ཞྭ་ཞིག་བྱིན་ནོ།",
