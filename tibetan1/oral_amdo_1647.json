    "བདག་གི་བློ་འདི་མ་རིག་མུན་པས་བསྒྲིབས།",
    "འཇམ་མགོན་ཁྱོད་ལ་གསོལ་བ་བཏབ་པའི་མཐུས།",
    "བདག་ཀྱང་ཁྱོད་བཞིན་གྱུར་ཅིག་འཇམ་པའི་དབྱངས།",
    "མངྒ་ལཾ། ། བྱམས་པའི་བསྟོད་ཆེན་བཞུགས་སོ། ། བྱམས་ཆེན་མི་ཡིས་ཞེ་སྡང་བུད་ཤིང་སྲེག།",
    "ན་མོ་ཤྲཱི་གུ་རུ་མཉྫུ་གྷོ་ཥཱ་ཡ།",
    "བྱམས་མགོན་ཞབས་པད་སྐྱེ་ཞིང་སྐྱེ་བར་བདག་གི་གཙུག་ན་མཛེས་གྱུར་ཅིག།",
    "ཉམ་ངར་ལྷུང་བའི་འགྲོ་ལ་རྟག་ཏུ་གཟིགས།",
    "ཕམ་མཛད་སྟོབས་བཅུའི་དཔལ་གྱིས་བརྗིད་པ་ཁྱོད།",
    "མི་འཇིགས་བཞི་ལྡན་མི་ཡི་སེདྒེ་ཁྱོད།",
    "གང་གིས་སྨྲ་བར་མ་ནུས་འཁོར་ལོ་མཆོག།",
    "བསྐོར་བར་འགྲོ་ལ་བྱམས་པའི་མགོན་པོ་ཁྱོད།",
    "དབེན་ཕྱིར་ཁྱོད་ཀྱི་སྤྱོད་པ་ཡོངས་སུ་དག།",
    "དེེ་ཕྱིར་ཁྱོད་ཀྱི་རྟོགས་པ་བླ་ན་མེད།",
    "མཛད་པའི་ཁུར་གྱིས་དགྱེས་བཞིན་འཇུག་པ་ཁྱོད།",
    "ཕྲ་མོའི་སྐྱོན་ཡང་འཇུག་པའི་སྐབས་བཅོམ་པ།",
    "ཁྱོད་ཀྱི་བརྩེ་བའི་ཡུལ་དུ་གྱུར་པ་བདག།",
    "བག་མེད་ལེ་ལོ་གཉིད་དང་བྲེ་མོའི་གཏམ།",
    "བདག་ལ་ཁྱོད་ཀྱི་ཐུགས་རྗེས་གཟིགས་སུ་གསོལ།",
    "ལྷ་ཡི་མཛེས་མ་ཡིད་འོང་སྐྱེད་མོས་ཚལ།",
    "སླར་ཡང་ངན་སོང་གནས་སུ་ལྷུང་བར་འགྱུར།",
    "སྲིད་པའི་བདེ་ལ་ཆགས་པར་མི་རིགས་མོད།",
    "ཕྱིན་ཅི་ལོག་གི་རྟོག་པས་བསྒྲིབས་པ་བདག།",
    "ལས་ཀྱིས་མནར་བ་བདག་ནི་ཁྱོད་ཀྱི་ཐུགས་རྗེའི་གནས།",
    "རྒྱལ་བའི་དགོངས་པ་ཕྲ་མོ་སྨོས་ཅི་དགོས།",
    "བདག་གི་བློ་མིག་ཆེས་ཆེར་གསལ་མ་གྱུར།",
    "བརྩེ་ཆེན་ཁྱོད་ཀྱི་རྗེས་སུ་བཟུང་བའི་དུས།",
    "བྱམས་པ་བྱམས་པས་འགྲོ་བ་སྒྲོལ་བ་ཁྱོད།",
    "མྱུར་བ་མྱུར་བར་བྱོན་ནས་བདག་གི་ནི།",
    "རྒྱུན་མི་འཆད་པ་གཟིགས་པ་ཁྱོད་དྲུང་དུ།",
    "གང་གི་ཡོན་ཏན་དྲན་པས་དང་བའི་ཡིད།",
    "ཉིན་རེ་བཞིན་དུ་སློབ་པར་བགྱིས་ན་ཡང་།",
    "རེག་པར་མ་གྱུར་སྐྱེ་བ་ཐམས་ཅད་དུ།",
    "ཇི་བཞིན་རྙེད་ནས་རང་གིས་དགོངས་པ་ལྟར།",
    "སྐད་ཅིག་གཅིག་ལ་བདག་གིས་སྒྲོལ་བར་ཤོག།",
    "ཉིད་ཀྱིས་གཟིགས་གང་འགྲོ་ལ་བསྐྲུན་ཕྱིར་གཞན་ཕན་ཁུར་ཆེན་སྐྱོ་མེད་ཐུགས་ཀྱིས་འཁྱེར།",
    "འཇམ་དབྱངས་མཁྱེན་པའི་གཏེར་ཁྱོད་ཡུད་ཙམ་དགོངས།",
    "ཁྱོད་ལས་གཞན་པའི་སྐྱབས་བཟང་མ་མཆིས་པས།",
    "བདག་ཡིད་ཁྱོད་ཀྱི་རྗེས་སུ་ཕྱོགས་པ་ནི།",
    "དེ་ཕྱིར་ཁྱོད་ཀྱི་ཡོན་ཏན་བརྗོད་ལ་བདག།",
    "ཡིད་ལ་རེ་བ་སྐོང་བར་བྱེད་པ་ཡི།",
    "འབྱོར་པས་དམན་པའི་སློང་མོ་བ་བཞིན་གྱུར།",
    "དཀར་གསལ་གཡས་སུ་འཁྱིལ་ལེགས་རི་མོ་ཅན།",
    "གཡས་པའི་ཕྱག་ན་དངོས་འཛིན་འཁྲི་ཤིང་གི།",
    "སྡོང་བུ་གཡོན་པའི་ཕྱག་གིས་ཐུགས་ཀར་འཛིན།",
    "སིལ་སིལ་སྒྲ་སྒྲོག་གསེར་གྱི་འོག་པག་གིས།",
    "ཟླ་མེད་རེ་རེར་བྱུང་ནས་གཡས་ཕྱོགས་སུ།",
    "འཇམ་དབྱངས་སྐུ་མཛེས་མིག་གི་ལམ་དུ་འབྲལ་མེད་ཤོག།",
    "ནམ་ཞིག་ཁྱོད་སྐུ་མཐོང་བར་གྱུར་མ་ཐག།",
    "ལོག་པའི་ལམ་དུ་སོང་བའི་མ་རུངས་ཡིད།",
    "སྙན་པའི་གསུང་གང་གང་གི་རྣ་བའི་ལམ་དུ་ལྷུང་ན་ན་རྒ་འཆི་བ་འཕྲོག་པར་བྱེད།",
    "ཆར་སྤྲིན་ནང་གི་འབྲུག་སྒྲ་ཟབ་མོ་བཞིན།",
    "ཁྱོད་གསུང་རྣ་བའི་ལམ་དུ་འབྲལ་མེད་ཤོག།",
    "ཁྱོད་ཀྱིས་ཇི་ལྟར་རྗེས་སུ་གདམས་པ་ཡི།",
    "གསུང་གི་མཚམས་ལས་ནམ་ཡང་མི་འདའ་བར།",
    "སྐྱབས་མཆོག་ཁྱོད་ཀྱིས་རབ་འབྱམས་ཤེས་རབ་སྩོལ།",
    "དངོས་འཛིན་ཆང་གིས་རབ་ཏུ་མྱོས་པས་བླང་དོར་དཔྱོད་པའི་བློ་གྲོས་ཉམས།",
    "སྲིད་པའི་ཞགས་པས་ཡིད་ནི་དྲངས་པའི་རྙེད་བཀུར་གླང་མོའི་ཕྱིར་འབྲང་བ།",
    "ཚུལ་དེ་སྐྱོ་མེད་བརྩོན་པའི་ཤུགས་དྲག་གིས།",
    "མཐར་འཛིན་རི་བོ་མིང་གི་ལྷག་མར་མཛད།",
    "དགོངས་པ་གཅིག་གིས་གསུངས་པའི་གདམས་པ་མཆོག།",
    "ཁྱོད་ཀྱིས་མངོན་དུ་མཛད་པ་དེ་ཡི་མཐུས།",
    "སྐྱོབ་པ་ཁྱོད་ལ་ནམ་མཁའ་ཇི་སྲིད་དུ།",
    "མཁྱེན་བཟང་ཁྱོད་ཀྱི་མཁྱེན་པ་དེ་ཡང་སྐད་ཅིག་ཉིད་ལ་དེ་ལྟར་ལགས།",
    "དེ་ཕྱིར་ཁྱོད་ནི་སྨྲ་བའི་གཙོ་བོ་ལགས།",
    "ཐོགས་མེད་སྲིད་པར་སོང་བ་ཐམས་ཅད་ཀྱི།",
    "གང་དེ་ཁྱོད་ཀྱི་མངོན་དུ་མ་གྱུར་མེད།",
    "དེ་སླད་ཁྱོད་གསུང་འབྲལ་མེད་མ་མཆིས་ལགས།",
    "ཆགས་ལ་གནས་ཤིང་སྡང་ལ་མོས་པ་དང་།",
    "དེ་ལས་ལྡོག་སོགས་མོས་པ་སྣ་ཚོགས་ཚུལ།",
    "མངོན་སུམ་གཟིགས་ཕྱིར་ཁྱོད་ཀྱི་མཛད་པ་ཀུན།",
    "ཁྱོད་ལ་ལྐོག་ཏུ་གྱུར་པ་གང་ཡང་མེད།",
    "དེ་ཕྱིར་ཁྱོད་ནི་གདུལ་བྱའི་གནས་རྣམས་ཀྱི།",
    "མཁྱེན་པ་ཐོགས་མེད་འཇུག་པ་དེ་སླད་ཁྱོད།",
    "ངན་སོང་གནས་རྣམས་ཀུན་ཏུ་བགྲོད་པའི་ལམ།",
    "ཁྱོད་ནི་འགྲོ་བའི་བཤེས་གཉེན་བཟང་པོ་ལགས།",
    "ཐོད་རྒལ་ལ་སོགས་ཏིང་འཛིན་མཐའ་དག་གིས།",
    "ཁྱོད་ནི་སྔོན་གྱི་མཐའ་ལ་མཁས་པ་ལགས།",
    "ཁྱོད་ནི་ཕྱི་མའི་མཐའ་ལ་མཁས་པ་ལགས།",
    "གང་གིས་ཟད་བྱེད་འཕགས་ལམ་བརྒྱད་ཀྱི་ལམ།",
    "དེ་ཕྱིར་ཁྱོད་ནི་སྐྱབས་ཀྱི་དམ་པ་ལགས།",
    "དེ་ལྟར་གནས་དང་གནས་མིན་ལས་ཀྱི་རྣམ་སྨིན་མོས་པ་འཇིག་རྟེན་ཁམས།",
    "གང་ལ་མངའ་བ་ཁྱོད་ཀྱི་ཡུལ་དུ་མ་གྱུར་ཤེས་བྱའི་གནས་དེ་གང་།",
    "ཡང་དག་ལམ་ལ་རྒྱབ་ཀྱིས་ཕྱོགས་པར་གཟིགས།",
    "བརྩེ་ལྡན་ཁྱོད་ཀྱིས་གཟིགས་ནས་བདག་དང་གཞན།",
    "དེ་ཕྱིར་ཁྱོད་ཀྱིས་བདག་གཞན་བརྗེ་བའི་ཚུལ།",
    "ལུས་སྟོབས་རྫོགས་པར་བསྐྱངས་པའི་བཅོམ་ལྡན་ཁྱོད།",
    "སྲིད་ཞིར་མི་གནས་ཁྱོད་ཐུགས་བསྟོད་པས་བདག།",
    "མི་རྟོག་བཞིན་དུ་རེ་བ་སྐོང་བ་ཡི།",
    "གང་གི་སྙན་པས་འཇིག་རྟེན་གསུམ་བཀང་འཇམ་པའི་དབྱངས་ཞེས་རབ་ཏུ་གྲགས།",
    "ཕྱོགས་བཅུའི་རྒྱལ་བ་རབ་འབྱམས་ཞིང་གི་རྡུལ་དང་མཉམ་པ་དེ་དག་གི།",
    "དེ་ལས་འཁྲུངས་པའི་ཡོན་ཏན་ལྷུན་རྫོགས་སྤྱན་རས་གཟིགས་ཞེས་རྣམ་གྲགས་པ།",
    "འཇིག་རྟེན་དག་ན་ཟླ་བ་ཉ་འདྲ་ཀུན་ཏུ་ལྷམ་མེར་གསལ་བ་ཁྱོད།",
    "སྒྱུ་མ་ཇི་བཞིན་ཁྱོད་ཀྱི་སྤྱོད་ལ་བློ་དང་ལྡན་རྣམས་ངོ་མཚར་འགྱུར།",
    "དྲི་མེད་དུང་དང་ཆུ་ཤེལ་ལྟར་དཀར་ལྟ་ན་སྡུག་པའི་ལང་ཚོ་ཅན།",
    "ཁྱོད་ཀྱི་འོད་ཟེར་ཟླ་བ་བཀྲུས་འདྲའི་ལུ་གུ་རྒྱུད་ཀྱིས་ཉེར་དྲངས་ནས།",
    "ཕྱག་གཡས་མཆོག་སྦྱིན་རྩེ་མོ་ལས་བབས་བདུད་རྩི་དཀར་པོའི་ཐིགས་པ་ནི།",
    "རེས་འགའ་བགེགས་འཇོམས་ཁྲོ་རྒྱལ་རྟ་མགྲིན་ལེགས་ལྡན་ནག་པོའི་ཚུལ་ལ་སོགས།",
    "ནམ་མཁའི་ལམ་གྱི་རྗེས་སུ་སོང་བའི་འཇིག་རྟེན་རྒྱ་ཆེན་མཐའ་མ་མཆིས།",
    "ཁྱོད་གསུང་སུ་ཡི་རྣ་བར་ལྷུང་ཡང་བཀའ་ལ་ཡང་དག་གནས་པར་འགྱུར།",
    "ནམ་མཁའ་ཁྱབ་པའི་འབྲུག་སྒྲ་ཇི་བཞིན་ཟབ་མོར་འབྱིན་ཡང་དེ་ཡི་མོད།",
    "འཇིགས་པས་སྐྲག་པ་དེ་དག་གི་ཡང་སྡུག་བསྔལ་མིང་གི་ལྷག་མར་མཛད།",
    "གནོད་འགྱུར་ཆ་ཙམ་ཐུགས་ཀྱིས་དགོངས་པ་རིང་མོ་ཞིག་ནས་བཏང་བས་ན།",
    "ཞི་བའི་གཟིགས་སྟངས་ནམ་ཡང་མི་འཛུམ་རིགས་དྲུག་སྤྱན་རས་བཙའ་མོད་ཀྱི།",
    "ཤ་རུས་འགས་བྱེད་གྲང་བས་ཉེན་རྣམས་དྲོ་བའི་རེག་པས་སྐྱོབ་ཏུ་གསོལ།",
    "ལུས་བསྐམས་ཐལ་བས་རབ་གཡོགས་ལྷུ་ཚིགས་འཐབ་ལས་མེ་ཡི་ཚ་ཚ་འབབ།",
    "ཟས་ཁམ་ཙམ་གྱི་འདོད་ལ་སྲེད་པས་ཕྲ་མོའི་བདེ་བ་དེ་ཡི་སླད།",
    "རེག་ན་བདེ་བའི་མལ་སྟན་འཇམ་དང་ཡིད་འོང་སྐྱེད་ཚལ་ངོགས་རྩེ་བའི།",
    "ལང་ཚོ་འདི་ཡང་ཡུད་ཀྱིས་ཉམས་འགྱུར་སྟོན་མཐའི་མེ་ཏོག་ཇི་ལྟ་བུ།",
    "བདག་གི་ཚེ་ཡང་གློག་འོད་འགྱུ་བཞིན་སྐད་ཅིག་ཙམ་ཞིག་འདིར་སྣང་སྟེ།",
    "བདག་ཅག་སྡུག་བསྔལ་རྒྱ་མཚོ་འདི་ནས་ཐུགས་རྗེའི་ཕྱག་གིས་དྲང་དུ་གསོལ།",
    "གངས་ཅན་རི་ཡིས་བསྐོར་བའི་ཞིང་འདིར་ཐུབ་པའི་བསྟན་སྲོལ་གནས་མོད་ཀྱི།",
    "ཁྱོད་ཀྱི་མཚན་ཡང་བྱིན་གྱིས་བརླབས་ཏེ་གང་ཐོས་འཇིགས་པ་ཞི་བ་དང་།",
    "གྲུ་འཛིན་ཞིང་དུ་རྒྱལ་བ་མཆོག་རབ་སྤྱན་རས་གཟིགས་ཀྱིས་རྗེས་བཟུང་ཤོག།",
    "ས་གསུམ་འགྲོ་བའི་རེ་སྐོང་དངོས་གྲུབ་གཏེར།",
    "འཆི་བདག་བེ་ཅོན་རི་མོའི་དབྱུག་པ་ལྟར།",
    "གང་གིས་མཛད་པའི་ལྷ་མོ་འགྲོ་བའི་སྐྱབས།",
    "ཁྱོད་ལ་རྒྱ་ཆེར་བསྔགས་པ་ཐོས་པ་ལས།",
    "ཕུལ་བྱུང་ཆུ་ཞེང་གབ་པ་ཁྱོད་ཀྱི་སྐུ།",
    "དྲི་བྲལ་མཁའ་ལ་འཁྱོག་པའི་འཇའ་ཚོན་ལྟར།",
    "རྨད་བྱུང་ཉམས་ཀྱིས་ཡིད་འཛིན་ཁྱོད་ལ་འདུད།",
    "དོ་ཤལ་མཆོག་གིས་མགྲིན་པར་རབ་ཏུ་འཁྱུད།",
    "འོ་མའི་རྒྱུན་འཛིན་ནུ་འབུར་ཟུང་གཅིག་གིས།",
    "གསུམ་པས་མདའ་གཞུ་བཞི་པའི་ཕྱག་ཟུང་གིས།",
    "མི་ཕྱེད་སྐྱིལ་ཀྲུང་མཆོག་གིས་ལེགས་གནས་ཤིང་།",
    "བརྒྱད་གཉིས་ལང་ཚོའི་དཔལ་འཛིན་རྒྱལ་བའི་ཡུམ།",
    "གཡས་གཡོན་གནས་ནས་ཁྱོད་སྐུར་མངོན་ཕྱོགས་ཏེ།",
    "ཁྱོད་ཀྱི་ཕྱོགས་བཞིར་གནས་ནས་བགེགས་དཔུང་འཇོམས།",
    "སྟེང་གི་ཕྱོགས་ནས་རིན་ཆེན་བུམ་པ་ཡིས།",
    "མི་དང་ལྷ་ཡི་རྣམ་འདྲེན་ཁྱོད་ལ་འདུད།",
    "ཁྱོད་ཀྱི་གཟུངས་སྔགས་ཞག་དྲུག་བགྲངས་པས་ཀྱང་།",
    "མཆོག་གི་ཚེ་ཐོབ་ངན་འགྲོ་དག་གྱུར་ན།",
    "འདི་ན་ཁྱོད་ལ་རྩེ་གཅིག་ཡིད་ཀྱིས་ནི།",
    "ཅི་ལགས་རེ་བ་མི་སྐོང་བཅོམ་ལྡན་མ།",
    "ཡིད་ལ་ཁྱོད་སེམས་དང་བའི་བུ་ཡིས་ནི།",
    "བརྩེ་བའི་གཏེར་དུ་བདག་གིས་ཅི་ལས་དཔག།",
    "ཁྱོད་ནི་འགྲོ་བ་ཀུན་གྱི་བསམ་པ་མཁྱེན།",
    "ཡིད་ལ་རེ་བ་ཡོངས་སུ་རྫོགས་པར་མཛོད།",
    "མཆོག་གི་ཚེ་དང་རླབས་ཆེན་རྣམ་དཔྱོད་དང་།",
    "མཐོང་ཐོས་དྲན་དང་རེག་པ་ཙམ་གྱིས་ཀྱང་།",
    "འགྲོ་བ་ཀུན་གྱི་རེ་བ་གང་ཡིན་པ།",
    "སྟོང་གསུམ་མི་མཇེད་ཞིང་གི་དཔལ་གྱུར་པ།",
    "གང་གི་བློ་གྲོས་མགུལ་བ་རབ་བརྒྱན་ཅིངའཛམ་གླིང་འདི་ན་ཀུན་མཁྱེན་གཉིས་པར་གྲགས།",
    "རྟེན་འབྱུང་རིགས་ཚུལ་ཟབ་མོས་གསལ་མཁས་པ།",
    "གསལ་མཛད་གྲུབ་པ་མཆོག་གི་སར་གཤེགས་པ།",
    "ཟབ་དང་རྒྱ་ཆེའི་རིགས་ཚུལ་རྣམ་མང་གིས།",
    "ཤིང་རྟ་ཆེན་པོའི་གཞུང་གི་དོན་རྣམས་ལ།",
    "མི་ཕྱེད་དད་པས་དེ་དག་གི་རྗེས་སུ་སློབ་པར་སྨོན་ཅིང་།",
    "དེང་དུས་འཛམ་གླིང་ཁྱོན་འདིར་ཚན་རིག་དང་།",
    "མཆོད་ཅིང་བཀུར་འོས་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "མཁས་མཆོག་ཁྱོད་སྐུ་བོད་དུ་མ་བྱོན་ན།",
    "ཟབ་མོའི་དོན་ལ་ཕལ་ཆེར་རྨོངས་གྱུར་པས།",
    "ལེགས་པར་སྟོན་མཛད་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "དེ་ཉིད་འཆད་དང་རང་གི་རྩོམ་པ་སོགས།",
    "བསྟན་པ་རྒྱས་མཛད་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "ཐར་འདོད་དེད་དཔོན་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "གཞན་དོན་ལྷུར་མཛད་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "ནོར་བདུན་དག་གིས་ཕྱུག་པར་གྱུར་པའི་མཛོད།",
    "ལྷ་སར་ལྷ་ཡི་རོལ་མོ་བསྒྲགས་པ་ལས།",
    "མཁའ་འགྲོས་གཏེར་ཁ་ཕྱེ་ནས་ཁྱོད་ལ་བསྟན།",
    "ཤཱཀྱ་མུ་ནེའི་འཇའ་ས་ཁྱོད་ཀྱི་དྲིན།",
    "རིགས་ཀྱི་བུ་མོ་ལྷ་རུ་སྐྱེས་ཞེས་གསུངས།",
    "མ་འོངས་མངོན་སུམ་གཟིགས་ལ་གསོལ་བ་འདེབས།",
    "འབྲོམ་སྟོན་བདག་གིས་རྭ་སྒྲེང་ལྷ་ཁང་བཞེངས།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་མཐོང་དང་ཐོས་པ་ལས།",
    "དགའ་ལྡན་གནས་ནས་ཐུགས་རྗེས་གཟིགས་མཛོད་ལ།",
    "ད་དུང་ཁ་བ་ཅན་ན་ཁྱོད་ཉིད་ལ།",
    "བརྩེ་བས་བདག་གི་བཤེས་གཉེན་མཛད་དུ་གསོལ།",
    "དམ་པ་ཁྱོད་ནི་བདག་གི་མགོན་ལགས་ཀྱི།",
    "སེམས་ཁྱོད་དགའ་བ་འདི་ལྟར་བསྐྱེད་ན་ལེགས།",
    "གཞུང་ལ་ཕྱོགས་རེ་བ་དང་རགས་པ་རེས།",
    "ཡང་དག་རིགས་པའི་གཞུང་གི་དཀའ་གནས་ལ།",
    "ལྟ་བའི་ཚུལ་ལས་རིང་དུ་མ་སོང་བར།",
    "ཟབ་མོ་འབྱེད་པའི་ཕྲ་བའི་རིགས་ལམ་ནས།",
    "ཟབ་མོའི་ཐེག་དེ་ཇི་ལྟ་བུ་ཞིག་ཅེས།",
    "དངོས་གྲུབ་གཉིས་ཀྱི་གཏེར་གྱུར་ཟབ་མོ་དེར།",
    "དཔུང་བཟང་གིས་ཞུས་བསམ་གཏན་ཕྱི་མ་སོགས།",
    "བྱ་རྒྱུད་རིགས་གསུམ་སྤྱི་དང་བྱེ་བྲག་གི།",
    "གཙོ་བོར་གྱུར་པ་རྣམ་སྣང་མངོན་བྱང་གི།",
    "རྣལ་འབྱོར་མ་རྒྱུད་ཀྱེ་རྡོར་བདེ་མཆོག་གི།",
    "འཇམ་པའི་དབྱངས་ལ་ཤུགས་དྲག་རྒྱུན་རིང་གི།",
    "ཐུན་མོང་མིན་པའི་ངེས་པ་རྙེད་གྱུར་པས།",
    "ཅུང་ཟད་སླ་ཡང་ལམ་དེར་ཟབ་མོའི་དོན།",
    "ཐེག་ཆེན་གཉིས་ཀྱི་ཐུན་མོང་ལམ་དང་ནི།",
    "ཐུན་མོན་མིན་པའི་ལམ་གྱི་རིམ་པ་གཉིས།",
    "རང་གི་རྟོགས་པ་བརྗོད་པ་འདི་བྱས་སོ།",
    "གང་གི་མཁྱེན་པ་རབ་ཡངས་ནམ་མཁའ་ལ།",
    "ཁྱོད་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་ཡོན་ཏན་རྣམས།",
    "ཡོན་ཏན་རྒྱ་མཚོའི་བསྟོད་ཚིག་མེ་ཏོག་གི།",
    "བདག་གིས་བསྒྲུབས་ལ་མཁས་རྣམས་དགྱེས་པར་མཛོད།",
    "མངོན་སུམ་གཟིགས་ཤིང་རྒྱུན་དུ་རྗེས་བཟུང་བས།",
    "ནམ་འདོད་གཟིགས་ཤིང་དཔལ་ལྡན་འདུས་པ་དང་།",
    "ཤེས་རབ་ཕ་རོལ་ཕྱིན་གཞུང་ཟབ་མོའི་དོན།",
    "ལྷག་པའི་ལྷ་རྣམས་ཡང་ཡང་གསལ་བར་གཟིགས།",
    "ཀུན་མཁྱེན་གཉིས་པ་རྒྱལ་སྲས་དབྱིག་གི་གཉེན།",
    "ཞལ་ཕྱག་ཡོངས་སུ་རྫོགས་པའི་སྐུ་མཆོག་གཟིགས།",
    "གང་གིས་བྱིན་གྱིས་བརླབ་པའི་ལྷ་ཚོགས་རྣམས།",
    "ཟབ་མོ་རྟེན་འབྱུང་གཏམ་གྱི་བགྲོ་བ་མཛད།",
    "བཅོམ་ལྡན་དུས་ཀྱི་འཁོར་ལོ་མངོན་སུམ་གཟིགས།",
    "ལྟེ་བའི་འཁོར་ལོའི་གཏུམ་མོ་ཙཎྚ་ལིས།",
    "དཀྱིལ་འཁོར་པ་རྣམས་མངོན་སུམ་གསལ་བར་གཟིགས།",
    "བདུད་འདུལ་ཆེན་པོའི་ཐུབ་པ་དངོས་སུ་གཟིགས།",
    "སྔོན་ཚེ་རྡོ་རྗེ་འཆང་གིས་བཀའ་བསྩལ་བཞིན།",
    "ཁྱོད་ཀྱི་བསྟན་པ་འཛིན་དང་སྤེལ་བ་ལ།",
    "མཆོག་དང་ཐུན་མོང་དངོས་གྲུབ་སྩལ་ཏུ་གསོལ།",
    "རྒྱལ་སྲས་ཐུ་བོ་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "ཡོན་ཏན་ལྷུན་རྫོགས་ཁྱོད་ལ་གསོལ་བ་འདེབས།",
    "ཁྱོད་སྐུའི་ཉིན་བྱེད་ཡུམ་གྱི་ཆུ་འཛིན་ལས།",
    "ཀུན་ནས་སྲེད་པའི་གློག་གི་རོལ་རྩེད་དང་།"
  ]
}