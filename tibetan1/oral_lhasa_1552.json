    "གསེར་རྟ་བླ་རུང་སྒར་གྱི་གནས་བབ་སོགས་ལ་གལ་ཆེན་པོས་ཞལ་ཆེམས་སུ་གསུངས་པ་ཞིག་ཏུ་ཁོ་བོས་འདོད་ལ།",
    "སྐབས་དེའི་བོད་ཀྱི་སྐྱེས་བུ་རང་ཚུགས་སྲུང་བ་ཙམ་མ་ཡིན་པར་གཞན་སེམས་དཀྲུགས་པ་སྟེ།",
    "བོད་ནི་གཞན་སེམས་དཀྲུག་མཁན་མ་ཡིན་པར།",
    "སྒེར་གཅོད་དང་གཉའ་གནོན་ལ་ཕྱིར་རྒོལ་མེད་པར་གུ་ཡངས་སུ་གཏོང་བ་ནི།",
    "གྲྭ་ཤག་གཏོར་བཤིག་བཏང་བ་དང་ཇོ་སེར་གྱི་གྲངས་ཀར་ཚོད་འཛིན་སོགས་བྱས་ཏེ།",
    "དེ་ལ་གཞན་སེམས་དཀྲུགས་ནས་ངོ་རྒོལ་མི་བྱེད་པར།",
    "བཟོད་སྲན་གྱིས་མུ་མཐུད་དུ་ཐོས་བསམ་སྒོམ་གསུམ་བྱ་སའི་སློབ་གླིང་འདིར་སྲུང་སྐྱོབ་བྱས་ཏེ།",
    "དེ་ལྟར་ལགས་པས།",
    "སྒེར་གཅོད་ཀྱི་སྦྱོར་བ་མཐའ་དག་ངན་པ་ལངས་ཤོར་དུ་གྱུར་ནས་ཅི་བྱས་ལ་རྒོལ་ལན་མེད་པའི་མཐུན་རྐྱེན་གྱི་གོ་སྐབས་བཟུང་སྟེ།",
    "རང་མི་རིགས་ཀྱི་རང་ཚུགས་བསྲུངས་ནས་ཡུན་ནས་ཡུན་དུ་བསྡད་ན།",
    "མཇུག་འབྲས་ནི་ཕལ་ཆེར་ཉམས་པ་དང་རྒུད་པ་ལས་མེད་པར་འདོད།",
    "སྒེར་གཅོད་དང་གཉའ་གནོན་གྱི་འོག་ནས་རང་ཚུགས་བསྲུང་བ་ཙམ་གྱིས་མི་ཆོག་པར།",
    "དེ་ལ་འདྲ་མཉམ་གྱི་རྨང་གཞི་བརྟན་པོ་ཞིག་དགོས་པར་སེམས་ཏེ།",
    "རང་ཉིད་རང་ཉིད་ལ་ངོ་མི་གནོང་བའི་རྣམ་པར་དག་པའི་མི་ཞིག་ཏུ་འགྱུར་དང་མི་འགྱུར་ནི།",
    "སྐྱེས་བུ་ཞིག་ལ་དད་གུས་གཙང་མས་རྗེས་དྲན་གྱི་སྐྱེལ་མ་ཞུ་བ་ནི།",
    "མདུན་གྱི་རི་ཁྲོད་ཕྱོགས་སུ་སྙེག་པའི་བཙུན་པ་ལོ་གཞོན་དེས་ཕྱིར་བལྟས་ཐེངས་གཅིག་ཙམ་ཡང་མ་གནང་།",
    "ཟས་གོས་ཀྱི་འཚོ་བའི་དཀའ་ངལ་ག་ཙམ་མཆིས་ཀྱང་བློས་བཏང་ཆེན་པོ་གནང་སྟེ།",
    "བསྟན་འགྲོ་སྤྱི་ལ་ཐུགས་ཁུར་རླབས་པོ་ཆེ་གནང་བ་གཙོས་པའི་ནམ་རྒྱུན་གྱི་བླང་བྱ་རྣམས་ནི།"
  ]
}