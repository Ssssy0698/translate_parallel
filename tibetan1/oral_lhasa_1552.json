    "ལམ་ཐག་ཉེ་བའི་མདུན་ཕྱོགས་སུ་བལྟས་ནས་ཡོད་པར་ཞབས་ཕྱི་བ་དེས་ཉམས་འཇོག་ཐུབ་པ་བྱུང་ཞིང་།",
    "ཚིག་ཇ་སྡུད་པའི་སྐྱེས་པ་དེ་ཡ་མཚར་བའི་སྒོ་ནས་མན་ནུའུ་ཨེའར་གྱི་སྐྱ་བོར་གྱུར་བའི་ངོ་གདོང་ལ་ཅེར་ནས་བསྡད།",
    "ཚིག་ཇ་སྡུད་པའི་སྐྱེས་པ་དེས་ཕར་ཕྱོགས་སུ་བལྟས་ནས་བསྡད་ཅིང་།",
    "ཁོས་ཚིག་ཇ་དཀྲུག་དཀྲུག་འགའ་བྱས་ནས་ཁོ་ཧྥེ་ཕོར་བ་གང་བོ་འཐུང་བ་ན།",
    "ཁོ་ཕལ་ཆེར་གསར་དུ་ཐོན་པ་ཞིག་ཡིན་པར་སྙམ།",
    "མན་ནུའུ་ཨེའར་གྱིས་ཁོའི་མདུན་ཅོག་གམ་ནས་ལབ་གླེང་བྱེད་ཀྱིན་པའི་མི་དེ་ཚོར་བལྟས་ནས་བསྡད་ཅིང་།",
    "བལྟས་ཚོད་ཀྱིས་ཁོས་ཅི་བྱས་ཀྱང་ཁོ་ཚོར་ཚོར་བ་ཅི་ཡང་མེད་པ་འདྲ།",
    "མཐར་ཁོས་སླར་ཡང་གནས་འདི་ནས་ཁོ་བོ་སྒུག་ཞོར་དུ་ཅུང་ཙམ་གཉིད་ནས་བསྡད་ན་འགྲིག་པར་འདོད།",
    "ཁོ་གཉིད་ལས་སད་སྐབས་མི་ཞིག་ཁོའི་ཁ་གཏད་ཀྱི་སྐུབ་སྟེགས་ཀྱི་སྟེང་དུ་བསྡད་ནས་ཡོད་ལ།",
    "ཁོས་ཡུན་རིང་ཞིག་ཏུ་མན་ནུའུ་ཨེའར་ལ་བལྟས་ནས་བསྡད་རྗེས།",
    "ཁོ་ལྗིད་ཏིག་ཏིག་ངང་རྐུབ་སྟེགས་ཀྱི་སྟེང་དུ་བསྡད་པ་དང་།",
    "ཁོ་གཉིས་ལ་སྨྲ་བ་ཅི་ཡང་མེད་པར་མན་ནུའུ་ཨེའར་གྱི་སྐྱ་བོར་གྱུར་བའི་ངོ་གདོང་ལ་ཧུར་གྱིས་བལྟས་ནས་བསྡད།",
    "ཁ་ཕྱིར་འཁོར་ནས་ཅོག་ཙེའི་འགྲམ་དུ་བསྡད་ཡོད་པའི་མི་དེ་གཉིས་ལ་ཞིབ་ལྟ་ཞིག་བྱེད་ཞོར་བསྡད།",
    "དེ་ལྟར་བྱས་ན་ང་ལ་རྒྱལ་ཁ་ཐོབ་ཁོ་ཐག་ཡིན།",
    "ཁྱེད་ཀྱིས་ངེས་པར་དུ་འདི་ལྟར་བྱེད་དགོས་པ་ཡིན་ནམ་ཞེས་བཤད།",
    "ཁོ་ཚོ་འཇམ་ཐེང་ངེར་གནས་དེར་བསྡད་ཅིང་།",
    "མན་ནུའུ་ཨེའར་གྱིས་ཁོས་ངོ་གདོང་ལ་བལྟས་ནས་བསྡད།",
    "མན་ནུའུ་ཨེའར་གྱིས་ཁོའི་མིག་མདངས་ལས་གཡོལ་གང་ཐུབ་བྱས།",
    "ད་ཐེངས་ངས་ལས་ཀ་འདི་སྒྲུབ་པར་མཇུག་འབྲས་ལེགས་པོ་ཞིག་ཡོད་སྲིད་ཅེས་བཤད།",
    "སོས་དལ་གྱི་ངང་ནས་དབུགས་ཐེངས་གཅིག་ལ་འཇིབ་རྔུབ་བྱས།",
    "ཁོ་ལ་ཚོར་བར་རྩོད་པ་དེ་ལྟར་བྱས་པ་དེར་དཀའ་ངལ་ཆེན་པོ་ཡོད་པར་འདོད།",
    "དེའི་རྗེས་ནས་སྨྲ་བ་ཅི་ཡང་མེད་པར་ཁུ་སིམ་མེར་གྱུར།",
    "རིམ་གྱིས་གྲལ་སྒྲིག་བྱས།",
    "དུས་དེ་ནས་བཟུང་ཁོས་སླར་ཡང་མགོ་བརྩམས་ཏེ་དེའི་རྗེས་ཀྱི་བྱ་བ་རྣམས་ཇི་ལྟར་སྒྲུབ་དགོས་པར་བསམ་བློ་བཏང་།",
    "གཡས་ལྟ་གཡོན་ལྟ་ཅི་ཡང་མེད་པར་གཟབ་ནན་སྒོས་མདུན་དུ་སླེབས་བྱུང་།",
    "ཁོས་རྒྱང་རིང་དུ་གནས་པའི་ཕྱུགས་རའི་སྒོ་ཆེན་ལ་ཅེར་ནས་བསྡད།",
    "ཧྲི་ལེའུ་བཱོ་ཡི་ལག་གཡོན་མའི་རྟའི་རྣ་བར་བྱིལ་བྱིལ་ཞིག་བྱས།",
    "དེ་ཚུར་རྒྱུག་པའི་དུས་དང་བསྟུན་ནས་ཡངས་ཤིང་རྒྱ་ཆེ་བའི་སྣ་ཁུང་གཉིས་ལས་དབུགས་འཇིབ་རྔུབ་བྱས་པའི་སྒྲ་ཡང་གསལ་བོར་ཐོས་བྱུང་།",
    "བ་གླང་ཡང་ཉེན་ཁ་ཞིག་ལས་ཐར་བར་བྱས་ཀྱང་།",
    "ཁོས་ཟླ་གམ་དབྱིབས་ཀྱི་ཡོལ་རས་དེ་བྲེལ་ཚུབ་ངང་བསྡུ་ཉར་བྱས་པ་ན།",
    "མན་ནུའུ་ཨེའར་གྱིས་ཟླ་གམ་དབྱིབས་ཀྱི་ཡོལ་རས་དེ་སྒུལ་ཙམ་སྒུལ་ཙམ་བྱས་པ་ན།",
    "མན་ནུའུ་ཨའེར་གྱིས་སྔར་བཞིན་བ་གླང་ལ་བལྟས་ནས་བསྡད།",
    "ཁོ་ལ་བྱ་བ་ཅི་ཡང་མེད་པར་རང་འགུལ་གྱིས་བསྡད་ཡོད།",
    "བྱས་པ་ཤིན་ཏུ་ལེགས་ལ།",
    "མེ་ཏོག་ལྟ་བུའི་མདུང་དམར་པོ་དེ་ཁོའི་འགུལ་བསྐྱོད་ལ་རམ་འདེགས་བྱས་པ་ལྟར་ཡུན་གྱིས་འགུལ།",
    "ཁོས་མཉམ་འཇོག་བྱས་མེད་པའི་གླག་དང་བསྟུན་ནས་བ་གླང་ཁོའི་གམ་དུ་ཐོན་བྱུང་།",
    "སྔར་བཞིན་རྐང་པ་ཐེངས་གཅིག་ལ་བསྐོང་འཐེན་བྱས་ཤིང་།",
    "མུ་མཐུད་དུ་ལྡིང་སྐོར་བྱེད་ཀྱིན་རྐང་པ་གཉིས་རྗེན་པར་ཕུད།",
    "མན་ནུའུ་ཨེའར་གྱིས་མགོ་ལྡེམ་ལྡེམ་བྱས་བྱུང་།",
    "ཁོས་བསམ་པར་འགྲན་ཐེངས་འདི་ཡིག་ངོར་ཕབས་དགོས་པའི་རིན་ཐང་མེད་པར་སྙམ་ལ།",
    "མན་ནུའུ་ཨའེར་གྱིས་སྐུ་ཞབས་ཀྲུའུ་ཞི་ལགས།",
    "ཁོས་ཐེངས་འདིར་དོན་དག་གཅིག་ལ་བསམ་བློ་བཏང་ནས་བསྡད་ཡོད།",
    "བ་གླང་ལ་མགོ་བོ་སྒུར་དུ་བཅུག་ནས་དུས་ནམ་ཡང་མགོ་བོ་ཡར་འཇོག་ཏུ་འཇུག་མི་ཉན་པར་བསམ།",
    "མན་ནུའུ་ཨའེར་ལ་གྲགས་འགུལ་ཅི་ཡང་མེད་པར་བསྡད།",
    "མན་ནུའུ་ཨའེར་གྱི་ཆེས་མཐའ་མཇུག་མགོ་བོ་དགྱེ་དགྱེ་བྱས་པས།",
    "དྲག་རྒོལ་བྱེད་པར་གྲ་སྒྲིག་བྱས་ཚར་བའི་དུས་སུ།",
    "ཁོའི་སེམས་སུ་བ་གླང་ལ་རྡུང་རྡེགས་དྲག་པོ་ཞིག་བྱས་ན་ཆོག་པར་འདོད་བཞིན་ཡོད།",
    "དུས་མཚུངས་སུ་ལྟ་ཞིབ་ཀྱང་མང་པོ་ཞིག་བྱས།",
    "འོན་ཀྱང་ཁོས་ལེགས་འགྲུབ་བྱུང་བའི་དོན་དག་འདི་མཐའ་གཅིག་ཏུ་ཡི་གེའགས་མཚོན་ཐུབ་པར་འདོད་ཅིང་།",
    "རྭའི་མགོར་འཛེར་བའི་རས་ལྷབ་དེར་འདྲོགས་ནས་ནུས་པ་གང་ཡོད་ཀྱིས་པར་མཆོང་ཚུར་མཆོང་བྱས།",
    "བ་གླང་ལ་འདང་རྒྱག་སྤུ་ཙམ་ཡང་མེད་པར་ཁོའི་ཕྱོགས་སུ་གདོང་མཆོང་བྱས།",
    "དུས་དེ་ནས་བཟུང་བ་གླང་དེར་ཡར་བསྐྱར་དྲག་རྒོལ་བྱེད་པའི་གོ་སྐབས་གཞི་ནས་མེད་པར་གྱུར།",
    "མན་ནུའུ་ཨའེར་གྱིས་བློ་རྩེ་གཅིག་སྒྲིམ་བྱས་ཏེ་རལ་གྲིའི་ཁ་ལ་དམིགས་བཙུགས་ནས་སྔོན་གྱི་གནས་དེར་གཙགཁོས་སླར་ཡང་ཐེངས་གཅིག་ལ་གདོང་མཆོང་བྱས་རྗེས།",
    "རིམ་གྱིས་ར་སྐོར་གྱི་ཕྱོགས་སུ་བརྒྱུགས་ནས་རལ་གྲི་གསར་བ་ཞིག་ཏུ་བརྗེ་དགོས་པརའདོད།",
    "ཁོས་རལ་གྲིའི་སོ་ཁ་གཙང་མ་ཞིག་ཕྱི་རོགས་ཞེས་བཤད།",
    "ཧྲི་ལེའུ་བཱོ་གང་ན་ཡོད་པར་སྙམ།",
    "ཨའེར་ལ་བསྒུག་ནས་བསྡད།",
    "མན་ནུའུ་ཨའེར་གྱི་མགོ་བོ་ལྡེམ་ལྡེམ་བྱེད་ཞོར་ངོ་གདོང་ཕྱི་ཙམ་བྱས་པ་དང་།",
    "ཁོས་ངེས་པར་དུ་ཚང་མར་ལྟ་རུ་འཇུག་དགོས་འདོད།",
    "ཁོ་ས་རུ་འགྱེལ་ནས་གཡོ་བ་ཅི་ཡང་མེད་པར་ལོག་ནས་བསྡད།",
    "ཁོ་ལ་ཐབས་བཀོད་ཅི་ཡང་མེད་པར་སར་བསྡད་པ་དང་།",
    "ཁོའི་སེམས་གཏིང་ནས་དབུགས་འཇུབ་རྔུབ་བྱས་པ་དང་།",
    "ལམ་གཉིས་ནས་མིས་བཟོས་གཙང་བོའི་བརྒྱུད་དང་འབྲེལ་ནས་ཡོད།",
    "དེའི་རྔོ་ཐབ་ཀྱི་མདུན་དུ་ལངས་ནས་བསྡད་ན་ཧ་ཅང་སྐྱིད་པའི་ཚོར་བ་ཞིག་སྐྱེས་ཤིང་།",
    "དེའི་སྟེང་དུ་མཛེས་སྡུག་ལྡན་པའི་ཚིག་རྒྱན་གྱིས་གྲུབ་ཡོད་པའི་ཡི་གེའི་རྣམ་པར་ལྟ་རུ་བཅུག་པ་ཡིན།",
    "ངས་རང་ཉིད་ཀྱིས་བྱས་པའི་བྱ་བའི་ཐོག་ནས་ངོ་གནོང་མི་དགོས་པར་འདོད།",
    "ངས་རོགས་པ་ཚོར་བྱས་རྗེས་གཟེངས་རྟགས་ཐོབ་པའི་ཆེད་དུ་རང་ཉིད་ཀྱི་ཡོད་ཚད་བློས་བཏང་།",
    "བསྡད་ཡོད་པའི་སྐབས་སུ།",
    "ཁྱེད་ཀྱིས་གཉེན་སྒྲིག་བྱས་ཡོད་དམ་ངས་གཉེན་སྒྲིག་བྱས་མེད།",
    "སྐྱེས་པ་དེས་དོན་དངོས་ཐོག་ཇེའུ་ཀེར་ལ་གཤགས་བཅོས་བྱེད་རྒྱུ་ནི་ཤིན་ཏུ་སླ།",
    "སྔོན་ཆད་དང་ཁྱད་པར་ཅི་ཡང་ཡོད་མི་སྲིད།་",
    "འཚོ་བ་ཧ་ཅང་བདེ་སྐྱིད་ལྡན་པར་འདོད་པ་ཡིན་ནམ།",
    "ཁྱེད་ཀྱིས་གཤགས་བཅོས་བྱེད་མི་འདོད་ན་ངས་ཀྱང་བྱ་བ་དེའི་ཐོག་ནས་ཨུ་ཚུགས་མི་བྱེད།",
    "གལ་སྲིད་ཁྱེད་ཀྱིས་སེམས་གཏིང་ནས་གཤགས་བཅོས་བྱེད་མི་འདོད་ན།",
    "གལ་སྲིད་ངས་གཤགས་བཅོས་བྱས་བཞག་ན།",
    "མཐའ་འཁོར་གྱི་མི་རྣམ་ལ་ཞིབ་ལྟ་བྱས།",
    "ཁོ་གཉིས་ཚོང་སྒྲོམ་གྱི་འགྲམ་ནས་མར་བསྡད།",
    "མཆུའི་རྣམ་པའང་ཧ་ཅང་ཡག་པར་མ་ཟད།",
    "ལག་པར་ཡང་ལག་ཤུབས་ཤིག་གྱོན་ཡོད།",
    "ཡུལ་འདིའི་དོ་དམ་པར་ཇི་ལྟར་འབོད་དགོས་སམ།",
    "བློ་རིག་ཅན་གྱི་གསར་བུ་ལགས།",
    "ཁོ་ནང་དུ་བོས་ཤོག་ཁྱེད་ཚོའི་སེམས་སུ་རང་ཉིད་གང་ཞིག་ན་ཡོད་པར་འདོད་ཀྱིན་ཡོད་དམ།་",
    "ཚོང་སྒྲོམ་གྱི་འགྲམ་དུ་བསྡད་ཡོད་པའི་མི་དེ་གཉིས་ཀྱིས་ཁོ་ལ་ཐེངས་གཅིག་བལྟས།",
    "ཚོང་སྒྲོམ་གྱི་འགྲམ་དུ་བསྡད་ཡོད་པའི་སྐུ་མགྲོན་དེ་གཉིས་ལ་བལྟས་ནས་ལགས་སོ།",
    "མིང་ལ་མེའུ་ཁི་སི་ཟེར་བའི་སྐྱེས་པ་དེ་ཚོང་སྒྲོམ་འགྲམ་རྒྱུད་དུ་ཡོད་པའི་ཇོར་ཏྲི་ཡི་ཁ་གཏད་དུ་བསྡད་ཡོད་ལ།",
    "ནེའུ་ཁི་དང་ཇ་མ་གཉིས་པོ་ཁང་བའི་ཕུག་ཏུ་བསྡད་ཡོད།",
    "དུས་ཚོད་བདུན་པར་སླེབས་ཤིང་།",
    "འདི་ལྟར་བྱས་ནས་ཕན་པ་ཅི་ཡང་མེད།",
    "མེའུ་ཁི་སི་ཡིས་ཁོ་ལ་དོ་དམ་བྱས་ནས་ཅི་བྱ།",
    "ཇོར་ཏྲི་ཡིས་སྒེའུ་ཁུང་ནང་ནས་ཁོ་གཉིས་གློག་འོད་རྒྱུད་ནས་སྲང་ལམ་བརྒལ་ནས་འགྲོ་བཞིན་པའི་རྣམ་པར་བལྟས་ཤིང་།",
    "ཁོ་དང་བར་ཐག་རིང་པོ་བྱས་ན་ཤིན་ཏུ་ལེགས་ཞེས་བཤད།",
    "ཁོ་གང་ན་བསྡད་ཡོད་དམ་ཞེས་དྲིས།",
    "ཅིག་བྱས་ན་ཁོ་ཚོས་ཁྱེད་ལ་འཇིགས་སྐུལ་བྱས་པ་ཡིན་ནའང་ཐང་།",
    "ང་ཉིན་གང་བོར་གནས་འདིར་བསྡད་པ་ཡིན་ཞེས་བཤད།",
    "ཕྱོགས་སུ་ལངས་ནས་བསྡད་ཡོད།",
    "ངས་ཚོད་དཔག་བྱས་ན་དེ་ཚོས་ལག་འཇོག་སྲིད།",
    "རྡོར་ཏྲི་ཡིས་ལག་རས་ཤིག་ཁྱེར་ནས་ཡོང་སྟེ་ཚོང་སྒྲོམ་གྱི་སྟེགས་བུའི་ཐོག་ཏུ་གཙང་སྦྲ་བྱས།",
    "ཁོས་ང་སྒོར་ཕུད་ནས་ལངས་དེ་བསྡད་ན་ཆོག་ཅེས་བྲེལ་བ་དང་བཅས་དེ་ལན་བཏབ་བྱུང་།",
    "ཉི་འོད་ཀྱིས་རྩྭ་རྩེའི་ཟིལ་བ་གཅིག་ཀྱང་མ་ལུས་པར་སྐམ་པོར་བསྒྱུར་ཅིང་།",
    "གནམ་ངོ་དྭངས་ཤིང་ཕྱི་རོལ་གྲང་ཤུར་ཤུར་གྱི་རྣམ་པར་གནས་ལ།",
    "ལམ་གྱི་རྣམ་པ་ནི་ཕར་གུག་ཚུར་གུག་བྱས་ནས་ཡོད་ཅིང་།",
    "ངས་ཀེའུ་ཡུ་ལ་ན་གཞོན་དེ་དབྱི་ཐ་ལི་རུ་ད་དུང་ལམ་ཐག་རིང་པོ་ཞིག་བརྒྱུད་ནས་འགྲོ་དགོས་པར་སྙམ་ཞེས་བཤད།",
    "འཇར་མན་ལྷོ་རྒྱུད་ཀྱི་མི་ཚང་མ་ཞི་འཇམ་བག་ཕེབས་རྐྱང་རྐྱང་ཡིན་ཞེས་བཤད།",
    "ལྷག་པར་དུ་གཡས་ཕྱོགས་ཀྱི་ངོ་དབྱིབས་ནི་ཆེ་ཞིང་མཛེས་སྡུག་ལྡན་པ་ཞིག་ཡིན།",
    "ཀེའུ་ཡུས་ཁྱེད་ཀྱི་སྐྱག་ཁ་བཙུམ་ནས་བསྡད་ན་ཆོག་གམ།",
    "ངས་ཀྱང་དེ་བཞིན་དུ་ཀེའུ་ཡུ་ལ་སྐད་ཆ་དེ་བརྒྱུད་བསྒྲགས་བྱས་པ་ཡིན།",
    "ད་དུང་ས་རུབ་པར་དུས་ཚོད་ལེའུ་ལྔ་བ།",
    "ཅུང་ཙམ་ལ་བསྡད་ནའང་ཆོག་ནམ་ལངས་པ་དང་ངེས་པར་དུ་ལམ་ལ་ཆས་དགོས།",
    "ར་སོགས་གཙང་མར་བཞར་ཡོད་པའི་ན་གཞོན་དེས་ཁོ་གཉིས་ཀྱི་སྟེང་དུ་དུས་ཚོད་ཆུ་ཟོས་སུ་མ་གཏོང་།",
    "ད་དུང་ཁ་སྤུ་གཙང་མར་བཞར་བའི་སྐྱེས་པ་དང་ལྷན་དུ་ཅོག་ཙེའི་འགྲམ་དུ་བསྡད།",
    "འཇིབ་རྔུབ་བྱས་པའི་ཁ་རླངས་ཀྱི་རྣམ་པ་ཡང་མཐོང་ཐུབ།",
    "སྐྱེས་པ་དེའི་ཚ་རླངས་ལ་བལྟས་ནས་མགོ་བོ་གཡུག་ཙམ་བྱས།",
    "ངས་སང་རས་ལྷབ་མ་ཞིག་བཟུང་ནས་རླངས་འཁོར་གྱི་སྒེའུ་ཁུང་དང་གློག་རླངས་འཁོར་གྱི་ཨང་བྱང་གཙང་མར་ཕྱིས།",
