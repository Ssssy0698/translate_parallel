    "ཧལ་ཧ་དམ་ཚིག་རྡོ་རྗེའི་གསུང་འབུམ་སོགས་གཟིགས་དཔེ་པོད་མང་།",
    "རྔ་མོང་།",
    "ལྷར་བཅས་སྐྱེ་རྒུ་ཡོངས་ཀྱི་གཙུག་གི་ནོར་བུ་ལུང་རྟོགས་བསྟན་པའི་མངའ་བདག་མཚུངས་པ་མེད་པ།",
    "སྐུ་རྩེད་ཀྱི་རྣམ་པས་གཟིམ་ཆུང་ཀ་རྩེ་ན་ཡོད་པའི་སྒྲོལ་དཀར་བཟོས་གྲུབ་ཤེལ་སྒོ་ཅན་ཞིག་ཡོད་པ་ཤིང་རིང་བོ་ཞིག་གིས་སར་ཕངས་ཏེ་ལྗིད་ཀྱིས་མནན་ཀྱང་སྐྱོན་ཅུང་ཟད་ཀྱང་མ་བྱུང་བ་ཞབས་པད་དུ་འཁོད་པ་དག་གིས་ཡ་མཚན་དུ་གླེང་།",
    "རྨེ་རྒྱལ་བློན་གྱིས་མར་མོ་ཐང་ནས་བསུ་ཉིན་རྗེ་གོང་མའི་དུས་མཆོད་ཀྱི་ཉིན་དང་འགྲིགས་པ་ང་།",
    "ཅེས་ལུང་གིས་ཟིན་པ་ལྟར་རྨེ་རྒྱལ་རབས་རྣམས་རྗེ་འདིའི་སྦྱིན་བདག་གི་མཐིལ་དུ་སོང་བ་དང་།",
    "བྱམས་ཐང་གི་དཔོན་ཁག་སོ་སོ་དང་།",
    "རྨེ་ཚང་འབྲོག་གི་ཐབ་བསུ།",
    "དབོ་ཟླའི་དཀར་ཕྱོགས་ཀྱི་དགའ་བ་དང་བོའི་ཉིན་གྲྭ་མང་གིས་རྟ་ཐབ་གྱི་བསུ་བ།",
    "ཚེས་དྲུག་གི་དུས་ཆེན་དང་བསྒྲིགས།",
    "སྐུ་གོང་མས་མོ་ལ་གནང་བའི་མཚན་བརྗོད་ཀྱི་གླེགས་བམ།",
    "མཆོག་གི་དངོས་གྲུབ་འགྲུབ་པའི་ལྟས་དང་།",
    "སྔར་ནས་མངོན་ལྐོག་གིས་བརྟག་པ་བྱས་པ་དང་ལྷུ་འགྲིགས་པས་རྒྱལ་པོ་ཡིད་ཆེས་ཀྱི་ས་ལ་བཀོད།",
    "འདི་ནས་བཟུང་དཔའ་གཅིག་གི་ཆོ་ག་ཆགས་མེད་དང་།",
    "རྫི་འགག་སོགས་ལ་འཚམས་ཞུས་ཀྱི་མི་སྣ་མངགས་ཤིང་ཁོང་པ་དག་གིས་ཀྱང་མི་སྣ་ཆེད་མངགས་སྒོས་ཟང་ཟིང་གི་བདོག་པས་མཆོད།",
    "དགོན་དང་དུ་ཕེབས་ཏེ་ཆོག་རོགས་པ་དང་བཅས་གུར་ཞལ་གྱི་བསྐང་གསོ་ཚོགས་༢ཁོར་འབུལ་བ་དང་སྦྲགས་ལྷ་ཞལ་གཟིགས།",
    "སྐབས་ཤིག་རྡོ་ཞིག་གི་ངོས་ལ།",
    "མཆོག་མཚན་ཉིད་དགོན་དུ་རྗེ་གུང་ཐང་བར་འཚམས་ཞུས་འབུལ་རེས་མཛད།",
    "རྨེ་ཚང་གི་འབྲོག་གཞིས་སུ་བཅགས་མལ་སྐབས་རྔ་བའི་སྐྱ་སེར་རྣམས་ནས་འཚམས་ཞུས་དང་།",
    "དད་ལྡན་མང་བོ་མཇལ་ཕྱག་ཏུ་བཅར་བའི་རེ་བ་བསྐངས།",
    "ཨ་མཆོག་ཚང་ལ་འཚམས་ཞུས་དང་།",
    "གཅའ་ཚང་དུ་ཕེབས་ནས་ཚ་ཁོ་དང་གཅའ་ཚང་གི་གྱོད་ཆེན་དང་།",
    "སོག་ཚང་ནས་བསྙེན་བཀུར་བཟབས་པ་བདག་གིར་བཞེས་ངོས་ཐང་སྐོར།",
    "གདན་སར་འདུ་ཁང་གསར་བཞེངས་ཀྱི་ཨར་ལས་སྐབས་སུ་སོང་བས་གླིང་གཅིག་གི་གྱང་རིལ་བོར་ལོག་ཀྱང་ཉེས་སྐྱོན་ཕྲ་མོ་ཙམ་ཡང་མ་བྱུང་བ་རྗེ་འདིའི་བྱིན་མཐུར་གླེང་།",
    "ཚེས་བཅོ་བརྒྱད་ལ་གདན་ས་རང་གི་བསུ་བ་བསྐྱར་མ་དང་།",
    "ཐེ་རོང་ནས་གདན་འདྲེན་ནན་ཆེ་བར་ཡོངས་འཛིན་ཚང་གི་ཐུགས་བརྟག་དང་མཐུན་པར་ཕེབས་རྒྱུ་བྱས།",
    "དགུ་བའི་ཚེས་མགོར་གནས་སྲུང་དྲུག་པོ་རྩལ་གྱི་སྲུང་ནགས་ལས་འདུ་ཁང་ཆེན་མོའི་ཤིང་ཆ་བཏུ་བའི་དོན་དུ་གནས་སྒོར་ཕེབས་ནས་གནས་སྲུང་ལ་བསང་དང་དཀར་གཏོར་བཏང་ནས་འཕྲིན་བཅོལ་མཛད།",
    "རྒྱུན་པར་བུད་ཤིང་ཅུང་ཟད་རེ་བླངས་ཀྱང་འཚུབ་འགྱུར་ཆེ་བ་ཞིག་ཡིན་མོད།",
    "འདུ་ཁང་གི་ཆེད་སྡོང་བོ་མོད་མི་དམའ་བ་བཅད་ཀྱང་འཚུབ་ངོ་ཕྲ་མོ་ཙམ་ཡང་མ་བྱུང་བ་ནི་མི་མ་ཡིན་རྣམས་རྡོ་རྗེའི་བཀའ་ལས་ནམ་ཡང་མི་འདའ་བའི་གཏན་ཚིགས་འཁྲུལ་མེད་དུ་རྟོགས་སླའོ།",
    "རྒྱ་ཟངས་ཐང་དུ་བཞུགས་སྒར་བཏབ་སྐབས་རྨེ་ཚང་གི་སྲས་མོ་ཆུང་ངུ་ཞིག་འདས་པའི་ལྗགས་བསྔོ་ཞུ་རྟེན་འབུལ་བར་ནང་བློན་ཕུར་བ་ངོ་གཡོག་འབྱོར་བ་ལ་གཤིན་པོ་རྗེས་འཛིན་གྱི་ཐུགས་དམིགས་དང་།",
    "དགའ་ལྡན་ལྔ་མཆོད་ཆེན་མོའི་མཆོད་འབུལ་དང་།",
    "ཆིབས་བསུ་སེར་སྦྲེང་དང་བཅས་རྒྱལ་ཟླའི་དམར་ཕྱོགས་ཀྱི་བཟང་བོ་གཉིས་པར་གདན་སར་འབྱོར་འཕྲལ་ཀུན་རིག་གི་ལྗགས་བསྙེན་ཚུགས་ཏེ་ལྷག་པའི་ལྷའི་བསྙེན་སྒྲུབ་ལ་གཞོལ།",
    "གོས་ཕྲུག་སྣམ་རས་སོགས་མང་ཞིག་རྣམ་དཀར་གྱི་རྒྱུར་སོང་།",
    "ཚེས་བཅུ་གསུམ་ལ་ཁ་སྐོང་སྦྱིན་སྲེག་ཕུལ་ཏེ་བཅད་རྒྱ་ལས་བཞེངས་ནས་འཆམ་གཟིགས་དང་མཆོད་གཟིགས།",
    "ད་དུང་དེ་མཐུན་བཞེངས་ངེས་པས་དེ་དག་གི་རྣམ་དཀར་ཞབས་པད་བརྟན་ཅིང་མཛད་འཕྲིན་རྒྱས་པའི་ཆ་རྐྱེན་དུ་བདག་གིར་བཞེས་དགོས་ཚུལ་ཞུས་པར་དགྱེས་ཉམས་ཆེ་བ་མཛད།",
    "མཁར་སྟེང་གི་རྒྱ་ཁྱིམ་ཁ་ཤས།",
    "མཁར་མོ་ཆེ།",
    "སྲང་སུམ་བརྒྱ་ལྷག་གིས་ཚོགས་ཟངས་སྤུས་ལེགས་གསར་བསྒྲུབས་ཀྱིས་གདན་སར་སྦྱོར་འཇགས་མཛད།",
    "ཐན་པ་ཆེ་སྒང་དུ་སོང་བས་ཆར་འབེབས་ཞུས་པར་གསེར་ཁྲིའི་སྐུ་གདུང་མདུན་ནས་ཁྲུས་གསོལ་མཛད་པ་ཙམ་གྱིས་ཆར་རྒྱུན་ཡུན་རིང་འཇོ་བ་བྱུང་བས་ཞིང་རྣམས་དབུགས་ཕྱིན་པར་གྱུར།",
    "དགོན་གཤམ་ནས་མཆོད་རྫས་སྣ་ཚོགས་འཆང་བའི་ངུར་སྨྲིག་གི་རྒྱལ་མཚན་གཟབ་འཕྱོར་ཅན་གྱི་སེར་སྦྲེང་དང་བཅས།",
    "གན་མཛོད་བདག་གིར་བགྱིད་ལ་ཐུབ་བསྟན་མཆོག།",
    "རེ་བའི་སེན་མོ་གང་གི་ཞབས་པད་ལ།",
    "ཅེས་པ་ནི་གསན་སྦྱོང་གི་གཞི་བཏིངས་ཤིང་འབྲེལ་ཚད་དོན་ལྡན་དུ་མཛད་པའི་ཚུལ་ལ་བསྔགས་པའི་བར་སྐབས་ཚིགས་བཅད་དོ།",
    "ད་ལྟའི་དུས་ན་ཡང་བསྟན་འཛིན་གྱི་ཁྲི་ལ་འགྱིང་བག་གིས་འཁོད་པ་སའི་རྡུལ་ལ་ཅོ་འདྲི་བ་ཞིག་བཞུགས་ཀྱང་།",
    "དེ་ཡང་རྡོ་རྗེ་འཆང་འདི་རྒྱུན་དུ་དུས་བཞི་ཕལ་ཆེར་ལ་ཐུན་མོང་དང་ཐུན་མོང་མིན་པའི་ལམ་རྣམས་སྐུ་ཉམས་སུ་བསྟར་བའི་ཆ་རྐྱེན་དུ་བཅད་རྒྱ་ལས་མི་འགོངས་པ་ཞིག་ཡིན་པར་མ་ཟད།",
    "ཞེས་བག་ཕེབས་པའི་གསུང་གིས་ཞལ་བཞེས་ཡང་དག་པར་གནང་།",
    "ཐུགས་ཤེས་བྱའི་དཀྱིལ་འཁོར་མ་ལུས་པ་གཟིགས་པའི་མཁྱེན་པ་དང་ལྡན་ཞིང་འཕྲིན་ལས་རྒྱལ་བ་རྣམས་དང་མཉམ་དུ་འཇུག་པ།",
    "ཨ་ཁུ་དབོན་པོ་བཅས་ཀྱིས་ཐུགས་ལ་ནན་ཏན་བསྣམ་དགོས།",
    "ལུགས་གཉིས་ཀྱི་བྱ་བ་ཆེ་ཕྲ་ཐམས་ཅད་ལ་བཀའ་ཁྱབ་ཞིབ་མོར་སྩོལ་བ་དང་།",
    "རོལ་མོ་གཅིག་འཁར་རྔ་གཅིག་ཕྲུག་ཡུག་གོས་ཡུག་རྒྱ་དངུལ་རྟ་རྨིག་མ་བདུན།",
    "ཁྲི་རྒྱབ་ཡོལ་བཅས་རེ་རེ་ནས་རྗེ་ཉིད་ཀྱིས་ཕྱག་གིས་བཏེག་ཏེ་ཕུལ།",
    "ཨ་ལགས་དབོན་པོ་ཚང་གི་ཐུགས་ལ་ངེས་པར་འཛིན་དགོས།",
    "འཇིག་རྟེན་གྱི་བྱ་བ་ཡང་ལས་འབྲས་དྲང་ཐིག་གི་སྒོ་ནས་མངའ་འབངས་རྣམས་ཀྱེ་བདེ་སྐྱིད་རྒྱས་པའི་ཐབས་ལྷུར་བཞེས་པ་རྗེས་སུ་ཡི་རང་གི་གནས་རེད།",
    "རྗེ་འདི་ཕེབས་སྐབས་གྲུ་ཐད་སོར་བུད་པས་མཉན་པ་རྣམས་ཀྱང་ངོ་མཚར་བའི་གནས་ལ་བཀོད།",
    "སྟག་གཟིག་སོགས་གཅན་གཟན་འགའ་ཡང་གཟིགས་ཞེས་སྐུ་གམ་པ་འགའ་ལ་གསུངས།",
    "ལོ་འདིར་ཆར་དཀོན་ཅིང་ནུས་ལྡན་དུ་རློམ་པ་མང་བོས་མ་ཕོབ་པར་ཡོད་པ་ལ་རྗེ་འདིར་ཞུས་པས་ཁྲུས་གསོལ་སོགས་ཐབས་འགའ་གནང་བས་འཕྲལ་དུ་ཆར་གྱི་རྒྱུན་བཟང་བོ་བབས་པས་ཆར་ལ་རེ་བ་ཅན་རྣམས་དགའ་དད་ཀྱི་ས་ལ་བཀོད།",
    "ཚེས་ཉེར་དགུ་ལ་སྒར་ལུང་གིས་ཆིབས་སྐྱེལ་ཞུས་ཏེ།",
    "བསེ་སྐུ་ཞབས་བློ་བཟང་བཀྲ་ཤིས་འཕྲིན་ལས་རྒྱ་མཚོ་དང་ཕན་ཚུན་བཀུར་སྟི་དང་བཅས་མཇལ་འཛོམས་སྟེང་ཟང་ཟིང་གི་བདོག་པ་བསྟར་རེས་དང་།",
    "ཉ་ཐོའི་དཔོན་ཚང་དུ་ལྷ་མོའི་རྟེན་ཐང་ལ་སྙན་ཤལ་ཕུལ་བ་བཞེས་ཉམས་མངོན་མཚན་ཆེ་བ་བྱུང་།",
    "དེ་སྐབས་རྡོ་རྗེ་འཆང་སཾགྷའི་ཞབས་ཐ་མལ་སྣང་བར་སྙུན་གཞི་བཞེས་པ་གསན་པས་ལྷ་མོའི་གདན་ས་སོགས་ཡས་མས་སུ་ཞབས་རིམ་མང་དུ་བསྒྲུབས་བཅུག་ཅིང་།",
    "ཨ་མཆོག་ཤོ་རྡེ།",
    "མཇལ་ཕྱག་དོན་གཉེར་བ་མང་དག་བྱུང་བའི་རེ་བ་བསྐངས་ཤིང་།",
    "འདུ་ཁང་ཆེན་མོའི་རྩིག་བཟོ་དགའ་རབ་གྲུབ་ཡོད་པ་ལ་གཟིགས་རྟོག་ངོས་ཤིས་བརྗོད་མཛད་དེ།",
    "རྟ་ཟོག་ལྔ་བརྒྱ་ལྷག་སོང་བས་མཚོན་ཟང་ཟིང་གི་སྦྱིན་པ་རླབས་གང་ཆེ་མཛད།",
    "མར་མེ་བརྒྱ་རེ་ཆགས་མེད་འབུལ་བའི་སྲོལ་བཙུགས་ཏེ།",
    "ཞབས་སྡོད་པ་འགར་ཁྱེད་ཅག་གིས་ནང་ཆེན་གྱི་དཀོར་ཟས་འབའ་ཞིག་ལ་བག་མེད་དུ་སྤྱད་ནས་ཁ་འདོན་བསགས་སྦྱངས་སོགས་ཅི་ཡང་མི་བྱེད་པར་འདུག་པ་ནི།",
    "མཚོ་ཚང་གི་རུ་བ་སོགས་ལམ་བར་གྱི་འབྲོག་རུ་རྣམས་བརྒྱུད།",
    "རབ་འབྱམས་སྨྲ་བའི་ཤེས་གཉེན་མང་བོས་གཙོས་གདན་ས་རང་གི་བླ་གྲྭ་ལྷན་རྒྱས།",
    "རྗེ་འདིའི་བསྟན་པའི་སྦྱིན་བདག་གི་གཙོ་བོ་རྨེ་རྒྱལ་པོ་ཆེན་པོ།",
    "འབུད་དཀྲོལ་རྡུང་བའི་རོལ་མོའི་བྱེ་བྲག་དཔག་ཏུ་མེད་པའི་སེར་སྦྲེང་གི་བཀོད་པ་ཡིད་དུ་འོང་བས་མདུན་བསུས་ཏེ།",
    "ཀིརྟི་རྨེ་ཚང་གི་སྐྱབས་གནས་གཅིག་ཆོག་ཡིན་པ་དང་།",
    "ཚེས་བཞི་ལ་རྨེ་ཚང་གི་སྒར་གཞིས་སུ་ཕེབས་པར་སྟོན་ཆེན་དང་འབུལ་ནོད་རྒྱ་ཆེར་བཏེག་རྒྱུད་པའི་འདུ་ཁང་གསར་བཞེངས་ཀྱི་ས་མིག་ལ་གཟིགས་ཏེ་ཤིས་བརྗོད་ཀྱི་མེ་ཏོག་གཏོར་སྐབས་རྗེ་དགེ་ལེགས་མའི་སྣང་བརྙན་དང་།",
    "འདོན་རྒྱུགས་ཞིབ་ཏུ་བཞེས་ནས་གསུང་གིས་དབུགས་དབྱུང་སྩལ།",
    "འབྲོག་པའི་ཐབ་བསུ་བདག་གིར་བཞེས་ཤིང་།",
    "སྤྱན་རས་གཟིགས་དང་སྒྲོལ་མའི་བྲིས་ཐང་གཉིས་རབ་གནས་ལ་ཕུལ་བར་མ་བཀྲམ་པ་ནས་སོ་སོར་འཁྲུལ་མེད་ངོས་འཛིན་མཛད་པས་ཞབས་པད་དུ་འཁོད་པ་རྣམས་དད་པའི་ས་ལ་བཀོད།",
    "གདན་འདྲེན་པ་མང་པོའི་མོས་བསྟུན་གྱིས་ཕེབས་བཞུད་ཀྱི་སྒོ་བཏོད་པར་མི་འགྲོ་ཞེས་གསུངས་ཤིང་ཅུང་ཟད་བསྙུན་ཚུལ་བཞེས་པར་བརྟེན་མགྱོགས་ཤད་ཀྱིས་ཕེབས་པ་སྣྲོན་ཟླའི་བཅུ་བཞི་ལ་གདན་སར་འབྱོར།",
    "༨འདུ་ཁང་ཆེན་མོ་ལུང་རིག་སྤུངས་པའི་གན་མཛོད་ཀྱི་ཐོག་ཁང་གྲུབ་པའི་དགའ་སྟོན་དང་།",
    "དྲུག་པའི་ཉར་འདུ་ཁང་ཆེན་མོའི་ཀ་བ་སློང་དུས་དང་།",
    "སླར་གདན་སར་བྱོན་ནས་འདུ་ཁང་ཆེན་མོའི་སྒང་སྟོན་སྐབས་སྐུ་དངོས་ཕེབས་ཀྱིས་མཛད་སྒོ་རྣམས་ཕྱག་ཏུ་བཞེས་ཤིང་།",
    "དེང་དུས་དམ་པའི་ཡང་སྤྲུལ་ཏུ་ཁས་འཆེ་བ་ཤོ་ལོ་ཀ་རེའི་དོན་དུ་ཡང་བསྐལ་ཆེན་གྲངས་མེད་གསུམ་གྱི་ཚོགས་གསོག་དགོས་པ་དག་ལ་དཔགས་ན་ཆེས་ཡ་མཚན་པ་དང་།",
    "དངུལ་བྲེ་རེ་གསོལ་རས་སུ་སྩལ།",
    "ནུར་མའི་དཔལ་བློ་ན་བར་སྤྱན་དྲངས་སྐབས་རེ་ཞིག་མི་འཆི་བས་ད་ལན་མི་ཕེབས་ཞེས་ཐག་བཅད་ཀྱང་ཨུ་ཚུགས་མཐར་སྐྱེལ་བྱས་པའི་མོས་བསྟུན་གྱིས་ཕེབས།",
    "ཁྱོ་ཁོ་སྨད་རྣམས་སུ་མཛད་སྒོ་རྣམས་ཕྱག་ཏུ་བསྟར་བར་རྟ་ཐོག་ལྔ་བརྒྱ་དང་།",
    "དེར་བཞུགས་སྐབས་བླ་བྲང་གི་བླ་གྲྭ་མང་བོས་ཀྱང་གུས་འདུད་ཞུས།",
    "ཕྲན་ལའང་མཇུག་གི་སྨོན་ཚིག་གི་དོན་ལྟར་ཐུགས་སྨོན་གནང་དགོས་ཞེས་ཞུ་འཕྲིན་ཕུལ་བ་མི་སྣ་སླར་འབྱོར་གདོང་ཕྱག་ཏུ་སོན་པས་དགྱེས་ཚོར་བརྟས།",
    "ཐེ་རོང་དུ་རྒྱ་དམག་གི་ཉེར་འཚེའི་སྒོ་བཏོད་པར་ཉེས་སྐྱོན་མི་འབྱུང་ཞེས་སྔ་ཕྱིར་གདེང་དང་ལྡན་པའི་གསུང་ཡང་ཡང་ཕེབས་ཏེ་དད་པའི་ས་ལ་བཀོད།",
    "རྟ་ཕོ་རྒོད་ཉེར་ལྔ་དང་དངུལ་འགའ་འདུ་ཁང་གི་ཤིང་བཟོའི་ལག་ཡོན་དུ་སྦྱར།",
    "ཁ་སྐོང་དཔའ་བོའི་སྟོན་མོ་དང་བཅས་པ་གྲུབ་ནས་ལྔ་མཆོད་ཀྱི་མཆོད་འབུལ་མཛད།",
    "མཁར་ཆེན་སྲིབ་པར་ལོ་ཤས་རིང་ལོ་ཉེས་སོགས་མི་འདོད་པ་མང་བོ་བྱུང་རྐྱེན་དད་གདུང་གིས་སྤྱན་དྲངས་པ་ལྟར་ཕེབས་བཞུད་དང་སླད་ཆར་འདོད་མོས་རྣམས་ཡིད་བཞིན་འགྲུབ་པའི་ཞལ་བཞེས།",
    "སེང་གདོང་དུང་ཕྱུར་སོགས་གེགས་སེལ་མང་བསྒྲུབས་བཅུག་རེབ་གོང་ནས་གོང་ས་སྐལ་ལྡན་དྲུག་པ་ཆེན་པོ་དགོངས་པ་ས་དབྱིངས་སུ་གཟིམས་པའི་དོན་རྒྱ་དངུལ་རྟ་རྨིག་མ་སོགས་ཚན་གྲངས་མང་པོ་འབྱོར་བར་དགོངས་པ་ཡོངས་སུ་རྫོགས་པའི་ཐུགས་དམ་ཉམས་བཞེས་དང་།",
    "སྔར་གདན་སར་གཤིན་རྗེའི་གཤེད་ཀྱི་རྩ་སྔགས་དུང་ཕྱུར་སྒྲུབ་སྲོལ་བཙུགས་པ་ལྟར་འདི་སྐབས་དུང་ཕྱུར་སོང་བའི་སྦྱིན་སྲེག་འབུལ་བ་དང་།",
    "ཡོངས་འཛིན་ཚང་གིས་སྔར་ནས་ཡོངས་འཛིན་གྱི་གོ་གནས་བཞག་ཆོག་པའི་དགོངས་ཞུས་ཚ་ནན་ཡང་ཡང་མཛད་པས་ཁྲོལ་ཆ་མི་མཛད་ཐབས་མེད་དུ་གྱུར་ཏེ་དྲུག་པའི་ཡར་ཚེས་ནས་སྐུ་དབོན་དམ་པས་གྲོས་རྣམས་ལ་གྲོས་བསྟུན་དང་།",
    "ཉེར་སྤྱད་སྐོར་སོགས་རེ་རེ་ནས་གྲངས་དང་རིན་ཐང་ཅན།",
    "ཆག་ཝ་མ་སོགས་ཀྱི་དད་མོས་ཅན་མང་བོའི་འདུན་པ་ལྟར་རིབ་ཕེབས་དང་།",
    "རྒྱལ་པོ་ཆིན་ཝང་གི་ཞལ་ཚབ་ཐུ་ས་ལག་ཆི་ཨ་རྒ་འཇམ་དབྱངས་དང་།",
    "འདུ་ཁང་གི་རྟེན་གསར་བ་རྣམས་བཞེངས་རིམ་བཞིན་རབ་གནས་ཀྱིས་བྱིན་ཕབ།",
    "བཞག་སྡོམ་པས་རྐ་ཆུ་ཁ་བ་དང་ཕྱི་ནང་མེད་པའི་ལྷ་འབངས་སུ་ཁས་བླངས་ཏེ་མི་འགྱུར་བའི་ཡི་གེ་བཞག་པར་ཁོང་བ་དག་ཟང་ཟིང་གིས་ཚིམས་པར་བགྱིས།",
    "མཚོ་བདུན་རྣམས་ཀྱི་སྐྱ་སེར་གྱི་བསུ་བ་བདག་གིར་བཞེས་ཏེ་ནག་པའི་ཚེས་བདུན་ལ་རྗེ་འབྲོག་རུར་བབས།",
    "རྨེ་རྒྱལ་བགྲེས་པའི་དུས་བཞིན་རྒྱ་གར་ལྷ་གཅིག་བཞིན་དུ་བྱེད་པ་ལགས་ན་དམ་པ་ཉིད་ནས་ཀྱང་རྗེས་སུ་འཛིན་ཚུལ་ཐུན་མོང་མིན་པས་རྗེས་སུ་འཛིན་པ་དང་།",
    "ཁྱོད་དྲུང་ཁྲག་ཁྲིག་སྒོ་འཕར་ཕྱེ་བ་ཡི།",
    "རིགས་ཀྱི་བདག་པོ་མཆོག་ཏུ་བཀུར་བ་མཁས་གྲུབ་ཀྱི་མཛད་པ་མ་ལུས་ཆེན་པོ་ལ་རྒྱ་མཚོའི་དཔེས་མཚོན་པར་བྱ་བ་རྒྱལ་བ་སཾགྷའི་ཞབས་དེ་ཉིད་ཐུན་མོང་ཚུལ་བཞེས་སུ་དངོས་ཞལ་མཇལ་བའི་ཡུལ་ལས་འདས་ནས་རིང་ཞིག་ལོན་པས།",
    "ད་ནི་ཁྱབ་བདག་རྡོ་རྗེ་འཆང་ཆེན་པོ་དེ་ཉིད་ཀྱི་ཞལ་ཚབ་ཏུ་གང་གི་ཉེ་སྲས་ཁྲོད་ན་བཀུར་བར་འོས་པ་སུ་ཞིག་ཡོད་སྙམ་དུ་གཟིགས་པ་དག་པས་དགོངས་པ་ན།",
    "ཞེས་གསུངས་པ་ལྟར་གྱི་མཚན་ཉིད་ཐམས་ཅད་རྫོགས་པར་མཐུན་སྣང་དུ་མངའ་བ་ནི་རྟོགས་ལྡན་འཇམ་དཔལ་རྒྱ་མཚོ་སླར་ཡང་སྲིད་འདིར་བསམ་བཞིན་སྐྱེ་བ་བཞེས་པ་བདག་གི་མཁན་ཆེན་ཡོངས་རྫོགས་བསྟན་པའི་མངའ་བདག་དོན་གྱི་སླད་དུ་མཚན་ནས་སྨོས་ཏེ་རྡོ་རྗེ་འཆང་འཇམ་དབྱངས་ཐུབ་བསྟན་རྒྱ་མཚོ་དཔལ་བཟང་བོ་ཉག་གཅིག་པུར་གཟིགས་ནས་སྟོན་པ་བླ་ན་མེད་པར་བཀུར་བའི་དགོངས་པ་མངོན་དུ་བྱས་ཏེ་སྙན་གསན་སྔ་ཕྱི་དང་བསུ་བ་རིམ་པར་མངགས་པ་སོགས་གོང་དུ་བརྗོད་ཟིན་པ་ལྟར་ཕེབས་པ་ཡབ་སྲས་ཞལ་འཛོམས་ཀྱི་ཆེད་ནོར་བུའི་སུམ་སྣར་སྒར་ཆེན་བཏབ་པའི་སྟེང་ཡབ་སྲས་ཀྱི་ཞབས་པད་བཀོད།",
    "ས་ག་ཟླ་བའི་དཀར་ཕྱོགས་ཀྱི་དགའ་བ་དང་བོའི་སྔ་ཆར་སྐུ་དབོན་ཆེ་ཆུང་གིས་གཙོས་ཞབས་ཕྱི་བྱིངས་ནས་སེར་སྦྲེང་དང་།",
    "རྗེ་ཉིད་རོང་འབྲོག་གི་རྟ་ཐབ་ཀྱི་བསུ་བ་དང་བཅས་མཁའ་རི་ནས་ལྷ་བསང་བཏང་སྟེ་ཀིརྟི་མའི་འབྲོག་ཏུ་ཕེབས་སྐབས།",
    "འཇིགས་བྱེད་ཀྱི་རྗེས་གནང་གཉི་གིག་དབྱངས་ཅན་མ་དམར་མོ།",
    "རིགས་བྱེད་མ་ཕྱི་སྒྲུབ་ཐུན་མོང་དང་ཐུན་མིན་སྦྲགས་པ།",
    "ཚེ་ལྷ་རྣམ་གསུམ་གྱི་སྐུ་ཆེ་ལེགས་རེ་སོགས་སྐུ་གསུང་ཐུགས་རྟེན།",
    "མཛོ་མོ་གཅིག་བཅས་སྲང་ལྔ་བརྒྱའི་རྩིས་ཕུལ་ཏེ།",
    "སྔ་ཕྱིར་ལྷ་མོ་དང་རྔ་བ་ནས་འཚམས་ཞུས་པ་མང་ཤོས་དང་།",
    "ཤཱ་ས་ན་འབུམ་བཅས་སོང་ཞིང་།",
    "ཁ་སྐོང་ཚོགས་འཁོར་དང་བཅས་པ་ཁྱད་ཐོན་གནང་།",
    "དཔལ་ལོས་མ་དགོན་དུ་ཕྱག་སྐོར་ལ་འབད་དགོས་ཞེས་སྔར་དཔྱིད་དུས་སུ་གསུང་རྗེན་པ་གནང་བ་ལྟར་འདི་སྐབས་སྲས་མོ་སྦྲུམ་མར་ཡོད་པ་ལ་རྒྱལ་པོ་ནས་བུ་ཡིན་མིན་ཐག་གཅོད་དགོས་ཞེས་ཞུ་བ་ཚ་ནན་ཕུལ་བར་བུ་ཡིན་ཞེས་ཐོགས་མེད་བཀའ་སྩལ།",
    "ཟླ་ཟད་ཀྱི་མཇུག་བདུན་གཅིག་གི་རིང་ཡ་མ་རཱ་ཛཱའི་ལྗགས་བཟླས་དང་།",
    "སྐྱབས་འཕྲིན་གསོལ་གདབ་གང་གི་སྐབས་ཡིན་ཡང་།",
    "མི་མགོ་རྣམས་སུ་འགྲོ་ཕན་ཅུང་ཟད་རེ་བསྐྱངས་ཤིང་།",
