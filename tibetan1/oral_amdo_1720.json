    "སྐུ་དབོན་ཆེན་མོ་ནས་རྩད་གཅོད་བྱེད་ལུགས།",
    "སྐུ་དབོན་ཆེན་མོ་ནས་དབུས་སུ་འགྲོ་རྩིས་ཀྱི་གྲ་བསྒྲིགས་བྱེད་འདུན་ཡོད་ནའང་།",
    "ལྷོ་ཚ་ཁོ་ཚུན་ཆད་ནས་འོས་ཐོར་འགོད་འོས་གང་རྙེད་ཕྱོགས་གཅིག་ཏུ་བསྡོམས་པར་བདུན་ཅུ་ལྷག་པ་བྱུང་ཞིང་དེ་དག་གི་ནང་ཡང་སྤྲུལ་འཁྲུལ་མེད་ཡོད་མེད་ཀྱི་ཆེད་དམ་པ་སོ་སོར་ཞུ་བ་ནན་ཆེར་ཕུལ་བར།",
    "སྐྱབས་མགོན་རྡོ་རྗེ་འཆང་སྐུ་སྔ་ཕྱི་ལ་དད་གུས་རྩེ་གཅིག་པས་གསོལ་བ་བཏབ་པར་བྱིས་པ་རྣམས་ཀྱི་ནང་ནས་ཚ་ཁོའི་མྱི་རྩ་ཚང་གི་བྱིས་པ་ལ་ཤོ་མིག་བཅུ་གསུམ་བབས་ཞེས་དང་།",
    "ཚ་ཁོའི་མྱི་རྩ་ཚང་གི་བྱིས་པ་དེ་ཀར་རེ་བ་བྱས་ན་བཟང་སྙམ་པ་བྱིས་བློར་ངང་ངམ་ཤུགས་ཀྱིས་འབྱུང་།",
    "དེ་ལྟར་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་ཅིང་གཟིགས་པ་ཆེན་པོ་ནས།",
    "སྒྲིབ་བྲལ་ཡེ་ཤེས་ཀྱི་གཟིགས་པར་ཇི་ལྟར་མངའ་བ་ལྟར་བཀའ་ལུང་སེངྒེ་སྒྲ་དབྱངས་གསང་མཐོར་བསྒྲགས་ཏེ་ཡང་སྤྲུལ་འཁྲུལ་མེད་ཐག་བཅད་པ་དང་སྔར་དམ་པ་སོ་སོས་ཀྱང་ཐུགས་དཔྱད་ཆུ་ཐུབ་པ་མཛད་པ་ཇི་བཞིན་མཐུན་ཞིང་།",
    "ནོར་འཛིན་ཡངས་པའི་ཁྱོན་ལ་ལྟད་མོ་ལྟ།",
    "ཡོངས་འཛིན་མཆོག་ནས་འདི་ཞོ་ཕོང་དཔོན་རིའི་དགུ་རོང་མྱི་རྩ་ཚང་གི་ཡིན།",
    "ཟླ་རེའི་ཚེས་བརྒྱད་ལ་ཞལ་བཞི་བའི་དུས་གཏོར་ནར་མ་དང་།",
    "གསོལ་ཐབ་པ་གཅིག་མ་གཏོགས་ཕྱི་ནང་གི་འགྲུལ་བ་རྣམས་བཀག་ཅིང་།",
    "གཙང་སྤྲ་དང་བཞེས་བ་སོགས་ལ་དོ་དམ་གང་དྲག་བྱེད་རྒྱུ་སྐུ་དབོན་ཆེན་མོས་བཀོད་ཁྱབ་ཅི་ཕབ་ལྟར་མྱི་རྩ་ཚེ་ཐར་གྱིས་ཁུར་བླངས།",
    "དེ་འཕྲལ་མགོན་ཁང་དུ་མགོན་པོ་ཆེ་ཆུང་གི་ཞལ་མཇལ་དང་།",
    "ལར་སྣམ་བུ་འདོམ་རེ་ཙམ་རྙེད་པ་ལ་དཀའ་ཚེགས་མི་འདུག་ཀྱང་པཎ་ཞྭ་སེར་བོ་སྣེ་རིང་ཚད་ཀྱིས་ལམ་རིམ།",
    "ཞབས་པད་བརྟན་ཅིང་མཁས་པ་ཆེན་པོའི་རྒྱལ་ཐབས་བདག་གིར་བཞེས་པ་ཞིག་གནང་རྒྱུའི་ཞུ་འབུལ་ན་ཆེར་བགྱིས་པར།",
    "ཨ་མཆོག་སོགས་ཀྱི་མཁན་སློབ་སོ་སོ་དང་བཅས་སྐྱ་སེར་གྱི་ཁྲོམ་ཆེན་པོ་འཁྲུངས་གཞིས་སུ་གདན་འཛོམས་པ་ལ་མྱི་རྩ་ཚང་ནས་དཀར་དམར་གྱི་སྟོན་མོ་རྒྱས་པར་དྲངས།",
    "ཚོགས་པ་སུམ་སྟོང་ལྷག་པའི་དབུས་སུ་བག་ཚ་བ་སོགས་ཕྲ་མོ་ཙམ་ཡང་མེད་པར།",
    "གསུང་གི་ཕེབས་སྒོ།",
    "ཨ་ལ་ལ་བདག་ཅག་ནི་དམ་པའི་མགོན་དང་བཅས་སོ་ཞེས་ངོ་མཚར་བའི་དབྱངས་ཅིག་ཆར་སྒྲོག་པ་དང་ཆབས་གཅིག་ཚོགས་སྦིས་ཆེན་མོའི་དབུས་སུ་ཁྲི་ཆེན་བཀོད་པ་མཛེས་པར་བཤམས་པའི་སྟེང་དུ་བཞུགས་སུ་གསོལ།",
    "སྐབས་འདིར་བྱུང་བའི་གཟིགས་སྣང་སོགས་གསང་རྣམ་དུ་ཟུར་ཙམ་གསལ།",
    "དུས་གསུམ་རྒྱལ་བ་ཐམས་ཅད་ཀྱི་དམིགས་པ་མེད་པའི་ཐུགས་རྗེའི་རང་གཟུགས་དཀྱིལ་འཁོར་རྒྱ་མཚོའི་བྱེད་པོ་རྡོ་རྗེ་འཆང་འཇམ་དབྱངས་ཐུབ་བསྟན་རྒྱ་མཚོ་དཔལ་བཟང་པོ་ནས་བདེན་བརྗོད་གསུང་གི་གསང་བའི་བཀའ་ཆེད་དུ་སྩོལ་བར་མཛད་པ་ནི།",
    "བློ་བཟང་ཤེས་བྱ་ཐམས་ཅད་གཟིགས་པ་ཡེ་ཤེས་བླ་ན་མེད་པའི་གཏེར།",
    "རེ་འབྲས་བསམ་དོན་ལྷུན་གྲུབ་བདེན་པས་སྐྱོངས།",
    "ཇི་ལྟ་ཇི་སྙེད་ཤེས་བྱ་ཀུན་གཟིགས་པའི།",
    "རྒྱལ་བ་རྒྱ་མཚོའི་གསུང་གི་གསང་བ་མཆོག།",
    "ལྟ་སྒོམ་སྤྱོད་པ་གང་གི་ཆ་ལ་ཡང་།",
    "བདེན་ཚིག་མཐུན་འགྱུར་རོལ་མོ་འབུམ་དཀྲོལ་ཅིག།",
    "གང་གི་བྱིན་མཐུ་འོད་ཀྱི་ལྕགས་ཀྱུ་དང་།",
    "འཕྲིན་ལས་ལྷ་མོ་མར་གད་མདངས་ལྡན་པ།",
    "མཇུག་ཏུ་དགེ་ལྡན་བསྟན་འབར་མ་གསུངས་ཤིང་མེ་ཏོག་གི་ཆར་ཕྱོགས་སུ་འབེབས་པར་མཛོད།",
    "གདན་ས་ནས་བླ་བྲང་ཆེན་མོ་དང་ནང་ཁག་སོ་སོ་གྲྭ་ཚང་ཕན་ཚུན་བཅས་ནས་ལོ་གསར་ལེགས་འབུལ་དུ་ཆེད་མངགས་ཀྱི་མི་སྣ་སོས་སོས་ཧོར་ཟླ་གཉིས་པའི་ཚེས་ལ་དགྱེས་སྟོན་དྲངས།",
    "གསང་རྣམ་དུ་ཟུར་ཙམ་གསལ་བ་ལྟར་དག་པའི་སྣང་བ་ལ་འབྱམས་པ་སོགས་བདག་ཉིད་ཆེན་པོའི་མཛད་སྤྱོད་ངོ་མཚར་བ་དག་གིས་དུས་འདའ་བར་མཛད་དོ།",
    "བཟང་ངན་ལས་ཀྱིས་བདེ་སྡུག་རི་མོའི་འཛུམ།",
    "ཐུགས་བསྐྱེད་རྟེན་འབྱུང་ཚོགས་པ་མ་འགགས་པས།",
    "རྣམ་ལྔའི་གཟིགས་པ་མཆོག་གིས་ལེགས་དགོངས་ཏེ།",
    "དོ་ཤལ་རིང་བོས་ཁྱོད་ལ་དགེ་ལེགས་སྤེལ།",
    "ཁྱུ་མཆོག་བློར་ཡང་ངོ་མཚར་རི་མོ་བཀོད།",
    "རྗེ་ཉིད་གདན་སའི་ཡབ་རྗེ་གོང་མ་དག་གི་ཁྲི་ལ་མངལ་གསོལ་དགའ་སྟོན་དང་།",
    "སྐུ་དབོན་ཆེན་པོ་ནས་འཁྲུངས་གཞིས་སུ་བླུ་ཡོན་སྤྲོད་རྒྱུའི་འཕྲོས་མོལ་བཏང་བ་ལ།",
    "རང་རེ་དགོན་གྲོང་གི་བར་དེ་འདྲའི་འོས་འགབ་ག་ལ་ཡོད་ཅེས་སློག་པའི་འདུན་པ་དང་བསྟུན།",
    "ཕྱི་ཉིན་རྗེ་གོང་མ་རིམ་བྱོན་གྱིས་ཕྱག་མཚན་དུ་བཞེས་པའི་ཆེན་པོ་ལ་འོས་པའི་མཚན་རྟགས་རྣམས་ཀྱིས་མདུན་བདར་ཏེ་མཆོག་གི་སྦྲུལ་པའི་སྐུ་གཙང་བདེ་རྟག་བདག་དམ་པའི་ཕ་རོལ་ཏུ་སོན་ཞིང་།",
    "རྟག་བརྟན་ཞི་བ་གཡུང་དྲུང་གི་ཁྱད་པར་མངོན་དུ་མཛད་པ།",
    "དགོ་ཁོག་ཏུ་གདན་ས་ཆེན་པོའི་ཆིབས་བསུ་བ་རྣམས་དཀར་དམར་གྱི་སྟོན་མོ་རྒྱ་ཆེ་བས་ཚིམ་པར་བྱས།",
    "སྣ་ཚོགས་མཆོད་རྫས་ཐོགས་པའི་སེར་སྦྲེང་གིས།",
    "འདུ་ཁང་ཆེན་མོའི་ཡང་སྟེང་དུ་མཆོད་རོལ་གྱི་བཀོད་པ་ངོ་མཚར་བ་དང་བཅས་པའི་བསུ་བཀོད་ཕུན་སུམ་ཚོགས་པས་མདུན་བདར་ཏེ།",
    "སྐྱེ་བོ་སྟོང་ཕྲག་མང་བོའི་དབུས་སུ་བག་ཚ་བ་ལ་སོགས་པའི་རྣམ་པ་ཕྲ་མོ་ཙམ་ཡང་མི་མངའ་ཞིང་།",
    "ཁྱོད་ཞལ་མཐོང་བའི་མོད་ལ་མི་བསྲུན་ཡིད།",
    "ཞེས་གསུངས་པ་དང་ཕྱོགས་མཐུན་པར་མཆོག་གི་སྤྲུལ་པའི་ཟློས་གར་ཁྲིར་ཕེབས་པ་ལ་སྤྲོ་བས་རྒྱུད་གང་བ་ཉེ་བར་མཚོན་པའི་ཕྱིར།",
    "གཞུང་གིས་གསོལ་སྟོན་གྱ་ནོམ་པ་དྲངས་ཤིང་།",
    "ཚོགས་པ་རྒྱ་མཚོ་ལྟ་བུའི་དབུས་སུ་གསུང་གི་གདངས་མཐོ་ཞིང་རྗོད་པ་ཡོངས་སུ་དག་པས་ལྗགས་བསྔོ་མཛད།",
    "དེ་དག་གི་སྐབས་སུ་དད་འདུས་ཀྱི་སྐྱེ་བོ་མཐའ་ཡས་པས་རྗེ་འདིའི་ཞལ་གྱི་དཀྱིལ་འཁོར་ལ་ངོམས་པ་མེད་པར་ལྟ་བ་དང་།",
    "གསུང་གི་བདུད་རྩི་ལ་ལོངས་སྤྱོད་པ་བྱུང་བས་དགའ་དད་སྨྲ་མི་ཤེས་པ་དག་གིས་རྒྱུད་ཡོངས་སུ་གཏམས་པར་གྱུར་ཏེ་ཨེ་མ་བདག་ཅག་གི་རྙེད་པ་འདི་ནི་ཕུན་སུམ་ཚོགས་པའོ་སྙམ་དུ་སེམས་པར་གྱུར་ཅིང་ཚོགས་པ་ཡོངས་ནས་དགེ་ལྡན་བསྟན་འབར་མ་གསུངས་ཏེ་མེ་ཏོག་གི་ཆར་ཕབ་བོ།",
    "སླར་ཡང་ཚོམས་ཆེན་དུ་ཞབས་སོར་བཀོད་དེ་ཁྲི་སྟོན་ལེགས་འབུལ་རིམ་པར་བསྟར་བ་ལས།",
    "མཛོད་དགེཨ་མཆོག་སྟོད་སྨད།",
    "ལྷ་མོའི་ཉིན་གྱི་གྲྭ་ཚང་ལ་ཡང་ཁྲི་སྟོན་གྱི་མང་ཇ་ཉིན་འཁྱོངས་ཞུས།",
    "གྲོ་ཞུན་ཟླ་བའི་ཡར་ངོང་སྐུ་དབོན་ཆེན་མོ་ནས།",
    "ཞི་དྲག་གི་ཐབས་ལ་མཁས་པ།",
    "སྐུ་དབོན་ཆེ་ཆུང་གིས་གཙོས་ནང་པའི་ལས་ཚན་རྣམས་དང་།",
    "སྲོག་གི་ཕྱིར་ཡང་མི་གཏང་ངོ།",
    "རབ་བྱུང་བཅུ་དྲུག་པའི་ཐོག་མ་མེ་ཡོས་སྤྱི་ལོ་༡༩༢༧གནམ་ལོ་གསར་ཚེས་ཀྱི་དགྱེས་སྟོན་དང་ལྷ་མོའི་ཚེས་གཏོར་ཕུལ་ཞིང་།",
    "སྐུ་བཅར་རི་ཁྲོད་པས་དགོངས་པ་ཞུས་པར་ཁོང་གིས་གཞོན་ནུ་ནས་སྐུ་རྫི་བྱས་པས་ཐུགས་འདྲིས་ཧ་ཅང་ཆེ་བས་ཞབས་པད་དུ་གནས་པ་ཐམས་ཅད་ཀྱིས་འབྲལ་མི་ཕོད་པའི་སེམས་འཚེར་ཆེ་ཞིང་།",
    "ཕྱི་ཉིན་ཁྲི་ཆེན་རྡོ་རྗེ་འཆང་ཆེན་པོ་སླར་ཆིབས་བསྐྱོད་མཛད་པར་རྗེ་འདིས་སྐྱེལ་ཐུང་མཛད་དེ་སྐུ་དབོན་ཆེན་མོ་སོགས་ཆིབས་སྐྱེལ་དུ་མངགས།",
    "བཅུ་བདུན་ལ་མ་དགོན་དང་རོང་འབྲོག་གི་བསུ་བཀོད་རྒྱས་པ་དང་བཅས་འཁྲུངས་གཞིས་བརྒྱུད།",
    "ཞབས་ཕྱི་མང་མ་ཕྱིར་མངགས་ཏེ་སྐུ་འཁོར་ཉུང་བསྡུས་བཅས་འཁྲུངས་གཞིས་སུ་ཟླ་གཅིག་ཙམ་བཞུགས་ནས་དབྱུག་པ་ཟླ་བའི་རྒྱལ་བ་གསུམ་པར་རི་ཁྲོད་བདེ་ཆེན་དགའ་ཚལ་དུ་ཡུན་བཞུགས་ཀྱི་སྒོ་བཏོད་དེ་བཅོ་ལྔ་ནས་ཡོངས་འཛིན་ཚང་གིས་གཞི་བསྙེན་ཆེན་མོར་མཛད་པའི་ཐུན་མཚམས་རྣམས་སུ་ཐུགས་འཛིན་གྱི་ཞབས་ཕྱི་ཞུས།",
    "སྐྱོན་མེད་ང་འགྲོ་རྒྱུར་མ་སོང་བའི་སྟབས་རེད་ཅེས་གསུངས།",
    "འའདི་ལས་བརྩམས་པའི་ཐུན་མོང་མིན་པའི་རྣམ་པར་ཐར་བའང་ཅི་རིགས་ཤིག་ཡོད་པར་སྣང་།",
    "ས་གའི་ཉར་ཡོངས་འཛིན་མཆོག་ནས་ཀྱང་གཞི་བསྙེན་ཆེན་མོ་ལེགས་པར་གྲུབ་ཅིང་།",
    "ལབ་ཙེ་བསྟོད་པ་དང་བསངས་དཀར་གཏོར་རྒྱས་པར་གནང་ནས་སྒྲ་དང་བཅས་མཚོ་སྔར་ལས་ཆེར་སོང་བས་ཐམས་ཅད་ངོ་མཚར་ཞིང་དགའ་སྤྲོ་བརྟས།",
    "བཅུ་གཅིག་ལ་གདན་ས་ཆེན་མོ་དང་རྐ་ཆུ་ཁ་བའི་ཆིབས་བསུ་དང་བཅས།",
    "ཡོངས་འཛིན་ཚང་ནས་གཞི་བསྙེན་ཆེན་མོའི་ཡན་ལག་རྣམས་ཕྱག་ཏུ་བསྟར་བཞིན་ཐུན་མཚམས་སུ་མངོན་རྟོགས་རྒྱན་ཐུགས་འཛིན་གྱི་ཞབས་ཕྱི་ཞུ་ངོས་ཡབ་སྲས་ལྷན་བཞུགས་མཛད།",
    "རིགས་བརྒྱའི་ཁྱབ་བདག་རྡོ་རྗེ་འཆང་ཆེན་པོ་མཉྫུའི་ཞབས་དགོངས་པ་ཞི་དབྱིངས་སུ་གཟིགས་པའི་གཏམ་གསན་འཕྲལ་ཐུགས་ངལ་དཔེ་མེད་མཛད་ཅིང་།",
    "ཁོང་བ་ཕེབས་ནས་བཀྲ་ཤིས་གསོ་སྦྱོང་ཆར་འབེབས་སོགས་མཛད་པར་ལོ་ཏོག་ལ་ཕན་པའི་ཆར་མོད་ཆེ་བ་བབས་པས་དེ་ཕྱོགས་ཀྱི་འགྲོ་བ་རྣམས་དད་པའི་ས་ལ་བཀོད།",
    "ཧོར་ཚང་ནས་ཀྱང་དེ་བཞིན་ཞུ་བ་འབུལ་མི་བྱུང་བར་དམ་བསྒྲགས་སྩལ་ཏེ་གསོ་སྦྱོང་སོགས་བྱེད་དབོན་འདི་ཉིད་བླ་བྲང་ཆེན་མོ་དང་གདན་སར་ལུགས་གཉིས་ཀྱི་ཕྱག་རྗེས་དང་བཀའ་དྲིན་ཆེ་ཞིང་།",
    "ཚེས་གསུམ་ཉིན་ལྗགས་བསྙེན་ཁ་སྐོང་གི་མེའི་མཆོད་སྦྱིན་གནང་།",
    "སྐུ་དབོན་ཆེན་མོ་གཤེགས་པའི་དགོངས་རྫོགས་སུ་སྐུ་དབོན་གཤེགས་པ་རང་གི་ཞལ་ཆེམས་ལྟར་གྱོན་པ་དང་ཡོ་བྱད་རྣམས་བཙོངས་ཏེ་བཅོ་ལྔའི་ཉིན་མང་ཇ་ཉིན་འཁྱོངས་དང་།",
    "དབྱར་གདན་ས་ཆེན་མོའི་གྲྭ་ཚང་སོ་སོས་རྒྱུགས་ཀྱི་རིམ་པ་རྣམས་ཕུལ་བར་གཟིགས་རྟོག་དཀྱུས་བཞིན་མཛད་དེ་ཚར་གཅོད་རྗེས་འཛིན་དུས་ལས་མ་ཡོལ་བར་ཕྱག་ཏུ་བཞེས།",
    "ཟླ་ནང་རེབ་གོང་མར་ནང་དུ་འཇིགས་མེད་རྡོ་རྗེ་འཆང་ཆེན་པོར་གདན་འདྲེན་པ་བསྐྱར་མ་མངགས་ཤིང་།",
    "འཁྲུངས་གཞིས་སུ་ཕེབས་ཏེ་ལྗགས་བསྙེན་ཁ་སྐོང་གི་སྦྱིན་སྲེག་མཛད།",
    "གྲོང་སོགས་སུ་དེའི་ཉོན་མོངས་རྣམས།",
    "རྒྱུན་གཙང་རྒྱལ་བའི་ཉོན་མོངས་མེད།",
    "ཅེས་གསུངས་པ་ལྟར་གྱི་ཉོན་མོངས་མེད་པའི་ཏིང་ངེ་འཛིན་མངོན་དུ་མཛད་པའི་མཐུས།",
    "བླ་བྲང་ཆེན་མོར་ཕྱགས་ཕེབས།",
    "དེ་ཉིན་དུས་འཁོར་གྲྭ་ཚང་གསར་འཛུགས་ཀྱི་འདུ་ཁང་བཞེངས་སའི་གཞི་གཟིགས་རྟོག་དང་བཀྲ་ཤིས་ཀྱི་ཚིག་དང་བཅས་མེ་ཏོག་འཐོར་བར་མཛད་ཚེ།",
    "ཚེས་དྲུག་ལ་གཡང་འབོད་དང་ཤིས་བརྗོད་གསུང་བཞིན་རྒྱལ་ཁང་ཆེན་མོའི་ཕྱི་ནང་དུ་ཕྱག་དངོས་ནས་མེ་ཏོག་གཏོར་བཞིན་ཕེབས་བྱམས་སུ་ཕེབས་ཏེ།",
    "བཅུ་གཉིས་ལ་རྒྱལ་སྲས་མཆོག་གིས་གཙོས་འབྲོག་རུའི་དམག་དང་བཅས་བྲག་དཀར་ལ་བཙས་དཔངས་བསྟོད་ཕྱག་ནས་འཐོར་བ་སྔར་བཞིན་གནང་ཞིང་།",
    "དེ་ནས་གདན་ས་ལྷ་འབངས་དང་བཅས་པའི་ཆིབས་བསུ་རིང་ཐུང་དང་སེར་སྦྲེང་གིས་བསུས་ཏེ།",
    "ཉེར་བདུན་ལ་གདན་ས་ཆེན་པོར་འབྱོར་གདོང་འདུ་ཁང་དུ་ཚོགས་པ་ཡོངས་ལ་ཕྱག་བྱིན་སྩལ་འཕྲལ་བླ་བྲང་ཆེན་མོར་གཞི་ཕབ་སྟེ།",
    "གཡས་སུ་འཁྱིལ་བ་ཁྱོད་ཀྱི་འཕྲིན་ལས་ཞིང་།",
    "འགྱུར་མེད་གསུང་གི་གསང་བས་རྗེས་བསྔགས་པ།",
    "རེ་བའི་མིག་འབྲས་གཏོང་བའི་ཚོགས།",
    "ཕྱི་མོ་ཀློག་ལ་བརྩོན་པའི་གོ།",
    "ལྟད་མོ་ངོ་མཚར་ལ་འགོད་དུས་སྟོན་ཡོ་ལང་རྒྱས།",
    "ཤེས་རབ་ཀྱིས་ཚིག་དང་དོན་ཟབ་མོ་རྟོགས་པར་འགྱུར་བའོ།",
    "སྐུ་ཡོན་གསན་སྦྱོང་གི་གཞི་འདིངས་བ་ཟུང་འབྲེལ་དུ་མཛད་ནས།",
    "བསྟེན་བྱར་འོས་པ་སའི་སྟེང་ན་བསྟན་པའི་ཁུར་བཞེས་པ་ཡང་མང་དུ་བཞུགས་མོད་ཀྱི།",
    "ཕྲུག་སོགས་རྟེན་འབྱུང་གི་བདོག་པ་བསྟར།",
    "སྤྱན་རས་གཟིགས་བཅུ་གཅིག་ཞལ།",
    "བདེ་གསང་གི་སྔགས་བཏུ།",
    "དེ་ཡང་རྗེ་བཙུན་དམ་པ་འདི་གནས་ཚོད་ལ་འཕགས་པ་སྤྱན་རས་གཟིགས་དངོས་ཡིན་པར་མ་ཟད།",
    "ཅེས་གང་ལ་ཐོས་བསམ་བྱ་བའི་གཞུང་གི་མིང་ངེས་པར་བྱས་ཏེ་ཚིག་ཁོང་དུ་ཆུད་པར་བྱས་ནས་དོན་ལ་དཔྱོད་པར་གསུངས་པ་ལྟར་གཞུང་ལུགས་རབ་འབྱམས་ལ་གསན་བསམ་མཐའ་ཆོད་པ་མཛད་བཞེད་སྔར་ནས་ཡོད་པ་དོན་ཐོག་ཏུ་བསྐྱལ་ཏེ།",
    "ཚེས་དགུའི་ཕྱི་དྲོ་རྡོ་རྗེ་འཆང་ཆེན་པོ་ནས་རྗེ་འདིའི་ཞབས་བརྟན་དུ་མགོན་ཁང་རང་ནས་ཐུན་མོང་མིན་པའི་དྲུག་ཅུ་བའི་གཏོར་བསྔོས་མཛད་ཅིང་།",
    "རྔ་བའི་གདན་ས་ཆེན་མོའི་མཁན་སློབ་དང་རྒྱལ་པོ་ཡབ་སྲས་སོགས་སེར་སྐྱའི་ཆིབས་བསུ་རྒྱས་པས་བསུས་ཏེ།",
    "མོས་པ་ལྟར་ཡབ་སྲས་བཀའ་བགྲོས་ཀྱིས།",
    "དཔོན་ཚང་གི་ཕྱི་ནང་དུ་ཤིས་བརྗོད་དང་བཅས་སྒར་བཏེག་སྟེ།",
    "ཞི་ཁྲོ་སྦྲགས་སྒྲུབ་ཐུན་མོང་བ།",
    "འཇམ་དཔལ་ཞི་དྲག་གི་སྲུང་བ།",
    "དབྱུག་ཟླའི་ཚེས་བཞི་ལ་ཆིབས་བསུ་དང་བཅས་ཡབ་སྲས་གདན་ས་ཆེན་མོར་ཕེབས།",
    "ཁྱོད་ཉིད་ལུང་དང་རྟོགས་པའི་རྒྱལ་སྲིད་ལ།",
    "མཛོ་མོ་གཉིས།"
  ]
}