    "དེ་ཕྱིན་ཆད་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལས་འདི་ལ་ཕྱི་བཤོལ་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བྱ་བ་ནི་རོད་རྗེ་གར་བྱས་ནས།",
    "བདུག་པ་ལ་སོགས་པའི་ཕྱག་རྒྱ་ནི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་དུ་གསུངས་པ་དང་།",
    "དམ་ཚིག་མཆོག་ནི་གཉིས་བྱས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་འཇིག་རྟེན་གསུམ་གྱི་འཁོར་ལོ་རྩ་བའི་དཀྱིལ་འཁོར་ལས་རྡོ་རྗེ་བཅིང་བ་དམ་བྱས་ཏེ།",
    "རྡོ་རྗེ་དེ་ནི་གཉིས་བྱས་ཏེ།",
    "ཇི་ལྟར་བཅིང་ཞ་ན་གཉིས་བྱས་ཏེ་ཞེས་བྱ་བ་སྟེ་རྡོར་ཇེ་བཅིང་བ་གཉིས་སུ་བྱའོ།",
    "རྡོ་རྗེ་གར་བྱས་ནས་རྡོ་རྗེ་བཅིང་བས་བཅིངས་ལ་རྡོ་རྗེ་གཡོན་པ་དེ་བཙིར་བར་བྱའོ།",
    "རྡོ་རྗེ་གར་བྱས་ནས་རྡོ་རྗེ་བཅིང་བ་བཅིངས་ཏེ།",
    "དེ་ལྟར་བྱས་པས་ཅིར་འགྱུར་ཞེ་ན།",
    "ལས་གྲུབ་པར་ཡང་ངེས་པར་འགྱུར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ཐམས་ཅད་འགྲུབ་པར་འགྱུར་བའོ།",
    "གསང་བའི་དོན་རྣམས་པར་སྤྱད་པའི་ཕྱིར་དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མཁྱེན་བཞིན་དུ་ཞེས་བྱ་བ་ལ་ཅི་ཞིག་མཁྱེན་ཅེ་ན།",
    "དེ་གང་ལགས་བཀའ་སྩོལ་ཅིག་ཅེས་བྱ་བ་ནི་དེ་བཀའ་སྩོལ་ཞིང་གསུངས་ཤིག་ཅེས་པའོ།",
    "ཐམས་ཅད་དུ་བསྟན་པར་མི་བྱ་བའོ།",
    "ཏིང་ངེ་འཛིན་གང་དོན་དང་མཐུན་པའི་མིང་འདི་ཉིད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་དེ་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "ཅི་ཞིག་མཛད་ཅེ་ན་གསུངས་སོ་ཞེས་བྱ་བ་སྟེ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ལ་སྤྱོད་པར་བསྟན་པ་སོ།",
    "མ་ཡིན་ཏེ་གཙང་བས་བྱ་ཞེས་བྱ་བའོ།",
    "ཇི་ལྟར་བཅོམ་ལྡན་འདས་ཀུན་དུ་བཟང་པོ་འདོད་ཆགས་ལ་། སོགས་པའི་སྤྱོད་པ་རྣམས་ལ་འདོད་ཆགས་སྤྱོད་པར་སྟོན་ཀྱང་ཆགས་པར་མི་མཛད་པ་དང་།",
    "ཞེས་དང་ལ་སྤྱོད་པ་རྣམས་ལ་ཞེས་དང་སྤྱད་པར་སྟོན་ཀྱང་ཞེས་ལྡང་མི་མངའ་བ་དང་།",
    "ང་རྒྱལ་ཅན་ཚར་གཅད་པར་བྱ་བའི་ཕྱིར།",
    "བསྟན་པ་རྣམ་པར་འཇིག་པར་བྱེད་པ་ན་དེ་གདུལ་བར་བྱ་བའི་ཕྱིར་བརྒྱ་བྱིན་གྱིས་ཚོང་དཔོན་གྱི་ནོར་སྤས་པ་བཞིན་དུ།",
    "བསྟེན་པས་བསོད་རྣམས་ཐོབ་པར་འགྱུར།",
    "ཞེས་བྱ་བ་སྟེ་གཞན་པར་ཏེ་མཆོག་གོ།",
    "ཕྱིར་ཞེས་པ་ནི་ཚེ་འདིའི་དོན་རྫོགས་པར་བྱ་བ་སྟེ།",
    "ལས་རྣམས་ཐམས་ཅད་བྱས་པ་ཡིས།",
    "དེ་ནས་ཞེས་བྱ་བ་ལ་སོགས་པའི་གཞུང་གཞན་གསུངས་པ་ཡིན་ཏེ།",
    "ཕྱག་ན་རྡོར་ཇེ་དེ་ཉིད་ཅེས་བྱ་བ་ནི་སྔར་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་གཟུགས་ཀྱིས་བཞུགས་པ་གང་ཡིན་པ་དེ་ཉིད་དོ།",
    "པདྨོའི་སེམས་དཔའ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་སེམས་དཔའི་དེ་ཉིད་པདྨའི་རིགས་ཀྱི་སྒོ་ནས་པདྨོའི་སེམས་དཔའ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཚིགས་སུ་བཅད་པ་འདིས་ནི་མཚན་བདུན་ཡང་དག་པར་བསྡུས་པ་ཡིན་ནོ།",
    "ཡང་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་ཐུགས་སུ་ཆུད་པས་ན་བློ་གྲོས་ཆེན་པོའི།",
    "ཁམས་གསུམ་མ་ལུས་པར་ཁྱབ་པར་མཛད་པས་ན་པདྨ་ཆེའོ།",
    "པདྨའི་མགོན་ཞེས་བྱ་བ་ནི་པདྨའི་རིགས་ཀྱི་མགོན་པར་གྱུར་པའི་ཕྱིར་ཏེ།",
    "བསྒོམས་པའི་སྟོབས་ཀྱིས་པདྨོའི་ཕྱག་རྒྱ་ལས་ཡང་དག་པར་བྱུང་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དཔེར་ན་པདྨ་ནི་བཀྲ་ཤིས་པའི་གནས་སུ་གྱུར་པས་ཕྱོགས་གོང་དུ་སྐྱེ་བའི་ས་ཕྱོགས་དེ་གཙང་མར་འགྱུར་རོ།",
    "གང་དང་དུ་གང་དུ་གནས་པར་གྱུར་པ་དག།",
    "ཡང་ན་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་སེམས་དཔའི་ཉིད་པདྨའི་གཟུགས་སུ་བཞུགས་པས་ན་རྡོ་རྗེ་པདྨའོ།",
    "ཁྱད་པར་ནི་དེ་ཡིན་ནོ།",
    "དེ་ནི་ལས་ཀྱི་རིགས་ཀྱི་སྒོ་ནས་བསྟོད་པར་བྱ་བའི་ཕྱིར།",
    "སྣ་ཚོགས་ཞེས་བྱ་བ་ལ་སོགས་བ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པ་ཤཱཀྱ་ཐུབ་པ་ཡང་དེ་དང་མཚུངས་པར་གྱུར་པ་ན་ཆེ་དང་མཚུངས་སོ།",
    "གདུག་ཅིང་གཏུམ་པ་རྣམས་ཀུན་དུ་སྐྲག་པར་མཛད་པས་ན་དཔའ་བ་ཆེན་པོ་སྟེ།",
    "འདི་ཡང་མཚན་བདུན་གྱིས་བསྟོད་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "མྱ་ངན་ལས་འདས་པའི་བདེ་བ་ཐོབ་པར་མཛད་པའི་ཕྱིར་རོ།",
    "འདི་ཡང་མཚན་བདུན་གྱིས་བསྟོད་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ཤིན་ཏུ་ཡང་ཅན་རྣམས་མཁྱེན་པས་ན་སེམས་མཆོག་ཤེས་སོ།",
    "ཡང་ན་སེམས་དཔའ་མཆོག་རྣམས་མཁྱེན་པས་ན་སེམས་པའི་མཆོག་ཤེས་སོ།",
    "དེ་རྣམས་ལ་རྗེ་སུ་ཐུགས་བརྩེ་བས་འཇིགས་པ་ཆེན་པོ་བརྒྱད་ལས་བསྐྱབ་པར་བྱ་བའི་ཕྱིར་ཆགས་པར་མཛད་པ་སྟེ།",
    "ཡང་ན་མགོན་པོ་ནི་ཕོངས་པ་རྣམས་ལས་སྐྱོབ་པར་བྱེད་པ་སྟེ།",
    "འཇིགས་པ་ཆེན་པོ་བརྒྱད་ཀྱི་ཟིན་པ་རྣམས་ལས་ཡོངས་སུ་སྐྱོབ་པར་མཛད་པས་ན་མགོན་པོ་རྣམས་ཀྱི་མཆོག་ཏུ་གྱུར་པས་ན་མགོན་པོའི་མཆོག་གོ།",
    "གདུལ་བྱའི་དོན་གྱི་བྱ་བ་ཆེན་པོ་ལ་བརྩོན་པར་མཛད་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་མཚན་དེས་མཚོན་པར་བྱས་ཏེ་བསྟོད་པ་ཡིན་ནོ།",
    "འཇིག་རྟེན་ན་ཡི་གེ་སྟེ་མི་འགྱུར་བར་འདོད་པ་གང་ཅི་ཡང་རུང་བ་རྟག་པར་འདོད་པ་དེ་རྣམས་ཀྱི་མཆོག་སྟེ་དམ་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱག་ན་མཚན་པར་གྱུར་པའི་པདྨ་མངའ་བས་ན་ཕྱག་ན་པདྨོའོ།",
    "ཕྱག་ཆེན་པོ་མངའ་བས་ན་ཕྱག་ཆེན་པོ་སྟེ་གདུལ་བྱ་རྣམས་ཀྱི་དགོས་པ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་ཁྱབ་བདག་ཉིད་དུ་གྱུར་པར་སྟོན་པའི་ཚེ།",
    "དེ་ཉིད་ཀྱིས་ཁམས་ཐམས་ཅད་དུ་ཁྱབ་པར་ཕྱིར་ན་གཟུགས་ཆེན་པོའོ།",
    "ཕྱག་ན་རྡོ་རྗེའི་གཟུགས་ཀྱིས་བཞུགས་པས་ནས་རྡོ་རྗེའི་གཟུགས་སོ།",
    "གཟུགས་བཟང་པོ་འཛིན་པར་མཛད་པས་ན་གཟུགས་བཟང་འཆང་ངོ།",
    "ཏིང་ངེ་འཛིན་གྱིས་བཞུགས་པའི་ཕྱིར་རོ།",
    "ད་ནི་རིགས་ཀྱི་སྒོ་ནས་བསྟོད་པའི་ཕྱིར་པདྨོའི་དཔལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ད་ནི་ཡེ་ཤེས་ཀྱི་སྒོ་ནས་བསྟོད་པའི་ཕྱིར་སྣང་བའི་སྣང་མཆོག་ངེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འཇིག་རྟེན་ན་ནོར་བུ་ལ་སོགས་པ་སྣང་བ་གང་ཡིན་པ་དེ་རྣམས་ནི་ཕྱི་རོལ་གྱི་མུན་པ་སེལ་བར་བྱེད་པ་ཡིན་པར་གྲགས་པ་ཙམ་དུ་ཟད་ཀྱི།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྲས་ཀྱི་ཐུ་བོའོ་ཞེས་ཇི་སྐད་གསུངས་པ་ལྟ་བུའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སོ།",
    "བར་དང་ཐ་མའི་རྣམ་པར་དག་པ་ཐུགས་སུ་ཆུད་པའི་ཕྱིར་རོ།",
    "བསྟོད་དམ་ཞེས་བྱ་བ་ནི་བསྟོད་པའི་བསམ་པས་སྟོད་པར་བྱེད་ཅིང་རྗོད་པར་བྱེད་པའོ།",
    "དེ་ལྟར་མཚན་བརྒྱ་རྩ་བརྒྱད་ཀྱིས་བསྟོད་པའི་གསོལ་བ་བྱས་ནས།",
    "འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བས་ན་དཔའ་བོའོ།",
    "ཆེད་དུ་བརྗོད་པ་ནི་མ་དྲིས་པར་ལུང་སྟོན་པའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ།",
    "དེ་བསམ་པའི་ཁྱད་པར་གང་ལས་བྱུང་བ་དེ་བྱིན་གྱིས་བརླབ་པར་བྱ་བའི་ཕྱིར།",
    "པདྨ་ལྟར་གོས་པ་མེད་པའི་ཏིང་ངེ་འཛིན་དེ་ལ་དོན་དང་མཐུན་པའི་མིང་འདི་སྐད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གང་ཡིན་པ་དེ་ལ་སྙོམས་པར་ཞུགས་པའོ།",
    "དེ་ལྟ་བུའོ་འོད་ཟེར་རྣམས་བྱུང་ནས་འདོད་ཆགས་ལ་སོགས་པ་རྣམ་པར་དག་པ་དང་།",
    "སོགས་པ་སྨོས་པ་ནི་ཞེ་སྣང་དང་གཏི་མུག་ལ་སོགས་པ་ཡང་རྣམ་པར་རྟོག་པས་ཀུན་ནས་བསླང་ཞིང་ཡང་དག་པ་མ་ཡིན་པའི་ཀུན་དུ་རྟོག་པ་ལས་བྱུང་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་ནི་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་ཡིན་ནོ།"
  ]
}