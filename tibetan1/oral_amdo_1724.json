    "མེ་རྡོ་གཡག་རོ་ཙམ་ཞིག་གི་ཁར།",
    "ལན་གསུམ་བརྡབས་དུས་རྩ་ཕུང་མེ་ལ་བསྲེག་འདྲའི་དུ་བ་སྔོ་ཕྱུར་རེ་བ་དེ།",
    "ཚད་ཐལ་ར་རོ་ཙམ་ཞིག་མདུན་དུ་སྤུངས།",
    "སྒ་སེང་ལྕམ་འབྲུག་མོ།",
    "རབ་ཡངས་བྲང་གི་ངོས་ན།",
    "ཞེས་པ་ལྟ་བུ་འདིས་བརྗོད་བྱའི་དོན་སེང་ལྕམ་འབྲུག་མོའི་མཛེས་སྐུ་དེ་འཇིག་རྟེན་ལ་གྲགས་པའི་མཚམས་ལས་མ་འདས་པར་འོས་ཤིང་འཚམས་པར་བརྗོད་པས་འུད་ཆེ་བས་ཡིད་ལ་ཤོང་དཀའ་བ་ལྟ་བུ་མིན་པར་འུད་དང་འདྲེས་ཀྱང་མཛེས་པར་གྱུར་པ་ལྟ་བུའོ།",
    "ནོར་གཡུ་བྱུར་བཏགས་པ་བུ་མོས་རྨིས།",
    "གཡས་གསེར་ཏེམ་ནང་གི་ཇ་འདྲེན་འདི།",
    "ཇ་ཤིང་དཀར་ལོ་མའི་རྩེ་མོ་དང་།",
    "ཁ་ཊཾ་རྩེ་གསུམ་གྲུ་མོར་བརྟེན།",
    "སྦྲང་ནག་སྲོག་དམར་སྐྱེལ་འདོད་རེད།",
    "སུམ་དམག་མདའ་འབེན་བྱེད་འདོད་རེད།",
    "དཔེ་ཅན་སུམ་པའི་དམག་དཔུང་རྗེས་སུ་འོང་བ་དེ་ཡང་སྲོག་དམར་མདའ་དབེན་བྱེད་འདོད་པ་ལྟ་བུ་རེད་ཅེས་དཔེ་སྦྲང་ནག་དེ་དཔེ་ཅན་སུམ་པའི་དམག་གི་ཟླ་བོ་དང་མཚུངས་པར་བཀོད་པ་ལྟ་བུའོ།",
    "བློ་འཁྱོགས་བྲག་གི་ཤིང་རུལ་ལ།",
    "བློ་འཁྱོགས་ནི་བྲག་གི་ཤིང་རུལ་ཞེས་པ་ལྟ་བུར།",
    "དཔེ་ཅན་བློ་འཁྱོགས་དང་བྲག་གི་ཤིང་རུལ་བཅས་དཔེ་དང་དཔེ་ཅན་གཉིས་བར་གྱི་མཚམས་སྦྱོར་གྱི་འབྲེལ་སྒྲ་བསྡུས་ནས་དཔེ་ཅན་དཔེའི་གཟུགས་སུ་བཀོད་པ་ལྟ་བུའོ།",
    "ཁྱོད་ལ་འབུལ་ལོ་སེང་ཆེན་རྗེ།",
    "བདུད་འདུལ་ལས་ཆུང་མ་འབྲུག་མོས་རྩིས་ལེན་མཛོད།",
    "འགོག་པའི་རྒྱན་གྱི་ནང་གསེས་རྩུབ་མོས་འགོག་པ་ནི།",
    "ང་འབྲུག་མོ་ལམ་ཁའི་རྡོ་བཞིན་བསྒྱུར།",
    "ངས་བརྒྱ་བརྒྱའི་ཁྲོད་ནས་ཁྱོད་རང་འདེམས།",
    "ང་འབྲུག་མོ་མིན་པ་སུ་ཞིག་ཡོད།",
    "ང་འབྲུག་མོ་མིན་པ་སུ་ཞིག་ཡོད།",
    "ང་འབྲུག་མོ་མིན་པ་སུ་ཞིག་ཡོད།",
    "གྲོགས་རྒྱལ་པོ་མི་ངན་ཐ་ཆད་ཁྱོད།",
    "དུས་ད་རེབ་ཉོན་ལ་བཞུགས་རོགས་མཛོད།",
    "དགག་བྱ་གླིང་རྗེ་གེ་སར་ཉིད་བྱུང་ལ་བདུད་འདུལ་དུ་ཕེབས་པའི་དགོངས་པ་འགྲུབ་ཏུ་མི་སྟེར་བའི་འགོག་བྱེད་ཀྱི་ཚིག་ཤིན་ཏུ་རྩུབ་མོ་ཕོ་ངན་དང་རྒྱལ་པོ་མི་ངན་ཐ་ཆད་སོགས་བརྗོད་པའི་སྒོ་ནས་འགོག་པར་བྱེད་པ་ལྟ་བུའོ།",
    "ང་འབྲུག་མོ་ཅིས་ཀྱང་མི་འཁྲིད་ན།",
    "འགོག་བྱེད་འགྲུབ་པར་དཀའ་བའི་བྱ་ཐབས་འབྲུག་མོས་།",
    "སྲིད་པ་ཅན་གྱི་རྒྱན་གྱི་ནང་གསེས་འབྲས་བུ་རང་གི་ངོ་བོ་ཙམ་སྟོན་པའི་སྲིད་པ་ཅན་ནི།",
    "དམར་ཡག་སྟག་གི་འཛུམ་དྲུག་བརྣོགས།",
    "སེང་གེ་དཀར་མོའི་གཡུ་རལ་བྲེག།",
    "བྲེ་སེར་འབྲོང་གི་རུ་ཐུར་བཀོགས།",
    "དེ་མཚོན་པར་བྱེད་པའི་དཔེ་སེང་གེའི་གཡུ་རལ་བྲེག་པ་དང་དོམ་ནག་གི་མཆེ་བ་ཕུད་པ་སོགས་དངོས་སུ་བརྗོད་དེ་དཔེ་ཅན་ཤུགས་བསྟན་གྱི་ཚུལ་དུ་བསྡུས་ནས་སྟོན་པར་བྱེད་པ་ལྟ་བུའོ།",
    "མངར་དགུ་ཞིམ་བཅུ་སྐྱུག་རེ་བྲོ།",
    "ཁ་སྐྱ་ལོའི་བུ་མོ་སེང་ལྕམ་ང་།",
    "གླིང་མཐོང་བ་ཀུན་སྨོན་དཔོན་མོར་བབ།",
    "སྤྱན་མིག་ཐོ་རེངས་སྐར་ཆེན་འདྲ།",
    "གསུང་སྙན་མོ་པི་ཝང་གླིང་བུ་འདྲ།",
    "སྐྱ་ལོ་སེང་ལྕམ་འབྲུག་མོར་གླིང་མཐོང་བ་ཀུན་སྨོན་གྱི་དཔོན་མོ་དང་།",
    "ཝ་མོས་བརྒྱལ་ཟུག་བྱེད་པ་དང་།",
    "འདི་ལ་འཇིགས་རུང་གི་ཉམས་ཀྱང་འདྲེས་སོ།",
    "ཉམས་ལྡན་གྱི་རྒྱན་གྱི་ནང་གསེས་རྨད་བྱུང་གི་ཉམས་ནི།",
    "གཞི་མེ་ཏོག་གི་ཆར་པ།་",
    "གདོང་མ་བཞིའི་དཔོན་པོ་ཁྲོ་ཐུང་རེད།",
    "ངེས་བསྟན་གྱི་རྒྱན་གྱི་ནང་གསེས་མཆོག་གི་ངེས་བསྟན་ནི།",
    "ངས་འུར་ལུང་མཛུབ་མོས་བཟུང་ལུགས་འདི།",
    "ཞེས་པ་ལྟ་བུས་འུར་ལུང་མཛུབ་མོས་བཟུང་བ་དང་།",
    "ཆེ་དགུ་དག་གི་རལ་པའི་རྩེར།",
    "རྐང་པ་བཞི་ཀའི་མཐའ་ན་ཡོད་པའི་ཟུང་ལྡན་གྱི་ཚིག་སྔ་ཕྱིའི་བར་དུ་གཞན་དག་གིས་བར་མ་ཆོད་པ་ལྟ་བུའོ།",
    "རྐང་པ་དྲུག་གི་མཐའ་དྲུག་ལ་ཡ་སྟེ་ཡི་གེ་དཀོན་ཞེས་པ་དྲུག་བཀོད་པ་དེ་ནི་མཐའ་ན་ཡོད་པའི་ཆོད་པའི་ཟུང་ལྡན་གྱི་རྒྱན་ནོ།",
    "གོང་གསལ་གྱི་དཔེ་རུ་དྲངས་པ་དེ་དང་དེ་དག་ནི་འཛམ་གླིང་གེ་སར་རྒྱལ་པོའི་སྒྲུང་ཡིག་པོད་གྲངས་བརྒྱ་ཕྲག་ལ་ཉེ་བ་ཡོད་པའི་ནང་གི་རྟ་རྒྱུག་ནོར་བུ་ཆ་བདུན་དང་འཛམ་གླིང་སྤྱི་བསང་དང་བདུད་འདུལ་སོགས་ཀྱི་ནང་ནས་བཏུས་པ་ཡིན་ལ།",
    "ད་དུང་དེ་མིན་གྱི་རྒྱུན་དག་ཀྱང་དཔེ་བརྗོད་བཙལ་ནས་འདྲེན་ཆོག་མོད།",
    "རང་རིགས་ཀྱི་ཕུལ་བྱུང་སྙན་རྩོམ་གེ་སར་སྒྲུང་གི་སྐོར་ལ་ཕྱོགས་གང་ཐད་ནས་ཞིབ་འཇུག་བརྟག་དཔྱད་བྱས་དང་བྱེད་མུས་ཡོད་པའི་སྐབས་འདིར།",
    "བདག་གིས་ཀྱང་དེའི་བརྗོད་པ་ཚིག་གི་སྐོར་ལ་ཞིབ་འཇུག་ཅུང་ཟད་བྱེད་པའི་སྤྲོ་བ་བཏེགས་ནས།",
    "མཁྱེན་ལྡན་གཟུ་བོར་གནས་པ་དག་གིས་ཐུགས་བརྩེ་བའི་སྒོ་ནས་ཡོ་བསྲང་གནང་བར་ཞུ་ཞེས་གསོལ་བ་འདེབས་པ་ལགས།",
    "གླུ་མཚོ་ཕྱུག་མོ་ཇི་འདོད་འཇོ་བའི་གཏེར།",
    "ལེགས་དྲངས་བརྩེ་དུང་མཚོ་མོ་འཕེལ་བ་ཡི།",
    "ཐོག་མར་གླུ་ཞེས་པའི་བརྡ་ཆད་འདི་ལའང་སྒྲ་ཡངས་འཇུག་དང་དོག་འཇུག་གི་ཁྱད་པར་ཡོད་དེ།",
    "གླུ་ཡི་བརྗོད་ཚིག་བྱུ་རུའི་ཕྲེང་རྒྱུན་ནང་དུ་ཚོགས་སུ་དབྱུང་མི་རུང་བའི་གྲོང་སྐད་ཤིང་གི་དོག་པ་མི་བསྲེས་ཤིང་།",
    "དམངས་ཁྲོད་ཀྱི་གཉེན་སྒྲིག་དང་དུས་ཆེན་སོགས་སྟོན་མོ་ཆེ་ཆུང་ཀུན་གྱི་རྩེད་མོའི་ནང་དོན་གཙོ་བོ་ཞིག་ཏུ་གྱུར་ཡོད་པ་ནི་ཇི་སྐད་དུ།",
    "སྐྱེས་ཕོ་མོས་གླུ་ཁ་མ་བཀྱེད་ན།",
    "མོ་ལོ་དྲུག་གསུམ་བཅོ་བརྒྱད་དུ་སོན་ཚེ།",
    "དེ་དག་གིས་དུས་རྒྱུན་ཁྲོམ་ཚོགས་དཀྱིལ་འཁོར་རྫོགས་པའི་གར་སྟེགས་སྟེང་དུ་མི་སུ་བཟང་དང་།",
