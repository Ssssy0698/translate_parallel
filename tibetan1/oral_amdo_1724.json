    "ཆར་ལོ་རེ་འབབ་ན་ཇེ་རྒྱས་རེད།",
    "དཔེར་བཞག་ན་འབྲོག་པའི་རྩྭ་ཐང་རེད།",
    "བོད་སྦྲ་ནག་ཅན་གྱི་རྩྭ་ས་རེད།",
    "རྩྭ་ལོ་རེ་བསྡད་ན་ཇེ་མཐུག་རེད།",
    "ཡར་ལོངས་དང་ན་ཟླ་ཡང་གིས་རྩེ།",
    "ཡར་ལོངས་དང་ན་ཟླ་ཡང་གིས་རྩེ།",
    "རོགས་ཆུང་འདྲིས་ཕོ་མོ་མགྲོན་ལ་བོས།",
    "ཡར་ལོངས་དང་ན་ཟླ་ཡང་གིས་རྩེ།",
    "མ་བུ་མོ་ཤ་ཁ་དཀར་ན་བསམ།",
    "བུ་བུ་མོའི་ཁས་གཅེས་འཇམ་ན་བསམ།",
    "བདེ་སྐྱིད་ཀྱི་དགའ་སྟོན་དེ་རིང་རེད།",
    "བདེ་སྐྱིད་ཀྱི་དགའ་སྟོན་དེ་རིང་རེད།",
    "མགོ་ཝ་དམར་དུང་གི་ཇ་ལ་ཅན།",
    "བདེ་སྐྱིད་ཀྱི་དགའ་སྟོན་དེ་རིང་རེད།",
    "ཁྲ་ཆིལ་ལེ་ས་ཡི་དོག་མོར་མཆོད།",
    "གུར་དཀར་པོའི་ནང་གི་སློབ་དཔོན་སྐྱིད།",
    "སྦྲ་ནག་པོའི་ནང་གི་འབྲོག་པ་སྐྱིད།",
    "མཁར་ཁང་པའི་ནང་གི་ཞིང་པ་སྐྱིད།",
    "དེ་ཨ་སྔོན་གནམ་གྱི་རྒྱན་ཆ་རེད།",
    "དེ་བར་སྣང་ཁམས་ཀྱི་རྒྱན་ཆ་རེད།",
    "དེ་དོག་མོ་ས་ཡི་རྒྱན་ཆ་རེད།",
    "རྟ་བར་མ་བར་ནས་གཤར་གི་ཡོད།",
    "རྟ་མཇུག་མ་སླས་ནས་ཐོན་གི་ཡོད།",
