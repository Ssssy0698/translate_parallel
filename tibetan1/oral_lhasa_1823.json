    "རྣམ་པར་རྟོག་པ་ནི་སེམས་ཀྱི་རྒྱུ་བ་ཡིན་ན།",
    "དེ་དང་བྲལ་བའི་ཕྱིར་དེ་ཁོ་ན་ཉིད་དེ་ནི་རྣམ་པར་རྟོག་པ་མེད་པ་ཡིན་ནོ།",
    "ཡི་གེ་རྣམས་ལ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་ན་རྣམ་པར་རྟོག་པ་མེད་པ་ཡིན་ནོ།",
    "གཏན་མ་སྐྱེས་པ་གང་དུ་མཚུངས་པ་དེར་དོན་དམ་པར་མཚམས་མེད་པ་རྣམས་ཀྱང་མཚུངས་སོ།",
    "མཚམས་མེད་པ་རྣམས་དོན་དམ་པར་གང་དུ་མཚུངས་པ་དེར་ནི་ལྟ་བར་གྱུར་པ་རྣམས་ཀྱང་མཚུངས་སོ།",
    "དེ་ལ་དོན་དམ་པར་ཐ་དད་དུ་བྱ་བ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "གང་རྣམ་པར་བྱང་བ་དེ་ཡང་དོན་དམ་པར་གཏན་མི་སྐྱེ་བ་ཉིད་དོ།",
    "དོན་དམ་པར་ན་མྱ་ངན་ལས་འདས་པའི་བར་དུ་ཡང་གཏན་མི་སྐྱེ་བ་ཉིད་དེ།",
    "དེ་ལ་དོན་དམ་པར་ན་ཐ་དད་དུ་བྱ་བ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "དེའི་ཕྱིར་དེ་ལྟར་ན་དོན་ཐ་དད་པ་མ་ཡིན་པ་ནི་དེ་ཁོ་ནའི་མཚན་ཉིད་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "གཅིག་ཡིན་པའི་ཕྱིར་མྱུ་གུ་ལྟར་མྱུ་གུའི་གནས་སྐབས་སུ་ས་བོན་འཛིན་པར་ཡང་འགྱུར་རོ།",
    "ཡང་ན་ས་བོན་ལྟར་མྱུ་གུ་ཡང་འཛིན་པར་མི་འགྱུར་རོ།",
    "མི་འཇིག་པར་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "དེ་ཚེ་གཞན་མེད་པར་གཞན་འགྱུར།",
    "དེས་ན་ཆད་པར་མི་འགྱུར་ཞིང་།",
    "ཞེས་གསུངས་སོ།",
    "རྟག་པར་རྒྱུན་མི་འཆད་པར་ཇི་ལྟར་འཚམ་པར་སྤྱོད་པ་རྣམས་ཀྱི་གཉེན་པོར་གྱུར་པ།",
    "ཆད་པ་དང་རྟག་པར་སྨྲ་བ་དང་བྲལ་བར་ཤེས་པར་བྱའོ།",
    "དེ་ལྟ་ན་འང་དེ་དག་སྐྱེ་བ་གཞན་དུའང་སྔོན་གྱི་རྒྱུའི་སྟོབས་ཉིད་ལས་གྲུབ་པ་ངེས་པར་གདོན་མི་ཟ་བར་འགྲུབ་པར་འགྱུར་རོ།",
    "སྐྱེ་བ་ཕྱི་མར་འབད་མེད་པར།",
    "ངེས་པར་ཐོབ་འགྱུར་ལས་བཞིན་ནོ།",
    "གྱུར་པའི་ཚེ་འཕགས་པའི་ལམ་སྟོན་པར་བྱེད་པའི་རྐྱེན་མ་ཚང་བས་དེ་ཁོ་ན་ཉིད་ཀྱི་བདུད་རྩི་མ་ཐོབ་པར་གྱུར་པ།",
    "དེ་ལྟ་ན་ཡང་སྔོན་ཚེ་རབས་གཞན་དུ་དེ་ཁོ་ན་ཉིད་ཐོས་པའི་རྒྱུའི་སྟོབས་ཁོ་ན་ལས་འཇིག་རྟེན་འདིའི་ཉེ་བར་བསྟན་པ་ལ་ལྟོས་པ་དང་བྲལ་ཡང་རྐྱེན་རྣམ་པར་དབེན་པ་རྟེན་པ་ཙམ་ཐོབ་པ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ཇི་ལྟར་ཡོངས་སུ་བཙལ་བ་ལགས།",
    "རྙེད་པ་དང་བཀུར་སྟི་དང་ཚིགས་སུ་བཅད་པ་དག་ལ་མི་གནས་པར་ཡོངས་སུ་བཙལ་ཏོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐོས་པར་འགྱུར་གྱི་ཅི་ནས་ལུས་ངལ་བ་ཡིད་ལ་བྱེད་པ་མི་སྐྱེད་པ་དང་།",
    "ཅི་ལས་ཉམས་པར་འགྱུར་ཞེ་ན།",
    "ཆུ་དེ་དག་མི་སྣང་བར་བྱས་ནས་ཀུན་ཏུ་ཆུ་བཙལ་ན་ཆུ་མ་རྙེད་དོ།",
    "བརྗོད་པར་བྱ་སྟེ།",
    "དུས་གསུམ་དུ་གདགས་པའི་རྒྱུ་དངོས་པོའི་རང་བཞིན་ཡང་ཡོད་པར་འགྱུར་ན།",
    "འདས་པའི་དུས་ན་ཡོད་པར་འགྱུར་ཞེས་གསུངས་ཏེ།",
    "དེ་དག་འདས་པའི་དུས་ལ་ལྟོས་པའམ་མ་ལྟོས་པ་ཡོད་པར་འགྱུར་གྲང་།",
    "དེའི་ཚེ་ངེས་པར་དག་འདས་པའི་དུས་ན་ཡོད་པར་འགྱུར་ཏེ།",
    "དེ་ཡང་བསྒྲུབ་པར་བྱ་བ་དང་མཚུངས་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་འདིར་གལ་ཏེ་ལྟོས་པ་གྲུབ་པར་བྱ་བའི་ཕྱིར་ད་ལྟར་དང་མ་འོངས་པའི་དུས་དག་འདས་པའི་དུས་ན་ཡོད་པར་འདོད་ན་ནི།",
    "དེའི་ཕྱིར་འདས་པར་ཡང་མི་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་འདས་པར་ཡང་མི་འགྱུར་རོ།",
    "ཇི་ལྟར་དེ་ལ་ལྟོས་པར་འགྱུར།",
    "གལ་ཏེ་ད་ལྟར་བ་དང་མ་འོངས་པའི་དུས་དེ་དག་འདས་པའི་དུས་དེ་ན་མེད་པར་རྟོག་ན།"
