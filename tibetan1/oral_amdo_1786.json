    "ཁྱོད་ལ་སྦྱིན་པས་ཡེ་ཤེས་རྡོ་རྗེའི་སྐུ་འགྲུབ་ཤོག།",
    "ཁྱོད་ལ་སྦྱིན་པས་ཡེ་ཤེས་རྡོ་རྗེའི་གསུང་འགྲུབ་ཤོག།",
    "ཁྱོད་ལ་སྦྱིན་པས་ཡེ་ཤེས་རྡོ་རྗེའི་ཐུགས་འགྲུབ་ཤོག།",
    "ཁྱོད་ལ་སྦྱིན་པས་ཡེ་ཤེས་རྡོ་རྗེ་མཆོག་འགྲུབ་ཤོག།",
    "ཧོ་དཔལ་ཡེ་ཤེས་ཀྱི་མགོན་པོ་རྡོ་རྗེ་ནག་པོ་ཆེན་པོ་ཕྱག་བཞི་པ་བྱ་རོག་གི་མཚན་ཅན།",
    "སོ་སོའི་ཡུམ་དང་ལས་མཁན་བཀའ་སྡོད་འཁོར་གྱི་ཚོགས་དང་བཅས་པ་ཁྱོད་རྣམས།",
    "རེངས་པ་དང་།",
    "རང་སེམས་ཡེ་འདོད་མའི་ཤེས་པ་འཁོར་འདས་ཐམས་ཅད་ཀྱི་དཔལ་མགོན་པོ་ཉིད་མངོན་སུམ་དུ་རྟོགས་ནས་བཅོམ་ལྡན་འདས་དཔལ་རྡོ་རྗེ་ཁྲག་འཐུང་རྡོ་རྗེ་བཙུན་མོ་དང་དགྱེས་པར་རོལ་བའི་སྒྱུ་འཕྲུལ་རྡོ་རྗེ་གར་གྱི་ཆོ་འཕྲུལ་འགོག་པ་མེད་པར་འདུ་བགྱིད་པའི་ཕྲིན་ལས་དམ་པ་མཛོད་ཅིག།",
    "གཏང་རག་གི་མཎྜལ་འབུལ་ལོ།",
    "དགའ་ཆེན་ཁྱོད་བདག་གིས་གསོལ་བ་གདབ།",
    "མེ་གསོད་མེ་འགོག་གི་རྩ་འཛུགས་སྐོར།",
    "རྒྱལ་སྲིད་སྤྱི་ཁྱབ་ཁང་གིས་རྒྱལ་ཡོངས་ཀྱི་མེ་གསོད་མེ་འགོག་ལས་ཀར་འགོ་ཁྲིད་བྱ་རྒྱུ་དང་།",
    "མེ་གསོད་མེ་འགོག་གི་སྒྲིག་བཀོད་ལ་བདག་སྐྱོང་།",
    "མེ་གསོད་མེ་འགོག་གི་ཆུ་མཁོ་སྤྲོད།",
    "མེ་གསོད་མེ་འགོག་གི་འཕྲིན་གཏོང་།",
    "སྤྱི་པའི་མེ་གསོད་མེ་འགོག་གི་སྒྲིག་བཀོད་དང་གོ་ལག་མི་འདང་བའམ་དགོས་མཁོ་དངོས་དང་འཚམ་པོ་མ་བྱུང་ཚེ།",
    "རྒྱལ་ཁབ་ཀྱི་ཚད་གཞི་དང་ལས་རིགས་ཀྱི་ཚད་གཞི་ལྟར་མེ་གསོད་མེ་འགོག་གི་སྒྲིག་བཀོད་དང་ཡོ་བྱད་བཀོད་སྒྲིག་བྱ་རྒྱུ་དང་།",
    "བཟོ་བཀོད་ཀྱི་མེ་གསོད་མེ་འགོག་གི་སྒྲིག་བཀོད་ཆ་ཚང་ལ་ལོ་རེར་ཉུང་མཐའ་ཡང་ཞིབ་དཔྱད་ཚད་ལེན་ཐེངས་རེ་བྱས་ནས་སྐྱོན་མེད་གོ་ཆོད་ཡོང་བའི་འགན་ལེན་ཏན་ཏིག་བྱ་དགོས་པ་དང་།",
    "ད་དུང་མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་འགན་འཁྲི་གཤམ་གསལ་དག་ཀྱང་བསྒྲུབ་དགོས་པ་སྟེ།",
    "མེ་གསོད་མེ་འགོག་གི་ཡིག་ཚགས་གསར་འཛུགས་དང་།",
    "མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་བྱེད་གནས་གཙོ་བོ་གཏན་འཁེལ།",
    "འགན་འཁྲི་འཁུར་མཁན་གཏན་ཁེལ་ཡང་བྱས་ནས་ཐུན་མོང་དུ་སྤྱོད་རྒྱུའི་མི་འགྲེམ་སའི་བགྲོད་ལམ་དང་།",
    "མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་འགན་འཁྲི་ཁག་བགོ་གསལ་པོ།",
    "མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་དོ་དམ་པ་གཏན་འཁེལ།",
    "མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་བཀོལ་སྤྱོད་སྐོར་གྱི་སྒྲིག་སྲོལ་ལ་བརྩི་སྲུང་ཞུ་དགོས།",
    "ཆེད་སྤྱོད་རླངས་འཁོར་འབབ་ཚུགས་དང་གྲུ་ཁ་བཅས་སྒྲིག་བཀོད་བྱེད་པར་ངེས་པར་དུ་མེ་གསོད་མེ་འགོག་གི་ལག་རྩལ་གྱི་བླང་བྱ་དང་མཐུན་དགོས།",
    "གནོན་ཤུགས་སྙོམས་སྒྲིག་ས་ཚིགས་བཅས་མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་གི་བླང་བྱ་དང་མཐུན་པའི་གནས་ཡུལ་དུ་འཛུགས་དགོས་པ་མ་ཟད།",
    "མེ་གསོད་མེ་འགོག་གི་ཐོན་རྫས་ཡིན་ཕྱིན་ངེས་པར་དུ་རྒྱལ་ཁབ་ཀྱི་ཚད་གཞི་དང་མཐུན་དགོས།",
    "ལག་རྩལ་གྱིས་གསལ་འབྱེད་བྱས་པ་བརྒྱུད་མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་གི་བླང་བྱ་དང་མཐུན་རིགས་ད་གཟོད་ཐོན་སྐྱེད་དང་།",
    "མེ་གསོད་མེ་འགོག་གི་འཕྲིན་སྐྱེལ།",
    "མེ་གསོད་རླངས་འཁོར་གྱི་བགྲོད་ལམ་སོགས་སྤྱི་པའི་མེ་གསོད་མེ་འགོག་གི་སྒྲིག་བཀོད་སྐྱོན་མེད་གོ་ཆོད་ཡོང་བར་སྲུང་འཛིན་བྱ་དགོས།",
    "གཞུང་ལམ་བཟོ་བ་དང་དེ་བཞིན་གློག་དང་ཆུ་བཀག་པ་དང་འཕྲིན་སྐྱེལ་སྐུད་ལམ་གཅོད་པ་བཅས་བྱེད་སྐབས་མེ་གསོད་མེ་འགོག་རུ་ཁག་གིས་མེ་གསོད་རོགས་སྐྱོབ་བྱ་རྒྱུར་གནོད་པ་སྐྱེལ་སྲིད་པ་ཡིན་ན།",
    "མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་འགན་འཁྲིའི་ལམ་ལུགས་འཛུགས་རྒྱུ་སྒྲིག་འཛུགས་དང་དོན་འཁྱོལ་བྱེད་པར་ལྟ་སྐུལ་བྱ་དགོས།",
    "ནགས་ཚལ་དང་རྩྭ་ཐང་གི་མེ་འགོག་དུས་སྐབས།",
    "མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་གནས་ཚུལ་ལ་ཞིབ་བཤེར་བྱ་དགོས།",
    "མེ་ཟོན་བདེ་སྲུང་གི་སྤྱི་ཆིངས་འགོད་རྒྱུའི་སྒྲིག་འཛུགས།",
    "མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་གནས་ཚུལ་ལ་ཞིབ་བཤེར་བཅས་བྱ་དགོས།",
    "མེ་གསོད་མེ་འགོག་གི་སྒྲིག་བཀོད་ཞིབ་དཔྱད་ཚད་ལེན།",
    "ལས་གཉེར་ཚད་གཞི་བཅས་ལྟར་མེ་གསོད་མེ་འགོག་གི་ལག་རྩལ་ཞབས་ཞུ་མངགས་བཅོལ་འདོན་སྤྲོད་དང་དང་ལེན་བྱ་དགོས་པ་མ་ཟད།",
    "མེ་གསོད་མེ་འགོག་གི་རྩ་འཛུགས་སྐོར།",
    "རྒྱལ་ཁབ་ཀྱི་ཚད་གཞི་ལྟར་མེ་གསོད་མེ་འགོག་གི་གོ་ལག་སྒྲིག་སྦྱོར་བྱས་ཏེ་མེ་གསོད་མི་སྐྱོབ་ཀྱི་ལས་ཀ་སྒྲུབ་འགན་འཁུར་དུ་འཇུག་དགོས།",
    "སྐྱེ་བོ་སུ་ཞིག་གིས་མེ་སྐྱོན་ཤོར་བ་ཤེས་སྐབས་ལམ་སེང་ཉེན་བརྡ་སྐྱེལ་དགོས།",
    "མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་བྱེད་ཚུལ་ལ་ཞིབ་བཤེར་བཅས་བྱས་ནས་དྲང་གཞག་དང་།",
    "མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་བྱེད་ཚུལ་ལ་ཞིབ་བཤེར་བཅས་བྱེད་དུས་གྲོན་དངུལ་བསྡུ་མི་ཆོག་པ་དང་།",
    "གཅིག་མེ་གསོད་མེ་འགོག་གི་སྒྲིག་བཀོད་དང་ཡོ་བྱད་དམ་ཡང་ན་མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་མཚོན་རྟགས་བཀོད་སྒྲིག་དང་གསར་འཛུགས་བྱས་ཚུལ་དེ་རྒྱལ་ཁབ་ཀྱི་ཚད་གཞིའམ་ལས་རིགས་ཀྱི་ཚད་གཞི་དང་མི་མཐུན་པའམ་ཡང་ན་སྐྱོན་མེད་གོ་ཆོད་ཡོང་བའི་སྲུང་འཛིན་བྱས་མེད་པའི་རིགས་དང་།",
    "མེ་གསོད་མེ་འགོག་གི་སྒྲིག་བཀོད་དང་ཡོ་བྱད་ཆག་གྲུམ་བཏང་བ་དང་།",
    "མེ་གསོད་མེ་འགོག་གི་ཐོན་རྫས་ཀྱི་སྤུས་ཚད་བདེན་དཔུང་ར་སྤྲོད་དང་།",
    "མེ་གསོད་མེ་འགོག་གི་བདེ་སྲུང་ལ་ཞིབ་བཤེར་བྱས་པའི་ཚད་ལོན་དཔང་རྟགས་བཅས་སྤྲད་རིགས་དང་།",
    "གཅིག་མེ་གསོད་མེ་འགོག་གི་སྒྲིག་བཀོད་ཅེས་པ་ནི་མེ་སྐྱོན་རང་འགུལ་ཉེན་བརྡ་གཏོང་བའི་མ་ལག་དང་།",
    "མེ་གསོད་མེ་འགོག་གི་ཐོན་རྫས་ཞེས་པ་ནི་མེ་སྐྱོན་སྔོན་འགོག་དང་།"
  ]
