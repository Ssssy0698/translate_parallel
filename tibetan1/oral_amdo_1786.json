    "གང་ཞིག་རང་གི་བདེ་བས་བདེ་སྒྲུབ་པ།",
    "དངོས་གྲུབ་མཆོག་གིས་ང་ནི་བརྟན་པར་མཛད།",
    "གང་གི་ཕྱིར་ཞེ་ན།",
    "དེ་ཉིད་གང་གི་ཕྱིར་ཞེ་ན།",
    "གང་གི་ཚེ་གདོད་མ་ནས་དག་པ་ཐ་མའི་མཐར་བོགས་དབྱུང་དུ་མེད་པ།",
    "གང་ཞིག་རང་གི་འདེབས་བསྒྲུབ་པ།",
    "དངོས་གྲུབ་མཆོག་གིས་ནི་བརྟན་པར་མཛད།",
    "རྡོ་རྗེ་སེམས་དཔའ་ནི་རང་གི་བདེ་བའོ།",
    "རང་གི་བདེ་བ་ནི་སེམས་ཀྱི་མཚན་ཉིད་དོ།",
    "དེ་བས་ན་རང་གི་བདེ་བ་ལ་གནས་པས་རྡོ་རྗེ་སེམས་དཔའ་འགྲུབ་པ་ཞེས་ཀྱང་བྱ་སྟེ།",
    "བདག་གིས་དེ་ལྟར་ཤེས་མོད་ཀྱི།",
    "རྒྱུད་འདིའི་ཐུན་མོང་ཡི་གེའི་དོན།",
    "ཕྱོགས་གཅིག་བདག་གིས་མཐོང་ངོ་ཞེས།",
    "གང་གིས་གླེགས་བམ་འདི་མཐོང་ན།",
    "འདི་བརྟེན་གཞུང་གི་དོན་རྟོགས་ཏེ།",
    "རྟོགས་པ་ཐམས་ཅད་ཀྱི་འཁོར་ལོ་བསྐོར་བ་ཆེན་པོ་ཞེས་བྱ་བའི་འགྲེལ་བ་གཞུང་གི་དོན་བསྡུས་པ་དང་དོན་ལ་འཇུག་པ་ཙམ་གྱི་སྒོར་བཀྲལ་བ་རྫོགས་སོ།",
    "ན་མོ་ག་ར་མཉྫུ་ཤྲཱི་ཛྙཱ་ན་ས་ཏྭཱ་ཡ།",
    "རྒྱད་ཀྱི་རྡོ་རྗེའི་ཚིག་རྣམས་བཅོས་བསླད་བྲལ་བར་ཐགས་ཀྱི་བཀའ་བབས་ཀྱི་རིག་འཛིན་ཆེན་པོས་ལང་གི་ཚལ་ད་བསྡུས་པ་འདི་ཉིད།",
    "དེ་ལ་ཇི་ལྟར་ན་དྲང་དོན་རྟགས་ཀྱི་ཧེ་ར་ཀ་ནི་རྒྱལ་བ་ཀན་གྱི་ཐགས་མཆོག་གི་ཡེ་ཤེས་འབར་བའི་ཁྲོ་བོའི་རྣམ་པ་ཅན་ད་ཤར་བ་དངོས་གྲབ་གཉིས་ཀྱི་གཏེར་ད་གྱར་པ་དེ་ཡིན་ལ།",
    "དེ་ནི་རྒྱད་ཀྱི་དོན་ཉིད་དམ་པའི་མན་ངག་གིས་མ་སྦས་པར་བཀྲལ་བའི་རྗེས་ས་ཚལ་བཞིན་ཞགས་པ་ལས་འགྲབ་པར་འགྱར་གྱི་གཞན་ད་གྲབ་པ་མིན་པས་ན།",
    "ཡང་ཧེ་ར་ཀ་ཞེས་པ་ཁྲག་འཐང་གི་མིང་སྟེ།",
    "འཐང་བ་ནི་སྤྱོད་ཡལ་དེ་ལྟ་བ་ལ་ངང་གིས་རོལ་བ་སྟེ།",
    "ཆེན་པོ་ནི་གཞན་འཇིག་རྟེན་པའི་ལྷ་ཆེན་པོ་སོགས་ལས་ཁྱད་པར་ད་འཕགས་ཏེ་དེ་དག་གི་རྗེ་བོར་གྱར་པའམ།",
    "གསམ་པ་གཞང་གི་དོན་ལ་གསམ་སྟེ།",
    "རྣལ་འབྱོར་ཟབ་མོ་སྐ་གསམ་རྫོགས།",
    "གདལ་བྱ་ཐབས་ཀྱིས་སྤྱོད་པས་རེ་འདོད་སྐོང་བའི་དོན་བྱེད་ནས།",
    "བཏགས་པ་ཙམ་ད་སྣང་གི་ཡང་དག་པར་སྐ་གསང་ཐགས་ཀྱི་ངོ་བོ་ལ་བརྗོད་ད་མེད་པ་བརྟག་ན་དབེན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་སྤྱོད་ཀྱང་ཉོན་མོངས་པས་མི་གོས་པར་དེ་ཉིད་ལམ་ད་འགྱར་བས་ལྷ་ཆེན་པོ་སོགས་ལས་མཆོག་ཏ་གྱར་ལ།",
    "ཉོན་ཡིད་དང་ཚོར་བ་ང་རྒྱལ་རྣམས་རིན་ཆེན་འབྱང་ལྡན་སྤྲོས་བྲལ་གཅིག་པ་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ས་གནས་པ་དང་།",
    "ཀན་གཞི་རང་གི་རྣམ་པའི་ཆ་ནས་དང་།",
    "གོང་གི་དོན་དེ་ལྟ་བའི་ངང་ལས་མ་གཡོས་པ་ན་སྐ་གསམ་ལྷན་གྱིས་རྫོགས་པ་སྟེ།",
    "ཡལ་དྲག་ལ་ཤེས་པ་དྲག་གིས་མ་བཟང་བར།",
    "གཟང་འཛིན་གྱི་རྟོག་པའི་སྤྱོད་ཡལ་ཅན་གྱི་ཕྱི་ནང་གི་སྙིགས་མའི་འབྱང་བ་ལྔ་རྣམ་པར་དག་པ་ནི་གཟང་འཛིན་གྱི་རྟོག་པ་མེད་པའི་རང་བཞིན་ཅན་དྭངས་མའི་འབྱང་བ་ལྔ་སྟེ་ཡམ་ལྔར་གནས་པའོ།",
    "མེ་ཁམས་དང་དྲོད་རྣམ་པར་དག་པ་པདྨ་མཁའ་འགྲོ་གོས་དཀར་མོ།",
    "མི་རིགས་དང་མི་གཞི་དང་དད་པ་དང་ཤེས་རབ་བཞི་ཇི་ལྟ་བ་དང་ལྡན་ངེས་པར་བརྟགས་ནས་ཟབ་མོ་སྔགས་ཀྱི་ཚལ་བསྟན་པའི་སྣོད་ད་གྱར་པའི་སྣོད་ད་གྱར་པ་ཞིག་ཡིན་ན།",
    "དེ་དག་གི་སྲོག་ལྟ་བ་བྱང་ཆབ་སེམས་ཀྱི་དམ་ཚིག་སྟེ།",
    "དམ་ཚིག་གི་སྲོག་ལྟ་བ།",
    "ལང་གི་སྲོག་མན་ངག།",
    "དེ་ལྟར་དམ་ཚིག་མཆོག་གིས་རྒྱད་སྣུམ་པར་བྱས་པའམ་བཅད་དང་ལྡན་པར་བྱ་སྟེ།",
    "མཉམ་ཉིད་སྔགས་ཀྱི་བརྟལ་ཞགས་ཟབ་མོ་ལ་ཇི་བཞིན་པར་གནས་པ་ལས་རིགས་དང་རིགས་མིན་གྱི་ངོར་མི་བལྟ་བ་ཕོ་ཉའི་གཙང་སྦྲ་དང་།",
    "བདེ་སྟོང་གི་རྐྱེན་ལས་ཀྱི་ཕྱག་རྒྱ་དང་མཉམ་པར་སྦྱོར་བ་སྦྱོར་བའི་གཙང་སྦྲ་དང་།",
    "དེ་ལྟར་སྣོད་ལྡན་གདམས་ངག་གི་ལང་ཐོབ་པ་དེས་ཀྱང་ཐོག་མར་དམ་ཚིག་དང་གཙང་སྦྲ་བརྟལ་ཞགས་དེ་དག་གོམས་པར་བྱས་ནས་གདོད་སྒྲུབ་པ་ཉམས་ས་བླང་བར་བྱའོ།",
    "འདི་ལྟར་སྔགས་ཀྱི་སྤྱོད་པ་རྨད་ད་བྱང་བ་ལ་ཡིད་སྤྲོ་བ་མེད་པའི་བློ་ཞན་པ་དང་གསང་སྔགས་ཁྱད་ད་འཕགས་པའི་དོན་ཟབ་མོ་ཇི་བཞིན་མི་ཤེས་པའི་ཤེས་རབ་ཆང་བས་ནི།",
    "གང་གཡོག་གཙག་ལག་གི་བརྡའ་ཤེས་པ།",
    "ཕྱི་ནང་གི་ལས་བྱེད་རྡལ་ཕྱག་སྐྱེས་བའི་འཁོར་དང་བཞི་སྟེ།",
    "དེ་ཀན་ཀྱང་ལས་ཀྱི་སྐྱོན་སོགས་སྤངས་ཞིང་དད་པ་སོགས་ཡོན་ཏན་དང་ལྡན་པ་མ་ཡིན་པ་ལ་ནི་ཚིག་གི་ཟར་ཙམ་དང་དཀྱིལ་འཁོར་གྱི་ཞལ་ཡང་བསྟན་པར་མ་གསངས་སོ།",
    "གནས་ཕན་ཚོགས་ལའང་སྔོན་སྦྱངས་ཅན་གང་བསྟན་པའི་ཏིང་འཛིན་ལ་གནས་ནས་པ་ནི་སྣང་སྟོང་དབྱེར་མེད་ཀྱི་མན་ངག་བསྟན་པའི་སྣོད་དམ་གནས་ཡིན་པས་དེ་ལ་ཏིང་ངེ་འཛིན་ཡེ་ཤེས་མཆོག་གི་གནས་ཞེས་བྱ་ལ།",
    "དས་གང་རང་གི་བསྒྲུབ་པའི་གནས་ས་འོས་པར་བཟང་བ་ལ་སྒྲུབ་པ་དས་ཀྱི་གནས་ཞེས་བྱ་སྟེ་བཞི་པོའམ།",
    "ཡང་རྣམ་པ་གཅིག་ཏ་ཁམས་བོར་རི་མོར་བྲིས་པའི་རྫས་ཐོད་པ།",
    "བསྒྲུབ་པའི་ཞིང་གི་རྫས་བམ་མཚན་ལྡན།",
    "བསྒྲལ་ཞིང་བཅ་དམིགས་ཀྱིས་བསལ་ཞིང་མངོན་སམ་ད་བསྒྲལ་བའི་རྫས་ཏེ་ཕྱི་མ་འདི་གཉིས་བསྒྲལ་བ་ཞིང་གི་རྫས་ཞེས་གཅིག་ཏ་བརྩིས་པས་བཞི་ཡོད་པ་ལས་དངོས་ས་སྐབས་འདིར་དགོས་པ་དང་པོ་གསམ་སྔ་ནས་བརྟགས་ལ།",
    "གིང་གིས་ཕྲ་མེན་མས་འཇོམ་ཚལ་བྱ་ཞིང་ར་ལའི་དབྱངས་དང་བཅས་ཅང་ཏེའ་དྲག་ཏ་བརྡང་བཞིན་བླང་ནས་ཁྱེར་བར་བྱ་ཞིང་།",
    "སྒྲུབ་ཁང་གི་སྒོར་ཕྱིན་པ་དང་སྔགས་བརྗོད་ཅིང་།",
    "ནང་གི་མཚམས་བཅད་པ་གསམ་བསྟན་ཏེ།",
    "ཐོག་མར་བྱེ་བྲག་གི་འབྱང་པོའི་ཚོགས་སམ་སྣང་སྲིད་ཀྱི་མགྲོན་ལ་གཏོར་མ་རྒྱ་ཆེར་བཏང་ནས་ཕྱི་མཚམས་བཅད་པ་དང་།",
    "ཡང་གཏོར་མ་ཆ་གཅིག་སྐབས་ཀྱི་མགྲོན་ཁྱད་པར་བ་རང་གི་མགོན་བྱེད་དང་ཡལ་དེའི་ས་བདག་གནས་བདག་རྣམས་ལ་བསྔོ་ཞིང་སྟོང་གྲོགས་ཀྱི་ཕྲིན་ལས་བཅོལ།",
    "དེ་ནས་བར་མཚམས་ལ་སྒོ་ནས་གཞལ་བའི་འདོམ་གང་གི་སར་དོང་གྲ་གསམ་ད་བྲས་ལ།",
    "སྐད་པ་དཀར་ནག་གིས་བཅིང་།",
    "དག་གིས་བྲབ་ལ།",
    "ཁྲོ་བོའི་སྡང་མིག་གི་མཚམས་ནི།",
    "རང་གི་ཐགས་ཀའི་ཧཱུྃ་ལས་འོད་འཕྲོས་པ་རྡོ་རྗེར་གྱར་པ་འཕྲོ་འདས་བཛྲ་ཨ་ཀྵོ་བྷྱ་ཞེས་པ་ཞལ་གསམ་ཕྱག་དྲག་པར་གྱར་ཏེ་མདན་མཁར་བཞགས་པ།",
    "སྤྱན་གཡོན་ཨ་ལས་ཟླ་དཀྱིལ་གྱིས་ཕྱོགས་ཀན་ཏ་བལྟས་པའི་བདད་རྩིའི་རྒྱན་གྱིས་གོང་གི་བསྲེག་པ་དེ་དག་སླར་ཞི་བར་བསམ་སྟེ་སྔགས་བརྗོད་པའོ།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་གྱི་མཚམས་ནི་བདེན་པའི་བཀའ་བགོ་བའི་ཚིག་དང་སྔགས་བརྗོད་པས་རང་གི་ཐགས་ཀའི་ཧཱུྃ་ལྗང་ག་ལས་ཁྲོ་བོ་གནོད་སྦྱིན་གྲངས་མེད་པར་སྤྲོས་པས་བགེགས་རྣམས་ཕྱོགས་བཅར་བསྐྲད་པར་བསམ་པའོ།",
    "ཐོ་བས་བརྡང་སྟེ་རྡོ་རྗེའི་བྲག་དང་ཉི་མའི་སྟེང་ད་ཕོ་ཁ་སྦུབ་མོ་གན་རྐྱལ་ད་མགོ་མཇག་བསྣོལ་ཏེ་བཞག་ནས་གདན་བཏིང་ལགས་ཀྱི་ཁྲོ་བོའི་སྤྲུལ་པར་དགྱེ་ར་གསོལ་ཞེས་ཞས་ནས་ཧཱུྃ་ཀ་རའི་ཐགས་ཀར་ཐིམ།",
    "དེ་ནས་སེང་ལྡེང་གི་ཕར་པ་བཅ་ལ་ཞེ་སྡང་རྡོ་རྗེའི་ཐགས་ཀའི་ཧཱུྃ་བཅ་ཐིམ་པས་ཕར་པའི་དངོས་པོ་སྦྱངས་ནས་ཧཱུྃ་བཅར་གྱར་པ་ལས་སོ་སོའི་སྔགས་ཀྱིས་ཁྲོ་བོ་བཅ་སྟོད་ཞལ་གསམ་ཕྱག་དྲག་སྨད་ལྕགས་ཕར་ཟར་གསམ་པ་འབར་བའི་འོད་དང་བཅས་པར་གསལ་ལ་བྱགས་བདག་བྲབ་གསམ་བྱས།",
    "ཕྱོགས་སྐྱོང་བཅ་ཐལ་ཕྱང་ད་ཕག་ནས་ཉི་མའི་དཀྱིལ་འཁོར་ལ་དབལ་ནབ་པར་བསམས་ལ།",
    "དེ་ལྟར་བགེགས་ཐམས་ཅད་ཀྱི་རྒྱལ་པོ་ཕྱོགས་སྐྱོང་བཅ་གདན་ད་བཏིང་བས་རྒྱལ་པོ་བཙོན་ད་བཟང་ན་དམངས་ཆོམས་ལ་དབབ་པ་ལྟར་བགེགས་ཕྲ་མོ་གཞན་གྱིས་བར་ཆད་བྱེད་མི་ནས་པར་འགྱར་ཏེ།",
    "དེ་ལྟར་ནང་གི་མཚམས་བཅད་པ་བདན་བྱའོ།",
    "ལྷ་རྣམས་ཀྱིས་བདག་ཅག་རྣམས་ཞལ་གཟིགས་ཤིང་ཐགས་ལ་དགོངས་པར་བསམ་པའོ།",
    "རྣམ་རྒྱལ་བམ་པ་ལ་བགེགས་བསྐྲད་སྟོང་པར་སྦྱངས་ཡམ་ཀན་ཏ་བཟང་མོར་གསལ་བའི་མཁའ་ལ་གཞལ་ཡས་ཁང་གདན་དང་བཅས་པར་བསྐྱེད།",
    "ལས་བམ་བྷྲཱུ་ལས་གཞལ་ཡས་ཁང་གི་ནང་ད་རྡོ་རྗེ་གནོད་སྦྱིན་གསལ་བཏབ་ལ།",
    "ལྔ་པ་ནི་ཀརྨས་ཤར་ད་བསྲེ་བསྣན་སྟ་གོན་གྱི་མཎྜལ་བྱ་ཞིང་བ་བྱང་གིས་བྱག།",
    "ཁྱོར་ཆ་བླད་པ།",
    "ཁྱད་པར་དམ་ཅན་ལྷག་མགྲོན་ལ་གཏོར་མ་དང་ལྷག་མས་རྒྱས་པར་བརྔན་ལ་སྒྲུབ་པའི་གྲོགས་བྱེད་པའི་ཕྲིན་ལས་བཅོལ་ནས་མཚན་མོར་རྨི་ལམ་བརྟག་པར་བྱའོ།",
    "དར་ཁྲོད་ཀྱི་གནས་ན་ཤ་ཁྲག་གི་ལོངས་སྤྱོད་ལ་རོལ་ཞིང་།",
    "དེ་ལ་དག་ཅེས་པའི་ཚིག་གིས་ར་ཏྲའི་དབྱེ་བ་བརྒྱད་དེ།",
    "དེ་ཐལ་བས་སྒྱུ་མ་མཁན་མེད་ན་དེའི་སྤྲུལ་པ་མི་སྣང་བ་བཞིན་ད་བདད་ར་འཁོར་དང་བཅས་པ་ཐལ་བའོ།",
    "གཉིས་པ་སྔགས་ཀྱི་ཐབས་ཟབ་མོས་སྤྱོད་པས་མ་ཏྲཾ་བསྒྲལ་བ་སྟེ།",
    "འབྲས་བ་ཉོན་མོངས་ལྔར་སྨིན།",
    "ཡམ་ཀྲོ་དྷཱི་ཤྭ་རི་དང་དབྱེར་མེད་ད་འཁྲིལ་བ་དམ་ཚིག་གི་ཕྱག་རྒྱ།",
    "ཁྲོ་བོའི་ཞབས་གྱད་ཀྱི་དོར་སྟབས་ཀྱིས་སྟེང་ད་མཆོངས་ཤིང་བརྫིས་པར་མོས།",
    "ཐགས་ཀའི་ཧཱུྃ་དམར་པོའི་འོད་ཀྱིས་ཨ་དེ་བཀག་ནས་རང་གི་ཐགས་ཀའི་ཨ་ལ་ཐིམ་པ་ལས་ཧཱུྃ་ད་གྱར་པ་སྲོག་དག་པའི་གསང་ལང་ད་བརྒྱད་ནས་བདག་གི་བྱང་ཆབ་ཀྱི་སེམས་དང་འདྲེས་པ་རྡོ་རྗེའི་ལམ་ནས་ཡམ་གྱི་མཁར་བབས་པ་ཡམ་གྱི་བྱང་སེམས་དང་འདྲེས་ནས་སྲས་ཀྱི་དམ་པར་བསྐྱེད་པ་མཁའ་ནས་བཏོན་ཏེ་མདན་ད་ཉི་ཟླའི་གདན་ལ་བཞག་གོ།",
    "བགེགས་ཕྲ་མོ་ཀན་གཉའ་ཆག་ནས་ཟིལ་གྱིས་གནོན།",
    "ཁམས་ཕོར་རི་མོར་བྲིས་པ་དག།",
    "དེ་ལ་ཐོག་མར་སྟེགས་བ་འདོམ་གང་གྲ་བཞི་འཕང་ཁྲ་གང་བའི་མཎྜལ་ལེགས་པར་བྱས་ཏེ་བ་བྱང་གིས་བྱག་ཅིང་དེར་ཆག་ཆག་གདབ་ནས་བྱིན་གྱིས་བརླབ་པའི་ཐིག་སྐད་ཀྱིས་གནམ་ཐིག་རྒྱ་གྲམ་དང་།",
    "མར་མེ་འགོད་པའི་ཚིག་གིས་ལྷ་གྲངས་བཞིན་ད་རིམ་པར་དགྲམ་པར་བྱའོ།",
    "ཤན་ཆེན་གཡང་གཞི་ལ་ཁྲག་གི་ཐིག་ལེ་ལྷ་གྲངས་བྱས་པ་དཀྱིལ་འཁོར་གྱི་བླ་བྲེ་བྱ།",
    "ཐོད་ཚལ་གསམ་ད་ཐལ་ཆེན་རཀྟ་ཞག་གསམ་ཡང་བཞག།",
    "ནབ་ཕྱོགས་ས་དཔལ་ཆེན་པོ་འཁོར་དང་བཅས་པའི་སྐ་བྲིས་འབར་གང་རིགས་ནི་ལྷ་གཤེགས་པའི་རྟེན་དང་མཚན་མ་བརྟགས་པ་དང་ཏིང་འཛིན་གསལ་བའི་ཕྱིར་མིག་གི་རྟེན་ད་བཞག།",
    "བྷྲཱུ་ལས་རིན་ཆེན་གཞལ་མེད་ཁང་ད་ཉི་དཀྱིལ་གྱི་སྟེང་ད་ཡོ་བྱད་རྣམས་དམིགས་པ་ཧཱུྃ་གིས་བསྲེག་སྟེ་སྟོང་པའི་ངང་ལས་ༀལས་སྣོད་བཅད་ཀྱི་བདད་རྩི་བསྡུ་ཞིང་ཡེ་ཤེས་ལྔའི་རང་བཞིན་འདོད་ཡོན་ལྷ་མོ་དྲག་གི་རོལ་པས་ནམ་མཁའ་གང་བར་བསམ་ལ་གཏོར་མའི་སྔགས་བརྗོད།",
    "མཆོད་གཏོར་དང་ཚོགས་ཐམས་ཅད་ཡོ་བྱད་བཞིན་ད་བརླབ་པར་བྱའོ།",
    "རཀྟ་ནི་བན་ྡྷའི་གཞལ་ཡས་འཇིག་རྟེན་གྱི་གཏོས་དང་མཉམ་པར་ར་ཡིག་གི་དངོས་རྟོག་སྦྱངས་ཏེ་རཀྟའི་རྒྱ་མཚོ་རྦ་རླབས་འཁྲགས་པའི་ཟེར་མ་རེ་རེ་ལས་འདོད་ཡོན་ལྔའི་ལྷ་མོ་འཕྲོ་བར་བསམ་ལ་སྔགས་བཟླའོ།",
    "རྟོགས་པའི་བློ་ཅན་དེ་དག་གིས།",
    "ལམ་མཆོག་གིས་བྱང་ཆབ་བསྒྲུབ་པར་འདོད་མི་འདོད།",
    "ཐིམ་པའི་རྒྱལ་མོར་བྱིན་གྱིས་བརླབས།",
    "མི་དམིགས་པའི་ངང་ནས་ས་བོན་ལས་ཇི་ལྟར་འདོད་པ་བཞིན་ད་ཡམ་ཀན་ཏ་བཟང་མོའམ་ཀྲོ་དྷཱི་ཤྭ་རི་མའི་རྣམ་པར་བློས་སྦྱར་བར་བྱ་བ་ནི་ལས་སྐར་བྱིན་གྱིས་བརླབས་པའོ།",
    "ཕྱིན་ཅི་ལོག་གི་འདོད་ཆགས་བདེ་བ།",
    "ཡབ་རྣམས་ཡབ་ལ་ཐིམ་པས་རྡོ་རྗེ་རྒྱལ་པོ་དང་ཡམ་རྣམས་ཡམ་ལ་ཐིམ་པས་རྡོ་རྗེ་རྒྱལ་མོ་ཀན་ཏ་བཟང་མོའམ་ཀྲོ་དྷཱི་ཤྭ་རི་དངོས་ས་གྱར་པར་བསམ་པར་བྱ་སྟེ།",
    "ཧཱུྃ་གིས་བསྐྱོད།",
    "དེ་ལས་འོད་ཟེར་འཕྲོ་བ་ཇི་བཞིན་ད་མཉམ་པར་ཡམ་གྱི་མཁའ་ལ་གསལ་བ་དག་ནི་ནམ་མཁའ་དྭངས་པ་ལ་དྲི་མ་མེད་པའི་ཉི་མའི་དཀྱིལ་འཁོར་ཤར་བའི་འོད་བས་ཀྱང་འཚེར་ཞིང་བྱང་ཆབ་སེམས་དེ་ནི་གཟང་འཛིན་དང་བྲལ་ཞིང་ནག་པོར་རིའི་དྲི་མ་མ་ལས་པ་ཀན་ཏ་དག་པ་སྟོན་ཀའི་ཟླ་བ་ལྟར་གནས་པ་ཉིད་ད་བསམ་མོ།",
    "དྲི་མ་མེད་པའི་ཉི་མའི་འོད་ཟེར་བས་ཀྱང་ཤིན་ཏ་འཚེར་ཏེ་སྣང་བ་གཞན་གྱིས་སེལ་བར་མི་ནས་པའི་ནང་གི་མན་པ་འཇོམས་པའི་སྟོབས་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "བྱང་ཆབ་སེམས་མཉམ་པ་ཉིད་ལ་གཟད་པའམ་ཚད་ནས་ཐིག་ལེ་ཉག་གཅིག་ཏ་གནས་སོ་ཞེས་པ་དེ་ནི་མཚོན་བྱ་དོན་གྱི་ཡེ་ཤེས་རང་བཞིན་རྫོགས་པ་ཆེན་པོ་དབངབཞི་པའི་མན་ངག་གིས་བསྟན་དོན་ཡིན་ནོ།",
    "དེའི་རྗེས་ས་དགོངས་སྤྱོད་ཟབ་མོའི་དམ་ཚིག་གི་ལང་དབོག་པར་བྱའོ།",
    "ལང་མན་ངག་གི་གདམས་པ་སྦྱིན་པ་དང་།",
    "མན་ངག་ཟབ་མོ་རྣ་བར་གཤིབ་པ་གསམ་གྱི་དང་པོ།",
    "རྐྱེན་ཅི་བྱང་ཡང་སྤྱོད་ལམ་ཡངས་ཤིང་ཚིག་གི་མཚོན་ཆ་མ་ཤོར་བར་བྱ་བ་དང་གསམ།",
    "སྦྱོར་སྒྲོལ་ཟབ་མོ་ལ་ཡིད་གཉིས་མི་ཟ་བར་བརྟལ་ཞགས་ཆེར་སྤྱོད་པ་དང་དྲག།",
    "ཀན་སྣང་དང་རྒྱ་ཏིང་གི་རིམ་པ་ལ་ཚལ་བཞིན་གོམས་པར་བྱ་སྟེ།",
    "སླར་འདས་བདག་ཉིད་ཀྱང་བསྲེག་སྟེ་ཨ་གཅིག་པར་གནས་པ་ཇེ་ཕྲར་གྱར་ནས་མཐར་སྒྲ་ཙམ་དང་སྒྲ་མཐའ་ཡལ་ཏེ་ཅི་ཡང་མི་འཛིན་མི་དམིགས་པའི་བར་ད་གྱར་པར་བསྒོམ་མོ།",
    "དཀར་པོ་རྒྱན་ཆས་མེད་པ་ཚོན་གང་བ་ཞིག་ནམ་མཁའ་ལ་ཡེ་ཤེས་ཀྱི་རླང་གིས་བཏེགས་ནས་ཅི་ལའང་མི་བརྟེན་པའི་ཚལ་གྱིས་བཞགས་པར་བསམ་མོ།",
    "རེ་ཞིང་དམ་པའི་ཚལ་ད་དགོངས།",
    "གང་ལྟར་ཡང་ཡེ་ཤེས་སེམས་དཔའི་ཐགས་ཀ་ནས་ཨེ་སོགས་ལྔ་འཕྲོས་པས་སྙིགས་འབྱང་སྦྱངས་ཏེ་ཡམ་ལྔའི་ངོ་བོ་དྭངས་མའི་འབྱང་བ་མཁའ་རླང་ཆ་ས་བཞི་རིམ་བརྩེགས་དང་དེ་སྟེང་མེ་འོད་འབར་བས་ཀན་ཏ་ཁྱབ་པར་བསམ་མོ།",
    "བྷྲཱུ་ལས་འོད་ཟེར་གྱི་ཚལ་ད་བྷྲཱུ་ཕྲ་མོ་ཉངས་འབྲ་ཙམ་གྲངས་མེད་པ་སྤྲོས་ནས་ཀྱང་སྣོད་བཅད་ཀན་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་གྱིས་སྦྱངས།",
    "རྒྱ་ཁྱོན་ནམ་མཁའི་མཐའ་དང་མཉམ་པ།",
    "སེང་གེ་ལ་སོགས་པའི་གདན་དང་བཅས་པ་གཞལ་ཡས་དེའི་རྒྱན་འཕན་དང་རྒྱལ་མཚན་དོ་ཤལ་ལ་སོགས་པ་དང་འདོད་ཡོན་གྱི་ལྷ་མོའི་ཚོགས་རང་བྱང་བས་བརྒྱན་པར་གསལ་བར་བྱའོ།",
    "ལ་སོགས་པ་ཞེས་པའི་སྒྲས་བདག་གི་ཐགས་ཀ་ནས་ཡི་གེ་མཱུཾ་ལས་དྲིལ་བ་དང་དེ་ལས་རྡོ་རྗེ་དབྱིངས་ཕྱག་མ་གཡོན་ད་བསྐྱེད་ནས།",
    "ཧཱུྃ་གིས་བརྒྱད།",
    "དེའི་གཡོན་ད་ཡམ་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་མི་འབྲལ་བ་གསང་བ་ཡམ་གྱི་དཀྱིལ་འཁོར།",
    "ཀན་ལ་རང་གི་དབ་རྒྱན་རིགས་ལྔ་དང་ལྗགས་རྡོ་རྗེ་རྩེ་གསམ་རྩེ་མོ་པད་འདབ་བཞི་པ་དང་།",
    "འཁོར་ཞེས་པས་ཐབ་དྲག་ལ་གོང་གི་དཀྱིལ་འཁོར་ལྔ་མི་ཚང་ཞིང་འགྲོ་བ་དྲག་འདལ་བའི་ཐབས་ས་སྤྲུལ་པ་ཙམ་ཡིན་པས་དཀྱིལ་འཁོར་ལྔ་ལ་སོགས་པའི་ཡོན་ཏན་དང་ལྡན་པའི་གཙོ་བོའི་ལྷའི་འཁོར་གྱི་ཚལ་ད་སྣང་བས་དེ་སྐད་ད་གསང་སྟེ།",
    "ལས་ཞེས་འབྱང་ཁང་གི་སྒྲས་སྐའི་གནས་རྣམས་ལས་འོད་འཕྲོ་བ་དང་།",
    "སོགས་སམ་རྩོགས་ཞེས་པས་ཉོན་མོངས་དྲག་བསགས་པ་ལས་སྐྱེས་པ་རིགས་དྲག་དང་འཁོར་ཞེས་པས་རིགས་དྲག་དེའི་གཙོ་བོའི་ཚལ་ད་སྣང་ཞིང་ལྷའི་འཁོར་ཡིན་པས་ཐབ་དྲག་བསྟན་པར་གསང་པའང་རྒྱ་སྐད་ཀྱི་འབྲ་བཤགས་མིན་ཀྱང་དོན་གྱི་སྐད་བྱིང་འཇལ་ཚལ་ཟབ་མོ་ཞིག་སྟེ་འགྲེལ་བ་ན་གསང་པ་འདི་ཡང་རྒྱད་ལས།",
    "དོན་གྲབ་ལ་ཕྱག་རྡོར་འཇམ་དཔལ་བདད་རྩི་ཡབ་ཡམ་དྲག་གིས་བསྐོར་བའི་དཀྱིལ་འཁོར་ལྔ་དང་།",
    "ཕྱོགས་བཞི་ན་ལྔ་རེ་ལྔ་རེ་དང་སྤྱིར་བཞིས་བསྐོར་ནས་གནས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་དག་གི་འོད་ཀྱང་རིགས་ལྔ་དང་ཀན་བཟང་ཡབ་ཡམ་གཞའ་ཚོན་འོད་ལྔའི་ནང་ན་བཞགས་ཤིང་སེམས་དཔའ་ཡབ་ཡམ་དང་ཐབ་དྲག་འོད་སྣ་གསམ་གྱི་ནང་ན་བཞགས་པ་དང་སྒོ་བ་ཡབ་ཡམ་བསྐལ་མེ་འབར་བའི་ཀློང་ན་བཞགས་པའོ།",
    "དག་ཅེས་གཉིས་ཚིག་གིས་ངེས་པར་བརྣན་པའི་རྣམ་པས་རྣལ་འབྱོར་པའི་ཏིང་ངེ་འཛིན་དང་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡལ་ད་ནག་ནོག་དང་ར་རི་མེད་པར་གསལ་ཞིང་བཀྲ་བར་བསྒོམ་ཞེས་པའི་དོན་ཏོ།",
    "ཐོག་མར་ཕྱག་རྒྱ་དཔང་མགོར་བསྣོལ་ནས་སེ་གོལ་བརྡབ་པ་རྡོ་རྗེ་བསྡུ་བའི་ཕྱག་རྒྱ་དང་སྔགས་བརྗོད་པས་བདག་གི་ཐགས་ཀ་དང་གསང་བའི་མཁའ་ལས་འོད་ཟེར་ལྕགས་ཀྱ་ལྟ་བ་བསམ་གྱིས་མི་ཁྱབ་པ་སྤྲོ་ཞིང་།",
    "སྤྱན་འདྲེན་པའི་ལང་ཚིག་གིས་བསྐལ་བས་ཞིང་སོ་སོ་ནས་ཏིལ་གང་བཞིན་ད་དཀྲིགས་ཤིང་འོད་ཟེར་འཕྲོ་བ་དང་བཅས་ཏེ་བྱོན་ནས་ཏིང་འཛིན་གྱི་དཀྱིལ་འཁོར་དང་འོད་ཕང་འདབ་འདྲེས་ཙམ་ད་བཞགས་པ་ལ།",
    "སླར་ཡང་ཕྱག་རྒྱ་བཞིས་སྤྱན་དྲངས་པའི་ཚིག་བརྗོད་ནས་ཡབ་ཡམ་གྱི་ཐགས་ཀ་དང་མཁའ་གསང་ནས་ཕྱག་རྒྱ་བཞིའི་འོད་ཟེར་འཕྲོས་པས་གཞལ་ཡས་ཁང་གི་ནང་ད་སྤྱན་དྲངས་ཏེ།",
    "ལྷ་རྣམས་ལྷ་སོ་སོར་འོད་ཕང་ཀྲག་གིས་འདྲེས་ནས་རང་ཉིད་ལྷ་ལ་ལྷ་ཉིད་རང་ཡིན་ཏེ་དོན་དབྱིངས་དང་ཡེ་ཤེས་གཉིས་ས་མེད་པར་རྟོགས་ན་རྟགས་རིག་པའི་མེ་ཏོག་བོར་བ་ཞེས་ཀྱང་བྱའོ།",
    "མར་མེ་ཕྱི་ལྟར་སྣོད་སྟོང་གསམ་ཙམ་ལ་མར་ཁ་རྒྱ་མཚོ་ཙམ་གྱི་མེ་ལྕེའི་འོད་ཀྱིས་སྲིད་གསམ་ཁྱབ་པ་ནང་ལྟར་སྣོད་དར་ཁྲོད་ཀྱི་གཞལ་ཡས་ཁང་མར་ཁ་ངོ་བོ་ཞི་གནས་ཏེ་རྣམ་པ་ཚིལ་ཆེན་རྒྱ་མཚོ་ཙམ་ལ་མེ་ལྕེ་ལྷག་མཐོང་ཡེ་ཤེས་ལྔའི་ཟེར་འཕྲོ་བ་དང་གསང་བར་བདག་གི་བྱང་ཆབ་སེམས་ཡེ་ཤེས་ཀྱི་མར་མེ་སྟོང་ཕྲག་ད་མར་འཆར་བའི་གཞིར་བསམ་པ་དང་།",
    "དྲི་ཆབ་ཕྱི་ལྟར་ལྷ་མོ་དང་ཕོར་ཐོགས་པ་མང་པོས་ཙནྡན་གྱི་འདི་གས་བྱག་པ་དང་ནང་ལྟར་བྱང་ཆབ་སེམས་ཀྱི་རླན་གྱིས་ཉོན་མོངས་པའི་ལྗན་ལྗིན་གནས་ས་དག་པ་གསང་བར་ཞི་གནས་ཀྱི་རླན་དང་བཅས་པའི་ལྷག་པའི་བྱང་ཆབ་སེམས་ཀྱི་རང་བཞིན་ད་བསམ་པ་དང་།",
    "ཐོག་མར་བདད་རྩི་ཆེ་བ་བརྗོད་ཅིང་དཀྱིལ་འཁོར་གྱི་ལྷ་སོ་སོར་རྐང་ཐོན་ད་ཕལ་ལ་སྔགས་ཚིག་གི་སྐབས་ས་ཁ་རམ་དང་པོས་སྣང་སྲིད་བདད་རྩིར་བསྒྱུར།",
    "དེ་ནས་གཏོར་མ་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་འདོད་པའི་ཡོན་ཏན་ལྔའི་ལྷ་མོ་སོགས་བསམ་གྱིས་མི་ཁྱབ་པས་མཆོད་ཅིང་མཉེས་པར་བསམ་ལ་མཆོད་དོ།",
    "དེའི་ངོ་བོའང་དོན་དམ་པར་རང་གི་སེམས་ཉིད་དོན་གྱི་ལྷ་བྱང་ཆབ་སེམས་ས་ངོ་ཤེས་པའམ་ཀན་རྫོབ་ཏ་ཐགས་རྗེ་ཆེན་པོ་རྟགས་ཀྱི་ལྷར་ཤར་བ་ལ་ཉེ་བར་བྱེད་པའི་ཐབས་དམ་པ་ཡིན་ལ།",
    "དབྱེ་བ་དས་དང་གྲངས་དང་མཚན་མའི་བསྙེན་པ་གསམ་མོ།",
    "ཞི་བའི་ངག་གིས་མི་དྲག་མི་ཞན་པར་འཛབ་དབལ་བར་བྱ་སྟེ།",
    "མཐར་ཚོགས་བསགས་ཕྱིར་འདོད་ཡོན་ལྷ་མོས་མཆོད་ཅིང་།",
    "དེ་ལྟ་བའི་ཏིང་འཛིན་གསལ་ཞིང་བརྟན་པར་གྱར་ན་བསྙེན་པ་དང་སྒྲུབ་པ་དང་དངོས་གྲབ་ཀྱང་ཡིན་ནོ་དེས་ཞི་བར་བསྙེན་པ་སོང་ནས།",
    "དེ་དག་ནི་འོག་གི་ཚིག་གི་ཤགས་ལ་གྲབ་པས་ཤེས་ནས་ཤིང་།",
    "དང་པོ་རང་ཉིད་མི་བསྐྱོད་པས་ཐགས་རྗེ་ཡེ་ཤེས་ཀྱི་སྤྱན་གྱིས་སྲིད་པ་གསམ་ལ་གཟིགས་པས་ཞི་བས་མི་འདལ་བ་རྣམས་ཁྲོ་བོས་འདལ་བར་གཟིགས་ནས།",
    "བན་ྡྷའི་མིག་ནས་མེ་འབར་ཞིང་སྣ་ནས་དད་པ་འཐལ་བ་ལྕང་ལོ་ལས་ཁྲག་གི་ཟར་བ་འབབ་པ།",
    "སྦྲུལ་སྔོན་པོའི་སྐྱེས་བ་ཆ་སྲིན་གྱི་སྤྱིབ་ཁང་ཞིང་ཕོ་མོའི་སྒོ་འགེབས་དང་ལྡན་པ།",
    "དེའི་ནང་ན་ཞིང་གི་བླ་རེ་སོགས་རྒྱན་སྣ་ཚོགས་དང་སྒོ་བཞིར་ཏ་ལའི་སྐྱེ་ཤིང་ཟང་རེ་ཡོད་པ།",
    "དེའི་ཡལ་གར་འདོད་ཡོན་ལྷ་མོ་མང་པོ་གནས་པ་རྩ་བ་དང་བར་ཁྱམས་ལ་རོ་བམ་རིལ་དང་མགོ་མེད་ཕྱེད་མ་རལ་བ་བམ་པ་ལྷག་མ་ལ་སོགས་པ་ལ་ཅེ་སྤྱང་དང་མན་འདེ་དང་ཀངྐ་ལ་སོགས་པ་མང་པོ་རོལ་པ་ཅན་གྱི་གནས་ས་གྱར་པའི་དབས་ས།",
    "ཡེ་ཤེས་དམ་ཚིག་ཆེན་མོ་ཡིས།",
    "གཙོ་བོ་ཡབ་ཡམ་ནི་ཡེ་ཤེས་ལྔ་འདས་པའི་བདག་ཉིད་ཐབས་ཕྱག་རྒྱ་ཆེན་པོ་ཡབ་བཛྲ་ཧེ་ར་ཀ་དང་དབྱིངས་ཀྱི་ཡམ་དམ་ཚིག་ཆེན་མོ་ཀྲོ་དྷཱི་ཤྭ་རི་མ་གཉིས་ས་གནས་གྱར་པ་ཡིས་ཁྲོ་བོའི་རྣལ་འབྱོར་བྱའོ།",
    "ཞེས་དེ་ཡང་བདག་ཉིད་མི་བསྐྱོད་པའི་ཡེ་ཤེས་སྤྱན་གྱི་ཁྲོ་བོས་འདལ་བ་ལ་གཟིགས་ཏེ་ཐགས་རིག་པའི་ཡེ་ཤེས་ཧཱུྃ་ད་གསལ་བ་དེ་ཧེ་ར་ཀའི་སྣ་གླས་དབགས་དང་སྦྲགས་ནས་ཁོང་རྒྱད་ནས་དྲངས་ཏེ་སྣ་རྩེར་ཉི་མའི་སྟེང་ན་གསལ་བ་ལས།",
    "ཧཱུྃ་གཉིས་པས་ཤེས་པས་ཟིན་དང་མ་ཟིན་པའི་སྒྲ་སྐད་ཐམས་ཅད་ཧཱུྃ་གི་གདངས་ས་གྲགས་པར་བསམ།",
    "རྫི་མ་ལྕགས་ཀྱའི་འོད་ཟེར་ད་འཕྲོ་བ་སྤྱན་དབས་མ་གསམ་སྡང་མིག་འབྲ་ཚགས་ས་གཟིགས་པའི་མིག་སྤྲིན་དམར་བ་འབྲས་བ་ལྡིང་ནག་ལ་གྲ་གསམ་ད་གསལ་བ།",
    "དེའི་འགྲོས་ས་གསང་དང་ཐགས་ལ་སྦྱར་ཏེ་ལྗགས་སྟེང་ཨཱ་དམར་པོ་ལས་སྤྲོ་བསྡུས་ལྗགས་རྡོ་རྗེ་རྩེ་གསམ་ལ་རྩེ་མོ་པདྨ་འདབ་མ་བཞི་བའི་ལྟེ་བར་ཨཱ་དམར་པོ་མཐའ་མར་ར་ལ་འབྲ་བརྒྱད་ཀྱིས་བསྐོར་བ་དང་།",
    "དེ་ནས་ཡམ་བསྐྱེད་པ་ནི་བདག་གི་ཐགས་ཀའི་ཧཱུྃ་ལས་ཡམ་གྱི་ས་བོན་འཕྲོས་པ་སྣ་རྩེར་ཉི་དཀྱིལ་ལ་གནས་པ་ལས་འོད་འཕྲོས།",
    "རིགས་ཀྱི་ཡམ་བཞི་ལ་ཕོག་པས་འོད་ད་ཞ་ནས་སླར་བསྡུས་ཏེ་ཀན་ཏ་བཟང་མོའི་སྤྱི་གཙག་ཏ་ཐིམ་པས་འོད་ད་འབར་ཞིང་ཡམ་སྔགས་བརྗོད་པས་ཡམ་ཀྲོ་དྷཱི་ཤྭ་རི་མ་མཐིང་ནག་ཞལ་གཅིག་ཕྱག་གཉིས་སྤྱན་གསམ་པ།",
    "གཡོན་བྷན་དམར་གཙོ་ལ་སྟོབ་པ་སྟེག་རྒོད་འཛམ་པའི་མདངས་དང་ལྡན་ཅིང་འོད་ཕང་དང་བཅས་ནས་བཞགས་པར་བསམ་མོ།",
    "དེ་ནས་འཁོར་གནས་བསྒྱུར་ལ་ཐབས་གང་གིས་བསྒྱུར་བ།",
    "མགྲིན་ཕག་ནས་ཐགས་ཀར་ཐིམ་པ་སྲོག་གི་གསང་ལང་ད་ཞགས།",
    "ཧཱུྃ་གིས་སྒལ་ཚིགས་རྟ་ལ་བརྒྱད་དེ་རྡོ་རྗེའི་ལམ་ནས་འབྱང་བ་དེ་ཕཊ་ཀྱིས་ཡམ་གྱི་མཁའ་ལ་འཕང་པ་རང་རིག་ཡེ་ཤེས་ཀྱི་ངོ་བོ་ལྷག་པ་བྱང་ཆབ་ཀྱི་སེམས་དེ་ལས་འོད་ཀྱི་འཕྲོ་འད་བྱ་བ་ནི།",
    "སླར་སྒལ་ཚིགས་བརྒྱད་དེ་ཡམ་གྱི་སྣ་བག་གཡས་ནས་ཐོན་ཏེ་བདག་གི་སྣ་བག་གཡོན་ནས་ཐིམ་པས་དགྱེས་པའི་རོ་དས་གཅིག་ཏ་སྐ་ཉམས་ས་བསྟར་བར་བསམ།",
    "དགྱེས་མཉམ་མཆོག་གི་སྦྱིན་པས་གཏིམ།",
    "སྐ་རེ་རེ་ལས་ཀྱང་ཡེ་ཤེས་ཀྱི་མེ་འོད་བསྐལ་པའི་མེ་དཔང་འཁྲིགས་པ་བཞིན་ད་འབར་ཞིང་འཚབས་པའི་ཁྲོ་བོའི་སྤྲུལ་པ་མང་པོས་སྟོང་གསམ་དང་འཇིག་རྟེན་དྲག་གི་ཁམས་བཀང་བས།",
    "སྟོང་གསམ་གྱི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་རས་བལ་རླང་གིས་བཏབ་པ་བཞིན་ད་གཡོ་ཞིང་གཏོར་བསྲེག་རྡལ་ད་བྱས་ཤིང་ཁྱད་པར་ད་འདོད་ཁམས་ཀྱི་ལྷ་ཆེན་པོ་སོགས་དྲེགས་པ་ཅན་བསྒྲལ།",
    "དྲེགས་པ་ཅན་དེ་དག་གི་ཆང་མ་སྲིན་མོ་རྣམས་ཀྱིས་དཔལ་གྱི་ཞལ་ནི་མ་མཐོང་བར་འོད་ཟེར་དང་སྒྲའི་ཆོམ་རྒྱངས་ཀྱིས་མཐ་དང་བྲལ་ནས་ལ་ལ་བརྒྱལ།",
    "ཐ་མ་སྲིང་ཆང་མ་དྲན་ཏེ་ཉེ་གནས་བཞིའི་ཚལ་ད་དམ་མནོས་ལ་མ་ཆགས་ཐབས་ཀྱི་སྦྱོར་བ་བྱས་ནས་དཀྱིལ་འཁོར་གྱི་མ་རན་ལ་ཞིང་རྐྱང་དང་དར་གྱི་རློད་སྟན་རེའི་སྟེང་ན་དབ་གཙག་ཏོར་རེ་དང་ལྡན་པར་པས་མོ་རྐྱལ་བཙགས་ནས་མགོ་བཏད་དེ་གནས་པར་བསམ་མོ།",
    "དེ་དག་གིས་ཐབས་གང་གིས་བསྒྱུར་བའི་ཚལ་སོང་ནས།",
    "ཞེས་མཁའ་གསང་གི་ཧ་བརྒྱད་ཡེ་ཤེས་ཀྱི་འོད་དང་བཅས་པ་སེམས་དཔའ་བརྒྱད་ཀྱི་གཙག་ཏ་ཐིམ་པ་ལས་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་ད་འབར་ཞིང་གནས་པ་ལ་ཀ་རི་ལ་སོགས་བརྒྱད་བསྐྱེད་པའི་ལང་ཚིག་གིས་བསྐལ་ཞིང་སོ་སོའི་སྔགས་ཀྱིས་ཀ་རི་བརྒྱད་རིམ་བཞིན་ཕྱིའི་དཀྱིལ་འཁོར་དང་ནང་གི་ལས་ལའང་གསལ་བར་བསྒོམ།",
    "དེ་བཞིན་ད་ཧེ་བརྒྱད་སེམས་མ་བརྒྱད་ཀྱི་གཙག་ཏ་ཐིམ་ནས་སེང་ཧ་ལ་སོགས་པ་བརྒྱད་ད་གསལ་བ་དང་ཕཊ་བཞི་སྒོ་མ་བཞིར་ཐིམ་ནས་ཁྲོ་བོའི་སྒོ་མར་གསལ་བ་དེ་གཉིས་ཀྱང་ཕྱི་ནང་ད་བསྒོམ་མོ།",
    "སྒོ་མ་གནས་མ་བསྒྱུར་བར་སྒོ་བཞི་ན་བཞགས་ཏེ་སྒོ་སྲང་གི་ལས་མཛད་པར་བསམ།",
    "དེ་ནས་གོང་གི།",
    "དེས་རྒྱལ་པོ་ཨ་ར་ཤ་ནེ་དང་ཀླའི་བ་མོ་རྒྱ་མཚོ་མ་ལ་བསྟན།",
    "དེས་རྒྱལ་པོ་ཨིནྡྲ་བོ་དྷཱི་དེས་དགེ་སློང་སོ་ཀྱ་དེ་བ་དང་བལ་མོ་མངྒ་སི་ཏི་ལ་བསྟན།",
    "ཚལ་རིག་གོམ་པའི་བློ་དག་གིས།",
    "དེ་ལྟར་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་མཉེས་པར་བྱེད་པའི་ཡན་ལག་སྤྱན་དྲང་བ་ནས་བཟའ་བཏང་ཡན་ཆད་ཀྱི་བར་དེ་དག་ལ་དོན་གསལ་འདེབས་པའི་ལང་གི་ཚིག་དང་ཐགས་དམ་བསྐལ་ཞིང་བྱིན་གྱིས་རློབས་པའི་སྔགས་དང་མཚོན་པའི་བརྡ་ཕྱག་རྒྱ་དང་གནས་སྐབས་དེའི་དམིགས་པ་གསལ་བའི་ཏིང་འཛིན་ཏེ་གསང་སྔགས་ལང་གི་སྒོ་བཞིར་གྲགས་པ་བཞིན་ད་ཅི་རིགས་པར་སྦྱར་ཏེ་དེ་དག་གི་ཚལ་ནི་འགྲེལ་པ་ལས་ཤེས་པར་བྱའོ།",
    "དང་པོ་ལ་མཚན་མེད་དང་མཚན་བཅས་གཉིས་ཀྱི་དང་པོ་སེམས་ཉིད་མ་བཅོས་པའི་ངང་ད་ཧ་རེ་རྩ་མ་གཡོས་མ་བསླད་པར་མཉམ་པ་ཉིད་ལ་ཐན་མཚམས་བཟང་བས།",
    "གཉིས་པ་ལ་ཐོག་མར་ཐང་སྐ་ལྟ་བའི་མིག་གི་རྟེན་ལ་ལེགས་པར་བལྟས་ནས་སེམས་བཟང་བས་དྲན་ཡིད་ངོར་ཤར་བ་ན།",
    "ཧཱུྃ་ཧ་ཧེ་ཕཊ་བྷྱོ་ཞེས་པས་མདན་ད་རྟེན་དང་བརྟེན་པར་བཅས་པའི་ཛབ་ཁང་དབྱེ་བ་དེ་དག་གི་ལྗགས་དང་ཐགས་ཀར་ཡང་སྔགས་ཕྲེང་གོང་ལྟར་བསྒོམ་མོ།",
    "སྒྲ་ཧ་ཅང་མི་ཆེ་མི་ཆང་ངག་མི་མྱར་མི་དལ་བར་ངག་གཞན་སྨྲ་ཞིང་གཡེང་བ་མིན་པར་གག་སྐྱེད་ཀླད་ཀོར་སོགས་ཡན་ལག་ཕྲ་མོ་ཡང་མ་ཉམས་པར་ཚེགས་པར་ཚང་ཞིང་ཡི་གེ་རྣམས་ཀྱི་སྐྱེ་གནས་དང་ང་རོ་ཚལ་བཞིན་ཟར་ཕྱིན་པར་གསལ་བ་དག་པར་བསྒྲག་པ་སྟེ་ཚལ་དེས་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་བསྐྱེད་པར་བྱའོ།",
    "ལྔ་པ་མཆ་བཙམ་ཞིང་ལྕེ་ཡ་རྐན་ལ་གཏད་དེ་གཅོམ་ཆང་བའི་གདངས་ཀྱིས་རྔ་མོ་བ་སྟོར་བ་ལྟར་མཁན་ཞིང་གདང་བའི་ཚལ་ད་བཟླས་བརྗོད་བསྲིང་ལ་བྱ་སྟེ།",
    "སྔོན་ཚངས་པར་དང་གི་ཐོར་ཚགས་ཅན་དང་གནོད་སྦྱིན་རྒོད་མ་ཁ་གཉིས་བཏལ་ཞིང་རྡལ་ད་བརླག་པ་དེ་བཞིན་ད་གང་གནོད་བྱེད་རྣམས་ཐལ་བ་རྡལ་ད་བརླག་པར་བསམ་པས་གནོད་བྱེད་ཀན་རྡལ་ད་བརླག་པར་འགྱར་རོ།",
    "དེ་ལྟར་མན་ངག་གིས་དས་བཞི་དང་སྦྱར་བར་བྱའོ།",
    "ལྷ་བསྒོམ་ཞིང་སྔགས་བཟླས་པའི་མཐས་ཉོན་མོངས་དང་ཤེས་བྱའི་སྒྲིབ་པས་བསྡུས་པའི་སྒྲིབ་པ་ཐམས་ཅད་ཚེ་འདི་ཉིད་ལ་སྦྱོར་བར་བྱེད་པས་ན་ར་ལ་འདི་ནི་སྒྲིབ་པ་སྤོང་བ་དང་།",
    "དང་པོ་དཀྱིལ་འཁོར་ད་ཤེས་པ་ལ་བདག་གི་ཐགས་ཀའི་ར་ལ་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་སྣོད་ལ་ཕོག་པས་ཕྱི་སྣོད་ཀྱི་འཇིག་རྟེན་དྭངས་མ་ཡམ་ལྔའི་ཀློང་ད་དར་ཁྲོད་ཆེན་པོའི་གཞལ་ཡས་ཁང་ཟླ་གམ་སྨུག་ནག་འབར་བ་རྒྱན་དང་བཀོད་པ་ཡོངས་ས་རྫོགས་པ་ཞིག་ཏ་སྐྱེ་མེད་ཀྱི་དབྱིངས་ལས་འབྲས་བ་སྐྱེ་བའི་ཆོ་འཕྲལ་འགགས་པར་སྣང་བ་ཉིད་ལང་ཚིག་དང་ར་ལས་གསལ་བཏབ།",
    "ཚར་འདས་པས་བདག་གི་སྒྲིབ་པ་སྦྱངས་ཤིང་དངོས་གྲབ་ཐོབ་པར་བསམ་པ་སྟེ་ཚལ་དེའི་ལང་ཚིག་བཞིན་ནོ།",
    "ལས་ལས་གྲབ་པའི་མཁའ་འགྲོ་མ་རྣམས་ཀྱི་སྐ་མི་བསྡུ་བར་འོད་ཟེར་དང་ཡོན་ཏན་བསྡུས་པ་ཐན་མོང་ཆང་ངའི་དངོས་གྲབ་བོ།",
    "ལང་ཚིག་གིས་གསལ་བཏབ་ཅིང་ཐགས་དམ་བསྐལ་བར་བྱ་བ་སོགས་བསྙེན་སྒྲུབ་ཀྱི་སྐབས་ས་རྒྱས་འབྲིང་ཅི་རིགས་ས་བྱ་ཞིང་།",
    "གཞན་ཡང་ཚོགས་སྒྲུབ་ཀྱི་ཐོག་མ་ནས་ཐ་མ་དངོས་གྲབ་བླང་བའི་བར་ད་སྦྱར་བ་དང་ལམ་ལྔ་ཡོངས་རྫོགས་ལ་སྦྱར་བ་སོགས་སྣ་ཚོགས་ཡོད་ཅིང་།",
    "སོ་སོར་ཡང་རྒྱ་འབྲས་ཀྱི་ཚལ་ད་གཉིས་རེ་ཕྱེ་བས་བཞིར་འགྱར་བས་སྤྱིར་ལམ་གྱི་འགྲོས་ཆེ་ཞིང་ལྷ་བསྒྲུབ་པའི་ཁོག་ཕབ་ཀྱི་ཆིངས་ཡིན་ནོ།",
    "དང་པོ་བསྙེན་པར་བྱ་བའི་དས་རིང་ཐང་གི་ཚད་དེ།",
    "ཟླ་གསང་ཐིག་ལེ་དང་རྟག་ཆེན་གཡབ་མོ་ལ་སོགས་པ་ནས་འབྱང་བ་དང་།",
    "འཆག་དས་རྒྱལ་པོའམ་རྒྱལ་ཐེབ་རེས་ད་རང་གཉག་མར་འགྲོ་བ་རེ་ལ་སྲང་བ་རེ་བྱ།",
    "ཡང་འོང་བ་རེ་ལ་བདད་རྩི་འཁྱིལ་པའི་སྔགས་ཀྱིས་མཚམས་བཅད།",
    "མོས་པའི་ཐགས་ལ་མཉེས་བསམ་ནས།",
    "བརྟན་པར་རེད་ནས་མཁའ་ལ་བཞག།",
    "འབྲིང་ལྷ་ལ་བརྟེན་ནས་ཐན་མོང་གི་གྲབ་པ་ཐོབ་པས་དགའ་ལྡན་གྱི་ལྷའི་གནས་ནས་ལྷ་མོ་པཎ་ཙི་ཀ་དགག་པའམ་རྒྱ་མཚོའི་གཏིང་ནས་ཀླའི་བ་མོ་ཡིད་འོང་དགག་པ་སོགས་ལྷ་ཀླ་གནོད་སྦྱིན་བ་མོ་དགག་པ་དང་།",
    "ཡིད་རང་བྱང་ཡེ་ཤེས་སེམས་མ་དང་ལྡན་པ་འདོད་ཁམས་ཏེ་ཕྱག་རྒྱ་མོའི་ལས་ངག་ཡིད་གསམ་གྱི་ཁམས་གསམ་ལ་ཁྲག་ཏ་དམིགས་ཞེས་པ་ཁྲག་ནི་རླན་ཅིང་དམར་བའི་ངོ་བོས་ཆགས་པའི་བརྡ་སྟེ།",
    "ཕྱིའི་དར་ཁྲོད་དང་ནང་གི་ལས་གནས་བརྒྱད་དང་གསང་བ་ཚོགས་བརྒྱད་དེ་ཕྱི་ནང་གསང་བའི་དར་ཁྲོད་ཀན་ཏ་ཡེ་ཤེས་ཀྱི་སྒྱུ་འཕྲལ་དྲྭ་བས་ཁྱབ་པར་བསམ་པ་སྟེ།",
    "འབྲིང་ལས་ཕྲད་དེ་ལག་པས་རེག་ཅིང་འོ་བྱས་པས་སམ།",
    "དངོས་གཞི་ལྷའི་སྐ་གསང་ཐགས་ཀྱི་ཕྱག་རྒྱས་བཏབ་པའི་བྱིན་གྱིས་བརླབས་པའི་མཐ་དང་རླང་སེམས་དབ་མར་འཆིང་བའི་ཆགས་ལམ་གྱི་མན་ངག་ཟབ་མོའི་ཐབས་ཀྱི་སྟོབས་དང་།",
    "ཚལ་དེ་ལྟ་བ་རང་སྣང་ཏིང་ངེ་འཛིན་གྱི་སྤྱོད་ཡལ་ཉམས་བག་རྙེད་པའི་སྒོ་ནས་ཕྱི་ནང་གསང་བའི་དགྲ་སོད་ཅིང་བདད་བཞི་བཅོམ་ལ་འགྲོ་དྲག་གི་གཡེང་བ་རྩལ་གྱིས་ཆོད་པར་ཤེས་པར་བྱ་སྟེ།",
    "སྦྱོར་བའི་ཚལ་འདི་ལྟ་བའི་སྔགས་ཀྱི་བརྟལ་ཞགས་ཟབ་མོ་དས་ས་བབས་ཀྱང་དང་ད་མ་བླང་ན་མ་ཧཱ་ཡོ་གའི་དམ་ཚིག་ཉམས།",
    "ནང་ལྟར་ན་དོན་དབྱིངས་དང་ཡེ་ཤེས་ལ་དམིགས་ནས་རྟགས་ཐབས་ཤེས་ཟང་ད་འབྲེལ་ཞིང་ཕྱག་རྒྱ་བཞིས་རྒྱས་གདབ་སྟེ་བསྟེན་བསྒྲུབ་པ་བཞིའི་ཚལ་གྱིས་ཕང་ཁམས་ལྷ་དང་ལྷ་མོར་གནས་པའི་སྒོ་ནས་རང་གཞན་གྱི་དོན་བྱེད་པས་ཐ་མལ་གྱི་མཚན་རྟོག་བསྒྲལ་ལོ།",
    "མཐས་བསྒྲལ་བ་ལ་ནི་ཡལ་ཞིང་བཅ་ལ་བྱ་སྟེ་གང་གིས་བསྒྲལ་ན་གསང་བའི་དྲག་སྔགས་དང་དམོད་པའི་དྲག་སྔགས་གཉིས་ཀྱིས་བསྒྲོལ་ལ།",
    "གསང་བའི་དྲག་སྔགས་ལ་ཕྱི་ནང་གསང་བ་གསམ་གྱི་ཕྱི་ལྟར་དཔལ་ཆེན་པོས་དཔལ་བཏགས་པའི་སྲིན་མོ་ཀ་རི་བརྒྱད་དམ་དར་ཁྲོད་ཀྱི་མ་མོ་རོ་ག་མ་བཞི་ལ་བསྙེན་པ་ཕལ་ཏེ་དྲག་པོའི་ཐན་ཟོར་བཅས་ནས་དམོད་སྔགས་ཀྱིས་བསྒྲལ་བའམ།",
    "ནང་ལྟར་དཔལ་ཆེན་ཡབ་ཡམ་ལ་མ་མོ་ཀ་སེང་གིས་བསྐོར་བ་ལ་བསྙེན་པ་ཕལ་ཏེ་མ་མོ་ཉིང་ཁོལ་གྱི་དྲག་སྔགས་ཀྱིས་བསྒྲལ་ཏེ་མནན་པ་ཡན་ཆད་བྱ་བའམ།",
    "བསེ་བའི་ལྷ་མོ་བཞིས་བསྐོར་བ་བསྙེན་ཏེ་ཕར་ཐན་གྱི་བསྒྲལ་བའམ།",
    "གསང་བའི་སྒྲུབ་པ་ལ་སྒྲུབ་མཐས་བསྒྲལ་བ་དང་གནས་སྦྱོང་གི་དགོངས་པ་གཉིས་ལས།",
    "གནས་སྦྱངས་ནི་ཡབ་ཡམ་གྱི་ཐགས་ཀ་དང་མཁའ་གསང་ནས་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་དང་ཁྲོ་བོ་ཁྲོ་མོའི་ཚོགས་འཕྲོས་པས་གཟས་པ་པོའི་ཤེས་པ་དགག།",
    "ཡཾ་ལས་རླང་གི་དཀྱིལ་འཁོར་གྱི་སྟེང་ད་བཞག་ལ་ཕཊ་ཀྱིས་འོག་མིན་རང་བཞིན་གྲབ་པའི་གནས་ས་ཧེ་ར་ཀ་རིགས་ལྔ་ཡབ་ཡམ་གྱི་སྦྱོར་མཚམས་ས་འཕང་ལ་དེ་བཞིན་གཤེགས་པའི་སྲས་ས་བསྐྱེད་པར་བྱའོ།",
    "ཐ་མ་ལ་གཅིག་གིས་བསྟན་ཏེ།",
    "མཆོག་ཏ་འཕགས་པའི་ཤེས་རབ་ཟབ་མོས་དོན་དམ་པར་བསྒྲལ་བྱ་སྒྲོལ་བྱེད་ཅི་ཡང་མི་དམིགས་པར་རྟོགས་པས་ཐ་མལ་གྱི་ཞེ་སྡང་ལ་སོགས་པ་རྩད་ནས་ཕྱང་ཞིང་།",
    "གོང་ད་སྨོས་པའི་བཀྲ་ཤིས་གཙང་མའི་རྫས་སོགས་བམ་གསམ་པོ་ལ་རིགས་དྲག་གི་ཤེས་པ་བསྟིམ་ཞིང་།",
    "ཞིང་གི་དངོས་པོ་སྒྲུབ་པའི་རྫས་དེ་དག་དངོས་ས་དཀྱིལ་འཁོར་གྱི་རྩལ་དགག་ལ་བསྒྲལ་བའི་རྫས་ས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "དེ་ཡང་རྒྱད་ལས་བྱ་ལ་སོགས་པ་བསྒྲལ་བའི་རྒྱ་དག་ཏ་གསངས་པ་ཡང་སྡིག་མེད་ཀྱི་ཤ་ཁྲག་ལ་མཆོད་སྟོན་བྱ་བར་གསངས་པ་བཞིན་རྣལ་འབྱོར་པའི་ཤེར་ཏིང་གི་ཉམས་དང་མ་ལྡན་ན་ཤིན་ཏ་ཉེན་ཆེ་སྟེ་རྣམ་སྨིན་མི་བཟློག་པས་གཟབ་པར་བྱའོ།",
    "དེ་ལ་ཀརྨ་དང་སྒྲོལ་གིང་གིས་སྒྲུབ་རྫས་དེ་དག་བཟང་ལ་མཁྱེན་པར་གསོལ་ཞིང་ཁེ་ཉེན་གྱི་ཚལ་དང་བཅས་པའི་སྒོ་ནས་བསྒྲལ་བ་ལ་བསྐལ་བའི་ཚིག་ཞ་ཞིང་།",
    "དེ་ནས་བསྒྲལ་བྱའི་དངོས་པོ་ནི་ཁོ་རང་གི་དྲོད་དབགས་རླན་ལས།",
    "བྱང་ཆབ་སེམས་ཀྱི་རང་བཞིན་དེ་ལས་འོད་ཟེར་ཕྱོགས་བཅར་འཕྲོ་ཞིང་ཁྱབ་པས་གཉིས་མེད་ཀྱི་བདེ་བ་མོས་པའི་ཚལ་གྱིས་ཁ་སྦྱོར་དང་ལྡན་པར་བཞགས་པ།",
    "དེ་ལྟར་མ་སྒྲོལ་ན་ཡང་རྒྱ་དེ་ལ་མྱོས་ཆང་བླད་ལ་ཡང་དག་གི་སྲང་མ་བཞི་ལ་ཕད་བཏབ།",
    "གིང་གིས་རྒྱ་ཤགས་སྒྲོལ་གྱི་སྔགས་གོང་ད་བསྙེན་པ་བྱས་པ་དེ་བཏབ་པ་ལ་བསྒྲལ་ལོ།",
    "གིང་གིས་འགྲེང་ཞིང་རྡོ་རྗེ་ཁར་ཚར་དཀ་གཡས་གཡོན་ད་བརྟེན་ཕྱོགས་བཅར་བལྟ་ཞིང་ཧཱུྃ།",
    "དར་ཁྲོད་ཆེན་པོ་གདལ་བ་དང་སོགས་བརྗོད་ཅིང་སྡང་མིག་གིས་ཕྱོགས་བཅར་བལྟ་ཞིང་།",
    "ཞེས་པ་ལ་སོགས་པ་བརྗོད་ཅིང་འགྱིང་བག་གི་སྟབས་ཀྱིས་ལན་གཅིག་བསྡིགས་ནས་རྒྱ་དེ་གན་རྐྱལ་ད་བཞག་པ་ཁྲོ་བཅའི་སྔགས་དང་ཕྱག་རྒྱ་བྱ་ཞིང་ཐབས་ཞགས་ནས་འབྱང་བའི་བསྐལ་པ་མེ་ལྟར་འབར་བའི་ཞེས་སོགས་ཀྱིས་སྟངས་སྟབས་ཟིལ་གནོན་གྱིས་སྒྲིབ་པ་སྦྱངས་ཤིང་དགྲ་བགེགས་འདལ་སྦྱོངས་བྱས་ལ།",
    "ཞེས་སོགས་བརྗོད་ཅིང་པྲ་ཝེ་ཤ་ཡ་ཕཊ་ཅེས་སྒོ་དབྱེ་ཞིང་ལག་གཡས་སོར་མོ་ལྔ་ཟླ་བའི་དལ་རེའི་སྟེང་ན་དཔའ་བོ་འབྲ་ལྔ་འོད་ཟེར་ཁ་དོག་ལྔ་དང་ལྡན་པས་རྒྱའི་ཙིཏྟ་ནས་བཟང་སྟེ་ཕྱང་ཙམ་ན་ཙིཏྟའི་ནང་ན་ཡི་གེ་ཏི་དད་ཁ་བཅས་པ་ཕྱངས་ཏེ་དག་གསམ་རྩད་བཅད།",
    "ཁམས་གསམ་གནས་ནས་དྲངས་པར་བསམ་པའི་གིང་གི་དགོངས་ཉམས་དང་སྦྱར་ཏེ་སློབ་དཔོན་ལ་ཕལ།",
    "སློབ་དཔོན་གྱིས་བན་ྡྷའི་ནང་ད་བཅག་པའི་སྲོག་རྩ་ཞལ་ད་གཞིབས་པས་ཙིཏྟའི་དཀྱིལ་ན་སེམས་ཀྱི་རང་བཞིན་ཏི་དད་ཁར་གནས་པ་དེ་རང་གི་ཐགས་ཀའི་ཧཱུྃ་གི་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་གྱིས་བསྲེག་སྟེ་ཧཱུྃ་དཀར་པོ་གཅིག་ཏ་གྱར་པར་བསམས་ལ།",
    "དབགས་འཕར་ཞིང་ཤམ་གྲང་གི་བར་དེར་ཀན་དགོངས་པ་གཅིག་ཏ་དྲིལ་ནས་དེ་ལྟར་བྱའོ།",
    "དེ་ནས་ཧཱུྃ་དེ་རང་གི་ཧཱུྃ་ལ་བསྟིམས་པས་ཚེའི་མཐད་མར་བྱིན་གྱིས་བརླབས།",
    "དེ་ནས་ཐགས་ཀའི་ཧཱུྃ་ལས་སླར་ཧཱུྃ་དེ་ཧཱུྃ་ཞེས་པའི་གདངས་ཀྱིས་སྣའི་རྩེ་མོར་དྲངས་ཏེ།",
    "དེ་ནས་ཡ་ལས་རླང་དཀྱིལ་ད་གྱར་པས་བཏེགས་ནས་སྟོང་ཚིག་གི་གསལ་འདེབས་དང་བཅས་པས་རང་བཞིན་ལྷན་གྱིས་གྲབ་པའི་འོག་མིན་གྱི་གནས་ན་ཞི་ཁྲོ་རབ་འབྱམས་ཀྱི་ལྷ་ཚོགས་བཞགས་པའི་ཡབ་ཡམ་ཐབས་ཤེས་ཟང་ད་འབྲེལ་བའི་སྦྱོར་མཚམས་ཀྱི་མཁའ་ལ་བསྟིམས་ནས་དེ་བཞིན་གཤེགས་པའི་སྲས་ས་བསྐྱེད་དེ་བཞག་གོ།",
    "དཀྱིལ་འཁོར་གྱི་ཕྱོགས་བཞིར་རེས་མོས་ས་བཞག་ལ་ཕྱོགས་བཞིར་བྲོ་ཆེན་པོ་བཞིས་སྦྱངས།",
    "གདལ་བྱའི་ལས་ངན་རྒྱན་གཅོད་པར་ངེས་པའི་རྟོགས་པ་གདེངས་ས་གྱར་པའི་སྒོ་ནས་བསྒྲལ་བས་འབྲས་བ་འཚེང་བ་གསམ་ལྡན་ད་གྲབ་པ་དེ་ནི་སྔགས་ཀྱི་སྤྱོད་པ་ཀན་གྱི་ཟབ་མོ་མཐར་ཐག་པ་ཡིན་པས།",
    "དས་ལ་བབས་ཀྱང་དང་ད་མ་བླང་ན་སྔགས་ཀྱི་དམ་ཚིག་ཉམས་གདལ་བྱའི་ལས་ངན་རྒྱན་མི་ཆོད་བདག་གི་དངོས་གྲབ་མི་འགྲབ་པ་སོགས་སྐྱོན་ཡོད་ལ།",
    "ཁྱད་པར་ད་བསྙེན་པ་ནས་དངོས་གྲབ་ཐོབ་ཀྱི་བར་ད་གླགས་བལྟ་བའི་བགེགས་ཆེན་པོ་དྲག་སྟེ་ཉི་ཤར་ཉིན་ཕྱེད་དགང་མོ་གསམ་དང་སྲོད་དང་མཚན་ཕྱེད་ཐོ་རེངས་གསམ་སྟེ།",
    "དས་དྲག་ཏ་རྒྱ་བའི་ཉལ་ལེ་མ་དྲག་ལ་རང་རང་གི་འདལ་སྐལ་གཉེན་པོའི་ཕོ་ཉ་བསྐལ་བས་བཟློག་ཅིང་།",
    "རེ་དང་དོགས་དང་དགའ་བ་ཡི།",
    "དངོས་གྲབ་སྦྱིན་པར་མཛད་པའི་ཡེ་ཤེས་ལྷའི་གཟགས་ཅན་ནམ་མཚན་མ་བྱང་བ་ལ་ཡང་དངོས་གྲབ་ཐོབ་པ་ཡིན་ནོ་སྙམ་ད་རེ་བ་དང་མི་ཐོབ་པར་བར་ཆད་ད་དོགས་པ་དང་ཐོབ་པར་འགྱར་རམ་སྙམ་ད་དགའ་བ་ཡི་སེམས་དང་།",
    "བགེགས་ཡིན་ཀྱང་སྔགས་བསྒྲུབ་པ་ལ་འགྱར་སྲིད་མོད།",
    "དེ་ཡང་ཕྱིའི་མཚན་མ་ཁོ་ན་ལ་གཙོ་བོར་མི་འདོན་པར་རྣལ་འབྱོར་པ་ནང་གི་ཉམས་ཟབ་མོ་ཉིད་ཀྱི་ཕྱག་རྒྱ་སྟེ་མི་འཆགས་པར་བྱ་བའི་རྒྱས་རང་གི་བསྒྲུབ་བྱའི་དོན་གྲབ་བམ་མ་གྲབ་སད་པར་བྱས་ནས་ངོས་ཟིན་པར་བྱའོ།",
    "ཁྲོ་ཞིང་འཚིག་པ་གཟའི་བ་མོའི་ལྟས་དང་བསྒྲུབ་པ་ཉམས་ཆང་ཞིང་བྱིང་བྱིང་བྱེད་ནས་འོག་ནས་དམ་སྲི་མནའ་ཟན་འོང་བའི་ལྟས་དང་།",
    "དེ་ཡང་བསྙེན་བསྒྲུབ་གཞང་བསྲང་བས་སྐ་ཡི་རྟགས་ལྷ་ཞལ་མཐོང་བ་ངག་ལ་ནས་པ་འབྱང་བ་གསང་གི་རྟགས་ས་རཀྟ་ཁོལ་མ།",
    "སླར་བདག་ཉིད་ཀྱི་གནས་ས་འགྲོ་སྙམ་ད་མཛབ་མོ་བཀག་པས་རང་གནས་ས་ཕྱིན་ན་དངོས་གྲབ་གྲབ་པས་རང་དོན་གྲབ་པ་ཡིན་པར་ཤེས་པ་དེ་ལྟ་བའི་མཚོན་ནས་མཚན་མ་རབ་འབྲིང་ཐ་མ་གང་བྱང་ཀྱང་ནང་གི་དྲོད་ཚད་དང་ཕྱག་རྒྱ་བཅའ་བ་སོགས་ཀྱི་སྒོ་ནས་རང་དོན་གྲབ་པའམ་རང་ལ་ཕན་པའི་དངོས་པོར་གྲབ་མ་གྲབ་ཉམས་སད་པར་བྱས་ནས།",
    "གལ་ཏེ་རང་དོན་མ་གྲབ་པར་བགེགས་ཀྱི་མཚན་མ་ཡིན་ན་ནི་བར་ད་གཅོད་པའི་འབྱང་པོ་དེ་དག་ལིངྒ་ལ་ཡེ་ཤེས་ཀྱི་ཕོ་ཉ་དང་ལས་ལས་གྲབ་པའི་ཕོ་ཉ་དང་རང་གི་སྲང་མ་སོགས་རང་དང་འབྲེལ་བའི་ཕོ་ཉ་སྟེ་ཕོ་ཉ་གསམ་བཀྱེས་ལ་དགག་བསྟིམ་དྲག་ཏ་བྱ་ཞིང་།",
    "སྐྱ་རེངས་འཆར་བའི་བར་ད་བསྒྲུབ།",
    "ཅེས་གསངས་ཏེ་རྡོ་རྗེ་སེམས་དཔའ་མཆོག་གི་སྟོན་པས་བསྟན་པའི་ལང་ཧེ་ར་ཀའི་གལྤོ་ལ་སོགས་པ་ལས་ལས་དང་པོ་པ་དང་ནས་པ་རྙེད་པ་དང་མཚན་མ་མཐོང་བའི་རྣལ་འབྱོར་གསམ་གྱི་དགོངས་པའི་དས་དང་གྲངས་དང་མཚན་མའི་བསྙེན་པ་རྣམ་གསམ་བྱ་བར་གསངས་པ་ལ་སོགས་པ་བཞིན་ད།",
    "ཞག་ཇི་ཙམ་ཞིག་ཏ་བསྙེན་པར་གསང་དས་ཀྱི་ཚད་དམ་གྲངས་འདི་ཙམ་ཞིག་དག་གིས་བསྙེན་པ་རྫོགས་སོ་ཞེས་གསང་པའི་དས་ནི་བརྟག་སྟེ་དེ་ལྟ་ན་གྲབ་པ་ན་དངོས་གྲབ་ལེན་པའམ།",
    "དས་ཡན་རིང་ཐང་ལ་མ་ལྟོས་པར་དངོས་གྲབ་གྲབ་པའི་མཚན་མ་བརྟན་པོ་སྟེ་མ་ངེས་པའི་རྟགས་ཙམ་མིན་པར་ངེས་པར་བྱང་བ་ན་གྲོགས་རིགས་ངན་གྱི་བ་མོ་གཞོན་ན་མཚན་ལྡན་གཉིས་དང་བཅས་པས་དངོས་གྲབ་སྒྲུབ་པའི་ཆོ་གའམ་སྒྲུབ་པ་ཆེན་པོ་ཕྱི་ནང་གསང་བའི་ཚལ་ད་ཚལ་བཞིན་བརྩམ་པར་བྱའོ།",
    "ཞག་དེའི་ཉི་མ་ནབ་ཅིང་དམར་ཐག་ཆད་ནས་ནི་བརྩལ་ཏེ་སྐྱ་རེངས་འཆར་བའི་བར་གྱི་མཚན་མའི་ཐན་དེ་དག་ཏ་དངོས་གྲབ་བསྒྲུབ་པར་བྱ་བ་ནི་ཕྱི་ལྟར་དང་།",
    "ཡབ་ཀྱི་ལས་སྟོབས་དང་ལྡན་པ་རྡོ་རྗེ་རིན་ཆེན་རྒྱས་ཏེ་ཁ་བ་འདོན་ནས་པ་སྐྱ་རེངས་འཆར་བ་ཞེས་བྱ་སྟེ།",
    "གསང་བ་རྡོ་རྗེ་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་ཉོན་མོངས་རྒྱན་ཆད་དེ་ཉི་མ་ནབ་པ་ལྟར་ལ་སྐ་དང་ཡེ་ཤེས་ཀྱི་ཏིང་ངེ་འཛིན་གྱི་ཉམས་རྙེད་པ་ལ་སྐྱ་རེངས་འཆར་ཞེས་བྱ་བའོ།",
    "ཧཱུྃ་ཞེས་རཀྟ་ལན་གཅིག་གཟིང་བས་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་གྱི་རྩེ་ལས་ལྕགས་ཀྱ་མང་པོ་འཕྲོས་པས་གཙོ་བོ་ཡབ་ཡམ་ལ་སོགས་པ་གང་གི་དངོས་གྲབ་བླང་བར་བྱ་བ་དེ་མདན་གྱི་བན་ྡྷའི་རཀྟའི་འོད་ལ་བསྟིམ་པས་སྐ་གསང་ཐགས་ཀྱི་དཀྱིལ་འཁོར་འོད་ད་ཞ་ནས་ལྟེམ་མེར་གནས་པར་བསམ་པ་ཧཱུྃ་བར་པའི་བར་མའི་དགོངས་པའོ།",
    "དེ་ལྟར་ལྷ་ལ་བསྟོད་ཅིང་བསྙེན་པ་དབལ་ལ་མཆོད་ཅིང་གསོལ་བ་གདབ་པ་བྱས་ནས་ཚལ་དེ་ཉིད་ཀྱིས་དངོས་གྲབ་བསྡུས་ཏེ་སྐ་གསང་ཐགས་ཀྱི་ས་བོན་གྱི་རྣམ་པས་བདག་ལ་བསྟིམ་པ་ནི་ཧཱུྃ་བར་མ་གསམ་གྱི་དགོངས་པ་སྟེ་ལྷ་སོ་སོ་རེ་རེ་ནས་དངོས་གྲབ་ལེན་པའི་ཚལ་བར་ད་བྱའོ།",
    "དེ་ནས་སྒྲུབ་པོ་ཀན་བཞེངས་ལ་དལ་ད་བཀོད་པའི་རྫས་ཐམས་ཅད་ཨ་མྲྀ་ཏའི་སྔགས་ཀྱིས་བདད་རྩི་ཆེན་པོའི་རང་བཞིན་ད་འདོད་ཡོན་ལྔར་བརླབས་པ།",
    "དེ་ཡན་ཆད་མཆོག་གི་དངོས་གྲབ་བླང་བ་དང་ཐན་མོང་གིས་རྫས་ཅི་རིགས་བཤམས་པ་ཀན་ལས་ཀྱང་དངོས་གྲབ་བླང་ངོ།",
    "དེ་བཞིན་ད་མར་མེ་རྡོར་དྲིལ་ལའང་སོ་སོའི་དངོས་གྲབ་ལེན་པའི་ཚིག་གིས་དངོས་གྲབ་བླང་བ་ནི་ཧཱུྃ་ཐ་མ་གསམ་གྱི་དགོངས་པ་སྟེ་ལྷ་སྤྱིའི་སྐ་གསང་ཐགས་ཀྱི་དངོས་གྲབ་རྫོགས་པར་བླང་བའི་ཐ་མར་བྱ་བའོ།",
    "སླར་ཧཱུྃ་སོགས་བརྗོད་པས་དཀྱིལ་འཁོར་གྱི་ལྷ་རྫོགས་པར་བདག་ལ་བསྒོམ་སྟེ་སྒྲུབ་རྫས་དེ་ལས་དངོས་གྲབ་བདག་གིས་བླང་བ།",
    "དར་ཁྲོད་གསང་བ་མཆོག་གི་བདག་པོ་ནི།",
    "རིགས་ཀྱི་བ་ཁྱོད་ཀྱིས་སོགས་བརྗོད་ཅིང་དམ་ལ་བཞག།",
    "བདག་གི་ཧཱུྃ་ལས་དཔའ་བོ་འབྲ་ལྔ་འཕྲོས་པ་བམ་པའི་བདད་རྩི་ལ་བབས་པས་བདད་རྩི་ལྔ་དང་དཔའ་བོ་འབྲ་ལྔར་གྱར་འབྲ་ལྔ་ཕྱག་མཚན་ལྔ་དང་དེ་ལས་རིགས་ལྔ་ཁྲག་འཐང་གི་སྐར་གྱར་ཏེ་སྐ་ཚོན་གང་བ་རེ་གནས་ལྔར་བསྟིམ་པས་རིགས་ལྔར་གྱར་པར་བསམས་ལ།",
    "སྦྱིན་སྲེག་བྱ་བ་ལས་བཞི་གང་མོས་སམ་ཟླ་གམ་དམར་པོའི་ཐབས་ལ་བད་ཤིང་བརྩིགས་ནས་མཆོད་རྫས་རྣམ་ལྔ་དང་གཏོར་མ།",
    "ལས་གྲབ་པའི་རྫས་གང་ལ་བྱ་བའི་མིང་གཟགས་དང་སྡིག་སྦྱང་གི་རྫས་ཏིལ།",
    "ཡམ་ཤིང་ལ་ཚིལ་ཆེན་གྱིས་བྱག་སྟེ་དབས་ཀྱི་མར་མེ་ལས་མེ་བླངས་ཏེ་ཐབ་ཏ་བཅག་ནས་རང་དཔལ་ཆེན་པོའི་ཐགས་ཀར་ར་དམར་སེར་འོད་དང་བཅས་པ་ཐབ་ཁང་ད་གསལ་བ་མེའི་རིལ་བ་གཅིག་ཏ་གྱར་པ་ལས་དམ་ཚིག་གི་མེ་ལྷ་བསྐྱེད།",
    "དེ་ནས་ཚིལ་ཆེན་གྱི་མར་ཁ་དང་གཏོར་མ་དང་ཡམ་ཤིང་དང་ཏིལ་རྣམས་སོ་སོའི་སྔགས་ཚིག་གིས་དབལ།",
    "ཚལ་དེས་ལྷ་མཉེས་པར་བྱེད་ཅིང་གཏང་རག་གི་ཚལ་ཡང་ཡིན་ལ།",
    "དང་པོ་རང་གི་ཐགས་ཀའི་ཧཱུྃ་གི་འོད་ཀྱིས་ལྷ་རྣམས་རང་རང་གི་ས་བོན་གྱི་རང་སྒྲ་དང་བཅས་ཏེ་བྱང་ཆབ་སེམས་ཀྱི་འོད་ད་ཞ་སྟེ་ཁྲོ་བཅ་སྒོ་མ་བཞི་ལ་ཐིམ།",
    "དེ་ནས་བྲོ་བརྡང་བ་ནི་གོང་ད་མ་སྲིང་རྒྱ་མཚོ་རྣམས་མཚན་མ་མེད་པའི་ངང་ད་བསྡུས་ཤིང་གཤེགས་པ་དེ་དག་སླར་བརྟེན་ཅིང་དགའ་བའི་ཕྱིར་ར་ལ་གར་གྱི་བྲོ་བརྡང་སྟེ་གླ་དྲག་བླངས་ལ་མ་སྲིང་མཁའ་འགྲོ་རྣམས་བརྟེན་པའི་ཚིག་བརྗོད་ཅིང་གླ་གར་རོལ་མོའི་རྩེད་འཇོ་སྣ་ཚོགས་བྱའོ།",
    "བདག་གིས་བླ་ན་མེད་པའི་བྱང་ཆབ་སོགས་བརྗོད་ཅིང་།",
    "དེ་དག་གི་ཚིག་དོན་བཞིན་ད་རྩེ་གཅིག་བསྔོ་བར་བྱའོ།",
    "བཞི་པ་མཇག་གི་དོན་ལ་མཛད་བྱང་ནི།",
    "བོད་ཀྱི་ལྷ་བཙད་པོ་ཁྲི་སྲོང་ལྡེའ་བཙན་གྱི་བཀའ་ལང་གིས་དཔལ་ནཱ་ལེནྡྲའི་གཙག་ལག་ཁང་ད།",
    "བཀའི་ཐ་རམ་ཆེན་པོ་འདི་སྣོད་དང་མི་ལྡན་པ་རྣམས་ལ་སྲོག་གི་ཕྱིར་ཡང་མི་སྦྱིན་ཞིང་།",
    "སྣོད་ལྡན་འགའ་ཟང་ལ་རིམ་པས་བཀའ་རྒྱས་གདམས་ཏེ་སྦྱིན་པར་བྱས་ན་དངོས་གྲབ་མཆོག་གི་རྒྱར་འགྱར་བའི་ཚལ་གསངས་པའི་དགོངས་དོན་བཞིན་ད།",
    "འཇམ་དཔལ་དགྱེས་པ་ཞེས་བྱ་བ་བདག་གིས་ལྟ་བ་གཏན་ཚིགས་ཀྱིས་བཤད།",
    "འདྲེན་མཆོག་རིག་འཛིན་གསང་གིས་བསྐལ་བ་ལས།",
    "རིག་འཛིན་ཧཱུྃ་གིས་བཞེད་པ་རིག་འཛིན་གྱིས།",
    "དམ་ཚིག་མཆོག་གི་དགྱེས་པས་འདིར་གཤེགས་ནས།",
    "མི་ཕམ་མཁས་པ་མཆོག་གིས་སྦྱར།",
    "གསང་བ་ཉེ་བརྒྱད་ཟབ་མོར་བྱོན།",
    "རང་རྒྱུད་ཀྱི་བློ་ཁ་ཕྱེ་བར་བྱས་ནས་སྔགས་ལ་མོས་པའི་གང་ཟག་དེ་ཡི་རྒྱུད་ངེས་པར་བརྟགས་ནས་གལ་ཏེ་བསྟན་པའི་སྣོད་དུ་གྱུར་པ་ཡིན་ན་དེ་ནི་ཇི་ལྟར་ས་གཞི་བཟང་པོ་ལོ་ཏོག་སོགས་ཀྱི་གཞི་རྟེན་ཡིན་པ་བཞིན་ཡོན་ཏན་གྱི་རྟེན་དུ་རུང་བ་དེ་ལ།",
    "དེ་ལྟ་མིན་པར་སྔགས་ཀྱི་སྤྱོད་པ་རྨད་བྱུང་ལ་ཡིད་སྤྲོ་བ་མེད་པས་བློ་ཞན་ཅིང་གསང་བ་ཟབ་མོའི་དོན་མི་ཤེས་པའི་ཤེས་རབ་ཆུང་བས་ནི།",
    "རང་གི་སྲོག་ལུས་མན་ཆད་ནས་དངོས་པོ་ཕལ་པ་ཡན་ཆོད་ཀྱི་གང་ཕོངས་པའི་རྫས་ཀྱི་དངོས་པོ་རྣམས།",
    "ཇི་ལྟར་འདོད་པ་བཞིན་དུ་ཡུམ་ཀུན་ཏུ་བཟང་མོའམ་ཀྲོ་དྷཱི་ཤྭ་རི་མར་བློས་སྦྱར་བར་བྱས་པས་ལུས་སྐུར་བྱིན་གྱིས་བརླབས།",
    "ཡབ་རྣམས་ཡབ་ལ་ཐིམ་པས་རྡོ་རྗེ་རྒྱལ་པོ་དང་ཡུམ་རྣམས་ཡུམ་ལ་ཐིམ་པའི་གཟུངས་མ་ནི་རྡོ་རྗེ་རྒྱལ་མོ་ཀྲོ་དྷཱི་ཤྭ་རི་མའམ་ཀུན་ཏུ་བཟང་མོར་བྱིན་གྱིས་བརླབ་པར་བྱས་པ།",
    "བསྐྱེད་རྫོས་ཀྱི་དོན་ཀུན་དང་ཁྱད་པར་སེམས་ཉིད་རང་བྱུང་གི་ཡེ་ཤེས་ཇི་བཞིན་ཉམས་སུ་མྱོང་བ་ནི།",
    "དམ་རྫས་ཐམས་ཅད་ལ་བློ་ཐ་མལ་གྱི་ཁུ་འཁྲིག་སྤང་ཞིང་སྦྱོར་སྒྲོལ་གྱི་བརྟུལ་ཞུགས་ཟབ་མོ་དང་དུ་ལེན་པའི་དམ་ཚིག་ཆེན་པོས་བདེ་བར་གནས་པའི་སྒོ་ནས་གྲུབ་འབྲས་མངོན་དུ་བྱའོ།",
    "སེམས་ཀྱི་རང་བཞིན་ནི་ཡི་གེ་ཨ་དཀར་པོའི་རྣམ་པ་ཅན་གྱི་རྒྱུ་ཏིང་གི་ཡེ་ཤེས་སུ་གསལ་བར་བྱའོ།",
    "བྷྲཱུྃ་ལས་འོད་ཟེར་གྱི་ཚུལ་དུ་བྷྲཱུྃ་ཕྲ་མོ་གྲངས་མེད་སྤྲོས་ནས་ཀྱང་སྣོད་བཅུད་ཀུན་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་གསལ་བར་བྱས་ཏེ།",
    "དེ་ལྟར་ཞི་བར་བསྙེན་པ་སྔོན་དུ་སོང་ནས་སྐུ་གསུང་ཐུགས་ཀྱི་དངོས་གྲུབ་དམ་པ་གང་ཞིག་རྣལ་འབྱོར་པའི་ཤེས་རབ་ཀྱི་རྩལ་གྱིས་མྱུར་དུ་བླང་བའི་ཕྱིར་ཁྲོ་བོའི་དཀྱིལ་འཁོར་སྒྲུབ་པ་བརྩམ་པ་བྱ་སྟེ།",
    "ཞེས་སོགས་ཀྱི་དོན་བཞིན་རྒྱུད་དང་མན་ངག་གི་དགོངས་པ་བཞིན་དུ་རིམ་གྱིས་སམ་ཅིག་ཆར་གསལ་གདབ་པ་བྱའོ།",
    "སྔགས་ཀྱི་ཡི་གེ་སྒྲ་སྒྲོགས་པའི་དབྱངས་ལ་སོགས་པ་དྲུག་གིས་བཟླས་པ་དང་།",
    "ནམ་གུང་ལ་རོལ་མོའི་སྒྲ་དང་བཅས་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་ཐུགས་དམ་བསྐུལ་བའི་དོན་དང་ལྡན་པའི་ཚིག་དབྱངས་སྙན་པོའི་འགྱུར་བ་ཉིད་ཀྱིས་བསྒྲུབ་བྱའི་ལྷ་དེ་དག་མཉེས་པར་བྱ་ཞིང་།",
    "ཡུམ་གྱི་མཁའ་ཡི་དངོས་པོ་ནི་པདྨ་ཨ་ཡིག་གིས་མཚན་པ་རུ་བྱིན་གྱིས་བརླབས་ནས།",
