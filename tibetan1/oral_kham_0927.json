    "ཡང་ཕྲན་ཆུང་ང་ཡིས་མཐོང་བ་ལ་ཁྱེད་ཉིད་བརྩམས་སྒྲུང་ལ་དཔྱད་པ་སྤེལ་བར་མཁས་པོ་འདུག་ལ།",
    "འདི་ནི་དངོས་གནས་ཧ་གོ་ཐབས་མི་འདུག་ཅིང་ཡིད་ཕངས་ས་ཆེས་ཆེ་བ་ཡང་ཡིན་ནོ།",
    "ད་ནི་དེར་གཤག་བཅོས་བྱེད་སྤྱད་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་ཅེས་པའི་གྲི་ཆུང་དེ་བེད་སྤྱོད་ཆེན་པོ་མ་བྱས་གོང་ནས་རྡུགས་ཏོ་ཞིག་ཏུ་གྱུར་འདུག་པས།",
    "གྱིས་བོད་ཀྱི་དུས་སྐབས་གསར་པའི་བརྩམས་སྒྲུང་སྐོར་གྱི་དཔྱད་བརྗོད་དེབ་ཅིག་པར་སྐྲུན་གནང་འདུག་པ་གོ་རྗེས།",
    "བོད་ཡུལ་དུ་སྐད་གྲགས་ཆེ་བའི་རྩོམ་པ་པོ་ཞིག་ཀྱང་ཡིན་པས་དེ་འདྲ་དཔེ་མི་སྲིད་སྙམ།",
    "དཔྱད་རྩོམ་འབྲི་དུས་གཟབ་ནན་གྱི་རྣམ་འགྱུར་བཟུང་མི་འདུག་པ་རྟོགས་ཐུབ།",
    "དེ་ནི་དཔེ་མི་སྲིད་ཞིག་མ་ཡིན་ནམ།",
    "གཞན་གྱི་ཚིག་རང་འདོད་དུ་བཟོ་བཅོས་བྱས་འདུག་པ་ལས་ཀྱང་གསལ་བོར་ཤེས་ཐུབ།",
    "མ་མཐའ་ཡང་མཐུག་ཚད་ལ་བློ་གསར་དགྱེས་པའི་དགའ་སྟོན་ཞེས་པའི་དེབ་འདི་འདྲ་ཞིག་ཅིས་ཀྱང་འབྲི་དགོས་འདུག་པས།",
    "རྙིང་ཞེན་གྱི་བསམ་བློ་ལ་དཔྱོད་ཤེས་ཀྱི་སྒོ་ནས་ཡིན་མིན་བརྟག་དཔྱད་གཏོང་བ་ལས་རྨོངས་ཚོད་དུ་མི་འཇུག་པའི་ལམ་གསར་པ་ཞིག་བཏོད་དང་གཏོད་བཞིན་འདུག་པས།",
    "རང་རང་སོ་སོའི་སྤྱོད་པ་བསྐྱངས་ན་ལེགས།",
    "སྐྱོན་ལ་ངོས་ལེན་ཞུས་ཚེ་རྫུན་གཏམ་མཁན་ནི་ང་རང་ལས་འཆོར་ས་མེད་ཅིང་།",
    "མེ་ཏོག་སྟན་དུ་བཏང་རུང་རྫུན་གཏམ་ནི་ནམ་ཡང་བདེན་དོན་དུ་འགྱུར་མི་སྲིད་ཅེས་བསྟན་འདུག་ལ།",
    "ཡང་ན་ངན་པ་བཟང་བོར་བསྒྱུར་པའི་ཐབས་རྩལ་ལ་བྱང་ཆ་ངེས་ཅན་ལྡན་འདུག་པས།",
    "ཉེ་སྔོན་ཕ་ཡུལ་དུ་ལོག་དུས་རྒྱུས་ལོན་ཕྲན་ཙམ་བྱས་པ་ལྟར་ན།",
    "མི་ལྷག་ཏུ་གྱུར་འདུག་པའི་སྣང་ཚུལ་ག་ས་གང་དུ་མཐོང་ཐུབ།",
    "གོམས་སྲོལ་བཟང་པོ་འདི་ཡང་མུ་ནས་མུ་རུ་བསྲིངས་པ་ཡིན་འདུག།",
    "དེ་ནི་དཔེ་མི་སྲིད་པ་ཞིག་ཡིན་ནའང་།",
    "ཁོ་བོ་ནི་ནམ་ཡང་ཁ་རོག་གེར་གཏན་ནས་འདུག་ཐབས་མེད་ལ།",
    "བོད་ཀྱི་མཁས་པ་ཚོའི་ཁྲོད་དུ་གེ་སར་སྒྲུང་ཞེས་པའི་རུས་པ་སྐམ་པོ་དེ་མུར་མུར་ནས་བཅུད་མེད་རོ་མེད་ཞིག་ཏུ་གྱུར་འདུག་ནའང་།",
    "གཞུང་འདིའི་བྱེད་པོས་སྙན་རྩོམ་འདིའི་རིན་ཐང་སྙན་རྩོམ་རང་སྟེང་དུ་མེད་པར་དེ་ལས་བརྒལ་འདུག་པ་ཞིག་སྟེ།",
    "ཡང་ན་དོན་གྲུབ་རྒྱལ་ངོ་མ་དེ་ཅུང་རྒྱང་རིང་སར་བསྐྱལ་འདུག་པའི་ཉམས་སྣང་ཡང་སྦྱིན།",
    "དེབ་འདིར་འཁོད་པའི་ལྟ་ཚུལ་མང་ཤོས་ཤིག་ནི་ཐོག་མར་བཏོན་པ་ཡིན་འདུག་ལ།",
    "མི་དང་རང་བྱུང་ཁམས་མཉམ་གནས་དང་གཅིག་ལ་གཅིག་བརྟེན་གྱི་འབྲེལ་བ་དམ་པ་སོགས་སྒྱུ་རྩལ་གྱི་རྣམ་པས་སློང་སྐྲུན་བྱས་ཡོད་པས།",
    "རང་བྱུང་ཡུལ་ལྗོངས་མང་བོ་རྨེག་མེད་དུ་གཏོང་བཞིན་པའི་སྐྱ་ཟད་སྔོ་གཏུགས་ཀྱི་དུས་སྐབས་ཤིག་དང་ཁེལ་འདུག་པས།",
    "ལྷག་པར་དུ་བསམ་ཚུལ་གང་ཞིག་ཡི་གེར་བཀོད་ནས་ཁྱེད་དང་བགྲོ་གླེང་བྱེད་བསམ་ཚེ་གླེང་རིན་ཡོད་པའང་ཅང་མི་འདུག་སྟེ།",
    "ང་རང་ཁྱེད་དང་བསྡུར་ཐབས་མེད་དེ།",
    "ཕྱིར་དྲན་བྱེད་རིན་ཡོད་པ་ཞིག་ཏུ་ཡང་འདུག་ཁ་ཁག་ཡབ་དང་།",
    "དགའ་ཕྱོགས་ཙམ་ལས་འདའ་མི་འདུག་ལ།",
    "ཁོ་ཚོའི་གྲུབ་འབྲས་ཀྱི་མདུན་དུ་ཁོ་བོས་ཅིས་ཀྱང་ཁ་རོག་གེར་སྡོད་ཐབས་མི་འདུག་དེ་ལ་ཁོ་བོས་བཟོད་སྒོམ་བྱེད་ཐབས་བྲལ།",
    "ཁོ་ཚོས་ཅི་ཞིག་བརྗོད་ཀྱིན་འདུག་དེས་ནུས་པ་ཅི་ཞིག་ཐོན་གྱིན་འདུག་དེ་ལས་འགན་འཁྲི་ཅི་ཞིག་མཐོང་ཐུབ།",
    "བསྐྱར་ཟློས་ནས་ཡང་ཟློས་དང་ནུར་འགྲོས་བྱེད་ཀྱིན་འདུག་པས།",
    "གྲྭ་བཙུན་སོགས་སྨྱུ་གུ་ཐོགས་མཁན་ཡོངས་ཀྱིས་ཟིན་འདུག་ལ།",
    "རྩོམ་མཁན་རྒྱུས་མེད་རྣམས་ལ་རྩོམ་སྐུལ་བྱས་ཚེ་དང་ལེན་བྱེད་པའི་ངེས་པ་མི་འདུག་ལ།",
    "དེས་ནི་ཁོ་བོར་བཟོད་གླགས་བྲལ་བའི་གདུང་བ་དྲག་ཏུ་བསྐྱེད་དེ་ད་དུང་ཡང་སོས་དཀའ་བའི་ཚད་དུ་གདའ་འོ།",
    "གང་དུཡོངས་སུ་བསྔོ་བའི་སེམས་དེ་ཡང་རང་བཞིན་གྱིས་སྐྱོ་དབའོ་ཞེས་ཤེས་པར་བྱས་ལ།",
    "ནོར་བུའི་སེམས་ཀྱིས་མིའཆག་མི་འདུག་མི་ཉལ་ཏེ།",
    "ཚེའཕོས་ནས་ཀྱང་ཉན་ཐོས་དང་རང་སངསརྒྱུ་སེསཡི་སྨྱོའོ།",
    "ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན།",
    "བུམ་ནང་ནས་ཁོལ་ཞིང་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས།",
    "དེ་ནས་མདུན་བསྐྱེད་དཀྱིལ་འཁོར་ལྷ་ཚོགས་རྣམས་ཀྱི་སྐུ་ལས་མར་མེ་གཅིག་ལ་གཉིས་མཆེད་ཀྱི་ཚུལ་དུ་བྱོན་ནས་ཁྱེད་རང་རྣམས་ལ་ཐིམ་པས་རྣམ་དག་རྒྱལ་བའི་དཀྱིལ་འཁོར་མ་ལུས་པ་གཅིག་ཆར་དུ་དབྱེར་མེད་པར་རྟོགས་པའི་འདུན་པ་མཛོད་ཅིག།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་རྣམས་ལ་གསོལ་བ་བཏབ་པས་གཙོ་འཁོར་རྣམས་དང་ཁྱད་པར་ཚེ་བདག་རྒྱལ་བ་རིགས་ལྔ་ཡབ་ཡུམ་རྣམས་ཀྱིས་རང་འདྲའི་སྤྲུལ་པ་དཔག་ཏུ་མེད་པ་ཕྱོགས་བཅུར་སྤྲོས་ནས་ཁྱེད་རང་རྣམས་ཀྱི་ཚེ་ཡར་བ་དང་ཆད་པ་དང་འཐོར་བ་རྣམས་དང་།",
    "དབྱིངས་རིག་རྡོ་རྗེ་དབྱིངས་ཕྱུག་མ་དང་རྡོ་རྗེ་འཆང་གཉིས་ངོ་བོར་འདྲེས་ཏེ་ཁྱེད་རང་རྣམས་ཀྱི་སེམས་ཀུན་ཏུ་བཟང་པོ་སྐྱེ་འཆི་དང་བྲལ་བའི་ཀློང་དུ་སྐྱེ་མེད་དུ་ཐག་བཅད།",
    "མདུན་བསྐྱེད་ཆེ་མཆོག་པདྨ་དྲག་པོའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་རྣམས་ལས་མར་མེ་གཅིག་ལས་གཉིས་མཆེད་ཀྱི་ཚུལ་དུ་རིམ་བཞིན་ལྷ་སྐུ་རྣམས་འཕྲོས་ནས་ཁྱེད་རང་རྣམས་པདྨ་དྲག་པོར་གསལ་བའི་ལུས་ལ་སིབ་སིབ་ཐིམ་པར་སྒོམས་མཛོད་ཅིག།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་དུ་ཞུགས།",
    "ལོ་དུས་སྨྲ་ཤེས་པ་ཞིག་བྱུང་འདུགབཙས་ནས་ལོ་གཉིས་སུ་ཉེ་བར་ཙམ་ན།",
    "ཕ་དང་ཞང་བོ་སོགས་ནང་མི་ལྔ་ཙམ་ཡོད་འདུག་པ་ཐམས་ཅད་ཀྱིས་མཐུན་པར་མཐོང་ཞིང་།",
    "བསྐང་གསོ་འཆག་མེད་དུ་མཛད་ཀྱིན་འདུག་པས་གཏོར་ཆབ་སྦྲོན་པ་དང་།",
    "དེ་སྐབས་མཆོད་བཤོམ་ལ་བཅོམ་ལྡན་འདས་ཐུབ་པའི་སྐུ་བརྙན་ཆེ་རབ་ཞིག་བཞུགས་ཀྱིན་འདུག་པས།",
    "གཤེད་དམར་གྱི་ཐང་སྐུ་ལྷ་མགྲོན་ལ་ཀྱེ་རྡོར་ཡོད་པ་ཞྀག་འདུག་པ།",
    "ཐོག་ཁ་ནས་ངས་བལྟས་ཁོང་འདུག་པ་མཐོང་སྟེ།",
    "གསོལ་ཇ་བཞུགས་གྲལ་ཞིག་འདུགངེད་ལ་གདན་དམའ་བ་ཞིག་བྱུང་བས་ཁྲོ་ཞིང་སྡོད་མ་འདོད།",
    "བལ་པོ་རྒྱ་གླིང་པ་གཉིས་འདུག་པའི་སར་ཕྱིན།",
    "བཀའ་ལས་ཀྱང་སྐུ་ཁམས་ནི་དྭངས་པོ་འདུག་སྟེ།",
    "རྗེ་དམ་པ་རང་ནི་མིན་པ་འདྲ་ཞེས་དབུས་ཕྱོགས་ཀུན་ལ་གསུངས་འདུག་ཅིང་།",
    "གོང་དཀར་ན་ཕྱག་རིས་ངོས་མ་རང་འདུག་པ་དངོས་སུ་མཐོང་།",
    "དེ་གོང་མནལ་ལམ་དུ་ལུང་བསྟན་རིམ་པ་གསུམ་ཙམ་བྱུང་འདུག་པ་དང་།",
    "ག་ཐོག་པ་དཔལ་ཀུན་དགའ་ལེགས་རྒྱལ་གཉིས་ཀྱང་ཞབས་འབྲིང་དུ་འཕྲལ་འབྱོར་བྱུང་འདུག་ཅིང་།",
    "གོང་མ་ཁུ་དབོན་དང་མཇལ་འཕྲད་ལེགས་ཚོགས་ཆེ་བར་བྱུང་འདུག་ཅིང་།",
    "དཔལ་ལྡན་དུས་ཀྱི་འཁོར་ལོའི་སྨིན་བྱེད་ཅིག་སྩལ་འདུག་སྟེ་ཧ་ཅང་གསལ་བར་མི་དྲན།",
    "གཏོར་རྒྱག་བྱེད་ཀྱིན་ཡོད་པར་འདུག་ཚུལ་སོགས་མང་པོ་བྱུང་སྟེ་ལ་ཆ།",
    "མ་ཧཱ་ཀ་ལ་དེ་ན་ཟེར་དབྱངས་གདའ།",
    "འཕན་ནེ་སོགས་ཕལ་ཆེར་གྱིས་མ་ཕྱིན་པ་ལེགས་ཚུལ་མཛད་ཀྱིན་འདུག་ནའང་།",
    "ཟེར་བ་དེ་རང་ཡོད་པར་གདའོ།",
    "ཡི་དམ་གྱི་མངོན་རྟོགས་ཆེ་ཆུང་རྣམས་མ་ནོར་བར་གཙང་སིང་ངེ་སྐད་གསལ་པོར་འདོན་པ་ཁོ་ན་དེའི་རིང་ལ་རྟག་ཏུ་བྱུང་འདུགཟླ་བོ་ཚོ་ནི་དཀྱུས་མ་མིན་པ་བར་ཆད་ཡིན་ནམ་སྙམ་བློ་སྐྱོག་ཟེར།",
    "ཟླ་བ་གཟའ་འཛིན་ཞིག་དང་བསྟུན་ནས་ཕྱག་རྡོར་གྱི་བཟླས་པ་མཚམས་ཞག་བདུན་མ་ཞིག་ཀྱང་བྱས་ཏེ་ཟླ་བ་གང་ཡིན་བརྗེད་འདུགདཔྱིད་ཕྱོགས་རྗེ་བཙུན་དཔལ་སྟག་ལུང་པ་ཆེན་པོ་ལྷ་སའི་ཞིག་གསོས་དང་གསེར་ཕིབས་འབུལ་བར་ཕེབས་སྐབས།",
    "དེ་ལ་ཕྱག་ཅིག་བྱས་ནས་དྲུང་དུ་འདུག་ཙ་ན།",
    "ཁོང་རྣམས་ལྡོག་དུས་དར་ཁྱེར་གྲུབ་འདུག་ཟེར།",
    "ཕེབས་སྒོ་ལ་ཡང་དང་པོ་རྗེ་དམ་པ་ལ་ཡང་འདི་བཞིན་མཛད་འདུག་པ་བཞིན།",
    "དགོངས་རྫོགས་སོགས་ཀྱང་གྲུབ་པར་གདའ།",
    "གང་ཟིན་དེ་ལ་གོ་བློ་རང་བཟང་རབ་འདོགརྗེ་གྲོལ་མཆོག་ནི་ཐུགས་རྩོལ་ཆེ་བ་རང་ཡིན་པར་འདུགང་ནི་ལེ་ལོ་དང་སྙོམས་ལས་ཀྱི་མངའ་བདག་རང་ཡིན་ནོ།",
    "མཚོ་དེའི་དབུས་ན་མེ་ཏོག་ཤིན་ཏུ་ཆེ་བ་སེར་པོ་དང་སྔོན་པོ་ཤས་ཆེ་བ་འདུགདེ་མཚམས་ནས་རྨི་ལམ་ཡང་ཟིན་ཅིང་།",
    "ཁ་སང་རང་བསམ་སྡིངས་ན་ཡོད་པ་ཡིན་པ་ལ་འདི་རྨི་ལམ་དུ་འདུག་སྙམ་པ་དང་།",
    "ཡུན་རིང་པ་ནས་སྐབས་འདི་ཙ་ན་ལུས་ཀྱི་ཤེད་ཀྱང་ཅུང་ཟད་བྲི།",
    "ཟླ་བོ་རྣམས་ཐུགས་འཚབ་ལ་གཏད་པར་གདའ།",
    "སྔ་སོར་ཞལ་ངོས་ཀྱང་ཞལ་ལེན་མཛད་ཡོད་འདུག་ནའང་།",
    "དེ་ནས་བསྙེན་པ་ཞིག་བྱས་ན་བར་ཆད་ཐམས་ཅད་སེལ་ཞིང་དཔའ་བོ་དང་མཁའ་འགྲོ་རྣམས་ཀྱིས་རྗེས་སུ་འཛིན་པར་འདུག་གསུང་བ་ཅིག་བྱུང་།",
    "དྲུང་ཆེན་པས་ངེད་ལ་གྲོས་ཙམ་ཡང་མ་དྲིས་པར་བྱང་རང་དུ་ཕུལ་བ་ཡིན།",
    "སྐོར་ལམ་ཐམས་ཅད་ཀྱང་ཆུས་ཁེངས་ཤིང་ཆུ་རགས་འཕྲལ་འཕྲལ་བརྩིགས་ཀྱང་འཕྲལ་འཕྲལ་ཞིག་འགྲོ་བའི་མི་ཐམས་ཅད་སུན་ཞིང་གཙུག་ལག་ཁང་ལ་ཆུ་ཉེན་ཤིན་ཏུ་ཆེ་བར་འདུག་སྟེ་དཀའ་ཚེགས་ལ་མ་འཛེམ་པར།",
    "ཆུ་རྒྱས་པས་འཛའ་འཕྲང་ཛོ་འཕྲང་ལ་མི་ཐར་བ་འདུག་པས།",
    "ས་ཕྱོགས་དེ་གྲུབ་པའི་བསྟི་གནས་སུ་འདུག་པས་གུས་པ་ཆེན་པོས་ཕྱག་དང་སྐོར་བ་ཞིག་བྱས་དར་ལྕོག་ཅིག་བཙུགས།",
    "དེ་ནས་མར་ལམ་སྟག་ཚེར་གྱི་གོང་ཙམ་དེར་ཡུར་བ་ཞིག་ན་འོད་འཚེར་བ་འདུག་པས་མགྱོགས་པོར་ཕྱིན་ནས་བླངས་ཙ་ན།",
    "ཁོང་པ་རང་ངེད་ལ་འཕྲད་པར་ཕེབས་པ་ཡང་ཡིན་པར་འདུགགང་ནའང་ཀ་བཞི་ནས་ཀྱིས་འབུལ་བ་ཤིན་ཏུ་བཟབ་པ་རང་གནང་།",
    "སླར་ཡང་ཞུ་ནན་ཆེས་ན་ཐུགས་ལོག་པའི་རྒྱུད་འགྲོ་བ་འདུག་པས་བཀའ་བཞིན་མི་སྒྲུབ་མཐུ་མེད་བྱུང་ཞིང་།",
    "འདི་སྐབས་ཙ་ན་ལེགས་སྦྱར་གྱི་སྐད་ཀྱང་མང་རབ་ཤེས་ཤིང་།",
    "དེ་ཡང་ཡིན་ནི་གཉིས་ཐད་ནས་ཕྱིའི་མཛེས་ཁྲིགས་ཙམ་གྱི་ཚུལ་ཀ་ཡིན་ཁོག་པ་ལོང་མཉམ་དུ་གདའ།",
    "ཕྱི་ལྟར་དུ་སྐུ་རིམ་ཡིན་པའི་ཁུངས་འདུག་ནའང་།",
    "འདི་སྐབས་སྦས་སྐུངས་བཏོན་པར་གདའ།",
    "དེའི་ཕྱི་ཉིན་དཀྱིལ་འཁོར་དེ་དང་ཆོ་གའི་རྣམ་སྤྱི་བློ་ལ་གསལ་སེང་ངེ་མ་བརྗེད་པར་འདུག་པས་སློབ་དཔོན་དམ་པ་སོགས་མཚམས་འོག་ཡོད་པ་རྣམས་ལ་གླེང་སླང་བྱུང་།",
    "བདག་པོ་མ་ཆེན་དྲུང་རྩེ་ཆེན་དུ་བུ་གཏེར་ཕེབས་དགོས་སོགས་ནས་སྐུ་གྲིབ་ཀྱི་རྣམ་པ་དང་ཐུགས་ལའང་བདེ་དོག་མཐོ་དམན་ཆེ་བ་རང་འདུག་པ་དང་།",
    "རྩེ་ཆེན་དབོན་པོ་བ་ལ་ཞུས་ན་ཡོང་ཕེབས་ཀྱིན་འདུག་པས།",
    "ཡར་ལམ་འཚེ་དུ་མཇལ་འདོད་ཡིན་ཡང་སྐུ་མཚམས་དམ་པོ་གནང་འདུག་པས་མཇལ་མ་ཐུབ།",
    "ཁྱད་པར་སྨོན་འགྲོ་ནས་དཔོན་ས་ཡེ་ཤེས་དྲུང་རང་ལ་སྒེར་དུ་སྦྱོར་གཏོད་ཞུས་པའི་ལེགས་སློབ་ཉེས་སུབ་མགོ་འདོན་གནང་དགོས་ཚུལ་ཞུས་ནས་ཕྱིན་པ་ཡིན་ནའང་།",
    "དེ་མཚམས་སྨོན་འགྲོ་རང་ནས་མགོ་འདོན་དགོས་རྒྱུར་འདུག་ནའང་།",
    "ཕྱི་ནས་དགྲ་བྱུང་བ་སོགས་གང་ལའང་ཁུར་མི་འཁྱེར་བར་འདུག་པས།",
    "དེ་ལོ་ཇོ་ནང་དུ་རྫ་ཤར་པ་དང་གླིང་པ་ཟིངས་ཆེ་བ་བྱུང་བས་དུས་ཁྲིད་ཆག་འདུག་པ་ནས།",
    "ཕྱིན་ཆད་མཇལ་བར་དཀའ་བ་འདུག་སྙམ་པའི་ཡིད་སྐྱོ་སང་ངེ་བ་ཡང་ཡང་བྱུང་།",
    "སྒྲུབ་བརྒྱུད་ཀྱི་བསྟན་པ་སྐྱོང་བ་ཞིག་བྱུང་ན་ས་གང་ན་འདུག་ཀྱང་མཐུན་རྐྱེན་སྒྲུབ།",
    "ཚོང་འདུས་དབུ་རྩེར་ཞལ་ངོ་རྣམས་དང་མཇལ་ཞིང་དུས་རིམ་དང་ཐུག་པའི་ཟིང་ཟིང་མང་པོ་འདུག་པས་སྣང་བ་སྒྱུ་མ་ལྟ་བུ་ལ་ངེས་ཤེས་སྐྱེ་བར་བྱུང་།",
    "མི་རིང་བར་སྐུ་ཁམས་ལོག་པའི་ཐུགས་ལ་བདེ་དོག་ཆེར་བྱུང་འདུག་པ།",
    "དངོས་ཀྱིས་སླེབ་དུས་ཞབས་དྲུང་ནི་ཕྱིར་ཕེབས་གྲུབ་འདུག་ཅིང་།",
    "དེ་གོང་ཐུགས་འབྲེལ་མི་གདའ།",
    "སྔོན་གྱི་དེ་དངོས་རང་མིན་པའི་སྐུ་ཚབ་ཡིན་ནམ་སེམས་པ་ཞིག་འདུག་པ་གང་ལྟར་ཡང་དེ་རྣམས་མཇལ།",
    "ཞལ་ཕྱེ་ནས་བལྟས་པས་འཁོར་ལོ་སྡོམ་པའི་རྩ་རྒྱུད་དུ་འདུག་ཅིང་།",
