    "བཾ་ཤ་རོ་ཙ་ན་ཞེས་པའི་སྨྱུག་མའི་ནང་ནས་བྱུང་བ་སེར་སྐྱ་རོ་གསལ་བ།",
    "ཁྱི་ནག་ཕག་ནག་སྤྱང་ནག་གསུམ་གྱི་བྲུན་ཟེར་བའང་འདུག་ཕུར་ནག་བསྐོལ་ཁུར་གླ་རྩི་ཞོ་གང་ཞིབ་བཏགས་ཕྱེ་མ།",
    "མཁལ་བབས་སྒོས་ཀྱི་ཐང་ལ་སྒོག་སྐྱ་ཞེས་པ་ལྷན་ཐབས་སུ་སྒ་སྐྱ་ཟེར་བའང་འདུགཀླད་གཟེར་སྐབས།",
    "གཞན་རྣམས་ཆ་མཉམ་ཞུ་མཁན་ཁུ་བར་སྦྱར་དྲོད་ཡོད་ཙམ་གྱིས་ཐིགས་བདུན་ཙམ་སྣར་བླུགས་ལ་ཟན་ཟ་ཡུན་ཙམ་འདུག་བླུག་དུས་ལྟག་པ་ས་ལ་ཁེན་ཏེ་གན་རྐྱལ་གྱིས་ཉལ།",
    "སྲད་མའི་མེ་ཏོག་ལ་པད་ཁའི་མེ་ཏོག་དང་པད་མའི་མེ་ཏོག་ཟེར་བའང་འདུག་འབྲོང་རྩེ་བས།",
    "ཤིང་ཚ་རྒྱ་ཚ་བྱང་བ་ཟེར་བ་འདིར་བྱང་བ་དང་སྟག་ཤ་བཞེད་པ་མི་མཐུན་པ་འདུག་ཀྱང་གཉིས་ཀ་འཐད་པར་མངོན།",
    "རྒྱ་ཤལ་བཤལ་རྩ་དམར་སྐྱུག་དུས་གུར་གུམ་དང་།",
    "ཁྲག་རུལ་དུད་ཁུ་སྐྱུག་དུས་སེ་འབྲུ་དང་།",
    "ཅོང་ཞི་ཞིབ་བཏགས་ཐོ་རང་རངས་སེང་སིངས་པོས་ཕུལ།",
    "ཞིག་དུས་འཕྲལ་དུ་ཚ་ལའི་འཕྲུལ་བཤལ་གཏོང་།",
    "ཚད་རྟགས་འདུག་ན་གློ་ཚད་ཀུན་སེལ་ལོ།",
    "ག་དུར་ཚབ་ལུག་མུར་གཏོང་བའི་ཕྱག་ལེན་འདུག།",
    "རང་རང་འདུ་བའི་ཁ་འཛིན་དཔུང་དང་བཅས།",
    "རང་རང་ཁ་བསྒྱུར་བསྣན་པ་མཆོག་ཏུ་བསྔགས།",
    "ཚ་གྲངས་རང་རང་སྐབས་ཐོབ་ལྟག་པ་སྤྲད།",
    "སྨྲ་བ་སྤང་ལ་དལ་འདུག་སྐོམ་པ་སེལ།",
    "བཅོས་ཐབས་རང་རང་འདུ་བ་སྤྱི་དང་བསྟུན།",
    "ཁྱད་ཐོན་འདུག་པས་འདི་ཉིད་བསྟན་པ་བསྔགས།",
    "རང་རང་སྐབས་ཐོབ་བརྩིས་པའི་རིག་པས་དཔྱད།",
    "སྣོད་གར་བབས་རང་རང་གཉན་གཉེན་པོ་བསྟེན།",
    "ཕོ་ལོང་སྦོ་འཁྲོག་རང་རང་སྟེང་དུ་སྐྲངས།",
    "རྒྱུ་རྐྱེན་བསྟན་སྟན་སྲབ་ཙོག་པུར་འདུག་པ་དང་།",
    "གཞན་བསྟན་བཞོན་བསྟེན་རླན་སྟེང་ཡུན་རིང་འདུག་ལས་འབྱུང་།",
    "རང་རང་ཁ་འཛིན་མེ་གཟའ་ག་པུར་དང་།",
    "རང་རང་ངོ་བོ་མཉམ་པ་ཡི།",
    "སྔགས་བཏབ་ཙམ་གྱིས་འཚོ་བ་འདུག་ཅེས་ཐོས།",
    "ཕྱེད་ཙམ་འཐག་དུས་འབྲི་འོ་མ་རུལ་སྙིམ་པ་གསུམ་ཙམ་ཟུར་དུ་བསྐོལ་བ་སབ་གསབ།",
    "སྲོད་དང་ཐོ་རང་རངས་ལྟག་སྤྲད་བྱེར་བ་སྡུད།",
    "གཞི་འཛིན་གང་རུང་ཐོ་རང་རངས་ཆུ་བསྐོལ་དབུལ།",
    "སྔགས་པ་དང་རང་གཞན་གཉིས་ཀས་ཤ་ཆང་སྒོག་ཙོང་སྤངས།",
    "འདི་སྔོན་དུ་བཏང་སྲོལ་འདུག་ཀྱང་རྗེས་ལ་བཏང་ན་ལེགས་གསུངས།",
    "གཞན་འབམ་ཐམས་ཅད་ལ་ལོང་རྩ་བྱིན་གཞུག་གང་རུང་གཏར་ཞིང་རང་བྱུང་ངམ་བཅོས་མའི་ཆུ་ཚན་ལ་ཞུགས།",
    "རྩ་གཉིས་འདུག་ན་གོང་མ་མཐོང་བྱེད་ཡིན་པས་གཞག་འོག་མ་སྒྲིབ་རྩ་ཡིན་པས་ལྕགས་ཀྱུས་ལེན་ནས་བཙག་གཙགས་བུས་བཅད།",
    "ཐེབ་པའི་དུས་སུ་ལྕག་ཆང་གསུངས་ཀྱང་ཆུ་བསྐོལ་གྲང་རང་ལེགས།",
    "ཟུག་ཆེ་ཞིང་འབབས་མི་ཐུབ་པ་འདྲ་འདུག་ན།",
    "ཇ་ཡུན་ཙམ་བཞག་ནས་འདུག་མི་ཚུགས་སྐབས་ཆིང་ཆིངས་བཀྲོལ།",
    "རྟ་ནོར་ཆག་དུས་ཀྱང་རྩི་དཀར་དང་སྤེན་མའི་དེབས་དེབ་ཀྱིས་སྔར་ལྟར་དཀྲི།",
    "གཟེར་མིག་སྟེང་དུ་བསྒོམ་ཞིང་རང་མདུན་གྱི།",
    "རང་རང་གསང་ཡིན་ཚད་དང་བསྟུན་ལ་བསྲེག།",
    "ལུས་ངག་ཡིད་གསུམ་མ་འཁྲུགས་དལ་བར་འདུག།",
    "ཀུན་ལ་ལྷ་བསྐྱེད་བསྔགས་སྔགས་རྟ་མགྲིན་སོགས་རང་རང་གཉེན་པོ་བཟླས་རབ་གནས་བྱ།",
    "དེའི་བསྙེན་པ་དང་རང་བསྔགས་སྔགས་བརྒྱ་རྩས་རབ་གནས་བྱའོ།",
    "སྲིན་ཤས་ཆེ་བ་ལ་མི་འཕྲོད་འདུག་པས་དེ་ཚབ་ཁ་ཆེ་དཔུས་སྤུས་ལེགས་དྲི་རོ་མ་ཉམས་པ་ཅུང་ཟད་དང་།",
    "ད་ལོའི་འབྲུམ་དཀར་འདི་མིག་དང་གྲེ་བར་སྐྱོན་བྱས་སྐད་མི་འདུག་རུང་།",
    "སྤྱོད་ལམ་དྲག་ཤུལ་རྟ་ཞོན་ཉིན་གཉིད་འགྲོ་འདུག་སོགས་སྤང་ནས།",
    "ཞག་དུས་ན་དམར་ཉོ་འགྲོ་བ་ཙམ་ལས་མི་ཆུགས་པ་འདུག་གསུངས།",
    "སྟོང་ཆེན་རབ་འབྱམས་ནས་གསུངས་པའི་བདེན་ཚིག་དང་ཤིས་པ་བརྗོད་ཅིང་མེ་ཏོག་འཐོར་སྟན་ལ་འདུག་སྟེ།",
    "ལངས་འདུག་ཐུབ་མཚམས་ནས་གསེར་མཚོའི་བུལ་ཏོག་ཞུ་མཁན།",
    "མ་འདྲེས་པར་ཕྲོམ་ཕྲོམ་འདུག་ན་འཆི།",
    "གྲིབ་ཕོག་དུས་ཐོག་མར་སྤོས་དཀར་གྱི་ཐང་བཏང་ན་བཅོས་སླ།",
    "མགོ་མ་གཏོགས་སྣོད་བཅས་རས་ཀྱིས་དཀྲིས་ལ་རླངས་པ་མ་ཤོར་བར་བྱས་ནས་མཚན་བརྗོད་ཚར་གཅིག་རིང་འདུག་དེ་ནས་རས་ཕུད་ཆུ་ཕྱར།",
    "འབྲུ་ཆང་ལ་ཆུ་བརྒྱབ་ནས་བཅགས་བཙགས་པའི་ཆང་རང་ནུབ་ཙམ་བླུགས་ནས་བསྐོལ་ཕོག་སྟེ་ཁ་བཅད་ནས་ཅུང་ཟད་བཞག་དེ་ནས་ཟངས་སྣོད་ཆེ་བར་བླུགས་ལ་ལྡེ་ཁུ་དང་ཆུ་ཡི་བུངས་བསྐྱེད་ལ་བསྐོལ།",
    "ཞག་གཅིག་བཞག་ལ་དྭངས་སྙིགས་བྱེད་འདུག་ན།",
    "ཁུངས་ཐུབ་འདི་ཡིན་འཆད་རྒྱུད་མི་འདུག་པས།",
    "དེ་ནས་རྩ་ལྷག་འདུག་ན་གདོན་རྩ་སྟེ།",
    "རྩ་ལྔ་འདུག་ན་དང་པོ་གདོང་རྩི་དང་།",
    "དེ་སྟེང་རང་ཐག་ཡ་ལོ་དར་བུས་གཞག།",
    "ཞག་གསུམ་སྔོན་ནས་བཏང་ཞིང་དལ་བར་འདུག།",
    "སྔགས་འདིས་སྨྱུག་མར་ཕུ་རྒྱག་པ་སོགས་ནི་མི་བྱེད་འདུག་དེ་རྗེས་ཀྱི་སྔགས་བི་འོང་ཟེར་བ་འབི་འོང་ལྟ་བུ་ཟེར་བ་འདྲ།",
    "འཛབ་ལྟ་བུ་དབྱེ་བ་མི་ཕྱེད་གཅིག་འདོན་འདུག་སོན་ཏི་སི་ལྟོ་ཞིས་ལ་དགོས་ལ་ཡང་སྦྱོར་རམ་སེམས།",
    "སྒྲིབ་བྱང་རང་ཉིད་ཤེལ་བུམ་ཞོ་ཡིས་བཀང་འདྲར་བསྐྱེད",
