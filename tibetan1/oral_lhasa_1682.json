    "དེར་བདག་ལ་ཡང་བརྡུང་ཐག་བྱེད་པར་འགྱུར་རོ་ཞེས་སྨྲས་པ་དང་།",
    "རྒྱལ་པོ་འཁོར་གྱི་དཀྱིལ་ན་བཞུགས་པ་ལ་བུ་དེ་ལག་བརྡས་སྟོན་ཅིང་གནས་ལ།",
    "དེ་ནས་རྒྱལ་པོས་བཀྱོན་པར་གྱུར་པས་ཁྱི་ཐམས་ཅད་ཡུལ་ཡུལ་ནས་ཁུག་ལ་དུས་གཅིག་ཏུ་སོད་ཅིག་ཅེས་བཀའ་སྩལ་ཏོ།",
    "ཁྱིའི་གནོད་པ་དེ་ཡང་བཟློག་པར་མཛད་ལ།",
    "༣ པ་དུད་འགྲོའི་སྐྱེ་གནས་ཀྱི་གནས་གང་དག་ཏུ་སྐྱེས་པ་ཀ་པིལྗལ་དང་ནེ་ཙོ་དང་ཕུ་རོན་ལ་སོགས་པའི་ཟ་སྐྱེས་རབས་དེ་དག་དཀའ་བ་བྱེད་པ་ཤེས་པར་བྱ་བའི་ཕྱིར་བརྗོད་པར་བྱའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་གཞལ་བྱ་ཡང་།",
    "མིན་ཞེས་དེ་བཞིན་གཤེགས་པས་གསུངས།",
    "ཐབས་ནི་མངོན་བར་འདོད་པའི་དོན་ཤིན་ཏུ་བྱ་དཀའ་བ་ཡང་འབད་པ་མེད་པར་སྒྲུབ་པར་ནུས་པའི་རྒྱུ་ཉེ་བར་རྟོགས་པའོ།",
    "གསད་པར་བྱ་བས་གཏོང་བ་ཐོས་པ་བཞིན་ནོ།་",
    "ཚོང་སྤོགས་བཞིན་དུ་སྨད་པར་འགྱུར།",
    "གཞན་དག་འབྲས་བུ་བསྔགས་པར་༤སབྱེད་ཅིང་གཏོང་བ་དང་ལེན་པ་སྒྲུབ་པར་བྱེད་པ་དེ་ནི་ཇི་ལྟར་ཚོང་པ་དག་ཁེའི་ཕྱིར་རྫས་གཏོང་བ་དེ་དང་འདྲ་ལ།",
    "ཇི་ལྟར་ཡོ་བྱད་ཐམས་ཅད་བཙོངས་པར་གྱུར་པ་དང་།",
    "མཉམ་པར་སེམས་སྙོམས་པས་གཏོང་བའི།",
    "རྩ་བ་ཆུང་དང་ཆེ་ཡངས་ལ་མཁྱེན་བགྱི།",
    "བསྒྲུབ་པར་བྱ་མིན་ཅི་ཡང་མེད།",
    "མྱ་ངན་འདས་ལ་ཁྱད་པར་མེད།",
    "འཆི་བ་ལ་སོགས་པའི་སྡུག་བསྔལ་གྱི་གནོད་པ་མེད་པའི་ཕྱིར་སྲིད་པ་དང་མྱ་ངན་ལས་འདས་པ་ལ་ཁྱད་པར་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་མྱ་ངན་ལས་འདས་པར་མི་འགྲོའོ།",
    "ཡེ་ཤེས་ཀྱིས་ནི་ཕུང་པོ་སྟོང་པར་ཤེས།",
    "ཐ་སྙད་ཙམ་གྱིས་རྣམ་པར་དཔྱོད་བྱེད་ཅིང་།",
    "འཇིག་རྟེན་འདི་ན་མྱ་ངན་འདས་པར་གནས།",
    "ཞེས་གསུངས་སོ།",
    "འོན་ཀྱང་སྐུར་པ་འདེབས་པར་ཡང་བྱེད་དེ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་འདིར་དེ་བཞིན་ན་མ་༢༣ གཤེགས་པ་ནི་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་ཏེ།",
    "ཟློས་པའི་ཉེས་པར་འགྱུར་རོ།",
    "དོན་ཐ་དད་དོ་ཞེ་ན་བརྗོད་པར་འདོད་པའི་དོན་གོ་བར་བྱེད་པ་མ་ཡིན་ནོ།",
    "ཅི་སྟེ་དེ་ཉིད་དང་གཞན་ཉིད་དུ་བརྗོད་དུ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་བརྗོད་དུ་མེད་པ་ཡིན་ནོ་ཞེ་ན་འོ་ན་ནི་ཇི་སྐད་དུ་བརྗོད་པར་བྱ་བ་དེ་སྐད་དུ་བརྗོད་པར་གྱིས་ཤིག།",
    "གང་གཅིག་མ་ཡིན་ཞིང་གཅིག་མ་ཡིན་པ་ཡང་མ་ཡིན་པའི་དངོས་པོ་དེ་ལྟ་བུ་ནི་སྲིད་པར་བྱ་བ་ཡང་མི་ནུས་སོ།",
    "ལན་ཡོད་ན་ནི་ལྟག་ཆོད་དུ་འགྱུར་བ་ཞིག་ན་དེ་ཡང་ང་ལ་གདབ་པར་མི་ནུས་ཏེ།",
    "དེ་བསལ་བས་འཇིག་རྟེན་ཡོངས་སུ་བསྐྱངས་པར་འགྱུར་རོ།",
    "རྗེས་སུ་དཔོག་པས་གཙོར་བྱེད་ཅིང་བདག་ཉིད་མཁས་པར་ཁས་འཆེས་ནས་འཇུག་པས་ཁོ་བོས་དེ་མི་བཟོད་དོ།",
    "མ་ལ་སོགས་པ་དག་ཀྱང་འདིའི་བགྲོད་བྱ་མ་ཡིན་པར་མི་འགྱུར་ཏེ།",
    "འདིས་འཇིག་རྟེན་གྱི་གནོད་པ་གཞུག་པར་ཡང་མི་ནུས་ཏེ།",
    "ངེས་པར་ཡོད་ཅེས་རྟོགས་པར་གྱིས།",
    "དབུལ་པོ་དེས་ཀྱང་དེ་ལ་རྐང་པ་བསྐུ་བའི་འབྲུ་མར་དང་མལ་ཆ་བསྟབས་པར་གྱུར་ཏོ།",
    "དེ་ནས་གང་ཞིག་ཡུལ་དེར་ཡུལ་དཔོན་དུ་གྱུར་པ་དེས་དགེ་སློང་དེ་འོངས་སོ་ཞེས་ཐོས་པར་གྱུར་པ་དང་།",
    "དེས་ཀྱང་དེ་བཞིན་དུ་བྱས་ཏེ་དེ་ལྟར་ན་འཇིག་རྟེན་ན་ཕུལ་དུ་འགྲོ་བ་པས་ཆེས་ཕུལ་དུ་འགྲོ་བ་མཐོང་ངོ།",
    "རྗེས་སུ་དཔག་པ་འདིས་ནི་གང་ཞིག་བསམ་གྱིས་མི་ཁྱབ་པ་མཐུའི་སྟོབས་ཁྱད་པར་དུ་གྱུར་པ་དེ་འགའ་ཞིག་ཡོད་དོ་ཞེས་བྱ་བར་རྟོགས་པར་བྱའོ།",
    "ཇི་ལྟར་ས་བདག་འཕགས་པ་ལུས་བཟང་ཁྱིམ་པར་གྱུར་པ།",
    "ཡང་འདི་ལྟར་མཆོག་ཏུ་བདེ་བར་གྱུར་པའི་ཤཱཀྱ་རྣམས་ལ་ལྡོག་པ་ལྟ་ཅི་སྨོས་ཞེས་སླས་ཀྱི་ནང་དུ་དགེ་སློང་འཇུག་པ་རྣམས་ལ་འཇིགས་པར་ཡང་གྱུར་ཏོ།",
    "དེ་སྤུན་ཟླ་ཐུ་བོ་མཁས་པ་རྒྱལ་པོ་མྱ་ངན་མེད་ཀྱིས་བསད་པར་བཀའ་ལུང་སྩལ་བའི་ཐབས་ཀྱིས་བཏུལ་བར་ཡང་གྱུར་ཏོ།",
    "ལྷག་པར་ཞེན་པ་འཐོབ་པ་སྨོས་ཀྱང་ཅི་དགོས།",
    "ཡུལ་དུ་རྒྱལ་བ་རྣམས་ཀྱིས་གསུངས།",
    "འགྲོ་བ་རྣམས་ལ་དེ་གཅད་པར་བྱ་བའི་ཕྱིར་སྒྲིམ་པ་དང་ལྡན་པར་བྱ་དགོས་སོ།",
    "རས་འཇམ་པོས་གཏུམས་པའི་སྟན་དང་སྔས་ནང་ཚངས་ཅན་གྱིས་མཛེས་པར་བྱས་པའི་ཁྲི་འདེགས་དང་བཅས་པ་ཅན་དག་ཡོངས་སུ་ལོངས་སྤྱོད་པའི་ཕྱིར་གནང་ལ།",
    "བདེ་བ་སྒྲུབ་པར་བྱེད་པ་དག་ཀྱང་འདོད་ཆགས་ཀྱི་གཞི་ཡིན་ལ།",
    "དེའི་ཕྱིར་སྡུག་བསྔལ་ཕལ་ཆེ་བའི་ལམ་བསྒྲུབ་པར་བྱ་སྟེ།",
    "བདེ་བ་མྱོང་བར་འགྱུར་བའི་ཡུལ་ཡོངས་སུ་སྤངས་པ་མཆོག་ཏུ་འགྱུར་རོ་སྙམ་ན་ནི་སྡུག་བསྔལ་གྱིས་ཀྱང་ཁྲོ་བ་འཕེལ་བའི་ཕྱིར་སྡུག་བསྔལ་མྱོང་བར་འགྱུར་བའི་ཡུལ་ཡོངས་སུ་སྤངས་པ་ཡང་མཆོག་ཏུ་བཏུས་པར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "གཞན་ཡང་འདོད་ཆགས་དང་ཞེ་སྡང་དང་སྡུག་པ་དང་མི་སྡུག་པའི་མཚན་མ་ལྷག་པར་སྒྲོ་བཏགས་པས་བསྐྱེད་པ་དག་ནི་བདེ་བ་དང་སྡུག་བསྔལ་མྱོང་བར་འགྱུར་བའི་ཡུལ་ཙམ་ཉེ་བར་ལོངས་སྤྱོད་པ་ཡོད་ཀྱང་སྐྱེ་བར་མི་རིགས་ཏེ།",
    "དོན་དམ་པར་ན་དཀའ་ཐུབ་ཅན།",
    "གདུང་ལ་འདོད་པ་མཚུངས་པར་འགྱུར།",
