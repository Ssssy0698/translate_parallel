    "འོ་ན་ད་ཅིས་ཀྱང་མི་ཉན་ན་འདི་ང་རང་ཡིན་པར་བསྒོམ་ལ་ཀུན་དཔལ་ཁང་པའི་ནང་ནས་ཚུར་ཕྱག་འཚོལ་ཅིག།",
    "བཟོད་པར་འདུག་ཅེས་གསུངས་པར།",
    "སྐུ་རྐྱང་ལ་ཕེབས་པས་གཟིམས་ཆུང་འགག་ནས་ཆབ་དྲངས་ཞབས་ལྷུམ་ཕུད་དུ་བཅུག་སྟེ་དྲུང་དུ་ཕེབས་འཕྲལ་གསང་ཁྲིད་ལྷ་དགུའི་རྗེས་གནང་ཞིག་བསྒྲུབས་ཟིན་འདུག་པ་གནང་།",
    "ད་ང་རང་རྒན་པོ་མྱུར་དུ་འཆི་བ་ཞིག་བྱུང་ན་མཚམས་སྦྱོར་གང་འདྲས་འགྲོ་སྙམ་ཙ་ན།",
    "སུ་ལའང་གདེང་ཁེལ་རང་མི་འདུག།",
    "རྗེ་འདིས་དེ་འཕྲལ་དེ་ང་རང་ལ་ཆེད་དུ་གདམས་པ་ཡིན།",
    "རྗེ་འདིས་བདག་འཁོས་དམན་སྟབས་འཆད་ཉན་རྒྱ་ཆེན་གྱི་ཁས་ལེན་མི་འགྲུབ་པས་མཐར་ཉེས་པའི་རྒྱུ་ལས་མི་འདུག་པར་སྒྲུབ་པ་གཙོ་བོར་བྱེད་འོང་བས་དེ་ལུགས་དགོངས་པས་ཁྲོལ་དགོས་ཞུས་པར།",
    "ལུང་བསྟན་དེ་དེ་ཉིད་ཡིན་ནམ་སྙམ་ངེས་པ་རང་ཡང་མི་འདུག་ཅེས་བདག་ལ་ཕེབས་སོ།",
    "འོན་ཀྱང་འཕོ་ཆེན་རྐྱང་བ་རང་ནི་མིན་འདུག་ལུས་རྡུལ་ལྟར་དེངས་པའང་མང་དུ་འདུག་གསུངས་པ་དང་།",
    "རྗེས་སུ་བསམས་དུས་འདི་དེ་འདྲ་ཞིག་ལོས་ཡིན།",
    "སང་ཕོད་ང་རང་འཆི་ཨེ་འགྲོ་སྙམ།",
    "ཞིག་གསོལ་དགོས་བྱུང་བར་དེའི་རྗེས་ཙམ་ན་ཡབ་རྗེའི་དྲུང་ཕེབས་ནས་མཐུན་རྐྱེན་ཕོངས་མེད་ཞིག་ཕྱག་འཛིན་གནང་ཡོད་འདུག་པར།",
    "གཞན་ཡང་འདྲི་ཡུལ་འདྲ་མིན་འདུག་པས་དོན་གོ་བ་མ་བྱུང་།",
    "རིགས་དང་རིགས་བདག་གམ་དབྱིངས་དང་ཡེ་ཤེས་ཀྱི་ངོ་བོར་ཐ་མི་དད་པ་ཞིག་ཡིན་ངེས་སུ་འདུག་ཀྱང་།",
    "དེ་ཡང་ས་སྐྱ་པ་ཤ་སྟག་ཡིན་ཚུལ་ཕེབས་ཡོད་འདུག་པ་དེ་ཉིད་ལས་ཐོས་སོ།",
    "ཡང་ཐུགས་ཉམས་དང་མནལ་ལམ་དུ་དོགས་གནས་བྱུང་བ་རྣམས་ཀྱང་དྲུང་དུ་ཞུ་འབུལ་མཛད་པ་ན་བསླུ་མེད་ཀྱི་ལུང་བསྟན་ཁོ་ན་སྩོལ་བ་ཡིན་འདུག་སྟེ།",
    "སྤྲུལ་པའི་སྐུ་བཞུགས་མི་འདུག་ཀྱང་།",
    "བཅོ་བརྒྱད་ཁྲི་ཆེན་དེ་ང་རང་ལ་སྐུ་དྲིན་ཆེ་སྟབས།",
    "དབོན་པོ་ཞབས་དྲུང་དེ་ལ་ཕན་ཞིག་ཐོགས་ན་སྙམ་པ་བདོག་ཅེས་ཡང་ཡང་ཕེབས་འདུག་ལ།",
    "རྗེ་ཉིད་ཀྱིས་ཀྱང་ཞལ་མཇལ་གྱི་ཐུགས་འདུན་དྲག་པོ་ཡོད་འདུག་པས་ཆུ་རྟ་ལོར་སྟོན་དུས་ཕེབས་ནས་མི་རིང་བ་ཞིག་བཞུགས།",
    "འ་འི་འཇམ་དཔལ་གཞོན་ནུ་དངོས་སུ་འདུག་གསུངས་པའི་དགྱེས་ཚོར་ཆེན་པོ་གནང་བཞིན་ཕེབས་འདུག།",
    "ཞལ་སྔ་ནས་ཀྱང་འོ་དེ་འདྲ་ཞིག་ལོས་ཡིན་གསུངས་པའི་ལན་གནང་འདུག་གསུངས།",
    "གཞན་སློབ་ཚོགས་ཕལ་ཆེར་གྱིས་ཀྱང་ཁྲིད་ཡིག་སོགས་རྒྱུན་པར་མཐོང་གོམས་ཅན་ཚོ་མ་གཏོགས་འདི་འདྲའི་རྩ་བ་ལ་སྙེགས་མཁན་ཆེར་མ་བྱུང་བར་འདུག་ལ།",
    "གསོལ་ཆས་ནི་སྐབས་བསྟུན་གྱིས་ཡབ་གཞིས་དཔོན་ཚང་ནས་འབུལ་བ་ཡིན་འདུག་གོ།",
    "དེ་དུས་ང་རང་མི་ལོ་ཧྲིལ་པོ་གསུམ་ལ་སྐ་རགས་བཀྲོལ་ནས་གཏན་ཉལ་མ་མྱོང་ཞེས་དངོས་སུ་བདག་ལ་ཕེབས་སོ།",
    "ཞེས་པ་དེར་བབས་འདུག་ཚུལ་ཡང་བཀའ་ལས་ཐོས་སོ།",
    "དེའང་དུས་ཕྱིས་གཞན་ངོར་ཇི་ལྟཪ་སྣང་ཡང་ཉིད་ཀྱི་རང་སྣང་ལ་ཉམས་ལེན་ལས་མི་གཡོ་ཞིང་གྲོགས་སུ་འགྲོ་བ་ཞིག་ཡིན་ངེས་སུ་འདུག་སྟེ།",
    "དལ་གཅིག་ནས་བཞེངས་ཙ་ན་ཁོ་ཡང་རྗེས་མེད་དུ་ཡལ་ཞིང་སྐུ་ལ་ཅི་ཡང་མ་གནོད་པ་ཡིན་འདུག་ལ།",
    "མཉམ་པར་བཞག་སྟེ་ཅུང་ཟད་ཅིག་ནས་བཞེངས་པ་ན་ཞལ་འགྲམ་དུ་རྡོག་རྡོག་གཅིག་འདུག་པར་ལྗགས་ཀྱིས་འཕུལ་བའི་ཚེ་མངར་བའི་རོ་བྱུང་བ་དག་གདོད་རྗེས་སུ་དྲན་པ་བྱུང་ཞེས་ཀྱང་བཀའ་ལས་ཐོས་སོ།",
    "ཚོགས་སྐལ་ཉེ་གནས་བརྒྱུད་ནས་སྐུ་མདུན་དུ་སླེབ་པ་ནའང་དེ་བཞིན་འདུག་པར།",
    "ང་རང་ལ་དེ་དུས་རྟོགས་པའི་འགྲོས་དང་མཐུན་པའི་བར་ཆད་བྱེད་མཁན་ཞིག་ཡིན་པར་འདུག་ཅེས་ཕེབས་སོ།",
    "དེང་སྐབས་རིག་པ་ཤིན་ཏུ་དྭངས་པ་ཞིག་འདུག།",
    "ད་ལྟ་ཙམ་འཆི་ཡང་འགྱོད་པ་མི་འདུག་ཅེས་ཡང་ཡང་ཕེབས་པར།",
    "ཡང་དེང་སྐབས་ལམ་དུས་གསུངས་པ་ན་ཐ་མལ་གྱི་སྣང་བ་གཏན་མི་འདུག་ཅེས་དང་།",
    "དེ་ཉིད་གླིང་གཤིས་པའི་འདྲེ་ངན་དེ་ཡིན་འདུག་ཅེས་བཀའ་ལས་ཐོས་སོ།",
    "པའི་རྟགས་སུ་འདུག་གོ།",
    "མ་ཧཱ་ཀཱ་ལས་བུ་བཞིན་དུ་སྐྱོང་འདུག་ཅེས་ཕེབས་ཚུལ་བཀའ་ལས་ཐོས་སོ།",
    "ཆེན་པོ་གནང་འདུག་ཅེས་རྗེ་ཉིད་ཀྱིས་བཀའ་ལས་ཐོས་ཏེ།",
    "དེ་ཉིད་ད་ལྟའི་འདི་ཡིན་འདུག་གསུངས་ནས་དགྱེས་བཞིན་བྱོན་པས།",
    "འཇམ་དཔལ་སྨྲ་སེང་ཡབ་ཡུམ་ཡིན་རྒྱུ་ལ་ཁོ་བོས་ཡུམ་ཉིད་སྒེར་དུ་བསྒྲུབ་པ་ཡིན་པས་དེའི་ལུགས་སུ་གོ་ཡང་ནག་ཚང་ཕུབས་པ་དེ་མི་ལེགས་པ་ཡིན་འདུག་སྙམ་པ་བྱུང་ཞེས་བཀའ་ལས་ཐོས་སོ།",
    "དངོས་སུ་ཞལ་བསྟན་ཅིང་རྗེས་སུ་བཟུང་བ་ལའང་ཐེ་ཚོམ་མི་འདུག་སྙམ་པ་ཞིག་གསུངས་ཏེ།",
    "སྐད་ཅིག་དུས་ལ་མི་འགལ་བ།",
    "ཡང་ལན་ཅིག་མནལ་ལམ་དུ་རྗེ་ཉིད་ཀྱི་མདུན་དུ་རྒྱལ་པོ་བེ་ཀར་བཞུགས་འདུག་པར་ཞལ་སྔ་ནས།",
    "ཅུང་མི་འདོད་པའི་རྣམ་འགྱུར་དང་བཅས་ཏེ་ལོས་ཡིན་ལོས་ཡིན་ཟེར།",
    "རྗེ་བྲག་འཐབ་པའི་ས་ཕྱོགས་འཇིགས་སུ་རུང་བ་ཞིག་ནས་མེ་ལྕེ་གནམ་ས་གཉིས་ཀྱི་བར་དུ་མི་ཤོང་བ་ལྟ་བུ་ཞིག་བྱུང་སྐུ་དངོས་ནི་མཐོང་སྙམ་པ་མི་འདུག་ཅེས་ཕེབས་པར།",
    "ལྟ་བུ་མིན་འདུག་ཀྱང་།",
