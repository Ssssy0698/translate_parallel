    "དེ་ཡང་རང་བཞིན་ཉིད་ཀྱིས་རྟག།",
    "འོན་ཏེ་གཞན་ཡང་རང་བཞིན་གྱིས།",
    "དེ་མིན་འགྲོ་བ་དང་ལྡན་མིན།",
    "དེ་དག་དུས་ཀྱི་རྣམ་དབྱེ་བས།",
    "མ་བསལ་བས་ནི་གྲུབ་པ་ཡིན་། དེས་ན་འདི་ཡང་རང་ལ་གནས།",
    "མ་རྟོགས་ན་ཡང་རང་ཉིད་ཀྱིས།",
    "དེས་ན་ཁྱེད་རང་ཀུན་མཁྱེན་པས།",
    "དེ་ཡང་རང་དོན་མ་སྤངས་ཕྱིར།",
    "དེ་དངོས་གཞན་དུ་ཡང་འདུག་༢ི་མིན།",
    "བྱེད་ན་ཁྱེད་རང་སྨཱད་བྱར་འགྱུར།",
    "ཡུལ་དང་རང་བཞིན་དབྱེ་བ་ཡིས།",
    "དེ་ལ་འདི་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་མྱུ་གུ་དེ་ཡང་རང་ཉིད་ཀྱེས་བྱས་པ་མ་ཡིན།",
    "རྟགས་དེ་ཡང་རང་བཞིན་དང་འབྲས་བུ་དང་།",
    "རྒྱུ་དང་འབྲས་བུ་དག་ཀྱང་རང་བཞིན་ཐ་མི་ད་ད་པའི་༡ཕྱིར་བསྐྱེད་༡པར་བྱ་བ་དང་སྐྱེད་པར་བྱེད་པ་ཉིད་མ་ཡིན་ནོ།",
    "གཞན་དུ་ན་སྐྱེས་བུ་ཡང་རང་བཞིན་ད་ང་འགྱུར་བའི་ཐ་སྙད་དུ་བྱ་བར་འགྱུར་ར་རོ།",
    "ཡོད་པ་ཡང་རང་བཞིན་ཐམས་ཅད་གྲུབ་པའི་༧ཁྱད་པར་དུ་བྱར་མེད་པའི་ཕྱིར་དེ་ཇི་ལྟར་བྱེད།",
    "གང་ཡང་རང་བཞིན་དབྱེར་མེད་པའི་ཕྱིར་ཞེས་བྱ་བ་སྨྲས་པ་དེ་ཡང་མ་གྲུབ་སྟེ།",
    "གང་ཡང་རང་རྩོམ་པར་བྱེད་པའི་ཆ་ཤས་ཀྱི་ཁྱད་པར་དང་ལྡན་པའི་ཕྱིར་ཞེས་བྱ་བའི་སྒྲུབ་པར་བྱེད་པའི་གཏན་ཚིགས་ཀྱི་སྦྱོར་བ་དང་པོ་ནི་མ་༤གྲུབ་བོ།",
    "ཉེས་པའི་༧གནས་སྐབས་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "འོན་ཏེ་ཡང་རང་ལ་བྱེད་པ་འགལ་བ་ཉིད་ཇི་ལྟར་འགྲུབ་ཅེ་ན།",
    "འོན་ཀྱང་རང་བཞིན་རྒྱུར་སྨྲ་བའི་ལུགས་བླངས་ནས་བསྟན་པ་ཁོ་ནའོ།",
    "བ་ཐག་པ་རྐྱོང་ཡང་རང་བཞིན་གྱིས་འཇུག་པ་མ་༡ཧ་ཡིན་ནོ།",
    "ཅི་སྟེ་དེ་ཡང་རང་ལས་ཐ་དད་པའི་རིག་པར་བྱེད་པས་རིག་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་ཤེས་པ་གཞན་དག་ལ་ཡང་རང་རིག་པ་ཉིད་ཁས་ལེན་པ་ལ་སྡང་དུ་ཅི་ཡོད།",
    "ཅི་སྟེ་ཡང་གཏན་ཚིགས་ཀྱི་དོན་དེ་ཡང་རང་བཞིན་གྱི་༢ིཚིག་གཅིག་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་འདི་བརྗོད་པར་འདོད་དོ་༤།",
    "གནས་སྐབས་སྣ་ཚོགས་པ་ཡིན་ན་ཡང་རང་བཞིན་གཅིག་གོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་འདི་ལ་དོན་གཏོད་པར་བྱེད་པ་མེད་ཀྱི།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་དག།",
    "དེའི་ཚེ་༧ཁྱད་པར་མེད་པར་འགྱུར་ན་ཇི་སྲིད་དུ་ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་མི་དད་པའི་ཕྱིར་རྫས་དང་རྣམ་གྲངས་དག་གཅིག་ཏུ་འདོད་ལ།",
    "རྣམ་གྲངས་དག་ཅེས་བྱ་བ་ནི་གཟུགས་ལ་༡༡ཧ་སོགས་པ་དང་རང་རིག་པའི་རང་བཞིན་གྱི་སྡུག་བསྔལ་ལ་སོགས་པའོ།",
    "འོན་ཀྱང་རང་བཞིན་རྟག་ཏུ་གནས་པ་འཇིག་པ་མེད་པ་གང་ཡིན་པ་དེ་ནི་རྟག་པ་ཞེས་བྱ་སྟེ།",
    "དེའི་ཕྱིར་གང་ཞིག་དུས་ཕྱིས་སྐྱེ་བའི་འཇིག་པའི་དངོས་པོ་དེ་ནི་རང་བཞིན་༐",
    "དེ་ནི་སུས་ཀྱང་རང་བཞིན་གཞན་དུ་བྱ་བར་མི་ནུས་པའི་ཕྱིར་ར་རོ།",
    "ཅེས་བྱ་བ་ལ་ཡང་རང་བཞིན་གཞན་དུ་མི་འདོད་ད་དོ།",
    "གཞན་ལ་ཡང་རང་ལས་ཐ་དད་པའི་སོ་སོ་ཉིད་ཀྱི་མིང་ཅན་གྱི་ཡོན་ཏན་གཞན་མེད་པར་ཡང་འགྱུར་རོ།",
    "གནས་སྐབས་ཀྱང་རང་བཞིན་ལས་ཐ་མི་དད་པའི་ཕྱིར་དོན་གཞན་དུ་གྱུར་པའི་ལྡན་པ་མ་གྲུབ་པོ།",
    "གལ་ཏེ་འདི་སྙམ་དུ་སྐད་ཅིག་མ་མ་ཡིན་པའི་དངོས་པོ་ཁྱད་པར་མེད་པ་དེ་ལྟ་ན་ཡང་རང་བཞིན་གྱིས་དེ་འགྲོ་བ་པོ་ལ་སོགས་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་བྱ་བ་དང་ལྡན་པ་ཉིད་དུ་འགྱུར་བས་དེའི་ཕྱིར་གཏན་ཚིགས་མ་ངེས་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་༤པའི་དོགས་པ་བསུ་ནས།",
    "ཇི་ལྟར་ཨ་རུ་ར་ལ་སོགས་པ་༡མང་པོ་རྣམས་སྤྱི་མེད་པར་ཡང་རིམས་༡༡ལ་སོགས་པ་ཞི་བའི་མཚན་ཉིད་ཀྱི་འབྲས་བུ་གཅིག་བྱེད་པ་བཞིན་དུ་ཁྲ་བོ་ལ་སོགས་པ་ཡང་དོན་ཐ་དད་ན་ཡང་སྤྱི་དངོས་པོར་གྱུར་པ་མེད་ཀྱང་རང་བཞིན་གཅིག་པ་ཅན་གྱི་སྲེ་བའི་ཤེས་པའི་རྒྱུར་གྱུར་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་འཚེད་དོ་ཞེས་བྱ་བ་འདི་ནི་བཏང་སྙོམས་སུ་འདུག་པ་ད་ང་གཞན་ཡང་ཟ་བ་འམ།",
    "ཞེས་བྱ་བ་ནི་བཏང་སྙོམས་སུ་འདུག་པ་ལ་སོགས་པའི་མ་ཡིན་པར་ད་གག་པའི་བདག་ཉིད་ཀྱི་བསལ་བར་བྱ་བ་དེ་དང་དེ་ཡོད་དོ་ཞེས་འབྲེལ་ཏོ།",
    "འདི་ནི་དེས་དབེན་པའི་ཞེས་བྱ་བ་ནི་བཏང་སྙོམས་སུ་འདུག་པ་ལ་སོགས་པ་ལས་དབེན་པའོ་། སྒྲུབ་པའི་ངག་དང་གཞན་ལས་ལྡོག་པར་མཚུངས།",
    "དེའི་ཚེ་ཡང་རང་ཉིད་ཀྱིས་གཏན་ཚིགས་མ་ངེས་པ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིཕྱིར།",
    "རྒྱུ་དང་རང་བཞིན་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་བཞིན་དུ་གཏན་ཚིགས་ལ་སོགས་པ་འདིར་ཡང་རང་བཞིན་བཟུང་བ་ཁོ་ནའོ།",
    "ཅི་སྟེ་སྒྲ་རྣམས་ནི་རྟག་པའི་ཕྱིར་དུས་ཐམས་ཅད་དུ་གནས་པས་དོན་དང་ལྷན་ཅིག་དུས་ཐ་དད་པ་མ་ཡིན་ལ།",
    "ཁ་ཅིག་དུས་གཞན་དུ་དཔུང་རྒྱན་མཚར་པོ་ཅན་གྱི་སྒྲ་དེ་ལ་མཛེས་པའི་ཅོད་པན་ཅན་༩གྱི་མཆོག་སྦྱིན་རྟོགས་པ་ནི་མ་ཡིན་ནོ།",
    "མ་མཐོང་བ་ཡང་ཞེས་བྱ་བ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པའོ།",
    "དེ་ལ་༦ལྡོག་པ་ན་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པའི་ལྐོག་ཏུ་གྱུར་པ་ལྡོག་པ་ཡང་མ་ཡིན་ནོ།",
    "གཞན་ཡང་རང་བཞིན་གཉིས་པ་མེད་པའི་ཕྱིར་གཅིག་ཉིད་ཡོད་པའི་ཕྱིར་འགྲོ་བ་ཐམས་ཅད་དངོས་པོ་གཅིག་ཏུ་འགྱུར་བས་གཅིག་དུ་མའི་རྣམ་པ་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་༡དམ་བཅའ་བ་ཉམས་པར་འགྱུར་རོ།",
    "འདི་ལྟར་བུམ་པ་ལ་༧སོགས་པའི་དངོས་པོ་ལས་ལྡོག་པའི་སྣམ་བུ་ལ་སོགས་པ་དེའི་བདག་ཉིད་དང་བྲལ་བར་བསྒྲུབ་པར་འགྱུར་བ་འབའ་ཞིག་ཏུ་ཟད་ཀྱི་ཐམས་ཅད་དང་རང་བཞིན་མེད་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ཡིན་དང་གཅིག་སྐྱེད་པར་བྱེད་པ་དང་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་འགལ་བ་དེ་ཉིད་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "གང་ཟག་དང་རྒྱུན་༢ི་རང་བཞིན་མེད་པ་དེ་བཞིན་དུ་བྱ་བ་ཡང་རང་བཞིན་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་དུས་དཔག་ཏུ་མེད་པར་འགྱུར་བ་སོ་ན་འདུག་པ་ཡིན་ན་ནོ།",
    "འཁྲུལ་པ་ཞེས་བྱ་བ་ནི་ཉམས་སུ་མྱོང་བ་ཇི་ལྟ་བ་༡བཞིན་དུ་སོ་སོར་ངེས་པའི་ཡུལ་དང་དུས་དང་རང་བཞིན་ལ་སོགས་པའི་ཁྱད་པར་གྱི་ངོ་བོས་མི་འཇུག་པའི་ཕྱིར་རོ།",
    "ཐམས་ཅད་ཀྱི་རང་རང་སོ་སོར་རིག་པའི་ཕྱིར་ར་རོ།",
    "གང་དང་རང་རིག་པ་ཡིན་པ་དེ་དང་དེ་ནི་ཤེས་པ་ལས་དོན་གཞན་དུ་གྱུར་པའི་ཡུལ་ཅན་མ་ཡིན་ཏེ།་",
    "དེ་ལྟ་བས་ན་ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་དད་དུ་ཡོད་པའི་ཕྱིར་བུམ་པ་ལ་སོགས་པ་བཞིན་དུ་སྒྲ་ཐ་དད་པ་༦དང་མི་རྟག་པར་གྲུབ་པའི་ཕྱིར་དེ་ཇི་ལྟར།",
    "བློ་གསལ་བ་དང་གཞན་༢པ་ལ་སོགས་པ་ཐ་དད་པར་འགྱུར་བ་དེ་བཞིན་དུ་སྒྲ་ཡང་རང་ལས་རང་བཞིན་ཐ་དད་པ་མེད་ན་ཡང་གསལ་བར་བྱེད་པའི་སྒྲ་ཙམ་ཐ་དད་པའི་ཕྱིར་རིང་པོ་ལ་སོགས་པ་ཐ་དད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སྐྱོན་མེད་དོ།",
    "འདི་ལྟར་དེ་དག་རིགས་ཀྱི་ཁྱད་པར་ཐ་དད་མ་ཡིན་ཡང་རང་ལས་རིམ་པ་ཡོད་པ་མ་ཡིན་ཏེ་ཆ་ཤས་མེད་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱིས་ཡིན་ཏེ།",
    "དེ་ཡང་རང་ཉིད་འོད་མ་ལ་སོགས་པ་དྲུང་པ་ལས་བྱུང་བ་གང་ཡིན་པ་དེ་འདིར་འཁྲུལ་པའི་ཡུལ་ཉིད་དུ་བལྟ་བར་༐",
    "ཉེས་པ་རྣམས་ནི་སྐྱེས་བུ་ལ་བརྟེན་པའི་ཕྱིར་དེ་ལ་ལོག་པ་ཉིད་དུ་རྟོགས་ཀྱི་སྐྱེས་བུས་མ་བྱས་པ་ལ་ནི་མ་ཡིན་ནོ་ཞེས་ཀྱང་བརྗོད་པར་ནུས་པ་མ་ཡིན་ཏེ་སྐྱེས་བུས་མ་བྱས་པ་དག་ལ་ཡང་རང་བཞིན་གྱིས་ལོག་པའི་དོན་ཤེས་པའི་༡རྒྱུ་ཉིད་སྲིད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྐྱེས་བུའི་འདོད་པ་ཡང་རང་དགའ་བ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཉེ་བ་དང་བསྐལ་པ་ད་ག་དུས་མཚུངས་པར་འཛིན་པའོ།",
    "དེ་ལྟ་ཡིན་དང་འཇིག་པ་འདི་གཉིས་ཀྱང་རང་བཞིན་མེད་པ་ཡིན་ན།",
    "དེ་ཡང་རང་ཉིད་ལས་གནས་པའི་ཕྱིར་ཐུག་པ་༐",
    "ད་ག་ལ་༥ཡོངས་སུ་ཤེས་ལ་དེ་ལྟ་༦ན་ཡང་དེ་ལྟ་བུ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ལྟ་བུའི་རྣམ་པར་གཞག་པ་ཐམས་ཅད་ཉམས་པ་ཐུག་པ་མེད་པའི་གནས་སྐབས་དེ་ཉིད་སོ་ན་འདུག་པ་ཡིན་ནོ།",
    "དེ་དག་དུས་ཕྱིས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "འདི་ལ་ཡུལ་ད་ང་དུས་དང་རང་བཞིན་དང་གནས་སྐབས་ཇི་ལྟ་བ་བཞིན་དུ་སྣང་བ་ཡོད་པ་མ་ཡིན་ལ།",
    "རང་ལས་གྲུབ་པ་ཡིན་ན་ཡང་རང་ཉིད་གསལ་བའི་བདག་༐",
    "འདི་ལྟར་མི་༡ད་མིགས་པ་ཡང་དངོས་པོ་མེད་པའི་བདག་ཉིད་ཡིན་པར་ཇི་ལྟར་གྲུབ་ཅེས་དེ་ལ་ཡང་རང་ངམ་གཞན་ལས་ཞེས་བྱ་བའི་བསམ་པ་འདི་འཇུག་པ་ཉིད་ད་དོ།",
    "རྟག་པའི་ཕྱིར་དང་རང་བཞིན་དུ་བྱ་བར་མི་ནུས་པའི་ཕྱིར་ར་རོ།",
    "དེ་ལྟ་ཡིན་དང་སྐྱོན་གྱི་གནས་སྐབས་སོ་ན་འདུག་པ་ཡིན་ནོ་སྙམ་ན་༢ི།",
    "དེ་ལྟ་བས་ན་ཐེ་ཚོམ་ཟ་བ་སོ་ན་འདུག་པ་ཡིན་ན་ནོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་དད་པས་དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་ཐ་དད་པར་རིག་༥པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་དང་རང་ཉིད་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་ཁས་༐",
    "དེ་ཡང་རང་བཞིན་དང་།",
    "ཇི་ལྟར་མི་དམིགས་ན་ཡང་ཐམས་ཅད་མཁྱེན་པ་ཡོད་པ་ལ་ཐེ་ཚོམ་ཟ་བ་དེ་བཞིན་དུ་དམིགས་ན་ཡང་ཐམས་ཅད་མཁྱེན་པའི་ཡུལ་ལ་ཐེ་ཚོམ་བྱ་༨བ་ཡིན་ཏེ་གཉིས་ཀ་ཡང་རང་བཞིན་གྱིས་༐",
    "གལ་ཏེ་ཡོད་པ་༡༡ཉིད་དང་ཤེས་བྱ་ཉིད་ཡོད་པ་ན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལྡོག་པ་ཡིན་ནོ་ཞེས་ཁྱེད་ཀྱི་༡ཁས་ལེན་པ་དེ་ལྟ་ན་ནི་ཡོད་པ་ལ་སོགས་པ་ཉེ་བ་ལས་སྔར་འདིའི་མེད་པ་ཉིད་དང་རང་རིག་པས་ཀྱང་ཤེས་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་ཅེས་ཁས་བླངས་པར་འགྱུར་ལ།",
    "རྣམ་པར་རྟོག་པ་ཡང་རང་བཞིན་གྱིས་འཁྲུལ་པ་ཡིན་པའི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པ་ལ་མངོན་དུ་འགྱུར་ན་འཁྲུལ་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེའི་གོ་བ་ལེགས་པོ་ཞིག་ནག་པོར་བཞག་པ་འདི་ཡིན་པར་འདུག་ཟེར།",
    "བརྡ་སྦྱོར་གྱི་འབྲེལ་བས་དེ་སྐབས་ཀྱི་བརྗོད་བྱ་སྣང་སྟོབས་ཀྱིས་གོར་རུང་ཞིང་རང་མཚན་གྱི་ནུས་སྟོབས་ཀྱིས་སྟོང་སྟེ།",
    "འདྲེན་པ་རང་བྱུང་རང་རྒྱལ་ཚུལ་གཅིག་ཅིང་།",
    "དེ་གཉིས་ཀྱང་རང་ཀུན་ནས་སློང་བའི་སེམས་པ་གཞན་ལ་རིག་པར་བྱེད་པས་རྣམ་པར་རིག་བྱེད་དོ།",
