    "རྒོད་པོས་ནམ་འཕང་བཅད་ནས་འཕུར་བ་དང་བྱ་གཞན་ཚང་མས་ཀྱང་དེ་ལ་ཐག་བཅད་དེ་སོ་སོའི་གནས་སུ་སོང་ངོ།",
    "བྱ་རྣམས་ཕར་ལབ་ཚུར་ལབ་བྱེད་ལུགས་དོན་འགྲིག་ཆགས་ཀྱི་རྡོག་ཁ་འདི་ལྟར་ལབ་ཚུལ་དེ་ལ་བྱ་རྒྱལ་རྒོད་པོས་ཐག་བཅད་པ་ལྟར་བྱ་ཚང་མ་མོས་ཤིང་ཐག་བཅད་སོང་བས།",
    "ད་ཁྱོད་རང་སྤྲེའུ་རྣམས་ནི་དོན་བྱིངས་སྔར་ས་ད་གནས་ཀྱི་ཐོག་སྤང་རིའི་སུམ་ཆ་གཅིག་ཕྱིན་ཆད་གཙང་དག་གི་ཁས་བླངས་ཡོད་པས་ཉན་དགོས་པ་ཧ་ཅང་ཆེ་ཞིང་།",
    "སྤྲེའུ་ཚང་མ་དགའ་ཞིང་ཤིང་ཏོག་དང་མེ་ཏོག་རྩི་ཏོག་སོགས་ཧ་ཅང་མང་བ་ཁོང་གཉིས་ལ་ལེགས་སྐྱེས་ཀྱི་ཚུལ་དུ་སྤུངས་ཐོག་སྤྲེལ་རྒན་བློ་བཟང་གིས་འདི་སྐད་སྨྲས་སོ།",
    "ཁོང་འདབ་ཆགས་ཆེ་ཆུང་གྲངས་མེད་རེད།",
    "ངེད་སྤྲེའུ་མང་ཉུང་འདི་ཙམ་རེད།",
    "དེ་རེ་ལ་བློ་སེམས་རེ་རེ་ཡོད།",
    "ཆུ་བརྒྱ་སྟོང་གི་ཆུ་སྣ་གཅིག་ཏུ་བསྒྲིལ།",
    "བྱ་སྤྲེལ་གཉིས་ཀའི་འདུན་མར་གཟིགས།",
    "ཡོ་འཁྱོག་འདུག་ན་དྲང་པོར་སྲོངས།",
    "དེ་ནས་རྡོ་རམས་པ་བློ་བཟང་རིན་ཆེན་ཀློག་གི་སློབ་དཔོན་དུ་བསྟེན་ནས་ཀ་མད་སྦྱོར་ཀློག་དང་བློ་འཛིན་སོགས་ལེགས་པར་སྦྱངས་ཤིང་།",
    "དབུས་གཙང་གི་མཁས་མང་དབུས་ན་རྒྱལ་མཚན་གྱི་ཏོག་ལྟར་ཀུན་གྱིས་བཀུར་བར་བྱ་བའི་གནས་སུ་གྱུར།",
    "དགུང་ལོ་དྲུག་ཅུ་རེ་གཉིས་པ་རབ་བྱུང་བཅུ་བཞི་པའི་ཆུ་ལུག་སྤྱི་ལོ་ལོར་སྐུ་གཤེགས།",
    "ཁྱོད་ཀྱི་ཞབས་ལ་བདག་ཀྱང་ཕྱག་བགྱིད་དོ།",
    "རྒྱལ་ཀུན་མཁྱེན་པའི་དཔལ་དང་ནམ་མཁའི་ཁྱོན།",
    "གཟིགས་པ་རྣམ་ལྔའི་དགེ་མཚན་སྐྱ་རེངས་ཤར།",
    "རང་གི་བྱེད་པ་ཇི་ལྟར་རང་ལ་འཇུག།",
    "འགར་ཡང་མངོན་ཞེན་དམིགས་གཏད་རེ་བ་མེད།",
    "བསྙོན་མེད་འཆར་བའི་ངོ་མཚར་གཟིགས་མོ་ཡིས།",
    "བློ་ལྡན་སྒེག་མོའི་དགོས་དོན་ཅི་ཡང་འགྲུབ།",
    "དེ་ཡིས་ཁྱོད་ཀྱི་མགུར་ནས་བསྒྲགས་པ་བཞིན།",
    "བསྟན་པའི་གདུགས་དཀར་རྩིབས་མ་རེ་རེ་སྟེ།",
    "ཡུ་བར་ཕུལ་བྱུང་ཞབས་དང་ཁྱོད་ཀྱིས་གཟིགས།",
    "རྒྱལ་བསྟན་མིང་གི་ལྷག་མར་གྱུར་པ་ན།",
    "ཐར་འདོད་ཡོངས་ཀྱི་རེ་བ་གཅིག་ཅར་བསྐངས།",
    "འཕྲོག་བྱེད་རང་གི་སྙེམས་པའང་གཏིང་དུ་བྱིངས།",
    "གྱུར་པ་ཁྱོད་གསུང་རྣམ་པ་ཀུན་དང་ལྡན།",
    "ཁྱོད་ཀྱི་མཛད་པས་ཐུབ་བསྟན་མཐའ་དག་དང་།",
    "མགོན་ཁྱོད་མགོན་དུ་བསྟེན་རྣམས་སྐལ་བ་བཟང་།",
    "ཁྱོད་ཞབས་པདྨའི་དྲུང་དུ་བསྙེགས་པ་ནི།",
    "གང་གི་ཡོན་ཏན་རྨད་བྱུང་སྦྲང་རྩིའི་ཆང་།",
    "ཡབ་གཅིག་ཁྱོད་ཀྱི་ཐུགས་རྗེས་ཡོངས་བཟུང་བའི།",
    "གངས་ཅན་བསྟན་འཛིན་ཀུན་གྱི་རྩེ་མོར་སོན།",
    "འདུས་ཞལ་གཅིག་པུར་གྱུར་པ་ཁྱོད་ཀྱི་ཞབས།",
    "ངེས་ལེགས་ཁང་བཟང་རྩེ་མོར་འཇུག་གྱུར་ཅིག།",
    "ཁྱོད་བཞིན་ཁྱོད་ཀྱི་གསང་བའི་མཛོད་བཟུང་སྟེ།",
    "རྣམ་དཀར་དགེ་ཚོགས་མགོན་ཁྱོད་ཐུགས་བསྐྱེད་ཀྱི།",
    "ལེགས་ཉེས་བླང་དོར་མ་ལུས་གཟིགས་པའི་ཐུགས།",
    "ལེགས་པའི་ལམ་སྟོན་འདྲེན་པ་གཙུག་གིས་མཆོད།",
    "མཆོག་དམན་སྐྱེས་བུའི་རེ་བ་རྫོགས་མཛད་པ།",
    "གནས་གསུམ་གཞལ་བྱའི་ཁྱོན་ཡངས་ཇི་སྙེད་དང་།",
    "གནས་ལུགས་ཇི་ལྟ་བ་ཡི་དོན་གཟིགས་ཤིང་།",
    "ས་སྟེང་མཁས་པ་ཀུན་གྱི་གཙུག་གི་རྒྱན།",
    "ཕྱོགས་གླང་གྲགས་པའི་རིགས་ལམ་ཟབ་མོ་ཡིས།",
    "ཤིན་སྦྱངས་མཆོག་གིས་ཟིན་པའི་ཏིང་ངེ་འཛིན།",
    "སྣང་བྱེད་སྨྲ་བའི་ཟླ་བ་ཁྱོད་མིན་སུ།",
    "རྡོ་རྗེའི་རྣལ་འབྱོར་ཟབ་མོར་གཞོལ་བ་ཡིས།",
    "རབ་ཏུ་བརྟན་པའི་རིམ་གཉིས་ལམ་བཟང་གིས།",
    "ཐ་སྙད་རིགས་ལམ་ཕྲ་མོ་ནས་བཟུང་སྟེ།",
    "གང་ཞིག་ཁྱོད་ཞབས་པདྨོ་བསྟེན་པ་རྣམས།",
    "ཡིད་བཞིན་ནོར་ལྟར་འགྲོ་བའི་རེ་བ་སྐོང་།",
    "ཁྱོད་མིན་སྐྱབས་གཞན་འགའ་ཡང་མི་འཚོལ་བས།",
    "ཁྱོད་ཀྱིས་ཐུགས་རྗེས་ནམ་ཡང་མ་གཏོང་ཞིག།",
    "ཨ་མཆོག་ལམ་རིམ་གྲྭ་ཚང་གི་སློབ་ཟུར་ལྷག་བསམ་རྣམ་དཔྱོད་ཕུལ་དུ་བྱུང་བ་འཇམ་དབྱངས་ཕུན་ཚོགས་ཀྱིས་བསྐུལ་ངོར།",
    "གང་གི་ཞབས་སེན་འོད་ཀྱིས་རེག་པ་ཡིས།",
    "ནོར་འཛིན་ཕ་མཐའ་བརྒལ་བའི་རོལ་མོ་ནི།",
    "དེ་ཚེ་ཛམས་མཚན་པའི་ལྷོ་གླིང་གི།",
    "ལས་དང་ཉོན་མོངས་རླན་གྱིས་མ་བསྐྱེད་ཅིང་།",
    "རི་མོ་ཡོངས་སུ་སྨིན་པའི་བཀོད་པ་ནི།",
    "རེག་འཇམ་པཉྩ་ལི་ཀའི་རྗེས་སུ་འགྲོ།",
    "སིམ་པའི་ཚོར་བ་མཆོག་གི་བདེ་དགའ་སྐྱེད།",
    "དཀར་སེར་དམར་ལྗང་སྔོ་བའི་མེ་ཏོག་གི།",
    "རེག་བྱ་མཆོག་གིས་བགྲོད་ལ་ངལ་གསོ་སྦྱིན།",
    "ཆུ་མཐོངས་དཔལ་གྱི་བེའུའི་རེ་མིག་ཀུན།",
    "ཉི་གཞོན་ལང་ཚོ་དར་བ་ལྷ་ཡི་བུ།",
    "མྱུར་གསལ་གློག་གི་འོད་དང་སྐར་མདའ་བཞིན།",
    "འབུམ་ཕྲག་ཉིན་མོར་བྱེད་པའི་ཕུང་པོ་བཞིན།",
    "དགའ་སྐྱེད་ལྷ་མོའི་ཚོགས་ཀྱིས་མཆོད་བྱེད་ཀྱང་།",
    "ཁྱོད་ནི་རྣམ་དཔྱོད་ལུས་མཛེས་ཤིང་།",
    "ཞེས་གསུངས་པ་ལྟར་འཇིགས་མེད་རྣམ་པར་དཔྱོད་པའི་ལུས་རྩལ་ཡོངས་སུ་རྫོགས་པའི་བློ་གྲོས་ཀྱི་ལང་ཚོ་དར་ལ་བབ་ཅིང་།",
    "བློ་མིག་མ་རིག་གིས་ལྡོངས་འགྲོ་བ་རྣམས།",
    "བཀའ་ཡི་རྩེ་དགའ་བགྱིས་པ་ཁྱོད།",
    "སྨྲ་བ་ངན་པའི་གཡུལ་ངོ་མཐའ་དག་བཅོམ་སྟེ་འཇམ་མགོན་རྒྱལ་བའི་རིང་ལུགས་མི་ནུབ་བསྟན་པའི་རྒྱལ་མཚན་སྲིད་པའི་རྩེ་མོར་བསྒྲེངས་པ་མཁས་གྲུབ་བྱེ་བའི་བསྟི་གནས་རྨད་དུ་བྱུང་བ་འདིར།",
    "བསྟན་པ་རིན་ཆེན་མཆོག་གིས་མ་ཁྱབ་པའམ།",
    "རིགས་པའི་ཉིན་བྱེད་ཁྱོད་དྲིན་ལས།",
    "རྫོགས་ལྡན་གསར་བའི་དགའ་སྟོན་བཀྲ་ཤིས་རྒྱ་མཚོའི་རླབས་ཀྱིས་ཁྱབ་པར་འགྱུར་བ་ཡིན་པར་ཐལ།",
    "ནང་ཕྱིན་དྲུག་གི་ཉམས་ལེན།",
    "ངེས་དོན་ཟབ་མོ་དྲུག་ཅུའི་དབྱངས་སྙན་གྱིས།",
    "སྲིད་པའི་ཚང་ཚིང་བསྲུང་བའི་ཉོན་མོངས་སྦྲུལ།",
    "འགྲོ་བའི་ལེགས་བྱས་ཤར་རིའི་རྩེ་མོར་དྲངས་པའི་དགེ་ཚོགས་ལ་བརྟེན་ནས།",
    "བསླབ་གསུམ་གེ་སར་རྒོད་པའི་བཅུད་ཀྱིས་མཐའ་ཀླས་ལུས་ཅན་མཐའ་དག་ཚིམ་པར་འགྱུར་བ་ཡིན་པར་ཐལ།",
    "བདག་གི་བློ་གྲོས་པདྨ་ཁ་ཕྱེ་ནས།",
    "བཀའ་ཡི་རྩེ་དགའ་བགྱིས་པ་ཁྱོད།",
    "ས་སྟེང་གི་ཐུབ་པའི་བསྟན་པ་ཡོངས་ཀྱི་མངའ་བདག་གོང་ས་ཐམས་ཅད་མཁྱེན་ཅིང་གཟིགས་པ་ཆེན་པོ་ཆེ་གེའི་ཞལ་སྔ་ནས་ཀྱིས་གཙོས་ས་སྟེང་གི་བསྟན་འཛིན་དམ་པ་རྣམས་ཞབས་ཟུང་གཡོ་མེད་གཞོམ་གཞིག་བྲལ་བ་རྡོ་རྗེའི་ཁམས་ལྟར་བརྟན་ཅིང་།",
    "འཁོར་ལོ་གསུམ་གྱི་མཛད་བཟང་ནམ་ཡང་ཉམས་པ་མེད་པའི་མཐུ་ལ་བརྟེན་ནས་དགེ་ལྡན་ལུགས་བཟང་འདི་ཉིད་མཐའ་དབུས་ཀྱི་འཛིན་མའི་ཁྱོན་ཀུན་ཏུ་དར་ཞིང་རྒྱས་ལ་ཡུན་རིང་དུ་གནས་པར་འགྱུར་བ་དང་།",
    "བཀྲ་ཤིས་འཁོར་ལོས་མཚན་པའི་ཞབས་ཟུང་གིས།",
    "བཀྲ་ཤིས་རི་མོས་མཚན་པའི་ལྷ་དར་འདི།",
    "ཐུབ་བསྟན་ནོར་བུའི་ཏོག་རང་གིར་འཛིན།"
  ]
}