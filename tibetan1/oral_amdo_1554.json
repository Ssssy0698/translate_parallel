    "གྲོགས་པོ་དེ་དག་གི་གམ་དུ་ཁ་སྙན་ཚིག་འཇམ་གྱི་གཏམ་སྙན་བརྗོད་མི་ཤེས་པས་ཡིན་ནམ།",
    "བཞུད་ཟིན་པའི་དཀའ་ཚེགས་ཀྱི་ལོ་ཟླའི་འཁོར་འགྲོས་དེ་དག་གི་ནང་།",
    "མིག་མདུན་གྱི་འཚོ་བས་ཁྱེད་ལ་འཛེམ་བག་མེད་པའི་ཀུ་རེ་བྱས་ཀྱང་།",
    "རང་མགོ་རང་གིས་སྲུང་མཁན་གྱི་མི་བུ་དེ་ཡིན།",
    "ལོ་ཟླ་མང་བོ་ཞིག་ཕར་ལ་འདས་བཞིན་འདུག་ལོ་ངོ་དེ་དག་གི་ནང་ཁོས་རང་ཉིད་ཀྱི་ཆེས་ཐོག་མའི་དམ་བཅའ་དང་རྨི་ལམ་སེམས་དཀྱིལ་དུ་བཞག་སྟེ་གཏན་ནས་མཚམས་འཇོག་བྱས་མེད་པ་རེད་ཨང་།",
    "ཁོས་དེ་ལྟར་སྙན་ངག་གི་བུ་མོ་ཆུང་མར་བསུས་ནས་སེམས་ཁོང་གི་དགའ་སྐྱོ་ཆགས་སྡང་དང་།",
    "བདེ་སྡུག་བཏང་སྙོམས་ཀྱི་ཚོར་བ་མཐའ་དག་སྙན་ངག་གི་ལྷ་མོར་བརྗོད་བཞིན་འདུག་དེའང་ཡིན་ཏེ།",
    "སྙན་ངག་གི་ལྷ་མོ་ཁོ་ནས་ད་གཟོད་ཁོ་ལ་སྒུལ་ཤུགས་དང་སེམས་གསོ་སྦྱིན་པར་བྱེད་ལ།",
    "ཁོ་ལ་བདེ་སྐྱིད་དང་ཚོར་སྣང་ཁྱད་པར་བ་རེ་སྦྱིན་པས་ཡིན།",
    "ཁྱེད་ནི་སྲི་ཞུ་བསྙེན་བཀུར་མེད་པའི་མི་ཞིག་རེད།",
    "ཁོ་ནི་མི་ཨུ་ཚུགས་ཅན་ཞིག་རེད།",
    "ཉི་མ་རེ་རེ་བཞིན་འདས་སོང་།",
    "ལོ་ངོ་དེ་དག་གི་དཀའ་སྤྱད་འབད་བརྩོན་དང་།",
    "དཀའ་ཚེགས་ཀྱི་རྔུལ་ཆུ་ལ་བརྟེན་ནས་བྲིས་པའི་སྙན་ངག་དག་ལ་ཀློག་པ་པོ་ཧ་ཅང་དཀོན་པས་རེད།",
    "དེ་ནི་ངོ་མ་མནར་གཅོད་ཅིག་རེད་ཡཱ།",
    "ཕྱི་རོལ་དུ་ཁ་བ་སྐྱ་ལྷེབ་ལྷེབ་ཏུ་བབས་ཀྱིན་འདུག་ཁོ་རང་འདུག་སའི་མལ་ཤག་གི་ཕྱི་རོལ་ནས་བྱིས་པ་མང་པོའི་རྩེད་འཇོའི་དགོད་སྒྲས་ཁེངས་འདུག་གལ་ཏེ་ང་རང་བྱིས་པ་ཞིག་ཡིན་ན་ཅི་མ་རུང་།",
    "ཁྱིམ་ལ་ལོག་ཐེངས་རེར།",
    "ཁྱིམ་མཚེས་ཚོས་རང་གི་ཕྲུ་གུའི་ངོ་སོ་དགུང་ལ་བསྟོད་དེ།",
    "ཡོང་སྒོ་ཇི་ལྟར་བཟང་མིན་སོགས་རང་གི་ཕྲུ་གུའི་འཇོན་ཐང་ཁོ་ན་བརྗོད་ཀྱིན་ཡོད་པས།",
    "སྙན་ངག་པ་ཁྱིམ་ལ་འབྱོར་ཐེངས་རེར།",
    "ད་དུང་རང་གི་སེམས་པ་མཚོན་བྱེད་འཁྱེར་འོངས་པའི་ལག་རྟགས་མི་ཆུང་བ་འགའ་འཁྱེར་ཏེ་ཁྲུའུ་ཀྲང་བཀྲ་ཤིས་ཀྱི་ཁྱིམ་དུ་འཚང་ཁ་ཤིག་ཤིག་ངང་འགྲོ་བཞིན་འདུག་ང་མི་སྒེར་གྱི་སེམས་པའི་མཚོན་བྱེད་དུ་སྒོར་སུམ་སྟོང་དེ་ནི་གསར་དུ་ལས་བྱེད་དུ་སླེབས་མ་ཐག་པའི་གཞོན་གསར་ཚེ་རིང་རེད།",
    "དེ་ནི་ངའི་ཕ་ཡུལ་གྱི་ཐོན་ཁུངས་ཕྲན་བུ་ཡིན་སྦྱིན་བདག་ཨ་ཕོ་དངོས་གྲུབ་ཀྱིས་དེ་ལྟར་བརྗོད་ཞོར།",
    "དབྱར་རྩྭ་དགུན་འབུ་སློ་མ་གང་ཁྲུའུ་ཀྲང་བཀྲ་ཤིས་ཀྱི་གམ་དུ་བཞགསྙན་ངག་པས་ཀྱང་ཁྲུའུ་ཀྲང་བཀྲ་ཤིས་ཀྱི་གམ་དུ་སོང་སྟེ་ཁྲུའུ་ཀྲང་བཀྲ་ཤིས་ཀྱི་ཁྱིམ་མི་རྣམས་ལ་མཇལ་དཪ་ཪེ་བསྒྲོན་པ་དང་།",
    "སྙན་ངག་པར་ཡང་ཡང་ལྟ་བཞིན་སྐད་ཆ་དབ་དིབ་བར་མེད་བརྗོད་བཞིན་འདུག་ཁོ་ཚོའི་མིག་ཟུང་དེ་མ་ཐག་ཏུ་གྱུར་སོང་།",
    "འགའ་རེས་ཁྲུའུ་ཀྲང་གི་བུ་ལ་ཤོག་སྙིགས་འགའ་སྤྲོད་པ་ནི་ཁྲུའུ་ཀྲང་མིག་ནང་དུ་གཏན་ནས་མི་འཇོག་པ་རང་རེད་ཟེར་ཏེ།",
    "ཡུད་ཙམ་ཞིག་རིང་གནས་དེར་འདུ་འཛིའི་སྨུག་སྤྲིན་ཅིག་གིས་རཔ་ཏུ་འཁྲིགས་འདུག་སྙན་ངག་པས་ཁུ་སིམ་མེར་གྱང་ངོས་སུ་མིག་ཟུང་ཅེར་བཞིན་མིག་མདུན་གྱི་འཇིག་རྟེན་འདི་དང་རང་ཉིད་ཀྱི་བར་ལ་མངོན་གསལ་མིན་པའི་རྒྱང་ཐག་རིང་བོ་ཞིག་ཆོད་ཡོད་པའི་ཚོར་སྣང་ཞིག་ངང་གིས་སྐྱེས།",
    "ཉིན་དཀར་དང་མཚན་མོ་ཅི་འདྲ་ཞིག་ཡིན་རུང་ད་ནི་སྙན་ངག་པས་ཕྱི་རོལ་དུ་གཏན་ནས་འགྲོ་མ་འདོད།",
    "སྒོ་མོ་བསྣན་ཏེ་ཁུ་སིམ་མེར་འདུག་རྒྱུ་ནི་བདེ་སྐྱིད་ཅིག་ཀྱང་ཡིན།",
    "མཚན་མོའི་ནམ་ཟླ་ཧ་ཅང་འཁྱུག་རྒྱང་རིང་ནས་གསལ་ལ་མི་གསལ་བའི་གློག་སྒྲོན་གྱི་འོད་མདངས་ཤིག་ལྗོན་ཤིང་གི་ལོ་མའི་གསེབ་ནས་ངའི་ཕྱོགས་སུ་འཕྲོས་འོང་།",
    "སྨག་རུམ་གྱི་ཡོལ་བས་མིག་མདུན་གྱི་ཡོད་ཚད་ནག་མོག་མོག་ཏུ་བསྒྲིབས་པར་བྱས་ཀྱང་།",
    "ངས་དེ་ལྟར་རང་གིས་རང་ལ་འདྲི་ཚིག་ཅིག་འཕེན་ཞོར་རང་ཁྱིམ་དུ་ལོག་པའི་ལམ་ལ་ཞུགས་པ་ཡིན།",
    "བཟང་ངན་གཉིས་ཀྱི་རྒྱལ་ཕམ་འབྱེད་པའི་གཡུལ་འགྱེད་ཁྲོད་ནས་ང་རང་གི་ལུས་ཕུང་རྨ་ཁས་གང་ཞིང་།",
    "འདུ་འཛི་དང་ཟང་ཟིང་གིས་ཕྱུག་པའི་རོང་གྲོང་དེའི་སྲང་ལམ་དེར་གོམ་ཁ་བསྒྱུར་ཐེངས་རེར།",
    "ཁྱེད་ནི་ཕ་མ་གཉོམ་ཆུང་གི་ཕྲུ་གུ་ཡིན་པས།",
    "མང་ཚོགས་སེམས་དཀྱིལ་དུ་གཞག་དགོས་ཞེས་པ་དེ་རེད།",
    "དེ་དག་ཡོད་དོ་ཅོག་རྒྱུ་ནོར་གྱིས་བང་མཛོད་གཏམས་པའི་སྤྲེལ་ལད་ཅན་གྱི་འབྱོར་ལྡན་དག་རེད།",
    "ཕ་ཡུལ་གྱི་ཨ་ཕ་དྲན་ཐེངས་རེར།",
    "ངའི་སེམས་དབུས་སུ་ཡ་ང་བའི་མི་བུ་དག་གི་སྣང་བརྙན་རེས་མོས་ཀྱིས་ཡིད་ཀྱི་ལྷ་ལམ་ཡངས་མོར་དལ་གྱིས་རྒྱུ་ཞིང་།",
    "བདག་གིས་ཉམ་ཆུང་གི་མང་ཚོགས་དཀྱུས་མ་ཚོར་བརྩེ་དུང་དྲག་པོ་སྐྱེས་ཏེ་ཁོ་ཚོའི་དཀའ་ཁག་ཅུང་ཟད་སེལ་བར་འབད་ཀྱང་།",
    "ང་རང་གི་འཇོན་ནུས་ལ་ཚད་བཀག་ཡོད་པས།",
    "ངས་མང་ཚོགས་ཚོའི་ཉམ་ང་བའི་སྣང་བརྙན་དང་།",
    "ངན་ངོན་གྱི་འཚོ་བའི་རྣམ་པ་དེ་དག་འདྲེན་བྱེད་ལམ་དུ་འཆར་ཐེངས་རེར།",
    "ངའི་སེམས་པ་མཚོ་བཞིན་ལང་ལོང་དུ་འཁྱོམས་ཏེ།",
    "ང་ཚོའི་ཁྲོད་ལོ་ན་བགྲེས་ཤོས་ནི་སེང་གེ་དགྲ་འདུལ་ཡིན་ཞིང་།",
