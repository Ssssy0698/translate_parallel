    "འདུས་བྱས་དང་འདུས་མ་བྱས་པའི་རང་བཞིན་དུ་ཡོད་པའི་རྣམ་པར་རྟོག་པ་མི་འབྱུང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ་།",
    "གཉེན་པོའི་དངོས་པོར་མི་རྟོག་ཅིང་རྣམ་པར་མི་རྟོག་པར་གྱུར་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡིད་ལ་བྱ་བ་མ་གཏོགས་པར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི།",
    "ཀུན་རྫོབ་ཏུ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཐོབ་པར་བྱ་བ་ཙམ་ཞིག་ཡིད་ལ་བྱ་བ་མ་གཏོགས་པར།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སོགས་པ་དོན་དམ་པར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་ཞེས་བསྟན་པའོ།",
    "འཕགས་པའི་ཚེ་ཡང་རྣམ་པར་བྱང་བར་མི་འགྱུར་ཏེ།",
    "ཀུན་རྫོབ་ཏུ་མིང་བརྡ་ཙམ་དུ་གདགས་པ་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ་བརྩོན་པ་ལ་གདམས་པར་བྱའོ་ཞེས་བསྟན་པའོ།",
    "གཟུགས་ལ་ཆགས་པར་འགྱུར་བ་མེད་དོ་ཞེས་བྱ་བ་ནས།",
    "རྣམ་པར་མི་རྟོག་པ་ལ་གནས་པའི་འབྲས་བུ་གཟུགས་ལ་སོགས་པའི་འཇིག་རྟེན་དང་།",
    "དེ་ནི་འདི་ལྟར་གང་ཆགས་པར་བྱེད་པའམ།",
    "དེ་ལྟར་ཆགས་པར་མི་འགྱུར་བའི་གཏན་ཚིགས་བསྟན་པ་སྟེ།",
    "གང་ལ་ཆགས་པར་བྱ་བའི་དངོས་པོ་དེ་དག་ཐམས་ཅད་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པའོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པས་རྣམ་པར་འཕེལ་ལོ་ཞེས་བྱ་བ་ནས།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱང་ཐོབ་པར་འགྱུར་རོ།",
    "ཏིང་ངེ་འཛིན་གྱི་སྒོ་རྣམས་ཀྱང་ཐོབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་དུ་ནི།",
    "རབ་འབྱོར་དེ་ཇི་སྙམ་དུ་སེམས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "མུ་སྟེགས་ཅན་གྱིས་བཏགས་པའི་བདག་ལ་སོགས་པ་བཞིན་དུ་ཡོད་པར་རྟོག་ན་རྣམ་པར་རྟོག་པ་གསུམ་དུ་འགྱུར་ཏེ།",
    "དེ་ལས་གཞན་པར་རྟོག་པ་དང་།",
    "འདུས་མ་བྱས་པ་ཞེས་བྱ་བ་ནི།",
    "གཟུགས་ཀྱི་དེ་བཞིན་ཉིད་ཚོར་བའི་དེ་བཞིན་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པ་རྣམ་པ་དུ་མར་གསུངས་ཏེ།",
    "རབ་འབྱོར་གྱིས་དེ་མ་ལགས་སོ་ཞེས་གསོལ་བའི་ཚིག་བཟླས་ཏེ་བཀའ་སྩལ་ནས།",
    "དོན་དམ་པར་ངོ་བོ་ཉིད་ཡོད་པར་མ་གྲུབ་སྟེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མི་དམིགས་པ་ལ་དེ་ལྟར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "མིང་དང་བརྡ་ཙམ་དུ་བཏགས་པ་བརྩོན་པ་ལ་གདམས་པར་བྱེད་པ་དེ་ལེགས་སོ་ཞེས་བསྟོད་ནས།",
    "དེ་ལྟར་བསླབ་པར་བྱའོ་ཞེས་བཀའ་སྩལ་པའོ།",
    "རྣམ་པར་ཤེས་པ་སྨོན་པ་མེད་པའི་ཚིག་བླ་དགས་མི་དམིགས་པར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དུ་ནི།",
    "རབ་འབྱོར་གྱིས་དོན་དམ་པར་ཚིག་བླ་དགས་མི་དམིགས་པར་རྟོགས་ནས་དེ་ལྟར་མི་སེམས་སོ་ཞེས་གསོལ་པའོ།",
    "རྣམ་པར་ཤེས་པ་སྨོན་པ་མེད་པའི་ཚིག་བླ་དགས་མི་དམིགས་པར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དུ་ནི།",
    "ཚིག་བླ་དགས་མི་དམིགས་པར་གདམས་པའི་མཇུག་བསྡུས་ཏེ།",
    "དེ་ལྟར་བསླབ་པར་བྱའོ་ཞེས་བསྟན་པའོ།",
    "རབ་འབྱོར་འདུས་བྱས་ཀྱི་དབྱིངས་ཀྱིས་འདུས་མ་བྱས་ཀྱི་དབྱིངས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ།",
    "འདུས་མ་བྱས་ཀྱི་དབྱིངས་ཀྱིས་འདུས་བྱས་ཀྱི་དབྱིངས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་ཞེས་བྱ་བ་ནི།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་གཉི་ག་ཡང་དོན་དམ་པར་རང་བཞིན་དབྱེར་མེད་པས།",
    "འདུས་བྱས་ཀྱི་དབྱིངས་མ་ཡིན་པར་ཡང་འདུས་མ་བྱས་ཀྱི་དབྱིངས་རབ་ཏུ་གདགས་པར་མི་ནུས་སོ།",
    "འདུས་མ་བྱས་ཀྱི་དབྱིངས་མ་ཡིན་པ་ཡང་འདུས་བྱས་ཀྱི་དབྱིངས་རབ་ཏུ་གདགས་པར་མི་ནུས་ཏེ་ཞེས་བྱ་བ་ནི།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་གཉི་ག་དོན་དམ་པར་རོ་གཅིག་པས།",
    "འདུས་བྱས་མ་གཏོགས་པར་འདུས་མ་བྱས་ལོགས་ཤིག་ཏུ་གདགས་སུ་ཡང་མི་རུང་ལ།",
    "འདུས་མ་བྱས་མ་གཏོགས་པར་འདུས་བྱས་ལོགས་ཤིག་ཏུ་གདགས་སུ་ཡང་མི་རུང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་ཉིད་དུ་རང་བཞིན་གཅིག་པ་ལས་ཡོངས་སུ་མ་དག་པའི་ཚེ་ནི་འདུས་བྱས་ཞེས་གདགས།",
    "ཡོངས་སུ་དག་པའི་ཚེ་ནི་འདུས་མ་བྱས་པ་ཞེས་གདགས་ཏེ།",
    "ཕྱིས་རྙོག་མ་མེད་པར་གྱུར་པའི་ཚེ་ནི་ཆུ་དངས་པ་ཞེས་བྱ་སྟེ།",
    "ཆུའི་རང་བཞིན་ལ་ཐ་དད་པར་གདགས་སུ་མི་རུང་བ་བཞིན་ནོ་ཞེས་བསྟན་པའོ།",
    "ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་བས་མི་འཇིགས་མི་དངང་ཞེས་བྱ་བ་ལ་སོགས་པས།",
    "སེམས་ཞུམ་པ་དང་ཡིད་འགྱོད་པར་མི་འགྱུར་བ་བསྟན་ཏོ།",
    "དེ་ལྟར་སྐྲག་པར་མི་འགྱུར་བའི་གཏན་ཚིགས་བསྟན་པའི་སྒོ་ནས།",
    "ཤེས་རབ་རྣོ་བའི་རྒྱུ་སེམས་ཞུམ་པར་མི་འགྱུར་བ་དང་།",
    "ཡིད་ཡོངས་སུ་སྐྲག་པར་མི་འགྱུར་བའི་གཏན་ཚིགས་རབ་འབྱོར་གྱིས་ཞུས་པའི་ལན་བཀའ་སྩལ་པ་སྟེ།",
    "འཇུག་པའི་རྣམ་པར་ཤེས་པ་དྲུག་དང་།",
    "ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་དང་།",
    "ཡིད་དང་ཡིད་ཀྱི་ཁམས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་སྟེ་ཞེས་བྱ་བ་ནི།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསླབ་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པས་བརྩོན་པ་ལ་གདམས་པའི་དོན་དང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསླབ་པར་བགྱིའོ་ཞེས་བྱ་བ་ནས།",
