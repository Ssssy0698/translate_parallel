    "ཁོ་རང་རང་གཤེད་རང་ལ་ཕབ་ནས་ཀྱང་།",
    "གང་ན་འདུག་ཀྱང་ལིང་ག་འདི་ཉིད་ལ།",
    "ལོ་ཟླ་ཞག་དུས་ལ་དགྲ་དར་བ་ཐམས་ཅད་མཱ་ར་ཡ་རྦད་ནན།",
    "ལོ་ཟླ་ཞག་དུས་སྐག་བབ་ཟློག།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཀྱིས་མཚོན་པའི་མ་དག་པའི་སྣང་བ་ཐམས་ཅད་སྦྱངས་ཏེ་སྟོང་པར་གྱུར།",
    "ཁྱེད་རང་དང་རིག་མ་འཇམ་དཔལ་གཤིན་རྗེ་གཤེད་ཡབ་ཡུམ་དུ་གསལ་བ་ལྷའི་འདུ་ཤེས།",
    "གཞི་རྩ་འདུག་ན་གཞི་རྩའི་གཞི་རྩ་གང་།",
    "རྟག་ཆད་ཇི་ལྟར་སྣང་ཡང་ཁོ་རང་ལས།",
    "རྣམ་རྟོག་སྔ་ཕྱི་བར་དེར་སུ་ཞིག་འདུག།",
    "སེང་གེ་གླང་ཆེན་དྲང་སྲོང་འདུག་སྟངས་ཀྱིས།",
    "དེ་ལྟར་ལྟ་སྒོམ་སྤྱོད་པ་འབྲས་བུ་དང་བཅས་པ་རང་བྱུང་རང་ཤར་རང་གྲོལ་རང་ཆས་སུ་ངོ་འཕྲོད་པའི་དོན་གོ་བར་དེར་གྲོལ་དགོས་པས་དེའི་དོན་ངོ་སྤྲད་པ་ནི་མ་ཡེངས་པར་གསན་འཚལ།",
    "དཔལ་གྱི་གཏོར་མ་འདི་ཉིད་དཔལ་ཆེན་གཤིན་རྗེ་གཤེད་པོ་འཁོར་དང་བཅས་པ་དངོས་སུ་གསལ་བ་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་བྱོན།",
    "གཏོར་མའི་ཡེ་ཤེས་པ་ཁྱེད་རང་རྣམས་ལ་ཐིམ་པས་ཁྱེད་རང་རྣམས་དཔལ་ཆེན་གཤིན་རྗེ་གཤེད་ཡབ་ཡུམ་གོ་ཆའི་ལྷ་འཁོར་སྲས་མཆོག་རིགས་བཞི་དང་བཅས་པ།",
    "ཁྱེད་རང་བཅོམ་ལྡན་འདས་འཇམ་དཔལ་གཤིན་རྗེ་གཤེད་པོས།",
    "མཉམ་དུ་རོལ་ཅིག་དམ་ཚིག་དུས་ལ་བབས།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་སེང་གེའི་ཁྲིའི་སྟེང་དུ་བཞག།",
    "གྲུ་གསུམ་མཐིང་ནག་འབར་བའི་ཀློང་ཆེན་པོར་ཁྱེད་རང་རྣམས་གནས་པའི་གོ་སར་པདྨ་འདབ་བཞིའི་ལྟེ་བར་ཆུ་གླང་པད་ཉི་བཾ་གྱི་གདན་ལ་ཁྱེད་རང་རྣམས་ཀྱི་རྣམ་པར་ཤེས་པ་ཡི་གེ་ཧཱུྃ་མཐིང་ནག།",
    "སྔར་བསྒྲུབས་ཟིན་པའི་མདུན་རྟེན་གཏོར་མའང་ཁྱེད་རང་རྣམས་ཀྱི་བློ་ངོར་གསལ་འདེབས་བསྐྱར་མ་འདི་བཞིན་དུ་མཛད་འཚལ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་བཅོམ་ལྡན་འདས་གཤིན་རྗེ་གཤེད་ཡབ་ཡུམ་གོ་ཆའི་ལྷ་དང་བཅས་པ་དང་།",
    "གལ་ཏེ་མི་འགྲོ་གནས་འདིར་འདུག་གྱུར་ན།",
    "སླར་ཡང་རང་བཞིན་གནས་སུ་གཤེགས་ནས་ཀྱང་།",
    "རྒྱབ་ཏུ་ཡ་མ་རཱ་ཙ་ནི།",
