    "འབུམ་པའི་ཟུར་དུ་སླེབ་ཙ་ན་སྟོན་པ་ཤཱཀ་ཚུལ་གྱིས་ཕྱག་བྱས།",
    "ན་བཟའ་ཁུར་ནས་འབུམ་ཆུང་ཟུར་དུ་འོངས་ཙ་ན་ཇི་ལྟར་བྱས་ཆ་མེད་པར་གཟིམ་ཁང་ན་ཕར་ཡུད་བཞུད་པ་ཅིག་བྱུང་ཞེས་གྲག་གོ།",
    "ཇི་ཙུག་གདའ་ཞུས་པས།",
    "དེའི་དུས་ཁོ་ནར་ཚེའི་དུས་བྱས་པ་ཇི་ལྟ་བ་བཞིན་མཁྱེན་པར་གདའ།",
    "ཕྱིས་འདི་ལྟར་བརྩིས་ཙ་ན་དུས་ཚོད་དང་ཚེས་གྲངས་ཀྱང་ཏིག་གེ་བར་འདུག་པ་ལ།",
    "དེ་ཙ་ན་སྒོམ་ཆེན་ཞིག་ཤི་བའི་སྤུར་སྦྱངས་པས་འཇའ་དང་འོད་ལ་སོགས་པ་བྱུང་།",
    "ཡབ་ཀྱིས་ཁམས་ངན་པར་འདུག་པས་དེ་རིང་མ་སྲུངས།",
    "བའོ་ཐང་འདིར་ཇི་ལྟ་བུའི་མི་ཆེན་པོ་ཞིག་འབྱོན་པར་འདུག་གསུངས།",
    "རྩེ་ལྔའི་རི་ལས་འདིར་ལྷགས་གདའ།",
    "དེ་རྣམས་གླུ་ལེན་གྱི་འདུག་པའི་ནང་ན་མར།",
    "སྔོན་ནས་སྔོན་གྱི་དུས་ཙ་ན།",
    "ཡོན་ཏན་ལ་ངོམས་པ་བག་ཙམ་ཞིག་མཆིས་པ་འདི་དེའི་འོད་ལ་བརྟེན་པ་ཞིག་ལགས་པར་གདའ་གསུངས།",
    "མི་འདི་སྦྱང་སླ་བར་འདུག་གསུང་།",
    "དེ་དུས་ཚོགས་བསྡུས་ནས་ལོ་གསུམ་ལོན་ནས་འདུག།",
    "ཐུགས་མ་མཉེས་ཙ་ན་ཁྱེད་ལེགས་པར་བྱེད་ན་གྱིས།",
    "བསྔོ་བ་བྱེད་ཙ་ན་ཁ་བ་ཐུལ་གྱིས་བྱུང་བས།",
    "དག་པའི་སྣང་བ་འབའ་ཞིག་འཆར་ཡིན་འདུག་གསུང་ནས་ཐུགས་ཁྲལ་མཛད་པར་གསུངས།",
    "འདུག་སྙམ་ནས་གཙང་དུ་འགྲོ་བའི་འདུན་པ་ལོག།",
    "དབྱར་དེ་ཉན་ཐོས་ཀྱི་ས་གསུང་ཞིང་འདུག་པ་ཉན་པས།",
    "ཟེར་བ་ཅིག་གདའ་བ་འདི་ཟབ་མི་ཟབ་ཇི་ལྟར་ལགས།",
    "གཞན་གོ་བ་ཙམ་ཡང་མི་འདུག་གསུང་།",
    "སུ་ལ་ཕན་དང་སུ་ལ་མི་ཕན་མི་ཤེས་པར་འདུག།",
    "བྲག་ཕུག་ཏུ་ཚེམ་བེར་གྱོན་ནས་འདུག།",
    "འདའ་ཁ་ཙ་ན་ཡང་འཇིག་རྟེན་ན་སྒྲ་གཅིག་ཐོས་པ་ལ་བློ་སྦྱོང་སྒྲ་ལས་སྙན་པ་མེད་པས།",
    "གཅུང་པོས་སྐུ་ཁམས་ཞན་པར་གདའ།",
    "ད་ཚོགས་སུ་འདི་ལས་འཆད་པ་མི་འོང་༡༢༥བས་ཁྱེད་རང་ཐམས་ཅད་ནན་ཆགས་གྱིས་ཤིག་གསུང་།",
    "སྤྱིལ་དུ་མཆོད་ཁང་རང་ཡང་མེད་པར་འདི་ཁོ་ན་སྦྱང་སྙམ་པ་ཡིན་པ་ལ་གསུང་།",
    "དེ་ཡིན་པར་འདུག་དེའི་རིགས་སུའང་གདའ།",
    "ད་ཁྱེད་རང་ཀླུངས་ཤོད་ཀྱི་ནང་ན་སྤྱིལ་བུ་བྱ་བའི་ལུང་པ་ཡོད།",
    "ཕུང་པོ་འདི་ལྔར་འབྱེད་ཚོད་ཀྱིས་མཐར་སྟོང་པ་ཉིད་དུ་འདུག་སྙམ་སྟེ་བདག་མེད་པའི་ལྟ་བ་རང་འཁྲུངས་སུ་བྱུང་།",
    "ངའི་བུ་འདི་ལ་རབ་ཏུ་བྱུང་ནས་གྲགས་པ་ཡང་ཆེ་བ་ཅིག་འོང་བར་འདུག་ཟེར།",
    "ཕྱིས་སུ་བསམས་ཙ་ན་སྔར་གྱི་དེས་གར་ཡང་མི་ཕྱིན་པར་འདུག་གསུང་།",
    "དུས་ཚོད་འདི་ཙ་ན་ཤོག་གསུང་བས་སྤྱན་སྔར་ཕྱིན་དུས་གྲོག་པོའི་གསེབ་ལ་ཉི་མ་བྱུང་བ་དེ།",
    "ང་རང་དད་གུས་ཆུང་བས་ལན་སྙམ་ནས་གསོལ་བ་ཤུགས་དྲག་བཏབ་པས་དངོས་སུ་བྱོན་ནས་བྱིན་གྱིས་བརླབས།",
    "དེའི་ཚེ་སྤྱན་སྔའི་ཐུགས་ནམ་མཁའ་ལ་བྱོན་ཏེ་བྱ་ཡུལ་བ་ཆེན་པོ་སྨྱུག་རུམ་གྱི་གདོང་དེ་ན་གསོལ་བ་འདེབས་ཀྱིན་བཞུགས་པའི་པང་དུ་བྱུང་བས་ཐུགས་ཀྱི་གཏོད་ས་ང་རང་ཡིན་སྙམ་དུ་དགོངས་པ་བྱུང་གསུངས།",
    "དེར་བྱོན་ཙ་ན་སྟན་མཐོན་པོ་ཞིག་བཤམས་འདུག་པ་ལ།",
    "ཇོ་བོ་སྟོན་པ་ད་དུང་མཚན་ཉིད་པའི་སྐྱ་དྲི་མ་སངས་པར་འདུག་གསུང་བས།",
    "ཁོང་བཙུན་ཆུང་བྱུང་ཙ་ན།",
    "ལན་ཅིག་སྟོད་ལུང་པས་སྤྱན་སྔ་མཇལ་དུ་བྱོན་ཙ་ན།",
    "ཚོགས་སྡུད་པ་ཤཅིག་འོང་བར་འདུག་གསུང་།",
    "དེ་ཐུགས་མད་པར་གདའ།",
    "སྤྱན་སྔའི་ཐུགས་དམ་ཡིན་པས་མྱ་ངན་སེལ་བ་ལ་བྱོན་པའི་ཞད་དུ་གདའ།",
    "དེས་ན་ང་རང་ལ་གོ་བ་ཅིག་ཡོད་ཨང་གསུང་།",
    "ཁྱེད་ཀྱིས་ནི་ཁོ་བོ་ཐུགས་ལས་ཆུང་ངུར་གཞོལ་བས་ཆོག་པ་ཅིག་འོང་བར་འདུག་གོ་གསུང་།",
    "དེ་ནས་ཚུར་བྱོན་ནས་བརྒྱགས་ཀྱི་རྩོལ་བསྒྲུབ་བྱས་ཏེ་སྤྱན་སྔར་བྱོན་ཙ་ན།",
    "དེ་ནས་གདམས་ངག་བཏབ་སྟེ་གཞན་རྣམས་ཀྱིས་ང་མ་རྙེད་པར་འདུག་སྟེ།",
    "ངོ་༥མཚར་ཆེ་ཐ་མལ་པར་མི་གདའ་གསུང་།",
    "ངས་དེ་ཙ་ན་དེ་བཞིན་དུ་བྱས་ན་རྒྱ་སྣུབས་དགོན་གསུམ་གྱི་མིང་ཡང་མི་འོང་གསུང་།",
    "ནངས་ཅིག་དགེ་སྦྱོར་བྱེད་འདོད་ལྷན་གྱིས་བྱུང་བས་སྤྱན་སྔར་ཕྱིན་ཙ་ན།",
    "འདི་ཙུག་གདའ་ཞུས་པས་དེ་ངས་བྱིན་གྱིས་བརླབས་པ་ཡིན།",
    "དེར་ཐེམ་པ་ལ་སྙེས་ནས་བཞུགས་ཙ་ན།",
    "དེ་མིན་ན་དེའི་ཚེ་གསུང་ཁ་ཡར་འོང་བ་༣༨བ་འདུག་པ་ལ་གསུང་།",
    "ལན་ཅིག་ཙ་ན་འུ་ཅག་ལ་ཚེ་རིང་པོ་འོང་ངེས་མེད།",
    "འདི་ལ་གཞན་མི་འཆལ་བར་གདའི།",
    "གསོལ་བ་བཏབ་ཙ་ན་མི་མཇལ་བ་བྱེད་མ་མྱོང་གསུང་།",
    "རིན་ཆེན་སྒང་ན་བཞུགས་ཙ་ན་རྨི་ལམ་དུ་ནགས་གསེབ་ཅིག་ན་བྲག་ཕུག་ལེགས་པ་ཅིག་འདུག།",
    "དེའི་ནང་དུ་བྱོན་ཙ་ན།",
    "ཇོ་བོ་ནཱ་རོ་པ་བདུད་རྩི་ཀ་པཱ་ལ་གང་ཐོགས་ནས་འདུག།",
    "མ་ཕྲད་ཞུས་པས་འོ་ན་དེ་ཐ་མལ་པར་མི་འདུག་གསུང་།",
    "རྣལ་འབྱོར་མ་དེས་ཁོག་མ་ཅིག་ཁུར་ནས་འདུག།",
    "རྒྱལ་པོ་ཨིནྡྲ་བྷུ་དྷིའི་ཞབས་ལ་རྩྭ་ཨ་བ་གཉིས་སྐྱེས་ནས་འདུག་པ་ལ་གཅིག་གསོལ་བས་སྔར་མ་མྱོང་བའི་རོ་བཟང་པོ་ཞིག་བྱུང་།",
    "གྱེ་ར་སྒོམ་ཤེ་དང་དབོན་སྟོན་ཆེན་པོ་གཉིས་འགྲོགས་ནས་གཟིམ་ཆུང་དུ་བྱོན་ཙ་ལྡེ་མིག་མེད་པས་སྒོམ་ཤེས་ལྡེ་མིག་བླངས་ནས་འོང་ཙ་ན་ནང་ན་ཕེབས་འདུག།",
    "ཡང་ཉེ་གནས་དར་མ་འོད་ཀྱིས་སྐས་ཐོག་ཁར་དྲངས་ནས་ཉི་མ་ལ་བསྡད་ཙ་ན་དབོན་སྟོན་རྒྱ་མཐོངས་ལ་བྱོན་ནས།",
    "འཁོར་རྣམས་ཀྱིས་མར་སྔོན་ལ་འོངས་པས་ལམ་ཁར་ཆར་པ་བཏང་ཙ་ན་དྲིལ་བུ་སིལ་གྱིས་བྱུང་བས་དབོན་སྟོན་གཟིམ་ཆུང་ན་བཞུགས་འདུག།",
    "འོ་ན་བྱ་ཡུལ་བ་ཆེན་པོ་ཡིན་པའི་གྲགས་པ་གདའ་བ་ལགས་སམ་ཞུས་པས།",
    "བྱ་ཡུལ་གྱི་བག་ཆགས་ཀྱང་མང་བར་འདུག།",
    "སྔ་མ་དེ་ཡིན་ཞད་དུ་གདའ་གསུང་།",
    "དེར་འཁོར་ལོ་དེ་གང་དུ་གདའ་ཞུས་པས་གསེར་གྱི་འཁོར་ལོར་སྣང་།",
    "གང་ན་མཆི་ཞུས་ཏེ་དུས་དིང་སང་ནི་ལུང་བསྟན་འོང་དགོས་པའི་ཚོད་དུ་འདུག།",
    "སློབ་དཔོན་པའི་ཕྱག་ཞབས་ལ་འཁོར་ལོ་རྩིབས་བརྒྱད་གདའ་བ་ལ་མུ་ཁྱུད་ཕྱི་མ་འདི་མ་འབྱར་ཙམ་དུ་གདའ་བ་ཇི་ལྟར་ལགས་ཞུས་པས།",
    "མི་ནག་པོ་དེ་མགོན་པོ་གྲི་གུག་ཡིན་པར་འདུག་གསུང་།",
    "ཇོ་བོ་དེ་དང་མཇལ་བ་ཞིག་བྱུང་ན་སྙམ་ནས་གསོལ་བ་འདེབས་ཀྱིན་ཕྱིན་པས་ཇོ་བོ་ཆེན་པོ་ཞལ་རས་དཀར་ལ་སྐུ་བོང་ཆེ་བ་པཎ་ཞྭ་དམར་པོ་གསོལ་བ་ཅིག་བཞུགས་འདུག།",
    "དགའ་བ་ལ་སྙམ་ཙ་ན།",
    "གཉིད་སད་དེ་བལྟས་པས་ཡུན་རིང་དུ་བཞུགས་འདུག།",
    "དེ་དུས་ཁོང་རྫིང་ཕྱིའི་མཆོད་ཁང་ལ་རབ་གནས་མཛད་ཀྱིན་ཡོད་པར་འདུག་གསུང་།",
    "དེ་གང་ཡིན་དཔྱད་པའི་ཕྱིར་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞག་པས་ཁྱེད་ཀྱི་བུར་འདུག་པ་ཐིགས་པ་ཡིན་གསུང་བ་ལ་སོགས་མཔའི་གསང་བའི་གནས་དུ་མ་གསུངས་ནས།",
    "༣༣༨ན་མཆོད་སྡོང་དེའི་ཕྱི་རོལ་ཏུ་ཙན་དན་གྱི་སྡོང་པོ་གསར་པ་ཞིག་ཐོན་པ་དེ་ལ་ཡང་ཡལ་ག་དང་ལོ་མ་རྣམས་ལ་ཨ་ར་པ་ཙ་ན་དང་།",
    "ཤེས་རབ་བསྐྱེད་པའི་ལྷ་འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན་དང་།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་།",
    "ཁམས་ཀྱང་མ་བདེ་ཞིང་ཕར་ཚད་འཆད་དགོས་པ་འདིས་འཕྲལ་ལ་འཆད་པ་མི་འགྲུབ་པ་འདུག།",
    "ལས་བཏུས་གསུང་བ་འདུག་ཅེས་གསན་ནས།",
    "རྗེ་བཙུན་པ་ཁོང་རང་ལམ་འབྲས་སོགས་གསན་པའི་ངང་ནས།",
    "ཅི་བྱེད་དེ་འདྲ་ལ་དགོས་པ་མི་འདུག།",
    "སྣར་ཐང་དུ་གཞུང་བསྒྱུར་བཙུགས་པའི་ཐོག་མ་དེ་ཡིན་པ་འདུག།",
    "ལུང་ཙམ་ཞུ་བའི་ཡུལ་ཡང་དཀའ་བར་བྱུང་འདུག་གོ།",
    "དེ་དུས་ཀྱི་གྲྭ་ས་རྣམས་ན་པོ་ཏི་གཞན་རྣམས་ཀྱི་གྲྭ་སྐོར་བྱེད་པའི་ལུགས་མ་དར་འདུག་པས་མ་བྱས་གསུང་ངོ།",
    "དེ་ལག་ཏུ་བླངས་ནས་བུས་པས་སྒྲ་ཆེན་པོ་དཔག་ཏུ་མེད་པ་གྲགས་པ་ཞིག་རྨིས་འདུག་སྟེ།",
    "ཡུ་བ་དང་བཅས་པ་ཞིག་འདུག།",
    "འདི་རྗེ་བཙུན་སྒྲོལ་མའི་ཕྱག་མཚན་དུ་འདུག་༣༥ན་པས་དེས་རྗེས་སུ་འཛིན་པའི་ལྟས་ཡིན་ནམ་དགོངས་པ་ན།",
    "དེ་དུས་ཀྱང་འགྲེལ་ཆེན་གསུང་བའི་ལེའུ་དང་པོ་རྫོགས་པའི་མཚམས་ལ་འདུག་པས།",
    "ད་ནངས་ཀྱི་གོས་ཡུག་འདི་ལྗང་༥ ༩ ༥ ༡ ༣ ༡ཁུ་ནམ་མཁའི་ཁམས་ཡིན་བསྐྱེད་རིམ་དང་མཐུན་པས་བསྐྱེད་རིམ་ཡོངས་སུ་རྫོགསཔར་འོང་བར་འདུག།",
    "༣༥༥བ་ཕྱིས་མཇལ་བ་ན་སྐུའི་རྣམ་པ་མནལ་ལམ་དུ་བྱུང་བ་དེ་ཉིད་རང་དུ་འདུག་གསུང་ངོ།",
    "ཞེས་གསུངས་པ་དེ་ལ་དཔྱད་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་གོ་ཞེས་གསུང་ངོ།",
    "མི་གོ་བར་འདུག་ལགས་ཞུས་པས།",
    "སྐབས་སུ་བབ་ན་ངས་ས་བོན་བཏབ་པ་འདི་རྣམས་ཀྱིས་ཀྱང་རྐྱེན་བྱས་ནས་ལེགས་པར་གོ་བ་ཞིག་མྱུར་དུ་འོང་བ་འདུག་ཅེས་གསུང་ངོ།",
    "རྗེ་བཙུན་འཇམ་པའི་དབྱངས་ཀྱིས་སྔར་བཞིན་ཉམས་སྣང་རང་དགའ་བ་མིན་པས་གསོལ་བ་དྲག་ཏུ་ཐོབ།",
    "དེ་དུས་ངོ་མཁྱེན་པ་དང་མི་མཁྱེན་པའི་འཁོར་དུ་མ་ཁ་གདངས་ནས་བཟེད་འདུག་པས།",
    "གང་དུ་བཞུད་ཅེས་གསོལ་བས་རྫིང་ཕྱིའི་རབ་གནས་ལ་སྤྱན་འདྲེན་གྱིན་འདུག་ཅེས་གསུང་བའི་ཚེས་གྲངས་དང་རབ་གནས་མཛད་པའི་ཚེས་གྲངས་གཉིས་ཕྱིས་བརྩིས་པས་མཐུན་པར་བྱུང་ངོ།",
    "སྟོང་པ་ཉིད་ཀྱི་རྒྱས་མ་ཐེབས་པའི་སྣང་བ་རང་དགའ་བ་ཆེར་མི་འཆར་བར་འདུག།",
    "སྔ་ཕྱི་འགལ་བ་དང་རང་ཚིག་འགལ་བ་དང་ཟློས་བུར་སྨྲ་བ་སོགས་ཀྱི་སྐྱོན་ཡང་རྣམ་པ་ཀུན་ནས་མེད་པ་དྲི་མ་མེད་པའི་རིགས་ལམ་ལ་སྦྱངས་པའི་མཁས་པ་རྣམས་ཀྱིས་གཟུ་བོའི་བློས་ཇི་ཙམ་དཔྱད་ཀྱང་འདིའི་ཐད་ནས་ནོར་རོ་ཞེས་ཚིག་གཅིག་ལའང་སྐྱོན་གདགས་སུ་མེད་པ་དང་།",
    "འོན་ཀྱང་ཆབ་ཚན་གྱིས་ནི་ཞབས་ལ་༤བ་ཅུང་ཟད་ཙམ་འདུག་པ་ལས་མ་མཛད།",
    "འཇམ་དཀར་གྱིས་སྐྱེ་བ་གསུམ་དུ་རྗེས་སུ་བཟུང་ནས་བྱིན་གྱིས་བརླབས་ཀྱང་དམ་སེལ་ཅན་ཞིག་ལ་རྗེས་གནང་བྱས་པས་ཅུང་ཟད་འགྲིབས་འདུག།",
    "བསྟན་པའི་མཇུག་མ་རྣམ་དག་ཅིག་འདུག་སྟེ་འཇུག་མཁན་མི་འདུག།",
    "ཅུང་ཞིག་ལོན་པ་ན་ད་མི་དགོངས་པར་འདུག་སྙམ་ནས་བྲིས་སྐུ་དེ་སྐུ་རྒྱབ་གཡོན་ཕྱོགས་སུ་གདན་དྲངས་པས་ཇི་ལྟར་སྤྱན་དྲངས་པ་ལྟར་བྲིས་སྐུ་ལ་སྤྱན་གདངས་ཏེ་ཨོག་སྐོ་སྐུ་དཔུང་གཡོན་དཔགས་ནས་འཁྲུལ་བའང་སྐྱེས།",
    "མི་སྣ་ལྡོག་དུས་རྒྱལ་པོ་ལ་ལེགས་གསོལ་ཞུ་འབུལ་བྱས།",
    "ངེད་ཀྱང་སྒྲུབ་པ་བྱེད་ཁྱེད་རང་ཡང་ལམ་འབྲས་ཀྱི་ཆ་ལག་ལྷག་མ་རྣམས་ཞུས་ལ་ཤོག་གསུང་བས་དེ་ལྟར་མཛད་ནས་བྱོན་གསུངས།",
    "དབོན་པོ་དཔལ་སྐྱོང་རྣམས་ཁྲིད་གསུང་བ་བྱུང་འདུག།",
    "ད་ནི་ང་རང་དབེན་གནས་ཤིག་བཙལ་ནས་སྒྲུབ་པ་བྱ་དགོངས་ཏེ་མལ་གྲོ་རྒྱལ་སྟེང་དུ་ཐོགས་གཅིག་བཞུགས།",
    "ཁྱེད་རང་གཉིས་ཀྱང་བེམ་རིག་མ་བྲལ་རིང་ལ་ནང་འདིར་མ་བྲལ་བ་བྱེད་དགོས་པ་ཡིན།",
    "བཤེས་གཉེན་གཞན་སུ་ལའང་མི་བསྔགས་པ་ཅུང་ཟད་ཀྱང་མི་སྨྲ་ཞིང་ཡོན་ཏན་བརྗོད་པ་ལྷུར་ལེན་པ་དང་གང་ཟག་མཆོག་དམན་སུ་ལ་ཡང་ཕུན་སུམ་ཚོགས་པའི་རྣམ་པ་ཆེ་ཆུང་ཅི་འདུག་པ་དང་།",
    "འོན་ཀྱང་རང་སྐྱེས་ཤཱཀྱ་ཡིས།",
    "ཁོ་རང་ཡང་ཕལ་པ་རང་ཇོ་བོ་བཟང་ཞེས་དད་པ་ལྷག་པར་སྐྱེ།",
    "ཁོ་རང་ཡང་དེ་ཉིད་དང་དུ་ལེན།",
    "ཤེས་པར་འདུག།",
    "མཆོད་གཡོག་པས་ཁྲུས་སྟེགས་ཀྱི་འཁྲིས་སུ་ཙོག་པུར་འདུག་ལ།",
