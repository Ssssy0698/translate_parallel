    "དམེ་རུ་འགྲོ་བར་འདུག་པར་དགོངས་ཏེ་སྨྲས་པ།",
    "དེས་ན་ང་རང་གང་བསམ་ལས་ཤིག་བསྒྲུབ།",
    "བདག་དང་གཙོ་འཁོར་ལྷན་ཅིག་ཏུ་འདུག་སྟེ།",
    "པའི་སྤྱན་དེ་འདུག།",
    "གནས་ལ་མཐོ་དམན་ཡོད་པ་ངེས་པར་འདུག།",
    "བོན་ལ་འཆད་ཉན་བྱེད་ཀྱིན་འདུག།",
    "དངོས་པོའི་གཟུགས་སུ་འདུག་གམ་མཐོང་།",
    "ཐམས་ཅད་ཀུན་ཡིན་གང་མིན་འགྲོལ།",
    "འཛེགས་པ་དཀའ་ཡང་འདུག་ས་བདེ།",
    "རྒྱ་མཚོའི་འགྲམ་དུ་འདུག་པའི་མི།",
    "མཚོ་གླིང་འདུག་པ་ཅི་ཞིག་རྒྱུ།",
    "ལོ་ཏོག་གསེབ་ཏུ་འདུག་པའི་མི།",
    "ཐད་སོར་རང་རང་དྲི་མེད་གཟི་བརྗིད་པོད་བཅུ་གཅིག་པ་བཞུགས།",
    "འཇིག་རྟེན་ཕྱིར་དང་རང་གཡེང་བ།",
    "རང་ཞི་ཙམ་ན་བདུད་ཀྱང་རང་སར་ཞི།",
    "ཅི་ལྟར་དུ་མཚམས་པའི་ཞག་དུས་དང་ཟ་མའི་དམ་བཅས་ཏེ་བསྲུང་ན།",
    "སྟོང་དང་བཅས་པ་ཁྱབ་ཅིང་ཐམས་ཅད་ཀྱིས་ཚིམ་པར་བཞེས་ཀྱང་བསོད་སྙོམས་དེ་ཟད་པར་མ་གྱུར་པ་ན་ཁྱེའུ་དེ་རབ་ཏུ་དགའ་ཞིང་དད་པ་ལྷག་པར་སྐྱེས་ནས་དེ་བཞིན་གཤེགས་པ་དེའི་སྤྱན་སྔར་འདུག་པ་དང་།",
    "གངས་རིའི་བྱ་ཁུ་བྱུག་སོགས་ཁྱིམ་དེའི་སྟེགས་བུ་སོགས་སུ་འདུག་ནས་སྐད་སྙན་པ་སྒྲོགས་པ་དང་།",
    "ཡུམ་གྱི་ལྷུམས་ན་བཞུགས་པའི་ན་ནི་སྐུ་མེའི་ཕུང་པོ་ལྟ་བུ་འདུག་པའི་སྣང་བས་དཔག་ཚད་ལྔའི་བར་ཁྱབ་བོ།",
    "ཚུལ་དེས་བདུད་སྡིག་ཅན་ཞུམ་ཞིང་ཅང་མི་སྨྲ་ལ་སྤྱི་བོ་སྨད་ནས་སེམས་ཁོང་དུ་ཆུད་ནས་འདུག་གོ།",
    "དགེ་སློང་ལྔ་པོས་ཀྱང་དེ་བཞིན་གཤེགས་པ་ལ་ཕྱག་བཙལ་ནས་དུལ་བའི་ཚུལ་གྱིས་འདུག་གོ།",
    "བདེ་བར་གཤེགས་པ་ལ་ཀུན་ནས་རྟོག་ཅིང་འདུག་གོ།",
    "སྒོ་བཞི་ན་ནི་རྒྱལ་པོ་ཆེན་པོ་བཞི་འདུག་གོ།",
    "མིའམ་ཅི་རྣམས་ཀྱིས་བསྐོར་ཞིང་ཉན་ཐོས་ཆེན་པོ་རྣམས་ཀྱང་འདུག་གོ།",
    "རྒྱལ་པོ་ཡུལ་འཁོར་སྲུང་སྒོ་ན་འདུག་ནས་དེས་ནང་དུ་མ་འགྲོ་སྡོད་ཅིག་ཅེས་བཟློག་གོ།",
    "མཐོང་ནས་ཀྱང་དགའ་བ་༥ན་དང་མགུ་བ་སྐྱེས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཅིང་ཡུལ་ཡུལ་པོ་དང་ཞུམ་ཞུམ་༥༩ན་པོར་གྱུར་ནས་མགོ་སྨད་ཅིང་སྤོབས་པ་མེད་དེ་སེམས་ཁོང་དུ་ཆུད་ནས་འདར་ཞིང་འདུག་གོ།",
    "སྐུ་གདུང་ནི་རིལ་པོ་གཅིག་ཏུ་འདུག་གོ།",
    "ཐོ་རངས་རྒྱུ་འབྲས་གཉིས་ཀ་བཟང་བར་འདུག་པ་ལ་ངས་སྐུར་པ་བཏབ་པ་ལྕེ་འདིས་ལན་པས་གཅོད་གསུངས་ནས་སྤུ་གྲི་འཚོལ་བའི་ཚེ་ཁོང་གཉིས་ཀྱིས་ལྗགས་དགུམ་མི་༨༨བ་འཚལ།",
    "ཇོ་ངོ་ཤཱཀྱ་མུ་ནེ་མང་ཡུལ་སྐྱིད་གྲོང་དུ་སྤྱུགས་འདུག་པས།",
    "འཇམ་དཔལ་རང་ལ་བཀའ་གནང་བས་འཇམ་དཔལ་གྱིས་སྟན་དེ་ལ་འདུག་བཞིན་དུ་ལག་པ་བརྐྱངས་ནས་ལྷུང་བཟེད་བླངས་ནས་ཕུལ་ལོ།",
    "སུ་འདུག་༡༢༢བ་འདུག་ལ་ཕུལ་ཅིག་ཟེར་བའི་སྒྲ་ཞིག་བྱུང་བ་ན་འོད་སྲུངས་སོགས་ལ་ཕུལ་བས་ཀྱང་སུ་ཡང་མ་མཐོང་ཞིང་།",
    "སྔོན་མཚམས་མེད་ཀྱི་ལས་བྱས་པའི་ལས་ཀྱི་ལྷག་མ་ཅུང་ཟད་ཡོད་པ་ལ་སྤྱོད་པའི་བྱང་སེམས་ལྔ་འདུག་པ་དེ་དག་དམིགས་པ་དང་བྲལ་བར་བྱ་བའི་ཕྱིར།",
    "ཕྱི་དང་ནང་ལ་སོགས་པ་ཇི་ལྟར་འདུག་ལྟོས་ཤིག་གསུངས་པས།",
    "༡ད་དུང་མུ་སྟེགས་པར་ལྡོག་པར་འདུག།",
    "མི་རྣམས་ཀྱིས་ཕྱིན་པས་སློབ་དཔོན་གྱི་རྩྭའི་སྤྱིལ་བུའི་འདོམ་གང་ཚུན་ཆད་མེས་མ་འཚིག་པར་འདུག་ཅིང་།",
    "བལྟས་པས་རྗེས་ལས་མི་འདུག་པས་ཀུ་མ་རི་ཡིད་ཆེས་སོ།",
    "ཚིག་ཁེངས་སྐྱུངས་པར་འདུག་པས།",
    "སང་རང་ཉིད་སྡོད་པར་འགྱུར་བའི་ཁྲི་དེ་ལ་རྗེ་བཙུན་འཇམ་དབྱངས་བཞུགས་ནས།",
    "གདུགས་ཚོད་གསོལ་གྱིན་འདུག།",
    "དེའི་གྲལ་ཞབས་ན་ཇོ་བོ་ཉིད་ཀྱང་བཞུགས་འདུག་པ་ལ།",
    "སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་བཞེངས་པའི་རྡོ་ར་ན་བཞུགས་ཙ་ན།",
    "བ་སོའི་རྒྱལ་བ་ཤཱཀྱ་ཐུབ་པ་གཅིག་འདུག་པ་དེའི་ཞལ་ནས།",
    "དེ་ནས་རབ་ཏུ་ཕྲ་བར་གྱུར་པས་ཁོང་རང་གཉིས་ཀྱིས་གོ་གཞན་གྱི་མི་གོ་བར་གྱུར་ཏོ།",
    "ང་རང་ལ་ཡང་བར་ཆོད་བྱུང་ན་ཇོ་བོ་ཆེན་པོ་སྤྱན་མི་འདྲོངས་པར་གདའ་བས་ཁོ་དང་ཐབས་མཁས་པས་བསྟུན་ཏེ་ཁུ་བོ་བླུའོ་སྙམ་དུ་དགོངས་ནས་བླུས་པ་དང་།",
    "འོ་ན་ཁྱེད་རང་པཎྜི་ཏ་གདན་འདྲེན་པའི་འཕྲོ་བཤོལ།",
    "ཁྱེད་རང་ཡང་ངའི་འོག་ཏུ་ཞུགས།",
    "པཎྜི་ཏ་གདན་མ་དྲངས་པར་ཁྱེད་རང་ངེད་ཀྱི་འོག་ཏུ་ཞུགས་ཟེར་བ་ལ་ནི།",
    "དེ་ནས་གསེར་ཁྱེད་རང་ཙམ་ཞིག་དགོས་ཟེར་བ་ལ་གསེར་བཙལ་བས།",
    "གསེར་ང་རང་ཙམ་རྙེད་པ་ཤིན་ཏུ་རྔམ་ཆེ་ན།",
    "ཁྱད་པར་ཨུ་པ་སི་ཀ་གཅིག་ལ་བརྟེན་ནས་ཕན་ཐོགས་ཏེ་འོང་བར་འདུག།",
    "ཚེ་ནི་བོད་དུ་བྱོན་ན་ཐུང་བར་འདུག་གསུང་།",
    "དེ་ཐད་འཇའི་གུར་གསུམ་བརྩེགས་འདུག།",
    "ལྷ་བཙུན་བོ་དྷི་རཱ་ཛས་ཇོ་བོ་ལ་ལྷ་བཙུན་པས་ཕྱག་མཛད་ཙ་ན་མི་བཞེང་།",
    "ཁོ་བོས་ཕྱག་བགྱིས་ཙ་ན་སྐུ་ལུས་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་མཛད་ཀྱང་བཞེང་བ་ཇི་ལྟར་ལགས་ཞུས་པས།",
    "སྒྲོལ་མ་དཀར་སྔོ་གཉིས་གང་དུ་འདུག་གསུང་།",
    "རྣལ་འབྱོར་པ་མི་བཞུགས་པར་གདའ་སྐད།",
    "གཞན་རྟེན་གྱི་དངོས་པོ་ཅི་ཡང་མི་འདུག།",
    "སྔོན་གཙིགས་ཆེ་བར་བྱུང་འདུག་གོ།",
    "དེ་ནས་ཇི་ལྟར་བཞེད་པ་ལྟར་བྱོན་ཏེ་སོག་ཆུ་ཁར་ཕེབས་པ་ན་ཁང་པ་ཅིག་ན་ཀུ་དི་རི་འདུག་པས།",
    "དེ་ཙ་ན་བསྐུལ་མ་གྱིས་ལ་ལ་སྟོད་དུ་བསུ་བས་སླེབ་པར་མཛོད་ཅིག་པའི་ཞུ་བ་ཕུལ་བས།",
    "དེ་ཙ་ན་ཇོ་བོ་རྗེ་ལ་རྗེ་བཙུན་སྒྲོལ་མའི་ཞལ་ནས།",
