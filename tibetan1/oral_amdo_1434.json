    "ལུས་ཅན་སྦྱང་ཚོགས་ཉེར་འཚོའི་གཞི་རུ་ཤོག།",
    "རིགས་གསུམ་གདུལ་བྱའི་ཚོགས་རྣམས་རེ་རེ་ལའང་།",
    "མཆོག་དམན་འབྲིང་གི་སྐལ་བ་གང་། འཚམ་ཚུལ།",
    "དད་བརྩོན་ཟུང་གི་དཔུང་བ་བརྟན་པ་ཡིས།",
    "མི་ནུབ་སྲིད་པའི་རྩེ་མོར་བསྒྲེངས་ནུས་ཤོག།",
    "དགྱེས་པའི་ཞལ་མཐོང་གསུང་གིས་དབུགས་དབྱུང་སྟེ།",
    "ན་མོ་གུ་རུ་མཉྫཤྲཱི་ཡེ།",
    "རབ་འབྱམས་ཞིང་གི་རྒྱལ་བ་སྲས་བཅས་ཀྱི།",
    "མཚན་དཔེའི་ལང་ཚོ་ཀུན་ནས་བའི་རྡོ་ལྷམ་མེ་བ།",
    "ཁྱོད་ལས་གཞན་ན་དམིགས་སུ་མ་མཆིས་པས།",
    "ཨེ་མ་འཇིག་རྟེན་ཀུན་གྱི་མིག་གཅིག་ཁྱོད།",
    "མ་རིག་མུན་ཆེན་འཇོམས་པའི་ཉིན་མོར་བྱེད།",
    "སྒྲིབ་མེད་ཡེ་ཤེས་སྤྱན་གྱི་ལེགས་གཟིགས་ནས།",
    "གང་གི་མཁྱེན་རབ་འོད་སྟོང་འབར་བ་ཡིས།",
    "ན་མོ་གུ་རུ་ཨཱརྱ་མཉྫཤྲཱི་ཡ།",
    "གང་གི་ཡོན་ཏན་ཆུ་གཏེར་ཆེན་པོའི་ཁམས།",
    "དངོས་གྲུབ་འབྱུང་གནས་ལྷག་པའི་ལྷ་ཁྱོད་ཟུང་།",
    "ལེགས་པར་གཟིགས་སམ་ཡེ་ཤེས་སྤྱན་ལྡན་པ།",
    "ཁྱོད་ནི་ཡོན་ཏན་རྒྱ་མཚོ་གཏིང་མཐའ་བྲལ།",
    "ཁྱོད་ནི་ཤེས་རབ་ཆེས་མཆོག་ལྡན་པ་སྟེ།",
    "ཉིད་ཀྱི་སྐྱོན་དང་བདག་གི་ཡོན་ཏན་གཉིས།",
    "གང་གི་ཡོན་ཏན་རྒྱ་མཚོ་ལྟ་བུ་ལས།",
    "དབུལ་པོས་འབྱོར་ལྡན་དག་ལ་སློང་མོ་བཞིན།",
    "ཁྱོད་ཉིད་བསྙེན་སྒྲུབ་མཆོད་བསྟོད་གསོལ་བཏབ་འབྲས།",
    "ཁྱོད་ཀྱི་ལྷག་བསམ་ཁུར་དུ་ལེགས་རོལ་བཞེས་ཤིང་།",
    "ཁྱོད་ནི་ཡིད་ཅན་རྒྱ་མཚོ་སྤྱི་ཡི་དཔལ།",
    "གང་གི་བྱིན་མཐུ་ཁོ་ནར་ངེས་ལགས་ན།",
    "ན་རྒ་འཆི་བའི་དཔུང་གིས་མ་བཅོམ་ཚེ།",
    "ན་མོ་གུ་རུ་མཉྫགྷོ་ཥཡ།",
    "ཉོན་མོངས་གཉིད་ལས་སློང་བྱེད་དེ་ལ་འདུད།",
    "དྲན་པས་ངག་གི་དཔལ་སྟེར་དེ་ལ་འདུད།",
    "གྲུབ་པ་མཆོག་གི་དཔལ་ལ་སྦྱོར་མཛད་པའི།",
    "དེ་ལྟར་ཁྱོད་ལ་ཆ་ཙམ་བསྟོད་པའི་མཐུས།",
    "ན་མོ་གུ་རུ་མཉྫ་ཤྲཱི་ཛྙཱན་ས་ཏཱ་ཡ།",
    "དམར་སེར་རལ་གྲི་ཅན་ཁྱོད་བསྟོད་པར་བགྱི།",
    "མཁྱེན་རབ་ཡེ་ཤེས་སེམས་དཔའ་ཁྱོད་ལ་བསྟོད།",
    "མཛད་པ་ཀུན་ལས་མཆོག་གི་རབ་དང་ཕུལ།",
    "༡། གསུང་གི་རང་གཟུགས་སྒྱུ་མའི་མིག་འཕྲུལ་བཞིན།",
    "ཕྱག་ཞབས་མཐིལ་རྣམས་རྩིབས་སྟོང་རི་མོས་མཛེས།",
    "གང་འདོད་ཞུ་བ་ཇི་སྙེད་ཕུལ་བའི་མོད།",
    "གསུང་དབྱངས་གཅིག་གིས་སོ་དྲུག་དེ་སྙེད་ལན་མཛད་པ།",
    "ཕུལ་བྱུང་རྣམ་དཔྱོད་ལུས་ཕྲའི་ཁམ་ཚང་གིས།",
    "ལྷག་པའི་ལྷ་འདི་ལ་མི་ཕྱེད་དད་མོས་བརྟན་པའི་ཀུ་ས་ལི་པ་ཝཱ་གིནྡྲ་ཤཱ་ས་ན་བྲི་ཏིའམ་མིང་གཞན་རོལ་བའི་རྡོ་རྗེ་འབོད་པས་འཕྲལ་དུ་གང་ཤར་སུག་ལས་ཟླབགྱིས་པའོ།",
    "ན་མོ་གུ་རུ་མཉྫཤྲཱི་ཡེ།",
    "ཁྱོད་ལ་བསྟོད་དོ་བརྩེ་བས་རྗེས་སུ་ཟུངས།",
    "ཐུན་མོང་མཆོག་གི་དངོས་གྲུབ་རྒྱ་མཚོའི་གཏེར།",
    "དང་བའི་ཡིད་ཀྱི་ཐལ་སྦྱར་ཕྱག་གི་ཡུལ།",
    "ཉན་རང་བྱང་སེམས་རིགས་ཅན་རྩེ་མོ་ཡི།",
    "ལྷུན་འགྲུབ་འདོད་དགུས་རེ་སྐོང་ཡིད་བཞིན་ནོར།",
    "ཕུན་ཚོགས་རྟེན་འབྱུང་ཟབ་མོའི་ནུས་སྟོབས་ཀྱིས།",
    "དགོས་མེད་ངང་གིས་སྐྱེ་བར་བྱིན་གྱིས་རློབས།",
    "སྡིག་ལྟུང་རྒོལ་བ་སྟོབས་ཀྱི་དཔུང་ཚོགས་བཞིས།",
    "ངེས་པར་རིག་ནས་ངེས་འབྱུང་རྣམ་དག་གིས།"
  ]
}