    "ཁོ་ཚོས་སྐད་ཆ་དྲང་པོ་བརྗོད་མ་སོང་།",
    "གཉིས་ན་ཁོ་ཙུའུ་ཀྲང་གི་གོ་གནས་ནས་བརྗེ་རོགས།",
    "ཡང་ན་ང་ཙུའུ་གཞན་ན་བཞག་རོགས་མ་གཏོགས་ཕྱིན་ཆད་ཁོས་ངའི་བསྒྱུར་བཀོད་ཀྱི་འགྲོ་ལམ་བཀག་ས་རེད་ཅེས་ཡང་ཡང་ཞུས་མཐར།",
    "མེད་ན་དེ་ག་རེད།",
    "ང་ཚོའི་རླབས་ཆེན་གྱི་མའོ་ཀྲུའུ་ཞིའི་བཀའ་སློབ་ལའང་།",
    "མེད་ན་དོགས་ཟོན་བྱེད་དགོས་ཞེས་གསུངས་ཡོད་རེད།",
    "བསམ་འཆར་སུ་ཡིན་ནའང་བཏོན་ཆོག་གི་རེད་ཟེར།",
    "དེ་ནས་བཟུང་དེའི་སྐོར་འཇམ་ཐིང་ངེར་གྱུར་སོང་།",
    "སྡོད་ས་བཙོན་པའི་རུ་ཁག་གི་མིང་བཅས་གསལ་པོར་ལབ་བྱུང་བས།",
    "ངས་བཙོན་པ་དེ་སྐབས་དེ་དུས་ཀྱི་དམག་འཁྲུག་ནང་རྩ་བ་ནས་ཡོད་མ་རེད།",
    "སྐད་ཆ་དེ་དག་ནི་འོལ་ཚོད་བྱས་ནས་སྐྱག་བརྫུན་ལབ་པ་དངོས་གནས་རེད།",
    "ཡང་ཉིན་ཞིག་གི་ཞོགས་པ་བཙོན་པ་ཚང་མ་སྒོ་རྭའི་ནང་བང་སྒྲིག་སྟེ།",
    "ངས་ཁྲག་གི་མིག་ཆུ།",
    "རྒྱལ་སྲས་ལག་ལེན་སོ་བདུན་མ་ཡིག་འབྲུ་མིག་གིས་རིག་ཙམ་ཞིག་བྲིས་པའི་དེབ་ཆུང་ཙག་སྒྲའི་སྒམ་ཆུང་ཙམ་ཞིག་ཡོད་པ་དེ་ལམ་སེང་གདན་འོག་ཏུ་བཅུག་དགོས་བྱུང་ཡང་།",
    "ལས་བྱེད་བློ་བཟང་གིས་ང་སྐད་བཏང་ནས་ཡི་གེ་འདི་ཁྱོད་ཀྱིས་བྲིས་པ་རེད་དམ་ཟེར་བས།",
    "ངས་རང་གིས་བྲིས་པ་མིན།",
    "ཁོ་ཚོར་འབྲས་གྲོ་ཞིབ་དང་སྔོ་ཚལ་སོགས་ཆ་རྐྱེན་ཡག་པ་ཡོད་པ་རེད།",
    "ང་ཚོའི་ནང་ནས་ལྟོ་བ་ཆེ་བའི་མི་རྣམས་ལྟོགས་སྡུག་ཆེན་པོ་མྱང་སོང་།",
    "ཕོར་པ་དང་ལྟོ་སྣོད་སོགས་ཁྲུས་པའི་ཆུ་བཅས་ཕག་ལྟོ་སྟེར་བའི་ཆེད་དུ་ལྕགས་ཀྲིང་ནས་བླུགས་ནས་ཐབ་ཚང་སྒོ་ཁར་བཞག་པ་དེའི་ནང་ནས་ཀྲིང་མོག་རྡོག་རྡོག་རྣམས་ལེན་ནས་ཟ་བ་དང་།",
    "ང་ཚོར་འབྲུ་རིགས་ཉོ་བྱེད་ཤོག་སྒོར་རེ་ཟུང་བསྐུར་རྒྱུ་འདུག་ན་ཕན་ཐོགས་ཆེན་པོ་འདུག་ཟེར།",
    "དེ་དུས་བཙོན་པ་རེ་ལ་ཟླ་རེར་སྒོར་ཟུར་ལྔ་རེ་སྤྲོད་ཀྱི་ཡོད་ཀྱང་ཉོ་རྒྱུ་ནི་གང་ཡང་ཡོད་མ་རེད།",
    "བློ་བཟང་ཡོན་ཏན་ལ་མི་ཁ་ཤས་ཀྱིས་སྒོར་རེ་གཉིས་སྤྲད་པ་རྣམས་བཅས་སྒོར་བཅུ་ཁྱིམ་དུ་བསྐུར་བ་དེའི་ཡིག་ལན་འབྱོར་བའི་ནང་དངུལ་སྒོར་བཅུ་བསྐུར་བ་དེ་ཕན་ཐོགས་ཆེན་པོ་བྱུང་སོང་།",
    "ཞུས་ཏིང་ཡུས་ཟེར་བའི་རྒྱ་བཙོན་ཞིག་ཡོད་པ་དེའི་ཨ་མའི་ཡི་གེ་འབྱོར་བའི་ནང་།",
    "བུ་ཁྱོད་ལ་ཡིག་རྟེན་ནི་གང་ཡང་བསྐུར་རྒྱུ་རྙེད་མ་སོང་།",
    "བོད་ཁྱོན་ཡོངས་སུ་སྡུག་བསྔལ་མྱངས་པ་ནི་བརྗོད་དུ་མི་ལང་།",
    "དཔེར་ན་༡༩༦ ལོ་ལོ་གཅིག་ཌོ་ནའི་ནང་ཚ་བ་སྤོམ་མདའ་ལ་བཙོན་པ་༡༨ ཡོད་ཁོངས་ནས་༡༦ མུ་གེས་ཤི་བ་རེད།",
    "ཕྱི་ལོ་༡༩༧ ཟླ་༥ ཚེས་༨ ཉིན་མི་༡༤ དུས་གཅིག་ཏུ་དམར་གསོད་བཏང་བ་རེད།",
    "ལུས་ལ་སྟོད་ཐུང་དང་གུ་ཐུང་ནག་པོ་རེ་གཡོགས་ཡོད་སྟབས་ནག་ཉིལ་ཉིལ་སོལ་དོང་ནང་ལ་བལྟས་པ་ལྟར་དང་།",
    "བསམ་ངན་ཡིན་ན་གད་མོ་ཤོར་བ་ཞིག་ཏུ་འགྱུར་ངེས་ལྟ་བུ་ཡིན།",
    "དམག་དཔོན་རྒྱ་གཏེ་པོ་ཞིག་འདུག་པ་དེས་སྐད་བསྒྱུར་བརྒྱུད་ནས་ཉེས་བཙོན་ཚོ་ཡར་ལངས་མི་ཆོག་ཕན་ཚུན་སྐད་ཆ་ཤོད་རེས་མི་ཆོག་མིག་གིས་ཡག་པོ་ལྟོས།",
    "ཁྲག་གི་མིག་ཆུ།",
    "མི་རེ་ལ་ཤིང་བྱང་སྤྱི་ཁྲེ་རེ་ཙམ་ཕལ་ཆེར་ཡོད་ས་རེད།",
    "ཚང་མའི་སྐེ་རྩྭ་ཐག་གིས་བསྡམས་ནས་དབུགས་གཏོང་ལོ་ཙམ་བྱས་འདུག་པ་དེ་ནི་འབོད་སྒྲ་རྒྱག་པའི་དོགས་ཟོན་ཆེད་ཡིན་པ་འདྲ།",
    "རྒྱབ་ཏུ་མེ་མདའ་བཟུང་མཁན་རེའི་མེ་མདའ་རྩེ་གྲི་མགོ་བོར་ཐུག་ལ་ཁད་བྱས།",
    "ཀེ་རེ་གོང་བཀྲ་ཤིས་ཚེ་རིང་།",
    "ད་དུང་མི་གཅིག་གི་མིང་ད་ལྟ་དྲན་ཐུབ་ཀྱི་མི་འདུག་པ་བཅས་རེད།",
    "བ་རེ་ལྡིང་དཔོན་རིག་དངོས་གཉིས་ཀྱི་ཕ་མ་གཅིག་པའི་སྤུན་གཉིས་དམར་གསོད་གཏོང་རྒྱུའི་ནང་ཡོད་པས་ཁོ་པ་གཉིས་མདུན་དུ་བཞག་ནས་ལྟ་བཅུག་པ་རེད།",
    "མགོ་ཞུམ་ཞུམ་དང་ཉྭ་དམའ་པོ་བྱེད་མཁན་གཅིག་ཀྱང་མི་འདུག་མཐའ་ན་གདོང་གཤིས་འགྱུར་བ་ཙམ་ཡང་མཐོང་མ་སོང་།",
    "སྐེ་རྩྭ་ཐག་གིས་བསྡམས་མེད་ན་འབོད་སྒྲ་རྒྱག་རྒྱུའི་ཐེ་ཚོམ་མི་འདུག་ཉེས་པ་བསྒྲགས་ཚར་ནས་ཕར་དེར་ཁྲིད་སོང་།",
    "ང་ཚོ་ལ་ཚང་མར་མིག་ལྟོས་ཤིག་ཟེར་ནས་མེ་མདའ་མང་པོ་བརྒྱབ་ནས་བསད་སོང་།",
    "རྒྱ་དམར་གྱིས་ང་ཚོར་འཇིགས་བསྐུལ་བྱས་ཏེ་ལྟ་བཅུག་པ་རེད་དེ།",
    "ཁོ་ཚོའི་བཙན་འོག་ནས་སྔ་ཕྱི་མ་གཏོགས་ང་ཚོར་འདི་འདྲ་ཡོང་གི་རེད་བསམ་ནས་སེམས་ཐག་ཆོད་པ་ལས་དམིགས་བསལ་སྐྲག་སྣང་གང་ཡང་མ་བྱུང་།",
    "བཙོན་རོགས་དམར་བསད་བཏང་བ་རྣམས་ཀྱི་ཞུམ་པ་མེད་པའི་དཔའ་བོའི་ཞལ་རས་དེ་ངའི་མིག་ལམ་དུ་ཤར་བ་དང་ཆབས་ཅིག་ཡི་གེ་འདི་འབྲི་བའི་སྐབས་མིག་ཆུ་གཏོང་གིན་གཏོང་གིན་འབྲི་དགོས་བྱུང་ཞིང་།",
    "བོད་མི་དཔའ་བོ་ཚོས་ལུས་སྲོག་གི་དཀའ་སྡུག་མྱངས་པ་ནི་ངའི་མིག་ལམ་དུ་ནམ་ཡང་ཡལ་ཐབས་མེད།",
    "ཚ་བ་རོང་པ་ནོར་བུ་ཚེ་རིང་བཅས་དམར་གསོད་བཏང་བ་རེད།",
    "ཁོང་གིས་རྒྱུན་དུ་རྒྱ་དམར་ལ་མི་འདོད་པའི་བརྗོད་ཚིག་མང་པོ་སོང་བ་ཁྲག་གི་མིག་ཆུ།",
    "རྒྱ་དམར་ཁོང་ཚོས་མི་བསད་ནས་གཞན་ལ་འཇིགས་སྣང་སྐུལ་གྱི་ཡོད་པ་རེད།",
    "ལག་པ་གཡས་གཡོན་གཉིས་ལ་བུ་མོ་ལོ་བཅུ་ལྷག་ཙམ་ཡིན་པ་དེ་དང་།",
    "བྲོས་བྱོལ་འགྲོ་རྩིས་བྱེད་ཀྱི་འདུག་ཟེར་ཏེ་མེ་མདའ་རྒྱབ་ནས་ཞིང་ཁའི་ནང་བསད་པ་རེད།",
    "རྒྱ་དམག་ཚོ་བོད་མི་གསོད་རྒྱུར་དགའ་བའི་རྐྱེན་གྱིས་གང་ཡང་མ་ལབ་པ་མ་གཏོགས་སྒོ་ཆེན་རྩ་བར་ཡོང་དུས་ནས་འགྲོ་མི་ཆོག་ལབ་ན་འགྲོ་ཕོད་ཀྱི་མ་རེད།",
    "དང་སྟབས་འཁེལ་ནས་སྒོ་ཕྱིར་འགྲོ་ཆོག་གི་མ་རེད་ཟེར་མ་ཐག་ཕྱིར་ལོག་བྱས་འདུག་པས་གནས་ཚུལ་གང་ཡང་མ་བྱུང་།",
    "ཨ་ཁྲིད་ཀྱི་མགོ་བཅད་དེ་རུ་ཁག་ཚང་མའི་ནང་ཁྱེར་ཏེ་བྲོས་བྱོལ་འགྲོ་རྒྱུའི་བསམ་བློ་ཡོད་མཁན་རེད་ཟེར་བ་རྣམས་ལ་ཐོད་པ་གཏུགས་བཅུག་སོང་།",
    "ཨ་ཁྲིད་ཀྱི་མགོ་སྒྲོག་ཙེ་ཞིག་གི་ཐོག་བཞག་ནས་ཐོད་པ་གཏུག་མཁན་དེ་ཡིས།",
    "ཨ་ཁྲིད་ང་རང་གཉིས་མགྱོགས་པོ་ཐུག་གི་རེད་ལབ་ནས་ཐོད་པ་གཏུག་བཅུག་པ་རེད།",
    "མགྱོགས་པོ་ཐུག་གི་རེད་ལབ་དགོས་ཟེར་དོན་ནི་བྲོས་བྱོལ་སོང་ན་ཨ་ཁྲིད་ནང་བཞིན་བསད་ཀྱི་ཡིན་ཟེར་བའི་གོ་དོན་རེད།",
    "ལྷོ་ཁ་ཕུན་ཚོགས་རྣམ་རྒྱལ་གཉིས་ཐག་པས་བསྡམས་ནས་མཚན་གང་བཞག་ནས་བསད་པ་རེད།",
    "དཔལ་འབར་གནས་རྟེན་སོགས་ཀྱིས་རང་ཤི་བརྒྱབ་པ་རེད།",
    "འདིར་བཙོན་ར་ཨང་གཉིས་པའི་རུ་ཁག་༡༢ ཀྱི་གནས་ཚུལ་མཐོང་ཐོས་བྱུང་རིགས་ཡིན་པ་ལས་ང་ཚོའི་རུ་ཁག་ཁེར་བུའི་གནས་ཚུལ་མིན་སྟབས་དེ་ཙམ་ལས་བཀོད་ཐུབ་མ་སོང་།",
    "ང་ཚོ་བོད་མིའི་ནང་ནས་ཆེས་ཉུང་ཤས་རེ་ཟུང་གིས་རྒྱ་དམར་གྱི་རྐུབ་གཡོག་རྒྱུག་གི་ཡོད་པ་ལྟར་བཙོན་པ་ཉུང་ཤས་ཀྱིས་རྒྱ་དམར་གྱི་རྒྱུག་ཁྱི་བྱས་པའི་ནང་ནས་ལྷག་པར་དུ་ལྕགས་མདའ་བྱམས་པ་དང་།",
    "གཞན་ལ་གནོད་སེམས་འཁོན་འཛིན་མཁན་བོད་མི་རིགས་ཀྱི་རྐང་འདྲེན་པ་གཉིས་རེད།",
    "ལྷན་པ་དམར་སེར་སོགས་མི་གཞན་གྱི་ཞྭ་མོའི་བར་རམ་གྱོན་ཆས་ཀྱི་ལྷན་པའི་བར་གཞན་གྱིས་མ་མཐོང་སར་བཅུག་ནས་ཉིན་རེ་ཟུང་ནས་བསྔོག་གཤེར་བྱེད་ཅིང་།",
    "རྒྱ་དམག་བསད་ནས་རྒྱ་གར་ལ་བྲོས་བྱོལ་འགྲོ་རྩིས་རེད་ཟེར་བ་དང་།",
    "ཁྲག་གི་མིག་ཆུ།",
    "རླབས་ཆེན་གཙོ་འཛིན་མའོ་ཀྲུའུ་ཞིའི་སྐུ་དཔར་ལ་ཁྲག་གིས་དམར་ཁྲམ་བརྒྱབ་སོང་ཟེར་བ་སོགས་མི་ཚོའི་བསམ་བློའི་ནང་འཁོར་མི་ཐུབ་པའི་བྱ་བ་ཁོ་ན་བྱས་པའི་རྐྱེན་གྱིས་མི་མང་པོ་དམར་གསོད་བཏང་བ་རེད།",
    "ཤོག་གྲངས་ལྔ་བརྒྱ་དྲུག་བརྒྱ་ནི་ཡོང་ཐག་ཆོད་རེད།",
    "རྒྱལ་ས་ལྷ་ས་སོགས་ལ་ནི་དེ་བས་ཀྱང་འགྲོ་ཕོད་ཀྱི་མེད་སྟབས་ཁོ་པ་གསོད་རྒྱུའི་གོ་སྐབས་མ་ཤར་བ་རེད།",
    "དེ་ལ་དགག་པ་རྒྱག་མ་དགོས་པ་ཐུགས་རྗེས་གཟིགས།",
    "གཞན་ཡང་ལས་ཀ་ལས་རྒྱུ་དང་སྒྲིག་ལམ་སྲུང་རྒྱུ་སོགས་ཧུར་བཙོན་བྱེད་ཀྱི་ཡིན་ཞེས་ག་དུས་ཡིན་ནའང་རྒྱུན་འཁྱོངས་བྱེད་པ་དང་།",
    "དཔའ་ཤོད་བློ་བཟང་ཉི་མ་ལ་རྒྱ་བཙོན་ཀུའུ་སི་ཀྲིང་གིས་བྲོས་བྱོལ་འགྲོ་རྒྱུའི་སྒྲིག་འཛུགས་བྱས་ཡོད་ཟེར་བའི་རྐྱེན་གྱིས་འཐབ་འཛིང་བཏང་ཡང་ཁས་མ་བླངས།",
    "དེར་བརྟེན་ང་རང་གཉིས་བྲོས་དང་ཐར་གྱི་རེད་ལབ་བྱུང་ཟེར།",
    "ཚང་མས་རྒྱ་གར་ལ་ཐར་ཡོད་པ་ངོས་འཛིན་བྱེད་པའི་སྐབས་རེད།",
    "བཙོན་པའི་ནང་གི་ཡར་ཐོན་པ་ཞིག་གིས།",
    "ཁྱོད་ཀྱིས་མའོ་ཀྲུའུ་ཞི་ལ་འཁོན་འཛིན་ཡོད་དམ་མེད་ཟེར་བས།",
    "གང་ཡིན་ཟེར་ན་སྐྱེ་བ་སྔ་ཕྱི་བརྗེས་པའི་རྐྱེན་གྱིས་ངོ་མ་ཤེས་པ་མ་གཏོགས་ངའི་ཕ་མ་བྱེད་མྱོང་ཡོད་པ་རེད་ཟེར།",
    "ཁོ་པ་ནི་ལྷག་བསམ་དཀར་བའི་མི་ཞིག་རེད།",
    "བྱམས་པ་མགོ་ཆེ་ཤི་ནས་ལོ་གཅིག་ཙམ་ནས་ཁ་བ་བབས་སྐབས་ཁོ་ཚོའི་ཁང་པ་མཐོང་སར་རི་གདོང་ཞིག་གི་ཐོག་སྤྱང་ཀི་ཞིག་ཡོང་སྟེ་ཁང་པའི་ཕྱོགས་ཁ་གཏད་ནས་ངུ་ཟུག་རྒྱུན་དུ་བྱེད་ཀྱི་ཡོད་པས།",
    "ར་ལུག་དེད་ནས་ཟིན་གྲབས་སྐབས་བྱམས་པ་མགོ་ཆེ་ཞེས་འབོད་དུས་ལམ་སེང་རྐུབ་ས་ལ་བཙུགས་ཏེ་ངུ་ཟུག་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "སྐྱེ་དམན་དེས་ཀྱང་ངུ་བཞིན་པའི་ངང་ངའི་བཟའ་ཟླའི་སྐྱེ་བ་རེད་ཟེར་གྱི་ཡོད་པ་རེད།",
    "ང་ནི་སྔོན་མ་རྒྱ་དམག་གིས་མེ་མདའ་བརྒྱབ་ནས་རྨས་རྗེས་ཤི་བའི་དཔལ་ལྡན་ཟེར་བ་དེ་ཡིན།",
    "ངའི་མ་ལ་མཚོ་མོ་ཟེར།",
    "གཞན་གང་ཡང་ལབ་མི་དགོས་ཟེར་ཡང་ཁ་ཚིག་གཅིག་ཀྱང་གྲགས་མ་སོང་།",
    "བསམ་བློ་ཡག་པོ་མེད་པའི་གྲས་སུ་བཞག་གི་ཡོད།",
    "རང་གི་རྒྱབ་ཏུ་སྒྲོག་ཙེ་དང་རྐུབ་སྟེགས་ཐོག་ལས་བྱེད་རྣམས་བསྡད་ཡོད།",
    "སྡུག་བསྔལ་དང་བྲལ་བ་ཞེས་འཁོད་ཡོད་པ་རེད།",
    "ཨེ་གོ་ཟེར་བས།",
    "དེ་ལྟར་ལབ་པ་རེད་ཅེས་སྐད་བསྒྱུར་བྱས་སོང་བས་རྒྱ་དཔོན་དེས་ཁོ་པ་གྲལ་རིམ་མངའ་བདག་ལས་ཚབ་མིན་ན་ཐག་གཅོད་ཕབས་དགོས་རེད་ལབ་སོང་།",
    "དེ་ནས་ངས་དེ་ནི་རྨོངས་དད་རེད།",
    "རང་གཞན་གཉིས་ཀར་གནོད་སྐྱེལ་བའི་རྒྱུ་རེད།",
    "ལས་བྱེད་ཚོས་དགག་པ་ཡག་པོ་བརྒྱབ་སོང་ཞེས་བསྟོད་བསྔགས་བྱས།",
    "དེ་ནས་བཟུང་རྒྱ་མིས་ང་ལ་ལྟ་སྟངས་ཡག་ཏུ་ཕྱིན་སོང་།",
    "བྲག་གཡབ་འཇམ་དབྱངས་རྡོ་རྗེ་སོགས་ནས་མིག་ཆུ་བཏང་གི་འདུག་སྐབས་དེར་བེ་རི་ཨ་ཕོ་དགའ་དགས།",
    "ཁྲག་གི་མིག་ཆུ།",
    "དམག་མི་ཁག་ཅིག་ཡོང་སྟེ་བཙོན་པའི་གཟུགས་པོ་དང་གྱོན་ཆས་བསྔོག་གཤེར་བྱེད་པའི་འགོ་བཙུགས་སོང་།",
    "དེ་མིན་ས་གནས་གཞན་ལ་ཡང་བུད་མེད་མང་པོ་དམར་གསོད་བཏང་ཡོད་པ་རེད།",
    "པོས་རང་སྲོག་བློས་གཏོང་བྱས་པ་རེད།",
    "༡༩༥༩ ལོའི་ཕྱི་ཟླ་༣ ནང་རང་རེའི་རྒྱལ་ས་ལྷ་སར་དཔའ་མོ་ཀུན་བཟང་ལགས་ཀྱིས་གཙོས་པའི་བུད་མེད་སྟོང་ཕྲག་རེ་ཟུང་གིས་བཙན་རྒོལ་རྔམ་སྟོན་ཁྲོམ་བསྐོར་བྱས་པར།",
    "བུད་མེད་མང་པོ་རྒྱ་དམར་གྱིས་བསད་རྨས་བཟུང་གསུམ་བྱས་ཤིང་།",
    "ཁོང་གིས་རྒྱ་མི་བོད་ནས་ཕྱིར་རྒྱུགས།",
    "ངས་རྒྱ་ནག་ལ་ངོ་རྒོལ་བྱེད་དོན་མེད་ཅེས་ལན་བརྒྱབ་པ་རེད།",
    "ཁོང་གིས་སྤོབས་པ་དང་སྐད་གསེང་མཐོན་པོའི་ངང་ནས་སྐྱབས་མགོན་རྒྱལ་བ་ཡིད་བཞིན་ནོར་བུའི་དགུང་སྐེག་དང་།",
    "བོད་བསྟན་སྲིད་མི་རིགས་དང་བཅས་པའི་ཆེད་དུ་རང་སྲོག་བློས་གཏོང་གནང་བ་རེད།",
    "ང་ཚོས་ཁོང་ཚོའི་མཛད་རྗེས་ལ་དྲན་གསོ་དང་མིག་དཔེ་ལྟ་དགོས་པ་རེད།",
    "སྐབས་དེར་རང་གི་མ་གྲོངས་པའི་གནས་ཚུལ་ཡིག་ཕྲིན་འབྱོར་བྱུང་བས་རྒྱ་མིས་མནར་གཅོད་གང་འདྲ་ཞིག་བཏང་བའི་འོག་གྲོངས་ཡོད་ན་བསམ་པའི་སེམས་ཁྲལ་ཆེན་པོ་བྱུང་།",
    "ཟླ་བ་གཅིག་ཙམ་གྱི་སྔོན་ལ་རྨི་ལམ་ནང་ཕ་ཡུལ་གྱི་ས་ཆ་ཉིན་མོ་ཟེར་བ་དེར།",
    "རང་གིས་དགེ་སྦྱོར་གང་ཐུབ་བྱས།",
    "ཁག་ཅིག་གིས་ཐེག་ཆེན་གསོ་སྦྱོང་གི་སྡོམ་པ་ཡང་ལེན་གྱི་ཡོད།",
    "གནམ་གང་ལ་ཟླ་བ་རེ་རེ་བཞིན་མ་ཆག་པ་བྱེད་པ་དང་།",
    "ཨ་ཕོ་དགའ་དགའ།",
    "བོན་པོའི་དཔེ་རྙིང་དེ་དག་ད་ལྟའང་མཐོང་རྒྱུ་ཡོད་བཞིན་པ་རེད།",
    "འོན་ཀྱང་ད་སྐབས་མི་ཚོས་སྔ་མོ་བོད་ལ་ཡི་གེ་མེད་ཅིང་།",
    "དེར་བརྟེན་ང་ཚོས་ད་ལྟ་སྤྱོད་བཞིན་པའི་བོད་ཡིག་འདི་ཐོན་མི་སམ་བྷོ་ཊས་བཟོང་གནང་བ་རེད་ཟེར་ན་དོན་དངོས་དང་མཐུན་པ་རེད།",
    "ཅེས་བཀོད་ཡོད་པ་རེད་སོགས་གླེང་མོལ་བྱེད་མྱོང་།",
    "ད་དུང་ཁོང་གིས་ཁྱོད་རང་ད་ལྟ་ལོ་ཆུང་ཆུང་རེད་རྗེས་སུ་བསམ་ཡས་མཇལ་བའི་གོ་སྐབས་ཤར་གྱི་རེད་ན།",
    "བཙོན་རོགས་ཁ་ཤས་ཀྱིས་རེ་སྐུལ་ལྟར།",
    "རྒྱལ་སྲས་ལག་ལེན་སོ་བདུན་མ་དཔེ་བཤུ་རེ་ཟུང་བྱས།",
    "རང་ཉིད་བོད་ཀྱི་ལམ་ལུགས་རྙིང་པར་དེ་ཙམ་གྱིས་དགའ་མོས་མེད་མཁན་ཞིག་ཡིན།",
    "མོས་མཐུན་ཡོད་ན་ས་ཡིག་རྒྱག་དགོས་ལབ་པར།",
    "མང་མས་མོས་མཐུན་བྱས་སོང་།",
    "དཔེར་ན་ཨ་མེ་རི་ཀའི་སྲིད་འཛིན་དང་མི་དམངས་དཀྱུས་མ་གཉིས་འདྲ་མཉམ་རེད་དམ།",
    "ཁྱོད་ཀྱིས་མི་ཚང་མ་འདྲ་མཉམ་ཡིན་ཟེར་གྱི་ཡོད་རེད།",
    "དམག་མི་གཉིས་དཔུང་པ་མཉམ་གཤིབས་དང་གོམ་པ་མཉམ་བགྲོད་ཀྱིས་དགྲ་བོའི་མདུན་ཕྱོགས་སུ་མཆོངས་བཞིན་པའི་སྐབས་དེར་མདུན་དུ་མེ་སྒྱོགས་ཀྱི་མདེའུ་ཕོགས་ནས་མི་གཅིག་བསད་པ་ཁྲག་གི་མིག་ཆུ།",
    "དང་པོ་ཁྱོད་དང་ང་གཉིས་མཉམ་པ་ལ།",
    "ཞེས་གསུངས་པ་ལྟར་གནས་སྐབས་དང་གནས་ཚུལ་ཁ་ཤས་ཐད་འདྲ་ནའང་རྒྱུ་རྐྱེན་སྣ་ཚོགས་ལ་བརྟེན་ནས་འདྲ་མཉམ་ཡོང་ཐབས་མེད་པ་རེད།",
    "ད་སྐབས་རྒྱ་མི་གུང་ཁྲན་ཏང་གི་བརྗོད་ཚིག་ལའབྱོར་ལྡན་གྲལ་རིམ།",
    "ཀུན་སྤྱོད་སོགས་ཀྱི་ཆ་རྐྱེན་ཚང་ཡོད་ན་ཞིང་པའི་བུ་བུ་མོ་སུ་ཡིན་ནའང་འདྲ།",
    "འབྲོག་པའི་བུ་བུ་མོ་སུ་ཡིན་ནའང་འདྲ།",
    "མི་ལོ་སྟོང་ཕྲག་སྔོན་ནས་ད་བར་བོད་མིའི་སེམས་ལ་རྩབ་བརྟན་པོ་ཟུགས་ཡོད་སྟབས་མི་སུ་ཞིག་གིས་དེ་ལ་གཏོར་བཤིགས་གཏོང་ཐུབ་ཀྱི་མ་རེད།",
    "ཐོབ་བྱའི་འབྲས་བུ་སོགས་ནི་གཅིག་པ་ཡིན་པརེད།",
    "དེ་ནི་མི་དམངས་ལ་གཉའ་གནོན་བཤུ་གཞོག་བྱེད་པའི་ལག་ཆ་རེད་ཟེར་བ་དང་།",
    "གཟུགས་འདས་རིག་པའི་ལྟ་ཚུལ་ཞིག་རེད།",
    "རྒྱ་མི་གུང་ཁྲན་ཏང་གིས་བོད་ཀྱི་དགོན་ཁག་རྩ་གཏོར་གཏོང་བ་དང་།",
    "ཕྱིའི་གཟུགས་པོར་དྲག་གནོན་ཐུབ་ཀྱང་ནང་སེམས་ལ་དྲག་གནོན་ཐུབ་ཀྱི་མ་རེད།",
    "བྱེད་ཀྱང་ཐུབ་ཀྱི་རེད།",
    "ཐ་ན་མི་བསད་རེས་བྱས་པའི་གནས་ཚུལ་ཡང་བྱུང་ཡོད།",
    "ཐ་ན་གཅིག་ལས་མ་བྱུང་ནའང་དེ་མཁས་བཙུན་བཟང་གསུམ་དང་ལྡན་པ་ཞིག་བྱུང་ན་ཕན་ཐོགས་ཆེ་ཡི་རེད།",
    "དེ་ནི་དདཔ་དང་བརྩི་བཀུར་བྱ་ཡུལ་ཞིག་རེད།",
    "ཨ་མའི་བུ་ལ་ཡོན་ཏན་ཡོད་ན་དགའ་ལྡན་ཁྲི་ལ་བདག་པོ་མེད་ཟེར་བ་ལྟར་དགའ་ལྡན་ཁྲི་པ་ཡང་གྲྭ་དཀྱུས་ཞིག་ནས་གཞུང་ལུགས་རབ་འབྱམས་རྒྱ་མཚོ་ལ་ཐོས་བསམ་སྒོམ་གསུམ་གྱི་དཀའ་བ་བརྒྱ་ཕྲག་བསྐྱེད་ནས་མཁས་པའི་རྩེ་མོར་ཕེབས་པ་ཞིག་ཡིན་པ་རེད།",
    "དེའི་ལས་འགན་ནི་༡༩༤༩ ལོ་ནས་ད་ལྟའི་བར་རྒྱ་དམར་བཙན་རྒྱལ་རིང་ལུགས་པས་བོད་བཙན་བཟུང་གིས་ཀླ་ཀློའི་རྩུབ་སྤྱོད་བྱས་པའིབྱ་རིམ་ནང་བོད་བསྟན་པ་ཆབ་སྲིད་ཀྱི་དོན་དུ་རང་ཉིད་བློས་གཏོང་གིས་བྱས་རྗེས་ཅན་ལ་བྱ་དགའ།",
    "མི་ཞིག་གིས་རང་གི་ཕ་གསོད་སེམས་བཅངས་བ་མ་ཟད།",
    "བསད་པའི་སྦྱོར་བ་དངོས་སུ་བྱས་ནས་གསོན་རེ་བྲལ་ཡང་དྭ་ལྟ་ལམ་སེང་ཤི་མེད་ན་ཕ་མ་ཤི་བའི་སྔོན་དུ་བསད་པའི་སྦྱོར་བ་བྱེད་མཁན་གྱི་བུ་དེ་བསད་ན་ཕ་བསད་པའི་ཉེས་པ་ཆ་ཚང་འཁུར་མི་དགོས་ཤིང་།",
    "ཆུ་གྲང་མོ་གཤོ་བ་སོགས་གཏན་འགོག་བྱེད་དགོས།",
    "མ་ཉེས་ཁ་གཡོག་གིས་ཉེན་ཁའི་ལམ་ལ་བསྐྱལ་བ་བཅས་ཀྱི་སྡུག་བསྔལ་དང་དངངས་སྐྲག་མ་བཟོད་ནས་རང་ཤི་རྒྱག་དགོས་པ་བཟོས་པ་བཅས་ཀྱང་མི་ཡོང་བ་བྱེད་དགོས།",
    "བཙོན་པའི་འཚོ་བ་དེ་མང་ཚོགས་ཀྱི་འཚོ་བ་ལས་བརྒལ་མི་དགོས་ཀྱང་།",
    "ཡུལ་དུས་ཀྱི་ཆ་རྐྱེན་ལ་བསྟུན་ཏེཐ་ན་གྲོད་ཁོག་ལྟོགས་པར་ཁྲག་གི་མིག་ཆུ།"
  ]
