    "ཁ་སེང་དམག་མི་དེ་ཚོ་ཁྱེད་དང་འཛིང་མྱོང་མཁན་རེད།",
    "ཁོ་ཚོ་ལ་ཁག་ཡོད་མ་རེད།",
    "ང་རང་གིས་རྒྱ་དམག་དང་ཐེངས་༢༣ཙམ་འཛིང་སྐབས་མེ་མདའ་མང་པོ་བརྒྱབ་ཡོད་སྟབས་རང་གིས་བསད་ཡོད་བསམ་ཀྱང་ཤི་རྫུན་བྱེད་པ་དང་གཞན་དང་མཉམ་དུ་བརྒྱབ་པ་སོགས་ཀྱིས་གསལ་པོ་ཤོད་དཀའ་ཡང་ཁྱེད་ཚོས་ག་ཚོད་ཁས་ལེན་བྱེད་དགོས་གསུང་ན་དེ་ཁས་ལེན་གྱི་ཡིན།",
    "དེ་ནས་དྲི་ཞིབ་མཇུག་སྒྲིལ་སོང་།",
    "གམ་བཅར་གྲྭ་ཚང་གི་ཚོགས་གུར་ཁྱུང་འབྲུག་ལྡིང་མཛེས་ཟེར་བའི་འགོ་སྣམ་ཚོས་ཚོགས་ཀྱིས་བརྒྱན་པ་དེ་དུམ་བུ་བྱས་ནས་ཕག་ལྟོ་སོགས་སྐམ་ས་བྱེད་ཀྱི་ཡོད་པ་དེར་གྲོ་ཆུ་སིགས་རྒྱབ་ནས་སྐམ་ས་བྱས།",
    "བྲག་གཡབ་ཁྲག་གི་མིག་ཆུ།",
    "མཐའ་མཚམས་དམག་གི་རྒྱབ་སྐྱོར་མི་སེར་མང་པོ་འགྲོ་དགོས་པ་དེ་ཚོར་སྤྲོད་ཆེད་ང་ཚོ་བཙོན་པ་རྣམས་ལ་ཉིན་མཚན་རེས་སྐོར་གྱིས་ཉིན་བཅུ་ལྷག་ཙམ་རྩམ་པ་འཐགས་དགོས་བྱུང་།",
    "སྐབས་དེར་ངའི་ཨ་མ་ང་རང་དང་ངོ་ཐུག་གི་ཆེད་དུ་ཕ་ཡུལ་ནས་གོམ་པ་སྤོས་ཏེ་ཉིན་ལྔའི་ཐོག་བསླེབས་པ་དང་།",
    "ཁྱེད་རང་གིས་རྣམ་དཀར་གྱི་བྱ་བ་གང་ཐུབ་གྱིས་ཟེར་ནས་ཐོད་པ་གཏུག་བྱུང་བས་ཡིད་ཤིན་ཏུ་སྐྱོ་པོ་བྱུང་།",
    "ང་ཚོས་རང་ཉིད་འགྲོ་ཐུབ་མིན་གྱི་སྐབས་སུ་མི་ཁུར་ཐུབ་ས་མ་རེད་ལབ།",
    "རྒྱ་སྐད་ཀྱི་ཐོག་ནས་ཁྱེད་ཀྱིས་མི་བསད་རྩིས་ཡོད་དམ་སོགས་ལབ་ནས་ཁ་རྩོད་བྱས་སོང་།",
    "ཡང་བྲག་གཡབ་ཚེ་འབུམ་ནས་ཡིན་པའི་བློ་བསྟན་ཟེར་བ་དེ་ལ་བཙོན་པ་དང་འབྲེལ་བ་བྱས་འདུག་ཟེར་ནས་ཕྱིར་ཕུད་དེ་རང་ཁྱིམ་དུ་ལོག་པ་རེད།",
    "ཉིན་རེ་ཟུང་དམག་རྒྱག་མཚམས་རྒྱ་གར་གྱི་མི་མང་པོ་གསོན་བཟུང་བྱས་པ།",
    "དམག་དཔོན་གཅིག་གནམ་གྲུའི་ནང་ཞུགས་ཏེ་བྲོས་རྩིས་བྱེད་སྐབས་གནམ་གྲུ་དང་བཅས་ཚུར་ལེན་པ་རེད།",
    "ཀྲུང་གོའི་མི་དམངས་བཅིངས་འགྲོལ་དམག་གཅིག་ཀྱང་བཟུང་མ་ཐུབ་པ་རེད།",
    "རྒྱ་གར་གྱི་དམག་མི་མང་པོས་མེ་མདའ་བསྐྱུར་ནས་བྲོས་ཕྱིན་པ་རེད།",
    "རྒྱ་གར་གྱི་རྒྱལ་ས་ལྡི་ལིར་ཡང་བཅིངས་འགྲོལ་གཏོང་གི་ཡིན་ན་བདེ་བླག་ངང་གཏོང་ཆོག་ཀྱང་།",
    "ང་ཚོ་ཞི་བདེར་དགའ་མཁན་ཡིན་སྟབས་སྤྱི་ལེ་གསུམ་ལ་ཕྱིར་འཐེན་བྱས་པ་རེད།",
    "དེ་རྗེས་ང་ཚོས་བཟུང་བའི་རྒྱ་གར་གྱི་དམག་མི་དེ་ཚོར་ཕྱིར་གཏོང་དུས་ངུས་ནས་ང་ཚོ་ཕར་མ་གཏོང་རོགས་མ་གཏོགས་ཡང་བསྐྱར་དམག་རྒྱབ་སར་ཚུར་གཏོང་གི་རེད་ཟེར།",
    "ང་ཚོས་ཕར་བཏང་ཆོག་ལབ་ཡོད་པ་རེད།",
    "ཁྱེད་ཚོས་རྒྱ་གར་ལ་རེ་སྟོང་ཡོད་མེད་གྲོས་བསྡུར་བྱེད་དགོས་ཟེར་ཏེ་གྲོས་བསྡུར་བྱེད་བཅུག་སོང་།",
    "ང་ཚོའི་སེམས་ལ་རྒྱ་དཀར་ནག་གཉིས་པོ་རྒྱལ་ཁབ་ཆེན་པོ་འདྲ་འདྲ་ཡིན་པ་ལ་ལས་སླ་པོ་དེ་འདྲ་མི་ཐུབ་བསམ་ནས་ཡིད་ཆེས་རྩ་བ་ནས་མ་བྱུང་།",
    "བུ་ལོན་འཇལ་བྱེད་རྒྱ་གར་གྱི་བུ་མོ་ཚོས་རྣ་རྒྱན་སོགས་སྤྲད་ཀྱང་བུ་ལོན་མ་འཕྲོད་སྟབས།",
    "ཕྱི་ནས་ཨ་མེ་རི་ཀས་བུ་ལོན་ཁྲག་གི་མིག་ཆུ།",
    "དེ་རྗེས་རྒྱ་གར་གྱི་སྲིད་བློན་ཤ་སི་ཐི་རི་པ་ཀི་སི་ཐན་དང་རྒྱ་གར་འདུམ་འགྲིགས་ཀྱི་ཆེད་དུ་ཨུ་རུ་སུའི་ཏ་ཤི་ཀན་ཌི་ནས་ཁ་མཆུ་ཕམ་པའི་སེམས་ཁྲལ་གྱིས་རྐྱེན་བྱས་ཏེ་ཤི་བ་རེད་ཟེར་བ་དང་།",
    "ཨ་མེ་རི་ཀའི་སྲིད་འཛིན་ཁེ་ནི་ཊི་༡༩༦༣པོར་མི་དམངས་ཀྱིས་མགོ་བོར་མེ་མདའ་གཞུས་ཏེ་བསད་པ་རེད་བཅས་བསྒྲགས་སོང་བར་བཙོན་པ་ཚང་མས་སེམས་ཁྲལ་ཆེན་པོ་བྱས་སོང་།",
    "ངའི་བསམ་པར་རྒྱ་གར་གྱིས་རྒྱ་ནག་ལ་ཁ་གཏད་བཅག་རྒྱུ་ཡིན་པ་མངོན་གསལ་རེད།",
    "གཙོ་བོ་རྒྱ་གར་ལ་མཐར་ཐུག་གི་ཞི་བདེ་ཡོང་ཆེད་རེད།",
    "དེར་བརྟེན་རྒྱ་གར་གྱིས་བོད་རང་བཙན་སླར་གསོ་ཡོང་བའི་རྒྱབ་སྐྱོར་གཙང་མ་བྱེད་ཀྱི་རེད་བསམ་བྱུང་།",
    "ང་ཚོའི་ཙུའུ་ཀྲང་ཨ་དོན་ལ་འབོད་སོང་བས།",
    "ཡར་ལངས་པ་དང་གྱོན་ཆས་བཤུས་སོང་།",
    "གྱོན་ཆས་དང་ཉལ་གདན་ཚང་མར་ཞིབ་གཤེར་བྱས་སོང་།",
    "ང་ལ་ཞིབ་གཤེར་ཚར་བ་དང་མར་ཉོལ་ཞིག་ཟེར་ནས་ཕྱིན་སོང་།",
    "དེ་ག་རེ་ཡིན་ན་བསམ་ནས་ཡུད་ཙམ་གཉིད་མ་ཁུག་བཙོན་པ་ཚང་མ་འཇམ་ཐིང་ངེར་བསྡད་སོང་།",
    "སོའི་ནང་ཡར་འཛུལ་ཟེར་བ་ལྟར་ལམ་སེང་ནང་དུ་འཛུལ་བ་དང་སྒོ་བརྒྱབ་སོང་།",
    "ཁང་པ་རེ་རེ་བཞིན་སྒོ་ཕྱེ་བ་དང་རང་གི་ཉལ་ཆས་ཁུར་ཏེ་ཕྱི་ལོགས་སླེབས་པ་དང་གཟུགས་པོ་དང་ཉལ་ཆས་ཚང་མར་ཞིབ་གཤེར་བྱས་སོང་།",
    "སྤྱིར་བཏང་གིས་ཞིབ་གཤེར་དེ་འདྲ་ཟླ་བ་རེའི་ནང་ཐེངས་རེ་ཟུང་བྱེད་པ་དང་ལུས་ལ་གྱོན་པ་དེ་མ་གཏོགས་གཞན་ཉལ་ཆས་སོགས་ས་ཐོག་ཏུ་བཀྲམ་སྟེ་ལས་བྱེད་དང་དམག་མི་དེ་ཚོས་རྐང་པས་བརྫིས་ཏེ་ས་སྐམ་པོ་འགོས་ཀྱི་ཡོད་པ་ཤོད་མི་དགོས་ཀྱང་།",
    "ཆར་པ་དང་ཁ་བ་བབས་དུས་འདམ་བག་འགོས་ཀྱི་ཡོད་པ་ལྟར་དེ་ཉིན་འདམ་བག་རེད་འདུག་པས་ཉལ་ཆས་ཡང་ནས་ཡང་དུ་བརྫིས་སོང་།",
    "དེ་ནས་ཚང་མ་བང་སྒྲིག་ནས་ལས་ཀར་འགྲོ་མཁན་རྣམས་ལས་ཀར་སོང་།",
    "སྟ་རེ།",
    "འོ་ན་དང་པོ་ཚང་མས་སྟ་རེ་བཙལ་ནས་ཁང་པར་གཙང་སྦྲ་གྱིས་ཟེར་བ་དང་།",
    "རྐང་ལྕགས་ལག་ལྕགས་ལ་ཞིབ་བཤེར་བྱེད་སྐབས་སོགས་ཀྱི་བང་སྒྲིག་སྐབས་འཕྲལ་འཕྲལ་རུ་སྒྲིག་འགྲིག་པོ་བྱེད་དགོས་པ་ལས་བཙིར་རེས་དང་འབུད་རེས་མི་ཆོག་༩བཙོན་པ་ཕན་ཚུན་དངོས་པོ་བརྗེ་ཚོང་རྒྱག་པ་དང་རྐུ་འཁྱེར་བྱེད་པ།",
    "༡༤གཟའ་ཉི་མའི་དགོང་མོ་བདུན་ཕྲག་གཅིག་རིང་གི་འཚོ་བའི་སྐྱོན་བརྗོད་བྱེད་དགོས།",
    "ཁྱེད་ཚོ་བོད་མི་རྣམས་ཐག་གཅོད་ཚེ་བཙོན་ཡིན་ཟེར་ན་འཛུམ་ཤིག་ཤིག་འདི་ག་འདྲ་ཡིན་ནམ་ཁྱད་མཚར་པོ་ཞིག་རེད་ཟེར།",
    "ངས་འཛུམ་ཤིག་ཤིག་མ་བྱས་པར་ག་རེ་བྱེད་དགོས་རེད་ལབ་པས།",
    "ཁོས་རྒྱ་མི་ཡིན་ན་ཚེ་བཙོན་ཡིན་ཟེར་ན་ཉིན་ཤས་ངུ་བསྡད་ཀྱི་རེད་ཟེར།",
    "ངས་ངུས་ན་ཕན་ཐོགས་ག་རེ་ཡོད་རེད།",
    "ཐག་གཅོད་ཕབ་ཀྱི་རེད་དམ་ཟེར་བས།",
    "ཁོ་པས་ཐག་གཅོད་ཕབ་ཀྱི་མ་རེད་དེ།",
    "རང་ད་ལྟ་ཚེ་བཙོན་ལ་ཡོང་བ་དེ་སྔོན་བསགས་ལས་ཀྱི་འབྲས་བུ་རེད་བསམ་གྱི་ཡོད་རེད།",
    "དེར་བརྟེན་སེམས་ལ་སྡུག་བསྔལ་ཆེན་པོ་ཡོད་པ་མ་རེད་ལབ་མྱོང་།",
    "བཙོན་པ་ཡོངས་རྫོགས་ཁྲག་གི་མིག་ཆུ།",
    "བཙོན་པ་ཚང་མར་བལྟས་ཏེ་ཁ་ཡིས་གད་མོ་འཛུམ་ཤིག་ཤིག་བྱས།",
    "༧རྒྱལ་བ་བསྟན་འཛིན་རྒྱ་མཚོ་སྐུ་ཚེ་ཁྲི་ཕྲག་བརྟན་པར་ཤོག་རྒྱ་གུང་ཁྲན་ཏང་རྩ་མེད་འགྲོ་དགོས་ཞེས་སྐད་གསང་མཐོན་པོ་ཐེངས་གསུམ་འབོད་སོང་བ་དང་རྒྱ་དམག་དེ་ཚོས་ལམ་སེང་སྐེ་བསྡམས་སོང་ཀྱང་ཕར་འཐེན་ཚུར་འཐེན་བྱས་ཏེ་ཀི་ཀི་ཀི་སོགས་མང་པོ་བརྗོད་སོང་།",
    "དེ་ནས་ཕར་ཙམ་ཁྲིད་དེ་མེ་མདའ་རྒྱབ་སྟེ་བསད་པ་རེད།",
    "ལྷག་པར་དུ་མདུན་དུ་ཡོད་པའི་ཕ་བཀྲ་རྣམ་ལ་ཡང་ཡང་བལྟས་ནས་འཛུམ་མདངས་བསྟན་སོང་།",
    "དེ་ཡང་ཚང་མས་མཐོང་ས་དེར་མེ་མདའ་བརྒྱབ་ནས་བསད་སོང་།",
    "ཁྱེད་ཚོས་བསམ་བློ་སྤྱོད་ལམ་གཉིས་ཀའི་བསྒྱུར་བཀོད་ཡག་པོ་མ་བྱས་ན་སྤྱང་ཀིས་ལུག་ལྤགས་གྱོན་པ་དང་འདྲ་ཞིང་མི་དམངས་ནང་འདྲེས་ཀྱི་མ་རེད་ལ།",
    "མི་དམངས་ཀྱིས་ཡན་པོར་བཏང་གི་མ་རེད།",
    "ཟ་གྱོན་ནི་ཧ་ཅང་སྡུག་པོ་རེད།",
    "ཉིན་མོར་ང་རང་དང་བུ་གཉིས་ཀྱི་མདུན་དུ་ལོག་གཡེམ་བྱས་སོང་།",
    "ང་ལ་རེ་བ་མ་རྒྱག་ལབ་པ་དང་ཕྲུ་གུ་རྒྱུགས་ཡོང་ནས་ངའི་ཕ་ལ་ཐོད་པ་ཞིག་གཏུག་བཅུག་རོགས་ལབ་སོང་ཡང་།",
    "ངའི་འཁྲིས་ལ་བཅར་བཅུག་མ་སོང་།",
    "སྐབས་དེར་ང་ཚོ་བརྒྱ་ཤོག་དང་པོའི་བཙོན་པ་རྣམས་ལ་འཚོ་བའི་དཀའ་ངལ་ཆེན་པོ་མ་བྱུང་།",
    "ཉིན་རེ་སྔོ་ཚལ་དུས་གཉིས་རེ་དང་བདུན་ཕྲག་རེའི་ནང་ཤ་ཡོད་པའི་ཚལ་རེ་རེ།",
    "བདུན་ཕྲག་རེར་ཇ་སྲུབས་མ་ཐེངས་གསུམ་རེ་གཏོང་གི་འདུག་བཙོན་དཔོན་ལུག་ག་སོ་ཀྲང་ཟེར་བ་དེས།",
    "ད་ལྟ་རྒྱལ་ཁབ་ཀྱིས་ཁྱེད་ཚོར་འཚོ་བ་ཡག་པོ་སྤྲོད་ཀྱི་ཡོད་པ་རེད།",
    "རྒྱ་གར་མི་སེར་དཀྱུས་མའི་འཚོ་བ་ཡང་འདི་ཙམ་ཡོད་མ་རེད།",
    "ཁོང་གི་བུ་མཁས་གྲུབ་དང་།",
    "མི་རེ་རེ་བཞིན་ནང་ལ་ཁྲིད།",
    "ངའི་དཔུང་པ་གཡོན་མའི་རྩ་ལམ་ནས་ཟུངས་ཁྲག་འཐེན་སོང་།",
    "ཟུངས་ཁྲག་གཏར་བའི་དུས་ཚོད་ནི་རྒྱུན་རིང་འགོར་སོང་།",
    "བུད་མེད་གཅིག་གིས་མར་རྒྱུན་ནས་མེད་པ་ལ་སང་ཉིན་ལོ་གསར་ག་འདྲ་གཏོང་དགོས་རེད་ཟེར།",
    "ཁྲག་དེ་རྒྱ་མིའི་ལས་བྱེད་དུམ་དམག་མི་ལ་དགོས་ཀྱི་ཡོད་དམ་ཡང་ན་བཙོང་གི་ཡོད་ཧ་གོ་མ་སོང་།",
    "༡༩༦༥ ལོའི་དབྱར་ཁ་ཙམ་ལ་ཉིན་ཞིག་ང་རང་ཐེ་བའི་བཙོན་པ་༧༥ ཡི་མིང་ཐོ་ཀློག་སྟེ་སང་ཉིན་འགྲོ་དགོས་རེད།",
    "མི་གཉིས་རེ་ལྕགས་ཐག་གིས་སྦྲེལ་བ་སྟེ་མི་གཅིག་གི་རྐང་པ་གཡོན་མ་དང་གཞན་ཞིག་གི་རྐང་པ་གཡས་པ་གཉིས་རྐང་ལྕགས་གཅིག་གི་སྣེ་གཉིས་སྦྲེལ་ནས་སྔོན་རྗེས་གཉིས་ལ་རླངས་འཁོར་ནང་དམག་མི་དང་།",
    "བཙོན་པ་༡༦ ནས་༢ ཙམ་བར་རླངས་འཁོར་ནང་བླུག་ཅིང་དེ་དང་མཉམ་དུ་དམག་མི་ཁ་ཤས་རེ་བཅས་ཕྱི་དྲོ་སྤོ་མདའ་གྲོང་དུ་འབྱོར།",
    "མི་ཁྲག་གི་མིག་ཆུ།",
    "གཅིག་གཅིན་པ་ཤོར་ན་གཉིས་ཀ་འགྲོ་དགོས་པ་སོགས་དཀའ་ངལ་ཡོད་པའི་རྐྱེན་གྱིས་རེད།",
    "མཚན་མོ་ཆུ་ཚོད་༡ པ་ཙམ་ནས་སྐམ་གློག་གཏོང་མཚམས་བཞག་པ་དང་གཞུ་མར་མང་པོ་སྤར་ཞིང་།",
    "ལྡིང་ཆའི་ཐོག་དམག་མི་ཚོས་རེས་མོས་བྱས་ནས་སྲུང་སོང་།",
    "ཨར་འདམ་གྱིས་བཟོས་པའི་ལྟ་སྲུང་ཁང་གྲུ་བཞི་རེ་དང་།",
    "བཟོ་གྲྭའི་ཁང་པ་སྟར་པ་གཅིག་ཡོད་པ་དང་ལྕགས་རིའི་ཕྱི་ལ་དམག་སྒར་དང་ལས་བྱེད་ཀྱི་ཁང་པ་སོགས་འདུག་ང་ཚོ་རུ་ཁག་༡༡ པའི་ཁང་པའི་ནང་བཞགཕྱི་ཉིན་རྒྱ་དཔོན་ཁ་ཤས་ཡོང་སྟེ་མི་རེ་རེ་བཞིན་མིང་ཐོ་ཀློག་ནས་རྩིས་གཤེར་བྱས།",
    "མི་གཉིས་རེ་ལྕགས་ཐག་གིས་སྦྲེལ་བ་དེ་བླངས་སོང་།",
    "ཉིན་བདུན་རེའི་རྩམ་པ་དུས་གཅིག་ལ་སྤྲད།",
    "ཉིན་རེར་ཆུ་ཁོལ་ཚ་མེད་ཐེངས་གསུམ་རེ།",
    "གལ་སྲིད་སྐྱག་པ་གཏོང་དགོས་བྱུང་ན་གཏོང་རྐྱང་བྱེད་རྒྱུ་རེད།",
    "མའོ་རྩེ་ཏུང་གི་རྩོམ་བཏུས་ལ་སློབ་སྦྱོང་དང་བློ་འཛིན་དགོས་པ་དང་།",
    "རྩོམ་བཏུས་རེ་མི་རེ་ལ་སྤྲད་ནས་ཤུབ་དམར་པོ་རེ་བཟོས་ནས་ཞོགས་པ་ཡར་ལངས་པ་ནས་དགོང་མོ་མ་ཉལ་བར་ཁྲག་གི་མིག་ཆུ།",
    "དེ་ནས་བཙོན་སྒོ་རྣམས་ཕྱེ་བའི་སྐབས་ཁང་མིག་རེ་རེའི་ནང་གཅིན་ཟོམ་གཤོ་མཁན་མི་གཉིས་ཕུད་དེ་མིན་ཚང་མ་བང་སྒྲིག་སྟེ་རང་གི་སྐེ་ལ་གྱོན་ཡོད་པའི་རྩོམ་བཏུས་དེ་མགོ་ལས་མཐོ་བ་བསྒྲེངས་ཏེ་མའོ་ཀྲུའུ་ཞི་ཁྲི་ལོར་བརྟན་པར་ཤོག་ཅེས་ལན་གསུམ་བརྗོད།",
    "བཙོན་པའི་ཙུའུ་ཀྲང་གིས་མའོ་ཡིས་རྩོམ་བཏུས་ཁ་ཕྱེས་ཏེ་རླབས་ཆེན་གཙོ་འཛིན་མའོ་ཀྲུའུ་ཞིའི་ཆེས་མཐོའི་བཀའ་སློབ་ཟེར་ཞིང་ཚིག་དུམ་གཅིག་ཀློག་པར་མང་མས་རྗེས་ཟློས་བྱེད་ནས་གྲོལ།",
    "གཟའ་ཉི་མའི་དགོང་མོར་བདུན་ཕྲག་གཅིག་གི་འཚོ་བའི་སྐྱོན་བརྗོད་ཅེས་རང་སྐྱོན་ངོས་ལེན་དང་།",
    "གྲོ་མོ་ནས་ཡིན་པའི་ཕུར་བུ་ཚེ་རིང་ཞེས་པའི་ལས་བྱེད་དེ་བཙོན་པར་སྡང་བས།",
    "ཁོ་པའི་ཡིད་ལ་མ་འཐད་པ་ཕྲན་བུ་བྱུང་ཚེ་འཐབ་འཛིང་བཏང་བ་སོགས་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "སྐབས་དེར་བཙོན་པ་རེར་ཟླ་རེར་མར་རྒྱ་མ་ཕྱེད་ཀ་རེ་ཡོད་རེད།",
    "ང་ཚོས་གོང་རིམ་ལས་བྱེད་ལ་ཞུ་བ་ཕུལ་ཏེ་ཟླ་རེའི་མར་རྒྱ་མ་ཕྱེད་ཀ་དེ་མི་སོ་སོའི་ལག་པའི་ནང་གནང་རོགས།",
    "རྒྱལ་གཅེས་ལྷག་བསམ་ཅན་གྱི་དཔའ་བོ་ཨ་ཕོ་དགའ་དགའ་ནི་ཚེ་བཙོན་ནས་གློད་རྗེས་བེ་རི་དུད་ཚང་༥ ལྷག་ཙམ་གྱིས་ཕ་ཡུལ་དུ་བཞུགས་རོགས་ཞེས་རེ་བ་ནན་ཆེར་བྱས་ཀྱང་།",
    "༡༩༨༢ ལོ་རྒྱ་གར་དུ་བཙན་བྱོལ་ལ་འབྱོར་ཏེ་ད་ལྟ་བོད་གཞུང་བདེ་སྲུང་གི་ཟུང་འབྲེལ་དྲུང་ཆེ་གནང་བཞིན་འདུག་ཡང་ཐེངས་ཤིག་ཕ་ཡུལ་ཚ་བ་རོང་པ་ནས་ཡིན་པ་ཡེ་ཤེས་ཉི་མ་ཟེར་བ་དེས་ཕོར་པའི་ནང་ཇ་ཞིག་ཁྱེར་ནས་ཐབ་ཚང་ནས་ཕྱིར་དོན་པ་དང་ལས་བྱེད་ཕུར་བུ་ཚེ་རིང་དང་གདོང་ཐུག་བརྒྱབ།",
    "མའོ་ཀྲུའུ་ཞིས་ལོག་སྤྱོད་པར་གང་བྱུང་གི་གཏམ་བརྗོད་དང་།",
    "སྐྱོད་རྩ་བ་ནས་མི་བརྒྱབ་པ་ཡོང་སྲིད་ཀྱི་མ་རེད།",
    "ཁོ་པས་ཁྱོད་ཁ་བདེ་པོ་ཡོང་།",
    "ལྟད་མོ་ལྟོས་ཤིག་ཟེར་ནས་ཕྱིན་སོང་།",
    "ཐེངས་ཤིག་རྒྱ་བཙོན་ཞིག་དང་ཁ་རྩོད་བྱས་སོང་།",
    "ངོ་གདོང་དམར་པོ་དེ་སྐྱ་སེང་ངེ་ལ་གྱུར་ནས་ཁོང་ཁྲོ་ཞི་འཇམ་དུ་སོང་།",
    "ཡེ་ཤེས་ཉི་མ་ད་ལྟ་བོད་ནང་ཡོད་པ་རེད།",
    "བཙོན་པ་རེ་ཟུང་གིས་སྐྱོན་བརྗོད་བསམ་འཆར་བཏོན་པའི་རྐྱེན་གྱིས།",
    "ཀླད་རྙིང་མཁྲེགས་བཟུང་བྱེད་མཁན་རེད་ཅེས་ཉེས་མིང་ཐོག་ནས་འཐབ་འཛིང་དང་ཉེས་བརྡུང་ཕོག་པའི་ཉེན་ཁ་ཆེན་པོ་ཐེངས་གསུམ་འཕྲད་ཀྱང་།",
    "ཁྲག་གི་མིག་ཆུ།",
    "བསྒྲགས་ཡིག་སོགས་ཚང་མའི་ཐོག་རྒྱ་ཁྱབ་ཏུ་སྤེལ་བཞིན་ཡོད་པ་རེད།",
    "དཔེར་ན་མི་ཞིག་གིས་ཉིན་གཅིག་ལྟོ་མ་ཟས་ན་འགྲིག་ཀྱང་།",
    "ང་ཚོའི་ཚོགས་ཆུང་གི་ཁང་པའི་ནང་ཙི་ཙིས་རྟག་པར་རྩམ་ཁུག་རྣམས་ཨི་ཁུང་ཕུག་གི་ཡོད་པ་རེད།",
    "ཉིན་ཞིག་ཞོགས་ཇ་འཐུང་གྲབས་ཡོད་པའི་སྐབས་དེར་ཁོང་ཚོས་ཙི་ཙི་ཕྱིར་བཏོན་མ་ཐུབ་ན་ཡག་པོ་བྱེད་ཀྱི་མི་འདུག་ལབ་སོང་བས།",
    "ཙི་ཙི་ཕྱིར་འབུད་རྒྱུ་དང་།",
    "ཡང་ན་འབུད་མ་དགོས་པར་རྩམ་ཁུག་སོགས་ལ་མི་གནོད་པའི་ཐབས་ཤེས་བྱེད་དགོས་ཀྱི་རེད་ཅེས་ཁ་ནས་ཤོར།",
    "ཁང་པའི་ནང་ཙི་ཙི་འཛུལ་བ་དེ་གསོད་དགོས་རེད་ཟེར་སྐབས།",
    "འབེབས་བྱེད་པའི་ལོག་སྤྱོད་ཀྱི་སྐད་ཆ་ཉེན་ཚབས་ཆེན་པོ་རེད།",
    "མཁྲེགས་བཟུང་བྱས་ན་དྲག་གནོན་གྱི་སྲིད་བྱུས་ཡོད་པ་དེ་ག་དུས་ཡིན་ནའང་འགྱུར་བ་མེད་ཅེས་བསྒྲགས་སོང་།",
