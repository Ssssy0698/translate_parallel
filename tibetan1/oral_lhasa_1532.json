    "ལྷ་སྲིན་འཚམས་ཀྱིས་རྫིའུ་གར་སྤར་ཡིན།",
    "ཡོད་པར་ལྟ་འམ་མེད་པར་ལྟ།",
    "སྣང་བའི་ཆ་ནས་ཡོད་པར་ལྟ།",
    "སྟོང་པའི་ཆ་ནས་མེད་པར་ལྟ།",
    "བསང་ཁྲུས་བྱས་ལ་ད་བཟོད་བཏབས།",
    "སོ་བྲག་ལྷ་ས་དར་བ་དེ།",
    "གཤིན་རྗེའི་ལམ་དུ་བྱས་པ་ཡིན།",
    "ཐམས་ཅད་དེ་ལྟར་ཤེས་པར་གྱིས།",
    "ཤིང་དྲང་པོར་སྐྱེར་པ་སྟ་ཡུ་བྱས།",
    "ལྕགས་དྲང་པོར་སྐྱེས་པ་སེག་གདར་བྱས།",
    "ལྷ་ཡི་བྱ་ཐན་དང་ལྷ་སྡོང་འོང་དོག་ཡོད།",
    "འོང་ཀྱང་ལྷ་སར་བྱུང་ནས།",
    "ལན་དུ་ཕུང་པར་བྱ་རལ་དང་།",
    "སྔོན་ཤིང་གཉན་ལ་ཐུབ་ཆོད་བྱས་པས་ཕུང་།",
    "སྤྲེལ་ཤིང་ཐོག་མ་ལོང་གླང་བཞུགས་ཤོར།",
    "སྔོན་མི་རོ་ར་རོ་བྱས་པས་ཕུང་།",
    "ཤིང་ཧྲིལ་བུ་སྐྱེས་པ་ཤིང་ཤག་ཡིན།",
    "ཀྱམ་དཀར་གཙང་ཆབ་བབས་པའི་ཆུ།",
    "ཉིན་གཅིག་ཆར་པ་འཕེལ་པར་བཟང་།",
    "དཀར་པོ་ལྷ་སར་དགོས།",
    "སྲིན་གྱིས་སྲོག་ཕུལ་འཁོར་དུ་བྱས།",
    "སྐུ་ལྷ་སྤྲ་ཕུད་དང་གནམ་ཐེལ་དཀར་པོ་དུམ།",
    "མི་མགར་བ་དང་གཡགས་དང་གོ་མཚོན་ཀྱིས་བསྐྲུན་བྱས།",
    "ལྷག་པར་སྟག་ཡོས་ལོ་པར་ངན།",
    "ལྷག་པར་རྟ་སྦྲུལ་ལོ་པའི་སྲིད་བགབ་འཆད།",
    "ལྷག་པར་གཤེད་བཞི་ལོ་པར་ངན།",
    "ལྷག་པར་བྱ་སྤྲེལ་ལོ་པར་ངན།",
    "ལྷག་པར་བྱི་ཕག་ལོ་པར་ངན།",
    "ལོ་བཅུ་གཉིས་ཀྱིས་འཐེན་ཐག་དེ་ཡི་འགྲེས་སུ་ཤེས་པར་བྱ།",
    "དགྲ་ཕྱ་ལས་དཔའ་རྡོར་གནང་གསུམ་སྤྱད།",
    "སངས་ཀྱིས་ཕ་ནི་སྤྱོད་པར་ཡིན།",
    "ན་བཞུགས་སངས་ནས་སོས་པ་ཡིན།",
    "དམེ་ཁྲམ་ཞོར་ཀྱིས་བྱས་པའི་མདུར་རྒྱུགས་ཡིན།",
    "སྲིའུ་ཀིག་ཐར་བྱས་ཛ་ཤི།",
    "སྨྲ་ལགས་ཆད་པའི་ཕལ་ངོ་ཡོད།",
    "མི་སྟོགས་ལགས་ན་ཡོད་པ་གཅིག་ཡོད།",
    "གཡག་ཕུ་བོ་གཉིས་ཀྱི་དཔྲལ་ཐུན་བྱས།",
    "རྫུན་ལས་སྟོང་ཞོག་བྱས་པ་ཡོད།",
    "སྨྲ་ལགས་ཆད་པའི་ཕམ་ངོ་ཡིན།",
    "ཆང་བབས་རྟག་པར་ངན་ན་ཡུལ་འཆོར།",
    "བ་ཁོག་རྟག་པར་ངན་ནས་སྐྱེ་འཕེལ་ཆུང་།",
    "ཕྱི་སར་སྤྱོད་པར་བབས་ནས།",
