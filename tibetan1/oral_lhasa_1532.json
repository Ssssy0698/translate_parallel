    "གླང་གཞིམཉན་དུ་ཡོད་པ་ན་བཞུགས་ཏེ།",
    "བསླབ་པའི་གཞིརྣམས་ལ་གནས་པར་བྱསནས།",
    "ཡང་དག་པར་འཛིན་དུ་འཇུག།",
    "ཡང་དག་པར་དགའ་བར་མཛད་ནས་གདན་ལས་བཞེངས་ཏེ་གཤེགསསོ།",
    "དེས་རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་མངོན་སུམ་དུ་བྱས་ཏེ།",
    "དགྲ་བཅོམ་པ་ཉིད་མངོན་སུམ་ངུ་བྱས་སོ།",
    "དེ་དགྲ་བཅོམ་པར་གྱུར་ནས་བསམས་པ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲསབུ་མངོན་སུམ་ཏུ་བྱས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱང་འདིས་མཉེས་པར་བྱས།",
    "འཇིག་རྟེན་མཁྱེན་པ།",
    "ཡ་༨དག་པར་གཟེང་བསྟོད།",
    "དེ་ནས་ཁྱེའུ་དེ་འཇིགས་ཤིང་སྐྲག་པར་གྱུརཞས།",
    "མདུན་ལོགས་སུ་བཞེས་སོ།",
    "བཞིན་བཟངས་ཁྱེད་གཉིས་སྔོན་གྱི་ཉེས་པར་སྤྱོད་པའི་ལས་ཀྱིས།",
    "རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་ཐམསཅད་འོད་ཆེན་པོས་སྣང་བར་བྱསནས།",
    "དེ་ནས་དགེ་སློང་རྣམས་ཀྱིས་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་ཐམསཅ་ད་སྣང་བ་ཆེན་པོས་ཁྱབ་པར་གྱུར་པ་མཐོང་ནས།",
    "བཅོམ་ལྡན་འདས་ཅི་ལགས།"
  ]
}