    "མཛུབ་གང་ཙམ་པར་མདུད་བྱུང་ཡིན།",
    "སྲིད་པ་ཐམས་ཅད་མཁྱེན་པ་འཕྲུལ་གྱི་རྒྱལ།",
    "ཏིང་འཛིན་སྒོམ་ཞིང་ལྷ་སྔགས་བསྒྲུབ་པ།",
    "ཡེ་མཁྱེན་འཕྲུལ་རྒྱལ་གཤེགས་སུ་གསོལ།",
    "ལྷ་གཞི་དཀར་པོའི་གོང་འདིར་བཞུགས།",
    "དེ་དུས་རྣམ་མཁྱེན་རྒྱལ་བ་གཤེན་རབ་ཀྱི།",
    "ཁྱེད་ལ་འབུལ་ལོ་བསྟོད་པར་བགྱི།",
    "དུས་གསུམ་ས་ལེར་མཁྱེན་པ་ཁྱེད་རྣམས་ཀྱིས།",
    "བདེན་པར་སྟོན།",
    "འོད་ཀྱི་ཕུང་པོ་ཡེ་ཤེས་ལྔའི་འོད་ཟེར་གྱིས་སྟོང་གསུམ་གསལ་བའི་སྒྲོན་མེ་གྱུར་པར་བསམ།",
    "བསྭོ་ཨཱ་ཁ་ཡེ་དུང་ཤག་ཨ་པར་གོང་ཀོ་ལེ་ཤག།",
    "དེ་ལྟར་གཙང་མ་སྲིད་པའི་ལྷ་གསས་གཅིག་བསྒྲུབས་ནས་གྲུབ་ན།",
    "དང་པོ་ལུག་ཕྱིང་དཀར་པོ་གཙང་མའི་སྟེང་དེར།",
    "ལྷ་ས་དང་པོ།",
    "བཞི་པ་ལྷ་བྱང་གོང་འོག་བར་གསུམ་གྱི་དཔྱད་སུམ་ཅུ་སོ་གསུམ་ཁྱད་པར་དུ་བསྟན་པ།",
    "རིགས་བཞི་ལྷ་སྲུང་ཕོ་རྒྱུད་ས།",
    "ལྷ་ས་འབྲིང་པོའི་བདག་པོ་ནི།",
    "ཁྲོ་ཆུ་དམུ་ལུགས་མཁར་ལ་བཞུགས།",
    "ལྷ་ས་ཐ་མའི་བདག་པོ་ནི།",
    "འཛང་པ་འཕྲུལ་གྱི་མཁར་ན་བཞུགས།",
    "འཇའ་ཚོན་སྣ་ལྔའི་གུར་ན་བཞུགས།",
    "ཚ་ཞང་ཤག་པོ་གཉེན་གྱི་ས།",
    "ལྷ་ས་དང་པོ་འདིར་གཅིག་བབ་ན།",
    "ལྷ་བསང་བྱས་ནས་གསས་མཁར་བརྩེགས།",
    "ལྷ་ས་འབྲིང་པོ་འདིར་གཅིག་བབ་ན།",
    "ལྷ་ས་ཆུང་བ་འདིར་གཅིག་བབ་ན།",
    "ལྷ་ས་དང་ཕོ་ས་ཆུང་བའི་དཔྱད་རྫོགས་སོ།",
    "ཁྱི་ར་ཕག་གསུམ་ཐོད་པར།",
    "མཁས་པ་ཤག་ཐེབ།",
