    "ཉིན་པར་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་ནི་ཉི་མ་ནུབ་སྟེ་དམར་ཐག་ཆད་ན་ལྷག་མར་འགྱུར་རོ།",
    "སྐྲོད་པ་ཡང་ཡང་བསོད་པ་གནས་འདུག་པ་མ་ཕྱུང་བ་ཉུང་བ་རས་ཆེན་དུ་ཆུད་པ་མ་གཏོགས་སོ།",
    "ཁྱིམ་པ་དང་ལྷན་ཅིག་དབེན་པ་ན་འདུག་པའོ།",
    "མུར་འདུག་མས་ཀྱང་ངོ།",
    "གྲོང་བར་དུ་མ་བསྒོ་བར་འདུག་ན་ཡང་ངོ།",
    "དགེ་སློང་མ་སྔ་ན་གྲོང་བར་ན་ཟན་སློང་ཞིང་འདུག་པ་ལ་ཕྱིས་འོངས་པས་གུད་དུ་སློངས་ཤིག་ཅེས་བསྒོ་ནའང་ལྟུང་།",
    "འདུག་ནས་འགྲེང་བ་འདི་ལ་འདུག་ཅེས་བསྒོ།",
    "དགེ་སློང་ལ་འདུག་ལ་དགེ་སློང་མ་འགྲེང་ཞིང་འཁོད་པ་ལ་འདུག་ཤིག་ཅེས་མ་སྨྲས་ན་དགེ་སློང་ཕ་ཉེས་བྱས།",
    "མ་བྱས་ན་གསོལ་ཏེ་འདུག་པར་བྱ།",
    "དགེ་སློང་ཕས་དགེ་སློང་མ་ལ་འདུག་མི་ཟེར་ན་འདུག་ན་ཉེས་སམ་མ་ཉེས་ཞེས་ཞུས་ལ་འཁོད་དོ།",
    "བྱིས་པ་དང་རྒན་པོ་དང་མངལ་ན་འདུག་པ་དང་གཞོན་ནུ་དང་འདི་རྣམས་ལས་གང་བསད་ཀྱང་ཕམ་པར་འགྱུར་རོ།",
    "གསེར་ཕྱེའམ་པ་ནེའམ་དོང་ཙེའམ་འགྲོན་བུའམ་ནས་འབྲས་ལ་སོགས་པ་ཕུང་པོར་འདུག་པ་ལ་སྔ་ཕྱིར་ཚག་བུར་བླངས་ཤིང་རྐུ་ན་ཅི་ཙམ་ཐོབ་ཀྱང་རུང་ཕུང་པོ་མ་ཟད་ཀྱི་བར་དུ་རིན་ཐང་མ་ཚང་ན་ཕམ་པར་མི་འགྱུར་རོ།",
    "སྨྱེན་ཚིག་དང་ཀུན་སྤྱོད་དང་ག་ག་ཚིལ་ལ་སོགས་པ་དང་གོས་དང་ཟས་སློང་བ་ལ་སོགས་པ་རྣམས་ནི་སྨྱོས་ཤིང་རང་བཞིན་སྟོང་པ་ལས་བྱས་པ་ནི་ཉེས་པ་འབྲི་བར་འགྱུར་རོ།",
    "འདུག་པའི་ཕྱིར་སའི་སྟེགས་བུ་ཡང་ངོ།",
    "བསམ་གཏན་དུ་འདུག་པའི་འོག་ཏུ་སའི་སྟེགས་བུ་བྱས་ཀྱང་ཉེས་མེད།",
    "ནམ་མཁའ་ལ་མི་འདུག།",
    "དད་པ་ལེན་པའི་ཚེ་གཅིག་ནམ་མཁའ་ལ་མི་འདུག་པ་ལའང་བྱ།",
    "དད་པ་བླངས་ནས་ནམ་མཁའ་ལ་མི་འདུག་པ་ལའང་བྱ།",
    "ཚོལ་བ་དང་དགྲ་དང་མཐོན་པོར་འདུག་སྟེ་ཕྱོགས་སུ་ལྟ་བ་ནི་དེའོ།",
    "ཚོར་བ་སོ་སོར་བྱ་སྟེ་ཐམས་ཅད་དུ་འདུག་གོ།",
    "ཕྱོགས་མཐོན་པོར་འདུག་ལ་ཕྱོགས་བཞིར་བལྟ།",
    "དགེ་སློང་བཞིར་མ་ཚང་སྟེ་གསུམ་མན་ཆད་ཅིག་འདུག་ནའང་གཅིག་ལ་གཅིག་ཉེས་པ་ཅི་ཡོད་པ་བརྟགས་ཏེ་དཔང་བཙུགས་ཏེ་གཞག་གོ།",
    "འབའ་ཞིག་ན་འདུག་སྟེའོ།",
    "དགེ་སློང་མང་དུ་མེད་དེ་གཉིས་སུ་འདུག་ན་ཉེ་བར་ཙོག་ཙོག་པོར་ཕས་འདག་ཚུས་འདུག་སྟེ་གཅིག་ལ་གཅིག་བརྟག་གོ།",
    "ཡང་དག་པར་བྱས་པ་དེར་འདུག་པར་འདོད་ནའོ།",
    "མུར་འདུག་བར་དུ་གཅོད་ན་ཆད་པས་རབ་ཏུ་བཅད་དེ་ཁྲོས་པ་དང་འཁྲུགས་པས་ནི་མི་བསྟན།",
    "དགེ་སློང་ཀུན་མུར་འདུག་ཏུ་ཞུགས་པ་དང་།",
    "ཤིང་གཅིག་འདུག་པའི་མཚམས་ཀྱིས་དུ་མ་བཞིའི་མཚམས་སོ།",
    "སྒྱུ་མར་སྤྲུལ་ཅིང་འདུག་པ་ལྟ་བུ་ལ་མཚན་མར་མི་གཟུགས།",
    "གྲལ་ཐོག་མ་པས་ཁ་དོན་ཀློག་མི་ནུས་ན་དེའི་འོག་ནས་འདུག་པ་ལ་མེ་ཏོག་བྱིན་ཏེ་བྱེད་དུ་གཞུག་གོ།",
    "དེས་ཀྱང་མ་ནུས་ན་གཉིས་ཀྱི་འོག་ནས་དགེ་སློང་སུ་འདུག་པ་ལ་མེ་ཏོག་བྱིན་ཏེ་ཀློག་ཏུ་གཞུག་གོ།",
    "མི་འདུག་པར་འགྲོགས་ཏེ་དོང་བ་ན་ཡང་བྱ།",
    "ཐ་མར་ས་དང་ཟུང་ང་བླངས་ཏེ་མདུན་དུ་འདུག་ལ།",
    "དགུན་ནི་དྲོ་བ་འདིར་འདུག་གོ།",
    "ཞག་ལྔ་ཞིག་འདིར་འདུག་ཞག་དྲུག་ཅིག་འདིར་འདུག་གོ་ཞེས་ཟེར་ཞིང་གནས་གཅིག་ཏུ་མ་བཅད་པར་མནོད་པར་མི་བྱའོ།",
    "འདུག་པའི་ཁྲི་ཆེན་པོ་རྒྱབ་རྟེན་ཅན་དང་ཁྲི་ཆུང་ངུ་ཡང་བགོའོ།",
    "བྱིས་པའི་སྐྲ་རལ་བུར་འདུག་འདུག་པ་ལས་འདྲེག་པའི་ཚེ་བཀྲ་ཤིས་ཀྱི་ཕྱིར་འབོད་པ་དང་།",
    "མུར་འདུག་ཏུ་ལྟ་བ་དབྱེ་བའི་ཕྱིར་དང་།",
    "གྱི་ན་མི་སྨྲ་བར་འདུག་པར་བསམས་པ་ནི་ཉེས་བྱས་སོ།",
    "ཟས་དང་ཁང་བུ་ལ་སོགས་པ་ཅི་འདོད་པ་ངེད་ལ་ནོས་ལ་ཅི་དགོས་པ་ལ་སོགས་པ་ལོང་ལ་འདུག་ཤིག་ཅེས་བསྒོ།",
    "འདོམ་གང་ཙམ་དུ་འདུག་ལ་དགུས་ཏེ་བཟོད་པ་བགྱིར་ཅི་གནང་ཞེས་གསོལ་ལོ།",
    "རས་སང་སེང་དུ་འདུག་ཅིང་ཐགས་བཟང་ངན་དུ་འདུག་པ་དང་།",
    "དགེ་སློང་སོ་སོའི་མདུན་དུ་འདུག་སྟེ་གདིང་ངོ་ཞེས་བྱའོ།",
    "དེ་བས་ན་དད་པ་མ་བྱིན་པ་ཉལ་ལམ་བསམ་གཏན་དུ་ཞུགས་ཤིང་འདུག་ན་གདིང་བའམ་དབྱུང་བ་མི་སྐྱེ་སྟེ་བརྙན་ཚུན་ཆད་དུའོ།",
    "ཉེས་མེད་པ་ནི་བཏིང་བ་དྲུབས་ནས་སྦྱར་མ་མེད་པར་གྲོང་དུ་འཇུག་པ་ལ་སོགས་ཏེ་མངོན་སུམ་དུ་འདུག་པས་ཡང་ངོ།",
    "གཙུག་ལག་ཁང་གཅིག་ན་དགེ་སློང་གཅིག་པུ་འདུག་པ་ལས་ཡོན་བདག་དད་པས་ཡོན་མང་ཞིག་ཕུལ་ན་དགེ་སློང་གཅིག་པུ་དེས་ཁྱེར་ཡང་ཉེས་མེད།",
    "མཚམས་ཀྱི་བར་ན་འདུག་པ་ལུས་ལ་ཆགས་པའམ་གཞན་ཡང་ཇི་སྙེད་དུ་ཆུད་པ་དེ་གཏོགས་སོ།",
    "དགེ་སློང་ཤི་བའི་ནོར་ཁྱིམ་པ་ལ་གཏམས་ཤིང་འདུག་པ་ལས་དགེ་སློང་ཕོངས་པས་བླངས་ཏེ་བྱིན་ན་ནི་ཉེས་མེད་དོ།",
    "དགེ་སློང་གུད་དུ་འགྲོ་ན་བདག་འདུག་འདུག་པའི་གནས་ཕྱག་དར་དང་ཆག་ཆག་ལ་སོགས་པ་བྱས་ཏེ་འགྲོ།",
    "འགྲེངས་ཏེ་འདུག་པ་ནི་ཀུན་གྱིས་མཐོང་ཞིང་གསལ་བའི་ཕྱོགས་སུ་སྒྲ་བསྐྱུངས་ལ་མཛེས་ཤིང་ཚུལ་བསྡམས་ཏེ་གཏོགས་འདོད་དང་ཤེས་འདོད་མི་བྱ་བར་འདུག་གོ།",
    "མུར་འདུག་ངོ་ཤེས་ཤིང་གཡོ་མི་བྱེད་པ་ཞིག་འོངས་ནའང་ངལ་སོར་གཞུག།",
    "དེ་སྐད་མི་ཟེར་བར་ནང་དུ་འགྲོ་ཞིང་སྟན་ལ་འདུག་པར་མི་བྱ།",
    "སྟོད་ཏྲ་བྱ་བ་ནི་དགའ་བར་བྱ་བའི་ཕྱིར་ཀུན་གྱིས་མཐོང་བར་ས་མཐོན་པོར་འདུག་སྟེ་བྱའོ།",
    "དེ་ལྟ་བུའི་རྐྱེན་མེད་ན་མ་བཅད་པར་གྲོང་དང་ཁྱིམ་དུ་འཇུག་པ་དང་འདུག་པ་མ་ཡིན།",
    "ཡོད་ན་འདུག་པར་མ་ཡིན།",
    "ཡུལ་གཞན་དུ་འདུག་པ་ལ་བརྟགས་ན་མི་འཇིག།",
    "དེའི་ཕྱིར་བསྙུང་བུ་དང་གླ་རྒྱུན་བཅངས་ཡན་མན་ཡུལ་རྒྱུ་བའམ་གནས་ན་འདུག་པའང་རུང་ལྷམ་རལ་ན་བཙེམ་པའི་ཕྱིར་གླ་རྒྱུན་དང་བསྙུང་བུ་བཅང་བཟོ་གྲི་མ་ཡིན།",
    "གྲོང་དུ་གཞན་མེད་ན་པགས་པ་ལ་འདུག།",
    "གྲོང་དུ་སྤྱན་དྲངས་ཏེ་པགས་པ་སྟན་དུ་བཏིང་ན་སྟན་གཞན་མེད་དམ་ཞེས་སྨྲོས་ཏེ་སྟན་གཞན་མེད་ཅེས་ཟེར་ན་པགས་སྟན་ལ་འདུག་ཀྱང་ཉེས་མེད་དོ།",
    "མཐོ་རིས་ཀྱི་ཁམས་ན་འདུག་པ་ཞིག་སྟེ་འདི་ཡང་མར་དུ་གཏོགས་ཏེ་ཞག་བདུན་པའོ།",
    "གཏར་ག་གདོད་ལ་བྱ་ན་རྩ་ག་ལ་འདུག་པའི་སྟེང་དུ་བྱས་པ་ནི་ཉེས་མེད་དོ།",
    "གནས་བརྟན་གྱིས་བརྗེད་ན་དྲུང་ན་སུ་འདུག་པས་ཀྱང་དྲི།",
    "ལྟག་ཏུ་ཤ་བཟར་མི་རུང་བའི་རྣམས་དང་འོ་མ་རྣམ་གཉིས་ཟོས་ན་ཉེས་བྱས་སུ་འགྱུར་གྱི་མི་བཟའ་བར་འབྲས་སམ་སྣ་ལ་ཕན་པའི་ཕྱིར་གླན་པ་དང་སྲབ་ཅིང་འདུག་པ་ལ་སོགས་པ་ལུས་ཀྱི་ཕྱིར་ལོགས་སུ་སྤྱད་པ་ནི་ཉེས་མེད་དོ།",
    "ཟན་བཟའ་བར་ས་ལ་འདུག་སྟེ་ཟོས་ན་དེ་ཆོག་གོ་ཞེས་བྱས་ཏེ་སླར་གཏོང་བ་ལས་ཡང་སླར་འོན་ཅིག་ཅེས་བྱས་ཏེ་ཟོས་ཀྱང་རུང་ལངས་ཏེ་ཡང་སླར་འདུག་ན་ཟོས་ཀྱང་ཉེས་མེད་དོ།",
    "གྲོང་དུ་སློང་བའི་ཚེ་ལམ་སྲང་གྱ་གྱུ་མང་དུ་འདུག་ན་ཐོག་མའི་ལམ་སྲང་མི་ནོར་བར་བསམ་ཞིང་།",
    "རྩྭའི་ཐུམ་པོ་ལ་འདུག་ཀྱང་རུང་དགེ་སློང་སྟན་མེད་ན་རྩྭའི་ཐུམ་པོ་ལ་འདུག་ཀྱང་ཉེས་མེད་དོ།",
    "དགེ་སློང་རྒན་པོ་དང་གཞོན་ནུ་དང་དགེ་སློང་ཞིག་འདུག་ན་འདྲིམ་པ་ལ་མཉམ་པའི་ཕྱིར་སོ་སོར་བཀང་དུ་བཅུག་ལ་ཞལ་ཏ་བ་མང་དུ་བསྐོས།",
    "དགེ་སློང་མ་ཚར་གཅིག་ཏུ་བཀང་ན་ལྟག་ཏུ་སྟན་རིམ་པ་གཉིས་གསུམ་བོར་ལ་འདུག་པར་བྱའོ།",
    "ཟས་བཟའ་བའི་ཚེ་གྲོང་དང་གཙུག་ལག་ཁང་འདྲ་སྟེ་ཅ་ཅོ་མེད་པར་སྒྲ་བསྐྱུངས་ཏེ་འདུག།",
    "སྟན་ལ་འདུག་པའི་ཚེ་གོང་མ་རྣམས་བཞུགས་ལ་འདུག་གོ།",
    "དེར་ཆུད་པ་བཞིན་དུ་གཞན་གྱིས་སྤྱན་དྲངས་ཏེ་འདུག་པ་ལས་དེས་གནང་ནས་གཞན་གྱིས་བྱིན་ནའོ།",
    "ཟ་བའི་ཕྱིར་འདུག་པ་ལ་འདི་དང་འོ་ན་བྱིན་ལེན་ཞེས་འདྲིམ་པ་ལ་མི་བསྒོ།",
    "ཕྱི་ལོགས་ནས་འོངས་པས་སྒྲ་བྱས་ན་ནང་ན་འདུག་པས་ཡོད་པར་གོ་བར་བྱ་བའི་ཕྱིར་སྒྲ་ཡང་བྱ།",
    "ཉེས་མེད་པ་ནི་ཟ་གུ་སྟེ་ཐ་མར་ཕྱིས་མཚམས་ཏེ་འདུག་ཀྱང་ངོ།",
    "དེ་ལས་གཞན་གྱི་ཆུ་ཡོད་ན་མ་བཀྲུས་པར་མི་འདུག།",
    "ཁ་རོག་ཏུ་འདུག་ཅེས་པ་ཡན་ཆད་དོ།",
    "འཁོར་དུ་མ་འདུག་ན་མ་རྫོགས་པའོ།",
    "འདུག་པ་ལས་ལས་ཀྱི་མགོ་བརྩམས་ཏེ་མ་ཟིན་པར་གྲལ་ན་ཉི་ཤུ་ནི་ལུས་དོང་བ་རྣམས་ཀྱིས་དད་པ་མ་སྦྱིན་ནའང་ལས་སུ་མི་རུང་།",
    "མུར་འདུག་བཅངས་པ་དང་།",
    "གང་ཟག་ལ་འབུལ་བ་ན་ཚིག་ལན་གསུམ་བཟླས་ཏེ་སྨྲ་མདུན་དུ་ཙོག་ཙོག་པོར་འདུག་པ་ལས་ཏེ་བཏང་བ་ཡང་ངོ།",
    "གསོལ་བ་བྱེད་ཅིང་ལས་པའི་དགེ་སློང་དང་རབ་ཏུ་བྱུང་བ་གཉིས་ཀ་ཙོག་ཙོག་པོར་འདུག་པ་ལ་གསོལ་བ་དང་ཞུ་བ་དང་བར་ཆད་དྲི་བ་བྱ།",
    "ལས་ནི་འདུག་སྟེའོ།",
    "བསྔོ་བ་དང་བརྟག་པ་གཉིས་གུད་ན་བཞག་ལ་བདག་འདི་འདུག་པས་སྔགས་གདབ་ཏུ་མི་རུང་ངོ།",
    "ཚུལ་ནས་འབྱུང་འཇུག་དང་བརྟག་པ་དང་བསྔོ་བ་ལ་སོགས་པའི་སྔགས་གྲོགས་གཅིག་དང་གཉིས་འདུག་ལ་སྔགས་གདབ་པའི་ཚེ་བདག་པས་ན་རྒན་པ་ཞིག་ཡིན་ན་ཕྲག་པ་གཡས་པ་ཕྱུང་ལ་གུས་པའི་ཚུལ་དུ་ལས་བྱའོ།",
    "དགེ་སློང་གོས་བདག་པོས་ནི་དྲུང་ན་འདུག་པས་ཨོ་པ་ཡི་ཀ་ཞེས་སྨྲས་པའི་རྗེས་ལས་དུ་ཞེས་ལན་གསུམ་དུ་བརྗོད་དོ།",
    "མཚམས་བཅད་པ་གང་ཚུན་ཆད་བཅད་པའི་ཕྱི་རོལ་དུ་འདུག་སྟེ།",
    "མཚམས་ཀྱི་ནང་དུ་འདུག་ལ་བྱའོ།",
    "དེ་བཞིན་དུ་གང་ཟག་བཅུ་གཉིས་ཀྱི་ལས་སུ་བསྐོས་པ་ཡང་མཚམས་ཀྱི་ནང་དུ་འདུག་ལ་བྱའོ།",
    "འདུག་པར་བྱེད་པས་འདུག་པར་བསྒོ་སྟེ་གཎྜི་བརྡུངས་པ་དང་དྲིས་སྨྲོས་ཤིག་བསྒོ།",
    "མཚམས་གཞན་དུ་འདུག་པ་ནི་གང་དུ་ཡང་ཡན་ལག་མ་ཡིན་ནོ།",
    "གཉིས་སུ་འདུག་པ་ནི་ཚུ་ལོགས་སུ་རྐང་པ་གཅིག་ཕ་ལོགས་སུ་རྐང་པ་གཅིག་ནའོ།",
    "ཀུན་སྤྱད་མི་ནུས་ན་བདག་གར་དགའ་བར་འདུག་ལ་སྤྱོད་ཅིག།",
    "མུར་འདུག་དང་བསྟེན་པ་དང་།",
    "མུར་འདུག་དང་བསྟེན་པ་འདི་གཉིས་ལ་ཡན་ལག་གཅིག།",
    "མཚམས་གཞན་དུ་འདུག་པ་ལ་ཡང་ངོ།",
    "དགེ་སློང་གྲོགས་ལ་བསྔོ་བ་གྲོགས་ནམ་མཁའ་ལ་འདུག་གམ་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་ལ་བདག་མཚམས་ཀྱི་ནང་ངམ་ས་ལ་འདུག་པས་བསྔོ་ན་བསྔོས་པར་ནི་ཆུད་ཀྱི་ཉེས་བྱས་སོ།",
    "འདུག་ན་བཅང་།",
    "ལྷུང་བཟེད་ཁས་ཕུབ་པའི་ཁྱིམ་དུ་ནོར་ཏེ་ཕྱིན་ནས་སྟན་ལ་འདུག་ཅེས་ཟེར་ཀྱང་མི་འདུག།",
    "དགེ་སློང་རང་བཞིན་ཉམས་ཏེ་སྨོས་པའི་ཚེ།",
    "ལྷག་མ་བྱས་ནས་བདག་འཁོར་དུ་མཐོལ་དུ་དགེ་སློང་གྲོགས་མེད་དེ་རྒྱང་གྲགས་གཅིག་གཉིས་ཕན་ཆད་གཅིག་ན་དགེ་སློང་འདུག་ལ་གཅིག་ལ་མཐོལ་དུ་འགྲོར་ལམ་དུ་ཆུས་ཆོད་དེ།",
    "ལྷག་མར་གྱུར་པའི་འོག་ན་ཉེ་འཁོར་དུ་མཐོལ་དུ་ནི་དགེ་སློང་མེད་རྒྱང་གྲགས་གཉིས་གསུམ་ཙམ་གྱི་དགེ་སློང་འདུག་པ་ལ་ནམ་ཕྲད་པ་ན་མཐོལ་བར་བསམས་ཏེ་སེམས་ལ་བཅབས་པའི་སེམས་མེད་ན་ལེ་ལོ་བྱས་ཏེ་མྱུར་དུ་མ་མཐོལ་ཀྱང་བཅབས་པར་མི་འགྱུར།",
    "སྟན་དམའ་བ་ལ་མི་འདུག།",
    "ཆད་པ་བསྟན་མཐོན་པོ་ལ་བཞག་སྟེ་ཆད་པ་མེད་པ་སྟན་དམའ་བ་ལ་མི་འདུག།",
    "མུར་འདུག་སེམས་བརྟག་པའི་ཕྱིར་ཟ་བ་གཅིག་ཏུ་གཞག་པའང་ལྷན་ཅིག་ཏུ་ཉལ་ན་ཉེས་མེད་དོ་ཞེས་བྱི་ཛ་ཡས་བཤད།",
    "ལམ་སྲང་ངམ་གྲོང་བར་ན་འདུག་ན་བྱོལ་ཏེ་འགྲོ།",
    "སྟན་གཅིག་ལ་འདུག་པ་དང་འཆགས་གཅིག་ཏུ་འཆག་པ་དང་གཏམ་དང་གཏམ་ཀུན་ཀྱང་ངོ།",
    "དགེ་སློང་གཉིས་ཤིག་རྩོད་ཅིང་འདུག་འདུག་པ་ལས་རྩོད་པའི་འཕྲོ་ལས་ཤིའམ་ཁྱེམ་པར་བབས་ཏེ་ལམ་རིང་པོར་བབས་ན་ཞི་བར་འགྱུར་རོ།",
    "གཞན་གྱི་གྲོང་ན་འདུག་པ་དང་།",
    "ཟན་ལ་འདུག་པ་མ་གཏོགས་སོ།",
    "འདུག་གམ་འཕྲེས་ན་འདུག་སྟེའོ།",
    "གཙུག་ལག་ཁང་སློང་བའི་དགེ་སློང་བསོད་སྙོམས་པ་ཡིན་པ་ཞིག་དུས་ལས་སྔར་བསོད་སྙོམས་ལ་འགྲོ།",
    "ལྟག་མའི་ཁྲི་འདུག་པའི་གཞི་རྐང་པ་སེང་གེ་བཞིའི་གཟུགས་བྱའོ།",
    "སེང་གེའི་ཁྲི་ལ་འདུག་པའི་ཚེ་རྐང་པ་གཞག་པའི་ཁྲིའུ་གཅིག་གཞག།",
    "མཆོད་སེང་གེའི་ཁྲི་ལ་འདུག་པའི་མདུན་དུ་མེ་ཏོག་དང་།",
    "ཁྲི་ལ་དགེ་སློང་གསུམ་ལས་མང་དུ་ལྷན་ཅིག་མི་འདུག་འཆག་པའི་ཕྱིར་རོ།",
    "ཁྲིའུ་ཆུང་ངུ་གྲུ་བཞི་ལ་མི་གཅིག་ལས་ལྷག་པར་མི་འདུག་པར་ལོ་གསུམ་པ་དང་དེ་དང་ལྷན་ཅིག་ཏུ་སྟན་ལ་མ་ཡིན།",
    "དགེ་སློང་ནང་ལོ་མ་ལོན་པ་དང་ལོ་གསུམ་ལོན་པ་མན་ཆད་ནི་སྟན་གཅིག་ལ་འདུག་ཏུ་རུང་ངོ།",
    "བར་དུ་ལོ་གསུམ་གྱིས་ཆོད་ན་གནས་བརྟན་མན་ཆད་གང་ཡང་སྟན་གཅིག་ལ་འདུག་ཏུ་རུང་ངོ།",
    "ལོ་བཞི་ལོན་ན་ལྷན་ཅིག་ཏུ་འདུག་ཏུ་མི་རུང་ངོ།",
    "གཙུག་ལག་ཁང་ཡང་རུང་གྲོང་ཡང་རུང་ཁྱིམ་པ་དང་སྟན་གཅིག་ཏུ་མི་འདུག།",
    "དགེ་སློང་དང་སྟན་གཅིག་ཏུ་མི་འདུག།",
    "མ་ནིང་དང་ཟ་མ་དང་མ་བསད་པ་ལ་སོགས་པ་དང་མུར་འདུག་དང་མུར་འདུག་ཏུ་འཇུག་པ་དང་།",
    "དགེ་སློང་གཅིག་སྤྱོད་ཅིང་འདུག་པ་ལ་ང་རྒན་གྱིས་ཚུར་འོང་གཅིག་ཅེས་མི་བྱ།",
    "ཆོག་བུ་པ་ནི་འདུག་པ་ལས་མི་བསླང་།",
    "བསམ་གཏན་བྱེད་པའི་གནས་སུ་རྒན་གཞོན་གང་ཡང་རུང་གང་སྔ་སྔ་བབ་བབ་ཏུ་འདུག་ཀྱང་ཉེས་མེད་དོ།",
    "གྲལ་མ་ཡིན་པར་མི་འདུག།",
    "དེ་དག་སྒོ་ཆེན་པོར་མི་འདུག།",
    "དགེ་སློང་མའི་གཙུག་ལག་ཁང་སྒོ་ཆེ་ཆུང་གཉིས་འདུག་ན་སྒོ་ཆུང་ངུ་ནས་ཡར་བྱུང་མར་བྱུང་མི་བྱ།",
    "ལམ་གྱི་མངོན་སུམ་དུ་དགེ་སློང་མས་འགྲེང་ཞིང་མི་འདུག།",
    "དགེ་སློང་ཞིག་གུད་ནས་འོངས་ཏེ་གཙུག་ལག་ཁང་བུར་འདུག་ན་ཁང་བུ་ཕྱག་དར་དང་ཆག་ཆག་བྱས་པ་གནས་སོ།",
    "ཞལ་ནས་གསུངས་པའི་ཚིགས་སུ་བཅད་པ་ཀློག་པ་ན་མངོན་སུམ་དུ་འདུག་ལ་སེ་གོལ་གྱི་སྒྲས་ཆད་པར་བྱ་བ་དང་།",
    "ཐབས་མེད་པ་ཡིན་ནོ་བྱས་པ་ལ་ཡི་གེ་ཤེས་ནས་འདུག་པས་མཐུ་ཅིག་བསློབས་ངས་རྒྱགས་ཤིག་བཙལ་ལ་བསྐུར་གྱི་ཟེར་ནས་མ་ཡི་རྗོངས་ཞིང་ཡོད་པ་བཙོངས་པ་དང་སློངས་བྱས་པའི་ཀ་ཆས་རྟ་སེར་པོ་རྟེའུ་ལ་གྲགས་བྱ་བ་ཉོས་ནས།",
    "དེར་གཡུང་སྟོན་གྱི་ལམ་རྒྱ་ཡོད་ཟེར་ནས་ཁ་རག་ལ་ལམ་རྒྱ་ལ་ཕྱིན་ཙ་ན།",
    "ཁྱེད་ཀྱིས་ང་གསོད་པའི་གྲབས་བྱེད་ཀྱིན་འདུག་སྟེ་ད་སེར་བ་འབེབས་སོ་བྱས་པའི་ཤོག་འཕྲིན་ཞིག་བསྐུར་ནས་བཏང་།",
    "དེར་ཡར་ཀླུངས་སུ་ཕྱིན་ཙ་ན་སེར་བ་ཕེབས་སམ་ཟེར།",
    "དེ་ནས་སློབ་དཔོན་གྱི་གཡོག་བྱེད་ཡིན་བསྡད་ཙ་ན།",
    "བློ་བདེ་བ་གཅིག་ལ་དབྱར་དགུན་གསུམ་བསྡད་ཙ་ན།",
    "ང་རང་ཡང་ནུས་ཚད་ཀྱིས་ཁྲོ་གཉེར་ཅན་གྱི་བཟླས་པ་བྱེད་པ་ཡིན་ཏེ་ཉལ་མ་མྱོང་།",
    "ས་སྐྱགས་སུ་སླེབ་པ་དང་མི་རྒན་འབྲས་བུ་བྱེད་པ་གཅིག་འདུག་པ་ལ།",
    "མི་བདུན་ཕྱག་བྱེད་ཀྱིན་འདུག་པ་ལ་ཡང་རྟོག་པ་མ་ཞུགས།",
    "ཁོ་གཞན་དུ་འགྲོ་བར་འདུག་ཞུས་པས་ཀྱང་མ་གནང་།",
    "དེར་སེར་བ་ཞིག་ཕབ་ཙ་ན་ལོ་འདར་འདུར་དུ་ཁྱེར།",
    "ཆང་ས་གཅིག་ན་བྲག་དཀརསྤོ་མཐོན་ལ་མི་ལ་རས་པ་ཟེར་བ་ཞིག་བསྒོམ་གྱིན་འདུག་སྟེ།",
    "ཡོན་བདག་གཟའ་མི་གཉིས་སྡུག་བསྔལ་གྱིས་ཟིན་ནས་འདུག་ཙ་ན།",
    "ཡུལ་པའི་གཙོ་བོ་གཅིག་ལ་གྲོས་དྲིས་པས་ལན་གཅིག་ཚོལ་དུ་བཏང་བ་ལེགས་ཀྱྀ་ཟེར་ནས་དེར་རྔན་ཟིན་བྱིན་མི་གཉིས་ལྟར་བཏང་ནས་དུད་པ་བཏང་དུང་བུས་ཙ་ན།",
    "བྲག་གསེབ་ན་བཞུགས་པ་འདི་ལམ་ཡང་མི་བདེ་བར་འདུག་པས་ས་བདེ་བ་ཞིག་ཏུ་བཞུགས་པར་ཞུ་བྱས་པས།",
    "ཡོན་བདག་ཀུན་ཀྱིས་ཞུས་པ་འདི་མཐུན་རྐྱེན་མ་འཛོམས་ལ་ཉམས་མི་དགའ་བ་ཞིག་འདུག་པ་ལ།",
    "ཆུ་ཤིང་གམ་ནས་སྤྱོད་ཙ་ན།",
    "འབྲས་བུ་འཁྲུལ་ནས་འདུག་སྟེ།",
    "འཇིག་རྟེན་གྱི་ཆེན་པོ་ཞིག་ལས་མི་འཐོབ་པར་འདུག་པས།",
    "བཙུན་པ་རྣམས་ལ་འོ་སྐོལ་གྱི་རྒྱལ་སྒོའི་ཙ་ན་མི་ལ་དཔོན་སློབ་འགའ་འདུག་བྱས་པས།",
    "རང་སྣང་ཤེས་པ་དགའ་ཡིན་གདའ།",
    "དེར་ལམ་རས་ཆུང་པ་སྤྱན་འདྲེན་དུ་ཕྱིན་ཙ་ན།",
    "ནང་པར་ཙ་ན་ཤུལ་ཀྱང་མེད་པར་བདེ་ནས་འདུག།",
    "ཡང་ཉིན་གཅིག་བྲག་རྩ་གཅིག་ན་ཐུགས་དམ་མཛད་ཀྱིན་བཞུགས་ཙ་ན།",
    "དེར་ཕྱིན་ཙ་ན་བྲག་དེས་ཧྲུལ་གྱི་ཞིག།",
    "བཟའ་གཞན་མི་དགོས་པར་འདུག་གསུངས།",
    "འོ་ན་གྲུབ་ཐོབ་མི་འདུག་གསུངས།",
    "དེར་གཟིམ་སྐྱོར་གློར་ལྟས་ཙ་ན།",
    "གྲི་གཅིག་འདུག་གོ།",
    "མ་དག་པ་ཡང་གང་འཚམ་འདུག་པས།",
    "བོད་རྒྱལ་ཐོག་མ་གཉའ་ཁྲི་བཙན་པོ་ནས་བཟུང་རྒྱལ་རབས་ཉེར་བདུན་གྱི་རིང་བོན་སྲིད་ཟུང་འབྲེལ་བྱས་ཏེ་རང་རྐྱ་ཐུབ་པར་གནས་ཤིང་ཞིང་འབྲོག་དང་བཟོ་ལས་འཕེལ་རྒྱས་སོགས་ཀྱང་དགའ་རབ་བྱུང་འདུག་ལ།",
    "ལོ་བརྒྱ་ཙམ་གྱི་རྗེས་སུ་ད་ཡོད་ཀྱི་སྐད་རིགས་སྟོང་ཕྲག་དྲུག་ལས་སུམ་སྟོང་ཙམ་གཞི་མེད་དུ་འགྱུར་བའི་ཉེན་བརྡ་བཏང་འདུག་ཟེར།",
    "ཞེས་འཁོད་འདུག་པས་ཀྱང་ངེས་པ་རྙེད་ཐུབ།",
    "མཚམས་ལ་འདུག་མཁན་སོགས་ཡོད་ན་ཆེས་ཡ་མཚར་དུ་འཛིན།",
    "ཞེས་སོགས་ཆེས་ཆེར་དོན་ལ་གནས་པའི་བསྔགས་བརྗོད་མཐའ་ཡས་པ་གནང་འདུག་པ་བཞིན་ཡིན་ནོ།",
    "ཡོད་ཚད་ཁོས་གསར་བཏོད་བྱས་སྐད་དེ་ལ་ཁུངས་ལུང་མི་འདུགཇི་སྐད་དུ།",
    "གཅིག་པུར་འདུག་ན་སེམས་ལ་བརྟག།",
    "བུམ་པ་སྐད་ཅིག་གཉིས་པ་དེ་ཡང་རང་དུས་ཙམ་ལས་སྐད་ཅིག་གཉིས་པར་སྡོད་མི་ནུས་པས་ན་བུམ་པ་སྐད་ཅིག་གཉིས་པ་དེ་ཡང་སྐད་ཅིག་མ་ཡིན་པ་ལ་སོགས་པ་བུམ་པ་ལ་སྐད་ཅིག་ཇིསྙེད་ཡོད་པ་ཐམས་ཅད་སྐད་ཅིག་མ་ཡིན་ལ།",
    "བུམ་པ་ཡང་རང་དུས་སྐད་ཅིག་མ་གཅིག་ལས་གཉིས་པར་མི་སྡོད་པས་ན་བུམ་པ་ཡང་སྐད་ཅིག་མ་ཡིན་ཞེས་པའོ།",
    "རྫས་སུ་གྲུབ་པ་ཡིན་ན་མངོན་སུམ་གྱི་སྣང་ཡུལ་གྱི་དོན་བྱེད་ནུས་པ་དང་རང་འཛིན་ཤེས་པ་སྐྱེད་པའི་དོན་བྱེད་ནུས་པ་ཡིན་ཕྱིར་གཞི་གྲུབ་ན་དངོས་པོ་ཡིན་པས་ཁྱབ་པར་འདོད་དོ།",
    "བུམ་འཛིན་ཡིད་ཤེས་ཀྱིས་བུམ་པ་རྟོགས་རྗེས་སུ་ཤེས་པ་ཁོ་རང་འགག་ཀྱང་སེམས་སྟེང་དུ་བུམ་པ་དྲན་པའི་དྲན་ཤེས་བསྐྱེད་པའི་ནུས་པ་ཞིག་བཞག་ཡོད་པ་དེའོ།",
    "བུམ་པ་ཁོ་རང་དངོས་འབྲས་ཡིན་ལ་ཁོའི་དངོས་འབྲས་ཀྱངཡོད་པ་སོགས་དངོས་པོ་ཐམས་ཅད་ལ་རིགས་འགྲེའོ།",
    "མངོན་སུམ་ལ་སྐྱེ་འགག་དེ་གསལ་བར་སྣང་ནས་རྟོགས་པ་ལས་བློ་ངོར་དགག་བྱ་བཅད་ནས་རྟོགས་མི་དགོས་པས་དེ་ཡང་རང་མཚན་ཡིན་ནོ།",
    "དེ་དངོས་སམ་བརྒྱུད་པས་ཀྱང་རང་འབྲས་སྲད་བུ་ལ་སོགས་པ་སྐྱེད་པའི་དོན་བྱེད་པར་ནུས་པ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དོན་དམ་བདེན་པ་དང་རང་མཚན་གཉིས་ཀྱི་མཚན་ཉིད་དང་།",
    "དེ་གཉིས་ནི་རིམ་བཞིན་སྔ་མ་རང་མཚན་དང་ཕྱི་མ་སྤྱི་མཚན་ཡིན་པར་བསྟན་པས་ལུང་དེར་དོན་དམ་བདེན་པ་དང་རང་མཚན་གཉིས་ཀྱི་མཚན་ཉིད་དང་།",
    "གང་ཟག་གང་དང་གང་ཡིན་ཡང་རང་རྒྱུད་ཀྱི་བློའི་འཇུག་ཡུལ་གང་ཡིན་པ་དེ་གང་ཟག་དེའི་ཡུལ་ཡིན་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་རྟོག་བཅས་ཀྱི་བློ་དང་རང་ཡུལ་མེད་པའི་བློ་ཐམས་ཅད་ཀྱང་དེ་དང་མཚུངས་སོ།",
    "གང་ཟག་དེ་དེ་ཡིན་ཡང་རང་ཡུལ་སྣང་བའི་རིག་པ་མ་ཡིན་ཏེ།",
    "དང་པོ་ལའང་རང་རིག་དང་གཞན་རིག་གཉིས་སུ་དབྱེ་བ་དང་།",
    "དེ་ཡང་རང་རིག་འདོད་པ་རྣམས་ནི།",
    "རང་རིག་དང་རང་རིག་མངོན་སུམ་དོན་གཅིག་འཛིན་རྣམ་ལ་རང་རིག་ཅེས་པའི་ཐ་སྙད་འཇུག་པ་ནི།",
    "དེ་ལ་ཡུལ་ཡུལ་ཅན་གཉིས་མེད་ཀྱང་རང་ཡུལ་སྣང་བའི་ཕྱིར།",
    "རང་ཡུལ་ཤར་ཡང་རང་ཡུལ་གྱི་རྣམ་པ་ཤར་མི་དགོས་པའི་ཕྱིར།",
    "དོན་རིག་གཉིས་དང་རང་རིག་དང་།",
    "རྟོག་པས་རང་ཡུལ་གྱི་དོན་སྤྱི་ཤར་ནས་རྟོགས་ན་དེས་ཀྱང་རང་ཡུལ་གྱི་རྣམ་པ་ཤར་ནས་རྟོགས་པ་ཡིན་ཏེ།",
    "གཞན་ཡང་རང་རིག་ཡིན་ན་རང་ཡུལ་རྟོགས་པ་ཡིན་པས་མ་ཁྱབ་སྟེ།",
    "རྟོག་པ་དང་རྟོག་བཅས་ཀྱི་ཤེས་པ་དོན་གཅིག་དེ་ཡང་རང་ཡུལ་གང་ཡིན་པ་དེའི་དོན་སྤྱི་མི་སྣང་བའི་རྟོག་པ་ནི་མེད་ལ།",
    "དེ་དང་རང་མཚན་གཟུང་ཡུལ་དུ་བྱེད་པའི་རྟོག་མེད་མ་འཁྲུལ་བའི་ཤེས་པ་དང་།",
    "རང་རིག་དང་རང་རིག་མངོན་སུམ་གཉིས་དོན་གཅིག་མཚན་གཞི་ནི།",
    "རང་རིག་དང་རང་རིག་མངོན་སུམ་དོན་གཅིག་ཀྱང་།",
    "དེ་གསལ་བར་སྣང་ཡང་རང་ཡུལ་མ་ངེས་པ་སྟེ་མ་རྟོགས་པའི་བློ་ཡང་ཡིན།",
    "དངོས་པོ་དང་རང་བཞིན་གཅིག་ཡིན་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་སྐྱེ་མཆེད་ལྔ་བོ་གང་ཡིན་ཡང་རང་སྐྱ་འཛིན་ཐུབ་པའི་རྫས་ཡོད་ཡིན་ནོ།",
    "བུམ་པ་དང་གཅིག་ལ་སོགས་པ་ཡང་རང་དངོས་སུ་རྟོགས་པའི་བློ་དེས་དེ་དག་རང་མཚན་གྱིས་གྲུབ་པ་སོགས་དངོས་སུ་བཅད་ནས་རྟོགས་དགོས་པས་ན།",
    "སྒྲ་དེས་མི་སྡོད་པ་ཙམ་སྟོན་པ་མ་ཡིན་པར་ཡུན་རིང་དུ་སྡོད་པ་བཀག་ནས་འདུག་ཡུན་ཐུང་བ་དང་མྱུར་དུ་འགྲོ་བ་འཕེན་པ་ཡིན་ནོ།",
    "རྟོག་ངོར་ལྡོག་པ་ཐ་མི་དད་དུ་སྣང་ཡང་རང་ལྡོག་གཅིག་མ་ཡིན་ཏེ།",
    "ཡོད་པ་དེ་ཡོད་པ་དང་རང་ལྡོག་གཅིག་ཡིན་གྱི།",
    "ཡོད་པ་དང་རང་ལྡོག་གཅིག་ཡིན་པས་ཁྱབ་ཀྱང་།",
    "ཡོད་པ་དང་རང་ལྡོག་སོ་སོ་བ་མ་ཡིན་ན།",
    "ཡོད་པ་དང་རང་ལྡོག་གཅིག་ཡིན་པས་མ་ཁྱབ་སྟེ།",
    "རི་བོང་རྭ་དེ་ཡོད་པ་དང་རང་ལྡོག་སོ་སོ་བ་མ་ཡིན་པ་གང་ཞིགདེ་ཡོད་པ་དང་རང་ལྡོག་གཅིག་མ་ཡིན་པའི་ཕྱིར།",
    "ཡོད་པ་དང་རང་ལྡོག་གཅིག་པ་ནི།",
    "དེ་ལ་ཡང་རང་ཡིན་གྱི་གཟུགས་ཤེས་ལྡན་མིན་འདུ་བྱེད་གསུམ་ཡོད་དེ།",
    "ཡོད་པ་དང་རང་ལྡོག་ཐ་དད་ཀྱི་མཚན་ཉིད།",
    "དངོས་པོ་དང་རང་ལྡོག་ཐ་དད་ཀྱི་མཚན་ཉིད།",
    "བུམ་པ་མི་རྟག་པ་དེ་བུམ་པ་དང་རང་བཞིན་ལ་ལྟོས་ཏེ་གྲུབ་བདེ་དབྱེར་མེད་ཀྱི་རྫས་གཅིག་ཡིན་ཡང་།",
    "ཡང་ཀ་བུམ་གཉིས་ཀ་བུམ་གཉིས་དང་རང་ལྡོག་གཅིག་ཡིན་ཏེ།",
    "མྱུ་གུའི་འཇིག་དུས་ནི།",
    "མྱུ་གུའི་སྐྱེ་བ་དང་མྱུ་གུའི་རང་དུས་གཉིས་སྐྱེ་འགག་དུས་མཉམ་ཡང་།",
    "རང་དུས་སྐད་ཅིག་གཉིས་པར་འཇིག་དགོས་དང་རང་དུས་སྐད་ཅིག་གཉིས་པར་ཞིག་ཟིན་གྱི་གཞི་མཐུན་ཡོད་དེ།",
    "དེ་དག་ནི་འབྲས་བུ་དང་རང་བཞིན་དང་།",
    "བྱས་པའི་ཕྱིར་ཞེས་བཀོད་པའི་ཚེ་ན་བྱས་པ་དེ་ཁོ་རང་ལ་དེ་སྒྲུབ་ཀྱི་སྔ་རྒོལ་ལ་ལྟོས་ནས་མ་གྲུབ་པའི་གཏན་ཚིགས་ཡིན་ཏེ།",
    "ཡང་དག་བདུན་ལ་ཡང་རང་རྒྱུད་འཕེན་པ་དང་མི་འཕེན་པ་གཉིས་སུ་དབྱེ་བ་ནི།"
  ]
}