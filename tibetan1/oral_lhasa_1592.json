    "དེའི་ཕྱིར་དེའི་དུས་ཕྱིས་བྱུང་བའི་རྣམ་པར་རྟོག་པའི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དག་ལས་ཟླ་བ་གཉིས་ཐ་དད་པར་བཏགས་པ་ཡིན་གྱི།",
    "མེད་པར་ཐ་དད་མཐོང་བ་བཞིན།",
    "གལ་ཏེ་ཐ་དད་པར་འདོད་ན་ནི།",
    "མྱོང་བ་མེད་པར་དོན་འགའ་འམ།",
    "ཐ་དད་པར་ནི་ཉེར་སྦྱོར་ཕྱིར།",
    "དེས་ན་འདིར་ཕ་རོལ་པོས་ཐ་དད་པ་ཞེས་བྱ་བའི་མིང་ཙམ་ཞིག་གདགས་པར་བྱ་བ་ཡིན་པས་གཞན་ལ་ཆད་པ་ཅུང་ཟད་ཀྱང་མེད་དོ།",
    "བཟློག་པར་རབ་ཏུ་དཀའ་བ་ཉིད།",
    "གྲུབ་པ་དང་བདེ་བ་ཐ་མི་དད་པའི་ཕྱིར་དོན་ཤེས་པ་དང་གཅིག་ཉིད་ནི་བཟློག་པར་དཀའ་བ་ཡིན་ནོ།",
    "བཟློག་པར་མི་ནུས་པའི་ཕྱིར་ན་ཤེས་པ་རྣམ་པ་དང་བཅས་པ་ཞེས་བྱ་བར་ཐུབ་པོ།",
    "རྣམ་པ་གཞན་འཇོག་པར་འགྱུར་བས་ཐུག་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་ན་འཆོལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "སྔོན་པོའི་རྣམ་པ་མཐོང་བ་དང་ལྡན་པ་དག་འདི་ལ་རྒྱུ་འགའ་ཡོད་པར་འགྱུར་རོ་ཞེས་དེ་དང་མཐུན་པའི་རྗེས་སུ་དཔག་པ་ཡིན་གྱི་དངོས་སུ་འདི་རྟོགས་པའི་ཡུལ་དུ་གྱུར་པ་ནི་མ་ཡིན་ཏེ།",
    "ཕྱི་རོལ་གྱི་གཞལ་བྱ་དེ་ལྟ་བུར་གྱུར་པའི་དོན་དེ་ནི་མཐོང་བའི་ཁྱད་པར་དང་བྲལ་བའི་དོན་ཉིད་དུ་ཤེས་པ་ཡིན་ནོ།",
    "རྐྱེན་ལས་ངེས་པར་མི་སྨྲ་ནའོ།",
    "ཅི་རྣམ་པའི་ཁྱད་པར་སྐྱེད་པར་བྱེད་པའི་དོན་གཞན་བརྟག་པར་བྱ་བ་ཡིན་ནམ།",
    "འོན་ཏེ་མཚུངས་པ་དེ་མ་ཐག་པའི་རྐྱེན་ཉིད་ཀྱི་ཁྱད་པར་འགའ་ཞིག་ཡིན།",
    "རྟེན་གཞན་མེད་པར་དེ་ལྟར་རྟོགས་པ་ཡིན་ནོ།",
    "འགྱུར་བ་ཡིན་གྱི་གཞན་དུ་ནི་མ་ཡིན་ཏེ་མ་མཐོང་བ་ནི་བརྟག་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "རྟོགས་པ་ནི་མཐོང་བའི་རྗེས་སུ་འབྲང་བར་སྣང་བས་གཞན་དུ་བརྟག་པར་མི་ནུས་སོ།",
    "གལ་ཏེ་ཕྱིའི་དོན་ཡང་སྐྱེད་པར་བྱེད་པ་ཉིད་དུ་མཐོང་བ་མ་ཡིན་ན།",
    "དེ་ཡང་ཤིང་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་སུས་མཐོང་།",
    "དེས་ན་དེ་ཡང་དོན་ཡོད་དོ་ཞེས་བྱ་བ་ཕྱིས་དམིགས་པར་ངེས་པ་ཡིན་ལ་དེ་ཡང་ཕྱིས་ཡིན་པའི་ཕྱིར་མཐར་ཐུག་པ་མེད་པས་ན་མི་རྟོགས་པ་ཉིད་དོ།",
    "འབྲས་ཉིད་ཤེས་པ་ཡིན་པར་འགྱུར།",
    "ངེས་པ་མེད་པར་འགྱུར་བ་ཡིན་ནོ།",
    "རྒྱུ་ནི་འཁྲུལ་པར་འགྱུར་བའི་ཕྱིར།",
    "ངེས་པར་རྟོགས་པ་གཞན་ཡོད་མིན།",
    "རྣམ་པར་ཤེས་པ་སྨྲ་བ་ལ་ནི་ས་བོན་ལ་སོགས་པ་སྣང་བ་ལས་མ་གཏོགས་པའི་ས་བོན་ལ་སོགས་པ་མེད་དོ།",
    "དེ་ལྟར་ན་ཡང་ཐ་སྙད་ཆད་པར་འགྱུར་རོ།",
    "དུ་བ་ལས་མེ་ཡོད་དོ་ཞེས་བྱ་བ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་ལ་ལྐོག་ཏུ་གྱུར་པ་ཡིན་ན་ཕྱི་རོལ་གྱི་མེ་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "གཞན་གྱི་སྣང་བ་ཡང་བསྒྲུབ་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་ཕྱི་རོལ་གྱི་དོན་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེ་ན།",
    "མི་སྣང་བ་ནི་ཡོད་ཀྱང་མེད་པ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་དམིགས་པ་ཉིད་ཡོད་པར་བརྗོད་པ་ཡིན་ནོ།",
    "སྣང་བ་མེད་པར་འགྱུར་བ་ན།",
    "གྲུབ་ན་དེ་ཡི་ཡོད་པར་རྟོགས།",
    "འོ་ན་རྣམ་པར་ཤེས་པ་ལ་ཡང་སྒྲོ་བཏགས་པས་སུས་བཟློག།",
    "རྣམ་པར་ཤེས་པ་མེད་པའི་ཕྱིར་ཇི་ལྟར་སྒྲོ་འདོགས་ཤེ་ན།",
    "དེར་ཡང་དོན་དམ་པར་ནི་གཅིག་ཉིད་རྟོགས་པ་མ་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་སྨྲ་བ་ལ་ཡང་རབ་རིབ་ཅན་གཉིས་ཀྱིས་ཟླ་བ་གཉིས་མཐོང་བ་བཞིན་དུ་གཞན་ལ་ཡང་ཐ་སྙད་བྱེད་དོ།",
    "དེས་ན་རྣམ་པར་ཤེས་པ་སྨྲ་བ་ལ་ཡང་གལ་ཏེ་དེའི་ངོ་བོར་ངེས་པར་སྣང་བ་དང་འབྲེལ་པའི་ཆ་ལ་བརྟེན་ནས་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ཡིན་ན་འགལ་བ་ཅི་ཡོད།",
    "ཕྱི་ནས་ཉིད་ནི་རྟོགས་པར་འགྱུར།",
    "གཞན་གྱི་ངོ་བོར་རྟོགས་ན་ནི་རྣམ་པར་ཤེས་པའི་རང་བཞིན་ལ་ཡང་མཚུངས་པ་ཉིད་དོ།",
    "འོན་ཏེ་རྟོགས་པས་སྣང་བ་དང་རྣམ་པར་བརྟག་པར་བྱ་བ་གཅིག་ཏུ་བྱས་ནས་འཇུག་པ་དག་དེར་སྒྲོ་འདོགས་པར་བྱེད་དོ་ཞེ་ན།",
    "དེ་མེད་ན་ཕྱིས་ཀྱིས་དོན་རྣམ་པར་ཆད་པ་སྐྱེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་མིན་པའང་རྣམ་པར་ཆད་པ་ཇི་ལྟར་འགྱུར།",
    "གལ་ཏེ་རྣམ་པར་མ་ཆད་པར་རྟོགས་པས་དངོས་པོ་ཡིན་ན་བག་ཆགས་བར་དུ་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "མཐོང་བ་ནི་མ་མཐོང་བ་དང་མཚུངས་པར་རྟོགས་ནུས་པ་མ་ཡིན་ནོ།",
    "དེ་ནི་རྣམ་པར་ཤེས་པ་སྨྲ་བ་ལ་ཡང་མཚུངས་པ་ཉིད་དོ།",
    "གལ་ཏེ་རིགས་མི་མཐུན་པའི་རྣམ་པར་ཤེས་པའི་རྒྱུ་དག་ཉིད་བག་ཆགས་བར་དུ་ཞུགས་པ་དག་ཇི་ལྟར་དེས་དེ་རྣམ་པར་མ་ཆད་པར་འགྱུར་ཞེ་ན།",
    "རྣམ་ཆད་མེད་པར་དེ་འདོད་བཞིན།",
    "ཉིད་ལས་རྣམ་ཆད་མེད་པར་འགྱུར།",
    "སྡོང་བུ་ལ་སོགས་པ་དག་ལ་འབྲས་བུ་ལས་རྗེས་སུ་དཔག་པའི་ནུས་པའི་ཁྱད་པར་འཇོག་པས་ན།",
    "འཇིག་རྟེན་དག་རྣམ་པར་མ་ཆད་པར་སྐྱེད་དོ་ཞེས་བསྐྱེད་པ་དེ་བཞིན་དུ།",
    "འབྲས་བུ་རྣམ་པར་མ་ཆད་པ་ཁོ་ནར་སྐྱེད་པར་བྱེད་དོ་ཞེས་བརྗོད་པའམ་ངེས་པ་ཡིན་ནོ།",
    "དེས་ན་སྔར་གྱི་སྣང་བ་དེ་ཉིད་མེར་སྣང་བ་དེ་སྐྱེད་པར་བྱེད་པ་ཡིན་གྱི་དུ་བར་སྣང་བ་ནི་མ་ཡིན་ནོ།",
    "གང་ལས་ངེས་པར་རྟོགས་པར་འགྱུར།",
    "རྒྱུ་ཉིད་ཡིན་ན་ཡང་ངེས་པར་རྟོགས་པར་ག་ལས་ཡོད་དེ།",
    "གལ་ཏེ་ཐ་སྙད་ཁས་ལེན་པར་བྱེད་ན་དོན་གྱི་ཡུལ་ཅན་ཉིད་ཡིན་པར་འགྱུར་ལ།",
    "དེས་ན་དུ་བར་སྣང་བའི་ཤེས་པས་ནི་མེའི་བག་ཆགས་ཉིད་རྟོགས་པར་བྱེད་ལ།",
    "དེས་ན་དོན་དམ་པར་སྣང་བར་འགྱུར་བའི་ཡུལ་ཡིན་ནོ།",
    "གང་ལ་བག་ཆགས་ཀྱི་ཁྱད་པར་ཉིད་ལས་འཆུགས་པ་མེད་པ་དེ་ནི་རྨི་ལམ་གྱི་བདེན་པ་ཉིད་མ་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་སྨྲ་བ་རྣམས་ལ་ཡང་བག་ཆགས་ཀྱི་ཁྱད་པར་ལ་རྨི་ལམ་དང་ཅིག་ཤོས་ཀྱི་རྣམ་པར་ཤེས་པའི་དབྱེ་བ་ནི་ཡོད་པ་ཉིད་དོ།",
    "དཔེར་ན་རྨི་ལམ་ཉིད་ན་རྨི་ལམ་དང་ཅིག་ཤོས་ཁྱད་པར་ཡོད་པ་བཞིན་ནོ།",
    "དེ་ལ་ཡང་མི་མཁས་པ་རྣམས་འཇུག་པར་འགྱུར་བས་འདི་ཁྱེད་ལ་ཆད་པ་ཅི་ཞིག་ཡོད།",
    "གལ་ཏེ་མེ་ལ་སོགས་པར་སྣང་བ་ནི་བག་ཆགས་དང་འབྲེལ་པ་ཉིད་ཡིན་ལ་དེའང་རིགས་མཐུན་པའི་བག་ཆགས་དང་འབྲེལ་པ་ཡིན་ན།",
    "འོ་ན་ནི་དུ་བར་སྣང་བ་དེའི་བག་ཆགས་ཉིད་རྟོགས་པར་འགྱུར་གྱི།",
    "ཇི་ལྟར་མེའི་བག་ཆགས་རྟོགས་པར་བྱེད།",
    "མེའི་བག་ཆགས་ཀྱིས་ནི་དུ་བར་སྣང་བ་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེའི་དུ་བའི་བག་ཆགས་ཉིད་ཀྱིས་བསྐྱེད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལས་གཞན་གྱིས་བསྐྱེད་པར་བྱ་བས་ནི་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་གཞན་གོ་བར་བྱེད་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "རྒྱུད་དེ་ཡང་དུ་བའི་བག་ཆགས་སད་པར་བྱེད་པའི་སེམས་གཞན་གྱིས་ཉེ་བར་བསྒྲུབ་པ་ལས་དུ་བར་སྣང་བ་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ།",
