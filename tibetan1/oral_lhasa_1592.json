    "གཞན་གྱིས་དེ་བཞིན་རྟོགས་པར་འགྱུར།",
    "གལ་ཏེ་འདི་དོན་ཡིན་ན་གཞན་གྱིས་ཀྱང་ཤེས་པར་འགྱུར་རོ།",
    "བརྗོད་ཀྱང་རྟོགས་པར་མི་འགྱུར་རོ།",
    "དེ་ལྟ་ཡིན་དང་བརྗོད་ཀྱང་རྟོགས་པར་མི་འགྱུར་རོ།",
    "འོན་ཏེ་རྟོགས་ན་ནི་དེའི་ཚེ་དེ་ལྟ་མ་ཡིན་པར་ཡང་རྟོགས་པར་འགྱུར་རོ།",
    "འདི་ནི་གཅིག་གོ་ཞེས་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "སེམས་དེ་གཉིས་ནི་དོན་ཐ་དད་པར་འགྱུར་བ་འཛིན་པ་ལ་འཇུག་པའི་ཕྱིར་རོ།",
    "གཞན་ལ་གནས་པ་ཡང་རྟོགས་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་གཞན་ལ་སྣང་བ་མེད་པར་གཞན་ལ་སྣང་བར་ངེས་པའི་བློར་འགྱུར་བ་དེ་བཞིན་དུ་དོན་སྣང་བ་མེད་པར་དོན་གྱི་རྣམ་པར་འགྱུར་བའི་ཕྱིར་ཤེས་པ་རྣམ་པ་དང་ལྡན་པར་གྲུབ་པོ།",
    "དེ་ཤེས་པ་ཡི་དམིགས་པར་འགྱུར།",
    "དྲན་པའི་རང་བཞིན་མ་ཡིན་པ་སྔོན་པོ་ལ་སོགས་པའི་ཡུལ་ཅན་གྱི་ཉམས་སུ་མྱོང་བའི་རྣམ་པར་ཤེས་པ་ནི།",
    "དེའི་ཡུལ་ཅན་གྱི་ཤེས་པ་གཉིས་པ་དྲན་པའི་རང་བཞིན་གྱིས་དམིགས་པར་འགྱུར་ཏེ།",
    "རྗེས་སུ་འབྲང་བར་བྱེད་ཅིང་ངེས་པར་འཛིན་པར་བྱེད་དོ།",
    "ཆ་གཉིས་པ་བརྟེན་པར་འགྱུར་བས་དེ་སྔོན་པོར་སྣང་བའི་ཤེས་པ་བྱུང་བར་གྱུར་ཏོ་ཞེས་བྱའོ།",
    "རང་བཞིན་རྟོགས་པར་བྱེད་མིན་ཏེ།",
    "དེ་ཡི་རང་བཞིན་མ་རྟོགས་པར།",
    "རྟོགས་པར་བྱེད་པར་ནུས་མ་ཡིན།",
    "གཟུགས་ལ་སོགས་པར་སྣང་བ་ལས་མ་གཏོགས་པའི་བློའི་རྣམ་པ་གཞན་ནི་འགའ་ཡང་དོན་གྱིས་གོ་འམ།",
    "གཞན་གྱིས་ངེས་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "རྐྱེན་ཐ་དད་པས་ནི་ཁམས་ཀྱི་དོན་ཐ་དད་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་སྔོན་པོ་ལ་སོགས་པའི་རང་བཞིན་ཉིད་བློ་ཞེས་ཐ་དད་པར་བསྙད་པ་ཡིན་ན།",
    "བློ་ཞེས་བྱ་བ་ནི་མེད་པར་འགྱུར་ཏེ།",
    "འགའ་ཞིག་ཉིད་ནི་འགོག་པར་བྱེད།",
    "བློ་དང་ལྡན་པས་ནི་དོན་གྱི་ཐབས་ཀྱིས་བློ་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "དེས་ན་དོན་མེད་ཀྱང་ཁས་བླངས་པར་ནུས་པ་ཉིད་དོ།",
    "རྫས་ནི་མེད་པར་རབ་བརྗོད་པའི།",
    "དོན་མེད་པར་ནི་རབ་ཏུ་བརྗོད།",
    "དངོས་མེད་པར་ནི་གསལ་མ་ཡིན།",
    "དོན་དམ་པར་ནི་རྣམ་པ་གཉིས་པོ་དེ་དང་།",
    "གལ་ཏེ་རྣམ་པ་གཉིས་སུ་རྣམ་པར་གཞག་པ་དེ་ལྟ་བུ་ཡང་རྣམ་པ་གཉིས་ཉིད་ཇི་ལྟར་ཡིན་ཞེ་ན།",
    "ཇི་ལྟར་ཤེས་ལ་གནས་པར་འགྱུར།",
    "གལ་ཏེ་བདག་ཉིད་དེའི་རྣམ་པར་རང་རིག་པས་མ་མྱོང་ན་ནི་དེའི་ཚེ་ཤེས་པ་ལ་དེའི་རྣམ་པ་ཅན་དུ་དྲན་པས་གནས་པར་བྱེད།",
    "གནས་པར་བྱེད་པ་ནི་དེའི་རྣམ་པ་ཉིད་དུ་ཤེས་པར་བྱེད་པའོ།",
    "དེར་རྣམ་པར་བྱེད་དོ་ཞེས་བྱ་བ་ག་ལས་ཤེ་ན།",
    "གདོན་མི་ཟ་བར་འདི་ལྟར་རྟོགས་པར་བྱ་སྟེ།",
    "འདི་ཉིད་དཔེས་སྟོན་པར་བྱེད་པ་ནི།",
    "ཤེས་པ་ཡིས་ནི་རྟོགས་པར་འགྱུར།",
    "ཤེས་པ་གཉིས་པ་ནི་རྣམ་པར་ཤེས་པ་སྔ་མའི་རྣམ་པ་གཉིས་དང་།",
    "དྲན་པར་ནུས་ཀྱི་བར་དུའོ།",
    "དེས་ན་གཞན་དུ་ཤེས་པ་དྲན་པར་མི་ནུས་པས་ན་དེ་ལྟར་དྲན་པ་ཡིན་ནོ།",
    "དེས་ན་དེས་བློ་རྨོངས་པའི་རྒྱུད་ཅན་དག་དེ་ལྟར་རྟོགས་པར་འགྱུར་བ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལྟ་ན་ནི་འོ་ན་སྣང་བ་དང་ཡིད་ལ་བྱེད་པ་དག་ལ་ཡང་དེ་ལྟར་རྟོགས་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་རྣམ་པར་ཤེས་པ་ལ་ཡུལ་གྱི་འབྲས་བུ་ཡིན་པ་དེ་བཞིན་དུ་སྣང་བ་དང་ཡིད་ལ་བྱེད་པའི་འབྲས་བུ་ཡང་ཡིན་ནོ།",
    "དེས་ན་གཉིས་ལ་ཡང་བསྡོམས་ནས་རྟོགས་པར་འགྱུར་ཏེ།",
    "འབྲས་བུ་ཉིད་དུ་ནི་ཁྱད་པར་འགའ་ཡང་མེད་དོ།",
    "འོ་ན་དེའི་ཚེ་སྣང་བ་ལ་ཡང་བྱེད་པར་མཚུངས་པ་ཡིན་ཏེ་སྣང་བ་མེད་པར་ནི་གཟུགས་ལ་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་ན་གསལ་བར་བྱེད་པའི་ཤེས་པ་ཡང་གཟུགས་ལ་འཇུག་པའི་ཕྱིར་གཟུགས་ཉིད་ཡིན་པས་སྣང་བ་རྣམ་པ་དང་བཅས་པ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་ཡང་རྣམ་པ་དང་བཅས་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་གཟུགས་མེད་པར་སྣང་བ་གཟུང་བར་མི་ནུས་པ་དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་ཡང་ཡིན་ནོ།",
    "གཟུགས་ལ་སོགས་པའི་གསལ་བྱ་མེད་པར་ནི་འགས་ཀྱང་རྣམ་པར་ཤེས་པའི་ཞེས་བྱ་བ་ཡོད་པར་རྟོགས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཟུགས་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ཡིན་ནོ།",
    "རྒྱུ་དང་ལྷན་ཅིག་འཛིན་པར་འགྱུར།",
    "མེད་པར་བུམ་པ་དྲན་མི་འགྱུར།",
    "ཤེས་པ་འཛིན་པ་ན་དོན་འཛིན་པར་འགྱུར་བ་ཤེས་པ་དོན་གྱིས་བྱས་པའི་ཁྱད་པར་འགའ་ཞིག་ཡོད་པ་ཡིན་པས་ན་ཤེས་པ་འགའ་ཞིག་དྲན་པའམ་འཛིན་པ་མ་ཡིན་ནོ།",
    "ཁྱད་པར་གང་ལས་ཤེས་པ་ནི།",
    "གལ་ཏེ་རྣམ་པར་ཤེས་པ་དེ་དོན་གྱི་རྣམ་པ་ཅན་ཉིད་མ་ཡིན་པ་དེའི་ཚེ་རྣམ་པར་ཤེས་པ་དོན་འཛིན་པ་དང་།",
    "དོན་དེ་ནང་དུ་ཆུད་པ་ཡིན་ན་ནི་ངེས་པར་ད་འཛིན་པ་ཉིད་ཀྱིས་འཛིན་པ།",
    "ཡིན་པའི་ཕྱིར་ངེས་པར་འགྱུར་རོ།",
    "དེ་དྲན་པ་མེད་པར་མི་དྲན་པ་ཡིན་ནོ།",
    "དེ་ཉིད་འདིའོ་ཞེས་དྲན་པར་མཐོང་བ་ཡིན་ལ།",
    "གལ་ཏེ་རྣམ་པར་ཤེས་པ་དང་པོ་གཉི་གའི་རང་བཞིན་མ་ཡིན་ཏེ།",
    "རྣམ་གནས་ངེས་པར་འཛིན་པ་ཡི།",
    "སེམས་ཀྱིས་འབྱེད་པར་འགྱུར་མ་ཡིན།",
    "ངེས་པར་འཛིན་པའི་སེམས་ཀྱིས་ཏེ།",
    "གཉིས་པ་ངེས་པར་འཛིན་པའི་སེམས་ཀྱིས་གཉིས་པ་དང་པོ་ལས་ཐ་དད་པར་རྣམ་པར་འཇོག་པར་མི་འགྱུར་རོ།",
    "རང་བཞིན་གཅིག་ཉིད་ལས་རྣམ་པར་གནས་པར་འགྱུར་ཏེ།",
    "འཛིན་པའི་རྣམ་པ་འབའ་ཞིག་གོ་ཞེས་བྱ་བའི་དོན་ཏེ་དེས་ན་གང་ལས་ཐ་དད་པར་ངེས་དེས་ན་རྣམ་པར་ཤེས་པ་ནི་ཡུལ་གྱི་རྣམ་པ་ཉིད་དོ།",
    "མདུན་ན་གནས་པར་གྱུར་པའི་བློ།",
    "བློ་གཉིས་པས་ནི་དམིགས་པར་འགྱུར།",
    "དོན་གྱི་རྣམ་པ་ཅན་ཡིན་པ་དེའི་ཕྱིར་བློ་སྔ་མ་བློ་གཉིས་པས་མདུན་དུ་དམིགས་པར་འགྱུར་རོ།",
    "འདི་དོན་སྲེ་བས་འབྲེལ་པར་འགྱུར་བའི་ཕྱིར་འབྲེལ་བའོ།",
    "གལ་ཏེ་དེའི་རྣམ་པར་གྱུར་ན་ནི་འབའ་ཞིག་ཀྱང་དམིགས་པར་འགྱུར་རོ།",
    "དེས་ན་དེ་འཛིན་པར་བྱེད་པ་མ་ཡིན་པའི་རང་བཞིན་གཞན་གྱིས་ཕྱིས་དྲན་པ་དེ་ལྟ་བུ་ཉིད་འཛིན་པར་བྱེད་པ་ཇི་ལྟར་ཡིན།",
    "དེའི་ཕྱིར་དེ་སྣང་བ་ཉིད་འདི་ནི་རང་བཞིན་ཡིན་པས་རྣམ་པར་དབྱེ་བས་མི་ནུས་པའི་ཕྱིར་གཟུགས་ལ་སོགས་པའི་བདག་ཉིད་གཅིག་ཉིད་དོ།",
    "གལ་ཏེ་རྣམ་པར་ཤེས་པ་རང་བཞིན་གཉིས་པ་མ་ཡིན་ན་དེའི་ཚེ་དང་པོ་ཉིད་སྔོན་པོའི་རྣམ་པར་འགྱུར་གྱི་ཕྱི་མ་ཕྱི་མ་ནི་མ་ཡིན་ནོ།",
    "དེ་ནི་དེའི་ཡུལ་མ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་གསུངས་སོ།",
    "ཡུལ་མ་ཡིན་པ་ཡང་ཇི་ལྟར་དམིགས་པར་འགྱུར།",
    "གལ་ཏེ་དང་པོའི་དོན་གྱི་རྣམ་པར་གྱུར་པ་ཉིད་ཡིན་པས་དེའི་ཚེ་ནི་དེ་ལས་གྱུར་པ་གཉིས་པ་ཡང་དེའི་དོན་གྱི་རྣམ་པ་མྱོང་བའི་རྣམ་པ་ཉིད་ཡིན་ནོ།",
    "དེ་ཡི་རྣམ་པར་ལྡན་གྱུར་ཏེ།",
    "འོན་ཏེ་ཤེས་པ་འབའ་ཞིག་དྲན་པར་མི་ནུས་པས་དོན་དང་ལྷན་ཅིག་པ་ཉིད་དྲན་པ་ཡིན་ཏེ།",
    "ཡུལ་ནི་རྣམ་པར་ཤེས་པ་དང་ལྷན་ཅིག་ཉིད་དུ་དམིགས་པ་ཡིན་ཏེ།",
    "ཤེས་པ་ངེས་པར་རྟོགས་པ་མེད།",
    "བདེ་བ་ལ་སོགས་པའི་རང་བཞིན་རྣམ་པར་ཤེས་པ་ཡིན་ནོ་ཞེས་བྱ་བར་ནི་ཁྱེད་ལ་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "ཇི་ལྟར་བདེ་བ་ལ་སོགས་པ་ལས་ཐ་དད་པར་རྣམ་པར་ཤེས་པ་གཞན་མེད་པ་དེ་བཞིན་དུ།",
    "སྔོན་པོ་ལ་སོགས་པ་ལས་ཐ་དད་པར་ཡང་ངོ།",
