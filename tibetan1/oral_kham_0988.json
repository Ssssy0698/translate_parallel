    "ད་གྲོང་ཁྲོད་དུ་འབབ་མ་དགོས་པར་འཚོ་ཆས་བུག་སྒོར་སྐྱེལ་མཁན་བྱུང་ཕྱིན་དགེ་སྦྱོར་ལ་བར་ཆད་ཡོང་དོན་མི་འདུག་པས་གཞན་གྱིས་བསྙེན་བཀུར་བ་རྣམས་བླངས་ཏེ་དགེ་སྦྱོར་གཤའ་མ་ཞིག་བྱས།",
    "འབྲལ་སྤང་རྣམས་དང་ཞག་ཤས་ཐུབ་པའི་ཕྱེ་ལྷག་པ་ཅིག་འདུག་པ་རྣམས་ཁྱེར་ཏེ།",
    "གནས་འཛིན་མཆོད་གནས་བྱམས་པ་ཟེར་བ་ཞིག་འདུག་པ་ལ་དྲིས་པས་ཀྱང་ཅི་བྱེད་ཟེར།",
    "གནས་ཡིད་དུ་འོང་ཞིང་ཉམས་དགའ་བ་ཞིག་འདུག།",
    "དེ་ནས་རིམ་བཞིན་ཕྱིན་པས་རི་དེའི་རྐེད་པ་ཙམ་ན་ཕུག་པ་བཟང་པོ་གཉིས་འདུག།",
    "དེ་ནས་ཀྱང་ཕྱིན་པས་བྲག་རིའི་མགུལ་ན་ཕ་བོང་རྩེ་འཛོམ་པ་ལྟ་བུའི་ཕུག་པ་གཞན་གྱིས་མི་རྙེད་པའི་ཤིན་ཏུ་གསང་བ་ཞིག་འདུག་པ་དེར་སྡོད་པར་དམ་བཅས་ཏེ་ཕུག་པའིམིང་ལ་མཁའ་འགྲོའི་གསང་ཕུག་ཏུ་བཏགས།",
    "གནས་དེ་ན་དགེ་སློང་འཚོ་བ་བཀྲེན་པ་ཞིག་འདུག་ཟེར་བ་ཐོས་ཏེ།",
    "ཞོ་རྫི་འུ་གང་ཁྱེར་ནས་ཆུང་མ་དགོས་ཡགས་བྱུང་འདུག་པ།",
    "ཕྱེས་ཇི་ཙམ་ཐུབ་དྲིས་ཤིག་བྱས་འདུག།",
    "དེ་བཞིན་ཁོ་ན་རུ་འདུག་ཀྱང་།",
    "འདི་པཎ་ཆེན་སྐུ་འདིས་གཞན་གྱིས་གཙུག་ཕུད་བཞེས་པའི་སྔ་ཤོས་སུ་འདུག།",
    "དེ་ནས་དགའ་བཞི་གུང་པཎྜི་ཏའི་ཐུགས་བཞེད་ལྟར་ཁོང་རང་དང་།",
    "མཁས་བཙུན་བཟང་༤༥ན་པོའི་ཡོན་ཏན་དང་ལྡན་པ་འཆད་རྩོད་གསུམ་མཛད་མཁན་ལ་དོ་གལ་བྱེད་མཁན་མི་འདུག་པས།",
    "ཞེས་ཞུས་འདུག་པར།",
    "སྤྲང་ཕུགས་ཤི་ལ་གཏོད་གསུངས་འདུག་པས།",
    "གཟིམས་མལ་ན་རྩྭའི་བཞུགས་གདན་ཞིག་ཡོད་པ་དེ་མ་གཏོགས་གཞན་གང་ཡང་མི་འདུག་པས།",
    "ཕྱིས་གནས་དེ་ལ་སེམས་བསྐྱེད་སྒང་དུ་གྲགས་ཤིང་དེ་ན་རྡོ་ལས་གྲུབ་པའི་རྗེ་འདིའི་བཞུགས་ཁྲི་ད་ལྟ་ཡང་མཇལ་རྒྱུ་ཡོད་པར་འདུག།",
    "གནས་དེར་མགོན་པོ་ཕྱག་དྲུག་པའི་རྡོ་སྐུ་ཞིག་ཡོད་འདུག་པར་འཕྲིན་བཅོལ་དང་།",
    "གཏན་གྱི་མདུན་མ་གྲུ་བཞིར་ལེགས་ནས་གདའ།",
    "རྦབ་དང་གངས་རུད་སོགས་ཀྱིས་སྒྲུབ་གནས་རྒྱ་ཆེ་བ་ཆགས་ཐུབ་པ་མི་འདུག་པས།",
    "དུང་དཀར་བོ་དྲི་མ་མེད་པ་ཞིག་འདུག་པར།",
    "ངེད་བན་རྒན་གྱི་བྱ་བ་ཟིན་ནས་གདའ།",
    "ཁོ་བོ་རྒྱ་ཕྱོགས་སུ་འགྲོ་དགོས་པ་འདི་མཁྱེན་པའི་རྟགས་སུ་འདུག་ཅེས་གསུང་བའང་སྣང་ངོ།",
    "འོ་བན་རྒན་ང་དབེན་པའི་གནས་ནས་དབུས་གཙང་དུ་འགྲོ་དགོས་པ་འདི་བཞིན་མར་གྱི་དཀྱིལ་ནས་སྤུ་བཏོན་པ་བཞིན་སེམས་བག་འཚེར་བའི་རང་བཞིན་དུ་འདུག་ཀྱང་།",
    "སྐུ་ན་སྨིན་ཆེ་བར་མ་ཟད་དེ་སྔ་ཆིབས་གྲལ་གཡོར་ཆེ་དེ་རིགས་ཀྱི་ཁྲོད་དུ་ཕེབས་མྱོང་མེད་པས་སྔོན་ཚུད་དུ་ཕེབས་བཞེད་འདུག་དོན་ལྟར་ཐུགས་མཁོའི་ཉེར་སྤྱད་དང་།",
    "རྣམ་འཇོམས་དང་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་དང་བཅས་སྙན་བརྒྱུད་ཀྱི་ལུགས་སུ་འབུལ་བར་མཛད།",
    "འདི་ལྟ་བུའི་ལྟས་ཅི་ཡིན་ཞེས་དགྱེས་ཚུལ་མཛད་འདུག་པ་རྣམས་དམ་ཚིག་པ་ལ་ཡེ་ཤེས་པ་དངོས་སུ་ཞུགས་པའི་རྟགས་ཡང་དག་པའོ།",
    "དེའི་ཕྱི་ཉིན་ཡང་མགོན་པོ་ཉིད་ལ་འཕྲིན་བཅོལ་མཛད་པས་མགོན་པོའི་ཞལ་མདངས་ཉིན་སྔ་མ་ལས་སྣུམ་ཞིང་དགྱེས་ཞལ་གཟི་བརྗིད་དང་ལྡན་པར་བཞུགས་འདུག་པར།",
    "རྗེ་ཉིད་ནས་མགོན་པོ་དགྱེས་འདུག་པས་ད་ནི་ལེགས་པ་ཡིན་གསུངས་ཏེ་མཉེས་མཉེས་མཛད།",
    "མེ་ཏོག་ཉིད་སྒྲོལ་མའི་ལྷ་གྲངས་དང་ཕྱག་མཚན་དུ་འདུག་པས་རྗེ་ཉིད་ཤིན་ཏུ་དགྱེས་པའི་ཉམས་ཀྱིས་མེ་ཏོག་མདུན་བསྐྱེད་ཀྱི་ཚོམ་བུའི་མདུན་དུ་བསྒྲིགས་པར་མཛད་དེ།",
    "གཞན་ཡང་རྗེ་འདི་ཉིད་ཀྱིས་མཛད་པའི་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་བློ་གྲོས་མཆོག་སྩོལ་ཞེས་བྱ་བ་དང་།",
    "གནས་རྒྱ་འདུལ་འཛིན་ཆེན་པོས་མཛད་ཚུལ་ཞིག་འདུག་པ་རྣམས་སྒོ་མཐུན་པས་རྗེ་འདི་རྒྱ་འདུལ་ཆེན་པོའི་༡༨༦ན་སྐུའི་སྐྱེ་ཟླ་ཡིན་ནམ་སྙམ་ཤིང་།",
    "ཁྱད་པར་ཇོ་གདན་མཚན་སྒྲོག་ཏུ་གནས་གཞི་ཕབ་ནས་གདུལ་བྱ་མཐའ་ཡས་སྨིན་གྲོལ་ལ་འགོད་པར་མཛད་འདུག་ཅིང་།",
    "ད་ནི་ན་སོ་རྒས་འདུག་གསུང་།",
    "ད་ལྟ་དཀྲིག་བཅར་མ་བྱུང་ལགས་ཞུས་འདུག་པར།",
    "གཞི་འདིར་གཏོར་མ་མ་ཆག་པར་དགོས་པ་འདུག་གོ་གསུང་།",
    "ལྷ་ལྡན་དཔལ་ལྷའི་འདྲ་འབག་ནས་སྤྱན་ཆབ་ཀྱི་རྒྱུན་བབས་པ་སོགས་རྟགས་མཚན་ངན་པ་སྣ་ཚོགས་ཤིག་བྱུང་འདུག་པས་བློགཡེང་དུ་གྱུར་ཏེ་རྗེ་འདིའི་ཞབས་བརྟན་དུ་སྒྲོལ་མ་དང་།",
    "དཔེར་ན་རི་ཆེན་པོ་ཉིལ་བའི་ཚེ་ཕ་བོང་ཆེན་པོ་རིས་རྟེན་བྱས་ན་དེ་ལ་བརྟེན་ནས་རྡོ་མང་པོ་ཞིག་ཆགས་ཐུབ་ཀྱིན་འདུག་པ།",
    "ད་ལམ་གྱི་སྙུན་༢༢༨བ་ཚུལ་འདིའི་ཐོག་ཏུ་དགོངས་པ་གཞན་དོན་དུ་གཏད་ཚེ་ཁོ་བོ་བློ་ཤིན་ཏུ་ཕམ་པ་ཞིག་ཡོང་བ་འདུག་པས་སྙུན་ཚུལ་འདི་འཕྲལ་དུ་དྭངས་པ་ཞིག་དགོས་ཞེས་ངག་མ་ཞུ་རྒྱུ་དང་།",
    "ད་ང་ན་བ་ཡང་དྲག་འདུག།",
    "དེང་ལོ་ཆེན་རིན་ཆེན་བཟང་པོ་དགུང་ལོ་དགུ་བཅུ་གོ་དྲུག་བཞུགས་འདུག་ཅིང་།",
    "བྱ་རྒྱུ་ཡང་འུ་རང་མང་བ་ཙམ་འདུག།",
    "རྟ་ནག་པའི་དྲུང་རམས་པ་ཡེ་ཤེས་བསྟན་པ་བརྒྱད་བཅུ་གྱ་གྲངས་ཙམ་ཨེ་ཡིན་གཞན་མི་སྣང་ལགས་ཞུས་འདུག་པར།",
    "བདེ་བ་ཅན་གྱི་སྨྱོན་ལམ་ནི་འདོན་མི་དགོས་པ་འདུག།",
    "ཡང་སྒྲུབ་གནས་འདིར་དགེ་སློང་རང་སེམས་བཟང་པོའི་སྒོ་ནས།",
    "དེ་རྣམས་ཕྲ་རྒྱན་དུ་ཕུལ་ཆོག་པའི་རྟེན་བཞེང་ཞིག་བྱེད་དགོས་པ་འདུག།",
    "ཚེམས་གྲུལ་བ་རྡོག་དྲུག་འདུག་པ་རྣམས་ལ་སྐྲ་ཆོག་དང་།",
    "ཟླ་བ་ལྔ་པའི་ཚེས་བཅུ་བདུན་ནས་ཆབ་ཅུང་ཟད་བྲི་ཞིང་སྐུ་གཟུགས་ལྕི་བ་ཞིག་བྱུང་བར་ཉེ་གནས་ནས་ཨེམ་ཆི་ལ་ཕྱག་རྩ་ཞིག་གནང་ན་ཞུས་འདུག་པར།",
    "འུ་རང་བསྐོར་དུ་ཡོངས་པས་སུན་པོ་རང་འདུག།",
    "ཞབས་སྐྲངས་པ་འབམ་གྱི་ངོ་ཞིག་ཡིན་འདུག་པས་ཐོག་མར་གླང་ཆེན་བཅོ་བརྒྱད་པ་ཐུན་གསུམ་ཙམ་བཞེས།",
    "ངེད་གཉིས་གྲོས་ཤིག་ཀྱང་བྱེད་རྒྱུ་ཡོད་དེ་ཁོང་སླེབས་པ་མི་འདུག།"
  ]
}