    "དེ་ཐ་མལ་པར་འདུག་པར་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "རྒྱལ་པོ་འདི་གསོན་པོར་འདུག་བཞིན་དུ་ནི།",
    "དེ་དེ་ན་འདུག་པས་སྐྱེ་བོ་ཕལ་པོ་ཆེ་ཁ་འདོག་པར་བྱེད་དོ།",
    "དེ་ནས་དེ་ཡང་གསོལ་བ་འདེབས་པ་ལྷུར་བྱེད་ཅིང་འདུག་ལ།",
    "མགོ་བོ་གདུགས་ལྟར་འདུག་པ།",
    "དེ་གཉིས་ཀྱིས་སྟན་དེ་ལ་འདུག་བཞིན་དུ་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་མངོན་སུམ་དུ་བྱས་ཏེ།",
    "སྲང་དེ་ན་འགྱེལ་ཞིང་འདུག་སྟེ།",
    "བཅོམ་ལྡན་འདས་ལ་རྟོག་ཅིང་འདུག་གོ།",
    "སྐྲ་དང་ཁ་སྤུ་ནི་བྲེགས་ནས་ཞག་བདུན་ལོན་པ་ཙམ་དུ་གྱུར་སྤྱོད་ལམ་ནི་བསྙེན་པར་རྫོགས་ནས་ལོ་བརྒྱ་ལོན་པ་ལྟ་བུར་འདུག་པར་གྱུར།",
    "མེ་ལུས་ཀྱི་དབྱིབས་སུ་འདུག་པ་ལྟ་བུ་མེ་ལྕེ་མར་གྱིས་བཏབ་པ་ལྟ་བུ།",
    "མེ་ལུས་ཀྱི་དབྱིབས་སུ་འདུག་པ་ལྟ་བུ།",
    "མ་ཧེ་དང་ལྡན་པར་འདུག་སྟེགནོད་པ་མེད་ཅིང་ཚེར་མ་དཀྲུགས་ལ་བུ་གཅིག་པ་སྡུག་པ་ལ་བྱ་བ་བཞིན་དུ་རྒྱལ་སྲིད་བྱེད་དོ།",
    "རྒྱལ་པོ་མར་མེའི་འདབ་ན་རྒྱལ་པོ་ནོར་ཅན་གྱི་བུ་ཞེས་བྱ་བ་འདུག་པ་དེ་ལ་དེས་ཕོ་ཉ་བཏང་སྟེ།",
    "སློབ་དཔོན་ལ་ཡང་སློབ་དཔོན་གྱི་ཡོན་དབུལ་དགོས་པར་ཤེས་ནས་སེམས་ཤིང་འདུག་གོ།",
    "དེ་གཉིས་ཀྱང་མཆོད་སྦྱིན་བྱེད་པའི་གནས་དེར་འོངས་ནས་བྲམ་ཟེའི་གྲལ་དུ་སྐབས་བྱེ་བའི་སར་སྟན་ལ་འདུག་གོ།",
    "དེ་ནས་བྲམ་ཟེའི་ཁྱེའུ་བློ་གྲོས་བཟང་པོའི་ཕྱི་བཞིན་འབྲང་ཞིང་འདུག་པ་དེ་ཁྲོས་ནས།",
    "དེ་ནས་དེ་ནམ་མཁའ་ལ་འདུག་པ་སྐྱེ་བོ་ཕལ་པོ་ཆེས་མཐོང་ངོ།",
    "གྲོང་མིའི་བྱིས་པ་གཉིས་ཀྱང་བཅོམ་ལྡན་འདས་ཀྱི་ཐད་ནས་ཐག་མི་རིང་བ་ཞིག་ན་རྩེ་ཞིང་འདུག་སྟེ།",
    "དེ་ཁང་བཟངས་ཀྱི་སྟེང་དུ་འདུག་ནས།",
    "ཀྱེ་གོ་ཏ་མ་སྟན་དག་ཡོད་ཀྱིས་གལ་ཏེ་འདོད་པ་ལྟ་ན་འདུག་ཅིག་ཅེས་དེ་སྐད་ཙམ་དག་སྨྲ་བར་བྱའི་གུས་པར་སྨྲ་བར་མི་བྱའོ།",
    "གསེར་གྱི་ཁ་དོག་ཅན་མགོ་བོ་གདུགས་ལྟར་འདུག་པ་ལག་པ་རིང་བ་དཔྲལ་བའི་དབྱེས་ཆེ་བ་སྣ་མཐོ་བ་སྣ་ལེགས་པ་སྨིན་མ་སྟུག་པ་ཞིག་བཙས་ཏེདེའི་བཙས་སྟོན་རྒྱས་པར་བྱས་ནས་ཁྱེའུ་འདིའི་མིང་ཇི་སྐད་གདགས་ཞེས་མིང་འདོགས་པར་བྱེད་དེ།",
    "དེ་དག་སུས་ཟོས་པ་དེ་ཞག་བདུན་གྱི་བར་དུ་བརྒྱལ་ཏེ་འདུག་པར་འགྱུར་གྱིས་དེ་དག་ཁྱེད་མ་ཟ་ཞིག།",
    "དེ་ཐོས་པས་ཚོང་པ་རྣམས་ཀྱིས་བསྒྲིམས་ཏེ་བག་ཡོད་པར་འདུག་ནས།",
    "དེ་ནས་དེད་དཔོན་ཆེན་པོ་དབྱིག་དགའ་རྒྱ་མཚོ་ཆེན་པོའི་ནང་ན་འདུག་བཞིན་དུ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "བདག་གསོན་པོར་འདུག་བཞིན་དུ་ནི་འདི་རྣམས་རྒྱ་མཚོ་ཆེན་པོ་ལས་བསྒྲལ་བར་མི་ནུས་ལ།",
    "མི་འདི་ནི་ལྷགས་པས་ཀྱང་ཉེན་ལ་སྐྲག་ཅིང་ཡང་འདུག་གོ་སྙམ་དུ་རིག་ནས།",
    "ཀྱེ་མི་ཁྱེད་གཉིས་ལ་ངས་དོམ་ག་ལ་འདུག་པ་དེ་བསྟན་ཏོ་ཞེས་བྱས་ནས།",
    "དེ་ཕུག་ན་འདུག་པ་ཁོ་ན་རྔོན་པ་དེ་གཉིས་ལ་བསྟན་ནས།",
    "དོམ་ཞིག་ཀྱང་སེང་གེ་དེས་འཇིགས་ནས་སྔར་ཤིང་དེ་ལ་འཛེགས་ཏེ་འདུག་གོ།",
    "འདུག་པ་དང་ནི་ཉལ་བ་དང་།",
    "དེ་དེ་ན་འདུག་ཀྱང་ཁ་ཅིག་ནི་འཐོབ་ཁ་ཅིག་ནི་མི་འཐོབ་བོ།",
    "དེ་དེའི་ཉིན་པར་སྨྱུང་བར་འདུག་གོ།",
    "ཅང་མི་ཟེར་བར་འདུག་ནས།",
    "བུ་བདག་ཐོང་ཤིག་དང་ཕྱིན་ཅད་སུ་ལ་ཡང་སྦྱིན་པར་མི་བྱེད་ལ་ཕྱིན་ཅད་ཁྱིམ་འདིར་ཡང་མི་འདུག་གོ།",
    "དེ་ནས་དེ་དེ་ན་འདུག་པས་དགེ་སློང་རྣམས་ཀྱི་རྙེད་པའི་བར་ཆད་དུ་གྱུར་ཏོ།",
    "སུ་ནི་རྒུད་སུ་ནི་དར་སུ་ནི་ཕོངས་ཤིང་འདུག་སུ་ནི་ཉམ་ང་བར་གྱུར།",
    "མཐོང་ནས་ཀྱང་དྲང་སྲོང་ཀེ་ནེ་ཡས་ཁྱེད་ཅི་ཤོམ་ཞིང་འདུག་ཅེས་དྲིས་སོ།",
    "བཅོམ་ལྡན་འདས་ལ་མདུན་གྱིས་ཕྱོགས་ཤིང་ནུབ་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་ལ་མདུན་གྱིས་ཕྱོགས་ཤིང་བྱང་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་ལ་མདུན་གྱིས་ཕྱོགས་ཤིང་ཤར་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་ལ་མདུན་གྱིས་ཕྱོགས་ཤིང་ལྷོ་ཕྱོགས་སུ་ཁ་བལྟས་ཏེ་འདུག་གོ།",
    "དྲང་སྲོང་གངས་རིའི་འདབ་ན་ཆུ་ཀླུང་གང་གཱའི་འགྲམ་ན་དྲང་སྲོང་སེར་སྐྱ་འདུག་པའི་གནས་ནས་ཐག་མི་རིང་བ་ཞིག་ན།",
    "དགེ་སློང་དག་སྔོན་བྱུང་བ་འདས་པའི་དུས་ན་རི་ཞིག་ལ་དྲང་སྲོང་གཡོག་འཁོར་ལྔ་བརྒྱ་ལྔ་བརྒྱ་དང་ལྡན་པ་གཉིས་བརྟེན་ཅིང་འདུག་སྟེ།",
    "རི་ངོས་གཅིག་ན་ནི་དྲང་སྲོང་གཡོག་འཁོར་ལྔ་བརྒྱ་དང་ལྡན་པ་གཅིག་འདུག་གོ།",
    "ཕ་རོལ་གྱི་ངོས་ན་ནི་དྲང་སྲོང་གཡོག་འཁོར་ལྔ་བརྒྱ་དང་ལྡན་པ་གཅིག་འདུག་གོ།",
    "དེའི་ཚེ་མཉན་དུ་ཡོད་པ་ན་ཁྱིམ་བདག་མཛའ་ཞིང་བཤེས་ལ་གཅུགས་པ་གཉིས་ཤིག་འདུག་གོ།",
    "དགྲ་བཅོམ་པ་ཉིད་ཐོབ་ནས་འབར་བ་དང་ལམ་མེར་འདུག་པ་དང་ཆར་འབབ་པ་དང་གློག་འགྱུ་བའི་ཆོ་འཕྲུལ་བསྟན་ཏེ།",
    "བདག་དེ་དང་མྱུར་དུ་ཕྲད་པར་འགྱུར་བའི་ཐབས་ཇི་ཡོད་སྙམ་སྟེ་དེའི་ཐབས་སེམས་ཤིང་འདུག་གོ།",
    "གནས་དེ་ཉིད་ན་སྣ་ལ་གཏོགས་པ་ཞིག་འདུག་པ་དེས་བསམས་པ།",
    "དེ་རྒྱ་མཚོའི་འགྲམ་དུ་འགྲེང་བ་དང་དེས་དེར་ཡི་དགས་ལུས་ཆེ་ལ་རོ་སྨད་ནི་ཐ་མལ་པར་འདུག།",
    "རྐེད་པ་ཡན་ཆད་ནི་ལུས་གཉིས་སུ་འདུག་སྟེ།",
    "དགུན་གནས་བཅས་པ་རྣམས་ཀྱི་གོས་དང་རྙེད་པ་རྣམས་བཅད་དེ་དབྱར་གནས་བཅས་པ་རྣམས་ལ་ཕུལ་བའི་ལས་དེའི་རྣམ་པར་སྨིན་པས་ནི་རྐེད་པ་ཡན་ཆད་ལུས་གཉིས་སུ་འདུག་པར་གྱུར་ཏེལས་ལས་སྐྱེས་པའི་མི་རྣམས་དེའི་དྲུང་དུ་ལྷགས་ནས།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཚེ་དང་ལྡན་པ་དགའ་བྱེད་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་ས་ལ་འདུག་ན་ནི་དེ་ལ་ཐོག་ཐག་ནས་སྲོག་ཆགས་ཁབ་ཀྱི་མཆུ་ཅན་ཤ་སྟག་ཟ་ཞིང་འདུག་ལ་སྲོག་ཆགས་དེ་དག་ཟ་ཆེས་པས་དེ་གལ་ཏེ་ནམ་མཁའ་ལ་འཕགས་ན་ཡང་དེའི་ལུས་ཐམས་ཅད་མེར་འབར་ཏེརྒྱུ་དེས་ན་དེས་སྡུག་བསྔལ་དྲག་པ་དང་མི་བཟད་པ་དང་ཚ་བ་དང་ཡིད་དུ་མི་འོང་བ་མྱོང་ཞིང་འདུག་པ་ཞིག་མཐོང་ནས།",
    "དེའི་ཚེ་མཉན་དུ་ཡོད་པ་ན་བྲམ་ཟེ་རྒས་ཤིང་འཁོགས་ལ་གཏུགས་པ་ཞིག་འདུག་པ་ལས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་གོ།",
    "སྤྱོད་ལམ་ནི་བསྙེན་པར་རྫོགས་ནས་ལོ་བརྒྱ་ལོན་པ་ལྟ་བུར་འདུག་པར་གྱུར།",
    "བྲམ་ཟེ་དེ་ནི་ཞིང་དེ་ཉིད་ན་ཞིང་ལས་བྱེད་ཅིང་འདུག་པ་ལས།",
    "བཅོམ་ལྡན་འདས་གཤེགས་པ་ལ་སྡོད་ཅིང་འདུག་གོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དེའི་བསམ་པ་དང་བག་ལ་ཉལ་དང་ཁམས་དང་ཤེས་པ་དང་རང་བཞིན་ཐུགས་སུ་ཆུད་ནས།",
    "བསྲེགས་ནས་དེ་དུར་ཁྲོད་དེ་ཉིད་ན་འདུག་ཅིང་མྱ་ངན་བྱེད་ལ་སྡུག་བསྔལ་ཞིང་སྨྲེ་སྔགས་འདོན་ཏེ་བྲང་རྡུང་ཞིང་ཕ་ཅིག་ཕ་ཅིག་ཅེས་ཆོ་ངེས་འདེབས་ཏེ་ཕན་ཚུན་འཁྱམ་ཞིང་འདུག་གོ།",
    "དེས་བལྟས་ན་བུ་དེ་དུར་ཁྲོད་ན་འདུག་ཅིང་ཤིན་ཏུ་མྱ་ངན་བྱེད་ལ་སྡུག་བསྔལ་ཞིང་སྨྲེ་སྔགས་འདོན་ཏེ།",
    "ཕན་ཚུན་དུ་འཁྱམ་ཞིང་འདུག་པ་མཐོང་ངོ།",
    "བྲང་རྡུང་ཞིང་ཕ་ཅིག་ཕ་ཅིག་ཅེས་ཆོ་ངེ་འདོན་ཏེ་ཕན་ཚུན་འཁྱམ་ཞིང་འདུག་གོ།",
    "འཇིགས་བྱེད་མའི་ཚལ་རི་དགས་ཀྱི་ནགས་ན་འདུག་གོ་ཞེས་ཐོས་སོ།",
    "དེ་དེ་ན་འདུག་པ་ན་ཁྱིམ་བདག་དེ་ཡང་ཐད་དུ་འོངས་ནས་ཀོ་ཀ་ལི་ཀས་ཁྱིམ་བདག་དེ་ལ་དྲིས་པ།",
    "དེ་ནགས་ཁྲོད་ཅིག་ཏུ་གནས་བཅས་ཏེ་ཡལ་ག་དང་ལོ་མའི་སྤྱིལ་པོ་ཕུབ་ནས་འདུག་གོ།",
    "སེམས་ནི་ཀུན་ནས་དཀྲིས་ཤིང་འདུག།",
    "དེས་དེའི་ཡུལ་ན་གནས་པའི་སྐྱེ་བོ་མང་པོ་ཇི་སྙེད་ཡོད་པ་དེ་སྙེད་ལ་བྱམས་པའི་སེམས་ཀྱིས་ཁྱབ་པར་བྱས་ཏེ་འདུག་ནས།",
    "དེས་ཡུལ་ན་གནས་པའི་སྐྱེ་བོ་མང་པོ་ཇི་སྙེད་ཡོད་པ་དེ་སྙེད་ལ་བྱམས་པའི་སེམས་ཀྱིས་ཁྱབ་པར་བྱས་ཏེ་འདུག་པ་དེའི་མཐུས་ན།",
    "དེས་ཚོང་པ་དེ་དག་ཅི་བྱ་གཏོལ་མེད་པར་འདུག་པ་མཐོང་ནས་སྨྲས་པ།",
    "སུ་ནི་རྒུད་སུ་ནི་དར་སུ་ནི་ཕོངས་ཤིང་འདུག་སུ་ནི་ཉམ་ང་བར་གྱུར།",
    "ཕྱིན་ཅད་སྐྱེ་བོ་མང་པོའི་ནང་དུ་འདུག་པར་མི་དགའོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་སྔོན་གླང་པོ་ཆེར་གྱུར་པའི་ལྷའི་བུའི་བསམ་པ་དང་བག་ལ་ཉལ་དང་ཁམས་དང་རང་བཞིན་ཐུགས་སུ་ཆུད་ནས།",
    "པད་མ་དཀར་པོ་རྣམས་ཀྱིས་གང་བར་འདུག་ལ།",
    "གྲལ་དཔོན་གྱི་སྤྱན་སྔར་འདུག་གོ།",
    "འབར་བ་དང་ལམ་མེར་འདུག་པ་དང་།",
    "མཐོང་ནས་ཀྱང་དེ་དག་སྡུག་བསྔལ་ཆེན་པོ་སྐྱེས་ཏེ་ལྷ་ལ་གསོལ་བ་འདེབས་ཤིང་འདུག་གོ།",
    "མགོ་བོ་གདུགས་ལྟར་འདུག་པ་ལག་པ་རིང་བ།",
    "མེ་ལུས་ཀྱི་དབྱིབས་སུ་འདུག་པ་ལྟ་བུ།",
    "དེ་ཉིད་དུ་འདུག་སྟེ་དེས་དེ་ལ་ཁ་ཟས་ཀྱི་བགོ་བཤའ་བྱས་ནས།",
    "མེ་ལུས་ཀྱི་དབྱིབས་སུ་འདུག་པ་ལྟ་བུ་མེ་ལྕེ་མར་གྱིས་བཏབ་པ་ལྟ་བུ།",
    "དེ་ནས་ཁྱེའུ་མི་སྡུག་པ་སྟན་དེ་ཉིད་ལ་འདུག་བཞིན་དུ་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་མངོན་སུམ་དུ་བྱས་ཏེ་དེས་བདེན་པ་མཐོང་ནས་བསམས་པ།",
    "ཁྱིམ་བདག་སེར་སྣ་ཅན་འཇུངས་པ་ཡོ་བྱད་ཀུན་དུ་འཛིན་པ་ཞིག་གནས་པ་ལས་ཕྱི་ཞིག་ན་དེ་ཁྱིམ་ན་འདུག་པ་དང་།",
    "འབར་བ་དང་ལམ་མེར་འདུག་པ་དང་ཆར་པ་འབབ་པ་དང་གློག་འགྱུ་བའི་ཆོ་འཕྲུལ་རྣམས་བསྟན་ཏོ།",
    "ཆུ་ཀླུང་ཁང་ལྡན་གྱི་འགྲམ་དུ་ཕྲུ་མ་བཏབ་སྟེ་འདུག་གོ།",
    "དེས་ཆུ་ཀླུང་ཁང་ལྡན་གྱི་འགྲམ་དུ་ཕྲུ་མ་བཏབ་སྟེ་འདུག་གོ་ཞེས་ཐོས་ནས།",
    "དེས་ཀྱང་ཆུ་ཀླུང་ཁང་ལྡན་གྱི་འགྲམ་དུ་ཕྲུ་མ་བཏབ་སྟེ་འདུག་ནས།",
    "དེ་གཉིས་དེ་ན་འདུག་ཅིང་དུས་དུས་སུ་སྐྱེ་བོ་མང་པོ་ཁ་འདོག་པར་བྱེད་དེ།",
    "སྐད་ཅིག་ཙམ་ཡང་གཅིག་མེད་པར་གཅིག་འདུག་མི་ཕོད་དོ།",
    "མི་རིགས་པ་མ་བྱེད་པར་འདིར་འདུག་ཅིག་ཅེས་བྱས་སོ།",
    "སུ་ནི་ཕོངས་ཤིང་འདུག།",
    "དེ་གསད་པས་འཇིགས་སྐྲག་ནས་ཕན་ཚུན་ལྟ་ཞིང་འདུག་སྟེ།",
    "ཕ་མ་གཉིས་ཀྱི་མདུན་དུ་འབར་བ་དང་ལམ་མེར་འདུག་པ་དང་ཆར་འབབ་པ་དང་གློག་འགྱུ་བའི་ཆོ་འཕྲུལ་རྣམས་བསྟན་ནས་ས་ལ་བབས་ཏེ།",
    "དེ་ཐོས་ནས་ཕ་མ་གཉིས་སྟན་དེ་ཁོ་ན་ལ་འདུག་བཞིན་དུ།",
    "སུ་ནི་ཕོངས་ཤིང་འདུག།",
    "སུ་ནི་ཕོངས་ཤིང་འདུག།",
    "ཡུལ་མི་ཁ་མི་མཁས་ཤིང་གཡེམ་པ་ཞིག་འདུག་ནས།",
    "སྐྱེ་བོ་མང་པོ་གླགས་ཚོལ་ཞིང་འདུག་པ་ལས།",
