    "ལུས་ལས་གཞན་མ་ཡིན་པའི་ཕྱིར་ལུས་ཀྱི་རང་གི་བདག་ཉིད་བཞིན་ནོ།",
    "དེས་ནི་འདུ་བྱེད་སྐད་ཅིག་རེ་རེར་འཇིག་པའི་ངང་ཅན་རྣམས་ལ་གནས་པ་མེད་པས།",
    "གང་གི་ཚེ་བདག་རྟག་པ་དེ་མི་རིགས་པ་དེའི་ཚེ་ངེས་པར་འདིས་འདུ་བྱེད་ཀྱི་རྒྱུན་སྐད་ཅིག་རེ་རེར་འཇིག་པ་ཁོ་ན་ལ་ལས་དང་པས་འབྲས་བུ་ལ་སོགས་པ་ཐམས་ཅད་ཁས་བླང་བར་བྱའོ།",
    "འདིར་སྨྲས་པ་གལ་ཏེ་བདག་རང་གི་ངོ་བོས་གྲུབ་པར་མི་འགྱུར་ན་ནི་དེའི་ཚེ་ལུས་ཀྱི་གཡོ་བ་བསྐུམ་པ་དང་བརྐྱང་བ་ལ་སོགས་པ་རྣམས་ཀྱི་འཇུག་པ་པོ་གང་ཞིག་འགྱུར།",
    "དེའི་ཕྱིར་གདོན་མི་ཟ་བར་ཤིང་རྟའི་སྐུལ་བ་པོ་ལྷ་སྦྱིན་ལྟར་ལུས་ཀྱི་གཡོ་བའི་རྒྱུ་ནང་གི་བྱེད་པའི་སྐྱེས་བུ་འགའ་ཞིག་ཁས་བླང་བར་བྱའོ།",
    "རེག་དང་མི་ལྡན་དངོས་པོ་ལས།",
    "ཤིང་རྟ་ནི་རེག་པ་དང་མི་ལྡན་པའི་དོན་འགས་ཀྱང་བསྐུལ་བར་མི་ནུས་ཏེ།",
    "རེག་པ་དང་ལྡན་པ་དེ་ཁོ་ནས་དེ་བསྐུལ་བའི་ཕྱིར་རོ།",
    "ཁྱེད་ཅག་གིས་ཡོངས་སུ་བརྟགས་པའི་བདག་ཀྱང་རེག་པ་དང་མི་ལྡན་པ་ཞིག་སྟེ།",
    "དུས་ལྟར་ལུས་མེད་པའི་ཕྱིར་ཅི་ལ་ཡང་མི་རེག་ཅིང་དོན་འགའ་ཞིག་གིས་རེག་པ་ཡང་མ་ཡིན་ནོ།",
    "གང་གི་ཚེ་འདི་དེ་ལྟར་ཡིན་པ་དེའི་ཚེ།",
    "གང་ལ་ལུས་ཀྱི་གཡོ་བའི་རྒྱུ་ཉིད་ཀྱིས་འདི་ཡོད་པ་ཉིད་དུ་རྗེས་སུ་དཔོག་པར་འགྱུར་བ་རེག་པ་དང་མི་ལྡན་པའི་དངོས་པོ་འདི་ལས་བསྐུལ་བ་སྟེ།",
    "གཞན་ཡང་བདག་འདི་ནི་ཕྱོགས་མེད་པའི་ཕྱིར་རེག་པ་དང་མི་ལྡན་ནོ།",
    "གལ་ཏེ་དེ་ཁོ་ན་ལྟར་སེམས་ལ་ཡང་ལུས་ཀྱི་གཡོ་བའི་རྒྱུ་ཉིད་མི་རིགས་པའི་ཕྱིར་ཁྱོད་ལ་ཡང་ཉེས་པ་འདིར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "ཁོ་བོས་ནི་སེམས་རེག་པ་དང་མི་ལྡན་པ་ཉིད་དུ་ཁས་མ་བླངས་སོ།",
    "ཁྱོད་ཀྱིས་ནི་དེ་ལྟར་བདག་རེག་པ་དང་ལྡན་པར་ཁས་མ་བླངས་པས་མི་མཚུངས་སོ།",
    "གནོད་པར་དོགས་པ་མེད་པའི་རྡོ་རྗེ་ནི་ཤིང་གི་སྲིན་བུ་ལས་ཡོངས་སུ་བསྲུང་བར་མི་རྩམ་མོ།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་བདག་རྟག་ན།",
    "ཁྱོད་ཀྱི་ལུས་ཀོ་ཅིས་མི་རྟག།",
    "དེའི་ཕྱིར་སྐྱེ་བ་དྲན་པ་ཡོད་པས་བྱས་པའི་བདག་རྟག་པ་ཉིད་དུ་ཡོངས་སུ་བརྟགས་པ་ལྟར་དེ་དག་གིས་ལུས་རྟག་པ་ཉིད་དུ་ཡང་བརྟག་པར་བྱ་དགོས་ན་འདི་ནི་དེ་ལྟར་ཡང་མ་ཡིན་པས་དེ་ཡོད་པ་མ་ཡིན་ནོ།",
    "རྒྱུའི་ཁྱད་པར་གྱིས་གསལ་བར་གྱུར་པ་འདུ་བྱེད་ཀྱི་རྒྱུན་ནི་མི་རྟག་པ་ཁོ་ནར་ཡོད་ན་ནི་དེའི་ཉེ་བར་ལེན་པ་ཅན་བཏགས་པར་ཡོད་པའི་བདག་གི་སྐྱེ་བ་རྗེས་སུ་དྲན་ནོ་ཞེས་བྱ་བར་རིགས་སོ།",
    "དངོས་པོ་རྣམས་ནི་རང་གི་མཚན་ཉིད་ཀྱིས་མ་གྲུབ་སྟེ་དེ་རྣམས་ལ་རྣམ་པ་དེ་ལྟ་བུའི་རྐྱེན་ཉེ་བར་ལྷགས་པ་ཡོད་དང་གཞན་དུ་གྱུར་པ་ཉིད་མི་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དངོས་པོ་རང་གི་མཚན་ཉིད་ཀྱིས་མ་གྲུབ་པའི་རྒྱུ་ཅན་བྱ་བའི་ཁྱད་པར་བསམ་གྱིས་མི་ཁྱབ་པ་ཡོངས་སུ་བརྟག་པར་བྱའོ།",
    "འདི་ལྟར་འདམ་བཞིན་དུ་ཞོའི་སྣོད་ཁང་པའི་ནང་ན་གནས་པ་དག་ལ་ཐོག་རྩྭ་ཆེས་མང་པོས་གཡོགས་པའི་སྟེང་ན་གནས་པའི་ཕུ་རོན་སྐྱ་བོའི་རྐང་རྗེས་དམིགས་མོད་ཀྱི།",
    "གཞན་དག་གིས་དེ་མི་སླུ་བ་ཉིད་དུ་ཁས་བླངས་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་སྐྱེ་བ་དྲན་པ་ལྟར་རྨ་དང་བཅས་པའི་ལུས་གཞན་གྱི་རྒྱུ་ཅན་གྱི་ལུས་སྔོན་བྱས་པའི་རྨས་ཉེ་བར་མཚོན་པ་རྣམ་པ་དེ་ལྟ་བུའི་ལས་ཀྱི་བྱེ་བྲག་གི་རྐྱེན་ཅན་ཉེ་བར་སྐྱེའོ་ཞེས་བྱ་བ་མི་སྲིད་པ་མ་ཡིན་ནོ།",
    "ལུས་ཀྱང་རྟག་པ་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཡང་ཇི་ལྟར་བདག་འདིས་སྐྱེ་བ་དྲན་ནོ་ཞེས་བྱ་བར་རྟོག་པ་གལ་ཏེ་རང་གི་ངོ་བོ་ཁོ་ནས་ཡིན་ན་ནི་དེ་མི་རིགས་ཏེ།",
    "དེ་ནི་མི་རྟོག་པའི་རང་གི་ངོ་བོ་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོ་བཏང་བར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་བློ་ལ་སོགས་པ་རྣམས་ནི་བདག་གི་ཡོན་ཏན་ཡིན་ཞིང་དེ་རྣམས་དང་ལྡན་པས་བདག་ཡོན་ཏན་གྱི་རྗེས་སུ་མཐུན་པར་འཇུག་ཅིང་དངོས་པོ་རྣམས་ཀྱང་རང་བཞིན་མི་འདོར་བ་ཡིན་ལ།",
    "རྣམ་པར་འགྱུར་བ་དང་ལྡན་པ་རྣམས་ལ་ནི་རང་གི་ངོ་བོ་ཡོད་པ་ཡང་མ་ཡིན་པས་ཁྱོད་ཀྱི་བདག་རང་བཞིན་མེད་དེ།",
    "རི་མོ་ལ་སོགས་པ་བཞིན་དུ་རྣམ་པར་འགྱུར་བ་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "གཞན་ཡང་བདག་འདི་ཇི་ལྟར་སེམས་པ་ཅན་ཉིད་དང་ལྡན་པས་སེམས་པ་དེ་བཞིན་དུ་བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་པ་དང་ལྡན་པས་སྔར་གྱི་རང་གི་ངོ་བོ་ཉམས་པའི་ཕྱིར་ཁྱད་པར་དེ་དང་དེ་འཐོབ་པར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་བདག་གི་ཡོན་ཏན་འདི་རྣམས་ཐ་དད་པར་བགྲང་བར་མི་འགྱུར་རོ།",
    "འང་གི་སྒྲས་ནི་བྱེད་པ་པོ་ཉིད་དང་བྱ་བ་པོ་ཉིད་དང་གཅིག་ཉིད་ལ་སོགས་པ་ཐམས་ཅད་སེལ་བར་བྱེད་དོ།",
    "ཡང་གཞན་དག་ནི་གང་གི་ལྟར་ན་སྐྱེས་བུ་སེམས་པ་ཅན་མ་ཡིན་པ་དེ་ལ་ཉེས་པ་འདིར་འགྱུར་གྱི།",
    "ཁོ་བོ་ཅག་གི་ལྟར་ན་ནི་སྐྱེས་བུ་ཤེས་པ་ཡོད་པའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་མི་འདོད་པ་ཅི་ཡང་མེད་དོ་ཞེས་སྨྲའོ།",
    "བུད་ཤིང་གིས་དོན་ཡོད་མི་འགྱུར།",
    "འདི་གང་གི་ཚེ་མིག་ལ་སོགས་པ་བྱེད་པར་གྱུར་བ་རྣམས་ཀྱི་འཇུག་པ་དག་གཟུགས་ལ་སོགས་པའི་དོན་རྣམས་ལ་འབབ་པ་དེའི་ཚེ་གཟུགས་ལ་སོགས་པའི་བློ་གཟུགས་ལ་སོགས་པའི་རྣམ་པས་རྗེས་སུ་བསྒྱུར་བ་རྣམས་ཉེ་བར་སྐྱེ་ཞིང་བློས་ཞེན་པར་བྱས་པའི་དོན་དེ་ཡང་སྐྱེས་བུས་སེམས་པར་བྱེད་དོ།",
    "ཤེས་པ་ཡོད་པ་ཉིད་ཀྱང་ཡུལ་རྟོགས་པའི་རང་གི་ངོ་བོ་ཡིན་ལ་སྐྱེས་བུ་དེ་ཡང་དེ་ལས་ཐ་མི་དད་པའི་རང་གི་ངོ་བོ་དང་།",
    "སྐྱེས་བུའི་རང་གི་ངོ་བོ་ལས་ཐ་མི་དད་པར་གནས་པའི་ཕྱིར་ཤེས་པ་ཡོད་པ་ཉིད་ཀྱང་རྟག་ཏུ་ཉེ་བ་ཡིན་ནོ།",
    "གང་གི་ཚེ་ཇི་སྐད་སྨྲས་པའི་ཚུལ་ལ་ལྟོས་པ་མེད་པ་ཁོ་ནས་ཤེས་པ་ཡོད་པ་ཉིད་རྟག་པ་ཡོད་པ་དེའི་ཚེ་ནི་བྱེད་པ་ལོག་པར་འགྱུར་བ་སྟེ།",
    "གང་གི་ལྟར་ན་བུད་ཤིང་མེད་པར་མེ་མི་འབྱུང་ཞིང་།",
    "གང་གི་ཕྱིར་འདི་དེ་ལྟར་ཡིན་པ།",
    "ཤེས་པ་ཡོད་པ་ལ་ཚུལ་གཉིས་རྟོག་ན་ཁྱོད་ཀྱིས་ཤེས་པ་ཡོད་པ་ལས་གཞན་དུ་སྟེ་ཐ་དད་པ་ཉིད་དུ་ཤེས་པ་ཡོད་པའི་ཁམས་ཏེ།",
    "སྲོག་ཆགས་ཐམས་ཅད་ལ་ལུས་རེ་རེ་ཞིང་ཡོད་པའི་བདག་ཉིད་ནི་ནམ་མཁའ་ལྟར་ཁྱབ་པ་ཡིན་ལ།",
    "ཡོད་ཀྱང་བདག་གི་ཕྱོགས་རྡུལ་ཕྲ་རབ་ཙམ་ཉིད་ལ་ལྡན་པ་ཞིག་སྟེ།",
    "དེས་ན་ཡིད་དང་སྦྱར་ནས་སྐྱེས་བུས་དེ་དང་ཡུལ་ཐ་མི་དད་པ་ཅན་གྱི་ཤེས་པ་ཡོད་པ་སྐྱེད་པར་བྱེད་དེ་དེའི་ཕྱིར་ཁོ་བོ་ཅག་གི་ཕྱོགས་ལ་ཇི་སྐད་སྨྲས་པའི་སྐྱོན་གྱི་སྐབས་མེད་དོ་ཞེས་སྨྲའོ།",
    "གང་གི་ཕྱིར་ཁྱོད་ཀྱིས་སྐྱེས་བུ་ནམ་མཁའ་ལྟར་ཤིན་ཏུ་ཆེ་བ་འདིའི་ཤེས་པ་ཡོད་པ་ཡིད་ཙམ་ཁས་ལེན་ལ།",
    "རྡུལ་ཕྲ་རབ་ཙམ་གྱི་ལན་ཚྭ་དང་འབྲེལ་པས་གང་གཱའི་ཀླུང་གི་ཆུ་ལན་ཚྭ་དང་བཅས་སོ་སྙམ་དུ་བསམ་པར་ནུས་པ་ནི་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་བདག་ལྟར་གཞན་ཡང་བདག་གི་བདག་ལ་ངར་འཛིན་པར་འགྱུར་ན་ནི།",
    "གཞན་གྱི་ལུས་ལ་གཞན་གྱི་བདག་གིས་བདག་གི་བདག་བསྒྲིབས་པར་རིགས་པ་ཡང་མ་ཡིན་ནོ།",
    "གཞན་གྱི་བདག་གི་ཡུལ་ནི་བདག་གི་བདག་མེད་པ་ནི་མ་ཡིན་ཏེ།",
    "ཡུལ་མཚུངས་པའི་ཕྱིར་རང་གི་བདག་གི་ངོ་བོ་ལྟར་རང་གི་བདག་གིས་གཞན་གྱི་བདག་ལ་སྒྲིབ་པ་ཡོད་པ་མ་ཡིན་པས་གཞན་གྱི་བདག་ཀྱང་ངར་འཛིན་པའི་ཡུལ་ཉིད་དུ་ཐལ་བར་འགྱུར་ན།",
    "རེག་པ་དག་གོ།",
    "དེ་ལྟར་ན་རང་བཞིན་གྱི་རྣམ་པར་འགྱུར་བའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་རྣམ་པར་འགྱུར་བ་མཐའ་དག་གི་འཇུག་པར་བྱེད་པ་ནི་ཡོན་ཏན་གསུམ་ཡིན་ནོ།",
    "ཤེས་པ་ཡོད་པ་མ་ཡིན་པ་ཉིད་དོ་ཞེས་བྱ་བ་རྒོལ་བ་མཐའ་དག་གི་བསམ་པ་ཡིན་པ་དེ་དག་དང་སྨོན་པ་རྣམས་ལ་ཁྱད་པར་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་དངོས་པོའི་དེ་ཉིད་ལ་མཁས་པ་རྣམས་ཀྱིས་མཐོང་ངོ།",
    "དེ་ནི་ཕྱིན་ཅི་ལོག་གི་རྣམ་པར་ཤེས་པ་དེ་དོན་ཇི་ལྟ་བ་བཞིན་མི་རྟོགས་ཤིང་ཕྱིན་ཅི་ལོག་ཏུའང་ངེས་པར་འཛིན་པར་བྱེད་ལ།",
    "ཡོད་པ་མ་ཡིན་པའི་དོན་གཏམ་པར་ཡང་བྱེད་པས་ན་སྨྱོན་པ་རྣམས་དང་མཚུངས་པ་ཁོ་ན་ཞིག་གོ་སྙམ་མོ།",
    "དེ་ལྟར་ན་རེ་ཞིག་ཡོན་ཏན་རྣམས་བྱེད་པ་པོ་ཉིད་དུ་མི་རིགས་སོ།",
    "དེ་ནི་ཐམས་ཅད་དུ་སོང་བ་མ་ཡིན་པའི་ཕྱིར་རྐང་པ་འདེགས་པ་དང་འཇོག་པའི་མཚན་ཉིད་ཅན་གྱི་བྱ་བས་ཡུལ་སྔ་ཕྱི་གཉིས་གཏོང་བ་དང་ལེན་པའི་ཕྱིར་བྱ་བ་དང་བཅས་པར་རིགས་སོ།",
    "གལ་ཏེ་འདི་ཐམས་ཅད་དུ་སོང་བ་ཉིད་དུ་རྟོག་ན་དེའི་ཚེ་གང་དུ་འགྲོ་བར་གྱུར་པ་འདི་ཉེ་བར་མི་གནས་པ་གང་ཞིག་ན་ཡོད།",
    "གང་གི་ཕྱིར་འདི།",
    "ཀུན་ཏུ་སོང་ལ་བྱ་བ་མེད།",
    "ས་ཕྱོགས་དང་ལྡན་པའི་ལྷ་སྦྱིན་ལ་ཁྱབ་བདག་མ་ཡིན་པ་ཉིད་ཡོད་དང་རིགས་པར་འགྱུར་གྱི་ཐམས་ཅད་དུ་སོང་བ་ལ་ནི་མ་མནན་པའི་ཕྱོགས་འགའ་ཡང་ཡོད་པ་མ་ཡིན་པ་ཉིད་ནས་བྱ་བ་དང་ལྡན་པ་ཉིད་མི་རིགས་སོ།",
    "ཀུན་ཏུ་སོང་ལ་བྱ་བ་མེད།",
    "དེ་དག་གི་འབྲས་བུ་མེད་པ་ཡིན་དང་།",
    "བདག་མེད་ལ་ཁྱོད་ཀྱིས་མི་དགའ།",
    "གལ་ཏེ་བདག་རྟག་པ་ཡོད་པ་མ་ཡིན་ན་རྒྱུ་གང་གིས་ཁྱོད་བདག་མེད་པ་ལ་མི་དགའ་སྟེ།",
    "ཡང་གལ་ཏེ་བདག་ཅེས་བྱ་བ་འདི་འགའ་ཞིག་མེའི་ཚ་བ་ཉིད་ལྟར་རང་གི་ངོ་བོས་ཡོད་ན་ནི་དེའི་ཚེ་དེ་རང་གི་ངོ་བོ་དེས་ཡོད་པའི་ཕྱིར་ངེས་པར་དམིགས་པ་ཞིག་ན་དེ་ལྟར་ཡང་མ་ཡིན་ནོ།",
    "འདི་ལྟར་དེའི་རྒོལ་བ་དག་གིས།",
    "ལ་ལར་ཀུན་ཏུ་སོང་བར་མཐོང་།",
    "དེ་ལ་ཁ་ཅིག་དག་གིས་ནི་ལུས་རེ་རེ་ཞིང་ཐ་མི་དད་པའི་བདག་ཐམས་ཅད་དུ་སོང་བར་རྟོགས་སོ།",
    "གཞན་དག་གིས་ནི་འགྲོ་བ་མཐའ་དག་གི་བདག་ཟླ་བ་ལྟར་གཅིག་ཁོ་ནར་རྟོགས་སོ།",
    "དེ་ཡང་ཐམས་ཅད་དུ་སོང་བ་ཞིག་སྟེ་དེ་ལྟར་ན་ལ་ལར་ཀུན་ཏུ་སོང་བར་མཐོང་ངོ།",
    "འདི་ལྟར་ལ་ལ་དག་བ་གིས་ནི་སྦྲང་བུ་མཆུ་རིངས་དང་གྲོག་མ་དང་གླང་པོ་ཆེ་ལ་སོགས་པ་རྣམས་ལ་བདག་ལུས་ཙམ་ཞིག་ཡིན་པའི་ཕྱིར་ཞུམ་པ་དང་རྒྱས་པ་ཉིད་དུ་རྟོགས་སོ།",
    "མུ་སྟེགས་ཅན་རྣམས་ལ་ཡང་དེ་ལྟར་ལྟ་བ་ཐ་དད་པར་མི་འགྱུར་བ་ཞིག་ན་འདི་ཐམས་ཅད་ཡོད་པ་ཡང་མ་ཡིན་པས་བདག་རང་གི་ངོ་བོས་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཡང་གལ་ཏེ་བདག་རང་གི་ངོ་བོས་ཡོད་ན་ནི།",
    "དེས་ན་གང་གི་བདག་རྟག་པ།",
    "བདག་གིར་འཛིན་པ་རྣམ་པ་ཐམས་ཅད་དུ་ཟད་པར་བྱ་བའི་ཕྱིར་གྲོལ་བ་ཁས་བླངས་ཏེ།",
    "དེའི་ཕྱིར་བདག་གི་དེ་ཁོ་ན་ཉིད་རིག་པ་ངེས་པས་བདག་ཏུ་འཛིན་པ་སྤངས་པ་ལས་མྱ་ངན་ལས་འདའ་བར་འགྱུར་རོ་ཞེས་བྱ་བ་ཡང་བརྫུན་ཏེ་དེ་ཡང་ངར་འཛིན་པ་ཡོད་པའི་ཕྱིར་རོ།",
    "བདག་ཏུ་འཛིན་པ་འཇུག་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཐལ་བའི་སྔ་རོལ་གྱི་གནས་སྐབས་ན་ཡང་དེའི་རང་བཞིན་དེ་ཁོ་ན་ཡིན་པར་རིགས་སོ།",
    "དེའི་ཕྱིར་དོན་འདི་མཐོང་བ་ཕྱིན་ཅི་ལོག་གི་དམིགས་སུ་ཟིན་ཀྱང་དེ་ལྟར་ཁས་བླང་བར་མི་ནུས་སོ།",
    "རབ་རིབ་ཅན་གྱིས་མཐོང་བ་ཡོད་པ་མ་ཡིན་པའི་སྐྲ་ཤད་དང་སྦྲང་བུ་ལ་སོགས་པའི་དོན་སྒོ་འདོགས་པ་ཡང་དེ་ལྟར་ཁས་བླངས་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་བདག་རང་གི་ངོ་བོས་གྲུབ་པ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བར་གནས་སོ།",
    "གལ་ཏེ་བདག་མེད་ན་དེའི་ཚེ་སྐད་ཅིག་རེ་རེ་ལ་འཇིག་པའི་ངང་ཅན་གྱི་འདུ་བྱེད་རྣམས་སྐྱེས་མ་ཐག་ཏུ་འཇིག་པའི་ཕྱིར་ཆད་པར་ལྟ་བར་འགྱུར་ལ།",
    "ཀྱང་གི་སྒྲས་ནི་བདེ་བ་ལ་སོགས་པ་དང་འདོད་ཆགས་ལ་སོགས་པ་རྣམས་ཀྱང་མི་འགྱུར་བ་ཞིག་གོ།",
    "ཡང་ན་བདག་ཡོད་དུ་ཆུག་མོད་འདིའི་འགྲོ་བ་འཇུག་པའི་རྒྱུ་ཉིད་ནི་མི་རིགས་སོ།",
    "ཡང་གལ་ཏེ་འདི་དག་ཐམས་ཅད་བདག་གི་བྱེད་པ་པོ་ཅན་ཉིད་ཡིན་ན་ནི།",
    "གཟུགས་འདི་ལ་འཇུག་པ་དེ་ཁོ་ན་ལས་ཡིན་པར་རག་མོད།",
    "ཅི་མིག་ལ་སོགས་པ་རྣམས་རང་གི་ཡུལ་ལ་འཇུག་པ་ལ་ཉེ་བར་བསྟན་པ་ལ་ལྟོས་པ་ཞིག་གམ་དེ་མ་ཡིན་ནོ།",
    "དེ་ལྟར་ཡང་མ་ཡིན་ཏེ་དངོས་པོ་ལས་ཐ་དད་པར་འཛིན་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་བཀག་ཟིན་པའི་ཕྱིར་ཡང་རང་གི་མཚན་ཉིད་ཀྱིས་གྲུབ་པའི་དུས་ལ་འཇུག་པ་དང་ལྡོག་པའི་རྒྱུ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "གཞན་ཡང་དུས་གསུམ་པོ་གང་དག་དུས་ཀྱི་ཁྱད་པར་གྱི་ངོ་བོར་རྣམ་པར་གཞག་པ་དེ་དག་ཀྱང་ལུས་ཅན་མ་ཡིན་པ་ཉིད་ཀྱིས་རང་བཞིན་ལས་ངེས་པར་མི་ནུས་པའི་ཕྱིར་རང་གི་ངོ་བོས་རྣམ་པར་གཞག་པར་མི་ནུས་ཀྱི་དེ་དག་གིས་བསྙད་པར་བྱ་བའི་དངོས་པོའི་ཁྱད་པར་བུམ་པ་ལ་སོགས་པའི་སྒོ་ནས་ནི་རྣམ་པར་གཞག་པར་ནུས་སོ།",
    "དེ་དག་ནི་དངོས་པོ་ལས་ཐ་དད་པའི་རང་བཞིན་ཡིན་ཞིང་ཚོར་བ་ལ་སོགས་པ་ལྟར་ཉམས་སུ་མྱོང་བའི་རྣམ་པ་མ་ཡིན་ལ།",
    "དེར་མ་འོངས་པ་དང་རྒལ་བ་དག་གིས་མ་འོངས་པ་དང་འདས་པའི་དུས་གཉིས་རྣམ་པར་འཇོག་པ་ནི་གཙོ་བོ་མ་ཡིན་ནོ།",
    "གཉིས་གཉིས་ལ་མ་ལྟོས་པར་རེ་རེ་མེད་པའི་ཕྱིར་རོ།",
    "མ་འོངས་པ་ནི་མ་འོངས་པ་ལས་ཡིན་ལ་མ་འོངས་པའི་རང་གི་ངོ་བོས་དེ་གང་དུ་མ་འོངས་པ་འདས་པ་དང་ད་ལྟར་གྱི་དུས་གཉིས་པོ་དེར་གདོན་མི་ཟ་བར་འགྱུར་དགོས་སོ།",
    "གང་གི་ཚེ་དེ་ལྟར་མ་འོངས་པའི་བུམ་པ་ལ་ད་ལྟར་བ་དང་འདས་པ་གཉིས་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་ད་ལྟར་བ་དང་འདས་པ་གཉིས་ཀྱང་མ་འོངས་པར་མ་འོངས་པས་དེ་གཉིས་ཀྱང་མ་འོངས་པར་འགྱུར་རོ།",
    "མ་འོངས་པར་གྲུབ་པ་ཡོད་ན་ནི་ད་ལྟར་དང་འདས་པ་གཉིས་འགྲུབ་ན་གང་གི་ཚེ་མ་འོངས་པ་ཉིད་མེད་པ་དེའི་ཚེ་ཇི་ལྟར་འདས་པའམ་ད་ལྟར་བྱུང་བར་འགྱུར།",
    "གང་གི་ཕྱིར་དེ་གཉི་ག་ཡང་མ་འོངས་པ་ཡིན་པ་དེའི་ཚེ་གསུམ་ཆར་ཡང་མ་འོངས་པ་ཉིད་དུ་འགྱུར་ལ།",
    "དེ་ལ་རེ་ཞིག།",
    "ཅི་སྟེ་མ་འོངས་པ་མ་སྐྱེས་པ་ཡིན་མོད་ཀྱི།",
    "འདུས་མ་བྱས་ནི་དེ་ལྟར་རང་གི་ངོ་བོ་ལས་ཉམས་པ་ཡང་མ་ཡིན་པས་འདི་འདུས་མ་བྱས་བཞིན་དུ་རྟག་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "གལ་ཏེ་རང་གི་ངོ་བོ་ཉམས་པ་ཡོད་པའི་ཕྱིར་མ་འོངས་པ་རྟག་པ་ཉིད་དུ་མི་འདོད་ན་ནི་འོ་ན་དངོས་པོ་འདས་པ་ལ་རང་གི་ངོ་བོ་ཉམས་པ་ཡོད་པ་མ་ཡིན་པས་དེ་ཡང་རྟག་གོ་ཞེས་བྱ་བར་བརྟག་པར་གྱིས་ཤིག།",
    "གང་གི་ཚེ་མི་ནུས་པ་དེའི་ཚེ་དངོས་པོ་ཐམས་ཅད་ལ་མི་རྟག་པ་ཉིད་མི་སྲིད་པས་རྟག་པ་ཉིད་ཁོ་ནར་འགྱུར་རོ།",
    "དེ་ལ་རེ་ཞིག།",
    "རེ་ཞིག་དངོས་པོ་ད་ལྟར་བ་གང་ཡིན་པ་དེ་ལ་ནི་ཇེ་མི་རྟག་པ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "རྟེན་མེད་པའི་ཕྱིར་དང་ཐུག་པ་མེད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་རེ་ཞིག།",
    "གང་གི་ཚེ་སྐྱེས་པ་མི་རྟག་པའི་རྟེན་ལ་མི་རྟག་པ་ཉིད་མི་སྲིད་པ་དེའི་ཚེ་ནམ་མཁའ་ལ་སོགས་པ་བཞིན་དུ་དེ་སྐྱེ་བས་སྟོང་པའི་མ་འོངས་པ་ལ་དེ་ཡོད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་གཏན་མ་འབྲེལ་བ་ཞིག་གོ།",
    "སྔར་མེད་པ་ནི་མོ་གཤམ་གྱི་བུ་ལ་སོགས་པ་ལྟར་ཕྱིས་སྐྱེ་བར་མི་དམིགས་ཏེ།",
    "གལ་ཏེ་གང་ཞིག་སྐྱེས་པའི་སྔ་རོལ་ན་དངོས་པོ་མེད་ཅིང་ངོ་བོ་མེད་པའི་ཕྱིས་རྒྱུ་དང་རྐྱེན་རྣམས་ཀྱིས་བསྐྱེད་པ་དེ་བསྐྱེད་པའི་སྔ་རོལ་ན་རང་གི་ངོ་བོས་ཡོད་དོ་ཞེས་བྱ་བར་རྟོག་ན་དེ་ལྟ་ཡིན་དང་།",
    "དེ་དག་གི་སྨྲ་བ་ནི་ལོག་པ་མ་ཡིན་པ་ཡང་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར།",
    "གཞན་ཡང་གང་གིས་འདུ་བྱེད་རྣམས་མི་རྟག་གོ་ཞེས་ཁས་བླངས་པ་དེའི་ལྟར་ན་མི་རྟག་པ་ཉིད་དུས་གསུམ་ཆར་ལ་ཡང་མི་འཁྲུལ་བའི་ཕྱིར་གང་མི་རྟག་པ་དེ་སྔ་ཕྱིའི་ཆ་གཉིས་ངེས་པར་ཡོད་པ་མ་ཡིན་པར་འགྱུར་བར་བྱ་དགོས་ཏེ།",
    "གང་གི་སྔ་རོལ་དུ་དངོས་པོ་གཞན་མེད་པ་དེ་ནི་འཇིག་རྟེན་ནི་ཐོག་མ་ཞེས་བྱ་ལ།",
    "གང་གི་འོག་རོལ་ཏུ་དངོས་པོ་གཞན་མེད་པ་དེ་ནི་མཐའ་ཞེས་བརྗོད་ལ།",
    "མ་འོངས་པའི་ཉོན་མོངས་པ་དང་སྐྱེ་བ་མེད་པར་སྒྲིམ་པར་འགྱུར་ཏེ་འཕགས་པའི་ལམ་བསྐྱེད་པ་མེད་པར་ཡང་འདི་གྲོལ་བར་འགྱུར་རོ།",
    "གྲོལ་བ་རྣམས་ལ་ནི་འཕགས་པའི་ལམ་གྱི་སྟོབས་ཀྱིས་མ་འོངས་པའི་ཉོན་མོངས་པ་དང་སྐྱེ་བ་གཉིས་མི་སྐྱེ་བའི་ཕྱིར་མ་འོངས་པ་མེད་པ་མ་ཡིན་ནོ།",
    "དགྲ་བཅོམ་པ་ལ་ཡང་འདོད་ཆགས་ཡོད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཡང་གི་སྒྲས་ནི་ཆགས་པ་མེད་པར་ཡང་འདོད་ཆགས་སུ་འགྱུར་བའམ།",
    "གྲངས་ཅན་དང་བྱེ་བྲག་ཏུ་སྨྲ་བ་དག་གི་ནི་འབྲས་བུ་ཡོད་པར་སྨྲ་བ་ཉིད་དོ།",
    "འཇིག་རྟེན་གྱིས་ནི་མ་འོངས་པའི་ཡོན་ཏན་གསུམ་པོ་འདི་དག་ཡོད་པ་ཉིད་དུ་དམིགས་ནས་དེ་དག་གི་ཡོངས་སུ་འགྱུར་བར་དམིགས་པ་མེད་པ་ཉིད་དོ།",
    "གང་གི་ཚེ་འོ་མ་ལ་ཞོའི་དངོས་པོ་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་གཞན་གང་ཞིག་ལ་སྲིད་པར་འགྱུར་དེའི་ཕྱིར་ཡོངས་སུ་འགྱུར་བ་མེད་དོ།",
    "འོ་མ་དང་ཞོའི་གནས་སྐབས་ལས་ཐ་དད་པར་བ་ལང་གི་ཁུ་བའི་རྫས་ཞེས་ཅུང་ཟད་ཅིག་དམིགས་པ་ཡང་མ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་ཡང་མི་མཁས་ཤིང་བླུན་པ་རང་ཉིད་ཀྱིས་རང་གི་ངོ་བོ་ངེས་པར་མི་ཟིན་པ་རྣམས་ཀྱིས་དེ་ལྟར་བ་དེ་ཡོད་པར་རྟོག་གོ།",
    "དེ་ལྟར་སྐྱེ་བོ་བླུན་པོ་ལ་ལྟོས་ནས་ད་ལྟར་བ་ཞེས་བྱ་བར་རང་གི་ངོ་བོས་ཡོངས་སུ་བརྟག་པར་ནུས་པ་ཡང་མ་ཡིན་པས་དུས་གསུམ་མེད་དོ།",
    "འདི་ན་དངོས་པོ་སྐད་ཅིག་རེ་རེ་ལ་སྐྱེ་བ་དང་འཇིག་པ་དང་ལྡན་པ་རྣམས་ལ་གནས་པ་རྣམ་པ་ཐམས་ཅད་དུ་ཡོད་པ་མ་ཡིན་ལ།",
    "ཕྱིས་རྙིངས་པ་མེད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་སྔར་ཉིད་ནས་གནས་པ་མེད་པར་རྟོགས་པར་གྱིས་ཤིག།",
    "གང་གཅིག་གིས་བཟུང་བ་དེ་གཞན་གྱིས་བཟུང་བར་ནུས་པ་ཡང་མ་ཡིན་ཏེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ནི་ཡུལ་ལྷན་ཅིག་སྐྱེས་པ་ཡོངས་སུ་བཅད་ནས་འགག་པར་འགྱུར།",
    "ཅི་སྟེ་ཁས་ལེན་ན་ནི་དེའི་ཚེ་གཟུགས་དེ་མིག་གི་རྣམ་པར་ཤེས་པ་ལྟར་ཞིག་པའི་ཕྱིར་ཇི་ལྟར་རྣམ་པར་ཤེས་པར་འགྱུར།",
    "གནས་པ་ནི་དངོས་པོའི་རང་གི་མཚན་ཉིད་ཀྱིས་གནས་པ་ཡིན་ཏེ།",
    "རང་གི་མཚན་ཉིད་དེ་ནི་དངོས་སུ་འཛིན་པ་མ་ཡིན་པའི་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་གཅད་པར་མི་ནུས་སོ།",
    "དེ་འཇུག་པ་ཤས་ཆེ་བའི་གནས་སྐབས་ལ་ལྟོས་ནས་དངོས་པོ་གང་ཡང་རུང་བ་འགའ་ཞིག་གི་མཚན་ཉིད་བྱེད་པས་དངོས་པོ་འདས་པ་ལ་དམིགས་པའི་རྣམ་པར་ཤེས་པ་ཁོ་ན་ལ་དྲན་པའི་མཚན་ཉིད་ཆེས་གསལ་གྱི་གཞན་ལ་ནི་མ་ཡིན་ནོ།",
    "ད་ལྟར་བའི་གནས་སྐབས་ཀྱི་དངོས་པོ་དེའི་རང་གི་ངོ་བོ་དངོས་སུ་བྱེད་པའི་ཤེས་པ་ད་ལྟར་བས་མཐོང་བ་གང་ཡིན་པ་དེ་ནི་སླར་མི་སྣང་ངོ།",
    "གང་གི་ཚེ་མི་སྣང་བ་དེའི་ཚེ་དེའི་ཡུལ་ཅན་གྱི་སེམས་སླར་ཡང་མི་སྐྱེའོ།",
    "གང་གི་ཚེ་དངོས་པོ་དེའི་བདག་ཉིད་དེས་ཡོད་པར་གྱུར་ན་ད་ལྟར་བར་ཐལ་བའི་ཕྱིར་ལ།",
    "གལ་ཏེ་དེ་རང་གི་ངོ་བོས་ཡོད་ན་ནི་དེའི་ཚེ་དྲན་པ་དེ་ཡོད་པའི་དོན་ལ་དམིགས་པའི་ཕྱིར་རང་གི་ངོ་བོས་གྲུབ་པ་ཞིག་ན།",
    "གང་གི་ཚེ་འདས་པའི་དངོས་པོ་དེ་རང་བཞིན་མེད་པ་དེའི་ཚེ་དེ་ལ་དམིགས་པའི་དྲན་པ་ཡང་རང་བཞིན་མེད་པ་ཡིན་ཏེ།",
    "རང་གི་ངོ་བོས་ཡོད་པ་ཡང་མ་ཡིན་ནོ།",
    "རྟག་པ་ཉིད་དུ་ཐལ་བའི་ཕྱིར་དང་།",
    "དངོས་སུ་འཛིན་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཁྱོད་ཀྱིས་བདག་མེད་པ་འདི་ཆེས་གསལ་ཞིང་རྒྱས་པར་བསྟན་ལ།",
    "དེའི་ཕྱིར་སྨྲ་བ་པོ་ཆེས་ཡོངས་སུ་དག་པ་ཡིན་ཡང་ཉན་པ་པོ་རང་གི་ཉེས་པར་མི་བརྩི་བ་རྣམས་ཀྱི་སྐྱོན་དང་ལྡན་པ་ཉིད་དུ་འཛུད་པར་བྱེད་དེ།",
    "ཁ་ཅིག་དག་གིས་དེས་ཉེ་བར་བསྟན་པའི་དངོས་པོའི་དེ་ཁོ་ན་ཉིད་ཇི་ལྟ་བ་བཞིན་ངེས་པར་མ་ཟིན་པའི་ཕྱིར་རོ།",
    "དམུས་ལོང་གིས་མ་མཐོང་བ་ནི་སྣང་བཞིན་པའི་ཉི་མའི་སྐྱོན་མ་ཡིན་ཏེ་མ་ལོང་བ་རྣམས་ཀྱིས་དེ་མཐོང་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་བཅོམ་ལྡན་འདས་དངོས་པོ་ཐམས་ཅད་ཀྱི་རང་གི་ངོ་བོ་སུན་འབྱིན་པར་ཞུགས་པའི་ཕྱིར་ཁོ་བོ་ཅག་གི་ཡིད་མགུ་བར་མི་མཛད་དོ།",
    "བདག་ཉིད་ལ་ཀུན་ནས་ཉོན་མོངས་པའི་དངོས་པོ་ཐམས་ཅད་མྱ་ངན་ལས་ཟློ་བའི་གཏམ་ཡང་ཁོད་ཅིག།",
    "ཞེས་བྱ་བར་འགྱུར་མོད་ཀྱི།",
    "དྷརྨ་ཎཱ་ཨ་མ་ཞེས་བསྟན་པར་བྱ་བ་ལ།",
    "ཐམས་ཅད་བཏང་བས་མྱ་ངན་ལས་འདས་པ་ཞེས་བྱ་བ་འདི་ཉིད་ཡ་མཚན་ཅན་རྣམས་ཀྱི་ཡང་བསམ་པ་ཡིན་ན་ནི་ཁྱོད་དང་མུ་སྟེགས་ཅན་རྣམས་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "ཕ་རོལ་པོ་སྨྲ་བ་ནི་དགེ་སྦྱོང་དག་གིས་སྟོང་པའོ་ཞེས་གསུངས་སོ་ཞེས་བྱ་བར་ངེས་སོ།",
    "དེ་ནི་གང་གིས་ཀྱང་གཞན་ཉིད་དུ་བསྒྱུར་བར་མི་ནུས་སོ།",
    "རེ་ཞིག་འདི་ཉིད་ལ་འདི་ངེས་པར་གྱིས་ཤིག།",
    "ཇི་ལྟར་བདག་གི་འདུ་ཤེས་ཤེས་གྱུར་པ།",
    "གང་གི་འཇིག་རྟེན་འདི་མཐོང་དཀའ།",
    "ཟླ་བ་ཉ་བ་ལ་མཐོང་བའི་ནུས་པ་ཉམས་པ་འགའ་ཞིག་གིས་སྐད་མ་རྒྱུ་བ་དང་ཨ་ནུ་དན་ཏི་མཐོང་བ་ནི་མ་ཡིན་ནོ།",
    "དེ་བཞིན་གཞུང་ལུགས་དག་ལ་མི་མཁས་བློ་གྲོས་ངན་ཞིང་འཛམ་བུའི་གླིང་དུ་སོང་བ་རྣམས།",
    "བདག་གི་ཡོད་མིན་འབྱུང་མི་འགྱུར།",
    "སྐྲག་པ་དེ་ཡང་ཤིན་ཏུ་ཡུན་རིང་པོར་བདག་ཏུ་འཛིན་པ་དང་བདག་གིར་འཛིན་པ་གོམས་པ་ལས་སོ།",
    "དམ་པ་མ་ཡིན་པ་བདག་ཏུ་འཛིན་པ་དང་བདག་གིར་འཛིན་པ་ལ་རྣམ་པར་གནས་པའི་ཡིད་རང་ཉིད་མྱ་ངན་ལས་འདས་པར་འགྲོ་བར་མི་སྤྲོ་བ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "ཡང་ཅིའི་ཕྱིར་དམ་པ་མ་ཡིན་པའི་གང་ཟག་གི་ཡིད་འདྲེན་པ་པོ་དེའི་རྗེས་བཞིན་དུ་ཡང་མམྱ་ངན་ལས་འདས་པར་འགྲོ་བ་མི་སྤྲོ་ཞེ་ན།",
    "གཏི་མུག་གིས་བཙས་པའི་ཕྱིར་རོ།",
    "ཡང་ཅིའི་ཕྱིར་ཅུང་ཟད་ཤེས་པ་འདི་དག་གིས་ཤེས་པར་བྱ་བ་ཡོངས་སུ་རྫོགས་པར་མ་གྱུར་གྱི་བར་དུ་གོ་འཕང་གོང་མ་མི་ཚོལ་ཞེ་ན།",
    "གང་ཞིག་གཏི་མུག་འགའ་ཞིག་གིས།",
    "གཏི་མུག་པ་འགའ་ཞིག་གིས་ཞེས་བྱ་བ་ནི་ཕྲག་དོག་དང་སེར་སྣ་དང་ལེ་ལོ་དང་འཇིགས་པ་དང་ཉན་པ་པོ་ལ་སྡང་བ་ལ་སོགས་པས་སོ།",
    "དེས་ན་ཤེས་རབ་ཀྱི་སྒྲོན་མ་ཕྱོགས་ཀྱི་སྒོ་མ་ལུས་པ་ཁྱབ་ཅིང་སྣང་བ་ཆེས་གསལ་བ་དུས་གསུམ་དུ་མཐུ་འཇུག་པ་ཉམས་པ་མེད་པ་ཉིན་རེ་ཞིང་མ་རིག་པའི་མུན་པ་གཞོམ་པའི་ཕྱིར་སྣང་བའི་ཚོགས་འཕེལ་བཞིན་པར་གྱུར་པ།",
    "འདི་ཉིད་ཀྱང་རང་དང་གཞན་གཉིས་ལ་གནོད་པ་བྱེད་པ་ཉིད་དུ་གཟིགས་ནས།",
    "སྟོང་པ་ཉིད་མཐོང་བའི་རྐྱེན་གྱིས་ཐམས་ཅད་ལ་ཆགས་པ་སྤངས་པ་ལས་ལས་དང་ཉོན་མོངས་པའི་ཚོགས་བཅོམ་པ་ནི་ངེས་པར་མྱ་ངན་ལས་འདས་པའི་གོ་འཕང་དུ་ཉེ་བར་འགྲོའོ།",
    "གང་ཟག་གི་བདག་མེད་པ་ཞེས་བྱ་བའོ།",
    "དོན་གང་ཞིག་ལ་རང་གི་ངོ་བོས་གྲུབ་པ་ཡོད་པ་མ་ཡིན་པ་དེ་བདག་ཉིད་གཞན་གང་ཞིག་གིས་འགྲུབ་པར་འགྱུར།",
    "བདག་མེད་པ་ཡིན་ན་ནི་དངོས་པོ་རྣམས་རྣམ་པ་ཐམས་ཅད་དུ་མ་དམིགས་པས་དངོས་པོའི་རང་གི་ངོ་བོ་ཡོངས་སུ་བརྟགས་པའི་རྟེན་ཅན་ལྟ་བ་ངན་པ་རྣམས་གཏན་ནས་འཇིག་པར་མཐོང་བའི་ཕྱིར་བདག་མེད་པ་འདི་ནི་འཇིག་པར་བྱེད་པའོ།",
    "གང་གི་ཕྱིར།",
    "གལ་ཏེ་ཡང་དེ་ལྟ་ཡིན་མོད་ཀྱི།",
    "བསྲེག་སྟེ་མེ་ཡིས་བུད་ཤིང་བཞིན།",
    "མེ་ཉེ་བར་ལེན་པ་ནི་བཙོ་བ་ལ་སོགས་པའི་བྱ་བའི་དོན་དུ་ཡིན་ལ་བུད་ཤིང་བསྲེག་པའི་དོན་དུ་མ་ཡིན་མོད་ཀྱི།",
    "དེ་ལྟ་ན་ཡང་སྲེག་པར་བྱེད་པའི་རང་བཞིན་ཡིན་པས་འདོད་པའི་བྱ་བ་རྗེས་སུ་སྒྲུབ་ཅིང་བུད་ཤིང་ཡང་སྲེག་པར་བྱེད་དོ།",
    "ཉོན་མོངས་པའི་འཆིང་བ་ཐམས་ཅད་སྲེག་པར་བྱེད་པའི་བདག་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་ལ་ཕྱི་དང་ནང་གི་དངོས་པོའི་རང་གི་ངོ་བོ་ཡོངས་སུ་མི་རྟོགས་པའི་ཕྱིར་ཞེས་བྱ་བའི་དངོས་པོ་འགའ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ནོ་སྙམ་པའི་དགོངས་པ་རྣམ་པར་གནས་པ་དེ་ནི་གང་མེད་པར་མཐོང་བ་ལས་དེ་བདག་མེད་པ་ལ་འཇིགས་པར་འགྱུར་བ་ཡོད་པར་ལྟ་བ་ཡོད་པས་ཡོངས་སུ་ཚིམ་པར་ག་ལ་འགྱུར།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དེ་དག་གི་རྗེས་སུ་ཆགས་པ་དང་ཁོང་ཁྲོ་བ་དང་བྲལ་བའོ་ཞེས་བྱ་སྟེ།",
    "ཉོན་མོངས་པའི་དྲི་མ་མ་ལུས་པ་བསལ་བས་སེམས་ཀྱི་རྒྱུད་དྲི་མ་མེད་པར་གྱུར་པ་རྣམས་ནི་དེ་ལྟར་མཉམ་པར་གཞག་པ་དག་ཁོ་ནས་ངེས་པར་བྱ་བ་ཡིན་ཏེ།",
    "འགྱོད་ཚངས་ལ་སོགས་པའི་བྱ་བ་དག་གིས་གཞན་དག་ལས་རྙེད་པ་དང་།",
    "དེ་བཞིན་ཉོན་མོངས་བླངས་པ་ལས།",
    "ཇི་ལྟར་འདོན་པར་བྱེད་པ་ཙམ་གྱིས་སེམས་རངས་པར་གྱུར་པའི་འཇིག་རྟེན་ནི་རིག་པ་བླངས་པ་ལས་བྲམ་ཟེ་རྣམས་ལ་གུས་པ་སྐྱེ་བ་དེ་བཞིན་དུ་ཉོན་མོངས་པ་བླངས་པ་ལས་ཏེ་མགོ་འབལ་པ་ལ་སོགས་པ་ལུས་ཡོངས་སུ་དུབ་པ་རྣམས་ལས་གོས་མེད་པ་རྣམས་ལ་བརྩེ་བ་སྐྱེའོ།",
    "དེས་ཀུན་ནས་བསླང་བའི་ལུས་དང་ངག་གི་ལས་ཡིན་ལ།",
    "རང་གི་ཕྱོགས་ལ་ཆགས་པའི་ཕྱིར་རོ།",
    "ཁྱོད་ལ་གང་གིས་སྡུག་པར་འགྱུར།",
    "རང་གི་སྐྱེ་བའི་གནས་ལྟར་འཇིག་རྟེན་གྱིས་དེ་ཡོངས་སུ་གཏང་བར་མི་ནུས་ཏེ།",
    "མཁས་པས་རང་སྐྱེ་བའི་ས་ཡིན་ཡང་བརྒྱུད་པའི་རྒྱུར་གྱུར་པ་ལ་རེ་བ་སྤངས་ནས་འབྱོར་པ་བྱེད་པའི་ཡུལ་ལ་བརྟེན་པར་རིགས་ལ།",
    "འདི་ཇི་ལྟར་ཡིན་པ་དེ་ལྟར་རང་གི་ཕྱོགས་ལ་ཆགས་པ་སྤངས་ནས་གཞན་གྱི་ཕྱོགས་ཡིན་ཡང་ཡོན་ཏན་དང་ལྡན་པ་ལ་ཡིད་གཞུག་པར་བྱའོ།",
    "ཕྱི་དང་ནང་གི་དངོས་པོ་ཐམས་ཅད་རང་བཞིན་གྱིས་བདག་མེད་པར་མཐོང་བའོ།",
    "འང་གི་སྒྲས་ནི་དེའི་ཉེ་བར་ལེན་པ་སྔོན་པོ་ལ་སོགས་པ་དག་ཀྱང་མངོན་སུམ་ཡིན་ནོ་ཞེས་དེ་ཁོ་ན་ཉིད་ཤེས་པ་སུ་ཞིག་སྨྲ་བར་འགྱུར།",
    "དེ་ལ་ཁ་ཅིག་དག་གིས་ནི་བུམ་པ་ལ་སོགས་པའི་ཡོན་ཏན་གསུམ་ཡོངས་སུ་འགྱུར་བའི་ངོ་བོར་རྟོགས་ལ།",
    "ཡང་གཞན་དག་གིས་ནི་བུམ་པ་ཞེས་བྱ་བ་ཡན་ལག་ཅན་གྱི་རྫས་ཡན་ལག་ལས་ཐ་དད་པ་མཐོང་བ་དང་།",
    "དེ་དག་གི་ཡང་།",
    "ཇི་ལྟར་བུད་ཤིང་ལ་བརྟེན་ནས་མེ་དང་།",
    "གང་ཞིག་གཟུགས་ལ་སོགས་པ་ལས་མ་གཏོགས་པར་བུམ་པ་གཞན་དུ་མ་དམིགས་པའི་ཕྱིར་གནས་སྐབས་དེ་ལྟ་བུའི་གཟུགས་ལ་སོགས་པ་དག་ཁོ་ན་ལ་བུམ་པའི་བློར་འགྱུར་གྱི་བུམ་པ་ཞེས་བྱ་བ་དངོས་པོ་འགའ་ཞིག་ཡོད་པ་ནི་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་དེ་ལྟར་རྒོལ་བ་དེའི་ལྟར་ན་རྟག་ཏུ་འབར་བ་ཉིད་ལ་སོགས་པའི་ཉེས་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་བུད་ཤིང་ལས་མ་གཏོགས་པར་ལས་མེད་པར་གྱུར་པའི་མེའི་ཡོད་པ་ཉིད་མེད་པས་དེ་ཡང་བློས་ཡོངས་སུ་བརྟགས་པ་ཙམ་དུ་འགྱུར་ལ།",
    "དེའི་ཕྱིར་བུམ་པ་རྫས་བརྒྱད་ཀྱི་ཉེ་བར་ལེན་པ་ཅན་རང་གི་ཉེ་བར་བླངས་པའི་ཉེ་བར་ལེན་པ་པོར་གྱུར་ཅིང་ཉེ་བར་ལེན་པའི་བྱ་བ་བྱེད་པ་པོ་འཇིག་རྟེན་གྱི་མངོན་སུམ་དུ་གྱུར་པའི་ཡན་ལག་ཅན་དེ་ལྟར་རྣམ་པར་གནས་པ་ཡིན་དང་འདི་རྣམ་པར་དཔྱད་དེ།",
    "མིག་གིས་ནི་གཟུགས་གཅིག་པུ་མཐོང་གི་དྲི་ལ་སོགས་པ་དག་ནི་མ་ཡིན་ཏེ་ཡུལ་ཐ་དད་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་རྣམ་པར་འབྱེད་པར་བྱེད་ཅིང་དངོས་པོའི་རང་གི་ངོ་བོ་ལ་མཁས་པ་གང་ཕྱོགས་གཅིག་མཐོང་བས་རི་ལ་མཐོང་བར་སྲིད་པར་མི་བྱེད་པ་དེ་ནི་བུམ་པ་མངོན་སུམ་མོ་ཞེས་བྱ་བ་རྣམ་པ་དེ་ལྟ་བུར་སྨྲ་བར་མི་འོས་སོ།",
    "འདི་ལ་རྟོག་གེ་བ་རྣམས་ན་རེ་བུམ་པ་ལ་མངོན་སུམ་ཉིད་ཡོད་པ་མ་ཡིན་པ་ཁོ་ན་སྟེ།",
    "གཟུགས་ལ་སོགས་པ་རྣམས་ཀྱི་རང་གི་མཚན་ཉིད་ནི་བསྟན་དུ་མེད་པ་ཡིན་ལ།",
    "བུམ་པ་ནི་བློས་ཡོངས་སུ་བརྟགས་པ་ཙམ་ཡིན་པའི་ཕྱིར་རང་གི་མཚན་ཉིད་དུ་ཡོད་པ་མ་ཡིན་ལ།",
    "གང་ལ་རང་གི་མཚན་ཉིད་ཡོད་པ་མ་ཡིན་པ་དེ་ལ་ནི་དངོས་ཀྱི་གནས་པས་མངོན་སུམ་ཉིད་མི་སྲིད་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་དེ་ལ་བཏགས་པའི་མངོན་སུམ་ཉིད་ཀྱང་མི་རུང་ངོ།",
    "དེའི་ཕྱིར་མངོན་སུམ་ཉིད་འགོག་པ་དགོས་པ་མེད་པའི་ཕྱིར་སྒྲ་ལ་མིག་གིས་གཟུང་བར་བྱ་བ་འགོག་པ་ལྟར་བུམ་པ་འདི་ལ་ཡང་འགོག་པའི་རིགས་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "རྟོག་གེ་པ་འདི་ནི་འཇིག་རྟེན་པའི་དོན་དག་ལ་གཏན་མ་བྱང་བའི་ཕྱིར་བྱིས་པ་གཞོན་ནུ་ལྟར་ཇེ་དང་པོ་ཁོ་ན་ནས་སྦྱང་བར་གྱུར་པ་ཡིན་པས་དེ་བསྟན་པར་བྱ་བའི་ཕྱིར་ཁྱོད་ཀྱི་མངོན་སུམ་གང་ཞིག་ཡིན་ཞེས་བརྒལ་ཞིང་བརྟག་པར་བྱའོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "རབ་རིབ་ཅན་གྱིས་སྐྲ་ཤད་རེ་རེ་ལོགས་སུ་མ་མཐོང་བའི་ཕྱིར་རོ།",
    "ཚོགས་པའི་ནང་ན་གནས་པ་རེ་རེ་ཡང་རྒྱུའི་དངོས་པོ་ཡིན་པ་ལྟར་མིག་ལ་སོགས་པའི་རྡུལ་ཕྲ་རབ་ཚོགས་པ་རྣམས་ནི་རེ་རེ་ཞིང་རྒྱུ་ཉིད་ཡིན་ནོ་ཞེ་ན།",
    "རབ་རིབ་མེད་པས་སྐྲ་རེ་རེ་ནས་མཐོང་བའི་ཕྱིར་མིག་ལ་གནོད་པ་ཡོད་ན་མི་མཐོང་བར་འགྱུར་ན།",
    "འདི་ལྟར་རྩ་གཅིག་ལ་ཤ་སྦྲང་དང་སྦྲང་བུ་མཆུ་རིངས་ལ་སོགས་པའི་རྐང་པ་འཆིང་བའི་ནུས་པ་དམིགས་ནས་དེ་དག་གི་ཚོགས་པ་ལ་གླང་པོ་ཆེ་འཆིང་བའི་ནུས་པའི་བར་སྲིད་ལ།",
    "དེའི་ཕྱིར་དེ་ལྟར་འཇིག་རྟེན་པའི་ཐ་སྙད་གནས་པ་ཡིན་དང་འཇིག་རྟེན་ཁོ་ན་ལས་བུམ་པ་མངོན་སུམ་མོ་ཞེས་བྱ་བར་བརྗོད་པར་རིགས་ཀྱི།",
    "བུམ་པའི་རང་གི་ངོ་བོ་རྣམ་པ་ཐམས་ཅད་དུ་མ་དམིགས་པའི་ཕྱིར་རོ།",
    "འཇིག་རྟེན་འདི་ཡང་ཕལ་ཆེར་མའི་བཞིན་ལྟར་དཔྱོད་ཅིང་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་དངོས་པོ་གནས་པ་ལ་རྣམ་པར་རྨོངས་པའི་འདིས་རང་གི་རྟོག་པ་ཙམ་གྱིས་སྦྱར་ཞིང་མཐོ་རིས་དང་ཐར་བའི་ལམ་ལ་བར་དུ་གཅོད་པར་བྱེད་པ་ཤིན་ཏུ་དོན་མེད་པར་རྟོག་གེ་བའི་ལམ་ལ་བཀོད་པ་ཡིན་ནོ།",
    "ཅི་སྟེ་བུམ་པ་གཟུགས་ལས་ཐ་དད་པ་མེད་མོད་ཀྱི་གཟུགས་ཀྱིས་དེ་ཁྱབ་པར་བྱས་ནས་ནི་གནས་པས་གཟུགས་མཐོང་བས་བུམ་པ་ཐམས་ཅད་མཐོང་བར་འགྱུར་རོ་ཞེ་ན།",
    "ཡང་ན་འདི་ནི་དོན་གཞན་ཡིན་ཏེ་བུམ་པ་རྫས་བརྒྱད་ཀྱི་ཉེ་བར་ལེན་པ་ཅན་ཡིན་ཡང་གལ་ཏེ་རྫས་གཅིག་གི་གཟུགས་མཐོང་བས་རིལ་མཐོང་བར་རྟོགས་ན་ནི་རེ་ཞིག་དེ་དག་དང་སོ་སོར་མི་གནས་པའི་གཟུགས་དེ་ཉིད་དེ་དེ་ལས་གཞན་རྫས་བདུན་མ་མཐོང་བས་ན་མ་མཐོང་བ་ཡིན་ནོ་ཞེས་ཅིའི་ཕྱིར་མི་རྟོག།",
    "བུམ་པའི་གཟུགས་ནི་རེ་ཞིག་མངོན་སུམ་ཡིན་ཏེ།",
    "བུམ་པ་ནི་ཡན་ལག་གྱོ་མོ་ལ་ལྟོས་ནས་ཡན་ལག་ཅན་ཡིན་ལ།",
    "གྱོ་མོ་དེ་དག་ཀྱང་རང་གི་ཡན་ལག་ལ་ལྟོས་ནས་ཡན་ལག་ཅན་དུ་འགྱུར་རོ།",
    "དེ་ཡང་རྫས་བརྒྱད་ལ་ལྟོས་ནས་སམ་མདུན་དང་རྒྱབ་དང་དབུས་ཀྱི་ཆ་ལ་ལྟོས་ནས་སླར་ཡང་ཡན་ལག་ཅན་ཡིན་པས་འགའ་ལ་ཡང་རང་གི་ངོ་བོས་ཡན་ལག་ཉིད་དང་ཡན་ལག་ཅན་ཉིད་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཇི་ལྟར་རྡུལ་ཕྲ་རབ་ལ་རྣམ་པར་དཔྱད་པ་དེ་བཞིན་དུ་མིང་གི་མཐར་གནས་པའི་ཡི་གེ་ལ་ཡང་སྟེ།",
    "དེ་ལ་རེ་ཞིག།",
    "གལ་ཏེ་དེ་ལས་དབྱིབས་ཐ་དད་པར་འགྱུར་ན་ནི་ཁ་དོག་ལས་ཐ་དད་པའི་ཕྱིར་སྒྲ་ལ་སོགས་པ་ལྟར་མིག་གི་གཟུང་བྱར་མི་འགྱུར་བ་ཞིག་ན།",
    "ཁ་དོག་ལྟར་མིག་གིས་འཛིན་པ་ཡང་ཡིན་པས་དེ་ལས་གཞན་མ་ཡིན་ནོ།",
    "དེ་དག་ནི་རེ་ཞིག་ཡོད་པ་ཡིན་ནོ།",
    "དེ་དག་ཡོད་པས་དེ་དག་གི་འབྲས་བུ་གཟུགས་ཀྱི་སྐྱེ་མཆེད་ཀྱང་ཡོད་པར་འགྱུར་རོ་ཞེས་སྨྲའོ།",
    "དེའི་ཕྱིར་གལ་ཏེ་གཟུགས་ཀྱི་རྒྱུ་ཞེས་བྱ་བ་ཅུང་ཟད་ཅིག་རང་གི་ངོ་བོས་འགྲུབ་པར་འགྱུར་ན་ནི་༥ དེའི་ཚེ་གཟུགས་ཀྱང་རང་གི་ངོ་བོས་གྲུབ་པར་འགྱུར་བ་ཞིག་ན།",
    "གང་གི་ཕྱིར་འདི་དེ་ལྟར་ཡིན་པ།",
    "དེས་ན་རེག་པ་འགའ་ཞིག་འདི།",
    "དེ་ཉིད་དང་གཞན་ཉིད་དང་བྲལ་བའི་དངོས་པོ་འདི་འགའ་ཞིག་ལ་རང་གི་ངོ་བོས་ཡོད་པ་ཉིད་དུ་བརྟག་པར་རིགས་པ་ཡང་མ་ཡིན་ཏེ།",
    "འདིར་ཁ་ཅིག་དག་ན་རེ་བུམ་པ་ནི་རང་༣གི་ངོ་བོས་བལྟ་བར་བྱ་བ་མ་ཡིན་ཞིང་།",
    "བལྟ་བར་བྱ་བ་མ་ཡིན་པའང་མ་ཡིན་མོད་ཀྱི།",
    "འདིར་བལྟ་བར་བྱ་བ་ཉིད་འདི་ཡོངས་སུ་བརྟགས་ནས་དོན་བལྟ་བར་བྱ་བའི་རང་གི་ངོ་བོའམ།",
    "བལྟ་བར་བྱ་བ་མ་ཡིན་པའི་རང་གི་ངོ་བོ་ཞིག་ལ་རྟོག།",
    "རེ་ཞིག་གལ་ཏེ་བལྟ་བར་བྱ་བའི་རང་གི་ངོ་བོ་ལ་ཡིན་ན་དེའི་ཚེ་དེ་བརྟགས་པས་ཅི་ཞིག་བྱ།",
    "གང་གི་དོན་ཡོངས་སུ་རྟོག་པ་དེ་ནི་མེད་པར་ཡང་ཡོད་པ་ཉིད་པས་བརྟག་པར་མི་རིགས་སོ།",
    "ཅི་སྟེ་བལྟ་བར་བྱ་བ་མ་ཡིན་པར་གྱུར་པ་ལ་བལྟ་བར་བྱ་བ་ཉིད་རྟོག་ན་ཡང་མི་རིགས་ཏེ་ལུས་ཅན་མ་ཡིན་པ་རྣམས་ཀྱང་བལྟ་བར་བྱ་བ་ཉིད་དུ་ཐལ་བའི་ཕྱིར་དང་།",
    "འདི་ལྟར་མིག་གིས་གཟུགས་ཁོ་ན་མཐོང་གི་སྒྲ་མི་ཐོས་ལ།",
    "གང་གི་ཚེ་དེ་ལྟར།",
    "མིག་གིས་མཐོང་གི་གཞན་གྱིས་མིན་པ་དེའི་ཚེ་འཐད་པ་དང་འགལ་བའི་བྱ་བ་མི་སྲིད་པའི་ཕྱིར་མིག་ལ་སོགས་པ་རྣམས་ཀྱི་རང་གི་ངོ་བོ་རྟོག་པ་ག་ལ་ཡོད།",
    "ཅི་ཁོ་བོ་ཅག་གིས་འདི་རྣམས་ཀྱི་རྣམ་པར་སྨིན་པའི་ངོ་བོ་ཉིད་བཀག་གམ།",
    "ཁོ་བོ་ཅག་གི་རྣམ་པར་དཔྱོད་པ་དོན་རང་བཞིན་ཚོལ་བ་ལྷུར་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "མིག་གིས་མཐོང་གི་གཞན་གྱིས་མིན།",
    "རེ་ཞིག་ལས་དེ་ཉིད་རང་གི་ངོ་བོས་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་དེ་རང་གི་ངོ་བོས་གྲུབ་པར་གྱུར་ན་ནི་དེའི་ཚེ་དུས་ཐམས་ཅད་དུ་རྣམ་པར་མི་འཆད་པར་འགྱུར་ཞིང་རྣམ་པར་སྨིན་པ་བྱུང་ཟིན་པ་ལས་ཀྱང་སླར་རྣམ་པར་སྨིན་པར་འགྱུར་བའམ་ཡང་ན་རྣམ་པར་སྨིན་པར་མི་འགྱུར་བ་ཉིད་དེ།",
    "གང་གི་ཕྱིར་འདི་དེ་ལྟར་ཡིན་པ།",
    "དེ་ལ་རེ་ཞིག།",
    "རེ་༥་ཞིག་ལྟ་བའི་སྔ་རོལ་དུ་ནི་མིག་གི་རྣམ་པར་ཤེས་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "མིག་གི་ལྟ་བ་བདག་པོའི་རྐྱེན་མ་ཚང་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་རྣམ་པར་ཤེས་པ་མེད་པའི་མིག་གིས་གཟུགས་མཐོང་ན་ནི་འོ་ན་རྣམ་པར་ཤེས་པ་ཡོངས་སུ་རྟོག་པ་དོན་མེད་དོ།",
    "གང་གི་ཚེ་དེ་ལྟར་རྣམ་པར་ཤེས་པ་མི་སྲིད་པ་དེའི་ཚེ་དེ་ཡོད་པས་མིག་ལ་སོགས་པ་རྣམས་ཡོད་པར་བརྟག་པ་གང་ཡིན་པ་དེ་ནི་མི་རིགས་སོ།",
    "གལ་ཏེ་མིག་གིས་གཟུགས་དེ་ལྟ་བ་ན་ཡུལ་གྱི་ཡུལ་དུ་སོང་ནས་སམ་མ་སོང་བར་ལྟ་གྲང་ན།",
    "ཐག་རིང་ཡུན་རིང་གིས་མཐོང་འགྱུར།",
    "ཕྱེ་བ་ཙམ་གྱིས་མིག་གིས་ཐག་རིང་བ་ན་གནས་པ་ཡང་ཉེ་བ་ན་གནས་པ་ལྟར་མཐོང་བ་ཡང་ཡིན་པས་འདི་ནི་མི་རིགས་སོ།",
    "གཞན་ཡང་གལ་ཏེ་མིག་གིས་ཕྱིན་ནས་གཟུགས་མཐོང་ན།",
    "སོང་བས་ཡོན་ཏན་འགའ་ཡང་མེད།",
