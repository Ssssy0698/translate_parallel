    "གཙོ་བོའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པས་རང་གི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས་ཏེ་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་དཀྱིལ་འཁོར་གྱི་གཙོ་བོའི་ཞལ་དུ་ཞུགས།",
    "ལུས་ཀྱི་ཚོགས་རྣམས་རྔ་ཡབ་ལ་སོགས་པ་གཞལ་ཡས་ཁང་གི་རྒྱན།",
    "རིན་འབྱུང་མི་བསྐྱོད་པགི་ལུས་རང་བཞིན་གྱིས་གྲུབ་པའི་གཞལ་ཡས་ཁང་དུ་གྱུར།",
    "དེའི་སྤྱི་བོར་གཟུགས་ཕུང་གི་ངོ་བོ་ཨོ་དཀར་པོ་ལས་རྣམ་སྣང་།",
    "མགྲིན་པར་མེ་ཁམས་ཀྱི་ངོ་བོ་པོ་ལས་གོས་དཀར་མོ།",
    "མིག་གི་སྒོར་གཟུགས་ཀྱི་ངོ་བོ་ཛམ་ལས་གཟུགས་རྡོ་རྗེ་མ།",
    "པུས་མོ་གཡས་པར་གཡས་པའི་ངོ་བོ་ཧཱུྃ་ལས་དབྱུག་སྔོན་ཅན།",
    "རྐང་མཐིལ་གཉིས་སུ་བརྒྱ་ཞེ་གསུམ་རྐང་མཐིལ་གྱི་ངོ་བོ་ཧཱུྃ་ལས་གནོད་མཛེས་རྒྱལ་པོ་རྣམས་སྟེ་རང་གི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཐམས་ཅད་ལྷའི་ངོ་བོར་གྱུར།",
    "ཆུའི་ལྷག་མ་ཡར་ལུད་པ་ལས་རིན་འབྱུང་གིས་དབུར་བརྒྱན།",
    "ལག་པ་གཉིས་རྡོ་རྗེ་ཐལ་མོ་སྦྱར།",
    "གུང་མོ་གཉིས་གཤིབས་ཏེ་རྩེ་སྤྲད་ལ།",
    "ཨོ་དྷརྨ་བཛཱི་ཨ་མི་བསྐྱོད་པབྷི་ཥིཉྩ་ཧཱུྃ",
    "དེ་ཉིད་ལས་དབུས་མའི་རྩེ་མོ་བཅག་པ་ལས་ཀྱི་རྡོ་རྗེ་མའི་ཕྱག་རྒྱ་རྣ་ལྟག་གཡོན་པར་བཞག་ལ།",
    "མཉམ་པའི་ཐལ་མོ་དང་།",
    "ངཟེར་འཕྲོས་པ་རང་གི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས་ཏེ་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་དཀྱིལ་འཁོར་གྱི་གཙོ་བོའི་ཞལ་དུ་ཞུགས།",
    "སྐུའི་དབྱིབས་བརྒྱུད་ནས་ལྷ་མོའི་པདྨར་ཐོན་པ།",
    "ཨཱཋལས་པདྨ་ཨཱཋས་མཚན་པ་ལས་འོད་དཔག་མེད་དམར་པོ་དམར་ནག་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི།",
    "ལུས་ཀྱི་ཚོགས་རྣམས་རྔ་ཡབ་ལ་སོགས་པ་གཞལ་ཡས་ཁང་གི་རྒྱན།",
    "དེའི་སྤྱི་བོར་གཟུགས་ཕུང་གི་ངོ་བོ་ཨོ་དཀར་པོ་ལས་རྣམ་སྣང་།",
    "མགྲིན་པར་མེ་ཁམས་ཀྱི་ངོ་བོ་པོ་ལས་གོས་དཀར་མོ།",
    "མིག་གི་སྒོར་གཟུགས་ཀྱི་ངོ་བོ་ཛལས་གཟུགས་རྡོ་རྗེ་མ།",
    "པུས་མོ་གཡས་པར་གཡས་པའི་ངོ་བོ་ཧཱུཾ་ལས་དབྱུག་སྔོན་ཅན།",
    "རྐང་མཐིལ་གཉིས་སུ་རྐང་མཐིལ་གྱི་ངོ་བོ་ཧཱུྃ་ལས་གནོད་མཛེས་རྒྱལ་པོ་རྣམས་ཏེ་རང་གི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཐམས་ཅད་ལྷའི་ངོ་བོར་གྱུར།",
    "ཁ་། ཨོཾ་ཨཱ་སྤརེ་བཛཱི་ཧཱུྃ།",
    "ཨོཾ་ཨ་མི་ཏ་བྷཱ་ཝ་ཨབྷཾ་ནས་ཤབྡའི་བར་དང་།",
    "དེ་རིང་ཁྱོད་ལ་བསྐུར་བར་བྱ།",
    "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་བཅང་།",
    "ཨོཾ་ཨ་མི་ཏ་བྷ་ཝ་ཨནྡྷཾ་སོགས་ནས་ཤབྡའི་བར་གྱིས་མཆོད།",
    "གཙོ་བོའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པས་རང་གི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས་ཏེ་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་དཀྱིལ་འཁོར་གྱི་གཙོ་བོའི་ཞལ་དུ་ཞུགས།",
    "སྐུའི་དབྱིབས་བརྒྱུད་ནས་ལྷ་མོའི་པདྨར་ཐོན་པ་ཧ་ལས་རལ་གྲི་ཧཱས་མཚན་པ་ལས་དོན་ཡོད་གྲུབ་པ་ལྗང་གུ་ལྗང་ནག་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི།",
    "ཨོཾ་ཨཱསླརེ་བཛཱི་ཧཱུྃ།",
    "ལུས་ཀྱི་ཚོགས་རྣམས་རྔ་ཡབ་ལ་སོགས་པ་གཞལ་ཡས་ཁང་གི་རྒྱན།",
    "དེའི་སྤྱི་བོར་གཟུགས་ཕུང་གི་ངོ་བོ་ཨོཾ་དཀར་པོ་ལས་རྣམ་སྣང་།",
    "མགྲིན་པར་མེ་ཁམས་ཀྱི་ངོ་བོ་པོ་ལས་གོས་དཀར་མོ།",
    "མིག་གི་སྒོར་གཟུགས་ཀྱི་ངོ་བོ་ཛལས་གཟུགས་རྡོ་རྗེ་མ།",
    "གཡོན་པར་གཡོན་པའི་ངོ་བོ་ཧཱུྃ་ལས་འདོད་རྒྱལ་པུས་མོ་གཡས་པར་གཡས་པའི་ངོ་བོ་ཧཱུྃ་ལས་དབྱུག་སྔོན་ཅན།",
    "རྐང་མཐིལ་གཉིས་སུ་རྐང་མཐིལ་གྱི་ངོ་བོ་ཧཱུྃ་ལས་གནོད་མཛེས་རྒྱལ་པོ་རྣམས་ཏེ་རང་གི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཐམས་ཅད་ལྷའི་ངོ་བོར་གྱུར།",
    "ཨོཾ་ཨཱཋསྤརེ་བཛཱི་ཧཱུྃ།",
    "ཨོཾ་ཨ་མོ་གྷ་སིདྡྷི་ཨནྡྷཾ་སོགས་ནས་ཤབྡའི་བར་དང་།",
    "བདག་གིས་བཅོམ་ལྡན་བཟུང་ལགས་ཀྱི།",
    "ཨོཾ་ཨ་མོ་གྷ་སིདྡྷི་ཨབྷཾ་ནས་ཤརྡའི་བར་གྱིས་མཆོད།",
    "གཙོ་བོའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པ་རང་གི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས་ཏེ་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་དཀྱིལ་འཁོར་གྱི་གཙོ་བོའི་ཞལ་དུ་ཞུགས།",
    "སྐུའི་དབྱིབས་བརྒྱུད་ནས་ལྷ་མོའི་མི་བསྐྱོད་པཔདྨར་ཐོན་པ་ཧཱུྃ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་ལས་རྡོ་རྗེ་སེམས་དཔའ་དཀར་པོ་དཀར་ནག་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི།",
    "ཨོཾ་ཨཱསྤརེ་བཛཱི་ཧཱུྃ།",
    "བསྐུར་ཏེ་ལྷ་མོའི་པདྨ་ནས་ཕྱིར་ཐོན།",
    "ལུས་ཀྱི་ཚོགས་རྣམས་རྔ་ཡབ་ལ་སོགས་པ་གཞལ་ཡས་ཁང་གི་རྒྱན།",
    "དེའི་སྤྱི་བོར་གཟུགས་ཕུང་གི་ངོ་བོ་ཨོཾ་དཀར་པོ་ལས་རྣམ་སྣང་།",
    "མགྲིན་པར་མེ་ཁམས་ཀྱི་ངོ་བོ་པོ་༣ལས་གོས་དཀར་མོ།",
    "མིག་གི་སྒོར་གཟུགས་ཀྱི་ངོ་བོ་ཛམ་ལས་གཟུགས་རྡོ་རྗེ་མ།",
    "པུས་མོ་གཡས་པར་གཡས་པའི་ངོ་བོ་ཧཱུཾ་ངལས་དབྱུག་སྔོན་ཅན།",
    "རྐང་མཐིལ་གཉིས་སུ་རྐང་མཐིལ་གྱི་ངོ་བོ་ཧཱུྃ་ལས་གནོད་མཛེས་རྒྱལ་པོ་རྣམས་ཏེ་རང་གི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཐམས་ཅད་ལྷའི་ངོ་བོར་གྱུར།",
    "དཀར་ནག་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི།",
    "འགྲོ་བ་བུད་མེད་འདུལ་གཟིགས་ནས།",
    "རྒྱལ་བ་རྣམས་ཀྱིས་བུ་ཁྱོད་ཀྱི།",
    "ཡེ་ཤེས་ཀྱི་མིག་འབྱེད་པར་བསམ་མོ།",
    "རང་གི་སེམས་དབྱེར་མེད་དུ་ཤེས་པར་གྱིས་ཤིག།",
    "གཙོ་བོའི་ཐུགས་ཀ་ནས་འོད་ཨཟེར་འཕྲོས་པ་རང་གི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས་ཏེ་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་དཀྱིལ་འཁོར་གྱི་གཙོ་བོའི་ཞལ་དུ་ཞུགས།",
    "སྐུའི་དབྱིབས་བརྒྱུད་ནས་ལྷ་མོའི་པདྨར་ཐོན་པ་ཧཱུྃ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་ལས་མི་བསྐྱོད་པ་སྔོན་པོ་སྔོ་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི།",
    "ལུས་ཀྱི་ཚོགས་རྣམས་རྔ་ཡབ་ལ་སོགས་པ་གཞལ་ཡས་ཁང་གི་རྒྱན།",
    "དེའི་སྤྱི་བོར་གཟུགས་ཕུང་གི་ངོ་བོ་ཨོ་དཀར་པོ་ལས་རྣམ་སྣང་།",
    "ཀྱི་ངོ་བོ་པོ་ལས་གོས་དཀར་མོ།",
    "མིག་གི་སྒོར་གཟུགས་ཀྱི་ངོ་བོ་ཛལས་གཟུགས་རྡོ་རྗེ་མ།",
    "པུས་མོ་གཡས་པར་གཡས་དྷཱི་། པའི་ངོ་བོ་ཧཱུྃ་ལས་དབྱུག་སྔོན་ཅན།",
    "ངརྐང་མཐིལ་གཉིས་སུ་རྐང་མཐིལ་གྱི་ངོ་བོ་ཧཱུྃ་ལས་གནོད་མཛེས་རྒྱལ་པོ་རྣམས་ཏེ་རང་གི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཐམས་ཅད་ལྷའི་ངོ་བོར་གྱུར།",
    "ཨོཾ་ཨཱསླརེ་བཛཱི་ཧཱུྃ།",
    "ཨོཾ་བཛྲ་ས་ཏྭ་ཧཱུཾ་ཨ་བྷི་ཥིཉྩ་བཛྲ་ནཱ་མ་ཨ་བྷི་ཥེ་ཀ་ཏ་ཧེ་ཤྲཱི་ཆེ་གེ་མོ།",
    "རང་གིས་ཀྱང་དེ་ལྟར་བྱས་ཏེ།",
    "ཀྱེ་དཔལ་ཆེ་གེ་མོ་ཞེས་བྱ་བའི་དེ་བཞིན་གཤེགས་པ།",
    "མི་ཤེས་པའམ་གཏི་མུག་གིས།",
    "རང་གིས་བདག་ཉིད་ཡོངས་བཏང་སྟེ།",
    "ཨོཾ་ལས་འཁོར་ལོ་ཨོཾ་གྱིས་མཚན་པ་ལས་དྷཱི་། རྣམ་སྣང་དཀར་པོ་དཀར་ནག་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི།",
    "ཆུའི་ལྷག་མ་ཡར་ལུད་པ་ལས་རྣམ་སྣང་གིས་དབུར་བརྒྱན།",
    "ཆུའི་ལྷག་མ་ཡར་ལུད་པ་ལས་རིན་འབྱུང་གིས་དབུར་བརྒྱན།་",
    "ཨཱཋལས་པདྨ་ཨཱས་མཚན་པ་ལས་འོད་དཔག་མེད་དམར་པོ་དམར་ནག་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི།",
    "ལྗང་ནག་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི།",
    "གཙོ་བོའི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས་པ་རང་གི་ལུས་ལ་ཕོག་པས་སྡིག་སྒྲིབ་ཐམས་ཅད་སྦྱངས་ཏེ་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་དཀྱིལ་འཁོར་གྱི་གཙོ་བོའི་ཞལ་དུ་ཞུགས།",
    "སྐའི་དབྱིབས་བརྒྱད་ནས་ལྷ་མོའི་པདྨར་ཐོན་པ་ཧཱུྃ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་བརྒྱ་རེ་གཉིས་ལས་རྡོ་རྗེ་འཆང་སྔོན་པོ་སྔོ་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི།",
    "དྷཱི་། གཞལ་ཡས་ཁང་གི་རྒྱན།",
    "ལྟོ་བ་བུམ་པ་སྟེ་རྡོ་རྗེ་འཆང་གི་ལུས་རང་བཞིན་གྱིས་གྲུབ་པའི་ངགཞལ་ཡས་ཁང་དུ་གྱུར།",
    "དེའི་སྤྱི་བོར་གཟུགས་ཕུང་གི་ངོ་བོ་ཨོཾ་དཀར་པོ་ལས་རྣམ་སྣང་།",
    "ལྟེ་བར་ས་བརྒྱ་རེ་གསུམ་ཁམས་ཀྱི་ངོ་བོ་ལོ་ལས་སྤྱན་མ།",
    "མགྲིན་པར་མེ་ཁམས་ཀྱི་ངོ་བོ་པོ་ལས་གོས་དཀར་མོ།",
    "མིག་གི་སྒོར་གཟུགས་ཀྱི་ངོ་བོ་ཛལས་གཟུགས་རྡོ་རྗེ་མ།",
    "པུས་མོ་གཡས་པར་གཡས་པའི་ངོ་བོ་ཧཱུཾ་ལས་དབྱུག་སྔོན་ཅན།",
    "རྐང་མཐིལ་གཉིས་སུ་རྐང་མཐིལ་གྱི་ངོ་བོ་ཧཱུྃ་ལས་གནོད་མཛེས་རྒྱལ་པོ་རྣམས་ཏེ་རང་གི་ཕུང་།",
    "སྟོང་པའི་ངང་ལས་ཧཱུྃ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་ལས་རྡོ་རྗེ་སེམས་དཔའ་དཀར་པོ།",
    "དེ་རིང་ཁྱོད་ལ་བསྐུར་བར་བྱ།",
    "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་བཅང་།",
    "བཅོམ་ལྡན་འདས་དང་པོ་མཆོག་གི་སྐྱེས་བུའོ།",
    "དྲིལ་བུ་མི་དམིགས་ཏེ་སྟོང་པའི་ངང་ལས་ཨ་ལས་རྡོ་རྗེ་ཨས་མཚན་པ་ལས་རྡོ་རྗེ་སྙེམས་མ་དཀར་མོ་ཞུ་བ་ལས་བྱུང་བའི་དྲིལ་བུར་གྱུར།",
    "ཅེས་བརྗོད་ལ་གཏད་པ་རང་གིས་ཀྱང་ལན་གསུམ་དཀྲོལ་ཞིང་།",
    "ཨོཾ་ཨཱམོ་ཧ་ར་ཏཱི་ལཾ་ཧཱུྃ་ཨོཾ་ཨཱཋབཛྲ་ཨ་བྷི་ཥིཉྩ་ཧཱུཾ་སུ་ར་ཏི་ཙཱ་ཨ་ཧཾ།",
    "ཨོཾ་ཨཱཋམ་ཧཱ་བརྒྱ་རེ་དྲུག་༧ བ་ལ་ཧཱུྃ་ཧཱུྃ་ཨོཾ་ཨཱཋབཛྲ་ཨ་བྷི་ཥིཉྩ་ཧཱུཾ་སུ་ར་ཏི་ཙཱ་ཨ་ཧཾ།",
    "སྔགས་ཐམས་ཅད་སྦྲེལ་བའི་མཐར་ཨོཾ་ཨཱབཛྲ་སོགས་ཚར་གཅིག་བཏགས་པ་གང་རུང་གི་མཐར།",
    "ཁྱོད་ཀྱིས་སྲོག་ཆགས་བསད་པར་བྱ།",
    "མ་བྱིན་པར་ཡང་ཁྱོད་ཀྱིས་བླང་།",
    "ཉོན་མོངས་ཐམས་ཅད་སྤོང་བ་དང་།",
    "དྷཱི་། རང་གི་དམ་ཚིག་རྟག་ཏུ་བསྒྲུབ།",
    "ཁྱོད་ཀྱིས་རྟག་ཏུ་བསྲུང་བར་བྱ།",
    "གིས་བསྐོར་བ་ལས་སྔགས་ཕྲེང་གཉིས་པ་བྱུང་།",
    "རང་གི་ཁར་ཞུགས་ཏེ་ཏིང་ངེ་འཛིན་སེམས་དཔའི་མཐའ་སྐོར་དུ་འཁོད་པར་གྱུར།",
    "བཅོམ་ལྡན་བདག་གིས་གཟུང་ལགས་ཀྱི།",
    "རང་སྐད་ཅིག་གིས་རྣམ་པར་སྣང་མཛད་དུ་གྱུར།",
    "ཁྱོད་ནི་བདུད་རྣམས་ལས་རྒྱལ་ཏེ།",
    "བུ་ཁྱོད་ཀྱིས་ནི་དེ་མི་བྱ།",
    "མཉམ་མེད་ཁྱོད་ཀྱིས་བསྒྲག་པར་བྱ།",
    "ཨོཾ་ཙཀཱུ་བནྡྷ་ཝ་ར་མ་ཎཱ་ཡ་ཧཱུྃ་གིས་གདོང་བཅིང་།",
    "བདག་ཉིད་ཅན་ཡུམ་རེག་རྡོ་རྗེ་མ་དང་བཅས་པ་གཉིས་ཀའང་རིགས་ལྔ་ལ་སོགས་པ་ལྷའི་ཚོགས་པ་ཅན་དུ་གྱུར་པའི་ཡབ་ཀྱི་གསང་བའི་གནས་ཧཱུྃ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་༣༧པའི་ནོར་བུ་ལ་ཨོཾ་དཀར་པོས་མཚན་པ་དང་།",
    "ཞེས་བྱིན་པ་དེ་རང་གི་ལུས་དཀྱིལ་གྱི་ལྷ་ཐམས་ཅད་མཉེས་པའི་ཕྱིར།",
    "གཱདེ་ནས་རྣམ་སྣང་གི་ང་རྒྱལ་ལས་འཕོས་ནས།",
    "ངག་གི་དྲི་མ་འཁྲུད།",
    "ཐལ་མོ་སྦྱར་ནས།",
    "ཨོཾ་ཙཀཱུ་བནྡྷ་ཝ་ར་མ་ཎཱ་ཡ་ཧཱུྃ་གིས་གདོང་བཅིང་།",
    "༣༨བདག་གིས་འདི་ལ་འདི་གཏད་དོ།",
    "གཟུངས་མ་ཡིད་འོང་འདི་ཁྱོད་ཀྱིས།",
