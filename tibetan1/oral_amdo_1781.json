    "བདག་གི་དབྱིག་གསེར་ནོར་འབྲུ་ལང་ཚོ་ཚེ།",
    "རེངས་དང་བཅིངས་དང་རྣམ་པར་འཇིག་པར་མཛོད།",
    "གཡས་རྡོ་རྗེ་དང་བཅས་པའི་ཐལ་མོ་གྱེན་སླང་དང་།",
    "མུཞེས་པས་ལག་པ་གཡས་ས་ལ་རེག་སྟེ།",
    "ཨོཾ་ཨཱབིནྡྷན་ཏ་ཀྲྀཏ་ཧཱུྃ་གིས་བསང་།",
    "རོལ་མོ་ལ་སོགས་པའི་མཆོད་རྫས་རྣམས་དངས་ཤིང་ཐོགས་པ་མེད་པ།",
    "བསྐུལ་བའི་སྣ་ཚོགས་རོལ་མོ་ལ།",
    "གསུམ་པའི་ཚེ་མཆོད་རྫས་བྱིན་གྱིས་བརླབ་པར་བསམ་མོ།",
    "དཀྱིལ་འཁོར་རྒྱལ་མཆོག་གི་ཏིང་ངེ་བ་རྒྱད་འཛིན་ལས་རྒྱལ་མཆོག་གི་ཏིང་ངེ་འཛིན་ནོ།",
    "དེའི་དང་པོའི་ཐོག་མར་ཐུན་མོང་གི་སྔོན་འགྲོ་གསུམ་སྤྱི་ལྟར་ཕྱག་འཇམ་རྡོརལེན་ལ་མཛད་པས།",
    "ཁྱེད་རྣམས་ཀྱིས་བདག་གི་རྒྱུད་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "སྐྱབས་ཡུལ་རྣམས་འོད་དུ་ཞུ་ནས་རང་ལ་ཐིམ་པར་བསམ་མོ།",
    "དེའི་ཆེད་དུ་བདག་གིས་ལམ་དྷཱི་༧། ཟབ་མོ་ཉམས་སུ་བླང་བར་བགྱིའོ།",
    "རང་གི་སྤྱི་བོར་སྣ་ཚོགས་པདྨ་དང་ཟླ་བའི་གདན་ལ་སྐད་ཅིག་གིས་རྡོ་རྗེ།",
    "སེམས་དཔའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "རྡོ་རྗེ་ཐལ་མོ་སྦྱར་ཏེ།",
    "སྐུ་གསུང་ཐུགས་རྩ་བ་དང་ཡན་ལག་གི་དམ་ཚིག་ཉམས་པ་ཐམས་ཅད་མཐོལ་ལོ་བཤགས་སོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཡབ་ཡུམ་འོད་དུ་ཞུ་ནས་རང་ལ་ཐིམ་པས་རང་གི་ལུས་འཇའ་ཚོན་ལྟ་བུར་གྱུར།",
    "ཐུན་མོང་མ་ཡིན་པའི་སྔོན་འགྲོ་གསུམ་གྱི་དང་པོ་ནི།",
    "སོར་མོ་ལྷག་མ་གསུམ་བརྐྱངས་པའི་རྩེས་དྲི་ཆུ་བླངས་ཏེ་ལྷ་རྣམས་ལ་བྱུགས་པའི་ཚུལ་བྱ་ཞིང་།",
    "རྡོ་རྗེ་ཐལ་མོ་ཁ་གྱེན་དུ་ཕྱེ་བའི་ཕྱག་རྒྱ་དང་།",
    "། ནས་འོད་ཟེར་གྱི་རྩེ་མོ་ལས་བྱུང་བའི་སྤྲུལ་པའི་ལུས་རྣམས་ཀྱིས་ཚོགས་ཞིང་རྣམས་ཀྱི་སྤྱན་སྔར་པུས་མོ་བཙུགས་ནས།",
    "མ་ལུས་ཀུན་རྟོག་གིས་བསགས་རྙོག་པ་རྣམས།",
    "རང་གི་ཡིད་ལ་གནས་པར་གྱུར་པ་ཡིས།",
    "སྒྲིབ་པ་ཀུན་གྱི་བག་ཆགས་ཡང་དག་འབྱིན་། ལྷག་པར་མོས་པས་རྣམ་པར་བརྒྱན་པ་ཡི།",
    "དམར་པོ་གཉིས་ཀྱི་བར་དུ་ཆུད་པར་བསྒོམ་ནས་རྣལ་འབྱོར་པ་རང་གི་སེམས་ཉིད་དེའི་གཟུགས་སུ་ལངས་པར་བསམ་མོ།",
    "བཅུ་གཉིས་རྩེ་མོ་རྣོ་བ་ཁོག་པ་སྟོང་པ་ཡངས་ཤིང་རྒྱ་ཆེ་བར་བསམས་ལ།",
    "དེའི་དབུས་དང་ཕྱོགས་བཅུར་པདྨ་དང་ཉི་མའི་དཀྱིལ་འཁོར་རེ་རེ།",
    "དེ་རྣམས་ཀྱི་སྟེང་དུ་ཧཱུྃ་རེ་རེ།",
    "དེ་ཡང་སྟེང་གི་སེར་པོ།",
    "༣༤ ༡རྩེ་གསུམ་པ་རྣམས་ཧཱུཾ་གིས་མཚན་པ།",
    "དེ་ལས་འོད་ཟེར་ཁ་དོག་ནག་པོ་འཕྲོས་ཏེ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་རེག་པ་ལས།",
    "བདེ་བ་ཆེན་པོ་ཐོབ་སྟེ་ཞལ་གསུམ་ཕྱག་དྲུག་པར་གྱུར་ནས་རང་རང་གི་ས་བོན་ལ་ཞུགས་ཏེ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "དབུས་སུ་རང་ཉིད་རྡོ་རྗེ་ཧཱུྃ་མཛད་ནག་པོ་ནག་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "འོག་ཏུ་རྡོ་རྗེ་གནོད་མཛེས་སྔོན་པོ་རྟོགས་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "སྟེང་དུ་གཙུག་ཏོར་འཁོར་ལོས་སྒྱུར་བ་སེར་པོ་སེར་སྔོ་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "གཡོན་འོག་མ་གཉིས་ཀྱིས་ནོར་བུ་དང་པདྨ་འཛིན་ངདྷཱི་། པ་ཤར་དུ་གཤིན་རྗེ་མཐར་བྱེད་ནག་པོ་ནག་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "ལྷོར་ཤེས་རབ་མཐར་བྱེད་དཀར་པོ་དཀར་ནག་དམར་བའི་ཞལ་བགསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "ནུབ་ཏུ་པདྨ་མཐར་བྱེད་དམར་པོ་དམར་སྔོ་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "བྱང་དུ་བགེགས་མཐར་བྱེད་ནག་པོ་ནག་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་འཇམ་རྡོརདྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "ཤར་ལྷོར་མི་གཡོ་བ་ནག་པོ་ནག་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "ལྷོ་ནུབ་ཏུ་འདོད་པའི་རྒྱལ་པོ་སྔོན་པོ་སྔོ་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "ནུབ་བྱང་དུ་དབྱུག་སྔོན་ཅན་སྔོན་པོ་རྟོགས་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "བྱང་ཤར་དུ་སྟོབས་པོ་ཆེ་ནག་པོ་ནག་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་བསྣམས་པ།",
    "ལྷ་རྣམས་ཀྱི་ཐུགས་ཀར་ཉི་མ་ལ་གནས་པའི་རང་འདྲའི་ཡེ་ཤེས་སེམས་དཔའ་རེ་རེ།",
    "དེ་བཅུ་བཞི་རྣམས་ཀྱི་ཐུགས་ཀར་ཏིང་ངེ་འཛིན་སེམས་དཔའ་ཧཱུྃ་རེ་རེ།",
    "འོག་ཏུ་རྡོ་འཇམ་རྡོརརྗེའི་ས་གཞི་སྡུག་ཅིང་མཁྲེགས་པ་བར་མཚམས་མེད་པའི་རང་བཞིན་གྱི་སྲུང་བའི་འཁོར་ལོར་གྱུར་པར་བསམ་མོ།",
    "༣༤ དབུས་ཀྱི་ཧཱུྃ་མཛད་ཞུ་བ་ལས་ཧཱུྃ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ།",
    "རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "རྣམ་པ་སྣ་ཚོགས་ཀྱི་ན་བཟའ་གསོལ་ཅོ་ལྔ་བ་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པར་བསམ་མོ།",
    "དེ་དག་གི་བར་རྣམས་སུ་རྒྱལ་མཚན་དང་།",
    "དེའི་སྟེང་དུ་གདུགས་དང་གཡས་གཡོན་དུ་རི་དགས་ཕོ་མོ་དང་བཅས་པ།",
    "དེ་དག་འབྲིང་གིས་རྗེ་བཙུན་ཡུམ་བསྐྱེད་པའོ།",
    "ནམ་མཁའི་ཡི་གེ་གསུམ་གཞལ་ཡས་ཁང་གི་དབུས་སུ་བབས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་གཞལ་ཡས་ཁང་གི་སྟེང་གི་ནམ་མཁར་བཞུགས་པ་༢༤༨ལ་རྗེ་བཙུན་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་བདག་ལ་གཟིགས་པར་མཛོད་ཅིག་ཅེས་བསྐུལ་བས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཡི་གེ་གསུམ་གྱི་གཟུགས་ཀྱིས་རྣལ་འབྱོར་པའི་ལུས་ལ་ཞུགས་པར་བསམ་མོ།",
    "ཡི་གེ་གསུམ་གྱི་སྟེང་གི་ཆར་དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུའི་ངོ་བོ།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་ཧཱུྃ་དམར་པོ་ལས་རྡོ་རྗེ་དམར་པོ་རྩེ་ལྔ་པ་ལྟེ་བ་ལ་ཁདྷཱི་། ཧཱུྃ་གིས་མཚན་པ་སོ་སོར་ཀུན་ཏུ་རྟོག་པའི་ཡེ་ཤེས་སུ་བསམས་ལ།",
    "རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "ནམ་མཁའི་ཁམས་གང་བ་གྲགས་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རང་གི་བ་སྤུའི་བུ་ག་ནས་ཞུགས་ཏེ།",
    "རྗེ་བཙུན་ཡབ་རྒྱས་པར་གྱུར་ནས་ལྷ་མོ་མཉེས་པར་གྱུར་པར་བསམ་མོ།",
    "གོས་དཀར་མོ་དང་།",
    "རེག་རྡོ་རྗེའི་ངོ་བོར་བྱུང་སྟེ་རང་གི་བ་སྤུའི་བུ་ག་ནས་ཕྱིར་སྤྲོས།",
    "རྗེ་བཙུན་མའི་བ་སྤུའི་བུ་གར་ཞུགས་པས་ཡུམ་རྒྱས་པར་གྱུར་པས་རྗེ་བཙུན་ཡབ་མཉེས་པར་བསམ་མོ།",
    "དཀྱིལ་འཁོར་གྱི་སྒོ་བཞི་ནས་རྡོ་རྗེ་སེམས་དཔའི་འཇུག་པས་ཞུགས་ཏེ་བྷ་གའི་དཀྱིལ་འཁོར་གྱི་ནང་དུ་ཞུགས་པར་བསམ་མོ།",
    "གཟུགས་རྡོ་རྗེ་མ་ལ་སོགས་པའི་ལྷ་མོ་དྲུག།",
    "དེ་ནས་ཐིག་ལེ་ལས་འཕྲོས་པའི་ལྷ་མོ་བཞི་རང་རང་གི་གནས་སུ་འདུག་ནས་གླུས་བསྐུལ་ཏེ།",
    "གོས་དཀར་མོས།",
    "ཁྱོད་ནི་རྡོ་རྗེའི་གསུང་སྟེ་ཀུན་ལ་ཕན་ཞིང་ཐུགས་བརྩེ་བས།",
    "ཁྱོད་ནི་རྡོ་རྗེ་འདོད་པ་དམ་ཚིག་མཆོག་གི་ཕན་ཡོན་ཆེ།",
    "ཞེས་བསྐུལ་བས་ཐིག་ལེ་དེ་མོ་ལས་གསེར་གྱི་ཡུ་བ་ཅན་གྱི་རལ་གྲི་ལྗང་གུ་ཡུ་བ་ལ་མཾ་གྱིས་མཚན་པ།",
    "དེ་ལས་འོད་ཟེར་འཕྲོས་ཏེ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་རེག་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བདེ་བ་ཆེན་པོ་ཐོབ་པར་གྱུར་ཏེ།",
    "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པར་བསམས་ལ།",
    "གནས་རྣམས་སུ་ཟླ་བའི་དཀྱིལ་འཁོར་རེ་རེའི་སྟེང་དུ།",
    "མིག་གཉིས་ཀྱི་དབུས་སུ་ཧཱུཾ་ལས་འཁོར་ལོ་ཧཱུཾ་གིས་མཚན་པ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "རྣ་བར་ཛཱི་ལས་རྡོ་རྗེ་ཡཱཾ་གིས་མཚན་པ་ཡོངས་སུ་གྱུར་པ་ལས་ཕྱག་རྡོར་ནག་པོ་ནག་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "ལས་པདྨ་གཾ་གིས་མཚན་པ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "སྒྲ་མཚམས་སུ་ཏྟཾ་ལས་རལ་གྲི་ཏྟཾ་གིས་མཚན་པ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "སྒྲིབ་སེལ་ལྗང་གུ་ལྗང་སྔོ་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "ཀུན་བཟང་དཀར་པོ་དཀར་ནག་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "ཧཱུྃ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "ཐུགས་རྡོ་རྗེ་ནག་པོ་ནག་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "གསུང་རྡོ་རྗེ་དམར་པོ་དམར་སྔོ་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "སྐུ་རྡོ་རྗེ་དཀར་པོ་དཀར་ནག་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་།",
    "རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "ཞེས་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དྷཱི་། ཐུགས་རྡོ་རྗེ་ལ་ཞུགས་པར་བསམ་མོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ལྟཐུགས་རྡོ་རྗེ་བདག་ཉིད་ཀྱི་ཐུགས་རྡོ་རྗེ་ལ་ཐིམ་པར་བསམ་མོ།",
    "ཞེས་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་གསུང་རྡོ་རྗེ་ལ་ཞུགས་པར་བསམ་མོ།",
    "རྡོ་རྗེ་གསུང་གིས་མཛད་དུ་གསོལ།",
    "ཞེས་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གསུང་རྡོ་རྗེ་བདག་ཉིད་ཀྱི་གསུང་རྡོ་རྗེ་ལ་ཐིམ་པར་བསམ་མོ།",
    "ཞེས་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་སྐུ་རྡོ་རྗེ་ལ་ཞུགས་པར་བསམ་མོ།",
    "ངཀྱི་སྐུ་རྡོ་རྗེ་བདག་ཉིད་ཀྱི་སྐུ་རྡོ་རྗེ་ལ་ཐིམ་པར་བསམ་མོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་འཇམ་པའི་རྡོ་རྗེའི་རྣམ་པར་སྤྱན་དྲངས་ནས་མོ་ལ་ཐིམ།",
    "ཨོཾ་ཏཱ་རེ་ཏུཏྟཱ་རེ་ཏུ་རེ་སྭཱ་ཧཱ།",
    "ཆུའི་ལྷག་མ་ཡར་ལུད་པ་ལས་ལྷ་མོ་རྣམས་སྤྱི་བོར་ཐིམ་པས།",
    "སྒྲིབ་པ་རྣམ་སེལ་ལ་དོན་ཡོད་གྲུབ་པས་དབུར་བརྒྱན་པར་བསམ་མོ།",
    "རང་གི་མདུན་དུ་ཨ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་རྣལ་འབྱོར་པ་རང་ཉིད་ཡི་གེ་གསུམ་གྱི་གཟུགས་སུ་གནས་པའི་ཡེ་ཤེས་ཀྱིས་བསྐུལ་བས།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་གཞལ་ཡས་ཁང་གི་སྟེང་གི་ནམ་མཁར་བཞུགས་པ་ལ།",
    "རྗེ་བཙུན་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་བདག་ལ་གཟིགས་པར་མཛོད་ཅིག།",
    "དྷཱི་། དེའི་འོག་གི་ཆར་མཚན་བཟང་པོ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་ངོ་བོ།",
    "ཡི་གེ་གསུམ་གྱི་སྟེང་གི་ཆར་དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུའི་ངོ་བོ།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་ཧཱུྃ་དམར་པོ་ལས་རྡོ་རྗེ་དམར་པོ་རྩེ་ལྔ་པ་ལྟེ་བ་ལ་ཧཱུཾ་གིས་མཚན་པ་སོ་སོར་ཀུན་རྟོག་པའི་ཡེ་ཤེས།",
    "རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "དྷཱི་། དེ་ནས་ཐིག་ལེ་ལས་འཕྲོས་པའི་ལྷ་མོ་བཞི་རང་རང་གི་གནས་སུ་འདག་ནས་གླུས་བསྐུལ་ཏེ།",
    "གོས་དཀར་མོས།",
    "ཁྱོད་ནི་རྡོ་རྗེའི་གསུང་སྟེ་ཀུན་ལ་ཕན་ཞིང་ཐུགས་བརྩེ་བས།",
    "ཁྱོད་ནི་རྡོ་རྗེ་འདོད་པ་དམ་ཚིག་མཆོག་གི་ཕན་ཡོན་ཆེ།",
    "དེ་ལས་འོད་ཟེར་འཕྲོས་ཏེ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་རེག་པས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བདེ་བ་ཆེན་པོ་ཐོབ་པར་གྱུར་ཏེ།",
    "འཇམ་པའི་རྡོ་རྗེ་མ་ཞལ་གསུམ་ཕྱག་དྲུག་མའི་གཟུགས་ཀྱི་མོ་གྱི་ཡི་གེ་ལ་ཐིམ།",
    "རལ་གྲི་མོ་དང་བཅས་པ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "གནས་རྣམས་སུ་ཟླ་བའི་དཀྱིལ་འཁོར་རེ་རེའི་སྟེང་དུ།",
    "རྣ་བར་ཚིགས་ལས་རྡོ་རྗེ་ཡཱཾ་གིས་མཚན་པ་ཡོངས་སུ་གྱུར་པ་ལས་ཕྱག་རྡོར་ནག་པོ།",
    "སྐྲ་མཚམས་སུ་ཏྟཾ་ལས་རལ་གྲི་ཏྟཾ་གིས་མཚན་པ་ཡོངས་སུ་གྱུར་པ་ལས་སྒྲིབ་སེལ་ལྗང་གུ།",
    "ནུ་མ་གཉིས་ཀྱི་དབུས་སུ་ཧཱུྃ་འཇམ་རྡོརལས་རྡོ་རྗེ་ནག་པོ་རྩེ་ལྔ་པའི་ལྟེ་བར་ཧཱུྃ་ལས་རྡོ་རྗེ་ཧཱུྃ་གིས་མཚན་པ་ཡོངས་སུ་གྱུར་པ་ལས་ཐུགས་རྡོ་རྗེ་ནག་པོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་འཇམ་པའི་རྡོ་རྗེ་མའི་རྣམ་པར་སྤྱན་དྲངས་ནས་མོ་ལ་ཐིམ།",
    "ཨོཾ་ཏཱ་རེ་ཏུ་ཏྟཱ་རེ་ཏུ་རེ་སྭཱ་ཧཱ།",
    "ཆུའི་ལྷག་མ་ཡར་ལུད་པ་ལས་ལྷ་མོ་རྣམས་སྤྱི་བོར་ཐིམ་པས་གཙོ་མོ་ངལ་མི་བསྐྱོད་པ།",
    "༣༥བར་དུ་ཁྱབ་པ་བསྒོམ་ཏེ་འདིས་ལྷ་མོ་རིགས་ལྔའི་རང་བཞིན་དུ་གྱུར་ཏོ།",
    "ཞེས་པས་ཡབ་ཡུམ་སྙོམས་པར་ཞུགས་པར་བསམ་མོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་རེག་སྟེ་བདེ་བ་ཆེན་པོ་ཐོབ་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཞལ་དུ་ཞུགས།",
    "ཟླ་བ་ཞུ་བའི་གཟུགས་སུ་གྱུར་ནས་རྡོ་རྗེ་ནོར་བུའི་ལམ་ནས་པདྨར་ལྷུང་བ་ཡོངས་སུ་གྱུར་པ་ལས་ས་བོན་མོ་གྱི་ཡི་གེར་གྱུར།",
    "དེ་ལས་མི་བསྐྱོད་པ་གཙོ་བོར་གྱུར་པའི་ལྷ་བཅུ་དགུའི་དཀྱིལ་འཁོར་ཅིག་ཆར་དུ་གྱུར་པར་བསམ་མོ།",
    "སེར་ནག་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "དམར་སྔོ་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "ལྗང་སྔོ་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་དང་པོ་གཉིས་ཀྱིས་རང་འོད་ཀྱི་རིག་མ་ལ་འཁྱུད་པ།",
    "སྣ་ཚོགས་པའི་ན་བཟའ་གསོལ་བ་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པའོ།",
    "མོ་ཧ་ར་ཏི་ཞེས་པའི་སྔགས་བརྗོད་པས།",
    "སླར་གཅིག་ཏུ་འདུས་ནས་རིང་དུ་སོང་བའི་འཇམ་རྡོརས་རྣམ་པར་དག་པ་སའི་ཁམས་དང་།"
  ]
}