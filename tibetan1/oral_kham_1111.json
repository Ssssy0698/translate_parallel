    "སྔོན་ཆད་བརྩིགས་པའི་ལྕགས་རི་རྣམས་མ་ཞིག་པར་འདུག་ལན་ཀྲོའུ་ཡུལ་གྲུ་ཀུན་ཏུ་ཆུ་འབྲས་སྐྱེས་ཤིང་།",
    "ལམ་ཡང་ཀྱག་ཀྱོག་ཏུ་འདུག་བོད་པ་རྣམས་ཀྱིས་མཁར་ལྕགས་རྩེ་ཞེས་བྱ།",
    "ས་རྡོ་རྣམས་རང་བཞིན་གྱིས་དམར་བ་ཞིག་འདུག་བོད་པས་དེ་ལ་ལ་དམར་ཞེས་བྱ།",
    "ཀྲང་ཧྲོའུ་ཀུའི་བྱ་བ་གཉིས་ཀྱིས་བཙུགས་པའི་རྡོ་རིང་འགྱེལ་འདུག་བོད་ཀྱིས་བཙུགས་པའི་རྡོ་རིང་དེ་ད་དུང་མ་འགྱེལ་བར་བསྡད་འདུག་ལ་དམར་ནས་ཁྲང་ཨན་བར་དུ་ལམ་ཐག་ལེ་དབར་སུམ་སྟོང་ལྷག་ཡོད་པ་དང་།",
    "རི་སྐེད་དུ་ཤུག་པ་སྐྱེས་འདུག་པ་དང་།",
    "རི་ཞབས་སུ་བང་སོ་མང་པོ་འདུག་བང་སོའི་ལོགས་སུ་ས་ཁང་བརྩིགས་པ་དེ་ཚོར་ཚོས་དམར་པོ་བྱུག་ཡོད་ལ།",
    "ཐུ་བོད་ཀྱིས་རི་བོ་རྩེ་ལྔའི་ས་རིས་གནང་རོགས་ཞུ་མཁན་ཕོ་ཉ་བ་མངགས་འདུག་ཅིང་།",
    "རྟིང་བརླག་པར་བྱེད་པ་ཅིག་འདུག་ཡུ་གུར་གྱི་རྒྱལ་ཁམས་འདི་ཡང་མ་བརླག་པར་གོང་དུ་ཕན།",
    "ཧོར་ཁོ་རང་འུ་ལག་དང་དམག་ཁྲལ་ཆུང་།",
    "དེ་དང་སྦྱར་ན་གཞན་ཚོ་ཆུང་བར་གདའ།",
    "ངོ་བལྟས་པ་རྣམས་བརྟན་ནམ་བྱས་པ་དེ་ཚོ་སྔོན་ལ་འདྲི་བར་འདུག་གསེར་ཡིག་པ་དེ་མ་མགུ་ན་གནོད་ཐུབ་པའི་གཏམ་གཏོང་བར་ངེས།",
    "མགུ་ན་ཕན་ཐོགས་ནུས་པ་ཅིག་གདའ།",
    "འདིར་མི་གང་དྲག་པ་དང་འདབ་ནོར་ཁྱེར་ནས་འོང་བ་ཚོ་བཟང་པོར་གཏོང་བར་གདའ།",
    "གསེར་ཡོད་ན་གང་འདོད་འོང་བར་འདུག་པས་དགོངས་མཛོད།",
    "ཞོན་ཀྲེང་ཡོན་གྱི་དཔོན་རིགས་ནང་རང་སྣང་གང་ཤར་གྱིས་གཞུང་དྲང་མི་བྱེད་པར།",
    "གོ་ཆོད་འདུག་གསུངས།",
    "སྦྱོང་སྤྱོད་ཤིན་ཏུ་ཆེ་བ་གཅིག་ཡོད་པར་འདུག་ཅིང་།",
    "ས་རིམ་ཨོ་གེར་གའི་འུ་ལག་རང་རང་ལ་བབ་བའི་དོན་ལ།",
    "ད་དུང་ཡང་འདང་མིན་ལ་བརྟེན་དངོས་པོའི་སྐྱོབ་གསོ་ཅི་ནས་ཀྱང་ཡོང་བའི་སྐྱབས་འཇུག་གནང་རོགས་ཞེས་བརྗོད་ཀྱི་འདུག་དེ་མིན་ཏི་ཤྲཱིའི་བཀའ་ལྟར་ན།",
    "ད་ལྟ་སྔར་སྲོལ་ལྟར་སྐྱོབ་གསོ་གནང་དགོས་པ་འདུག་ཅེས་བརྗོད་ཀྱི་འདུག་བདག་ཚོ་བློན་འབངས་རྣམས་ཀྱིས་གྲོས་ཞིབ་བྱས་པར།",
    "ལོ་དེའི་ཕྱི་ལོར་ནན་ཅིན་ཕྱོགས་སུ་ཁོ་རང་ངོ་ཕེབས་ཀྱིས་གོང་མར་མཇལ་འཕྲད་ཞུས།",
    "དམག་དམངས་རྣམས་ལས་ལ་དགའ་ཞིང་བརྩོན་པར་འདུག་ཅེས་ངེད་ལ་བརྗོད་ཀྱི་འདུག་པས།",
    "ལིའུ་ཡུན་གྱིས་ཁོ་རང་གང་སླེབས་ཀྱི་ལམ་འཁེལ་ས་གནས་ཁག་ནས་ཇ་ཚྭ་གཉིས་ཀྱི་ཁེ་བགོས་དངུལ་གྲངས་ཆིག་འབུམ་ཙམ་བླངས།",
    "དེ་ནས་ཧོའུ་ཞན་གྱིས་རྟ་པ་མངགས་ཏེ་གོང་མ་ཆེན་པོར་ཁོ་རང་མཐའ་མཚམས་སུ་འབྱོར་བའི་ཞུ་ཡིག་ཕུལ་བར་བརྟེན་གོང་ནས་མུ་ཞིན་གདན་ཞུར་མངགས།",
    "ལྐོག་གཤོམ་གྱི་བྱ་ངན་དེ་ཀྲིང་ཧོ་ཡིས་རྟོགས་ཏེ་ཁོ་རང་རྒྱལ་ཁབ་དེ་ནས་ཁ་གྱེས།",
    "ཁོ་བོས་འབད་བརྩོན་ཆེར་བསྐྱེད་དང་དོ་ནན་ཡིད་གཟབ་ངང་རང་འགན་ལྷུར་ལེན་བྱེད་པ་ལས།",
    "ཁོ་བོས་འབད་བརྩོན་ཆེར་བསྐྱེད་དང་རང་འགན་ལྷུར་ལེན་བྱེད་པ་ལས་འབུལ་མཚོན་དེ་ཁོ་བོ་མི་སྒེར་གྱིས་ཞུ་ལེན་གཏན་ནས་བྱེད་མི་ཕོད།",
    "ཁོ་རང་རང་ཉིད་ཀྱི་མཚན་སོགས་ཚང་མ་ཁ་གསལ་འགོད་དགོས་པ་ལས་གཡོ་ཁྲམ་བྱེད་དུ་བཅུག་མི་རུང་།",
    "དེའི་ཕྱིར་ད་ལམ་དོན་དེར་ཚོད་འཛིན་ཡག་པོ་གནང་དགོས་ངེས་འདུག་ཅེས་གསུངས།",
    "བོད་ཀྱི་རྒྱལ་བུའི་ཐམ་ཡིག་དང་ཝང་ཤུ་ཡང་འཁྱེར་མིན་འདུག་ད་ལམ་དེའི་གྲས་མི་གྲངས་བཅུ་ལྷག་ཙམ་ཡུལ་ཟོག་སྲུང་འཇགས་སུ་ཉར་བ་ལས་དེ་བྱིངས་ཚང་མ་རང་ཡུལ་དུ་ཕྱིར་སློག་བྱས་ཟིན་པ་ཡིན།",
    "ཁྱེད་རང་རྣམས་ཀྱང་ཚེ་དཔག་མེད་ཀྱི་སྐུར་གསལ་བའི་སྤྱི་བོར་ཡེ་ཤེས་ཨོཾ་དཀར་པོ།",
    "རྒྱུད་འཛིན་བུ་ལ་གདོང་གྲོགས་མཛོད། དེ་ལྟར་བྱིན་ཆེན་དབབ་ཅིང་གསོལ་བ་བཏབ་པ་ཙམ་གྱིས་མདུན་གྱི་ནམ་མཁར་བཞུགས་པའི་ཡེ་ཤེས་སེམས་དཔའི་ལྷ་ཚོགས་དེ་དག་མུས་པ་ཁྱེད་རང་དམ་ཚིག་སེམས་དཔའ་ལ་མཚོ་ལ་ཁ་བ་བབས་པ་ལྟར་སིབ་ཀྱི་ཐིམ་པས་ལུས་ངག་ཡིད་གསུམ་རྒྱལ་བའི་སྐུ་གསུང་ཐུགས་ཀྱི་རང་བཞིན་རྡོ་རྗེ་གསུམ་གྱི་ངོ་བོ་མི་ཟད་རྒྱན་གྱི་འཁོར་ལོ་གྱུར་པའི་ངེས་ཤེས་བརྟན་པོ་གནང་བ་ཞུ།",
    "ཡང་དཀྱིལ་འཁོར་ཕྱོགས་བཞི་ནས་སྤྲུལ་པ་རྣམ་པ་བཞི་ལས་སོ་སོ་རང་འདྲའི་སྐུ་འཕྲོས་ནས་ཁྱེད་རང་རྣམས་ལ་ཐིམ་པས་མ་རིག་ལས་༦༢",
    "དེ་ནས་ཡང་དཀྱིལ་འཁོར་གྱི་སྒོ་བཞི་ནས་སྒོ་བ་ཡབ་ཡུམ་རྣམས་ལས་རང་འདྲའི་སྐུ་འཕྲོས་ནས་ཁྱེད་རང་རྣམས་ལ་ཐིབ་པས།",
    "འཆི་མེད་གྲུབ་པའི་གཏའ་རུ་བཟུང་བའི་རྗེས་རྫས་ཀྱི་ཚེ་མདའ་འདི་ལས་འོད་ཟེར་རྡོ་རྗེའི་ལུ་གུ་རྒྱུད་དུ་འཕྲོས་པ་ཁྱེད་རང་རྣམས་ལ་ཕོག་པས་ལུས་ཐམས་ཅད་ཡེ་ཤེས་ཀྱི་རྡོ་རྗེའི་གོ་ཁྲབ་ཀྱིས་བར་འཚམས་མེད་པར་གཡོགས་ཤིག་བཏམས་ཏེ།",
    "ལྷ་སྦྱིན་གདིང་བ་འཇམ་པོ་བཏིང་བའི་མལ་ཆ་ལ་ཉལ་ལམ་འདུག་ཀྱང་རུང་སྟེ།",
    "འདུག་གོ།",
