    "ཇི་ཙམ་ན་ལྡམ་ཐམས་ཅད་མི་གཙང་བས་གཏོར་ཅིང་ཝས་ཀྱང་ཟོས་ཏེ་ཟོང་དུ་མི་རུང་བར་ིམཐོང་ནས་དེ་ལག་པ་འགྲམ་པ་ལ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་དང་།",
    "འདི་ཇི་ལྟར་འོང་བའི་སྟངས་ལས་ན་འདིས་བདག་ཟན་གཅོད་པར་བྱེད་དོ་སྙམ་དུ་རིག་ནས་དེ་ཤིང་ལྗོན་པ་དེ་ལས་བབས་ཏེ་ིའདུག་གོ།",
    "དགེ་སློང་དེ་ཤིང་ལྗོན་པ་ལ་མི་གང་ཙམ་དུ་འཛེགས་ཏེ་འདུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་འཛེགས་པར་མ་གནང་བས་ཇི་ལྟར་མཐོར་འཛེག་སྙམ་ནས་དེ་དེ་ཉིད་དུ་འདུག་པ་དང་།",
    "༣༡ ༧སྣར་ཞོལ་འདུག་གཡུང་ཐོ་བཙམས།",
    "༩༨ ༧གཡུང་པེ་འདུག་སྣར་རྣམས།",
    "༧ སྣར་ཀྱི་༡ཉེ་གཡུང་འདུག་༧གཡུང་པེ་སྣར་སྤྱངས།",
    "༡ གཡུང་མཐའ་གཅིག་ཏུ་འདུག་གོ།",
    "སྣར་ཁོངས་སུ་ཆུད་ཅིང་འདུག་སྣར་ཞོལ་ཀྱི།",
    "༤༧༩ སྣར་ལྟ་ཅི་སྨོས་འདུག་པར་ཤེས་པ།",
    "གཡུང་རང་།",
    "གཡུང་པེ་འདུག་༡གཡུང་ལི་པེ་ཅོ་ཀྱིས།",
    "ཉེ་དགའས་ཆེད་ཁོང་དུ་ཆུད་ཅིང་འདུག་༦༢༩༧པེ་མི་རུང་བས་དེ།",
    "གནོད་སྦྱིན་སོགསཀྱིས་རང་རང་གཾ་སྔགས་ཀྱིས་བྱིན་གྱིས་བརླབས་པ་ལྟ་བུའོ།",
    "སྔགས་ཐམས་ཅད་ཤེས་པར་དོན་གྱིས་ཁས་བླངས་འདུག་པས་ཅི་འཇིག་རྟེན་ན་དེ་ལྟར་གྲགས་བསྐྱངས།",
    "ཕེབས་འདུག་པ་ལ།",
    "ལྷོ་ཕྱོགསསུ་གདན་ཁྲིརྔན་པོ་བཤམས་ནས་རྒྱལ་པོ་བློན་པོའི་འཁོར་དང་བཅས་པ་འདུག་ག།",
    "འདུག་པ་དང་།",
    "ཞེ་སྡང་རང་སྣང་ཞུགསཀྱི་ཕུང་པོ་བསྐལ་པའི་མེ་དཔུང་བཞིན་འབར་བ།",
    "འཇམ་དབྱངས་ཨར་པ་ཙ་ནའི་རྗེསགནང་།",
    "རང་རང་གནས་སུ་འགྲོ་བར་གྱིས།",
    "དེ་བཞིན་དུ་དམ་བཅའ་དང་རང་ཚིག་འགལ་བ་དཔེར་ན་དགེ་སྦྱོང་མ་སྦྲུམ་མ་ཅེའམ་བདག་མེད་དོ་ཞེས་པ་ལྟ་བུའོ་ཟེར་བའང་དམ་བཅའ་དངོས་སུ་བརྗོད་ན་ངག་ལྷག་པས་བསྒྲུབ་པའི་ཡན་ལག་མ་ཡིན་པ་བརྗོད་པའི་རྒོལ་བ་ཚར་གཅད་ཀྱི་གནས་སོ།",
    "ཁྱེད་ཀྱིས་གཙོ་བོར་འཛིན་རྒྱུ་ཞྭ་ལུའི་འགྲེལ་པ་ཡིན་འདུག་བཞིན།",
    "འོ་ན་མེད་ངེས་ཤེས་མཁན་ཁྱེད་རང་ཡང་མི་རབས་བརྒྱ་ཕྲག་གོང་ནས་ཡོད་དགོས་པ།",
    "ཁྱེད་རང་ཕྱོགས་ཀྱི་སྐད་ལ་ས་ཐམས་ཅད་པའམ།",
    "འཇིགས་བྱེད་ཀྱི་ལྷོ་སྦྱོར་ཡ་མཱན་ཏ་ཧྰུྃ་ཛ་ཞེས་གསུངས་པ་འདུག་ཀྱང་།",
    "བརྐྱང་ཚུན་ཆད་ཀྱིས་འབྲེལ་བ་བཞག་པ་མང་དུ་འདུག་པས་བདེ་བ་ཅན་དུ་གནས་སྤོར་ན་འབྲེལ་བ་དང་།",
    "རྣམ་པར་རྟོག་པ་དངབཅས་པའི་བློས་ཁྱབ་བྱེད་རྒྱུ་འདུག་ལ།",
    "ང་རང་མི་ལ་རས་པ་སྨྱོ།",
    "ང་འདུག་པ་འམ།",
    "མ་བྱུང་འདུག།",
    "ཙ་ན་ཡང་ངོ།",
    "བཱི་རབ་ཏུ་སྐྱེ་བ་དང་མཛེས་པ་དང་འདུག་པ་དང་ཟ་བ་རྣམས་ལ་ཡང་ངོ།",
    "དྭངས་གཙང་རང་བཞིན་མ་བསླད་འོད་མདངས་རྒྱས་ཤིང་།",
    "བོད་མི་རྒན་གཞོན་ཚང་མའི་སེམས་རྟེན་རྒྱལ་སྲས་ཁྱེད་རང་ཁོ་ན་ལགས།",
    "ཁམས་ཀྱི་ཕྱོགས་ནས་ཁ་རོག་མི་འདུག་ལ་རྒྱའི་དར་ཆ་གྱེན་དུ་བསྒྲེངས།",
    "ད་ནི་ཁྱེད་རང་ཁ་བའི་ལྗོངས་སུ་བྱ་བཞིན་འཕུར་ལ་ཉེ་འདུག་པས།",
    "རང་རང་ས་ནས་ལམ་ལ་ཆས་འགྲོ་བརྡ་འཕྲིན་བརྒྱུད་ནས་རྗེས་སུ་མཇལ།",
    "བརྩེ་ཆེན་ཕ་མའི་ལྷད་མེད་དྭངས་གཙང་མ་རྒས་སྔར་བཞིན་ལྷག་འདུག་ལ།",
    "དྲིན་ཆེན་ཕ་མ་སྔུན་ན་ཡོད་པས་བུ་ངའི་སེམས་པ་ལྷོད་ཅིག་འདུག།",
    "རྒྱ་ནག་སྐྱུ་མའི་གྲོང་ན་གཉིད་ལ་ཤོར་འདུག།",
    "ཤཱཀྱ་ཐུབ་པའི་བསྟན་པ་སྣུབ་མཁན་ལོས་ཡིན།",
    "ཁ་མཆུ་རྒོད་པོས་ཁ་རོག་འདུག་ཐབས་བྲལ།",
    "ལྡང་འདུག་གཏད་སོ་བྲལ་བའི་སྐབས་རྣམས་སུ།",
    "ཁྱེད་ཀྱི་བཞུར་རྒྱུན་བྱུང་བའི་ཡ་ཐོག་དུས་ནས།",
    "འཛམ་གླིང་མཐོ་སྒང་ཞིང་ལ་མཛེས་པར་བརྐོས་འདུག།",
    "སྐྱེས་སྦྱངས་རྣམ་དཔྱོད་དཔུང་བ་ལྷོད་ལྷོད་དུ་འདུག་སྟེ།",
    "གྲྭ་བས་ཀྱང་རང་སྲོག་འབེན་ལ་འཛུགས་བཞིན་ཡོད།",
    "གྲྭ་བས་ཀྱང་རང་ཉིད་མི་རུ་བརྩི་བཞིན་ཡོད།",
    "འཇིག་རྟེན་འོད་ཀྱི་དྭངས་མ་ཁྱེད་རང་དང་ངེད་གཉིས།",
    "ང་རང་ཁྱེད་ཅག་དང་རྒྱང་རིང་སྟེ།",
    "སྣང་བ་སྟོང་ཁམས་ཀྱི་བཀོད་པ་མཚར་པོ་འདུག་གམ།",
    "ཁྱེད་རང་ལྷུང་ལྷུང་འབབ་པའི་ཆུ་ལ་བཞུད་ན།",
    "འགྲོགས་འདྲིས་ལག་ཏུ་ལྷུང་འདུག།",
    "བྱེའུ་ཚང་ཆགས་ཐབས་མི་འདུག།",
    "བསིལ་བའི་དགོས་པ་མི་འདུག།",
    "སྐབས་དེར་ང་རང་ཕ་མའི་དྲུང་ན་ཡོད།",
    "ང་རང་གངས་རི་མཐོན་པོ་དང་སྤང་ལྗོངས་ཡངས་པོར་དམ་དུ་འཁྱིད་དེ་ཡོད་ན་ཡང་།",
    "ང་རང་གཏན་ནས་མ་གློད་རོགསཞེས་འབོད་བཞིན་ཡོད།",
    "སྐྱེ་སྔོན་ལས་ཀྱིས་ཉེས་ཚད་གཅོད་ཀྱིན་འདུག་། ནོར་ལྡེའི་ཚགས་ཤོག་ཏུ་བཀོད།",
    "༣སྒྲོལ་མའི་ལས་ཀྱི་བསྐོས་ཐང་ཨ་རིར་འདུག།",
    "འཁྱག་དུས་འཁྱག་དུས་དྲོན་པོ་གོས་ཤིག་བྱོས།",
    "སྒྲོལ་མའི་ཞགས་ཐག་འདར་བའི་ལག་པས་ཁྱེད་རང་དམ་དུ་སྡོམ།",
    "ངག་ནི་སྔར་ནས་ལྐུགས་པར་གྱུར་ནས་འདུག།",
    "ང་རང་གཏི་མུག་གཉིད་ལས་ཐོལ་གྱིས་དཀྲོགས།",
    "བདག་ཉིད་གཅིག་པུ་མལ་སར་ལུས་འདུག་གོ།",
    "ཁྱེད་རང་བདག་སེམས་ཀྱི་གར་སྟེགས་ན།",
