    "ང་རང་ནི་མཁོས་མེད་པས་ཐབས་ཅི་ཡང་མི་འདུག།",
    "ལྷོངས་ཀྱང་གནས་བཀའ་གཉེན་པོ་འདུག་པའི་སྟབས་ཀྱིས།",
    "གསང་རྟགས་ཡིན་པས་གཏེར་ལ་སྤྱོད་ཅེས་ཁ་བྱང་དུ་འདུག་པའི་རྟགས་ཕྱི་ནང་གསང་བའི་རིམ་པ་རུ་ཡང་སེམས།",
    "འདི་དང་འཕྲད་ཚུན་བདག་གཞན་ལེགས་ཉེས་ཕྲན་བུ་སྐབས་སྐབས་གསལ་བ་སོགས་བྱུང་བས་མཁའ་འགྲོ་མ་ཞིག་ཡིན་འདོག་ཁ་འདུག།",
    "ཀ་པཱ་ལའི་ནང་དུ་ཁྲག་འཐུང་རིགས་ལྔ་གཟི་བརྗིད་དུ་ལམ་ལམ་འདུག་པ་སོགས་ཀྱི་དག་སྣང་བྱུང་བས།",
    "ང་ཤིན་ཏུ་ནས་མགུ་དཀའ་འོན་ཀྱང་ཁོ་རང་གཏེར་སྟོན་ཞིག་ཡིན་པ་འདྲ་ཨ་བ་ཧྲིག་བསམ་པར་གདའ་གསུངས།",
    "ཚེ་འཕྲང་ཡང་དམ་འདུག་པ་དང་རྐྱེན་ངན་ནམ་ཡོང་ཆ་མི་ཆོད་བསམས་ཏེ།",
    "ཚེས་བཅུ་བཏང་བས་ཆར་ཆེན་པོ་བབས་འབྲུག་གྲགས་གློག་འཁྱུག་པ་སོགས་བྱུང་བས་ལྕགས་ལ་དཔོན་དང་ས་དཀར་འགོ་པ་སོགས་གཉིས་འཛིན་གྱི་རྟོག་པ་ཟོས་འདུག།",
    "ཅི་ཆང་འདི་ནས་བཞེས་ཆོག་པ་ལ་ཟེར་བ་སོགས་མང་པོ་ལབ་འདུག།",
    "རྒྱལ་པོའི་གཟིམས་ཆུང་དུ་ཕྲ་མའི་ཡིག་འཁྱལ་བྱུང་བ་སོགས་ཀྱི་སྟབས་བདེ་ཞིག་མེད་ཉམས་འདུག་ཀྱང་།",
    "ད་ལམ་གྱི་མི་ཐོག་འདིར་ས་ལས་ཆེ་བས་ཁེངས་ལོག་ཨེ་ཐུབ་བལྟ་ཟེར་གཏམ་འདུག་སྣང་མང་པོ་བྱུང་།",
    "སྤོ་བོ་ན་རོལ་པ་སྐྱ་བདུན་གནས་རི་འདུག་པས་དེའི་མདུན་ཡུན་རིང་སྡོད་གནས་བྱས་པས།",
    "རི་ཕྲན་མང་པོའི་བསྐོར་བ་ཞིག་འདུག་ཚེ།",
    "མཚོའི་འོད་གསལ་ཁྱམ་། ཁྱམ་པ་ཞིག་འདུག་པ་འདི།",
    "གྲོང་ཆེར་མང་པོ་ཞིག་འདུག་པ་ནི།",
    "མཚོ་ཆེ་ཆུང་སྣ་ཚོགས་སུ་ཡོད་པ་འགའ་གདའ་འོ།",
    "ཡ་ཀིའི་རི་རྩེར་མཁར་དམར་པོ་གསེར་གྱི་རྒྱ་ཕིབས་ཡོད་པ་གཅིག་འདུག་པའི་ནང་དུ།",
    "ཕྱོགས་ལྷོ་ངོས་ཀྱི་ཕར་ཙམ་ཕྱིན་པས།",
    "ཞབས་རྗེས་མི་རྐང་གཉིས་འགྱུར་ཙམ་ཞིག་དང་ཕྱག་རྗེས་དེ་མཉམ་ཙམ་གཉིས་འདུག་པས།",
    "མཚམས་གཅོད་དང་ཁྲུས་སོགས་མི་མཛད་པར་འདུགང་སྔོན་ལ་འགྲོ་དང་བུ་རང་ཡང་མའི་གོས་མཐའ་ལ་ལག་པས་བཟུང་སྟེ་ཐེ་ཚོམ་མེད་པར་ཤོག་གསུངས་ཚེ།",
    "མི་རོའི་རྒྱལ་མཚན་གསུམ་སྒྲིགས་གཅིག་འདུག་པའི་དབུས་མ་ཅུང་ཟད་མཐོ་བར་འདུག་གོ།",
    "ཤིང་སྣ་འགའ་སྐྱེས་པར་གདའ་འོ།",
    "ཁང་པ་ཆེ་བ་གསུམ་སྦྲེལ་གཅིག་འདུག་གོ།",
    "རྟ་མགོ་བཞིར་མི་རོའི་རྒྱལ་མཚན་བཞི་གཙུག་ནས་འདུག་གོ།",
    "གསེར་གྱི་རྒྱལ་མཚན་བཞི་དང་མཚམས་བཞིར་བ་དན་བཞིས་བརྒྱན་པར་འདུག་གོ།",
    "ཁ་བད་ནི་གསེར་ལས་གྲུབ་འདུག་ཐོག་གསུམ་པའི་སྟེང་ན་རྒྱ་ཕིབས་གཉྫི་རས་མཚན་པའི་ཁ་བད་ཀྱི་འོག་ནས།",
    "བྲོ་རྒྱུན་མི་ཆད་པར་བརྩོན་འདུག་དཀྱིལ་འཁོར་ཆེན་པོ་དེའི་གཡས་གཡོན་ནས།",
    "རིགས་འཛིན་གྱི་གྲལ་བརྒྱད་འདུག་པ་རྣམས་ཀྱང་།",
    "འཛབ་དབྱངས་ལ་ནན་ཏན་དུ་བྱེད་པར་གདའ་འོ།",
    "ཟ་བེར་དང་པད་ཞུ་གཅིག་འདུག་པ་དེ།",
    "རིགས་འཛིན་གྱི་ཚོམ་བུ་དང་བཅས་པའི་གྲལ་དུ་འདུག་ཅིང་བསྙེན་སྒྲུབ་ལ་འཇུག་ཏེ།",
    "མངོན་སུམ་དུ་ལྷ་མེ་ལྷང་ངེར་འདུག་ཚེ།",
    "ད་ལྟ་ངེད་བོད་ཡུལ་དུ་དགེ་། བཤེས་བློ་བཟང་གྲགས་པ་ཉེ་གནས་ལེགས་སྐར་གྱི་སྐྱེ་བ་ཡིན་ཞེས་ངོས་འཛིན་མཁན་མང་པོ་ཞིག་འདུག་པས།",
    "འོ་ན་ཇོ་བོ་ལ་སྲོག་ཞུ་ཕུལ་བ་དེ་མ་ལེགས་ཟེར་མཁན་གདའ་བས་བདེན་ནམ་ལགས་ཞུས་པས།",
    "ཁོང་རྣམས་གར་འབྱོན་ཞུས་པས་མཚོ་རྒྱལ་གྱིས་ཁོང་རྣམས་མུ་ལེ་མཐིང་མཚོ་ལ་རྡུལ་ཚོན་སྐྱེལ་དུ་འབྱོན་པར་འདུག་གསུང་།",
    "སྦྱིན་སྲེག་འདེབས་པ་ཡིན་འདུག་ལྷོ་ཕྱོགས་ཀྱི་ཁྲི་བདུན་ན་འགྲོ་བ་མང་པོས་གླུ་བྲོ་བྱེད་པ་འདི།",
    "ཉི་མ་ཡང་ཤར་དྲོས་ལ་འདུག་དག་སྣང་རྣམས་གསལ་པོར་གདའ་བས།",
    "མཁའ་ལྡིང་འདབ་ཆགས་མ་གཏོགས་འགྲིམ་ལམ་ནི་མི་འདུག།",
    "འདབ་ཆགས་མཁའ་ལྡིང་མ་གཏོགས་འགྲིམ་ལམ་ནི་མི་འདུག།",
    "སྤྲུལ་པའི་བྱ་ཚོགས་མ་གཏོགས་འདུ་ས་ནི་མི་འདུག།",
    "སྤྲུལ་པའི་འདབ་ཆགས་མ་གཏོགས་འགྲིམ་ས་ནི་འདུག།",
    "སྐལ་ལྡན་། ས་ཐོབ་མ་གཏོགས་འགྲིམ་ས་ནི་མི་འདུག།",
    "ས་ཐོབ་སྐལ་ལྡན་མ་གཏོགས་འགྲིམ་ལམ་ནི་མི་འདུག།",
    "ཕྱོགས་བཅུའི་བདེ་གཤེགས་མ་གཏོགས་བཞུགས་ས་ནི་མི་འདུག།",
    "འཇའ་འོད་མཁའ་འགྲོ་ཀུན་བཟང་མཆོད་སྤྲིན་གྱིས་ཁེངས་འདུག།",
    "ཕྱི་ནང་མཆོད་སྤྲིན་མེ་ཏོག་སྦྲང་ཆར་ནི་འཁྱིལ་འདུག།",
    "དམ་ཅན་སྲུངས་མ་མ་གཏོགས་འགྲིམ་ས་ནི་མི་འདུག།",
    "སྲུངས་མ་དམ་ཅན་མ་གཏོགས་འགྲིམ་ལམ་ནི་མི་འདུག།",
    "གསང་སྔགས་གཏེར་སྒྲོམ་སྐལ་ལྡན་དང་འཕྲད་འདུག།",
    "སྣང་སྲིད་རྣམ་དག་ཅེར་མཐོང་རང་གྲོལ་ཤོག།",
    "སྤྲང་རྒན་ང་རང་ནི་འདོ་མེད་ཁོ་ན་ཞིག་ཡིན་ལགས་སོ། ། སྦྲང་བན་རིག་འཛིན་མིང་ཅན་འཕོ་ལུང་པས།",
    "ང་ཡི་འདུག་ས་བྱེད་པར་ཤོག།",
    "ང་ཡི་འདུག་གྲོགས་བྱེད་པར་ཤོག།",
    "ལྷག་པར་དགའ་རྒྱུ་ཆེན་པོ་མི་འདུག།",
    "ཡང་ནགས་ཤོད་ཁོང་ཁྱིམ་ནང་དུ་ནག་ཚང་རལ་འདུག་པས།",
    "བན་ཆུང་རང་ཉིད་ཡིན་པར་འདུག།",
    "བན་ཆུང་རང་ཉིད་ཡིན་པར་འདུག།",
    "འདུག་ས་རི་ཁྲོད་བྱེད་པར་ཤོག།",
    "འགྲོ་འདུག་སྐོར་བར་བསྒྱུར་བའི་ཚེ།",
