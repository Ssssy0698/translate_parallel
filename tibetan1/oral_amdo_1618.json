    "བཞི་པ་དེ་དག་གི་ཤེས་བྱེད་ཀྱི་ལུང་དྲང་བ་ནི།",
    "བཞི་པ་ཐུན་མོང་གི་བྱ་བས་དོན་བསྡུ་བ་ལ་གསུམ་སྟེ།",
    "ཟུང་འཇུག་གི་ལམ་གྱི་བྱེད་པ་བསྟན་པ་དང་།",
    "ཚེ་འདིར་བདེ་བ་སྒྲུབ་པའི་བྱ་བ་ཕུན་ཚོགས་པ་བསྒྲུབ་པ་གང་ཡིན་པ་དེ་བདག་གིས་འབད་ནས་སྒྲུབ་པར་བྱའོ་སྙམ་པ་ལགས་སོ།",
    "ཁམས་རྣམས་ལ་སྦྲུལ་གདུག་པ་ཅན་གྱིས་གཞན་འཛིན་པ་ལྟ་བུར་རང་རང་གི་མཚན་ཉིད་འཛིན་པའི་ཚུལ་ལ་རང་བཞིན་མེད་པར་སོ་སོར་རྟོག་པ་ཡང་སྒྲུབ་ལ།",
    "ཐ་སྙད་སྣང་ཚོད་དུ་སྐྱེ་མཆེད་ཡོངས་སུ་འདོར་བར་ཡང་མི་འཚལ་ལོ།",
    "རྣམ་པར་ཤེས་པ་ལ་སྒྱུ་མའི་རྟ་གླང་ལྟར་འགྲོ་འོང་གི་བྱ་བ་བྱེད་པར་སྣང་ཡང་བྱ་བྱེད་མི་བདེན་པར་སོ་སོར་རྟོག་པ་ཡང་སྒྲུབ་བོ།",
    "འོ་ན་བྱ་བྱེད་ལ་ཞེན་པ་སྤོང་བས་ལུས་ངག་གི་བྱ་བ་གང་ཡང་སྒྲུབ་པ་ལ་མི་འཇུག་གོ་ཞེ་ན།",
    "ཡེ་ཤེས་སྔོན་དུ་འགྲོ་བའི་གཞན་དོན་ལ་འཇུག་པའི་ལུས་ངག་གི་བྱ་བ་མི་འདོར་བར་བསྟན་པ་ནི།",
    "འོན་ཀྱང་ཚོགས་ལམ་དུ་ཐོས་བསམ་གྱིས་རིགས་པས་གཏན་ལ་ཕབ་པའི་དོན་བསྒོམས་པས་གོམས་པའི་སྟོབས་ཀྱིས་གསལ་སྣང་ཅུང་ཟད་ཐོབ་པས་ན་མོས་པ་ཤིན་ཏུ་བརྟན་པ་ཙམ་དུ་ཟད་དེ།",
    "བདུད་དང་མུ་སྟེགས་ལ་སོགས་པས་རང་གི་རྟོགས་པ་ལས་གཞན་དུ་མི་བྱེད་ལ།",
    "མོས་སྤྱོད་ཀྱི་ས་འདི་ཉིད་ལ་ཐ་མ་དང་འབྲིང་དང་མཆོག་དང་རབ་ཀྱི་མཆོག་གི་གནས་སྐབས་བཞིས་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་བཞིར་རྣམ་པར་བཞག་སྟེ་ཞེས་བྱའོ།",
    "གང་གི་ཚེ་ཕྱི་རོལ་གྱི་དོན་དུ་སྣང་བ་སེམས་ལས་ཐ་དད་དུ་བདེན་པར་མི་དམིགས་པར་རྟོགས་པའི་རྣམ་པ་འཛིན་པ་ན་གཟུང་བ་དང་བདེན་པས་སྟོང་བར་སྒོམ་བྱུང་གིས་རྟོགས་པའི་ཤེས་པའི་སྣང་བ་ཅུང་ཟད་གསལ་བར་གྱུར་པ་དེའི་ཚེ་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་དྲོ་བར་གྱུར་པ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "གང་གི་ཚེ་གཟུང་བ་བདེན་མེད་དུ་རྟོགས་པའི་ཤེས་པའི་སྣང་བ་དེ་ཉིད་འབྲིང་ཙམ་དུ་གསལ་བར་གྱུར་པ་དེའི་ཚེ་ངེས་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྩེ་མོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "གང་གི་ཚེ་གཟུང་བ་བདེན་མེད་དུ་རྟོགས་པའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་དེ་ཉིད་སྔར་ལས་ཆེས་གསལ་བར་གྱུར་ཏེ།",
    "གང་གི་ཚེ་གཟུང་འཛིན་གཉིས་ཀྱི་རྣམ་པ་དང་།",
    "དེ་དག་ཡོངས་སུ་དག་པའི་བཅུ་གཅིག་གི་ཁྱད་པར་གྱིས་ཡོངས་སུ་རྫོགས་པའི་སྒོ་ནས་སར་རྣམ་པར་བཞག་གོ།",
    "ས་དང་པོའི་གནས་སྐབས་དེར་མཐོང་བས་སྤང་བར་བྱ་བའི་ཉོན་མོངས་པ་བརྒྱ་རྩ་བཅུ་གཉིས་སྤོང་ངོ།",
    "ལམ་མཐོང་སྤང་ལ་དགུ་སྟེ་སུམ་ཅུ་རྩ་དྲུག་དེ་བཞིན་དུ་གཟུགས་མེད་ཁམས་ལ་ཁོང་ཁྲོ་ཕྲི་བས་གཟུགས་ཁམས་ཀྱི་མཐོང་སྤང་གི་དབྱེ་བ་བཞིན་དུ་དབྱེ་བས་སུམ་ཅུ་སོ་དྲུག་གོ།",
    "གང་གི་ཚེ་དེ་ལྟར་ནུས་པ་དེའི་ཚེ་ལྷག་པའི་སེམས་ཀྱི་བསླབ་པའི་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་གསུམ་པར་རྣམ་པར་བཞག་གོ།",
    "གང་གི་ཚེ་དེ་ལྟར་ནུས་པ་དེའི་ཚེ་བདེན་བཞི་ལ་མཁས་པའི་ཤེས་རབ་ཀྱི་བསླབ་པའི་ཡན་ལག་དེ་ཡོངས་སུ་རྫོགས་པས་ས་ལྔ་པར་རྣམ་པར་བཞག་གོ།",
    "ལོག་སྒྲུབ་ཀྱིས་ཀུན་ནས་ཉོན་མོངས་པར་མི་འགྱུར་བ་སྟེ།",
    "ས་བདུན་པ་ལ་གནས་པ་དེ་རྩོལ་བ་བྱས་ན་མཚན་མ་ཕྲ་མོའི་གོ་སྐབས་ཀྱང་མེད་པར་མཚན་མ་མེད་པ་ལ་གནས་པའང་ཡིན་ནོ།",
    "ཇི་སྲིད་དུ་མིང་གི་རྣམ་གྲངས་དང་།",
    "མཆོག་གི་སྤྲུལ་པ་ལ་སོགས་པ་མཛད་པ་བཅུ་གཉིས་བསྟན་པ་དང་།",
    "ཡི་གེ་མང་གི་དོགས་ནས་འདིར་མ་བྲིས་སོ་ཞེས་སོ།",
    "ལོག་རྟོག་གི་མཐའ་ཐམས་ཅད་དང་བྲལ་བ།",
    "སུ་ཞིག་གིས་ཞེ་ན།",
    "རྒྱུ་གང་གིས་ཞེ་ན།",
    "སྒྱུར་བྱེད་གང་གིས་བསྒྱུར་བ་ནི།",
    "ཟབ་མོའི་སྣང་བྱེད་ཉིན་བྱེད་འོད་འབར་བ།",
    "སྐྱོན་བྲལ་ཚིག་གིས་དོན་བཟང་རབ་ཏུ་བཤད།",
    "ཚིག་གི་སྤྲོས་པའི་ཁུར་གྱིས་རབ་ལྕི་ཞིང་།",
    "བླང་དོར་ཚུལ་བཞིན་རྣམ་འབྱེད་བདག་གིས་བཤད།",
    "རོང་སྟོན་ཆེན་པོ་ཤེས་བྱ་ཀུན་རིག་གིས་མཐའ་ཡས་པའི་འགྲོ་བ་དུ་མ་རྗེས་སུ་གཟུང་བའི་དོན་དུ་སྒོམ་རིམ་དང་པོའི་དགོངས་པ་ཚུལ་བཞིན་དུ་བཀྲལ་ནས་ལྷག་པའི་བསམ་པ་རྣམ་པར་དག་པས་བགྱིས་སོ།",
    "འཇིག་རྟེན་ལྷ་བརྒྱའི་གཙུག་གི་ནོར་བུའི་ཅོད་པན་དག་གིས་རབ་འདུད་པ།",
    "རྨད་བྱུང་དོན་བཟང་སྣང་བྱེད་ངག་གི་འོ་མའི་ཆུ་མཚོ་མངོན་གྱུར་ཅིང་།",
    "གཞུང་གི་དོན་དངོས་སོ།",
    "གཉིས་པ་གཞུང་གི་དོན་ལ་ལྔ་སྟེ།",
    "རྒྱུ་རྐྱེན་ལ་མི་ལྟོས་པ་ཐལ་འགྱུར་གྱིས་དགག་པ།",
    "གཞན་ཡང་རྒྱུ་རྐྱེན་ལ་མི་ལྟོས་པར་འབྱུང་ན་གང་ཟག་ཐམས་ཅད་ཀྱང་གང་གིས་ན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་མི་འགྱུར།",
    "དཔེར་ན་མེ་གཅིག་བུད་ཤིང་ལས་སྐྱེ་བར་གྲུབ་ན་དེའི་རིགས་ཅན་གཞན་ཐམས་ཅད་ཀྱང་བུད་ཤིང་ལས་སྐྱེ་བར་གྲུབ་པ་བཞིན་ནོ།",
    "ངན་སོང་གི་སྡུག་བསྔལ་དང་།",
    "ངན་སོང་གསུམ་ན་སྡུག་བསྔལ་ཡོད་པའི་ཚུལ་འདི་ལྟར།",
    "གང་དག་ཁྱིམ་ན་གནས་པ་རྣམས་ནི་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པའི་ཀུན་ནས་དཀྲིས་པ་སྣ་ཚོགས་ཀྱིས་སེམས་དཀྲིས་པ་དག་དང་།",
