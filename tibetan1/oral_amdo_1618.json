    "ཅེས་པ་འདི་དག་གི་དོན་ཡང་བསམ་པར་བྱའོ།",
    "རེ་རེའི་ཆ་ཡི་དབྱེ་བས་བསམ་མི་ཁྱབ།",
    "དམིགས་པ་གང་གིས་རྣམ་པ་བཟུང་ནས་སེམས་བླན་ཏེ་འཇོག་པ་སྟེ་སེམས་གནས་པའི་ཐབས་དགུ་བསྟན་ཟིན་ཏོ།",
    "གང་གིས་སྔོན་དུ་འགྲོ་བ་ལེགས་པར་སྤྱད་པས་འདི་ལ་རྩེ་གཅིག་ཏུ་འགྱུར་བའོ།",
    "གྲོགས་ཀྱི་བྱེ་བྲག་གིས་སེམས་བཟུང་བའང་ཡོད་དེ།",
    "དུས་ཀྱི་བྱེ་བྲག་གིས་སེམས་བཟུང་བའང་ཡོད་དེ།",
    "གཞན་མཐོང་བའི་བྱེ་བྲག་གིས་སེམས་བཟུང་བའང་ཡོད་དེ།",
    "ཏིང་ངེ་འཛིན་གང་གིས་སྐུ་ལ་སོགས་པ་ཐམས་ཅད་ཡུལ་དུ་བྱས་ནས་ཐམས་ཅད་ལ་གསལ་བར་འགྱུར་བའོ།",
    "དམིགས་པ་བྱེ་བྲག་གིས་སྤྱི་ལ་སེམས་བཟུང་བའང་ཡོད་དེ།",
    "བྱེ་བྲག་གིས་བྱེ་བྲག་ལ་སེམས་བཟུང་བའང་ཡོད་དེ།",
    "གཏོང་བའི་བྱེ་བྲག་གིས་སེམས་བཟུང་བའང་ཡོད་དེ།",
    "སེམས་རྒོད་པར་གྱུར་ན་གང་གིས་བཅིངས་པས་གསལ་བར་འགྱུར་བའོ།",
    "གང་གིས་བདག་གི་གསལ་བ་དང་ཡོངས་སུ་རྫོགས་པ་ཇི་ལྟར་གནས་པ་རྟོག་པའོ།",
    "འདི་ལྟར་ཉོན་མོངས་པ་དང་བཅས་པའི་སེམས་སམ།",
    "ཉོན་མོངས་པའི་ཡུལ་ལ་རབ་ཏུ་འཕྲོ་བའོ།",
    "རང་གི་བསམ་གཏན་འདི་མཆོག་ཏུ་འགྱུར་བའོ།",
    "གང་གིས་དམིགས་པ་རྩོལ་བས་གསལ་བ་དང་།",
    "ཡང་ཇི་ལྟར་སྣང་བ་རང་གི་བསམ་གཏན་ལས་གཞན་དུ་མི་སྣང་བའོ།",
    "ཚད་དུ་ཕྱིན་པའི་སྤྱོད་ལམ་མོ།",
    "གཞན་ཡང་བདག་ཉིད་ཀྱིས་ལུས་ངག་གི་སྤྱོད་པ་ཅི་བདེར་གནས་པར་བྱ་སྟེ།",
    "འདི་ནི་ལས་དང་པོ་པའི་སྤྱོད་ལམ་མོ།",
    "གང་གིས་སྣང་བ་ཐམས་ཅད་ལྷའི་དཀྱིལ་འཁོར་དུ་གནས་པ་དང་།",
    "རྣལ་འབྱོར་མོས་པའི་ས་ལ་གནས།",
    "རྣལ་འབྱོར་པ་མཆོག་གི་སྤྱོད་ལམ་གང་ཞེ་ན།",
    "གང་གིས་སྔོན་དུ་སྣང་བའི་ལོག་པ་སྒྱུ་མ་ཙམ་དང་།",
    "ནང་གི་ཟས་དང་སྐོམ་དག་ནི།",
    "དེ་ལས་གཞན་པའི་བྱེ་བྲག་གིས་བཞག་གོ།",
    "རང་གི་ངང་གིས་དམིགས་པ་གསལ་བར་གྱུར་པ་དང་།",
    "ངན་སོང་གི་སྐྱེ་བ་དང་བྲལ་བ་དང་།",
    "དགེ་སློང་གི་བར་གྱི་ཡོན་ཏན་དང་ལྡན་པ་དང་།",
    "དེ་ལས་ལངས་ནས་བསམ་གཏན་དང་པོའི་ཏིང་ངེ་འཛིན་བསྒོམ་མོ།",
    "གང་ཟག་ཞི་གནས་དང་ལྡན་པ་ལ་གང་གིས་ཇི་ལྟར་ཡོངས་སུ་བརྟག་ཅེ་ན།",
    "གང་གིས་ཀུན་ཏུ་འགྲོ་བ་མེད་པ་དང་།",
    "ངག་གི་སྨྲ་བ་དྲག་ཏུ་མི་བྱེད་པ་དང་།",
    "ཁེ་དང་རེ་བ་མེད་པ་དང་།",
    "ལྷག་མཐོང་གི་རྒྱུ་གང་ཞེ་ན།",
    "ལྷག་མཐོང་གི་གེགས་ཡིན་ནོ་ཞེས་འབྱུང་ངོ།",
    "དང་པོ་གསུམ་ནི་ཐུན་མོང་གི་ཤེས་བྱའི་གཞི་ལ་མཁས་པའོ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བའི་ཚུལ་ལ་མཁས་པའོ།",
    "ཕུང་པོ་སོགས་ཀྱི་མིང་གི་རྣམ་གྲངས་ལ་མཁས་པ་དང་།",
    "མིང་གི་རྣམ་གྲངས་ལ་མཁས་པ་ནི།",
    "ཕུང་པོ་སོགས་བཅོམ་ལྡན་འདས་ཀྱིས་མིང་གི་ཐ་སྙད་དུ་མ་རྣམ་པར་བཞག་པ་ཤེས་པའོ།",
    "ཁམས་ཀྱི་དོན་རང་གི་མཚན་ཉིད་འཛིན་པ་དང་།",
    "གསལ་བ་སོ་སོ་རང་རང་གི་དོན་ཤེས་པའོ།",
    "བོད་འདིར་ཇི་སྙེད་པ་འབྱེད་པའི་ལྷག་མཐོང་གི་གཏམ་ཙམ་ཡང་མི་སྣང་ངོ།",
    "དེ་ནི་གང་ཟག་གི་བདག་མེད་རྟོགས་པ་དང་།",
    "གང་ཟག་གི་བདག་མེད་རྟོགས་པ་གང་ཞེ་ན།",
    "དང་པོ་ལྟར་ན་ཉེ་བར་བླང་བྱ་དང་ཉེ་བར་ལེན་པ་པོ་གཅིག་ཏུ་ཐལ་བར་འགྱུར་ཞིང་།",
    "མཚན་ཉིད་མི་མཐུན་པའམ་ཕུང་པོ་བདག་གི་མཚན་ཉིད་ཅན་མ་ཡིན་པར་ཁོང་དུ་ཆུད་པ་ན་ཕུང་པོ་བདག་མེད་པར་རྟོགས་པར་འགྱུར་རོ།",
    "གང་ཟག་ངོ་བོ་ཉིད་མེད་པར་རྟོགས་པ་ནི་གང་ཟག་གི་བདག་མེད་རྟོགས་པའི་དོན་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་ཟག་ངོ་བོ་ཉིད་མེད་པ་ལ་གང་ཟག་གི་བདག་མེད་པ་ཞེས་བརྗོད་པར་བྱ་བ་ཡིན་ཏེ།",
    "འདི་དག་ནི་གང་ཟག་གི་བདག་མེད་གཏན་ལ་འབེབས་པར་བྱེད་པའི་རིགས་པའོ།",
    "རིགས་པ་འདི་ལ་བརྟེན་ནས་ཕུང་པོ་ལ་བདག་གདོད་མ་ནས་ཡོད་པ་མ་ཡིན་པར་རྟོགས་པའི་ཤེས་རབ་ནི་གང་ཟག་གི་བདག་མེད་རྟོགས་པའི་ལྷག་མཐོང་ངོ།",
    "བོད་གཞན་དག་གིས་ནི་འདི་ཙམ་ཡང་ཁོང་དུ་མ་ཆུད་ན་གཞན་ལྟ་ཡང་ཅི་སྨོས།",
    "སྒྱུ་མ་བྱེད་པ་དག་གིས་གཟུགས་སྤྲུལ་ནས།",
    "དྭང་བའི་མཚོར་ཟླ་བའི་གཟུགས་བརྙན་ཤར་བ་ན་ཟླ་བར་སྣང་ཙམ་མ་འགགས་པར་ཡོད་མོད་ཀྱི།",
    "ཟླ་བའི་ཚད་གང་ཡང་མེད་པའི་ཕྱིར་ཟླ་བའི་རང་གི་མཚན་ཉིད་ཀྱིས་སྟོང་པའོ།",
    "ཟླ་བར་སྣང་ཙམ་མ་དོར་ཞིང་ཟླ་བའི་རང་གི་མཚན་ཉིད་དུ་མེད་པས་ན་སྣང་ལ་རང་བཞིན་མེད་པ་ཞེས་བྱའོ།",
    "ཟླ་བར་སྣང་བ་ཉིད་ཟླ་བའི་རང་གི་མཚན་ཉིད་ཀྱིས་སྟོང་པ་ཡིན་གྱི་དེ་ལས་གཞན་དུ་ཟླ་བ་རང་གི་མཚན་ཉིད་ཀྱིས་སྟོང་པ་ཙམ་དུ་མེད་དོ།",
    "ཟླ་བ་རང་གིས་སྟོང་པ་གཉིས་སོ་སོ་མ་ཡིན་པས་སྣང་སྟོང་ཐ་མི་དད་པ་ཉིད་དོ།",
    "གཞན་དག་གིས་ནི་དོན་འདི་ཁོང་དུ་མ་ཆུད་དོ།",
    "དེ་ནས་ཁྱད་པར་གཟུགས་དང་ཚོར་བ་སོགས་ལ་དཔྱོད་པ་ལྟ་བུའོ།",
    "ཇི་ལྟ་བ་རྣམ་པར་འབྱེད་པའི་ལྷག་མཐོང་གིས་ནི་བློ་སྔ་མས་སོ་སོར་རྣམ་པར་ཕྱེ་ནས་བཟུང་བའི་དོན་ལ་རེ་རེ་ཞིང་དེའི་གནས་ཚུལ་ལ་རིགས་པ་ལ་བརྟེན་ནས་སོ་སོར་རྟོག་ཅིང་དེའི་གནས་ཚུལ་འཛིན་པར་བྱེད་པའོ།",
    "མཉམ་གཞག་གི་དངོས་གཞིའི་གནས་སྐབས་སུ་ནི་རྣམ་པར་མི་གཡོ་བའི་ལྷག་མཐོང་གིས་འཇུག་པའོ།",
    "མཉམ་གཞག་གི་གནས་སྐབས་སུ་ནི་རྣམ་པར་མི་གཡོ་བའི་ལྷག་མཐོང་ལ་འཇུག་གོ།",
    "དྲུག་གིས་གཅིག་ཆར་སྦྱར་བ་ན་ཞེས་སོགས་ཀྱི་རིགས་པ་ལ་བརྟེན་ནས་ཕྱི་རོལ་གྱི་དོན་རང་བཞིན་མེད་པའི་དོན་རྟོགས་པའམ།",
    "འོ་ན་ཤེས་པ་དེ་ལ་སྐྱེ་བ་དང་འགག་པ་དང་གནས་པའི་ཆ་གསུམ་མེད་ན་ནི་རྒྱུན་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "རང་གི་ཆ་ཤས་དང་རྫས་གཅིག་གམ་ཐ་དད།",
    "དེ་དག་གི་ཆ་ཤས་ཅན་མ་ཡིན་པར་ཐལ་བར་འགྱུར་རོ།",
    "ཡང་སྐྱེ་འགག་གནས་གསུམ་རེ་རེ་ལ་ཡང་སྐྱེ་འགག་གནས་གསུམ་གྱི་ཆ་མེད་ན་འདུས་བྱས་སུ་མི་འགྱུར་ལ།",
    "ཡོད་ན་དེ་དག་རེ་རེའི་ཆ་ལའང་ཆ་གསུམ་གསུམ་དུ་བརྟགས་པས་ཅུང་ཟད་ཀྱང་རྙེད་པར་མི་འགྱུར་རོ།",
    "སོ་སོར་རྟོག་པའི་ལྷག་མཐོང་གིས་རྙེད་པའི་དོན་ཡང་དང་ཡང་དུ་གོམས་པར་བྱས་པ་ལས་ཡང་དག་པའི་དོན་མངོན་དུ་གྱུར་པའི་ལྷག་མཐོང་ངོ།",
    "ལྷག་མཐོང་གི་ཕན་ཡོན་གང་ཞེ་ན།",
    "ལྷག་མཐོང་གི་རྟགས་གང་ཞེ་ན།",
    "ནང་གི་སེམས་ལ་དཔྱོད་པ་ན་ཡང་ཉོན་མོངས་པའི་རྣམ་པར་རྟོག་པ་དང་།",
    "རྩ་ཉོན་དང་ཉེ་ཉོན་ཉི་ཤུ་སོགས་ལ་རྩ་བའི་ཉོན་མོངས་པ་ཁོང་ཁྲོ་སྐྱེས་སོ།",
    "རྣམ་བྱང་གི་རབ་དབྱེ་རྣམས་ལ་རྟོག་པ་གང་སྐྱེས་དྲན་པ་དང་ཤེས་བཞིན་གྱིས་བཟུང་ནས་རེ་རེ་ཞིང་རང་བཞིན་མེད་པར་རྟོགས་པར་བྱའོ།",
    "ཀུན་ནས་ཉོན་མོངས་གཟུང་རྟོག་དང་།",
    "གང་ཟག་གི་བདག་མེད་པ་དང་།",
    "རང་གི་ངོ་བོ་དང་།",
    "བསྒོམ་བྱ་དང་སྒོམ་བྱེད་སྟོར་ནས་ཐལ།",
    "ལྷག་མཐོང་གི་ཕན་ཡོན་གང་ཞེ་ན།",
    "རང་གི་རྟོགས་པ་ལ་ཐེ་ཚོམ་མེད་པ་དང་།",
    "ལྷག་མཐོང་གི་སྤྱིའི་དོན་བསྟན་ཟིན་ཏོ།",
    "གཉིས་པ་གཞུང་གི་དོན་ལ་གཉིས་ཏེ།",
    "ལྷག་མཐོང་གི་རྒྱུ་ཚོགས།",
    "ཉིན་མོ་སྐྱེ་བོ་མང་པོ་དག་གིས་མ་གང་བའི་ཕྱིར་དང་།",
    "མཚན་མོ་སྒྲ་ཆུང་བའི་ཕྱིར་མཐུན་པའི་རྐྱེན་ལེགས་པར་ལྡན་པའོ།",
    "གསུམ་པ་ལྷག་མཐོང་གི་རྒྱུ་ཚོགས་བསྟན་པ་ལ་གཉིས་ཏེ།",
    "ལྷག་མཐོང་གི་རྒྱུ་ཚོགས་གང་ཞེ་ན།",
    "ཡོན་ཏན་ལྷག་པར་བརྩོན་བཅས་ལུང་གིས་ཕྱུག།",
    "ཐོས་བསམ་གྱི་ཤེས་རབ་བརྒྱུད་ནས་ཉོན་མོངས་པ་ཞི་བའི་རྒྱུར་འགྱུར་བ་ཡང་ཇི་སྐད་དུ།",
    "ཤེས་རབ་དང་ལྡན་པ་ནི་ཉོན་མོངས་པ་རབ་ཏུ་ཞི་བར་འགྱུར་རོ་ཞེས་བཀའ་སྩལ་ཏོ།",
    "ལྷག་མཐོང་གི་རྒྱུ་ཚོགས་བསྟན་ཟིན་ཏོ།",
    "ཟས་མང་ཉུང་ཚོད་ཟིན་པར་བཟའ་བར་བྱའོ།",
    "ཞི་གནས་དང་ལྷག་མཐོང་གི་རྒྱུ་ཚོགས་བསྟན་ཟིན་ཏོ།",
    "ལུས་ངག་གི་བསྟོད་པ་སོགས་ཚོགས་རྫོགས་པའི་ཡན་ལག་དུ་མ་བྱས་ལ།",
    "སྤྱོད་ལམ་གྱི་ཁྱད་པར་སྟན་ཤིན་ཏུ་འཇམ་པོ་བདེ་བ་ལ་རྗེ་བཙུན་རྣམ་པར་སྣང་མཛད་ཀྱི་སྐྱིལ་མོ་ཀྲུང་ལྟ་བུའམ།",
    "དབུགས་རྒོད་པ་ཅན་དུ་མི་གཏང་གི་ཅི་ནས་ཀྱང་རྒྱུ་བ་རྒོད་པ་ཅན་དུ་མི་ཚོར་བར་དལ་བུ་དལ་བུས་རང་གི་ངང་གིས་ལྷུན་གྱིས་གྲུབ་པའི་ཚུལ་གྱིས་དབུགས་ནང་དུ་རྔུབ་པ་དང་ཕྱིར་དབྱུང་བར་འགྱུར་བ་དེ་ལྟར་བྱའོ།",
    "ཞི་གནས་དང་ལྷག་མཐོང་གཉིས་ཡོད་པ་དེ་ལ་ཐོག་མར་རེ་ཤིག་ཞི་གནས་བསྒྲུབ་པར་བྱ་སྟེ།",
    "བསྒྲུབ་བྱའི་ཞི་གནས་ཀྱི་རང་བཞིན་ནི་གང་མཉམ་པར་གཞག་པར་བྱ་བའི་ཡུལ་ལས་ཕྱི་རོལ་གྱི་ཡུལ་ལ་སེམས་ཤིན་ཏུ་རྣམ་པར་གཡེང་བ་རབ་ཏུ་ཞི་གནས་ནང་དུ་ཞི་གནས་ཀྱི་དམིགས་པ་ལ་རྒྱུན་དུ་རང་གི་ངང་གིས་འཇུག་ལ།",
    "ལྷག་མཐོང་གི་རང་བཞིན་ནི་ཞི་གནས་དེ་ཉིད་དམིགས་པ་ལ་དམིགས་བཞིན་པའི་ཚེ་ན།",
    "ཚིག་དོན་བསམ་བྱུང་གི་ཡིད་ཀྱིས་ལེགས་པར་བརྟགས་པ་དང་།",
    "སྒོམ་བྱུང་གིས་མཐོང་བས་ཤིན་ཏུ་ངེས་པའི་ཚུལ་གྱིས་རྟོགས་པར་བྱས་ནས་ཞེས་པའོ།",
    "སེམས་གང་གིས་དམིགས་པ་ཡིད་ལ་བྱེད་པའི་སེམས་དེ་ནང་དུ་རྒྱུན་ཆགས་སུ་ཡིད་ལ་བྱེད་པས་རྩེ་གཅིག་ཏུ་ཡིད་ལ་བྱེད་དོ།",
    "སྣང་ཚུལ་ལ་དམིགས་ནས་གནས་ཚུལ་ལ་མེད་པར་མོས་པར་བྱེད་དོ།",
    "དེ་ནས་སྔར་ལས་ཀྱང་ཞིབ་མོར་ཡོངས་སུ་དཔྱོད་པ་དང་།",
    "ཞི་གནས་དང་ལྷག་མཐོང་གི་རང་བཞིན་བསྟན་ཟིན་ཏོ།",
    "མཐར་ཐུག་གི་དོན་ཡང་དེ་བཞིན་ཉིད་ལ་འབབ་པ།",
    "རིགས་པས་མཐར་ཐུག་གི་དོན་དེ་བཞིན་ཉིད་ལ་བབ་པའོ་ཞེས་མཐར་ཐུག་གི་བརྗོད་བྱ་ཐམས་ཅད་དེ་བཞིན་ཉིད་དུ་བསྡུས་ཏེ་དེ་ལ་སེམས་ཉེ་བར་གཞག་པར་བྱའོ།",
    "ཡང་ན་རྗོད་བྱེད་བསྡུས་པར་བྱས་ནས་འདི་ལ་སེམས་དྲུག་གི་སྒོམ་ཚུལ་ཡོད་དེ།",
    "དམིགས་པའི་རྣམ་གྲངས་རྣམ་པ་གཅིག་ཏུ་ན་མིག་གིས་ཇི་ལྟར་མཐོང་བའི་སྐུ་གཟུགས་དང་།",
    "དམིགས་པ་དེ་ལ་གང་གིས་སེམས་འཇུག་པ།",
    "ལུས་འཕྲོ་བ་ཡན་ལག་གི་འདུག་སྟངས་བཅོས།",
    "ངག་འཕྲོ་བ་དེ་བཞིན་གཤེགས་པའི་ཚིགས་སུ་བཅད་པ་ཟབ་མོ་ངག་ཏུ་འདོན།",
    "གང་གི་ཚེ་ཡུལ་གྱི་དངོས་པོ་མི་མཐོང་བ་དམུས་ལོང་ལྟ་བུའམ་མི་འགའ་ཞིག་མུན་པར་ཞུགས་པ་ལྟ་བུའམ།",
    "གང་གི་ཚེ་ཕྱི་རོལ་གྱི་གཟུགས་སྡུག་པ་ལ་སོགས་པ་ལ་དེ་དག་གི་ཡོན་ཏན་མཛེས་པ་ལ་སོགས་པར་རྟོག་པས་སེམས་དེ་ལ་རྒྱུག་པའི་ཕྱིར་རམ།",
    "རང་གི་དམིགས་པ་ལས་གཞན་ཡིད་ལ་བྱེད་པས་སམ།",
    "གང་གི་ཚེ་ཞི་གནས་ཀྱི་སྐྱོན་བྱིང་བ་དང་རྒོད་པ་མེད་པར་གྱུར་ཏེ་དམིགས་པ་དེ་ལ་སེམས་རྣལ་དུ་འཇུག་པར་མཐོང་བ་དེའི་ཚེ་བྱིང་རྒོད་སེལ་བའི་རྩོལ་བ་གློད་ལ་སེམས་གཏང་སྙོམས་སུ་བྱ་ཞིང་།",
    "དེའི་མཐུས་རྣལ་འབྱོར་པ་དེའི་ལུས་དང་སེམས་གང་གི་ཚེ་ཤིན་ཏུ་སྦྱངས་པར་གྱུར་པ་དང་།",
    "ལྷག་མཐོང་གི་དགོས་པའི་ཁྱད་པར།",
    "ལྷག་མཐོང་གི་བྱེད་པ་བསྟན་པ་དང་།",
    "ཤེས་རབ་ཁོ་ནས་དེ་ཁོ་ན་ཉིད་རྟོགས་ཤིང་སྒྲིབ་པ་སྤོང་བ་དེ་ལྟ་བས་ན་རྣལ་འབྱོར་པ་དག་གིས་ཞི་གནས་ལ་གནས་ཏེ།",
    "ལྷག་མཐོང་གི་འཇུག་པ་དང་།",
    "དེ་གང་གིས་རྟོགས་ཞེ་ན།",
    "གང་ཟག་གི་བདག་མེད་ལ་སོ་སོར་རྟོག་པ་དང་།",
    "ཕུང་པོ་ལ་སོགས་པ་དེ་དག་ནི་སྐད་ཅིག་གིས་མི་རྟག་པ་དང་།",
    "གང་ཟག་ནི་རྟག་པ་དང་གཅིག་པུའི་ངོ་བོ་ཉིད་ཡིན་པར་གཞན་མུ་སྟེགས་པ་དག་གིས་བཏགས་པའི་ཕྱིར་རོ།",
    "གཅིག་ཏུ་ཁས་བླངས་ན་ཡང་རང་གིས་གང་ཟག་གི་མཚན་ཉིད་བརྟགས་པ་དང་འགལ་ལོ་ཞེས་པའི་དོན་ནོ།",
    "གང་ཟག་རྫས་སུ་ཡོད་པ་བཀག་པ་ན་གང་ཟག་ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པ་ཡང་དེ་ཉིད་ཀྱིས་ཁེགས་པ་ཡིན་པས་གང་ཟག་གི་བདག་མེད་པར་གྲུབ་བོ།",
    "ཕུང་པོ་དང་དེ་ཉིད་དམ་གཞན་དུ་བརྗོད་དུ་མི་རུང་བའི་གང་ཟག་གི་དངོས་པོ་ཡོད་པར་མི་རུང་སྟེ།",
    "གང་ཟག་གི་ངོ་བོ་ཉིད་མེད་པ་ལ་གང་ཟག་གི་བདག་མེད་པ་ཞེས་བསྟན་ཏོ།",
    "གཟུགས་སུ་སྣང་བ་དེ་དག་དྲུག་གིས་གཅིག་ཆར་སྦྱར་བ་ན།",
    "ཁམས་གསུམ་པོ་དེ་དག་ནི་སེམས་ཙམ་མོ་ཞེས་སྙམ་དུ་སེམས་ཤིང་།",
    "བདེན་པ་ཉིད་དུ་གྲུབ་པར་ག་ལ་འགྱུར་ཏེ་མི་འགྱུར་བར་ཐལ།",
    "ཇི་ལྟར་གཅིག་ཏུ་བདེན་པ་ཡིན་ཏེ་མ་ཡིན་པར་ཐལ།",
    "དུ་མའི་ངོ་བོ་ཉིད་དུ་བདེན་པ་མ་ཡིན་པར་ཐལ།",
    "འགྲོ་འོང་གི་སྒོ་ནས་བརྟགས་ན་སེམས་སྐྱེ་བར་སྣང་བའི་ཚེ་ཡང་བརྟགས་ན་གང་ནས་ཀྱང་མི་འོང་།",
    "སེམས་ཀྱི་ངོ་བོ་ཇི་ལྟར་ཡོད་པའམ་མེད་པ་གང་གིས་ཡོངས་སུ་རྟོག་པར་བྱེད་པའི་ཡུལ་ཅན་གྱི་བློ་དེ་ཡང་བརྟག་པར་བྱ་བའི་སེམས་ལྟར་སྟོང་པར་རྟོགས་སོ།",
    "ཡང་དག་པའི་དོན་ལ་སྒྲིབ་པར་བྱེད་པ་ཉོན་མོངས་པའི་ཟག་པ་དང་བཅས་པའམ།",
    "ཉོན་མོངས་པའི་ཟག་པ་མེད་པ་ཞེའམ།",
    "གང་གི་ཚེ་རྣལ་འབྱོར་པས་དངོས་པོ་གང་གི་ངོ་བོ་ཉིད་རིགས་པས་རྣམ་པར་དཔྱད་པས་མ་རྙེད་པ་ན་དོན་དམ་པར་མེད་པར་ཁོང་དུ་ཆུད་དེ་ངོ་བོ་དང་ཁྱད་པར་ངེས་པར་མི་འཛིན་པ་དེའི་ཚེ་རྣམ་པར་མི་རྟོག་པའི་ཏིང་ངེ་འཛིན་ལ་བདེ་བླག་ཏུ་འཇུག་གོ།",
    "གསུམ་པ་ལྷག་མཐོང་གི་འཇུག་པ་སྒྲུབ་པ་ལ་གསུམ་སྟེ།",
    "ཙུབ་ཤིང་བཙུབས་པ་ལས་བྱུང་བའི་མེས་བུད་ཤིང་སྲེག་པར་བྱེད་པ་བཞིན་དུ་རྣམ་པར་རྟོག་པའི་བུད་ཤིང་སྲེག་གོ་ཞེས་པའོ།",
    "ཡུལ་ཅན་ཆགས་སྡང་གི་སེམས་གང་ཡིན་པ་དེ་ཡང་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱིས་བརྟགས་ན་སྟོང་པར་རྟོགས་སོ།",
    "སེམས་གང་གིས་སོ་སོར་རྟོག་པར་བྱེད་པའི་བློ་དེ་ཡང་ངོ་བོ་ཉིད་ཕྱི་ནང་ཀུན་ཏུ་བཙལ་ན་སྟོང་པར་རྟོགས་ཏེ།",
    "རྣལ་འབྱོར་པ་དེ་གོང་དུ་བསྟན་པ་དེ་ལྟར་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱིས་ཡུལ་གཟུགས་དང་ཚོར་བ་ལ་སོགས་པའི་ངོ་བོ་ཉིད་ལ་ཐོས་བསམ་གྱི་ཤེས་རབ་ཀྱིས་ཡང་དག་པར་ཇི་ལྟ་བ་བཞིན་དུ་བརྟགས་ནས་གནས་ཚུལ་གྱི་དོན་རྟོགས་པ་ལ་བསམ་གཏན་དུ་བྱེད་ཀྱི།",
    "སྣང་ཚུལ་མི་སྒོམ་མོ་ཞེས་པའི་དོན་ནོ།"
  ]
}