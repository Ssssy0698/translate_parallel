    "ལོ་མ་ལྷགས་པ་དག་བླངས་ཏེ་འདུག་ནས་ཟས་ཀྱི་བྱ་བ་བྱས་ཏེ།",
    "རྐང་པ་གཉིས་བཀྲུས་ཏེ་ཤིང་དྲུང་ཞིག་ཏུ་བརྟེན་ནས་བྲང་འགྲོའི་རྒྱལ་པོ་ཉལ་བའི་ལུས་བསྒྱིལ་བ་ལྟར་སྐྱིལ་ཀྲུང་བཅས་ཏེ་སྤྱོད་ལམ་ཞི་བར་འདུག་པ་དང་།",
    "དགེ་སློང་དག་སྔོན་བྱུང་བ་རི་བྲགས་ཤིག་ན་ཁྱིམ་བདག་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "ལོངས་སྤྱོད་ཆེ་བ་ཞིག་འདུག་པ་དེའི་ཁྱིམ་རྒྱལ་པོ་ཤར་བའི་དྲུང་ན་འདུག་ཅིང་དེ་ནང་པར་སྔར་ལངས་ཏེ་ལས་ཀྱི་མཐའ་དག་ལ་རྟོག་ཏུ་འགྲོའོ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་རྒྱལ་པོ་ཤར་པ་དོན་གྱི་གནས་ན་འདུག་པས་བློན་པོ་རྣམས་ལ་སྨྲས་པ།",
    "རྒྱལ་པོས་ཉེ་བར་འཚོ་བ་སྔ་ན་འཁོད་པ་དག་ཀྱང་དེ་དང་ལྷན་ཅིག་ཕྱིར་བྱུང་སྟེ་རྒྱལ་པོའི་ཚོགས་མེད་པར་འདུག་པ་དང་།",
    "ཤེས་ལྡན་དག་དེང་ཤིག་དང་འདི་ནས་ཧ་ཅང་མི་རིང་བ་ན་རྫིང་བུ་ཞིག་ཡོད་པ་དེའི་འགྲམ་ན་ཤིང་ལྗོན་པ་ཞིག་ཡོད་པ་དེའི་དྲུང་ན་འབྲས་ཆན་གྱིས་བྲེ་བོ་གང་ཞིང་འདུག་པ་དེ་ལས་ཟོས་ཤིང་འཐུངས་ནས་བཟའ་བ་དང་བཏུང་བ་ཅི་འདོད་པར་ཁྱེར་ཅིག།",
    "ངུར་པས་མཛེས་པར་བྱས་པ་ཞིག་འདུག་པ་དེའི་འགྲམ་ན་ཤིང་ལྗོན་པ་ཞིག་འདུག་པ་དེའི་དྲུང་ན་འབྲས་ཆན་ཚོད་མ་སྣ་ཚོགས་དང་བཅས་པས་གང་བ་ཞིག་དུ་པ་མཐོང་ནས།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་པའི་བཀའ་མཆིད་ཀྱིས་ཡང་དག་པར་སྟོན་པར་མཛད།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་སྐུལ་བྱེད་ཆེན་པོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཡོངས་སུ་གཟུང་བ་ཡངས་ཤིང་རྒྱ་ཆེ་བ་ཞིག་འདུག་པ་དེས་མཛོད་པ་བོས་ཏེ་སྨྲས་པ།",
    "སྟོང་ཐུབ་མཚམས་ཀྱི་བར་ན་འདུག་ཅིང་དེ་དོན་མཐུན་ཡུལ་ཀོ་ས་ལ་ནས་འོང་བ་གང་ཡིན་པ་དེའི་བསེལ་ཡང་བྱེད།",
    "ཞུ་དག་ལན་བརྒྱད་ཙམ་བྱས་པའི་ཐུགས་དམ་འདུག་པ་ལ།",
    "ཚིག་དོན་གཉིས་ལ་མཁས་ཞིང་རང་རྒྱུད་ལ་ཇི་འབྱོར་མཛད་པར་ཞུ།",
    "རྟོགས་ན་རྟོགས་མྱོང་རང་རིག་ཡེ་ཤེས་ཐོབ།",
    "འཁྲུལ་ན་འཁྲུལ་མྱོང་རང་རིག་རང་ངོ་ཤེས།",
    "མཐར་ཡང་རང་ལུས་གང་ལེན་འབངས་སུ་མཐོང་།",
    "མེད་ལས་ཡོད་འབྱུང་རང་འབྱུང་ཡེ་ཤེས་དེ།",
    "མཐོང་ལམ་མཐོང་སྣང་རང་སྣང་ཡིན་པར་བཤད།",
    "དངོས་པོ་དངོས་མེད་དབྱིངས་སུ་ཕར་བཟློག་དུས།",
    "རང་རང་སྟོབས་ལས་ཤར་བའི་མཚན་ཉིད་སྟོན།",
    "ཙང་རི་ཙ་ནའི་ཐིག་ལེས་བཏང་སྙོམས་བསྐྱེད།",
    "སྣང་ཚུལ་འགྲོ་འདུག་འཕར་འཕྱོ་བརྟན་པའོ།",
    "འཕྲིན་ལས་མྱུར་ཡང་རང་ལ་བདུད་དུ་འབེབས།",
    "གང་སྣང་རང་འབྱུང་ཡེ་ཤེས་ཡུལ་དུ་གྲོལ།",
    "ཅིར་མཐོང་རང་གྲོལ་ཆེན་པོའི་དབྱིངས་སུ་འཕྱོ།",
    "ཉོ་མཁན་བྱུང་ཡང་རང་ཉིད་བྲེད་པར་འགྱུར།",
    "ཤུགས་འབྱུང་རང་གྲོལ་ཆེན་པོའི་རྩལ་ཤུགས་བཏོན།",
    "བརྡའ་སྒོ་དབྱེ་ཞིང་རང་གྲོལ་གདན་ཡང་འབུལ།",
    "རང་རང་འཁོར་དུ་བདེ་ཆེན་ཡུམ་བཞི་དང་།",
    "ལྷ་ཚོགས་རྣམས་ཀྱང་རང་ཉིད་གཙོ་ལ་བསྡུ།",
    "རང་ཉིད་སྒེར་བུ་ཕག་ལ་གདའ་བསྐུར་ཡིན།",
    "ཐུགས་ཀ་བོན་གྱི་འཁོར་ལོ་འདུག་པའི་གནས།",
    "མེ་རྨིས་མེར་མཆོང་རང་ལུས་མེ་རུ་སྤྲུལ།",
    "ཆུ་རྨིས་ཆུ་མཆོང་རང་ལུས་ཆུ་རུ་སྤྲུལ།",
    "འཇིགས་པ་གང་སྣང་རང་གྲོལ་ཡེ་ཤེས་གྲོགས།",
    "སེང་གེའི་རྩལ་ཚུགས་འདུག་པས་ཐར་ལམ་བགྲོད།",
    "འཁྲུལ་དང་རང་སྣང་རང་བཞིན་མེད་ཤེས་པས།",
    "སྣང་བ་འཁྲུལ་སྣང་རང་སྣང་དོན་སྣང་གསུམ།",
    "བཟང་ངན་བག་ཆགས་སྤྲིན་དཔུང་རང་བཞིན་དཔེ།",
    "ནམ་མཁའི་ཆོ་འཁྲུལ་རང་འབྱུང་རང་སར་བཞག།",
    "ཐོག་སེར་འབྲུག་གློག་རང་འབྱུང་རང་མི་བསྐྱོད།",
    "འདུག་པ་རང་བཞིན་ཆ་ལུགས་ཕྱག་རྒྱར་གནས།",
    "གསལ་བར་བསྒོམ་དང་རང་བཞིན་མེད་པ་ལ།",
    "སྲས་ཀྱི་ཞལ་ནས་ཡུམ་གྱིས་བཙལ་བ་དེ་དག་ཀྱང་ཀུན་རྫོབ་སྒྱུ་མའི་ཚུལ་དུ་གདའ་གསུངས་པས།",
    "རང་སེམས་སྐྱོན་གྱིས་མ་གོས་པར་འདུག་ན་ཤེལ་གྱི་བྲག་ཕུག་ཀྱང་དེ་ཡིན།",
    "སྲས་ཀྱི་གསུངས་པ་དེ་ཀུན་ཀྱང་བདེན་ཚིག་ཏུ་མ་གྱུར་པ་མི་འདུག་ཀྱང་།",
    "མཐུ་རྩལ་གྱི་འདུག་གནས་མཁར་ཆེན་བརྒྱད་བརྒྱད།",
    "ཞང་བོད་འདྲེས་མ་ལ་བོད་ཡིག་མང་བར་འདུག་ཞང་ཡིག་ཀྱང་ཀ་ཁ་སྣང་བ་ལ་ལེགས་པར་བརྟགས་པས་མི་ཁྲོལ་བ་མ་བྱུང་།",
    "ངང་དང་རང་བཞིན་འདུ་འབྲལ་མེད་པ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་གནས་སོ།",
    "རྒྱ་མཚོ་རང་ཉིད་ཡིན་ཞིང་རང་ཉིད་མྱོང་བར་གནས།",
    "ནང་རང་ལུས་རྒྱལ་བའི་དཀྱིལ་འཁོར་དང་།",
    "དེ་བཞིན་དུ་ནང་རང་ལུས་ཀྱང་སྲིད་ལུགས་སྲིད་པ་ནང་བསྟན་པ་དང་མཚུངས་སོ།",
    "དེ་ཡང་རང་རིག་པའི་ཡེ་ཤེས་ཀྱི་རྩལ་ལས།",
    "དེ་ཡང་ཤ་ཟར་འདུག་པས་ན་པྲ་ཤ་ཞེས་བྱའོ།",
    "ངང་དང་རང་བཞིན་འདུ་འབྲལ་མེད་པའོ།",
    "པ་ཆུའི་ས་ཁོ་རང་ཉིད་གཏིང་ནག་བཀུར་ལྗི་ལུས་སེམས་གཉིས་གཅིག་མི་བདེ།",
    "ཁོ་རང་དེ་དང་བློ་སེམས་མི་མཐུན།",
    "འབྲས་བུ་སད་སྟོར་འབྱམས་གསུམ་སྟོན་པ་ནས་དཀོན་པའི་ཡོན་ཏན་ཅི་འདུག་གོ་ཕུག་ཧ་ར།",
    "འགྲོ་ཉལ་འདུག་སྡོད་གང་བྱེད་ཀྱང་།",
    "ཤུགས་འབྱུང་རང་གྲོལ་ཆེན་པོའི་ངང་ལས་རྩལ་བྱུང་ན་རྩལ་བཏོན།",
    "དཔལ་མགོན་པྲ་མ་ར་ཙ་ནག་པོ་དང་།",
    "མཉམ་ཉིད་ཞི་བའི་ངང་ལ་གནས་པས་སྣང་བ་སྒྱུ་མ་འཁྲུལ་པའི་བག་ཆགས་སུ་འདུག་པས་སོ།",
    "མཆོག་དམན་བར་མའི་རང་རང་བློར་འཚམས་པར།",
    "སྲིད་སྐྱོང་རང་ཉིད་བཞུགས་སྟན་ལས་བཞེངས་ཏེ་རྗེ་ཉིད་ལ་རྟེན་གསུམ་དང་།",
    "བསྟན་འགྲོའི་དོན་འབའ་ཞིག་ཐུགས་ལ་བརྣག་པའི་རང་རྟགས་གསལ་པོ་ཞིག་ཡིན་འདུག་པས།",
    "རི་དྭགས་ཀྲྀ་ཎ་ཤ་ནིའི་རྭ་གཅིག་ལས་མི་འདུག་ཅིང་།",
    "ཁྱེད་རང་གནས་པའི་ས་འདི་དག་པའི་ཞིང་།",
    "སླར་ཡང་རང་ཉིད་འོད་དཔག་མེད་སྐུར་ལྡང་།",
    "གཡར་དམ་ཐ་ཚིག་དུས་ལ་དེང་འདིར་བབ།",
    "རང་རང་མཐུན་པའི་དམ་རྫས་དགྱེས་དགུར་རོལ།",
    "རང་རང་དགྱེས་པའི་གདན་ལ་བཞུགས།",
    "རང་རང་མཐུན་པའི་དམ་རྫས་ཀྱིས།",
    "རང་རང་མཐུན་རྫས་གཏོར་མ་འདི་འབུལ་གྱི",
    "ཨོཾ་ཨཱ་ར་པ་ཙ་ན་དྷཱི་དྡྷེ་ན་ཤེས་རབ་བློ་འཕེལ་གྱི་གཟུངས་བཅས།",
    "ལང་རང་ཐིམ་བདག་ཉིད་ཀྱང་།",
    "གོང་བཞིན་མཆོད་ཅིང་བསྟོད་ལ་གསོལ་བ་གདའ།",
    "རང་རང་ཡུལ་དུགཤེགས་ནས་ཀྱང་།",
    "ཁྱེད་རང་རྣམས་ལྷག་པའི་ལྷར་གསལ་བའི་ཞལ་དུཞུགས།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཀྱིས་སློབ་དཔོན་ལ་དྲིན་ལན་གྱི་ཚུལ་དུ་མེ་ཏོགའ་པས་འདིའི་རྗེས་བློས་མཛོད།",
    "སྐྱེ་འཆི་རང་དག་དུས་གསུམ་རྒྱལ་བའི་སྐུ།",
    "ཕྱོག་དུས་རྒྱལ་བ་སྲས་བཅས་ཀྱི།",
    "ཡང་རང་ཉིད་ལ་བཀའ་དྲིན་ཆེ་བའི་རྡོ་རྗེ་སློབ་དཔོན་སོགས་ཡུལ་ཁྱད་པ་ཅན་ལ་བརྟན་བཞུགས་དམིགས་འཕུལ་བའི་བདེའི་ལན།",
    "དེ་ཡང་རང་ལ་ལྟས་ངན་གང་བྱུང་བ་དེའི་གཟུགས་དང་།",
    "རང་རང་ཡུམའ་ཁོར་བཀའ་ཉན་སྤྲུལ་པར་བཅས",
    "མཁྱེནབརྩེའི་བེ་རོ་ཙ་ན་མཁས་པ་མི་དགུ་སོགས།",
    "ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ན",
    "དེས་མ་ཕེབས་ན་སླར་ཡང་ཁྱེད་རང་རྣམས་ལུས་ཙོག་པུར་འཁོད།",
    "དེ་ཡང་འདི་ལྟར་ཁྱེད་རང་རྣམས་ཀྱིས་སློབ་དཔོན་མདུན་དཀྱིལ་དང་བཅས་པའི་དཀྱིལ་འཁོར་རྟེན་དང་བརྟེན་པར་བཅས་པམངོན་སུམ་བཞིན་དུ་མཐོང་བར་གྱུར་པ་ནི",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་ནས་ཞུགས།",
    "ཡང་ཁྱེད་རང་རྣམས་ལྷར་གསལ་བའི་ཐུགས་ཀའི་སྔགས་ཕྲེང་ལས་སྔགས་ཕྲེང་གཉིས་པ་བྱུང་",
    "སློབ་དཔོན་མདུན་བསྐྱེད་ཁྱེད་རང་རྣམས་དང་བཅས་པའི་ཐུགས་ཀར་ཡེ་ཤེས་སེམས་མའི་ཐུགས་ཀའི་དབུས་སུ་ཉི་ཟླའི་གའུ་ཁ་སྦྱོར་གྱི་ལྟེ་བར་ཁ་ཊཱྃ་ག་དཀར་པོ་ལྟེ་བར་ཧྲཱི་ས་མཚན་པ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་བླ་ཚེ་ཆད་ཉམས་ཡར་བ་དང་",
    "འདུག་སྟངས་ཀྱི་དབྱེ་བ་རྣམ་པ་བརྒྱད་ཀྱི་ངེས་པའོ། ད་ནི་ཤེལ་དད་བལ་ཤེལ་གྱི་བགྲང་ཕྲེང་ངོ།",
    "སྲིང་ཆོད་བྱཱ་གྲྭ་སྟག་སྐྱི་ཀ་ཨ་ཇོ་པུ་ཀ་ལྷ་སྤྱང་པུཥྤ་རཀྵ་ནྟུ་ཧཱུྃ་ཧཱུྃ་ཕཊ་བཛྲདྷ་རཱ་ཛྙཱ་པ་ཡ་ཏི་སྭཱཧཱ།",
    "ནི་འདུག་ལ་ངལ་སོས་ཤིག་ཅེས་རྗོད་པར་བྱེད་དོ།",
    "འཇིག་དུས་སྤྲིན་དང་མཚུངས་པ་ཞེས་པ།",
