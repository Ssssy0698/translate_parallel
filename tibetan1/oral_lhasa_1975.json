    "འབྲས་བུ་གང་ཡིན་པ་ནི་རྣམ་པར་སྨིན་པའོ།",
    "འཐོབ་པ་མ་ཡིན་ཞེས་བྱ་བ་ནི་རྙེད་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྒྲའི་དེ་བཞིན་ཉིད་ལ་སོགས་པ་མེད་པར་རིག་པར་བྱའོ།",
    "མེད་པ་ཉིད་ཀྱི་ཕྱིར་དཔག་ཏུ་མེད་པ་ལ་སོགས་པར་འགྱུར་རོ།",
    "རྣམ་པར་ཤེས་པ་དྲུག་དང་སྦྱར་བ་ནི་བཅུ་གཉིས་པའོ།",
    "རྣམ་པར་ཤེས་པ་རྣམས་དང་།",
    "འདུས་བྱས་དང་།",
    "འདུས་མ་བྱས་རྣམས་ཏེ།",
    "ཡང་སོ་སོའི་མིང་སྨོས་ཏེ་མེད་པར་བསྟན་ཏོ།",
    "དུས་གསུམ་མཉམ་པ་ཉིད་ལ་མི་དམིགས་པར་བསྟན་ནས།",
    "ད་ལྟར་བྱུང་བའི་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དམིགས་པར་ག་ལ་འགྱུར་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་བསྩལ་བའི་འགྲེས་རྣམས་སུ་ཤེས་པར་བྱའོ།",
    "མི་དམིགས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གཏན་ལ་དབབ་པའི་ཚིག་བཅུ་གཉིས་བཀོད་པ་གང་ཡིན་པ་དེ་དག་ད་བསྟན་པར་བྱའོ།",
    "འདི་དག་ཐམས་ཅད་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་དོ་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་ཡོངས་སུ་གྲུབ་པའི་མཚན་ཉིད་དུ་ཐམས་ཅད་གཅིག་པར་དགོངས་པའོ།",
    "དེ་བས་ན་སྟོང་པ་ཉིད་ལ་གཟུགས་མེད་ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "ཡང་དག་པར་སྐྱེ་བའི་དུས་ན་ཡང་གང་ནས་ཀྱང་མི་འོང་ལ།",
    "དེ་ལྟར་མིང་མེད་པར་བསྟན་ནས།",
    "མིང་དག་ཐ་དད་པ་མ་ཡིན་པར་བསྟན་ཏེ།",
    "མི་དམིགས་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "མ་བརྟེན་པར་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཟུགས་ལ་སོགས་པ་ཀུན་བརྟགས་པ་རྣམས་ནུས་པར་འགྱུར་བའི་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ།",
    "ཐེར་ཟུག་ཏུ་གནས་པ་མ་ཡིན་ཞིང་རྣམ་པར་འཇིག་པ་མ་ཡིན་པའི་ཕྱིར་ངོ་བོ་ཉིད་མེད་དོ་ཞེས་བྱ་བ་ཡང་གཅིག་གོ།",
    "འདིར་ནི་མི་རྟག་པའི་མཚན་ཉིད་དེ་ལྟ་མ་ཡིན་པར་སྟོན་ཏེ།",
    "སྟོང་པ་ཉིད་ལ་སྟོང་པ་ཉིད་ཇི་ལྟར་གདམས་པར་བྱ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྨིག་རྒྱུ་ལ་སོགས་པ་དང་མཚུངས་པར་སོ་སོར་བརྟགས་ན་གང་ལ་བྱིང་བ་འམ་སྐྲག་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདོགས་པར་མི་བགྱིད་དོ་ཞེས་བྱ་བ་ནི་འཛིན་པའི་རིགས་པ་བསྟན་པའི་ཕྱིར་ཚིག་ལྔ་སྨོས་ཏེ།",
    "དེའི་འོག་ཏུ་ཤེས་རབ་ཀྱིས་གནས་པར་མི་བྱེད་དོ།",
    "གཟུགས་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་གཟུགས་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་འདི་ལྟར་མ་སྐྱེས་པ་ནི་གཅིག་པ་མ་ལགས་མང་པོ་མ་ལགས་ཞེས་བྱ་བ་ལ།",
    "གཉིས་སུ་བགྱིར་མ་མཆིས་པ་ལགས་སོ་ཞེས་བྱ་བས་ཅི་བསྟན་ཞེ་ན།",
    "མ་སྐྱེས་པ་ནི་གཅིག་མ་ལགས་མང་པོ་མ་ལགས་ཞེས་བྱ་བ་ལ་མ་སྐྱེས་པ་ཞེས་བྱ་བ་ནི་དེ་བཞིན་ཉིད་དེ་དེ་ལ་ནི་གཅིག་གམ་གཉིས་ཤེའམ།",
    "བཅོམ་ལྡན་འདས་འདི་ལྟར་དེ་བཞིན་ཉིད་ནི་མ་སྐྱེས་པ་སྟེ་དེ་བཞིན་ཉིད་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་དེ་བཞིན་ཉིད་མ་ལགས་ཏེ།",
    "མ་སྐྱེས་པ་དེ་གཉིས་སུ་མ་མཆིས་ཏེ་གཉིས་སུ་བགྱིར་མ་མཆིས་པ་ལགས་སོ་ཞེས་བྱ་བ་ནི་དེ་བཞིན་ཉིད་དྲི་མ་དང་བཅས་པ་དང་དྲི་མ་མེད་པ་བཟུང་ནས་སྦྱར་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་འདི་ལྟར་གཟུགས་ནི་མི་རྟག་པ་སྟེ་གཟུགས་ཀྱི་འགྲིབ་པ་གང་ལགས་པ་དེ་གཟུགས་མ་ལགས་ཏེ།",
    "དེ་ལྟར་ན་གཟུགས་དང་འགྲིབ་པ་དེ་གཉིས་སུ་མ་མཆིས་ཤིང་གཉིས་སུ་དབྱེར་མ་མཆིས་པ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདི་ལྟར་འགྲིབ་པ་ནི་གཅིག་མ་ལགས་མང་པོ་མ་ལགས་པའི་སླད་དུ་སྟེ།",
    "བཅོམ་ལྡན་འདས་འདི་ལྟར་འགྲིབ་པ་ནི་གཅིག་མ་ལགས་མང་པོ་མ་ལགས་ཞེས་བྱ་བ་ནི་འགྲིབ་པ་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར།",
    "སྒྱུ་མའི་གཟུགས་བཞིན་དུ་དོན་དམ་པར་གྲངས་ཀྱི་བྱེ་བྲག་མེད་དོ།",
    "དེ་བཞིན་ཉིད་ཀྱི་འགྲིབ་པ་གང་ལགས་པ་དེ་དེ་བཞིན་ཉིད་མ་ལགས་ཞེས་བྱ་བ་འདི་ལ་ཡང་དྲི་མ་དང་བཅས་པ་དང་།",
    "འདི་ལྟར་སྔར་དྲི་མ་དང་བཅས་པར་གྱུར་པ་ལས་ཕྱིས་དྲི་མ་མེད་པར་འགྱུར་ཏེ་དེའི་ཕྱིར་མི་རྟག་པའོ།",
    "གང་རྣམ་པར་མི་རྟོག་པ་ཡིད་ལ་བྱེད་པའི་འབྲས་བུ་བསྟན་མ་ཐག་པ་ལ་གནས་བརྟན་རབ་འབྱོར་གྱིས་འགྲེས་བཞི་བསྟན་ཏེ།",
    "གཟུགས་ཀྱི་མ་སྐྱེས་པ་གང་ལགས་པ་དེ་གཟུགས་མ་ལགས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གཉིས་པའོ།",
    "གཟུགས་ཀྱི་འགྲིབ་པ་གང་ལགས་པ་དེ་གཟུགས་མ་ལགས་ཞེས་བྱ་བ་ནི་གསུམ་པའོ།",
    "གཟུགས་ཞེས་བགྱི་བ་འདི་ནི་གཉིས་སུ་མ་མཆིས་པའི་གྲངས་སུ་བགྱིས་པ་ལགས་སོ་ཞེས་བྱ་བ་ནི་བཞི་པའོ།",
    "དེ་བས་ན་འདིའི་སྤྱོད་པ་ཁྱད་པར་ཅན་ཡང་སྟོན་ཏེ།",
    "ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་གཟུགས་ནི་གཟུགས་ཀྱིས་སྟོང་ཞེས་བྱ་བ་ནི་རྣམ་པར་བརྟགས་པའི་གཟུགས་དེ་གཟུགས་ཀྱི་དངོས་པོར་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་བས་ན་མི་སྐྱེ་བ་ནི་གཟུགས་མ་ཡིན་པར་དེ་ལྟར་གྲུབ་པོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟ་ན་གཟུགས་ལ་སོགས་པ་རྟོགས་པས་དེ་བཞིན་ཉིད་རྟོགས་པར་འགྱུར་རོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་རྣམས་ཀྱང་འདྲེས་པར་འགྱུར་རོ།",
    "བདག་ནི་མ་སྐྱེས་པ་ལ་རྒྱུན་དུ་ཞུགས་པ་ཡོད་པར་མི་འདོད།",
    "རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ཡོད་པར་མི་འདོད་དོ་ཞེས་བྱ་བས་ཅི་བསྟན་ཞེ་ན།",
    "མ་སྐྱེས་པ་ལ་གང་ཡང་རྒྱུན་དུ་ཞུགས་པར་མི་འགྱུར་གྱི།",
    "འོན་ཏེ་སྐྱེས་པས་མ་སྐྱེས་པའི་ཐོབ་པ་འཐོབ་ཅེས་རྣམ་པར་རྟོག་པ་གཉིས་དྲིས་ཏེ།",
    "སྐྱེས་པའི་ཐོབ་པ་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་གང་ཟག་ཏུ་གདགས་པར་བསྟན་ཏོ།",
    "འདི་ལྟར་མཚན་ཉིད་མེད་པར་མཚན་ཉིད་གཅིག་པ་དེ་བཞིན་དུ་མ་སྐྱེས་པ་ཡང་དེ་ལྟ་ཡིན་ནམ་ཞེས་བྱ་བ་ནི།",
    "ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་རྣམ་གྲངས་དེས་ན་སྐྱེ་བ་ཡང་མི་སྐྱེ་མི་སྐྱེ་བ་ཡང་མི་སྐྱེའོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "སྐྱེ་བ་མེད་པར་བརྗོད་པར་སྤོབས་སོ་ཞེས་བྱ་བའི་ཚིག་འདི་ལ་མ་སྐྱེས་པ་དང་།",
    "འདུས་མ་བྱས་པ་ཞིག་ཡིན་གྲང་ན།",
    "དེ་ལ་ལྡན་པ་ཡང་མ་ཡིན་ཞེས་བྱ་བས་ནི་སེམས་ལས་བྱུང་བའི་དངོས་པོར་ཡོད་པ་མ་ཡིན་པར་སྟོན་ཏོ།",
    "མི་ལྡན་པ་ཡང་མ་ཡིན་ཞེས་བྱ་བས་ནི་སེམས་དང་མི་ལྡན་པའི་དངོས་པོར་ཡོད་པ་མ་ཡིན་པར་སྟོན་ཏོ།",
    "བསྟན་དུ་མེད་པ་ཞེས་བྱ་བ་ནི་ཁ་དོག་བཞིན་དུ་བསྟན་དུ་ཡོད་པའི་དངོས་པོར་ཡོད་པ་མ་ཡིན་པར་སྟོན་ཏོ།",
    "འདི་ལྟར་མཚན་ཉིད་མེད་པར་མཚན་ཉིད་གཅིག་པ་དག་གོ་ཞེས་བྱ་བས་ནི་འདུས་མ་བྱས་པའི་མཚན་ཉིད་དུ་ཡོད་པ་མ་ཡིན་པར་སྟོན་ཏོ།",
    "དེ་མེད་པས་ཡོད་པ་དང་མེད་པའི་མཚན་ཉིད་ལས་རྣམ་པར་གྲོལ་བའི་ཕྱིར་མཚན་ཉིད་མེད་པ་སྟེ་མཚན་ཉིད་མེད་པའི་མཚན་ཉིད་དུ་མཚན་ཉིད་གཅིག་པའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ནས་གནས་བརྟན་རབ་འབྱོར་གྱིས་དེ་དེ་བཞིན་ནོ་ཞེས་བྱ་བ་ཐམས་ཅད་ཀྱང་སྐྱེ་བ་མེད་པའི་ངོ་བོ་ཉིད་ཡིན་པར་ཁས་ལེན་ཏེ།",
    "བསྟན་པ་འདི་ལ་ཡང་སྔར་སྨོས་པའི་སྐྱོན་འགྲོ་བ་ལྔ་པོ་དག་ཀྱང་ཐ་མི་དད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་དེ་དྲན་པར་བྱས་ནས།",
    "ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་དེ་ལྟར་འགྲོ་བ་ལྔ་པོ་རྣམས་ཀྱང་ཐ་མི་དད་པར་འགྱུར་རོ་ཞེས་ཟེར་བ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་ལ་ལན་འདེབས་ཏེ།",
    "འོ་ན་སྔོན་བསྐལ་པ་གྲངས་མེད་པ་གསུམ་དུ་ཚོགས་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའི་ཚེ་ལས་ཀྱི་བྱེ་བྲག་ཀྱང་ཡོད་ལ་དེ་དང་རྗེས་སུ་མཐུན་པའི་རྣམ་པར་སྨིན་པའི་བྱེ་བྲག་དང་།",
    "རྣམ་པར་བྱང་བ་ལས་གྱུར་པའི་བྱེ་བྲག་ཀྱང་ཡོད་དོ་ཞེས་ལོག་པར་ཞུགས་པ་རྣམས་ཀྱི་ཕྱིར་ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་འདི་ལྟར་དོན་དམ་པར་ནི་ལས་ཀྱང་མེད།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ཡང་མེད།",
    "རྣམ་པར་བྱང་བ་ཡང་མེད་དོ་ཞེས་གསུངས་ཏེ།",
    "གལ་ཏེ་མྱུ་གུ་མ་སྐྱེས་པ་སྐྱེ་ན་ནི་མ་སྐྱེས་པ་ཐམས་ཅད་ཀྱང་ངེས་པ་མེད་པར་སྐྱེ་བར་འགྱུར་རོ།",
    "མི་སྐྱེ་བ་ནི་འདུས་མ་བྱས་པའི་ཕྱིར་མི་སྐྱེ་ལ།",
    "མི་སྐྱེ་བ་ཡང་མི་སྐྱེའོ་ཞེས་བྱ་བ་གསུངས་པ་དེའི་གཏན་ཚིགས་སུ་ཚེ་དང་ལྡན་པ་ཤ་ར་དྭི་ཏིའི་བུ་འདི་ལྟར་སྐྱེ་བ་གང་ཡིན་པ་དང་མི་སྐྱེ་བ་གང་ཡིན་པ་དེ་གཉིས་ཀ་ཡང་ལྡན་པ་ཡང་མ་ཡིན་མི་ལྡན་པ་ཡང་མ་ཡིན་ཏེ།",
    "མི་སྐྱེ་བ་ཉིད་དོ་ཞེས་བྱ་བ་ཡང་གསུངས་ཏེ།",
    "དེ་ལྟ་ཡིན་ཡང་གཉི་ག་ཡང་དོན་དམ་པར་དེ་བཞིན་ཉིད་ཙམ་དུ་ཟད་དོ་ཞེས་བྱ་བར་དགོངས་པའོ།",
    "དེ་ལྟར་ན་གཟུགས་སྐྱེ་བ་མེད་དོ་ཞེས་བྱ་བ་ནས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་དུ་སྐྱེ་བ་མེད་དོ་ཞེས་བསྟན་ནས།",
    "གཉིས་ཀ་མེད་པར་ཡང་མི་དམིགས་སོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "འདི་ལྟར་དེ་གསུམ་ཆར་ལ་ཡང་དོན་དམ་པར་མེད་དེ།",
    "གང་དག་འཇིག་རྟེན་འགྲུབ་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་སྣོད་ཀྱི་འཇིག་རྟེན་ནོ།",
    "གང་དག་འཇིག་རྟེན་མ་ཡིན་པར་འགྱུར་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་གྲུབ་པར་འགྱུར་བའོ།",
    "ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུས་ཡང་དག་པའི་ཚིག་བརྗོད་པས་དོན་ཉིད་ཡོངས་སུ་བཟུང་བ་ནི་ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་དམིགས་སུ་ཕེབས་སོ་ཞེས་བྱ་བ་ནི་ཤཱ་རིའི་བུའི་ཚིག་ལ་ཚིག་རྣམ་པ་གསུམ་གྱིས་རྗེས་སུ་ཡི་རང་བའི་ཚིག་སྟེ།",
    "ལེགས་ཤིང་རིགས་པས་དམིགས་སུ་ཕེབས་པར་དོན་ཡོངས་སུ་བཟུང་ངོ་ཞེས་སྟོན་ཏོ།",
    "ལྷའི་བུ་བྱེ་བ་ཁྲག་ཁྲིག་འབུམ་ཕྲག་དུ་མ་ལྷན་ཅིག་ཏུ་འཁོར་དེ་ཉིད་དུ་འདུས་པར་གྱུར་ཏོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཅིའི་ཕྱིར་ལྷ་རྣམས་འདུས་པར་ཡང་བསྟན་ལ།",
    "དེ་ལ་སྔར་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནས་བརྩམས་ཏེ།",
    "དེ་ལ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཕྱོགས་ནི།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཀྱི་ཕྱོགས་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སོགས་པ་ནས་མ་འདྲེས་པའི་མཐའི་བར་དུ་མི་དམིགས་པར་ཡིད་ལ་བྱེད་པ་རྣམས་དང་།",
    "མི་རྟག་པར་ཡིད་ལ་བྱེད་དོ།",
    "སྨད་པར་བྱ་བ་ཡིན་པ་དང་།",
    "གནོད་པས་ཀྱང་འཇིག་པར་འགྱུར་བའི་ངང་ཚུལ་ཅན་ཡིན་པའི་ཕྱིར།",
    "འདུས་བྱས་ཀྱི་མཚན་མ་ཐམས་ཅད་དང་བྲལ་བའི་ཕྱིར་མཚན་མ་མེད་པའོ།",
    "ཡོངས་སུ་བསྔོ་བའི་སེམས་རྣམས་ཕན་ཚུན་དུ་འགྲོགས་པར་ཡིད་ལ་བྱེད་པ་ནི་སྦྱོར་བའོ།",
    "གཞན་གྱི་ངོ་བོ་ལ་ཡོད་པ་མ་ཡིན་པར་ཡིད་ལ་བྱེད་པ་ནི་དཔྱོད་པར་བྱེད་པའོ།",
    "འདི་ནི་བདག་མེད་པར་སོ་སོར་བརྟགས་པ་བཞི་པའོ།",
    "ཐམས་ཅད་ཀྱི་ཐ་མའི་སེམས་ལ་ནི་འདུ་བྱེད་ཐམས་ཅད་རྫོགས་པར་འགྱུར་རོ།",
    "དེ་བས་ན་སྒོ་འདིས་སེམས་རྣམ་པར་འགྲོགས་པ་ཡོད་དོ་ཞེས་ཟེར་ཏེ།",
    "བྱས་པ་མི་གཟོ་བར་མི་བགྱིའོ་ཞེས་བྱ་བས་ཅི་བསྟན་ཞེ་ན།",
    "ཡང་དག་པར་འཛིན་དུ་བཅུག་པ་བརྙེས་ནས་ཡང་དག་པར་སྒྲུབ་པ་ལ་བཅུག་སྟེ།",
    "ཐོག་མར་ནི་གདམས་ཤིང་རྗེས་སུ་བསྟན་པར་བྱའོ།",
    "ལོག་པར་སྒྲུབ་པ་དང་།",
    "ཡང་དག་པར་སྒྲུབ་པ་སྟེ་གནས་སྐབས་བཞིའོ།",
    "དེ་ལ་མི་ཤེས་པས་མི་སྒྲུབ་པ་ལ་སྒྲུབ་ཏུ་འཇུག་པ་ནི་ཡང་དག་པར་བསྟན་པའོ།",
    "ལོག་པར་ཤེས་པས་ལོག་པར་ཞུགས་པ་དག་ཡང་དག་པར་སྒྲུབ་ལ་སྦྱོར་བ་ནི་ཡང་དག་པར་འཛིན་དུ་བཅུག་པའོ།",
    "ལེ་ལོ་ལ་སོགས་པའི་སྐྱོན་གྱིས་ཅུང་ཟད་སྒྲུབ་པ་དག་ལེགས་པར་བརྩོན་འགྲུས་རྩོམ་དུ་འཇུག་པ་ནི་ཡང་དག་པར་གཟེངས་སྟོད་པའོ།",
    "ཤེས་རབ་ཀྱིས་ཡང་དག་པར་ཞུགས་པ་དག་ལེགས་སོ་ཞེས་རྗེས་སུ་ཡི་རངས་ནས་དེ་ཉིད་ལ་སྦྱོར་བ་ནི་ཡང་དག་པར་རབ་ཏུ་དགྱེས་པར་བགྱིད་པའོ།",
    "དེའི་འོག་ཏུ་ཇི་ལྟར་གནས་པར་བྱ་ཞེས་དྲིས་པ་ལ་གནས་པར་མི་བྱ་བ་ཡོངས་སུ་སྤངས་ཏེ་གནས་པར་བྱ་བས་གནས་པ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་པ་ཞེས་བྱ་བར་སྟོན་ཏོ།",
    "གནས་པར་མི་བྱ་བའི་འགྲེས་ལ་ཡང་རྣམ་པ་གསུམ་དུ་བསྟན་ཏེ།",
    "གང་ཟག་རྣམས་ལ་གནས་པར་མི་བྱ་ཞེས་བྱ་བ་ནི་གསུམ་པའོ།",
    "དེ་ལ་གཟུགས་ལ་དམིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནས།",
    "ཀོ་ཤི་ཀ་དེ་ལྟར་ན་གཟུགས་ཞེས་བྱ་བར་གནས་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནས།",
    "གཟུགས་རྟག་གོ་ཞེས་གནས་པར་མི་བྱ།",
    "ས་དང་པོ་ནས་ས་བཅུ་པའི་བར་ལ་གནས་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནས།",
    "མིག་ལྔ་བསྒྲུབ་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ནས་བཟུང་སྟེ།",
    "དེ་ནས་གནས་བརྟན་རབ་འབྱོར་གྱིས་མི་གནས་པར་སྒྲུབ་པ་ཉིད།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་པ་ཡིན་པར་བསྟན་པ།",
    "དེ་བཞིན་གཤེགས་པའི་ཐུགས་ནི་ཅི་ལའང་གནས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་སྟེ་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པ་ལ་བཞུགས་པར་བསྟན་ཏོ།",
    "ལྷའི་བུ་དག་གང་སྨྲས་པ་ཤེས་པར་མི་རུང་ངམ་ཞེས་བྱ་བ་ལ་སོགས་པས་གང་བརྗོད་པ་དེ་དག་ཅིའི་ཕྱིར་མི་ཤེས་སམ་ཞེས་ལྷའི་བུ་རྣམས་ལ་དྲིས་པ་དང་།",
    "འཕགས་པ་རབ་འབྱོར་ཤེས་པར་མི་རུང་ངོ་ཞེས་སྨྲས་ཏེ།",
    "དེ་ནས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བརྗོད་དུ་མེད་པ་ཡིན་པའི་ཕྱིར་གནས་བརྟན་གྱིས་ཡི་གེ་གཅིག་ཀྱང་མ་བརྗོད་དེ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "མཉན་པར་སྣང་བ་དེ་ནི་ཀུན་བརྟགས་པ་ཡིན་ནོ་ཞེས་སྤྲུལ་པ་དང་།",
    "སྒྱུ་མ་ལྟ་བུར་བསྟན་པས་ལྷའི་བུ་དེ་རྣམས་དགའ་བར་བྱས་སོ།",
    "གལ་ཏེ་དོན་དམ་པར་བརྗོད་དུ་མེད་པ་ཡིན་ན།",
    "རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔའི་ཡུལ་མ་ཡིན་པའི་ཕྱིར་མཐོང་བར་དཀའ་བའོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཡུལ་མ་ཡིན་པའི་ཕྱིར་རྟོགས་པར་དཀའ་བའོ།",
    "རྣམ་པར་རྟོག་པའི་སྤྲོས་པ་ཐམས་ཅད་ཉེ་བར་ཞི་བའི་ཕྱིར་ཕྲ་བའོ།",
    "ཕྱིར་མི་ལྡོག་པ་རྣམས་ཉིད་ཀྱིས་རིག་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་མཁས་པ་དང་མཛངས་པས་རིག་པར་བྱའོ།",
    "ལེན་པར་བྱེད་པར་འགྱུར་ཞེས་བྱ་བ་ནི་འཛིན་པའོ།",
    "དེ་ལྟར་ཀུན་རྫོབ་ཏུ་བསྟན་ནས་ཡང་དོན་དམ་པར་བསྟན་པ་དེ་དག་ནི་གཟུགས་སྟོང་ངོ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་ཞེས་བྱ་བ་ནས།",
    "ལེན་པར་བྱེད་པ་སུ་ཡང་མེད་དོ་ཞེས་བྱ་བའི་བར་དུ་སྟེ།",
    "འདིས་ནི་གང་དག་དེ་ལྟར་རྣམ་པར་མི་རྟོག་པའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མངོན་སུམ་དུ་བྱས་པར་གྱུར་པ་དེ་དག་ཉིད་ཚོལ་བར་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་དག་ཀྱང་དོན་དམ་པར་བཙལ་བར་བྱ་བ་མེད་པའི་ཕྱིར་ཚོལ་བར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་སྟོན་ཏོ།",
    "ཉན་པ་པོ་མེད་པར་དམ་བཅས་པ་ལུང་དང་འགལ་བར་བསྟན་པས།",
    "དོན་དམ་པར་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་དེ་དེ་བཞིན་ནོ་དེ་དེ་བཞིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་དག་སྟོང་པ་ཡིན་པའི་གཏན་ཚིགས་ནང་སྟོང་པ་ཉིད་དང་ཞེས་བྱ་བ་ནས་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་བར་གྱི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གང་མ་བྱུང་བ་དེ་ནི་གཟུགས་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་དོན་དམ་པའི་གཟུགས་ལ་འདུས་བྱས་ཀྱི་སྐྱེ་བ་མེད་པའི་ཕྱིར་གཟུགས་མ་བྱུང་བའོ་ཞེས་བསྟན་པའོ།",
    "དེ་ལྟར་འདུས་མ་བྱས་པ།",
    "གཟུགས་ལ་སོགས་པ་དངོས་པོ་མེད་པར་མཐོང་བས་གཟུགས་ལ་སོགས་པ་ལ་མི་སློབ་ཅེས་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "འདི་ལྟར་གང་ལ་བསླབ་པར་བྱ་བའི་གཟུགས་དེ་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གཟུགས་ལ་སོགས་པ་ཅིའི་ཕྱིར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ཞེས་བརྒྱ་བྱིན་གྱིས་དྲིས་པ་དང་།",
    "སྟོང་པ་ཡིན་པས་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "གཟུགས་གཟུགས་ཀྱིས་སྟོང་ངོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཀོ་ཤི་ཀ་གཟུགས་སྟོང་པ་ཉིད་ནི་གཟུགས་སྟོང་པ་ཉིད་ལ་མི་སློབ་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་འོག་ཏུ་ཀོ་ཤི་ཀ་གང་གཟུགས་སྟོང་པ་ཉིད་ལ་མི་སློབ་ཅེས་བྱ་བ་ནས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་བར་ལ་མི་སློབ་པ་དེ་ནི་གཉིས་སུ་བྱར་མེད་པར་གཟུགས་སྟོང་པ་ཉིད་ལ་སློབ་པོ་ཞེས་བྱ་བ་ནས་གཉིས་སུ་བྱར་མེད་པར་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་སྟོང་པ་ཉིད་ལ་སློབ་པོ་ཞེས་བྱ་བ་ནི་གང་མི་སློབ་པ་དེ་ཉིད་སློབ་པ་ཡིན་པར་སྟོན་ཏོ།",
    "འགྲིབ་པར་བྱ་བ་མེད་པར་སྟོན་ཏེ།",
    "ནག་པོའི་ཕྱོགས་འགྲིབ་པར་བྱ་བའི་ཕྱིར་མི་སློབ་པོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེའི་འོག་ཏུ་དེ་ནི་གཟུགས་ཡོངས་སུ་གཟུང་བ་དང་མེད་པར་བྱ་བའི་ཕྱིར་མི་སློབ་པོ་ཞེས་བྱ་བ་ནི་གང་ལ་དེ་ལྟར་འཕེལ་བར་བྱ་བ་དང་།",
    "མེད་པར་བྱ་བ་མེད་ཅེས་འདྲི་བའོ།",
    "གནས་བརྟན་རབ་འབྱོར་གྱིས་གཟུགས་ལ་གཟུགས་ཡོངས་སུ་མི་འཛིན་ཏོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གཟུང་བ་དང་འཛིན་པ་རྣམས་མེད་པར་སྟོན་ཏོ།",
    "དེའི་གཏན་ཚིགས་སུ་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གཟུང་བར་བྱ་བ་མེད་པས་སྔོན་མ་བྱུང་བའི་རྣམ་པར་བྱང་བ་མེད་དོ།",
    "རྣམ་པར་བྱང་བ་མེད་པས་འཕེལ་བ་མེད་དོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་བསྟན་པའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲིས་སོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལས་བརྩམས་ཏེ་བྱུང་བའི་ཕྱིར།",
    "འདི་ནི་དེ་བཞིན་གཤེགས་པའི་བྱིན་གྱི་རླབས་སོ་ཞེས་སྨྲ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གཞན་གྱི་དངོས་པོ་དང་ལྡན་པ་དང་བྲལ་བའི་རྣམ་པར་རྟོག་པ་དག་ནི་ཐ་དད་པ་ཡོད་ན་རིགས་ཀྱི་མེད་ན་མི་རིགས་སོ།",
    "གཟུགས་ལས་གཞན་དུ་ཡང་བཙལ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་ཐ་དད་པ་མེད་དོ་ཞེས་ཐ་དད་པ་མེད་པར་བསྟན་ཏོ།",
    "དེའི་ཕྱིར་ཡོད་པ་མ་ཡིན་ཐ་དད་པ་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་མཚན་ཉིད་མེད་པའོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་གཉིས་ཀ་ཡང་ཡོད་པ་མ་ཡིན་པར་བསྟན་པའོ།",
    "གཟུགས་ལས་གུད་ན་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མེད་དོ་ཞེས་བྱ་བ་ནི་ཡོད་པ་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་ཐ་དད་པར་བརྗོད་དུ་མི་རུང་ངོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་མཐའ་ཡས་པ་དང་།",
    "འགག་པར་འགྱུར་བ་ཞིག་ན།",
    "དེ་བཞིན་གཤེགས་པར་ལུང་བསྟན་ཏོ་ཞེས་མར་མེ་མཛད་ཀྱི་དཔེ་བསྟན་ཏོ།",
    "འོན་ཀྱང་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་སྔོན་མ་བྱུང་བ་ཡོངས་སུ་འཛིན་པ་དེ་ངོ་མཚར་ཏོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལ་འཇིག་རྟེན་པ་ཐམས་ཅད་སྟོང་པར་སྣང་ལ།",
    "བདག་ཀྱང་སྟོང་པར་སྣང་ངོ།",
    "འདིར་ཇི་ལྟར་ན་སྟོང་པ་ཉིད་ཀྱིས་སྟོང་པ་ཉིད་ལ་གླགས་རྙེད་པར་མི་འགྱུར་བ་སྟོན་ཏོ།",
    "གང་དུ་གླགས་རྙེད་པར་འགྱུར་བ་ཞེས་བྱ་བ་ནི་སའི་སྟེང་ངམ།",
    "དུས་མ་ཡིན་པར་འཆི་བ་མེད་པ་དང་།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་འཐོབ་པ་དང་།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ལ་སོ་སོར་ཡང་དག་པར་སློབ་པ་སྟོན་ཏོ།",
    "ཐབས་མི་མཁས་པས་ཁེངས་པར་འགྱུར་བ་ལས་ཁེངས་པ་མེད་པར་བྱེད་པར་ཡང་ཉེ་བར་གནས་པ་ཡིན་ནོ།",
    "ཁེངས་པར་འགྱུར་བ་མེད་པའི་ཕྱིར་ཁེངས་པར་མི་བྱེད་པར་ཉེ་བར་གནས་པ་ཡིན་ནོ།",
    "བསྲུང་ཞིང་བསྐྱབ་པར་དམ་བཅས་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ལས་ངེས་པར་བྱུང་བ་ཞེས་བྱ་བ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ་ཞེས་བྱ་བ་ནི་ཀུན་རྫོབ་ཏུ་ཐ་དད་པར་བསྟན་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་གཞན་མ་ཡིན།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་གཞན་མ་ཡིན་ཞེས་བྱ་བ་ནི་དོན་དམ་པར་ཐ་དད་པ་མེད་པར་བསྟན་པའོ།",
    "དེ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལས་ངེས་པར་བྱུང་བ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དོ་ཞེས་བྱ་བ་ནི་སྒྲུབ་པའི་ས་ལའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལས་ངེས་པར་བྱུང་བ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ་ཞེས་བྱ་བ་ནི་འབྲས་བུའི་ས་ལའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་གཞན་མ་ཡིན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་འབྲས་བུའི་ས་ལ་ཐ་དད་པ་མེད་ཅིང་།",
    "གཉིས་སུ་མེད་པར་སོ་སོར་བརྟགས་ཏེ།",
    "རྣམ་པར་བརྟགས་པའི་གཟུགས་ནི་ལེན་པའི་ཚུལ་གྱིས་སོ།",
    "ཀོ་ཤི་ཀ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ནི་གཟུང་དུ་མེད་པ་ཞེས་བྱ་བ་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་གཟུང་དུ་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་མཚན་ཉིད་མེད་པར་མཚན་ཉིད་གཅིག་པ་ཞེས་བྱ་བ་ནི་ཀུན་བརྟགས་པའི་མཚན་ཉིད་ཐམས་ཅད་ཀྱི་མཚན་མ་དང་བྲལ་བའི་ཕྱིར་རོ།",
    "གཟུང་བར་མི་བྱ་བར་རྣམ་པར་བརྟགས་པའི་འོས་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་གཉིས་སུ་ཉེ་བར་གནས་པ་མ་ཡིན་ཞེས་བྱ་བ་ནི་གལ་ཏེ་འཛིན་པ་དང་མི་འཛིན་པ་ལ་སོགས་པའི་ཚུལ་དུ་གནས་པར་གྱུར་ན།",
    "ཐ་དད་པའི་བདག་ཉིད་དུ་གནས་པར་འགྱུར་ན།",
    "འདི་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ་དོན་དམ་པར་གཅིག་ཅིང་ཐ་དད་པ་མེད་པའོ།",
    "ཀོ་ཤི་ཀ་དེ་བཞིན་ཉིད་ལ་གཉིས་སུ་འདོད་དུ་ཟད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སོགས་པ་དེ་དག་ཐམས་ཅད་ནི་དེ་བཞིན་ཉིད་ཀྱི་བདག་ཉིད་དུ་གཅིག་སྟེ་གཉིས་སུ་མེད་པར་གནས་པའོ།",
    "སྒྲའི་བདག་ཉིད་མ་ཡིན་པའི་ཕྱིར་སྨོས་སུ་མེད་པར་རོ།",
    "འགག་པ་མེད་པའི་ཚུལ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ཉན་ཐོས་རྣམས་ཀྱིས་འབྲས་བུའི་གནས་སྐབས་སུ་མྱ་ངན་ལས་འདས་པ་ལས་དགོངས་ཏེ་གསུངས་སོ།",
    "དོན་དམ་པར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་ཕ་རོལ་ལམ།",
    "རྡོ་རྗེ་ལྟ་བུའི་སྐུ་བཤིག་སྟེ་དེ་བཞིན་གཤེགས་པའི་སྐུ་གདུང་དུ་བྱིན་གྱིས་བརླབས་སོ་ཞེས་བྱ་བ་འདིས་ནི་བགོ་བཤའ་བྱས་པ་འབྲས་བུ་ཆེ་བ་བསྟན་ཏོ།",
    "གཉིས་ལ་སྤྱོད་པ་མ་ཡིན་པའི་བློས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འཛིན་པ་ཞེས་བྱ་བ་ནི་གཉིས་སུ་མེད་པར་ཀུན་ཏུ་སྤྱོད་པའི་བློས་འཇུག་པ་ནི།",
    "དོན་བསྟན་པ་གཙོ་བོ་ཡིན་པར་སྟོན་ཏེ།",
    "མཚན་མ་མེད་པར་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པས་གནས་སྐབས་བཅུ་བཞིར་རྣམ་པར་རྟོག་པ་བཅུ་བཞི་མེད་པར་སྟོན་ཏེ།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་དང་།",
    "མཚན་མ་མེད་པའོ་ཞེས་རྣམ་པར་རྟོག་པ་ཡང་མེད་པའི་ཕྱིར།",
    "མཚན་མ་མེད་པར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ལས་ཀྱི་དུས་ན་ཡང་སྲིད་པར་བྱ་བའི་ཕྱིར་བླང་བའི་རྣམ་པར་རྟོག་པ་མེད་ལ།",
    "རྣམ་པར་སྨིན་པའི་དུས་ན་ཡང་འགྲོ་བ་རྣམས་སུ་དོར་བའི་རྣམ་པར་རྟོག་པ་ཡང་མེད་པའི་ཕྱིར་བླང་བར་མ་ཡིན།",
    "དོར་བར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "བསྣན་པར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གནས་གྱུར་པའི་ཚེ་ཡང་ནམ་མཁའ་བཞིན་དུ་སྔོན་མ་བྱུང་བའི་རྣམ་པར་བྱང་བ་མེད་པའི་ཕྱིར།",
    "རྣམ་པར་བྱང་བར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "སྐྱེ་བར་མ་ཡིན་འགག་པར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གཟུང་བར་མ་ཡིན་མི་གཟུང་བར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ས་གོང་མ་ལ་གནས་པར་བྱ་བའི་རྣམ་པར་རྟོག་པ་མེད་ཅིང་།",
    "ས་འོག་མ་ལ་གནས་པར་མི་བྱ་བའི་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་གནས་པར་མ་ཡིན་མི་གནས་པར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་བཞིན་དུ་ཞི་གནས་དང་ལྷག་མཐོང་སྒྲུབ་པ་ལ་སྦྱོར་བ་ན་སྒྲུབ་པ་དེ་ལ་འདི་ནི་ཡང་དག་པར་སྒྲུབ་པའོ།",
    "འདི་ནི་ཡང་དག་པ་མ་ཡིན་པའི་སྒྲུབ་པའོ་ཞེས་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར།",
    "ཡང་དག་པར་མ་ཡིན་ལོག་པར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "རིགས་པར་མ་ཡིན།",
    "མི་རིགས་པར་མ་ཡིན་ནོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "བག་ཙམ་མ་ཡིན་པར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "རྣམ་པར་དག་པ་མེད་པའི་དོན་དང་།",
    "ལྷག་མ་མེད་པའི་དོན་ཅེས་བྱ་བ་ལ་སོགས་པའི་རིམ་པས་ཆ་ཤས་ཀྱིས་རབ་ཏུ་རྟོགས་པར་བྱེད་པའི་ཚེ་ཡང་དེ་ལྟ་བུའི་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར།",
    "ཆ་ཤས་མེད་པར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་བཞིན་ཉིད་དུ་མ་ཡིན་དེ་བཞིན་ཉིད་མ་ཡིན་པར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཡང་དག་པའི་མཐའ་མ་ཡིན་ཡང་དག་པའི་མཐའ་མ་ཡིན་པར་མ་ཡིན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དོན་ཅེས་བྱ་བ་འདི་ནི་བརྗོད་པར་བྱ་བའི་རྣམ་གྲངས་དང་།",
    "མི་དམིགས་པར་གདམས་པའི་འགྲེས་ནི་དང་པོའོ།",
    "མཆོག་ཏུ་འཛིན་པ་ལས་ཡང་དག་པར་གནས་པའི་འགྲེས་ནི་གཉིས་པའོ།",
    "བཙུན་པ་རབ་འབྱོར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེའི་འོག་ཏུ་དེའི་རྒྱུ་གསུངས་པ།",
    "ཡོངས་སུ་སྨིན་པར་བྱ་བ་དང་།",
    "རྣམ་པར་གྲོལ་བར་བྱ་བ་ལ་སོགས་པ་དང་།",
    "སྟོང་པ་ཉིད་ཤེས་པ་དག་ནི་མཚན་མར་བྱས་ཏེ།",
    "མ་ཐོད་པ་ཡོངས་སུ་ཉམས་པར་འགྱུར་བའི་སྐྱོན་ཏོ།",
    "མཚན་མར་བྱས་ཏེ།",
    "རྣམ་པར་གྱུར་པ་ཡིན་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་དངོས་པོ་ལ་སོགས་པ་མེད་པར་སྟོན་ཏོ།",
    "གལ་ཏེ་སེམས་ཀྱིས་སེམས་ཡོངས་སུ་བསྔོར་ནི་སེམས་ཕྲད་པར་འགྱུར་བ་མེད་དེ་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་བསྔོ་བ་དང་།",
    "ཡོངས་སུ་བསྔོ་བར་བྱ་བ་གཉིས་མེད་པར་སྟོན་ཏོ།",
    "སེམས་ཀྱི་རང་བཞིན་གང་ཡིན་པ་དེ་ནི་ཡོངས་སུ་བསྔོ་བར་མི་ནུས་སོ་ཞེས་བྱ་བས་ནི་ཡོངས་སུ་བསྔོ་བའི་སེམས་མེད་པར་སྟོན་ཏེ།",
    "དེས་བདུད་ཀྱི་ལས་དེ་དག་ཐོས་ནས་འགྲིབ་པའམ་འཕེལ་བ་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་དེ་དག་ཏུ་རྣམ་པར་མི་རྟོག་པའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་ཡོངས་སུ་བསྔོ་བ་མེད་དོ་ཞེས་དེ་ལྟར་སེམས་ན་མཐུན་པར་ཡོངས་སུ་བསྔོ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འགྲེས་གཉིས་པའོ།",
    "དེ་དག་ཟད་པར་ཡིད་ལ་བྱེད་པ་དང་།",
    "ཡོངས་སུ་བསྔོ་བ་མེད་པར་ཡིད་ལ་བྱེད་པ་དང་།",
    "ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པ་ཉིད་ཡིན་པར་ཡིད་ལ་བྱེད་པ་ན་བླ་ན་མེད་པའི་ཡོངས་སུ་བསྔོ་བས་ཡོངས་སུ་བསྔོ་ཞིང་ཞེས་བྱ་བ་ནི་གསུམ་པའོ།",
    "འོན་ཀྱང་བདག་ནི་དེ་དག་ཐམས་ཅད་མཚན་མར་བྱས་ནས་རྣམ་པར་རྟོག་པ་ལྟ་ཞིག།",
    "དེ་ལྟར་མཚན་མར་བྱས་ཤིང་རྣམ་པར་རྟོག་པས་ཡོངས་སུ་བསྔོ་བ་ནི་དེ་བཞིན་གཤེགས་པས་རྗེས་སུ་གནང་བ་མ་མཛད་དེ།",
    "དེ་བས་ན་དེ་ལྟར་ཡོངས་སུ་བསྔོ་བར་མི་བྱ་ཞིང་དེ་ལ་བསླབ་པར་ཡང་མི་བྱའོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དང་།",
    "ཕྱིས་རྣམ་པར་བྱང་བ་མེད་པའོ།",
    "རྣམ་པར་བྱང་བ་མེད་པ་དང་།",
    "མངོན་སུམ་དུ་བྱས་སོ།",
    "དེ་ལ་སྡུག་བསྔལ་གྱི་བདེན་པ་ལ་སྡུག་བསྔལ་གྱི་ངོ་བོ་ཉིད་དང་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་ཇི་ལྟར་གནས་པར་བགྱི་ཞེས་བྱ་བ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་པའི་ཐབས་སྔར་བརྒྱ་བྱིན་གྱིས་དྲིས་ཟིན་ལ།",
    "འདིར་ནི་ཇི་ལྟར་གནས་པར་བགྱི་ཞེས་བྱ་བ་ཇི་ལྟར་གུས་ཤིང་འཇར་བས་གནས་པར་བྱ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དགོས་པ་དེ་ཙམ་གྱིས་མ་མགུ་ནས་རྣམ་པར་རྟོག་པ་སྟེ།",
    "དེ་བས་ཤཱ་རིའི་བུས་འོག་ནས་ཀོ་ཤི་ཀ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་ཡོངས་སུ་བཟུང་བ་རྣམས་ནི་ཞེས་བྱ་བ་ལ་སོགས་པས་དེ་གཙོ་བོ་ཡིན་པར་བསྟན་ཏེ།",
    "དེ་བས་ན་འདི་ལ་རབ་ཏུ་གུས་པར་བྱའོ་ཞེས་བསྟན་པའོ།",
    "དེ་དག་ཐམས་ཅད་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་ཡོངས་སུ་བསྔོ་བས་ན་ཞེས་བྱ་བ་ནི་རྗེས་སུ་ཡི་རང་བས་སོ།",
    "དེ་ནི་དེ་ལྟར་མ་ཡིན་ཏེ་ཀོ་ཤི་ཀ་དེ་ནི་དེ་ལྟར་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་དག་ལས་གཅིག་ཡོངས་སུ་རྫོགས་པར་བྱེད་པའི་ཚེ་ཡང་དྲུག་ཅར་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྟར་ཐམས་ཅད་ཀྱི་བདག་ཉིད་ཀྱིས་རྣམ་པ་ཐམས་ཅད་དུ་རྒྱུར་འགྱུར་བ་ནི་མ་ཡིན་པར་སྟོན་ཏོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་ཐོབ་པར་མི་བྱེད།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱང་གཞན་ལ།",
    "དེ་བས་ན་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་མིང་དེ་ཡང་མཚན་མ་དེ་དང་།",
    "བཅོམ་ལྡན་འདས་འོ་ན་ཇི་ལྟར་ཐོབ་པར་བགྱིད་པ་ལགས་ཞེས་བྱ་བ་ནི།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཐོབ་པར་བྱེད་དོ་ཞེས་བྱ་བ་ཀུན་རྫོབ་ཏུ་ཡོད་པས་ཇི་ལྟར་ཐོབ་པར་བྱེད་ཅེས་ཞུས་པའོ།",
    "མིག་ལ་སོགས་པ་ལྟར་གནས་ཀྱི་དངོས་པོར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བ་དང་།",
    "གཟུང་བ་དང་སྦྱར་བར་བྱ་བ་དཀར་པོ་དང་ནག་པོའི་ཕྱོགས་སུ་གྱུར་པ་ཡང་མ་མཐོང་བས་མི་འཛིན་མི་གཏོང་བ་དེའི་ཚེ་བདག་ཉིད་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ངོ་བོར་གནས་པའི་ཕྱིར།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཐོབ་པར་བྱེད་ཅེས་ཀྱང་བཤད།",
    "གཟུགས་ལ་ཡིད་ཆེས་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་གཟུགས་དངོས་པོ་མེད་པའི་མཚན་ཉིད་དུ་ཡིད་ཆེས་ཤིང་ཁོང་དུ་ཆུད་པར་གྱུར་ཏོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "མངོན་སུམ་དུ་བྱས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཡང་དག་པར་ཞུགས་པའི་དུས་ཀྱི་ཚད་དང་།",
    "བསྙེན་བཀུར་བྱས་པའི་དེ་བཞིན་གཤེགས་པའི་ཚད་དང་།",
    "རྣམ་པར་སྨིན་པའི་བཅིང་བ་ཐམས་ཅད་ཀྱིས་མ་བཅིངས་པས་མ་བཅིངས་ཞེས་བྱའོ།",
    "དེ་བས་ན་གཟུགས་དངོས་པོ་མེད་པའི་རང་བཞིན་ནི་གཟུགས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ནི་འབྲས་བུ་རྣམ་པར་དག་པའོ་ཞེས་བྱ་བ་ནི།",
    "རྣམ་པར་བྱང་བ་རྣམ་པར་མི་རྟོག་པ་ཡང་བྱིས་པ་རྣམས་ཀྱིས་བརྟགས་པ་ཉིད་དེ་ཡོངས་སུ་གྲུབ་པ་མ་ཡིན་ནོ།",
    "དེ་ལ་གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ཉིད་འབྲས་བུ་རྣམ་པར་དག་པའོ་ཞེས་བྱ་བ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་།",
    "དེ་ལྟར་རྣམ་པར་དག་པའི་ངོ་བོ་ཉིད་བསྟན་ནས།",
    "གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ཉིད་འབྲས་བུ་རྣམ་པར་དག་པའོ།",
    "འབྲས་བུ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་གཟུགས་རྣམ་པར་དག་པའོ་ཞེས་བྱ་བ་སྟེ།",
    "མྱ་ངན་ལས་འདས་པ་ཞེས་བྱ་བ་ཡང་དག་པའི་གནས་སྐབས་ལ་ནི་འབྲས་བུ་རྣམ་པར་དག་པ་ཞེས་བྱའོ།",
    "དེ་ལ་གཟུགས་རྣམ་པར་དག་པའི་དེ་བཞིན་ཉིད་གང་ཡིན་པ་དེ་འབྲས་བུ་རྣམ་པར་དག་པ་སྟེ།",
    "རྣམ་པར་གྲོལ་བའོ།",
    "དེ་བཞིན་དུ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་རྣམ་པར་དག་པའི་བར་དུ་ཡང་སྦྱར་བར་བྱའོ།",
    "དེ་ལྟར་ན་གཟུགས་རྣམ་པར་དག་པ་དང་།",
    "འབྲས་བུ་རྣམ་པར་དག་པ་དང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་ནས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་དུ་རྣམ་པར་དག་པ་འདི་དག་ནི་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་སོ་སོ་མ་ཡིན་ཐ་མི་དད་དོ་ཞེས་བྱ་བ་སྟེ།",
    "འབྲས་བུ་རྣམ་པར་དག་པ་བོར་ཏེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་འགའ་ཞིག་བཟུང་ནས་བསྟན་ཏེ།",
    "དེ་བཞིན་གཤེགས་པའི་རྣམ་པར་དག་པ་གཅིག་གོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "ད་ནི་རྣམ་པར་དག་པ་དེ་གང་ཟག་ལ་བདག་མེད་པའི་རྣམ་པར་དག་པ་དང་།",
    "བདག་རྣམ་པར་དག་པས་གཟུགས་རྣམ་པར་དག་པ་ཞེས་བྱ་བ་ནི་བདག་དངོས་པོ་མེད་པར་ཤེས་པ་ཉིད་བདག་རྣམ་པར་དག་པའོ།",
    "དེ་ལ་འགྲེས་ཀྱི་རིམ་པ་བཞིན་དུ་བསྟན་པར་བྱ་སྟེ།",
    "བདག་རྣམ་པར་དག་པས་གཟུགས་རྣམ་པར་དག་པ་གཟུགས་རྣམ་པར་དག་པས་བདག་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ལྟར་ན་བདག་རྣམ་པར་དག་པ་དང་གཟུགས་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་དེ།",
    "དེ་བཞིན་དུ་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་རྣམ་པར་དག་པ་དང་བདག་རྣམ་པར་དག་པས་རྣམ་པར་ཤེས་པ་དག་པ།",
    "རྣམ་པར་ཤེས་པ་རྣམ་པར་དག་པས་བདག་རྣམ་པར་དག་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་བདག་རྣམ་པར་དག་པ་དང་།",
    "གཟུགས་རྣམ་པར་དག་པས་འདོད་ཆགས་རྣམ་པར་དག་པ་སྟེ།",
    "ཇི་ལྟར་མ་རིག་པ་རྣམ་པར་དག་པས་འདུ་བྱེད་རྣམ་པར་དག་པ།",
    "འདུ་བྱེད་རྣམ་པར་དག་པས་མ་རིག་པ་རྣམ་པར་དག་པ་སྟེ་དེ་ལྟར་ན་མ་རིག་པ་རྣམ་པར་དག་པ་དང་།",
    "དེ་ལྟར་ན་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་རྣམ་པར་དག་པས་ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་རྣམ་པར་དག་པ་ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་རྣམ་པར་དག་པས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ལྟར་ན་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་རྣམ་པར་དག་པ་དང་།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་ཅེས་བྱ་བར་སྦྱར་བར་བྱའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་དང་།",
    "ཕུང་པོ་ལ་སོགས་པ་ཚོར་བའི་ཚོགས་དྲུག་པོ་རྣམས་ཀྱི་མཐར་ཐུག་པའི་རྣམ་པར་དག་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་རྣམ་པར་དག་པ་བཟུང་ནས་དེ་དག་གཉིས་སུ་མེད་པར་བསྟན་པའི་འགྲེས་ཏེ།",
    "ཇི་ལྟར་རབ་འབྱོར་གཞན་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་གཟུགས་རྣམ་པར་དག་པ།",
    "གཟུགས་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་དང་།",
    "གཟུགས་རྣམ་པར་དག་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་སོ་སོ་མ་ཡིན་ཐ་མི་དད་དོ་ཞེས་བྱ་བ་དེ་བཞིན་དུ་ཚོར་བ་རྣམས་དང་།",
    "རྣམ་པར་ཤེས་པ་ནས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་བར་དུ་རྣམ་པར་དག་པ་གང་ཡིན་པ་དེ།",
    "དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་ཅེས་བྱ་བ་ལ་སོགས་པ་ལ་ཡང་སྦྱར་བར་བྱའོ།",
    "དེ་ནས་ཡང་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་ནས།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་རྣམ་པར་དག་པ་བཟུང་ནས་དེ་དག་གཉིས་སུ་མེད་པ་བསྟན་པ་དང་།",
    "སྟོང་པ་ཉིད་ཐམས་ཅད་རྣམ་པར་དག་པ་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་རྣམ་པར་དག་པ་འདི་ལ་གཉིས་སུ་མེད་པར་བསྟན་པ་དང་།",
    "དེ་ནས་ཡང་འདུས་བྱས་དང་།",
    "འདུས་མ་བྱས་རྣམ་པར་དག་པའི་འགྲེས་དང་།",
    "དུས་གསུམ་རྣམ་པར་དག་པའི་འགྲེས་བསྟན་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་དག་པ་འདི་ནི་ཟབ་པོ་ཞེས་བྱ་བ་ལ་སོགས་པས་རྣམ་པར་དག་པའི་ཚིག་བཅུ་གསུམ་རིམ་གྱིས་བསྟན་པར་བརྩམས་སོ།",
    "དུས་ཐམས་ཅད་དུ་ཤིན་ཏུ་རྣམ་པར་དག་པ་ཡིན་པར་བྱིས་པ་རྣམས་ཀྱི་ཡིད་ཆེས་པར་དཀའ་བས་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་ཟབ་ཅེས་བྱའོ།",
    "ཤཱ་རིའི་བུ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རྣམ་པར་དག་པ་ནི་སྣང་བའོ་ཞེས་བྱ་བ་ནི་འདི་ལྟ་སྟེ་དཔེར་ན་སྤྲིན་དང་།",
    "ན་བུན་དང་ཁུག་རྣ་ལ་སོགས་པ་མེད་ན་ཉི་མ་དང་ཟླ་བ་ལ་སོགས་པ་ཤིན་ཏུ་རྣམ་པར་དག་པ་སྟེ།",
    "དེ་བས་ན་གཟུགས་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཕྱིར་རྣམ་པར་དག་པ་སྣང་བའོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "རྣམ་པར་རྟོག་པའི་སྤྲོས་པའི་དྲི་མ་རྣམས་སྤངས་པ་ནི་སླར་ཉིང་མཚམས་མི་སྦྱར་བའི་ཕྱིར།",
    "དྲི་མ་མེད་ཅིང་རྣམ་པར་དག་པས་ན་ཉིང་མཚམས་སྦྱོར་བ་མེད་པ་ཞེས་བྱའོ།",
    "འཐོབ་པ་ཡང་ཡོད་པར་འགྱུར་ལ།",
    "རྣམ་པར་དག་པ་ནི་འདོད་པ་དང་།",
    "གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་སུ་སྐྱེ་བ་མ་ལགས་སོ་ཞེས་བྱ་བ་ནི་འདོད་པ་དང་གཟུགས་དང་གཟུགས་མེད་པའི་ཁམས་རྣམས་ཀུན་བརྟགས་པ་སྟེ།",
    "དེ་བས་འདོད་པའི་ཁམས་ཀྱི་རང་བཞིན་མི་དམིགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་དག་པ་ནི་འཚལ་བ་མ་མཆིས་པའོ་ཞེས་བྱ་བ་ནི་བདག་རང་ཤེས་པའི་ངོ་བོ་ཉིད་མ་ཡིན་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འཚལ་བ་མ་མཆིས་པ་ཞེས་བྱ་བ་འདིས་ནི་རྣམ་པར་དག་པ་རྣམ་པར་མི་རྟོག་པའི་མཚན་ཉིད་ཡིན་པར་བསྟན།",
    "གཉིས་ཀྱིས་ནི་དམིགས་པར་བྱ་བ་དང་།",
    "དམིགས་པར་བྱེད་པ་དངོས་པོ་མེད་པའི་མཚན་ཉིད་བསྟན་ཏོ།",
    "དེ་བཞིན་ཉིད་ནི་དེ་བཞིན་ཉིད་ལ་ཕན་པའམ་གནོད་པར་མི་བྱེད་དེ།",
    "དེའི་འོག་ཏུ་གནས་བརྟན་རབ་འབྱོར་གྱིས་བཅོམ་ལྡན་འདས་བདག་རྣམ་པར་དག་པའི་སླད་དུ་གཟུགས་རྣམ་པར་དག་པའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ནི་བདག་དངོས་པོ་མེད་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འདིར་ནི་རྣམ་པར་དག་པ་ཞེས་བྱ་བ་དངོས་པོ་མེད་པ་ལ་བྱ་བའི་ཕྱིར་རོ།",
    "དེ་བས་ན་རབ་འབྱོར་བདག་མེད་པའི་ཕྱིར་གཟུགས་མེད་པ་ནི་ཤིན་ཏུ་རྣམ་པར་དག་པའོ་ཞེས་གསུངས་སོ།",
    "སྔར་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམ་པར་དག་པ་བསྟན་ཏོ།",
    "ད་ནི་བདག་མེད་པ་རྣམ་པར་དག་པ་བསྟན་ཏེ།",
    "ཡོངས་སུ་གྲུབ་པའི་གནས་སྐབས་ན་ཡང་ནམ་མཁའ་བཞིན་དུ་སྔོན་མ་བྱུང་བའི་རྣམ་པར་བྱང་བ་མེད་དོ།",
    "དེ་བས་ན་རབ་འབྱོར་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་དང་ཐོག་མ་དང་ཐ་མ་མེད་པའི་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་རོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "བྱ་བ་བྱས་པ་མ་ཡིན་གྱི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ལམ་གྱི་རྣམ་པ་སྟེ།",
    "ཚུ་རོལ་གྱི་འགྲམ་ན་ཡང་མི་གནས་ཕ་རོལ་གྱི་འགྲམ་ན་ཡང་མི་གནས་འགྲམ་འདི་གཉིས་ལས་མ་གཏོགས་པ་གཞན་དུ་འང་མི་དམིགས་པའི་ཕྱིར་དེ་སྐད་གསུངས་ཏེ།",
    "ཚུ་རོལ་གྱི་འགྲམ་ཞེས་བྱ་བ་ནི་འདུས་བྱས་སུ་གཏོགས་པའོ།"
  ]
}