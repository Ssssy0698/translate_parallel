    "སྐྱ་སྤྲང་གི་ཞལ་ནས་གླང་གསོད་པ་ཅི་ཉེས།",
    "དེ་ནས་སྐྱ་སྤྲང་ཁྱོད་ཀྱིས་རོག་གྱིས།",
    "ཤན་པ་ཁྱོད་ང་ལ་ཉོན་དང་།",
    "གླང་འདི་མ་བསད་དང་གླང་བསད་པ་བས་མ་བསད་པ་རུང་གིས།",
    "གླང་འདིས་ས་ཞག་རྨོས་པས་སའི་བདག་མོ་ཁྲོས་ནས།",
    "དེ་ནས་ཐོང་མཁན་སྲིད་པ་ལེགས་གསུམ་གྲགས་འཁོན་དུ་བཅུག་པ་ཡང་སའི་བདག་མོ་ཡིན་ནོ།",
    "ད་ལྟ་གླང་རྨོ་རུ་མི་འདོད་པ་ཡང་སའི་ལྷ་མོ་དང་སའི་བདག་མོ་མ་ལགས་པ་རྨོ་རུ་མི་སྟེར་བ་ཡིན་ནོ།",
    "སའི་བདག་མོས་རླང་པ་གླང་སྣར་བཏང་བས་གླང་སྦོས་ནས་རྨོ་མ་ནུས་པ་ཡིན་ནོ།",
    "སཱ་ལུ་ལྗང་པ་རེ་རེ་ལ་བརྒྱ་བརྒྱ་འཕེལ་ལགས་སོ།",
    "རྩེ་མོ་དང་འབྲས་བུ་འཚལ་བས་བདུད་རྩིར་བྱུང་།",
    "གླང་ཡང་བརྒྱགས་ཐོང་མཁན་པ་ཡང་ཚོ་བར་གྱུར་པ་ལས།",
    "གླང་གི་སྔོན་ན་སྒྲིག་རྒྱུ་འགྱུ་བས་གླང་འགྲོ་མ་འཆིས།",
    "གླང་བཀུམ་དགོངས་ནས་གླང་གི་སྣ་ནས་ཁྲིད་དགོངས་ནས་མཆིས་པ་ལས་སྐྱ་སྤྲང་མི་ཞིག་མཆིས་ནས།",
    "སྐྱ་སྤྲང་ཁྱོད་ཀྱང་སྤྲང་པོ་བས་འདི་བཤའ་བའི་རོག་གྱིས་དང་།",
    "དེ་དོན་ཤ་འདྲེན་འོང་གིས་བྱས་པས།",
