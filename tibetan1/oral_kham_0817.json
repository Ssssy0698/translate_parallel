    "ཟླ་བ་དགུ་ལས་མ་བརྟེན་པར་འདུག།",
    "རྗེ་བཙུན་རས་ཆུང་པ་རྡོ་རྗེ་གྲགས་པ་ལ་ཕུལ་བར་འདུག།",
    "དེ་ནས་རིམ་གྱི་རྒྱུད་པ་ཅིག་ཀྱང་འདུག།",
    "དེ་རྣམས་ལ་གནང་བར་འདུག་སྟེ།",
    "བེམ་རྡུལ་རགས་པ་ཡང་རང་དང་རིགས་འདྲ་ངེས་པར་སྔོན་དུ་འགྲོ་མི་དགོས་པ་ནི།",
    "སྲིད་པ་རྣམས་ནི་རང་རང་ལས་ཀྱི་རྫུ་འཕྲུལ་དང་ལྡན་པས་འཇིག་རྟེན་ཁམས་གཞན་ནས་གཞན་དུ་སྐྱེ་བ་མཐའ་ཡས་པའི་ཕྱིར་རོ།",
    "དམིགས་བསལ་སྦྱང་བརྩོན་ཡོད་འཙ་ན་དེ་ལས་ཆེས་ཆེ་བ་འཁྱེར་ཐུབ་པ་དེ་ལྟར་དེ་ལ་ཁྱབ་པའི་ཚོར་བ་ཉམས་ན་རྐང་པ་རང་ཡང་ཚུགས་བ་༤མི་ཐུབ་པ་བཞིན་ནོས།",
    "དེ་བཞིན་འདུ་ཤེས་ཡོད་པས་ཡུལ་བཟང་ངན་དང་ཡིད་དུ་འོང་བ་དང་མི་འོང་བ་དང་རང་དང་སྤྱིའི་མཚན་ཉིད་སོགས་ཡུལ་གྱི་སྤུ་ཀ་རིས་འབྱེད་དེ་ལེགས་ཉེས་ཀྱི་བླང་དོར་དཔྱོད་ཤེས་ཀྱི་ཤེས་རབ་འཕེལ་བར་བྱེད་པའམ་ཡང་ན།",
    "དངོས་པོ་གང་དང་གང་ཡིན་ཡང་རྒྱུ་ལ་རང་རང་དང་རྒྱུད་གཅིག་ཏུ་གཏོགས་པ་ལ་རིགས་ས་ནམ་བབ་འ།",
    "ཐོག་མ་མེད་པའི་དུས་ན་དེ་བས་སྔ་བ་མེད་པའི་མེས་པོ་རྒྱུན་དང་ཀའ་༤ ད་ལྟའི་བུ་ཚ་རྣམས་ཕ་རོལ་ན་འགྲོགས་ན་ད་ལྟར་མིའི་རུས་དང་རིགས་དང་ཕྱོགས་དང་རིས་ས་༥ ཙ་བ་པས་མི་གཅིག་པ་ཐ་དད་པ་མང་པོ་ཇི་སྙེད་པ་རྣམས་སོ་བསབབ་༡་སོར་དགྲར་གྱུར་པ་རྣམས་དང་གནས་གང་ན་༧འདུག་པ་དང་རུས་རིགས་གཅིག་པ་དང་།",
    "གྲོང་གང་ཡིན་པ་ཞིག་བོར་ཏེ་ཡུལ་བའི་འབཅར་འདབ་མ་བས་ང་གཞན་ཞིག་ཏུ་ཚེ་སྨད་ལ་འདུག་པ་ན།",
    "དེའི་ཚེ་ལྷས་བྱིན་དེ་ནི་འདུག་ཀུཔས་བཅོམ་ལྡན་འདས་ཀྱིས་དེ་སྐད་ཅེས་གསུངས་ཏ་སྨ་༥༣ས་༡༩༡༣ལྟ་པ་དེ་ལ་ཡིད་མ་ཆེས་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེའི་ཚེ་ཤཱཀྱ་མིང་འ་ཆེན་དེ་ན་འདུག་པས་ཚེ་འཕོས་པ་ཅིར་འགྱུར་བ་ལས་བཀའ་སྩལ་པ་ལ་ཡིད་མ་ཆེས་ནས་བཅོམ་ལྡན་ཧྥ་བ་༩༧ འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ས་མི་སྨྲ་བར་འདུག་གོ།",
    "འདུག་པ་དང་།",
    "མའི་མངལ་ན་གཡས་ཕྱོགས་སུ་ཙོག་པོར་འདུག་ལ།",
    "བལྟས་ཏེ་འདུག་གོ།",
    "རྩིབ་ལོགས་གཡོན་ཕྱོགས་སུ་ཙོག་པོར་འདུག་གོ།",
    "འརྩའི་རྐྱལ་པའི་ནང་དུ་འདུག་པ་དང་ཏི་ཕྱིན་༤༡ནའདྲའོ་། གལ་ཏེ་དེའི་མས་ཤིན་ཏུ་མང་དུ་ཟོས་སམསཾ།",
    "ལམ་འབྲས་བུ་དང་བཅས་པའི་དཀར་ཆག་འཇམ་དཔལ་ཨ་ར་པ་ཙ་ནའི་མངོན་རྟོགས།",
    "ཤེས་རབ་ཆེ་བར་འདུག་པས་ཀློག་འདྲ་སློབས་དང་ལས་སླ་བར་ཡོང་ཟེར།",
    "མི་གཞན་མང་པོ་ལུང་པའི་ཕུ་ན་ཡར་འགྲོ་ཞིང་འདུག།",
    "དེར་གཞན་རྣམས་ཀྱིས་ཀྱང་འབུལ་བ་བྱེད་ཅིང་འདུག།",
    "མ་ཁུས་རྩད་བཅད་པས་རྗེ་བཙུན་གྱི་དྲུང་ནུ་འདུག་ཅིང་།",
    "རྗེ་བཙུན་ལ་ཕུལ་བར་ཤེས་ནས་མ་ཁུས་ཇི་ལྟར་བཀག་རུང་མ་ཁེགས་པས་ཁོང་རང་གཉིས་ཁྲོས་ནས་ཤིན་ཏུ་སྡང་ཞིང་སྡུག་པར་བཅོལ།",
