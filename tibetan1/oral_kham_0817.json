    "སྨྲ་བསམ་བརྗོད་དུ་མེད་པ་གཅིག་གདའ།",
    "དེ་འདྲའང་བྱེད་ཀྱི་གདའ་ཞུས་པས།",
    "དེ་ན་ཛོ་ཀི་དང་བསྒོམ་ཆེན་མང་པོ་བཞུགས་འདུག་པ་ལ།",
    "ལམ་དང་མདུན་གྱི་འགྲོ་འདུག་ལ།",
    "ལ་ལའི་ས་ན་མི་དད་པར་ཁྲོས་སྟངས་བྱེད་ཅིང་འདུག་པས།",
    "ལ་ལའི་སར་མི་དད་པ་བྱེད་ཅིང་འདུག་པ་ཅི་ཡིན་བྱས་པས།",
    "རྗེ་བཙུན་ཕྱག་ལེན་གྱི་ཐུགས་དགོངས་ཙམ་ཡང་མི་འདུག་པ་དང་།",
    "བདུད་ཀྱི་བྱིན་ཀྱིས་བརླབས་སམ་གང་ནའང་ང་རྒྱལ་གྱི་བར་ཆད་ཅིག་བྱུང་འདུག་པས།",
    "རྗེ་བཙུན་གྱིས་དགོངས་ཏེ་ལམ་བར་ལ་གཡག་རུ་ཞིག་འདུག་པ་ལ།",
    "མི་རྒས་ཀྱིན་འདོད་པ་ཆེ་ཟེར་བའི་དཔེ་དེ་མཛད་འདུག།",
    "ཅུང་ཟད་བཞུགས་པས་ས་མཐོ་ས་ཞིག་ན་གཡག་རུ་དེ་འདུག་པའི་ཐད་དུ།",
    "ལྟ་བསྒོམ་སྤྱོད་འབྲས་ལ་མཐོ་དམན་འདུག་པས་བསམ་བློ་ཐོངས་ཞེས་པའི་ངོ་སྤྲོད་གེགས་སེལ་བོགས་འདོན་གྱི་མགུར་གསུངས་པས།",
    "ངེས་པར་ང་རང་ཡང་ཤོར་བ་ཡིན་ནམ་སྙམ་འགྲོ་གྲབས་བྱས་པས་ལག་མགོ་ཡང་མ་ཐར་བ་དང་།",
