    "དེ་ལྟར་ན་ཁམས་ལ་མཁས་ན་བདག་ལ་རྒྱུར་འཛིན་པ་ལྡོག་པར་འགྱུར་རོ།",
    "ཁམས་ཀྱི་དོན་གྱི་འོག་ཏུ་སྐྱེ་མཆེད་རྣམས་ཀྱི་དོན་བརྗོད་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
    "༦༦༥རྣམས་ལས་ཀྱི་གཞན་ཞེས་བྱ་བའི་སྒྲ་འདི་གནས་པར་བསྟན་པའི་ཕྱིར།",
    "ཝིཏི་༡༣༩དངོས་པོ་ཡིན་པའི་ཕྱིར་སྐྱེ་མཆེད་འདི་དག་རིག་པར་བྱ་སྟེ།",
    "ཚོར་བ་དང་དོན་ཡོངས་སུ་གཅོད་པ་ལ་ཉེ་བར་སྤྱོད་པའི་སྒོ་ནས་ཟ་བ་པོར་རྣམ་པར་རྟོག་པ་འབྱུང་སྟེ།",
    "དེའི་ཕྱིར་དོན་གཉིས་ཀྱིས་སྐྱེ་མཆེད་རྣམ་པར་གཞག་པ་བྱས་སོ།",
    "ཟ་བ་པོའི་བདག་མེད་དོ་སྙམ་ནས་བདག་ཟ་བ་པོར་འཛིན་པ་ལྡོག་པར་འགྱུར་རོ།",
    "འདི་ལྟར་ཀུན་བརྟགས་པའི་གཟུགས་ཁོ་ན་འདིར་དགག་པར་བྱའི།",
    "རྣམ་པར་བརྟགས་པའི་གཟུགས་ནི་མ་ཡིན་ནོ།",
    "རྒྱུ་དེ་ལས་བྱུང་བ་འཇུག་པའི་རྣམ་པར་ཤེས་པ་ལ་གཟུགས་ལ་སོགས་པར་སྣང་བ་ནི་ཕྱིའི་སྐྱེ་མཆེད་དོ།",
    "གཟུགས་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ལ་སོགས་པར་སྣང་བ་ནི་རྣམ་པར་ཤེས་པ་ལས་ཐ་དད་ན་དེ་ཉིད་སྐྱེ་བའི་རྐྱེན་དུ་དེ་ཉིད་འགྱུར་བར་ནི་མི་རིགས་ཏེ།",
    "དེ་ལྟ་བས་ན་གདོན་མི་ཟ་བར་རྣམ་པར་ཤེས་པ་སྣང་བ་ལས་ཐ་དད་པར་གྱུར་པ་གཟུགས་ལ་སོགས་པར་ཁས་བླང་བར་བྱའོ་ཞེ་ན།",
    "བག་ཆགས་ཡོངས་སུ་གྱུར་ནས་ཡང་གཟུགས་ལ་སོགས་པར་སྣང་བའི་རྣམ་པར་ཤེས་པ་སྐྱེ་སྟེ།",
    "དེ་ལྟར་ན་རང་སྣང་བའི་རྣམ་པར་ཤེས་པའི་རྐྱེན་ཡིན་པའི་ཕྱིར་གཟུགས་ལ་སོགས་པར་སྣང་བ་ནི་དམིགས་པའི་དོན་དུ་འཐད་དོ།",
    "རྣམ་པར་ཤེས་པ་དང་ལྷན་ཅིག་སྐྱེས་པ་ནི་དམིགས་པའི་རྐྱེན་དུ་འཇོག་པ་དེ་བཞིན་དུ་འདིར་ཡང་གཟུགས་ལ་སོགས་པ་སྣང་བའི་རྣམ་པར་ཤེས་པ་བསྐྱེད་པར་བྱ་བ་དང་སྐྱེད་པ་པོའི་དངོས་པོར་མེད་ཀྱང་དེ་ཡོད་པ་དང་མེད་པ་ལས་རྣམ་པར་ཤེས་པ་ཡོད་པ་དང་མེད་པར་འགྱུར་བ་འཁྲུལ་པ་མེད་པའི་ཕྱིར་རྐྱེན་དང་རྐྱེན་ཅན་དུ་རྣམ་པར་གཞག་གོ་། གཟུགས་སུ་སྣང་བ་དང་རྣམ་པར་ཤེས་པ་གཉིས་ཐ་མི་དད་པའི་ཕྱིར།",
    "གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པའི་གནས་ཡིན་པའི་ཕྱིར་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་ཐ་སྙད་ཀྱི་ཐ་དད་པ་ལྟ་བུར་དམིགས་པར་བྱ་བ་དང་དམིགས་པར་བྱེད་པའི་དངོས་པོར་རྣམ་པར་གཞག་པ་དེ་བཞིན་དུ་གཞན་ལ་ཡང་འགལ་བ་མེད་དོ།",
    "གཞན་ཡང་དམིགས་པར་བྱ་བ་དང་དམིགས་པར་བྱེད་པའི་དངོས་པོ་ནི་ཐམས་ཅད་དུ་ཡང་གདགས་པ་ཉིད་དུ་ཟད་ཀྱི་དངོས་སུ་མེད་དེ།",
    "རྣམ་པར་ཤེས་པ་ནི་སྐྱེས་པའམ་མ་སྐྱེས་པས་ཀྱང་ཡུལ་ལ་དམིགས་པར་མི་འགྱུར་ཏེ།",
    "སྐྱེས་མ་ཐག་ཏུ་ཞིག་པའི་ཕྱིར་དམིགས་པར་བྱེད་པའི་ཚེ་མི་སྡོད་པ་དང་མེད་པའི་ཕྱིར་རོ།",
    "གཞི་མེད་པ་ལ་ནི་དམིགས་པར་བྱར་མི་རུང་ངོ།",
    "སྐྱེ་བའི་ཚེའང་དོན་མེད་པར་འགྱུར་ཏེ་མེད་པའི་ཕྱིར་རོ།",
    "སྐྱེ་བའི་ཚེ་དོན་མེད་པར་མི་འགྱུར་ཏེ།",
    "འདི་ལྟར་ཡུལ་གྱི་དངོས་པོ་ཡོད་ན་རྣམ་པར་ཤེས་པ་དེར་སྣང་བའི་བདག་ཉིད་འཐོབ་པའི་ཕྱིར་རོ་ཞེ་ན།་",
    "གལ་ཏེ་ཡུལ་དུ་སྣང་བའི་རྣམ་པར་ཤེས་པའི་རྒྱུ་ཕྱི་རོལ་གྱི་དོན་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་འདས་པ་དང་མ་འོངས་པ་དང་རྨི་ལམ་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་རྣམ་པ་མེད་པར་འགྱུར་རོ།",
    "ཧ་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ཕྱིའི་དོན་ཡང་རྣམ་པར་ཤེས་པའི་དམིགས་པའི་རྐྱེན་དུ་མི་འགྱུར་ཏེ།",
    "དེ་བས་ན་རབ་རིབ་ཅན་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ཕྱིའི་དོན་དམིགས་པ་ལ་མི་ལྟོས་པ་ཉིད་ཁས་བླང་བར་བྱའོ།",
    "འདི་སྐྱེས་པའི་ཕྱིར་འདི་སྐྱེ་བ་སྟེ་་འདི་ལྟར་མ་རིག་པའི་རྐྱེན་གྱིས་འདུ་བྱེད་རྣམས་ཞེས་བྱ་བ་རྒྱ་ཆེར་གསུངས་པ་ལྟ་བུའོ།",
    "དེ་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "མེད་ན་ནི་མ་ཡིན་ནོ་ཞེས་འབྲས་བུ་འདུ་བྱེད་ལ་སོགས་པར་བདག་སྒྲོ་འདོགས་ན་འབྲས་བུ་ལ་སྒྲོ་འདོགས་ཅིཔ་ཞེས་བྱའོ་ཞེའོ།",
    "ལེགས་པར་སྤྱད་པ་ཡང་མེད།",
    "ཉེས་པར་སྤྱད་པ་ཡང་མེད།",
    "འཇིག་རྟེན་ཕ་རོལ་ཡང་མེད་དོ་ཞེས་མེད་པ་རྣམས་ལེགས་པར་སྤྱད་པ་དང་།",
    "ཉེས་པར་སྤྱད་པ་དང་འཇིག་རྟེན་ཕ་རོལ་ལ་སྐུར་པ་འདེབས་པར་སྨྲ་བའོ།",
    "བྱེད་པ་ལ་སྒྲོ་འདོགས་པ་ནི་འདུ་བྱེད་ལ་སོགས་སྐྱེ་བ་ལ་མ་རིག་པ་ལ་སོགས་པ་བྱེད་པར་རྟོག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་གལ་ཏེ་འདུ་བྱེད་ལ་སོགས་པ་སྐྱེ་བ་ལ་མ་རིག་པ་ལ་སོགས་པ་དངོས་པོའི་རང་བཞིན་དོན་གཞན་དུ་གྱུར་པ་ཞིག་བྱེད་པར་རྟོག་པ་དེ་ལྟ་བུ་ནི་བྱེད་པ་ལ་སྒྲོ་འདོགས་པའོ།",
    "བྱེད་པ་ལ་སྐུར་པ་༦༧ ༡དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "འདེབས་པ་ནི་ནུས་པ་མེད་པར་རྟོག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ལ།",
    "མ་རིག་པ་ལ་སོགས་པ་ཡོད་པ་ཙམ་གྱིས་འདུ་བྱེད་ལ་སོགས་པ་སྐྱེ་བར་ནུས་པ་ཡིན་ཡང་ནུས་པ་མེད་པར་རྟོག་པའི་ཕྱིར་བྱེད་པ་ལ་སྐུར་པ་འདེབས་པའོ།",
    "དེ་མེད་པའི་ཕྱིར་སྒྲོ་འདོགས་པ་དང་སྐུར་པ་འདེབས་པ་མེད་པར་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་རྒྱུ་དང་འབྲས་བུ་དང་བྱེད་པ་རྣམས་ལ་སྒྲོ་འདོགས་པ་དང་སྐུར་པ་འདེབས་པ་དེ་མེད་པའི་ཕྱིར་སྒྲོ་འདོགས་པ་མེད་པ་དང་སྐུར་པ་འདེབས་པ་མེད་པར་རིག་པར་བྱའོ།",
    "བྱེད་པར་འཛིན་པ་གང་ཡིན་པ་དེའི་གཉེན་པོ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདུ་བྱེད་རྣམས་མ་གཏོགས་པར་རྣམ་པར་ཤེས་པའི་བྱེད་པ་གཞན་མེད་དོ།",
    "ཐམས་ཅད་དུ་ཡང་ཅི་རིགས་པར་བརྗོད་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
    "བདེན་པར་སྨྲ་ཞིང་ཁྲོ་བ་མེད།",
    "སློང་ལ་ཆུང་ཡང་སྦྱིན་པར་བྱ།",
    "ལེགས་པར་སྤྱོད་པ་ནི་སྲོག་གཅོད་པ་ལ་སོགས་པ་སྦྱོར་བ་དང་བཅས་པ་དང་།",
    "བདེ་འགྲོར་སྐྱེ་བ་ནི་ལེགས་པར་སྤྱད་པ་ལ་རག་ལུས་པ་ཉིད་དོ།",
    "དེ་དག་མ་སྤངས་ལགས་ཞེས་བྱ་བ་ནི་མ་བཏང་བའོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་དང་།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ས་གསུམ་གྱི་སྟོན་པར་མི་སྲིད་པའི་ཕྱིར་ཏེ།",
    "སོགས་པ་ཞེས་བྱ་བའི་སྒྲས་ནི་མ་བྱིན་པར་ལེན་པ་ལ་སོགས་པ་བསྡུས་ཏེ།",
