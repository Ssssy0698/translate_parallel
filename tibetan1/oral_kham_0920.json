    "ཁོ་རང་སྐྱེས་དུས་སམ་ད་ལྟ་རྩིས་ནམ་བརྩི་དུས་ཀྱི་དུས་གང་ཡིན་གཉིས་ལ་ཟེར།",
    "དེ་སྟེང་ལོ་ཟླའང་རང་ལོ་ཡིན་པ་འདོམས་པར་བཙས་ན་ལྟ་མིག་ལོང་།",
    "དེ་སྟེང་ཞག་དུས་ཀྱང་རང་ལོར་འདོམས་ན་རྭ་ཆག་པའོ།",
    "ཕ་མའི་ལོག་མིན་དང་རང་ལོ་བཅས་གང་རུང་ལྕགས་བཞི་མེ་བརྒྱད་ལ་བབ་པ་ངན་ཀླུང་བཅུ་གཉིས་ཡིན།",
    "གཟའི་ཁམས་ཀྱི་དར་རྒུད་ལོ་དེའི་སྟེང་དུ་ཁྱེར་བ་ནི་མིན་པར་འདུག།",
    "གསོན་པོ་ལོས་བཅོམ་པ་ཞེས་ཀེག་རྩིས་ཡིན་ན་ཀག་དུས་ཡིན།",
    "ནང་གཟའི་ཀག་རྩིས་སྐྱེས་སྤར་སྟེང་བབ་སླར་ཕྱིན་པ་ལ་ངོས་འཛིན་མཛད་འདུག།",
    "ཕ་མའི་ལོག་མིན་བདུན་ཟུར་ཐུག་དུས་བཙས་པའོ།",
    "རྒྱལ་བློན་བཞི་ལོ་ཟླ་ཞག་དུས་བཞི་ཡི་སྲོག་སོགས་བཞི་དང་།",
    "ཕ་སྟག་ཡོས་ཟིན་བུ་ཁྱི་འབྲུག་ཟིན་བཅས་དྲངས་འདུག།",
    "གཞན་ལའང་རང་མཐུན་པ་སྒྱུར་ཟེར་ཀྱང་དོན་འདྲ།",
    "མ་ལོའི་དགྲ་དུར་གྱི་ལོ་ཟླ་ཞག་དུས་བཙས་པ་དང་།",
    "གཞན་ཡང་རང་ཟླར་ལྟོར་ཞུགས་ན་ཞེས་སོགས་སྐབས།",
    "རང་ལོ་རང་དགྲར་འགྱུར་ག་ལ་ཤེས་ཀྱང་ལོ་ཁོ་ནར་མ་ཟད་སྐྱེས་དུས་ཀྱི་ཟླ་ཞག་དུས་ཀྱི་ལོའི་སྲོག་ལའང་འཐབ་པར་བཤད།",
    "ཟླ་ཞག་དུས་བདུན་གྱི་སྟེང་དུ་བུ་ཡི་སྲོག་སོགས་བཞིའི་དར་གུད་སྤྱི་ལྟར་བསྐོར་བའོ།",
    "བུ་བཙས་སྐབས་ཀྱི་ལོ་ཟླ་ཞག་དུས་མའི་ལོག་མིན་གྱི་སྲོག་དང་ཀླུང་རྟས་ཕའི་དེ་གཉིས་གཅོད་ན་སྲིན་པོ་ཕ་གཅོད་དོ།",
    "སྲོག་ལུས་ཀྱི་རྡེལ་ཕྲེང་རྣམས་འདུག་ས་བརྗེ་བ་མན་ངག་གོ།",
    "རྩུབ་རིགས་འདི་ལ་ལོ་དེ་དང་རང་ལོའི་སྲོག་སོགས་འཐབས་པས་བྱེ་བྲག་ཏུ་རྩུབ་མི་རྩུབ་ཤེས་པ་ཀུན་ལ་གལ་ཆེ།",
    "སྔ་ལོ་གཉིས་ནག་ཡིན་ན་རྒྱབ་འདུག་ཅེས་དང་།",
    "ཉེར་གཅིག་དུས་གླང་ཤར་ཀྱང་མེད་པ་ལྟ་བུས་འགྲེ།",
    "ཤིང་ཁམས་ཞེས་པར་སྟག་ཡོས་མཆན་འདུག་པས།",
    "ལུགས་དེའི་མ་ལ་དཀར་གསུམ་སོགས་བཞག་འདུག་བླ་ནི་སྲོག་མའོ།",
    "ཡང་ནི་རྡེལ་སྒོ་ལ་དུས་ཚད་ཀྱང་བརྟག་ཅེས་པའི་ཚིག་འབྲུ་མནན་ན་དཀའ་ཙམ་དུ་མ་གཞུང་འདིའི་རྩོམ་གཤིས་ལ་འདུག་པ་སྐབས་འདིར་མ་ཟད་ཀུན་ལ་ཤེས་དགོས།",
    "དེ་ཡང་ལོ་ཟླ་ཞག་དུས་དང་སྨེ་བ་འཐབ་པའམ་དར་གུད་ཀྱིས་བརྟག་ལ།",
    "དེ་ཅི་ལྟར་ན་རང་ལོ་ཡི་སྲོག་དང་སྐྱེས་པའི་སྤུར་སྨྲེ་གསུམ་གྱི་ཁམས་དབུགས་སྤྱི་ལྟར་བླངས་ལ་ན་བའི་དུས་ཀྱི་ལོ་ཟླ་ཞག་དུས་སྟེང་ཁྱེར་བས་ཤེས་སོ།",
    "ནམ་ན་བའི་ལོ་ཟླ་ཞག་དུས་ཀྱི་སྲོག་ཁམས་བཞི་དང་།",
    "དེ་སྟེང་ལོ་ཟླ་ཞག་དུས་བཞི་གང་ཡིན་ཀྱང་།",
    "ལོ་ཟླ་ཞག་དུས་སྤར་སྨེ་བསྟུན་ཞེས་པ།",
    "རྡེའུ་བཅུ་དགུ་མ་བརྩི་བྱའི་སྲོག་ལུས་ཀྱིས་ན་དུས་ཀྱི་ལོ་ཟླ་ཞག་དུས་ཀྱི་སྲོག་ལུས་ལ་འཐབ་ལ་དང་སྲོག་ལུས་དར་གུད་ལོ་ཟླ་ཞག་དུས་སྟེང་ཁྱེར་བ་བཅུ་དྲུག་དང་།",
    "ཞག་དུས་ཀྱི་ཀེག་ལ་བདུན་ཟུར་བཞི་གཤེད་གཙོ་ཆེ་ལ།",
    "དེ་བཞིན་ཉི་མར་ན་ན་ཟླ་ལྷག་དུས་མ་སྐྱོན་ན་ཕུར་བུར་འཚོ་སོགས་འགྲེ།",
    "གཅིག་དུས་སུ་འཆིང་ཡིན་ལ།",
    "གཤིན་གྱི་སྨེ་བས་ནི་གནམ་ལོའི་སྨེ་བ་དང་ཟླ་ཞག་དུས་ལོག་མིན་གྱིའང་བརྩི་བྱ་དང་སྨེ་ཕྲེང་མཐུན་པའི་སྨེ་བ་དེ་དང་འཐབ་དགོས།",
    "སྨེ་བ་དཀར་གསུམ་དང་དམར་གཉིས་སེར་གསུམ་དང་ནག་གཉིས་ལྗང་དང་གསུམ་སྟེ་བཞི་ངོས་འཛིན་ལ་བརྩིས་འདུག།",
    "དེ་ཡང་སྐྱེས་སྤར་ལས་བརྩི་བ་འདུག་ཀྱང་འདིར་སོ་སྐྱེས་སྤར་ལ་བརྩི་དོན་མེད་པས།",
    "དེ་ཡང་ལོ་ཟླ་ཞག་དུས་ལ་བརྟག་ཅེས་འདུག་གོ།",
    "ཟླ་ཞག་དུས་གསུམ།",
    "ཉི་ཤུ་པོ་དཀར་ནག་བགྲངས་པའི་སྤྱིའི་ཁ་དམར་རྡེལ་གཅིག་སྟེ་བཏང་གཅོད་རྡེའུ་ཉེར་གཅིག་ལ་འཆི་དུས་རྡེལ་ཕྲན་ཉེར་གཅིག་ཏུ་འཇོག་པ་འདྲ་སྟེ་བུ་དཔེའི་ཁྲ་མར་དེ་ལྟར་འདུག།",
    "དེ་བཞིན་ཟླ་ཞག་དུས་གང་ལ་ཤི་བ་དེ།",
    "སྔར་ཟླ་ཞག་དུས་དེའི་བདུན་ཟུར་ལ་བདུད་བཅད་ཅེས་སོ།",
    "ཞག་དུས་གཟའ་སྐར་གང་ལ་ཤི་འབྲས་གཞུང་ན་གསལ།",
    "ཡིན་པ་ལ་རྡེལ་དཀར་བཞག་འདུག་ཀྱང་སྤྲོས་པ་ཙམ་སྟེ།",
    "འདུག་སྟངས་རྡེལ་བཞི་བཅས་ལས་དང་པོ་ལ།",
    "༣ གནམ་སྒོ་ས་སྒོ་བཅས་ཡོད་མེད་བརྟག་པས་ལོ་དང་ཕྱི་གཟའ་བཅས་ལ་ངོས་འཛིན་རྡེལ་ཉེར་བདུན་བུ་ཡིག་ཏུ་བཀོད་འདུག།",
    "དེ་བཅུ་དཀར་ནག་བགྲངས་ལ་ཁ་དམར་བཅས་བཅུ་གཅིག་ལ་རྭ་བསེ་རྡེལ་རྩ་བཅུ་གཅིག་ཅེས་བུར་འདུག།",
    "གནམ་ལོ་ཟླ་ཞག་དུས་རྟ་སྦྲུལ་ལ་ཤི་བ་བཞི་དང་།",
    "བྱ་སྤྲེལ་གྱི་ལོ་ཟླ་ཞག་དུས་ལ་ཤི་བ་བཞི་བཅས་སོ།",
    "དྭ་ལ་བབ་པ་ལོ་ཟླ་ཞག་དུས་བྱ་སྤྲེལ་ལ་ཤི་བ་བཞི་དང་བཏང་བཅས་དྲུག་གོ།",
    "སྤྱིའི་བཏང་བཅས་རྡེའུ་ཞེ་གསུམ་བརྩི་འདུག།",
    "རྩ་བར་ས་བཅད་དུ་ཞག་དུས་ཀྱང་གཤེད་བཞི་ཐུག་པ་ལ་འགྲམ་དུ་བཤད།",
    "དེ་བཞིན་ཟླ་ཞག་དུས་གསུམ།",
    "བཏང་དང་བརྒྱད་དུ་བྱས་འདུག།",
    "མ་བུར་རྩ་གྲངས་ཅུང་མི་འགྲིགས་འདུག།",
    "ཁྱད་པར་ཟླ་ཞག་དུས་ཀྱི་ལོ་ཡང་གཟའ་དེར་འདོམ་ན་མཚང་ཆེའོ།",
    "དེ་ལས་སྤེན་པ་སུམ་འདོམ་སོགས་བཞི་སྟེ་བཅུ་དྲུག་ཏུ་བཤདདེའི་མ་ཚང་ཆེན་ལ་རྡེལ་བཞི་སྟེ་གནམ་ལོ་ཟླ་ཞག་དུས་དང་འདོམ་མིན་བཞི་བཅས་གོང་བསྡོམས་ཉི་ཤུ་བུར་བཤད།",
    "གཟའ་དང་ཁམས་འདོམ་རྡེལ་ཉི་ནི་ཤུ་ཤིང་སོགས་ཁམས་བཞིའི་ལོ་ཟླ་ཞག་དུས་སོ་སོར་སྦྱར་བས་ཉི་ཤུའོ།",
    "འདི་རྣམས་བྱ་བ་ཁོ་ན་མིན་ཀྱང་བྱ་འགྲམ་ཞེས་བརྩིས་འདུག་གོ།",
    "ལོ་ཟླ་ཞག་དུས་ཀྱི་སྲོག་དང་སྐྱེས་སླར་ཁམས་གཅིག་པ་བཞི་སྟེ་ལྔའོ།",
    "ཤིང་ཆུ་གཅིག་མེ་གཉིས་སོགས་ནང་གསེས་རྡེལ་དགུར་བྱས་འདུག།",
    "དེ་བཞིན་ཟླ་ཞག་དུས་དང་གཅིག་མིན་གསུམ།",
    "གཤིན་པོའི་རུས་སྐྱེས་པའི་ལོ་ཟླ་ཞག་དུས།",
    "ཤི་བའི་ལོ་ཟླ་ཞག་དུས་བཅས་ངོས་བཟུང་བ་དགུའོ།",
    "དེ་བཞིན་ཞག་དུས་ཀྱི་ལྔ་ལྔ་སྟེ་ཉེར་ལྔ་ཡོད་དོ།",
    "འགྲམ་ཕྲན་བཅུ་གསུམ་ནི་ཤི་དུས་འདུག་སྟངས་ངན་པ་བཅུ་གསུམ་སྟེ།",
    "གཞན་ལུགས་ལོ་ཟླ་ཞག་དུས་གང་ལ་ཤི་བའི་གསོན་ལོར་ངན་པ་བཞིམཐུན་གསུམ་ནང་དུར་ལོ་ཁྱི་ཤི་ན་སྟག་རྟ་ལོ་པས་ཤི་སྣ་འདྲེན་པ་ཞེས་དཔེ་འགའ་ན་འདུག་ཀྱང་བུ་ལ་དཔགས་ན་གསོན་གཤིན་དང་མཐུན་གསུམ་ཡོད་པ།",
    "ཉི་མ་བཅུ་གཉིས་དང་རང་ཉི་བདུན་ཟུར་བཞི་གཤེད།",
    "གསལ་བྱེད་ནུབ་མིན་བཅས་དྲུག་དུས་འཁོར་ལུགས་དང་དེ་དྲུག་དབྱངས་འཆར་ལྟར་བརྩིས་པ་དྲུག།",
    "གཉིས་ནག་ཐོག་ཏུ་མ་བཏང་བས་དོམ་ནག་དང་དྲེད་ནག་ཐོག་མ་ལས་ཐུག་པས་དཀར་སོགས་ཞེ་ལྔ་སྤྲོས་འདུག་ཀྱང་།",
    "དེ་ཡང་རང་མ་བུ་གྲོགས་བཅས་ལྔ་འཐབ་དགྲ་སྤར་ཁའི་བདུད་གཅོད་དེ།",
    "གསོན་སྐྱ་མདའ་གང་ལ་ཐུག་པའི་སྤར་ཁ་དེ་ཕྱོགས་མི་བཏང་བས་སྤར་བརྒྱད་གྲངས་བཞིན་རྡེལ་བརྒྱད་བྱས་འདུག།",
    "ཞག་དུས་ཀྱང་གསོན་ལོའི་རང་དང་དགྲ་ལོའི་དུས་ལ་འཛེམ་པ་དང་།",
    "ཞག་དུས་གྱི་རང་དགྲའི་ཕྱོགས་ལ་འཛེམ་པའི་ལུགས་གཉིས་འདུག་ཀྱང་དཔྱད།",
    "སྨེ་བའང་སྦྱར་བས་ལྔ་སྟེ་ཉེར་གསུམ་བརྩིས་འདུག།",
    "དེ་ལ་བདུན་ཟུར་དྲུག་པོ་བརྩིས་པའི་རྡེལ་དྲུག་བྱས་འདུག།",
    "འདི་ལ་ཕན་ཚུན་རྒྱས་སྦྱར་གྱི་སྟག་རོ་ཡོས་ལ་དྲངས་པ་མིན་སོགས་སྦྱར་འདུག།",
    "འདི་གཉིས་ལ་ཟུང་སྦྱར་དྲུག་དྲུག་བཅུ་གཉིས་བྱས་འདུག་སྟེབྱི་ཡོས་སོགས་དང་།",
    "ལོ་ཟླ་ཞག་དུས་ཀྱི་ལོ་རྟ་དེ་དགགཤིན་གྱི་རུས་ཁམས་ཀྱི་དགྲ་ལོ་དུར་ལོ།",
    "དེ་རྣམས་ལོ་ཟླ་ཞག་དུས་སྦྱར་བས་སོ་གཅིག་འདུགཟློས་པས་གཟའ་ཟློས་སྐར་དང་།",
    "སྨེ་བདུན་ཤར་བའི་གདོང་སྟེ་མདུན་ནས་ཕ་གཏད་པ་ངན་པ་གཉིས་ནི་འདིར་མ་རྩིས་གོང་ལ་ཡར་སྦྱར་ནས་བབརྩིས་འདུག།",
    "ཕྱི་མ་བཅུ་དྲུག་པོ་འདི་སྒོ་ལ་ཕུད་མ་ཐག་རོའི་ཁ་ལྟ་ཕྱོགས་ཙམ་ཡིན་འདུག་གོ།",
    "བཅོས་གཞུང་ན་འདུག་ཀྱང་ཚིག་མི་གསལ་བ་ཐོམ་ཐོམ་ཅན་ཞིག་གོ།",
    "ཟླ་ཞག་དུས་གསུམ་རོ་ཁུར་གྱི་རང་ཀེག།",
    "ཟླ་ལོ་ཞག་དུས་ཀྱི་བཅོས་བཅུ་གསུམ་ར་བཅོས་བཞི་སོགས་གཞུང་ལྟར།",
    "རྡོ་གྲངས་ནི་བྲེ་བཞིས་བླང་བའི་རྡོ་དུ་འདུག་བགྲང་བས་གཤིན་པོའི་ལོ་གྲངས་ལས་མང་ན་བཟང་བ་ཡིན་ནམ་ཞེས་དཔེ་འགའ་ལས་བཤད།",
    "གྲ་མའི་མགལ་བ་ཞེས་ཤིང་རྩ་ལོ་མ་ཉམས་པའི་མགལ་དུམ་ཞེས་དཔེ་འགར་འདུག་ཀྱང་ཤིང་གྲ་མ་རང་འདྲ།",
    "ཨོལ་སྟོང་སྟེང་གཉའ་ལྟག་ལ་ངོས་བཟུང་བའང་འདུག།",
    "འདི་ལ་བརྗོད་ལུགས་ཅུང་མི་བདེ་བ་འདུག་འདྲ།",
    "ལྔ་སེར་སྟེང་དུ་སེར་གྲལ་མི་བྱ་བའང་འདུག་སྟེ་རྩི་ལུགས་འདྲ་མིན་བྱས་འདུག།",
    "བུ་སྐྱེས་དུས་ཀྱི་ཟླ་ཞག་དུས་གསུམ་པོའང་ཕན་ཚུན་དགྲ་དང་དུར་དང་བདུན་ཟུར་སོགས་མ་ཐུག་ན་བཟང་ངོ།",
    "སྤར་ཁ་ལ་དང་པོ་རང་རང་ཕྱོགས་ལ་བརྩི་ཞེས་པ་སྤར་ཁ་བརྒྱད་ཕྱོགས་མཚམས་བརྒྱད་དུ་འགོད་ལུགས་སྤྱི་ལྟར་བྱས་ཞེས་པ་ཙམ་ལས་གཞན་མེད།",
    "ཟུང་ཟད་པ་སྟེ་རྒས་པར་ངོས་བཟུང་འདུག་ཀྱང་ལུས་ཀྱི་རྩིས་ངན་པ་དང་།",
    "འདི་ལོ་ཡིན་པས་ཐོག་མཐའ་ན་ལོ་མ་བྲིས་པའི་ཕྱིར་སྨིན་དྲུག་ཉི་མ་དང་ས་ག་སྤེན་པ་ཅན་གྲངས་སུ་འདྲེན་མི་དགོས་པར་བྱས་འདུག།",
    "ལོག་མིན་བྱ་སྤྲེལ་གང་རུང་ལོ་ཟླ་ཞག་དུས་ཀྱང་བྱ་སྤྲེལ་གང་རིགས་ལ་བབ་དུས་འགྲོ་བ་སྟེ་དེ་ཀུན་འདོམས་ན་ངན།",
    "རང་སྐྱེས་པའི་གདན་སའི་བདུད་གཅོད་ནི་མ་ཀླུང་དང་བབ་སླར་ལི་ཁེན་སོགས་བདུད་གཅོད་ཐུག་དུས།",
    "ལོག་མིན་དང་ཟླ་ཞག་དུས་གསུམ་བྱ་སྤྲེལ་ལ་བབ་ན་ཞེས་སོ།",
    "ཞིབ་པར་དབྱངས་འཆར་གྱི་རིགས་གསུམ་དང་དཀར་པོའི་འཁོར་ལོ་སོགས་། ཅི་རིགས་པའང་བརྟག་པར་བྱས་ན་ལེགས་པས་བུར་བཀོད་འདུག།",
    "འདི་འདྲ་ཟླ་འཁོར་ཤོག་ཁྲར་བཀོད་འདུག།",
    "ཞག་དུས་ལའང་དེ་ལྟར་རྩིས་སྣང་ལ།",
    "ཚེས་ལ་གནམ་ཁྱིའི་ལུས་ཀྱི་ཆ་ཤས་བཀོད་པ་སོགས་འདིར་བཀག་འདུག།",
    "དུར་སའང་གཤིན་ཨཱུལོའམ་འདྲི་བྱེད་ལའང་སྦྱར་འདུག།",
    "བཅུ་གསུམ་པ་ལ་དར་གུད་ཟེར་ཀྱང་སྤྱི་འགྲེལ་ལྟར་འཐབ་པ་ལས་དར་གུད་བསྐོར་མི་འདུག།",
    "འབྲི་ཝང་སུམ་ཅུའམ་བརྡ་ཐན་སུམ་ཅུ་འདི་ལ་དཔེ་ཕལ་ན་བརྩི་ཚུལ་མི་འདུག་པས་དེ་ཡི་སྐོར་འགོ་ནི།",
    "བྱེ་བྲག་རྣོ་ཐིག་དུས་རྩིས་སྐོར་ནི་ལོགས་སུ་བྲིས་པ་བཞིན་ཝཱ་། ཤེས་པར་བྱའོ།",
    "མི་རྟག་དུས་ཀྱི་ནུབ་རིར་ཡིབ་པ་ལ།",
    "འགྲམ་པའི་མཛེས་ལྗོངས་ནས་བཀྲ་འདུག།",
    "ཉི་ཟླ་གཟའ་སྐར་རྒྱུ་བའི་ཚུལ་དང་བགྲང་བྱ་ཟླ་ཞག་དུས་ཚོད་སོགས།",
    "གྲོགས་ཀྱིས་ང་རང་རྙིང་བ་ཡིན་ཞེས་སྐད།",
    "བྱམས་ལྡན་ཕ་ལོས་ང་ལ་རྙིང་འདུག་སྐད།",
    "ཕུ་བོས་སྨྱོས་འདུག་ཟེར་བའི་གཏམ་ཞིག་བཞད།",
    "མི་ཆུང་ཁ་བདེ་དེ་ཚོར་ཡིད་རྟོན་ཞིག་མི་འདུག།",
    "མ་འདུག་མྱུར་དུ་ལམ་ལ་ཆས་རོགས།",
    "ཁྱེད་རང་བྲག་གཟར་གཡང་ནས་འབབ་པའི་དྭངས་བསིལ་གྱི་རྦབ་ཆུ་ཡིན།",
    "ང་རངསྤྲང་བོ་བཞིན་འཁྱམས་ཏེ།",
    "ཉ་འཛིན་རྒན་པོ་ལྟ་བུའི་འཆར་སྒོ་ཙམ་མི་འདུག།",
    "ང་འདི་ལྟར་འདུག་མི་འདོད་པས།",
    "གདོད་མའི་མུན་ཁུང་རང་ཉིད་ཀྱི་གནས་ཚང་དུ་བཟུང་ནས་ལོ་མང་འགོར།",
    "དོན་དང་དོན་མ་ཡིན་འགྲོ་ལ་ལམ་བཟང་འདོམས་མཁས་པ།",
    "བལ་བོ་བཅས་ཀྱི་མཁས་པ་དུ་མ་པ་ཆེ་ཙམ་འདོན་ཚུལ་སོགས་ཟོལ་སྦྱོར་གྱི་གཏན་ཚིགས་བོད་ཡིག་གསར་བཟོའི་བྱ་བཞག་ལ་ཞུགས་ཏེ་ཐོན་མི་ལ་མང་དུ་སྨྲས་ཀྱང་ཞེ་འདོད་ཀྱི་སྒྲུབ་བྱ་འགྲུབ་པར་མི་རོགས་བགྱིས་ཚུལ་སོགས་གཏན་ནས་མི་འདུག་པས་ལོ་འགྱུར་ཏེ།",
    "ད་ལྟ་འཛམ་གླིང་ན་མཚན་སྙན་གྱིས་ཁྱབ་བཞིན་པ་ཡིན་ཙ་ན།",
    "ད་དུང་ལས་ཀྱི་འབྲས་བུ་འདིའི་ཐད་ལ་དོགས་པ་དང་སོམ་ཉི་ཟ་བ་མང་འདུག་པས་དེའི་སྐོར་ཅུང་གླེང་ན།",
    "ཁོ་རང་ཚེའི་དུས་བྱས་སོ་ཟེར་བར་ཐེ་ཚོམ་མི་འདུག་ཀྱང་།",
    "འབྲས་བུ་ཐོབ་པ་ཡིན་འདུག་པས།",
    "རང་ལ་ཁེ་ཕན་ཅུང་ཡོད་ན་ཕ་མ་ཡིན་ཡང་གསོད་པར་ཐེ་ཚོམ་མི་འདུག་པ་ལྟར་སྣང་ཡང་།",
    "ཞེས་མིང་བསྒྱུར་འདུག་གོ།",
    "བཟང་ངན་དང་དྭངས་སྙིགས་འབྱེད་པ་འགན་ཁུར་གལ་ཆེན་ཞིག་ཏུ་འདུག་གོ།",
    "ཡུལ་དེར་བྱོན་ཙམ་ཉིད་ནས་ངོ་མཚར་བའི་རྟགས་མཚན་དུ་མ་བྱུང་འདུག་ཅིང་།",
    "རྒྱུན་དུ་བཞུགས་དགོས་ཚུལ་ནན་ཆགས་པ་བྱས་འདུག་ཀྱང་།",
    "ཞེས་ལུང་དྲངས་འདུག་པས་དཔེ་བྱ་ཡུལ་གྱི་ཡིག་རྙིང་ཞིག་ཡོད་ཅེས་བསྟན་ཏོ་ཟེར།",
    "ཤི་ནས་ཀྱང་སྒྲོན་མེ་ཤི་བའམ་བཏུང་ཆུ་སྐམ་པ་ལྟ་བུ་ཞིག་ཡིན་ན་དེ་ལས་གཞན་མི་འདུག་ཀྱང་།",
    "གཞལ་མེད་ཁང་དུ་འཇུག་པའམ་ཁྲི་ལ་འདུག་པར་བྱའོ་སྙམ་དུ་སེམས་ཏེ་འདུ་ཤེས་རྣམ་པ་སྣ་ཚོགས་བསྐྱེད་ནས་ཇི་ལྟར་མཐོང་བ་བཞིན་དུ་མའི་མངལ་དུ་འཇུག་པར་འགྱུར་རོ།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "ཅཤིང་འབྲུག་དང་ཆུ་བྱི་དམག་དུས་སྐོར།",
    "དེ་རྗེས་ལོ་གསུམ་རིང་རང་ལུགས་སྔོན་འགྲོ་གཟེར་ལྔ་དང་།",
    "མ་འོངས་རྒྱ་མིས་ཁྱེད་རང་ལ་སེམས་འཛིན་བརྣག་ལན་རྡུང་རྡེག་ཕོག་རྒྱུའི་གྱོང་གུན་ཉིས་བརྩེགས་ཕོག་རྒྱུ་ཞེས་ཚང་མས་ཕྲན་ལ་འཕྱ་སྨོད་ཀྱང་བྱས་བྱུང་།",
    "སྒྲུབ་ཕུག་བྱིན་ཅན་དང་རང་བྱོན་སོགས་དུ་མ་ཞིག་མཇལ་རྒྱུ་ཡོད་ལ།",
    "མཆོད་ཆས་གསེར་དངུལ་བཀྲ་མ་ཤིན་ཏུ་སྤུས་ལེགས་སྣེ་མང་ཡོད་ཀྱང་རང་བློར་གཅིག་ནས་གཉིས་སུ་ངེས་དཀའི་རང་བཞིན་ཨོ་ཚོད་ཞུ་ཐུབ་དབེན་ཞིང་།",
    "དགོན་ལག་ཁག་དང་བཅས་པའི་འཛིན་དངོས་ཆེ་ཕྲ་མཐའ་དག་ཀྱང་རང་ཁུངས་སོ་སོར་སྤྲོད་དེབ་དམ་འབྱར་ནང་ཞིབ་གསལ་འཁོད་ཅིང་།",
    "དེའི་སྲས་ཞབས་དྲུང་མཐུ་སྟོབས་གྲགས་པ་ཞེས་མཚན་སྙན་ཆེ་ཤོས་ཤིག་བྱུང་འདུག་པ་དེའི་ཡུམ་རྗེ་བཙུན་སྒྲོལ་མའི་རྣམ་སྤྲུལ་ཡིན་པའི་འདྲ་སྐུར་དུང་ཚེམས་འཁྲུངས་པ་དངོས་སུ་མཇལ་རྒྱུ་ཡོད་པ་མ་ཟད།",
    "མགོན་ཁང་ཞིག་བཅས་འདུག་ཕྱག་བཞེས་ཆོག་རྒྱུན་ཐད་ས་སྐྱ་སྟོད་ལུགས་དང་།",
    "ཁྲག་མཚོའི་ཞལ་ཁེབས་ཀྱི་ཇུས་ཇུས་སེར་པོ་དང་སྙན་ཤལ་ནང་མཛོད་དེ་ཚོའི་སྟེང་གསེར་ཐམ་འབྱར་མའི་སྨོན་ཚིག་ཀྱང་བཀོད་པ་གནང་འདུག་སྐབས་དེ་དུས་སྲུང་མ་འདི་བཞིན་འཕྲིན་ལས་ཀྱི་རམ་འདེགས་ཞུ་མི་དམིགས་བསལ་དྲག་རྩལ་ཅན་ཧ་ཅང་དཔའ་བརྗིད་དང་ལྡན་པར་ངེས་པ་རྙེད་པ་བྱུང་གཤིས།",
    "བོད་ཡུལ་ས་བབས་མཐོ་བས་འཁྱགས་ཆེས་ཧ་ཅང་དཀའ་ངལ་ཆེ་འཕྲད་སྐབས་ལམ་སེང་ས་ཆ་ཚུར་ལེན་ཐབས་བྱེད་ཐུབ་ཀྱི་ཡོད་འདུག་ཀྱང་སྐབས་དེ་དུས་མདའ་དཔོན་ལྷ་སྡིངས་སྲས་དགྲ་ལྷ་སྐུ་སྲོག་ཤོར་རྗེས་སྒང་སྟོད་ལྕགས་སྤྲགས་དང་།",
    "མདའ་མདུང་མ་གཏོགས་མེད་ཙང་ཞོགས་པ་མེ་མདའ་བཅུ་ཤོགབསྒྲིགས་ནས་རྒྱག་དུས་བོད་མདའི་སྐད་དེ་སྦོམ་པོ་ཡོད་སྟབས་གསལ་པོར་གོ་ཞིང་།",
    "ལྷག་པར་ཡར་འབྲོག་སྐམ་གསོལ་ཞེས་ཉ་ཤ་དང་ཚགས་ཤ་བཅས་རང་རང་ཡོང་འབབ་ཁྲལ་ཐོབ་ཆེ་ཆུང་ལ་གཞིགས་པས་འདེགས་ཁལ་བརྒྱ་ཕྲག་མང་པོ་བསྡུ་བཞེས་གནང་ལམ་བྱུང་འདུག་ཅིང་།",
    "རྗེ་བཙུན་སྐུ་ཡལ་བ་མི་བདེན་པར་འདུག་སྙམ་གསོལ་བ་བཏབ་པས་གང་ཞུས་ཀྱི་ལན་ཐམས་ཅད་གནང་སའི་ས་གནས་དེ་ཡིན།",
