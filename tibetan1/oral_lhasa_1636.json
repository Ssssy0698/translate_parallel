    "བདག་ལ་ཆགས་པ་མེད་ཀྱང་གཞན་ལ་ཆགས་པ་སྲིད་པར་དོགས་པ་བསུ་བ་ནི།",
    "འདི་ག་ལས་སྙམ་ན་དེ་འམ་གཞན་ལ་ཞེས་གསུངས་སོ།",
    "འདི་ལྟར་བདག་ལ་ཆགས་པ་ནི་ཕུལ་དུ་བྱུང་བའི་བདེ་བ་འདོད་ཀྱང་དེ་མ་ཐོབ་ན་ངན་པ་ཐོབ་པ་ལ་ཡང་མཚུངས་པར་སེམས་སོ།",
    "དེ་བས་ན་བདག་ཏུ་འཛིན་པ་ལ་ནི་བདེ་བ་གཉི་ག་ཁྱད་པར་མེད་དོ།",
    "ཚོགས་པར་དབྱུང་བ་མ་ཡིན་པར་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ཡོད་པར་དོགས་པ་བསུ་བའོ།",
    "ཚོགས་པར་དབྱུང་བ་དང་ཅིག་ཤོས་ཀྱི་ཐ་སྙད་གཉིས་ལས།",
    "ཚོགས་པར་དབྱུང་བ་མ་ཡིན་པས་བདེ་བ་སྒྲུབ་པར་བྱེད་པ་བས་ནི་ཚོགས་པར་དབྱུང་བའི་ཐ་སྙད་ཉིད་བླའོ་ཞེས་དོགས་པ་ནི་འོན་ཏེ་ཞེས་བྱ་བའོ།",
    "དེ་ལྟ་ན་ཡང་ཞེས་བྱ་བ་ནི་ཁྱད་པར་མེད་པ་ཡིན་ན་ཡང་ངོ།",
    "ཉེས་པ་མེད་པ་ཡང་ཉེས་པར་སེམས་པ་ནི་མཉམ་པར་བྱེད་པའི་དོན་ཏོ།",
    "འདིས་ནི་སྲིད་པས་སྐྱོན་རྣམས་སྒྲིབ་པར་བྱེད།",
    "དེས་ན་གསལ་བར་བྱེད་པའམ་སྒྲུབ་པར་བྱེད་པ་ནི་བླང་བར་བྱ་བ་ཉིད་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་དབྱེ་བ་དེ་ལས་བྱུང་བའི་ཉེས་པར་ཡང་འགྱུར་རོ་ཞེས་མཇུག་སྡུད་པའི་སྒོ་ནས་བརྗོད་པ་ནི་དེའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པ་མེད་པའི་ཤེས་པར་རྟོགས་པར་བྱ་བ་གཞན་དག་ཀྱང་ཉམས་སུ་མྱོང་བ་ཇི་ལྟ་བ་བཞིན་སྐད་ཅིག་མ་ཁོ་ནའོ།",
    "ཁོ་བོ་ཅག་ཉིད་ཁ་ཙང་ཡིན་ལ་ཁོ་བོ་ཅག་ཉིད་དི་རིང་ཡང་ཡིན་ནོ་ཞེས་རྣམ་པར་རྟོག་པས་ཞེན་པ་འབའ་ཞིག་ཏུ་ཟད་དེ།",
    "རྣམ་པར་རྟོག་པ་དེ་ལྟར་འཇུག་པ་ནི་བདག་ཏུ་ཞེན་པ་ལས་གཞན་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི་ངེས་པར་བདག་ལ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་བདག་དང་རྣམ་པར་རྟོག་པ་ཉིད་སྤང་བར་བྱ་བ་ཡིན་གྱི་བདག་ནི་མ་ཡིན་ནོ།",
    "ཐ་དད་པར་ཁས་བླངས་ཀྱང་འདོད་པ་ཅུང་ཟད་ཀྱང་གྲུབ་པ་མེད་དོ་ཞེས་བརྗོད་པ་ནི་དེ་ལས་ཅིར་འགྱུར་ཏེ་ཅིར་ཡང་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རིགས་པ་ཉེ་བར་བསྟན་པ་སྔོན་དུ་འགྲོ་བ་ཅན་རྣམ་པར་འགྲེལ་པ་ནི།",
    "ཡོན་ཏན་སྐྱོན་དང་ཞེས་གསུངས་སོ།",
    "ཕྱི་རོལ་གྱི་བུམ་པ་ལ་སོགས་པ་ཕྱི་རོལ་གྱི་རྒྱུ་ལ་རག་ལས་པའི་ཡུལ་རྣམས་ལ་ནི་ཡོན་ཏན་དང་ཉེས་པ་མཐོང་བ་ལས་ཉེ་བར་ལེན་པ་སྤོང་བ་མཐོང་བ་ཉིད་ཡིན་ན་ཚུལ་འདི་ནི་ཞེན་པ་ལ་ཡང་ཡིན་པར་མི་འཐད་དོ།",
    "ཅེས་བྱ་བ་འདིའི་དོན་བསྟན་པ་ཡིན་ནོ་སྙམ་དུ་དགོངས་ནས་བསྡུ་བའི་ཚིགས་སུ་བཅད་པའོ་ཞེས་གསུངས་སོ།",
    "བདག་ནི་བདེ་བ་སྒྲུབ་བྱེད་ཐམས་ཅད་ཤེས་པར་བྱེད་པ་དང་།",
    "དེའི་འབྲས་བུ་སྤྱོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "འོན་ཏེ་བདག་ཀྱང་སྡུག་བསྔལ་གྱི་སྒྲུབ་པར་བྱེད་པ་ཤེས་པར་བྱེད་པ་དང་།",
    "དེའི་འབྲས་བུ་ལོངས་སྤྱོད་པར་བྱེད་པ་ཉིད་ཀྱིས་ཆགས་པ་དང་བྲལ་བའི་ཡུལ་ཉིད་དུ་འདོད་ན།",
    "བསམ་པར་བྱ་བ་དང་།",
    "ཐམས་ཅད་ཀྱི་ཤེས་པར་བྱེད་པ་དང་།",
    "སྤྱོད་པར་བྱེད་པའོ།",
    "བདག་བཞིན་དུ་འདོད་ཆགས་ལ་སོགས་པ་ཡང་ཁྱད་པར་གཞན་དང་ལྡན་པ་ཁོ་ན།",
    "སླར་ལེན་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "དེ་ལ་འདུ་སོགས་ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཕལ་ཆེར་ཡང་མ་ཡིན་ཏེ་དཔེར་ན་དུག་དང་འདྲེས་པའི་ཟས་བཞིན་ནོ་ཞེས་ལེན་འདེབས་པར་བྱེད་པ་ནི།",
    "བླང་བྱ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "ཁྱད་པར་ཅན་དེ་ལྷག་པར་གྱུར་པ་བདེ་བ་གཅིག་པའི་རང་བཞིན་ཡོད་པས་ན།",
    "དུག་དང་བཅས་པའི་ཟས་བཞིན་དུ་རྒྱབ་ཀྱིས་ཕྱོགས་པར་འགྱུར་རོ།",
    "འོན་ཏེ་ཁྱད་པར་ཅན་གྱི་བདེ་བ་མ་རྙེད་པ་ན།",
    "རྣམ་པར་སྤྱོད་པ་གྲུབ་པོ་སྙམ་པར་དོགས་པ་ནི།",
    "སྤྱོད་པར་འགྱུར་རོ་ཞེ་ན་ཞེས་བྱ་བའོ།",
    "སྤྱོད་པ་ཡང་ཁྱད་པར་ཅན་གྱི་བདེ་བ་ལ་སྲེད་པའི་སྐྱེད་བྱེད་ཡིན་ནོ།",
    "དེ་ཡང་དེ་ལ་རྙེད་ན་སྡུག་བསྔལ་སྐྱེད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "འདིས་ནི་བདག་ཏུ་སྨྲ་བ་ལ་རྣམ་པར་བྱང་བ་མི་འཐད་པར་རོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དེ་བསྒོམས་ཀྱང་རྣམ་པར་བྱང་བའི་རྒྱུར་མི་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "བདག་དེ་ཞེས་གསུངས་སོ།",
    "བསྒོམས་པ་དོན་དང་བཅས་པར་དོགས་པ་ནི།",
    "ཉེས་ཅན་ཇི་ལྟར་ཞེས་གསུངས་སོ།",
    "ཉེས་པ་ཅན་དེ་ནི་གཞན་དུ་ཉེས་པ་མེད་པར་འགྱུར་བ་མིན་པ་སྟེ།",
    "རྣལ་འབྱོར་པ་བདག་འདོད་པ་ཞེན་པའི་ཡུལ་དུ་བྱེད་པ་གང་ཡིན་པ་དེ་ཇི་ལྟར་བདག་དེ་འཇིག་པར་འདོད་པར་འགྱུར།",
    "དེ་དང་གཅིག་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ན་བསྒོམས་པས་འདི་བཟློག་པར་མི་ནུས་སོ་ཞེས་གཞན་སེམས་སོ།",
    "དེ་ནི་འདོད་ཆགས་ཅན་ལ་སོགས་པར་མི་སྲིད་དོ།",
    "ཐ་དད་པ་ལ་ཞེས་གསུངས་ཏེ།",
    "ལྡན་པས་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་ཅི་ཞིག་ཡོད།",
    "བྲམ་ཟེའི་ལུགས་ཀྱིས་ཁྱབ་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལ་གནས་པའི་འདོད་ཆགས་ལ་སོགས་པ་དང་ནི་ལྡན་པར་འགྱུར་བའི་འདུ་བའོ།",
    "དེར་གནས་པའི་འདོད་ཆགས་ལ་སོགས་པ་དང་ནི་ལྡན་པར་གྱུར་པའི་འདུ་བ་ཉིད་ལྡན་པར་བརྗོད་པ་ཡིན་ནོ།",
