    "ང་རང་གི་རྣ་ལམ་ནས་ཁྱོད་ཀྱི་འགྲོ་དོན་ཤར་ཕྱོགས།",
    "ཚེས་བཅོ་བརྒྱད་ཉིན་སྔ་མོ་ཞོག་ཇ་གསོལ།",
    "དེའི་ཉི་དྲོས་ཀྱི་ཆ་ལ་གཟིམས་མལ་ནས་བཞེངསསྐུ་གཅེར་བུར་མཛད་དེ་ཞབས་སྐྱིལ་ཀྲུང་ཙཕྱག་གཉིས་པུས་པམོར་བཀབ།",
    "གཞན་དད་ལྡན་གྱི་སྐྱེ་བོ་སྟོང་ཕྲག་གཉིས་ཙམ་བོད་པ་ལ་ན་བཟའ་ཕྲན་བུ་རེ་དད་རྟེན་དུ་ཕྱིན་ཅིང་དགེ་སྒྲུབ་སྡིག་སྤང་སོགྲས་ཁས་ལེན་དམ་བཅའ་རྒྱུ་ཚོབ་བྱུང་།",
    "རྒན་གྱིས་བུད་མེད་སོགས་ཀྱིས་ཚམ་ཚོམ་མེད་པར་བརྒལ་འ་། ཀྱང་ཆུའི་འཇིགས་པ་མ་བྱུང་བ་ནི་ཁོང་གི་ཐུགས་རྗེ་རེད་ཅེས་ཀུན་གྱིས་གླེང་བ་བཞིན་ངེས་པ་ཡིན།",
    "ཡར་འབྲོག་རྡོ་རྗེ་ཕག་མོ།",
    "ཚོ་བློས་བཏང་གི་བྱ་བྲལ་རྣམས་དང་།",
    "དེ་དག་ཟླགི་དྲིན་ལས་མཚུངས་བྲལ་རྗེ་བཙུན་མཆོག་གི་རྣམ་དཀར་ཕྲིན་ལས་ཀྱི་འོད་སྣང་དབྱིག་འཛིན་ཡངས་པའི་རྒྱན་དུ་ད་ལྟས་དཔལ་། ནའང་གནས་བཞིན་པ་སྟེ།",
    "སྤྱན་རས་གཟིགས།",
    "གསང་བའི་བདག་པོ་སོགས་དང་དགོངས་སྤྱོད་དབྱེ་བྱམེད་པའི་ཕྱིར་ལྷའི་ཞལ་གཟིགས་དང་གྲུབ་པའི་ཆོ་འཕྲུལ་མཛད་ཚུལ་སོགས་བདག་ཉིད་ཆེན་པོ་འདི་ལྟ་བུ་ལ་ཡ་མཚན་དུ་རྩི་བའི་འོས་མ་ཡིན་མོད་ཀྱང་།",
    "གདུལ་བྱ་ཐུན་མོང་པ་དག་གི་ངོར་གནས་གང་དུ་འཁྲུངས་པ།",
    "༥ རང་མཐོང་ཕྱོགས་ཞེན་དུག་གིས་མ་བསླད་པས།",
    "དམ་པ་དག་གིས་ཇི་ལྟར་གསུངས་པ་བཞིན།",
    "འདི་ནི་རེ་ཞིག་བསྡུས་པའི་དོན་ཏེ།",
    "ཡན་ལག་གི་དོན་བརྗོད་པར་བྱའོ།",
    "གང་གིས་ཕྱིན་ཅི་ལོག་ཅེས་བྱ་བ་དག་གོ།",
    "ཁ་ཅིག་གིས་རྣམ་པ་གཉིས་སུ་རྟོགས་ཏེ།",
    "གང་གིས་ཐེ་ཚོམ་ཟ་ཞེས་བྱ་བ་དག་གོ།",
    "གང་ཟག་ལ་བདག་མེད་པར་བསྟན་པ་ནི་ཉོན་མོངས་པའི་སྒྲིབ་པ་སྤང་བའི་ཕྱིར་རོ།",
    "ཉོན་མོངས་པ་རྣམས་དང་ཤེས་བྱའི་སྒྲིབ་པ་དག་སྤང་ཞེས་བྱ་བར་ཚིག་རྣམ་པར་སྦྱར་བར་བྱ་སྟེ།",
    "གང་ཟག་ལ་བདག་མེད་པར་བསྟན་པ་ནི་ཉོན་མོངས་པ་སྤང་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་དེ་ཇི་ལྟ་བུ་སྙམ་པ་ལ།",
    "འདི་ལྟར་འདོད་ཆགས་ལ་སོགས་པ་ཉོན་མོངས་པ་རྣམས་ནི་བདག་ཏུ་ལྟ་བ་ལས་བྱུང་ངོ་ཞེས་སྨྲས་སོ།",
    "བདག་དང་བདག་གིར་ལྟ་བ་སྤངས་པ་འདོད་ཆགས་དང་བྲལ་བ།",
    "དེ་བས་ན་གང་ཟག་ལ་བདག་མེད་པར་བསྟན་པ་ནི་ཉོན་མོངས་པ་སྤངས་པའི་ཕྱིར་རོ།",
    "ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་སྤངས་པ་འདིས་ཅི་ཞིག་བྱ་སྙམ་པ་ལ།",
    "ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་སྤངས་པ་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "ཉོན་མོངས་པ་སྤོང་བ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲས་སོ།",
    "ཤེས་བྱ་ཐམས་ཅད་ལ་ཡེ་ཤེས་འཇུག་པའི་བར་དུ་གཅོད་པར་བྱེད་པ་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་མི་ཤེས་པ་གཟུང་བ་དང་།",
    "གང་རེས་འགའ་འཇུག་ལ་རེས་འགའ་མི་འཇུག་པ་དེ་ནི་རྒྱུ་གཞན་ལ་ལྟོས་པའི་ཕྱིར་ཆགས་པ་ཞེས་བྱའོ།",
    "འཛིན་པ་དང་བྲལ་བའི་སེམས་དང་སེམས་ལས་བྱུང་བ་རྣམས་ནི་རྣམ་པར་རིག་པ་ཙམ་མོ།",
    "དེ་ལས་ནི་ཚིག་གི་དོན་འདི་འབྱུང་སྟེ།",
    "འགྲེལ་པ་བྱེད་པས་ཡན་ལག་གི་དོན་དགྲོལ་བའི་ཕྱིར།",
    "གང་གིས་བདག་ཏུ་ཉེ་བར་འདོགས་པ་དེ་ནི་བདག་ཏུ་ཉེ་བར་འདོགས་པའོ།",
    "གྱུར་པའི་རང་གི་ངོ་བོ་བསྟན་པའི་ཕྱིར།",
    "གང་གི་ཚེ་རྒྱུའི་སྐད་ཅིག་འགགས་ལ།",
    "དེ་ལྟར་གྱུར་པའི་རང་གི་ངོ་བོ་བསྟན་ནས།",
    "སུམ་ཅུ་པའི་འགྲེལ་བཤད། ། བདག་ལ་སོགས་པར་རྣམ་པར་རྟོག་པས་བག་ཆགས་གང་སྐྱེད་པ་དེ་དག་གི་ཚེ་ཡོངས་སུ་བརྟས་པར་གྱུར་པ་དེའི་ཚེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལས་བདག་ལ་སོགས་པའི་རྣམ་པའི་རྣམ་པར་རྟོག་པ་སྐྱེའོ།",
    "དེ་བཞིན་དུ་གཟུགས་ལ་སོགས་པར་རྣམ་པར་རྟོག་པས་བག་ཆགས་གང་སྐྱེད་པ་དེ་ཡང་གང་གི་ཚེ་ཡོངས་སུ་བརྟས་པར་གྱུར་པ་དེའི་ཚེ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལས་གཟུགས་ལ་སོགས་པའི་རྣམ་པའི་རྣམ་པར་རྟོག་པ་འབྱུང་ངོ།",
    "ཉེ་བར་འདོགས་པ་ནི་འདི་ལྟར་གཞི་མོད་པར་མི་སྲིད་དོ།",
    "གཞན་དུ་ན་ནི་ངེས་པ་མེད་པས་ཐམས་ཅད་ལ་ཐམས་ཅད་གདགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཐལ་ཆེས་བྱ་བའི་སྐྱོན་དུ་གྱུར་ཏ་རེ་ཞེས་ཀུན་རྫོབ་ཏུ་གཞི་ཅི་ཞིག་ཅིག་ཁས་བླང་བར་བྱའོ།",
    "དེ་ལྟར་མཐའ་གཅིག་ཏུ་སྨྲ་བ་དེ་བཀག་ནས་རང་གི་ཕྱོགས་བརྗོད་པའི་ཕྱིར།",
    "གང་གི་ཕྱིར་འདི་ལྟར་ཤེས་བྱ་ནི་རྣམ་པར་ཤེས་པའི་རང་གི་ངོ་བོ་ཁོ་ན་ཡིན་པས།",
    "འདི་ལྟར་ཕྱི་རོལ་གྱི་དོན་གང་གི་ཚེ་བདག་གི་རྣམ་པའི་རྣམ་པར་ཤེས་པ་སྐྱེད་པ་དེའི་ཚེ་རྣམ་པར་ཤེས་པའི་དམིགས་པའི་རྐྱེན་དུ་འདོད་ཀྱི།",
    "འདི་ལྟར་ཆ་ཤས་རེ་རེ་ནས་བསལ་ན་བསགས་པའི་རྣམ་པའི་རྣམ་པའི་རྣམ་པར་ཤེས་པ་མི་འབྱུང་ངོ།",
    "དེའི་ཚེ་ཆ་ཤས་རེ་རེ་ནས་བསལ་ན་ཡང་འདུས་པའི་རྣམ་པའི་བློ་སྐྱེ་བ་ཞིག་ན།",
    "གང་གི་ཕྱིར་དེ་ལྟ་བསགས་པ་ནི་ཆ་ཤས་འདུས་པ་ཙམ་ལས་གུད་ན་ཡོད་པ་མ་ཡིན་པར་ཡང་བསགས་པའི་རྣམ་པའི་རྣམ་པར་ཤེས་པ་འདི་མྱོང་སྟེ།",
    "དེའི་ཕྱིར་དེའི་ལུགས་བསྟན་པར་གཞན་དག་རྡུལ་ཕྲ་རབ་རེ་རེ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨྲས་ཏེ།",
    "དེ་དག་གི་ཡང་སུམ་ཅུ་པའི་འགྲེལ་བཤད།",
    "དེ་སྐད་སྨྲ་བ་དེ་དག་གི་གཞུང་ལྟར་ན་ཡང་རྡུལ་ཕྲ་རབ་ཉམས་སུ་འོང་ཞེས་རྡུལ་ཕྲ་རབ་རྣམས་ལྟོས་པ་དང་བཅས་པ་དང་མི་ལྟོས་པའི་དུས་ན་ཡང་རགས་པའི་མཚན་ཉིད་དུ་འགྱུར་བར་རང་བཞིན་བྱེ་བྲག་ཏུ་གྱུར་པ་མེད་དོ།",
    "ཕྲ་མོའི་རྣམ་པ་ནི་རགས་པའི་རྣམ་པ་ཤེས་པའི་ཡུལ་དུ་མི་རུང་སྟེ་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་རེ་ཞིག་རྡུལ་ཕྲ་རབ་དག་ཡོད་པས་ཁས་བླངས་ཏེ།",
    "རྡུལ་ཕྲ་རབ་ཀྱང་ཚུ་རོལ་དང་ཕ་རོལ་དང་དཔུང་གི་ཆ་ཡོད་པས་ཀ་བ་ལ་སོགས་པ་བཞིན་དུ་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་རྡུལ་ཕྲ་རབ་རྣམས་ཀྱི་ཚུ་རོལ་དང་ཕ་རོལ་དང་དཔུང་གི་ཆ་ཁས་མི་ལེན་ན་ནི།",
    "དེ་ལྟར་ན་རེ་ཞིག་རྣམ་པར་ཤེས་པའི་ཚོགས་ལྔ་པོ་རྣམས་ཀྱི་ཡུལ་བཀག་གོ།",
    "དེ་ལ་རེ་ཞིག་གང་དག་འདས་པ་དང་མ་འོངས་པ་དེ་དག་ནི་རང་གི་རྣམ་པའི་རྣམ་པར་ཤེས་པ་སྐྱེད་པ་མ་ཡིན་ཏེ།",
    "ད་ལྟར་གྱི་ཚོར་བ་ལ་སོགས་པ་དག་ཀྱང་རང་གི་རྣམ་པའི་རྣམ་པར་ཤེས་པ་མི་སྐྱེད་དོ།",
    "གང་གི་ཚོར་བ་ལ་སོགས་སྐྱེས་པའི་ཚེ་ན་ནི་རྣམ་པར་ཤེས་པ་ཡང་དེའི་རྣམ་པར་སྐྱེས་པ་ཉིད་དོ།"
  ]
}