    "བདེ་བ་ཐམས་ཅད་བདག་གིས་བསྒྲུབ་སྙམ་པས་ཕ་རོལ་གྱི་སྡུག་བསྔལ་ཐམས་ཅད་བདག་རྒྱུད་ཀྱི་སྟེང་དུ་བླངས་པར་བསམ།",
    "དེའི་ཆེད་དུ་བསྐྱེད་རྫོགས་ཟུང་འཇུག་གི་རྣལ་འབྱོར་བསྒོམ།",
    "བདག་གི་བདེ་དགེ་མ་ལུས་དེར་སྨིན་ཤོག།",
    "ཨོཾ་སུ་བྷ་བ་ཤུདྡྷསརྦ་དྷརྨཱཝསྭ་བྷཱ་ཤུདྡྷོཉ་ཧཾ་གིས་སྟོང་པའི་ངང་ལས།",
    "ཞབས་གཡས་བརྐྱང་བས་དུས་མཚན་དམར་མོའི་ནུ་མའི་སྟེང་དང་།",
    "གཡོན་དུ་ཚེས་གཅིག་གི་ཟླ་བས་བརྒྱན་པ་གཉིས་མཚོག་མའི་སྟེང་དུ་སྣ་ཚོགས་རྡོ་རྗེས་མཚན་པ།",
    "རུས་པའི་རྒྱན་དྲུག་གིས་བརྒྱན་པ།",
    "སྟག་གི་ལྤགས་པའི་ཤམ་ཐབས་གྲོལ་བ།",
    "གཡོན་ཐོད་པ་ཁྲག་གིས་གང་བ་ཐོགས་པས་ཡབ་ལ་འཁྱུད་པ།",
    "གཅེར་མོ་སྤྱན་གསུམ་སྐུ་གྲོལ་བ་ཐོད་པ་སྐམ་པོ་ལྔའི་དབུ་རྒྱན་དང་།",
    "ཕྱག་རྒྱ་ལྔས་བརྒྱན་པ་བྱིན་པ་གཉིས་ཀྱིས་ཡབ་ལ་འཁྲིལ་བ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན་དུ་བསམ།",
    "བཟའ་བཏུང་ཨོཾ་ཨཱ་ཧཱུྃ་གིས་བདུད་རྩིར་བྱིན་གྱིས་བརླབས་བསྟེན།",
    "རང་གི་སྤྱི་བོའི་གཙུག་ཏུ་སེང་གེའི་ཁྲི་དང་པད་ཟླའི་སྟེང་དུ།",
    "ཞབས་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "བདེ་སྐྱིད་ཐམས་ཅད་ཀྱི་རྩ་བ་ཡིན་ངེས་སྙམ་པའི་མོས་པ་དྲག་པོས།",
    "ངག་གིས་བསྟོད་པ་བརྗོད།",
    "ཉོན་མོངས་གདོད་ནས་སྟོང་པ་མ་ཡིན་གྱི།",
    "དེ་དག་གི་གཉེན་པོར་འཛིན་པའི་འཁྲི་བ་བཅད་པ་གལ་ཆེ།",
    "ཡེ་ཤེས་ལས་ཡེ་ཤེས་སུ་རང་ངོ་རང་གིས་ཤེས་པ་གཟུགས་སྒྲའི་རྐྱེན་གྱིས་ཡེ་ཤེས་རང་སད་པ་བྱ་བ་ཡིན་ནོ།",
    "དེ་དག་གི་ཚེ་སེམས་རྩེ་གཅིག་པའི་ཆ་གང་ཡིན་པ་ནི་ཞི་གནས་ཡིན་ལ།",
    "དད་མོས་སྒོ་ནས་སྟོན་པར་བརྟག།",
    "ཆེ་བའི་ཡོན་ཏན་ཟས་དག་གིས།",
    "འཇིག་རྟེན་གྱི་ཁམས་མཐའ་ཡས་ཤིང་མུ་མེད་པ་ཐམས་ཅད་ན་ཐ་མ་དང་འབྲིང་དང་མཆོག་གི་དབྱེ་བས་ཕྱེ་བའི་བུད་མེད་ཇི་སྙེད་ཡོད་པར་གྲགས་པ་ཀུན།",
    "རེག་པར་བྱར་མེད་པས་ནམ་མཁའ་ལྟ་བུ་སྟེ།",
    "ཨོ་ལ་སོགས་པའི་ཡི་གེ་གསུམ་མོ།",
    "དོན་འདི་ཉིད་བཅོམ་ལྡན་འདས་ཀྱི་གསུང་གིས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "རྡོ་རྗེ་མི་ཕྱེད་པ་གསུམ་མོ།",
    "རྡོ་རྗེ་ཀུན་གྱི་སྤྱན་ལ་སོགས་པ་ལྷ་མོ་བཞི་ཡིན་ལ།",
    "དེ་རྣམས་ལྷག་པར་མོས་པས་ཇི་ལྟ་བ་བཞིན་དུ་སྤྲོ་བ་ནི་འཕྲོ་བ་སྟེ།",
    "དེ་སྐྱེད་ཅིང་འཛིན་པར་བྱེད་པས་ན་རྡོ་རྗེ་སྤྲིན་ནི་འཕྲོ་སྐྱེད་པ་སྟེ་ཡི་གེ་ཧཱུཾ་མོ།",
    "སྐུ་གསུང་ཐུགས་ནི་ཡི་གེ་གསུམ་མོ།",
    "དམ་ཚིག་དག་གིས་རྫོགས་པར་འགྱུར།",
    "གང་གིས་ཤེ་ན།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་ནི་ཡི་གེ་གསུམ་མོ།",
    "དེའི་དམ་ཚིག་ནི་དེ་ལས་བྱུང་བ་ཉི་མའི་དཀྱིལ་འཁོར་ལ་སོགས་པ་རྣམ་པ་གསུམ་མོ།",
    "དེ་ལ་དེའི་དེ་ཁོ་ན་ཉིད་ནི་པདྨའི་སྟེང་གི་ཡི་གེ་གསུམ་མོ།",
    "གཞལ་ཡས་ཁང་གི་ནང་དུ་ལྷ་སུམ་ཅུ་རྩ་གཉིས་རྣམ་པར་དགོད་པའི་མཐར་ཐུག་པར་ལྷག་པར་མོས་པས་སྙོམས་པར་ཞུགས་ཏེ།",
    "རང་གི་སྔགས་ཀྱི་དམ་ཚིག་བསྐྱེད།",
    "དེ་སྒྲུབ་པ་པོ་གང་གི་ཡིན་པ་དེའི་ལུས་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ཡོངས་སུ་གྱུར་པ་ལས་རང་གི་སྔགས་ཀྱིས་སྐྱེས་བུ་འོད་དཔག་ཏུ་མེད་པ་བསྐྱེད་ལ།",
    "ངག་གི་ལམ་ཡེ་ཤེས་སེམས་དཔའ་ལ།",
    "ཚིག་གི་དམ་ཚིག་ལྔ་ཡི་མཆོག།",
    "ཚིག་གི་དམ་ཚིག་ནི་ཏིང་ངེ་འཛིན་གྱི་སེམས་དཔའ་སྟེ།",
    "རང་གི་སྔགས་ཀྱིས་སྐྱེས་བུ་དམ་ཚིག་ེསེམས་དཔའ་བསྐྱེད་ནས།",
    "སྐུ་དང་གསུང་དང་ཐུགས་ནི་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་གསུམ་མོ།",
    "དམ་ཚིག་གི་དོན་ཡོད་པར་གྲུབ་པའོ་། རྡོ་རྗེ་ནི་རིན་ཆེན་འབྱུང་ལྡན་ཏེ་འདི་རྣམས་ཀྱི་ཏིང་ངེ་འཛིན་ནི་ཐ་མི་དད་པར་ཉེ་བར་བཏགས་པས་ན།",
    "དེའི་དཀྱིལ་འཁོར་ནི་ཚོགས་ཏེ་འཇིག་རྟེན་གསུམ་མོ།",
    "སྐལ་བ་ིགསུམ་དུ་ཡེ་ཤེས་གསུམ་མོ།",
    "བཅོམ་ལྡན་འདས་ནམ་མཁའ་རྡོ་རྗེའི་དམ་ཚིག་གིས་དེ་སྐད་ཅེས་བཀའ་སྩལ་ཏོ་ཞེས་བྱ་བ་ལ།",
    "རང་སྔགས་སྐྱེས་བུ་ནི་འདིར་ཡོངས་སུ་དག་པའི་ཕྱག་རྒྱ་ཆེན་པོའི་གཟུགས་སུ་བསམ་ཞིང་བསྒོམ་མོ།",
    "དང་པོ་མིག་གི་སྦུབས་སྟོང་པར་བྱས་པས་ཁོང་སྟོང་དུ་བྱ་བ་ཐོབ་པ་གང་ཡིན་པ་དེ་ནི་ནམ་མཁའ་སྟེ།",
    "བ་ཉི་མ་དང་ཟླ་བའི་འོད་ཟེར་རྣམས་ཀྱིས་འབར་བར་གྱུར་པ་གང་གིས་འཕེན་ཅིང་བཅུག་པ་དེ་ནི་མཚོན་ཆའི་མཆོག་སྟེ།",
    "དེ་ནི་རྡོ་རྗེའི་ལུས་ངག་གིས་ཏེ།",
    "དེ་ནི་ནམ་མཁའ་རྡོ་རྗེའི་དམ་ཚིག་གི་བཀོད་པའི་གནས་ཞེས་བྱ་བ་ལ།",
    "རྡོ་རྗེ་གསུམ་ནི་རོ་རྣམ་པ་གསུམ་མོ།",
    "རྡོ་རྗེ་གསུམ་ནི་རེག་རྣམ་པ་གསུམ་སྟེ།",
    "དེའི་མིག་གི་གནས་སུ་རྡོ་རྗེ་རྣམ་པར་སྣང་མཛད་རབ་ཏུ་བསྒོམས་ལ།",
    "དེ་མིག་གི་སྦུབས་སུ་བསྒོམས་ལ་དེ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "ཟུངས་ཞེས་པ་དེ་དག་གིས་བསླབ་པ་གསུམ།",
    "ཚིག་གི་སྦྱོར་བ་ཤིན་ཏུ་མཛེས་ཤིང་སྙན་འཇེབས་ཀྱིས་ཚིག་དོན་སྔ་ཕྱིའི་མཚམས་སྦྱོར་དང་།",
    "ལུས་སེམས་ཤིན་སྦྱངས་བདེ་བསབབ་བདུན་ཤེས་རབ་ཟབ་མོའི་གཟུངས་ཐོབ་བཞིན།",
