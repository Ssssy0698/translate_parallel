    "སྤྲུལ་པ་ཚོན་གྱི་རི་མོ་མ་འདྲེས་པས།",
    "ཆུང་ངུའི་དུས་ནས་ཐུགས་རྗེ་ཆེན་པོའི་ཞལ་གཟིགས་ཤིང་ཡང་ཡང་བྱིན་གྱིས་བརླབས་པས།",
    "བདེ་མཆོག་འཁོར་ལོའི་ཞལ་གཟིགས་དཀྱིལ་འཁོར་ཐམས་ཅད་དངོས་སུ་སྤྲུལ་ནུས་པས།",
    "དེར་གནས་ལ་མཇལ་བའི་ཟོལ་གྱིས་ཡེར་བར་ཕྱིན་པས་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་སྤྲུལ་པའི་བུ་མོ་དེ་དང་འཕྲད།",
    "དེར་དགུང་ལོ་ང་དྲུག་གི་བར་དུ་སྦས་པའི་ཚུལ་གྱིས་འགྲོ་དོན་མཛད།",
    "ལྷ་སྤྱན་རས་གཟིགས་དང་སྒྲོལ་མ་བདེ་མཆོག་གཤིན་རྗེའི་གཤེད་རྣམས་ཡང་ཡང་ཞལ་གཟིགས།",
    "དེའང་ཆེར་སྐྱེས་པ་ནས་ཐུགས་ཀ་ན་ཧྲཱི་དང་ཧཱུཾ་གསལ་བ་ཕྱག་ཞབས་ལ་འཁོར་ལོའི་རི་མོ་གསལ་བ་ཡོད་དོ།",
    "ཞྭདམར་པ་ལ་ཡབ་ཀྱིས་མོས་ཀྱང་།",
    "ཨུ་ཙཱརྱ་བརྩོན་པས་གསང་བདག་གི་ཞལ་གཟིགས་ནུས་པ་བརྙེས།",
    "མྱུར་བར་དབུས་གཙང་ཕྱོགས་སུ་སོང་ནས་ཀྱང་།",
    "སྲས་ཀྱིས་འོ་ཅག་གི་ཡུལ་དུ་གང་དཀོན་ཉོ་བར་བགྱིད་གསུངས་ནས།",
    "དེར་རང་གི་ཟླ་བོ་མང་པོ་རྣམས་གཙང་དུ་འགྲོ་བར་འདུག་པས་རང་ཉིད་ཀྱི་ཆས་རྣམས་ཁུར་བདེ་བར་བྱས་ནས་ལྷན་དུ་ལྷ་སར་ཕྱག་བསྐོར་མཛད་ནས་རང་བྱོན་ལྔ་ལྡན་གྱི་དྲུང་དུ་གསེར་སྲང་གི་མཎྜལ་ཕུལ་ནས་གསོལ་བ་བཏབ་པས།",
    "ཐུགས་རྗེ་ཆེན་པོས་རེ་ཞིག་བྱང་གི་ཕྱོགས་སུ་སོང་།",
    "མི་རིང་བར་གཙང་དུ་སོང་ན་དོན་འགྲུབ་གསུངས་པས་བྲོས་སྟབས་སུ་འཕན་ཡུལ་དུ་བྱོན།",
    "དེ་བར་དུ་རང་གི་ཟླ་བོ་རྣམས་ཀྱིས་མ་རྙེད་པར་ཕྱིར་ལོག་པ་ཤེས་ནས་ཚུར་བྱོན།",
    "ཁྱོད་ཀྱིས་སྐྱེ་བའི་སྒྱུ་འཕྲུལ་མང་པོ་རྟེན་ཏུ་གྱུར་པའི་རང་ཡུལ་ཕྱོགས་ནས་བསྟན་པའི་རྒྱལ་མཚན་འཛིན་ནུས་པ་འདྲ།",
    "གཟིགས་རྟོག་མཛད་པས་ཤིན་ཏུ་གོ་བ་ཆགས་པ་བྱུང་།",
    "དེ་ལྟར་རང་ཡུལ་ནས་འདི་བར་ལོ་བཞི་ཙམ་སོང་བར་མཛད།",
    "ལྕེ་ནག་པ་རང་ལ་སྔར་གྱི་དེ་རྣམས་ཀྱི་སྟེང་དུ་བདེ་མཆོག་གི་རིམ་ལྔ་ལ་ལྷག་པར་འཁྲིད་མཛད་ནས་སྒོམས་ཤིག་གསུངས།",
    "ཨ་ཙརྱ་བདེ་མཆོག་རྣམས་ཡང་ཡང་ཞལ་གཟིགས།",
    "ཀུན་གྱིས་ཐོས་པར་ནམ་མཁའ་ནས་མི་རྐང་གི་སྒྲ་ཡུན་རིང་བྱུང་ངོ།",
    "སྐབས་ཤིག་ང་ནི་དབེན་པར་སོང་སྟེ་བསྒྲུབ་པ་བྱས་ན་ལེགས་སམ་སྙམ་པ་ཐུགས་ལ་ཤར་བ་ན།",
    "ཐུབ་པ་སྤྱན་རས་གཟིགས་སྒྲོལ་མ་འཇམ་དབྱངས་རྣམས་ཞལ་གཟིགས།",
    "དེ་ཉིན་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་རྗེ་བཙུན་རང་གིས་གནང་བའི་ཆིག་བརྒྱུད་ཅིག་དང་ཐུགས་རྗེ་ཆེན་པོ་ལྷ་ལྔའི་རྗེས་གནང་ཞིག་མ་ཞུས་པར་བསྩལ།",
    "དགུང་ལོ་སོ་དྲུག་པ་ས་བྱིར་སྤྱི་ལོ་༡༤༨ཡེར་བའི་བྲག་ལ་མཇལ་བས་ཐུགས་རྗེ་ཆེན་པོ་སྐུ་ཤེས་པ་དང་མི་ཤེས་པ་མང་པོས་ནམ་མཁའི་ཁམས་ཐམས་ཅད་གང་བ་གཟིགས།",
    "འདི་སྐབས་ནས་རང་ཡུལ་རྒྱལ་མོ་རོང་ནས་རྗེ་བདག་ཉིད་ཆེན་པོའི་སྙན་པ་གསན་ནས་དབུས་ཕྱོགས་སུ་རབ་ཏུ་བྱུང་བའང་སུམ་ཅུ་ལྷག་ཙམ་བྱུང་བས།",
    "རང་ཡུལ་རྒྱལ་མོ་རོང་གི་ཆ།",
    "ནགས་སྤང་འབྲོང་གི་རྭ་ཅོའི་དབྱིབས།",
    "གངས་ཀྱི་རྩེ་ལ་བྲག་གི་མཐའ།",
    "གླང་ཆེན་ས་སྲུངས་གདོང་གི་དབུས།",
    "དེ་ནི་ཁྱོད་ཀྱི་འདུལ་ཞིང་སྟེ།",
    "འབྲོག་རི་བོ་ཆེ་བཞེངས་པའི་ལྷ་ཁང་གི་ལག་གི་བླའི་དོ་དམ་མཛད།",
    "ལུང་བསྟན་ཞལ་གཟིགས་སོགས་ཀྱང་མཐའ་ཡས་པ་བྱུང་།",
    "ཁྱད་པར་རྗེ་རང་གིས་གནང་བའི་འཇམ་དབྱངས་ཞག་བདུན་བསྒྲུབས་པས།",
    "ཁྱོད་ཀྱི་ཡི་དམ་གསང་བདེ་འཇིགས་གསུམ་དང་ཁྱད་པར་རྡོ་རྗེ་འཇིགས་བྱེད་ལ་གྱིས།",
    "ན་མོ་མཉྫུ་ན་ཐ་ཡེ།",
    "བུ་ཁྱོད་འདི་ནས་ཤར་ཕྱོགས་རྒྱལ་མོ་རོང་།",
    "རྒྱ་བོད་ས་མཚམས་བྱིན་ཅན་འཚོལ་དུ་སོང་།",
    "སྨོན་པ་བྲག་གི་མཐའ་བརྟེན་བཟང་པོ་ནས།",
    "གསེར་ཉ་དུང་དང་བཀྲ་ཤིས་རི་མོས་མཚན།",
    "ཤིང་གི་རྩ་བར་ནག་པོ་རྟེན་གྱིས་ཤིག།",
    "མགོན་པོ་ར་དང་ལྷ་མོ་དུང་སོལ་མ།",
    "བ་མ་ཁྱོད་ལ་ལུས་གྲིབ་བཞིན་དུ་འོང་།",
    "དེ་བས་དཀའ་བ་དང་དུ་ལོང་ལ་སོང་།",
    "ཁྱོད་ཀྱི་བསྟན་པ་རིམ་གྱིས་དར་འགྱུར་ཞིང་།",
    "སླར་ཡང་གུར་དང་ལྷ་མོ་གདུང་བཞི་རྣམས་ཀྱི་རྗེས་གནང་བཀའ་གཏད་སོགས་དྲག་ཏུ་མཛད་པས་ནག་པོ་ཆེན་པོ་གུར་ཞལ་ལྷ་མོ་རྣམས་དངོས་སུ་བྱོན།",
    "དགྱེས་པའི་གསུང་གིས།",
    "ཐུགས་རྗེ་ཆེན་པོ་རྒྱལ་བ་སྲས་དང་བཅས་པས་བསྐོར་བ་ནམ་མཁའི་ཁམས་གང་བ་གཟིགས་དབྱངས་གཅིག་ཏུ།",
    "རྒྱལ་ཚབ་མཁས་གྲུབ་འདུལ་འཛིན་སོགས་ལའང་དེ་མཚུངས་འབུལ་བ་ཅུང་ཟད་རེ་མཛད་ཅིང་།",
    "ཡུལ་བདག་རྣམས་ལ་གཏོར་མ་གནང་ཞིང་ཏིང་ངེ་འཛིན་མཛད་པས་དེ་བ་ཐོ་རངས་ཙམ་ནས་ཡུལ་སྐྱོང་བཞི་བོ་རང་རང་གི་འཁོར་དང་བཅས་ཏེ་བྱོན།",
    "རེ་ཞིག་དེ་རྣམས་ནི་བླངས་པས་སྟོན་མོ་ཅུང་ཟད་དང་།",
    "མཚན་མོ་ལས་ལྷག་པར་འགྲུབ་ཅིང་ཉིན་མོ་མི་རྣམས་ཀྱང་ལས་ལ་ངལ་བ་མེད་ཅིང་ཡིད་མཐུན་པ་སོགས་ཡ་མཚན་རྒྱུན་མི་འཆད་པར་བྱུང་།",
    "དེ་སྐབས་ཀྱང་རེས་འབྲུག་དང་སེ་ར་ཆོལ།",
    "རེས་འཇའ་ཚོན་རྣམ་པར་འཁྲིགས་པ་སོགས་བྱུང་ངོ།",
    "འབྲུག་གློག་གིས་ནམ་མཁའ་ནས་ཚམ་རྔམ་དང་བཅས་ནམ་མཁའ་ནས་སྒྲ་མི་སྙན་པ་དཔག་ཏུ་མེད་པ་སྒྲོག་ཅིང་།",
    "ནམ་ལྕགས་བདུན་ཤིང་སྡོང་གི་ཕྱོགས་བཞིར་ལྷུང་ཞིང་ལས་བྱེད་ལྷ་བཟོར་བཅས་ཅི་བྱ་གཏོལ་མེད་དུ་གྱུར་ཏོ།",
    "མཐའ་འཁོབ་སྐྱོང་བའི་སློབ་དཔོན་ཁྱོད།",
    "རྟག་པར་འགྲོགས་པའི་སློབ་དཔོན་ཁྱོད།",
    "ཅེས་གསུངས་པའི་མོད་ལ་གུར་མགོན་གྱི་སྐུ་མི་ཚད་ལས་ལྷག་པ་ཆེ་བ་ཙམ་དུ་སོང་ནས་རྟེན་འདམ་རྣམས་ལ་སོ་སོར་དངོས་སུ་ཐིམ་པས་ཀུན་གྱི་མཐོང་སྣང་ལ་རྒན་པོ་ཆེ་ཆུང་གཉིས་ནང་དུ་ཆངས་ཀྱི་སོང་བར་མཐོང་བ་དང་མཉམ་དུ་ས་ཆེན་པོ་གཡོས་པར་གྱུར་ཏོ།",
    "དེ་སྐབས་ཀྱང་རེས་འགའ་མེ་ཏོག་གི་ཆར་དང་འཇའ་ཚོན་རེས་འགའ་ཆར་དྲག་དང་འབྲུག་ཆོལ་སོགས་ཡེ་ཤེས་སེམས་དཔས་དངོས་སུ་བྱིན་གྱིས་བརླབས་པའི་རྟགས་ཡ་མཚན་བྱུང་བ།",
    "ཡུལ་དེའི་མི་དང་རང་ཉིད་ཀྱི་སློབ་བུ་ཁ་ཤས་ཀྱིས་ཀྱང་གཙུག་ལག་ཁང་རེ་རེ་བརྩིགས་པ་སོགས་མཛད།",
    "ཐུགས་རྗེ་ཆེན་པོའི་སྤྲུལ་པ་སྦས་ཚུལ་རེ་དང་།",
    "གྲུབ་ཐོབ་ལྦ་བའི་སྤྲུལ་པ་རེའང་འོང་གསུང་པར་འདུག་གསུངས།",
    "ཡང་དེ་སྐབས་ཡུལ་དེའི་བུད་མེད་གཅིག་གིས་དུང་རྡོག་བཅུ་གསུམ་དང་མགྲོན་བུ་འགའ་རེ་ཕུལ་བས།",
    "དེ་སྐབས་ཐུགས་རྗེ་ཆེན་པོའི་སྒྲུབ་པ་མཛད་པས་སྤྱན་རས་གཟིགས་ལ་གཤིན་རྗེའི་གཤེད་དང་།",
    "གུར་ཞལ་བེར་ལྷ་མོ་སོགས་ཀྱིས་བསྐོར་བ་ཞལ་གཟིགས།",
    "དེ་ནས་སླར་ཡང་རང་གི་བསྟི་གནས་སུ་ཕེབས་ནས་གཤིན་རྗེའི་གཤེད་ཀྱི་བསྒྲུབ་པ་ལོ་གཅིག་གི་བར་དུ་མཛད་ནས།",
    "དེ་ནས་སྨད་རྒྱལ་མོ་རོང་ནས་བཙན་ལྷ་རྒྱལ་པོས་གདན་དྲངས།",
    "གུས་སློབ་ཚོགས་གཉིས་ཤུགས་ལྡན་ཁྱོད།",
    "ང་ལ་སྐྱེ་འཆི་མེད་མོད་ཀྱང་།",
    "རང་གི་བྲན་གཡོག་རང་ཉིད་དེ།",
    "རིང་བསྲེལ་སྣ་ཚོགས་ཁྱོར་བ་གང་ཙམ་དང་བཅས་བྱོན་པས་ཐམས་ཅད་ཀྱང་གདུང་བུམ་ནང་དུ་བཞུགས་སོ།",
    "གང་ཐུགས་ཡེ་ཤེས་རྒྱ་མཚོའི་ཁྱོན་ཡངས་ལས།",
    "རབ་འཁྲུངས་མཐུ་སྟོབས་མཐའ་ཡས་ནོར་འཛིན་ཁྱོན།",
    "དེ་ནས་དགུང་ལོ་གསུམ་པ་ལ་ཐུགས་རྗེ་ཆེན་པོའི་ཞལ་གཟིགས།",
    "གུར་ཞལ་བེར་ལྷ་མོ་སོགས་ཀྱིས་བྱིན་གྱིས་བརླབས་ཤིང་འབྲལ་མེད་དུ་བསྐྱངས།",
    "དགུང་ལོ་བཅུ་གསུམ་པ་ལ་ཕྱག་ན་རྡོ་རྗེའི་ཞལ་གཟིགས་སོ།",
    "ནུབ་མོ་འཇིགས་བྱེད།",
    "མ་ཧཱ་མ་ཡ་སྟེ་ཐུགས་དམ་ལྷ་བཅུའི་བསྙེན་བསྒྲུབ་རིམ་གཉིས་ལ་བརྩོན་པས་དེ་ཐམས་ཅད་ཀྱི་ཞལ་གཟིགས་བྱིན་གྱིས་བརླབས་པའི་ཏིང་ངེ་འཛིན་ནུས་པ་དཔག་མེད་བརྙེས།",
    "ཀུན་དགའ་རིན་ཆེན་གྱི་དྲུང་དུ་བསྟན་བསྲུངས་ཡོངས་ཀྱི་གདམས་ངག་ཐམས་ཅད་བུམ་པ་གང་བྱོར་གསན་ནས་ཁའུ་སྐྱེད་ལྷས་ཀྱི་བྲག་ཕུག་ཏུ་ལོ་གསུམ་རྩེ་གཅིག་ཏུ་བསྒྲུབ་པ་མཛད་ནས་གུར་ཞལ་ཕྱག་དྲུག་པ་བེར་ལྷ་མོ།",
    "དམག་ཟོར་ཚེ་རིང་མཆེད་ལྔས་བསྐོར་བ་དང་ལས་གཤིན་རྣམ་ཐོས་སྲས་ཀྱི་སྣང་བརྙན་མང་པོ་དང་བཅས་ཐམས་ཅད་ཀྱི་ཞལ་ཡང་ཡང་གཟིགས།",
    "ཡུམ་རྡོ་རྗེ་ཕག་མོ་གྲོགས་སུ་ཆེ།",
    "ཡུལ་འགལ་འདུའི་ལྟད་མོ་ཡ་མཚན་མཐོང་།",
    "ཕེབས་ནས་བསྟན་པ་རྒྱས་པའི་སྐབས་སུ་ཡང་དཔུང་གིས་འཇོམས་པར་ཆས་ནས་བྱུང་བ་ལ་ཐུགས་ལས་ཆུང་ངུར་བཞུགས་སམ།",
    "དེ་ཕྱོགས་ཐམས་ཅད་ཀྱི་གཙུག་གི་ནོར་བུར་གྱུར།",
    "རྣམ་རྒྱལ་གདུགས་དཀར་སྒྲོལ་མ་འབུམ་གསུམ་རེ།",
    "ཞལ་གཟིགས་ལུང་བསྟན་སོགས་འབྲིར་མི་ལང་བས།",
    "དེ་ནས་སྐུ་འདས་པ་ནས་སྒྲ་འོད་མེ་ཏོག་གི་ཆར་སོགས་དང་།",
    "གདུང་ཐལ་རྣམས་ཤ་རི་རམ་ཁོ་ནར་གྱུར་པ་གདུང་རྟེན་དང་།",
    "ལུང་རྟོགས་མཐུ་སྟོབས་ཡེ་ཤེས་མེ་དཔུང་གིས།",
    "མ་རུངས་ནག་ཕྱོགས་བུད་ཤིང་བསྲེགས་པའི་འོད།",
    "ཡུལ་སྐྱོང་རྨ་ཆེན་སྦོམ་རའི་ལྷ་ཞོལ་ཨ་རིག་གསེར་མཛོད་ལུང་གི་ནང་།",
    "ཨ་མྱེ་ཀེ་ཏུ་དམར་ཡག་གི་མདུན།",
    "ཕ་བོང་གི་སྟེང་དུ་བརྒྱབ་པས་འདམ་བརྫིས་པ་ལྟར་བྱིས་པའི་རྗེས་གསལ་བར་བྱུང་།",
    "ཟླ་བ་གཉིས་ཙམ་སོང་བ་ན་ཐུགས་རྗེ་ཆེན་པོས་བྱིན་གྱིས་བརླབས་དུང་སྐྱོང་ལྷ་མོས་གཟེངས་བསྟོད་མཛད་པས་སྐུ་བོངས་ལོ་གཉིས་ལོན་པའི་བོངས་ཚོད་དུ་གྱུར་ཅིང་།",
    "དམུ་རྒེའི་དགོན་གྱི་མི་སེར་འགའ་ཞིག་གིས་གཡོ་ཐབས་བྱས་ནས་གདན་འདྲེན་པར་རྩོམ་པས།",
    "དེ་སྐབས་རྡོ་རྗེ་ཕག་མོ་ལ་མཁའ་འགྲོ་མང་པོས་བསྐོར་བ་ཞལ་གཟིགས།",
    "རྒྱལ་བ་ཤཱཀྱ་ཐུབ་པ་ལ་སྤྱོད་རྒྱུད་དང་ལྷ་རྒྱུད་ཀྱིས་བསྐོར་བའང་གཟིགས་ཏེ་སྟོན་པའི་ཞལ་ནས།",
    "གསུངས་ནས་རང་གི་ཐུགས་ཀར་ཐིམ།",
    "མཁའ་འགྲོ་སེང་གེའི་གདོང་ཅན་བཞུགས་པའི་གཟིགས་སྣང་གི་ཚེ།",
    "མཁའ་འགྲོ་བདུད་འདུལ་དྲག་མོ་བསྒྲུབ་གྱུར་ན།",
    "སྔོན་གྱི་ཡུམ་གཅིག་ལྷ་མོ་བྲ་མོ་ཧེ།",
    "ཚེ་རིང་མཆེད་ལྔས་བསྐོར་པ་ཞལ་གཟིགས།",
    "དེ་སྐབས་བསམ་སྦྱོར་ངན་པའི་ཕྱོགས་ཀྱི་མི་ཞིག་གིས་བཙན་དུག་དྲངས་པར་བརྟེན་ཅུང་ཟད་བསྙུང་བའི་ཚེ།",
    "སྟག་ཚང་ལྷ་མོར་བྱོན་ནས་བདེ་མཆོག་ཕུག་པའི་གནས་སྒོ་ཕྱེ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ངེད་ལ་གསོན།",
    "ལོང་ཞིག་སྐལ་ལྡན་ཁྱོད་ལ་གཏོད།",
    "སྐལ་ལྡན་ཁྱོད་ལ་ང་ཡིས་གཏད།",
    "འགྲོ་བ་རྣམས་ལ་ཁྱོད་ཀྱིས་སྟོན།",
    "སྐལ་ལྡན་རྣལ་འབྱོར་རིས་ལྡན་ཁྱོད།",
    "ཁྱོད་ནི་སློབ་དཔོན་པདྨའི་སྲས།",
    "ངེད་ཅག་རྟག་ཏུ་ཁྱོད་ལ་འཁོར།",
    "དེ་མ་ཐག་ནམ་མཁའ་ནས་རྐང་གླིང་གི་སྒྲ་བྱུང་མེ་ཏོག་གི་ཆར་བབས་སོ།",
    "རེབ་སྐོང་གི་སྦྱིན་བདག་རྣམས་ཀྱི་སྙན་གསན་ཕུལ་བས།",
    "དེ་ནས་རེབ་སྐོང་དུ་བྱོན།",
    "སླར་རྒྱ་ཡུལ་དུ་ཐོལ་ཅུའི་སྐྱ་སེར་མང་པོ་གདན་འདྲེན་དུ་བྱུང་བ་བཞིན་ཕེབས་པས་ཤུའུ་ལྡོང་ཕྲོམ་ཞེས་པའི་གཞི་བདག་གི་མཐོ་འཚམས་ནས་ཐོག་དང་སེར་བ་ཕབ་པས།",
    "འཕགས་པའི་སྐུ་ལ་ཐིམ་པར་གཟིགས་པའི་ངའི་སྦྱིན་བདག་རྣམས་འཚེངས་གསུངས།",
    "དེ་དག་གི་ཚེ་ལམ་བར་དུ་མི་མ་ཡིན་དམ་ལ་བཏགས་ཤིང་ཐམས་ཅད་ཀྱིས་སྐྱེ་བར་གྲོགས་བྱེད་པར་ཁས་བླངས་ནས་དམ་ཚིག་བསྒྲགས་པ་མཛད།",
    "ཕྱི་ནང་གི་མངོན་མཁྱེན་གྲུབ་རྟགས་སོགས་ལ་ཐོགས་པ་མེད་པས།",
    "ལམ་བར་དུ་རེས་འགའ་རྫུ་འཕྲུལ་གྱིས་བྱོན་པར་ཡང་གྲགས།",
    "དགུང་ལོ་དོན་གཉིས་པ་མེ་བྱི་སྤྱི་ལོ་༡༦༣༦ལ་རང་ཡུལ་དུ་བྱོན་ནས་ལོ་མང་པོ་རེ་འགའ་བསྙེན་སྒྲུབ་ཅུང་ཟད་རེ་མཛད།",
    "རེས་སྤྲུལ་སྒྱུར་སྣ་ཚོགས་ཀྱིས་མངོན་མི་མངོན་ཅི་རིགས་ཀྱི་སྒོ་ནས་གདུལ་བྱ་རྣམས་སྨིན་གྲོལ་ལ་བཀོད་ནས།",
    "སྔར་གྱི་ཐམས་ཅད་མཁྱེན་གཟིགས་ཆེན་པོ་དང་བཀའ་བགྲོས་ཀྱང་ཡོད་ཅིང་།",
    "རང་ཡུལ་དུ་བྱོན་པའི་ལམ་ཁར་ཐུགས་རྗེ་ཆེན་པོ་རྩ་བ་གསུམ་གྱིས་བསྐོར་བར་གཟིགས་ཤིང་།",
    "འབྲེལ་ཚད་དོན་དང་ལྡན་པ་ཁྱོད།",
    "སྔོན་ཆད་ཁྱོད་ལ་འབྲེལ་ཚད་ཀུན།",
    "ནམ་མཁའ་འཇའ་མཚོན་གྱིས་ཁྱབ་ཅིང་རོལ་མོ་སྣ་ཚོགས་འཁྲོལ་ལོ།",
    "ནང་གཅིག་ཡུམ་གྱིས་བ་འཇོ་བར་བྱོན་པའི་ཤུལ་དུ་བྱིས་པ་དེ་མདང་ཐལ་ཚན་རྣམས་ཀྱི་སྟེང་དུ་བཞུགས་པས།",
    "བཞུགས་ཤུལ་གྱི་མེ་རྣམས་སོལ་བར་སོང་ཞིང་།",
    "མགོན་ཁང་གི་ནང་དུ་རྒན་པོ་སྐྲ་དང་ཁ་སྤུ་རྣམས་དཀར་པོ་གཅིག་འདུག་ཅེས་གསུངས་པས།",
    "བྲམ་གཟུགས་ཡིན་གསུངས་ཤིང་རེས་འགའ་ཡིབ་པའི་ཚུལ་གྱིས་གར་སོང་ཆ་མེད་པ་ཡུན་འགའ་རེར་བཞུགས།",
    "དེ་ནས་བཟུང་ལོ་རེ་བཞིན་ཁྲལ་ནང་ནས་རྟ་གཉིས་རེ་འབུལ་བ་མཛད།",
    "ཚོ་བ་བཅུ་དྲུག་གིས་བསྙེན་བཀུར་ཕུན་སུམ་ཚོགས་པ་བྱས།",
    "དེ་ནས་བསྟན་འཛིན་དང་ལྷན་དུ་ཇུ་ནང་གི་དྲུང་དུ་གཏུག་གཤེར་ལ་སླེབས་ནས་ཡོང་སྐབས།",
    "འགའ་རེ་ལ་ཕྱག་རེག་པ་ཙམ་གྱིས་གདོན་དྲག་པོ་ལས་གྲོལ་བ་སོགས་འགྲོ་དོན་མཐའ་ཡས།",
    "བསྙེན་པར་རྫོགས་ནས་ཐུན་མཚམས་གསར་བའི་ལང་ཚོ་རྒྱས་པའི་མཚན་བློ་བཟང་འཇམ་དབྱངས་རྒྱ་མཚོར་གསོལ།",
    "སྐབས་ཤིག་རང་ཡུལ་གྱི་ཉེ་ཆར་སྐུ་མི་སྣང་བས་དྲུང་གནས་གཅིག་གིས་བཙལ་བ་ན་བྲག་ཅིག་གི་ནང་དུ་བྱོན་པས་ལྷ་མང་པོའི་སྣང་བརྙན་ལ་གཟིགས་ཀྱིན་འདུག་པས།",
    "ཕྱིར་བྱོན་ནས་བྲག་ཀྱང་སྔར་བཞིན་དུ་སོང་།",
    "དེ་ཡང་སྔ་སོ་ནས་གཞན་ཕྱོགས་ཀྱི་མི་ངན་སོང་གི་གཡང་སར་མྱུར་དུ་འགྲོ་བ་ལ་རིངས་པའི་བསམ་སྦྱོར་ཅན་ཞིག་གིས་བཙན་དུག་དྲངས་པའི་རྐྱེན་བྱས།",
    "སྐུ་འདས་པ་ན་མེ་ཏོག་གི་དབྱིབས་ཅན་གྱི་ཁ་བ་མང་པོ་འབབ་ཅིང་འཇའ་སྤྲིན་འཁྲུགས་པ་སོགས་མཐའ་ཡས།",
    "དེའི་ཚེའང་ངོ་མཚར་མང་པོ་བྱུང་ཞིང་འཇའ་ཚོན་སྣ་ལྔ་བའི་གདུང་རིང་བསྲེལ་དང་བཅས་སྐུ་གདུང་གི་ནང་དུ་བཞུགས་སོ།",
    "འགོག་མེད་རྒྱུ་ལ་རྣམ་དཀར་འོད་སྟོང་གིས།",
    "རྩ་གསུམ་ཐུགས་རྗེས་བོང་བ་གསེར་གཟིགས་སུ།",
    "བྱིས་པའི་ལད་མོས་དད་ལྡན་མགོ་བསྐོར་ཞིང་།",
    "ཞེས་རོང་བོ་མཁས་གྲུབ་ཆེན་པོའི་རྣམ་པར་ཐར་བ་དཔག་བསམ་ལྗོན་པ་ལས་སྨྲ་བ་བོ་རང་ཉིད་ཀྱི་རྟོགས་པའི་སྡོམ་ཚིག་གི་ཡལ་འདབ་སྟེ་ཞེ་གསུམ་པའོ།",
    "དཔལ་ཁྱིམ་ལྟར་དཀར་ལེགས་མེ་ཏོག་ལིང་ལིང་གཡོ་བའི་འདབ་མ་སྟོང་ལྡན་ཕུལ་བྱུང་མཛད་བཟང་གི།",
    "སྔོན་བྱོན་དམ་པའི་གསུང་གི་བདུད་རྩིའི་ཐིགས།",
    "ཆགས་སྡང་མིག་གིས་བལྟ་བར་མི་བཟོད་པའི།",
    "ཕྱོགས་རེ་མཐོང་ལ་མཁས་པའི་རློམ་པ་ཅན།",
    "རྟོགས་བརྗོད་རྨད་བྱུང་རི་མོ་གསལ་འཆར་བ།",
    "རྒྱལ་བསྟན་ཕན་བདེའི་ས་མོས་རྟག་རྒྱས་ཤིང་།",
    "གང་གིས་ལུགས་གཉིས་གསེར་འཁོར་རྩིབས་སྟོང་ཅན།",
    "ཡངས་པའི་ནོར་འཛིན་ཁྱོན་ལ་འགོད་མཁས་པའི།",
    "ཕན་བདེ་གདུགས་དཀར་སྲིད་པའི་རྩེ་མོའི་བར།",
    "འཛམ་བུའི་ལང་ཚོ་དར་བའི་ལྗོངས་སྤྱི་དང་།",
    "མཉམ་མེད་ཟས་གཙང་གི་སྲས་པོ་འཇིག་རྟེན་དུ་བྱོན་ཚེ་བྱང་སེམས་ཡོན་ཏན་མེ་ཏོག་ཀུན་ཏུ་རྒྱས་པ་དང་།",
    "འདོད་ཡོན་རེག་བྱ།",
    "དགེ་སློང་བློ་བཟང་དར་རྒྱས་མཛོ་མོ་གཅིག།",
    "མགོན་ཁྱོད་བསྐལ་པ་དཔག་མེད་སྔ་རོལ་ཏུ།",
    "ཐུན་མོང་སྣང་ངོར་གང་འཚམས་སྤྲུལ་པའི་གར།",
    "རིས་མེད་འགྲོ་བའི་གཙུག་གི་མཁར་འཕགས་ཤིང་།",
    "༡ ཤིས་བརྗོད་དང་གླེང་གཞིའི་སྐབས། ། ན་མོ་གུ་རུ་དེ་བ་ཌཱ་ཀི་ནེ།",
    "རི་བོང་ཅལ་སྒྲོག་གམ་ཐག་ཁྲ་སྦྲུལ་མཐོང་གི་རྣམ་པར་ཟད་མོད།",
    "འཇིག་རྟེན་སྙན་གྲགས་ལ་རེ་བ་སོགས་ཀྱི་སྒོ་ནས་བརྗོད་པ་ག་ན་ཡིན།",
    "བུད་མེད་དང་།",
    "རེས་འགའ་དམ་ཚིག་བཛྲ་དང་།",
    "རེས་འགའ་འཇིགས་མེད་རྡོ་རྗེ་དང་།",
    "རེས་འགའ་དུད་འགྲོའི་གཟུགས་སུའང་གནས།",
    "སྔོན་བསྐལ་པ་བྱེ་བ་མང་པོ་འདས་པའི་སྔ་རོལ་ན་ཤར་ཕྱོགས་ཀྱི་ལོགས་སུ་ཞིང་ཁམས་དགའ་བའི་འོད་བྱ་བ་ཞིང་གི་ཡོན་ཏན་རྨད་དུ་བྱུང་བ་ན།",
    "དེས་ཀྱང་འདི་ནི་འཕགས་པ་སྤྱན་རས་གཟིགས་ཏེ་ཡོན་ཏན་དཔག་ཏུ་མེད་པའོ།",
    "བདག་ནི་དེང་བཟུང་ཁྱོད་མཚུངས་མ་གྱུར་བར།",
    "མཐོང་ཐོས་དྲན་རེག་འགྲོ་བ་དེ་རྣམས་ཀྱང་།",
    "དེང་བཟུང་ཁྱོད་ཀྱིས་རྒྱལ་མང་མཉེས་པར་བྱེད།",
    "ལྷ་རྣམས་ཀྱིས་མེ་ཏོག་གི་ཆར་ཕབ་ས་ཡང་གཡོས་པར་གྱུར་ཏོ།",
    "དེ་ནས་རེ་ཞིག་ལྷའི་བུའི་གཟུགས་དེ་ཉིད་ཀྱིས་ལོ་བདུན་འབུམ་དུ་སྤྲུལ་པ་སྣ་ཚོགས་པས་འགྲོ་བའི་དོན་བྱས་ནས་ཚེ་འཕོས་ཏེ།",
    "དེ་ཡང་ལྷའི་བུའི་རྟོགས་བརྗོད་འདི་ནག་ཚོ་ལོ་ཆེན་དགུང་ལོ་སོ་བདུན་པར་ཐུགས་རྗེ་ཆེན་པོའི་ཞལ་གཟིགས་ཤིང་ལུང་བསྟན་སྩལ་པ་ན།",
    "ཕྱག་ན་པདྨའི་ཐུགས་རྗེ་ཟླ་སྣང་གིས།",
    "དྲི་མེད་དམ་པའི་ས་མོས་བཞད་པ་ན།",
    "མགོན་པོ་འོད་མི་འགྱུར་བ་དང་འཕགས་པ་ཕྱག་ན་པདྨོ་ཟུང་གི་བཀས་ཉེ་བར་བསྐུལ་བ་ལ་བརྟེན།",
    "སློབ་དཔོན་གྱི་ཞལ་ནས་ཁྱོད་སྐྱེ་བ་མང་པོའི་སྔ་རོལ་ཏུ་ལྷོ་ཕྱོགས་ཀྱི་རྒྱལ་པོར་གྱུར་ཚེ་བསགས་པའི་ལས་སྒྲིབ་ཡོད་པས་རྨོངས་རྟུལ་སེལ་བའི་ཐབས་བྱ་དགོས་གསུངས་ནས་ཐུགས་རྗེ་ཆེན་པོའི་སྒྲུབ་ཐབས་གནང་ཀྱང་ཟླ་བ་མང་པོར་བློར་མ་ཟིན་མཐར་གྱི་ཅུང་ཟད་ཟིན་ནས་སློབ་དཔོན་ལ་ཞུས་ཤིང་ཡུན་རིང་བར་བཀླགས་པས།",
    "སྤྱན་རས་གཟིགས་ཀྱིས་ཞལ་བསྟན་བྱིན་གྱིས་བརླབས་ནས།",
    "དེར་སློབ་དཔོན་གྱི་དྲུང་དུ་སོང་ནས།",
    "དེས་ཀྱང་དེ་བཞིན་དུ་བསྒོམས་པས་དེ་ཡང་རེག་མཐོང་ལྟ་བུའི་མཚན་མ་རྙེད་པ་ན།",
    "མཐར་གསང་བ་འདུས་པའི་ཞལ་གཟིགས་ཤིང་།",
    "མི་རིང་བར་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་ཉམས་འོག་ཏུ་ཆུད་ཀྱང་།",
    "རྭ་ཅན་པ་དེས་དྲི་ཆུ་ཐིགས་པ་རེ་རེ་བླུགས་པས།",
    "སློབ་དཔོན་གྱིས་རྒྱ་གར་ལྷོ་ཕྱོགས་སུ་སོང་ལ་འགྲོ་བའི་དོན་གྱིས་ཤིག་གསུངས་པས།",
    "འདུས་པའི་འཁོར་ལ་གཟིགས་ནས་གསུངས་པ།",
    "རྨོངས་པའི་སྐྱེས་བུ་རྭ་ཅན་བདག་གིས་ཀྱང་།",
    "སྐྱེ་མེད་ཡེ་ཤེས་རང་རིག་བུ་ཆུང་གི།",
    "འོད་གསལ་བསམ་གྱིས་མི་ཁྱབ་པའི་ཏིང་ངེ་འཛིན་ལ་གནས་པའི་སྐབས་ཤིག་ཡུལ་དེའི་རྒྱལ་པོ་འཁོར་སྟོང་དང་བཅས་ཏེ་རི་དྭགས་བཤོར་དུ་སོང་བས་མཐོང་སྟེ།",
    "དེར་རྒྱལ་པོས་ཡིད་ཀྱིས་གུས་པ་བྱས་པས་རེངས་པ་ལས་གྲོལ།"
  ]
}