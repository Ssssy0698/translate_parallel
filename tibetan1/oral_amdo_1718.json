    "མཛད་པ་སུམ་རྩེན་རྣམ་རྒྱལ་ཁང་བཟང་གིས།",
    "དེ་བར་མ་དྷ་པའི་བྲག་ཕུག་ཏུ་ཟླ་བ་དྲུག་བསྒོམས་པས་དཔལ་ཧེ་རུ་ཀ་དང་གཤིན་རྗེའི་གཤེད་ཀྱི་དཀྱིལ་འཁོར་ཞལ་གཟིགས་ནུས་པ་དཔག་ཏུ་མེད་པ་ཐོབ།",
    "མུ་སྟེགས་པོ་ལ་ལྐུགས་པ་དང་རེངས་པ་དང་བཅིངས་པ་སོགས་མཛད་ནས་ནང་པར་བཙུད།",
    "བདེ་ཆེན་ཡེ་ཤེས་ཆང་གིས་རྟག་མྱོས་ཀྱང་།",
    "ཞང་ཞུང་གི་ཡུལ་ནས་ལེགས་མཐོང་།",
    "ཡུལ་གྱི་ཡོན་ཏན་གཟིགས་ནས་བཙན་ཐང་སྒོ་བཞིར་ཕེབས་པ་དང་འཛོམ།",
    "གང་ནས་འོང་དྲིས་པས་སྐད་མ་མཁྱེན་པས་མཛུབ་མོ་གནམ་ལ་གེར་བས།",
    "བཙུན་མོ་གནམ་མུག་ཁབ་ཏུ་བཞེས།",
    "བཙུན་མོ་ས་སྙན་མའི་སྲས་སེ་སྣོལ་གནམ་ལྡེ་བཙན་བྱ་བ་འཁྲུངས།",
    "བྲུ་ཤའི་རྒྱལ་པོ་ལ་དཔུང་གིས་སྐྲག་པར་མཛད་ནས་མངའ་འོག་ཏུ་བསྡུས།",
    "རྒྱལ་པོའི་བཀའ་བཞིན་རྒྱལ་མོ་ཚ་བ་རོང་གི་རྒྱལ་པོ་མི་ཉག་གཤེན་སྒུར་བྱ་བ་དཔུང་གིས་བཏུལ།",
    "ཐུགས་རྗེ་ཆེན་པོའི་ཞལ་གཟིགས་བྱིན་གྱིས་བརླབས་ནས།",
    "དྲེགས་ལྡན་དགྲ་ངན་དཔུང་ཚོགས་མཐར་མཛད་ནས།",
    "ཞེས་རོང་བོ་མཁས་གྲུབ་ཆེན་པོའི་རྣམ་པར་ཐར་བ་དཔག་བསམ་ལྗོན་པ་ལས་སོ་སྲུངས་ལྡོང་གི་ཡལ་འདབ་སྟེ་ཉེར་དགུ་པའོ།",
    "མུན་གླིང་གསལ་བྱེད་ཉི་ཟླ་ཟུང་གཅིག་གི།",
    "སྲས་ཁྲི་སྲོང་ལྡེའུ་བཙན་འཁྲུངས་པའི་ཚེ་བློན་པོ་ཆེན་པོར་གྱུར་ནས་གསལ་སྣང་གི་སྲས་སང་ཤི་རྒྱ་ཡུལ་དུ་ཕོ་ཉར་མངགས།",
    "མ་ཞང་གི་ཆད་པ་བྱུང་དོགས་ནས་གསལ་སྣང་ཡིབ།",
    "དེའི་ཚེ་གསལ་སྣང་གིས་ལྷོ་ཕྱོགས་ཀྱི་གྱང་གི་ལས་དཔོན་མཛད།",
    "ཅེས་རོང་བོ་མཁས་གྲུབ་ཆེན་པོའི་རྣམ་པར་ཐར་བ་དཔག་བསམ་ལྗོན་པ་ལས་གསལ་སྣང་གི་ཡལ་འདབ་སྟེ་སུམ་ཅུ་པའོ།",
    "ནག་ཕྱོགས་ས་མོས་ཚོགས་ལ་ཟུག་རྔུ་འབྱིན།",
    "ཉམས་སུ་བླངས་པས་ལོ་བཅུ་གཅིག་ན་སྔར་གྱི་ཡི་དམ་གསུམ་པོས་ཞལ་གཟིགས།",
    "ཁྱད་པར་ལས་གཤིན་དང་གིང་ལྔ་གཟའ་གདོང་མ་མོ་ཕུར་བསྲུངས་བཅུ་གཉིས་རྣམས་བྲན་བཞིན་དུ་གྱུར།",
    "མུ་ཏིག་བཙན་པོས་རང་ཉིད་ཀྱི་སྲིང་མོའི་བུ་མོ་པདྨ་རྒྱན་བྱ་བ་ཆུང་མར་གནང་།",
    "བློན་པོ་ཨ་གུར་ཁྲོས་ཏེ་རང་ཉིད་ཀྱི་ཞོ་ཤས་འཚོ་བ་སུམ་བརྒྱ་ནོར་དང་བཅས་པ་ཁྲིད་དེ་རང་ཡུལ་དུ་སོང་བས་བློན་པོ་རྣམས་ཀྱིས་བདས་པས་སྡིག་བློན་སྟག་སྣའི་བུ་བྲན་དཔལ་ཟེར་བ་མདས་བསད་དེ་བོད་དཔུང་རྣམས་སྐྲག་པར་བྱས་པས་སུས་ཀྱང་གླགས་ལྟར་མ་ནུས་པར་དཔུང་རྣམས་རང་ཡུལ་དུ་ལོག་ཨ་གུར་གྱིས་མི་ཉག་ཏུ་སོང་ནས་ཐུགས་རྗེ་ཆེན་པོའི་ལྷ་ཁང་བཞེངས།",
    "ཞལ་གཟིགས་ནུས་པ་ཐོབ་ནས་མི་ཉག་གི་འདྲེ་རྒོད་མང་པོ་བཏུལ།",
    "ཁྱོད་རང་ལྐུགས་པ་འདྲ།",
    "སྲས་ན་རེ།",
    "དགུང་ལོ་ཉེར་གཅིག་པ་ལ་གཤིན་རྗེའི་གཤེད་ཀྱི་ཞལ་གཟིགས་ནས་རང་ལ་ཐིམ་པས།",
    "རྐོང་ཡུལ་དྲེ་སྣ་གདོང་དུ་བྱོན་པའི་ཚེ་རྐོང་བཙུན་དེ་མོས་གཟུགས་བསྟན་ནས་ཐུགས་བཞེད་ཐམས་ཅད་བསྒྲུབས།",
    "དེར་ཡུལ་དཔོན་རྡོ་རྗེ་རྒྱལ་པོ་ཟེར་བ་ལ་བུ་མོ་རྐོང་བཙུན་དེ་མོ་རང་གི་སྤྲུལ་པ་མཁའ་འགྲོའི་མཚན་ལྡན་ཞིག་ཡོད་པ་བཞེས་ནས།",
    "ཡུལ་དེར་དམར་ནག་མེ་འཕྲེང་གི་སྐུ་བཞེངས་ནས།",
    "ཡེར་བའི་བྲག་ལ་གསང་བདག་བསྒྲུབས་པས་ཞལ་གཟིགས་ནས་ཐུགས་ཀར་ཐིམ་པའི་སྣང་བ་བྱུང་།",
    "ཡུལ་དེར་རྒྱལ་པོ་གཅིག་གི་སྐུ་ལ་མཚོན་ཆའི་ཆར་ཕབ་ཀྱང་ལྕགས་ལ་བརྡེག་པ་ལྟར་སོང་བས།",
    "ཡ་མཚན་ནས་དེར་ཡང་བཀུར་ཞིང་ཡུལ་དེར་འགྲོ་བ་ཕོ་མོ་མང་པོ་ཡང་སྨིན་པར་མཛད་ནས་སླར་བྱོན་ཀོང་པོའི་ཡུལ་དུ་ཟླ་བ་དྲུག་ཙམ་བཞུགས་ནས་སྐུ་འདས་སོ།",
    "བདེ་ཆེན་སྣང་བའི་འཛུམ་གྱིས་སོ་འཕྲེང་གིས།",
    "ཁྱེའུ་འདི་ལའང་སེམས་དེ་ལྟ་བུ་ཡོད་ན་འོ་ཅག་རེ་ཕུང་ཟེར་ནས།",
    "ཕ་བོང་ཞིག་གི་སྟེང་དུ་འདུག་ནས་གྲོགས་བྱེའུ་གཉིས་བུ་མོ་གཅིག་དང་གསུམ་ཡོད་པ་རྣམས་ལ་རང་ཉིད་ཀྱི་ལག་ན་ཟན་ཅིག་ཡོད་པ་དེར་བྱིན་པས་འཕགས་པས་ཁྱེའུ་གཉིས་ཀ་བྱིན་གྱིས་བརླབས།",
    "ཕ་བོང་གི་སྟེང་ནས་ཁྱེའུ་དགེ་ལེགས་མཚོས་མདུན་གྱི་ལྷ་རྣམས་ལ་ཕྱག་གསུམ་འཚལ་བ་དང་།",
    "དེ་ཉིད་དུ་འཕོས་ནས་རང་ཉིད་ཀྱི་ཡི་དམ་ལྷ་ཚོགས་དང་འགྲོགས་ནས་འཕགས་པའི་ལུང་བཞིན་གུང་ཐང་གི་ཕྱོགས་སུ་བྱོན་ནོ།",
    "དམུ་རྒོད་གདུལ་དཀའི་འགྲོ་བ་རེ་རེའི་ཆེད།",
    "བརྩོན་འགྲུས་འཕྲུལ་གྱིས་ཐུབ་བསྟན་གླིང་བཞིའི་ཁྱོན།",
    "དེ་ཡང་སྔར་གྱི་བྱིས་པ་དེ་ཉིད་ཀྱིས་འཕྲོས་ལ་སྟོད་མངའ་རིས་ཀྱི་སྨད་གཙང་གི་རྒྱུད་ཡར་ཟང་པ་ཡུལ་གྲུ་ཉེར་གཅིག་ཡོད་པའི་གཙོ་བོ་པུ་རང་ཞང་ཞུང་གུ་གེ་གསུམ་ཡིན་འདི་ནི་པུ་རང་གི་ཆར་གཏོགས་པའི་ནང་ཚན་སྨད་ཕྱོགས་རུ་བཞིར་གྲགས་པའི་ཡ་གྱལ་གུང་ཐང་བདེ་ལེགས་སྐྱིད་གྲོང་དུ་གྲགས་པ་ན།",
    "ཁྱོད་སྤྲུལ་པ་གཅིག་ཡིན་པར་འདུག་ནག་པོ་རང་ཉིད་ཀྱི་བཀའ་ཡིན་པས་ངས་ཁྱོད་ལ་ནག་པོ་ཆེན་པོའི་རྗེས་གནང་བྱེད་གསུངས་ནས་རྗེས་གནང་མཛད།",
    "ཡབ་མེས་ཀྱི་པཎྚི་ཏ་ཆེ་ཆུང་བཅུ་གསུམ་ཙམ་གདན་དྲངས་ནས་གདའ་སྟེ་བསྟན་པ་ལ་མ་ཕན་པར་སླར་གནོད་པ་བྱས་པ་བཞིན་དུ་སོང་།",
    "ད་རེས་ཅི་ནས་ཀྱང་བཞུད་དགོས་གསུངས་ནས་ཞུ་བ་ནན་ཅན་དུ་ཕུལ།",
