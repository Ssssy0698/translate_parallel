    "ཁོང་ནི་སྐྱེས་བུ་ཙམ་ཞིག་མིན་པར་ངེས་པ་དོན་གྱི་རླབས་ཆེན་སྐྱེས་བུ་ཞིག་རེད་ཅེས་ངོས་འཛིན་དགོས་པ་ཞིག་ཏུ་བཏང་ཞིང་།",
    "གང་ཟག་འགའ་རེ་བདེ་བ་ཙམ་གྱིས་མི་འོང་བས།",
    "ཐུན་མོང་དུ་འབད་བརྩོན་བྱ་དགོས།",
    "ཁོང་གི་མཇུག་མཐའི་ཞལ་ཆེམས་རང་ཚུགས་མ་འཆོར་དང་གཞན་སེམས་མ་དཀྲུག་ཅེས་པར་དབྱེ་ཞིབ་ཕྲན་ཙམ་བྱས་པ།",
    "ཁོང་འཇིག་རྟེན་འདི་དང་ཞལ་གྱེས་དུས་ང་ཚོར་གདམས་པའི་ཞལ་ཆེམས་ཏེ།",
    "དེ་ཡང་སྐྱེས་ཆེན་སུ་དང་གང་ཡིན་ཡང་དེའི་གསུང་ལ་འཇུག་རྐྱང་མི་བྱེད་པར་རང་ཚོད་ཀྱིས་དབྱེ་ཞིབ་བྱེད་པ་ནི།",
    "ཁོང་གི་ཞལ་ཆེམས་འདི།",
    "ཞལ་ཆེམས་འདི་ལས་སྐྱེས་བུ་ཁོང་གི་སྐུ་ཚེའི་མཛད་འཕྲིན་སོགས་ལ་ལྟ་མཁན་ནི་ད་སྔོན་ཁོ་བོས་སུ་ཡང་མཐོང་མ་སོང་ལ།",
    "ང་ཚོས་དབྱེ་ཞིབ་ཙམ་ཡང་མི་བྱེད་པར་དག་སྣང་རབ་རིབ་ཅིག་གིས་དེར་འཇུག་རྐྱང་བྱེད་པ་ནི་ཁོ་བོས་བསམ་ན་ལེགས་པའི་གནས་ཤིག་མ་རེད་འདོད།",
    "ཞལ་ཆེམས་འདི་ལ་རྒྱབ་ལྗོངས་ཅི་འདྲ་ཡོད་པའམ་གནས་བབ་གང་འདྲ་ཞིག་གི་འོག་ནས་གསུངས་པ་ཡིན་ནམ་ཞེ་ན།",
    "ཁོང་གི་མི་ཚེའི་ཉམས་མྱོང་དང་ལག་ལེན་སོགས་ཀྱི་སྟེང་ནས།",
    "ཁོང་གི་ཆེས་མཇུག་མཐའི་ཞལ་ཆེམས་འདི་གསུང་སྐབས་ཀྱི་སྔ་གཞུག་ལ་རྒྱུས་མངའ་ཡོད་པའི་མི་ཀུན་ལ།",
    "ཁོང་གི་ཞལ་ཆེམས་འདི་ཉིད་རིག་གསར་སོགས་ཀྱིས་བསྐྱེད་པ་ཁོ་ན་ཞིག་ཀྱང་མིན་ཏེ།",
    "བདག་གམ་ངའམ་སྐྱེས་བུ་སྒེར་རང་གི་རྩིས་ཐང་དང་རང་ཚུགས་སོགས་ཤོར་འགྲོ་བའི་ཆ་ཞིག་ཀྱང་ཡོད་མོད།",
    "ཁོང་གི་དཀའ་སྡུག་སྣ་ཚོགས་ཀྱིས་གསར་འདེབས་བྱས་པའི་གསེར་རྟ་བླ་རུང་སྒར་ལ་གཏོར་གཤིག་ཐེབས་ཏེ།",
    "གཉའ་གནོན་དང་དེའི་ཕྱིར་རྒོལ་སོགས་ལ་ཞལ་ཆེམས་དྲོན་མོ་འདི་ཚད་གཞི་བྱས་ཏེ་ཐག་གཅོད་བྱེད།",
    "ཞལ་ཆེམས་འདི་གང་གི་ཕྱོགས་ལ་གསུངས་པ་ཡིན་ནམ་ཞེ་ན།",
    "སྤྱིར་ཞལ་ཆེམས་འདིའི་ནང་དོན་ཁོ་ན་ཡི་ངོས་ནས་བལྟས་ན་གཞུང་གི་ཕྱོགས་ལ་ཡང་ཁྱབ་པའམ་ཕོག་སྟེ་ཡོད་མོད།",
    "ཁོང་གི་ཞལ་ཆེམས་འདི་ཏག་ཏག་བོད་ཀྱི་ཕྱོགས་ལ་གཟས་ཏེ་གསུངས་པ་ཞིག་ཡིན།",
    "སྒེར་གཅོད་ཀྱི་ལས་ལ་རིང་ནས་གོམས་པའི་གཞན་གྱི་ཕྱོགས་ལ་ཁོང་གི་ཞལ་ཆེམས་འདི་ཙམ་གྱིས་ནུས་པ་ཅི་ཡང་མི་འཐོན་པས་ཡིན་སྲིད།",
    "རིགས་གཞུང་གི་རྩིས་ཐང་སོགས་རྡོག་བརྫིས་བྱས་ཏེ་གཉའ་གནོན་བྱས་ཡོང་ན།",
    "དེ་ལ་རྒོལ་ལན་བསློག་པ་ནི་ཆོག་པ་ཞིག་གམ་འོས་པ་ཞིག་རེད་ལ།",
    "སྒེར་གཅོད་དང་གཉའ་གནོན་སོགས་ལ་རྒོལ་ལན་བསློག་རྒྱུ་ནི་ལས་སླ་མོ་ཞིག་གཏན་ནས་མིན་ཏེ།",
    "ཁོང་གིས་གཉའ་གནོན་ཁུར་བའི་བོད་དམ་གསེར་རྟ་བླ་རུང་ལ་གཞན་སེམས་མ་དཀྲུག་ཅེས།",
    "སྒེར་གཅོད་དང་གཉའ་གནོན་སོགས་ལ་རྒོལ་བ་གཏོང་བའི་དཔའ་སྤོབས་ཀྱི་ཀི་སྒྲ་སྣ་ཚོགས་སྒྲོག་པ་ལ་ཚོད་འཛིན་དང་ཁྱད་གསོད་སྣ་ཚོགས་བྱེད་མོད།",
    "བར་འདི་ནས་ང་ཚོས་ཅིས་ཀྱང་རང་ཚུགས་མ་འཆོར་ཞེས་པའི་ཚིག་རྐང་འདི་ལ་རྒྱུས་ལོན་བྱ་དགོས།",
    "ལྷག་ཏུ་གསེར་རྟ་བླ་རུང་གི་གནས་བབ་ཀྱི་ངོས་ནས་བལྟས་ན།",
    "བོད་མིའི་ཞི་རྒོལ་ཆེན་མོར་རྡུང་བཅག་འཕྲོག་སྲེག་གི་དོན་རྐྱེན་ཞེས།",
    "སྡིག་དམོད་སྣ་ཚོགས་བྱས་ཏེ་རང་ཚུགས་སོགས་ཀྱང་ཤོར་མེད།",
    "བོད་མིའི་སྐྱིད་སྡུག་བོད་མི་རང་གི་ཕྲག་སྟེང་དུ་ཚེ་སྲོག་གཏའ་མར་བཞག་ནས་འཁུར་ཏེ།",
    "ཁོ་ཚོས་ཀྱང་ང་ཚོ་ཁ་རོག་གེར་ཡོད་པ་དེ་ཁ་རོག་གེར་བཞག་སྟེ།",
    "རྒྱུས་ལ་འགྱུར་བ་བྱུང་ནས་ནམ་ཞིག་གི་ཚེ་ན།",
    "ཞལ་ཆེམས་འདི་བོད་མི་རིགས་དང་གསེར་རྟ་བླ་རུང་སོགས་ཀྱི་གནས་བབ་ལ་དམིགས་ཏེ་གསུངས་པ་ཞིག་རེད་མོད།",
    "ད་སྐབས་མི་མང་བོ་ཞིག་གིས་ཞལ་ཆེམས་འདི་མི་བུ་སྒེར་རང་གི་མི་ཚེའི་རིན་ཐང་ལྟ་བ་དང་མི་གཞི་ཀུན་སྤྱོད་དུ་ཉམས་ལེན་བྱེད་མཁན་ཡང་མང་དུ་འདུག་ལ།",
    "དེ་ནི་འོས་པ་ཞིག་ཀྱང་རེད།",
    "ཁྱོད་འཕགས་ཀྱི་བྱ་བ་གང་ཡང་བསྒྲུབ་དཀའ།",
    "རང་གི་ཉམ་རྒྱུན་འཚོ་བའི་ཁྲོད་ཀྱི་དཀར་ནག་གི་བློ་མིག་གསལ་དུ་གཏོང་བ་ཁོ་ནར་ཟུག་ཅིང་།",
    "མདུན་གྱི་དང་རྙེན་རུ་གྱུར་པའི་སྐྱེས་བུ་གང་གིས་ཁུར་བའི་དཀའ་སྡུག་གི་རྡོག་ཁྲེས་དེ་སོ་སོས་གདེག་ཐུབ་དང་མི་ཐུབ་པའི་ནང་གི་ཆོད་སེམས་ལ་རག་ལས་འཇིགས་མེད་ཕུན་ཚོགས་འབྱུང་གནས། ཞི་བའི་དཔའ་རྟུལ།",
    "བདག་གིས་ཐོག་དང་བོར་སྐྱེས་བུ་གང་དང་འབྲེལ་བའི་རྗེས་དྲན་གྱི་ཆེད་དེབ་འདི་ཉིད་གྲ་སྒྲིག་གི་དབུ་བསླངས་པ་ཡིན།",
    "སློབ་སྦྱོང་གི་ངལ་བ་བཅས་ཀྱིས་བགྲང་བྱའི་འཁོར་ལོ་གཉིས་ཡོངས་སུ་འདས་སོང་།",
    "དེབ་ཆུང་གི་སྟེགས་བུར་དངོས་སུ་འགྲེང་བའི་སྤུན་ཟླ་ཡི་གེ་བ་འདི་དག་གི་བསམ་བློའི་ནུས་མཐུ་ལས།",
    "ཟད་མི་ཤེས་པའི་དགའ་བ་ངང་གིས་འཕེལ་ན།",
    "སྐྱེས་བུ་གང་གི་གཟི་མདངས་ཡངས་པོར་རྒྱས་སླད་མིན་ལ།",
    "སྐྱེས་བུ་གང་གི་དགོངས་གཞི་རྣམས་འུར་སྒྲོག་བྱ་རྒྱུ་ཡང་མིན་པར།",
    "དོན་དམ་པར་ང་ཚོར་མཁོ་བ་ནི་རླབས་ཆེན་སྐྱེས་བུ་དག་གི་བློ་སྤོབས་ཀྱི་མཚར་སྣང་ཙམ་མིན་པར།",
    "ང་ཚོས་སྐྱེས་བུ་ཆེན་པོའི་མི་ཚེའི་བགྲོད་ལམ་ལ་དཔྱད་འཇོག་བྱེད་པ་ནི།",
    "རང་གི་ནམ་རྒྱུན་འཚོ་བའི་ཁྲོད་ཀྱི་དཀར་ནག་གི་བློ་མིག་གསལ་དུ་གཏོང་བ་ཁོ་ནར་ཐུག་ཅིང་།",
    "ཁོང་ཅག་གི་གཤིས་རྒྱུད་དམིགས་བསལ་བ་རེ་རེས།",
    "མི་རིགས་ཤིག་ལ་སྐྱེས་བུ་ཆེན་པོ་རེ་འགའ་ལས་མི་འབྱུང་ལ།",
    "ལྷག་ཏུ་མི་རིགས་ཤིག་གིས་སྐྱེས་བུ་ཆེན་པོ་རེ་གཉིས་ལས་མཐོང་མི་སྲིད།",
    "དམ་པའི་སྐྱེས་བུ་ཞིག་གི་མི་ཚེ་དང་ཆགས་འཇིག་ནི་མི་རིགས་ཤིག་གི་དར་རྒུད་དང་མཚོན་པ་སྟེ།",
    "ཁོང་ཚོ་ཕྱིན་པའི་འགྲུལ་བཞུད་ཀྱི་ལམ་བུའི་རྗེས་སུ།",
    "མིའི་རིགས་ཀྱི་འཕོ་འགྱུར་ལ་སྒུལ་ཤུགས་ཐེབས་ངེས་ཀྱི་ནུབ་པ་མེད་པའི་ཞབས་རྗེས་རེ་རེ་བཞག་ཡོད།",
    "ཀུན་ཀྱང་མི་ཡིན་པ་གཞིར་བཞག་གིས་དྲན་པ་ཞུ་དགོས་ཀྱི་ཡོད་ཅིང་།",
    "ང་ཚོས་དམ་པའི་སྐྱེས་བུ་རྣམས་རང་དང་བར་ཐག་ཇེ་རིང་དུ་གཏོང་བའི་ལས་ལ་མི་འཇུག་པར།",
    "ཉིན་འགའི་སྔོན་དུ་ས་ཆ་དེ་དང་ཐག་མི་རིང་བའི་རི་ཁྲོད་ནང་གི་བཙུན་མཁོ་བས།",
    "བཙུན་པ་དེ་ནི་ཨ་མཆོད་ཀྱི་བྱ་བ་ལྟ་བུའི་རྒྱུ་དངོས་འཚོལ་བའི་ཟིང་ཟིང་གི་ལས་ལ་སྤྲོ་བ་གཏན་ནས་མེད་པར།",
    "ཐབས་བཀོད་གཞན་མ་མཆིས་པར་ཉིན་ཞག་འགའ་ཤས་ལ་སྦྲ་ཁྱིམ་འདི་ཚང་གི་ཨ་མཆོད་ཀྱི་ཚུལ་མཛད་དགོས་བྱུང་དེ་ཚང་གི་ཉིན་མོ་རེ་རེའི་ཉི་འོད་སེར་བོ་རི་རྩེར་ཕོག་མ་ཐག་ཡིན་ནའང་།",
    "ལང་ཚོའི་མཛེས་པ་རྣམ་པར་དགོད་པའི་བུ་མོ་གཞོན་ནུ་མ་དེ་དང་།",
    "སྦྲ་ཁྱིམ་དེ་ཚང་གི་སྒོ་དར་དང་ཐག་མི་རིང་བའི་མཚམས་སུ།",
    "མཐོང་ལ་མི་མཐོང་བའི་མདུན་ཕྱོགས་ཀྱི་གྱ་གྱུའི་ལམ་དུ་གཅིག་པུར་རྒྱུ་བའི་ཤ་དར་ཁྲག་དར་གྱི་བཙུན་པ་གང་གི་ཞལ་རས་དང་སྤྱོད་ལམ་ཐམས་ཅད།",
    "གསར་དུ་བཞད་པའི་སྐལ་བཟང་མེ་ཏོག་གི་དྲི་ཙམ་ཡང་མ་བསྣམས་པར་གྱེས་ཕྱག་བཏང་ཞིང་།",
    "རང་གི་མི་ཚེའི་དམ་བཅའ་སྲོག་བཞིན་སྲུང་བའི་བཙུན་པ་གཞོན་ནུ་དེ་ཉིད་གང་ཞེ་ན།",
    "འགྲོ་བ་མིའི་རིན་ཐང་གི་སྒང་ལ་བཞག་ནས་བལྟས་ཀྱང་བཀྲག་མདངས་མ་ཉམས་པར་བལྟ་ཆོག་གི་ཡོད།",
    "གློག་བརྙན་ལ་ལྟ་བ་དང་སྤང་ལྗོངས་སྟེང་གི་གཞོན་པ་ཚོའི་བྲོ་གཞས་ལོངས་སུ་སྤྱོད་པ་གཙོས་པའི་འཚོ་བ་སྐྱེལ་ཕྱོགས་བག་ཕེབས་པོ་བྱེད་ཅིང་།",
    "སྔར་གཞོན་པའི་སྐབས་བརྒྱུད་པའི་དཀའ་སྡུག་གི་ཉམས་མྱོང་སྣ་ཚོགས་ལས།",
    "མྱོང་བ་གསལ་བོས་མཐོང་བའི་རང་གི་མིག་མདུན་གྱི་བགྲོད་ལམ་ནམ་ཡང་ཐུགས་ཀྱིས་མི་གཏོང་།",
    "མི་ཡུལ་གྱི་དམ་པའི་སྐྱེས་བུ་ཞིག་གི་སྲོག་ཤིང་ཚུགས་ཏེ།",
    "དམ་པ་རེ་རེའི་གཡས་གཡོན་དང་མདུན་རྒྱབ་ཏུ།",
    "ཨ་ཙ་ར་དེ་དག་གི་དམིགས་ཡུལ་ནི་དམ་པ་གང་གི་མཛད་རྗེས་འོད་དུ་བརྒྱན་པ་མིན་པར།",
    "འབུ་སྲིན་ཕྲ་མོར་བརྫུས་པའི་རིགས་གང་གིས་ཀྱང་རྣམ་པར་གདུང་བའི་གནས་མེད།",
    "འཇིགས་མེད་ཕུན་ཚོགས་འབྱུང་གནས་ལྟ་བུའི་མཛངས་མི་རེ་རེ་ནི།",
    "རྨི་ལམ་གྱི་ཐུན་མཚམས་རེ་རེ་སྲུང་བའི་དཔའ་སྤོབས་ཀྱི་སྲུང་དམག་རེ་རེ་སྟེ།",
    "དམག་སྤྱི་ཡང་ཡིན་ལ་དམག་མི་ཡང་ཡིན་པའི་དཔྱོད་ལྡན་གྱི་སྲུང་དམག་དེ་དག་གིས།",
    "འཇིགས་མེད་ཕུན་ཚོགས་འབྱུང་གནས་མཆོག་གི་སྐུ་ཚེའི་མཛད་རིམ་གྱི་ལོ་ཚིགས་རགས་བསྡུས།",
    "པཎ་ཆེན་མཆོག་རང་གི་དགོངས་བཞེད་བཞིན།",
    "ལོ་མཇུག་གི་བོད་ཟླ་བཅུ་བར་ཕྱིར་སློབ་གླིང་དུ་འཁོད་དེ།",
    "ཨ་རི་གཙོས་པའི་རྒྱལ་ཁབ་ཆེན་མོ་ལྔ་ལྷག་ནང་ཕེབས་ཏེ།",
    "ཁྲིན་ཏུའུ་གྲོང་གི་སི་ཁྲོན།",
    "ཕྱོགས་གཞན་ཞིག་ནས་བོད་དུའང་ཆབ་སྲིད་ཀྱི་སིམ་འཛུལ་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "དེར་ང་ཚོས་ཚོད་དཔག་འདང་ངེས་དང་ངོས་འཛིན་གསལ་པོ་ཡོད་པའི་ཐོག་ནས་དོགས་ཟོན་ཆེར་སྐྱེད་ཀྱིས་ཁ་བྲལ་ལ་ངོ་རྒོལ་གྱི་འཐབ་རྩོད་དང་།",
    "རང་ལྗོངས་ཀྱི་དུས་བབ་བརྟན་ལྷིང་ཡོང་བར་ངེས་པར་དུ་བློ་ཐག་རྦད་བཅད་ཀྱིས་མང་ཚོགས་ལ་རྟེན་དགོས་པ་དེ་ནི་ང་ཚོའི་སྟོབས་ཤུཊ་ཀྱི་འབྱུང་ཁུངས་དང་རྒྱལ་ཁའི་རྩ་བ་རེད།",
    "ཕྱོགས་བསྡུས་བཅོས་སྐྱོང་བཅས་བྱས་ཏེ་དུས་ཟིང་གི་འབྱུང་རྐྱེན་རྣམས་མེ་ཆུང་ཐོག་ཏུ་གསོད་དགོས་པ་དང་།",
    "ལོ་ནས་ལོ་བར་རྒྱལ་ཡོངས་ཀྱི་བཟོ་ལས་དང་ཞིང་ལས་ཐོན་རྫས་རིན་ཐང་ལོ་རེའི་ཆ་སྙོམས་འཕར་ཚད་ཡིན་པ་དང་རང་ལྗོངས་སུ་ལས་ཟིན་མེད།",
    "ཞིང་ལས་ཐོན་རྫས་རིན་ཐང་རྒྱལ་ཡོངས་ཀྱི་ལོ་རེའི་ཆ་སྙོམས་ཐར་ཚད་ཡིན་པ་དང་བོད་ལ་ལས་ཟིན་མེད།",
    "གཅིག་ནི་ཏང་ཀྲུང་དབྱངས་དང་རྒྱལ་སྲིད་སྤྱི་ཁྱབ་ཁང་གི་ཡང་དག་པའི་འགོ་ཁྲིད་ཡོད་པ་དང་།",
    "བོད་ཀྱི་དངོས་ཡོད་གནས་ཚུལ་དང་བཟུང་འབྲེལ་བྱས་ཏེ་རང་ལྗོངས་ཀྱི་ལས་ཀའི་གཞི་རྩའི་མཛུབ་ཁྲིད་བསམ་བློ་དང་གཙོ་བོའི་ལས་འགན་གཏན་འཁེལ་བྱས་པ་བཅས་ནི་ང་ཚོའི་ལས་ཀ་ཁག་ལེགས་སྒྲུབ་ཐུབ་པའི་རྩ་བའི་འགན་སྲུང་ཡིན།",
    "མི་རེའི་ཆ་སྙོམས་ཀྱི་ས་ཁྱོན་ཅུང་ཆེ་བ།",
    "རྒྱལ་དམངས་ཀྱི་ཡོངས་འབབ་སྒོར་དུང་ཕྱུར་ལ་སླེབས་པ་བྱེད་རྒྱུ་དང་ལོ་རེའི་རིམ་འཕར་བྱུང་ཚད་ཡིན་པ།",
    "ཤ་རིགས་སྤྱིའི་ཐོན་འབོར་ཀྲོན་ཁྲི་ལ་སླེབས་པ་བྱ་རྒྱུ་དང་ལོ་རེའི་རིམ་འཕར་བྱུང་ཚད་ཡིན།",
    "ཞིང་འབྲོག་མི་དམངས་ཀྱི་མི་རེའི་ཆ་སྙོམས་ཡོང་འབབ་སྒོར་སླེབས་པ་བྱ་རྒྱུ་དང་།",
    "གོམ་པ་བརྟན་པོས་གོང་སྤེལ་གཏོང་བ་བཅས་ཀྱི་ཕྱོགས་སྟོན་བསམ་བློ་མཐའ་འཁྱོངས་དང་ངེས་པར་དུ་བློ་བརྟན་འགྱུར་མེད་ཀྱི་སྒོ་ནས་ཞིང་འབྲོག་ལས་རྨང་གཞིར་བྱེད་པ་དང་།",
    "ཏན་ཏིག་གི་སྒོ་ནས་ས་འོག་ཚ་ནུས་ཀྱི་ཐོན་འགོ་འབྱེད་པ།",
    "འགན་བབ་ལས་ཀའི་གཞི་ཁྱོན་རྒྱུན་ཆད་མེད་པར་ཆེ་རུ་གཏོང་བ་དང་།་",
    "ཚན་རིག་ཞིབ་འཇུག་གི་གྲུབ་འབྲས་སྣ་ཚོགས་རྒྱུ་ཁྱབ་ངང་བེད་སྤྱོད་གཏོང་བ།",
    "ལྗོངས་མི་དམངས་འཐུས་ཚོགས་ཀྱི་ཀྲུའུ་རེན་གཞོན་པ་ཟུར་པ།",
    "ཏང་གི་ལམ་ཕྱོགས་དང་།",
    "ང་ཚོས་མུ་མཐུད་ནས་འབད་བརྩོན་དང་།",
    "ང་ཚོའི་འགྲོ་ལམ་ནི་ཡངས་ཤིང་རྒྱ་ཆེ་བ་དང་།",
    "ང་ཚོའི་མདུན་ལམ་ནི་འོད་སྟོང་འཕྲོ་བ།",
    "ང་ཚོའི་བྱ་གཞག་ནི་རེ་བ་ཆེན་པོ་ཡོད་པ་བཅས་ཡིན་། སྤྱི་ལོ་ཟླ་པར།་",
    "ཏང་ཀྲུང་དབྱངས་དང་ཀྲུའུ་ཞི་མའོ་ཙེ་ཏུང་གིས་བོད་བཅིངས་འགྲོལ་གཏོང་རྒྱུར་དགོངས་བཞེས་ཧ་ཅང་གཟབ་ནན་གནང་ཡོད།",
    "བརྒྱུད་བོད་ཀྱི་བཅོས་བསྒྱུར་གྱི་ལས་དོན་ཁག་དང་འབྲེལ་བ་ཡོད་པ་ཞིག་ཡིན་ཕྱིན་རྦད་དེ་བོད་མི་ད་མངས་ཀྱི་འདོད་བློར་བསྟུན་དགོས་ཤིང་བོད་མི་དམངས་དང་བོད་ཀྱི་འགོ་ཁྲིད་དབར་གྲོས་མོལ་གྱི་ཐབས་ཤེས་སྤྱད་དེ་ཐག་གཅོད་བྱ་རྒྱུ།",
    "དང་པོ་ལོ་རབས་ལྔ་བཅུ་པའི་འཐབ་ཕྱོགས་གཅིག་གྱུར་དེར་བཙན་རྒོལ་རྒྱལ་གཅེས་ཀྱི་འཐབ་ཕྱོགས་གཅིག་གྱུར་ཞེས་བརྗོད་པ་དེའང་དུས་ཚོད་ངེས་ཅན་ཞིག་གི་ནང་མཐོ་རིམ་གྱི་འཐབ་ཕྱོགས་གཅིག་གྱུར་རེད།",
    "བཙན་རྒོལ་རྒྱལ་གཅེས་བྱ་རྒྱུ་ནི་འཐབ་ཕྱོགས་གཅིག་གྱུར་ནང་ཞུགས་མཁན་རིམ་གྲས་ཁག་ལ་བཏོན་པའི་ཐུན་མོང་གི་རེ་བ་ཡིན་ལ་མ་མཐའི་ཚད་གཞིའང་ཡིན་ཞེས་བརྗོད་ཚོག་ཐུན་མོང་གི་དགྲ་བོ་དང་ཐུན་མོང་གི་ཁེ་ཕན་མེད་ན་འཐབ་ཕྱོགས་གཅིག་གྱུར་ཀྱང་མེད།",
    "བོད་ཞི་བས་བཅིངས་འགྲོལ་གཏོང་བར་ངེས་པར་དུ་བཙན་རྒྱལ་རིང་ལུགས་ཀྱི་སྟོབས་ཤུགས་བོད་ནས་མཐར་སྐྲོད་གཏོང་དགོས་པས་བཙན་རྒྱལ་རིང་ལུགས་ཀྱི་སྟོབས་ཤུགས་དང་བཙན་རྒྱལ་རིང་ལུགས་དགའ་ཉེར་བསྟེན་མཁན་ནི་ང་ཚོའི་ཐུན་མོང་གི་དགྲ་བོ་ཡིན་པར་བརྟེན་ཀྲུང་གོ་མི་དམངས་བཅིངས་འགྲོལ་དམག་བོད་དུ་དཔུང་བསྐྱོད་བྱེད་དགོས་པ་མ་ཟད།་",
    "བཙན་རྒོལ་རྒྱལ་གཅེས་ཀྱི་འཐབ་ཕྱོགས་གཅིག་གྱུར་དེ་དུས་ཚོད་ངེས་ཅན་ཞིག་གི་ནང་མཐོ་རིམ་ལ་འཐབ་ཕྱོགས་གཅིག་གྱུར་བྱས་པ་ཞིག་རེད།",
    "མི་རིགས་དེ་རང་གི་ཁེ་ཕན་སྲུང་སྐྱོང་དང་།་",
    "བོད་རིགས་མི་དམངས་ཀྱི་ཚོས་དད་སྲུང་སྐྱོང་བྱེད་མྱོང་ཡོད་པས་མང་ཚོགས་ཀྱི་ཁྲོད་དུ་ང་ཐག་ཆགས་དང་སྙན་གྲགས་ངེས་ཅན་ཞིག་ལྡན་ཡོད་པ་དང་མང་ཚོགས་ཚོད་འཛིན་བྱེད་པའི་ནུས་པ་ཧ་ཅང་ཆེན་པོ་ལྡན་ཡོད་ལ་མང་ཚོགས་ཚོ་ད་དུང་གོ་རྟོགས་སད་མེད་པའམ་གོ་རྟོགས་ཧ་ཅང་དམའ་བའི་སྐབས་སུ་མཐོ་རིམ་རུ་ཚོགས་དེ་མང་ཚོགས་ཀྱིས་རང་ཕྱོགས་སུ་བརྩི་གི་ཡོད།་",
    "མཐོ་རིམ་པ་གང་ཞིག་ཡིན་རུང་ཀླད་རྙིང་མཁྲེགས་བཟུང་གི་བཙན་རྒྱལ་རིང་ལུགས་ཀྱི་རྒྱུག་ཁྱིའམ་ཡང་ན་དེ་ལས་ཆེ་བའི་ཇག་ཚོགས་དང་གསང་མྱུལ་མིན་ཚེ་ང་ཚོས་ཚང་མ་བརྩོན་ལེན་བྱེད་དགོས།",
    "བཙན་རྒྱལ་རིང་ལུགས་ཀྱིས་སྤྱོད་ཐུབ་པའི་ཐབས་ངན་ཐམས་ཅད་སྤྱད་ནས་ང་ཚོ་དང་བོད་ཀྱི་མཐོ་རིམ་པ་འཕྲོག་རེས་བྱེད་བཞིན་ཡོད་པས་ཚོས་ངེས་པར་དུ་ཧུར་བརྩོན་ཆེན་པོས་མཐོ་རིམ་གྱི་འཐབ་ཕྱོགས་གཅིག་གྱུར་",
    "སེར་གཙུག་ནང་བསྟན་དཔེ་རྙིང་འཚོལ་བསྡུ་ཕྱོགས་སྒྲིག་ཁང་གིས་བསྒྲིགས། ༩",
    "སེར་གཙུག་ནང་བསྟན་དཔེ་རྙིང་འཚོལ་བསྡུ་ཕྱོགས་སྒྲིག་ཁང་གིས་བསྒྲིགས། ༩",
    "ཉི་ཁྲི་རྣམ་འགྲེལ་ལྟར་ན་དྲུག་ཚན་དྲུག་གི་མཐོང་ལམ་རྩེ་སྦྱོར་དེ་ཉིད་འདིའི་སེངྒེ་རྣམ་བསྒྱིངས་ཀྱི་ཏིང་ངེ་འཛིན་ཡིན་ཏེ།",
    "མཐོང་ལམ་རྩེ་སྦྱོར་ཉིད་ལ་སྙོམས་པར་འཇུག་པ་ལ་སེང་གེ་རྣམ་བསྒྱིངས་ལ་སྙོམས་པར་འཇུག་པའི་མིང་གིས་བསྟན་པ་ཡིན་ཏེ།",
    "འདི་ལ་ཡང་མཉམ་གཞག་གིས་བསྡུས་པའི་མཐོང་ལམ་རྩེ་སྦྱོར་དང་།",
    "མཐོང་བའི་ལམ་ཐོབ་པའི་རྣལ་འབྱོར་པ་དེ་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པའི་འཇིགས་པ་མེད་པའི་ཕྱིར་ཏིང་ངེ་འཛིན་སེང་གེ་རྣམ་བསྒྱིངས་པ་ལ་ཞུགས་ནས།",
    "རོང་ཊིཀ་པ་ན་རེ།",
    "རང་གི་ཆ་ཤས་ལ་ལྟོས་ནས་གྲུབ་པ།",
    "རང་གི་རྒྱུར་གྱུར་པའི་རྐྱེན་གསུམ་ཀ་ལས་བྱུང་བ་གང་ཞིག།",
    "རང་གི་ཆ་ཤས་ལ་ལྟོས་ནས་གྲུབ་པ།",
    "རང་གི་ཆ་ཤས་ལ་ལྟོས་ནས་གྲུབ་པ།",
    "རང་གི་ཆ་ཤས་ལས་ལྟོས་ནས་གྲུབ་པ།",
    "རང་གི་ཆ་ཤས་ལ་ལྟོས་ནས་གྲུབ་པ།",
    "རྐྱེན་གཞན་ལ་རག་ལས་ཏེ་མ་འདྲེས་པར་འབྱུང་ཡང་རྐྱེན་དེ་དག་གི་བློ་སྔོན་དུ་བཏང་སྟེ་བྱེད་པ་མེད་པའི་ཕྱིར།",
    "སྐད་ཅིག་རེ་རེ་ལ་འཇིག་ཀྱང་གནས་པ་ལྟར་སྣང་བའི་ཕྱིར།",
    "རང་གི་རྒྱུ་ལས་འབྱུང་ཡང་བདག་གཞན་ལ་སོགས་པ་འབྱུང་ཚུལ་གྱི་མཐའ་བཞིའི་སྒོ་ནས་བརྟགས་ན་རྟོགས་པར་དཀའ་བའི་ཕྱིར།",
    "ལྷག་མ་དྲུག་གིས་མི་རྟག་པའི་དོན་བསྟན་པའི་ཕྱིར་རོ།",
    "ཁ་ཆེ་བྱེ་བྲག་སྨྲ་བ་ན་རེ།",
