    "དུས་རབས་བཅུ་དྲུག་བཅུ་བདུན་པར་བོད་ཡུལ་ལ་ཨ་ཙ་ར་མང་པོ་སླེབས་ཡོད་འདུག་ལ།",
    "ཞུ་ཆེན་སྒྱུར་བྱེད་མཆན་བུའི་གནས་འདུག་པའི།",
    "ང་རང་ཁྱེད་ཀྱི་ཆེས་མཐའ་མའི་སྲི་ཞུ་བར་བསྒྲུབ་པར་བྱ་བ་ཅི་ཞིག་ལུས་ཡོད་མེད་འདྲི་རུ་འོངས་པ་ལགས།",
    "ང་རང་ཁྱེད་ཀྱི་མེ་ཏོག་ལྡུམ་རའི་ལྡུམ་ར་བ་བྱེད་དུ་གཞུག་པར་འཚལ།",
    "ང་རང་ཁྱེད་ཀྱི་མེ་ཏོག་ལྡུམ་རའི་ལྡུམ་ར་བ་བྱེད་དུ་གཞུག་པར་མཛོད།",
    "ས་སྲོད་ཀྱི་སྐར་མ་ཡལ་ཞིང་གདའ།",
    "བདག་ལ་ཚེ་ཕྱི་མར་སྟོང་བསམ་བྱེད་ཁོམ་མི་གདའ་ལགས།་",
    "ང་རང་ཡུད་ཙམ་ལ་ཐེ་ཚོམ་ངང་བསྡད་རྗེས།",
    "ང་རང་ས་ཆ་འདིར་གཏན་དུ་བཏགས་ཡོད་པའང་།",
    "ང་རང་ཐོ་རངས་ཀྱི་བྱེའུ་ཁྱུ་དང་ལྷན་དུ་སད་པར་གྱུར།",
    "ང་རང་སྒེའུ་ཁུང་ཕྱེ་ཡོད་ཕ་དེའི་ཁ་རུ་བསྡད།",
    "ཁོ་རང་ངའི་སྒོ་ཁར་བསྡད་དེ།",
    "ཁོ་རང་ངའི་སྒོ་མདུན་ནས་བབས་ཏེ།",
    "ང་རང་སྒེའུ་ཁུང་འཁྲིས་སུ་བསྡད་དེ།",
    "ངའི་མིག་ལྕིབས་ཟུང་ཐུར་དུ་བབ་པར་གྱུར་ཙ་ན།",
    "ཁྱེད་ཀྱིས་སྒྲོན་མེ་བཏེགས་ཏེ་ཁོ་རང་ནང་ལ་འཁྲིད་པའི་ཚེ།",
    "མཁའ་དབུགས་ཀྱང་རླན་ནེ་རློན་ནེར་གྱུར་འདུགརྩྭ་རློན་གྱི་དྲི་མ་ལེ་ལོ་ཅན་དེ།",
    "ང་རང་སྤྱིལ་བུ་འདིའི་འགྲམ་དུ་ལངས་ནས་བསྡད།",
    "ང་རང་སྤྱིལ་བུ་འདིའི་འགྲམ་དུ་ལུས་པར་གྱུར།",
    "ང་རང་ཉིད་ཀྱི་འདོད་པའི་གཟུགས་བརྙན་ངའི་སེམས་ཁོང་ནས་ཐོན་ཏེ་བྲོ་གར་འཁྲབ་པར་བྱེད།",
    "དེས་ང་རང་རྨོངས་པར་བྱེད་ཅིང་འབྲིད་པར་བྱེད།",
    "བྱེའུ་ཚང་དག་ཀྱང་གཉིད་ཀྱིས་བཀབ་ནས་འདུག་ལ།",
    "ངའི་མིག་ལ་ནི་གང་ལྟར་སྨྱོ་མདངས་འདུག་གཞོན་ནུ་ལགས།",
    "ཁྱེད་ཀྱི་བཀའ་མཆིད་རབ་རིབ་ཅན་དུ་འདུག་པས།",
    "ཁྱེད་ཀྱི་བཀའ་མཆིད་རབ་རིབ་ཅན་དུ་འདུག་པས།",
    "ཁྱེད་ཀྱི་བཀའ་མཆིད་རབ་རིབ་ཅན་དུ་འདུག་པས།",
    "ཁྱེད་ཀྱི་བཀའ་མཆིད་རབ་རིབ་ཅན་དུ་འདུག་པས།",
    "བཙལ་བཙལ་བའི་མཐའ་མར་ང་རང་རྙེད་དུས།",
    "འཛུམ་པའི་འོད་མདངས་ཀྱིས་ང་རང་ལོང་བར་སྒྱུར་ཞིང་མཆི།",
    "ངས་ཁྱེད་རང་མི་ཚོགས་ལས་ལོགས་སུ་འགེར་མི་ཐུབ་པའི་སླད་དུ།",
    "ཁྱེད་རང་ཟུར་ཞིག་ཏུ་ལངས་ནས་སྡོད་ཅིང་མཆི་བའོ།",
    "ཁྱེད་རང་གཏན་དུ་ཁྱེད་བགྲོད་འདོད་པའི་ལམ་ཁ་དེ་ནས་བཞུད་པར་མི་བྱེད་དོ།",
    "ང་རང་མ་ཤི་གོང་དུ་འཆི་མེད་དངོས་གྲུབ་བསྩལ་དུ་གསོལ་དང་།",
    "ང་རང་ཁྱེད་ཀྱི་གན་དུ་འདུག་པའི་གནང་བ་བསྩལ་དུ་གསོལ།",
    "ཁྱེད་ཀྱི་སྤྱན་ཟུང་དུ་སོམ་ཉི་དང་བཅས་པའི་འཛུམ་མདངས་ཤིག་མངོན་ཞིང་གདའ།",
    "ངས་རྒྱུན་དུ་དེ་ལྟར་བྱས་པས་ཁྱེད་ཀྱིས་ང་རང་མགྱོགས་པོར་ལོག་འོང་ངེས་སྙམ་དུ་བསམས་ཡོད་ངེས།",
    "ངས་རང་ཉིད་ཀྱི་སྡུག་བསྔལ་ཇེ་ཡང་དུ་གཏོང་ཞིང་གདའ།",
    "ང་རང་ཁ་རོག་གེར་ཁྱེད་ཀྱི་དྲུང་དུ་ཙོག་པུར་བསྡད་འདོད་ནའང་།",
    "ངས་རང་ཉིད་ཀྱི་སྡུག་བསྔལ་ལ་དྲག་སྤྱོད་བྱེད་ཅིང་གདའ།",
    "ང་རང་ཁྱེད་ཀྱི་འགྲམ་ནས་ལངས་ཏེ་འདོང་བར་བསམས་ནའང་།",
    "རང་ཐཐབ་དང་རང་ཁྱིམ་དང་ཁ་བྲལ་ཏེ་དབེན་པའི་ནགས་ཚལ་དུ་གནས་པར་མི་འགྱུར་ལ།",
    "ད་ནི་དུས་ཚོད་ཀྱང་མང་བོ་ལྷག་མི་གདའ།",
    "གལ་སྲིད་ངས་ཁྱེད་རང་སྤྲོ་འཆམ་ལ་ཕེབས་དུས་སྐྲག་པར་བྱེད་ན།",
    "ང་རང་ཁྱེད་ཀྱི་དབེན་འཇགས་ཀྱི་ལྡུམ་ར་ལས་རྒྱང་རིང་ཞིག་ཏུ་གནས་ཀྱང་རིགས།",
    "ང་རང་ཁྱེད་ཀྱི་ཞིམ་པ་ཉིད་ཀྱི་འཆིང་བ་ལས་གྲོལ་བར་མཛོད།",
    "ཧ་ཅང་ངལ་བར་གྱུར་ཏེ་ང་རང་ཕྱིར་ལོག་པར་བྱས།",
    "༥༣ཁྱེད་ཀྱིས་ཅིའི་ཕྱིར་ངའི་ཕྱོགས་སུ་བལྟས་ཏེ་ང་རང་ཁ་སྐྱེངས་པར་བྱས་པ་ལགས།",
    "ཁྱེད་ཀྱིས་ཅིའི་ཕྱིར་ངའི་ཕྱོགས་སུ་བལྟས་ཏེ་ང་རང་ཁ་སྐྱེངས་པར་བྱས་པ་ལགས།",
    "ངས་ང་རང་མུན་ནག་ཏུ་ལངས་ཡོད་པ་ཁྱེད་ཀྱིས་མཐོང་ཡོད་མེད་ཇི་ལྟར་རྟོགས་པར་འགྱུར་རམ།",
    "ང་རང་རང་ཉིད་ཀྱི་བཤུལ་ལམ་བསྙེག་པར་བྱའོ།",
    "ང་རང་གཅེར་བུར་ཕུད།",
    "རང་ཉིད་ཀྱིས་རང་ཉིད་ཀྱི་ལེགས་སྐྱེས་ཅི་འདྲའི་མཛེས་པ་མཁྱེན་པར་གྱུར་མི་གདའ་ཞེས་སྨྲས།",
    "ཁྱེད་རང་ཁམས་བདེའམ།",
    "ཁྱེད་རང་ངེས་པར་དུ་བཞུད་དགོས་སམ།",
    "ང་འདིར་བསླེབས་དུས་ང་ལ་སྒྲོན་མེ་རྐང་གཅིག་ཀྱང་སྦར་ནས་བསྒུགས་མི་གདའ།",
    "ང་རང་རི་ཀླུང་གང་མང་བརྒལ་ཞིང་ས་མིང་མི་ཤེས་པའི་ཡུལ་ལུང་གང་མང་བརྒྱུད་པ་ལགས།",
    "ཕར་ཚུར་གྱི་གླ་ཆ་ཡང་སྤྲད་ཟིན་པས་ད་ནི་ང་རང་ཁྱིམ་ལ་ལོག་པའི་དུས་སྐབས་ལགས།",
    "ལམ་འགྲམ་གྱི་སྡོང་འོག་ཏུ་སྤྲང་བོ་དེ་ཙོག་པུར་གདའ།",
    "ང་རང་ལ་ད་དུང་མང་བོ་ཞིག་ལྷག་ཡོད།",
