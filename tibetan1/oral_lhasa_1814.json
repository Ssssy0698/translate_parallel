    "ཁ་ནས་ཐོན་པའི་སྐད་སྒྲ་དེ་ཡང་རྣམ་གྲངས་ངེས་པ་ཅན་དེ་ལས་འཕར་དུ་མེད་པར།",
    "སྒྲ་རིག་པ་ཞེས་པ་རྒྱ་གར་གྱི་སྒྲ་ཀ་ཙན་དབྱངས་གསུམ་དང་སྒྲ་པཱ་ཎི་ཎིས་གཙོས་པའི་བོད་ཀྱི་བརྡ་སྤྲོད་པའི་གཞུང་དང་བཅས་པར་གོ་བ།",
    "ཞེས་གསུངས་པས་གོ་ཡང་།",
    "རིག་པ་གཞན་དག་བར་གྱི་འབྲེལ་བ་སོགས་རྩལ་དུ་འདོན་པར་བྱེད་པས།",
    "དེ་དང་བརྡ་སྤྲོད་རིག་པ་གཉིས་ལ་ཁྱད་པར་ཨེ་ཡོད།",
    "མི་འགའ་སྡོད་སའི་ཡུལ་དུ་སྐད་ཆ་ཞིག་ངེས་པར་ཡོད་ཅིང་།",
    "ཤེས་བྱ་རིག་པའི་གནས་གང་ཞིག་ཡིན་ཡང་ངེས་པར་སྐད་ཆ་ལ་བརྟེན་ནས་ཉར་བར་བྱ་དགོས་པ་བཅས་ཀྱིས།",
    "བརྗོད་པའི་བརྡ་སྤྲོད་བཅས་དབྱེ་རྒྱུ་ཡོད་པར་མ་ཟད།",
    "སྐད་ཆ་རིག་པ་ནི་ཁོ་ལག་རྒྱ་ཆེ་བའི་རིག་པའི་གནས་གལ་ཆེན་པོ་ཞིག་ཡིན་པ་ཤེས་པར་བྱའོ།",
    "སྒྲའི་ཁམས་དང་འབྲེལ་བ་ཤིན་ཏུ་དམ་པར་གནས་པས།",
    "སེམས་ཁམས་རིག་པ་བཅས་ལ་འབྲེལ་བ་དམ་པོ་ཡོད་པར་མ་ཟད།",
    "བརྡ་ཆད་རིག་པ་བཅས་ནི་སྐད་ཆའི་རིག་པ་རྨང་དུ་བྱས་པའི་རིག་པའི་གནས་ཐ་དད་པ་ཡིན་པར་བརྟེན།",
    "ལྷག་པར་རང་བྱུང་ཚན་རིག་དང་ཧ་ཅང་ཉེ་བའི་རིག་གཞུང་ཁྱད་པར་བ་ཞིག་ཡིན་པས།",
    "སྐད་ཆ་རིག་པ་ནི་རིག་གཞུང་ཀུན་གྱི་སྣ་འདྲེན་པའི་རིག་པ་ཞིག་ཡིན་པར་སྨྲའོ།",
    "ཞིབ་སྡུར་སྐད་ཆ་རིག་པ་གཉིས་ལ་ཁྱད་པར་ཨེ་ཡོད།",
    "གལ་ཏེ་ཁྱད་པར་མེད་ན་དེ་གཉིས་སོ་སོར་བྱས་པ་ལ་དགོས་པ་མེད་སྙམ།",
    "ཞིབ་སྡུར་སྐད་ཆ་རིག་པས་ྗ་ནི་མཆེད་ཁུངས་ཀྱི་འབྲེལ་བ་མེད་པའི་སྐད་རིགས་གཉིས་ཡན་གྱི་མི་མཐུན་པའི་ཁྱད་པར་བསྡུར་བ་ལ་བརྟེན་ནས།",
    "སྐད་རིགས་ཐ་དད་པའི་བར་གྱི་མཚུངས་ཆ་དང་མི་མཐུན་པའི་ཁྱད་པར་རྟོགས་པར་བྱེད་པ་ལ་བརྟེན་ནས།",
    "རིག་པ་འདིའི་ཐོག་མའི་སྲོལ་འབྱེད་པར་གྱུར།",
    "ཧིན་ཡོའི་སྐད་ཆའི་མཆེད་ཁུངས་ལ་ཞིབ་འཇུག་བྱས་པའི་རྗེས་སུ།",
    "དེ་གཉིས་ལ་ཁྱད་པར་ཡོད་མེད་གསལ་བར་གསུངས་རོགས།",
    "རིག་པ་འདིའི་མིང་ཡང་དེ་མཐུན་དུ་བསྒྱུར་དགོས་པར་བཞེད་ཀྱང་།",
    "མི་རྣམས་ཀྱིས་སྐད་ཆ་ལ་ཕྱོགས་ཡོངས་ནས་ཞིབ་འཇུག་བྱས་ཏེ།",
    "སྤྱིར་བཏང་སྐད་ཆ་རིག་པའམ་གཞུང་ལུགས་སྐད་ཆ་རིག་པ་ཡིན་པར་ཤེས་སོ།",
    "དེ་གཉིས་ཀྱི་བསྟན་བྱ་ལ་ཁྱད་པར་ཡོད་པ་གང་ཡིན་གསལ་བར་གསུངས་རོགས།",
    "རིག་པ་རང་རྐྱ་ཕེར་པར་འཛིན་པ་མིན་ནོ།",
    "འགག་སྒྲ་དང་འཚེར་སྒྲ་སོགས་ཀྱི་ཁྱད་པར་བྱུང་བར་མ་ཟད།",
    "དེ་གཉིས་ཀྱི་ཁྱད་པར་གཙོ་བོ་ཕྱོགས་འདི་དག་ཏུ་འདུ་བ་སྟེ།",
    "དེ་ཡང་གནའ་བོའི་སྐད་ཆ་ཙམ་མ་ཡིན་པར་དེང་རབས་ཀྱི་སྐད་ཆའང་གཙིགས་སུ་འཛིན་པ་དང་།",
    "སྤྱི་མཐུན་གྱི་སྐད་ཆ་ཁོ་ན་མ་ཡིན་པར་ཡུལ་སྐད་ལུང་སྐད་ལའང་ཞིབ་འཇུག་བྱེད་པ་དང་།",
    "སྐད་ཆའི་ཟུར་ཞིག་ནས་ཕྱོགས་མང་པོར་དཔྱད་ཞིབ་བྱས་ཏེ།",
    "སྐད་ཆའི་སྦྱོར་བ་རྩིས་འགྲོས་ཅན་དུ་བྱས་ཚེ།",
    "མིའི་རིགས་རིག་པ་བཅས་ཀྱི་ཞིབ་འཇུག་ལ་རྒྱུ་ཆ་དང་བྱེད་ཐབས་མང་པོ་མཁོ་སྤྲོད་བྱས་ཤིང་།",
    "གཤིབ་སྡུར་ལྷ་སྒྲུང་རིག་པ།",
    "སུའེ་ཝེས་ཙེར་གྱི་སེམས་ཁམས་རིག་པའི་མཁས་པ་ཕི་ཨ་གེ་ཐ་ལོ་ལགས་ཀྱིས།",
    "འཇར་མན་པ་ཧུམ་པོལ་ཐུ་ནས་མགོ་ཚུགས་པར་བྱས་ན་ལོ་ངོ་ཆིག་བརྒྱ་བདུན་ཅུ་ཙམ་དང་།",
    "རིག་པ་འདིའི་བསྟན་བྱ་མང་པོ་སྔོན་བྱོན་མཁས་པའི་གསུང་ན་ཐར་ཐོར་མང་དུ་བཞུགས་པས།",
    "ཚོགས་གསུམ་གསལ་བ་སོགས་སུ་སཾ་བོད་ཀྱི་དབྱངས་གསལ་སྒྲ་གདངས་དང་བཅས་པ་གསལ་བར་བསྟན་པས་གཞིར་བྱས།",
    "ལྷག་པར་ཡི་གེའི་བཀླག་ཐབས་བྱིས་པ་བདེ་འཇུག་ཏུ།",
    "གཙང་པས་མས་འཕུལ་འས་འཕུལ་དུ།",
    "བརྡ་སྤྲོད་བཅས་གཙོར་བྱས་པའི་ཐ་སྙད་དང་།",
    "ཁྱད་པར་དུ་བརྡ་སྤྲོད་རིག་པའི་དཔྱད་འབྲས་ཕུན་སུམ་ཚོགས་ཀྱང་།",
    "ཆ་ཚང་བར་མེད་པ་རྣམས་ཅི་མི་སྙམ་པར་བཏང་སྙོམས་སུ་བཞག་པས།",
    "སྐད་ཆ་རིག་པའི་ཐབས་ལྟར་བོད་སྐད་ཀྱི་སྦྱོར་བ་གསལ་བར་བྱེད་པ་ལ་ད་དུང་འབད་པ་ཆེན་པོ་ཡུན་རིང་བསྟེན་པར་རིགས་སོ།",
    "ཡུལ་དེ་དག་ཏུ་ཡི་གེ་དར་ཡུན་ཤིན་ཏུ་རིང་ཞིང་ཡི་གེར་བཏབ་པའི་གླེགས་བམ་ཡང་གཏོས་ཆེ་བ་བཞུགས་པ།",
    "རྒྱ་གར་གྱི་བསྟན་བཅོས་ཡང་དག་པར་བསྒྱུར་བ།",
    "ཞེས་པས་གསལ་བར་གསུངས་པ་བཞིན།",
    "ཁྱད་པར་དུ་དེ་དག་ལས་སྒྲ་སྦྱོར་བམ་པོ་གཉིས་པ་ཞེས་པ་ནི།",
    "བརྡ་གསར་པ་དང་རྙིང་པའི་ཁྱད་པར་བསྡུར་པ།",
    "གཏན་ལ་འབེབས་པར་སྨོས་ཅི་འཚལ།",
    "ཅེས་པ་སོགས་མང་དུ་གསུངས་པ་བཞིན།",
    "དེ་ལྟར་མཛད་པར་ཕན་ནུས་ཅི་ཡོད།",
    "བཟོ་ཡི་རྣམ་འགྱུར་ལེགས་པར་བཅོས།",
    "གཙང་པས་དས་འཕུལ་ར་མགོ་རྣམས་སུ་ནོར།",
    "དེ་དག་ལ་གཟུགས་ཀྱི་སྒོ་ནས་ཁྱད་པར་འབྱེད་བྱེད་ཀྱི་མིང་དེ་དུས་སུ་སྦྱར་མེད་ཀྱང་།",
    "ས་སྔགས་ཡིན་པས་ཤེས་པར་བྱ།",
    "ས་མགོ་དག་པར་བྱེད་དགོས་ལ།",
    "ཞེས་གསུངས་པས་ཀྱང་ཤེས་ཤིང་།",
