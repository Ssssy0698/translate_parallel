    "མིང་གི་དང་པོ་དཀར་ནག་གི།",
    "ཁྱོ་ཤུགས་ཀྱི་མིང་ཡིག་དག་པར་བྲིས་པ་ལ་ཚེག་བར་དང་འབྲུ་གྲངས་སོ་སོར་བགྲངས།",
    "གཉིས་ཀྱིས་བུད་མེད་སྔོན་དུ་འཆི་བར་བརྗོད་དོ།",
    "རེའུ་མིག་གཞུང་བཞིན་འདི་ལྟར་བྱས་ཏེ།",
    "ཡི་གེ་འདི་རྣམས་ནི་དབྱངས་ཡིག་གི་དང་བོ་ཨ།",
    "པོ་ཡིན་པས་གཅིག་ཡིག་རེ་རེ་བརྒྱད་ཀྱིས་བསྒྱུར།",
    "བུད་མེད་ཀྱི་མིང་དེ་བཞིན་དུ་བྱས་ནས་དབྱངས་བསྲེས།",
    "འཆི་བའི་དུས་ཀྱང་མིང་གི་དང་པོར་དཀར་ཕྱོགས་ལ་འཆར་བའི་དབྱངས་རིང་བ་ལྔ་དང་།",
    "ཞེས་དོན་བསྡུ་བ་གསུངས་ཏེ་ཁ་ཅིག་དབྱངས་འཆར་ལས་ཀྱང་འབྱུང་མོད།",
    "འདིར་ནི་རྩིས་ཀྱི་རིག་པའི་གསང་གཟིགས་པས་༢༥ན་མཛད་པ་ཉིད་དོ།",
    "གང་ཚེ་ནང་གི་སྒྲ་གཅན་འཁྲུགས།",
    "ཅེས་ནང་གི་སྒྲ་གཅན་གྱི་ངོ་ལོན་དང་།",
    "འཁྲུགས་པ་དང་རེངས་པ་ལས་སྨྱོ་འབོག་དང་རྒྱལ་བ་ལ་སོགས་ཉེས་པ་སྣ་ཚོགས་བྱེད་ཅིང་མྱུར་དུ་སྲོག་ལ་རྒོལ་བར་འགྱུར་ལ།",
    "ལག་གཉིས་རྡོ་རྗེ་ཁུ་ཚུར་བསྣོལ་བས་མཆན་འོག་གི་འཕར་རྩ་རོ་རྐྱང་གི་ལམ་བསྡམ།",
    "གླང་གི་ཁྱིམ་དུ་མེ་ལྷ་བརྗོད།",
    "རྣལ་འབྱོར་མ་བརྒྱད་ནི་གསུང་གི་འཁོར་ལོའི་ལྷ་མོ་ཡིན་པས་དེའི་ཆོ་གས་གཏོར་མ་བྱ་ཞིང་།",
    "ཆུ་ཚོད་དྲུག་ཅུ་དང་ཆུ་སྲང་དྲུག་ཅུ་དང་དབུགས་ལ་འཆར་བ་ནི་རྡོ་རྗེའི་ཕོ་ཉ་མོ་དྲུག་ཅུ་རྩ་བཞི་ཡིན་པས་དེ་དག་གཏོར་མས་ཚིམ་པར་བྱའོ།",
    "པའི་ཕྱིར་ཀ་རྡོ་རྗེ་དང་ཀི་རྡོ་རྗེ་སོགས་ཚེས་ཀྱི་ལྷ་མོ་རྣམས་སོ་སོ་སྒོམ་ཞིང་གཏོར་མས་ཚིམ་པར་བྱས་ཏེ།",
    "རྟེན་ཅིང་འབྲེལ་འབྱུང་ཇི་བཞིན་གཟིགས་པའི་ཕྱིར།",
    "བདག་དང་བདག་གི་བས་སྟོང་པ།",
    "བཅས་པ་དབྱེར་མེད་དུ་སྦྱར་ཏེ་ཐམས་ཅད་ཀྱང་དེ་ཁོ་ན་ཉིད་ཕྱག་རྒྱ་ཆེན་པོ་རྡོ་རྗེའི་རྣལ་འབྱོར་དུ་མངོན་སུམ་དུ་སྟོན་པའི་དཔལ་དུས་ཀྱི་འཁོར་ལོའི་རྒྱུད་འགྲེལ་ཆེན་པོ་ལས་ཇི་ལྟར་གསུངས་པའི་རྩིས་ཀྱི་ཚུལ་ཆེན་པོ་རྣམས་གུད་དུ་ཕྱུང་ཞིང་མན་ངག་གིས་ཁ་བརྒྱན་ཏེ་ཕྱི་རབས་ལ་ཉེ་བར་མཁོ་བའི་གཞུང་དུ་དཔལ་རང་བྱུང་ཞབས་ཉིད་ཀྱིས་མཛད་པའི་དོན་ནོ།",
    "དེ་ལྟར་ཇི་བཞིན་པ་ཉིད་རྟོགས་པའི་ཕྱིར་འཁྲུལ་པ་མེད་མོད་ཀྱང་།",
    "ཅེས་རྡོ་རྗེའི་གཟུངས་ཆེན་པོ་གྲུབ་པའི་བདེན་པའི་ཚིག་གིས་བསྔོ་བར་མཛད་པའོ།",
    "ས་ཕོ་རྟའི་ལོ་དཔྱིད་ཟླ་ཐ་ཆུང་གི་ཡར་ཚེས་ལ་རྒྱལ་བའི་མིང་ཅན་བདག་གིས་བདེ་ཆེན་གྱི་རི་ཁྲོད་དུ་བྲིས་པའོ།",
    "ཕྱིས་རྩིས་ཀྱི་བསྟན་བཅོས་བྱེད་པོ་གཞན་མང་དུ་བྱུང་ཡང་བོད་ཡུལ་དུ་དུས་ཀྱི་འཁོར་ལོའི་ཐུན་མོང་མ་ཡིན་པའི་རྩིས་ཀྱི་གླེགས་བམ་གྱི་ཤིང་རྟའི་སྲོལ་འབྱེད་ནི་བསྟན་བཅོས་འདི་ཁོ་ན་ཡིན་མོད་ཀྱང་།",
    "དོན་དུ་གཉེར་བ་དག་གིས་ཀྱང་འཕྲལ་དུ་བསྐུལ་བའི་རྐྱེན་ལས་དཀའ་བའི་གནས་རྣམས་དཔྱིས་ཕྱིན་པར་གཏན་ལ་ཕབ།",
    "རི་མོ་ཞིབ་མོ་རྣམས་ཀྱང་ཇི་ལྟ་བར་ལག་ཏུ་བླངས་སྟེ་སྡོམ་ཚིག་ཏུ་བཀོད།",
    "མང་ཞིག་མཁས་པར་གྲགས་པའི་མིང་གིས་ཚིམ།",
    "དེ་བས་བདག་གིས་ཚུལ་འདིར་འབད་པ་ཡང་།",
    "རྣམ་པ་ཀུན་ལྡན་ངག་གི་མཆོག་འགྲུབ་པའི།",
    "མིང་ངམ་ནོར་རམ་སྡོད་ས་ཙམ་ཞིག་གིས།",
    "ཟབ་མོའི་ནང་དོན་དེར་ནི་བགྲོད་མི་ནུས།",
    "བདག་གིས་བཤེས་གཉེན་དུ་མའི་མན་ངག་དང་།",
    "། དཔལ་དུས་ཀྱི་འཁོར་ལོའི་མན་དག་རྩིས་ཀྱི་བསྟན་བཅོས་ཀུན་ལས་བཏུས་པའི་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ་བཞུགས་སོ།",
    "རྟོགས་པར་སླ་ཕྱིར་རེའུ་མིག་གི།",
    "ཀུན་དགའ་བོ་ང་ཡོངས་སུ་མྱ་ངན་ལས་རྩིས་ཀུན་བཏུས་ལས་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ།",
    "ཞེས་སྟོང་ཆིག་བརྒྱའི་བར་སོ་སོའི་འགྱུར་བ་དང་བཅས་པ་གསུངས་ཀྱང་དེ་ཕན་ཡུན་གྱི་ངེས་པ་མ་གསུངས་པས་རེ་ཞིག་འདི་ཡང་ལོ་སྟོང་དུ་གནས་པའི་ཕྱོགས་སུ་བསྡུའོ།",
    "དུས་རྣམ་དག་གི་ལོ་ཡི་ཚད་ནི་སྟོང་ཕྲག་ཉི་ཤུ་གཅིག་དང་དྲུག་བརྒྱ་དག་དང་བཅས་པ་སྟེ།",
    "རེ་རེ་དག་གི་ཚད་ནི་དུས་དང་མདའ་ཡིས་བསྒྱུར་བའི་མི་རྣམས་དག་གི་ལོ་བརྒྱ་གང་ཡིན་པའོ།",
    "རང་གི་རང་བཞིན་རྟག་ཏུ་གནས།",
    "གཞན་དུ་སོང་ནས་ཡང་དག་གནས།",
    "རྩིས་ཀུན་བཏུས་ལས་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ།",
    "རྒྱ་བོད་ཀྱི་བསྟན་པའི་བདག་པོ་པཎ་གྲུབ་ཕུལ་དུ་བྱུང་བ་དཔལ་དཱི་པཾ་ཞབས་ཀྱི་རེ་དྲུག་པ་མེ་ཕག་གི་ལོ་ལ་བསམ་ཡས་སུ་བོད་སྟོན་རྣམས་ཀྱིས་སྟོན་པ་འདས་ནས་ལོ་དུ་ཐལ་ཞུས་པས།",
    "སྟོན་པ་བྱི་བའི་ལོ་དབྱར་འབྲིང་གི་ཉ་ལ་ལྷུམས་སུ་གཤེགས་ནས་གླང་ལོ་དཔྱིད་འབྲིང་ལ་སྐུ་བལྟམས་ཏེ་ལོ་སོ་གཅིག་ཁྱིམ་པའི་ཚུལ་མཛད།",
    "ཆུ་འབྲུག་ལ་ཅོག་ལ་ཡུལ་གྱི་སྦེག་མཁར་དུ་སྟོད་སྨད་ཀྱི་ཡབ་མཆེད་གདན་འཛོམ་མོལ་བ་ཆེན་པོ་མཛད་གཏུམ་ཡུལ་ས་སྒང་གི་དབེན་ས་སར་དུ་བཙུགས་དུས་སུམ་སྟོང་བརྒྱ་ཉེར་ལྔ།",
    "འདི་ནི་བོད་ཡུལ་སྨད་སིལ་ཆད་ཀྱི་སྐབས་ཀྱི་བོད་བློན་ཞིག་གིས་བྲིས་པ་ལས་བཤུས་པར་སྣང་ལ་གོ་བ་ལ་ཕན་པར་འདུག་ཀྱང་བསྟན་རྩིས་ཞིབ་མོ་ལ་ཡིད་རྟོན་པར་དཀའ་སྟེ་བློན་པོ་དག་ཀྱང་འཇིག་རྟེན་གྱི་དཀྱིལ་ཆེ་བར་ཟད་ཀྱི་ཤེས་བྱ་ལ་མ་རྨོངས་པའི་བློ་གྲོས་ཡོད་པ་དཀའ་བའི་ཕྱིར་དང་ཇི་ལྟར་བྲིས་པ་དེ་དག་ལ་ཡང་དཔྱད་པའི་གཞི་དུ་མ་སྣང་བའི་ཕྱིར་རོ།",
    "རྒྱ་གར་ཤར་ཕྱོགས་ཀྱི་ཆ་རྒྱ་ནག་དང་ཉེ་བ་རྣམས་ན་རྒྱ་ནག་གི་སྲོལ་དར་བར་གྲགས་པ་དང་།",
    "ད་ལྟ་བོད་ན་༩ན་རབ་སྐྱེས་སོགས་ཀྱི་ལོ་མིང་ཚང་བར་བརྗོད་པ་ཕྱག་རྡོར་སྟོད་འགྲེལ་ཡིན་པ་སྤྱིར་འཆད་ལུགས་སེམས་འགྲེལ་བསྐོར་གསུམ་ག་དུས་འཁོར་དང་མཐུན་ཤས་ཆེ་མོད་ཀྱང་འདི་བདེ་མཆོག་རྩ་རྒྱུད་ཀྱི་སྟོད་ཀྱི་འགྲེལ་པ་ཡིན་པས་ཐ་སྙད་ཏུ་དུས་འཁོར་དུ་བསྡུ་མི་འོས་པའི་ཕྱིར་དེས་ན་འདི་ནི་འཇིག་རྟེན་ལ་གྲགས་པའི་ཐ་སྙད་ཅིག་སྔོན་ཡོད་པ་སྟོད་འགྲེལ་དུ་དེ་བརྗོད་པ་སྟེ་ཕྱི་རྒྱུད་དབྱངས་འཆར་གྱི་ལེའུ་དགུ་པར་ཡང་།",
    "རྩིས་ཀུན་བཏུས་ལས་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ།",
    "ཡང་སིངྒྷ་གླིང་གི་རྒྱལ་པོ་རིམ་བྱུང་དང་སིངྒྷ་གླིང་གི་དགྲ་བཅོམ་པའི་གསུང་དང་ཁ་ཆེ་པཎ་ཆེན་གྱི་དུས་འཁོར་གྱི་རྩིས་རྣམས་གུང་བསྒྲིགས་ནས་ཁྲོ་ཕུ་བས་བསྒྱུར་བ་ནི།",
    "བདག་གི་རྣམ་པར་རྟོག་པ་ལ།",
    "དེ་སྲས་རིགས་པའི་ཁུ་བྱུག་གིས།",
    "ཞེས་གསུངས་ལ་༡ཁ་འདི་པཎ་ཆེན་ཤིང་བྱི་ལ་བོད་ཏུ་ཕེབས་པའི་ལོ་གཉིས་པ་ཤིང་གླང་ལ་བརྩིས་པར་སྣང་ལ་ཡོངས་སུ་ཉིས་སྟོང་གྱ་གསུམ་སོང་ཁར་འདོད་དོ།",
    "ད་ནི་དུས་ཀྱི་འཁོར་ལོའི་ལུགས་ཐུན་མོང་མ་ཡིན་པ་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལ་རྒྱལ་བ་གཡུང་གིས་སྟོན་པ་ཤིང་བྱི་དབྱར་ར་ལ་བལྟམས་ཤིང་ཆུ་ལུག་ལ་འདས་ནས་ཉིས་སྟོང་བཞི་བརྒྱ་བཅུ་བདུན་སོང་བར་བཞེད་ལ།",
    "ཁ་ཅིག་ཐུབ་པ་མེ་རྟའི་ལོ་པ་གྱ་གཉིས་མེ་ཡོས་ལ་འདས་ནས་ཉིས་སྟོང་སུམ་བརྒྱ་དོན་གསུམ་སོང་བར་ཡང་འདོད་དོ།",
    "གཏན་རྩིས་འདི་འཇོག་ཚེ་རམ་ཤིང་གི་བུ་ས་ག་ཏ་སིདྷ་སྟེ་སྟོབས་ཀྱི་སེང་གེ་ཡོད།",
    "ཨུ་རྒྱན་གཏན་རྩིས་ནས་ཆུ་ཁྱིའི་བར་ལ་ལོ་ཉིས་བརྒྱ་དང་བརྒྱད་བཅུ་སོང་འདུག་པས་མགོན་པོའི་རྒྱུད་ཀྱི་ལུང་བསྟན་དེ་བྱུང་ཟིན་པའམ་དེ་ཙམ་ཡོང་དགོས་པར་སྣང་ངོ།",
    "དེ་ནས་སྲོང་བཙན་འཁྲུངས་རྩིས་ཀུན་བཏུས་ལས་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ།",
    "དེ་ནས་དྲུག་ཅུ་སྐོར་གཅིག་གི་མེ་ཁྱི་ལ་དེབ་དམར་བྲིས་ཞེས་སྣང་ཡང་དེ་ལྟར་ན་སྲོང་བཙན་གྱི་འཁྲུངས་ལོ་དྲུག་བཅུ་སྐོར་ཉེར་གཉིས་པའི་ང་དྲུག་པ་ཆུ་ཕག་ལ་འགྲིག་པ་དང་།",
    "མང་སྲོང་གི་རྒྱལ་ས་ལོ་བཅོ་ལྔ།",
    "འདུས་སྲོང་གི་ཉེར་དགུ།",
    "ཁྲི་སྲོང་གི་ཞེ་བཞི།",
    "པཎ་ཆེན་ཤིང་བྱི་ལ་བོད་ཏུ་ཕེབས་པས་དེ་དང་མེ་ཡོས་ཀྱི་བར་དུ་ལོ་གཉིས་ཀྱིས་ཆོད་མོད་ཀྱང་བསྟན་པའི་གནས་ཚད་སོགས་ནི་རགས་པ་ལུང་སྟོན་པའི་སྐབས་ཡིན་པས་ཞིབ་མོར་རྩི་བ་དང་མ་མཐུན་པ་སྐྱོན་མ་ཡིན་རྩིས་ཀུན་བཏུས་ལས་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ།",
    "འདས་ལོའི་གྲངས་འཁྲུལ་སེལ་བ་ལྟར་དྲུག་ཅུ་སྐོར་ལྔས་མང་བ་ཉིས་སྟོང་བརྒྱད་བརྒྱ་བདུན་ཅུ་སོང་བར་མཛད་དོ།",
    "དེ་ལ་འདས་ལོ་བཞི་སྟོང་དང་སུམ་སྟོང་ལྷག་པ་སོང་བར་འདོད་པའང་དུས་འཁོར་གྱི་ལུགས་འདིར་ནི་མི་ལེགས་ཏེ་དེ་ལྟ་ན་འཛམ་གླིང་འདིར་དྲག་པོ་འཁོར་ལོ་ཅན་གྱི་དུས་བཞི་ཡང་འདས་ཟིན་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེ་གཉིས་ཀྱི་དངོས་སློབ་སྨར་རྩིས་ཀུན་བཏུས་ལས་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ།",
    "ཁྲོ་བོ་ཤིང་མོ་གླང་ལོ་ལ།",
    "དེ་ལ་དྲུག་གིས་སྦྱངས་པ་ནི།",
    "སྐྱུར་བྱེད་ས་མོ་ཕག་ལོ་ལ།",
    "དེ་ལྟར་དྷུ་ཝ་ཡར་ལོག་དུ་བརྩིས་པས་ཁྲོ་བོ་ཞེས་བྱ་བ་ཤིང་མོ་གླང་ལོ་ལ་སྟོན་པ་སྐུ་བལྟམས་པར་མངོན་ནོ།",
    "ཁྱིམ་ནས་འབྱུང་ཀའི་ཚེ་སྐར་མ་རྒྱལ་ཡང་ཤར་བར་གཟིགས་ཏེ་ཞེས་པས་འདིར་རྒྱལ་དང་ལྡན་པ་ཡང་ཤར་བའི་དུས་ཡིན་པར་ཐོབ་བོ།",
    "འདྲེན་པ་ཁྱོད་ནི་རྒྱལ་ལ་སྐྱེས།",
    "ཞེས་པའི་རྒྱུད་ཚིག་གསུངས་པ་ཕྱིན་རི་མོར་རྩི་བ་དུས་འཁོར་གྱི་ཐུན་མོང་མ་ཡིན་པའི་ལུགས་ནག་པས་ལོ་མགོ་བཟུང་བ་གཉིས་སུ་འགྱུར་བ་ཡིན་ནོ།",
    "རྒྱུ་སྐར་གྱི་དང་པོར་དྲང་སྲོང་རྔ་བོང་གིས་བཞག་པའི་ཕྱིར་སྨིན་དྲུག་གི་ཟླ་བ་དང་པོར་བྱེད་ལ་དེ་ལ་བཅུ་པ་སྨིན་དྲུག་གིས་མཚན་སྐྱེལ་བ་སྨིན་དྲུག་གི་ཟླ་བར་བརྗོད་པ་ཡོངས་གྲགས་ཀྱི་ལུགས་དང་།",
    "ཐ་རྩིས་ཀུན་བཏུས་ལས་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ།",
    "ཉི་མ་སྐར་མ་ལྷ་མཚམས་གདོངས་མིག་དམར་དང་འགྲོགས་པ་སྟེ་གཟེར་ལྔ་ཡོད་ན་སྨིན་ཟླ་ཡིན་པས་ཧོར་ཟླ་བ་བརྒྱད་པའི་བཅུ་དྲུག་ནས་དགུ་པའི་བཅོ་ལྔའི་བར་སྨིན་དྲུག་གི་ཟླ་བའོ་ཞེས་དྭགས་པོ་པཎ་ཆེན་པའི་ལུགས་ཏེ་གཉིས་དང་།",
    "དེང་སང་གི་བོད་ཡུལ་ན་ཧོར་ཟླ་གཉིས་པ་ལ་དབོ་ཟླར་བྱེད་པ་སྟེ་ལུགས་གཉིས་དང་།",
    "ཧོར་ཇིང་གི་རྒྱལ་པོས་རྒྱལ་ས་ཐོབ་ནས་ཟླ་བ་དེ་དང་པོར་བཀར་བཏགས་པ་ཧོར་གྱི་ལུགས་དང་།",
    "རྒྱ་ནག་གི་ལི་ཐུ་པར་མར་དང་པོ་ལ་སྟག་ཟླ་དང་དཔྱིད་རར་བྱས་པར་གྲགས་པས་དེ་ལྟ་ན་ཧོར་དང་རྒྱ་ནག་ཕྱི་མ་འདི་ལོ་མགོ་མཚུངས་པ་དང་།",
    "རྗེ་དེ་བཞིན་གཤེགས་པ་དང་ཏའི་མིང་རྒྱལ་པོ་མཆོད་ཡོན་མཇལ་བའི་ཡི་གེར་ཧོར་ཟླ་གཉིས་པ་ལ་ལོ་སར་མཛད་ཚུལ་རྒྱས་པར་སྣང་བས་དེ་ལྟ་ན་ད་ལྟའི་རྒྱ་ནག་གི་ལོ་མགོ་ཧོར་ཟླ་གཉིས་པ་ནས་འཛིན་པར་ངེས་པ་སྟེ་ལུགས་ཐ་དད་པ་རྣམས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "སིང་མ་མེ་རྩིས་ཀུན་བཏུས་ལས་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ།",
    "མཛད་པ་འཁྲུལ་མེད་པས་ཞག་ཞེ་དགུ་འདས་ན་ཞེས་པའི་ལུང་གིས་ཚེས་ལྔ་ལ་འདོད།",
    "ས་དཀར་རྩིས་ཀུན་བཏུས་ལས་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ།",
    "སྐྱེས་མཆོག་ལོ་རེ་ལོ་རེ་བཞུགས།",
    "འབར་བའི་ཕུག་གི་གནས་སུ་ལྔ།",
    "བདག་ཅག་གི་སྟོན་པ་ཤཱཀྱ་ཐུབ་པ་ནི་ལོ་བརྒྱད་ཅུ་བཞུགས་པ་ལ།",
    "ལྔ་པ་བེ་ཤཱ་ལྱཾ་མོ།",
    "བདུན་པ་སུམ་བཅུ་རྩ་གསུམ་ལྷ་རུ་རྡོ་ཨར་མོ་ནིག་དུའོ།",
    "བརྒྱད་པ་སུ་ཤུ་མཱ་ར་གི་རིར་རོ།",
    "ཞེས་བརྒྱད་བཅུ་པོ་རེ་རེ་ནས་བགྲངས་པའི་ཕྱིར་དང་།",
    "འདིར་དབྱར་གནས་པར་གསུངས་པ་རྣམས་ཀྱང་དབྱར་དགག་གི་བསླབ་པ་མ་བཅས་ཀྱི་བར་དུ་དབྱར་བཞུགས་ཙམ་ལ་དེའི་མིང་གིས་བསྟན་པ་ཡིན་གྱི་གཞི་གསུམ་གྱི་ཟླས་ཕྱེ་བའི་དབྱར་གནས་དངོས་མ་ཡིན་ནོ།",
    "དེ་ནས་རིགས་ལྡན་རྒྱལ་དཀའི་གྱ་གཉིས་འདས་པ་མེ་ཁྱི་ལ་བྱེད་པའི་རྩིས་ཕྱག་ལེན་དུ་རྩིས་ཀུན་བཏུས་ལས་འདས་ལོའི་རེའུ་མིག་གསལ་བར་བྱེད་པ་བཀླགས་པས་གྲུབ་པ་ཆེན་པོ།",
    "རྔོག་ལུགས་ལྟར་ན་རྗེ་མར་པའི་དགུང་ལོ་ཉེར་བརྒྱད་པ་ཡིན་ལ་དེ་ནས་ད་ལྟའི་ཆུ་ཕོ་ཁྱི་ཡན་ལ་ལྔ་བརྒྱ་དང་སོ་ལྔ་སྟེ་དྲུག་བཅུ་སྐོར་བརྒྱ་དང་ལོ་རྐྱང་ང་ལྔ་སོང་བ་ནི་སྐབས་འདིར་རང་ལུགས་སོ།",
    "འོ་ན་ད་ལྟ་སྒྲུབ་པའི་དུས་ཀྱི་ལྔ་བརྒྱ་པ་དབུས་མར་ཐལ་ཏེ་ལྔ་བརྒྱ་པ་ཕྲག་བཞི་འདས་ཤིང་ལྔ་པ་ལ་སྤྱོད་པའི་ཕྱིར།",
    "གལ་ཏེ་རྒྱུ་ཚོགས་གྲངས་ཚང་ན་དེ་སྙེད་གནས་མོད་ཀྱང་རེས་རྒྱལ་བའི་ཕྲིན་ལས་དང་རེས་བདུད་ཀྱི་ལས་མང་པོས་ལྔ་བརྒྱ་བ་རེ་རེ་ཡང་དུས་ཐུང་ངུས་རྫོགས་པ་སྟེ།",
    "སྐྱོབ་པ་འཇིག་རྟེན་མགོན་པོས་དུས་ཀྱི་འཕེལ་འགྲིབ་ནི་ད་ལྟར་ཡང་བྱར་ཡོད་ཅེས་གསུངས་པ་ཁོ་ན་ལྟར་ཏེ་སྤྱིར་མར་འགྲིབ་ལ་ལོ་སྟོང་ཕྲག་རེ་ན་ལོ་རེ་༡༨ཁ་འབྲི་བྱ་བ་སོགས་ཟེར་ཡང་ཁུངས་སུ་རུང་བ་མ་མཐོང་ལ།",
    "བདུད་ཀྱི་ལས་རྒྱ་ཆེར་འཕེལ་བའི་ཕྱིར་ལྔ་བརྒྱ་པ་རྣམས་ཀྱང་དུས་ཐུང་ངུས་བདུད་ལས་ཀྱིས་བཟླུམས་པ་དང་ཡང་སྐྱེས་བུ་དམ་པ་རེ་རེས་འགྲོ་བ་དཔག་མེད་སྨིན་གྲོལ་དུ་བྱས་པ་ན་གདུལ་བྱ་ཐུལ་བའི་ཕྱིར་དུས་ཐུང་ངུས་ཀྱང་བསྟན་པ་ཡུན་རིང་པོར་གནས་པའི་བྱ་བ་བྱེད་པ་དཀར་པོའི་ལས་ཀྱིས་བཟླུམས་པར་ཟད་དོ།",
    "རྒྱལ་ཁམས་རེ་ཙམ་དུ་ཅུང་ཟད་འཕེལ་བ་ནི་ལོས་ཡོང་མོད་ཀྱང་བསྟན་པའི་གནས་ཚད་ལ་ཕན་པ་འཛམ་གླིང་ཁྱབ་པར་བདལ་ནུས་པ་ནི་དཀོན་པར་མཐོང་ལ།",
    "ཁོང་ཁྲོ་གཅིག་གིས་འཇོམས་པར་བྱེད།",
    "ལྟ་བུ་སོགས་དགེ་མི་དགེ་མཐུ་ཅན་རེས་དུས་མང་པོ་བཟླུམས་པ་འདིའི་རིགས་པ་བསྟན་པ་ལའང་ཤིན་ཏུ་འབྱོར་སྙམ་མོ།",
    "དེ་ལྟ་མོད་ཀྱི་བསྟན་པ་གནས་པ་ནི་སྨོན་པའི་ཡང་གཞི་ཡིན་པས་བདག་གིས་ཀྱང་བོད་ཕལ་གྱི་རྗེས་སུ་འབྲངས་སྟེ་ད་ལྟ་ལུང་གི་དབུས་མར་བརྗོད་མོད།",
    "མཆོག་གི་གྲུབ་ཐོབ་ཏུ་འདོད་པ་རྣམས་ལའང་ཐ་ན་འདོད་པ་ལས་བློ་ལོག་པའི་ཡོན་ཏན་མུ་སྟེགས་པའི་ཆགས་བྲལ་ཙམ་ཡང་མི་སྣང་ན།",
    "རྩོད་པ་རྒྱལ་བའང་ཕ་རོལ་གྱི་དམ་བཅའ་ངན་པ་ལུང་རིགས་ཀྱིས་གཞིགས་ནས་སྨྲར་མེད་པ་ཡིན་མོད་ཀྱི་དེང་སང་འཁོར་གསུམ་སོང་བས་རྩོད་པ་རྒྱལ་བའི་ཚད་དུ་བྱེད་པ་འདི་ནི་རྩོད་པ་གཟུགས་བརྙན་དུ་སོན་པ་ཡིན་ནོ།",
    "དོན་དམ་རྟོགས་ཟེར་ཉོན་མོངས་དངོས་མཛིན་རགས།",
