    "ད་ནི་དབྱངས་ནི་ཞེས་པལ་སོགས་པས་དབྱངས་རྣམས་ཀྱིསྐྱེ་བའི་གནས་ལ་སོགས་པ་བསྡུས་པའི་ཚིགས་སུ་བཅད་པ་དགུ་པ་བདག་གིས་དགྲོལ་བར་བྱའོ།",
    "མགྲིན་རྐན་སྟེང་གི་ཆ་ཇི་ལྟར་གྱུར་པ་ཞེན།",
    "མཆུ་དང་སོ་ནི་ཆུ་དང་ས་དག་གི་སྐྱེ་བའི་གནས་སུ་ཨ་ཡིག་ལ་སོགས་པ་རྣམས་གྲངས་ཇིལྟ་བབཞིན་དུ་སྐྱ་བསྟེ།",
    "མིམཉམ་པའི་ཕྱིར་རོ། ལྟར་འཇིག་རྟེན་གྱི་ཁམས་ཀྱི་ཚད་ཀུན་རྫོབ་ཏུ་ཇིལྟ་བ་དེ་ལྟར་འགྱུར་དུ་ཆུག་མོད།",
    "གང་གི་ཕྱིར་འཇིག་རྟེན་གྱི་ཁམས་ལ་ཡུལ་ལ་མཛོད་ཀྱི་འདོད་པ་དང་།",
    "ཚངས་པའི་ཡུལ་ས་གཅིག་ནི་དཔག་ཚད་བྱེ་བའི་ཁྱོན་ནོ།",
    "ལུསལ་དཔྲལ་བར་མཐའནས་གཙུག་ཏོར་གྱི་གནས་ཀྱི་བར་དུ་སོར་དྲུག་གི་ཚད་དོ།",
    "དེབཞིན་དུ་ལྷོནས་བྱང་གི་མཐའ་བར་རོ།",
    "གང་གིས་འདི་བརྗོད་པར་བྱ་བ་ལྷུན་པོགཞན་ཡང་ཡོད་དམཅི་ཞེན།",
    "འདིར་མནྡར་ཡང་ལྷུན་པོའི་མིང་གིས་སྨོས་པ་དེས་ནམནྜ་ར་ལས་ཐ་དད་དུ་བྱ་བའི་སླད་དུ་ཚིག་འདི་རིགས་སོ།",
    "ཆ་དྲུག་ལ་ནི་འབུམ་ཕྲག་གཉིས་གཉིས་ཞེས་པ་ནིའདིར་བརྗོད་པའི་། རིམ་པས་འོག་དང་སྟེང་དང་ཤར་དང་ནུབ་དང་ལྷོ་དར་བྱང་གི་ཆ་དྲུག་ལ་སའི་དཀྱིལ་འཁོར་གྱི་དབུས་ནས་འབུམ་ཕྲག་གཉིས་གཉིས་སོ།",
    "དེ་ནིས་ཡི་སྟེང་གི་གནས་སུ་ལུས་ལ་རང་རང་དག་གི་ཚད་ཀྱི་ཡང་དག་ཁྲུགང་ངོ།",
    "པྲཱ་མོ་འདི་བརྒྱུད་རྣམས་ཀྱིས་མི་རྣམས་ཀྱི་སྐྲའི་རྩེ་མོར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་ཚངས་པ་འཇིག་རྟེན་ལས་འདས་པ་ཟུང་ནི་ཟུང་དང་ལྡན་པ་དག་སྣའི་གནས་ཏེ་བུདབརམེ།",
    "ཨ་ཡིགལ་སོགས་པ་སྲིད་པ་སུམ་ཅུ་རྩ་གཅིག་པོ་འདི་དག་གི་སྲིད་པ་གསུམ་སྟེ།",
    "གཟུགས་མེད་པལ་སོགས་པ་འདི་རྣམས་ཀྱི་མང་གི་སྔགས་ཨ་ཡིག་ལ་སོགས་པ་རྣམས་བརྗོད་པའི་རིམ་པས་གྲངས་བཞིན་ནོ།",
    "དེ་ལྟར་སྲིད་པ་སུམ་ཅུ་རྩ་གཅིག་གིས་སྲིད་པ་གསུམམོ་ཞེས་པའི་དོན་ཏོ།",
    "ལོབརྒྱན་སྐྲའི་རྩེ་མོ་རེ་རེ་ཕྱར་བས་གད་གི་ཚེ་སྟོད་བར་གྱུར་པ་དེའི་ཚེ་བསྐལ་པ་ཆུང་ངུའི་ཉིན་ཞག་གཅིག་གོ།",
    "མཆོག་གི་བསྐལཔའོ།",
    "ལྷོ་རུ་མེའི་དཀྱིལ་འཁོར་གྱི་རང་བཞིན་གྱིས་གྲུ་གསུམ་མོ།",
    "ལྷུན་པོ་ཡི་ནི་སྟེང་གི་རྒྱ་ཤར་དང་ནུབ་དང་བྱང་དང་ལྷོ་འ་ཆའི་བར་དུ་སྟོང་ཕྲག་ལྔ་བཅུའོ།",
    "སགཞི་དག་གི་གནས་ལ་རྒྱ་ར་སྟོང་ཕྲག་བཅུ་དྲུག་གོསྟོང་ཕྲག་གཅིག་ནི་ཁོན་ཡུག་དག་གི་ཡང་དག་པའི་ཞེང་ངོ།",
    "ཆུ་གཏེར་དྲུག་པོ་ཐམས་ཅད་ཀྱང་ཟ་བ་ཟླ་བ་གཅིག་གི་དམན་པའི་སྟོང་ཕྲག་རེ་རེ་སྟེ་ཞེས་པ་ནི་རྒྱ་མཚོ་དྲུགས།",
    "དཉིད་ཞིབ་མོར་ནི་སྟོང་ཕྲག་བཅུ་དྲུག་ལས་བཅོ་བརྒྱད་ཀྱིས་ཐོབ་པའི་ཆས་གསལ་བར་འགྱུར་རོ།",
    "དཔག་ཚད་སྟོང་ཕྲག་དགུའི་ཕྱི་རོལ་དཔག་ཚད་སྟོད་ཕྲག་བཅུ་དྲུག་གི་བར་དུ་གླིང་དྲུག་ལ་སོགས་པ་རྣམས་གནས་སོ།",
    "བྱང་གི་སྒྲ་མི་སྙན་དང་།",
    "ཤར་དུ་བརྒྱ་བྱིན་ནི་ལྷན་པོའི་སྟེང་གི་ཤར་ཕྱོགས་སུ་བརྒྱ་བྱིན་ནོ།",
    "སྟེང་གི་ཆར་ཚངས་པའོ།",
    "རོ་བརྒྱཞེས་པ་དྲུག་བརྒྱ་ལྷག་པའི་སྟོང་ཕྲག་ཉི་ཤུམ་གཅིག་གིསཚད་དང་འགྱུར་རོ།",
    "ནག་ཀྲོར་ཕྱོགས་ཉིན་མོ་དང་དཀར་བོའི་ཕྱོགས་མཚན་མོ་ནི་ཡི་དགས་པ་མེས་ལ་སོགས་པ་རྣམས་ཀྱི་རང་གི་ཉིན་ཞག་གོ།",
    "ནུས་པའི་དབུགས་དང་མི་རྣམས་ཀྱི་ལོ་བརྒྱ་ཕྲག་བཅོ་བརྒྱད་བཅོ་བརྒྱད་ཀྱི་རེ་རེ་བགྲོད་དེ།",
    "ཆུ་ཚོདནི་དྲུག་བརྒྱ་ལྷག་པའི་སྟོང་ཕྲག་ཉི་ཤུ་རྟ་གཅིག་གི་གྲངས་སོ།",
    "རུས་དྲུག་གིས་ཉིན་ཞག་དང་ལོར་འགྱུར་རོ།",
    "ད་ལྟ་དན་ལུས་སྐྱེས་ལ་སོགས་པ་རྣམས་ཀྱི་དདརང་གི་ཚད་ཀྱི་དབུགས་ཉི་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱས།",
    "དབུགས་གཅིག་གིས་ཆུ་ཚོད་དུ་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་དཀྱིལ་འཁོར་ལྔ་ལ་གཟའ་ཐམས་ཅད་རང་རང་གི་སྐྱེ་བའི་གནས་སྟོང་པ་ལ་འཇུག་གོ།",
    "ལོ་དེནས་ལོདྲུག་བརྒྱ་ན་ཆུ་བོ་ཤཱི་ཏའི་བྱང་ཤམྦྷལ་ཞེས་བྱ་བའི་ཡུལ་དུ་གྲགས་པ་ཞེས་པ་ནི་ལུང་གི་བརྗོད་པ་སྟེ།",
    "ཀླ་ཀློ་དེའི་དུས་སུ་འཛིནམ་ལ་ནི་ཉུང་ངུའི་བྱེད་པ་གསལ་བར་མི་རྣམས་དག་གིས་རིག་པར་བྱའོ།",
    "གང་གི་ཕྱིར་གྲུབ་པའི་མཐའ་རྣམས་རྣམ་པར་ཉམས་ཞེས་པའི་ཚིག་ཟུར་གྱི་ཕྱིར་རོ།",
    "ཞི་མའི་ལོངས་སྤྱོད་མ་དག་པ་ཉིད་ཀྱི་ཕྱིར་དེ་དག་གི་ལོངས་སྤྱོད་ཀྱང་མ་དག་གོ།",
    "འདིར་གྲུབ་པའི་མཐའ་ལ་གཟའ་རྣམས་ཀྱིས་བགྲོད་པ་བུད་མེད་དང་བྱིས་པ་རྣམས་ཀྱིས་བསྒྲབ་པོར་བྱ་བ་ཡིནན་བྱིས་པའི་སྐྱ་བ་ལ་སོགས་པ་དེ་དག་རྣམས་ཀྱིས་གཟའ་མྱུར་ངུ་ཤེས་པར་འགྱུར་རོ།",
    "དེས་ན་ཕྲགདོག་གི་ཆལ་སསྐྱེས་པའི་མུ་སྟེགས་གདུག་པ་རྣམས་ཀྱིས་གལ་ཏེ་བུད་མེད་དང་བྱིས་པལ་སོགས་པ་ཐམས་ཅད་ཀྱིས་གཟའི་རྒྱུབ་ཤེས་པར་གྱུར་པ་དེ་ལྟ་ན།",
    "གང་གིས་བྱིས་པའི་སྐྱེ་བོ་རྣམས་ཀྱིས་མི་བཟད་པར་མཐོང་ནས་རིང་དུའབྲོས་པར་བྱེད་ཅིང་སྐར་རྩིས་༣ ཀྱི་སྲིད་མི་བྱེད་པར་འགྱུར་བརྒྱད་ལ་ཉིན་ཞག་གི་ཚོགས་ཀྱི་ཕུང་པོ་དུ་མ་དང་།",
    "ར་ཧཱ་སྐུཎའི་འཇུག་པ་ཀླ་ཀློའི་ཚེས་སྟོན་པ་པོ་ཀླ་ཀློ་སྟག་གཟིག་རྣམས་ཀྱི་བྲམ་དང་རྗེ་བའོ།",
