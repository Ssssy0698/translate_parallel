    "དནི་བཀྲ་ཤིས་ལ་སོགས་པ་རྣམས་རྒྱུ་སྐར་ལ་ལོངས་སྤྱོད་པའི་དོན་དུ་ཉིན་ཞག་གི་ཆོ་གས་གསུངས་པ།",
    "བརྒྱ་དྲུག་ཅུ་རྩ་བདུན་གྱིས་བསྲེས་པ་ནི་རི་དུས་གཅིག་གིས་བསྲེས་པའོ་གསལབའི་ནཞག་ཚོགས་ཏེ་རིག་དུས་ཀྱས་བགོས་པ་ཡི་ཉིན་ཞག་གི་ཚོགས་དེ་ཡང་མིག་དམར་གྱི་དཀྱིལ་འཁོར་ཉིནཞག་དྲུག་བརྒྱ་བརྒྱད་ཅུརྩ་བདུན་གྱིས་བགོས་པ་ནི་རི་གླུ་དུས་ཀྱིས་བགོས་པའོ།",
    "ཆུ་སྲང་གི་གནས་དང་།",
    "དྲུག་གི་ཆས་ཐོབ་པ་ནི་ཆུ་སྲང་ལ་གཞུག་གོ།",
    "དེནས་ནི་རེ་མཐག་འདི་ལའོ་སླར་ཡང་ཁྱིམ་གྱི་ལས་ཀྱིས་རྣམ་པར་དག་པའི་གཟའི་ལོངས་སྤྱོད་ལ་སྦྱང་བར་བྱའོ།",
    "དེ་བཞིན་དུ་བླ་སྐྱེས་ཏེ་ཟླ་སྐྱེས་ཀྱི་ལོངས་སྤྱོད་ལས་གཟའ་ལྷག་གི་ལོངས་སྤྱོད་ཀྱི་དོན་དུ་ཉི་མམ་སྦྱར་བར་བྱའོ།",
    "འདིར་གཟའ་མཐོན་པོ་ཡིས་གཟའ་དམའམོལརྣམ་པར་སྦྱང་ངོ།",
    "གཟའམཐོན་པོའི་ལོངས་སྤྱོད་རྣམ་པར་དག་པའི་ལྷག་མའི་སྐར་མནིགཟའ་རྣམས་ཀྱི་ཉིན་ཞག་གི་ལོངས་སྤྱོདཀྱི་དབརགིས་རྒྱུབའི་སྐར་མར་འགྱུར་རོ།",
    "མ་ནུའི་གནས་ནས་བཅུ་བཞིལ་གནས་པའི་རྐང་པ་བཅུ་བཞི་པོ་གང་དག་གིས་གནས་དང་པོ་ལའོ།",
    "དཀྱིལ་འཁོར་གྱི་ཉིན་ཞག་གི་ཆའི་ལྷག་མའི་ཉིན་ཞག་གི་ཚོགས་སླར་ཡར་བསྒྱུར་ཏེ།",
    "རབ་བརྗོད་དཀྱིལ་འཁོར་གྱི་ཉིན་ཞག་གི་ཆ་ཡིས་ཐོབ་པ་ནི་སྐར་མེར་འགྱུར་རོ།",
    "རེ་བཞན་དུ་ཆུ་སྲང་དང་དབུགས་ནི་ཐོབ་པའོ།",
    "སེམིཆུ་གཏེར་དག་གིས་བགོ་ཞེས་བཞི་བཞི་སྟོང་སུམ་བརྒྱ་སུམ་ཅུ་རྩ་གཉིས་ཀྱིས་བགོ་བའོ།",
    "བཅུ་ཡིས་ཉིན་ཞག་གི་ཚོགས་བསྒྱུར་ནས།",
    "སྔར་གྱི་ཉིན་ཞག་གི་ཚོགས་གསལ་བལ་བཞི་སྟོང་བརྒྱད་བརྒྱ་ཉི་ཤུས་དམན་པ་སྟེ།",
    "དྲུག་རོ་རི་མཁའ་ཟླ་བ་ཡིས་བགོ་ཞིང་ཞེས་པན་ད་ཀྱིལ་འཁོར་གྱི་ཉིན་ཞག་ཁྲི་བདུན་བརྒྱ་དྲུག་ཅུ་རྩ་དྲུག་གི་བགོ་བའོ།",
    "ལྷག་མ་སྐར་མས་བ་སྐྱར་བལས་དཀྱིལ་འཁོར་གྱི་ཉན་ཞག་གི་ཆས་ཐོབ་པནི་སྐར་མར་འགྱུར་ཏེ་དེ་བཞིན་དུ་ཆུ་སྲང་ལ་སོགས་པའི་ལོངས་སྤྱོད་དུ་འགྱུར་རོ།",
    "ཉི་མ་འགྲོ་བའི་རྣམ་པར་དབྱེ་བ་དེས་འཆར་བའི་གཟའ་དེ་དག་གི་ལམ་དུ་ཡང་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་གཟའ་ལག་གི་ར་འཁྲིག་པ་དང་།",
    "ཟླ་སྐྱེས་དང་བཀྲ་ཤིས་དག་རང་རང་གི་སྐར་མ་ལའཐབ་སྟེ།",
    "རང་རང་གི་སྐར་མ་མ་གཏོགས་པ་སྐར་མའམ་ཞིང་གཞན་ལ་འཐབ་པ་མནིཔར་འགྱུར་བར་ངེས་པ་ནི་གདོན་མི་ཟ་བའོ།",
    "འོག་གི་ག་ཟའ་ཡམ་སྟེར་གི་གཟའ་བསྒྲིབས་པ་ནི་མཉམ་པ་ཉིད་དོ།",
    "དེ་བཞིན་དུག་ཡས་དང་གཡོནལ་གནས་པ་རྣམས་ཀྱང་ཉི་མ་དང་ལྷན་ཅིག་ཟད་བ་མེད་དེ་རང་གི་གནས་ཡོངས་སུ་མི་གཏོང་བའི་ཕྱིར་རོ།",
    "ལྷོ་རུ་ཡང་གོ་ལའི་རི་མོའི་དབུས་སུནག་པ་བྱེད་ལསོགས་པ་ནམ་གྲུའི་མཐའ་བྱེད་དང་བཙས་པའི་རྒྱ་སྐར་བཅུ་གསུམ་མོ།",
    "། ཤར་དུ་ལུག་དང་སྲང་སོགས་ཏེ་བུ་མོའི་མཐར་ཐུག་པ་ལ་གནས་ཤིང་།",
    "བྱང་གི་ཕྱེད་དུ་འཁྲིག་པའོ།",
    "ནུབ་ཀྱིཕྱེད་དུ་བུ་མོའོ།",
    "སྲང་གི་ཉི་མ་ལ་སྟོན་ཕྱེད་དུ་འགྱུརརོ།",
    "དེ་བཞིན་ཕན་ཚུན་ལྟོས་པ་ལས་གང་གི་རི་སའི་དུམ་བུ་དང་པོ་ལས་ར་ཞེས་པས་འགྲེལ་དུམ་བུ་བདུནཔ་ལ་སྟེ་ལྷུན་པོའི་ལྷོ་ནས་བྱང་དང་བྱང་ནས་ལྷོར་སའྀ་དུམ་བུ་བདུན་པ་ལཉཞི་མཚནམཉམ་པར་འགྱུར་རོ།",
    "གསུམ་པར་བུ་མོའི་ཉི་མས་སོ།",
    "བཅུ་པ་ལ་ལུག་གི་ཉི་མས་སོ།",
    "མེའི་དཀྱལ་འཁོར་གྱི་མཚམས་དེ་ནསཀཱིལ་ཤྭའི་བྱང་དུ་འགྲོ་སྟེ་གངས་ཀྱི་ར་ལི་བྱང་གི་ལམདུ་ཡང་བྱང་བགྲོད་པ་ལ་གནས་པའི་ཉི་མ་ལྷོ་བགྲོད་ཀྱིདང་པོའི་ཉིན་ཞག་གི་བར་དུའོ།",
    "གངས་ཅན་ནས་མོའ་བིར་དང་མིནས་གངས་ཅན་གྱི་བར་དཔག་ཚད་སྟོང་ཕྲག་བདུན་ཅུ་རྩ་ལྔའི་ད་། ན་ལྷོ་བགྲོད་ལ་སོགས་པའི་ཕྱོགས་ཀྱི་ཆ་འོ།",
    "ཕྱོགས་ཀྱི་ཆ་དེ་ཟླབ་དྲུག་གི་མི་ལ་བཞན་བྱང་དུ་བགྲོད་པ་དད་ལྷོར་བགྲོད་པ་དག་ལ་བགྲོད་དོ།",
    "ཉི་མ་ཁྱིམ་གཅིག་ལ་གནས་པའི་རྣམ་པ་གང་གིས་ཡཞི་པ་དེ་ལྟར་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་ཕྱོགས་རྣམས་ཐམས་ཅད་རབ་ཏུ་གྲགས་སོ་ དེའི་ཕྱིར་ལུག་གི་ཁྱམ་དེ་ལ་ཉི་མ་གནས་པས་དུམ་བུ་བཅུགཉིས་སུ་དུས་ཀྱིཆོག་ས་ལ་སོགས་པསཐམས་ཅད་བྱེད་པ་ཇི་ལྟ་བ་དེ་བཞན་དུ་བརྗོད་པར་བྱ་སྟེ།",
    "ལྷན་པོའི་བྱང་དུམ་བུ་བདུན་པར་སྨིན་དྲུག་གི་ཟླ་བ་བྱེད་དོ།",
    "ནུབ་བ་ལང་སྤྱོད་ན་གནས་པ་ནི་ནུང་གི་ཟུར་ཕྱེད་དུ་འགྲོའོ།",
    "འབུམཕྲག་གསུམམོ།",
    "ཉིན་གུང་གི་ཐུནམ་ཚམས་དང་།",
    "དེ་དག་གི་དབྱེ་བས་ཕྱེ་བར་གྱུར་པའི་དུསལ་སོགས་པ་རྣམས་འཁོར་ཏེ་དུས་ནི་དུས་སྦྱོར་བཞི་བཞིས་འཁོར་རོ།",
    "ཆུ་སྲང་སོ་སོ་ནི་དབུགས་དྲུག་གིས་འཁོར་ཏེ།",
    "ཁྱིམལ་གནས་པའི་ཉིན་མོར་བྱེད་པ་འདི་ནམ་མཁའ་ལ་འགྲོ་བའོ།",
    "གཡསསུ་ཟབ་གསུམ་གྱི་མཚན་མོ་ཆུ་ཚོད་ལྔ་འཕེལ་ལོ།",
    "གཡས་མིན་དུ་ཟླ་བ་གསུམ་གྱིས་ཉིན་མོ་ཆུ་ཚོད་ལྔ་འཕེལ་ལོ།",
    "འདིང་མཚན་མོ་འཕེལ་བས་ཉིན་མོའགྲིབ་པ་དང་ཉིནམོ་འཕེལ་བས་མཚན་མོ་འགྲིབ་པར་ཤེས་པར་བྱའོ།",
    "འཁྲིག་པ་འཆར་བའི་དུས་ཆུ་སྲང་གི་ཚོགས་ཉིས་བརྒྱསྟེ།",
    "དབུགས་དེདགལོབརྒྱའོ་ཉིནཞག་སྟོང་ཕྲག་སུམ་ཅུརྩ་དྲུག་གིས་བསྐོར་བ་དེདགེ་ནི་ལོ་བརྒྱའི་དབུགས་ཀྱི་ཚད་དུ་འགྱུར་རོ།",
    "ལྷགམའི་ཉིནཞག་གི་ཚོགས་བརྒྱ་ཕྲག་བཞི་བཅུརྩ་བརྒྱད་དང་བདུན་ཅུརྩ་ལྔ་ལྷག་པའི་ཁྲི་ཕྲག་གསུམ་ནི་ལ་ལ་ནཱདང་ར་ས་ནཱདག་གི་ལོ་བརྒྱའི་མཚམས་ཀྱི་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཟླ་བའི་ཕྱོགས་ཏེ་ཞེས་པ་ནི་ཟླ་བའི་ཕྱོགས་གཅིག་དབྱུ་གུ་སུམ་ཅུའི་བདག་ཉིད་ཀྱི་མཚན་མོར་འགྱུར་ཏེ།",
    "ཆུ་ཚོད་ཀྱི་ཚོགས་དྲུག་ཅུ་རྩ་བཞི་ལྷག་པའི་བརྒྱ་ཕྲག་བཅུ་གཅིག་གི་གྲངས་རྣམས་ནི་བཀྲ་ཤིས་ལ་སོགསགཟབ་ནི་ལྔ་བོརྣམས་ཀྱི་མྱུར་བའི་ལསཏེ་སྐརམའི་ལས་དག་ལ་ཡང་རྐང་པའི་ཆུ་ཚོད་དུ་གྱུར་རོ།",
    "འདིར་གཟའ་ལག་གི་ཆུ་ཚོད་ཀྱི་ཚོགསབརྒྱ་རྒྱུད་། དགུཐ་ཅུ་རྩ་བཞིའོ།",
    "སྐྱོན་དང་ཚོས་དང་བརྒྱད་དེ་ཞེས་པ་ནི་བརྒྱད་པ་ལ་བཅོ་བརྒྱད་དོ།",
    "གཟའལག་གི་ཡང་དེ་བཞིན་ནོ།",
    "ཟླབའི་དྲིདང་རེདང་གཟུགས་དང་རེག་དང་སྒྲའི་ཡོན་ཏན་ཏེ་རྐད་པ་ལྔའོ།",
    "ལོ་ག་སུམ་གྱི་མཐར་ཆུ་སྲང་གི་ལོངས་སྤྱོད་རྣམས་ཡོངས་སུ་བཏང་ནས་ཕྱོགས་གསུམ་གྱི་བར་དུ་ཉིན་ཞག་སོ་སོར་ཆུ་ཚོད་གཉིས་ལོངས་སྤྱོད་དེ་མྱུརབ་ལ་མདུན་དང་།",
    "གི་ཚོགས་སུ་འགྱུར་རོ།",
    "རེ་བུག་རི་ཀླུ་སྟེ་ཟླ་སྐྱེས་ལ་སྟོང་ཕྲག་བརྒྱད་དང་བདུན་བརྒྱ་དགུ་བཅུ་རྩ་བདུན་དུ་འགྱུར་རོ།",
    "ཉི་མའི་བུ་ལ་དྲུག་དྲུག་རི་དང་ནམ་མཁའ་ག་ཅིག་སྐྱེས་པ་ཁྲི་ཕྲག་གཅིག་དང་བདུན་བརྒྱ་དྲུག་ཅུརྩ་དྲུག་གིཉིན་ཞག་གི་ཚོགས་ནི་ད་ཀྱིལ་འཁོར་དུ་འགྱུར་རོ།",
    "འཆར་བལ་ཡང་ཕྱོགས་གསུམ་གྱི་ཉིན་ཞག་གི་རྒྱུ་བའི་རྐང་པ་བ་སྒྱུར་བ་ནི་ཆུ་སྲང་གི་ཚོགས་ཕྱེད་དང་བཅས་པའི་བརྒྱ་བཅུ་གཉིས་སུ་འགྱུར་ཏེ།",
    "འཁྱོག་པོ་ལ་ཞེས་པ་དཀྱིལ་འཁོར་ཕྱེད་ཡོངས་སུབ་ཏང་ནས་རིམ་པ་མིན་པ་ལ་ལོངས་སྤྱོད་པ་ལ་སྟོབས་དང་ལྡནཔར་འགྱུར་རོ།",
    "ཁྱིམ་ནི་བཅུགཉིས་པོརྣམས་བཞི་ཡིས་བ་སྒྱུར་བ་བརྒྱད་དང་རིག་བྱེད་དག་ཀྱང་ཟླ་བ་དྲུག་གི་བར་དུ་ཉི་མེའ་རྐང་པར་འགྱུར་རོ།",
    "གཟའ་རྣམས་དག་གི་ལོ་ཡི་ལོངས་སྤྱོད་ཀྱིས་ནིབ་སྐྱར་བར་བྱ་ཞེས་པ་ནི།",
    "གནས་གཉིས་ཕྱོགས་ཀྱི་ཆས་ཐོབ་པ་བཅུའི་ཆའིཐེབ་སྟེང་གི་ཕུང་པོ་དག་ལ་བུ་ལོན་སྦྱང་བར་འགྱུརཏེ།",
    "ཁྲི་ཕྲག་དྲུག་གི་ལོ་གྲངས་གང་དག་རྣམས་ནིདུས་ཀྱི་བྱེད་ལ་འགྱུར་རོ།",
    "དཀྱིལ་འཁོངག་སུམ་དང་གཉིས་དངག་ཅིག་གི་བདག་ཉིད་དེ་དཀྱིལ་འཁོར་སོ་སོ་ནི་རྩོད་ལྡན་གྱི་དུས་ཀྱི་ལོའི་ཚད་དོ།",
    "གཟའ་རྣམས་ཀྱི་ནི་དཀྱིལ་འཁོར་དག་གི་ས་ངེས་བར་ཆ་ནི་རབ་ཏུ་ཐོབ་བར་གྱུར་པ་ལོངས་སྤྱོད་འགྱུར།",
    "ཨཾ་ཨ་འདི་དག་གིས་ཀ་ཡིག་ལ་སོགས་པའི་ཡི་གེ་སོ་སོ་ལ་བཅུ་གཉིས་ཀྱི་དབྱེ་བས་ཐ་དད་པར་འགྱུར་རོ།",
    "རྡུལ་དངམུན་པའི་དབྱེ་བས་སད་པ་དང་རྨི་ལམ་དང་ཤིན་རྒྱུ་ཅུ་གཉིད་ལོག་པའི་རང་བཞིན་གྱིས་དེ་དག་ནི་སྒྲ་གཅན་ཏེ་སྲོག་གི་རླད་གིས་དུས་སྦྱོར་གསུམ་དུ་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ངེ་ས་པའོ།",
    "ཕྱེད་བཅས་ཟླ་བ་ཞེས་པ་ནི་ཕྱོགས་གསུམ་མོ།",
    "ལྷ་མོ་དྲུག་ཅུས་རྣམས་ཀྱིས་ཏེ་ཆུ་ཆོད་དྲུག་ཅུ་། རྣམས་ཀྱིས་སོ།",
    "ལྷ་མོ་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་ཆུ་ཚོད་རྣམས་ཀྱི་ཟླ་བའི་ངེས་པ་ལ་ཆུ་ཚོད་ཀྱི་གནས་སུ་སུམ་ཅུ་རྩ་གཉིས་སོ།",
    "སྦྱིན་དོར་སྦྱིན་པ་དག་ནི་ལྷ་མོ་གཅིག་ཏུ་འགྱུར་ཞིང་།",
    "ལྔ་པོ་གཅིག་དང་བཅས་པའི་དྲུག་གིས་སོ།",
    "དུས་ཀྱི་གཟུགས་ནི་སྲོག་གི་གཟུག་ས་ཀྱིས་སོ།",
    "མྱུར་འཁྱོག་ལ་སོགས་པའི་རྒྱབས་སོ།",
    "དེ་ལྟར་སྔར་བརྗོད་པའི་ཚོགས་ཚངས་པ་ལ་སོགས་པ་འདི་དག་གིས་ཤེས་པམ་ཡིན་པ་བཅོམ་ལྡན་འདས་དུས་ཀྱི་འཁོར་ལོ་ཀུན་རྫོབ་ཀྱི་ཚུལ་གྱིས་རྣམ་པར་གནས་པ།",
    "དབྱངས་གང་དག་གི་དང་པོ་ཨ་ཡིག་ཡི་ན་པ་དེ་དག་ནི་ཨ་སོགས་ལྔ་སྟེ།",
    "ཨ་ཨིརྀ་ཨུལྀ་ཞེས་པ་རང་བྱུང་གི་ཚིག་གོ།",
    "ཨེ་ཡིག་དང་ཨུ་ཡིག་དག་གི་ཡོན་ཏན་སྦྱར་བའི་ཡི་༢གེ་དག་གོ།",
    "རྀ་ཡྀག་ལྀ་ཡིག་དག་ཀྱང་ཡོན་ཏན་དང་ལྡན་པས་ཨི་ཡིག་ལ་སོགས་པ་རྣམས་དད་ཁྱད་པར་མོད་དོ།",
    "དེ་བཞིན་དུ་བཟད་པོ་དངག་ཟའ་ལག་གལ་ཏེ་རྒྱུ་སྐར་མཆུར་གྱུར་ན་དེའི་ཚེ་གཉིས་པཨེ་ཡིག་གི་དབྱངས་ཀྱི་མིང་ཅན་འཆི་བར་འགྱུར་རོ།",
    "བཞིཔ་ཨུ་ཡིག་གི་དཔྱངས་ཀྱི་མིང་ཅན་འཆི་བར་འགྱུར་རོ།",
    "དེ་ལྟར་དབྱངས་འཆར་བ་རྣམས་ལ་ཡང་རྒྱུ་སྐར་དང་གཟའི་དབདགིས་འཆི་བའི་སྦྱོར་བར་འགྱུར་རོ།",
    "གཟིར་བ་རྣམས་ཉོན་མོངས་པར་འགྱུར་རོ།",
    "བདེན་པར་འཆར་བ་ལྔ་བ་རྣམས་ཀྱི་སྟེ་ཨ་ཡིག་ལ་སོགས་པ་རང་རང་གི་ཚོས་ལ་ཤར་བ་རྣམས་ཀྱི་འབྲས་བུ་མར་པོར་འཆི་བའི་སྦྱོར་བས་དམན་པ་དག་ལ་འགྱུར་རོ།",
