    "ཁྱེད་སྐུ་མཆེད་ཀྱི་ཡོན་ཏན་འདི་ལ་ཁོ་བོ་མགུགུང་བསང་བྱུང་རེས་ཀྱི་འདིར་བྱོན།",
    "འདི་ཡས་རང་ལག་གི་གླ་ཟ་བ་བྱ་བ་ལགས་པས་འདི་ངེད་ཀྱིས་མི་འཇུ།",
    "ཁོང་རང་གི་ཞིང་སོགས་ཚོང་མང་དུ་མཛད་པས།",
    "གཅེན་གྱིས་བསྒོམས་པ་དངོས་རྡོ་རྗེའི་ཚིག་རྐང་གི་སྟེང་དུ་གོ་བ་ཆེ་བ་སོགས་བྱུང་།",
    "དེའང་བསྟན་པ་སྔ་དར་གྱི་དུས་སྤྱན་རས་གཟིགས་ཀྱི་སྤྲུལ་པ་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོ།",
    "བདེ་མཆོག་གི་སྒྲུབ་པ་བྱས་ན་མྱུར་དུ་དངོས་གྲུབ་ཐོབ་ཅེས་ལུང་བསྟན་པ་ལྟར།",
    "ཁོང་རང་ཡབ་ཡུམ་ཡི་དམ་གྱི་ལྷར་དངོས་སུ་གཟིགས་པ་དང་།",
    "དེ་ནས་རེ་ཞིག་ནས་རྨ་ལོ་ཙཱ་བ་རབ་ཏུ་བྱུང་སྟེ་དབུས་གཙང་ལ་བྱོན་པས་ཤབ་ཏུ་དུག་བྱུང་ནས་གྲོངས།",
    "ཉིན་རེ་ལ་བྱང་སེམས་ཉུང་ཀར་ཙམ་རེ་ཉམས་འགྲོ་བ་དང་།",
    "གཏོར་མ་བྱ་རོག་གིས་མི་ཟ་བ་དང་།",
    "ཁྱོད་ཀྱི་མིང་པོས་ཕག་ཏུ་རིན་ལ་རྟ་གཅིག་ཟོས་འདུག་གསུངས།",
    "བྱ་མོ་ནག་མོའི་སྒོ་ང་སོགས་ཁྱེར་ཤོག་གསུངས།",
    "སྲས་གཅིག་ལ་འབུལ་བ་བྱས་ཀྱང་ཟེར་ཏེ་དེ་དག་གིས་ལོ་གཅིག་ལ་ཁམས་འདུས་པ་སངས་ཏེ་བདེ་བར་བྱུང་།",
    "རྒྱལ་ཁམས་ལ་བྱོན་པས་རོང་གི་ཁུ་ལུང་མདའིཆུ་ཁ་ན།",
    "དིང་རེའི་སྐེད་ཆག་པ་ཁྱུང་པོ་ཧཱུཾ་ཀ་ར་ཞེས་བྱ་བའི་སར་བཞུགས་པའི་ཚེ།",
    "ཁྱོད་ལ་དང་པོ་འདི་ལྟ་བུ་མ་བྱུང་ངམ།",
    "ཁོང་གི་སྔར་བྱུང་བ་རྣམས་ཀྱི་ཐོག་ཏུ་ཁྲིག་ཁྲིག་བྱུང་བས།",
    "གདམས་ངག་རྫོགས་པར་གནང་བ་བཞེད་པ་ལ་སྐབས་ལ་ཤིག་ན་ཁོང་རྣམས་གདམས་ངག་གིས་ཐུགས་ཚིམ་སྟེ་ཕྱིར་འབྱོན་གྲབས་སུ་འདུག་པ་ལ།",
    "ད་དུང་བཞུགས་ཏེ་གསོལ་བ་བཏབ་ནས་གདམས་ངག་གི་འཕྲོ་རྣམས་གསན་པ་འཐད།",
    "གོས་ཇག་དམར་རྐྱང་རེ་ལས་མེད་པས་གྲང་དྲག་ནས་གཡག་གི་སྐྱིབས་འབྱོན་ཞིང་འོང་དགོས་པ་བྱུང་།",
    "འུ་ཅག་ལ་མེད་པ་འདྲ་ཁོང་ལ་གནང་མོད།",
    "རྒྱུ་དུས་ཀྱི་ལྟ་བ་འཁོར་འདས་དབྱེར་མེད་ལ་མི་བྱེད་པར་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་ཐུན་མོང་གི་ལྟ་བ་ལ་བྱེད་པ་སོགས་ཅུང་གདམས་ངག་མ་རྫོགས་པའི་རྟགས་སུ་གདའ་གསུངས།",
    "ཉེ་གནས་མ་ལ་རང་རེ་སྒོག་པ་སྒྲུགས་པར་འགྲོ་བས་ཁྱོད་རང་སྔོན་ལ་སོང་གསུངས།",
    "ཉེ་གནས་གར་ཕྱིན་དུ་ཕུག་རོན་རེ་འོང་གིན་འདུགདེར་སྒོག་པ་ཁྱེར་ནས་ཕྱིན་པས།",
    "ང་རང་གིས་སྒྲུགས་པ་ཡིན།",
    "ཁྱོད་བྲག་གཡང་ལ་འདྲིལ་ལ་ཁད་བྱུང་བའི་དུས་ཀྱང་ང་འཁྲིས་ན་ཡོད་གསུངས་པ་དང་།",
    "སྡུག་བྱིས་ཕུང་བྱིས་འདྲས་སོར་རྡེལ་རྡེག་གིན་ཉན་དུ་མ་སྟེར་གསུང་བ་དང་།",
    "བོད་མོའི་ཆ་ལུགས་ཀྱིས་ནམ་མཁའ་ལ་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་བྱས་ནས་བསྐོར་བ་མཛད་པ།",
    "བདེ་མཆོག་གི་སྒོ་མཚམས་མ་རྣམས་བྲན་དུ་ཁོལ་བས་ཁྭ་གདོང་མ་ཆུ་ཆུས།",
    "ཉམས་དབྱངས་ལ་དགའ་ཆེས་པས་ཅུང་ཟད་ལམ་གྱི་བར་ཆད་དུ་སོང་འདུག་གསུངས།",
    "ཕ་དྲུག་གི་སེ་སྒོམ་བྱང་ཡེ་ཞེས་པའི་ཕྱུག་པོ་ཞིག་གིས་ནོར་མང་པོ་ཁྱེར་ནས་མུ་གུ་ལུང་དུ་ཕྱིན་པས།",
    "ཁོང་རང་གི་ཉམས་ལེན་དང་།",
    "ཤེས་རབ་སོགས་ཀྱིས་མ་འཁྱོངས་པ་ཡིན་ནམ།",
    "ཆུན་མ་ཞང་ཞུང་གུ་ར་བའི་བུ་མོ་ཡིན་པས་མ་གཅིག་ཞང་མོའམ།",
    "དེའང་ད་ལྟ་སྤྱིར་འདི་རྗེ་བཙུན་ས་ཆེན་སྤྱན་རས་གཟིགས་ཀྱི་སྤྲུལ་པ་ཡིན་གྱི།",
    "འཇམ་དབྱངས་བདུན་བརྒྱུད་ལའང་མིའདྲེན་མོད།",
    "ཇོ་བོ་རྗེས་ས་དཀར་ལོགས་ལ་དྷཱི་ཡིག་བདུན་གཟིགས་པའི་བསྟན་པ་ལྟར།",
    "དེ་ལྟར་འཇམ་དབྱངས་ཀྱི་སྤྲུལ་པ་ཡིན་པས་སྤྱན་རས་གཟིགས་མ་ཡིན་པར་མི་འགྱུར་བས་ན།",
    "ཁམས་པ་ཞིག་གིས་ཁྱེད་སྤྱན་རས་གཟིགས་སུ་གྲགས་པས་ང་ལ་རྟགས་ཤིག་མི་སྟོན་ན་ལྕེབ་ཞུས་པས།",
    "ཕྱག་སྟོང་སྤྱན་སྟོང་གི་མཚོན་བྱེད་དུ་ཕྱག་ཡང་རྗེ་བཙུན་བརྩེ་བ་ཆེན་པོར་གྲགས་པ་ཡིན་གསུངས།",
    "རྗེ་བ་རི་ལོ་ཙཱ་བ་ས་སྐྱའི་གཡུ་མཁར་མོ་ན་བཞུགས་པ་སྤྱན་དྲངས་ཏེ་གདན་སར་བསྐོས།",
    "པར་ཐུགས་ཀྱིས་མ་བཟོད་པར་ཁོང་གིས་གཡོག་མཛད་པས་ཁོ་ལ་ལེགས་པར་ཕན་མོད།",
    "དེའི་ཚེ་ས་སྐྱ་ན་ཨ་ཕོ་ཕག་སྟོན་བྱ་བ།",
    "ཞྭ་ཐང་ཞུ་གྱོན་པ་ཞིག་རྟ་ལྕག་བརྡེག་གིན་ནམ་མཁའ་ནས་ཚུར་ཡུད་ཡུད་བརྒྱུགས་ཏེ།",
    "ཨ་པོས་ཟེར་བ་རྣམས་ངེས་པར་བདེན་པ་ཞིག་འོང་གིན་ཡོད་པས་མ་ལེགས་གསུངས།",
    "ཡུམ་ན་རེ།",
    "བ་རི་བ་བྱང་གི་གླིང་བར་ཕུག་བྱ་བར་ན་ནས་དེར་མྱ་ངན་ལས་འདས།",
    "ཟན་སྒོང་གིས་ཟམ་ཐུར་བྱས་པའི་ཟམ་པ་གསུམ་འདུག་ཕ་རི་ན་བདག་སྒྲོལ་བར་ཞུ།",
    "མ་ལ་ཡ་ཡིན་ཟེར་བའི་རི་ཞིག་གི་ལོགས་སུ་ཉི་མ་ལ་བསྙེལ་བསོ་མཛད་ཅིང་བཞུགས་པ་རྨིས།",
    "ཁྱོད་ཀྱི་མཁོས་ཀས་མི་གསུམ་ལས་ག་ན་སྒྲོལ་ཞེས་ཞལ་ཀྱལ་མཛད་ཅིང་།",
    "སྒྱི་ཆུ་བའི་བན་ཆུང་མང་པོ་ལྟད་མོལ་འགྲོ་གྲབས་སུ་འདུག་པ་ལ།",
    "བླ་ཆེན་སྤྱིར་ལྟད་མོ་སོགས་ལ་མི་དགྱེས་ཀྱང་།",
    "རྗེ་མཁར་ཆུང་བ་གྲལ་དབུ་ན་གཏམ་འུད་ཅན་མང་པོ་གསུང་ཞིང་བཞུགས་ཏེ་ཁོང་སྒྱི་ཆུ་བའི་བན་ཆུང་རྣམས་ལ་རེ་རེ་ནས་དྲི་རྩད་མཛད།",
