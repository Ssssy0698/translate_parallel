    "སའི་གོ་ལའི་སྟེང་གི་ས་དང་ཆུ།",
    "ཕྱི་ནང་གི་རྒྱུ་རྐྱེན་ཡོངས་ལ་ཟེར།",
    "རྩྭ་ར་ཆུང་ངུ་ལྟ་བུའི་དངོས་པོ་བྱེ་བྲག་པ་རེ་རེ་ནས་སྐྱེ་དངོས་མ་ལག་ཏུ་གཏོགས་ཤིང་།",
    "དེ་དག་གི་འབྲེལ་བ་འདི་ལྟ་སྟེ།",
    "རྒྱལ་མོ་རྔུལ་ཆུ།",
    "མཚོ་ཁྲི་ཤོར་རྒྱལ་མོ་བཅས་སོ།",
    "ཇོ་མོ་གངས་དཀར།",
    "ཧི་མ་ལ་ཡ་རི་བོའི་རིང་ཚད་ལ་སྤྱི་ཡོད་པ་དང་ལྷོ་བྱང་གི་ཞེང་ལ་སྤྱི་ལེ་ཡོད།",
    "རྒྱལ་མོ་རྔུལ་ཆུ།",
    "རྒྱ་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ་སྟོང་ཡན་གྱི་མཚོ་ཆེན་གནམ་མཚོ་ཕྱུག་མོ་དང་བཀྲ་རི་གནམ་མཚོ།",
    "རྒྱ་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ་བརྒྱ་བརྒལ་བའི་མཚོ་སུམ་ཅུ་སོ་ལྔ།",
    "རྒྱ་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ་ལྔ་ནས་བཅུ་བར་སུམ་བརྒྱ་ཉེར་གཅིག་ཡོད།",
    "བོད་ལྗོངས་ཀྱི་གནམ་མཚོ་ཕྱུག་མོ་དང་བཀྲ་རི་གནམ་མཚོ།",
    "མཚོ་སྔོན་མགོ་ལོག་ཁོངས་ཀྱི་མཚོ་སྐྱ་རེངས་དང་མཚོ་སྔོ་རངས་སོགས་ཡིན།",
    "དེང་གི་སྐབས་འདིར་རྩི་ཤིང་རིགས་མངོན་གསལ་སྒོས་ཇེ་ཉུང་དུ་སོང་ཡོད་དེ།",
    "རྩི་ཤིང་དེ་དག་ལས་རིགས་གཅིག་ལ་གནོད་སྐྱོན་ཕོག་ཚེ་རིགས་གཞན་དག་གི་གྲངས་ཀ་ཡང་ཇེ་ཉུང་དུ་འགྲོ་བའམ་ཡང་ན་རྩ་བ་ནས་མེད་པར་འགྱུར་ངེས།",
    "ཚན་རིག་པས་བརྟག་དཔྱད་བཏང་བ་ལྟར་ན་ད་ལྟ་སའི་གོ་ལའི་སྟེང་ནས་ཉིན་རེར་རྩི་ཤིང་རིགས་གཅིག་ནས་རིགས་གཉིས་རྩ་མེད་དུ་འགྲོ་བཞིན་ཡོད་པ་དང་།",
    "འབྲི་ཆུའི་སྟོད་རྒྱུད་དུ་སྔོན་ཆད་ནགས་ཚལ་གྱི་སྤྱིའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ཆིང་ཁྲི་ཡོད་པ་དང་།",
    "ནགས་ཚལ་གྱི་ཁྱོན་ཇེ་ཆུང་ལ་སོང་བ་དང་ནགས་ཚལ་གྱི་ཁེབས་ཚད་སྔོན་ཆད་ལས་ཆེས་ཆེར་ཇེ་ཉུང་དུ་སོང་ཡོད།",
    "རང་རེའི་རྒྱལ་ཁབ་ནི་རླན་ས་མང་པོ་ཡོད་པའི་རྒྱལ་ཁབ་ཅིག་ཡིན་པས་རླན་སའི་གཞི་ཁྱོན་དེས།",
    "གངས་གཟིག་གནའ་བ།",
    "གོང་མོ།",
    "ཆུ་སྐྱར་མགོ་སྨུག་སྐྱར་མོ།",
    "འོད་ཟེར་ཆེམ་ཆེམ་དུ་འཚེར་བའི་ཚྭ་མཚོ་དཀར་མོ་ནི་ཡུལ་གཞན་ན་མེད་པའི་ཚྭ་སྔོན་གྲུ་བཞིའི་འབྱུང་ཁུངས་ཡིན་ལ།",
    "ཚྭ་ཁའི་ནུབ་བྱང་ཕྱོགས་ཀྱི་ཚྭར་ཧན་ཚྭ་མཚོ་ནི་ཆེས་ཆེ་བའི་ཚྭ་མཚོ་ཡིན་ལ་དེའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ཡོད་ཅིང་།",
    "དེ་ཡང་བོད་མི་རིགས་ནི་གནའ་སྔ་མོའི་དུས་ནས་བཟུང་ཕྱུགས་ལས་གཉེར་བཞིན་པའི་མི་རིགས་ཤིག་ཡིན་སྟབས།",
    "རྩྭ་ཐང་ནི་རང་གི་འཚོ་བའི་རྟེན་གཞི་དང་ཤ་མར་ཐུད་གསུམ་གྱི་འབྱུང་ཁུངས་ཡིན་པས་དེར་དུང་བ་ཤིན་ཏུ་ཆེ།",
    "བོད་མི་རིགས་ཀྱི་འདུ་ཤེས་ལས་རྩྭ་ཐང་ནི་གཞི་བདག་གི་ལྭ་བ་ཡིན་ཟེར་བས་ས་རྐོ་རྡོ་སློག་དང་གཏེར་ཁ་སྔོག་འདོན།",
    "བོར་རྩྭ་ཐང་ཞན་འགྱུར་གྱི་ཚད་ཡན་ལ་སླེབས་འདུག་རང་རྒྱལ་ལ་མཚོན་ན་དུས་རབས་ཉི་ཤུ་བའི་ལོ་རབས་ཉི་ཤུའི་དཀྱིལ་དུ་ཞན་འགྱུར་རྩྭ་ཐང་གིས་རྒྱལ་ཡོངས་རྩྭ་ཐང་གི་སྤྱིའི་རྒྱ་ཁྱོན་གྱི་ཙམ་ལས་ཟིན་མེད་ལ།",
    "ལོ་རབས་བརྒྱད་བཅུ་བའི་དུས་དཀྱིལ་ནས་ཡན་ལ་ཐོན་པ་རེད།",
    "བེད་སྤྱོད་བྱ་རུང་བའི་རྩྭ་ས་སྤྱིའི་རྒྱ་ཁྱོན་གྱི་དང་ཟིན་འདུག་གོ།",
    "རྩྭ་ས་ཞན་འགྱུར་གྱིས་ང་ཚོའི་འཚོ་གནས་ལ་དུས་དང་རྣམ་པ་ཀུན་ཏུ་འཇིགས་སྐུལ་གྱི་ཅོང་བརྡ་སྒྲོག་བཞིན་ཡོད།",
    "ཚྭ་འགྱུར་ཏེ་འགྱུར་གསུམ་ནི་སྣོད་ཀྱི་འཇིག་རྟེན་འདིར་ཆུ་ཤོར་ས་ཉིལ་བྱུང་ཚད་ཇེ་མང་དུ་འགྲོ་བ་དང་རྩྭ་ཐང་གི་གནམ་གཤིས་ལོ་རེར་ཇེ་སྡུག་ཏུ་འགྲོ་བའི་རྒྱུ་ཡིན་པས་དེ་ལ་བརྟེན་ནས་སའི་གོ་ལར་རྟེན་འབྱུང་གི་འཁོར་རྒྱུག་ངན་པ་གྲུབ་པ་རེད།",
    "དེ་ཡང་རྩྭ་ཐང་ཞན་འགྱུར་གྱི་རྒྱུ་རྐྱེན་ནི་གོ་ལའི་གནམ་གཤིས་ཇེ་དྲོར་སོང་བ་དང་ཆར་ཆུའི་འབབ་རྒྱུན་ཉུང་ཞིང་ཐན་པ་བྱུང་བ་སོགས་ཡིན།",
    "ཆུའི་ཐོན་ཁུངས་བག་མེད་དུ་བེད་སྤྱོད་གཏོང་བ་སོགས་རེད།",
    "ནགས་ཀླུང་སྟུག་པོ་ལ་ཐཱན་འཇགས་དབྱང་གཏོང་གི་ནུས་པ་ཡོད་པར་མ་ཟད།",
    "ནགས་ཚལ་གྱི་ཐོན་ཁུངས་བག་མེད་དུ་བེད་སྤྱོད་བྱེད་པ་དང་དགོས་མཁོ་ཇེ་ཆེར་སོང་པའི་རྐྱེན་གྱིས་ནགས་ཀླུང་གི་རྒྱ་ཁྱོན་ཉེན་རེར་ཇེ་ཆུང་དུ་འགྲོ་བཞིན་ཡོད་ལ།",
    "དེ་ལ་བརྟེན་ནས་འཛམ་བུ་གླིང་གི་ས་ཆ་ལ་ལར་ཆུ་ཤོར་ས་ཉིལ་བྱུང་བ་དང་།",
    "ནགས་ཚལ་ཐོན་ཁུངས་ཀྱི་ཐོན་སྐྱེད་ནུས་པ་དང་སླར་སྐྱེད་ནུས་པ་སྔར་བཞིན་གཏན་འཇགས་སྒོས་རྒྱུན་འཁྱོངས་བྱེད་ཐུབ་པ་དང་།",
    "ཐོན་རྫས་ཐོན་ཁུངས་མཁོ་འདོན་བྱེད་རྒྱུ་དེ་རྒྱུན་འཁྱོངས་བྱེད་པ་དང་།",
    "སྤྱིར་བརླན་ས་ནི་འཇིག་རྟེན་ཁམས་ཀྱི་སྐྱེ་དངོས་ཕུན་སུམ་ཚོགས་པའི་འབྱུང་ཡུལ་དང་ཐོན་ཁུངས་གཙོ་བོ་ཞིག་ཡིན་པས་འཛམ་གླིང་གི་ས་ཆ་སོ་སོར་ཁྱབ་ཡོད་དོ།",
    "བརླན་ས་ཡིས་སའི་གོ་ལའི་སྐམ་སའི་སྤྱིའི་རྒྱ་ཁྱོན་གྱི་བརྒྱ་ཆའི་དྲུག་ལས་ཟིན་མེད་ནའང་།",
    "གོ་ལ་ཧྲིལ་བོའི་བརླན་སའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ཁྲི་ཡོད་ལ་སྐམ་སའི་རྒྱ་ཁྱོན་གྱི་བརྒྱ་ཆའི་དྲུག་ཟིན་ཡོད།",
    "དེའི་ནང་ནས་ན་འདམ་གྱིས་བརླན་སའི་རྒྱ་ཁྱོན་གྱི་བརྒྱ་ཆའི་བདུན་ཅུ་དོན་དྲུག་ཟིན།",
    "དེའི་རྒྱ་ཁྱོན་ནི་འཛམ་གླིང་གི་ཨང་དང་པོ་ཡིན།",
    "རང་རྒྱལ་གྱི་བརླན་སའི་རྒྱ་ཁྱོན་ལ་ཧེག་ཐ་ཁྲི་ཡོད་ལ།",
    "འཛམ་གླིང་གི་ཨང་བཞི་བ་ཡིན་པ་དང་ཨེ་ཤ་ཡའི་ཨང་དང་པོ་ཡིན།",
    "དེ་རུ་སྐམ་ས་དང་ཆུ་གཉིས་ན་འཚོ་གནས་ཐུབ་པའི་སྲོག་ཆགས་དང་རྩི་ཤིང་གི་ཐོན་ཁུངས་ཕུན་སུམ་ཚོགས་པ་འདུས་ཡོད་ལ།",
    "ཐུན་མོང་མ་ཡིན་པའི་ཆུ་ཁམས་དང་ས་གཤིན།",
    "སྒོས་སུ་ཆུ་ཁམས་རང་བྱུང་ཁམས་དང་མིས་སྤྱོད་ལམ་གང་རུང་ཞིག་གིས་གནོད་པ་ཕྲན་བུ་ཞིག་བཟོས་བྱུང་ནའང་།",
    "ཆུ་སྲམ་སོགས་རྒྱལ་ཁབ་ཀྱི་སྲུང་སྐྱོང་རིམ་པའི་རི་སྐྱེས་སྲོག་ཆགས་ཀྱི་པགས་པ་གྱོན་གོས་ཀྱི་མཐའ་རྒྱན་བྱེད་པའི་ལུགས་སྲོལ་དར་བས་གྱོན་གོས་མཐའ་རྒྱན་གྱི་ཆེད་དུ་བོད་རང་གིས་ཀྱང་རི་སྐྱེས་སྲོག་ཆགས་གཤོར་བའང་ཡོད།",
    "སྟག་གཟིག་དང་ཝ་སྤྱང་།",
    "དེའི་ཕྱིར་ང་ཚོས་གྱོན་གོས་ཀྱི་མཐའ་རྒྱན་རྐྱེན་གཙོ་བོ་ཞིག་ཡིན།",
    "དེའི་ཕྱིར་ང་ཚོས་གྱོན་གོས་ཀྱི་མཐའ་རྒྱན་ལ་རི་སྐྱེས་སྲོག་ཆགས་ཀྱི་པགས་པ་མི་འཇོག་ལ།",
    "རི་དྭགས་ལ་ཟ་རྒྱུ་ནག་ནོག་གི་རིགས་མི་སྟེར་བ།",
    "སྐྱེས་དངོས་ཀྱི་ཐོན་ཁུངས་རྒྱུན་བསྲིང་གིས་བེད་སྤྱོད་བྱེད་པ་དང་།",
    "གླང་མོ་ཆེ་ལྟ་བུའི་སྲོག་ཆགས་རྩ་ཆེན་གྱི་རིགས་མྱུར་སྐྱོབ་བྱེད་པར་ཕན་ནུས་གལ་ཆེན་ཐོན་པ་ཡིན།",
    "འཛམ་གླིང་སྟེང་དུ་སྐྱེས་དངོས་འདྲ་མིན་རྣམ་གྲངས་ལ་སྲུང་སྐྱོང་བྱེད་པའི་སྤྱི་ཆིངས་སྟེང་མིང་རྟགས་འགོད་མཁན་གྱི་རྒྱལ་ཁབ་ཉུང་ཤོས་ཤིག་ལ་མེད་མོད།",
    "ལོའི་ལོ་མཇུག་ཏུ་རང་རེ་རྒྱལ་ཁབ་ཀྱིས་ཀྲུང་གོའི་སྐྱེས་དངོས་འདྲ་མིན་རྣམ་གྲངས་ཀྱི་འགུལ་སྐྱོད་འཆར་གཞི་ཞེས་པ་གཏན་ཁེལ་བྱས་ཤིང་།",
    "ཀྲུང་གོའི་རྒྱ་མཚོ་ཆེན་མོའི་སྐྱེ་དངོས་སྣ་མང་སྲུང་སྐྱོང་གི་འགུལ་སྐྱོད་འཆར་གཞི་ཞེས་པ་སོགས་གཏན་ལ་ཕབ་ཡོད།",
    "རྩི་ཤིང་གི་ས་བོན་དང་།",
    "དཔེར་ན་ཨ་རི་རྒྱལ་ཁབ་ཀྱི་ས་བོན་མཛོད་ཅེས་པ་རུ་རྩི་ཤིང་གི་རིགས་ལྷག་གི་ས་བོན་འབུམ་བཞི་ཉར་ཚགས་བྱས་ཡོད་ལ།",
    "ཚད་ལས་བརྒལ་བའི་བཙོག་འབུད་ཀྱི་རིན་དོད་བསྡུས་རིགས་ངེས་པར་དུ་སྦགས་བཙོག་འགོག་སེལ་བྱེད་པར་སྤྱོད་དགོས་པ་ལས་གཞན་དུ་སྤྱོད་མི་རུང་བ་དང་།",
    "ད་དུང་འཚོ་བའི་ཁྲོད་མྱོང་ཚོར་གཞན་ཡང་འབྱུང་ངེས་ཡིན།",
    "གྲོ་བཀྲུས་རྗེས་ཀྱི་བཙོག་ཆུ་སོགས་ཀྱིས་ནོར་བཟང་ཚང་གི་རྒྱུན་ལྡན་འཚོ་བ་དང་ལུས་ཕུང་བདེ་ཐང་ལ་གནོད་པ་ཚབས་ཆེན་བཟོས།",
    "ནོར་བཟང་གིས་ཐེངས་འགར་བཟོ་གྲྭར་འབྲེལ་གཏུག་བྱས་མཐར།",
    "བཟོ་གྲྭས་སྦགས་བཙོག་འགོག་སེལ་གྱི་སྒྲིག་ཆས་སྐོར་ཞིག་བཙུགས་ན་ཡང་ལྡིར་སྒྲ་སྣར་གཙེས་པའི་ས་རྡུལ་སྔར་བཞིན་ཡོད་པ་རེད།",
    "གསུམ་པ་ནི་ཕྱེ་འཐག་བཟོ་གྲྭས་སྔ་མོའི་དུས་ཚོད་བརྒྱད་ནས་ཕྱི་དྲོའི་དུས་ཚོད་བཅོ་བརྒྱད་བར་མ་གཏོགས་ལས་ཀ་མི་བྱེད་རྒྱུར་བརྩི་སྲུང་ནན་མོ་བྱེད་པ་དང་།",
    "དམིགས་བསལ་གྱི་གནས་ཚུལ་དང་འཕྲད་ནའང་ལས་ཀ་བྱེད་ཡུན་མཚན་མོའི་དུས་ཚོད་ཉེར་གཉིས་ལས་བརྒལ་མི་རུང་བ་སོགས་ནོར་བཟང་ལ་བཤད།",
    "གལ་ཏེ་ནོར་བཟང་གི་ལུས་ཕུང་བདེ་ཐང་ལ་གནོད་པ་བཟོས་ཡོད་ན་བཟོ་གྲྭ་ལ་སྐྱིན་ཚབ་འདོན་དགོས་པའི་བླང་བྱ་བཏོན་ཆོག་གལ་ཏེ་བཟོ་གྲྭའི་སྦགས་བཙོག་གིས་ནོར་བཟང་ལ་གནོད་པ་ངེས་ཅན་ཞིག་གམ་རྒྱུན་ལྡན་འཚོ་བ་ལ་གྱོང་གུན་དངོས་མ་བཟོས་ན།",
    "ལོའི་སྟོན་དུས་ནས་བཟུང་གྲོང་མི་རྣམས་ཀྱིས་དུས་རྒྱུན་ལྗིད་ཐེག་རླངས་འཁོར་ནང་གད་སྙིགས་དྲུད་ཡོང་ནས་ཞིང་སའི་ཉེ་འགྲམ་དང་ལུང་ཁུག་གྲམ་པའི་ནང་དུ་ཕོ་པ་རེད།",
    "ཀྲང་ཆེ་གེ་མོས་འགན་གཙང་ལེན་བྱས་པའི་ཞི་ཀཱ་ཞིང་ས་དང་མུན་ཆེ་གེ་མོས་འགན་གཙང་ལེན་བྱས་པའི་གྲོའི་ས་ཞིང་གཉིས་ཕན་ཚུན་འབྲེལ་ནས་ཡོད།",
    "མུན་ཆེ་གེ་མོས་སྐྱིན་ཚབ་འཇལ་དགོས་པའི་བླང་བྱ་བཏོན།",
    "བརྟག་བཤེར་ནན་མོ་བྱས་མཐར།",
    "མུའུ་རེར་ཡོང་སྒོ་སྒོར་དྲུག་བརྒྱ་དང་ལྔ་བཅུ་རེར་རྩིས་བརྒྱབ་ན་མུའུ་ཉི་ཤུ་ལ་ཞི་ཀཱ་ཡོང་སྒོ་སྒོར་ཁྲི་གཅིག་དང་སྟོང་གསུམ་ལྷག་ཡོད་དེ།",
    "མུའུ་རེའི་གྱོང་གུན་བརྒྱ་ཆའི་བདུན་ལྟར་རྩིས་བརྒྱབ་ན་ཀྲང་ཆེ་གེ་མོར་ཐེབས་པའི་གྱོང་གུན་སྒོར་དགུ་བརྒྱ་དང་བཅུ་ཐམ་པ་ཡིན།",
    "ཀྲང་ཆེ་གེ་མོས་འགན་གཙང་ལེན་བྱས་པའི་ཞི་ཀཱའི་ལྗང་མྱུག་ལ་གནོད་སྐྱོན་དང་གྱོང་གུན་ཚད་ངེས་ཅན་བཟོས་པ་དང་ཞི་ཀཱའི་ཐོན་ཚད་ལ་ཤུགས་རྐྱེན་ཐེབས།",
    "འབྲེལ་ཡོད་མི་སྣ་དང་མཉམ་དུ་ཡུལ་དངོས་སུ་སོང་ནས་རྩད་ཞིབ་བྱེད་དུས།",
    "རྡོ་སོལ་སྔར་བཞིན་མུ་མཐུད་དུ་རང་དགར་འབར་བ་དང་ཚ་བའི་དུ་སྨུག་གིས་དབུགས་འབྱིན་དཀའ་བ།",
    "ཝང་ཆེ་གེ་མོས་རྫས་འགྱུར་ཚད་ཡོད་ཀུང་སིའི་སྤྱིའི་ལས་གཉེར་བའི་ལས་རོགས་ཨན་ཆེ་གེ་མོ་ངོ་ཤེས་ནས་གྲོགས་པོར་གྱུར།",
    "རྫས་འགྱུར་ཀུང་སིས་བསྡུ་ལེན་གྱི་རིན་ཐང་མེད་པའི་རྫས་འགྱུར་གྱི་དངོས་རྫས་སྐོར་ཞིག་ཐག་གཅོད་བྱེད་པར་ཨན་ཆེ་གེ་མོ་བོས་ནས་གྲོས་བྱས།",
    "རླངས་འཁོར་རེ་ལ་སྒོར་དྲུག་བརྒྱ་བྱས་ནས་རྫས་འགྱུར་གྱི་ཟོག་རོ་དེ་ཐག་གཅོད་བྱེད་པར་ཁོ་གཉིས་གྲོས་འཆམ་བྱུང་།",
    "ཝང་ཆེ་གེ་མོའི་བསམ་པར།",
    "བསྡུ་ལེན་གྱི་རིན་ཐང་མེད་པའི་དངོས་རྫས་འདི་དག་ལོ་རེར་ཐེངས་གཅིག་ལ་ཐག་གཅོད་བྱས་ནས་ཁེ་སྤོགས་སྒོར་སྟོང་ལྷག་ཡོད་པས།",
    "ཝང་ཆེ་གེ་མོས་ཆོག་མཆན་མ་ཐོབ་པའི་གནས་ཚུལ་འོག་བསྡུ་ལེན་གྱི་རིན་ཐང་མེད་པའི་སྦགས་བཙོག་གི་ཟོག་རོ་དེ་དག་རླངས་འཁོར་གྱི་ཐེངས་གཉིས་དྲུད་ནས་ཙོང་ཆུའི་འགྲམ་དུ་བླུགས།",
    "ཝང་ཆེ་གེ་མོ་ནི་རླངས་འཁོར་རེར་སྒོར་དྲུག་བརྒྱ་ལ་ཧམ་པ་ལངས་ནས་རྫས་འགྱུར་དངོས་རྫས་ཙོང་ཆུའི་འགྲམ་དུ་བླུགས་པའི་བྱ་སྤྱོད་དེ།",
    "ཙོང་ཆུའི་སྨད་འགྲམ་དུ་འཚོ་བའི་མང་ཚོགས་ཀྱི་བདེ་ཐང་ལ་ཤུགས་རྐྱེན་ངན་པ་ཐེབས།",
    "གོང་གི་གྱོད་དོན་འདིའི་གནས་ཚུལ་གཞིར་བཟུང་ནས་དབྱེ་ཞིབ་བྱས་ན།",
