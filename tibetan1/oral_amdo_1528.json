    "ད་དུང་སྐལ་བཟང་གི་འབྲེལ་བ་བརྒྱུད་ནས་བཅད་པའི་ཤིང་སྡོང་གཡང་འབུམ་གྱིས་ཤིང་སྡོང་ལས་སྣོན་བཟོ་གྲྭར་བཙོང་རྒྱུར་ཐག་བཅད་པ་རེད།",
    "དགོང་མོའི་དུས་ཚོད་དྲུག་སྟེང་དོན་འགྲུབ་དང་སྟོབས་ལྡན།",
    "སྐལ་བཟང་ལ་ལོ་དྲུག་གི་དུས་བཅད་བཙོན་བཀག་དང་སྒོར་ཡི་ཆད་པ་བཅད།",
    "ཞུ་སྦྱོར་ཕྱི་མ་དབྱང་ཆེ་གེ་མོ་ནི་རྒྱལ་ཁབ་ཀྱི་ནགས་ལས་གཙོ་སྐྱོང་གི་ལས་བྱེད་མི་སྣ་བྱས་ཏེ།",
    "རང་མོས་ཀྱིས་མི་གཞན་ལ་ནགས་ཤིང་ལིའུ་ཧྥང་སྨི་ཆིག་སྟོང་སུམ་བརྒྱ་གཅོད་དུ་བཅུག་དེ་མིན་ནགས་ཤིང་གཅོད་མཁན་གྱིས་ནགས་ཤིང་གཅོད་སྐབས་ཆོག་མཆན་འཛིན་ཡིག་དང་བརྒལ་ནས་ལིའུ་ཧྥང་སྨི་ཆིག་སྟོང་ཉིས་བརྒྱ་བཅད་པས་ནགས་ཚལ་གྱི་ཐོན་ཁུངས་ལ་གཏོར་བརླག་ཚབས་ཆེན་བཟོས།",
    "ཁོས་མི་འགའ་ཁྲིད་ནས་དགོང་མོ་ས་རུབ་རྗེས་རླངས་འཁོར་ཞིག་བསྐོར་ནས་སྡོང་དམར་བརྐུ་རུ་སོང་།",
    "མི་གྲངས་ཇེ་མང་དུ་སོང་བ་དང་བསྟུན་ནས།",
    "ཕྱོགས་གཅིག་གིས་གཏོར་བརླག་བྱེད་པ་དེ་རེད།",
    "ས་ཆ་མི་ཉུང་བ་ཞིག་ན་ས་ཆུ་ཤོར་བའི་རྒྱ་ཁྱོན་སྔར་ལས་ཇེ་ཆེར་འགྲོ་བཞིན་ཡོད།",
    "རྒྱལ་སྲིད་སྤྱི་ཁྱབ་ཁང་གི་རྩྭ་ཐང་སྲིད་འཛིན་ས་ཁོངས་དེ་གའི་རྩྭ་ཐང་སྲུང་སྐྱོང་དང་།",
    "གྲོང་ཚོ་དང་གྲོང་རྡལ་སྐོར་གྱི་འཆར་གཞི་དང་དེ་བཞིན་འབྲེལ་ཡོད་འཆར་གཞི་གཞན་དག་བཅས་དང་མཐུན་སྦྱོར་ཡོང་བ་བྱ་དགོས།",
    "རྩྭ་ཐང་གཞི་ཁྱོན་ཆེ་བར་ཕྱོགས་བསྡུས་བཅོས་སྐྱོང་བྱ་རྒྱུ་དེ་རྒྱལ་ཁབ་ཀྱི་ས་ཁོངས་སྒྲིག་བཅོས་བྱ་རྒྱུའི་འཆར་གཞིའི་ནང་འགོད་དགོས་པ་དང་།",
    "འབུད་ཤིང་སོགས་བཟུང་ནས་ལྷུན་པོ་རི་འགོར་ལྷ་བསང་གཏོང་བའི་ལམ་དུ་ཆས།",
    "དུས་ཚོད་ཕྱེད་ཀ་ཙམ་ལ་ཧུར་ཐག་བྱས་མཐར་མེ་གསོད་ཐུབ་སོང་།",
    "ཉེ་བའི་ལོ་འགའི་ནང་དུ་དབྱར་རྩྭ་དགུན་འབུའི་རིན་གོང་ནི་ལྡབ་ནས་ལྡབ་འགྱུར་གྱིས་གོང་དུ་འཕེལ་བས་བོད་རིགས་མང་ཚོགས་ཀྱི་འཚོ་རྟེན་དུ་གྱུར་ནས་ལོ་རེར་ཡོང་འབབ་མི་ཉུང་བ་ཞིག་ཐོབ་བཞིན་ཡོད།",
    "ཁོ་ཚང་གི་རྩྭ་ས་ལ་གཏོར་བརླག་ཚབས་ཆེན་ཐེབས་འདུག་ཟེར་ནས་ཚེ་རིང་གིས་གསར་དུ་ཉོས་པའི་རླངས་འཁོར་དེ་སྐྱིན་ཚབ་ཏུ་བླངས།",
    "འཛམ་གླིང་གི་ས་སྒང་རིལ་པོ་འདི་ནི་ང་ཚོ་སྐྱེ་འགྲོ་ཡོངས་ཀྱི་ཐུན་མོང་གི་ཁྱད་ནོར་ཞིག་ཡིན་པ་མ་ཟད།",
    "སྐྱེ་འགྲོ་ཡོངས་ཀྱི་ཚེ་སྲོག་གི་འབྱུང་ཁུངས་དང་འཚོ་གནས་ཀྱི་རྟེན་གཞི་ཉག་ཅིག་ཡིན།",
    "དེའི་ཐོན་ཁུངས་ཡོད་ཚད་ལ་བག་མེད་ངང་བཤུ་གཞོག་བྱེད་པ་ནི་ང་ཚོ་རང་ཉིད་ཀྱི་ཚེ་སྲོག་གི་རྩ་བར་རང་ཉིད་ཀྱིས་གཏོར་བརླག་བྱེད་པ་དང་ཁྱད་པར་མེད།",
    "རྗེས་རབས་མི་ཐོག་རྣམས་ལའང་འཇིག་ཉེན་ཡོད་པའི་དོན་རྐྱེན་འདི་དག་ལ་ཁ་གཏད་གཏོང་ལེན་ཇི་ལྟར་བྱེད་པའི་ཐད་ལ་ང་ཚོ་ཚང་མས་བསམ་བློ་ཞིབ་ཏུ་གཏོང་དགོས་པ་ཞིག་ཡིན།",
    "ང་ཚོ་སྐྱེ་འགྲོ་རེ་རེའི་ངོས་ནས་སྣོད་བཅུད་ཉམས་པ་སོར་ཆུད་དང་།",
    "རྩྭ་ས་བྱེ་འགྱུར་དུ་སོང་བ་དེ་ནི་ཚེ་རིང་དང་ཀླུ་རྒྱལ་གཉིས་ཀྱིས་གླས་པའི་མི་རྣམས་ཀྱིས་བསམ་བཞིན་དུ་རྩྭ་ཤུན་བཀོག་ནས་གནོད་པ་ཚབས་ཆེན་མ་ཐེབས་ན་སྐྱིན་ཚབ་འཇལ་མི་དགོས།",
    "གཡུ་བཟང་རྩྭ་ཐང་དུ་རླངས་འཁོར་དེ་དག་སོང་ཤུལ་དུ་ཤུར་བརྐོས་ཡོད་པ་གང་སར་མཐོང་ཐུབ།",
    "ཁྱིམ་ཚང་གི་ཁ་ཟས་ཙམ་རྒྱུན་འཁྱོངས་བྱ་རྒྱུ་ཡང་དངོས་གནས་དཀའ་ཁག་ཆེན་པོ་ཡོད་པའི་གནས་སུ་སླེབས་ཡོད།",
    "གསེར་རྐོ་རུ་ཁག་གིས་གཏེར་ཁ་སྔོག་འདོན་ལས་རྩྭ་སར་གཏོར་བརླག་ཚབས་ཆེན་བཟོས་པ་དང་།",
    "ལོ་རེའི་དབྱར་ཁའི་དུས་སུ་ཡུལ་དེར་ཡུལ་སྐོར་ལ་ཡོང་མཁན་ཡང་སྔར་ལས་ཇེ་མང་དུ་འགྲོ་བཞིན་ཡོད།",
    "ཁོས་ཀྱང་རང་གི་འགན་གཙང་ལེན་བྱས་པའི་རྩྭ་ས་མུའུ་ལྷག་རྐོ་སློག་བྱས་ནས་ཞིང་ས་རུ་བསྒྱུར།",
    "ལོར་ཁོས་སྐེ་ཚེ་བཏབ་སྟེ་སྒོར་ཁྲི་གསུམ་ལྷག་གི་ཡོང་སྒོ་བཙལ།",
    "ཨ་ཁུ་བརྩོན་འགྲུས་ཀྱི་བྱ་སྤྱོད་དེ་ནི་རྩྭ་སའི་སྔོ་ཁེབས་ལ་གཏོར་བརླག་ཚབས་ཆེན་བཟོས་པས།",
    "གཏེར་ཁའི་ཐོན་ཁུངས་རྩད་ཞིབ་བྱས་པའི་དང་ཐོག་གི་ས་གཤིས་གནས་ཚུལ་ཟིན་དེབ་བསྒྲིགས་རིགས་དང་དཔེ་རིས།",
    "ཐུན་མོང་གི་གཏེར་ཁའི་ཁེ་ལས་དང་ཁེར་རྐྱང་གིས་གཏེར་འདོན་བྱེད་པར་རྒྱལ་ཁབ་ནས་ཧུར་བརྩོན་ཆེན་པོས་རོགས་སྐྱོར་དང་།",
    "ཐུན་མོང་གི་གཏེར་ཁའི་ཁེ་ལས་དང་ཁེར་རྐྱང་གིས་གཏེར་འདོན་བྱེད་པའི་ལག་རྩལ་ཆུ་ཚད།",
    "རྡོ་སོལ་གཏེར་ཁུངས་ག་གེ་མོས་སྔོག་འདོན་བྱེད་སའི་དོང་ངོས་ལ་ཆུས་བརླན་བཟུང་ནས་འགད་རྫས་རྒྱག་པར་དཀའ་ཁག་ཆེ་ལ།",
    "ཝ་སི་འབར་རུང་བའི་རླངས་པ་ཇེ་ཉུང་དུ་སོང་ནས་ཆུས་བསྣུབས་པའི་དོན་རྐྱེན་བྱུང་བ་དང་།",
    "དོན་རྐྱེན་ཞིབ་བཤེར་ཚན་ཆུང་གིས་རྩད་ཞིབ་དང་དབྱེ་ཞིབ་བྱས་པ་ལྟར་ན།",
    "བདེ་མཆོག་གིས་དོན་དག་འདི་ནི་མི་ལུས་བདེ་ཐང་དང་ཚེ་སྲོག་ལ་འབྲེལ་བ་ཡོད་པས།",
    "ད་རེམ་པར་སོང་ནས་ལས་ཀ་མི་ལས་ན།",
    "བདེ་མཆོག་ལའང་བྱ་ཐབས་གཞན་མེད་པར་དོང་ནང་དུ་སོང་ནས་ལས་ཀ་ལས།",
    "བདེ་མཆོག་སོགས་ལས་བཟོ་བ་མི་ཚང་མ་རྐྱེན་ལམ་དུ་ཤོར་སོང་ལ།",
    "གཏེར་བདག་གི་བྱ་སྤྱོད་དེ་འགྲིག་གམ།",
    "གཏེར་བདག་གིས་དང་ལེན་མ་བྱས་པའི་ཁར།",
    "ཆུ་བོ་གལ་ཆེན་དང་ཆུ་རགས་གཡས་གཡོན་གྱི་བར་ཐག་ངེས་ཅན་ཞིག་གི་འགྲམ་དུ།",
    "ཆུ་བོ་གལ་ཆེན་དང་ཆུ་རགས་གཡས་གཡོན་གྱི་བར་ཐག་ངེས་ཅན་ཞིག་གི་ནང་གཏེར་རྫས་ཐོན་ཁུངས་སྔོག་འདོན་བྱས་མི་ཆོག་ཅེས་པའི་གཏན་ཁེལ་དང་འགལ་འདུག་འབྲུག་རྒྱལ་གྱིས་དཔང་ཡིག་མེད་པར་སྔོག་འདོན་བྱས་པ་ལས།",
    "ལྕགས་ལམ་དང་གཞུང་ལམ་གལ་ཆེན་གྱི་གཡས་གཡོན་གྱི་བར་ཐག་ངེས་ཅན་ཞིག་གི་ནང་།",
    "ཆུ་རྒྱུན་གལ་ཆེན་དང་ཆུ་རགས་གཡས་གཡོན་གྱི་བར་ཐག་ངེས་ཅན་ཞིག་གི་ནང་།",
    "རྡོ་སོལ་གྱི་བསགས་འབོར་ཡང་ཧ་ཅང་མང་བ་དེ་རེད།",
    "ཁོས་སེམས་སུ་འདི་ནི་གནམ་རྒན་མས་རང་ལ་གནང་བའི་ནོར་བུ་རེད་སྙམ་སྟེ།",
    "མགོན་པོའི་གདོང་ལ་སྐྱིད་པའི་ཉི་མ་ཞིག་ཤར་འདུག་དེ་ནས་མགོན་པོས་ལག་གང་མྱུར་ལ་བསྟེན་ནས་རང་གི་ཁྱིམ་མི་རྣམས་རྩ་འཛུགས་བྱས་ཏེ།",
    "ཐུན་མོང་དང་མི་སྒེར་གང་ཡིན་རུང་།",
    "ང་ཚོ་ནི་ཀྲུང་ཧྭ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱི་ཁྱོན་ཡངས་པའི་ས་གཞིའི་སྟེང་འཚོ་གནས་བྱེད་བཞིན་ཡོད།",
    "ང་ཚོའི་ས་གཞི་འདིའི་ག་ས་གང་དུ་ཧ་ཅང་དཀོན་པའི་གཏེར་རྫས་ཐོན་ཁུངས་རིགས་མང་བོ་ཞིག་ཡོད།",
    "ང་ཚོར་ཁང་བ་གསར་སྐྲུན་བྱེད་པ་དང་།",
    "ཝང་ཆེ་གེ་མོས་དེར་ཁ་ཡ་མ་བྱས་པར་སྔར་བཞིན་གཏེར་ཁ་སྔོག་འདོན་བྱས།",
    "གཏོར་བརླག་གི་བྱ་སྤྱོད་ཡོད་ལ་གཏོར་བརླག་གི་མཇུག་འབྲས་མེད་ན་བྱས་ཉེས་སུ་མི་གྲུབ་པ་ཡིན།",
    "ལོའི་ལོ་སྟོད་དུ་ལིག་ཆེ་གེ་མོས་བྱ་ཆེ་བ་ཚང་མ་བཙོང་སྟེ་རྩིས་བརྒྱབ་ནས་ཤེས་གསལ་ལྟར་ན།",
    "གོང་གསལ་དོན་དག་དེ་ལས་ལིག་ཆེ་གེ་མོར་ཁེ་སྤོགས་སྒོར་ཁྲི་གཅིག་ལྷག་གི་གྱོང་གུད་ཐེབས་པ་རེད།",
    "ཁྱིམ་བྱ་འགའ་རེ་ཤི་བའི་སྣང་ཚུལ་ཡང་བྱུང་ཡོད།",
    "ཁྱིམ་བྱ་གསོ་སྤེལ་ར་བ་བཙུགས་པའང་འབྲེལ་ཡོད་གཏན་ཁེལ་དང་འགལ་མེད་པ་རེད་ཟེར།",
    "བཟོས་པའི་རྐྱེན་གྱིས་སྒོ་ང་གཏོང་ཚད་ཇེ་དམའ་རུ་སོང་བས་ན།",
    "ཉེ་འཁོར་ཁྱིམ་བྱ་གསོ་སྤེལ་ར་བའི་བྱ་ཁྱུའི་སྒོ་ང་གཏོང་ཚད་ཇེ་དམའ་རུ་བཏང་བའི་གྱོད་གཞི་ཞིག་རེད།",
    "དོན་གྲུབ་ཚང་གི་དབྱར་སའི་སྟེང་དུ་རྡོ་སོལ་གཏེར་ཁ་ཡོད་པ་ཤེས་ནས།",
    "དོན་གྲུབ་ཀྱིས་ལྐོག་ཏུ་ས་སློག་འཕྲུལ་ཆས་ཉོས་ནས་རྡོ་སོལ་འབོར་ཆེན་སློག་པ་རེད།",
    "ཡིན་ཡང་ཞིང་བ་མི་སྒེར་གྱིས་གཏེར་ཁ་བརྐོ་མི་ཆོག་པ་མ་རེད།",
    "རང་བྱུང་གི་རྗེས་ཤུལ།",
    "རྒྱ་མཚོར་སྦགས་བཙོག་དངོས་རིགས་གཏོང་འབུད་དང་།",
    "ཐལ་རྡུལ།",
    "ཚད་བརྒལ་བཙོག་འབུད་ཀྱི་རིན་དོད་བསྡུས་རིགས་ངེས་པར་དུ་སྦགས་བཙོག་འགོག་སེལ་བྱེད་པར་སྤྱོད་དགོས་པ་ལས་གཞན་སྤྱོད་མི་རུང་བ་དང་།",
    "སྲིད་འཛིན་ཐོག་གི་ཆད་པ་བཅད་པ་དོ་བདག་གི་བློ་མོས་སུ་མ་བབས་ན།",
    "དོན་དོ་བདག་གི་བློ་མོས་སུ་མ་བབས་ན།",
    "དོ་བདག་གིས་སྦགས་བཙོག་གི་གནོད་གུན་ཐེབས་ཚུལ་ཤེས་པའམ་ཤེས་དགོས་པའི་དུས་ནས་བརྩི་རྒྱུ།",
    "རྒྱལ་ཁབ་ཀྱི་རྩ་ཆེ་བའི་རི་སྐྱེས་སྲོག་ཆགས་སྲུང་སྐྱོང་གི་རིགས་བཏུལ་ནས་རྒྱུད་སྤེལ་བར་ཆེད་གཉེར་འཛིན་ཡིག་ལེན་དགོས།",
    "རྒྱལ་སྲིད་སྤྱི་ཁྱབ་ཁང་གིས་ཆོག་མཆན་གནང་དགོས།",
    "རྒྱལ་ཁབ་ཀྱི་ཚན་རིག་ལག་རྩལ་གྱི་གསང་བ་དང་འབྲེལ་བའི་རི་སྐྱེས་སྲོག་ཆགས་ཡིན་ན་རྒྱལ་སྲིད་སྤྱི་ཁྱབ་ཁང་གི་གཏན་འཁེལ་ལྟར་བསྒྲུབ་དགོས།",
    "ཕྱི་རྒྱལ་གྱི་མིས་ཀྲུང་གོའི་མངའ་ཁོངས་སུ་རྒྱལ་ཁབ་ཀྱི་རྩ་ཆེའི་རི་སྐྱེས་སྲོག་ཆགས་ལ་རྟོག་ཞིབ་དང་བརྙན་དང་གཟུགས་ལེན་པ་སོགས་ལ་ངེས་པར་རྒྱལ་སྲིད་སྤྱི་ཁྱབ་ཁང་གི་ཆོག་མཆན་ཐོབ་དགོས།",
    "རྔོན་ཆོག་པའི་དཔང་ཡིག་མ་བླངས་པའམ་དཔང་ཡིག་གི་གཏན་འཁེལ་དང་འགལ་ནས་རྔོན་མཁན་ལ།",
    "རྔོན་ཆོག་པའི་དཔང་ཡིག་དང་བཏུལ་ནས་རྒྱུད་སྤེལ་ཆོག་པའི་དཔང་ཡིག་ཕྱིར་གཏོང་བྱེད་ཆོག་པའི་དཔང་ཡིག་སོགས་རྫུན་བཟོ་དང་ཚོང་ལོག་རྒྱག་མཁན་གྱི་གནས་ཚུལ་ཚབས་ཆེན་ཡིན་ན།",
    "དོ་བདག་གིས་སྲིད་འཛིན་ཁྲུའུ་ཡིས་ཐག་གཅོད་བྱས་པར་འཐད་པ་མ་བྱུང་ཚེ།",
    "ནགས་ཚལ་དང་རྩྭ་ཐང་ཁེབས་ཁྱོན་ཆེ་རུ་གཏོང་བ།",
    "ཆུ་རྩྭ་སྲུང་འཁྱོངས་བཅས་བྱས་ཏེ་ས་ཆུ་ཤོར་ཚུལ་སྔོན་འགོག་དང་ཇེ་ཆུང་དུ་གཏོང་དགོས།",
    "དོ་དམ་དང་སྲུང་སྐྱོང་གི་འགན་འཁྲི་དོན་ཐོག་ཏུ་འཁྱོལ་བ་བྱས་ཏེ་དེའི་ནུས་པ་རྒྱུན་ལྡན་ངང་འདོན་སྤེལ་ཡོང་བར་འགན་སྲུང་བྱ་དགོས།",
    "གཞི་ཁྱོན་ལུགས་དང་མཐུན་པ་གཏན་འཁེལ་བྱས་ཐོག་ས་ཆུ་སྲུང་འཛིན་བྱ་ཐབས་སྤྱད་ནས་ས་ཆུ་ཤོར་ཚུལ་བཀག་འགོག་བྱ་དགོས།",
    "ནགས་ཚལ་དང་རྩྭ་ཐང་གཏོར་བཤིག་བཏང་ནས་གསར་སྦོལ་དང་འདྲེ་མོ་སྐྲ་ལུད་གཉེར་འཐུ་བྱེད་པར་གཏན་འགོག་བྱ་དགོས།",
    "རྩྭ་ཞིང་རེས་འདེབས།",
