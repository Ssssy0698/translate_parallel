    "ཕྲུ་གུ་བཞི་བརྒྱ་སྐྱེས་ནས་འདུག་གོ།",
    "སྤུ་དང་མཇུག་མ་མེད་པ་ཤིང་ལ་མི་ཐར་བ་ཤི་ལ་ཁད་པ་ཁ་དམར་ཏིང་ཏིང་འདུག་པས།",
    "ཁོང་རྣམས་ཀྱིས་སྣེ་མའི་གྲངས་བགྲངས་པས་འབྲུའི་གྲངས་ཁྲི་ཁྲི་འདུག་ནས་ཡར་ལུངས་ཁྲི་ཐང་ཞེས་ཀྱང་བྱའོ།",
    "དུས་དེ་ཙ་ན་བེམ་པོའི་རྒྱལ་པོ་ཆེན་པོ་བཞི་བྱུང་སྟེ།",
    "འོད་ནི་རང་རང་ལ་ཡོད་པ་དེ་དེ་ནི་བསྐལ་པ་ཕྲན་བུ་ཞིག་གནས་སོ།",
    "འོད་ནི་རང་རང་ལ་བྱུང་སྟེ་མུན་པའི་བསྐལ་པ་སངས་སོ།",
    "ཁས་བླངས་པ་དེ་ཆད་མ་བཙན་ནས་དེའི་བར་དུ་ཚོང་བ་ཨ་རི་ལིས་ཀར་ཤ་པ་ནི་ལྔ་བརྒྱ་བྱིན་ནས་སྨད་ཚོང་མ་འགྲོ་བཟང་ངའི་ཕག་ཏུ་ཤོག་ཅིག་བྱས་པས་སྔོན་ལ་ཚོང་བ་ཨ་ཀི་ལིའི་ཕག་ཏུ་ཕྱིན་ཏེ་དགའ་མགུར་སྤྱོད་ཀྱིན་ཡོད་ཙ་ན།",
    "དེ་ནས་དེ་གཉིས་བསད་འདུག་གོ་ཟེར་ནས།",
    "དུས་དེ་ཙ་ན་རྒྱ་གར་གྱི་རྒྱལ་པོ་དམག་བརྒྱ་བའི་སྲས་རྒྱལ་བུ་རུ་པ་སྐྱེས་ཞེས་བྱ་བ་སྲིད་གཡས་བག་པ་ཕྱུའི་ལྷ་དེས།",
    "ལྷ་བཙན་པོ་དེ་ངོ་མཚར་ཆེ་བ་འདུག།",
    "རྒྱལ་པོ་བཞི་ནི་སོ་སོ་རང་རང་ནས་གླིང་བཞི་དང་གསུམ་དང་གཉིས་དང་གསེར་དངུལ་ཟངས་ལྕགས་འཁོར་ལོ་བསྒྱུར་བྱ་བ་ཡིན་པས་རྒྱལ་པོ་བཞི་ནི་རིམ་པ་བཞིན་ཡིན་ནོ།",
    "མ་སངས་ཀྱི་མདའ་ནི་ཕ་བོང་ལ་འདེམ་ཚུགས་ཙམ་འདུག་པའི་དུས་ན།",
    "ཕ་བོང་ལ་མདའ་ལྡེམ་མེ་དང་སྒོ་རིབ་བེ་འདུག་གོ།",
    "རྒྱལ་པོ་དང་མ་སངས་ཀྱི་བར་དུ་མདའ་སྒྲོ་རིབ་བེ་བ་དེ་རྒྱལ་པོའི་ཡིན་པ་ལ་མ་སངས་ཀྱི་མདའ་ཡིན་ཟེར་གྱིན་འདུག།",
    "ཐུགས་ཀྱི་མཆོད་རྟེན་བུམ་པ་བཞེངས་མ་གྲུབ་པར་འདུག་པས་ད་དེའི་ཕྱག་རྗེས་ངས་བྱེད་དགོས་ཟེར་རོ།",
    "དེའི་སྟེང་ན་ཟིལ་བ་ཕྲུམ་མེ་ལ་སྔར་བས་ལེགས་པ་ཞིག་བྱས་འདུག་ནས།",
    "དེ་ངོ་མཚར་ཆེ་བ་ཞིག་འདུག་ནས།",
    "ཡབ་ཀྱི་ཐུགས་དགོངས་ལ་ངའི་སྲས་འདི་ངོ་མཚར་བ་ཞིག་འདུག་པས།",
    "ཙན་དན་གྱི་སྒྲོལ་མ་རང་བྱོན་དུ་བཞུགས་པ་རྣམས་བོད་དུ་འབྱོན་པར་འདུག།",
    "རིག་པའི་བསྟན་བཅོས་ཐམས་ཅད་ལ་མངའ་བརྙེས་པ་ཞིག་བཞུགས་འདུག་པས།",
    "བློན་པོ་ལ་ཆང་དྲོངས་གསུངས་ནས་ཐོན་མིས་ཆང་དྲངས་ནས་གསོལ་ཙ་ན།",
    "དེ་ནས་ཁོང་ཁྲོས་ནས་བྱུང་ཙ་ན།",
    "དེ་ནས་ཁོང་ཁྲོས་ནས་བྱུང་ཙ་ན།",
    "ངས་ཁོ་བོའི་བློན་པོ་ལ་ཇི་ལྟར་བྱས་པ་ཁོའི་སྒྲོམ་བུས་ལན་ཐེབས་པ་ཞིག་འདུག་སྟེ།",
    "སྤྲུལ་པའི་སྐུ་ཐུབ་པར་དཀའ་བ་ཞིག་ཡོད་འདུག་སྙམ།",
    "བདེན་ན་ང་བས་ཁོ་བཟང་བར་འདུག།",
    "ཁོའི་སྒྲོམ་བུས་ཐེབས་ཀྱིན་འདུག་སྙམ་ནས་བྱེད་ཆུམ་ཆུམ་བྱུང་ནས།",
    "མཐིང་ཤོག་ལ་གསེར་དངུལ་ཟངས་གསུམ་གྱིས་བལ་པོའི་སྐད་དུ་ཡི་གེར་བྲིས་ནས་འདུག་པ་དེ་བཀླགས་པས།",
    "ཁོའི་སྒྲོམ་བུའི་ཡི་གེས་ཐེབས་ཀྱིན་འདུག།",
    "བལ་པོའི་སྐད་དང་ཡི་གེ་ཤེས་པ་དེ་སྤྲུལ་པའི་སྐུར་ཡོད་པར་འདུག།",
    "བོད་ཀྱི་རྒྱལ་པོ་ཁོང་རང་གསུངས་པ་བཞིན་དུ་བདེན་པར་ཡོད་འདུག་པས།",
    "དེ་བདེན་ཙ་ན་ང་བས་ཁོ་བཟང་འདུག་པས་བོད་ཀྱི་རྒྱལ་པོ་དེ་ལ།",
    "ཚུར་ལ་ལོང་ཡོང་ཙ་ན་བྱ་ཁྭ་ཏའི་སྐད་ཀྱིས་མ་ནོན་པ་ལ་ལོག་ཤོག་གསུང་ངོ།",
    "རྒྱ་ནག་སྟོང་ཁུན་གྱི་སྐད་དང་ཡི་གེ་མཐིང་ཤོག་ལ་གསེར་གྱི་བྲིས་ནས་འདུག་པ་དེ་བཀླགས་པས།",
    "ངས་ཁོའི་བློན་པོ་ལ་ཇི་ལྟར་བྱས་པ་ཁོའི་སྒྲོམ་བུས་ལན་ཐེབས་པ་ཞིག་འདུག་པས་སྤྲུལ་པའི་སྐུ་ཐུབ་པར་དཀའ་བ་ཞིག་འདུག་སྙམ།",
    "ཁྱེད་ཀྱི་རྒྱལ་པོ་དེས་ང་ལ་སྡིག་ར་རང་གཏོང་བ་ཞིག་འདུག་རུང་དེས་མི་ཡོང་།",
    "འདི་བདེན་ན་ང་བས་ཁོ་བཟང་བར་འདུག།",
    "ངས་ཁོའི་བློན་པོ་ལ་ཅི་སྐད་སྨྲས་པའི་ལན་ཁོའི་སྒྲོམ་བུས་ཐེབ་ཀྱིན་འདུག་སྙམ་བྱེད་ཆུམ་ཆུང་བྱུང་ནས།",
    "དེ་བས་ན་ཤཱཀྱ་ཐུབ་པ་གཙོ་ཆེར་བར་འདུག་པས།",
    "ངས་ཅི་སྐད་བོད་བློན་ལ་དྲིས་པའི་ལན་དེ་ཁོའི་སྒྲོམ་བུའི་ཡི་གེས་ཐེབས་ཀྱིན་འདུག།",
    "ཁོང་རང་ཇི་ལྟར་གསུངས་པ་བཞིན་དུ་བདེན་པར་ཡོད་འདུག།",
    "དེ་བདེན་ཙ་ན་ང་བས་ཁོ་བཟང་བར་འདུག་སྙམ་ནས།",
    "ལྷ་ཅིག་ཨོང་ཅོང་འདི་ལག་ལེན་མཐའ་གཞུག་བོད་ཡུལ་དུ་གཏོང་དགོས་པར་འདུག་སྟེ།",
    "ད་བློན་པོ་ཁྱེད་རང་རྣམས་རིག་པ་སུ་རྣོ་བ་ཞིག་ལ་སྦྱིན་ནོ་གསུངས་ནས།",
    "བློན་པོ་ཚན་པ་བཞི་པོ་ལ་རྒྱལ་པོ་ཡང་རྩིས་ཆེ་བར་འདུག།",
    "ཁྱེད་རྣམས་སྔོན་ལ་གཡུ་ལུང་ཚུད་ཅིང་ཐོགས་པར་འདུག་ལྟོས་བྱས་པས།",
    "ཁོང་རང་འདུག་སའི་སྒོའི་ཡ་ཐེམ་ལ་མཚལ་གྱི་རྡོ་རྗེ་ཞིག་བྲིས།",
    "བློན་པོ་གཞན་རྣམས་ཀྱིས་འགྲོ་ས་མ་ཤེས་པར་གནས་ཁང་འཆོལ་ནས་ནོར་འདུག།",
    "དེ་ཚོའི་གསེབ་ནས་ཁྱེད་རང་རྣམས་སུས་ཤེས་པ་དེ་ལ་སྟེར་བ་ཡིན་གསུང་བྱུང་བ།",
    "བོད་ཀྱི་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོ་དེས་སྤྲུལ་པ་ལ་མི་ཤེས་པ་དང་མི་ཡོང་བ་མི་འདུག།",
    "དེ་འདྲ་ཇི་ལྟར་འདུག་དྲིས་པས།",
    "ཉིན་ཞིག་ཙ་ན་རྒྱལ་པོ་ཆེན་པོ་དེ་བྱོན་ནས།",
    "བློན་པོའི་རྩ་དེ་ཚོར་ལུད་པ་བསྒྱུར་འདུག་པ་ཡང་རྣག་ཁྲག་ཏུ་བྱུང་།",
    "འདི་འདྲ་ལ་ངས་བཅོས་ཐབས་མི་ཤེས་པས་ཁོ་རང་ལ་དྲིས་ཟེར་རོ།",
    "བློན་པོ་ཁོ་རང་ལ་ཅི་ཕན་དྲིས་པས་ལྟོ་ཆོག་ཕན་ཆ་འདི་འདྲ་དགོས་ཟེར་བས།",
    "ལར་ང་རང་འཆི།",
