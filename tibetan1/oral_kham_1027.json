    "དེ་ལ་དེ་མི་ལྡན་པར་ཁྱེད་རང་ཁས་ལེན་པ་ལྟར་འདིར་ཡང་དེ་བཞིན་གྱི་ཕྱིར་རོ།",
    "དེའང་འཕགས་པ་ལ་རོ་མྱོང་བ་མེད་ཀྱང་སོ་སོའི་སྐྱེ་བོའི་དུས་ཀྱིས་རོ་མྱང་བར་བྱ་བའི་ཡུལ་དེ་དང་རིགས་གཅིག་ཏུ་འདུག་པས་རོ་མྱོང་ཟེར།",
    "ཡང་ན་རོ་མྱོང་རང་ཡང་ཡོད་དེ།",
    "འགོག་པ་ཕ་རོལ་གྱི་སེམས་མིན་ཙ་ན།",
    "ལམ་ཤེས་གཉིད་དང་མཚུངས་ལྡན་གྱི་ཤེས་པ་མིན་པས་དེས་གཉིད་མི་ཤེས་ཙ་ན།",
    "ཡན་ལག་འདི་དག་དུས་ཕྱིས་དུས་གཅིག་ཏུ་བསྒོམས་ལ།",
    "རྒོད་པ་ནི་བག་ལ་ཞ་བར་འདུག་པ་དེ་ནི་ཞུམ་པ་ཡིན་ལ།",
    "གང་ལ་རྒོད་པ་ལྷག་ལ་ལེ་ལོ་བག་ཞ་བར་འདུག་པ་དེ་རྒོད་པ་ཡིན་པས་འདི་གཉིས་ཀྱི་བྱེ་བྲག་ཡོད་པའི་ཕྱིར།",
    "བདེན་བཞིའི་ནང་ན་ལམ་ཡོད་ཙ་ན།",
    "གཞན་རྒྱུད་ལ་ཡོད་པ་བསྒོམ་མི་ནུས་ཤིང་རང་རྒྱུད་ལ་རྙེད་ཟིན་བརྒྱའི་ཆར་ཡང་མངོན་དུ་བྱར་མི་ནུས་པའི་ཕྱིར།",
    "དངོས་སུ་ནི་དང་པོའི་ཡིན་ཙ་ན།",
    "ཁམ་ཟས་ལ་འདོད་ཆགས་དང་བྲལ་བས་ལས་ཀྱིས་གྲུབ་པར་མི་འདུག་ཅིང་།",
    "དག་དང་རང་ལས།",
    "དེས་ན་གནས་གཞན་གསུམ་གསུམ་པོ་རྣམས་དང་བརྒྱད་པོ་ལྟག་ལོག་ཏུ་འདུག་ཀྱང་རང་ས་རང་ས་གཅིག་པར་འགྲུབ་སྟེ།",
    "བརྒལ་ནས་གཟིངས་ལ་འཆེལ་ཏེ་མི་འདུག་པ་ལྟར་ལམ་ལ་བརྟེན་ནས་སྲིད་པ་ལ་བརྒལ་ཡང་ལམ་ལ་བརྟེན་ཏེ་མི་འདུག་པ་བཞིན་ནོ།",
    "དེས་ན་མི་སློབ་པའི་ཏིང་ངེ་འཛིན་གྱིས་སོ་སོར་མ་བརྟགས་པས་ཟད་པ་སྟེ་འགོག་པ་ལ་དམིགས་ནས་འདུག་པ་ཆད་པའི་མཚན་ཉིད་ཅན་ཞི་བའི་རྣམ་པ་ཁོ་ནར་བལྟས་ཏེ།",
    "འགོག་པའི་སྙོམས་འཇུག་འདོད་པ་སྙོམས་པར་ཞུགས་ན་འདོད་པ་བ་ནི་ཁམ་ཟས་ཀྱི་འདོད་ཆགས་དང་མ་བྲལ་བས་ཁམ་གྱི་ཟས་འཚོལ་བ་ནི་ཁམ་གྱི་ཟས་དང་བྲལ་ན་ཞག་བདུན་ལས་མི་ཐུབ་ཙ་ན་ཞག་བདུན་གྱིས་མི་འདོ་བར་སྐལ་པ་ལ་སོགས་པར་ཁམ་ཟས་མ་གསོལ་བས་ནམ་བཞེངས་པའི་དུས་སུ་འགྲངས་པ་ཡིན།",
    "དེ་ཉིད་མ་མཐོང་རང་གར་གྱུར་པ་ཡི།",
    "རང་བྱུང་རང་བྱུང་བསྟན་པ་གཅེས་འཛིན་རྣམས།",
    "བགྱི་བ་བཏང་སྟེ་འདུག་པ་ན།",
    "མཚུར་ཕུའི་ཕྱག་དཔེའི་ཁྲོད་ནས་བྲིས་མ་ཞིག་གཡར་བ་དེ་གཉིས་ཀྱང་སྤྱི་དོན་ཚིག་དོན་སོགས་གང་ཐད་ནས་ཁྱད་ཆེ་བ་ལྟ་བུས་མཚུངས་པ་ཆེར་མི་འདུག།",
    "ཕྱིས་ཡང་བཅོས་མཛད་རྒྱུ་སོགས་ག་འདྲ་གནང་བ་ཡིན་རུང་དཔེ་མང་པོ་རྣམས་གཅིག་པ་ལྟ་བུའི་མཚུངས་རྒྱུ་ནི་གཏན་ནས་མེད་འདུག་པ་ལྟར།",
    "སྤར་མ་གཉིས་སོ་སོར་ཡེ་མི་མཚུངས་པར་འདུག་ཀྱང་།",
    "༢ དོན་དམ་གྱི་རྣམ་གྲངས་གཞན་མང་པོ་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ་ལ་གཉིས།",
    "༢ དོན་དམ་གྱི་མཚན་བརྗོད་དུ་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ་ལ་བཞི།་",
    "ཀྱེ་མི་ང་ནི་གཏེར་ཆེན་པོ་སྟེ་སས་གཡོགས་ཞིང་འདུག་གོ་ཞེས་མི་སྨྲ་སྟེ།",
    "བདེན་པ་ཉིད་དེ་ནི་ནམ་ཡང་གང་ནའང་འདུག་པ་སྟེ།",
    "འདི་དག་ཀྱང་རང་བཞིན་གྱི་རིགས་སོ།",
    "གང་ཞིག་གང་ན་མེད་པ་མེད་དགག་དང་རང་སྟོང་དང་མེད་ཙམ་དང་སྟོང་ཙམ་ལ་དགོངས་པ་ཡིན་ལ།",
    "དེ་བཞིན་ཉིད་དང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་འདས་པ་དང་།",
    "ཡེ་ཤེས་ལ་ཡང་རང་བྱུང་གཞན་བྱུང་དང་།",
    "གནས་ལུགས་ལ་ཡོད་མེད་དང་རང་སྟོང་གཞན་སྟོང་དང་མེད་དགག་མ་ཡིན་དེབ་ཕྲེང་གཉིས་པ།",
    "དེ་བཞིན་དུ་རང་སྟོང་དང་མཚན་མ་མེད་པའི་དབྱིངས་རྣམ་གྲངས་སུ་འདོད་ན་མཚན་མ་འགགས་པའི་དངོས་པོ་རྣམས་ཀྱང་རང་སྟོང་ཡིན་པའི་ཕྱིར་མཚན་མ་མེད་པའི་དབྱིངས་ཡིན་པར་འགྱུར་ལ།",
    "སྒྲིབ་པ་གཉིས་ཀྱང་རང་སྟོང་ཡིན་པའི་ཕྱིར་དོན་དམ་པའི་བདེན་པར་འགྱུར་ལ།",
    "༢ གཉིས་པ་དོན་དམ་གྱི་རྣམ་གྲངས་གཞན་བསྟན་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ་ལ་གཉིས།",
    "གཉིས་པ་དོན་དམ་གྱི་མཚན་བརྗོད་དུ་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ་ལ་བཞི།",
    "ཡོངས་སུ་དག་པའི་ཕུང་པོ་ཁམས་སོགས་རྣམས་ཏེ་དེ་ཡང་རང་བྱུང་ཡེ་ཤེས་དོན་དམ་གྱི་ལྷ་ཚོགས་རྣམས་སོ།",
    "ཕྱི་མ་འདི་གཉིས་ཀྱིས་ཀྱང་རང་སྟོང་དང་གཞན་སྟོང་བསྟན་པ་ཡིན་ལ།",
    "དེ་ལ་ཟ་བ་དང་བཟའ་བ་ལ་སོགས་པ་ནི་རང་རང་ངོ་བོས་སྟོང་བའི་ཕྱིར་གང་ཞིག་གང་ན་མེད་པ་སྟེ་ཅིར་ཡང་མ་གྲུབ་ཅིང་ཅུང་ཟད་ཀྱང་མེད་པའོ།",
    "གང་ཞིག་ཐམས་ཅད་རང་རང་ངོ་བོས་སྟོང་པ་ཁོ་ནར་ལྟ་གྱུར་པ།",
    "ཕུང་པོ་རྣམས་རྣམ་པར་དཔྱད་ན་རང་རང་ངོ་བོས་སྟོང་བ་རྣམས།",
    "ཐམས་ཅད་རང་རང་ངོ་བོས་སྟོང་བ་ཉིད་སྟོན་པ་གང་ཅི་ཡང་རུང་བ་དེ་ཐམས་ཅད་ནི་དྲང་དོན་དགོངས་པ་ཅན་དུ་རིག་པར་བྱ་ལ།",
    "གཟུགས་སོགས་རང་རང་ངོ་བོས་སྟོང་པ་གང་ཡིན་པའམ་དེ་ལྟར་ངོ་ཤེས་ཤིང་རྟོགས་པ་དེ་ཉིད་དེ་བཞིན་ཉིད་དང་རྣམ་མཁྱེན་མ་ཡིན་ནམ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "སྐྱེ་བའི་ངོ་བོར་ཡོད་ཀྱང་རང་ལས་སྐྱེ་བའི་ངོ་བོར་མེད་ཅིང་ཡང་དག་པར་ན་ཅིར་ཡང་མ་གྲུབ་པ་སྟེ།",
    "བྱུང་ཡེ་ཤེས་བཞི་དང་རང་བྱུང་ཡེ་ཤེས་ལྔ་སྟེ་ཡེ་ཤེས་དགུར་ཡང་འགྱུར་ཞིང་།",
    "རྣམ་པ་ཐམས་ཅད་ཀྱང་རང་བཞིན་གྱི་སྐུ་དང་ལོངས་སྤྱོད་རྫོགས་སྐུ་སྟེ་གཉིས་ལ་གནས།",
    "བཞི་པ་ངང་དང་རང་བཞིན་བདག་ཉིད་གསུམ་བསྟན་པ།",
