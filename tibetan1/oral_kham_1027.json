    "དེ་ལྟར་གྱི་ཤེས་པ་ལ་ཡང་རྒྱུ་འབྲས་འདུག་པའི་ཕྱིར།",
    "སྟན་བཟང་པོ་ལ་འདུག་སྟེ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་། པའི་ཕྱིར།",
    "འདུག་ན་མ་དགོའགྲོ་བ་ལ་བཤོལ་འདེབས་མ་བྱེད།",
    "འདུག་པ་ལ་བསྐུལ་མ་མ་བྱེད།",
    "ཕན་ཚུན་གྲོགས་སུ་འགྲོ་བ་ཞིག་དགོས་རྒྱུ་ཡིན་འདུག་པས་ན།",
    "བོད་ཀྱི་ཆབ་སྲིད་ཀྱི་གནས་བབས་ཐོག་ནས་ཧ་ཅང་གལ་འགངས་ཆེ་བའི་སྟོང་ཆ་ཞིག་ཁ་བསྐངས་གནང་འདུག་པ་མ་ཟད།",
    "དེ་སྔ་ཡོན་རྒྱལ་རབས་ཀྱིས་བྱིན་པའི་མིང་བཏགས་སྣ་ཚོགས་སྔར་མུས་བཞིན་ཁས་ལེན་བྱས་པའི་དོན་དག་དེ་དག་ཀྱང་རང་རློམ་དང་རང་རྩིས་ཆེན་པོའི་སྒོ་ནས་གཅིག་ཁོངས་གཅིག་ལ་གཏོགས་པའི་འབྲེལ་བ་རིགས་ཤིག་ལ་བརྩི་བཞིན་ཡོད།",
    "ཞེས་སོགས་མཆོད་ཡོན་གྱི་འབྲེལ་བ་ཞེས་པ་ཆབ་སྲིད་དང་འབྲེལ་བ་བཏགས་ནས་ཤོད་བཞིན་པ་འདི་དག་བྱེ་མའི་འཆིང་བུ་བཞིན་དུ་ཡིད་རྟོན་གང་ཡང་མེད་པར་བསྒྲུབས་འདུག་རྒྱ་ནག་ཆིང་རྒྱལ་རབས་དུས་ཀྱི་བོད་རྒྱའི་འབྲེལ་བའི་སྐོར་ལ་རྒྱལ་མཆོག་སྐལ་བཟང་རྒྱ་མཚོ་ཁམས་ལི་ཐང་ནས་ལྷ་སར་བསྐྱལ་རྒྱུར་ཁ་གཡར་ནས་ཆིང་རྒྱལ་རབས་ཀྱི་བློན་ཆེན་ལྷ་སར་བསྡད་ནས་ཕྱིར་མ་ལོག་པ་དང་།",
    "པ་ང་རང་རིག་པ་ཅུང་དྭངས་པར་གྱུར་དུས།",
    "གལ་ཏེ་བཙོན་པ་ང་རང་བཙོན་ནས་ཐོན་རྗེས་གཉེན་ཉེ་གྲོགས་པོ་རྣམས་དང་གངས་ཅན་བོད་མིར་ལེགས་སྐྱེས་ཆུང་ངུ་གང་ཞིག་འབུལ་ཐུབ་ཡོད་པར་བརྗོད་ཚེ།",
    "མའོ་ཀྲུའུ་ཞིས་རང་སྣང་རིང་ལུགས་དང་རང་ཤེད་ཚ་པོ་ནི་ཀྲུང་གོའི་གསར་བརྗེ་དང་།",
    "ཚབས་ཆེ་བའི་རང་སྣང་རིང་ལུགས་དང་རང་ཤེད་ཚོ་པོའི་ནོར་འཁྲུལ་གནས་ཡོད་པ་དང་།",
    "ཁོ་ཡང་རང་ཉིད་ཀྱི་ལྡོག་ཕྱོགས་ཏེ་བདེན་པར་སྒྲུབ་པའི་ཕྱོགས་སུ་ཆས་འགྲོ།",
    "ཆོ་མེད་དགོད་བྲོ་དང་རང་ཁུངས་རང་སྐྱེལ་མི་ཐུབ་པའི་གཏན་ཚིགས་རྣམ་པ་སྣ་ཚོགས་ལས་སླ་པོར་རྙེད་ཐུབ།",
    "དེ་ནི་ཁོ་རང་སྐལ་བ་མ་ལེགས་པ་ཞིག་ལས་ཁོའི་ནོར་འཕྱུག་མིན།",
    "གདམ་ག་འདི་ད་ལྟའི་དངོས་ཡོད་གནས་ཚུལ་གྱི་སྲིད་རུང་རང་བཞིན་དང་མཐུན་ལ།",
    "ང་རང་འགན་ཁུར་པ་གཙོ་བོ་ཡིན་པའི་བོད་རིགས་གུང་ཁྲན་རིང་ལུགས་ཀྱི་རྩ་འཛུགས་རྣམས་ཏེ།",
    "ང་རང་ཉིད་ཀྱིས་ཀྲུང་དབྱང་བོད་སྡོད་འཐུས་ཚབ་ཀྲང་ཅིང་ཝུའུ་ཡིས་ཧྲུའུ་ཅིའི་འགན་ཁུར་ཅིང་།",
    "གྲོས་མཐུན་འཇོག་དུས་ང་དང་བློ་མཐུན་ལོ་ཡུས་ཧུང་གཉིས་ནི་ཀྲོའུ་ཙུང་ལིས་དམིགས་བཀར་གྱིས་གཞུག་ཏུ་བཅུག་པའི་ཀྲུང་དབྱང་ཕྱོགས་ཀྱི་ཟུར་ཞུགས་མི་སྣ་ཡིན།",
    "ང་རང་ད་དུང་རྒྱལ་བ་པཎ་ཆེན་རྣམ་གཉིས་སོགས་མའོ་ཀྲུའུ་ཞི་དང་།",
    "ཐོས་ཚུལ་ལྟར་ན་མི་ལ་ལར་དེ་འདྲའི་བསམ་ཚུལ་འདུག་ཟེར།",
    "གལ་ཏེ་གོ་སྐབས་བྱུང་ཚེ་ང་རང་ཅི་ཐུབ་ཀྱིས་ཡོང་ངེས་ཡིན།",
    "རྩ་བའི་ཆར་ང་རང་ཉིད་ཀྱི་མ་རྩོམ་སོར་བཞག་ཡོད།",
    "བློ་མཐུན་ཏེང་ཞའོ་ཕིང་དངོས་ཀྱིས་མ་ཡིག་བྲིས་ནས་ལྷོ་ནུབ་ཅུ་ཡིས་ཀྲུང་དབྱང་ལ་ཕུལ་བའི་གློག་འཕྲིན་འདུག་པ་འདི་ལྟར།",
    "མར་ལེ་རིང་ལུགས་ཀྱི་རྨང་གཞི་རགས་ཙམི་འདུག་ལ།",
    "ཁོ་རང་ཡང་དམག་དཔུང་དང་ལྷན་དུ་བོད་ལྗོངས་སུ་བསྐྱོད་རྒྱུའི་བཀའ་དབབ་གཏན་ཁེལ་ཟིན་ཅིང་།",
    "མི་བརྒྱ་ལྷག་འདུག་ཅེས་དང་།",
    "ད་དུང་རང་ཉིད་ཀྱི་དམག་དོན་དང་ཕྱི་འབྲེལ་སོགས་ཀྱང་ཡོད་པ་དང་།",
    "མ་མཐར་ཡང་སྤྲོ་སྣང་ཆེན་པོ་རང་མི་འདུག་དང་པོ་ནི།",
    "དེ་ནི་ཕྱི་རྒྱལ་དུ་ཡོད་པའི་བོད་མི་ཚོས་བཏོན་པའི་བོད་ཆེན་པོ་དང་འདྲ་པོ་འདུག་ཅེས་པའི་ལྟ་ཚུལ་བྱུང་།",
    "རམ་པ་དེ་འཕྲལ་ལྷ་ས་དང་བྲལ་ནས་ཁོ་རང་ཉིད་ཀྱི་གཞིས་ཀར་ལོག་པ་དང་།",
    "ད་ཆ་ས་ཆ་མང་ཆེ་ཤོས་ལ་ང་རང་ཡང་བསྐྱར་འགྲོ་འདོད་མི་འདུག་ཅིའི་ཕྱིར་ཞེ་ན།",
    "ང་རང་རྒལ་མི་ཐུབ་ཅིང་རྒལ་འདུན་ཡང་མེད།",
    "ཁྱེད་རང་བདེ་བར་བཞུགས་སམ།་",
    "ཁྱེད་ཀྱི་འགོ་ཁྲིད་ཨ་ལོ་ལོ་ཡུས་ཧུང་དང་ངེད་གཉིས་འབྲེལ་བ་ཤིན་ཏུ་ལེགས་ཤིང་རྟག་པར་ཁྱེད་རང་གླེང་མྱོང་།",
    "ཁོ་དང་ཧྲི་ཀྲུང་མན་གཉིས་ཀྱི་གཉེན་དོན་ལ་ཁྱེད་རང་ཡར་མར་མང་དུ་བརྒྱུགས་ཡོད།",
    "ཁྱེད་དང་དབྱིན་ཧྥ་ཐང་སོགས་ཀྱིས་ངས་སྔ་ཕྱི་བར་གསུམ་དུ་བོད་རང་བཙན་བྱེད་འདོད་འདུག་ཅེས་བརྗོད་ཅིང་།",
    "༡༩༥༩ ལོར་ཁོང་བོད་ལྗོངས་ནས་བྲོས་རྗེས་ཀྱི་ད་ལྟའི་བར་གྱི་དུས་རབས་ཕྱེད་ཀའི་ཡུན་ལ་ང་རང་ཁོང་ལ་ཐེངས་གཅིག་ལའང་ཕྲད་མ་མྱོང་།",
    "ང་རང་གསར་དུ་བཅིངས་འགྲོལ་བྱས་མ་ཐག་པའི་ཁྲུང་ཆིན་དུ་ཕྱིན་ནས་ཀྲུའུ་ཞི་ལི་འུ་པོ་ཁྲེང་དང་འཕྲད་དགོས་པའི་བླང་བྱ་བཏོན།",
    "ང་རང་བོད་ལྗོངས་ནས་ཐེངས་གཉིས་ལ་ལས་གནས་སྤོ་རུ་བཅུག་པ་ནི་ཁྱེད་ཀྱིས་བྲིས་པ་ཇི་བཞིན་གཏན་ནས་མིན་པར།",
    "འོན་ཀྱང་ང་རང་ཧ་ལས་སུ་འཇུག་པ་ཞིག་ནི།",
    "བློ་མཐུན་དབྱིན་ཧྥ་ཐང་དང་ང་རང་གཉིས་ཀ་ལོ་ན་དགུ་བཅུར་ཉེ།",
    "ང་རང་དོན་འདི་དང་འབྲེལ་བ་ཡོད་པའི་མི་སྣའི་གྲས་ཡིན་གཤིས།",
    "ང་རང་ལའང་འཐུས་ཚབ་ཀྱི་རང་བཞིན་ངེས་ཅན་ཞིག་ཡོད་པ་བདེན་ཏེ།",
    "དྲིལ་བསྒྲགས་ལས་ཀ་གཙོ་སྐྱོང་བྱེད་མཁན་བློ་མཐུན་ཀྲང་ཞང་མིང་ལ་ང་རང་དངོས་ཀྱིས་སྤྲད་པ་ཡིན།",
    "ཁོ་རང་ང་ལས་ལོ་ཕྱེད་ཀྱིས་ཆུང་།",
    "ཏང་ཕྱི་ནང་དང་རྒྱལ་ཁབ་ཕྱི་ནང་གང་དུའང་རང་ཉིད་གུང་ཁྲན་ཏང་ཡོན་རྒན་གྲས་ཤིག་ཡིན་པའི་ཆ་ནས།",
    "དེར་དཀའ་ཚེགས་ཆེན་པོ་ཡོད་པ་རྟོགས་པས་ང་རང་འགྲོ་དང་མི་འགྲོ་ཀྲུང་དབྱང་ནས་ཐག་གཅོད་རོགས་ཞེས་ཁ་གསལ་པོར་བརྗོད་པ་དང་།",
    "ཕལ་ཆེར་ང་རང་ཕྱི་རྒྱལ་ལ་གཞུང་ལུགས་འཆད་འཁྲིད་དུ་འགྲོ་རུ་བཅུག་མ་མྱོང་།",
    "ང་རང་རང་དགར་གཞུང་ལུགས་འཆད་འཁྲིད་དུ་མི་འགྲོ་ག་མེད་བྱུང་ཞིང་ཕྱིས་སུ་འགོ་ཁྲིད་ཀྱིས་བྱེད་སྟངས་དེ་འོས་འཚམ་མིན་ཞེས་སྐྱོན་རྗོད་བྱས་བྱུང་།་",
    "གོང་དུ་གླེང་བ་ལྟར་དོན་དངོས་སུ་འཐུས་ཚབ་མི་སྣ་གསུམ་ལ་སྐྱོན་རྗོད་དང་འཐབ་རྩོད་བྱེད་པ་ཞེས་པ་དེའི་མདུང་རྩེ་གཏོད་ས་ང་རང་ཡིན་ཞིང་།",
    "ང་རང་ཉིད་ལ་མཚོན་ན་མི་རིགས་འདྲ།",
    "འོན་ཀྱང་དཀར་འདོན་བྱས་རྗེས་ཁོས་ད་དུང་བོད་རང་བཙན་རྗོད་བཞིན་འདུག་ཟེར།",
    "གལ་ཏེ་དཀར་འདོན་གྱི་རྗེས་སུ་བྱས་ཚེ་གཞན་གྱིས་ངས་མཇུག་མ་གཟེངས་གཟེངས་བྱེད་ཀྱི་འདུག་ཅེས་བརྗོད་སྲིད་ཅེས་ལན་དུ་སྨྲས་པ་ཡིན།",
    "ང་རང་བོད་ལྗོངས་གུང་ཁྲན་ཏང་རྩ་འཛུགས་ཐོག་མར་འཛུགས་མཁན་དང་ཏང་ཡོན་རྒན་པ་ཞིག་ཡིན་པའི་ཆ་ནས།་",
    "ཟླ་༣པའི་ཚེས་༢༥ ཡི་ཉིན་ཁྱེད་ཀྱིས་འགོ་ཁྲིད་བློ་མཐུན་གྱི་བཀའ་ལྟར་ང་རང་ཁ་བརྡ་བྱེད་པར་བོས་བྱུང་བ་དང་།",
    "ང་རང་པའེ་ཡུན་གླེང་ལ་ངོ་སྤྲོད་བྱས་ཏེ་ང་ནི་བོད་ལྗོངས་ལས་དོན་ཨུ་ལྷན་གྱི་བོད་རིགས་ཨུ་ཡོན་ཉག་གཅིག་དང་།",
    "དབྱིན་ཇིར་དགའ་བ་དང་རང་བཙན་བྱེད་མཁན་ཡིན་པ་དང་།",
    "སྲིད་སྐྱོང་སྟག་བྲག་ནི་དབྱིན་ཇིར་དགའ་མཁན་དང་རང་བཙན་བྱེད་མཁན་ཡིན་པར་འདོད་པ་སོགས་ལྟ་བུའོ།",
    "སྐབས་དེར་ལྷ་སར་དེ་གཅིག་པུ་ལས་མེད་པའི་རླངས་འཁོར་དེ་བཏང་ནས་ཁོད་དོགས་པའི་སྲང་ལམ་དུ་སྨོས་པ་ལྟར་རྒྱུག་དུས།",
    "ང་རང་ཕལ་ཆེར་དེའི་ནང་ལ་གཞུག་ཏུ་བཅུག་མེད་ཅིང་།",
    "བོད་ལྗོངས་སུ་ང་ལ་དགག་པ་དང་འཐབ་རྩོད་བྱེད་དུས་ང་རང་བོད་ལྗོངས་ཀྱི་ཞིང་བྲན་བདག་པོ་ཨང་གཉིས་པར་བརྩིས།",
    "ཀྲང་དང་ཧྥན་གཉིས་ཀྱི་རྩོད་གཞིར་ང་རང་གཞུག་ཏུ་གཏན་ནས་བཅུག་མ་མྱོང་།",
    "ཆབ་སྲིད་མི་སྣ་ཞིག་དུས་རབས་ཕྱེད་ཀའི་རིང་ལ་ཡུལ་གཞན་དུ་གྱུར་བ་དང་།",
    "བློ་མཐུན་རྡོ་རྗེ་ཚེ་བརྟན་དང་ཡངས་གླིང་རྡོ་རྗེ་སོགས་ཀྱིས་ཀྱང་རང་ས་ནས་ཕྲིན་ཡིག་བྲིས་འདུག་འཚོ་བའི་ལག་ལེན་ནི་བདེན་དོན་ལ་བརྟག་ཞིབ་བྱེད་པའི་ཚད་གཞི་ཉག་ཅིག་ཡིན།",
    "སྐབས་དེར་ཁོ་ཕྱིར་ལོག་པར་ང་རང་ཡིད་ཆེས་ཡོད།",
    "ཁོ་རང་ཆེས་རླབས་ཆེ་བའི་རྩོམ་རིག་པ་ཡིན་པར་མ་ཟད།",
    "ཁོ་རང་ནུབ་ཕྱོགས་མཐའ་མཚམས་སུ་ཡོད་པའི་བོད་དུ་བསྐྱལ་ཅིང་།",
    "དེ་སྔ་ཡོན་རྒྱལ་རབས་ཀྱིས་བྱིན་པའི་མིང་བཏགས་སྣ་ཚོགས་སྔར་མུས་བཞིན་ཁས་ལེན་བྱས་པའི་དོན་དག་དེ་དག་ཀྱང་རང་རློམ་དང་རང་རྩིས་ཆེན་པོའི་སྒོ་ནས་གཅིག་ཁོངས་གཅིག་ལ་གཏོགས་པའི་འབྲེལ་བ་རིགས་ཤིག་ལ་རྩི་བཞིན་ཡོད།་",
    "བོད་དོན་དང་འབྲེལ་བ་ཡོད་པའི་འབྲེལ་ཡོད་འགོ་ཁྲིད་ཀྱིས་མ་དངུལ་ཤིན་ཏུ་མང་པོ་གཏོང་འདོད་འདུག་ཅིང་།",
    "རྒྱ་གར་དུ་སྡོད་པའི་དབྱིན་ཇིའི་དམག་དཔུང་རང་དགར་རྒྱང་ཐག་རིང་པོ་ནས་ལྷ་སར་དྲངས་པ་དང་།",
    "སྣ་མང་རང་བཞིན་གྱི་གཅིག་གྱུར་ཡིན།",
    "འདིའི་དོན་ནི་སྔོན་ཆད་ཁྱིམ་ཚང་གཅིག་མིན་པར་རང་རང་སོ་སོར་ཁྱིམ་ཡོད་པ་དེ་ཤུགས་སུ་བསྟན་ཡོད།",
    "འགོག་སྲུང་རང་བཞིན།",
    "སུའུ་འཇར་དམག་འཁྲུག་དུས་ཀྱི་སུའུ་ལེན་དང་འཇར་མན་གཉིས་ཀྱི་འབྲེལ་བའི་རྐྱེན་ལ་བརྟེན་ནས།",
    "བློ་མཐུན་ཀྲོའུ་ཨེན་ལའེ་དང་ང་རང་བཅས་ཚང་མས་ངོ་རྒོལ་མ་བྱས་ཤིང་བློ་མཐུན་ཁྲེན་ཡུན་གྱིས་ཀྱང་སྐད་ཆ་མ་བཤད།་",
    "རང་ཉམས་རང་རྒྱུད་ཀྱི་ཟབ་སར་སྦྱར་ནས་ལག་ལེན་དུ་བཏབ་ཙ་ན།",
    "གཉིས་ནི་ཞིན་ཅང་རང་བཙན།",
    "དུས་བདེ་ཞོད་འཇགས་ཀྱི་རྣམ་པར་ཤུགས་རྐྱེན་ཐེབས་ཙ་ན།",
    "ཀུན་ལ་གསལ་བ་ལྟར་རང་རྒྱལ་གྱི་ད་ལྟའི་རྡོ་སྣུམ་དང་རང་བྱུང་སོལ་རླངས་གཙོ་བོ་ཞིན་ཅང་ལ་བརྟེན་པ་དང་།",
    "འོན་ཀྱང་ཁོང་རང་ཉིད་ལ་ཐོག་མཐའ་བར་གསུམ་དུ་ལན་གང་ཡང་མ་ཐེབས་གཤིས་ཐུགས་ཕམ་ཧ་ཅང་ཆེན་པོ་བྱུང་།་",
    "རང་མི་རིགས་ཀྱི་ཁེ་ཕན་དོར་ཅིང་ད་དུང་རང་རློམ་དང་ཁེངས་དྲེགས་ཆེན་པོ་དང་བཅས་རང་ཉིད་ཡར་ཐོན་ཅན་དང་གསར་བརྗེ་ཅན་ཡིན་ཚུལ་ངོམ་སོ་བྱེད།",
    "གཅིག་ནི་ང་རང་བོད་མི་ཞིག་ཡིན་པའི་རྐྱེན་གྱིས་དང་།",
    "ཁོ་རང་ངོས་ན་རང་ཉིད་ཀྱི་དམིགས་བསལ་གྱི་ནང་དོན་དང་ཚད་ཡོད་པ་ཞིག་ཡིན་ལ།",
    "རྙོག་འཛིང་རང་བཞིན།",
    "བྱ་དངོས་གང་དང་གང་ཞིག་ཡིན་ཡང་རུང་རང་ཁོངས་སུ་དངོས་པོ་གཞན་དག་ཚུད་ཡོད་པར་འདོད།",
    "ཁོང་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དུས་རབས་སྔོན་མའི་ལོ་རབས་བརྒྱད་ཅུ་པའི་དུས་མགོའི་དཔྱིད་གསར་དུས་ཆེན་གྱི་སྐབས་སུ་བློ་མཐུན་ཝུའུ་ལན་ཧྥུ་ཡི་ཁྱིམ་དུ་མཉམ་འདུ་ཐེངས་ཤིག་བྱུང་ཞིང་།",
    "ཁོ་རང་ཉིད་ལའང་གཡས་ལྷུང་མགོ་འདོགས་རིང་ལུགས་ཞེས་པའི་ཉེས་མིང་བཀལ་ནས་སྐྱོན་རྗོད་ཁེལ་བ་དང་གོ་གནས་ཕབ་པར་བརྟེན།",
    "གུང་ཁྲན་ཏང་ཡོན་ཡིན་ན་བློ་དཀར་ཞིང་གཡོ་ཟོལ་མེད་པ་ཡིན་དགོས་ཤིང་རང་ཉིད་ཀྱི་བསམ་བློ་དང་ལྟ་ཚུལ་གསང་མི་རུང་།་",
    "ཡིན་ན་ཡང་ཐོག་མར་བསམ་བློ་ངོས་འཛིན་གྱི་ཐོག་ནས་རང་རྒྱལ་དུ་རྩ་བ་ཟབ་ལ་གཞུང་ཤིང་བརྟན་ཞིང་རང་ཉིད་ཀུན་ལས་མཆོག་ཏུ་རྩི་བའི་རྒྱ་རིགས་ཀྱི་སྲོལ་རྒྱུན་གྱི་མི་རིགས་ཆེན་པོའི་རིང་ལུགས་གནས་པ་དང་།",
    "དེ་ལས་ལྡོག་སྟེ་ཇེ་སྡོམ་དང་ཇེ་དམ་དུ་འགྲོ་བཞིན་གདའ།",
    "དེ་ལས་མི་རིགས་འདྲ་མཉམ་ངོ་མ་ཚོར་ཐུབ་ཅིང་རང་ཉིད་རྒྱ་རིགས་དང་མཉམ་པོར་རྒྱལ་ཁབ་ཀྱི་བདག་པོ་ཡིན་པའི་རང་བཀུར་རང་སྤོབས་ཀྱི་ཚོར་བ་འབྱུང་ཐུབ།",
    "ཁོ་རང་སྟོབས་ཤུགས་ཅི་འདྲ་ཆེ་ཞིང་ཁེངས་སེམས་ཅི་འདྲ་ཆེ་ན་ཡང་མཐར་གཏུགས་དུས་རྒྱལ་ཁབ་ཀྱི་དར་རྒུད་དང་རྒྱལ་ཕམ་ནི་མི་དམངས་ཀྱི་བློ་ཁ་ཕྱོགས་མིན་གྱི་རྗེས་སུ་འགྲོ་ལྡོག་བྱེད།་",
    "ཁྲེན་དབྱི་སོགས་ཀྱིས་རྒྱལ་བ་པཎ་ཆེན་གཉིས་དང་གསུང་གླེང་གལ་ཆེན་ལན་མང་གནང་བ་ཚང་མར་ང་རང་ཞུགས་པའམ་ཡང་ན་གནས་སྐབས་ཀྱི་སྐད་སྒྱུར་པའི་འགན་ཁུར་པ་ཡིན།",
    "ཧུའུ་ཡའོ་པང་སོགས་ཀྱི་ཐུགས་ཁུར་འོག་ང་རང་ཉིད་དང་།",
    "ང་རང་རྒྱལ་ཡོངས་མི་དམངས་འཐུས་ཚོགས་སྐབས་དང་པོ་དང་།",
    "ང་རང་ད་དུང་བཅིངས་འགྲོལ་གཏོང་རྒྱུར་བསྡད་པའི་འབའ་ཐང་ནས་ཀྱག་ཀྱོག་མང་པོ་བརྒྱུད་ནས་བཅིངས་འགྲོལ་ཐོབ་མ་ཐག་པའི་ཁྲུང་ཆིང་དུ་ཆས།",
    "ང་རང་ཁྲུང་ཆིང་དུ་འབྱོར་རྗེས་ཀྲུང་གུང་ཀྲུང་དབྱང་ལྷོ་ནུབ་ཅུ་ཡི་ཏེང་ཞའོ་ཕིན་དང་།",
    "ང་རང་ཡུན་ནན་དང་།",
    "ང་རང་ཉིད་ལ་བལྟོས་ན་སྔ་ཕྱི་གཉིས་ལས་སྔ་མ་དེའི་ལངས་ཕྱོགས་སུ་བཙོན་དུ་ལོ་ངོ་བཅོ་བརྒྱད་ཙམ་སྡོད་རིང་ལའང་བློ་བརྟན་འགྱུར་མེད་ཀྱིས་འགོག་རྒོལ་རྩོད་ལེན་བྱས་པ་ཚུད་བསྡད་ཡོད།",
    "འདོད་བློ་དང་ལྟ་བ་དེ་ད་ལྟའི་དངོས་ཡོད་ཀྱི་གནས་ཚུལ་ལ་གཞིགས་དགོས་པ་ལས་རང་འདོད་དང་རང་ངོས་ཀྱི་བསམ་ཚོད་ཐོག་འཇོག་མི་རུང་།",
    "ངས་གོང་དུ་ཞུས་ཟིན་པ་ལྟར་ངའི་སྐད་ཆ་དེ་ནི་ང་རང་སྒེར་གྱི་ལྟ་ཚུལ་དང་བསམ་འཆར་ཙམ་ཡིན།",
    "ཡོན་མིན་ཡོན་སྐྱེད་ཚལ་ནས་འཕྲོག་པའི་མཛེས་སྡུག་རྨད་དུ་བྱུང་བའི་གནའ་རྫས་རྣམས་ངོམ་བཞིན་གདའ།",
    "ཞེས་གསུངས་འདུག།",
    "རྒྱལ་ཁབ་ཅིག་ཏུ་མི་རིགས་བར་ཁ་བྲལ་མིན་གྱི་འགག་དོན་དེ་མི་རིགས་གཉའ་གནོན་ཡོད་མེད་ལ་ཐུག་འདུག་ཅིང་།",
    "ཐ་ན་དེ་ལ་ཡི་རང་འུད་བསྟོད་བྱེད་ཀྱིན་འདུག་གོ།་",
    "མི་རིགས་འབྲེལ་བའི་ཁྲོད་གཞི་མགྲོན་གྱི་གོ་གནས་དང་མི་གྲངས་མང་བའི་རུ་ཡོང་པས་མི་གྲངས་ཉུང་བའི་གཞི་འདུག་པར་དམིགས་བསལ་སྟེར་བའི་བྱེད་ཕྱོགས་མཚོན་ཡོད།",
    "ཏ་ཨེར་ཝུན་གྱི་སྟོབས་ལྡན་གནས་པའི་འཇིག་རྟེན་རུས་རྒྱུད་དང་འགྱུར་ལྡོག་རིག་པ་ཞེས་པས་སྐྱེ་དངོས་ཀྱི་གནས་ཚུལ་སྤྱི་དང་འཕེལ་འགྲོས་གསལ་བོར་འགྲེལ་འདུག་མི་ནི་སྲོག་ཆགས་ཕལ་བ་ལས་འཕེལ་བ་ཡིན་ཕྱིན།",
    "གཅན་གཟན་གྱི་རང་གཤིས་ད་དུང་རང་སྟེང་ན་གནས་པ་ཡིན།",
    "༡༩༥ ལོར་ཁྲུང་ཆིང་བཅིངས་འགྲོལ་ཐོབ་མ་ཐག་ལྷོ་ནུབ་ཅུ་ཡི་འགོ་ཁྲིད་ཁ་ཤས་དང་ང་ཐུག་དུས།",
    "ཤེས་རབ་རྒྱ་མཚོ་གང་ན་བསྡད་འདུག་ཅེས་དྲིས་པར།",
    "དབྱང་ཏུང་ཧྲེང་དང་ང་རང་བཅས་ཡོད།",
    "འཇར་མན་གྱི་གཙོ་འཛིན་ཧི་ཐེ་ལི་ཡིས་ས་འོག་ཁང་པའི་ནང་རང་མདའ་བརྒྱབ་ནས་རང་ཤི་བརྒྱབ་པ་དང་།",
    "ང་རང་བཅས་སུས་ཀྱང་བསམ་འཆར་བཏོན་མེད་ལ།",
    "ཀྲུང་དབྱང་ཧྲུའུ་ཅིའི་ཁྲུའུ་ནས་གཏན་འཁེལ་བྱས་རྗེས་ཁྱེད་རང་ལ་ལན་བྱེད་ཀྱི་ཡིན།",
    "ཀྲུང་དབྱང་འཐབ་ཕྱོགས་གཅིག་གྱུར་པུའུ་ཡི་པུའུ་ཀྲང་གཞོན་པ་གཅིག་ལྕོགས་ལིའུ་ཁྲུན་ཕེབས་འདུག་ཀྲང་ཅིན་ཝུའུ་ཡིས།",
    "ཞིབ་བཤེར་བྱ་དགོས་ངེས་གང་ཞིག་འདུག་གམ་ཞེས་དྲིས་པ་ཡིན།་",
    "པ་དེའི་ཕྱི་ཉིན་ང་རང་དུས་རྒྱུན་འབྲེལ་འདྲིས་ཆེ་ཞིང་།",
    "ང་རང་དེ་སྔ་བོད་རིགས་གུང་ཁྲན་ཏང་ཡོན་གྱི་མིང་ཐོག་ནས་སུའུ་ལེན་གུང་ཁྲན་ཏང་དང་།",
    "ལོས་ཡིན།",
    "ང་རང་བཙོན་དུ་ཡོད་སྐབས་ངོས་དཔེ་དེབ་འབོར་ཆེན་བཀླགས་པ་ཡིན།",
    "དེ་ལས་ལྡོག་སྟེ་ང་ནི་རྨོངས་རྟུལ་ཞིག་ཡིན་སྙམ་གྱི་འདུག་ཡིན་ན་ཡང་།",
    "དུས་འགྱང་གཏོང་མི་རུང་བར་མ་ཟད་དེ་བས་ཀྱང་རང་དགར་འཇོག་མི་རུང་བ་ཞིག་ཡིན་པ་ཡོངས་གྲགས་སུ་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད།",
    "ང་རང་ནས་བོད་ཀྱི་ཞི་གྲོས་ཆེད་འབད་བརྩོན་བྱས་པར་བྱ་དགའ་གནང་ཆེད།",
    "མནའ་འབྲེལ་ཚོགས་པའི་ཁོངས་མི་བཅས་ང་རང་ནས་སྣེ་ཁྲིད་འོག་བོད་སྐྱོད་དམག་དཔུང་དང་སྲིད་དོན་ནང་ཞུགས་པ་དང་།",
    "ཧྥེང་ཝུན་པིན་སོགས་ཀྱི་ཐུགས་ཁུར་འོག་ང་རང་དང་དེ་བཞིན་ངས་གཙོ་འགན་ཁུར་བའི་གསར་བརྗེའི་སྒྲིག་འཛུགས་ཁག་ཚང་མར་དག་སེལ་དཀར་འདོན་བྱུང་།",
    "ང་རང་བོད་ཀྱི་གུང་ཁྲན་ཏང་སྒྲིག་འཛུགས་ཀྱི་འགན་ཁུར་མི་སྣ་སྔ་ཤོས་ཡིན་པའི་ངོས་ནས།",
    "དུས་འགྱང་གཏོང་མི་རུང་བར་མ་ཟད་དེ་བས་ཀྱང་རང་དགར་འཇོག་མི་རུང་བ་ཞིག་ཡིན་པའི་ངོས་འཛིན་ཡོངས་གྲགས་སུ་བྱེད་ཀྱི་ཡོད།",
    "ང་རང་སྒེར་ནས་ཀྱང་རྦད་དེ་ཡི་རང་ཞུ་མྱོང་ཡོད།",
    "ང་རང་མི་སྒེར་ནས་མི་དམངས་འཐུས་ཚོགས་ཀྱི་དབུ་ཁྲིད་ལ་མི་རིགས་སྐོར་གྱི་བཟོ་བཅོས་བསམ་འཆར་འགའ་ཤས་དཔྱད་གཞིར་ཕུལ་བ་ཡིན།",
    "མི་དེ་དག་དངངས་སྐྲག་སྐྱེས་ནས་འདུག་བཟོད་མི་བདེ་བ་དང་།",
    "རང་ངོས་ཕྱོགས་ལྷུང་རང་བཞིན་ཁྱད་གསོད་ཀྱིས་མིག་སྔར་གནས་པའི་མངོན་གསལ་དང་མངོན་མེད་ཀྱི་འགལ་ཟླ་སྣ་ཚོགས་གསལ་རྟོགས་བྱས་ཐོག་བསམ་བློ་ཞིབ་རྒྱས་གཏོང་བ་དང་།",
    "རྒྱ་ཆེའི་བོད་རིགས་མི་དམངས་ཀྱི་ལྷག་བསམ་ཟོལ་མེད་ཀྱི་བསམ་འདུན་ཡང་ཡིན་པར་ང་རང་ཡིད་ཆེས་བརྟན་པོ་ཡོད།་",
    "དེ་ནས་ཞིན་ཅང་རང་བཙན་དང་།",
    "དྲུག་ང་རང་སྔ་ས་ལོ་རབས་བཞི་བཅུ་པའི་དུས་འགོ་ནས་བཟུང་།",
    "ང་རང་སྒེར་གྱི་ངོས་ནས་ཞུས་ན་མ་གཞི་གཟུགས་གཞི་བདེ་ཐང་ཡིན་པ་དང་།",
    "ཇི་སྐད་དུ་རི་ཀླུང་བསྒྱུར་བཅོས་སླ་ཡང་རང་གཤིས་སྒྱུར་བ་དཀའ་ཞེས་པའི་དཔེ་ལྟར།",
    "སྤྱི་ལོ་༡༩༨༡ ལོར་ང་རང་བོད་ལྗོངས་ལ་ལྟ་ཞིབ་ཐེངས་དང་པོར་འགྲོ་སྐབས།",
    "བློ་མཐུན་ཞའོ་ཕིན་ལ་གསང་ཡིག་ཕུལ་ནས་སླར་ཡང་ང་རང་ལ་ཉེས་མེད་ཉེས་འགེལ་བྱེད་རྩིས་བྱས་ཤིང་།",
    "ཧ་ཅང་གསལ་པོ་གསུངས་འདུག་ཁོང་པེ་ཅིན་སོགས་སུ་ལོ་གཅིག་བཞུགས་རིང་།",
    "ང་ཕོད་ང་རང་བཅས་ལ་ཕྱག་ཡིག་དང་ཞལ་པར་ཐོག་ནས་འཚམས་འདྲི་གནང་མྱོང་ཡོད་པས།",
    "ཁོ་རང་ནི་དམག་མི་ཞིག་ཡིན་པས།་",
    "བློ་མཐུན་ཞའོ་ཕིན་གྱིས་གོང་གསལ་གནས་ཚུལ་ང་རང་ལ་གསུངས་སྐབས།",
    "བློ་མཐུན་ཞའོ་ཕིན་གྱིས་ང་རང་ལ་མཇལ་འཕྲད་གནང་རྗེས།",
    "ང་རང་འདེད་སྙེག་བཏང་བ་དང་།",
    "གྷོལ་ཌི་སི་ཊིན་གྱིས་བོད་རིག་པ་ཞིབ་འཇུག་ལྟེ་གནས་སུ་རྒྱ་ཡིག་ལ་བསྒྱུར་བསམ་མཁན་འདུག་ཅེས་གསུངས་བྱུང་བས།",
    "ཁྱེད་རང་བོད་དུ་ལོག་ནས་འགོ་ཁྲིད་ལས་ཀ་བྱེད་དགོས་གསུངས་སྐབས།་",
    "ང་རང་ཉིད་ཀྱིས་བྲིས་པའི་རྒྱ་ཡིག་ཡིག་འབྲུ་དྲུག་འབུམ་ཙམ་ཡོད་པའི་ཕྱིར་རྟོག་དང་གསར་དཔྱད་ཅེས་པའི་དེབ་བཟོ་བཅོས་བྱེད་པའི་སྒང་ཡིན་ཞིང་།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་རྩོམ་པ་པོས་ཁོ་རང་དྲིལ་བསྒྲགས་བྱེད་པའི་དེ་བ་གཞན་དག་མ་རྙེད་པ་མ་གཏོགས།",
    "ངས་ཁོ་རང་ལ་ངོ་གནོང་དགོས་པའི་བྱ་བ་གང་ཡང་བྱེད་མྱོང་མེད།",
    "ང་རང་ནི་ལོ་རབས་བཞི་བཅུ་པའི་སྔ་རྗེས་སུ་ཀྲུང་གོ་གུང་ཁྲན་ཏང་དང་།",
    "ཕྱི་རྒྱལ་གྱི་སྤྱན་སྦྱོར་ཚན་པ་འགའ་ཤས་ནས་ང་རང་ལ་རྒྱ་མི་བོད་དུ་འཁྲིད་མཁན་བོད་མི་ཞེས་ཟེར་བ།",
    "བྱེད་སྟངས་དེར་ང་རང་ཧང་སང་བར་གྱུར་ཅིང་།",
    "འོན་ཀྱང་གཞན་པའི་ཐད་ཀྱི་བར་ཐག་ནི་ལེ་དབར་ཁྲི་འབུམ་གྱིས་ཀྱང་ག་ལ་ཚད་ཅེས་བྲིས་འདུག་ང་རང་ད་ལོ་ལོ་ན་༩་ལ་སོན་ཟིན།",
    "ཐ་ན་སྔོན་དུས་སུ་ང་རང་མ་ཉེས་ཁག་གཡོགས་ཀྱིས་བཙོན་དུ་བརྫངས་ཏེ་ལོ་༡༨ ལ་གཅིག་པུར་བཀག་སྡོམ་བྱེད་མཁན་ལའང་རང་ངོས་ནས་འཁོན་འཛིན་གང་ཡང་བཅངས་མེད།",
    "གལ་ཏེ་ང་རང་བཙོན་དུ་ཚུད་པ་མིན་ན་རིག་གསར་གྱི་དུས་སུ་ང་ལ་སྐྱོན་རྗོད་ཁེལ་ནས་སྲོག་དང་ཕྲལ་ཡོད་ཀྱང་སྲིད།",
    "དེ་ཡང་རང་བཞིན་དགའ་བ་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བ་ལས་ནི་རིམ་གྱིས་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་མཚན་ཐམས་ཅད་རྫོགས་པ་དེ་ལས་སྤྲུལ་ནས་དོན་བྱེད་དོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་སྦྱིན་སྲེག་འདི་ནི་གཟུགས་ཀྱང་མ་ཡིན།",
    "རང་རང་ངོ་བོར་གནས་པའོ།",
    "དེ་ཡང་རྒྱུ་ཡིན་པ་དང་རང་བཞིན་དང་བདེ་ཆེན་དུ་སྦྱར་བ་ཡང་ཡིན་ལ།",
    "འདུད་པ་མེད་པའི་སང་ངེ་འདུག་པའི་སོར་བཅུ་གཉིས་ཀྱིས་ཚངས་པའི་བུ་གའི་བར་དུའོ།",
    "ཀུ་ཤའི་ཁྲེས་ལ་འདུག་ལ་བཟླས་བརྗོད་བརྩམ།",
    "ཞེས་གསུངས་པས་ལོངས་སྐུ་རང་དོན་ཡིན་པས་འཁོར་ཡང་རང་དོན་ཡིན་ནོ།",
    "གྲ་ཧ་ཙ་ནི་འཛིན་པའི་སེམས་སུ་འགྲོ་ལ།",
    "ལུས་དང་རང་བཞིན་གྱིས་གནས་པའོ།",
    "འོན་ཀྱང་རང་ལ་སླུ་བར་རབ་མཚོན་རྣམ་པར་འཁྲུགས།",
    "ཉམ་ཐག་དུས་སུ་རྣམ་པར་ཉམས་པ་ཤེས་ནས་ནི།",
    "རང་གནས་ལངས་དང་འདུག་པའམ།",
    "དཀར་ལ་དཀར་མིན་འགྲོས་ཀྱི་འོད་ཟེར་ལུང་ལྡན་པ།",
    "སྨྲས་ཤིང་རངས་བྱེད་ལ་སོགས་རྣམས་ནི་དཔེ་བསྟན་ཏེ།",
    "དེ་ཡི་ཕྱིར་ཡང་རང་བཞིན་ལ་ནི་ཉེས་པ་དེ།",
    "ཁ་ཅིག་རྣམ་པར་འདུག་པའི་སེང་གེའི་སྒྲ་རྣམས་ནི།",
    "དཀར་མིན་འགྲོས་ལས་དུ་བ་བཞིན།",
    "ངེས་པར་ལྡོག་པ་བཟའ་བའི་ཆོ་ག་དུས་ཡིན་ནོ།",
    "རབ་མཐོ་བྲག་རིའི་རྩེ་ཡི་ཡུལ་ངོས་རབ་ཞི་བདེ་བའི་ལོངས་སྤྱོད་འདུག་འདུག་པས།",
