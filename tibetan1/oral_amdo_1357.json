    "ང་ཚོ་མཐོ་ཚད་ལ་གོམས་ཡོད་པ་རེད།",
    "བོད་མི་གནམ་མཆོངས་རྒྱག་མཁན་ཐ་མ་དེ་མ་གཏོགས་ཐོག་མའི་གནམ་མཆོངས་དེ་ལྷོད་ལྷོད་ངང་བྱེད་ཐུབ་སོང་།",
    "ཡིན་ན་ཡང་ཁོས་ང་ལ་ཁོ་རང་མཆོངས་རྒྱུ་ལ་སྐྲག་པ་མིན་མོད་འཚབ་ཤ་ལངས་པ་ཙམ་ཡིན་པ་དང་།",
    "ང་ཏོག་ཙམ་བློ་དྭོགས་སྐྱེ་མོད་ངས་ཁོའི་སྐད་ཆ་རྣམས་ངོས་ལེན་བྱས་ཤིང་།",
    "མཆོངས་གདུགས་ཀྱིས་ནམ་ཡིན་ཡང་ལས་ཀ་བྱེད་ཀྱི་རེད་ཅེས་ཁག་ཐེག་བྱས་པ་ཡིན།",
    "གལ་སྲིད་ཨ་ཐར་གྱིས་གནམ་མཆོངས་རྒྱག་པ་དེ་ཧ་ལས་པའི་ཉམས་མྱོང་ཞིག་རེད་བསམས་ཡོད་པ་ཡིན་ན།",
    "ཁོང་ཚོའི་ལས་འགན་ཐོག་མ་ནི་མགོན་པོ་བཀྲ་ཤིས་ལ་འབྲེལ་བ་བྱས་ནས་སྙན་སེང་འབུལ་རྒྱུ་དེ་རེད།",
    "ཆུ་བཞི་སྒང་དྲུག་གི་ཆེ་ཆུང་དང་གནས་བབ་གང་འདྲ་རེད།",
    "ཁོང་ཚོའི་ལས་འགན་གཉིས་པ་ནི་མགྲོན་གཉེར་ཆེན་མོ་ཕ་ལྷ་ལ་ཐུག་རྒྱུ་དེ་རེད།",
    "བཀའ་ཤག་གི་གཟིགས་ཕྱོགས་གང་འདྲ་རེད།",
    "བོད་མི་ཚོའི་འདོད་ཕྱོགས་གང་འདྲ་རེད།",
    "གལ་སྲིད་དངོས་གནས་ཁོང་ཚོ་རྒྱ་མིའི་བཙན་འཛུལ་ལ་ཡིད་ཐང་ཆད་ཡོད་ན།",
    "ཁོང་ཚོ་རང་ཉིད་གུང་ཁྲན་གྱི་འོག་ནས་ཐར་ཆེད་ག་རེ་བྱེད་རྒྱུའི་གྲ་སྒྲིག་བྱས་ཡོད་པ་རེད།",
    "ཁོང་ཚོའི་ལས་འགན་གསུམ་པ་ནི་ཁོང་ཚོས་རང་གི་ཐུབ་ཚོད་ཀྱིས་བཅིངས་འགྲོལ་དམག་དང་ལྷ་སའི་གཡས་གཡོན་གྱི་གནས་ཚུལ་ལ་ཉུལ་ཞིབ་བྱེད་རྒྱུ་དེ་རེད།",
    "ཁོ་ཚོའི་ཁ་གྲངས་དང་ས་ཆ་ག་རེ་རེད།",
    "ཁོ་ཚོའི་རླངས་འཁོར་དང་མེ་སྒྱོགས་རླངས་འཁོར་གྱི་རིགས་ག་འདྲ་རེད།",
    "ཁོ་ཚོའི་གནམ་དམག་གི་སྟོབས་ཤུགས་གང་འདྲ་རེད།",
    "གུང་ཁྲན་གྱིས་བོད་མི་ཚོར་གཅར་རྡུང་བྱས་པ་དང་མནར་གཅོད་བྱས་པའི་ཞིབ་གསལ་གྱི་གནས་ཚུལ་ག་རེ་རེད།",
    "ལམ་སྟོན་འཕར་མ་བསྣན་རིམ་བཞིན་ཨ་ཐར་གྱི་རེ་བ་ཇེ་ཆེར་གྱུར།",
    "ང་ཚོ་གསང་འཛུལ་བྱེད་པ་ལ་ཐག་ཇེ་ཉེར་སོང་བ་དེའི་ཚོད་ཀྱིས་ང་ཚོ་ལ་དགའ་སྣང་འཕེལ།",
    "ང་ཚོ་ལ་ལག་ཆ་གསར་པ་མང་པོ་ཐོབ་ཡོད་ཅིང་།",
    "ང་ཚོ་བོད་ནང་དུ་སོང་ནས་རྒྱ་མིའི་ཐོག་བཀོལ་རྒྱུ་ལ་སྒུག་མི་ཐུབ་པ་ཞིག་འདུག་སྟབས་ཉེས་པ་ཞིག་ལ།",
    "ང་ཚོ་ཤར་པཱ་ཀི་སི་ཐན་ལ་འཕུར་རྒྱུའི་ཉིན་ཤས་ཀྱི་གོང་དེར་གནས་ཚུལ་ཞིག་ལྷགས་པ་རེད།",
    "བོད་མི་དྲུག་པོ་མདའ་འཕེན་སྦྱོང་ས་ན་ཡོད་ཅིང་ལག་མདའ་མང་པོ་ལ་ཚོད་ལྟ་བྱས་ནས་རང་རང་སྒེར་གྱི་འདོད་བབ་ཅན་དེ་སྒྲུག་གིན་ཡོད།",
    "སྐབས་དེ་ག་རང་ལ་ཁོས་རང་གི་རྟགས་ཅན་གྱི་མདེལ་ལྡེ་ལ་བསྣུན་ཤོར་པ་རེད།",
    "ཁོ་ཁོང་ཚོའི་ཕྱོགས་སུ་རྒྱུགས་ཡོད་ཅིང་ཁོས་གང་མཐོང་བ་རྣམས་བསྐྱར་གླེང་བྱས་བྱུང་།",
    "འཇུར་སྒྲོག་འོག་གི་ཨི་ཁུང་ཆུང་ཆུང་དེ་ནས་ཁྲག་ག་ལེར་ཕྱིར་ཐོན་མགོ་བཙུགས་པ་མཐོང་བྱུང་།",
    "ངས་ཁོའི་རྨས་སྐྱོན་ཕོག་པའི་རྐང་པའི་རྐང་ཐུང་གི་པུས་མོ་ནས་བརླ་ཤ་བར་གཅོད་ཐུབ་སོང་།",
    "ཐབས་ཤེས་བྱས་མོད་ཁྲག་རྒྱུན་ཇེ་ཉུང་དུ་གཏོང་མ་ཐུབ།",
    "ཁོས་རང་གི་རྐང་ཐུང་གི་སྐེ་རགས་བཏོན་ནས་བསྡམས་ཐག་བྱས་པའི་སྐབས་དེར་ངས་ལམ་ལྷོང་དང་བཅས་རང་གི་ལྗིད་ཚད་རིང་ཚད་ཕི་ཊི་༦༡དང་རྒྱ་མ་༢༥ ཡོད་ལ།",
    "ང་ཚོ་མཉམ་དུ་བསྡམས་ཐག་དེ་དམ་པོར་བསྡམས།",
    "རྒྱལ་མཚན་སྐད་སྒྱུར་གྱི་ཚུལ་དུ་མཉམ་དུ་སོང་།",
    "དེ་ནས་ང་ཚོ་དམག་སྒར་གྱི་བཙན་ཁང་ལ་ཕྱིན་པ་ཡིན།",
    "ཧ་ལས་པ་ཞིག་ལ་གློག་པར་བརྒྱབ་དུས་རྐང་པའི་ནང་གི་རུས་པ་གང་ཡང་ཆག་པ་དང་འཐོར་པ་བྱུང་མི་འདུག་ལ།",
    "མདེའུ་རྐང་པ་བརྟོལ་ནས་རུས་པ་ལ་མ་ཕོག་པར་སོང་བ་ནི་ཧ་ལམ་ཡོང་མི་སྲིད་པ་ཞིག་རེད།",
    "ཐེངས་དང་པོ་ནི་སཱེ་པཱན་ལ་ཡོད་དུས་རྒྱུ་ལྷག་འཐོར་པ་ནས་དྲགས་སྐྱེད་བྱུང་བ་དེ་རེད།",
    "ཁོང་ཚོ་བོད་ལ་གསང་འཛུལ་བྱེད་པའི་དུས་ཚོད་རན་པ་དེའི་ནང་ཚུད་རྨ་ཁ་དྲག་སྐྱེད་མི་ཡོང་བ་ནི་ཚང་མ་ལ་གསལ་པོ་རེད།",
    "ཁོ་གནམ་གྲུ་ནས་མཆོངས་རྒྱུ་ལ་འགྲིག་གི་རེད་ཅེས་བཀའ་འཁྲོལ་ཡོང་ཐབས་མེད་པ་ཞིག་རེད།",
    "དེ་ནི་ཚང་མ་བློ་སེམས་མི་ཁེངས་པའི་བདེན་པ་ཞིག་རེད།",
    "ཡང་ན་ཛ་དྲག་གི་གནས་ཚུལ་གཞན་གྱིས་བཙན་ཤེད་བྱེད་སྐབས་བེད་སྤྱོད་བྱེད་དགོས།",
    "སྐར་ཆ་ཁ་ཤས་ཀྱི་ནང་ཚུད་རང་ཤི་རྒྱག་ཐུབ་པ་རེད།",
    "དེ་ནས་དབུགས་རིང་ཤུགས་ཀྱིས་ལེན་དགོས་རྒྱུ་ཙམ་ཞིག་རེད་ལ།",
    "དེའི་རྗེས་སུ་འཆི་བ་གང་མྱུར་གྱིས་ཡོང་གི་རེད།",
    "དམིགས་ཡུལ་འདི་རྒྱུན་འཛིན་བྱེད་ཆེད་སེ་ཊེ་བཱར་ནུམ་ཞེས་པ་བོད་མི་དྲུག་གནམ་གཡུགས་བྱེད་རྒྱུའི་མཚོན་པའི་མཁའ་འཕུར་གྱི་ལས་འགུལ་རིགས་མཚོན་པ་རེད།",
    "དེའི་མགོ་གཙོ་དེ་གཱར་ཐོར་སེ་རཱ་ཌི་ཡིས་བྱས་པ་རེད།",
    "གནམ་གཡུགས་བྱེད་སའི་ས་ཆ་དམིགས་འཛུགས་བྱེད་རྒྱུ་དེ་དཀའ་རྙོག་ཅིག་རེད།",
    "བོད་ཀྱི་ས་བཀྲ་ཡིད་བརྟན་འཕེར་བ་ཞིག་མེད་པ་རེད།",
    "སྔོན་མའི་དབྱིན་ཇིས་ལག་འབྲི་བྱས་པའི་ས་བཀྲ་ཁག་ཅིག་དང་མེཀ་མོ་ཧཱན་ས་ཐིག་སྐབས་ཀྱི་པར་རིགས་རྣམས་རེད།",
    "གནས་ཚུལ་མང་ཤོས་སྟོན་པའི་པར་རིགས་ཀྱི་གཅིག་ནི་ལྷ་སའི་ལྷོ་ཤར་ཕྱོགས་སུ་ཀི་ལོ་མི་ཊར་དྲུག་ཅུ་ན་ཡོད་པའི་གཙང་པོའི་པར་དེ་རེད།",
    "ལས་སླ་བོར་རྙེད་ཐུབ་པའི་གནམ་གཡུགས་ས་ཚིགས་ཤིག་རེད།",
    "དམིགས་བསལ་གྱིས་ཟླ་འོད་ཀྱི་འོག་ཏུ་དེ་ལྟར་རེད།",
    "གནམ་གཡུགས་ས་ཚིགས་ཀྱིས་མཚོན་པའི་ས་ཐོག་གཞིར་བཟུང་བའི་ཕྱོགས་སྟོན་རོགས་འདེགས་རིགས་ནི་མེད་པའམ་ཧ་ཅང་དཀོན་པོ་རེད།",
    "དེ་ནི་དེ་ལས་རྒྱ་ཆེ་བའི་ལི་ཐང་གི་ཐག་ཉེར་ཡོད།",
    "དོ་པོ་དེ་ཚོའི་ནང་བོད་ཀྱི་གྱོན་ཆས་དང་ཅ་ལག་ཡོད་པའི་ཁོངས་སུ་ལྷམ་དང་ཞྭ་མོ།",
    "བོད་གྲི་བཅས་ཀྱང་ཡོད་པ་རེད།",
    "རུ་ཁག་གི་མི་ཚང་མས་ཅ་ལག་སྦས་སའི་ས་ཆ་དེ་ཏན་ཏན་ཤེས་པ་དང་ཡག་པོར་དྲན་པ་བྱེད་དགོས་རྒྱུ་དེ་རེད།",
    "རྒྱལ་མཚན་བཅས་དམག་ཆེན་གཉིས་པའི་སྙན་གྲགས་ཅན་བཙན་ཁང་མཁའ་འཕུར་མ་ཟེར་བའི་༡༧རྟགས་ཅན་གྱི་གནམ་གྲུ་ལ་འཛེགས་པ་རེད།",
    "འབོམ་གཡུགས་གནམ་གྲུ་འདི་གཅིག་པུའི་ཐོག་གི་ཨ་རིའི་མཚོན་རྟགས་ཚང་མ་བསུབས་ནས་ཚོན་ནག་པོ་བྱུགས་ཡོད་པ་རེད།",
    "གནམ་ཐང་དེ་ནི་བོད་མིའི་རུ་ཁག་གཉིས་ཀྱི་འཕུར་སྐྱོད་ས་ཚིགས་བྱེད་རྒྱུ་ཡིན་པ་རེད།",
    "འབོམ་གཡུགས་གནམ་གྲུ་འདི་ཕི་ཊི་སྟོང་ཕྲག་བརྒྱད་ལས་བརྒལ་ངེས་པ་ཞིག་ལ་མ་སླེབས་ཀྱི་བར་དུ་བོད་མི་ཚོས་མཁའ་དབུགས་གདོང་འབག་ལ་ལག་པ་མ་འཆང་བ་རེད་ལ།",
    "མཚམས་དེ་ལ་མེག་ཀར་ཐེ་ཡིས་མཁའ་དབུགས་ལེན་དགོས་པའི་ཨུ་ཚུགས་བྱས་པ་རེད།",
    "དེ་ཚོ་ནི་དམག་མིས་ཐང་ཆུའི་རྡོ་གཅལ་གྱི་སྟེང་དུ་བོད་མི་ཚོའི་ཆེད་དུ་སྒྲིག་ཡོད་པ་རེད།",
    "༡༩༥༧ ལོའི་ཟླ་བ་བཅུ་པ་རེད།",
    "ཚེས་པ་བཅོ་ལྔའི་དགུང་མོ་རེད།",
    "ཡིན་ན་ཡང་ཉི་མ་དང་སྐར་མ་བཟང་པོ་དེ་སླེབས་ནས་ཕྱིན་སོང་།",
    "ཨ་མི་རི་ཀ་བ་གཅིག་ཀྱང་གནམ་གྲུའི་ནང་ཡོང་གི་མ་རེད།",
    "གྷར་ཐོར་སེ་རུ་ཌེ་ཡིས་འདི་ལ་རྐང་བཙུགས་ནས་གཡོལ་ཡོད་པ་རེད།",
    "གྷར་ཐོར་སེ་རུ་ཌེ་ཡིས་ཁོའི་ནང་ལས་བྱས་ཟིན་པ་རེད་ལ།",
    "གལ་སྲིད་༡༧ རྟགས་ཅན་གྱིས་ཧི་མ་ལ་ཡའི་རི་རྒྱུད་དེ་བརྟག་ཆས་སྔོན་འགོག་གི་ཡོལ་བ་ལྟར་བྱས་ཚེ་ཕམ་འཇུག་ཐུབ་གི་ཡོད།",
    "དེ་ནས་བོད་ཀྱི་མཐོ་སྒང་ཤར་དུ་བཅད་ནས་ཁམས་ལི་ཐང་གི་ཐག་ཉེ་ལ་ཕྱིན་ནས་གནམ་གཡུགས་གཉིས་པ་བྱེད་རྒྱུ་དང་།",
    "དེ་ནས་ལྷོ་ནུབ་ཏུ་ཁ་བསྒྱུར་ནས་རྒྱ་གར་གྱི་ས་ཐོག་བརྒྱུད་ཤར་པཱ་ཀི་སི་ཐན་ལ་ལོག་རྒྱུ་རེད།",
    "གང་ལྟར་ཡང་ཉེན་ཁ་གཞན་པ་ཡོད་པ་རེད།",
    "རྒྱུས་མེད་ཀྱི་ས་ཆ་ཞིག་ལ་དམིགས་པ་གཏོད་རྒྱུ་ནི་ལས་སླ་པོ་ཞིག་གཏན་ནས་མ་རེད།",
    "ཐོག་མ་གལ་ཆེ་བ་དེ་ནི་ཡོ་ཆས་རེད།",
    "ང་ཚོ་ལ་གཅིག་ཀྱང་མེད།",
    "གནམ་གྲུ་ལ་བརྟག་ཆས་རེ་ཌར་དཀྱུས་མ་ཞིག་ཡོད་མོད་གནམ་ནས་མར་ལྟ་བ་དང་རྩིས་ཞིབ་བྱེད་རྒྱུ་ལས་གཞན་པའི་ཕྱོགས་སྟོན་བྱེད་པའི་ཐབས་ལམ་གང་ཡང་མེད་པ་རེད།",
    "དེ་ནས་མིག་འབྲས་བསྐོར་ནས་ཕྱོགས་སྟོན་བྱེད་པ་དེ་ཡོད་ཡོད་རེད།",
    "རི་རྒྱུད་དག་གི་ཆགས་དབྱིབས་སྣ་ཚོགས་ལ་གཞིགས་ནས་རང་གི་གནས་ཕྱོགས་ཤེས་ཐབས་བྱེད་རྒྱུ་ཡོད་པ་རེད།",
    "དུས་ཚོད་དེ་ལ་བོད་མི་ཚོ་ནི་ང་ཚོའི་སྤུན་ཡིན་པར་བརྩི་འཇོག་བྱེད་རྒྱུ་དེ་ལས་སླ་བོ་ཞིག་རེད།",
    "གནམ་གྲུ་ས་ཐོག་ནས་བཀྱགས་རྗེས་ཁ་ཐུག་ཡར་འགྲོ་བ་འདྲ་ཞིག་འདུག་གནམ་ཐོག་ནས་ཧི་མ་ལ་ཡ་མཐོང་དུས་དངོས་གནས་ཧ་ལས་ཡག་ཅིག་རེད།",
    "ཟླ་བ་ཤར་ཟིན་འདུག་རིའི་སྟེང་དུ་ཆགས་པའི་གངས་རྣམས་ནི་སྔོན་པོ་རེད་འདུགསའི་མཐོ་ཚད་ལ་མ་ལྟོས་པར་བོད་མི་ཚོ་ལ་མཁའ་དབུགས་མཁོ་སྤྲོད་བྱེད་དགོས་མ་བྱུང་།",
    "འབོམ་གཡུགས་མིང་མེད་པ་འདིས་རང་གི་བགྲོད་པ་གཙང་པོའི་ཐོག་བསྐྱོད་མགོ་བཙུགས།",
    "པར་རིས་རྙིང་པ་ཞིག་གི་ནང་ཐེབས་པའི་བྱེ་མའི་ཐང་དེ་མཐོང་བར་གྱུར།",
    "སྣེ་མོ་དེ་ཨ་ཐར་གྱི་སྐེད་པ་ལ་བཅིངས།",
    "དོ་པོ་དེ་སྒོ་ནས་ཕྱིར་འབུད་རྒྱག་བཏང་།",
    "དེ་མ་ཐག་བློ་ཚེ་མཆོངས་ཤིང་ཁོའི་ཁ་བསྒྱུར་གྱི་ཡོ་ཆས་སྤྱད་ནས་ཨ་ཐར་གྱི་རྗེས་སུ་སྙེག་ཁོས་གཙང་པོ་དེ་ཁོང་ཚོའི་འོག་ཏུ་འོད་ཆེམས་ཆེམས་བྱེད་པ་མཐོང་།",
    "ཉི་མ་དེ་ཁོང་གི་རྒྱབ་ལ་ཡོད་ཅིང་དེས་ཁོང་གི་རྩེ་གསུམ་ གྱི་གྲིབ་ནག་དེ་མདའ་རྩེ་ལྟར་ས་ཐོག་ལ་ཕབ་པ་རེད།",
    "དེ་ནི་ས་ཐོག་ན་བཞུགས་པའི་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱིས་ཇི་ལྟར་བསམ་ཡས་ཀྱི་ས་མཚམས་ལ་རྟགས་བརྒྱབ་ཚུལ་དེ་རེད།",
    "དེ་ནི་ཁྱད་མཚར་པོ་ཞིག་དང་ཧ་ཅང་དམིགས་བསལ་ཞིག་རེད།",
    "ཁོང་ཚོས་རང་གི་མཆོངས་གདུགས་སྦས་ཚར་བའི་རྗེས་ལ།",
    "ཁོང་ཚོས་རྟགས་ཅན་གྱི་ལྟེབ་རྩེག་རྒྱག་རུང་གི་ལག་མདའ་རྣམས་བྲང་རྒྱབ་ཏུ་འཁུར་ཞིང་།",
    "ཅ་ལག་གི་དོ་པོ་ཁ་ཕྱེས།",
    "སྐལ་བཟང་གིས་རྡོ་རྗེ་གླིང་ནས་ཨོ་ཀི་ནཱི་ཝ་ལ་བསྐུར་བའི་བོད་ཆས་ཕྱུ་པ་དེ་གོན།",
    "དེ་ནས་མཚན་མོ་དེ་ལ་དེ་ནས་ཉལ་བ་རེད།",
    "མི་སུ་གཅིག་གིས་ཀྱང་ང་ཚོར་དོ་སྣང་སྤྲད་མ་བྱུང་།",
    "ང་ཚོས་རྭ་སྐོར་ཕྱི་བསམ་ཡས་ནི་རྭ་སྐོར་ཆེན་པོ་ཞིག་གི་ནང་ཆགས་ཡོད་པ་རེད།",
    "དེ་ནས་ང་ཚོ་སྒོ་ཆེན་ཨ་མའི་ནང་དུ་འཛུལ་ནས་ལྷ་ཁང་གཙོ་བོའི་ནང་ཕྱིན་ནས་མཆོད་འབུལ་བྱས་པ་ཡིན།",
    "ང་ཚོས་ཐོག་རྩེག་གསུམ་ཆ་ལ་བསྐོར་ར་བརྒྱབ་པ་ཡིན།",
    "ང་ཚོས་བྲག་ཕུག་ཆུང་ཆུང་དེ་ཚོའི་སྒོ་འགྲམ་དུ་རྩམ་པ་དང་མར།",
    "མཆིམས་ཕུ་ནི་སྙན་གྲགས་ཆེན་པོ་ཡོད་པ་རེད།",
    "ཁོང་ཚོ་སླར་བསམ་ཡས་ལ་ལོག་ཅིང་ཁོང་ཚོས་གསར་དུ་ཉོས་པའི་རྟ་དེ་བླངས་པ་རེད།",
    "བསམ་ཡས་ཀྱི་ལྷོ་ན་ཡོད་པའི་ས་ཆ་རྒྱ་ཆེ་བ་དེ་ལ་ལྷོ་ཁ་ཞེས་འབོད་པ་རེད།",
    "ས་ཆའི་ཆགས་དབྱིབས་ནི་སྣ་ཚོགས་པ་ཞིག་རེད།",
    "རྒྱ་མིས་དེའི་ཤིང་ཆ་དེ་ཚོ་བེད་སྤྱོད་བྱེད་མགོ་བཙུགས་ཟིན་ཡོད་པ་རེད།",
    "དེར་ཁང་པ་མང་པོ་སློང་བའི་འཆར་གཞི་རྣམས་ལག་ལེན་ལ་འགེལ་བཞིན་པ་རེད།",
    "ཨ་ཐར་དང་བློ་ཚེ་གཉིས་ཀྱིས་གང་ལྟར་ཡང་ཆུ་བཞི་སྒང་དྲུག་གིས་ཚབས་ཆེ་བའི་ཕར་རྒོལ་བྱས་ནས་ལྷོ་ཁ་དེ་གུང་ཁྲན་ལས་ཚུར་བླངས་ཡོད་པ་དེ་ཤེས་གྲབས་ཡོད།",
    "ཁོང་ཚོས་གང་ལ་བལྟ་དགོས་པ་དེ་ཤེས་ཡོད་དམ།",
    "ཁོང་ཚོས་སེ་པ་ཊ་ནིཀ་ཟེར་བའི་མིས་བཟོས་འཕྲུལ་སྐར་ཐོག་མ་དེ་མཁའ་དབྱིངས་ཕྱི་མའི་ནང་བཏང་ཞིང་།",
    "༡༧ རྟགས་ཅན་དེ་ཤར་ཕྱོགས་སུ་གསེག་འཕུར་གྱིས་རུ་ཁག་གཉིས་པ་དང་མཉམ་དུ་ལི་ཐང་ཕྱོགས་སུ་གཏད་ནས་སོང་།",
    "ལས་དོན་གྱི་ཕྱོགས་འདི་ནི་མཚམས་འཇོག་མ་བྱས་ཀ་མེད་རེད།",
    "བཟང་ཕྱོགས་སུ་མེད་པའི་གནམ་གཤིས་སྔོན་བརྡ་ཡིས་ཟླ་བ་འདིའི་ཟླ་བ་ཉ་གང་གི་མཚན་མོ་གཞན་དག་ལ་བགྲོད་ཐབས་འཕར་མ་བྱེད་རྒྱུ་ཡང་སྔོན་འགོག་བྱས་ཡོད་པ་དེ་རེད།",
    "མེག་ཀར་ཐེ་ལ་རུ་ཁག་འདི་སླར་ཡང་ཨོ་ཀི་ཎ་ཝ་ལ་འཕུར་རྒྱུ་དང་ཕྱིས་སུ་ཟླ་བཅུ་གཅིག་པའི་ནང་ཟླ་བ་ཉ་གང་བ་སླར་ཤར་བའི་མཚམས་དེར་གསང་འཛུལ་གྱི་ཐབས་ཤེས་བྱེད་རྒྱུ་ལས་གཞན་པའི་འདམ་ཁ་གང་ཡང་མེད་པ་རེད།",
    "དེར་པཱ་ཀི་སི་ཐན་གྱི་དམག་མིའི་རོགས་སྐྱོར་འོག་མགྱོགས་མྱུར་ངང་གྲ་སྒྲིག་གི་རིམ་པ་གྲུབ་པར་བྱས།",
    "ཡིན་ན་ཡང་གང་ལྟར་ཡང་གནམ་མཆོངས་རྒྱག་རྒྱུའི་ཐག་གཅོད་བྱས་པ་རེད་ལ།",
    "བཀྲ་ཤིས་ནི་ཏན་ཏན་བློ་འགྱོད་དང་བཅས་ཧ་ལས་ཡོད་ཀྱི་རེད།",
    "མེཀ་ཆེན་པོ་ཡིས་དེ་ཚོ་བརྗེད་པ་རེད།",
    "ཡིན་ན་ཡང་ད་ནི་དེ་ཚོ་བཅོས་ཐབས་བྱེད་པ་ལ་ཧ་ཅང་ཕྱིས་དྲགས་པ་རེད།",
    "འབྲེལ་གཏུགས་ཀྱི་ནུས་པ་དེ་མེད་པར་སྡོད་དགོས་ཀྱི་རེད་ལ།",
    "རུ་ཁག་གིས་ཅ་ལག་གི་དོ་པོ་ྣམས་སྦས་ཤིང་ས་རྒྱུས་ལོན་ཆེད་ཀྱི་འབད་བརྩོན་བྱས་ཏེ་ཐག་ཉེའི་རི་རྩེ་ཞིག་ལ་འཛེགས།",
    "ཁོང་ཚོས་ཧ་ཅང་ཐག་མི་རིང་ས་ཞིག་ནས་མེ་མདའ་བརྒྱབ་པ་ཐོས།",
    "འཚབ་སྣང་དང་བཅས་མཚན་མོ་དེར་ཁོང་ཚོ་དེར་ཉལ།",
    "ཉིན་དེའི་ཉིན་རྒྱབ་ལ་རི་རྩེ་ཞིག་ལ་གོམ་བགྲོད་བྱེད་སྐབས་དེར་རུ་ཁག་དེ་འབྲོག་པ་ཞིག་གིས་ཁམས་རྟ་འཚོ་རུ་འགྲོ་གིན་ཡོད་པ་དང་གདོང་ཐུག་བརྒྱབ།",
    "ཁོས་རུ་ཁག་དེ་གྱེན་ལོག་པའི་དམག་སྒར་ཡོད་ས་ལ་འཁྲིད་རྒྱུའི་མོས་མཐུན་བྱས།",
    "ཁམས་པའི་བུ་རྣམས་ཕ་ཡུལ་ལ་འདུགཨོ་ཀི་ཎི་ཝའི་ནང་རུ་ཁག་གཉིས་པའི་གནས་ཚུལ་གཅིག་ཀྱང་མ་འབྱོར་བར་ཟླ་བ་བཅུ་གཉིས་པ་སླེབས་སོང་།",
    "བརྡ་ཆས་ལེབ་མོ་ཁེར་རྐྱང་མ་ངོ་མ།",
    "ངས་དྭོགས་པ་ཟ་བ་ཞིག་ལ་བདེ་གྲུབ་ལས་གཞན་པའི་མི་གཅིག་གིས་ལག་འཛིན་སྐམ་གློག་བསྐོར་བ་དེ་ནི།",
    "ཧ་ལམ་ཁམས་པ་རོགས་པ་ཚོ་ཡིན་རྒྱུ་རེད།",
    "ཁོས་ལམ་སེང་མཚོན་ཆ་དང་མདེའུ་གནམ་གཡུགས་གཏོང་དགོས་པའི་རེ་སྐུལ་ཞུས་པ་རེད།",
    "མེག་ཀར་ཐེ་ཡིས་ཁོའི་སྔོན་གྱི་རེ་སྐུལ་དེ་བསྐྱར་ཟློས་བྱས།",
    "ལོ་གསར་སླེབས་ནས་ཡལ་སོང་།",
    "བོད་ནང་ལོགས་ནས་གནས་ཚུལ་འཕར་མ་འབྱོར་ཁ་གྲངས་ནི་ཀླད་གོར་རེད།",
    "བར་འདིར་གནམ་མཆོངས་ལ་འཚེར་མཁན་གྱི་བཀྲ་ཤིས་ཤར་པཱ་ཀི་སི་ཐན་ནས་ས་ཐོག་བརྒྱུད་གསང་འཛུལ་དུ་བཏང་ཟིན་པ་རེད།",
    "བཀྲ་ཤིས་བཅས་ལས་དོན་གྱི་ཁྲོད་བོར་བརླག་ཏུ་སོང་བའི་ཐོ་དེབ་ཏུ་བཀོད་པ་རེད།",
    "ཨ་མི་རི་ཀ་བ་ཚོས་ག་རེ་བྱུང་ཡོད་མེད་ཤེས་རྒྱུ་ལ་ལོ་གཅིག་དང་ཕྱེད་ཀ་འགོར་རྒྱུ་ཡིན་པ་རེད།",
    "ཝ་རེན་སི་མི་ཐི་ལྟར་ན།",
    "ཡང་ན་བཙོན་འཇུག་བྱས་པ་རེད།",
    "དེ་ནས་འཆར་གཞི་ལྡན་པའི་ཐོག་ནས་གཏོར་སྐྱོན་བཏང་བ་རེད་ལ།",
    "རྡོ་དང་ཤིང་ཆ་རྣམས་བཅིངས་འགྲོལ་དམག་གི་དམག་ཁང་རྒྱག་པ་དང་རྒྱ་ནང་ནས་འཁྱེར་ཡོང་བའི་རྒྱ་མི་ཚོའི་སྡོད་ཁང་རྒྱག་རྒྱུ་ལ་བེད་སྤྱོད་བྱས་པ་རེད།",
    "གནམ་གྲུ་ནས་མི་གསོན་པོ་གཡུགས་པ་བཅས་རེད།",
    "ཕ་མ་ཚོས་མེས་རྒྱལ་ཁྱིམ་ཚང་ཆེན་མོ་ལ་ངལ་རྩོལ་གྱི་ཞལ་འདེབས་རྒྱག་པ་དེར་སེམས་པ་གཏོད་ཤུགས་ཆེ་བ་ཡོང་ཕྱིར་རྒྱ་མིའི་རིགས་པ་ལྟར་སོང་ནས་བོད་ཀྱི་བྱིས་པ་རྣམས་དོ་དབོར་རླངས་འཁོར་ནང་བཅུག་ནས་ཕར་འཁྱེར་བ་དེ་རེད།",
    "དེ་ལ་དགག་པ་རྒྱག་མཁན་གྱི་ཨ་མ་ཚོ་ནི་གདུག་རྩུབ་ཆེན་པོ་དང་བཅས་ཐག་ཉེའི་གཙང་པོ་ལ་བསྐྱུར་པ་རེད།",
    "ཁྱོན་བསྡོམས་བྱིས་པ་དང་བྱིས་པ་མ་འབྱར་མ་སྟོང་ཕྲག་བཅོ་ལྔ་ཙམ་བཙན་ཤེད་ཀྱིས་བོད་ནས་འཁྱེར་ཡོད་ཅིང་།",
    "ཁོང་ཚོས་འདམ་གཞུང་གནམ་ཐང་གི་གནས་བབ་ལ་སོ་ཞིབ་དང་བཅས་ཝ་ཤིན་ཊོན་དུ་གནས་ཚུལ་བཏང་བ་རེད།",
    "ཁོང་ཚོས་ནོར་བུ་གླིང་ཁར་ཕ་ལྷ་དང་ཐུག་འཕྲད་བྱས་པ་རེད།",
    "ཕ་ལྷའི་ལན་ནི་བཏང་སྙོམས་ཤིག་རེད།",
    "ཡིན་ན་ཡང་མཇལ་འཛོམས་དེ་ནམ་ཡང་མ་ཡོང་བ་རེད།",
    "དེ་ནི་ཁོ་ལ་མཚོན་ན་གཡོལ་ཐབས་མེད་པའི་ལས་ཀ་ཞིག་རེད་ལ།",
    "དུས་ཚོད་འདི་ལ་སླེབས་དུས་རྒྱ་མི་ཚོས་ཁོ་ལ་དྭོགས་པ་ཟས་པ་རེད།",
    "ཁོ་ཚོ་ད་དུང་ཏན་ཏན་གང་ཡང་ཡོད་མ་རེད།་",
    "ཁོང་ལོ་༥༣ རེད།",
    "མུ་མཐུད་ནས་ཁོས་རྟ་དྲེལ་གྱི་ཚོང་འདྲེན་བྱས་ཡོད་པ་རེད།",
    "སྐྱབས་བཅོལ་བ་ཚོར་ཁོང་ཚོའི་མིང་དང་ལོ་ཚད།",
    "ཕ་མིང་བཅས་མཁོ་སྤྲོད་བྱེད་དགོས་པ་བཟོས་པ་དང་སྐྱེས་ཕོ་མོའི་འདྲ་པར་གསུམ་རེ་སྤྲོད་དགོས་པ་བཟོས།",
    "གལ་སྲིད་ཡོད་ནའང་ཁ་ཤས་ཤིག་རེད།",
    "ཁོ་ཚོས་བོད་མི་ཚོས་འཛིང་རྒྱུའི་ཐག་གཅོད་བྱས་ཡོད་སྐོར་གྱི་གཏམ་ཐོས་པ་དེར་སེམས་ཁྲལ་བྱེད་ཤུགས་ཆེ་རུ་སོང་བ་དང་།",
    "ཁག་གཅིག་ནི་ལྷ་སའི་ཕྱི་རོལ་དུ་སྲུང་སྐྱོབ་ལས་ཀའི་ཐོག་ཡོད་པའི་རྒྱ་དམག་འཚབ་ཤ་ཅན་ཚོས་ཁོ་ཚོས་ཐོས་ཚད་གང་བྱུང་ལ་མེ་མདའ་བརྒྱབ་པ་རེད།",
    "མཚན་མོར་མེ་མདའ་འཕངས་པ་དེས་རྒྱ་མི་ཚོ་སེམས་ཁྲལ་གྱི་མཐའ་ལ་ལྷུང་བཅུག་ཡོད་ཅིང་།",
    "ལྷ་སའི་སྔོན་གྱི་ཞི་འཇམ་དེ་གང་ཡང་ལྷགས་མེད་པ་རེད།",
    "སྒོར་མོ་ཏོག་ཙམ་སྤྱད་ནས་བླངས་པ་རེད།",
    "ད་དུང་ལྷ་ས་ལ་འགྲོ་བའི་ཐབས་ལམ་ཧ་ཅང་མང་པོ་ཡོད་པ་དེ་ཚོ་རྒྱ་མིས་སྟངས་འཛིན་བྱེད་ཐུབ་ཀྱི་མ་རེད།",
    "ཁོང་ཚོས་བཅིངས་འགྲོལ་དམག་དང་འཐབ་འཛིང་ལན་མང་བྱས་པ་དེས་ལམ་ལྷོང་འདྲེན་བཞིན་ཡོད།",
    "ཁོང་ཚོ་རྒྱ་དམག་དང་བསྡུར་ན་མཚོན་ཆའི་ཁྱད་པར་ཤོར་ཡོད་མེད་ལ་མ་ལྟོས་པར་ལྷ་ས་དང་ཐག་ཇེ་ཉེར་བསྐྱོད་བཞིན་ཡོད།",
    "མགོན་པོ་བཀྲ་ཤིས་སྒེར་ངོས་ནས་ཨུ་རུ་སུས་བཟོས་པའི་མེ་མདའ་ཐག་རིང་ཐུང་གཉིས་ཀར་རྒྱག་ཆོག་པ་ཉོས་ནས་འབད་བརྩོན་དེ་ལ་སྣོན་པ་བརྒྱབ་ཡོད་པ་རེད།",
    "ཐ་ན་རྒྱ་ནག་ཚུན་ནས་ཁོང་རང་གིས་མེ་མདའ་དང་ལག་མདའ་འཕར་མ་ཉོ་ཐུབ་པ་བྱུང་ཡོད།",
    "ཚོང་འདི་ལ་མཇུག་སྡོམ་བརྒྱབ་རྗེས་མགོན་པོ་བཀྲ་ཤིས་རང་གི་སྦག་སྦག་འདི་ཡང་རྒྱ་གར་ནས་ནང་འདྲེན་བྱས་པ་རེད།",
    "ལ་ཞོན་ཏེ་ལྷོ་ཕྱོགས་སུ་རང་གི་དམག་དཔུང་དང་འཛོམས་ཕྱིར་ལྷོ་ཁ་ལ་གཏད་ནས་སོང་།",
    "གལ་སྲིད་ཁོ་ལ་འདོད་པ་ཡོད་ན་ཡང་ཁོས་ང་འཛིན་པ་དང་འགོག་ཐུབ་ཀྱི་མ་རེད།",
    "ལམ་ཁ་རུ་དང་བླང་དམག་ལ་འཛུལ་རྒྱུའི་ཆེད་འགྲོ་མཁན་གཞན་པ་བརྒྱ་ཕྲག་མང་པོ་ང་ཚོ་དང་ལྷན་དུ་སླེབས་སོང་།",
    "ཨ་ཐར་དང་བློ་ཚེ་གཉིས་དང་བླངས་ཁོངས་ཀྱི་མི་གཉིས་ཡིན་པ་རེད།",
    "ཞེས་འགྲེལ་བརྗོད་བྱས་པ་རེད།",
    "ཁོང་ཚོ་ཡར་འབྲོག་གཡུ་མཚོའི་སྟོད་དུ་འཛོམས་པ་རེད།",
    "བོད་དབུས་གཅིག་པུ་ནས་རྟ་དམག་ལྔ་སྟོང་བརྒལ་བ་འཛོམས་ཡོད་པ་རེད།",
    "ང་ཚོས་བང་བཞི་སྒྲིག་ནས་རྟ་ཐོག་ཏུ་སྤོབས་པ་ཆེན་པོ་དང་བཅས་རུ་སྒྲིག་བཏང་བ་ཡིན་ལ།",
    "ང་ཚོ་མི་རེ་ངོ་རེ་ནས་བོད་ལུགས་ཀྱི་ཕྱུ་པ་གོན་ཏེ་མེ་མདའ་དང་གྲི་བཏགས་ཡོད།",
    "མཐའ་གྲོང་གི་ནམ་མཁའ་རུ་དུ་བ་སྔོན་པོ་འཁྱིལ་ནས་ཡར་མཆེད་ཅིང་ཁྱབ་པར་གྱུར།",
    "འགྲམ་སོ་བརྡར་བའི་བཞོན་རྟ་སྟོང་ཕྲག་མང་པོས་ལུང་པའི་དཀྱིལ་ནས་བང་བླངས་ནས་སོང་ཞིང་།",
    "ཁོང་ཚོའི་བློ་སྤོབས་དང་རེ་བ་ནི་ཁོང་ཚོའི་སྟེང་གི་ནམ་མཁའ་བཞིན་རྒྱ་ཆེ།",
    "དམག་མི་ཚོ་ཚང་མ་ཧ་ལམ་ལས་སླ་བོར་ཆུ་བཞི་སྒང་དྲུག་གི་དམག་ཁོངས་སུ་འཛུལ་རྒྱུ་རེད་གསུངས།",
    "ཁོང་གིས་འགོག་རྒོལ་དམག་མི་ཚོར་མཚོན་ཆ་བསྐྱུར་ནས་བོད་ཤར་ཕྱོགས་སུ་ལོག་རོགས་ཅེས་གསུངས་རྒྱུར་ཐུགས་མོས་གནང་།",
    "ཁོང་གི་རེ་སྐུལ་དེ་རྩིས་མེད་བྱེད་རྒྱུ་ཡིན་པའང་ཁོང་གིས་མཁྱེན་ཡོད།",
    "ད་ལྟའི་ཆར་མི་སེར་ཁྲོད་དུ་དེ་ཤེས་ཟིན་པ་ནས་ཆབ་སྲིད་ཀྱི་ཉེན་བརྡ་ཞིག་ཡིན་པ་ཡོངས་གྲགས་ཆགས་ཡོད་པ་རེད།",
    "ཇི་ལྟར་ཡོང་རེ་བྱས་པ་བཞིན།",
    "བོད་མི་ནང་གསོད་བྱས་པ་ཚུད་ཡོད་པ་རེད།",
    "རྒྱ་མི་ཚོ་དེ་ལས་ཕར་ཙམ་སོང་ཡོད་དེ།",
    "ཁོང་ཚོས་དམག་མི་རྣམས་ཁམས་པའི་ཆས་སུ་རྫུས་བཅུག་སྟེ།",
    "དེ་ནས་ས་གནས་མི་མང་གི་བཞོན་རྟ་དང་ཅ་ལག་བཅོམ་པའི་སྐོར་ཁག་བཏང་ཡོད་པ་རེད།",
    "རྒྱ་མི་དེ་ཚོས་ལས་ཀ་བྱེད་བཞིན་པའི་སྐབས་སུ་ཆུ་བཞི་སྒང་དྲུག་གི་ལག་པར་ཐེབས་པ་རྣམས་གདུག་རྩུབ་ཆེན་པོས་མེ་མདའ་བརྒྱབ་པ་རེད།",
    "གང་ལྟར་ཡང་རྒྱ་མིའི་བསྙད་འདོགས་བྱས་པ་དེའི་ནང་བདེན་པའི་སྐྱུར་རྩི་ཞིག་ཡོད་པ་རེད།",
    "དོན་དག་འདི་གསལ་པོ་བཟོས་པའི་རྗེས་སུ་ང་ཚོས་འཁྱམ་ཉུལ་མཁན་གྱི་སྐོར་ཁག་དེ་ཚོ་ཧ་ལམ་ཡོད་སྲིད་པའི་ས་ཆ་ཁག་ལ་དམག་མི་༥ ནས་༡ སྐོར་ཡོད་པའི་སྐོར་ཁག་བཏང་བ་ཡིན།་",
    "མགོན་པོ་བཀྲ་ཤིས་ལ་ལྟ་ལོག་སྤྱོད་ལོག་བྱེད་མཁན་ཚོ་དམར་གསོད་གཏོང་རྒྱུ་ལ་འགྱོད་སེམས་སྤུ་ཙམ་ཡང་མེད་པ་རེད།",
    "ཁོས་ཚར་གཅོད་བྱས་པའི་ལྟ་ལོག་གི་དཔེ་མཚོན་གཅིག་རྗེས་གཉིས་མཐུད་ཀྱིས་ཡོད་ལ།",
    "ཁོ་ཚོ་ཤི་ན་དགའ་བའི་མཚམས་བར་དུ་གཅོད་གཏུབས་བྱས་ཡོད་པ་རེད།",
    "རྒྱ་མིའི་དམག་མི་ཁ་ཤས་སོ་པ་བྱས་ཏེ་ཆུ་བཞི་སྒང་དྲུག་ཏུ་འཛུལ་རྒྱུའི་ཐབས་ཤེས་བྱས་པ་རེད།",
    "ཁོ་ཚོའི་འབད་བརྩོན་དེའི་འབྲས་བུ་གོ་ལྡོག་ཏུ་སོང་བ་རེད།",
    "ཆུ་བཞི་སྒང་དྲུག་གིས་དེ་ཚོའི་མང་ཆེ་བ་བསད་པ་རེད།",
    "ཁོང་ཚོ་དམར་ཧྲེང་དུ་ཕུད།",
    "ཁོང་ཚོའི་གདོང་ལ་རྟགས་བརྒྱབ།",
    "རྣ་དང་མཛུབ་མོ་སྔར་ཡོད་ལས་གྲངས་ཀ་ཇེ་ཉུང་དུ་བཏང་ནས།",
    "དགྲ་བོའི་དམག་སྒར་ལ་བཏང་བ་རེད།",
    "ཡ་མཚན་པ་ཞིག་ག་རེ་རེད་ཅེ་ན།",
    "ཁོ་ཚོའི་དམག་དཔུང་དེ་ང་ཚོའི་དམག་དཔུང་ལས་ཧ་ཅང་ཆེ་བ་ཡོད་ན་མ་གཏོགས།",
    "དུས་རྒྱུན་རྒྱ་མིའི་དམག་མི་ཚོས་འཛིང་རྒྱུའི་ཚབ་ལ་བྲོས་འགྲོ་རྒྱུ་འདམས་ཀྱི་རེད།",
    "ཁོ་ཚོ་དམིགས་བསལ་གྱིས་ང་ཚོའི་གྲི་དང་ང་ཚོའི་མདའ་གཟིར་པོ་ལ་ཞེད་ཀྱི་རེད།",
    "དམག་དཔོན་ཚོས་རྒྱུན་ལྡན་ནས་དམག་དཔུང་གི་སྣེ་འཁྲིད་མི་བྱེད་པར་རྒྱབ་ཏུ་སྡོད་ཀྱི་འདུག་གཅིག་བྱས་ན་དམག་མི་ཚོ་བྲོས་མི་འགྲོ་བ་ཏན་ཏན་བཟོ་ཆེད་ཡིན་རྒྱུ་རེད།",
    "གང་ལྟར་གནམ་གཡུགས་གཏོང་སའི་ས་ཚིགས་ཏག་ཏག་ཚུར་མ་ཡོང་བ་རེད་ལ།",
    "ཁོང་ཚོས་རྒྱ་གར་དུ་ཁོང་ཚོ་དང་ཨ་ཐར་ཐུག་འཕྲད་བྱེད་པའི་སྟ་གོན་བྱས།",
    "བཅིངས་འགྲོལ་དམག་གི་འཇབ་རྒོལ་ལས་བྲོས་ཐར་བྱས།",
    "རྡོ་རྗེ་གླིང་ནས་རྒྱལ་ལོ་དོན་གྲུབ་དང་ལྷ་མོ་ཚེ་རིང་།",
    "ཨ་ཐར་བཅས་ལྷོ་ཕྱོགས་སུ་ཀ་ལི་ཀ་ཏ་ལ་སོང་།",
    "དེར་ཁོང་ཚོ་རླངས་འཁོར་ནང་རྒྱབ་ཀྱི་རྐུབ་སྟེགས་སྟེང་དམའ་མོར་ཉལ་ནས་སོང་ཞིང་།",
    "ཧོ་བྷར་གྱིས་ཨ་ཐར་ལ་འདྲི་རྒྱུའི་དྲི་བའི་ཐོ་རིང་པོ་ཞིག་གྲ་སྒྲིག་བྱས་ཡོད་པ་རེད།",
    "དེ་ནི་ཧ་ཅང་རྒྱ་ཆེན་པོ་ཞིག་རེད་ལ།",
    "ལྷོ་ཁར་འཛོམས་པའི་གྲངས་འབོར་དེ་ནི་བློ་ཡུལ་ལས་འདས་པ་ཞིག་རེད།",
    "དེ་ལྟར་བྱས་ན་ཁོང་ཚོ་འབུར་དུ་ཐོན་པའི་འཛེར་མ་ཞིག་ཤིང་ལེབ་ཀྱི་ངོས་སུ་བཅིངས་འགྲོལ་དམག་གིས་ཐོ་བས་མར་བརྡུངས་དགོས་པ་ཞིག་ཡོང་གི་མ་རེད།",
    "དེ་ལྟར་བྱས་པས་གལ་སྲིད་ང་ཚོས་དངོས་གནས་ཆེན་པོ་ཞིག་འཁྲབ་རྒྱུའི་དུས་ཚོད་ཅིག་ཤར་དུས་ང་ཚོས་བརྡ་གཏོང་ཐུབ་ཀྱི་རེད་ལ།",
    "མི་ཚང་མ་དུས་གཅིག་ལ་ཡར་ལངས་ཐུབ་ཀྱི་རེད།",
    "དེ་ནས་དུས་ཚོད་འདིར་ང་ཚོས་བོད་དུ་རུ་ཁག་གཉིས་གནམ་གཡུགས་བཏང་ཟིན་པ་ཡིན་ལ།",
    "ཡིན་ན་ཡང་ཁམས་པ་ཚོའི་གཤིས་ཀའི་ནང་སྤྱོད་པ་དེ་ལྟར་སྟོན་པ་ཞིག་དངོས་གནས་མེད་པ་དེ་ངས་ཤེས་རྒྱུའི་མགོ་ཚུགས་སོང་།",
    "གལ་སྲིད་ཁོང་ཚོས་ཁོང་ཚོ་མི་དགའ་ས་ཞིག་མཐོང་དུས་ཁོང་ཚོ་རྟ་ལ་ཞོན་ནས་མེ་མདའ་ཞིག་འཕྱར་ནས།",
    "གུང་ཁྲན་གྱི་མི་ཁ་ཤས་རྔོན་དུ་འགྲོཟེར་གི་རེད།",
    "ཁོས་རྒྱ་གར་ཕྱོགས་ཀྱི་ས་མཚམས་དེར་གནས་སྟངས་དེ་འདྲའི་རིགས་ལ་སྟངས་འཛིན་བྱེད་རྒྱུའི་རང་གི་འཇོན་ཐང་གང་ཡོད་ཐད་ལ་ཁོང་གིས་ཅི་ཞིག་བསམས་ཀྱིན་ཡོད་མེད་དེ་ཡིན།",
    "རྒྱལ་ལོ་ལ་མཚོན་ན་ཕྱི་ལོགས་སུ་བསྡད་ནས་ནང་ལོགས་ཀྱི་ཇག་དམག་གི་ལས་ཀ་ལ་སྟངས་འཛིན་བྱེད་རྒྱུ་ནི་ཡོང་མི་ཐུབ་པ་ཞིག་རེད།",
    "རེད།",
    "ཅེས་འཁོད་ཡོད་པ་རེད།",
    "ད་དུང་ནེ་ཧ་རུ་ཡིས་སྒེར་ངོས་ནས་བཀའ་བློན་སྦུག་གི་ཕྱི་སྡོད་མགོ་གཙོ་འདྲ་མིན་ཉི་ཤུ་རྩ་ལྔ་ལ་སྒེར་ཐོག་ནས་ཉེན་བརྡ་སྤྲོད་བཅུག་པ་རེད།",
    "ཕྱིས་སུ་རྒྱ་གར་བ་ཚོས་བཀའ་བློན་སྦུག་གི་བོད་མི་ཚོ་ལ་ཞིབ་བཤེར་བྱེད་པའི་ཐབས་ཤེས་བྱས་པ་དེ་ངོས་ལེན་བྱས་མེད་པ་རེད།",
    "ག་རེ་བྱས་ནས།",
    "གང་ཡིན་ཟེར་ན་ཕྱི་སྡོད་པ་ཚོ་ནི་ཡང་ན་ཧ་ཅང་རྨོངས་པ་ཡིན་པའམ་ཡང་ན་དོན་དག་ཅི་ཞིག་འབྱུང་གིན་ཡོད་མེད་ཤེས་རྒྱུ་ལ་ཧ་ཅང་ལྐུགས་པ་ཡིན་པ་རེད།",
    "ཁོང་ཚོ་བཀའ་བློན་སྦུག་གི་བོད་མི་ཚོ་རྒྱ་གར་གཞུང་གི་རྣམ་འགྱུར་ཐད་ལ་ཏན་ཏན་གང་ཡང་མེད་པ་དང་ཁོང་ཚོ་རང་ཉིད་རྙོག་འཛིང་ནང་ཚུད་པའི་ཉེས་འགེལ་ཡོང་རྒྱུའི་ཞེད་སྣང་བྱས་པ་རེད།",
    "བྱས་ཙང་ཁོང་ཚོ་ཁུ་སིམ་མེར་བསྡད་པ་རེད།",
    "བཀའ་བློན་སྦུག་གི་ངོ་རྒོལ་པ་ཚོ་ལས་ལྷག་པའི་བོད་ནང་དུ་ཇི་བྱུང་གི་གནས་ཚུལ་ཤེས་མཁན་གལ་སྲིད་ཡོད་ན་ཁ་ཤས་ཤིག་ཡོད་རེད།",
    "བཀའ་བློན་སྦུག་གི་སྐྱབས་བཅོལ་བ་རྣམས་ནི་ངོ་ལོག་གི་གནས་ཚུལ་ཁྱབ་སྤེལ་བྱེད་མཁན་ལྟེ་བ་དེ་རེད།",
    "༡༩༥༡ ལོ་ནས་རྒྱ་གར་བ་ཚོས་ཁོང་ཚོའི་གནས་ཚུལ་དག་ལ་ཡང་ན་ཞིབ་བཤེར་བྱེད་པའམ་ཡང་ན་ངོས་ལེན་བྱེད་ཀྱི་མེད་པ་རེད།",
    "མང་པོ་ཞིག་གིས་དམའ་འབེབས་ཕྱི་ཤོས་འདི་ནི་རྒྱ་གར་གཞུང་གིས་ཕྱིར་འབུད་གཏོང་རྒྱུ་ཡིན་པའི་ཉེན་བརྡའི་སྔོན་བརྡ་ཞིག་ཏུ་བརྩིས་ནས་རང་འདོད་ཀྱིས་བཀའ་བློན་སྦུག་བཞག་ནས་ཐོན་པ་རེད།",
    "བྱང་ཕྱོགས་ཀྱི་ས་མཚམས་བརྒལ་ནས་ཕྱིན་རེད།",
    "ད་དུང་ད་ནི་ང་ཚོའི་གཞུང་ལ་ཁོང་ཁྲོ་དང་བཅས་ཁག་འགེལ་བྱས་པ་རེད།",
    "བཀའ་ཤག་གིས་ངོ་ལོག་པ་ཚོ་གནོན་ཐབས་བྱེད་ཀྱི་མི་འདུགདེས་བོད་ཀྱི་གོ་མཛོད་ཁང་རྣམས་སྲུང་བྱ་མ་བྱས་པར་བཞག་འདུག་དེས་ན་ངོ་ལོག་པ་ཚོཡིས་མཚོན་ཆ་དང་མེ་མདེལ་རྐུ་ཐུབ་ཀྱི་རེད།",
    "བཙན་འཛུལ་བ་གཞན་དག་དང་མཚུངས་པར་ཁོ་ཚོས་ཁོ་ཚོ་ལ་གྱེན་ལོག་བྱེད་དགོས་པའི་རྐྱེན་རྩ་ངོ་མ་དེ་རྩ་བ་ཉིད་ནས་མ་མཐོང་བ་རེད་ལ།",
    "དེ་ནི་ང་ཚོའི་མི་མང་གིས་ཁོ་ཚོ་ང་ཚོའི་ལུང་པའི་ནང་འཇོག་འདོད་མེད་ཁར།་",
    "ཁོ་ཚོ་ཕྱིར་འབུད་བྱེད་ཆེད་རང་སྲོག་བློས་གཏོང་བྱེད་རྒྱུའི་གྲ་སྒྲིག་ཨང་གསར་ཡིན་པ་དེ་རེད།",
    "མགོ་ལོག་པ་ཚོའི་ཐོག་ཏུ་བསྐོར་ཡོད་པ་རེད།",
    "ཡིན་ན་ཡང་༡༩༥༨ ལོའི་ལོ་དཀྱིལ་ལ་སླེབས་དུས་སྐྱོན་བརྗོད་དེ་རྒྱ་བསྐྱེད་ནས་བོད་དབུས་ཀྱང་ནང་དུ་བསྡུས་ཡོད་པ་རེད།",
    "ཁོ་ཚོས་ཐ་ན་མཚམས་རེར་མང་ཚོགས་དཀྱིལ་དུ་ག་ལེར་དམར་གསོད་གཏོང་རྒྱུ་ཡིན་ཞེས་འགྲེལ་བརྗོད་བྱས་པ་རེད།",
    "ཤ་རུལ་པའི་མཐའ་ལ་སྦྲང་ནག་འཁོར་ཡོད་པ་རེད།",
    "སྦྲང་ནག་མེད་པར་བྱེད་པའི་ཐབས་ཤེས་ནི་ཤ་རུལ་པ་དེ་མེད་པར་གཏོང་རྒྱུ་དེ་རེད།",
    "སྦྲང་ནག་ནི་ངའི་བསམ་ཚོད་ལ་ཇག་དམག་གི་འགོག་རྒོལ་པ་ཚོ་ཡིན་རྒྱུ་རེད།",
    "ཤ་རུལ་པ་དེ་ངའི་བཀའ་ཤག་གམ་ང་རང་ཡིན་པ་རེད།",
    "ཨ་ཐར་ཕྱིར་ལྷོ་ཁ་ལ་རྟ་ཐོག་ནས་སོང་།",
    "ཁོས་རང་གི་གྲོགས་པོ་རྩེ་ཕུད་དང་སྤུན།",
    "སྭེ་པཱན་གྱི་སློབ་གྲོགས་བཅས་ཡིན་པའི་བློ་ཚེ་བཙལ་ནས་རང་གི་སྔར་ལམ་ལ་ཕྱིར་བགྲོད་བྱས་རིམ་བཞིན།",
    "དེ་ལ་ངས་བྱེད་ཐུབ་པ་གང་ཡང་མི་འདུག་ཁམས་ནི་ལྷོ་ཁ་ནས་ཧ་ཅང་ཐག་རིང་པོ་རེད།",
    "ད་དུང་ང་ནི་བོད་ལ་ལོག་དུས་ཧ་ཅང་རེ་བ་ཆེན་པོ་སྐྱེས་བྱུང་།",
    "ཨ་མི་རི་ཀ་ཡིས་ང་ལ་གནམ་གཡུགས་གཏོང་རྒྱུའི་ཁས་ལེན་བྱས་བྱུང་།",
    "འདི་ནི་ངས་བྱེད་ཐུབ་པ་ཞིག་རེད་ལ་ང་ནི་ཧ་ཅང་དགའ་པོ་བྱུང་།",
    "ང་ཚོར་ཁ་ཚ་དགོས་གཏུགས་ཀྱིས་དགོས་མཁོ་ཆེ་བའི་མཚོན་ཆ་དང་མདེལ་འཕར་མ་ཐོབ་རྒྱུ་ཡིན་པ་རེད།",
    "ཨ་མི་རི་ཀའི་གནམ་གྲུས་ང་ཚོ་ལ་རྒྱབ་སྐྱོར་བྱེད་པ་དང་ལྷན་ཅིག་ཏུ།",
    "བྷོ་རེ་སེ་པཱ་སེ་ཏེར་ནག་གིས་ནོ་བྷེལ་གཟེངས་རྟགས་ངོས་ལེན་མ་བྱས།",
    "བློ་ཕམ་ཅན་གྱི་ལྟ་མཁན་ཇེ་མང་དུ་སོང་བའི་མདུན་དེར་ཚུར་སྒུར་ཙམ་བྱས་ཏེ་འབར་གས་སུ་སོང་།",
    "ཐག་རིང་ལྷོ་ཁའི་མཐོ་སྒང་དུ་ཁེར་རྐྱང་གི་དམག་སྒར་ཕྱོགས་གཅིག་ཏུ་ཨ་ཐར་དང་བློ་ཚེ་གཉིས་སླར་ཡང་མཉམ་འཛོམས་བྱས།",
    "ཁོང་ཚོ་ཡང་སྐར་མ་བཞིན་སྲུང་བརྩི་བྱས།",
    "ང་ཚོས་ང་ཚོ་ལ་ཅི་ཙམ་ཞིག་བྱུང་མྱོང་བའི་སྐོར་ལ་སྐད་ཆ་བཤད།",
    "ང་ཚོས་སྲིན་པོ་ཡིས་ང་ཚོ་དུར་ས་ལ་འཁྱེར་བའི་སྐོར་བཤད།",
    "དེ་ནས་ང་ཚོ་སླར་ཡང་མར་གཡུགས་པ་དང་།",
    "ང་ཚོས་ལྷ་དང་སྲུང་མ་ནི་ང་ཚོའི་ཕྱོགས་སུ་ཡོད་པ་དང་།",
    "ཨ་མི་རི་ཀའི་གནམ་གྲུས་ང་ཚོ་ལ་རྒྱབ་སྐྱོར་བྱེད་ཀྱིན་ཡོད་པ།",
    "ང་ཚོས་སླར་ཡང་བོད་ཚུར་ལེན་རྒྱུ་ཡིན་པ་བཅས་དངོས་གནས་ཚོར་བྱུང་།",
    "ལྷ་མོ་ནི་བསྟན་སྲུང་སྟེ་བདུད་ཀྱི་དགྲ་དྲག་ཏུ་ཁྲོས་པ་ཞིག་རེད་ལ།",
    "༡༩༥༨ ལོར་ལྷ་མོས་རང་གི་རྒྱལ་ཞེན་གྱི་རྣམ་པ་བརྒྱུད་ནས་བོད་མི་ཚོ་ལ་སྐུལ་སློང་བྱས་ཡོད་པ་རེད།",
    "ལྷ་མོའི་ཞི་བའི་སྤྲུལ་པ་དེ་ནི་མཛེས་མ་ཞིག་ཡིན་ན་ཡང་།",
    "རྒྱུན་དུ་དཔལ་ལྡན་ལྷ་མོ་ནི་འཇིགས་སུ་རུང་ཞིང་ཡིད་མི་སྡུག་པ་ཞིག་གི་རི་མོ་བྲིས་ཡོད་པ་རེད།",
    "ལྷ་མོའི་བཞོན་རྟ་ནི་དྲེལ་དཀར་པོ་ཞིག་ཡིན་ལ་དེའི་མིག་གསུམ་པ་དེ་འཕོངས་གཡོན་མའི་སྟེང་ཡོད་པ་དེས་ལྷ་མོའི་དྲག་པོའི་སྤྱན་གསུམ་པ་ཐམས་ཅད་མཁྱེན་པ་དང་འདྲ་མཚུངས་སུ་ཡོད།",
    "དཔལ་ལྡན་ལྷ་མོའི་དབུ་སྐྲ་ནི་མེ་ལྕེའི་ཁྲོད་དུ་ཡོད།",
    "ཐོད་པ་བཅས་ནི་ལྷ་མོའི་རྒྱན་ཆ་རེད།",
    "ལྷ་མོའི་ནུ་མ་ལུག་པའི་མདུན་དུ་ཡར་བཀྱགས་པ་དེ་ནི་མིའི་དོན་ལྔ་དང་ཁྲག་གིས་ཁེངས་པའི་ཐོད་པ་རེད།",
    "ལྷ་མོའི་དབུ་ཐོག་ཏུ་རྨ་བྱའི་སྒྲོ་གདུགས་གཡོ།",
    "བོད་མི་ཚོས་རྨ་བྱ་ཡིས་དུག་རིགས་དེ་རྣམས་ཁོང་ཚོའི་ཚོན་མདངས་རྣམ་པར་བཀྲ་བའི་གཤོག་སྒྲོའི་རིགས་སུ་བསྒྱུར་བར་བྱེད་ལ།",
    "རིན་ཐང་ཆེ་བའི་སྐྱེས་ཤིག་རེད།",
    "དེ་ནས་མི་ཚེ་འདི་ནི་དམིགས་བསལ་གྱིས་བསྐལ་བ་བཟང་པོ་ཞིག་རེད།",
    "དེ་ནི་གཤིན་རྗེའི་བྱེད་ཕྱོགས་རེད།",
    "རྒྱལ་ཞེན་བྱེད་པ་དེ་དཔལ་ལྡན་ལྷ་མོའི་བྱེད་ཕྱོགས་རེད།",
    "བོད་ཀྱི་གལ་འགངས་ཆེ་ཤོས་ཡིན་པའི་སྲུང་མ་དཔལ་ལྡན་ལྷ་མོ་ཡིས་གཤིན་རྗེའི་ཤོ་མིག་བཟུང་བ་རེད།",
    "ཁོང་ཚོ་ལ་འབྲེལ་བ་ཡོད།",
    "ཆབ་སྲིད་ཀྱི་ཐོག་ནས་དཔལ་ལྡན་ལྷ་མོ་ནི་དམར་པོའི་རིང་ལུགས་འགོག་མཁན་དྲག་པོ་དེ་རེད།",
    "བཟང་སྤྱོད་ཀྱི་ཐོག་ནས་ལྷ་མོས་ཤོ་མིག་བཟུང་ཡོད།",
    "ཚོར་བའི་ཐོག་ནས་དཔལ་ལྡན་ལྷ་མོས་རྒྱལ་དར་གྱི་ལྗིད་ཡོད་ཚད་དེ་འཁྱེར་བ་རེད།",
    "བོད་མི་ཚོས་ལྷན་ཅིག་ཏུ་ཕན་ཚུན་ཞི་དུལ་གྱི་ངང་ལས་ཀ་བྱས་པ་རེད་ཅེས་བརྗོད་རྒྱུ་ནི་མགོ་སྐོར་བཏང་བ་ཞིག་རེད།",
    "ལྷོ་ཁར་འཛིང་བཞིན་པའི་མགོན་པོ་བཀྲ་ཤིས་ཀྱི་དམག་དཔུང་༡༩༥༨ ལོར་སླེབས་དུས་ཆུ་བཞི་སྒང་དྲུག་གི་དར་ཆའི་འོག་ཏུ་དམག་མི་ཁྲི་ཕྲག་བརྒྱད་ལྷག་རུ་སྒྲིག་བྱས་ཡོད།",
    "དེ་ཚོས་རང་གི་ལུང་པའི་ས་ཆ་གཞན་དུ་གང་འདྲ་ཞིག་འབྱུང་གི་ཡོད་མེད་ཐད་བསམ་ཚུལ་ཙམ་ཡང་མེད་ངོས་ནས་ཁོང་ཚོའི་ནུས་པ་རྩལ་འདོན་གྱིས་འཛིང་ཡོད་པ་རེད།",
    "སྐར་ཆ་རེ་རེའི་ནང་ཚུད་ལ་རྒྱལ་སར་ག་རེ་བྱུང་བའི་གནས་ཚུལ་སྐོར་མི་ཤེས་པའམ་ཏོག་ཙམ་ལས་ཤེས་ཀྱི་མེད་པ་རེད།",
    "སྐབས་མང་པོར་ལྷ་ས་ནས་བང་ཆེན་གྱིས་ཁོའི་རྗེས་ཟིན་རྒྱུ་ལ་བདུན་ཕྲག་གཉིས་རིང་ལམ་ཁ་ལ་རྟ་བཞོན་ནས་ཡོང་དགོས་ཀྱི་ཡོད་རེད།",
    "སྣག་ཚ་སྐམ་པོར་གྱུར་ཟིན་ཅིང་བང་ཆེན་གྱི་གཞུང་ཡིག་གི་མཐའ་ཟད་པ་དེའི་སྟེང་དུ་ལམ་ཁའི་ཐལ་བ་འགོས་ཡོད་སྟབས།",
    "བར་སྐབས་དེར་ཧ་ལམ་ག་རེ་བྱུང་ཡོད་པ་དེ་ཚོད་དཔག་ཐུབ་པར་གྱུར།",
    "འདི་འདྲ་ཐེངས་ཅི་ཙམ་ཞིག་བྱས་ཡོད་པ་མི་ཚོས་འཆར་སྒོམ་ཙམ་ཞིག་བྱེད་ཐུབ་ཀྱི་རེད།",
    "སྤྱི་སྡོམ་ཞིག་གི་ནང་ཆད་པ་ནི།",
    "༡༩༥༨ ལོར་ཆ་སྙོམས་ཀྱིས་བོད་མི་ཅི་ཙམ་ཞིག་གིས་ཁོང་ཚོའི་མཐའ་སྐོར་དུ་གནས་ཚུལ་ལྷགས་བཞིན་པ་དེའི་སྐོར་དངོས་གནས་ཁོང་དུ་ཆུད་ཡོད་དམ།",
    "ལོ་མང་རིང་གི་གུང་ཁྲན་གྱི་གཉའ་གནོན་ནས་བྱུང་བརྟེན་ཁོང་ཚོས་ཁོང་ཚོ་རྒྱ་ལ་མི་དགའ་བ་དེ་ཤེས་ཡོད།",
    "ཁོང་ཚོས་རང་གི་ལུང་པ་ཕྱིར་རང་ལ་ཐོབ་འདོད་པ་དེ་ཤེས་ཡོད།",
    "དེ་ནི་ཁོང་ཚོས་རང་གི་མི་ཚེ་ཕྱིར་ཐོབ་འདོད་པ་རེད་ཟེར་བ་དེ་རེད།",
    "ཡིན་ན་ཡང་བདེན་པ་བཙན་པའི་གནས་ཚུལ་ངོ་མ་གང་འདྲ་ཞིག་ཁོང་ཚོ་ལ་ཐོབ་པ་དེ་སྤྱད་ནས་ཁོང་ཚོའི་དཀའ་རྙོག་སེལ་ཐབས་གང་འདྲ་རྩེ་ཕུད་ཡིན་པ་ཐག་གཅོད་བྱེད་ཐུབ་བམ།",
    "མེ་མདའ་ལག་ཏུ་ལེན་རྒྱུ་ནི་དོན་དག་གཅིག་རེད་ལ།",
    "འབེན་གང་ལ་འཛིན་པ་ཤེས་རྒྱུ་ནི་དོན་གཞན་ཞིག་རེད།",
    "ལུང་པའི་ལྷག་མ་རྣམས་ནི་ད་ལྟའི་གནས་ཚུལ་རྣམས་ནི་ཁ་ནས་ཐོན་པའི་སྐད་ཆ་ཏག་ཏག་དེ་རེད།",
    "གནས་ཚུལ་དངོས་སུ་མཐོང་མཁན་གྱི་མི་ཞིག་ཡིན་ན་ཁོས་གང་ཤེས་པརྣམས་ཁྱབ་སྤེལ་བྱེད་ཐུབ་པ་དེ་ནི་ཅི་ཙམ་ཞིག་གི་བར་དུ་ཁོས་རྐང་བགྲོད་བྱེད་ཐུབ་པའམ་ཡང་ཁོ་འཁྱེར་ཐུབ་པ་ཙམ་ཞིག་གི་བར་རེད།",
    "ལུང་པ་གཅིག་གི་ནང་གནས་ཚུལ་གང་བྱུང་དེ་དེའི་རྒྱབ་ན་ཡོད་པའི་ལུང་པའི་ནང་ཤེས་ཀྱི་མེད།",
    "གློག་ཡོད་མ་རེད།",
    "པེ་ཅིན་གྱི་ལས་བྱེད་ཚོར་གནས་ཚུལ་གཏོང་བ་ལས་བོད་མི་ཚོ་ལ་གཏོང་གི་མ་རེད་ལ།",
    "ཏན་ཏན་འཛམ་གླིང་ཕྱི་རོལ་ལ་གཏོང་གི་མ་རེད།",
    "གནས་ཚུལ་དེ་ཁུངས་སྐྱེལ་བྱེད་པའི་ཐབས་ལམ་ཉག་གཅིག་ནི་རྒྱ་མི་དང་རྒྱ་གར་གཞུང་དག་བརྒྱུད་ནས་བྱེད་རྒྱུ་དེ་རེད།",
    "རྒྱ་ནག་དབུས་གཞུང་གི་སེམས་ཁྲལ་ཞིག་ཡིན་པ་ལས་གཞན་སུ་ཞིག་གི་ཡང་མིན་པར་ཨུ་ཚུགས་བྱས་པ་རེད།",
    "རྨོངས་དད་ཅིག་དང་བཅས་བོད་མི་རྒྱལ་སའི་ཕྱོགས་སུ་གནས་མཇལ་ལ་ཡོང་བ་ནི་ཇེ་མང་དང་ཇེ་མང་རེད།",
    "གཞན་པ་ཚོས་ཐ་ན་དེ་འདྲའི་རེ་བ་ཆུང་ཆུང་དེ་ཡང་བརླག་ནས་ལྷོ་ཕྱོགས་སུ་རྒྱ་གར་ལ་གཏད་ནས་སོང་མོད།",
    "ཕྱོགས་གཞན་ཞིག་ནས་རིམ་པ་རེ་རེ་བཞིན་ཁ་ཕྱོགས་ཀྱི་སྐོར་ལ་ཤེས་ཚོར་ཏོག་ཙམ་ལས་མེད།",
    "བོད་ཀྱི་མུན་པ་ཆེ་ཤོས་ཀྱི་དུས་ཚོད་འདིར་ཡང་ད་དུང་ནང་པ་བ་མང་པོས་ཁ་ཕྱོགས་གང་ཞིག་ཏུ་འགྲོ་དགོས་པ་ཧ་ལམ་གསལ་པོར་ཤེས་མཁན་མང་པོ་བྱུང་འདུག་ཁ་ཕྱོགས་དེ་ནི་ཐད་ཀར་དང་རྒྱལ་ཞེན་གྱི་ལམ་ཁ་སྟེ་རང་གི་སྤུན་གྲོགས་བོད་མི་ཚོར་རོགས་བྱེད་རྒྱུ་དེ་རེད།",
    "ཡིན་ན་ཡང་ཁོང་གིས་རེ་བ་ཏོག་ཙམ་ཞིག་དང་བཅས་ངང་སྒུག་བྱས་ཤིང་།",
    "དེའི་རིང་དེར་ཨ་མི་རི་ཀ་བ་ཚོས་ཅི་མངགས་བྱེད་རྒྱུའི་གྲ་སྒྲིག་ཨང་གསར་ངང་བསྡད།",
    "རྒྱ་གར་གྱི་མཐའ་གྲོང་འདིར་ཧ་ལས་པའི་སྐྱབས་བཅོལ་བ་འབོར་ཆེན་ཞིག་བླུགས་ཡོང་བ་དངོས་སུ་གཟིགས།",
    "ཁོང་གིས་དཀའ་རྙོག་གི་ཆ་ཤས་འདི་ལ་དམིགས་པ་གཏོད་རྒྱུའི་ཐག་གཅོད་བྱས།",
    "དེ་ནས་བདེ་དོན་ཚོགས་པ་དང་ཚོགས་པ་གཞན་སྣ་ཚོགས་པ་ཞིག་ནས་ཞལ་འདེབས་བསྡུ་ཆེད་ནིའུ་ཡོག་ལ་ཕེབས།",
    "དེ་རྗེས་བོད་མི་སྐྱབས་བཅོལ་བའི་ཆེད་དུ་རོགས་རམ་འཆར་གཞི་ཐོག་མ་དེ་བཙུགས་པ་རེད།"
  ]
}