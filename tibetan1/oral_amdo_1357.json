    "སྤུན་གྲོགས་འཇབ་རྒོལ་པ་ཚོ་ནི་སོ་སོའི་ཤུལ་ལུས་ཀྱི་ཁྱིམ་མི་ཉག་གཅིག་དེ་རེད།",
    "ཁོང་ཚོ་ལ་དམག་མིའི་སྒྲིག་ཆས་མེད་ནའང་ཁོང་ཚོའི་ཆིག་སྒྲིལ་དམ་པོ་ཡོད་པ་སྟོན་པའི་ཆེད་དུ་ཕྱི་ལོགས་ཀྱི་གྱོན་ཆས་ཤིག་དགོས་པ་མེད་པ་རེད།",
    "ཁྱེད་ཀྱིས་ཁོང་ཚོའི་སོ་གསེབ་ནས་བོད་ནང་གི་རྒྱ་མི་ཡོད་ཚད་གསོད་འདོད་ཡོད་པ་མཐོང་ཐུབ།",
    "དེ་ནི་མིའི་རིགས་དང་འགྲོགས་འདྲིས་དཀའ་བའི་ལྷ་དང་ལྷ་མོ་ཁག་གཅིག་གི་གོ་ས་བཙན་པོ་ཡོད་པ་ཞིག་རེད།",
    "དེ་མིན་གྱི་གསང་བ་ཡ་མཚན་ཅན་གྱི་བསྐལ་བ་ཡ་ཐོག་གི་རྣམ་པ་མང་པོ་ཞིག་བརྒྱུད་ནས་ཞིབ་ཏུ་བལྟ་བཞིན་ཡོད།",
    "དུས་ནས་དུས་བཞིན་བོད་ཀྱི་བཙན་པོ་དག་གིས་རྒྱབ་སྐྱོར་ཐོབ་ཡོད་པ་རེད།",
    "ཡུལ་ཕྱོགས་དེར་སྙན་གྲགས་ཆེ་བའི་ནང་པའི་གྲུབ་ཆེན་ཞིག་གདན་འདྲེན་ཞུས་ནས་བོན་གྱི་ལུགས་སྲོལ་ལ་གདོང་ལེན་བྱས་པ་རེད།",
    "ཁོང་རྒྱལ་རིགས་ནས་འཁྲུངས་ཤིང་མང་པོ་ཞིག་གིས་ཁོང་ནི་རྒྱལ་བ་གཉིས་པ་ཞེས་ཡིད་ཆེས་བྱས།",
    "བདུད་མོའི་མིག་ལ་བུ་ག་བཏོན་ཅིང་།",
    "དེ་ནས་ཐུན་མོང་མ་ཡིན་པའི་བོད་ཀྱི་ལྷ་སྲུང་འདི་ཡོད་པར་གྱུར་པ་རེད།",
    "དེང་དུས་ཀྱི་ཀློག་མཁན་ཚོ་ལ་རྒྱལ་བ་གཉིས་པ་ཞེས་པ་དང་འབྲེལ་བའི་སྒྲུང་རྣམས་ནི་དེ་ཚོས་བསྟན་སྲིད་པ་ཇི་བཞིན་གྱི་འཆར་སྣང་ཞིག་ཡིན་པ་དེ་ཙམ་གྱིས་བོད་ནང་དུ་ཧ་ཅང་གཟབ་ནན་ཞིག་ཏུ་བརྩིས་ཡོད་པ་རེད།",
    "ཁོང་ལོ་བརྒྱ་ཕྲག་བཅུ་གཉིས་ཙམ་གྱི་སྔོན་ལ་བཙན་པོ་ཁྲི་སྲོང་ལྡེ་བཙན་གྱི་རྒྱན་བཙུགས་གདན་ཞུས་ཐོག་བོད་ལ་ཕེབས་པ་རེད།",
    "མི་སྙན་གྲགས་ཅན་འདི་གཉིས་བསམ་ཡས་གཙང་པོའི་འགྲམ་གྱི་བྱེ་ཐང་རྒྱུད་དུ་ཆགས་ཤིང་ལྷ་ས་ནས་ཤར་ལྷོའི་ཕྱོགས་སུ་ཀི་ལོ་མི་ཊར་དྲུག་ཅུ་ཙམ་ན་ཡོད་པའི་བསམ་ཡས་སུ་མཇལ་བ་རེད།",
    "དེ་ཡང་ཡང་ན་ཞོགས་ཀ་སྔ་མོའམ་དགུང་མོ་འཕྱི་བོ་གང་རུང་ཞིག་ལ་བྱེད།",
    "ང་ཚོ་ལ་དེ་འདྲའི་བརྡ་ཙམ་ཡང་བསྟན་མ་སོང་།",
    "བོད་ཀྱི་ལས་དོན་གྱི་འགོ་འཁྲིད་ཇཱོན་རེ་གྷན་གྱི་ཚབ་ཏུ་ཧྥི་རན་ཀི་ཧོ་ལོ་བྷེར་བཞག་པ་རེད།",
    "ང་ཚོས་ལས་ཀ་བྱས་ཟིན་པའི་མི་ཁ་ཤས་དང་སྡུར་ན་འོས་བབ་ཆེ་བའི་མི་སྐོར་གཅིག་དང་འབྲེལ་བ་བྱེད་བཞིན་པ་དེ་ང་ཚོས་ཤེས་ཟིན་ཡོད།",
    "ཁོང་ཚོ་ནི་དངོས་གནས་རང་གི་མི་ཚེའི་འགྲོ་བབ་དང་རང་གི་ལུང་པ་སྲུང་སྐྱོབ་བྱེད་པའི་ནང་ཞུགས་ཡོད་ཅིང་།",
    "དེའི་ཆེད་དུ་འཛིང་རྒྱུའི་ཆོད་སེམས་ཡོད་པ་རེད།",
    "བོད་མི་ཚོ་ལ་འདི་འདྲའི་སེམས་ཤུགས་ཆེན་པོ་ཞིག་འདུག་ང་ཚོ་ལ་ལག་ཆ་སྤྲོད་དང་ང་ཚོས་ལས་ཀ་བྱེད་ཀྱི་ཡིན།",
    "ང་ཚོས་ལས་ཀ་མཉམ་དུ་བྱས་པའི་སྐོར་ཁག་མང་པོ་ཞིག་གིས་དེ་འདྲ་ང་ཚོ་ལ་ལབ་ཀྱི་ཡོད་རེད།",
    "ང་ཚོས་བོད་མི་ཚོའི་ཆེད་དུ་ལས་ཀ་བྱེད་འདོད་བྱུང་།",
    "ཁོང་ཚོ་ནི་འགྲོ་ཆོག་ཆོག་ཡོད།",
    "ཁོང་ཚོ་མཚོན་ཆ་དང་མདེལ་རྫས་ཅུང་ཡག་ག་ཞིག་སྤྱོད་རྒྱུ་བཅས་རེད།",
    "དེ་ཚོ་ཚང་མ་འཚོལ་དགོས་པ་རེད།",
    "ཡིན་ན་ཡང་དེ་ཡིད་བརྟན་འཕེར་བ་ཡོད་མ་རེད།",
    "གསང་ཞིབ་ཀྱི་གནས་ཚུལ་ཧ་ལམ་མེད་པ་རེད།",
    "གལ་སྲིད་ཁྱེད་རང་གིས་དེ་ལ་བཀའ་འཁྲོལ་ཐོབ་ཐུབ་པ་ཡིན་ན།",
    "སྒོར་མོ་ནི་བླུགས་ཡོང་གི་རེད་ལ་དོན་གཞན་དག་ཚང་མ་འགྲུབ་ཡོང་གི་རེད།",
    "སྐབས་འདི་ལ་མེ་ཀར་ཐེ་སྭེ་པཱན་དུ་སྒུག་བཞིན་ནམ་ཞིག་ལ་སྙན་ཐོ་ཐེབ་ཆག་འདི་ཚར་རྒྱུ་ཡིན་ནམ་བསམས་ཀྱིན་ཡོད་པ་རེད་ལ།",
    "དེ་བྱུང་ཕྱིན་ཁོས་ལས་ཀ་རྣམས་འགུལ་བསྐྱོད་གཏོང་ཐུབ་གི་རེད།",
    "ཐོག་མའི་རོབ་རྩིས་མ་དངུལ་ངས་བཏང་བ་དེ་ཨ་སྒོར་འབུམ་ལྔ་ཡིན་བསམས་སོང་།",
    "ཨང་གྲངས་དེ་ང་ལ་ཇི་ལྟར་ཡོང་བ་ནི་ངས་ད་ནི་ཅི་ཡང་དྲན་གྱི་མི་འདུག་སྒོར་མོ་ཟུར་སྤྲོད་བྱས་པ་དེ་ནི་གསལ་ཁ་ཅན་ཞིག་མ་རེད།",
    "སྒོར་མོ་སྤྱོད་རྒྱུ་དེ་མགོ་ཚུགས་ཟིན་ཡོད།",
    "ང་ཚོས་རྒྱལ་ལོ་དོན་གྲུབ་ཀྱིས་དངུལ་ཁང་ཨང་གྲངས་ཤིག་ཁ་ཕྱེ་པ་དེ་བརྒྱུད་ནས་ཁོ་ལ་ཨ་སྒོར་༡༨སྤྲོད་མགོ་ཚུགས་ཡོད་བསམས་ཀྱི་འདུགདངུལ་རྩིས་ཀྱི་ལས་ཀ་བྱེད་མཁན་ཚོས་དེ་ཚོ་ལག་ལེན་བྱས་པ་རེད་ལ།",
    "ཁོང་ཚོས་དངུལ་དེ་ཁོའི་དངུལ་ཁང་ཨང་གྲངས་ཐོག་བཏང་ནས་ཁོས་ག་རེ་བྱེད་འདོད་ཡོད་ནའང་བྱེད་བཅུག་པ་རེད།",
    "ང་ཚོས་ཁོ་ལ་ལས་ཀ་འགྲིག་པ་དེ་བྱེད་པའི་ཡིད་ཆེས་བྱས་པ་རེད།",
    "ཁོས་བྱས་ཡོད་པ་རེད་བསམས་ཀྱི་འདུགཁོ་རང་གིས་དེའི་ཆ་ཤས་ཤིག་མ་རྩ་འཛུགས་ཀྱིན་ཡོད་པ་ངས་ཤེས་ཀྱིན་ཡོད།",
    "ནང་པ་བའི་རྒྱལ་ཁབ་མང་པོ་ཡོད་པ་རེད་ལ།",
    "དེ་དག་གི་ནང་དང་དམིགས་བསལ་གྱིས་ཉི་ཧོང་གི་ནང་ལས་འགུལ་ཤུགས་ཆེན་པོ་མང་པོ་ཡོད་པ་རེད།",
    "མཐའ་མཇུག་ཏུ་ལངས་ཕྱོགས་དེ་འཛིན་རྒྱུ་ཡིན་པའི་རེ་བ་བྱས་པ་རེད་ལ།",
    "མཇུག་འབྲས་སུ་བྱུང་བ་ཇི་བཞིན་ཁོང་གིས་དེ་འདྲ་རྩ་ནས་མ་གནང་བ་རེད།",
    "འཆར་གཞི་ཕུལ་བ་དེ་ལ་བཀའ་འཁྲོལ་ཐོབ་པ་རེད།",
    "འཆར་གཞི་དེ་ལ་ངས་མ་བྲིས་པའི་གོང་ནས་བཀའ་འཁྲོལ་སྤྲད་ཡོད་པ་རེད།",
    "ཧྥི་རན་ཀིད་ནི་དུས་ཚོད་ལ་སླེབས་གྲབས་འདུགཅེས་ལབ་པ་རེད།",
    "ཁོང་ཚོས་དེའི་ཐོག་མཐའ་སྡོམ་བརྒྱབ་ནས།",
    "ཐོག་མའི་ལས་འགུལ་གྱི་དམིགས་ཡུལ་ནི་བོད་མིའི་རུ་ཁག་གཉིས་བཙུགས་ནས་སླར་བོད་དུ་གནམ་མཆོངས་བྱེད་རྒྱུ་དེ་རེད།",
