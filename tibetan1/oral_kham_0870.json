    "ཡི་དམ་གྱི་ལྷ་མཐོང་བ་དང་སྒྲུབ་པ་གཤའ་མར་བྱེད་པ་ལ་སྔོན་ལ་བར་ཆད་འོང་བ་ཡིན་པར་གདའ་སྟེ།",
    "ལོ་གསུམ་མཛད་པར་ཡང་འདོད་པ་ཡིན་ཏེ་དོན་ལ་འགལ་བ་མེད་པར་འདུག་གསུང་།",
    "གནས་བརྟན་གྱི་རྩར་འོངས་ནས་སྤྲང་པོའི་ལུས་ལ་འོད་འཕྲོ་བ་གཅིག་འདུག་ན་རྣལ་འབྱོར་པ་གཅིག་ཡིན་ཏེ་དེ་ལ་རྩོད་པ་ཞུས་ན་ཟེར་བས།",
    "ཇོ་བོའི་ཐུགས་དགོངས་ལ་ད་ནི་བདག་ངེས་པར་རབ་ཏུ་བྱུང་དགོས་པར་འདུག་སྙམ་པའི་ཐུགས་དགོངས་བྱུང་ངོ།",
    "ཇི་ཙམ་གདའ་ཞུས་པས།",
    "དབུ་རུ་གཡུ་རུའི་བར་གྱི་རི་རྒྱུད་འདི་ཙམ་འདུག་གསུང་།",
    "རྒྱ་མཚོ་ཆེན་པོ་ན་གསེར་གྱི་སྐུ་གཅིག་འདུག་པ་ལ།",
    "དེའི་ཞབས་བརྐྱངས་པའི་སྐྱིད་པའི་འོག་ན་ཕར་ལ་མི་གཅིག་ཟན་ཟ་འགྲོ་དགོས་པར་འདུགསྤྱི་བོ་ན་བྱ་མང་པོ་ཡང་འབབས་ཀྱི་འདུག་ངས་དེ་ལྟ་བུ་ཡང་མཐོང་།",
    "རྟེན་བཟང་པོ་རང་བྱུང་དང་བཞེངས་པ་གྲངས་མེད་པ་བཞུགས་འདུག་གསུང་།",
    "ཁ་སང་འགྲོན་པོ་གཅིག་འོངས་པ་འགྲོན་ཁང་ན་འདུག་གོ།",
    "རྒད་པོས་དེར་ཕྱིན་པས་སྒོམ་ཀྱིན་བཞུགས་ནས་འདུག་པ་དང་ཕྲད།",
    "འཁོར་ས་ན་ཕར་ལྡེར་ཚོ་མང་པོ་བཞུགས་ནས་གདའ་བས་ལྡེར་ཚོ་གཅིག་བཞེངས་ནས།",
    "ལྡེར་ཚོ་གཅིག་ལ་ཞུ་བ་བྱེད་ཀྱིན་འདུག་པ་ལ།",
    "དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་མཛད་པའི་རྡོ་རྗེ་ར་བ་གཅིག་ན་བཞུགས་ཙ་ན།",
    "ཡང་རྡོ་རྗེ་གདན་གྱི་གྷན་རྡོ་ལི་ལ་བསྐོར་བ་མཛད་ཀྱིན་བཞུགས་ཙ་ན།",
    "ཡང་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱི་རྡོ་རྗེ་ར་བའི་ཁང་བུ་ལ་བསྐོར་བ་མཛད་ཅིང་བཞུགས་ཙ་ན།",
    "ངས་བལྟས་པས་དེ་ལྟར་མི་འདུག་བྱས་པས།",
    "དེའི་རྩ་ན་ཤིང་ནྱ་གྲོ་ཏའི་ཕུང་པོ་གཅིག་ཡོད་པའི་དྲུང་དུ་དོ་ནུབ་ཉལ་བའི་གཤིས་ཀྱི་ཤིང་ལོ་རྣམས་ཕར་འཆག་ཚུར་འཆག་བྱེད་ཀྱི་གདའ་སྐད།",
    "ཇོ་བོ་རྡོ་རྗེ་གདན་ན་བཞུགས་ཙ་ན་མ་ག་ཏའི་རྒྱལ་པོ་ནེ་ཡ་པ་ལ་དང་ནུབ་ཕྱོགས་ཀར་ནའི་མུ་སྟེགས་ཀྱི་རྒྱལ་པོ་གཉིས་རྩོད་པ་ཆེན་པོ་བྱུང་བའི་ཚེ།",
    "དེ་ཡིན་ཏེ་འོང་ཁོང་དུག་བྱེད་ཀྱིན་འདུག་གསུང་།",
    "བ་ལང་སྐྱོང་བྱ་བ་ལགས་པར་གདའ།",
    "སྐུ་གསུང་ཐུགས་ཀྱི་ནོངས་པ་མཐོང་མ་མྱོང་བ་ཡིན་པར་འདུག་སྟེ།",
    "དེ་མ་ཡིན་པ་ཡང་བོད་ལ་ཕན་ཐོགས་པའི་པཎྜི་ཏ་ཇི་ལྟ་བུ་འདུག་དྲིས་ལ་ཤོག་བྱ་བ་དང་།",
    "དཔལ་རྡོ་རྗེ་གདན་ནས་རྒྱལ་པོ་མ་ཧཱ་པ་ལ་བྱ་བས་སྤྱན་དྲངས་ནས་དེ་སྤྱན་འདྲོངས་ན་བོད་ལ་ཕན་བཞུགས་པའི་པཎྜི་ཏ་ཆེན་པོ་གཅིག་འདུག་ཐོགས་པར་བྷི་ཀ་མ་ལ་ཤི་ལའི་པཎྜི་ཏ་རྣམས་ཀྱིས་ལུང་བསྟན་ནོ།",
    "ཇོ་བོ་ལ་དད་པ་ཡང་སྐྱེས་ནས་དགྱེས་པ་ཡིན་པར་གདའ་གསུང་།",
    "ལོ་ཙཱ་ཡང་ཤེས་པས་པཎྜི་ཏ་སྤྱན་འདྲེན་པའི་ཕོ་ཉ་ལ་གཏོང་དགོས་པར་འདུག་ད་ཇོ་བོ་སྤྱན་མི་འདྲོངས།",
    "རྒྱ་གར་ཐང་ཆེ་བ་ལ་མཆི་ན་དགུང་གསུམ་དགོས་པར་འདུག་གསུང་།",
    "དེ་ནས་སྲོད་འཁོར་ཙ་ན་གྲུ་བྱུང་ནས་ཡང་སྔོན་ལ་རྒྱལ་པོ་མི་ཆེ་བར་བྱས་ནས་བསྒྲལ།",
    "ནམ་ལ་བྱུང་བདེ་ཀུན་སུ་ཡིན་སྙམ་ཙ་ན།",
    "བེ་རོ་ཙ་ན་རཀྵི་ཏ་བྱ་བ་དང་།",
    "ཚེ་དང་ལྡན་པ་འདི་སྤྱན་འདྲེན་དུ་བཏང་གདའ་བས།",
    "དེ་ནས་ནངས་པར་ཇོ་བོས་མེ་ཏོག་སྙིམ་པ་གང་བླངས་ནས་བྱོན་ཏེ་ལྷ་ཁང་དེ་ན་མཎྜལ་གཅིག་མཛད་ཀྱིན་བཞུགས་ཙ་ན།",
    "ཁྱད་པར་དུ་ཨུ་པ་སི་ཀ་གཅིག་ལ་ཕན་ཐོགས་ནས་འོང་པར་འདུག་གསུང་།",
    "ཕྱིར་རྗེས་ལྟར་ན་སྟོན་པ་ཡིན་པར་འདུག་ཚེ་ནི་བོད་དུ་བྱོན་ན་ཐུང་ཡོང་བར་འདུག་གསུང་།",
    "དུས་དེ་ཙ་ན་རྗེ་བཙུན་ནཱ་རོ་པ་ཆེན་པོ་བྲི་ཀ་མ་ལ་ཤི་ལའི་གཙུག་ལག་ཁང་དུ་བྱོན་ནས་རབ་ཏུ་བྱུང་བ་ཐམས་ཅད་ཀྱིས་བསུ་བ་མཛད་དེ།",
    "དེ་ཙ་ན་འདི་དགོས་པ་ཡིན།",
    "ཇོ་བོ་ཡང་བསམ་པ་དག་པས་འབྱོན་པ་ལ་དགྱེས་པར་འདུག་པས་མ་བཏང་ན་གཞན་དོན་གྱི་བར་ཆེད་དུ་འགྲོ།",
    "ངེད་པས་བྲི་ཀ་མ་ལ་ཤི་ལ་བ་དྲག་སྟེབ་བཤོལ་མ་ཐེབས་པར་འདུག་ན་ཉིད་ཀྱིས་བཤོལ་མི་ཐེབས་ཟེར་ནས་མི་བཏབ་བོ།",
    "མུ་སྟེགས་ཀྱི་གནས་ཤིག་འདུག་དེ་ན་མུ་སྟེགས་ཀྱི་སྟོན་པ་བཅོ་ལྔ་བྱ་བ་འདུག་པས།",
    "ཡང་རྒྱ་གར་མཐའ་འཁོབ་ན་ཚུར་ལ་བྱོན་ཙ་ན།",
    "ཁྱེད་རང་གང་འདོད་གསུང་།",
    "ཀུན་དང་མི་མཐུན་པའི་ལྟ་བ་གཅིག་ཡོད་པར་འདུག་སྙམ་ཡང་ཇོ་བོ་ལ་སྣང་བ་སེལ་བ་ལགས་སམ་མི་སེལ་བ་ལགས་ཞུས་པས།",
    "ཁྱེད་རང་སྤྱོད་དང་གསུང་།",
    "དེ་ཙ་ན་ལོ་ཙཱ་བ་རིན་ཆེན་བཟང་པོ་ལ་ལོ་ཙཱ་བ་ཆེན་པོ་ཟེར་ནས་གང་བས་ཀྱང་བཟང་པར་བྱེད།",
    "དེ་གོང་དུ་མཁྱེན་པ་པ་ཆེ་ཡང་བསྒྲུབ་པའི་གདམས་པ་ཡེ་མི་གདའ་སྐད།",
    "ཨ་ལེ་བོད་ན་རྒྱ་གར་ན་མེད་པའི་གཏམ་མང་པོ་འདུག་གསུངས་ནས་རོལ་རྙེད་མ་ཕྲོགས་པ་དང་།"
  ]
}