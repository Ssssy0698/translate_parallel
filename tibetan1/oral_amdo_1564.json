    "དྲན་པ་ཐོག་ཏུ་འཁེལ་བ་ཨ་མཆོད་ངས་བྱས་སོང་།",
    "བྱས་པའི་སྔོ་ལོའི་རྒྱལ་མཚན་ཉི་མ་དེ་རིང་འཕུར་སོང་།",
    "ཞེས་པས་ལྔ་བརྒྱ་ནི་གཅིག་གི་གདོང་ལ་གཅིག་གིས་བལྟ་ཞིང་མཆི་མ་འདོན་པར་ཉེ་ཞིང་།",
    "ཕུང་བྱེད་ཡིད་འཕྲོག་ལྷ་མོ་དེ་རིང་བཏོན།",
    "བུ་མོའི་རྗེས་བཙལ་ནས་ཕེབས་པར་སྲིད་ན་ལྗོན་པའི་ལམ་དགྲ་འདྲེ་སྐྱོན་གྱི་ཕྱིར་ལན་ཞིག་འཕོ་དགོས།",
    "རྣ་བ་གཞན་ལ་མ་ཡེངས་བུ་མོ་བདག་ལ་གསོན་དང་།",
    "དྲང་སྲོང་བདག་གིས་ལུང་བསྟན་ཞུས་པ་ཡིས།",
    "བྱང་ཕྱོགས་ནོར་བཟང་དྲུང་དུ་ཁྱོད་ཉིད་བརྫངས།",
    "ཅེས་གསུངས་པས་ཡིད་འཕྲོག་ན་རེ།",
    "མཁས་བཙུན་སྤྱན་རས་གཟིགས་པ་གཉིས་པའི་དྲུང་།",
    "བུ་མོ་རྔོན་པས་བཟུང་ནས་གདུང་བའི་སྐབས།",
    "རྔོན་པས་ནོར་བཟང་དྲུང་དུ་བུ་མོ་ཕུལ།",
    "བུ་མོ་རང་གི་ཡུལ་དུ་ལོག་དགོས་བྱུང་།",
    "གཞོན་ནུ་བདག་གི་རྗེས་སུ་ཕེབས་པ་ཞིག་བྱུང་ན།",
    "དྲང་སྲོག་ཆེན་པོས་བུ་མོའི་ཕྱི་ལན་འདི་གསུངས་ཤིག།",
    "མཐའ་མར་བུ་མོའི་རྗེས་སུ་ངེས་མེད་ཕེབས་པར་སྲིད་ན།",
    "བུ་མོའི་སོར་གདུབ་འདི་བཞིན་རྒྱལ་པོའི་ཕྱག་ཏུ་ཕུལ་ནས།",
    "སྦྲང་ཆར་སིལ་བུ་ཞིག་གིས་ལམ་སྣ་འདྲེན།",
    "ཤ་བ་སྨུག་ཆུང་ཞིག་གིས་ལམ་སྣ་འདྲེན།",
    "ལ་མོ་མཐོན་པོ་ཞིག་ཏུ་འབྱོར་བ་ཡི།",
    "ཨ་མ་མ་མ་བུ་ཆུང་ངའི་སེམས་ཉིད་ནི་སྐྱིད་པ།",
    "ལུས་སེམས་སྐྱེད་པའི་ཨ་མ་ཁོང་དང་འཕྲད་དགོས་ཡོད་དོ།",
    "ཞེས་དམག་སྒར་བྱིངས་མ་རྣམས་རྗེས་ལ་འཇོག་གནང་གིས་ནོར་བཟང་དཔོན་གཡོག་ཉུང་བསྡུས་ཤིག་རྩོལ་ཁྱད་ཀྱིས་བྱོན་པས་སྟག་ལ་ལ་ཐོག་ཏུ་འབྱོར་ནས་ལྷ་རྣམས་ལ་ག་ཏངརག་མངའ་གསོལ་འདི་ལྟར་ཞིག་མཛད་དོ།",
    "འདི་གཉིས་བྱང་ཕྱོགས་ཡུལ་ལ་ལྷ་གཞི་བདག་གི་སྤྲུལ་པ་ཡིན་ཡང་སྲིད་སྙམ་ནས་བྱ་རོག་གཉིས་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་བ།",
    "བཟང་འདུག་ཟེར་ན་འདབ་བྱ་ཁྱོད་གཉིས་ཀྱིས།",
    "ཞེས་གསུངས་པས་འདབ་བྱ་གཉིས་ནས་བསྐོར་བ་གཡས་སུ་བསྐོར་ནས་ནོར་བཟང་གི་འགྲམ་དུ་ཡོང་ཏེ་ཕྱེ་མར་ཐོས་པས་ནོར་བཟང་དགྱེས་ཤིང་འདི་སྐད་དོ།",
    "ཡུམ་ཆེན་ཨ་མ་སྐུ་ཁམས་བཟང་ལགས་སམ།",
    "བཟང་འདུག་ཟེར་ན་འདབ་བྱ་ཁྱོད་གཉིས་ཀྱིས།",
    "ཨ་མ་མ་མ་བུ་ཆུང་ངའི་སེམས་ཉིད་ཀྱི་དགའ་བ།",
    "ལུས་སེམས་སྐྱེད་པའི་ཨ་མ་དེ་སྐུ་ཁམས་བཟང་བར་ཡོད་འདུག།",
    "གསུངས་པས་འདབ་བྱ་གཉིས་ནས་དབེན་ཙམ་རིང་པོའི་སར་འཕུར་སླར་ཡང་ས་ལ་རེག་ལ་ཁད་བྱས་ནས་གཡོན་བསྐོར་བརྒྱབ།",
    "བུ་ཆུང་ང་ཡི་སྲོག་གཅོད་འདབ་བྱ་གཉིས་ཀྱིས་བྱས་སོང་།",
    "ད་རུང་རང་བརྒྱུད་རང་གི་མ་བཏུལ་ན།",
    "ཞེས་རང་གིས་རང་ལ་སེམས་བཅག་གནང་ནས་ལ་ཁ་དེར་དུམ་ཞིག་གཞི་གནས་ཀྱི་དགོངས་པ་ལ་བཞུགས།",
    "སླར་ཡང་འདབ་བྱ་གཉིས་ལ་གཟིགས་ནས་འདི་སྐད་དོ།",
    "འོན་ཏེ་ཨ་མ་མཇལ་བར་ལན་གཅིག་འགྲོ།",
    "བུ་མོ་ཡིད་འཕྲོག་བདེ་སྐྱིད་ལྡན་པ་ནས།",
    "ཞེས་པཀའ་སྩལ་བས་འདབ་བྱ་གཉིས་ཀྱིས་ནོར་བཟང་གི་མདའ་ཡིག་དེ་ཁྱེར་ནས་བྱང་ཕྱོགས་སུ་ཡབ་ཆེན་ཐོག་སྐོར་དུ་ཕེབས་པའི་སྐུ་མདུན་དུ་ཡོང་ནས་སྤང་རྒྱའི་ཁར་བབ།",
    "ལྷ་སྲས་ཡིད་འཕྲོག་མེད་པས་ཨ་མ་ངའི་སྐྱོ་བ།",
    "ཨ་མ་རང་བློ་ཆུང་ནས་སེམས་ལ་ཅི་འཆར་མི་འདུག།",
    "ཨ་མ་དགའ་སྡུག་གཉིས་ལ་སོར་ཐག་འཐེན་འཐེན་བྱས་བྱུང་།",
    "ཡིད་འཕྲོག་གཞིས་སུ་མེད་པར་ཨ་མ་བློ་སེམས་མ་སྐྱོ།",
    "ལ་བཙས་གཉིས་པའི་ཐོག་ཏུ་ཨ་མའི་བསུ་བ་བསྤྲིག་ཤིས།",
    "ཡིད་འཕྲོག་ལྷ་མོའི་གདོང་བསུ་རྗེས་ལ་སྡོད་པ་ཅི་ཡིན།",
    "ཨ་མ་བགྲེས་པོའི་བསུ་ཆང་སྔོན་ལ་ཡོང་བ་ཅི་ཡིན།",
    "དེ་འདྲ་ཡུམ་ཆེན་ཨ་མས་གསལ་པོར་ཤོད་ལོགས་ཟེར་ཡོང་།",
    "དེ་ལ་ཡུམ་ཆེན་ཨ་མས་འདི་བཞིན་སྨྲས་ན་ལེགས་སོ།",
    "ཡིད་འཕྲོག་ལྗོན་པའི་ཡུལ་ལ་གཉེན་འཕྲད་དུ་སོང་གི།",
    "བུ་ཆུང་བྱང་ནས་འཁོར་ན་བུ་མོ་མྱུར་བར་ཡོང་ངེས།",
    "རྒན་མོ་ཅ་ཅོ་མ་མང་དེ་བཞིན་ཡིད་ལ་ཞོག་དང་།",
    "ལ་བཙས་དང་པོའི་བསུ་བ་བཙུན་མོ་ལྔ་བརྒྱས་བསྒྲིགས་ནས།",
    "དེ་ནས་ཞག་ཤས་སོང་བའི་ཚེ་ན།",
    "དེ་ནས་མི་རིང་བར་རི་ཟུར་ཞིག་ནས་ཕེབས་བྱུང་བའི་ལ་བཙས་གཉིས་པའི་ཐོག་གྲ་བསྒྲིགས་ཡོད་པ་ནོར་བཟང་ནས་མཁྱེན་པས་ལ་ཁ་དེ་ན་གྲ་བསྒྲིགས་འདུག་དེར་ཡིད་འཕྲོག་མེད་ཀྱང་ཨ་མ་ཡོད་འགྲོ་དགོངས་ནས་རྩོལ་ཁྱད་ཀྱིས་ཕེབས་པས།",
    "ཡུམ་ཆེན་ཨ་མ་སྐུ་ཁམས་བཟང་ལགས་སམ།",
    "ཨ་མ་བགྲེས་པོའི་བསུ་ཆང་སྔོན་ལ་བྱོན་པ་གང་ཡིན།",
    "ཨ་མ་བཀའ་དྲིན་ཅན་གྱིས་བདག་ལ་གསལ་པོར་གསུང་དང་།",
    "ཕྱག་ཏེ་ཕེབས་པ་ལེགས་བྱུངཨ་མའི་གཞོན་ནུ་ནོར་བཟང་།",
    "ང་ཚོ་གཞིས་པའི་གཞིས་གོ་ཡ་མཚན་ཆེ་ཙམ་ཡོད་དོ།",
    "ཨ་མ་ལུས་སེམས་བྲེལ་བའི་གདུང་བ་ཆེ་བ་མ་གཏོགས།",
    "བུ་ཆུང་གདན་ལ་བཞུགས་དང་ངང་གིས་ངང་གིས་ཞུ་ཡོང་།",
    "ཚུར་ལ་གསོན་དང་ང་ཡི་ཡུམ་ཆེན་གྱི་ཨ་མ།",
    "སྟག་ལ་ལ་མོའི་ཁ་རུ་འདབ་བྱས་ཟེར་བ་བདེན་བྱུང་།",
    "བདག་གི་ལྷ་སྲས་ཡིད་འཕྲོག་ད་ནི་མེད་པ་ཚར་རམ།",
    "བུ་མོ་མེད་པའི་མེད་ལུགས་ཨ་མས་ཤོད་རོགས་གནང་དང་།",
    "ན་ཤི་ལུགས་དང་མཐུན་ན་འགྱོད་ཀྱང་བྱ་ཐབས་བྲལ་སོང་།",
    "བསམ་ངན་ཟས་ལ་དོགས་པས་བུ་མོ་ཤི་བ་མིན་ནམ།",
    "འགྲན་སེམས་མི་ངན་གཞན་གྱིས་བུ་མོ་བསད་པ་མེད་དམ།་།",
    "བུ་མོ་མེད་པའི་མེད་ལུགས་གསལ་པོ་རུ་གསུང་དང་།",
    "རྣ་བ་གཞན་ལ་མ་ཡེངས་ཨ་མ་ང་ལ་གསོན་དང་།",
    "བུ་ཆུང་ཐུགས་ངལ་མ་མཛད་ཨ་མའི་བསུ་ཆང་བཞེས་དང་།",
    "གཏམ་དང་འཕྲོས་པའི་གླེང་མོ་ད་དུང་ཞིབ་ཏུ་ཞུས་ཆོག།",
    "ཚུར་ལ་གསོན་དང་དགོངས་དང་ཡུམ་ཆེན་གྱི་ཨ་མ།",
    "ཨ་མའི་བཀའ་བཞིན་བདེན་ན་བུ་མོ་ཤི་བ་མེད་འདྲ།",
    "བུ་མོ་མ་ཤི་ཟེར་ན་བུ་ཆུང་བློ་སེམས་བདེ་བ།",
    "ཡུམ་ཆེན་ཨ་མས་བློ་ཁྲིད་གསུང་ཕྱོགས་འདྲ་མིན་ནམ།",
    "ཨ་མ་བཀའ་དྲིན་ཆེ་བའི་ད་ལན་འདི་རུ་ཡོང་ངོ།",
    "ལུས་སེམས་སྐྱེད་པའི་ཨ་མ་མཇལ་བ་ངོ་མཚར་ཆེ་སྟེ།",
    "ཀ་ལས་བྱས་པ་ཅན་གྱི་ཨ་མའི་བུ་ཆུང་ནོར་བཟང་།",
    "ཏ་ལ་གཉིས་པའི་སྟེང་ལ་ཨ་མས་བསུ་ཆང་བཏེགས་ཡོད།",
    "ད་དུང་གདན་ལ་བཞུགས་དང་ངང་གིས་ངང་གིས་ཞུས་ཆོག།",
    "པ་ཕ་ཡབ་ཆེན་རྒྱལ་པོ་མི་ངན་གཞན་གྱིས་བསླུས་སོང་།",
    "བུ་མོ་བརྒྱ་ལས་ལྷག་པ་ལྷ་སྲས་མཛེས་ལྡན་ལྷ་མོ།",
    "མ་ངས་སྟེང་ཕྱོགས་ལྷ་ལ་མི་གཏོང་ཀ་མེད་བྱུང་སོང་།",
    "ཚ་དྲག་ཆེ་རང་གྲགས་ནས་བུ་མོའི་ཕྱག་ཏུ་ཕུལ་བས།",
    "ཛ་རེ་ཛོ་རེ་མེད་པར་ལྗོན་པའི་ཡུལ་ལ་ཕེབས་སོང་།",
    "ཝ་མོ་བརྒྱལ་བ་བཞིན་དུ་ཉིས་སྟོང་ལྔ་བརྒྱས་བྱས་སོང་།",
    "ཟ་རེ་ཟི་རིའི་དམག་གིས་རོ་སྟོད་ན་ཚས་ཁེངས་སོང་།",
    "རང་གཉིས་མ་བུ་འཕྲད་པའི་གླེང་མོའི་གཏམ་ལན་འདི་ཚོ།",
    "ལ་མོ་འདི་ཡི་སྟེང་དུ་ཆད་ལུས་མེད་པ་ཞུས་ཡོད།",
    "ཨ་མ་མ་ཤི་གོང་ལ་ནོར་བཟང་གཞིས་ལ་ཕེབས་མཛོད།",
    "ཚུར་ལ་གསོན་དང་རྒྱལ་མཆོག་ནོར་བཟང་གི་མཚན་ཅན།",
    "ཆིབས་ཐོག་ཡོབ་ལང་གནང་ནས་ཕྱག་གཡས་ཆིབས་ལྕག་གི་ཡུ་བ་ཞབས་པུས་ལ་བཙུགས་ནས་འདི་སྐད་དོ།",
    "ཚུར་ལ་གསོན་དང་གཏན་གྲོགས་བཙུན་མོ་ཡི་ལྔ་བརྒྱ།",
    "ཁྱོད་ཅག་གཞིས་པས་གཞིས་གོ་ཆོད་པ་རེ་ཡོད་དམ།",
    "ནོར་བཟང་ཆང་དད་ཆེ་ན་རང་སྲོག་རང་གིས་བསྐྱལ་ཡོང་།",
    "བདག་གི་བརྩེ་པའི་ཡིད་འཕྲོག་མཐོང་ས་ན་མི་འདུག།",
    "རང་རེའི་ཕ་བུའི་ཚིག་ལ་འགྱུར་བ་ཡོང་དོགས་མི་འདུག།",
    "ལྷ་སྲས་ཡིད་འཕྲོག་ལྷ་མོ་ལྗོན་པའི་ཡུལ་ལ་ཕེབས་སོང་།་།",
    "ལྗོན་པའི་ཡབ་ཡུམ་གཉིས་ལ་མཇལ་ཁ་ཞུ་རུ་ཕེབས་སོང་།",
    "ཁྱོད་ལ་སྔོན་བླང་བཙུན་མོ་ལྔ་བརྒྱ་ཙམ་ཡོད་དོ།",
    "མིང་ལ་མཛེས་ལྡན་ལྷ་མོ་བཏགས་པས་རང་ཆོག་གོ།",
    "ཨ་མ་ཡིད་འཕྲོག་ཐུགས་ནས་འདོར་བ་མེད་པ་ཞུས་པ།",
    "ང་དང་ལྷ་མོ་གཉིས་ལ་མིག་མཐོང་མེད་པས་ལན་བྱུང་།",
    "ངོ་དང་ལྷ་མོ་ཕྲལ་བའི་གཏན་དོན་ག་ལ་ཕན་པ།",
    "ལྷ་མོ་མེད་པའི་ལྷ་འདྲས་བདག་ལ་དགོས་པ་མེད་དོ།",
    "ཡབ་ལ་བདག་གིས་ཞུས་པར་གསན་འཇོག་ནི་མི་གནང་།",
    "མི་ངན་ནོར་བཟང་བུ་རུལ་ཁྱོད་ཉོན་དང་།",
    "བྱང་ཕྱོགས་རྒྱལ་པོའི་རིགས་ཀྱི་རྐང་འདྲེན་ཁྱོད།",
    "གསུམ་པར་ལུས་ཆས་མ་ལུས་ཡབ་ཆེན་པ་ཕས་བཞེས་སོང་།",
    "ལེགས་པར་སྤྱོད་པའི་དགྲ་བོ་ནོར་བཟང་ཡིན་ན་ཐུལ་སོང་།",
    "ཞེས་ཡུམ་ལ་གཟིགས་ནས་སྤྱན་ཆབ་བསིལ་བས་ཡུམ་ནས་འདི་སྐད་དོ།",
    "བུ་ཆུང་དེ་ལྟར་མ་གསུང་ཨ་མ་ང་ལ་ཉོན།",
    "ཚུར་ལ་གསོན་དང་ཨ་མ་བཀའ་དྲིན་ཅན།",
    "བྱ་ངན་ཡོང་རྐྱེན་ཨ་མས་གསུང་དུ་གསོལ།",
    "ཞེས་ཞུས་པས་ཡུམ་ནས་ཧ་རི་ལ་བརྒྱའི་བྱེད་ལས་ལྷ་མོ་ལ་བབས་ལུགས་སོགས་ཞིབ་ཏུ་གསུངས་ཏེ་ཡུམ་སྤྱན་ཆབ་བསིལ་ནས་ནོར་བཟང་སྐུ་ངལ་གྱིས་གསོལ་ཆས་ཀྱང་མི་བཞེས་ཤིང་།",
    "བཀའ་དྲིན་འཁོར་མེད་ཡུམ་ཆེན་ཨ་མ་ལགས།",
    "རེ་ཞིག་ཨ་མ་ཐུགས་ངལ་མ་མཛད་ཅིག།",
    "གསུངས་ནས་ཟླ་བ་བཞི་པའི་ཚེས་བཅོ་ལྔའི་ཟླ་བ་ཤར་བ་དང་དུས་མཉམ་ནོར་བཟང་གཅིག་པོ་ཐོན་སོང་།",
    "དམ་སྲིས་རྒྱུད་དཀྲུགས་པའི་བཙུན་མོ་ལྔ་བརྒྱའི་འདོད་དོན་ཧ་རིས་ཁས་ལེན་བྱས་པ་དོན་ཐོག་ཏུ་མ་ཁེལ་བའི་བྱེད་ངན་ཁ་བསྐྱེངས་པའི་ལེའུ་སྟེ་གསུམ་པའོ།་",
    "ནམ་ལངས་པ་དུས་མཉམ་ཞིང་དབུས་རིའི་རྩེ་དེར་ཕེབས་པ་དང་ཉི་མ་ཤར་བ་དུས་མཉམ་དུ་བྱུང་ཞིང་རི་རྩེ་དེ་ནས་གར་ཕེབས་མེད་པའི་ཕྱོགས་བཞི་ཀུན་ལ་གཟིགས་པས་ཐུགས་སྐྱོ་ཞིང་ངལ་བ་ཞིག་བྱུང་ནས་འདི་སྐད་དོ།",
    "འདི་ནས་ཕྱོགས་བཞི་ཀུན་ལ་བུ་མོའི་མིང་ནས་འབོད་དོ།",
    "བུ་མོ་རྫུ་འཕྲུལ་ལྡན་ན་ང་ལ་ཨ་ལན་མཛོད་དང་།",
    "བུ་ཆུང་གཅིག་པོར་བསྒྱུར་བ་ཡིད་འཕྲོག་ལྷ་མོས་ཡོད་དམ།",
    "ནོར་བཟང་ཉེས་མེད་བདག་ལ་ཐུགས་རྗེས་གཟིགས།",
    "ཕྱི་མ་ཡིད་འཕྲོག་ཁོང་དང་འཕྲད་པར་ཤོག་འཕྲད་ནས་གཅིག་ངོ་གཅིག་གིས་ཟིན་པར་ཤོག།",
    "བདག་ཉིད་ཐག་རིང་གི་མི་ལ་ཞལ་མཇལ་གསུང་ལན་ཞིག་ཞུ་ཡོང་།",
    "བརྩེ་བའི་ཐུགས་རྗེའི་སྤྱན་གྱིས་མི་རིང་མྱུར་བ་རུ་གཟིགས་ཤིག།",
    "དྲང་སྲོང་ནས་རྒྱལ་པོའི་གསུང་ཐོས་པ་ཙམ་གྱིས་དགྱེས་པར་གྱུར་ནས་དེ་འཕྲལ་གཟིགས་པས་སྐྱེ་བོ་མཐོང་ན་དགའ་བ་བལྟས་པ་ཙམ་གྱིས་དང་བ་འདྲེན་པ་ཞིག་འདུག་པར་འདི་སྐད་དོ།",
    "ཁྱོད་ཉིད་ཐག་རིང་ཡུལ་ཕྱོགས་ག་འདྲ་ཞིག་ནས་ཡིན་ནམ།",
    "བདག་གི་ཡུལ་ནི་བྱང་ཕྱོགས་མངའ་ལྡན་ཡིན།",
    "གི་ཞིབ་ཏུ་ཞུ།",
    "བདག་གི་ཡུལ་ལ་བྱང་ཕྱོགས་མངའ་ལྡན་ཟེར།",
    "ཡུམ་གྱི་མཚན་ལ་རྒྱ་གར་ལྷ་མོ་ཞུ།",
    "བདག་གི་མིང་ལ་ལྟོར་བུ་བཟང་པོ་ཟེར།",
    "སྔོན་བླང་བཙུན་མོ་ལྔ་བརྒྱ་བྱ་བ་ཡོད།",
    "ངོན་པས་བཟུང་བའི་ཡིད་འཕྲོག་ལྷ་མོ་དེ།",
    "བདག་དང་ལས་སྨོན་ཡོད་ཅེས་བཀའ་ལུང་གིས།",
    "བྱང་ཕྱོགས་རྒྱལ་པོ་བདག་གི་གྲོགས་སུ་བྱུང་།",
    "ནག་ཕྱོགས་དམ་སྲིའི་དཔུང་གི་ཆོ་འཕྲུལ་གྱིས།",
    "དེ་ཤུལ་ཡིད་འཕྲོག་ནག་མེད་བུ་མོ་དེ།",
    "ཧ་རི་ལྔ་བརྒྱ་བཅས་པའི་དམག་གིས་བསྐོར།",
    "བདག་གི་ཡིད་འཕྲོག་ལྷ་མོ་གཟིགས་ལགས་སམ།",
    "མཐོང་ཐོས་རེ་བའི་གཏམ་ཞིག་མེད་ལགས་སམ།",
    "ཁྱོད་ཉིད་ཤེས་བྱའི་མཛད་བཟང་།",
    "ལྗོན་པའི་ལྷ་སྲས་ཡིད་འཕྲོག་ལྷ་མོ་དེ།",
    "ཟིན་ཚེ་ནོར་བཟང་བཙུན་མོར་ཕུལ་བ་ལ།",
    "དེ་རིང་རྒྱལ་པོ་རང་གི་ཡུལ་དུ་ལོག།",
    "སླར་ཡང་ཡིད་འཕྲོག་བདག་གིས་མཐོང་ཐོས་ཀྱི།",
    "དྲང་སྲོང་གིས་ན་བཟའི་སྣེས་གཡབ་མོ་གནང་བ་རྒྱལ་བུས་གཟིགས་ནས་སླར་ཡང་དྲང་སྲོང་གི་དྲུང་དུ་བྱོན་པ་ན།",
    "ལྷ་མོའི་ལན་དང་འཕྲིན་པ་བདག་ལ་ཡོད།",
    "ཡིད་འཕྲོག་ལྷ་མོའི་ཕྱི་ལན་འདི་ལྟར་འདུག།",
    "བུ་མོའི་མཛུབ་རྒྱན་འདི་བཞིན་ཕུལ་བ་ཡིས།",
    "བུ་མོའི་སོར་གདུབ་དེ་རྒྱལ་པོའི་ཕྱག་ཏུ་ཕུལ།",
    "ལམ་དགུའི་བཀའ་མངགས་རྣམས་ཞིབ་ཏུ་ཞུས་པས་བུ་མོའི་སོར་གདུབ་དེ་ཕྱག་ཏུ་འབྱོར་པ་དང་།",
    "དྲན་མེད་དུ་སོང་སྟེ་དུམ་ཞིག་ལུས།",
    "བུ་མོ་བརྩེ་གདུང་ལྡན་པས་ང་ལ་ཕྱི་ལན་བཞག་འདུག།",
    "དེ་ནས་ནོར་བཟང་གིས་ལམ་དགྲ་རྣམས་མཛེས་མས་གསུང་བ་བཞིན་བསྒྲལ་ནས་ལྗོན་པའི་ཆུ་མིག་རིན་ཆེན་སྤུངས་འདྲར་ཕེབས།",
    "ཁྱོད་མིང་གང་ཞུ་རིགས་ནི་གང་གི་རིགས།",
    "ཚུར་ལ་ཉོན་དང་ན་ཆུང་བུ་མོ་གསུམ།",
    "དེ་ནས་བུ་མོ་གསུམ་པོ་ཡང་ཆུ་ཁ་དེར་ཚུར་ཡོང་ནས་བུམ་པ་ཕབ་ཏེ་ཆུ་བླུག་བཞིན་འདུག་པས།",
    "དེར་རྒྱལ་པོས་བུ་མོ་གསུམ་ལ་འདི་སྐད་ཅིག་གསུངས་སོ།",
    "ཚུར་ལ་ཉོན་དང་ཆུ་ལེན་བུ་མོ་གསུམ།",
    "ཁྱོད་ཀྱི་ཨ་ཅེའི་མིང་ལ་ཇི་སྐད་ཟེར།",
    "ང་ཡི་བུམ་པ་ཁྱོད་ཀྱིས་འཕྲོག་དོན་མེད།",
    "ཞིང་ཁམས་འདི་འདྲ་ཁྱོད་ཀྱིས་མ་ཤེས་ན།",
    "ཨ་ཅེའི་མཚན་ལ་ཡིད་འཕྲོག་ལྷ་མོ་ཞུ།",
    "ང་ཡི་མིང་ལ་མཐོང་གྲོལ་ལྷ་མོ་ཟེར།",
    "བུ་མོ་འདི་གཉིས་ང་ཡི་མདུན་གཡོག་ཡིན།",
    "ཡིད་འཕྲོག་ལྷ་མོ་ཞེས་བྱའི་མཛེས་མ་དེ།",
    "ཁྱོད་ཀྱིས་དྲི་བའི་ལན་དེ་གསལ་བར་བཤད།",
    "འོ་ན་ཉོན་དང་བུ་མོ་མཐོང་གྲོལ་མ།",
    "ཁྱོད་ཀྱི་ཨ་ཅེ་དེ་ལ་འདི་ལྟར་སྨྲོས།",
    "བུ་མོ་དེ་རྣམས་ཀྱིས་མ་ཤེས་པ་བྱས་པས་བུ་མོ་རྣམས་ཡིད་འཕྲོག་མའི་སྐུ་གམ་དུ་འབྱོར་བ་དང་མཐོང་གྲོལ་མས་འདི་སྐད་དོ།",
    "བུ་མོ་གསུམ་གྱི་ཀུ་རེ་ཡིན་འདུག་དགོངས་ནས་ཁྲུས་གསོལ་བས་བུམ་ཆུ་ཟད་མཚམས་སུ་ཡིད་འཕྲོག་མ་རང་གིས་ནོར་བཟང་ལ་ཀེའུ་རིར་བཞག་པའི་སོར་གདུབ་དེ་ཕྱོག་ཏུ་ཐོན་བྱུང་བས།",
    "བུ་མོ་དེ་རྣམས་ཀྱིས་བརྗོད་རིགས་དང་སོར་གདུབ་ཐོན་པ་ལ་དཔྱད་ན་ནོར་བཟང་བཀའ་དྲིན་ཅན་དེ་ཡིན་པར་ངེས་སོ་དགོངས་ནས་ཐུགས་དྲན་མེད་དུ་སོང་བས་དུམ་ཞིག་ལུས།",
    "བུ་མོས་ཡབ་ཡུམ་གཉིས་ལ་འཕྲིན་འདི་ཕུལ།",
    "ཡབ་ཡུམ་གཉིས་ནས་བུ་མོ་བསླུ་རུ་ཕེབས།",
    "རྟ་གླང་བུ་མོའི་ཚབ་དང་བཅས་པ་ཡི།",
    "དེ་སྐབས་ལྗོན་པའི་འཁོར་འབངས་སུ་གཅིག་གིས།",
    "བུ་མོའི་སྲོག་ནི་སྐྱོབ་པའི་རྒྱལ་སྲས་དེ།",
    "བུ་མོ་རིན་ཆེན་སྤུངས་འདྲར་གཏོང་བར་ཞུ།",
    "ཁྱོད་ཀྱི་སྲོག་བསླུ་བྱས་པའི་དྲིན་ཡོད་ན།",
    "ཡོལ་བས་བཅད་ནས་འཕྲོས་མོལ་བྱས་པས་ཆོག།",
    "ཅེས་ཡབ་ནས་བཀའ་འཁྲོལ་གནང་བས་བློན་འབངས་རྣམས་ཀྱིས་ཤར་སྒོའི་ཐང་དུ་ཡོལ་བས་བཅད་ནས་རྒྱལ་པོ་དང་ཡིད་འཕྲོག་གཉིས་ཕར་ཚུར་དུ་བཞག་ནས་ནོར་བཟང་གིས་འདི་སྐད་དོ།",
    "ནོར་བཟང་ཡོང་བའི་ཡོང་གོ་ཆོད་པ་རུ་བྱུང་སོང་།",
    "འདི་འདྲ་ཡིད་འཕྲོག་ལྷ་མོའི་བཞུགས་གནས་འདྲ་ལོས་ཡིན།",
    "ཞེས་ནོར་བཟང་ནས་གསུང་དབྱངས་དེ་བཞེས་པ་མཛེས་མས་འཚོར་ནས་ཡིད་འཕྲོག་གིས་འདི་སྐད་དོ།",
    "ལྷང་ལྷང་སྙན་པའི་གསུང་དབྱངས་བུ་མོའི་རྣ་བས་ཚོར་བྱུང་།",
    "ཡིད་འཕྲོག་ལྷ་མོའི་གསུང་དབྱངས་ཐོས་པས་ལུས་སེམས་བདེ་བ་རང་བྱས་བྱུང་།",
    "ཅེས་གསུངས་ཕྱག་གཡས་པས་གཡུག་ཙམ་ཞིག་མཛད་པས་དེར་ཡོད་ལྗོན་པའི་ཡོལ་བ་འཛིན་མི་བློན་འབངས་ཀུན་དུས་གཅིག་ཏུ་འགྱེལ་བས་རྒྱལ་པོ་དང་ལྷ་མོ་གཉིས་དེར་གསེར་ཞལ་ལྷན་རྒྱས།",
    "ཡིད་འཕྲོག་མས་རྒྱལ་པོའི་ཕྱག་ལ་འཆང་ནས་སྤྱན་ཆབ་འདོན་ཤིང་གཞོན་ནུའི་བཞིན་རས་ལ་ལེགས་པར་གཟིགས་ཏེ་ཞབས་ཀྱི་པུས་མོ་ས་ལ་བཙུགས་ནས་རྒྱལ་པོའི་ན་བཟའི་སྣེ་བཟུང་ཏེ་འདི་སྐད་དོ།",
    "མངའ་ལྡན་ལྷ་ཡི་སྤྲུལ་པའི་བྱ་རོག་གིས།",
    "ལ་བཙས་གཉིས་པར་ཨ་མའི་བསུ་ཆང་བྱུང་།",
    "ཨ་མར་བཀའ་འདྲི་ཞུས་པའི་དོན་གསལ་ལ།",
    "ཡིད་འཕྲོག་གར་སོང་ཡབ་ལ་བཀའ་འདྲི་ཞུས།",
    "ཡིད་འཕྲོག་ལྗོན་པའི་ཡུལ་ལ་སོང་བ་ཡི།",
    "སོང་དོན་ཡབ་ཡུམ་གཉིས་པོ་མཇལ་བར་སོང་།",
    "ཡབ་ནས་ཨ་མ་ཡིད་འཕྲོག་བྱམས་བརྩེ་ཡིས།",
    "དེ་བཞིན་ཡབ་ལ་བདག་གིས་ཞུས་པ་ལ།",
    "ཁྱོད་ལ་སྔོན་བླངས་བཙུན་མོ་ལྔ་བརྒྱ་ཡོད།",
    "མིང་ལ་མཛེས་ལྡན་ལྷ་མོ་བཏགས་པས་ཆོག།",
    "ཡང་གཅིག་ཡབ་ལ་བདག་གིས་འདི་ལྟར་ཞུས།",
    "ལྷ་མོ་མེད་པའི་ལྷོ་འདྲས་དགོས་པ་མེད།",
    "མི་ངན་རྒྱུད་ཀྱི་རྐང་འདྲེན་ནོར་བཟང་ཁྱོད།",
    "ཁྱོད་ཉིད་ཡུལ་གཞན་མྱུར་བར་འགྲོ་ཟེར་ན།",
    "ལུས་ཆས་ཀུན་བཞག་བུ་མོ་འཚོལ་བ་ལ།",
    "ཡུམ་ཆེན་ཨ་མའི་བཀའ་ནན་མ་ལྕོགས་པར།",
    "བུ་མོར་ལྔ་བརྒྱ་ཧ་རིའི་བྱ་ངན་གྱིས།",
    "ཞིབ་པར་ཨ་མས་བདག་ལ་གསུངས་བྱུང་བས།",
    "བུ་མོ་བརྩེ་དུང་ལྡན་པས་ཕྱིར་ལན་ཡང་།",
    "བུ་མོས་ཇི་གསུངས་ལམ་དགྲ་བཤགས་ནས་ཡོང་།",
    "ངེད་གཉིས་རེ་བའི་བསམ་དོན་དེ་རིང་བསྒྲུབས།",
    "ལྗོན་པའི་བློན་འབངས་ཡོལ་བ་འཛིན་མི་རྣམས་ནི་ནོར་བཟང་གི་ཤེད་སྟོབས་ལ་ཧ་ལས་པར་གྱུར་ཅིང་།",
    "ཞེས་གསུངས་ནས་ཡིད་འཕྲོག་མ་རང་གི་གཟིམ་ཆུང་གཡུ་བཀོད་ལྷ་ཁང་དུ་སྤྱན་དྲངས།",
    "ལྗོན་པའི་བློན་འབངས་རྣམས་ནས་ཡབ་ཡུམ་གྱི་དྲུང་དུ་ནོར་བཟང་གི་དཔལ་དང་གཟི་བརྗིད་སྙན་གྲགས་སོགས་ཀྱི་གནས་ཚུལ་ཞུས་པས་དྲི་ཟའི་རྗེ་འབངས་ཀུན་ཧ་ལས་ཤིང་བག་ཚ་བར་རྒྱལ་ཅིང་།",
    "གཅིག་གིས་གཅིག་གི་ཡོན་ཏན་མཐོང་བ་དང་།",
    "མི་འདོད་རྐྱེན་ངན་སྔོན་བྱུང་ཐལ་བ་ལས།",
    "བཀའ་དྲིན་འཁོར་མེད་ཨ་མའི་ཐུགས་གསོ་ཆེད།",
    "ངོས་མཇལ་བུ་མོས་དགོངས་ཁྲོལ་ཞུ་བ་དང་།",
    "དེ་ལྟར་བུ་མོས་ཡབ་ཡུམ་སྙན་དུ་གསོལ།",
    "ཞེས་གསུངས་པས་ཡིད་འཕྲོག་ན་རེ།",
    "བཀའ་ལ་གྱེན་བཟློག་བུ་མོས་མི་ནུས་ཀྱང་།",
    "གཞོན་ནུས་བུ་མོ་དགོངས་པས་ཡུལ་ཕྱོགས་འདིར།",
    "རྒྱལ་བུའི་བཀའ་བཞིན་ཞུ་ཐབས་བདག་གིས་འགྲོ།",
    "བུ་མོ་དེ་ལྟར་མ་གསུངས་ལྷ་སྲས་མ།",
    "བཀའ་དྲིན་ཅན་གྱི་བདག་གི་ཡུམ་ཆེན་དེ།",
    "ལྷག་དོན་བུ་མོ་འཚོལ་བར་བདག་ཐོན་སྐབས།",
    "ཨ་མར་གསང་ནས་ནུབ་གཅིག་ཡོང་བ་ཡིན།",
    "ཨ་མས་བདག་ཕྱིར་སྐུ་ངལ་སྲོག་ལ་ཉེན།",
    "བུ་མོ་དེ་ལྟར་མ་གསུངས་བྱང་ཕྱོགས་སུ།",
    "ཨ་མ་ཡིད་འཕྲོག་སུ་དང་བྲལ་ན་ཡང་།",
    "བུ་མོས་ཁས་བླངས་ཚིག་དེ་མི་འགྱུར་ན།",
    "བུ་མོས་ཡབ་ཡུམ་དྲུང་དུ་ད་སོང་ལ།",
    "ལྷག་དོན་གཞོན་ནུའི་ཡུམ་ཆེན་ཨ་མ་དེ།",
    "དྲིན་ཅན་ཡུམ་སྲས་གཉིས་ཀྱིས་བུ་མོའི་ཕྱིར།",
    "དགོངས་ཁྲོལ་རེ་བའི་དོན་ལ་འབེབས་མཁས་ཀྱི།",
    "སྒོ་ང་རང་གིས་ལོན་པའི་ཐབས་ལ་འབད།",
    "བུ་མོ་ཐུགས་ལ་བརྩེ་བའི་རྫུ་འཕྲུལ་གྱིས།",
    "ད་ལྟ་ཁོ་མོའི་ཤག་ཏུ་ལྷན་ཅིག་བཞུགས།",
    "བུ་མོའི་སྤྱི་པོའི་རྒྱན་དུ་སྩལ་ཏུ་གསོལ།",
    "བུ་མོ་ཡིད་འཕྲོག་ང་ལ་ཚུར་ཉོན་དང་།",
    "ཁྱོད་སྲོག་ནོར་གྱིས་བསླུས་པའི་སྐྱེ་བོ་དེ།",
    "དྲིན་ཆེན་ཡིན་ཚུལ་བུ་མོས་མོལ་བྱུང་བར།",
    "ཁྱོད་སྲོག་ནོར་གྱིས་སྐྱོབས་པའི་ལན་འཇལ་ན།",
    "ཟས་གོས་ནོར་གྱི་གནང་ཆ་ཡོང་མོལ་རུང་།",
    "ཞེས་གསུངས་པས་ཡིད་འཕྲོག་ན་རེ།",
    "བུ་མོར་ཐརྩེ་དུང་ཆེ་ནས་ཕེབས་པ་ལས།",
    "ཕོ་མོའི་བསམ་ཚོད་ཞུ་བའི་ཚིག་དོན་ལ།",
    "རང་རེའི་རྒྱལ་སྲས་ཀུན་གྱི་དང་མ་ཡིན།",
    "ཨ་ལྕེ་ཡིད་འཕྲོག་ཞེས་བྱའི་བུ་མོ་འདི།",
    "ནོར་བཟང་བུ་མོ་འདི་ལ་བརྩེ་བ་ཡིས།",
    "བསམས་ན་རྫུ་འཕྲུལ་ལྡན་པས་ཡིད་ཆེས་མོད།",
    "ཡིད་འཕྲོག་ཞུ་བའི་དོན་ལ་ཨ་མ་ཡིས།",
    "ནོར་བཟང་བུ་མོའི་རྗེས་སུ་སྙེགས་པ་ལས།",
    "ཨ་མས་ཞུ་ནན་ཆེ་བའི་གནངས་ཉིན་ཙམ།",
    "བདག་ཉིད་མོས་པས་ཞི་བའི་མཇལ་ཞུ་ལས།",
    "ཁྱོད་སྲས་ཡིད་འཕྲོག་ལྷ་མོ་འདི་ཉིད་དང་།",
    "བཀའ་ཡི་ལུང་གིས་བདག་གི་བཙུན་མོར་བརྫངས།",
    "ལྷ་སྲས་ཡིད་འཕྲོག་ལྷ་མོ་སུས་མཐོང་རུང་།",
    "དེར་བརྟེན་བདག་གི་ཡབ་ཡུམ་གཉིས་ཀྱང་དགྱེས།",
    "ནག་ཕྱོགས་བདུད་ཀྱི་དཔུང་གི་ཆོ་འཕྲུལ་གྱིས།",
    "ལྔ་བརྒྱ་ཧརིས་བྱེད་པའི་ཕུང་གི་མཐུས།",
    "བདག་གི་ཡབ་རྒྱུད་དཀྲུགས་པའི་མཛད་སྤྱོད་ཀྱི།",
    "བདག་གིས་བློས་མ་བཟོད་ནས་ཁོ་བོ་ཡོང་།",
    "ལྷ་སྲས་ཨ་ཅེ་ཡིད་འཕྲོག་ལྷ་མོ་འདི།",
    "བདག་གི་སྤྱན་དྲངས་རིགས་ཀྱི་བཙུན་མོར་འཛིན།",
    "ཞེས་ཞུས་པས་དྲི་ཟའི་རྒྱལ་པོ་ན་རེ།",
    "ང་ཡི་བུ་མོ་ཡིད་འཕྲོག་གཞོན་ནུ་འདི།",
    "རྔོན་པས་བཟུང་བས་བུ་མོ་གདུང་བའི་སྐབས།",
    "གསེར་དངུལ་དངོས་རིགས་ཁྱོད་ཀྱི་རེ་བ་སྐོང་།",
    "དགོས་འདོད་རེ་བའི་སློང་མི་མང་བའི་ཕྱིར།",
    "ལས་ཀྱིས་བསྐོས་པའི་ཡིད་འཕྲོག་ལྷ་མོ་འདི།",
    "བུ་མོར་ཡབ་ཡུམ་གཉིས་ཀྱིས་བཀའ་ཁྲོལ་ན།",
    "རེ་ཞིག་དྲི་ཟའི་ཡུལ་འདིར་བཞུགས་ན་ལེགས།",
    "ཞེས་ཞུས་ནས་ཟས་སྐོམ་རོ་མཆོག་ལྡན་པའི་སྣ་དུ་མ་དང་དྲི་ཟའི་གླུ་དབྱངས་རོལ་མོའི་རིགས་བྱེད་མང་པོས་ཡ་མཚན་དགྱེས་པའི་ལྟད་མོས་ཉི་མ་སོང་བ་ཡང་མ་ཚོར་ཞིང་།",
    "དེ་ནས་ཞག་ཤས་ནོར་བཟང་ལྗོན་པའི་སྐྱེད་མོས་ཚལ་རྣམས་ལ་སྤྱན་དྲངས་ཏེ་ཡིད་འཕྲོག་གིས་མཚོན་ལྷའི་བུ་དང་བུ་མོ་མང་པོས་གླུ་གར་རྩེད་འཇོའི་སྒོ་ནས་དགྱེས་ཤིང་བག་འཕེལ་བའི་ཐབས་བྱས།",
    "འགའ་ཞིག་གིས་ཡིད་འཕྲོག་གིས་ནོར་བཟང་ཐུགས་ནས་མི་གཏོང་བས་ཡབ་ཡུམ་གྱིས་བཀའ་འདོམ་པར་རིགས་ཟེར།",
    "འགའ་ཞིག་གིས་གནོད་སྦྱིན་གཞན་གྱི་དམག་སྐུལ་བ་ལེགས་ཟེར།",
    "རྩལ་སུ་མཐོ་ལ་བུ་མོ་སྟེར་ཟེར་ནས།",
