    "འདུག་སྟངས་དེ་ཉིད་བརྐྱང་བ་ནི།",
    "རྐང་བ་གཉིས་བསྣོལ་ནས་ཙ་ག་བུར་འདུག་ག་རྟིང་པ་བཏེགས་ཇོ་ནང་དཔེ་ཚ་གས།",
    "འདུག་སྟངས་རྣམས་ནི་ལུས་འཆུན་ཐུབ་པས་རྩ་ཁ་བཅིངས་ནུས་པ་ཞིག་དགོས་ཀྱི།",
    "ལོངས་སྐུའི་འདུག་སྟངས་བཞི་ལ་བདུད་རྩི་འཁྱིལ་བའི་ལྟ་སྟངས་ཞེས་བྱ་བ་མིག་གཉིས་བགྲད་དེ་ཐད་ཀ་ལས་ཅུང་ཟད་སྟེང་དུ་བལྟས་ཏེ།",
    "འཕོང་སྟེགས་ལ་བཞག་སྟེ་ཙ་ག་བུར་འདུག་ག་ལག་པ་གཉིས་བརླའི་ནང་ནས་འཁྱུད་དེ་ངར་གདོང་གཉིས་ཕྱི་ངོས་ནས་ལག་མཐིལ་གཉིས་ཀྱིས་བསྡམས་ཏེ་བཟུང་ལ།",
    "སྔ་མ་བཞིན་དུ་འཕོང་སྟེགས་ལ་བཞག་སྟེ་ཙ་ག་བུར་འདུག་ག་ལག་པ་གཉིས་བརླའི་ནང་ནས་འཁྱུད་དེ་ངར་གདོང་གཉིས་ཕྱི་ངོས་ནས་བསྡམས་ཏེ་བཟུང་།",
    "མི་ཐུབ་སྙམ་པ་ན་འདར་སྤྲུགས་དང་འདུག་འབེབ་བྱས་ཏེ་སྔར་ལྟར་ངར་གདོང་ཆེར་མནན་པ་དང་།",
    "ཙ་ག་བུར་འཕོང་སྟེགས་ལ་བཙུག་སྟེ་འདུག་ལ།",
    "འདུག་ཇོ་ནང་དཔེ་ཚ་གས།",
    "འདུག་འབེབ་བརྡེག་སྟེ་ཕྱིར་བཟུང་བཏང་ངོ།",
    "ཐོག་མར་སྐུ་གསུམ་གྱི་འདུག་སྟངས་ལ་བསླབ་པ་ནས་བཟུང་སྟེ་སྔོན་འགྲོ་ཉི་ཤུ་པ་འདིའི་བར་ནི་རྗེས་དྲན་རྗེས་མཐུན་པ་ལ་སྦྱོར་བྱེད་ཀྱི་སྔོན་འགྲོ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ལྔ་པ་རྗེས་དྲན་གྱི་འདུག་སྟངས་ཀྱི་རིམ་པ་ལ་བསླབ་པ་རྣམས་དང་།",
    "སོར་འཐེན་རྐང་འབྲས་ལངས་འདུག་གཉིས།",
    "ལངས་འདུག་བྱས་ནས་རྒྱ་མཚ་བསྐྱོད།",
    "འདུག་པའི་འཁྲུལ་འཁོར་རོ།",
    "ལངས་དང་འདུག་ནས་དགང་གཏོད་འདྲེན་པ་སྦགས་འདྲེན་ཏེ།",
    "རྐང་འཕྲ་ལངས་འདུག་སྟེ།",
    "༣ འདི་སྐབས་རྐང་བའང་གཡས་པས་གཡོན་པ་གནོན་གྱིན་འདུག་ག་དེ་བཞིན་ཏུ་གཡོན་ལའང་སྦྱར།",
    "དེ་ནས་གཉིས་པོ་ལངས་འདུག་གཉིས་ཀ་དང་།",
    "ལྷག་མ་འདུག་པའི་འཁྲུལ་འཁོར་རོ།",
    "རྐང་བ་ཟླུམ་པོའི་འདུག་སྟངས་དང་།",
    "ལག་པ་གཡས་དང་རྐང་བ་གཡོན་དུས་གཅིག་༣ ལག་པ་གཡོན་དང་རྐང་པ་གཡས་དུས་གཅིག་༣ འདི་ལའང་སྐྱིལ་ཀྲུང་བཅས་ཏེ་འདུག་ནས་མཉེ།",
    "འདི་མན་ཆད་ཀྱི་འདུག་པའི་འཁྲུལ་འཁོར་ཐམས་ཅད་ཀྱི་མཐར་རྡོར་འབེབས་འདིའི་སྒོ་ནས་མཐར་དབྱུང་བ་ཡིན་ནོ།",
    "འདུག་པ་དེ་ལས་ཡར་མ་ལྡང་བར་བཅའ་བའི་འཁྲུལ་འཁོར་ཐམས་ཅད་འདུག་པའི་འཁྲུལ་འཁོར་དང་།",
    "རྐང་ལག་བཞི་འདུག་སྟངས་རང་སར་གནས་པ་ལས་འཆུན་ལྷོད་ཀྱིས་གློད་ནས་མགོ་འདར་བར་བྱས་པའི་སྒོ་ནས་ལན་གསུམ་སྤྲུགས་ལ་རྡོར་འབེབས་བྱའོ།",
    "རོ་སྟོད་ཡར་འཐེན་པ་སྟེ་རོ་སྟོད་གཅུད་པས་རོ་སྟོད་འཆུན་པར་བྱེད་པའི་འདུག་སྟངས་སོ།",
    "སོར་འཐེན་རྐང་འཕྲས་ལངས་འདུག་གཉིས།",
    "ཡང་རྐང་པ་གཡོན་པས་ཀྱང་དེ་བཞིན་དུ་འཕྲ་ཚུལ་བྱེད་པ་ནི་ལངས་འདུག་གཉིས་ཀ་སྟེ།",
    "སླར་ཡང་སྔར་གྱི་འདུག་སྟངས་ལྟར་བསྐུམས།",
    "དེ་ནས་འདུག་སྟངས་རང་སར་གནས་ཏེ་རྒལ་བ་གྱེན་དུ་བཏེགས་ནས་མར་ས་ལ་བརྡབ་པའི་རྒྱབ་འཕུར་ལན་གསུམ་བྱས་ཏེ།",
    "ཡང་བརླ་གཡས་པའི་སྟེང་རང་སར་ཁུ་ཚུར་གཡས་པ་གྱེན་བསྟན་གྱི་སྟེང་དུ་གཡོན་པ་རྦུབ་སྟེ་བཞག་ལ་གཡས་སུ་ལན་གསུམ་དང་།",
    "བཅུ་གཅིག་པ་མན་ཆད་ཀྱི་བཅུ་ཚན་གཉིས་པ་ཐམས་ཅད་ལངས་པའི་འཁྲུལ་འཁོར་ཤ་སྟག་ཡིན་པས་བཅུ་པ་འདི་འདུག་པའི་འཁྲུལ་ཇོ་ནང་དཔེ་ཚ་གས།",
    "འདི་ལ་ཉེར་བཞི་ཡོད་པ་ལས་དང་པོ་ནས་བཅུ་དྲུག་པའི་བར་དང་ཉེར་བཞི་པ་རྣམས་ནི་འདུག་པའི་འཁྲུལ་འཁོར་ཤ་སྟག་ཡིན་པར་ཤེས་པར་བྱས་ལ།",
    "དེ་ཡན་ཆད་འདུག་པའི་འཁྲུལ་འཁོར་ཁོ་ནའོ།",
    "ཉེར་གཉིས་པ་དང་ཉེར་གསུམ་པ་གཉིས་དེ་ལངས་འདུག་གཉིས་ཀ་ཅན་གྱི་འཁྲུལ་འཁོར་རོ།",
    "ལངས་འདུག་བྱས་ནས་རྒྱ་མཚ་བསྐྱོད།",
    "ལངས་འདུག་བྱས་ནས་རྒྱ་མཚ་འི་བསྐྱོད།",
    "སེམས་དཔའི་སྐྱིལ་དྲུང་རང་སའི་སྟེང་ནས།",
    "རྐང་པ་གཉིས་མར་ཤད་ཀྱིས་བརྐྱང་པ་དག་དུས་མཉམ་དུ་བྱས་པའི་སྒོ་ནས་རྐང་པའི་མཐིལ་གཉིས་ལོགས་ངོས་ཞིག་ལ་དྲག་ཏུ་བརྡབ།",
    "ཡང་རང་སར་ལངས་ནས་ལྟག་བསྣོལ་གཤིབ་ལ་རྡོར་འབེབ་བྱའོ།",
    "ཡན་ལག་བཞི་ག་དུས་གཅིག་ཏུ་ནམ་མཁར་འཕངས་ལ་ངག་ནས་ཧ་ཞེས་དྲག་ཏུ་འདོན།",
    "སྒྱིད་ཁུང་གཉིས་ཅུང་ཟད་བཀུག་པ་ཟླུམ་པོའི་འདུག་སྟངས་བྱས་ཏེ།",
    "དེ་ནས་རྒྱབ་ས་ལ་གཏད་ནས་ཀན་རྐྱལ་དུ་ཉྭ་བཞི་བཀུམ་ནས་འདུག་ལ།",
    "ཕྱག་ལེན་ལ་འདུག་པའི་འཁྲུལ་འཁོར་རྣམས་ཀྱི་མཇུག་ཏུ་འབེབ་ཆུང་བསྡུས་པ་རྡོར་འབེབ་དང་།",
    "རྐང་ལག་བཞིའི་མགོར་འདུག་ཚུལ་དུད་འགྲོའི་ལུས་དབྱིབས་ལྟར་བྱས་ནས།",
    "དེ་ནས་ཀྱང་འདུག་སྟངས་དེ་གའི་སྟེང་ནས་གཡས་སུ་བསྒྱེད་ནས་ལུས་གཡས་སུ་གཅུད།",
    "བཅའ་གཞིའི་སྐྱིལ་ཀྲུང་རང་སའི་སྟེང་ནས།",
    "དེ་ནས་རྐང་པ་གཉིས་ཟླུམ་པོའི་འདུག་སྟངས་བྱས་ཏེ་ལག་གཉིས་ཁུ་ཚུར་འདོམས་འཇལ་བསྐོར་བ་ཚུར་བསྡུས་ནས།",
    "རྐང་པ་གཉིས་ཟླུམ་པོའི་འདུག་སྟངས་དང་ལག་པ་གཉིས་རྒྱབ་དུ་བརྐྱང་སྟེ་ཁུ་ཚུར་གཉིས་ཁ་སྦུབ་སུ་གཤིབས་ཇོ་ནང་དཔེ་ཚ་གས།",
    "རྒྱབ་ཕྱོགས་ཀྱི་ས་ལ་བཙུག་ག་རྐང་པ་གཉིས་ཟླུམ་པོའི་འདུག་སྟངས་ཀྱིས་འཕོང་དང་རྐང་ངར་སོགས་བཏེགས་ཏེ་གནས་པའི་སྒོ་ནས།",
    "བཅའ་གཞི་སྔོན་དུ་བཏང་ནས་རྐང་པ་སྐྱིལ་ཀྲུང་རང་ས་ལ།",
    "རྐང་ལག་བཞི་ག་དུས་མཉམ་དུ་ཕར་བསྐྱངས།",
