    "ལུང་གཞིར་འདུག་པ་བྱ་བ་གསོ་སྦྱོང་གནང་།",
    "མཚོ་ཊཱིཀ་ཟན་བཅད་ཞག་བདུན་བརླབས་བཅད་བཀགདུས་ནི་སྔ་དྲོ་ཡུན་ཚད་རང་རང་མཐའ།",
    "རྗེས་གནང་རང་དོན་རབ་བྱུང་མཁོ་བཞག་བརྒྱད།",
    "གཞན་ལུགས་དགག་དང་རང་ལུགས་བཞག་གཉིས་ལས།",
    "དེ་ནས་ཐམས་ཅད་ཙོག་པུར་འདུག་སྟེ།",
    "དེ་ནས་རྣམས་ཙོག་པུར་འདུག་སྟེ།",
    "དེ་ནས་ཙོག་པུར་འདུག་སྟེ་གནས་བརྟག་དགོངས་སུ་གསོལ།",
    "འཕགས་པའི་ཚོགས་སམ་བསྟན་པ་ལ་དགའ་བའི་ལྷ་གསལ་བཏབ་སྟེ་འདུག་ནས།",
    "དེ་ནས་ཙོག་པུར་འདུག་འདི་ལགས་སོ་ཞེས་ལན་གསུམ་ཐབས་ལེགས་བྱ།",
    "དེ་ནས་ཙོག་པུར་འདུག་སྟེ་གནས་བརྟན་སླད་དུ་དགུང་གཅིག་མཚམས་ཀྱི་སླར་རོལ་ཏུ་འདི་ལགས་སོ་ཞེས་ལན་གསུམ་དགོངས་སུ་གསོལ།",
    "དེ་ནས་བསྐོས་པའི་དགེ་སློང་གདིང་བའི་སྟེང་ན་འདུག་པའི་མདུན་པའི་མདུན་དུ་གནས་བརྟན་ནས་བཟུང་རྒན་རིམ་བཞིན་གསུམ་མན་ཆད་ཀྱིས་ཕྱག་གསུམ་འཚལ་ཏེ།",
    "ཁོང་རང་པར་དུ་ཤེས་དགོས་ཤིང་བསྐལ་བར་དྲན་གསོ་ཞུ་དགོས་པའི་བཀའ་དྲིན་འདི་ལྟར་མཆིས་ཏེ།",
    "མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་ཏུ་བཅུག་ཅིང་།",
    "ཞར་ལ་མཚན་གཉིས་པ་ལ་སོགས་པ་ཡིན་མ་ཡིན་བརྟགས་ལ་མིན་ནབར་ཆད་དང་མི་ལྡན་པར་གདའ་ལགས།",
    "འདིའི་སྔགས་ཚིག་ལན་གསུམ་རྗེས་སུ་བཟློ་བའི་སྒོ་ནས་བར་མའི་ཚུལ་ནས་ཙོག་པུར་འདུག་ཏུ་བཅུག།",
    "ཡོངས་སུ་དག་གོ་ཞེས་ཁོ་ན་ཉིད་མཆི་ཡིན་གདའོ།",
    "དེ་ཡང་ལོ་ཟླ་ཞག་དུས་འདི་ཚུན་ཆད་དུ་སྤོང་།",
    "ཁྱེད་རང་ལེགས་སོ་གྱིས་བྱས་ལ་ཕྲག་པ་གཡས་ངོས་སུ་སྤོས་ཐང་གོས་ལ་སྣམ་སྦྱར་ཞེས་པའི་ཚབ་བླ་གོས་དང་།",
    "དགེ་སློང་རང་དང་བསླབ་པ་མཉམ་པ་བྱུང་ན།",
    "མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་ཏུ་བཅུག་ལཆོ་ག་ནི་བཙུན་པ་དགོངས་སུ་གསོལ།",
    "ཚིག་དང་རང་གཞན་གཏི་མུག་གཅོད་པ་འཁོར་ལོ་བཞིན།",
    "བོད་ཕྲུག་ང་རང་ལ་མཚོན་ན་བསམ་བློའི་གོ་རྟོགས་དང་ཡོན་ཏན།",
    "ངས་ཀྱང་རང་གཞུང་དོན་དགོངས་འགྲེལ།",
    "མཛེས་པའི་ཡང་རྩེ་ཅན་གྱི་ཁྱད་ནོར་གང་ཡང་མི་འདུག་ཅེས་གུས་པ་རང་ཉིད་ཀྱི་མི་ཚེའི་བགྲོད་ལམ་ནང་འཕྲད་པའི་དཀའ་ངལ་གྱི་ཉམས་མྱོང་ཐོག་ནས་ར་འཕྲོད་པའི་མན་ངག་ཉག་གཅིག་སྟེ།",
    "དེ་ཡང་རང་རིགས་ལ་ལྷག་བསམ་དཀར་བའི་རིགས་མཐུན་གྱི་ཁྱེའུ་གཞུང་དྲང་ཞིག་དང་།",
    "འཛམ་གླིང་གཙུག་ལག་རིག་པའི་བང་མཛོད་སྔར་ལས་གྱ་ནོམ་པར་ཁ་སྐོང་རང་བཞིན་ལྡན་པའི་ཞབས་འདེགས་གང་ལེགས་སྒྲུབ་ཐུབ་པ་དང་།",
    "དེ་དག་ཐམས་ཅད་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པའི་སྟོང་པ་ཡིན་པའི་ཆ་ནས་རྟག་པའི་མཐའ་ལས་གྲོལ་བ་ཡིན་པར་འདོད་པ་སྟེ།",
    "ཡང་ན་ཕན་ཚུན་ལྟོས་འཇོག་སོགས་ལ་མ་བརྟེན་པར་ཡུལ་གྱི་ངོས་ནས་ཁོ་རང་ཚུར་རང་བཞིན་གྱིས་ཚུགས་ཐུབ་ཏུ་མ་གྲུབ་པའི་ཡོན་ཏན་དང་།",
    "མེད་པ་དང་རང་བཞིན་གྱིས་མེད་པ།",
    "དར་སྤེལ་སོགས་ལ་ངེས་པར་མཁོ་བའི་བགོ་སྐལ་བཟང་པོར་སྨིན་འདུག་ཅེས་ཡི་རང་དང་བསྔགས་བརྗོད་ཀྱི་མེ་ཏོག་མང་དུ་གཏོར།",
    "ལས་འབྲས་ལ་བརྩི་ཞིང་རང་རིགས་ལ་དུང་སེམས་མངའ་བར་མ་ཟད།",
    "དེ་ལ་བསླུ་བ་མེད་པའི་བདེན་དོན་སྐྱོབ་བྱེད་དུ་གྱུར་པའི་རྣམ་དཀར་གྱི་ཡོན་ཏན་ནི་གཡུང་དྲུང་བོན་གྱི་མཚན་ཉིད་དུ་བཞག་འདུག་པ་དང་།",
    "སྤྱི་ལོ་༩༦༡ལོར་ཨ་ཙ་ར་མི་གཉིས་ཀྱིས་བསམ་ཡས་ཅ་ཏི་དམར་པོ་ནས་གཏེར་དུ་རྙེད་འདུག་ལ།",
    "འཛམ་གླིང་རང་བཞིན་གྱི་རིག་དངོས་ངོ་མཚར་བ་ཞིག་ཀྱང་ཡིན་པས།",
    "ལྟ་ཚུལ་གཉིས་སུ་གླེང་འདུག་པས།",
    "ཀུན་ཀྱང་བོད་བརྒྱུད་ནང་བསྟན་གྱི་གྲས་སུ་བཞག་ན་ཕན་ཐོགས་ཆེན་པོ་འདུག་ཅེས་མཛུབ་སྟོན་གལ་ཆེན་གནང་བ་ལྟར།",
    "བྱུང་བས་ཡིན་ལུགས་མཁན་སློབ་གོང་མའི་ཞལ་རྒྱུན་གཙང་མར་འདུག་ཅིང་།",
    "གསལ་བོར་དྲན་གྱིན་འདུག་ལས་སྨོན་བཟང་པོའི་རྨུ་ཐག་དེ་ལ་རྗེས་སོར་དམ་དུ་འཇུས་པའི་སྐལ་བ་བཟང་པོའི་འོག་ཏུ།",
    "དེ་ནི་སྐྱེ་གནས་བཞི་གང་རུང་ཞིག་ལ་མ་བརྟེན་པའི་སྐྱེ་བ་ལེན་ཐབས་གཞན་གང་ཡང་མེད་པ་ལྟར་ཆགས་པའི་གནས་ལུགས་དང་གཅིག་མཚུངས་སུ་འདུག་ཅིང་།",
    "སྨད་འོག་གོས་མདངས་དམར་སེར་ཞིག་སྐུ་སྨད་ལ་གསོལ་འདུག་ཀྱང་།",
    "ཉེ་བའི་ལོ་ཤས་ནང་ང་རང་པེ་ཅིན་དང་བླ་བྲང་སོགས་ལ་ཐེངས་ཁ་ཤས་སུ་ཕེབས་སྐབས་ཀྱང་།",
    "ད་རུང་ཁོ་བོའི་ལུས་ཀྱིས་ལྕོགས་ཀྱིན་འདུག་པས།",
    "དར་རྒྱས་ནས་ཕུལ་བ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "གཤམ་གསལ་ལྟར་བསྟན་འདུག་པ་སྟེ།",
    "ཞེས་གསུངས་པ་ལྟར་ངོས་འཛིན་གནང་དགོས་པ་ཞིག་ཏུ་ཆགས་ཡོད་འདུག་ཅིང་།",
    "ང་རང་ཡང་རྩེ་ཞིག་བླ་རབས་རིམ་བྱོན་གྱི་གྲས་ཡིན་ཞེས་ཡང་དང་ཡང་དུ་གསུངས་པ་དང་།",
    "འཆད་རྩོད་རྩོམ་པའི་མཛད་བཟང་གསེར་གྱི་འཁོར་ལོ་རྒྱལ་བསྟན་གླིང་བཞིའི་དཔལ་ལ་ཐོགས་མེད་དུ་བསྒྱུར་ཙ་ན།",
    "འོ་སྐོལ་སྐྱེ་བོ་མཐོ་དམན་བར་གསུམ་སུ་ཞིག་ཡིན་ཡང་རང་ཉིད་བོན་གྱི་དྲེད་པོར་མི་འགྲོ་བའིཐབས་ལམ་གལ་ཆེན་ཞིག་ཏུ་ཁ་ཚོན་བཅད་དེ་བརྗོད་ཆོག་པ་ལྟར་ཡོད་དོ།",
    "ཕལ་ཆེར་དཔེ་མི་སྲིད་པ་ལྟ་བུར་ཆགས་ཡོད་ཅིང་།",
    "ལེའུ་ཚན་ཆད་འདུག་པ་རྣམས་དཀར་ཆག་ནང་འགོད་དགོས་མིན་དང་།",
    "དཔྱད་རྩོམ་ཕྱོགས་བསྒྲིགས་བཅས་དེབ་ལྔ་ལྷག་ཡོད་འདུག་ཅིང་།",
    "རྩོམ་སྒྲིག་མི་སྣ་བཅས་ནས་རང་རང་སྐུ་སྒེར་གྱི་ཕྱག་ལས་ལ་ཐུགས་བྲེལ་ཅི་འདྲ་ཆེ་ཡང་།",
    "ཆད་པའི་སྐོར་རིགས་སྐབས་ཐོབ་ལྟར་གཞུང་རང་ངོས་ལ་མཐུད་པ་སོགས་ཀྱི་ལས་འགན་ལེགས་འགྲུབ་ཡོང་ཕྱིར།",
    "སྒང་རང་ས་ནས་དར་ཁྱབ་བྱུང་བ་དང་།",
