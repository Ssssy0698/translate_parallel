    "སྟོབས་ཤུགས་ཀྱི་ལྗིད་ཚད་དཔེ་མི་སྲིད་པའི་བཟང་ཕྱོགས་སུ་གནས་ཡོད།",
    "དོན་དངོས་ཐོགརང་སྲུང་རང་ལུགས་ཀྱི་གནོན་ཤུགས་དེ་ཐོག་མར་ཨ་རིའི་ཕྱོགས་ནས་སླེབས་སྲིད།",
    "གནས་བབས་ཀྱི་ཁེ་ཕན་ལ་ཐུག་དུས་འགྲན་རྩོད་བྱེད་མཁན་སུས་ཀྱང་གྲུབ་འབྲས་ལ་ངོས་འཛིན་བྱེད་རྒྱུ་ཧ་ཅང་དཀའ།",
    "གལ་སྲིད་ཉི་ཧོང་རང་ཉིད་སྟོབས་ལྡན་རྒྱལ་ཁབ་ཅིག་ཏུ་མ་གྱུར་པའི་སྔོན་དུ་ཨ་རིའི་ཐབས་ཇུས་ཀྱི་ཚོང་ཤག་བྱེད་མཚམས་བཞག་པ་ཡིན་ན།",
    "གསལ་ཤོས་ཤིག་ནི་ཉི་ཧོང་རང་ཉིད་སྟོབས་ཆེན་རྒྱལ་ཁབ་ཀྱི་གནས་བབས་དང་།",
    "རྒྱ་ནག་ཕྱོགས་ནས་ཀྱང་རང་ཉིད་གཅིག་པོ་ཨེ་ཤེ་ཡའི་འགོ་གཙོ་ཡིན་པ་གསལ་སྟོན་བྱེད་ངེས་ཡིན་པ་ནི་ཧང་སངས་དགོས་པ་ཞིག་མིན།",
    "ས་མཚམས་སམ་ཚད་ཐིག་དེ་གང་ཡིན་མིན་ནས་ཁོ་ཚོ་ས་མཚམས་སམ་ཚད་ཐིག་དེར་ག་དུས་སླེབས་ཡོད་མེད།",
    "འདི་ལ་དྲི་བ་གཉིས་འདུག་དང་པོ།",
    "ཨ་རི་ནི་སྒྱུ་འཕྲུལ་དང་རང་ཉིད་ལ་མགོ་སྐོར་བཏང་བའི་རྨང་གཞིའི་ཐོག་བཙུགས་པ་ཞིག་མིན།",
    "དེ་ལྟར་ཁོང་གཉིས་བཟའ་ཚང་དུ་འགྱུར་འདུགདུས་དེར་གཉེན་སྟོན་ཞེས་པ་ཤོད་ཐབས་བྲལ་ཞིང་།",
    "མི་ཁ་ཤས་ཀྱིས་ང་ལ་སྔོན་མའི་གནས་ཚུལ་དེ་ཚོ་གསལ་པོ་དེ་འདྲ་ཇི་ལྟར་ངེས་སམ་ཞེས་འདྲི་ཡི་འདུག་དེ་ནི་དཀའ་སྡུག་ཆེ་དྲགས་པ་དང་རྡབ་གསིགས་ཕོག་དྲགས་པ།",
    "དེ་དུས་ང་རང་ལོ་ན་ཆུང་བས་དྲི་ངན་ལ་ཚོར་སྣང་དེ་ཙམ་མེད་པར་དགོད་བྲོ་སྣང་དུ་བརྩི།",
    "པ་ཕས་ཡིག་ངོ་མི་ཆོད་ཀྱང་རང་སྡོད་སར་མི་དང་།",
    "ངས་ཞིམ་པོ་འདུག་ཞིམ་འདུག་ཅེས་ཤོད་བཞིན་དུ་ཏན་ཤིང་ལྷག་མ་ཁ་ནང་དུ་བླུགས།",
    "ཏན་ཤིང་དང་ཤིང་ཏོག་དེ་ཚོའི་མངར་བསིལ་ལྡན་པའི་བྲོ་བ་དེ་དག་ད་ལྟའང་བརྗེད་མི་འདུགའདས་མཇུག་བྱེད་སྒོ་སྒྲུབ་ཟིན་རྗེས།",
    "སྐབས་དེར་པ་ཕ་ཁོང་ཁྲོ་ཆེན་པོ་ལངས་འདུག་ཅིང་།",
    "ཡིན་ནའང་ངའི་བསམ་པར་མ་གཞི་ཁོའི་ངོ་གདོང་ལ་བལྟས་ན་འཇིགས་སུ་རུང་བ་ཞིག་འདུག་ཀྱང་ལྟོ་སློང་མཁན་འདྲ་འདྲ་ཡིན་སྟབས་ང་གཉིས་ལ་གནོད་པ་བྱེད་མི་སྲིད་སྙམ།",
    "དེ་དག་ཕུད་ཁྲང་ཞི་འཁྲབ་སའི་མདུན་ངོས་སུ་ཤིང་ཏོག་དང་བག་ལེབ་ཏན་ཤེལ་སོགས་ཟས་རིགས་སྣ་ཚོགས་འཚོང་མཁན་འདུག་ལ།",
    "ངས་སྐད་ཤུགས་ཆེན་པོས་མི་གསོད་ཀྱི་འདུག་མི་གསོད་ཀྱི་འདུག་ཅེས་སྐད་བརྒྱབ།",
    "ང་རང་གཟུགས་པོ་ཆུང་རྐྱེན་མ་མཐོང་བར་མདུན་གྱི་ཕྲེད་གདུང་ཞིག་ལ་པ་ཕའི་དབུ་རྡབ་འདུག་ང་ཞེད་ཐག་ཆོད་ནས་པ་ཕར་བལྟ་སྐབས་པ་ཕས་ཕྱག་གཅིག་དཔྲལ་བར་བརྒྱབ་པ་དང་།",
    "ང་དགའ་ཐག་ཆོད་དེ་རྒྱུགས་ཕྱིན་ནས་བལྟ་སྐབས་ཁྱི་ཕོར་ནང་དུ་ད་དུང་ཁྱི་ལྟོ་ལྷག་མ་ཕྲན་བུ་ཡོད་པ་དེའི་སྟེང་དུ་གྲོག་མས་ཁེངས་འདུག་ལྟོགས་པའི་མི་ལ་ཐམས་ཅད་ཟས་ཞེས་པ་ལྟར་ངས་འགྲམ་དུ་བཅར་ནས་ཁྱི་དེ་གར་མེད་པ་ཤེས་རྗེས་ཁྱི་ལྟོ་དེ་མྱུར་དུ་ཁ་ནང་བཅུག་པ་དང་།",
    "མིག་གཉིས་ནས་མཆི་མ་གཏོང་བཞིན་འདུགཉེ་འགྲམ་གྱི་མི་ཚོས་ལྕེ་ལ་སོ་འདེབས་སུ་མ་འཇུག་མགྱོགས་པོ་རས་ཤིག་ཁའི་ནང་དུ་ཆུགས་གཟབ་གཟབ་གྱིས།",
    "ཞལ་གདངས་ཙམ་གནང་ན་ཡོང་བ་འདུག་གམ་ཞེས་སྐད་བརྒྱབ།",
    "དེ་དག་དུས་ངེས་མེད་དུ་འབར་ལ་ཉེ་བའི་འབར་རྫས་ཤིག་དང་འདྲ།",
    "ངས་ལྟོ་ཆས་ཕྲན་བུ་སྟེར་ཐབས་ཀྱིས་ཞིབ་ཞིབ་བཟོས་པའི་ལྟོ་ཆས་ཁ་ལ་བླུག་ཀྱང་གཏན་ནས་མིད་ཀྱི་མི་འདུག་པ་ཕས་རས་ལྷེབ་ཙམ་ཞིག་ང་ལ་སྤྲད་ནས་ཆུ་ལ་སྦངས་ཏེ་དཔྲལ་བར་སྦྱར་དགོས་ཟེར།",
    "འདིའི་ནང་བྱ་བྲུན་འདུག་ངས་གསར་པ་ཞིག་བརྗེས་ཆོག་ཟེར།",
    "ང་རང་གཉིད་སྐྱིད་པོ་ཞིག་གཏན་ནས་མ་ཁུག་མ་གཞི་པ་ཕ་ངའི་གཡོན་དུ་གཟིམས་ཡོད་པ་དང་།",
    "ངས་བསམ་བློ་ཇི་ལྟར་བཏང་ཡང་རང་ཉིད་མཚན་དགུང་གཉིད་ལས་དྭངས་པ་མི་དྲན་ལ།",
    "ངའི་མཇིང་པར་གང་བྱས་འདུག་གམ་ཞེས་འདྲིས་པས།",
    "གོས་ཐུང་ནང་བཙོག་པ་ཤོར་བ་འདུག་ཅེས་གསུངས།",
    "ཁྱེད་རང་འདིར་ཆབ་ཆེན་གནང་དང་ཞེས་བཤད།",
    "སྐབས་དེར་ང་རང་ཞེད་ཐག་ཆོད་ནས་གོས་ཐུང་ནང་གཅིན་པའང་ཤོར།",
    "ཁྱེད་རང་མགྱོགས་པོ་རྒྱུགས་ཟེར།",
    "སྐབས་དེར་ཅང་ཚང་ཕ་བུ་གཉིས་པོས་གང་སར་དམ་བསྒྲགས་བྱེད་པའི་དུས་རིམ་ཡིན་འདུག་ཅིང་།",
    "སྟབས་ལེགས་ནས་ང་ནི་གཤེ་གཤེ་གཟེད་རྒྱུ་གོམས་གཤིས་སུ་འགྱུར་འདུག་པས་མགྱོགས་མྱུར་སྲང་ལམ་གུ་དོག་པ་ཞིག་ནང་རྒྱུག་ཕྱིན།",
    "ཚུར་ལོག་ཡོང་སྐབས་བྱ་ཤ་དེ་དུང་ཕྲུག་ནང་བླུགས་ནས་བཙོ་བཞིན་འདུག་ཅིང་།",
    "ངས་གཡོན་ཕྱོགས་ནས་འགྲོ་སྐབས་ཁོས་གཡོན་ཕྱོགས་ནས་བཀགངས་པ་ཕ་འཐེན་ཙམ་གྱིས་སྤྲང་པོ་བའི་ལོག་སྐད་ཐོག་ནས་བརྙས་བསྐོ་མཁན་འདུག་ཅེས་བརྡ་བསྟན་པས་པ་ཕས་འཁར་བ་དང་རྡོག་ཁྲེས་རྣམས་ཕྱག་ནང་དམ་པོར་བཟུང་བ་དང་།",
    "ལམ་བུར་བལྟ་ཐུབ་ཀྱི་མི་འདུག་གམ།",
    "ཁྲག་དམར་འགོས་པའི་གྱོན་གོས་དེ་དག་ཐེངས་དང་པོ་མཐོང་སྐབས་མགོ་ཡུར་འཁོར་ལ་གཏིང་ནས་ཞེ་མེར་ལངས་ཀྱི་འདུག་གང་ལགས་ཤེ་ན།",
    "ད་དུང་ཡིད་ཆེས་མ་བྱས་སྟབས་ངས་མཆི་མ་ཐོན་བཞིན་དུ་ཟོལ་མེད་ངང་རང་ཁྱིམ་གྱི་གནས་ཚུལ་ཇི་མ་ཇི་བཞིན་བཤད།",
    "ང་ནི་ག་དུས་འདིར་སླེབས་ཐུབ་བམ།",
    "ལྟོགས་ནས་ཤི་གྲབས་བྱེད་ཀྱི་འདུག་ཧ་ཧ་ཧ།",
    "ངའི་པ་ཕ་ལོང་བ་ཡིན་པ་དང་ཨམ་ནི་སྨྱོན་མ་ཡིན་པས་ཁོང་གཉིས་ཡོང་ཐུབ་ཀྱི་མི་འདུག་ཅེས་ལན་བཏབ།",
    "ཁྱེད་རང་སེམས་ཁྲལ་མ་བྱེད་ཨང་ཞེས་བརྗོད།",
    "ངས་ཁྱེད་རང་ལ་བསླབ་ཆོག་ཟེར།",
    "གྲོད་ཁོག་ན་ཡི་འདུག་གམ།",
    "ཁྱེད་རང་ཚུར་ལོག་ཤོག་དང་།",
    "དེ་སྔ་ཤོག་དངུལ་ལྷག་པས་འཁྱེར་བའི་གནས་ཚུལ་ཐེངས་ཁ་ཤས་ཐོན་མྱོང་ཡོད་ཀྱང་ང་རང་རྒྱུགས་ཤར་མགྱོགས་པས་སྒྲུག་ཐུབ་ཙམ་བྱུང་།",
    "མ་མཐར་ཡང་གཉིད་སྐྱིད་པོ་ཞིག་ཉལ་རྒྱུ་འདུག་སྙམ།",
    "ལོ་ན་ཆུང་ལ་ཧ་ཅང་མཛེས་པོ་འདུག་ཧ་ཧ།",
    "ཕག་ཚང་རྙིང་པ་དེའི་ནང་སྤོ་རྒྱུ་བྱུང་བས་ང་རང་ཉིན་ཤས་རིང་ཧ་ཅང་སྐྱིད་པོ་བྱུང་།",
    "ང་རང་ཉ་ཟ་བར་དགའ་པོ་མེད་བཞིན་དུ་ཡང་ང་ལ་ཉ་ཤ་བླུག་འདུག་ཟེར་བ་དང་།",
    "ང་རང་དགའ་ཐག་ཆོད་ནས་འཕྲལ་མར་གསང་གཅོད་ནང་འཛུལ་ཏེ་ནང་ལོགས་ནས་སྒོ་ལྕགས་བརྒྱབ་ཐོག་ཕྱི་ལོགས་ཀྱི་གནས་ཚུལ་ལ་སྣ་ཅོག་ཉན་བཞིན་བསྡད།",
    "སྐབས་དེར་ང་གཉིས་ནི་གཞུང་ལམ་གྱི་དཀྱིལ་ངོས་སུ་སླེབས་འདུག་པས་བསམ་བློ་གཏོང་བཞིན་སྐྲག་སྣང་སྐྱེས།",
    "རྒྱུགས་ཤུགས་ཡང་ཤིན་ཏུ་ཆེན་པོ་འདུག་པས་ཆུ་ཡིས་ང་གཉིས་སོ་སོར་ཁ་ཕྲལ།",
    "ངའི་མཐེ་བོང་ཆད་པ་འདུག་རྗེས་སུ་ངས་གཉིད་ཉལ་གྱི་མིན།",
    "འབྲས་བཙོ་བའི་རླངས་པོའི་སྒྲ་ཚེར་ཚེར་ཞེས་གྲགས་པ་དེ་ནི་ང་ལ་དུས་ཚོད་སླེབས་ཀྱི་འདུག་ཅེས་བརྡ་གཏོང་བ་དང་མཚུངས།",
    "མ་གཞི་པ་ཕས་ང་འབོད་ཀྱི་འདུག་ཀྱང་ངས་ཐག་རིང་སར་རྒྱུགས་ཤིང་།",
    "མེ་ཁ་གསོ་ཐུབ་ཙམ་བྱུང་ནས་འབྲས་བཙོ་བའི་གྲ་སྒྲིག་བྱེད་སྐབས་ངའི་གདོང་པར་མེ་ཐུལ་ཐོར་སྟབས་སྐབས་དེར་གཅུང་པོ་ཚོས་ངའི་མཐའ་ནས་བསྐོར་བཞིན་དུ་གཅེན་པོ་མི་རིགས་ནག་པོར་འགྱུར་འདུག་ཟེར།",
    "ཕལ་ཆེར་ང་རང་ལོ་བཅུ་གཉིས་ཙམ་ལ་སླེབས་པའི་སྐབས་ཀྱི་ཉིན་ཞིག་པ་ཕས་ང་ཡུར་འགྲམ་དུ་ཁྲིད་དགོས་གསུངས།",
    "སྦལ་པ་དེ་དག་ཚལ་བཟོས་ཚེ་བྲོ་བ་ཤིན་ཏུ་ཞིམ་པོ་འདུགགལ་ཏེ་མཚན་གང་སྒུག་མ་ལྕོགས་ན་ད་དུང་ཐབས་ཤེས་གཞན་ཞིག་ཡོད་པ་སྟེ།",
    "རྒན་ལགས་ཀྱིས་ངའི་ཁྱིམ་གྱི་གནས་ཚུལ་ཤེས་རྗེས་ངལ་གསོའི་དུས་ཚོད་ནང་ང་རང་ངང་ཚང་ལ་གད་འཕྱིས་དང་།",
    "ངང་པའི་སྒོ་ང་མང་པོར་ངང་པས་རྡོག་བརྫིས་བཏང་ནས་ཆག་འདུག་ངས་འཕྲལ་དུ་ཨ་ཚའེ་རྗེས་འདེད་བཏང་ནས་བཀག་འགོག་བྱ་དགོས་བསམ་ཡང་།",
    "སློབ་སྦྱོང་ཨང་དང་པོ་བླངས་འདུག་ཅེས་བསྔགས་བརྗོད་ཀྱི་ཟེགས་མ་གཏོར།",
    "དེ་ཉིན་ངངས་གཟེངས་བསྟོད་ལག་ཁྱེར་དང་དངོས་པོ་རྣམས་འཁྱེར་ནས་བྲེལ་འཚུབ་ངང་ཁྱིམ་དུ་ལོག་སྐབས་པ་ཕ་སྐུ་རྐྱང་དུ་གཟིམ་ཁྲིའི་ཟུར་དུ་བཞུགས་འདུག་ངས་དགའ་སྤྲོའི་ངང་མདུན་དུ་ཕྱིན་ནས་པཱ་ལགས།",
    "རྗེས་སུ་རྒན་ལགས་ཀྱིས་ཇི་ལྟར་མཁྱེན་པ་མ་ཤེས་པར་ཉིན་ཞིག་ང་རང་དོན་གཅོད་ཁང་ནང་དུ་བོས།",
    "རྒན་ལགས་ཀྱིས་ཀྱང་དེ་ལྟར་དགོངས་ཀྱི་འདུག་པས་ངས་འཕྲལ་དུ་ཁས་བླངས།",
    "མི་གཞན་གྱིས་ང་རང་སྐྱེལ་བར་བཏང་བྱུང་ཟེར།",
    "ཕར་ཙམ་ནས་ད་དུང་སླར་ཡང་ལྐུགས་པ་ཞེས་འབོད།",
    "ཡི་གེ་དེ་ནི་ཡིག་སྐོགས་སྔོ་བསངས་ཤིག་ནང་བླུགས་འདུག་ཅིང་།",
    "མེ་སྤར་བ་དང་འབྲས་བཙོ་འགོ་ཚུགས་རྗེས་ང་རང་ཐབ་ཀྱི་མདུན་དུ་བསམ་བློའི་རྒྱ་རུ་ཚུད།",
    "དེ་སྔ་ལྟར་ལུས་རྩལ་ཐང་དུ་ང་སྒུག་ནས་སྡོད་ཀྱི་མི་འདུག་ལ།",
    "སྣང་དག་མི་འདུག་ང་ལ་རྨས་སྐྱོན་བྱུང་མེད་ཅེས་བཤད།",
    "ཆར་པ་བབ་གྲབས་འདུག་ཚང་ཨ་ཁྱིམ་དུ་ལོག་ནས་ངལ་གསོས་ཤིག་ཞོགས་ལྟཪ་ཆུ་ཚོད་ཕྱེད་ཀ་སྔ་བསུས་ནས་སླེབས་པ་བྱེད་དགོས་ཞེས་གསུངས།",
    "ང་རང་པང་པར་བཏབ་བྱུང་།",
    "ཡིན་ནའང་ར་བཟི་བ་དེ་གཉིས་ཀྱིས་གཏན་ནས་མ་ཉན་པར་ང་རང་བཟུང་བར་ཡོང་བས་ངས་གང་སར་བྲོས་ནས་ཕྱིན།",
    "ཉིན་ཁ་ཤས་རིང་ང་རང་བློ་བཟོད་བདེ་པོ་གཏན་ནས་མེད་པར་འགྱུར་ཞིང་།",
    "རྫས་འགྱུར་གྱི་རྩི་དེ་ཚོའི་དྲི་མ་ནི་དེ་བས་བཟོད་ཐབས་བྲལ་བ་ཞིག་འདུག་ངས་ཁ་རས་ཉིས་རྩེགས་བརྒྱབ་ཀྱང་ད་དུང་མགོ་ཡུར་འཁོར་ཡོང་བ་དང་།",
    "ཁྱིམ་དུ་སླེབས་དུས་ད་དུང་དྲི་ཚོར་ཉམས་ནས་སྡོད་ཀྱི་འདུག་ལོ་གསུམ་པ་དེར་ངས་ཀྲུང་ཨེ་མེ་འགོག་ཀུང་སིའི་ནང་ལས་ཀར་ཕྱིན།",
    "དེ་དུས་ང་རང་རང་ལོ་ཉེར་ལྔར་སླེབས་ཤིང་།",
    "སྦྱིན་བདག་དེས་ང་རང་ལས་ཀར་ཧུར་ཞིང་ཡར་བརྩོན་བྱེད་མཁན་ཞིག་ཡིན་པ་ཤེས་སྟབས་ཨུ་ཚུགས་ཀྱིས་ང་ལ་དགའ་གྲོགས་ཤིག་ངོ་སྤྲོད་བྱེད་ཀྱི་ཡིན་ཟེར།",
    "དེ་རིང་རང་ཉིད་ཀྱིས་གྱོན་ཆས་ཀྱང་གྲལ་འགྲིག་པོ་གྱོན་ཡོད་སྟབས་བློ་ཁོག་དང་བཅས་ལི་ཞ་ཁྱིམ་གྱི་སྒོ་ཏིར་མནན།",
    "དོན་དུ་ང་ནི་དངངས་སྐྲག་ཆེན་པོ་སྐྱེས་ཀྱི་འདུག་གང་ལགས་ཤེ་ན།",
    "ཁོའི་དོན་དུ་ནང་མི་མི་འཆམ་པ་བཟོ་རིན་འདུག་གམ་ཟེར་ཡང་།",
    "འབྱུང་འགྱུར་གནས་ཚུལ་གང་ཞིག་བྱུང་ཡང་རང་ཉིད་ལ་བརྟེན་རྒྱུ་ལས་མེད་ཅེས་གསུངས་པ་དང་སྦྲགས་ཐབ་ཚང་ནང་དུ་ཕྱག་ལས་ལ་ཕེབས།",
