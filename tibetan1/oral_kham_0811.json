    "དེ་དུས་དབུས་གཙང་ན་ཆར་པ་ཤིན་ཏུ་དཀོན་པ་འདུག་པ་ལ།",
    "སྐབས་ཤིག་ནཱ་ལེནྡྲར་དེ་རིང་ཡུ་བུས་ཆར་འབེབས་བྱེད་དགོས་པ་འདུག་པས་རྟིང་ཀྲོལ་མའི་གསེར་སྐུ་དེ་ཁྱེར་ཤོག་གསུངས་ནས་ཁྲུས་གསོལ་མཛད་པས།",
    "གསེར་གྱི་གླེགས་བམ་ལ་བཀྲ་ཤིས་རབ་གནས་མཛད་པའི་མཚན་ལྟས་བྱུང་འདུག།",
    "རྗེ་ཡང་ཤར་ཕྱོགས་ལ་ཕེབས་རྒྱུར་གདའ་བས།",
    "འདི་གཉིས་ལ་ཐུགས་དམ་འདོགས་བྱེད་དགོས་པ་གདའ་ལགས་ཞུས་པ་ལ།",
    "ཁར་སང་གསུངས་པ་དེ་སེམས་གསོ་ཡིན་པར་འདུག།",
    "རྗེ་ཉིད་ཀྱི་ཞལ་སྔ་ནས་ཁྱེད་ལྟ་བུའི་གང་ཟག་བསྙེན་པར་རྫོགས་པ་ལ་ལྟོས་པའི་གང་ཟག་ཏུ་མི་འདུག་སྟེ།",
    "འོ་ན་གཏུགས་ས་མ་ནོར་འདུག་གསུངས་པ་སོགས་བསྔགས་པ་ཤིན་ཏུ་ཆེ་བར་མཛད་དོ།",
    "ངེད་ཁམས་བཟང་པོ་མི་འདུག་པས་ཐེ་ཚོམ་མ་བྱེད་པར་མྱུར་དུ་ཤོག་གསུངས་པའི་བཀའ་ཕེབས།",
    "ངེད་རང་ལ་ཐུགས་དམ་སྲུང་འཁོར་གྱི་ཁོངས་སུ་འཇུག་པ་དགོས་གསུངས་པ་འདུག་ནའང་།",
    "དེ་ལ་སྒྲུབ་དགོས་པ་འདུག་གསུངས་པའི་བཀའ་ལུང་ཕེབས་པར་འདུག།",
    "རྗེའི་ཞལ་ནས་ལྷ་རྣམས་དགེས་ཟེར་བའི་བརྡར་འདུག།",
    "ང་རང་ཡང་འདི་ལྟ་བུ་ཅིག་བཞེངས་དགོས་པར་འདུག་གསུངས་ནས།",
    "བཟང་སྤྱོད་ཁ་དོན་བྱས་ནས་ཚེ་གཞུག་འདི་རྣམས་ལ་སྐྱབས་གནས་ཞུ་དགོས་པ་འདུག་ཅེས་གསུངས།",
    "ཁྱེད་རང་ར་འབྱམས་པ་ཐུགས་རྗེ་དཔལ་གཉིས་ཞག་འགའ་ཡར་གྱི་བར་ལ།",
    "དྲུང་དུ་འབྱོན་པས་ཁམས་བདེ་རྒྱུ་རང་ཅིག་མི་འདུག།",
    "ཐུགས་དམ་ལ་རྩེ་གཅིག་ཏུ་བཞུགས་འདུག་པ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་དང་།",
    "ནོར་མཛོད་དེ་གཉེར་ཁ་འོང་ངེས་པར་འདུག་གསུངས།",
    "བིར་སྲུང་རྣལ་འབྱོར་མ་རྣམས་གནང་སྐབས་ཀ་བཅུ་མ་ན་ཡབ་སྲས་ལྷན་ཅིག་བཞུགས་འདུག་པ་ལ།",
    "དེ་རྒྱུན་ལྡན་གྱི་ཕྱག་དྲུག་པའི་གཏོར་བསྔོ་དེ་ཁའུར་བྱས་པའི་རྩུབ་འགྱུར་དུ་འདུག་པས།",
    "རྗེ་ཡོངས་འཛིན་ལ་མཇལ་ཙམ་ཀ་གནང་ནས་ཕེབས་ཚོད་དུ་འདུག་ཀྱང་།",
    "གཞན་ལ་རྩད་བཅད་པས་ཀྱང་འདི་བཞིན་རང་འདུག་ཟེར།",
    "འདི་ལྟར་འདུག་ལགས་ཞུས་པས།",
    "གཞན་རྗེའི་གསན་ཡིག་ནང་ལྟར་ལ་ཞུས་དག་གནང་བས་སྔར་གསན་པའི་ཚེ་རྟ་སྦྲགས་མ་ཟེར་བ་ཅིག་འདུག་པ།",
    "བསྲེག་སྦྱངས་གྱིས་ཀྱི་བརྡར་འདུག་དགོང་ནས་སྐུ་མཚམས་གྲོལ་ཉིན་དབོན་ཆེན་རིན་ཆེན་སེང་གེ་ལ།",
    "འོ་འདི་འདྲ་གཞན་དོན་ཡིན་ཡང་ཐུགས་རྟོག་རྩིང་འདུག།",
    "ད་འདི་ལྟར་གྱུར་འདུག་པ་ཐབས་གཞན་ནི་མི་འདུག།",
    "གུ་གེ་པཎྜི་ཏ་མངའ་བར་འདུག་པ་ནས།",
    "དུས་མཆོད་ཅིག་ཀྱང་མི་འདུག།",
    "ང་རང་ཡང་སྐུ་དྲུང་ན་འདུག་གསུངས།",
    "ད་རང་ཁམས་བདེར་འགྲོ་བ་འདུག།",
    "ཞལ་འཛུམ་མེ་བཞུགས་པའི་ཆག་ཕྱིར་ང་རང་ཡང་འདུག་གསུངས།",
    "དེའང་བླ་ཆེན་སྒུག་སྡོད་མཛད་པར་འདུག།",
    "གཞན་གྱི་བྱད་ཁ་ཆོད་གཏོང་རང་ཞིར་འགྱུར་བ་ཞིག་སྟེ།",
    "གཟིམས་ཆུང་རང་ན་བཞུགས་འདུག།",
    "སྐུ་མདངས་ཀྱང་ཆེར་འདུག་སྐུ་བསྙེལ་བ་མེད་ལགས་སམ་ཞུས་པས་མེད་གསུང་།",
    "ས་ལོ་འཇམ་པའི་དབྱངས་ཆེན་པོ་མནལ་ལམ་དུ་འབྱོན་གྱིན་ཡོད་འདུག་པ་བྱུང་ལགས་སམ་ཞུས་པས།",
    "ནམ་ཟེར་གྱི་འདུག་གསུངས།",
    "ད་ལན་དཀར་ཕྱོགས་དང་ནག་ཕྱོགས་གཉིས་སུ་ཐོབ་ཞིག་འདུག་སྟེ།",
    "མཆོད་གཡོག་པས་ཐུགས་དམ་གཏོར་འབུལ་མཛད་ལགས་སམ་ཞུས་པས་ད་ལྟ་ཁམས་དྭངས་པ་རང་མི་འདུག།",
    "ཉི་མ་གང་ཙམ་འདུག་གསུངས།",
    "ཉི་མ་བཞུད་འདུག་ཞུ་མ་ནུས་པར།",
    "ཉི་མ་ཅུང་ཟད་ཅིག་འདུག་ཞུས་པས།",
    "དེ་བཞིན་ཡིན་པ་འདུག་གསུངས་པ་རྨི།"
