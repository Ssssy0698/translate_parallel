    "བསམ་གཏན་གྱི་བྱེ་བྲག་རྣམ་པ་སྣ་ཚོགས་གཉིས་བསྒོམས་པའི་སྟོབས་ཀྱིས་ཉོན་མོངས་པ་ཤིན་ཏུ་སྦྱངས་དཀའ་བ་ལས་རྣམ་པར་རྒྱལ་བས་ས་ལྔ་པ་ལ་ཤིན་ཏུ་སྦྱངས་དཀའ་ཞེས་བརྗོད་དོ།",
    "ཁྱོད་ནི་ཀུན་ཏུ་བསམ་གྱིས་མི་ཁྱབ་པས།",
    "གང་གིས་ཀྱང་ཁྱེད་ཤེས་པར་མི་ནུས་པའི་ཕྱིར་ཏེ།",
    "ངག་གི་སྤྱོད་ཡུལ་ཀུན་ལས་འདས་པའི་ཕྱིར་ཏེ།",
    "རྨོངས་པ་དམན་པའི་འཇིག་རྟེན་པ་རྣམས་ལ་སྡུག་བསྔལ་གྱིས་འཇིགས་ཤིང་ཉེན་པ་རྣམས་ལ་ལྷའི་སྤྱན་གྱིས་གཟིགས་པར་གྱུར་ནས།",
    "ཤེས་བྱའི་བུད་ཤིང་སྐམ་པོ་མ་ལུས་པ།",
    "གངས་རིའི་ཁྲོད་འདིར་མཁས་རློམ་བརྒྱ་ཕྲག་གིས།",
    "ངོ་བོ་ཉིད་མེད་སྨྲ་བའི་བཞེད་གཞུང་གི།",
    "གཞན་གྱིས་བཏགས་པའི་གང་ཟག་གིས་སྟོང་པའི་ཕྱིར་ཆད་པ་དང་རྟག་པ་གཉིས་ཀ་མ་ཡིན་ནོ།",
    "དངོས་སྨྲ་བ་འདི་དག་གིས་རྡུལ་དང་སྐད་ཅིག་དོན་དམ་པར་ཡོད་པས་ཆད་པ་མིན་ལ།",
    "འདི་དག་གིས་ནི་རྟག་ཆད་ཀྱི་སྐྱོན་སྤང་ཚུལ་བྱེད་པ་ཙམ་དུ་ཟད་མོད།",
    "དེ་ནི་ཆད་པར་ཐལ་བར་འགྱུར།",
    "ཐལ་བར་འགྱུར་ཏེ་དངོས་དེ་ནི།",
    "ལམ་གྱིས་ཀྱང་འདི་ལ་དམིགས་ནས་ཉོན་མོངས་པ་རིམ་གྱིས་སྤང་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཤེས་བྱ་ལས་ཕྱེ་བའི་དབྱེ་བར་མི་འབྱུང་ངོ་ཞེས་སྨྲ་བ་སྣང་མོད་ཀྱི།",
    "ཐལ་འགྱུར་དང་།",
    "ཡུལ་ཡུལ་ཅན་གཉིས་ཀའི་ཐུན་མོང་གི་སྒྲ་དོན་ནི།",
    "བརྡ་ཞེས་པ་ནི་ངག་གི་ཐ་སྙད་ཡིན་ལ།",
    "དེས་ན་དངོས་པོ་ཡིན་མིན་གྱི་ཆ་ནས་ཡང་ལོག་གི་ཐ་སྙད་བྱེད་པ་མིན་ཏེ།",
    "རྟག་འཛིན་སོགས་དངོས་པོར་གྲུབ་པ་ལ་ཡང་ཕྱིན་ཅི་ལོག་གི་ཐ་སྙད་བྱེད་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "འཇིག་རྟེན་ནའང་ཡུལ་ལོག་གི་ཡུལ་ཅན་ནི་མ་ལོག་པའོ་ཞེས་ཐ་སྙད་བྱེད་པ་མེད་ལ།",
    "ལོག་པའི་ཀུན་རྫོབ་ཅེས་པའི་ཚིག་གི་ཟུར་དུ་སྨྲོས་པའི་བདེན་པ་དང་།",
    "འཇིག་རྟེན་པས་བསླུ་བ་དང་མི་བསླུ་བར་མཐོང་བའི་བྱེ་བྲག་ལས་ཡང་ལོག་གི་ཐ་སྙད་བཞག་པ་ཡིན་ལ།",
    "ཀུན་རྫོབ་ཙམ་བདེན་པ་གཉིས་གང་གི་ནང་དུ་འདུ།",
    "རྨ་བྱས་འཕགས་པའི་རྗེས་ཤེས་ཀྱི་ངོར་ཡང་ལོག་གི་དབྱེ་བ་མེད་པའི་ཕྱིར་ཙམ་གྱི་སྒྲ་སྨྲོས་པར་འདོད་དོ།",
    "འགའ་ཞིག་གིས་སོ་སྐྱེའི་བློ་ལ་ལྟོས་ནས་ཀུན་རྫོབ་བདེན་པར་བཞག་པ་ཡིན་གྱི།",
    "བསླུ་བ་ལ་ཀུན་རྫོབ་ཏུ་གྲགས་པའི་རྗེས་སུ་འབྲངས་ནས་འདིར་ཡང་བསླུ་བ་དང་མི་བསླུ་བའི་བྱེ་བྲག་ལས་བདེན་པ་གཉིས་ཀྱི་ཐ་སྙད་མཛད་མོད།",
    "སེངྒེ་བཟང་པོ་གཉིས་བཞེད་མོད།",
    "སློབ་དཔོན་འདིས་ཡང་ལོག་གི་དབྱེ་བ་མཛད་པ་མེད་ཅིང་།",
    "གང་གིས་མཐོང་བར་འགྱུར་ཞེ་ན།",
    "ངག་གིས་ཇི་ལྟར་གནས་པ་བཞིན་བརྗོད་པར་མི་ནུས་པས་ན་འཇམ་དཔལ་གྱིས་ལིཙྪ་བཱི་དྲི་མ་མེད་པར་གྲགས་པ་ལ་དེ་ཁོ་ན་ཉིད་ཀྱི་དོན་དྲིས་པའི་ཚེ།",
    "བཏགས་པའི་རང་གི་ངོ་བོ་ཡི།",
    "ཇི་ལྟར་ངེས་པ་ལྟར་ཡིད་ལ་བྱས་པས་དོན་དུ་གཉེར་བའི་མཐར་ཐུག་གི་ཡོན་ཏན་ཐོབ་པས་བསམ་པའི་དོན་ལ་མི་བསླུ་བས་སོ།",
    "བོད་དག་གིས་རིགས་པ་དང་རིགས་ཤེས་ཁྱད་མ་ཕྱེད་ཅིང་།",
    "དེས་གཏན་ལ་ཕབས་པའི་དོན་ཡང་ཡུལ་ཅན་གྱི་མིང་གིས་བཏགས་ནས་དོན་དམ་ཞེས་བརྗོད་དོ།",
    "གཞན་ནི་ཡུལ་དང་ཐུན་མོང་དུ་འཇུག་པའི་ཕྱིར་རོ།",
    "འགའ་ཞིག་གིས་སློབ་དཔོན་ཟླ་བས་འཇིག་རྟེན་པའི་བློ་ལ་ལྟོས་ནས་གཞན་ངོར་ཞལ་གྱིས་བཞེས་ཀྱི།",
    "གང་ཞིག་གིས་སམ་གང་ཞིག་ལ།",
    "ཡུལ་ཡུལ་ཅན་གཉིས་ཀའི་ཐུན་མོང་གི་སྒྲ་དོན་ནི།",
    "འགའ་ཞིག་གིས་རང་རྒྱུད་པ་ཐམས་ཅད་ཀྱིས་ཀུན་རྫོབ་རིགས་པས་དཔྱད་ནས་འཇོག་ཟེར་བ་ནི་མི་འཐད་དེ།",
    "གཞན་དུ་སོང་བས་གནོད་པར་འགྱུར།",
    "ཇི་ལྟར་སྣང་བའི་ངོ་བོ་ཀུན་རྫོབ་ལ་བརྟེན་ནས་དེ་ལ་ཁྱོད་དཔྱོད་པ་བྱེད་པ་ནི་དོན་གཞན་དུ་འགྲོ་བའི་ཕྱིར་གནོད་པ་འབའ་ཞིག་ཏུ་ཟད་དོ་ཞེས་སོ།",
    "བོད་དག་གིས་རང་རྒྱུད་ཀྱི་གཞུང་ལུགས་མཐའ་དག་མ་མཐོང་བར་འོལ་སྤྱི་ཙམ་བརྗོད་པར་ཟད་དོ།",
    "དོན་དམ་རྟོགས་པས་སྣང་བ་ལ་བདེན་འཛིན་གྱི་སྒྲོ་འདོགས་མི་ཆོད་པར་ཐལ་བ་དང་།",
    "ཀུན་རྫོབ་རིགས་པས་མ་རྙེད་པ་ཉིད་དོན་དམ་མ་ཡིན་པར་ཐལ་བ་དང་།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "རྣམ་པར་བྱང་བ་དུས་གཅིག་ཏུ་ཐལ་བར་འགྱུར་རོ།",
    "ཕྱི་མའི་དོན་ནི་བདེན་གཉིས་སོ་སོ་ཡིན་ན་དོན་དམ་རྟོགས་ཀྱང་ཀུན་རྫོབ་ལ་སྒྲོ་འདོགས་མི་ཆོད་པས་ཀུན་རྫོབ་ལ་དམིགས་ནས་འཕེལ་བར་འགྱུར་བའི་ཀུན་ནས་ཉོན་མོངས་ཀྱི་གཉེན་པོ་མེད་པའི་ཕྱིར།",
    "དོན་དམ་རྟོགས་ཀྱང་ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་བྱང་གཉིས་དུས་ཅིག་ཅར་འཕེལ་བར་འགྱུར་ཞེས་པའི་དོན་ཡིན་ནོ།",
    "ཀུན་རྫོབ་ལ་དམིགས་ནས་ཀུན་ནས་ཉོན་མོངས་འཕེལ་བར་འགྱུར་བ་ལྟར་དོན་དམ་ལ་དམིགས་ནས་ཀུན་ནས་ཉོན་མོངས་འཕེལ་བར་འགྱུར་བ་དང་།",
    "ཀུན་རྫོབ་ལ་དམིགས་པས་ཀུན་ནས་ཉོན་མོངས་པ་འཕེལ་བར་མ་ངེས་པའི་ཕྱིར།",
    "ངོ་བོ་གཅིག་ན་དོན་དམ་ལ་དམིགས་པས་ཀུན་ནས་ཉོན་མོངས་འཕེལ་བར་འགྱུར་ཞེས་པ་ཡང་མི་འཐད་དེ།",
    "གཉིས་ཀ་ལ་ངོ་བོ་ཡོད་ན་ངོ་བོ་གཉིས་སུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཀུན་རྫོབ་ལ་དམིགས་ནས་ཉོན་མོངས་འཕེལ་བར་འགྱུར་བའི་ཕྱིར་སྤྱི་ཙམ་ལ་བསམ་ནས་ཀུན་ནས་ཉོན་མོངས་པའི་དམིགས་པར་བརྗོད་ཀྱི།",
    "དང་པོ་ནི་གཞན་དག་གིས་ཀུན་རྫོབ་ཏུ་འདོད་པ་དཔྱད་གཞིར་བཟུང་ནས་དེ་ལ་དཔྱོད་པའི་རིགས་པ་ཡིན་ལ།",
    "དེ་ནི་རེ་ཞིག་དེ་ཉིད་མིན།",
    "ཐལ་འགྱུར་བའི་ལུགས་གཉིས་འབྱུང་སྟེ།",
    "རི་བོང་གི་རྭ་ལྟར་མེད་པར་མི་སྨྲ་བའི་ཕྱིར་ཏེ།",
    "འདུས་བྱས་ནི་སྐྱེ་འགག་གིས་རབ་ཏུ་ཕྱེ་བའི་ཕྱིར་རོ།",
    "བོད་དག་གིས་འདི་ཙམ་ཡང་མ་རྟོགས་སོ།",
    "རྗེས་དཔག་གི་གཞལ་བྱ་དཔྱད་པའོ།",
    "གཞུང་གིས་བསྐྱེད་པའི་བྱེ་བྲག་གིས།",
    "བུད་མེད་བྱིས་པའི་བར་དག་ལ།",
    "རང་རྒྱུད་པས་ཀྱང་རང་གི་མཚན་ཉིད་ཀྱིས་གྲུབ་པར་འདོད་པས་ན།",
    "རང་གི་མཚན་ཉིད་ཅེས་པ་འཇོག་བྱེད་ལ་འདོད་དམ།",
    "དང་པོ་ལྟར་ན་སློབ་དཔོན་ཟླ་བས་ཀྱང་གཟུགས་ནས་རྣམ་མཁྱེན་གྱི་བར་གྱི་རང་གི་མཚན་ཉིད་གསུངས་པས་རང་རྒྱུད་པར་འགྱུར་ལ།",
    "དེ་ཉིད་སྐབས་སུ་རིགས་པ་གང་ཞིག་གིས།",
    "ཁྱོད་ཀྱི་སྐྱེ་བ་གང་གིས་ཡིན་པར་འགྱུར།",
    "རང་གི་ངོ་བོས་གྲུབ་པར་འདོད་ན་དཔྱད་མི་བཟོད་དུ་འདོད་པ་འགལ་བ་ཡིན་ཏེ།",
    "རང་གི་ངོ་བོས་གྲུབ་ན་རིགས་པས་དཔྱད་ན་རྙེད་རིགས་པ་ལས་མི་རྙེད་པས་རང་གི་ངོ་བོས་མ་གྲུབ་ཅེས་སྨྲ་དགོས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་རང་གི་ངོ་བོས་གྲུབ་པར་འདོད་ཅིང་དཔྱད་མི་བཟོད་དུ་འདོད་ན།",
    "ཐལ་འགྱུར་གྱི་དགག་བྱ་གཉིས་སོ།",
    "གང་གིས་ལྟ་བའི་མེ་མདག་གིས།",
    "བུད་ཤིང་དང་ནི་འཇིག་རྟེན་གྱི།",
    "ཐལ་འགྱུར་གྱིས་ཀུན་བཏགས་ཀྱི་འཛིན་པའི་ཡུལ་གཙོ་བོར་འགོག་གོ།",
    "ཁྱོད་ཀྱི་སྐྱེ་བ་གང་གིས་ཡིན་པར་འགྱུར།",
    "རྣམ་པ་བདུན་གྱིས་བཙལ་ན་འགྲུབ་འགྱུར་མེད་མོད་ཀྱི།",
    "རྗེས་དཔག་གིས་སྒྲུབ་པའི་ཚུལ་ནི།",
    "རི་བོང་གི་རྭ་བཞིན།",
    "ཐོགས་བཅས་མ་ཡིན་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "ལྔ་པ་རྗེས་དཔག་གི་གཞལ་བྱ་དཔྱད་པ་ལ།",
    "དེ་མི་སྣང་བས་དོན་དམ་དུ་ཐལ་བའི་སྐྱོན་ལས་གྲོལ་ལོ།",
    "བོད་དག་གིས་འཁྲུལ་གཞི་ནི།",
    "ཞེས་པའི་ཡང་གི་སྒྲ་གསུངས་པ་ཡང་རྣམ་རིག་པ་དག་གིས་སྐྱེ་བ་བཀག་པ་ཡང་དག་པ་ཁོ་ནར་འཛིན་པས་དེ་ཕྱོགས་མཐུན་གྱི་དོན་དམ་དུ་བསྡུ་བའི་དོན་དུ་ཡང་གི་སྒྲ་སྨྲོས་ཞེས་པའི་དོན་དང་འགལ་བ་ཡིན་ནོ།"
  ]
