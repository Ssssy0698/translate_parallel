    "དེ་དག་ནི་དངོས་ཁམས་རིག་པ་བ་དང་རྫས་འགྱུར་རིག་པ་བ་རྣམས་ལ་གོམས་པ་ཆེ་བའི་སྤྱིར་བཏང་གི་གློག་དང་རྫས་ཀྱི་བྱུང་བས་གཟུགས་ཅན་གྱི་སྒོ་ནས་ཚད་འཇལ་རུང་བའི་འགྲོ་ལུགས་ཤིག་ཡིན་ཀྱང་།",
    "གཅིག་དེ་སྤྱིར་བཏང་གི་རྒྱུན་ཤེས་གཞིར་བཞག་དང་གཅིག་ཤོས་ནི་དུས་རབས་བཞི་ཙམ་རིང་ཚན་རིག་གི་འཚོལ་རྙེད་ལ་གཞིར་བཟུང་ཡོད།",
    "དེས་རང་བྱུང་གི་འཇིག་རྟེན་ཁམས་ལ་རྒྱུ་རྐྱེན་བྱེད་པ་དང་།",
    "མྱོང་ཚོར།",
    "དཔེ་དེ་བཞིན་དུ་སེམས་ཁམས་རིག་པ་རྐྱང་པས་ང་ཚོས་ག་རེ་ཤེས་པ་དང་།",
    "ཁོང་ཚོ་གཉིས་ཀས་མྱོང་འདྲིས་ཀྱི་ཐོག་ནས་དགག་སྒྲུབ་བྱེད་ཀྱི་མེད་པ་དེ་ཡིན།",
    "ཡུལ་རྟོགས་ཚན་རིག་པ་རྣམས་ཀྱིས་ཇི་ཙམ་རིང་མུ་མཐུད་ཀླད་རྩའི་རྒྱུ་རྐྱེན་དང་སེམས་ཀྱི་སྤྱོད་ཚུལ་སྟོན་སྟངས་ཀྱི་བརྟག་ཐབས་ཁོ་ནའི་ནང་བསྡད་པ་ཡིན་ན་ཡིད་ལུས་ཀྱི་དཀའ་རྙོག་ཐོག་གཉིས་སྣང་སྨྲ་བའམ་དངོས་གཙོ་སྨྲ་བའི་རྣམ་གཞག་གང་གིས་ཀྱང་དགག་སྒྲུབ་མི་ཐུབ།",
    "དེ་ནི་ཁོང་ཚོའི་རྗེས་འབྲང་པ་ཚོས་སྤྱིར་བཏང་རང་ཉིད་ཀྱི་ལྟ་ཚུལ་ལ་ཞེན་འཛིན་སྟོན་པ་ཙམ་ཞིག་ཡིན།",
    "ཇི་ལྟར་བྱས་ཏེ་ང་ཚོ་ལྟ་ཚུལ་གྱིས་ཁ་ལོ་སྒྱུར་བའི་མགོ་རྙོག་འདི་ནས་འགྲོལ་ཐུབ་བམ།",
    "རང་བཞིན་ལས་འདས་པ་སྨྲ་བ་པོ་རྣམས་ཀྱིས་ཀྱང་ཚན་རིག་གི་འཚོལ་རྙེད་རྣམས་འཇིག་རྟེན་བཀོད་པ་པོས་ལུང་དུ་བསྟན་པའི་གདམས་པ་ལས་གལ་ཆུང་བར་བརྩི་དགོས་པའི་ཨུ་ཚུགས་བྱེད་ཀྱི་ཡོད།",
    "ཕྱོགས་གཉིས་ཀས་ཕན་ཚུན་རྩ་མེད་གཏོང་རེས་ཀྱི་འཐབ་རྩོད་མི་བྱེད་ཀྱང་ཚིག་རྩུབ་འཕང་རེས་བྱེད་པའི་ལངས་ཕྱོགས་དེར་བསལ་ཐབས་ཤིག་འཚོལ་དགོས་ན།",
    "ང་ཚོས་དཀའ་རྙོག་དེའི་ཐོག་མའི་མེ་ལྕེ་གང་ནས་སྤར་མིན་གྱི་དུས་ཚོད་ལ་ཕྱིར་བལྟས་ཤིག་བྱེད་དགོས།",
    "གོང་གི་བཀའ་རྒྱ་དེར་ཡིད་མ་རངས་པར་ཚན་རིག་གི་གསར་བརྗེའི་སྲོལ་འབྱེད་པ་ཚོས་གྱེན་ལོག་བྱས་པ་དང་།",
    "ཁོང་གིས་ངོ་སྤྲོད་བྱས་པའི་བསམ་ཚུལ་དེ་ད་ལྟའང་མུ་མཐུད་གནས་ཡོད།",
    "འོན་ཀྱང་ཨ་ཡན་སྲཊན་གྱི་གཏིང་ཟབ་པའི་གོ་རྟོགས་ནི་བེམ་རྫས་ཀྱིས་བར་སྣང་དང་དུས་ཚོད་འཁྱོག་ཏུ་བཅུག་པ་དང་།",
    "དེས་རང་བྱུང་ཁམས་ཀྱིས་དགའ་མོས་བྱེད་ཡུལ་ལ་ཁས་ལེན་མེད་པ་བསྟན་ཡོད།",
    "ཚན་རིག་པ་རྣམས་ཀྱིས་མྱོང་འདྲིས་ཁུངས་སྐྱེལ་བྱེད་ཚུལ་རྣམས་ཁོང་ཚོའི་རྣམ་གཞག་ཁག་གི་མཐའ་མའི་ཐག་གཅོད་ལ་བཞག་ཡོད།",
    "ཚན་རིག་གི་དངོས་གཙོ་སྨྲ་བ།",
    "གཤམ་དུ་གསལ་བའི་གཞི་རྩའི་ཁས་ལེན་བཞི་པོའི་སྟེང་གཞི་རྟེན་བྱས་པའི་དངོས་གཙོ་སྨྲ་བའི་ལྟ་གྲུབ་དང་མཐུན་རྒྱུའི་ཆེད་སྒང་ནས་འོག་ཏུ་ནན་བསྐྱལ་བྱས་པ་ཞིག་རེད།",
    "གས་སྒྲ་ཆེན་མོ་བྱུང་བའི་རྗེས་གཙོ་བོ་གཟུགས་ཅན་གྱི་བརྒྱུད་རིམ་ལ་བརྟེན་ནས་འཇིག་རྟེན་ཁམས་འདི་བྱུང་བ་དང་།",
    "དེ་དག་གི་གྲུབ་ཆ་རྣམས་རྫས་འགྱུར་རིག་པ་བ་ཚོས་ཤེས་རྟོགས་ལེགས་པར་བྱས་པ།",
    "དམིགས་བསལ་གྱི་གནས་ཚུལ་ཁ་ཤས་མ་གཏོགས་རང་བྱུང་ཚན་རིག་ཁོངས་ཀྱི་མྱོང་འདྲིས་ཀྱི་ཞིབ་འཇུག་ཚང་མའི་ནང་གོང་གི་ཁས་ལེན་དེ་དག་གཅིག་མཚུངས་དགོས་པ་རེད།",
    "དངོས་ཁམས་རིག་པ་བ་ཚོས་དངོས་གཙོ་སྨྲ་བའི་ཚན་རིག་གི་རྩ་འཛིན་ལ་ཁ་གཏད་མི་བྱེད།",
    "མི་ལོ་༤ ཙམ་རྗེས་ཚན་རིག་གིས་ཧ་ལས་དགོས་པའི་ཡར་རྒྱས་བཏང་ཡོད་ནའང་ད་དུང་ཤེས་པའི་སྐོར་ལ་ཚན་རིག་གི་ཁ་གསལ་ཟུར་སྟོན་གྱི་གསལ་འབྲེལ་མེད་ལ།",
    "གོང་གི་ཚོད་དཔག་གསུམ་པོ་མྱོང་འདྲིས་ཀྱི་ཐོག་ནས་གསལ་པེ་ལང་ཀ་ཡི་དུས་ཚོད་ཅེས་པ་ནི་སྟོང་ཆའི་ནང་པེ་ལང་ཀ་ཡི་རྒྱང་ཐག་ཚད་གཞི་གཅིག་གི་བར་ཐག་ལ་འོད་ཀྱི་འགྲུལ་བཞུད་བྱེད་པར་དུས་ཚོད་ཇི་ཙམ་འགོར་བའི་དོན་ཡིན།",
    "ཚན་རིག་གི་འཕེལ་འགྱུར་དེར་རང་བཞིན་དང་མ་མཐུན་པ་ཞིག་ཡོད་པ་ནི།",
    "ཆེས་ཐོག་མའི་སེམས་དང་འབྲེལ་བའི་ཚན་རིག་གི་གསར་བརྗེ་ཞིག་སློང་བར་སེམས་ཀྱི་དངོས་གཙོ་སྨྲ་བའི་ལྟ་ཚུལ་ལ་མཐའ་གཅིག་ཏུ་མོས་གུས་བྱེད་མཁན་ཚོར་ཟུག་རྔུ་སྐྱེད་བྱེད་ཀྱི་བསམ་ཚུལ་ཞིག་འཕྲད་རྒྱུ་ཡིན་པ་དང་།",
    "དེ་ནི་སེམས་དང་བེམ་རྫས་གཉིས་ཀྱི་རང་བཞིན་ལས་ཞིབ་ཚགས་པའི་བདེན་པའི་ཕྱོགས་ཆ་ཞིག་གི་བརྒྱུད་རིམ་ལས་བྱུང་བར་འདོད་པའི་སྒོ་ནས་འགྲོ་བ་མིའི་སེམས་དེའང་བལྟོས་གྲུབ་ཡིན་པར་བསྒྲུབས་ཡོད་ཅིང་།",
    "འོན་ཀྱང་གལ་ཏེ་ཚན་རིག་གི་སེམས་དེ་རང་བྱུང་ཁམས་ཀྱི་ཆ་ཤས་ཤིག་དང་དེ་ལས་ལོགས་སུ་མེད་ན།",
    "ཚན་རིག་གི་འཇིག་རྟེན་ལྟ་ཚུལ་དེའི་རྒྱབ་ཕྱོགས་སུ་འཇིག་རྟེན་བཀོད་པ་པོའི་འཆར་བཀོད་ཅིག་ཡོད་པ་ཡིན་ནམ།",
    "སྐྱེ་བོ་སུ་རུང་གཅིག་གིས་ཀོ་པ་ནི་ཀས་ཡི་སྔོན་ལ་ཌར་ཝིན་གྱི་འཕེལ་འགྱུར་རྣམ་གཞིག་གཏོད་ཡོད་སྲིད་པ་དང་།",
    "གཞན་ཞིག་གིས་ཌར་ཝིན་གྱི་སྔོན་ལ་ཝེ་ལེམ་ཇེམ་སེ་ཡི་བློ་ཁ་ནང་དུ་ཕྱོགས་ཏེ་དཔྱད་པ་གཏོང་བའི་སེམས་ཁམས་རིག་པའི་རྣམ་གཞག་གསར་གཏོད་བྱས་ཡོད་སྲིད།",
    "སྒྲིག་འཛུགས་ཀྱི་ཐོག་ནས་ཚན་རིག་གི་བདེན་པ་གཅིག་དེར་ངེས་པར་དུ་ཆ་རྐྱེན་གཉིས་ཚང་དགོས།",
    "བསམ་ཚུལ་དེ་རིགས་ད་དུང་སྒྲིག་འཛུགས་ཁ་ཤས་ཀྱིས་རང་ཉིད་ཀྱི་ལྟ་ཚུལ་དང་ཐབས་ལམ་གཅིག་གྱུར་ཡོང་སླད་བཅོས་མའི་སྒོ་ནས་བདག་གིར་བྱས་ཡོད།",
    "གནས་ཚུལ་དེའི་རིགས་དུས་རབས་བར་མའི་དུས་མཇུག་ཏུ་རོའོ་མན་མཆོད་ཁང་གི་ལྟ་རྟོག་འོག་ཏུ་བྱུང་བ་དང་།",
    "གལ་ཏེ་རང་བྱུང་འདེམས་སྒྲུག་དང་སྟོབས་ཀྱིས་འཚོ་གནས་གཉིས་ནི་ཚན་རིག་གི་རྣམ་གཞག་འཇོག་རྒྱུའི་མིག་དཔེ་ལེགས་པོ་ཞིག་ཡིན་ན།",
    "འོན་ཀྱང་ཚན་རིག་གི་རྣམ་གཞག་གཅིག་གསོན་གནས་དང་རྒྱུད་སྤེལ་བྱེད་པར།",
    "ཚོགས་ལའང་བསྟུན་དགོས་པ་རེད།",
    "དོ་ནན་ཆེན་པོའི་དཔྱད་ཞིབ་ཀྱི་འབྲས་བུ་ལས་བྱུང་བའི་མྱོང་འདྲིས་ཀྱི་ཁུངས་སྐྱེལ་ལ་གཞིགས་ནས་རྣམ་གཞག་ཅི་འདྲ་ཞིག་ཚན་རིག་གི་བརྟག་ཞིབ་འོག་གནས་ཐུབ་མིན་ཐག་གཅོད་དགོས་པ་རེད།",
    "གལ་ཏེ་ཚན་རིག་ཡར་རྒྱས་འགྲོ་དགོས་ཀྱི་ཡོད་ན་ལོ་ངོ་བཅུ་ཕྲག་ཁ་ཤས་འགོར་རུང་ཚན་རིག་གི་རྩད་ཞིབ་ལས་བྱུང་བའི་ཚོད་དཔག་དེ་དག་ལ་ངེས་པར་དུ་མཐར་དཔྱད་བཟོད་ཐུབ་པའི་འབྲས་བུ་འཐོབ་དགོས་པ་རེད།",
    "ཁྱབ་ཁོངས་འདིའི་ནང་མྱོང་འདྲིས་ཀྱི་ཞིབ་འཇུག་ཚང་མས་གོང་གི་བསམ་ཚུལ་ལྟར་གྲོས་ཁ་གཅིག་མཐུན་ཞིག་བྱེད་ཀྱི་ཡོད་སྟབས་དངོས་གཙོ་སྨྲ་བའི་སེམས་ཀྱི་རྣམ་གཞག་དེ་དག་ལ་དཔྱད་བཟོད་རུང་བའི་གྲུབ་འབྲས་འཐོབ་མི་དགོས་པ་ལྟ་བུ་ཆགས་ཡོད།",
    "དེབ་འདིའི་བརྗོད་གཞི་གཙོ་བོ་ནི་ཤེས་པ་དང་ཡུལ་གྱི་ཤེས་པ་ཐེ་བའི་རང་བྱུང་གི་འཇིག་རྟེན་འདིའི་ཕྱོགས་ཆ་སྣ་ཚོགས་པ་དེ་དག་ཚན་རིག་གི་ལྟ་ཚུལ་དང་འགྲོ་བ་མིའི་བསམ་སྒོམ་གྱི་མྱོང་བའི་ལྟ་ཚུལ་གཉིས་ཀ་བློ་རྩེ་གཅིག་སྒྲིམ་གྱི་སྒོ་ནས་རྟོགས་ཐུབ་པ་དང་།",
    "ཤེས་པ་ནི་ང་ཚོའི་ལྟ་ཚུལ་དང་རྟོག་ཚུལ་གྱི་འཇིག་རྟེན་འདིའི་ཤེས་བྱ་ཀུན་གྱི་གཞི་རྩར་གྱུར་ཡོད།",
    "དེས་དེའི་མཐའ་སྐོར་གྱི་ཁྱབ་ཁོངས་ཚང་མར་ཕར་སྤྲོད་ཚུར་ལེན་གྱི་སྒོ་ནས་ཤུགས་རྐྱེན་བྱེད་པ་ལ་བརྟེན་ནས་དེ་དག་ཕན་ཚུན་གཅིག་གིས་གཅིག་ལ་ཤུགས་རྐྱེན་བྱེད་ཀྱི་ཡོད།",
    "ཁོང་ཚོ་ཕལ་ཆེ་བས་ལུས་སེམས་ཀྱི་དཀའ་རྙོག་སེལ་ཕྱིར་རང་བྱུང་སྨྲ་བའི་ཐབས་ལམ་ཞིག་འདོན་རྒྱུའི་ཐག་གཅོད་བྱུང་ཡོད།",
    "ཤེས་པའི་ལྟ་ཚུལ་ཁག་གཅིག་གི་ཡོན་ཏན་ལ་མ་བལྟས་གོང་ང་ཚོས་རང་བྱུང་སྨྲ་བའི་རྒྱབ་ལྗོངས་ཀྱི་ལྟ་སྟངས་དང་གོ་རིམ་ཁག་ལ་དཔྱད་ཞིབ་དགོས་པ་རེད།",
    "རང་བྱུང་གི་འཇིག་རྟེན།",
    "དེ་ཉིད་ཤེས་རྟོགས་བྱེད་པར་གཟུགས་ཅན་དང་བེམ་རྫས་སོགས་ཀྱི་ཐ་སྙད་དེ་དག་གི་གོ་དོན་ལ་ཁ་གསལ་ཞིབ་ཚགས་ཀྱིས་བལྟ་དགོས་པ་རེད།",
    "རང་བྱུང་གི་འཇིག་རྟེན་སྣ་ཚོགས།",
    "དང་འབྲེལ་བའི་ཚན་རིག་གི་སློབ་སྦྱོང་འགོ་ཚུགས་སྐབས་བེམ་རྫས་ཀྱི་མཚན་ཉིད་ལ་རྟག་ཏུ་བར་སྟོང་འཛིན་མཁན་ཞིག་དང་།",
    "རང་བཞིན་གྱི་ངང་ནས་བསྡུས་པའི་གདོས་ཚད་དང་བར་སྟོང་གི་སྒོ་ནས་འགྲེལ་བའི་རྡུལ་ཕྲན་གྱི་གཟུགས་ལྟ་བུ་ལ་བཞག་པའི་མཚན་ཉིད་དེའི་གདེང་འཇོག་བརླགས་པ་རེད།",
    "ཁོང་གིས་ལྟ་ཚུལ་རྙིང་པ་འདི་དག་ཉམས་ཞན་དུ་གཏོང་བའི་དཔྱད་རྩོམ་སྤེལ་ཡོད་པ་མ་ཟད།",
    "ཁོང་གི་དུས་མཉམ་གྱི་དངོས་ཁམས་རིག་པ་བ་དང་ལྟ་གྲུབ་པ་རྣམས་ཀྱིས་དུས་རབས་བཅུ་དགུའི་ནང་དངོས་གཙོ་སྨྲ་བའི་ལྟ་ཚུལ་གྱི་གདོང་ལེན་ཁག་ལ་དུས་དང་མཐུན་པའི་ཁ་གསབ་བྱས་ཡོད།",
    "དེ་ལྟ་ནའང་སྤྱིར་བཏང་གི་དངོས་ཁམས་རིག་པ་བ་མང་པོས་ད་དུང་འཇིག་རྟེན་འདི་རྡུལ་ཕྲན་གྱི་ངོ་བོ་དུ་མས་གྲུབ་པ་དང་།",
    "རང་བྱུང་གི་འཇིག་རྟེན་སྣ་ཚོགས།",
    "༡༨༤༧ ལོར་དེ་ཚན་རིག་གི་འཇིག་རྟེན་ལྟ་ཚུལ་ནང་རྩ་བ་བརྟན་ཚུགས་བྱུང་བ་དང་།",
    "དུས་རབས་ཉི་ཤུ་པའི་ནང་དངོས་ཁམས་རིག་པ་མུ་མཐུད་ཡར་རྒྱས་སོང་བ་དང་སྤྱིར་བཏང་གི་ནུས་པའི་རང་བཞིན་ལྟ་ཚུལ་དེ་གྲངས་རྩིས་ཀྱི་རྩ་འཛིན་ཞིག་ལ་སྤུས་དག་ཏུ་བཏང་བ་དེ་ནི་དངོས་པོའི་རྩོལ་ནུས་སམ་གཟུགས་རགས་པ་གང་གི་འགྲེལ་བརྗོད་ཅིག་མ་ཡིན་ལ།",
    "རང་བྱུང་གི་འཇིག་རྟེན་སྣ་ཚོགས།",
    "རང་བྱུང་གི་འཇིག་རྟེན།",
    "དུས་རབས་བཅུ་དྲུག་པའི་ནང་བདུད་མོའི་མཐུ་གཏད་སྐོར་ལ་མི་སྒེར་དང་སྐྱེ་བོ་མང་པོའི་མཐུན་གྲོས་ལ་གཞིར་བཞག་པའི་བདེན་དཔང་གི་ཚིག་ཐོ་སྣ་ཚོགས་ཤིག་ཐོན་ཡོད།",
    "རྟོག་ཞིབ་དེ་དག་རིགས་གཅིག་ཚན་རིག་གི་དཔྱད་ཞིབ་ལྟར་དམིགས་བསལ་དོན་གཉེར་ཅན་ཁ་ཤས་ཀྱིས་བདག་ཏུ་བཟུང་བ་དང་།",
    "དེ་ན་ང་ཚོས་མྱོང་འདྲིས་ཀྱི་ཁུངས་སྐྱེལ་མེད་པར་བེམ་གཟུགས་སམ་ཡུལ་གྱི་ཡོད་པ་ཉིད་དུས་རབས་ཉི་ཤུའི་ཡར་སྔོན་དུ་ཚན་རིག་གིས་བེམ་རྫས་ཀྱི་གྲུབ་གཞི་ཆུང་ཤོས་དེ་རྡུལ་ཕྲན་ཡིན་པར་ཡིད་ཆེས་བྱས་ཡོད།",
    "རང་བྱུང་གི་འཇིག་རྟེན་སྣ་ཚོགས།",
    "དུས་རབས་ཉི་ཤུའི་བལྟོས་གྲུབ་དང་ཚད་རྡུལ་རྣམ་གཞག་གི་གསར་བརྗེའི་སྣང་བ་གསར་པ་ཞིག་ནས་ཡུལ་གྱི་བསམ་ཚུལ་དེ་དོར་ཟིན་པ་དང་།",
    "རང་བྱུང་གི་འཇིག་རྟེན།",
    "དེས་རྡུལ་ཕྲན་དང་དེའི་ཁྱབ་ཚད་ཀྱི་ར་བའི་ནང་ཐོགས་རེག་བྱེད་པའམ།",
    "འོན་ཀྱང་ང་ཚོས་མིག་བཙུམ་ནས་དེ་དག་གི་ཡོད་པ་ཉིད་ལ་སྣང་མེད་དུ་འཇོག་གི་མེད།",
    "རྗེས་སུ་དཔག་ནུས་པའི་རྒྱུ་རྐྱེན་གྱི་འབྲེལ་ཐུག་དེ་དག་ཁོ་ན་ཁོངས་སུ་འཇོག་གི་ཡོད།",
    "དེ་ནི་ད་ལྟ་ང་ཚོར་ཡོད་པའི་ཡུལ་ཅན་གྱི་བྱུང་རིམ་ལ་དཔྱོད་པའི་ཐབས་ལམ་གཅིག་པུ་དེ་ཡིན་པས་རེད།",
    "རང་བྱུང་གི་འཇིག་རྟེན།",
    "ཀླད་པའི་སློབ་སྦྱོང་གི་ཚད་ཐུབ་ངེས་པའི་རིགས་ལམ་གྱི་ཐབས་ལམ་སྤྱད་ནས་སྐྱེ་དངོས་རིག་པ་བ་ཚོས་མཐར་ཀླད་རྩའི་ཆགས་བཀོད་ནས་ཡུལ་ཅན་གྱིས་མྱངས་པའི་སེམས་ཀྱི་བྱུང་རིམ་བར་གོམས་སྟབས་ཀུན་ལ་བར་དུ་གཅོད་པའི་འདོད་བློ་ཁེངས་ངེས་ཀྱི་འགྲེལ་བརྗོད་ཡོང་རྒྱུར་ཡིད་ཆེས་བརྟན་པོ་ཞིག་ཡིན།",
    "ཡུལ་རྟོགས་ཚན་རིག་པ་ཕལ་མོ་ཆེས་རང་བྱུང་གི་འཇིག་རྟེན་སྣ་ཚོགས།",
    "རང་བྱུང་འདེམ་སྒྲུག་གི་འགྲེལ་བརྗོད་ནང་ཌར་ཝིན་གྱི་རྣམ་གཞག་ལས་གྲུབ་འབྲས་སོན་པ་རྣམས་ལ་ཡོངས་སུ་ཁས་ལེན་བྱས་ཡོད།",
    "དེ་ནི་མཐར་འཇིག་རྟེན་ཁམས་འདིའི་ནང་ཤེས་པའི་འབྱུང་ཁུངས་དང་དེའི་རང་བཞིན་འགྲེལ་བརྗོད་བྱེད་རྒྱུར་ཕུགས་རེ་ཆེ་ཤོས་ཤིག་ཆགས་ཡོད།",
    "དོན་དངོས་ནི་སེམས་ཀྱི་མྱོང་བ་ཁྱད་པར་བ་རེ་བསྐྲུན་པར་ཀླད་རྩའི་བརྒྱུད་རིམ་ངེས་ཅན་ཞིག་དགོས་ངེས་ཡིན་པ་དེས་མྱོང་བ་དེ་ཉིད་བསྐྲུན་པར་ཀླད་རྩ་མ་ཡིན་པའི་དགོས་ངེས་ཀྱི་རྒྱུ་རྐྱེན་གཞན་ངོ་སྤྲོད་བྱེད་ཀྱི་མེད།",
    "ལྷག་པར་དུ་འགྲོ་བ་མིའི་གསལ་རིག་གི་མྱོང་བ་ཁྱད་པར་བ་ཞིག་ལ་རྒྱུ་རྐྱེན་བྱེད་རང་བྱུང་གི་འཇིག་རྟེན་སྣ་ཚོགས།",
    "ང་ཚོས་རང་ཉིད་ཀྱི་རྨི་ལམ་ནང་གི་མཚོན་དོན་ལ་དོ་སྣང་ཡོང་བ་དང་།",
    "འཚང་ཁ་དང་སྐད་སྒྲ་ཆེ་བའི་འགྲིམ་འགྲུལ་ནང་ཨ་མ་ཞིག་གཉིད་དུ་ཤོར་ནའང་རང་ཉིད་ཀྱི་ཕྲུ་གུའི་ངུ་སྐད་ཐོས་སྐབས་ལམ་སེང་གཉིད་ལས་སད་ཀྱི་ཡོད་པར་ལྟར་ཡིན།",
    "ཚན་རིག་པ་རྣམས་ཀྱིས་གང་ཟག་དེ་གཉིད་ལས་མ་སད་བར་སྤྱོད་ཚུལ་སྟོན་སྟངས་གང་རུང་གི་ཐོག་ནས་དེ་དག་ལ་སྒོ་བསྟུན་གྱི་བརྡ་མཚོན་དཔྱོད་མི་ཐུབ།",
    "ཀླད་རྩའི་ཚན་རིག་པ་རྣམས་ཀྱིས་དུས་ཚོད་ཅི་འདྲ་ཞིག་གི་ཐོག་ཀླད་རྩའི་བྱུང་རིམ་ཤར་གྱི་ཡོད་པ་དེ་ཚད་འཇལ་ཏག་ཏག་ཐུབ་ཀྱི་ཡོད་ཀྱང་།",
    "ཡུལ་ཅན་ཞིག་གི་མྱོང་བ་ཤར་བའི་དུས་ཡུན་ཏག་ཏག་ཅིག་ཚད་འཇལ་བྱེད་རྒྱུ་དེ་དཀའ་ངལ་ཞིག་ཆགས་ཡོད།",
    "སྤྱོད་ཚུལ་རིག་པ་བ་ཚོས་ཀྱང་ངོ་གདོང་གི་གནས་ཚུལ་ལ་བལྟས་ནས་སེམས་ཀྱི་བརྒྱུད་རིམ་ཤར་ཚུལ་ཁས་ལེན་མི་བྱེད་པར་ཁོང་ཚོའི་དགོས་འདུན་ནི་རེག་ཚོར་ལ་ཡ་ལན་བྱེད་པའི་རྣམ་འགྱུར་གྱི་རང་གཤིས་ཐོག་ནས་སེམས་ཀྱི་རང་བཞིན་དངོས་ངོས་འཛིན་བྱེད་རྒྱུ་དེ་ཡིན།",
    "རང་བྱུང་གི་འཇིག་རྟེན།",
    "དེ་ནི་ཌར་ཝིན་གྱི་འཕེལ་འགྱུར་དང་རིགས་རྫས་ཟུང་འབྲེལ་གྱི་ལྟ་ཚུལ་ལ་ཁས་ལེན་གྱི་རྣམ་འགྱུར་ཙམ་ཞིག་ལས་ཚན་རིག་གི་གནས་བབས་ཆ་ནས་དེ་ཚན་རིག་ཡིན་དང་མིན་གྱི་ཐེ་ཚོམ་སློང་གི་ཡོད།",
    "དེ་དག་ངེས་པར་དུ་གཟུགས་ཅན་ཡིན་དགོས་པ་རེད།",
    "དེས་ན་ཡུལ་ཅན་གྱི་མྱོང་བ་དག་གིས་ཀླད་པ་དང་སྤྱོད་ཚུལ་ལ་ཤུགས་རྐྱེན་བྱེད་སྲིད་པ་སོགས་ལ་དཔྱད་ཞིབ་གཏོང་བ་རེད།",
    "དེས་སྟོང་སང་གི་བར་སྟོང་བརྒྱུད་གློག་ཁབ་ལེན་གྱི་ར་བ་འཕེལ་སྐྱེད་འགྲོ་ཚུལ་གྱི་བྱེད་ལས་ཅི་ཡིན་གྱི་འགྲེལ་བརྗོད་མེད་པ་དང་།",
    "གདོས་ཚད་དང་ནུས་པའི་གྲུབ་ཚུལ་དབར་ལ་ཕན་ཚུན་རྒྱུ་རྐྱེན་གྱི་འབྲེལ་ཐུག་ཡོད་པ་བསྟན་པ་རང་བྱུང་གི་འཇིག་རྟེན་སྣ་ཚོགས།",
    "ད་དུང་ཨུ་ཚུགས་ཀྱིས་ལུས་སེམས་ཀྱི་དཀའ་རྙོག་དང་འབྲེལ་བའི་རྣམ་གཞག་གི་གདམ་ཀ་གཅིག་པུ་དེ་ཀར་ཊི་སན་ལུགས་ཀྱི་གཉིས་སྣང་ཅེསམ་དངོས་གཙོ་སྨྲ་བའི་གཉིས་མེད་ལ་འཛིན་གྱི་ཡོད།",
    "དེས་ན་ཚན་རིག་གིས་གཉིས་མེད་སྨྲ་བ་དང་གཉིས་སྣང་གི་ལྟ་ཚུལ་དེ་གཉིས་ལས་བརྒལ་ཏེ་མྱོང་འདྲིས་ཀྱི་དུ་མ་འདོད་པའི་རིང་ལུགས་ཕྱོགས་སུ་བསྐྱོད་ཡོད།",
    "སེམས་ནི་གཟུགས་འདས་ལ་འདོད་པའི་གནའ་བོའི་གྷི་རིག་གི་ལྟ་གྲུབ་པ་ཀར་ཊི་སན་གྱིས་འདོད་པའི་གྲུབ་དོན་ཅིག་སྒྱུར་མཁན་གྱིས།",
    "རང་བྱུང་གི་འཇིག་རྟེན་སྣ་ཚོགས།",
    "སྤྱིར་བཏང་གི་དངོས་ཁམས་སམ་སྐྱེ་དངོས་རིག་པའི་བརྟག་དཔྱད་ཀྱི་གནས་སྟངས་འོག་ཤེས་པའི་ཤུགས་རྐྱེན་དེ་ཧ་ཅང་མངོན་ཆུང་ཆུང་ཡིན།",
    "འོན་ཀྱང་བརྟག་དཔྱད་ཀྱི་ལམ་ནས་འགུལ་སྐྱོད་བྱེད་པའི་ཡུལ་དེ་དག་གི་སྟེང་འོད་ཀྱི་ཤུགས་རྐྱེན་མིག་སྟོན་བྱེད་རྒྱུ་ཁག་པོ་ཡིན།",
    "བསམ་བློའི་རྟོག་བཟོའི་བཅོས་ཐབས་ཀྱི་ཕན་ནུས་ཀུན་དང་སྒོམ་ཉམས་ལེན་གྱིས་ཀླད་པའི་ནང་ཤུགས་རྐྱེན་ཇི་ཡོད་ཀྱི་ཐོག་ནས་བསམ་བློའི་རྒྱུ་རྐྱེན་གྱི་ནུས་པ་རྣམས་ཚན་རིག་གི་ཐབས་ལམ་ནས་ཞིབ་འཇུག་བྱས་ཟིན་པ་དང་།",
    "ཀླད་པའི་སྟེང་གི་ཞིབ་ཚགས་ཆེ་བའི་ཞིབ་འཇུག་དེ་ཧ་ལམ་དུས་རབས་གཅིག་ལྷག་སྔོན་ནས་ཚུགས་པས་ཡིན་ལ།",
    "འོན་ཀྱང་ཁོང་ཚོས་ཕྱོགས་མང་པོ་ཞིག་ནས་རང་བྱུང་སྨྲ་བའི་ཁས་ལེན་དང་འཁྲུལ་སྣང་གི་ཤེས་བྱས་རྐྱེན་པས་ཤེས་པའི་རང་བཞིན་དང་འབྱུང་ཁུངས་ལ་ཤེས་རྟོགས་མ་བྱུང་བའི་སྒྲིབ་པ་སེལ་ཐབས་བྱེད་པ་དང་།",
    "འབྱུང་འགྱུར་གྱི་འཚོལ་རྙེད་ལ་གཞིགས་ཏེ་ཁོང་ཚོའི་ད་ལྟའི་ཡིད་ཆེས་ཁག་ཕུགས་འཕེར་ཐུབ་པའི་རེ་བ་བྱས་ཡོད་ཀྱང་ལག་ལེན་འདི་ཚན་རིག་གི་རྣམ་འགྱུར་དང་རྒྱབ་འགལ་ཆགས་ཡོད།",
    "འོན་ཀྱང་ཁོང་གིས་རྒྱུན་རིང་འགྱུར་བ་མེད་པའི་སྒོ་ནས་ཡིད་ལུས་ཀྱི་དཀའ་རྙོག་དེ་གཟུགས་ཅན་གྱི་ལྟ་ཚུལ་ལ་བཟུང་ཡོད་རུང་།",
    "དོན་དངོས་ཐོག་ཚན་རིག་གི་གསར་བརྗེའི་ནང་གྲགས་ཆེ་བའི་སྲོལ་འབྱེད་མཁན་རྣམས་ལྷ་ཡོད་སྨྲ་བ་འདོད་མཁན་ཡིན་ཁར།",
    "ཁོང་མྱ་ངན་ལས་འདས་པ་རེད།",
    "ང་ཚོས་ཁོང་དཀྲོངས་པ་རེད།",
    "དེས་ན་ང་ཚོ་བཤན་པའི་བཤན་པ་གཅིག་གིས་རང་གིས་རང་ལ་སེམས་གསོ་ཇི་ལྟར་གཏོང་ངམ།",
    "དེ་དག་གིས་རང་བྱུང་འཇིག་རྟེན་ཁམས་ཀྱི་གྲུབ་ཆ་དང་སྟངས་འཛིན་གྱི་འགན་ལེན་བྱེད་པར་ཤུགས་ཆེར་འཛིན་པའི་ཁོང་ཚོའི་ཡིད་ཆེས་ཀྱི་ལྟ་ཚུལ་རྣམས་བཙན་ཐབས་ཀྱིས་ཕྱིར་འཐེན་བྱེད་དགོས་ཐུག་པ་རེད།",
    "ཁོང་ཚོས་སེམས་ཀྱི་ཡོད་པ་ཉིད་དང་དེའི་རྒྱུ་རྐྱེན་བྱེད་ནུས་ཀྱི་གནས་བབས་རྣམས་གཟུགས་ཅན་གྱི་གནས་བབས་ལྟར་ངོས་འཛིན་བྱས་ཡོད།",
    "ཁོང་གིས་བརྗོད་པ་ལྟར་ན།",
    "ནིལ་བྷོར་གྱི་དངོས་ཁམས་རིག་པའི་གོ་རྟོགས་དེ་ཕན་ཚུན་ཁ་སྐོང་བྱེད་རེས་ཀྱི་རྩ་འཛིན་ལ་གཞི་བཞག་ཡོད།",
    "ཁོང་གི་ལྟ་ཚུལ་ནང་སྲོལ་རྒྱུན་དངོས་ཁམས་རིག་པས་བདེན་པར་ལྟ་བ་དང་།",
    "ཚད་རྡུལ་དངོས་ཁམས་རིག་པ་ནི་འབྱུང་ངེས་པའམ་སྲིད་རུང་གི་ཆ་མཐའ་དག་དང་འབྲེལ་ནས་ཡོད།",
    "ང་ཚོའི་འགྲེལ་བརྗོད་ཀྱང་དེ་ལྟར་ཚད་རྡུལ་དང་སྲོལ་རྒྱུན་གྱི་ཆ་གཉིས་མཉམ་འདྲེས་སུ་ཡིན་དགོས་ཤིང་།",
    "སེམས་དང་ཀླད་པའི་འབྲེལ་ཐུག་རྟོགས་ཐབས་བྱེད་དུས་རྣམ་གཞག་འཇོག་མཁན་མང་པོས་ཚད་རྡུལ་རྣམ་གཞག་དེ་གལ་ཆེར་མ་མཐོང་བའི་རྐྱེན་གྱིས་འཐོར་བྲལ་རྣམ་གཞག་གིས་ཁོང་ཚོའི་སེམས་ལ་བདེན་དཔང་འཕེར་བའི་རྒྱབ་རྟེན་བྱས་ཡོད་རུང་།",
    "གོང་གི་ལྟ་ཚུལ་གཉིས་ཀ་འགྲོ་བ་མིའི་ཤེས་པའི་རང་བཞིན་གྱི་རྣམ་གཞག་ལ་ཕྱོགས་པ།",
    "ཁོང་གི་བསམ་བློ་གཙོ་བོ་ནི་འཇིག་རྟེན་རིག་པའི་ཁྱབ་ཁོངས་སྣ་ཚོགས་དང་རྡུལ་ཕྲན་དངོས་ཁམས་རིག་པ་གཉིས་ཟུང་འབྲེལ་བྱེད་རྒྱུ་དེ་ཡིན།",
    "གོང་དུ་ང་ཚོས་དོ་སྣང་ཐུབ་པའི་འཇིག་རྟེན་རིག་པའི་ཁྱབ་ཁོངས་དང་རྡུལ་ཕྲན་དངོས་ཁམས་རིག་པའི་མཐའ་དེ་གཉིས་ཙམ་མ་ཟད།",
    "ཨན་ཊོན་ཛི་ལིང་གྷར་ནི་ཚད་རྡུལ་རྣམ་གཞག་གི་གཞི་རྟེན་ཐོག་བརྟག་དཔྱད་རྒྱུས་སྟོན་བྱེད་པོའི་དངོས་ཁམས་རིག་པ་བ་གཅིག་ཡིན།",
    "དངོས་ཁམས་རིག་པ་བ་རྣམས་ཀྱིས་ངེས་མེད་ཀྱི་སྒོ་མོ་དེ་ཕྱེ་ནས་འཇོག་དགོས་ཐུག་གི་ཡོད།",
    "ཚད་རྡུལ་རླབས་རྩེག་གི་ནུས་སྣང་ཇེ་ཆེ་ནས་ཇེ་ཆེར་འགྲོ་བ་དང་།",
    "ཁེལ་ཝན་གཅིག་གི་ཚད་གཞི་ནི་རྒྱུན་གཏན་གྱི་དྲོད་ཚད་ཀླད་ཀོར་འོག་གི་ཨང་གྲངས་༢༧༢་༡༥ དང་མཉམ་པ་ཡིན།",
    "༡༦༨༧ ལོར་ཁོང་གི་ལས་གཞི་དང་འབྲེལ་བའི་མ་རྩོམ་དཔར་འགྲེམས་བྱས་པ་ནས་བཟུང་༡༩༡༥ ལོར་ཨ་ཡན་ས་ཊན་གྱི་ཡོངས་ཁྱབ་བལྟོས་གྲུབ་རྣམ་གཞག་མ་ཐོན་པའི་བར་མི་ལོ་༢༢༨ འགོར་ཡོད།",
    "སྐྱེ་དངོས་ཚན་རིག་ནང་ལོ་བཅུ་ཕྲག་མང་པོའི་རྟོག་ཞིབ་ལ་བརྟེན་ནས་ད་ལྟའི་ཌར་ཝིན་གྱི་རང་བྱུང་འདེམ་སྒྲུག་གི་རྣམ་གཞག་འདི་བསྒྲུབས་ཡོད།",
    "དངོས་རིགས་ཀྱི་འབྱུང་ཁུངས་ཞེས་པའི་མ་དེབ་དཔར་བསྐྲུན་བྱས་པ་ནས་ཕ་རན་སེ་སྲ་ཀེ་རེག་དང་ཇེམ་སེ་ཝིལ་སན་གཉིས་ཀྱིས་རིགས་རྫས་ཀྱི་གཞི་རྐྱེན་འཚོལ་རྙེད་བྱུང་བའི་བར་ལོ་ངོ་བརྒྱ་ལྷག་འགོར་ཡོད།",
    "ཡུལ་གྱི་འཇིག་རྟེན་སྐོར་གྱི་ཡོད་ཚད་ཤེས་རྟོགས་བྱེད་མཁན་ནི་འགྲོ་བ་མིའི་ཤེས་པ་ཡིན་པ་དེ་ང་ཚོས་ལམ་སེང་བརྗེད་སོང་བ་དང་།",
    "ཁོང་གིས་བརྗོད་པ་ལྟར་ན།",
    "བར་སྣང་ནི་བེམ་རྫས་འགྲེལ་བརྗོད་ཆེད་ཀྱི་གྲངས་རྩིས་ཀྱི་ཐབས་ལམ་གཅིག་པུར་འཛིན་པའི་སྔར་གྱི་ང་ཚོའི་ཚོད་དཔག་ལྟར་གོང་གི་ཚོད་དཔག་ནི་རང་བཞིན་ལྟ་བུ་དང་གཅིག་བྱས་ན་ནོར་འཁྲུལ་ཡིན་པར་འགྲོ་བ་མིའི་ཤེས་པའི་རང་བཞིན་གྱི་རྣམ་གཞག་ལ་ཕྱོགས་པ།",
    "གལ་ཏེ་ང་ཚོའི་ལྟ་ཚུལ་དེ་དག་སྐབས་རེ་གཟུགས་ཅན་གྱི་ཡུལ་ལས་བདེན་པ་ཆེ་བ་ཡོད་ན་ཅི་ཞིག་འབྱུང་ངམ།",
    "དེས་ན་བེམ་གཟུགས་མེད་པའི་དུས་སུ་འཐེན་ཤུགས་ཀྱི་རླབས་གནས་པ་ལྟར་ཕོ་རྡུལ་དང་མོ་རྡུལ་མེད་པའི་སྐབས་སུའང་བར་སྣང་སྐུལ་སྤེལ་ཡོང་བ་དང་།",
    "འཐེན་ཤུགས་ཀྱི་རླབས་ནི་རྒྱུན་དུ་ཧ་ཅང་ཆུང་ངུ་ཡིན་པར་བརྟེན་བེམ་རྫས་དང་དེའི་འབྲེལ་ཐུག་བྱེད་ཚུལ་ཧ་ཅང་ཞན་པོ་ཡིན་པའི་རྐྱེན་ལས་ང་ཚོར་མྱོང་འདྲིས་ཐུབ་པའི་ཁུངས་སྐྱེལ་རྙེད་སོན་བྱུང་མེད།",
    "དེ་དག་གི་གནས་ཡོད་ཚུལ་ནི་གནམ་རིག་སྐར་དཔྱད་ཀྱི་གྲངས་ཐོ་ཁ་ཤས་ཤེས་རྟོགས་བྱེད་པར་ཧ་ཅང་གལ་འགངས་སུ་གྱུར་ཡོད།",
    "ཡོངས་ཁྱབ་ཀྱི་ཚོད་དཔག་འདིས་ང་ཚོ་བསྐྱར་དུ་འཇིག་རྟེན་ཁམས་འདིའི་ནང་ཚད་རྡུལ་རྣམ་གཞག་དེ་ཇི་ཙམ་གལ་འགངས་ཡིན་པའི་ཕྱོགས་སུ་འཁྲིད་ཀྱི་ཡོད།",
    "འཇིག་རྟེན་ཁམས་ཀྱི་རྒྱབ་ལྗོངས་སྐོར་ལ་མྱུལ་ཞིབ་བྱེད་པའི་མི་བཟོས་སྲུང་སྐར་འདྲ་མིན་གྱིས་མཁོ་སྒྲུབ་བྱས་པའི་ར་སྤྲོད་དང་ཁུངས་སྐྱེལ་ཐུབ་པའི་གྲངས་ཐོར་གཞིགས་ཏེ་ཚན་རིག་པ་འདི་དག་གིས་གདོད་མའི་འཇིག་རྟེན་ཁམས་རྒྱ་སྐྱེད་ཕྱིན་པའི་རྣམ་པ་དེར་ཤུགས་ལ་རྒྱབ་སྐྱོར་མཚོན་པའི་ར་སྤྲོད་མང་པོ་ཞིག་བྱེད་ཀྱི་ཡོད།",
    "ཁོང་གིས་ཚད་རྡུལ་རྣམ་གཞག་དང་ཚན་རིག་གི་ཤེས་པའི་གནས་བབས་དབར་གྱི་གོ་རྟོགས་ལ་དཔྱད་ཞིབ་གཏིང་ཟབ་བྱེད་པ་དང་།",
    "ཁོང་གི་རེ་འདུན་གཙོ་བོ་ནི་བརྒྱུད་རིམ་ཅི་འདྲ་ཞིག་ལ་བརྟེན་ནས་ཚད་འཇལ་བྱས་པའི་གྲུབ་འབྲས་མང་པོའི་ཁོངས་ནས་གདམ་ཀ་གཅིག་ཇི་ལྟར་འདེམས་སྒྲུག་བྱས་ཚུལ་ཤེས་རྟོགས་བྱེད་རྒྱུ་དེ་ཡིན།",
    "དེ་དང་འབྲེལ་བའི་སྲིད་རུང་གི་བགོ་བཤའ་ཇི་ལྟར་བྱེད་ཚུལ་འགྲེལ་བརྗོད་བྱེད་རྒྱུ་ཁོ་ན་མ་ཡིན་པར།",
    "གོང་གི་གནས་ལུགས་འདིས་སེལ་མ་ཐུབ་པའི་དཀའ་རྙོག་གཉིས་སླེབས་པ་རེད།",
    "ཁོང་གིས་དཀའ་རྙོག་ཆེན་པོ་གཉིས་དུས་མཉམ་ལ་སེལ་དུས་དེ་གཉིས་ཕན་ཚུན་རམས་འདེགས་ཀྱིས་བྱེད་པ་ལྟར།",
    "༢༣ ལོར་དངོས་ཁམས་རིག་པའི་ཐོག་ནོ་སྦེལ་གཟེངས་རྟགས་ཐོབ་མཁན་ཝི་ཊ་ལི་ཨེལ་ཇེན་སེ་སྦག་གིས་ཚན་རིག་པས་ཚེ་སྲོག་གི་འབྱུང་ཁུངས་དང་ཤེས་པའི་སྐོར་ལ་འདོད་བློ་ཁེངས་པའི་འགྲེལ་བརྗོད་མ་བྱས་པར་བརྟེན།",
    "དེ་དང་ཚད་རྡུལ་རྣམ་གཞག་གི་འབྲེལ་བ་ཇི་ཡོད་ཐོག་ང་ཚོས་མཐར་སྐྱེལ་ནས་བཀག་འགོག་བྱེད་པ་ནི་ནོར་འཁྲུལ་ཡིན་ལ།",
    "དེ་འདྲའི་གསལ་ཁ་ལྡན་པའི་རྣམ་གཞག་འཇོག་པ་ནི་ང་ཚོར་དགོས་རྒྱུ་དེ་ཡིན་ཏེ།",
    "འདི་འདྲའི་ཡུལ་ཅན་ཕན་ཚུན་མོས་མཐུན་བྱེད་པའི་རྩད་ཞིབ་ཀྱི་དམན་འགྲོ་བ་མིའི་ཤེས་པའི་རང་བཞིན་གྱི་རྣམ་གཞག་ལ་ཕྱོགས་པ།",
    "སྒྲོམ་གཞི་ཆེ་ས་ཞིག་བསྐྲུན་ཏེ་དུས་རབས་ཉེར་གཅིག་གི་འགོ་སྟོད་འདིར་དངོས་ཁམས་རིག་པའི་ནང་དོ་གལ་ཆེ་ཤོས་ཀྱི་དཀའ་རྙོག་གཉིས་ནི།",
    "ལྷག་པར་དུ་འདས་པའི་ལོ་བཅུ་ཕྲག་གཉིས་གསུམ་རིང་གི་ཚད་རྡུལ་དངོས་ཁམས་རིག་པའི་ཡར་རྒྱས་ནང་ལྟ་ཚུལ་གྱི་དཀའ་རྙོག་གླེང་སྐབས་བརྟག་ཞིབ་མཁན་གྱི་ཤེས་པ་དེའི་ཁོངས་སུ་ཐེ་དགོས་པ་བཟོས་ཡོད།",
    "དངོས་ཁམས་རིག་པའི་འཕེལ་འགྱུར་འདིའི་ཐོག་ནས་ང་ཚོས་ཤེས་དགོས་པ་ནི།",
    "ང་ཚོས་བར་མཚམས་མེད་པའི་རླབས་འཕེལ་འགྲིབ་ཀྱི་ཆ་ཡོངས་རྫོགས་བསྡོམ་པ་ཡིན་ན།",
    "གཟེངས་སུ་ཐོན་པའི་ཡོ་བྱད་ཀྱི་རྒྱབ་རྟེན་མེད་པར་བརྟེན་རང་གི་མིག་རྗེན་པས་སྐར་ཚོགས་སྟོང་ཕྲག་འགའ་ཤས་མ་གཏོགས་དེ་བྱིངས་ཀྱི་སྐར་ཚོགས་རྣམས་མཐོང་ཐུབ་ཀྱི་མེད།",
    "གནས་ཚུལ་དེ་དག་དངོས་ཡོད་ཀྱི་ལག་ལེན་ཐོག་ནས་འཚོལ་ཞིབ་ཡོང་རྒྱུའི་རེ་བ་འབྲལ་བར་བརྟེན།",
    "༡༦༩ ལོ་བར་གོང་གི་གནས་ཚུལ་རྣམས་གཟུགས་འདས་ཀྱི་ཁྱབ་ཁོངས་སུ་བཞག་ཡོད།",
    "སྔོན་ཆད་མཐོང་མ་མྱོང་བའི་དགུ་ཚིགས་སྐྱ་མོའི་ཁོངས་སུ་རྒྱ་ཆེ་བའི་སྐར་ཚོགས་གྲངས་ལས་འདས་པ་འདུས་ཡོད་པའི་གནས་ཚུལ་འཚོལ་རྙེད་བྱུང་བ་ནས་བཟུང་།",
    "ཚན་རིག་པ་ཚོས་དགུ་ཚིགས་སྐྱ་མོའི་ཕ་མཐར་ཆོད་པའི་སྐར་ཚོགས་གཞན་འཚོལ་སྒྲུབ་མ་བྱུང་གོང་གི་མི་ལོ་༣ ཙམ་གྱི་ཡར་སྔོན་གྱི་གྷ་ལེ་ལི་འོ་ཡི་དུས་ནས་ཀྱང་གནམ་རིག་གི་ཚན་རིག་དར་རྒྱས་ཕྱིན་ཡོད།",
    "༡༩༢༣ ནས་༡༩༢༤ ལོ་བར་དེ་འདྲའི་རྟོག་ཞིབ་གཅིག་མཇུག་གཉིས་མཐུད་བྱུང་བ་ལ་བརྟེན་ནས་ཨ་རིའི་གནམ་རིག་པ་ཨེ་ཌ་ཝེན་པོ་ཝེལ་ཧཱ་སྦལ་གྱིས་ཝེལ་སེན་རི་བོའི་རྩེ་མོར་སོར་དོ་བརྒྱ་ཅན་གྱི་རྒྱང་ཤེལ་གསར་འཛུགས་བྱས་ཏེ།",
    "སྔར་ནུས་ཤུགས་ཆུང་བའི་རྒྱང་ཤེལ་སྤྱད་ནས་མཐོང་བའི་བ་སྤུ་ལྟ་བུའི་སྐར་སྤྲིན་རྣམས་ང་ཚོའི་འཇིག་རྟེན་ཁམས་ཀྱི་དགུ་ཚིགས་སྐྱ་མོའི་ཆ་ཤས་མ་ཡིན་པར་རྒྱང་ཐག་ཆོད་པའི་དགུ་ཚིགས་གཞན་ཡིན་པའི་ཐེ་ཚོམ་བསལ་ཡོད།",
    "༡༩༦༥ ལོར་བར་སྣང་ཕྱི་མའི་འོད་ཟེར་ཁྱབ་འགྱེད་བྱེད་ཚུལ་འཚོལ་རྙེད་བྱུང་བས་གོང་གི་རྣམ་གཞག་ཁག་ལ་མྱོང་བ་ཐོན་པའི་རྒྱབ་རྟེན་བྱས་ཡོད།",
    "དེང་སྐབས་སྤྱི་ལོ་༢༣ ནས་༢༤ ལོའི་བར་ཧྭ་སྦལ་གྱི་རྒྱང་ཤེལ་མཉམ་སྦྱར་བྱས་པའི་བར་སྣང་གི་གཏིང་མཐའ་ཆོད་པའི་འཇིག་རྟེན་འཕུར་གྲུ་གསར་གཏོད་བྱས་ཏེ་འགྲོ་བ་མིས་ཞིབ་ཚགས་ངང་མཐོང་ཐུབ་པའི་འཇིག་རྟེན་ཁམས་ཀྱི་བརྙན་དཔར་བླངས་ཡོད།",
    "སྐར་ཆ་ས་ཡ་གཅིག་གི་དུས་ཡུན་སྤྱད་དེ་སའི་གོ་ལའི་གཡས་གཡོན་ནས་ཧཱ་སྦལ་གྱི་འཁོར་ལམ་གྲངས་༤ ཙམ་ནས་ཧ་ཅང་རྒྱ་ཆེ་བའི་སེམས་ཀྱི་ཁྱབ་ཡུལ་ལ་དཔྱོད་པ།",
    "ནམ་མཁའི་ཟླ་བ་ཉ་གང་མའི་ཚངས་ཐིག་བཅུ་ཆ་གཅིག་ཙམ་གྱི་བར་སྣང་གི་རྒྱ་ཁྱོན་ལ་གཞིགས་ཏེ་ཚན་རིག་པ་རྣམས་ཀྱིས་དགུ་ཚིགས་ཁྲི་གཅིག་ཙམ་མཐོང་ཐུབ་པ་དང་།",
    "དེ་འདྲའི་རྟོག་ཞིབ་བརྒྱུད་ནས་དགུ་ཚིགས་ཀྱི་འབྱུང་ཁུངས་དང་དེ་དག་འཕེལ་འགྱུར་ཇི་ལྟར་ཕྱིན་པའི་སྐོར་ལ་ངེས་ཤེས་གསར་པ་ཞིག་ཡོང་རྒྱུར་ཚན་རིག་པ་རྣམས་རེ་སྒུག་བྱེད་བཞིན་པའི་སྒང་ཡིན།",
    "ཁོང་ཚོ་ནི་འཆར་སྒོའི་ནུས་ཤུགས་ལ་བརྟེན་ནས་སེམས་ཁམས་ཐོག་བརྟག་དཔྱད་བྱེད་མཁན་ཐོག་མའི་གྲས་ཡིན།",
    "འོན་ཀྱང་སྐབས་དེར་བྱུས་ཉེས་ཆེ་ལ་སེམས་འཆོལ་ཏེ་བདུད་མོ་འཚོལ་འཕུད་བྱེད་པའི་དུས་ཚོད་ཐབས་སྡུག་ཅིག་ཡིན།",
    "གནམ་རིག་སྐར་དཔྱད་ཀྱི་རྟོག་ཞིབ་ཀུན་ལ་ཆ་རྐྱེན་དེ་ཚང་གི་མེད།",
    "དཔེར་ན་ཟླ་བ་གཅིག་པུའི་གནས་ཚུལ་དངོས་དེ་ང་ཚོས་རྟོག་ཞིབ་བྱེད་པའི་སྐབས་ཀྱི་སྐར་ཆ་གཅིག་གི་སྔ་རོལ་དུ་ཡིན་པ་དང་།",
    "དེ་ལྟར་ཉི་མ་དང་གཟའ་སྐར་གཞན་གྱི་གནས་ཚུལ་དངོས་ནི་ང་ཚོའི་རྟོག་ཞིབ་ལས་སྐར་མ་འགའི་སྔ་རོལ་དུ་ཡིན་པ་དང་།",
    "ང་ཚོ་དང་རྒྱང་ཐག་ཆོད་པའི་དགུ་ཚིགས་དེ་ཚོའི་ཤེས་བྱ་ནི་ལོ་ངོ་ཐེར་འབུམ་གྱི་སྐོར་ཡིན།",
    "ང་ཚོའི་ཉེ་འགྲམ་གྱི་ཁ་དོག་དང་སྒྲ་སོགས་ཀྱི་མཐོང་སྣང་དང་ཐོས་སྣང་ཀུན་ཀྱང་ཡུལ་དངོས་ཀྱི་བྱུང་བ་ལས་ཕྲན་བུ་རྗེས་ལུས་ཡིན།",
    "གནས་ཚུལ་དེ་རིགས་ང་ཚོ་གཉིད་ཁུག་པ་དང་སད་པའི་སྐབས་སུ་ཤར་སྲིད་པ་ཡིན།",
    "དཔེར་ན་གང་ཟག་སུ་རུང་ཞིག་གིས་ཧ་ཅང་དྭངས་བའི་རྨི་ལམ་ནང་རང་ཉིད་གཉིད་ཁུག་ཡོད་པ་ཚོར་བཞིན་དུ་རྨི་ལམ་གྱི་བྱུང་རིམ་མ་བསྒྱུར་བའི་སྒོ་ནས་རྟོག་ཞིབ་ཡོང་གི་ཡོད།",
    "དེས་ཚན་རིག་གི་གསར་བརྗེ་ཚུགས་པ་ནས་གཙོ་འགངས་ཆེ་བའི་ཆ་ཤས་མང་པོ་བླངས་ཡོད།",
    "༡༦༢༣ ལོར་ཧྥེ་ལེ་ལིའོ་ཡིས་སྙན་གྲགས་ཆེན་པོའི་སྒོ་ནས་ལྟ་གྲུབ་དེ་ཁོང་གི་བརྗིད་ཉམས་དོད་པའི་དཔེ་དེབ་འཇིག་རྟེན་ཁམས་ཞེས་པ་དེའི་ནང་བྲིས་ནས་ང་ཚོའི་མིག་ངོར་རྟག་ཏུ་སྒོ་མོ་ཕྱེ་ནས་བཞག་ཡོད།",
    "སྤྱིར་བཏང་ས་སྨྱུག་གིས་ནག་པང་སྟེང་དུ་རྩིས་གཞི་འགོད་པ་ནི་དམངས་ཀྱི་སྤྱོད་ཚུལ་ཞིག་ཡིན་མོད།",
    "པའི་གང་ཟག་གིས་རྩིས་གཞི་འགའ་ཞིག་ཇི་ལྟར་འབྲི་ཚུལ་སྦྱངས་ཡོད་སྲིད་ཀྱང་།",
    "སེམས་ཀྱི་སྟེང་དུ་ཤེས་ཚོར་དང་ཤེས་ཚོར་བྲལ་བའི་གཡོ་འགུལ་འདྲ་མིན་ཤར་གྱི་ཡོད་པ་དེ་དག་གིས་སྐབས་རེ་དྲན་པ་དང་།",
    "མྱོང་ཚོར།",
    "སེམས་ཁམས་རིག་པ་བ་རྣམས་ལ་སེམས་ཀྱི་འཛིན་སྟངས་དེ་བསམ་བློའི་རེ་སྒུག་གི་བྱེད་ལས་ཤིག་ཡིན་པའི་ཁུངས་སྐྱེལ་མང་དག་ཅིག་ཡོད་པ་དང་།",
    "བློ་ཁ་ནང་གཏད་ཀྱི་འཛིན་ཚུལ་དེ་ཡང་བསམ་བློའི་རེ་སྒུག་ལས་ཐ་དད་དུ་ཡོད་པ་ཞིག་མ་ཡིན།",
    "གྲུབ་ཆ་དེ་དག་གིས་ང་ཚོར་ཡུལ་གྱི་རྣམ་པ་བྱེ་བྲག་སོ་སོར་སྣང་གི་ཡོད་ལ།",
    "སེམས་ཀྱི་གནས་ཡུལ་ནང་བཅོས་མའི་འཆར་སྣང་དང་བདེན་པ་གཉིས་རྟག་ཏུ་གཅིག་མཚུངས་སུ་ཡོང་གི་མེད།",
    "ལྷག་པར་དུ་སྦས་དོན་ཅན་དང་གོ་བརྡ་སྤྲོད་པའི་བརྒྱུད་རིམ་ཕྲ་མོ་རྣམས་བརྒྱུད་སྐབས་རྟག་ཏུ་འཆར་སྣང་དང་བདེན་པ་གཉིས་གཅིག་མཚུངས་ཤིག་ཡོང་གི་མེད།",
    "གལ་ཏེ་ང་ཚོས་བྷེ་ཀོན་ལུགས་ཀྱི་རྗེས་སུ་འབྲང་སྟེ་མྱོང་འདྲིས་ལ་ཕབ་པའི་སྒོ་ནས་ཡུལ་ཅན་གྱི་མྱོང་བར་བརྟག་ན།",
    "སེམས་མཐོང་བའི་རྒྱང་ཤེལ་གསར་གཏོད་བྱེད་ཚུལ་ཐད་ང་ཚོ་སྔར་བཞིན་རྗེས་ལུས་ཡིན།",
    "དེ་ལྟར་ངས་དུ་མས་གྲུབ་པའི་བསམ་ཚུལ་དེ་སྔ་ན་མེད་པའི་དེང་རབས་ཚན་རིག་གི་ལག་ལེན་དངོས་དང་རྣམ་གཞག་ཐོག་བློ་ཁ་ནང་གཏད་ཀྱིས་དཔྱད་པ་གཏོང་ཚུལ་དེ་ཡ་མ་འབྲལ་བ་ཞིག་དགོས་པའི་དགོས་འདུན་འདོན་བཞིན་ཡོད།",
    "ལྷག་པར་དུ་ང་ཚོའི་སེམས་ལ་ཡོངས་སུ་གོམས་པའི་ཁོང་ཁྲོ་དང་བྱིང་རྨུགས་སོགས་ནི་དམིགས་པ་རྩེ་གཅིག་གི་བསམ་གཏན་བསྒྲུབ་པར་བརྒྱུད་ནས་སྤོང་དགོས་ཤིང་།",
    "ཉམས་ལེན་དེ་དག་ལོགས་སུ་བློ་སྦྱོང་གི་རིམ་པའི་ནང་ཤུགས་ཆེར་གསལ་ཡོད།",
    "ཚན་རིག་གི་དོགས་ཟོན་རིང་ལུགས་བཅས་ཀྱི་རྟེན་གཞིའི་ཐོག་ཚན་རིག་པ་རྣམས་ཀྱིས་འཚོལ་རྙེད་གང་བྱུང་བ་ཚང་མར་འགན་ཁུར་ཁས་ལེན་བྱེད་པ་ལྟར།",
