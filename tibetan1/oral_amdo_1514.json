    "ཁྱི་དང་བྱི་ལས་མ་རེག་ཅིང་སུས་ཀྱང་མི་འགོང་པ་བྱ།",
    "སྐུ་སྨད་དུག་གི་ཕུར་བུ་འབར།",
    "ཨོཾ་བཛྲ་ཀྲོ་དྷ་ཀྲོ་དྷཱི་དུནྡྷུ་བྷི་ནཱ་ད་གརྫ་ཡ་ཧཱུྃ་ཕཊ་ཅེས་རྔ་དང་ཌཱ་རུ་རྡུང་ཞིང་རོལ་མོ་རྒྱ་ཆེར་བྱའོ།",
    "ཁྱད་པར་བསྙེན་སྒྲུབ་སྐབས་མེད་ཐབས་མེད་པ་ཡིན་མོད།",
    "འཇམ་དཔལ་ལས་ཀྱི་གཤིན་རྗེ་ཁྲོ་ཆུ་དུག་གདོང་གི་ལས་བྱང་རྒྱས་པར་ལྷན་ཐབས་སུ་སྦྱར་རྒྱུ་སྲུང་གུར་དང་མངོན་རྟོགས་རྒྱས་པ་བཞུགས་སོ།",
    "ན་མོ་གུ་རུ་མཉྫུ་ཤྲཱི་ཀྲོ་དྷ་ཡ་མཱནྟ་ཀ་ཙ་ར་ཎཱ་ཡ།",
    "འཇམ་དཔལ་རིགས་གསུམ་ཁྲོས་པ་ཁྲོ་ཆུ་དུག་གདོང་གི་ལས་བྱང་རྒྱས་པ་སྣང་སྲིད་ཀུན་འཇོམས་ཀྱི་ལྷ་བསྐྱེད་སྐབས་སུ་སྲུང་གུར་རྒྱས་པ་དང་མངོན་རྟོགས་ཚིག་རིས་རྒྱས་པ་སྦྱར་བར་འདོད་ན།",
    "དེའི་རྒྱབ་ཏུ་འོད་ཟེར་དཀར་པོའི་གུར་ཁང་གི་ནང་དུ་འཇམ་དཔལ་གཞོན་ནུ་སྤྲུལ་པའི་སྐུ་ཁྲོ་བོ་དཀར་པོ་ཞལ་གསུམ་ཕྱག་དྲུག་པ།",
    "དེའི་རྒྱབ་ཏུ་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པའི་གུར་ཁང་གི་ནང་དུ་མི་བསྐྱོད་པ་སྔོན་པོ་རྡོ་རྗེ་དང་དྲིལ་བུ་བསྣམས་པ་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ་དཔག་ཏུ་མེད་པ་ཞལ་ནང་དུ་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་འཁོར་ལོ་དཀར་པོའི་གུར་ཁང་གི་ནང་དུ་རྣམ་པར་སྣང་མཛད་དཀར་པོ་འཁོར་ལོ་དང་དྲིལ་བུ་བསྣམས་པ་དཔག་ཏུ་མེད་པ་ཞལ་ནང་དུ་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་པདྨ་དམར་པོའི་གུར་ཁང་གི་ནང་དུ་འོད་དཔག་མེད་དམར་པོ་པདྨ་དང་དྲིལ་བུ་བསྣམས་པ་དཔག་ཏུ་མེད་པ་ཞལ་ནང་དུ་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་རྒྱ་གྲམ་ལྗང་གུའི་གུར་ཁང་གི་ནང་དུ་དོན་ཡོད་གྲུབ་པ་ལྗང་གུ་རྒྱ་གྲམ་དང་དྲིལ་བུ་བསྣམས་པ་དཔག་ཏུ་མེད་པ་ཞལ་ནང་དུ་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་ཆུའི་གུར་ཁང་སྔོན་པོའི་ནང་དུ་མཱ་མ་ཀི་སྔོན་མོ་རྡོ་རྗེ་རྩེ་ལྔ་པ་འཕྱར་ཞིང་ཨུཏྤལ་སྔོན་པོའི་ཞགས་པ་འཛིན་པ་གྲངས་མེད་པ་ཞལ་ནང་དུ་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་མེའི་གུར་ཁང་དམར་པོའི་ནང་དུ་གོས་དཀར་མོ་དམར་མོ་པདྨ་དམར་པོ་དང་པདྨའི་ཞགས་པ་འཛིན་པ་གྲངས་མེད་པ་ཞལ་ནང་དུ་གཟིགས་པ།",
    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་སེང་ཁྲི་པད་ཟླ་ལ་བཞུགས་པ།",
    "ཐམས་ཅད་ཞལ་ནང་དུ་གཟིགས་པ།",
    "དུག་གི་འོད་ཟེར་འཇའ་ཚོན་ལྟ་བུ་འཕྲོ་བ།",
    "དུག་གི་རླངས་པ་སྔོ་དམར་དུག་སྦྲུལ་བྱེ་བའི་ཁ་རླངས་ལྟར་འཕྱོ་ཞིང་དུག་གི་མེ་དཔུང་དམར་ནག་བསྐལ་པ་འཇིག་པའི་མེ་ལྟར་འབར་བ།",
    "གཟུགས་ཅན་དང་གཟུགས་མེད་གང་གིས་ཀྱང་ཐོས་ཤིང་དྲན་པ་ཙམ་ཡང་མི་བཟོད་པའི་རང་བཞིན་ཅན།",
    "ཐམས་ཅད་ཀྱི་ཕྱག་གིས་གནམ་ལྕགས་ཀྱི་མདའ་གཞུ་འགེངས་པ།",
    "ཞལ་ཕྱིར་གཟིགས་ནས་བཟློག་པ་དང་བསད་པའི་ལས་མཛད་པ།",
    "དེའི་རྒྱབ་ཏུ་བེ་ཅོན་གྱི་གུར་ཁང་སྒོང་དབྱིབས་ཀྱི་ནང་དུ་སྐུ་འཇམ་དཔལ་གཤིན་རྗེའི་གཤེད་ཀྱི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་གྲངས་མེད་པ་ཞལ་ཕྱིར་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་ཁ་ཊྭཱྃ་གྱི་གུར་ཁང་གི་ནང་དུ་ཐུགས་ཡང་དག་ཧེ་རུ་ཀའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་གྲངས་མེད་པ་ཞལ་ཕྱིར་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་རྡོ་རྗེ་རྩེ་ལྔ་པའི་གུར་ཁང་གི་ནང་དུ་ཡོན་ཏན་བདུད་རྩིའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་གྲངས་མེད་པ་ཞལ་ཕྱིར་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་ཕུར་བུའི་གུར་ཁང་གི་ནང་དུ་ཕྲིན་ལས་རྡོ་རྗེ་གཞོན་ནུའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་གྲངས་མེད་པ་ཞལ་ཕྱིར་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་མདུང་གི་གུང་ཁང་གི་ནང་དུ་དྲེགས་པ་ཀུན་འདུལ་འཇིག་རྟེན་མཆོད་བསྟོད་ཀྱི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་གྲངས་མེད་པ་ཞལ་ཕྱིར་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་མདའི་གུར་ཁང་གི་ནང་དུ་སྟོབས་ལྡན་ནག་པོ་དམོད་པ་དྲག་སྔགས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་གྲངས་མེད་པ་ཞལ་ཕྱིར་གཟིགས་པ།",
    "དེའི་རྒྱབ་ཏུ་རྡོ་རྗེའི་གྲི་གུག་ངར་མ་གཡས་གཡོན་དུ་འཁོར་ཞིང་སོ་འཐབ་པའི་བར་དུ་བདུད་དགྲ་བྱད་མ་ཐམས་ཅད་དམར་ཉིལ་ཉིལ་དུ་གཏུབས་པའི་གུར་ཁང་གི་ནང་དུ་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཆེན་པོ་ཞལ་དགུ་ཕྱག་སོ་བཞི་ཞབས་བཅུ་དྲུག་དང་ལྡན་པ་གྲངས་མེད་པ་ཞལ་ཕྱིར་གཟིགས་ཤིང་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་ལྷ་ལ་བསྡིགས་པར་མཛད་ཅིང་ཁམས་གསུམ་ཟ་བ།",
    "གནམ་ལྕགས་ཐོག་གི་ཚྭ་ཚྭ་དྲག་པོ་སེར་ལྟར་དུ་འབེབས་པས་དགྲ་གེགས་མ་རུངས་པ་ཐམས་ཅད་བརླག་པར་བྱེད་པ།",
    "དེའི་རྒྱབ་ཏུ་ནང་ཐོད་རློན་བར་ཐོད་རྙིང་ཕྱི་ཐོད་སྐམ་བརྩེགས་པའི་གུར་ཁང་སྒོང་དབྱིབས་བར་མཚམས་ཐམས་ཅད་ཁྲག་ཞག་གི་སྤྱིན་གྱིས་བསྡམས་པ།",
    "ཁྲག་གི་རྒྱ་མཚོ།",
    "ཞིང་སྐྱོང་དང་མཁའ་འགྲོ་དང་མ་མོ་དང་སྲི་མོ་རྣམས་ཀྱིས་ལས་སྣ་ཚོགས་སྒྲུབ་པ།",
    "དུར་ཤིང་རེག་ཕུང་།",
    "དེའི་རྒྱབ་ཏུ་རྡོ་རྗེ་འཁོར་ལོ་གྲི་གུག་རལ་གྲི་སྤུ་གྲི་ལྕགས་ཀྱུ་རྩེ་གསུམ་ཁ་ཊྭཱྃ་མདུང་ཐུང་མདུང་རིང་དགྲ་སྟ་ཐོ་བ་དབྱུག་ཏོ་བེ་ཅོན་མདའ་དང་མདའ་བོ་ཆེ་སོགས་མཚོན་ཆ་སྣ་ཚོགས་རབ་ཏུ་རྣོ་ཞིང་དུག་གི་ངར་དང་ལྡན་པ་དཔག་ཏུ་མེད་པ་རྩེ་མོ་ཕྱིར་བསྟན་པས་སྟེང་འོག་ཕྱོགས་མཚམས་ཐམས་ཅད་བར་མཚམས་མེད་པར་གཏམས་པའི་གུར་ཁང་སྒོང་དབྱིབས་མཚོན་ཆ་སྣ་ཚོགས་ཀྱི་ཆར་ཆེན་པོ་གནོད་བྱེད་ཀྱི་སྟེང་དུ་རྒྱུན་མི་ཆད་པར་འབེབས་པ།",
    "དེའི་ཕྱི་རོལ་དུ་དུག་གི་མེ་དཔུང་ཁ་དོག་ལྔ་ལྡན་བསྐལ་པ་བསྲེག་པའི་མེ་ལྟར་འབར་བ་གཡས་སུ་འཁྱིལ་ཞིང་དུམ་བུ་གཅིག་ཏུ་གྱུར་པའི་གུར་ཁང་ཆེན་པོ་ལས་མེའི་ཚྭ་ཚྭ་འཕྲོ་བས་གཟུགས་ཅན་དང་གཟུགས་མེད་ཀྱི་གནོད་བྱེད་ཐམས་ཅད་གཞོབ་ཐུལ་གྱིས་བསྲེག་པ།",
    "འདོད་ཆགས་དུག་གི་ཆུ་བོ་འོག་གི་རྒྱ་མཚོ་ལྟར་འཁྲུགས་པ།",
    "ཞེ་སྡང་དུག་གི་མེ་ཆེན་དུས་མཐའི་མེ་ལྟར་འབར་བ།",
    "གཏི་མུག་དུག་གི་རླངས་པ་མུན་པ་ལྟར་འཐིབས་པ།",
    "འཇམ་དཔལ་དྲག་ཏུ་ཁྲོས་པ་ཁྲོ་ཆུ་དུག་གདོང་ནག་པོའི་སྐུར་སྐད་ཅིག་གིས་རྫུས་སྐྱེས་སུ་བཞེངས་པ་ནི།",
    "དགྲ་གེགས་བྱད་མ་མོ་རྒྱུད་ཚོགས་རྣམས་ནི།",
    "ཁ་རླངས་དུག་གི་སྤྲིན་ཕུང་གཡོ་ཞིང་འཐིབས།",
    "འབར་བའི་སྤྱན་དགུ་གཟིགས་པས་བགེགས་དཔུང་བསྲེགས།",
    "འབར་ཞིང་འཁྱིལ་ལས་ཧཱུྃ་གི་སྒྲ་ཆེན་སྒྲོག།",
    "མཚོན་ཆའི་བུ་ཡུག་དུག་གི་ཐོག་སེར་འཕྲོ།",
    "དྲེགས་པ་མོ་རྒྱུད་ཐམས་ཅད་དམྱལ་ཐག་གཅོད།",
    "འབྲུག་སྟོང་ལྡིར་ཞིང་དུག་གི་ཐོག་སེར་འབེབས།",
    "དུག་ཁྲག་ངར་ལྡན་རྩེ་མོ་རབ་རྣོ་བས།",
    "ཕུར་པའི་རྩེ་མོས་དམྱལ་ཁམས་བཅོ་བརྒྱད་གཟིར།",
    "སྐུ་ཡི་ཁྱོན་གྱིས་སྟོང་གསུམ་འཇིག་རྟེན་གང་།",
    "ལྟོ་བར་སྲིད་པ་སུམ་ཅུ་རྩ་གཅིག་གི།",
    "ཐལ་ཚོམ་ཁྲག་ཐིག་ཞག་གི་བྱུག་པས་སྤྲས།",
    "དབུ་རྒྱན་སྙན་རྒྱན་མགུལ་རྒྱན་སེ་མོ་དོ།",
    "བ་སྤུ་དུག་གི་ཚེར་མ་གཟེངས་པ་ལས།",
    "ཁྲོ་ཆུང་གནམ་ལྕགས་དུག་གི་སེར་བ་འབེབས།",
    "སྐུ་ཡི་ཆ་ལས་དུག་གི་འོད་ཟེར་ནི།",
    "གསང་ཡུམ་གསང་བ་དུག་ཏིག་ནག་མོ་ནི།",
    "ཁྲོ་མོའི་ཆས་རྫོགས་ཞབས་གཉིས་ཡབ་ལ་འཁྲིལ།",
    "ཡབ་ཡུམ་སྐུ་ལས་ཁྲོ་བོ་ཁྲོ་མོ་འཕྲོ།",
    "མེ་མཚོན་དུག་གི་ཐོག་སེར་དྲག་པོ་འབེབས།",
    "དུག་གི་མེ་དཔུང་དམར་ནག་དྲག་འབར་བ།",
    "ལྗགས་འདྲིལ་དུག་གི་ཁ་རླངས་མུན་ནག་གཡོ།",
    "རལ་པ་ཁམ་ནག་སྲིད་པའི་རྩེ་མོར་བསྐྱོད།",
    "གཡོན་པས་དམ་ཉམས་ཙིཏྟ་དྲོན་མོ་བསྣམས།",
    "དུག་གི་ཁ་རླངས་དུས་མཐའི་སྤྲིན་ལྟར་གཡོ།",
    "སྤྱན་དགུ་ཉི་འབུམ་ལྟར་འབར་སྡང་མིག་གཟིགས།",
    "སྐུ་སྐྱེས་དུག་གི་མེ་ཕུང་དམར་ནག་གིས།",
    "གདུག་པ་མ་ལུས་ཐལ་བར་སྲེག་པར་བྱེད།",
    "ཡབ་བཞིའི་ཕྱག་གིས་བེ་ཅོན་འཁོར་ལོ་བསྣམས།",
    "ཕྱོགས་ཀྱི་རྩིབས་བཞིར་ནང་གི་གཤེད་བཞི་ནི།",
    "དུང་མོན་སེང་མགོ་མོན་མོ་བླ་རྐུན་མ།",
    "བསྭེ་མོན་དྲེད་མགོ་མོན་མོ་ཁྲག་རལ་མ།",
    "ལྕགས་མོན་སྟག་མགོ་གཡུ་ཡི་རལ་ཅན་མ།",
    "ཡུམ་བཞི་ནག་མོ་ཆུ་གྲི་ཐོད་ཁྲག་ཐོགས།",
    "དེ་གསུམ་ཡུམ་ནི་རེ་མ་ཏི།",
    "ཞལ་ནས་དུག་གི་རླངས་པ་འཕྱོ།",
    "ཁྲོ་མོའི་ཆ་ལུགས་ཡོངས་སུ་རྫོགས།",
    "ནུབ་ཏུ་མ་མོ་ནག་མོ་བརྒྱད།",
    "ཡུམ་ནི་ལྷ་མོ་རེ་ཏི་ནག།",
    "ལས་བྱེད་མོན་པ་ཕོ་དྲུག་ནག།",
    "མོ་གཤེད་སུམ་བརྒྱ་དྲུག་ཅུ་ནི།",
    "ལྕགས་ཁྲོ་དུག་གི་སྦྲང་བུ་ནི།",
    "གཞན་ཡང་སྟེང་གི་ནམ་མཁའ་ལ།",
    "བཤན་དམར་མི་བདུད་གཏེར་སྲུང་ཚོགས་རྣམས་ལ།",
    "སྤྲོ་ན་ཤྭ་ལོ་ཀ་རེའི་མཚམས་སུ།",
    "མ་ཧཱ་པཉྩ་ཨ་མྲྀ་ཏ་ཁ་རཾ་ཁཱ་ཧི།",
    "ལྷ་རྣམས་ཡོངས་ཀྱིས་ཁྱོད་ལ་མངའ་གསོལ་ཕྱིར།",
    "དབུ་སྐྲ་ཁམ་ནག་སྲིད་པའི་རྩེ་མོར་འབར།",
    "བྱད་མ་རྦོད་གཏོང་བཟློག་པར་གཤིན་རྗེ་མ་མོ་ལྷ་སྲིན་ལས་ལ་འགྱེད།",
    "ཐུན་མོང་མཆོག་གི་དངོས་གྲུབ་སྩལ་དུ་གསོལ།",
    "རེམས་ཤིག་འཆི་བདག་གཤིན་རྗེའི་ཚོགས།",
    "དགྲ་ལ་རྨུགས་རེངས་འཐིབ་གསུམ་ཐོངས།",
    "ད་དགྲ་ལག་གིས་ལེན་པ་དང་།",
    "ན་མོ་གུ་རུ་ས་ག་ཏ་ཤཱནྟ་ཀྲོ་དྷེ་བྷྱ",
    "བཀའ་སྲུང་གཏེར་སྲུང་གི་གཏོར་འབུལ་རྒྱས་བསྡུས་གང་འགྲུབ་བཅས་གྲུབ་ནས་བཤགས་ཡུལ་གསལ་གདབ་པ་ནི།",
    "ཀུན་ཏུ་བཟང་མོ་གསང་བའི་བྷ་ག་ལ",
    "སྣང་སྲིད་རྣམ་དག་ལྷ་དང་ལྷ་མོའི་དབྱིངས",
    "མཁའ་དབྱིངས་ཀློང་ཡངས་པད་མོ་འཁྱིལ་བ་ལ",
    "རྡོ་རྗེ་ལྷ་མོ་ཚོགས་རྗེ་ཚོགས་ཀྱི་བདག",
    "རྡོ་རྗེ་གདུང་འཚོབ་རྣལ་འབྱོར་བདག་ཅག་གིས",
    "ཉམས་དང་ཚོགས་འདྲེས་ཉམས་པ་བསྐང་བ་དང་",
    "ཉམས་དང་འགྲོགས་ཤིང་ཉམས་པ་དེ་དག་གིས",
    "ངག་ཡིད་ཐུན་མོང་གི་ཉམས་ཆག་བཤགས་པའོ།",
    "ན་མོ",
    "གཉིས་པ་ངག་གི་ཉམས་ཆག་བཟླས་པས་བཤགས་པ་ནི།",
    "བདག་གི་སྤྱི་བོར་པད་ཟླའི་སྟེང་།",
    "བྱམས་མགོན་ཐུགས་རྗེའི་ལྷ་ཁྱོད་དགོངས་སུ་གསོལ",
    "གཏི་མུག་མུན་འཐིབས་བདག་གི་ཤེས་རབ་ལྡོང་",
    "འདི་འདྲའི་སྡུག་བསྔལ་བདག་གིས་བཟོད་དཀའ་ཞིང་",
    "སྐྱེས་པས་འགྱོད་དོ་ལོག་ལམ་ཡི་རེ་ཆད",
    "རྣམ་སྨིན་ཐམས་ཅད་རང་གི་ལས་ལས་བྱུང་",
