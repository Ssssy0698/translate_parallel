    "ཅིག་ཤོས་ཀྱི་རྣམ་པར་དབྱེ་བ་མེད་པ་དེའི་ཕྱིར་ཐོབ་པར་བྱ་བ་ལྐོག་ཏུ་གྱུར་པ་རྟོག་ན་འཁྲུལ་པ་ཅིག་ཤོས་ཀྱི་རྣམ་པར་དབྱེ་བར་འགྱུར་བ་ཡིན་ནོ།",
    "གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ལྐོག་ཏུ་གྱུར་པ་མ་རྟོགས་པར་ནི་མ་ཡིན་ཏེ།",
    "འཆད་པ་པོའི་ལོག་པར་རྟོག་པ་བསལ་བའི་དོན་དུ་ཚིགས་སུ་བཅད་པ་ཡང་འདོན་པ་ནི་དེ་ལྟར་རྟགས་དང་ཞེས་བྱ་བའོ།",
    "རྟགས་ཅན་གྱི་ཤེས་པ་བཞིན་དུ་དེ་ངེས་པར་བྱེད་པའི་རྟགས་ཀྱི་ཤེས་པ་ཡང་རྟགས་དེ་དང་འབྲེལ་པའི་ཕྱིར་དེ་ལ་མི་འཁྲུལ་བ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གལ་ཏེ་དོན་དང་འབྲེལ་པ་དང་ལྷག་པར་ཞེན་པ་དང་ཐོབ་པར་བྱེད་པ་ལ་སོགས་པ་ཡིན་ཡང་ཇི་ལྟར་འཁྲུལ་པ་ཡིན་ཏེ་འགལ་བའི་ཕྱིར་རོ་ཞེས་དོགས་ན།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་ལྷག་པར་ཞེན་པར་བྱེད་པར་རྟགས་དང་རྟགས་ཅན་གྱི་ཤེས་པ་དེ་ནི་རྟགས་ཅན་དེའི་ངོ་བོ་ཡིན་པའི་ཕྱིར།",
    "འཁྲུལ་པ་རྣམ་གཞན་བྱས་པ་ཡིན།",
    "རྟགས་དང་རྟགས་ཅན་བློ་ཞེས་ཐ་དད་པར་སྨོས་པ་དོན་མེད་དོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་སྟེ་ཡུལ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྟགས་ཅན་གྱིས་ཁྱད་པར་དུ་བྱས་པའི་རྟགས་ནི་མངོན་སུམ་ཉིད་ཀྱང་མ་ཡིན་ནོ་ཞེས་སྨོས་པ་ནི།",
    "དེའི་ཚེ་ཐུག་པ་མེད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "དེ་ལའང་ཞེས་གསུངས་ཏེ།",
    "དོན་དམ་པར་ཞེས་གསུངས་སོ།",
    "དུའི་ཞེས་གསུངས་སོ།",
    "དེ་བཟུང་བ་ཉིད་ཀྱང་དེ་དང་འབྲེལ་པར་བཟུང་བ་ཡིན་ནོ།",
    "དེ་ཉིད་རྟགས་ཀྱི་ཤེས་པ་ཡིན་ནོ་ཞེས་ངོ་ཤེས་པ་ལ་ཡང་ཞེས་གསུངས་སོ།",
    "དེ་ནི་སྤྱིའི་འཛིན་པ་རྗེས་སུ་དཔག་པ་ཡིན་ཞེས་འབྲེལ་ཏོ་གཞན་དུ་ཞེས་བྱ་བ་ནི་རྗེས་སུ་དཔག་པའི་རང་བཞིན་མ་ཡིན་པ་རྟགས་ཀྱི་ཤེས་པ་ཡིན་པར་རོ།",
    "དངོས་པོར་རྟོགས་པར་བྱ་བའི་དངོས་པོ་རྟོགས་པར་བྱ་བ་ལའོ།",
    "ཁྱབ་པར་བྱེད་པ་ཡང་དེའི་ངོ་བོའམ་རྒྱུ་ཡིན་པར་འགྱུར་རོ།",
    "ཁྱབ་པར་བྱ་བའི་སེམས་དེ་ཡང་ཁྱབ་པར་བྱེད་པ་དེའི་བློའི་རྒྱུ་ཡིན་ནོ།",
    "བྱེད་པ་བསྒྲུབ་པར་བྱ་བ་གཞན་དག་ཀྱང་སྲིད་དམ་སྙམ་ན་བསྒྲུབ་པར་བྱ་བ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་བསྒྲུབ་པར་བྱ་བ་ཡིན་སྙམ་ན།",
    "དེ་ཡང་ཞེས་བྱ་བ་སྟེ་ཁྱབ་པར་བྱ་བའི་སེམས་ཀྱང་ངོ།",
    "ངེས་པར་སྨྲ་བ་རྣམས་ཀྱི་དོན་གྱིས་ཞེས་བྱ་བ་མེད་པ་རྟོགས་པའི་རྣམ་པ་གཞན་མེད་པའི་ཤུགས་ཀྱིས་སོ།",
    "དམིགས་པར་རིགས་པ་ནི་ལྟར་རུང་བའོ།",
    "གལ་ཏེ་གཞན་གྱི་ལྟར་ན་རྣམ་པ་ཅི་ཞིག་ལྟར་མེད་པར་རྟོགས་པར་འགྱུར་བ་ཡིན་ན།",
    "མི་དམིགས་པ་ལས་གཞན་པའི་དགག་པ་ལ་ནི་འབྲེལ་པ་མེད་པར་ཡང་འགྱུར་གྱི།",
    "དགག་པར་བྱ་བ་གྲང་བ་དེའམ་དེའི་རྒྱུའི་སྟེ་བ་སྤུ་ལངས་པ་ལ་སོགས་པ་གང་ལ་རྒྱུ་གྲང་བ་དེ་དགག་པ་ལའོ།",
    "མི་དམིགས་པ་སྟོན་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དཔོག་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་དེ་མཐོང་བ་ལས་དེ་མེད་པར་ཇི་ལྟར་རྟོགས་དེ་དང་ནི་ཞེས་བྱ་བ་ནི་གྲང་བ་མེད་པ་དང་སྟེ་མེ་དང་གྲང་བ་མེད་པ་དག་ནི་ལྷན་ཅིག་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་ལ་མེ་དེ་ཡོད་པ་དེར་གྲང་བ་མེད་པར་འགྱུར་བ་ལནི་དེ་ག་ལས་ཞེས་བྱ་བའོ།",
    "ཅི་ཞེས་བྱ་བའི་རྣམ་པར་རྟོག་པ་གཉིས་བྱས་ནས་གལ་ཏེ་ཞེས་བྱ་བས་དང་པོ་སེལ་བའོ།",
    "ཁོང་པར་མཐོང་བ་ནི་སྣང་བ་མི་དམིགས་པ་སྟེ་འགལ་བ་འཛིན་པའི་དུས་ན་ཞུགས་པ་དེས།",
    "རྗེས་སུ་དཔག་པའི་ཞེས་གསུངས་ཏེ་རྟགས་ཀྱིའོ།",
    "གྲང་བ་ལ་སོགས་པ་དགག་པར་བྱ་བ་ལྐོག་ཏུ་གྱུར་པའོ།",
    "འོ་ན་ནི་འགལ་བ་འཛིན་པའི་དུས་ན་ཡོད་པའི་མི་དམིགས་པ་དྲན་པའི་ཡུལ་དུ་གྱུར་པ་ཉིད་མེད་པའི་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "འོ་ན་ཇི་ལྟར་འགལ་བ་དམིགས་པ་ལ་སོགས་པར་མི་དམིགས་པ་ལས་མེ་འགྲུབ་པ་ཇི་ལྟར་ཡིན་ཞེ་ན།",
    "འདི་ལས་ཞེས་བྱ་བ་ནི་འཆད་པར་འགྱུར་བའོ།",
    "དེ་ལྟ་ན་ཡང་མི་དམིགས་པ་སྒྲུབ་པར་བྱེད་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "གང་འཆད་པར་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "འདིར་ཡང་ཞེས་གསུངས་སོ།",
    "དེ་གཉིས་སྤུ་ལངས་པ་མེད་པའི་མཚན་ཉིད་ཀྱི་བསྒྲུབ་པར་བྱ་བ་གཅིག་ལ་འཇུག་པའི་ཕྱིར་རོ།",
    "གང་ཡང་འབྲེལ་པ་འཛིན་པའི་མངོན་སུམ་རྗེས་སུ་དཔག་པ་ཉིད་ལས་རྗེས་སུ་དཔག་པར་གྲུབ་པ་ན།",
    "རྗེས་སུ་དཔག་པ་མེད་པར་ཟློག་པར་བྱེད་པ་དེ་ཡང་མི་འཐད་དེ།",
    "མངོན་སུམ་ལས་རྗེས་སུ་དཔག་པར་བྱ་བ་ཐ་དད་པར་མེད་པ་ཡིན་ན།",
    "དེ་གྲུབ་ན་རྗེས་སུ་དཔག་པར་བྱ་བ་ཉིད་གྲུབ་པ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་ནི།",
    "གལ་ཏེ་དེ་ལྟ་ན་ནི་ཞེས་བྱ་བ་ནས་རྗེས་སུ་དཔག་པར་དངོས་པོའི་ཡུལ་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "གལ་ཏེ་དམིགས་པ་ཡོད་ན་དེའི་ཚེ་མི་དམིགས་པ་མེད་པར་འགྱུར་རོ་ཞེས་དོགས་པ་བསུ་བ་ནི།",
    "མི་དམིགས་པ་ཉིད་མེད་པ་ཡིན་པར་ཁས་ལེན་ན།",
    "མི་དམིགས་པ་ལས་མེད་པར་བསྒྲུབ་པོ་ཞེས་བྱ་བའི་ཕྱོགས་ཉམས་པར་འགྱུར་རོ་ཞེས་དོགས་པ་བསུ་བ་ནི་མེས་ཞེས་བྱ་བའོ།",
    "ཇི་ལྟར་དམིགས་པ་ལས་མེད་པ་ཉིད་ཐ་མི་དད་པ་དེ་བཞིན་དུ་གཞན་དམིགས་པའི་རང་བཞིན་གྱི་མི་དམིགས་པ་ལས་ཀྱང་ཐ་མི་དད་དེ་དེས་ན་ཐ་སྙད་ལས་མི་རྟོགས་པའི་བསྒྲུབ་པར་བྱ་བ་ནི།",
    "འོན་ཀྱང་དངོས་པོ་རྣམས་ཀྱི་མེད་པ་ཉིད་འགའ་ཞིག་ལས་བསྒྲུབ་པར་བྱ་བར་འདོད་པ་དེས་ན་དགག་པ་བརྗོད་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི།",
    "འོ་ན་འགལ་བ་དམིགས་པ་ལ་སོགས་པའི་དབྱེ་བ་ཇི་ལྟ་ཞེ་ན་སྦྱོར་བ་ཉིད་ཅེས་གསུངས་སོ།",
    "ཐམས་ཅད་དུ་ནི་ཞེས་གསུངས་ཏེ་རང་བཞིན་འགལ་ལ་སོགས་པ་དམིགས་པར་རོ།",
    "བསྒྲུབ་པར་བྱ་བས་གྱུར་པ་ཐ་སྙད་ཀྱི་ངོ་བོ་ཉིད་ཐ་དད་པ་མེད་པ་དེས་ན་ཁོངས་སུ་འདུས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ན་འགལ་བའི་འབྲས་བུ་དམིགས་པ་དེར་ཡང་བརྒྱུད་པ་ཁོ་ནས་གྲང་བ་ལ་སོགས་པ་མེད་པར་འགྲུབ་པ་ཡིན་ནོ།",
    "འགལ་བ་དེ་ཡང་ཐམས་ཅད་མཁྱེན་པ་མ་ཡིན་པ་ཉིད་ལ་སོགས་པའི་ཐབས་དང་འདི་ལྷན་ཅིག་ཏུ་འཇུག་པས་ཐབས་དང་བཅས་པར་བཀག་པར་ཏེ་བསྟན་པ་མེད་པར་རོ།",
    "དངོས་སུ་འགལ་བ་མེད་པའི་ཕྱིར་ན་དེའི་རྒྱུའི་སྒོ་ནས་ཚིག་དགག་པར་བྱ་བ་དང་འགལ་བ་མ་བསྟན་པ་དགག་པ་བརྗོད་པ་ནི་མི་འཐད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་སོགས་པ་འཆི་བའི་སེམས་ཉིད་ལ་སོགས་པ་གང་ཡིན་པ་དེས་ཀུན་མཁྱེན་དང་།",
    "དེ་མེད་པར་ནི་ཤེས་པ་མེད་པའོ།",
    "དེ་བཞིན་དུ་རིགས་པ་དང་ཚིག་དག་ཀྱང་བརྟག་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བར་ནི་མི་འཐད་དེ།",
    "ཐམས་ཅད་ཤེས་པ་ལ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་ནི་ཞེས་གསུངས་སོ།",
    "འོ་ན་མི་དམིགས་པ་དེ་ཉིད་ཐམས་ཅད་རིགས་པ་མེད་པར་གྲུབ་པ་ལ་བརྗོད་པར་བྱ་བའི་དེའི་ཁྱད་པར་ཅན་གྱི་སྨྲ་བ་ཉིད་ཀྱིས་ཅི་ཞིག་བྱ།",
    "དེ་བཞིན་དུ་གལ་ཏེ་ཞེས་བྱ་བ་ནི་གནས་སུ་ཡང་ཁྱད་པར་དུ་གྱུར་ན་ཞེས་འབྲེལ་ཏོ།",
    "མི་དམིགས་པ་ནི་དེ་ལྟ་བུ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "བལྟར་རུང་བའི་ཁྱད་པར་དང་བྲལ་བའོ།",
    "གལ་ཏེ་མི་དམིགས་པ་ཙམ་ལས་མེད་པར་མི་ངེས་ན་འོ་ན་ཡོད་པར་ངེས་པར་འགྱུར་རོ་ཞེས་དོགས་པ་བསུ་ནས་དེའི་ཕྱིར་ཞེས་གསུངས་སོ།",
    "མེད་པར་ངེས་པ་ཡིན་ནོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཞེས་བྱ་བ་ནི་གསལ་བར་རོ།",
    "སྨྲ་བ་པོ་གཞན་བཞིན་དུ་ཐམས་ཅད་མཁྱེན་པ་ཡང་རྟོགས་པས་འཇུག་པ་ཡིན་ཏེ།",
    "མ་བརྟགས་མ་དཔྱད་པར་ནི་ཚིག་མི་སྨྲ་བའོ་ཞེས་ལུང་ལས་གསུངས་པའི་ཕྱིར་རོ།",
    "བརྗོད་འཇུག་པར་གྱུར་ཏེ།",
    "སྔོན་གྱི་དུས་ན་ཡོད་པའི་བརྗོད་པར་འདོད་པ་གོམས་པ་ལས་བརྗོད་འཇུག་པ་ཞེས་བྱ་བ་ནི་ཕྱོགས་གཉིས་པ་ལའོ།",
    "དེའི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པ་དེ་ལ་རྣམ་པ་གཉིས་ཀ་ལྟར་ཡང་ཚིག་མེད་པར་ཇི་ལྟར་འགྱུར།",
    "གལ་ཏེ་མཐོང་བའི་དུས་ན་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར་ཇི་ལྟར་སྨྲ་སྙམ་ན་བསྒོམས་སྟོབས་ལ་ཞེས་བྱ་བའོ།",
    "ཉེ་བར་གནས་པའི་ཞེས་གསུངས་སོ།",
    "གཞན་གྱིས་ཐ་མི་དད་པར་སྒྲོ་བཏགས་པའི་འགལ་བ་ཡང་འགལ་བ་ཡིན་ནོ་ཞེས་བརྗོད་པ་ནི་ཐ་མི་དད་ལ་ཞེས་བྱ་བའོ།",
    "འགལ་བ་གཉིས་པོ་འདི་ཉིད་ཁྱད་པར་གྱི་མཐར་ཐུག་པར་བྱེད་པ་ནི་ཁ་བ་མེད་ལ་ཞེས་བྱ་བ་སྟེ་གྲང་བ་མེད་པའོ།",
    "དེ་དང་ཐ་མི་དད་པར་ཁས་བླངས་པའི་སྐྱེ་བ་ལ་ཡོད་པ་ཉིད་གནོད་པར་བྱེད་པ་ཡིན་པ་བཞིན་ནོ།",
    "ཅི་ཐ་དད་པ་མེད་པ་ལ་ལྷན་ཅིག་མི་གནས་པའི་མཚན་ཉིད་ཀྱི་འགལ་བ་ཡོད་ན་ཞེས་དོགས་ན་ཡོད་པ་དང་ཞེས་གསུངས་ཏེ།",
    "ཐ་དད་པ་ལ་འགལ་བ་ཉིད་མེད་པར་དོགས་པ་བསུ་བ་ནི་ཐ་དད་པ་མེད་པ་དག་ཅེས་བྱ་བའོ།",
    "བཟློག་པར་བྱ་བ་ནི་ལན་ནོ།",
    "མེད་པར་འགྱུར་བ་ནི་དེའི་ཚེ་དེ་གཉིས་བཟློག་པར་བྱ་བ་དང་ཟློག་པར་བྱེད་པ་ཡིན་པའི་མཚན་ཉིད་ཀྱི་འགལ་བ་དེ་མཐོང་བར་འགྱུར་རོ།",
    "འོ་ན་སྐྱེས་པ་ལ་ཡང་དེ་ཅི་ལྟར་མི་འཐད་སྙམ་ན་སྐྱེས་པ་ཡང་ཞེས་གསུངས་སོ།",
    "འོ་ན་གཞན་གྱིས་དུས་གཞན་དུ་འཇིག་པར་བྱེད་དོ་སྙམ་དུ་གཞན་གྱིས་དུས་སུ་ནི་ཞེས་གསུངས་སོ།",
    "འོན་ཀྱང་སྐད་ཅིག་ཡོད་པ་ཡིན་ལ་དེའི་འཇིག་པ་ཡང་སྐད་ཅིག་བརྒྱུད་པ་ཕྱི་མའི་གེགས་བྱས་པ་ལས་གཞན་མ་ཡིན་ནོ་ཞེས་དོགས་པ་བསུ་བ་ནི་གལ་ཏེ་ཕྱི་མའི་ཞེས་བྱ་བའོ།",
    "མེད་པ་ལ་ཡང་འགལ་བས་འབྲས་བུ་བཟློག་པར་མི་ནུས་ན།",
    "དེ་མ་ཐག་པའི་ཚིག་ལེའུར་བྱས་པའི་ཕྱེད་སྔ་མ་འཆད་པ་ནི་མ་ཚང་བ་ཞེས་བྱ་བའོ།",
    "དེའི་ཕྱིར་རྣམ་པར་དཔྱད་ན་ནི་འགལ་བ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་སྐབས་ཀྱི་དོན་ཏོ།",
    "བསྡད་ནས་བྱེད་པའི་རྒྱུ་དང་འབྲས་བུའི་ཁྱད་པར་ཉིད་འགལ་བ་ཡིན་ནོ་ཞེས་ལན་འདེབས་པ་ནི།",
    "ལྷན་ཅིག་བྱེད་པ་མེད་པའི་གྲང་བ་ནི་སྐྱེད་པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱེད་ཕྱི་མ་ཉིད་རྣམ་པར་འབྲེལ་པ་ནི་གྲང་བའི་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་དེའི་རྒྱུ་ནུས་པ་མེད་པས་སྐྱེད་པ་ལས་སྐྱེད་བྱེད་ཉིད་ཡིན་པའི་ཕྱིར་ཇི་ལྟར་ལྡོག་པར་བྱེད་པ་ཡིན་ཞེ་ན།",
    "དེས་བྱས་པ་ཞེས་སྨོས་ཏེ།",
