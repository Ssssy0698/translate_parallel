    "སྨྱུག་འཛིན་པ་དང་མི་གང་མང་ཞིག་གིས་ན་གཞོན་གསར་བ་ནི་སྔོན་གྱི་དགྱ་ནག་གི་ཚགས་ཤོག་ཅིག་གི་མིང་རེད།",
    "དེ་ནི་ལྔ་བཞིའི་ལས་འགུལ་སྐབས་ཀྱི་ཚགས་ཤོག་ཧ་ཅང་བཟང་ཤོས་དང་སྐབས་དེའི་དགྱ་ནག་མི་དམངས་ལ་འབོད་སྐུལ་གསར་བ་དང་སྔར་མེད་ཀྱི་གསོན་ཤུགས་གསར་བ་ཞིག་སྦྱིན་མྱོང་བའི་ཚགས་ཤོག་ཅིག་རེད།",
    "ངས་ཁ་སང་དེ་རིང་འུ་ཅག་གི་མིག་ལམ་དུ་བཀྲམ་པའི་ན་གཞོན་གསར་བ་ནི་ངེས་པ་དོན་གྱི་ན་གཞོན་གསར་བ་ཞིག་རེད་བསམ་གྱིན་ཡོད།",
    "ན་གཞོན་གསར་བ་ནི་གང་ཕྱོགས་ནས་ངེས་པ་དོན་གྱི་ན་གཞོན་གསར་བ་ཞིག་རེད་ཅེས་ན།",
    "ལྷག་པར་དུ་སྒང་བ་བོད་པ་ཚང་གི་མྱི་རབས་ཚ་རྒྱུད་དག་གི་བརྗེད་པར་དཀའ་བའི་ཐིག་བརྒྱད་ལོའི་དོན་རྐྱེན་དེའི་འོག་ནས།",
    "དགྱ་ནག་གི་ན་གཞོན་གསར་བའི་ཚགས་ཤོག་ལ་མཚོན་ནའང་།",
    "འུ་ཅག་གི་ད་ལྟ་མིག་ལམ་ན་ཡོད་པའི་ན་གཞོན་གསར་བ་ལས་ཐོད་བརྒལ་ཆེན་པོ་ཞིག་བྱས་མེད་པར་སྙམ།",
    "དགྱ་ནག་གི་ན་གཞོན་གསར་བའང་འཚོ་བ་དངོས་ཀྱི་ངོ་གདོང་ལ་ལངས་པའི་རྒྱུ་འབྲས་བློ་མིག་གི་བདེན་དོན་ཞིག་ལས་གང་ཡང་མིན་པ་བསམ།",
    "འུ་ཅག་ལའང་གཅེས་སྤྲས་དང་ངོམ་ཆོག་ཆོག་གི་ན་གཞོན་གསར་བ་ཞིག་ཡོད་འདུག་པ་མངོན་གསལ་དོད་པོ་རེད།",
    "ན་གཞོན་ནི་ཕ་མེས་ཡང་མེས་དག་གི་རིང་ནས་ཡོད་པའི་ཐ་སྙད་རྙིང་བ་ཞིག་ཡིན་མོད།",
    "ན་གཞོན་གསར་བ་ནི་དེ་འདྲ་ཞིག་ཁྱོན་ནས་མིན་པར་སེམས།",
    "ན་གཞོན་གསར་བ་ནི་མི་རིགས་དང་རྒྱལ་ཁབ་ཀུན་གྱི་དགོས་མཁོ་ཞིག་ལ་ངོས་འཛིན་བྱེད་དགོས་པ་ཞིག་རེད།",
    "ན་གཞོན་གསར་བ་ནི་སྡོམ་ཚིག་ཅིག་གི་འོག་ཏུ་ཡོད་པ་ཞིག་གཏན་ནས་མ་རེད།",
    "དེ་དག་གི་འཚོལ་སྙེག་དང་དམིགས་འདུན་ཡང་ཁ་ཁ་སོ་སོ་ཡིན་པ་རེད།",
    "འུ་ཅག་གི་ན་གཞོན་གསར་བ་ནི་གང་འདྲ་ཞིག་ལ་ངོས་འཛིན་དང་བསམ་བློ་གཏོང་དགོས་ཅེ་ན།",
    "ནས་ར་སྤྲོད་བྱེད་ཐུབ་ཞིག་རེད།",
    "ན་གཞོན་གསར་བ་ནི་ལོ་ཚོད་ཀྱི་སྟེང་ནས་ལྟ་ཆོག་པ་ཞིག་ཀྱང་མ་རེད།",
    "དེ་ནི་གཙོ་བོ་བསམ་བློའི་སྟེང་ནས་ངོས་འཛིན་དང་དབྱེ་ཞིབ་བྱེད་དགོས་པ་ཞིག་རེད།",
    "ན་གཞོན་གསར་བ་ནི་རྒན་དར་གཞོན་གསུམ་གྱི་བསམ་བློའི་མཐོ་རླབས་ཀྱི་དར་ཆ་ཞིག་ཡིན་པའི་རྒན་དར་གཞོན་གསུམ་ནང་དུ་ཚུད་ཡོད་པ་ཞིག་རེད།",
    "འོ་ན་འུ་ཅག་གི་ན་གཞོན་གསར་བ་གང་དུ་ཡོད་ཅེ་ན།",
    "ལས་གནས་ཀྱི་བྲེལ་འཚུབ་ཏུ་ཡོད་པ་ཞིག་ཀྱང་རེད།",
    "རྟ་ནོར་ལུག་གསུམ་གྱི་རྗེས་ན་ཀི་རིང་འདེབས་པའི་རྒན་དར་གཞོན་གསུམ་གྱི་ནང་དུ་ཡོད་པ་ཞིག་ཀྱང་རེད།",
    "གཉིད་དུ་ཡུལ་བའི་མི་རབས་ཚ་རྒྱུད་དག་གི་རྨི་ལམ་དུ་གཏོར་བརླག་བྱེད་དུ་འགྲོ་དགོས་པའང་ན་གཞོན་གསར་བའི་འགན་འཁྲི་ཞིག་ཡིན་པ་སྨོས་མེད་རེད།",
    "མང་མང་གིས་རང་རང་གི་བསམ་ཚུལ་ལྷུག་བརྗོད་བྱས་པའི་མཐར་མཇུག་དྲིལ་བ་རེད།",
    "ཞེས་པར་གཞི་བཅོལ་ནས་ཚོགས་ཞུགས་མི་བུ་རེ་རེས་སྐར་མ་བཅུ་ཙམ་གྱི་ཡུན་ལ་བགྲོ་གླེང་བྱས་པ་ཡིན།",
    "མི་བུ་རེ་འགས་ནི་ད་ནས་བཟུང་རང་གིས་རང་ལ་དྲི་བ་བྱས་རང་གིས་རང་ལ་ཚོད་བགམས་བྱས་ནས་སྐད་ཆ་དག་མོ་ཞིག་དང་།",
    "ཡང་མི་རེ་འགས་ནི་མི་བུའི་སྒལ་ན་གཞོན་གསར་པ།",
    "ཚིགས་ཀྱི་ཐད་ནས་དོན་དངོས་ལ་བཤོལ་བ་ནི་མི་བུ་ཞིག་གི་གཤིས་ཀ་མིན་ཚུལ་གྱི་དང་།",
    "ང་ཚོ་ནམ་ཡང་འདས་ལོ་ལྟ་བུའི་སྐབས་སུ་དོན་དངོས་ལ་བཤོལ་ན་མི་འགྲིག་པའི་ཚུལ་ཡང་གླེང་བྱུང་།",
    "སྤྱིར་ས་ཕྱོགས་གང་ས་ན་རང་གི་མདུན་ལམ་དང་རང་གི་གོ་ས།",
    "དེར་ཐོན་པའི་མི་སྣ་གལ་ཆེན་སྐུ་ཞབས་ཞོགས་དུང་དང་སྐུ་ཞབས་བྱང་སྐར་སོགས་མཁས་པ་མང་དག་ཅིག་གིས་མཐའ་ནས་སྐྱོང་གིན་འདུག།",
    "ཉིན་དེར་ཚོགས་ཞུགས་ཀྱི་ཤེས་ལྡན་པ་དག་གི་རང་རང་གི་ལྟ་ཚུལ་ལམ་བསམ་བློ་གསར་པ་ཞིག་གི་གླེང་གཞི་སྤེལ་ཡོང་དུས།",
    "ཉིན་དེ་ནས་བཟུང་མི་རིགས་ཤིག་གི་སྒལ་ཚིགས་དངོས་འདི་ཧ་ཅང་གི་འཕེལ་རྒྱས་ཀྱི་གལ་འགངས་ཤིག་ཡིན་པར་ར་སྤྲོད་ཐུབ་བྱུང་།",
    "དུས་ཚོད་དམ་འཛིན་དང་གླེང་གཞིས་རྩ་བ་བཟུང་ཏེ་གླེང་སྟེགས་འདི་ནས་བོད་སྐད་དག་མ་ཞིག་གི་གླེང་མོལ་བྱས་ཡོང་དུས་ཕལ་ཆེར་ང་ནི་སྲོང་བཙན་བོད་རྒྱལ་གྱི་བུ་ཕྲུག་རྣལ་མ་དེ་ཨེ་ཡིན་འདོད་བྱུང་ལ་སྤོབས་པ་ཞིག་ཀྱང་སྐྱེས་གྲབས་བྱས་ཡོད།",
    "མང་ཚོགས་རང་བཞིན་ལྡན་པའི་བྱ་གཞག་རྒྱ་ཁྱོན་ཆེ་ཙམ་ཞིག་ཅེས་བརྗོད་འདུག་པ་དང་།",
    "ང་ཚོས་འདས་ཟིན་པའི་དུས་རབས་ཉི་ཤུ་པར་ཕྱི་མིག་ཅིག་བལྟས་ནའང་།",
    "ཁོང་གི་ཤེས་རབ་དང་མི་གཞི་ལ་ཡིན་འཇོག་དང་དང་ལེན་བྱེད་མཁན་ག་ཚོད་ཡོད་ཨང་།",
    "དུས་རབས་སྔོན་མའི་ལོ་རབས་བརྒྱད་ཅུ་པའི་ནང་དུ་རང་གྲོལ་ལགས་ཀྱིས་མི་རིགས་ཀྱི་ལ་རྒྱ་དང་ཁོག་དཔུང་གི་དར་ཆ་མཐོན་པོར་འཕྱར་ཏེ་རྟོགས་སད་ཀྱི་ཅོང་བརྡ་ཡང་ཡང་བརྒྱབ་ནའང་།",
    "རྐང་ལམ་ནས་བུད་དེ་གཞུང་ལམ་དུ་བགྲོད་མཁན་ག་ཚོད་ཡོད་ཨང་།",
    "བསམ་བློའི་མར་རྩམ་དེ་ལ་བརྟེན་ནས་རྒྱ་ནག་གི་ན་གཞོན་གསར་པ་གང་མང་འཚར་ལོངས་བྱུང་ཞིང་བློ་འབྱེད་ཀྱི་བྱ་གཞག་དེ་ཡང་མི་རབས་ནས་མི་རབས་བར་ཆད་མ་མཐུད་ཀྱིས་སྤེལ་ཡོང་བ་རེད།",
    "ཞིག་ཏུ་ངོས་འཛིན་གྱིན་ཡོད་འདུག་ལས་འགུལ་དེ་ལ་ཧུའུ་ཧི་ལགས་ཀྱིས་རྒྱ་ནག་གི་རིག་རྩལ་བསྐྱར་དར་ཞེས་འབོད་ལ།",
    "ལུའུ་ཞུན་ལགས་ཀྱིས་བསམ་བློ་གསར་བརྗེ་ཞེས་འབོད་པ་རེད།",
    "བྲན་གཤིས་དང་རྨོངས་འཐོམ་སོགས་ལ་རྒྱབ་ཀྱིས་གཏོད་པས་ཁོང་ཚོ་ནི་བློ་འབྱེད་པ་དང་ངོ་རྒོལ་པ་དང་།",
    "གཏོར་བཤིག་པ་དང་རྟོགས་སད་པའི་ཁྱུ་ཞིག་ཡིན་པ་རེད།",
    "རང་རེའི་ཁ་བའི་ལྗོངས་སུ་ཡོ་རོབ་ཀྱི་བློ་འབྱེད་ལས་འགུལ་དང་རིག་རྩལ་བསྐྱར་དར་ལྟ་བུ་དང་།",
    "རྒྱ་ནག་གི་ལྔ་བཞི་ལས་འགུལ་ལྟ་བུའི་ལས་འགུལ་གང་ཡང་བྱུང་མ་མྱོང་ནའང་།",
    "འདི་ནི་མི་བུ་སོ་སོའི་རིན་ཐང་དང་མི་གཞི་ལ་གོང་བཀུར་གྱིས་དཔའ་དར་འཐེན་པའི་གྲབས་གཤོམ་ཡང་རེད།",
    "རྒྱུ་འབྲས་དང་འགན་འཁྲི་སོགས་ཀྱི་ལྗང་མྱུག་འབུས་པའི་རྟགས་མཚན་རེད་ལ།",
    "ད་ལྟ་ནི་མི་བུ་སོ་སོས་བསམ་གཞིག་གི་མགོ་བོ་ཐུར་དུ་དཔྱངས་ནས་རང་མི་རིགས་ཀྱི་མ་འོངས་པའི་བགྲོད་ལམ་འཚོལ་སྙེག་བྱེད་བཞིན་པའི་སྒང་རེད།",
    "བསམ་གཞིག་གི་ཤེད་མོང་དག་གི་འབྲས་བུར་ཡང་གཞུང་ཕྱོགས་དང་ན་གཞོན་གསར་པ།",
    "སོ་སོའི་རིང་ལུགས་གང་ཞིག་ཡིན་ཡང་འདོན་ཆོག་ཆོག་དང་སོ་སོའི་བསམ་བློ་གང་ཞིག་ཡིན་ཡང་སྒྲོག་ཆོག་ཆོག་རེད།",
    "ཁྱོད་རང་ཉིད་ཀྱི་མི་གཞི་སྲུང་འཛིན་བྱེད་པ་ནི་དོན་ལ་རྒྱལ་ཁབ་ཀྱི་ཆེད་དུ་མི་གཞི་སྲུང་འཛིན་བྱེད་པ་ཡིན།",
    "ཧུའུ་ཧི་ལགས་ཀྱི་སྐད་ཆ་འདི་ནི་མི་སྒེར་རིང་ལུགས་ཀྱི་བསམ་བློའི་ཉིང་བཅུད་རེད་ཅེས་བརྗོད་ཆོག་པ་དང་།",
    "མི་སྒེར་དང་བདག་དང་ང་བཅས་ནི་བྱེ་བྲག་གི་ལྷུ་ལག་དང་གཅུས་གཟེར་རེ་རེ་ཡིན་པ་རེད།",
    "ལྷུ་ལག་དང་གཅུས་གཟེར་རེ་རེ་སྲ་ཞིང་མཁྲེགས་པ་ཞིག་མིན་ཚེ་འཕྲུལ་འཁོར་དེ་འཁོར་སྐྱོད་བྱེད་པ་ནི་དཔེ་མི་སྲིད་དོ།",
    "འཇར་པན་གྱི་མེ་རྗེ་གསར་སྒྱུར་སྐབས་ཀྱི་བསམ་བློ་པ་ཧྥུ་ཁི་རྫ་ཝ་ཡོ་ཁི་ཆི་ལགས་ཀྱིས་མི་སྒེར་གྱི་བསམ་བློའི་སྟེང་གི་སྒེར་ཚུགས་མ་ཐུབ་ན་རྒྱལ་ཁབ་ཀྱི་སྒེར་ཚུགས་ཀྱང་མི་ཐུབ་པར་བརྗོད་འདུག་པ་དང་།",
    "ངས་ཀློག་པ་པོ་ཞིག་གི་མིག་ཟུང་སྤྱད་ནས་ན་གཞོན་གསར་བར་བལྟས་ཤིང་གླེང་དགོས་ཚེ།",
    "ཐོག་མར་རང་ཉིད་ཀློག་པ་པོ་རྣལ་མ་ཞིག་གི་ས་ནས་བསྡད་དེ་སྐད་ཆ་འགའ་ཤས་གསོང་བོར་བརྗོད་འདོད་ཀྱི་ཀུན་སློང་འདི་རྒྱུ་བྱས་ཏེ་རང་ཉིད་ཀྱི་འཆར་སྒོ་ཞིག་བྲིས་པ་ཡིན་ནོ།",
    "མིང་གིས་ཡིན་ནམ་དོན་གྱིས་ཡིན་མིན་ནམ་ཆ་མ་འཚལ་ཀྱང་།",
    "འདི་ལྟར་རང་གི་ལས་ཀ་ལ་གཟབ་ནན་གྱི་རྣམ་འགྱུར་ཞིག་འཛིན་ཐུབ་པ་ནི་ང་ཚོའི་མི་རབས་འདི་མཐོ་ས་ནས་དམའ་སར་ན་གཞོན་གསར་པ།",
    "མཐོ་བ་ནམ་མཁའི་དབྱིངས་ནས་དམའ་བ་རང་གི་རྡོག་སྣེ་རྙེད་པའི་དན་རྟགས་ཤིག་ཀྱང་མ་ཡིན་ནམ།",
    "ཚོར་ཤེས་ངུ་ཤུམ་ནས་དཔྱོད་ཤེས་རྒྱང་འབོད་བརྒྱུད་པའི་གོ་རིམ་ནི་ལས་ཀ་ཞེས་བའི་དངོས་དོན་ཞིག་ཞིབ་ས་ཕྲ་ས་ནས་རྙེད་པའི་མགོ་རྩོམ་སྟངས་རེད།",
    "དེ་ན་ཁོ་བོས་ཀྱང་ན་གཞོན་གསར་བ་ཟུར་གཞན་ཞིག་ནས་མི་གླེང་ཐུ་མེད་རེད།",
    "བོད་རང་གི་མིང་བརྡ་ཐ་སྙད་ཀྱི་ཁྱབ་ཁོངས་ནས་དེ་ལ་འདི་དང་གན་གྱི་འགྲེལ་བ་ཞིབ་ཆ་ཅན་ཞིག་མེད་ན་ཡང་།",
    "ཕྱི་ཕྱོགས་བཙན་རྒྱལ་བའི་གཉའ་གནོན་དང་གཞན་བསྒྱུར་གྱི་ཧམ་སེམས་ལ་ཁ་རྡུང་དྲག་པོ་བཏང་སྟེ་ཆེས་ཐོག་མར་དམིགས་ཡུལ་གསལ་བའི་ལམ་ཆེན་དུ་བུད་པ་ཞིག་རེད།",
    "མ་གཞི་ན་གཞོན་ནི་མི་ཚེ་ཧྲིལ་བོའི་གོ་རིམ་ཁྲོད་ཀྱི་ཆེས་ཟིལ་ཤུགས་ལྡན་པའི་ལང་ཚོའི་སྟོབས་དང་རྣམ་དཔྱོད་ཀྱི་བློ་གཤོག་རྒྱས་པའི་ན་ཚོད་ཅིག་ལ་གོ་གི་ཡོད།",
    "ཡིན་ན་ཡང་ན་གཞོན་གསར་བ་ནི་ན་ཚོད་གཅིག་པུའི་སྟེང་དུ་གོ་ན་འགྲིག་གི་ཡོད་པ་ཞིག་མ་རེད།",
    "གཙོ་བོ་མི་ཚུལ་རིག་པའི་བློ་མིག་གིས་བལྟས་ན་འགྲིག་གི་ཡོད་པ་ཞིག་རེད།",
    "ནུབ་གླིང་གི་བློ་འབྱེད་ལས་འགུལ་དང་རིག་རྩལ་བསྐྱར་དར་སོགས་ཀྱི་ལས་འགུལ་གྱིས་འཛམ་གླིང་གི་ཁྱོན་ལ་གཡོ་འགུལ་གསར་བ་བཟོས་པ་དེས་མིའི་རིགས་ལ་རིན་ཐང་བསྐྱར་དཔག་གི་རླབས་རྒྱུན་འདི་བསྐྱལ་འོངས་བ་རེད།",
    "དེ་ནི་ན་གཞོན་གསར་བ་འཁྲུངས་པའི་རྒྱུ་རྐྱེན་གཙོ་བོ་ཞིག་ཡིན་གི་ཡོད།",
    "རླབས་རྒྱུན་འདིས་ལྔ་བཞིའི་ལས་འགུལ་བསླངས་པར་རྩ་བའི་རྒྱུ་རྐྱེན་བསྐྲུན་སོང་བ་རེད།",
    "གསར་བརྗེ་ལ་རྒྱལ་ཁ་འཐོབ་དགོས་ན་ངེས་པར་ཏུ་ཐོག་མར་སྐྱེ་བུ་སྒེར་གྱི་འདུ་ཤེས་སད་རྟོགས་བྱུང་དགོས་བའི་གནས་ལུགས་རྙེད་པ་རེད།",
    "ང་ཚོའི་གནས་བབ་ནི་ད་དུང་དེ་འདྲའི་དམིགས་ཡུལ་གསལ་ཐག་ཆོད་པ་ཞིག་གཏན་ནས་ཡིན་གི་ཡོད་པ་མ་རེད།",
    "ང་ཚོ་ད་དུང་འགྱེལ་ཞོར་ལངས་ཞོར་མདུན་ཕྱོགས་སུ་སྐྱོད་ཀྱིན་པ་དེའོ།",
    "༢༩ལོའི་ཟླ་༩བའི་ཚེས་༢༡ཉིན་རྒྱལ་མོ་ཚ་བ་རོང་ནས་ཕུལ་བའོ།",
    "ལོ་རབས་བརྒྱད་བཅུ་བའི་ནང་དུ་ང་ཚོས་ཐོག་མར་བོད་ཅེས་པའི་ཚོགས་སྤྱི་འདི་འཛམ་གླིང་གི་ཁྱོན་ནས་ཚོར་ཏེ་རྗེས་ལུས་ཞེས་པའི་ཐ་སྙད་ཅིག་རྙེད་ཅིང་།",
    "རང་མོས་སྙན་ངག་གི་གླིང་བུ་འབུད་སྟངས་ཀྱིས་རྗེས་ལུས་ཀྱི་སྡུག་སྨེ་ཞིག་ངུ་ཤུམ་གྱིས་གྱེར་བའི་དུས་རླབས་ཤིག་འཕྱུར་བ་ལ་གོ་བ་ཡིན།",
    "དཔྱོད་ཤེས་ཀྱི་བློ་མིག་གིས་བག་ཆགས་རྙིང་བ་དོང་ནས་སྤྲུགས་ཤིང་འབོལ་རྩོམ་ཞེས་པའི་གློ་གྲི་དང་མདུང་ཐུང་གིས་རང་གི་གདོང་འབག་དམར་བཤུ་བྱས་པའི་ལོ་རབས་དགུ་བཅུ་བའི་དུས་སྨད་ཞིག་ལ་གོ་བ་ཡིན།",
    "མི་རབས་དང་བོ་ནས་ལྔ་བའི་བར་གྱི་རྩོམ་རིག་སྣང་ཚུལ་དང་ཧི་ར་མ་དང་མཐོ་སྒང་བུ་མོ་སོགས་ཀྱི་གླུ་གར་རོལ་ཚོགས།",
    "གཅིག་གྱུར་གྱི་ཚོགས་སྤྱི་ཞིག་ལ་རེ་བའི་སེམས་ཁམས་སྣང་ཚུལ་ཞིག་ཀྱང་ཡིན་ན་ཐང་གི་གང་ལྟར།",
    "རྟག་བརྟན་ཐེར་ཟུག་གི་བདེན་པའི་རི་བོ་དཔག་ཚད་ཁྲི་ཕྲག་གི་བར་དུ་བརྐྱངས་ཤིང་།",
    "དེ་བསྟུན་འོས་འབབ་ཀྱི་གཟི་མདངས་ལམ་ལམ་གང་མི་རིགས་སོ་སོའི་བླ་སྲོག་གི་གཏིང་རིམ་ན་འཕྱོ་ཞིང་འཚེར་གྱིན་ཡོད་ན།",
    "རེས་འཇགས་རེས་ལངས་ཀྱི་བསམ་བློའི་རླབས་རྒྱུན་རེ་རེས་རྔམ་མཐུག་པའི་མུན་ནག་གི་ཡོལ་བ་བརྟོལ་ནས་འབའ་འབུར་དང་སྒང་གཤོང་མེད་པའི་ཁོད་ཡངས་ཀྱི་ལམ་ཆེན་ཞིག་དུ་ཁྲིད་ཀྱིན་བདོག་པ་ནི།",
    "སྡུག་ཡུས་དང་སྐྱོ་གར་སོགས་ལོ་དང་ཟླ་བ་བསག་པའི་དུས་ཚོད་ཀྱི་ལྕེབས་ཐག་བར་ནས་ཡལ་འགྲོ་གི་རེད།",
    "ཤེས་མེད་ཚོར་མེད་ཀྱི་ངང་ནས་རང་སྟེང་གི་དགྲ་གཉེན་གྱི་འདུ་ཤེས་དང་ཆག་འཇིགས་ཀྱི་བྱེད་སྣང་དེ་བརྗེད་འགྲོ་གི་རེད།",
    "སྔོན་སོང་ན་གཞོན་གསར་པ།",
    "གི་ལམ་བུར་ཕྱིར་རྟོག་བྲལ་ཞིང་མིག་སྔའི་གནས་སྟངས་ལ་ཉེན་ཚབས་ཀྱི་འདུ་ཤེས་ཤིག་སྐྱེས་སྲིད་དམ།",
    "མི་སྒེར་རེ་རེ་ཡར་ལངས་དགོས་རྒྱུ་ནི་རྒྱལ་ཁབ་འཕེལ་རྒྱས་ཀྱི་རྨང་གཞི་ཡིན་པ་ཤེས་རྟོགས་བྱུང་།",
    "ཟླ་པའི་ཚེས་ཉིན་དམག་སྤྱི་ཆེན་མོ་ལུས་ཡོན་ཧོང་གི་བཀའ་ལྟར།",
    "ཀྲོའུ་ཙོ་རིན་སོགས་རེད།",
    "བསམ་བློའི་བློ་འབྱེད་ཀྱི་ལས་འགུལ་བརྒྱུད་ནས་གཞི་རིམ་མང་ཚོགས་ཀྱི་གོ་རྟོགས་ཟད་པར་འབད་དེ།",
    "ཕྱི་རབས་པ་དག་གིས་ཁོར་གདེང་འཇོག་གནང་གིན་པ་ནི།",
    "རྒྱ་ནག་གི་ལྔ་བཞིའི་ལས་འགུལ་སྤེལ་མི་ཐུབ་ཞེས་པ་དེ་རེད།",
    "ང་ལ་སློབ་གཙོ་ངོ་མ་ཞིག་གི་བྱེད་ནུས་དེ་ག་འདྲ་ཞིག་ཡིན་པ་ཤེས་སུ་བཅུག་པའི་མོད་ལ།",
    "མིག་གིས་གསལ་བྱེད་སུམ་ཅུའི་བདག་པོ་ཚོར་རྒྱང་ལྟ་བྱེད་ཅིང་རྣ་བས་དུས་རབས་ཀྱི་དགོངས་པར་གཟབ་ཉན་བྱེད་མཁན་ནི་ཉིན་མོའི་སྐར་མ་ལྟ་བུ་རེད་ཨང་།",
    "བོད་ཀྱི་མི་སྣ་སུ་ཞིག་ཡིན་རུང་དཔོན་གནས་ཤིག་ལག་ཏུ་རེག་རྗེས།",
    "ང་ཚོ་སྔར་བཞིན་རང་ལམ་ན་ལུས་ཡོད་པ་མ་ཡིན་ནམ།",
    "རང་ཉིད་ལ་འགན་མི་ཁུར་མཁན་ཞིག་གིས་མི་རིགས་སྤྱིའི་བསམ་བློའི་འཕེལ་ཕྱོགས་ལ་བསམ་བློ་འཁོར་ཐུབ་བམ།",
    "སེམས་པ་ནང་དུ་བསྡུས་ཏེ་བསམ་གཞིག་རེ་གྱིས་དང་མི་རིགས་ཞེས་པའི་ཐ་སྙད་འདིའི་ཁོངས་སུ་ཁྱོད་དང་ང་སོགས་མི་བུ་བྱེ་བྲག་པ་རེ་རེ་འདུས་ནས་ཡོད་པ་མ་ཡིན་ནམ།",
    "མི་བུ་བྱེ་བྲག་པ་རེ་རེ་ཡི་བྱེད་རྩོལ་གྱིས་ད་གཟོད་ཐ་སྙད་འདི་ལ་གསོན་ཤུགས་བསྩོལ་དགོས་པ་མ་ཡིན་ནམ།",
    "ང་ཚོ་ཡང་མི་ཡིན་པས།",
    "པ་ཡོད་པ་ནི་དཔེར་ན་ལུའུ་ཞུན་དང་ཧུའུ་ཧི་གཉིས་ལྟ་བུ་རེད།",
    "མིའི་ནང་བསམ་པའི་དཔལ་ཡོན་དང་ཕྱིའི་འགྲོ་འདུག་སྤྱོད་ལམ་གཉིས་མཉམ་གནས་སྒོས་མཐུན་འཇུག་ཡོང་ཐབས་བྱ་རྒྱུ་དེ་ཡིན་མོད།",
    "ཐེག་ཐུབ་མིན་གྱི་ཐད་ང་ལ་མཚོན་ན་ད་དུང་ཡང་བསམ་གཞིག་གཏོང་དགོས་པའི་འདྲི་རྟགས་ཆེན་པོ་ཞིག་རེད།",
    "འདི་ལ་དོ་སྣང་བྱེད་མི་མང་ན་འགྲིག་མོད།",
    "འགྲོ་མིའི་བླ་སྲོག་སྐྲུན་ཐུབ་རྒྱུ་ཕར་ཞོག་དེ་ལས་ལྡོག་སྟེ་ང་ཚོའི་མི་རབས་གསར་བ་འདི་ལོག་ལམ་ལ་ཁྲིད་རྒྱུ་རེད།",
    "སྣང་ཚུལ་འདིའི་ཐོག་ནས་ང་ཚོས་གནས་ལུགས་ཆེན་པོ་ཞིག་གསལ་འགྲེལ་བྱ་ཐུབ་པ་ནི།",
    "གཞན་པའི་ངལ་རྩོལ་གྱི་འབྲས་བུར་མཐོང་ཆེན་མ་བྱས་པའི་ཉེས་སྐྱོན་འདི་གང་གིས་སེལ་དགོས།",
    "བདག་གིས་ཁྱོད་ཉིད་གུ་ཡངས་སུ་གཏོང་ཐབས་བྲལ།",
    "ཁོ་ཚོར་ལས་གནས་བརྟན་པོ་ཞིག་རེག་རྗེས་ཀྱི་དམིགས་ཡུལ་ཉག་གཅིག་པུ་ནི་ཕྱུག་པོར་འགྱུར་བ་བྱ་རྒྱུ་དེ་རེད།",
    "ཁྱོད་དང་ཁ་གཏད་དུ་འགྲེང་ནས་ཡོང་གིན་པ་ནི་དུས་རབས་གསར་བའི་རྒྱབ་ལྗོངས་སུ་འཚར་ལོངས་བྱུང་བའི་མྱི་གསར་བ་ཡིན་པས།",
    "ཁྱོད་ན་གཞོན་གསར་པ།",
    "དེ་བས་འདི་ནི་ང་ཚོ་འགྱུར་དགོས་པའི་གདམས་ཀ་ཡང་རེད།",
    "རྒྱལ་ཡོངས་རང་བཞིན་གྱི་ལས་འགུལ་འདི་ལྟ་བུ་ཞིག་སྤེལ་བ་རེད་ལ།",
    "འདྲ་མཉམ་གཙོས་འཛམ་གླིང་དཔལ་ཡོན་རྒྱལ་ཁབ་ཀྱི་རྗེས་སུ་གོམ་ཁ་སྒྱུར་བའི་དུས་རབས་ཤིག་ཀྱང་རེད།",
    "ཚེ་སྲོག་གི་བཀྲག་མདངས།",
