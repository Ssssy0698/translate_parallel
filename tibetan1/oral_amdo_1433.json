    "དེ་འདྲའི་ལོ་ཟླ་གང་མང་གཅིག་གི་རྗེས་སུ།",
    "ཁྱོད་ལ་དྲན་ཤེས་གསར་པ་གཅིག་རྙེད་ན་རེད།",
    "དེ་ལྟར་ཁྱོད་ཀྱིས་ཁྱོད་རང་ལྕེབས་པ་གཞི་ནས་རྟོགས་ངེས།",
    "ཁྱོད་ཀྱིས་དེ་ལ་དཔྱད་པ་བྱོས་པ་ལས།",
    "ད་དུང་གཡོ་སྒྱུའི་ཚིག་དང་ཕྲག་དོག་གི་གདོང་རིས།",
    "དེ་ལ་ཁྱོད་གཅིག་ནས་དུས་ཚོད་གཅིག་གི་ཐོད་བརྒལ་ལས་བརྒལ་ཚར་བས་རེད།",
    "གཉིས་ནས་ཁྱོད་ལ་ཁ་གཏད་དུ་ལངས་པའི་ཡང་དག་གི་ལྟ་ཚུལ་ཆར་རྗེས་ཀྱི་མྱུ་གུ་བཞིན་འབུས་པས་རེད།",
    "ངས་ནི་ཁ་སང་གི་གཏམ་རྒྱུད་ཅིག་ན་ཟུག་གིས་དྲན་གི་ཡོད།",
    "ཁ་སང་ནས་དེ་རིང་བར་དུ་རྗེས་ལུས་ཀྱི་གཡང་ལ་ལྷུང་ཡོད་པའི་འུ་ཚང་གི་གནམ་སའི་འདྲེས་མཚམས་མཐོང་གི་ཡོད།",
    "མངོན་སུམ་ལས་ལྐོག་གྱུར་ལ་ཡིད་ཆེས་བྱ་ཐུབ་པའི་འུ་ཚང་གི་མི་རིགས་འདིའི་ངོ་གདོང་མཐོང་གི་ཡོད།",
    "དེ་བས་འུ་ཚོ་སུ་ཡིན་རུང་རང་ཉིད་ཀྱི་འདང་རྒྱག་སྟངས་བསླབ་ན་རེད།",
    "མི་སྒེར་གྱི་བསམ་གཞིག་གཏོང་སྟངས་ལ་གོམས་ན་རེད།",
    "འདི་ནི་ང་ཚོ་རྗེས་ལུས་ཀྱི་ཉེན་ཁ་ལས་གཡོལ་དགོས་པའི་གོམ་པ་ཐོག་མ་ན་གཞོན་གསར་པ།",
    "མང་དག་ཅིག་གི་ནོངས་ལ་རེག་དགོས་པ་སྨོས་མ་དགོས་པ་ཞིག་རེད།",
    "སྐབས་དེར་ནོངས་ཐོག་ལ་འཁེལ་མཁན་དག་གི་སེམས་ལ་བཟོད་གླགས་མེད་པའི་ན་ཟུག་ཅིག་གམ་འཐབ་ཡ་མེད་པའི་ཁོང་ཁྲོ་ཞིག་ལངས་ཏེ་རང་ཤག་ཏུ་ཁུ་ཚུར་བཅངས་ཏེ་ཡར་འགྲོ་མར་འགྲོ་བྱེད་པ་གདོན་མི་ཟ་སྟེ།",
    "ད་དུང་ཁ་སང་ལྟར་བཏང་སྙོམས་དང་འགན་འཁྲི་མེད་པར་སོང་ན།",
    "ཕྱོགས་རིས་དང་མ་ཉེས་ཁ་གཡོག་གི་སྐད་ཆ་ལས།",
    "མཛུབ་མོས་གར་བསྟན་ཤར་ཞེས་པའི་གནས་ལུགས་དང་རང་ཚུགས་བོར་བའི་ཐ་སྙད་འདི་དག་གིས་བསྐྱེད་པར་འདོད།",
    "བསམ་བློ་གུ་དོག་པའི་བོད་ཀྱི་རྩོམ་སྟེགས་ན་འགྱིངས་པའི་ཅོལ་ཆུང་སྐོར་ཞིག་གིས་ཐེ་ཚོམ་མེད་པར་རྣ་བར་གཟན་པའི་ཐ་སྙད་འགའ་བཀོད་དེ་སྡིགས་དམོད་གཏོང་བཞིན་པ་འདི་ནི་ང་ཚོའི་བསམ་བློ་དང་རྩོམ་རིག་རྒུད་པར་ཕྱོགས་པའི་ལྟས་སུ་སྣང་ངོ།",
    "ད་དུང་ལྡོང་ཡོན་ཏན་ལྟ་བུའི་སྙན་དེབ་ཀྱི་འགོ་བརྗོད་འབྲི་བར་མོས་པ་དག་གིས་སྙན་དེབ་ག་གེ་མོ་འདིའི་བརྗོད་བྱ་གཏིང་ཟབ་ཅིང་།",
    "སྲོལ་རྒྱུན་སྙན་ངག་གི་སྲོག་ཞུགས་པ་དང་།",
    "ནར་སོན་བཞིན་པའི་ང་ཚོའི་རྩོམ་རིག་གི་ཞིང་ས་གཤིན་པོར་འབྲས་བུ་མེད་པའི་ས་བོན་རུལ་བ་གཏོར་དྲགས་པ་མ་ཡིན་ནམ་ཞེས་ཀྱང་སྨྲ་བར་འདོད་དོ།",
    "སྙན་གྲགས་དང་ངོ་སོ་ལ་མོས་པའི་དེང་གི་བོད་ཀྱི་རྩོམ་པ་པོ་ཁ་ཤས་ཀྱིས་བྲིས་བྲིས་ཐམས་ཅད་རྩོམ་དུ་འདོད་པ་དང་།",
    "གུང་གཞུང་གིས་སྤྲད་པ་ཡིན།",
    "རྔན་པ་ལེགས་པོ་བྱིན་ཡོད་རྒྱུ་རེད་ལ་སོགས་ཀྱིས་མཚོན་པའི་སྐད་ཆ་འདི་དག་གིས་ཅི་ཞིག་མཚོན་ཐུབ།",
    "དོན་དངོས་སུ་མི་འདི་དག་ལ་རྩོམ་རིག་གི་འདུ་ཤེས་ཞན་པ་དང་།",
    "སུ་ལའང་མི་འཛེམ་པར་བོད་མིར་དགག་རྒྱག་བྱེད་ཚུལ་དེར་རྒྱབ་རྟེན་བཀན་མོ་ཡོད་ཐག་ཆོད་རེད་ཅེས་ཚོད་དཔག་གིས་མ་ཉེས་ཁ་གཡོག་གི་ཞྭ་མོ་བསྐོན་ཚུལ་འདི་ལ་གཞིགས་ན།",
    "དོན་དངོས་ལ་གཞོལ་ཏེ་འཁྱོགས་བཟོ་ལ་མཁས་པའི་མི་ཞིག་གི་བགྱི་བ་ཡིན་པར་ར་སྤྲོད་བྱས་མི་འདུག་གམ།",
    "འདིའི་སྐབས་ཀྱི་ཡོན་ཏན་ཟེར་བ་སྙན་ངག་ཁོ་ནའི་ཕྱོགས་ཀྱི་ཡོན་ཏན་ལ་གོ་དགོས་པ་ཁ་བྱང་གི་སྟེང་ནས་ཀྱང་ཤེས་ཐུབ་པས་སོ།",
    "ལག་གི་དབྱུག་པ་ཐང་ལ་སྐྱུར་རོགས།",
    "ལག་ལེན་དངོས་ལ་རྐང་བཙུགས་ནའང་གཅར་རྡུང་ནི་དོན་ལ་དགེ་སློབ་སུར་མཚོན་ཡང་ཐབས་རྡུག་གི་ལས་ཀ་ཞིག་མ་རེད་དམ།",
    "ད་ནི་ལག་གི་དབྱུག་པ་ཐང་ལ་སྐྱུར་རོགས།",
    "གདོང་གི་ཞལ་ཁེབས་ཡར་ལ་འགྱོགས་རོགས།",
    "གལ་སྲིད་ང་ཚོས་མིའི་རིགས་ཀྱི་འཁོར་ལམ་དེར་མ་བསྟུན་པར་འདི་ནི་ང་ཚོའི་ཡབ་མེས་ནས་བརྒྱུད་པའི་གོམས་སྲོལ་ལོ་ཟེར་རྒྱུ་ཡིན་ན།",
    "ང་ཚོ་ནི་མིའི་རིགས་ཀྱི་མིག་ནང་གི་གདོན་རྫས་སུ་འགྱུར་བ་དང་།",
    "གལ་སྲིད་ང་ཚོས་ད་རུང་མཚམས་མ་བཞག་པ་ཡིན་ན།",
    "དེས་ན་ང་ཚོས་ད་རུང་མ་གཅར་ན་ཐབས་མེད་ཚུལ་གླེང་རྒྱུ་ཡིན་ནམ།",
    "ཏུ་ཆགས་རྒྱུའི་སྔོན་འགྲོའི་ཆ་རྐྱེན་དང་རྩ་བའི་རྒྱུ་རྐྱེན་འབའ་ཞིག་ཏུ་ལོག་མོད།",
    "རྒྱུ་འབྲས་བློ་མིག་མངའ་མཁན་དང་རྟོགས་འཇུག་གི་བསམ་བློ་ཡོད་མཁན་ཞིག་ཡིན་ཕྱིར་འདིར་ཅིས་ཀྱང་ནན་འཇོག་ཆེན་པོ་བྱེད་དགོས་པ་རེད།",
    "ཤེས་བྱར་གུས་པར་བྱ་བའི་སྲིད་བྱུས་འོད་སྣང་ས་ཕྱོགས་ཀུན་ཏུ་སྤྲོས་ཏེ་དཀར་ཆ་དོད་པའི་འཇིག་རྟེན་ཞིག་མི་སེར་རེ་རེའི་སེམས་ངོས་སུ་བཀྲམ་སྟོན་བྱས།",
    "དུས་སྐབས་འདི་འདྲར་ཡིན་པ་ནི་ང་ཚོས་འདས་སོང་ལ་ཕྱིར་རྟོག་གིས་མ་འོངས་འཚོ་བར་སྐྱ་ཐིག་འགོད་རྒྱུ་དེ་རེད་མོད།",
    "ཕོ་གཞུང་ཐོག་དང་འདུག་ཁྲི་ཐོག་རྒྱུག་འཁོར་ཐོག་གི་ལོངས་སྤྱོད་རིང་ལུགས་ཀྱི་འཚོ་བས་བརླམས་དྲགས་པས་ལས་ཀྱིས་བསྡུས་པའི་ཕ་ཡུལ་ཉེ་དུ་ཀུན།",
    "ང་ཚོས་ཀྱང་ངེས་པར་དུ་མིག་ཟུང་འཛམ་གླིང་དུ་ཕྱོགས་དགོས་ལ་དེངས་རབས་ཅན་དུ་ཕྱོགས་དགོས།",
