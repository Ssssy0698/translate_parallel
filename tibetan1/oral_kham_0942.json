    "ཁོ་རང་སྔར་བཞིན་ཞིང་ཀྲོའུ་རུ་བསྡད་ཅིང་མདུན་དུ་རྨ་ཆུས་བཅད་ཅིང་རི་བོ་ཧོ་ལན་ཧྲན་ལ་རྒྱབ་བརྟེན་ཏེ་མངའ་ཁོངས་བརྟན་པོར་བསྲུངས།",
    "འདིའི་དོན་ནི་བོད་དང་ཐ་ཐ་སོགས་ཚང་མས་ཁོ་རང་གོང་མའི་ཁྲི་ལ་སྡོད་དགོས་ཞེས་བསྐུལ་བར་གོ་དགོས།",
    "ལི་ཡོན་ཧའོ་མགོ་འདོགས་འདོད་འདུག་ཅེས་ཞུས།",
    "ཕང་ཅི་ཡིས་ཁོའི་སྐད་ཆའི་ནང་མགོ་འདོགས་རྒྱུའི་ཚིག་མེད་པ་མཐོང་ནས་ཁོ་རང་ཉིད་ལ་ཞུ་ཡིག་འབུལ་དུ་བཅུག་གོང་མས་ཕང་ཅི་ལ་ཕྱིར་ཡིག་ལན་འབྲི་དགོས་པའི་བཀའ་ཡིག་བཏང་ནས་དེ་ལྟར་བྱས་ཆོག་ཚུལ་ཞལ་བཞེས་གནང་།",
    "ཁོ་རང་མི་ཉག་རྒྱལ་ཁབ་ཀྱི་བདག་པོ་ཞེས་པར་བསྐོ་རྒྱུ་ཞལ་བཞེས་གནང་།",
    "ལེང་ཙོ་ལྐོག་གསོད་གཏོང་ཐུབ་ཅེས་ཞུས་པས་གོང་མ་ཐུགས་དགྱེས་ནས་ཁོ་རང་པའོ་ཨན་ཅུན་གྱི་གཙོ་སྐྱོང་དུ་གོ་གནས་སྤར།",
    "ཟླ་ལྔ་པར་ཡན་ཏ་ཡིས་ལོ་ཝུའུ་མཁར་སྲུང་མཁན་དམག་མི་དང་དམག་ཆས་རྣམས་དབོར་ནས་ལོག་དུས།",
    "གསལ་འདེབས་དཔོན་པོ་ཝུའུ་ཡུས་གཅིག་པུས་ཁོ་རང་ཀྲུང་གོའི་ངོ་ལོག་བློན་པོར་རྩི་དཀའ་བས།",
    "ས་སྒོའི་ནང་སླར་ལོག་དུས་མི་སུམ་ཁྲི་ལས་ལྷག་མེད།",
    "རང་ཉིད་ལྷོ་ཕྱོགས་རྒྱལ་རབས་སུ་ཡོང་དགོས་པའི་བཀའ་ཕབ་འདུག་ཟེར།",
    "སྐབས་འཕྲལ་བསམས་ནས་ཕུགས་དོན་འདོར་མཁན་འདུག་ས་མཁོ་མེད་དེ་འདོར་དུ་ཕངས་པས་ལོ་བསྟུད་མར་དམག་མཚམས་མ་བཞག་པར་རྒྱལ་ཁབ་ཀྱི་འཕུང་གཞིར་གྱུར།",
    "ཁོ་རང་ཐོབ་ན་ཡང་འབངས་མི་དཀྱུས་མ་ཞིག་ལས་མ་འདས་པས་རྒྱལ་ཁབ་ཀྱི་དོན་ལ་ཕན་པ་ཅི་ཞིག་ཡོད་དམ་སྙམ།",
    "ཁོ་རང་ཅིན་ཀྲོའུ་ཡི་ཐོན་ལེན་ཧྲི་ལ་བསྐོས།",
    "དེ་དག་མཐའ་མཚམས་སུ་སོ་སོར་སྡོད་དུ་བཅུག་མཐའ་མཚམས་ཀྱི་བློན་པོས་ལེ་ཅུའེ་མ་ཚོ་པ་དགྲ་བོ་དང་འགྲོ་འོང་བྱེད་བཞིན་འདུག་ཚུལ་ཞུས་པས།",
    "དེར་མིའེ་པུའུ་ཡི་ཕོ་ཉ་བཀུག་སྟེ་ཁོ་རང་ཕྱིར་ལྡོག་པ་དང་བསྟུན་ནས་གོང་མའི་དམིགས་བསལ་བཀའ་ཡིག་ཚོ་པ་དེ་གཉིས་ལ་བསྐུར་ནས་བྱས་རྗེས་འཇོག་པར་སྐུལ་མ་བཏང་།",
    "སྒྱུ་ཡིན་པར་དོགས་ནས་ཡོད་དུས་གཡུལ་འཐབ་ཀྱིས་བྱས་རྗེས་འཇོག་ཐུབ་འདུག་གསུངས་ཤིང་།",
    "ཁོ་རང་ལེང་ཀྲོའུ་རུ་སླེབས་མ་ཐག་བོད་ཀྱི་འགོ་པ་ཀྲེ་པུའུ་ཀྲི་སོགས་དཔོན་ཆན་ཡིའུ་ཁྲི་ལོ་ནི་ཧན་ཕྱི་མའི་གོང་མ་ཀའོ་ཙུའུ་འམ་ལིའུ་ཀའོ་ཡི་ཁྲི་ལོའི་མིང་།",
    "ཁོ་རང་དགར་རྒྱལ་སར་ལོག་པས་དེའི་བྱས་ཉེས་ཀྱི་རྐྱེན་པས་གོ་གནས་ཕབ།",
    "དེ་ནས་ཙའེ་ཞང་བློན་པོར་བོད་དང་རང་ཅག་སྐད་བརྡ་མི་འཕྲོད་ཅིང་ཆ་ལུགས་ཆ་དད།",
    "དེར་སླེབས་དུས་ལེང་ཀྲོའུ་རུ་ལོ་ལེགས་ཆེན་པོ་བྱུང་བས་ཁོ་རང་དེ་གར་སྡོད་དུ་བཅུག་པ་དང་།",
    "ཕྱིར་ལོག་དུས་རྔ་བརྡུངས་ཤིང་དབྱེ་ཀྲོའུ་ཡི་ཚོ་པ་བརྒྱད་ཀྱི་འགོ་པ་པུའུ་པོ་ཁྲི་སོགས་ཀྱིས་ཁོའི་ས་ཆ་འཕྲོག་ཚུལ་ཞུས་པས་གོང་མས་བཀའ་ཡིག་བཏང་ནས་བསླབ་འདོམས་གནང་།",
    "མཁར་གྱི་ཁྱུད་རྒྱ་ལེ་དབར་བཅོ་ལྔ་འདུག་པ་རྒྱ་བྱའི་དབྱིབས་སུ་ཡོད།",
    "གོང་མས་བཀའ་ཡིག་བཏང་ནས་གཟེངས་བསྟོད་གནང་བ་དང་ཅི་བྱེད་ཁོ་རང་ཉིད་ཀྱིས་ཐག་བཅད་ཆོག་པའི་བཀའ་གནང་།",
    "མཉམ་དུ་འཐབ་རྒྱུའི་སྐོར་གྲོས་བྱེད་བསམས་དུས་ཚོ་པ་དེ་གཉིས་ཀྱི་མིས་ཁོ་རང་གུར་གྱི་ནང་དུ་བསད་པས།",
    "ཁོ་རང་ཙོ་པན་ཏེན་ཀྲི་ཞེས་པར་གོ་གནས་ཕབ།",
    "གྲུབ་རྟུལ་ཕོད་ཆེ་ཞིང་ཇུས་ལ་མཁས་པར་སྐྲག་སྟེ་དེས་ངོ་ལོག་རྒྱུའི་ཇུས་གཤོམ་བཞིན་འདུག་ཅེས་མ་ཉེས་ཁ་གཡོག་བྱས།",
    "བཀྲ་ཤིས་གཡུང་ལུང་འད་ས་རྗེས་བུ་བེ་རོ་ཙ་ན་འགོ་པ་བྱས།",
    "བེ་རོ་ཙ་ན་འདས་རྗེས་དེའི་བུ་ཞི་པ་ཝུན་འགོ་པ་བྱས་ཞེས་བཀོད་ཡོད་པར་བརྗོད།",
    "ཝུན་དང་ཁོའི་བུ་ཞི་ཧྲེ་ལོ་ས་གཉིས་ཀྱིས་ཀྱང་རང་ས་ནས་མཁར་བཟུང་།",
    "དེར་ཁོ་རང་ཞ་ཀྲེང་དང་ལྷན་དུ་ཧོང་ཀྲོའུ་རུ་ལོག་ཞི་ཧྲེ་ལོ་ས་ཡིས་ཀྲའོ་ཧོའི་ཏེ་འཇབ་རྒོལ་གྱིས་གསོད་པའི་ཇུས་བཀོད་པས་ཀྲའེ་ཧོའེ་ཏེ་རྨ་ཆུའི་ལྷོ་ཕྱོགས་སུ་བྲོས།",
    "གཞུང་ལ་གྱོད་དོན་གཏུག་དུས་དཔོན་རིགས་ཚོས་ཤགས་རྩོད་མཁས་ཤིང་གཞུང་རྒྱུད་དྲང་བའི་མི་ཞིག་བདམས་ནས་གཟུ་བ་བྱེད་དུ་འཇུག་པ་དང་།",
    "ཝན་ཡན་ཝོ་ལུའུ་དང་ཝན་ཡན་ལོའུ་ཧྲི་གཉིས་ཀྱིས་ཆུ་བོ་དབྱི་ཧྲུའེ་ཡི་རྒྱུད་དུ་ཁོ་རང་ཕམ་པར་བྱས།",
    "ལིའོ་རྒྱལ་ཁབ་དཀའ་ཉེན་གྱི་དུས་ལ་ཐུག་དུས་ཀྱང་དམག་དཔུང་བཏང་ནས་སྐྱོབ་ཐབས་བྱས།",
    "གལ་ཏེ་ལིའོ་རྒྱལ་ཁབ་ཀྱི་བདག་པོ་མི་ཉག་ཏུ་སླེབས་ཚེ་ཁོ་རང་འཇུས་ནས་བསྐྱལ་དགོས་པའི་བཀའ་ཕབ་ཆོག་གསུངས།",
    "ད་ལམ་གྱི་ཞུ་གསོལ་དེ་རྒྱུན་གཏན་གྱི་བྱེད་སྟངས་ལས་རིང་དུ་འགོངས་པ་ཞིག་འདུག་པས།",
    "མི་ཉག་རྒྱལ་ཁབ་ཀྱི་དམག་མི་སུམ་ཁྲི་ཉིང་ཀྲོའུ་ནས་ལོག་དུས་ཆིང་ཧྲན་ནུའུ་ཡིས་བཀག་ནས་ཕམ་པར་བྱས།",
    "མི་ཉག་རྒྱལ་ཁབ་ཀྱི་ཧྥུ་ཧྲན་ཞེས་པས་འཇུ་བཟུང་བྱས་པའི་འབངས་ཁྱིམ་ཁྲིད་ནས་མགོ་འདོགས་སུ་འོངས་པར་ཁོ་རང་ཙེ་ཀྲོའུ་ཡི་གཙོ་སྐྱོང་དུ་བསྐོས།",
    "མི་ཉག་རྒྱལ་ཁབ་ཀྱི་མིར་ཞི་འདུམ་གྱི་བློ་འདུག་ཅིང་།",
    "དེར་ལི་ཙུན་ཞུས་ཁྲོས་ནས་ཁོ་རང་ལིང་ཀྲོའུ་རུ་བཀག་སྐྱིལ་བྱས་པ་དང་།",
    "ཁོ་རང་ཕྱིར་མ་འཁོར་གོང་མི་ཉག་རྒྱལ་ཁབ་ནུབ་པས་གོང་མས་ཁོ་རྒྱལ་སར་སྡོད་དུ་བཅུག་པ་དང་།",
    "རྒྱལ་ཁམས་ཤར་ནས་ནུབ་ཏུ་ལེ་དབར་ཁྲི་ལྷག་གདའ།",
    "ཁོ་རང་ཏ་ཞ་ཾལ་ཕོ་ཉར་ཆས་པའི་དུས་སུ་དེ་གར་ཧྲུའུ་ས་ཆའི་རས་དང་ཁྱུང་ཏུའུ་ཡི་སྨྱུག་མའི་དབྱུག་པ་མཐོང་བ་དང་།",
    "ཏེན་རྒྱལ་ཁབ་ཀྱི་རྒྱལ་པོས་དང་ཐོག་ནས་ཧན་ལ་རྣམ་འགྱུར་བཟང་པོ་བཅངས་མྱོང་གཤིས་ཁོ་རང་མ་བསད་པར་བསྐྱུར་བ་ལ།",
    "རྗེ་བོ་དེ་དག་ཚང་མས་དམག་དཔུང་རང་སར་བཏང་ནས་མགོ་བཏགས།",
    "ཝན་ཉན་ཕྱིཪ་དགྲར་འཐབ་ཏུ་ཆས་པ་དང་ཁྲེན་ལི་ཡིས་དམག་སྣེ་ཁྲིད་ནས་ཁོ་རང་བསྐྱབས།",
    "ཁྲེན་ལིས་དེ་ལྟར་ནུབ་ཕྱོགས་མི་རིགས་བཏུལ་བར་བརྟེན་གོང་མས་ཁོ་རང་རྒྱལ་སར་བཀུག་པ་ཀུན་དུ་ཇག་རྐུན་ལྡང་བ་དང་སྐབས་ཁེལ་བས་གོང་མས་ཡང་བསྐྱར་ཁྲེན་ལི་པ་ཀུན་གྱི་ཐའེ་ཧྲོའུ་དཔོན་པོར་བསྐོས།",
    "གནམ་གྱི་སྲས་ཀྱིས་ཁོར་རྒྱལ་པོའི་ཐམ་ག་ལུང་བུ་དང་བཅས་པ་བསྩལ་བ་དང་ཕྱིས་སུ་ཁོ་རང་སྲོག་ཐོག་ཏུ་བཏང་།",
    "འདིའི་ཀྲུའུ་ཞེས་པ་ནི་སྨྱུག་མ་ཞེས་པའི་དོན་ཏེ་ཁོ་རང་སྨྱུག་མའི་ཁོག་ནས་བྱུང་བས་དེ་ལྟར་བཏགས།",
    "མི་འབོར་ལྔ་འབུམ་ལྔ་ཁྲི་སུམ་སྟོང་བདུན་བརྒྱ་བཅུ་གཅིག་གདའ།",
    "ལིའུ་ཁྲུང་རང་།",
    "ཁོ་རང་ནམ་འཆི་ཙམ་ཡང་མི་ཤེས།",
    "ས་བོན་དེ་དག་དུས་དང་ཚིགས་སུ་ཞིང་ལ་བཏབ་སྟེ་དུས་དུས་སུ་ཆུས་བཅུས།",
    "དེ་ལས་མང་ཙམ་ཡོད་ན་ཁོ་བོ་གསོད་པ་འདུག་ཟེར་ལྐོག་ལབ་བྱས་ནས་བསྡད་པས།",
    "རྗེས་སུ་བརྒྱ་བྱིན་གྱིས་དེ་གང་དུ་སྐྱེས་འདུག་བརྟགས་པ་ན།",
    "ར་དེས་གཞན་གཉིས་ལ་བདག་ཅག་གསུམ་གསོད་པར་འདོད་འདུག་ཅེས་སྨྲས་པར།",
    "ཕ་རོལ་པོས་བློས་མ་ཐོངས་ཀྱང་རང་ལ་ནོར་རྫས་དེ་དང་དེ་ཐོབ་འདོད་ཀྱི་བསམ་པས།",
    "བ་དང་འབྲེལ་ན་བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བའི་སྡིག་ལྟུང་གཉིས་ཀ་འབྱུང་ཞིང་།",
    "ད་ནི་སྐྱེ་བ་ཕྱི་མའི་དོན་ཞིག་བསྒྲུབ་དགོས་པ་འདུག་སྙམ་དུ་དེ་ཕྱིན་ཆད་ཕྱི་མ་དོན་གཉེར་གཙོ་བོ་དང་།"
  ]
}