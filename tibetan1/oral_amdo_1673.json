    "དེ་ཡང་བྱ་རྫོགས་ཀྱི་སྐད་ཅིག་མ་ཡིན་པ་ཡང་སེམས་ཀྱི་སྐད་ཅིག་བཅུ་དྲུག་པོ་འདི་དག་ནི་མཐོང་བའི་ལམ་མོ།",
    "ཀུན་ནས་ཉོན་མོངས་པས་ཇི་ལྟ་བུ་ཞེ་ན་ཞེས་སོགས་ཀྱིས།",
    "མ་རིག་པ་བཞིས་བསམ་གཟུགས་ཀྱི་དངོས་གཞི་རྣམས་ཉོན་མོངས་པར་བྱེད་ཚུལ་དེ་འཆད།",
    "མོས་པ་ལས་བྱུང་བ་དང་རབ་ཏུདབེན་པ་ལས་བྱུང་བ་དང་།",
    "ཡིད་བྱེད་འདི་ལ་ཟག་བཅས་ཟག་མེད་གཉིས་སུ་ཕྱེ་བའི་ཟག་མེད་དེས་སྤང་བྱ་ཅིག་ཅར་རྒྱུན་ཞུགས་ཀྱིས་ཁམས་གསུམ་གྱི་ཉོན་མོངས་ཅིག་ཅར་དུ་སྤོང་བའི་སེམས་རྟེན་བྱེད་ཀྱི་བསམ་གཏན་ཉེར་བསྡོགས་མཚན་ཉིད་སོ་སོར་རིག་པ་སོགས་ག་ལ་ཟག་མེད་འཇོག་དཀའ་བ་འདྲ་སྟེ་དཔྱད་དོ།",
    "རེ་རེ་བར་དུ་བཞག་པའི་ཐོད་རྒལ་ལུགས་མཐུན་དུ་སྙོམས་པར་འཇུག་པ་ནི།",
    "སྐབས་འདིར་བསམ་གཟུགས་ཀྱི་སྙོམས་འཇུག་གིས་བསྡུས་པའི་འཇིག་རྟེན་པའི་སྒོམ་ལམ་ཙམ་བསྟན་པ་ནི།",
    "འདོད་ཉོན་མངོན་འགྱུར་བ་སྤངས་ན་འདོད་པའི་སས་བསྡུས་ཀྱི་གང་ཟག་གི་བདག་འཛིན་མངོན་གྱུར་བ་སྤངས་དགོས་པ་གང་ཞིག།",
    "གང་ཟག་གི་བདག་དེ་བདག་འཛིན་དེའི་ཞེན་ཡུལ་ཡིན་པའི་ཕྱིར།",
    "བདེན་བཞིའི་གནས་ལུགས་མངོན་སུམ་དུ་མཐོང་བ་ལ་སྐྲག་རིགས་པ་ལ་མི་སྐྲག་པའི་བཟོད་པ་མཐོང་ལམ་གྱི་དུས་སུཐོབ་པ་འདས་ནས་ཡུན་རིང་དུ་སོང་བའི་ཕྱིར།",
    "འོ་ན་འགོག་སྙོམས་ཀྱང་སྲིད་རྩེའི་སེམས་ལ་བརྟེན་པ་མེད་པར་ཐལ་ཏེ།",
    "ཡུལ་ཅན་ཤེས་པ་གང་གི་ཡུལ་ཡིན་པ་དང་།",
    "བསམ་བྱུང་གི་ཤེས་རབ་བསྐྱེད་པའི་ཐབས་དང་།",
    "སྒོམ་བྱུང་གི་མངོན་རྟོགས་འཇུག་པའི་རིམ་པ་དང་།",
    "སྤྱོད་པ་རྣམ་སྦྱོང་གི་དམིགས་པ།",
    "ཉོན་མོངས་རྣམ་སྦྱོང་གི་དམིགས་པ་རྣམས་ཡོད་པའི་ཕྱིར།",
    "གསུམ་པ་སྒོམ་བྱུང་གི་མངོན་རྟོགས་འཇུག་པའི་རིམ་པ་ཡོད་དེ།",
    "དེ་ལ་མོས་པའི་དགེ་རྩ་མ་སད་པ་དང་།",
    "ངོ་བོ་ཉིད་མེད་པར་སྨྲ་བ་ན་རེ།",
    "རང་གི་བདག་ཉིད་དུ་མེད་པ་དང་།",
    "རང་གི་ངོ་བོ་ལ་མི་གནས་པ་དང་།",
    "བྱིས་པས་གཙང་བདེ་རྟག་པ་སོགས་སུ་བཏགས་པ་ལྟར་གྱི་ངོ་བོ་ཉིད་མེད་པ་ལ་དགོངས་ནས་དེ་ལྟར་གསུངས་ཤིང་དེར་མ་ཟད་ཀུན་བཏགས་ལ་རང་གི་མཚན་ཉིད་ཀྱིས་གྲུབ་པའི་ངོ་བོ་ཉིད་མེད་པ་དང་།",
    "ཡང་གོང་དག་གིས་ཤིན་ཏུ་རྒྱས་པ་ལ་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་དགོངས་པ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་དགོངས་པ་བཞི་སྟེ་མཉམ་པ་ཉིད་ལ་དགོངས་པ་དང་།",
    "གང་ཟག་གི་བསམ་ལ་དགོངས་པའོ།",
    "གང་དག་གིས་ཤིན་ཏུ་རྒྱས་པ་ལ་དེ་ཐོབ་པ་རྣམ་ངེས་ཀུན་བཏུས།",
    "བཞི་བ་གང་ཟག་གི་བསམ་པ་ལ་དགོངས་པ་ནི།",
    "གང་ཟག་གི་བདག་ཡོད་པར་གསུངས་པ་ལྟ་བུ།",
    "དོན་ཟབ་མོ་སྒྲ་ངན་པས་བསྒྱུར་ཏེ་གསུངས་པ་ལྟ་བུ།",
    "ལྷག་མཐོང་གི་ཕན་ཡོན་གཉིས།",
    "ཕྱི་མ་ཉན་ཐོས་ཀྱི་རྟོགས་པ་སྔོན་སོང་དུ་བཤད།",
    "དད་མོས་དང་མཐོང་ཐོབ་པ་གཉིས་ནས།",
    "འབྲས་གནས་ཀྱི་སྐབས་སུ་དད་མོས་པ་དང་མཐོང་ཐོབ་པ་ཞེས་བརྗོད་དོ།",
    "རྒྱུན་ཞུགས་འབྲས་གནས་ལ་མཐོང་སྤངས་ཉོན་མོངས་ཐམས་ཅད་སྤངས་པ་དགོས་ན་མཐོང་སྤངས་ཀུན་སྦྱོར་གསུམ་སྤངས་ནས།",
    "རེ་ལྟར་ཐོགས་ན་སྲིད་པ་ལན་བདུན་པ་གང་ཞེ་ན།",
    "ལྷ་དང་མི་རྣམས་ཀྱི་ནང་དུ་རིགས་ནས་རིགས་སུ་སོང་ནས་གང་སྡུག་བསྔལ་གྱི་མཐའ་མ་ཐོབ་པའོ།",
    "སྔ་མ་ཆགས་བྲལ་སྔོན་སོང་དུ་མི་རིགས་ཏེ།",
    "སྔ་མ་ཆགས་བྲལ་སྔོན་སོང་དུ་འདོད་པ་ནི་ཧ་ཅང་ཐལ་བའོ།",
    "ཡང་ཕྱིར་འོང་ལ་ཆགས་བྲལ་སྔོན་སོང་དེ་ཙམ་གྱིས་ཆོག་པ་སྦྱར་ནས་ཆགས་བྲལ་སྔོན་སོང་གི་ཕྱིར་འོང་ལ་ཆགས་བྲལ་སྔོན་སོང་གིས་མ་ཁྱབ་པར་བྱས་ནའང་འགལ་བ་མེད་དོ།",
    "ཕྱིར་འོང་གི་རྟེན་ལ་ཕྱིར་མི་འོང་གི་འབྲས་བུ་མངོན་དུ་བྱེད་པ་ཡོད་པའི་ཕྱིར།",
    "ལྟའི་སྲིད་པ་ལན་ཅིག་དང་མིའི་སྲིད་པ་ལན་ཅིག་སྐྱེས་པའི་ཚེ་ལན་ཅིག་ཕྱིར་འོང་གི་འབྲས་བུར་བཞག་གོ།",
    "ཐེ་ཚོམ་ཉོན་མོངས་ཅན་ཏེ་མཐོང་སྤངས་ཀུན་སྦྱོར་གསུམ་གྱི་སྟེང་དུ་འདོད་པ་ལ་འདུན་པ།",
    "རིང་མོ་ཞིག་ནས་འདའ་བ་དང་གསུམ་ཞོག་མའི་མེ་སྟག་གི་དཔེར་མཚོན་ནས་གསུངས་པའི་ཕྱིར།",
    "ལ་ལ་ནི་སྲིད་པའི་རྩེ་མོའི་བར་དུ་སོང་ནས་ལམ་མངོན་དུ་བྱས་ཏེ་སྡུག་བསྔལ་གྱི་མཐའ་མ་ཐོབ་པའོ།",
    "སྦྱོར་བ་གཅིག་གིས་དང་པོར་བསམ་གཏན་བཞི་པ་ཟག་མེད་ལ་སྙོམས་པར་འཇུག།",
    "སྦྱོར་བ་གཅིག་གིས་སྔར་བཞིན་དང་།",
    "འོ་ན་ཁམས་གསུམ་གྱི་ཉོན་མོངས་ཐམས་ཅད་སྤངས་པས་དགྲ་བཅོམ་པར་འགྱུར་ན།",
    "མོས་པས་སྤྱོད་པ་ཅན་གང་ཞེ་ན།",
    "མི་ལྕོགས་མེད་པ་ལ་རྟེན་ཏེ་འཇིག་རྟེན་ལས་འདས་པའི་ལམ་གྱིས་ཁམས་གསུམ་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་རྣམས་རྣམ་པས་ཅིག་ཅར་སྤོང་སྟེ།",
    "སྤང་བྱ་ཁམས་གསུམ་པའི་སྒོམ་སྤངས་ཉོན་མོངས་ཅིག་ཅར་དུ་སྤོང་བ།",
    "མཐར་ཐུག་གི་མངོན་རྟོགས།",
