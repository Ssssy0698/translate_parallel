    "སིད་པའི་ས་བྟོན་འགག་པར་འགྱུར།",
    "དངྟོས་པྟོ་མྲེད་པ་འདི་ནི་རྣམ་པར་ཤྲེས་པས་དམིགས་པར་བ་བའྟོ་ཞྲེས་པ་འདི་སྐད་དུ་བརྟོད་པར་བ་སྲེ།",
    "དངྟོས་པྟོའི་སྟོ་ལ་མི་ལྟྟོས་པར་དངྟོས་པྟོ་མྲེད་པ་འབའ་ཞིག་རྣམ་པར་ཤྲེས་པས་མི་དམིགས་སྟོ་ཞྲེས་བ་སྲེ།",
    "དཔྲེར་ན་སྔྟོན་པྟོའི་རྣམ་པར་ཤྲེས་པ་སྲེར་པྟོ་ལ་སྟོགས་པ་ལ་མི་ལྟྟོས་པ་བཞིན།",
    "དྟོན་དང་བཅས་པ་ནི་ལྷ་སྦྱིན་ལ་སྟོགས་པའི་སའྟོ།",
    "དམིགས་པ་མ་ཡིན་པ་ནི་དངྟོས་པྟོ་ཞྲེས་རྣམ་པར་མི་འཇིག་གྟོ།",
    "དྟོན་དངྟོས་པྟོ་མྲེད་པའི་སྟོ་ནས་དྟོན་མྲེད་པ་཈ིད་དུ་ངྲེས་པར་འགྱུར་ལ།",
    "ཐམས་ཅད་དུ་དམིགས་པས་གཏན་མྲེད་ཅྲེས་འཇིག་རྲེན་དུ་རྣམ་པར་འཇྟོག་གྟོ།",
    "དྲེ་བཞིན་དུ་དངྟོས་པྟོ་ལ་བརྲེན་ནས་སྔ་ན་མྲེད་པ་དང་གཅིག་ལ་གཅིག་མྲེད་པ་པ་རྣམས་འཇིག་རྲེན་པས་རྣམ་པར་བརགས་སྟོ།",
    "དངྟོས་པྟོ་མྲེད་པ་ཞྲེས་བ་བ་དངྟོས་པྟོ་ལ་ལྟྟོས་པ་འབའ་ཞིག་པ་རྣམ་པར་ཤྲེས་པས་འཛིན་པ་ནི་མདྟོ་དྲེ་཈ིད་ཀིས་ན།",
    "འཕགས་པ་ལྷས་གསུངས་པ།",
    "གྲུབ་པར་འགྱུར་བ་ག་ལ་ཞིག།",
    "ཅྲེས་གསུངས་སྟོ།",
    "རྣམ་པ་ཐམས་ཅད་དུ་དངྟོས་པྟོ་དང་དངྟོས་པྟོ་མྲེད་པ་ལ་ཀུན་ཏུ་འཛིན་པ་ཟད་པས་རྣམ་པར་ཤྲེས་པ་སྲེ་བ་མྲེད་པ་དང་མྱ་ངན་ལས་འདས་པ་འགྟོག་པ་རྣལ་འབྟོར་པ་རྣམས་ཀིས་ཐྟོབ་པར་འགྱུར་རྟོ།",
    "དྲེའི་ཕྱིར་འདིར་དངྟོས་པྟོ་མྲེད་པ་འབའ་ཞིག་ལ་དམིགས་པའི་རྣམ་པར་ཤྲེས་པ་མྲེད་ལ།",
    "གལ་ཏྲེ་དྲེ་དག་དམིགས་པར་བ་བར་མྲེད་ཀང་དྲེ་ལྟ་ན་ཡང་཈མས་སུ་མྱྟོང་བའི་ངྟོ་བྟོ་ཡིན་པའི་ཕྱིར་ངར་འཛིན་དང་ང་ཡིར་འཛིན་པ་འདི་དག་ནི་མྲེད་པའྟོ་ཞྲེས་བརྟོད་པར་མི་ནུས་སྟོ་ཞྲེ་ན།",
    "དྲེའི་ཕྱིར་གལ་ཏྲེ་རང་཈ིད་ཀིས་ངར་འཛིན་པ་དང་ང་ཡིར་འཛིན་པ་཈མས་སུ་མྱྟོང་ཡང་དྲེ་ལྟ་ན་ཡང་ཡྟོད་པར་ལུང་དང་རིགས་པ་དང་འགལ་བས་མྲེད་དྟོ་ཞྲེས་བའྟོ།",
    "བཅྟོམ་ལྡན་འདས་ཀིས་ཆྟོས་ཐམས་ཅད་བདག་མྲེད་པའྟོ་ཞྲེས་གསུངས་པས་བདག་ནི་མི་རག་པ་མ་སྲེས་པ་ངར་འཛིན་པའི་ཡུལ་ཏྲེ།",
    "ཅི་ཁྱྟོད་ནི་བདག་མྲེད་པ་ལ་ཕྱིན་ཅི་ལྟོག་ཏུ་སྟོ་འདྟོགས་པར་བྲེད།",
    "དྲེའི་རང་བཞིན་མ་ཡིན་པ་཈ིད་ཀིས་ཆྟོས་ཐམས་ཅད་བདག་མྲེད་པ་཈ིད་དུ་རྣམ་པར་གཞག་པ་མ་ཡིན་ནྟོ།",
    "དྲེ་ནི་མངྟོན་པར་ཞྲེན་པའི་གནས་སུ་གྱུར་པའི་ཕྱིར་འདིར་བསལ་བར་བའྟོ།",
    "གལ་ཏྲེ་མུ་སྲེགས་བྲེད་ཀིས་ཡྟོངས་སུ་བརགས་པའི་བདག་འདིར་འགྲེགས་པར་མི་བྲེད་ན།",
    "དྲེ་ལྟ་ན་བཅྟོམ་ལྡན་འདས་ཀིས་ཅི་ཞིག་དགག་པའི་དྟོན་དུ་འདི་སྐད་གསུངས།",
    "ཤྭའི་ས་ནི་ག་པ་ལ་སྟོགས་པར་དཔྱད་པ་སྲེ།",
    "འྟོ་ན་དྲེ་ལྟ་ན་མིག་཈ིད་མྲེད་དྟོ་ཞྲེས་སྨྲས་པར་འགྱུར་བས།",
    "ཅིའི་ཕྱིར་མིག་མྲེད་པར་འཇིག་རྲེན་པ་སྨྲའམ།",
    "ད་ནི་བསན་བཅྟོས་ལས་ཀང་མིག་མྲེད་དྟོ་ཞྲེས་བསན་པ་བསན་བཅྟོས་ཞྲེས་བ་བ་ཕྱིན་ཅི་མ་ལྟོག་པའི་ལམ་དྲེས་཈ྟོན་མྟོངས་པ་འཇིག་པར་བྲེད་པས་སྟོ།",
    "འདི་ལྟར་འཇིག་རྲེན་ན་གསྟོད་པ་ན་ཆད་པ་ཆྲེན་པྟོ་འཇིག་པར་བྲེད་དྟོ་ཞྲེས་ཟྲེར་ལ།",
    "ཁྟོང་དུ་ཆུད་པ་མྲེད་པས་མྲེད་པ་཈ིད་཈ྲེ་བར་སྟོན་པར་མི་འགྱུར་ཞྲེས་བ་སྲེ།",
    "རྣལ་འབྟོར་པ་རྣམས་དྲེ་ཁྟོང་དུ་ཆུད་པ་ལ་མངྟོན་པར་འདྟོད་པ་མྲེད་པའི་ཕྱིར་རྟོ།",
    "བཞིན་དུ་ཀུན་རྟོབ་ཏུ་ཕྱིན་ཅི་ལྟོག་མྲེད་ལ་དྟོན་དམ་པར་རང་བཞིན་མྲེད་པ་ནུས་པ་དང་ལྡན་ནྟོ་ཞྲེས་པ་ཡང་།",
    "སླུ་བ་མྲེད་པར་ཁས་བླངས་པའི་ཕྱིར་རྟོ་ཞྲེས་བའྟོ།",
    "འྟོན་ཀང་མིག་རང་བཞིན་མྲེད་པར་གནས་པ་཈ིད་ལ་འཇིག་རྲེན་པ་ཕྱིན་ཅི་ལྟོག་ཏུ་རྟོངས་པའི་རྣམ་པར་ཤྲེས་པ་ལ་མིག་རང་བཞིན་མྲེད་པར་གནས་ཀང་ལྟོགས་སུ་བཞག་ནས་རང་བཞིན་དང་བཅས་པར་རྟོགས་ལ།",
    "དྲེ་ལ་མངྟོན་པར་ཞྲེན་པས་འདི་དག་ཁྟོ་ན་བདྲེན་པར་ཡྟོད་གཞན་ནི་རྟོངས་པའྟོ་ཞྲེས་འདི་དག་བདྲེན་པར་མངྟོན་པར་ཞྲེན་པས་མཆྟོག་ཏུ་འཛིན་པ་ལུས་ཀི་མདུད་པ་སྲེད་པས་འཁྟོར་བར་འཁྟོར་རྟོ།",
    "གལ་ཏྲེ་དྲེ་ལྟར་མིག་རང་བཞིན་སྟོང་པར་བསྒྲུབས་ན།",
    "ལྷ་སྦྱིན་མྲེད་པ་཈ིད་ལ་ཁྱིམ་ཡྟོད་པ་཈ིད་དུ་རྟོགས་པས་གང་དུ་ག་཈ི་ག་ཡང་སྟོང་པར་མི་འདྟོད་ན།",
    "དྲེ་ནི་སྟོང་པ་཈ིད་དུ་མི་རུང་ངྟོ་ཞྲེས་འདིར་རྣམ་པར་རིག་པར་སྨྲ་བས་སྨྲས་པ།",
    "སྟོང་པ་དྲེས་ཅི་ཞིག་བ་སྲེ་དྲེས་སྟོང་པ་དང་དྲེ་཈ིད་ཀིས་སྟོང་པར་མི་རུང་ངྟོ་ཞྲེས་བའྟོ།",
    "དྲེ་ལ་ཡྟོངས་སུ་མ་དག་པ་ནི་འཁྟོར་བ་ཐྟོག་མ་མྲེད་པ་ནས་གྟོམས་པ་པའི་གཟུང་བ་དང་འཛིན་པར་ཡྟོངས་སུ་བརགས་པའི་དྲི་མས་བསྟོས་པའྟོ།",
    "ཇི་སྐད་དུ་མདྟོ་ལས་གསུངས་པ་གང་ཞིག་གང་ན་མྲེད་པ་དྲེ་ནི་སྟོང་ལ་གང་ཡང་འདིར་ལྷག་མ་དྲེ་ནི་ཡྟོད་པ་ལ་འདིར་ཡྟོད་དྟོ་ཞྲེས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་རབ་ཏུ་ཤྲེས་སྟོ་ཞྲེས་འདི་སྐད་སྨྲ་ན་སྟོང་པ་཈ིད་ལ་ཕྱིན་ཅི་མ་ལྟོག་པར་ཞུགས་པའྟོ།",
    "སྲེས་པ་཈ིད་ཀང་ངྲེས་པར་གཟུང་བར་མི་ནུས་ན་ཁྱད་པར་བརག་པར་ནུས་པ་མ་ཡིན་ནྟོ།",
    "ཕ་རྟོལ་པྟོས་འདི་ཞྲེས་པ་དྲེ་ལས་སྲེ་བཞིན་པའྟོ་ཞྲེས་པའི་ཁྱད་པར་ངྲེས་པར་གཟུང་བར་མི་ནུས་ལ།",
    "གལ་ཏྲེ་རྲེ་ཞིག་འདི་ཡྟོད་པར་གྱུར་ན།",
    "མུ་སྲེགས་བྲེད་ཀིས་བརགས་པའི་བདག་ཀང་ཡྟོད་པར་འགྱུར་ལ།",
    "འདི་ནི་རྲེ་ཞིག་བདག་ཡྟོད་པར་ཡང་མི་འཐད་དྲེ།",
    "དྲེའི་ཕྱིར་གལ་ཏྲེ་རིགས་པ་དང་འགལ་བ་གཅིག་པྟོ་ཡྟོད་ཅིང་འཁྟོར་བ་དང་མྱ་ངན་ལས་འདས་པའི་རྒྱུར་རྟོག་ན་ག་཈ིས་པ་ཡང་བརག་པར་བའྟོ།",
    "དྲེ་ལྟ་ན་གང་ཞིག་བཅྟོམ་ལྡན་འདས་ཀིས་གསུངས་པ།",
    "གང་ཡང་འདིར་ལྷག་མ་ཡྟོད་པ་དྲེ་ནི་ཡྟོད་དྟོ་ཞྲེས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤྲེས་སྟོ་ཞྲེས་ཐྟོས་པ་དྲེ་ཇི་ལྟར་གསུངས།",
    "གང་ཞིག་བིས་པ་རྣམས་དངྟོས་པྟོར་མངྟོན་པར་ཞྲེན་པའི་གནས་སུ་གྱུར་པ་དྲེ་ཡང་བིས་པའི་སྲེ་བྟོའི་བླྟོའི་སྟོད་ཡུལ་ལ་རྣམ་པ་དྲེ་ལྟ་བུའི་དངྟོས་པྟོར་གྱུར་པ་བརྫུན་པ་སླུ་བའི་ཆྟོས་ཅན་ནི་ཡྟོད་ལ་དྲེའི་རང་བཞིན་ནི་མྲེད་དྟོ།",
    "ཇི་སྐད་དུ་བཅྟོམ་ལྡན་འདས་ཀིས་གསུངས་པ།",
    "དྲེ་ལ་མི་གནྟོད་པས་ཆད་པར་སྨྲ་བའམ་མྲེད་པ་཈ིད་མི་ལྟུང་ལ།",
    "ཕྱིན་ཅི་ལྟོག་བདག་཈ིད་ངན་པ་ལ་རྣམ་པར་རྟོལ་པའི་གྟོ་འཕང་ལ་ཞུགས་པས་ད་གདྟོད་སྟོས་པ་཈ིད་ལས་རྒྱས་པ་གསལ་བར་རྲེན་ཅིང་འབྲེལ་བ་རང་བཞིན་མྲེད་པ་སྒྲུབ་བྲེད་ཀི་མིང་ཐྟོས་པ་ལྟ་བུར་རླྟོམ་སྲེམས་ནས་འདྲི་བ་ལ་འཇུག་པ་ཀྲེ་མ་ངྟོ་མཚར་ཏྟོ།",
    "དྲེའི་ཕྱིར་གང་ཞིག་གང་ན་མྲེད་པ་དྲེ་ནི་དྲེས་སྟོང་པ་཈ིད་དུ་སྨྲ་བ་རྣམས་ཀིས་དྲེ་ལྟར་ཡང་དྟོན་རྣམ་པར་ཕྱྲེ་བའི་ཕྱིར་དྲེ་རྣམས་སྟོང་པ་཈ིད་ལ་ཕྱིན་ཅི་ལྟོག་ཏུ་ཁྟོང་དུ་ཆུད་པ་མ་ཡིན་ནྟོ།",
    "གང་ཞིག་དྲེའི་ཚེ་རང་བཞིན་མྲེད་པ་ལ་སྟོ་འདྟོགས་པར་བྲེད་པ་དང་སྒྱུ་མ་དང་མཚུངས་པ་བས་པ་ནི་མྲེད་དྟོ་ཞྲེས་སྨྲ་བ་དྲེ་ནི་ངྲེས་པར་ཕུང་བར་འགྱུར་རྟོ།",
    "འདི་ལྟར་རྣམ་རིག་ཏུ་སྨྲ་བ་དྲེ་རྣམས་ལ་སྟོང་པ་཈ིད་ཕྱིན་ཅི་ལྟོག་པར་རྟོགས་པ་མྲེད་དྟོ་ཞྲེས་བ་སྲེ།",
    "རག་པ་བརན་པ་ཐྲེར་ཟུག་པ་ཡྟོངས་སུ་མི་འགྱུར་བའི་ཆྟོས་ཅན་མ་ཡིན་པས་མིག་སྟོང་ངྟོ་ཞྲེས་པར་འབྲེལ་ཏྟོ།",
    "ལས་ཡྟོད་ཅིང་ལས་ཀི་རྣམ་པར་སིན་པ་ཡྟོད་ལ།",
    "མིག་ཇི་ལྟ་བར་གནས་པ་ལ་མངྟོན་པར་ཞྲེན་པ་མ་བཀག་ན་རག་པའི་བདག་བཀག་ཀང་མིག་ལ་སྟོགས་པར་མངྟོན་པར་ཞྲེན་པའི་བ་སྤུ་ཡང་འགུལ་བར་ནུས་པ་མ་ཡིན་ནྟོ།",
    "རི་དྭགས་དང་བ་ལ་སྟོགས་པ་བདག་རག་པ་མི་དམིགས་ཀང་དྲེར་ཞྲེན་པས་དྲེའི་ཕྱིར་འདིར་རག་པའི་བདག་བཀག་པའི་སྟོ་ནས་མིག་བདག་མྲེད་པར་འཇྟོག་པ་ནི་མ་ཡིན་ནྟོ།",
    "གང་ཡང་དྲེ་ལྟར་ཅི་སྐད་གསུངས་པའི་རིགས་པས་བདག་མྲེད་པས་དྲེའི་ཚེ།",
    "ག་཈ྲེན་པྟོ་མྲེད་པའི་ཕྱིར་བདག་མྲེད་པ་཈ིད་ཀང་ཡྟོད་པ་མ་ཡིན་ནྟོ་ཞྲེས་གསུངས་ལ།",
    "཈ྲེ་བར་ལྲེན་པ་པྟོ་མྲེད་ན་཈ྲེ་བར་བླངས་པ་མྲེད་པས་གཟུགས་ལ་སྟོགས་པ་མ་གྲུབ་པའི་ཕྱིར་ཞྲེས་གསུངས་པ།",
    "གསུངས་པ།",
    "དྲེའི་ཚེ་ཕན་ཚུན་ལྟྟོས་པ་འགྲུབ་པར་འགྱུར་ལ།",
    "འགའ་ཡང་མྲེད་ཅྲེས་པའི་འགག་པ་འདི་ཇི་ལྟར་ཕྱིས་དྲེ་མ་ཐག་པའི་བརྟོད་པ་འགའ་དང་མངྟོན་པར་འབྲེལ་ལ།",
    "དྲེ་བཀག་ན་བདག་དང་བདག་མྲེད་པ་ག་ལ་འབྱུང་ཞྲེས་སྒྲུབ་བྲེད་གསུངས་པ།",
    "བདག་དང་བདག་མྲེད་པ་ལས་ཐ་དད་པའི་རང་བཞིན་མ་གྲུབ་པའི་ཕྱིར་བདག་དང་བདག་མྲེད་པ་མ་ཡིན་པ་འགའ་ཡང་མྲེད་དྟོ་ཞྲེས་གསུངས་པ།",
    "ཆྟོས་ཐམས་ཅད་ནི་མིང་ཙམ་མྟོ་ཞྲེས་རྣམ་པར་གཞག་པ་ན་མུ་སྲེགས་པས་སྨྲས་པ།",
    "དྲེ་དག་ལ་ལྟྟོས་ནས་གསུངས་པ་བདག་མྲེད་མིན་ནྟོ།",
    "ཇི་ལྟར་མྲེད་པ་དྲེ་ལྟར་ཡང་སྔར་཈ིད་དུ་རྒྱས་པར་བསྒྲུབས་སྟོ།",
    "ཡྟོད་པ་མ་ཡིན་ནྟོ་ཞྲེས་སྒྲུབ་པར་བྲེད་པ་གསུངས་པ།",
    "ཡང་ན་གནས་པ་ལ་སྟོགས་པ་མྲེད་པར་བསྒྲུབས་པས།",
    "དྟོན་མྲེད་པའི་ཕྱིར་ས་ཡང་མྲེད་པར་ཟླ་གགས་ཆུང་བ།",
    "བརྟོད་པ་མྲེད་པར་གྱུར་ན་ཡང་བརྟོད་བའི་དྟོན་གྲུབ་པ་མྲེད་དྟོ་ཞྲེས་གནས་སྟོ།",
    "སྒྱུ་མའི་རི་དྭགས་ཀི་ཤས་བཀྲེས་པ་཈ྲེ་བར་ཞི་བར་བྲེད་པར་མི་ནུས་སྟོ།",
    "ཇི་སྐད་དུ་བཅྟོམ་ལྡན་འདས་ཀིས་གང་ངྲེས་པར་འདི་ནི་སྡུག་བསྔལ་མ་ལུས་པ་སྤྟོངས་བ།",
    "བྟོར་བ་བང་བར་གྱུར་པ་ཟད་པ་འདྟོད་ཆགས་དང་འབལ་བ་འགྟོག་པ་཈ྲེ་བར་ཞི་བ་ནུབ་པར་འགྱུར་བ་སྡུག་བསྔལ་གཞན་དུ་཈ིང་མཚམས་མི་སྦྱྟོར་བ།",
    "འདི་ལྟར་མྱ་ངན་ལས་འདས་པའི་རང་བཞིན་ཅི་ཡང་མྲེད་པ་དྲེ་ལྟར་ཆྟོས་ཐམས་ཅད་ཀི་རང་བཞིན་ཅི་ཡང་མྲེད་པས་དྲེའི་ཕྱིར་ཆྟོས་རྣམས་ཀི་དྲེ་ཁྟོ་ན་཈ིད་ཕྱིན་ཅི་མ་ལྟོག་པར་བསྲེན་པ།",
    "གང་ཞིག་ཆྟོས་ཐམས་ཅད་ཀི་རང་བཞིན་མྱ་ངན་ལས་འདས་པ་དང་མཚུངས་པར་བརྟོད་པར་བའྟོ།",
    "གང་ཞིག་མཐྟོང་བ་ལས་འཕགས་པ་རྣམས་རྣམ་པར་གྟོལ་ལྟོ།",
    "མྟོས་པ་མྲེད་པ་དད་པ་མྲེད་པ་སིག་པའི་གྟོགས་པྟོ་དང་འབྲེལ་པ་ཐྟོས་པ་ཆུང་བ་ལྲེ་ལྟོ་ཅན་རྟོངས་པ་ལ་སྟོགས་པ་དང་ལྡན་པས་དྲེ་རྟོགས་པར་འགལ་བས་དྲེས་འདི་མི་མཐྟོང་སྲེ།",
    "སྦྱིན་པ་དང་སྟོ་བ་དང་ཐྟོས་པ་མང་བ་དགྲེ་བའི་བཤྲེས་ག་཈ྲེན་བརྲེན་པ་དད་པ་དང་མྟོས་པ་ལ་སྟོགས་པ་སྟོ་སྟོར་བརྲེན་པར་བའྟོ་ཞྲེས་བ་སྲེ།",
    "དྲེ་ལྟར་ཐབས་དང་བཅས་གང་རིགས་པས་ངྲེས་པར་ཡྟོད་ན་ཆྟོས་རྣམས་ཀི་རང་བཞིན་མངྟོན་སུམ་཈ིད་དུ་འགྱུར་རྟོ།",
    "འཕགས་པས་཈ྲེ་བར་བསན་པའི་ཕྱིར་གསུངས་པ།",
    "རྒྱུའི་དངྟོས་པྟོ་འབའ་ཞིག་ཙམ་དུ་཈ྲེ་བར་འགྟོ་བས་འདི་ལ་རྲེན་཈ིད་དུ་རྣམ་པར་འཇྟོག་གྟོ།",
    "འདིའི་རྒྱུ་དང་རྲེན་དུ་འགྱུར་ན་རྟོགས་པར་བྲེད་པ་ནི་རྒྱུའི་དངྟོས་པྟོར་གནས་ལ།",
    "འདི་ལྟ་སྲེ་རྣམ་པར་ཤྲེས་པའི་དམིགས་པའི་རྲེན་ནྟོ།",
    "ཚོགས་པ་ནི་དངྟོས་པྟོ་དྲེ་དག་མ་ཚང་བ་མྲེད་པར་཈ྲེ་བར་གནས་པ་ལས་སྲེའི་གཞན་དྲེ་མ་ཐག་པ་཈ྲེ་བར་གནས་པ་ལས་མ་ཡིན་པས་རྒྱུ་རྲེན་ཚོགས་པར་འདིར་རྟོགས་པར་བའྟོ།",
    "གལ་ཏྲེ་འདིར་དངྟོས་པྟོ་རྣམས་ཀི་རང་བཞིན་འགའ་ཞིག་ཡྟོད་ན་དྲེ་ངྲེས་པར་འདུས་བས་སམ་འདུས་མ་བས་སུ་ཡྟོད་པར་འགྱུར།",
    "འདུས་བས་རྣམས་ནི་རྒྱུ་དང་རྲེན་ལས་སྲེ་བའི་ཕྱིར་ན་སྲེ་བ་རྒྱུ་དང་རྲེན་ལ་རག་ལས་པར་འགྱུར་ལ།",
    "གང་ཞིག་གང་ལ་མྲེད་པར་དྲེ་དྲེ་ལས་མི་སྲེ་སྲེ།",
    "འདི་ནི་རྒྱུ་ལ་སྟོགས་པ་ལས་སྲེ་བར་འདྟོད་ན་ངྲེས་པར་རྒྱུ་ལ་སྟོགས་པ་ལ་རང་བཞིན་ཡྟོད་པ་཈ིད་དུ་ཁས་བླང་བར་བ་ན།",
    "ཅི་ཕྱིར་མངྟོན་པར་འབྱུང་མི་འགྱུར།",
    "དྲེའི་ཕྱིར་འབས་བུ་ཡྟོད་པ་཈ིད་ཀི་སྟོན་ཁྟོ་བྟོ་ལ་མྲེད་ཅིང་མྲེད་པ་཈ིད་ཀང་བརྟོད་པར་མི་ནུས་ཏྲེ།",
    "དྲེ་སྲེད་པའི་ནུས་པ་ཡྟོད་པའི་ཕྱིར་དྲེ་ལྟར་དྲེ་ནི་རྒྱུ་ལ་སྟོགས་པ་ལ་འབས་བུ་ཡྟོད་པ་དང་མྲེད་པ་཈ིད་ཀི་བསམ་པ་སྤངས་ཏྲེ་རྒྱུ་ལས་འབས་བུ་སྲེའྟོ་ཞྲེས་པ་འདིས་རྲེ་ཞིག་སྲེ་བ་གྲུབ་པར་རྣམ་པར་འཇྟོག་གྟོ།",
    "སྲེ་བ་གྲུབ་པར་གནས་པས་འགག་པ་གྲུབ་པར་འགྱུར་ཏྲེ།",
    "ཡྟོད་བཞིན་པའི་ཕྱིར་ད་ལྟ་བའི་རྣམ་པར་ཤྲེས་པ་བཞིན་སྲེ་བ་མ་ཡིན་ནྟོ་ཞྲེས་བ་སྲེ།",
    "དངྟོས་པྟོ་རྣམས་མྱ་ངན་ལས་འདས་པ་དང་མཚུངས་པར་རང་བཞིན་མྲེད་པར་གྲུབ་བྟོ།",
    "གལ་ཏྲེ་ཡང་དྲེ་ལྟར་ཡྟོད་པ་ལས་སྲེ་བའམ་མྲེད་པ་ལས་སྲེ་ཞྲེས་སྨྲ་བར་མི་ནུས་ཀང་དྲེ་ལྟ་ན་ཡང་སྲེའྟོ་ཞྲེས་བ་བ་འདི་ནི་རྲེ་ཞིག་སྲེ་བྟོ་བ་ལང་རི་མྟོའི་བར་ལ་གགས་པར་ཡྟོད་ལ།",
    "སྲེས་པ་དང་མ་སྲེས་པ་དང་སྲེ་བཞིན་པའི་བསྲེད་པ་མངྟོན་པར་འདྟོད་པ་རྣམས་ཀི་སྲེས་པ་དང་མ་སྲེས་པ་བསྲེད་བཞིན་པའི་བསྲེད་བ་཈ིད་མི་སིད་དྟོ་ཞྲེས་བསན་པའི་ཕྱིར་གསུངས་པ།",
    "དྲེའི་ཚེ་གྲུབ་པ་ལ་སྒྲུབ་པར་འགྱུར་ལ་ནམ་ཡང་བསྲེད་བ་མ་ཡིན་པར་མི་འགྱུར་རྟོ་ཞྲེས་བ་སྲེ།",
    "གང་ཞིག་ཅིའི་ངྟོ་བྟོ་ཡང་མ་ཡིན་པ་དྲེ་ནི་ངྲེས་པར་གཟུང་བའི་ངྟོ་བྟོར་མྲེད་པའི་ཕྱིར་འདི་ཞྲེས་བ་བ་དྲེ་ལས་སྲེའྟོ་ཞྲེས་པའི་བྲེ་བག་བསན་དུ་མྲེད་པས་མ་སྲེས་པ་ཡང་བསྲེད་བ་མིན་ནྟོ།",
    "དྲེའི་ཚེ་བསྲེད་བ་མྲེད་པས་འདི་དག་བསྲེད་པར་ག་ལ་འགྱུར་ཞྲེས་པ་དྲེ་ལྟར་འགྱུར་རྟོ།",
    "ཡྟོད་ན་བསྲེད་བ་ཡྟོད་པར་འགྱུར་ལ།",
    "ཡྟོད་པ་མ་ཡིན་ནྟོ་ཞྲེས་བསན་པའི་ཕྱིར་གསུངས་པས།",
    "མྱུ་གུའི་རྒྱུར་རྣམ་པར་མི་འཇྟོག་སྲེ།",
    "ས་བྟོན་ལ་རྣམ་པར་འཇྟོག་སྲེ་མྱུ་གུ་ཞྲེས་བ་བའི་འབས་བུ་དང་ལྡན་པའི་ཕྱིར་རྟོ།",
    "དྲེས་ན་འབས་བུ་ཡྟོད་ན་འབས་བུ་དང་ལྡན་པར་འགྱུར་རྟོ་ཞྲེས་བ་སྲེ།",
    "དྲེའི་ཚེ་འདི་སུའི་ཁྱད་པར་ཡིན་པས་གཟུང་བར་མ་གྱུར་པས་སུ་ཞིག་འབས་བུ་དང་ལྡན་ཞྲེས་བའྟོ།",
    "ག་཈ིས་ནི་ད་ལྟར་བསྲེད་པར་བྲེད་ལ་ད་ལྟར་བ་དང་འདས་པ་ལ་ནི་ག་཈ིས་ཀིས་སྟོ།",
    "གཅིག་ནི་འདས་པས་བསྲེད་དྟོ་ཞྲེས་ཆྟོས་མངྟོན་པ་ལས་རྣམ་པར་གཞག་པའི་ཕྱིར།",
    "ད་ལྟར་བསྲེད་པའི་འབས་བུ་སར་བསྲེད་པར་མི་ནུས་སྟོ།",
    "རྣམ་པར་སིན་པའི་རྒྱུ་ནི་འདས་པ་཈ིད་ཀིས་འབས་བུ་འབིན་ཏྟོ།",
