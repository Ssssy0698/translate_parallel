    "རྣམ་པར་ཤྲེས་པ་དྲེའི་རྣམ་པར་བསྲེད་པའི་ཕྱིར་རྟོ།",
    "དྲེའི་རྣམ་པར་ཤྲེས་པ་དྲེ་མི་རག་པའི་དངྟོས་པྟོ་ལ་མ་ཡིན་ཏྲེ།",
    "དྲེ་དྲེའི་རྣམ་པར་མ་སྲེས་པའི་ཕྱིར་རྟོ།",
    "དྲེས་ན་རྣམ་པར་ཤྲེས་པ་དྲེ་ཡང་མི་རག་པ་ལ་མ་ཡིན་ཏྲེ།",
    "ཡྟོད་པ་ལ་རག་པའི་རྣམ་པར་འཛིན་པས།",
    "རག་པར་འཛིན་པ་ཇི་ལྟར་ཕྱིན་ཅི་ལྟོག་སྨྲས་པ།",
    "དངྟོས་པྟོ་མི་རག་པར་གནས་པ་ལ་རག་པའི་རྣམ་པར་འཛིན་པས་ཕྱིན་ཅི་ལྟོག་པ་ཞྲེས་བའྟོ།",
    "སར་ཡང་དངྟོས་པྟོ་མི་རག་པའི་རྣམ་པར་གནས་སྟོ་ཞྲེས་དྲེ་ཇི་ལྟར་དྲེ་ལྟར་རྟོགས།",
    "རྣམ་པར་ཤྲེས་པ་ལ་གགས་པའི་རྣམ་པ་དྲེ་ལས་དངྟོས་པྟོ་རྣམ་པར་འཇྟོག་སྲེ།",
    "དྲེའི་ཚེ་མི་རག་པའི་རྣམ་པ་ན་དྲེའི་རྣམ་པར་ཤྲེས་པས་དངྟོས་པྟོ་གང་ཞིག་འཛིན་པར་ག་ལ་འགྱུར།",
    "གཞན་ཞིག་ན་དྲེའི་རྣམ་པར་ཤྲེས་པ་མ་སྲེས་པའི་ཕྱིར་མི་སང་བ་཈ིད་ལ།",
    "གང་དུ་མ་རིག་པ་མྲེད་པར་འདུ་བྲེད་རྣམས་མི་འབྱུང་ལ།",
    "དྲེ་བཞིན་དུ་རྣམ་པར་ཤྲེས་པ་མྲེད་པས་མིང་དང་གཟུགས་བཀག་པ་སྲེ།",
    "རྲེ་ཞིག་ཁྟོ་ནར་འདི་དག་མྲེད་དྟོ་ཞྲེས་རྣམ་པར་གཞག་པར་མི་ནུས་ཏྲེ།",
    "དྲེ་སྐད་དུ་ཡང་བཅྟོམ་ལྡན་འདས་ཀིས་གསུངས་པ།",
    "མ་རིག་པའི་རྲེས་སུ་འགྟོ་བའི་གང་ཟག་འདི་དག་ནི་བསྟོད་ནམས་ཀི་འདུ་བྲེད་ཀང་མངྟོན་པར་འདུ་བྲེད་དྟོ།",
    "བསྟོད་ནམས་མ་ཡིན་པའི་འདུ་བྲེད་ཀང་མངྟོན་པར་འདུ་བྲེད་དྟོ།",
    "ལུང་དུ་མ་བསན་པའི་འདུ་བྲེད་ཀང་མངྟོན་པར་འདུ་བྲེད་དྟོ་ཞྲེས་སྟོ།",
    "ཇི་ལྟར་མྲེད་པ་དྲེ་ལྟར་བསྒྲུབ་པའི་ཕྱིར་གསུངས་པ།",
    "གལ་ཏྲེ་མ་རིག་པ་འདུ་བྲེད་རྣམས་ཀི་རྒྱུར་རྣམ་པར་གཞག་པ་ནི་འདི་ལྟར་འདུ་བྲེད་མྲེད་པའི་ཕྱིར་དྲེ་མྲེད་ལ།",
    "དྲེའི་ཕྱིར་རྒྱུའི་རྣམ་པར་གཞག་པ་འབས་བུ་མྲེད་ན་མ་ཡིན་ལ་རྒྱུ་ཡང་མ་རིག་པ་ནི་འདུ་བྲེད་རྣམས་ཀིའྟོ་ཞྲེས་བ་སྲེ།",
    "རྒྱུའི་ས་མྲེད་ཀང་རྒྱུ་཈ིད་དུ་རྟོགས་པ་཈ིད་ཀི་འབས་བུ་རྒྱུའི་སས་མ་གསུངས་སྟོ།",
    "གང་ཡང་འདི་ལྟར་རྒྱུ་དང་འབས་བུ་དག་ཕན་ཚུན་མ་ལྟྟོས་པར་གྲུབ་པ་མྲེད་ལ།",
    "གལ་ཏྲེ་རྒྱུ་དང་འབས་བུ་དག་ངྟོ་བྟོ་཈ིད་ཀིས་གྲུབ་པར་གྱུར་ན།",
    "དྲེ་ནི་འབས་བུ་ལ་མི་ལྟྟོས་པར་རྒྱུར་འགྱུར་ན།",
    "དྲེས་ན་ངྲེས་པར་འབས་བུ་ལ་ལྟྟོས་ལ།",
    "དྲེ་བཞིན་དུ་གལ་ཏྲེ་འབས་བུ་ངྟོ་བྟོས་གྲུབ་པར་གྱུར་ན།",
    "དྲེ་ནི་རྒྱུ་ལ་མི་ལྟྟོས་པར་འགྱུར་ལ།",
    "དྲེ་ནི་འདི་ལྟར་ཇི་སྐད་དུ་གསུངས་པའི་རིགས་པས།",
    "དྲེ་ཇི་ལྟར་རང་཈ིད་གྲུབ་པ་མྲེད་པར་འབས་བུ་སྲེད་པར་བྲེད།",
    "ཕན་ཚུན་མི་ལྟྟོས་པར་གྲུབ་པར་ཡྟོད་པར་གྱུར་ན།",
    "རྒྱུ་ལས་གཞན་པ་འབས་བུ་ལས་གཞན་པ་རྒྱུའི་ཞྲེས་འཐད་པར་འགྱུར་ལ།",
    "རྒྱུ་དང་འབས་བུ་དག་ཕན་ཚུན་མ་ལྟྟོས་པར་གྲུབ་པ་ཡྟོད་པ་མ་ཡིན་ནྟོ་ཞྲེས་བསྒྲུབས་ཟིན་ཏྟོ།",
    "དྲེས་ན་མ་རིག་པ་ལས་འདུ་བྲེད་རྣམས་གཞན་཈ིད་དུ་མ་གྲུབ་པས་འདུ་བྲེད་རྣམས་ལ་མ་ལྟྟོས་པར་མ་རིག་པ་གཞན་཈ིད་དུ་གྲུབ་པར་འགྱུར་རྟོ་ཞྲེས་བརྟོད་པར་མི་ནུས་སྟོ།",
    "དྲེ་ལྟར་འདུ་བྲེད་ལ་སྟོགས་པ་ལས་མ་རིག་པ་ལ་སྟོགས་པ་གཞན་཈ིད་དུ་མ་གྲུབ་ན་མ་རིག་པ་ལ་བརྲེན་ནས་བྱུང་བའི་འདུ་བྲེད་རྣམས་གཞན་཈ིད་དུ་གྲུབ་བྟོ་ཞྲེས་རྣམ་པར་གཞག་པར་མི་ནུས་སྟོ།",
    "འདུ་བྲེད་ལ་ལྟྟོས་ནས་མ་རིག་པའྟོ་ཞྲེས་རྣམ་པར་གཞག་པས་རྲེ་ཞིག་རྒྱུ་དང་འབས་བུ་དག་གཅིག་཈ིད་མ་ཡིན་ནྟོ་ཞྲེས་སྟོས་པར་འགྱུར་རྟོ།",
    "ཕན་ཚུན་ལྟྟོས་པས་རྒྱུ་དང་འབས་བུ་དག་གྲུབ་པར་གྱུར་ལ།",
    "ཞྲེས་གསུངས་སྟོ།",
    "གལ་ཏྲེ་ཡང་དྲེ་ལྟར་རྒྱུ་དང་འབས་བུ་དག་ཕན་ཚུན་ལྟྟོས་པ་ཅན་དུ་གྲུབ་པར་རྣམ་པར་བཞག་ལ།",
    "དྲེ་ལྟ་ན་ཡང་ཕན་ཚུན་ལྟྟོས་པ་ཅན་དུ་གྲུབ་པས་དྲེ་དག་ཀང་བུ་དང་ཕ་བཞིན་དུ་གྲུབ་པར་འགྱུར་རྟོ་ཞྲེ་ན།",
    "གསུངས་པ།",
    "བུ་མྲེད་ན་ཅི་ཞིག་སྲེད་པར་བྲེད་པས་ཕ་཈ིད་དུ་འགྱུར།",
    "ཞྲེས་བ་བས་ཐམས་ཅད་ལ་མཚུངས་པར་སྦྱར་བར་བའྟོ་ཞྲེས་གསུངས་སྟོ།",
    "ཅུང་ཟད་རྟོག་པར་བྲེད་པས་ན།",
    "ཕྱིན་ཅི་ལྟོག་ཏུ་རྣམ་པར་གཞག་སྲེ།",
    "རྣམ་པར་རྟོག་པ་ལས་ཡྟོངས་སུ་བཟླྟོག་ནས་ཡང་ཆྟོས་རྣམས་ཀི་ཆྟོས་཈ིད་ཇི་ལྟ་བ་དྲེ་ལྟ་བུ་ལ་གནས་སྟོ།",
    "དྲེ་ལ་གནས་ནས་ཡང་དག་པ་མ་ཡིན་པར་སྟོ་མི་འདྟོགས་པས་མྱ་ངན་ལས་འདས་པ་ཐྟོབ་པ་ལ་རྣམ་པར་གྟོལ་བ་ཞྲེས་བརྟོད་དྟོ།",
    "ཞྲེས་རི་ལམ་཈ིད་དུ་རྣམ་པར་འཇྟོག་ལ།",
    "གང་དང་དྲེ་ག་཈ིས་རག་ཏུ་མངྟོན་པར་འབྲེལ་བའི་ཕྱིར།",
    "རི་ལམ་ན་རྣམ་པར་ཤྲེས་པ་ལས་ཐ་དད་པའི་ཡུལ་མྲེད་ལ།",
    "རྣམ་པར་རིག་པ་ཙམ་ཡང་ཡྟོད་པའི་ཕྱིར་རྟོ་ཞྲེ་ན།",
    "བཅྟོམ་ལྡན་འདས་ཀིས་གསུངས་པ།",
    "ཇི་ལྟར་ན་ཡང་སྔྟོན་པྟོ་དང་སྲེར་པྟོ་ལ་སྟོགས་པ་མིག་ལ་སྟོགས་པའི་རྣམ་ཤྲེས་ཀིས་ཡྟོངས་སུ་དཔྱད་པར་བ་བ་མངྟོན་སུམ་དུ་དམིགས་བཞིན་པ་ལ་མྲེད་དྟོ་ཞྲེས་བརྟོད་པར་མི་ནུས་སྟོ།",
    "འདུས་པ་ལ་དམིགས་པ་པྟོ་཈ིད་དུ་མི་རུང་བས་རྣམ་པར་ཤྲེས་པའི་རྣམ་པ་ལས་ཐ་དད་པའི་སྔྟོན་པྟོ་ལ་སྟོགས་པ་ཡྟོད་པར་མི་འགྲུབ་བྟོ་ཞྲེ་ན།",
    "ཅྲེས་བ་བ་ལ་སྟོགས་པ་ཇི་སྐད་གསུངས་པའི་རག་པ་དང་།",
    "ཞྲེས་བ་བ་ལ་སྟོགས་པའི་ཆད་པར་འགྱུར་བའི་དཔྱད་པ་ལས་ཀང་མ་གྲུབ་བྟོ།",
    "ཐམས་ཅད་ཀི་རང་བཞིན་མ་གྲུབ་པར་གྱུར་པས་རྣམ་པར་ཤྲེས་པ་ངྟོ་བྟོ་཈ིད་ཀིས་མ་གྲུབ་པར་ཁས་བླངས་པ་བཞིན་ཡུལ་ཡང་མ་གྲུབ་པར་ཁས་བླངས་པར་བྟོས་ཤིག་དང་སྟོན་ཅི་ཡང་མྲེད་དྟོ།",
    "དྲེའི་རྣམ་པར་ཤྲེས་པ་ཡྟོད་པ་ཅན་ས་ཚོགས་པའི་གཟུགས་དང་ས་ལ་སྟོགས་པའི་ཡུལ་཈མས་སུ་མྱྟོང་བ་ལ་འཇུག་པས།",
    "དྲེ་དྲེ་བཞིན་དུ་སད་པའི་བདག་཈ིད་ཀི་དངྟོས་པྟོ་དང་འབྲེལ་བའི་རྣམ་པར་ཤྲེས་པ་རི་ལམ་དུ་རྣམ་པ་ཐམས་ཅད་དུ་མི་སིད་དྟོ།",
    "གཞན་དུ་ན་དྲེར་བས་པའི་ལས་ཀིས་སད་པ་ན་ཡང་འབས་བུ་཈མས་སུ་མྱྟོང་བ་སུས་ཟླྟོག་པར་བྲེད།",
    "ཡིད་ཀི་རྣམ་པར་ཤྲེས་པ་཈ིད་རྣམ་པར་ཤྲེས་པ་ལ་བག་ཆགས་ས་ཚོགས་པ་ཡྟོངས་སུ་སིན་པ་སྔྟོན་པྟོ་དང་སྲེར་པྟོ་ལ་སྟོགས་པའི་རྣམ་པར་མི་རུང་སྲེ།",
    "ག་཈ིད་དང་མཚུངས་པར་ལྡན་པས་དྲེ་ཤིན་ཏུ་བླུན་པའི་ཕྱིར་ཏྲེ།",
    "ཤིན་ཏུ་ཕྲ་བའི་དྟོན་ལ་སྲེམས་པ་ལ་སྟོགས་པ་ཡང་སད་པའི་བདག་཈ིད་ཀི་དངྟོས་པྟོས་བསྒྲུབ་པར་ནུས་པས་དྲེ་ལ་཈ྲེ་བར་དམིགས་ལ།",
    "ག་཈ིད་ཀིས་བསད་པའི་རྣམ་པར་ཤྲེས་པ་ལ་ཇི་སྐད་དུ་སྟོས་པ་མི་འཐད་དྟོ།",
    "འྟོ་ན་དྲེ་ལྟར་གྱུར་ན་བདག་཈ིད་ཀི་དངྟོས་པྟོ་ག་཈ིས་པ་ཐྟོབ་པར་འགྱུར་རྟོ།",
    "སུས་འདི་ལ་ག་཈ིས་པའྟོ་ཞྲེས་ཡྟོངས་སུ་བརག་པར་ནུས།",
    "འདི་ལ་ག་཈ིས་པ་དང་གསུམ་པ་ཞྲེས་རྣམ་པར་གཞག་པར་མི་ནུས་སྟོ།",
    "འདིར་སད་པ་ན་རྣམ་པར་ཤྲེས་པའི་ཀུན་དུ་སྟོད་པ་ཡྟོད་པས་ཞྲེས་བ་སྲེ།",
    "རི་ལམ་དུ་཈མས་སུ་མྱྟོང་བ་སད་པའི་རྣམ་པར་ཤྲེས་པ་ལ་མི་དྲན་པ་མ་ཡིན་ནྟོ།",
    "རྒྱུ་དང་འབས་བུ་རྒྱུན་གཅིག་ཏུ་རྣམ་པར་གཞག་པའི་ཕྱིར།",
    "སུ་ཞིག་འདིར་རང་བཞིན་མྲེད་པར་ཁྟོང་དུ་ཆུད་པར་འགྱུར།",
    "གང་ཁྟོ་ན་ལ་དྲེ་དག་རིགས་པས་མི་འཐད་པ་དྲེ་཈ིད་ཀིས་ན་དྲེ་ལ་བརྫུན་པར་འཐད་དྟོ།",
    "མི་བདྲེན་པ་཈ྲེ་བར་དམིགས་པ་དྲེས་བདྲེན་པར་འདྟོད་པའི་སད་པའི་བདག་཈ིད་དངྟོས་པྟོ་ལ་ཆགས་པ་འཕགས་པས་སྲེལ་བར་མཛད་དྟོ།",
    "གལ་ཏྲེ་དྲེ་ལྟར་ན་ནི་འདི་ཐམས་ཅད་ལ་དྲེ་བཞིན་ཁྟོ་ནར་རྲེས་སུ་གནས་པས་བྟོས་ཤིག་དྲེས་ན་འཇིག་རྲེན་པས་ཇི་ལྟར་མཐྟོང་བ་དངྟོས་པྟོར་ཡྟོད་འགའ་ཞིག་ལ་བདྲེན་པར་མངྟོན་པར་འདྟོད་པ་འཁྲུལ་པ་བསལ་བ་ལ་དགྟོས་པ་ཅི་ཞིག་ཡྟོད།",
    "བརྫུན་པ་཈ིད་དུ་རྣམ་པར་གནས་ལ་དྲན་པས་ན་བདག་཈ིད་ཀི་དངྟོས་པྟོ་ལས་གཞན་པ་ཡང་མ་ཡིན་ཞིང་ཐ་དད་པ་ཡང་མ་ཡིན་ཏྲེ།",
    "དངྟོས་པྟོ་ལ་ཆགས་པ་སྔྟོན་དུ་འགྟོ་བ་ལས་འཁྟོར་བ་ལ་ངྲེས་པར་དངྟོས་པྟོ་ལ་ཆགས་པ་ཟད་པ་ལས་མྱ་ངན་ལས་འདའྟོ་ཞྲེས་བའྟོ།",
    "དྲེའི་ཕྱིར་རི་ལམ་དུ་རིས་པའི་བདྲེ་བ་དང་སྡུག་བསྔལ་བཞིན་དང་རྒྱུ་ཡུལ་བཞིན་དུ་མ་རིག་པ་དང་འདུ་བྲེད་དག་རང་བཞིན་མྲེད་པར་གྲུབ་བྟོ།",
    "དྲེའི་ཚེ་དངྟོས་པྟོ་མྲེད་པར་སྨྲ་བ་ཁྱྟོད་ལ་དམན་པ་དང་མ་཈མ་པ་དང་ཁྱད་པར་འཕགས་པ་཈ིད་མི་འཐྟོབ་བྟོ།",
    "ཡྟོད་བཞིན་པ་མ་ཡིན་པ་ནམ་མཁའི་མྲེ་ཏྟོག་ལ་དམན་པ་དང་མ་཈ན་པ་དང་ཁྱད་པར་ཅན་ལ་དམིགས་ལ།",
    "གཟུགས་ལ་སྟོགས་པ་཈ྲེ་བར་དམིགས་པ་རྣམས་ཁྱད་པར་ཅན་དང་ཁྱད་པར་ཅན་མ་ཡིན་པ་དང་བར་མའི་དབྲེ་བས་གནས་པ་རྣམས་སྟོ་སྟོར་དམན་པ་དང་མ་཈ན་པ་དང་ཁྱད་པར་ཅན་ཡིན་ལ།",
    "མ་སྲེས་པ་རྟོ་གཅིག་པ་ལ་ས་ཚོགས་པ་཈ིད་དུ་འགྲུབ་པ་ཐྟོབ་པར་མི་འགྱུར་རྟོ།",
    "དངྟོས་པྟོ་རང་བཞིན་མྲེད་པར་སྨྲ་བ་རྣམས་དངྟོས་པྟོ་རྒྱུ་ལས་སྲེ་བ་ཡང་མི་འཐྟོབ་སྲེ།",
    "དྲེ་ལ་གལ་ཏྲེ་འདུ་བྲེད་ལ་སྟོགས་པའི་དངྟོས་པྟོ་རང་བཞིན་མྲེད་པར་གྱུར་ན།",
    "འདིར་གསུངས་པ།",
    "གང་ལ་རང་བཞིན་མྲེད་པར་འགྱུར།",
    "ཇི་ལྟར་མངྟོན་པར་འདྟོད་པའི་ཁྱད་པར་གྲུབ་པ་ཡང་ཁྱྟོད་ཀིས་ཐྟོབ་པར་མི་འགྱུར་ལ།",
    "རྣམ་པར་གཞག་པ་ཐམས་ཅད་མྲེད་པ་ཡང་ཐྟོབ་པར་འགྱུར་རྟོ།",
    "དངྟོས་པྟོ་རྣམས་ཀི་དམན་པ་ལ་སྟོགས་པའི་ཁྱད་པར་མི་འབྱུང་ངྟོ་ཞྲེས་བ་སྲེ།",
    "དྲེའི་ཕྱིར་མ་བརྲེན་པར་ཡང་མ་ཡིན་ཏྲེ།",
    "མ་བརྲེན་པར་ཡང་དངྟོས་པྟོ་རྣམས་ཀི་རང་བཞིན་མྲེད་དྟོ།",
    "གཞན་ཡང་དངྟོས་པྟོ་རྣམས་ཀི་རང་བཞིན་ཁས་བླངས་ན་ཇི་ལྟར་ཁས་བླངས་པའི་རང་བཞིན་མྲེད་པར་ཡང་མི་འགྱུར་ཏྲེ།",
    "འདུ་བྲེད་རྣམས་འཇིག་པ་མྲེད་པ་ཐྟོབ་པར་འགྱུར་ལ།",
    "འདི་ལས་གཞན་དུ་གྱུར་པར་རྣམ་པར་འཇྟོག་པར་བྲེད་ལ།",
    "དྲེ་མྲེད་ན་འྟོ་མའི་རྣམ་པར་གཞག་པ་མྲེད་པ་཈ིད་དུ་འགྱུར།",
    "གཞན་དུ་འགྱུར་བ་མྲེད་པར་གྱུར་ན་རང་བཞིན་མྲེད་པར་མི་འགྱུར་རྟོ།",
    "དངྟོས་པྟོ་འབའ་ཞིག་ཙམ་ཁས་བླངས་པར་གྱུར་ན་རང་བཞིན་མྲེད་པའི་འཇིག་པ་ཡང་ཐྟོབ་པར་མི་འགྱུར་བ་ཡང་མ་ཡིན་ཏྲེ།",
    "དངྟོས་པྟོ་཈ིད་དུ་རྣམ་པར་གཞག་པ་དྲེ་དང་འགལ་བ་དངྟོས་པྟོ་མྲེད་པ་མི་འཐད་པས་སྟོ།",
    "ཞྲེས་རྣམ་པར་འཇྟོག་སྲེ།",
    "ཡྟོད་བཞིན་པ་མ་ཡིན་པར་འགྱུར་ན།",
    "འགག་པར་ཡང་མི་འགྱུར་རྟོ།",
    "བཅྟོམ་ལྡན་འདས་ཀིས་ཀང་དངྟོས་པྟོའི་སྲེ་བ་དང་འགག་པ་གསུངས་ཏྲེ།",
    "གལ་ཏྲེ་སྲེ་བ་དང་འགག་པར་འགྱུར་ན།",
    "ཀི་རང་བཞིན་གྲུབ་པར་འགྱུར་ལ།",
    "དངྟོས་པྟོ་ལ་བརྲེན་ནས་བརག་པར་ནུས་ཀི་གཞན་དུ་མ་ཡིན་ལ།",
    "དྲེ་དག་དྲེའི་ཚེ་སྲེ་བ་དང་འཇིག་པའི་དངྟོས་པྟོར་འཇུག་པར་གྱུར་ན།",
    "ཅིག་ཅར་རམ་ཐ་དད་པར་འཇུག་པར་འགྱུར་ན།",
    "ག་཈ིས་ཀར་ཡང་འཇུག་པར་མི་སིད་དྟོ་ཞྲེས་བསན་པའི་ཕྱིར་གསུངས་པ།",
    "རག་པར་དངྟོས་པྟོ་དངྟོས་མྲེད་ཀང་།",
    "དྲེ་ལྟར་རྲེ་ཞིག་དངྟོས་པྟོ་དང་དངྟོས་པྟོ་མྲེད་པར་དག་ཅིག་ཅར་མྲེད་པའྟོ།",
    "གལ་ཏྲེ་དངྟོས་པྟོ་ལས་གཞན་དུ་དངྟོས་པྟོ་མྲེད་པ་འཇུག་ན་དྲེའི་ཚེ་འཇིག་པ་དང་བལ་བའི་ནམ་མཁའ་ལ་སྟོགས་པ་ཡང་སྲེ་བ་འཇུག་པར་འགྱུར་ཏྲེ།",
    "དངྟོས་པྟོའི་མཚན་཈ིད་ལས་ཕྱིན་ཅི་ལྟོག་ཏུ་གྱུར་པ་འདི་ལ་སྲེ་བ་ཡང་བཟྟོད་པར་མ་ཡིན་ཏྲེ།",
    "དྲེ་ལྟར་རག་པར་དངྟོས་པྟོ་དང་དངྟོས་པྟོ་མྲེད་པ་ཡང་མྲེད་ན་མྲེད་དྟོ་ཞྲེས་བ་བ་འདི་དང་འབྲེལ་ཏྟོ།",
    "གལ་ཏྲེ་ཡྟོད་ན་སྲེ་བ་མྲེད་པར་ཡང་རྣམ་པར་འཇིག་པར་འགྱུར་རྟོ།",
    "ཡང་ན་གལ་ཏྲེ་དངྟོས་པྟོ་དང་དངྟོས་པྟོ་མྲེད་པ་དག་ཏུ་འཇུག་པར་མི་འགྱུར་ཡང་།",
    "དྲེ་མྲེད་པར་དངྟོས་པྟོ་སིད་དངྟོས་པྟོ་ཡྟོད་པ་཈ིད་ལ་དྲེ་ཡང་མྲེད་དྟོ་ཞྲེས་གསུངས་པར་འགྱུར་རྟོ།",
    "གལ་ཏྲེ་དྲེ་དང་འགལ་བའི་དངྟོས་པྟོ་མྲེད་པ་ཡྟོད་ན་དངྟོས་པྟོ་ཡྟོད་པར་འགྱུར་ལ།",
    "དྲེ་ཡང་མྲེད་དྟོ་ཞྲེས་བསན་པའི་ཕྱིར་གསུངས་པ།",
    "གཞན་ཡང་རིགས་པ་འདིས་དངྟོས་པྟོ་དངྟོས་པྟོ་མྲེད་པས་དངྟོས་པྟོ་མྲེད་པ་ཡང་མྲེད་དྟོ་ཞྲེས་བསན་པའི་ཕྱིར་གསུངས་པ།",
    "འདིའི་དངྟོས་པྟོ་གཅིག་཈ིད་ལ་དྲེ་གལ་ཏྲེ་རྟོགས་པའི་རང་བཞིན་དུ་གྲུབ་ན་འདི་དྲེ་དང་འགལ་བའི་སྲེ་བཞིན་པའི་རང་བཞིན་དུ་བརྟོད་པར་ཇི་ལྟར་འཐད།",
    "ཡང་ན་སྲེད་བཞིན་པའི་རང་བཞིན་དུ་བརྟོད་ན་ཇི་ལྟར་གྲུབ་པའི་རང་བཞིན་དུ་བརྟོད་པར་ནུས།",
    "དྲེའི་ཕྱིར་གལ་ཏྲེ་དྲེ་བཞིན་ཞྲེས་བརྟོད་ན་སྲེད་དྟོ་ཞྲེས་བརྟོད་པར་མི་བ་ལ།",
    "ཡང་ན་སྲེད་པ་ཞྲེས་བརྟོད་ན་དྲེ་ལ་རང་ཞྲེས་རྣམ་པར་མི་གཞག་གྟོ།",
    "གཞན་དུ་རྣམ་པར་གཞག་པ་ནི་དངྟོས་པྟོ་གཞན་཈ྲེ་བ་ལ་ལྟྟོས་པའི་ཕྱིར་ལ་དྲེའི་འབས་བུ་ཞྲེས་བ་བའི་དངྟོས་པྟོ་མ་རྟོགས་པའི་ཕྱིར་དྲེ་ལ་ལྟྟོས་ནས་འགའ་ཡང་གཞན་཈ིད་དུ་ཡྟོད་པ་མ་ཡིན་ཞྲེས་བ་སྲེ།",
    "སྲེ་བ་མྲེད་པར་འགྱུར་བས་དངྟོས་པྟོ་ཡང་མྲེད་དྟོ་ཞྲེས་གསུངས་པ།",
    "ཀུན་བརགས་གཟུང་བ་དང་འཛིན་པ་཈ིད་མྲེད་པས་ཡྟོད་པ་཈ིད་དུ་ལྟ་བ་ཡང་དག་པ་མ་ཡིན་པར་འཛིན་པའྟོ་ཞྲེས་བའྟོ།",
    "ཀུན་ཏུ་བརགས་པ་གཟུང་བ་དང་འཛིན་པ་མི་སིད་པར་ཁས་བླངས་པར་གྱུར་ན།",
    "དྲེ་དག་ཀང་མྲེད་པར་ལྟ་བ་ཁ་ན་མ་ཐྟོ་བ་མྲེད་པའྟོ་ཞྲེས་བ་བ་དྲེ་རྣམས་ཀིས་ཡྟོད་པ་཈ིད་དང་མྲེད་ཟླ་གགས་ཆུང་བ།",
    "ངྲེས་པར་འདི་རྣམས་འཁྟོར་བ་཈ིད་ལས་མི་ལྡྟོག་གྟོ།",
    "དངྟོས་པྟོ་འབའ་ཞིག་ཁས་བླངས་ན་ཡང་ཡྟོད་པ་དང་མྲེད་པ་཈ིད་དུ་སྨྲ་བ་ལས་མ་འདས་ལ་རག་པ་དང་ཆད་པར་སྨྲ་བ་ཡང་ཐྟོབ་པར་འགྱུར་རྟོ།",
    "མྲེད་ནའང་ངྲེས་པར་ཆད་པ་ལ།",
    "དངྟོས་པྟོ་ཁས་བླངས་པར་གྱུར་ན་དྲེའི་རང་བཞིན་ཡྟོད་བཞིན་པས་སར་ཡང་གཞན་དུ་གྱུར་པ་མི་སིད་པས་དུས་ཐམས་ཅད་དུ་ཡྟོད་པར་འགྱུར་བས།",
    "དངྟོས་པྟོ་དྲེ་རག་པར་ཁས་བླང་བར་བའྟོ།",
    "གལ་ཏྲེ་རག་པ་ཁས་བླངས་ན་དྲེའི་ཚེ་ཐྲེར་ཟུག་ཐྟོབ་པར་འགྱུར་ཏྲེ།",
    "ཡང་ན་གལ་ཏྲེ་འཇིག་པར་གྱུར་ན་དྲེའི་ཚེ་དངྟོས་པྟོ་མྲེད་པར་ཁས་བླངས་པར་གྱུར་པས་འདི་ནི་མྲེད་པ་ཐྟོབ་པར་འགྱུར་རྟོ།",
    "དྲེ་ལས་ཀང་སྔར་བྱུང་ལ་ད་ནི་མྲེད་དྟོ་ཞྲེས་པའི་དྟོན་ཁས་བླངས་པར་གྱུར་པས་ཆད་པར་ལྟ་བ་ཐྟོབ་སྲེ།",
    "གང་ཡང་ཡང་དག་པའི་ལྟ་བ་མ་ཡིན་པ་དྲེ་ནི་ངྲེས་པར་སྤང་བར་བ་ལ།",
    "དྲེ་ལྟ་ན་ཡང་ལྟ་བ་དྲེ་ནི་ཆད་པར་ལྟ་བ་མ་ཡིན་ནྟོ་ཞྲེས་བའྟོ།",
    "རྣམ་པར་དམིགས་པས་འཇུག་གྟོ།",
    "ཁྱད་པར་ནི་འདི་དག་སྲེ།",
    "དགྲེ་སྟོང་ངམ་བམ་ཟྲེ་གང་ཅུང་ཟད་བདག་གྟོ་ཞྲེས་ཡང་དག་པར་རྲེས་སུ་ལྟ་བ་ལས་ཡང་དག་པར་རྲེས་སུ་མཐྟོང་བ་ནི་཈ྲེ་བར་ལྲེན་པའི་ཕུང་པྟོ་ལྔ་པྟོ་འདི་཈ིད་མཐྟོང་ངྟོ་ཞྲེས་བཅྟོམ་ལྡན་འདས་ཀིས་གསུངས་པ།",
    "དྲེའི་ཕྱིར་མཐར་འཛིན་པར་ལྟ་བ་ཡང་རག་པ་དང་ཆད་པའི་རྣམ་པས་འཇུག་བཞིན་པ་ན།",
    "དྲེ་཈ིད་ཀིས་ན་བཅྟོམ་ལྡན་འདས་ཀིས་གསུངས་པ།",
    "བདག་མྲེད་དྟོ་ཞྲེ་ན་ཕ་རྟོལ་པྟོའི་ཆད་པར་རྟོ་ཞྲེས་སྟོ།",
    "ཅི་དྲེ་ནི་རག་པར་ལྟ་བར་འགྱུར་རམ་འྟོན་ཏྲེ་མ་ཡིན།",
