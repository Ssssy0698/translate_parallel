    "དངོས་གྲུབ་འཇོམས་པར་འགྱུར་བ་ཡིན།",
    "རྡོ་རྗེ་ཞལ་བཞིས་རྣམ་པར་མཚན།",
    "གདུག་པའི་བདུད་ནི་བསྐྲད་བྱས་ནས།",
    "མཉམ་པར་གནས་པ་ཉིད་ཡིན་ནོ།",
    "འབད་པས་གཏོར་བ་ཡིན་པར་བཤད།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་མཁའ་འགྲོས་དེ་ཁོ་ན་ཉིད་ཀྱི་གསང་བ་གསུངས་པ།",
    "འཇིགས་པ་ཐམས་ཅད་རྣམ་པར་སྤངས།",
    "གཙང་སྦྲ་མེད་ཅིང་མི་གཙང་མེད།",
    "དག་པའི་སྤྱོད་པ་རྣམ་པར་སྤངས།",
    "གནས་ནི་བརྟག་པ་བྱས་ནས་ཀྱང་།",
    "ས་ནི་བྱུག་པ་བྱས་ནས་ཀྱང་།",
    "མེ་ཏོག་འབད་པས་དགྲམ་པར་བྱ།",
    "མཉམ་པར་བཞག་པས་རྒྱ་ཆེར་བྱ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་གནས་པར་བསྒོམ།",
    "རྣམ་པར་འཕྲོ་བས་ཀུན་ཏུ་ཁྱབ།",
    "ལྷ་དང་ཁྲོ་བོས་ཁྱབ་པར་མཐོང་།",
    "དེ་ནི་རྣམ་པར་སྣང་མཛད་དང་།",
    "ཡོངས་སུ་དག་པར་ཤེས་པར་བྱ།",
    "འདི་ལ་འཇོག་ཅིང་འགོད་པར་ཤོག།",
    "ཕྱི་རོལ་རིང་ནས་དགོད་པར་བྱ།",
    "ཉི་མའི་དཀྱིལ་འཁོར་དབུས་བཞུགས་པ།",
    "རྡོ་རྗེ་སེམས་དཔའ་རྣམ་པར་བསྒོམ།",
    "ཕྱག་རྒྱ་ཆེ་དང་མཉམ་པར་ལྡན།",
    "ཤེས་རབ་སྐྱིལ་ཀྲུང་ལེགས་པར་བཞུགས།",
    "མི་བསྐྱོད་པ་ནི་དབུ་རྒྱན་བཞུགས།",
    "རྡོ་རྗེ་དྲིལ་བུས་ལེགས་པར་འཁྱུད།",
    "དཔའ་ཆེན་བདེ་བའི་གོ་འཕང་བཞུགས།",
    "ཞལ་གདོང་གཉིས་པོ་རྣམ་པར་འགྱུར།",
    "ཁྲོ་བོ་འདི་དག་རྣམ་པར་དགོད།",
    "སྣ་ཚོགས་པདྨའི་ནང་བཞུགས་ཤིང་།",
    "ཉི་མའི་དཀྱིལ་འཁོར་དབུས་ན་བཞུགས།"
