    "དེ་ནས་རང་གི་དཔྲལ་པར་སིནྡྷུ་རའི་ཐིག་ལེ་བྱས་ལ་མཚམས་དམ་དུ་བཅད་དེ་མིང་ཚིག་མི་བསྲེ་བར་མདུན་གྱི་ལྷ་ལ་དམིགས་ཏེ།",
    "རང་གི་ཐུགས་ཀ་ནས་འོད་ཟེར་འཕྲོས།",
    "གཙོ་བོ་ལ་ཅི་ཙམ་བཟླས་པ་དེའི་བཅུ་ཆ་རེ་འཁོར་རྣམས་ལའང་བཟླ་དགོས་པར་གསུངས་སོ།",
    "ཧཱུྃ་གི་འོད་ཀྱི་ཡེ་ཤེས་པ་རྣམས་དང་།",
    "སོགས་འཁོར་སྔགས་རྣམས་ཀྱང་བཅུ་ཕྲག་རེ་ཙམ་བཟླ་བཞིན་དུ་འབུལ་བར་བྱའོ།",
    "ཨ་མྲྀ་ཏས་བསངས།",
    "འབུལ་བའི་ཡུལ་གྱི་སྐུ་བརྙན་མ་འབྱོར་ཚེ་གའུའི་ལྷ་ལས་ལྷ་གཉིས་པ་རེ་ཆད་ནས་ཆུ་སྦྱིན་གྱི་སྣོད་དུ་བྱོན་པར་བསམ་ལ་དེ་ལ་ཕུལ་བས་ཀྱང་རུང་ངོ།",
    "རོ་བརྒྱའི་ཞལ་ཟས་གདངས་སྙན་རོལ་མོའི་སྤྲིན།",
    "ཡིད་ལ་འདོད་པའི་རེ་བ་རྫོགས་མཛད་ཅིང་།",
    "ཕྱི་མར་བདེ་བ་ཅན་གྱི་ཞིང་དུ་སྐྱེ་ཞིང་སྤྱན་རས་གཟིགས་ཀྱི་གོ་འཕང་ཐོབ་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ཆུ་ལྷག་མ་གཞན་དུ་མི་འཁྱེར་བར་རང་གི་ལོངས་སྤྱོད།",
    "པདྨ་མཁའ་འགྲོ་དམར་མོ་ཆགས་པའི་ཉམས།",
    "དད་གུས་མོས་པའི་རྟ་བདུན་གྱིས་དྲངས་ཏེ།",
    "འབད་མེད་ངང་གིས་འདུ་བའི་ཕྱ་གཡང་སྩོལ།",
    "སྔོན་བསགས་རྣམ་དཀར་འཛིན་མའི་ཁྱོན་ཡངས་ལ།",
    "དུས་རྣམས་ཀུན་ཏུ་གཡང་འདུས་མེ་རེ་རེ།",
    "གཡང་གིས་བང་མཛོད་ཁྱིམ་སྒོ་ཀུན་ཏུ་གང་།",
    "གཡང་གིས་ར་བ་རི་ལུང་ཐམས་ཅད་གང་།",
    "གཡང་གིས་ས་ཕྱོགས་ཡུལ་ཁམས་ཡོངས་སུ་གང་།",
    "ཁྱད་པར་རྟག་ཏུ་ཁྱོད་ཞབས་གུས་བསྟེན་པ།",
    "རྗེས་ཀྱི་བྱ་བ་གོང་ཆུ་སྦྱིན་མཇུག་གི་མཆོད་བསྟོད་དང་འདོད་གསོལ་ལྟར་བྱས་ལ།",
    "མེ་ཏོག་དང་བཅས་པས་ཐལ་མོ་སྦྱར་ཏེ།",
    "ལྷ་མོ་སྒྱུ་བརྒྱ་འཕྲུལ་ལྷུམས་ཞུགས་ལྟར།",
    "བདག་གི་འབྱོར་པ་ཉིད་ཀྱིས་ནི།",
    "བཅོམ་ལྡན་ཁྱོད་ནི་བཞུགས་པར་མཛོད།",
    "དེ་ནས་རང་གི་དཔྲལ་པར་ཨོཾ",
    "མགྲིན་པར་ཨཱ་ཐུགས་ཀར་ཧཱུཾ་གིས་མཚན་པར་གྱུར།",
    "ཞེས་སྔགས་འདི་ཉིན་རྗེའི་རེ་བཞིན་བརྒྱ་རྩ་བརྒྱད་རེ་བཟླས་ན་ཟས་འདུ་བར་འགྱུར་རོ།",
    "རི་དེའི་རྩེ་མོར་ཕྱིན་ལ་བསང་གཏོར་གསེར་སྐྱེམས་བཏང་ལ།",
    "ནོར་སྒྲུབ་རྐྱང་བ་ལ་ནོར་བདག་གི་གའུ་གཅིག་པུ་བསྒྲུབ་པ་གསུང་འབུམལས་གཞན་མི་དགོས་སོ།",
    "ངན་སོང་གི་གནས་ངན་དུ་མི་ལྟུང་ཞིང་ཕྱི་མར་བདེ་བ་ཅན་གྱི་ཞིང་དུ་སྐྱེ་ནས་འཕགས་པ་སྤྱན་རས་གཟིགས་ཀྱིས་གོ་འཕང་ཐོབ་པ་སོགས་ཕན་ཡོན་བསམ་གྱིས་མི་ཁྱབ་པར་གསུངས་སོ།",
    "འདོད་པའི་རེ་བ་སྐོང་ལ་སོམ་ཉི་བྲལ།",
    "འདོད་དགུའི་ཆར་ཀྱིས་གསུང་འབུམལུས་ཅན་རེ་བ་བསྐང་།",
    "ན་མོ་གུ་རུ་ཨཱརྱ་ལོ་ཀི་ཤྭ་རི་ཡ།",
    "སྤྱན་རས་གཟིགས་སྤྲུལ་ཨཱརྱ་ཛམྦྷ་ལྷ།",
    "ན་མོ་གུ་རུ་ཨཱརྱ་ཏཱ་རེ་ཡེ།",
    "དེ་ལ་འདིར་མཉམ་མེད་ཇོ་བོ་རྗེ་དཔལ་ལྡན་ཨ་ཏི་ཤ་ནས་ཉེ་བར་བརྒྱུད་པའི་རྗེ་བཙུན་མ་སྒྲོལ་མ་ཉེར་གཅིག་གི་ནང་ཚན།",
    "རྒྱ་ཤོག་ལ་རབ་གསེར་དངུལ་ལམ་མ་འབྱོར་ན་མཚལ་སྣག་གང་རུང་གིས།",
    "དྲི་བཟང་གིས་བྱུག་སྟེ་དབུ་ནས་ཤ་། ཞལ་ནང་བསྟན་དུ་དྲིལ་ལ་ན་བཟའ་དམར་སེར་ཕུལ་ལ་མགོ་མཇུག་མི་ནོར་བའི་མཚན་མ་བྱས་ཏེ་གཟུངས་སུ་གཞུག།",
    "མདུན་གྱི་ནམ་མཁར་སྐྱབས་ཡུལ་སྤྲིན་ཕུང་འཐིབསབརྒྱ་ཉི་ཤུ་པ་ལྟར་བཞུགས་པར་མོས་ལ།",
    "ཟབ་མོ་གཏེར་གྱི་བུམ་པ་བསྒྲུབ་པར་བྱ།",
    "བརྒྱད་ཟུང་འཇོ་སྒེག་ལང་ཚོའི་དཔལ་གྱིས་མཛེས།",
    "རང་གི་སྤྱི་བོ་ནས་ཐིམ་སྤྱི་གཙུག་ཏུ།",
    "ཕྱག་གི་བུམ་ནང་ཐུགས་དབུས་ཟླ་དཀྱིལ་སྟེང་།",
    "ཨོཾ་ཏཱ་རེ་ཏུཏྟ་རེ་ཏུ་རེ་སྭཱ་ཧཱ།",
    "ཨོཾ་ཛ་བྷི་ནི་མོ་ཧི་སྭཱ་ཧཱ།",
    "མཆོག་དང་ཐུན་མོང་གིས་དངོས་གྲུབ་མ་ལུས་པ་བསྩལ་ཏུ་གསོལ།",
    "ཨོཾ་ཨ་མྲྀ་ཏས་བསངས།",
    "བརྒྱད་ཟུང་འཇོ་སྒེག་ལང་ཚོའི་དཔལ་གྱིས་མཛེས།",
    "ཨོཾ་ཨཱརྱ་ཏཱ་རེ་ས་པཱ་རི་ཝ་ར་ཨེ་ཧེ་ཧི་བཛྲ་ས་མཱ་ཡ་ཛ",
    "ཨོཾ་ཨཱརྱ་ཏཱ་རེ་ས་པཱ་རི་ཝ་ར་ཨབྷཾ་ནས་ཤལྟ་ཨཱཧཱུྃ།",
    "གདངས་སྙན་རོལ་མོའི་བྱེ་བྲག་སྣ་ཚོགས་པ།",
    "ཨོཾ་ཨཱརྱ་ཏཱ་རེ་ས་པཱ་རི་ཝ་ར་ཨགྷཾ་པུཊྚཾ་ནས་ཤཔྟ་པཱཙྪ་ཧོ",
    "ཨོཾ་ཨཱརྱ་ཏཱ་རེ་ས་པཱ་རི་ཝ་ར་མངྒ་ལཾ་སབྟ་རཏྣ་པཉྩ་ཀཱ་མ་གུ་ཎ་པཱུ་ཛི་ཏེ་ཧཱུྃ།",
    "ཁྲོ་གཉེར་གཡོ་བ་ཡི་གེ་ཧཱུཾ་གིས།",
    "བུམ་པ་རྣམས་གཟུངས་ཐག་གིས་སྦྲེལ་བ་ནས་བཟུང་ལ།",
    "གསུང་ཡིག་འབྲུ་ཐུགས་ཕྱག་མཚན་གྱི་རྣམ་པ་དཔག་ཏུ་མེད་པ་ནམ་མཁའི་ཁམས་ག་གང་བར་སྤྱན་དྲངས་ཏེ་བྱོན་ནས་མདུན་གྱི་བུམ་པའི་ནང་གི་སྐུ་དང་རྟེན་རྫས་རྣམས་ལ་ཐིམ།",
    "སླང་ཡང་བུམ་པའི་ནང་གི་ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པ་ཐམས་ཅད་འཕེལ་ཞིང་རྒྱས་ཏེ་མེར་གྱིས་གང་ནས་བུམ་པའི་ཁ་ནས་ལྷུད་ཀྱིས་ལུད་པ་དང་།",
    "ལྷའི་ཕྱག་གི་བུམ་ག་པ་ལས་ཀྱང་དེ་བཞིན་འདོད་དགུ་སྣ་ཚོགས་ལྷུག་ལྷུག་བབས་པས་དགོན་གནས་སྦྱིན་བདག་ཡུལ་ཁམས་དང་བཅས་པའི་གནས་ཁང་སྦྲ་གུར་བང་མཛོད་ར་བ་རི་ལུང་ཐམས་ཅད་མྱུར་བུར་ཁེངས་ཤིང་གཏམས་པས།",
    "ཏཱ་རེ་ཡིག་བཅུ་ཅི་འགྲུབ་དང་།",
    "ཨོ་ཛཾ་བྷ་བརྒྱ་ཉེར་ལྔ་ནི་མོ་ཧི་ས་ཧཱ།",
