    "བོད་བག་རས་དཀྲི་མཁན་མང་པོ་འདུག།",
    "དཔེ་བཞག་བཞག་དགོས་ས་མང་པོ་འདུག།",
    "ཁ་ཡག་ཡག་སླུ་མཁན་མང་པོ་འདུག།",
    "རྟ་མ་ཎི་འདོན་མཁན་མང་པོ་འདུག།",
    "ད་གཏུག་གྲངས་མ་མང་འདུག་མཁས་གྱིས།",
    "སྡུག་ཐག་ཆོད་ཤི་བའི་ནང་པར་འདུག།",
    "བློན་པོ་ཡི་འགྲོ་ལུགས་གང་ན་འདུག།",
    "མི་སྐྱ་བོའི་འགྲོ་ལུགས་གང་ན་འདུག།",
    "ཇོ་བཙུན་གྱི་འགྲོ་ལུགས་གང་ན་འདུག།",
    "སྣ་དེ་ལ་རྫས་དྲི་ཨེ་བྲོ་འདུག།",
    "བསྔོ་ཤ་དང་དམར་ཆོག་ཨེ་བཟོ་འདུག།",
    "དཔེ་དེ་ལ་བསམ་ན་ཨི་ཡག་འདུག།",
    "དཔེ་དེ་ལ་བསམ་ན་ཨི་མཛེས་འདུག།",
    "དཔེ་དེ་ལ་བསམ་ན་ཨི་དགའ་འདུག།",
    "གསེར་སེར་པོའི་སྲོག་རིན་མི་འོང་འདུག།",
    "ཇ་ནག་པོ་རང་གྱོང་མི་སོབ་འདུག།",
    "ཤ་ཞིམ་པོའི་ལོ་བརྒྱགས་མི་འོང་འདུག།",
    "རྔོན་རི་དྭགས་ཟུར་ན་ཆགས་སྒོ་འདུག།",
    "གཏམ་ཁ་མཚར་ངག་འཁྱལ་འདུག་ར་གཉིས།",
    "ད་བྱ་བླག་མང་ལ་ཨི་དགའ་འདུག།",
    "དོམ་ཧ་དོམ་བུ་ལོན་འགྲོ་འདུག་གསུམ།",
    "ད་མཛོ་ཤ་ཟ་ལ་ཨི་དགའ་འདུག།",
    "ཁ་བུ་རོས་གང་བ་མང་པོ་འདུག།",
    "སྐྱེས་ནས་མི་འཆི་མི་འདུག་སྟེ།",
    "ད་མི་དྲང་རང་དྲང་བཟོ་བསམ་ན།",
    "ཁོ་མ་རབས་རིགས་ལ་དེ་འདྲ་འདུག།",
    "ཤི་ཡི་དྭགས་ཡུལ་ལ་སྐྱེ་འདུག་གོ།",
    "བཀྲེས་སྐོམ་གྱི་སྡུག་བསྔལ་མྱོང་འདུག་གོ།",
    "གླེན་ལྐུགས་ཀྱི་སྡུག་བསྔལ་མྱོང་འདུག་གོ།",
    "ཤི་མཐའ་འཁོབ་ཡུལ་ལ་སྐྱེ་འདུག་གོ།",
    "ཤི་ལྷ་མིན་ཡུལ་ལ་སྐྱེ་འདུག་གོ།",
    "འཐབ་རྩོད་ཀྱི་སྡུག་བསྔལ་མྱོང་འདུག་གོ།"
  ]
