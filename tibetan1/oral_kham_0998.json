    "རང་འགུལ་བསམ་བློ་དང་རང་རྐྱ་འཕེར་བའི་ངང་བརྩོན་ཞིབ་བསམ་གཞིགས་བྱེད་པའི་གཤིས་ཀ་ལྡན་པར་བྱས་ཚེ།",
    "ངལ་རྩོལ་བརྒྱུད་རིམ་ནང་རང་ཉིད་ཀྱི་ངལ་རྩོལ་འབྲས་བུ་མཐོང་ཐུབ་པ་བྱས་ནས།",
    "ལར་ཆེན་སྐྱེ་བོ་རང་རང་སོ་སོའི་འཇིག་རྟེན་ལྟ་ཚུལ་དང་མི་ཚེའི་ལྟ་ཚུལ།",
    "མི་རིགས་ཀྱི་རང་བཀུར་བསམ་པ་དང་རང་ཡིད་ཆེས་པའི་བསམ་པ།",
    "སྔ་ས་ནས་ཚོང་གཉེར་བྱས་ཚེ་ད་དུང་རང་ཁྱིམ་དུ་ཕན་ཐོགས་པ་སོགས་ལྡོག་ཕྱོགས་ཀྱི་བསམ་བློའི་ཤུགས་རྐྱེན་མང་པོ་བྱུང་ལ།",
    "ཁོ་ཚོས་མིའི་སྐྱེས་ལུགས་དང་གྲུབ་ཚུལ་གྱི་སྟེང་ནས་མིའི་རང་བཞིན་དང་རང་ལུགས་རྟོགས་སུ་འཇུག་པ་དང་།",
    "དེང་རབས་ཅན་ལ་ཕྱོགས་པར་ནང་དོན་གཉིས་འདུག་སྟེ།",
    "སྐབས་དེར་རྩོམ་པ་པོ་ཁོང་རང་ཉིད་ཀྱིས་ཀྱང་སློབ་གླིང་དེ་གར་ཕྱག་ལས་གནང་བཞིན་ཡོད།",
    "བྱེད་སྒོ་སྤེལ་སྐབས་སྣ་མང་རང་བཞིན་དགོས་ལ།",
    "མི་དང་རང་བྱུང་ཁམས་བར་གྱི་འབྲེལ་བ།",
    "རྩ་བའི་ཐོག་ནས་བལྟས་ན་ཕལ་ཆེར་འདྲ་མཚུངས་སུ་འདུག་བོད་ལ་མཚོན་ནའང་འདི་འདྲའི་ལྷ་སྒྲུང་ཁག་ཅིག་བྱུང་བ་སྟེདཔེར་ན།",
    "ད་རུང་སྲོང་བཙན་སྒམ་པོ་ལོ་ན་ཕྲ་ཡང་ཆབ་སྲིད་ཀྱི་ལས་འགན་ཕྲག་ལ་འཁུར་དགོས་པའང་སྐབས་དེའི་དགོས་མཁོར་ཁེལ་འདུག་པས་ཡིན།",
    "དེ་གཉིས་ཀྱི་འགྱུར་འབྱུང་ནི་ག་དུས་བྱུང་བ་ཡིན་རུང་།",
    "ཚོ་ཆུང་གྲོས་བསྡུར་གྱི་ནང་རང་ཉིད་ཀྱི་ལྟ་ཚུལ་འདོན་པར་སྐུལ་མ་དང་།",
    "ལས་ཞོར་དང་རང་སྦྱོང་གཙོ་བྱས་ནས་ཐབས་ལམ་མང་ཞིང་རིམ་པ་མང་བ།",
    "འགྲོ་ཐབས་འདུག་ཐབས་ཀྱི་སྤྱོད་ཚུལ་འཛིན་གྱིན་ཡོད་པ་དང་།",
    "སྲོལ་རྒྱུན་གྱི་རྨང་གཞིའི་སྟེང་ནས་གསར་བ་བྱུང་བ་ཡིན་ཙ་ན།",
    "བྱ་དངོས་གསར་བ་ཡང་བོད་ཀྱི་འཚོ་བའི་གྲུབ་ཆ་རུ་མེད་དུ་མི་རུང་བ་ཞིག་ཏུ་གྱུར་འདུག་ལ།",
    "སྣ་མང་རང་བཞིན་ཅན་ཡིན་ཡང་།",
    "སྒྱུ་རྩལ་གྱི་རྣམ་པས་ཕྱུག་ལ་སྣ་མང་རང་བཞིན་ཅན་གྱི་རིགས་པ་ཤིག་ལགས་ཤིང་།",
    "དེ་དང་མཐུན་པར་ཁོ་ཚོའི་ངོས་འཛིན་ལ་རོགས་རམ་དང་རང་རྟོགས་ཐད་གཟབ་ནན་བྱེད་དགོས།",
    "ངས་དུས་རྒྱུན་གྱི་གནས་ཚུལ་ལ་གཞིགས་ནས་ཁོ་རང་འགྲན་བསྡུར་སྣ་ཚོགས་སུ་ཞུགས་སུ་བཅུག་པར་ཟད།",
    "བཞད་གད་ཀྱི་བརྗོད་དོན་ཡང་ཁོ་རང་གཙོ་བྱས་ནས་སློབ་གྲོགས་འགར་འབྲི་རུ་བཅུག་པ་ཡིན།་",
    "སྣ་མང་རང་བཞིན་དང་།",
    "ལྕགས་སླང་ནང་དུ་ལིངྒ་ཕུར་བ་བཏབ་པ་མང་པོ་འདུག་པ་དང་།",
    "ཐ་ན་གོ་ལོག་སྒྲ་ལོག་ཏུ་འགྲོ་ངེས་འདུག་སྟེ།",
    "ཆ་ཚང་རང་ཉིས་སྒྱུར་སྡོམ་གྱི་སྤྱི་འགྲོས་དེའི་གོ་དོན་ནི་གྲངས་གཉིས་ཀྱི་སྡོམ་གྲངས་ཀྱི་རང་ཉིས་སྒྱུར་ནི་གྲངས་དེ་གཉིས་ཀྱི་རང་ཉིས་སྒྱུར་གྱི་སྡོམ་གྲངས་གྱི་སྟེང་གྲངས་དེ་ཉིད་ཀྱི་བསགས་གྲངས་ཀྱི་ལྡབ་གཉིས་བསྣན་པ་དང་མཚུངས་ཞེས་པ་དང་།",
    "ནི་གྲངས་གསུམ་གྱི་ཆ་ཚང་རང་ཉིས་སྒྱུར་སྤྱི་འགྲོས་ཡིན།",
    "བློ་ལ་སྐྱོར་ཐབས་སོགས་མང་དུ་འདུག་ལ།",
    "ད་གཟོད་རང་བཀུར་དང་རང་ལ་ཡིད་ཆེས་ཤིང་།",
    "ཆགས་དབྱིབས་ཀྱི་རྣམ་པ་སོགས་ལས་ཡུལ་ཁོ་རང་མིན་ཏེ།",
    "དེ་ལྟར་དབྱེ་ཞིབ་བྱས་ན་རྩིས་ཀྱི་ཚོ་བགོད་ངེས་སྲོལ་དང་རང་སུམ་སྒྱུར་གྱི་སྡོམ་ཆད་སྤྱི་འགྲོས་བཀོལ་ཏེ་རྩིས་ཆོག་པ་གསལ་བོ་མཐོང་ཐུབ།",
    "སྤྱིའི་རྐྱེན་ཕྲེང་ལེན་ཐབས་དང་རང་ཉིས་སྒྱུར་ཆད་སྤྱི་འགྲོས་ཟུང་འབྲེལ་བྱས་ཏེ་འགྲེལ་ན་འོས་འཚམ་ཞིག་ཡིན་པ་མཐོང་ཐུབ།",
    "དེ་བཞིན་དུ་ད་དུང་རང་ཉིད་ལ་རང་བཀུར་གྱི་བསམ་བློ་དང་འགྲན་རྩོད་ཀྱི་བསམ་བློ་འཚོལ་ཞིབ་ཀྱི་བསམ་བློ་ཡང་ངེས་པར་དུ་ལྡན་དགོས་པ་ཡིན།",
    "མི་སུ་དང་སུ་ཞིག་ལ་མཚོན་ནའང་ཐོག་མར་མིག་ལམ་དུ་སྣང་བ་ནི་གཞན་ཕ་རོལ་བ་དེའི་འགྲོ་འདུག་སྤྱོད་གསུམ་ཡིན་ལ།",
    "འདུག་པར་གྱུར་པ་ནི་ཇི་ལྟར་རིགས་པའི་སྟན་ལ་འདུག་ནས་སོ།",
    "སྤྱོད་ལམ་མི་འཁྲུགས་པ་ཞེས་བྱ་བ་ནི་རྟག་ཏུ་མཉམ་པར་གཞག་པ་ཉིད་ཀྱིས་ལངས་པ་དང་འཆག་པ་དང་འདུག་པ་དང་ཉལ་བ་ལ་སོགས་པ་ན་རྣམ་པར་འགྱུར་བ་མེད་པ་ཉིད་ནི་སྤྱོད་ལམ་མི་འཁྲུགས་པ་ཞེས་བྱའོ།",
    "ཞེས་བྱ་བའི་དཔེས་ནི་སྒྲ་ཙམ་པ་འདུག་པར་གསུངས་སོ།",
    "འདུག་པ་དང་།",
    "ཞེས་བྱ་བ་ནི་གཞན་གནོད་པ་བྱེད་པ་ལ་ཇི་མི་སྙམ་པའི་བཟོད་པའི་བདག་ཉིད་ཅན་དུ་གྱུར་པ་དང་རང་དང་གཞན་དུ་རྟོག་པ་དང་བྲལ་བའི་ཕྱིར་སྤྱོད་ལམ་རྣམ་པ་བཞི་ཆར་ལ་ཡང་སེམས་གཡོ་བ་མེད་པར་གྱུར་པ་ན་མཉམ་པར་གཞག་པ་ཉིད་ཀྱིས་འགྲེང་ངམ་འདུག་གམ་འགྲོ་འམ་མཉམ་ཡང་རུང་།",
    "ཇི་ལྟར་མི་དག་ནགས་རིའི་ཁྲོད་འདུག་ནས།",
    "ཇི་ལྟར་བར་སྣང་རང་བཞིན་སྟོང་པ་ལྟར།",
    "ཤིང་ཏ་ལ་བདུན་ཙམ་དུ་འཕགས་ནས་ནམ་མཁའ་ལ་འདུག་སྟེ།",
    "ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་མགོ་བོས་ཕྱག་བྱས་ནས་མདུན་དུ་འདུག་པར་གྱུར་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་ང་ནི་རྒྱལ་པོ་དཔལ་གྱི་སྟོབས་སུ་གྱུར།",
    "དེ་ནས་དེ་ཉིད་དུ་དྲི་ཟའི་བུ་གཙུག་ཕུད་ལྔ་པ་ཞེས་བྱ་བ་སིལ་སྙན་ལྔ་བརྒྱ་དང་བཅས་པར་ནམ་མཁའི་དཀྱིལ་ནས་བབས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་པར་གྱུར་ཏེ་བསྙེན་བཀུར་དང་གཡོག་བྱེད་དོ།",
