    "ཅ་ཏ་ར་དང་རང་མཐུན་གདན་འབུལ་གྱི།",
    "སྒྲུབ་གཤེན་ཡོན་མཆོད་འགྲོ་འདུག་གང་བྱེད་ཀྱང་།",
    "རང་རང་གནས་སུ་བདེ་བར་དེངས།",
    "གལ་ཏེ་མི་འགྲོ་འདུག་པ་ན།",
    "དགྲ་གྱོད་ངོ་འདུག་གཟུངས་འདུས་དང་།",
    "འཐབ་རྩོད་གྱོད་ངོ་སོགས་འདུག་པའི།",
    "སྲིད་ཕྱྭ་སྲིད་བྱུང་ངོ་འདུག་ཀྱང་།",
    "ཁྱེའུ་སྐྱེས་པའི་ངོ་ཡང་འདུག།",
    "མནན་གཏད་བྱད་ཁའི་ངོ་ཡང་འདུག།",
    "གནས་གཞི་༤འདུག་གནས་༤ཁྱིམ་དང་༦ཁབ་༧།",
    "ཆུང་ཆུང་རང་ཤོང་ཕུག་པར་སྒྲུབ་ཡུན་བསྲིང་།",
    "རང་རང་གནས་སུ་འཕྲལ་ཡུན་བདེ་བའི་ཐབས།",
    "རང་རང་འབད་པས་སྒྲུབ་པར་མི་བྱེད་པར།",
    "འབོལ་འབོལ་སྟན་པ་ལ་འདུག་འདུག་རྣམ་དང་།",
    "ཇི་ལྟར་འབད་ཀྱང་རང་མཚང་མྱུར་བར་སྟོན།",
    "བྱས་མ་ཐག་ཏུ་ཡིན་གྱི་དུས་གཞན་གྱི་བར་དུ་གསོན་པོར་འདུག་ནས་ཀྱང་མ་ཡིན་ནོ།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་བྱུང་གཉིས།",
    "འཛམ་བུའི་ཚལ་ན་འདུག་པའི་སོ་སོའི་སྐྱེ་བོ་ཞེས་བྱ་བ་ནི་གང་ཞེ་ན།",
    "མཁས་རྣམས་དྲི་ནི་རྫི་ཕྱོགས་མིན་འགྲོ་སྟེ།",
    "གང་ཡང་ཆགས་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འདུག་པ་དང་།",
    "དེའི་ཚེ་འཇིག་རྟེན་འདི་ཞིག་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འདུག་པ་གང་ཡིན་པ་དེ་ལས་ནི་ངེས་པར་བྱུང་བ་ཞེས་བརྗོད་པར་བྱ་ལ།",
    "ཆགས་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འདུག་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ནི་ཉེ་བར་འོངས་པ་ཡིན་ནོ།",
    "ཉི་ཤུར་ཞིག་ནས་འདུག་གོ།",
    "མུ་གེ་དག་དུས་ཇི་སྲིད་དུ་འདུ་ཞེ་ན།",
    "ནམ་ཞིག་དུས་ཇི་སྲིད་ཅིག་ཏུ་འགྱུར་ཞེ་ན།",
    "དམའ་བར་འདུག་སྨྲས་བཟླས་པ་ཡིས།",
    "བོར་ན་དེ་ཚེ་འདུག་པ་ནི།",
    "བགྲོད་མིན་འགྲོ་བ་འདོད་པ་ཡིས།",
    "བྱེ་ནས་དུས་ཇི་སྲིད་དུ་ཅིག་ཏུ་འདུག་ཅེ་ན།",
    "མ་ཁྲིའུའི་འོག་ན་འདུག་པ་བསད་པ་དང་།",
    "ལྷག་འདུག་ན་རིས་གཙང་བཟོ་གལ།",
    "ལན་འདེབས་ནང་འདི་ལོའི་ཕི་ཟླ་༧ ཚེས་༡༥ གོང་འགན་ལྷན་ནས་བཀའ་འཁྲོལ་ཞུས་ཏེ་རིས་གཙང་ཞུ་འཐུས་ཆོག་པ་ཞུས་འདུག་ཀང་།",
    "གང་མྱུར་རིས་གཙང་བཟོ་འཆར་ཡིན་ལུགས་བཀོད་འདུག་ཀང་ད་བར་ལག་ལེན་འཁེལ་བ་བྱུང་མི་འདུག་པས་རིས་གཙང་བཟོ་དགོས།",
    "རིས་ལོ་༢༡༣་༡༤ ལོའི་རིས་ཞིབ་སྐབས་རིས་གཙང་བཟོས་ཡོད་གནས་འཁོད་འདུག་ཀང་།",
    "ལན་འདེབས་ནང་བསྡུ་དངུལ་འབུལ་འབབ་ད་བར་རིས་གཙང་ཟིན་ཞེས་གསལ་འདུག་རུང་།",
    "རིས་ཞིབ་ནས་བཏོན་པའི་སྙན་ཐོའི་ནང་སོན་རིས་བཀའ་འཁྲོལ་ལས་བརྒལ་བ་དང་བཀའ་འཁྲོལ་མེད་པའང་འདུག་ན།",
    "རིས་ཞིབ་ནས་བཏོན་པའི་སྙན་ཐོའི་ནང་སོན་རིས་བཀའ་འཁྲོལ་ལས་བརྒལ་བ་དང་བཀའ་འཁྲོལ་མེད་པའང་འདུག་ན།",
    "ཁོ་རང་ལ་དངོས་ར་འཕོད་ངེས་ཐོག་བདའ་འདེད་ཀིས་རིས་གཙང་བཟོ་དགོས།",
    "ལན་འདེབས་ནང་གྲོས་ཚོགས་ནས་འགྲིག་ཁོངས་བཏང་འདུག་ཀང་།",
    "ལན་འདེབས་ནང་ད་ཆ་མུ་མཐུད་ཁ་མཆུ་འགྲོ་མུས་ཀིས་བུ་ལོན་ཕིར་བཞེས་ཡོང་ཐབས་འབད་བརོན་གང་ཡོང་ཞུས་དང་ཞུ་མུས་ཡིན་གནས་གསལ་འདུག་ཀང་།",
    "ལན་འདེབས་ནང་མཉམ་དྲུང་ཟུར་པ་དང་དངུལ་གཉེར་ཟུར་པ་གཉིས་ནས་ས་འདོན་དངུལ་འབོར་རིས་གཙང་ཞུས་ཟིན་འདུག་ཅེས་གསལ་ཡང་བྱུང་འཛིན་ངོ་བཤུས་ཕུལ་འབོར་མ་བྱུང་བ་དང་།",
    "རིས་གཙང་ཟིན་འདུག་གསལ་ཡང་བྱུང་འཛིན་ངོ་བཤུས་མེད་པ་དང་།",
    "༥༥ ཆགས་ཀི་འདུག་པར་བརྟེན།",
    "ལས་བེད་མིང་ཐོག་ས་འདོན་དང་རིས་ཆད་མང་ཆེ་བ་ཚེ་འདས་སྐལ་བཟང་དང་རིས་རོགས་ཐུབ་བསྟན་དགེ་ལེགས་གཉིས་ནས་ཡིན་འདུག་པ་དངོས་ཡོད་གནས་སྟངས་ལ་གཞིགས་ཏེ་འགན་ལྷན་ནས་ཐག་གཅོད་ཀིས་རིས་གཙང་བཟོ་དགོས།",
    "བཀའ་ཤག་ནས་ཕི་ལོ་༢༡༥ ཟླ་༦ ཚེས་༢༦ ཉིན་དུས་ཚོད་རྒྱས་བཅད་ནང་རིས་གཙང་མ་བྱུང་ཚེ་སི་རྒྱུ་སེར་ཟས་ཀི་གསལ་བསགས་དང་འབེལ་རིས་བསུབ་བ་རྒྱུ་གནང་བ་ལྟར་ལ་རྒྱབ་གཉེར་གནང་འདུག་ན།",
    "འདས་པའི་ལོ་གཉིས་ཀི་ནང་སོར་རྡོག་གཅིག་ཀང་ཕིར་སོག་བས་མི་འདུག་ན།",
    "ལི་ལི་དོན་ཁང་བརྒྱུད་བདའ་འདེད་ཞུ་མུས་ཡིན་འདུག་པས་ངེས་པར་བསྡུ་བཞེས་ཐུབ་པ་དགོས།",
    "རླངས་རྫས་པུ་རིལ་༡༣ མ་ཚང་བའི་ཐད་ཞིབ་འཇུག་ཞུས་ཀང་བདའ་འདེད་ཞུ་ཡུལ་མི་འདུག་ན་དགོངས་བཞེས་ཡོང་བ་ཞུས་འདུག་ཀང་།",
    "ཞུ་ཡིག་མཉམ་སར་མི་འདུག་ལ།",
    "ཆགས་པའི་གནས་སྟངས་ཟུར་སར་དང་བཅས་པ་ཕུལ་འདུག་ན།",
    "བགྲེས་ཕོགས་ནས་ངེས་ཅན་བསྡུ་དངུལ་འབབ་གཅོག་འཐེན་མ་གནང་བར་འགན་ལྷན་ནས་ཆག་ཡང་ཐག་གཅོད་བས་འདུག་པ་ལྟར།",
    "སོབ་ཡོན་བུན་གཡར་བསྡུ་བསད་བསོམས་འབོར་ཆེན་པོ་འདུག་ན།",
    "ནང་དོན་ཡང་རིས་སིག་དང་འགལ་རིགས་ཚབས་ཆེན་མི་ཉུང་བ་ཞིག་འདུག་པ་མ་ཟད།",
    "བོད་ཕྲུག་ཁྱིམ་སེའི་ངོས་ནས་ནང་ཞིབ་གཅིག་གནང་འདུག་ནའང་།",
    "འགན་འཛིན་ལྷན་ཚོགས་ཀིས་བསར་ཞིབ་དགོས་པའི་བཀོད་ཁྱབ་བཏང་ཟིན་འདུག་པ་ལྟར།",
    "བོད་ཕྲུག་ཁྱིམ་སེའི་ངོས་ནས་ནང་ཞིབ་ཀི་སྙན་ཐོ་འབོར་འདུག་ནའང་།",
    "འབེལ་ལས་ནས་ལན་འདེབས་ནང་དངུལ་རང་ལྷག་མེད་ལུགས་ཞུས་འདུག་པ་འགན་འཛིན་ལྷན་ཚོགས་ལ་སྙན་སེང་ཞུས་ཏེ་ཞིབ་འཇུག་དགོས་རྒྱུར་བཀའ་མངགས་ཕེབས་འདུག་ཀང་།",
    "ཕུལ་ཟིན་འདུག་རིས་པ་བསྟན་འཛིན་ལེགས་མཛེས་ཀིས་བརྒྱ་ཆ་༢༥ འབབ་སོར་༩༡༤༢།",
    "སོབ་ཡོན་ཡོང་བསད་ཁོངས་རིས་ཁུར་དགོས་པ་ཆགས་འདུག་ཅེས་གསལ་བ་བཞིན་རིས་བཅོས་ཀིས་རིས་གཙང་བཟོ་དགོས།",
    "འབེལ་ཡོད་དོན་ཟུར་ནས་སྒྲུབ་འཆར་ཡིན་གནས་གསལ་འདུག་པ་ལྟར་རིས་གཙང་བཟོ་དགོས།",
    "མ་གཏོགས་གཙང་བཟོ་ཟིན་གནས་འཁོད་འདུག་ཀང་།",
    "འབི་འགོད་ཟིན་མཚམས་ད་སོན་ཕེབས་དགོངས་ལྟར་འགན་འཛིན་ལྷན་ཚོགས་སུ་འབུལ་འཆར་ལ་འགན་འཛིན་ལྷན་ཚོགས་མ་ཟིན་བར་ཚོགས་ཆུང་འཛུགས་རྒྱུར་མཐུན་འགྱུར་ཞུ་སྟབས་བདེ་མིན་ལ་དེ་རིས་མཛད་ཕོགས་ཡོང་བ་རྣམ་མངའ་ཞུ་ཞེས་ཕུལ་འདུག་པ་དང་།",
    "འགན་འཛིན་ལྷན་ཚོགས་སུ་སྙན་ཐོ་དེ་ཕུལ་མ་ཟིན་བར་དུ་གྲོས་ཚོགས་ཀི་ཆེད་བཙུགས་ཚོགས་ཆུང་ནས་ཞིབ་འཇུག་ལས་དོན་དབུ་འཛུགས་མི་དགོས་པར་གནང་རོགས་ཞེས་ཞུ་འདུག་པས།",
    "འགན་འཛིན་ལྷན་ཚོགས་སུ་སྙན་ཐོ་དེ་ཕུལ་མ་ཟིན་བར་དུ་གྲོས་ཚོགས་ཀི་ཆེད་བཙུགས་ཚོགས་ཆུང་ནས་ཞིབ་འཇུག་ལས་དོན་དབུ་འཛུགས་མི་དགོས་པར་གནང་རོགས་ཞེས་ཞུ་འདུག་གསལ་བའི་ཐད།",
    "ཞེས་འཁོད་འདུག་ཅ་",
    "བྱུང་འདུག་པར་བརྟེན་འགྲིག་པར་བས།",
    "སིག་གཞི་བསར་བཅོས་ཕིན་པའི་ངོ་བཤུས་མཉམ་འབུལ་མིན་འདུག་ཀང་།",
    "ལས་བེད་ག་ཕོགས་ཀི་སིག་གཞི་འབུལ་གནང་མིན་འདུག་ན་འགྲིག་མིན་དང་།",
    "སིར་གསོལ་ཕོགས་སར་ཕོགས་ཐད་སིག་གཞིའི་ནང་ཅུང་ཟད་འཁོད་འདུག་པ་ལྟར་ད་ཐེངས་འགྲིག་པར་བས་ཀང་།",
    "ཟུར་ཕོགས་འཕར་མ་སད་པ་དེ་སིག་འགལ་ཆགས་འདུག་ཀང་།",
    "སོད་དགོས་མེད་པར་བྱུང་ཁོངས་སུ་རིས་ཁུར་ཞུས་འདུག་པར་འགྲིག་པ་བས།",
    "༣༩ ཙམ་ཆགས་འདུག་ན།",
    "ཟུར་ཕོགས་འཕར་མ་ཁག་གཉིས་རིས་ཞིབ་ནས་ཞིབ་གནས་བཏོན་འདུག་པ་གཞིར་བཟུང་།",
    "འབེལ་ཡོད་ལས་བེད་གཉིས་ཀི་མིང་ཐོག་སྙན་བཀོད་བས་འདུག་པ་དེ།",
    "སིར་གསོལ་ཕོགས་སར་ཕོགས་ཐད་སིག་གཞིའི་ནང་ཅུང་ཟད་འཁོད་འདུག་ཀང་།",
    "ཕོགས་སར་ཐད་བརྒྱ་ཆ་༨ ནས་༡༢༨ བར་སར་ཆ་གཅིག་མཚུངས་མིན་པ་བར་ཁྱད་ཆེན་པོ་གནང་འདུག་པར་འོས་འཚམས་མིན་ནའང་།",
    "འགན་འཛིན་ལྷན་ཚོགས་ནས་བཀའ་འཁྲོལ་གང་ཡང་མ་ཞུས་པའི་ལས་གཞི་གསར་རོམ་འདི་ཡིས་སོར་འབུམ་༣ ལྷག་ཆུད་བཟོས་སུ་བཏང་འདུག་ན།",
    "གསོལ་ཕོགས་ཀི་འབབ་གྲོན་ཡང་གཞུང་གྲོན་ཁོངས་བཏང་འདུག་པ་སིག་འགལ་ཡང་།",
    "བས་པ་ཞིག་ཕུལ་འདུག་ན།",
    "སོད་བསད་བཏོན་འདུག་ན།",
    "ཆོད་གན་ལྟར་སད་འདུག་པས་འགྲིག་པ་བས།",
    "སིར་གསོལ་ཕོགས་སར་ཕོགས་ཐད་སིག་གཞིའི་ནང་ཅུང་ཟད་འཁོད་འདུག་པ་ལྟར་ད་ཐེངས་འགྲིག་པ་བས་ཀང་།",
    "༡༨ གཉིས་ལ་ཕན་པར་སོར་འབུམ་ག་ཅིག་ཕུལ་ཟིན་གནས་ཞུས་འདུག་ཀང་།",
    "བཅས་ཁག་གཉིས་ཕུལ་ཏེ་རིས་གཙང་བྱུང་འདུག་དེ་བཞིན་གཙང་ཁེ་བརྒྱ་ཆ་༡༥ འབབ་འབུལ་བསད་སོར་༩༦༦༤༢༥།",
    "༦༥ ལྷག་འདུག་པ་འདི་མུར་མ་བཞག་པར་འཕལ་མར་གཙང་བཟོ་དགོས་རྒྱུ།",
    "མ་འོངས་བེད་འཆར་སོགས་ལ་སྟངས་འཛིན་ལམ་སྟོན་གནང་དགོས་འདུག་པ་མ་ཟད།",
    "ཕོགས་སར་སྐབས་སི་སོལ་བཞིན་ཕོགས་རིམ་བསར་ཞིབ་ཚོགས་ཆུང་འཛུགས་སོལ་མེད་པ་སོགས་ད་ལྟའི་སིག་གཞིར་དགོས་ངེས་བསར་བཅོས་གནང་དགོས་འདུག་ན།",
    "ང་རང་སེར་ལ་ཆ་བཞག་ན་ཆེས་བཀུར་བ་འོས་པ་ཞིག་བརི་ཡི་ཡོད།",
    "བསྡུ་དགོས་པ་དེ་ཚོར་ཡ་མཚན་པོ་རང་རང་མཐོང་རྒྱུ་འདུག་འབུམ་དང་འབུམ།",
    "ང་རང་ཡིན་ན་ཁོང་ལ་བརི་བཀུར་དང་གུས་ཞབས་ཡོད།",
    "ད་ལྟ་མི་འགྲིག་པ་བརྒྱད་རང་འདུག་དྲུག་ཅུ་ལྷག་ཙམ་ཞིག་འགྲིག་པ་ཆགས་ཀི་འདུག་ཚོགས་གཙོ་མཆོག་ནས།",
    "ཐག་གཅོད་བེད་སྟངས་དེ་ཁྱད་མཚར་ཞིག་མེད་འགྲོ་བསམ་པའི་ཚོར་སང་ཞིག་ཡོང་འདུག་ཅེས་གསལ་པོ་བས་ཏེ་ཞུ་འདོད་བྱུང་།",
    "བེད་སྟངས་དེ་ཚོ་ཁྱད་མཚར་ཞིག་འདུག་བ་བསམ།",
    "ཞིབ་འཇུག་དུས་ཐོག་ལ་གནང་མ་ཐུབ་པ་དང་།",
    "དེ་འདའི་གནས་སྟངས་ཀི་ཐོག་ནས་ངེས་པར་དུ་ཚོགས་དགོས་ཀི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡིན།",
    "དེ་ངེས་པར་དུ་དེ་རིང་གྲོས་ཚོགས་འདི་ནས་གསུང་དགོས་ཀི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡིན།",
    "དེར་བརྟེན་ཁོ་རང་ཕྲུ་གུ་ནང་བཞིན་དང་།",
    "འགན་འཛིན་ལྷན་ཚོགས་ནས་ག་དུས་ཡིན་ནའང་།",
    "དེའི་བཟོ་འད་པོ་བས་ན་བཀའ་ཁྲི་གསར་པས་དམ་བཅའ་ཕུལ་བ་ལ་ཆུ་ཚོད་གཅིག་གཉིས་ཤིག་མ་གཏོགས་མེད་པ་ཆགས་འདུག་དངོས་ཡོད་གནས་ཚུལ།",
    "ཧ་ཅང་ཡག་པོ་འདུག་སྙམ།",
    "དེར་ངེས་པར་དུ་ཞིབ་འཇུག་ནན་པོ་བས་ཏེ་མ་འོངས་པར་རིས་ཀི་སང་ནས་འགན་ཆེན་པོ་ཞིག་བཞེས་དགོས་ཀི་འདུག་དེ་ཞུ་རྒྱུ་ཡིན།",
    "ར་བའི་ཚོགས་མིའི་ནང་ལ་མི་མང་པོ་འདུག་ཅེས་ཞུས་པ་དེ་ཡིན།",
    "གཉིས་པ་དེ་གཅིག་པ་གཅིག་རང་མ་འགྲོ་ན་བཟོ་བཅོས་གྲོས་འཆར་དེ་ལ་རྒྱབ་སོར་བེད་ཐུབ་ཀི་མི་འདུག་བསར་བཅོས་དེ་ག་རང་ལ་རྒྱབ་སོར་བེད་ཀི་ཡིན་དེ་གསལ་པོ་བས་ནས་ཞུ་རྒྱུ་ཡིན།",
    "དེ་ཡིན་དུས་ད་ལྟ་བསར་བཅོས་ནང་ལ་འགན་འཛིན་ལྷན་ཚོགས་ཀི་ཚོགས་མི་དེ་འགྱུར་བ་གཏོང་དགོས་འདུག་འོག་ཏུ་འོས་ཤོག་དང་འབེལ་བའི་ཐོག་ལ་ཚོགས་མིའི་འོས་ཤོག་བསྡུ་དགོས་པ་དང་འགན་འཛིན་ལྷན་ཚོགས་མང་པོ་ཞིག་ཆགས་བསད་པ་ཡིན་དུས།",
    "རྒྱུན་ལས་ཚོགས་མི་ཟེར་ན་ང་རང་བསམ་ན་འདི་ཅུང་ཟད་ལེགས་པ་འདུག་འགན་འཛིན་ལྷན་ཚོགས་ལབ་དུས་གོ་བ་གཞན་དག་ལ་འགྲོ་དུས།",
    "དཔལ་ལན་ཚོགས་གཙོ་མཆོག་ངས་ཞུས་པ་ཡིན་ན་འདི་ལྷན་ཚོགས་ཀི་ཚོགས་མིའི་ཞུས་ན་ཡག་པོ་འདུག་གལ་སིད་འགན་འཛིན་ལྷན་ཚོགས་ཟེར་བསྒྱུར་བ་ཡིན་ན།",
    "འདི་ལྷན་ཚོགས་ཀི་ཚོགས་མི་རང་ལ་བཞག་ན་ལེགས་པ་འདུག་ཞུ་རྒྱུ་ཡིན།",
    "དེ་ཡིན་དུས་ཚན་རིག་ཟེར་བ་འདི་དགོས་ཀི་མི་འདུག་ཚོགས་གཙོ་སེན་པ་ཚེ་རིང་མཆོག་ནས།",
    "ཡིན་གཅིག་མིན་གཉིས་ཕག་རོང་དགོས་ཀི་འདུག་གམ།",
    "དེ་འད་རང་རང་གསུངས་བསད་ན་ཏག་ཏག་ཆགས་ཀི་མི་འདུག་ཅེས་དེ་ཞུ་རྒྱུ་ཡིན།",
    "ཚན་རིག་དང་མཐུན་པའི་ཉམས་ཞིབ་ཅེས་པ་དེ་དགོས་ཀི་མི་འདུག་ཅེས།",
    "ཚན་རིག་དང་མཐུན་པ་ཞེས་པ་དེ་བཞག་དགོས་ཀི་མི་འདུག་ལབ་མཁན་ཚོས་སོན་ལ་དང་པོ་ཕག་རོང་རོགས།",
    "སོན་ལ་ཚན་རིག་དང་མཐུན་པ་ཞེས་པ་བཞག་དགོས་ཀི་མི་འདུག་གསུང་མཁན་ཚོས་སོན་ལ་ཕག་རོང་རོགས་གནང་།",
    "ཚན་རིག་དང་མཐུན་པ་ཞེས་པ་བཞག་དགོས་ཀི་འདུག་གསུང་མཁན་ཚོས་ཕག་རོང་རོགས།",
    "ལྷན་ཚོགས་ཀི་ཚོགས་མི་བཞག་དགོས་ཀི་འདུག་ཞེས་པ་དེ་སོན་དུ་ཕག་རོང་རྒྱུ་དང་།",
    "འགན་འཛིན་ལྷན་ཚོགས་ཀི་ཚོགས་མི་བཞག་དགོས་ཀི་འདུག་གསུང་མཁན་ཚོས་ཕག་རོང་རོགས་གནང་།",
    "དཔལ་ལན་ཚོགས་གཙོ་མཆོག་ཁ་དང་ག་གཉིས་འབེལ་བ་ཆགས་ཀི་འདུག་པས་མཉམ་དུ་འགྲོ་ན་འགྲིགས་སམ།",
    "ཚོགས་ཆུང་ལ་ཞུ་རྒྱུ་གཅིག་དེ་ངས་རྒྱབ་སོར་བ་རྒྱུར་ཁྱད་པར་འདུག་པས།",
    "ག་དུས་དེ་འོས་འདེམས་བས་ཡོད་དམ།",
    "དེ་རིང་བསར་དུ་འཁྱེར་ཡོང་དུས་ཚིག་སོར་རིང་པ་རང་འཇགས་བཞག་གནང་འདུག་པས།",
    "དེས་ན་ཚིག་བརོད་ཇི་མ་ཇི་བཞིན་སུ་ལ་གསུང་རྒྱུ་ཡོད་ན་གསུངས་ན་ཡག་པོ་འདུག་ཅེས་དང་།",
    "ཚོགས་ཆུང་ས་མ་དེས་ཀ་པ་དེ་ཚིག་བརོད་གང་བཞག་ཡོད་དམ་དེ་གཅིག་དགོས་ཀི་འདུག་ཅེས་དེ་གཅིག་ཡིན།",
    "དེ་ཏག་ཏག་དེ་འད་བིས་འདུག་གམ་དེ་གཉིས་ཀར།",
    "སྐབས་དེར་ཚིག་དེ་འདི་འད་བས་ནས་བཟོས་པ་ཞིག་ཆགས་ཀི་འདུག་དེས་ན་དཔལ་ལན་ཚོགས་གཙོ་མཆོག་ལ་བཀའ་འདི་ཞུ་རྒྱུར།",
    "ད་ལྟའི་ཆར་དེ་དོན་དག་སང་ལ་ཏག་ཏག་ཅིག་སེབས་ཀི་མི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡིན།",
    "དེར་གསལ་ཁ་མི་འདུག་ཞུ་རྒྱུ་ཡིན།",
    "ཡང་བསར་ཡང་བསར་མི་དགོས་པའི་ཐོག་ནས་སེབ་གཅིག་ཏུ་གསུང་ན་ཡག་པོ་འདུག་སི་འཐུས་ཀརྨ་ཡེ་ཤེས་ལགས།",
    "དེ་གཉིས་གཅིག་ཆགས་ཀི་འདུག་ཟེར་དུས།",
    "ར་བའི་ཡར་སར་དགོས་པའི་ཁྱབ་པ་མི་འདུག་ཚོགས་གཙོ་སེན་པ་ཚེ་རིང་མཆོག་ནས།",
    "ཚིག་བརོད་ཁོ་རང་མར་བཏོན་པ་ཡིན་ན།",
    "དེས་གཙང་མ་ཆགས་འགྲོ་ཡི་འདུག་འོག་དེ་དག་ཚང་མ་དགོས་པ་མི་འདུག་ཚོགས་གཙོ་སེན་པ་ཚེ་རིང་མཆོག་ནས།",
    "དཔེར་ན་ཚིག་བརོད་རིང་པ་རང་འཇགས་བཞག་དགོས་ཀི་འདུག་ཟེར་བ་ཞིག་དང་།"
  ]
}