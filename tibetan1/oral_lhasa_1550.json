    "བྱས་ན་འཇིག་རྒྱུ་གཞན་ལ་ལྟོས་མེད་ཀྱི།",
    "ཐེ་ཚོམ་སྐྱེས་ཚེ་གང་བྱས་མི་རྟག་སྟེ།",
    "བུམ་པ་ཇི་བཞིན་སྒྲ་ཡང་བྱས་ཞེ་འམ།",
    "གདུལ་བྱ་མི་རྟག་ལམ་ལ་འགོད་པར་ནུས།",
    "འདི་ལ་བལྟོས་ངག་དབྱེ་བ་གཉིས་སུ་གསུངས།",
    "མེད་པར་མ་ངེས་རྟགས་དང་མངོན་སུམ་གྱིས།",
    "ཡོད་པར་མི་འགྲུབ་ཤིན་ཏུ་ལྐོག་གྱུར་དོན།",
    "འདིས་ནི་གཞན་རྒྱུད་ཆགས་ལྡང་ཁྱད་པར་སོགས།",
    "དེ་དག་ཉིད་ལས་རྒྱ་ཆེར་རྟོགས་པར་བྱ།",
    "རྩ་བར་གསུངས་པས་སྣོད་དང་རྩ་བའི་ཁྱད།",
    "བཞི་པར་རྒྱ་བོད་མཁས་རྣམས་བཞེད་པར་འཐད།",
    "སིལ་བུ་ལ་སོགས་འདུལ་ཕྲན་དུ་མ་བཞུགས།",
    "བརྗོད་བྱ་ཐོར་བུ་ཁྱད་པར་བ་རྣམས་ལ།",
    "བཞུགས་ཤིང་གཞན་རྣམས་ལན་གསུམ་བརླག་ཅེས་གྲགས།",
    "པར་ལེན་མཁན་ཐུབ་བསྟན།",
    "མཆོད་ཆང་གཙང་བཞེས་གནང་རོགས།",
    "ལྷ་ཐུག་བོད་ལྗོངས་ས་མཐོར་དཔྱིད་དཔལ་རྣམ་པར་བཞད།",
    "བྲིསལྷ་སའི་ཞོ་སྟོན་ལ་བསྐྱོད་རྗེས།",
    "ཁ་ཤོག་པར་ལེན་མཁན།",
    "འབྲས་བཟང་སྨིན་པའི་བདོག་པར་སུ་ཞིག་བསྙོན།",
    "རྨིས་མ་མྱོང་བ་རང་ལྗོངས་སྤོབས་པ་ལགས།",
