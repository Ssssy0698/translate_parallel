    "བུ་ག་ཧ་ཅང་མི་ཆེ་བ་ཞིག་བྱས་ལ།",
    "རྩིག་པ་ལ་མངོན་དུ་ཕྱོགས་པར་བཞག་ནས་མར་མེ་དེ་ལས་བྱུང་བའི་སྣང་བས་རྩིག་ངོས་ལ་ཕོག་པའི་འོད་ཀྱི་དཀྱིལ་འཁོར་ཡུན་རིང་དུ་གནས་པར་གྱུར་པ་ལ།",
    "དེ་ལ་ཡིད་གཏོད་པར་བྱེད་པ་དེ་ནི་ཟད་པར་རྣམ་པར་ཤེས་པ་ལས་སུ་རུང་བར་བྱ་བའོ།",
    "སོར་བཞི་པ་བྱས་པ་དེ་ལ་ཡིད་གཏད་པར་བྱ་སྟེ།",
    "ཡོངས་སུ་བཅད་པ་འདི་ནི་ཟད་པར་ནམ་མཁའ་ལས་སུ་རུང་བར་བྱ་བའོ།",
    "དེ་ཡང་རྣམ་པ་དགུ་ཆར་ཡང་ཟད་པར་བྱས་པའམ།",
    "མ་བྱས་པ་ལ་འཛིན་པ་དང་།",
    "ཟད་པར་ཆུ་གང་ཡིན་པར་འཛིན་པའི་མཚན་མ་ནི་རབ་ཏུ་གཡོ་བའི་རྣམ་པ་སྟེ།",
    "འདྲེས་པའི་ཆར་སྣང་བ་དེ་ལྟ་བུ་ཁོ་ནར་གྱུར་ནས་ཉེ་བར་གནས་པ་ནི་ཟད་པར་གྱི་ཉེས་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "འདིར་མ་བྱས་པ་ལ་ཟད་པར་གྱི་ཉེས་པར་ཤེས་པར་བྱ་བ་ནི་མགལ་མེ་དང་།",
    "ཟད་པར་སྔོན་པོ་ནི་མེ་ཏོག་གེ་སར་སྡོང་བུ་མེད་པ་དང་།",
    "གེ་སར་སྡོང་བུ་བཅས་པ་དག་ཅིག་ཤོས་འདབ་མ་ཕྱེ་བ་ལྟ་བུ་དེ་ཟད་པར་གྱི་ཉེས་པར་ཤེས་པར་བྱའོ།",
    "སོ་སོར་སྣང་བའི་མཚན་མ་ནི་ཟད་པར་དཀྱིལ་འཁོར་གྱེན་དུ་འཕགས་ཏེ།",
    "ཟད་པར་སེར་པོ་ལ་སོགས་པ་ལ་ཡང་ཚུལ་འདི་ཉིད་ཡིན་ནོ།",
    "ཟད་པར་རྣམ་པར་ཤེས་པའི་འཛིན་པའི་མཚན་ཉིད་ནི་ས་རྩིག་པ་ལས་གྱེན་དུ་འཕགས་ཏེ།",
    "མ་བྱང་བའི་ཟད་པར་འཛིན་པ་དང་།",
    "དེ་ལྟར་དེ་རྣམས་ཀྱི་དེ་དང་དེ་ལ་བསླབས་པའི་ཁྱད་པར་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "གཡོ་བ་ལ་སོགས་པའི་ཁྱད་པར་འདི་འབྱོར་པར་འགྱུར་རོ།",
    "ཆུ་བོ་དང་རྒྱ་མཚོ་ལ་སོགས་པར་སྤྲུལ་པ་དང་།",
    "ས་དང་རི་བོ་ལ་སོགས་པར་སྟོན་པར་ནུས་པར་འགྱུར་རོ།",
    "མེ་དང་མེ་རྣམས་ཟིལ་གྱིས་གནོན་ཅིང་གང་དང་གང་འདོད་པ་དེ་དང་དེ་བསྲེག་པར་ནུས་པ་ཉིད་དང་།",
    "དུས་སུ་ལུས་བསྲེག་པ་ལ་སོགས་པ་ལ་འབྱོར་པར་འགྱུར་རོ།",
    "མུན་པར་རྣམ་པར་འཇིག་པ་དང་།",
    "སྤྱོད་ལམ་སྟོན་པར་བྱེད་པ་དང་།",
    "རྩིག་པ་ལ་སོགས་པ་ལ་ཐད་ཀར་ཐོགས་པ་མེད་པར་འགྲོ་བ་ལ་སོགས་པར་འབྱོར་པར་འགྱུར་རོ།",
    "རྒྱུན་མི་འཆད་པར་ཟད་པར་སྤྲོས་པ་ན་ཟད་པར་སྐྱེ་མཆེད་དོ།",
    "དེ་བཞིན་དུ་ནང་གཟུགས་མེད་པར་འདུ་ཤེས་ཤིང་ཕྱི་རོལ་གྱི་གཟུགས་རགས་པ་སྟེ།",
    "ནང་གཟུགས་མེད་པར་འདུ་ཤེས་པ་ཉིད་ལ་སྔོན་པོ་དང་།",
    "དེ་ལྟར་དཔེར་བྱས་པ་བས་ཀྱང་འདི་ལྟ་སྟེ།",
    "ཁ་དོག་སྔོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་རིགས་པ་ཡིན་ནོ།",
    "སྨོན་ནས་མཁྱེན་པ་གང་ཞེ་ན།",
    "ཤེས་པར་གང་དང་གང་འདོད་པར་འགྱུར་བ་དེ་དང་དེ་ལ་ཤེས་པར་བྱའོ་ཞེས་ཡིད་ཀྱིས་སྨོན་པར་བྱས་ནས།",
    "ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པས་དེ་ནས་ལྡང་བ་དང་།",
    "འདྲི་ལ་ཀུན་ལན་འདེབས་པར་བཞེད།",
    "རྟག་གནས་ཞེས་བྱ་བ་ནི་རྟག་ཏུ་མཉམ་པར་གཞག་པ་ལ་འཇོག་པའོ།",
    "འདྲི་བ་ལན་ཀུན་འདེབས་པར་བཞེད་པ་ནི་ཞུས་པའི་ལན་ཐམས་ཅད་འདེབས་པར་མཛད་པའོ།",
    "ཉན་ཐོས་རྣམས་ཀྱི་སྒོ་ནས་ཞེས་པ་ནི་དེ་ལས་བཟློག་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པ་ནི།",
    "བཏགས་པར་ཡོད་པ་དང་།",
    "དོན་དམ་པར་ཡོད་པ་ཞེས་བྱ་བ་སྟེ་དེ་དག་ལ་སོགས་པའོ།",
    "ཡང་དག་པར་ཕན་འདོགས་པར་མཛད་པ་ལ་ཇི་ལྟར་བཞེད་པར་བཞུགས་པས་ན་རྟེན་ཡོངས་སུ་དག་པའོ།",
    "ཇི་ལྟར་འདོད་པ་བཞིན་དུ་ཡེ་ཤེས་མངོན་དུ་བྱེད་པས་ཡང་དག་པར་བསྡུས་པ།",
    "གནས་དང་གནས་མ་ཡིན་པ་མཁྱེན་པའི་སྟོབས་དང་།",
    "ལས་དང་རྣམ་པར་སྨིན་པ་མཁྱེན་པའི་སྟོབས་དང་།",
    "སྙོམས་པར་འཇུག་པ་མཁྱེན་པའི་སྟོབས་དང་།",
    "ཁམས་སྣ་ཚོགས་མཁྱེན་པའི་སྟོབས་དང་།",
    "ཐམས་ཅད་དུ་འགྲོ་བའི་ལམ་མཁྱེན་པའི་སྟོབས་དང་།",
    "སྔོན་གྱི་གནས་རྗེས་སུ་དྲན་པ་མཁྱེན་པའི་སྟོབས་དང་།",
    "ཟག་པ་ཟད་པ་མཁྱེན་པའི་སྟོབས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་སྐུའི་སྤྱོད་པ་ཡོངས་སུ་མ་དག་པ་མི་མངའ་བས་ཞེས་གང་ཞིག་བཅས་པར་དགོངས་པ་དེ་བཞིན་གཤེགས་པ་ལ་མི་མངའ་སྟེ།",
    "ཐུགས་ཀྱི་ཕྲིན་ལས་ཀྱང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "གཞན་དག་རྣ་བ་བཏུད་དེ་གུས་པར་ཉན་པ་ལས་གོ་བཟློག་པ་རྒྱས་པར་གསུངས་པ་དེས།",
    "མི་བཟོད་པར་མི་འགྱུར་ཐུགས་མི་ཆེས་པར་མི་འགྱུར་བ་ཉིད་དང་།",
    "ལ་ལ་གཅིག་ཏུ་གུས་པར་ཉན་པ་དང་།",
    "གཅིག་ཏུ་གུས་པར་མི་ཉན་པ་དེ་དག་ལ་དེ་བཞིན་གཤེགས་པ་དགྱེས་པའམ།",
    "ཐམས་ཅད་དུ་བཏང་སྙོམས་སུ་རྣམ་པར་སྤྱོད་པ་འདི་ནི་དགོངས་པ་ཉེ་བར་གཞག་པ་གསུམ་པའོ།",
    "ཐུགས་རྗེ་ཆེན་པོ་ནི་ཕན་པར་དགོངས་པ་ཉིད་དེ།",
    "ཇི་ལྟར་རྟོག་པར་མཛད་ཅེ་ན།",
    "སུ་ཞིག་ནི་ངེས་པར་ལེགས་པ་བསྟན་པའི་སྣོད་ཡིན།",
    "གང་ཞིག་ལ་ཅི་ཞིག་བྱ་ཞེས་རྟོག་པར་མཛད་དོ།",
    "ཐུགས་མཉམ་པར་མ་བཞག་པ་མི་མངའོ།",
    "རྣམ་པར་གྲོལ་བ་ཡོངས་སུ་ཉམས་པ་མི་མངའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གང་ཞེ་ན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཅེས་བྱའོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "གང་དེ་དང་དེར་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དང་།",
    "ད་ནི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་བསྟན་པར་བྱ་བའི་ཕྱིར་རོ།",
    "བདེ་བ་ཤིན་ཏུ་ཁ་ན་མ་ཐོ་བ་མེད་པ་ཉེ་བར་ལོངས་སྤྱོད་པར་མཛད་པ་ཡིན་ནོ།",
    "གྲངས་ནི་བཞི་བཅུ་ཐམ་པར་ཚང་བ་དང་།",
    "ཞབས་གཉིས་ཀྱི་མཐིལ་ས་ལ་མཉམ་པར་འཇོག་ཅིང་ཞབས་འཁུམས་པ་མེད་པས་ཞབས་ཤིན་ཏུ་གནས་པ་དང་།",
    "ལོང་བུ་མཛེས་པར་ནུབ་པས་ན་ཞབས་ལེགས་པར་མཐོ་བ་དང་།",
