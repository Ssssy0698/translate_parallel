    "ཉིན་མོ་མི་ཚོགས་ཆེ་ཞིང་།",
    "མཚན་མོ་འབྱུང་པོའི་ཟང་ཟིང་མང་པོས་དུས་འདས་ཀྱང་།",
    "དེ་རྗེས་ཅུང་ཟད་བསིལ་དུ་སོང་།",
    "ཞོགས་རྒྱུགས་རེ་ཡང་འཛིན་མི་ནུས།",
    "འདི་སྐབས་བྱང་ཞབས་དྲུང་ནོར་ཁྱུང་ཀླུ་སྡིངས་ནས་ཡར་ངམ་རིང་ལ་ཕེབས་སོང་བའི་སྐད་ཆ་ཚོར་ཏེ།",
    "གཟིམས་ཁང་གི་རབ་གནས་སོགས་ལ་ངེད་ཡོན་མཆོད་ལྷན་དུ་ཕེབས་ཞག་གཉིས་བཞུགས།",
    "གཉེར་ཁ་བཞེས་པ་མིན་པ་དེ་རེས་ལ་ཉེས་སྐྱོན་གཞན་མ་བྱུང་བ་ཡིན།",
    "གྱི་རབ་གནས་ཞལ་དྲོ་ཆེན་མོ་དེ།",
    "ངེད་ལའང་ད་རེས་བཤགས་པ་འབུལ་བ་ཡིན་པས།",
    "སྤྱན་རས་གཟིགས་ཀྱི་རྗེས་གནང་གི་རིགས་མང་ཙམ་བྱས།",
    "འཇའ་འོད་དང་མེ་ཏོག་གི་ཆར་འབབ་པ་ཉི་མ་བསྟུད་མར་བྱུང་བ་སོགས་ཕྱི་ལྟས་ནང་ལྟས་ཐམས་ཅད་ལེགས་པར་བྱུང་།",
    "རང་རེའི་ལག་ནས་བཏང་བ་དང་།",
    "རྟག་བརྟན་རང་གི་ཚོགས་པ་དངོས་རྣམས་འདུ་ཁང་ཆེན་མོར་ཁེངས་པ་དང་།",
    "ཡོངས་གྲིལ་བ་ལ་ཧཾ་རྒྱག་ཙམ་མ་ཡིན་པར་རེ་རེ་ནས་བགྲངས་པ་ལ།",
    "ཉིན་རེ་བཞིན་མང་ཇ་གང་ཐོངས་ཐོངས་དང་།",
    "གཞན་གཏིང་སྐྱེས་ནས་ཞལ་ངོ་རེ་རེས་མང་ཇ་འགྱེད་བཅས་ཏེ།",
    "བུ་རམ་འཁྱིད་གྲུ་བཞི་ནས་འབོ་སོགས་དགའ་སྟོན་རྒྱ་ཁྱོན་ཆེ་ཞིང་བྱིངས་ཆགས་པ་འཐབ་རྩོད་སོགས་ཉེས་སྐྱོན་ཡེ་མེད་པའི་འཇམ་པ་རང་ཞིག་བྱུང་།",
    "སྐུ་བྱང་གཅིག་ཀྱང་གཅོག་དགོས་བར་བྱུང་བ་ལུགས་གཉིས་ཀར་ནས་འབྲེལ་བ་ཤིན་ཏུ་ཆེ་བས་སྐུ་སྒྲིབ་སྦྱངས་ཐབས་དེ་སྐྱོ་ཤས་དང་འབྲེལ་བ་གཅིག་གི་ངང་ནས།",
    "ནག་པོ་རིམ་བཞི་ལམ་སློང་ཆེན་མོ།",
    "དཔྱལ་ལུགས་ཀྱི་ཕག་མོ་སྒོམ་དྲུག་གི་ཁྲིད།",
    "ནཱ་རོ་མཁའ་སྤྱོད་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་ཁྲིད།",
    "དེ་ནས་བར་སྐབས་དེར་རི་ཁྲོད་ཆེན་མོར་མཚམས་ཞག་བཅུ་སྐོར་ཞིག་བྱས།",
    "གཙང་ཁང་གི་ལོགས་བྲིས་དཔལ་དུས་ཀྱི་འཁོར་ལོ་དང་དཔལ་འཁོར་ལོ་སྡོམ་པ་དང་།",
    "འཇམ་དབྱངས་ལྷ་ཁང་གི་ལོགས་བྲིས་འཕྲོས་དང་།",
    "ཨོ་རྒྱན་མཁའ་སྤྱོད་ལྷ་ཁང་གི་ལོགས་བྲིས་ཕྱེད་ཙམ་དང་།",
    "གནོད་སྦྱིན་ནོར་ལྷའི་ལྷ་ཁང་གི་སྐྱ་རིས་ཙམ་ཐེབས་སོ།",
    "གཅིག་གིས་མཛེས་པར་བྱས་པ།",
    "མཆོད་རྫས་ཀྱི་ཁྱད་པར་མཆོད་རྐོང་ཆེན་མོ་དང་།",
    "རྟིང་ཆེན་མོའི་རིགས་འགའ་རེ་ཡང་བཅོས།",
    "འདི་འབྲི་བ་ལ་ཉི་མ་ཉི་ཤུ་རྩ་ལྔ་སོང་།",
    "ཨ་ཕས་བུ་ལ་དུག་བཏང་བ་ཡིན་ཟེར་བའི་གཏམ་ནི་འདུག།",
    "དེ་རྗེས་ཟླ་བ་གསུམ་པའི་ཚེས་བཅོ་ལྔ་ལ་གཙུག་ལག་ཁང་གི་ཤར་ཕྱོགས་ལ་བཀྲམ་སྟེ་ཕྱག་མཆོད་གཟབ་པ་ཞིག་བྱས།",
    "རང་ཡང་ལྷག་པར་འདི་ལ་མོས་ཤིང་།",
    "ཁྱད་པར་བོ་དོང་བཀྲ་ཤིས་སྒང་ནས་གསིང་མའི་བར་ལ་ཉིན་ཟང་གིས་ཁ་བ་ཆེན་པོ་བབས།",
    "ཕྱི་རྟགས་ནང་རྟགས་ལེགས་ཉེས་འདྲེས་མ་དང་བཅས་ཚེས་བཅུ་གསུམ་ལ་དཔུང་ཐོག་ཏུ་ཕེབས་སོང་།",
    "ཞག་ཤས་ནི་བྲེལ་གཡེངས་འདྲ་ལ་སོང་།",
    "ཕག་མོ་གསང་སྒྲུབ།",
    "སྤྱན་རས་གཟིགས་སྐྱེར་སྒང་ལུགས་ཀྱི་བཀའ་གསུམ།",
    "རྗེས་སུ་ཡི་རང་གི་བར་དུ་ཁྲིད་ཀྱི་སྐོར་དང་།",
    "དངུལ་ཞོ་སུམ་བརྒྱ་ཙམ་སོང་།",
    "གསེར་ཞོ་བཞི་བཅུ་ཞེ་ལྔ་ཙམ་སོང་བ།",
    "མེ་ཏོག་གི་ཆར་ཤིན་ཏུ་ཆེ་བ་འབབ་པ་དང་།",
    "ཕྱོགས་ཐམས་ཅད་དྲི་བཟང་གིས་ཁྱབ་པ་སོགས་ཕྱི་རྟགས་དང་།",
    "ཞུ་ལན་དུ་ད་ལོའི་རེས་ལ་མི་ཡོང་བ་འདྲ་ཞུས།",
    "ཨ་ལྕེ་དྲུང་གི་བཀའ་ཤོག་སྟོན་དགོས་ཟེར་བ་ཤ་སྟག་བྱུང་།",
    "ཡར་ཀླུང་ལོ་ཙཱ་བ་གྲགས་པ་རྒྱལ་མཚན་གྱིས་བསྒྱུར་བར་མཛད་པ་འདི་ལ་བར་བར་ན་རྒྱ་དཔེ་ཁོལ་འདོན་དུ་སོང་བའི་མ་ཚང་བ་མང་དུ་ཡོད་ཅེས་སྔར་གྲགས་འདུག་པ་ལྟར་དོན་ལ་གནས་པར་འདུག་ཅིང་ལོ་གྲགས་ཉིད་ཀྱི་བསྒྱུར་བའི་སྐབས་ལ་ཡོད་པ་ལ་ཡང་།",
    "དེས་ན་དཀར་ཆག་དང་བསྟུན་ན་སྒྲུབ་ཐབས་རྒྱ་མཚོའི་རྒྱ་གཞུང་དེང་སང་ཡོད་པ་འདི་ན་སྒྲུབ་ཐབས་ཤིན་ཏུ་མང་བ་ཞིག་མ་ཆུག་འདུག་པས་རང་རེས་སྔར་ནས་ཡང་ཡང་རྩོལ་བ་བྱས་ཏེ་བརྟགས་ཤིང་བཙལ་བ་ན།",
    "འགའ་ཞིག་སྒྲུབ་ཐབས་རྒྱ་མཚོ་ན་ཡོད་པ་དེ་དང་མཛད་པ་པོ་གཅིག་མི་གཅིག་མི་ཤེས་པ་རེ་རེ་གཉིས་གཉིས་ལ།",
    "རྩི་སོགས་དགོས་ཆ་དེ་དང་འཚམས་པར་སོང་།",
    "གཞལ་ཡས་ཁང་གི་ཁྱམས་ཆེན་མོ་རྣམས་ཀྱི་ལོགས་བྲིས་གྲུབ་པར་བྱས།",
    "ཀུན་གཟིགས་ལྷ་ཁང་དུ་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་དང་།",
    "དཔྱིད་སོས་ཀ་ལྷོ་གླིང་གི་གཡས་ཅུང་ཟད་ངོམས་ཆེ་ས་གཅིག་འདུག་པ་འདིར།",
    "འདིར་རྔམ་པོ་བ་སོགས་འགོ་མི་རྣམས་ཀྱང་ཞེན་མོས་གུས་ཤ་ཚ་འདོད་པ་གང་ཡང་མེད་པས་ནག་ཆང་ལ་ཡེངས་ནས་ལས་ཀ་གྲུབ་ཆུང་ཞིང་།",
    "ནང་ཧྲོམ་རྩིགས་སུ་སོང་ཆུ་འགྲོས་སོགས་གང་ཡང་ལྷུས་མ་ཐིངས་འདུག།",
    "ངེད་མར་ཕྱོགས་ཟླ་གཅིག་གི་རིང་ལ་གཏོར་མའང་འགྱངས་པས་ལན་ནམ།",
    "དབྱར་སྟོད་དེ་སེར་དྲག་ཆེན་པོ་ཞིག་བབས་པའི་ཐོ་ལ་རྨང་ནས་འགྱེལ་བའི་བྱས་པ་ལས་རོར་སོང་བ་ཞིག་བྱུང་།",
    "དེ་ལ་སྤྱི་རྟག་བརྟན་གྱི་ས་ཕྱོགས་འདི་རྡོ་རང་མོད་པའི་རིགས་སུ་འདུག་ཀྱང་།",
    "ཡོས་ལོ་དང་འབྲུག་ལོའི་དབྱར་གུང་སྒྲུབ་པ་མོ་རྣམས་ཀྱིས་ཀྱང་རྡོ་ཅུང་ཟད་བསགས་པའི་དུས།",
    "གསར་བ་གཅིག་འཚོལ་དགོས་སྙམ་པའི་སྐབས་ནུབ་མོ་བྲག་ཅིག་ཞིག་ནས་རྡོ་ཟད་པ་མེད་པ་དེ་འདྲ་ལན་གཉིས་བྱུང་།",
    "གཙུག་ལག་ཁང་རེ་གྲུབ་པ་ན།",
    "སྔ་སོར་ཇོ་ནང་གི་བྱམས་པ་བཞེངས་པ་ཡན་ཆད་དུ་ཐམས་ཅད་ཟད་པར་བྱས་པ་ཡིན་ཡང་།",
    "གཞན་ཡང་སྔ་ཕྱིར་གསིལ་མ་མང་དུ་གནང་མོད།",
    "ངམ་རིང་གི་བྱམས་པ་བཞེངས་པ་སོགས་ཀྱི་སྐབས་ལ་ཆ་བཞག་ན།",
    "ཁོ་བོས་དྲན་པ་ནས་ད་ལྟའི་བར་དུ་ཡང་ཆེས་དཀོན་པར་སོང་སྣང་།",
    "སྔར་ཡན་ཆད་སྐུ་གཟུགས་བཞེངས་པ་ལ་དངུལ་ཆུ་ཞོ་གྲངས་སུ་བཏབ་ན་ཁྲི་ཚོ་ལྔར་ཉེ་བ་སོང་།",
    "ལྷ་ཁང་གི་སྒོའི་ཤན་སོགས་རྟག་བརྟན་གྱི་སྐོར་འདི་ལ་ལྕགས་རང་ཡང་ལྕགས་སྒྱེད་ཕྱེད་དང་ཉིས་བརྒྱ་ཙམ།",
    "ཐོང་ལྕགས་བདུན་བརྒྱ་སྐོང་དེ་སྔ་ཡན་ཆད་ལ་སོང་བས་མཚོན།",
    "འདུ་ཁང་དང་གཙང་ཁང་གི་ལོགས་བྲིས་ལ་སོགས་པའི་སྐབས་སུ་པིར་དང་།",
    "གཙང་ཁང་གི་འཇིགས་བྱེད་ཆེན་པོའི་སྐུ་ལ།",
    "སྦྱར་མཐིང་ཚོན་ཀོང་ཆུང་ཆུང་གཅིག་གི་གསུམ་ཆ་གང་ཙམ་ཞིག་གིས་ཁྱེད་པ་སོགས་ངོ་མཚར་ཤིན་ཏུ་མང་སྟེ།",
    "ཁྱད་པར་རི་མོ་བ་ཤིན་ཏུ་མང་པོ་དང་བཅས་པ་འདི་རྣམས་ལ།",
    "གོང་དུ་སྨོས་པ་ལྟར་ཟླ་རེ་བཞིན་དང་།",
    "དེ་ཚོ་མེད་ན་སྔར་ཡོད་ཡོད་པོ་རྣམས་ཀྱང་རྟ་སྦངས་གཏོང་བ་བཞིན་དུ་རིམ་ཅན་དུ་བསྐྱུར་དགོས་ཡོང་གིན་འདུག་པ་མ་མཐོང་བ་ཨེ་ཡིན།",
    "ཁྱེད་ལ་རེ་ཆེ་ཡང་མི་བྱེད་དོ་བྱས།",
    "ངེད་རྣམས་ཁོང་རང་ཚོ་ལས་ཆེས་ངན་རྒྱུའི་ཁུངས་བྱེད་རྒྱུ་ལ་ཁོ་རང་ཚོས་གང་ཡང་མ་བྱུང་།",
    "སྔ་མོ་ནས་ཤེས།",
    "དེ་ཁས་ཁོང་ཚོའི་སེམས་འཛིན་པ་ལ་མ་ཕྱིན་པ་དེ་ཡིན།",
    "ཡིན་ན་ད་ཁ་སྔ་བང་མགྱོགས་རྒྱུག་པ་རེ་ངེད་ཀྱིས་ཀྱང་ལོས་ཤེས།",
    "དཔལ་ལྡན་ཀ་ལཱ་པའི་ཞིང་གི་བཀོད་པ་དང་།",
    "ཨིནྡྲ་བྷུ་ཏཱིའི་སྤྲུལ་པའི་སྐུ་བཞུགས་པའི་སྐུ་དང་གསུང་གི་སྣང་བ་བྱུང་བ་དང་།",
    "ལྷ་མོ་ཆུ་སྲིན་གདོང་ཅན་གྱི་མིང་པོ་ཡིན་ཡང་ཟེར་བ་སྙམ་བྱུང་།",
    "ཟླ་བ་ཕྱེད་རེ་བཞིན་རྩམ་པ་མི་རྒྱབ་གསུམ་རེ་ལ་གཏོར་རྩམ་བྱས།",
    "ཆང་ཚོང་རེ་རེ་གཉིས་གཉིས་ཙམ་རེའི་གཏོར་ཆང་དང་བཅས་པའི་གཏོར་མ་འཆག་མེད་དུ་ཕུལ།",
    "རྒྱབ་རིའི་རྩེ་མོར་གཏོར་མ་གཏོང་ཐེངས་འདི་ཡིན་ལ་ལན་བཞི་སོང་བ་ལ།",
    "རེ་རེ་བཞིན་དུ་རྩམ་ཁལ་བརྒྱ་ནས་ཉིས་བརྒྱ་བར་རེ་ཡོང་བར་བྱས།",
    "ཐོག་མ་རང་རེའི་ལག་གཡོག་ཐམས་ཅད་ཀྱིས་ཀྱང་བློར་མ་ཆུད།",
    "དེ་མིན་དགྲ་མི་བྱེད་ལ་རེ་བ་སོགས་སུ་འདུག།",
    "རང་རེའི་ཕྱོགས་འཛིན་པ་སོགས་མི་ཡོད་སྙམ་པ་དེར་གདའ།",
    "ཀུན་ཏུ་ཐོགས་མེད་གཟིགས་པར་ལྡན།",
    "ལྷ་མཐུ་བོ་ཆེ་རྣམས་རང་རེ་ལ་རྟག་ཏུ་བལྟ་བཞིན་ཡང་ཡོད།",
    "མི་ལ་རེ་བ་མ་ཆེ་ལྷ་ལ་གསོལ་བ་ཐོབ་ཅེས་པ་འདི་བདེན་གཏམ་ཆེན་པོ་ཞིག་ཏུ་ཡང་གོ་ལགས།",
    "སྐབས་རེ་ཉི་མ་རེ་རེ་དང་།",
    "ཕྱོགས་འཛིན་ཞེན་འཐེན་གྱི་བན་སྐྱ་ཕོ་མོ་མཐའ་ཡས་པ་ཡོད་པ་རྣམས་ཀྱང་།",
    "གྲྭ་རིགས་ཡོན་བདག་སོགས་རྒྱལ་ཁམས་ཀྱི་སྐྱེ་བོ་འབྲེལ་ཅན་འབྲེལ་མེད་ཆེ་ཕྲ་སྐྱ་སེར་སྣ་ཚོགས་པའི་སར་འབུལ་སྡུད་དང་སློང་མོའམ།",
    "དང་སྦྱིན་པ་བྱིན་པའི་ཡུལ་གཉིས་ཀར་ངན་སོང་གི་གཡང་སར་ལག་སྦྲེལ་བྱས་ནས།",
    "ད་ནི་རང་གི་བློ་འདོད་འཚོ་བའི་ལྷག་མ་ཇི་ཙམ་ཡོད་པ་འདི།",
    "རིགས་དྲུག་གི་སྔགས་འཁོར་རྣམས་སྒེག་པའི་རྡོ་རྗེའི་ལུགས་དང་མཐུན་པ་གཅིག་ཤིན་ཏུ་གསལ་བ་ཡུན་རིང་དུ་གནས་ཤིང་འོད་འཕྲོ་བ་ཞིག་བྱུང་།",
    "སྐྱེས་ཆེན་དུ་རྫུ་བ་འགའ་ཞིག་གིས་དགོངས་དོན་གྱི་གེགས་ཁོ་ན་བྱེད་པ་ང་ལ་ཕྱི་ནང་བར་གསུམ་ནས་མང་པོས་ཞོར་བཏེག་པའི་ཨར་འཁྱམས་ནས་ཕེབས་མ་ཐུབ།",
    "གཞལ་ཡས་ཁང་གི་ལོགས་བྲིས་ཀྱི་མངོན་བྱུང་མགོན་པོ་གཉིས་ལ་རབ་གནས་བྱས་དུས།",
    "བསམ་འགྲུབ་རྩེ་ནས་དཔོན་ས་ཨ་ལྕེའི་དྲུང་གི་སྐུ་རིམ་མང་ཇ་ཞིག་བྱུང་བ་ལ།",
    "ཉེར་གཅིག་གི་སྲོད་འཇིངས་ཡོལ་ལ་པ་སྣམ་གྲོང་སྟོད་པ་གཞོན་པ་འབོད་མིར་བྱུང་བའི།",
    "ཆེ་བཞག་ཆུང་བཤོལ་གྱི་ཕན་ཐོགས་རྫུས་མ་རེས་མགོ་བོ་བསྐོར་དུ་ཕྱིན་ན།",
    "འཇིག་རྟེན་པ་རྣམས་དེ་སྐད་སྨྲ་བ་ནི་ཤིན་ཏུ་བླུན་མོད་དེ།",
    "ཁྱད་པར་ཇོ་ནང་གི་དུས་ཁྲིད་འདི་ཤིན་ཏུ་བཀའ་གཉན་པར་བྱེད།",
    "ཇོ་ནང་དུས་ཁྲིད་སྔ་རེས་གནང་བ་ཞིག་ལ།",
    "ཡང་ཕྱི་རེས་ཤིག་རྒྱལ་རྩེ་ནས་བདག་པོ་ནམ་མཁའ་ལྷུན་གྲུབ་ཤིན་ཏུ་བསྙུང་བ་ལ་སྤྱན་འདྲེན་དོས་དྲག་བྱུང་བ་ལའང་།",
    "དེ་ནས་ཉེར་གསུམ་གྱི་ནུབ་མོ་ཨ་ལྕེ་དྲུང་གཤེགས་ཟེར་ནས།",
    "ཉེར་དྲུག་གི་སྔ་དྲོ་མགྱོགས་བསྔོ་སྐྱེལ་མཁན་སླེབས།",
    "དཔལ་འཁོར་ལོ་སྡོམ་པའི་སྒྲུབ་ཐབས་སློབ་དཔོན་སྤྱོད་པ་པས་མཛད་པའི་རྒྱ་གཞུང་གི་ཊཱིཀ་ཆེན་དེ་རྩོམ་གྲུབ་པར་བྱུང་།",
    "དེ་དུས་ངེད་ཀྱིས་ལུང་ནག་གི་ལྟག་ཙམ་དེར་སྐད་ཆ་གོ།",
    "ཁལ་མ་རྣམས་རྗེས་ལ་ཡོང་གིན་ཡོད་པས།",
    "བདག་ཆེན་སྐུ་གཞོན་པ་ཨ་མིས་དྲུང་དགྱེས་ཤིང་སྤྲོ་བས།",
    "ཡིད་ཡུལ་མ་བདེ་བ་ཞིག་ལ་ཞག་གསུམ་བཞི་ཙམ་སོང་སྐབས།",
    "དུས་མི་བདེ་བའི་སྟབས་རེ་ཞིག་ཤིན་ཏུ་གསང་རྒྱུ་ཡིན་པ་དང་།",
    "སླར་ཁོང་རང་ཚོ་བྱོན་ནས་སྙན་འབུལ་བྱེད་དགོས་ཡིན་ཟེར་བ་སོགས་འདུག།",
    "སྐུ་གཤེགས་ཡུལ་ནི་བཟང་ཡུལ་མོན་པ་གདོང་དུ་སྒར་ཐོག་ཏུ་གཤེགས་གདའ།",
    "དེ་ཁ་ཐལ་ནས།",
    "ཚོ་གཏན་ཚིགས་ཆེ་ཆེ་མོ་རང་བྱེད་འདུག་པ་དེ་ཡིན།",
    "ཉིན་ཞིག་ཇོ་མོའི་རི་རྩེར་ཕྱིན་ནས་ཡོན་བདག་གི་སྐུ་རིམ་དུ་གཏོར་མ་རྒྱ་ཆེ་བ་ཞིག་གཏོང་དུས།",
    "དེ་རེས་སྐོར་སྐུ་འབྲུམ་ཡེ་མ་བྱུང་བ་དེ་ཡིན།",
    "ཡར་ཕྱོགས་དེ་རྗེས་ཐོར་པ་སོགས་ནང་བགས་ཀྱང་ཆེར་སོང་བ་ཞིག་བྱུང་བས།",
    "རང་རེས་ཀྱང་དམིགས་པའི་རྒྱབ་སྐྱོར་གང་ཡོད་བྱས།",
    "མི་གཞན་འགའ་རེས་བསམ་པ་ལ།",
    "དཀར་ཕྱོགས་ཀྱི་ལྷ་ལ་མཆོད་འཕྲིན་དགོས་ཟེར་བ་རེ་འདུག་པ་དེའི་དཀར་ཕྱོགས་ངོས་འཛིན།",
    "ཉམས་ཅི་ཡང་མེད་པའི་བླུན་པོ་ཤེས་ལྡན་དུ་རེ་བ་ཨ་རེ་སྡུག་ཨ་རེ་སྡུག།",
    "ཤི་ནས་ངན་སོང་འགྲིམ་པ་མཐོང་།",
    "སྔར་མི་བསྟེན་པ་ཞིག་གིས་འདྲེ་ཆེན་པོ་རེ་གསར་དུ་བསྟེན་དགོས་ན།",
    "ཁོ་རང་གི་དམ་ཚིག་བསྲེ་ལུགས་དང་།",
    "འཕྲལ་འཇིག་རྟེན་པའི་ཚུལ་བསྟན་པ་རང་གིས།",
    "ཡེ་ཤེས་པའི་ཁྱུ་ནས་བུད།",
    "ཚུལ་ཡང་འཇིག་རྟེན་ལས་འདས་པའི་ཚུལ་ཞིག་སྟོན་དགོས་པ་ལགས་མོད།",
    "འཇིག་རྟེན་པ་རང་གི་འགྲོགས་ལུགས་དང་།",
    "ཅུང་ཟད་མི་ཤེས་པའི་རྒྱུར་སོང་འདུག་ཅིང་།",
    "རི་མཐོན་པོ་ནགས་ཚལ་རྒྱས་པ་ཞིག་གི་ལྡན་ན།",
    "སྟེང་མ་དེ་ནས་བུད་མེད་བོངས་ཆེ་ཞིང་གཟི་བརྗིད་ཆེ་བ་རྒྱན་གྱིས་བརྒྱན་པ་ཞིག་ཐོག་རྩེ་ནས་ཉེངས་ཀྱིས་ཐོན་ནས།",
    "ཐུན་གཏོར་དང་གཏོར་འབུལ་ཐམས་ཅད་མགོན་ཁང་གི་སྟེང་གི་ཡང་རྩེ་དེར་ཕུལ།",
    "ཚོགས་བདག་ཡང་སྟེང་དུ་བཞུགས་ཡུལ་མཛད་པར་རྫུ་དགོས་པའི་སྟབས་ཡིན་ཟེར་ནས་གཏོར་འབུལ་བྱེད་ས་ཡང་མར་ཕབ་ནས་ཀུན་གཟིགས་སྟེང་གི་ཐོག་ཁར་བྱས།",
    "བདུན་པའི་ཚེས་བརྒྱད་ཀྱི་ཉིན་མོ་གཏོར་ཟོར་འཕེན་མཁན་མང་དུ་བྱུང་།",
    "གཙང་གི་རྒྱལ་སྲིད་ཀྱི་བླ་དེ་དགོན་འདིར་ཆགས་འདུག་སྟེ།"
  ]
