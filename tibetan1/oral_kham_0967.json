    "གང་ཟག་སུ་ལའང་རང་ཆས་སུ་གླ་རྩིའི་དྲི་མི་བྲོ་བ་ངེས་ཀྱང་།",
    "རབ་ཏུ་གནས་པ་ཞིག་ཡོད་པའི་དཔེ་དེ་བཞིན་དུ་མཁྱེན་བརྩེ་མཆོག་ཏུ་མངའ་བའི་བདག་ཉིད་ཆེན་པོ་སྟེ་སྐྱེས་བུ་དམ་པ་དེ་ཡང་རང་བཞིན་ཤིན་ཏུ་བརྟན་ལ་རབ་ཏུ་བརླིང་བ་གནས་སྐབས་ཐམས་ཅད་དུ་གཡོ་འགྱུར་གྱི་ཚུལ་ལས་འདས་པའོ་ཞེས་དང་།",
    "གཞན་ལ་གནོད་ཅིང་འཚེ་བར་རྩོམ་པའི་གནོད་སེམས་དང་རང་ཉིད་ཆོག་མི་ཤེས་པའི་འདོད་རྔམ་བརྣབ་སེམས་ལ་སོགས་པ་མ་རུངས་པ་ཁོ་ན་ལས་མ་འདས་པ་དང་།",
    "དོན་དུ་ནི་རང་གཞན་གཉིས་ཀ་ཕུང་བའི་རྒྱུ་འབའ་ཞིག་དོན་གཉེར་དུ་བྱེད་པ་བླང་དོར་ཕྱིན་ཅི་ལོག་པའི་བླུན་པོ་ཉིད་དུ་གྲུབ་བོ་ཞེས་གཡོན་ཅན་གྱི་ངོ་བོ་དང་རང་བཞིན་ལེགས་པར་བསྟན་ཏོ།",
    "ཀྱེ་མ་འཇིག་རྟེན་ན་བྲམ་ཟེ་ཁྱི་ཁྲིད་པའང་གདའོ་བྱས་པས།",
    "ཕྱི་ནས་མགྲོན་པོ་བོས་ཤིང་བྱུང་ཙ་ན།",
    "ཝ་ཞིག་དུས་ཡུན་རིང་དུ་སེང་གེས་རི་དྭགས་བསད་པའི་ཤ་རྣམས་ཟོས་པས།",
    "མ་སྤེལ་བར་ཡང་རང་ཉིད་འཕེལ།",
    "དེ་མིན་ནུས་པ་ད་ལྟར་བ་ངེས་ཅན་དང་ལྡན་པ་རྣམས་ཀྱིས་ཀྱང་རང་གཞན་དོན་གཉིས་ཀྱི་དགེ་མཚན་བསྒྲུབ་པ་ལ་ཅི་ནུས་ཀྱིས་གཞོལ་བར་རིགས་པ་ལས་རང་ནུས་སྟོང་ཟད་དང་ལོག་པར་མི་འགྱུར་བ་ཅི་ནས་གལ་ཆེ་བ་དང་།",
    "རང་གཞན་གཉིས་གནོད་ཀྱི་བླུན་ཚིག་དེ་ལྟ་བུ་མང་མང་སྨྲས་སཔས་ཅི་བྱ་སྟེསྟེ་ཅི་བྱར་ཡང་མེད་པས་མང་བར་མི་སྨྲ་ཞིང་བླུན་པོ་ཁ་རྙོག་ཏུ་འདུག་པ་ཁོ་ན་མཛེས་སོ་ཞེས་དང་།",
    "འདབ་ཆགས་གཞན་སྐད་འབྱིན་པ་ལ་མི་མཁས་པ་ལྐུགས་པ་ལྟ་བུ་དེ་རྣམ་འདྲའི་ཉེར་འཚེ་དང་བྲལ་ནས་རང་རང་བདེ་བར་རྒྱུ་བ་དེ་ལྟར་རོ་ཞེས་སོ།",
    "རྟག་ཏུ་སྨྲ་བ་ཉུང་ངུར་བྱ་ཞིང་ཁ་རོག་ཏུ་འདུག་པ་ལས།",
    "རྣ་བ་ནི་ཐོག་མའི་རྣམ་པ་གང་ཡིན་པ་ལ་རང་སོར་འདུག་པས་ན།",
    "བུ་རྒྱུད་སྐྱོང་བའི་ཕ་མ་རྣམས་ཀྱིས་རང་རང་མི་རབས་རྗེས་མའི་འབྱུང་འགྱུར་ལ་བསམས་ནས་རྟག་ཏུ་ཀུན་སྤྱོད་ལ་གཟབ་པར་བྱ་རིགས་པ་སྟེ།",
    "ཟས་ནོར་ཉུང་ངུས་ཀྱང་རང་གཞན་གཉིས་ཀྱི་ཕན་པ་བསྒྲུབ་ནུས་པ་ཡིན་ནོ།",
    "སློབ་དཔོན་བསྟེན་ནས་བསླབས་པ་མ་ཡིན་པ་རང་རང་རིག་སྟོབས་ཀྱིས་སྦྱངས་ཤིང་ཤེས་པའི་ཡོན་ཏན་དང་བཅས་པ་དེ་རྣམས་ནི།",
    "ཁྱེད་མཁས་པར་གདའ་བ་ལ།",
    "འཇིག་རྟེན་ན་སྐྱེ་བོ་བློ་རྒོད་པོ་ཞེས་སུ་གཞན་ལ་གྲག་ཅིང་རང་ཡང་རློམ་པ་དེ་དག་དོན་ལ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "རང་རང་སྔོན་ལས་ཀྱི་ཤུགས་ལ་རག་ལས་པ་སྟེ།",
    "ཁྲིའི་སྟེང་ན་ཕ་འདུག་པ་ལ་ཚིགས་སུ་བཅད་པས་བསྟོད་པ་དང་།་",
    "ལུས་སེམས་བདེ་ཞིང་སྐྱིད་པའི་ངང་རང་རང་གང་དུ་འགྲོ་འདོད་པ་དེ་དང་དེའི་ས་ལ་ཅི་དགའ་དགར་རྒྱུ་བ་སྟེ་འགྲོ་ཆོག་པར་ཡོད་པ་དེ་ལྟ་བུའོ་ཞེས་སོ།",
    "སྟོབས་ལ་སོགས་པ་དེ་དག་ཀུན་ཀྱང་རང་ཉིད་བརླག་པར་བྱེད་པའི་རྒྱུར་འགྱུར་བ་ཡིན་ནོ་ཞེས་སོ།་",
    "རྩོལ་བ་དོར་ནས་འདུག་པ་ལ།",
    "ཤིན་ཏུ་གཏུམ་ཞིང་རང་ལ་གནོད་པར་བྱེད་པའི་དགྲ་བོ་ཡིན་ན་ཡང་དགྲ་བོའི་སྡང་སེམས་དེ་དག་ཞི་བར་བྱེད་པའི་ཐབས་དང་ཤེས་རབ་མཁས་པ་དང་ལྡན་པ་ཞིག་ཡིན་ཚེ་རང་ལ་ཕན་ཐོགས་པའི་གྲོགས་པོ་བཟང་པོ་ཞིག་ཏུ་འགྱུར་ཐུབ་པ་བྱེད་པ་དཔེར་ན།",
    "དེའི་ཕུ་ན་སྤྲེའུ་གཉིས་འཐབ་པའི་མངོན་དུ་མཐོང་ནས་དེ་ལ་བལྟ་ཞིང་འདུག་པ་ན།",
    "ང་རང་སྤྲེ་མ་དཀར་ལྕམ་ཡིན།",
    "སུ་ཡང་རང་ཉིད་ཀྱི་དགྲ་བོ་ཡིན་པ་དང་།",
    "བཅངས་ཀྱི་འདུག་ཅེས་བརྗོད་དུ་མི་རུང་ཞིང་།",
    "དེ་དག་རྣམས་ལས་གཞན་གྱི་བྱ་བ་མི་ཤེས་ཀྱང་དེ་དང་རང་རང་སོ་སོའི་སྤྱོད་པས་སྐྱོང་བར་བྱ་ཞེས་གསུངས་པའི་དོན་ནོ།",
    "ཡང་བེ་རོ་ཙ་ནས།",
    "ཞེས་དགེ་སློང་བཱེ་རོ་ཙ་ན་ལ་མཁའ་འགྲོ་མས་གདམས་སོ།",
    "བེ་རོ་ཙ་ནས།",
    "ཞེས་དགེ་སློང་བེེ་རོ་ཙ་ན་ལ་གདམས་སོ།",
    "འཇིག་དུས་བསྐལ་པའི་རྔེ་ལྟར་འབར།",
    "ངོ་ཚ་༦མེད་པའི་འདུག་སྟངས་ནི་མི་སྡུག་པའོ།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའི་བར།",
    "ལྷོ་པ་ཐམས་ཅད་མཁྱེན་པས་ཀྱང་གསན་ཟེར་ཏིག་པ་མི་འདུག་པ་དང་།",
    "མདུན་དུ་དུལ་བར་འདུག་པ་དང་།",
    "ཚངས་པའི་ཡང་གཏེར་གཞུང་ལས་འདི་ལྟར་གདའ།",
    "ལེགས་ལྡན་རྗེ་དང་བྱང་པ་རིག་འཛིན་གྱི་ལྕགས་འདྲ་གནུབས་ལུགས་གསན་ཡཾག་ན་སྒྲུབ་ཁོག་ཆེན་པོའི་རྩ་བ་ཞེས་འདི་བགྲངས་འདུག་པས་སྒྲུབ་ཁོག་ཆེ་བ་དང་ཁ་ཉུན་ཡང་མཛོད་གཉིས་གཅིག་གམ་འདྲ་མིན་ཡིན་དང་ཕན་ཚུར་འཕྲུལ་ཤེས་པ་སོགས་གང་ཡིན་དཔྱད་མ་བཟོད།",
    "འདི་ཁ་ཐུན་ཡང་མཛོད་ལེན་ན་བརྒྱད་པ་ལྕགས་སྡིག་དང་གཅིག་ཅིང་དཔེ་རིས་རྣམས་ལྕགས་འདྲ་ལ་བལྟོས་དགོས་པ་གསན་ཡིག་ན་འདུག་གོ།",
    "གསང་སྒྲུབ་སྐོར་ལྕགས་སྡིག་ཏུ་ངོས་འཛིན་མི་འཛིན་ཇི་ལྟར་ཡང་གནམ་ས་ལྟོ་དཀྲུག་ལག་ཏུ་ལེན་པའིལྷན་ཐབས་སུ་མེད་ཐབས་མེད་པ་ཞིག་ནི་འདུག་གོ།",
    "འདིའི་མཇུག་ཅུང་ཟཟང་མ་ཚྭངས་ལ་འབྲི་བྱང་གཉིས་ཀའི་ཕྱག་དཔེར་འདུག་པ་ཤོག་སེར་ལས་འབེབས་དུས་འཚུབ་བྱུང་བས་འཕྲོར་ལུས་སྐད་དོ།",
    "མངོན་རྟོགས་ཆུང་འབྲིང་འདི་གཉིས་བྱང་བདག་རིག་འཛིན་ཆེན་པོའི་ཕྱག་དཔེར་མི་འདུག་ཅིང་།",
    "འབྲི་གུང་པའི་ཕྱག་དཔེར་འདུག་པ་འདི་འབྲེལ་ཆགས་པར་མངོན།",
    "དྲི་ཆེན་དྲི་ཆུ་སོགས་ལུས་ཀྱི་དྲི་ངན་ལ་མཚོན་ཆ་ལས་ཀྱི་འཁོར་ལོ་ཞེས་པ་བྱང་པའི་ཕྱག་དཔེར་མི་འདུག་ཅིང་།",
    "ཞབས་དྲུང་བདག་པོའི་གསན་ཡིག་ཏུ་ཡང་དེ་ལྟར་འདུག་པས།",
    "འབྲིང་བསྡུས་གཉིས་མི་འདུག།",
    "འགྲོ་འདུག་བསྲུང་བའི་ཞལ་འབྲི་",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "ནི་བརྒྱུད་ཀྱི་བརྒྱུད་འདེབས་ཞིག་འདུག་པ་ནི་མ་ཐོབ།",
    "རང་བྱུང་རང་ཤར་གསུམ་གྱི་འབྲས་བུ་དག་པའོ།",
    "ལུས་ངག་ཡིད་གསུམ་མཉམ་པའི་སྒོ་ནས་འདུག་པ།",
    "ཐབས་ཞེས་པ་རྗོ་ང་ཁའི་པར་མར་འདུག་ཀྱང་མ་ཐོབ་བོ།",
    "གཞན་ལ་ཕན་གདགས་ཤིང་རང་སྨིན་པའི་ཞལ་གདམས་ཏེ་བཅུ་དྲུག་ལས།",
    "རྐྱེན་སྣང་རང་གྲོལ་གསུམ།",
    "བཅུ་དྲུག་པ་གཞན་ལ་ཕན་གདགས་ཤིང་རང་སྨིན་པའི་ཞལ་གདམས་ནི།",
    "གཅིག་པུར་འདུག་ན་སེམས།",
    "གྲུབ་ཐོབ་དངོས་གྲུབ་ཀྱི་གཏེར་མའི་སྔགས་པ་འཁོན་སྦྱོང་ལག་པའི་འདུ་བྱེད་བསྐྱོད་བ་ལག་མཐིལ་དུ་པ་ཙ་ན་ཏི་ཟེར་བ་དང་།",
    "བེ་རོ་ཙ་ན།",
    "བདེ་གྲོལ་གྱི་ཕྱག་དཔེ་ཚང་མའི་སྟེང་ནས་སྤྱན་ཚབ་དང་སྦྲགས་ཞུས་པའི་སྐབས་གསང་འགྲེལ་འཁྲིད་སྐོར་འདི་རྣམས་ཡེ་མ་རྙེད་ཅིང་རྗེས་སུ་བཙལ་བས་ཀྱང་མི་འདུག་ཚུལ་གསན་ཡིག་ཏུ་བཏབ་ནའང་།",
    "ཡི་གེ་རང་རང་མཐུན་པ་ཉིད་དུ་ཤེས",
    "གསན་ཡིག་རྙིང་པའི་རིགས་ན་ལོགས་སུ་འདུག་པས་བརྟག་གོ།",
    "ལ་ལ་ཡང་གཏེར་དུ་སྦས་པ་སོགས་ཀྱིས་ཚང་མའི་རྒྱུན་མི་འདུག་ཅིང་།",
    "རྫོགས་པ་ཆེན་པོ་རང་བྱུང་རང་ཤར་གྱི་རྩ་བའི་རྒྱུད་ལེའུ་བཅུ་གསུམ་རྫོགས་བྱང་གཏད་རབས་ཀྱི་མཐའ་ཅན།",
    "རང་བྱུང་རང་ཤར་རྒྱུད་ལས་བྱུང་བའི་མཁའ་འགྲོའི་ཉམས་མྱོང་རིན་ཆེན་གསལ་བའི་སྒྲོན་མ་ཞེས་པ་མཚོ་རྒྱལ་གྱི་ཞུས་ལན་དམར་འཁྲིད་ཉམས་ལེན་བརྒྱད་པར་གྲགས་པ་འདི་ལ་ཐོག་མར་གླེང་གཞི་ནས་འགོ་བརྩམས་ཏེ་ལེའུ་བདུན་པ་ཡན་གྱི་ཉམས་རྟགས་དང་པོ་དང་།",
    "རིག་འཛིན་ཆེན་པོ་དང་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ཏུ་མ་རིག་མུན་སེལ་སྒྲོན་མེ་ཞེས་པའང་འདུག།"
  ]
}