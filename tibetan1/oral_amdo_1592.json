    "ཁྱོད་ཀྱིས་སྔགས་ལ་བརྟེན་ནས་དངོས་གྲུབ་ཀྱང་ཅི་ཞིག་འཐོབ་སྟེ་མི་འཐོབ་བོ་ གཞན་ཡང་རིག་སྔགས་ལས་ནི་རིག་སྔགས་གྲུབ་པ་པོ་གཞན་ཡིན་ནམ།",
    "ཡང་ན་གཞན་མིན་པ་གཅིག་ཏུ་གྱུར་པ་གང་ཡིན་ཞེས་ཁྱོད་ལ་འདྲི་ན།",
    "ནམ་མཁའ་ལ་སོགས་པར་ད་ལྟ་ཉིད་དུ་ཐོགས་པ་མེད་པར་སོང་ཞིག་གལ་ཏེ་རིག་སྔགས་དང་དེའི་ནུས་པ་གྲུབ་པ་ཐ་མི་དད་ཅིང་།",
    "རང་གི་བློས་ཡོངས་སུ་བསམས་ནས་ལན་གྱི་ཚིག་སྨྲས་པ་ནི།",
    "རིག་སྔགས་དེ་ཉིད་ཟློ་བ་པོ་བདག་ལ་ནམ་ཡང་དངོས་གྲུབ་མེད་པ་དེ་ལྟར་འགྱུར་མོད་ཀྱི།",
    "དེ་ལ་ཚངས་པ་ས་ཡི་མེ་ཏོག་གིས་ལན་སྨྲས་པ།",
    "ཨེ་མའོ་ཚངས་པ་མི་འཆི་བ་ཁྱོད་ཀྱི་བློ་འདི་ལྟ་བུ་ནི།",
    "ཤིན་ཏུ་ཉེས་པའི་དྲི་མ་མེད་པ་དག་ཡིན་པར་བསམས་ནས་ཚིག་དེ་སྐད་སྨྲས་མོད་ཀྱི།",
    "ཚིག་རེ་རེ་ལ་ཡང་ནི་མི་འཐད་པའི་སྐྱོན་གྱིས་རྙོག་པ་བཞིན་དུ་མཐོང་སྟེ།",
    "འདི་ལྟར་ཁྱོད་ཀྱིས་སྔགས་ལས་གྲུབ་པ་གཞན་དུ་གྱུར་པས་ཁྱོད་ལ་དངོས་གྲུབ་མེད་ཅིང་།",
    "ཚིག་དེ་འདྲ་སྨྲ་བ་ནི་སྨྱོན་པ་ཉིད་ནི་ཡིན་པར་འགྱུར་ཏེ།",
    "ཡེ་ཤེས་ཀྱི་སྒྲོན་མར་གྱུར་པ་ཁྱོད་ཀྱིས།",
    "དེ་ལ་ཚངས་པ་ཆེན་པོ་ས་ཡི་མེ་ཏོག་གིས་སྨྲས་པ།",
    "བདག་གིས་རྣམ་པར་དཔྱད་ན་ནི།",
    "བདག་ནི་སྔགས་དེ་ཉིད་སྒྲུབ་པ་པོ་རང་གིས་ཡིད་ལ་ཞེན་པར་བསམ་ཏེ་ཡང་ཡང་གོམས་པ་ལས་ནམ་ཞིག་ནུས་པ་མཐུ་ཅན་དུ་གྱུར་ནས་དངོས་གྲུབ་འཐོབ་པར་འདོད་དེ།",
    "ཤེས་བྱ་ཐམས་ཅད་ཀྱི་ནང་ན་བླ་ན་མེད་པ་གང་ཡིན་པའི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དེ་ཡང་རང་གིས་ལམ་གོམས་པ་ལས་འཐོབ་པར་འགྱུར་ན།",
    "གསང་སྔགས་ལས་ཀྱི་ཆོ་ག་ཁྱད་པར་ཅན་འདི་དག་གིས།",
    "གནས་སྐབས་དང་མཐར་ཐུག་གི་དངོས་གྲུབ་འཐོབ་ཏུ་ཡོད་པ་ཅི་ཞིག་སྨོས་ཏེ་སྨོས་མི་དགོས་སོ་ དེ་ཡང་བཟླས་བརྗོད་ཀྱི་དེ་ཁོ་ན་ཉིད་དང་།",
    "བདག་གི་དེ་ཁོ་ན་ཉིད།",
    "ཚངས་པ་ས་ཡི་མེ་ཏོག་བདག་གིས་རྟོགས་སོ།",
    "ཚིག་གི་འབྲུ་གནོན་ཅུང་ཟད་འདིར་བགྱིས་པ་ཡིན་ལ་ཧ་ཅང་ནོར་དོགས་ཆེན་པོ་མི་སྣང་ཡང་ཅུང་ཟད་རེས་ཚིག་སྦྱར་ཚུལ་ལ་སྐྱེད་འདོན་རྒྱུ་འདྲ་མཐོང་ན་མཁས་པ་དག་གིས་དེ་ལྟར་མཛད་འཚལ་ལོ།",
    "ཆོ་གའམ་བྱ་བ་གང་དང་གང་དག་གིས་བཟླས་བརྗོད་དང་མེར་གནས་སོགས་བསམ་གཏན་གྱི་ལས་སམ་བྱ་བ་ལ།",
    "སྒོ་གསུམ་ཉེས་པ་མེད་པར་དྲང་པོར་སྲོང་བའི་དྲང་སྲོང་གང་ཞིག་ཁྲུས་དང་གཙང་སྦྲ་སྨྱུང་བ་སོགས་ཀྱི་དཀའ་ཐུབ་ཆེན་པོ་ཅན་དེ་དག་གི་ཡང་།",
    "སྔགས་བཟླས་པའི་བསམ་གཏན་གྱི་ཐབས་དེ་དག་མེད་ན་སྔགས་བཟླས་པ་ལ་ཆེར་བརྩོན་ཡང་མི་འགྲུབ་པ་ཡིན་ན་ཕལ་པ་མ་བསྡམ་པ་དག་གིས་ལྟ་ཅི་སྨྲོས་ཏེ་མི་འགྲུབ་བོ།",
    "དེས་ཡིད་ལ་རེ་བའི་འབྲས་བུ་སྩོལ་བས་རང་སེམས་ཡོངས་སུ་ཚིམ་པར་བྱ་བའམ།",
    "སྔགས་ཀྱི་དངོས་གྲུབ་འདོད་པ་དག་གིས་ནི།",
    "ཉི་མ་རེ་རེ་བཞིན་རྟག་པར་རྒྱུན་ཏུ་སྦྱོར་བར་བྱ་སྟེ།",
    "སྤྱན་རས་གཟིགས་སམ།",
    "ཡིག་འབྲུ་རེ་རེ་ལ་སེམས་པའི་རྟོག་པ་དང་གསུམ་མོ།",
    "དེ་ལ་དམིགས་པ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་དང་གཉིས་སོ་ སྒྲུབ་པ་པོ་བདག་གི་དེ་ཁོ་ན་ཉིད་ནི།",
    "འདི་ལ་བདག་ཅེས་བྱ་བ་ངོ་བོས་གྲུབ་པ་གང་ཡང་མེད་མོད།",
    "ཡན་ལག་རྣམས་ཀྱང་རྡུལ་ཕྲ་རབ་དང་སྐད་ཅིག་མའི་ཆར་ཡང་གྲུབ་པ་མེད་པས་གཞི་རྩ་དང་བྲལ་བཞིན་རྟེན་འབྱུང་གི་སྣང་བ་ཆུ་ཟླ་ལྟ་བུ་འགོག་པ་མེད་པ་ཡིན་པས།",
    "ལོངས་སྤྱད་བྱ་དང་སྤྱོད་བྱེད་དུ་སྣང་མོད་ཀྱི།",
    "སེམས་དེའི་རང་གི་ངོ་བོར་གྲུབ་པ་རྡུལ་ཕྲ་རབ་ཀྱི་ཆ་ཙམ་ཡང་ཕྱི་ནའང་མེད་ནང་ནའང་མེད།",
    "འགྲེལ་པ་ལས་བདག་གི་དེ་ཁོ་ན་ཉིད་ནི་རིགས་པས་དཔྱད་པའི་སྟོང་པ་ཙམ་ལ་མི་བྱའི།",
    "དེའི་ཕྱིར་སློབ་དཔོན་གྱི་འགྲེལ་པར་བདག་གི་དེ་ཁོ་ན་ཉིད་ནི།",
    "བདག་དང་ཕུང་པོ་རྣམ་རིག་གི་སྤྲོས་པ་ལས་འདས་པའམ་ཡན་ལག་མེད་པ་ཞེས་སྤྱིར་བསྟན་ནས།",
    "དེ་ལྟ་བུའི་བདག་གི་དེ་ཁོ་ན་ཉིད་གཏན་ལ་ཕབས་ནས་དེ་ལ་བློ་གཞག་པར་བྱ་ཞིང་།",
    "བདག་གི་དེ་ཁོ་ན་ཉིད་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་གྱུར་པའི་སྟེང་དུ་ལྷའི་ངོ་བོ་སྔགས་ཀྱི་ཡི་གེ་དེ་དག་འདུས་ཏེ།",
    "དེ་ནས་དེ་ལྟ་བུའི་ལྷ་དེའི་སྐུ་དང་ཡན་ལག་གི་ཆ་ཤས་རེ་རེ་ནས་ཀྱང་གསལ་བཏབ་ལ་དེའི་མཚན་མ་ལ་སེམས་བཟུང་ཞིང་འདི་དང་འདི་ལྟ་བུ་ཞེས་བརྟག་པ་ལ་རྒྱུན་དུ་སེམས་བཞག་པ་ནི།",
    "གཞུང་གི་དཀྱུས་སུ་འཆད་བར་འགྱུར་རོ།",
    "བདེ་བར་གཤེགས་པ་ཉིད་རང་གི་མདུན་དུ་བསམ་ནས་ནི།",
    "བདག་གི་དེ་ཁོ་ན་ཉིད་འདི་འདྲར་བློ་བཞག་ནས་ནི།",
    "བདག་གི་དེ་ཁོ་ན་ཉིད་ཀྱང་དེ་ཡིན་ནོ།",
    "གཞི་ནི་རང་གི་ལྷ་གཞག་པ།",
    "རང་གི་ལུས་ཀྱི་གནས་ལ་བྱ།",
    "སླར་སྡུད་པ་ཡི་ཚིག་གིས་ནོན།",
    "ངག་གི་བཟླས་བརྗོད་མེད་པར་བསམ་གཏན་གྱི་སྒོ་ནས་སྔགས་འགྲུབ་པ་དང་།",
    "བདག་གི་གཞི་ལ་ང་རྒྱལ་མ་བཏང་བར་གཞི་བཞི་དུས་གཅིག་གསལ་བའི་ངང་དུ་གནས་པར་བྱ་ཞེས་གསུངས།",
    "བདག་གི་ལུས་ཐ་མལ་བར་བསམ་པས་ལྡང་ལ་ངལ་སོས་པར་གྱིས་ཤིག་ཅེས་གསུངས་ཏེ།",
    "རང་གི་ལུས་ཀྱི་ནང་དུ་སླར་སྡུད་པ་ཡིས་ཕྱིར་མི་འཕྲོ་ཞིང་མི་གཡོ་བར་བཀུག་ནས་ནི།",
    "ཡང་ན་ཅུང་ཟད་ལྷོད་པའི་ཚུལ་དུ་ཤུབ་བུར་བཟླ་བ་བྱ་ཡང་རུང་མོད་དེ།",
    "ནང་དུ་རྔུབ་ཚེ་བདག་གི་དེ་གསུམ་ལ་དམིགས་པ་གཙོ་ཆེར་བྱ་བ་རེས་མོས་བྱ་ཞིང་།",
    "ཆགས་སོགས་ཉོན་མོངས་པ་མ་ལངས་པས་དག་པ་དང་།",
    "རིག་སྔགས་དེ་ཉིད་མ་ལུས་དང་སོགས་ཚིགས་བཅད་གཅིག་གིས་བསྟན་ཏེ།",
    "མཆོག་གི་དོན་དེ་དེ་ཉིད་རྣམ་པ་གསུམ་པོ་འདི་ལེགས་པར་ཤེས་ན།",
    "དབེན་པའི་སྐྱེད་མོས་ཚལ་སོགས་ཚིགས་བཅད་གཅིག་གིས་བསྟན་ཏེ།",
    "བཟླས་པ་བྱེད་པའི་གནས་ནི་སྐྱེ་བོས་དབེན་པའི་སྐྱེད་མོས་ཚལ་དང་ཆུ་བོའི་ངོགས།",
    "གསང་སྔགས་མེར་གནས་སོགས་ཚིགས་བཅད་གཅིག་གིས་བསྟན་ཏེ།",
    "དེ་ལས་བྱུང་བ་སེམས་དང་སེམས་བྱུང་གི་དངོས་པོ་རྣམས།",
    "བློ་གྲོས་ཅན་གྱིས་ནི་བདག་གི་དེ་ཁོ་ན་ཉིད་གཉིས་སུ་མེད་པ་ལའམ།",
    "སྔགས་ཀྱི་ཡི་གེ་རྣམས་བརྒྱུས་ལ་སྟེ་གཅིག་གི་རྗེས་སུ་གཅིག་འབྲེལ་ཞིང་།",
    "སྲོག་དང་རྩོལ་བའང་ནང་དུ་བསྡུས་ཏེ་བདག་གི་དེ་ཁོ་ན་ཉིད་དུ་བཀག་པའི་བདག་ཉིད་དུ་གྱུར་པའི་རྣལ་འབྱོར་བས།",
    "ཞེས་རྣམ་པར་མི་རྟོག་པའི་གཟུགས་བརྙན་ཐོག་རེག་མེད་ཅིང་གོ་མ་རྡུག་པའི་ཕྱིར་རགས་པའི་གདོས་པ་མེད་པས་སོ་ དེ་གང་ཞེ་ན།",
    "སྒྲུབ་པའི་སྐྱེས་བུས་མཚོན་པས་བུད་མེད་སོགས་གང་ཡིན་དེས་ཐོབ་པར་འགྱུར་རོ།",
    "གནས་ནི་གཟུགས་ཀྱི་ཡན་ལག་གི་ཡིག་འབྲུར་དམིགས་པ་བཏང་བའོ།",
    "བདག་གི་དེ་ཉིད་གཏན་ལ་འབེབས་པའི་ཕྱིར་ཤེས་རབ་ཀྱིས་དཔྱད་པ་བྱེད་པ་སོགས།",
    "དེ་ལྟར་ལྟོས་བཅས་སམ་མཚན་བཅས་ཀྱི་རྣལ་འབྱོར་ལ་བརྩོན་པའི་ཚེ་ན་སྒོ་གསུམ་རབ་ཏུ་བསྡམ་པ་ཉོན་མོངས་པའི་གཉེན་པོའི་དཀའ་ཐུབ་ཆེན་པོ་རྒྱུན་ཆགས་ཤིང་མ་ཉམས་པ་དང་ལྡན་པར་བྱས་ཏེ།",
    "ལྟོས་བཅས་ཀྱི་གནས་སྐབས་དེར་ཡང་བརྟུལ་ཞུགས་ཏེ་ཡི་དམ་དུ་གོམས་པར་རེ་ཞིག་བྱས་ནས་ནི་དྲོད་རྙེད་པ་ན།",
    "སྔགས་བསྒྲུབ་པའི་ཡན་ལག་གི་སྤང་བླང་རྣམས་ཀྱང་མ་འཆོལ་བར་སྤྱད་དགོས་ཏེ།",
    "སྐབས་འདིར་ཡུལ་གྱི་བྱ་བའམ་གནས་ཀྱི་བྱ་བ་ཞེས་གསུངས་པ་འདི་སྡོད་གནས་ཁོ་ནར་མ་ཟད་འཇུག་ལྡོག་གི་གནས་སམ་ཡུལ་གོང་དུ་མ་འདུས་པ་ཐམས་ཅད་ལ་གོ་ཡང་ཆོག་འདྲ་སྙམ་མོ།",
    "ཞེས་སོགས་ཚིགས་བཅད་གཅིག་གིས་བསྟན་ཏེ་དེ་ལྟར་བསམ་གཏན་དང་བཟླས་བརྗོད་ཉིད་བརྩོན་པས་བསྒྲུབས་པས་གསང་སྔགས་ཀྱི་ལྷ་དེས་སྒྲུབ་པ་པོ་བྱིན་གྱིས་བརླབ་རུང་བར་མཁྱེན་ནས་སྤྱན་དྲངས་རུང་མ་དྲངས་རུང་དེའི་དྲུང་དུ་བྱོན་པ་ནི་སྔགས་དང་ཉེར་གྱུར་ཏེ་ཉེ་བར་གྱུར་པ་དང་།",
    "སྔགས་ཀྱི་ལྷ་དེ་ཉིད་རང་གི་གནས་དེར་མདུན་ན་བཞུགས་བཞིན་རང་ལ་སྤྱན་རས་ཀྱིས་འཚོ་བ་ནི་ལྷ་མངོན་དུ་ཕྱོགས་པ་དང་།",
    "རིག་སྔགས་ཀྱི་གཙོ་བོ་དཀྱིལ་འཁོར་གྱི་ལྷ་དེ་ཉིད་ལ་དེའི་རིགས་སུ་གཏོགས་པའི་རིག་སྔགས་ཀྱི་ཁྲོ་བོ་ཁྲོ་མོ་མངག་གཞུག་ཕོ་མོ་དང་བཅས་པ་ཐམས་ཅད་གཙོ་བོ་རྒྱལ་བའི་སྐུ་ལ་མངོན་དུ་ཕྱོགས་པར།",
    "དེ་ཕྱིར་སྒྲུབ་པ་པོས་ནམ་རིག་སྔགས་ཀྱི་བརྟུལ་ཞུགས་མངོན་དུ་བྱེད་པའི་ཚེ་རང་གི་མདུན་དུ་དེ་བཞིན་གཤེགས་པའི་སྐུ་བསམ་ལ།",
    "རིག་སྔགས་དང་གསང་སྔགས་དང་ཁྲོ་བོ་ཁྲོ་མོ་མངག་གཞུག་ཕོ་མོ་སོགས་ནམ་མཁའི་དབྱིངས་ཁྱབ་པར་ཡུད་ཙམ་བསམ་ཞིང་།",
    "ཕན་ཚུན་ཟུང་དུ་འབྲེལ་བའི་ཕྱིར་རིག་སྔགས་ནི་ལྷ་མོའི་གཟུགས་དབྱིབས་དང་།",
    "འདི་དང་འདི་ལྟ་བུའི་བྱ་བ་རྣམས་སྒྲུབ་པ་པོ་སྔགས་བཟླ་བ་ལ་བརྩོན་པ་ཡི་ཆོ་ག་ལ་འཇུག་པ་གང་གི་ཚེ་འདི་དག་བྱེད་པ་ན།",
    "བློ་དང་ལྡན་པ་དག་གིས་ཐབས་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་ཉེས་པ་དེ་དག་ཅི་ནུས་སུ་གཞིལ་བར་བྱ་དགོས་ཏེ།",
    "ཞེས་པའི་བར་གྱིས་བསྟན་ཏེ་འདི་ལའང་ནང་གི་དབྱེ་བ་ཡོད་མོད།",
    "རིང་བར་གྱུར་པའམ་བསྲིང་བ་མི་མངའ་མོད་ཀྱི་རང་གི་ལས་ཀྱི་སྐལ་བ་དང་།",
    "འདི་ལ་ལྷ་སོགས་དེ་ལྟ་བུ་མཐོང་ན་སྔགས་མངོན་དུ་གྱུར་པ་ཞེས་སྦྱར་ཡང་རུང་མོད།",
    "སྐད་ཅིག་དག་ལ་རང་གི་ལུས་ལས་ནི།",
    "ཇི་ལྟར་ན་རང་གི་ལུས་ལྷ་གཞོན་ནུར་འགྱུར་ཞིང་།",
    "རང་གི་མཐུ་ཡི་ཤེས་པས་རྒྱུད་གསལ་བར་གྱུར་པའི་ཕྱིར་བག་མེད་པར་འདོད་པས་མྱོས་ནས་སྔགས་ཀྱི་བརྩོན་པ་གཏོང་པར་མི་འགྱུར་རོ།",
    "སྔགས་ཀྱི་ལམ་ལ་བརྩོན་པ་མ་བཏང་བར་བྱས་པའི་མཐར་ཐུག་གི་འབྲས་བུ་ནི།",
    "སྔགས་ལ་བརྩོན་པའི་དཀའ་ཐུབ་ཅན་གྱིས་ཕྱི་དང་ནང་གི་ཉེ་བར་འཚེ་བའི་གནོད་པ་སྤངས་ཏེ་དེ་དག་གིས་མི་གནོད་ལ།",
    "བདེ་བ་དང་ནི་སྡུག་བསྔལ་གྱི་ལས་སྣང་གི་མཐའ་ལ་སྤྱོད་པ་དང་།",
    "ནང་གི་རྒྱུ་དེ་རྐྱེན་དང་ཕྲད་ན་བར་དུ་གཅོད་པའི་བགེགས་དང་གེགས་སུ་གྱུར་པ་འབྱུང་སྲིད་པའི་ཕྱིར་རོ།",
    "བཞི་པ་འཇུག་གི་དོན་ནི།",
    "ཤྭ་ལོ་ཀ་ལྔ་བཅུ་རྩ་གསུམ་མོ་ཞེས་སྐད།",
    "ཐབས་འདི་རེ་བ་ཡིད་བཞིན་སྐོང་བ་ཡི།",
    "ན་མོ་གུ་རུ་མཉྫུ་ཤྲཱི་ཝཱ་གཱི་ཤྭ་རཱ་ཡ།",
    "ལེགས་གསུང་འོད་ཟེར་སྟོང་གི་དྲྭ་བ་ཅན།",
    "དབྱངས་ཅན་ངག་གི་དཔལ་མོས་དགེ་ལེགས་སྩོལ།",
    "སྙན་ངག་ཟླ་བའི་འོད་ཀྱིས་མཛེས་པའི་མོད།",
    "རྨད་བྱུང་ཚིག་གི་ཉམས་འགྱུར་ཡིད་འོང་དེས།",
    "ཡིད་འཕྲོག་རྩོམ་པའི་ཚིག་གིས་གསལ་བའི་ཕྱིར།",
    "སྨྲ་བའི་ཚིག་རྣམས་ལ་ཡིད་དུ་འོང་བའི་ཉམས་ཀྱི་ཁྱད་པར་བཏོན་པའི་ཐབས་གང་གིས་དེ་ཐོས་པ་རྣམས་ཡིད་འཕྲོག་པར་ནུས་པའི་སྙན་ངག་ཅེས་བྱ་བའི་གཞུང་འདི་ནི་སྒྲ་རིག་པའི་ཡན་ལག་ཏུ་གྱུར་པ་ཡིན་ཞིང་།",
    "བདག་ཅག་གི་སྟོན་པ་ཉིད་ཀྱིས།",
    "ཟླ་བ་གྲགས་པ་སོགས་མཁས་པ་ཐམས་ཅད་ཀྱིས་བརྩམས་པ་ཀུན་ཀྱང་སྙན་ངག་གི་ལམ་དང་ལྡན་པར་སྦྱར་བ་ཡིན་ལ།",
    "རང་བཞིན་གྱི་ངག་གི་སྦྱོར་བ་ཕུན་སུམ་ཚོགས་པས་སྙན་ངག་གི་ཡོན་ཏན་ལྡན་ཏེ།",
    "དེའི་ཕྱིར་ངག་གི་སྦྱོར་བ་ཕུན་སུམ་ཚོགས་པར་བྱེད་པའི་བསྟན་བཅོས་སྙན་དངགས་ཀྱི་གཞུང་དག་འཕགས་ཡུལ་དུ་སྔོན་གྱི་སློབ་དཔོན་ར་མ་ཤྲ་མ་སོགས་ཀྱིས་བྱས་པ་དང་།",
    "སྔོན་གྱི་བསྟན་བཅོས་མཐའ་དག་གི་དོན་འདུས་ཤིང་།",
    "ངག་གི་ཡོན་ཏན་དེ་ལྟ་བུ་སྐྱེད་པར་བྱེད་པའི་བསྟན་བཅོས་ཀྱི་གཞུང་དེ་ལ་སྙན་དངགས་ཞེས་དས་འཕུལ་ཅན་བྱེད་པའི་ཚིག་ཏུ་སྔོན་གྱི་ལོ་ཙཱ་བ་མཁས་པས་བརྡ་མཛད་པ་ཡིན་པས།",
    "སྙན་ངག་གི་རྒྱན་དང་ལྡན་པའི་སྐྱེས་རབས་སོ་བཞི་ལྟ་བུ་རྣམས་དས་འཕུལ་མེད་པའི་སྙན་ངག་བྱས་ཀྱང་ལེགས་སོ།",
    "འཕགས་མཆོག་གིས་ཀྱང་ཐམས་ཅད་མཁྱེན་ཉིད་མི་འགྱུར་ཏེ།",
    "ལུང་སྔ་ཕྱི་འདི་དག་གི་དོན།",
    "དེ་འདྲའི་འཕགས་མཆོག་དེ་དག་གིས་ཀྱང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་འཐོབ་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟར་འཕགས་པ་མཆོག་ཅེས་མཆོག་གི་སྒྲས་ཐེག་ཆེན་འཕགས་པ་བསྟན་ཞིང་།",
    "དོན་རྒྱན་སོ་ལྔ་སོགས་ཀྱི་ཚུལ་ཤེས་ན་ཡིད་འཕྲོག་པའི་སྙན་ངག་སྦྱར་བ་ལ་མཁས་པའང་ཡིན་མོད་ཀྱི།",
    "སྙན་ངག་གི་རང་བཞིན་དུ་གྱུར་པའི་ཡོན་ཏན་བཅུ་དང་།",
    "དོན་རྒྱན་སོགས་ཇི་ལྟར་ཡིན་པའི་ཚུལ་ཤེས་ན་ཡིད་དུ་འོང་པའི་ཚིག་གི་རྒྱན་སྦྱོར་བ་ལ་མི་རྨོངས་པས་དེ་གཉིས་གང་ལྟར་བརྗོད་ཀྱང་དོན་ལ་འགལ་བ་མེད་དེ་བརྡ་སྤྲོད་པའམ་ལུང་སྟོན་པའི་གཞུང་ལ་སྒྲ་རིག་པ་ཞེས་བརྗོད་པ་བཞིན་ནོ།",
    "ཟློས་གར་ཡང་སྙན་ངག་གི་ཉམས་དང་ལྡན་པར་གཞུང་ལས་གསུངས་སོ།",
    "འདི་ལྟར་དོན་གང་དང་གང་ཞིག་ཤེས་པར་འདོད་པ་དེས་རྗོད་བྱེད་ཚིག་གི་ལམ་ལ་བརྟེན་ནས་དོན་གོ་བར་བྱ་དགོས་པས།",
    "དེ་ལས་ཀྱང་མཁས་པ་རྣམས་རྩོམ་པའི་བྱ་བ་ལ་འཇུག་པའི་སྐབས་སུ་སྙན་ངག་གི་གཞུང་ཤིན་ཏུ་གལ་ཆེ་བ་ཡིན་ནོ།",
    "དེ་གཉིས་ཚུལ་ཐ་དད་པས་འདི་བཟོ་རིག་གི་ནང་ཚན་ངག་བཟོའི་གཙོ་བོར་གཏོགས་ཞེས་གསུངས་ཀྱང་།",
    "སྒྲ་དང་མངོན་བརྗོད་སོགས་ལའང་ཚུལ་ཐ་དད་པ་ཡོད་མོད།",
    "ཡུལ་སོ་སོའི་ལུགས་ཀྱི་མིང་དང་དེ་ལ་རྐྱེན་ནམ་ཕྲད་སོགས་ཚུལ་བཞིན་སྦྱར་བས་བརྗོད་བྱའི་དོན་ལེགས་པར་བརྡ་འཕྲོད་པར་བྱེད་པའི་རྣམ་གཞག་སྟོན་པའི་བསྟན་བཅོས་དེ་དག་རང་རང་གི་ལུགས་ཀྱི་ལུང་སྟོན་པའམ་སྒྲ་རིག་པར་འགྱུར་ཞིང་།",
    "བརྡ་འཕྲོད་པར་བྱེད་པའི་རྣམ་གཞག་སྟོན་པའི་བསྟན་བཅོས་དེ་དག་མིང་གི་རྣམ་གྲངས་དུ་མ་དང་ལྡན་པའི་ཆ་ནས་མངོན་བརྗོད་དང་།",
    "ཟློས་གར་ལ་ལུས་ཀྱི་འཆམ་སྟབས་དང་གླུ་དབྱངས་ལྟ་བུ་ལུས་ངག་གི་བཟོར་གཏོགས་པའི་ཆ་ཡང་ཡོད་མོད་ཀྱི།",
    "དེ་དག་སོ་སོ་རང་རང་གི་སྐད་ཀྱིས་རིག་པའི་གནས་ཐམས་ཅད་ཁོང་དུ་ཆུད་པའང་ཡོད་པས།",
    "གསུམ་པ་གཞུང་གི་དོན་ལ།",
    "འཇིག་རྟེན་མེས་པོ་གདོང་བཞི་པ་ཚངས་པ་ཆེན་པོའི་གདོང་གི་པདྨའི་ཚལ་གྱི་ངང་པའི་བུ་མོ་གང་ཞིག་རྣམ་པ་ཐམས་ཅད་དུ་དཀར་བའི་གཟུགས་དང་ལྡན་ཞིང་།",
    "ཤིས་པར་བརྗོད་པ་སྟེ་སྨྲ་བ་ངག་གི་བྱེད་པོ་དབྱངས་ཅན་མ་ནི་ངག་རིག་སྨྲ་བ་རྣམས་ཀྱི་ལྷག་པའི་ལྷ་ཡིན་པས་སོ།",
    "སྒྲ་དབྱངས་དེ་ལ་དགྱེས་པས་ལྷའི་ལོ་སྟོང་དུ་རྒྱ་མཚོ་དེར་གཟིགས་ཤིང་སྒྲ་དབྱངས་ཀྱི་དགའ་བ་ཉམས་སུ་མྱོང་བར་བྱས་པའི་ཚེ་གནས་དེར་ཚངས་པའི་གདོང་ཡབ་དང་རྒྱ་མཚོ་ཡུམ་གྱི་དོད་དུ་རྟེན་ཅིང་འབྲེལ་བ་ལས།",
    "སྲིད་པ་གསུམ་གྱི་བརྟན་གཡོའི་སྒྲ་དབྱངས་དང་དྭངས་བཅུད་འདུས་པ་ལས་ལྷ་མོ་དབྱངས་ཅན་མ་འཁྲུངས་པར་གྱུར་ཅིང་།",
    "ལྷ་མོ་དེ་འཇིག་རྟེན་གསུམ་ན་མཚུངས་ཟླ་མེད་པའི་གཟུགས་དང་ལང་ཚོ་དང་ཤེས་རབ་དང་སྤོབས་པ་རྨད་དུ་བྱུང་བ་འཇིག་རྟེན་གསུམ་གྱི་མཆོད་འོས་སུ་གྱུར་པ་ནི།",
    "གང་གི་ཚེ་འཇིག་རྟེན་འདིར་མི་འཚེ་བ་དང་།",
    "རྒྱ་མཚོའི་ལྷ་མོ་སྒྲ་ལྡན་ཞེས་བྱ་བ།",
    "རང་གི་སྐད་ཀྱིས་སྐད་ཀུན་ཚིམ་པར་བྱེད།",
    "ཚངས་པའི་བུ་མོ་ཡིད་ལས་བྱུང་བ་དེ།",
    "དཔལ་ལྷ་མོ་སྒྲ་དབྱངས་ལ་བསྟོད་པ་ལས།",
    "སྒྲ་འཇོམས་ཁྱད་པར་ཚིག་གིས་དོན་མཚོན་ཏེ།",
