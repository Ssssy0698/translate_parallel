    "འུ་ཅག་སྔར་བཞིན་དལ་གྱིས་འབད་པ་བྱས་པས་ཆོག་དུས་ཡུན་མང་པོ་ཞིག་ལ་ཐམས་ཅད་ཀྱི་རྩ་བ་བསམ་ཚུལ་ལ་ཐུག་ཡོད་དེ།",
    "བབས་བབ་བཟང་བ་བཅསབཝཙ་ནམས་དབཝཱ་ཝསྶལས་སད་གཏམ་རྒྱུད་ཞེ་དྲུག་པ།",
    "དག་དག་དུས་དེར་དོམ་བདག་དང་ཁྱིམ་མཚེས་ཀྱིས་ཀྱང་གཏུག་ཡིག་བྲིས་ནས་ཡང་བསྐྱར་གྱོད་འདོན་བྱས།",
    "རང་ལ་ཡིད་ཆེས་དང་རང་ཚུགས་ཐུབ་པ་ཞིག་ཡིན་ན།",
    "ཁྱེད་ཀྱིས་ང་རང་ཕྱིར་བོས་པ་དེར་ངས་ལེ་བདའ་སྤུ་ཙམ་ཡང་བྱེད་ཀྱིན་མེད།",
    "འོན་ཏེ་ང་རང་ཕྱིར་འབོད་པའི་སྔོན་ལ་ཁྱེད་ཀྱིས་བརྡ་ཞིག་ཀྱང་མི་གཏོང་བ་ཅིའི་ཕྱིར་ཡིན་ནམ།",
    "འོན་ཀྱང་ཁྱེད་ཀྱིས་ང་རང་ཅི་བྱ་གཏོལ་མེད་དུ་བཏང་ཞེས་འཁང་ར་བྱས།",
    "དེ་མིན་སྲོག་ཆགས་སུག་པ་ཅན་རྣམས་རྒྱུག་དུས་ཁོ་ལས་མགྱོགས་པ་མཐོང་ནས།",
    "ཁོ་རང་རྒྱུག་སྙམ་པའི་དུས་དེར།",
    "མི་ཡོད་ཚད་དང་འགལ་སྲིད་ཅིང་རང་ཉིད་ལའང་བདེ་བླག་འཐོབ་མི་ཐུབ།",
    "ཁོ་རང་འཇིགས་སྐྲག་སྐྱེས་ཏེ་སྲོག་བསྡོས་ནས་བྲོས།",
    "དུག་ལྕེ་ཡི་ཡོ་ལང་འཛིང་བཞིན་ཁྱུར་མིད་ཀྱི་སྟ་གོན་བྱས་འདུག་ཁོ་རང་དངངས་སྐྲག་དང་བཅས་ཏེ་ཁྲོན་པའི་ནང་ལྷུང་བཞིན་པའི་སྐད་ཅིག་ཙམ་དེར།",
    "ཁོ་རང་བར་སྐབས་སུ་བདེ་བླག་ཙམ་དུ་གནས་ཐུབ་པ་བྱུང་སྟེ།",
    "དེ་ལྟར་ཁོ་རང་རི་གྲགས་ཅན་དང་གནས་འགངས་ཆེན།",
    "ཁོ་རང་སྤྲོ་སྐྱིད་ལྡན་པའི་མི་ཞིག་ཏུ་གྱུར་ཏོ།",
    "གལ་ཏེ་སྟག་དང་འཕྲད་ན་ཁོ་རང་སྡོང་བོའི་སྟེང་དུ་འགོ་དགོས་སྙམ།",
    "ཁོ་རང་ཚབ་ཚུབ་ངང་སྡོང་བོའི་སྟེང་དུ་འགོས།",
    "ཁོ་རང་ཉིད་ཅི་འདྲའི་ཞན་ཚུལ་གཉོམ་ཚུལ་ཞེས་འཁང་ར་བྱེད་ཀྱིན་མཆིས།",
    "མུན་འཐོམ་སྒོས་གཞན་ལ་འཛོམས་ཤིང་རང་ལ་འཐོབ་དཀའ་བའི་དངོས་པོ་དེར་ཡིད་སྨོན་སྐྱེས་མི་རུང་།",
    "ཁོ་རང་རི་དྭགས་རྒྱལ་པོར་གྱུར་བའི་མཐུན་རྐྱེན་བསྐྲུན།",
    "སྔོན་གྱི་ཚྭ་ཁུ་སྐྱེ་གང་ལས་ལྡབ་འགས་ལྗིད་འདུག་ཨ་ཧོ།",
    "ཁོང་ཁྲོ་ལངས་རིན་མི་འདུག་ཅེས་ཟེར།",
    "ཁོ་རང་ཁྲོ་དུས་ང་རང་ཁྲོ་དོན་མེད།་",
    "ཁོ་རང་དགའ་བ་འབུམ་གྱིས་མྱོས་ཏེ་ལྷའི་ཡུལ་གྱི་སྒོ་ཁར་ལངས་ནས།",
    "སྒོ་སྲུང་པ་དེ་སྔར་བཞིན་རྨོངས་པའི་ཚུལ་དུ་འདུག་དགའ་འབོད་སྒྲོག་མཁན་གྱིས།",
    "ཁོ་རང་ཅི་བྱ་གཏོལ་མེད་ཀྱི་གནས་སུ་བཅར་ཏེ།",
    "དེ་བཞིན་ཁོ་རང་སྤྲོ་བས་བརྟས་ཤིང་རང་ཉིད་ཀྱི་གདམ་ཀ་དེ་ནོར་མེད་ཡང་དག་ཡིན་པར་ཡ་མཚན་སྐྱེས།",
    "མི་ཞིག་དུས་གཏན་དུ་རྟ་རྒྱབ་ནས་འདུག་མི་བཟོད།",
    "དུས་དེར་ཁོས་ད་གཟོད་རང་ཉིད་ལན་ཆགས་ཆེན་པོར་འཕྲད་འདུག་པ་གཞི་ནས་ཤེས་སོ།",
    "སྲོག་སྐྱོབ་ཏུ་ཡོང་བའི་མི་རྣམས་ཀྱིས་ཀྱང་ཁོ་རང་མ་མཐོང་།",
    "ཁོ་རང་ལ་ཡང་སྲོག་སྐྱོབ་བྱེད་གྲུ་ཆུང་གཅིག་པུ་ལས་གཞན་ཅི་ཡང་མེད་པས།",
    "ནམ་ལངས་ཀྱང་ཁོ་རང་གནས་དེར་ད་རུང་ཐོན་མེད།",
    "ངལ་དུབ་བཅས་ཀྱིས་ཁོ་ལ་སྔར་བས་ཀྱང་མནར་གཅོད་སྐྱི་གཡའ་བ་བྱེད་ཀྱིན་འདུག་ཐེངས་གང་མང་ཞིག་ལ།",
    "ཁོ་རང་འཆི་བའི་ཚད་དུ་ཐོན་ནའང་།",
    "ཁོ་རང་དྲན་པ་སད་རྗེས།",
    "ཁོ་རང་མཚོ་སྟེང་དུ་སྐྱོད་ནས་ཉི་མ་བཞི་དང་ཞག་མ་བཞི་འགོར་ཅིང་།",
    "མི་དེས་ང་རང་ལྷ་དེ་ཡིན་ནོ་ཟེར།",
    "རང་ཉིད་སྐྱོབ་ཐུབ་པའི་མི་དེ་ཡང་རང་ཉིད།",
    "རང་ཉིད་ལ་ལེགས་འགྲུབ་བྱེད་དུ་འཇུག་མཁན་དེའང་རང་ཉིད་ལས་མ་འདས་སོ།་",
    "མིག་ཟུད་དུ་འགྱུར་མེད་ཀྱི་མདདས་ཤིག་མངོན་འདུག་ཁོས་བློ་གྲོས་ཅན་ལ།",
    "ཉིན་འགའི་རྗེས་སུ་ངས་ཁོ་རང་ང་ཡི་ལག་རོགས་སུ་འཐེན་རྩིས་ཡོད་ཅེས་ཟེར་རོ།",
    "ད་ནས་བཟུང་རང་ཉིད་ལའང་དུས་ཡུན་རིང་ཞིང་གཏན་འཇགས་ཡིན་པའི་ཡོ་འབབ་ཅིག་ཐོབ་བྱུང་།",
    "དེ་ཐམས་ཅད་ཀྱི་འབྱུང་ཡུལ་ང་རང་ཉིད་ཀྱི་གཞུང་དྲང་ལས་ཐོབ་པ་ང་ཡིས་བརྗེད་མེད་ཟེར་རོ།་",
    "ང་རང་འོ་ཟེའུ་འདི་ལས་ཐར་ངེས་ཡིན་ཞེས་སེམས་སྐུལ་བྱེད་བཞིན།",
    "ཁེ་ལས་དང་རང་སྒེར་མི་ཉུང་བ་ཞིག་ལ་རང་དང་འབྲེལ་བའི་ཉོ་མཁན་ཤོར་དུས།",
    "ཅང་མ་འགོར་བར་ཁོ་རང་ཕྱུག་པོ་མིང་དུ་གྲགས་པ་ཞིག་ཏུ་གྱུར།",
    "ཀྲོ་ཨེར་གྱི་བདག་གཉེར་པའི་གོ་གནས་ཀྱང་རང་ཤུགས་ཀྱིས་བརྟན་པོར་འགྱུར་རོ།",
    "འོན་ཀྱང་འཇིག་རྟེན་འདིར་ཁེར་རྐྱང་དང་རང་ཤུགས་ཀྱིས་སྒོ་ནས།",
    "ཁོ་རང་སེང་གེའི་ཁ་ཟས་སུ་གྱུར་འགྲོ་བ་ཤེས།",
    "མི་དེར་སྲོག་སྐྱོབ་ཅེས་འབོད་སྐད་མ་སྒྲོག་ཆུ་རྒྱུན་གྱིས་ཁོ་རང་ཆུ་དཀྱིལ་དུ་ཁུར།",
    "མཐའ་མ་ཁོ་རང་ཆུ་རྒྱུན་གྱི་གཏིང་ལ་བྱིང་ནས་ཤིའོ།",
    "ཁོ་རང་མེ་འཁོར་དུ་བསྡད་ནས་ཞིང་གྲོང་ཆུང་ཆུང་དེ་བརྒྱུད་སྐབས།",
    "མྱུར་དུ་ལོ་གཅིག་ལ་གླ་ཕོགས་སྒོར་ས་ཡ་གཅིག་བྱིན་ནས་ཁོ་རང་གདན་འདྲེན་ཞུ་རྒྱུ་ཐག་བཅད།",
    "ཁྱེད་ཀྱི་ཁྱེད་རང་སུ་ཡིན་པ་ཤེས་སམ་ཞེས་དྲིས་པར།",
    "ང་རང་གྲོགས་པོ་འདི་ལྟ་བུ་དང་འཕྲད་དུས།",
    "སེར་ཀ་ཅན་གྱི་རྫ་བུམ་ལའང་རང་དམན་བག་ཁུམས་ཀྱི་འདུ་ཤེས་ཀྱིས་བྲན་ཏེ།",
    "དངོས་གནས་བདེན་པར་འདུག་སེར་ཀ་ཅན་གྱི་མིག་ལམ་དུ་དུས་ནམ་ཡིན་མི་ཤེས་པར།",
    "གས་སྐྱོན་མེད་པའི་རྫ་བུམ་གྱི་ཕྱོགས་དེར་ཅི་ཡང་མི་འདུག་པ་མཐོང་བྱུང་།",
    "མ་མཐར་ཡང་རང་ཉིད་ལ་མི་འགོ་བར་བྱེད་པའི་ཡིད་ཚོད་ཡོད་དགོས།",
    "ཤར་ཀྱང་སྐྱོན་མེད་ཅེས་པ་ཡིན་ལ་འོན་ཀྱང་རང་ཡུལ་སྣང་༡༢ན་བའི་རིགས་པ་དང་རང་ཡུལ་གྱི་རྣམ་པ་ཤར་བའི་བློ་ཡིན་མིན་སོགས་བློ་རིག་དང་།",
    "ཐོབ་ཀྱང་རང་ལ་གཟུགས་ཀྱི་འདུ་ཤེས་བཞག་པས་ཀྱང་རུང་།"
