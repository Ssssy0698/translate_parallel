    "ཁམས་ཀྱི་དོན་ནི་རྒྱུའི་དོན་དང་ས་བོན་གྱི་དོན་དང་རང་བཞིན་གྱི་དོན་ད་ང་རིགས་ཀྱི་དོན་དང་ཆ་ཕྲ་བའི་དོན་དང་གཞིའི་དོན་ཏོ།",
    "གསོན་པ་དང་འཚོ་བ་དང་འདུག་པ་ད་ང་སྡོད་པ་ཞེས་བྱ་བའི་གྲངས་སུ་འགྲོ་བར་བྱེད་ད་དོ།",
    "ཉན་ཐོས་དང་རང་སང་ས་རྒྱས་རྣམས་ཀྱི་ནི་བདག་ལ་ཕན་པའི་ཕྱིར་ཉེ་བར་གནས་པ་དག་ཡིན་ན་ནོ།",
    "འཁོར་ཕལ་ཆེར་འདུས་ཏེ་འདུག་པའི་ཚེ།",
    "འཁོར་ཕལ་པོ་ཆེ་འདུས་ཏེ་འདུག་པའི་༡ཚེ་ཀློ་བུར་དུ་གཏམ་མི་ཟེར་ཞིང་།",
    "བསླབ་པ་རྣམས་ཕུལ་ནས་ཉམས་པར་བྱ་བའི་ཕྱིར་འདུག་པར་འདོད་ཅི་ང་།",
    "ཤིང་དྲུང་ན་འདུག་ཀྱང་རུང་སྟེ།",
    "འདུག་པའི་དུས་ན་དེའི་རྗེས་སུ་བསྒྲུབ་པ་ལས་རིག་པར་བྱ་སྟེ།",
    "འདུག་པའི་དུས་ན་ནི་སྒྲིབ་པ་དང་པོ་དང་།",
    "ཚིག་འོག་ན་འདུག་པ་སྤངས་ནས།",
    "ཁྱིམ་ན་འདུག་ན་ཆགས་པ་དང་།",
    "གཞི་དེས་ཁྱིམ་ན་འདུག་ན་ཆགས་པ་སྐྱེད་པར་བྱེད་ད་དོ།",
    "ཇི་ལྟར་འདུག་པར་བྱ་བ་ལ་༡རབ་ཏུ་ཤེས་ཤེ་ན།",
    "བསྒོ་བས་༢སྟན་ཅི་བཏིང་བ་ལ་ཚུལ་དང་མཐུན་པའི་སྤྱོད་ལམ་གྱིས་འདུག་པའོ།",
    "བཅོམ་ལྡན་འདས་བདག་དུས་གཅིག་ཅིག་ན།",
    "མཐོང་བས་ཤིན་ཏུ་རྟོགས་པར་བྱས་ནས་དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ་ནང་དུ་ཡང་དག་བཞག་ནས།",
    "༢ིགཟུགས་མ་མཆིས་པ་ན་སྤྱོད་པའི་ལྷའི་ལུས་ཕུན་སུམ་ཚོགས་པ་ཐམས་ཅད་གདའོ་ཞེས་བགྱི་བ་དེ་ལ།",
    "རྣམ་པ་༡སྣ་ཚོགས་སུ་འདུག་ཅིང་མང་པོའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་དང་།",
    "དཔེར་ན་མིག་དང་ལྡན་པའི་མི་སྣོད་ན་འདུག་པའི་ཆུ་དང་བའི་ནང་དུ་མིག་དང་རྣ་བ་གཉིས་ལ་ལྟ་བ་བཞིན་ན་ནོ།",
    "དེ་༢ལྟར་སྐྱེས་ནས་ཀྱང་རང་བཞིན་གྱིས་འཇིག་༦པའི་ཕྱིར་གཏན་དུ་མི་གནས་ས་སོ།",
    "བསྒོམས་པའི་འབྲས་བུའི་བྱམས་པའི་སྔོན་དུ་འགྲོ་ཞིང་རྒྱུའི་ཚུལ་དུ་འདུག་པའི་འདོད་པ་ན་སྤྱོད་པའི་བྱམས་པ་སྟེ།",
    "ལོངས་སྤྱོད་ཅིང་འདུག་པ་ནམས་ལའོ།",
    "འདུག་གོ།",
    "དེ་ནི་དེའི་ཚེ་འཇིག་ཚོགས་ལ་ལྟ་བས་སེམས་ཁྱབ་པར་འདུག་སྟེ།",
    "དེ་ལ་ཐབས་ཀྱི་སྒོ་ནས་ནི་གཅིག་པུ་ལྐོག་དབེན་པ་ན་འདུག་ཅིང་འདུ་བྱེད་རྣམས་ལ་ཕྱིན་ཅི་མ་ལོག་པ་དང་།",
    "མྱ་ངན་ལས་འདས་པ་ཞི་བ་ལ་འཇིག་རྟེན་པའི་ཡིད་ལ་བྱེད་པ་ཉི་ཚེས་ཀྱང་སོམ་ཉི་མེད་ཅི་ང་ཛེ་ཚོམ་མི་ཟ་༡བའོ་། གནས་ཤིང་འདུག་པ་ན་ཡང་དངོས་པོ་གསུམ་གྱི་རྟོག་པ་ངན་པ་དང་དུ་ལེན་པར་མི་བྱེད་ད་དོ།",
    "གསུམ་པོ་འདི་དག་ནི་གནས་ཤིང་འདུག་པའི་ཡང་དག་པའི་ལམ་གྱི་གདམས་ངག་ཡིན་པར་རིག་པར་བྱའོ།",
    "གནས་ཤིང་འདུག་པས་མྱ་ངན་ལས་འདས་པའི་ལམ་ལ་ཡང་དག་པར་ཞུགས་ཏེ།",
    "དེ་ལ་འབྲས་བུ་ཆེ་བ་ནི་མཚན་མ་མེད་པའི་སེམས་ཀྱི་ཏིང་ངེ་འཛིན་ལ་གོམས་པར་བྱེད་པ་ན་ཁམས་གཉིས་ཀྱི་༨བདུད་རྩིའི་སྒོ་རྙེད་ནས་འདུག་སྟེ།",
    "དེ་ལ་གནས་པའི་དྲུང་ན་ནི་མྱ་ང་ན་ལས་འདས་པ་རྣམ་པ་གཉིས་འདུག་ལ་༡ད་དུང་རྣམ་པ་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་དུ་ཐོབ་པ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་མི་སློབ་པ་ཞིག་ཡིན་ན་ནི་དེ་ཡང་རང་ཉིད་ཡོངས་སུ་མྱ་ངན་ལས་༐",
    "གནས་ཤིང་འདུག་པའི་མཚན་མ་མེད་པར་གནས་པ་ད་ང་།",
    "དེའི་འོག་ཏུ་དེ་ལྟར་སེམས་རྣམ་པར་གྲོལ་བས་རྒྱུ་ཞིང་འགྲོ་བའི་རྟག་ཏུ་གནས་པར་གྱུར་པ་རྣམས་ཀྱིས་ནི་རྗེས་སུ་ཆགས་པར་ཡང་མི་འགྱུར་མི་མཐུན་པར་ཡང་མི་འགྱུར་ལ་གནས་ཤིང་འདུག་པའི་ནི་མཚན་མ་ཐམས་ཅད་ཡིད་ལ་མི་བྱེད་པ་ད་ང་།",
    "དེ་ཡང་དཀར་པོའི་ཕྱོགས་སུ་འདུག་པ་ཁོ་ནར་རིག་པར་བྱའོ།",
    "འགྲོ་བ་བྱས་ཀྱང་འཆིང་བ་དང་རྗེས་སུ་འབྲེལ་པར་འདུག་གོ།",
    "རབ་ཏུ་བྱུང་བའི་གནས་སྐབས་རྣམས་སུ་ནི་ཆད་པ་ན་འདུག་པ་ཡིན་ན་ནོ།",
    "གསོན་ཞིང་འདུག་ལ་སྡོད་ཅིང་འཚོ་སྟེ་བདེ་བ་ད་ང་།",
    "མཛད་པ་ཉུང་དང་རང་བཞིན་སོགས།",
    "འདི་ལས་ཕྱི་རོལ་པ་ནི་མཁས་སུ་ཟིན་ཀྱང་རང་བཞིན་གྱིས་མཁས་པའི་ང་རྒྱལ་ཅན་ཡིན་ནོ་༢།",
    "འཁོར་འདུས་ཤིང་འཁོད་པ་གཟུ་བོར་འདུག་པ་ཐམས་ཅད་ཀྱིས་ཀྱང་དེ་བཞིན་གཤེགས་པ་ལ་ནི་རྒྱལ་བར་འགྱུར་བའི་སེམས་ཉེ་༡བར་འཇོག་ལ་རྒོལ་བ་ལ་ནི་ཕམ་པར་འགྱུར་བའི་སེམས་ཉེ་བར་འཇོག་པ་ད་ང་།",
    "བད་ག་བརྟགས་༡པས་ཆེད་དུ་བསྒྲུབས་པ་གང་ཡིན་པ་དེས་རྟག་ཏུ་གནས་པར་འགྱུར་ཞིང་དེ་ཁོ་ན་བཞིན་དུ་མི་འགྱུར་བའི་རིགས་ན་དེ་ཁོ་ན་ལྟར་ཡང་མི་འདུག་པ་འདི་ནི་སུན་འབྱིན་པའོ།",
    "རབ་ཏུ་དབེན་པའི་གནས་སུ་འདུག་ནས་སྒྲིབ་པ་རྣམས་ད་ང་།",
    "དེས་དེ་ཤེས་རབ་ཀྱིས་རྟོགས་ནས་སྤང་བའི་ཕྱིར་བས་མཐའི་གནས་མལ་དག་ཏུ་འདུག་སྟེ།",
    "འགྲེང་བ་དང་འདུག་པ་ད་ང་ཉལ་བ་དང་།",
    "འཇམ་ཞིང་མཉམ་ལ་ལག་མཐིལ་གྱི་རྣམ་པ་ལྟ་བུར་འདུག་པ་ཡིད་ལ་བྱེད་ད་དོ། ༐",
    "སྟོན་པའི་དྲུང་ན་འདུག་ཅིང་༡བསྙེན་བཀུར་བྱེད་པ་དང་།",
    "ཡུལ་ནི་གཅིག་ཏུ་རྣམ་པ་དུ་མར་འདུག་པའི་ཕྱིར་རོ།",
    "དགེ་སློང་བས་མཐའི་གནས་མལ་ན་འདུག་ཅིང་དབེན་པ་ན་གནས་པ་ལ་གལ་ཏེ་ཡུལ་རགས་ཤིང་རྟོག་པའི་ཀུན་ཏུ་འཁྲུག་པའི་གནས་ཀྱི་སྣང་བ་ཡིད་ལ་བྱེད་པར་གྱུར་ན་བདུད་ཀྱི་ཕྱོགས་དང་མཐུན་པ་ཡིན་ཏེ།",
    "མྱ་ངན་ལས་འདས་པ་ཐོབ་ནས་ཀྱང་གཞན་དག་དང་འཐབས་༢ནས་རྩོད་ཅིང་མི་འདུག་སྟེ།",
    "བཅིངས་པ་ལས་གྲོལ་ནས་ནམ་འབྲོས་༦པའི་བསམ་༡པ་མ་སྐྱེས་༡ཀྱི་བར་དུ་ནི་ལྷའི་འདོད་པའི་ཡོན་ཏན་རྣམས་ཀྱིས་རྩེ་ཞིང་འདུག་ལ་འབྲོས་པའི་སེམས་བསྐྱེད་མ་ཐག་ཏུ་ནི་འདོད་པའི་ཡོན་ཏན་རྣམས་ལས་ཀྱང་ཉམས་པར་འགྱུར་ལ་བདག་ཉིད་ཀྱང་བཅིང་བས་བཅིངས་པར་མཐོང་སྟེ།་",
    "གནས་ཤིང་འདུག་པ་ལོག་པའི་འདུ་ཤེས་སྔོན་དུ་འགྲོ་བ་དེ་དང་མཐུན་ཞིང་དེ་དང་མཚུངས་པར་ལྡན་པའི་རྟོག་པ་དང་།",
    "རྒྱུ་ཞིང་འགྲོ་བ་དང་གནས་ཤིང་འདུག་པ་ན་བག་མེད་པར་བྱེད་དེ་ཆགས་པར་འགྱུར་བའི་ཡུལ་རྣམས་ལ་ཚུལ་བཞིན་མ་ཡིན་པའི་མཚན་མ་འཛིན་པར་བྱེད་པ་དང་།",
    "དེ་ལ་བརྟེན་ཅིང་དེ་ལ་གནས་ནས་གཅིག་པུ་དབེན་པ་ན་འདུག་སྟེ།",
    "དེའི་རྒྱུས་གནས་ན་འདུག་པའི་རྟོག་པ་སྐྱེ་བ་དང་།",
    "༢གཉི་ག་སྐྱེ་བས་སེམས་ཡོངས་སུ་གཏུགས་ཏེ་མི་འདུག་ལ།",
    "མཐུན་པར་འདུག་ལ་ཡང་སྲིད་པར་སྐྱེ་བ་དང་མཐུན་པར་འདུག་པ་ནི་མྱ་ང་ན་ལས་འདས་པ་ལས་རིང་བ་ཞེས་བྱའོ།",
    "དེ་ལ་མ་འོངས་པའི་དུས་ན་འདུ་བྱེད་རྣམས་འདུ་བྱེད་ཀྱི་ཕུང་པོར་འདུག་སྟེ།",
    "གལ་ཏེ་དེ་༤ཡོད་པར་འགྱུར་ན་མ་འོངས་པའི་དུས་ན་རང་བཞིན་གྱིས་ཡོངས་སུ་གྲུབ་༥ཟིན་པ་དེ་དག་ནི་སྐྱེར་ཡང་མི་རུང་ལ་མི་རྟག་པ་ཉིད་དུ་སྣང་བར་ཡང་མི་འགྱུར་བའི་རིགས་ན་སྣང་ཞིང་ཡང་འདུག་སྟེ།",
    "དེ་ལས་༦འདས་པའི་དུས་ན་འདུ་བྱེད་རྣམས་ཕུང་པོར་འདུག་སྟེ།",
    "ཇི་ལྟར་དབུས་ཀྱི་མཐར་བྱུང་སྟེ་འདུག་པ་རྣམ་པར་བྱང་བར་ཡང་འགྱུར་བའོ།",
    "དེ་ལ་སྔོན་གྱི་མཐའ་ནས་དབུས་ཀྱི་མཐར་ཇི་ལྟར་བྱུང་༡བ་དང་བྱུང་ནས་ཀྱང་དབུས་ཀྱི་མཐར་ཇི་ལྟར་འདུག་ཅེ་ན།",
    "དེ་ཡང་མིག་ལ་སོགས་པ་རྟེན་དྲུག་པོ་རྣམས་ལ་གནས་ཤིང་འདུག་སྟེ།",
    "ད་ལྟར་གྱི་དུས་ན་ཚེའི་ཚད་ཇི་སྲིད་ཀྱི་བར་དུ་མདུང་ཁྱིམ་གྱི་ཚུལ་དུ་འདུག་གོ།",
    "མིང་དང་གཟུགས་ཀྱི་ས་བོན་ཡང་རྣམ་པར་ཤེས་པ་ལ་བརྟེན་ཅིང་འདུག་སྟེ།",
    "རྣམ་པ་དགུས་སྡུག་བསྔལ་ཞིང་འདུག་པའི་ཡང་སིད་པར་༡སྐྱེ་བའི་ཤིང་ཕྱི་མ་ལ་བསྐྱེད་པའི་ཕྱིར་མི་མཁས་པས་ཚེ་འདི་ལ་གསར་དུ་ལས་བྱས་པ་གང་ཡིན་པ་དེ་ནི་དེའི་སྡུག་བསྔལ་གྱི་ཤིང་གཞོན་ནུ་ལྟ་བུ་ཡིན་ཏེ།",
    "འདི་ལྟར་དེ་ནི་༤སྟོང་པ་ཉིད་ཅིག་ཤོས་ཀྱི་མི་མཐུན་པའི་ཕྱོགས་ཀྱི་ལྟ་བ་ལ་བརྟེན་ནས་འདུག་པའི་ཕྱིར་ཏེ་༥།",
    "༡ཅ་གང་རྒྱུ་དེ་རྣམས་ཀྱི་རང་བཞིན་ལ་ཡང་རང་བཞིན་དུ་རྒྱུ་ལ་ཡང་རྒྱུར།",
    "དེ་ནི་བདག་ཉིད་ཀྱང་རང་མཉམ་དུ་འདུག་ལ།",
    "གནས་ཤིང་འདུག་པ་ན་ཟླ་མེད་པར་རབ་ཏུ་དབེན་པའི་གནས་ན་འདུག་པས་བརྗེད་ངས་པ་དང་ཤེས་བཞིན་མེད་པར་གནས་པ་དེ་ཉིད་ལ་བརྟེན་ནས་ཕྱི་རོལ་དུ་སེམས་ག།",
    "འདུག་ལ་རྟོགས་པར་བྱ་བ་དང་།",
    "བདག་ཉིད་ཀྱང་སོམ་ཉི་དང་བཅས་ཏེ་ཐེ་ཚོམ་དང་བཅས་པར་འདུག་པ་འདི་ནི་གང་ཟག་གཉིས་པ་སྡུག་བསྔལ་ཞིང་མི་བདེ་བར་གནས་པ་ཡིན་ན་ནོ།",
    "དེ་ལ་ཐ་མ་ན་འདུག་པའི་རྒ་ཤི་ནི་འབྲས་བུ་ཁོ་ནར་ཟད་ད་དོ།",
    "མའི་མངལ་ན་འདུག་པ་རྣམས་ཀྱི་ཡང་དེ་དང་འདྲའོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་ནི་འཇིག་ཚོགས་ལ་ལྟ་བ་ཡིན་ན་ནོ།",
    "དེས་ན་དེ་གཅིག་པུར་འདུག་ཅིང་རྟོག་པ་རྣམས་ཀྱི་གཉེན་པོ་མ་བསྒོམས་པ་ད་ང་།",
    "སློབ་ཅིང་འདུག་པ་དང་།",
    "མི་སློབ་པ་དེའི་ནི་རྟག་ཏུ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་པས་ན་ཡོང་ས་སུ་རྫོགས་པའི་༡བདེན་པ་ཡིན་ཏེ།",
    "གནས་ཤིང་འདུག་པ་ན་ཡང་འདྲེ་བ་༡རྣམ་པར་ཞི་བའི་ཕྱིར་རོ།",
    "འདུག་ན་༨ཡང་དྲག་ཏུ་ལྗིད་ཀྱིས་དབབ་པར་མི་བྱའོ་སྙམ་པ་ནས་རྒྱས་པར་སྦྱར་ར་རོ།",
    "དུས་ལྔར་ནི་ཁ་རོག་པར་འདུག་པར་བྱ་སྟེ།",
    "དེ་ལ་གོང་ན་ཡོད་པ་ནི་ཇི་ལྟར་འདི་ན་ཁ་ཅིག་གཅིག་པུ་དབེན་པ་ན་འདུག་སྟེ།",
    "བཟོ་ལས་གློག་ཤུགས་ཅན་དང་རང་འགུལ་ཅན་གྱི་རིག་པ།",
    "འབྲས་བུའི་དང་རང་བཞིན་དང་མ་དམིགས་པའི་གཏན་ཚིགས་གསུམ་སྟེ།",
    "ཀོ་རྩིད་སོགས་ཀྱི་ལག་ཤེས་བཟོ་ལས་དར་འདུག་ཅིང་དར་སྤེལ་གཏོང་འོས་པ་ཞིག་ཀྱང་ཡིན།",
    "གཡས་རོལ་ཀྱི་འདུག་སྟངས་དང་།",
    "གཡོན་རོལ་གྱི་འདུག་སྟངས་དང་།",
    "དཔའ་བོའི་འདུག་སྟངས་ཞེས་བྱའོ།",
    "དབུ་ཆེན་ལ་རོགས་རམ་གྱིས་ལས་འགན་གང་འོས་ཤིག་བསྒྲུབ་དགོས་པ་ཡིན་འདུག་རིམ་པ་གསུམ་པ་ནི་བྱིངས་གཞིའི་གྲས་ཡིན་ལ།",
    "རྩིག་པའི་རིམ་པ་གོང་འོག་གཉིས་བར་གྱི་ཅབ་རྡོ་བཟོ་བ་རྡོ་གཡམ་གྱི་བཟོ་དབྱིབས་འདོན་རྒྱུ་སོགས་ཡིན་འདུག་གོ།",
    "བྱིངས་དཀྱུས་བཅས་རིམ་པ་གསུམ་དུ་ཕྱེ་བ་ཡིན་འདུག་གོ།",
    "གདུལ་བྱ་རང་རང་བསམ་པ་བཞིན་དྲངས་ཏེ།",
    "སློབ་དཔོན་འདི་ནང་པ་བ་ཡིན་ཟེར་ཡང་ཕྱི་རོལ་པར་མངོན་ནོ་ཞེས་གསུངས་འདུག་པས་དཔྱད་གཞི་ཆེ་བར་མངོན་ནོ།",
