    "གོང་གི་བཅུ་གཅིག་པོའི་སྟེང་དུ་ལུས་དང་སྡུག་བསྔལ་བསྣན་པས་བཅུ་གསུམ་དང་ལྡན་ནོ།",
    "དེ་ལྟར་དུས་གསུམ་པོ་དག་ནི་དངོས་པོ་རྣམས་ཀྱི་རྒྱུ་འབྲས་ཀྱི་སྣང་བ་ལ་བརྟེན་ནས་རྣམ་བཞག་གི་སྒོ་ནས་བཏགས་པའོ།",
    "དུས་གསུམ་གྱིས་བསྡུས་པའི་དུས་དེ་དག་ཡུན་རིང་ཐུང་གི་ཚད་ཀྱི་སྒོ་ནས་འདི་དང་འདི་ལྟ་བུའོ་ཞེས་ཤེས་པར་བྱེད་པ་ལ།",
    "སྐྱེས་བུ་དར་མ་ཁམས་སྙོམས་པའི་དབུགས་འབྱིན་རྔུབ་རྣལ་མ་ཟུང་རེ་གཅིག་ཏུ་བརྩིས་པ་ལ་དབུགས་གཅིག་ཅེས་བྱ།",
    "དབུགས་རེའི་ཡུན་ལ་དུས་མཐའི་སྐད་ཅིག་མ་སུམ་བརྒྱ་ཡོད་དོ།",
    "ཐང་ཅིག་རེ་ནི་ཆུ་སྲང་བཞིའི་ཡུན་ནོ།",
    "དེ་ལྟར་བརྩིས་ན་རྩ་རེ་རེ་འཕར་ཡུན་དང་སེ་གོལ་རན་པར་གཏོགས་པ་དུས་མཉམ་པར་བྱས་ཏེ།",
    "དེའི་ཡུན་ལ་ཤ་མང་གི་འདབ་མ་དྲུག་ཅུ་ཐམ་པ་བརྩེགས་པ་ཁབ་ཀྱིས་ཕུག་པས་འདབ་མ་རེ་རེ་འབུག་པའི་ཡུན་ནི་དུས་མཐའི་སྐད་ཅིག་མའི་ཚད་དུ་ཤེས་པར་བྱ་སྟེ།",
    "འདབ་མ་རྣམས་རིམ་ཅན་དུ་འབུག་པ་ལས་ཅིག་ཆར་འབུག་མི་སྲིད་པས་རེ་རེ་འབུག་པའི་ཡུན་དེ་ལས་རྗེས་སུ་དཔགས་ནས་ཤེས་པ་ཡིན་ནོ།",
    "རེས་ད་ལྟ་རང་དུས་སུ་ཡོད་པ་ཁོ་ན་ད་ལྟ་བ།",
    "རེས་བསྐལ་པ་འདི་ཆགས་ནས་མ་སྟོང་གི་བར་ལ་ད་ལྟ་བར་བྱེད་ཅིང་།",
    "བསྐལ་པ་ལ་ཆགས་གནས་འཇིག་སྟོང་གི་བསྐལ་པ་བཞི་དང་།",
    "དཀར་ནག་གི་ཕྱོགས་ཀྱི་མཐར་དོན་ལ་ཉིན་ཞག་གི་ཚད་ཙ་",
    "དེ་དག་ལེགས་པར་མ་བརྩིས་ན་མཐར་དཀར་ནག་གི་ཕྱོགས་དང་།",
    "ཡང་ཉིན་མོ་དང་མཚན་མོ།",
    "ཟླ་བ་རེ་ལ་དཀར་ཕྱོགས་ནག་ཕྱོགས།",
    "ལྷོ་བྱང་གི་བགྲོད་པ་གཉིས་ལ་སོགས་པའི་རྣམ་བཞག་བྱེད་དོ།",
    "ཀུན་འབྱུང་གི་བདེན་པ་དང་།",
    "ལྷ་མིན་ནི་རི་རབ་ཀྱི་ཁོང་གསེང་དང་གསེར་གྱི་ས་གཞིར་ཐུག་གི་བར་དུ་གནས།",
    "འདོད་ལྷ་དྲུག་གི་སུམ་ཅུ་རྩ་གསུམ་པ་རྣམས་རི་རབ་ཀྱི་སྟེང་ན་གནས།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་སྟེང་གི་ནམ་མཁའ་ལ་སྟེང་ནས་སྟེང་དུ་འཐབ་བྲལ་སོགས་བཞི་དང་།",
    "དེ་དག་གི་སྟེང་ན་གྱེན་དུ་བརྩེགས་ཏེ་ཚངས་རིས་ནས་འོག་མིན་པའི་བར་དུ་གཟུགས་ཁམས་བཅུ་བདུན་གནས་སོ།",
    "དེ་དག་ལ་གླིང་གཡོག་གཉིས་རེ་སྟེ།",
    "དེའི་འོག་གི་བང་རིམ་ལ་ཡས་ནས་མར་རིམ་པ་ལྟར།",
    "གཟུགས་ཁམས་ནི་གཞན་སྤྲུལ་པའི་སྟེང་གི་ནམ་མཁའ་ལ།",
    "དེའི་སྟེང་ན་ཚངས་ཆེན་ཏེ་གསུམ་མོ།",
    "ཡོད་མིན་མེད་མིན་སྐྱེ་མཆེད་པ་ལ་སྲིད་པའི་རྩེ་མོའང་ཟེར་རོ།",
    "བདེ་སྡུག་གི་སྣང་བ་སོགས་ཅི་ལྟ་བུ་ཡིན་པའི་ཚུལ་ནི་གཞན་ལས་ཤེས་པར་བྱའོ།",
    "དེ་སྟོང་ལ་དང་པོ་སྤྱི་ཕུད་སྟོང་གི་འཇིག་རྟེན་ཞེས་བྱའོ།",
    "དེ་སྟོང་ལ་བར་མའི་སྟོང་གི་འཇིག་རྟེན་གྱི་ཁམས་དང་།",
    "དག་པའི་ཞིང་གི་སྣོད་བཅུད་རྣམས་ནི་མ་ཡིན་ཏེ།",
    "ཡི་དྭགས་ཕལ་མོ་ཆེ་རྫུས་སྐྱེས་དང་།",
    "དེ་ནས་འཆི་བ་མ་བྱུང་གི་བར་སྔོན་དུས་ཀྱི་སྲིད་པ་དང་།",
    "བདུན་རེའི་ནང་དུ་སྲང་མདའི་མཐོ་དམན་བཞིན་ཤི་ནས་ཡང་རེ་རེ་སྐྱེ་བར་གསུང་།",
    "དེའི་ཁ་དོག་ནི་ངན་སོང་དུ་སྐྱེ་ན་ཕྱར་བ་ནག་པོའམ་མུན་ནག་ལྟ་བུ་དང་།",
    "དེ་གང་གིས་མཐོང་ན་གང་དུ་སྐྱེ་བ་མཚུངས་པ་དེ་དག་ནང་ཕན་ཚུན་དུ་མཐོང་ལ་གཞན་བསྒོམས་པ་ལས་བྱུང་བའི་ལྷའི་མིག་རྨུགས་གཉིད་རྒོད་པ་ཐེ་ཚོམ་ཡིད་མི་བདེ་སོགས་སྐྱོན་བཅུ་གཅིག་དང་ཁྲལ་བས་མཐོང་ངོ།",
    "རེག་པའི་ཟས་དང་།",
    "ཁམ་གྱི་ཟས་ནི་དྲི་རོ་རེག་བྱ་གསུམ་གྱི་བདག་ཉིད་དེ།",
    "གསུམ་འདུས་པའི་སེམས་བྱུང་རེག་པ་དང་།",
    "རྟེན་སེམས་སེམས་བྱུང་རྒྱས་པ་རེག་པ།",
    "ལྷ་མི་ངན་སོང་གསུམ་ལ་ལམ་རྒྱུད་ལྔ་ཞེས་བྱའོ།",
    "ངན་སོང་གསུམ་དང་འདུ་ཤེས་མེད་པའི་ལྷ་སྟེ་མི་མ་ཡིན་པའི་མི་ཁོམས་པའི་གནས་བཞི།",
    "ཉོན་མོངས་ཤིན་ཏུ་དྲག་པོ་རྒྱུན་ཆགས་པས་ལམ་ལ་འཇུག་ཙ་",
    "མི་ནུས་པ་ཉོན་མོངས་པའི་སྒྲིབ་པའོ།",
    "དེ་དག་གི་འབྲས་བུ་གནས་སྐབས་སུ་འདོད་པ་ལ་ལོངས་སྤྱོད་པ།",
    "དེ་དག་གི་ལྡོག་ཕྱོགས་བཞི་མི་འདོད་པའོ།",
    "ལོངས་སྤྱོད་རྒུད་པ་དུས་ཀྱི་སྙིགས་མ་འབྲུ་རྣམས་རོ་ནུས་ཆུང་ཞིང་མི་སྨིན་པ་སོགས་སོ་ ཁྱིམ་པའི་དགེ་ཕྱོགས་རྒུད་བྱེད་ཉོན་མོངས་པའི་སྙིགས་མ།",
    "རབ་བྱུང་གི་དགེ་ཕྱོགས་རྒུད་པ་ལྟ་བའི་སྙིགས་མ།",
    "འདི་དག་སྡུག་བསྔལ་གསུམ་དང་འབྲེལ་ཞིང་དེ་དག་གི་རྟེན་དུ་གྱུར་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་འཕགས་པ་རྣམས་ཀྱིས་གཟིགས་ངོར་ཟག་བཅས་རྣམས་སྡུག་བསྔལ་བ་ཉིད་དུ་བདེན་པའོ།",
    "ལས་ཉོན་གྱི་རྒྱུ་ལས་བྱུང་བའི་ཆ་ནས་ཀུན་འབྱུང་གི་བདེན་པ་ཞེས་སུ་རྣམ་པར་བཞག་གོ།",
    "གནས་རྣམས་ནི་སྣང་འགྱུར་ཐུན་མོང་བའི་ལས་དང་།",
    "སོ་སོའི་ལུས་དང་བདེ་སྡུག་ནི་མྱོང་འགྱུར་ཐུན་མོང་མིན་པའི་ལས་ཀྱིས་བསྐྱེད་པའོ།",
    "ལས་དེ་དག་སེམས་ཀྱིས་བསམ་ཞིང་ལུས་ངག་གིས་འཇུག་པའི་ཕྱིར་སེམས་པ་ཡིད་ཀྱི་ལས་དང་།",
    "དེས་བསྐྱེད་པ་ལུས་ངག་གི་ལས་གཉིས་སུ་ཡང་དབྱེའོ།",
    "རྣམ་པར་རིག་བྱེད་ཀྱི་ལས་ནི་ལུས་ངག་གི་ལས་རིག་བྱེད་དེ།",
    "བར་མའི་སྡོམ་སྡོམ་མིན་གསུམ་གང་རུང་གིས་བསྡུས་པ་སྟེ།",
    "བྱ་བ་དངོས་སུ་མེད་ཀྱང་ཟིན་འབྱུང་གི་རྒྱུས་བྱུང་བའི་གཟུགས་རྒྱུན་ཆགས་སུ་ཡོད་པའོ།",
    "སྡོམ་མིན་ནི་ཤན་པ་སོགས་སྡིག་བྱེད་ཀྱི་རིགས་སུ་སྐྱེས་ཤིང་རང་གིས་ཀྱང་ལས་འདིས་བདག་ཇི་སྲིད་འཚོ་བར་བྱའོ།",
    "ཚངས་ཆེན་ནི་ཕྱིན་ཅི་ལོག་གི་ལྟ་བ་ཅན་ཏེ་ཐམས་ཅད་བདག་གིས་བྱས་སོ་སྙམ་དུ་སེམས་པས་འཕགས་པ་དག་དེར་མི་སྐྱེ་བས་ཟག་མེད་ཀྱི་སྡོམ་པ་སྐྱེ་བ་མེད་ཅེས་བྱེ་སྨྲས་འདོད།",
    "བསམ་གཏན་གྱི་སྡོམ་པ་ནི་སྙོམས་འཇུག་ལས་ཉམས་པ་དག་གིས་གཏོང་ལ།",
    "ས་འཕོས་པ་ལས་རང་སའི་བསྡུས་པ་ཐོབ་ཅིང་ས་གཞན་གྱི་བསྡུས་པ་གཏོང་བ་ཙམ་མོ།",
    "ཐེག་དམན་གྱི་འབྲས་བུ་ཐོབ་པ་ལས་རེ་ཤིག་ཉམས་པ་ལས་གཏོང་ཡང་དེ་ནི་རྩལ་པོ་ཆེ་ལྡོག་འདྲེད་པ་ལྟར་མྱུར་དུ་སོར་ཆུད་པར་འགྱུར་རོ་ཞེས་བཤད།",
    "ཉམས་པ་འདི་ནི་དམན་ལམ་གྱི་འབྲས་བུ་ལས་གནས་སྐབས་ཉམས་ཚུལ་ཙམ་མོ།",
    "ཉོན་མོངས་མེད་པའི་ཏིང་ངེ་འཛིན་དང་།",
    "བྱས་ལ་མ་བསགས་པའི་ལས་ནི་གོང་གི་དྲུག་མ་ཚང་པས་ལས་བྱས་ཀྱང་འབྲས་བུ་ཇི་ལྟ་བ་བཞིན་སྨིན་པར་མ་ངེས་པའོ།",
    "འདི་དག་ལ་འཕེན་བྱེད་གཅིག་གིས་སྐྱེ་བ་དུ་མ་འཕེན་པ་ཡང་ཡོད།",
    "ལས་གཅིག་གིས་སྐྱེ་བ་གཅིག་འཕེན་པ་ཡང་ཡོད།",
    "གང་རུང་རེ་བྱེད་པའི་ལས་ཀྱང་ཡོད་པར་ཤེས་པར་བྱའོ།",
    "དཀར་གནག་གི་ལས་དེ་དག་ཟད་པར་བྱེད་པ་ཟག་མེད་ཀྱི་ལས་ནི་མི་དཀར་མི་གནག་པའོ།",
    "དེ་གསུམ་ལས་གཞན་པའི་རྩ་བའི་ཉོན་མོངས་པ་དང་ཉེ་ཉོན་རྣམས་ཉེས་ཙ་",
    "ཉོན་མོངས་པ་ལ་མི་བསྒྲིབ་པ་མི་སྲིད་དོ།",
    "དེས་བསླང་བས་ལུས་ངག་གི་ལས་ནི་བསླང་བའི་ལུང་མ་བསྟན་ནོ།",
    "སོ་སོར་བརྟག་པ་དང་ཉོན་མོངས་ཅན་གང་ཡང་མིན་པའི་སེམས་ཀྱིས་ལོངས་སྤྱོད་རྣམས་སྤྱད་པའོ།",
    "གཟུགས་གཟུགས་མེད་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་རྣམས་ཏེ་ཞི་གནས་དང་ལྡན་པའི་ཕྱིར་འབྲས་བུ་མི་འབྱིན་པའོ།",
    "མ་བསྟན་པ་དང་ཚོར་བ་བདེ་སྡུག་གང་དུའང་ལུང་མ་བསྟན་པ་དང་།",
    "ཡང་དགེ་མི་དགེའི་ལས་ཀྱི་བྱེ་བྲག་གི་རྣམ་གྲངས་ལ།",
    "སྨིན་པར་ངེས་པའི་ལས་ནི་ཆུད་མི་ཟ་བའི་ཕྱིར་བཟོད་པ་ཐོབ་པ་ལ་ངན་སོང་དུ་སྐྱེ་འགྱུར་གྱི་ལས་དང་།",
    "ཕ་རོལ་གྱི་བདོག་པ་ལ་རང་གིར་འདོད་པའོ།",
    "གནོད་སེམས་ནི་ཞེ་སྡང་གི་རྩ་བ་ཅན་ཕ་རོལ་སྟག་བསྔལ་བར་འདོད་པའོ།",
    "གཞན་གྱི་བུད་མེད་སོགས་བསྒྲོད་བྱ་མིན་པ་ལ་འདོད་པས་ལོག་པར་གཡེམ་པ་གསུམ་ནི་ལུས་ཀྱི་ལས་སོ།",
    "དེ་གསུམ་མིན་པའི་ཚིག་གང་ཞིག་ཉོན་མོངས་པས་ཀུན་ནས་བསླང་ཏེ་བརྗོད་པ་ངག་ཀྱལ་བ་བཞི་ནི་ངག་གི་ལས་སོ།",
    "སྲོག་གཅོད་སོགས་དེ་དག་དུག་གསུམ་གང་རུང་གིས་ཀུན་ནས་བསླང་ཏེ་འབྱུང་ལ།",
    "གསོད་པ་གནོད་སེམས་ཚིག་རྩུབ་རྣམས་ཞེ་སྡང་གིས་རྫོགས་པར་བྱེད།",
    "དགེ་མི་དགེ་གང་ཡང་རང་གིས་བགྱིས་པ་དང་།",
    "ཉོན་མོངས་པའི་སེམས་ཀྱིས་གླུ་ལེན་པ་སོགས་ཀྱལ་པ་དངོས་སུ་ཡོད།",
    "བདག་པོའི་འབྲས་བུ་སྐྱེ་བའི་ཡུལ་སྲོག་ལ་འཚེ་བ་ཅན་དུ་སྐྱེ་བར་བྱེད་པ་སོགས་བཞི་རེ་འབྱིན་པར་འགྱུར་རོ།",
    "སྲོག་གཅོད་པ་སོགས་སྤང་བ་དེ་ཡང་དངོས་དང་དེ་ཡི་ཕྱོགས་མཐུན་ཕྲ་མོའི་བར་དུ་སྤངས་ཏེ་ཡོངས་སུ་དག་པ་ལས།",
    "མ་ཡང་ཡིན་ལ་དགྲ་བཅོམ་མ་ཡིན་པ་འདོད་ལོག་གིས་སུན་ཕྱུང་བ་བྱང་སེམས་ངེས་གནས་གསོད་པ།",
    "མཐར་ཡང་སྲེད་སོགས་ཉོན་མོངས་པས་གསོས་མ་བཏབ་ན་སྐྱེ་བའི་འབྲས་བུ་མི་འབྱིན་པས་ཉོན་མོངས་པ་ནི་ཀླུ་གང་དུ་གནས་པར་ཆུ་ཡོད་པ་དང་།",
    "ཉོན་མོངས་དེ་དག་སྐྱེ་བའི་རྒྱུ་ནི།",
    "ཉོན་མོངས་པའི་བག་ལ་ཉལ་མ་སྤངས་པ་དང་།",
    "ཉོན་མོངས་སྐྱེ་པའི་ཡུལ་ཉེ་བར་གནས་པ་དང་།",
    "ཉོན་མོངས་དེའི་བྱེད་ལས་སེམས་ཀྱི་རྒྱུད་རབ་ཏུ་མ་ཞི་བར་བྱེད་པའོ།",
    "ཉོན་མོངས་དེ་དག་དམིགས་པ་དང་མཚུངས་ལྡན་གང་རུང་གི་སྒོ་ནས་ཕན་ཚུན་འཕྲོད་ཅིང་གནས་ཐོབ་ལ།",
    "ལམ་མངོན་དུ་གྱུར་པ་ན་མ་རིག་པ་དང་ཐེ་ཚོམ་སོགས་ཉོན་མོངས་རྣམས་སྤོང་བར་བྱེད་ཀྱི་རྒྱས་པར་མི་བྱེད་ལ།",
    "ཉོན་མོངས་སྤོང་བྱེད་དག་པ་ཡིན་པས་ལྟ་བ་མཆོག་འཛིན་སོགས་ལྟ་བ་གཞན་བཅས་དང་།",
    "འདུས་མ་བྱས་ནི་བདེ་སྡུག་གི་རྟེན་དུ་མི་རུང་བས་དེ་ལ་ཉོན་མོངས་མི་རྒྱས་སོ།",
    "ཀུན་འགྲོ་མ་ཡིན་པ་རྣམས་ནི་རང་གི་རིས་སུ་གྱུར་པའི་ཡུལ་ལ་རྒྱས་ཀྱི་ཐམས་ཅད་དུ་མིན་ནོ།"
  ]
}