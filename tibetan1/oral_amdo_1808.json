    "དགའ་འདུན་རེ་ལྟོས།",
    "རང་རེའི་རྒྱལ་ཁབ་འདིར་སྤྱི་ལོ་ནས་ལོའི་བར་ལ་སྐད་ཆའི་ཞབས་ཞུའི་ཁེ་ལས་ཀྱི་སྤྱི་གྲངས་ནས་ལ་འཕར་ཅིང་།",
    "སྐད་ཆ་རེ་རེ་བ་ནི་རྒྱུ་ནོར་གྱི་ཐོན་ཁུངས་ཤིག་ཏུ་གཟུང་ཆོག་ལ།",
    "ཐོན་རྫས་གསར་པའི་འཛད་མེད་ཀྱི་ཐོན་ཁུངས་ཤིག་ཡིན་པའང་གསལ་བར་བསྟན་འདུག་པ་རེད་དོ།",
    "རང་གི་རིན་ཆེན་མཆོག་བཟང་།",
    "བཀོལ་སྤྱོད་ལུགས་མཐུན་བྱ་དགོས་པའི་རེ་སྐུལ་གནང་གིན་ཡོད་པ་འདི་ལགས་ན།",
    "མི་རིགས་ཤིག་དང་ཁྱེའུ་ཞིག་གི་སྐད་ཆའི་འཕེལ་རིམ་གྱི་ཆ་ན་འདྲ་ས་ཨེ་ཡོད།",
    "མི་ཞིག་གིས་ཐོལ་བྱུང་དུ་བཏོན་པའི་སྒྲ་གང་ཞིག་ཀུན་ལ་གོམས་པར་འགྱུར་བ་ལ་ཆ་རྐྱེན་གང་དག་ཚང་དགོས།",
    "མིང་གི་འགྱུར་བས་སྐད་ཆ་ལ་ཤུགས་རྐྱེན་ཇི་འདྲ་ཞིག་ཐེབས་ཀྱིན་ཡོད།",
    "མིང་དེ་རིགས་དང་སྐད་ཆ་རང་ཐད་ཀྱི་མིང་དག་གི་བར་ན་ཁྱད་པར་ག་འདྲ་ཡོད།",
    "མི་རིགས་ཤིག་གི་སྐད་ཆ་ཉམས་པའམ་རང་སྐད་དོར་ཏེ་གཞན་སྐད་སྤྱད་ཚེ།",
    "མི་ལ་སྐད་ཆ་ནི་མི་རིགས་ཤིག་ལ་ཐུན་མོང་དུ་གྲུབ་པ་ཡིན་པར་སྨྲས་ན།",
    "སྤྱིར་ཕོ་མོའི་དབྱེ་བ་ཆེ་ཁག་གཉིས་ཡོད་པས།",
    "སྐད་ཆའི་བརྗོད་སྟངས་ལའང་ཕོ་མོའི་ཁྱད་པར་ཡོད་དམ།",
    "དེ་གཙོ་བོ་ཕྱོགས་གང་དག་གི་ཆ་ན་མངོན་གྱིན་ཡོད།",
    "དེ་དག་གི་བར་ན་འབྲེལ་བ་ཅི་ཡོད།",
    "སྐད་ཆ་རིག་པའི་མིང་གི་འདོགས་སྟངས་ལ་བཞེད་ལུགས་འགའ་རེ་མཆིས་པ་ལ་ཇི་ལྟར་དཔྱད་ན་ལེགས།",
    "སྐད་ཆ་རིག་པས་རིག་པའི་གནས་གཞན་དག་གི་གྲས་སུ་གོ་གནས་ག་འདྲ་ཞིག་བཟུང་ཡོད།",
    "དེ་བོད་ལའང་དར་སྔ་བ་རྒྱུ་རྐྱེན་གང་ལ་ཐུག་པ་རེད།",
    "དེ་དང་སྐད་ཆའི་བར་གྱི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "ཅི་ཞིག་ལ་སྒྲ་དོག་འཇུག་གི་ཡི་གེ་ཟེར་བ་དང་།",
    "དེ་དང་སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་དག་གི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "ཡི་གེ་རྣལ་མའི་འབྱུང་རྐྱེན་གཙོ་བོ་གང་དག་རེད།",
    "ཡི་གེ་དག་གི་འབྱུང་ཁུངས་ཇི་འདྲ་རེད།",
    "ཡི་གེ་ཞིག་སྐད་ཆ་གང་རུང་ཞིག་གི་མཚོན་རྟགས་སུ་འགྱུར་བ་ལ་ཆ་རྐྱེན་གང་དག་ཚང་དགོས།",
    "ད་ལྟར་ཤེས་པའི་འཛམ་གླིང་གི་ཡི་གེ་ཆེས་སྔ་ཤོས་ནི་གང་རེད།",
    "དེའི་ད་ལྟའི་གནས་སྟངས་ག་འདྲ་རེད།",
    "རྒྱ་ཡིག་གི་བཟོ་ལུགས་ལ་ཇི་ལྟར་དཔྱད།",
    "གནའ་བོའི་བྲིས་རིས་དང་ཡི་གེ་དངོས་ཀྱི་ཁྱད་པར་དང་འབྲེལ་བ་གཙོ་བོ་ཕྱོགས་གང་དུ་ཡོད་པ་རེད།",
    "དེ་གསུམ་གའི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "ཞང་ཞུང་ཡི་གེ་ཞེས་པ་ཞིག་ཡོད་མེད་ཀྱི་ཐད་བཞེད་པ་མི་མཐུན་པ་གང་དག་ཡོད་པ་རེད།",
    "དེ་དག་གི་སྦྱོར་བ་སྤེལ་སྟངས་ཇི་འདྲ་རེད།",
    "དེ་ནུབ་པར་གྱུར་པའི་རྒྱུ་རྐྱེན་གཙོ་བོ་ཅི་རེད།",
    "ཐོན་མི་མཆོག་གིས་གསར་དུ་བསྣན་པའི་ཡི་གེ་གང་དག་ཡིན་པའི་ཐད་བཞེད་ཚུལ་ཇི་འདྲ་ཡོད་པ་རེད།",
    "གཙོ་བོ་ཕྱོགས་གང་དུ་འདུ་བ་རེད།",
    "དཀར་ཆག་བོད་ཡིག་དབྱངས་གསལ་གྱི་ཡི་གེ་ལ་ཕོ་མོ་མ་ནིང་གི་རྟགས་ཀྱི་དབྱེ་བ་འབྱེད་པའི་དགོས་པ་ཅི་རེད།",
    "དེ་དག་གི་འབྲེལ་བ་དང་ཁྱད་པར་ཅི་རེད།",
    "མིང་གཞིའི་མོ་ཡིག་དག་གི་སྒྲུབ་བྱེད་ཅི་ཡིན་པ་དང་།",
    "སློབ་དཔོན་ཐོན་མི་མཆོག་གིས་གསར་དུ་མཛད་པའི་ཡི་གེའི་བྲིས་རྒྱུན་ལ་འཕེལ་རྒྱས་གང་དང་ཅི་བྱུང་བ་རེད།",
    "དེ་དག་གི་འབྱུང་རྐྱེན་གཙོ་བོ་ཅི་རེད།",
    "བོད་ཡིག་ཏུ་སྤྱོད་པའི་སྔགས་ཡིག་ཅེས་པ་ནི་ཇི་འདྲ་ཞིག་རེད།",
    "དེ་དང་བོད་ཡིག་གི་ཁྱད་པར་ཇི་ལྟར་འབྱེད།",
    "དེས་ན་སྲུང་འཁོར་གྱི་སྟེང་ལ་བྲི་བའི་རི་མོ་དེ་རིགས་ལ་བསྟན་དོན་གསལ་པོ་ཞིག་ཨེ་ཡོད།",
    "སྐད་ཆ་དང་བརྡ་སྤྲོད་རིག་པའི་བར་གྱི་འབྲེལ་བ་ཅི་རེད།",
    "བརྡ་སྤྲོད་རིག་པའི་གནའ་དེང་གི་བསྟན་བྱ་ལ་ཁྱད་པར་ཨེ་ཡོད།",
    "སྐད་ཆ་རིག་པ་དང་བརྡ་སྤྲོད་རིག་པ་གཉིས་ཀྱི་འབྲེལ་བ་དང་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "དེ་དག་བར་གྱི་འབྲེལ་བ་ཇི་འདྲ་ད་བརྡ་སྤྲོད་ཅེས་པ་ནི་རྩིས་འཁོར་གྱི་མཐེབ་གཞོང་དང་འདྲ་ཟེར་བའི་དོན་ཅི་རེད།",
    "བརྡ་སྤྲོད་བསླབ་པའི་དགོས་པ་ཅི་རེད།",
    "ངག་སྦྱོར་ལའང་དེ་བཞིན་ཡོད་པ་ཨེ་རེད།",
    "དེ་དག་ལས་བོད་ལ་དར་མྱོང་བ་གང་དག་རེད།",
    "སྐྱེད་སྒྲུབ་འཕེལ་འགྱུར་བརྡ་སྤྲོད་རིག་པའི་སྲོལ་གཏོད་པ་པོ་སུ་རེད།",
    "ས་གཞན་གྱི་ཚིག་གི་གྲུབ་ཆའི་དབྱེ་བ་དྲུག་པོ་དེ་དག་བོད་སྐད་ལ་སྦྱར་ཨེ་རུང་།",
    "སྐད་རིགས་སོ་སོའི་ཚིག་གི་གོ་དོན་འཇོག་ལུགས་ཨེ་འདྲ།",
    "ཚིག་གི་གྲུབ་ཆ་གཙོ་བོ་མིང་གང་དག་གིས་བྱེད་པ་ཡིན།",
    "དེ་དག་གི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "བརྡ་སྤྲོད་དང་སྐད་ཆའི་གནས་སྐབས་ཀྱི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "མིང་གི་བཏགས་ཚུལ་ལ་རིགས་གང་དག་ཡོད།",
    "གཞན་སྐད་སོར་བཞག་གིས་བཏགས་པའི་ཐབས་ལ་ནང་གསེས་རིགས་གང་དག་ཡོད།",
    "མིང་ཚིག་དང་བྱ་ཚིག་གི་དབྱེ་བ་ནི་ཇི་ལྟར་བྱུང་བ་ཡིན།",
    "མིང་གི་བརྡ་སྤྲོད་ཀྱི་དབྱེ་བ་ལ་ནང་གསེས་རིགས་གང་དག་ཡོད།",
    "བྱ་བ་བརྗོད་པའི་མིང་རྣམས་ཚིག་གི་སྦྱོར་བ་རུ་ཞུགས་ཚེ་ནུས་པ་གང་དག་ཡོད།",
    "བྱ་བ་བརྗོད་པའི་མིང་རིགས་གཉིས་ཀྱི་གྲུབ་ཚུལ་ལ་རྟེན་འབྱུང་གི་འབྲེལ་བ་གང་དག་ཡོད།",
    "ཁྱད་གཞི་དང་གྲངས་ཀ་བརྗོད་པའི་མིང་གི་སྦྱོར་སྲོལ་ལ་ངེས་གཏན་ག་འདྲ་ཡོད།",
    "ཅི་ཞིག་ལ་ངེས་བཟུང་གི་མིང་ཟེར།",
    "མིང་གི་སྒྲུབ་ཚུལ་ལ་སྒྲུབ་ལུགས་གཙོ་བོ་གང་དག་ཡོད།",
    "དག་ཡིག་གི་བསྟན་བྱ་གཙོ་བོ་ཅི་ཞིག་ཡིན།",
    "ཅི་ཞིག་ལ་མིང་གི་འཕེལ་ཚུལ་ཟེར་ཞིང་དེར་འཕེལ་ལུགས་གཙོ་ཆེ་བ་གང་དག་ཡོད།",
    "ཅི་ཞིག་ལ་མིང་གི་བསྟན་དོན་ཟེར།",
    "ཅི་ཞིག་ལ་མིང་གི་སྤྱིར་བཏང་གི་བསྟན་དོན་ཟེར།",
    "ཅི་ཞིག་ལ་མིང་གི་གནས་སྐབས་ཀྱི་བསྟན་དོན་ཟེར།",
    "ཅི་ཞིག་ལ་མིང་གི་ངོ་བོ་འགྱུར་བ་ཟེར།",
    "ཅི་ཞིག་ལ་མིང་གི་ཚོགས་པ་ཟེར།",
    "མིང་གི་ཚོགས་པ་སྒྲུབ་བྱེད་ཀྱི་རྐྱེན་གང་དག་ཡོད།",
    "བོད་སྐད་ཀྱི་མིང་གི་བཏགས་ཚུལ་ལ་རིགས་གང་དག་ཡོད།",
    "གཞན་སྐད་སོར་བཞག་གི་མིང་གི་བཏགས་ཐབས་ཐུན་མོང་པ་གསུམ་དང་།",
    "ཁྱད་པར་བ་གཉིས་ཟེར་བ་ནི་གང་དག་རེད།",
    "དེ་དག་གི་ཁྱད་པར་ཇི་ལྟར་འབྱེད་པ་རེད།",
    "མིང་ཚིག་དང་ཁྱད་གཞི་བརྗོད་པའི་མིང་གཉིས་ནི་དོན་གཅིག་ཨེ་རེད།",
    "དེའི་ནུས་པ་གཙོ་བོ་ཅི་རེད།",
    "ཚིག་དག་གི་མཐར་ཡིན་རེད་མིན་ཡོད་འདུག་ཅེས་པ་སོགས་སྦྱར་མ་སྦྱར་པའི་བསྟན་དོན་ལ་ཁྱད་པར་ཨེ་ཡོད།",
    "འཇལ་བྱེད་ཀྱི་མིང་དང་ཁྱད་གཞི་བརྗོད་པའི་མིང་གི་ཁྱད་པར་ཇི་ལྟར་འབྱེད་པ་ཡིན།",
    "མིང་གི་གྲུབ་ཚུལ་དང་འཕེལ་ཚུལ་གཉིས་ཀྱི་ཁྱད་པར་ཇི་ལྟར་འབྱེད་པ་རེད།",
    "མིང་གི་ཆ་ཤས་དང་མིང་མཐའ་གཉིས་ལ་ཁྱད་པར་ཨེ་ཡོད།",
    "ཚིག་རྒྱན་གྱི་ནུས་པ་ཤིན་ཏུ་ཆེ་བའི་མིང་གི་རིགས་ནི་གང་དག་རེད།",
    "མིང་འདུས་མ་དང་མིང་གི་ཚོགས་པ་གཉིས་ཀྱི་ཁྱད་པར་ཇི་ལྟར་འབྱེད་པ་ཡིན།",
    "མིང་གི་ཚོགས་པ་ལ་ནུས་པ་གཙོ་བོ་ཅི་ཡོད།",
    "བོད་སྔ་རབས་ཀྱི་ཚིག་གི་འཇོག་ལུགས་ལ་བཞེད་ལུགས་ག་འདྲ་ཡོད།",
    "ཚིག་ལ་ཀུན་སློང་གི་སྒོ་ནས་དབྱེ་ན་དབྱེ་བ་གང་དག་ཡོད།",
    "མིང་གིས་ཚིག་སྒྲུབ་པ་ལ་གཙོ་ཕལ་གྱི་ཁྱད་པར་ཇི་འདྲ་ཡོད།",
    "མིང་གི་བསྡུ་ཚུལ་ལ་ཐབས་གཙོ་བོ་གང་དག་ཡོད།",
    "མིང་གི་ཚོགས་པའི་བསྡུ་ཚུལ་ལ་རིགས་གང་དག་ཡོད།",
    "དཀར་ཆག་ཚིག་གི་ངེས་ཚིག་ཇི་འདྲ་ལ་བྱེད་པ་དང་།",
    "ཚིག་སྦྱོར་གཅིག་གི་ནང་དུ་ཚིག་ཕྲད་མང་ཉུང་ག་འདྲ་འདུག་པ་ཡིས་ཚིག་དེའི་སྐྱེད་སྒྲུབ་ལ་ནུས་པ་ཇི་འདྲ་འཐོན་པ་རེད།",
    "ཚིག་གི་བརྗོད་དོན་གྱི་དབྱེ་བ་དང་རྣམ་དབྱེའི་ཚིག་ཕྲད་ཀྱི་བར་ན་འབྲེལ་བ་ཇི་འདྲ་ཡོད།",
    "ཚིག་གི་སྦྱོར་བ་ཞིག་ཇེ་རིང་དུ་སྐྱེད་པ་ལ་ཐབས་གཙོ་བོ་གང་དག་ཡོད།",
    "དེ་དག་གི་བར་ན་འབྲེལ་བ་ཅི་ཡོད།",
    "ཚིག་གི་བསྡུ་ཚུལ་ལ་རིགས་གཙོ་བོ་གང་དག་ཡོད།",
    "ཚིག་གི་རྣམ་ཆ་ལ་དབྱེ་བ་གང་དག་ཡོད།",
    "མིང་ནི་ཚིག་གི་འགྲུབ་རྒྱུ་གཙོ་བོ་ཡིན་ན།",
    "ཚིག་གི་དོན་ནི་མིང་འདུས་མའི་བསྟན་བྱ་དེ་ཁོ་ན་ཨེ་རེད།",
    "ཅི་ཞིག་ལ་ཚིག་གི་གནས་འགྱུར་ཞེས་བྱ་ཞིང་དེ་ལ་རྣམ་གྲངས་གང་དག་ཡོད།",
    "སྐད་ཆ་གང་ཡིན་ཡང་ཚིག་རེ་རེ་བ་ནས་སྦྲགས་མ་ཅན་དུ་ཅིས་ཀྱང་འཕེལ་དགོས་པ་ཡིན་ནམ།",
    "ཚིག་གི་ཀུན་སློང་གི་དབྱེ་བ་དང་བརྗོད་དོན་གྱི་དབྱེ་བ་གཉིས་ཀྱི་འབྲེལ་བ་དང་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "དེ་དང་ཚིག་སྦྲགས་མ་གཉིས་ཀྱི་ཁྱད་པར་ཅི་རེད།",
    "ཚིག་རྐྱང་པ་དང་ཚིག་ཚན་གཉིས་ཀྱི་འབྲེལ་བ་དང་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "ཚིག་ཅིག་གི་ནང་དུ་ཁྱད་གཞི་བརྗོད་པའི་མིང་ངམ་ངེས་བཟུང་གི་མིང་དུ་མ་བྱུང་ན་དེ་དག་གི་ནུས་པ་ག་འདྲ་རེད།",
    "ཅི་ཞིག་ལ་ཚིག་གི་རྣམ་ཆ་ཟེར་བ་དང་།",
    "དེ་དག་བར་གྱི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "མིང་གིས་ཚིག་བཟོ་སྐབས་མིང་གི་བཀོལ་སྤྱོད་ལ་གདམ་སྒྲུག་གི་ཁྱད་པར་ཨེ་ཡོད།",
    "ཅི་ཞིག་ལ་མངོན་བྱུང་གི་ཚིག་དང་བག་ཉལ་གྱི་ཚིག་ཟེར།",
    "དེ་གཉིས་ཀྱི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "ཅི་ཞིག་ལ་ཚིག་གི་མངོན་མཐའ་དང་སྦས་མཐའ་ཟེར།",
    "དེ་དག་གི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "བག་ཉལ་གྱི་ཚིག་དང་ཚིག་རྒྱན་གྱི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "ཅི་ཞིག་ལ་ཚིག་གི་གནས་འགྱུར་ཟེར་བ་དང་།",
    "དེ་དང་ཚིག་གི་སྐྱེད་སྒྲུབ་ཀྱི་འབྲེལ་བ་དང་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "འབྲེལ་སྒྲའི་ཚིག་ཕྲད་ཀྱིས་ཚིག་གི་གྲུབ་ཆ་དང་བསྟན་དོན་ལ་བྱེད་ནུས་ཇི་འདྲ་ཞིག་འཐོན་གྱིན་ཡོད།",
    "ཡོད་ན་བརྡ་སྤྲོད་ཀྱི་གཞུང་དུ་ཅིའི་ཕྱིར་མ་བསྟན་པ་རེད།",
    "བོད་སྐད་ལ་གོ་རེ་ངས་ཟ་ལྟ་བུར་བྱ་ཡུལ་སྔོན་ལ་སློག་ཚེ།",
    "ཅི་ཞིག་ལ་ཚིག་གི་སྒྲ་འགྱུར་དང་གདངས་འགྱུར་ཟེར་བ་དང་།",
    "དེ་དག་གི་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "ཚིག་གི་བརྗོད་གཞི་དང་བྱེད་པ་པོ་གཉིས་ཀྱི་འབྲེལ་བ་དང་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "མིང་ཕལ་བ་དང་མངོན་བརྗོད་ཀྱི་མིང་གི་ཁྱད་པར་གཙོ་བོ་ཕྱོགས་གང་དག་ཏུ་འདུ་བ་རེད།",
    "བོད་སྐད་ཀྱི་ཚིག་གི་གཅོད་མཚམས་ལ་རྟགས་མཚན་གསལ་པོ་ཞིག་ཨེ་ཡོད།",
    "ཐོན་མིས་རྒྱ་གར་དུ་ལོ་ག་ཚོད་ལ་སྦྱངས་པ་བྱས་པ་རེད།",
    "སློབ་དཔོན་ཐོན་མིས་བརྡ་སྤྲོད་པའི་བསྟན་བཅོས་བརྒྱད་བརྩམས་པ་གང་གིས་ཤེས།",
    "སུམ་ཅུ་པའི་བསྟན་བཅོས་འདི་ནི་དུས་རབས་གང་གི་ནང་ལ་བྱུང་བ་ཡིན།",
    "གཞུང་འདིའི་བྱེད་པོས་འགྱུར་ཕྱག་གི་དོད་མཛད་པ་ལ་ཚིག་འགྲོས་མི་མཐུན་པ་གང་དག་བྱུང་བ་དང་དེ་དག་ལ་ཇི་ལྟར་དཔྱད།",
    "གང་གིས་མིང་གཞི་སྔོན་གསུངས་པའི།",
    "ཞེས་པའི་མིང་གཉིས་ཀྱི་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "གང་གིས་སྒྲ་དབྱངས་ཀུན་གསུངས་པ།",
    "ཨ་ཡིག་ལ་ཡན་ལག་གི་དབྱེ་བ་གང་དག་ཡོད།",
    "དབྱངས་བཞི་དང་གསལ་བྱེད་སུམ་ཅུའི་གཟུགས་རིས་ནི་རང་རང་གི་སྒྲའི་འབྱིན་སྟངས་དང་མཚུངས་པར་བྱས་པ་ཨེ་ཡིན།",
    "བོད་ཡིག་གི་སྲོག་གི་ཡི་གེ་གང་དག་ཡིན།",
    "མིང་གཉིས་དག་གིས་རིགས་གཅིག་མཚོན།",
    "སུམ་ཅུ་པའི་གཞུང་དུ་མགོ་འདོགས་དང་ཡང་འཇུག་གི་སྦྱོར་བ་མ་བསྟན་པ་ལ་ཇི་ལྟར་དཔྱད་དགོས།",
    "སྤྱིར་བརྡ་སྤྲོད་རིག་པའི་བསྟན་བྱ་ནི་མིང་དང་ཚིག་གི་རྣམ་གཞག་ཡིན་ན།",
    "བོད་སྐད་ལ་ཁྱོན་བསྡོམས་པས་ཚིག་ཕྲད་གང་དག་དང་རྣམ་གྲངས་ཅི་ཙམ་ཡོད།",
    "དཀར་ཆག་ཚིག་ཕྲད་ཀྱི་མིང་འདོགས་དང་དེ་དག་གི་འཇུག་ཡུལ་གྱི་བར་ན་འབྲེལ་བ་གང་འདྲ་ཡོད།",
    "རྣམ་དབྱེའི་རྣམ་གྲངས་དང་ཚིག་གི་རྣམ་གྲངས་ཀྱི་བར་ན་འབྲེལ་བ་ཇི་འདྲ་ཡོད།",
    "རྣམ་དབྱེ་ཞེས་པའི་དོན་ཅི་རེད།",
    "རྣམ་དབྱེ་སོ་སོས་ཅི་ཞིག་རྣམ་པར་དབྱེ་བ་རེད།",
    "དེ་དག་གི་ཁྱད་པར་དང་འབྲེལ་བ་ཅི་རེད།",
    "སླར་བསྡུ་དང་ཟླ་སྡུད་དང་རྫོགས་ཚིག་ཅེས་པ་ནི་དོན་གཅིག་མིང་གི་རྣམ་གྲངས་ཁོ་ན་ཙམ་ཡིན་ནམ།",
    "དེ་དག་གི་མིང་གི་བཏགས་དོན་ལྟར་དོན་གྱི་སྦྱོར་ཚུལ་ལའང་ཁྱད་པར་ཡོད་པ་ཡིན་ནམ།",
    "གནས་བརྒྱད་ཆེན་མོ་རྩ་འགྲེལ་ལས་བསྟན་པའི་གནས་བརྒྱད་ནི་གང་དག་ཡིན།",
    "རྣམ་དབྱེའི་ཚིག་ཕྲད་ཀྱི་ནུས་པ་གཙོ་བོ་ནི་གང་དག་རེད།",
    "རྒྱ་ཡིག་སོགས་སུ་སྤྱོད་པའི་ཚིག་རྟགས་དང་བོད་སྐད་ཀྱི་ཚིག་ཕྲད་དག་གི་བར་ན་ལྟོས་མཚུངས་ཀྱི་འབྲེལ་བ་ཇི་འདྲ་ཡོད།",
    "ས་རུབ་ལ་ཉེ་དུས་སུ་ཕ་ཡུལ་ལ་སོང་ཞེས་པ་ཚེ་སྐབས་ཀྱི་དཔེར་བརྗོད་དུ་གཞག་ན་ཆོག་གམ།",
    "ཡིན་དང་རེད་གཉིས་ཀྱི་སྦྱོར་ཚུལ་ལ་ཁྱད་པར་ཇི་འདྲ་ཡོད།",
    "ལྷ་མོ་བྲོ་གར་འཁྲབ་དང་ལྷ་མོས་བྲོ་གར་འཁྲབ་ཅེས་པའི་གང་ཞིག་འགྲིགདེ་དང་ལྷ་མོ་རྩེད་རིགས་རྩེ།",
    "མིང་གཞི་ཡ་ཡིག་ལས་གྲུབ་པའི་ཚིག་ཕྲད་དག་གི་སྒྲའི་སྦྱོར་ཚུལ་ལ་ཁྱད་པར་ཨེ་ཡོད།",
    "ཚིག་གི་སྦྱོར་བ་གཅིག་གི་ནང་དུ་རྣམ་དབྱེའི་ཚིག་ཕྲད་དག་མཉམ་དུ་སྦྱར་ཨེ་རུང་།",
    "ངའི་རྟ་ལས་བློ་བཟང་གི་རྟ་འགྲོས་མགྱོགས་ཞེས་པ་དང་།",
    "རྟ་ཐམས་ཅད་ཀྱི་ནང་ནས་རྟ་རྐྱང་རྐྱང་དེ་གོམ་ལག་བདེ་ཞེས་པ་དག་ལ་ཁྱད་པར་ཅི་ཡོད་པ་རེད།",
    "གི་སོགས་དང་ཀྱང་འང་ཡང་གསུམ་མི་མཐུན་པའི་ཚིག་རྒྱན་ལ་འཇུག་ཚུལ་ཨེ་འདྲ།",
    "འབྲེལ་སྒྲ་ལ་ནང་གསེས་དབྱེ་བ་གང་དག་དབྱེ་རུང་བ་རེད།",
    "འབྲེལ་སྒྲའི་ནུས་པ་གཙོ་བོ་ཇི་འདྲ་རེད།",
    "གི་སོགས་བསྟན་བྱ་འགལ་བ་ལ་འཇུག་པ་དང་ཀྱང་སོགས་མི་མཐུན་པ་ལ་འཇུག་པའི་ཁྱད་པར་ཅི་རེད།",
    "ཤིང་བཟོས་སྟ་རེས་ཤིང་བཅད་དང་།",
    "ཤིང་བཟོའི་སྟ་རེས་ཤིང་བཅད་ཅེས་པ་གཉིས་ཀྱི་གང་ཞིག་ཡང་དག་པ་རེད།",
    "བོད་ཡིག་གི་དབྱངས་ཡིག་མཚོན་བྱེད་༦༨ བཞི་ལ་སོ་སོར་གུག་གུ།",
    "དཀར་ཆག་བྱེད་སྒྲ་དང་བྱེད་པ་པོ་གཞན་དང་འབྲེལ་བའི་ལས་ཚིག་གི་བར་ན་འབྲེལ་བ་ཇི་འདྲ་ཡོད།",
    "ཡོན་ཏན་གྱིས་གྲགས་ཞེས་པའི་སྐབས་ཀྱི་གིས་སོགས་ཀྱི་སྒྲ་ནི་བྱེད་སྒྲ་དངོས་ཡིན་ནམ།",
    "མཛེས་ཤིང་ལྟ་ན་སྡུག་དང་མཛེས་ཀྱང་མཛེས་ཞེས་པ་གཉིས་པོ་ཚིག་གི་རྒྱན་དུ་འགྲོའམ།",
    "སུམ་ཅུ་པའི་གཞུང་དུ་སྡུད་པའི་མིང་གིས་བཏགས་པའི་ཚིག་ཕྲད་འགའ་ཞིག་བསྟན་པ་ལ་འཇུག་བྱ་དོན་གྱི་ཐད་དུ་ཁྱད་པར་ཅི་དང་གང་དག་ཡོད།",
    "མ་ཁྱབ་ན་ཚིག་ཕྲད་དག་གི་སྦྱོར་ཚུལ་ལ་ཁྱད་པར་ཨེ་ཡོད།",
    "སུམ་ཅུ་པའི་གཞུང་དུ་བསྟན་པའི་ཚིག་ཕྲད་དག་གི་སྦྱོར་ཚུལ་ལ་ཞིབ་ཆ་འབྱེད་དགོས་སམ།",
    "འབྱེད་པ་དང་སྡུད་པ་ཞེས་པའི་ཁྱད་པར་གང་ནས་བྱུང་བ་རེད།",
    "བོད་པ་རྣམ་དབྱེ་དངོས་མིན་ཟེར་དོན་ཅི་རེད།",
    "བོད་པའི་རྣམ་དབྱེ་ངོས་འཛིན་གྱི་ཐད་ལ་འགྱུར་བ་ཅི་དང་གང་འབྱུང་གིན་ཡོད།",
    "ནི་སྒྲའི་འཇུག་ཡུལ་རེ་རེ་བཞིན་དཔེར་བརྗོད་ཀྱི་སྒོ་ནས་གསལ་བར་བྱེད་པར་མཁྱེན།",
    "ནི་སྒྲ་དགར་བ་དང་ནས་ལས་གཉིས་དགར་བ་ལ་འཇུག་པའི་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "ལུས་བོངས་ཆེ་བ་ནི་གླང་ཆེན་རེད་ཅེས་པ་གཉིས་ལས་གང་ཞིག་ནི་སྒྲ་དགར་བའི་དོན་དང་།",
    "གང་ཞིག་ནི་སྒྲ་ངེས་བཟུང་གི་དོན་ལ་འཇུག་པ་རེད།",
    "ད་ལྟ་ནི་འབྲོག་པའང་སྤྱང་པོ་རེད་ཅེས་པ་དང་།",
    "དང་སྒྲའི་འཇུག་ཡུལ་ནི་ཕལ་ཆེར་ཚིག་ཕྲད་གཞན་འགའ་ཞིག་གི་འཇུག་ཡུལ་དང་མཚུངས་པས།",
    "དེ་སྒྲ་ལྷག་བཅས་ལ་འཇུག་པ་དང་ལྷག་བཅས་ཀྱི་དེ་གཉིས་ཀྱི་ཁྱད་པར་ཅི་རེད།",
