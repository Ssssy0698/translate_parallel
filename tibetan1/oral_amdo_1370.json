    "ཤིང་ཡ་ཐལ་དཀར་པོ་འདི་བདག་གིས་བསྐྱེད་པ་ལགས།",
    "ཀླུའི་རྒྱལ་མོ་ལགས་པས་ན་ཀླུ་དགྱེས་པ་ལྟར་ཡང་བགྱི།",
    "ཀླུའི་རྒྱལ་མོ་མཉེས་པས་སླར་ཚངས་ཆེན་དེ་ཡང་མངའ་ཐང་ཆེ།",
    "ཀླུའི་རྒྱལ་མོ་དཔྱིད་ཀྱི་དྲོད་འབེབས་མ་དེས་ཀྱང་ཐུགས་ལ་དགོངས་ནས།",
    "ཀླུ་དྲོད་འབེབས་རྒྱལ་མོ་ཡང་མཉེས་སོ།",
    "ཀླུའི་རྒྱལ་མོ་དྲོད་འབེབས་མས་ཀྱང་རྒྱ་མཚོའི་གཏིང་ནས་མས་ཕབ་བོ།",
    "དེ་རྒྱ་མཚོའི་ཐིགས་པ་ནམ་མཁའ་ལ་སོང་བས་ནམ་མཁའ་ལ་སྤྲིན་དུ་ཆགས་པ་ཡིན།",
    "དེ་ནི་ཀླུའི་རྒྱལ་མོ་དྲོད་འབེབས་མས་བསྐྱེད་པ་ཡིན་ནོ།",
    "ཀླུ་མོ་དྲོད་འབེབས་རྒྱལ་མོའི་ལེའུ་སྟེ་ང་གཅིག་པའོ།",
    "ཡང་དབྱར་གྱི་རྒྱལ་མོའི་གཏན་ཚིགས་དང་།",
    "སྣ་ལམ་རེ་རེ་ལ་བདུད་རྩི་རེ་རེ་བྱུང་ངོ།",
    "ཀླུའི་རྒྱལ་མོ་ཀུན་ཏུ་དགའ་ཞེས་བྱ་བ་དང་།",
    "ཀླུའི་རྒྱལ་མོ་ཀུན་ཏུ་དགའ་བ་དང་།",
    "ཤིང་གི་རྩེ་མོ་ཡང་གཡོས་པ་ཡིན།",
    "རྩེ་མོ་ཁ་འབུས་པ་ཡིན།",
    "དེ་ཡང་ཀླུའི་ཁུ་བྱུག་གི་སྒྲ་ནི་ཡོངས་སུ་ཐོས་སོ།",
    "དེ་ཡང་ཀླུའི་རྒྱལ་མོ་ཀུན་ཏུ་དགའ་རབ་ཀྱི་སྤྲུལ་པའོ།",
    "ཡང་ཀླུའི་རྒྱལ་མོ་དགའ་རབ་ཀྱི་སྤྲུལ་པའོ།",
    "དེ་ནས་དབྱར་ཟླ་ཐ་ཆུང་གི་གྲལ་བཅུ་ནས་བཅོ་ལྔའི་བར་དུ་སྨིན་དྲུག་གི་ཆར་པ་ཞག་དྲུག་བྱུང་ངོ།",
    "ཤོལ་མེད་པར་བྱུང་ན་ཀླུའི་རྒྱལ་མོའི་ཟ་མ་བྱས་པས།",
    "ཀླུའི་རྒྱལ་མོ་གཟི་འབར་མ་བྱ་བ་ལགས་པས།",
    "རེ་ལུ་རེ་འུ་ཧེ་ལུ་ཀད་པ་སཱཧཱ།",
    "ཀླུའི་རྒྱལ་མོ་གཟི་འབར་མ་དེ་ནི།",
    "དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་སྦྲུལ་ཁྲ་མོ་ཞིག་ཏུ་བྱས་ནས་དཀྱིལ་འཁོར་ཡང་སུབ་པར་ལྡོག།",
    "ཡང་ཀླུའི་རྒྱལ་མོ་གཟི་འབར་མ་དེ་གསེར་གྱི་སྦལ་པ་ཞིག་ཏུ་བརྫུས་ནས།",
    "ཀླུའི་རྒྱལ་མོ་གཟི་འབར་མ་བསྔངས་ནས།",
    "དཀྱིལ་འཁོར་གྱི་འགྲམ་དུ་བུད་མེད་བཟང་ལ་འོད་ཆགས་པ་འོངས་ནས་སྟོན་པ་ལགས་ཁྲི་ལན་ཇི་ལྟར་དགོས་པ་བཀའ་སྩལ་འཚལ་ཞེས་ཞུས་པས།",
    "ཀླུའི་རྒྱལ་མོ་གཟི་འབར་མ་ཉོན་ཅིག།",
    "དེར་དབྱར་ཟླ་འབྲིང་པོ་དང་ཐ་མ་ལ་ཆར་པ་འོང་དུ་མི་སྟེར་བ་ཁྱོད་ཡིན་པས།",
    "ཀླུའི་རྒྱལ་མོ་གཟི་འབར་མས་ནི་སྟོན་པ་ལ་ཕྱག་གསུམ་བྱས་ནས་མཆིད་ཞུས་པས།",
    "དབྱར་ཟླ་ར་བའི་གྲལ་ཚེས་བརྒྱད་ཀྱི་གདུགས་ལ་རྒྱ་མཚོ་སྔོན་མོ་ལ་རླངས་པ་ཞིག་བྱུང་ནས།",
    "ཀླུའི་རྒྱལ་མོ་དགའ་འབར་དབུ་ཁྲུས་བྱེད་པའི་དབུ་ལ་བརྒྱབ་བོ།",
    "ཀླུའི་རྒྱལ་མོ་དགའ་འབར་མ་དེ་ཡང་རབ་ཏུ་ཐུགས་ཁྲོས་སོ།",
    "གསེར་གྱི་སྦ་ལྕག་ཕྱར་བས་ཀྱང་བྲོས་ཏེ་སོང་ངོ།",
    "ཟངས་སྐྱོགས་སུ་ཡང་ཐལ་ལོ།",
    "ཁྱི་མོ་དཀར་མོར་བརྫུས་ནས་ཚངས་ཆེན་གྱི་ཐེམ་པའི་ཕྱི་རོལ་ཏུ་ཉུལ་བ་ལས།",
    "ཁྱི་མོ་དཀར་མོ་དེ་བཟུང་བ་ལས།",
    "ཁྱི་མོ་དཀར་མོ་དེ་གར་སོང་ཆ་ཡང་མེད།",
    "མེན་ཏྲི་ཡུག་གཉིས་ཕྱུང་ནས་གཅིག་གིས་བཅིངས།",
    "གཅིག་གིས་མས་བཅིངས་པས་རབ་ཏུ་ཁྲག་ཤ་མང་པོ་ཐོན།",
    "ཁྱོད་ལ་ཡང་འདྲེས་གནོད་དོ།",
    "ཕྱའི་བུ་མོའི་གམ་དུ་མཆིའོ་དགོངས་པ་ལས།",
    "མི་རྒད་པོ་དེ་ན་རེ་ཚུར་ཉོན་དང་།",
    "རྒྱ་མཚོའི་འགྲམ་དུ་ཕྱིན་པས་རྒྱ་མཚོ་མར་ཞག་གིས་ལྟེམ་མེ་འདུག་པ་ལ།",
    "ཀླུའི་རྒྱལ་མོ་དབུ་བསིལ་པ་ལ་ཕོག་པས།",
    "ཀླུའི་རྒྱལ་མོ་དགའ་རབ་ཡང་ཁྱི་མོ་དཀར་མོར་བརྫུས་ནས།",
    "སྒོ་ཤག་གིས་ཕྱེ་ནས་ཞབས་གཡས་པ་ཐེམ་པའི་ཕྱི་རོལ་དུ་བཏང་བས་དེ་ཁྱི་མོ་དཀར་མོས་བཟུང་།",
    "ཁྱི་ལ་རལ་མེད་དེ་ཀླུའི་རྒྱལ་མོ་དགའ་རབ་སྤྲུལ་པ་ལགས་སོ།",
    "དེ་ནས་སྦྲུལ་ཁྲ་མོ་ལུས་ལ་འཁྲིལ་པ་ཡང་།",
    "ཀླུའི་རྒྱལ་མོ་དགའ་རབ་ཀྱི་སྤྲུལ་པ་ལགས་སོ།",
    "ལུས་ལ་ཤ་མཚན་སྦལ་པ་འཇུག་པ་ཡང་ཀླུའི་རྒྱལ་མོ་དགའ་རབ་ཀྱི་སྤྲུལ་པ་ལགས་སོ།",
    "རྨ་སོས་སུ་མི་སྟེར་བ་དེ་ཡང་ཀླུའི་རྒྱལ་མོ་དགའ་རབ་ཀྱི་སྤྲུལ་པ་ལགས་སོ།",
    "རྨ་གཞའ་བར་བྱེད་པ་དེ་ཡང་ཀླུའི་རྒྱལ་མོ་དགའ་རབ་ཀྱི་ཆོ་འཕྲུལ་ལགས་སོ།",
    "རྨ་མཛེ་རུ་འགྲོ་བར་བྱེད་པ་ཡང་ཀླུའི་རྒྱལ་མོ་དགའ་རབ་ཀྱི་ཆོ་འཕྲུལ་ལགས་སོ།",
    "དེ་ལྟར་ཁྱེད་ཀྱིས་བྱས་སམ་མ་བྱས་ཀླུའི་རྒྱལ་མོ་ཡིན་ནམ་མིན་པ་དེ་ཁྱེད་ལ་ཆ་མེད་པ་ཡིན་བྱས་པས།",
    "ཁྱོད་སོས་པར་འདོད་ན་སྟོན་པ་གཤེན་རབ་མི་བོ་སྤྱན་དྲངས་ལ་ཆོ་ག་མཛོད་དང་།",
    "སོས་པར་འོང་གིས་གསུངས་པས་སྲིད་པ་ཚངས་ཆེན་གྱི་ཞལ་ནས།",
    "འོ་ཉོན་མོངས་པ་ཁྱོད་ངས་སོས་པར་བྱ་ཡིས།",
    "སྣ་ལ་སའི་བདག་མོ་ལ་སྦྲན་བཏང་།",
    "དེ་ནས་སའི་བདག་མོ་ལ་ས་བསླངས་སོ།",
    "ཡང་དགོངས་པ་མཛད་པས་སྦྲུལ་ཁྲ་མོ་ཞིག་བྱུང་ངོ།",
    "ཡང་དགོངས་པ་མཛད་པས་ཁྱི་མོ་ཞིག་ཏུ་བྱུང་ངོ།",
    "ལུ་མ་ན་རེ་ལུ་མ་ན་རེ།",
    "རྨ་རེ་ན་རེ་ས་སང་མ་བྱོ་བྷོ།",
    "ཧེ་དེ་མ་ཡ་བརྗོད་པས་དཀྱིལ་འཁོར་གྱི་དབུས་ཀྱི་ལྟེ་བ་ལ་ཀླུ་མོ་དགའ་རབ་མ་དེ་བརྒྱལ་ནས་གདའ།",
    "ཡང་བར་ཕྱིན་སུ་ན་ལ་ལང་བརྗོད་པས་ཀླུའི་རྒྱལ་མོ་དགའ་རབ་དེ་དཀྱིལ་འཁོར་གྱི་ལྟེ་བ་ལས་ལངས།",
    "བདག་ཀླུའི་རྒྱལ་མོ་དགའ་རབ་བཀུམ།",
    "དེ་ནས་ཁྱོད་ཅི་མ་རུང་བྱས་པས།",
    "ཀླུའི་རྒྱལ་མོས་ད་ལྟ་ཉིད་དུ་སྟོན་པ་གཤེན་རབ་མི་བོ་ལ་བུད་མེད་བཟང་ལ་འོད་ཆགས་པ་གཅིག་ཏུ་བརྫུས་ནས།",
    "སྟོན་པའི་ཞལ་ནས་ཀླུ་མོ་ལ་མཐུན་པའི་ཡས་དང་རྫས་སྟེར་དུ་གཞུག་གོ།",
    "ང་རྟ་ལ་ཆེས་ཀྱི་སྟོན་པའི་ཕྱི་མ་རྣམས་དང་མཐུན་པའི་རྫས་དང་ཡས་ཀླུ་མོ་རྟ་ལ་ཆེས་ཀྱི་ཀླུ་བསམ་གྱིས་མི་ཁྱབ་པ་ལ་ཡང་བསྔོ་བ་བྱེད་དོ།",
