    "གང་ལྟར་ཡང་ཁོང་ཚོ་ཧ་ཅང་ཐང་ཆད་ནས་ཡོད་སྟབས།",
    "རྩམ་པ་ཟས་པའི་རྗེས་དེར་ཁོང་ཚོ་ཚང་མ་གཉིད་ཤོར་བ་རེད།",
    "ནམ་གུང་གི་སྐབས་ལ་ང་ཚོའི་མཐའ་སྐོར་གང་སར་སྒྱོགས་མདེལ་གད་པའི་སྒྲ་ཡིས་ང་ཚོ་གཉིད་ལས་སད་བྱུང་།",
    "སྒྲ་དེ་ནི་འབྲུག་སྒྲ་ལས་ཀྱང་སྐད་ཆེ་བ་འདུག་རྒྱ་མིས་ཤིང་ནགས་དཀྱིལ་ནས་ང་ཚོ་མཐོང་འདུག་ལ།",
    "ད་ནི་ཁོང་ཚོས་ང་ཚོའི་ས་སྟོང་ཆུང་ཆུང་དེར་ཤར་དང་ལྷོ།",
    "དེ་ནི་ཧ་ཅང་འཇིགས་དངངས་ཆེ་ཞིང་འཐོམ་འཐོམ་བྱེད་པ་ཞིག་རེད།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་ཨ་ཕས་ང་ཚོས་ཅ་ལག་རྣམས་བསྡུ་གསོག་མ་བརྒྱབ་པར་རྩ་ནས་མི་ཉལ་རྒྱུ་ཏག་ཏག་བཟོས་ཡོད་སྟབས།",
    "ང་ཚོས་རང་གི་ཅ་ལག་རྣམས་བླངས་ནས་བྱང་ལ་འགྲོ་རྒྱུ་དེར་ཡུད་ཙམ་ཞིག་ལསའགོར་མ་སོང་ལ།",
    "ང་ཚོ་ཐོན་ཐུབ་པ་དེ་ནི་རྫུ་འཕྲུལ་ཞིག་རེད།",
    "ཡིན་ན་ཡང་མཚན་མོ་དེ་ཧ་ཅང་མུན་ནག་ཅིང་ཟླ་བ་མེད།",
    "དེས་ཏན་ཏན་ང་ཚོ་ལ་ཕན་ཐོགས་ཡོད་པ་རེད་བསམས་བྱུང་།",
    "ཉིན་ཁ་ཤས་ཀྱི་རིང་ལ་ཁོང་ཚོས་གཞན་ཅི་ཞིག་བྱེད་མ་ཤེས་པར་རང་གི་རྐང་རྗེས་དེད་ནས་སླར་ཡང་བྱང་དུ་སོང་།",
    "བྲོས་བྱོལ་འདིའི་མཉམ་དུ་ཡོད་པའི་ཁྱིམ་མི་གཞན་རྣམས་ཀྱིས་ཨ་ཕ་ལ་ཡིད་འགུགས་བྱེད་ཐབས་བྱས་ནས་ལྷོ་ཕྱོགས་སུ་སླར་ཡང་འགྲོ་བ་ནི་སྨྱོན་པ་རེད་ཅེས་བཤད།",
    "ཨ་ཕས་དེ་ལྟར་མི་འགྲོ་བ་ནི་དེ་ལས་ཀྱང་སྨྱོན་པ་རེད་ཅེས་ལན་བཏབ།",
    "ཁོང་གིས་རང་གི་ཁྱིམ་མི་རྣམས་ཁ་བསྐོར་ནས་ལྷོ་ཕྱོགས་སུ་འགྲོ་བཅུགབདུན་ཕྲག་གཉིས་འགོར་སོང་།",
    "ཁོང་ཚོས་རང་གིས་བློས་བཏང་བའི་ས་ཆ་དང་དེ་ལས་ལྷག་ཅིག་ལ་སླར་སླེབས་ཐུབ་པར་གྱུར་ཅིང་།",
    "ཁོང་ཚོའི་ཟ་ཆས་ཡང་ཉེན་ཁ་ཆེན་པོ་དང་བཅས་ཉུང་བར་གྱུར།",
    "མཚན་མོ་གཅིག་ལ་ཁོང་ཚོས་ཡུལ་མིས་སྤངས་པའི་སྤྱིལ་བུ་ཞིག་རྙེད་ཅིང་དེར་ཉལ།",
    "མགོ་སེར་དང་ཁོའི་ཨ་མ།",
    "ཁོའི་སྲིང་མོ་བཅས་ཀྱིས་སཱའི་ཁ་ལོན་དང་ཨ་ཕ་ནི་སླར་ཡང་གཏན་ནས་མཐོང་གི་མ་རེད་བསམས།",
    "སང་ཞོགས་དེར་ཨ་ཕ་སླར་ཡང་ཁོང་ཚོ་ཡོད་སར་སླེབས།",
    "ཁོང་གིས་ཁྱིམ་མི་རྣམས་ལ་ཁོང་དང་སཱའི་ཁ་ལོན་གཉིས་ལ་མཚན་གང་རིང་འདྲི་བརྩད་བྱས་མོད་ཁོང་གཉིས་ཀྱི་སུ་ལའང་རྨས་སྐྱོན་མ་བྱུང་ཞེས་བཤད།",
    "ཨ་ཕ་ལ་ཁོའི་ཁྱིམ་མི་རྣམས་རྒྱའི་དམག་སྒར་ལ་འཁྲིད་ཡོང་དགོས་པའི་བཀའ་བཏང་བ་རེད།",
    "ཨ་ཕ་སླར་ཡང་ལོག་རྒྱུ་འགན་ལེན་བྱེད་ཆེད་སཱའི་ཁ་ལོན་གཏའ་མའི་ཚུལ་དུ་ཉར་བ་རེད།",
    "སཱའི་ཁ་ལོན་གྱི་མགོ་ལ་གདུག་རྩུབ་དང་བཅས་མེ་མདའ་རྒྱག་རྒྱུ་ཡིན་པ་རེད།",
    "ཆུ་བཞི་སྒང་དྲུག་གིས་བཙོན་སྒར་འདི་ལ་འཇབ་རྒོལ་བརྒྱབ་པ་རེད།",
    "ཁོང་ཚོས་རྒྱ་མི་རྣམས་བསད་ཅིང་བཙོན་པ་གློད་བཀྲོལ་བཏང་བ་རེད།",
    "ས་ཆ་འདི་མེར་བསྲེགས་བཏང་བ་རེད།",
    "ས་ཆ་འདི་བོད་མིའི་ཁྱིམ་མི་བྲོས་ཐབས་བྱེད་མཁན་རྣམས་བཟུང་བ་དེ་ཚོ་འཕྲལ་སེལ་རིང་ཕྱི་ལོགས་སུ་འཛིན་སྡོད་བྱེད་ས་ལྟ་བུ་ཞིག་ཏུ་བསྒྱུར་འདུག་དེ་ནི་ལས་དོན་ཆེན་པོ་དེ་འདྲ་མ་རེད་ལ།",
    "གོ་སྒྲིག་ཀྱང་ལེགས་པོ་བྱས་མི་འདུགང་ཚོ་འབྱོར་མཚམས་དེར་ཧ་ལམ་བཙོན་པ་བརྒྱ་སྐོར་ལས་ལྷག་མི་འདུགསྐོར་སྲུང་བ་ཚོ་ནི་ཁོ་ཚོས་རང་གི་བཙོན་པ་རྣམས་ལ་ལྟ་སྲུང་བྱེད་རྒྱུ་ལས་ཐག་རིང་ནས་ཡང་ཡང་ཐོས་པའི་མེ་མདའི་སྒྲ་སྐད་ལ་སེམས་ཁྲལ་མང་བ་བྱེད་པ་དེ་ཨ་ཕས་གང་མྱུར་ཤེས་པར་གྱུར།",
    "མཚན་མོ་ཁ་ཤས་རེ་རེ་བཞིན་ཁྱིམ་མི་གཞན་ཞིག་བྲོས་ཐུབ་ཀྱི་ཡོད།",
    "ན་ཆེ་ནས་མོ་རང་རང་ངོས་ནས་འགུལ་ཐུབ་ཀྱི་མེད་ལ།",
    "མི་ཚང་མས་རང་རང་གི་ལྗིད་ཚད་དེ་འཁྱེར་ཐུབ་པ་དགོས་ཀྱི་ཡོད།",
    "ཟླ་བ་བཅུ་པའི་ནང་གི་ཉི་མ་གཅིག་ལ།",
    "མཚན་མོའི་དཀྱིལ་དེར་བཙོན་པ་ཚོས་གནམ་གྲུ་ཞིག་མགོ་ཐོག་ནས་འཕུར་བ་ཐོས།",
    "དེ་ནི་ཏན་ཏན་ཨ་མི་རི་ཀའི་གནམ་གྲུ་ཡིན་རྒྱུ་རེད།",
    "རྒྱ་མི་ཚོ་ལ་མཚན་མོར་འཕུར་བའི་འཕྲུལ་རྩལ་ཡོད་པ་མ་རེད་ཟེར་བའི་དཀྲོག་གཏམ་ཞིག་ཁྱབ་པར་གྱུར།",
    "བཙོན་པ་ཚོའི་སེམས་ནང་དེ་ནི་ཆད་སྐྱོན་མངོན་གསལ་ཅན་ཞིག་རེད།",
    "དེ་རྒྱ་མིའི་གནམ་གྲུ་ཞིག་ཡིན་པ་ཡིན་ན་གུང་ཁྲན་ལ་ཆེ་བསྟོད་རྫོགས་མཐའ་མེད་པ་ཡོང་རྒྱུ་ཡིན་པ་རེད།",
    "ང་ཚོས་མི་འདིའི་སྐོར་ལ་གོ་མྱོང་ཡོད།",
    "ཁོང་གི་མིང་ལ་དུང་ཚོན་དྲུག་དྲུག་ཟེར་ཞིང་།",
    "རྒྱ་མི་ལ་སྐད་བསྒྱུར་གྱི་ཚུལ་དུ་ལས་ཀ་བྱེད་མཁན་གྱི་ཁམས་པ་ཞིག་རེད།",
    "ཡིན་ན་ཡང་ཁོ་ནི་རྒྱ་མི་ལ་ལག་སྦྲེལ་བྱེད་མཁན་ཞིག་དངོས་གནས་མ་རེད།",
    "ཞོགས་པ་དེ་ལ་ཁོང་གིས།",
    "ཁྱེད་རང་ཚོ་ནི་ལྐུགས་པ་རེད།",
    "བཙན་རྒྱལ་རིང་ལུགས་པ་ཚོ་ནི་ང་ཚོའི་དགྲ་བོ་ཡིན་པ་ལས་རྒྱ་མི་མིན་པ་ནི་ཁྱེད་ཚོས་ག་རེ་བྱས་ནས་ཤེས་མི་ཐུབ་པ་རེད།",
    "བཙན་རྒྱལ་རིང་ལུགས་པ་ཚོས་ང་ཚོའི་ལུང་པ་འཕྲོག་འདོད་པ་རེད།",
    "ག་རེ་བྱས་ནས་ཁྱེད་རང་ཚོས་ཁོང་ཚོའི་གནམ་གྲུ་དེ་མཚན་མོ་སྔོན་མ་དེ་ལ་མ་ཐོས་པ་རེད།",
    "ང་ཚོའི་མིག་ནང་དུང་ཚོན་དྲུག་དྲུག་ནི་དཔའ་བོ་ཆེན་པོ་ཞིག་རེད།",
    "མཐའ་མ་རྒྱ་མིས་མ་ཤེས་ཀྱི་བར་དུ་ཁོང་གིས་ཁམས་པ་མང་པོ་བྲོས་བྱོལ་དུ་འགྲོ་རྒྱུ་ལ་རོགས་པ་བྱས་པ་རེད།",
    "ཁོ་ཚོས་ཤེས་རྗེས་ཁོ་ལ་ཉེས་རྡུང་བཏང་ཞིང་དེ་ནས་བསད་པ་རེད་ཅེས་ང་ཚོས་གོ་བྱུང་།",
    "སྐོར་སྲུང་བ་ཚོས་བྲོས་བྱོལ་བ་ཚང་མ་པད་མ་བཀོད་དུ་སོང་བ་ཧ་ལམ་ཤེས་ཀྱི་ཡོད་མོད།",
    "ཏིང་ཏིང་རང་གི་ན་ཚ་ལས་དྲགས་སྐྱེད་བྱུང་།",
    "ཞོགས་པ་གཅིག་གི་ཉི་མ་མ་ཤར་གོང་ལ།",
    "ཨ་ཕས་ཁོང་གི་ནང་མི་ལ་བརྡ་བརྒྱབ་ཅིང་།",
    "ཁོང་ཚོ་མུན་ནག་གི་འོག་ནས་བྲོས་ཕྱིན་པ་རེད།",
    "ང་ཚོ་སླེབས་ས་དེར་གཙང་པོ་ཞེ་དྲགས་ཁ་ཞེང་ཆེ་བ་འདུག་ངའི་ཨ་མ་ལགས་ནི་སྐྲག་དངངས་ཀྱིས་འགུལ་མི་ཐུབ་པ་ཆགས་བྱུང་།",
    "གཙང་པོས་ང་ཚོ་ཚང་མ་མར་འཁྱེར་གྱི་རེད་ཅེས་ཨ་མས་ངུ་འབོད་བྱས་བྱུང་།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་ཆུའི་རྒྱུགས་ཤུགས་དེ་ཙམ་ཆེན་པོ་མི་འདུག་ལ་གཙང་པོ་ཡང་གཏིང་ཟབ་པོ་མི་འདུག་བྱས་ཙང་ཨ་ཕ་དང་སཱའི་ཁ་ལོན་གཉིས་ཀྱིས་ང་ལ་ལག་སྦྲེལ་བྱས་ཤིང་།",
    "ང་ཚོ་གསུམ་ང་ཚོའི་ཅ་ལག་མང་ཆེ་བ་དང་བཅས་གཙང་པོ་ལ་བརྒལ་བ་ཡིན།",
    "ང་ཚོས་རང་གི་ཅ་ལག་རྣམས་གཙང་པོའི་ཕར་ཕྱོགས་ཀྱི་གྲམ་པ་ལ་བཞག་ནས་ཨ་ཕ་དང་སཱའི་ཁ་ལོན་སླར་ཤུལ་ལུས་ཀྱི་ནང་མི་རྣམས་ལེན་དུ་སོང་།",
    "གཙང་བོས་ང་ཚོ་གསོད་ཀྱི་མིན་པ་དེ་ཨ་མས་ཤེས་པ་མོ་རང་གི་ངོ་གདོང་ནས་མཐོང་ཐུབ་ཀྱི་འདུགགཙང་པོའི་ཕ་རོལ་ཏུ་སླེབས་མཚམས་ཁྱིམ་མི་རྣམས་གཙང་འགྲམ་གྱི་རྡོ་དཀར་འཇམ་པོའི་སྟེང་བཀྲམས་ནས་སྐམ་པོ་བཟོས།",
    "ཁོང་ཚོའི་ལུག་ལྤགས་ཀྱི་ཕྱུ་པ་རྣམས་གཙང་འགྲམ་དང་མདངས་མཚུངས་པ་འདུག་ཏོག་ཙམ་འགོར་རྗེས་ཁོང་ཚོས་རྒྱ་དམག་གི་སྐོར་སྲུང་བ་རྣམས་གཙང་པོ་ལ་ཚུར་ཡོང་བ་ཐོས།",
    "ཁོང་ཚོས་ཅ་ལག་རྣམས་བསྡུ་གསོག་བརྒྱབ་སྟེ་རྒྱབ་ཏུ་ཡོད་པའི་ཤིང་ནགས་མཐུག་པོའི་གསེབ་ཏུ་ཡིབ་ཅིང་རྒྱ་དམག་རྣམས་ཀྱིས་ཅི་བྱེད་ཀྱིན་ཡོད་པ་ལ་བལྟ་ཐབས་བྱས།",
    "རྒྱ་དམག་རྣམས་ཐེངས་ཁ་ཤས་ལ་ཡོང་ན་ཡང་གཙང་པོ་བརྒལ་ཐབས་རྩ་ནས་བྱས་མེད་པ་རེད།",
    "ཁོང་གི་ཁྱིམ་མི་རྣམས་ཐག་རིང་འདི་འདྲ་ལ་ཡོང་དགོས་བྱུང་ཐོག་དཀའ་སྡུག་ཆེན་པོ་མྱངས་ཙང་ཡང་བསྐྱར་ཐེངས་གཅིག་རྒྱ་ལག་ཏུ་ཤོར་མི་རུང་།",
    "ས་སྲོད་ཙམ་ལ་ཁོང་ཚོའི་སྐོར་གཅིག་ང་ཚོ་ཡིབ་ས་ནས་གོ་ཐུབ་པའི་ས་ཆ་ཞིག་ལ་སླེབས་བྱུང་།",
    "ཨོཁོང་ཚོས་བརྗོད་གསལ།",
    "བཛྲ་གླུ་རུ་པདྨ་སིདྷི་ཧཱུམཞེས་བཏོན་སོང་།",
    "ང་ཚོ་ཧ་ཅང་དགའ་བོ་བྱུང་ནས་རྒྱུགས་ཏེ་སོང་བ་ཡིན།",
    "བུད་མེད་དང་པོ་དེ་སྐྲག་ནས་རྒྱབ་བཤིག་བརྒྱབ་བྱུང་།",
    "ང་ཚོ་ནི་སུ་ཡང་ཡིན་ཆོག་པ་ཞིག་རེད།",
    "ང་ཚོས་གློག་འོད་རྣམས་ང་ཚོའི་གདོང་ལ་བསྟན་ནས་ཁོང་ཚོས་ང་ཚོའི་ངོ་གདོང་མཐོང་བཅུག་པ་ཡིན།",
    "དེའི་རྗེས་ལ་དཀའ་ངལ་གང་ཡང་མི་འདུགང་ཚོ་བདུན་གཅིག་རིང་བསྡད་ནས་གཟུགས་པོའི་ཟུངས་གསོས་ཤིང་ང་ཚོའི་བྲོས་བྱོལ་གྱི་ལམ་ཁ་ལ་རྒྱུས་ལོན་བྱས་པ་ཡིན་ལ།",
    "ང་ཚོའི་མདུན་དུ་ཡོད་པའི་དཀའ་ངལ་ཅན་གྱི་འགྲུལ་བཞུད་དེའི་ཆེད་དུ་ཟ་ཆས་གྲ་སྒྲིག་བྱས་པ་ཡིན།",
    "འགྲུལ་བཞུད་ཀྱི་རིམ་པ་རྗེས་མ་དེ་གང་འཚམས་ཤིག་གི་བར་དུ་པད་ཆུ་གཙང་པོའི་རྒྱུད་དུ་སོང་ཞིང་སྤྲ་མོ་ན་ཡོད་པའི་བཅིངས་འགྲོལ་དམག་གི་དམག་སྒར་ལས་ཧ་ཅང་ཐག་རིང་བ་མ་རེད།",
    "དེ་ནས་ལྷོ་ལ་འགྲོ་དགོས་སྟབས་གཙང་པོ་དང་ཁ་གྱེས་པ་རེད།",
    "དེ་ནས་ལམ་ཁ་དེ་ལུང་པ་རིང་ཞིང་ཤིང་ནགས་ཀྱིས་ཁེངས་པ་ཞིག་གི་ནང་དུ་སོང་།",
    "ཉིན་རྗེས་མ་དེ་དག་ཏུ་ཁོང་ཚོ་ས་ཆ་མཐོ་སར་འཛེགས་རིམ་བཞིན་གནམ་གཤིས་མུ་མཐུད་ནས་ཇེ་གྲང་དུ་སོང་ལ།",
    "དེ་ནི་ཁྱིམ་མི་ཚོ་ལ་དུས་ཚོད་འདི་ནི་དགུན་ཁ་དགུན་ནག་དེ་ཡིན་པ་དང་རི་རྒྱུད་དེ་ཚོ་བརྒྱུད་ནས་བྲོས་བྱོལ་དུ་འགྲོ་བའི་ཐབས་ཤེས་བྱེད་པའི་དུས་ཚོད་སྡུག་ཤོས་དེ་ཡིན་པའི་དྲན་གསོ་སྐྱུར་མོ་ཞིག་གཏོང་།",
    "ཁ་བ་ལེབ་མོ་ཆུང་ཆུང་དག་ཀྱང་མཐོང་མགོ་བཙུགས།",
    "ཁོང་ཚོ་ཤིང་ནགས་ཀྱི་མཚམས་བརྒལ་ནས་སོང་དུས་དེར་གནམ་གཤིས་ཧ་ཅང་གྲང་།",
    "ཁོང་ཚོའི་ལམ་ཁ་དེ་ཚྭ་ཁུ་ཅན་དུ་གྱུར་ཅིང་དེ་ནས་གངས་ཀྱིས་ཁེངས་པར་གྱུར།",
    "བྱིས་པ་རྣམས་ངུ་དགོས་པ་ཤར་དུས་ཨ་ཕ་དང་སཱའི་ཁ་ལོན་གཉིས་ཀྱིས་གང་ལྟར་མུ་མཐུད་ནས་འགྲོ་རྒྱུར་སྐུལ་མ་བྱེད་ཐུབ་པར་གྱུར།",
    "ཨ་ཕ་དང་སཱའི་ཁ་ལོན་ཐོག་མར་སོང་ཞིང་།",
    "དེ་ནས་ཨ་མ་དང་སྲིང་མོ་བཅས་ཡོང་།",
    "དེ་ལྟར་བྱས་པས་ལོ་ན་ཆུང་ཤོས་ཀྱི་ཁྱིམ་མིའི་གངས་ལམ་དེ་མ་མཐའ་ལ་ཡང་ཏོག་ཙམ་མར་མནན་ཡོད་པ་རེད།",
    "དེ་ནི་ཆུང་ཆུང་ཡིན་ན་ཡང་གྲགས་ཆེ་ཙམ་ཡོད་པ་རེད།",
    "ཨ་ཕས།",
    "ཁོང་ཚོས་གང་མཐོང་བ་དེས་ཁོང་ཚོ་ཚང་མ་དངོས་གནས་ཧ་ལས་པ་ཞིག་བཟོས།",
    "ཁོ་ཚོ་ཡོང་གི་འདུག་ད་ཡོང་གི་འདུག་ཟླ་བ་ཤར་འདུགང་ཚོས་རྒྱ་མི་རྣམས་རི་ངོགས་སུ་ཡར་ཡོང་གི་ཡོད་པ་མཐོང་ཐུབ་ཀྱི་འདུགཅེས་སྐད་བརྒྱབ་བྱུང་།",
    "དེ་ནི་ཧ་ཅང་འཐོམ་འཐོམ་ཞིག་དང་དངོས་གནས་འཇིགས་སྣང་ཆེ་བ་ཞིག་རེད།",
    "ང་ཚོ་དེར་འགྲོ་ཐུབ་པ་འདུག་རྒྱབ་ལ་བལྟས་ནས་ནུས་སྟོབས་འཕྲོ་བརླག་ཏུ་མ་གཏོང་།",
    "མཚམས་རེར་གངས་དེ་ང་ཚོའི་པུས་མོ་སྒང་ལ་སླེབས་ཀྱི་འདུག་མཚམས་རེར་གངས་དེ་འཁྲུག་དར་རང་རེད།",
    "མི་ཚང་མས་རང་གི་ཐུབ་ཚོད་ནུས་ཚོད་ཀྱིས་ཕན་ཚུན་ལ་རོགས་བྱེད་ཐབས་བྱས་པ་རེད།",
    "ང་ཚོའི་སུ་གཅིག་གིས་ཀྱང་དེ་ལ་དོ་སྣང་མི་བྱེད་པ་དེ་ཁྱེད་ཀྱིས་ཤེས་སམ།",
    "དེ་དངོས་གནས་བདེན་པ་རེད།",
    "ང་ཚོ་ཚང་མ་དགའ་ནས་མིག་ཆུ་གཏོང་གི་ཡོད།",
    "དེ་ནས་མི་གཅིག་གིས།",
    "ཁྱེད་ཚོས་དེ་རིང་ནི་ལོ་གསར་ཚེས་པ་གཅིག་ཡིན་པ་ཤེས་སོང་ངམ།",
    "རེད།",
    "ང་ཚོ་ཡུད་ཙམ་རིང་དེར་ལངས་ནས་བསྡད་དེ་གནས་ཚུལ་ཧ་ལས་པ་དེ་ཤེས་ཐབས་བྱས་ཤིང་།",
    "དེ་ནས་ང་ཚོས་མཆོངས་ལྡིང་དང་སྐད་རྒྱག་མགོ་བཙུགས།",
    "དེ་ནས་ང་ཚོ་ལུང་ཁུག་ཏུ་མར་བབས་པ་ཡིན།",
    "གོམ་པ་རེ་རེ་བཞིན་ལས་སླ་རུ་སོང་།",
    "ངའི་གཟུགས་པོའི་ཆ་ཚང་མ་ལ་ག་ཚོད་ཀྱིས་ན་ཟུག་བཏང་བ་དེ་ངས་དྲན་གྱི་འདུག་ཡིན་ན་ཡང་དེ་ལ་ཁྱད་པར་གང་ཡང་མི་འདུག་ང་ཚོའི་གཤམ་དེར་པད་མ་བཀོད་ཡོད་པ་རེད།",
    "དགའ་སྣང་དེ་ཡུད་ཙམ་ཞིག་རེད།",
    "ཉིན་གཉིས་ཀྱི་རྗེས་སུ་མོ་གྲོངས།",
    "ཟླ་བ་གཉིས་ཀྱི་རྗེས་སུ་སྲིང་མོ་རྒན་ཤོས་གཡང་འཛོམས་ཀྱང་གྲོངས།",
    "༡༩༦ ལོའི་ཟླ་༥ཚེས་༡ ཉིན་ཨ་རིའི་སོ་པའི་གནམ་གྲུ་རྟགས་ཅན་ཞིག་པཱ་ཀི་སི་ཐཱན་ཤར་མ་ནས་འཕུར་ཏེ་ཨུ་རུ་སུ་ལ་འགྲོ་ལམ་དུ་ཧི་མ་ལ་ཡའི་སྟེང་དུ་འཕུར་བ་རེད།",
    "དེ་ནི་འཆར་ཅན་གྱི་པར་ལེན་སོ་པའི་ལས་དོན་ཐོག་ཡོད་རེད།",
    "ཨུ་རུ་སུས་གནམ་གྲུ་དེ་ལ་མདེལ་འཕངས་ནས་མར་ཕབ་པ་རེད།",
    "ཉིན་ཤས་ཀྱི་རྗེས་དེར་ཨ་རིའི་སྲིད་འཛིན་ཨེ་སེན་ཧོ་ཝར་དང་ཨུ་རུ་སུའི་སྲིད་བློན་ནཱི་ཀཱི་ཏཱ་ཁུར་ཤི་ཆོབ་གཉིས་བར་གྱི་མཇལ་འཛོམས་ཤིག་རྒྱལ་ས་པཱ་རེ་སི་རུ་བསྐོང་འཆར་ཡོད་པ་དེ་ཕྱིར་འཐེན་བྱས་པ་རེད།",
    "ཤར་ནུབ་ཀྱི་ཆབ་སྲིད་འབྲེལ་ལམ་ནང་བཞིན་ཐུར་བགྲོད་ལྟས་ངན་ཞིག་ཏུ་ཕྱིན་པ་རེད།",
    "འདིས་བོད་ཀྱི་འགོག་རྒོལ་ཐད་ཚབས་ཆེའི་ཤུགས་རྐྱེན་ཐེབས་ཀྱི་རེད།",
    "སྲིད་འཛིན་ཨེ་སེན་ཧོ་ཝར་གྱིས་འཕྲལ་དུ་དམར་ཤོག་ཕྱོགས་ཁག་གི་སྟེང་དུ་འཕུར་བའི་གནམ་གྲུ་ཚང་མ་བཀག་པ་རེད།",
    "བོད་ཀྱི་ལས་དོན་ནི་དེའི་གྲུབ་འབྲས་ཀྱི་ཕྱོགས་ལ་འགྲོ་བའི་མགོ་ཚུགས་ཙམ་རེད།",
    "དོན་དག་ཚང་མ་རང་རང་གི་ས་ལ་འབབ་བཞིན་ཡོད།",
    "ཆབ་སྲིད་ཀྱི་དཀའ་རྙོག་འཕར་མ་ཞིག་ཀྱང་ལངས་པ་རེད།",
    "ཨ་རིའི་སྤྱི་མཐུན་ཚོགས་པའི་སྒྲིག་འཛུགས་ལ་ད་དུང་ཡང་བྱུང་རྐྱེན་དེས་ན་ཟུག་གཏོང་གི་ཡོད།",
    "ཚུར་གནོད་རིགས་དང་འོས་འདེམས་ཀྱི་མཇུག་འབྲས་ལ་དོ་ཕོག་གཏོང་རིགས་མི་བྱེད་རྒྱུའི་སློབ་སྟོན་ཞུས་པ་རེད།",
    "ཟླ་བ་བཅུ་གཅིག་པའི་ནང་ཁེ་ནཱ་ཌེ་ཨ་མི་རི་ཀའི་སྲིད་འཛིན་སུམ་ཅུ་སོ་ལྔ་པར་འོས་འདེམས་བྱས་པ་རེད།",
    "མ་མཐའ་ལ་ཡང་ཐོག་མའི་དུས་སྐབས་དེར་འབའ་པ་རྒན་ཡེ་ཤེས་ཀྱིས་རང་གི་ཞན་ཆ་རྣམས་ཁ་སྐོང་ཐུབ་པའི་འཇོན་ནུས་བསྟན་ཡོད་པ་འདྲ།",
    "འབའ་བ་རྒན་ཡེ་ཤེས་གཏམ་བརྗོད་ལ་མཁས་ལུགས་ནི་བླ་ན་མེད་པ་ཞིག་རེད།",
    "ཁོང་གིས་དཀའ་རྙོག་རྣམས་ལག་འོག་ནས་མ་ཤོར་གོང་དུ་ཐག་གཅོད་བྱེད་པའི་མིང་གྲགས་ཐོབ་པ་རེད་ལ།",
    "ཁོང་གི་ཐོག་མའི་འགན་ཁུར་ནི་ཁོང་དང་མཉམ་དུ་གློ་སྨོན་ཐང་ལ་འགྲོ་མཁན་བསྡུ་རུབ་བྱེད་རྒྱུ་དེ་རེད།",
    "ལོ་སྔོན་མའི་སྐབས་སུ་མེག་ཀར་ཐེ་ཡིས་དམག་དོན་ལས་ཀའི་ནང་དང་བླངས་པ་སུམ་བརྒྱ་ནས་བཞི་བརྒྱ་བར་དུ་རོགས་རམ་བྱེད་རྒྱུ་ཡིན་པའི་མོས་མཐུན་བྱས་པ་རེད།",
    "འབའ་བ་རྒན་ཡེ་ཤེས་གློ་སྨོན་ཐང་དུ་སྤོར་ནས་ལོ་གཅིག་གི་ནང་ཚུད་དུ་ཁོང་ལ་ཧ་ལམ་གྲངས་འབོར་དེ་ལས་ལྡབ་གསུམ་བཞི་ཞིག་གིས་མང་བ་ཡོད་པ་རེད།",
    "དེའི་སྟེང་དུ་གྱེན་ལོག་པ་མང་པོས་རང་གི་ཁྱིམ་མི་ཡང་ཁུག་ཀྱོག་གི་གཡུལ་ས་འདིར་འཁྲིད་ཡོང་ཡོད།",
    "ཟླ་བ་རྗེས་མའི་ནང་གློ་སྨོན་ཐང་དུ་ཐོག་མའི་མཚོན་ཆ་གནམ་གཡུགས་གཏོང་རྒྱུ་བྱས་པ་རེད།",
    "དེ་ལ་དཀའ་ངལ་གཅིག་ཡོད་རེད།",
    "མ་མཐའ་ལ་ཡང་ཨ་མི་རི་ཀ་བ་ཚོའི་ལྟ་ཚུལ་བྱས་ན་དེ་ལྟར་ཡོད་རེད།",
    "དམག་དོན་ལ་ཁེ་ཕན་དུ་གྱུར་པའི་གློ་སྨོན་ཐང་གི་ཁུག་ཀྱོག་རང་བཞིན་དེ།",
    "གློ་སྨོན་ཐང་དུ་ཨ་རིའི་གསང་ལས་པ་གཏོང་རྒྱུ་ནི་ཡོང་མི་སྲིད་པ་ཞིག་རེད།",
    "དེ་འདྲའི་གནས་སྟངས་འོག་ཏུ་གང་ལ་ཡང་རྩིས་འགན་འཁྱེར་མི་དགོས་པའི་དམག་སྤྱི་ཞིག་རེད།",
    "ཨ་མི་རི་ཀ་བ་དང་བོད་མི་ཚང་མས་འདྲ་མཚུངས་སུ་སྡུག་སྦྱོང་མྱོང་གི་རེད།",
    "༡༩༦༡ལོའི་ཟླ་བ་༡ པའི་ནང་འབའ་བ་རྒན་ཡེ་ཤེས་ཀྱི་དམག་མི་བོད་ནང་དུ་ཕར་རྒོལ་དང་ཕྱིར་འཐེན་གྱི་ལས་དོན་འཆར་ཅན་ཞིག་གི་སྐབས་སུ་ཧ་ལས་པའི་ལམ་ལྷོང་བྱུང་ཡོད་པ་རེད།",
    "འཇབ་དམག་ཚོས་ལྷོ་ཕྱོགས་ཀྱི་རྒྱ་མིའི་དམག་སྒར་ཁག་སྣེ་མཐུད་བྱེད་པའི་ལམ་ཁ་ཁོ་ན་སྟེ་ལྷ་ས་དང་ཤིན་ཅང་གི་ལམ་ཁའི་སྟེང་འགྲོ་བའི་རྒྱ་མིའི་འཇིབ་འཁོར་ཅིག་དང་ཊཱག་འཁོར་ཞིག་ལ་འཇབ་རྒོལ་བྱས་པ་རེད།",
    "བྱེ་ཐང་རྒྱ་ཆེན་པོ་ཞིག་གི་སྟེང་དུ་ཆགས་ཡོད་ཅིང་ལམ་ཁ་དེ་ཡོ་ཁྱོར་བྱེད་པའི་བྱེ་འབུར་གྱིས་ཆ་མང་པོ་བཀབ་ཡོད།",
    "ཐག་ཉེ་བའི་བྲག་འབུར་དེའི་ཐོག་ནས་བོད་མི་ཚོ་ཁོང་ཚོའི་དམིགས་འབེན་དེ་ཚོ་རང་གི་ཐད་ཀའི་འོག་དེར་མ་སླེབས་ཀྱི་བར་དུ་སྒུག་ཅིང་དེ་ནས་ཁོང་ཚོས་འབེན་དེ་ལ་གཞུས་པ་རེད།",
    "འཇབ་རྒོལ་དེའི་ནང་ཞུགས་པའི་ཇབ་དམག་གཅིག་གིས་དེ་ནས་ཇི་བྱུང་གི་སྐོར་འགྲེལ་བརྗོད་བྱས་དོན།",
    "མདེལ་གྱིས་མོ་ཊའི་མདུན་གྱི་ཤེལ་སྒོ་བརྟོལ་ནས་སོང་ཞིང་ཁ་ལོ་བའི་མགོ་དེ་རྒྱབ་ཏུ་འཁྱོར།",
    "མདུན་རིམ་རྐུབ་སྟེགས་སྟེང་སྡོད་མཁན་བུ་གཅིག་དང་བུ་མོ་གཅིག་ཡོད་པ་དེ་ལ་མེ་མདའ་ཕོག་རིམ་བཞིན་གཟུགས་པོ་སར་ལྷུང་།",
    "རཱོ་སེ་ཡིས་རང་གི་མེ་མདའི་ཚབ་ཏུ་པར་ཆས་བླངས།",
    "ཁོང་པར་རྒྱག་རྒྱུའི་ཆེད་དུ་མདུན་དུ་སོང་བ་དང་འཇིབ་འཁོར་གྱི་རྒྱབ་ནས་མེ་མདའ་རྒྱག་མགོ་བཙུགས་སོང་།",
    "སྐར་མ་གཅིག་གི་རྗེས་སུ་ཁོང་ཚོ་ད་ལྟ་ཁུ་སིམ་མེར་ཡོད་པའི་དམིགས་འབེན་ཡོད་ས་དེར་འཛོམས་ཤིང་རྒྱ་མི་ཤི་བོ་བཞི་བོ་ཕར་བསྐྱལ་ཅིང་།",
    "རཱོ་སེ་ཡིས་རི་རྩེར་ཡིབ་ནས་ཡོད་པའི་འཇབ་དམག་རྣམས་རང་རང་གི་བཞོན་པའི་ཐག་ཉེར་སྡོད་དགོས་པའི་ཤུབ་སྒྲས་བརྡ་བསྟན།",
    "ར་ར་དང་ཁོའི་དམག་མི་རྣམས་ཀྱིས་མ་ཤེས་མོད།",
    "ཁོང་ཚོས་རྒྱ་མིའི་གསང་ལས་ཀྱི་གསེར་གྱི་གཏེར་ཁ་ངོ་མ་ཞིག་ཕྱིར་འདོན་བྱས་ཡོད་པ་རེད།",
    "གཟབ་ནན་གྱི་ཉམས་ཞིབ་བྱེད་ཆེད་དེས་རང་ཉིད་མི་ངོ་མས་སླར་ཡང་ཝ་ཤིན་ཊོན་དུ་འཁྱེར་བ་རེད།",
    "གློ་སྨོན་ཐང་གི་འཇབ་དམག་ཚོས་མེ་མདའ་བརྒྱབ་ནས་བསད་པའི་ཀོ་སྒམ་གྱི་བདག་པོ་དེ་ནི་བཅིངས་འགྲོལ་དམག་གི་སྤྱི་ཁྱབ་བཀོད་འདོམས་པ་ཞིག་ཡིན་པ་རེད།",
    "འབྱུང་འགྱུར་ལོ་ངོ་ཁ་ཤས་ཀྱི་རིང་ལ་དེ་ཁོ་ན་ལས་མེད་པ་ཞིག་ཡོང་གི་རེད།",
    "ད་ནི་བོད་ཀྱི་ལས་དོན་དཔུང་ཁག་ལ་གློ་སྨོན་ཐང་གི་དམག་དོན་གྱིས་ཁེ་ཕན་ཡོད་པའི་ཁུངས་སྐྱེལ་རྩོད་མེད་ཅིག་ཡོད་པ་རེད།",
    "ཡིན་ན་ཡང་དེ་ནས་ཆབ་སྲིད་དག་ཀྱང་རྩེ་མོའི་ནང་འཛུལ་བ་རེད།",
    "གསར་དུ་བསྐོ་བཞག་བྱས་པའི་རྒྱ་གར་བཅའ་སྡོད་ཀྱི་ཨ་རིའི་གཞུང་ཚབ་པ་དང་སྲིད་འཛིན་ཁེ་ནཱ་ཌེའི་བློ་ཐག་ཉེ་ཤོས་ཀྱི་སློབ་སྟོན་པའི་གྲས་ཡིན་པའི་ཇཱོན་ཀེ་ནེ་ཐི་གྷལ་བཱི་རེ་ཐི་ཡིས་མངོན་སུམ་གྱིས་བོད་མི་ཚོ་ལ་དགག་བྱའི་ལས་ཀ་བྱས།",
    "གྷལ་བཱི་རེ་ཐི་ནི་མཚན་མཐོང་གིས་ཁེངས་ཡོད་ཅིང་།",
    "ཁེ་ནཱ་ཌའི་ཁྱིམ་རྒྱུད་ཀྱི་གྲོགས་པོ་བཅས་ཡིན་པ་རེད།",
    "དེའི་ཁར་གྷལ་བཱི་རེ་ཐི་ཡི་བོད་དོན་ལས་འཆར་ལ་མི་དགའ་བ་དེ་སྒེར་གྱི་འདོད་པར་མི་འགྲོ་བ་ཞིག་ཏུ་གྱུར་ཡོད་དེ།",
    "ཁོང་ཚོ་ནི་ཧ་ཅང་བཙོག་པའི་མི་རེད་ཅེས་བྲིས་པ་ལྟར་རེད།",
    "གཞུང་ཚབ་གྷལ་བཱི་རེ་ཐི་ཡིས་དཀའ་ལས་བརྒྱབ་ནས་བོད་མི་ཚོར་བོད་ནང་ངམ་གློ་སྨོན་ཐང་གང་ཡིན་དུ་གནམ་གཡུགས་གང་ཡང་མི་གཏོང་རྒྱུའི་ཞུ་སྐུལ་བྱས།",
    "གཞུང་ཚབ་ཆེན་མོས་ཨ་རིའི་ཕྱི་སྲིད་ལ་སྟངས་འཛིན་བྱེད་ཀྱིན་མེད་སྲིད་མོད།",
    "རྒྱ་གར་གླིང་ཕྲན་དུ་ཏན་ཏན་སྲིད་འཛིན་ཁེ་ནེ་ཌེའི་ཁ་དང་མིག་ཡིན་པ་རེད།",
    "དེའི་མཇུག་འབྲས་སུ་སྲིད་འཛིན་ཁེ་ནེ་ཌེས་གྷལ་བཱི་རེ་ཐི་ལ་མགོ་སྒུར་ཞིག་བྱས་ཏེ་གློ་སྨོན་ཐང་དུ་ད་ཕྱིན་གྱི་གནམ་གཡུགས་གཏོང་བ་ལ་ཆ་རྐྱེན་ཞིག་བཞག་ཡོད་དེ།",
    "གལ་སྲིད་རྒྱ་གར་གཞུང་གིས་དམག་དོན་ལས་འགུལ་ལ་ཐོག་མར་བཀའ་འཁྲོལ་དང་རྒྱབ་སྐྱོར་ཡོད་པ་ཡིན་ཚེ།",
    "གཞི་ནས་ཁོང་ཚོས་མུ་མཐུད་ལས་འགུལ་སྤེལ་ཆོག་ཅེས་པ་དེ་རེད།",
    "འདི་ནི་གྷལ་བཱི་རེ་ཐི་ཡིས་ཧ་ཅང་མངོན་ཆུང་ཞིག་མ་ཡིན་པའི་ཐོག་ནས་དམག་དོན་ལས་འགུལ་མཚམས་འཇོག་བྱེད་རྒྱུ་འགན་ལེན་བྱེད་ཐབས་དེ་རེད།",
    "རྒྱ་གར་གྱིས་གཏན་ནས་རོགས་མི་བྱེད་པ་ནི་ཤེས་གསལ་རེད།",
    "བྱས་ཙང་གློ་སྨོན་ཐང་ལ་འབྱུང་འགྱུར་གྱི་གནམ་གཡུགས་གཏོང་འཆར་རྣམས་དེ་མུར་ལུས་པ་རེད།",
    "དམག་སྒར་ཀཱེལ་གྱི་ལས་བྱེད་མང་པོ་ལ་ལས་འགན་བསྐྱར་སྤྱོད་བྱས་པ་རེད།",
    "རཱོ་ཇཱར་མེག་ཀར་ཐེ་ཡིས་བོད་དོན་ལས་དོན་རུ་ཁག་གི་འགོ་གཙོ་ཡིན་པའི་གོ་གནས་དེ་བསྐྱུར་ནས་ལས་འགན་གསར་པ་ཞིག་གི་ཆེད་དུ་ཐེ་ཝན་ལ་ཕྱིན་པ་རེད།",
    "དེ་ལ་བརྟེན་ནས་ཁེན་ཀི་ནའུ་སེ་ནི་མེག་ཀར་ཐེ་ཡི་ལས་འཆར་ཨ་མ་ཡི་སྐྱ་ཐིག་ཙམ་གྱི་རྣམ་པ་ལ་སྟངས་འཛིན་བྱེད་རྒྱུ་བཞག་པ་རེད།",
    "ཁེ་ནེ་ཌེ་དང་གྷལ་བཱི་རེ་ཐི།",
    "ཐ་ན་བོད་དོན་ལས་དོན་རུ་ཁག་དུས་གཅིག་ཏུ་སྒོ་རྒྱག་རྒྱུའི་སྐད་ཆ་ཡང་བྱུང་བ་རེད།",
    "གློ་སྨོན་ཐང་གི་འཇབ་དམག་ཚོས་ཨ་རིའི་ཆབ་སྲིད་ཀྱི་སྐོར་ལ་ཅི་ཡང་ཤེས་ཀྱིན་མེད།",
    "༡༩༦༢ལོར་ཁོང་ཚོའི་འཕྲལ་གྱི་སེམས་ཁྲལ་ནི་དོན་གཅིག་གི་ཐོག་ཏུ་ལྷུང་ཡོད་དེ།",
    "རང་གི་མཐའ་སྐོར་གྱི་དཀའ་ངལ་གྱི་གནས་སྟངས་ལས་ཐར་རྒྱུ་དེ་རེད།",
    "བོད་མི་སྐྱབས་བཅོལ་བ་རྣམས་ས་མཚམས་བརྒལ་ནས་གློ་སྨོན་ཐང་དུ་ཡོང་བསྡད་ཀྱིན་འདུག་ང་ཚོ་ནི་རང་ཁ་རང་གསོ་ཐུབ་རྒྱུ་ལ་དཀའ་ངལ་ཆེན་པོ་འཕྲད་བསྡད་ཡོད་ལ།",
    "ང་ཚོ་ལ་མཐུན་རྐྱེན་འདང་ངེས་རྩ་ནས་ཡོད་མ་མྱོང་།",
    "ཨ་མི་རི་ཀས་གནམ་གཡུགས་ཐེངས་ཁ་ཤས་བརྒྱབ་པའི་རྗེས་སུ་ཚང་མ་མཚམས་འཇོག་བྱས་པ་རེད།",
    "དེ་ནི་ཧ་ཅང་ཐབས་སྡུག་ཅིག་རེད།",
    "རྒྱ་གར་གྱིས་ང་ཚོར་རོགས་སྐྱོར་རྩ་ནས་མི་བྱེད་པ་དེ་ང་ཚོས་ཤེས་ཡོད།",
    "ང་ཚོའི་ཟ་ཆས་དང་གྱོན་ཆས་དེ་ཚོ་གློ་སྨོན་ཐང་གི་མི་མང་ལ་བརྟེན་ཡོད།",
    "ཁོང་ཚོ་ཡང་ཧ་ལམ་ང་ཚོ་ནང་བཞིན་ཧ་ཅང་སྐྱོ་པོ་རེད།",
    "ང་ཚོ་འཚོ་གནས་ཐུབ་ཆེད་རིན་ཐང་ཡོད་པ་ཚང་མ་བཙོང་དགོས་བྱུང་།",
    "ཐ་ན་ང་ཚོས་དུས་རྒྱུན་ནས་སྲུང་སྐྱོབ་ཆེད་རང་གི་སྐེ་ལ་འདོགས་པའི་དངུལ་གྱི་གའུ་ཡང་བཙོངས་པ་རེད།",
    "ང་ཚོས་གའུ་ནང་གི་ནང་རྟེན་རྣམས་བཏོན་ནས་ཉར་པ་ཡིན་མོད་དངུལ་གྱི་གའུ་དེ་བཙོངས་པ་རེད།",
    "ང་ཚོས་ཚུར་ལེན་ཐུབ་པའི་རྡོ་དང་ཤིང་ལོ།",
    "མི་མང་པོ་ཤི་ཡོད་པ་རེད་ལ་དམིགས་བསལ་གྱིས་ཐོག་མའི་དགུན་ཁ་གཉིས་ཀྱི་རིང་ལ་ཤི་ཡོད།",
    "གང་ལྟར་ཡང་གློ་སྨོན་ཐང་གི་སྐྱབས་བཅོལ་བ་ཚོར་རོགས་སྐྱོར་ཞིག་ཡོང་ཉེར་ཡོད།",
    "ལས་ཀྱི་འགྱུར་ལྡོག་ཁྱད་མཚར་ཞིག་གི་ནང་དུ་གནས་ཚུལ་ཞིག་བྱུང་ཡོད་ཅིང་།",
    "གློ་སྨོན་ཐང་གི་འགོག་རྒོལ་ལ་ཐད་ཀར་འབྲེལ་བ་མེད་ན་ཡང་།",
    "གཞུང་ཚབ་གྷལ་བཱི་རེ་ཐི་ཡིས་བོད་ལ་མི་དགའ་བའི་བསམ་ཚུལ་རྣམས་འགོག་ཐུབ་ཙམ་བྱུང་བ་རེད།",
    "དེ་ལས་ཀྱང་གལ་ཆེ་བ་ཞིག་ལ་གནས་ཚུལ་དེས་ནེ་ཧ་རུ་དང་ལས་རོགས་ཚོ་སྲུང་སྐྱོབ་ཀྱི་ལངས་ཕྱོགས་འཛིན་བཅུག་པ་རེད།",
    "ཁོང་ཚོ་ད་ནི་ནེ་ཧ་རུ་ཡི་དཔུང་སྦྲེལ་སྤུན་ཟླ་རེད།",
    "ཤ་ཚའི་འགྱུར་ལྡོག་སྐྱེན་པོ་འདིའི་ཆེད་དུ་བོད་མི་ཚོས་སུ་ལ་བཀའ་དྲིན་ཆེ་འབུལ་ཞུ་དགོས་རེད།",
    "གནས་ཚུལ་གང་འདྲ་ཞིག་གིས་འདི་འདྲའི་ཡ་མཚན་ཅན་གྱི་གོ་ལྡོག་གི་འགྱུར་བ་ཞིག་བསྐྲུན་པ་རེད།",
    "༡༩༦༢ལོའི་ཟླ་༡ཚེས་༢༢ཉིན་རྒྱ་ནག་གིས་རྒྱ་གར་ལ་བཙན་འཛུལ་བྱས་པ་རེད།",
    "རྒྱ་གར་བྱང་ཕྱོགས་ས་མཚམས་དེ་ལོ་བཅུ་ཕྲག་མང་པོའི་རིང་ལ་མེག་མོ་ཧྭན་ས་ཐིག་ཅེས་ཟེར་ཞིང་རོབ་རྩིས་བྱས་ན་ཧི་མ་ལ་ཡའི་ཤར་ངོས་རི་རྒྱུད་བརྒྱུད་ནས་ཨ་སཱམ་དང་འབར་མའི་ནང་སོང་ཡོད།",
    "༡༩༡༤ ལོ་ནས་བཟུང་རྒྱ་ནག་གིས་ས་མཚམས་འདིའི་སྐོར་ལ་རྩོད་རྙོག་བསླངས་ཡོད།",
    "སིམ་ལའི་ཆིངས་ཡིག་གི་སྐབས་འདིར་ལུང་པ་གཉིས་ཀྱིས་རྒྱ་གར་འདི་དུས་དེར་དབྱིན་ཇིའི་མངའ་འོག་ཏུ་ཡོད།",
    "དང་བོད་ཀྱི་ས་མཚམས་སྐོར་ལ་གྲོས་མོལ་བྱས་པ་རེད།",
    "མེག་མཱོ་ཧཱན་ས་ཐིག་གིས་ས་ཁམས་ཀྱི་ས་མཚམས་ཤིག་འཐེན་པ་ཇི་བཞིན་ན་ཟུག་གི་རྩོད་གཞིའི་ལམ་ཕྲན་ཞིག་ཀྱང་འཐེན་པ་རེད།",
    "མེག་མོ་ཧཱན་ས་ཐིག་དེར་བྱང་ཤར་མཐའ་མཚམས་ལས་ཁང་ཞེས་བཏགས་པ་རེད།",
    "མིང་བསྒྱུར་ཀྱང་རྩོད་རྙོག་ལ་འགྱུར་བ་མ་སོང་།",
    "མའོ་ཡི་རྒྱ་ནག་གསར་པ་དང་ནེ་ཧ་རུ་ཡི་རྒྱ་གར་གསར་པ་གཉིས་ས་མཚམས་ཐད་འགལ་ཟླ་ཆེན་པོར་གནས་པ་རེད།",
    "གསར་སྐྱེས་ཀྱི་རྒྱལ་ཁབ་འདི་གཉིས་དཀའ་ངལ་ཆེ་ཁག་གཞན་གྱིས་བཟུང་སྟབས་ས་མཚམས་ཀྱི་རྩོད་རྙོག་དེ་གལ་ཆུང་གི་གྲས་སུ་ལྷུང་བ་རེད།",
    "ཆེས་སྔ་མོ་དཔེར་ན་༡༩༥ ནང་གི་བར་དཀྱིལ་ཙམ་ནས་མེ་ལྕེ་དེ་ཡར་ལངས་ཡོད་པ་རེད།",
    "མའོ་ཡི་བོད་ཀྱི་ལྷོ་ལམ་སྟེ་དེང་རབས་འཕྲུལ་རྩལ་གྱི་མཛད་རྗེས་དེས་རྒྱ་གར་བྱང་ཤར་མཐའ་མཚམས་ཀྱི་སྐོར་གཅིག་བཅད་ནས་སོང་ཡོད་པ་རེད།",
    "རྒྱ་གར་བྱང་ཤར་མཐའ་མཚམས་ཀྱི་དྲི་བ་དེ་ནི་འཕེལ་བཞིན་པའི་དགྲ་བོ་འདི་གཉིས་བར་གྱི་འགལ་ཟླའི་གཞི་རྩ་དེ་ཆགས་པ་རེད།",
    "དེ་ནས་བཟུང་གནས་སྟངས་ཐུར་དུ་སོང་བ་རེད།",
    "༡༩༦༢ ལོར་སླེབས་དུས་རྒྱ་དཀར་ནག་གི་བར་གྱི་ཆབ་སྲིད་ཀྱི་འབྲེལ་བ་དེ་ཆེས་སྡུག་ཤོས་ཀྱི་དུས་དེར་གནས་ཡོད།",
    "བཅིངས་འགྲོལ་དམག་གིས་བོད་ཀྱི་ལྷོ་ངོས་དང་རྒྱ་གར་ས་མཚམས་རྒྱུད་དུ་གཞི་རྒྱ་ཆེ་བའི་དམག་དཔུང་བསྐྲུན་མགོ་ཚུགས།",
    "བཅིངས་འགྲོལ་དམག་གིས་ཤར་གྱི་བྷོམ་དྷེ་ལ་བར་དུ་མར་དེད་ཅིང་།",
    "དམག་སྤྱི་ཨེ་སེ་ཨེ་སེ་ཨུ་བྷན་ནི་རྒྱ་གར་གྱི་དམག་ཁོངས་ནས་ཐོག་མར་བཙན་འཛུལ་དེའི་སྐོར་སྙན་གསན་ཞུས་པའི་གྲས་གཅིག་རེད།",
    "དེ་ནས་ཁོང་དམག་སྤྱིའི་ལས་བྱ་གཙོ་བོ་དང་ལྷན་དུ་རི་ངོགས་ཀྱི་རྩོད་རྙོག་ཡོད་ས་དེར་ཕྱིན་པ་རེད།",
    "དེར་ཁོང་ཚོས་རང་ཕྱོགས་ཀྱི་དམག་མི་རྣམས་ནི་བློ་སྤོབས་ཉམས་ཤིང་ཟིང་ཆའི་ནང་ཡོད་པ་མཐོང་བ་རེད།",
    "དམག་མི་ཚོ་ལ་མཚོན་ཆ་མི་འདུག་ལ་འགྲུལ་བཞུད་ཀྱི་མཐུན་རྐྱེན་མི་འདུག་ཧ་ཅང་གྲ་སྒྲིག་མེད་པ་ཞིག་རེད།",
    "ཧ་ཅང་ཐབས་སྡུག་གི་གནས་སྟངས་ཤིག་རེད།",
    "དེ་ནི་རྒྱ་གར་གྱི་དམག་མིའི་ནོར་འཁྲུལ་ཞིག་མ་རེད།",
    "ང་ཚོ་ལ་ས་མཚམས་རྒྱུད་དུ་སྲུང་སྐྱོབ་ཤུགས་ཆེན་པོ་བཟོ་དགོས་དོན་ཡོད་པ་མ་རེད་ཅེས་སློབ་སྟོན་བྱས་པ་རེད།",
    "ང་ཚོས་དབྱིན་ཇིའི་ཁ་ལ་ཉན་པ་རེད་ལ།",
    "ལོ་གཅིག་གི་གོང་ལ་ང་རང་ས་མཚམས་ལ་བལྟ་སྐོར་བྱེད་དུ་སོང་ཞིང་།",
    "རྒྱ་གར་ས་མཚམས་བརྒལ་ནས་སླེབས་ཟིན་པའི་བོད་མི་བཙན་བྱོལ་བ་སྟོང་ཕྲག་མང་པོ་ལས་མེད་དུ་ཡོད་པ་རེད།",
    "ཐབས་ལམ་ཡག་ཤོས་ནི་ཁོང་ཚོ་གླས་ནས་བཟོ་ལྟ་ཡག་པོ་བཟོ་རྒྱུ་དེ་རེད།",
    "ཁོང་ཚོས་ང་ཚོ་ལ་གནས་ཚུལ་གལ་ཆེ་བ་དེ་འདྲ་ཅོ་སྤྲོད་དང་སྙན་གསན་ཞུ་ཐུབ་གི་རེད།",
    "དེ་ནས་རྒྱ་གར་གྱི་དམིགས་བསལ་མཐའ་མཚམས་དམག་དཔུང་གི་མགོ་འཛུགས་དེ་རེད།",
    "བོད་མི་ཚོར་ས་མཚམས་འཛིན་བཅུག་ནས་གུང་ཁྲན་ཚུར་ཡོང་རྩིས་བྱེད་མཁན་རྣམས་འགོག་རྒྱུ་དེ་རེད།",
    "སྟབས་ཉེས་པ་ཞིག་ལ་སྔེ་ཚན་༢༢དེ་ནི་རྒྱ་མིས་བཙན་འཛུལ་བྱས་པའི་སྐབས་དེར་ད་དུང་ཡང་སེམས་ནང་གི་འཆར་གཞི་ཙམ་ཞིག་རེད།",
    "ནེ་ཧ་རུ་དང་བདེ་སྲུང་བློན་ཆེན་མེ་ནོན་གཉིས་ཀྱིས་ཆབ་སྲིད་ཀྱི་ཡ་ལན་ཟུག་གཟེར་ཆེན་པོ་ཞིག་བླངས་པ་རེད།",
    "དེ་ནི་ཁོའི་ལས་ཀའི་བརྒྱུད་རིམ་ཁྲོད་ཀྱི་ངོ་ཚ་ཆེ་ཤོས་ཤིག་ཏན་ཏན་ཡིན་པ་རེད་ལ།",
    "ནེ་ཧ་རུ་ཡིས་ཨ་མི་རི་ཀ་ལ་རོགས་རམ་གྱི་ཆེད་དུ་ཞུ་བ་འཐེན་པ་རེད་ལ།",
    "མེ་ནོན་ངོ་ཚ་ནས་དགོངས་པ་ཞུས་པ་རེད།",
    "དེའི་རྗེས་ཀྱི་ཉི་མ་དག་གི་རིང་ལ།",
    "སུབ་ཊེ་ར་མ་ཡམ་གྱིས་མེག་ཀར་ཐེ་ཨག་རཱའི་གནམ་དམག་གི་ལྟེ་བ་དེར་འཁྲིད་ཅིང་།",
    "ཁོང་ཚོས་ཨག་རཱ་རུ་དུས་ཚོད་མཉམ་དུ་བསྐྱལ་བའི་སྐབས་དེ་ལ་ཁོང་གཉིས་ཀྱིས་རྒྱ་ནག་གི་ཉེན་བརྡ་དང་འབྲེལ་བའི་ལྟ་ཚུལ་བརྗེ་རེས་བྱེད་པའི་གོ་སྐབས་བྱུང་ཡོད་པ་རེད།",
    "དེའི་རྐྱེན་བྱས་ཏེ་རྒྱ་དམག་རྣམས་རྒྱ་གར་གླིང་ཕྲན་དུ་འཛིང་རེས་གཅིག་ཀྱང་མ་བྱས་པར་ལས་སླ་བོར་ཡོང་བཅུག་པ་རེད་ཟེར།",
    "སུབ་ཊེ་ར་མ་ཡམ་གྱིས་དགའ་སྣང་གིས་ཉན་ཅིང་དེ་འབྲེལ་གྱི་དྲི་བ་རྣམས་གཅིག་རྗེས་གཉིས་མཐུད་ཀྱིས་བཏང་།",
    "མེག་ཀར་ཐེ་ཡིས་བོད་མི་ཚོས་དེ་འདྲའི་ཉེན་ཁ་ཅན་གྱི་ལས་དོན་ལ་མོས་མཐུན་བྱེད་ཀྱི་རེད་བསམས་ཡོད་དམ།",
    "ཁོང་ལྡི་ལི་རྙིང་པའི་ནང་གི་ཟ་ཁང་ཞིག་ཏུ་མུ་ལིག་ལ་ཐུག་པ་རེད།",
    "དེ་ནས་བསམ་ཡིད་ན་དེ་ཙམ་མེད་པའི་དོན་དག་ཅིག་བྱུང་བ་རེད།",
    "རྒྱ་མི་རྒྱ་གར་གྱི་ས་ཐོག་ནས་ཕྱིར་འཐེན་བྱས་པ་རེད།",
    "གཅིག་བྱས་ན་བཙན་འཛུལ་དེ་ནི་རྒྱ་གར་གྱི་ས་མཚམས་སྐོར་སྲུང་དམག་གི་ནུས་ཤུགས་ལ་ཚོད་བགམ་ཙམ་ཞིག་བྱེད་ཆེད་ཡིན་སྲིད།",
    "མང་པོ་བཟུང་བ་རྣམས་ཁོ་ཚོ་ཕྱིར་འཐེན་བྱེད་སྐབས་དེར་གློད་གྲོལ་བཏང་བ་རེད།",
    "རྒྱ་གར་ས་ཐོག་གི་མི་སུ་གཅིག་གིས་ཉེན་ཁ་ལས་ཡོལ་བ་རེད་བསམས་མེད་པ་རེད།",
    "ཨུ་བྷན་གྱིས་ཁམས་པ་རྣམས་གནམ་མཆོངས་རྒྱག་མཁན་ཞིག་ཡོང་རྒྱུར་དམིགས་བསལ་གྱིས་དོ་སྣང་བྱས་པ་རེད།",
    "གང་ལྟར་ཡང་རྒྱལ་ལོ་དོན་གྲུབ་ཀྱིས་ཨུ་བྷན་ལ་ཁམས་པ་གྱོང་པོ་རྣམས་ལག་འོག་ཏུ་འཛུད་ཐུབ་མིན་ཐད་དོགས་པ་བྱུང་བ་རེད།",
    "ཁོང་གིས་དམག་སྤྱི་འདི་ཟུར་ཞིག་ཏུ་འཁྲིད་ནས་ཉེན་བརྡ་བཏང་དོན།",
    "དེ་ལས་སླ་བོ་ཡོང་གི་མ་རེད།",
    "ལགས་རེད།",
    "ཁོང་ཚོའི་ངོ་གདོང་ནས་ང་ལ་ལྟ་སྟངས་དང་རྣམ་འགྱུར་སྟོན་སྟངས་ནས་ངས་དེ་མཐོང་གི་འདུག་ཡིན་ན་ཡང་།",
    "དེ་འགྲིག་འགྲོ་གི་རེད་བསམས་ཀྱི་འདུགལབ་པ་རེད།",
    "དེ་དངོས་གནས་རེད།",
    "ངས་ཁམས་པ་སྤྱོད་ངན་དེ་ལ་ཁང་པའི་ནང་ལ་འཛུལ་ཞིག་ཁྱེད་རང་གིས་ཉིན་གསུམ་རིང་ཟས་བཅད་བྱེད་དགོས།",
    "ཁྱེད་ཀྱིས་འདི་འདྲའི་ཅོལ་ཆུང་གི་ལས་ཀ་བྱེད་རྒྱུ་ཡིན་ནམ།",
    "དེ་ནི་ད་ལྟའི་ཆར་ཁོང་གིས་རྩིས་མེད་དུ་བྱེད་འོས་བསམས་ཡོད་པ་རེད།",
    "རྒྱ་གར་གྱི་དམག་མིའི་ཁོངས་ནས་ལོ་ན་༢༥ ཡན་སུ་ཡིན་གནམ་གྲུ་ནས་མཆོངས་འཇུག་གི་མ་རེད།",
    "ངའི་དཀའ་རྙོག་ནི་ཧ་ལམ་ངའི་བོད་མི་ཚང་མ་ལོ་སུམ་བཅུ་སོ་ལྔ་ཡན་རེད་ལ།",
    "ང་ནི་ལྔ་བཅུ་ང་གཉིས་རེད།",
    "ཨུ་བྷན་གྱིས་སེམས་ཁྲལ་མ་བྱེད་ཅེས་ལན་བཏབ་པ་རེད།",
