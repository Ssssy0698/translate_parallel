    "ཁོང་གིས་སྒོར་མོ་དེ་ཚོ་ཚང་མ་ཁོ་རང་སྒེར་ལ་ཉར་བ་རེད།",
    "ཁོང་གིས་དུས་རྒྱུན་ནས་དེ་ལྟར་བྱས་པའི་སྐབས་དེ་ལ་ང་ཚོ་ནི་ལྟོགས་ཤི་ཐེབས་གྲབས་ཡོད་རེད།",
    "ཟ་ཆས་སྐྱོ་བ་ལ་སྣོན་པ་རྒྱག་སླད་དུ་འབའ་བ་རྒན་ཡེ་ཤེས་ཀྱིས་དམག་མི་སྐོར་ཁག་འགའ་རེ་གཡག་དང་ལུག་བརྐུས་ནས་གློ་སྨོན་ཐང་དུ་ཚུར་དེད་ཡོང་ཕྱིར་བོད་དུ་བཏང་བ་རེད།",
    "བཙན་རྒོལ་པ་ཚོས་འཇབ་རྒོལ་བྱས་ཏེ་གྲགས་ཆེན་གྱི་ཀོ་སྒམ་དེ་འཕྲོག་ལེན་བྱས་པའི་རྗེས་སུ་ཨ་རིའི་གསང་ལས་ཀྱིས་གློ་སྨོན་ཐང་གི་གསང་བའི་ལས་འགུལ་ལ་རིན་ཐང་ཡོད་པ་དེར་ཡིད་ཆེས་ཆེས་ཆེར་སྐྱེས་ཤིང་།་",
    "གནམ་གཡུགས་གཏོང་བ་ཇེ་མང་དུ་བཏང་བ་ནང་བཞིན་དོ་པོའི་གསེབ་ཏུ་སྒོར་མོ་ཡང་ཇེ་མང་དུ་བཏང་བ་རེད།",
    "དེ་ནི་དཀའ་རྙོག་དངོས་གནས་མགོ་ཚུགས་པའི་དུས་རེད།",
    "དེ་ལྟར་བྱེས་པས་འགོག་རྒོལ་པ་ཚོས་ས་གནས་མི་མང་ནས་ཤ་རིགས་ཉོ་ཐུབ་གི་ཡོད།",
    "འབའ་བ་རྒན་ཡེ་ཤེས་ནི་ལྐོག་ཟ་བྱེད་མཁན་ཞིག་རེད།",
    "དེ་ནི་དེ་འདྲའི་ལས་སླ་བོའི་གནས་ཚུལ་ཞིག་རེད།",
    "ཉེས་ཁག་འགེལ་བ་གཞན་ཡང་ཐོན་པ་རེད།",
    "འབའ་བ་རྒན་ཡེ་ཤེས་ཀྱིས་རང་གི་མི་ལས་རྐུན་མ་རྒྱག་མགོ་བཙུགས་པ་རེད།",
    "རྒྱ་མི་ལས་བྲོས་ནས་གློ་སྨོན་ཐང་དུ་འབྱོར་མ་ཐག་པའི་བོད་མི་ཚོ་འབའ་བ་རྒན་ཡེ་ཤེས་ཀྱི་མིས་བཀག་ཅིང་ནང་དུ་འཛུལ་རྒྱུ་ལ་རིན་པ་བླངས་པ་རེད།",
    "སྤྱིར་བཏང་བྱས་པ་ཡིན་ན་རྒྱན་ཆའི་རིགས་དང་སྐུ་རྟེན་རིགས་རེད།",
    "དེར་དགུན་ཐོག་གྲང་ངར་ཆུང་བ་ཡོད་རེད།",
    "ཁོས་རྒྱ་ཆེ་ཞིང་མཐུན་རྐྱེན་ལེགས་པའི་ཁང་པ་ཞིག་རང་ཉིད་སྒེར་དང་རང་གི་སྐུ་སྲུང་བ་ཚོའི་ཆེད་དུ་བརྒྱབ་པ་རེད།",
    "རང་ཉིད་ཀྱི་བདེ་ཐང་གཏན་འཁེལ་བྱས་ཟིན་པའི་མཚམས་དེར་ཁོ་མཐོང་རྒྱུ་ཡང་ཇེ་ཉུང་དང་ཇེ་ཉུང་དུ་སོང་བ་རེད།",
    "དམག་སྤྱིས་སྒོམ་རྒྱག་གི་ཡོད་སྟབས་བར་ཆད་གཏོང་མི་རུང་བ་རེད།",
    "དེ་ཚོ་ཚང་མ་རྫུན་མ་རེད།",
    "ཁོང་ནང་པ་ཡག་པོ་ཞིག་མ་རེད།",
    "ཁོས་ས་མཚམས་བརྒལ་ནས་ཡོང་བའི་སྐྱབས་བཅོལ་བ་ཚོ་ལས་རྐུན་མ་བརྒྱབ་པ་རེད།",
    "ཡ་གི་ལ་ཟིང་ཆ་ལངས་པ་རེད།",
    "མི་གཞན་དྲུག་བཅས་གནས་སྤོར་བྱས་ཤིང་རང་ངོས་ཀྱི་སྒར་ཞིག་བཙུགས་པ་རེད།",
    "ཁོས་ཁོང་བཙལ་ཏེ་གསོད་རྒྱུའི་ཆེད་དུ་རཱ་རཱ་འདི་སྐད་གྲགས་ཅན་གྱི་ཀོ་སྒམ་འཕྲོག་མཁན་དེ་རེད།",
    "༥་ཀར་ནོར་འཛོལ་གྱི་སྐྱོན་བརྗོད་རྣམས་འཕེལ་ཞིང་བལ་ཡུལ་གྱི་ཀཱ་ལི་གཱན་ཌཱ་ཀི་ལུང་པའི་ནང་ནས་མར་སོང་ཞིང་།",
    "མཐའ་མ་དེར་ཝ་ཤིན་ཊོན་དུ་འབྱོར་བ་རེད།",
    "ཁོས་མུ་མཐུད་ནས་རང་གི་སྒར་དུ་བདེ་སྐྱིད་ལ་རོལ་ཅིང་།",
    "ད་དུང་ཡང་འཕེལ་བཞིན་པའི་ཚོགས་པ་ཞིག་རེད།",
    "དེ་ནས་བོད་ནང་དུ་རྐང་བགྲོད་བྱེད་རྒྱུ་རེད།",
    "ཁོང་ཚོའི་དམིགས་ཡུལ་ནི་གསང་གནས་འཚོལ་བསྡུ་བྱེད་རྒྱུ་དེ་རེད།",
    "བོད་ཀྱི་ས་ཆ་གང་ཞིག་ཏུ་བཅིངས་འགྲོལ་དམག་གིས་ཧ་ཅང་དམིགས་པ་གཏོད་ཀྱི་ཡོད་པ་དང་།",
    "ད་ལྟའི་ཆར་བཅིངས་འགྲོལ་དམག་གིས་ལས་དོན་གང་དག་བྱེད་ཀྱིན་ཡོད་པ།",
    "ཁོང་༡༩༦༥ལོའི་སྟོན་མཇུག་ཏུ་ལྡི་ལི་ལ་འབྱོར་པ་རེད།",
    "འཆི་མེད་ཀྱི་མི་ལྔ་ཅན་གྱི་རུ་ཁག་དེ་ཨཱ་སམ་གྱི་པད་མ་བཀོད་ནས་བོད་དུ་གསང་འཛུལ་བྱས་པ་རེད།",
    "བོད་ནང་དུ་སླེབས་མཚམས་བྱང་ནུབ་ཏུ་གཏད་ནས་ཀོང་པོའི་ནང་ཕྱིན་པ་རེད།",
    "ཁོང་ཚོ་བརྒྱུད་པའི་རི་རྒྱུད་དག་ནི་ཤིང་ནགས་ཡིན་ལ་གནམ་གཤིས་ཚ་བོ་ཡོད་པ་རེད།",
    "ཤིང་སྡོང་དང་ལྗོན་ཤིང་མང་པོ་ཡང་དེ་བཞིན་རེད།",
    "དོམ་དང་སྟག་རྣམས་ནི་ཉེན་ཁ་འཕར་མ་རེད།",
    "འཆི་མེད་ཀྱི་རུ་ཁག་གིས་མེ་མདའ་འཁྱེར་ཡོད་ན་ཡང་།",
    "ཁོང་ཚོ་གང་དུ་ཡོད་མེད་རྒྱ་མིས་ཤེས་སུ་མི་འཇུག་རྒྱུའི་ཆེད་དུ་བེད་སྤྱོད་བྱེད་རྒྱུར་འཚེར་པོ་བྱས་པ་རེད།",
    "རུ་ཁག་དེ་ལྷམ་མེད་པར་ཕྱིན་པ་རེད།",
    "ཟ་ཆས་དེ་བློ་འཚབ་ལངས་པ་ཞིག་རེད།",
    "དེ་ནི་ཁོའི་མི་ཚེའི་ནང་གི་ལོ་སྡུག་ཤོས་དེ་ཡིན་པ་རེད།",
    "ང་ཚོ་བོད་ཀྱི་བྱང་དུ་ཐག་རིང་ས་ལ་འགྲོ་ནུས་མ་སོང་།",
    "དེ་བས་ང་ཚོས་ཀྱང་བོད་མི་སུ་འདྲ་ཞིག་ལ་འབྲེལ་བ་བྱས་པ་དེར་ཧ་ཅང་གཟབ་གཟབ་བྱེད་དགོས་བྱུང་།",
    "གནམ་མཆོངས་དམག་མི་ཁོ་ན་ལ་དེ་ཚོ་ཡོད་པ་རེད།",
    "ཁོང་ཚོ་ནི་ཕལ་ཆེར་འདྲི་རྩད་བྱས་ཤིང་གཅར་རྡུང་བྱས་ཏེ་བསད་ཡོད་པ་རེད།",
    "དེས་ང་ཚོ་གསུམ་ལས་ལྷག་མ་སོང་།",
    "གལ་སྲིད་རྒྱ་མིས་ང་ཚོ་འཛིན་གྲབས་བྱས་པ་ཡིན་ན།",
    "ང་ཚོ་ཕན་ཚུན་ཐོག་འཁོར་ནས་དུས་གཅིག་ལ་ཕན་ཚུན་ལ་མེ་མདའ་རྒྱག་རྒྱུ་ཡིན་ཞེས་ང་ཚོས་དམ་བཅའ་བཞག་པ་ཡིན།",
    "ང་ཚོ་ཚང་མས་ང་ཚོ་ཤི་གི་རེད་བསམས་ཀྱིན་ཡོད།",
    "དམིགས་བསལ་གྱིས་དུས་ཚོད་དེ་ལ་ང་ཚོས་ནོར་འཁྲུལ་བྱེད་ས་ཞིག་གཏན་ནས་ཡོད་མ་རེད།"
  ]
}