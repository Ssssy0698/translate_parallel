    "འགལ་བ་མེད་པའི་ཕྱིར་ན་རྒོལ་བ་ལ་ཕན་པ་ཆེན་པོས་བྱས་པས་ན་བསྟན་བཅོས་བྱེད་པའི་ཉེས་པ་ཡང་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་སྒྲ་ནི་རྟག་སྟེ་བྱས་པའི་ཕྱིར་རོ།",
    "གང་བྱས་པ་དེ་ནི་མི་རྟག་པ་ཡིན་ནོ་ཞེས་བྱ་བར་འདིར་འགལ་བ་བརྩད་པ་ཡིན་ན།",
    "དེའི་ཚེ་སྨྱོན་པ་མ་ཡིན་པ་སུ་ཡང་དེ་ཉིད་ཀྱི་ཚེ་རྟག་པ་ཉིད་དུ་དམ་བཅས་ནས་མི་རྟག་པ་ཉིད་ཀྱིས་ཁྱབ་པ་ཉེ་བར་སྟོན་པར་བྱེད་པ་ནི་མེད་དོ།",
    "འོན་ཏེ་རྟག་པ་ཉིད་ཀྱིས་ཁྱབ་པ་ཉེ་བར་སྟོན་པར་བྱེད་ན།",
    "དེའི་ཚེ་ཁྱབ་པ་ཕྱིན་ཅི་ལོག་ཉིད་ལས་འགལ་བ་ཉིད་དུ་རྟོགས་པར་འགྱུར་རོ།",
    "ཕྱིར་རྒོལ་པས་སྐབས་བྱས་སོ་ཞེ་ན།",
    "དེ་སྒྲུབ་པར་བྱེད་པའི་ཡན་ལག་ཡིན་ན།",
    "དམ་བཅའ་བ་སྒྲུབ་པར་བྱེད་པའི་ཡན་ལག་ཡིན་པའི་བཟློག་པ་ཉིད་དོ།",
    "སྒྲུབ་པར་བྱེད་པའི་ཡན་ལག་མ་ཚང་བར་འགྱུར་ན།",
    "དམ་བཅས་པར་ནི་སྒྲུབ་པར་བྱེད་པའི་ཡན་ལག་མ་ཡིན་ཏེ།",
    "མ་བསྟན་མ་ཚང་ཡིན་པར་བརྗོད།",
    "མཁོ་བ་མེད་པ་རྣམས་མཐའ་མེད་པས་མ་ཚང་བ་མེད་པས་མ་ཚང་བ་མེད་པ་ཉིད་མེད་པར་འགྱུར་རོ།",
    "བརྩད་པར་མི་བྱའོ།",
    "གལ་ཏེ་དམ་བཅའ་བ་སྒྲུབ་པར་བྱེད་པ་ཁས་ལེན་ན།",
    "དེའི་ཚེ་དམ་བཅས་པ་ནི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པའོ་ཞེས་བྱ་བ་དམ་བཅའ་བའི་མཚན་ཉིད་ཧ་ཅང་ཁྱབ་ཆེས་པར་འགྱུར་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་མ་གྲུབ་པ་ཡིན་ཡང་སྒྲུབ་པར་བྱེད་པར་འགྱུར་བའི་ཕྱིར་མ་གྲུབ་པའི་གཏན་ཚིགས་བརྗོད་པ་ཡང་དམ་བཅའ་བར་འགྱུར་རོ།",
    "གང་ཞིག་དམ་བཅས་པ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པ་དེ་ལ་ནི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཞེས་བྱ་བ་དམ་བཅའ་བའི་མཚན་ཉིད་ཡིན།",
    "སྒྲུབ་པར་བྱེད་པར་གྱུར་པ་མ་ཡིན་པའི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པར་དམ་བཅའ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྒྲུབ་པར་བྱེད་པ་ཡིན་ན་ནི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པར་མི་འགྱུར་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཉིད་མེད་པས་དམ་བཅའ་བའི་མཚན་ཉིད་མེད་པའི་ཕྱིར་གཏན་ཚིགས་ལྟར་སྣང་བ་བསྟན་པ་ནི་དམ་བཅས་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་དམ་བཅའ་བ་ཡིན་གྱི།",
    "སྒྲུབ་པར་བྱེད་པ་བསྟན་པ་མ་ཡིན་པའི་ཕྱིར།",
    "བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཞེས་བྱ་བ་འདི་ལ།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བསྟན་པ་སྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཡིན་ན་ནི།",
    "དེའི་ཚེ་སྒྲུབ་པར་བྱེད་པ་ལྟར་སྣང་བ་དམ་བཅའ་བར་མི་འགྱུར་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བསྟན་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་བསྟན་པར་བྱ་བ་མ་བསྟན་པར་འགྱུར་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བསྟན་པ་ཞེས་བྱ་གང་བསྟན་པ་ཡིན་པ་མི་ཤེས་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་ཡང་ཅི་ལྟར་བསྟན་ཞེས་སྐབས་མ་བསྟན་པའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུའམ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་ཞེས་ཁྱད་པར་མེད་པའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པ་ལྟར་སྣང་བ་ཡང་དམ་བཅའ་བ་ཉིད་དུ་འགྱུར་རོ།",
    "ཅི་ལྟར་ན་ལྔ་པའམ་གཞན་གྱིས་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུའམ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བསྟན་ཞེས་བརྗོད་པར་བྱ།",
    "ལྔ་པ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་དང་པོས་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བསྟན་པ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་དེ་ལྟ་ན་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཞེས་དམ་བཅས་པའི་མཚན་ཉིད་མི་བྱ་བར་འགྱུར་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཉིད་དུ་དམ་བཅས་པ་ཡིན་ནོ་ཞེས་འཇིག་རྟེན་ན་ཡང་སྒྲའི་དོན་དུ་གྲགས་པ་ཡིན་ནོ།",
    "ཕྱོགས་ཀྱི་མཚན་ཉིད་ནི་ལོག་པར་རྟོགས་པ་བསལ་བའི་དོན་དུ་ཡིན་ནོ་ཞེས་འཆད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཉིད་དམ་བཅའ་བ་ཡིན་པའི་ཕྱིར་མཚན་ཉིད་དོན་མེད་པས་ན།",
    "བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ནི་དམ་བཅའ་བ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "ཁྱེད་ཀྱི་ཕྱོགས་ལ་ཡང་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་དམ་བཅའ་བ་ཉིད་ཡིན་པས་ཇི་ལྟར་གཏན་ཚིགས་ལྟར་སྣང་བ་དམ་བཅའ་བ་མ་ཡིན་ཞེ་ན།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་མ་གྱུར་པའི་བསྒྲུབ་བྱ་བསྟན་པ་ཞེས་བྱ་བས་དེ་སྤངས་པ་མ་ཡིན་ནམ།",
    "གལ་ཏེ་སྒྲུབ་པར་བྱེད་པར་གྱུར་པ་ཡང་བརྒྱ་ལ་འགྱུར་རོ་ཞེ་ན།",
    "ཁྱད་པར་མེད་པར་བརྗོད་ན་ཡང་།",
    "གལ་ཏེ་དེ་ལྟ་ན་སྒྲུབ་པར་བྱེད་པར་འགྱུར་བ་མ་ཡིན་པའི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་དམ་བཅའ་བ་ཡིན་པའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པ་ལྟར་སྣང་བ་ཡང་དམ་བཅའ་བར་མི་འགྱུར་རོ་ཞེས་བྱ་བ་འདི་འགྲུབ་པོ།",
    "སྒྲུབ་པར་བྱེད་པར་གྱུར་པའི་བསྒྲུབ་བྱ་བསྟན་པ་དམ་བཅའ་བ་ཡིན་ནོ།",
    "སྒྲུབ་པར་བྱེད་པ་ལྟར་སྣང་བ་ནི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་ནི་དམ་བཅས་པ་མ་ཡིན་ཏེ།",
    "དམ་བཅའ་བ་ནི་སྒྲུབ་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "གལ་ཏེ་མ་གྲུབ་པ་ཉིད་ཀྱིས་སྒྲུབ་པར་བྱེད་པ་ལྟར་སྣང་བ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ན་མ་གྲུབ་པའི་དོན་གྱིས་དམ་བཅའ་བ་ཡང་ཅི་ལྟར་སྒྲུབ་པར་བྱེད་པར་འགྱུར།",
    "དམ་བཅའ་བ་ནི་མ་གྲུབ་པ་ཉིད་ཀྱིས་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་དེ་ལྟར་ན་སྒྲུབ་པར་བྱེད་པར་སྣང་བ་ཡང་དམ་བཅའ་བ་ཉིད་ཀྱིས་སྒྲུབ་པར་བྱེད་པར་འགྱུར་བའི་མི་ཟློགས་པ་ཉིད་དོ།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་ཀྱིས་ནི་འདི་ལྟར་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན།",
    "དོན་དང་ལྡན་པ་སྒྲུབ་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ནི་དེའི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ལ།",
    "སྒྲའི་ཕུར་མ་ཙམ་ཡང་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཐམས་ཅད་དུ་བརྗོད་པར་བྱ་བ་སྒྲུབ་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་དེ་ཉིད་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "འོ་ན་དམ་བཅས་པ་ཐམས་ཅད་ཕྱི་རོལ་གྱི་དོན་སྟོན་པས་ནུས་པའི་ཕྱིར་དེ་ཉིད་ཀྱིས་བསྒྲུབ་བྱ་འགྲུབ་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་དངོས་དང་བརྒྱུད་པས་དེ་ལ་གྲུབ་པ་མི་སྐྱེ་བའི་ཕྱིར་དམ་བཅའ་བ་ནི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "གཞན་དག་བརྗོད་པ་ནི་དམ་བཅས་པའི་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ལྟར་སྣང་བ་དང་བཅས་པ་ཉིད་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་དང་ལྷན་ཅིག་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "སུན་འབྱིན་པར་སྨྲ་བས་བརྗོད་པ།",
    "སུན་འབྱིན་པ་མ་ཡིན་པར་གྱུར་པ་ཞེས་ལན་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་ཐམས་ཅད་ནི་མི་རུང་སྟེ།",
    "ཅི་ལྟར་རུང་བའི་ཁྱད་པར་གྱིས་ནི་མ་ངེས་པ་སྤོང་བ་མ་ཡིན་ཏེ།",
    "རྒྱས་པ་འདོན་པས་མ་ངེས་པར་བརྩང་བ་ན།",
    "རིག་བྱེད་ཀྱི་ཁྱད་པར་ཅན་ཡིན་པའི་ཕྱིར་རོ་ཞེས་ལན་བརྗོད་ན།",
    "རིག་བྱེད་ལ་ཁྱད་པར་ཅི་ཞིག་ཡོད།",
    "གང་ཞིག་གཞན་དུ་འདོན་པར་མི་ནུས་པའོ་ཞེ་ན།",
    "མི་མཐུན་པའི་ཕྱོགས་དང་འགལ་བ་མེད་པའི་ཁྱད་པར་གྱིས་ནི་དེ་ལས་གཏན་ཚིགས་བཟློག་པར་མི་ནུས་སོ།",
    "དེ་ལྟ་མ་ཡིན་ན་དེ་ལྟ་བུ་མ་ཡིན་པ་ཞེས་བྱ་བ་སུས་བརྗོད་པར་མི་ནུས།",
    "གལ་ཏེ་འོ་ན་དམ་བཅའ་བ་ངེས་པར་བསྟན་པར་བྱ་བ་མ་ཡིན་ན།",
    "བསྒྲུབ་པར་བྱ་བའི་དོན་ནི་གཏན་ཚིགས་ཀྱི་ནུས་པས་གོ་བར་བྱ་བ་ཉིད་ཡིན་པས་དེ་ཕྱོགས་ཡིན་ནམ་དེ་ལྟ་མ་ཡིན་ཡང་རུང་སྟེ་དཔྱད་པ་འདིས་ཅི་བྱ་སྟེ།",
    "དེ་ལ་བསྒྲུབ་པར་བྱ་བ་དང་ཅིག་ཤོས་ཀྱི་ཡུལ་ལ།",
    "ཆེན་པོ་རྣམས་ཀྱང་ཕྱིན་ཅི་ལོག་ཏུ་ལོག་པར་རྟོགས་པ་ཆེན་པོ་ཡོད་ལ།",
    "དེ་མ་བཟློག་ན་ཡང་དོན་མ་ཡིན་པའི་སྒོ་ནས་ཆེན་པོའི་ཚུལ་སྐྱེད་པར་བྱེད་དོ།",
    "དམ་བཅའ་བ་ནི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པའོ་ཞེས་བྱ་བའི་མཚན་ཉིད་འདིས་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་ལ་ཡང་ཕྱོགས་ཉིད་དུ་འགྱུར་རོ་ཞེས་བྱ་བར་ཡང་རྟོགས་པ་དང་།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་ཞེས་ལོག་པར་རྟོགས་ཏེ།",
    "སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པ་དང་།",
    "རྒོལ་བས་ཁས་བླངས་པ་གཟུང་བར་རིག་པར་བྱའོ།",
    "མ་གྲུབ་པ་ཁོ་ན་བསྒྲུབ་པར་བྱ་བ་ཡིན་ལ་དེ་བཞིན་དུ་གཞན་ཡང་སྟེ།",
    "དེས་ན་ངེས་པར་གཟུང་བས་ཕྱིན་ཅི་ལོག་དེ་གསལ་བར་རིག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་གལ་ཏེ་དེ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན།",
    "སྐབས་མི་ཤེས་པས་ནི་བརྗོད་པར་འདོད་པའི་དོན་མི་རྟོགས་པའི་ཕྱིར་དེ་དང་ལྷན་ཅིག་ཏུ་ཐ་སྙད་ཀྱི་ལམ་དུ་ཅི་ལྟར་འཇུག།",
    "དངོས་སུ་བརྗོད་པའི་དོན་ནི་ཕྱུགས་ཀྱིས་ཀྱང་འཛིན་པས་དེ་ལ་ནུས་པ་ཁྱད་པར་དུ་འཕགས་པ་ཅི་ཡོད་ཅེའོ།",
    "བསྒྲུབ་པར་བྱ་བ་ཡང་གཞན་ཡིན་ན་ནི།",
    "གལ་ཏེ་ཡང་གཞན་ཙམ་ཞིག་སྒྲུབ་ན་དེའི་སྐབས་སུ་བབ་པ་མ་བསྒྲུབས་པར་འགྱུར་པ་འམ།",
    "གྲུབ་པ་ལ་བསྒྲུབས་པར་འགྱུར་རོ།",
    "འོ་ན་ནི་དེ་བཞིན་མི་འདོད་པ་བཟློག་པའི་ཕྱིར་ཡང་ཡིན་པར་འགྱུར་ཏེ།",
    "འདི་ནི་དེའི་དོན་བྱས་པ་ཡིན།",
    "བསྟན་བཅོས་བྱེད་པའི་འདོད་པ་ལ་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་པར་དོགས་པ་ཉིད་དེ།",
    "བསྟན་བཅོས་བྱེད་པའི་འདོད་པ་ནི་གདོན་མི་ཟ་བ་ཉིད་དུ་རྒོལ་བའི་ཡང་ཡིན་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བློར་འགའ་ཞིག་འགྱུར་ཏེ།",
    "གལ་ཏེ་བསྒྲུབ་བྱ་ཉིད་ཡིན་ན་ཅི་ལྟར་ཁྱད་པར་དུ་འགྱུར་བསྒྲུབ་པར་བྱ་བ་དང་ཁྱད་པར་དག་གཅིག་པ་ནི་མ་ཡིན་ནོ།",
    "འདོད་པས་ཡུལ་དུ་བྱས་པའི་བསྒྲུབ་བྱ་དེ་ནི་གཞན་ལ་ལྟོས་ཏེ།",
    "དེ་ཡི་ཁྱད་པར་ཡིན་པར་འགྱུར།",
    "གལ་ཏེ་བསྒྲུབ་བྱ་མ་ཡིན་ན་ནི་དེ་ཉིད་ཀྱི་ཁྱད་པར་ཡིན་པའི་ཕྱིར་ཁྱད་པར་དང་འགལ་བར་འགྱུར་རོ།",
    "བསྒྲུབ་བྱ་ཉིད་ཅིའི་ཕྱིར་སྒྲུབ་པར་མི་བྱེད་ཅེ་ན་མ་ཡིན་ཏེ།",
    "གཞན་ལ་ལྟོས་ནས་ལན་འདེབས་པར་བཞེད་པའི་ཕྱིར་ཏེ།",
    "ད་ནི་ཅི་ལྟར་མ་བརྗོད་པ་ཡང་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་བརྗོད་པ་ཉིད་ཡིན་ཏེ།",
    "མ་བརྗོད་པ་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་ཐམས་ཅད་བསྒྲུབ་པར་བྱ་བར་འགྱུར་ན།",
    "ཐམས་ཅད་དཔེ་ལ་ཉེ་བར་བསྟན་པར་ནུས་པ་ནི་མ་ཡིན་ནོ།",
    "སྐབས་ལས་རྟོགས་པར་འགྱུར་བ་ཡིན།",
    "གལ་ཏེ་འདིས་དེ་ཉིད་སྨྲས་པ་ཡིན་པ་དེ་ལྟ་ན་ཡང་སྐབས་ཀྱི་འདིར་དོན་ནི་འདི་ཡིན་པར་ལྟའོ།",
    "ཚིག་ཐམས་ཅད་སྐབས་ལ་མ་ལྟོས་པར་ནི་དོན་སྟོན་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "ངག་དོན་ངེས་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བསྒྲུབ་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེས་ནི་དེའི་འདོད་པ་ཕྱིན་ཅི་ལོག་ཏུ་གྲུབ་པས་ན་འདི་འདོད་པ་ལ་གནོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་སྐབས་སུ་བབ་པའི་དོན་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ཅི་ལྟར་ཤེས་ཤེ་ན།",
    "འགའ་ཡང་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་པར་འགྱུར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་པའི་ཡུལ་ལ་ནི་ཕྱིར་རྒོལ་བས་རྗེས་སུ་འགྲོ་བ་མེད་པའི་སྐྱོན་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "རྗེས་སུ་འགྲོ་བ་མེད་པ་ལ་སོགས་པའི་སྐྱོན་ནི་བསྒྲུབ་པར་བྱ་བ་ལ་ལྟོས་པ་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "ཉེ་བའི་ཁྱད་པར་མེད་ན་འགའ་ཞིག་ནི།",
    "གལ་ཏེ་གཞན་བསྒྲུབས་པས་ཀྱང་གཞན་འགྲུབ་པར་འགྱུར་ན་ནི་དེའི་ཚེ།",
    "འདོད་པ་བཞིན་དུ་ཕྱིན་ཅི་ལོག་ཀྱང་འགྲུབ་པར་འགྱུར་རོ།",
    "གཏན་ཚིགས་ཐམས་ཅད་འགལ་བ་དང་དཔེ་བསྒྲུབ་བྱས་སྟོང་པར་འགྱུར་ཏེ།",
    "འདོད་པའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་དེ་ཉིད་འགྲུབ་ཀྱི་གཞན་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "འདོད་པར་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་འགལ་བ་ནི་མ་བརྗོད་པ་ཉིད་ལ་ལྟོས་ནས་ཡིན་གྱི་གཞན་དུ་ནི་མེད་པའི་ཕྱིར་རོ།",
    "བསྟན་པ་ཡིན་ནོ་ཅི་སྟེ་ཡང་བསྒྲུབ་པར་བྱ་བ་སྤྱིར་འདོད་ན།",
    "བརྗོད་བྱས་སྟོང་པའི་རྗོད་བྱེད་རྣམས།",
    "གཉིས་པ་དང་བཅས་པར་བསྒྲུབ་པའི་སྦྱོར་བ་རྣམས་ལ་རྗེས་སུ་འགྲོ་བ་མེད་པའི་ཉེས་པ་དང་།",
    "རྗེས་སུ་དཔག་པ་ཉིད་སྒྲུབ་པར་བྱེད་པ་ཡིན་པས་གཏན་ཚིགས་བརྗོད་དོ་ཞེའོ།",
    "བསམ་པ་ནི་སྐྱེས་བུ་དེ་ལྟ་བུ་ནི་མཛུབ་ཚུགས་སུ་སྒྲུབ་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "བསྒྲུབ་བྱ་སྒྲུབ་པར་བྱེད་པ་ནི་ཐབས་ཡིན་ནོ།",
    "འདི་ལ་སྤྱི་འམ་ཁྱད་པར་གང་།",
    "བསྒྲུབ་པར་བྱ་བ་དེ་ཉིད་དེ།",
    "འདི་ལྟར་སྒྲས་ཟིན་པ་ནི་སྐྱེས་བུ་ཉིད་ཡིན་པས་དེ་ལ་ལྟོས་ནས་རྗེས་སུ་འགྲོ་བ་མེད་པར་འགྱུར་རོ་ཞེས་རིགས་པ་སྔ་མ་ཉིད་དོ།",
    "དེ་བསྒྲུབ་པར་བྱ་བ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "འདིར་ཁྱད་པར་ཕངས་པ་མེད་པ་ལ་མ་ཡིན་ནམ་ཞེ་ན།",
    "གང་ཡང་རུང་བའི་སྒྲ་ནི་རྣམ་པར་རྟག་པ་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "གཞན་ཉེ་བར་བཀོད་པ་མེད་པར་ནི་གང་ཡང་རུང་བའི་སྒྲ་འཇུག་པ་མི་སྲིད་དོ།",
    "སྣམ་བུ་དང་བུམ་པ་གང་ཡང་རུང་བས་གཉིས་པ་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་ཉིད་རྗོད་པར་འགྱུར་ཏེ།",
    "དེ་ལ་སྒྲུབ་པར་བྱེད་པར་སྨྲ་བའི་བསམ་པས་ནི་འདི་ཡིན་ཏེ།",
    "དེ་མི་འཕེན་ན་སྒྲུབ་པར་བྱེད་པའི་འབྲས་བུ་ཅི་ཡིན་ཏེ།",
    "ཡང་ན་ནི་མི་འདོད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་གཉི་གར་བུམ་པའི་རིགས་བསྟན་པ་ནི་ཤུགས་ཀྱི་སྐྱེས་བུ་ཉིད་ཀྱིས་གཉིས་པ་དང་བཅས་པར་བསྟན་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་དུ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་ཡང་འདིར་སྐྱེས་བུ་ཉིད་ངེས་པར་བརྗོད་པར་འདོད་པ་ཡིན་པའི་ཕྱིར་གང་ཡང་རུང་བ་སྨོས་པ་ནི་དོན་མེད་དོ།",
    "ཤུགས་ཀྱིས་ངེས་པར་འཐོབ་འགྱུར་ཞིང་།",
    "ངེས་པ་དང་ནི་རྣམ་པར་བརྟག།",
    "གཉི་གར་བུམ་པ་ཉེ་བར་བཀོད་པས་ནི་བུམ་པའི་རིགས་རང་ཉིད་ཀྱིས་གཉིས་པ་དང་བཅས་པར་འགལ་བའི་ཕྱིར།",
    "ཤུགས་ཀྱིས་སྐྱེས་བུ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན།",
    "ཅི་ལྟར་དེ་ལས་བཟློག་པ་སྒྲུབ་པར་བྱེད་པ་གང་ཡང་རུང་བ་བརྗོད།",
    "བརྗོད་པར་འདོད་པ་ལ་ལྟོས་པའི་སྒྲུབ་པར་བྱེད་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བསྟན་ཟིན་པའི་ཕྱིར་རོ།",
    "ཚོན་པོ་ཉིན་པར་མི་ཟ་ཞེས།",
    "དེ་སྐད་བརྗོད་པར་གྱུར་པ་ན།",
    "ལོག་པར་བརྗོད་པའང་སྲིད་ཕྱིར་རོ།",
    "ཅི་ག་སྒྲའི་མི་རྟག་པ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནམ།",
    "དེ་བཞིན་དུ་བྱས་པ་ཉིད་ཀྱང་ངོ།",
    "འོན་ཏེ་འདི་ནི་རྣམ་པར་རྟོག་པ་དང་མཚུངས་པ་ཡིན་ནོ་ཞེ་ན།",
    "སྒྲ་དང་བུམ་པའི་ཁྱད་པར་གྱི།",
    "བུམ་པའང་དེ་དང་ལྡན་པར་འགྱུར།",
    "དེ་བཞིན་དུ་ཇི་ལྟར་ཕྱོགས་དང་མཐུན་པའི་ཕྱོགས་གང་ཡང་རུང་བ་ཉིད་དེ་བཞིན་དུ་བྱས་པ་ཡང་ངོ་ཞེས་བྱ་བ་ཡང་ངོ།",
    "གལ་ཏེ་གྲུབ་ཀྱང་དེ་ནི་གཞན་ཉིད་ཡིན་པ་དེས་ན་ཇི་ལྟར་སྒྲ་མི་རྟག་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་འདིར་ཡང་མི་རྟག་པ་ཉིད་ཀྱི་སྤྱི་ཚིག་ཏུ་སྨོས་ཀྱང་མཐར་གཏུགས་པའི་དོན་ནི་སྒྲ་ལ་གནས་པའི་ཁྱད་པར་ཉིད་ཡིན་ལ།",
    "མི་རྟག་སྒྲ་ཡི་ཁྱད་པར་ཅན།",
    "རྗེས་འགྲོ་མེད་པར་འགྱུར་མ་ཡིན།",
    "གལ་ཏེ་མི་རྟག་པ་ཉིད་ཁྱད་པར་ཅན་རྗེས་སུ་འགྲོ་བ་མ་ཡིན་པ་དེ་ལྟ་ན་ཡང་རྗེས་སུ་འགྲོ་བས་ཁྱད་པར་ཅན་དུ་འགྱུར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་ཚོགས་པ་ཡིན་ཏེ།",
    "དེ་གལ་ཏེ་སྔར་གྲུབ་ན་སྒྲུབ་པར་བྱེད་པའི་དོན་ཅི་ཡིན་དེའི་ཕྱིར་འབའ་ཞིག་རྗེས་སུ་འགྲོ་བས་ན།",
    "མི་རྟག་པ་སྒྲ་ལ་གྲུབ་པས་སྤྱི་ཉིད་དང་ཁྱད་པར་ཅན་ཉིད་ཀྱི་བདག་ཉིད་དུ་གསལ་བར་བྱེད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་འབའ་ཞིག་རྗེས་སུ་འགྲོ་བས་ཁྱད་པར་ཅན་གྱི་མི་རྟག་པ་ཉིད་ཅི་ལྟར་འགྲུབ།",
    "དཔེ་བསྒྲུབ་པར་བྱ་བས་སྟོང་པར་འགྱུར་རོ།",
    "མ་ཡིན་ཏེ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "སྐྱོན་མེད་ན་ནི་འགའ་ཡང་འདོད་པ་ལ་གནོད་པ་བྱེད་པར་མི་འགྱུར་བའི་ཕྱིར་ཐམས་ཅད་ཀྱི་འདོད་པ་འགྲུབ་པར་འགྱུར་རོ་ཞེ་ན།",
    "མ་ཡིན་ཏེ་མ་འབྲེལ་པ་རྣམ་པར་གཅོད་པས་ཁྱད་པར་དུ་བྱེད་པའི་ཕྱིར་རོ།",
    "མ་འབྲེལ་བ་དང་གཞན་དང་འབྲེལ་པ་རྣམ་པར་གཅོད་པས་ནི་ཁྱད་པར་རྣམ་པ་གཉིས་སོ།",
    "བུམ་པས་གཉིས་པ་དང་བཅས་པ་ཉིད་ནི་རྩིག་པ་དང་བུམ་པ་དག་ལ་མཚུངས་པར་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ངེས་པ་མེད་ན་ནི་གང་ཡང་རུང་བས་གཉིས་པ་དང་བཅས་པ་ཉིད་ཀྱིས་མཚུངས་པར་འགྱུར་བ་ཡིན་ན།",
    "དེས་ན་རྣམ་པར་བརྟག་པ་དང་སོ་སོར་ངེས་པ་དག་འགལ་བ་མ་ཡིན་ནོ།",
    "འདི་ལྟར་ལྷ་སྦྱིན་དང་མཆོད་སྦྱིན་དག་ལས་གང་ཡང་རུང་བ་ལ་ཟན་བྱིན་ཅིག་ཅེས་བྱ་བ་ནི་ངེས་པ་གཅིག་ལ་ཟན་སྦྱིན་པ་ཉིད་རྣམ་པར་གནས་སོ།",
    "བྱ་རོག་དང་ཏ་ལའི་ཚུལ་དུ་ངེས་པར་གྲུབ་པའི་ཕྱིར།",
    "འདིར་ནི་སྐྱེས་བུ་དང་བུམ་པ་གང་ཡང་རུང་བས་གཉིས་པ་དང་བཅས་པར་བརྗོད་པ་ལ་སྐྱེས་བུ་ལ་ངེས་པ་མངོན་སུམ་གྱིས་གྲུབ་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་འདི་བརྗོད་ཀྱང་ཟན་མི་སྟེར་རམ་མི་ཟ་ན་ནི་ངེས་པར་གནས་པ་མ་ཡིན་ནོ།",
    "འདིར་ཡང་སྒྲུབ་པར་བྱེད་པའི་ཤུགས་ཀྱིས་ངེས་པར་རྟོགས་སོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་ལ་ནི་རྗེས་འགྲོ་མེད།",
    "འོན་ཏེ་སྒྲའི་ཁྱད་པར་ཅན་གྱི་མི་རྟག་པ་ཡིན་ན་དེའི་ཚེ་དེ་བུམ་པ་ལ་མེད་པའི་ཕྱིར་རྗེས་སུ་འགྲོ་བ་མེད་དོ་ཞེས་བྱ་བ་དེ་ཡང་བསལ་བ་ཡིན་ཏེ།",
    "དེ་སྤྱི་བསྒྲུབ་པར་བྱ་མིན་པས།",
    "གལ་ཏེ་གཞི་ལ་མི་ལྟོས་པའི་མི་རྟག་པ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ན་ནི་གྲུབ་པ་ལ་བསྒྲུབ་པར་འགྱུར་བ་ཡིན་ནོ།",
    "སྒྲའི་སྤྱི་ཁྱད་པར་ཅན་ཉིད་ཁྱད་པར་ཡིན་ནོ།",
    "གལ་ཏེ་སྤྱི་ཡིན་ན་ཅི་ལྟར་ཁྱད་པར་ཡིན།",
    "ཁྱད་པར་ཡིན་ནོ་ཞེ་ན་ནི་ཅི་ལྟར་སྤྱི་ཡིན་ཞེ་ན།",
    "ཁྱད་པར་གྱི་ནི་མཐར་ཐུག་ཉིད།",
    "སྒྲའི་ཁྱད་པར་གྱི་རྗེས་སུ་འགྲོ་བ་བསྟན་པས་སྒྲའི་ཁྱད་པར་ཅན་ཉིད་དུ་གྲུབ་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་མེས་ཁྱབ་པར་གྲུབ་པ་ནི་གང་ལ་ཉེ་བར་དེ་ཉིད་དུ་མེའི་བློ་སྐྱེད་པར་བྱེད་དེ་འབྲེལ་པ་དེ་བཞིན་དུ་བཟུང་བའི་ཕྱིར་རོ།",
    "ཡུལ་གང་ན་ཡོད་པའི་མེ་ནི་ཡུལ་དེ་ཉིད་དུ་སྐྱེད་པར་བྱེད་དོ།",
    "གལ་ཏེ་སྤྱིར་རྟོགས་ན་ཅི་ལྟར་ཁྱད་པར་རྟོགས་ཤེ་ན།",
    "ཡུལ་དང་དུས་དང་གནས་སྐབས་སོ་སོར་ངེས་པར་མ་རྟོགས་པར་ནི་ཐ་སྙད་གང་ཡང་མི་འགྲུབ་པོ།",
    "གལ་ཏེ་བསྒྲུབ་བྱ་དང་ལྷན་ཅིག་སྤྱི་རྟོགས་པར་བྱ་བ་ཡིན་ལ།",
    "བསྒྲུབ་པར་བྱ་བ་ཡང་རྗེས་སུ་དཔག་པས་ཤུགས་ཀྱིས་རྟོགས་པ་ཡིན་ནོ།",
    "ཕྱོགས་མ་ཡིན་པའི་བྱས་པ་ཐམས་ཅད་མི་རྟག་པ་ཡིན་ནོ་ཞེས་དེ་ལྟར་ཁྱད་པར་སྟོན་པ་ནི་མ་ཡིན་ནོ།",
    "དོན་དམ་པར་མ་བཟུང་བའི་ཕྱིར་ཅི་ལྟར་མི་སླུ་བ་ཡིན་ཞེ་ན།",
    "འབྲེལ་པ་ལ་སོགས་པ་ཐམས་ཅད་ནི་ཐོག་མ་མེད་པའི་ཐ་སྙད་ལས་ཤེས་པ་ཡིན་གྱི་དོན་དམ་པར་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "དེའི་ཕྱིར་སྤྱི་འབྲེལ་པ་བཟུང་ན་ཁྱད་པར་རྟོགས་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "དེ་ནི་ཁྱད་པར་མེད་པར་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྒྲ་མི་རྟག་པར་བསྒྲུབ་པ་ཡིན་ན།",
    "སྒྲ་ལ་སྒྲའི་ཁྱད་པར་ཅན་གྱི་མི་རྟག་པའམ།",
    "མི་རྟག་པ་ཉིད་ཀྱིས་ཁྱད་པར་ཅན་གྱི་སྒྲ་འགྲུབ་པར་བྱ་བ་ཡིན་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་གཏན་ཚིགས་འདི་སྒྲ་ལ་མི་རྟག་པ་ཉིད་སྒྲུབ་པ་དེ་བཞིན་དུ་སྒྲའི་ཁྱད་པར་ཅན་གྱི་མི་རྟག་པ་ཉིད་མེད་པ་ཡང་ཡིན་པའི་ཕྱིར་འགལ་བ་ཡིན་ནོ་ཞེས་སྨྲས་པ་དེ་ཡང་འདོད་པ་བསྒྲུབ་བྱར་བརྗོད་པ་འདིས་གསལ་བ་ཡིན་ནོ།",
    "མི་རྟག་པ་ཙམ་བསྒྲུབ་ན་ཅི་ལྟར་སྤྱི་སྒྲུབ་པར་འགྱུར་ཞེ་ན།",
    "སྒྲའི་སྤྱི་གཞན་བསྒྲུབ་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "གཉིས་ལས་གཅིག་མེད་ན་སྤྱི་བཟློག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གཅིག་ལ་གཉིས་པ་སྒྲུབ་ན་ཚོགས་པར་འགྲུབ་པའི་ཕྱིར།",
    "དེ་ཚོགས་པ་དང་ཁྱད་པར་བཟློག་པ་ཐ་དད་ཅེ་ན།",
    "དོན་དམ་པར་ནི་ཚོགས་པ་གསལ་བ་ཉིད་དོ།",
    "དེ་ལྟར་བསྒྲུབ་པར་བྱ་བ་མི་འདོད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་འདོད་པ་སྨོས་པ་བསྒྲུབ་བྱར་མི་འདོད་པ་བཟློག་ཀྱང་ཉེས་པ་མེད་པར་བསྟན་པ་ལྷུར་གཉེར་བ་ཡིན་ན།",
    "བསྟན་བཅོས་དང་འགལ་བའི་གཏན་ཚིགས་ནི་བསྒྲུབ་བྱ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "མི་རྟག་པ་ཉིད་ཀྱང་ནམ་མཁའི་ཡོན་ཏན་ཉིད་དང་དོན་གཅིག་ལ་འདུ་བ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ཏེ།",
    "ནམ་མཁའ་ནི་ལྕི་བ་དག་འཛིན་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "འཛིན་པར་བྱེད་པས་ཅི་ཞིག་བྱ།",
    "དེ་ལྟར་དེ་ནི་རྟེན་མེད་པར།",
    "འདི་ཡང་དཔྱད་པར་བྱ་མིན་ཞེས།",
    "དེའི་ཕྱིར་མི་རྟག་པའི་བདག་ཉིད་ཀྱི་དོན་ལ་བརྟེན་གྱིས་དོན་མ་ཡིན་པའི་ཕྱིར་མི་རྟག་པར་སྒྲུབ་པར་བྱེད་པ་དེ་ནི་བརྟེན་པ་ཉིད་ཀྱིས་གནོད་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་གཏན་ཚིགས་ཀྱི་སྐྱོན་དང་དམ་བཅའ་བའི་སྐྱོན་ཡིན་ནོ་ཞེ་ན།"
  ]
