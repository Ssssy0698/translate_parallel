    "གལ་ཏེ་མི་རྟག་པ་ཉིད་དུ་བརྗོད་པར་འདོད་པས་ཕྱོགས་ཡིན་པ་དེ་ལྟ་ན་ཡང་དེ་ཙམ་གྱིས་མི་རྟག་པ་ཉིད་དུ་མི་འགྲུབ་སྟེ།",
    "རྟག་པ་ཉིད་ཀྱིས་བརྗོད་པར་འདོད་པ་ནི་དེ་ཉིད་ཀྱི་ཚེ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རང་ལ་གྲུབ་པའི་དོན་གྱི་སྒྲུབ་པར་བྱེད་པ་དེ་ཡང་ཚུལ་གསུམ་པ་ཉིད་ཀྱི་རྟགས་ཉིད་ཡིན་ཏེ།",
    "ཡུལ་དང་དུས་རྣམ་པར་འཆད་པའི་གསལ་བ་གཅིག་དང་འདྲེ་བས་རྣམ་པར་མ་བཅད་པའི་རང་བཞིན་གཞན་དང་བྲལ་བར་རྟོགས་པས་ཅི་ལྟར་དེ་ཁྱབ་པ་ཡིན་ཞེས་ཁས་བླངས་པར་རིགས།",
    "མ་རྟོགས་པ་ནི་ཁས་བླངས་པར་མི་རིགས་སོ།",
    "གསལ་བ་མཐའ་དག་དམིགས་པར་འགྱུར་རོ།",
    "ཕ་རོལ་པོས་རྣམ་པ་ཉིད་སྤྱི་ཡིན་པར་ཁས་བླངས་ཤིང་།",
    "འདི་ཉེ་བར་བཀོད་པ་ཡང་རྩ་བའི་མཐར་ཐུག་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "དེའི་ཚེ་ཡང་དེ་གང་ཡིན་ཞེས་ངེས་པར་བརྟག་པར་བྱ་བ་ཉིད་དོ།",
    "དེའི་ཕྱིར་ངེས་པ་གཞན་གྱིས་བརྗོད་པའི་སྤྱི་བློ་ལ་གནས་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ལྡོག་པར་མཚུངས་པ་ཉིད་དག་ནི།",
    "འབྲེལ་པ་མེད་ན་གཅིག་མེད་པས་གཞན་མེད་པར་རྟོགས་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེས་ན་དེའི་སྟོབས་ཀྱིས་གང་ན་ཁྱབ་པར་བྱེད་པ་མེད་པ་དེ་ན་ཁྱབ་པར་བྱ་བ་མེད་པ་ཡིན་ནོ་ཞེས་མི་མཐུན་པའི་ཕྱོགས་མེད་པ་ཙམ་ཞིག་སྟོན་ཏེ།",
    "འོན་ཏེ་སོ་སོར་ངེས་པའི་དངོས་པོའི་ཡུལ་མེད་པར་སྒྲུབ་པའི་ཕྱིར་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཡང་ཉེ་བར་ལེན་ཏོ་ཞེ་ན།",
    "དེ་ལྟ་ན་ནི་འོན་ཏེ་དངོས་པོ་ཉེ་བར་ལེན་པ་ཅན་མ་ཡིན་པར་བསྒྲུབ་པ་ལ་དེ་དམིགས་པ་གཞན་གཏན་ཚིགས་ཡིན་པའི་ཕྱིར་དེ་ནི་གྱི་ནའོ།",
    "ངེས་པར་སྐྱེ་དང་འབྲེལ་མ་ཡིན།",
    "རྟགས་ཉིད་མིན་པར་སྒྲུབ་དོན་ཏེ།",
    "དོན་སྨོས་པ་གང་ཡིན་པ་དེ་ནི་སྒྲ་དང་རྟོག་པ་ཙམ་གྱིས་སྦྱར་བའི་བདག་ཉིད་ཅན་གཏན་ཚིགས་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར་ཏེ།",
    "གལ་ཏེ་འདི་ལ་ཚུལ་གསུམ་ཡོད་ན་ཅི་ལྟར་གཏན་ཚིགས་མ་ཡིན་པར་འགྱུར།",
    "མི་རིགས་པར་སྨྲ་བར་བསྟན་པར་འགྱུར་ཏེ།",
    "བསྒྲུབ་བྱ་སྒྲུབ་པར་བྱེད་པ་སྒྲུབ་བྱེད་ཡིན་གྱི།",
    "ཚིག་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "སྒྲུབ་པར་བྱེད་པ་གནས་མ་ཡིན།",
    "སྒྲ་ནི་མི་རྟག་སྟེ་བྱས་པའི་ཕྱིར་རོ་ཞེས་ཚུལ་གསུམ་པས་བྱས་པ་ཉིད་མི་རྟག་པ་གོ་བར་བྱེད་པ་ཡིན་ཏེ།",
    "གཞལ་བྱའི་ཕྱིར་ཞེས་བྱ་བས་ཀྱང་བསྒྲུབ་བྱ་གྲུབ་པར་འགྱུར་ཏེ།",
    "འོ་ན་ནི་འབྲེལ་པའི་ཕྱིར་དོན་ཉིད་ཀྱིས་དོན་རྟོགས་པར་འགྱུར་ཏེ།",
    "ཚིག་ནི་དངོས་སུ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བར་འགྱུར་རོ།",
    "ཚིག་ནི་དོན་མེད་པར་ཡང་ཡོད་པའི་ཕྱིར་རོ།",
    "གང་དུ་གཏན་ཚིགས་ཀྱི་ཚིག་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པ་དེར།",
    "ཕྱོགས་ཀྱི་ཚིག་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པར་ནི་མ་བརྗོད་པར་གྲུབ་པོ།",
    "འོན་ཏེ་བསྒྲུབ་བྱའི་ཚིག་བསྒྲུབ་བྱའི་དོན་སྒྲུབ་པར་བྱེད་པའི་སྒོ་ནས་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "འོན་ཏེ་དམ་བཅས་པ་ཙམ་ནི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་གཏན་ཚིགས་འགོད་དོ་ཞེ་ན།",
    "དེའི་ཕྱིར་ཚིག་ནི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "བསམ་པ་སྟོན་པར་བྱེད་པ་ལས།",
    "དེ་ལྟ་མ་ཡིན་ན་གཏན་ཚིགས་དགོད་པ་དོན་མེད་པར་འགྱུར་རོ།",
    "འོ་ན་ནི་ཅི་ལྟར་ཚིག་བསྒྲུབ་པར་བྱ་བའི་དོན་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་པ་དེ་བཞིན་དུ་སྒྲུབ་པར་བྱེད་པ་ནི་དོན་ཀྱང་དེ་ལས་རྟོགས་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "འབྲེལ་པ་ཡིན་ན་ནི་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "དེས་ན་དངོས་སུ་ནི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཚིག་ནི་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "འོ་ན་ཕྱོགས་ཀྱི་ཚིག་བརྒྱུད་ནས་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དཔེར་ན་སྒྲུབ་པར་བྱེད་པའི་ཚིག་བཞིན་ནོ་ཞེ་ན།",
    "བསྒྲུབ་པར་བྱ་བ་བརྗོད་པ་ཡིས།",
    "མ་གྲུབ་པར་སྟོན་པ་ན་ཅི་ལྟར་གྲུབ་པར་བྱེད་པ་ཡིན།",
    "རང་ཉིད་མི་ནུས་པ་ནི་ནུས་པ་ལ་མ་བརྟེན་པར་ནུས་པ་དང་ལྡན་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "གང་དུའང་བརྟེན་པར་འགྱུར་མ་ཡིན།",
    "གཏན་ཚིགས་ཀྱི་ཚིག་ནི་རང་ཉིད་ནུས་པ་མེད་ཀྱང་ནུས་པ་རྗོད་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར།",
    "སྒྲུབ་པར་བྱེད་པ་བརྗོད་དོ།",
    "སྒྲུབ་པར་བྱེད་པ་བརྗོད་པའི་ཕྱིར།",
    "བསྟན་པར་བྱ་བ་ལ་ལྟོས་ནས་ནི་རང་དོན་ཉིད་ཡིན་ལ།",
    "སྟོན་པར་བྱེད་པ་ལ་ལྟོས་ནས་ནི་རྗེས་སུ་བརྗོད་པ་ཙམ་དུ་ཟད་དོ་ཞེས་གང་བརྗོད་པ་དེ་ཡང་གསལ་བ་ཡིན་ཏེ།",
    "དེ་ནི་རྗེས་སུ་དཔག་པའི་རྒྱུ་ཡིན་པ་ཉིད་ཀྱིས་ཉེ་བར་བརྟགས་ནས་རྗེས་སུ་དཔག་པར་བརྗོད་ཀྱི།",
    "དེས་ན་བསྟན་པར་བྱ་བ་ལ་ལྟོས་ནས་ནི།",
    "དྲན་པར་བྱེད་པས་དེ་ཡང་ཕན་འདོགས་པ་ཡིན་པའི་ཕྱིར་རྟོགས་པར་བྱེད་པ་ཉིད་དོ་ཞེ་ན།",
    "དེའི་གཞན་གྱི་དོན་ཉིད་ནི་སྟོན་པར་བྱེད་པ་ལ་ལྟོས་ནས་ཡིན་ཏེ།",
    "སྟོན་པར་བྱེད་པ་ལ་ནི་དེས་ཅིས་ཀྱང་ཕན་བཏགས་པ་མེད་དོ།",
    "དེའི་རྗེས་སུ་དཔག་པའི་རྒྱུ་ཡིན་པ་ཉིད་ཀྱིས་རྗེས་སུ་དཔག་པ་ཉིད་ནི་བསྟན་པར་བྱ་བ་ལ་ལྟོས་པ་ཉིད་དོ།",
