    "གཡེར་དྲིལ་གྱི་ཚིང་སྒྲ་ལྷང་ངེར་གྲགས་ཅིང་གདའ།",
    "ཁོ་ཁ་སྐྱེངས་པོ་ཞིག་བཟོས་པ་འདྲ་འདུག་ཁོ་རྗེ་བཙུན་གྱི་མཐུ་རྩལ་ལ་ཧ་ལས་ནས་ག་བྱེད་འདི་བྱེད་མེད་པའི་སྐབས་དེ་ལ།",
    "སྒྲུང་འདི་ཕལ་ཆེར་དེབ་ཐེར་སྔོན་པོའི་ནང་འཁོད་ཡོད་བསམ་བསམ་འདུགཞི་འོད་ཀུན་དགའ་ཉི་མས་བཤད།",
    "ཐང་སྐྱ་ན་འདུར་རྒྱུག་བྱེད་པའི་བྱི་བ་ཡང་ཟུར་གཡོལ་བྱེད་ཅིང་གདའ།",
    "ཕྲག་པར་བོད་མདའ་ཐོགས་པའི་ཕོ་གཞོན་ཞིག་ཀེར་ལངས་བྱས་ནས་འདུག་པ་དང་།",
    "རྒྱབ་ན་དམག་མི་མིན་འདུག་ལྷོ་བྲག་ནོར་བཟང་གྱིས་སྔོན་ལ་ལན་བཏབ།",
    "བགྲོད་ལམ་གཡས་གཡོན་གྱི་ལྕང་མ་རིམ་བཞིན་ཇེ་མང་དུ་འགྲོ་ཞིང་འདུག་ལ།",
    "ཤ་རིད་པའི་ལས་མི་འགའ་ཞིག་འདུག་པ་དེ་ཚོས་ངེད་ལ་འདྲེ་མཐོང་བ་ལྟར་ལྟ་ཞིང་འདུག་ཝེ།",
    "གཞིས་ཀའི་ནང་ལ་སུ་བཞུགས་འདུག་ཕྱག་མཛོད་ལགས་བཞུགས་བཞག་ད་དུང་སྲས་ཆུང་སྐུ་ཞབས་ལགས་འོ།",
    "ལག་གཡོན་དུ་སྲབ་མདའ་བཅང་པ་དང་གཡས་སུ་ཀོ་བའི་ལྕག་ཚན་འཁྱེར་བ་ཞིག་འདུག་དེའི་རྒྱབ་ཏུ་ཡོད་པའི་རྟ་པ་དེས།",
    "མགོ་ལ་རྒྱ་ཞྭ་གྱོན་ཅིང་ལུས་ལ་སོག་ཆས་སྤེལ་བ་ཞིག་འདུག་རྟ་པ་སྔོན་མ་དེས་ངེད་ཀྱི་འཁྲིས་ནས་མདའ་ལྟར་རྒྱུག་ཅིང་།",
    "གཞིས་ཀའི་རྒྱལ་སྒོའི་མདུན་དུ་བར་སྟོང་ཆེན་པོ་ཞིག་འདུག་པ་དང་།",
    "དེའི་གཞོགས་གཉིས་སུ་ཁོང་སྐུ་ཐོག་གཅིག་མ་ཤ་སྟག་བརྒྱབ་འདུག་ཅིང་།",
    "ཁང་པ་དེ་ཤིན་ཏུ་སྐྱིད་སྣང་དོད་པོ་ཞིག་འདུག་པ་ལ།",
    "མལ་ཁྲིའི་སྟེང་དུ་རྩྭ་གདན་གྱི་ཁར་བོད་གདན་བཏིངས་འདུག་པ་དང་།",
    "གྱང་དུ་ཆ་སྒམ་ཆ་གཅིག་བསྒྲིག་འདུག་པ་དེའི་སྟེང་དུ།",
    "བརྐོས་རིས་པར་སྒྲོམ་ནང་དུ་ཐགས་རིས་དང་དེ་བཞིན་དུ་ནང་སའི་གནའ་མིའི་ཟངས་སྐུ་བཞག་འདུག་ཅིང་།",
    "གསེར་ཐང་གཞིས་ཀ་དེ་ནི་དབེན་པའི་ཡུལ་གནས་བཟོད་བདེ་བ་ཞིག་འདུག་པ་ལ།",
    "མཆོད་ཁང་དེའི་རྩིག་ལྡེབས་ལ་ཚོན་རྩི་སེར་པོ་བཏང་འདུག་ཅིང་།",
    "ཆ་སྒམ་གྱི་ཐོག་ཏུ་བཟོ་དབྱིབས་མི་གཅིག་པའི་ལི་དང་དངུལ་གྱི་སྐུ་རྟེན་བཞེངས་འདུག་པ་དང་།",
    "ཁྱེད་རང་ཕེབས་ཡོང་བསམ་བསམ་གཏན་ནས་མ་བྱུང་ཞེས་བཤད།",
    "དངོས་ཡོད་ཀྱི་འཚོ་བའི་ལམ་བུར་ལོག་གང་ཐུབ་བྱེད་ཅིང་འདུག་པའི་ཚེ་ན།",
    "ངའི་ལུས་ཐོག་ནས་གནས་ཚུལ་ཞིག་དྲན་པ་ལྟར་དུ་ཇོ་ལགས་དང་ན་མཉམ་གྱི་གྲྭ་བཙུན་དེ་ཚོ་མཐོང་དུསངས་དྲན་མི་དགོས་བསམ་ཡང་ཇོ་ལགས་སེམས་ལ་རྟག་པར་དྲན་གྱི་འདུག་ཁོང་སྨྱོས་རྗེས་ལུས་ལ་གཟན་གོས་གྱོན་ནས་གང་སར་འགྲོ་ཚུལ་དེ་ཚོ་དང་།",
    "མཇལ་ཁ་ཞུ་རུ་བཅུག་པའི་གནས་ཚུལ་དེ་ཚོ་བརྗེད་ཐབས་མི་འདུག་ཅེས་ཟེར།",
    "ཕྱག་གཉིས་ཀྱིས་འགྲམ་སྐྱོར་བྱེད་ཅིང་དུ་བློ་ཕམ་ཆེན་པོས་ངེད་གཉིས་ལ་ཅེར་ནས་འདུག་པས།",
    "ཁོ་ཚོ་བུ་ལོན་གཡར་བྱས་སྐྱེད་ཀྱི་མི་ཚད་ཙམ་བསགས་ནས་མི་རབས་ནས་མི་རབས་བར་འཇལ་ཐུབ་ཡས་མི་འདུག་ད་དུང་དེས་མ་ཚད་བཀའ་ཤག་དང་གཞིས་ཀར་འུ་ལག་རྒྱུག་དགོས་པ་དང་ཁྲལ་འཇལ་དགོས་དུས།",
    "ཁྱེད་རང་རྒྱལ་ཁབ་མང་པོ་ལ་ཕེབས་མྱོང་ཙང་།",
    "སྒོ་རའི་ནང་དུ་མི་སུམ་ཅུ་ཙམ་འདུག་པ་མཐོང་།",
    "གཡམ་གཅལ་གྱི་ལམ་ཆུང་ཀྱག་ཀྱོག་ཞིག་འདུག་པ་དེར་ཁྲིད་ནས་ཁང་སྐུ་ཐོག་གཅིག་མ་སྟར་གཅིག་ཅན་ཞིག་ཡོད་སར་སླེབས།",
    "དེར་རྐང་འཁོར་གསུམ་བཞག་འདུག་པ་མཐོང་།",
    "ཁྱེད་རང་སྔོན་ལ་སྐུ་ངལ་བསྐྱོན་པར་ཕེབས་དང་།",
    "རྗེས་སུ་ང་རང་གཅིག་པུར་བསྐྱོད་བསྐྱོད་པས།",
    "ལྷོ་བྲག་ནོར་བཟང་ཁྲ་མའི་ཕྱི་རོལ་དུ་ལྟ་ཞིང་འདུག་པ་རབ་རིག་ཅིག་མཐོང་བྱུང་།",
    "དེ་ཁ་རུ་བཅུག་སྟེ་ལྡད་པས་བྱེ་རིལ་ནང་བཞིན་ཞིམ་མངར་དང་ལྡན་ལ་ཧ་ཅང་སྙི་པོ་ཞིག་འདུག་རྡོ་རྗེ་རྒྱལ་མཚན་གྱིས་ཁྱུར་མིད་མ་གཏོང་ཨང་ཟེར་བྱུང་སྟབས།",
    "ཕྱག་མཛོད་བཟང་པོས་མགོ་སྐྲ་ཐོད་བཅིངས་དང་བཅས་ཕྱུ་རིང་ནག་ཐིང་ཐིང་ཞིག་གྱོན་འདུག་པ་མཐོང་།",
    "ཁོ་རང་དང་།",
    "ངས་ཀྱང་གཡག་རྒྱུ་བརྔོས་མ་རྡོག་གཅིག་རྡོ་རྗེ་རྒྱལ་མཚན་གྱི་ཕོར་པར་བླུགས་པས་ཁོས་དགོད་ཅིང་གདའ།",
    "མི་ཚང་མས་ང་ལ་ཅེར་ཞིང་འདུག་པ་མཐོང་།",
    "ཁོའི་ངོ་གདོང་ལ་རྨ་ཤུལ་ཆགས་འདུག་ལ།",
    "ཁོ་ཚོ་དེ་གར་འགྲོ་བསྐྱོད་བྱེད་པའི་རྡོག་སྒྲ་གསལ་ལེར་ཐོས་ཀྱི་གདའ།",
    "མདའ་དཔོན་བཅས་གསུམ་པོ་ཅོག་ཙེའི་མཐའ་འཁོར་ན་བསྡད་འདུག་པས།",
    "ཁོང་རྣམ་པའི་རྣམ་འགྱུར་ལོག་འདུག་ལ།",
    "ངེད་ནས་ཀྱང་རང་ཕོར་བཏོན་ཏེ་མགོ་བོ་དུད་ཅིང་ཇ་འཐུང་སྐབས།",
    "མདའ་དཔོན་གྱིས་དམག་ཆས་ཕུད་ནས་ལུས་ལ་ཕྱུ་པ་ཞིག་གྱོན་འདུག་པ་དང་ཁོ་དང་རྡོ་རྗེ་རྒྱལ་མཚན་གཉིས་ཀྱི་སྐེ་ལ་ཁ་བཏགས་གཡོགས་འདུག་པ་མཐོང་།",
    "ཁོའི་ཨམ་ཕྲག་མདེའུ་རོས་ཁེངས་འདུག་ཁོས་ཕྱུ་པ་དཀྲུག་དཀྲུག་གཏོང་དུས་མདེའུ་རོ་ཤག་ཤག་ཏུ་ས་ལ་འབབ་ཀྱི་འདུག་ཁོའི་ཕྱུ་པ་དེ་ང་ཚགས་འདྲ་པོ་ཞིག་བཟོས་འདུག་ཀྱང་།",
    "དེ་རྗེས་ཁྱི་གཉིས་ཤོར་འོང་སྟེ་བར་མི་ཆད་པར་ངེད་ལ་ཟུག་ཅིང་གདའ།",
    "གཞིས་ཀ་འདུག་ལ།",
    "གོམ་པ་སྤོས་ན་ཡང་སིལ་སིལ་ཞིག་འདུག་འོ།",
    "ཞི་འོད་ཀུན་དགའ་ཉི་མས་ཀྱང་ལག་པ་གཞུ་ལྟར་བཀུག་སྟེ་ཉི་མའི་འོད་ཟེར་འགོག་ཐབས་བྱེད་ཅིང་རི་རྩེའི་ཤར་མ་ཡལ་གྱི་རྒོད་གཟུགས་ལ་མིག་སྐྱེལ་བྱེད་ཅིང་གདའ།",
    "རྟ་ཐོག་ནས་སྐྱེ་བསྣར་ཏེ་གང་སར་ལྟ་བཞིན་འདུག།",
    "ས་འབུར་དེའི་རྒྱབ་ན་ཕོ་གཞོན་ཞིག་འཕྲེད་དུ་ཉལ་འདུག་པ་དང་།",
    "ངོ་མདངས་ཤོར་བའི་རྨོ་བོ་ཞིག་བྱིས་པ་གཉིས་བཅས་འདུག་པ་མཐོང་།",
    "མི་རྒན་གྱི་ལྷམ་ཞིག་གྱོན་འདུག་པ་དང་།",
    "གཤིན་པོའི་མགོ་དང་ལག་པ་གཉིས་རྟ་གྲོད་ཀྱི་ཟུར་ལོགས་ཤིག་ཏུ་ལང་ལིང་དུ་འགུལ་ཞིང་འདུག་ལ།",
    "དེ་གར་ས་རྡོའི་ཁང་པ་ཉིས་ཐོག་ཅིག་འདུག་པ་ལ།",
    "སྣ་ལྔའི་དར་ལྕོག་ཁུར་ཏུ་ལྕི་བའི་ལོ་ཏོག་བཞིན་མགོ་བོ་ཐུར་དུ་དཔྱངས་ནས་གདའ།",
    "ཁྱེད་རང་ཐུགས་ཁྲལ་མ་གནང་།",
    "ཡིན་ནའི་ད་ལྟ་ཁོ་ཚོར་འཁྱུག་པའི་གོས་མི་འདུག་པས་མ་ཚད།",
    "ཕར་ལྟ་སྐབས་སྒོ་རའི་ནང་བཞོན་མ་བཞི་དང་ཁྱིམ་བྱ་དྲུག་འདུག་པ་དང་སྒོ་རའི་གྱང་རར་གྲོ་རྩྭ་སྐམ་པོ་བྱུར་བུར་སྤུངས་འདུག་པ་མཐོང་།",
    "བྱིས་པ་དེ་གཉིས་གྲོ་རྩྭ་སྐམ་པོའི་ཐོག་ཏུ་རྔུ་ཆུང་རྒྱག་ཅིང་གཉིད་དུ་ཡུར་འདུག་ཀྱང་།",
    "རི་ཁུག་ཞིག་ཏུ་འབྱོར་ཏེ་དཀན་གཟར་གྱི་བྲག་རི་ཞིག་འདུག་པ་དེར་ངས་བཞོན་རྟ་ཁྲིད་ཅིང་།",
    "ལ་ལས་ཕུ་ཐུང་མདུན་དུ་བཅིངས་འདུག་པ་དང་།",
    "ཁོས་ལག་ཏུ་ཐུང་མདའ་ཞིག་བཟུང་བ་དང་སྐེད་པར་གྲི་རིང་ཞིག་ཕྲེད་དུ་བཏགས་འདུག་པ་ལ་བལྟས་ན།",
    "དབུགས་ཀྱི་རྒྱུ་བ་ཆད་འདུག་པ་ཚོར་བྱུང་ཡང་།",
    "རི་ཁུག་ཅིག་ཏུ་སླེབས་དུས་དེ་གར་སྐུ་ལམ་ཞིག་འདུག་པ་དེའི་ཟུར་དུ་ཇིབ་ལ་ཉེ་བའི་རྡོ་ཁང་ཞིག་ཡོད་པ་མཐོང་།",
    "དཀའ་སྡུག་ང་རང་རྡོ་ཡིས་བརྩིགས་པའི་གྱང་རའི་ཁུག་ཏུ་ཉལ་དུས།",
    "ཁྱེད་རང་མང་ཡུལ་སྐྱ་རྔ་རྩ་རུ་བྱོན་དུས།",
    "ཁོ་རང་བྱང་སྟག་རྩེའི་ཡུལ་དུ་ཚོང་མཇུག་བསྒྲིལ་མ།",
    "ཁྱེད་རང་ལོ་བཞི་ལ་ལོན་པའི་ཚེ་ན།",
    "ཁྱེད་རང་ལོ་བདུན་ལ་ལོན་དུས།",
    "ལུས་ལ་བཀབ་པའི་མལ་ཐུལ་སིག་སིག་ཏུ་འཕག་དུས།",
    "སེམས་ཕམ་པའི་ངུ་འབོད་སྒྲོག་དུས།",
    "དེར་ཡོད་ཀྱི་མིས་ཡང་མིག་ཆུ་ཉིལ་ཉིལ་དུ་གཏོང་ཞིང་འདུག་གོ།",
    "མཛེས་སེའི་ཕ་ཡིས་སྣ་ཐ་འཐེན་གྱིན་དུ་ཁྱེད་མ་སྨད་གསུམ་གྱི་སར་འོང་སྟེ་ད་སྐྱོ་པོ་བྱས་ཀྱང་མི་ཕན་འདུག་དུས་ད་ཆ་རྒྱུ་ནོར་ཤོར་ནའང་ཤོར།",
    "ཡུལ་པས་རྒྱབ་ནས་མྱང་ཚ་དཀར་རྒྱན་མ་སྨད་ཀྱིས་རྒྱུ་ནོར་སློང་བྱེད་པ་འདུག་ཅེས་ཟེར་རོ།",
    "ཁྱེད་རང་ལོ་བཅོ་ལྔ་ལ་ལོན་པས།",
    "ཁྱེད་རང་རྩའི་མི་ཐོད་གུད་ཁ་རུ་སྔགས་རྙིང་མའི་སློབ་དཔོན་གྱི་སར་སྔགས་སློབ་ཏུ་བཏང་ངོ།",
    "ཁྱེད་རང་བཟི་བ་ལས་དྭངས་ཤིང་།",
    "ཆུ་ངོགས་ཀྱི་རྡོ་བ་ཡང་འཁྱག་པོར་གྱུར་འདུག་པ་མཐོང་ལ།",
    "ང་ཡིད་ཆེས་ཀྱི་མི་འདུག་ཅེས་བཤད།",
    "མེ་ཤིང་ཚག་ཚག་ཏུ་འབར་ཞིང་གདའ།",
    "མི་བཟོ་དགུ་བཟོ་བཟོ་མཁན་ང་ཡིན་ཞེས་བར་མེད་དུ་གསུངས་ཤིང་འདུག་པས།",
    "ཉི་མ་ནུབ་ཏུ་བྱོན་ལ་ཁད་འདུག་ལ།",
    "རྗེས་སུ་གོང་འདྲ་གནང་མཁན་ཡིན་ནམ་རྒན་པོ་དེ་ཁ་གསང་པོ་ཞིག་འདུག་ལ།",
    "ངས་ཁྱེད་རང་ཁོའི་སར་གདན་འདྲེན་ཞུ་ན་བསམ་གྱི་འདུག་ཅེས་ཏབ་ཏབ་པོར་བཤད།",
    "དེ་དུས་ང་རང་ལོ་བཅུ་གསུམ་ལ་ལོན་མ་ཐག་ཡིན་སྟབས།",
    "ངེད་ཀྱང་ལོག་དུས་ལ་སླེབས་སྙམ་ངས་རྡུལ་ལེན་འོག་ཏུ་ཉར་ཚགས་བྱས་པའི་རས་ཁུག་ལ་ལག་པ་ཐུག་སྐྱབས།",
    "དབུས་སུ་རྩྭ་གདན་མཐུག་པོ་ཞིག་བཏིངས་པའི་ཐོག་ཏུ་ཅོག་ཙེ་ཆུང་ངུ་གཉིས་བརྒྱབ་འདུག་པ་དང་།",
    "དེ་དང་མི་རིང་བའི་སར་ཤུག་པ་སྤུངས་ནས་གདའ།",
    "རྩམ་སྐྱ་ངོ་བཞིན་དང་གྱོན་པར་བབས་པའི་ངང་ཚུལ་ལ་ཕན་ཚུན་ཅེར་ནས་དགོད་ཅིང་འདུག་ཡུལ་པས་རྨོན་མཛོ་དཀར་པོ་གཉིས་ཁྲིད་ཡོང་སྟེ།",
    "བསྟན་འཛིན་གྲགས་པ་དང་ཁོའི་བུ་རྒན་གཞོན་གསུམ་སྐྱིལ་ཀྲུང་དུ་བསྡད་འདུག་ཅིང་།",
    "བུའི་མནའ་མས་ཐུབ་ལས་བྱེད་ཅིང་གདའ།",
    "ཤིང་སྒོ་སེར་ག་ཤོར་ནས་བཟོ་ཉམས་འཆོར་འདུག་པ་དེ་མཐོང་སྟེ།",
    "ཡུལ་བྱོལ་ལ་འགྲོ་མཁན་ཡིན་ཟེར་གྱི་འདུག་ཁ་སོ་མེད་པའི་གྲུ་རྒན་དེས་མགོ་བོ་དགྱེ་ནས་འཛུམ་མེར་མེར་གྱིས་བཤད།",
    "སྒྲུབ་ཕུག་དེ་ཕུ་ཐག་རིང་པོ་མི་འདུག་ལ།",
    "ཁྱེད་རང་ལྷ་སར་ཕེབས་རྗེས་སྒྲུབ་པ་བསྐྱོན་གནང་ངས་ཞུ་བ་ཕུལ།",
    "དེ་ལས་ཁོ་ཚོ་ཐུག་གར་རྒྱུགས་ཁྱེད་རང་ལ་ཞབས་ཕྱི་བཞུ་མཁན་མེད་པར།",
    "ཁྱེད་རང་འདིར་སྒོམ་བསྐྱོན་ནས་བཞུགས་ན།",
    "འཁོར་སྒྲོམ་ནང་སྔར་ནས་མི་ལྔ་དྲུག་ཞིག་བླུགས་འདུག་སྟབས།",
    "ནང་དུ་མི་བརྒྱ་ལྷག་འདུག་པ་དང་།",
    "ཁོ་ཡང་བཟུང་འདུག་ང་དགའ་ནས་གཏམ་ཤོར།",
    "ཁོའི་སྣ་རྩེའི་ཉི་ཕྱུར་དག་ཡལ་ལ་ཁད་དུ་འདུག་པ་མཐོང་།",
    "དེ་དུས་ཁང་པའི་ནང་སྒྲོག་ཙེ་གཅིག་བཞག་འདུག་པ་དང་།",
    "དེའི་རྒྱབ་ཏུ་མི་གཉིས་དང་ཁོ་གཉིས་ཀྱི་ཟུར་ན་དམག་གོས་གྱོན་མེད་པའི་མི་གཅིག་བཅས་བསྡད་འདུག་ཅིང་།",
    "རྒྱབ་ཏུ་བསྡད་པའི་མི་རྣམས་ས་ཐོག་ལ་མཆོང་བཞིན་འདུག་པ་མཐོང་ནས།",
    "ཁ་ནང་ལ་སྐོར་ཏེ་ལྷོ་བྲག་ནོར་བཟང་བཙལ་སྐབསཁོ་ནི་འཁོར་སྒྲོམ་གྱི་མདུན་གྱི་ཁུག་ཟུར་ཞིག་ན་ཙོག་པུར་བསྡད་དེ་སྒྲོམ་མཇུག་ལ་ལྟ་བཞིན་འདུག་པ་མཐོང་།",
    "ཤུ་གཉིས་པ་དེ་རྒྱག་དུས།",
    "མི་གཞན་གྱིས་དབོར་འདྲེན་བྱེད་ཀྱིན་གདའ།",
    "ངེད་དང་བར་རྒྱང་མི་རིང་བའི་ས་ན་བཅིངས་འགྲོལ་དམག་མིས་མེ་མདའ་ཁྱེར་ནས་སོ་ལྟ་བྱེད་ཅིང་འདུག་ཝ་ཡེ།",
    "མི་སྤུང་ལོག་ས་མི་འདུག།",
    "ཡུར་བུ་བརྐོ་མཁན་གྲོག་མ་བཞིན་འདུག་པ་མཐོང་སྟེ།",
    "ངའི་བློ་ལ་གོ་སྐབས་ཤོར་བ་མིན་འགྲོ་སྙམ་བྱུང་ལ།",
    "ཁོས་ཀྱང་ང་ལ་བལྟས་ནས་དགོད་ཅིང་འདུག་དགོད་ཐེངས་འདི་ནི་ངེད་ཅག་ལམ་བར་དུ་ཡོང་བ་ནས་ད་བར་དུ་མཐོང་མྱོང་བའི་ཁོའི་དགོད་ཐེངས་ཐོག་མ་དེ་ལགས།",
    "གུར་ནང་དུ་མི་བཅུ་གྲངས་ཤིག་འདུག་ན་ཡང་ངས་ངོ་ཤེས་པ་གཅིག་ཀྱང་མེད་པ་མཐོང་།",
    "ལྷོ་ཁར་གནས་མཇལ་ལ་ཕྱིན་ནས་ཚུར་ལོག་དུས་བཟུང་བྱུང་ངས་ཁ་སྐོར་ནས་ལན་བཏབ།",
    "ཁྱེད་རང་གསེར་ཐང་སྐུ་ངོ་ཡིན་གནང་པས་ངས་གཟབ་ནན་གྱིས་རྒན་པོ་དེར་དྲིས།",
    "སེམས་པ་ཁོག་པའི་ནང་བཞག་ན་འགྲིག་པ་འདུག་ངའི་འོག་མ་ཁོ་ཤི་ཡོད་དམ་བྲོས་ཡོད་དམ།",
    "ཆུ་རགས་རྒྱག་ཅིང་འདུག་པ་དང་།",
    "ཁང་སྐྱིད་ཤར་སྐུ་ངོས་ཀྱང་དཔུང་ཧྲེང་མར་ཏོག་ཙེས་ས་ཁོད་སྙོམས་པ་སོགས་བྱ་བ་མཐོང་རྒྱུ་གདའོ།",
    "ལུས་ཀྱི་དྲེགས་ཉམས་རྨང་ནས་བརླག་ཟིན་འདུག་ངལ་གསོའི་དུས་སུ།",
    "ཁོས་གང་སར་མེ་མདའི་སྐད་ཀྱིས་ཁེངས་འདུག་ཁྱིམ་མི་ལ་གནས་ཚུལ་མི་ཡོང་ངམ་བསམས་བྱས།",
    "ད་དུང་ངོ་ཤེས་པ་མང་པོ་ཞིག་དེར་འདུག་ཅེས་ཟེར།",
    "ཁོ་ཚོས་ཡ་མཚན་གྱི་རྣམ་འགྱུར་གྱིས་ང་ལ་ལྟ་ཞིང་འདུག་སྟབས།",
    "ཡུན་རིང་མི་སྡོད་མྱུར་དུ་འཆི་དགོས་འདུག།",
    "ཁྱིམ་ཟློག་ང་རང་རླངས་འཁོར་ནས་འབབ་དུས།",
    "སྤེན་པད་ཅན་གྱི་བོད་བཞུགས་ཨན་བན་གྱི་ཁང་པ་དེ་མདུན་དུ་འགྱིང་ངེར་གནས་འདུག་ཅིང་།",
    "རྡོ་ཐ་སོགས་བཤམ་འདུག་ཅིང་།",
    "ཡིན་ནའི་ཁང་ཚན་སྐུ་ཞབས་ཚོས་རང་ག་པར་ཕྱིན་ཡོད་མེད་ཤེས་ཀྱི་མི་འདུག་ཁྱིམ་མཚེས་ཚོས་མལ་ཁྲིར་བསྡད་དེ་གཅིག་ཤོར་གཉིས་ཤོར་དུ་བཤད།",
    "བོད་ཆས་བཅས་སྤྲས་པའི་མི་གང་མང་ཞིག་ཡར་འགྲོ་མར་འོང་བྱེད་ཅིང་འདུག་པ་མཐོང་ནས།",
    "ད་ཁོང་རང་ཕུང་པས་མ་ཚད།",
    "ཁ་གདན་སོགས་སྒོ་རའི་དབུས་སུ་དབོར་གྱི་འདུག་ལ།",
    "ཁོ་ཚོའི་སྐད་ཤུགས་ཆེ་ལ་ང་རྒྱལ་ཆེ་བ་ཞིག་འདུག་པ་ནི་མིག་མཐོང་ལག་ཟིན་གྱི་དཔེ་དང་འདྲའོ།",
    "ཁྱེད་རང་ཨ་ཅག་ཚེ་གྲུབ་ལགས་ཡིན་པས་ངས་དྲིས།",
    "ལུག་མིག་བཅས་ལྷུག་པོར་བཞད་ཅིང་གདའ།",
    "བལ་ཆས་སྤྲས་པའི་ཚོང་པ་དེ་རྐང་པ་བསྣོལ་ནས་རྐུབ་སྟེགས་ཐོག་བསྡད་འདུག་པ་མཐོང་།",
    "ལམ་ཟུར་གྱི་ཡོ་འབོག་བར་ན་ཁང་བྱེའུ་ཡིས་ཅ་ཅོ་སྒྲོག་ཅིང་འདུག་ལ།",
    "ཚོགས་གདན་དམར་པོའི་ཐོག་ན་གྲྭ་རྒན་རྡོ་བཟང་མིག་བཙུམ་ནས་སྐྱིལ་ཀྲུང་དུ་བཞུགས་འདུག་པ་མཐོང་ན་ཡང་།",
    "རྡོ་རྗེ་རྒྱལ་མཚན་གྱི་ཟོམ་པ་རྙིང་ཟད་དེ་སྒོ་རྒྱབ་ན་དབྱུགས་འདུག་པ་སོགས་མཐོང་བའི་ཚེ་ན།",
    "མགོ་སྐྲ་དུང་ལས་དཀར་བའི་གྲུ་རྒན་ཞིག་སྐྱིལ་ཀྲུང་དུ་ཐང་ན་བསྡད་འདུག་པ་དང་།",
    "ང་རང་དབུལ་པོའི་ཁོངས་སུ་བཞག་བྱུང་།",
    "ང་རང་རྔ་ཆེན་གློག་ཁང་དུ་བསྡད་རིང་ལ།",
    "ངོ་རས་འདིའི་རང་མདངས་ཉམས་མི་འདུག་ཀྱང་།",
    "ཚོང་ལ་ལམ་འགྲོ་འདུག་ག་ངས་ཕོ་གཞོན་སྐད་ཆེན་ཞིག་ནང་དུ་འཛུལ་འོང་བ་ཐོས།",
    "མགོ་ལ་ལྕང་ལོ་དཀྲིས་འདུག་ཀྱང་།",
    "རས་ལྷ་དཀར་པོའི་ཐོག་ཏུ་མགོ་སྒྲས་ཁེངས་འདུག་པ་མཐོང་།",
    "འབར་ཚག་དང་མི་དེ་ལབ་གླེང་བྱེད་ཅིང་གདའ།",
    "ཐོན་ཟིན་རུང་ཁོ་བོའི་ལྟག་རྒྱབ་ན་ཁོ་ཚོའི་བགད་སྒྲ་ཐོས་ཀྱི་གདའ།",
    "ནོར་དཔལ་ཟུར་ཕྱག་མཛོད་ཀྱི་མགོ་སྐྲ་སྔར་མུས་བཞིན་འོད་ཐིག་ཅིག་བཞག་འདུག་ཁར།",
    "ལུས་སྟོད་དུ་ཀོ་བའི་ཅ་ཁེ་ཞིག་དང་རྐང་པར་ཀོ་ལྷམ་ཞིག་གྱོན་འདུག་པ་མཐོང་།",
    "རང་མཐོང་མྱོང་མྱོང་ཞིག་འདུག་ནོར་དཔལ་ཟུར་གྱི་ཕྱག་མཛོད་ཀྱིས་བཤད།",
    "ཇ་ཁང་དེའི་སྒོ་ཡོལ་མཐུག་ཅིང་ལྕི་བ་ཞིག་འདུག་ལ།",
    "ཟངས་སྐྱོགས་ཀྱི་ཧ་ཡང་ནང་ནས་ཇ་ལེན་རྗེས་ཧུའུ་ནང་བླུགས་པས་རླངས་པ་ཆིལ་ཆིལ་བྱེད་ཅིང་གདའ།",
    "ཡིན་ནའི་ཐག་རིང་ནས་མེ་མདའ་དང་རྫས་མེ་འབར་བའི་ལྡིར་སྒྲ་ཐོས་ཀྱི་འདུག་ངོས་ལྕམ་སྐུ་ཞབས་ཀྱི་གཟིམ་སྒོའི་མདུན་དུ་ཕྱིན་པ་ཡིན།",
    "ཁྱེད་རང་ཐུགས་ཁྲལ་མ་གནང་ལགས།",
    "ཁོ་རང་ལྐུགས་པའི་བརྟུལ་ཞུགས་མི་འཛིན་རང་འཛིན་བྱུང་སྐད།",
    "བར་སྐོར་དུ་ཉི་མའི་འོད་ཟེར་ལྷམ་མེར་འཕྲོས་ཤིང་གདའ་ལ།",
    "སྐོར་ལམ་ལ་འགྲོ་མཁན་གྱི་རྒས་འཁོགས་འགའ་སྣ་ཐ་འཐེན་བཞིན་དུ་གྱང་ཟུར་དུ་ཉི་མ་ལྡེ་ནས་བསྡད་འདུག་ཅིང་།",
    "རང་བསྡད་མཁན་མེད་ཙང་ང་ལ་དགོང་དྲོ་ཁོ་ཚོའི་སར་ཤོག་ཅེས་ལན་སྤྲད་རོགས་ཟེར་གྱི་འདུག་ཅེས་ཟེར།",
    "ཁ་ལན་སྤྲད་དུས་རྣམ་འགྱུར་ཡག་པོ་ཞིག་འདུག་ཕལ་ཆེར་རང་བཙལ་ནས་སྐད་ཆ་འདྲ་འདྲི་ཡས་མིན་འགྲོ་ཨ་ཅག་སྒྲོལ་དཀར་གྱིས་བཤད།",
    "ང་རང་གཅིག་པུར་ནང་དུ་དེ་དོན་བསམ་བློ་བཏང་ནས་བསྡད་ཀྱང་དོན་ལ་འབྲས་བུ་མ་སྨིན།",
    "རྩམ་པ་སོགས་ཁྲོམ་བཤམས་འདུག་ཅིང་།",
    "ཁང་པའི་རྩེ་ན་སྐར་ལྔའི་དར་དམར་ལྷབ་ལྷུབ་ཏུ་གཡོ་ཞིང་གདའ།",
    "ངས་སྒོ་ཁར་མི་ཞིག་ལངས་འདུག་པ་དེའི་ཕྱོགས་སུ་སྐྱོད།",
    "མི་གསུམ་གྱིས་སྒྲོག་ཙེའི་སྟེང་དུ་གང་ཞིག་འབྲི་བཞིན་འདུག་པ་མཐོང་ནའང་།",
    "རྗེས་སུ་གོ་ཆོད་ཡོང་ངོ་ཞེས་ཡང་ཡང་བསྔགས་ཤིང་གདའ་ལ།",
    "ངའི་ལྟག་བརྒྱབ་ན་འགྲེང་བའི་ཆུས་ཀྲང་ནི་ལྷག་ཏུ་མཛེས་པོ་ཞིག་འདུག་པ་ལ།",
    "ནག་ཅིང་སྣུམ་པའི་སྐྲ་ལོ་དེ་ལྷས་མ་གཉིས་ལྡན་ཞིག་བཅིངས་འདུག་ལ།",
    "དཀར་གཙང་ཟླ་བའི་བཞིན་རས་སུ་ཆུ་མིག་ལས་དྭངས་བའི་མིག་ཟུང་ཀེམ་ཀེམ་དུ་གཡོ་ཞིང་འདུག་པ་མཐོང་བྱུང་བས།",
    "ཁང་པའི་ནང་ཉལ་ཁྲི་སྟར་གཅིག་ཏུ་བསྒྲིགས་འདུག་ཅིང་།",
    "ཟུར་གྱི་མི་བུ་དག་ཀྱང་སེམས་འགུལ་ཐེབས་ནས་གཏམ་དོན་ལ་ཁ་སྣོན་བྱེད་ཅིང་འདུག་སྣང་ཚུལ་འདི་འདྲ་ཐོན་འོང་སྙམ་པ་ངེད་གཉིས་པོའི་བློ་ལ་ཡང་འཆར་མེད་སྟབས།",
    "ཕྱི་རོལ་གྱི་མི་ཇེ་མང་དུ་འགྲོ་ཞིང་འདུག་པ་མཐོང་།",
    "སྣ་ཆེན་པོའི་འོག་ན་རྩུབ་ལ་ཐུང་བའི་ཁ་སྤུ་སྐྱེས་འདུག་པ་སོགས་ཁོའི་བྱད་བཞིན་དེས་ང་ཅི་བྱ་གཏོལ་མེད་དུ་གྱུར་ནས།",
    "དེའི་ཟུར་ན་འཇིམ་རྡོས་བརྩིགས་པའི་ཆུ་སྟེགས་ཤིག་འདུག་པ་མཐོང་།",
    "འོག་ཁང་དུ་དུད་ཁྱིམ་བདུན་བརྒྱད་ཅིག་ཡོད་བཟོ་འདུག་ཅིང་།",
    "ཁྲོན་པའི་གམ་ན་ཁང་སྒོ་ཞིག་འདུག་པ་དེའི་འཁྲིས་སུ།",
    "ངས་ཕོར་མར་ལ་ཕུ་བཏབ་ནས་ཇ་འཐུང་བཞིན་དུ་ང་རང་རྔ་ཆེན་གློག་ཁང་ནས་ཚུར་སླེབས་རྗེས།",
    "ཕྱི་རོལ་ནས་ཁྱིས་ཟུག་དུས།",
    "ང་རྔ་ཆེན་ནས་ནང་དུ་ལོག་དུས།",
    "བར་སྐོར་དུ་སླེབས་གྲབས་འདུག་ཅོ་ཅོག་རང་ལོག་རྒྱུག་ང་ཁོ་དང་མཉམ་དུ་འགྲོ་མི་འདོད་སྟབས་དེ་སྐད་ཁ་ནས་ཤོར།",
    "ཕར་ཙམ་བསྐྱལ་དགོས་ནང་ལ་སླེབས་གྲབས་འདུག་རང་ལོག་ཕྱིན་ན་འགྲིག་ག་རྗེས་སུ་ཐུག་ཡོང་།",
    "རྡོ་བརྩིགས་ཀྱི་ཁང་པ་དེ་ཉེ་འདབས་ཀྱི་ཁང་པའི་དབུས་སུ་འབུར་དུ་ཐོན་འདུག་ཀྱང་།",
    "སྣ་རྩར་སྐྱུར་སིལ་ལངས་པའི་གཅིན་དྲིས་ཁེངས་འདུག་ངས་དེ་ཚོར་དོ་གལ་མ་བྱས་པར།",
    "རྒན་པོ་དེས་ཁྲོ་མིག་ཅེར་ནས་གདའ།",
    "ཁང་པ་ཕྱི་སྦུག་གཉིས་འདུག་པ་ལ།",
    "གང་དེས་ནང་གོས་ལ་དར་གོས་ཀྱི་འོག་འཇུག་དམར་པོ་ཞིག་དང་ཕྱི་གོས་ལ་སྣུམ་བུ་ནག་པོ་ཞིག་གྱོན་འདུག་པ་དང་།",
    "ཁྱེད་རང་ཟེར།",
    "ངས་གསེར་ཐང་སྲང་ཆུང་ལག་ས་བཞུགས་འདུག་ག་ས་ཞེས་དྲིས་པར།",
    "ཅོག་ཙེ་ཞིག་ཀ་བར་བརྟེན་ནས་བཞག་འདུག་པ།",
    "ལྷོ་ངོས་ཀྱི་གྱང་ལྡེབས་ཡོད་སར་ཆ་སྒམ་ཆ་གཅིག་བསྒྲིགས་འདུག་པ་དེའི་སྟེང་དུ་མཆོད་གཤོམ་ཆུང་ངུ་ཞིག་ནང་གསེར་ཟངས་ཀྱི་སྐུ་རྟེན་བཞེངས་ཤིང་།",
    "དེའི་ཟུར་ན་ཀོ་སྒམ་བརྩེགས་ནས་བཞག་འདུག་པ་ཕུད་གཞན་གྱི་ཅ་དངོས་ཅི་ཡང་མེད་པ་མཐོང་།",
    "བག་ཕེབས་ཁམས་ཡངས་ཀྱི་ངོ་རིས་དེ་ཡལ་འདུག་ལ།",
    "མིག་འོད་ཉམས་འདུག་པ་སོགས་མཐོང་སྟེ།",
    "ལག་གཡོན་མས་ལྕམ་གྱི་མགོ་སྐྲ་བཟོ་རོགས་བྱེད་ཅིང་གདའ་ནའང་།",
    "ད་ག་ལེར་དྲག་མི་ཡོང་ངམ་བསམ་གྱི་འདུག་དུས་སྐབས་དེར།",
    "ཁྱེད་རང་ལོག་ཕེབས་པ་ཤེས་བྱུང་།",
    "སེམས་ལ་ལྷག་ཏུ་དགའ་བའི་དོན་ཆེན་ཐོན་ཞིང་འདུག་པ་ལ།",
    "ང་རང་ལྷག་ཏུ་དགའ་འོས་པ་ཞིག་ལ།",
    "ནང་ནས་སྦྲང་ཚང་བརྡོལ་བ་ལྟར་གྱི་འུར་སྒྲ་དང་སྣ་ཁུང་ལ་ཚ་བེར་རྒྱུག་པའི་རྡོ་ཐའི་དྲི་མས་ཁེངས་འདུག་ལ་ཅོག་ཙེ་ཚང་མ་མིས་ཁེངས་འདུག་པ་རིག་ངས་ཕྱོགས་བཞིར་བལྟས་ནས་བསྡད་ས་འཚོལ་སྐབས།",
    "ཁོའི་མདུན་གྱི་མིས་བཀག་འདུག་རྐྱེན།",
    "སྐེ་ལ་སྐུད་པ་དམར་པོར་བརྒྱུས་པའི་གཟི་ཞིག་བཏགས་འདུག་པ་བཅས།",
    "ད་ཕྱི་པོ་ཆགས་འདུག་ནང་ལ་ལོག་ནས་ལྡེབས་ལྕི་བརྒྱབ་ན་མ་གཏོགས།",
    "ཉི་མ་ལ་ལ་བཞུད་གྲབས་འདུག་ལ།",
    "གནམ་མཐར་དགོང་ཁའི་མཚམས་སྤྲིན་དམར་པོ་གཡོ་ཞིང་གདའ།",
    "ཚོང་ཆུང་རྒྱག་མཁན་གྱིས་ཚོང་ཟོག་ཤིང་སྒམ་ནང་དུ་བསྡུ་ཞིང་འདུག་པ་དང་།",
    "ཁྱེད་རང་ལ་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "སྒོ་ཁྱི་སོགས་འདུག་པ་མཐོང་།",
    "སྤྱན་མདངས་ཉམས་པ་བཅས་རྒས་བཟོ་མངོན་ཞིང་འདུག་ཁོང་ཉལ་ཁྲིའི་ཐོག་ཏུ་སྐུ་སྨད་ལ་ཀམ་པ་ལི་ཞིག་བཞེས་ནས་སྐྱིལ་ཀྲུང་དུ་བཞུགས་ཤིང་།",
    "ཉིན་ལྟར་སྐད་ཅོར་རྒྱག་ཡས་མ་གཏོགས་ཤེས་ཀྱི་ན་མི་འདུག་ལྷ་ལྕམ་གྱིས་ཕྱག་ཕྲེང་ཕྱུག་འགོར་བརྒྱུས་ནས་གསུངས།",
    "ཁྱེད་རང་ཐུགས་བདེ་པོ་གནང་ཞིག་ང་བསྡད་པའི་གཞུག་ལ་ཁྱེད་རང་ལ་ཕོག་ཐུག་མི་ཡོང་བ་ངས་ཁས་ལེན་ཞུས་ཆོག་མ་གཞི་ནས་ང་རྣམ་ཚོའི་ཚོང་ཁང་དེ་གཉིས་ཀྱི་ཚོང་འགྲིག་ཙམ་ཡོད་ཙང་།",
    "མངར་ཆ་ཏོག་ཙམ་ནང་འདྲེན་བྱས་ན་བསམ་གྱི་འདུག་སྟེ།"
