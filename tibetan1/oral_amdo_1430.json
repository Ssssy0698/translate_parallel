    "དེ་བཞིན་གཤེགས་པ་གཅིག་གི་གདུལ་བྱ་མ་ཡིན་ན་ཐམས་ཅད་ཀྱི་གདུལ་བྱ་མ་ཡིན་ནོ་ཞེས་འདོད་ན་དེ་ལྟ་ན་ནི་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་ཚོགས་མཚུངས་པའི་ཕྱིར་ན།",
    "བཅོམ་ལྡན་འདས་གཅིག་གི་གདུལ་བྱར་མ་གྱུར་པ་ཉིད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་མང་པོ་རྣམས་ཀྱི་ཡང་སོ་སོའི་གཟུགས་མེད་རེ་རེས་གདུལ་བར་བྱ་བ་མ་ཡིན་པར་གྱུར་པ་ཡིན་ཡང་།",
    "ཁ་ཅིག་ན་རེ།",
    "གཞན་དག་ན་རེ།",
    "ཇི་སྲིད་དུ་ཁམས་གསུམ་པར་ཀུན་ཏུ་སྦྱོར་བས་ཡིན་གྱི་སེམས་ཉེ་བར་ཉོན་མོངས་པས་ནི་མ་ཡིན་ནོ།",
    "དེ་ནས་ཁྱེའུ་དེའི་ཕ་ཕྱོགས་དེར་སོང་སྟེ་དེས་བུ་གཅིག་པུ་དེ་མི་གཙང་བའི་དོང་དུ་ལྷུང་བ་མཐོང་ངོ།",
    "ཐབས་མཁས་པ་དང་ཤེས་རབ་ཀྱིས་ཡོངས་སུ་ཟིན་པས་ཀུན་ནས་ཉོན་མོངས་པ་དག་གིས་ཀྱང་མི་གནོན་ལ།",
    "ཐབས་དང་ཤེས་རབ་གཉིས་ཀྱི་སྟོབས་ཀྱིས་དེར་ཀུན་ནས་ཉོན་མོངས་པ་མེད་པའི་ཕྱིར་མ་དག་པ་དང་དག་པའི་གནས་སྐབས་བསྟན་ཏོ་ཞེས་སོ།",
    "འདོད་ཆགས་དང་བྲལ་བ་དག་གི་ངོ་བོ་གཡོ་བ་དང་རབ་ཏུ་འཇིག་པའི་རྣམ་པ་དག་དང་།",
    "འགོག་པའི་བདེན་པའི་རང་གི་ངོ་བོ་བདག་མེད་པ་དང་ཞི་བ་དང་།",
    "གཞག་པ་བཞི་བསྒོམ་མོ།",
    "ཀོའུ་ཤི་ཀ་འདི་ནི་བྱང་སེམས་ཆེན་པོའི་ཡུམ་མོ་ཞེས་པའི་དོན་ངེས་པར་འབྱིན་པའི་རྣམ་པ་སྟེ།",
    "དེ་དག་ཀྱང་ཡོངས་སུ་རྫོགས་པར་བྱ་ཞིང་དེ་དག་གིས་ལམ་གྱི་བྱ་བ་ཡང་བྱ་ལ།",
    "དེ་ལྟར་ན་གཟུགས་ཀྱི་སྟོང་པ་ཉིད་གང་ཡིན་པ་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་རྣམས་དང་རྣམ་པར་ཤེས་པའི་སྟོང་པ་ཉིད་གང་ཡིན་པ་དང་།",
    "གཟུགས་ལ་སོགས་པའི་ཕུང་པོ་རང་རང་གི་ངོ་བོ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧ཉིད་ཀྱིས་སྟོང་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་ཕུང་པོ་ཕྱི་མ་བཞི་དང་སྐྱེ་མཆེད་བཅུ་གཉིས་དང་ཤེས་པ་དྲུག་དང་རེག་པ་དྲུག་ནས།",
    "རྩེ་མོར་གྱུར་པ་དག་ཏུ་འདོད།",
    "སྔ་མ་དྲོད་ལ་བསྟན་པ་བཞིན་དུ་གཟུགས་ལ་སོགས་པའི་ཕུང་པོ་རང་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པའི་ཕྱིར།",
    "དྲོ་བ་ལ་བསྟན་པ་དེ་བཞིན་དུ་གཟུགས་ལ་སོགས་པའི་ཕུང་པོ་རང་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པའི་ཕྱིར།",
    "དེ་ལྟ་ན་ཡང་ཉན་ཐོས་རྣམས་ལས་དེ་དག་ཇི་ལྟར་ཁྱད་དུ་འཕགས་གང་གིས་ན་དེ་དག་གི་ལམ་གཞན་ཡིན་སྙམ་པའི་དོགས་པ་བསུས་ནས་བསལ་བར་བྱ་བའི་ཕྱིར།",
    "ཚིག་དང་སྨྲས་པ་དང་རབ་ཏུ་བསྙད་པ་གང་ཡིན་པ་དེ་དག་ནི་སྨྲས་པར་གྱུར་ན་ཤེས་པར་རུང་གི་གང་འཕགས་པ་རབ་འབྱོར་ཡུམ་འཆད་པ་དང་རབ་ཏུ་བརྗོད་པ་དང་སྟོན་པ་དང་ཉེ་བར་སྟོན་པ་དེ་ནི་ཤེས་པར་མི་རུང་ངོ།",
    "དེ་ནས་ཡང་རབ་འབྱོར་གྱིས་ལྷའི་བུ་དེ་དག་གི་སེམས་ཀྱི་རྣམ་པར་རྟོག་པ་སེམས་ཀྱིས་ཡོངས་སུ་ཤེས་ནས་ལྷའི་བུ་དེ་དག་ལ་སྨྲས་པ།",
    "གནོད་སྦྱིན་གྱི་སྐད་ཅེས་བྱ་བ་ནི་དེ་དག་གི་རང་གི་བརྡ་རྟོགས་པར་བྱེད་པའོ།",
    "དེའི་ཕྱིར་དེ་དག་གི་ཡེ་ཤེས་མི་རྟོགས་པ་ཉིད་ནི་ཁྱད་ཞུགས་པ་གཉིས་པ་ཡིན་ནོ།",
    "དེས་ན་དེ་དག་གི་སེམས་འདུ་འཛི་ལ་མི་འཇུག་གི་གཅིག་པུ་དགའ་བ་ལ་འཇུག་གོ།",
    "དེ་དག་ཐམས་ཅད་ནི་ཉོན་མོངས་པ་ཞི་བར་བྱེད་པའི་བགྲོད་པ་གཅིག་པུ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ནས་རབ་འབྱོར་གྱིས་ལྷའི་བུ་དེ་དག་གི་སེམས་ཀྱི་རྣམ་པར་རྟོག་པ་སེམས་ཀྱིས་ཡོངས་སུ་ཤེས་ནས་ལྷའི་བུ་དེ་དག་ལ་སྨྲས་པ།",
    "དེ་ནས་ལྷའི་བུ་དེ་དག་གིས་རངའབྱོར་ལ་སྨྲས་པ།",
    "ལྷའི་བུ་དག་གིས་སྨྲས་པ།",
    "དེ་ནས་ཤཱ་རིའི་བུ་དང་མོའུ་གལ་གྱི་བུ་ལ་སོགས་པས་སྨྲས་པ།",
    "ལམ་པ་གང་ཟག་གི་རྟེན།",
    "འོག་མིན་གྱི་བར་གྱི་ལྷ་རྣམས་ཀྱི་མེ་ཏོག་དེ་དག་གིས་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་འདིའི་གཞི་མེ་ཏོག་གིས་ཁེངས་པར་གྱུར་ནས་སྟེང་གི་བར་སྣང་ལ་ཡང་གྲགས་ཆེན་བཅོ་བརྒྱུད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧ཁང་པ་བརྩེགས་པ་མདངས་དགའ་ཞིང་ཡིད་དུ་འོང་བ་ཀུན་ནས་གནས་པར་གྱུར་ཏོ།",
    "ཤིང་དང་ལྡུམ་བུ་དང་འཁྲི་ཤིང་ལས་བྱུང་བ་མ་ཡིན་ནོ་སྙམ་མོ།",
    "འོན་ཏེ་གཟུགས་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་རྣམས་དང་རྣམ་པར་ཤེས་པ་ཡང་མ་བྱུང་བ་ཡིན།",
    "དེ་དག་ཀྱང་ཡོངས་སུ་རྫོགས་པར་བྱ་ཞིང་དེ་དག་གིས་ལམ་གྱི་བྱ་བ་ཡང་བྱ་ལ།",
    "ཀོའུ་ཤི་ཀ་གཟུགས་ནི་བཏགས་པ་ཙམ་མོ།",
    "རྩེ་མོར་གྱུར་པ་གཟུགས་ལ་སོགས།",
    "པོད་ཆེན་དྲུག་གི་དང་པོ་ཕར་ང་ཕྱིན་འགྲེལ་སྐོར།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་དང་།",
    "ལམ་ཤེས་པ་ཉིད་ཀྱི་སྐབས་སུ་ཉན་ཐོས་ཀྱི་ལམ་གྱི་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་གསུངས་པ་གང་ཡིན་པ་དེ་དག་ཀྱང་སྔ་མ་རྣམས་ལས་དམིགས་པ་དང་རྣམ་པ་དག་གིས་ཁྱད་པར་ཅན་ཡིན་ཏེ།",
    "དེ་ཁྱོད་ཀྱི་མཐུ་ཡིན་ནམ།",
    "ཁྱོད་ཀྱི་བྱིན་གྱིས་བརླབས་པ་ཡིན་ནམ།",
    "ཀོའུ་ཤི་ཀ་འདི་ནི་བདག་གི་མཐུ་དང་བྱིན་གྱིས་བརླབས་པ་མ་ཡིན་ནོ།",
    "རབ་འབྱོར་བྱང་སེམས་ཆེན་པོ་རྣམས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ནི་ཆེན་པོ་སྟེ་འདི་ལྟར་ཡུམ་མོ།",
    "འདི་ནི་མཐའ་ཡས་པ་སྟེ་འདི་ལྟར་ཡུམ་མོ།",
    "ཀོའུ་ཤི་ཀ་དེ་དེ་བཞིན་ཏེ་བྱང་སེམས་ཆེན་པོ་རྣམས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འདི་ནི་ཆེན་པོ་སྟེ་འདི་ལྟར་ཡུམ་མོ་ཞེས་པ་ནས།",
    "དེ་ནས་ལྷའི་བུ་དག་གིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ།",
    "ཀོའུ་ཤི་ཀ་ཡང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་དག་ལ་མིའམ་མི་མ་ཡིན་པ་དེ་དག་གིས་གླགས་རྙེད་པར་མི་འགྱུར་རོ།",
    "ཀོའུ་ཤི་ཀ་གཞན་ཡང་རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་གང་ཡུམ་འདི་འཛིན་ཅིང་འཆང་བ་དང་ཀློག་ཅིང་ཀུན་ཆུབ་པར་བྱེད་པ་དང་ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་ཅིང་རྣམ་མཁྱེན་ཉིད་ཀྱི་སེམས་དང་ཡང་མ་བྲལ་བར་བྱེད་པ་དེ་དག་ནི།",
    "ཁྱིམ་སྟོང་པ་དང་བླ་གབ་མེད་པ་དང་ལམ་གོལ་པ་ན་འདུག་ཀྱང་རུང་སྟེ་འཇིགས་པའམ་རེངས་པར་མི་འགྱུར་རོ།",
    "དེ་ནི་འདི་ལྟར་དེ་དག་གིས་ནང་སྟོང་པ་ཉིད་ནས།",
    "ཙམ་དུ་ཡུམ་ཟབ་མོ་འདི་ཡོངས་སུ་བཟུང་བ་ན་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་ཐམས་ཅད་ཡོངས་སུ་གཟུང་བར་འགྱུར་བ་ནི་འདི་ལྟ་སྟེ།",
    "ཀོའུ་ཤི་ཀ་གཞན་ཡང་སའི་ཕྱོགས་གང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ཡུམ་འདི་འཛིན་པ་དང་འཆང་བ་དང་ཀློག་པ་དང་ཀུན་ཆུབ་པར་བྱེད་པ་དང་ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་ཡོད་པའི་ས་ཕྱོགས་དེར།",
    "ཀོའུ་ཤི་ཀ་འདི་ལྟ་སྟེ་དཔེར་ན་རྩི་མ་གྷི་ཞེས་བྱ་བ་དུག་ཐམས་ཅད་ཞི་བར་བྱེད་པ་ཞིག་ཡོད་དེ་དེར་སྦྲུལ་ལམ་སྲོག་ཆགས་བཀྲེས་པས་མནར་ཞིང་ཟས་ཚོལ་བ་ཞིག་གིས་སྲོག་ཆགས་ཀྱི་རིགས་ལ་ལ་ཞིག་མཐོང་བར་གྱུར་ཏེ།",
    "དེ་ནས་སྲོག་ཆགས་ཀྱི་རིགས་དེ་འཆི་བས་འཇིགས་ཤིང་སྐྲག་སྟེ་རྩི་མ་གྷི་ཞེས་བྱ་བ་གང་ན་ཡོད་པ་དེར་སོང་ནས་དེ་ནས་རྩི་དེའི་དྲི་ཚོར་བ་ཙམ་གྱིས་ཕྱིར་ལྡོག་པར་འགྱུར་རོ།",
    "ཀོའུ་ཤི་ཀ་དེ་བཞིན་དུ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཡུམ་འདི་འཛིན་ཅིང་འཆང་བ་དང་ཀློག་ཅིང་ཀུན་ཆུབ་པར་བྱེད་པ་དང་ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་དེ་ལ།",
    "དེ་ཉིད་ཀྱིས་ཕྱི་དང་ནང་གི་འཚེ་བ་རབ་ཏུ་ཞི་བར་ཞེས་བྱ་བ་དེ་ལྟ་བུ་ནི་འགོག་པའི་བདེན་པའི་རྣམ་པ་དག་ཡིན་ནོ།",
    "སྡུག་བསྔལ་གྱི་ཕུང་པོ་ཆེན་པོ་འབའ་ཞིག་གི་བར་དུ་ཉེ་བར་ཞི་བར་བྱེད་དེ་རྣམ་པར་འཕེལ་བར་བྱེད་པ་མ་ཡིན་ནོ།",
    "ཀོའུ་ཤི་ཀ་དེ་ལྟར་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ཡུམ་འཛིན་ཅིང་འཆང་བ་དང་།",
    "འདྲི་བ་དང་ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་ཅིང་རྣམ་མཁྱེན་ཉིད་ཀྱི་སེམས་དང་ཡང་མི་འབྲལ་བ་དེ་དག་གིས་ཚེ་འདི་དང་ཚེ་རབས་གཞན་གྱི་ཕན་ཡོན་རབ་ཏུ་འཐོབ་པར་འགྱུར་རོ་ཞེས་པའི་དོན།",
    "ཤེས་པ་གང་གིས་བཟོད་པའི་མཇུག་ཐོགས་སུ་རྣམ་པར་གྲོལ་བ་མངོན་དུ་བྱེད་པའོ།",
    "ཤེས་པ་གང་གིས་རྗེས་སུ་རྟོགས་པར་ཤེས་པའི་བཟོད་པ་དེ་ངེས་པར་འཛིན་པའི་བཟོད་པའོ།",
    "སེམས་ཀྱི་སྐད་ཅིག་བཅུ་དྲུག་པོ་འདི་དག་ནི་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧མཐོང་བའི་ལམ་མོ།",
    "དེ་ཡང་གཞན་དུ་མི་འཐད་པས་ལམ་སྒོམ་མོ།",
    "དེ་ཕྱིན་ཅི་ལོག་ལས་བྱུང་བའི་ཉོན་མོངས་པ་དང་།",
    "དེ་བས་ན་རྣམ་པར་ཤེས་པས་རང་གི་ངོ་བོ་རྣམ་པ་ཐམས་ཅད་དུ་བཟུང་བ་ཉིད་ཡིན་ན་ཡང་ཆ་གང་ལ་ཡང་གོམས་པ་གསལ་བར་གྱུར་པ་ལ་སོགས་པས་སྒྲོ་བཏགས་པའི་རྣམ་པར་ངེས་པར་སེལ་ནུས་པ་དེ་ཉིད་ལ།",
    "ལན་ནི་གཞན་དག་ན་རེ།",
    "ཀོའུ་ཤི་ཀ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ཡུམ་ཟབ་མོ་འདི་འཛིན་པ་ནས།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་ཞིག་འཐབ་མོའི་ནང་དུ་འདུག་ཅིང་གཡུལ་ངོར་ཆས་པའི་ཚེ་དེར།",
    "གལ་ཏེ་དེས་ཡུམ་འདི་ཁ་ཏོན་དུ་བྱས་ནས་སོང་སྟེ་འདུག་ན་དེ་ཕམ་པར་མི་འགྱུར་ཏེ་གདོན་མི་ཟ་བར་རྒྱལ་བར་འགྱུར་རོ།",
    "རྒྱལ་ནས་མ་རྨས་མ་ཉམས་པར་འཐབ་མོ་དེ་ལས་ཐར་བར་འགྱུར་ཏེ།",
    "ཀོའུ་ཤི་ཀ་གང་ཡུམ་ཟབ་མོ་འདི་ཁ་ཏོན་དུ་བྱེད་ཅིང་གཡུལ་དེར་སོང་སོང་བ་ལས་སྲོག་གི་བར་ཆད་དུ་འགྱུར་བ་ནི་མི་སྲིད་དེ་གནས་མེད་སྐབས་མེད་དོ།",
    "གལ་ཏེ་དེའི་ལུས་ལ་ལ་ལ་ཞིག་གིས་མདའ་འཕངས་སམ་མཚོན་གྱིས་བཏབ་ན་ལུས་ལ་ཕོག་ཅིང་འཛུག་པར་མི་འགྱུར་རོ།",
    "དེ་ནི་འདི་ལྟར་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེས་ཡུན་རིང་པོར་ཡུམ་འདི་ཉིད་ལ་སྤྱད་དེ་བདག་གི་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་དང་།",
    "ཀོའུ་ཤི་ཀ་རྣམ་གྲངས་དེས་ན་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེའི་ལུས་ལ་མཚོན་བཏབ་བམ་མདའ་འཕངས་ཀྱང་འཛུག་པར་མི་འགྱུར་རོ་ཞེས་པའི་དོན།",
    "ཉོན་མོངས་ལས་རྒྱལ་དང་ཞེས་པའི་དོན།",
    "ཀོའུ་ཤི་ཀ་གཞན་ཡང་གལ་ཏེ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ཡུམ་ཟབ་མོ་འདི་འཛིན་པ་ནས།",
    "རྣམ་མཁྱེན་གྱི་སེམས་དང་ཡང་མི་འབྲལ་བར་འགྱུར་ན་དེ་ལ་ལ་ལ་ཞིག་གིས་དུག་གིས་གཏོར་ཏམ་བྱད་བྱས་སམ།",
    "ཀོའུ་ཤི་ཀ་འདི་ལ་སློབ་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ནི་བདག་ལ་ཡང་གནོད་པར་མི་བྱེད་གཞན་ལ་ཡང་གནོད་པར་མི་བྱེད་གཉིས་ཀ་ལ་ཡང་གནོད་པར་མི་བྱེད་དོ་ཞེས་པའི་དོན།",
    "འོག་མིན་གྱི་བར་གྱི་ལྷའི་བུ་གང་ཇི་སྙེད་པ་དེ་དག་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས་ཡུམ་ཟབ་མོ་འདི་བྲིས་ནས་འཆང་བར་འགྱུར་ཀློག་པར་འགྱུར་བ་དེ་དག་ལ་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "དེ་དག་ཀྱང་རེ་རེ་ཞིང་ཆུང་ངུ་ལ་སོགས་པའི་བྱེ་བྲག་གིས་རྣམ་པ་གསུམ་ཡིན་ལ།"
  ]
}