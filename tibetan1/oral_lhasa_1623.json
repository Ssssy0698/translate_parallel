    "འོན་ཏེ་སྔར་ཡུལ་དུ་བྱས་པ་དྲན་ནོ་ཞེ་ན།",
    "འོ་ན་ནི་གྲོགས་དག་ཉམས་སུ་མྱོང་བ་སྔ་མ་ཐམས་ཅད་དྲན་པར་འགྱུར་ཞིང་།",
    "གཅིག་པ་ཉིད་དང་རྟག་པ་ཉིད་དུ་འཛིན་པར་མི་ནུས་ན།",
    "ས་བོན་མེད་པར་མྱུ་གུ་བཞིན།",
    "སྲེད་པ་དང་བྲལ་བ་མ་ཡིན་པའི་གཉེན་པོ་གཞན་ལས་རང་ལུས་ཟད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "གཉེན་པོ་ཡོད་ན་ཡང་ལས་མི་ཤེས་པའི་ཕྱིར་དེའི་གཉེན་པོ་ལ་འདྲིས་པར་མི་རུང་ཞིང་ལས་ཟད་པར་ཡང་མི་ནུས་པའི་ཕྱིར་སྤོང་བར་རིགས་པ་མ་ཡིན་ནོ།",
    "འོན་ཏེ་ལས་དང་སྲེད་པ་གཉི་ག་ཟད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ལས་ཟད་པར་བྱ་བའི་ཕྱིར་ངལ་བ་ནི་དོན་མེད་པར་འགྱུར་ཏེ།",
    "སྲེད་པ་ཉིད་བཟློག་པར་བྱ་བ་བླའི།",
    "ལས་ཀྱང་དགག་པར་བྱ་བ་ཁོ་ནའོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "ལས་ལ་སོགས་པའི་ནུས་པ་སྣ་ཚོགས་པར་ངེས་པར་བྱེད་དོ།",
    "འབྲས་བུ་ཉིད་འབྲས་བུ་ཉམས་སུ་མྱོང་བས་ཟློག་པར་བྱེད་ཀྱི།",
    "འབྲས་བུ་མཚུངས་པར་སྟེར་བའོ།",
    "ཟད་པར་ཡང་མི་འགྱུར་ཏེ།",
    "ཁྱེད་ལ་ཡང་ལས་ཟད་པར་ཡོད་པའི་ཕྱིར་ཁས་བླངས་པ་ལ།",
    "ཇི་ལྟར་གནོད་པར་མི་འགྱུར་ཞེ་ན།",
    "ཇི་ལྟར་བྱས་པ་སྤོང་བར་འགྱུར།",
    "བྱས་པ་འཇིག་པ་མེད་པའི་ཕྱིར་རོ།",
    "འོ་ན་ཇི་ལྟར་ལས་ཟད་པར་བརྗོད་ཅེ་ན།",
    "གང་ཡང་གདོན་མི་ཟ་བར་འབྲས་བུ་སྟེར་ནུས་པ་དེ་ནི་ངེས་པ་ཁོ་ནར་འབྲས་བུ་སྐྱེད་པར་བྱེད་དེ།",
    "གང་ཡང་འདོད་ཆགས་ལ་སོགས་པ་དང་འགལ་བ་ཅན་བདག་མེད་པར་མཐོང་བ་ལ་སོགས་པ་དེ་ནི་དེ་ལས་སྐྱེས་པ་སྟེ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་ཉེས་པ་ལས་སྐྱེད་པའི་མ་འོངས་པའི་ལས་ཟློག་པར་བྱེད་ནུས་པར་འགྱུར་གྱི།",
    "བྱས་ཟིན་པ་ནི་བདག་མེད་པར་མཐོང་བས་ཀྱང་སྤོང་བ་ནི་མ་ཡིན་ནོ།",
    "འོ་ན་ཇི་ལྟར་བྱས་ཟིན་པའི་ཉེས་པ་དང་ལས་ཇི་ལྟར་འཇིག་ཅེ་ན།",
    "སྐྱོན་རྣམས་སྐྱེས་པར་འགྱུར་བ་ལ་ནི་ལྡོག་པ་མེད་ཀྱི།",
    "དེ་ནས་དེ་ཡིས་བྱས་པའི་ལས་མི་སྐྱེ་བའི་ཕྱིར།",
    "བྱས་པ་རྣམས་སྤང་བར་རིགས་པ་མ་ཡིན་ནོ།",
    "འོ་ན་ཇི་ལྟར་སྲེད་པ་བརྟེན་པར་གྱུར་ན།",
    "མ་ལུས་ཁྱད་པར་མཁྱེན་བསྒྲུབ་དང་།",
    "སྐྱོབ་པ་ལས་བཅོམ་ལྡན་འདས་བདེ་བར་གཤེགས་པ་ཉིད་དུ་ཤེས་པར་བྱ་སྟེ།",
    "མ་ལུས་པའི་ཁྱད་པར་མཁྱེན་པ་སྟེ།",
    "རབ་ཏུ་མཛེས་པ་མཁྱེན་པ་ནི་དེ་ཁོ་ན་ཉིད་མཁྱེན་པའོ།",
    "མཁྱེན་པས་སླར་མི་ལྡོག་པ་མཁྱེན་པ་ནི་བརྟན་པར་མཁྱེན་པ་སྟེ།",
    "ཁྱད་པར་མ་ལུས་པར་མཁྱེན་པ་ནི་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་མཁྱེན་པ་སྟེ།",
    "ལྷག་མ་མ་ལུས་པར་མཁྱེན་པའི་ཕྱིར་རོ།",
    "མཁྱེན་པ་དེ་བཅོམ་ལྡན་འདས་ལ་ཡོད་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་དངོས་པོ་ཐམས་ཅད་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ནི་བཅོམ་ལྡན་འདས་ཉིད་ཡིན་ནོ་ཞེས་ཤེས་པར་བྱ་སྟེ།",
    "དོན་ཐམས་ཅད་རྣམ་པ་ཐམས་ཅད་ཀྱི་མངོན་སུམ་དུ་བྱ་བ་མ་གཏོགས་པར་དངོས་པོ་ཐམས་ཅད་མི་རྟག་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "མ་མཐོང་བ་གང་ཡིན་པ་དེ་ཉིད་མ་ངེས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "མ་ལུས་པའི་ཁྱད་པར་མཁྱེན་པ་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ཁོ་ན་མཁྱེན་པས་ནི་ཕྱི་རོལ་མུ་སྟེགས་པ་ལས་ལྷག་པར་ཡིན་ནོ།",
    "བརྟན་པར་མཁྱེན་པས་ནི་རྒྱུན་དུ་ཞུགས་པ་ལས་ལྷག་པར་ཡིན་ནོ།",
    "ཁྱད་པར་མ་ལུས་པར་མཁྱེན་པས་ནི་འདོད་ཆགས་དང་བྲལ་བ་དང་།",
    "བྱས་ཆུབ་སེམས་དཔའ་ལས་ལྷག་པ་ཡིན་ཏེ།",
    "གཞན་དོན་མཁྱེན་སྦྱོར་བརྩོན་པ་ཡིས།",
    "བདེ་བར་གཤེགས་པའི་ཕྱིར་གཞན་གྱི་དོན་མཁྱེན་པར་བརྩོན་པས།",
    "བསྟན་བཅོས་ཞེས་བྱ་བའི་མིང་ཅན་བསྟན་པ་རྒྱུར་དཔོག་པར་བྱེད་དོ།",
    "གཞན་དུ་ན་གཞན་གྱི་དོན་མཁྱེན་པར་བརྩོན་པ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་ཏོ།",
    "བརྩེ་བ་དེ་ལས་གཞན་གྱི་དོན་ལ་རག་ལས་པ་ཉིད་ཀྱི་བཅོམ་ལྡན་འདས་གྲུབ་པས་ན་གཞན་གྱི་དོན་གྱི་ངལ་བ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གཞན་ཡང་བརྩེ་བས་ལེགས་པར་མཛད།",
    "བརྩེ་བ་དང་ལྡན་པས་ལེགས་པར་སྟོན་པར་མཛད་ལ།",
    "ཡང་དག་པར་སྟོན་པར་མཛད་དོ།",
    "སྔོན་པོའི་ཤེས་པ་ཅན་གྱི་སྐྱེས་བུས་སྔོན་པོ་ཤེས་ཀྱི་སྔོན་པོའོ་ཞེས་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་སོ་ཞེ་ན།",
    "ང་ཉིད་གཅིག་པུ་དེ་ཁོ་ན་ཉིད་གསུངས་པའོ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "བསྒྲུབ་བྱས་གཏན་ཚིགས་ཁྱབ་པར་ནི།",
    "ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "ཇི་སྟེ་དོན་ལ་མི་སླུ་བ་ཉིད་ཀྱང་ཇི་ལྟར་ཤེས་པར་བྱ་ཞིང་།",
    "འདིས་ནི་འཇིག་རྟེན་རྒྱང་པན་པའི་འདོད་པ་བཀག་པར་འགྱུར་རོ།",
    "རྟོགས་པ་སྤྱི་དང་ཁྱད་པར་གྱི་ཚུལ་ཅན་ཡིན་པའི་ཕྱིར།",
    "དེས་ན་སྤྱི་དང་ཁྱད་པར་གྱི་རྣམ་པ་ཁོང་དུ་ཆུད་པ་ཉིད་རིག་པས་ཤེས་པ་ནི།",
    "རྟོགས་པ་ཐ་དད་པས་ཀྱང་ཡུལ་ཐ་དད་པར་ཤེས་པར་བྱའོ།",
    "འོན་ཏེ་ཟླ་བ་གཉིས་ལ་སོགས་པ་ནུས་པ་མེད་པ་ཉིད་ཀྱིས་རྟོགས་པར་བྱེད་པའི་ཕྱིར།",
    "དེ་བཞིན་དུ་དཔེས་ཤེས་པར་གྱུར་པ་འདི་ནི་བ་མེན་ཡིན་ནོ་སྙམ་པ་དེ་ཡང་སྤྱི་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "བ་མེན་ལ་སོགས་པ་ལ་ནི་ཁྱད་པར་ཤེས་པའོ།",
    "སྒྲའི་ཡུལ་ནི་སྤྱི་ཉིད་དོ་ཞེས་ངེས་པར་གཟུང་བར་མི་རུང་སྟེ།",
    "ཞེས་ངེས་པར་བྱའོ།",
    "ངེས་པ་ནི་སྔ་མ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "དོན་མངོན་དུ་བྱེད་པས་ཤེས་པར་མི་ནུས་པའི་ཕྱིར་སྣང་དུ་རུང་བ་མ་ཡིན་ནོ།",
    "འོན་ཏེ་རྗེས་སུ་དཔག་པས་ཡུལ་ཐ་དད་པར་སྒྲུབ་ན་ལྐོག་ཏུ་གྱུར་པ་ཇི་ལྟར་དཔོག་སྟེ།",
    "འཇུག་ན་ནི་རྗེས་སུ་དཔག་པ་དོན་མེད་པར་འགྱུར་རོ།",
    "ལྐོག་ཏུ་གྱུར་པ་ལ་མངོན་སུམ་མི་འཇུག་པས་དེས་དེ་ཤེས་ན་ནི་འགལ་བར་བརྗོད་པར་བྱའོ།",
    "འབྲེལ་པ་མ་གྲུབ་པར་རྟགས་ངེས་པར་བྱེད་པ་ནི་མ་ཡིན་ལ།",
    "གཉིས་ཉིད་ནི་སྤྱི་ཡིན་པས་ཇི་ལྟར་མངོན་སུམ་གྱིས་ཤེས་པར་འགྱུར།",
    "ཤེས་པ་ནི་རང་བཞིན་ལ་འཁྲུལ་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟར་ན་སྤྱིའི་མཚན་ཉིད་བསྟན་པར་བརྗོད་པ་ལ།",
    "མངོན་སུམ་ཉིད་མེ་ལ་འཇུག་པར་བྱེད་པ་སྟེ།",
    "རྗེས་སུ་དཔག་པ་མེད་པར་མངོན་སུམ་གཅིག་པུས་འཇུག་པ་ནི་མ་ཡིན་ནོ།",
    "རྗེས་སུ་དཔག་པ་མེད་པར་ཡང་མངོན་སུམ་གཅིག་པུ་གོམས་པ་ཕུལ་དུ་བྱུང་བ་ལས་འཇུག་པར་མཐོང་བ་མ་ཡིན་ནམ།",
    "རྟགས་ལས་ངེས་པར་འཛིན་པ་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དང་པོ་མངོན་སུམ་གཅིག་པུ་འཇུག་པར་བྱེད་པར་མཐོང་བ་མ་ཡིན་ཏེ།",
    "འཇུག་པར་བྱེད་པ་མཚུངས་པ་མ་ཡིན་ནམ།",
    "དེས་ན་ཐམས་ཅད་ཀྱིས་ཐམས་ཅད་རིག་པར་འགྱུར་རོ།",
    "སྒྲའི་ཡུལ་ཡང་སྒྲ་ལས་བྱུང་བའི་ཤེས་པས་རྟོགས་པར་བྱ་བ་ཉིད་དེ།",
    "དེ་ལ་ཡང་ངོ་བོ་ཉིད་མངོན་སུམ་གྱིས་རྟོགས་པར་བྱ་བ་ཉིད་ཡིན་ལ།",
    "རང་བཞིན་གྱིས་གཏན་ཚིགས་ནི་ཐ་སྙད་སྐྱེད་པར་བྱེད་པ་སྟེ།",
    "སྒྲ་བཞིན་དུ་རྟོག་པ་ཡང་ཤེས་པར་བྱ་སྟེ།",
    "གང་ན་དོན་ཡོད་པ་དང་མེད་པ་ན་ཤེས་པ་འཇུག་པ་ལ་ལར་ངེས་པའི་རྣམ་པ་ཅན་གྱི་ཕྱིར་དོན་གཞན་མྱོང་བ་མེད་པར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་ལས་གཞན་པ་མེད་པར་རྟོགས་སོ།",
    "དེ་ནི་ཕྱི་ནས་བསྟན་པར་བྱའོ།",
    "དེ་ལས་གཞན་པ་ལྐོག་ཏུ་གྱུར་པར་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ནི་ལྐོག་ཏུ་གྱུར་པ་མངོན་སུམ་གྱིས་འཛིན་པར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་རྗེས་སུ་དཔག་པ་འཇུག་པ་མེད་པར་གྱུར་ཏེ།",
    "གཉིས་ཤེས་པ་ནི་འབྲེལ་པ་ཅན་ཉིད་རྟོགས་པ་དེ་བས་ན་མངོན་སུམ་གྱིས་ལྐོག་ཏུ་གྱུར་པ་ཉིད་ཤེས་ཀྱང་ངེས་པར་རྗེས་སུ་དཔག་པས་རྟོགས་པའི་ཕྱིར་རྗེས་སུ་དཔག་པ་འཇུག་པ་ཡིན་ནོ།",
    "མངོན་སུམ་གྱིས་ལྐོག་ཏུ་གྱུར་པ་ཉིད་གྲུབ་ཀྱང་དོན་བྱེད་པ་ནུས་པའི་སྲེག་པར་ངེས་པ་ཉིད་བསྒྲུབ་པར་བྱའོ།",
    "དེས་ན་སྔར་མངོན་སུམ་འཇུག་པར་འདོད་པ་ནི་མ་ཡིན་ནོ།",
    "ལྐོག་ཏུ་གྱུར་པའི་དངོས་པོ་ཡོད་པར་ནི་རྟགས་ལས་ཤེས་པའོ།",
    "ཅི་སྟེ་མངོན་སུམ་གྱི་ཡུལ་ནི་དོན་དམ་པར་ན་སྤྱིའི་མཚན་ཉིད་ཁོ་ན་སྟེ།",
    "འདི་ལྟར་རྫས་ལ་སོགས་པ་རྣམས་ཡོད་པ་དང་འབྲེལ་པས་ཡོད་པར་ཁས་ལེན་པ་མ་ཡིན་ནམ།",
    "དངོས་པོ་གསུམ་ཡོད་པར་བྱེད་པས་ཡོད་པ་ཞེས་རྗོད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "མངོན་སུམ་གྱི་ཡུལ་ཡིན་ལ་ཁྱད་པར་ནི་འཁྲུལ་པའོ།",
    "དེའི་ཕྱིར་ཇི་ལྟར་ཁྱད་པར་གྱི་ཡུལ་ཅན་ཡིན་ཞེ་ན།",
    "དེ་དང་འདུ་བས་འབྲེལ་པས་དངོས་པོ་རྣམས་ཡོད་པ་ཞེས་གང་བརྗོད་པ་དེ་དཔྱད་པར་བྱ་སྟེ།",
    "ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པར་འགྱུར་རོ།",
    "ཡོད་པའི་མཚན་ཉིད་དོན་བྱེད་པ་ཡིན་པར་འགྱུར་རོ།",
    "སྤྱི་ལ་སོགས་པ་ནི་ཡོད་པར་མི་འགྱུར་རོ།",
    "འོན་ཏེ་ཡོད་པ་ཡང་ཡོད་པ་གཞན་དང་འབྲེལ་པས་ཡོད་ན་དེ་ལྟ་ན་ནི་ཡོད་པ་གཞན་པོ་ཡང་ཡོད་པ་གཞན་དང་འབྲེལ་པས་ཡོད་པར་འགྱུར་བའི་ཕྱིར་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "ཁྱད་པར་ནི་མངོན་སུམ་གྱི་ཡུལ་མ་ཡིན་ནོ་ཞེས་གང་རྗོད་པར་བྱེད་པ་དེ་ལ་སྨྲས་པ།",
    "ཡུལ་ཐམས་ཅད་ལ་མ་ཁྱབ་ན་རྟག་པ་ཡོད་པར་ཇི་ལྟར་ཤེས།",
    "འདི་ལྟར་སྐད་ཅིག་ཙམ་ཡོད་པར་གནས་ཀྱི་བྱེད་པ་མེད་དོ།",
    "འོ་ན་དེ་སྐད་ཅིག་མའི་དེ་མ་ཐག་པའི་དངོས་པོ་གཞན་ནུས་པར་བརྗོད་ན་ནི་དེའི་རྗེས་ཐོགས་སུ་དངོས་པོ་གཞན་ཡོད་པ་ཡིན་ཡང་དེའི་འབྲས་བུ་མ་ཡིན་པར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "འོན་ཏེ་རྒྱུན་ནི་མེད་པ་ཡིན་ན་ནི་དེའི་ཚེ་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་དེ་ཉིད་ལ་ཡིན་པར་འགྱུར་ལ།",
    "རྒྱུན་ཡང་རྟག་པ་ཡིན་ན་འབྲས་བུ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "སྐད་ཅིག་མ་ཡིན་ན་ཡང་བྱེད་པ་མེད་པས་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་སྔར་བརྗོད་པའི་སྐྱོན་ཡོད་པ་ཡིན་ནོ།",
    "དེ་ཡང་སྐད་ཅིག་མ་ཡིན་པས་རྒྱུ་གཞན་ཡོད་པར་འགྱུར་བའི་ཕྱིར་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "ཤེས་པས་ནི་ཐམས་ཅད་ཡོད་པར་རིགས་ཏེ།",
    "ཇི་ལྟར་ཤེས་པ་ལས་ཤེས་བྱ་རྣམ་པར་གཞག་པར་བྱ།",
    "གཞན་ཡང་ཤེས་པས་དངོས་པོ་དག་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོར་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "ཡང་སྔར་འཇུག་པ་ན་ཡང་ཐུག་པ་མེད་པར་འགྱུར་བས་ཇི་ལྟར་འབྲས་བུ་ཉིད་ཡིན།",
    "འོན་ཏེ་བུམ་པ་མེད་པར་སྣམ་བུ་མཐོང་བའི་ཕྱིར་དེ་ལ་འབྲས་བུ་ཉིད་མེད་དོ་ཞེ་ན།",
    "འོ་ན་ནི་ཤེས་པ་ཡང་རྨི་ལམ་ལ་སོགས་པར་ཤེས་བྱ་དང་བྲལ་བ་མཐོང་བའི་ཕྱིར་ཤེས་བྱའི་འབྲས་བུ་ཉིད་ནི་མ་ཡིན་ནོ།",
    "འོན་ཏེ་སྣམ་བུ་དེ་ཉིད་ཡིན་པར་ངོ་ཤེས་པ་ཡིན་ན་ནི་ཤེས་པ་ཡང་ཤེས་པ་འདི་ཉིད་དོ་ཞེས་ངོ་ཤེས་པར་མཚུངས་པའི་ཕྱིར།",
    "ཤེས་པ་ཐམས་ཅད་གཅིག་པར་འགྱུར་ཞིང་།",
    "དེ་ལ་གལ་ཏེ་བདག་གཅིག་པུ་ཡིན་དུ་ཆུག་ན་ཡང་ཇི་ལྟར་གཅིག་ཉིད་རིག་པར་བྱེད།",
    "གཞན་གྱི་སྔ་ཕྱིའི་རང་བཞིན་དེའི་བདག་ཉིད་དམ་ཤེས་པ་གཞན་གྱིས་རྟག་པར་ཤེས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེ་མེད་པར་ཡང་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་རྟོགས་པར་ཇི་ལྟར་འགྱུར།",
    "མངོན་སུམ་གྱིས་རིག་པ་མ་གཏོགས་པར་རྗེས་སུ་དཔག་པ་སྐྱེ་བ་མ་ཡིན་ནོ་ཞེས་སྔ་མ་ཉིད་དུ་བརྗོད་པ་མ་ཡིན་ནམ།",
    "འོན་ཏེ་རྒྱུ་སྔ་མ་རྗེས་སུ་དཔག་པས་ཤེས་ནས་ཡང་དཔོག་ན་ནི་དེ་ལྟ་ན་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "ཕྱི་རོལ་པ་ཇི་ལྟར་མེད་པ་དེ་བཞིན་དུ་བསྟན་པར་བྱའོ།",
    "ནུས་པའི་མཚན་ཉིད་དོན་དམ་པར་ཡོད་པ་བརྗོད་པར་བྱའོ་ཞེ་ན།",
    "དེ་ཇི་ལྟར་རྗེས་སུ་དཔོག་པར་བྱེད།",
    "དྲན་པ་ཡང་དོན་དམ་པར་རང་རིག་པ་ཙམ་ཉིད་ཡིན་པ་དེ་བས་རང་རིག་པ་ལ་ངོ་བོ་ཉིད་མྱོང་བ་ཁོ་ན་སྟེ།",
    "དེ་ཇི་ལྟར་ཕ་རོལ་མི་རིག་པར་དེའི་འབྲས་བུ་གྲུབ་པ་ཡིན་པའི་ཕྱིར་ཤེས་པའམ་ཤེས་བྱ་ལ་དོན་བྱ་བ་བྱེད་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཕྱི་ནས་ཡོད་པར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "འོན་ཏེ་ཕྱིས་མཐོང་བས་སྔ་ན་མེད་པར་ཤེས་ན་ནི་དེ་ནི་གཅིག་ལ་གཅིག་བརྟེན་པའོ།",
    "ཇི་སྲིད་མ་སྐྱེས་པ་དེ་སྲིད་དུ་སྔ་ན་མེད་པར་ཇི་ལྟར་གནས།",
    "དེ་བས་ན་དེ་ལ་ཡང་རྒྱུ་ཡོད་པར་འགྱུར་ཏེ།",
    "འོ་ན་གལ་ཏེ་ཡོད་པར་གྱུར་པ་ཉིད་འབྲས་བུ་མ་ཡིན་ཏེ་བྱས་པ་ལ་བྱེད་པ་མེད་པའི་ཕྱིར་རོ།",
    "འོ་ན་ནི་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "གཞན་གྱི་ཚེ་རྒྱུ་ཡིན་ནོ་ཞེས་ལེགས་པར་སྨྲས་སོ།",
    "མངོན་དུ་བྱས་པ་ལ་རྗེས་སུ་དཔག་པ་མི་འཇུག་སྟེ།",
    "འོན་ཏེ་མངོན་དུ་བྱས་པ་ཉིད་ལྐོག་ཏུ་གྱུར་པས་ཤེས་པའི་ཕྱིར་ལྐོག་ཏུ་གྱུར་པ་ཡིན་ཞེ་ན།",
    "ཁས་ལེན་པར་མི་བྱེད་དེ།",
    "དེའི་ཚེ་འཇིག་རྟེན་གསུམ་ན་རང་བཞིན་གཉིས་པ་ཉིད་མེད་པར་འགྱུར་རོ།",
    "འོ་ན་གལ་ཏེ་ཁྱད་པར་ཅན་ཉིད་ཐ་དད་ཀྱི་དངོས་པོ་ལ་མིན་པ་དེ་ལྟ་ན་ནི་དངོས་པོ་མངོན་སུམ་ཉིད་དུ་མི་འགྱུར་ཏེ།",
    "གསལ་བ་དང་མི་གསལ་བ་ནི་ཁྱད་པར་ཅན་ལས་གཞན་པ་ཁོ་ནར་མྱོང་བར་སྐྱེ་ལ།",
    "ས་བོན་ལ་སོགས་པ་ལས་མྱུ་གུ་སྐྱེ་བར་འཇིག་རྟེན་ཐམས་ཅད་ལ་གྲགས་ཏེ་དཔྱད་པ་མེད་པར་སྣང་བ་ཡིན་ནོ།",
    "འདི་ལྟར་སྔོན་པོ་མཐོང་ངོ་ཞེས་རྟོགས་པའི་སྟོབས་ཀྱིས་སྔོན་པོར་རྣམ་པར་འཇོག་པ་དེ་ལྟ་བས་ན་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་མཐོང་བ་ལ་ལྷག་པར་ཞེན་པའོ།",
    "མ་བརྟགས་པར་ཤེས་པའི་དོན་ནི་ཀུན་རྫོབ་ཀྱི་དོན་ཏོ།",
    "ཡོད་པ་དང་མེད་པ་ཡང་མངོན་སུམ་དང་མི་དམིགས་པས་གྲུབ་པར་ཁས་ལེན་ན།",
    "དེ་ལ་གལ་ཏེ་དེ་ཉིད་ལས་འབྱུང་ངོ་ཞེས་ངེས་པར་བྱེད་ན།",
    "མངོན་སུམ་ནི་ད་ལྟར་བའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་ད་ལྟར་བའི་དངོས་པོ་འཛིན་པར་ནུས་ཀྱི།",
    "དུས་དང་ཡུལ་ཐམས་ཅད་ཀྱི་མེ་དང་དུ་བ་དང་མངོན་སུམ་གྱིས་ངེས་པར་འཛིན་ན་ནི་དེའི་ཚེ་རྗེས་སུ་དཔག་པ་དོན་མེད་པར་འགྱུར་རོ།",
    "འདི་ཡོད་པས་ཡོད་པ་ཉིད་ཅེས་ངེས་པར་གཟུང་བར་མི་རུང་སྟེ།",
    "རྗེས་སུ་དཔག་པར་བརྟག་གྲང་ན།",
    "དེ་ལ་གལ་ཏེ་མི་དམིགས་པ་རྗེས་སུ་དཔག་པ་ཡིན་པ་དེ་ལྟ་ན་ནི་མི་དམིགས་པ་དེ་ཡང་ལྡོག་པ་ལ་ལྟོས་ཤིང་ལྡོག་པ་ཡང་མི་དམིགས་པ་ལ་ལྟོས་པའི་ཕྱིར་གཅིག་ལ་གཅིག་བརྟེན་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་རྗེས་སུ་དཔག་པ་དེའི་ལྡོག་པ་ཡང་རྗེས་སུ་དཔག་པ་གཞན་གྱིས་སྒྲུབ་པ་ཉིད་ཀྱི་ཕྱིར་རྗེས་སུ་དཔག་པ་དེ་ཉིད་མཐའ་མེད་པར་འགྱུར་རོ།",
    "འོན་ཏེ་མངོན་སུམ་ཉིད་རྗེས་སུ་དཔག་པ་ཡིན་ན་ནི་དེ་ལྟ་ན་མིང་ཙམ་ཐ་དད་པར་བྱས་པར་འགྱུར་བས་མངོན་སུམ་ནི་ཡུལ་དང་དུས་ཐམས་ཅད་དུ་ལྡོག་པ་སྒྲུབ་པ་མ་ཡིན་ཏེ།",
    "འབྲེལ་པ་འཛིན་པ་མེད་པར་མ་མཐོང་བའི་དོན་ཤེས་པ་ནི་གྲགས་པར་བརྗོད་ཀྱི།",
    "མངོན་སུམ་གྱིས་དངོས་པོ་གཉིས་རྟོགས་པར་མི་འགྱུར་བས་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་དེ་དག་འབྲེལ་བར་མངོན་སུམ་གྱིས་རྟོགས་པ་མ་ཡིན་ནོ།",
    "དེའི་རྗེས་ཐོགས་སུ་ཡོད་པར་མི་རིགས་པའི་ཕྱིར་མ་མཐོང་བའི་དོན་རྟོགས་པ་ནི་དོན་གྱིས་གོ་བའོ་ཞེ་ན།",
    "གྲགས་པས་བརྗོད་པར་རིགས་པར་འགྱུར་བ་ལས།",
    "ངེས་པར་འདི་ལས་འབྱུང་ངོ་ཞེས་བྱ་བར་ཤེས་པ་ནི་མེད་དེ།",
    "འདི་ལྟར་ད་ལྟར་ན་ནི་དེའི་དེ་མ་ཐག་པར་དམིགས་ལ།",
    "གཞན་གྱི་ཚེ་ན་ཡང་དེ་ལས་མི་འབྱུང་ན་ནི་ལན་ཅིག་ཀྱང་དེའི་རྗེས་ཐོགས་སུ་དམིགས་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ལྟ་ན་ནི་ཀ་བ་ཡང་རྩིག་པའི་དེ་མ་ཐག་ཏུ་མཐོང་བར་འགྱུར་བས་དེ་ཡང་དེས་བསྐྱེད་པར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "འོན་ཏེ་ཀ་བ་ལ་སོགས་པ་ལ་འཁྲུལ་པར་མཐོང་ཞེ་ན།",
    "འོ་ན་ནི་རིགས་པ་འདིས་མྱུ་གུ་ལ་སོགས་པ་ཡང་ས་བོན་ལ་སོགས་པ་ལས་འཁྲུལ་པར་འགྱུར་རོ།",
    "འོན་ཏེ་དེ་ལ་འཁྲུལ་པར་ཤེས་པ་མ་ཡིན་པར་འཇིག་རྟེན་པ་ཡིད་རྟོན་པར་བྱེད་དོ་ཞེ་ན།",
    "འོ་ན་ནི་འཇིག་རྟེན་པའི་གྲགས་པ་ཉིད་ལ་རྒྱུ་དང་འབྲས་བུ་རྣམ་པར་གཞག་པ་ཡོད་དེ།",
    "ཀུན་རྫོབ་བམ་དོན་དམ་པར་ས་བོན་ལ་སོགས་པ་ལ་མྱུ་གུ་ལ་སོགས་པའི་ནུས་པ་ཡོད་པར་འཇིག་རྟེན་ཐམས་ཅད་ལ་གྲགས་པའོ།",
    "བག་ཆགས་མེད་པར་ཡང་ཤེས་པ་དམིགས་པ་དང་དམིགས་པ་མེད་པའི་ཤེས་པའི་ཆ་ཉིད་མེད་པར་འགྱུར་རོ།",
    "འོན་ཏེ་སྔོན་པོ་ལ་སོགས་པ་རྟོགས་པར་གྱུར་པ་ཇི་ལྟར་མི་བདེན་ཞེ་ན།",
    "སྔོན་པོ་ལ་སོགས་པ་མ་རྟོགས་པར་དེ་མྱོང་བར་མ་མཐོང་བ་དེའི་ཕྱིར་དོན་དམ་པར་ཤེས་པ་ཡང་མ་ཡིན་ལ་ཤེས་བྱ་ཡང་མ་ཡིན་ནོ།",
    "འཇིག་རྟེན་པའི་ཐ་སྙད་ཀྱང་ཆད་པར་མི་འགྱུར་ཏེ།",
    "དོན་དམ་པར་ནི་དོན་ཐམས་ཅད་ཀྱི་དབེན་པ་ཁོ་ནའོ་ཞེས་བྱ་བ་སྐབས་ཇི་ལྟ་བར་དཔྱད་པར་བྱའོ།",
    "ཀུན་རྫོབ་ནི་དོན་དམ་པར་ནུས་པ་མེད་པས་དོན་དམ་པར་སྐྱེ་བ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དོན་དམ་པར་ནི་ནུས་པ་མེད་པ་དེ་བས་ན།",
    "ཇི་ལྟར་འདས་པ་སྐྱེད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ཇི་སྲིད་འཇིག་རྟེན་གྱི་ཐ་སྙད་དོ་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་ཀུན་རྫོབ་ཀྱིས་དོན་བྱེད་པར་ནུས་ན་སྤྱི་ལ་སོགས་པ་ལ་ཡང་ཡོད་པ་མ་ཡིན་ནམ།",
    "དེ་དག་ཀྱང་དོན་དམ་པར་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཕྱི་རོལ་ཡོད་པར་ཤེས་སོ།",
    "གལ་ཏེ་ཕྱི་རོལ་མེད་པར་རྣམ་པར་ཤེས་པ་སྐྱེ་ན་ནི་དེའི་ཚེ་གང་དང་གང་ན་མིག་ཕྱེ་བ་དེ་དང་དེར་སྔོན་པོ་སྣང་བ་ཙམ་གྱི་ཤེས་པ་སྐྱེ་བར་འགྱུར་ཏེ།",
    "དཔེར་ན་མིག་རབ་རིབ་ཀྱིས་ཉམས་པ་ལ་སྐྲ་ཤད་འཛིངས་པར་མཐོང་བ་བཞིན་ནོ།",
    "དེ་ལྟ་ན་འོ་ན་ནི་སྤྱི་མེད་པར་རྟ་དང་བ་ལང་ཉིད་ཕན་ཚུན་ཐ་དད་པར་འགྱུར་ཞེ་ན།",
    "གལ་ཏེ་ཡང་བརྡ་ལ་རྩོལ་བ་ཙམ་གྱིས་བུམ་པས་དབེན་པའི་ཡུལ་དུ་ཡང་བུམ་པའི་ཤེས་པ་མེད་ན་ནི་སྤྱིའི་ནུས་པར་འགྱུར་རོ།",
    "སྐྲ་ཤད་ལ་སོགས་པ་འདི་རྟོགས་པར་གྱུར་པ་མ་ཡིན་ནམ།",
    "གཟུགས་ལ་སོགས་པ་མ་རྟོགས་པར་ཁ་དོག་ལ་སོགས་པ་མེད་དེ།",
    "དེ་མྱོང་བ་ཡང་གཟུགས་ཀྱི་རྣམ་པ་མ་ཡིན་པ་འཛིན་པར་འགྱུར་ན།",
    "དེ་ཇི་ལྟར་བུམ་པ་དང་གཟུགས་དག་ཐ་དད་པར་མྱོང་།",
    "དོན་དམ་པར་ནི་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ནི་སྐྲ་ཤད་ལ་སོགས་པ་རབ་རིབ་ཅན་གྱིས་མཐོང་བ་ཡང་དོན་བྱེད་མི་ནུས་པའི་ཕྱིར་སྤྱི་ཡིན་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་ན།",
    "སྤྱིའི་ངོ་བོ་ཉིད་ཀྱང་ཡོད་པར་འགྱུར་རོ།",
    "དེ་བས་ན་མི་དམིགས་པ་ནི་རྗེས་སུ་དཔག་པར་མི་འགྱུར་ཏེ།",
    "མེད་པ་ནི་མ་ཡིན་པར་འགག་པའི་སྒོ་ནས་དངོས་པོ་གཞན་གྱི་ངོ་བོ་ཉིད་ཡིན་པར་མངོན་དུ་བྱེད་པའི་ཕྱིར་དོན་ཁོ་ན་ཡིན་ནོ།",
    "དེ་བས་ན་མེད་པར་ངེས་པར་ཤེས་པས་དེ་ལ་དོན་ཉིད་དུ་རིགས་པ་ཁོ་ནའོ།",
    "འདི་ལྟར་སྐྲ་ཤད་ལ་སོགས་པ་བརྫུན་པར་རམ།",
    "འོན་ཏེ་མིག་མེད་པར་ཇི་ལྟར་གསལ་བ་ཉིད་ཡིན་ཞེ་ན།",
    "འོ་ན་གལ་ཏེ་ཤེས་པ་ཉིད་སྤྱིའི་རྣམ་པར་སྣང་བ་ཡིན་ན་ནི་ཤེས་པ་བཞིན་དེའི་རྣམ་པ་ཡང་ཐ་དད་པའི་ཕྱིར་ཇི་ལྟར་སྤྱིར་འགྱུར།",
    "ཕྱི་རོལ་གྱི་སྤྱི་མེད་པར་ས་བོན་མེད་ན།",
    "དེའི་ཕྱིར་མཐོང་བ་དང་རྟོགས་པའི་རྣམ་པའི་དོན་གཅིག་ཏུ་བྱས་པ་ལས་ཕྱི་རོལ་པ་རྣམས་ལ་ནུས་པ་ཞེས་བརྗོད་དོ།",
    "རྣམ་པ་ལ་སྤྱིར་ཇི་ལྟར་རྟོག་པར་བྱེད་དེ།",
    "རྗེས་སུ་དཔག་པས་སྤྱི་འཛིན་པར་བྱེད་ཀྱང་ཕྱི་རོལ་གྱི་དོན་ལ་འཇུག་པ་ནི་མ་ཡིན་ནོ།",
    "སྤྱི་ལས་གསལ་བ་རྣམས་ཁོང་དུ་ཆུད་པར་ཁས་བླང་བར་མི་བྱའོ།",
    "སྤྱི་ཉིད་ཀྱིས་མཚོན་ནས་ཤེས་པའི་ཕྱིར་གསལ་བ་རྟོགས་པར་འགྱུར་གྱི།",
    "ཁྱད་པར་གྱི་ངོ་བོ་ཉིད་ནི་མ་ཡིན་ན་ནི།",
    "ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་མཐར་གསལ་བ་དག་ངེས་པར་བྱ་བའི་ཕྱིར་གཟུགས་ལ་སོགས་པ་ཉིད་སྤྱི་ཡིན་པར་རིགས་སོ་ཞེ་ན།",
    "གལ་ཏེ་ཡང་མིག་ལ་སོགས་པ་མེད་པར་སྒྲ་ཉིད་ལས་གསལ་བར་མཐོང་བ་སྐྱེ་ན་ནི།",
    "དེ་ཡང་འབྲས་བུ་མེད་པར་དཔོག་པར་བྱེད་དོ།",
    "དེ་བས་ན་བརྗོད་པར་བྱ་བའི་ཕྱིར་སྤྱི་ནི་གཟུགས་ལ་སོགས་པའི་ངོ་བོ་ཉིད་མ་ཡིན་ནོ།",
    "དོན་ལ་འཇུག་པར་མི་འགྱུར་རོ།",
    "དེ་ལྟར་མིང་ལ་སོགས་པ་བརྗོད་པར་ཁས་ལེན་ན་ནི་མིང་ལ་སོགས་པ་ལྡན་པ་ཡིན་པའི་འདུ་བྱེད་ཅེས་བྱ་བ་སྟེ།",
    "སྨྲ་བ་པོ་དང་འབྲེལ་བའི་མིང་ལ་སོགས་པ་སྒྲས་བརྗོད་པར་འདོད་ན་ནི་དེ་ལྟ་ན་ཕྱི་རོལ་གྱི་དོན་ལ་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "ཐ་དད་པའི་ཡུལ་ཐ་དད་པ་ཅན་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "མི་རྟོགས་པར་འཇུག་ན་ནི་ཐམས་ཅད་ལ་འཇུག་པར་འགྱུར་བ་དང་།",
    "ངེས་པ་ཡང་དོན་མེད་པར་འགྱུར་རོ།",
    "མིང་ལ་སོགས་པ་རྟོགས་པས་ཀྱང་ཇི་ལྟར་མཚེ་མ་ལ་སོགས་པ་དོན་གྱི་ངོ་བོ་ཉིད་ལ་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་ཡུལ་ལ་འཁྲུལ་པར་ཡང་མི་འགྱུར་ཏེ།",
    "ཇི་ལྟར་དོན་གྱི་ཕྱོགས་སུ་ཤེས་པར་འགྱུར།",
    "ཡང་ན་ཕྱི་རོལ་པ་མིང་ལ་སོགས་པར་འདོགས་པ་གཉིས་སུ་བརྟག་ན།",
    "གང་དུ་ཤེས་པ་སྣང་བ་གང་ཡིན་པ་དེ་ཉིད་དུ་འཇུག་པར་རིགས་ཀྱི།",
    "འོན་ཏེ་དོན་གྱི་ངོ་བོ་ཉིད་ལ་མིང་ལ་སོགས་པར་འདོགས་ན་ནི།",
    "ཕྱི་རོལ་ཉིད་རྟོགས་པར་འགྱུར་གྱི་མིང་ལ་སོགས་པ་ནི་མ་ཡིན་ནོ།",
    "ཡུལ་དུ་མ་བྱས་པར་གདགས་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཤེས་པ་སྟེ་ཤེས་པའི་རྣམ་པ་བརྗོད་པར་བྱ་བ་ལ་ནི་འཇུག་པར་མི་འགྱུར་བའི་སྐྱོན་མཚུངས་པ་མ་ཡིན་ཏེ།",
    "མ་རྟོགས་པར་དོན་གྱི་ངོ་བོ་ཉིད་དུ་ཞེན་པར་འགྱུར་གྲང་ན།",
    "མིང་ལ་སོགས་པ་མ་རྟོགས་ན་ཡང་དོན་གྱི་རྣམ་པ་ཉིད་དུ་ཇི་ལྟར་རྟོགས་པར་འཐད་དེ།",
    "འདི་ལྟར་ཐམས་ཅད་ཐམས་ཅད་ཀྱི་ངོ་བོ་ཉིད་ཀྱིས་རྟོགས་པར་འགྱུར་རོ།",
    "དེ་བས་ན་མ་རྟོགས་པའི་མིང་ལ་སོགས་པར་རྟོགས་པ་ནི་ལེགས་པ་མ་ཡིན་ནོ།",
    "དེ་ལ་ཤེས་པ་ལས་ཐ་དད་པའི་མིང་ལ་སོགས་པར་བརྟགས་པ་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལ་རྣམ་པ་ནི་སྔོན་པོ་ལ་སོགས་པར་སྣང་བའོ།",
    "དེ་ལྟ་ན་ནི་འཁྲུལ་པ་དང་མ་འཁྲུལ་པའི་ཆ་མེད་པར་འགྱུར་ཏེ་ཐམས་ཅད་དོན་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་ཤེས་པ་དོན་དང་ལྡན་ན་ཡང་ན་བྱེད་པ་དང་མི་ཕྲད་པས་འཁྲུལ་པར་གནས་པའོ་ཞེ་ན།",
    "འོན་ཏེ་རྨི་ལམ་གྱི་ཤེས་པ་ལ་དམིགས་པ་དང་བཅས་པར་འདོད་ན་ནི་མ་ཡིན་ཏེ།",
    "གཞན་དུ་སྟེ་ཡུལ་མེད་པར་ཡང་མདུན་དུ་མཐོང་བའི་ཕྱིར་ཤེས་པ་ཐམས་ཅད་དོན་དང་ལྡན་པའོ་ཞེས་པ་དེ་ནི་རིགས་པ་མ་ཡིན་ནོ།",
    "དེས་ན་སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པར་སྣང་བ་ལས་རྨི་ལམ་གྱི་ཤེས་པ་སྐྱེའི་ལྡན་པ་མ་ཡིན་པའི་འདུ་བྱེད་ལས་སྐྱེས་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ཁང་ཆུང་ན་ཉལ་བའི་ཚེ་རྩིག་པས་ཆོད་པ་ཅན་དུ་ཡང་བདག་ཉིད་ཕྱི་རོལ་དུ་ཐོན་པར་སྣང་བ་དང་།",
    "གལ་ཏེ་དུས་གཞན་ན་ཡོད་པའི་དངོས་པོ་དུས་གཞན་དུ་མཐོང་ན་ནི་སད་པའི་ཚེ་ཡང་རྨི་ལམ་ལ་སོགས་པ་ན་མཐོང་བའི་དུས་ན་ཡོད་པ་ཉིད་ཀྱི་དངོས་པོ་ཡང་མཐོང་བར་འགྱུར་བའི་ཕྱིར་ཐམས་ཅད་དུ་འཁྲུགས་པར་སྣང་བར་འགྱུར་རོ།",
    "བཟློག་པར་སྣང་བ་ཉིད་གནོད་པ་ཅན་གྱི་དངོས་པོ་མྱོང་བ་མ་ཡིན་ནམ།",
    "དེ་ཐོབ་པར་ཡང་འགྱུར་རོ།",
    "འོན་ཏེ་ཡོད་པ་མ་ཡིན་པ་ཇི་ལྟར་ཕྲད་པར་ནུས་ཤེ་ན།",
    "དེ་ལྟ་ན་ནི་གཅིག་ཏུ་ཞེན་པར་བྱ་བ་ཐམས་ཅད་སྔར་ཉིད་དུ་མཐོང་བ་ཉིད་ལས་ད་ལྟ་མཐོང་བ་ནི་མ་ཡིན་ནོ།",
    "འོན་ཏེ་སྔོན་པོ་ལ་སོགས་པ་རྨི་ལམ་ལ་སོགས་པར་སྣང་བའི་དངོས་པོ་འཇིག་རྟེན་པ་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་རྨི་ལམ་གྱི་སྔོན་པོ་ལ་སོགས་པ་འཇིག་རྟེན་པ་མ་ཡིན་པར་སྐྱེའོ་ཞེ་ན།",
    "འདི་ལྟར་ཡུལ་རུང་བ་ཅན་ན་གནས་པར་གཉིད་ལོག་པ་ལས་སད་པ་ན་མི་ཤེས་པའི་སྔོན་པོ་ལ་སོགས་པ་རྨི་ལམ་ན་ཤེས་པའི་ཕྱིར་སྔོན་པོ་ལ་སོགས་པ་དེ་ཤེས་པ་ཉིད་དུ་རིགས་སོ།",
    "ད་ནི་ཤེས་པའི་མདུན་དུ་བྱ་བའི་དོན་ལ་དགོས་པ་མེད་པར་བསྟན་པའི་ཕྱིར།",
    "དེ་ཉིད་དོན་དམ་པར་ཅིས་ཤེས།",
    "དོན་མེད་ཅན་གཞན་ཐོབ་པར་འགྱུར།",
    "ཕྱིས་ཀྱང་ཐོབ་པར་འགྱུར་བ་དེ་བས་ན་དོན་གྱི་ནུས་པར་རིགས་སོ་ཞེ་ན།",
    "ཇི་ལྟར་རྨི་ལམ་དེ་འཇིག་རྟེན་པ་ལ་མ་གྲུབ་འཇིག་རྟེན་པས་རྟོགས་པར་གྱུར་པ་འཇིག་རྟེན་པ་ལ་མ་གྲུབ་པ་མ་ཡིན་ཏེ།",
    "འོ་ན་འཇིག་རྟེན་པ་ལ་མེད་པའི་རང་བཞིན་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "འོན་ཏེ་མིང་ལ་སོགས་པ་དོན་དང་འབྲེལ་པ་སྒྲས་བརྗོད་པ་དེ་བས་ན་དོན་ཁོང་དུ་ཆུད་པར་འགྱུར་རོ་ཞེ་ན།",
    "འོན་ཏེ་མིང་ལ་སོགས་པ་གང་དང་ཡང་འབྲེལ་པ་མེད་པ་ཡིན་པ་དེ་ལྟ་ན་ཡང་དོན་ལ་སོགས་པ་དང་འབྲེལ་པ་མེད་པས་ཤིན་ཏུ་གསལ་བར་འཇུག་པ་མེད་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་སྤྱི་ཡན་གར་བ་འཛིན་པ་དེའི་ཚེ་འདས་པ་ལ་སོགས་པའི་རྣམ་པར་གཞག་པ་མེད་དེ་སྤྱི་འདས་པ་ལ་སོགས་པའི་རང་བཞིན་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "གསལ་བ་ལ་མ་ལྟོས་པར་རང་རྒྱུད་པར་གཟུང་བ་དེ་དང་འབྲེལ་པ་ཅན་དུ་མི་རིགས་པའི་ཕྱིར་དང་།",
    "གལ་ཏེ་གསལ་བ་རྟོགས་པ་མེད་པར་སྤྱི་ཤེས་ན་ནི་གསལ་བས་གསལ་བྱ་མ་ཡིན་ནོ།",
    "སྤྱི་རྟག་ཏུ་དམིགས་པར་འགྱུར་བ་སྟེ།",
    "རྟག་ཏུ་དམིགས་པར་འགྱུར་རོ་ཞེས་བྱ་བར་སྙེགས་སོ།",
    "དེས་ན་རྟག་ཏུ་དམིགས་པར་འགྱུར་རོ།",
    "འོ་ན་ནི་ཐམས་ཅད་དུ་ནུས་པ་མེད་པའི་ཕྱིར་དེ་མི་དམིགས་པར་འགྱུར་རོ།",
    "དེ་ནུས་པའམ་མི་ནུས་པར།",
    "གང་ཡིན་རྗེས་སུ་འཛིན་པར་སྣང་།",
    "རིགས་ཕྱོགས་སུ་བྱས་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱི་རང་བཞིན་གྱིས་རྟག་ཏུ་རིགས་འཛིན་པར་འགྱུར་རོ།",
    "དེ་ནི་གསལ་བས་བྱས་པའི་ཕྱིར་རིགས་མེད་པར་འགྱུར་རོ།",
    "སྒྲའི་ཤེས་པས་མི་གསལ་བར་བྱས་པ་འཛིན་ལ།",
    "དེ་ཉིད་ཐ་དད་པར་སྣང་བ་ཅན་གྱི་བློ་ཚུལ་གཅིག་པ་ཅན་སྒྲ་ལ་སོགས་པ་ལས་ཅི་ལྟར་ཤེས་པར་འགྱུར་ཏེ།",
    "དེ་ལྟ་ན་ནི་སྒྲ་ནི་མདུན་ན་ཡོད་པ་མི་འཛིན་པའི་ཕྱིར་མངོན་སུམ་མ་ཡིན་པར་འགྱུར་རོ།",
    "འོ་ན་ནི་སྒྲ་ལས་ཀྱང་ཕྱི་རོལ་ཉིད་ཤེས་པར་འགྱུར་ཏེ་དེ་ཉིད་དུ་བརྡ་ཤེས་པའི་ཕྱིར་རོ།",
    "འོ་ན་ངོ་བོ་ཉིད་ཤེས་པ་ཇི་ལྟར་འདས་པ་ལ་སོགས་པ་དང་ལྡན་པར་འགྱུར་ཏེ།",
    "དམིགས་པར་གྱུར་པ་ལས་གཞན་པའི་འདས་པ་ལ་སོགས་པའི་གཟུགས་ཤེས་པ་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཆོད་པའི་གླུ་སྒྲ་མངོན་དུ་བྱས་པས་བདེ་བླག་ཏུ་ཤེས་ཤིང་དགའ་བ་སྐྱེ་བ་ཡིན་ནོ།",
    "རྟོག་པས་འབྲེལ་པར་བྱེད་པ་སྟེ།",
    "དེ་ཕྱིར་རང་བཞིན་མེད་པར་གྲུབ།",
    "རིགས་གསལ་བ་ལས་ཐ་དད་དམ་ཐ་མི་དད་པར་བརྟག་གྲང་ན།",
    "གསལ་བའི་ངོ་བོ་ཉིད་གཞན་ལ་མ་བརྟེན་པ་ཅན་རང་རྒྱུད་པར་གྲུབ་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་གསལ་བ་རྣམས་ཕན་ཚུན་རག་ལས་པ་མེད་པ་དང་ཐ་དད་པར་འཛིན་ཏོ།",
    "འོན་ཏེ་གསལ་བ་ལས་སོ་སོ་ཐ་དད་པར་སྤྱི་ཁས་ལེན་ནོ་ཞེ་ན།",
    "འོ་ན་ནི་གསལ་བས་སྤྱི་བསྐྱེད་པར་བྱ་བར་འགྱུར་ཏེ།",
    "འདི་ལྟར་འབྲས་བུ་ཉིད་ནི་ལྟོས་པའི་སྒྲས་བརྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡང་རིགས་གསལ་བ་ལ་ལྟོས་ན་ནི་དེའི་འབྲས་བུ་ངེས་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་སྤྱི་རང་བཞིན་མེད་པར་གྲུབ་པ་སྟེ་སྤྱི་རང་རྒྱུད་པ་མི་རིགས་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་དེ་ལ་འཇུག་དོན་ཅན།",
    "རིགས་དངོས་པོ་མེད་པར་གྱུར་པ་དེ་ཉིད་སྒྲས་བསྟན་པའི་ཕྱིར།",
    "དོན་བྱེད་པའི་དངོས་པོ་རྟོགས་པར་བྱ་བའི་དོན་དུ་སྒྲ་འགོད་ཀྱི་གྱི་ན་ནི་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་དེ་ལ་འཇུག་པའི་དོན་ཅན་ཏེ་ཐོབ་པར་བྱ་བའི་དོན་དུ་སྒྲས་རིགས་བསྟན་པ་མ་ཡིན་ནོ།",
    "ངོ་བོ་རྣམས་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་པ་ལ་བརྟེན་ནས་རིགས་དེར་ཀུན་དུ་རྟོགས་པའི་ཕྱིར་ཐོབ་པར་འགྱུར་རོ།",
    "ས་བོན་མེད་པར་ཇི་ལྟར་འཁྲུལ་ཞེ་ན།",
    "སྤྱི་གང་ཡིན་པ་མཐར་ཐུག་པ་སྟེ་དཔྱིས་ཕྱིན་པ་ཅན་གང་ཡིན་པའི་སྒྲ་དེ་རྣམས་ནི་སྤྱི་དེའི་ངོ་བོ་གསལ་བ་ལས་ཐ་དད་ཅི་ཡང་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་དེ་དངོས་པོ་མེད་པར་བརྗོད་དོ།",
    "དཔེར་ན་བློའི་རྣམ་པ་ཕྱི་རོལ་ལ་ལྟོས་ནས་དངོས་པོ་མེད་པར་བརྗོད་པ་བཞིན་ནོ།",
    "དོན་འཁྲུལ་པ་ལ་སྤྱི་ཡིན་པར།",
    "འདོད་པར་འགྱུར་ན་དེ་ཡང་ནི།",
    "སྤྱིའི་བློ་ལ་སྣང་བར་གྱུར་པ་ནི་གལ་ཏེ་བློ་ལ་རྣམ་པ་མེད་པར་གྲུབ་ན་སྤྱི་ཡིན་པར་འདོད་དེ།",
    "དེ་བས་ན་སྤྱི་དེ་ནི་ཤེས་པ་ཡིན་ཏེ་སྤྱིའི་བློ་ལ་སྤྱིའི་རྣམ་པར་ངོ་བོ་མེད་པ་ཡང་མཐོང་བའི་ཕྱིར་རོ།",
    "གང་ཞིག་དེ་ཉིད་དང་གཞན་དུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་དེ་ནི་ངོ་བོ་མེད་པ་སྟེ།",
    "དངོས་པོ་ཡིན་ན་གདོན་མི་ཟ་བར་ཐ་དད་པའམ་ཐ་དད་པ་མེད་པར་ཡོད་པར་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་ལེའུ་དང་པོར་གཏན་ལ་ཕབ་པོ།",
    "དེ་བས་ན་སྤྱི་དངོས་པོ་མེད་པའི་ཕྱིར་སྤྱི་དེ་བརྗོད་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "གསལ་བ་ལས་ནི་དེ་ཉིད་དང་གཞན་ཉིད་དུ་བརྗོད་པར་བྱ་བར་འགྱུར་རོ།",
    "འོ་ན་གལ་ཏེ་སྤྱི་དངོས་པོ་མ་ཡིན་ན་དེའི་ཚེ་ཇི་ལྟར་ཡང་བརྗོད་པར་བྱ་བར་མི་འགྱུར་རོ་ཞེ་ན།",
    "སྤྱི་ནི་སྤྱི་སྒྲ་གཞན་ལས་གཞན་པ་ཉིད་དུ་བརྗོད་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "འོ་ན་ཇི་ལྟར་རིགས་ཐ་དད་པར་ཤེས་ཤེ་ན།",
    "གཟུགས་ལ་སོགས་པ་ཉེ་བར་ལེན་པ་རྣམས་ཕན་ཚུན་ཐ་དད་པས་དེས་བསྐྱེད་པའི་རྣམ་པ་ཐ་དད་པ་ལ་ཉེ་བར་བཏགས་ནས་སྤྱི་ཐ་དད་པར་ཤེས་པ་ཡིན་གྱི།",
    "འདི་ལྟར་བོང་བུའི་རྭ་ལ་སོགས་པ་ཕན་ཚུན་ཐ་དད་པར་ཞེན་པ་སྟེ།",
    "སྤྱི་འདི་ལ་ཡང་བློ་ཐ་དད་པའི་རྣམ་པ་ཅན་ཡོད་པ་ཅིའི་ཕྱིར་ཁས་ལེན་པར་མི་བྱེད།",
    "སྒྲ་རྣམས་འཇུག་པར་འགྱུར་བ་ན།",
    "འོན་ཏེ་མངོན་སུམ་མ་ཡིན་པར་རྟོགས་པའི་ཕྱིར་ལྐོག་ཏུ་གྱུར་པའོ་ཞེ་ན།",
    "འོན་ཏེ་སྒྲ་འདོགས་ན་དེ་ཡང་མི་རུང་སྟེ་དོན་མེད་པར་སྒྲ་མི་འཇུག་པའི་ཕྱིར་རོ།",
    "འཇུག་ན་ཡང་མེད་པ་ལ་སྒྲ་འཇུག་པར་འགྱུར་རོ་ཞེས་བྱ་བ་འཐོབ་བོ།",
    "ཉེ་བ་མེད་པར་ཉེ་བར་གདགས་པར་མི་རུང་ངོ།",
    "འོན་ཏེ་ད་ལྟར་བྱུང་བའི་བུམ་པ་ལ་སོགས་པ་ལ་ཐ་དད་པར་འཇུག་པའི་རྒྱུ་སྤྱི་ཡོད་པས་ཐ་དད་པར་འཇུག་པའི་རྒྱུ་ཅན་གང་ཡིན་པ་དེ་ནི་དངོས་ཡིན་ལ་འདས་པ་ལ་སོགས་པ་ལ་སྒྲ་ཉེ་བར་བཏགས་པའོ་ཞེ་ན།",
    "ཐ་དད་པའི་ཁྱད་པར་ཅན་ནི་དངོས་མ་ཡིན་གྱི་འོན་ཀྱང་བློ་ཉིད་ཀྱི་དྲང་པོར་འཇུག་པ་དང་དྲང་པོ་མ་ཡིན་པར་འཇུག་པ་ནི་དངོས་དང་བཏགས་པའི་རྒྱུ་ཡིན་ཏེ།",
    "བྲམ་ཟེའི་ཁྱེའུ་ལ་ནི་དྲང་པོ་མ་ཡིན་པར་རྟོགས་པའི་ཕྱིར་དེ་ལ་སེང་གེ་ཉིད་དུ་བཏགས་པ་སྟེ།",
    "བུམ་པ་ལ་སོགས་པ་ལ་ནི་འདས་པ་དང་ད་ལྟར་བ་ནི་འཁྲུལ་པར་ཤེས་པའི་ཡུལ་མེད་པའི་ཕྱིར་ཉེ་བར་གདགས་པ་མ་ཡིན་ནོ།",
    "སྒྲ་ནི་སྐྱེ་བོས་བྱས་པ་ཡིན།",
    "ཇི་ལྟར་བུ་ལ་སོགས་པ་ཡོད་ཀྱང་བུའི་བྱ་བ་བྱེད་མི་ནུས་པ་མེད་པ་དང་འདྲ་ཞེས་སྐྱེ་བོས་རྗོད་པར་བྱེད་དེ་བུ་ནི་བུ་མ་ཡིན་ཞེས་བྱ་བའི་སྒྲ་དེ་ནི་དེ་ལ་དངོས་པོའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་དངོས་སུ་འགྱུར་རོ།",
    "དེ་བས་དངོས་པོ་གང་ཞིག་འཁྲུལ་པ་མེད་པར་རྟོགས་པ་ཅན་གྱི་ཤེས་པའི་ཡུལ་ཡིན་པ་དེ་ནི་གཙོ་བོ་ཡིན་ལ་ཅིག་ཤོས་ནི་ཉེ་བར་བཏགས་པ་ཞེས་བྱའོ།",
    "སྒྲ་རྣམས་ལས་སྔོན་པོར་སྣང་བ་དང་མི་གསལ་བའི་བློ་ཞིག་པའི་དངོས་པོ་ལ་རིག་པར་འགྱུར་བ་དེ་ཁོ་ན་ལྟར་ཏེ་སྔོན་པོའི་རྣམ་པ་མི་གསལ་བའི་མ་ཞིག་པའི་དངོས་པོ་ལ་ཡང་མཐོང་བར་འགྱུར་རོ།",
    "དེ་ལྟར་མེད་པའི་དོན་སྣང་བ་དང་ཁྱད་པར་མ་ཡིན་པར་སྣང་བ་ནི་བདེན་པ་དང་ཡོད་པའི་ཡུལ་གང་ཡིན་པ་ཅན་རྣ་བ་ལ་སོགས་པའི་རྣམ་པར་ཤེས་པ་རྣམས་ལ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "མིག་དག་པའི་རྣམ་པར་ཤེས་པ་ནི་ཡུལ་སོ་སོར་ངེས་པ་ཉིད་ལ་སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་ཅན་དང་མི་སླུ་བ་སྐྱེ་ཞིང་སྒྲ་ལས་ན་ཞིག་པ་དང་མ་ཞིག་པ་ལ་རྣམ་པ་གཅིག་པ་ཅན་ཡིན་པའི་ཕྱིར་དངོས་པོ་འཛིན་པ་མ་ཡིན་ནོ།",
    "སྤྱི་ཙམ་འཛིན་པར་བྱེད་པའི་ཕྱིར།",
    "ཇི་སྟེ་དངོས་པོ་མེད་པ་ལ་སྒྲ་ལས་བྱུང་བའི་ཤེས་པ་འཇུག་པར་ཅིས་ཤེས།",
    "འོན་ཏེ་རྟོགས་པ་ཉིད་དངོས་པོ་མེད་པ་ལ་ནི་འཇུག་ན་ནི་ཞིག་པ་མ་ཤེས་པར་སྣང་བ་ཐ་དད་པའི་མེད་པ་ཤེས་པ་མེད་པ་ཉིད་མ་ཡིན་ནམ།",
    "དེས་ན་འདི་ལྟར་རྟོགས་པས་ཞིག་པར་ངེས་པར་བྱེད།",
    "འོན་ཏེ་ཐེ་ཚོམ་ཡོད་དེ་མེད་པར་ངེས་པ་ནི་མ་ཡིན་ནོ་ཟེར་ན།",
    "གལ་དེ་སྒྲ་ལས་སྐྱེས་པའི་ཤེས་པ་དངོས་པོའི་ཡུལ་ཅན་ཡིན་ན་འདས་པ་ལ་སོགས་པའི་རྣམ་པར་གཞག་པ་མི་འཐད་དོ།",
    "ཕན་ཚུན་ཁྱད་པར་ཅན་རྣམས་དངོས།",
    "ཁྱད་པར་མེད་པར་ཇི་ལྟར་འགྱུར།",
    "གང་རྗེས་སུ་དཔག་པས་ཁྱད་པར་མེད་པར་གཟུང་བ་དེ་གལ་ཏེ་ཤེས་པའི་རང་བཞིན་ཡིན་ན་ནི་རྗེས་སུ་དཔག་པ་དངོས་པོའི་ཡུལ་ཅན་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་ཁྱད་པར་ཅན་གྱི་ངོ་བོ་ཉིད་ཕྱི་རོལ་པ་རྣམས་ཕན་ཚུན་ཁྱད་པར་མེད་པའི་ངོ་བོ་ཉིད་དུ་ཇི་ལྟར་རུང་སྟེ།",
    "ཁྱད་པར་ཅན་དང་ཁྱད་པར་མེད་པའི་རང་བཞིན་གང་གཅིག་པ་ཉིད་དུ་འགལ་བའི་ཕྱིར་རོ།",
    "འོན་ཏེ་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ཅན་གྱི་ངོ་བོ་ཉིད་ལ་བ་ལང་ལ་སོགས་པ་མངོན་སུམ་ཉིད་ཀྱིས་མཐོང་བ་སྟེ་དེ་བས་ན་སྤྱི་ཁྱད་པར་གྱི་བདག་ཉིད་ཅན་ནི་དངོས་པོའོ་ཞེ་ན།",
    "རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པའི་ངོ་བོ་ཉིད་ཀྱིས་ངོ་བོ་ཉིད་གཉིས་སུ་འགྱུར་ན་ནི་སྤྱི་ཁྱད་པར་གྱི་བདག་ཉིད་ཅན་གྱི་དངོས་པོ་དེ་ངོ་བོ་གཅིག་ཏུ་ཇི་ལྟར་འགྱུར།",
    "ཇི་ལྟར་སྤྱི་ཁྱད་པར་གྱི་བདག་ཉིད་ཅན་དངོས་པོར་འགྱུར།",
    "འོན་ཏེ་ཁྲ་བོ་དང་ནག་པོ་དེ་དག་ལས་སྤྱི་ཐ་དད་པ་ཉིད་མཚུངས་པར་ཁྲ་བོ་དང་ནག་པོ་ལ་ཡོད་པར་འདོད་དོ་ཞེ་ན།",
    "འོན་ཏེ་སྤྱི་ཁྱད་པར་གྱི་བདག་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་བུམ་པའི་སྤྱི་ཀ་བ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་ཁྱད་པར་དང་འབྲལ་བར་ཅི་ལྟར་ཤེས།",
    "འོན་ཏེ་ཁྱད་པར་དང་འབྲེལ་པ་ཅན་གྱི་རང་བཞིན་ཉིད་སྤྱི་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལྟ་ན་ཡང་ཁྱད་པར་ཐམས་ཅད་སྣང་བར་འགྱུར་ཏེ།",
    "སྤྱི་ཁྱད་པར་ཐམས་ཅད་དང་འབྲེལ་པའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་དང་དེ་ཡང་མངོན་སུམ་གྱིས་འཛིན་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་སྤྱིའི་ངོ་བོ་ཉིད་འཛིན་པ་ཁྱད་པར་གསལ་བ་དང་འབྲེལ་པ་ཅན་ཉིད་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "མ་ཡིན་ཏེ་གསལ་བ་དང་འབྲེལ་པ་ཉིད་ལས་ཐ་དད་པར་སྤྱིའི་རང་བཞིན་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ལྡོག་པ་སྤྱིར་འདོད་པས་ཀྱང་ཕན་ཚུན་ཁྱད་པར་ཅན་དུ་གྱུར་པའི་ངོ་བོ་ཉིད་དུ་ཇི་ལྟར་འགྱུར།",
    "ཐ་དད་ན་ཡང་དེའི་ལྡོག་པའོ་ཞེས་འབྲེལ་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "ལྡོག་པའི་སྤྱི་ལ་ཉེས་པ་མེད་དེ་ཕན་ཚུན་ཁྱད་པར་ཅན་དུ་གྱུར་པ་རྣམས་གཞན་ལས་ལྡོག་པ་ཡོད་པའི་ཕྱིར་རོ།",
    "སྣ་ཚོགས་མ་མཐོང་བ་ཅན་གྱི་མཚུངས་པའི་ངོ་བོ་ཉིད་ཅིས་ཟློག་པར་བྱེད།",
    "འོན་ཏེ་ཁྱད་པར་རྣམས་ལ་ཅི་ལྟར་སྤྱི་རྟོགས་པ་ཡིན།",
    "འདྲི་བ་འདིའི་དོན་ནི་སྤྱི་མ་ཡིན་པའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ཇི་ལྟར་སྤྱིའི་བློར་འགྱུར་ཞིང་སྤྱི་བློའི་ཡུལ་མ་ཡིན་པར་མི་འགྲུབ་སྟེ་སྤྱིའི་བློ་མྱོང་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "སྤྱིའི་རྣམ་པ་ཅན་ཉིད་ནི་འཁྲུལ་པའི་ངོ་བོ་ལས་ཐ་དད་པར་བསྟན་པར་མི་ནུས་པ་དེའི་ཕྱིར་འདི་མཚུངས་པའི་ངོ་བོ་ཉིད་ཀྱིས་དངོས་པོ་མེད་པའི་མཚན་ཉིད་དེ་ངོ་བོ་ཉིད་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་རིགས་ལ་ཡང་ཐ་དད་པའི་མཚུངས་པའི་རྣམ་པ་ཅན་ཡོད་པར་འགྱུར་བའི་ཕྱིར་རིགས་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "རིགས་ལ་ཡང་རིགས་གཞན་ངོ་ཤེས་པས་རྟོགས་སུ་རུང་བའི་ཕྱིར་རིགས་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "འཇིག་པ་ནི་ཡོད་པ་ཙམ་དང་འབྲེལ་པ་ཅན་ཡིན་པའི་ཕྱིར་དངོས་པོར་གྱུར་ན་གདོན་མི་ཟ་བར་འཇིག་པར་འགྱུར་རོ།",
    "གལ་ཏེ་སྔ་ཕྱིར་སྒྲོ་འདོགས་པ་མེད་པར་བརྡ་སྦྱོར་བ་མེད་པ་དེ་ལྟ་ན་མི་ནུས་པར་འགྱུར་བས་བརྡ་ལས་དངོས་པོ་རྟོགས་པར་མི་འགྱུར་བ་ཉིད་ཡིན་ནོ།",
    "འོན་ཏེ་སྒྲའི་སྟོབས་ཉིད་ལས་བརྡ་མེད་པར་ཡང་ཐ་སྙད་ཀྱི་དུས་སུ་ཤེས་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྤྱིའི་བློ་ནི་བརྡ་འཛིན་པ་མེད་པར་དེ་དངོས་པོའི་དངོས་ལས་སྐྱེ་བ་མ་ཡིན་ནོ།",
    "འོན་ཏེ་སྤྱིའི་བློ་ནི་བརྡ་འཛིན་པ་མེད་པར་གསལ་བ་གཞན་མཐོང་བ་ལས་འབྱུང་ངོ་ཞེ་ན།",
    "སྤྱིའི་ཐ་སྙད་བསྒྲུབ་པར་བྱ་བ་དེ་ལ་ཡང་གསལ་བ་གཞན་དེ་ཉིད་རྟགས་མ་ཡིན་ནམ།",
    "འོན་ཏེ་ཁྲ་བོ་ལ་སོགས་པ་ཉེ་བར་གྱུར་ན་བརྡ་འཛིན་པ་མེད་པར་ཡང་བ་ལང་བ་ལང་ཞེས་བྱ་བའི་ཤེས་པ་མཐོང་བ་མ་ཡིན་ནམ།",
    "འོན་ཏེ་རྣམ་པ་གཅིག་པ་ཅན་གྱི་བློ་ས་བོན་མེད་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "དེ་ལྟ་ན་ཡང་རྟག་པ་དང་མི་རྟག་པའི་རྣམ་པ་ཅན་ཕན་ཚུན་འགལ་བ་དང་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དེ་བཞིན་ཏེ་བརྡ་མེད་པར་མི་ཤེས་པའི་ཕྱིར་ཅི་ཡང་བྱེད་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "ཇི་ལྟར་རིགས་མེད་པར་ཤེས་པ།",
    "རིགས་ནི་རྣམ་པར་གསལ་བར་བྱེད།",
    "ཇི་ལྟར་རིགས་དེ་མེད་པར་འགྱུར།",
    "འོན་ཏེ་རྟོག་པ་མེད་པའི་ཤེས་པ་ལ་རིགས་མི་སྣང་བར་འདོད་ན་ནི་རྟོག་པ་མེད་པའི་ཤེས་པ་རིགས་འཛིན་པར་མི་འགྱུར་བ་མ་ཡིན་ནམ།",
    "མྱོང་བར་གྱུར་པ་མེད་པར་མི་རུང་སྟེ།",
    "གལ་ཏེ་སྤྱི་ཡོད་པར་གྱུར་ན་རྟོག་པའི་ཤེས་པའམ་རྟོག་པ་མེད་པའི་ཤེས་པ་ལ་སྣང་བར་འགྱུར་བ་ཞིག་ན།",
    "དེ་ཇི་ལྟར་རྣམ་པ་གཞན་དུ་མ་བས་རིགས་རྣམ་པ་གཞན་པོ་འཛིན་པར་འགྱུར།",
    "དེ་བས་ན་སྣང་བ་མེད་པར་གྲུབ་པ་ཡིན་ནོ།",
    "དེ་མེད་པར་མི་དམིགས་པས་ཇི་ལྟར་ཤེས་པར་བྱེད་དེ་བརྗོད་པ་དང་ཤེས་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དོན་བྱེད་པར་ཡང་མི་ཤེས་སོ།",
    "མི་སྣང་བ་དེ་ཉིད་ཀྱི་ཕྱིར་སྤྱི་དེ་ནི་ཤེས་པ་ཙམ་སྐྱེད་པར་བྱེད་པར་མི་ནུས་སོ།",
    "མཚན་གཞིའི་མཚན་ཉིད་དངོས་པོ་ནི་བརྟགས་པའི་ཕྱིར་རོ་ཞེས་འཆད་པར་འགྱུར་རོ།",
    "མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་ནི་ཡུལ་ཐ་དད་པས་ཐ་དད་པར་རིགས་ཀྱི་མི་དམིགས་པ་ལ་སོགས་པ་ནི་ཡུལ་ཐ་དད་པ་མ་ཡིན་ཏེ།",
    "འོན་ཏེ་རྟགས་ཐ་དད་པར་མཐོང་བས་སོ་ཞེ་ན།",
    "སྤྱིའི་དངོས་པོ་མེད་པར་གྱུར་ན་དབྱེ་བ་འདི་དག་མི་རུང་ངོ།",
    "དངོས་པོ་ཉིད་དུ་མཚུངས་ན་ཇི་ལྟར་དངོས་པོ་དང་དངོས་པོ་མེད་པར་དབྱེ་བར་བྱ་ཞེ་ན།",
    "མེད་པར་ཞེན་པ་ནི་མི་དམིགས་པས་ཡིན་ནོ།",
    "གཉི་ག་འཛིན་པའི་རྣམ་པར་རྟོག་པ་ནི་འབྲས་བུའི་གཏན་ཚིགས་ཀྱིས་བསྐྱེད་པ་སྟེ།",
    "སྒྲུབ་བྱེད་ཐ་དད་པ་ཅན་ནི་ཡོད་པ་དང་མེད་པ་ཐ་དད་པར་བྱེད་པ་འབྲས་བུའི་གཏན་ཚིགས་ཡིན་ཏེ།",
    "གཞན་དུ་ཡང་སྟེ་ཡོད་པ་མ་གཏོགས་པར་འདས་པ་ལ་སོགས་པ་ལ་མཐོང་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་ནི་གཞལ་བྱ་གཉིས་ཕྱིར་ཞེས་བྱ་བ་མི་འཐད་པར་འགྱུར་རོ།",
    "དོན་དམ་པར་གཞལ་བྱ་མེད་དོ་ཞེ་ན།",
    "ངོ་བོ་ཉིད་དམིགས་པར་གྱུར་པ་ཉིད་ཡོད་པའོ།",
    "དམིགས་པས་ཤེས་པར་གྱུར་པ་ཡོད་པ་ཡིན་ནམ།",
    "དམིགས་པར་གྱུར་པ་ཉིད་ནི་ཡོད་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "བོང་བུའི་རྭ་ལ་སོགས་པ་མི་དམིགས་པར་གྱུར་པ་མེད་པར་ངེས་པ་མ་ཡིན་ནམ།",
    "མཐོང་ན་ནི་ཡོད་པར་ཐ་སྙད་འདོགས་པའི་ཕྱིར་དམིགས་པ་ལ་ཡོད་པ་ཞེས་བརྗོད་དོ།",
    "མངོན་སུམ་ཉིད་མངོན་སུམ་ཡིན་པར་འགྱུར་བ་ནི་མ་ཡིན་ཏེ།",
    "མངོན་སུམ་གྱི་ངོ་བོ་ཉིད་ཀྱིས་ལྐོག་ཏུ་གྱུར་པ་ཡང་རྟོགས་པར་གྱུར་པ་མ་ཡིན་ནམ།",
    "དེའི་ཚེ་རྗེས་སུ་དཔག་པ་དོན་མེད་པར་འགྱུར་རོ།",
    "གང་མངོན་སུམ་དེ་ཉིད་ལྐོག་ཏུ་གྱུར་པར་ཇི་ལྟར་འགྱུར།",
    "ཇི་ལྟར་མི་དམིགས་པས་མེད་པར་འགྱུར་ཞེ་ན།",
    "དེ་བས་ན་གསལ་བའི་རྣམ་པ་ཅན་ཉིད་རྗེས་སུ་དཔག་པར་རིགས་སོ།",
    "འོན་ཏེ་ཕྱིས་ཀྱི་ཤེས་པས་སྔར་ཡོད་པར་ཤེས་པར་བྱེད་ཅེ་ན།",
    "ཕྱིས་མཐོང་བ་ནི་དེ་ཉིད་ཀྱི་ཚེ་ཡོད་པར་རིགས་པ་མ་ཡིན་ནམ།",
    "དེ་ལྟ་ན་ནི་ལྟོས་ནས་བྱས་པའི་ཕྱིར་སྤྱི་དོན་དམ་པར་ཡོད་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "དངོས་པོ་དང་ཕྲད་པར་བྱེད་པའི་སྒོ་ནས་ཐ་སྙད་འདོགས་པས་དུ་མ་ཤེས་ནས་དངོས་པོ་ཡིན་ནོ་ཞེས་ཐ་སྙད་འདོགས་སོ།",
    "འོན་ཀྱང་གཞལ་བྱ་ཐ་དད་པ་ནི་བརྟགས་པའི་ངོ་བོ་ཉིད་དེ་ཐོབ་པར་བྱེད་པ་ནི་གང་མངོན་སུམ་དུ་གྱུར་པ་དེ་ཉིད་རྗེས་སུ་དཔག་པར་བྱ་བའོ།",
    "འོ་ན་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་གཉིས་དོན་དམ་པ་ཡུལ་དུ་བྱེད་པའི་ཕྱིར་ཇི་ལྟར་ཐ་དད་པར་འགྱུར་ཏེ།",
    "དེས་གཉིས་པ་གཞན་གྱི་ངོ་བོ་ཉིད་ཀྱིས་རྟོགས་པ་འཁྲུལ་པར་བརྗོད་དེ།",
    "ཡང་ན་གལ་ཏེ་གཞན་གྱི་ཚུལ་གྱིས་རྟོགས་ན་ནི་ཇི་ལྟར་དངོས་པོ་དེ་རྟོགས་པར་འགྱུར་ཏེ།",
    "དེ་ལ་གཞན་གྱི་ངོ་བོ་ཉིད་རྟོགས་ན་དངོས་པོ་གཞན་ཐོབ་པར་ཇི་ལྟར་འགྱུར་ཏེ།"
  ]
}