    "མཛུབ་མོ་བསྒྲེང་བའོ།",
    "དེ་ལྟར་ཉི་མ་རེ་རེ་ཞིང་མཚམས་ཀྱི་རིམ་པ་ཉིད་ཀྱིས་ཞེས་པ་ནི་ཉིན་པར་བཟླས་བརྗོད་ཀྱི་མཚམས་ཏེ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་དག་གི་མཚན་མ་བྱུང་ན།",
    "ཚེ་འདི་ཉིད་ལ་བྱུང་གི་བར་དུ་སྦྱིན་སྲེག་བྱའོ་ཞེས་པ་ནི་ཕྱིའི་དུས་སུ་མི་བསྡད་དེ་ཅི་སྲིད་མཚན་མ་དེ་ལྟ་བུ་དག་བྱུང་གི་བར་དུ་སྦྱིན་སྲེག་གི་ཆོ་ག་འདི་དག་ཅེས་པ་ནི།",
    "བུ་དང་བུ་མོ་དང་ནོར་དང་འབྲུ་རྣམས་རྒྱས་ཤིང་འཕེལ་བར་བྱེད་པའོ།",
    "སྐབས་འདིར་བསྟན་པའི་སྦྱིན་སྲེག་གི་ཐབ་འདི་དག་ནི།",
    "རྡོ་རྗེ་རྩེ་མོའི་རྒྱུད་ལས་ཕལ་ཆེར་དེ་རྣམས་ཀྱི་ཆེ་ཆུང་ཇི་ཙམ་དུ་བྱ་བའི་ཚད་དེས་གསལ་པོར་མི་འབྱུང་སྟེ།",
    "ཐབ་དེ་དག་གི་དབྱིབས་ཀྱི་ཁྱད་པར་ཞེས་པ་ནི།",
    "བུ་དང་བུ་མོ་དང་ནོར་ལ་སོགས་པ་རྒྱས་ཤིང་འཕེལ་བར་བྱེད་པ་ནི་རིགས་རྒྱས་པ་སྟེ།",
    "སྔ་མ་ལྟ་བུའི་ཤིང་གིས་མེ་སྦར་རོ།",
    "སྲེག་རྫས་ཀུ་ཤའི་ཆུན་པོ་དག་རེ་རེ་ནས་ཡུངས་ཀར་གྱི་མར་ལ་སྤགས་ཤིང་སྦྱིན་སྲེག་བྱ་བའོ།",
    "དེ་ལ་སྦྱིན་སྲེག་གི་ལས་བཅུ་དྲུག་པོ་འདི་ཞེས་པ་ནི།",
    "སྦྱིན་སྲེག་གི་བྱེ་བྲག་གི་རྣམ་གྲངས་བཅུ་དྲུག་ཏུ་ཕྱེ་ནས་བསྟན་པ་འདིའོ།",
    "རྡོ་རྗེ་ཕྲ་མོའི་ཏིང་ངེ་འཛིན་ལ་མོས་པ་རབ་ཏུ་གོམས་པར་བྱས་པས་ཞེས་པ་ནི།",
    "སྨེས་གསོལ་བ་བཏབ་ནས་ཉི་མ་རེ་རེ་ཞིང་ཐོག་ཐག་སྦྱིན་སྲེག་བྱས་ན་འགྲུབ་པར་འགྱུར་རོ་ཞེའོ།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་ཆོ་ག་ཉམས་པ་ལྟ་བུ་མཆིས་ན་དེ་བདག་ལ་བཟོད་པར་གསོལ་ལོ་ཞེས་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་མཚན་མོའི་སྦྱིན་སྲེག་ཅེས་པ་ནི།",
    "སྒྲུབ་པ་ཆེན་པོའི་དུས་སུ་སྦྱིན་སྲེག་གི་ལས་འབད་ནས་བྱའོ།",
    "ཇི་ལྟར་འདོད་པའི་དངོས་གྲུབ་ཅེས་པ་ནི་སྒྲུབ་པ་པོ་ཉིད་གང་ལ་དགའ་ཞིང་མོས་པའི་དངོས་གྲུབ་སྒྲུབ་པར་བྱེད་པའོ།",
    "རྟག་ཏུ་ཉི་མ་རེ་རེ་ཞིང་སྦྱིན་སྲེག་བྱེད་པ་ཞེས་པ་ནི།",
    "དེ་ལྟར་དངོས་གྲུབ་མ་ཐོབ་ན་ཉིན་མཚན་གྱིས་དུས་སམ་རྟག་པར་ཉི་མ་རེ་རེ་ཞིང་ངམ་མཚན་མོ་ཇི་ལྟ་བ་བཞིན་དུ་སྦྱིན་སྲེག་གི་ལས་བར་མཚམས་མེད་པར་ནུས་ཐང་དུ་བྱ་སྟེ།",
    "མཚན་མོ་སྤྱོད་པའི་ཞེས་པ་ནི།",
    "དེ་ནས་ཇི་ལྟར་སྤྱན་དྲངས་པའི་རོལ་མོ་དང་ཞེས་པའི་གང་སྤྱན་དྲངས་ཤིང་བསྒྲུབས་པའི་ལྷའི་རིམ་པ་དང་།",
    "དེ་ནས་མེ་རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་།",
    "མེ་ལྷ་དེའི་སྔགས་དེ་ཉིད་ཀྱིས་སླར་དང་པོར་རང་གི་གནས་སུ་བཏང་ལ།",
    "གང་ཟག་གཅིག་གི་དོན་དུ་དགོངས་པ་མ་ཡིན་ཏེ།",
    "ཚིག་གི་བདུད་རྩི་འཐུང་བ་རྣམས།",
    "གང་ལ་མོས་པ་བཞིན་དུ་བསྒྲུབ་པར་བྱ་བའི་ཐབས་ཀྱི་ཚིག་འདིར་བསྡུས་པ་སྟེ།",
    "ཞེས་བྱ་བའི་ཚིག་གིས་བསྡུས་ཏེ།",
    "དེའི་ཚིག་གི་བདུད་རྩི་འཐུང་བ་ནི།",
    "ཚིག་གི་བདུད་རྩི་འཐུང་བ་རྣམས།",
    "མཐའ་རྣམ་པ་གཉིས་སུ་འཆི་བ་རྣམས་གསོ་ཞིང་སློང་བར་བྱེད་པའི་བདུད་རྩི་ཡིན་པས་ཚིག་གི་བདུད་རྩི་སྟེ།",
    "ཚིག་གི་བདུད་རྩི་འཐུང་བ་རྣམས།",
    "ཚིག་གི་བདུད་རྩི་འཐུང་བ་རྣམས་ཀྱིས་ཅིར་འགྱུར་ཞེ་ན།",
    "རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོར་གསུངས་པའི་ཡེ་ཤེས་སེམས་དཔའ་མཉེས་པར་བྱ་བའི་ཆོ་ག་རྒྱུད་ཀྱི་དོན་ལ་འཇུག་པའི་ཚིག་གི་དོན་ལ་རྣམ་པར་དབྱེ་བ་སློབ་དཔོན་པདྨ་བཛྲས་མཛད་པ་རྫོགས་སོ།",
    "ཅུང་ཟད་བདག་གིས་ཅི་རྟོགས་དག་པའི་ལུང་གི་ཚུལ།",
    "འདི་ནི་ཡུན་རིང་གནས་ཕྱིར་བདག་གིས་རྣམ་པར་བསམས།",
    "དེ་ལ་ཕན་གདགས་ཕྱིར་ནི་རང་གི་སྟོབས་བསྐྱེད་དེ།",
    "དེ་ཉིད་བསྡུས་ཏེ་བདག་གིས་གུས་པས་རྣམ་པར་དབྱེ།",
    "རྒྱུད་འདི་ལ་ཡང་འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཡང་དག་པར་སྡུད་པར་བྱེད་པས་མངོན་སུམ་དུ་ཐོས་པར་སྟོན་ཏོ།",
    "ཁྱོད་ཀྱིས་དུས་གང་གི་ཚེ་ཐོས་ཤེ་ན།",
    "ལན་ཅིག་གི་དུས་ཚོད་ན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལ་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ནི་བཅོམ་པ་དང་ལྡན་པས་ན་བཅོམ་ལྡན་འདས་ཏེ་ངེས་པའི་ཚིག་གི་ཚུལ་གྱིས་ན་ཡི་གེ་བསྒྱུར་བ་བྱས་ན་ཕུང་པོ་དང་།",
    "ཉོན་མོངས་པ་དང་།",
    "གང་གིས་རྒྱུད་འདི་སྟོན་པར་མཛད་པའི་རྒྱུད་ཀྱི་བདག་པོ་བཅོམ་ལྡན་འདས་འདི་ཡོན་ཏན་ཇི་ལྟ་བུ་དང་ལྡན་ཞེ་ན།",
    "དེ་ལྟ་བུའི་དམ་ཚིག་མཁྱེན་པ་ལ་ནི་དམ་ཚིག་གི་ཡེ་ཤེས་ཞེས་བྱ་སྟེ།",
    "དམ་ཚིག་གི་ཡེ་ཤེས་རྣམ་པ་སྣ་ཚོགས་ཀྱི་ཁྱད་པར་དང་ལྡན་ཞེས་བྱ་སྟེ།",
    "ཕྱི་དང་ནང་གི་མུན་པ་སེལ་བའི་དོན་གྱིས་ན་རབ་ཏུ་སྣང་བ་སྟེ།",
    "འདི་ནི་ཀུན་ནས་ཉོན་མོངས་པའོ།",
    "དྲན་པའི་ཟག་པས་གང་དང་གང་དུ་ཞི་གནས་དང་ལྷག་མཐོང་གི་ཚུལ་དེ་ལྟ་བུ་གང་ལས་ཉམས་པ་ལས་བློ་བཟློག་སྟེ་ཡང་དག་པ་ལ་སྦྱར་བ་ནི་ཟུང་དུ་འཇུག་པའོ།",
    "གང་གི་ཕྱིར་མ་ལུས་པའི་སྒྲ་ནི་ཐམས་ཅད་ཀྱི་སྒྲའི་རྣམ་གྲངས་ཡིན་པས་ན་ཟད་པར་གྱི་ཚིག་གོ།",
    "རེ་བ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་མཛད་པ་ན།",
    "ཡུན་རིང་པོར་དཀའ་བ་བརྙེས་ནས་རེ་བ་ཐམས་ཅད་ཡོངས་སུ་བསྐང་བར་མཛད་པ་པོས་ཀྱང་འདི་ལྟ་བུར་ཡུན་རིང་དུ་བཞུགས་པར་མི་བྱ་འམ་ཞེ་ན།",
    "གང་གི་ཕྱིར་བསྔགས་པ་ཡིན་པ་སྟེ་བཀྲ་ཤིས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཟླ་བ་དག་གིས་ཉེ་བར་མཛེས་པར་བྱས་ཤིང་བརྒྱན་པའོ།",
    "འདོད་ཆགས་ཀྱི་དེ་ཁོ་ན་ཉིད་ལ་གཟིགས་པ་དང་།",
    "རང་གི་རྣམ་པར་རྟོག་པ་ཉིད་དེ་ལྟར་སྣང་བ་ཡིན་ནོ་སྙམ་དུ་ཤེས་ནས་སྟོང་པ་ཉིད་སོ་སོར་རྟོགས་པས་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ངེས་པར་བཟློག་པར་ནུས་པའི་ཐབས་དང་ཡང་དག་པར་ལྡན་པའི་རྡོ་རྗེ་ཁྲོ་བོའི་ཏིང་ངེ་འཛིན་དེ་ལྟ་བུ་གང་གིས་ཤིན་ཏུ་ཡོངས་སུ་བསྒོམས་པ་དེ་ནི་བདུད་ཐམས་ཅད་ཀྱི་སྟོབས་རབ་ཏུ་འཇོམས་པའོ།",
    "དེ་རྣམས་ཀྱི་བྱེ་མ་ནི་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྟེ།",
    "གངྒཱའི་ཀླུང་གི་བྱེ་མ་ཇི་སྙེད་པ།",
    "སྐྲ་ཙམ་ཁྱོན་འདིར་འགྲོ་བ་ལྔར་གཏོགས་པ།",
    "ཅི་དེ་བཞིན་གཤེགས་པ་དེ་རྣམས་འབའ་ཞིག་གིས་ཡོངས་སུ་གང་བར་ཀུན་དུ་སྣང་ངམ།",
    "དེ་དག་གིས་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་གསང་སྔགས་ཀྱི་སྤྱོད་པའི་ཚུལ་འདི་རྗེས་སུ་གནང་བ་ཉིད་དུ་སྟོན་པ་ཡིན་ནོ།",
    "ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་ལས་ཤིན་ཏུ་རྣམ་པར་གྲོལ་བ་དངོས་པོ་ཐམས་ཅད་ཀྱི་རང་བཞིན་སོ་སོར་སྣང་བ་ཡང་དག་པར་སྟོན་པར་སྤྱོད་པའོ།",
    "གང་གི་ཕྱིར་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་བཞིན་དུ་རྟག་པར་བཞུགས་ཤིང་།",
    "དེ་ཡང་གང་གི་ཕྱིར་ས་དང་པོ་ལ་ཀུན་དུ་འགྲོ་བའི་སྟོང་པ་ཉིད་སོ་སོར་རྟོགས་ཏེ།",
    "ད་ནི་འདི་དེ་བཞིན་གཤེགས་པ་འབའ་ཞིག་གི་ངོ་བོ་ཉིད་ཡིན་པར་མ་ཟད་ཀྱི་གཞན་དུ་ན་རྡོ་རྗེ་སེམས་དཔའི་ངོ་བོ་ཉིད་ཀྱང་ཡིན་ནོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དང་མཉམ་པ་ཉིད་དུ་འཇུག་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་སྟོན་ཏེ།",
    "དེ་ཡང་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ལ་ཀུན་ནས་སྣང་བའི་ཚུལ་གྱིས་འཇུག་ཅིང་སོང་བས་ན།",
    "རེ་རེ་ཞིང་རྡོ་རྗེའི་གཟུགས་སུ་ཡོངས་སུ་བསྒྱུར་བ་ནི་བྱིན་གྱིས་བརླབས་པའོ།",
    "དེ་ལས་བྱུང་བའི་ཡེ་ཤེས་གང་ཡིན་པའི་ཡེ་ཤེས་དེ་ནི་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ཀྱི་རྡུལ་ཤིན་ཏུ་ཕྲ་མོའི་རྡོ་རྗེའི་བྱིན་གྱི་རླབས་ལས་བྱུང་བའི་ཡེ་ཤེས་སོ།",
    "ཟལག་རིང་གི་སྦྲ་ནགསྨད་ཆ།",
    "༡༤། ཐག་རིང་གི་སྦྲ་ནག།",
    "སྒྲུང་གི་སྨད་ཆ།",
    "ཐག་རིང་གི་སྦྲ་ནག།",
    "དུས་རབས་ཉི་ཤུ་པའི་ཐག་རིང་གི་སྦྲ་ནག།",
    "ལོ་རབས་དགུ་བཅུ་ཡས་མས་སུ་སྒྲུང་གཏམ་གསར་རྩོམ་གྱི་ལས་ལ་ཞུགས་ཤིང་སྒྲུང་དང་པོ་བྱང་ཐང་གི་མཛེས་ལྗོངས་དང་།",
    "རྩྭ་ཐང་གི་དབུས་ནས་གངས་རི་གཅིག་འཕགས་སོགས་མང་པོ་ཞིག་བརྩམས་གནང་འདུག།",
    "དུས་རབས་ཉེར་གཅིག་པའི་དུས་འགོར་ཐག་རིང་གི་སྦྲ་ནག་ཅེས་པ་འདི་བརྩམས།",
    "རྩོམ་པ་པོ་རང་ཉིད་ཀྱིས་ཀྱང་བྱང་ཐང་གི་སྣོད་བཅུད་མ་ལུས་ཀྱིས།",
    "བོད་བྱང་ཐང་གི་འབྲོག་པ་མང་ཚོགས་ཀྱི་ཡོད་ཚད་ཀྱི་ཡོད་ཚད་ལ་ང་ཆ་རྒྱུས་ཤིན་ཏུ་ཆེ་བས།",
    "ལོ་ཤས་སྔོན་གྱི་དོན་རྐྱེན་ཚབས་ཆེན་ནང་དོན་གྲུབ་དང་བཀྲ་ཤིས་གཡང་ཆགས་གཉིས་ཀྱི་ཕ་སྟེ་རྒན་མོ་ལྷ་མོའི་ཁྱོ་བོ་རྡོར་དཔལ་ཡང་རྐྱེན་ལམ་དུ་སོང་།",
    "བཀྲ་ཤིས་གཡང་ཆགས་ལའང་མིང་དོན་མཚུངས་པའི་ཁྱོ་བོ་རང་འདྲ་ཞིག་དགོས་པ་དང་གཉིས།",
    "ད་ལན་བུ་དང་བུ་མོའི་འཇིག་རྟེན་ལས་འཕྲོའི་ཟམ་པ་དེར་བརྟེན་ནས་གཉེན་ཚང་གི་འབྲེལ་བ་དེ་འཛུགས་རྒྱུ་བྱས།",
    "དར་ལུང་རྣ་བས་ཉན་ན་གོ་རྒྱུ་ཡོད་པས་དུས་ཡུན་ལོ་ཕྱེད་ཙམ་གྱི་རིང་གཤིབ་པའི་ཚེ་དགྲ་འདུལ་དང་བཀྲ་ཤིས་གཡང་ཆགས་གཉིས་དབར་ཁྲ་ཆུང་མིག་གིས་ལྐོག་མདའ་འཕེན་རེས་དང་།",
    "འཛུམ་སོ་དཀར་གྱིས་བསུ་རེས་བྱེད་པ་སོགས་གཞོན་ནུ་ལོ་ཆུང་ཐུན་མོང་ལ་ཡོད་པའི་འཆར་ཡན་གྱིས་ཕྱུག་ཅིང་སྟོང་བསམ་གྱིས་ཁྱབ་པའི་རྣམ་འགྱུར་སྣ་ཚོགས་སྟོན་རེས་བྱེད་པ་ཀུན་གྱིས་ཚོར་ནས་གླེང་བའི་རྒྱུ་རུ་གྱུར་ཡོད།",
    "གཡི་དཀར་གྱི་པགས་པས་དགྲ་འདུལ་དང་བཀྲ་ཤིས་གཡང་ཆགས་གཉིས་སྒྲུང་གི་སྨད་ཆ།",
    "ལ་ཞྭ་མོ་རེ་བཟོས་ཏེ་སྤྲད།",
    "དོན་གྲུབ་ཚང་གྲོང་པ་གསུམ་གྱི་ཕྱུགས་ཟོག་མཉམ་དུ་བཞག་ནས་ཁྱུ་གཅིག་ཏུ་བཟོས་ཏེ་རྫི་བོར་ཁྱིམ་ཚང་རེས་ཉི་མ་གསུམ་རེ་འགྲོ་རེས་བྱས།",
    "ཚམ་ཚོམ་དལ་བུར་རྒྱུ་བའི་སྤྲིན་པའི་ཁ་དོག་ད་ལྟ་འཇོས་མ་ཐག་གི་འབྲིའི་འོ་མ་དང་མཚུངས།",
    "སེམས་ནང་གི་མཛེར་རུར་གྱུར་པའི་ཨ་དར།",
    "སྣ་རུ་མཛེས་པོ་འདི་འདྲ་དེ་རིང་མ་གཏོགས་མཐོང་མ་མྱོང་ཞེས་ཤོད་ཀྱིན་སྔར་བཞིན་སེམས་ཆུང་གིས་ལག་གཡོན་མའི་མཐེ་བོང་གི་སེན་མོའི་སྟེང་དུ་ཅུང་ཟད་བླུགས་པ་དང་དེ་མར་ཡར་འཐེན་ནས་ཨ་ཞེས་ཤིན་ཏུ་ཡིད་ཚིམ་པའི་རྣམ་འགྱུར་བསྟན།",
    "ཁྱོད་ཀྱིས་ང་ལ་རོགས་བྱེད་རྒྱུ་ཁས་བླངས་པ་མིན་ནམ་ཟེར།",
    "ངོ་མ་ལེན་ནུས་པ་མི་འདུག་ཐག་རིང་གི་སྦྲ་ནག་དེ་འདྲ་མ་ཟེར་དང་།",
    "ཁྱོད་སྣ་ཐ་ཆད་ནས་རྒྱུན་རིང་ཕྱིན་ཡོད།",
    "ད་གིན་ཐོག་མར་སྣ་རུ་སྤྲོ་ལེན་བྱེད་སྐབས་རིན་ཐང་བྲལ་བའི་ནོར་བུ་ཞིག་སྤྲོད་ལེན་བྱེད་པ་དང་འདྲ་ཡང་ད་ལྟ་སྣ་རུ་དེ་ནི་རིན་ཐང་གང་ཡང་མི་ལྡན་པའི་སྤྱིར་བཏང་གི་དངོས་པོ་ཞིག་ལྟར་ཕན་ཚུན་པང་དུ་གཡུག་རེས་བྱེད་ཀྱི་འདུག།",
    "ད་གིན་གཟེངས་སུ་གཏོད་པའི་མགྲིན་པ་ད་གཟོད་སྒྲུང་གི་སྨད་ཆ།",
    "གཞུ་མོ་ལྟར་གུག་ནས་ད་རེས་ཁྲིད་ཐབས་བྱས་ཀྱང་ཆོག།",
    "ཡིན་ནའང་ངས་ད་རེས་མོའི་བདེ་འཚམས་བལྟ་རྒྱུ་ལས་མོ་དང་ཐུག་འཕྲད་བྱེད་རྩིས་མེད།",
    "གལ་སྲིད་བཙན་རྒོད་ཁ་ཤོས་ཤེས་སོང་ན་ཕྱིས་སུ་དགྲ་ཤ་ལེན་རྒྱུ་ལྟ་ཅི་ཁོ་དེ་བས་དོགས་ཟོན་ཆེ་རུ་འགྲོ་ངེས་རེད་ལ།",
    "ང་རང་གི་སྲོག་ཀྱང་ཐར་དཀའ་མོ་རེད།",
    "ང་མི་གཅིག་གིས་ཁོ་ཚོའི་ཁ་གཏད་འཇལ་ག་ལ་ནུས་ཞེས་ཤོད་ཀྱིན་འདྲེན་བྱེད་ཟུང་ལས་མིག་ཆུའང་རྡོག་གཉིས་ལྷུང་བྱུང་།",
    "སྐྱེས་པ་ཕོ་ཡི་མིག་ཆུ་ནི་རིན་ཆེན་གསེར་ལྟར་མཐོང་དཀའ་མོ་ཞིག་རེད།",
    "ལག་པ་གནམ་ལ་འཕྱར་བ་ཙམ་གྱིས་ཉམ་ཆུང་སྲོག་རྩ་འདར་ཐག་རིང་གི་སྦྲ་ནགའོས་པའི་དཔའ་བོ་ལྟ་བུ་ཞིག་ཏུ་མཐོང་ཡང་།",
    "མཛུབ་མོ་སྦོམ་ལ་རྩུབ་དྲེག་ལྡན་པ་དེ་དག་མཐོང་ཚེ་དེ་ནི་ངོ་གདོང་གི་ལྡོག་ཕྱོགས་སུ་གྱུར་ཅིང་རང་གི་ཀླད་པའི་ནང་དུ་ཡུན་རིང་གནས་པའི་དཔའ་བོའི་སྣང་བརྙན་དུ་གྱུར་ཏེ་དཔའ་བའི་དཔུང་རོགས་འདི་ལྟ་བུ་ཞིག་ཡོད་པས་ཡ་མེད་སྤུན་གསུམ་ལྟ་ཅི་ཁམས་གསུམ་དམག་གིས་འཁོར་ལོ་བསྐོར་ཏེ་འཇིག་རྟེན་ཁྲག་གི་མཚོ་མོ་འཁྱིལ་ཡང་འཇིགས་དགོས་མི་འདུག་སྙམ་པའི་ཚོར་སྣང་སྐྱེས།",
    "ལམ་རོགས་ཤིག་ཡོད་ན་ཉི་མ་འཁྱོལ་སླ་གི་རེད་ཟེར།",
    "མི་འདིས་ངོ་མ་རང་མིར་བརྩིས་ནས་སེམས་ཁུར་བྱེད་ཀྱི་འདུག་སྙམ་ནས་ཁྱོད་སེམས་ཁྲལ་མི་དགོས།",
    "ད་རེས་ངས་ཡུལ་དུ་ཐེངས་གཅིག་སོང་ནས་བཟའ་མོའི་བདེ་འཚམས་ཀྱི་གནས་ཚུལ་ཞིག་བལྟས་ཏེ་ལོག་ཡོང་རྒྱུ་ཡིན།",
    "ད་རེས་ཕྱིན་ནས་གནས་ཚུལ་ཞིག་རྟོགས་ཐུབ་ན་ཕྱིས་སུ་དགྲ་ཤ་ལེན་སྐབས་ཀྱང་འཆར་བཀོད་བཟོ་བདེ་བས་ང་རང་མི་རྐྱང་རྟ་ཀྱང་ལས་རོགས་པ་ཁྲིད་རྩིས་མེད་ཟེར།",
    "ཁོས་ཁས་ལེན་མི་བྱེད་པ་རེད་དམ་ཞེས་དྲིས།",
    "དགྲ་ཤ་ལེན་སྐབས་ཁོ་ལ་མཚོན་ཆ་ཡག་པོ་ཡོད་པས་དཔུང་རོགས་སུ་ཁྲིད་རྒྱུ་ལས་འཐབ་མཁན་གཙོ་བོ་ང་གཉིས་རེད།",
    "སྐད་ཆ་དེ་དོན་གྲུབ་ཀྱི་བསམ་སྟངས་དང་ཤིན་ཏུ་མཐུན་པས་དེ་རང་རེད།",
    "བོའུ་ཁྲ་རིང་གནམ་ལྕགས་རྒྱབ་ཏུ་ཁུར་ནས་ཡུལ་ལས་ཐོན་ཏེ་སོང་།",
    "ཁུག་སྣའི་ཁྲོད་དུ་ཁ་བའི་རྡུལ་བརྩེགས་ཀྱི་ལྷུན་པོའི་གཙུག་ཏོར་ཐར་ཐོར་ཡང་མངོན་གྱི་འདུག་ཀྱང་དེ་དག་གི་ཁྲོད་དུ་རང་ཡུལ་གྱི་རི་རྩེ་རེད་སྙམ་པ་ནི་གཅིག་ཀྱང་མི་འདུག་པས་གང་ལྟར་ཉིན་ཤས་ལྷོ་ཕྱོགས་ཁོ་ནར་ཁ་གཏད་དེ་འགྲོ་རྒྱུ་རེད་སྙམ་ནས་རྟར་བཞོན་ཏེ་རྟ་བོ་ལྕག་གིས་བྲབ་ནས་སྐྱོད།",
    "འབྱམས་ཀླས་མྱ་ངམ་གྱི་ཐང་ཆེན་དུ་འགྲུལ་རོགས་མེད་པའི་མི་གཅིག་ཁེར་འགྲོ་བྱེད་རྒྱུ་ནི་ཧ་ཅང་ཡིད་མུག་པ་ཞིག་རེད།",
    "དགའ་གྲོགས་སྐྱོ་གྲོགས་ཟེར་ནའང་འདྲ་གང་ལྟར་འོག་ཏུ་བཞོན་པའི་བྱོལ་སོང་ལས་མེད་པས་ཡིད་མུག་གི་སེམས་སངས་ཆེད་སྨྲ་སྒོ་ཕྱེས་ཏེ་གླུ་ཆུང་ཞིག་བླངས་པར།",
    "ཐག་རིང་གི་སྦྲ་ནགརྒྱ་དང་བོད་ཀྱི་ལམ་ཐག།",
    "ཉི་མ་གཅིག་གིས་བསྐྱོད་ཆོག།",
    "ན་ཐང་དེའི་གཞུང་གི་རྒྱུག་ཆུའི་འགྲམ་དུ་ཁོ་དང་ནོར་རྫི་ཕོ་གཞོན་དེ་འཕྲད།",
    "ཟོག་འཚོ་ཡག་ཅེས་ཁམས་འདྲི་བྱས་ཀྱང་ཕོ་གསར་དེས་ལན་མ་སྤྲད་པར་མིག་ཧུར་རེར་ཁོར་བལྟས་ནས་འདུག།",
    "ཕོ་གསར་དེས་ཁྱོད་ཀྱི་མིང་ལ་ཅི་ཟེར་ཞེས་ཚུར་དྲིས་བྱུང་།",
    "ཕོ་གསར་དེས་ཕྱིར་བཤོལ་གོམ་གང་བྱས་ནས་ཁྱོད་ཀྱིས་ཅི་བྱེད་རྩིས་ཡོད།",
    "ང་དོན་མེད་ནོར་རྫི་ལ་ཁྱོད་ཀྱིས་བརྙས་བཅོས་བྱེད་དོན་ཅི་རེད།",
    "འཐབ་འཐབ་རྒྱུར་དགའ་དྲགས་པས་ཆགས་སྒོ་ཆེན་པོ་རག་མྱོང་ཞེས་ཕྱིར་བཤོལ་བྱེད་ཀྱིན་ནོར་ཁྱུར་སྒྲུང་གི་སྨད་ཆ།",
    "ཁྱོད་དེ་རིང་ངའི་མཚོན་འོག་ཏུ་ཤི་སོང་ཞེས་འཇིགས་སྐུལ་བྱས།",
    "ཁྱོད་ཀྱིས་ངའི་མེ་མདའི་མཆུ་ལྕེ་ཡིས་ལྡོགས་དང་དེ་མིན་ན་ངས་གསོད་རྒྱུ་ཡིན་ཞེས་འཇིགས་སྐུལ་བྱས།",
    "འབྲུག་དར་རང་སར་ལངས་ནས་ལྕེ་ད་དུང་ཕྱི་རུ་བཏོན་ཏེ་ད་གིན་དེ་རྨི་ལམ་ཡིན་ནམ་མངོན་སུམ་ཡིན་ཆ་མ་འཚལ་བར་ཧོན་ཐོར་ནས་ལུས།",
    "དེ་ནས་ཁོ་དྭངས་གཙང་ཆུ་མིག་ལྡན་པའི་ན་སྒོར་མོ་ཞིག་ཏུ་སླེབས་པས་དེར་རྟ་སྒ་བླངས་ཤིང་ལྕི་བ་བཏུས་ཏེ་ཇ་བསྐོལ་ཏེ་ངལ་གསོ་ཏོག་ཙམ་བརྒྱབ་རྗེས་ཤར་ཕྱོགས་ནས་ཚེས་བཅོ་ལྔའི་ཟླ་བ་གསལ་གྱི་ལེར་ཤར་བྱུང་བས་སླར་ཡང་རྟ་སྒ་བརྒྱབ་ནས་མདུན་དུ་སྐྱོད།",
    "སྒང་གཤོང་གི་དབྱེ་མཚམས་ལྷག་པར་གསལ།",
    "དེའི་སྐབས་སྤྲིན་ནག་ཚོམ་བུ་ཞིག་གིས་ཟླ་བའི་ཞལ་རས་བཀབ་ནས་རེ་སྒྲུང་གི་སྨད་ཆ།",
    "བཙན་རྒོད་ཁ་ཤོ་ཡུལ་ལས་བྲལ་ནས་ཟླ་གཉིས་ལྷག་ཕྱིན་པའི་རྗེས་ཀྱི་ཉིན་ཞིག་གི་མཚན་མོ་ཞིག།",
