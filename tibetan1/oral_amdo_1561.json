    "མདའ་མོ་གློག་འོད་ཀྱུག་འདྲ་འདོན།",
    "གཡོན་གཟིག་ཤུབས་ནང་ནས་གཞུ་གཅིག་འདོན།",
    "གཞུ་མོ་ར་རྒོད་འཁྱིལ་བ་འདོན།",
    "རྒྱལ་བུས་སྒ་བསྒྱུར་ཞིག་མཛད་པས་ཐལ་སོང་བ་དང་སླར་དོན་ཡོད་ཀྱིས་ཁོ་ཡི་གདོང་བཀག་སྟེ་གླུ་འདི་ལྟར་ཞིག་གསུངས་སོ།",
    "སྡང་དགྲ་བོ་གཉའ་ནས་ནོན་པར་ཤོག་ཚུར་ཉོན་དང་བློན་པོ་ཏྲི་ཤུ་ཁྱོད།",
    "དགྲ་ཉོན་མོངས་ཆེ་ཡང་ཡ་ང་མེད།",
    "ངས་དེ་རིང་མི་འཕར་དཀའ་མེད་རེད།",
    "ཡུལ་ཕྱོགས་འདིར་ཡང་བཀྲ་ཤིས་ཕུན་སུམ་ཚོགས་པའི་དུས་འདིར་ཡབ་ཡུམ་གཉིས་ཀྱང་ཐུགས་ཁྲལ་བསང་བའི་ཕྱིར་མཇལ་དུ་འགྲོ་དགོས་དགོངས་ཏེ་དོན་ཡོད་ལ་གསུང་མོལ་འདི་ལྟར་ཞིག་གསུངས་སོ།",
    "དེང་དུས་རང་རེ་བཀྲ་ཤིས་ཕུན་སུམ་ཚོགས།",
    "ད་ནི་རང་རེའི་ཡབ་ཡུམ་བཀའ་དྲིན་ཅན།",
    "རང་རེའི་ས་དང་ཉེ་བའི་ལྗོངས་རྣམས་སུ།",
    "འཚོ་བའི་ཡོ་བྱད་མང་དུ་གྲབས་གཤོམ་འདུག་དེས་ན་ནམ་ཞིག་རང་རེའི་རྒྱལ་ས་འདི།",
    "སྔོན་ཆད་རང་རེ་མངའ་ཐང་འཛོམས་གྱུར་ཀྱང་།",
    "གཅུང་པོ་དོན་ཡོད་བཙུན་མོ་བཅས་པ་རྣམས།",
    "ཚུར་ལ་ཉོན་དང་བློན་པོ་ཆེན་པོ་ཁྱོད།",
    "ཐག་རིང་ཡུལ་གྱུར་ལོ་ངོ་འགའ་ཙམ་སོང་།",
    "བདག་གི་མིང་ལ་ཛ་ཡདྷ་ར་ཟེར།",
    "ད་རེས་ཕ་བུ་འཕྲད་པར་འགྱུར་ལགས་པས།",
    "དུང་འབུད་སོགས་བསམི་གྱིས་མི་ཁྱབ་པའི་སྟ་གོན་མཛད་ཅིང་།",
    "དེ་ནས་བློན་པོ་དཔོན་གཡོག་ལྟ་བཅས་ཕོ་ཉ་ཡབ་ཡུམ་གྱི་སར་བཏང་བའི་བཀའ་ཤོག་གི་སྒྲོམ་བུར་སྐུ་མཆེད་མཐའ་ལ་སྤྱུགས་ཤིང་འོ་བརྒྱལ་བྱུང་ལུགས་བསྐུར།",
    "ས་གཞི་གླུ་གར་རོལ་མོ་རྩེད་འཇོའི་སྒྲ་ལ་སོགས་པས་བཀང་།",
    "རྒྱུལ་བུ་སྐུ་མཆེད་བཙུན་མོ་དང་བཅས་པའི་གཟིམ་གུར་གྱི་འགག་ཏུ་ཕྱག་རྟེན་དང་བཅས་མཇལ་མ་ཐག་ཡབ་ཀྱིས་འདི་ལྟར་ཞིག་གསུངས་སོ།",
    "འོན་ཀྱང་སྐུ་ཚེར་བར་ཆད་མེད་པར་རང་རེ་མཇལ་བ་ཕ་ཡི་བསམ་དོན་གྲུབ་སོང་།",
    "ཞེས་གསུངས་ཤིང་དགྱེས་དྲག་པས་གཅིག་གི་གཅིག་ལ་འཐམས་ཏེ་ཕན་ཚུན་འབྲལ་མི་ཕོད་པར་མཛད་ཅིང་།",
    "བདག་ནི་ཉོན་མོངས་མི་ཤེས་ཀྱིས་བསྒྲིབས་པས།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་ལེགས་པར་མ་རྟོགས་ནས།",
    "སྐྱིད་སྡུག་ལེགས་ཉེས་རྒྱལ་སྲས་ཁྱོད་ཀྱིས་གཟིགས།",
    "རང་རེ་ལང་ཚོ་རིགས་བཟང་ལྡན་གྱུར་ཀྱང་།",
    "ལང་ཚོ་ཡོལ་ཞིང་རྒ་བའི་འཇིགས་པས་ནོན།",
    "ང་ཡི་རིགས་རྒྱུད་རྒྱལ་བུ་དོན་ཡོད་ཁྱོད།",
    "བློན་འབངས་ཁྱོད་རྣམས་བླང་དོར་འདི་ལྟར་དགོས།",
    "སྐུ་མཆེད་གཉིས་རྒྱལ་ས་ཕན་ཚུན་ཁྱད་མེད་ཅིང་བཙུན་མོ་ཡང་གཅིག་གིས་འཐུས་པ་མཛད།",
    "རང་རེས་ཡབ་ཡུམ་སྲས་བཅས་མཇལ་གྱུར་ཅིང་།",
    "ཁྱོད་གཉིས་རིངས་བར་སོང་ལ་གདན་འདྲེན་གྱིས།",
    "ཁྱོད་གཉིས་བྱོན་པའི་ལམ་དུ་ངལ་བར་གྱུར་པ་མེད་དམ།",
    "མོ་མ་ཀཎི་དང་།",
    "དེ་འདྲའི་གནས་མཆོག་རྒྱལ་སྲས་དོན་ཀུན་གྲུབ་པ་ཁྱོད་ཀྱི།",
    "དེ་ནས་ཐོག་མར་ཁྱོད་ཉིད་བཙན་པོའི་མིང་ཞིག་འཛིན་པའི།",
    "རྒྱལ་བུ་དོན་གྲུབ་ཁྱོད་ཉིད་བྱང་ཕྱོགས་ཁ་བ་ཅན་དུ།",
    "དོན་ཡོད་ཁྱོད་ཀྱང་དེ་ཚེ་པྲཛྷའི་མིང་དུ་འགྱུར་ནས།",
    "རང་རེ་ཡབ་སྲས་གསུམ་གྱིས་ཐུབ་བསྟན་བྱི་དོར་བྱེད་དོ།",
    "རྩེ་མོ་འཇིག་རྟེན་ཚངས་པའི་གནས་སུ་འཁྲུངས།",
    "གིང་ཕོ་ཐམས་ཅད་གཡས་སུ་ཤ་ར་ར།",
    "གིང་མོ་ཐམས་ཅད་གཡོན་ནས་ཤུ་རུ་རུ།",
    "སྤྱན་རས་གཟིགས་ཀྱི་རྣམ་སྤྲུལ་ཡིན་པའི་ཕ་ཚོང་དཔོན་ནོར་བཟང་དང་།",
    "བྱང་ཚོང་ཡོད་པ་ལྷོ་རུ་བསྐྱལ།",
    "གོམ་ལ་རིང་ཐུང་མེད་པ་བརྒྱབ་སྟེ་སྒྲོལ་མ་ལྷ་ཁང་གི་ཕྱོགས་སུ་སོང་ནས་སྒྲོལ་མ་ལྷ་ཁང་གི་སྒོ་བརྡུངས་ཏེ་དམས་ལྷ་སྲས་བྲམ་ཟེ་ཞེས་སྐད་ཀྱིས་བོས་པས།",
    "སྒྲོལ་མ་ལྷ་ཁང་གི་ནང་ནས་ལྷ་སྲས་བྲམ་ཟེ་དེས་ཅི་ཡིན་སྙམ་ནས་གཟིགས་པས་བདུད་ཀྱི་བློན་པོ་རྐང་མགྱོགས་བང་ཆེན་དེ་སྒོ་དྲུང་གི་འགག་ཏུ་སླེབས་པ་གཟིགས་ནས།",
    "སྒྲོལ་མ་ལྷ་ཁང་གི་སྒོ་དྲུང་གི་འགག་ཏུ་ཕེབས་ཏེ་བློན་པོ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཚུར་ལ་ཉོན་དང་ལྷ་སྲས་བྲམ་ཟེ་ཁྱོད།",
    "ཁྱོད་ཀྱི་ཟླ་གྲོགས་ཚོང་དཔོན་ནོར་བཟང་དེ།",
    "ཨེ་མ་གསན་དང་ཚོང་དཔོན་ནོར་བཟང་མཁྱེན།",
    "རང་རེའི་སྒོ་དྲུང་འགག་ན་སླེབས་ནས་འདུག་མུ་སྟེགས་རྒྱས་པོ་ལོག་པའི་མཆོད་སྦྱིན་གྱིས།",
    "ཞེས་གསུངས་ཏེ་བློན་པོ་དང་ཚོང་དཔོན་གཉིས་རྒྱལ་པོའི་དྲུང་དུ་ཕྱག་ཕེབས་སོ།",
    "ངེད་གཉིས་དེ་རིང་གཏམ་གྱི་གླེང་མོ་ལ།",
    "རང་རེ་རྒྱལ་བློན་གོ་བབ་ལོག་ནས་འདུག་ང་ནི་ཡུལ་གྱི་རྒྱལ་པོའི་ཚུལ་ཡིན་ཀྱང་།",
    "ཁྱེད་རང་རྒྱལ་ཁག་གཅིག་གི་བློན་པོ་ལ།",
    "ཀླུ་རྒྱལ་དུང་སྐྱོང་དཀར་མོའི་ཕྱག་ནས་ནི།",
    "ནང་གི་དོན་བསྒྲུབས་ཕྱི་ཡི་དགྲ་བཏུལ་བའི།",
    "འགྲོ་བར་མི་ནུས་དགོངས་པ་ཐུགས་རྗེས་གཟིགས།",
    "རྐང་མགྱོགས་བློན་པོ་ད་ལྟ་ཉིད་དུ་སོང་།",
    "བློན་པོ་དེས་སྒྲོལ་མ་ལྷ་ཁང་གི་ཕྱོགས་སུ་འགྲོ་བར་བརྩམ་པའི་ཚེ།",
    "མ་གཅིག་རྒད་མོ་ལྷ་སྲས་བྲམ་ཟེ་ལ།",
    "ཡང་ཚོང་དཔོན་གྱི་ཞལ་ནས།",
    "རབ་ལ་ལོ་གསུམ་དགོངས་པ་ཐུགས་རྗེས་གཟིགས།",
    "དེ་ནས་ཚོང་དཔོན་དེ་ཐུགས་སྐྱོ་བའི་ངང་ནས་སྒྲོལ་མ་ལྷ་ཁང་གི་ཕྱོགས་སུ་ཕྱག་ཕེབས་སོ།",
    "ཚུར་ལ་གསན་དང་ཚོང་དཔོན་ནོར་བཟང་མཁྱེན།",
    "རྒྱལ་པོའི་བཀའ་ཡི་ཆད་པ་ཅི་ཞིག་འདུག་མ་གསང་དྲང་པོའི་གཏམ་གཅིག་བདག་ལ་མོལ།",
    "ཀླུ་རྒྱལ་དུང་སྐྱོང་དཀར་མོའི་ཕྱག་ནས་ནི།",
    "དེ་བས་བདག་གིས་རྒྱ་མཚོར་འགྲོ་བར་ཞུས།",
    "མ་གཅིག་བདག་གི་བློ་གཏད་སུ་ལ་བཅོལ།",
    "ཤར་བའི་ཉི་མ་ནུབ་ལ་རྒས་ནས་མོང་།",
    "ཡང་ཚོང་དཔོན་གྱི་ཞལ་ནས།",
    "ཕྱིན་ཏེ་ལོ་གསུམ་སོང་ནས་མ་འཁོར་ན།",
    "ཁྱོད་ཀྱི་ལུས་ན་ཡོད་པའི་བུ་ཆུང་འདི།",
    "དེར་ཡུམ་མཛེས་ལྡན་ལྷ་སྲས་བྲམ་ཟེ་མ་དེ་ཚོང་དཔོན་མེད་པས་ཐུགས་མྱ་ངན་གྱིས་མནན་སོང་།",
    "རྒྱ་གར་གྱི་འཇིག་ཐང་ཆེན་པོ་ཞིག་གི་སྟེང་དུ་ཕྱག་ཕེབས་པ་དང་།",
    "རྒྱ་མཚོ་འཁྲུག་བཞིན་གཡོར་མོ་འབྱང་བཞིན་འདུག་པས།",
    "ཚུར་ལ་གསན་དང་ཚོང་དཔོན་ནོར་བཟང་ཁྱེད།",
    "རང་རེའི་གྲུ་རྫིངས་འདི་ཡི་འོག་རོལ་དུ།",
    "ཅེས་ཞུས་ནས་ནེ་ཙོ་དེས་གཤོག་བརྡབས་ལན་གསུམ་བྱས་ནས་གྲུ་རྫིངས་ཀྱི་ནང་ནས་འཕུར་སོང་།",
    "ཚོང་པ་ཐམས་ཅད་རྩལ་ཆེ་བས་གྲུ་རྫིངས་ཞིག་པའི་ཤིང་གི་གདུང་མ་རེ་ལ་བཞོན་ནས་ཆུ་ཡི་དཀྱིལ་དུ་ཁྱེར་བས་དགོས་པའི་ཀླུ་ཡུལ་པད་མ་ཅན་དུ་མ་སླེབས་པར།",
    "དེའི་སྲིན་མོ་ཐམས་ཅད་ཀྱིས་དཕྲལ་ལག་བཀབ་སྟེ་ཆུའི་ནང་དུ་བལྟས་པས་ཚོང་པ་མང་པོ་ཤིང་གི་གདུང་མ་རེ་ལ་བཞོན་ཏེ་ཡོང་བ་མཐོང་ནས་སྲིན་མོ་རྣམས་ཀྱིས་གྲོས་བྱས་པར།",
    "ཚུར་ལ་ཉོན་དང་རང་རིགས་སྲིན་མོའི་ཚོགས།",
    "བདག་ཅག་བུ་མོ་རྣམས་ཀྱི་ཕྱོགས་སུ་གསོན།",
    "ཞེས་ཞུས་ཏེ་སྲིན་མོ་རེ་རེས་ཚོང་པ་རེ་རེ་ཆུ་ནང་ནས་བཏོན་ཏེ།",
    "རང་རང་གི་ཟླ་གྲོགས་ལ་ཉར་སོང་ངོ།",
    "དེ་ནས་ཚོང་དཔོན་ནོར་བཟང་དེའི་ཐུགས་ལ་ངེད་ཀྱི་ཟླ་གྲོགས་འདི་ཚོ་ཉིན་གཅིག་ལ་དཔེ་བཞག་པ་བཞིན་ཡུལ་གྱི་ཕུ་མདའ་མེད་པ་ལ་འགྲོ་གིན་འདུག་པས་དོན་ཅི་བྱེད་པ་ཡིན་སྙམ་ནས་ཉིན་གཅིག་ཚོང་དཔོན་དེ་ལུང་པའི་ཕུ་རུ་བལྟ་བར་བྱོན།",
    "ལུང་པའི་ཕུ་ན་ལྕགས་མཁར་ཞིག་འདུག་པས་དེ་ལ་འགྲོ་བའི་སྒོ་གར་ཡོད་སྙམ་སྟེ་ཕྱོགས་བཞིར་གཟིགས་པས་འགྲོ་བའི་སྒོ་ནི་གཅིག་ཀྱང་མི་འདུག་མཁར་དེ་ཡི་འཁྲིས་ན་ཤིང་སྡོང་སྐམ་པོ་གཅིག་འདུག་པ་དེ་ཡི་སྟེང་དུ་འཛེགས་ནས་གཟིགས་པས་ལྕགས་མཁར་དེའི་ནང་ན་མི་ལ་ལ་སྟོད་ཡོད་ཅིང་སྨད་མེད་པ་དང་།",
    "མི་མང་པོས་སྐད་འཚེར་བཞིན་ཡོད་པ་གཟིགས་ཏེ་ཚོང་དཔོན་གྱི་ཞལ་ནས་ལྕགས་མཁར་ནང་གི་མི་རྣམས་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ལྕགས་མཁར་ནང་གི་མི་རྣམས་ཀྱི་ཁ་ནས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཁྱེད་ནི་ཕེབས་པ་གང་གི་ཕྱོགས་ནས་ཕེབས།",
    "ཚོང་དཔོན་ནོར་བཟང་གི་ཞལ་ནས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཡང་ལྕགས་མཁར་ནང་གི་མི་ཕོས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཚུར་ལ་གསོན་དང་ཚོང་དཔོན་ནོར་བཟང་ལགས།",
    "སྲིན་མོ་ཤ་ཟ་རྣམས་ཀྱི་ལུང་པ་ཡིན།",
    "ན་སོ་གཞོན་དུས་སྲིན་མོའི་གྲོགས་སུ་ཉར།",
    "གསན་པ་ཨེ་བྱུང་ཚོང་དཔོན་ནོར་བཟང་ལགས།",
    "ཡང་ཚོང་དཔོན་གྱི་ཞལ་ནས་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "ཡང་ལྕགས་མཁར་ནང་གི་མི་དེའི་ཁ་ནས་ཞུས་པ།",
    "ཚུར་ལ་གསན་དང་ཚོང་དཔོན་ནོར་བཟང་ལགས།",
    "མི་དེས་ཟེར་བ་ལྟར་ཚོང་དཔོན་གྱིས་དེའི་ནུབ་མོ་སྲིན་མོའི་མཁར་དུ་ཕེབས།",
    "ཚུར་ལ་ཉོན་དང་ཚོང་ཕྲུག་ལྔ་བརྒྱའི་ཚོགས།",
    "སྲིན་མོ་ཤ་ཟ་རྣམས་ཀྱི་ལུང་པ་འདྲ།",
    "གོ་བ་ཨེ་བྱུང་ཚོང་ཕྲུག་ལྔ་བརྒྱའི་ཚོགས།",
    "དེའི་ནུབ་མོ་སྲིན་མོ་ཐམས་ཅད་ལུང་པའི་ཕུ་མདའ་མེད་ནས་འབྱོར་བྱུང་བས་ཚོང་དཔོན་གྱི་ཞལ་ནས་སྲིན་མོ་རྣམས་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཡང་ལ་ཡང་བཟི་དང་བཅས་སྲིན་མོ་རྣམས་ལ་ཨུ་ཚུགས་ཀྱིས་དྲངས་གང་ཐུབ་བྱས་པས་ཡུད་ཙམ་ནས་སྲིན་མོ་རྣམས་ཐམས་ཅད་ར་རོ་སྟེ་གཉིད་ཁུག་སོང་བས།",
    "དེའི་བར་ལ་ཚོང་དཔོན་གྱིས་ཚོང་ཕྲུག་རྣམས་ཐམས་ཅད་གཅིག་ཀྱང་མ་ལུས་པ་ངེད་ཀྱི་རྗེས་སུ་ཤོག་ཅེས་གསུངས་ནས་ལྕགས་མཁར་ནང་གི་མི་ཕོ་དེ་ཡིས་ཟེར་བ་ལྟར་ལུང་པའི་ཕུ་རུ་བྱོན་ཏེ་གསེར་གྱི་བྱེ་ཐང་ཆེན་པོ་དེའི་སྟེང་དུ་བསྒུགས་ཏེ་བསྡད་པས་ཡུད་ཙམ་ནས་སྤྲིན་གྱི་གསེབ་ནས་རྟ་ཡི་རྒྱལ་པོ་བྷ་ལ་དེ་བ་ཞེས་བྱ་བ་འདི་ཀི་སྒྲ་དང་ཤུ་སྒྲའི་ངང་ནས་གསེར་གྱི་བྱེ་ཐང་དེ་ཡི་སྟེང་དུ་བབས་ནས།",
    "དེར་ཚོང་དཔོན་དང་ཚོང་ཕྲུག་ལྔ་བརྒྱ་རྣམས་ཀྱིས་པུས་མོའི་ལྷ་ང་ས་ལ་བཙུགས་ཏེ་ལག་གཉིས་ཐལ་མོ་སྦྱར་ནས་འདི་སྐད་ཅེས་ཞུས་སོ།",
    "ཤིང་གི་ཚལ་བར་འཇུས་པས་སྲོག་ཐར་མོད།",
    "ཚུར་ལ་ཉོན་དང་ཚོང་དཔོན་ཚོང་ཕྲུག་རྣམས།་",
    "སྲིན་མོའི་ཁ་ནང་ཕྱི་མིག་མ་ལྟ་ཞིག་གསོལ་བ་རྩེ་གཅིག་བཏབ་ནས་ཆོངས་ལས་ཤོག་བྱོལ་སོང་གཞན་གྱིས་ཤེས་ན་ལྟས་ངན་ཡིན།",
    "བྷ་ལ་དེ་བས་ཤེས་པ་གཡང་དུ་འཇུག་ཅེས་གསུངས་ནས་ཚོང་དཔོན་དང་ཚོང་ཕྲུག་བཅས་པ་རྟ་ཡི་རྒྱལ་པོའི་སྟེང་དུ་བསྐྱོན་སོང་།",
    "མ་ཆུག་བ་ཐམས་ཅད་ཟེ་མཇུག་ལ་འཐམས་ནས་ཀི་སྒྲ་དང་ཤུ་སྒྲའི་ངང་ནས་བར་སྣང་གི་མཐོངས་སུ་འཕུར།",
    "དེ་ནས་སིང་གྷ་ལ་ཡི་ཟླ་གྲོགས་སྲིན་མོ་རྣམས་གཅིག་གིས་གཅིག་གཉིད་སད་དེ་ངེད་ཀྱི་ཚོང་ཕྲུག་རྣམས་མི་འདུག་པས་རང་རེ་རྣམས་འཚོལ་དུ་འགྲོ་ཟེར་ཞིང་གཉིད་ཧར་སད་བརྒྱབས་ཏེ་འཚོལ་དུ་ཕྱིན་པས་མ་རྙེད་ཅིང་།",
    "ཚོང་དཔོན་དང་ཚོང་ཕྲུག་ཐམས་ཅད་རྟ་ཡི་སྟེང་དུ་བར་སྣང་དུ་ཡོད་པ་སྲིན་མོ་རྣམས་ཀྱིས་མཐོང་བས་མར་ཁྱིམ་དུ་འོངས་ནས་ལུས་སྐྱེས་བུ་ཚ་རྣམས་ཁྱེར་ཏེ་ནམ་མཁའ་ལ་འཕྱར་ནས་སྲིན་མོས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ཟླ་གྲོགས་བུ་མོ་རྣམས་ཀྱི་ཕྱོགས་སུ་གསོན།",
    "ཐ་མ་ཕྱི་མིག་རེ་རེ་གཟིགས་རོགས་གནང་།",
    "ཞེས་རིང་སྐད་ཀྱིས་འབོད་པ་ཆེན་པོ་བར་སྣང་གི་མཐོངས་ལ་ཁྱབ་པས་ཚོང་ཕྲུག་རྣམས་ཀྱི་སེམས་ལ་ད་སྲིན་མོ་ཡིན་ཀྱང་ལུས་སྐྱེས་ཀྱི་བུ་ཚ་ཡོད་སྙམ་ནས་ཕྱི་མིག་རེ་བལྟས་པས་ཚོང་ཕྲུག་ཐམས་ཅད་སྟོན་གཡུལ་སྟེང་དུ་སྲན་མ་བབས་པ་ལྟར་སྲིན་མོའི་ཁ་ནང་ལ་ལྷུང་།",
    "ཡང་སྲིན་མོ་རྣམས་ཀྱི་ཁ་ནས་སྨྲས་པ།",
    "ཞེས་ཟེར་ནས་སྲིན་མོ་རྣམས་ཀྱིས་ཚོང་ཕྲུག་རེ་རེ་བཟུང་ནས་བཟས་སོང་།",
    "དེ་རྗེས་མཚན་མོ་གཟིམས་ཀྱང་མནལ་སྤྲོ་ཞིང་ཉིན་མོ་གསོལ་ཆས་ཀྱང་བྲོ་བ་རྙེད་པ་སོགས་ཉམས་བདེ་བ་བྱུང་།",
    "ཨ་མ་གསན་དང་ལྷ་སྲས་བྲམ་ཟེ་ལགས།",
    "གསང་སྔགས་ཐབ་མོའི་བསྟན་པ་ང་ཡིས་འཛུགས།",
    "ཉིན་གཅིག་གྲོང་ཕན་ཚུན་གྱི་ཕྲུ་གུ་རྣམས་ཀྱིས་རང་གི་ཤིང་གུ་འཐུ་བཞིན་འདུག་པས།",
    "པད་མ་འོད་འབར་གྱི་ཐུགས་ལ་ང་རང་ཡང་ཤིང་གུ་ཞིག་འཐུ་རུ་འགྲོ་དགོས་དགོངས་ནས་ཨ་མའི་དྲུང་དུ་ཕེབས་ཏེ་འདི་སྐད་ཅེས་ཞུས་སོ།",
    "ཨ་མ་གསན་དང་ལྷ་སྲས་བྲམ་ཟེ་ལགས།",
    "རང་རང་ལས་ཀྱི་ཤིང་གུ་འཐུ་བར་འདུག་ཨ་མས་སླེ་པོ་སླེ་ཐག་གནང་རོགས་གནང་།",
    "འཚོ་བ་ཞབས་ཏོག་ཨ་མས་འབུལ་བས་ཆོག་ཅེས་གསུངས་ཀྱང་།",
    "རང་རེ་ཕ་མ་གཉིས་འཛོམས་ཕྱོགས་སུ་འགྲོ།",
    "ཞེས་ཟེར་ནས་སླེ་པོ་རྒྱབ་ཏུ་ཁྱེར་ཏེ་རང་རང་གི་ཁྱིམ་དུ་ལོག་སོང་།",
    "སྤང་ལ་གནས་པའི་ཤྭ་བ་ཕོ་མོ་འདུག་པས།",
    "ཤྭ་བ་དེ་དག་ལ་གཟིགས་བཞིན་པད་མ་འོད་འབར་གྱི་ཐུགས་ལ་དུད་འགྲོ་རྩྭ་བཟན་རྣམས་ལ་ཕ་མ་གཉིས་འཛོམས་ཡོང་ལུགས་ཀྱིས་བུ་ང་ལ་ཕ་གཅིག་ལོས་ཀྱང་ཡོང་།",
    "ཨ་མ་གསན་དང་ལྷ་སྲས་བྲམ་ཟེ་ལགས།",
    "སྤང་ལ་གནས་པའི་ཤྭ་བ་ཕོ་མོ་འདུག་ཤུ་བ་ཨ་ཕ་ཡིན་པས་སྔོན་དུ་འགྲོ།",
    "ཤྭ་བ་ཨ་མ་ཡིན་པས་རྗེས་སུ་འགྲོཤ་ཕྲུག་ཚོགས་བསགས་ཕ་མའི་ཧྲག་ཏུ་འགྲོརྩྭ་བཟན་རྣམས་ལ་ཕ་མ་གཉིས་འཛོམས་འདུག་བུ་གཅིག་ང་ལ་ཕ་གཅིག་ལོས་ཀྱང་ཡོང་།",
    "ཨ་མའི་བུ་ཆུང་པད་མ་འོད་འབར་ཁྱེད།",
    "པད་མ་འོད་འབར་ཨ་མའི་ཕྱོགས་སུ་གསོན།",
    "དེ་ནས་ལུང་པའི་མདའ་ཡི་མཚོ་ནང་ལ་གཟིགས་པས་མཚོ་ལ་གནས་པའི་ངང་པ་ཕོ་མོ་དང་ངང་ཕྲུག་བཅས་གཟིགས་པས་པད་མ་འོད་འབར་གྱི་ཐུགས་ལ་འདབ་ཆགས་བྱ་ཡི་ལུས་ལ་ཕ་མ་གཉིས་འཛོམས་ཡོང་ལུགས་ཀྱིས་བུ་གཅིག་ང་ལ་ཕ་གཅིག་ལོས་ཀྱང་ཡོང་།་",
    "ཨ་མ་གསན་དང་ལྷ་སྲས་བྲམ་ཟེ་ལགས།",
    "མཚོ་ལ་གནས་པའི་ངང་པ་ཕོ་མོ་འདུག་ཕ་རྣམས་སྔོན་འགྲོ་མ་རྣམས་རྗེས་སུ་འགྲོ།",
    "ཨ་མའི་བུ་ཆུང་པད་མ་འོད་འབར་ཁྱེད།",
    "རང་རེའི་རྒྱལ་པོ་ལོག་པའི་མཆོད་སྦྱིན་གྱིས།",
    "སྤྲང་པོ་རྣམས་ལ་སྟོན་མོ་ཆེན་པོ་བཤམས།",
    "ཅེས་གསུངས་ནས་ཨ་མས་སེང་ལྡེང་གི་དབྱུག་པ་བསྣམས་ཏེ་ཕྱག་འབེབས་ནན་ཆེ་བ་ཞིག་གནང་བྱུང་བས།",
    "ཨ་མ་གསན་དང་ལྷ་སྲས་བྲམ་ཟེ་ལགས།",
    "ཞེས་གསུངས་ནས་སྤྱན་ཆབ་འདོན་ཅིང་སྒྲོལ་མ་ལྷ་ཁང་གི་སྒྲོམ་སྐས་བབ་བཞིན་ཕྱག་ཕེབས་པས་ཡུམ་ལྷ་སྲས་བྲམ་ཟེ་དུང་ཅན་མ་དེས་མར་བྱོན་ནས་བུ་ལ་སྨྲས་པ།",
    "ཨ་མའི་བུ་ཆུང་པད་མ་འོད་འབར་ཁྱོད།",
    "པད་མ་འོད་འབར་ཨ་མའི་ཕྱོགས་སུ་གསོན།",
    "བུ་ཁྱོད་ཐུགས་ཁྲལ་མ་མཛད་བདེ་བར་བཞུགས།",
    "འཚོ་བ་ཞབས་ཏོག་ཨ་མས་ལེགས་པར་འབུལ།",
    "པད་མ་འོད་འབར་གྱི་ཐུགས་ལ་ང་རང་ཡང་སྐུད་པའི་ཚོང་གཅིག་རྒྱུག་དགོས་སྙམ་ནས་ཨ་མའི་བལ་ཁུང་གི་ནང་ནས་བལ་འདབ་མ་ཆེ་བ་གཅིག་བཏོན་ཏེ་ཨ་མས་མ་མཁྱེན་པར་བཀལ་ནས་སྐུད་ཆེན་འོད་དང་ལྡན་པ་བཅོ་བརྒྱད་བཟོས།",
    "རྒད་མོ་ངེད་གཉིས་ཚོང་གཅིག་ཨེ་རྒྱག་རྒད་མོ་ངེད་གཉིས་ཚོང་ཤག་བྱས་པས་ཆོག་རྒད་མོ་ཁྱེད་ལ་ཚོང་སྤུས་ཅི་ཞིག་ཡོད།",
    "ང་ལ་སྐུད་པའི་ཚོང་གི་ཚོང་སྤུས་ཡོད།",
    "རྒད་མོའི་ཁ་ནས་སྨྲས་པ།",
    "ངེད་གཉིས་ཚོང་གི་གླེང་མོ་གླེང་ཟེར་ན།",
    "རེ་འགས་མཐོ་ཟེར་རེ་འགས་དམའ་སོང་ཟེར།",
    "རྒད་མོའི་བསམ་པར་པད་མ་འོད་འབར་ལ་མགོ་སྐོར་ཞིག་གཏོང་དགོས་སྙམ་ནས་ཤིང་ཏ་ལའི་སྡོང་པོའི་གསེབ་ཏུ་ཁྲིད་སོང་།",
    "ཡང་པད་མ་འོད་འབར་དང་རྒད་མོ་གཉིས་ཀན་པ་ཎི་གླུ་གུ་རེ་དང་པད་མ་འོད་འབར་གྱི་སྐུད་པ་རེ་ཚོང་བྱེད་པ་ལ་མཐུན་སོང་།",
