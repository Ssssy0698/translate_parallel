    "ཀླུ་ཡི་ལག་གི་སྦྲུལ་ཞགས་ནག་པོ་དེ།",
    "དུམ་བུ་བརྒྱ་དང་བརྒྱད་དུ་འགྲོ་བར་ཤོག་བརྡ་སྔགས་གོང་ལྟར་བརྗོད་ནས་བཟླས་པས་སྦྲུལ་ཞགས་ནག་པོ་དུམ་བུ་བརྒྱ་དང་བརྒྱད་ལ་སོང་ཞིང་།",
    "ཁྱེའུ་ཁོ་རང་སྐྱོན་མེད་དུ་ལངས་བྱུང་བས་ཀླུ་ཡི་སྒོ་རྭ་བ་བུ་མོ་དེ་གཉིས་ཧ་ལས་ངོ་མཚར་ཆེ་ཞིང་ཕྱག་སྐུར་ཚུགས་སུ་བཙལ་ནས་འདི་སྐད་ཅེས་ཞུས་སོ།",
    "ཁྱེའུ་ཆུང་ལ་མཐུ་རྩལ་ཆེ་བ་འདུག་སྔར་ཕེབས་གང་གི་ཕྱོགས་ནས་ཕེབས་ལགས་སམ།",
    "པད་མ་འོད་འབར་གྱིས་ཀླུའི་སྒོ་རྭ་བ་བུ་མོ་གཉིས་ལ་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "ཚུར་ལ་གསན་དང་ཀླུ་མོའི་རྒྱལ་མོ་མཁྱེན།",
    "སྒོ་སྲུང་བུ་མོ་གཉིས་ཀྱི་ཕྱོགས་སུ་གསོན།",
    "ཀླུ་མོའི་རྒྱལ་མོ་དེ་ངོ་མཚར་ཤིན་ཏུ་ཆེ་སྟེ་ཀླུའི་སྒོ་རྭ་བ་བུ་མོ་དེ་གཉིས་ལ་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "ཚུར་ལ་ཉོན་དང་སྒོ་སྲུང་བུ་མོ་གཉིས།",
    "རང་རེའི་ཀླུ་ཡི་སྒོ་དྲུང་འགག་འདི་རུ།",
    "དེ་ནས་ཀླུ་མོའི་རྒྱལ་མོ་དང་ངོ་འཕྲད་མཛད་དེ།",
    "ཀླུ་མོའི་རྒྱལ་མོས་པད་མ་འོད་འབར་ལ་ཞུས་པ།",
    "བདག་ཅག་ཀླུ་མོའི་ཕྱོགས་ལ་ཚུར་གསོན་དང་།",
    "སྔར་ཕེབས་གང་གི་ཕྱོགས་ནས་ཕེབས་ལགས་སམ།",
    "ཨེ་མ་མ་སན་དང་ཀླུ་མོའི་རྒྱལ་མོ་ལགས།",
    "བརྩེ་བས་དགོངས་ཏེ་ཀླུ་མོས་གནང་བར་ཞུ།",
    "ཡང་ཀླུ་མོའི་ཞལ་ནས་འདི་སྐད་ཅེས་ཞུས་པ།",
    "ང་ཅག་ཀླུ་ཡི་རྒྱལ་མོའི་ཕྱོགས་སུ་གསོན།",
    "ཨེ་མ་གསན་དང་ཀླུ་མོའི་རྒྱལ་མོ་ལགས།",
    "རྒྱ་གར་ཤར་ན་བདག་གི་མ་གཅིག་ཡོད།",
    "བརྩེ་བས་དགོངས་ཏེ་ཀླུ་མོས་ག།",
    "ཀླུ་མོས་འདི་སྐད་ཞུས་སོ།",
    "ཀླུ་ཡི་རྒྱལ་མོའི་ཕྱོགས་སུ་ཚུར་གསོན་དང་།",
    "ནོར་བུ་ཀླུ་མོའི་ལྗགས་ཀྱི་འོག་ཏུ་ཡོད།",
    "ཡང་ཀླུ་མོས་ཞུས་པ།",
    "འདི་འདྲ་མེད་པའི་བརྡ་སྔགས་ཟབ་མོ་ཞུ།",
    "ལྷག་བར་ཀླུ་མོའི་རྒྱལ་མོ་ཁྱེད་རང་ཡང་།",
    "ལྷག་པར་ཀླུ་མོ་རྒྱལ་མོ་དེ་གཞོན་ཆ་ལྡན་པ་ན་ཚོད་ལོ་བཅོ་ལྔ་ཙམ་དུ་གྱུར།",
    "དེ་ནས་དགོས་འདོད་དཔུང་འཇོམས་ཀླུ་མོའི་ལྗགས་ཀྱི་འོག་ནས་བཏོན་ཏེ་དར་ཆོན་སྣ་ལྔ་ལ་བསྒྲིལ་ནས་ཕྱག་ཏུ་བསྣམས་ཏེ་ཀླུ་མོས་སྨྲས་པ།",
    "སྒོ་རྭ་བ་བུ་མོ་གཉིས་ཀྱིས་ཀླུའི་སྒོ་ཕྱིའི་འགག་ཏུ་སྐྱེལ་མ་མཛད།",
    "ཨ་མ་ཨ་མ་ཟེར་ནས་གསུམ་བོས།",
    "ཚུར་ལ་ཉོན་དང་ཚོང་ཕྲུག་ལྔ་བརྒྱའི་ཚོགས།",
    "ཁྱེད་ཅག་ཟླ་བ་གཅིག་གི་རྗེས་སུ་བཞུགས།",
    "ང་ནི་ཨ་མ་དྲན་པས་བཟོད་གླགས་མེད།",
    "ང་རང་ཨ་མ་དྲན་པས་སྔོན་དུ་འགྲོགོ་བ་ཨེ་བྱུང་བྱེད་ཅག་ཚོང་ཕྲུག་རྣམས།",
    "དེ་ནས་སྒྲོལ་མ་ལྷ་ཁང་གི་ཕྱོགས་སུ་ཕེབས་པས།",
    "ཨ་མ་གསན་དང་ལྷ་སྲས་བྲམ་ཟེ་ལགས།",
    "ཨ་མའི་བུ་ཆུང་པད་མ་འོད་འབར་ང་།",
    "ཨ་མ་མར་ལ་མ་གཟིམ་ཡར་ལ་བཞེངས།",
    "གསན་པ་ཨེ་བྱུང་བདག་གི་ཡུམ་ཆེན་མ།"
  ]
}