    "སྐྱེངས་ལྡན་ཞི་བའི་དབྱིངས་སུ་གཟིམས་ནས་བཏང་སྙོམས་བཞུགས།",
    "རིགས་རུས་ཆོ་འབྲང་ལྡན་པར་སྐུ་འཁྲུངས་ནས།",
    "བསྟན་པ་འཛིན་པའི་སྐྱེས་བུ་རྣམས་ཀྱི་ཁྲོད་ནའང་ངུར་སྨྲིག་རྒྱལ་མཚན་འཆང་བ་ཉིད་རབ་དང་ཕུལ་དུ་བྱུང་བར་མཁྱེན་ནས་རིང་པོར་མ་ཐོགས་པར་རབ་ཏུ་བྱུང་བར་བཞེད་པའི་ཚེ།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོ་གང་ན་བཞུགས་ཞུས་པས་གཡབས་ཆེན་ན་བཞུགས་གསུང་།",
    "རྨི་ལམ་ཙམ་དུའང་ཆགས་པའི་སྐབས་མེད་པར།",
    "ཡིད་འཕྲོག་ཡིད་ཀྱི་འཛིན་མ་ཁེབས་པར་གྱུར།",
    "དེ་ནས་བསྙེན་པར་རྫོགས་པའི་སྡོམ་པ་བཞེས་ཚུལ་ནི།",
    "ཅིས་ཀྱང་བགྱིད་གསུང་བའི་ཞལ་བཞེས་བཟང་པོ་ཕེབས་པ་བཞིན་མི་ཕྱེད་པའི་དད་པས་ཐུགས་དྲངས་ཤིང་བརྩོན་པའི་ཤུགས་བསྐྱེད་ནས་ངང་པ་པདྨའི་མཚོ་ལ་སྙེག་པ་ལྟར།",
    "དཔལ་ལྡན་ས་སྐྱའི་གཙུག་ལག་ཁང་ཆེན་པོ་ག་ལ་བ་དེར་ཕེབས་ཏེ།",
    "ལྷག་པར་ལོ་གྲངས་མང་པོའི་བར་དུ་སྡོར་དཀར་ཁོ་ན་དུས་ཐམས་ཅད་དུ་གདན་གཅིག་པའི་བརྟུལ་བཞུགས་ལ་གནས་པར་མཛད་ལ།",
    "ཐུན་མཚམས་སྤྲིན་ལ་ཅོ་འདྲི་བྱས།",
    "གཞན་ཡང་བདག་ཉིད་ཆེན་པོ་འདིས་ཡོངས་འཛིན་དམ་པ་རྣམས་ཀྱི་དྲུང་དུ་ཟབ་པ་དང་རྒྱ་ཆེ་བའི་ཐོས་བསམ་གྱིས་ཐུགས་རྒྱུད་སྦྱངས་ཏེ་ཤེས་བྱའི་གནས་རྣམས་ལ་མ་རྟོགས་པ་དང་ལོག་པར་རྟོག་པ་དང་ཐེ་ཚོམ་གྱི་དྲི་མ་མཐའ་དག་དང་བྲལ་བར་མཛད་པ་ཡིན་ཏེ།",
    "ཕྱག་ན་རྡོ་རྗེ་ཨུ་ཙརྻའི་རྗེས་གནང་།",
    "སྒྲོལ་དཀར་ཡིད་བཞིན་འཁོར་ལོའི་རྗེས་གནང་།",
    "གུར་གྱི་མགོན་པོ་ལྕམ་དྲལ་ལྷ་གསུམ་གྱི་རྗེས་གནང་རྣམས་ཚར་འགའ་གསན་པར་མཛད་དོ།",
    "མཉེས་པ་གསུམ་གྱིས་མཉེས་པར་མཛད་ནས།",
    "གྲྭ་ཐང་དུ་རབ་བྱུང་མཛད་འཕྲལ་དཔོན་སློབ་གཉིས་རི་ཁྲོད་ཅིག་ཏུ་སྐུ་མཚམས་ཤིན་ཏུ་དམ་པར་བཞུགས་པའི་དུས།",
    "དེ་རྗེས་ཕྱགས་ཕྱིར་མཐིལ་བཞུགས་མཛད།",
    "ལུགས་གཉིས་ཀྱི་བཀའ་སྒྲུབ་པའི་ཁུར་བཞེས།",
    "སྒྲུབ་པ་ལུང་སྦྱིན་ཡན་ཆད་ཚང་ལ་ཡོངས་སུ་རྫོགས་པ་དེ་དག་དང་རྗེས་སུ་འབྲེལ་བའི་གསུང་ངག་གླེགས་བམ་སོགས་རྗེ་བཙུན་གོང་མའི་ཡི་གེརྗེ་རྡོ་རྗེ་འཆང་ཆེན་པོ་ཡབ་སྲས་ཀྱིས་མཛད་པའི་ཡི་གེ་སོགས་རྗེ་དེ་ཉིད་ལ་གང་བཞུགས་པ་ཐམས་ཅད་བུམ་པ་གང་བྱོའི་ཚུལ་དུ་གསན་པར་མཛད་དོ།",
    "གསང་སྒྲུབ་ཀྱི་ཉམས་འཁྲིད་རྣམས་ཐུགས་མྱོང་མ་སྐྱེས་ཀྱི་བར་དུ་གསན་ཅིང་ཉམས་སུ་ལེན་པར་མཛད།",
    "དཔལ་དུར་ཁྲོད་ཀྱི་བདག་པོའི་རྗེས་གནང་།",
    "བདུད་རྒྱལ་ཐོད་ཕྲེང་ཅན་གྱི་རྗེས་གནང་།",
    "ཁྱད་པར་བདག་ཆེན་རྡོ་རྗེ་འཆང་ཆེན་པོ་ཉིད་ཀྱི་གསུང་ནས།",
    "ད་དུང་ཀྱང་གདུང་བརྒྱུད་ཞིག་ལ་སྤེལ་བའི་འདུན་པ་བྱས།",
    "ལྷན་སྐྱེས་བདེ་བའི་ཟོལ་གྱིས་མཉམ་པར་བཞག།",
    "མཁྱེན་པའི་མངའ་བདག་འཇམ་དབྱངས་ཤཱ་རིའི་བུ།",
    "མཁྱེན་ཅིང་གསན་པའི་ཟབ་དོན་གངྒཱའི་རྒྱུན།",
    "རྒྱལ་བའི་བསྟན་པ་རབ་འབྱམས་ལ་མཁྱེན་པའི་སྤྱན་ཡངས་པའི་པཎྜི་ཏ་ཤཱཀྱ་མཆོག་ལྡན་དྲི་མེད་ལེགས་པའི་བློ་གྲོས།",
    "གཞན་ཡང་མཁས་ཤིང་གྲུབ་པའི་བདག་ཉིད་རོང་རི་ལུང་སྦུག་པ་རྒྱལ་བ་ཐུགས་རྗེ་དགུང་ལོ་བརྒྱ་དང་དྲུག་བཞེས་པ།",
    "རོང་སྟོན་ཐམས་ཅད་མཁྱེན་པའི་ཉེ་གནས་ཆེན་པོ་ནམ་མཁའ་དཔལ།",
    "གཙང་བྱམས་པ་རྡོ་རྗེ་རྒྱལ་མཚན།",
    "བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པའི་བརྒྱུད་འཛིན་མཁན་ཆེན་བཤེས་གཉེན་པ།",
    "རྒྱུད་ལུང་མན་ངག་ཕྱག་ལེན་གྱི་མཐའ་རྟེན་པའི་རྣམ་གྲངས་ཤིན་ཏུ་མང་བ་བསམ་པའི་རྭ་བ་ལས་འདས་པ་ཞིག་ནོད་པར་མཛད།",
    "དེ་དག་ཀྱང་གསན་པ་ཙམ་དུ་མ་ཟད་དཔྱིས་ཕྱིན་པར་ཚིག་དོན་གྱི་སྒྲོ་འདོགས་མཐའ་དག་ཆོད་པར་མཛད་པས།",
    "ལུང་རྟོགས་སྦྲང་རྩིའི་རྒྱལ་མཚན་བཞད་པར་གྱུར།",
    "དང་པོར་རྒྱ་ཆེན་ཐོས་བསམ་མཛད་ཚུལ་ལགས།",
    "དེ་ལྟར་ཐོས་བསམ་གྱི་སྒྲོ་འདོགས་བཅད་པའི་དོན་རྣམས་རྩེ་གཅིག་ཏུ་ཉམས་སུ་བཞེས་པས་ཐུགས་རྒྱུད་ལ་ལུང་རྟོགས་ཀྱི་ཡོན་ཏན་བསམ་གྱིས་མི་ཁྱབ་པ་འཁྲུངས་ཏེ།",
    "བྱ་འགྱུར་རྡོ་རྗེའི་བྲག་སོགས་གཙང་དབུས་ཀྱི་རི་ཁྲོད་མང་པོར་རྒྱུན་རིང་པོའི་བར་དུ་སྒྲུབ་པ་ལྷུར་ལེན་པར་མཛད་ཅིང་།",
    "རྒྱུན་གྱི་ཉམས་བཞེས་ཀྱང་ཕལ་ཆེར་སྤྲོས་མེད་ཁོ་ནའི་ངང་དུ་མཉམ་པར་འཇོག་པ་ཡིན་ལ།",
    "བདག་ཆེན་རྡོ་རྗེ་འཆང་ཆེན་པོ་གཙོ་བོར་བཞུགས་པའི་ཡོངས་འཛིན་དམ་པ་བདུན་ཅུ་རྩ་གཉིས་མཚན་ནས་བརྗོད་དེ་གསལ་བཏབ་པའི་སྒོ་ནས་གསོལ་བ་འདེབས་པ།",
    "ཟུང་འཇུག་ཕྱག་རྒྱ་ཆེན་པོ་རྣམས་ལ་རྒྱུན་ཤིན་ཏུ་རིང་བའི་བར་དུ་མཉམ་པར་འཇོག་ཅིང་།",
    "ཐུགས་ཤིན་ཏུ་དད་པར་མཛད།",
    "དེ་ནས་དགུང་ལོ་ཉི་ཤུ་ཙམ་བཞེས་པའི་དུས་བསམ་འགྲུབ་རྩེར་ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོའི་མཚན་དང་ལྡན་པའི་རིག་མ་ཞིག་དང་ལྷན་ཅིག་བཞུགས་པའི་རྐྱེན་གྱིས་ཕྱི་རོལ་གྱི་སྣང་བ་འདི་ཐམས་ཅད་ལ་བདེན་འཛིན་ཧྲུལ་པོར་ཞིག་ནས་རང་ཁ་བའི་སྣང་བ་འདི་ཡེ་མེད་པར་དུ་བའམ།",
    "དངོས་གྲུབ་བདུད་རྩིའི་ཟིལ་མངར་འཛིན་པར་གྱུར།",
    "སྣང་སྲིད་ཕྱག་རྒྱ་ཆེན་པོའི་རོལ་པར་ཤར།",
    "དེ་ནས་རྡོ་རིང་དུ་ཕེབས་ནས་ཁང་སྟེང་ཞིག་ཏུ་བཞུགས་པའི་ཚེ།",
    "དུས་རྒྱུན་པར་ཆེད་དུ་བསྟད་ནས་གསན་པ་ན་བར་སྣང་དུ་ཡི་གེ་དྲུག་པའི་སྒྲ་མི་བཅུ་ཙམ་གྱིས་བཏོན་པའི་སྒྲ་ཙམ་ལྷང་ངེ་བ་རྒྱུན་དུ་བྱུང་གསུང་།",
    "དབུས་ཕྱོགས་སུ་བཞུགས་པའི་དུས་ཤིག་མནལ་ལམ་དུ།",
    "རྗེ་ས་ཆེན་ཀྱང་ཕེབས་ཀྱིན་ཡོད་གསུང་།",
    "སྐུ་ཆས་རྣམས་སྐུ་མདུན་དུ་བྱུང་ཚད་ལ་ཐར་ཐོར་དུ་གནང་བས།",
    "ནམ་ལངས་པ་དང་ཉེ་གནས་ལ་དེ་བཞིན་གསུངས་པས།",
    "འོས་པར་བཀོད་པའི་དགེ་མཚན་ཞལ་བཟང་ནི།",
    "ཁྲུས་ཆོག་སོགས་སྐུ་རིམ་བྱེད་པར་རྩོམ་པ་ནས་ཉེ་གནས་ལ་ཡར་ཤོག་གསུང་།",
    "འཕགས་པ་བྲག་ཁུང་དུ་སྐུ་མདུན་དུ་ཕྱིན་པས་སྐུ་ཁམས་སངས་དྭངས་ནས།",
    "སྐུ་འཁྲིས་ན་ཡོད་པ་དེས་གྲུབ་རྟགས་གནང་བྱུང་ལེགས་ཞུས་པས།",
    "བདག་ཆེན་རྡོ་རྗེ་འཆང་ཆེན་པོ་འཕན་ཡུལ་དཔལ་ལྡན་རྩེ་ན་བཞུགས་པའི་དུས།",
    "གང་ནའང་བཀའ་ལྟར་བསྒྲུབ་དགོས་སྙམ་ནས་བྱོན་ནས་ནཱ་ལནྡར་ཕེབས།",
    "བྲག་པའི་སྤྱི་ཁང་ན་བཞུགས་པའི་ཚེ།",
    "གཟིམས་ཁང་ནས་འབོད་མཁན་གནང་བྱུང་།",
    "རྗེ་ཡབ་སྲས་གཉིས་ཀ་ལ་མི་ཕྱེད་པའི་དད་པ་འཁྲུངས་ཤིང་སྤྱན་ཆབ་མང་པོ་ལྷུག་པར་ཤོར།",
    "ཕེབས་པའི་ལམ་བར་རྣམས་སུ་སྤྱན་ཟུར་ལ་ཆིབས་ཀྱི་སྔ་ཤ་ལ་བྱིས་པའི་མགོ་གཅིག་ཕྲུལ་ཕྲུལ་ཡོང་།",
    "དེ་ནས་ས་སྐྱར་ཕེབས་གདོང་དུ་གྲོས་ངན་གཤོམ་པའི་གཙོ་བོ་དེའི་བུ་ཤིན་ཏུ་གཅེས་པ་གཅིག་ཤི་གཞན་རྣམས་ལའང་མི་འདོད་པའི་ལྟས་དུ་མ་བྱུང་བས་ཐམས་ཅད་འཇིགས་ཤིང་སྐྲག་ནས་ཞལ་ཏ་གང་གནང་ལྷུར་ལེན་པ་བྱུང་།",
    "རྗེ་ཉིད་ལ་ངན་སྨྲས་གཤགས་འདེབས་སོགས་མི་འཚམ་པ་དུ་མ་བྱས་པའི་དུས།",
    "རྗེ་འདི་ཉིད་ནག་པོ་ཆེན་པོའི་གསང་འཁྲིད་ཉམས་བཞེས་མཛད་པའི་ལས་སྦྱོར་གྱི་སྐབས་དང་འགྲིག་པ་བྱུང་བས།",
    "དེ་པའི་གཡོག་ཞིག་ལ་བབས་ནས་ཇ་དགོས་ཚུལ་སྨྲས་པས་རྟོག་པ་སྐྱེས་ནས་གསོལ་ཇ་ཤིན་ཏུ་ཞིམ་པ་བཏོན་ནས་ཚོང་འབུལ་བྱས་པ་བྱུང་།",
    "བྱེད་མི་བཏུབ་ན་ཀུན་གྱི་མཐུན་སྣང་གྲུབ་པའི་ལྟས་སྟོན་གསུང་བ་སོགས་གནང་བས།",
    "རྐང་བཙུགས་འོངས་ཏེ་རྗེས་གནང་ཞུས་པས་དུས་དེ་ཉིད་དུ་ཏིང་ངེ་འཛིན་དུ་མ་རྒྱུད་ལ་སྐྱེས་ནས་མི་ཕྱེད་པའི་དད་པ་ཐོབ་པ་དང་།",
    "མ་བསྒོས་པར་ཡང་འཕྲིན་ལས་ཀུན་བསྒྲུབ་ཅིང་།",
    "ཐོགས་བཅས་རྡོ་རྗེ་དྲིལ་བུ་བརྟན་པར་བཞག།",
    "ད་ལྟ་སྐུ་ལུས་ལ་ཡོད་པ་འདི་བུར་སྐྱེ་བའི་ཁག་ཐེག་གསུངས་པས་དེ་ཁོ་ན་བཞིན་དུ་བྱུང་བ་དང་།",
    "རྗེས་སུ་བརྟགས་པ་ན་མ་འོངས་པ་མཁྱེན་པའི་ལུང་བསྟན་ཁོ་ནར་བྱུང་བ་མང་།",
    "དེ་ལྟར་ལུང་རྟོགས་ཀྱི་ཡོན་ཏན་གྱི་ཆུ་ཀླུང་མ་ལུས་པ་གང་དུ་འདུས་པའི་མཁྱེན་བརྩེ་ནུས་པའི་གཏེར་ཆེན་པོ་འདི།",
    "སྔར་གྱི་བདག་ཆེན་རྡོ་རྗེ་འཆང་ཆེན་པོའི་གསུང་རྣམས་ཀྱང་རྗེས་སུ་དྲན་པས་སླར་ཞལ་གྱིས་བཞེས་ཏེ།",
    "འབད་པ་མེད་པར་ཕྱོགས་དེར་འདུས་གྱུར་ཅིང་།",
    "མཁྱེན་བརྩེ་ནོར་བུའི་ཅོད་པཎ་གྱིས།",
    "རྗེ་ས་ཆེན་ཡབ་སྲས་རྣམས་ཀྱི་ཕྱག་བྲིས་ཀྱི་པོ་ཏིས་གཙོ་བྱས་པའི་ཕྱག་དཔེ་ཤིན་ཏུ་མང་བ།",
    "དུས་དེར་དངོས་གཙང་ཞིང་གནངས་ཆེ་བའི་ཐག་ཆོད་པ་ཀུན་གྱི་བློར་མི་ཤོང་བ་ཙམ་གེགས་མེད་དུ་སླེབས།",
    "སྦྱིན་པའི་ཞིང་རྣམས་ལ་རྒྱ་མཚོ་ཆེན་པོའི་རླབས་ཕྲེང་ལྟར་ཆལ་ཆིལ་དུ་སྤྱོད་པར་མཛད་པ་མ་གཏོགས་རང་ཉིད་ཀྱི་དོན་དུ་ཞེན་ཆགས་ཅུང་ཟད་ཙམ་ཡང་མི་མངའ་བ་ཡིན་ཏེ།",
    "ལྷག་པར་བདག་ཆེན་རྡོ་རྗེ་འཆང་ཆེན་པོའི་ཐུགས་དགོངས་རྫོགས་པའི་སླད་དུ།",
    "དཔལ་མགོན་ཆེན་པོའི་མགོན་ཁང་ཀྱང་བཞི་ཐོག་པ་མཁས་བཙུན་སྨྱོན་པར་གྲགས་པས་ཞིག་གསོས་མཛད་པ།",
    "རིང་པོར་མ་ཐོགས་པར་འཕྲལ་དུ་རང་ཞིག་ཏུ་གྱུར།",
    "དེར་བཞུགས་ཀྱི་སྒྲུབ་པ་བ།",
    "རིང་ནས་འདུས་པ་དམ་ཚིག་དང་སྡོམ་པ་རྣམ་པར་དག་པས་རྒྱུད་བསྡམས་ནས་ཐུན་བཞིའི་རྣལ་འབྱོར་ལྷུར་ལེན་ཞིང་།",
    "རྗེ་ཉིད་གཙོ་བོར་ཕེབས་ཏེ་དེར་བཞུགས་ཐམས་ཅད་ཀྱིས།",
    "གཞན་ཡང་དེར་བཞུགས་ཀྱི་གཙོ་བོར་གྱུར་པ་རྣམས་ལ་དུས་རྒྱུན་པའི་གསོལ་ཇ་སོགས་ཀྱི་བསྙེན་བཀུར།",
    "དེ་འོག་རྣམས་ལའང་ཚར་རྟིང་མའི་གསོལ་ཇ་རྟག་པར་གནང་།",
    "དར་འགྱེད་རས་འགྱེད་སོགས་ཕྱག་ཏུ་གང་བྱུང་དེ་འཕྲལ་དུ་གནང་།",
    "དཔོན་སྐྱ་སོགས་རིགས་དང་སྟོབས་དང་ནོར་གྱི་དྲེགས་པ་དག་ལ་ངོ་འཛིན་མཐུན་འཇུག་ཞུམ་པའི་རྣམ་པ་ཡེ་མི་མཛད་པར།",
    "འདས་མ་འོངས་ཀྱི་ཞལ་ཏ་གང་ཡིན་དྲི་རྩད་དཔྱིས་ཕྱིན་པ་གནང་།",
    "ཁྱད་པར་དབུལ་པོ་དང་།",
    "མགོན་མེད་པའི་རིགས་ལ་ཐུགས་ལྷག་པར་བརྩེ།",
    "འཁྲུལ་འཁོར་སོགས་གང་འོས་ལྷུག་པར་གནང་།",
    "མི་འགྱུར་བདེ་ཆེན་དབྱིངས་སུ་མཉེས་པར་མཛད།",
    "ཉམས་རྟོགས་རྡོ་རྗེའི་གླུ་དབྱངས་སྒྲོག་པར་གྱུར།",
    "ཡིད་འཕྲོག་སྦྲང་རྩིའི་བཅུད་ཀྱིས་གཏམས་པར་བྱེད།",
    "བརྩེ་ཆེན་ཐུགས་རྗེས་དམན་རྣམས་ལྷག་པར་སྐྱོང་།",
    "རྣམ་གྲོལ་ཡིད་བཞིན་གླིང་དུ་ཆས་པར་གྱུར།",
    "ལས་བཞིའི་འཕྲིན་ལས་ལྷུན་གྱིས་གྲུབ་པར་གྱུར།",
    "རྡོ་རྗེ་འཛིན་པའི་དོན་དང་མཐུན་པར་གནས།",
    "དེ་འཕྲལ་དུ་ཏིང་ངེ་འཛིན་ཁྱད་པར་ཅན་སྐྱེ་བ་དང་།",
    "ལྷག་པར་ཐོག་དེར་དུས་མཚུངས་པ་ལ།",
    "གེགས་སེལ་གྱི་དམིགས་པ་གནང་བའི་དུས།",
    "རྡོ་རིང་ཀུན་སྤངས་པ་འདི་ཧམ་པ་རང་ཆེ་བ་མི་གདོན་གྱིས་བཏབ་པ་ལ་གེགས་སེལ་བྱེད་ཟེར་བ་སོགས་རང་ཉིད་དམའ་འབེབས་པའི་ཁ་འཆལ་མང་པོས་སྐུར་པ་འདེབས་པར་བྱེད་ཀྱང་དེ་དག་ལ་ཆེད་དུ་སྨོད་པ་བཞིན་ཁོ་འཕྲལ་དུ་གེགས་དེ་ལས་གྲོལ་ནས།",
    "སྔར་གྱི་གནས་ཚུལ་རྣམས་ཞུ་ཡིག་ཏུ་འཁོད་པ་མཛད་དེ་གནང་བ་ན།",
    "དེ་ཡང་གེགས་ཆེར་ཆེ་བ་རྣམས་ལ་གདམས་པ་དམིགས་ཕུག་སྟེ་གནང་།",
    "ཕལ་ཆེར་ནི་སྐུ་མདུན་དུ་སླེབ་པ་ཙམ་གྱིས་སྦྲུལ་གྱི་མདུད་པ་ལྟར་རང་གྲོལ་དུ་འགྱུར་བ་མང་བ་ཡིན་ནོ།",
    "རྟེན་སྐྱ་བོའི་དུས་བསམ་ཡས་པེ་ཀར་ལྕོག་ཏུ་ཕེབས་པའི་ཚེ།",
    "སྐུ་མདུན་དེར་མདའ་དར་ཁྲོད་ནས་དར་ཆེན་ཁ་གང་པ་ཞིག་བསྐྱུར་བྱུང་བས།",
    "ཞག་འགའ་ནས་དར་དེ་བསྐྱུར་བ་ན་རྗེས་སུ་ཕེབས་དུས།",
    "བདག་ཆེན་རྡོ་རྗེ་འཆང་ཆེན་པོའི་བཀས་ཁྱེད་དེར་བཞུགས་ལ་ལྷ་འདྲེ་དེ་ཐོན་གསུང་བ་ལྟར་དེར་བཞུགས་པས་ཆོ་འཕྲུལ་དུ་མས་ཐོག་མར་མ་སྡོད་ཟེར།",
    "གནོད་པ་གང་བྱས་གསུངས་པས་སྔར་མ་བྱས།",
    "ད་བྱས་ཀྱི་དོགས་པ་ཡིན་ཞུ་བ་ལ།",
    "ཞབས་ཏོག་བསྒྲུབ་ལགས་ཟེར་ནས་ཡལ་གསུང་།",
    "རྡོ་རིང་ན་བཞུགས་པའི་དུས་ཤིག་ལེགས་ཤེས་ཟེར་བའི་མི་གཅིག་ལ་གནས་རྙིང་རྒྱལ་པོ་ཞུགས།",
    "ཡང་བསམ་འགྲུབ་རྩེར་བཞུགས་དུས་མི་དེ་ལ་སྔར་བཞིན་ཞུགས་བྱུང་བས་ཐུགས་ང་རྒྱལ་དང་བཅས་ཏེ་ཕེབས་པ་ན་ཁོ་འཇིགས་ཤིང་ཞུམ་པའི་རྣམ་པས་རྟབ་རྟབ་པོར་གྱུར་ནས་སྐྱེས་བུ་ཆེན་པོ་དེ་ལྟར་མི་མཛད་པ་ཞུ།",
    "སྒོ་ལ་སོགས་པར་སྦྱར་ཏེ་བཞག་པ་ཙམ་གྱིས་འབྱུང་པོའི་གནོད་པ་གང་དང་གང་ཡིན་པ་དེ་ལས་རྣམ་པ་རྒྱལ་བར་གྱུར་པ་ནི་ཀུན་གྱི་མཐུན་སྣང་དུ་གྲུབ་ཅིང་ཉམས་སུ་མྱོང་བ་ཡིན།",
    "མཁྱེན་བརྩེ་ཡེ་ཤེས་རྩེར་འཛེགས་ཏེ།",
    "དེ་ལྟར་སྦྱིན་དང་སྙན་པར་སྨྲ་བ་ལ་སོགས་པས་མཚམས་སྦྱར་ནས་མཐར་ཟབ་པ་དང་།",
    "མ་གབ་པར་གསུང་།",
    "འབྲེལ་ཆགས་ཤིང་གདངས་སྙན་པའི་སྒོ་ནས་ལྷུག་པར་འདོམས་པར་མཛད་པ་ཡིན་ལ།",
    "མཐའ་ན་རྗེས་གནང་ངམ།",
    "བཟླས་ལུང་ཆུང་ངུ་ཞིག་གནང་ནའང་།",
    "གདན་གསུམ་ཚང་ཞིང་ཡོངས་དག་བཞིའི་སྒོ་ནས་དག་བྱ་དག་བྱེད་མཐའ་དག་ལེགས་པར་ཞིབ་ཏུ་ངོ་སྤྲད་ཅིང་།",
    "ལྷག་པར་ཡེ་ཤེས་ཆེན་པོའི་ཏིང་ངེ་འཛིན་གྱི་རྒྱུད་བྱིན་གྱིས་བརླབས་པས་ལུས་ངག་ཡིད་གསུམ་ལ་ཉམས་ཀྱི་འགྱུར་བ་མནན་གྱིས་མི་ཐུབ་པ་དང་།",
    "ད་ལན་ངའི་རྒྱུད་ལ་སྔགས་ཀྱི་སྡོམ་པ་རྣམ་པར་དག་པ་ངེས་པར་སྐྱེས་བྱུང་སྙམ་པའི་ངེས་པའི་ཤེས་པ་གཏིང་ཚུགས་པ་བྱུང་།",
    "རྗེ་བཙུན་དམ་པ་འདི་ཉིད་ཀྱིས་བདག་ཆེན་རྡོ་རྗེ་འཆང་ཆེན་པོའི་བརྒྱུད་པའི་སྲོལ་གཞུང་བཟུང་ནས་སེངྒེའི་ང་རོ་ལན་ཅིག་མ་ཡིན་པར་ཡང་ཡང་བསྒྲགས་ཏེ།",
    "ད་ལྟའི་བར་དུ་སྙན་བརྒྱུད་ཀྱི་གདམས་པ་ལོ་གྲངས་བསྐོར་བའི་འཆད་ཉན་སྒོམ་སྒྲུབ་ཀྱི་སྒོ་ནས་སྐལ་བ་རབ་ཀྱི་མཆོག་ཏུ་གྱུར་པ་རྣམས་སྨིན་ཅིང་གྲོལ་བར་བྱེད་པའི་རྒྱུན་མ་ནུབ་པར་ཡོད་པས།",
    "ས་སྐྱ་སྐྱེད་འཕྲེང་པ་སོགས་མི་ཆེན་གྱི་སྦྱིན་བདག་ཀྱང་བསམ་གྱིས་མི་ཁྱབ་པས་མཆོད་ཅིང་བཀུར་བའི་གནས་སུ་བཞུགས་པ་ཡིན་ནོ།",
    "ལྷ་ཡི་རྔ་བཞིན་དུས་སུ་འདོམས་པར་འགྱུར།",
    "རྗེ་ཉིད་ཀྱང་ཞིང་གཞན་དུ་འབྱོན་པའི་གསུང་འབའ་ཞིག་གནང་།",
    "ཁྱེད་ཚོ་རྐྱང་པར་མ་ཟད་ཁྱེད་ཚོ་ལ་བློ་གཏད་པ་ཚོའང་ངས་སྐྱོང་པ་ཡིན།",
    "རྗེ་ཉིད་ཀྱང་ཕལ་ཆེར་ལྟ་སྟངས་དང་བཅས་པའི་མཉམ་གཞག་ཏུ་བཞུགས།",
    "བདག་ལ་ད་ལྟ་ལག་ན་ཡོད་པའི་རྡོ་དྲིལ་འདི་གནང་།",
    "མཁའ་ཁྱབ་ཀྱི་ཏིང་ངེ་འཛིན་འགོག་པའི་བདེན་པ་རྣམ་པར་གྲོལ་བའི་ཡེ་ཤེས་ཀྱི་སྐུ་མངོན་དུ་མཛད་དེ།",
    "འཇའ་དང་འོད་ཀྱི་ལམ་ནས་འོག་མིན་དག་པའི་ཞིང་དུ་གཤེགས་པར་གྱུར་ཏོ།",
    "འོག་མིན་གཙང་མའི་གདན་ཁྲི་ལ།",
    "མཁའ་མཉམ་འགྲོ་འདི་རྟག་པར་སྐྱོང་བ་ལ།",
    "བློ་འདས་བརྗོད་བྲལ་རང་ཞལ་རྒྱུན་པར་མཇལ།",
    "དེ་བཞིན་རང་ཉིད་བརྒྱུད་པར་བཅས་ལ་ངོ་མཚར་གཏམ་དང་བྲལ་འགྱུར་དག།",
    "སྐྱེ་བོ་དམན་དང་དམ་པའི་ཁྱད་པར་ནི།",
    "རྒྱ་ནག་མཆོད་རྟེན་དཀར་པོ་ཡན་ཆད་ཀྱི་ཡུལ་གྲུ་ཕལ་ཆེར་ན་ཁྱབ་པར་ཡོད་ཅིང་།",
    "མིག་ཙམ་ཡང་ལྟ་བའི་སྐབས་མེད་པར་གྱུར་ཏེ།",
    "ད་ལྟའི་བར་དུ་བོགས་ཡོང་སྒོ་མཐའ་དག་ཚང་མར་བླ་བྲང་དུ་བཞེས་ནས་འདོད་དགུར་ལོངས་སྤྱོད་ཆོག་པའང་ཀུན་གྱི་མཐུན་སྣང་དུ་གྲུབ་པ་འདི་ལགས་སོ།",
    "ད་ལྷག་མ་སྟོང་དང་གསུམ་བརྒྱ་སུམ་ཅུ་རྩ་དགུ་གནས་པར་ཤེས་པར་བྱའོ།",
    "དགེ་ཚོགས་དྲི་མེད་གཞན་དང་ལྷན་ཅིག་མ་རྣམས་དོན་དུ་མྱུར་བ་ཉིད་དུ་ཀུན་མཁྱེན་རྒྱ་མཚོར་འཇུག་གྱུར་ཅིག།",
