    "གཙུག་ལག་སློབ་དཔོན་སྐུ་ཞབས་ཌི་ཤིབ་ལིངྒཱ་ཡཱ་ལགས།",
    "གཙུག་ལག་སློབ་དཔོན་སྐུ་ཞབས་ཨེ་ཆི་པི་ནཱག་ཨིན་དྲ་ལགས།",
    "སྐུ་ཞབས་ཨ་པ་ཐུ་ཀ་ཐ་ཤི་ཝ་ཐཱ་ནུ་པིལ་ལེ་ལགས་བཅས་དང་།",
    "མི་རབས་གཉིས་ཙམ་གྱི་སྤོ་བོ་ལགས་དང་རྨོ་བོ་ལགས་ཆགས་པ་བྱུང་ཡོད།",
    "ཅེས་སོགས་ཀྱི་བཀའ་སློབ་ཕེབས་ཡོད།",
    "སྔོ་ཚལ་ནང་འབུའི་རིགས་ཐོན་པ་རྣམས་ཟུར་འཇོག་བྱས་ཏེ་སྲོག་སྐྱོབ་བྱེད་སྐབས་ཐོག་མར་ལས་རོགས་ཨ་རི་བ་ཚོས་དུས་ཚོད་འཕྲོ་བརླག་ཡིན་པ་བརྗོད་ཡོད་ཀྱང་།",
    "སྐབས་དེར་སྡིངས་ཆའི་སྟེང་རྒྱ་གར་བྷོ་ལི་ཝུ་ཌ་གློག་བརྙན་འཁྲབ་སྟོན་པ་སྐུ་ཞབས་ཨ་ནིལ་ཀ་པུར་ལགས་དང་།",
    "ངོས་རང་དུད་འགྲོར་བྱམས་བརྩེའི་ཐོག་ནས་སྲུང་སྐྱོབ་བྱ་རྒྱུ་གལ་ཆེ་ཡིན་སྐོར་གྱི་ལྷན་ཚོགས་འདིར་བཅར་ཐུབ་པར་ཧ་ཅང་དགའ་པོ་བྱུང་།",
    "དེ་སྔ་ངོས་ཀྱི་གྲོགས་པོ་ཚན་རིག་པ་སྐུ་ཞབས་ཕེ་རན་སི་སི་ཀོ་ཝ་ལེ་ར་དམ་པ་མཆོག་དང་ལྷན་སྲོག་ལྡན་གྱི་གོ་དོན་ཐོག་གོ་བསྡུར་ཡུན་རིང་བྱས་མཐར།",
    "འབྲོག་པའི་འཚོ་བའི་ནང་ཤ་མ་ཟ་ན་གནམ་གཤིས་གྲང་ངར་ཆེ་བ་དང་ཟ་འབྲུའི་རིགས་ཧ་ཅང་དཀོན་པོ་ཡིན་པར་བརྟེན་འཚོ་ཐབས་བྲལ།",
    "ཕྱོགས་བཞུགས་སྤྱི་འཐུས་ཨ་ཀྲུག་ཚེ་བརྟན་ལགས།",
    "དེ་བཞིན་སློབ་ཕྲུག་བཅས་ཀྱིས་བདུག་སྤོས་དང་མེ་ཏོག་དཀར་གཙང་མཇལ་དར་ཐོགས་ཏེ་ཕེབས་བསུ་གཟབ་རྒྱས་ཞུས་ཡོད།",
    "ཚང་མས་ཐུགས་སྨོན་མཚམས་སྦྱོར་གནང་རོགས་ཞུ་རྒྱུ་ཡིན།",
    "ཁྱབ་ཀྱང་ཉམས་པར་གྱུར་པའི་ཕྱོགས་དེ་ནི།",
    "ཕན་བདེའི་གཏེར་འདིས་སེལ་བར་བྱེད་པར་ཤོག་ཅེས་གསུངས་པ་བཞིན།",
    "ཁྱབ་ཀྱང་ཉམས་པར་གྱུར་པའི་ཕྱོགས་དེ་ནི།",
    "ཕན་བདེའི་གཏེར་འདིས་སེལ་བར་བྱེད་པར་ཤོག་ཅེས་གསུངས་པ་ཡིན་སྟབས།",
    "སོ་སོ་དཀའ་ལས་ཁག་པ་གྱོང་གུན་ལ་མི་འགྲོ་བ་ཞིག་དང་སྦྱིན་བདག་ཚོས་མཐུན་རྐྱེན་སྦྱར་པ་དེ་ཆུད་ཟོས་སུ་མི་འགྲོ་ཞིག་ཚང་མས་གཟབ་གཟབ་བྱས་ཏེ་གནང་རོགས།",
    "ཞེས་གསུངས་བ་དང་།",
    "ནམ་མཁའ་བྱས་ཏེ་ནམ་མཁའི་དབྱིངས་ནས་ཚུར་ཤར།",
    "༡ བར་དགའ་ལྡན་ཤར་རྩེ་གྲྭ་ཚང་དུ་བཞུགས་ཞག་དང་།",
    "ཡོན་ཏན་གཞིར་གྱུར་མ་བཅས་གསུང་འདོན་གནང་།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "ཕྱི་ཚེས་༦ ནས་༨ བར་སྒོ་མང་གྲྭ་ཚང་དུ་བཞུགས་ཞག་མཛད་ཡོད།",
    "དེ་བཞིན་དགའ་ལྡན་ལྔ་མཆོད་ནི་ཕྱི་ལོ་༡༤༡༩ བོད་ཟླ་༡ ཚེས་༢༥ ཉིན་དགའ་ལྡན་དགོན་དུ་རྗེ་ཙོང་ཁ་པ་ཆེན་པོ་སྐུ་གཤེགས་རྗེས་ལོ་དེའི་ཕྱི་ལོ་ནས་རྡོ་རྗེ་སློབ་དཔོན་བརྒྱ་ཕྲག་མང་པོས་དཀྱིལ་འཁོར་ལ་བརྟེན་པའི་སྒྲུབ་མཆོད་སོགས་དགོངས་རྫོགས་མཆོད་འབུལ་རྒྱ་ཆེ་མཛད་པར་བརྟེན།",
    "རང་ཉིད་ཀྱི་ལྟ་གྲུབ་ཁྱད་པར་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ཞལ་བཞུགས་པའི་སྐབས་སུ་ཤེས་བཞིན་དུ་ཁྱད་གསོད་བྱེད་མཁན་ཡོད།",
    "དུས་ཚོད་ཁག་པོ་འདི་འདྲ་ཞིག་ལ་བསྡད་ཡོད།",
    "འཚོགས་སར་ངོས་རང་ཡོང་རོགས་ཞེས་གསུངས་བྱུང་།",
    "དེ་ལྟ་བུའི་ཐུགས་སྣང་གནང་བར་ཐུགས་རྗེ་ཆེ་བརྗོད་རྒྱུ་ཡིན།",
    "བོད་པར་རན་པའི་བཅོས་བསྒྱུར་ཞིག་བོད་པ་རང་ཉིད་ཀྱིས་བཏང་ན།",
    "ངོས་རང་དེའི་སྐབས་ནས་ཕྱེད་རྒན་ཡོལ་གྱི་གནས་སྟངས་ཐོག་བསྡད་ཡོད།",
    "རྒན་ཡོལ་དེ་ཡང་ངོས་རང་སྒེར་རྒན་ཡོལ་བྱས་པ་ཙམ་དུ་མ་ཟད།",
    "མི་ཚང་མ་ཚོགས་ནས་བྱེད་ཐུབ་ཐབས་མེད་པར་བརྟེན།",
    "ཡང་ན་ཐག་གཅོད་མ་བྱེད་ཀ་མེད་ཐོག་ནས་ཐག་གཅོད་བྱས་པ་དེ་འདྲ་རྩ་བ་ནས་མིན།",
    "ཆབ་སྲིད་ཀྱི་འགན་དེ་འོས་བསྡུའི་ཐོག་ནས་སླེབས་པའི་འགོ་ཁྲིད་ཀྱིས་འགན་གཙང་མ་འཁྱེར།",
    "བོད་ཀྱི་མ་འོངས་པ་ཕྲུ་གུ་ཚོའི་ལག་པར་ཡོད་སྟབས།",
    "སྡོམ་པ་འབོགས་རྒྱུ་དེ་ཚོའི་གྲས་མཁན་ཆེན་ཞི་བ་ཚོས་འགན་རྐང་བཞེས་ཡོད།",
    "ཡི་གེའི་མིང་ཚིག་གསར་པ་རིམ་བཟོས་བྱས་སྟབས།",
    "བོན་པོའི་གཞུང་ནས་གསུངས་པ་ཡིན་ན།",
    "༡༩༤༧ ལྷ་སའི་ཉེ་འཁོར་ལ་སྐུ་མདུན་སྐུ་གོང་མའི་སྐབས་ནས་གློག་ཁང་ཞིག་བཟོས་ཡོད།",
    "དེ་ནས་ལྷོ་སྤྱི་ཀརྨ་སེང་གེ་ལགས་ཀྱིས་གཏང་རག་མཎྜལ་ཚོམས་བུ་འདེགས་འབུལ་ཞུ་བཞིན་ཚེ་དཔག་མེད་ཀྱི་བསྟོད་པ་ཉི་གཞོན་འཆར་ཀ་མ་དང་།",
    "ཅེས་གསུངས་ཡོད།",
    "ཁྱེད་རྣམ་ཚང་མས་ཐུགས་སྨོན་མཚམས་སྦྱོར་གནང་རོགས།",
    "ཁ་སེང་ངོས་ཀྱིས་བསམ་འཆར་ཞིག་ཁོང་རྣམ་པར་ཞུས་པ་ཡིན།",
    "ཕྱོགས་གཅིག་ནས་ངོས་རང་རྒལ་ཡོལ་བྱས་ཏེ།",
    "ནང་སྲིད་དྲུང་འཕར་འཆི་མེད་ལགས།",
    "ལྷོ་སྤྱི་ཀརྨ་སེང་གེ་ལགས།",
    "བོད་མིའི་མངོན་འདོད་དེའི་ཆེད་འབད་བརྩོན་གནང་རོགས་ཙམ་མ་ཟད།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོས་འཚེ་བ་དང་དྲག་པོའི་ཐབས་ལམ་ཡོངས་སུ་སྤངས་ཏེ་བཟོད་བསྲན་དང་ཕན་ཚུན་གུས་བརྩིའི་ལམ་ནས་ཞི་འགྲིག་ཡོང་ཐབས་གནང་བའི་མཛད་རྗེས་ལ་དམིགས་བསལ་གཟེངས་བསྟོད་གནང་ཡོད།",
    "འདས་པའི་ལོ་དྲུག་ཅུ་ལྷག་རིང་འགལ་རྐྱེན་སྣ་ཚོགས་ཡོད་བཞིན་དུ་བོད་མི་ཚོས་ཞི་བའི་ཐབས་ལམ་སྣ་ཚོགས་བརྒྱུད་སོ་སོའི་མངོན་འདོད་གསལ་སྟོན་བྱས་ཡོད།",
