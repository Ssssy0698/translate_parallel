    "མ་ཧཱ་ག་ཎ་པ་ཏི་ཛཱི་བི་ཏཱན་ཀ་རཱ་ཡ་ཞེས་པས་བསལ་ལ་བསྒྲུབ་བྱའི་མིང་བསྐུལ་བ་དང་བཅས་པ་གཞུག་པར་བྱའོ།",
    "གཞན་གྱིས་མི་ཐུབ་པའི་སྔགས་གསུངས་པ།",
    "རྟ་མགྲིན་གྱི་གསང་སྔགས་ཀྱིས་དུག་གཞོམ་པ་གསུངས་པ།",
    "བེ་ཅོན་སྔོན་པོའི་སྔགས་གསུངས་པ།",
    "སྟོབས་པོ་ཆེའི་སྔགས་གསུངས་པ།",
    "འདོད་པའི་རྒྱལ་པོ་སྔགས་གསུངས་པ།",
    "དེ་ནས་ཀུན་དུ་སྒྲོགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ནི་དགུག་པའི་བདག་ཉིད་པས་ཁྱབ་པའི་ཕྱིར་སྒྲོགས་པའོ་། ད་ནི་མི་གཡོ་བའི་སྔགས་བསྟན་པའི་ཕྱིར་བཅོམ་ལྡན་འདས་དྲི་མ་མེད་པ་རྡོ་རྗེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གནོད་མཛེས་ཀྱི་གསང་སྔགས་གསུངས་པ།",
    "དམ་ཚིག་རྣམ་པར་འཕྲུལ་པ་ཞེས་བྱ་བ་ནི་ཁྲོ་བོའི་ལས་ཀྱི་བདག་ཉིད་དོ།",
    "དེ་ལྟར་ཁྲོ་བོ་བཅུའི་སྔགས་བསྟན་ནས་དགུག་པའི་ཁྱད་པར་བསྟན་པའི་ཕྱིར།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྡོ་རྗེ་སེམས་དཔའ་རྣམ་པར་བསྒོམ།་།",
    "རྡོ་རྗེ་སེམས་དཔའ་དགུག་པ་གསུངས་པ།",
    "རྡོ་རྗེ་སེམས་དཔའ་དགུག་པར་བྱའོ་་དང་།",
    "སྔགས་ཐམས་ཅད་དགུག་པ་གསུངས་པ།",
    "སྐུ་གསུང་ཐུགས་རྡོ་རྗེའི་བདག་ཉིད་དུ་བསྒོམས་ཏེ་སྔ་མ་བཞིན་དུ་ཐུགས་ཀ་ནས་འཁོར་ལོ་པདྨོ་རྡོ་རྗེ་ཀྱོ་བས་ལྷ་ཐམས་ཅད་དགུག་པར་བྱའོ།",
    "ཤ་ཙི་ཀ་དགུག་པར་གསུངས་པ།",
    "ཞེས་བྱ་བ་ིལ་སོགས་པ་སྟེ་ཟླ་བའི་འཁོར་གྱི་སྟེང་དུ་རྣམ་པར་སྣང་མཛད་ཀྱི་ཕྱག་རྒྱུ་བསྒོམས་ཏེ།",
    "དེ་ནས་ནང་པར་ཕྱུང་ལ་བཞག་སྟེ།",
    "ནམ་འགུགས་པར་འདོད་པ་ན་རྫས་དེ་ལ་ལིང་ག་བྱས་ཏེ་མིང་བྲི་བའི་སྣག་ཚ་ཡང་བྱས་ལ་ལིང་གའི་སྟེང་དུ་མིང་བཞག་ན་ཚངས་པ་དང་དྲག་པོའང་འོང་བར་འགྱུར་རོ།",
    "ཀུན་གྱི་ཕྱག་རྒྱ་ཁྱད་པར་དང་།",
    "དེ་ལ་ཀུན་གྱི་ཕྱག་རྒྱུའི་ཁྱད་པར་ཞེས་པ་ནི་ཐམས་ཅད་ཀྱི་ཕྱག་རྒྱ་གང་ཡང་རུང་བའོ།",
    "སྔགས་ཀྱི་ཁྱད་པར་ཐམས་ཅད་ཀྱིས།",
    "ཀུན་ཀྱང་དགུག་པའི་ཐབས་སུ་མི་འགྱུར་བ་མེད་པར་གསུངས་སོ།",
    "གཞན་དུ་བྱས་ན་འཇིག་པར་འགྱུར།",
    "༢ དཔལ་གསང་བ་འདུས་པའི་མངོན་རྟོགས་བཞུགས།",
    "༤ ཤྲཱི་མ་ཧཱ་མ་ཡའི་མངོན་རྟོགས་གཏོར་མའི་ཆོ་ག་དང་བཅས་པ་བཞུགས།",
    "༥ དཔལ་པད་མ་རྒྱལ་པོའི་རྒྱུད་ཀྱི་བསྡུས་དོན་བཞུགས།",
    "༦ རྒྱལ་བ་རྒྱ་མཚོའི་མངོན་རྟོགས་བཞུགས།",
    "༡༡ དཔལ་ལཱུ་ཧི་པས་མཛད་པའི་སྒྲུབ་ཐབས་ཀྱི་བསྡུས་དོན་བཞུགས།",
    "༧ ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོས་མཛད། ། ཀུན་མཁྱེན་མི་ཕམ་རྒྱ་མཚོའི་གསུམ་འབུམ།",
    "༡༧༨ གཉིས་པ་རྩོམ་པར་དམ་བཅའ་བ།་",
    "༩༨༥ དང་པོ་ལུས་རྣམ་པར་གཞག་པ།་",
    "མཁྱེན་བརྩེའི་ཆ་རྫོགས་རྒྱལ་བའི་ཟླ་བ་གང་།",
    "དར་རྒུད་བདེ་སྡུག་ལ་སོགས་པ་ཐམས་ཅད་མཐའ་གཅིག་ཏུ་ངེས་པ་མེད་པར་སྐད་ཅིག་མའི་ཟློས་གར་གློག་བཞིན་བསྐྱོད་པ་ཁོ་ནར་ངེས་ཤིང་།",
    "གང་ཞིག་འཇིག་རྟེན་འདི་ན་སྡུག་བསྔལ་མཐར་བྱེད་པའི་ཐབས་མཁྱེན་པ་དང་།",
    "འགྲོ་བ་ཀུན་བསྐྱབ་པར་འདོད་པའི་བརྩེ་བ་དང་།",
    "སྐྱོབ་པར་ནུས་པའི་ཕྲིན་ལས་མངའ་བ་དེ་ནི་སུ་ཞིག་གོ་ཞེས་ལེགས་པར་བསམས་པའི་ཚེ།",
    "དེ་ལ་དཔགས་ནས་ཐབས་དེ་སྟོན་པ་རང་ཉིད་ཀྱིས་མངོན་སུམ་དུ་མཛད་པའི་མཁྱེན་པ་དང་།",
    "མྱ་ངན་འདས་པར་འགྲོ་འགྱུར་དང་།",
    "རྒྱ་མཚོའི་ནང་ན་རྣམ་པར་གནས།",
    "ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "ཞེས་གསུངས་ཏེ།",
    "དེ་ལ་འཕགས་པ་ཞེས་པ་གང་ལས་ཁྱད་པར་དུ་འཕགས་པའི་ཡུལ་ལ་ལྟོས་ཏེ་འཇུག་བྱ་ཐ་དད་ཀྱང་།",
    "ཡོན་ཏན་ནི་བསྔགས་འོས་ཀྱི་ཁྱད་པར་གཞུང་ནས་འཆད་པར་འགྱུར་བ་རྣམས་སོ།",
    "སྐྱབས་ཡུལ་གྱི་ཡོན་ཏན་ཡེ་ནས་དེ་ལྟར་སྒྲོ་སྐུར་བྲལ་བར་གནས་པ་ལ་ཕྱིན་ཅི་མ་ལོག་པའི་བློས་རྗེས་སུ་དྲན་པར་བྱེད་པའོ།",
    "ཞེས་ཇི་ལྟ་ཇི་སྙེད་ཀྱི་ཤེས་བྱའི་རྣམ་པ་མ་ལུས་པ་མ་འདྲེས་སྒྲིབ་མེད་དུ་མཁྱེན་པ།",
    "འདིར་ཡང་མ་རིག་པའི་གཉིད་སངས་ཤིང་ཤེས་བྱ་ལ་བློ་རྒྱས་པ་འདམ་ལས་གྲོལ་བའི་པདྨ་རྣམ་པར་རྒྱས་པ་ལྟ་བུའི་རྟོགས་ཚུལ་གྱི་བརྗོད་བྱ་མཚོན་པར་བྱེད་པ་ཡིན་པས།",
    "ཡང་དག་པར་རྫོགས་པ་ཞེས་བྱ་སྟེ།",
    "དེ་ལས་ཁྱད་ཕྱེ་བའི་དོན་དུ་རྫོགས་པར་ཞེས་དང་།",
    "དེ་ལས་ཁྱད་པར་ཕྱེ་བའི་དོན་དུ་ཡང་དག་པ་ཞེས་སྨྲས་པ་སྟེ།",
    "རིག་པ་དང་ཞབས་སུ་ལྡན་པ་ཞེས་གསུངས་ཏེ།",
    "དེ་ལ་རྒྱུ་ལམ་གྱི་རྣམ་པ་མཐའ་ཡས་ཀྱང་བསླབ་པ་གསུམ་དུ་ཡང་དག་པར་འདུ་ལ་དེ་དག་ཀྱང་འཕགས་པའི་ས་ན་འཕགས་ལམ་ཡན་ལག་བརྒྱད་དུ་བཞག་པའི་ནང་ཚན་ཡང་དག་པའི་ལྟ་བ་ནི་རིག་པ་ཡིན་ལ།",
    "སླར་མི་ལྡོག་པར་གཤེགས་པ་མ་ལུས་པར་གཤེགས་པ་གསུམ་སྟེ།",
    "གཤེགས་ཚུལ་དེས་ནི་བདག་ལྟའི་ས་བོན་མ་སྤངས་པའི་ཕྱི་རོལ་པའི་ལམ་ལས་ཁྱད་པར་བྱས་པ་ཡིན་ཏེ།",
    "དེ་དག་ལ་ཕྱིར་མི་ལྡོག་པ་ཙམ་ཡོད་ཀྱང་སྤངས་རྟོགས་མ་རྫོགས་པའི་ཁྱད་པར་ཡིན་པས་སོ།",
    "དྲི་མ་དྲུང་འབྱིན་གྱི་གཉེན་པོ་བདག་མེད་རྟོགས་པའི་ཤེས་རབ་ཁྱད་པར་ཅན་ཡོད་པ་དང་།",
    "འཇིག་རྟེན་མཁྱེན་པ་ཞེས་སོགས་ཀྱི་དོན།",
