    "དོན་བྱ་བ་ཐམས་ཅད་ཀྱི་ནུས་པ་དང་བྲལ་བ་ལ་ནི་རྟོག་པ་དང་ལྡན་པ་རྣམས་ཀྱིས་རྣམ་པར་དཔྱད་པའི་དོན་ཅི་ཡང་མེད་དེ།",
    "དོན་བྱ་བར་ནུས་པ་རྣམ་པར་རྟག་པའི་ཡུལ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་དངོས་པོ་ཡུལ་ཐམས་ཅད་བདག་མེད་པ་ལ་སོགས་པར་མ་བསྟན་ཏོ་སྙམ་དུ་མ་སེམས་ཤིག་ཐམས་ཅད་ཅེས་བྱ་བའི་སྒྲ་ནི་བརྗོད་པར་འདོད་པའི་དོན་མ་ལུས་པ་ལ་བརྗོད་པའི་ཕྱིར་ཏེ།",
    "བརྗོད་པར་འདོད་པ་ནི་དོན་བྱེད་ནུས་པའི་དངོས་པོ་ཐམས་ཅད་དོ།",
    "གཞན་ནི་རིམ་དང་ཅིག་ཤོས་ཀྱི་དོན་བྱེད་པར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "སྐད་ཅིག་མ་ཡིན་པར་བརྗོད་དུ་མེད་པ་ནི་རང་བཞིན་མེད་པ་ཉིད་དེ།",
    "ནམ་མཁའི་མེ་ཏོག་ལ་སོགས་པ་ལྟར་བསྒྲིམ་མི་དགོས་པར་གྲུབ་བོ།",
    "སྐད་ཅིག་སྐད་ཅིག་མ་ཡིན་པར།",
    "སྐད་ཅིག་པར་གྱུར་ན་ནི་དུ་མའི་རང་བཞིན་དུ་འགྱུར་ཏེ།",
    "གཉི་ག་ལྟར་ཡང་བརྗོད་དུ་མེད་ན་ནི་ཚེགས་མེད་པར་གཅིག་དང་དུ་མའི་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་དུ་གྲུབ་བོ།",
    "ནམ་མཁའ་ལ་སོགས་པ་ཕྱོགས་ཐ་དད་པའི་ཤིང་ལ་སོགས་པ་དང་འབྲེལ་བ་དེ་དག་ཤིང་གཅིག་དང་འབྲེལ་བའི་རང་བཞིན་གང་ཡིན་པ་དེ་ཉིད་གཞན་དང་འབྲེལ་བ་ཅན་ཡང་ཡིན་ན་ནི་དེས་ན་དེ་དང་འབྲེལ་བའི་ཕྱིར་དེ་གཅིག་པུའི་བདག་ཉིད་ཡིན་པ་བཞིན་དུ་གཞན་ཡང་དེ་དང་ཐ་དད་མ་ཡིན་པར་འགྱུར་རོ།",
    "འོན་ཏེ་དེ་ཕྱོགས་ཐ་དད་ན་ནི་རང་བཞིན་དེ་ཉིད་གཞན་དང་འབྲེལ་བ་ཅན་མ་ཡིན་པར་འགྱུར་རོ།",
    "རགས་པར་འདོད་པ་ལུས་ལ་སོགས་པ་ཡང་བསྒྲིབས་པ་དང་།",
    "ཚིག་པ་དང་མ་ཚིག་པ་ལ་སོགས་པ་མི་མཐུན་པའི་ཕྱོགས་གནས་པའི་རང་བཞིན་འཛིན་ན་གཅིག་པུའི་རང་བཞིན་དུ་རིགས་པར་འགྱུར།",
    "ཡང་ན་ཕན་ཚུན་མཐུས་འཛིན་གྱིས་མ་འབྱར་བའི་རང་བཞིན་པར་ཡོད་ཅིང་བསྐོར་བ་སྟེ།",
    "བརྗོད་པར་ཟད་ཀྱི་རྡུལ་དེ་ནི།",
    "ཡང་ན་མང་པོ་དག་པར་མེད་དེ།",
    "བདག་ཉིད་ཐམས་ཅད་ཀྱིས་འབྱར་ན་ནི་རྫས་རྣམས་འདྲེས་པར་འགྱུར་ཏེ།",
    "བར་ཡོད་པ་ཡང་བར་དག་ཏུ་སྣང་བ་དང་མུན་པའི་རྡུལ་ཕྲ་རབ་རྣམས་ཀྱི་གོ་སྐབས་ཡོད་པར་འགྱུར་ཏེ།",
    "བར་མེད་རྣམ་པར་གནས་ཀྱང་རུང་།",
    "དེ་ལྟ་བས་ན་ཤར་དང་ནུབ་ལ་སོགས་པའི་ཆ་ཅན་མི་གནས་པས་སའི་དཀྱིལ་འཁོར་ལ་སོགས་པ་གནས་པར་མི་འགྱུར་རོ།",
    "གཅིག་པུ་ཆ་ཤས་མེད་པར་འགྱུར།",
    "ཕྱོགས་བཅུ་ན་རྣམ་པར་གནས་པའི་རྡུལ་ཕྲ་རབ་ཏུ་གྱུར་པའི་གྲངས་ཀྱི་རང་བཞིན་དང་ལྡན་པའི་ཕྱིར།",
    "འདི་ལྟར་གཅིག་པུ་རྣམ་པར་གཞག་པ་སྨྲོས་ཤིག་རང་བཞིན་ཐ་དད་པའི་མཚན་ཉིད་ཡིན་པས་དངོས་པོ་ཐ་དད་དེ།",
    "གཟེགས་ཟན་པ་ལ་སོགས་པས་སྨྲས་པའི་རྫས་དང་ཡོན་ཏན་ལ་སོགས་པ་བསྒྲིམ་མི་དགོས་པར་རང་བཞིན་གྱིས་སྟོང་པར་ངེས་སོ།",
    "དེ་ཡི་སྤྱི་དང་ཁྱད་པར་ཡང་།",
    "རྣམ་པར་ཤེས་པ་དེ་འདས་མ་ཐག་པའི་ཡིད་ཀྱང་ཡང་དག་པར་རྣམ་པར་གཞག་པར་མི་རིགས་སོ།",
    "ལྡན་པ་མ་ཡིན་པའི་འདུ་བྱེད་རྣམས་ཀྱང་རྣམ་པར་རྟོག་པ་ལ་དཔའ་བ་མཁས་པ་རྣམས་ཀྱིས་ལན་བརྒྱར་དུམ་བུ་དུམ་བུར་བཤིག་ཟིན་པས་ཤི་ཟིན་པ་དེ་དག་ལ་བསྣན་མི་དགོས་སོ།",
    "ནམ་མཁའ་ལ་སོགས་པ་འདུས་མ་བྱས་མཐའ་དག་ཀྱང་སྔར་བསྟན་ཟིན་ཏེ།",
    "སྤྱི་དང་སྤྱིའི་ཁྱད་པར་དང་ཁྱད་པར་ཡང་ཡོད་པ་དང་།",
    "རང་བཞིན་མེད་པར་སྔར་བསྟན་ཟིན་ཏོ།",
    "དེ་ལ་གཉིས་ཀྱི་ཚུལ་ནི་གང་དག་གཟུང་བ་དང་འཛིན་པ་གཉིས་ཡང་དག་པར་ཡོད་པར་འདོད་ལ།",
    "རྣམ་པར་ཤེས་པ་ནི་ཤེལ་སྒོང་དག་པ་ལྟ་བུ་ཡུལ་གྱི་རྣམ་པ་མི་འཛིན་པར་བརྗོད་པ་སྟེ།",
    "རྣམ་པར་ཤེས་པ་ཡུལ་གྱི་སྣང་བ་དང་མ་ཕྲད་པ།",
    "འདི་རང་རིག་པའི་རང་བཞིན་དུ་རྣམ་པར་གཞག་པ་ནི་རང་བཞིན་གྱིས་གསལ་བའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ཡུལ་གྱི་ངོ་བོར་བཞག་པ་ནི་བསྐྱེད་པར་བྱ་བ་ཉིད་དེ་རིག་པ་པོ་ཉིད་དོ་ཞེས་རྣམ་པ་དང་བཅས་པའི་ཤེས་པའི་ཚུལ་ལས་བརྗོད་པ་ལྟ་བུར་རང་རིག་པ་ལ་ནི་དེ་ལྟར་རྣམ་པར་གཞག་པར་མི་འཐད་དེ།",
    "རྣམ་པར་ཤེས་པ་ཆ་མེད་པའི་བདག་ཉིད་ལས་བསྐྱེད་པར་བྱ་བ་དང་།",
    "རིག་པར་བྱ་བ་དང་རིག་པ་པོ་དང་།",
    "ནུས་པའི་དུས་ན་ནི་སྐྱེད་པ་པོར་འདོད་པའི་ངོ་བོ་བཞིན་དུ་དེ་དང་ཐ་མི་དད་པ་བསྐྱེད་པར་བྱ་བར་འདོད་པའི་ངོ་བོ་ཡང་ཡོངས་སུ་གྲུབ་སྟེ།",
    "དེ་ལྟ་བས་ན་གསལ་བར་བྱེད་པ་གཞན་ལ་མི་ལྟོས་པར་རང་གསལ་བའི་བདག་ཉིད་ནི་རྣམ་པར་ཤེས་པའི་རང་རིག་པ་ཞེས་བྱའོ།",
    "དེ་ཡིས་ཇི་ལྟར་ཤེས་པར་འགྱུར།",
    "ཅི་སྟེ་རྣམ་པར་ཤེས་པ་ནི་ཡུལ་སོ་སོར་རྣམ་པར་རིག་པའི་མཚན་ཉིད་ཡིན་པས་དེ་ནི་དོན་ཡོངས་སུ་དཔྱོད་པའི་ངོ་བོ་ཉིད་ཀྱང་ཡིན་ཏེ།",
    "ཤེས་དང་ཤེས་པར་བྱ་བའི་དོན།",
    "ཐ་དད་པར་ནི་འདོད་ཕྱིར་རོ།",
    "རྣམ་པར་ཤེས་པ་ཡང་དེའི་བདག་ཉིད་ཡིན་ན་ནི།",
    "ཤེས་པ་རིག་པས་དོན་རིག་པར་ཡང་འགྱུར་བ་ཞིག་ན།",
    "གང་རྣམ་པ་བཞིན་དུ་ཤེས་པ་ཡང་རིག་པ་མེད་པར་འདོད་པ་དེའི་ལྟར་ན་གཉི་ག་ལ་རིག་པ་མེད་དེ་དོན་དང་ཤེས་པ་ཞེས་བྱ་བར་འགྲུབ་པར་བསྙད་དུ་མེད་དོ།",
