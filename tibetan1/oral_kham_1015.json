    "ཞེས་ཞབས་འབྲིང་སྐུ་འཁོར་ཚོར་ཞལ་ཆེམས་འཇོག་གནང་མཛད་འདུག་གསུངས།",
    "སྐུ་བཅར་ནང་མ་ཚོར་མཚན་ཚོགས་འདི་འདྲ་ད་དུང་ཐེངས་གཉིས་ཙམ་འཚོག་དགོས་འདུག་གསུང་བཞིན།",
    "ཐང་ཆད་དེ་གཟུགས་པོ་བདེ་པོ་མི་འདུག་གསུངས།",
    "དབུས་གཞུང་ནས་ཝན་ཅ་པའོས་འགོ་ཁྲིད་པའི་མྱུར་སྐྱོབ་ཚོགས་ཆུང་གཞིས་རྩེར་གཏོང་རྒྱུའི་ཐག་གཅོད་གནང་འདུགཝན་ཅ་པའོ་གནམ་ཐང་དུ་འབྱོར་ཚར་འདུག་ཟེར།་",
    "ང་རང་ཁ་ས་ཕྱི་དྲོ་གཞིས་ཀ་རྩེ་ནས་པེ་ཅིང་དུ་འབྱོར་མ་ཐག་ཡིན་སྟབས།",
    "གནམ་ཐང་དུ་འབྱོར་སྐབས་གནམ་གྲུ་འཕུར་ལ་ཁད་དུ་འདུག་གསུངས།",
    "ཉིན་དགུང་ཆུ་ཚོད་༡ གོང་དཀར་གནམ་ཐང་དུ་ཕེབས་འབྱོར་ཟིན་འདུག་པས་སོ།",
    "བཞིན་མདངས་འགྱུར་བཞིན་ཐུགས་དམ་སྤྱན་དམིགས་ལ་བཞུགས་འདུག་གཞིས་ལུས་བོད་མི་ཚོས་སྐུ་ཐང་གསལ་ཞིང་བརྗིད་བག་ལྡན་པའི་མགོན་སྐྱབས་དམ་པ།",
    "ཞི་འགྲིག་ལས་རིམ་དེར་འབྲས་བུ་གང་ཡང་བྱུང་མི་འདུགདེར་བརྟེན།",
    "ཟླ་༡ ཚེས་༡ ཉིན་གྱི་ལྷ་སའི་དོན་རྐྱེན་རྟོག་ཞིབ་དང་ཐག་གཅོད་བྱེད་པར་མངགས་འདུག་༧པཎ་ཆེན་བཅུ་པ་ཆེན་པོ་མཆོག་ནི།",
    "དེའི་ཚབ་ཏུ་ཁ་བྲལ་རིང་ལུགས་པ་ཞེས་གསུང་འདུག་ཁ་བྲལ་རིང་ལུགས་པ་ནི་བོད་རང་བཙན་ནམ་རྒྱ་ནག་གཞུང་ཁ་བྲལ་འདོད་ཀྱི་བསམ་འདུན་དང་བྱ་སྤྱོད་སྤེལ་མཁན་ལ་གོ་དགོས།",
    "ཧུའུ་ཅིན་ཐའོ་ཡིན་པའི་དོགས་གཞི་བྱེད་ཀྱི་འདུག་ཏ་ཅང་ཡ་མཚན་དགོས་པ་ཞིག་ནི་༧པཎ་ཆེན་བཅུ་པ་སྟུན་གཞི་བཞེས་པར་བསྟོན་སྐབས།",
    "སྐད་ཆ་དེ་ལ་ཡང་དོ་སྣང་བྱ་དགོས་པ་ཞིག་འདུག་སྟེ།",
    "འདུག་ཀྱང་།",
    "གནམ་ཆུར་བརྟེན་ནས་ས་ཞིང་འདེབས་ལས་དགོས་པ་འི་དཀའ་ངལ་སེལ་ཆེད་ཀྱི་སློག་ཁང་ཞིག་ཡིན་འདུག་མི་རིགས་ལག་ཤེས་བཟོ་གྲྭ་གསར་འཛུག།",
    "དེར་བརྟེན་ཁྱེད་ལ་ཆབ་སྲིད་ཀྱི་རོགས་རམ་བྱ་རྒྱུ་དཀའ་ལས་ཁག་པོ་འདུག་འོན་ཀྱང་།",
    "དང་ལེན་བྱེད་མཁན་ཞིག་བྱུང་མི་འདུག་ལ།",
    "དངོས་དོན་དང་རན་པ་ཞིག་བཏོན་ཐུབ་མི་འདུག་སྙམ།",
    "མི་འཁེལ་བའི་ཐུགས་དོགས་བྱུང་འདུགདཔེར་ན།",
    "ཕྱི་ལོ་༡༩༨༢ ལོ་སྐུ་ཚབ་གསུམ་འགྲོ་དུས་རྩ་བ་ནས་ཤེས་རྟོགས་མི་འདུག་མཁྱེན་གྱི་ཡོད་དམ་ཞེས་བཀའ་དྲི་ཕེབས།",
    "འདི་ནི་ཧ་ཅང་ཡག་པོ་འདུག་པས།",
    "༧གོང་ས་མཆོག་གདན་ཞུའི་མགྲོན་ཤོག་ཅིག་ཕུལ་འདུག་གདན་ཞུའི་མགྲོན་བརྡ་དེ་ནི།",
    "ཁོང་རང་ངོ་མས་ཕྱག་བྲིས་དེ་རྒྱ་གར་དུ་བསྣམས་ནས།",
    "གནས་ཚུལ་དེའི་སྐོར་བོད་གཞུང་བཀའ་ཤག་ལ་དགོངས་སྐོར་ཞུས་འདུག་འོན་ཀྱང་།",
    "༧གོང་ས་མཆོག་༧པཎ་ཆེན་བཅུ་པའི་དགོངས་རྫོགས་མཆོད་འབུལ་ལ་ཕེབས་གནང་མི་ཡོང་བའི་ཐག་གཅོད་གནང་འདུག་གནས་ཚུལ་དེར་གཞིགས་སྐབས།",
    "ཕེབས་མི་དགོས་པ་ཐག་གཅོད་གནང་འདུག་༡་༤བྱེ་ཡོ་༡༩༩༣ཀྲུང་བོའི་བོད་ལྗོངས་དེབ་གསུམ་པ།",
    "ཁོང་མཚོ་སྔོན་དུ་ཕེབས་ཐུབ་པར་དགྱེས་ཚོར་དཔག་མེད་ཀྱིས་ང་རང་དགའ་སྤྲོ་ཤིན་ཏུ་སྐྱེས།",
    "ང་རང་མཚོ་སྔོན་ལ་བརྩེ་དུང་ཡོད་ཅེས་གསུངས།",
    "བོད་མི་དམངས་ཀྱི་བདེ་སྡུག་བཅས་དྲན་གྱི་འདུག་ཅེས།",
    "མི་དམངས་ཀྱི་འཚོ་བ་ཡག་པོ་ཡོད་ན་ང་ལྷག་པར་དུ་དགའ་པོ་འདུག་ངོས་ཀྱི་ལས་འགན་ཨང་དང་པོ་དེ།",
    "དེ་ན་རང་རང་ངོ་མས་རྒྱལ་སྲིད་སྤྱི་ཁྱབ་ཁང་ལ་སྙན་སེང་ཞུ་རྒྱུ་ཡིན་ལ།",
    "དེའི་སྐོར་མཚོ་སྔོན་གྱི་འབྲེལ་ཡོད་དཔོན་རིགས་ཚོར་འདྲི་རྩད་བྱེད་བཞིན་འདུག་ཅེས་བརྒྱུད་བསྒྲགས་བྱེད་སར།",
    "ཁྱེད་རང་འདི་གར་གཉིད་ཉལ་བ་ཡོང་བ་ཡིན་ནམ་ཞེས་བཀའ་བཀྱོན་ཕེབས།",
    "ཀྲུང་དབྱང་སྐུ་ཚབ་ཚོགས་པའི་འགོ་ཁྲིད་ལས་བྱེད་ཚོ་ག་བྱེད་འདི་བྱེད་མེད་པར་གྱུར་འདུག་འགྲོ།",
    "༧པཎ་ཆེན་གྱིས་ཁེངས་དྲེགས་བྱེད་ཀྱི་འདུག་ཅེས་སྙན་སེང་ཞུས་པ་མ་ཟད།",
    "ཟླ་༡༡ ཚེས་༤ ཉིན་རྒྱ་ནག་དབུས་གཞུང་ལ་ཐེར་འདོན་གྱི་ཚུལ་དུ་གསང་འཕྲིན་བསྐུར་འདུག་དབྱིང་ཧྥ་ཐང་གཙོས་པའི་བོད་སྡོད་རྒྱ་གཞུང་འགོ་ཁྲིད་ཚོས།",
    "ག་དུས་ཡིན་ནའང་ཁོ་པས་ང་ལ་སྐྱོན་འཛུགས་བྱས་བྱུང་།",
    "གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པའི་མཛད་འཕྲིན་ཞིག་ཏུ་ངོས་འཛིན་ཞུ་བཞིན་འདུགའོ་ན།",
    "གྲགས་ཅན་གྱི་རྒྱ་རིགས་རྩོམ་པ་པོ་ཝང་ལི་ཞུང་གཉིས་ལ་གསལ་ཆ་ཆེན་པོ་འདུག་ཅིང་།",
    "ང་རང་ལ་ནུས་པ་གང་ཡོད་པ་རྣམས་བཏོན་ནས།",
    "ཕྱི་ལོ་༡༩༥ ནས་རྒྱ་ནག་དམར་པོས་བོད་བརྒྱུད་ནང་བསྟན་རྨང་ནས་བཤིག་དུས།",
    "བོད་རིགས་ལའང་རང་ཉིད་ཀྱི་དད་པ་ཡོད།",
    "༧པཎ་ཆེན་བཅུ་པའི་དགོངས་པ་མཐུན་འགྱུར་དང་རྒྱབ་སྐྱོར་རྩ་བ་ནས་ཐོབ་མི་འདུགཕྱི་ལོ་༡༩༨ ལོར།",
    "ཡང་དར་བསྟན་པའི་ཁུར་འདི་ངེད་ལ་བབ་འདུག་དགོངས་ཏེ།",
    "བོད་མི་རིགས་རང་ཉིད་ཀྱི་རྐང་པའི་སྟེང་རང་རྐྱ་འཕེར་བ་ལངས་ཏེ་མདུན་སྐྱོད་ཀྱི་ལམ་དུ་ཆས་དགོས་ན།",
    "ང་རང་ནང་སོག་དང་།",
    "ད་ཆ་སུ་རྒྱལ་འཚོང་པ་ཆགས་འདུག་གསུངས།",
    "ནུས་ཤུགས་ཡོད་དགུ་བཏོན་ཏེ་གོ་བསྐོན་བློ་འགུག་བྱས་འདུགའོན་ཀྱང་།",
    "ཞལ་མ་མཇལ་བར་ལོ་སུམ་ཅུ་ཙམ་ཕྱིན་སྟབས་སེམས་ལ་དྲན་བཞིན་བློ་ཕམ་འདུགཐམས་ཅད་མཁྱེན་པ་སྐུ་ཚེ་ཞབས་པད་བརྟན་པ་དང་།",
    "བྱས་ཀྱང་མི་ཁ་མི་འདུག།",
    "སྒྱུར་གནང་འདུག་འོན་ཀྱང་།",
    "ད་དུང་ངོས་ཀྱི་ཁང་པ་སོགས་གངས་རྒྱན་གྱི་ལས་བྱེད་ཚོས་ཟིན་བསྡད་འདུག་ངོས་ཀྱིས་གཡར་བ་ཡིན།",
    "༧པཎ་ཆེན་བཅུ་པ་ཆེན་པོ་སྐུ་ཉིད་ཀྱི་ངོས་ནས་ཁོང་རང་ལ་འཚོང་པ་རྒྱགས་པའི་བསྐུར་འདེ་བས་ཞུས་མིན་ལ་མ་བལྟོས་པར།",
    "དགག་ཆ་ཇི་སྙེད་ཅིག་བྱས་འདུག་དཔེར་ན།",
    "མི་མང་པོས་བསམ་ཤེས་ཐུབ་ཀྱི་མི་འདུག་ཅེས།",
    "རང་ཡུལ་ཁ་བ་གངས་ལྗོངས་ཀྱི་གདན་ས་བཀྲ་ཤིས་ལྷུན་པོར་ཆིབས་ཁ་བསྒྱུར་བའི་༧པཎ་ཆེན་སེར་ཏེ་ནི་ཇིག་འདུགའདུན་པ་འགོག་མེད་དུ་འཁྲུངས་ཏེ།",
    "གཞུང་བླའི་འགལ་ཟླ་དང་༧པཎ་ཆེན་བཅུ་པའི་གནས་བབ་ལ་གནོད་སྐྱོན་ཤུགས་ཆེན་ཐེབས་འདུག་རྣམ་རྟོག་དགྲ་རུ་ལངས་ན།",
    "ཞེས་འཁོད་པའི་ཕྱག་སམ་མང་དག་ཅིག་མཇལ་རྒྱུ་འདུག་པར་བསམ་ཚེ།",
    "པོ་ཆེས་རྣམ་ཀུན་ལྟར་ཤོག་བུའི་ཐོག་མིན་པར་ཕྱག་སམ་ཞིག་བསྐུར་བ་གནང་འདུགཕྱག་སམ་དེའི་ནང་གནས་ཚུལ་རྩ་བ་ནས་ཡག་པོ་མི་འདུག་ད་ཆ་གཞུང་བླ་གཉིས་རྡོག་རྩ་ཆིག་སྒྲིལ་གྱི་ཐོག་ནས་ཤུགས་རྒྱག་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་འདུག་པས།",
    "ད་ལྟ་གང་དུ་ཡོད་མེད་ད་དུང་གསལ་པོ་ཤེས་ཀྱི་མི་འདུག་ཕལ་ཆེར་ལྷོ་ཁའི་ཕྱོགས་སུ་ཕེབས་ཡོད་པ་འདྲ་ཞེས་པ་ལས།",
    "སྐབས་དེར་༧པཎ་ཆེན་རིན་པོ་ཅེ་བོད་ལ་བཞུགས་ཡོད་པས་ལག་པ་འཆང་ཐུབ་མི་འདུག་ཕྱི་ལོ་༡༩༥༩ ལོར།",
    "ཚོགས་ཀྱང་མང་པོ་ཚོས་ཐུབ་ཀྱི་མི་འདུག་དེ་ལྟར་བྱས་ན་རྩ་བ་ནས་འགྲིགས་ཀྱི་མི་འདུག་པས།",
    "ཆིག་ཁྲི་ལྔ་སྟོང་རང་ཁ་རང་གསོ་གནང་རྒྱུ་བྱས།",
    "ཁྱེད་རང་ནི་བློ་མཐུན་རྒན་གྲས་ཤིག་ཡིན་པས།",
    "དགོངས་འཆར་གནང་དགོས་པ་ཡོངས་རྫོགས་ཁྱེད་རང་ནས་ཧ་ལམ་དབུ་ཁྲིད་ཚང་མར་དངོས་སུ་ཞུས་ཡོད།",
    "ཁྱེད་རང་ནས་ཀྱང་མཁྱེན་གསལ་ལྟར་ཀྲུང་དབྱང་ལ་གནས་ཚུལ་སྙན་སེང་ཞུ་བ་ནི་བསམ་བློ་གཟབ་ནན་བཏང་ཡོད་པས།་",
    "མགོ་འདོགས་རིང་ལུགས་བྱེད་ཀྱི་འདུག་ཅེས།",
    "ཁོང་ཉིད་ཀྱི་གནས་བབ་ལ་ཁོང་རང་ཉིད་ཀྱི་ཚོད་བགམ།་",
    "དུས་བསྒུགས་འོས་ཚུལ་ཕེབས་འདུག་པར་བརྟེན།",
    "དགྲ་དང་རང་ཕྱོགས་ཀྱི་དབྱེ་མཚམས་བཅད་ནས་གཏིང་ཟབ་ཀྱིས་དགག་པ་བརྒྱབ་སྟེ།",
    "སྟོན་པ་ཤཱཀྱ་ཐུབ་པ་ཡིད་ལ་དྲན་ནས་འདུག་པ་ལས།",
    "གཞན་གང་ཡང་དྲན་གྱི་མི་འདུག་གསུངས།",
    "དེ་བས་ཀྱང་རང་ཉིད་ཀྱི་བྱེད་སྟངས་ནི་ཡང་དག་པ་ཞིག་ཡིན་པར་དགོངས་བཞིན་ཡོད་སྟབས།",
    "པེ་ཅིང་དུ་བཙན་ཁྲིད་བྱས་པ་གང་ཡིན་ཤེས་ཀྱི་མེད་པའི་བསྒྲགས་གཏམ་སྤེལ་འདུག་ཕྱི་ལོ་༡༩༦༥ ཟླ་༧ ཚེས་༣ ཉིན།",
    "༧པཎ་ཆེན་ཞེར་ཏེ་ནི་ཞིའ་འདུགཕྱི་ལོ་༡༩༦༧ ཟླ་༣ ཚེས་༡༦ ཉིན།",
    "གསུང་སྐད་ཐེངས་གཅིག་ཀྱང་སྐྱོན་གྱི་མི་འདུག་གསུངས།",
    "དཔུང་པ་དང་ཕྱག་ངར་གྱི་སྟེང་དུ་ད་དུང་ཡང་ཐག་པས་བསྡམས་པའི་ཤུལ་ཡོད་པ་བཀའ་ཟུར་ཨ་ལགས་ཙ་ཡུས་དངོས་སུ་མཐོང་འདུག་ཕྱི་ལོ་༡༩༦༧ ལོར།",
    "ཕྱི་མི་ནང་དུ་མི་འགྲོ་བའི་ཆེད་ཁང་པའི་སྒོ་ཐག་པས་འཕྲེད་བཀག་བཏང་འདུག་ཧ་ཅང་ཡ་མཚན་དགོས་པ་ཞིག་ལ་ཡོངས་གྲགས་ཀྱི་འགྲེམ་སྟོན་བདུན་ཕྲག་གཅིག་བྱས་པའི་རིང་།",
    "གསང་དུ་འགྲོ་ཆོག་པའི་སྙན་སེང་ཐེངས་གསུམ་ཞུས་ཀྱང་ཁ་ཡ་མ་བྱས་མི་འདུགམཐར་འུ་ཐུག་བཟོད་བྲལ་དུ་གྱུར་བས་གསུང་སྐད་ཆེན་པོས།",
    "ཟོས་བྱོལ་དུ་ཕེབས་ན་རྒྱལ་ཁབ་གང་དུ་ཕེབས་མིན་ལ་ཤོད་ཚུལ་འདྲ་མིན་ཞིག་བྱུང་འདུགཕྱི་ལོ་༡༩༦༩ ཟླ་༡ ཚེས་༡ ཉིན།",
    "དོ་སྣང་ཆེན་པོའི་དགོངས་ཚུལ་གསུང་འདུགཕྱི་ལོ་༡༩༦༩ ཟླ་༩ ཚེས་༡༦ ཉིན།",
    "འགྲེལ་བརྗོད་གནང་འདུགཕྱི་ལོ་༡༩༦༩ ཟླ་༩ ཚེས་༡༢ ཉིན།",
    "ངལ་རྩོལ་སྒྱུར་བཀོད་ཁང་གསང་ནས་བྲོས་ཀྱིས་རྒྱ་གར་དུ་སྐྱབས་བཅོལ་ལ་ཕེབས་ཚུལ་བཀོད་ཅིང་འདུགདེར་བརྟེན།",
    "ད་ལྟ་པེ་ཅིང་༧པཎ་ཆེན་གཟིམ་ཤག་ཏུ་མཇལ་རྒྱུ་འདུག་ལ།",
    "ཁྱེད་ཚོའི་ལངས་ཕྱོགས་མཚོན་པར་གནང་ན་གང་འདྲ་འདུག་པ་དྲིས།",
    "༧པཎ་ཆེན་ནང་མ་ཁང་ལ་གྲོས་འཆར་ཞིག་ཕུལ་འདུག་པའི་ནང་།",
    "པ་དགུང་ལོ་གཞོན་གཞོན་ཞིག་འདུག་རང་བཞིན་ལྷན་སྐྱེས་ཀྱི་བབ་དེ་རང་ལ་བཞག་ན་དངོས་གནས་ཡག་པོ་ཡོང་བ་འདུག་སྙམ་པའི་མཐོང་ཚུལ་གསལ་པོ་བྱུང་ཞེས་གསུངས།",
    "ཡིད་བརྟན་འཕེར་བ་ཞིག་འདུག་ང་ལས་ལོ་གསུམ་གྱིས་སྐུ་ན་གཞོན་པ་དང་།་",
    "༧རྒྱལ་བ་༧པཎ་ཆེན་རྣམ་གཉིས་ནི་དེ་བས་ཀྱང་བརྗོད་མེ་དགོས་པ་ཞིག་ལོས་ཡིན།",
    "དེ་རིང་ཆེད་དུ་ཁྱེད་རང་ཕེབས་སྒྱེ་ལ་ཞུ་བར་ཡོང་བ་ཡིན།",
    "པའི་ལྟ་སྟངས་ཇི་སྙེད་ཅིག་གནང་འདུག་དཔེར་ན།",
    "སྐབས་དེའི་གནས་ཚུལ་ཤེས་ཐུབ་ཀྱི་འདུག་ལ།",
    "དཔེ་མི་སྲིད་པའི་གྱོང་ཆེན་པོ་རག་བྱུང་།",
    "༧རྒྱལ་བ་ཡབ་སྲས་མགྲོན་གྱི་གཙོ་བོར་གདན་འདྲེན་ཞུས་འདུགཕྱི་ལོ་༡༩༥༦ ཟླ་༡༡ ཚེས་༢ ཉིན།",
    "ཛད་དཀའ་ཇི་སྙེད་ཅིག་བཟོས་འདུགདཔེར་ན།",
    "འི་རྒྱལ་དར་བཙུགས་འདུག་འོན་ཀྱང་།",
    "བཅོལ་ནན་དུ་ཞུས་འདུག་༧གོང་ས་མཆོག་རྒྱ་གར་དུ་ཆིབས་སྒྱུར་ཟིན་རྗེས།",
    "རྒྱ་ནག་གཞུང་མི་དགའ་བ་ཡང་ཤུགས་ཆེན་བྱུང་འདུག་འོན་ཀྱང་།",
    "ངེད་ཅག་ཀྲུང་གོའི་རྒྱལ་ཡོངས་ཀྱི་ས་གནས་ཡོངས་ཀྱི་ཞེས་པའི་ཐ་སྙད་དག་བེད་སྤྱོད་གནང་འདུག་༧རྒྱལ་བ་ཡབ་སྲས་རྒྱ་གར་དུ་ལྷན་རྒྱས་ཆིབས་སྒྱུར་གནང་བ་དེ་ལྷན་ཕེབས་ཀྱི་མཐའ་མ་ཙམ་མ་ཟད།",
    "ཆུབཀྲས་བླའི་ཞབས་འབྲིང་མང་པོ་ཞིག་མི་འདོད་པ་ཆེན་པོ་བྱུང་འདུགཕྱི་ལོ་༡༩༥༧ ཟླ་༡ ནང་ལྕག་ར་ཏ་དམག་སྒར་དུ་ཞབས་སོར་འཁོད་སྐབས།",
    "༧རྒྱལ་བ་༧པཎ་ཆེན་འདྲ་མཉམ་གྱི་ལྟ་ཕྱོགས་བཟུང་བའི་ཚོར་སྣང་བྱུང་འདུག་ལ།",
    "སྔོན་ལ་བཀྲས་ལྷུན་བླ་བྲང་རང་ལ་ཞབས་སོར་འཁོད་གནང་ཡོང་བའི་གདན་ཞུར།",
    "ཕྱི་ལོ་༡༩༨༩ལོར་༧པཎ་ཆེན་ཞེར་ཏེ་ནི་ཞི་འདུག་ནང་མ་སྟབས་དེར་ཞུ་གསོལ།",
    "མང་ཆེ་བས་ཕེབས་བསུ་སེ་ར་སྦྲེང་ཞུ་བར་བཅར་འདུག་ལ།",
    "༧གོང་ས་མཆོག་གསོལ་ཚིགས་རྒྱས་པའི་སྟེང་གདན་ཞུ་གནང་བ་དེར་ཕེབས་མི་འདུགགནས་ཚུལ་དེའི་སྐོར་ལ་གྲ་མ་ཟླ་བ་ཚེ་རིང་དང་།",
    "ཕྱོགཝགོང་སམཆོག་བླ་བྲང་ནས་གསོལ་ཚིགས་ལ་གདན་ཞུ་གནང་བའི་ཚེས་གྲངས་གསལ་ཁ་མི་འདུག་ཀྱང་།",
    "རང་རང་དགའ་མར་བཅས་པའི་གདན་གསུམ་ལྷ།",
    "ལོ་ཟླ་བཞག་དུས་གནས་པ་དང་།",
    "དེ་ནས་སློབ་དཔོན་གྱིས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་སྟེ།",
    "གནས་ཁང་གང་ཡང་རུང་བར་སྟན་བདེ་བ་ལ་འདུག་ལ།",
    "མི་མགོའི་ར་བཟླུམ་པོ་ཡངས་ཤིང་རྒྱ་། ཆེ་བ་འདི་དཔེ་ཕལ་ཆེར་ན་མི་འདུག་ཀྱང་དོན་ལ་དགོས།",
    "འདིའི་ཁུངས་མཁན་ཆེན་ནམ་ལྷུན་པའི་འགྲེལ་པར་འདུག་ཀྱང་།",
    "དངོས་ཡུམ་དང་རང་འོད་ཀྱི་ཡུམ་གྱི་ཁྱད་པར་ནི།",
    "བསྐྱེད་དམ་རང་རང་གདན་གྱི་སྟེང་དུ་བསྐྱེད།",
    "དགྲ་བོའི་སྲོག་འཕྲོག་དུས་མཚན་གསོད་བྱེད་དང་།",
    "མི་ཟློག་དུས་ཀྱི་ཕོ་ཉ་མཐུ་བོ་ཆེ།",
    "མི་མགོའི་ར་བ་ཟླུམ་པོ་ཡངས་ཤིང་རྒྱ་ཆེ་བ་འདི་དཔེ་ཕལ་ཆེར་ན་མི་འདུག་ཀྱང་དོན་ལ་དགོས།",
    "འདིའི་ཁུངས་མཁན་ཆེན་ནམ་ལྷུན་པའི་འགྲེལ་པར་འདུག་ཀྱང་།",
    "དངོས་ཡུམ་དང་རང་འོད་ཀྱི་ཡུམ་གྱི་ཁྱད་པར་ནི།",
    "བསྐྱེད་དམ་རང་རང་གདན་གྱི་སྟེང་དུ་བསྐྱེད།",
    "འཇིགས་བྱེད་ཀྱི་རས་བྲིས་ཀྱི་དཀྱིལ་འཁོར་རྙིང་པ་ཕལ་ཆེར་ལ་འདུག་པས་ཀྱང་།",
    "ཡོངས་རྫོགས་རང་རང་གསོལ་གདབ་ཡིན་པའམ།",
    "༢༩བཤགས་སྔགས་དང་ལས་གཤིན་བསྐང་གསོ་སྦྱར་སྲོལ་འདུག་པ་ནི།",
    "དགྲ་བོའི་སྲོག་འཕྲོག་དུས་མཚན་གསོད་བྱེད་དང་།",
    "མི་ཟློག་དུས་ཀྱི་ཕོ་ཉ་མཐུ་བོ་ཆེ།",
    "ཡབ་བཅོམ་ལྡན་འདས་དཔལ་ཧེ་རུ་ཀ་དང་རང་བཞིན་ཐ་མི་དད་ཅིང་རྟག་ཏུ་མི་འབྲལ་བས་ཐབས་ཤེས་ཟུང་འཇུག་ཏུ་སྦྱོར་བ་བརྡས་མཚོན་བའི་ཕྱིར།",
    "བོ་རོ་ཙ་ན་ནས་ལོ་ཆེན་རིན་ཆེན་བཟང་པོའི་སྐབས།",
    "ཉལ་འདུག་མི་ཤེས་ལུས་རྡུལ་མཆིན་རྩ་འབུལ་བུལ།",
    "ཤིང་སྤོ་ལོ་རྒུན་འབྲུམ་ཤིང་མངར་ཨ་ཀྲོང་བསྣན་ཟེར་བའང་འདུག་མངར་མཚལ་དང་རུ་རྟ་སྲོ་ལོ་བསྣན།",
    "ཤུ་དག་བསེ་རུ་ཉ་ཕྱིས་སྲད་དཀར་ཀྱི་རྩེ་ལྔའི་མལ་དུ་བྲག་ཨ་རུ་བཅུ་སྟེང་སླེ་ཏྲེས་ཞུན་བ་ཤ་ཀ་གུ་གུལ་ཤུ་དག་སྤང་སྤོས་ལྔ་བསྣན་པའི་ལུགས་ཡང་འདུག་བོང་ཁྲག་བསྣན།",
    "རང་རང་སྐབས་ཐོབ་བརྩིས་པ་རིགས་པས་དཔྱད།",
    "སྒ་སྐྱ་བསྣན་ན་ཉེར་བདུན་འདུག།",
    "གན་རྐྱལ་འདུག་ལ་རོ་སྟོད་སྨད།",
    "འདོད་ལུགས་མང་པོ་འདུག་པ་ལ།",
    "མཁས་ཁྱད་ཞག་དུས་སྦྱང་བའི་ལག་ལེན་འདི།",
    "དངུལ་ཆུ་སྲང་གང་རང་བྱུང་མཚལ།",
    "ལོང་ཟིལ་པ་ཕྲུམ་མེ་འདུག་ན་དུག་མེད་གསུངས།",
    "ཚ་གྲང་རང་རང་གཙོར་སྨོས་སྐབས་རྩིས་པའི།",
    "རྨ་ལ་ཁཎྜ་ཁོ་རང་བྱུགས།",
