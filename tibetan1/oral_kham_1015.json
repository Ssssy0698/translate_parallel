    "མ་འདྲིས་པར་ཕྲོམ་ཕྲོམ་འདུག་ན་འཆི།",
    "ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན།",
    "ཕན་སྟོབས་ཆེ་བར་འདུག་གཞན་སྐྱུ་རུ་ཉེར་ལྔ།",
    "སྣ་ཆམ་ལ་ཡོས་ཀྱི་རླངས་པ་དང་ཤོག་གུའི་དུད་པ་བདུག་པས་ཕན་སྲོལ་འདུག།",
    "རང་རང་དུས་སུ་མ་ནོར་བཏང་བར་བྱ།",
    "ཨཱ་དྱ་ནུཏྤནྟ་ཏྭཱ་ཏ་སརྦ་དྷརྨཱ་ཎཱཾ་པྲ་ཀྲྀ་ཏི་པ་རི་ཤུདྡྷ་པྲ་བྷ་ཝ་སརྦ་དྷརྨ་ཞེས་བརྗོད་པས་སེམས་དེའང་རང་བཞིན་མེད་པ་སྒྱུ་མ་ལྟ་བུར་བསམས་པ་ནི་ཡེ་ཤེས་ཀྱི་ཚོགས་ཏེ་ཚོགས་གཉིས་བསགས་པའོ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱ་ཡ་སྭཱ་ཧཱ།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནེ་སྭཱ་ཧཱ།",
    "རྡོ་རྗེ་དྲིལ་བུ་ཐོགས་ནས་གར་གྱི་བཀོད་པ་དང་བཅས་པས་རྡོ་རྗེའི་སྟབས་ཀྱིས་ཁྲིའུ་ལ་སོགས་པའི་སྟེགས་ལ་འདུག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་བེ་རོ་ཙ་ནཱ།",
    "ལོ་ཙ་ནཱ་ཡེ།",
    "སློབ་དཔོན་གྱིས་གནས་དབེན་པར་འདུག་སྟེ་བསྙེན་པ་བྱའོ།",
    "སློབ་དཔོན་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་སྟན་ནང་ཚང་ཅན་ལ་འདུག་ལ།",
    "དེ་ནས་རྡོ་རྗེའི་འགྲོས་ཀྱིས་དཀྱིལ་འཁོར་གྱི་ས་བསྐོར་ནས་ཤར་དུ་མཐུན་པའི་རྐང་སྟབས་ཀྱིས་འདུག་ལ།",
    "འདུག་སྟངས་དང་།",
    "རང་རང་དཀྱིལ་འཁོར་གསུམ་པོ་ཡི།",
