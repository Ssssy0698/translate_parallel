    "རང་ཡུལ་དུ་ལྡོག་དུས་ཤིང་ཆེན་པོ་མི་ཐེག་སྙམ།",
    "བསྒོམ་ཙ་ན་སྐྱེ་བའི་རྒྱ་མཚོ་མཐར་དབྱུང་།",
    "ཡང་དབེན་པར་འདུག་དུས།",
    "ཡང་དབེན་པར་འདུག་དུས།",
    "ཚེ་གང་པོ་རི་ལ་བསྡད་ཀྱང་རང་སྡིག་ཡིན་སྒྲུབ་བརྒྱུད་བསྟན་པའི་བླ་བཙོང་རྐང་འདྲེན་རི་ལ་གནས་པའི་བྱི་བ་གཅན་གཟན་ཝ་ཁྱི་དང་ཁྱད་པར་མེད་དེ།",
    "ཕྱིས་དབེན་པར་འདུག་པའི་ཞོར་ལ་གཞན་དོན་ཡང་བྱས་ཆོག་སྟེ།",
    "སྙིགས་མའི་དུསའདིར་དམུ་རྒོད་གདུལ་དཀའི་རང་རང་འགྲོ་རྣམས་འདྲེན་སླད་དུ།",
    "བོད་ཡུལ་མི་ཡི་གྲངས་ཙམ་འདུག་པས།",
    "གཉེན་གྲོགས་འཁོར་གྱིས་ཅི་བདེར་སྤྱོད་ཅིང་རང་ཉིད་ལག་པ་སྟོང་པ་རུ།",
    "ལྕགས་ཁང་ནང་ནས་མེ་འབར་བསྲེག་ནས་འགྲོ་ས་མི་འདུག་སྙམ་དུ་ངུ།",
    "འཁོར་གཡོག་ལ་སོགས་གང་ཡང་རང་ལ་བྱུང་ན་སྙམ་པའི་བརྣབ་སེམས་ནི།",
    "ནོར་དང་བརྗེད་པས་བྱས་དང་མི་འདོད་བཞིན་དུ་བྱས་དང་རང་བཞིན་གྱིས།",
    "ཡུན་རིང་ཤུགས་དྲག་བཟོད་གླགས་མེད་པའི་སྡུག་བསྔལ་སྣ་ཚོགས་མྱོང་དགོས་འདུག།",
    "འགྲོ་འདུག་ཉལ་བ་བཟའ་བཏུང་ཉི་མ་གྲིབ་མ་ཧ་ཅང་བསྟེན་དྲགས་ན།",
    "འགྲོ་དྲུག་སྡུག་བསྔལ་གསུམ་གྱིས་མནར་བ་བརྟགས་ན་སྡུག་བསྔལ་ཕུང་པོར་འདུག།",
    "དེས་ན་ཡིད་བརྟན་མི་རུང་གཉེན་བཤེས་རྣམས་ལ་ཆགས་པ་དོན་མི་འདུག།",
    "བློ་བདེར་སྡོད་པ་ཤིན་ཏུ་འཁྲུལ་འདུག་ད་ནི་བསླབ་གསུམ་ཅང་ཤེས་ཀྱི།",
    "འགྲོ་འདུག་འགུལ་བསྐྱོད་ཤུགས་དྲག་བྱས་ན་གནོད་ཀྱིས་དོགས་ནས་དལ་བར་བྱས།",
    "ཆང་འཐུང་བཞིན་དུ་འགྲོ་འདུག་བྱེད་དུས་ཡུལ་ནས་འདུག་དུས་མིག་བཞིན་འཚོ།",
    "ཟག་མེད་བདེ་བ་ཡོད་པ་ཕར་ཞོག་ཟག་བཅས་བདེ་བ་ཙམ་མི་འདུག།",
    "རྒུད་པ་ཀུན་གྱི་གནས་སུ་འདུག་པས་རང་ཉིད་གཅེས་འཛིན་མ་སྐྱེས་པ།",
    "འདུག་པས་གཞན་རྣམས་གཅེས་འཛིན་མ་སྐྱེས་གསར་དུ་བསྐྱེད་དང་སྐྱེས་ཟིན་པ།",
    "སྙམ་དུ་ཚིག་བཞི་ངག་ཏུ་བརྗོད་ཅིང་རང་ལ་སྤྲོ་བ་བསྐྱེད་པར་བྱ།",
    "ཡོན་ཏན་ཅན་དང་ཚུལ་འཆལ་ལ་སོགས་སྐྱོན་ཅན་རྣམས་དང་རང་ཉིད་ལས།",
    "དམའ་བ་རྣམས་དང་རང་དང་མཉམ་པ་རྣམས་དང་རང་ལས་ལྷག་པ་དང་།",
    "མེས་ཚིག་པ་དང་སྡུག་བསྔལ་སེལ་བའི་མཐུ་མེད་པ་དང་རང་བཞིན་གྱིས།",
    "མ་རྒྱས་བར་དུ་གཞན་གྱིས་སློང་ཡང་རང་ལུས་གཏོང་བར་མི་བྱའོ།",
    "སྲོག་གཅོད་ལ་སོགས་གཞན་དང་རང་ལ་གནོད་པའི་ཉེས་སྤྱོད་བྱེད་ཕྱིར་དུ།",
    "སྟོན་པས་མ་བཀག་དུས་དང་སློང་ལ་མི་འོས་སྦྱིན་པ་མ་ཡིན་ཞིང་།",
    "བཟའ་བཏུང་སློང་ལ་སྦྱིན་དགོས་པ་དང་རང་ངམ་གཞན་ལ་ཕན་ཕྱིར་དུ།",
    "གཉིས་ཀའི་འདོད་པ་བསྐང་བར་བྱ་ལ་མི་ནུས་འདུག་ན་བཀྲེན་པ་པོས།",
    "གཞན་ཡང་རང་ལ་དབྱུག་པ་སོགས་ཀྱིས་རྡུང་ཚེ་དངོས་སུ་གནོད་བྱེད་ལ།",
    "ཚོགས་བསགས་གྱིས་ཞེས་བསྐུལ་མ་བྱས་འདུག་སྙམ་དུ་ཚོགས་བསགས་ཅི་ཐུབ་བྱ།",
    "འདུག་ས་བཅས་ཏེ་མི་འདོད་སྡུག་བསྔལ་སྣ་དགུ་ཐོག་ཏུ་འདྲེན་མཁན་གྱི།",
    "མ་ཡིན་སྔར་ནས་ང་ཞིག་གྲུབ་ནས་ཡོད་འདུག་སྙམ་པ་ཤར་བའི་ཚེ།",
    "གཏན་ནས་མི་འདུག་སྙམ་དུ་སྟོང་བ་ཉིད་ལ་རྩེ་གཅིག་མཉམ་པར་འཇོག།",
    "དེའི་ཚེ་ང་ཞེས་མིང་ཙམ་མ་གཏོགས་རང་བཞིན་མི་འདུག་སྟོང་པ་ཉིད།",
    "གཏན་ནས་མི་འདུག་སྟོང་པ་ཉིད་དོ་སྙམ་དུ་རྩེ་གཅིག་མཉམ་པར་འཇོག།",
    "བསལ་ཚེ་དེ་རིང་ཤེས་པ་འདི་ཞེས་སྟོན་རྒྱུ་དགོས་ལ་ཅང་མི་འདུག།",
    "རྡུལ་ཙམ་མི་འདུག་སྟོང་བ་ཉིད་དོ་སྙམ་དུ་རྩེ་གཅིག་མཉམ་པར་འཇོག།",
    "འདི་ཞེས་སྟོན་རྒྱུ་ཞིག་ཡོད་དགོས་ལ་དེ་འདྲ་སྟོན་རྒྱུ་ཅང་མི་འདུག།",
    "གཏན་ནས་མི་འདུག་སྟོང་པ་ཉིད་དོ་སྙམ་དུ་རྩེ་གཅིག་མཉམ་པར་འཇོག།",
    "ནམ་མཁའ་འདི་ཞེས་སྟོན་རྒྱུ་ཡོད་དགོས་དེ་འདྲ་སྟོན་རྒྱུ་ཅང་མི་འདུག།",
    "གཏན་ནས་མི་འདུག་སྟོང་པ་ཉིད་དོ་སྙམ་དུ་རྩེ་ཙམ་ཡང་།",
    "རང་བཞིན་གྲུབ་པ་རྡུལ་ཕྲན་ཙམ་ཡང་གཏན་ནས་མི་འདུག་སྟོང་པའོ།",
    "དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "གསང་སྔགས་རྙིང་མ་བ་འདི་ལ་སྔ་རབས་ཀྱི་མཁས་པ་རྣམས་ཀྱིས་ཀྱང་དགག་པ་འདུག་ཅིང་།",
    "ད་ལྟ་ཡང་སྐུར་པ་འདེབས་པ་མང་དུ་འདུག་པ།",
    "བསམ་ཡས་ན་ཡང་ད་དུང་སྔ་འགྱུར་གྱི་རྒྱ་དཔེ་མང་དུ་ཡོད་པར་འདུག་ཅིང་།",
    "མཁས་པས་བལྟས་ན་གཅིག་ཏུ་འདུག།",
    "བརྒྱ་ལ་ལག་ལེན་ལ་བཏབ་ཀྱང་ཕུང་དེང་སང་བྱ་བོས་ཀྱང་གཅོག་དཀའ་བར་འདུག་གསུངས།",
    "སོག་རགས་སུ་རྐེ་རྫིང་ངེ་བས་བརྒྱབ་ནས་བགད་ཆ་མང་པོ་ཤོར་བ་དེ་འདྲ་ཡོང་གསུངས་པ་དེ་ཐུགས་བདེན་པར་གདའ།",
    "དཔེར་ན་དཔའ་བོ་དགྲ་དང་འཐབ་དུས་རང་ལ་ཇི་ཙམ་འཛེམས་ཀྱང་མ་ཁོག་ཕ་རོལ་དགྲ་ཕམ་རང་ཡང་ནམཚོན་བབས་ནས་ཤི་ཙ་ན།",
    "དེ་མ་བསད་ན་ཨང་ཞེས་ཡིད་སྨོན་བྱེད་ཅིང་རང་ཡང་མི་འགྱོད་པ་ལྟར།",
    "ད་དུང་མ་ཤི་ན་ཨང་ཟེར་ཡིད་སྨོན་བྱེད་ཅིང་རང་ཡང་མི་འགྱོད་པ་ཞིག་འོང་།",
    "ལྷ་ལ་བརྙས་པ་བྱས་པ་མ་ཚོར་གདའ།",
    "རང་རང་མཆོད་རྫས་དགྱེས་པ་བསྐྱེད་བྱེད་པའི།",
    "དེ་ཡིན་ན་སྤྲང་བོ་དང་གླ་བ་སོགས་རི་དྭགས་ཐམས་ཅད་ཀྱིས་ཚེ་བློས་བཏང་ནས་རྒྱལ་བ་སྲས་བཅས་ཀྱི་གསུང་བརྩིས་འདུག་སྟེ།",
    "བོད་འདི་ཡི་དྭགས་ཀྱི་ཡུལ་ལྟ་བུར་ལོངས་སྤྱོད་ཆུང་བར་འདུགབསོད་སྙོམས་བྱས་ན་ལྟོ་མི་ཡོང་བར་མ་ཟད་དགེ་སྦྱོར་གྱི་བར་ཆད་དུ་འགྲོ་བར་གདའ།",
    "གསུང་ཐམས་ཅད་ལྟར་བྱེད་དགོས་ཟེར་ན་མགོ་རྐང་ལག་སོགས་ལུས་ཀྱི་སྦྱིན་པ་ཡང་ཐོངས་གསུངས་འདུག་པས།",
    "གཞན་ལུས་ལམ་དུ་སློང་ཙ་ན།",
    "སྐྲ་དཀར་མེད་ཅིང་རང་ལུས་ཟླ་ལྟར་རྒྱས།"
  ]
