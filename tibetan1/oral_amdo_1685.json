    "ཁོ་ཚོ་རེ་རེ་བཞིན་ཚ་ཐབ་ཐོག་ཏུ་བུད་རྗེས།",
    "ཁྱོད་ཀྱིས་ཡར་ཞུ་བྱས་ཆོག་ཟེར།",
    "ཁྱོད་ཚོས་ཆོག་མཆན་ཐོབ་པའི་རེ་བ་བྱེད་ཀྱིན་ཡོད།",
    "ཁོ་གཉིས་གནའ་གྲོང་གི་ཁོངས་མི་ངོ་མ་ཡིན་པར་མ་ཟད།་",
    "ཟུང་ཟླ་བས་འབྲི་དེབ་དེ་སྐྱ་ལྡང་གི་ལག་ཏུ་བཞག་ཅིང་ཁོ་ཚོའི་རྣམ་འགྱུར་ལ་བརྟགས་ནས་བསྡད།",
    "སྐྱ་ལྡང་གིས་འབྲི་དེབ་ལ་ལྟ་ཙམ་བྱས་ཤིང་ཟུང་ཟླ་བར་ལྟ་བཞིན་ཅུང་ཟད་ཧོན་ཐོར་བ་ལྟར་གནས།",
    "སྐྱ་ལྡང་གིས་འབྲི་དེབ་ཟུང་ཟླ་བའི་ཕྱོགས་སུ་བསྲིངས་དུས་ཁོའི་གདོང་ལ་ངུ་མ་དགོད་ཀྱི་མདངས་ཤིག་ཤར།",
    "ངས་ཁྱེད་ཚོའི་ཆོག་མཆན་ལ་རེ་བ་བྱས་ཡོད།",
    "གཞན་དག་གིས་ཀྱང་མགོ་བོ་ལྡེམ་ལྡེམ་བྱེད་ཞོར་དུ་རེད་ལགས།",
    "རེད་ལགས་ཟེར།",
    "མཁར་མོ་མ་སྨད་གཉིས་ཀྱི་ངོས་ནས་ཞུ་ཚིག་འབུལ་བ་འདི་ལྟར།",
    "གཙང་བོའི་འགྲམ་དུ་རྣང་ཞིང་ཞིག་འགན་ལེན་བྱས་ཡོད་མོད།",
    "དེ་ནི་གནའ་གྲོང་གི་མཚན་སྙན་ལ་ཧ་ཅང་གནོད་པས།",
    "རྣང་ཞིང་ཐོག་གི་ལོ་ཏོག་ཐོན་སྐྱེད་ཀྱི་ཆུ་ཚད་སྔར་ལས་ལྡབ་འགྱུར་གྱིས་འཕར་རྒྱུར་བརྩོན་ལེན་བྱེད་ཆེད་དུ།",
    "ཁྱེད་ཚོས་ཀྱང་རྒྱབ་སྐྱོར་གནང་རྒྱུ་ཤིན་ཏུ་གལ་ཆེ་ཞིང་ངེད་མ་སྨད་གཉིས་ཀྱིས་རེ་བའང་མཐའ་གཅིག་ཏུ་བྱེད་ཀྱིན་ཡོད།",
    "ད་ནི་མཇུག་གི་ཐིག་ཕྲེང་དེ་ཁོ་ན་ལས་ལྷག་མེད་པས་མུ་མཐུད་དུ་བཀླགས།",
    "གོ་དོན་རེ་རེ་རང་རྐྱ་ཐུབ་པའི་ངང་ཚུགས་ཐུབ་བམ།",
    "སྐད་ཆ་རྗེས་མ་དེ་ནི་ཚིག་ངོས་ནས་རྙོག་འཛིང་ཧ་ཅང་ཆེ་བ་ཞིག་ཡིན་མོད་ཀྱང་།",
    "མཇུག་གི་ཚིག་དེས་རྙོག་འཛིང་གི་གོ་དོན་མང་བོ་ཞིག་རབ་རིབ་ཏུ་བཟོས་ཡོད་པ་སྟེ།",
    "ཁོ་ཚོ་རེ་ཞིག་ལ་གྲག་འགུལ་ཅི་ཡང་མེད་པར་བསྡད།",
    "ཁྱོད་ཚོས་མ་སྨད་འདི་གཉིས་ལ་རྒྱབ་སྐྱོར་བྱེད་རྒྱུར་འཐད་པ་ཡིན་ན།",
    "སྐྱ་ལྡང་གིས་འབྲི་དེབ་བླངས་ནས་ཤོག་ལྷ་རེ་རེ་བཞིན་ཕར་བསློགས་པ་དང་།",
    "མི་གཞན་དག་ཀྱང་སྐྱ་ལྡང་གི་གན་དུ་རུབ་ནས་འབྲི་དེབ་ངོས་སུ་མིག་ཅར་རེར་ལྟ་བཞིན་འདུག་ཡིན་ནའང་།",
    "མཚར་སྣང་གི་མདངས་ཤིག་ལས་ཅི་ཡང་མངོན་མེད།",
    "ཁོ་ཚོའི་ལྟ་ཚུལ་དེ་ལས་ངའོ་སྙམ་པའི་རྣམ་འགྱུར་ཞིག་ཀྱང་མངོན་འདུགསྐྱ་ལྡང་གིས་ཐེའུ་ཡར་བླངས་ནས་ཤུགས་ཀྱིས་འབྲི་དེབ་ཀྱི་རྒྱབ་ཤོག་ངོར་གནའ་གྲོང་།",
    "སྐྱ་ལྡང་གིས་ཁ་ཅི་ཡང་མ་གྲག་ཁོའི་རྣམ་འགྱུར་ནི་དངོས་གནས་དཔོན་པོ་མཐོན་པོ་ཞིག་གི་ཉམས་དང་ལྡན།",
    "ཤིང་ཆའི་ཐོག་གི་འགལ་རྐྱེན།",
    "དེ་ནི་དངོས་གནས་ལན་འདེབས་ཐབས་མེད་པ་ཞིག་རེད།",
    "གནའ་གྲོང་གི་མི་ཕལ་མོ་ཆེ་ནི་མི་རྒྱུས་མེད་ལ་མི་རློམ་ཞིང་།",
    "བདག་པོ་འདས་པའི་རྨོ་མོ་མ་སྨད་གཉིས་དང་དྭ་ཕྲུག་ཏུ་ལུས་པའི་བཟོད་པ་ངོ་ལུག་གསུམ་གྱིས་ཁོར་དོ་སྣང་དང་ག་ཚིགས་ཆེན་བྱེད་པ་མ་གཏོགས།",
    "ད་ལྟའི་བར་གནའ་གྲོང་གི་མི་སུ་ཞིག་གིས་ཁོར་བརྩི་འཇོག་བྱས་མྱོང་ངམ།",
    "དེ་ནི་གནའ་གྲོང་གི་དོན་དངོས་གནས་ཚུལ་ཡིན་ལ།",
    "རྨོ་མོ་མ་སྨད་གཉིས་ཀྱི་འཚོ་བར་ལྷག་བསམ་དག་པའི་སེམས་ཁྲལ་བྱེད་མྱོང་གནའ་གྲོང་།",
    "གནའ་གྲོང་གི་མི་རྣམས་ཟུང་ཟླ་བར་ཆ་རྒྱུས་མེད་ཀྱང་།",
    "ཕྱོགས་གཅིག་གིས་ཨུ་ཚུགས་བྱས་པ་ཙམ་གྱིས་འབྲེལ་འདྲིས་བྱེད་ཐུབ་པ་ཞིག་རྩ་བ་ནས་མིན་པས།",
    "ཟུང་ཟླ་བས་གནའ་གྲོང་གི་གནས་སྟངས་ལ་ཅི་འདྲའི་སེམས་ཁུར་བྱས་ཀྱང་ཁོའི་སེམས་ཁུར་དེ་གོང་སྨྲས་གསུམ་པོ་ཕུད་པའི་གནའ་གྲོང་གི་མི་སུས་ཀྱང་ཁས་ལེན་པ་ཞིག་འབྱུང་གིན་མེད།",
    "དེ་ནི་སེམས་ཁྲལ་ལྷག་མ་ཞིག་གམ་བསམ་བློ་སྟོང་བ་ཞིག་རེད།",
    "ཟུང་ཟླ་བས་གནའ་གྲོང་གི་མིས་འཚོ་བའི་རྒྱུན་ཇི་ལྟར་སྐྱོང་གི་ཡོད་པ་མི་ཤེས།",
    "ཞོགས་སྔ་མོ་ནས་གཞིས་ཀ་སོ་སོའི་དུད་ཁུང་ལས་དུ་བ་འཕྱུར་བཞིན་འདུག་ལ།",
    "གནའ་གྲོང་ལས་གཞན་པའི་གྲོང་ཚོ་མང་བོས་ཀྱང་དེ་ལྟར་འཚོ་བ་རོལ་གྱིན་འདུག་མོད།",
    "རྒྱལ་ཁབ་ཡོངས་ཀྱི་གྲོང་ཚོ་སོ་སོ་དང་གྲོང་རྡལ་སོ་སོ།",
    "དེ་དག་གིས་ཆུ་ཚོད་གཅིག་ཀྱང་ཚུད་ཟོས་སུ་མ་བཏང་བར་འཚོ་བའི་ཐད་ཀྱི་བྱ་དངོས་མང་བོ་གསར་གཏོད་བྱེད་ཀྱིན་འདུག་སྙམ།",
    "ཁྱོད་ལ་སྐྱོན་འདྲ་མ་བྱུང་ངམ།",
    "དེབ་དེ་ཁོ་ཚོའི་མིག་སྔར་ཕར་གཡུག་ཚུར་གཡུག་ཅིག་བྱས་རྗེས་ཆོག་མཆན་ཐོབ་སོང་ཟེར།",
    "ཐེའུ་དམར་པོར་ཡང་དང་ཡང་དུ་ཞིབ་ལྟ་བྱས་མོད།",
    "དེ་ནི་གནའ་གྲོང་གི་མིའི་གོམས་གཤིས་ཤིག་མིན་ནམ་སྙམ་བྱུང་།",
    "ཕྱུགས་ཟོག་གིས་ངོ་རྒོལ་དྲག་པོ་བྱས་མྱོང་ཡང་།",
    "བཟོད་པ་ངོ་ལུག་གི་ངག་ནས་ཐོས་པ་ལྟར་ན།",
    "ཨ་ཁུ་བསམ་གཏན་ནི་སྔར་དགའ་ལྡན་གྱི་རབ་བྱུང་པ་ཡིན་ལ།",
    "ཞིག་ལས་རྒྱལ་ཁམས་འགྲིམས་མྱོང་མཁན་ཞིག་གི་བློ་ཁོག་རྒྱ་ཆེ་བ་སྨོས་མ་དགོས་སྙམ།",
    "ཕལ་ཆེར་ཉིན་གུང་གི་ཆུ་ཚོད་བཅུ་གཉིས་པར་བསླེབ་ལ་ཉེ་སྐབས།",
    "ཨ་སྟག་དང་བཟོད་པ་ངོ་ལུག་གཉིས་ཀྱི་གདོང་གི་ཐེ་ཚོམ་མ་ལུས་སྐད་ཅིག་ལ་གཡའ་དག་པ་ལྟར་གྱུར་ཀྱང་།",
    "ཁོས་ཆུ་འདྲེན་འཁོར་ལོ་གཟུག་སའི་གནས་ངེས་ཅན་ཞིག་ད་དུང་གཏན་ཁེལ་བྱས་མེད་པས་རེད།",
    "རྗེས་སུ་བཟོད་པ་ངོ་ལུག་གིས་ཁོ་མོར་མི་འོས་པ་ཅི་ཡང་མི་བྱ་ཞེས་མནའ་བསྐྱལ་པས།",
    "ཟུང་ཟླ་བ་གཙང་བོའི་འགྲམ་དུ་ཆུ་འདྲེན་འཁོར་ལོ་གཟུག་སའི་ས་གནས་ཡག་པོ་ཞིག་བཙལ་དུ་སོང་།",
    "སྐྱ་ལྡང་དང་ཟུང་ཟླ་བ་གཉིས་གཙང་འགྲམ་དུ་ཕྲད་པ་དེ་རེད།",
    "སྐྱ་ལྡང་ལོ་དྲུག་ཅུར་བསླེབས་རེག་བར་དུ་གཙང་འགྲམ་གྱི་ས་རྒོད་སྟེང་ནས་ཡང་ཡང་བརྒྱུད་མྱོང་ཞིང་།",
    "གནའ་གྲོང་གི་གཞིས་གནའ་གྲོང་།",
    "གཤིན་ཡག་པོ་འདི་དངོས་གནས་བེད་མེད་དུ་བསྒྱུར་འདུག་ཟུང་ཟླ་བ་ཐེམ་པ་ཞིག་གི་ཐོག་ཏུ་བུད་མ་ཐག་འགྲོ་མཚམས་བཞག་ནས་སྨྲས།",
    "རྒོད་དུ་ལུས་པའི་ཐེམ་པ་རེ་རེ་བཞིན་གནའ་གྲོང་གི་འདབས་སུ་དར་གོས་སྔོ་སྐྱ་ཡུག་རེ་བཏིངས་པ་དང་འདྲ།",
