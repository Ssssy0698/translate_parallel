    "དད་པའི་སྙིམ་པས་རྫོགས་པར་གསོལ།",
    "བདེན་གསུང་བདེན་པར་གསུངས་པ་གང་།",
    "དུལ་བའི་དཔལ་གྱིས་རྣམ་པར་བརྗིད།",
    "བསྟན་པ་འབའ་ཞིག་གཅེས་པར་དགོངས།",
    "འགྲོ་བའི་དོན་དུ་གཡོ་བ་ལགས།",
    "ལྷག་པར་གཞོལ་འདི་རྨད་དུ་བྱུང་།",
    "ཡོན་ཏན་ལྷག་པར་སྒྲོ་བཏགས་ནས།",
    "ཀུན་མཁྱེན་ལུས་བཟང་ཞབས་ལ་གསོལ་བ་འདེབས།",
    "མ་ལུས་སྐྲག་པར་མཛད་ལ་གསོལ་བ་འདེབས།",
    "གསང་བདག་གཉིས་པར་གྱུར་ལ་གསོལ་བ་འདེབས།",
    "ལེགས་པར་དྲངས་ཏེ་བདག་ཡིད་གླང་པོ་ཆེ།",
    "དོན་གཉིས་ལྷ་ལམ་འཇུག་པར་བྱིན་གྱིས་རློབས།",
    "གནས་སྐབས་ཀུན་ཏུ་རྒྱལ་བས་གནང་བ་ཡི།",
    "ཀུན་ཏུ་དགའ་དང་མི་བདག་ལྷ་སྐྱེས་དང་།",
    "འཁོར་ལོ་སྡོམ་པར་གྲུབ་བརྙེས་བཅུ་གསུམ་ཡུལ།",
    "འདྲེན་མཛད་ནག་པོ་སྤྱོད་པར་གསོལ་བ་འདེབས།",
    "རིན་ཆེན་མཁྱེན་མཆོག་གྲུབ་ལ་གསོལ་བ་འདེབས།",
    "པཎ་ཆེན་གྲགས་པས་ཐམས་ཅད་མཁྱེན་པར་གསོལ།",
    "བལྟམས་ནས་གསུམ་ལོར་སྒྲ་དབྱངས་ཐོལ་བྱུང་གསུངས།",
    "ཞལ་བཞེས་ཡོན་ཏན་རྒྱ་མཚོར་གསོལ་བ་འདེབས།",
    "གེ་སར་ལྷ་ལྡེའི་གདུང་ལས་གཙང་ཡུལ་དུ།",
    "བལྟམས་ཤིང་མཁྱེན་རླབས་བརྟན་པའི་འཁོར་ལོའི་ཟླས།",
    "གཙང་མའི་རིགས་ལས་དབུ་རུ་འོལ་དགའ་རུ།",
    "ཇི་སྙེད་ངོ་མཚར་མཁྱེན་རླབས་མགྲན་ཟླ་བྲལ།",
    "༧རྒྱལ་སྲས་སྤྱོད་ལ་བརྩོན་པར་བྱིན་གྱིས་རློབས།",
    "སྟོན་པ་འོད་མའི་ཚད་དུ་བཞུགས་པའི་ཚེ།",
    "ལྷག་པར་དུ་རང་ཅག་གངས་ཅན་པ་རྣམས་དེང་དུས་མི་བཟད་པའི་འཇིགས་སྐྲག་སྡུག་བསྔལ་ལས་སྐྱོབ་ཅིང་།",
    "གོ་རིམ་ཡང་དུ་ཀུ་ལའི་གོས་བཟང་པོད་བཞི་པར་ཇི་གསལ་བཞིན།",
    "ཐུགས་རྗེ་རྣམ་པར་དག་པའི་མཁའི་དབྱིངས་ཆེར།",
    "མཁྱེན་བརྩེའི་སྣང་བ་མི་འགོག་སྤྲིན་ཆེན་ལས།",
    "བསྐལ་མང་ལེགས་བྱས་ཚོགས་གཉིས་སྣང་བའི་མཐུས།",
    "མཐའ་བྲལ་སེམས་དཔས་ཀྱང་ནི་དཔོག་པར་དཀའ།",
    "པཎ་གྲུབ་གཏེར་སྟོན་དུ་མའི་རྣམ་པར་རོལ།",
    "འཛིན་མཁས་རྒྱ་མཚོའི་མགོན་དུ་བརྟན་པར་བཞུགས།",
    "ཕན་བདེའི་འོད་སྣང་འགྱེད་ཕྱིར་བརྟན་པར་བཞུགས།",
    "འགྲོ་ཀུན་སྒྲོལ་ལ་ངལ་མེད་བརྟན་པར་བཞུགས།",
    "མཁྱེན་བརྩེ་ནུས་པའི་ཡལ་འདབ་ཀུན་ཏུ་རྒྱས།",
    "ལྷག་པར་འཕེལ་བའི་དགའ་སྟོན་རྒྱས་པར་ཤོག།",
    "ཕུན་ཚོགས་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་གྱུར་ཅིག།",
    "ལེགས་ཉེས་རྣམ་པར་འབྱེད་པའི་བློ་གྲོས་ཀྱིས།",
    "རིས་མེད་རྒྱལ་བསྟན་སྤྱི་དང་ཁྱད་པར་དུ།",
    "རྒྱལ་བསྟན་འཛིན་ལ་འགོག་པ་མེད་པར་ཤོག།",
    "རྫོགས་ལྡན་དབྱར་གྱི་བཞིན་རས་ངོམ་པར་ཤོག།",
    "རིང་ནས་བསྟན་ལ་ལོག་པར་འཁུ་བ་ཡི།",
    "རང་སར་ཞི་ཞིང་ནུས་སྟོབས་ཉམས་པར་ཤོག།",
    "རང་གཞན་དོན་གཉིས་ལྷུན་གྱིས་འགྲུབ་པར་ཤོག།",
    "ཁྱད་པར་བཀའ་སྲུང་རྡོ་རྗེ་དྲག་ལྡན་གྱིས།",
    "རྣམ་བཞིའི་འཕྲིན་ལས་གཡེལ་བ་མེད་པར་སྒྲུབས།",
    "མཐོན་མཐིང་རལ་བའི་ལན་བུ་དོར་ནས་ཚངས་པར་སྤྱོད་པའི་མཚན་སྙན་གྱི་ཅོད་པཎ་སྤྱི་བོར་བཅིངས་པ་དང་ཆབས་ཅིག་མི་འཇིགས་གདོང་ལྔས་བཏེགས་པའི་གསེར་གྱི་ཁྲི་འཕང་མཐོན་པོར་ཞབས་ཟུང་རྡོ་རྗེའི་རང་ཁམས་སུ་བརྟན་ཅིང་།",
    "བཞེད་དོན་ལྷུན་གྱིས་འགྲུབ་པར་བྱིན་གྱིས་རློབས།",
    "བཞེད་དོན་ལྷུན་གྱིས་འགྲུབ་པར་བྱིན་གྱིས་རློབས།",
    "བཞེད་དོན་ལྷུན་གྱིས་འགྲུབ་པར་བྱིན་གྱིས་རློབས།",
    "བཞེད་དོན་ལྷུན་གྱིས་འགྲུབ་པར་བྱིན་གྱིས་རློབས།"
  ]
}