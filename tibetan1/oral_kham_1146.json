    "ཁྱེད་རང་རྣམས་ཀྱི་ཐུགས་ཀར་ཕོག་ཁྱེད་རང་རྣམས་ལྷན་སྐྱེས་ཀྱི་ཐུགས་ཀ་ནས་འོད་ཟེར་ལྕགས་ཀྱུའི་རྣམ་པ་ཅན་ཕྲེང་མ་ཆད་པར་འཕྲོས་ཏེ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ན་དེ་ཝི་ས་པ་རི་ཝཱ་ར་ཨི་དཾ་སོགས་གོང་འདྲ།",
    "མདུན་གྱི་གཏོར་རྟེན་འདི་ཉིད་ཀྱང་རང་རིག་བདེ་བ་ཆེན་པོའི་ཡེ་ཤེས་སོགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པའི་ཐོག་མར་མཎྜལ་འབུལ་བ་ཞུ།",
    "རུས་སྦལ་གྱི་འདུག་སྟངས་བཅས་ལ་རྡོ་རྗེ་བསྡོམས་པ་ལས་སྲིན་ལག་བརྐྱང་བའི་གཤིན་རྗེའི་དམ་རྒྱ་གཡབ་ཅིང་།",
    "ཞལ་ནས་ཐོན་ཁྱེད་རང་རྣམས་ལྷར་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་ཐུགས་དམིགས་འདི་ལྟར་མཛོད།",
    "ཨོཾ་ནག་པོ་ཏི་པ་རྭ་ཙ་ནཱ་ག་རཀྴ་ཨོཾ་ཕེ་ལཾ་ཧཱུྃ།",
    "ཞལ་ནས་ཐོན་ཁྱེད་རང་རྣམས་ལྷར་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "ཨོཾ་ནག་པོ་ཏི་པ་རཱ་ཙ་ནཱ་ག་རཀྴ་ཨོཾ་ཕེ་ལཾ་ཧཱུྃ།",
    "ཡུལ་ལམ་བྱེས་གསུམ་གར་འདུག་ཀྱང་།",
    "ཞེས་པའི་ཁྲུས་དང་མཎྜལ་བྱེད་དུ་གཞུག་ཁྱེད་རང་རྣམས་ལ།",
    "ཁྱེད་རང་རྣམས་མི་དམིགས་ཏེ།",
    "ལག་ལེན་འདྲ་མིན་ཅི་རིགས་འདུག་པ་ལས།",
    "དེའི་ཐུགས་ཀ་ནས་གྲི་གུག་ཐོད་པ་ཁ་ཊྭཱཾ་ཅང་ཏེའུ་སོགས་ཕྱག་མཚན་བསམ་གྱིས་མི་ཁྱབ་པ་བྱུང་བ་ཁྱེད་རང་རྣམས་ཀྱི་ཡིད་ལ་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པའི་ཐོག་མར་མཎྜལ་འབུལ་བར་ཞུ།",
    "དེ་ནས་བདག་ཉིད་སློབ་དཔོན་པདྨ་ཀཱ་ར་གསལ་བ་དང་ཁྱེད་རང་རྣམས་གཉེན་པོ་སྟོབས་ཀྱི་ལྷ་གུ་རུ་པདྨ་ཐོད་ཕྲེང་རྩལ་སྣང་སྲིད་ཟིལ་གྱིས་གནོན་པའི་སྐུར་ལམ་གྱིས་གསལ་ཐོབ་མཛོད།",
    "དེ་ལས་འོད་ཟེར་འཕྲོས་པས་རང་རང་གནས་པའི་ཡུལ་ཆེན་པོ་རྣམས་དང་ཁྱད་པར་གླིང་དྲུག་རྨ་ཡི་གཡང་ར་ནས་གཏེར་བདག་ཆེན་པོ་འཁོར་དང་བཅས་པ་བཛྲ་ས་མ་ཛ་སྤྱན་འདྲེན་པ་ནི་སྤོས་རོལ་དབྱངས་དང་བཅས་ཏེ།",
    "བཅོམ་ལྡན་འདས་དང་ཞག་དུས་མཉམ་དུ་འཁྲུངས་པར་བྱེད་ལ།",
    "སྲིད་པ་ཆའི་ས་ཡང་འདུག་ཅིང་།",
    "ནུ་འོ་ཝས་དྷ་གཉིས་དང་དྲུག་ལ་བོད་མི་བུ་ལྡོངས་དྲུག་ཟེར་བའང་འདུག་ནའང་།",
    "ངན་ཤོས་སུའང་འདུག་ཅིང་།",
    "གདུལ་བྱར་མ་གྱུར་པ་མུན་པ་མུན་ནག་ལྟ་བུར་འདུག་པ་ལ།",
    "སྤྲུལ་པ་བཏང་དགོས་པ་འདུག་སྙམ་ནས་དགོངས་པ་ན།",
    "དེའི་ཕྱིར་དུ་སྲོག་འདོར་བའི་རྣམ་འགྱུར་གྱིས་ཚུལ་སྟོན་གྱིན་འདུག་ནས།",
    "ལྟས་ངན་དུ་འདུག་པས་སོད་གཅིག་གསུང་པ་ལ།",
    "འདི་ནི་ངོ་མཚར་ཅན་གཅིག་འདུག་པས།",
    "དེ་འདྲ་གཅིག་འདུག་ན་ཉོ་བར་བྱས་ནས།",
    "གམ་ན་རྒ་པོ་གུ་བ་ལྟ་བུ་གཅིག་འདུག་རྒན་པོ་གང་ནས་ཡོང་།",
    "ད་ངའི་ཡབ་མེས་ཀྱི་གཉན་པོ་གསང་བ་འདིའི་ནང་ན་ཅི་འདུག་ལྟོས་དང་ཟེར་ཀློག་པས།",
    "ཤེས་པ་ཅན་བཅུ་གཉིས་མཐར་འཁྱམས་འདུག།",
    "རྒྱལ་པོ་འདི་ནི་ཤིན་ཏུ་སྒམ་པོ་གཅིག་འདུག་གོ་ཟེར་ནས།",
    "ཙན་དན་ཧ་རིའི་སྡོང་པོ་གཅིག་ལ་ཕོག་འདུག་པ།",
    "ཡུལ་དེ་ན་བཀྲ་ཤིས་པའི་རྟགས་བརྒྱད་ལ་སོགས་པའི་དགེ་དུ་མ་ཚང་འདུག་ཀྱང་།",
    "སངས་ནམ་ལང་ཙ་ན།",
    "བཅུ་གཅིག་ཞལ་གཅིག་རང་བྱོན་དུ་འདུག་པས།",
    "ར་སའི་གཙུག་ལག་ཁང་བཞེངས་ནས་ལོ་གསུམ་ལོན་ཙ་ན།",
    "དེ་ཡང་རང་རིག་པསརྟོགས་པར་བྱ་བ་ཡིན་ཏེ།་",
    "དེས་ན་འབྲས་བུ་བཞིན་ངུ་དོན་རིག་པ་ཡང་རང་རིག་པ་ཙམཉིད་དོ།",
    "ཇི་ལྟར་ངས་འདི་རྟོགས་པ་དེ་བཞིན་དུ་རུང་བའི་ཡུལ་ནའདུག་པ་གཞནགྱིས་རྩ་ཀྱང་རྟོགས་སོ་ཞེས་འཇིག་རྟེན་ན་གྲགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "འགའ་ཡང་མ་ཡིན་པའི་ཕྱི་གཤིག་ཡང་རང་རིག་པ་ཉིད་དོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "ཨདོན་དུ་སོགས་པ་མཚུངས་ཀྱང་རང་བཞིན་འགའ་ཞིག་གསལ་བར་སྣང་བའི་ཕྱིང་གོམས་པ་ལསོགས་པ་ལསཀྱང་འགྱུར་རོ།",
    "དེས་ན་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་ནོ་ཞེས་སྟོན་ཏོ།",
    "དེ་ལྟང་དོན་ནི་རྣམ་ངེས་ངེས་ དེའི་ཕྱིར་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་བཉིད་འབྲས་བུ་ཡིན་གྱི་དོན་རིག་པ་ནི་མ་ཡིན་ཏེ།",
    "དོན་དམ་པལ་བལྟོས་ནས་འདིའི་དོན་རིག་པ་ཡིན་ཡང་རང་རིག་པཞད་དོ།",
    "འཁྲུལ་བ་མེད་ན་ནི་འདི་མཐའདུག་མེད་པར་འགྱུར་བའི་ཕྱིར་ཐ་དད་པ་ནི་དེ་ཉིད་མ་ཡིན་ནོ།",
    "གཟུགས་ལ་སོགས་པའི་ཡུལ་གྱི་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་དོན་དང་རང་སྣང་བ་ཡིན་ལ།",
    "ཡུལ་གྱི་ཤེས་པ་གང་ཡིན་ཀྱི་། པ་དེ་ནི་དོན་དང་རང་སྣང་བའི་ཡིན་ལ་ཞེས་བྱ་བ་ནི་བསླབ་པར་བྱའོ།",
    "སྔོན་བོ་ལ་སོགས་པའི་ཡུལ་ནི་བློ་དང་ལྷན་ཅིག་དུས་གཅིག་ཉིད་དུ་མྱོང་བ་ཡིན་ཏེ།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་མིན།",
    "ལས་ཀྱི་རྣམ་པ་ཡིན་ཡང་རང་རིག་པར་ཁསམ་ལེན་པའི་ཕྱིར།",
    "གལ་ཏེ་བློ་ཡང་རང་རིག་པ་མ་ཡིནན་ནི་ཁྱད་པར་དང་ཁྱད་པར་ཅནམ་ཡིན་པའི་དོན་ཉིད་རྟོགས་པ་ཡིནནོཞེས་བྱ་བར་འགྱུར་རོ།",
    "འོན་ཏེ་གཞན་གྱིས་ཀྱང་རང་བཞིན་དེ་ཉིད་རྟོགས་པ་ཡིན་ནོ།",
    "འོན་ཏེ་དེར་ཡང་རང་རིག་པ་ལ་སོགས་པ་དོན་གྱི་སྣང་བ་སྣང་བ་ཡིན་པས་ན།",
