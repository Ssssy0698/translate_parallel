    "བསམ་བློ་ཡང་མ་བཏང་བར་སེམས་སུ་སྤྱིར་ན་བུ་མོ་ཚོས་སྐྱེས་པ་ཚོའི་ལ་གཞས་ལ་ལན་སྟེར་བ་ཧ་ཅང་དཀོན་ཡང་།",
    "ད་བར་དང་ཐོག་བུ་མོ་དེའི་སེམས་ལ་བཙུན་པ་དེས་ཁོ་མོ་ལ་ཀུ་རེ་རྩེད་བཞིན་ཡོད་པས་ཁོ་མོས་ཀྱང་ཁོ་ལ་ཀུ་རེ་ཞིག་རྩེ་དགོས་སྙམ་ནས་དེ་ལྟར་བླངས་པ་ཡིན་མོད།",
    "སྙམ་སྟེ་སྐྲག་ཐག་ཆོད་དེ་ཆུ་ཟོའང་བསྒྱུར་ནས་བྲོས་སོང་།",
    "ཁོ་རང་ཞོགས་པར་མལ་ལས་ལངས་པ་འཕྱི་བས་དགོང་མོར་གཉིད་ཀྱང་མི་ཁུགས།",
    "ཁྱིམ་ཚང་གཅིག་གིས་ད་རུང་མེ་སྦར་བཞིན་ཡོད་པ་དེ་བས་ཀྱང་གསལ་བོར་མཐོང་ཐུབ།",
    "ཁོ་སྒྲོན་མེའི་འོད་གསལ་བའི་ཁྱིམ་ཚང་དེའི་ཕྱོགས་སུ་གཟས་ནས་སོང་སྟེ་རྐང་འཇབ་ལག་འཇབ་ཀྱིས་སྦྲའི་སྒོ་བར་ནས་ནང་ལ་གཅིག་བལྟས་དུས་ཁྱིམ་ན་མི་གཅིག་མ་གཏོགས་མེད་ལ།",
    "དེའང་བུད་མེད་ཅིག་ཡིན་ནའང་ཕངས་པ་ཞིག་ལ་ཆུ་ལེན་བུ་མོ་དེ་མ་རེད།",
    "བུད་མེད་དེ་དང་ཐོག་སྐྲག་སྟེ་ཁ་ནས་ཨ་མ་ཞེས་ཤོར་བཞིན་ཡར་ལངས་ལ།",
    "ཡུད་ཙམ་ནས་སེམས་ལྷོད་ལ་བབས་ཏེ་ཁྱོད་སུ་ཡིན་ཟེར།",
    "དེ་ནི་གཟུགས་རིང་ཞིང་ཤ་སྐམ་ལ་སྨིན་མ་སྟུག་ཅིང་ངོ་མདངས་སྔོ་ཤས་ཆེ་བ་ཞིག་རེད།",
    "རིམ་བཞིན་བུད་མེད་དེའི་གདོང་ལ་བལྟས་པ་ན་ཁོ་མོ་ཕལ་ཆེར་ལོ་སུམ་ཅུ་ལྷག་ལ་སླེབས་ཡོད་ཅིང་།",
    "ཨེ་ཁོ་མོས་དབུགས་རིང་ཞིག་འཐེན་ཞིང་དེ་མ་ཐག་གདོང་ལ་སྡུག་ཉམས་ཤིག་ཤར་ཏེ་སྐྱེས་པ་ཁྲེལ་མེད་ཅིག་ཡོད་ཀྱང་སྔ་ས་ནས་ང་རང་བསྐྱུར་ཏེ་རབ་བྱུང་བསྒྲུབས་སོང་ཟེར།་",
    "༡ ༢ ཡོ་ཨ་དེ་ངོ་མ་ཁྲེལ་མེད་ཅིག་རེད།",
    "རེད་ཡ།",
    "ད་ཁྱོད་ཀྱིས་དུ་བ་འཐེན་ནམ་བུད་མེད་དེས་དེ་ལྟར་དྲིས།",
    "མཚམས་རེར་ཁོ་མོ་ལ་ངོ་བསྟོད་ཀྱི་ཚིག་ཀྱང་མི་ཉུང་བ་ཞིག་སྨྲས་པར་བརྟེན་ཁོ་གཉིས་ཀྱི་དམིགས་ཡུལ་ཡང་གཅིག་ཐོག་ཏུ་སོང་།",
    "དེ་ཐོབ་པ་དང་ཁོ་ལ་བྱའོ་ཅི་རེད།",
    "བབོད་གལ་ཏེ་ཁྱོད་ལ་དེ་འདྲའི་འདུན་མ་ཡོད་ན་དེ་ནི་ལས་སླ་མོ་ཞིག་རེད།",
    "ཉིན་འགའ་རེར་ཁྱིམ་ཚང་དེ་གར་བསྐུངས་ནས་བསྡད་རྗེས།",
    "དེས་ན་ང་ཚོས་ཀྱང་སླར་ཡང་ཁོ་ལ་ར་ལོ་ཟེར།",
    "ཁྱོད་རང་གདོན་གྱིས་བསླུས་པ་མིན་ནམ།",
    "གདོན་གྱིས་ཁྱོད་རང་བསླུས་པ་འདྲ།",
    "ཁོ་མོ་འུ་གཉིས་ཀའི་སུའི་ཆུང་མ་ཡིན་པ་དེ་ནས་ཐག་གཅོད་བྱེད་སྲིད།",
    "གལ་ཏེ་ཁོས་རེད་ཟེར་ན་ངེད་གཉིས་ཀྱིས་གཉེན་སྒྲིག་དཔང་ཡིག་གང་ནས་བླངས།",
    "རང་གིས་དང་ཐོག་གཉེན་སྒྲིག་དཔང་ཡིག་མ་བླངས་པར་འགྱོད་པ་གཏིང་ནས་སྐྱེས་ཏེ་རང་གིས་རང་ལ་འགྲམ་ལྕག་གཅིག་གཞུས་པ་ན་སྣབས་ལུག་ནས་མ་ནེའི་མགོ་ལ་ཐུག་སོང་།་",
    "དེ་ནས་ཁོ་རང་ཟ་ཁང་ཞིག་གི་སྒོ་ཁར་སླེབས་པ་དང་ད་གཟོད་རང་གིས་ནངས་ཟས་གུང་ཟས་གཅིག་ཀྱང་འཐུངས་མེད་པ་ཡིད་ལ་དྲན།",
    "ཕངས་པ་ཞིག་ལ་ཁོའི་ལག་ཏུ་སྒོར་རྡོག་གཅིག་ཀྱང་མེད་པ་རང་གི་སེམས་ན་ཁྲིགས་སེ་ཡིན།",
    "ཐེངས་ཤིག་ཁོས་སྒོར་མོ་སྟོང་བཞི་རྙེད་པའང་མ་གསང་མ་སྦས་པར་བདག་པོར་སྤྲད་སོང་།",
    "བལྟས་ཀྱིན་བལྟས་ཀྱིན་ཁོའི་སེམས་ལ་རང་ཉིད་གྲྭ་བ་ཡིན་དུས་ཀྱི་འཚོ་བ་དེ་དྲན་བྱུང་དད་ལྡན་མང་ཚོགས་ཀྱིས་རྒྱུན་ཆད་མེད་པར་གྲྭ་བ་ཚོར་འབྲས་ལས་ཤ་མང་ཞིང་།",
    "གལ་ཏེ་ཆ་རྐྱེན་ཅུང་ཞན་པའི་ཁྱིམ་ཚང་ཞིག་གིས་འབྲས་ཐུག་ནང་ལ་རྒུན་འབྲུམ་གྱི་ཚབ་ཏུ་སིལ་དམར་བཏབ་ཡོད་ན་གྲྭ་བ་ཚོས་ཧེ།",
    "འོན་ཀྱང་ཁོག་པའི་ནང་ནས་ཁོ་ལ་ངེས་པར་དུ་ཟ་མ་ཟ་དགོས་པའི་བརྡ་སྔར་ལྟར་རྒྱག་གིན་འདུག་ཨེ་ད་ཅི་བྱེད།",
    "ད་ལྟ་དེ་ཚོ་གང་ལ་སོང་བ་ཡིན་ནམ།",
    "ཁོས་དེ་ལྟར་དྲན་པ་དང་མཉམ་དུ་རང་གི་བཞོན་པ་གཡག་རྒན་དེ་ཡིད་ལ་ཤར།",
    "ར་ལོས་རང་གི་གཡག་རྒན་དེ་སྒོར་བདུན་བརྒྱར་བཙོངས་པ་རེད།",
    "གལ་ཏེ་ཁོ་རང་ཚོང་པ་ཉམས་མྱོང་ཅན་ཞིག་ཡིན་རྒྱུ་ན་དེ་ལས་མང་བ་ཞིག་ལ་བརྗེ་ཐུབ་ཀྱང་སྲིད།",
    "འོན་ཀྱང་ར་ལོར་མཚོན་ན་འདི་ནི་ཡིད་ཚིམ་པའི་གྲངས་ཀ་ཞིག་རེད།",
    "ཀ་ལཆང་ལྔ་པོ་དེ་དང་ང་ར་ལོར་ཡོད་པ་ནི་སྒོར་མོ་ཡིན།",
    "དེའི་གྱོན་པར་བལྟས་ན་ས་ཆ་འདིའི་མིན་པ་ཐག་གིས་ཆོད།",
    "ད་ཁྱོད་གང་གི་ཡིན་ར་ལོས་ཁོ་མོའི་གདོང་ལ་ལྟ་བཞིན་དེ་ལྟར་དྲིས།",
    "ཨ་མཆོག་གི་ཡིན་བུད་མེད་དེ་ཚུར་འཁོར་ནས་ར་ལོར་བལྟས།",
    "ཁོ་མོ་ལོ་ཉི་ཤུ་ལྷག་ཙམ་ཡིན་ལ།",
    "ད་དུང་ཁྱོད་རྩེ་ཆུའི་ཁར་ཆུ་ལེན་དུ་སོང་མྱོང་ངམ།",
    "བུད་མེད་དེས་ཁོའི་སྐད་ཆའི་ནང་དོན་མ་གོ་བར་ངོ་མཚར་བའི་ངང་ར་ལོའི་གདོང་ལ་བལྟས་འདུག་ཁ་བ་བབས་ཁྱོད་རང་རྩེ་ཆུའི་ཁར་ཆུ་ལེན་དུ་སོང་མྱོང་བ་ཁོ་ཐག་རེད།",
    "ཟས་ཤིག་ཟ་འདོད་མོད་ཁ་ར་ལོས་དེ་མ་ཐག་ཁོ་མོར་སྒོར་མོ་མི་འདུག་སྙམ་ནས་ངས་ཁྱོད་ངོ་ཤེས།",
    "ངས་ཁྱོད་མཐོང་མྱོང་།",
    "ཁྱོད་ཀྱིས་ཅུང་ཙམ་སྒུགས་དང་།",
    "༡ ཀྱི་དང་ཐོག་བུད་མེད་དེ་སོམ་ཉིའི་ངང་དུ་འདུག་པ་ལས་ར་ལོའི་རྗེས་ལ་མི་ཡོང་མོད།",
    "ར་ལོས་ཁྱོད་རང་སྐྲག་མི་དགོས།",
    "ངས་ཁྱོད་ངོ་ཤེས་ཟེར་ནས་ཁོ་མོའི་ཕུ་ཐུང་ནས་ཡང་ཡང་འཐེན་པས་བུ་མོ་དེའང་འཐད་ལ་མི་འཐད་པའི་ངང་ནས་ར་ལོའི་རྗེས་སུ་འབྲངས།",
    "དམ་པ་ཁོ་གཉིས་ཀ་དཔུང་བ་མཉམ་གཤིབ་ངང་སྲང་ལམ་ཆུང་བ་ཞིག་གི་ཕྱོགས་སུ་སོང་།",
    "འདིས་ཅི་ཟེར།",
    "སྔོན་ང་ལའང་ཆུང་མ་ཞིག་ཡོད་མོད།",
    "རྒྱ་ཡིག་ཐོག་དང་བོད་ཚིག་ཐོག་ཟེར་བ་ངོ་མ་རེད།",
    "མེའོད་དེས་ན་ཁྱོད་རང་གིས་ལྟོས།",
    "དེས་ན་ར་ལོས་ཀྱང་སེམས་གཏིང་ནས་རང་གི་སྒྱིད་ལུག་པའི་སྤྱོད་ངན་བསྒྱུར་ཏེ་ཡིད་སེམས་དྲང་བའི་བུ་མོ་འདི་དང་མཉམ་དུ་འཚོ་བ་རོལ་རྒྱུའི་སེམས་ཐག་བཅད་ནས་ཨ་ལགས་ཤིག་གི་དྲུང་ནས་ཆང་ཡང་བཅད་པ་རེད།",
    "ད་ཡོད་པར་ལོ་ངོ་མ་བུད་མེད་འདི་ལ་བརྩེ་དུང་ཆགས་འདུག་བརྩེ་དུང་འདི་ནི་ཁོ་རང་བུད་མེད་སྔོན་མ་གཉིས་ལ་གཏན་ནས་ཆགས་མ་མྱོང་བ་ཞིག་རེད།",
    "བུད་མེད་དེས་ཀྱང་ར་ལོ་ཕྱིར་ཡོང་བ་མཐོང་མ་ཐག་སྤྱི་ལེ་གཅིག་གཉིས་ཀྱི་ཚད་ནས་སྔོན་དུ་བརྒྱུགས་ཡོང་བར་མ་ཟད་ཆ་རྐྱེན་འཛོམས་ཚོད་ཀྱིས་ཁོ་ལ་ཟ་རྒྱུ་རེའང་གྲ་སྒྲིག་བྱས་ནས་ཡོད།",
    "གང་ལྟར་ཡང་བུ་མོ་དེ་དང་མཉམ་དུ་བསྡད་པ་ནས་བཟུང་ར་ལོ་དངོས་གནས་མི་གཞན་ཞིག་ཏུ་འགྱུར་སོང་།",
    "འོན་ཀྱང་བུ་མོ་དེ་ར་ལོའི་གམ་ནས་འགྲོ་ཞོར་དུ་ར་ལོ།",
    "ཟླ་དྲུག་འཁོར་རྒྱུ་སླ་མོ་རེད།",
    "ང་རང་ནམ་ཡང་ཁྱོད་ཀྱི་ཡིན་ཟེར།",
    "བོད་ཇི་འདྲའི་གཡོ་ཟོལ་བྲལ་ཞིང་བྱམས་བརྩེ་ལྡན་པའི་ཚིག་ཅིག་རེད་ཨང་།",
    "ཚིག་འདིས་ར་ལོར་སྔོན་ལ་ཡོད་མ་མྱོང་བའི་སྤོབས་པ་ཞིག་དང་རེ་ལྟོས་ཤིག་སྦྱིན་བྱུང་བས་ཁོས་སྣབས་དང་མིག་ཆུ་གཙང་མར་ཕྱིས་ནས་ཡར་དགྱེས་ཏེ་ཁྱོད་ཀྱིས་སེམས་བདེ་མོ་བྱོས།",
    "ངས་ཁྱོད་ལ་བསྒུགས་ནས་འདུག་ཟེར།",
    "གོང་གི་ར་ལོའི་གཏམ་རྒྱུད་འདི་ངས་ལོར་བྲིས་ཤིང་།",
    "ཅུང་མ་འགོར་བར་ཁང་བ་གཞན་པའི་ནང་གི་བཙོན་མ་རྣམས་ཀྱང་བེམ་པོའི་སྟེང་ལ་བྱ་རྒོད་བབས་པ་ལྟར་གཅིག་རྗེས་གཉིས་མཐུད་ཀྱིས་ངའི་གམ་ལ་འདུས་ཏེ་ཅིའི་ཕྱིར་འདི་རུ་གདན་འདྲེན་བྱས་པ་དྲིས།",
    "རྗེས་སུ་ངས་རིམ་བཞིན་རྟོགས་པ་ནི་མི་གསར་བ་ཞིག་བཟུང་ཡོང་མ་ཐག་ཁྱོད་རང་མི་རིགས་གང་ཡིན་ཡང་ཆོག་ལ་ངོ་ཤེས་མི་ཤེས་སུ་ཡིན་ཡང་རུང་།",
    "བཙོན་མ་རྙིང་བ་རྣམས་ཀྱིས་འདི་ལྟར་ཁྱོད་རང་ཡོངས་སུ་བསྐོར་ནས་འདྲི་ཚིག་སྣ་ཚོགས་འདྲི་བར་བྱེད་ལ།",
    "འདི་ནི་ཁྱོད་ལ་སེམས་ཁུར་བྱེད་པ་རེད་ཟེར་བ་ལས་ཁོ་ཚོའི་ཉི་མ་འཁྱོལ་ཐབས་རེད་ཟེར་ན་འགྲིག་འོན་ཀྱང་ངས་ཁོ་ཚོ་ཧ་ཅང་ཡིད་ཆད་པར་བྱས་སོང་སྟེ།",
    "དེས་ན་ཁོ་ཚོ་ཧ་ཅང་ཕངས་སེམས་སྐྱེ་བཞིན་ཕྱིར་སོང་ཞིང་།",
    "ཡང་འདང་ཞིག་བརྒྱབ་ན་ཁོ་ཚོ་ད་རེག་བར་དུ་རང་ཉིད་ཅིའི་ཕྱིར་གདན་འདྲེན་བྱས་པ་དང་།",
    "ཐ་ན་ཇི་ལྟར་གདན་འདྲེན་བྱས་ཡོང་བའང་མི་ཤེས་པ་ཞིག་ལ་འཕྲད་པ་ནི་ཐེངས་དང་པོ་ཡིན་པས་འདི་ནི་ཡ་མཚན་ཞིག་དང་ཡང་ན་དགོད་བྲོ་བ་ཞིག་ལ་བརྩིས་ནས་དེ་རིང་གི་ཉི་མ་འདི་ལྟར་འཁྱོལ་བའི་རེ་བ་འཆངས།",
    "ར་ལོ་མུ་མཐུད་དུ་ངའི་གམ་ནས་བསྡད་དེ་རེད་ཡ།",
    "དེ་སྔོན་ར་ལོའི་སྐུད་པོས་རལ་བ་འདི་རྩེ་ནས་བལ་ཏེ་ར་ལོ་མི་གྲལ་ལ་འགྲོ་སྲོལ་མེད་པ་ཞིག་བཟོས་ནའང་རྒྱ་ནག་གི་གཏམ་དཔེ་ལ་རྙིང་བ་མ་སོང་ན་གསར་བ་མི་ཡོང་ཟེར་བ་ཅིས་མ་བདེན་ཏེ་ར་ལོའི་རལ་བ་འདི་སྔར་ལས་ཀྱང་སྦོམ་ཞིང་རིང་བོར་སྐྱེས་འདུག་ད་དུང་།",
    "རང་གིས་བསམ་བློ་གཏོང་མི་དགོས་པར་ཤར་ཤར་བྲིས་པ་ཙམ་གྱིས་རྩོམ་ཡོན་ལེན་ཐུབ་པའི་དོན་བཟང་འདི་འདྲར་ད་ལྟ་ཤིན་ཏུ་འཕྲད་དཀའ་མོད།",
    "དེས་ན་ད་ཐེངས་ར་ལོ་ངེད་གཉིས་མ་གྲོས་རིང་མཐུན་གྱིས་འདི་རུ་འཕྲད་པའི་བསྐལ་བ་བཟང་བོ་འདི་གོང་མ་ལྷ་ཡིས་གནང་བ་ཡིན་མོད།",
    "ཁྱེད་རང་ཕྱིར་སོང་ཆོག་ཟེར་ལ་ཁད་ལོས་ཡོད་སྙམ་གྱིན་འདུག་།",
    "ཐག་སྒྲ་རྣ་བར་སྙན་པོ་རེད།",
    "ང་ཚོ་ཚང་མའི་རྐང་སྣམ་ཁ་ཐིག་དང་ཐ་ན་ལྷམ་ཐིག་ཀྱང་བླངས་སོང་བས་གཡོན་ལག་གིས་རྐང་སྣམ་གྱི་ཁ་འཛིན་པ་ལས་གཞན་པའི་ལས་ཀ་ཅི་ཡང་བྱེད་ཐབས་མེད།",
    "དེ་བས་ར་ལོས་ཀྱང་གཡོན་ལག་གིས་རྐང་སྣམ་ཁ་བཟུང་བ་དང་གཡས་ལག་གིས་སློག་པ་ཐར་བཅལ་ཏེ་ཉི་མར་ཅུང་ཙམ་ལྡེ་བ་ན་ཤིག་སྲོ་མང་གི་དཔུང་དེ་ཆར་ཤུལ་གྱི་ཤ་མོ་བཞིན་སྤུ་རྩེ་ལ་འགོས་ནས་འཁྲབ་སྟོན་རྣམ་པ་སྣ་ཚོགས་བྱས་པ་ན་མི་གཞན་རྣམས་ཀྱང་མ་གྲོས་རང་མཐུན་གྱིས་ར་ལོའི་སློག་པའི་མཐའ་རུ་འདུས་ཏེ་གན་གན།",
    "ཐག་སྒྲ་རྣ་བར་སྙན་པོ་རེད།",
    "ཟེར་ནས་མི་གཞན་པའི་ལག་གི་ཤིག་རྣམས་བླངས་ཏེ་ཐག་ཐག་ཏུ་བཟའ་བར་བྱེད།",
    "ཕར་བལྟས་ན་འདི་ནི་ཁོའི་འཛད་མཐའ་མེད་པའི་རྒྱུ་ནོར་ལ་རང་གིས་ཅི་དགར་ལོངས་སུ་སྤྱོད་བཞིན་པའི་སྣང་བ་ཞིག་ཡོད་པ་འདྲ།",
    "ད་ཐུབ་ངས་ཁྱོད་ཀྱི་སེམས་ཕམ་པ་མིན་མོད།",
    "འོན་ཀྱང་ཁྱོད་རང་མ་མཐའ་བཡང་དེ་རིང་ཕྱིར་གཏོང་མི་སྲིད།",
    "ར་ལོ་ངའི་གམ་ལ་ཡོང་སྟེ་ཕར་བལྟས་ན་ལྟ་སྲུང་བ་ཁྱོད་ལ་བཟང་བ་འདྲ།",
    "ཁྱོད་ཀྱིས་ཁོ་རང་ངོ་ཤེས་སམ་ཟེར།",
    "ཅི་རེད།",
    "ཁོ་རང་ཁྱོད་ཚོར་དེ་འདྲ་མི་བཟང་བ་ཡིན་ནམ།",
    "ནི་མ་རེད་མ་རེད།",
    "ང་ཚོར་མི་བཟང་བ་ནི་ལྟ་སྲུང་བ་གཞན་ཞིག་ཡོད།",
    "འོན་ཀྱང་ལག་ལ་ཤོག་སྨྱུག་བཞག་ནས་ཡུལ་ལ་ཡི་གེ་འབྲི་རུ་ག་ལ་འཇུག་ཨེ་རྒྱ་སྐད་ཤེས་ན་ངོ་མ་ཕན་པ་ཡོད་ཀི་ལྟ་སྲུང་ཁང་གི་ཟ་མ་དེ་ལུག་ཤ་རྐྱང་བའི་མོག་མོག་དང་བསྡུར་ཐབས་མེད་པས་ངས་ར་ལོར་ཤ་མོག་མོག་བཟའ་རུ་བཅུག་རྒྱུ་རྐྱེན་གང་ཡིན་མི་ཤེས་ཀྱང་སྔོན་ཆད་ངའི་སེམས་ལ་མི་ཚོན་པོ་ཚོར་ད་གཟོད་བཟའ་སྟོབས་ཆེ་བ་དང་།",
    "ཡང་ན་ཁྱོད་ཀྱིས་ཀྱང་ངོ་མ་ཉེས་པ་ཅི་ཡང་བཟོས་མེད་སྲིད།",
    "རྨ་ཆུའི་ཁུག་གི་རྟ་ཟེར་བ་དེ་ངོ་མ་གཞན་དང་མི་འདྲ།",
    "ཉིན་དེར་འབྲོང་ཚང་གི་ཞབས་སོར་ཐེངས་དང་བོར་ར་ལོའི་ཁྱིམ་ལ་བཀོད་པས་ར་ལོ་དགའ་དྲགས་ཏེ་རང་གི་ཁ་ནས་ཅི་ཤོར་ཡང་མ་ཤེས།",
    "གནའ་མིའི་གཏམ་དཔེ་ལ་ར་ལོ་མོག་མོག་གིས་བརྒྱགས་རྗེས་སླར་ཡང་ཚིག་གི་བར་ཐག་ཇེ་རིང་ལ་སོང་སྟེ་ལས་ལམ་ལ་འགྲོ་གི་མེད་དུས།",
    "གཅིན་བཏང་ན་བརླ་ཤའི་སྟེང་རེད།",
    "ངས་བཟང་ས་དེ་སྣ་ནག་མ་དེ་ཚང་གི་རུ་འདབས་སུ་བསྐྱལ་རྗེས་ཕྱིར་ཡོང་བ་ཡིན།",
    "ངས་མནའ་ཅི་ཙམ་བསྐྱལ་ནའང་ཁོ་ཚོ་རློམ་གྱིན་མི་འདུག་ཁྱོད་ཀྱིས་འདང་རྒྱོབ་དང་།",
    "ང་མགོ་ནག་བོད་མི་རལ་བ་ཅན་ཞིག་གིས་མནའ་ཟ་སྲིད་དམ་ཟེར།",
    "ར་ལོ་ངེད་གཉིས་ཀྱིས་འོ་ཇ་འཐུང་ཞོར་དང་དུ་བ་འཐེན་ཞོར་དུ་སྡོད་སྐབས་ར་ལོས་ཨེ་ངའི་ཆུང་མ་ཉིན་བཅུ་ལྷག་གི་རིང་ལ་གཅིག་ཀྱང་མི་ཡོང་བ་འདི་ཅི་ཡིན་ནམ།",
    "ཁོང་མ་བུ་གཉིས་ལ་ན་ཚ་རེ་བྱུང་བཞིན་པ་མིན་ནམ་ཟེར་ནས་རིམ་བཞིན་སླར་ཡང་འདང་རྒྱག་ནང་ལ་ལྷུང་སོང་།",
    "ཁོ་ཚོའི་ཉེས་པའི་ཆེ་ཆུང་མི་འདྲ་ལ་ཐ་ན་ལ་ལར་ཉེས་པ་ཡོད་མེད་ཀྱང་ད་རུང་གསལ་ཐག་ཆོད་མེད་མོད།",
    "གང་ལྟར་ཚང་མས་འདྲ་མཉམ་དུ་རང་གིས་རང་ལ་ཉེས་ཅན་ཞེས་འབོད་དགོས་ལ་དེ་ལྟར་བོས་ན་ད་གཟོད་ཁང་འདིའི་སྒོ་ཕྱི་ཁྱིམ་དང་མཚམས་རེར་སྒོ་ཆེན་གྱི་ཕྱི་ནང་ལ་འགྲོ་ཆོག་པ་རེད།",
    "གང་རྒྱ་སྐད་ཀྱིས་རང་གིས་རང་ལ་ཉེས་ཅན་ཞེས་འབོད་པའི་ཐད་ནས་ར་ལོར་བྱང་ཆ་ཞིག་ལྡན་ཏེ།",
    "ཟེར་བའམ་ཡང་ན་ཁྱོད་ཚང་གིས་གདུགས་དཀར་ཁྲི་ཚར་གཅིག་མ་བཏོན་ན་བྱ་བ་དེ་མི་འགྲུབ་ཁོ་ཐག་རེད།",
    "རྫུན་དང་ཕྲ་མར་དགའ་བས་རེད་ཟེར།་",
    "ཁོ་རང་ལོ་བཞི་བཅུ་ལྷག་གི་འགོ་ཁྲིད་ལས་བྱེད་ཅིག་ཡིན།",
    "མང་ཚོགས་ཀྱིས་ཐེར་འདོན་གོང་ཞུ་བྱས་པ་ཨན།",
    "ཐེངས་ལྔ་ལ་སྐྲ་ཉག་གཅིག་ཀྱང་བོར་བརླག་མ་བྱུང་བར་ཕྱིར་བཏང་སོང་།",
    "ངའི་སེམས་ལ་ད་ཐེངས་རུལ་སུངས་ལ་རྒོལ་རྡུང་བྱེད་པའི་སྐབས་འདི་དང་འཕྲད་པས་ཁོ་རང་ཚང་སོང་བསམ་ནའང་ཁོ་བོར་སྣང་དོགས་སྤུ་ཙམ་ཡང་མེད་པར་བག་ཕེབས་ལྷོད་གཡེང་དུ་འདུག་པ་དང་།",
    "ཁྱོད་ཚོར་ཉེས་པ་ཡོད་ཀྱང་ཆོག་ལ་མེད་ཀྱང་རུང་།",
    "ལ་ལས་རིམ་གྲོ་རྒྱ་ཆེན་སྒྲུབ་བཞིན་ཡོད་པ་དེར་བསྟན་པ་རེད།",
    "ཚང་མས་བཟའ་བའི་སྐབས་འདིར་ཁྱོད་གཅིག་པུས་མ་ཟོས་ན་ཁྱོད་རང་དེ་བས་ཀྱང་བླུན་ཟེར་བ་དང་།",
    "ད་རུང་འཇོག་གིན་ཡོད་པས་སྐྱོན་མེད་ཟེར།",
    "ཁོས་ཚེ་དཔག་མ་གཏོགས་ང་ཚོ་ཚང་མར་ལིངྒ་རུ་འབོད་པ་དང་།",
    "ཆུ་ལེན་དུ་སོང་།"
  ]
}