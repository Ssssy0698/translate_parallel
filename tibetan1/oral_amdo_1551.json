    "ཁྱོད་ཅིའི་རྐྱེན་གྱིས་ལྟར་སྐྱེས་པ་ཤེས་སམ་ཞེས་དྲིས་པ་དང་བདག་མི་ཤེས་སོ་ཞེས་སྨྲས་པ་ནས།",
    "དེའི་ཚེ་ན་ཧུ་བརྒྱལྷའི་སྲས་མོ་རྣམས་ཀྱིས་ཇི་ལྟར་སྐྱེས་པའི་གཏམ་རྒྱས་པར་བྱས་ནས་ཀཱ་ཏྱཱ་ཡ་ན་ག་དན་བར་སོད་ངོ།",
    "བྲནམོ་དབུལ་མོས་ཀཱ་ཏྱཱ་ཡ་ན་ལ་དབུལ་བཙོངས་པའི་ལེའུ་སྟེ་བཅུ་དགུ་པའོ།",
    "ཁྱེའུའི་གཏམ་ཡང་བུམོས་ཐོས་ནས།",
    "ལྷ་ཁྱོ་ཤུག་གཉིས་དད་ཁྱིམ་བདག་ཁྱོ་ཤུག་གཉིས་ཀྱིས།",
    "གསར་ལྟ་དང་གསར་འོད་ཁྱོ་ཤུག་གཉིས་ཀྱང་ཕ་མ་ལ་རབ་ཏུ་བྱུང་བར་གསོལ་ནས་ཕ་མས་ཀྱང་གནང་སྟེ།",
    "གསར་འོད་ནི་སྐྱེ་དགུའི་བདག་མོ་ལ་གཏད་དེ།",
    "དེའི་ཁྱིམ་བདག་དབུལ་པོ་ཁྱོ་ཤུག་གཉིས་འདི་སྙམ་དུ་བསམས་སོ།",
    "བདག་གི་ཅི་ཡང་དབུལ་དུ་མེད་དོསྙམ་འསམས་ཏེ་རབ་ཏུ་མི་དགའ་ནས་ངུས་སོ།",
    "ཆུ་མ་ལ་ཡདམ་ཁོང་གཅིག་ཡོད་དེ་ཁྱོ་ཤུག་གཉིས་ཀྱི་བུམ་པ་སར་པ་ཅིག་ཀྱང་ཉོས་ནས་བུམ་པའི་ནང་ཆུ་གཅད་མས་བཀང་སྟེ།",
    "ཁྱིམ་བདག་ཁྱོ་ཤུག་གཉིས་དེར་དག་འདུན་གྱིས་སྤྱོད་པ་མཐོང་ནས་རབ་ཏུ་དགའ་མགུ་ངས་ཏེ་ཕྱིར་ཁྱིམ་དུ་དང་ངོ།",
    "ཀུན་དགའབོ་དེའི་ཚེ་དེའི་དུས་ན་དབུལ་པོ་ཁྱོ་ཤུག་གཉིས་ཆུའི་བུམ་པ་ཕུལ་བདེ་ནི་གསར་ལྷ་ཁྱོ་ཤུག་གཉིས་ཡིན་ནོ།",
    "ཆུ་བ་ཞིག་གི་འགྲམ་དུ་འདུག་སྟེ་བཙས་སྟོན་ཟོས་སོ།",
    "ནས་བུ་ཁྱེའུ་ཞིག་བྱུང་ནས་བྲནམོ་དེས་ཁུར་ཏེ་རྔོམོ་ལ་ཕུལ་ལོ།",
    "ཁྱིམ་བདག་གི་ཆུང་མས་ཁྱེའུ་དེ་བླངས་ཏེབལྟས་ན།",
    "ཁྱོད་བརྟག་པར་ཉོནཙག།",
    "རྫུའཕྲུལ་གྱི་རྐངཔ་བཞི་ཐོབ་ན་བསྐལ་པ་གཅིག་གི་བར་དུ་འཇིག།",
    "ཀུན་དགའ་བོ་འདུག་པ་ལས་ལངས་ཏེ་ཚལ་ཞག་ཏུ་སོང་ངོ།",
    "ཀུན་དགའ་བོ་སོང་བའི་འོག་ཏུ་བདུད་ཀྱི་རྒྱལ་པོ་སྔག་ཏོ་ཅན་འོངས་ཅ་ན།",
    "གང་རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞི་ཐོབ་པའིབསྐལ་པ་གཅིག་གི་བར་རུ་གནས་ཏེ་ཡད་རྫུ་འཕྲུལ་གྱི་རྐང་པ་བཞི་ཤིན་དུབསྒོམསནསད་དབཞིན་གཤེགས་པའི་སྐུ་ཚེརྡི་སྲིད་ཀྱི་བར་དུ་བཞུགས་པར་རིགས་ཞེས་ཁྱོད་ལ་དྲིསན།",
    "ཁྱོད་སོང་བའི་འོག་ཏུ་བདུད་ཀྱི་རྒྱལ་བོ་སྡིག་ཏོ་ཅན་འོངས་ཏེ།",
    "ཁྱོད་ཀྱི་ཕྱིར་བྱ་བ་ཀུན་མཛད་ཏེ།",
    "དེ་སྟེ་ཁྱོད་དུས་ལ་བབ་པར་ཤེས་ན་འཕགསཔ་ཐམས་ཅ་ད་ནི་ཞི་བས་མྱ་དན་ལས་འདའོ་ཞས་བཀའ་སུལ་ཏོ།",
    "ལན་གསུམ་གྱི་བར་དུ་སྤྱི་བོས་ལ་གཏུགས་ནས་ཐལ་མོ་སྦྱར་ཏེ་འདི་སྐད་དུ།",
    "བདག་གིས་ནང་གི་ཐམར་ཡང་བཅོམ་ལྡན་འདས་མཐོང་ངོ་ཞེས་སྨྲསནས།",
    "ཁྱོད་སོང་ལ་གྲོད་ཁྱེར་དང་གྲོང་བརྡལ་དང་།",
    "འི་ཚེན་རྒྱལ་པོ་མ་སྐྱེས་དགྲ་དར་ཁྱིམ་བདག་རིགས་ཆེ་ཞིང་མཐོ་བ་ངང་ཡོན་བདག་གི་རྣམས་དགེ་ཚུལ་གྱིས་བསྒོ་བ་ཐོས་ནས་ཐམས་ཅད་མ་དགའ་ཞང་མྱ་ངན་གྱིས་གདུངས་པར་གྱུར་ཏེ།",
    "ཆུང་ཟད་མེད་པའི་སྐྱེ་མཆེད་ཀྱི་ཏདི་ང་འཛིན་ལས་བྱུང་ནས་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་གྱི་སྐྱེ་མཆེད་ཀྱི་ཏིད་རེ་འཛིན་ལ་ཞུགས།",
    "བདག་གི་སློབ་དཔོན་ནི་མྱ་ངན་ལས་འདས་ཏེ།",
    "བདག་ཅག་གིས་སུ་ལ་གནས་བཅའ་ཞིང་སྐྱབས་སུ་མཆི་བར་བགྱི།",
    "ཀུན་དགའ་བོས་ཐལ་མོ་སྦྱར་ཏེ་བཅོམ་ལྡན་འདས་ལ་གསོལ་བ།",
    "རྒྱལ་པོ་དེ་ལ་བཙུན་མོ་སྟོད་ཕྲག་ཉི་ཤུ་ཡོད་དེ།",
    "བཙུན་མོ་ཆེ་ན་མེ་ནི་མེ་ཏོག་སྦྱིན་པ་ཞེས་བྱ།",
    "བཙུན་མོ་འབྲིང་པོ་ནི་སྤྱན་ཆེན་མོ་ཞེས་བྱ་སྟེ།",
    "སྟོན་མད་དུ་བསྡུར་ཡོད་དོ་སྙམ་རེ་བ་ཡོད་དོ།",
    "ཕྱིས་རེ་བ་མེད་དོ་སྙམབསམས་ནས།",
    "རྒྱལ་པོས་སྨྲས་པ་ད་སྟེ་ཞག་བདུན་ན་ཁྱོད་ལ་མགེ་སྦྱིན་ནོ་ཞེས་སྒོའོ།",
    "མ་གཅིག་གི་སླད་དུ་འགྲོ་བ་ཐམས་ཅད་ཡོངས་སུ་སྤང་བ་མི་རིགས་ཀྱིས།",
    "དེ་ནས་རྒྱལ་པོཆེད་པོས་བློན་པོ་དང་བཙུན་མོ་དང་སྲས་རྣམས་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེ་ལྟར་ལུས་ཆུད་ཟོས་པ་དང་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་གིས་ལུས་གྲངས་མེད་པ་ཞིག་བེར་ཡང་བསོདནམས་སུམ་གྱུར་ཏེ།",
    "བདག་གིས་འདི་ཡོངས་སུ་གཏད་པར་བྱའོ།",
    "རྒྱལ་ཕྲན་དང་བློན་པོ་དང་བཙུན་མོ་དད་སྲསརྣམས་དེ་སྐདཅེས་ཀའ་སྩལ་པཐེས་ནས་ཅང་མི་སྨྲབར་འཁོད་དེ།",
    "བདག་ལ་སྩལ་བར་ཆེད་ན་རྒྱབ་ཀྱི་སྐྱེད་མོས་ཚལ་ངུ་གཤེགས་སོ་ཞེས་གསོལ་ཏེ།",
    "དེ་ནས་རྒྱལ་བོ་དེས་ཡང་ཤིང་གི་ལྷ་ལ་བལྟས་ཏེ་སྨྲས་པ།",
    "ཁ་ཅིག་ནིརང་གི་སྐྲ་ཀུན་འབལ་ཏོ།",
    "ཐོག་མརེ་བའི་སེམས་ལྟར་མ་གྱུར་པས་མྱ་ངན་གྱིས་ཡི་མུག་སྟེ།",
    "དེ་དགི་དུས་འདིར་ཡང་ང་མྱ་ངནལས་འདའ།",
    "ཁ་ཅགི་དགེ་སྦྱོང་གི་འབྲས་བུ་བཞི་ཐོབ་པར་གྱུར་ཏོ།",
    "བུ་མོ་བཟང་ཞིང་མཛེས་པ།",
    "བདག་གི་བུ་འདིའི་ཡིད་དུ་འོང་བགཅིག་ཁྱོད་ཀྱིས་བཙལ་དགོས་སོ།",
    "བུ་མོ་ལྔ་བརྒྱ་ཞིག་འགྲོགས་ཏེ་རྩེ་བ་ལས་མེ་ཏོག་བཟང་པོ་བཏུས་ཏེ།",
    "བུ་མོ་དེ་འབའ་ཤིག་གོས་ཀྱང་མཕུད་པར་ཆུ་རྒལ་ཏོ།",
    "བདག་གིས་གོས་མ་བརྫེས་པ་ཡིན་ནོ།",
    "བུ་མོས་སྨྲས་པ།",
    "བུ་མོས་ཀྱང་དེ་བཞིན་དུ་བགྱིའོ་ཞེས་སྨྲས་པ་དདགྱེས་བོ་དེ་མ་རདས་ཏེ་འད་སྙམ་དུ་བསམས་སོ།",
    "མནའ་མ་ཆེན་མོ་དྲུག་ཅར་གྱིས་མི་ནུས་སོ་ཞེས་གསོལ་ནས།",
    "ཅིའི་ཕྱིརམོ་བདག་གིས་མས་བསྒོ་བ་ལྟར་མི་བྱེད་སྙམནས་འདི་སྐདཅེས་སྨྲས་སོ།",
    "བཙུན་མོ་ཡང་སོས་ཏེ།",
    "རྒྱལ་པོདད་བློན་པོ་རྣམས་ཀྱིས་བལྟས་ནས་གཅིག་གིས་ཀྱང་བྱེ་བྲག་མ་ཕྱེད་དོ།",
    "དཔྱདན་གཅིག་གིས་ཀྱང་མ་རྟོགས་སོ།",
    "ཅི་མངོན་ཞེ་ན་གང་མོར་གྱུར་པ་དེ་ནི་འཇམ་ཞིང་ཡདང་ལ་ཆགས་སོ།",
    "ཁྱིམ་བདག་དེ་ལ་ཁྱོད་ཀྱིས་དེ་དག་ཇི་ལྟར་རྟོགས་ཤིང་ཤེས་བཀའ་སྩལ་ཏོ།",
    "འདི་ནི་བདག་གིས་རྟོགས་པ་མ་ལགས་ཀྱིས།",
    "དེ་མི་གཅིག་གིས་མ་སྐོང་ཐུབ་པར་གྱུར་ཏོ།",
    "དག་གིས་སྔར་གསོལ་པ་འདི་བདེན་ཏེ།",
    "བློན་པོས་གསོལ་པ་བཞིན་དུ་ཁྱེའུ་དདག་གིས་ཁར་བ་བལྟསན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྒྲོམ་རེ་ཤིག་མ་དབྱཔར་ཞལ་ཟས་གསོལ་ལགས་ནས།",
    "རབ་ཏུ་དགའ་མག་རས་ནས་ཐལ་མོ་སྦྱར་ཏ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དམག་ག་དཔུང་གིས་རྒྱལ་བུ་རྒྱལབྱེད་ཀྱི་ཚལ་ཡངབསྐར་ཏོ།",
    "དེའི་ཚེ་ཡུལ་དེ་ན་རྒན་མོ་དབུལ་མོ་བུ་ཚ་ཡང་མེད་པ་བཅུ་བཞི་ཞིག་ཡོད་དོ།",
    "མི་དེ་དག་གིས་དེར་བ་ལང་གསོད་འོག་པན།",
    "རྒན་མོས་ཀྱད་དེ་བཞན་དུ་གྱུར་ཅིག་ཅེས་སྨྲས་པས།",
    "ཁྱོད་མྱུར་དུ་ཕྱིར་སོད་ལ།",
    "མཐེའུ་ཆུང་གིས་གཞུབ་རྡུ་ས་ཏེ།",
    "པད་མ་རེར་ལ་ཡར་འཁོར་ལོས་སྦྱརབའ་རྒྱལ་པོ་རན་པོ་ཆེ་སྣ་བདུན་དང་ལྡན་པ་རེ་རེ་ཡོད་པརགྱུར་ཏོ།",
    "འདོད་ཆགས་དང་ཞེ་སྡང་གི་སེམསཞི་སྟེ་གཏི་མུག་གིས་སྡོངས་པ་ཡང་བསད་པར་གྱུར་པས།",
    "བཙོ་མོ་ལྡན་འདས་ཀྱིས་དེ་སྐད་ཅེས་བཀའ་སྩལ་ནས།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིགན།",
    "དེའི་ཚེ་ན་རིགསཆེ་ཞིང་བཙུན་པའི་བུད་མེད་དག་ཅིག་དེ་ལྟ་བུ་དག་མཐོང་ནས་ཁྱམི་ལ་མི་དགའ་བར་གྱུར་ཏེ།",
    "རབ་ཏུ་བྱུང་བ་དེ་དག་ལ་ལ་ནིཤག་གི་རིགས།",
    "རེ་ལེགས་སྙམ་ནས་འདི་སྐདཅེས་བསྒོའོ།",
    "ཁྱིམ་ཐབ་དང་བུ་དང་བུ་མོར་ལྡན་པར་ལྷན་ཅིག་ཏུ་ཡིད་བཞིན་དུ་རྩེ་དགའ་ཞིང་ཚེ་འདི་ལ་ཨད་སྐྱིད་པ་མྱོང་བར་བྱས་ན།",
    "དལྟར་གྱི་བསྟན་ཏེ་བདག་ཅག་གི་ཐེ་ཚོམ་དགྲོལ་དུགསོལ།",
    "ཁོ་མོ་ཕ་མའི་ཁྱིམ་དུ་བཙར་འགྲོའོཞེམ་བྱས་ན་ཁོ་མོ་ལ་ལེགས་མོ་ཞེས་ཟེརཏེ།",
    "ཀུན་དུ་རྐྱ་དེས་ཁྱོད་ཅི་ཉེས་ན་འདི་ལྟར་ཉོན་མོངས་པར་གྱུར་ཅེས་དྲིས་ན།",
    "སྒོ་བཅག་ནས་དང་ངུ་འོངས་པ་དང་ཁོ་མོ་ཡང་བརྡེགས་བདག་གིས་བུ་བཙས་སོ་ཞེས་བྱས་ན།",
    "བུ་ཡངབསད་དེ་མར་གྱི་ནང་དུ་བརྡོསནས་ཁོ་མོ་ཡང་ཟར་བཅུག་གོ།",
    "ཁྲོམ་བསྒྲེན་མོར་འདུག་པས་ངོ་ཚ་སྟེ་ལག་པས་ནུ་མ་བཀབ་ནས་ས་ཡ་འདུག་ག།",
    "དེ་ལྟ་བུའི་རྣམ་པར་སྨིན་པ་མྱོད་བ་སྟོན་ཅིག་ཅེས་སྨྲས་པདད་དགེ་སློང་མ་ཨུད་པ་ལས་ཁྱོད་རྟག་པར་ཉོན་ཅིག།",
    "ཟླ་བ་དོན་ས་ཁྱེའུཞིག་བཅས་ཏེ་ཁྱོ་ཤུག་གཉིས་ད་ལ་བྱམས་ཤིང་སྡུག་པར་འཛིན་ཏོ།",
    "དེའི་ཆ་ན་ད་སྐདཅེས་མནའ་བོར་བའི་ཆ་ན་མ་དེ་ནི་ཁོ་མོ་ཡིན་ཏེ།",
    "དགེ་སློདམ་དེ་དག་གིས་ཡང་སྨྲས་པ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དེ་ནས་གཅིག་གིས་གཅིག་སྦྲནཔས་འཛམ་བུ་གླིང་གི་མི་ཐམསཅདའདུས་ཏེ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "རྟག་པར་ཉོན་ལ་ཡིད་ལཟུང་ཤིག་དང་ཁྱོད་ལ་བསྟན་པར་བྱའོ།",
    "རྒྱ་ལ་བྲན་ལ་སྦྱིན་ནོ་སྙམ་བསམས་ནས་རི་མོ་མཁན་མང་དུ་བསྡུས་ཏེ།",
    "རྒྱལ་ཕྲན་རེ་རེ་ལ་སྐུ་གཟུགས་རེ་རེ་བསྐུར་ཏེ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "དེ་བཞིན་དུ་ལོ་ཁྲ་ཕྲག་དུ་མ་ལེན་པ་དང་ནང་གི་སྐྱོ་བ་ཐ་མ་ལ་ལུས་དེས་སྐྱོ་སྟེ་འདི་སྙམ་དུ་བསམས་སོ།",
    "དགེ་སློང་གི་གཙང་སྦྱོར་ལ་གསར་ཕུལ་ཏེ་འདི་ནི་སྦྲུལ་གཟུག་པ་ཞིག་གི་གསེར་ལགས་ཀྱིས།",
    "སྦྲུལ་གདུག་པ་གདན་འདུགབ་དེར་སོང་ངོ།",
    "ཁྱེར་ཏེ་སོང་བ་ལས་ལམདུ་མི་གཅིག་དང་ཕྲད་དེ།",
    "དེའི་ཚེ་སྲིན་མོ་དེ་བུ་ལྔ་བརྒྱ་ག་མར་རུ་བུ་བཙས་པས་བཀྲེས་སྐོམ་གྱིས་ཉེན་ཏེ་བདེབ་འོངས་པར་མཐོང་ནས་བཟའ་བ་རག་ཟས་སོ།",
    "བྲམ་ཟོ་མོ་བདེ་བའི་ལེའུ་སྟེ་ཉི་ཤུ་དགུཔའོ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་མ་གཅིགན།",
    "བླ་གོས་ཕྲག་པ་གཅིག་དུ་བྱས་ནས་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལེགས་སུ་ཐལ་མོ་སྦྱར་ཏེ།",
    "ཀོ་དོནྱ་ཁྱོད་སྟན་ལ་འདུག་ཅིག་ཅེས་བཀའ་སྩལ་ཏོ།",
    "དེ་བཞིན་དུ་འོད་སྲུང་དང་ཤཱ་རི་འ་བྱེ་དང་མོ་དགལ་ཡན་ལ་སོགས་བཞེ་གནས་ལྔ་བརྒྱ་སྟོདཀུན་གྱིསབཅོམ་ལྡན་འདས་ལ་བསྙེན་བཀུར་བགྱིའོ་ཞེས་གསོལ་ན་ཡང་གཅིག་ཀྱང་མ་གནང་ངོ།",
    "ཚེ་དང་ལྡནཔ་ཤཱ་རིའི་བྱེདང་མོདགལ་གྱི་བུ་ཆེན་པོ་གཉིས་ཀུན་དགའབོ་ག་ང་ན་བ་དེར་སོང་སྟེ་རུང་དུ་ཕྱིན་པ་དང་ཀུན་དགའ་བོ་དང་ལྷན་ཅིག་ཏུ་ཡིད་མགུ་ཞིང་དགའ་བའི་གདམ་རྣམ་པང་མཨནས་ཕྱོགས་གཅིག་འཁོད་དོ།",
    "ཁྱོད་ལ་ཕན་པའི་དོན་ཆེར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཐུག་ཀྱང་ཀུན་དགའ་བོ་ཁྱོད་ཀྱིས་བསྟན་བཀུར་བྱ་བར་དགྱེས་ཀྱིས།",
    "ཁྱོད་ལ་ཕན་པའི་དོན་ཆེ་བར་འགྱུར་རོ་ཞེས་སྨྲས་སོ།",
    "བཙུན་པ་མོད་གལ་ཡ་ན་ཆེན་པོ་ཇི་སྟེ་བདག་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་འདོད་པ་འདི་གསུམ་གནང་ན།",
    "བདག་ཅག་གིས་བཙེམ་ལྡནའདས་ལ་བསྙེན་བཀུར་བགྱིད་པ་དང་།",
    "གདོད་བདག་གིས་བཅོམ་ལྡན་འདསྲ་ལ་བསྟེན་བ་བབ་གྱིད་པར་དད་དེ་ཞེས་མཆིའོབཙེམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "འདི་ནི་བདེ་ཞིང་གསོད་པར་མི་འགྱུར་བར་ཤེས་པའི་ཕྱིར་ཏེ་མོད་གལ་གྱི་བུ་འདི་ནི་དགེ་སློང་ཀུན་དགའ་བོ་ངོ་མཚར་རྨད་དུ་བྱུང་བའི་ཚེས་སོ་མེདའོགདེ་ནས་ཤཱ་རེའི་བུ་དང་མོད་གལ་གྱི་བུ་གཉིས་ཀྱིས།",
    "བུད་མེད་མཁས་པ་དག་ནིསེམས་ཅ་ན་དང་ལྡན་མ་ཐག་ཏུ་བུ་ཁྱེའུ་འམ་བུ་མོ་ཡིན་པར་དེས་པར་རྟོགས་པས་དེ་ཡད་ཁྱེའུ་ཡིན་པར་ཤེས་ནས་ཧྲབ་ཟེ་ལ་གཏམ་སྨྲས་སོ།",
    "དེ་ནས་སོང་སོང་བ་ལས་མུ་ཏོ་བ་དག་ཅིག་གོས་ཧྲུལ་པོ་གྱོན་ཞིང་།",
    "ཅི་ཡང་མི་བདོག་པས་སྤྲོདས་མོ་བྱེད་དེ་ཞེས་ཟེར་རོ།",
    "དེ་འོགལ་སྐྱིནཔ་ཆེན་པོ་ངོ་མཚར་དུ་གྱུར་ནས་ལྟ་མི་འདོད་པར་སོང་ངོ།",
    "ཐམསཅདཉོནམོངས་ཏེ།",
    "ནོར་དབྱིག་མང་དུ་རེད་ཅིང་ཟད་མི་ཤེས་པར་འགྱུར་ཞེས་དྲིས་པ་དང་།",
    "སྦྱིན་པཆེན་པོས་དེ་དག་གིས་སྨྲས་པ་ཐོས་ནས།",
    "རྒྱ་མཚོའ་ནང་ན་ཆུ་རླབས་དང་རྦ་ཀློང་འཁྱིལ་བ་དང་ཆུ་སྲིན་དང་ཀླུ་གདུག་པ་དང་སྲིན་མོ་དང་།",
    "ཁྱོད་ལྷེ་ཞིག་ངའི་བུར་སྐྱེས་ནས།",
    "བདག་གི་བུ་འདི་ཐོག་མ་ནས།",
    "ད་ནི་བཏང་དགོས་སོ་སྙམ་བགྲོས་ནས་བུའི་དྲུང་དུ་སོང་སྟེ།",
    "ཁྱེད་སུ་འགྲོར་དགའ་བ་རྣམས་ཀྱང་འགྲོགས་ཏེ་འདོད་གིས།",
    "འབྲོག་སྟོད་པ་ཞིག་ཏུ་ཕྱིན་ཏེ་ནུབ་མོ་དགོངས་མལ་དུ་མི་རྒོད་ཀྱིས་བཅོམ།",
    "དེ་ནས་སོང་སོང་བ་ལས།",
    "དེའིཚིན་སྦྱིན་པ་ཆེན་པོ་བྲམ་ཟེའི་སྒོར་སོང་སྟེ།",
    "བུ་མོ་འདི་ཡང་ཁྱོ་ཀྱིཆུ་མར་སྦྱིན་ཀྱིས་ལོང་ཤིག་ཅེས་སྨྲས་པ་དང་སྦྱིན་པ་ཆེན་པོས་སྨྲས་པ།",
    "ཁྱོད་ཀྱི་བུ་མོ་ཆུང་མར་ལེན་པའི་ཐུགས་མི་ཐུབ་པོ།",
    "དེ་བཞིན་དུཉི་མ་བདུན་གྱི་བར་དུ་ཉིན་རེ་ལན་རེ་ད་སྐད་སྨྲས་ནས།",
    "དེ་ནས་ཡང་ཞག་བདུན་སོང་བ་མ་ལས་རྐེདཔཙམ་ལས་མ་ནུབ་བོ།",
    "དེ་ནས་ཨངར་ཞིག་གི་དྲུང་དུ་ཕྱིན་པ་དང་ཤིང་ལ་འཛེགས་ནས།",
    "ཞག་བདུན་གྱིས་རིའི་རྩ་ཟླམོར་ཕྱིན་ཏོ།",
    "རེ་ཚེ་ར་ཞག་བདུན་སོང་སོང་བས་ཡང་ཞགབདུན་གྱིས་ཤོད་དུ་ཆུ་འགྲམ་དུ་ཕྱིན་ཏོ།",
    "ན་མ་ཡང་མི་བྱིན་པས་ཉོན་མོངས་པར་འགྱུར་གྱིས།",
    "རིང་བོ་མ་ལོན་པར་དངུལ་གྱི་མཁར་ཞིག་མཐོང་ནས་ཀླུའི་གནས་ཡིན་ནོ་སྙམ་བསམས་ཏེ་ཉེ་བར་སོང་ངོ།",
    "དེ་ལྟར་བྱམས་པའི་སེམས་སྐྱེས་པས་སྤྲུལ་གྱི་གདུག་པ་ཡང་ཞི་བར་གྱུར་ནས་སྦྲུལ་དེ་དག་བརྫིས་ཏེ་ཀྲུའིམཁར་དུ་སོང་ངོ།",
    "འཛམ་བུ་གླིང་གི་མི་དག་ནི་དབུལ་། ཕོངས་པས་ནོར་དང་གོས་དང་ཟས་ཀྱི་ཕྱིར་གཅིག་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་འཚེ་ཞིང་གནོད་པ་བྱེད་དེ།",
    "ཚེ་འཕོས་མ་ཐག་ཏུ་ངན་སོང་གསུམ་དུ་ལྟུང་དོ།",
    "ཕུལ་ནས་རོལ་མོས་བྱད་ཆུབ་སེམས་དཔའ་ལ་མཆོད་དོ།",
    "སྐྱེས་བུ་ཆེན་པོ་འགྲོ་བ་ལ་ཕན་པའི་དོན་དུ་ཡི་དམ་ཤིན་དུ་བརྟན་པ་ཁྱོད་གདོན་མི་ཟ་བར་འཚང་རྒྱའོ།",
    "བདག་ཀྱང་ཁྱོད་ཀྱི་ཉེ་གནས་མཆོག་ཏུ་གྱུར་ཅིག་ཅེས་སྨྲས་སོ།",
    "ཀླུའི་རྒྱལ་པོ་འཁོར་དང་བཅས་པས་བསྐྱལ་ཏེ་སོང་ངོ།",
    "དེ་ནས་ཡང་སོང་སོང་བ་དང་།",
    "བདག་གི་གནས་འདིལ་འོབས་རིམ་པ་བདུན་གྱིས་བསྐོར་ཏེ།",
    "ཁྱོད་འདིར་ཅི་ལ་འོངས་དོནཅི་ཡོད་ཅེས་དྲིས་སོ།",
    "སྦྲུལ་གྱི་གདུག་པ་ཡང་ཞི་ནས་དེ་ལ་བརྫིམཏེ་སོང་ངོ།",
    "མགོན་བྱ་བའི་ཕྱིར་རྒྱལབཆེན་པོ་ཁྱོད་ལ་ཡིད་བཞིན་གྱི་ནོར་བུརིན་པོཆེ་སློང་དུ་འོངས་སོ།",
    "བྱད་ཆུབ་སེམས་དཔའགདོད་དགའ་ནས་འདི་སྙམ་དུའཛམ་བུ་གླིང་གི་ཁྱོན་ནི་དཔག་ཚད་བདུན་སྟོང་ལས་མེདད།",
    "ཁྱོད་རྒྱ་མཚོ་ར་སོད་སོདན་ཅི་རེད་ཅེས་དྲིས་པ་དང་།",
    "ཉོན་མོངས་པའི་དོན་ཡོད་པར་གྱུར་ཏོ་ཞེས་སྨྲས་སོ།",
    "བུ་གླིང་གི་མིདག་ནི་དབུལ་ཕོངས་པ་ཤ་སྟག་སྟེ།",
    "འཛམ་བུ་གླིང་གི་མི་རྣམས་ལ་འདི་སྐད་ཅེས་བསྒོའོ།",
    "བདཱུ་རྱའི་མཁརགྱི་ཀླུ་ནི་མོད་གལ་གྱི་བུ་ཡིན་ནོ།",
    "ཀུན་དགའབོདགའམགུ་རངས་ནས་པུས་མོའི་ལྷུངས་ལ་བཙུགས་ཏེ།",
    "བདག་གིས་ནམ་མཚོ་འབར་དུད་བཞིན་གཤེགས་པ་ལ་བསྙེན་བཀུར་བགྱིའོ་ཞེས་གསོལ་ཏོ།",
    "དེ་ནས་དགེ་སློང་དག་གིས་སྔོན་ཇི་ལྟར་གཙོ་བོར་གྱུརཔ་བསྟན་པརག་སོལ་བདངདེ་ལབཅོམ་ལྡན་འདས་ཀྱིས་འདི་སྐདཅེས་བཀའ་སྩལ་ཏོ།",
    "དུས་ཕྱི་ཞིག་ན་བཙུན་མོ་ཆེན་མོ་ལས་བུ་གཅིག། བཙས་ཏེ།",
    "རྐང་པ་ག་ཡོན་གྱི་མཐིལ་ན་རྟའི་རི་མོ་ཡོད་པ།",
    "རྐང་པ་གཡས་ཀྱི་མཐིལ་ན་གླང་པོ་ཆེའི་རྀ་མོ་ཡོད་པ།",
    "རྐང་པ་གཡོན་པའི་མཐིལ་ན་རྟའིར་མོ་ཡོད་པ་དང་།",
    "བཙུན་མོ་ཆེན་མོ་ལས་བཙས་པ་དང་བཅུ་སྟེ།",
    "རྐང་པའི་མཐིལ་ན་གླང་པོ་ཆེ་དང་རྟའི་རི་མོ་ཡོད་པམ་ཡིན།",
    "དེ་ལ་པུས་མོ་བཙུགས་ནས་གལ་ཏེ་བདག་ཡོན་ཏན་དང་ལྡན་ཏ་རྒྱལ་པོར་གྱུར་ན།",
    "ཏེ་རྐད་པས་འགྲོན་རྐང་པའི་རྗེས་གར་རེག་པར་གསར་གྱི་བྱེ་མར་གྱུར་ཏོ།",
    "སྦོས་ཆུས་ཁྲུས་བྱས་ཏེ་གོས་སར་ང་གཙང་མ་བགོས་ནས་ལག་ནསོས་ཕོར་ཐོགས་ཏ་ཤར་ཕྱོགས་ལོགས་སུ་བུས་མོ་བཙུགས་ནས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "བཙུན་མོ་ཆེ་ན་མོ་ནྀ་ངའི་ཡུམ་ལྷ་མཛེས་ཡིན་ནོ།",
    "མུ་སྟེགས་ཅན་གྱི་སྟོན་པ་དྲུག་གི་ཐད་ངུ་སོང་ནས་དྲིས་སོ།",
    "ཤིང་གི་དྲུང་ན་ཆུ་མིག་བཟང་པོ་གཅིག་ཀྱད་ཡོད།",
    "ཉེས་ཆོལ་མ་ཉན་ཏེ་ཤིང་གི་རྩ་བའབྱིན་ཏོ།",
    "བདག་ལ་བུ་ནི་གཅིག་ཀྱང་མེད་ཀྱིས་དེའུ་རེ་ཚེ་ཟད་པས་རྒྱལ་ཕྲན་ལྔ་བརྒྱ་ཡང་གཅིགལ་གཅིག་མིཉན་ཏེ།",
    "ཁྱོད་ཀྱང་བདག་གི་རིགས་སུ་སྐྱེ་བར་ཤོག་ཅིགཅེས་སྨྲས་སོ།",
    "བདག་ཕྱི་རོལ་དུ་འཆ་གཅིང་ལྟད་མོ་ལྟར་འགྲོའོ་ཞེས་བྱས་པ་དང་།",
    "དྲིལ་བསྒྲགས་རྔ་བརྡུངས་རོལ་མོ་དང་སིལ་སྙན་དཀྲོལ་ཏེ།",
    "ཅི་ཡང་མི་འདོག་པས་སློངས་མོ་བྱེད་དོ་ཞེས་ཟེར་རོ།",
    "ཕྱིར་ཁྱིམ་དུ་འོངས་ཏེ་ཉིན་མཚན་དུསེམས་ཤིདམ་དགའནས་པའི་དྲུང་དུ་སོང་སྟེ།",
    "ཅིའི་ཕྱིར་ཁྱོད་ཟེར་བ་མི་འདཅེས་སྨྲས་སོ།",
    "དེདག་ཀྱང་དཔག་ཚ་དབརྒྱ་དང་ཉིས་བརྒྱདང་སུམ་བརྒྱ་དང་བཞི་བརྒྱ་དང་ལྔ་བརྒྱ་དང་དཔག་ཚད་སྟོང་གི་། ལ་མནས་འོངས་སོ།",
    "ཕན་ཚུན་དུ་སྐྱེས་བསྐུར་བ་དང་ཚོང་ཟོང་ཙལས་བགྱི་ཞེས་སྨྲས་སོ།",
    "ཁྱེད་དག་གིས་ཐབས་ཅི་ལེགས་སུ་བྱོས་ལ་བྲེལ་ཞིང་མི་ཁོམ་པ་ལྟར་ཐ་སྙད་ཐོགས་ཤིག་མཛོད་སྲུངས་ཀྱིས་རྒྱལ་བོ་ལས་ལུང་ཐོབ་ནས།",
    "མཛོད་སྒོ་བཅད་དེ་དོན་གེདོ་གཉེར་དུ་སོང་ངོ།",
    "དགེ་དོན་གྱིས་དེ་དག་གིས་སཔཐོས་ནས་ཞིང་རྨོས་པ་དང་རྐང་འགྲོས་སྦྲེལ་བ་དང་ལམ་རིང་པོར་ཚོང་བ་ལ་འགྲོ་བ་ནི་ངའི་ཆ་མ་ཡིན་གྱིས།",
    "ད་ནི་བཏང་དགོས་སོསྙམ་གྲོས་ནས་བུའི་དྲུང་རུ་སོང་སྟེ།",
    "རྒྱལ་བུ་ཉིད་དེའི་གན་དུ་སོང་ནས་འདི་སྐད་ཅེས་སྐུས་སོ།",
    "དེ་ནས་རྒྱལ་བུ་ཕའི་ཐད་དུ་སོང་སྟེ་རྒྱལ་པོ་ལ་འདི་སྐདཅེས་གསོལ་ཏོ།",
    "རྒྱལ་བུ་རྒྱ་མཚོར་བགྲོ་འདོད་དེ་ངེད་ཀྱིས་འགྲོར་མི་རུང་བའི་གྲོས་རེ་ལྟ་ཞིག་བཏབ་ན་མཉན་གྱིས་རྒྱལ་བུ་རྒྱ་མཚོར་འགྲོ་བའིས་མཁན་ལ་གྱོད་སོང་ནིཤིག་ཅེས་བཀའ་སྩལ་བ་དང་།",
    "རྒྱལབོས་བསམས་པ་གཞན་སོང་བ་ལས་ནུ་བོ་སོང་ན་ཕན་ཡང་སྲིད་སྙམ་ནས་ནུ་བོ་ཡང་འགྲོ་བར་ག་ནང་ངོ།",
    "ཆས་ནས་རྒྱལ་པོ་དང་བཙུན་མོ་ལསོགས་པ་ཐམས་ཅད་ཀྱིས་བསྐྱལ་ཏོ།",
    "དེབཞིན་ངུའི་མ་བདུན་གྱི་བར་རུ་ཉིན་རེ་ལན་རེ་དེ་སྐདཅེས་བསྒོ་ནས་ཐག་པ་རེ་རེ་བཅད་དོ།",
    "སྒོརད་བྱེ་བ་དང་ལྷ་མོ་ལྔ་བརྒྱས་སོ་སོ་ནས་རིན་པ་ཆེ་ཐོགས་ཏེ་འབུལ་བར་བྱེད་དོ།",
    "རེས་ཀྱིས་ཉལ་ལ་མལ་ཙེ་བྱའོ་ཞེས་སྨྲས་པ་དང་།",
    "ཕུ་བོས་ཀྱང་དེ་བཞིན་དུ་བྱའོ་ཞེས་སྨྲས་ཏེ་སྔུན་གཉིས་རེས་ཀྱིས་ཆེ་ལཅོ་བྱིད་དོ།",
    "དེ་ནམ་ཞིང་གི་ལྷཞིག་གིས་ཁྱོད་ཀྱི་ཆོ་མཱ་པན་སྡིག་དོན་ཡིན་ནོ་ཞེས་སྨྲས་སོ།",
    "ཁྱོདངའི་བིསྐྱད་མོས་ཚལ་དུ་རོལ་མོ་བྱེད་ཅིང་བསྐྱེད་མོས་ཚལ་སྲུང་ན་མི་ནུས་སམ་ཞེས་དྲིས་ན།",
    "རྒྱལ་བུད་ན་འདུག་པ་དང་ཕྲདདོ།",
    "ཡུམ་དེ་བསྐྱེད་མོས་ཚལ་དུ་འཆགས་སོ་དསོ་ངབ་ལས་རྒྱལ་བུ་དགེ་དོན་འདུག་པ་དང་ཕྲད་ནས།",
    "བདག་གི་འཚལ་མ་འདིར་སྐྱོལ་གི་པ་མི་མཆིའོ་། ཞེས་མཆེའོ།",
    "འོན་དེ་བདག་གི་ཕ་ཡིན་ནོ།",
    "གདོད་བུ་མོ་ཡང་ཆུང་མར་བྱིན་བོ་སྐད་དུ་བསྒྲགས་སོ།",
    "དེ་ནས་རྒྱལ་བུ་དགེདོན་གྱིས་སྡིག་དོན་ག་རེ་ཞེས་སྨྲས་ཟ་དང་།་",
    "བདག་གིས་སྔོན་སྦྱིན་པ་བགྱིས་ཏེ།",
    "རྒྱལ་པོའྀ་བཙུན་མོ་དེ་ནི་ད་ལྟར་དའི་ཡུམ་ལྷ་མཛེས་ཡིནནོ།",
    "དེའི་ཚེ་ན་རྒྱལ་བུའི་ཆུད་མར་གྱུར་པ་དེནི་དལྟར་སྐྱེ་དགུའི་བདག་མོ་ཡིན་ནོ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "འདི་དག་ཤེས་པར་འདོདོ་ན་ལེགས་པར་ཉོན་ཅིག་དང་ཁྱོད་ལ་བསྟན་པར་བྱའོ།",
    "རྒྱལ་བུས་མ་ཟོས་པས་སོ་སོ་ནས་ཀྱང་གི་སྒྲ་མི་སྙན་ནས་འབྲས་བླངས་ནས་ཟ་བ་ཡིན་ནོ།",
    "ཕྱི་ཞིག་ན་ལྟས་མཁན་དག་གིས་ལེ་བཅུ་གཉིས་ཀྱི་བར་དུ་ཆར་མི་འབབ་པོ་ཞེས་ལུང་བསྟན་པ་དང་།",
    "དེའི་ཚེ་ན་ཡུལདེ་ན་ཁྱིམ་བདག་ཕྱུག་པོ་ལོདས་སྤྱོད་དང་ལྡན་ན་བསྡུམས་བྱེད་ཅེས་བྱ་བའི་དྲུང་ངུ་སོང་སྟེ།",
    "ཁྱིམ་བདག་དེས་དྲང་སྲོང་ཉིས་སྟོང་གི་འཚོ་བ་སྦྱོར་བའི་ལས་མི་ཧུལྔ་བརྒྱ་བསྒོས་ནས་བསོད་སྙོམས་སྦྱོར་དུ་བཅུག་གོ།",
    "བདག་ཅག་འདེ་ལྟ་བུ་རྟག་ཏུ་ཉོན་མོངས་པར་གྱུར་པ་ནི་སྦྲང་པོ་འདི་དག་གི་ཕྱིར་རོ་ཞེས་རྒིས་སྨྲས་སོ།",
    "ཁྱི་གདུགས་ཚོད་ཀྱི་དུས་སུ་དྲང་སྲོང་དེ་དག་གི་དྲུང་དུ་སོད་ནས་སྐད་ཆེ་ནཔོ་ཕྱུར་སྟེ།",
    "གདུགས་ཚོདལ་བབ་པར་ཤེས་ཏེབ་སོང་སྙོམས་ལ་གཤེགས་སོ།",
    "ཁྱིམ་བདག་ད་ནི་ཆར་འོང་གིས་ཞིང་བདག་ཞིང་གི་ལས་བྱེད་དུ་ཆུག་ཤིག་ཅེས་བསྒོ་བ་དང་།",
    "དྲང་སྲོད་གིས་སྨྲས་བ།",
    "དེ་ལྟ་བུ་དག་མཐོང་ནས་འགྱོད་པའི་སེམས་སྐྱེས་ཏེ་བདག་ག་གིས་ནི་ཚིག་ངན་པས་འཕགས་པ་ལ་སྣདངོ་ཞེས་འགྱོད་ཚངས་བྱས་ཏེ།",
    "འཁོར་མང་པོ་རྣམས་ཁ་ཅིག་གིས་འབྲས་བུ་དདཔོ་ཐོབ་ནས།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ངུས་གཅིག་ན།",
    "དེ་དག་གིས་ཀྱང་བྲམ་ཟེ་ལོང་བ་དེ་ཁྲིདནས།",
    "ད་ནསབཅོམ་ལྡན་འདས་ཀྱིསལེགས་པ་ར་འདོས་མོ་ཞེ་མབཀའ་སྩལ་ནས་དགེ་སློང་དུ་གྱུར་ཏོ།",
    "འཛམ་བུའི་གླིང་གི་དགེ་སྦྱོང་དང་།",
    "བདག་གིས་ཕནཔའི་གྲོས་བཏབ་ན་ཁྲོསཏེ་མ་མཉནཏོ།",
    "དེ་ནས་བློན་པོ་དེས་དཔུང་གི་ཚོགས་བསྡུས་ཏེ།",
    "གལཏེ་མིག་ཐོབ་ན་བྱ་དགའ་ཡང་ཆེར་སྤྱན་ནོ་ཞེས་བསྒོ་ནས་སོང་ངོ།",
    "ན་གི་སྦྱིན་པ་བྱས་ན་འབྲས་བུ་ཆེ་སྟེ།",
    "བྲམ་ཟེ་ལ་ཁྱོད་མཀ་འདོདན་སྦྱིན་ནོ་ཞེས་བསྐོའོ།",
    "ཅིའི་སླདདུ་མིགཅིག་གི་ཕྱིར་བདག་ཅག་ཀུན་སྡོང་ཞེས་གསོལ་ཏོ།",
    "བྲམ་ཟེ་མི་ཅིག་གི་སླད་དུ་བདག་ཅག་ཀུན་མ་གླངཞིགཅེས་གསོལ་ནས་ཆོ་ངེས་འདེབས་སོ།",
    "གཏི་མུག་གིས་རྔུལ་ཕྲ་མོ་སྟོད་ཀྱིས་ལུས་ཆུད་ཟོས་ན།",
    "བདག་གིས་མིག་བྱིན་པ་འདི་ལ་འགྱོད་པ་ཡང་མང་ལ།",
    "ངས་མིག་བྱིན་པས་ཁྱོད་ཀྱང་མཐོང་བར་གྱུར་གྱིས།",
    "ཁ་ཅིག་གིས་ནི་ཀླན་མད་པའི་བྱད་ཆུབ་ཏུ་སེམས་བསྐྱེད་དོ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ཇུས་གཅིག་ན་བཅོམ་ལྡན་འདས་མཉན་ཡོད་ན།",
    "ཉོན་མོངས་པ་ཐོངས་པ་ལ་བྱམས་ཤིང་བརྩེ་བར་གྱུར་ཏེ།",
    "བྲམ་ཟེས་ཀྱང་ཁྱེའུ་མི་གདུང་བ་ཁྱོད་ཕྱིར་འདུག་ལ།",
    "ཁོ་བོ་ནི་སྦྱིན་བདག་གིས་བོས་པར་འགྲོའོ་ཞེས་བསྒོའོ།",
    "ཁོ་མོའི་ཡིདདང་སྦྱོར་ཅིག་ཅེས་བསྒོའོ།",
    "མི་གཟུངགིས་སྨྲས་པ།",
    "ཅིའི་ཕྱིར་ཁྱོད་འདི་ལྟར་གྱུར་ཅེས་དྲིས་པ་དང་།",
    "ཁོ་མོ་མ་བཏུབ་པས།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་དེ་བཞིན་དུ་བྱས་ན།",
    "ཁྱེའུ་མི་གདུངབ་བུས་མོས་ལ་བཙུགས་ཏེ།",
    "སློབ་དབོན་གྱེས་ཁྲོམ་པར་རེག་ནས་རལ་གྲི་ལག་ཏུ་བྱིན་ནོ།",
    "དོནས་ཁྱེའུའི་མ་ཉིད་ཁ་ཟས་ཐོགས་ཏེ་བུའི་དྲུང་དུ་སོང་བ་ལས།",
    "རྒྱང་མ་ནས་དགེ་སློད་ཁྱོད་ཅུང་ཟད་ཅིག་སྡོད་ཅིག་ཅེས་བོས་སོ།",
    "ཁྱོད་ཉིད་མི་སྡོད་དོ་ཞེས་བཀའ་སྩལ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ་བཞིན་དུ་བ་ལ་དམོའྀ་དྲུད་དུ་སོད་སྟེ།",
    "དཔྱད་གི་ཚིགས་འགྲོ་བའི་ལམ་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་གྱི་དྲུང་དུ་བྱུང་བས།",
    "གཙུག་ལག་ཁ་དན་དབྱངས་བྱེད་པ་དཔུད་གི་ཚོགས་ཀྱིས་ཐོས་ནས།",
    "རྒྱལ་བོས་བུས་མོ་ས་ལ་བཙུགས་ནས།",
    "བཅོམ་ལྡན་བརྒྱརེགའདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ངོས་རེ་རེ་བྱེད་དུ་བཅུག་པ་ལས།",
    "ལེ་ལོ་བྱས་པ་དེ་ལ་ཁྱོད་ཀྱིས་ལས་ལེགས་པར་མ་བྱས་པས་མ་ཟིན་ཏེ་ཆད་བས་གཅད་དོ་ཞེས་བསྒོབ་དང་།",
    "ངོས་ཅིག་གི་ལག་དཔོན་ཁྲོས་པ་དེ་ཡངཤིན་དུ་དགའ་ནས་སྔར་ཉེས་པ་རྣམས་འགྱོད་ཅིང་བཤགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱཨེ་རྐྱལ་བོ་ཆེན་པོ་ཁྱོད་གར་འགྲོ་ཞེས་བཀའ་སྩལ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་གདན་བརསོང་ནས་ཇི་ལྟར་འཁ་མས་པ་བཅོམ་ལྡན་འདས་ལ་གསོལ་བ་དང་།",
    "འདོད་ཆགས་ཀྱིས་ཉོན་ནས་སོང་སོང་བ་ལས།",
    "བཙུན་མོ་ཁྱེད་གཉིས་ལས་གང་ངའི་ཕྱི་བཞིན་མ་གྱོགས་པར་འོངས་ཏེ།",
    "བཙུན་མོ་བྲམ་ཟེའི་ད།",
    "ཕྱག་བྱས་ནས་མྱུར་དུ་སོང་བ་ལས་འཆིག་བར་གྱུར་ཏོ།",
    "གལ་ཏེ་ལྷ་ཁྱོད་ལ་མཐུ་ཞིག་ཡོད་ཡང་དག་ན།",
    "དྲང་སྲོང་གིས་སྨྲས་པ།",
    "དེཟོས་ནས་སྔོན་གྱི་ཤ་བས་ལྷག་པར་ཞིམ་མོ་ཞེས་གཡོས་མཁན་ལ་སྔོན་ཅད་ཀྱི་ཤ་འདི་ལྟ་བུ་རོ་མེདད།",
    "དཔྱད་གིཚོགས་ལའད་སྐད་ཅས་སྨྲས་སོ།",
    "བློན་པོ་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ་འདི་སྐད་ཅས་སྣུས་མོ།",
    "སྐདཅིག་བོ་ནི་ཞིག་ཁོ་བོ་བདེ་བར་སེམས་སུ་ཆུག་ལ་གདོད་སོང་ཅིག་ཅེས་བསྒོའོ།",
    "སུ་ཏ་སོ་མ་ཞེས་བགྱི་བ་ཡོན་ཏན་ཆེ་ན་པོ་དང་ལྡན་ཏེ་དེ་རེད་ན།",
    "ཁྲུས་བྱེད་དུ་སོང་བལས།",
    "རྒྱལ་པོ་ཁྱོད་ཀྱིས་བདག་འདིར་ཁྱེར་ཏེ་འོདོས་པས།",
    "བདག་གིས་བ་རྫུན་སྨྲས་སོ་སྙམ་ཏེ།",
    "ཡུལ་སྲིད་ཡིད་བརྟན་རུང་རེ་སྐན།",
    "ཡུལ་སྲིད་ལྟ་ཞིག་ཡོད་རེ་སྐན།"
  ]
}