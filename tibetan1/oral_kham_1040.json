    "ཞྐྱེས་པའི་སོན་བརོད་པ་ཡང་འདུག་གོ།",
    "དེ་ནས་བཟུང་ཀྲང་རང་དང་།",
    "དེ་དག་བཏོན་ནས་དམག་བསྡུས་རྟ་ཉོས་ནས་སྐུ་ཞབས་ཁྱེད་དང་མཉམ་དུ་དོན་ཆེན་བསྒྲུབས་ན་ཅི་འདྲ་འདུག་ཅེས་དྲིས་པར།",
    "ཞོན་ཏེས་རྟབ་རྟོབ་པོར་སྒོའི་ཕྱིར་ཕྱིན་ནས་ལྟ་སྐབས་ཤིང་སྡོང་ལ་བསྡམས་པའི་མི་དེ་སྐོར་ཞིབ་དཔོན་པོ་ཡིན་པ་ཤེས་ཤིང་ཧང་སངས་ཏེ་རྡུང་དོན་ཅི་ཡིན་དྲིས་ཙ་ན།",
    "ཀྲའོ་ཀྲུང་དང་ཀྲང་རང་གཉིས་ཀྱིས་མི་བཏང་ནས་ལ་ཐོད་སེར་པོ་བ་བཅོམ་མཁན་དམག་དཔོན་རྣམས་ཀྱི་ས་ནས་གསེར་དངུལ་གོས་ཆེན་བསྡུ་རུ་བཅུག་ཅིང་།",
    "ཅན་ཧྲུའོ་ཡིས་ཁྱེད་གསོད་རྩིས་བྱེད་ཀྱི་འདུག་ཅེས་བཤད།",
    "ཀྲང་རང་སོགས་ཀྱིས་རོགས་རམ་མ་བྱས་ན་ད་ལྟའི་སྟོབས་འབྱོར་མངའ་ཐང་འདི་ལྟ་བུ་ཡོང་ག་ལ་སྲིད།",
    "དེ་འཕྲལ་ཡོན་ཧྲོ་ཁོང་ཁྲོ་མེ་ལྟར་འབར་ནས་སྐད་ཆེན་པོས་ཉུག་རུམ་འཁོར་དཔོན་ཚོས་བློན་ཆེན་བསད་འདུག་མི་ངན་ཚར་གཅོད་བྱེད་འདོད་མཁན་ཚོ་ང་ལ་དཔུང་རོགས་བྱེད་པར་ཤོག་ཅེས་འབོད་སྒྲ་བརྒྱབ།",
    "ཀྲང་རང་དང་།",
    "ཀྲང་རང་དང་ཏོན་ཀུའེ་གཉིས་ཀྱིས་གོང་མ་སྲས་ཆུང་དང་རྒྱལ་པོ་ཁྲེན་ལིའུ་ཝང་བཙན་ཁྲིད་ཀྱིས་མེ་མཚོ་དང་དུ་སྤྲིན་བརྒལ་ཏེ་མཚན་བརྒྱབ་ནས་པེ་མང་རི་བོར་ཕྱིན།",
    "ཀྲང་རང་ནི་ཐར་ས་མེད་པ་ཤེས་ནས་ཆུ་ནང་དུ་མཆོངས་ཏེ་རང་སྲོག་བཏང་།",
    "ཁྱེད་ཀྱིས་བལྟས་ན་ཅི་འདྲ་འདུག་ཅེས་དྲིས་པར།",
    "ཕྱི་ཉིན་མི་ཞིག་ཡོང་ནས་ཏིང་ཡོན་དམག་དཔུང་ཁྲིད་ནས་ལྕགས་རིའི་ཕྱི་རོལ་དུ་འཛིང་བར་སླེབས་འདུག་ཅེས་ཞུས་པས།",
    "ཏུང་ཀྲོས་གནམ་གྱི་དགོངས་པ་དང་འགལ་ནས་གོང་མ་གནས་དབྱུང་བཏང་བ་ལ་ཀུན་གྱིས་བཟོད་མི་ཐུབ་པའི་ཁོང་ཁྲོ་བྱེད་ཀྱི་འདུག་སྐུ་ཞབས་ཁྱེད་ཀྱིས་དེའི་བྱ་ལོག་སྤྱོད་ལོག་མཐོང་ཡང་མ་མཐོང་བའི་ཚུལ་གྱིས་རང་དགར་བཞག་པ་དེ་རྒྱལ་ཁབ་ལ་སྲི་ཞུ་བྱེད་མཁན་བློན་པོ་ཞིག་ཏུ་བརྩིས་ཆོག་གམ།",
    "ཚང་མས་བློ་གཡེང་བྱེད་བཞིན་པའི་སྐབས་དེར་དམག་དཔོན་ཆུང་ཆུང་ཞིག་ཡར་ཡོང་ནས་ལུའེ་པུའུ་འཛིང་བར་སླེབས་འདུག་ཅེས་ཞུས།",
    "དཔོན་བློན་རྣམས་ཀྱི་ནང་ནས་གུང་བློན་ཆེན་པོས་བརྩི་བཀུར་བྱེད་ས་དམག་དཔོན་ཁྱེད་རང་ལས་མེད།",
    "ད་གཟོད་ཉེན་ལས་ཐར་ཞེས་ཟེར་གྱི་འདུག་བློན་པོ་ངས་སྐད་ཆ་དེ་ཚོར་བསམ་བློ་གཏོང་དུས་ནུབ་ལ་ཧན་གཅིག་བཙུགས་ཟེར་བ་ནི་གོང་མ་ཀའོ་ཙུའུ་ཡིས་ནུབ་ཕྱོགས་ཀྱི་ཁྲང་ཨན་དེ་ཧན་རྒྱལ་རབས་ནུབ་མའི་རྒྱལ་ས་བྱས་ནས་རྒྱལ་སྲིད་གཅིག་རྒྱུད་གཉིས་རྒྱུད་ཀྱིས་གོང་མ་སྐུ་ཐོག་བཅུ་གཉིས་བྱུང་བ་དེར་ཟེར་ཞིང་།",
    "ངས་སྐར་དཔྱད་བྱས་པ་ལྟར་ན་གོང་མའི་ལས་སྐལ་ནུབ་ཕྱོགས་སུ་འཕོས་འདུག་པས་ངས་གོང་མ་བསུས་ནས་ནུབ་ཏུ་སྐྱོད་རྒྱུ་ཡིན།",
    "ཐམ་ག་རྙེད་ཀྱང་རང་མགོ་ཆུ་འདྲེན་ལས།",
    "དེང་སྐབས་ཀྱང་པུན་ཁྲུའུ་ཡིས་ལིའུ་པིའོ་དང་ལྐོག་འབྲེལ་བྱས་ནས་ཡུལ་ཅང་ཏུང་དུ་དཔུང་འཇུག་བྱེད་རྩིས་བྱེད་ཀྱི་འདུག་པས་སྐུ་ཞབས་ཁྱེད་ཀྱིས་གང་མགྱོགས་ཅི་མྱུར་དུ་དམག་དཔུང་ཁྲིད་ནས་ལིའུ་པིའོ་ལ་ཕར་རྒོལ་གནང་དང་།",
    "དེ་ཡང་སྔོན་ལ་ངས་ཁྱེད་རང་ལུའེ་པུའུ་ཡི་མནའ་མར་སྟེར།",
    "གུང་བློན་ཁྱེད་ཀྱི་མཛད་རྗེས་དང་སྙན་གྲགས་ནམ་མཁར་མི་ཤོང་བ་ཞིག་ཡོང་བ་འདུག་དེས་ན་གནམ་གྱི་སྲས་ཧྲུན་གྱིས་གནམ་གྱི་སྲས་ཡིའོ་ཡི་ས་ནས་རྒྱལ་སྲིད་བཞེས་པ་དང་།",
    "ཡང་ཏུང་ཀྲོས་ད་ལྟ་ངས་ཁྱེད་ལུའེ་པུའུ་ལ་སྟེར་ན་ཅི་འདྲ་འདུག་ཅེས་དྲིས་པས།",
    "འཕུང་འདྲེ་ཁོའི་ཤ་རྗེན་ཟ་བྱས་ཀྱང་ངའི་ཡིད་ཚིམ་ཐུབ་པ་མི་འདུག་ཅེས་བཤད།",
    "སྒྲ་གདངས་ཀྱང་སྐྱོ་སྣང་ཧ་ཅང་ཆེ་བས་ཏུང་ཀྲོས་ལི་ཞུ་ལ་བྱིས་པའི་གླུ་ཚིག་དེའི་ཐོག་ནས་ལྟས་གང་འདྲ་ཞིག་མཚོན་གྱི་འདུག་ཅེས་དྲིས་ཤིང་།",
    "དེ་ལས་ཧྲན་ཞིའི་མི་དམངས་དང་རང་འོག་དམག་དཔུང་གཡོ་ཁྲིད་ཀྱིས་ཁྲང་ཨན་དུ་བཤར་ཏེ་ཏུང་ཀྲོའི་དགྲ་ཤ་བླངས་ན་ལེགས།",
    "སྨི་ཀྲུའུ་ཡིས་ཨམ་ཕྲག་ནས་ཐའོ་ཆན་གྱི་འཕྲིན་ཡིག་བཏོན་ཏེ་ཕུལ་ནས་ཚའོ་ཚའོ་ཡིས་ལྕགས་རི་བསྐོར་ཏེ་ཚུར་རྒོལ་དྲག་པོ་བྱེད་ཀྱི་འདུག་པས་སྐུ་ཞབས་ཁྱེད་ཀྱིས་གང་མགྱོགས་སུ་ཉེན་སྐྱོབ་གནང་རོགས་ཞེས་ཞུས།",
    "དེང་སང་ཚའོ་ཚའོ་ཡིས་ཆེ་བས་ཆུང་གནོན་གྱིས་མི་སེར་རྣམས་ལ་བརྙས་བཅོས་ཐུབ་ཚོད་འཛེམ་བག་མེད་པར་བྱེད་ཀྱི་འདུག་པས་ང་གཉིས་མཉམ་དུ་ཉེན་སྐྱོབ་བྱེད་པར་ཕྱིན་ན་མི་ལེགས་སམ་ཞེས་དྲིས་པར།",
    "དེར་མ་ཟད་ཡི་གེའི་ནང་ང་ལ་ཁྱད་གསོད་བྱེད་པའི་སྐད་ཆ་ཡང་འདུག་ཡི་གེ་སྐྱེལ་མཁན་དེ་བསད་ནས་ཕར་རྒོལ་དྲག་པོ་གྱིས་ཤིག་ཅེས་བཀའ་ཕབ།",
    "དེ་བྱུང་ན་ང་ཤི་ནའང་བློ་བདེ་བོ་ཡོང་བ་འདུག་ཅེས་བཤད།",
    "ལུའེ་པུའུ་ཡིས་ངས་སླར་ཡང་ཡོན་ཧྲོ་ལ་རྒྱབ་རྟེན་བཅོལ་བར་འགྲོ་དགོས་བསམ་གྱི་འདུག་ཁྱེད་ཀྱིས་བལྟས་ན་ཅི་འདྲ་འདུག་གམ་ཞེས་དྲིས་པར།",
    "དམག་དཔོན་སྟོབས་ལྡན་མང་པོ་ཡོད་མཁན་ཞིག་ཏུ་གྱུར་འདུག་པས་ཁོ་རྒྱལ་སར་བཀུག་ནས་རྒྱལ་སྲིད་སྐྱོང་དུ་བཅུག་ན་ལེགས་ཞེས་ཞུས་པར།",
    "སྐབས་དེར་མི་ཞིག་ཡོང་ནས་ལི་ཅོ་དང་ཀོ་སིས་དམག་དཔུང་ཁྲིད་ནས་སླེབས་གྲབས་འདུག་ཅེས་སྙན་སེང་ཞུས་པས་གོང་མ་དངངས་སྐྲག་ཆེན་པོ་སྐྱེས་ནས་དབྱང་ཧྥུན་ལ་ཡུལ་ཧྲན་ཏུང་དུ་བཏང་བའི་ཕོ་ཉ་ད་དུང་ལོག་མ་བྱུང་།",
    "ལི་ཅོ་དང་ཀོ་སིའི་དམག་དཔུང་སླེབས་གྲབས་འདུག་ད་ཇི་ལྟར་བྱེད་དགོས་ཞེས་དྲིས་པར།",
    "ཕོ་ཉ་དེ་ཁ་སྒོ་སྐྱེ་འབྲས་མཚར་ཞིང་ལུས་སྟོབས་རྒྱས་པོ་ཡོད་པ་མཐོང་སྟེ་སེམས་ལ་ད་ལོ་རྒྱལ་ས་ཤར་མའི་རྒྱུད་དུ་མུ་གེ་བྱུང་ནས་དཔོན་དམག་ཚང་མ་བཀྲེས་ལྟོགས་ཀྱིས་མནར་ནས་ཤ་སྐམ་སྟོབས་ཞན་ཤ་སྟག་ཏུ་གྱུར་འདུག་ཀྱང་།",
    "ཚའོ་ཚའོ་ཡིས་དམག་དཔུང་བསྡུས་ནས་དམག་སྒར་དུ་ལོག་དུས་མན་ཁྲུན་གྱིས་ཞུ་ཧོང་ཁྲིད་དེ་མཇལ་བར་ཡོང་བས་དགའ་སྤྲོ་ཧ་ཅང་ཆེན་པོ་བྱུང་སྟེ་བྱ་དགའ་གྱ་ནོམ་པ་སྤྲད།",
    "ཉེ་སྔོན་དམག་ཕམ་པའི་ལུའེ་པུའུ་ཡང་ཞའོ་ཕི་མཁར་དུ་སྡོད་དུ་བཅུག་འདུག་གལ་སྲིད་ཁོ་གཉིས་གཅིག་སྒྲིལ་གྱིས་ཚུར་རྒོལ་བྱེད་པར་ཡོང་ན་ཆག་སྒོ་སློང་ངེས་ཡིན་པས་ངའི་བློ་བདེ་བོ་མི་འདུག་སྐུ་ཞབས་ཁྱེད་རྣམས་ལ་དེའི་ཁ་གཏད་འཇལ་ཐབས་བཟང་པོ་ཅི་ཡོད་ཅེས་དྲིས།",
    "འོན་ཀྱང་ང་ད་དུང་བློ་བདེ་པོ་རང་ཡོང་བ་མི་འདུག་ཁྲེན་ཡོན་ལུང་ཁྱེད་ཀྱིས་ལྟ་སྐྱོང་གང་གཟབ་བྱས་ནས་ཁོས་ཆང་མང་པོ་མི་འཐུང་བ་དང་།",
    "ངའི་མ་རྒན་དང་བཅས་པའི་མི་ཚང་མ་ཡུལ་དེའི་ཆུས་ཨར་ཡོད་པས་དེའི་དམར་གསོད་འཁེལ་ཉེན་ཡང་འདུག་དེར་བརྟེན་ངས་དམག་དཔུང་གོ་ཐང་སྟོང་ཕྲག་ཁ་ཤས་ཞིག་གཡར་ནས་འབྲི་ཆུ་བཅད་དེ་གཉེན་ཉེ་སྐྱོབ་པར་འགྲོ་རྩིས་ཡིན་པས་ཁྱེད་ཀྱིས་གཏོང་རོགས་གནང་།",
    "མི་ཞིག་ཡར་ཡོང་ནས་ཀྲང་དབྱིན་ལ་དམག་སྒར་ནང་དུ་མེ་རྒྱག་མཁན་འདུག་ཅེས་སྙན་སེང་ཞུས།",
    "ཐའེ་ཧྲི་ཚིའི་སེམས་ལ་འཕུང་འདྲེ་ཁོ་ལ་འཁོར་དམག་བཅུ་གསུམ་འདུག་ང་ནི་མི་གཅིག་མ་གཏོགས་མེད།",
    "རམ་འདེགས་དཔོན་ཆེན་ཀྲང་ཀྲིའོ་ཡིས་དགྲ་བོའི་གནས་གཞི་ཀྲོའུ་ཡུས་ཀྱིས་བླངས་པའི་རྐྱེན་གྱིས་ངར་ཤུགས་ཉམས་འདུག་དོ་ནུབ་ལྐོག་རྒོལ་བྱས་ན་ལེགས་ཞེས་བཤད།",
    "སྐབས་དེར་མི་ཞིག་ཡར་ཡོང་ནས་ཅི་ལིན་སླེབས་འདུག་ཅེས་སྙན་སེང་ཞུས་པས་ཞོན་ཏེ་དངངས་སྐྲག་ཆེན་པོ་སྐྱེས་ཏེ་གཡོལ་བསམས་ཀྱང་ལུའེ་པུའུས་བཀག་ནས་ངས་ཆེད་དུ་ཁྱེད་རྣམ་པ་གཉིས་ཀ་གདན་དྲངས་ནས་ལྷན་དུ་བཀའ་གྲོས་ཞུ་བསམ་གྱི་ཡོད་པས་ཐུགས་དོགས་གནང་མི་དགོས་ཞེས་བཤད།",
    "ཅི་ལིན་གྱིས་དམག་དཔོན་ཆེན་པོ་ཁྱེད་ཀྱིས་ང་གསོད་བསམ་གྱི་འདུག་གམ་ཞེས་དྲིས་པར།",
    "ཚའོ་ཚའོ་ཧ་ཅང་དགའ་ནས་སྐུ་ཞབས་ཁྱེད་ཀྱི་གསུངས་པ་དེ་རྣམས་ངའི་བསམ་ཚུལ་དང་ཡོངས་སུ་མཐུན་གྱི་འདུག་ཅེས་བཤད།",
    "ཧན་ཞན་གྱིས་ཤུགས་རིང་ནར་ནར་དུ་འབྱིན་བཞིན་པར་ངས་ཧན་གོང་མར་རྒྱབ་རྟེན་བཅོལ་བསམས་ཀྱང་མགོ་འདྲེན་བྱེད་མཁན་མི་འདུག་ཅེས་བཤད།",
    "ཁོ་གཉིས་ཀྱིས་དམག་དཔུང་བཏང་ནས་དམངས་ལ་འཕྲོག་བཅོམ་ཚོད་མེད་བྱས་སྟབས་དམངས་ཀྱི་སྡུག་སྐད་ཀྱིས་རི་ལུང་གང་འདུག་དེར་བརྟེན་ངས་དོན་ཆེན་བགྲོ་གླེང་བྱེད་རྒྱུར་བསྙད་དེ་གསོལ་སྟོན་ཞིག་བཤམས་ནས་ཁོ་གཉིས་བོས་ཏེ་ཆང་འཐུང་བའི་སྐབས་སུ་ཀོན་ཡུས་དང་ཀྲང་ཧྥེ་གཉིས་ལ་བརྡ་བཏང་ནས་གསོད་དུ་བཅུག་ཐོག་ཁོ་གཉིས་ཀྱི་དམག་མི་ཡོད་ཚད་ཀྱང་ཚར་གཅོད་བྱས་ཟིན།",
    "ཚུལ་དེ་ཚའོ་ཚའོ་ཡིས་ཤེས་རྗེས་ལྐོག་ཏུ་ཝང་ཧེའུ་བོས་ནས་ངས་ཁྱེད་ཀྱི་ས་ནས་དངོས་པོ་ཞིག་གཡར་ཏེ་དམག་མི་ཚོ་ཁོང་ཁྲོ་བསང་ཐབས་བྱེད་བསམ་གྱི་འདུག་པས་ཁྱེད་ཀྱིས་སེར་སྣ་མ་བྱས་པར་ཅིས་ཀྱང་གཡར་རོགས་གནང་ཞེས་བཤད།",
    "ལུའེ་པུའུས་དམག་དཔུང་ཁྲིད་དེ་ཞུ་ཀྲོའུ་རུ་ལོག་རྗེས་ཚའོ་ཚའོ་ཡིས་ལྐོག་ཏུ་ཞོན་ཏེ་ལ་ངས་ཁྱེད་རང་ཞའོ་ཕིར་སྡོད་དུ་བཅུག་པ་འདི་ནི་དོང་རྙི་བཙུགས་ནས་སྟག་འཛིན་པའི་ཐབས་བཀོད་སྒྲུབ་ཆེད་ཡིན།",
    "དེ་གཉིས་ཀྱི་མགོ་འབུལ་བར་སླེབས་འདུག་པར་མ་ཟད།",
    "ཏོན་ཝེས་ད་དུང་ལི་ཅོའི་ཁྱིམ་མི་རྒན་གཞོན་ཉིས་བརྒྱ་ལྷག་ཙམ་ཞིག་ཀྱང་ཞུ་ཏུའུ་རུ་གསོན་ཁྲིད་བྱས་འདུག་ཅེས་སྙན་སེང་ཞུས།",
    "ཞུན་ཡུས་ཀྱིས་སྐུ་ཞབས་ཀོ་ལགས་ཀྱིས་གསུངས་པའི་དགེ་མཚན་བཅུ་དང་སྐྱོན་ཆ་བཅུ་པོ་དེ་ངའི་རྨོངས་འཆར་དང་ཡོངས་སུ་མཐུན་གྱི་འདུག་ཡོན་ཧྲོའི་དམག་མི་མང་ཡང་སྐྲག་དགོས་དོན་ཡེ་ནས་མེད་ཅེས་བརྗོད།",
    "གཏིང་ནས་མ་རུང་ཁོག་བཅུག་བྱེད་ཀྱི་འདུག་པས་དོགས་ཟོན་གནང་ན་ལེགས་ཞེས་ཞུས་ཀྱང་།",
    "ཁྱེད་རང་སྐུ་གཟུགས་བདེ་ངོཡིན་ནམ་ཞེས་དྲིས།",
    "ཚའོ་ཚའོ་ཡིས་ཁ་ཕྱིར་འཁོར་ནས་ཞོན་ཏེ་ལ་ཁྱེད་ཀྱིས་བལྟས་ན་ཅི་འདྲ་འདུག་ཅེས་དྲིས་པར་ཞོན་ཏེས་ཏིང་ཅན་དབྱང་དང་།",
    "ངས་གོང་མ་གདན་དྲངས་ནས་རི་དྭགས་རྔོན་པར་ཕྱིན་ཏེ་གནས་ཚུལ་ཅི་འདྲ་འདུག་ཚོད་བགམ་ཞིག་བྱས་ཆོག་ཅེས་བཤད།",
    "སྐེ་རགས་དེ་བཅིངས་ནས་འཁོར་གཡོག་རྣམས་ལ་ལྟ་བཞིན་རིང་ཐུང་ཆེ་ཆུང་ཅི་འདྲ་འདུག་ཅེས་དྲིས་པར་འཁོར་གཡོག་ཚོས་ཧ་ཅང་རན་པོ་འདུག་ཅེས་ཞུས།",
    "ཚའོ་ཚའོ་ཡིས་ཏུང་ཁྲེན་ལ་གོང་མའི་ཞང་པོ་ཁྱེད་ཀྱིས་ཕྱུ་པ་དང་སྐེད་རགས་འདི་ང་ལ་གནང་ན་ཅི་འདྲ་འདུག་ཅེས་ཟེར་བར་ཏུང་ཁྲེན་གྱིས་འདི་གོང་མས་གསོལ་རས་གནང་བ་ཞིག་ཡིན་པས་གཞན་ལ་འབུལ་མི་ཕོད།",
    "འོན་ཀྱང་ཕངས་པ་ཞིག་ལ་ང་ལ་རོགས་རམ་བྱེད་མཁན་མི་འདུག་ཅེས་བཤད།",
    "ཏུང་ཁྲེན་གྱིས་མི་གཞན་གྱིས་མཐོང་མི་འདུག་ང་གཅིག་པུས་མཐོང་བྱུང་ཞེས་བཤད།",
    "ཞོན་ཏེ་དངངས་འཚུབ་འཚུབ་ཏུ་གྱུར་ཏེ་དོན་དག་ཛ་དྲག་པོ་གང་ཞིག་འདུག་གམ་ཞེས་དྲིས་པར་ཞུ་ཁྲུའུ་ཡིས་གུང་བློན་ཆེན་པོས་ཁྱེད་རང་གདན་འདྲེན་དགོས་གསུངས་པ་ལས་དོན་དག་ཅི་ཡོད་གསུངས་མ་བྱུང་ཞེས་ལན་བཏབ།",
    "ཕྱི་ཉིན་དེར་ཡང་ཚའོ་ཚའོ་ཡིས་ཞོན་ཏེ་གདན་དྲངས་ནས་ཆང་འཐུང་བཞིན་པའི་སྐབས་སུ་མི་ཞིག་ཡར་ཡོང་ནས་མན་ཁྲུན་གྱིས་ཡོན་ཧྲོའི་གནས་ཚུལ་རྩད་ཞིབ་བྱེད་པར་ཕྱིན་ནས་ཕྱིར་འཁོར་འདུག་ཅེས་སྙན་སེང་ཞུས།",
    "དམག་དཔོན་གཡུལ་དུ་ཞུགས་ཙ་ན།",
    "ཐབས་བྱུས་པ་ཐེན་ཧྥུན་གྱིས་ལོ་བསྟུད་མར་དམག་བརྒྱབ་པས་དམངས་རྣམས་ངལ་དུབ་ཀྱིས་མནར་ཞིང་འབྲུ་མཛོད་སྟོང་པར་གྱུར་འདུག་པས་སླར་ཡང་དཔུང་ཆེན་ཁྲིད་ནས་དམག་རྒྱག་པར་འགྲོ་མི་འོས།",
    "ཚའོ་ཚའོ་ཡིས་ངའི་མངའ་འོག་ཏུ་དེང་དུས་ཀྱི་དཔའ་བོ་ཕུལ་བྱུང་བཅུ་ཕྲག་ཁ་ཤས་ཡོད་པར་མི་གཅིག་ཀྱང་མི་འདུག་བརྗོད་དོན་ཅི་ཡིན་ཞེས་དྲིས་པར་སྨི་ཧུན་གྱིས་དེ་རྣམས་སུ་ཡིན་གསུང་རོགས་གནང་དང་།",
    "ཡོན་པུན་ཁྲུའུ་ཡིས་ཀྱང་ཕོ་ཉ་བཏང་འདུག་པས་སུ་ལ་སྐྱབས་བཅོལ་ན་ལེགས་ཞེས་དྲིས་པར།",
    "དགའ་སྤྲོའི་ངང་ནས་ཁོ་ལ་དོན་ཆེན་དེ་སྒྲུབ་ཐུབ་པ་འདུག་ཅེས་བཤད།",
    "ཚའོ་ཚའོ་ཁྲོས་ནས་བཙོན་སྲུང་རྣམས་ལ་དྲག་རྡུང་བྱེད་དུ་བཅུག་དུས་ཚོད་གཉིས་ཙམ་བརྡུངས་མཐར་ཤ་ཆད་ལྤགས་རལ་དུ་གྱུར་ཅིང་།",
    "ཚའོ་ཚའོས་དར་དཀར་པོའི་ཐོག་ཏུ་ཡི་གེ་གང་ཞིག་བྲིས་འདུག་ཅེས་དྲིས་ཀྱང་།",
    "དང་པོ་ཐུག་དུས་མགྲོན་དུ་བཀུར།",
    "དོན་ཆེན་ལ་འཐུས་ཤོར་ཡོང་བ་ཞིག་བཟོ་བསམ་གྱི་འདུག་གམ།",
    "ལྕམ་ཀན་ལགས་དང་སྨི་ལགས་གཉིས་སྐུ་གཟུགས་བདེ་པོ་འདུག་གམ་ཞེས་དྲིས།",
    "ཀོན་ཀུང་ཡིད་མུག་ནས་གཅིག་པུར་བསྡད་ཡོད་པའི་སྐབས་སུ་ཀྲང་ལིའོ་ཡོང་ནས་གཅེན་པོ་ཁྱེད་ཀྱིས་གཡུལ་སའི་ཐོག་ཞོན་ཏེའི་གནས་ཚུལ་མཁྱེན་འདུག་པར་ངས་ཆེད་དུ་བཀྲ་ཤིས་བདེ་ལེགས་ཞུ་བར་བཅར་བ་ཡིན་ཞེས་བརྗོད།",
    "ཀོན་ཀུང་རང་གཅིག་པུར་བསམ་བློ་གཏོང་བཞིན་བསྡད་པའི་སྐབས་སུ་གྲོགས་པོ་མཇལ་བར་ཕེབས་པའི་བརྡ་འབྱོར།",
    "ཁྲེན་ཀྲེན་གྱིས་ཞོན་ཏེས་ཁྱེད་ཧ་ཅང་དྲན་གྱི་འདུག་པས་སྐུ་ཞབས་ཁྱེད་ཀྱིས་དམ་ཚིག་བརྩི་ན་གང་མགྱོགས་ཅི་མྱུར་དུ་མཇལ་བར་ཕེབས་ན་ལེགས་ཞེས་སྨྲས།",
    "ཚའོ་ཚའོ་ཡིས་བལྟས་ཏེ་ཧང་སངས་ནས་ཨ་ཙིཡུན་ཁྲང་ཕྱིན་འདུག་ཅེས་བཤད།",
    "གནས་ཚུལ་ག་འདྲ་འདུག་ཅེས་དྲིས་པའི་ལན་དུ་སུན་ཆན་གྱིས་དམག་དཔོན་ཆེན་པོ་ཁྱེད་དཔུང་དམག་ཁྲིད་དེ་ཕྱིར་ཤིང་།",
    "ཕོ་ཉ་དེས་གནས་ཚུལ་དེ་ད་དུང་མཁྱེན་མི་འདུག་ཅེས་ལན་བཏབ།",
    "ཀྲང་ལིའོ་ཡིས་ཞོན་ཏེ་གང་དུ་ཡོད་མིན་མི་ཤེས་ན་བསྐྱར་དུ་གུང་བློན་ཆེན་པོ་མཇལ་བར་ཕྱིན་ན་ག་འདྲ་འདུག་ཅེས་དྲིས་པས།",
    "ཁྱེད་ལ་རྒྱབ་རྟེན་བཅོལ་འདོད་ཀྱང་ཆེན་པོ་བྱེད་ཀྱི་འདུག་ཅེས་ལན་བཏབ།",
    "ལྕམ་ཀན་གྱིས་མི་གཅིག་གཉིས་མཉམ་དུ་ཁྲིད་ཀྱང་སྐྱོན་མི་འདུག་ཅེས་བཤད།",
    "རྗེ་བོ་ཞོན་ཏེ་ཧོ་པེར་ཕེབས་འདུག་པ་ཤེས་བྱུང་།",
    "སྐུ་ཞབས་ཁྱེད་ཀྱང་ང་དང་མཉམ་དུ་ཕེབས་ན་ཅི་འདྲ་འདུག་ཅེས་དྲིས་པར།",
    "ཧ་ཅང་བརྗིད་ཉམས་ཆེན་པོ་ཞིག་འདུག་ཅེས་ལན་བཏབ།",
    "ཞོན་ཏེས་ང་ཙིལུང་དང་ཐོག་མར་ཐུག་དུས་ནས་བློ་བབ་ཡིད་སྨོན་གྱིས་འབྲལ་མི་འདོད་པ་བྱུང་།",
    "ཀོ་ཅ་གཅིག་པུས་ཁྱེད་ལ་སྣང་ཆུང་བྱེད་ཀྱི་འདུག་ཅེས་ཞུས།",
    "དགྲ་དམག་ཧྲག་ཀྱང་རང་དམག་ལྟ་བུའི་དམག་རྒྱགས་མང་པོ་མེད།",
    "མདའ་སྐྱེན་པའི་དམག་མི་ལྔ་སྟོང་རུ་སྒོའི་དམག་དར་གྱི་རྒྱབ་ཏུ་གབ་ཏུ་བཅུག་སྟེ་མེ་སྒྱོགས་འཕེན་པའི་བརྡ་བཏང་མ་ཐག་དུས་གཅིག་མདའ་རུབ་རྒྱག་དགོས་པ་མངག་ཆ་བྱས་ནས་བསྡད།",
    "ཚའོ་ཚའོ་ཡིས་མི་སུ་བཏང་ན་ལེགས་ཞེས་དྲིས་པར་ཞུན་ཡིའུ་ཡིས་ཞུ་ཧོང་རང་བཏང་ན་ལེགས་ཞེས་ལན་བཏབ།",
    "ད་བྱས་དུས་དངོས་གནས་རང་ཡིན་འདུག་ཅེས་བཤད།",
    "ཞུ་ཧོང་དང་ཡུས་ཅིན་རྒྱབ་ཏུ་བཞག་ཁོ་རང་དང་དམག་དཔོན་གཞན་རྣམས་དཀྱིལ་དུ་ཞུགས་ཏེ་ཡོན་ཧྲོའི་དམག་དར་སྒྲེང་ཞིང་།",
    "མང་དུ་འདུག་ཀྱང་།",
    "དེས་ན་སྐྱོན་གཉིས་པ་དང་གསུམ་པའང་རང་གྲོལ་ཡིན་ཏེ།",
