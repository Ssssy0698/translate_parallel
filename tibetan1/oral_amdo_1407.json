    "གི་ཝང་ཙན་དན་དཀར་བོ་ཅུ་གུར་ལི།",
    "གྲང་མོ་འདོད་ཅིང་བསིལ་སྙེག་རྔུལ་ཁ་སྙི།",
    "གདོང་སེར་ལྕེ་རྙིལ་སེན་མོའི་བཀྲག་མདངས་ཉམས།",
    "མགྲོན་བུ་གསུམ་གྱི་ཐལ་བ་བཅས།",
    "དེ་དུས་མ་མོ་མཁའ་འགྲོ་ཀུན་འཁྲུགས་ཏེ།",
    "གཅིག་གྲོགས་གཅིག་གིས་བྱེད་ཅིང་གྲོས་ཁ་མཐུན།",
    "བརྒྱུད་ལྡན་སློབ་དཔོན་མཁས་པའི་གསུང་གི་རྒྱུན།",
    "གཉན་རིམས་གདུག་པའི་སྲུང་བ་ཟབ་མོ་ནི།",
    "འཇིགས་རུང་ཕག་རྒོད་ཕོ་མོ་ལྟོ་སྦྱར་པ།",
    "སྐལ་བཟང་ཁོ་བོ་ཅག་གི་དཔལ་དུ་ཐོབ།",
    "བསྙེན་པ་འབུམ་ཕྲག་སོང་བས་དངོས་གྲུབ་ཐོབ།",
    "དེ་ནས་ཟབ་གསང་མཁའ་འགྲོའི་བརྡ་ཤོག་གི།",
    "ཤིན་ཏུ་ཟབ་པ་ཤ་བ་རི་དམར་མོས།",
    "བལ་ཡུལ་ཕག་མོའི་ཕུག་པ་ནས་བསྩལ་པ།",
    "གསང་རྒྱ་ཟབ་མོ་བསྒྲགས་པར་ཅུང་མ་སྤོབས།",
    "རྒྱས་པར་གཟིགས་འདོད་གཏེར་བརྒྱའི་མཛོད་དུ་ཚོལ།",
    "འགག་མེད་རྟེན་འབྱུང་སྒྱུ་མའི་རི་མོ་ནི",
    "ཆེད་དུ་མ་གཉེར་ཞལ་གཟིགས་ལུང་གིས་བསྔགས",
    "སྨིན་གྲོལ་གདམ་པའི་བསྙེན་སྒྲུབ་ཚད་དུ་འཁྱོལ།",
    "རིང་འཚོའི་སྲོག་གི་ནོར་བུ་ཁོ་ན་ཡང་།",
    "ན་མོ་རཏྣ་ཏྲ་ཡཱ་ཡ།",
    "བུ་མོ་གཞོན་ནུས་བཀལ་བ་ཡི།",
    "ཡང་ན་གོང་གི་རྩ་སྔགས་ཤམ་བུ་རུ།",
    "རེས་འགའ་དར་ལྕེ་བཞིན་དུ་སྤུར།",
    "ཉེས་ལེན་རེས་འཇོག་སྣ་ཚོགས་ཚུལ་དུ་སྟོན།"
  ]
