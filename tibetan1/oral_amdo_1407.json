    "རྡོ་ཐལ་སྟར་བུ་ཀ་ར་སྦྱར་ལ་བཏང་།",
    "གོ་སྙོད་རྡོ་ཐལ་བཅས་སྦྱར་བྱེའུའི་བྲུན།",
    "ཟན་དྲོན་དུགས་ཀྱིས་བག་རེ་བདུག་པར་བྱ།",
    "གྲང་སྐྲན་མ་ལུས་ཐལ་བར་རློག་པར་བྱེད།",
    "ཐལ་བ་བུ་རམ་སྦྱར་པ་ཆུ་བསྐོལ་དབུལ།",
    "འབུར་ན་འཇག་གིས་མཐའ་ནས་བསྡམས་ལ་བཙིར།",
    "དན་རོག་དན་ཁྲ་མགྲོན་བུའི་ཐལ་བ་རྣམས།",
    "གྲང་མོ་ཁེངས་པ་གྱོང་དང་སྔོ་ངད་དང་།",
    "མེ་ཉིའི་ཚ་རེག་མི་བཟོད་མེ་དྲོད་ཞན།",
    "བུད་མེད་ཤ་ཆང་སྲེད་ཆེ་རྨི་ལམ་འཁྲུགས།",
    "རེག་བྱ་གྲང་ཞིང་མཐེབ་རྗེས་ལེན་པ་དང་།",
    "ཁྱད་པར་ཆང་གི་བཏུང་བ་ལོ་དུས་སྤངས།",
    "གཉན་ཤས་ཆེ་ན་སྟག་མོ་ཁ་རལ་ཟངས་རྩི་དཀར་བོའི་འབྲུ་མཆོག།",
    "མ་གི་ཏ་དང་དྲི་ཆེན་བ་ཆུའཡ།",
    "རྐང་བའི་མཐེ་བོང་ལག་པའི་གྲུ་མོར་གནས།",
    "མཁྲིས་གྱུར་དྲོད་ཆེ་དམར་ལ་རེག་མི་བཟོད།",
    "དྲེག་གི་རྩ་ནི་སྣ་ཐུང་མཁྲང་ལག་གྲིམས།",
    "དྲེག་གི་ཆུ་ལ་ངེས་མེད་ཚད་པ་འདྲ།",
    "དྲེག་གི་ཕྱི་ཡུལ་རྐང་ལག་སྐམ་ཁོལ་བྱེད།",
    "རྒྱམ་ཚྭ་ཐལ་ཚྭ་ཟེ་ཚྭ་ཁ་རུ་ཚྭ།",
    "བསྐོལ་བ་ཚན་མོར་བྱུགས་པས་འཇོམས།",
    "ལུག་གི་སློ་ལུམས་བསྟེན་པས་འཕྲལ་ཟུག་གཅོག།",
    "ཡང་ན་གོ་བོའི་བྱ་ཐལ་བྲེ་ཕྱེད་ལ།",
    "རྒྱམ་ཚྭ་པི་ལིང་གུར་ཀུམ་དབྱི་མོང་དང་།",
    "སོ་མ་རཱ་ཛཱ་སྦྱར་པས་སྦྱོང་གིས་དྲངས།",
    "ཡང་ན་རྐང་ལག་བཞི་བོ་ན་རེས་བྱེད།",
    "ནུབ་མོ་ན་ཞིང་མགོ་སྤུ་བྱི་བའོ།",
    "གི་ཝང་བཟང་དྲུག་གེ་སར་རྣམ་པ་གཉིས།",
    "མཆིན་བབས་གི་ཝང་།",
    "གི་ཝང་དགུ་དང་གུར་ཀུམ་བདུན།",
    "གྲུམ་བུའི་ཟུག་གཅོག་ཆེན་མོ་ནི།",
    "ཐལ་རྡོར་གི་ཝང་བ་ལེ་ཀ།",
    "བསྲེགས་ཐལ་བཏབ་པས་སྐད་ཅིག་ལ།",
    "འདི་ལ་དངུལ་ཆུ་མུ་ཟི་གུ་གུལ་གསུམ་ཐུན་རེ།",
    "དེ་ནས་དཔྱི་རྐེད་པུས་མོ་ཚིགས་ལ་འབབ།",
    "དེ་རྗེས་འབྲས་གསུམ་ཞོ་གསུམ་རེ་སྤྱི་བཞུར་ཞོ་བཞི་སྤང་རྒྱན་དཀར་ཞོ་བཞི།",
    "གི་ཝང་ཞོ་བརྒྱད་སོ་མ་ར་ཞོ་བརྒྱད་དང་ཐལ་ཀ་རྡོར་ཞོ་བརྒྱད།",
    "བ་ལེ་ཀ་ཞོ་བཞི་དང་གེ་སར་རྣམ་པ་གཉིས་ཞོ་བཞི་རེ།",
    "གླ་ཞོ་བཞི་སྤོས་ཞོ་བརྒྱད་མགྲིན་བཟང་མཚལ་སྲང་གང་བསྣན་ཉིན་ཞག་རེར།",
