    "གཤིན་རྗེར་ཕྱོགས་པ་དང་རྩེ་མོ་ནུབ་ཏུ་བལྟ་བ་དང་།",
    "དེ་ནས་ཐབ་ཁུང་དུ་རྩེ་མོ་ཤར་དུ་བསྟན་པའི་ཀུ་ཤ་བ་ལང་གི་རྣ་བ་ལྟ་བུ་ཧ་ཅང་མི་རིང་བས་གཡོགས་སོ།",
    "མངོན་སྤྱོད་ཀྱི་ཐབ་ཁུང་རྣམས་སུ་རིམ་པ་བཞིན་དུ་རྩེ་མོ་བྱང་དང་ནུབ་དང་ལྷོར་བསྟན་པ་རྣམས་ཏེ་དང་པོར་གཡོན་གྱི་ཁ་ཁྱེར་ལ་ཀུ་ཤ་གཉིས་ཀྱི་རྩེ་མོ་ཡང་དེ་ལྟར་རོ།",
    "མཛུབ་མོས་མེ་ཏོག་བླངས་ནས་ནི།",
    "མཐེའུ་ཆུང་སྲིན་ལག་གུང་མོ་དང་།",
    "མཛུབ་མོ་རིམ་གྱིས་དགྲོལ་ཞིང་དབུལ།",
    "གཉིས་པའི་དུང་གི་ཆུ་ཡིས་ནི།",
    "ལན་གསུམ་བསྐོར་བའི་སོར་མོ་ནི།",
    "མཛུབ་མོ་གུང་མོ་མིང་མེད་དང་།",
    "རྒྱས་པར་ནི་ཨོཾ་ཨཱ་ཛ་ཧཱུཾ་ཞེས་པ་འདིས་བཀུག་ནས་ཐབ་ཁུང་གི་མེའི་ཕྱོགས་ཀྱི་ལོགས་ན་ཀུ་ཤའི་ཆུན་པོ་ལ་འདུག་པ་ལ།",
    "དེ་བཞིན་དུ་དྲག་པོའི་ལས་ལ་ནི་དུག་དང་བཅས་པའི་ཚ་བའི་མར་ནག་གིས་གང་བའི་དགང་གཟར་གཡས་ཀྱིས་བཟུང་ཞིང་གཡོན་པས་བླུགས་གཟར་ཡང་སྟེ་དགང་གཟར་བླུགས་གཟར་གྱི་ཁ་ལ་རང་གི་ལྷའི་ས་བོན།",
    "མེ་ལྷའི་ཞལ་དུ་རཾ་རྣམ་པར་བཀོད་ལ་དགང་གཟར་གྱི་ཁར་བླུགས་གཟར་གྱི་ཁ་བཞག་སྟེ་ལག་པ་གཉིས་པུས་མོའི་ནང་དུ་དང་།",
    "དྲག་པོ་ལ་གཡོན་སྐོར་བྱས་ཏེ་ཡོན་བདག་གི་ནུས་པ་ཇི་ལྟ་བས་དགང་བླུགས་ལན་གསུམ་མམ་ལན་བདུན་དབུལ་བར་བྱ་སྟེ།",
    "ཨོཾ་ན་མ་ས་མནྟ་བུད་ྡྷཱ་ནཱཾ་ཨགྣ་ཡེ་སྭཱ་ཧཱ།",
    "འཆད་པར་འགྱུར་བའི་རང་རང་གི་སྔགས་ཀྱིས་ཡམ་ཤིང་དང་།",
    "རང་གི་གཟུགས་ཀྱིས་མེའི་ཕྱོགས་སུ་གཞག་པར་བྱའོ།",
    "མངོན་སྤྱོད་ལ་གདན་ནག་པོ་ལ་སོགས་པ་དང་ལྡན་པ་ཁྲོས་པ་བསྒྲུབ་བྱའི་སྟེང་དུ་རྡོ་རྗེ་མེའི་ཆར་ཕབ་ནས་བསྒྲུབ་བྱ་ཐལ་བར་བྱེད་པའོ།",
    "དེ་བཞིན་དུ་ལས་ཐམས་ཅད་པ་ཉིད་རང་གི་ལྷག་པའི་ལྷ་ཉིད་ལས་དང་རྗེས་སུ་མཐུན་པའི་རྣལ་འབྱོར་དང་ལྡན་པའམ།",
    "མི་དང་ཉ་ལ་སོགས་པའི་ཞག་གི་མར་མེ་རྣམས་དང་།",
    "མར་ལ་སོགས་པ་རྫས་རྣམས་རེ་རེའི་སྲེག་བླུགས་གསུམ་མམ་བདུན་ནམ་ཉེར་གཅིག་བསྲེགས་ཏེ་བདུད་རྩི་དང་བཅས་པ་མར་གྱི་སྲེག་བླུགས་ཅི་ལྟར་སྙེད་པ་བསྲེག་པར་བྱའོ།",
    "རང་གི་འདོད་པའི་ལྷ་རྣམས་ཐབ་ཁུང་དུ་གོ་རིམས་ཇི་ལྟ་བ་བཞིན་དུ་བཀོད་ལ།",
    "བདག་ཉིད་ཀྱང་རང་གི་ལྷག་པའི་ལྷའི་རྣལ་འབྱོར་དང་ལྡན་པའམ་ཡང་ན་ཐབ་ཁུང་དུ་བཞུགས་པའི་ལྷའི་རྣལ་འབྱོར་དང་ལྡན་པར་བྱའོ།",
    "དེ་ནས་ཞི་བ་ལ་རང་སྔགས་ཀྱི་མཐར་ཆེ་གེ་མོའི་ཤཱིནྟཾ་ཀུ་རུ་སྭཱ་ཧཱ།",
    "ཅེས་པ་ལ་སོགས་པའི་ཚིག་དྲེགས་པ་དང་བཅས་ཤིང་ང་རོ་ཆེན་པོ་དང་བཅས་པ་རང་གི་སྔགས་ལ་རང་གང་འདོད་པའི་མིང་སྤེལ་བཅུག་པའམ་ཡང་ན་མ་བཅུག་པར་རང་བཞིན་གྱིས་ཞི་བ་ལ་སོགས་པའི་བསམ་པས་ལྷག་པར་མོས་པར་བཟླས་ཤིང་སྲེག་རྫས་རྣམས་བརྒྱའམ་སྟོང་ངམ་དཔག་ཏུ་མེད་པ་བསྲེག་པར་བྱའོ།",
    "ཡང་ན་ཐབ་ཁུང་གི་དབུས་སུ་རང་བཞིན་གྱིས་གནས་པའི་དེ་བཞིན་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་རང་བཞིན་གྱི་མེ་ལྷའི་ཐུགས་ཀ་ཁོ་ནར་རང་གིས་བོན་ལས་བྱུང་བའི་རང་གི་འདོད་པའི་ལྷའི་བདག་ཉིད་དམ་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོའམ།",
    "ཕུན་སུམ་ཚོགས་པའི་དོན་དུ་ཞོ་ཟན་དང་འབྲས་མཆོག་གིའོ།",
    "ཨ་མྲའིའོ།",
    "སེང་ལྡིང་གིའོ།",
    "དེ་ནས་བསང་གཏོར་དང་ཞབས་བསིལ་དང་གོས་གསར་པ་དང་རྡོ་ཐལ་མེད་པའི་སོ་རྩི་དང་དྲག་པོའི་ལས་ལ་རྡོ་ཐལ་དང་བཅས་པ་ཕུལ་ལ་སྔར་བཞིན་མཆོད་ནས་ཡང་དག་པར་བསྟོད་དེ།",
    "ཞེས་བྱ་བས་ཡང་དག་པར་བསྐུལ་ནས་རང་གི་སྔགས་ཡི་གེ་གསུམ་གྱི་ནང་དུ་བྱས་པའི་མཐར་ཡི་གེ་མུ་ཞེས་པ་བརྗོད་ཅིང་རང་གི་བདག་པོའི་མགོན་པོ་ཡིད་ཀྱིས་ཆོ་ག་བཞིན་དུ་གཤེགས་སུ་གསོལ་བར་བྱའོ།",
    "སླར་ཡང་དག་པར་མཆོད་ནས་བསང་གཏོར་དང་ཞབས་བསིལ་དང་རྡོ་ཐལ་མེད་པའི་སོ་རྩི་དང་།",
    "དྲག་པོ་ལ་རྡོ་ཐལ་དང་བཅས་པའི་སོ་རྩི་དང་གོས་གསར་པ་ཕུལ་ལ་སྲེག་རྫས་ལྷག་མ་སྦྱིན་སྲེག་བྱས་ནས་མཐར་དྲིལ་བུ་དཀྲོལ་ཞིང་བསྟོད་པར་བྱའོ།",
    "གང་གི་ཚེ་དེ་ལྟར་འཇིག་རྟེན་པའི་ལྷ་རྣམས་ཐབ་ཁུང་དུ་དགོད་པར་འདོད་ན་ཡང་།",
    "དེ་ནས་སྦྱིན་སྲེག་གི་ཐབ་ཀྱི་ཐལ་བ་དང་སོལ་བ་རྣམས་ལས་ཐམས་ཅད་པའི་བུམ་པར་བླུགས་ལ་ཆུ་བོ་ལ་སོགས་པའི་ཆུ་ལ་བསྐུར་བར་བྱའོ།",
    "འདི་ནི་ཕྱི་རོལ་གྱི་སྦྱིན་སྲེག་གི་ཆོ་གའོ།",
    "འདི་ནི་ཡིད་ཀྱི་སྦྱིན་སྲེག་གི་ཁྱད་པར་ཅིག་གོ།",
    "སྦྱིན་སྲེག་གིས་ཚིམ་པར་བྱའོ།",
    "ཞེས་ཡིད་ཀྱི་སྦྱིན་སྲེག་གི་ཆོ་གའོ།",
    "རང་གི་འདོད་པའི་ལྷའི་རྣལ་འབྱོར་དང་ལྡན་པས་དེའི་ངོ་བོའམ་རྡོ་རྗེ་སེམས་དཔའི་རང་བཞིན་རིམ་པ་ཅི་ལྟ་བར་རང་བཞིན་གྱིས་རྣམ་པར་དག་པའམ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རང་བཞིན་གཟུགས་ལ་སོགས་པའི་འདོད་པའི་ཡོན་ཏན་རྣམས་ཅི་ལྟར་རྙེད་པ་ལ་ཐེ་ཚོམ་མེད་པར་ཉེ་བར་ལོངས་སྤྱད་པར་བྱའོ།",
    "ཞེས་པས་ཕྱི་རོལ་གྱི་རྫས་ཀྱིས་ནང་གི་སྦྱིན་སྲེག་གོ།",
    "ཕྱི་རོལ་གྱི་རྫས་ལ་མ་ལྟོས་པའི་ནང་གི་སྦྱིན་སྲེག་མཆོག་ཏུ་དགའ་བ་ཕུན་སུམ་ཚོགས་པའི་རྒྱུ་ནི་དཔལ་ཁ་སྦྱོར་གྱི་རྒྱུད་ཀྱི་འགྲེལ་པར་ཁོ་བོས་གསལ་བར་བྱས་པས་དེར་ཤེས་པར་བྱའོ།",
    "གང་ཡང་རྣལ་འབྱོར་དང་རྣལ་འབྱོར་མའི་རྒྱུད་ཁ་ཅིག་ཏུ་ཆོ་གའི་དབྱེ་བ་ཅུང་ཟད་ཐ་དད་པ་བསྟན་པ་དེ་ཡང་འདི་དག་གི་རྗེས་སུ་འབྲངས་ནས་ཇི་ལྟར་རིགས་པར་བྱའོ།",
    "བུད་ཤིང་མར་གྱིས་རབ་སྦར་ཏེ།",
    "ཨ་མྲ་ཨརྒ་ཚངས་ཤིང་དང་།",
    "འགྲོ་བས་རྡོ་རྗེ་འཆང་གི་སྐུ་ཡི་ཕུན་སུམ་ཚོགས་པ་རབ་ཏུ་ཐོབ་གྱུར་ཅིག།",
    "ཅེས་པ་སྦྱིན་སྲེག་གི་ཆོ་ག་འོད་ཀྱི་སྙེ་མ་ཞེས་བྱ་བ།",
    "ཨཱཪྻ་བུད་ྡྷཨ་ནུ་སྨྲྀ་ཏི།",
    "སྐུ་མཚུངས་པ་མེད་པ་འདོད་པ་དག་གིས་མགོས་པ།",
    "གཟུགས་དག་གིས་ཉེ་བར་མ་གོས་པ།",
    "འདི་དག་ནི་དེ་བཞིན་གཤེགས་པའི་ཡང་དག་པའི་ཆེ་བའི་ཡོན་ཏན་མོ་དམ་ཚིག་གསུམ་གྱི་རྒྱལ་པོའི་སྒྲུབ་པའི་ཐབས།",
    "འགྲུལ་འཇུག་གིས་རྣམ་པར་དབེན་ཞིང་ཡིད་དགའ་བར་གྱུར་པ་ལ་སྔགས་པས་གནས་པར་བྱས་ལ།",
    "དེ་ནི་སྔགས་རྣམས་ཐམས་ཅད་འབུམ་ཕྲག་རེ་རེ་བཟླས་པ་བྱས་པར་འགྱུར་རོ།",
    "ཨོཾ་ཨ་ས་མ་ས་མ་ས་མནྟ་ཏོ་ཨ་ནནྟཱ་བཱ་ཏི་ཤཱ་ས་ནི་ཧ་ར་ཧ་ར་སྨ་ར་སྨ་ར་ཎ་བི་ག་ཏ་རཱ་ག་བུད་ྡྷ་དྷེ་རྨ་ཏེ་ས་ར་ས་ར་མ་སཱ་བཱ་ལཱ་ཧ་ས་ཧ་ས་ས་ཏྲ་ཡ་ས་ཏྲ་ཡ་ག་ག་ན་མ་ཧཱ་བཱ་ལ་ར་ཀྵཎེ་ཛྭ་ལ་ཛྭ་ལ་ན་སཱ་ག་རེ་སྭཱ་ཧཱ།",
    "བཟང་པོའི་སྤྱོད་པ་བདག་གིས་སྤྱད།",
    "ལག་པ་གཡས་པའི་ཐལ་མོ་གྱེན་དུ་བསླངས་ལ་མཐེ་བོང་གིས་མཛུབ་མོའི་རྩེ་མོ་མནན་པའི་ལྷག་མ་རྣམས་ནི་རྡོ་རྗེའི་མཚན་ཉིད་དོ།",
    "ཏྲཱ་ཊ་ཨ་མོ་གྷཙཎྜ་མ་ཧཱ་རོ་ཥ་ཎ་སྭཱ་ཊ་ཡ་ཧཱུཾ་ཏྲ་མ་ཡ་ཏྲ་མ་ཡ་ཧཱུཾ་ཊ་ཊུ་ཧཾ་མཾ།",
    "གཉིས་ཀའི་སོར་མོ་རྣམས་སྤེལ་ནས་ནང་དུ་བཀུག་པས་ཁུ་ཚུར་བཅངས་ཏེ།",
    "གུང་མོ་གཉིས་རྩེ་གཅིག་ཏུ་ཕྱིར་བསྐྱེད་ལ་མཛུབ་མོ་གཉིས་ཀྱང་མཐེ་བོང་གི་རྩེ་མོས་ཅུང་ཟད་མ་རེག་པར་མནན་ལ་གཟུང་བར་བྱའོ།",
    "དེ་ནས་སྐྱིལ་ཀྲུང་གིས་ལེགས་པར་གནས་ལ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་འདི་བཅིང་བར་བྱ་སྟེ།",
    "ཐལ་མོ་སྦྱར་བ་སྤྱི་བོའི་སྟེང་དུ་བཞག་པ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "ཨ་ཏི་བ་ལི་ན་མོ་སྟུ་བ་ར་སིད་ྡྷི་དཱ་ཡ་ཀེ་བྷྱོ།",
    "ཏྲི་ཤི་ཁཱ་གྲི་ན་མོ་སྟུ་སྟེ།",
    "སྲིན་ལག་དང་མཐེའུ་ཆུང་དག་ནང་དུ་བཅུག་པའི་སྙིམ་པ་བྱས་ལ་མཐེའུ་ཆུང་གཉིས་ཕྱིར་བརྐྱང་ལ་རྩེ་མོ་སྦྲང་དེ་སྲིན་ལག་གཉིས་བཀུག་པ་དེའི་སྟེང་དུ་མཐེ་བོང་གཉིས་ཅུང་ཟད་མ་རེག་པར་དགོད་དོ།",
    "གུང་མོ་གཉིས་སྦྱར་ནས་བསྒྲེང་བ་དེའི་ལོགས་ཀྱི་ཚིགས་གསུམ་བར་མཛུབ་མོ་ཅུང་ཟད་བཀུག་པས་བཀོད་པ་ནི་ཟླ་མེད་པ་ཞེས་བྱ་བའི་ཕྱག་རྒྱའོ།",
    "མཐེའུ་ཆུང་གཉིས་དང་མཐེ་བོང་གཉིས་ལུ་གུ་རྒྱུད་ཀྱི་རྣམ་པ་གཞན་རྣམས་ཀྱི་རྩ་བ་དང་བར་དང་རྩེ་མོ་ལེགས་པར་སྦྱང་བ་ནི་རྡོ་རྗེ་མི་ཐུབ་པའོ།",
    "སྐྱིལ་ཀྲུང་བཅས་ལ་ཐལ་མོ་གཡོན་བ་བཀན་པའི་སྟེང་དུ་ཐལ་མོ་གཡས་པ་ཁ་ཡར་ལྟ་བ་ལེགས་པར་བཞག་པ་ནི་རྡོ་རྗེ་གདན་གྱི་ཕྱག་རྒྱའོ།",
    "ཐལ་མོ་མཉམ་པར་སྦྱར་བ་མཛུབ་མོ་གཉིས་དང་སྲིན་ལག་གཉིས་ཀྱི་ཚིགས་དབུས་མ་བཅག་ནས་ནང་དུ་བཀུག་སྟེ་ལེགས་པར་བཅུག་པས་ཀ་བའི་རྣམ་པར་རོ།",
    "སྙིམ་པ་གདངས་པའི་སྲིན་ལག་གཉིས་ནང་དུ་དགུག་གུང་མོ་གཉིས་རྩེ་སྤྲང་ནས་བསྒྲེང་བའི་ཚིགས་གསུམ་པ་ལ་མཛུབ་མོ་གཉིས་རྡོ་རྗེའི་རྣམ་པར་བཀོད་པའི་ལོགས་ལ་ཡང་མཐེ་བོ་གཉིས་སྦྱར་བ་ནི་ར་བའི་ཕྱག་རྒྱའོ།",
    "ཐལ་མོ་མཉམ་དུ་སྦྱོར་ལ་སྲིན་ལག་གཉིས་དང་མཛུབ་མོ་གཉིས་རྒྱབ་སྤྲད་ལ་ནང་དུ་དགུག་གོ།",
    "གུང་མོ་རྩེ་སྤྲད་ལ་བསྒྲེང་དེ་བཞིན་དུ་མཐེའུ་ཆུང་དང་མཐེ་བ་མོ་དག་ཀྱང་བྱས་པ་ནི་གུར་གྱི་ཕྱག་རྒྱའོ།",
    "མི་འཇིགས་པའི་ཕྱག་རྒྱར་བྱས་པའི་རྒྱབ་ཏུ་གཡོན་པ་སོར་མོ་རྣམས་ཀྱི་བཀབ་ལ།",
    "ལག་པ་གཡས་པ་ཁ་ཚུར་བཅངས་པའི་མཛུབ་མོ་བསྒྲེང་བས་གཡས་སུ་བསྐོར་བར་བྱའོ།",
    "ཨཱ་ཨ་མ་ལ་བི་ཀྲཱ་ན་ཏ་ཏེ་ཛི་ནི་ཨ་ར་ཛེ་སྭཱ་ཧཱ།",
    "མཚུངས་པ་མེད་པའི་བདག་གི་དྲི་དམ་པ་འདི་ནམ་མཁའི་དབྱིངས་དག་ཆེར་ཁྱབ་པས་བཅོམ་ལྡན་འདས་ལ་འཕྲོ་བའི་དོན་ཐམས་ཅད་སྒྲུབ་པ་སྭཱ་ཧཱ།",
    "མེ་ཏོག་གི་སྔགས་ནི།",
    "རྩེ་མོའི་དྲི་མཆོག་གི་རྩེ་མོར་གྱུར་པའི་སྤོས་ཀྱི་རྩེ་མོ་སྭཱ་ཧཱ།",
    "མཆེད་ཅིང་འབར་བའི་མར་མེའི་སྣང་བའི་རྩེ་མོ་སྭཱ་ཧཱ།",
    "ཨ་ར་ར་པ་ར་ར་ཀ་ར་ར་གཏོར་མ་བཏང་ཞིང་བདག་གིས་གཏོར་མ་དབུལ་པའི་གཏོར་མ་ཆེན་པོ་སྭཱ་ཧཱ།",
    "གཞན་ཡིད་གང་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ན་ལྷ་དང་མི་རྣམས་ཀྱི་གཟུགས་དང་སྒྲ་དང་དྲི་དང་རོ་དང་རེག་བྱ་ལ་སོགས་པ་རྣམས་ཐམས་ཅད་ཀྱང་སྟེ།",
    "སརྦ་ཏྲ་སཾ་ཀུ་རུ་མི་ཏཱ་བྷི་ཛྙཱ་ར་ཤི་ནི་ན་མོ་སྟུཏྟེ་སྭཱ་ཧཱ།",
    "དེ་ནས་འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ཐམས་ཅད་ཀྱི་བདག་གི་དངོས་པོ་དང་མཚུངས་པར་ཐམས་ཅད་ལ།",
    "ཀུན་དུ་བཟང་པོའི་སྐུ་ལ་སོགས་པ་དག་པ་མཐར་ཐུག་གི་བར་གྱི་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་ཕུན་སུམ་ཚོགས་པ་ཐམས་ཅད་ལེགས་པར་ཐོབ་པར་མཛད་དུ་གསོལ་ཞེས་ཀྱང་བསམས་ལ་རིག་བའི་རྒྱལ་པོ་འདི་ལན་བརྒྱད་ཀྱི་བར་དུ་རྗེས་སུ་བརྗོད་པར་བྱ་བ་ནི།",
    "ལག་པ་གཉིས་ཕན་ཚུན་དུ་རྒྱབ་སྦྲེལ་བས་གཤིབས་པའི་སོར་མོའི་རྩེ་མོ་གྱེན་དུ་བསྟན་ལ་མཛུབ་མོ་གཉིས་དང་མཐེའུ་ཆུང་གཉིས་ཀྱང་ལུ་གུ་རྒྱུད་དུ་དགོད་ཅིང་གུང་མོ་གཉིས་དང་སྲིན་ལག་དག་ཀྱང་བསྒྲེང་བའི་བར་དུ་མཐེ་བོང་གཉིས་བཅུག་པ་ཁ་གྱེན་དུ་བསྟན་ལ་བཟུང་བ་ནི་ཡི་གེ་བརྒྱ་པའི་ཕྱག་རྒྱའོ།",
    "ཐལ་མོ་ཁ་སྦྱར་དུ་བྱས་ཏེ་མཛུབ་མོ་གཉིས་ཀྱིས་མཐེ་བོང་གཉིས་རྩེ་མོ་ལ་རེག་པར་བྱས་ལ་ལྷག་མ་ནི་དེ་ཁོ་ན་ཉིད་བཞིན་དུ་ཁབ་ཀྱི་རྣམ་པར་རོ།",
    "ལག་པ་གཉིས་མཉམ་པོར་བཀན་ནས་བརྐྱང་ལ་སྲིན་ལག་དང་མཛུབ་མོ་ལག་པའི་ནང་དུ་སེན་མོས་སེན་མོ་གཏུགས་པ་ལ་མཐེ་བོང་གི་རྩེ་མོ་དགུག་གོ།",
    "གུང་མོ་ནི་དེ་ཁོ་ན་ལྟར་སེན་མོའི་རྩེ་མོ་མཉམ་པོར་སླང་ངོ།",
    "དེ་ཉིད་ལ་མཛུབ་མོ་བཤུགས་ལ་སེན་མོས་སེན་མོ་ལ་ཅུང་མ་རེག་པའི་མཎྜལ་གྱི་རྣམ་པ་སྟེ།",
    "རང་གི་ཕྱག་རྒྱ་དང་སྔགས་ཀྱང་ལན་ཅིག་བརྗོད་པས་དམ་ཚིག་བརྟན་པར་བྱའོ།",
    "རང་གི་ཕྱག་རྒྱ་རྣམས་ཀྱང་ཅི་རིགས་པར་རིག་པར་བྱའོ།",
    "ཆོ་ག་འདི་ཉིད་ཀྱང་ཉི་མ་རེ་རེ་ཞིང་འབུམ་ཕྲག་བཟླས་པ་དང་ཇི་སྲིད་དུ་ཟླ་བ་ཉའི་བར་དུ་སྟེ།",
    "དེ་ནས་རང་གི་ལྷའི་ཕྱག་རྒྱ་བཅིངས་ལ་དེའི་སྔགས་ལན་བདུན་ནམ་བརྒྱད་བརྗོད་པས་དམ་ཚིག་བརྟན་པར་བྱའོ།",
    "བུམ་པ་བཟང་པོ་ལ་སོགས་པ་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་དངོས་གྲུབ་ཐམས་ཅད་ཀྱང་ཚུལ་འདི་ཉིད་ཀྱིས་སྤྱི་དང་བྱེ་བྲག་གི་ལེའུ་རྣམས་མཐོང་བས་སམ་ཆོ་ག་བཞིན་དུ་རྒྱུད་ལེགས་པར་བལྟས་ཤིང་ངེས་པར་ཐེ་ཚོམ་མེད་པར་བྱས་ལ་བསྒྲུབ་པར་བྱ་སྟེ།",
    "གཅིག་གིས་ཀྱང་འཇིག་རྟེན་གསུམ་བསྲུང་བར་ནུས་པ་ཡིན་ནོ་ཞེས་རྒྱུད་ལས་གསུངས་པའི་ཕྱིར་རོ།",
    "སྦྱོར་བ་གང་གིས་སྒྲུབ་པར་བྱེད་པ་དེ་ཉིད་ཀྱིས་འགྲུབ་པར་འགྱུར་རོ་ཞེས་སོ།",
    "ནམ་མཁའ་མཉམ་པ་དག་གི་ཡོན་ཏན་རྡུལ་ཕྲན་ཟེར་མི་ཡོད།",
    "དམ་ཚིག་གསུམ་གྱི་དངོས་གྲུབ་མཆོག་གི་མཆོག་སྦྱིན་མཛད་པས་བདག།",
    "མཆོག་སྩོལ་སྩལ་ན་རྟག་ཏུ་མཆོག་གི་རྟོགས་པའི་རྟོགས་དང་ལྡན།",
    "བསྟོད་བའི་རྒྱལ་པོ་འདི་དག་གིས།",
    "དམ་ཚིག་གསུམ་གྱི་དམ་ཚིག་གི་སྒྲུབ་ཐབས།",
    "དམ་ཚིག་གསུམ་གྱི་དམ་ཚིག་གི་སྒྲུབ་ཐབས།",
    "ཉོན་མོངས་བྱ་མིན་བྱེད་གཞུག་དང་།",
    "པཎྜི་ཏ་ཆེན་པོ་རིན་ཆེན་འབྱུང་གནས་སྤས་པས་མཛད་པའི་དམ་ཚིག་གི་སྒྲུབ་ཐབས་རྫོགས་སོ།",
    "རེ་རེ་ཞིང་ལན་གསུམ་གསུམ་དབུལ་བར་བྱའོ།",
    "དེའི་སྟེང་དུ་ཡི་གེ་ཧཱུཾ་ཨ་ལ་སོགས་པ་དབྱངས་ཡིག་བཅུ་དྲུག་གིས་ཡོངས་སུ་བསྐོར་བའོ།",
    "ཉོན་མོངས་པ་དང་།",
    "དེ་ལ་བཞུགས་པའི་བཅོམ་ལྡན་འདས་ནི་ཕྱག་གཉིས་པ་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་གནས་པ།",
    "ཞེས་བྱ་བའི་བསྟོད་པ་འདི་དག་གིས་བསྟོད་པར་བྱའོ།",
    "དམ་ཚིག་ཁྱོད་དམ་ཚིག་ཁྱོད་དམ་ཚིག་ཁྱོད་བདག་ཨོཾ་ཨཱ་ཧཱུཾ་ཞེས་བྱ་བའི་སྔགས་འདིས་གཉིས་སུ་མེད་པར་བྱ་བའོ།",
    "གདམས་ངག་གི་རིམ་པའི་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་གདན་གྱི་སྒྲུབ་ཐབས་ཡོངས་སུ་རྫོགས་སོ།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་ལ་ཡི་གེ་ཧཱུཾ་མཐིང་ནག་ཨ་ལ་སོགས་པའི་དབྱངས་ཡིག་དཀར་པོ་བཅུ་དྲུག་གིས་ཡོངས་སུ་བསྐོར་བའོ།",
    "མགོ་བོར་ཟླ་བ་ལ་གནས་པའི་ཡི་གེ་ཨོཾ་ལས་བྱུང་བའི་འཁོར་ལོ་རྩིབས་བརྒྱད་པ་དང་ཟླ་བ་ལ་གནས་པའི་ཡི་གེ་ཨོཾ་མོ།",
    "ཨོཾ་དམ་ཚིག་ཁྱོད་དམ་ཚིག་ཁྱོད་དམ་ཚིག་ཁྱོད་ཨོཾ་ཨཱ་ཧཱུཾ་ཞེས་བྱ་བའི་སྔགས་འདིས་གཉིས་སུ་མེད་པའི་ང་རྒྱལ་བསྐྱེད་པར་བྱའོ།",
    "དང་པོར་རེ་ཞིག་སྔགས་པས་བདེ་བའི་སྟན་ལ་ཉེ་བར་གནས་ཏེ།",
    "ཐམས་ཅད་ཀྱང་བདག་གིས་ཕུང་པོ་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་སུ་ལེགས་པར་དགོད་པར་བྱ་བའོ།",
    "གཡོན་ཕྱོགས་ན་དེ་ཁོ་ན་བཞིན་དུ་ཡི་གེ་དྲུག་གི་རིག་མ་ཆེན་མོ་པདྨ་གཞན་ལ་གནས་པའོ།",
    "དཔའ་བོ་ཁྱོད་ཨ་ལ་ལ་ལ་ལ་ཧོ་ཨ་ཨ་ཨ་ཨ་ཞེས་བྱ་བ་ནི་བྱིན་གྱིས་རློབ་པར་བྱེད་པའི་སྔགས་ཀྱི་རྒྱལ་པོ་བརྗོད་པར་བྱའོ།",
    "འཕགས་པ་ཡི་གེ་དྲུག་པ་རིག་པ་ཆེན་མོའི་སྒྲུབ་ཐབས་རྫོགས་སོ།",
    "རང་གི་ལྟེ་བའི་དཀྱིལ་འཁོར་དུ།",
    "རེ་རེ་ཞིང་ནི་དགོད་པ་དང་།",
    "པད་བཅས་ཐལ་མོ་ཁ་སྦྱར་བའི།",
    "ལྷ་མོ་ཞེན་པ་མེད་པར་བསྟེན།",
    "གདམས་ངག་གི་ཁྱད་པར་ཡི་གེ་དྲུག་པའི་སྒྲུབ་ཐབས།",
    "གདམས་ངག་གི་ཁྱད་པར་ཡི་གེ་དྲུག་པའི་སྒྲུབ་ཐབས་འགའ་ཞིག་ལ།",
    "དེ་བཞིན་དུ་བདུག་སྤོས་དང་མར་མེ་ཞེས་བྱ་བ་ལ་སོགས་པ་དག་གིས་གོ་བར་བྱའོ།",
    "ཡི་གེ་དྲུག་པའི་གདམས་ངག་གི་ཁྱད་པར་རྫོགས་སོ།",
    "རེ་ཞིག་དང་པོར་སྔགས་པས་བདེ་བའི་སྟན་ལ་ཉེ་བར་གནས་ཤིང་གདོད་པའི་གཙང་སྤྲ་ལ་སོགས་པ་བྱས་པས།",
    "སྔ་མོར་གདོང་སོགས་ལེགས་བཀྲུས་ལ།",
    "དེ་དག་ཐམས་ཅད་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་བདག་གིས་བཤགས་པར་བགྱིའོ།",
    "སྲས་དང་བཅས་པའི་བདེ་བར་གཤེགས་པའི་ལམ་ལ་བདག་གིས་བསམ་པ་རྣམ་པར་དག་པས་ལེགས་པར་བསྟན་པར་བགྱིའོ།",
    "སྣ་ཚོགས་པདྨ་ལས་བྱུང་བའི་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་ཕྱེད་ཀྲུང་གིས་བཞུགས་པ།",
    "རི་བོ་པོ་ཊ་ལའི་ནང་ན་བཞུགས་པ་དཔལ་དང་ལྡན་པ་ཐུགས་རྗེས་བརླན་པར་གྱུར་པའི་ཀུན་དུ་གཟིགས་པས་སྒེག་པའི་ཉམས་དང་ལྡན་པས་ཀུན་ནས་ལེགས་པར་བསྟེན་པར་བྱེད་པ།",
    "ཤིན་ཏུ་གཞོན་ཤིང་ལང་ཚོལ་བབས་པ་ལྟ་ཟུར་ལེགས་པར་བསྟེན་པའོ།",
    "ནོར་བཟངས་གཞོན་ནུ་ཡང་མཆན་ཁུང་གཡོན་པ་ན་པོ་ཏི་བཅུག་ཅིང་ཐལ་མོ་ཁ་སྦྱར་བ་གསེར་གྱི་འོད་ཀུན་དུ་སྣང་བ།",
    "དེ་དག་ཉིད་ཐམས་ཅད་ཀྱང་རང་གི་གཙོ་བོའི་ཞལ་ལ་སྤྱན་ལྟ་བར་བྱེད་པ།",
    "ན་མོ་རཏྣ་ཏྲ་ཡཱ་ཡ།",
    "མཎྜལ་རེ་རེ་ཞིང་ལན་གསུམ་དུ་བཟླས་པར་བྱ་བའོ།",
    "དང་པོར་རེ་ཞིག་སྔགས་པས་བཞིན་གྱི་གཙང་སྦྲ་ལ་སོགས་པ་བྱས་པ་བདེ་བའི་སྟན་ལ་གནས་ཏེ།",
    "སྤྱན་གསུམ་པ་དཀའ་ཐུབ་ཀྱི་ཆ་བྱད་འཛིན་པ་རྒྱལ་པོ་ཆེན་པོའི་འགྱིང་བག་གིས་བཞུགས་པ།",
    "མཎྜལ་རེ་རེ་ཞིང་ལན་བཅུ་གསུམ་རྗེས་སུ་བརྗོད་པར་བྱ་བའོ།",
    "ཞལ་འཛུམ་པ་དང་ལྡན་ཞིང་ཕྱག་དྲུག་པ་སྟག་གི་པགས་པའི་ཤམ་ཐབས་མནབས་པ་སྟེ།",
    "རལ་པའི་ཚོགས་ལ་མེ་ཏོག་གིས་མཛེས་པར་གྱུར་པའོ།",
    "སྤྱན་གསུམ་སྟག་གི་ཤམ་ཐབས་མནབས།",
    "འགྱུར་བའི་ཕྱག་གིས་བསྐོར་བར་མཛད།",
    "བདག་གི་ལས་ཐམས་ཅད་གྲུབ་པར་མཛོད།",
    "རང་གི་ནུས་པའི་སྦྱིན་པ་གཏང་།",
    "སྒྲུབ་ཐབས་བྲིས་ལས་བདག་གིས་ནི།",
    "སེམས་དཔའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "གཡོན་ངོས་ན་གོས་དཀར་མོས་ལེགས་པར་འཁྱུད་ཅིང་འཁྱུད་པའི་སྟངས་ཀྱིས་གནས་པའོ།",
    "དེའི་རྗེས་ལ་ཕྱོགས་བརྒྱད་དུ་ལྷ་མོ་བརྒྱད་རྣམ་པར་བསམ་པར་བྱ་བའོ།",
    "དེ་ལ་པདྨ་དམར་པོ་འདབ་མ་བརྒྱད་པའི་ཤར་གྱི་འདབ་མ་ལ་རྣམ་པར་གཟིགས་མ་པདྨ་དཀར་པོ་དང་དམར་པོ་འཛིན་པའོ།",
    "བྱང་གི་འདབ་མ་ལ་ཁྲོ་གཉེར་ཅན།",
    "བྱང་གི་གྲྭའི་འདབ་མ་ལ་སྣ་ཚོགས་རྡོ་རྗེ་མ་ཁ་དོག་སྣ་ཚོགས་པ་སྣ་ཚོགས་པདྨ་འཛིན་པའོ།",
    "སེང་གེ་དང་བྱ་ཁྱུང་དང་ཁྱབ་འཇུག་གི་ཕྲག་པ་ན་གནས་པར་རོ།",
    "དང་པོར་རེ་ཞིག་ཡིད་དང་རྗེས་སུ་མཐུན་པའི་གནས་སུ་ཐང་ཀ་དགྲམ་པར་བྱའོ།",
    "རྡོ་རྗེའི་རི་མོ་ཧཱུཾ།",
    "སྔགས་འདི་དག་གིས་བྱ་བ་ཡིན་ཏེ།",
    "པདྨ་དམར་པོ་ལ་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་ཤིང་ལྷ་རྫས་ཀྱི་རྒྱན་དང་ན་བཟས་རྣམ་པར་བརྒྱན་པར་བདག་ཉིད་བསམས་ལ།",
    "རེ་ཞིག་དང་པོར་ཡིད་ཀྱི་རྗེས་སུ་མཐུན་པའི་གནས་སུ་རྣལ་འབྱོར་པས་ཐང་ཀ་བརྐམ་ལ།",
    "ཨོཾ་རྡོ་རྗེ་རི་མོ་ཧཱུཾ་ཛ་ཧཱུཾ་བཾ་པདྨ་ལ་བཞུགས་ཧོ།",
    "དེའི་སྟེང་དུ་ཆགས་པའི་ས་བོན་སྐྱ་རེངས་དང་པོའི་འོད་ཟེར་དང་མཚུངས་པར་བལྟས་ལ།",
    "དེ་དག་ཐམས་ཅད་ཡོངས་སུ་གྱུར་པ་ལས་སྐད་ཅིག་གིས་ས་གསུམ་གྱི་ལུག་གཉིས་ཞགས་པས་སྦྲེལ་བའི་ཐོག་གི་པདྨའི་སྟེང་དུ་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ་སྟེ།",
    "དེའི་སྟེང་གི་གཡོན་དུ་ཆགས་པའི་ས་བོན་ནོ།",
    "དེ་ལྟར་ཉིན་རེ་བཞིན་རིགས་ལྔ་འདུ་བ་དེས་ནི་འགྲུབ་པར་འགྱུར་བ་ཡིན་ལ།",
    "ལན་ཚྭ་དང་ཨ་ཧུ་ཏའི་ཞེས་བྱ་བ་བརྒྱ་རྩ་བརྒྱད་སྦྱིན་སྲེག་བྱས་ན་སྐྱེས་པའམ་བུད་མེད་ཀྱང་རུང་སྟེ།",
    "དེ་ཡི་འཁོར་ལོ་རིན་ཆེན་འདི་ནི་རང་ཉིད་རྗེས་སུ་རྟོགས་པར་བྱ་ཕྱིར་བདག་གིས་བྲི།",
    "གཟུང་འཛིན་དག་གིས་བཅོམ་པའི་འགྲོ་བ་འདི་དག་རྣམས་ནི་རྨི་ལམ་དང་ནི་མིག་འཕྲུལ་མཚུངས།",
    "གསེར་འོད་དང་ལྡན་གུར་ཀུམ་དག་གི་འདབ་བཞིན་སེར་གྱུར་པ།",
    "གུར་གུམ་དམར་རེངས་ཤིན་ཏུ་འོད་འབར་བ་སྟེ་དེ་སྟོང་ངོ།",
    "དེ་ལ་རེ་ཞིག་ཡི་གེ་རྣམས་བསམ་པར་བྱ་སྟེ།",
    "དེ་ཁོ་ན་བཞིན་དུ་བར་དང་བར་རྣམས་ཀྱི་ནི་ཨ་ལ་སོགས་པའི་དབྱངས་ཡིག་གི་ཚོགས་རྣམས་སོ།",
    "ཕྱི་ནས་འཁོར་ལོའི་ཡི་གེའི་ཚོགས་དང་འོད་ཟེར་གྱི་ཚོགས་ཀྱི་འོད་ཀྱིས་མུན་པའི་དཀྱིལ་འཁོར་ཀུན་ནས་འཇོམས་པར་བྱེད་པ་རྣམས་རང་གི་ལུས་ཀྱི་བ་སྤུའི་ཁུང་བུ་རྣམས་ནས་འཕྲོས་པས།",
    "སྔར་མ་མཐོང་བའི་ངག་གི་རང་བཞིན་རྣམས་དང་ནི།",
    "ཤིན་ཏུ་གསལ་དང་གསུང་གི་མངའ་བདག་དཔལ་དགྱེས་འདིར་ནི་སྐྱེ་བོ་ཤོག།",
    "རྣམ་པར་གསལ་བའི་ཚིག་གིས་བྲི་བར་བྱ།",
    "གུར་གུམ་གྱི་འོད་དང་ལྡན་པའི་ཡི་གེ་མུ་ལས་བྱུང་བའི་ཨ་ལ་སོགས་པའི་དབྱངས་ཡིག་གི་འོད་ཟེར་འཕྲོས་པ་ལས་ཟླ་བ་དམར་པོར་བལྟ་བའོ།",
    "དེའི་སྟེང་དུ་ཡི་གེ་མུ་ལས་བྱུང་ཞིང་དྲི་མ་མེད་ཅིང་འོད་འཕྲོ་བ་དང་ལྡན་པའི་ཨུཏྤལའི་མཆོག་ལྟེ་བ་ལ་ཡི་གེ་མུ་གནས་པར་བསམ་མོ།",
    "བྱང་གི་རྩིབས་ལ་ནའོ།",
