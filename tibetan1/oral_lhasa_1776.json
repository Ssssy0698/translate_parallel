    "གལ་ཏྲེ་ཇི་ལྟར་བསྒྲུབས་པའི་རིགས་པས་ལས་རང་བཞིན་མྲེད་པ་཈ིད་དུ་རྣམ་པར་འཇྟོག་ན།",
    "གང་ཡང་ལས་དང་བྲེད་པ་པྟོ་཈ྲེ་བར་བསན་པ་འདི་ཡང་ཐྟོབ་པར་མི་འགྱུར་རྟོ།",
    "སྲེམས་དང་སྲེམས་ལས་བྱུང་བ་རྣམས་སྒྲུབ་པར་བྲེད་པ་པྟོར་འགྱུར་ཏྲེ།",
    "རྲེན་ལ་བརྲེན་ནས་སྲེ་བཞིན་པས་བྲེད་པ་པྟོ་ཡྟོད་བཞིན་པར་འགྱུར་རྟོ།",
    "གལ་ཏྲེ་ཡང་རྣམ་པར་ཤྲེས་པའི་དམིགས་པ་཈ིད་དུ་བསྒྲུབས་ན།",
    "རྣམ་པར་ཤྲེས་པ་མ་འཁྲུལ་བས་དྲེའི་ཕྱིར་མི་བདྲེན་པ་བདྲེན་པའི་རྒྱུར་མི་འགྱུར་བ་཈ིད་ལ།",
    "དྲེ་ལ་རྣམ་པར་ཤྲེས་པ་ཡང་མི་བདྲེན་པ་཈ིད་དུ་འདྟོད་ལ།",
    "སྤྲུལ་པ་གཞན་ནི་སྤྲུལ་པར་འགྱུར།",
    "འྟོག་མིན་ཁྟོ་ནར་དྲེ་ཁྟོ་ན་཈ིད་རྣམ་པ་ཐམས་ཅད་དུ་མངྟོན་པར་རྟོགས་པའྟོ།",
    "དྲེ་཈ིད་ཀིས་ན་གསུངས་པ།",
    "ཞྲེས་གསུངས་སྟོ།",
    "གང་ཞིག་སྤྲུལ་པ་ལས་སྤྲུལ་པ་གཞན་ཡང་འཇུག་པར་མཛད་དྟོ།",
    "ཅི་འྟོན་ཏྲེ་གང་སྤྲུལ་པའི་སྤྲུལ་པ་ཐྲེ་ཚོམ་མྲེད་པར་འདི་ནི་དྲེ་བཞིན་གཤྲེགས་པའི་རང་བཞིན་དང་བལ་བ་སྟོང་཈ིད་བདུན་ཅུ་པའི་འགྲེལ་པ།",
    "སྤྲུལ་པ་འདི་ཡང་རྣམ་པ་ཐམས་ཅད་ཀིས་མྲེད་དྟོ་ཞྲེས་བརྟོད་པར་མི་ནུས་ཏྲེ།",
    "དྲེ་དག་཈ྲེ་བར་དམིགས་བཞིན་པའི་ཕྱིར་རྟོ་ཞྲེས་གསུངས་པ།",
    "གསུངས་པ་རྟོགས་པ་ཙམ་ཞྲེས་བ་བ་ལ་ཡྟོངས་སུ་བརགས་པ་ཙམ་ཡང་དག་པ་མ་ཡིན་པར་སྟོ་བཏགས་པ་ཙམ་བརྫུན་པ་སླུ་བའི་ཆྟོས་ཅན་ཙམ་ཞྲེས་བ་བའི་དྟོན་ཏྟོ།",
    "གལ་ཏྲེ་ཡང་འཁྲུལ་པ་ཙམ་དུ་ཡང་དམིགས་པ་མྲེད་དྟོ་ཞྲེས་བ་བར་གྱུར་ན་དྲེ་ནི་ཀུན་རྟོབ་ཀི་བདྲེན་པ་ལ་གནྟོད་པར་ཡང་འགྱུར་ཏྲེ།",
    "འབས་བུ་གཞན་སྒྲུབ་པར་བྲེད་པར་མི་འགྱུར་ཏྲེ།",
    "ཀུན་རྟོབ་ཙམ་དུ་དྲེ་དག་ཡྟོད་དྟོ་ཞྲེས་རྣམ་པར་གཞག་གྟོ།",
    "སྲེད་པ་ཟད་པས་རྣམ་པར་གྟོལ་བར་འགྱུར་རྟོ།",
    "དྲེ་ནི་འདི་ལྟར་བརྫུན་པར་མཐྟོང་བ་ནི་཈ྟོན་མྟོངས་པའི་རང་བཞིན་མཐྟོང་བས་རྣམ་པར་གྟོལ་ལྟོ་ཞྲེས་གནས་སྟོ།",
    "དྲེ་བཞིན་བྲེད་པྟོ་སྤྲུལ་པར་མཚུངས།",
    "འགྟོ་བ་ས་ཚོགས་པ་བསྲེད་པར་ནུས་པར་འགྱུར་རྟོ།",
    "གང་འདིར་ཡང་དག་པའི་དྲེ་བཞིན་གཤྲེགས་པ་ཡྟོད་དྟོ་ཞྲེས་མངྟོན་པར་འདྟོད་ན།",
    "གལ་ཏྲེ་རྲེ་ཞིག་བྲེད་པ་པྟོར་གྱུར་པར་ཡྟོངས་སུ་རྟོགས་ན།",
    "ཡང་ན་ལས་སུ་གྱུར་པས་ཡང་དག་པར་ཡྟོངས་སུ་རྟོགས་ན།",
    "དྲེ་ལྟ་ན་ཡང་སྤྲུལ་པ་ནི་སྤྲུལ་པས་སྤྲུལ་པ་བཞིན་འདི་ལ་ཡང་དག་པར་བརྟོད་པར་རིགས་པ་མ་ཡིན་ནྟོ།",
    "ངྲེས་པར་དྲེ་བཞིན་གཤྲེགས་པ་ཡང་མྲེད་དམ་ཅི་ཞྲེ་ན།",
    "གང་ཞིག་དྲེ་བཞིན་གཤྲེགས་པ་ཞྲེས་བ་བ་རང་བཞིན་དུ་རྟོགས་ན་དྲེ་ནི་དྲེ་ལ་ཡྟོད་པའམ་མྲེད་པར་ཡྟོངས་སུ་རྟོགས་པར་བྲེད་ན།",
    "གལ་ཏྲེ་རང་བཞིན་ཡྟོད་པར་གྱུར་ན།",
    "དྲེའི་ཚེ་མྱ་ངན་ལས་འདས་པ་མྲེད་པར་འགྱུར་ལ།",
    "བྲེད་པ་པྟོ་ཡང་མྲེད་པར་འགྱུར་རྟོ།",
    "གལ་ཏྲེ་རྟོག་པ་ཙམ་ཡང་མྲེད་པར་འགྱུར་ན།",
    "རྟོག་པ་ཁས་མི་བླང་བར་ཡང་མི་བའྟོ་ཞྲེས་བསྒྲུབ་པའི་ཕྱིར་གསུངས་པ།",
    "གང་འདི་ལྟར་མྱ་ངན་ལས་འདས་པ་ལས་དང་཈ྟོན་མྟོངས་པ་ཟད་པ་ལས་རྣམ་པར་གཞག་ལ།",
    "ལས་དྲེ་ཡང་བྲེད་པ་པྟོ་ལ་མི་ལྟྟོས་པར་འགྱུར་ལ།",
    "རང་བཞིན་ཡྟོད་པར་གྱུར་ན།",
    "དྲེའི་ཚེ་ལས་ཀིས་བསྲེད་པའི་སྡུག་པའམ་མི་སྡུག་པར་མི་འགྱུར་ལ།",
    "ཆྟོས་཈ིད་དང་མི་འགལ་ལྟོ་ཞྲེས་བསྒྲུབ་པའི་ཕྱིར་གསུངས་པ།",
    "གསུངས་པ་རྟོགས་པར་ས་མ་ཡིན།",
    "དྲེ་ལ་གཅིག་ཏུ་ངྲེས་པར་གཟུང་བར་མི་ནུས་པས་ལས་ངྟོ་བྟོ་཈ིད་ཀིས་ཡྟོད་པར་འཇིག་རྲེན་པས་ཡང་དག་པར་མཐྟོང་ནས་མངྟོན་པར་ཞྲེན་པའི་ཡྟོད་པ་ཡང་གང་ཅི་ཡང་རུང་བ་རག་པ་ཙམ་སྲེ།",
    "དྲི་ཟའི་གྟོང་ཁྱྲེར་ལ་སྟོགས་པའི་རྣམ་པ་ལ་མྲེད་དྟོ་ཞྲེས་བ་བར་རྟོགས་པ་ཁྟོང་དུ་ཆུད་པས་ལྟོག་པར་ལྟ་བས།",
    "དྲེ་དག་མྲེད་པར་ལྟ་བ་ལས་བཟླྟོག་པའི་དྟོན་དུ་ལས་ཡྟོད་དྟོ།",
    "ལས་ཀི་རྣམ་པར་སིན་པ་ཡྟོད་དྟོ་ཞྲེས་བཅྟོམ་ལྡན་འདས་ཀིས་གསུངས་ལ།",
    "གང་ཞིག་དྲེ་གང་ཅི་ཡང་རུང་བ་རྟོག་པ་ཙམ་བིས་པའི་སྲེ་བྟོས་ཡྟོངས་སུ་བརགས་པའི་དྲི་ཟའི་གྟོང་ཁྱྟོར་ལ་སྟོགས་པར་ཡྟོད་པ་དྲེ་ཐུགས་ལ་བཞག་པའྟོ།",
    "གང་ཡང་ལས་དང་འབས་བུ་ལ་འདི་དག་བདྲེན་ནྟོ་ཞྲེས་མངྟོན་པར་ཞྲེན་ལ།",
    "མངྟོན་པར་ཞྲེན་པ་དྲེས་དྲེ་དག་འཁྟོར་བ་ལས་མི་གྟོལ་བས།",
    "གང་ལ་ལས་མྲེད་ཅིང་ལས་ཀི་རྣམ་པར་སིན་པ་མྲེད་པ་དྲེ་ནི་འཕགས་པ་རྣམས་ཀི་རིགས་སྟོ་ཞྲེས་བ་བ་ལ་སྟོགས་པའྟོ།",
    "རྣམ་པར་གཞག་པ་མ་བས་ན།",
    "གསུངས་པ་རྟོགས་པར་ས་མ་ཡིན།",
    "ཇི་སྐད་གསུངས་པའི་དྟོན་ཡྟོད་བཞིན་པའི་ཕྱིར་ན།",
    "དྲེ་ལྟར་ག་཈ིས་཈ིད་དུ་རྣམ་པར་གནས་པ་འདི་དག་འདིར་བསམ་པར་བ་སྲེ།",
    "དྲེའི་ཚེ་ཤིན་ཏུ་དྟོན་མ་ཡིན་པ་སྲེ་བ་ཐྟོབ་པར་འགྱུར་ལ།",
    "ཅུང་ཟད་ཙམ་ཐུགས་ལ་བཞག་ནས་གསུངས་པས་ཞྲེས་བ་སྲེ།",
    "གང་ཡང་དྟོན་འདི་ནི་བདྲེན་པ་ག་཈ིས་རྣམ་པར་གཞག་པ་ལ་མི་མཁས་པ་རྣམས་ཀིས་འདིར་ལྲེགས་པར་མི་ཤྲེས་པའི་ཕྱིར་རྟོ།",
    "དྲེས་ན་ཇི་སྐད་སྟོས་པའི་བདྲེན་པ་ག་཈ིས་ཀི་བླྟོ་དང་ལྡན་པས་མངྟོན་པར་སྦྱྟོར་བར་བྲེད་པར་རུང་ངྟོ་ཞྲེས་བའྟོ།",
    "དྲེ་ལྟ་ན་ཡང་རྲེ་ཞིག་ལས་ཀི་འབས་བུ་གཟུགས་ལ་སྟོགས་པ་ཡྟོད་པས་གཟུགས་ལ་སྟོགས་མྲེད་དྟོ་ཞྲེས་ཀང་བརྟོད་པར་མི་ནུས་སྟོ་ཞྲེས་བ་སྲེ།",
    "གང་དུ་བཅྟོམ་ལྡན་འདས་ཀིས་ཀང་གསུངས་ཏྲེ།",
    "གལ་ཏྲེ་གཟུགས་཈ིད་ཡྟོད་ན་གཟུགས་ལ་བརྲེན་ནས་དངྟོས་པྟོ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་ན།",
    "ཇི་ལྟར་མྲེད་པ་ཡང་དྲེ་ལྟར་སྔར་཈ིད་དུ་རྒྱས་པར་བསྒྲུབས་ལ།",
    "གཞན་ཡང་གལ་ཏྲེ་མྲེད་པས་གཟུགས་མྲེད་པར་གྲུབ་ཀང་།",
    "དྲེས་ན་དྲེ་སྲེལ་བའི་སྟོ་ནས་སྲེ་མཆྲེད་ཐམས་ཅད་དགག་པའི་དྟོན་དུ་སར་ཡང་བརག་པ་ཙམ་པའི་ཕྱིར་གསུངས་པ།",
    "གཟུགས་ལ་རིགས་པ་དང་འགལ་བར་གསུངས་པའྟོ་ཞྲེས་མཚོན་པས་འཇིག་རྲེན་པ་རྣམས་ཀིས་དྲེ་མི་བདྲེན་པར་ཁྟོང་དུ་ཆུད་པར་བ་བའི་དྟོན་དུའྟོ།",
    "འྟོན་ཀང་གཟུགས་མྲེད་པའི་སྒྲུབ་བྲེད་དྟོ་ཞྲེས་བསན་པའི་ཕྱིར་གསུངས་པ།",
    "གཅིག་ལ་ཕན་ཚུན་མཚན་཈ིད་ཐ་དད་པའི་བདག་཈ིད་བཞི་བརྲེན་པར་མི་འཐད་དྲེ།",
    "གསུངས་པ།",
    "གལ་ཏྲེ་གཟུགས་འཛིན་པར་མི་འགྱུར་ན་འདི་ནི་གཟུགས་སྟོ་ཞྲེས་པའི་བླྟོ་མི་འབྱུང་ལ།",
    "གཟུགས་ཀི་བླྟོ་མྲེད་ན་ཇི་ལྟར་གཟུགས་ཡྟོད་པའི་རགས་སུ་འགྱུར་ཞྲེས་གསུངས་པ།",
    "དྲེའི་རྣམ་པར་སྲེ་བས་སྟོ།",
    "དམིགས་པ་མྲེད་པར་དམིགས་པ་པྟོ་མི་འཐད་པའི་ཕྱིར་རྟོ།",
    "འདིར་གཟུགས་ཇི་ལྟར་འཛིན་པར་བྲེད།",
    "དྲེ་ཡིས་ཇི་ལྟར་རྟོགས་པར་འགྱུར།",
    "སྲེས་པའི་ས་ནི་འདིར་ད་ལྟར་བའི་རྟོད་དུ་ཤྲེས་པར་བའྟོ།",
    "འདིར་གལ་ཏྲེ་བླྟོ་ཡིས་གཟུགས་ལ་འཛིན་པར་བྲེད་ན།",
    "ག་཈ི་ག་ཡང་སྐད་ཅིག་མའི་ཕྱིར་སྲེས་མ་ཐག་ཏུ་རྣམ་པར་འཇིག་པའི་བླྟོ་ནི་དྲེ་ལ་སྐད་ཅིག་ཙམ་ཡང་གནས་པ་མྲེད་ན།",
    "གང་ལས་འདིས་ཡུལ་ལ་འཛིན་པ་སིད་པར་འགྱུར།",
    "བསྲེད་པར་བ་བ་ལ་འཛིན་ནྟོ་ཞྲེ་ན།",
    "བསྲེད་པར་བ་བ་ནི་མ་འྟོངས་པ་ཡིན་ལ།",
    "དྲེ་ཡང་མ་སྲེས་པར་གྱུར་པའི་གཟུགས་ཇི་ལྟར་འཛིན་པར་འགྱུར།",
    "ཐག་ཏུ་རྣམ་པར་འཇིག་པས་སྐད་ཅིག་ཙམ་ཡང་གནས་པ་མྲེད་ན།",
    "གང་ལས་འཛིན་པར་བྲེད།",
    "དྲེ་ལྟ་ན་ཡང་འདས་པ་དང་མ་འྟོངས་པ་ལ་ཇི་ལྟར་འཛིན་པར་མི་འགྱུར་ཞྲེ་ན།",
    "དྲེའི་ཚེ་ཇི་ལྟར་རྣམ་པ་ཐམས་ཅད་དུ་ཡྟོད་བཞིན་པ་མ་ཡིན་པའི་ཞིག་པ་དང་མ་སྲེས་པ་བླྟོས་འཛིན་པར་ནུས།",
    "དྲེ་ལྟར་རྲེ་ཞིག་འཛིན་པ་མི་སིད་པ་དྲེས་ན་ཡང་གཟུགས་མྲེད་དྟོ་ཞྲེས་བསྒྲུབ་པའི་ཕྱིར་གསུངས་པ།",
    "གལ་ཏྲེ་ཡྟོད་ལ་ཕན་ཚུན་མ་ལྟྟོས་པར་འཛིན་པར་འགྱུར་ལ།",
    "འདི་དག་ཀང་ཁ་དྟོག་ལས་ཐ་དད་པའི་དབིབས་འཛིན་པར་མི་ནུས་ཏྲེ།",
    "བུམ་པ་ལས་སམ་བུ་ལྟ་བུ་མ་ཡིན་ལ་དྲེ་བཞིན་དུ་དབིབས་ལས་ཐ་དད་པའི་ཁ་དྟོག་འཛིན་པར་མི་ནུས་སྟོ།",
    "དབིབས་ལས་ཐ་དད་པའི་ཁ་དྟོག་ལྟོགས་སུ་གྲུབ་པར་མི་སིད་དྟོ་ཞྲེས་བའྟོ།",
    "དྲེས་ན་དྲེ་དག་ཐ་དད་པར་འཛིན་པ་ཡྟོད་པ་མ་ཡིན་ནྟོ།",
    "དྲེ་ལྟ་ན་ཡང་གཅིག་ཏུ་གྱུར་པ་འདྲྲེན་མའི་དངྟོས་པྟོར་དྲེ་དག་འཛིན་པར་འགྱུར་རྟོ་ཞྲེ་ན།",
    "ཡང་ན་གལ་ཏྲེ་ཡང་འཛིན་པ་མྲེད་པས་གཟུགས་མྲེད་པར་འགྱུར་ལ།",
    "ཡྟོད་པ་མ་ཡིན་ནྟོ་ཞྲེས་བསྒྲུབ་པའི་ཕྱིར་གསུངས་པ།",
    "གཟུགས་ལ་ཡྟོད་མིན་པར་ན་མྲེད།",
    "ལྲེགས་སྟོ་ལྟོག་པར་ཡྟོངས་བརགས་པ།",
    "དྲེས་ན་འདི་ནི་ཡང་དག་པར་མི་སྲེ་སྲེ།",
    "སྲེ་བ་རིགས་པ་དང་མི་ལྡན་པའི་ཕྱིར་རྟོ་ཞྲེས་བསྒྲུབ་པའི་ཕྱིར་གསུངས་པ།",
    "ལྲེགས་སྟོ་ལྟོག་པར་ཡྟོངས་བརགས་པ།",
    "ཞྲེས་མདྟོ་ལས་གསུངས་སྟོ་ཞྲེས་བའྟོ།",
    "འཛིན་པར་འགྱུར་ལ།",
    "དྲེ་ནི་བྟོང་བ་ལ་སྟོགས་པ་བཞིན་པས་མིག་཈ིད་དུ་མི་འགྱུར་རྟོ་ཞྲེས་སྒྲུབ་པར་བྲེད་ན་དྲེ།",
    "སྲེ་མཆྲེད་ཐམས་ཅད་མིག་དང་གཟུགས་བཞིན་དུ་རང་བཞིན་ཡིན་པར་ཁྟོང་དུ་ཆུད་པར་བའྟོ་ཞྲེས་བ་བའི་དྟོན་ཏྟོ།",
