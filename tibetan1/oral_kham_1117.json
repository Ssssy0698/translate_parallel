    "འོན་ཀྱང་རང་ཉིད་ཀྱི་གཏམ་བརྗོད་མ་ལག་ངེས་པར་དུ་རང་ཉིད་གཅིག་པུས་འཛུགས་དགོས།",
    "ཨུ་ཚུགས་བཙན་ཤེད་ཀྱི་སྣང་ཚུལ་ཚབས་ཆེན་གནས་འདུག་བློ་མཐུན་ལ་ལར་བྱ་བའི་ཁྲོད་དུ་གཤམ་གྱི་གོལ་འཛོལ་བྱུང་འདུག་སྟེ།",
    "བྱ་དངོས་ཀྱི་སྤྱིར་བཏང་རང་བཞིན་ཐད་ནས་བརྗོད་ན།",
    "དམིགས་བསལ་རང་བཞིན་དེ་ནམ་ཡིན་ཡང་སྤྱིར་བཏང་རང་བཞིན་གྱིས་ཐག་གཅོད་བྱེད་དཀའ།",
    "འཛམ་གླིང་ནི་འབྲེལ་བ་སྣ་ཚོགས་ཀྱིས་གྲུབ་པའི་འཇིག་རྟེན་ཞིག་ཡིན་ཙ་ན།",
    "ཡང་ན་འགྲོ་ཐབས་འདུག་ཐབས་བྱས་ནས་དོན་མི་རིགས་ལས་དོན་གྱི་བྱེད་ཐབས་སྨྲ་བ།",
    "སྤྱིར་བཏང་རང་བཞིན་དང་དམིགས་བསབསལ་རང་བཞིན་གྱི་འབྲེལ་བ་འདི་ཐག་གཅོད་ཡག་པོ་བྱ་དགོས།",
    "སྒྲིག་སྲོལ་བཅས་ཀྱི་སྤྱིར་བཏང་རང་བཞིན་ཡིན།",
    "སྤྱིར་བཏང་རང་བཞིན་གྱིས་དམིགས་བསལ་རང་བཞིན་དགག་ནས་ཁས་མི་ལེན་པ་དང་།",
    "དམིགས་བསལ་རང་བཞིན་གྱིས་སྤྱིར་བཏང་རང་བཞིན་དགག་ནས་ཁས་མི་ལེན་པ་བྱེད་མི་རུང་།",
    "ཡང་ན་སྤྱིར་བཏང་རང་བཞིན་གྱིས་དམིགས་བསལ་རང་བཞིན་གྱི་ཚབ་བྱེད་མི་རུང་ལ།",
    "དམིགས་བསལ་རང་བཞིན་གྱིས་སྤྱིར་བཏང་རང་བཞིན་གྱི་ཚབ་ཀྱང་བྱེད་མི་རུང་བ་སྨོས་ཅི་དགོས།",
    "སྤྱིར་བཏང་རང་བཞིན་གྱི་རྨང་གཞིའི་སྟེང་ནས་དམིགས་བསལ་རང་བཞིན་ཐག་གཅོད་བྱེད་པ་དང་།",
    "ཡུན་རིང་རང་བཞིན།",
    "རྙོག་འཛིང་རང་བཞིན།",
    "བྱེད་ཐབས་འདེམ་གསེས་བྱེད་པ་བཅས་ལ་ཤུགས་རྐྱེན་བཟོས་དང་བཟོ་བཞིན་གདའོ།",
    "ཡུན་རིང་རང་བཞིན་ངོས་ཟིན་དགོས་ན་མར་ཁེ་སི་རིང་ལུགས་པའི་ལོ་དུས་སྐབས་གསར་པའི་མི་རིགས་ལས་དོན་གྱི་བསམ་གཞིགས།",
    "ཞེས་དབྱེ་ཞིབ་བྱས་པར་ང་རང་ཅུང་ཡིད་འཐད་ཡོད་དེ།",
    "སུའུ་ལེན་གུང་ཁྲན་ཏང་རང་ངོས་ནས་མར་ཁེ་སི་རིང་ལུགས་ཀྱི་འདུ་ཤེས་འཛིན་སྟངས་རླབས་ཆེན་འདིར་ཡིད་ཆེས་ཉམས་ནས་དད་པ་མེད་པར་གྱུར་པ་སྟེ།",
    "མི་རིགས་རང་ཉིད་ཀྱི་རིག་དུས་སྐབས་གསར་པའི་མི་རིགས་ལས་དོན་གྱི་བསམ་གཞིགས།",
    "རྒྱའི་བརྡ་རྙིང་དུ་མི་རིགས་ཞེས་པའི་ཐ་སྙད་མི་འདུག་དུས་རྟག་ཏུ་ཚོ་རྒྱུད་དང་།",
    "མི་སོགས་སྤྱོད་བཞིན་གདའ།",
    "མཁས་པས་ནམ་ཡང་རང་སྟོབས་བསྐྱེད་པར་བྱ།",
    "རྒྱུ་ཡིས་དབུལ་ཡང་རང་ཉིད་ལེགས་པོར་སྲུང་།",
    "ཞེས་པའང་རང་སེམས་བཅོས་སྐྱོང་ཡིན།",
    "མིའི་རིགས་ཀྱི་ཤེས་དཔལ་གྱི་སྣ་མང་རང་བཞིན་ཁས་ལེན་པར་མ་ཟད།",
    "ད་དུང་སྣ་མང་རང་བཞིན་སྲུང་སྐྱོབ་དང་འཕེལ་རྒྱས་གཏོང་བའི་འདོད་བློ་འཛིན་པ་དང་གཅིག་མིའི་རིགས་ཀྱི་ཤེས་དཔལ་གྱི་འདྲ་མཉམ་རང་བཞིན་ཁས་ལེན་པར་མ་ཟད།",
    "ཞིན་ཅང་རང་བཙན་པ་ཡིས་རང་བཙན་གྱི་གྲུ་གུ་ཤར་མ་སི་ཐན་འཛུགས་པ།",
    "གཅིག་ནས་ཡུན་རིང་རང་བཞིན་དངོས་གནས་ངོས་ཟིན་ཏེ་ཁོང་དུ་ཆུད་དགོས།",
    "ཡུན་རིང་རང་བཞིན་ངོས་མ་ཟིན་ན།",
    "རྙོག་འཛིང་རང་བཞིན།",
    "ཡུན་རིང་རང་བཞིན།",
    "རྙོག་འཛིང་རང་བཞིན་ཤེས་པར་བྱེད་དགོས་ན།",
    "མི་རིགས་ཀྱི་ཁྱད་པར་སྔར་བཞིན་གནས་ཙ་ན།",
    "འདི་ཡང་རང་རྒྱལ་གྱིས་སྤྱི་ཡོངས་གཏན་འཇགས་ཡོང་བ་དང་།",
    "ཐོན་སྐྱེད་དང་འཚོ་བ་རོལ་སྟངས་སོགས་ལ་ཆ་རྒྱུས་ཡོད་ཅིང་རང་མི་རིགས་དང་བཅོས་མིན་གྱི་འབྲེལ་བ་ཡོད་པས།",
    "དུས་ཡུན་རིང་ཞིང་ཕྱོགས་ཡོངས་ཀྱི་ནུས་པ་བཏོན་དང་འདོན་བཞིན་གདའ།",
    "ཡིན་ནའང་རྩོམ་པ་པོ་ལ་ལ་ཞིག་གཞན་གྱི་གསང་བར་ལྐོག་ལྟ་བྱེད་མཁན་ལྟ་བུར་གྱུར་འདུག་ད་ལྟ་ད་དུང་སྣང་ཚུལ་གསར་པ་ཞིག་བྱུང་འདུག་སྟེ།",
    "གདུག་རྩུབ་བཅས་ལ་འུར་བསྟོད་བྱེད་ཀྱིན་གདའ།",
    "འོན་ཀྱང་ད་ལྟ་ནང་དོན་གསར་པ་བྱུང་འདུག་བསྒྱུར་བཅོས་སྒོ་འབྱེད་ཚུན་གྱི་ལོ་རབས་བརྒྱད་ཅུ་དང་དགུ་བཅུའི་སྐབས་ཀྱི་ཕྱི་སྨོན་ཕྱི་དགའ་ནི།",
    "མཇུག་འབྲས་ཁོ་ནར་ལྟ་བ་ལས་གོ་རིམ་ལ་མི་ལྟ་བར་སེམས་ངན་སྦྱོར་རྩུབ་དང་ཐབས་ངན་གང་རུང་སྤྱོད་བཞིན་གདའ།",
    "གལ་ཏེ་མི་རིགས་ཀྱི་ཡིན་ཚེ་རྗེས་ལུས་དང་བླུན་རྨོངས་ཡིན་པས་འདོར་དགོས་པར་བསམས་ནས་མཐོང་ཆུང་དང་ཕུད་འདེད་བྱེད་བཞིན་གདའ།",
    "གཅེས་སུ་འོས་པའི་ཐོན་ཁུངས་འདི་དག་གསེར་སྤེལ་དང་བེད་སྤྱོད་བྱས་པ་མ་ལེགས་པས་ཉམས་དམས་སུ་འགྲོ་བཞིན་གདའ།",
    "ཚད་གཞི་མེད་པའི་ཐོན་རྫས་ནི་ཐོན་རྫས་སྤུས་ཞན་དུ་འགྱུར་སླ་ཙ་ན།",
    "གསར་པ་བཞི་དང་རང་བཞིན་བཞི་ནི་རྒྱལ་ཡོངས་གྲངས་ཉུང་མི་རིགས་རིག་རྩལ་འཁྲབ་སྟོན་སྐབས་བཞི་པའི་བླང་བྱ་ཡིན་པས།",
    "ད་དུང་བལྟོས་བཅས་ཀྱི་རང་ཚུགས་རང་བཞིན་བདོག་ཅེས་འགྲེལ་འདུག་དེར་བརྟེན།",
    "དུས་རབས་ལ་རྐང་བཙུགས་ནས་དུས་རབས་ལ་ནུས་པ་ཐོན་ཙ་ན།",
    "གསར་པ་བཞི་དང་རང་དུས་སྐབས་གསར་པའི་མི་རིགས་ལས་དོན་གྱི་བསམ་གཞིགས།",
    "ང་རང་སྐབས་གཉིས་ཀྱི་རིག་རྩལ་འཁྲབ་སྟོན་ལ་ཞུགས་པའི་རྩ་འཛུགས་རྣམ་པ་གཞི་ནས་འདྲ་མཚུངས་ཡིན་ཏེ།",
    "ཅེས་བཀོད་འདུག་ཁ་ལོའི་ཟླ་པའི་ཚེས་ཉིན།",
    "ཞེས་ཕྱག་བྲིས་གནང་འདུགཡིན་ཡང་སྐབས་དང་པོ་ནས་བཞི་པའི་རྒྱལ་ཡོངས་གྲངས་ཉུང་མི་རིགས་འཁྲབ་སྟོན་ཚང་མ་པེ་ཅིན་དུ་གཉེར་དོན་ཅི་ཞེ་ན།",
    "འོན་ཀྱང་རང་ཚུགས་མི་འཆོར་བར།",
    "འདུག་བའི་རྩེ་ལ་ཐུགས་དམ་བཛད།",
    "ཆད་ཁ་པ་ལ་བཀའ་གདམས་གསན་འདུག་པས།",
    "ཡུལ་པའི་ཕྱུགས་མ་སྐྱོང་བཞིན་གདའ།",
    "གཅིག་བུར་འདུག་ཚེ་སེམས་ལ་བརྟག།",
    "ཆབ་ཚན་གྱིས་ཞབས་ལ་འདུག་པ་ཙམ་མཛད།",
    "སཀུ་སྐྱེ་ཞིག་སྔ་གོང་ནས་འཁྲུངས་པ་ཡིན་འདུག་ཀྱང་།",
    "ལུས་དཔོན་མེད་གཡོག་མེད་ཀྱི་འདུག་ལུགས་གསལ།",
    "གཙོ་བོར་དྲང་ངེས་རྣམ་འབྱེད་གསུང་བ་གནང་ཞིང་རང་རྒྱུད་པ་ཡན་ཆད་ཀྱི་ཌྲཱིཀ་ཞིག་ཀྱང་མཛད།",
    "བླླ་མ་འདིས་ཁོ་བོས་བྱ་ཞེས་བཀའ་སྤྱི་བོས་ནོད་པ་ལགས་པར་གདའ།",
    "བསྟན་པའི་མཇུག་མ་རྣམ་དག་གཅིག་འདུག་སྟེ།",
    "ད་མི་དགོངས་པར་འདུག་སྙམ་ནས་བྲིས་སཀུ་དེ་སཀུ་རྒྱབ་གཡོན་ཕྱོགས་སུ་གདན་དྲངས་པས།",
    "འཁོར་ལོ་བདེ་མཆོག་དུས་ཀྱི་འཁོར་ལོའི་བསྐྱེད་རྫོགས་ཀྱི་གནང་།",
    "སྔ་སོར་གསང་ཕུ་འཆད་ཉན་ཞིག་མཛད་འདུག་ཀྱང་བཞེད་པ་བཞིན་མ་བྱུང་བས་གཙང་ལ་ཐེགས་ཏེ་བྱ་བྲལ་འཆད་ཉན་འཕེལ་པོ་མཛད་ཅིང་།",
    "རྒྱལ་བ་ཙོང་ཁ་པ་ཆེན་པོའི་ཞབས་དྲུང་ན་མཁས་གྲུབ་ཐམས་ཅད་མཁྱེན་པ་དང་རྗེ་བཙུན་ཤེས་རབ་སེང་གེ་གཉིས་ཀྱང་བཞུགས་འདུག་དེ་ནས་རྒྱ་གར་ཤར་ཕྱོགས་སུ་སྐྱེ་བ་ལེན།",
    "ཕོ་ཉའི་ལམ་གྱིས་ས་ལམ་བགྲོད་པ་ཞིག་འོང་བར་འདུག་ཅེས་མྱ་ངན་ལས་འདའ་ཁར་གསུངས་པར་སྣང་།",
    "དེ་ནས་ཞལ་སྔ་ནས་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གདན་སར་སྤྱན་དྲངས་པ་རྒྱུན་འཐུད་པར་འོས་ཤིང་དེ་ཀའི་དགོངས་པ་ཡོད་འདུག་ནའང་།",
    "གཉལ་ཆེན་པ་རང་བཞུགས་དུས་ནས་སློབ་དཔོན་དགེ་རྒྱལ་འཆད་ཉན་དུ་བསཀོ་བ་མཛད་འདུག་ནའང་།",
    "ཚོགས་པ་བསྡུ་བ་ནི་རྣམ་གཉིས་དུས་མཉམ་ཙམ་དུ་འདུག་ཆུང་ངུ་ནས་ཡབ་ཡུམ་གཉིས་ཀ་འདས་ནས།",
    "ད་ལྟ་མཆོད་ཁང་ནང་ན་ཡོད་འདུག་དགོངས་གསལ་བ་ནི།",
    "དེར་གནས་བརྟན་དེས་གླས་པོ་ཆེར་བཙུན་པ་ཉི་ཤུ་ཙམ་ཞིག་འདུག་པ་ལ།",
    "རྩོད་ལྡན་གྱི་ལོར་འཇོག་དུས་བཞི་ཕྱི་མ་ནི་དྲག་པོ་འཁོར་ལོ་ཅན་གྱིས་ཀླ་ཀློ་བཅོམ་ཏེ།",
    "ཟས་བཟང་པོ་གཅིག་ཡོད་པར་འདུག་དགོངས་ནས།",
    "མེས་སྲོང་བཙན་གྱིས་སྲས་ཁྲི་སྲོང་ལྡེ་བཙན་ལུང་བསྟན་པ་ཉིད་ཁོ་རང་ཡིན་སྙམ་པའི་རློམས་པས་རྐྱབྲསྤྱ་༣་ཏ་སྤྱན་དྲངས་ཏེ།",
    "བུས་ཞང་ངོ་ཤེས་ཙ་ན་མས་ཡུལ་ཕྱེད་རླག་ཚར་སྐྱིད་ཤོད་དམར་པོ་རི་དང་ཡར་ཀླུངས་མེ་སྣ་རི་སོགས་ཏེ་འོན་ཀྱང་བཅོས་ཐབས་ཡོད་ཅེས་བྱ་སཀད།",
    "ཞྭ་ནག་པོ་གཅིག་གྱོན་འདུག་པས་གཏམ་ཕྱིས་སུ་རྒྱལ་པོས་གསན་པ་ན་ཉེས་པ་མེད་པའི་བརྡར་དགོངས་ནས་དམག་དཔོན་རྣམས་ལ་བཀའ་སྐྱོན་ཕེབས་པ་ཡིན་འདུག་ལོ་འདི་ལ་དབོན་པོ་དྷརྨ་པཱ་ལ་གདན་སར་བྱོན།",
    "འདི་པ་གོང་དུ་བྱོན་པ་རྒྱལ་པོ་ཨོལ་བྱ་ཐུལ་གྱི་རྒྱལ་སྲིད་སྐྱོང་བའི་དུས་ཡིན་ཚོད་འདུག་གདན་སར་ལོ་བཅུ་བདུན་བཞུགས་ནས་ཆུ་ཁྱི་ལ་གཤེགས།",
    "སླར་ཞལ་ངོ་སཀུ་མཆེད་མ་མཐུན་ཞིང་དཔོན་སྐྱ་སྟོང་པོ་སཀོར་གསུམ་ཡང་བླློ་མི་མཐུན་པ་སོགས་ནས་བར་སཀབས་ཞིག་དུས་མི་བདེ་བ་ཆེན་པོ་བྱུང་།",
    "རྩེ་ནས་གོང་མ་ཅུང་མ་དགྱེས་པ་ཡིན་འདུག་འདིའི་ཁོག་ལོན་པ་འདྲས།",
    "རྗེ་སྤྱན་སྔས་ལོ་བཅོ་ལྔ་ལོན་དུས་དབུས་སུ་བྱོན་པ་གདན་སར་བླླ་མ་མ་འཁོད་འདུག་པས།",
    "གཙང་རང་ནས་དཔོན་སྐྱ་དྲག་པ་མང་པོས་སྙན་སྒྲོན་ཕུལ་འདུག་ནའང་རིན་སྤུངས་པ་དཔོན་བླློན་གྱིས་མ་གསན་པར།",
    "སྔ་གོང་རྒྱ་ཧོར་ལས་ལས་ཀ་སླངས་པར་མི་འདུག་ཅིང་།",
    "སྣེ་གདོང་ནས་ཁྲི་དཔོན་གྱི་ལས་ཀ་བྱིན་པར་འདུག་བཀྲིས་དར་རྒྱས་པས་ཐུབ་ཆེན་གྱི་གསེར་སཀུ་གཙུག་ལག་ཁང་དང་བཅས་པ།",
    "དེ་དག་དུས་རིང་པོར་མི་ཐོགས་པར་དེ་བཞིན་ཏུ་འགྱུར་རོ།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ནའི་འགྱུར་སྨོན་ནི།",
    "འབད་རྩོལ་མེད་བཞིན་དུ་རབ་ཏུ་མྱུར་བར་རང་རང་༤༤ཐར་ལམ་གསལ་སྒྲོན་ལས།",
    "བདག་ལ་ཐིམ་ཞིང་རང་ལུས་འོད་དུ་ཞུ།",
    "པ་རྒྱ་མཚོ་ལྟར་མཐའ་མེད་པའི་མང་པོར་མི་སྐྱོ་ཞིང་ང་རང་རབ་ཏུ་དགའ་བའི་བསམ་པས་སྤྱད་པར་བགྱི་བར་གྱུར་ཅིག།",
    "སྒྲིག་སྦྱོར་བས་ཞུ་དག་མ་བྱས་པ་དང་ནོར་ནས་བསྒྲིགས་འདུག་པས།",
    "ཕལ་ཆེར་ཤཱཀྱ་བཤེས་གཉེན་གྱི་རྗེས་སུ་འབྲང་བར་འདུག་ཀྱང་།",
    "གསུང་སྲས་ཉན་ཐོས་དང་རང་རྒྱལ།",
    "བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བའི་ཉེས་པའི་ཚོགས་ཅི་མཆིས་པ་ཐམས་ཅད་བཤགས་པ་དང་།",
    "ཅི་ཡང་མི་དྲན་འདུག་ཞུས་པས།",
    "ད་ལྟ་བལྟས་ན་དགེ་སློང་དེ་འཕགས་པ་ཤཱ་རིའི་བུ་ཡིན་འདུག།",
    "དེའང་གང་ཡང་ངམ་གང་དག་དུས་གསུམ་གཤེགས་པའི་རྒྱལ་བ་གྲངས་མེད་པ་བློའི་དཔག་ཏུ་མེད་པ་ཇི་སྙེད་ཅིག་བྱོན་པ་དེ་ཡི།",
    "འབྲུག་ཐོག་ཉི་ལྡོག་དུས་གཏོར་དུ།",
    "གལ་ཏེ་མཐུན་ཐབས་བྱ་རྒྱུར་བློ་གྲོས་མཐུན་ཚེ་སྣེ་གཏུགས་པར་ང་རང་ངོ་མ་ཕྱིན་ཆོག་ལབ་ནས།",
    "དེ་ནས་ལ་ཞིག་འདུག་པ་བརྒྱབ་སྟེ་མར་བབ་ནས་འགྲོ་དུས་རྨར་ཁམས་ཁོངས་འགུ་ཤོད་གྲོང་དུ་མ་སླེབས་ཙམ་དུ་གཡས་གཡོན་གྱི་མི་སེར་ཚོས་མདའ་དཔོན་མ་ཕེབས།",
    "འདིར་མཐུན་སྣེ་གཏགས་པར་ཡོང་བ་ཡིན་ལབ་པས་ཁོས་ཨ་ཨ་ཟེར་ནས་གོ་བརྡ་འཕྲོད་ཀྱི་མི་འདུག་ངས་ཡང་བསྐྱར་ཁོ་ལ་ང་མགོ་བཏགས་པར་ཡོང་བ་ཡིན་ཟེ་ལབ་པས།",
    "ང་རང་ཉིད་ད་ནས་བཟུང་མི་སེར་དཀྱུས་མ་ཞིག་རང་བྱས་ཏེ་བསྡད་རྒྱུ་ཡོང་བ་ཞུ་རྒྱུ་དང་གསུམ་བཅས་ཡིན་ཞུས་པར་ཆབ་སྲིད་ཨུ་ཡོན་ནས།",
    "ཁྱེད་ཀྱི་གསུང་སྟངས་ཡག་པོ་འདུག་དོ་ནུབ་ཁྱེད་བཞུགས་སར་ཡར་ཕེབས།",
    "སྐབས་དེར་ང་རང་འགྲོ་དོན་ནི་ཞི་བདེར་གནས་པའི་དུས་ཤིག་ཡིན་རུང་།",
    "ཆབ་སྲིད་ཨུ་ཡོན་ནས་མདའ་དཔོན་ཁྱེད་རང་དེ་འདྲའི་ཐུགས་རུ་གཏུམ་པོ་གནང་མི་དགོས།",
    "ལུས་དང་ཁུ་ཚུར་སྟེང་དུ་འཕང་བ་དང་རྟིང་པ་འཕོངས་ལ་བརྡེབ་མར་ལོག་དུས་ཁུ་ཚུར་པུས་ཁར་བཞག་སྒྱིད་པ་གུག་བྱས་ནས།",
    "བག་བཞི་འཕག་ཅེས་པ་ནི་གན་རྐྱལ་བྱས་རྐང་ལག་བསྐུམས་ནས་སུག་བཞི་མགོ་བཅས་སྟེང་དུ་བསྒྲེངས་མར་ལོག་དུས་རྟིང་པ་འཕོངས་དང་།",
    "ཡི་དྭགས་འདུག་སྟངས་ཞེས་པ་ནི།",
    "མར་ལོག་དུས་རྟིང་པ་འཕོངས་དང་ལག་པ་བཅང་བག་བརྡུང་བ་བསྟུན་པ་གོང་བཞིན་ལན་གསུམ་ཐོག་ནས་རྐང་གཉིས་རྡོར་སྐྱིལ་བྱས།",
    "པུས་བཙུག་ཁྱི་འདུག་སྟོད་བསིག་གསུམ།",
    "པུས་བཙུག་ཁྱི་འདུག་སྟོད་བསིག་གསུམ་གྱི་དང་པོ་པུས་བཙུག་ནི།",
    "གཅའ་གཉའ་གཏའ་གདའ་གནའ་གཙའ་གཞའ་གཟའ་གཡའ་གཤའ་གསའ།",
    "ཀུན་ཏུ་ཁེངས་པ་ཡི་ང་རྒྱལ་ནི་བདག་འཛིན་དང་རང་བཞིན་གྱིས་བྲལ་བ་ཡོན་ཏན་རྡོ་རྗེ་དང་རིན་ཆེན་རིགས་རིན་འབྱུང་དང་།",
    "གཞན་ལ་ཕྲག་དོག་པ་ནི་བདག་གཞན་གྱི་རྟོག་པ་དང་རང་བཞིན་གྱིས་བྲལ་བ་སྟེ་ལས་ཀྱི་རིགས་དང་ཕྲིན་ལས་རྡོ་རྗེ་ཉིད་དུ།",
    "ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་མངོན་དུ་བྱེད་པའི་ལམ་གྱི་ཐོག་མ་འཇིག་རྟེན་པའི་ལམ་གྱི་ལོངས་སྐུར་ང་རང་སྨྲ།",
    "དཔེར་ནང་རང་བཞིན་གྱིས་གསེར་དང་ནམ་མཁའི་ཁམས་དང་ཆུ་ཁམས་འགྱུར་བ་མེད་པ་སྟོང་པ་དྭངས་པ་བཞིན།",
    "དེ་ལྟར་མྱོང་ཡང་རང་བཞིན་ཡང་དག་པའི་དབྱིངས་ཉིད་ལས་ཅུང་ཟད་ཀྱང་གཡོས་པའམ་གོལ་བའམ་ཉམས་པ་མེད།",
    "འདོད་ཆགས་ཆེ་བའི་ཚད་འགྲོ་རུང་འདུག་རུང་འཁྱུད་པ་ལ་སོགས་པའི་མི་བཟད་དུག་གསུམ་འབར་བ་ཡིས།",
    "སོ་སོ་རང་ཉིད་ཞི་བདེ་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་འབྲས་བུ་བསྒྲུབ་འདོད་པ།",
    "འཕགས་པ་དགྲ་བཅོམ་པ་དང་རང་རྒྱལ་བ་སྟེ་ལྔ་པོ་དེ་དག།",
    "དེ་ལྟར་སྣང་བའི་སེམས་ཉིད་ཀྱང་རང་རིག་པ་གསལ་ལ་ངོ་བོ་མི་རྟོག་པ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བས་འདོད་པའི་ཕྱི་རོལ་དོན་དུ་གྲུབ་པ་ཡོད་པར་མི་བརྟག་གོ།",
    "དེའི་ཚེ་གཟུང་བའི་ཡུལ་མེད་པས་དེར་འཛིན་པའི་སེམས་ཀྱང་རང་རིག་པ་ཙམ་ལས་མེད།",
    "དེ་ལྟར་རིག་པས་འཁྲུལ་སྣང་འདི་སྣང་ཡང་རང་བཞིན་མེད་པའི་སྒྱུ་མར་མ་བསྒྲུབ་ན།",
    "ཉེས་ལྟུང་རང་དང་གཞན་གྱི་དོན་དང་ལམ་དུ་མི་འགྱུར་བའི་མི་དགེ་མཐའ་དག་སྤངས་བྱ་དང་གཉེན་པོར་མ་ཞེན་པས་སྤོང་།",
    "ཞེ་སྡང་ཅན་ལ་མི་བསྐྱོད་པ་ལ་སོགས་པ་དུ་མའི་རྣམ་པར་རྡོ་རྗེ་འཆང་རང་ཉིད་འགྱུར་སྟེ། མཉམ་སྦྱོར།",
    "མཆོད་རྫས་མེ་ཏོག་སྣ་ཚོགས་དང་རང་ལོངས་སྤྱོད་པའི་ཤིང་ཏོག་ལ་སོགས་པ་འབྲས་བུ་གཙང་མ་ཡོད་པ་དང་།",
    "དེ་ནི་ཡོད་མེད་རྟག་ཆད་ལ་སོགས་པའི་སྤྲོས་པ་ཀུན་དང་རང་བཞིན་གྱིས་བྲལ་བ་སྟེ།",
    "གཅིག་པུར་འདུག་ཀྱང་འཁྲིག་དང་བཅས།",
    "སྲོག་དང་བཅས་པའི་སྲོག་ཆགས་མི་ལ་སོགས་པ་གཞན་རྣམས་ཀྱང་རང་དོན་གྱི་དུས་ལ་བབ་ན་གསོད་པ་དང་།",
    "དེ་ལ་པ་གོར་བི་རོ་ཙ་ན་དང་།",
    "ཞེ་སྡང་རྡོ་རྗེ་ལ་སོགས་པ་རང་རང་རྒྱུད་ཀྱི་སྟོན་པ་དེས་གདུལ་བའི་གདུལ་བྱའི་དོན་དུ་གསུངས། ནམ་མཁའ་ཆེ།",
    "དུས་ནམ་ཞེ་ན་གདོད་ནས་སྤྲོས་པའི་མཐའ་ཐམས་ཅད་དང་བྲལ་བར་རྒྱུ་རྐྱེན་ལས་མ་བྱུང་རང་བཞིན་གྱིས་ལྷུན་གྱིས་གྲུབ།",
    "རྟེན་ཁྱད་པར་དུ་འཕགས་པ་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོས་འགྲོ་བ་ལམ་ལ་འགོད་ཅིང་རང་ཉིད་ཀྱི་ལམ་སྦྱོར་བ་གོ་འཕང་འགྱུར།",
    "རྟོག་དཔྱོད་སྣ་ཚོགས་ཀྱི་བློས་བཙལ་ཀྱང་གནས་ལུགས་ཅི་ཡང་མ་ཡིན་པའི་ཕྱིར་མ་རྙེད་ཅིང་རང་ལ་ལྷུན་གྲུབ་ཏུ་འདུག་ཀྱང་དེ་མ་ཤེས། བསམ་མི།",
    "འདི་ནི་ཡོད་པར་སྒྲོ་འདོགས་པ་དང་མེད་པར་སྐར་པ་འདེབས་པ་ཐམས་ཅད་དང་རང་བཞིན་གྱིས་བྲལ་བ་སྟེ།",
    "འགག་པ་སྣང་ངམ་མི་སྣང་རང་རིག་མ་བཅོས་པས་རང་བཞིན་ཐ་མ་བལྟས་བྱས་ན།",
    "དང་པོ་རབ་ཏུ་དགའ་བ་ལ་སོགས་པའི་ས་འགའ་ལ་ཡང་རང་བཞིན་གནས་པ་མེད་པའི་ཡེ་ཤེས་དེ་གནས་མི་བྱེད་སྟེ།",
    "མཐའ་མི་རྟོགས་ཤིང་རང་མགོ་འཁོར།",
    "མིང་མེད་ནང་ནས་ཤར་ཙ་ན།",
    "གཟུང་འཛིན་སྤྲིན་ཕུང་རང་སར་དྭངས།",
    "ཅིར་སྣང་རང་གྲོལ་བདེ་ཆེན་ལ།",
    "སེམས་ཉིད་འོད་གསལ་རྟོགས་ཙ་ན།",
    "རང་རང་རྟེན་རྣམས་མྱུར་སྤོངས་ཏེ།",
    "རང་རང་ཏིང་འཛིན་མ་ཞེན་པར།",
