    "རལ་བ་ལྕང་ལོ་སྔོ་ནག་ནི་འོད་རིས་འཁྱུག་སེ་སོག་འདི་ཕྱི་གཉིས་ཀའི་འདོད་དོན་འགྲུབ་ཡོང་ཞེས་རྒྱབ་ལ་འཕྱང་འདུག་ཚུལ་དེ་མཐོང་བ་ན།",
    "མགོན་མིན་ད་དུང་སིལ་ཁོག་དམར་ཆེན་པོ་ཞིག་ཀྱང་ཁུར་པོ་མ་བུ་གཉིས་ལ་རྟེན་འགངས་ཆེན་ཞིག་ཡོད་པར་འདུག་པ་ན།",
    "ངས་ཀྱང་རྨི་ལམ་སྣ་ཚོགས་པ་ནས་བླངས་ཏེ་ཁོའི་ཁ་ནང་ལ་བརྫངས་འདུག་པ་ན།",
    "ཁོ་རྒོད་གཤོང་ཆེན་ནས་ཉི་མ་མང་བོར་འདུག་མི་ཚོ་གཏན་ནས་བསྒྲལ་མི་རུང་།",
    "རིགས་གསུམ་མགོན་བཞིན་གདའ།",
    "ཁོ་ཇོ་སྐྱབས་ཀྱི་རྗེས་ཆོད་བསླེབས་འདུག་པ་དང་།",
    "བཀྲ་ཤིས་ཉི་མས་ཁྲ་ཡིས་བྱེའུ་ཆུང་འདེད་པ་འདུག་པ་ལས་ཇོ་སྐྱབས་དང་ཐང་ག་གཉིས་ཀ་བཞིན་རྗེས་སུ་དེད།",
    "སྐབས་དེར་ཇོ་གཏེར་སྒོ་དེ་ག་དུས་དབྱེ་དགོས།",
    "ཆོ་ག་དང་མཚོ་དཀར་འཇིགས་ཞེན་དང་ཉམ་ང་ཅི་ཡང་མེད་པར་ཡང་མཁའ་ལྡིང་ཡིད་བཞིན་ནོར་བུའི་ཡང་སྲིད་སྲིད་ཀྱི་གཡས་ཕྱོགས་ན་བསྡད་འདུག་སྔགས་ཡིན་པར་བཤད།",
    "དུས་ལས་ཡོལ་ན་བར་ཆད་ཀླད་ལ་བསླེབས་འདུག་པ་ཐོས་འཕྲལ།",
    "བཞིན་གདའ།",
    "བཞུགས་འདུག་པ་མཐོང་བས།",
    "ནོར་འདུག་ན་ཡང་སྲིད་འཁྲུལ་འདུག་སྟེ།",
    "མ་ལྷན་དུ་སྦྲེལ་འདུག་རུང་།",
    "༢མཐིལ་ལ་བསླེབས་འདུག་པ་མཐོང་བྱུང་།",
    "༢ ༡༩ ༡ཁྱིམ་ལ་ལོག་དུས།",
    "ཤོག་བུ་ལྟེབ་མ་འགའ་བཟུང་འདུག་སྤྲོ་བསང་ལ་འགྲོ་ལུགས་འདི་འདྲ་ཞིག་ཡོད་དམ།",
    "གྱོན་གོས་རལ་ཅིང་སྐ་རགས་ལྷོད་འདུག་པ་ན།",
    "ཚོང་ཁྲོམ་ན་སྤྲེའུ་ངོ་མཚར་ཡིད་དུ་འོང་བ་ཞིག་འདུག་སྤྲེའུ་དེའི་མགོ་བོ་སེར་པོ་སེར་ལམ་མེར།",
    "རྣམས་ཀྱི་གདོང་ལ་རིག་རིག་ཏུ་བལྟས་ནས་འདུག་བ།",
    "ཏུ་དགའ་སྟེ་འདུག་མི་བཟོད་པར་གྱུར།",
    "ཤུགས་ཀྱིས་འབུར་འདུག་པ་མཐོང་བས།",
    "སྟོད་པོ་ཟེར་ན་མགོ་བོ་མི་འདུག་རྐང་ལག་ཡིན་ཟེར་ན་འགག་ཀྱང་དམར་ལམ་མེར་ས་ལ་ལྷུང་བ་ན།",
    "ཁོས་རྒྱ་མའི་དཀྱིལ་འཁོར་ལ་འཁྱིམས་ཉིས་བརྩེགས་སུ་དཀར་ནག་དང་སྒང་བ་བོད་ཀྱི་གནས་ཀུན་སེམས་བབས་ནས་མངོན་འདུག་པ་དང་།",
    "ཁྲོ་ཐུང་ཕོ་གདོང་ལ་སྡུག་ཉམས་ཤིག་ཤར་འདུག།",
    "ཇོ་སྐྱབས་ལ་ཁོང་ཁྲོ་ལངས་འདུག་པོས་དོགས་མི་བདེ་བའི་ངང་ནས་ཇོ་རུའི་ཞལ་ལ་གམ།",
    "ནས་བྲེལ་འཚུབ་སྐྱེས་ཏེ་འདུག་མི་བཟོད་པར་གྱུར།",
    "གྱིས་ཕུ་འདེབས་བཞིན་རྡོ་ལེབ་ངོས་ཀྱི་ས་རྡུལ་འདུག་སྔགས་འཆང་པདྨ་ཁྲོ་རྒྱལ་གྱིས་སྐྱོ་ལྷང་།",
    "སྐྱེ་ཎ་ཌ་ཎ་ལེབ་གཞན་ཞིག་འཇོག་དགོས་འདུག་པ་རྟོགས་ས་སྔགས་མི་འབྲི་བར་ཅི་འབྲི།",
    "ཀ་༥ ཀུན་མ་པདྨ་ཁྲོ་རྒྱལ་དང་ཇོ་སྐྱབས་གཉིས་ཀ་བྲག་ཁུང་དུ་གཡའ་ལེབ་ཅིག་བཙལ་ནས་གཡའ་མ་ཡི་གེ་ཁ་རོག་གེར་བསྡད་དེ་འབྲོ་བའི་དུས་ལ་ངང་སྒུག་བྱེད་བཞིན་གདའ།",
    "ཐབ་རྡོ་ཙམ་ཞིག་མ་གཏོགས་མི་འདུག་དེ་འདྲ་ཞིག་ཅི་ལ་བབ།",
    "དམིགས་པ་ལྷོ་ལ་གཏད་དེ་ནམ་སྨད་འགྲོ་བཞིན་གདའ།",
    "ཞོགས་པའི་དུས་སུ་རྡོ་དཀར་བཞིན་གདའ།",
    "འོན་ཀྱང་རང་ཉིད་སྙན་ངག་ལ་དུངས་པ་ཟབ་དྲགས་པའི་རྐྱེན་གྱིས་སྐྱོ་སྣང་དེ་ནི་ངས་ནམ་ཡང་རང་ཉིད་ཀྱི་བདེ་སྐྱིད་ཅིག་ཏུ་རྩི་བཞིན་ཡོད།",
    "ལ་ལ་ནི་ཁ་གཡང་ཙམ་དུ་གྱུར་འདུག་ལ།",
    "རིག་པའི་བུ་ཆུང་དེའི་ཐོབ་སྐལ་མི་འདུག།",
    "འགྲོ་ཐབས་འདུག་ཐབས་ཀྱི་བཙུན་པ་ང་ཡི།",
    "བླངས་ཀྱིན་བླངས་ཀྱིན་འཕུར་ཆོག་པ་ཞིག་ཡིན་འདུགདེ་བས་ན།",
    "དེའི་ཚེ་ཀུ་ལ་ལ་ལ་ལ་བར་སྣང་དང་ས་གཞི་མེད་པར་བསྣོགས་འདུག་ལ།",
    "སྤྱིར་ང་ནི་སྤྲིན་པ་ཁེར་འགྲོ་ཁེར་འདུག་ཅིག་ཡིན།",
    "སྤྱིར་ང་ནི་སྐར་མ་ཁེར་འགྲོ་ཁེར་འདུག་ཅིག་ཡིན།",
    "སྤྱིར་ང་ནི་གླང་རྒན་ཁེར་འགྲོ་ཁེར་འདུག་ཅིག་ཡིན།",
    "དམིགས་བསལ་བ་ཅང་མི་འདུག་ནའང་།",
    "གྲོགས་པོ་ཚོས་ང་འགྱུར་འདུག་ཟེར་ན།",
    "འགག་རྩ་གང་ལ་ཐུག་འདུག་བ་ཅི་ཡང་སྦྱིན་པར་མི་བྱེད་པའང་སྲིད་དེ།",
    "བལྟས་ཚོད་ཀྱིས་ཁོང་རང་ཉིད་ལ་སྦྱོར་བའི་ཆ་ནས་སྲོལ་རྒྱུན་གྱི་བསླབ་གཅུན་ལས་དེ་ལྟའི་འགལ་བ་མི་གནས་པའི་ཚུལ་དུའང་སྣང་དཔྱད་རྩོམ།",
    "བདག་མེད་ཀྱི་ལྟ་བ་ཞེས་པ་ནི་ནམ་ཡང་རང་དོན་བསམ་ན་ཆོག་པ་མིན་པར་གཞན་ཕན་བསམ་པ་སྟེ།",
    "མཐར་ཐུག་ན་འཆི་རག་བར་དུ་ཚན་རིག་བསླབས་ཀྱང་རང་ཉིད་ཅི་ལྟ་བུ་ཡིན་པ་ཤེས་ཀྱིན་མེད།",
    "བོད་རྒྱལ་པོའི་རིང་ལ་རྒྱ་བོད་བར་གྱི་འཐབ་འཁྲུག་དུས་རྒྱུན་དུ་ལངས་པ་ཡིན་ཏེ།",
    "གངས་ཀྱི་ཕ་ས་འདིས་ང་ཙམ་ཕྱིན་འདུག་ཆུ་ད་ལྟ་ཕྱིར་དྲན་ཞིག་བྱས་ཚེ།",
    "བའི་སྐྱོན་དུ་འདུག་སྙམ།",
    "ཁོས་གསར་རྩོམ་བྱེད་སྐབས་ཀུ་ཤུ་འབྲི་བཞིན་ཡོད་དམ་ཞེས་དྲིས་ན་འགྲིག་འདུག་རུལ་བ་དག་ཅོག་ཙེའི་གམ་དུ་བཤམས་ནས་དྲི་མ་ཡིན་ནའང་ཁོ་བོར་ལྟ་ཚུལ་གཞན་ཞིག་ཡོད་དེ།",
    "གྲངས་འབོར་གྱི་ཆ་ནས་དེ་འདྲ་མང་བོ་ཞིག་མི་འདུག་པ།",
    "ང་དགའ་སའི་སྙན་ངག་མང་བོ་ཞིག་འདུག་དེ་དག་ལས་དཔེར་ན་ཚིག་གསུམ་དང་ཐ་མག་རྔུབ་པའི་མི་ལྟ་བུ་སྟེ།",
    "བཞི་དང་རང་བཞིན་འབྲས་བུ་དང་།",
    "སྟང་སྟབས་བདུནའདུག་སྟབས་བཟླས་བརྗོད་དང་།",
    "གནས་དེར་ཡོ་བྱད་ཐམས་ཅད་ཚོགས་པར་བྱས་ལ་གདན་དང་ཁ་ཁལྟ་གོས་དང་འདུག་སྟངས་སོགས་ཀྱི་ཁྱད་པར་དང་ལྡན་པས་སྔོན་དུ་འབྱུང་པོ་ལ་གཏོར་མ་སྦྱིན་པར་བྱ་སྟེ།",
    "བསམ་གཏན་གནས་སུ་འདུག་པ་དང་།",
    "སྣང་ཡང་རང་བཞིན་མེད་བ་སྨིག་རྒྱུ་དང་འཇའ་ཚོན་ལྟར་བསམ་པ་ནི།",
    "ལྟ་བ་ཁྱད་པར་ཅན་མངོན་དུ་གྱུར་བ་དག་ལ་ལྷའི་སྐུར་སྣང་ཙམ་ཉིད་ནས་ངོས་བཟུང་མེད་པའི་སྣང་སྟོང་རང་རིག་ཏུ་འཆར་བས་གསར་དུ་ལྟ་བ་བསྐྱེད་མི་དགོས་ལ།",
    "གཞནནི་ལྷའི་སྐུར་སྣང་བའི་སྣང་ཆ་མ་འགགས་པར་དེ་ཉིད་ཀྱི་ངོ་བོ་ངོས་བཟུང་མེད་ཅིང་རང་རིག་པ་སྣང་སྟོང་དབྱེར་མེད་དུ་དུ་བ་པ་ཡིན་ཏེ།",
    "སྣང་བ་སྔུན་སྐྱེས་གཏན་ལ་ཕབ་པའི་ཚེ་སྣང་བ་མཐའ་དག་སྣང་ཆ་མ་འགགས་པར་སྣང་བཞིན་དུ་ངོས་བཟུང་མེད་པ་སྣང་སྟོང་རང་རིག།",
    "ཐོགས་པ་མེད་ཅིང་རང་བཞིན་སྟོང་པ།",
    "དང་བོའི་ཕྱག་གཉིས་རང་རང་རྟགས་མཚན་ལྡན།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་སྭཱཧཱ།",
    "སུམ་བྷ་ནི་བརྗོད་ཅིང་འབྲི་ཕྱོགས་བཞི་དང་རང་ལ་གཏོར་བ་དང་གནས་གསུམ་དུ་ཐིག་ལེ་བྱས་པས་གནས་དང་བདག་དང་རྣལ་འབྱོར་བསྲུངས་ཏེ།",
    "འོན་ཀྱང་རང་གཞན་གྱི་ཚོགས་རྗོགས་པ་དང་།",
    "འདི་ལྟ་སྟེ་དཔེར་ན་ཉི་མ་བསྒྲིབས་པ་མེད་པ་ནམ་མཁའི་དབྱིངས་ཡོངས་སུ་དག་པ་ལ་འདུག་པ་འམ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདི་ཅིའི་རྒྱུ་ཅིའི་རྐྱེན།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བཅྩིའི་རྒྱ་ཅིའི་རྐྱེན།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདི་ཅིའི་རྒྱ་ཅིའི་རྐྱེན།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདི་ཅིའི་རྒྱ་ཅིའི་རྐྱེན།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདི་ཅིའི་རྒྱ་ཅིའི་རྐྱེན།",
    "བཅོམ་ལྡན་འདས་འོད་ཆེན་པོ་འདི་ལྟ་བུ་གདའ་བ་འདི་ཅིའི་རྒྱ་ཅིའི་རྐེན།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་འདི་ལྟ་བུ་གདའ་བ་འདི་ཅིའི་རྒྱ་ཅིའི་རྐྱེན།",
    "འདུག་པ་དང་།",
    "ཉལ་བའི་ས་ཕྱོགས་དེ་དག་རྗོ་རྗེའི་རང་བཞིན་དུ་འདུག་པར་འགྱུར་སྙམ་ན་ཡང་།",
    "འདི་ནི་འདུག་པར་མི་འགྱུར་རོ།",
    "བདག་དེ་ལྟ་བུ་ཞིག་ན་འདུག་འདུག་སྟེ།",
    "ཡུན་ནི་འདི་སྲིད་གཅིག་ཏུ་འདུག་འདུག།",
    "འདི་ལྟར་དེས་ཡེ་ཤེས་དེ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་དང་། ། རང་བཞིན་གྱིས་དབེན་པ་དང་།",
    "བཅོམ་ལྡན་འདས་འདི་ལྟར་གཟུགས་ནི་ཡོངས་སུ་བཟུང་བ་མ་མཆི་པ་སྟེ་གཟུགས་ཀྱི་ཡོངས་སུ་གཟུང་བ་མ་མཆིས་པ་གང་ལུགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་གཟུགས་མ་ལགས།",
    "རྣམ་པར་ཤེས་པའི་ཡོངས་སུ་བཟུང་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་རྣམ་པར་ཤེས་པ་མ་ལགས་ཡང་དག་པའི་མཐའ་བར་དུ་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་སྟེ།",
    "ཡང་དག་པའི་མཐའི་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་པ་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་དུ་ཡང་དག་པའི་མཐའ་མ་ལགས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོད་པའི་སླད་དུ་ཡོངས་སུ་བཟུང་བ་མ་མཆིས་སོ།",
    "དོར་བ་མེད་པ་སྟོང་པ་ཉིད་དང་རང་བཞིན་སྟོང་པ་ཉིད་དང་།",
    "དེ་ལྟར་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་སེམས་ཟག་པ་མ་མཆིས་ཤིང་ཁམསུ་གསུམ་གྱི་ཁོབས་སུ་རྙེད་པ་མ་མཆིས་པའི་སེམས་དེ་ལ་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་སླད་དུ་ཆགས་པ་མ་མཆིས་པས།",
    "བྱས་པ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་སེམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆད་པ་མེད་དོ།",
    "ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་བྱས་པ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་སེམས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆད་པ་མེད་དོ།",
    "གཟུགས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "རྣམ་པར་ཤེས་པ་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཆུད་པ་མེད་དོ།",
    "གཟུགས་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་ཚུད་མ་མེད་དོ།",
    "རྣམ་པར་ཤེས་པ་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་དོ་པི་རྱ་བར་བྱིད་པུར་སྱོན་པ་མིན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར།",
    "འདུག་ན་འདུག་གོ་ཞེས་བྱ་བར་རབ་ཏུ་ཤེས་སོ།",
    "འདུག་པ་དང་།",
    "འགྲེང་ངམ་འདུག་སྟེ།",
    "གནས་མེད་ཅིང་འདུག་པ་མེད་ལ་ཉལ་བར་འགྱུར་བ་མེད་པས།",
    "དེ་དེའི་རིགས་ཡིན་པར་འདུག་སྟེ།",
    "དེ་དང་འདྲ་པོ་རང་ཞིག་འདུག་པས་ཟེར་བས།",
    "སྣང་བའི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དང་རང་བཞིན་གྱི་སྣང་བ་དང་ལས་ཀྱི་ལམ་རྣམ་པར་གཞག་པ་གཉིས་ནི་རྗེས་སུ་མྱོང་བའི་མཚན་ཉིད་དམ།",
    "ཞེས་སྨྲ་བའང་རང་ཉིད་ཀྱི་ནང་སྟོན་པར་ཟད་ལ།",
    "དབུགས་དབྱུང་རང་དགའ་ལྕེ་དང་ནི།",
    "དེ་ལྟ་བུའི་ཡུད་ཙམ་། གཉིས་ལས་ཐུན་ཕྱེད་པ་བཅུ་དྲུག་དུས་སྦྱོར་བཅུ་གཉིས་ཐུན་བརྒྱད་ཐུན་བཞི།",
    "དྭངས་མ་ལུས་ཟུངས་རང་རང་མེ་དྲོད་ཀྱི།",
    "དང་པོའི་ཉིན་ཞག་དུས་བརྩིས་ནས།",
    "རྟག་ཏུ་འབྱུང་ཞིང་རང་ལ་། གནས།",
    "ལྷའི་འཁོར་ལོར་སྣང་བ་དེའང་རང་སེམས་སྣང་བ་ལས་ལྷའི་ངོ་བོར་གྲུབ་པ་མེད་ཅིང་སྣང་ཡང་རང་སེམས་སྣང་ལ།",
    "མཐོང་ཡང་རང་སེམས་མཐོང་བའོ།",
    "པདྨའི་འདུག་སྟངས་དང་།",
    "འདུག་སྟངས་རྣམ་པར་དག་པ་གཡོ་བ་མེད་པའོ།",
    "ཐོག་མར་རྐང་པ་གཉིས་འདུག་སྟངས་སུ་བྱས་ནས།",
    "སྣང་བ་གསུམ་པོའང་རང་རིག་དེ་དང་དུས་མཉམ་པ་ནི་མ་ཡིན་ཏེ།",
    "སྟན་ཡང་གཅིག་ལ་མི་འདུག་གོ།",
    "གསང་ལ་སྦྱོར་བའི་དུས་ཙ་ན།",
    "སླར་ཡང་རང་བྱིན་བརླབ་པ་ཡིས་། བྱིན་གྱིས་བརླབ་པར་བྱ་བ་ཡིན།",
    "དེའང་རང་བཞིན་འོད་གསལ་དང་།",
    "དུས་དེར་ལས་ཀྱི་ཕྱག་རྒྱ་དང་སྙོམས་པར་ཞུགས་ཤིང་བསྲུབས་པ་ལས་ཐིག་ལེས་རྡོ་རྗེའི་རྩ་བར་བསླེབ་ཙ་ན་རང་བཞིན་སུམ་ཅུ་རྩ་གསུམ་འགགས་བདེ་བའི་ཡེ་ཤེས་དེ་ལ་སྟོང་པས་རྒྱས་བཏབ་ཏེ་བསྒོམ།",
    "ཐིག་ལེས་རྐེད་པར་བསླེབ་ཙ་ན་རང་བཞིན་བཞི་བཅུ་འགགས་ཏེ་བདེ་བའི་ཡེ་ཤེས་དེ་ལ་ཤིན་ཏུ་སྟོང་པས་རྒྱས་བཏབ་ནས་བསྒོམ།",
    "ཐིག་ལེས་རྡོ་རྗེའི་བུམ་པར་བསླེབ་ཙ་ན་རང་བཞིན་བདུན་འགག།",
    "དེ་ལ་གོམས་པར་བྱས་པས་གཉིད་དུས་དེའི་ཤེས་པ་ཐམས་ཅད་འོད་གསལ་དུ་དེངས་པས་ལམ་དང་རང་བཞིན་གཅིག་ཏུ་འགྲོ་བའི་ཕྱིར།",
    "བདག་མེད་པ་ཁོང་དུ་ཆུད་པས་གཞན་གྱིས་འཚེ་བའི་མཚན་མ་མི་འབྱུང་ཞིང་རང་བཞིན་སྤྱོད་ལམ་སྨད་དུ་མེད་པའི་ལས་གསུམ་ཡོངས་སུ་དག་པའི་བསྲུང་བ་ཆེན་པོ་ཕུན་སུམ་ཚོགས་པ་ལ་མི་འཇིགས་པ།",
    "སྐྱེ་བ་སྣ་ཚོགས་སྤྲལ་པའི་སྐུ་དེའང་རང་ལ་རང་ཆས་སུ་ཡོད་པའི་ཕྱིར་ཉེ་བས་གཉེན་ནམ་མཛའ་བཤེས་ཞེས་བྱའོ།",
    "རྒྱུད་ལ་རྟོགས་པ་ཤར་ཙ་ན།",
    "མི་སློབ་པར་ནི་གྱུར་ཙ་ན།",
    "ཇི་ལྟར་འདུག་པ་དེ་ལྟར་འཆི་བ་དང་།",
    "སྦྱོར་བ་ནི་ཟུང་འཇུག་སྟེ་རང་བཞིན་གྱི་འོད་གསལ་ངོས་ཟིན་པ་དང་རངནུས་སྣང་གསུམ་གྱི་འོད་གསལ་རང་རིག་ཙམ་མངོན་དུ་བྱས་པ་སྟེ།",
    "༦རྒྱལ་རྩེའི་མདའ་དམག་དུས་ཆེན།",
    "ཆང་ས་རྒྱག་དུས་མནའ་མར་བསྐོན་རྒྱུའི་སོག་ཞྭ།",
    "སྲོལ་རྒྱུན་བཟང་པོ་དེ་ད་ལྟའི་བར་བོད་མི་ཡོངས་ནས་སྔ་དྲོ་རང་རང་འཁོས་འབྱོར་དང་བསྟུན་རྣམ་དཀར་མཆོད་འབུལ།",
    "ས་པཎ་ཀུན་དགའ་རྒྱལ་མཚན་གྱིས་ཁོང་རང་ལ་གྲུབ་ཆེན་འདའ་འཕྱར་བས་གནང་བའི་ཕུར་པ་དེ་བཙུགས་པས།",
    "གཏན་དུ་བདེ་བ་ཐོབ་པར་ཤོག་དུས་སང་ད་ཚོད་ཁྲ་རོག་རོག་བྱས་ནས་མཇལ་རྒྱུ་ཡོང་བ་ཤོག་ཅེས་པ་དང་།",
    "༦རྒྱལ་རྩེའི་མདའ་དམག་དུས་ཆེན།",
    "སྲོལ་རྒྱུན་དེ་ད་ལྟའི་བར་རྒྱུན་བསྲིངས་ནས་འདམ་སྤྱི་རིམ་ཞེས་པའི་རྟ་རྒྱུག་དུས་ཆེན་དེ་གཏོང་སྲོལ་དུ་གྱུར།",
    "འདམ་སྤྱི་རིམ་ཞེས་པའི་རྟ་རྒྱུག་དུས་ཆེན་གྱི་ནང་དོན་གཙོ་བོ་ནི།",
    "རྟ་རྒྱུག་དུས་ཆེན་གཏོང་བའི་དུས་ཚིགས་དེ་ནི་ཏག་ཏག་དབྱར་དུས་ཀྱི་ལས་ཀ་མཇུག་བསྒྲིལ་ཞིང་།",
    "སྒེར་ཁང་རང་བདག་ཡིན་ན་ཁང་པའི་བཟོ་བཀོད་ཐད།",
    "ཞེས་སྲིད་པ་ཆགས་པའི་ལྷ་དགུའི་ཡབ་ཡིན་པའི་ལུང་ཁུངས་ཀྱང་འདུག་གོ།",
    "སྤྱིར་སྣོད་ཀྱི་འཇིག་རྟེན་འདི་ཉིད་ཀྱང་རང་བཞིན་ལྷུན་གྱིས་གྲུབ་པའི་མཆོད་རྟེན་གྱི་རང་བཞིན་ཡིན་པར་གསུངས་ཏེ།",
    "ཚ་ཚ་རྒྱག་དུས་འདམ་བག་རློན་པ་ལུགས་ཀོང་ནང་བླུགས་དཔར་རྗེས་མར་བཏོན་ནས་ཉི་མར་སྐམ་དགོས་པ་དང་།",
    "སྟོང་པའི་དྲིལ་བུ་གསུང་རང་བཞིན།",
    "རང་རང་གནས་ཀྱི་ཕྱོགས་སུ་དགྲམ།",
    "ས་ཐག་རིང་བར་འདུག་པས་ད་ལན་འཁུར་བའི་གྲོགས་སམ་ཁལ་མ་གཅིག་ཡོད་ན་བསམ།",
    "བྱ་དེས་དེ་བཞིན་བྱེད་པས་རྒྱལ་པོ་ཐེ་ཚོམ་སྐྱེས་ཏེ་ཤིང་བུ་དེ་ལ་བལྟས་ན་བརྟག་དཔྱད་བྱས་པས་སྔར་མེད་ཀྱི་ཤིང་དུ་འདུག་ཅིང་།",
    "ཆུ་ཆེན་པོ་ཞིག་འདུག་པས་ཆུ་ལ་ནི་འགྲོ་མ་ནུས།",
    "ཆུ་ཁ་ཞེང་ཆེ་བ་མ་གཏོགས་གཏིང་ལ་མི་ནུབ་པར་འདུག་པས་སེམས་དགའ་སྟེ།",
    "ཡོན་ཏན་འདི་འདྲ་དང་འདི་འདྲ་ཡོད་པས་ཁྱེད་ཀྱི་ཐུགས་ལ་སུ་ཞིག་བབ་པ་འདུག་གམ་ཞེས་འདྲི་སྲོལ་ཡོད་ཅིང་།",
    "དྲི་བར་ལན་འདེབས་མི་ཐུབ་ན་ཚང་མ་བཞད་གད་ཤོར་ངེས་དང་རང་ཉིད་ངོ་ཚ་ཡོང་རྒྱུ་ཙམ་ལས་གང་ལྟར་བག་མ་བསུ་ཐུབ།",
    "གཞི་རྩའི་སྟངས་སྟབས་སུ་རང་སར་རྐང་པ་བརྐྱང་བསྐུམ་དང་རང་སར་རྐང་པ་འདེགས་འཇོག་རྐང་པ་མདུན་བདར།",
