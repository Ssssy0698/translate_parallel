    "སྐྱྲེ་བའི་སོར་གྱུར་཈ིད་དུ་གསུངས།",
    "མྱ་ངན་ལས་འདས་པར་བགོད་པའི་ཕྱིར་འགའ་ལ་ཡང་ཆགས་པ་མྲེད་པའི་ཕྱིར་རོ།",
    "མཚན་཈ིད་འདི་དག་ཡིན་པར་བརོད།",
    "མི་འཁྲུགས་མཚན་཈ིད་ཅན་དུ་གསུངས།",
    "དྲེ་དག་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་ཁོ་བ་མྲེད་པའི་མཚན་཈ིད་ཅན་དུ་གསུངས་ཏྲེ།",
    "དངོས་པོ་མ་དམིགས་པས་རྣམ་པར་རོག་པའི་དྲི་མས་཈ྲེ་བར་མ་སྦགས་པའི་ཕྱིར་ན།",
    "མཚན་཈ིད་རྣམ་པར་གོལ་བྱྲེད་པའོ།",
    "སྟོབས་རྣམས་ཤིན་ཏུ་རྣམ་པར་ནི།",
    "གཏན་ལ་འབྲེབས་པའི་རང་བཞིན་གསུངས།",
    "འཆད་པར་འགྱུར་བའི་སྟོབས་བཅུ་ནི་ཤིན་ཏུ་གཏན་ལ་འབྲེབས་པའི་མཚན་཈ིད་ཅན་དུ་རིག་པར་བྱ་སྟྲེ།",
    "ཤིན་ཏུ་རྣམ་པར་གཏན་ལ་འབྲེབས་པ་཈ིད་ཀྱིས་ཐོགས་པ་མྲེད་པའི་མཚན་཈ིད་ཡིན་པའི་ཕྱིར་ན་སྟོབས་རྣམས་ཞྲེས་བྱའོ།",
    "ཀྱྲེ་མ་དྲེ་ལ་ཟག་པ་འདི་རྣམས་ཟད་པར་མ་གྱུར་ཏོ་ཞྲེས་བྱ་བར་བདག་ལ་དགྲེ་སྦྱོང་ངམ་ཞྲེས་བྱ་བ་ལ་སོགས་པ་འབྱུང་ངོ།",
    "སྡུག་བསྔལ་ཡང་དག་པར་ཟད་པར་འགྱུར་བར་ངྲེས་པར་མི་འབྱུང་ངོ་ཞྲེས་བྱ་བ་དྲེ་ལྟ་བུའི་གནས་མྲེད་དྲེ་ཞྲེས་བྱ་བ་རྒྱས་པར་འབྱུང་ངོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ནི།",
    "འཆད་པར་འགྱུར་པ་རྣམས་ཏྲེ་དྲེ་དག་ནི་ཆད་པ་མྲེད་པའི་མཚན་཈ིད་ཅན་ནོ།",
    "ཐུགས་མ་཈མ་པར་མ་གཞག་པ་མི་མངའོ།",
    "རྣམ་པར་གོལ་བ་཈མས་པ་མི་མངའོ།",
    "འཁྲུལ་པ་ལ་སོགས་པ་མི་མངའ་བས་གགས་མྲེད་པ་཈ིད་ཀྱིས་ཐུབ་པར་མི་ནུས་པ་཈ིད་ཀྱི་ཕྱིར་རོ།",
    "ཀུན་ཏུ་ལྟ་བ་དང་རྣམ་པར་ལྟ་བ་དང་བསྐུམ་པ་དང་རོང་བ་དང་།",
    "ཡང་དག་པར་སྨྲ་བ།",
    "སྲེམས་ཅན་ཐམས་ཅད་ཚིམ་པར་བྱྲེད་པའི་ཚིག་དང་ལྡན་པའོ།",
    "སྐད་ཅིག་བརོད་པས་སྲེམས་ཅན་ཐམས་ཅད་ཀྱི་བསམ་པ་ཚིམ་པར་བྱྲེད་པ་སྟྲེ།",
    "སྲེམས་ཅན་ཐམས་ཅད་ཀྱིས་བཀུར་སྟི་བྱས་ཀྱང་མཐོ་བར་མི་སྲེམས།",
    "སྲེམས་ཅན་ཐམས་ཅད་ཀྱིས་བཀུར་སྟི་མ་བྱས་ཀྱང་སྲོ་ཤི་བར་མི་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་གཞན་ཡང་དྲེ་བཞིན་གཤྲེགས་པ་ལ་སྲེམས་མ་཈མ་པར་མ་གཞག་པ་མྲེད་དྲེ།",
    "དྲེ་བཞིན་གཤྲེགས་པ་ནི་འཆག་གམ་ཞྲེས་བྱ་བ་རྒྱས་པར་འབྱུང་སྟྲེ།",
    "གནོད་པ་བྱས་པ་རྣམས་ལ་ལན་དུ་གནོད་པ་བྱྲེད་པ་མྲེད།",
    "སྲེམས་ཅན་ཡོངས་སུ་སིན་པར་བྱ་བ་དང་།",
    "དྲེ་བཞིན་གཤྲེགས་པའི་འདུན་པ་ནི་ཡྲེ་ཤྲེས་སྔོན་དུ་འགོ་བ་཈ིད་དྲེ་དྲེའི་ཕྱིར་ཞྲེས་བྱ་བ་རྒྱས་པར་འབྱུང་སྟྲེ།",
    "ད་ལྟར་བྱུང་བའི་སྲེམས་ཅན་རྣམས་ཀྱི་སྲེམས་ཀྱི་རྒྱུད་ལ་རྣམ་པར་བལྟས་ཀྱང་དྲེ་བཞིན་གཤྲེགས་པ་ལ་བསྲེལ་བ་ཤིན་ཏུ་མྲེད་དོ།",
    "དྲེ་བཞིན་གཤྲེགས་པས་ནི་ཕུང་པོ་གསུམ་དུ་རྣམ་པར་དགོད་པ་དང་།",
    "དྲེ་ཇི་ལྟར་བདག་ཅྲེས་བྱ་བ་རྒྱས་པར་འབྱུང་སྟྲེ།",
    "ཅིའི་ཕྱིར་དྲེ་བཞིན་གཤྲེགས་པའི་ཏིང་ངྲེ་འཛིན་཈མས་པར་མི་འགྱུར་ཞྲེ་ན།",
    "དྲེའི་ཕྱིར་མ་཈མ་པར་གཞག་པ་ཞྲེས་བྱའོ་ཞྲེས་བྱ་བ་ནས་ཁམས་གསུམ་ཆར་ལ་ཡང་མི་གནས་པའི་ཕྱིར་཈མས་པ་མྲེད་དྲེ།",
    "དྲེ་བཞིན་གཤྲེགས་པ་སྲེམས་ཅན་ཐམས་ཅད་ཀྱང་ཏིང་ངྲེ་འཛིན་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཞྲེས་བྱ་བ་ལ་སོགས་པའི་བར་དུ་འབྱུང་སྟྲེ།",
    "ཐྲེག་པ་གསུམ་རྣམ་པར་དགོད་པར་བསྟན་པ་ཤྲེས་པའོ།",
    "རིགས་ཀྱི་བུ་གཞན་ཡང་དྲེ་བཞིན་གཤྲེགས་པའི་རྣམ་པར་གོལ་བ་཈མས་པ་མྲེད་དོ།",
    "དྲེ་ལ་རྣམ་པར་གོལ་བ་སྟྲེ།",
    "཈ན་ཐོས་རྣམས་ཀྱི་རྣམ་པར་གོལ་བ་ནི་སའི་རྲེས་སུ་འགོ་བའོ།",
    "རྣམ་པར་གོལ་བ་ནི་རྲེན་ཁོང་དུ་ཆུད་པའོ།",
    "མིག་དང་གཟུགས་ལ་ག་཈ིས་སུ་འཛིན་པ་ལས་རྣམ་པར་གོལ་བའོ།",
    "ཆད་པར་ལུང་སྟོན་པའོ།",
    "དྲེ་བཞིན་གཤྲེགས་པའི་ངག་དྲེ་ཡང་ཀུན་ཤྲེས་པར་བྱྲེད་པའོ།",
    "རྣམ་པར་ཤྲེས་པར་བྱྲེད་པའོ།",
    "རྣམ་པའི་མཆོག་ཐམས་ཅད་དང་ལྡན་པའོ་ཞྲེས་བྱ་བའི་བར་ཡན་ལག་དྲུག་ཅུ་དང་ལྡན་པར་བརོད་པར་བྱ་ཞིང་།",
    "དྲེ་བཞིན་གཤྲེགས་པ་ནི་སྲེམས་ཀྱིས་བརོད་པར་བྱ་བ་མ་ཡིན།",
    "བདུད་ཀྱི་ལས་ཐམས་ཅད་ལས་རྣམ་པར་གོལ་བའོ་ཞྲེས་བྱ་བའི་བར་དང་།",
    "གཞན་ཡང་འདས་པའི་དུས་ལ་ཡྲེ་ཤྲེས་མཐོང་བ་ཆགས་པ་མྲེད་ཅིང་ཐོགས་པ་མྲེད་པར་འཇུག་གོ།",
    "ཇི་སྲེད་ཅིག་ཐྲེག་པ་ཆྲེན་པོ་ལ་བཏུལ་བ་དྲེ་དག་ཐམས་ཅད་རབ་ཏུ་ཤྲེས་སོ་ཞྲེས་བྱ་བ་རྒྱས་པར་འབྱུང་ཞིང་སྲེམས་ཀྱི་རྒྱུད་ཀྱང་རབ་ཏུ་ཤྲེས་སོ།",
    "རིགས་ཀྱི་བུ་གཞན་ཡང་མ་འོངས་པའི་དུས་ལ་དྲེ་བཞིན་གཤྲེགས་པའི་ཡྲེ་ཤྲེས་མཐོང་བ་ཆགས་པ་མྲེད་ཅིང་ཐོགས་པ་མྲེད་པར་འཇུག་གོ།",
    "མ་འོངས་པའི་སྲེམས་ཀྱི་རྒྱུད་བསྐལ་བར་འགྱུར་བ་མ་ཡིན་པར་མ་འོངས་པ་ལ་ལྟ་བས་ཟླ་གགས།",
    "རིགས་ཀྱི་བུ་གཞན་ཡང་ད་ལྟར་བྱུང་བའི་དུས་ལ་དྲེ་བཞིན་གཤྲེགས་པའི་ཡྲེ་ཤྲེས་མཐོང་བ་ཆགས་པ་མྲེད་ཅིང་ཐོགས་པ་མྲེད་པར་འཇུག་གོ།",
