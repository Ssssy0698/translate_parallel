    "ལས་དམག་རྣམས་ཧ་ལས་པའི་ངང་དུ་མགོ་གཡུག་མེ་གླིང་རྒྱལ་བློན་རྣམས་ཀྱང་རང་ཡུལ་དུ་གཡུག་བྱེད་བཞིན་འདུག་ལ།",
    "ངེད་རང་རྒྱལ་བློན་རྣམས་འཇའ་ཡུལ་དུ་བྲོས་ཀྱང་ཐར་བ་མི་འདུག་པས།",
    "མེ་གླིང་རྒྱལ་བློན་རྣམས་ཀྱིས་བྱུ་རུའི་རབ་གསལ་ཁ་ནས་ཤེལ་གྱི་རྒྱང་མཐོང་བཙུགས་ཏེ་བལྟས་ཙ་ན།",
    "གེ་སར་གྱིས་དམ་རྫས་དུག་གྲི་ནག་པོ་དེ་ལན་གསུམ་གཡུགས་རྗེས་གླང་ཆེན་རྣམས་ཐང་དུ་འགྱེལ་བར་གདའོ།",
    "ཟེར་བའི་དཔེ་དེ་བདེན་པར་འདུག།",
    "གདའ་ལི་ཁྱི་བཞིན་ཞགས་པས་བཟུང་།",
    "མི་འདུག་འཇའ་ཡི་ཡུལ་ལ་འགྲོ།",
    "བསྐལ་བ་མ་སྟོང་བར་དུ་མ་གཏོང་ཟེར་བའི་ཡི་གེ་ཡང་བྲིས་པར་གདའོ།",
    "དེ་ནས་དཔའ་རྟུལ་རྣམས་ཀྱིས་དབུ་ཐོད་ཡང་ཡང་གཏུགས་ཤིང་མིག་མཐར་མཆི་མས་ཁེངས་ཤིང་འདུག་པ་ན།",
    "ཟེར་ཏེ་ངུ་འབོད་བྱེད་ཅིང་རྒྱ་ཚའི་ལག་པར་འཇུས་འཇུས་བྱས་ཙ་ན།",
    "ཕལ་ཆེ་བར་འདི་ཉིད་རྒྱུས་མེད་དུ་འདུག་པས།",
    "དེས་ནི་སྐད་རིགས་བཞི་ནི་ལེགས་སྒྱུར་དང་རང་བཞིན་དང་ཟུར་ཆག་དང་ཤ་ཟའི་སྐད་བཞི་ཡིན་ལ།",
    "ཅེས་པའི་བར་མཚན་ཉིད་དེ་ལྡན་གྱི་མཚན་གཞི་བསྟན་བཅོས་ངོས་བཟུང་སྟེ་བརྡ་འཕྲོད་པར་མཛད་རྒྱུ་འདུག་པའི་ཕྱིར་རོ།",
    "སྐབས་འདིར་ཕྱིས་ཀྱི་འགྲེལ་པ་ཕལ་ཆེར་ལས་ནོར་བ་ཁོ་ནར་འཆད་འདུག་ཀྱང་དགག་གཞག་མི་སྤྲོ་སྟེ་འོག་ཏུ་རྒྱ་འགྲེལ་གྱིས་ཁ་སྐོང་བའི་དཔེར་བརྗོད་འཆད་པས་རྟོགས་པར་འགྱུར་རོ།",
    "འབྱུང་འགྱུར་ནུ་མ་མི་ཤོང་བ་འདི་ལ་ངེས་པར་མ་བརྟགས་པར་སྔོན་འཇིག་རྟེན་གྱི་བྱེད་པོ་ལྷ་ཚངས་པས་ནམ་མཁའ་འདི་རྒྱ་ཆུང་ངུར་སྤྲུལ་འདུག་པའི་ཕྱིར་རོ།",
    "སྙན་ངག་སརྒས་བཅིངས་པ་སོགས་ལའང་རང་བཞིན་བརྗོད་པ་འདི་ཉིད་རྒྱན་དུ་འདོད་དོ།",
    "འཕགས་ཡུལ་ཙནྡྲ་གོ་མི་དངོས་འདུག་ཀྱང་།",
    "ནམ་མཁའ་སྔོ་བསངས་གསལ་ཡང་རང་འོད་མིན།",
    "ར་རིའི་དྲི་མ་དང་ལྡན་ཞིང་རང་བཞིན་སེམས་མེད་བེམ་པོའི་རང་བཞིན་བླུན་པར་གྱུར་པ་ཟླ་བ་ལ།",
    "གཟུགས་མཚུངས་ཀྱི་སྒྲ་ས་རཱུ་པ་གཟུགས་ཀྱི་སྐད་དོད་ཡིན་མིན་དཔྱད་གཞི་སྣང་ཡང་དཔེ་དོན་འགྲིག་ཕྱིར་མི་རུང་བ་མི་འདུག་དེའི་ཚེ་མཉམ་པའང་གཟུགས་མཉམ་དུ་སྦྱར་བ་དང་།",
    "དྲི་བསུང་རང་འཐུལ་གཞན་ཕན་འབྲས་བཟང་ཅན།",
    "གྲོགས་ཁྱེད་རང་ཡུལ་གཤེགས་པར་སྤྲོ་ན་ཡང་།",
    "བསམ་དོན་སྐྱེས་བུའི་སྐབས་སུ་སྐྱེ་བོ་ངན་པ་དང་མི་འགྲོགས་ཤིང་རང་བཞིན་གྱིས་བསམ་པ་བཟང་པོ་མངར་བའི་བདག་ཉིད་ཅན།",
    "དེ་བཞིན་ཐེ་ཚོམ་ཕུལ་བྱུང་སོགས་ཀྱང་རང་བཞིན་གསལ་ཕྱིར་དཔེར་བརྗོད་ཅུང་ཟད་དེ་འགའ་ཙམ་བསྟན་པར་བྱའོ་ཞེས་མཚམས་སྦྱར་རོ།",
    "བག་ཆགས་འབྱུང་འདུས་ཁམས་ཀྱང་རང་སར་ཞི།",
    "ཐོག་མ་ནུས་པ་བརྟག་པའི་ཕྱིར་ཉི་མ་འགུགས་པའི་སྔགས་བྱས་པས་ཉི་མ་འོངས་ཙ་ན་མ་ཡོང་བྱས།",
    "དེ་དག་དུས་སར་དགའ་བ་ཡི།",
    "དེ་རྣམས་ཡིད་འོང་རང་བཞིན་ནི།",
    "སྤྲིན་གྱིས་རྩོམ་པའང་རང་བཞིན་གྱིས།",
    "དེ་དག་ཁོ་ན་འདུག་པ་དམན་པའི་རོ་མྱོང་བ་དེས་མཆོག་ཏུ་སྟེ་ཤིན་ཏུ་རྒྱུ་ཞིང་འགྲོ་བར་བྱེད་དོ།",
    "ཡང་རྟག་པའི་ངོ་བོ་ཉིད་ཕྱིར་འཆི་བདག་དུས་ཀྱིས་ནམ་ཡང་གཟུང་བྱ་མིན་ཞིང་།",
    "ན་མེ་ཀ་ཙ་ན་ཀཱ་མི་ཏཱ།",
    "མཁསངག་སྙན་སྔར་འཁོར་ལོ་རྩོམ་པ་རྣམས་ཀྱིས་གོ་དོན་འབྲེལ་མེད་པ་ཁ་ཁྲལ་ཙམ་ལས་མ་བྱུང་བ་འདུག་པས་འདིར་གཞུང་དོན་དང་མཐུན་པར་ཚིག་དོན་གཉིས་ཅར་འབྲེལ་བཟང་པོའི་དཔེ་རྒྱུན་འཛུགས་པ་ཡིན།",
    "ཕལ་ཆེར་གྱིས་སྒྲ་སྒྲུབ་ནོར་བ་འདུག་པས་འདིར་དག་པར་བྱས་ཡོད་དོ།",
    "འདུག་ཀྱང་འདར་ལྡན་བདག་ལ་ནི།",
    "རྒྱུང་ན་འདུག་པའི་མ་མ་དེས།",
    "དེ་ལྟར་ཡང་རང་བཞིན་གྱིས་དག་ཅིང་དྭངས་པའི་ཤེལ་དག་ནི་དག་པར་འདུ་བྱེད་པའི་བྱ་བ་གཞན་ལ་ལྟོས་པ་མེད་པ་མིན་ནམ་ཞེས་རིག་བྱེད་ཀྱི་ཆོ་ག་དང་འགལ་བའོ།",
    "བློ་བརྟན་བཞི་པ་སོགས་ཀྱིས་འགྱུར་བཅོས་མཛད་འདུག་ཀྱང་རྒྱ་འགྲེལ་གཇིགས་མ་ནུས་པས་ཕལ་ཆེར་དཔང་ལོས་ལེགས་པར་བཅོས་པ་རྣམས་སླར་ལོག་པར་བཅོས་པ་ཙམ་ལས་མ་བྱུང་ཞིང་།",
    "སླད་ནས་བློ་བརྟན་བཞི་པའི་འགྱུར་ཐོག་རིན་སྤུངས་པས་ཀྱང་དཔང་ལོ་ལ་ཟུར་ཅུང་ཟད་ཟ་བས་འགྱུར་བཅོས་པ་རྣམས་ནི་དེ་བས་ཀྱང་ལོད་དུ་བཏང་བ་ལས་མ་བྱུང་འདུག་པས།",
    "དེའི་སྟེང་རང་ཉིད་ཀྱིས་ཁ་སྐོང་འགའ་ཞིག་ཀྱང་གསར་དུ་བསྣན།",
    "འགྲོས་མྱུར་མགྱོགས་རྟ་མཆོག་བརྒྱུགས་པ་དང་འདྲ་འདུག།",
    "རང་རང་དགའ་འཛུམ་གྱི་གེ་སར་ཉི་གཞོན་དམར་པོའི་ཕྱོགས་སུ།",
    "ལྡན་ཡང་རང་མཉམ་བློ་ལྡན་གཞན་དག་དང་།",
    "སྐབས་འདིར་དཔེར་བརྗོད་ལ་ཡི་གེ་རྩུབ་པ་ཉུང་ཞིང་འཇམ་པ་ཤས་ཆེ་བ་བྱས་འདུག་པ་དཔེར་བརྗོད་དང་མཚན་ཉིད་མི་མཐུན་ནོ་སྙམ་ན།",
    "རང་རང་གང་འདོད་གནས་སུ་བགྲོད།",
    "རིང་དུ་བཙལ་ཡང་རང་ཉིད་ངལ་བ་ཙམ།",
    "ལྷ་རྣམས་ཀྱི་དཔལ་ཕུན་ཚོགས་པ་གང་ན་གནས་པ་ཐམས་ཅད་ཀྱང་རང་ཉིད་ཀྱིས་བླངས་སོ།",
    "རང་རང་ཆབ་སྲིད་དགོས་མཁོར་བསྟུན་བྱས་ཏེ།",
    "དུས་དང་མཐུན་པར་རང་རང་འགྲོས་ཀྱིས་འཁོར།",
