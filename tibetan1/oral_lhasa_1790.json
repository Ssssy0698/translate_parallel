    "སྒྲུབ་ཐབས་འདིར་བསྟན་པ་འདི་བཞིན་ཞགས་ན་ཡང་དག་པར་གྲབ་པར་འགྱར་བས་ཡང་དག་པར་གྲབ་པ་ཞེས་བྱ་ཞིང་།",
    "དེ་ནི་ལམ་དམན་པ་གཞན་གྱིས་ཐོབ་པར་མི་ནས་ཏེ།",
    "ཁྲག་ནི་དམར་བ་དང་རླན་པར་གྱར་པ་སོགས་ཀྱིས་མཚན་པ།",
    "གདལ་དཀའི་འགྲོ་བར་ལྷག་པར་རྗེས་ས་ཆགས་ཤིང་བརྩེ་བའི་རང་བཞིན་ཡིན་ལ།",
    "དེས་ན་ཁྲོ་བོ་ནི་གདལ་བྱ་གདལ་དཀའ་བ་ལ་རྗེས་ས་ལྷག་པར་བརྩེ་ཞིང་།",
    "ཞི་བས་ཕན་པར་མི་འགྱར་ཏེ།",
    "གདལ་བྱ་གདལ་དཀའ་བ་འདལ་བའི་ཡེ་ཤེས་དང་ཐགས་རྗེའི་ཤགས་རྨད་ད་བྱང་བ་ལ་དེ་སྐད་ད་བསྟན་པའོ།",
    "སྒྲུབ་པས་དམིགས་པར་བྱ་བའི་ཡལ་དང་།",
    "དེ་ལ་འབྲས་བ་ནི་ཤགས་ཀྱིས་བསྟན་ནས་སྐབས་འདིར་དམིགས་པའི་ཡལ་དང་སྒྲུབ་པའི་ཐབས་གཉིས་ས་བཞག་པ་ལས།",
    "ཡེ་ཤེས་དང་ཐགས་རྗེས་སྐ་གསང་ཐགས་ཀྱི་སྒྱུ་འཕྲལ་ནམ་མཁའ་རབ་འབྱམས་ཀྱི་ཁམས་ཁྱབ་པར་འགྲོ་ཞིང་རྟག་ཏ་གདལ་བྱའི་དོན་མཛད་པ་སྒྱུ་མ་ལྟ་བའི་རྣམ་པར་རོལ་བ་སྟོན་པ་སྟེ།",
    "མཐན་པར་སྣང་།",
    "གཟགས་རྣམ་པར་སྣང་མཛད།",
    "གཏི་མག་རང་བྱང་ཆེན་པོ་ཡེ་ཤེས་ཀྱི་སྐར་གསལ་བ་ནི་གནས་ལགས་ཡང་དག་པ་ཞེས་བྱའོ།",
    "གཞན་ཡང་དགོངས་པའི་དོན་ཁྱད་པར་བ་ཡོད་ན་བློ་ལྡན་རྣམས་ཀྱིས་ད་དང་བཙལ་བར་བྱའོ།",
    "ཆ་ཁམས་དང་ཁྲག་རྣམ་པར་དག་པ་རིན་ཆེན་མཁའ་འགྲོ་མ་མཱ་ཀི།",
    "རླང་དང་དབགས་རྣམ་པར་དག་པ་ལས་ཀྱི་མཁའ་འགྲོ་དམ་ཚིག་སྒྲོལ་མ།",
    "རིགས་གསམ་རིགས་བཞི་རིགས་ལྔ་ལ་སོགས་པའི་སྣང་ཆ་བསམ་ཡས་སྒྱུ་འཕྲལ་དྲྭ་བའི་རིགས་ཀྱི་ཁྱབ་བདག་གཅིག་པར་གྱར་པ་དེ་ནི་སྒྲུབ་པས་དམིགས་པར་བྱ་བ་ཉིད་ད་ངེས་པར་བྱའོ།",
    "ངེས་པར་བརྟགས་པའི་ས་གཞི་ལ།",
    "གཙང་དང་འཇིགས་པའི་བརྟལ་ཞགས་ཅན།",
    "གཙང་དམེ་མེད་པར་བདད་རྩི་ལྔ་ལ་སོགས་པར་ལོངས་སྤྱོད་པ་ཟས་གཅིག་ཏ་ཟ་བའི་གཙང་སྦྲ་སྟེ་གསམ་དང་ལྡན་པར་བྱ་སྟེ།",
    "མཉམ་ཉིད་བླང་དོར་མེད་པའི་དོན་ལ་དེ་དང་རྗེས་ས་མཐན་པའི་བརྟལ་ཞགས་ཀྱིས་བདེ་བ་ཆེན་པོ་འགྲབ་པར་འགྱར་བའི་བླང་དོར་ད་སྤྱོད་པ་ནི་ཇི་ལྟར་བཟང་ཡང་དེ་ཁོ་ན་ཉིད་ལས་གོས་པས་ན་ཚལ་འདི་ལྟ་བས་གཙང་ཞིང་དག་པ་རབ་ཀྱི་མཐའ་ཐོབ་པར་ནས་ཀྱི།",
    "གཞན་གྱིས་མ་ཡིན་པས་ན་འདི་ནི་གཙང་སྦྲ་མཆོག་ཡིན་པས་འདི་དང་ལྡན་པར་བྱ་ཞིང་།",
    "བཟླས་པ་མཐར་དབྱང་ནས་སྦྱིན་སྲེག་བྱ་བས་བསྙེན་པ་དང་ཉེ་བར་བསྙེན་པ་རྫོགས་པའི་སྒོ་ནས་ལྷའི་བྱིན་གྱིས་རློབ་པའི་མཚན་མ་ཐོབ་པར་བྱའོ།",
    "བསྒྲུབ་ཀྱང་འགྲབ་པར་མི་འགྱར་ཏེ།",
    "ཅི་ཕྱིར་དེ་ལྟར་སྣོད་ངེས་པར་བརྟག་པར་བྱ་ཞེ་ན།",
    "ཚལ་འདི་ལྟ་བ་བསྒྲུབ་ཀྱང་འགྲབ་པར་མི་འགྱར་ཏེ།",
    "གོང་ད་བསྟན་པ་ལྟར་གྱི་སྒྲུབ་པ་པོ་མཚན་ཉིད་ལྡན་པ་དམ་ཚིག་དང་གཙང་སྦྲ་དང་བརྟལ་ཞགས་མཆོག་ལ་གནས་པ་དེ་བས་སམ་དེ་ལས་གཞན་ད་བློ་ཞན་ཅིང་ཤེས་རབ་ཆང་བ་རྣམས་ལ་བསྟན་པ་ཉིད་བྱ་བ་མིན་ནོ།",
    "ཡོ་བྱད་ཕན་སམ་ཚོགས་པ་བཞི་དང་ལྡན་པར་བྱས་ནས་བསྒྲུབ་པ་བསམ་དགོས་པས།",
    "གང་ད་སྒྲུབ་པ་རྩོམ་པའི་ས་གཞི་བརྟག་ཅིང་ཆོ་ག་ཚལ་བཞིན་བྱས་པ་དེར་སྒྲུབ་པ་བརྩམ་པར་བྱའོ།",
    "རིགས་བཟང་ཞིང་དབྱིབས་མཛེས་པ་སོགས་མཚན་ཉིད་ཚང་བ་བཀྲ་ཤིས་གཙང་མའི་རྫས།",
    "ནང་ད་ཕྱིན་ནས་མཚམས་བཅད་ལ་སྒྲོམ་ད་བཅག་ནས་ཧཱུྃ་བཅས་རྒྱས་གདབ་པར་བྱའོ།",
    "རང་ན་དེར་གཏེར་གཞག་ཅིང་འཐས་པར་བཅག་པ་དང་།",
    "བསྲེག་གཏོར་བཀྲས་ནས་དག་པར་བསམ་པས་སྦྱངས་ལ་དལ་མཉམ་ཞིང་དྲི་སྣ་ལྔའི་ཆས་གཏོར་བ་དང་།",
    "ཕར་པ་བདད་རྩི་འཁྱིལ་པར་བརླབས་ལ་གདབ་སྟེ་ས་བཟང་བ་དང་།",
    "དེ་ནས་འབྱང་གཏོར་ལའང་ཡོན་ཏན་གྱི་མགྲོན་སྤྱི་གཙང་རིགས་ཀྱི་དཔལ་མགོན་བདན་ཅ་སོགས་ལ་གཏོར་མ་གཅིག་འབལ་ཏེ་ཕྲིན་ལས་བཅོལ།",
    "དེ་ལས་ཁྱད་པར་ད་རྒྱལ་པོ་བཞིའི་འཁོར་མི་སྲན་པ་རྣམས་ལ་སོགས་པ་གསང་བའི་སྒྲུབ་པ་ལ་གླག་ལྟ་བར་འབྱང་བ་རྣམས་མཚམས་བཅད་པའི་ཕྱིར་ཕྱོགས་བཞིར་ཐོ་བཞིས་རྒྱལ་པོ་བཞིར་མངའ་གསོལ་ལ།",
    "གསམ་པ་ནང་མཚམས་བཅད་པ་ལ་སྔར་འདྲེས་པ་རྣམས་ནང་ད་ཚོགས་ནས་མ་འདྲེས་པ་རྣམས་ཕྱི་རོལ་ད་བཞག་ལ་ནང་མཚམས་བཅད་པར་བྱ་སྟེ།",
    "བགེགས་དེ་རང་སེམས་ལས་བྱང་ཡང་སེམས་ལ་རང་བཞིན་མེད་པར་ཤེས་པས།",
    "དེ་ལ་བཀའ་རྩལ་པའི་ཚལ་ད་སཾ་བྷ་ནི་བརྗོད་ཅིང་ཕྱོགས་བཅར་ཁྲོ་བོའི་གདན་ཐིངས་ཤིག་པར་བཀའ་སྩལ་བས་ཧཱུྃ་ཀ་རའི་ཐགས་ནས་ཊཱ་ཱཀཱི་རཱ་ཛ་བཀའ་ནོད་པའི་ཚལ་ད་སྤྲོས་ཏེ་དེ་མངགས་པས་ཕྱོགས་སྐྱོང་བཅ་ལྕགས་ཀྱས་བཟང་།",
    "ཧཱུྃ་ཀ་ར་ཡང་ཞེ་སྡང་རྡོ་རྗེའི་ཐགས་ཀར་ཐིམ་པར་བསམ།",
    "བདད་རྩི་འཁྱིལ་པ་མདན་ད་བཀག་ལ་རྡོ་རྗེའི་ཐོ་བ་གཏད་དེ་ཕར་བ་གདབ་པར་བསྐལ་བས།",
    "འཁྱིལ་བས་ཐོ་བ་ཞེ་སྡང་རྡོ་རྗེ་ལ་གཏད་པས་ཞེ་སྡང་རྡོ་རྗེ་ཉིད་ཀྱིས་བྱང་ད་གནོད་སྦྱིན་ལ་བདད་རྩི་འཁྱིལ་པ་བཏབ་པར་བྱའོ།",
    "ཡངས་ཀར་ལ་རྡོ་རྗེ་གནོད་སྦྱིན་གྱིས་སྔགས་བཟླས་པ་ཕྱོགས་མཚམས་ཀན་ཏ་འཐོར་བས་བགེགས་བསྐྲད་པར་བྱའོ།",
    "སྐ་གསང་ཐགས་ས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "དྲང་བསྟིམ་བརྟན་བཞགས་ཕྱག་མཆོད་བྱས་ལ་རང་སྔགས་བརྒྱ་རྩ་བརྒྱད་སོགས་བཟླས་པས་བྱིན་གྱིས་བརླབ་པར་བྱ་ཞིང་།",
    "ཐམས་ཅད་ཚལ་བཞིན་བྱིན་གྱིས་བརླབ་པར་བྱ་བ་གསམ།",
    "ཕྱག་རྒྱ་ཆེ་དང་ལྡན་པར་ནི།",
    "ཞེས་པས་སྔོན་ད་སྟ་གོན་གྱི་རིམ་པ་ལེགས་པར་གྲབ་པ་དེ་ནས་བསྒྲལ་བྱ་དར་ཁྲོད་ཀྱི་བདག་པོ་མ་ཏྲཾ་ར་དྲ་དག།",
    "སྒྲོལ་བྱེད་ཀྱི་གཉེན་པོ་འདའ་བ་མེད་པའི་ཕྱག་རྒྱ་ཆེན་པོ་སྟེ་ལྟ་སྒོམ་སྤྱོད་པ་ཁྱད་པར་ཅན་གྱི་ཆེ་བ་དང་ལྡན་པར་བྱས་ནས་ནི།",
    "ལས་ཀྱིས་བསྟུན་པའི་ཡམ་དང་འཁོར་ད་བཅས་ཏེ་གནས་པར་གྱར་ཏོ།",
    "ལས་འབྲས་མེད་ཅིང་དངོས་པོ་ཀན་མཐར་ཆད་པར་ལྟ་བ་ལས།",
    "དག་གསམ་ལྷག་པར་རྒྱས་པའི་རང་རྒྱད་པ་ལས་ཀྱིས་དེ་ལྟ་བར་སྐྱེས་པ་ཡང་མི་འགལ་ལ།",
    "རྣལ་འབྱོར་པ་ཀན་ལ་གནོད་པ་ཅན་དེ་ལ་ར་དྲ་རྣམ་གསམ་ཚང་བས་དེ་ཐབས་ཀྱིས་མནན་པར་བྱ་སྟེ།",
    "རྐྱེན་སྔགས་ཀྱི་གསང་བ་ལོག་པར་སྤྱད་པ་ལས་བྱང་།",
    "དེ་ནས་ཅི་རིགས་ས་ལས་རྣམས་བྱ་བ་ནི་ཆོ་ག་རྒྱས་བསྡུས་སོགས་ཅི་ལྟར་འཚམས་པ་སྔོན་ད་བྱ་ཞིང་མ་ཏྲཾ་བསྒྲལ་བའི་ལས་དངོས་ལའང་ཁྱད་པར་དང་སྤྱིའི་ལས་གཉིས་ལ།",
    "དེ་ནས་མ་རིག་པའི་སྦུབས་སྒོ་དྲལ་ཏེ་ཁོག་པ་ཁ་ཕྱེ་བས་ནང་སྒོ་ཕྱེས་པར་བསམ།",
    "ཞིང་དེའི་ཕང་པོ་ལས་ཤ་རི་ཁྲག་མཚོ་རས་པའི་རི་རབ་ཏ་གྱར་པར་བསམ།",
    "དེ་ནས་རྡོ་རྗེ་རྒྱལ་པོས་སྣ་དྲངས་ཏེ་ཕྱག་རྒྱ་ལག་པ་དཔང་མགོར་བསྣོལ་ནས་སྡིགས་མཛབ་བསྒྲེང་ཞིང་སྔགས་དང་བཅས་པས་འབར་བའི་ལྟ་བས་ཐམས་ཅད་ནང་ད་འཇག་པར་བྱས་ནས་སྒོ་རྦད་ཀྱིས་བཅད་པར་བསམ།",
    "དེ་ནས་སྒྲུབ་པ་པོ་རྣམས་ཀྱིས་ཚེ་དགག་བསྟིམ་བཀྲ་ཤིས་རྒྱས་པར་བྱའོ།",
    "སྣང་བའི་འོད་དང་ཆས་པར་དགྲམ།",
    "སྣང་བའི་འོད་དང་བཅས་པའི་མར་མེ་བཅའ་ཚལ་འོག་ཏ་འཆད་པ་ལྟར་བྱས་ལ།",
    "ཤེས་པ་དགག་ཅིང་དཀྱིལ་འཁོར་ད་གཞག་པ་བྱས་ཏེ་དལ་གྱི་དབས་ས་ཙོག་པར་བཞག་ལ།",
    "དང་པོ་ལྟར་ན་ལྷོ་ནས་བྱང་ད་ཆ་གསམ་བགོས་པའི་ནབ་ཕྱོགས་ངོས་ཀྱི་ཆ་གཉིས་ལ་ཟླ་གམ་སྒོ་གཅིག་པ་ཁ་ཤར་ད་བལྟ་བ་བྱས་ལ་དེར་ལིང་ཚེ་དག་པ་བྱ་སྟེ་དེའི་དབས་ཀྱི་ཟླ་གམ་སྒོ་ཤར་བསྟན།",
    "གཉིས་པ་ལྟར་ན་ལྷོ་བྱང་ད་བཅད་པའི་ཤར་ཕྱོགས་ཀྱི་ངོས་གཉིས་ལ་ཟླ་གམ་དམར་པོ་སྒོ་ནབ་ཏ་བཏོད་པར་བྱས་པ་ལ་ལིང་ཚེ་དག་པ་བྱས་པ་ནི་དཀྱིལ་འཁོར་ནབ་ཕྱོགས་དེ་བཞིན་གཞི་ཞེས་དཀྱིལ་འཁོར་སྒོ་ནབ་ཀྱི་ཕྱོགས་ས་བསྟན་པ་ནི་སྔ་མ་དེ་བཞིན་ད་བྲི་ཞི་བསྙེན་སོགས་ཀྱི་གཞི་ཡིན་ནོ།",
    "ནམ་བྱ་ན་ནབ་པར་ཕྱོགས་པ་སྟེ་ཞི་བསྙེན་མཐར་དབྱང་ནས་ནབ་ཐ་མ་ལ་སྒྲུབ་པའི་གཞི་ཉིད་ཀྱི་ཕྱིར་བྱ་བར་གསངས་སོ།",
    "མར་མེ་སྣང་བའི་འོད་དང་ཆས་པར་དགྲམ་པ་ཡང་གསང་སྔགས་འདི་པའི་ལགས་ཀྱི་ཁྱད་པར་གྱི་མར་མེའི་སྣོད་ནི་ཐོད་ཚལ་སྐྱོན་མེད་པ་ཟླ་གམ་དབྱིངས་ས་བྱས་ལ་པདྨ་བྲིས་ནས་ཟེའ་འབྲ་མཐོ་བར་བྱ།",
    "མཉམ་པ་ཉིད་ཀྱི་ཏིང་ངེ་འཛིན་དེས་ཐམས་ཅད་གཉིས་ས་མེད་པར་བྱིན་གྱིས་བརླབ་པར་བྱ་བ་དང་།",
    "ཇི་ལྟར་ན་བདག་གཙོ་བོའི་རྣམ་པར་གསལ་བ་སྤྱིར་བཏང་ནས།",
    "ལས་ཀྱི་ཀརྨས་བཞེས་པར་གནང་བ་ཞ།",
    "བདད་རྩི་དཔའ་བོ་འབྲ་ལྔ་དང་རྟ་མགྲིན་ཡམ་བཞིས་བསྐོར་བ་ལས་སྦྱོར་བའི་སེམས་སྤྲིན་དབབ་པ་དང་འཁོར་འདས་ཀྱི་བཅད་བསྡུ་བསྟིམ་བྱས་པའི་དྭངས་མ་འབྲ་གསམ་གྱི་རྣམ་པས་བདག་ལ་བསྟིམ་སོགས་ཀྱིས་བརླབ་པར་བྱའོ།",
    "ཐ་མར་དམ་ཚིག་ལ་གནས་པར་བྱ་བའི་རིམ་པ་གསམ།",
    "དངོས་གྲབ་འདོད་པར་གསོལ་བ་གདབ།",
    "མ་གནང་བ་སོགས་གེགས་ཡོད་མེད།",
    "དམ་ཚིག་ནོད་པ་བཞིན་མི་འདོར་བར་བརྟན་པར་ནས་སམ་མི་ནས་རྣམས་རིམ་བཞིན་འདྲེས་པ་ལ་ལན་ཚལ་བཞིན་གདབ་རྗེས།",
    "སློབ་དཔོན་གྱིས་གནང་བ་རྩལ་ཞིང་མེ་ཏོག་བྱིན་ལ་སྒོ་བཞིར་ཁྲིད་དེ་སྒོ་དབྱེ།",
    "དེ་ནས་བགེགས་བསྐྲད་ལས་བམ་གྱིས་ཁྲས་བྱས་དམ་ཆ་བླད་ལ་ཁེ་ཉེན་གྱི་སྒོ་ནས་དམ་ལ་བཞག།",
    "སློབ་དཔོན་གྱིས་ཤར་ཕྱོགས་ས་རིག་པའི་མེ་ཏོག་དོར་ཞིང་དེར་དཔལ་ཁྲག་འཐང་ཆེན་པོ་ཇི་ལྟ་བ་བཞིན་ད་གསང་བའི་ཡམ་དང་བཅས་པར་བསྒོམ་ལ།",
    "ཡང་ན་ཡབ་ཡམ་གཉིས་ཀྱི་ལས་སེམས་ཅིར་ཡང་བསྒྱུར་བཏབ་པ་གར་མཁན་གྱི་ཚལ་དང་འདྲ་ཞིང་ཡིག་འབྲ་སྔགས་དང་ཏིང་འཛིན་གྱིས་དཔལ་ཆེན་པོ་ཡབ་ཡམ་གྱི་སྐར་བྱིན་གྱིས་བརླབ་པ་ཐ་མལ་གདོས་པ་ཅན་མིན་པར་སེམས་ཀྱི་ཆོ་འཕྲལ་ད་ཤར་བ་དཔེ་སྒྱུ་མའི་སྣང་བ་བཞིན་ད་གྱར་པ་དེ་ལས།",
    "འཇའ་ཚོན་བཞིན་སྣང་ལ་རང་བཞིན་མེད་པར་གསལ་བར་བྱའོ།",
    "ཕན་ཚན་སོ་སོར་བལྟས་པའམ་ཡིད་ཕྲད་པའམ་ལག་པ་ཕྲད་པའམ་འོ་བྱས་པ་ཙམ་གྱིས་སྐ་ཡི་གནས་དང་བྱང་ཆབ་ཀྱི་སེམས་ལས་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་ཁ་དོག་ལྔ་ལྔ་ཉེར་ལྔར་འཕྲོས་པས་རང་བཞིན་ལྷན་གྱིས་གྲབ་པའི་ཞི་ཁྲོའི་ལྷ་ཚོགས་སྤྱན་དྲངས་ནས་མདན་མཁར་བཞགས་པར་བསམ་ལ།",
    "ཡབ་ཡམ་གཉིས་ཀྱི་མཁའ་གསང་བྱིན་གྱིས་བརླབས་ནས་བདེ་བའི་བརྡས་བསྐལ་ཏེ་གཉིས་ས་མེད་པར་སྦྱོར་བ་ཡིས་བྱང་ཆབ་ཀྱི་སེམས་ཡམ་གྱི་མཁར་དབབ་ཅིང་སྤྲོ་བསྡུ་ཚལ་བཞིན་བྱའོ།",
    "པདྨོ་རིན་ཆེན་ལྡན་བྱས་ནས།",
    "འདོད་པར་བྱ་བ་རབ་ཏ་མཉེས།",
    "སྒྱུ་མའི་ཏིང་ངེ་འཛིན་ལ་གནས་པར་བྱས་ནས་ས་མ་ཡ་སྟྭཾ་སོགས་རྣམ་པ་བཞིའི་སྦྱོར་བས་བརྡས་མཚོན་པར་བྱས་ཏེ།",
    "ཁྲོ་བོའི་སྐབས་བཞིན་ཕྱག་རྒྱ་བཞིས་འཛིན་འཁྱད་སྦྱར་སྤྲད་བྱས་ཏེ་ཧཱུྃ་ཞེས་རྡོ་རྗེ་ནང་ད་གཟང་ཅིང་ཡབ་ཀྱི་བྱང་སེམས་ལས་གནས་ཐམས་ཅད་ནས།",
    "ཕཊ་ཀྱིས་ཡམ་མཁར་དབབ་པར་བྱས་པས།",
    "དེ་ལས་འོད་ཟེར་འཕྲོས་པས་ཞིང་འདིའི་ཁམས་གསམ་གྱི་སྣོད་བཅད་སྦྱངས་ཤིང་དག་པའི་རྟེན་བརྟེན་པར་གྱར་པ།",
    "ཡམ་གྱི་པདྨོ་དང་ཡབ་ཀྱི་རིན་ཆེན་ཟང་དང་ལྡན་པར་བྱས་ནས་ཉམས་ས་བླངས་པའི་ཆགས་ལམ་གྱི་བདེ་བ་གང་ཞིག།",
    "དེ་ཡང་རྟོག་པའི་རབ་རིབ་ཐམས་ཅད་དབྱིངས་ས་སངས་ཀྱང་སེམས་མེད་ཀྱི་གནས་སྐབས་ཐིབས་པོ་ལྟ་བ་མ་ཡིན་ཏེ་རང་རིག་ཇི་བཞིན་པ་སྒྲིབ་བྱེད་དང་བྲལ་བས་ན་རང་འོད་ལྷག་པར་གསལ་བ་ནི་བདེ་བའམ་གསལ་བའམ་རིག་པ་ཉིད་དོ།",
    "དེ་མངོན་ད་བྱེད་པའི་ཐབས་སམ་རྐྱེན་ནམ་རྟེན་ད་གྱར་པ་ཀན་རྫོབ་ཀནྡ་ལྟ་བའི་བྱང་ཆབ་ཀྱི་སེམས་ལའང་མཚན་དང་ཡོན་ཏན་སོགས་དེ་སྙེད་ད་བཏགས་པ་ནི་འབྲས་མིང་རྒྱ་ལ་བཏགས་པའི་ཚལ་ད་ཤེས་པར་བྱས་ནས་ཐབས་དེ་ལྟ་བའི་ལྷན་ཅིག་བྱེད་རྐྱེན་ལ་བསྟེན་ནས་རང་གནས་གཉག་མའི་ཡེ་ཤེས་ཞལ་མཐོང་བས་རང་དོན་གྲབ་ལ།",
    "དེའི་ཐབས་ཀྱི་རྩ་བ་ཆགས་ལམ་གྱི་མན་ངག་ལ་ཤིན་ཏ་ངོམ་པས་ཡམ་ཕྱག་རྒྱའི་དམ་ཚིག་དང་ད་ལེན་ཅིང་སྦྱོར་བའི་སེམས་སྤྲིན་གྱིས་ཤེས་རབ་མ་མཉེས་པར་བྱ་བའོ།",
    "ཇི་ལྟར་འདོད་པར་ནན་ཏན་བྱ།",
    "གསམ་པ་དེ་ཁོ་ན་ཉིད་རྫོགས་པར་གདམས་ཏེ་སྦྱིན་པ་སྟེ་འདི་རྣམས་ཞལ་གྱི་མན་ངག་ཡིན་པས་སེམས་ལ་བླན་ཅིང་ཉམས་ས་བླང་ངོ།",
    "དེའི་ངང་ལས་ཡེ་ཤེས་ཀྱི་རོལ་པ་འགག་པ་མེད་པ་དཔལ་ཆེན་ཡབ་ཡམ་ད་སྩོལ་བ་མེད་པར་ཤར་ཏེ་བདེ་བ་རྒྱན་མི་འཆད་པར་བཞགས་པ་ལོངས་སྐ།",
    "གསམ་པ་ཐ་མ་དམ་ཚིག་ལ་གནས་པར་བྱ་བ་ནི།",
    "དམ་ཚིག་སྤྱི་དང་བསྒྲུབ་པའི་དས་ས་ཁྱད་པར་གྱི་དམ་ཚིག་ཆེན་པོས་བསྲང་སྟེ་ལམ་ལ་བདེ་བར་གནས་པར་བྱ་དགོས་པས་དམ་ཚིག་ཆེན་པོ་བརྒྱད་དབོག་པ་ནི་འདི་ལྟ་སྟེ།",
    "སྐ་གསམ་ས་ལ་གོམས་པར་བྱ་ཞེས་པས།",
    "དབགས་ནང་ད་བསྡུས་ཏེ་སེམས་གཡོ་མེད་ད་གསལ་བར་ཨ་ལ་གཏད་པས་དེར་ཟིན་པ་ན་ཨའི་འོད་ཀྱིས་སྣོད་བཅད་ཐམས་ཅད་མི་དམིགས་པར་སྦྱངས།",
    "ཐམས་ཅད་ཀན་ལ་ཁྱབ་པར་བྱ།",
    "ཡང་ན་དོན་གྱིས་ཁ་བསྐང་སྟེ་ཤེས་པར་བྱ་ལ།",
    "དེ་ནས་ཡེ་ཤེས་སེམས་དཔའི་ཐགས་ཀའམ་སྨིན་མཚམས་ས་ཅིར་ཡང་འགྱར་བའི་ཡིག་འབྲ་བྷྲཱུ་སྨུག་ནག་གཅིག་བསམ་པར་བྱའོ།",
    "དེ་ལས་སྤྲོ་བསྡུ་སྔར་བཞིན་བྱས་པས་རིན་ཆེན་སྣ་ལྔ་ལས་གྲབ་པ་མཆོག་ཏ་མཛེས་པའི་གཞལ་ཡས་ཁང་དབྱིབས་གྲ་བཞི་མཆོད་རྟེན་གྱི་ཚལ་ཅན།",
    "ཕྱི་ནང་མི་སྒྲིབ་པར་གསལ་བ།",
    "ཕྱག་རྒྱ་རྒྱན་དང་ཆ་ལགས་དག།",
    "རྡོ་རྗེ་སེམས་དཔལ་མཐིང་ག་ཞལ་གསམ་ཕྱག་དྲག་པར་བསྐྱེད་ལ།",
    "དེ་གཉིས་གཉིས་ས་མེད་པ་ལས་ཡམ་གྱི་མཁའ་ལ་སྐ་ལྔ་ཡེ་ཤེས་ལྔའི་བདག་ཉིད་ཐགས་རྗེ་ཆེ་དང་ལྡན་པའི་གཙོ་བོ་དཀྱིལ་འཁོར་ལྔ་ལ་སོགས་པའི་འཁོར་དང་བཅས་པའི་ལྷ་བཞི་བཅ་རྩ་གཉིས་བསྐྱེད་པར་བྱ་ལ།",
    "མཁའ་ནས་ཕྱིར་དབྱངས་ཏེ་མི་བསྐྱོད་པ་ཡབ་ཡམ་བདག་ཉིད་ཡབ་ཡམ་བསྟིམ་ཞིང་གཞན་རྣམས་སོ་སོའི་གདན་སྟེང་ད་འགོད་པར་བྱའོ།",
    "འདི་སྐབས་གཙོ་བོ་ནི་ཡབ་ཡམ་དང་མངལ་གྱི་ལྷ་གཙོ་འཁོར་ཐམས་ཅད་ལའང་འཁོར་གྱི་ཐ་སྙད་བྱས་པའོ།",
    "ཐགས་རྗེས་ཀན་ལ་ཁྱབ་པར་དོན་མཛད་ཅིང་།",
    "ཞེས་པའི་དགོངས་དོན་ཏེ་ཚིགས་ནི་ཤེས་རབ་ཀྱི་ནས་པ་བརྗོོད་པར་འདོད་པའི་རྗེས་ས་བྱེད་པའི་ཕྱིར་རོ།",
    "ཆ་ལགས་ཞེས་པས་བཞགས་ཚལ་དང་སྐ་ཇི་ལྟར་སྣང་ཚལ་གཉིས།",
    "རིག་པ་དབྱིངས་ལ་ཞགས་པའི་རྟགས་ས་དབྱེར་མེད་པར་བསྟིམ་པའི་ཚིག་བརྗོད་ཅིང་བྱེ་མ་ལ་མར་ཐིམ་པའམ་བ་ཞོ་ལ་ཁ་བ་བབ་པ་ལྟར་དབྱེར་མེད་པར་བསམ།",
    "གསམ་པས་མཐེབ་སྲིན་ཉི་ཟླའི་གྭའས་བདད་རྩིའི་ཐིག་པ་བླངས་ཏེ་ལྷ་སོ་སོའི་ལྗགས་ལ་ཐིམ་ཁཱ་ཧི།",
    "དེ་དག་སོ་སོའི་ལང་ཚིག་དང་སྔགས་ནི་གལྤོ་ལས་འབྱང་བ་འགྲེལ་པར་བཀོད་པ་ལྟར་ཉམས་ས་བླང་ངོ།",
    "དེ་ཡང་མཆོད་སོགས་དེ་དག་བཟླས་པའམ་བསྙེན་པ་ཉིད་བྱེད་པའི་གཞིའམ་དེ་ཡི་དོན་ད་ཡིན་ལ་བསྙེན་པ་ཉིད་ནི་བདག་གཞན་གྱི་དོན་གཉིས་བསྒྲུབ་ཅིང་དཔལ་ཆེན་པོའི་གོ་འཕང་ལ་ཉེ་བར་བྱེད་པས་ན་མིང་དང་དོན་མཐན་པར་ཤེས་པར་བྱས་ལ།",
    "མར་མེ་གཅིག་ལས་གཉིས་མཆེད་ཀྱི་ཚལ་ད་སོ་སོ་ནས་བཏོན་ལ་དེར་གཞགས་ཅིང་དཀྱིལ་འཁོར་རྫོགས་པར་བྱས་ལ།",
    "སྔར་བས་ཀྱང་གསལ་བའི་རྣམ་པ་ཅན་གྱི་ཡེ་ཤེས་ཀྱི་སྐར་གྱར་པར་བསམ་ལ་བཟླའོ།",
    "ལྷ་སོ་སོར་བསྟོད་པ་བྱས་ལ་དངོས་གྲབ་ཀྱི་གེགས་བསལ་ཕྱིར་བཤགས་པ་ཕལ་ནས་དངོས་གྲབ་བསྐལ་བའི་ཆོ་ག་དང་།",
    "རྗེས་ས་ཐགས་དམ་བསྐལ་ཞིང་མཉེས་པར་བྱ་བ་བཞི།",
    "དར་ཁྲོད་ས་རབ་བརྟག་པར་བྱ།",
    "བདག་ཉིད་མི་བསྐྱོད་པར་གསལ་བ་ཡེ་ཤེས་ཀྱི་ལྟ་བ་དྲག་པོས་བསྐྱོད་དེ།",
    "ཉི་ཟླ་རྩིབས་ལ་འཆར་ཞིང་འཕྱོ་བ་དབས་ཐིག་བཞི་བཏབ་པའི་ལིང་ཚེ་དགར་གྱར་པའི་གཙང་ཁང་སྟེང་ཚངས་པའི་གདང་དྲེས་པ་གདང་སྣ་བརྒྱད་ལ་ཞིང་སྨུག་པོ་བརྒྱད་ཀྱི་ཀ་བས་བཏེགས་ཏེ་གཟའ་བརྒྱད་ཀྱི་གཞ།",
    "ཧཱུྃ་བཞི་པས་ཧཱུྃ་དེ་འོད་ད་ཞ་ནས་བདག་ལ་ཐིམ་པས་བདག་ཉིད་འོད་ད་གསལ་ལམ་འབར་བ་ལ་ཁྲོ་བོར་བསྐྱེད་པར་བསྐལ་བའི་ཚིག་དང་སྔགས་བརྗོད་པས།",
    "བདག་ཉིད་ཧེ་ར་ཀ་མཐིང་ནག་དབ་གསམ་ཕྱག་དྲག་ཞབས་བཞི་པ་ཏི་རའི་དབྱག་པ་དང་རྡོ་རྗེ་ལ་སོགས་པའི་ཕྱག་མཚན་ཅན་དར་ཁྲོད་ཀྱི་ཆས་བརྒྱད་དང་ལྡན་ཅིང་བསྐལ་པའི་མེ་ལྟར་འབར་བའི་ཀློང་ན་ཞབས་བརྐྱང་བསྐམ་གྱིས་བཞགས་པ་ཡམ་ཀྲོ་དྷཱི་ཤྭ་རི་མ་དང་གཉིས་ས་མེད་པར་ལྡན་པ་ཉིད་ད་གནས་བསྒྱུར་བར་བྱའོ།",
    "པདྨོ་རིན་ཆེན་ལྡན་བྱས་ནས།",
    "ཡམ་དང་ཡབ་ཀྱི་མཁའ་དབྱིངས་པདྨོ་དང་རིན་ཆེན་ལ་ཨཾ་དང་ༀལྡན་པར་བྱས་ནས་བྱིན་གྱིས་བརླབ་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "སྒྱུ་མའི་ཚལ་གྱི་ཏིང་ངེ་འཛིན་ལ་གནས་ནས་སྦྱོར་བའི་བརྡས་བསྐལ་བས་བདེ་བ་མཚོན་པའམ་གསལ་བར་བྱས་ཏེ་སྦྱོར་བ་བརྩམ་བར་བྱ་སྟེ།",
    "ཧོ་ཞེས་པས་པདྨ་ཁ་ཟམ་པ་ཕྲལ་ཏེ་ཧཱུྃ་ཧཱུྃ་ཧཱུྃ་ཞེས་རིག་པ་དབྱིངས་ལ་འཛད་པའི་ཕྱིར་རྡོ་རྗེ་ནང་ད་ཕལ་ལ་རོལ་པས་བདེ་བ་བསྐྱེད་པར་བྱའོ།",
    "ཡབ་ཡམ་ཕན་ཚན་རྗེས་ས་ཆགས་པའི་རོལ་པས་སྙོམས་པར་ཞགས་པ་ན་དགའ་བ་དང་བདེ་བ་འཕྲད་དེ།",
    "འདོད་པར་བྱ་བ་རབ་ཏ་མཉེས།",
    "ཡང་བྱང་ཆབ་ཀྱི་སེམས་དཀར་ལ་འཚེར་བ་དེ་ནི་དས་ཀན་ཏ་གཟང་འཛིན་གྱི་དྲི་མ་རྣམ་པར་དག་པ་སྟེ།",
    "གསང་ཡིག་འབྲའི་ཚོགས་ས་གྱར་པར་བྱིན་གྱིས་བརླབས་ཏེ་ཧ་བརྒྱད་ཧེ་བརྒྱད་ཕཊ་བཞི་ཧཱུྃ་བཅར་གྱར་པ་ལས་ཞི་བ་རྣམས་གནས་བསྒྱུར་བར་བྱའོ།",
    "འབར་བའི་ཚོགས་རྣམས་རྣམ་པར་བསམ།",
    "ཡབ་ཡམ་གྱི་མཁའ་གསང་ན་གནས་པའི་ས་བོན་སོ་སོ་ཞི་བའི་འཁོར་རྣམས་ལ་ཐིམ་པ་ལས་ཁྲོ་བོ་འབར་བའི་འཁོར་གྱི་ཚོགས་ཀོ་རི་བརྒྱད་ལ་སོགས་པར་རྣམས་ས་རྣམ་པར་བསམ་པར་བྱའོ།",
    "ཅི་རིགས་ས་ནི་བརྟག་པར་བྱ།",
    "གཟི་བྱིན་བསྐྱེད་པའམ་བཞགས་ས་གསོལ་བའི་ལང་ཚིག་སྔགས་དང་ཕྱག་རྒྱར་བཅས་པས་དམ་ཚིག་པ་ལ་ཡེ་ཤེས་པ་རྣམས་དབྱེར་མེད་ད་གནས་ཤིང་གཟི་བྱིན་དང་ལྡན་པར་བཞགས་པར་བསམ་པ་དང་།",
    "སླར་ཡང་མི་གཡོ་བར་བཞགས་ས་གསོལ་བ་ལ་བརྟན་པར་བཞགས་པ་དང་བཞགས་ནས་གདག་པ་ཅན་བཟའ་བའི་ལང་གཉིས་ས་ཡོད་པའི་དང་པོ་སྒྲུབ་པོ་དངོས་གྲབ་མ་ཐོབ་ཀྱི་བར་ད་སོ་སོའི་གོ་ན་བཞགས་པར་བསམས་ལ་ལང་ཚིག་དང་སྔགས་དང་ཕྱག་རྒྱས་བརྟན་པར་བྱ་བ་དང་།",
    "ཡེ་ཤེས་ཀྱི་ལྷ་སྔོན་གྱི་ཐགས་དམ་ལས་མི་འདའ་བར་སྒྲུབ་པ་པོ་ལ་དངོས་གྲབ་སྩོལ་བར་མཛད་པའི་ཕྱིར་དམ་ཚིག་བསྐལ་བའི་ཚིག་དང་སྔགས་ཕྱག་རྒྱ་བྱ་བ་དང་།",
    "དོན་གྱི་བསྙེན་པ་དང་ལས་ཀྱི་བསྙེན་པ་གཉིས་ལ་འཇག་པར་འདོད་པས།",
    "དཔལ་ཆེན་པོའི་ཡེ་ཤེས་སྔགས་ཀྱི་ཡི་གེ་ར་ལ་འབྲ་བརྒྱད་ཀྱི་རྣམ་པར་ཤར་བ་ཚལ་བཞིན་བསྟན་པར་བྱ་བ་ཡིན་ལ།",
    "སྒྲ་དག་པར་སྒྲོགས་པ་དང་མཁར་བ་དབགས་ཀྱི་དབྱངས་གཉིས་ལ་ཅང་ཀ་དེའ་དང་པང་ཀ་དེའ་ཞེས་དང་།",
    "ལས་སྦྱོར་དས་དྲག་པོར་བརྗོད་པ་ནི་འབྲག་སྒྲ་ལྟར་བཟླས་པར་བྱ་སྟེ།",
    "གསང་བར་སྣོད་བཅད་གཉིས་ཀྱང་བྱང་ཆབ་སེམས་སྣང་སྟོང་མཉམ་པ་ཉིད་ད་འཁོར་འདས་དབྱེར་མེད་པར་གསལ་འདེབས་པའི་ལང་ཚིག་དང་ར་ལས་སྔགས་བརྗོད་པར་བྱའོ།",
    "བདན་པ་ར་ལ་དངོས་གྲབ་ཏ་ཤེས་པ་ལ་དངོས་གྲབ་བསྡུ་བའི་ཚིག་སྔགས་དང་བཅས་པར་བརྗོད་ལ་དེའི་དོན་བཞིན་ཐགས་ཀ་ནས་ར་ལ་འབྲ་བརྒྱད་ལྗང་དམར་ད་འཕྲོ་ཞིང་ཡེ་ཤེས་ལྷའི་གནས་གསམ་ད་ཐིམ།",
    "མཉེས་ཤིང་ཐགས་ཀ་ནས་ར་ལ་སྨུག་ནག་ཚར་བསྡུ་ཞིང་སྒྲུབ་པོའི་སྒོ་གསམ་ལ་ཐིམ་སྐ་གསང་ཐགས་ཀྱི་དངོས་གྲབ་ཐོབ་པར་བསམ་སྟེ་བཟླས་པ་བྱའོ།",
    "དེ་ལྟར་ན་གཉིས་ས་མེད་པའི་བདག་ཉིད་དཔལ་ཆེན་པོའི་ཡེ་ཤེས་སྒྱུ་འཕྲལ་དྲྭ་བ་གསང་སྔགས་ཀྱི་ཚལ་ད་ཤར་བ་ར་ལ་འབྲ་བརྒྱད་པོ་དེ་ནི་རྣམ་པ་ཐམས་ཅད་པའི་རང་བཞིན་འཆར་ཞིང་བྱིན་གྱིས་རློབས་པའི་སྟོབས་ཀྱིས་ཇི་ལྟར་དམིགས་པ་དེ་བཞིན་ད་འགྲབ་པར་ནས་པ་སྟེ་གསང་སྔགས་ཀྱི་རྒྱལ་པོའི་ཡོན་ཏན་དང་ཆེ་བ་དེ་ལྟར་ཤེས་ནས་ཏིང་ངེ་འཛིན་དང་ལྡན་པས་ཚལ་བཞིན་བསྒྲུབས་པས་དངོས་གྲབ་རྣམ་གཉིས་མངོན་ད་གྱར་པ་ཡིན་ནོ།",
    "བསྙེན་པའི་ལང་བཞིན་བརྩོན་པར་འབད།",
    "དེ་ལྟར་ར་ལའི་ཡོན་ཏན་ཤེས་ཤིང་དོན་རྣམ་པ་བརྒྱད་ཀྱི་ཚལ་ད་བཟླས་པའི་མན་ངག་མཐོང་བའི་སྒྲུབ་པ་པོ་དེས་ཉམས་ས་ཏིང་ངེ་འཛིན་གྱིས་བླང་བ་ལས་འབྲས་བ་ཐོབ་དགོས་པས་ན་བསྙེན་པ་དང་སྒྲུབ་པའི་སྐབས་གོང་ད་བསྟན་པ་བཞིན་ཤེས་པར་བྱས་ལ།",
    "དེའི་ངང་ནས་ཕྱག་རྒྱ་ཆེན་པོའི་དཀྱིལ་འཁོར་གསལ་བརྟན་གྱད་ད་གྱར་པར་བྱས་ལ་མཆོད་སོགས་ཡན་ལག་ཚང་པའི་སྒོ་ནས་བཟླས་བརྗོད་ཚལ་བཞིན་རྒྱན་བར་མ་ཆད་ད་བྱ་བ་དང་།",
    "རྒོད་ཅིང་གཡེང་བ་མེད་པའི་སེམས་ཀྱིས་དོན་ལ་ཅི་ནས་ས་མཉམ་པར་འཇོག་པའི་རྣལ་འབྱོར་ལ་རྩལ་ད་བཏོན་ནས་གཙང་སྦྲ་དང་བརྟལ་ཞགས་མ་ཉམས་པར་སྤྱད་དོ།",
    "བདེ་བ་བསྐྱེད་ཅིང་ཁམས་དབབ་པ་བྱང་ཆབ་སེམས་ལས་ཇི་ལྟར་འདོད་པར་སྦྱར་བ་བཞི་དང་སྦྱར་བ་སྟེ་དེ་ལྟར་རྣམ་པ་བཞིར་འགྲེལ་པ་ན་གསང་ཞིང་།",
    "དངོས་གྲབ་གང་འདོད་པ་དེ་ལ་བསྙེན་པའམ་ཉེ་བར་བྱེད་པའི་ཐབས་དང་པར་བྱ་བ་ལ་བསྙེན་པ་དང་།",
    "དེ་ཡང་རབ་དས་བཞིར་བསྙེན་སྒྲུབ་རྒྱན་པར་བྱ་སྟེ་ར་བ་བཞིར་བསྙེན་པ་འབྲིང་བཞིར་བསྒྲུབ་པ་ཐ་ཆང་བཞིར་ལས་སྦྱོར་བྱ་བ་ལྟ་བའོ།",
    "གཉིས་པ་གྲངས་ནི་དས་ལ་མི་ལྟོས་པར་སྔགས་ཀྱི་གྲངས་མང་ཉང་ལ་ཚད་བཟང་བ་སྟེ།",
    "གསམ་པ་ནི་དས་གྲངས་ལ་མི་ལྟོས་པར་གྲབ་པའི་མཚན་མ་མངོན་ད་ནམ་གྱར་པ་ན་མཚན་མའི་བསྙེན་པ་རྫོགས་པ་སྟེ།",
    "རང་བཞིན་དང་ཏིང་ངེ་འཛིན་དང་རྡལ་ཚོན་གྱི་དཀྱིལ་འཁོར་རྣམ་གསམ་དབྱེར་མེད་པར་བྱས་པའི་ལྷ་དེ་དག་མཉེས་ཤིང་དགྱེས་པ་བསྐྱེད་པར་བྱའོ།",
    "དར་ཁྲོད་ཀན་ཏ་ཁྱབ་པར་བསམ།",
    "དངོས་གྲབ་སྒྲུབ་པའི་རྫས་གསང་བའི་ཡམ་དེ་དག་བརྟག་ཅིང་བྱིན་གྱིས་བརླབས་པར་བྱའོ།",
    "དེ་ལ་དང་པོ་གཟངས་མ་ནི་རྣལ་འབྱོར་པའི་ཉམས་དང་སྦྱར་ལ་རབ་ཏིང་འཛིན་ལས་ས་རང་བས་འོད་ཀྱི་རིག་མའམ་ཐམས་ཅད་ལ་སྦྱོར་ཤེས་པར་བྱ་ཞིང་།",
    "གཉིས་པ་རྒྱན་གྱིས་བྱིན་གྱིས་བརླབས་པ་ནི་གཟང་མ་དེ་ཁྲས་བྱས་ཙནྡན་གླ་རྩི་ཨ་གར་སོགས་དྲི་ཞིམ་པོས་བྱག་ཅིང་གོས་དང་རྒྱན་གྱི་ཁྱད་པར་གྱི་མཛེས་པར་བྱ་ཞིང་འདོད་པའི་སྒྱུ་རྩལ་གྱི་རིམ་པ་ལའང་མཁས་པར་བྱའོ།",
    "དེ་ལྟར་དམིགས་པའམ་ཆགས་པ་རྒྱས་པར་བྱས་ནས་ནི།",
    "སླར་མཁའ་དབྱིངས་ས་འདས་པས་བྱང་སེམས་དཀར་དམར་ལྟེམ་གྱིས་འོད་ད་འཁྱིལ་བར་བསམ་པར་བྱ་སྟེ།",
    "ཕར་པ་དང་ཐན་འད་བྱས་ལ་ཆོ་ག་གཞང་བསྲང་སྟེ་མཆོད་བསྟོད་བར་རྫོགས་པ་ན་རྩ་བསྙེན་དང་དྲག་པོའི་ལས་བསྙེན་བྱས་ལ།",
    "འབྲས་བ་སྡུག་བསྔལ་གྱི་ཕང་པོ་བཅོམ་སྟེ་སེམས་གསེར་ཞན་ལྟར་གནས་པ་ཧཱུྃ་ལས་གསང་བ་ཡེ་ཤེས་ཀྱི་ཧེ་ར་ཀ་ཞལ་གཅིག་ཕྱག་གཉིས་པར་གྱར་པ་དེ་ཛ་ཞེས་པས་ཚར་བཏོན་བྷྲཱུ་གསམ་གྱིས་བྱིན་གྱིས་བརླབས་ལ།",
    "རྒྱལ་པོ་དང་རྒྱལ་ཐེབས་ཀྱི་རྫས་ལ་ཉི་ཟླའི་སྤྱན་ཟར་གྱིས་བལྟ་ཞིང་བསྒྲལ་བར་གནང་བའི་ལན་བྱིན་ལ།",
    "ར་ཡ་ཁ་ལས་མེ་རླང་ཆས་བསྲེག་གཏོར་སྦྱངས་ནས་སྟོང་པར་གྱར་ཅིང་སླར་ལས་ཟླ་དཀྱིལ་གྱི་སྟེང་ད་སེམས་ཉིད་ཡི་གེ་ཨ་ར་གྱར་པར་བསམ་ལ་སོ་སོའི་གྱེར་ཚིགས་བརྗོད་ཅིང་དེ་ལྟར་ཏིང་ངེ་འཛིན་གྱིས་བྱིན་གྱིས་བརླབ་པར་བྱས་ནས།",
    "ཧེ་ར་ཀ་ཡབ་ཡམ་གཉིས་དང་དེའི་སྲས་དང་འཁོར་ད་བཅས་པའི་ཐགས་ལ་ཕོག་པས་མཆོད་ཅིང་མཉེས་པར་བསམ་ནས་སླར་འོད་དེ་དག་འདས་ནས་ཐོག་མའི་གཟགས་ཏེ་སྔར་བཞིན་ཐ་མལ་པའི་གཟགས་ས་བསམ་པ་དེ་ལ་གཟད་པར་བྱའོ།",
    "རིགས་ལྔ་ཡབ་ཡམ་དང་ཁྱད་པར་དོན་གྲབ་ཡབ་ཡམ་མཉེས།",
    "རིགས་ལྔ་དང་ཁྱད་པར་ལས་ཀྱི་རིགས་ཀྱི་ཐགས་དམ་བསྐང་།",
    "ཡེ་ཤེས་ལྔ་དང་ཁྱད་པར་བྱ་བ་ནན་ཏན་གྱི་ཡེ་ཤེས་གྲབ།",
    "མགྲིན་པར་པདྨ་ཨཱ་ལས་མིའི་སྦྱངས།",
    "དེ་ལྟར་རིགས་ལྔ་ཡབ་ཡམ་ཆོ་ག་རྣམ་པ་གསམ་གྱི་འཕྲོ་འདས་གནས་འབྱོངས་པ་དང་ཏིང་འཛིན་མངོན་སམ་ད་གསལ་ཞིང་བརྟན་པར་གྱར་ནས་ཏིང་ངེ་འཛིན་ཁོ་ནས་སྒྲོལ་བར་གྱར་ན་ལེགས་ཤིག།",
    "ཙིཏྟ་སླར་ཁོག་པར་བཅག།",
    "བླང་དོར་མ་འདྲེས་པར་བརྟགས་པ་གཉིས།",
    "དང་པོ་ལ་བགེགས་ལ་འཇིགས་པ་མེད་པར་བཟློག་པ།",
    "ལྷ་ལ་དགའ་བྲོད་མེད་པར་བྱ་བ་གཉིས།",
    "ནོར་ཅན་ལ་དགྲ་ལྡང་བ་ལྟར་དངོས་གྲབ་ཐོབ་པ་ལ་བར་ཆད་བྱེད་པའི་བགེགས་ཆེན་པོ་གང་དག་འབྱང་བ་ཡང་སྐྱེ་མེད་ཀྱི་ངང་ལས་སྐྱེ་བའི་ཆོ་འཕྲལ་དཔལ་ཆེན་པོའི་ཏིང་འཛིན་གསལ་ལ་མི་གཡོ་བའི་གདེངས་འཇིགས་པ་མེད་པའི་སེམས་ས་གནས་པ་ཉིད་ཀྱིས་ཅི་རིགས་ས་བཟློག་པར་བྱ་ཞིང་།",
    "ཚབ་ཆེ་བ་ལ་དཔལ་ཆེན་པོའི་སྐའི་གནས་བརྒྱད་ཀྱི་ཧ་བརྒྱད་ལས་ཀ་རི་མ་བརྒྱད་ཞལ་གསམ་ཕྱག་དྲག་པར་བསྐྱེད་ལ།",
    "དགྲ་བགེགས་འདལ་བའི་གཉེན་པོར་རྦད་དེ་བཏང་ཟོར་བརྒྱད་བཅས་ལ་དེས་བཟློག་པར་བྱ་སྟེ།",
    "དགྲ་བགེགས་གང་ཡང་དེས་འདལ་ཏེ་མན་ངག་ལས་ཤེས་པར་བྱའོ།",
    "གཞན་ཡང་ཐེ་ཚོམ་ལ་སོགས་པ་རྣམ་རྟོག་ད་མ་སྐྱེ་བ་ནི་དངོས་གྲབ་ལ་བར་ཆད་ད་བྱེད་སྲིད་པས་ངན་པའི་དོན་ཅན་གྱི་སེམས་ཡིན་པས་དེ་ལྟ་བ་མི་འབྱང་བའམ་མི་བསྐྱེད་པར་བྱ་སྟེ།",
    "བྱེ་བྲག་ཏ་ནི་ཤེས་པར་བྱ།",
    "གལ་ཏེ་འབྱང་པོ་མནན་པར་བྱ།",
    "ཕན་བྱེད་ཀྱི་ལྷ་དང་གནོད་པར་བྱེད་ལ་བགེགས་རྣམ་པ་གཉིས་པོ་གང་ཡིན་ངེས་པའི་མཚན་མ་དག་ནི་འདི་ལྟར་གཟགས་ས་སྣང་བ་དང་སྒྲ་ར་གྲགས་པ་དང་དྲི་བསྣམ་པ་དང་ནི་རྣམ་པ་གསམ་པོར་བསྟན་ཏེ་བྱང་བ་ན།",
    "ལྷ་ཡིན་པར་ཆགས་པ་དང་བགེགས་ས་དོགས་པ་དང་བཅས་པའི་སེམས་སྤང་བར་བྱ་སྟེ།",
    "གཉིས་ཀ་དོན་ད་མ་གྲབ་པར་མཉམ་ལ།",
    "གཟགས་མི་སྡུག་པ་སོགས་ཅིར་སྣང་ཡང་དཀྱིལ་འཁོར་གྱི་ན་སྡུག་ལ་སེམས་གསལ་ཞིང་ཉམས་དགའ་ན་ལྷའི་བྱིན་ཆེན་པོ་ཕེབས་པའི་རྟགས་ཡིན་པས།",
    "སྒྲུབ་པ་ཆེན་པོར་བརྩམ་པར་བྱ།",
    "དེ་ཡང་དས་ནི་རྡོ་རྗེ་བསྒྲུབ་པའི་ཞག་གྲངས་ཚངས་པའམ་རྟགས་བྱང་ནས་དངོས་གྲབ་ལེན་པར་འོས་པའི་ཞག་དེ་ནི་རྡོ་རྗེ་དངོས་གྲབ་བསྒྲུབ་པའི་ཞག་ཡིན་ལ།",
    "དེ་ཡང་སྒྲུབ་ཆེན་བརྩམ་པའི་ཚལ་ནི་ད་དཀྱིལ་འཁོར་དང་ཟླ་གམ་ཞལ་བསྒྱུར་པ་སོགས་བྱས་ཤིང་མཚམས་བཅད་ལ་མ་ཏྲཾ་མནན།",
    "བདེ་ཆེན་དབྱིངས་ནས་ཁྲག་འཐང་སྐར་བཞེངས་ཏེ་སོགས་ཀྱིས་ལྷ་རྣམས་སོ་སོར་བསྐལ་ཞིང་གསོལ་བ་གདབ་པ་ལ་གསར་ད་བཤམས་པའི་དངོས་གྲབ་ཀྱི་རྫས་ཀྱང་ཅི་རིགས་འད་བྱས་ནས།",
    "རྒྱལ་ཐེབས་ཀྱི་དཔང་གཟགས་ཀརྨ་ལས་གཞང་བསྲང་རྡོ་རྗེ་རྒྱལ་པོས་སྒྲུབ་པ་ཆེན་པོའི་ངག་བསྒྲུབ་པར་བྱ་སྟེ།",
    "དཀྱིལ་འཁོར་གྱི་ལྷའི་འོད་ཟེར་སྤྲོ་བསྡུས་འཁོར་འདས་ཀྱི་དྭངས་བཅད་འགགས་བསྟིམ་ཚལ་བཞིན་བྱས་ནས་བཟླས་པ་ཚལ་བཞིན་བྱའོ།",
    "དེ་ལ་གཞང་གཞན་ལའང་སྲོད་ལ་འཕྲོ་འད་ལམ་ད་བྱས་ཏེ་ལྷ་ལས་དངོས་གྲབ་བླང་བ་དང་ནམ་གང་སྒྲོལ་བ་ལམ་ད་བྱས་ཏེ་དགྲ་ལས་དངོས་གྲབ་བླང་བ་དང་ཐོ་རངས་སྦྱོར་བ་ལམ་ད་བྱས་ཏེ་རིག་མ་ལས་དངོས་གྲབ་བླང་བ་དང་གསམ་གྱིས་གྲབ་པ་རྣམ་གཉིས་ཅི་རིགས་ཐོབ་པར་གསངས་པ་བཞིན་དའང་ཤེས་པར་བྱའོ།",
    "དེ་ལ་སྦྱོར་སྒྲོལ་ནི་གོང་ད་བསྟན་པ་བཞིན་ཏེ་ཁྱད་པར་ད་སྦྱོར་བའི་སྒོ་ནས་དངོས་གྲབ་ལེན་པ་སྐབས་འདིར་གསངས་སོ།",
    "ཞེས་སོགས་སྤྱན་དྲངས་པའི་ཚིག་བརྗོད་ཅིང་བདག་ཉིད་ཡེ་ཤེས་ཀྱི་སྐ་འཁོར་དང་བཅས་པར་གསལ་ལ།",
    "ཞེས་པ་ལ་སོགས་པ་དངོས་གྲབ་སྩོལ་བར་གསོལ་བ་འདེབས་པའི་ཚིག་བརྗོད་ཅིང་ཧཱུྃ་ཞེས་རཀྟ་ལན་གསམ་པ་སྦྲེང་བས་ཐགས་དམ་གྱི་རྒྱད་བསྐལ་བས་གནས་འདིར་སྒྲུབ་པོ་འདི་རྣམས་ལ་སྐ་གསང་ཐགས་ཀྱི་དངོས་གྲབ་འདི་ནོད་པས་དངོས་གྲབ་སྩོལ་བའི་དས་ལ་བབས་པའི་སྒྲ་བྱང་བས་ཐགས་དམ་བསྐལ་ཏེ་དངོས་གྲབ་བསྩལ་བའི་ཉེར་བསྡོགས་ས་གནས་པར་བསམ་པ་ནི་ཧཱུྃ་གསམ་པའི་དགོངས་པ་སྟེ།",
    "སོགས་བརྗོད་ཅིང་ལྷ་སོ་སོའི་སྐ་དང་ཡི་གེ་རྣམས་གནས་གསམ་ད་བསྟིམ་ཞིང་བསྐོར།",
    "ཐོག་མར་སློབ་དཔོན་བདག་ཉིད་དཀྱིལ་འཁོར་གྱི་ནབ་ཕྱོགས་ས་འདག་སྟེ་རྡོ་རྗེ་ཤགས་ཀྱི་ཕྱག་རྒྱ་བཏེགས་པས་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་མདན་གྱི་མཁའ་ལ་སྨིན་མཚམས་ཡན་ཆད་འོད་ཕང་འདབ་འདྲེས་ས་བཞགས་པར་བསམ་ལ།",
    "དེ་སློབ་དཔོན་གྱི་ཐགས་ཀར་ཐིམ་པས་མཉེས་པར་བསམས་ལ།",
    "དར་ཁྲོད་གསང་བ་སོགས་བརྗོད་པས་དངོས་གྲབ་སྦྱིན་པའི་གནང་བ་བྱིན་ནས།",
    "དེ་ལྟར་སྒྲུབ་པ་ལེགས་པར་གྲབ་པའི་རྗེས་ས་བྱ་བ་ལ།",
    "མེ་འབར་བའི་རྫས་སམ་ཤིང་བད་ཤིང་རྣམས་ཚོགས་པར་བྱས་ལ།",
    "ཚོགས་བསགས་སྒྲིབ་སྦྱང་དང་དངོས་གྲབ་བརྟན་པར་བྱ་བའང་ཡིན་ནོ།",
    "སྦྱིན་སྲེག་ཟིན་ནས་ཐབ་ཁང་ལ་བསྐོར་བ་བྱས་ཏེ་ལྷ་རྣམས་ལ་གཏམ་ཆེན་མའམ།",
    "དེ་ནས་ཧེ་ར་ཀའི་ལས་ཀྱི་བཟླས་པ་བྱ་བ་དང་ལྷག་ཕད་བསྲེས་ཏེ་མཁའ་འགྲོ་བསྐྱང་བ་ནི་ལྷག་མའི་གཏོར་མ་བཏང་བའི་ལས་ཁ་ཚར་བཞིན་ད་ཤེས་པར་བྱའོ།",
    "ཧེ་ར་ཀའི་ཞལ་ཡེ་ཤེས་ཀྱི་ཧོམ་ད་སྦ་བ་དག་ཀྱང་ཤེས་པར་བྱ་སྟེ།",
    "དབྱིངས་ཡེ་གཉིས་མེད་ཀྱི་ཀློང་ད་མི་ཟད་ཡན་གྱི་གཏེར་དང་ལྡན་པར་བྱའོ།",
    "དེ་ནས་བཟོད་གསོལ་བྱ་ཞིང་གཟགས་བརྙན་གྱི་དལ་བསྡུ་བའི་ཚིག་བརྗོད་པའི་མཐར་རྫས་རྣམས་བསྡུ་ཞིང་སྦ་ལ་ཚོན་རྣམས་ཕྱག་པར་བྱའོ།",
    "བྱང་ཆབ་སེམས་མཆོག་ཤེས་རབ་ཏིང་འཛིན་སོགས་བཀྲ་ཤིས་བརྗོད་པར་བྱའོ།",
    "དེ་ནས་མ་དག་པ་བཤགས་པ་ལ་ཐོག་མར་མཆེད་ནང་ཕན་ཚན་བཤགས་པའི་སླད་ད་མཆེད་ཚོ་གཉིས་ས་བྱས་ལ་ཕན་ཚན་བཤགས་ཤིང་ཚངས་པར་སྩོལ་བའི་ཚིག་གཞང་བཞིན་བརྗོད་ནས་མཆེད་ཀན་གྱི་རྡོ་རྗེ་སློབ་དཔོན་ལ་བཤགས་པ་ཕལ་ཞིང་སློབ་དཔོན་གྱིས་ཀྱང་ཚངས་པ་སྩལ་བའི་ལན་བྱིན།",
    "དེ་ནས་རྒྱན་གྱི་ཏིང་འཛིན་ལ་ཞི་བ་རྒྱན་གྱི་ཏིང་འཛིན་དང་ཁྲོ་བོ་རྒྱན་གྱི་ཏིང་འཛིན་དང་ཁྲོ་བོ་རྒྱན་གྱི་ཏིང་འཛིན་གཉིས་ཏེ་མན་ངག་ཁ་ཚར་བཞིན་ད་ནན་ཏན་གྱི་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་དཔལ་ཧེ་ར་ཀ་བསྒྲུབས་པའི་ཐོག་མཐའ་བར་གསམ་གྱི་ལེགས་བྱས་ཐམས་ཅད་དང་།",
    "སྒྲུབ་པ་ཆེན་པོ་ཡང་དག་པར་གྲབ་པ་ཞེས་བྱ་བ་གྲབ་པའི་སློབ་དཔོན་ཆེན་པོ་བཛྲ་ཧཱུྃ་ཀ་རའི་ཞལ་སྔ་ནས་མཛད་པ་རྫོགས་སོ།",
    "རྒྱལ་པོས་བཀྲལ་བ་བཞིན་ད་གསལ་བྱས་འདིས།",
    "རྒྱལ་བ་ཀུན་གྱི་ཡེ་ཤེས་ཁྲོ་བོའི་གཟུགས་སུ་ཤར་བ་དོན་གཉིས་ལྷུན་གྱིས་གྲུབ་པའི་དཔལ་ཁྲག་འཐུང་ཆེན་པོའི་སྒྲུབ་ཐབས་ཕྱིན་ཅི་མ་ལོག་པར་བསྟན་པས་ན་ཡང་དག་པར་གྲུབ་པ་ཞེས་བྱ་བ་ཞེས་སོ།",
    "མཁྱེན་བརྩེ་ཆེན་པོས་གསང་གསུམ་གྱི་རོལ་པ་ནམ་མཁའ་རབ་འབྱམས་ཀྱི་ཁམས་ཁྱབ་པར་འགྲོ་ཞིང་རྟག་ཏུ་གདུལ་བྱའི་དོན་མཛད་པ་སྒྱུ་མ་ལྟ་བུའི་རྣམ་རོལ་སྟོན་ཅིང་།",
    "མཉམ་ཉིད་བླང་དོར་མེད་པར་སྤྱོད་པའི་ཚུལ་གྱིས་གཙང་སྦྲ་ཁྱད་པར་ཅན་དང་།",
    "དམ་ཚིག་དང་གཙང་སྦྲ་བརྟུལ་ཞུགས་དེ་དག་གོམས་པར་བྱས་ནས་ཉམས་རྙེད་པ་ན་གདོད་ཚུལ་བཞིན་སྒྲུབ་པ་ཉམས་སུ་བླང་བར་བྱའོ།",
    "ལྟ་སྤྱོད་ཕྲིན་ལས་དམ་ཚིག་བཞིའམ་གཙོ་བོ་དང་འཁོར་དང་གནས་དང་ཡོ་བྱད་ཕུན་སུམ་ཚོགས་པ་བཞི་དང་ལྡན་པར་བྱས་ནས།",
    "དངོས་གྲུབ་སྒྲུབ་པའི་རྫས་དང་སྒྲུབ་པའི་གནས་ས་གཞི་བརྟགས་ཤིང་ཆོ་ག་ཚུལ་བཞིན་བྱས་པ་དེར་སྒྲུབ་པ་ཚུལ་བཞིན་བརྩམ་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་འབྲི་བའི་སྔོན་དུ་བྱ་བ་རྣམས་ལེགས་པར་གྲུབ་པ་དེ་ནས་བསྒྲལ་བྱ་དུར་ཁྲོད་ཀྱི་བདག་པོ་མ་ཏྲཾ་རུ་དྲ་དག།",
    "སྒྲོལ་བྱེད་འདའ་བ་མེད་པའི་ཕྱག་རྒྱ་སྟེ་ལྟ་སྒོམ་སྤྱོད་པ་ཁྱད་པར་ཅན་གྱི་ཆེ་བ་དང་ལྡན་པར་བྱས་ནས་ནི།",
    "ཐོད་སྣོད་དུ་ཞུན་ཆེན་གྱི་མར་མེ་དགུ་སྣང་བའི་འོད་དང་ཆས་པར་དཀྱིལ་འཁོར་དུ་གནས་སོ་སོར་དགྲམ་ལ།",
    "དེ་ནས་བྱིན་གྱིས་བརླབ་པར་བྱ་བ་ལ།",
    "གནས་དང་སྒྲུབ་པོ་ཡུམ་དང་སྒྲུབ་རྫས་ཐམས་ཅད་བསྐྱེད་རྫོགས་རྫོགས་ཆེན་གྱི་ཚུལ་ཇི་ལྟ་བ་བཞིན་དུ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "དེ་ནས་སློབ་དཔོན་ཉིད་དཔལ་ཁྲག་འཐུང་ཆེན་པོ་ཇི་ལྟ་བ་བཞིན་དུ་སྟན་དག་ལ་ཇི་བདེར་གནས་པར་བྱས་ནས།",
    "དེ་ལས་ཡབ་ཡུམ་གྱི་སྐུའི་གནས་རྣམས་སུ་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་ཕན་ཚུན་མི་སྒྲིབ་ཅིང་རྣམ་པ་མ་འདྲེས་པར་འཇའ་ཚོན་བཞིན་དུ་གསལ་བར་བྱའོ།",
    "དེ་ནས་ལུས་དང་སྤྱོད་ལམ་ཡིད་དུ་འོང་ཞིང་མཚན་ཉིད་དང་ལྡན་པར་བཀྲ་ཤིས་པ་སྒྲུབ་པ་པོའི་རིགས་ཀྱི་ཡུམ་དེ་གོང་ལྟར་བྱིན་གྱིས་བརླབས་ནས།",
    "དེ་ལ་མཆོད་ཅིང་བསྙེན་པར་བྱ་བ་གཉིས།",
    "དེ་ལས་ཀྱང་སྤྲོ་བསྡུ་སྔར་བཞིན་བྱས་པས་རིན་ཆེན་སྣ་ལྔ་ལས་གྲུབ་པ་མཆོག་ཏུ་མཛེས་པའི་གཞལ་ཡས་ཁང་ཚད་དང་མཚན་ཉིད་ལྡན་པ་རྒྱན་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པའི་གནས་སུ།",
    "དཔལ་ཆེན་པོའི་དངོས་གྲུབ་ལ་བསྙེན་པར་བྱེད་པ་སྔགས་ཀྱི་བཟླས་བརྗོད་དམ་བསྙེན་པའི་དོན་དུ་ཚུལ་དེ་དག་བྱ་བ་ཡིན་ནོ།",
    "ཐུགས་དམ་བསྐུལ་ཞིང་མཉེས་པར་བྱ་པ་བཞི།",
    "དེ་ནས་མི་བསྐྱོད་པ་ཡབ་ཡུམ་ནི་ཁྲོ་བོར་གནས་གྱུར་ཏེ་ཡབ་ཡེ་ཤེས་ལྔ་འདུས་པའི་བདག་ཉིད་བཛྲ་ཧེ་རུ་ཀ་དང་དབྱིངས་ཀྱི་ཡུམ་དམ་ཚིག་ཆེན་པོ་ཀྲོ་དྷཱི་ཤྭ་རི་མར་གསལ་བ་ཡིས་གཉིས་སུ་མེད་པའི་སྦྱོར་བ་བརྩམ་པར་བྱ་སྟེ།",
    "ཡབ་ཡུམ་གྱི་མཁའ་དབྱིངས་པདྨོ་དང་རིན་ཆེན་ལ་ཨཾ་དང་ༀལྡན་པར་བྱས་ནས།",
    "འདོད་ཡོན་མ་སྤངས་གྲོགས་སུ་ཁྱེར་བས་ཉན་ཐོས་སོགས་ཀྱི་ལམ་ལ་ལྟོས་ནས་བདེ་ལ་ཉེས་པས་མ་གོས་པས་འཇིག་རྟེན་ལས་མཆོག་ཏུ་གྱུར་པའི་ལམ་མངོན་དུ་བྱ་བའི་ཕྱིར་སྒྱུ་མའི་ཏིང་འཛིན་ལ་གནས་ནས་སྦྱོར་བའི་བརྡས་བསྐུལ་བས་བདེ་བ་མཚོན་པའམ་གསལ་བར་བྱས་ཏེ།",
    "ཇི་ལྟར་ན་ཁམས་གསུམ་འདིའི་སྣོད་བཅུད་འོད་ཀྱིས་སྦྱངས་ནས་དག་པའི་རྟེན་བརྟེན་པར་བྱས་དེ་ལས་ཀྱང་རབ་ཏུ་འདས་ནས་ཀྱང་།",
    "འབར་བའི་ཁྲོ་བོའི་སྤྲུལ་པ་མང་པོས་འཇིག་རྟེན་གྱི་ཁམས་བཀང་བས་དྲེགས་པ་ཅན་ཀུན་བསྒྲལ་ཞིང་འཁོར་རྣམས་དཔལ་བཀོད་སྟེ་བྲན་དུ་བྱས་པར་བསམ་ལ།",
    "སོ་སོ་གནས་གྱུར་ནས་ཁྲོ་བོ་འབར་བའི་འཁོར་གྱི་ཚོགས་ཀ་རི་བརྒྱད་ལ་སོགས་པར་རྣམ་པར་བསམ་པར་བྱའོ།",
    "དམ་ཚིག་པ་ལ་བསྟིམ་ཞིང་དབྱེར་མེད་དུ་བཞུགས་པར་བསམ་པ་དང་སླར་ཡང་དངོས་གྲུབ་མ་ཐོབ་ཀྱི་བར་དུ་བརྟན་པར་བཞུགས་སུ་གསོལ་བ་དང་མཉམ་ཉིད་རོལ་པ་ཆེན་པོའི་ཕྲིན་ལས་ལྷུན་གྱིས་གྲུབ་པ་ལས་མི་གཡོ་བས་ན་བར་དུ་གཅོད་པ་ཀུན་ཞལ་དུ་བསྟན་པ་དང་།",
    "ཆོ་གའི་རིམ་པ་རྒྱས་པ་བསྡུས་སོགས་ཅི་རིགས་སུ་ནི་བློས་བརྟག་པར་བྱའོ།",
    "བསྙེན་སྒྲུབ་ཡན་ལག་བཞིའི་རིམ་པས་དུས་གྲངས་མཚན་མའི་བསྙེན་པ་རྫོགས་པར་བྱའོ།",
    "དེ་ལྟར་བསྙེན་པ་བྱས་པའི་ཐུན་གྱི་རྗེས་རྣམས་སུ།",
    "དངོས་གྲུབ་སྒྲུབ་པའི་རྫས་གསང་བའི་དེ་དག་བརྟག་ཅིང་ཀྲོ་དྷཱི་ཤྭ་རི་མར་བྱིན་གྱིས་བརླབས་པར་བྱ་སྟེ།",
    "གཟུགས་མའི་སྒོ་གསུམ་པོའི་ཁམས་གསུམ་ལ་ཁྲག་སྟེ་ཆགས་པར་བྱ་བའི་རང་བཞིན་དུ་དམིགས་པར་བྱས་ནས་ནི།",
    "ཕྱི་དུར་ཁྲོད་བརྒྱད་ནང་ལུས་གནས་བརྒྱད་གསང་བ་ཚོགས་བརྒྱད་དེ་ཕྱི་ནང་གསང་བའི་དུར་ཁྲོད་ཀུན་ཏུ་མཁའ་འགྲོ་ཀ་རི་བརྒྱད་ཀྱི་རྣམ་པ་གསལ་བཏབ་ལ་ཡེ་ཤེས་སྒྱུ་འཕྲུལ་དྲྭ་བས་ཀུན་ནས་ཁྱབ་པར་བསམ་པར་བྱ་ཞིང་།",
    "དེ་ཡང་བསྒྲལ་བྱའི་དངོས་པོ་ནི་བསྲེགས་གཏོར་སྦྱངས་ཏེ་སྟོང་པའི་ངང་ལས་སེམས་ཉིད་ཡི་གེ་ཨ་རྒྱུ་ཏིང་ངེ་འཛིན་གྱིས་བྱིན་གྱིས་བརླབ་པར་བྱས་ནས་གནས་པ་ན།",
    "སླར་འོད་དེ་དག་འདུས་ཏེ་སྔར་ལྟར་ཐ་མལ་པའི་གཟུགས་སམ་ཐོག་མའི་གཟུགས་སུ་བསམ་པ་དེ་ལ་གཟུད་པར་བྱའོ།",
    "མས་ནས་ཡར་རིགས་ལྔའི་སྐུ་རྣམས་གཅིག་ལ་གཅིག་ཐིམ་ཞིང་བསྡུ་བའི་སྦྱོར་བས་གནས་སྦྱོང་ཞིང་རྣམ་པར་ཤེས་པ་རྡོར་སེམས་ཀྱི་རྣམ་པར་འོག་མིན་ན་བཞུགས་པའི་ཞི་ཁྲོའི་ལྷ་ཚོགས་ཡབ་ཡུམ་ཐབས་ཤེས་སུ་འབྲེལ་བའི་སྦྱོར་མཚམས་ཀྱི་མཁའ་ལ་བསྟིམ་ནས་དེ་བཞིན་གཤེགས་པའི་སྲས་སུ་བཞག་པར་བྱའོ།",
    "སྐྱེ་མེད་ཀྱི་ངང་ལས་སྐྱེ་བའི་ཆོ་འཕྲུལ་དཔལ་ཆེན་པོར་གསལ་བའི་ཏིང་འཛིན་གཡོ་མེད་ཀྱི་གདིང་དང་ལྡན་པ་འཇིགས་པ་མེད་པའི་སེམས་སུ་གནས་པ་ཉིད་ཀྱིས་ཅི་རིགས་སུ་དུས་དྲུག་ཏུ་རྒྱུ་བའི་ཉུལ་ལེ་བསྐྲད་པ་ལ་སོགས་པས་བཟློག་པར་བྱའོ།",
    "དངོས་གྲུབ་སྦྱིན་པར་མཛད་པའི་ཡེ་ཤེས་ལྷའི་གཟུགས་ཅན་ནམ་མཚན་མ་བྱུང་བ་ལ་ཡང་།",
    "མཉམ་པའི་ལྟ་བས་ཟིལ་གྱིས་མནན་པར་བྱའོ།",
    "དེ་ཡང་ཕན་བྱེད་ཀྱི་ལྷ་དང་གནོད་པར་བྱེད་པ་བགེགས་རྣམ་པ་གཉིས་པོ།",
    "ཐབས་དང་བློ་གྲོས་ཀྱིས་བཟང་ངན་གྱི་བྱེ་བྲག་མ་ནོར་བ་ཉིད་དུ་ནི་ཤེས་པར་བྱ་དགོས་ཤིང་།",
    "གལ་ཏེ་རང་དོན་གྲུབ་པ་དངོས་གྲུབ་ཀྱི་མཚན་མ་མིན་པར་བགེགས་ཀྱི་མཚན་མ་ཡིན་ན་ནི་བར་དུ་གཅོད་པའི་འབྱུང་པོ་དེ་དག་ལིངྒ་ལ་དགུག་བསྟིམ་བྱས་ཕུར་བུས་གདབ་ལ་ཁྲོ་བོ་རོལ་པའི་བྲོས་གཟིར་ཞིང་བསྐལ་པའི་བར་དུ་ལྡང་མེད་དུ་མནན་པར་བྱའོ།",
    "འདོད་དོན་དངོས་སུ་གྲུབ་པའི་ཕྱིར་སྒྲུབ་པ་ཆེན་པོ་ཕྱི་ནང་གསང་བའི་ཚུལ་དུ་བརྩམ་པར་བྱའོ།",
    "དེ་ཡང་བསྒྲུབ་པར་བྱ་བ་རྡོ་རྗེ་དངོས་གྲུབ་དམ་པ་ཉིད་ཉི་མ་ནུབ་ཅིང་དམར་ཐག་ཆད་ནས་ནི།",
    "སྣང་སྲིད་ལྷའི་དཀྱིལ་འཁོར་འོད་དུ་ཞུ་བ་རྫས་ལ་ཐིམ་པའི་ཚུལ་གྱིས་དངོས་གྲུབ་བསྡུས་ཏེ་ཡི་གེ་གསུམ་གྱི་རྣམ་པར་རྡོ་རྗེ་ལྕེས་མྱོང་བས་རང་ཉིད་སྐུ་གསུང་ཐུགས་ཀྱི་དངོས་གྲུབ།",
    "སྒྲུབ་པ་ཆེན་པོ་ཡང་དང་པར་གྲུབ་པ་ཞེས་བྱ་བ་གྲུབ་པའི་སློབ་དཔོན་ཆེན་པོ་བཛྲ་ཧཱུྃ་ཀཱ་རའི་ཞལ་སྔ་ནས་མཛད་པ་རྫོགས་སོ།",
    "ཁཾ་ཞེས་ཞི་གནས་ཀྱི་ཆུས་བཀྲུས་པར་བསམས་ལ།",
    "ཞེས་ཀུན་གཞི་མ་བཅོས་པ་དབྱིངས་རང་བཞིན་རྣམ་པར་དག་པའོ།",
    "དོན་རྣམ་པར་སྣང་མཛད་ཀྱི་ངོ་བོ།",
    "ཏ་ཐ་ཧཾ་བཛྲ་ནན་ཞེས་རྡོ་རྗེ་རྒྱ་གྲམ་གྱིས་མནན་པར་བསྒོམ།",
    "ཀུན་ལ་ཁྱབ་པའི་སྐུ་གཟུགས་ནི།",
    "གཉིས་བརྐྱང་བསྐུམ་དུ་བཞུགས་པ།",
    "རྡོ་རྗེ་པད་མ་མཉམ་པར་སྦྱོར་བ་ནི།",
    "མགྲིན་པར་པདྨའི་སྟེང་དུ་གསུང་རྡོ་རྗེ།",
    "ལྟག་པར་པད་མ་ཧེ་རུ་ཀ།",
    "གཡོན་དེས་ཡུ་བ་བྱས་པའི་དྲིལ་བུ་འཛིན་པ།",
    "ཞེས་གཉིས་སུ་མེད་པར་བསྟིམས་ནས།",
    "དེ་བརྟན་པར་བཞུགས་སུ་གསོལ་བ་ནི།",
    "གུས་དང་དགྱེས་པར་བྱེད་པ་པོ།",
    "ཡབ་ཡུམ་འདུ་འབྲལ་མེད་པར་འཁྲིལ།",
    "ཞེས་པ་དང་བསྟོད་པ་རྣམས་བྱས་ནས།",
    "རང་བྱུང་ཡེ་ཤེས་སེམས་དཔའ་བཞུགས།",
    "ཐབས་མཁས་གཉིས་སུ་མེད་པར་གཤེགས།",
    "ལྷ་ཚོགས་ཁྱེད་ལ་མཐོལ་ལོ་བཤགས།",
