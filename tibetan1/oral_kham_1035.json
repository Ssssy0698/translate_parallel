    "རྩོལ་སེམས་ཀྱང་རང་ཉིད་ངལ་བའི་རྒྱུ།",
    "དོན་དེས་ཀྱང་རང་ཡན་སྨྱོན་པ་ང་སྐྱིད་དོ།",
    "དངོས་པོ་གཤིས་ཀྱི་འདུག་ཚུལ་ཇི་ལྟ་བུ།",
    "དངོས་པོ་གཤིས་ཀྱི་འདུག་ཚུལ་ངོ་བོས་སྟོང་།",
    "རང་རང་རྟོག་པའི་འཆིང་བས་དཀྲིས།",
    "ཕྱིས་ནས་འགྱོད་ཚེ་འཕྱིས་པར་གདའ་འོ།",
    "ང་རང་ཡང་སྐྱ་མིན་སེར་མིན་སྙམ།",
    "སྤྲང་རང་གཤིས་དོན་དམ་བདེན་པའི་མཐུས།",
    "སྲིད་པའི་རྒྱ་མཚོར་ལྷུང་ཉེན་གདའོ།",
    "ཉལ་སྙེས་ཁ་སྦུབ་འགྲོ་འདུག་མང་འདིས།",
    "ལྟོ་འགྲོ་རྐང་མངས་སྒྲུབ་ཉེན་གདའ་འོ།",
    "རྙོག་བྲལ་ཏིང་འཛིན་སྒྲིབ་གཉེན་གདའོ།",
    "ད་ནི་དོན་དུ་དབྱེ་བ་མི་གདའ་ན།",
    "ཙ་ན་ཀ་མཚུངས་ཐིག་ལེ་ཐིག་ཕྲན་ནི།",
    "འགྲོ་འདུག་ཟ་འཆག་དུས་ཀུན་དུ།",
    "གཅིག་པུར་འདུག་ཚེ་གཡེང་བ་སྤང་ཞིང་།",
    "སྣ་ཚོགས་ཅིར་སྣང་རང་བཞིན་ལོངས་སྤྱོད་རྫོགས།",
    "ཕྱོགས་སུ་མ་ལྷུང་རང་སེམས་དྲི་མེད་འདི།",
    "ཇི་ལྟར་བྱས་ཀྱང་ཁོ་རང་ཉིད་དུ་གོ།",
    "ལྟ་སྒོམ་སྤྱོད་གསུམ་ཁ་ནར་གདའ་བོ་ཞེས།",
    "འཐད་པ་འདུག་ན་བདག་དོན་འདིས་འགྲུབ་ཅིང་།",
    "གེགས་ཀྱང་འདིས་སེལ་བོགས་ཀྱང་ཁོ་རང་ཐོན།",
    "ཟ་འཐུང་རྒྱུ་འདི་རྙེད་གཅིག་འོང་བ་གདའ་བ་འདི།",
    "ཙ་ནའི་འབྲུ་ཙམ་རིལ་ཆུང་གསུམ་བྱིན་ནས།",
    "སྔར་བསྲོལ་གང་འདུག་ཁུར་དུ་བླངས་ཏེ་བསྒྲུབས་ལགས་པས།",
    "ཡིད་གཉིས་ཐེ་ཚོམ་བཅས་པར་གྱུར་འདུག་ཀྱང་།",
    "ད་ལྟའི་ལུགས་ལ་སྐད་ཆ་འཇམ་པར་འདུག།",
    "མདང་ད་ནངས་སྐུ་སྙོམས་མུས་བྱུང་འདུག་པ་ཐུགས་ལ་བཏགས།",
    "ཡང་མཚན་དུས་ཉིན་པར་གྱི་འཆར་སྒོའི་རྩལ་སྣང་རང་ལས་འཛིན་པའི་ངོ་བོ་མ་གྲུབ་པ།",
    "བདག་ཀྱང་བསམ་པ་འགྲུབ་པར་འདུག་པས་ཤིན་ཏུ་སྐྱིད་པ་ལགས།",
    "ས་ཞིང་སྦྱིན་པའི་ཡི་གེ་གང་འདུག་ལ།",
    "ཉིད་བསམ་ཡས་ཀྱི་མཐིལ་འདིར་སྐྱེ་བ་བཞེས་འདུག་ཀྱང་།",
    "ཁྱེད་རང་ཚང་ལ་གང་དགོས་ཀྱི།",
    "ཇི་ལྟར་བྱས་ཀྱང་གང་ལྟར་འདུག་ཀྱང་།",
    "གཅིག་པུར་འདུག་ཀྱང་།",
    "འདི་མེད་ན་གོལ་ས་ཆེན་པོ་ཞིག་འདུག་གང་ལ་ཟེར་ན།",
    "ལོག་པར་ལྟས་ན་ལྷས་ཀྱང་རང་སྲོག་གཅོད།",
    "སྔ་སོར་ནས་འདི་ཕྱོགས་ཕེབས་བཞེད་ཆེད་པོ་མཛད་འདུག་ཀྱང་།",
