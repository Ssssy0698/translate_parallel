    "རང་རང་འཁོར་ལོས་སྟེང་དྲིལ་དོར།",
    "རང་རང་འཁོར་ལོས་སྟེང་དྲིལ་བ།",
    "རང་རང་འཁོར་ལོའི་རྙེད་པ་ནི།",
    "བདག་དུས་འདི་ནས་བཟུང་སྟེ།",
    "བཅུ་པ་འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན་ལྷ་ལྔའི་དཀྱིལ་འཁོར་ནི།",
    "དེ་ལྟར་བྱས་ན་རང་གོ་བདེ་ཞིང་གཞན་ལ་འགྲེལ་བདེ་བ་ཞིག་འདུག་སྟེ་སྒྲུབ་བྱེད་ནི་བོད་མཁས་པས་ཇི་ལྟར་གསུངས་པ་ཁོ་ནས་འཐུས་པར་སེམས་སོ།",
    "དཔའ་བོ་དེས་གསོད་བཟུང་རྡུང་སོགས་ཅི་འདོད་དུ་བྱེད་སླ་བའི་ཐོག་ནས་དཔའ་བོར་བསྔགས་པ་ང་མི་ཉུང་བ་ཞིག་འདུག་པས་བརྗོད་ཚུལ་དེ་ལྟ་བུས་བསྔགས་ཡུལ་གྱི་དཔའ་བོ་དེ་ཁྱད་དུ་འཕགས་པ་ཞིག་ཏུ་མཚོན་པར་ནུས་པ་ལྟ་ཅི།",
    "མང་དུ་ཐོས་པའི་རྒྱ་མཚོའི་ཆུས་བརླན་པར་བྱས་པ་ཞིག་ཀྱང་འདུག་པར་གྱུར་ཏོ།",
    "རྒྱན་ཡང་རང་བཞིན་བརྗོད་པ་ཙམ་ལས་སྦྱོར་མི་རུང་བ་སོགས་ཀྱི་ཁྱད་པར་འོག་ཏུ་འཆད་པར་འགྱུར་བས་འདིར་མང་དུ་སྨྲོས་པའི་དགོས་པ་མ་མཆིས་སོ།",
    "དེ་དག་ཀྱང་རང་གོ་བདེ་ཞིང་གཞན་ལ་འགྲེལ་བདེ་བ་ཞིག་ནི་དཀོན་པ་ཙམ་དུ་མཐོང་ངོ།",
    "ཞེས་བསྒྱུར་བཅོས་མཛད་པ་ལ་འབྲུག་ཁམས་སྤྲུལ་གྱི་སྔ་མ་ལྟར་ལེགས་པར་གསུངས་འདུག་ལ་སྔ་མ་དེ་ཀ་གོ་བདེ་བར་སྣང་ངོ།",
    "རྒྱན་ཡང་རང་བཞིན་བརྗོད་པ་ཙམ་ལས་ཕུལ་བྱུང་དང་།",
    "རྒྱན་ཡང་རང་བཞིན་བརྗོད་པ་ཙམ་ཡིན་པ་ནི་ལྷོ་ཕྱོགས་པ་དང་ཁྱད་པར་མེད་དོ།",
    "དཔེར་བརྗོད་ཐམས་ཅད་ལའང་དེ་བཞིན་དུ་སྦྱར་འདུག་ཀྱང་དེ་ནི་ནོར་བ་སྟེ།",
    "དག་བྱེད་ཅེས་པ་ཆུ་ཡིན་པར་འགྲེལ་པ་སོགས་ནོར་འཁྲུལ་རྒྱུན་འབྱམས་པ་ཞེ་ཅིག་ཏུ་འདུག་ལ།",
    "མཆུ་དམར་པོ་ཡིན་པའི་ཁྱབ་པ་ནི་མི་འདུག་གོ།",
    "ཟུར་མཁར་བ་སོགས་སྙན་ངག་བསླབས་པ་རྣམས་ཀྱིས་དོགས་པ་སྐྱེས་པ་ཡིན་འདུག་ལ།",
    "གསལ་ལྟ་བུ་སྦྱར་ན་བྱ་བ་དང་ཡོན་ཏན་གྱི་དབྱེ་བ་གསལ་པོ་ཡོང་ངེས་པར་སེམས་ཀྱང་གཤམ་དུ་བྱ་བ་བརྗོད་པ་བར་གྱི་གསལ་བྱེད་ཀྱི་སྐབས་སུ་རྩ་བའི་དཔེར་བརྗོད་དུའང་མེ་རུ་འགྱུར་ཞེས་བྱ་བྱེད་ཐ་མི་དད་པ་སྦྱར་འདུག་པས་དཔྱད་པར་མཛད་རིགས་སོ།",
    "སྤུ་སྡུག་རྣམ་བཀྲའི་བྱ་དང་བྱེའུས་རང་རང་སྙན་པའི་སྒྲ་སྒྲོག་པ་།",
    "དེ་དག་ཀྱང་རང་བཞིན་གྱི་ཡུལ་གྱི་བཀོད་པ་སྟོན་པ་ལ་འཇུག་ལ།",
    "འདིར་ཡང་རང་བཞིན་མ་བརྗོད་པར།",
    "སྤྲིན་གྱི་རྩོམ་པའང་རང་བཞིན་གྱིས།",
    "སྦྲང་ཆུང་རང་སྲོག་གཅོད་པ་དེས།",
    "ཡིད་ལ་དྲན་ཚད་བཅས་ཡི་གེར་འགོད་པ་ནི་སྣག་ཤོག་དུས་གསུམ་འགྲོན་པའི་རྒྱུ་ཙམ་ལས་རིན་ཐང་ཏིལ་འབྲུ་ཙམ་མེད་པ་ཞིག་ཏུ་འགྱུར་བས་རྩོམ་གྱི་ལྷུ་ཚིགས་གང་ཞིག་ལ་དོན་གང་ཞིག་བྲིས་ན་སྔ་ཕྱིའི་ཚིག་དོན་ལ་ཕན་པ་ཡོད་མེད་བསམ་བློ་ངེས་པར་གཏོང་དགོས།",
    "འོན་ཏེ་དེང་སང་ཡིག་འབྲུ་ཇི་ཙམ་མང་བ་དེ་ཙམ་གྱིས་ལེགས་པར་འཛིན་པ་ལྟ་བུ་འདུག་པས་ལྟ་ཚུལ་དེ་ལྟ་བུས་བོད་ཀྱི་རྩོམ་རིག་འཕེལ་བ་ལ་ཕན་པ་མེད་པར་སེམས་སོ།",
    "ཚིགས་བཅད་ཕྱེད་དང་རངས་པོ་ལྡོག་པ་གསུམ།",
    "ག་ཙ་ན་ཡང་རབ་གསལ་བ།",
    "ག་ཙ་ན་ཡང་ཞེས་པ་ནི།",
    "འདུག་ཀྱང་འདར་ལྡན་བདག་ལ་ནི།",
    "རྒྱང་ན་འདུག་པའི་མ་མ་འདིས།",
    "འཁོར་ཉན་ཏེ་གླུ་དབྱངས་ཀྱི་ངེས་པ་བདུན་པོ་དེ་དག་ཀྱང་ཐ་དད་པའི་ལམ་རང་རང་འཇུག་ཡུལ་དང་མཐུན་པར་སྦྱར་དགོས་ཏེ་ཇི་སྐད་དུ།",
    "སླར་མཚོ་རིམགྱིས་དྲི་ནས་དཔལ་ཧེ་རུ་ཀའི་ལྷ་ཁང་རང་བྱུང་ཞིག་ཀྱང་བྱུང་།",
    "དེར་ལོ་བཅུ་གཉིས་འདག་སྦྱར་མཛད་པར་དགོངས་ཙ་ན།",
    "དེང་སང་རང་ལུགས་སྒྲ་ཤེས་ཉུང་བས་འདིར།",
    "བསྟན་ལ་ཕྱག་རྗེས་མེད་ཀྱང་རང་སྲོག་ལ་ཉེས་སྐྱོན་མེད་པར་ཟུར་དུ་བྱོན།",
    "འབྲིང་རང་མཚན་ཕྱོགས་གཅིག་ཉམས་འོག་ཏུ་ཚུད་གཐམའང་ངོ་དོན་སྤྱི་བློ་ལ་ཤར་བ་གང་རུངུ་དང་ལྡན་པ་ཞིག་གལ་ཆེ་ཁང་།",
    "བསྟིམ་བྱའི་ཡེ་ཤེས་པ་དེ་གང་ལ་ཟེར་བ་གང་ཟག་ཁོ་རང་ལའངཆ་མེད་པའི་བྱིར་རོ།",
    "ཞལ་ནས་འཐོན་ཁྱེད་རང་རྣམས་ཀྱི་ཞལ་ཞུ་ཞུགས།",
    "ཌི་སུལནས་ལོང་བའི་སྤོང་བ་བསམ་གཏན་པའི་སྒོམ་ཆེན་པ་གཉིས་སྤྱོད་ཡུལ་གྱི་གྲོང་དུ་ཕྲད་ནས་བག་ཕབ་སྟེ་འདུག་པའིཚེ་སྒོམཆེན་པས་ཟེརབ།",
    "སྒོམ་དང་མ་སྒོམ་ཁྱད་པར་མི་འདུག་ན།",
    "འོན་ཀྱང་རང་ཡང་བཙུགས་པའི་ཤིང་དང་བསྐོས་པའི་མི་ཞིག་ཡིན་པ་ལས།",
    "རང་ལ་མི་ལྡོག་པའི་ཕྱིར་སྲུང་བའི་གོ་བགོས་ཏེ་བསད་པའི་ལས་ལ་ཞུགས་ཤིང་རང་བཞིན་གྱི་ཁ་སྦྱར་དབྱེ་བའི་ཕྱིར་སྐྱིང་རྗེ་ཁྲོས་པའི་ཚུལ་དུ་ཕུར་ཚུ་གནས་བཞིར་གཟིར་བས་བདུད་བཞི་གཤེད་དུ་ཕབར་ནི་དགྲ་དངོས་སུཚར་བཅད་པ་ལྟ་བུ་ཡིན།",
    "སྟོན་ཅི་འདུག་བརྟག།",
    "བདེ་བར་འདུག་ལ་མཁས་པར་མི་འགྱུར་ཞེས།",
    "ཅེསགསུངས་གཞན་ཡང་དེངསང་སྙིག་དུས་འདིར།",
    "གཞན་ཡང་འཇིག་རྟེན་འདི་ནའང་རང་ཉིད་ལ།",
    "གང་ལ་བསབས་ཀྱང་ཡིད་བརྟན་མི་འདུག་པས།",
    "ཡུན་རིང་གནས་པའི་ངེས་པ་མི་གདའ་བས།",
    "བསྐྱེད་རིམ་རྣལ་འབྱོར་ལ་འཇུག་དུས།",
    "གསང་སྔགས་བཟླས་བརྗོད་ལ་འཇུག་དུས།",
    "ལྷག་མཐོང་རྣལ་འབྱོརལ་འཇུག་དུས།",
    "རང་ལ་གྲོས་འདེབས་བྱེད་མཁན་སུ་འདུག་ཀྱེ།",
    "ཕྱི་མར་བུ་ལོན་ལུས་ལས་འཇལ་དགོས་པར་འདུག་གོ།",
    "སྔར་བྱས་ལས་ངན་འཛད་པའི་ཕྱགས་ཤིང་ངུ་འདུག་གོ།",
    "ཆགས་སྡང་མཚོན་གྱིས་ཕིག་པ་དཀའ་བ་རུ་འདུག་གོ།",
    "ཞྭ་གོས་དམར་སེར་ཙམ་གྱིས་ཕན་པ་རང་མི་གདའ།",
    "ལ་ལུང་མང་པོ་རྒྱབ་སྟེ་བཙལ་དགོས་ནི་མི་འདུག།",
    "ཕ་རོལ་ག་ཤེད་ཞིག་ནས་བཙལདགོས་ནི་མི་གདའ།",
    "༣༥༧༧ ཙ་ན་ཀའི་རྒྱལ་པོའི་ལུགས་ཀྱི་བསྟན་བཅོས།",
    "ཆང་དང་རང་སྐྱུར་བཅས་པ་དང་།",
    "དཔེར་ན་ཁྱབ་འཇུག་ཅེས་བྱ་བ་སྲེད་མེད་ཀྱི་བུས་ལྷ་མ་ཡིན་རྣམ་པར་བཅོམ་པར་གྱུར་ན་གནས་ཤིང་འདུག་པའི་མཐུ་མེད་པ་དང་འདྲའོ།",
    "རང་རང་གནས་སུ་འགྲོ་བར་འགྱུར།",
    "ཤིན་ཏུ་ཚོར་བ་མེད་ཅིང་བེམ་བེམ་པོར་འདུག་པ་དང་།",
    "དེ་བས་ན་སོ་མ་ར་ཛའི་ཁུ་བ་དེ་འཐུངས་ནས་ལུས་བསྐུས་ཏེ་ཉམས་སྟོབས་ཀྱིས་ཇི་ཙམ་བཟོད་པར་ཉི་ཚན་ལ་བསྟན་ཅིང་འདུག་པར་བྱའོ།",
    "དྲོ་བར་འདུག་ནས་ཆུ་བུར་བྱུང་བ་ན།",
    "སོ་མ་ར་ཛའི་ལྡེ་གུ་ཤིང་བལ་གུ་དང་སྐྱུ་རུ་ར་ལ་སོགས་པའི་ཤུན་པ་བསྐོལ་བའི་ཁུ་བ་དང་སྦྱར་ཏེ་བླུད་ནས་ཤ་བཀྲ་ཅན་དེ་ཉི་ཚན་དྲོ་བ་ིལ་འདུག་ཏུ་བཅུག་ནས་ཆུ་བུར་བྱུང་བར་གྱུར་པ་དང་།",
    "ཞུ་བའི་གནས་འདུག་སྣུམ་དུགས་༧ ཀྱིས།",
    "ཤ་མ་ཞེས་བྱ་བ་རྩ་བ་དམར་ནག་ཏུ་འདུག་པ་ནི་གཅིག་ཡིན་ལ།",
    "ཞུ་བའི་གནས་འདུག་དུགས་བྱས་ལ།",
    "མས་གཏོང་བ་ཞུ་བའི་གནས་ན་འཁྱིལ་ཞིང་འདུག་པར་གྱུར་ན།",
    "སྣུམ་པ་དང་ལན་ཚྭ་དང་དྲོ་བ་དང་སྐྱུར་བའི་བག་དང་ར་སྣ་དང་བི་ད་དྲོ་བཙིར་བའི་མར་དང་རང་ིསྐྱུར་ལ་སོགས་པ་བསྐོལ་བའི་ནི་རུ་ཧ་མས་གཏོང་བས་ལེགས་པར་བསལ་བར་བྱ་བའམ།་",
    "རིགས་དང་རང་བཞིན་དེ་དང་མཉམ།",
    "རིགས་དང་རང་བཞིན་བྱིས་པ་དེ་དང་མཉམ་པ་དང་།",
    "རོ་བསྐ་བ་དང་རང་བཞིན་རྩུབ་པ་དང་།",
    "སྤྱིན་༡བག་ནལ་ནལ་པོར་འདུག་པ་དང་།",
    "ཡུད་ཙམ་འདུག་ལ་དེ་རྗེས་བཀྲུ།",
    "འབྱུང་པོའི་གཟུགས་དང་རང་བཞིན་དང་།",
    "དེའི་གཟུགས་དང་རང་བཞིན་ལ་སོགས་པའི་ཚུལ་མཐུན་པར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་མི་དེ་ལ་གདོན་དེ་ཞུགས་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ཡོན་པོར་བལྟ་ཞིང་རང་བཞིན་ངན།",
    "གཅེར་བུར་འདུག་ཅིང་གོས་མེད་པར་གནས་པ་དང་།",
    "༢༦༩ལ་སོགས་པར་བརྟེན་ཅིང་འདུག་པར་དགའ་བ་དང་།",
