    "མིའི་རིགས་ཀྱིས་དུས་རབས་བཅོ་བརྒྱད་པ་དང་བཅུ་དགུ་པའི་ནང་སྔར་སྲོལ་གྱི་འདུ་ཤེས་ཡུལ་ལས་བརྒལ་བའི་ཚན་རྩལ་གྱི་འབྲས་བུ་སྣ་ཚོགས་ཤིག་འཁྱེར་ཏེ་དུས་རབས་ཉི་ཤུ་པར་བསྐྱོད་པའི་དུས་གངས་རིའི་ཁྲོད་དུ་གནས་པའི་སྤུན་ཟླ་རྣམས་མ་ཆོག་འཛིན་གྱི་འདུ་ཤེས་དེར་མགོ་འཁོར་ཏེ་བསྡད་པས་ད་ལྟ་འི་ཆར་སྨོས་མ་དགོས་པའི་འབྲས་བུ་ཞིག་སྨིན་ཡོ་ད་ང་འདི་ཡང་།",
    "ཤེར་རྟོགས་རིག་པའི་ཤེས་རབ་དང་ལྷའི་རིག་པའི་ཤེས་རབ་གཉིས་དབར་དབྱེ་འབྱེད་བྱས་པར་བརྟེན།",
    "པའམ་ཤེར་རྟོགས་རིག་པའི་ཤེས་རབ་ཁོ་ནའི་ཕྱོགས་སུ་གཞོལ་བར་ཧུར་བརྩོན་བྱས་ཡོད་པ་ནི་གཞི་གྲུབ་སྨྲ་བ་དང་དངོས་སྤྱོད་སྨྲ་བ།",
    "མཛའ་ཞིང་བརྩེ་བའི་ཀློག་པ་པོ་རྣམ་པ་ལགས།",
    "ས་ཉེན་དེ་འདྲ་འབྱུང་མི་སྲིད་པར་སྨྲ།",
    "ཤེར་རྟོགས་རིག་པས་དངོས་པོ་ཉིད་རིན་ཐང་ལྡན་པར་སྒྲོག་པ་དང་།",
    "ཨབ་རུ་སི་ཐོ་ཐོར་གྱིས་ལྷ་སྒྲུང་ལ་དགའ་བའི་མི་ནི་ཤེར་རྟོགས་རིག་པ་ལ་དགའ་བའི་མི་ཡིན་པ་དང་དེས་ན་ཤེར་རྟོགས་རིག་པ་ནི་ཐོག་མར་ལྷ་སྒྲུང་ལ་བརྟེན་ནས་བྱུང་བར་བརྗོད།",
    "དུས་རབས་བཅོ་བརྒྱད་པའི་ནང་དུ་ཚན་རིག་དང་ལོགས་སུ་དབྱེ་སྟེ་ཤེར་རྟོགས་རིག་པ་ཞེས་གཞུང་ལུགས་འཐུས་ཚང་ཅན་དུ་གྱུར་པར་བརྗོད།",
    "མི་རང་ཉིད་རང་ལས་བརྒལ་བར་བྱས་ཏེ་ལྷ་རུ་འགྱུར་བ་དང་།",
    "ཕུགས་བསམ་གྱི་གླིང་དེ་ནི་མིའི་རིགས་ཀྱི་བདེ་བ་ཆེས་ཆེ་བའི་ཡུལ་ཡིན་པར་འདོད།",
    "དེར་བརྟེན་མི་རིགས་ཤིག་ལ་ངེས་པར་མཁོ་བ་ནི་སྲོལ་རྒྱུན་དང་དེང་རབས།",
    "བསམ་བློའི་ལྟ་ཚུལ་གསར་པར་གོང་བཀུར་མི་བྱེད་པ་འདིས་མཚོན།",
    "ཁའར་མར་ཁེ་སིས་དངོས་པོ་ནི་འགུལ་བསྐྱོད་ཅན་དུ་གསུངས་པ་དང་།",
    "སྟོན་པ་ཤཱཀྱ་ཐུབ་པས་འཇིག་རྟེན་མི་རྟག་པར་གསུངས་པའི་ལྟ་ཚུལ་དེ་དག་ལ་ངེས་ཤེས་འདྲོངས་ཚེ་འཇིག་རྟེན་དུ་རྟག་བརྟན་མི་འགྱུར་བའི་བྱ་དངོས་ཤིག་མི་སྲིད་པ་དང་དེའི་ནང་མིའི་རིགས་ཀྱི་རིགས་ཤེས་ཡོད་ཚད་དང་།",
    "ཡོན་ཏན་འཛིན་པར་ཞེན་པས་ན།",
    "གཞན་ལ་སྐྱབས་སུ་མཆིས་པར་གྱུར།",
    "ཞེས་རྟིང་སྐུལ་བྱས་ཡོད་པ་དང་།",
    "གང་ཞིག་རིགས་པར་ལྡན་པའི་ཚིག།",
    "ང་འཇིག་རྟེན་དང་མི་རྩོད་ཅེས་པའི་གསུང་ལ་གོང་བཀུར་ཞུས་ཏེ་ལན་གདབ་པར་མི་བྱའོ།",
    "ལེགས་པར་བརྟག་ལ་ང་ཡི་བཀའ།",
    "བླངས་པར་བྱ་ཡི་གུས་ཕྱིར་མིན།",
    "ཤེས་པ་མེད་པར་ཤེས་བྱ་མེད།",
    "མ་བསླབས་པར་ནི་ཀུན་མཁྱེན་དུ།",
    "བྱས་པ་ལྟ་བུ་ཆེད་དུ་མི་མཐུན་པ་སྦྱར་ན།",
    "གཙུག་ལག་གཞན་གྱིས་གྲུབ་པའི་མཐའ་ཡོད་པར་གྱུར་ཏེ།",
    "སུམ་གཅིག་བསྡུས་ཀྱི་ལྷ་ཡིན་པར་འདོད་པའི་ལྟ་ཚུལ་གྱི་འབྲས་བུ་ཞིག་ཡིན་པ་དང་།",
    "ཕྱོགས་གཞན་ཞིག་ནས་བསམ་བློ་བཏང་ཚེ་བོན་པོ་ཚོས་ཁྲི་སྲོང་ལྡེ་བཙན་ནི་གཡུང་དྲུང་བོན་གྱི་བསྟན་པ་སྣུབ་མཁན་ཡིན་པར་བརྗོད་ལ།་",
    "ཡེ་ཤུ་བཅས་ཀྱི་རྗེས་སུ་འཇིག་རྟེན་མགོན་པོས་མི་ཡུལ་དུ་མངགས་པའེ་མཐའ་མཇུག་གེ་བང་ཆེན་དེ་ཡིན་པར་བརྗོད་པ་དང་།",
    "དེས་ན་དགེ་ལུགས་པ་ཞེས་པའི་མིང་དེ་ཇི་ལྟར་ཐོགས་ཚུལ་གསལ་རྟོགས་དགོས་ཚེ་ཐོག་མའི་རྨང་གཞི་དགའ་ལྡན་ཞེས་པའི་ཐ་སྙད་དེ་ཇི་ལྟར་བྱུང་བ་ངེས་པར་རྟོགས་དགོས་པས་འདིར་དགའ་ལྡན་ཞེས་པའི་ཐ་སྙད་ཀྱི་བྱུང་བ་བརྗོད་པ་ལ།",
    "དེ་འདེབས་པ་པོ་ནི་རྗེ་བློ་བཟང་གྲགས་པ་ཡིན་པར་བསྟན་པ་དང་།",
    "དུ་མའི་ཕན་བདེ་སྒྲུབ་པར་བྱེད།",
    "བང་དུ་བྱས་པར་ཕྱིས་ཀྱི་མཁས་པ་ཚོས་མགྲིན་གཅིག་ཏུ་གླེང་།",
    "རྗེ་ཙོང་ཁ་པས་སྟོང་པ་ཞེས་ཐད་ཀར་མ་བརྗོད་པར་རྟེན་འབྲེའ།་",
    "དྲང་དོན་དང་ངེས་དོན་གྱི་ཁྱད་པར་རམ་དྲང་ངེས་སུ་ཕྱེ་བ་ལ་དགོས་པ་དུ་རྨ་ཞིག་ཡོད་པ་ནི་རྒྱ་གར་བ་སློབ་དཔོན་འཕགས་པས་བདེན་གཉིས་ལ་མི་རྨོངས་པ་དང་དེའི་དགོས་པ་ཤེས་པ་དང་།",
    "ཡང་དྲང་དོན་ངེས་དོན་གཉིས་གང་ཡིན་སྙམ་པའི་ཐེ་ཚོམ་དང་དྲང་དོན་ལ་གནས་ལུགས་ངེས་དོན་དུ་འཛིན་པའི་ལོག་ཤེས་བསལ་བའི་ཆེད་དུ་ཡིན་ཞེས་གསུངས་པ་ལྟར་ཡིན་ལ།",
    "དོན་དམ་བདེན་པ་དངོས་བསྟན་བསྟན་བྱའི་གཙོ་བོར་བྱས་ནས་བསྟ་ན་པ་དེ་དག་ནི་ངེས་དོན་ལ་བྱའོ་ཞེས་གསུངས་པ་ལྟར།",
    "འཁོར་ལོ་ཐ་མའི་དོན་བཞིན་མཚན་ཉིད་གསུམ་བདེན་པར་ཡོད་ན་ཡོད་མཉམ་དང་མེད་མཉམ་དུ་གསུངས་པ་རྣམས་དྲང་དོན་དང་།",
    "སེམས་ཙམ་པས་ཀུན་བཏགས་བདེན་པར་མ་གྲུབ་པས་རྟག་པའི་མཐའ་སྤོང་ལ།",
    "ངོ་བོ་ཉིད་མེད་པར་གསུངས་ཤིང་།",
    "ཡོངས་གྲུབ་ཀྱི་མཚན་ཉིད་ནི་རྣམ་པར་རྟོག་པའིསྤྱོད་ཡུལ་ཀུན་བཏགས་པའི་མཚན་ཉིད་ཀྱི་གནས་འདུ་བྱེད་ཀྱི་མཚན་མ་དེ་ཉིད།",
