    "ཁོང་སྐུ་ན་བགྲེས་ཙམ་ཞལ་ཚོམ་དཀར་པོ་རིང་པོ་ཅན་བླ་ཆས་ཐོག་གོས་ཆེན་སེར་པོའི་དྷཱ་སྒོག་རྩེ་བཞེས་པ་ཞིག་འདུག།",
    "གཞུང་ཞབས་བྱིངས་ཤག་འཁོར་ཐོག་སྟེང་གུར་གཡབ་འོག་འཁོད་འདུག།",
    "བྱེད་ཀྱི་འདུག་ཅེས་ཟེར།",
    "ལྷ་སར་དམག་འཁྲུགས་སྐབས་མེ་སྒྱོགས་རྒྱབ་པའི་སྒྲ་སྐད་དགའ་ལྡན་ཉག་རོང་ལ་ཁར་ཐོས་ཀྱི་འདུག།",
    "གསེར་སྐྱེམས་བཞེས་སྒྲ་གསུང་ཤུགས་ཆེན་པོས་གསུངས་པ་རྡོ་ཁང་སྟེང་ཕྲན་གྱི་ཤག་ཏུ་ཐོས་ཀྱི་འདུག།",
    "གཏོར་རྒྱག་སོ་སོའི་སྐབས་གསེར་སྐོང་རྡོ་རྗེ་འཆང་ཐུགས་ཉམས་འུར་ཏེ་ཟོར་འཆབས་སྣ་ཚོགས་འཁྲུལ་ལིང་ལིང་དུ་བསྐྱོན་གྱི་འདུག་པར།",
    "ཅེས་སོགས་འཁོད་པའི་ཕྱག་བྲིས་ཤིག་སྩལ་བྱུང་བ་ཐུགས་མད་པར་གདའ།",
    "རྒྱུད་གྲར་ཞུགས་སྐབས་གསང་འདུས་རྩ་རྒྱུད་ཀྱང་རང་སྐྱ་མ་འཕེར་བ་ཙམ་ལས་ཚོགས་མང་དང་མཉམ་འདོན་ཐུབ་ཀྱི་ཡོད།",
    "གདན་སའི་ནང་ཁུངས་སོགས་ཕྱི་ནང་མང་པོ་ཞིག་ནས་གནས་དུས་ཚོད་བརྩིས་ཀྱི་སྙད་འདོགས་བསྙོན་དཀྲི་སྣ་ཚོགས་ཀྱིས་གླགས་བལྟ་བ་བྱུང་འདུག་ཀྱང་།",
    "དེའི་དུས་ཀྱི་ཊམ་རྡོ་སུམ་བརྒྱའི་བུ་ལོན་དེ་དག་དུས་ཕྱིས་རྒྱ་དམར་བོད་འབྱོར་སྐབས་ཀྱི་ཊམ་རྡོ་སུམ་ཁྲིའི་བུ་ལོན་དང་འདྲ་མཉམ་གྱི་ཁུར་ཤིན་ཏུ་ལྕི།",
    "དེ་ཡང་རང་བྱུང་རང་ཐིམ་ཡིན་ འཇའ་དང་ན་བུན་ཁུག་སྣ་གསུམ།",
    "བྱུང་ཡང་བར་སྣང་རང་ལས་བྱུང་།",
    "ཐིམ་ཡང་བར་སྣང་རང་ལ་ཐིམ།",
    "དེ་ཡང་རང་བྱུང་རང་ཐིམ་ཡིན།",
    "རྗེས་སོར་ཕྲན་ཁམས་ནས་ཕྱིར་འཁོར་སྐབས་ཁང་ཚན་ནས་ཊམ་རྡོ་ཉིས་བརྒྱའི་བུ་ལོན་གཙང་སེལ་ཐོག་ད་དུང་འབྲུ་དངུལ་གང་འཚམས་གསོག་གནང་འདུག་ཅིང་།",
    "རིག་འཛིན་ནས་བུ་ལོན་སྔོན་ཡོད་ཐོག་ད་དུང་ཕྲན་བུ་འཕར་བླངས་བྱས་འདུག།",
    "བྱམས་མགོན་གྱི་ཕྲ་རྒྱན་དང་གཟུངས་གཞུག་བྱིན་རྟེན་འགངས་ཆེ་སྣ་ཚོགས་བཅས་འཁྱེར་འདུག་པ་མ་ཟད།",
    "བྱས་འདུག་པ་ངེད་རང་དེར་སླེབས་ན་བཏོན་ཆོག་འདུག་ཀྱང་སྟབས་འགྲིགས་དཀའ་བས་གཏད་རུལ་ཚད་ལྡན་ཞིག་བསྒྲུབས་ཏེ་བྲག་རྩ་དེར་སྦ་ཆོག་བྱ་རྒྱུ་གལ་ཆེན་ཡིན་ཅིང་།",
    "ཁམས་ཀྱི་དེར་ཁྱེད་རང་ནས་ཐོག་གཉིས་ཕབ་འདུག་པས་འཇོམས་འདུག་ཅིང་།",
    "དགའ་ལྡན་གྱི་མདུན་ཆུ་མིག་ཡོད་སར་གཅིག་འདུག་པར་གཏད་རུལ་བྱ་དགོས་ཞེས་གསུངས་བྱུང་བ།",
    "ལམ་བྲག་སྐུ་གོང་མ་གྲུབ་ཐོབ་རྣལ་འབྱོར་པའི་ངང་ཚུལ་ཅན་ཞིག་དེ་ཕྱོགས་བཞུགས་ཡོད་འདུག་པ་མཇལ་འདོད་བྱུང་རུང་།",
    "རྗེ་གོང་མས་སྤྱི་འབུལ་གནང་བའི་མཆོད་རྫས་གོས་ཆེན་ཕྱེ་ཕུར་ཆ་གཅིག་འདུག་ཅིང་།",
    "རྒྱ་ཚ་ཞལ་དཀར་གྱི་རལ་གྲི་ཨ་ཟི་སྐར་བྲན་སོགས་མཇལ་རྒྱུ་འདུག།",
    "གནས་ནང་དེར་སླེབས་ཙམ་ཉིད་ནས་རིག་པ་དྭངས་ཤིང་བག་ཕེབས་པ་ཞིག་འདུག།",
    "རྟ་དྲེལ་དངོས་ཟོག་ཡོད་དོ་ཅོག་འཕྲོག་འབྱེར་བྱས་འདུག་པར་དགྲ་བོ་རྣམས་ལ་དེ་ལན་དེ་མཇལ་མ་བྱས་མཐུ་མེད་སྟབས།",
    "ལྷ་སར་ཕྲན་ལ་འགྱོད་བཤགས་ཀྱི་ཡི་གེ་བསྐུར་འདུག་ཀྱང་ཕན་བསྐྱེད་མ་བྱུང་བར་འདས་འདུག།",
    "བཟང་ངན་ལས་ཀྱི་སྲད་བུས་སྦྲེལ་བའི་འཆིང་ཐག་དེ་བཅད་ཀྱང་མི་ཚོད་པར་གདའ།",
    "སྤུར་བཞུ་བྱ་རྒྱུ་སོགས་ལ་ཁྱེད་རང་བསྐྱོད་དགོས་ཞེས་བཀའ་ཕབ་པ་ལྟར་དེ་འཕྲལ་ཁྲི་པའི་བཞུགས་གནས་ཕུར་ལྕོག་བླ་བྲང་དུ་བསྐྱོད་སྐབས།",
    "ཞིག་བྱ་དགོས་བྱུང་བ་འདི་ལ་དགོངས་པ་ཡིན་ཚོད་གདའ།",
    "རྐང་བགྲོད་ཅི་རིགས་ཀྱིས་བསྐྱོད་དགོས་ཀྱིན་འདུག།",
    "ཞེས་པའི་ཚིག་མཚམས་ནས་ལུང་ཚིག་རྫོགས་འདུག་པར་དཔྱད་ཚེ་རྒྱལ་མཆོག་སྐུ་གོང་མ་སྐུ་ཟིལ་བཙན་བརྗིད་ཆེ་བ་དང་།",
    "བྱ་ལོར་དགོངས་པ་གཞན་དོན་དུ་གཤེགས་པ་སོགས་ལུང་གསལ་ངེས་རྙེད་ཅིག་འདུག།",
    "འགའ་ཤས་ཁོག་བརླམས་ཟིན་ཏེ་ལྷ་མི་བ་རྣམས་གྲལ་འཁོད་ཀྱིས་མྱོས་བྱེད་ཀྱི་བཏུང་བར་རོལ་བཞིན་དུ་བསྡད་འདུག།",
    "བརྗོད་ཕྱོགས་ཕྲན་བུ་མ་གཏོགས་ཕལ་ཆེར་འདྲ་མཚུངས་འདུག་པ་སྔར་རྗེ་ཡབ་སྲས་རྣམས་ས་སྐྱར་ཐུགས་གཉེར་གསན་བསམ་མཛད་པ་དང་།",
    "གཟིམ་ཆུང་ནང་དགའ་ལྡན་སྤྲུལ་པའི་གླེགས་བམ་དུ་གྲགས་པའི་ཕྱག་དཔེ་པོད་གཅིག་ཀྱང་མཇལ་རྒྱུ་འདུག།",
    "རྒྱ་དཔེ་སོགས་ནང་རྟེན་འགངས་ཆེ་མང་ཞིག་འདུག་པ་མཇལ།",
    "ལོ་སྔོན་མ་ནས་བཟུང་སྐྱབས་མཆོག་རྡོ་རྗེ་འཆང་ལ་མནལ་ལྟས་འཚུབ་རིགས་མང་པོ་བྱུང་འདུག་པ་དང་།",
    "ད་ལྟ་གང་བསླབ་པ་རྣམས་གཞིར་བཞག་པའི་ཐོག་རིགས་མཐུན་གྱི་ཆོ་ག་གཞན་ནས་ཁ་འགེངས་འོས་རྣམས་བསྐངས་ཏེ་འདིའི་ལས་ཚོགས་རྣམས་ཁྱེད་རང་ནས་ལེགས་པར་སྒྲིགས་ཤིག།",
    "འཆར་འཕར་གྱི་མཛད་སྒོ་ཁག་བཅས་པར་རྩེ་ཞབས་དྲུང་རིགས་སྤྱི་མཚུངས་བཅར་དགོས་འདུག་པ་ལྟར་བཅར་ཞིང་།",
    "སྣེ་ཟུར་སོགས་བཀའ་གདམས་གོང་མ་རྣམས་ཀྱི་གནས་དགོན་འགའ་ཤས་རི་ཕུག་ཁ་འཐོར་དུ་ཡོད་འདུག་པས་མཇལ་སྟབས་མ་འགྲིགས།",
    "འཁོར་གདོང་ཅན་གཉིས་བྱིས་པ་ལོ་བརྒྱད་ཚོད་ཙམ་བཅས་འདུག་ཀྱང་།",
    "ཐོག་མར་སྐུ་བརྙན་བཞེངས་སྐབས་སུ་སོ་སོར་བཞེངས་གནང་མཛད་འདུག་སྟབས་གདན་ཞུ་བྱ་སྟབས་མི་བདེ་བ་མི་སྣང་བས།",
    "རིག་པ་བརྟུལ་ཞུགས་ཀྱི་སྤྱོད་པ་དང་འབྲེལ་བའི་ཐུགས་ནང་དགེ་སར་སྩལ་བའི་ཕྱག་བྲིས་ཁག་སོགས་སྙན་ཞིང་ཡ་མཚན་པའི་ཤོག་དྲིལ་སྣ་ཚོགས་ཀྱི་ཕོན་པོ་ཞིག་ཀྱང་མཇལ་རྒྱུ་འདུག་པར་ཕྱག་བྲིས་གཟུགས་འབྲིང་ཙམ་ལ་བཀའ་རྩོམ་ཚིགས་བཅད་རྣམས་ཉམས་འགྱུར་ལེགས་པར་སྣང་།",
    "སྣེ་མགྲོན་རང་ཉིད་བློ་ཆུང་གུ་དོག་གྲིབ་མ་ཤ་ཟར་དོགས་པའི་དོགས་པ་སྔུན་བསུས་བྱས་ཚོད་དུ་གདའ།",
    "བཀའ་བླ་ཉིད་ཀྱང་ཉིན་ཤས་རྩེར་བཞུགས་དགོས་འདུག་པས་ཕྲན་གྱི་ཤག་ཏུ་བཞུགས་སྒྲིག་དགོས་ཚུལ་གསུང་བ་བཞིན་རྩེར་འཕྲལ་བསྐྱོད་བྱས་ཤིང་།",
    "མངའ་བདག་ཁྲི་རལ་སོགས་ཀྱི་བྱུང་བ་བཞིན་དུ་དམ་པའི་མཛད་པ་ལ་སྐྱོན་དུ་མི་གདགས་པར་རང་ཉིད་བག་ཡོད་ལ་གནས་དགོས་རིགས་སུ་གདའ།",
    "ལ་མཆོད་སྤྲིན་སྤྲོ་རྒྱུའི་ལག་སྣེ་མི་ཉུང་ཙམ་བསྐུར་བས་མཆོད་འབུལ་གང་རྒྱས་བྱུང་འདུག།",
    "རྗེ་ལྷ་ཁང་གསར་བསྐྲུན་སོགས་ཁོ་བོའི་ངག་བཞིན་བསྒྲུབས་འདུག།",
    "ཆེན་དེ་སྔ་ཐོབ་ཟིན་འདུག་པས་འཐུས་པ་བྱས་ཤིང་།",
    "དེར་ཇོ་བོའི་བཞུགས་ཁྲི་སྟོང་པ་ཞིག་མཇལ་རྒྱུ་འདུག་པར་གོང་ས་མཆོག་དང་ལྷན་བཅར་གྱིས་མཇལ།",
    "ཕྲན་བཅས་གཡི་ཁ་ཇའོ་ཞེས་པར་བཞུགས་སྒྲིག་འདུག་པ་དེར་བསྡད།",
    "ཚོགས་འདེགས་པའི་ཚིགས་བཅད་ཀྱང་བློ་ཐོག་ནས་ཤར་མར་འདོན་རྒྱུ་འདུག།",
    "ཞི་བ་ཁང་ཚན་གྱི་ཡང་སྟེང་དུ་སྡོད་སྒྲིག་གནང་འདུག་པར་གནས་མལ་བཅས།",
    "དགའ་ཚོར་ཆེན་པོ་བྱུང་ལུགས་སོགས་ལེགས་སོའི་སྨྲ་བྱེད་ཀྱི་འདུག་པ།",
    "བཞིན་བཟོད་བཞེས་ཀྱིས་དགོན་ཡུལ་སེར་སྐྱ་ཐམས་ཅད་ལ་ཚེ་རབས་རྗེས་འཛིན་ཡོང་བ་ཞེས་ནན་ཏན་ཆེན་པོས་བརྗོད་ཀྱི་འདུག་པའི་ལན་དུ།",
    "དེ་ནས་བཤུལ་ལམ་རིམ་བསྐྱོད་ཀྱིས་བྲག་གཡབ་ཀྱི་ས་སྣེ་ཟིན་མཚམས་བྲག་གཡབ་བླ་བྲང་ནས་ངེད་ཚོར་སྣེ་ཤན་མགྲོན་གཉེར་ཞིག་གཏོང་གནང་འདུག་པ་ནས་ལམ་སྐྱབས་རྗེ་ཡོངས་འཛིན་ཁྲི་བྱང་རྡོ་རྗེ་འཆང་ཆེན་པོ།",
    "གཅིག་ལ་ལྡོག་པ་ཐ་དད་པའི་མམ་སའི་བཟའ་བའི་རྣམས་གྲངས་ཤིང་འཁྲོལ་ཆེན་པོ་ཁེངས་པ་ཞིག་ཉིན་ལྟར་གཏོང་གནང་མཛད་ཀྱིན་འདུག་སྟབས་ལངྐའི་བདག་པོའི་བརྟུལ་ཞུགས་བཟུང་།",
    "ཁོ་བོའི་སྡོད་གནས་སྔར་ངེད་རང་དགེ་ཚུལ་སྒྲུབ་སའི་གཟིམ་ཆུང་དེར་ཁེལ་འདུག།",
    "ཕྲན་གཉིས་ཀྱང་གོང་ས་ཆེན་པོའི་གཟིམ་ཆུང་དང་ཁད་ཉེར་གྲ་སྒྲིག་འདུག་པ་དེར་བསྡད།",
    "ཕྲན་རྒྱལ་རྩེ་ཞི་གནས་གྲྭ་ཚང་དུ་གྲ་སྒྲིག་འདུག་པར་བསྡད་ཅིང་།",
    "ཡིད་ཆེས་བསྐྱེད་པའི་ངོ་མཚར་ཅན་དུ་གདའ།",
    "གཞུང་གནས་ཀྱི་བསྙེན་འགྱེད་བཅས་འབྲས་སྤུངས་དང་ཕྱོགས་མཚུངས་བསྐྱངས་པའི་མཛད་ཞབས་སུ་བཅར་ཏེ་སེ་རར་བཞུགས་རྒྱུན་རིང་ལྡན་མ་ཁང་ཚན་དུ་སྡོད་སྒྲིག་འདུག་པར་གནས་མལ་བཅའ་སྡོད་བྱས།",
    "ངེད་རང་ཡང་རྡོ་ཁང་ཁང་ཚན་གྱི་ཡང་སྟེང་རང་ཤག་ཏུ་བསྡད།",
    "ཚུར་ནང་དེར་སྟག་བྲག་བླ་བྲང་ཕྱག་མཛོད་ནས་གོང་ས་མཆོག་ལ་གསོལ་འདྲེན་ཕེབས་སྐྱེལ་ཟིན་ཏེ་ཕྲན་ཚེ་སྒུག་འདུག་པ་ནས་བཟའ་བཏུང་ཕྲན་བུ་བྱས་ནས་བྱེ་ལ་བརྒལ་ཏེ་བན་རྩ་གྲུ་ཁ་ཞེས་པ་གཙང་ཆུ་དང་སྐྱིད་ཆུ་འདྲེས་པའི་ཆུ་ཆེན་འགྲམ་བྱེ་ཐང་དེར་ཉི་མྱུར་ཙམ་ལ་འབྱོར་ཞིང་།",
    "སྐུ་སྲུང་དམག་མི་བཅས་འདུག་པར་གོང་ས་མཆོག་སྟོན་འཁོར་དང་ལྷན་དུ་སྡོད་སྒྲིག་གུར་གྱི་ནང་བསྡད་ཅིང་།",
    "ཁོ་བོ་ཅག་ཀྱང་ལུང་པ་རྒྱུས་མེད་སྟབས་ཀྱིས་དོན་དང་བྱ་བ་མང་པོའི་འདུ་འཛིའི་བྲེལ་གཡེང་རང་ཤུགས་ཀྱིས་འགག་གཤིས་ལྷོད་དལ་ཁ་ཏོན་དགེ་སྦྱོར་སོགས་ཕྲན་བུ་འཕེལ་ཞིང་།",
    "ཁོང་རང་ཨང་རྒྱུན་དུ་ཁ་ཏོན་ལ་བརྩོན་ཞིང་།",
    "ཕྱི་དྲོ་གོང་ས་མཆོག་བཞུགས་སྒར་ནས་ཆིབས་ངས་པར་པ་ཐན་ཀོ་ཊི་ཉེ་མཚམས་སུ་ཕེབས་སྐབས་པ་ཀི་སི་ཐན་གྱིས་རྒྱ་གར་ལ་ཚུར་རྒོལ་བསྒྱུར་བསྐྱངས་པར་དམག་ཟིང་འགོ་ཚུགས་ཏེ་གནམ་ཐོག་ནས་དམག་མི་འཕང་པ་སོགས་ཉེན་ཆེ་བྱུང་འདུག་ཀྱང་།",
    "དམག་དུས་ཟིང་ཆས་བགྲོད་བདེ་མེད་པ་དང་།",
    "ཕྲུག་གུ་གང་འཚམས་ཤིག་བོད་ཀྱི་གོམས་གཤིས་ལྟ་ཅི་བོད་སྐད་ཀྱང་བརྗེད་དེ་སྒྲ་མེད་ལུས་ཀྱི་རྣམ་འགྱུར་ལ་བརྟེན་དགོས་པར་གྱུར་ཟིན་འདུག་པ་ཡིད་ཕམ་གྱི་གནས་སུ་ཆེ་ཡང་ཅི་བྱར་མ་མཛད་རྣམ་འཁྲུལ་སྣང་སྒྲ་མའི་ཟློས་གར།",
    "ཁོང་ནས་བོད་སྐད་ཀྱང་གང་ལེགས་ཤེས་ཀྱི་འདུག།",
    "ཡོད་པའི་ཡོད་གོ་ཆོད་འདུག་སྙམ་སྟེ་ཡིད་སྤྲོ་བརྟས།",
    "རོལ་དབྱངས་སོགས་ལེགས་པར་གདའ།",
    "གྲོང་ཁྱིམ་མང་པོ་འབྲས་དཀར་ཐང་ལ་བཀྲམས་པ་ལྟར་ཁྲ་ཕུང་ངེ་བལྟ་བས་མི་ངོམས་པ་འདུག་པ་རྣམས་བལྟས་རྗེས་དེ་ནུབ་མགྲོན་ཁང་ཞིག་ཏུ་བསྡད།",
    "ཟ་ཁང་སོགས་འདུག་པ་དེ་དག་ལ་བལྟ་ཞིབ་སོགས་ཨིང་ལན་གྱི་བྱེད་སྒོ་རྣམས་ཟིན་རྗེས།",
