    "ལུག་མགོ་ཆིག་བརྒྱ་ཉེར་ལྔ་བརྐོས་འདུག་པ་ཡིས།",
    "བྲིས་རིས་དང་ཡི་གེ་དངོས་ཀྱི་བར་ན་ད་དུང་ཁྱད་པར་ཆེ་བར་གདའ་བས།",
    "དེ་ཡང་དང་པོ་ཙ་ན་འདྲ་གཟུགས་ཀྱི་རྣམ་པ་མངོན་སུམ་དུ་དོད་པར་མ་ཟད།",
    "མི་དང་རང་བྱུང་ཁམས་ཀྱི་འབྲེལ་བ་དང་།",
    "བརྗོད་དོན་གང་ཞིག་དུས་ཀྱི་སྐབས་ནས་ཡུལ་གྱི་ཆ་ལ་སྤྲོ་བ་ནི།",
    "མིང་དག་དུས་ལྟར་སྒྲིག་པ་ངག་བརྗོད་དང་།",
    "བདེ་སྐྱོང་ཡིག་མཛོད་ཞེས་པར་ཡི་གེ་བསྡུས་ཡོད་པའི་ཁོངས་སུ་སྒྲ་གཟུགས་ཡི་གེ་མཆིས་པ་ཡིས་དེའི་ཟིན་འདུག་པ་ཡིས།",
    "དམག་ལ་སོགས་བྲིས་འདུག་པ་ལས་མི་རིགས་དེའི་འཚོ་བའི་གོམས་སྲོལ་དང་།",
    "དང་པོ་ཙ་ན་བཙུན་པ་ནེ་དེ་ནི་ཆུ་བོ་ཡུ་ཕ་ར་ཏེ་ས་དང་།",
    "ད་ལྟའང་རྒྱ་ཡིག་ཉིས་སྟོང་ལ་ཉེ་བ་ཙམ་ལྗར་པན་པ་རྣམས་ཀྱིས་སྤྱོད་མུས་སུ་གདའ་འོ།",
    "ཡི་གེའི་རྣམ་གྲངས་ཙམ་ཡོད་པའི་ནང་དུ་རྒྱུན་བཀོལ་གྱི་ཡིག་འབྲུ་ཙམ་འདུག་པ།",
    "སྐར་ཚོམ་གྱིས་འཕྲ་བཏབ་པ་བཞིན་ཀྲུང་ཧྭའི་ས་གཞི་ཡངས་པོ་འདིའི་ཕྱོགས་སོ་སོར་བཀྲམ་འདུག་ཅིང་།",
    "ཡི་གེའི་བྱུང་བ་དང་འཕེལ་རྒྱས་ཞེས་པ་རུ་འདི་ལྟར་བསྟན་འདུག་པ་སྟེ།",
    "པྲཧྨའི་ཡི་གེ་འདིར་བྲིས་འདུག་ནི་ཧྲན་མི་ཐུའི་སྐད་ཆ་བརྗོད་པའི་ལྷོ་ཕྱོགས་ནས་ཚོང་འགྲུལ་དང་འབྲེལ་ཏེ་རྒྱ་གར་གྱི་ནུབ་སྒོ་རུ་སླེབས་པ་ཡིན་ཞིང་།",
    "འདིར་སྔ་དར་དང་ཕྱི་དར་ཞེས་པ་ནི་ཕལ་ཆེར་བསྟན་པ་སྔ་དར་ཕྱི་དར་གྱི་དབྱེ་མཚམས་དང་དུས་གཅིག་ལ་ཁེལ་འདུག་པས།",
    "རྒྱ་གར་སྐད་ཀྱི་གཟུངས་སྔགས་སྒྱུར་བྱེད་ལ་མཁོ་བའི་སྔགས་ཡིག་དང་དེའི་བཀླག་ཐབས་དང་བཅས་པའི་བསྟན་བཅོས་ཆ་ཚང་བ་མཛད་འདུག་ཕྱིར།",
    "གཅིག་ནི་གསལ་བྱེད་ཀྱི་ཡི་གེ་དང་དབྱངས་ཀྱི་ཡི་གེ་གཉིས་སོ་སོར་ཕྱེ་འདུག་པ་དང་།",
    "ཅིག་ཤོས་ནི་རང་སྐད་དང་གཞན་སྐད་ཀྱི་སྐད་གདངས་ཐ་དད་དུ་ཕྱེ་འདུག་གོ།",
    "བོད་སྐད་སྤྱི་དང་སྒོས་སུ་ཡི་གེ་རིག་པའི་འཕེལ་རྒྱས་ལ་ནུས་པ་ཆེན་པོ་ཐོན་འདུག་གོ།",
    "རྒྱལ་ཁབ་ཕྱི་ནང་དང་རང་གཞན་ཀུན་ལ་བཞེད་ལུགས་མི་མཐུན་པར་སྣང་ཡང་།",
    "སྨྲ་སྒོ་མཚོན་ཆར་གདེང་འཇོག་ཀྱང་གནང་འདུག་གོ།",
    "ཡི་གེའི་སྦྱོར་བ་གྲུབ་ལུགས་སུ་གདའ་འོ།",
    "བོད་ལ་སྔར་མེད་པའི་རིག་གཞུང་གསར་དུ་སྐྲུན་པའི་མཐོ་རླབས་ཤིག་འཕྱུར་དང་འཕྱུར་མུས་སུ་གདའ་བ་དང་དུས་མཚུངས་སུ།",
    "དེ་དུས་ཙ་ན་གུཔྟའི་ཡི་གེ་དང་ཡེ་ཁྱད་མེད་ལྟ་བུ་ཡོད་ཚོད་འདུག་པར་བསྟན་ཏེ།",
    "ཙ་ནས་འའི་བར་གྱི་དཀྱུས་གཅིག་ཏུ་ཡོད་པའི་ཡི་གེ་བདུན་ག་གསར་དུ་བསྣན་ཏེ།",
    "ཞང་ཞུང་ཡི་གེའི་ངོས་ཟིན་སྔར་བས་ཇེ་གསར་དུ་གྱུར་ཟིན་དང་འགྱུར་བཞིན་གདའ་འོ།",
    "ད་ལྟར་ཞང་ཞུང་ཡི་གེ་ཞེས་པ་ཞིག་བྱུང་མྱོང་བའི་ཐད་རིག་པ་སྨྲ་བ་ཕལ་ཆེ་བ་ཞལ་མཐུན་པར་ཕྱོགས་བཞིན་གདའ་འོ།",
    "བོད་ཡིག་འདི་ནི་ཡི་གེ་གཞན་བས་ཆེས་ཆེར་བྲིན་པར་གདའ་འོ།",
    "ཕྱིས་སུ་བྲིས་རིས་ཀྱི་རྣམ་པའི་ཡི་གེ་གཞན་བྱུང་བའི་ཟམ་པ་ལྟ་བུར་གྱུར་འདུག་པས།",
    "རྣམ་ཆ་གསུམ་མམ་བཞི་གྲུབ་འདུག་པ་ལྟར།",
    "ཐ་གུའི་ཡི་གེ་འདིར་སྐད་ཆའི་ཆ་ཤས་གང་དང་འབྲེལ་ཞིང་ཅི་ཞིག་མཚོན་པ་བསྟན་དུ་མེད་པ་ཙམ་ལས་ཡི་གེ་དངོས་ལ་ཚང་དགོས་པའི་རྣམ་ཆ་དག་རུབ་ཀྱིས་གྲུབ་འདུག་པ།",
    "དོན་གང་ཞིག་མཚོན་པའི་ཁྱད་པར་ཤིན་ཏུ་གསལ་པོར་གདའ་བ།",
    "རྣམ་གྲངས་ཁོ་ནས་ཀྱང་ཡི་གེ་དངོས་ཀྱི་ཚད་ལ་ལོངས་པ་གསལ་བར་བྱས་འདུག་གོ།",
    "ཡི་གེ་འབྲི་བྱེད་ཀྱང་རང་ས་ནས་ཐོན་པའི་འཇིམ་པ་དང་འདམ་བུ།",
    "ཤོག་ངོས་གངས་ཏི་སེ་བོན་གཞུང་རིག་མཛོད་དཔེ་ཚོགས་དེབ་གཉིས་པར་བསྡུས་འདུག་མི་རིགས་དཔེ་སྐྲུན་ཁང་།",
    "དེ་ནི་གཙོ་བོ་མི་དང་རང་བྱུང་ཁམས་ཀྱི་འབྲེལ་བ་ཡིན་ཕྱིར།",
    "བོད་དང་བཅས་པའི་གདོད་མའི་མི་རྣམས་ཀྱི་སྤྱི་ལུགས་སུ་གྲུབ་འདུག་ཕྱིར།",
    "བུ་ཁོ་རང་གཉན་བུ་ཧྲིལ་པོ་ཡིན།",
    "བོད་ཀྱི་མཐའ་འཁོར་གྱི་རྒྱལ་མཚེས་མི་རིགས་དག་ལའང་དངོས་བརྒྱུད་གང་རུང་ནས་ཤན་ཤུགས་ཆེ་ཆུང་ཅི་རིགས་ཐེབས་འདུག་པ་གདོན་མི་ཟ་ཡང་།",
    "འཇང་པ་རྣམས་ཀྱིས་ཀྱང་རང་ཉིད་ཀྱི་སྟོན་པ་ནི་གཤེན་རབ་མི་བོ་ཡིན་པར་འདོད་པ་བོན་བསྟན་དང་ཀུན་ནས་མཐུན་པས།",
    "ཤེས་བྱའི་གསང་རྒྱ་འགྲོལ་བྱེད་ཀྱི་ལྡེ་མིག་ལྟ་བུར་གྲུབ་གདའ་འོ།",
    "ཤོག་ངོས་གྱི་རྒྱུ་༡༡ དགོས་པར་གདའ་འོ།",
    "བོད་ཁམས་གླིང་དགུ་ཞེས་པ་ནས་བྱུང་འདུག་པ་ནི།",
    "འགྲོ་འདུག་ཟ་ཉལ།",
    "ཡི་གེའི་སྦྱོར་བ་རང་ངོས་སུ་དུས་ཀྱི་ཁྱད་པར་སྟོན་ཐབས་བྲལ་བ་ད་ལྟའི་རྒྱ་ཡིག་སོགས་ལའང་དེ་བཞིན་འདུག་པས་གསལ་བར་ཤེས་པ་དང་།",
    "མིང་སྦྱོར་རམ་ཚིག་སྦྱོར་གྱི་ཡི་གེ་གང་ལའང་རང་ངོས་ན་བསྟན་བྱ་གསལ་པོ་མེད་པའི་ཚིག་ཕྲད་ཀྱི་སྦྱོར་བ་བཟོ་ཐབས་མེད་པས།",
    "ཞང་ཞུང་ཡི་གེའི་དཔེ་བཤུས་གང་དུའང་བར་ཚེག་བྲིས་པ་མི་གདའ་བས།",
