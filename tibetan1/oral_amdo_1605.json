    "དཔེར་ན་ས་ལ་སོགས་པའི་རང་གི་བདག་ཉིད་བཞིན་ནོ་ཞེས་བྱ་བས་དོན་དམ་པར་གཟུགས་རང་གི་རྒྱུ་དག་ལས་གཞན་མ་ཡིན་པར་བསྟན་པ་དེ་བཞིན་དུ་འདིར་ཡང་དོན་དམ་པར་ཚོར་བ་ལ་སོགས་པ་དག་རང་གི་རྒྱུ་དག་ལས་གཞན་མ་ཡིན་པར་བརྗོད་པར་བྱའོ།",
    "དེ་དག་གི་བྱེ་བྲག་དག་དགག་པ་བརྗོད་པར་བཞེད་པས་ཉེ་བར་བཞག་སྟེ།",
    "བསྒྲུབ་པར་བྱ་བ་དང་མཚུངས་པར་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་ཚིག་གི་ལྷག་མའོ།",
    "རྣམ་པར་ཤེས་པ་དག་གི་ངོ་བོ་ཉིད་དང་བྲལ་བ་གང་ཡིན་པ་དེ་ནི་། ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ།",
    "རྣམ་པར་ཤེས་པ་དག་གི་ངོ་བོ་ཉིད་མེད་པ་གང་ཡིན་པ་དེ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ་ཞེས་བྱ་བ་དང་།",
    "རེག་བྱ་དང་།",
    "རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་དག་གི་མཚན་ཉིད་སླ་བ་དང་།",
    "དོན་དམ་པར་ས་ལ་སོགས་པ་ཁམས་རྣམས་ཡོད་པ་ཁོ་ན་ཡིན་ཏེ་དེ་དག་གི་མཚན་ཉིད་ཡོད་པའི་ཕྱིར་རོ།",
    "ས་ལ་སོགས་པ་དག་ལ་ནི་སྲ་བ་ཉིད་ལ་སོགས་པའི་མཚན་ཉིད་དག་ཡོད་པས་དེ་ལྟར་དེ་དག་གི་མཚན་ཉིད་ཡོད་པའི་ཕྱིར་ས་ལ་སོགས་པ་ཁམས་རྣམས་ཡོད་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "དེ་དག་གི་དེ་ལྟར་ཁས་བླངས་པ་ཉིད་ལ་ཡང་།",
    "དོན་མ་གྲུབ་པའི་ཕྱིར་དེས་ན་གང་གིས་ཅི་ཞིག་སྒྲུབ་པར་འགྱུར།",
    "རི་བོང་གི་རྭ་ལ་སོགས་པ་དག་ཡིན་ནོ།",
    "སྐྱེ་བ་མེད་པའི་ཕྱིར་དཔེར་ན་རི་བོང་གི་རྭ་བཞིན་ནོ།",
    "འདིར་ཁ་ཅིག་ན་རེ་གལ་ཏེ་དོན་འདི་བསྟན་བཅོས་བྱེད་པའི་བསམ་པ་ཡིན་པར་གྱུར་ན་དེ་ལྟ་ན་བསྟན་བཅོས་བྱེད་པས་ནམ་མཁའི་མཚན་ཉིད་ལས་གཞན་དུ་གྱུར་པའི་ནམ་མཁའ་ཅུང་ཟད་ཡོད་པ་མ་ཡིན་ཞེས་སྨྲས་པ་ཁོ་ནར་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "བྱེ་བྲག་པ་དག་གི་མཚན་ཉིད་ཀྱི་གཞི་དང་།",
    "མཚན་ཉིད་དག་གཞན་ཉིད་དུ་དམ་བཅའ་བས་དེ་དག་གི་གཞན་ཉིད་ཡིན་ན་ལན་འགའ་སྔ་ཕྱིར་ཡང་འགྱུར་ཏེ།",
    "མཚན་ཉིད་མེད་པར་ཐལ་བར་འགྱུར།",
    "མཚན་ཉིད་མེད་པར་ཐལ་བར་འགྱུར།",
    "ཕ་རོལ་པོའི་ནི་རང་གི་རྗེས་སུ་དཔག་པ་ལ་གནོད་དོ།",
    "དོན་དམ་པ་པའི་དངོས་པོ་གཞན་གྱི་ཕྱོགས་དང་བདག་ཅག་གི་ཕྱོགས་གང་ན་ཡང་འགྲུབ་པ་མེད་དོ།",
    "གང་གི་ཚེ་ཁོ་བོ་ཅག་གི་ཕྱོགས་ལ།",
    "དཔེ་མེད་པའི་ཕྱིར་ཁྱོད་ཀྱི་འདོད་པའི་དོན་མ་གྲུབ་བོ།",
    "ལྟོས་པའི་ངེས་པ་ཡང་མེ་དང་བུད་ཤིང་རྟག་པའི་རབ་ཏུ་བྱེད་པ་ལས་འོག་ནས་འགོག་པར་འགྱུར་བའི་ཕྱིར་དང་།",
    "དེ་ལྟར་གང་གི་ཕྱིར་མཚན་ཉིད་མེད་པའི་དངོས་པོ་འགའ་ཡང་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་མཚན་ཉིད་མེད་པའི་དངོས་པོ་མེད་ན་གཞི་མེད་པ་ལ་མཚན་ཉིད་འཇུག་པར་མི་འཐད་དོ།",
    "མཚན་ཉིད་ཀྱི་གཞིའི་སྐྱེ་མཆེད་དེ་དག་གི་དོན་དམ་པ་བའི་ཡོད་པ་ཉིད་ནི་དོན་དམ་པར་བརྩལ་པས་དེའི་ཕྱིར་མཚན་ཉིད་ཀྱི་གཞི་མི་འཐད་ན་མཚན་ཉིད་ཀྱང་མི་སྲིད་པས་དེ་དགག་པའི་ཕྱིར་ནི་འབད་པ་མི་རྩོམ་མོ།",
    "ཐ་སྙད་དང་རྗེས་སུ་མཐུན་པ་ནི་ཡིན་ནོ།",
    "དཔེ་ཡང་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་དགོངས་སོ་། གང་གི་ཕྱིར་དེ་ལྟར་ཤེས་རབ་ཀྱིས་ཉེ་བར་བརྟགས་ན་མཚན་ཉིད་ཀྱི་གཞི་དང་།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བདག་གིས་སྨྲས་པ།",
    "དེས་ན་གང་གི་ཕྱིར་ཁོ་བོ་ཅག་གི་ཕྱོགས་ལ།",
    "ཡུལ་དེ་ལ་འདུན་པའི་འདོད་། ཆགས་སྤོང་བའི་ཕྱིར་ཞེས་བྱ་བ་དེས་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་སེལ་བར་བྱེད་པ་ཡིན་མོད་ཀྱི།",
    "དངོས་མེད་གང་གི་ཡིན་པར་འགྱུར།",
    "ཐོགས་པ་དང་བཅས་པའི་གཟུགས་ཞེས་བྱ་བའི་དངོས་པོ་ཡོད་པ་མ་ཡིན་ན་ཁྱེད་ཀྱིས་ནམ་མཁའ་ཞེས་བྱ་བར་བརྟགས་པ་གང་ཡིན་པའི་དངོས་པོ་མེད་པ་དེ་གང་གི་ཡིན་པར་འགྱུར་ཏེ།",
    "ཁྱོད་ཀྱིས།",
    "འདི་ལྟར་ཁྱོད་ཀྱིས་ལན་ཅིག་མ་ཡིན་པར་ཕུང་པོ་དང་ཁམས་དང་།",
    "གཞན་དག་གིས་སྨྲས་པ།",
    "གང་གིས་དངོས་དང་དངོས་མེད་ཤེས།",
    "དེ་ནི་ཡོད་པ་མ་ཡིན་པ་ཉིད་དོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཏོ།",
    "གལ་ཏེ་རྣམ་གྲངས་ཀྱི་ཚུལ་སྨྲ་བ་དག་གིས་བརྟགས་པའི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དང་།",
    "གང་གི་ཕྱིར་དེ་ལྟར་དཔྱད་ན།",
    "གསེར་གྱི་འབྱུང་ཁུངས་བཞིན་དུ་ནམ་མཁའ་ལ་སོགས་པ་དག་ཀྱང་སྡུག་བསྔལ་དང་ཡིད་མི་བདེ་བ་ལ་སོགས་པ་དག་གི་འབྱུང་ཁུངས་སུ་གྱུར་པ་དག་ཡིན་ནོ།",
    "ཡང་ན་ཁམས་ཞེས་བྱ་བའི་དོན་ནི་བྱེད་པ་མེད་པར་རང་གི་མཚན་ཉིད་འཛིན་པའི་དོན་ཏོ།",
    "ཡང་ན་ཁ་ཅིག་ན་རེ།",
    "ཁྱོད་ཀྱིས་དོན་དམ་པར་དངོས་པོ་ཐམས་ཅད་ལ་སྐུར་བ་བཏབ་པའི་ཕྱིར་ལོག་པའི་ལྟ་བ་དངོས་པོ་ཐམས་ཅད་ལ་སྐུར་བ་འདེབས་པའི་ཚུལ་ཅན་རྗེས་སུ་བརྗོད་པས།",
    "རྩིག་པ་ལ་བྲིས་པའི་རི་མོ་བཞིན་དུ་སྲོག་ཆགས་རྣམས་ཀྱི་ན་ཚོད་དང་བོང་ཚོད་དང་།",
    "མེད་པའི་ཕྱིར་དཔེར་ན་རི་བོང་གི་རྭ་རྣོན་པོར་བྱ་བའི་ཕྱིར་འབད་པ་བཞིན་པས།",
    "མེད་པ་ཉིད་དུ་ལྟ་བ་དེ་དག་གིས་ནི་དོན་དམ་པའི་བདེན་པ་ཤིན་ཏུ་ཆེ་ཕྲ་བ་འཕགས་པའི་ཤེས་རབ་ཀྱི་སྤྱན་གྱི་སྤྱོད་ཡུལ་བལྟ་བར་བྱ་བ་ཞི་ཞིང་ཞི་བ་མི་མཐོང་ངོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
