    "དགེ་རྒྱས་མི་ལོག་རུ་པས་རྐུན་འཇལ་སོགས་སྤྲོད་སྲོལ་མེད་འདུག་ཀྱང་།",
    "དེ་དག་ཕལ་ཆེར་སྐུ་ཐོག་དུས་མཉམ་དུ་བྱོན་པ་ཤ་སྟག་མང་དུ་མཆིས་པའི་ཕྱིར་ན།",
    "གདུལ་བྱ་ཞབས་ཏོག་རྒྱས་པ་ཙམ་བྱུང་ཡོད་འདུག་སྟེ་བྱང་ཕྱོགས་ནོར་འཛིན་གྱི་གཞིར་སྤྱོད་པའི་སྐྱེ་རྒུ་མཐའ་དག་ལ་གནས་སྐབས་སུ་ཟ་པ་ཕན་པ་དང་།",
    "བླ་བྲང་རང་ནས་ཀྱང་དགོངས་རྫོགས་རྣམ་དཀར་རྒྱ་ཆེ་མཛད་གྲུབ།",
    "ལོ་སྔ་ཕྱིར་ལྷ་ལྡན་ཕྱོགས་སུ་རྒྱལ་བའི་མཇལ་ཕྱག་དང་ཇོ་ཤཱཀ་མཆོད་ཆ་པ་སོགས་ལ་སྐྱབས་མགོན་ཉིད་ཕེབས་པའི་དགོངས་གཏད་ཆེ་བ་ཡོད་འདུག་ཀྱང་།",
    "ཁོང་རང་གཉིས་དབྱུག་པ་ཐོགས་ཏེ་འཐབ་པར་གཡུལ་བཤམས་ཏེ་འཐབ་ནས་རྒྱལ་པོས་ལྷའི་མཚོན་གྱི་ཆར་ཕབ་སྟེ་གཤིན་རྗེའི་འཁོར་རྣམས་ཕམ་པར་བྱས།",
    "པྲ་བ་ཙ་ནཾ་བྱུགྲུ་དྲོ་ཎ་ཨཱཛྙཱ་པནྟཱ་ན།",
    "རང་རང་གཞུང་དང་གྲུབ་པའི་མཐའ་ཡིས་ཀྱང་།",
    "རང་བྱུང་རང་ཞི་ཆུ་ཡི་དབའ་རླབས་འདྲ།",
    "ནམ་མཁའ་འི་རང་བཞིན་ལ་ནི་འདི་འདྲ་འདུག་ཅེས་བརྗོད་དུ་མེད།",
    "ཐམས་ཅད་རང་ལས་བྱུང་ཞིང་རང་ཞི་བས་ཆུ་ཡི་པ་ཏྲ་དང་འདྲའོ།",
    "རང་རང་ཐུགས་རྗེ་གཞན་གྲོལ་བར་བྱ་བའི་ཕྱིར་བསྒྲལ་བའི་སྦྱོར་བ་བརྩམ་པར་བྱའོ།",
    "རྩ་ལམ་དུ་འདྲེན་དང་རང་གནས་སུ་འཛིན་དང་འཁྱིལ་བར་བྱ་བ་སྟེ།",
    "རང་རང་རོལ་པ་བདེ་བའི་མཛད་པས་ཉམས་དང་ལྡན།",
    "གང་ན་འདུག་ཀྱང་པདྨ་འདམ་ལ་གནས་ཀྱང་འདམ་གྱི་ཉེས་པ་དང་བྲལ།",
    "གཉེན་རྒྱལ་པོ་ལྟར་པོས་ཆེད་དུ་བཅོས་པ་དང་རང་བྱུང་བས་དགག་པ་ཡང་མེད་པས་། དེ་གསུམ་གྱི་རང་ལུགས་བཅོས་སུ་མེད་ཡེ་ཤེས་ཆེན་པོར་དང་གསལ།",
    "དེ་ཉིད་ཉམས་སུ་ལེན་ཙ་ན།",
    "བེམ་རིག་བྲལ་བའི་དུས་ཙ་ན།",
    "སྟན་ནང་ཚངས་ཅན་བདེ་བ་ལ་འདུག་སྟེ།",
    "བཟང་ངན་སྒྱུ་མ་ཅིར་སྣང་རང་གྲོལ་ལྟོས།",
    "ཅིར་སྣང་གཞི་མེད་རང་བྱུང་རང་ལ་ལྟོས།",
    "འཕྱོ་སེམས་བཙལ་ཏེ་མ་རྙེད་ཙ་ན་གང་དགར་བཞག་ན་སྤྲེའུ་དེད་ལ་གསོད།",
    "དང་པོ་ནི་འཇམ་པའི་སྟན་ལ་འདུག་ལ།",
    "དཀྱིལ་འཁོར་ཁ་དོག་ཅིར་འདུག་དྲི།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་སྭཱཧཱ།",
    "མཧཱ་བ་ལེ་ཧཱུཾ་ཧཱུྃ་ཕཊ་ཨཾ་ཧི་ལི་ཧི་ལི་བེ་རོ་ཙ་ན།",
    "བཛྲ་ཝརྣ་ནཱི་ཡེ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ༀབཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་སྭཱཧཱ།",
    "རས་བྲིས་དང་ལུགས་མ་ལ་སོགས་པའི་རྟེན་བཀྲམ་ནས་སྟན་བདེ་བ་ལ་འདུག་པར་བྱའོ།",
    "བློ་གྲོས་ཆེན་པོས་བདེ་ལ་འདུག།",
    "བདེ་བའི་སྟན་ལ་འདུག་བྱས་ནས།",
    "སྟན་བདེ་བ་ལ་འདུག་སྐྱབས་སུ་འགྲོ་ཞིང་།",
    "རྫོགས་རིམ་དང་ཟུང་འཇུག་བར་རྩིབས་སུ་མ་ལུས་བསྐྱེད་རིམ་བསྒོམ་བརྡོ་ཙ་ན་ལམ་བཞི་བགྲོད་བརྡོ་བས།",
    "བསྐྱེད་རིམ་བསྒོམ་བརྡོ་ཙ་ན་སྐུ་བཞི་ཐོབ་བརྡོ་བ་ཅིག་བྱུང་བས།",
    "རྒྱུན་དུའམ་གནས་སྐབས་སུ་བྱེད་པ་གང་ཡིན་ཀྱང་རང་ལྷར་བསྒོམས་པའི་ཐུགས་ཀ་ནས་འོད་འཕྲོས་པས།",
    "འགྲོ་འདུག་སྤྱོད་ལམ་གྱི་རྣལ་འབྱོར་དང་།",
    "བཞི་པ་འགྲོ་འདུག་བསྐོར་བའི་རྣལ་འབྱོར་ནི།",
    "རང་བཞིན་སྐྱེ་བ་མེད་པ་ཅིར་ཡང་མ་གྲུབ་པར་འདུག་པས་བསྐྱེད་པའི་རིམ་པའི་སྐབས་ཉིད་ན་རྫོགས་པའི་རིམ་པ་ཡང་ཚང་།",
    "ཐ་མར་གར་འགགས་བལྟས་པས་གང་ཡང་མི་འདུག་པས་དེ་ལྟར་ལམ་དུ་སླང་བའོ།",
    "བྱེད་ཀྱང་རང་བཞིན་མེད་དོ།",
    "ངོ་བོ་རྟོག་མེད་དུ་རྟོགས་པ་དང་རང་གཞན་བདེ་སྟོང་དུ་རྟོགས་པར་བྱས་ཏེ་བསྲུང་བའོ།",
    "འཇུག་དུས་སུ་ཡབ་ཡུམ་ཕྲིལ་གྱིས་འཁྲིལ་བར་བསམ།",
    "འགྲོ་འདུག་ལས་ཁུར།",
    "དེ་ཙ་ན་གོས་ཀྱི་འདུན་པ་དང་བྲལ།",
    "ཕར་ལྟས་པས་ལྷ་ཚོགས་རྣམས་སྣང་ཙ་ན་སྟོང་སྟོང་ཙ་ན་སྣང་།",
    "སྙོམས་འཇུག་དུས་ན་སྤྱི་བོ་ན་གནས་སོ།",
    "རང་དལ་གྱི་ཤར་དུ་ཁ་ནུབ་ཏུ་བལྟས་ཏེ་འདུག་སེམས་བསྐྱེད་རང་རྗེ་བཙུན་མར་བསྒོམ།",
    "ཉལ་ཁར་སྣང་སྲིད་དང་རང་ལུས་རྨི་ལམ་ཡིན་སྙམ་དུ་དྲན་འདུན་བར་མ་ཆད་པར་བྱ་བ་ལ་ནན་ཏན་བསྐྱེད་པ་སྟེ་འཚམས་སྦྱོར་མི་འགྱུར་བའི་། གཟེར་རོ།",
    "ཉིན་ནུབ་བསྲེ་བ་དང་རང་སྣང་སྒྱུ་མར་ཐག་བཅད་ལུས་ལྷ་སྐུར་སེམས་རང་བཞིན་མེད་པར་ཐག་བཅད་པས་མངོན་དུ་རྒྱུ་འགོག་གོ།",
    "དེ་ལ་གཉིད་ནི་ལོག་དུས་སུ།",
    "བུག་པ་དབུས་སྣའི་དཀྱིལ་དུ་སུ་བྱུང་ན་ཟླ་བ་གཅིག་དུས་ཐེབས་ན་འཆི་ངེས་པར་ཐག་ཆོད་སྟེ།",
    "སྔ་གྲོ་མཐོན་པོའི་གནས་སུ་ནམ་མཁའ་ཡངས་པ་མཐོང་སར་སྤྱོད་ལམ་ལེགས་པར་འདུག་ལ།",
    "རྩིབས་སྟོང་ལྡན་པའི་རལ་གྲིའི་འཁོང་རང་།",
    "ང་རང་ཆེས་དགའ་བའི་དུས་ཚིགས་ནི་དབྱར་དུས་དང་དཔྱིད་དུས་ཡིན།",
    "འོན་ཀྱང་ང་རང་ཉིན་མཚན་ཀུན་ཏུ་ཕྱི་ནས་བསྡད་དེ་མཁའ་དབུགས་གསར་བ་རྔུབ་པར་སྤྲོ།",
    "ང་རང་སྤང་ཐང་དུ་ཡོད་དུས།",
    "ངས་སྤང་ཐང་ལ་སྐོར་བ་བྱས་ནས་དལ་གྱིས་རྒྱུག་དུས།",
    "ཉིན་ཞིག་ལ་བདག་པོས་ང་ལ་རྨེད་བསྐོན་པའི་སྐབས་སུ་ང་རང་ཁོང་ཁྲོ་ལངས་བྱུང་།",
    "ང་རང་རྟ་བཟང་བོ་ཞིག་ཏུ་བཏུལ་ཆེད།",
    "དེ་ནི་ངས་ཐོག་དང་བོར་མེ་འཁོར་མཐོང་བ་ཡིན་པ་ད་དུང་ཡང་ཡིད་ལ་ཝ་ལེར་འདུག་དེའི་དུང་སྒྲ་དང་ཕྱིའི་རྣམ་པས་ང་རང་ཧང་སང་བར་བྱས།",
    "ཁྱིམ་དེར་ཐོན་མ་ཐག་ང་རང་རྟ་རའི་ནང་དུ་ཁྲིད་ཅིང་བལྟས་ཚོད་ཀྱིས་ཆ་རྐྱེན་ཅུང་བཟང་བའི་རྟ་ར་ཞིག་ཏུ་བཏང་།",
    "ད་དུང་ཡུག་པོ་ཁུག་མ་གང་གཟན་ཆས་སུ་བཞག་འདུག་ངའི་རྟ་ར་དེར་ཁོ་ཚོས་ལྷུག་མ་ཤིང་ར་ཟེར།",
    "འདི་དངོས་གནས་བཙོག་པོ་འདུག་དུས་རབས་འདི་དངོས་གནས་འཇིགས་སུ་རུང་བ་ལ།",
    "ཨ་ཙི།",
    "ཉིན་གཉིས་པའི་ཞོགས་པར་ཁོ་རྟ་ར་དུ་ཡོང་སྟེ་ང་རང་ར་སྐོར་ནང་དུ་ཁྲིད།",
    "མི་དྲག་ཚུར་ཡོང་ནས་ལྗོན་ལ་ང་རང་ཁྲིད་ནས་གཞིས་ཀར་རྒྱུས་ལོན་བྱེད་པར་མངགས།",
    "བལྟས་ཚོད་ཀྱིས་ཁོ་རང་ཧ་ཅང་ཡིད་ཚིམ་ཡོད་པ་འདྲ།",
    "ཡག་པོ་འདུག་ད་ལྟ་ང་རང་དངོས་སུ་བཞོན་ནས་ཕྱི་རུ་འགྲོ་འདོད།",
    "ངས་ཁོ་རང་ཐེངས་འགར་ཐང་ལ་གཡུག་བསམ།",
    "བདག་པོས་ང་ཕྱིར་ཁྲིད་དུས་སམ་སན་མི་སོས་སྒོ་ཁ་ན་ལངས་འདུག་ང་ཡང་བསྐྱར་འབྲོ་རྩིས་བྱས།",
    "ང་རང་ཆེས་དགའ་བ་ནི་མི་ཚང་མ་དང་ལྷན་དུ་ཕྱི་ལ་འགྲོ་བ་ཡིན།",
    "འུ་གཉིས་ལ་ཁ་བརྡ་ཞིག་འདུག་ཟེར།",
    "དོན་དག་ཅི་བྱུང་བར་ཕྱོགས་བཞིར་བལྟས་ཙ་ན།",
    "རྟ་རའི་ནང་དུ་དུ་བའི་ཁེངས་འདུག་པ་ཚོར།",
    "གཟའ་འཁོར་གཉིས་པར་སླེབས་ཙ་ན།",
    "ཁོས་ད་དུང་ལྭ་བ་གོན་ཚར་མེད་ལ་མགོའི་སྐྲ་ཡང་གཟེངས་འདུག་ང་རང་ངའི་རྟ་ལ་ཞོན་མི་རུང་།",
    "ལྗོའོ་ཡིས་ང་རང་རྟ་རར་ཁྲིད།",
    "ངའི་ལུས་ཡོངས་རྫོགས་རྔུལ་ཆུས་བརླན་པར་བྱས་འདུག་ལ་རྐང་ལག་ཚང་མ་སྦུད་ནས་ཤེད་ཤུགས་མེད་པར་གྱུར་འདུགརྟ་ནག་ཅང་ཤེས།",
    "ངའི་ལུས་ལ་ཚ་བ་རྒྱས་འདུག་པས།",
    "ཁོས་ང་ལ་མལ་ཆས་འགེབ་མི་རུང་བསམ་ནས་ཡུད་ཙམ་གྱིས་ང་རང་གྲང་འདར་བརྒྱབ།",
    "དེ་ནས་ང་རང་ཐང་ལ་ཉལ་ནས་ངལ་གསོ་ཐབས་བྱས།",
    "འཁོར་ལོ་འདམ་དུ་ཟུག་ནས་གོམ་པ་གང་ཡང་སྤོ་མ་ཐུབ་ཀྱིན་མི་འདུག་འོན་ཀྱང་དེ་ལས་མཚར་བ་ནི།",
    "ཁོས་དལ་ལྷོད་ལྷོད་ཀྱིས་ཆུང་མ་འདུག་སྟེགས་སྟེང་དུ་བཞག་སྟེ་རང་ཉིད་ཤིང་རྟའི་གཞོགས་སུ་བསྡད།",
    "ང་རང་དེ་ལ་སུན་སྣང་དང་སྐྱོ་སྣང་མཉམ་དུ་སྐྱེས།",
    "རང་ཉིད་ཀྱི་བསམ་ཕྱོགས་དེ་རྩ་བ་ནས་ནོར་འདུག་པ་ཤེས།",
    "སྐྲག་ནས་ལུས་ཀྱི་སྤུ་ཡང་གཟེངས་འདུགརྟ་པས་སྔོན་ལ་ངའི་སྲབ་མདའ་དམ་པོར་འཐེན་ཞིང་སྲབ་ཀྱིས་ཁ་ཤ་གཤགས་ནས་ཁྲག་དྲི་བྲོ།",
    "བུ་ཕྲུག་གཉིས་དང་བཅས་བཞི་བོ་ང་དང་ལྗེན་ལྗིར་གཉིས་འདི་རུ་མ་ཐོན་གོང་ཨེར་ཤལ་གཞིས་ཀ་ནས་ཕྱི་རུ་ཕུད་ཟིན་པའི་གནས་ཚུལ་དག་དུས་རྒྱུན་ང་དང་མཉམ་དུ་ཤིང་རྟ་འདྲུད་པའི་རྟ་ཕོས་ང་ལ་བཤད།",
    "རཱུའུ་བྷིན་ཤི་འདུག་ཅེས་སྐད་བརྒྱབ་བྱུང་།",
    "ང་རང་ངེས་པར་དུ་མེ་འཁོར་ལ་བསྡད་ནས་འགྲོ་དགོས།",
    "ས་ཆ་ལ་ལར་རྡོ་བཏིང་ནས་ཅུང་འགོར་འདུག་འོན་ཀྱང་ས་ཆ་ལ་ལར་དེ་འདྲའི་བརྟན་པོ་ཆགས་མེད།",
    "མི་འདི་སྔར་བཞིན་བགད་ནས་འདུག་རྡེའུ་ཧ་ཅང་རྣོན་པོ་ཡིན་པས་གོམ་གང་སྤོས་ཀྱང་རྡེའུས་ཇེ་རྡེབ་ཡིན་ལ་རྨིག་པ་གཤག་སྲིད།",
    "རྟ་ལ་ཁོ་ཚོས་ཅི་ལྟར་བྱས་ཀྱང་ཆོག་སྙམ་བཞིན་གདའ།",
    "གཤིས་རྒྱུད་ཀྱང་ཧ་ཅང་འཇམ་ལ་མིའི་ཁ་ལ་ཉན་པ་ཞིག་གདའ།",
    "ཁོ་ནམ་རྒྱུན་མགྲོན་ཁང་ནས་ཡུན་རིང་དུ་འདུག་ངེས།",
    "དཔུང་བ་སྐྱི་བཤུས་བཏོད་འདུག་ངས་ད་དུང་རྩིབ་རུས་འགའ་བཅག་ཡོད་པར་སྙམ།",
    "འདིས་ང་རང་དངངས་སྐྲག་སྐྱེས་སུ་འཇུག་ངས་བསམ་པར་གལ་ཏེ་ཁོས་ང་ལ་མདུན་ཕྱོགས་ཀྱི་དངོས་པོས་གནོད་མི་སྐྱེལ་བ་རིག་ཏུ་བཅུག་ཚེ།",
    "ང་རང་ཉིད་ཆ་རྒྱུས་ཡོད་པའི་དངོས་པོ་ལ་གཏན་ནས་དངངས་སྐྲག་སྐྱེས་མ་མྱོང་།",
    "གོང་མདུད་བསྣོགས་ནས་འདུག་བདག་པོས་ཁོ་དང་ཁ་བརྡ་བྱེད་པའི་སྐབས་སུ།",
    "གྲོ་སོག་ལ་དྲི་ངན་འཐུལ་འདུགམཁའ་དབུགས་བཙོག་པོ་དེས་ངའི་མིག་སྐྲངས་ཤིང་ན་ཟུག་ཆེ་བ་དང་ཡི་ག་ཡང་ཆུང་དུ་ཕྱིན།",
    "ང་བཞོན་ནས་ཕྱི་རུ་འགྲོ་ཁོམ་མེད་ཚེ་ང་བསྟུད་མར་རྟ་ར་ནས་ཉིན་འགའ་ལ་ལངས་ནས་འདུག་དགོས།",
    "ཁོ་རྟ་གཡུང་མ་ཞིག་འདུག་གམ།",
    "ཁོ་ལ་རུ་དཔོན་ཞེས་འབོད་ཀྱང་ད་ནི་ལོ་ལོན་འདུག་འོན་ཀྱང་ཁོ་ཆུང་དུས་ཁྱད་དུ་འཕགས་པ་ཞིག་ཡིན་ངེས།",
    "ཁོས་ད་ལྟ་མགོ་བོ་དགྱེ་ཞིང་སྐེ་བསྲིངས་བའི་རྣམ་པ་སྔར་བཞིན་ཧ་ཅང་ང་རྒྱལ་གྱིས་ཁེངས་འདུག་ཁོ་སྐྱེས་ཁུངས་མཐོ་ལ་བྱ་སྤྱོད་ཚད་ལྡན་ཡིན།",
    "ཁོས་ང་རང་ཁོ་ཚོའི་ཆེས་ཡིད་རྟོན་རུང་བའི་གྲོགས་པོར་གྱུར་ན་བསམ་ཡོད།",
    "བལྟས་ཚོད་ཀྱིས་འཛུམ་མདངས་ཀྱིས་ཁེངས་འདུག་ཁོ་ཚུར་ཡོང་དུས་ཚང་མས་ཁོ་ལ་ལམ་ཕྱེས།",
    "བཀའ་ཕབ་མ་ཐག་ཏུ་འདུག་དགོས།",
    "མི་ཚང་མ་འགུལ་ཙམ་ཡང་མི་བྱེད་པར་ལངས་འདུག་ཚོར་ཤེས་ཇེ་རྣོར་གཏོང་ཆེད།",
    "ང་རང་ང་རྒྱལ་དང་སྤྲོ་ཉམས་ཀྱིས་ཡར་ལ་དགྱེས་ནས་ཁུ་སུམ་མེར་ལངས་ནས་བསྡད།",
