    "དང་པོ་ལའང་རང་ལས་སྐྱེ་བ་དོན་མེད་པ་དང་།",
    "འགྲོ་འོང་རང་ལྡོག་ནས་དངོས་སུ་དགག་པའི་ཕྱིར་རབ་ཏུ་བྱེད་པ་འདི་གསུངས་པ་ཡིན་ནོ།",
    "གནས་པ་པོ་མིན་འགྲོ་བ་མིན།",
    "གང་སྤྱོད་དེ་ཡང་རང་བཞིན་སྟོང་པ་སྟེ།",
    "དེས་ན་དེའི་ཁོངས་སུ་འདུས་པས་སྐྱེ་མཆེད་རྣམས་ཀྱང་རང་བཞིན་དུ་ཡོད་དོ་སྙམ་པ་ལ།",
    "གནས་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "འཇིག་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "རྟགས་མ་གྲུབ་པ་མ་ཡིན་ཏེ་སྣང་མུན་ཡུལ་གཅིག་ཏུ་འགལ་བས་མར་མེ་དང་ནི་གཞན་ཡུལ་གང་དག་ན་མར་མེ་དེ་འདུག་པ་ན་བསལ་བྱའི་མུན་པ་མེད་པའི་ཕྱིར་རོ།",
    "མུན་པ་ལྟར་མར་མེ་ལ་ཡང་རང་གཞན་སྣང་བ་མེད་དོ་ཞེས་པའོ།",
    "ཁ་ཅིག་དུས་གསུམ་རྗ་ས་སུ་ཡོད་པས་སྐྱེ་བཞིན་པའི་བུམ་པའང་མ་འོངས་པ་ན་ཡོད་ལ་དེའི་ཕྱིར་དེ་ལ་སྐྱེ་བའི་བྱ་བ་བརྟན་པའི་སྒོ་ནས་ད་ལྟ་བར་སྐྱེ་བར་འགྱུར་རོ་སྙམ་ན།",
    "གཉིས་པ་ལྟར་ཡང་མི་རུང་སྟེ་གང་ཞིག་དུས་གཉིས་པར་འགག་བཞིན་པ་མ་ཡིན་པ་དེ་ནི།",
    "ཐུག་མེད་དུ་འགྱུར་བ་དང་རང་ལ་བྱ་བྱེད་འགལ་བའི་ཕྱིར།",
    "རང་ཉིད་ཚོགས་དྲུག་དུས་གཅིག་པར་མི་འདོད་པ་དང་།",
    "ཉེ་བར་ལེན་པ་པོའི་བདག་གཉིས་ཕན་ཚུན་ལྟོས་ཀྱང་རང་བཞིན་དུ་ཡོད་པ་མི་འགལ་ཏེ།",
    "དང་པོ་ལའང་རང་བཞིན་གཞན་དུ་འགྱུར་བར་འགལ་བ་དང་།",
    "དང་པོ་ལའང་རང་བཞིན་གཞན་དངོས་དགག་པ་དང་།",
    "རང་བཞིན་འགའ་ཞིག་ལས་གཞན་གྱི་དངོས་པོའང་ཡིན་ལ་དེ་ཉིད་ཀྱི་རང་བཞིན་ཡང་ཡིན་པ་ཞིག་ལ་ནི་གཞན་གྱི་དངོས་པོའི་རང་བཞིན་ཡིན་ཞེས་བརྗོད་པ་ཡིན་པས་དེ་ལ་ཡང་རང་བཞིན་གྱིས་ཁྱབ་དགོས་སོ།",
    "གནས་སྐབས་འགྱུར་ཡང་རང་བཞིན་རྟག་གོ་ཞེས་ཀྱང་བརྗོད་པར་མི་རུས་ཏེ།",
    "ངར་འཛིན་དང་ང་ཡིར་འཛིན་པ་མེད་པའི་རྣལ་འབྱོར་པ་གང་ཡིན་པ་དེ་ཡང་རང་བཞིན་དུ་ཡོད་པ་མ་ཡིན་ཏེ་སྔར་བདག་དང་ཕུང་པོ་ཙམ་བཀག་པས་དེ་གཉིས་སུ་མ་འདུས་པའི་རྣལ་འབྱོར་པ་ཉིད་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "མ་འོངས་པའི་དུས་ཀྱང་རང་བཞིན་དུ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "འབྲས་བུ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའམ་མི་སྟོང་པ་ཞིག་སྐྱེ།",
    "གལ་ཏེ་དེ་ལྟར་འགག་བཞིན་སྐྱེ་བཞིན་གྱི་སྲིད་པ་གཉིས་དག་དུས་ལྷན་ཅིག་ཉིད་དུའང་རིགས་མིན་ན།",
    "བསྟན་པའི་ཚུལ་དེ་ལྟར་བློ་ངོ་གཉིས་ལ་ལྟོས་ནས་སྣང་བ་དང་རང་བཞིན་ཅིར་ཡང་མ་གྲུབ་པར་གནས་པ་ཡིན་པ་དང་།",
    "བྱད་ལ་སོགས་པའི་རིག་སྔགས་མན་ངག་ཇི་ལྟ་བ་བཞིན་བསྒྲུབས་ན་དགྲ་བརླག་པ་དང་རང་ལ་དངོས་གྲུབ་འབྱུང་ཡང་མན་ངག་བོར་ཏེ་ཉེས་པར་བསྒྲུབས་པས་རང་བརླག་པར་འགྱུར་བ་བཞིན་ནོ།",
    "བཅོས་མ་དང་རང་བཞིན་འགལ་བས་སོ།",
    "རང་རང་དངོས་ལ་ཐེར་ཟུག་གནས་དེ་ལ།",
    "དངོས་པོ་འགའ་ལ་ཡང་རང་བཞིན་གྱི་སྐྱེ་བ་མེད་པས་ཡོད་པའམ་མེད་པ་གང་ཡང་མི་སྐྱེ་སྟེ།",
    "དེ་ལྟ་ན་ཡང་རང་རྒྱུད་ཀྱི་རྗེས་དཔག་དོན་མེད་དེ།",
    "གཞན་ལུགས་སུན་འབྱིན་པ་ལ་ཡང་རང་རྒྱུད་ཀྱི་རྗེས་དཔག་སྦྱོར་བ་དོན་མེད་པ་ཡིན་ནོ།",
    "རང་ཕྱོགས་སྒྲུབ་པ་ལ་ཡང་རང་རྒྱུད་དོན་མེད་དེ།",
    "དེ་ལྟར་ན་རང་ལུགས་སྒྲུབ་པ་ལ་ཡང་རང་རྒྱུད་ཀྱི་སྦྱོར་བ་དོན་མེད་དོ།",
    "འགྲོ་བ་པོ་མིན་འགྲོ་བ་མིན།",
    "གནས་པ་པོ་མིན་འགྲོ་བ་མིན།",
    "སྐྱེ་བའང་རང་དང་གཞན་གྱི་དངོས།",
    "དེ་འདུག་པ་ན་མུན་པ་མེད།",
    "མུན་པ་གང་སེལ་བས་མར་མེ་གཞན་གསལ་བྱེད་དུ་འགྱུར་བ་མར་མེ་ཡུལ་གང་ན་འདུག་པ་དེ་ན་ཡང་མུན་པ་མེད་དེ།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "འགལ་ཟླར་གྱུར་པའི་ཕྱིར་མུན་པས་ཀྱང་རང་གཞན་གཉིས་ཀ་སྒྲིབ་པར་འགྱུར་རོ།",
    "གལ་ཏེ་གང་ལས་རྒྱུ་དང་རྐྱེན་དོན་མེད་པར་འགྱུར་བ་སྐྱེ་བའི་སྔ་རོལ་དུ་དངོས་པོ་འགའ་ལ་ཡང་རང་བཞིན་ཡོད་པ་མ་ཡིན་གྱི།",
    "དངོས་པོ་ཡོད་ན་ཡང་རང་བཞིན་ནམ་གཞན་དངོས་ཞིག་ཏུ་འགྱུར་དགོས་ཏེ་དེའི་ཕྱིར་དེ་དག་ཀྱང་ཡོད་དོ་ཞེ་ན།",
    "དེ་ལྟ་ན་བཅིངས་པ་ཡིན་པའི་ཕྱིར་དང་གྲོལ་བཞིན་པ་ཡིན་པའི་ཕྱིར་བཅིངས་པ་དང་གྲོལ་བ་དག་དུས་གཅིག་པར་འགྱུར་ན།",
    "དེ་ཡང་རང་བཞིན་ལུང་མ་བསྟན།",
    "འདི་ལྟར་རང་བཞིན་མེད་ཅིང་རང་བཞིན་གྱིས་སྟོང་པ་དེའི་ཕྱིར།",
    "ཅི་སྟེ་རང་བཞིན་མེད་པ་ལ་བྱ་བྱེད་མི་རུང་བའི་ཕྱིར་ཉེས་པ་སོ་ན་འདུག་གོ་སྙམ་ན།",
    "རང་བཞིན་དང་བཅས་པ་ཁོ་ན་ལ་བྱ་བ་མ་མཐོང་བའི་ཕྱིར་དང་རང་བཞིན་མེད་པ་རྣམས་ཁོ་ན་ལ་བྱ་བ་མཐོང་བའི་ཕྱིར་རོ།",
    "སྤྲུལ་པ་གང་ཞིག་སྤྲུལ་པ་གཞན་སྤྲུལ་པ་པོ་ནི་སྟོང་ཞིང་རང་བཞིན་མེད་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་རང་བཞིན་མེད་པའི་སྤྲུལ་པ་དེ་རྣམས་བྱ་བ་དང་བྱེད་ལས་དང་བྱེད་པ་པོ་ལ་སོགས་པའི་ཐ་སྙད་ཡོད་པ།"
  ]
}