    "ཡི་གེ་རང་རང་མཐུན་པ་ཉིད་དུ་ཤེས",
    "སུ་དང་འཕྲད་པ་མེད་པར་གཅིག་པོར་འདུག",
    "མགྲོན་རྣམས་རང་རང་ཞིང་དུ་གཤེགས་།",
    "རང་རང་ལས་ཀྱི་རྣམ་པར་སྨིན་པས་སྡུག་བསྔལ་མྱོང་ལུགས་དང་།",
    "དེའི་ཚེ་ང་ཤི་བ་ཡིན་འདུག་བསམ་སྟེ་མཆི་མ་མང་དུ་ཤོར་ནས་ཡོད་པ་དང་།",
    "ང་རང་ལྷ་ཁང་མཇལ་བ་ལ་ཕྱིན་པ་ཡིན་ཞུས་པས།",
    "ཕ་མ་གཉིས་པོས་ཤི་བ་ཡིན་ཟེར་སྡུག་བསྔལ་དཔག་ཏུ་མེད་པ་བྱས་ནས་འདུག།",
    "ཡང་ངའི་བསམ་པ་ལ་གང་ཡང་ངོས་བཟུང་མེད་པ་འདི་ཅི་ཡིན་བསམ་ནས་བསྡད་ཙ་ན།",
    "ཁྱེད་རང་མ་ཎི་ལན་བདུན་བགྲངས་ཤིག་གསུངས་པས།",
    "དེ་ནས་ཡང་རང་སེམས་ཤིན་ཏུ་མི་དགའ་བ་གཅིག་བྱུང་ནས།",
    "ང་རང་དྲན་མེད་དུ་འགྱེལ་ལོ།",
    "ཡང་ང་རང་འདི་ལྟ་བུའི་སྡུག་བསྔལ་མང་པོ་མྱོང་བ་མཐོང་ནས།",
    "ལ་ལ་ནི་ཆུ་ཚོད་བལྟ་ཞིང་འདུག།",
    "ལ་ལ་ནི་ཡི་གེ་འབྲི་མཁན་ཡང་འདུག།",
    "ལ་ལས་དགེ་སྡིག་གཉིས་ཀྱི་ཤན་ཕྱེ་ཞིང་འདུག།",
    "ཚེ་ཟད་དུས་ལ་བབ་ནས་ངའི་མདུན་དུ་སླེབས་ནས་འདུག་གོ།",
    "མི་མང་ངུ་ཞིང་འདུག་པ་འདི།",
