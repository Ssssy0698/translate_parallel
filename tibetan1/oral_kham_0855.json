    "ང་རང་མིའི་ཡུལ་དུ་བསྡད་དུས་སུ།",
    "སྤྲེལ་མགོ་ཅན་གྱིས་མདེའུ་དཀར་པོ་ཡང་བར་འདུག།",
    "མདེའུ་ནག་པོ་ལྕི་བར་འདུག་ཞུས་པས།",
    "ཀྱེ་མ་ངའི་ཨ་ཞང་ཚུར་ཉོན་དང་།",
    "རང་རང་ལས་ཀྱིས་སྡུག་བསྔལ་མྱོང་༡༡བ་ལ།",
    "རང་རང་ལས་ཀྱི་སྡུག་བསྔལ་མྱོང་མཁན་རྣམས།",
    "ཁྱེད་རང་གཉིས་ཀྱིས་དམྱལ་ཁམས་བཅོ་བརྒྱད་ཀྱི་སྡུག་བསྔལ་ཐམས་ཅད་མཐོང་བྱུང་ངམ།",
    "ལས་ངན་ཚེ་ལས་འདས་པ་རྣམས་ཀྱང་བསམ་གྱིས་མི་ཁྱབ་པར་འདིར་སླེབས་འདུག་གོ།",
    "ཀྱི་ཚེ་འདས་ཁྱེད་རང་ཚུར་ཉོན་དང་།",
    "ང་རང་མིང་ལ་རྟ་མགྲིན་ཕུན་ཚོགས་ཟེར།",
    "ཁྱེད་ལྷ་དང་འདྲེ་གཉིས་ཀྱི་གཏམ་ཕྱེད་བདེན་ཕྱེད་མི་བདེན་པར་འདུག།",
    "ལོ་ནི་ལྔ་བཅུའི་བར་དུ་ཟངས་ཆེན་ནང་དུ་འགྲོ་དགོས་འདུག།",
    "ཡི་དྭགས་ངུ་འབོད་ནང་དུ་འགྲོ་དགོས་འདུག།",
    "ལ་ལ་ནི་རྟ་མཆོག་རྒྱལ་པོ་བྷ་ལ་ཧ་ལ་བཞོན་ནས་སླེབས་མཁན་ཡང་འདུག།",
    "ཡར་མིའི་ཡུལ་དུ་ཕྱིན་ཙ་ན།",
    "ངའི་ཕུང་པོ་མེ་རུ་བསྲེགས་ཚར་འདུག།",
    "སྔར་བཞིན་གསོན་གཤིན་གཉིས་ཀྱི་འཕྲིན་པ་བྱེད་དགོས་ཡོདའདུག།",
