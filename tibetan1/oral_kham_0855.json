    "མ་ཧཱ་ལོ་ཙཱ་བ་ཁྱེད་ལོ་ཙཱ་མཁས་པར་གྲགས་ཤིང་འདུག་པས་ངའི་ལོ་ཙཱ་བྱ་དགོས་གསུངས་པས།",
    "༡༣ བརྟན་པའི་འཁོར་ལོའི་ཆོ་ག་༡༤ ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས།",
    "༡༤༣ ཙ་ན་ཀའི་རྒྱལ་པོའི་ལུགས་ཀྱི་བསྟན་བཅོས།",
    "དེ་ཡང་དར་མ་ཨུ་དུམ་བཙན་གྱིས་བསྟན་པ་བསྣུབས་རྗེས་སློབ་དཔོན་པདྨ་འབྱུང་གནས་དང་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན།",
    "བོང་རངས་གླང་རངས་བས་ནི་འདོད་ཆགས་ཆེ།",
    "བེ་རོ་ཙ་ནས་ལོ་ཙཱ་བསྒྱུར་ནས་གསུངས།",
    "སྔོན་གྱི་ལོ་ཙཱ་བ་སྒྲ་བསྒྱུར་བེ་རོ་ཙ་ན་དང་།",
    "བེ་རོ་ཙ་ན་དང་སྐ་ཅོག་ཞང་གསུམ་སོགས་ཀྱི་ལོ་ཙཱའི་རིགས་ལམ་གྱི་གཞི་རྟེན་འོག་ཕྱི་རབས་རྣམས་ལ་བརྗོད་བདེ་བ་དང་རྟོགས་སླ་བ།",
    "བོད་ཀྱི་ལོ་ཙཱ་བའི་ནང་ནས་འགྱུར་གཞུང་མང་ཤོས་སུ་གྲགས་པའི་རྔོག་ལོ་ཙཱ་བ་བློ་ལྡན་ཤེས་རབ་ཀྱིས་བེ་རོ་ཙ་ན་ནམ་མཁའི་མཐའ་དང་མཉམ།",
    "ཅེས་གསུངས་པ་ལྟར་ཉན་ཐོས་དང་རང་རྒྱལ་ཐེག་དམན་པ་ལྟ་ཅི།",
    "འགྱུར་བྱང་ཚུལ་དུ་བྲིས་པའི་ཚིགས་བཅད་རྐང་པ་བདུན་དང་ཕྱེད་འདུག་པ་དེ་ལོ་ཆེན་གྱི་རང་རྩོམ་འཁྲུལ་མེད་སྣང་བ་རྫོགས་པར་དྲངས་ན།",
    "ཁྱེད་ལ་ཡོན་ཏན་ཀུན་འདུག་པས།",
    "མཁར་རྩེའི་ཡུལ་དེར་གནའ་གཏམ་དུ་དང་པོ་ཙ་ན་ཕ་སྒོ་བཅུ་གསུམ་ཞེས་གྲོང་ཁྱིམ་བཅུ་གསུམ་དང་ཡུལ་ལྷའང་བཅུ་གསུམ་བྱུང་བར་བཤད།",
    "ཡོད་སྨྲ་ཁྱེད་རང་ཡིན།",
    "ཁོ་བོས་བསམས་ན་སྤྱི་ལོ་ལོར་འཁྲུངས་པའི་བཞེད་ཚུལ་དེ་མི་འཐད་པར་འདུག་སྟེ།",
    "སྤྱི་ལོ་བར་དུ་སྒྲུབ་ལ་རྩེ་གཅིག་གནས་ཞེས་འཁོད་འདུག་པར་བརྟག་ན།",
    "སྩོགས་དང་དཀོན་ཅོག་སོགས་བཀས་བཅད་བར་མའི་འབྲི་སྲོལ་ཁ་ཅིག་མངོན་རྒྱུ་འདུག་ལ།",
    "འཁོར་ལོ་ལྡེ་ཡིན་ཞེས་མངའ་རིས་གུང་ཐང་དུ་དཔེ་ཧྲུལ་ཀ་ནི་ཀ་རྙིང་པར་བརྫངས་བ་ཞིག་ཏུ་འདུག་པ་འཐད་ངེས་སུ་སྣང་།",
    "ནོར་འཕྲོད་ཁྱེད་རང་དང་མཇལ་ཀྱང་འདི་ལྟར་བསྟན་པའི་བྱ་བ་ཆེས་པས་གདན་མ་འདྲོངས།",
    "ང་རང་ལ་ཡང་བར་ཆོད་བྱུང་ན་ཇོ་བོ་སྤྱན་མི་འདྲོངས་པར་གདའ་བས་ཁོ་དང་ཐབས་མཁས་པས་བསྟུན་གྱིས་བསླུས་པ་དང་།",
    "འོ་ན་ཁྱེད་རང་པཎྜི་ཏ་གདན་འདྲེན་པའི་འཕྲོ་གཤོལ།",
    "ཁྱེད་རང་ཡང་ངའི་འོག་ཏུ་ཞུགས།",
    "པཎྜི་ཏ་གདན་མ་དྲངས་པར་ཁྱེད་རང་ངེད་ཀྱི་འོག་ཏུ་ཞུགས་ཟེར་བ་པ་ནི།",
    "གསེར་ང་རང་ཙམ་རྙེད་པ་ཤིན་ཏུ་རྔམས་ཆེ་ན་ད་མགོ་པོ་ཙམ་པ་ག་ན་རྙེད།",
    "ཁོང་རང་ཡང་རྒྱ་གར་དུ་བྱོན་པས།",
    "ང་བླུ་བའི་གསེར་རྣམས་ཁྱེར་ལ་ཇོ་བོ་དཱི་པཾ་ཀ་ར་ཞེས་བྱ་བ་བཞུགས་ཡོད་པར་འདུག་དེ་ལ་གསེར་ཕུལ་བོད་དུ་གདན་དྲངས་ལ།",
    "མཇུག་ཏུ་གསེར་དེ་དག་ཇོ་བོ་གདན་འདྲེན་ཞུ་བའི་ཡོན་དུ་བཏང་འདུག་པའི་གནས་ཚུལ་ཡང་གསལ་སྟོན་གནང་འདུག་སྟེ།",
    "ཞང་ནི་རུས་ལ་གོ་བར་འདུག་སྟེ།",
    "རང་རང་སློབ་དཔོན་རྣམས་ཀྱི་བསྔགས་པ་ཡི།",
    "གསང་སྔགས་ནང་པ་ཡོ་ག་རྣམ་གསུམ་ལོ་ཆེན་བེ་རོ་ཙ་ནས་བསྒྱུར་ཏེ་གསུངས།",
    "བེ་རོ་ཙ་ན།",
    "ཡེར་པ་ན་དེང་སང་ཡང་གྲུབ་བརྒྱའི་མཆོད་རྟེན་འདུག་པས་གྲུབ་ཆེན་དེ་རྣམས་ཀྱི་དྭངས་མ་འོད་སྐུར་ཡལ།",
    "དེ་ནས་ངེས་དོན་དུ་རྒྱལ་པོས་གླེགས་བམ་དེ་རྣམས་ལ་བརྟགས་ན་རྟོགས་པར་འདུག་ཀྱང་།",
    "ནང་པར་སྒོར་ཕྱིན་ཙ་ན་བྱ་ངང་པ་དེ་དཔུང་པར་ཆགས་ནས་འདི་སྐད་དོ།",
    "དེས་གཟུང་མ་ཨ་ར་ལི་དང་རྒྱལ་པོ་གློག་འོད་ལ་ཡུལ་དྷ་ན་ཀོ་ཤའི་ཤར་ཕུག་ཏུ་གསུངས་ཤིང་རང་ལུས་ཕུལ།",
    "མེ་ཏོག་ཀྱང་ཁ་ཟུམ་ནས་འདུག་གོ།",
    "འདི་ཁྱིམ་བཙུན་ཞིག་ཏུ་འདུག་པས་མ་ཡིན་ནམ་སྙམ་ནས།",
    "ཤྲཱི་སིངྷའི་ཐུགས་ལ་འདི་ལ་ཡང་རྫུ་འཕྲུལ་འདི་ལྟར་འདུག་པས་ཁྱིམ་བཙུན་དེ་སློབ་དཔོན་ཡིན་ནམ་སྙམ་ནས་ད་དུང་བརྟག་དགོས་བསམས་ཏེ།",
    "དོ་ནུབ་གནས་ག་ཡར་བྱས་པས་འདུག་གསུངས་ནས་བཞུགས་པས།",
    "སློབ་དཔོན་གྱི་གདམས་ངག་མི་གནང་བར་འདུག་འགྲོ་དགོས་སྙམ་ཡོད་ཙ་ན།",
    "ཟོ་བྱ་བ་ཡིན་ནམ་སྙམ་སྟེ་ཟོས་པས་རོ་མཆོག་བརྒྱད་དང་ལྡན་པ་ཤིན་ཏུ་དྲི་ཞིམ་པ་ཞིག་འདུག།",
    "སློབ་དཔོན་འདི་དང་པོར་ཞིང་རྨོ་བའི་ཚེ་བརྡ་ཞིག་ཡིན་འདུག་པ་ལ་ཡང་ངས་མ་གོ་བས་ཤི་ན་རུང་།",
    "ཤིང་ཏོག་ཟོས་པ་དེ་ཡང་བརྡར་འདུག་སྟེ་མ་གོ་བས་ཤི་ན་རུང་སྟེ་སྙམ་པ་བདུན་ཤར་བ་དང་སྐྱུག་འཕྲོ་ཆད།",
    "དེ་ལས་སད་ཙམ་ནས་སློབ་དཔོན་ཡང་དེ་གར་བཞུགས་ནས་འདུག་སྟེ་དོན་དེ་མི་བརྗེད་པའི་བརྡར།",
    "ལོ་ཙཱ་བེ་རོ་ཙ་ན་དང་གཙང་སྔོན་ལེགས་གྲུབ་ལ་དྷ་ཧེ་ནའི་གཙུག་ལག་ཁང་དུ་གསུངས་ཤིང་།",
    "དེ་ནས་བེ་རོ་ཙ་ནའི་རྟོགས་པ་མངོན་དུ་གྱུར་ཏེ།",
    "དེར་རྡོ་རྗེ་གདན་དུ་བལྟས་པས་རྒྱ་རྣམས་བཤིག་ནས་འདུག་སུས་བཤད།",
    "བྲག་ཆེན་པོ་གསུམ་གྱི་ཁ་ན་འདུག་པ།",
    "མིག་ལྟག་ཁུང་དུ་དོད་པ་ཁྲེས་ཆུང་ཅན་གཉིས་ཀྱིས་ཉན་འདུག་པས་འདི་ཡ་མཚན་ཆེ་ལྷ་མི་སྤྲུལ་པ་གང་ཡིན་ངོ་མ་ཤེས་ཟེར་རོ།",
    "སྔགས་བསྒྱུར་ནང་དུ་བེ་རོ་ཙ་ན་བྲིས",
    "འདི་བས་ལྷག་པ་མེད་ཀྱང་མཐའ་མི་ནོར་འདོད་དུ་འདུག་སྙམ་སྟེ་ལོག་རྟོག་སྐྱེས་ནས་ཞུ་ལན་ཕུལ་བར།",
