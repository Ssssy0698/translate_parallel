    "ཞེས་དེའི་དགོང་ཁྲོད་དབུ་གུར་གཅིག་ཏུ་ཡུམ་སྲས་ཡིད་འཕྲོག་གསུམ་ག་ལྷན་རྒྱས་སུ་བཞུགས་ཏེ་གཞིས་བྱེས་ཀུན་གྱི་དགེ་སྐྱོན་གསུང་གླེང་ཞིབ་ཏུ་གནང་།",
    "སུ་དང་ཐུག་འཕྲད་མེད་པར་ཕྱིན་ལགས་གཤིས།",
    "མཐུ་ནུས་ལྡན་པའི་ཞབས་བརྟན་བཟང་ལགས་སམ།",
    "ལྷ་སྲས་ཡིད་འཕྲོག་མ་ཡེངས་བདག་ལ་གསོན།",
    "ཅེས་དེ་འཕྲལ་ཆིབས་བསྒྱུར་ཚོམས་ཆེན་དུ་ཕེབས་དགྱེས་སྟོན་སྡར་མ་གྲགས་པ་མཛད་ཐོག་ནོར་བཟང་ནས་ལྗོན་པའི་ཡུལ་དུ་ཕེབས་པ་ནས་བཟུང་ཡིད་འཕྲོག་མས་དྲང་སྲོང་ལ་ཕྱི་ལན་བཞག་ཚུལ།",
    "གསོལ་སྟོན་གྲོལ་བསྟུན་སོ་སོའི་གཟིམ་ཆུང་དུ་ཕེབས།",
    "བསམ་གྲུབ་སྒྲོལ་མ་གཞོན་ནུ་གཉིས་པོ་དེ་སྐུ་མདུན་དུ་ཤོག་གསུང་པས་གོང་གསལ་གཉིས་ནི་རབ་ཏུ་སྐྲག་ནས་མཆི་མ་འདོན་བཞིན་བཅར་བས།",
    "སྔོན་བྱས་ལྔ་བརྒྱའི་བྱ་ངན་བྱུང་ཚུལ་རྣམས།",
    "ཡོང་ལུགས་ཞིབ་པར་ཞུའོ་སྙན་གསོན་ཅིག།",
    "ཡིད་འཕྲོག་གྲལ་མགོར་བཞུགས་བཞིན་གཡུ་ཁྲི་བརྒྱབ།",
    "ལྔ་བརྒྱར་སྣང་ཆུང་བྱས་པའི་རྐྱེན་ལ་བརྟེན།",
    "རྗེ་འབངས་ཀུན་ལ་ལྔ་བརྒྱས་བསྐུར་འདེབས་བྱས།",
    "ལྷ་སྲས་མཚར་ཞིང་མཛད་བཟང་ལྡན་པ་ཞེས།",
    "བདག་ཅག་བྱིངས་ནས་མ་ཤེས་ཅི་ཡིན་བྱས།",
    "སླེབས་འཕྲལ་རྒྱལ་པོས་དེ་ལ་རྩིས་ཆེན་བྱས།",
    "དཔོན་གཡོག་ཐུགས་འདྲའི་རང་ཕྱོགས་སྣང་ཆུང་བྱས།",
    "ཡིད་འཕྲོག་མེད་པའི་ཐབས་ཤིག་མ་བྱས་ན།",
    "ཕྱིར་འཁོར་ཞལ་བཞེས་བཟང་ཚུལ་དགའ་སྤྲོ་བྱེད།",
    "དེ་རྗེས་རྒྱལ་པོ་བྱང་དུ་ཕེབས་ཚར་བསྟུན།",
    "ཡང་ནས་ལྔ་བརྒྱའི་རྣ་བར་འདི་སྐད་གསུངས།",
    "བཀའ་འདྲི་གནང་ན་རྒྱལ་པོའི་དགོངས་པར་དྭངས།",
    "ཅེས་སྐུ་མདུན་རང་དུ་ལྗགས་སྨིན་ནས་གསོལ་རས་སྩལ་བས།",
    "ཐུགས་རྗེའི་མངའ་བདག་བྱང་སེམས་ཌཱ་ཀི་བཞུགས།",
    "ཡབ་ཀྱི་དྲུང་དུ་ཕེབས་ནས་འདི་སྐད་དོ།",
    "སྔ་ཕྱིའི་བྱེད་བབ་ཐམས་ཅད་དྲི་བ་བྱས།",
    "ཞིབ་པར་ཡི་གེར་བཀོད་ནས་ཡབ་ཀྱི་དྲུང་།",
    "སྤྱན་ཞུ་ཐུགས་དགོངས་དྭངས་ཕྱིར་བཅར་ལགས་པས།",
    "བྱས་ཚོད་ང་ཡི་བློར་ཡང་དོགས་ནས་ཀྱང་།",
    "ལེགས་པར་དགོངས་དང་ཡབ་ཆེན་རྒྱལ་པོ་ལགས།",
    "བཀའ་འདྲི་གནང་ན་ཡབ་སྲས་དགོངས་པ་དྭངས།",
    "དུས་གཅིག་ཏུ་ཀུན་བཟུང་སྟེ་མུན་པ་ཅན་གྱི་ཁང་པར་ཁ་འཕྲལ་ནས་བཅུག་དགྱེས་སྟོན་རྣམས་གྲོལ་བསྟུན་ཡབ་ནས་ཉིན་གཅིག་བྱང་གླིང་ན་ཁར་བྱོན་ཏེ་ཞབས་གྲས་མང་ལ་རག་པ་ཁྲིད།",
    "ཐོག་མར་ཧ་རི་འཁྲིད་ཤོག་ཅེས་གསུངས་པས།",
    "ལེནས་པར་ཉོན་དང་ཡིན་ལུགས་དྲང་པོར་ཤོད།",
    "ཡབ་ནས་བདག་ལ་བཀའ་ཕེབས་འདི་ལྟར་བྱུང་།",
    "ཕེབས་གཤིས་ཡིད་འཕྲོག་གཞན་བསྒྲོལ་མི་རིགས་པས།",
    "སྒྲོལ་བྱེད་ལྔ་བརྒྱས་བྱས་ན་མཛེས་འདྲ་ཞུས།",
    "དེ་ཀུན་ཡབ་ཀྱི་དགོངས་པར་འཇགས་ཚོད་ཡོད།",
    "ཡབ་ཆེན་དེ་ལྟར་མ་གསུངས་བདག་ལ་གསོན།",
    "ཡིད་འཕྲོག་བསྒྲོལ་ནས་ཚིལ་བུ་ཁྱེར་ཤོག་གསུངས།",
    "ཁྲུས་རྫིང་ཁ་དེར་ཡབ་ལ་ཁྲུས་གསོལ་བྱས།",
    "དེ་རྣམས་ཀུན་ཀྱི་དགོངས་པར་འཇགས་ཚོད་ཡིན།",
    "དགོངས་དེ་དག་གོ་ཡབ་ཆེན་རྒྱལ་པོ་ལགས།",
    "ཡིད་འཕྲོག་ནམ་ཉིན་མེད་པར་སྐུ་ལ་བཅར།",
    "ཡབ་ཆེན་རྒྱལ་པོའི་མཚན་ལྟས་སློག་ཐབས་བྱས།",
    "ནོར་བཟང་བྱང་ལ་ཕེབས་བསྟུན་ཡིད་འཕྲོག་ནི།",
    "ཡབ་ལ་དབུ་བསྐོར་ཞུས་ཏེ་སྒྲོལ་བར་བྱས།",
    "ཧ་རིས་ཁས་ལེན་བྱས་པའི་བརྗོད་རིགས་བཅས།",
    "ཧ་རིས་བྱས་ཚད་བདེན་འཛིན་ལག་ཏུ་བླངས།",
    "ཡིད་འཕྲོག་མེད་པའི་ཐབས་ཀྱི་བཀོད་པ་བྱས།",
    "ནོར་བཟང་བྱང་ནས་འཁོར་འཕྲལ་འཁྲུགས་འཛིང་བྱས།",
    "ཚུར་ལ་གསོན་དང་ཡབ་ཆེན་རྒྱལ་པོ་ལགས།",
    "རྣ་ཐོས་མེད་པར་བཟུང་ནས་གང་ཤར་བ།",
    "བཀའ་འདོམས་ཅི་བདེར་གཏོང་བ་ཅིས་ཀྱང་མཁྱེན།",
    "སླར་ཡང་ཅི་ཡོང་རྟོགས་པར་དཀའ་བ་ཡིན།",
    "ཞེས་གསུངས་པས་ཡུམ་ཆེན་ནས་འདི་སྐད་དོ།",
    "དགོངས་བཞེས་ལྔ་བརྒྱུའི་སྲོག་སྐྱོན་མེད་ཙམ་གྱི།",
    "ད་དུང་ཇི་ལེགས་ཞིབ་པར་བཀའ་གྲོས་སོ།",
    "ཞེས་དོ་ནུབ་སོ་སོའི་གཟིམ་ཆུང་དུ་ཕྱག་ཕེབས།",
    "འབངས་འཁོར་མི་གྲགས་ཀུན་འཛོམས་པའི་ཐོག་ཡབ་ནས་སྔོན་མའི་བཀའ་བཞིན་ཀུན་གསོད་ཤག་རང་གནང་བའི་ཚེ",
    "ནན་ཞུ་དོན་ལ་དགོངས་པ་མི་བཞེས་ན།",
    "ལེགས་པར་ནོར་བཟང་བདག་ལ་སྙན་གསོན་དང་།",
    "མིག་བཏོན་ཡུལ་ངན་གཞན་དུ་བཅུག་པར་བྱ།",
    "ད་ལམ་ནོར་བཟང་འཆར་ལྟར་འཐུས་པར་བྱེད།",
    "ཡབ་ནས་ནོར་བཟང་ལ་ཁྲི་འདོན་གནང་རྒྱུའི་དགྱེས་སྟོན་སོགས་གང་ཅིའི་སྒྲིགས་ཟླ་གཅིག་ལྷག་ཙམ་གནང་།",
    "། རྒྱུད་འབུམ་ཀ་པ་བཞུགས་སོ། ། རྒྱ་གར་སྐད་དུ།",
    "འཇམ་དཔལ་ཡེ་ཤེས་སེམས་དཔའི་དོན་དམ་པའི་མཚན་ཡང་དག་པར་བརྗོད་པ།",
    "དམ་ཚིག་ཆེན་པོ་དེ་ཉིད་མཁྱེན།",
    "མཚན་ཡང་དག་པར་བརྗོད་པ་མཆོག།",
    "གང་ཡང་ཡང་ཡང་གསུངས་པ་གང་།",
    "གང་ཡང་ཡང་དག་རབ་གསུངས་པ།",
    "དག་པར་བྱེད་ཅིང་སྡིག་སེལ་བ།",
    "ང་ལས་མཉན་པར་བརྩོན་པ་ནི།",
    "འཇིགས་ཆེན་འཇིགས་པར་བྱེད་པ་པོ།",
    "ཡང་དག་མཐའ་ལ་རྣམ་པར་གནས།",
    "རྒྱལ་བ་དགྲ་རྒྱལ་རྣམ་པར་རྒྱལ།",
    "ཚིག་བདེན་བདེན་པར་སྨྲ་བ་དང་།",
