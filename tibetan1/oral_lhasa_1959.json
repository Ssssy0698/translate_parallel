    "ཆུ་བཟང་ལ་མཐོལ་བཤགས་གཙང་སངས་པ་བྱས་ཏེ་བླ་སློབ་ཀུན་གྱི་འབྲེལ་བ་སྔར་ལས་ཇེ་ཟབ་ཏུ་བཏང་།",
    "རྣམ་རྒྱལ་མ་རྣམས་ཀྱི་རྗེས་གནང་།",
    "དགུང་ལོ་ཉེར་ལྔའི་སྟེང་དབུས་གཙང་དུ་ཕེབས།",
    "རྒྱལ་བ་མཁས་གྲུབ་རྒྱ་མཚོའི་ཞབས་ཕྱགས་བཅས་བསྩལ་བ་ལས་ཞབས་ཕྱགས་ཡ་གཅིག་འབྲས་འགག་ཤིང་ལ་གནང་།",
    "ཡ་གཅིག་ཚེ་ཏན་གཞུང་ལ་གནང་།",
    "དེའི་རྐྱེན་གྱིས་དཀར་ཆག་རྙིང་བ་དེའི་དོན་རྩ་རྒན་པ་ཚོའི་བློ་ན་ཡོད་པ་ས་བོན་དུ་བྱས་ནས་གསར་བ་འདི་བསྒྲིགས་པ་ཡིན།",
    "དགུང་ལོ་ལྔ་བཅུའི་ནང་ཙམ་ལ་སྟོད་སོག་ཡུ་གུར་ཕྱོགས་སུ་ཕེབས་ནས་གདུལ་བྱ་རྒྱས།",
    "ཕྱིར་ཕེབས་ནས་ཚེ་ཏན་ལ་བྱམས་པའི་གོས་སྐུ་སོགས་དགོན་ཁག་རྣམས་ལ་འཇོག་པ་བཟབས།",
    "བོའུ་སྐུ་སྐྱེ་དཔལ་ལྡན་རྒྱ་མཚོ་དང་བློ་བཟང་རབ་བརྟན་སོགས་རིམ་པར་བྱོན་པ་ལས་ད་ལྟ་རྭ་ལོ་ཐང་ནས་འཁྲུངས་པ་བློ་བཟང་འཇིགས་མེད་རབ་བརྟན་ཆུ་བཟང་དུ་ཐུགས་གཉེར་གྱི་སྐབས་ཡིན།",
    "དན་ཏིག་བླ་བྲང་ལ་ཞིག་གསོ་ངོས་གཙང་བ་དང་།",
    "ད་ཆ་དགུང་ལོ་ཞེ་བདུན་བཞེས་ཤིང་སྐུ་ཚེ་བརྟན་པར་བཞུགས་པ་འདི་བཞིན་ལགས་སོ།",
    "ཨ་ཚ་ཞེས་གསུང་འབྱོན་པར་གྲགས་ཏེ།",
    "འདས་པའི་གདུང་སྟག་དགོན་འདུ་ཁང་རྙིང་བའི་ཀླད་དུ་བཞུགས།",
    "དེའི་ཉེ་ལོགས་ཀྱི་ལ་བཙས་ནང་དུ་མེ་ཚང་ཇི་ལྟར་བཅས་ཀྱང་སྦར་མ་ཐུབ་པས་ཧོས་ཧོས་མི་སྲུན་པ་རྣམས་ཀྱང་འུ་ཐུག་པར་གྲགས།",
    "དེ་ནས་ཕྲན་བུའི་རིང་ལ་ཞིག་གསོས་བྱས་ཚུལ་འོག་ཏུ་གསལ།",
    "གང་ལྟར་ཕྱོགས་དེར་ཕེབས་པའི་རྟགས་ལ།",
    "གྲྭ་བ་རྣམས་བཞུགས་གསུངས་ནས།",
    "ལྡེ་ཚའི་སྐུ་ཞབས་རྣམ་པ་གཞན་དང་གཞན་ཡང་ཕེབས་ནས་ཞབས་ཀྱིས་བཅགས་ཤིང་བྱིན་གྱིས་བརླབས་ལ།",
    "ཕྱིས་སུ་ཕྲན་བུའི་སྐྱེ་ཕྲེང་སྔ་ཕྱིར་འབྲེལ་བའི་སྐོར་འོག་ནས་འཆད་པར་འགྱུར་རོ།",
    "བསྙེན་རྫོགས་སྐབས་སུ་འཇམ་དབྱངས་གྲགས་པར་མཚན་གསོལ།",
    "བློ་བཟང་རྒྱལ་མཚན་ཞེས་སྐུ་ཕྲེང་སོ་སོར་བྱས་པ་ནི་ངག་སྒྲོས་མ་དག་པ་ཞིག་ལ་བརྟེན་པ་ཡིན་པར་སྣང་སྟེ།",
    "རབ་བྱུང་བཅུ་གསུམ་པའི་སྨད་ཕྱེད་ཀྱི་སྟོད་ཙམ་དུ་འདས་པར་མངོན་ཏེ།",
    "དེ་ལྟར་ན་དགུང་ལོ་དྲུག་ཅུ་ཙམ་ལ་བཞུགས་པ་ཤེས།",
    "སྒར་ཁག་གཅིག་ཏུ་ཁུ་དབོན་གྱི་ཚུལ་དུ་བཞུགས་པ་ལ་འཇིག་རྟེན་ཡོངས་གྲགས་དང་མཐུན་པར་ཕ་དང་བུའི་ཐ་སྙད་ཀྱང་དེ་དུས་ཀྱི་སྐྱེ་བོ་ཀུན་གྱི་ངག་ཏུ་མ་བསླབས་པར་ཡང་ཁ་ལ་ལོབས་ཡོད་པ་གསལ་བར་ཤེས།",
    "ཅེས་གསུངས་པའི་ཁུངས་ནི་འདི་ལ་ཐུག་པ་ཡིན་ནོ།",
    "དེའི་རྐྱེན་གྱིས་ཁ་དྲུག་ཕྱོགས་ནས་གདན་དྲངས་ཏེ་ཕེབས་པ་ཡིན་ཟེར་ཏེ་ངག་རྒྱུན་གང་དག་བརྟག་པར་བྱ།",
    "དགུང་ལོ་བདུན་པར་ཇ་སག་མདུན་ནས་རབ་བྱུང་བསྒྲུབས།",
    "ཇ་སག་ཚང་རྒྱ་ནག་ཏུ་ཕེབས་ནས་ལོ་མང་རབས་བཞུགས།",
    "ཤུ་དུ་དགོན་ཁག་རྣམས་ཀྱི་ཁྲི་འགན་བཞེས་པར་བརྟེན་སེར་སྐྱ་ཚང་མར་རྩིས་མཐོང་ཤིན་ཏུ་ཆེ།",
    "ཞེས་གསུངས་པ་ནི་དོན་དང་ལྡན་པར་གྲགས་ཏེ།",
    "ཐུགས་གཟུ་བོར་གནས་སྟབས་གྱོད་ངན་ཁ་མཆུ་སོགས་ཀྱང་འགྲིག་འདུམ་བྱས་པ་མང་བར་གླེང་།",
    "སྐུ་ཚོ་ཞིང་དར་བས་ཆིབས་ཀྱིས་མ་དྲོངས་པར་གཡག་ཀོ་སྟེང་ནས་འདྲུད་པའམ།",
    "ཀྱོའུ་ཙིའི་སྟེང་ནས་ཕེབས་བཞུད་བྱེད་དགོས་པ་དང་།",
    "མགོན་ཁང་སོགས་ལ་རབ་གནས་རྒྱས་ཙམ་ཞིག་མཛད་པའི་མཇུག་ནས་ཆིབས་རྟ་དཀར་པོ་ཆེ་ལེགས་ཤིག་ཡོད་པ་ཕུལ་བས་གཞི་བྱས།",
    "དེ་ནས་དགུང་ལོ་ང་བརྒྱད་དམ་ང་དགུ་གང་རིགས་ལ་གོང་སྐྱའི་སྒར་རྙིང་བ་ནས་མྱ་ངན་ལས་འདས་པར་གྲགས་སོ།",
    "མ་ལ་མདུང་རྨས་འགའ་ཕོག་པར་ཟ་ལར་ཞིག་ལ་བྱིས་པ་མི་སྟེར་ཀ་མེད་བྱུང་།",
    "འདི་མ་གསོད་པར་ཁྱེར་ལ་ཕན་ཐོགས་ངེས་ཡིན་ནོ་ཞེས་གདམས།",
    "ཚོགས་ལངས་ཀྱང་ལན་མང་བྱས།",
    "རྒྱའི་སྐད་ཀྱི་གདངས་ལ་རྒན་མ་ཐོན་པར་ནན་ཞེས་བཅོས་པར་ཁོང་བའི་རྒྱའི་མིང་ལ་ནན་ཁྲན་ཀྲིན་དང་ནན་ཏཱ་ཞིན་ཞེས་སུ་གྲགས།",
    "འཁྲུག་མགོ་མནན་པས་ད་ལྟ་ཚང་མ་བག་ཕབ་ཏུ་གནས་ཆོག་པ་འདི་བྱུང་ཞེས་གསུངས་ཤིང་ཧ་ཅང་ཐུགས་ཟིན་པའི་ངག་སྒྲོས་ཁུངས་མ་དང་ལྡན།",
    "གོང་སྐྱའི་བླ་བྲང་ཡར་ནང་སོགས་གཟིམ་ཁང་གསར་བཞེངས་བྱས།",
    "དེ་ནས་རང་དགོན་རྣམས་སུ་སོས་དལ་གུ་ཡངས་ཀྱིས་བཞུགས་སྐབས།",
    "ཚེ་སྟོད་འཇིག་རྟེན་གྱི་བྱ་བ་གང་བསྒྲུབས་ལ་འགྱོད་བཤགས་དང་།",
    "འདི་ཕྱིའི་བློ་སྣ་གཏད་དེ་འཇུ་ས་འཆང་ས་གཅིག་པུར་བྱས།",
    "ཤིང་ལུག་ལོའི་དགུ་བའི་ཉ་ལ་རབ་གནས་རྟ་ཐོག་མའི་སློབ་དཔོན་བགྱིས་ཤིང་གཞུང་ནས་རབ་སྟོན་ཀྱང་རྒྱས་པ་བྱས།",
    "སྒར་བའི་ཁྲ་མ་རྣམས་རྒན་པ་ལས་སྣེ་རིམ་ཁུར་གྱིས་སྤྲོད་ལེན་བྱེད་རྒྱུ་བྱས།",
    "གྲྭ་ཤག་སོ་སོའི་རྟེན་བཞེངས་ལ་མཁོ་བའི་གསེར་ཚོན་ཉོ་སྒྲུབ་སོགས་རྣམ་དཀར་གྱི་ལས་བྱ་གང་བཅོལ་བསྒྲུབས་དང་སྒྲུབ་མུས་སུ་ཡོད་པ་འདི་བཞིན་ལགས་ཏེ།",
    "ཁྱད་པར་རབ་བྱུང་ལོ་ཚིགས་སྔ་ཕྱི་ཡི།",
    "སྐྱེས་སྦྱངས་རིག་པའི་འཕྲུལ་ལས་མ་བཏོན་པར།",
    "དམ་པའི་མཛད་པར་དག་སྣང་དད་པའི་མཚོ།",
    "མཛེས་བྱའི་ཕྱིར་ན་གཉིས་བྱུང་ཞེས་གསུངས་ལྟར།",
