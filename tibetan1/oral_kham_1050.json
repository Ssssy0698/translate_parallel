    "ཇི་སྲིད་དུ་ཁྱིམ་པ་འདུག་པ་ལ་བསྒོསབར་བྱེད་པ་དེ་སྲིད་དུ་དེའི་ལྷུང་བཟེད་དང་།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མི་སྒོ་ན་ཞེས་བྱ་བ་ནི་དེ་ན་ཁྱིམ་པ་གང་འདུག་པ་ལའོ།",
    "དེས་ཀླུ་ཆེན་པོའི་ལུས་ཀྱིས་རིའི་རྒྱལ་པོ་རི་རབ་ལ་ལན་བདུན་དཀྲིས་ཏེ་སྟེང་དུ་གདེངས་ཀ་ཆེན་པོ་བྱས་ཏེ་འདུག་པ་དང་།",
    "དེ་གཉིས་ཀྱི་མདུན་དུ་འདུག་སྟེ་སྨྲས་པ།",
    "ཁམས་དང་རང་བཞིན་ཐུགས་སུ་ཆུད་ནས་གང་ཐོས་ན།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་ཀོ་ས་ལར་བྱུང་བའི་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་སྐབས་དེ་བཅོམ་ལྡན་འདས་ལ་རྒྱས་པར་གསོལ་པ་དང་།",
    "རྣམ་ཐོས་ཀྱི་བུ་ལ་ནོར་གྱིས་འགྲན་པ་ཞིག་འདུག་སྟེ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས།",
    "ཡང་ན་ནི་ཕྱག་སྦལ་ན་འདུག་ཤིག།",
    "ཕྱག་སྦལ་དུ་འདུག་གོ།",
    "ཀྭའི་ནང་རྗེ་དེ་ན་མི་གཙོ་བོ་གངསའདུག།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཀོ་ས་ལར་བྱུང་བའི་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་ཀོ་ས་ལར་བྱུང་བའི་རྒྱལ་པོ་གསལ་རྒྱལ་གྱིས་ཚེ་དང་ལྡན་པ་འཆར་ཀ་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་འཆར་རྗོཀས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "སྒོ་བ་སྐྲག་ནས་ཅང་མི་སྨྲ་བར་འདུག་པ་དང་།",
    "མཐའ་གཅིག་ཏུ་འདུག་གོ།",
    "ལྷ་རྒྱལ་པོ་དེ་ནི་བདག་ཉིད་ཆེན་པོ་ཞིག་ལགས་ཞེས་གདའ་བས་དེས་ལྷའི་ཞལ་སྔར་སྐྱེས་ངན་ངོན་ཞིག་བསྐུར་བར་རྔོ་མི་ཐོག་པས་ཇེ་བརྟགཤེཔར་བགྱིས་ཏེ།",
    "དེས་ཀྱང་ཐོས་ནས་མཆི་མས་བརྣངས་ཏེ་འདུག་གོ།",
    "རབ་འབྱུང་ཁྱིམ་ན་འདུག་མི་བྱེད།",
    "འདི་ལྟར་འདི་གཉིས་ཀྱིས་ངའི་མིག་སྔར་འདུག་པར་མི་བྱའོ་ཞེས་དེ་གཉིས་ཀྱི་སྒོ་བཟློག་ནས་སྐྱོན་ཆགས་པ་གཞན་གཉིས་ཤིག་བློན་པོར་བསྐོས་པ་དང་།",
    "ལྷ་རྒྱལ་པོ་བགྲེས་པོ་བྱོན་པར་འགྱུར་རོསྙིཞེས་གདའོ།",
    "ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོས་དེ་ཐོས་ནས་མཆི་མས་བརྣངས་ཏེ་འདུག་གོ།",
    "ཇི་ཙམ་དུ་རི་བྲགས་ཤིག་ན་རྔོན་པ་ཞིག་འདུག་སྟེ།",
    "ལོ་མ་རྙེགས་པ་དག་བླངས་ཏེ་འདུག་ནས་ཟས་ཀྱི་བྱ་བ་བྱས་ཏེ།",
    "རྐང་པ་གཉིས་བཀྲུས་༧ཏེ་ཤིང་དྲུང་ཞིག་ཏུ་བརྟེན་ནས་བྲང་འགྲོའི་རྒྱལ་པོ་ཉལ་བའི་ལུས་བསྐྱིལ་བ་ལྟར་སྐྱིལ་ཀྲུང་༧བཅས་ཏེ་སྤྱོད་ལམ་ཞི་བར་འདུག་པ་དང་།",
    "དགེ་སློང་དག་སྔོན་བྱུང་བ་རི་བྲགས་ཤིག་ནཏུཁྱིམ་བདག་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "ལོངས་སྤྱོད་ཆེ་བ་ཞིག་འདུག་པ་དེའི་ཁྱིམ་རྒྱལ་པོ་ཤར་པའི་དྲུང་ན་འདུག་ཅིང་དེ་ནང་པར་སྔར་ལངས་ཏེ་ལས་ཀྱི་མཐའ་དག་ལ་རྟོག་ཏུ་འགྲོའོ།",
    "ཇི་ཙམ་དུས་གཞན་ཞིག་ན་རྒྱལ་པོ་ཤར་པ་དོན་གྱི་གནས་ན་འདུག་པས་བློན་པོ་རྣམས་ལ་སྨྲས་པ།",
    "རྒྱལ་པོས་ཉེ་བར་འཚོ་བ་སྔ་ནཤེའཁོད་པ་དག་ཀྱང་དེ་དང་ལྷན་ཅིག་ཕྱིར་བྱུང་སྟེ་རྒྱལ་པོའི་ཚོགས་མེད་པར་འདུག་པ་དང་།",
    "ཤེས་ལྡན་དག་དེང་ཤིག་དང་འདི་ནས་ཧ་ཅང་མི་རིང་བ་ན་རྫིང་བུ་ཞིག་ཡོད་པ་དེའི་འགྲམ་ན་ཤིང་སྔོན་པ་ཞིག་ཡོད་པ་དེའི་དྲུང་ན་འབྲས་ཆན་གྱིས་བྲེ་བོ་གང་ཞིང་འདུག་པ་དེ་ལས་ཟོས་ཤིང་འཐུངས་ནས་བཟའ་བ་དང་བཏུང་བ་ཅི་འདོད་པ་ཁྱེར་ཅིག།",
    "ངུར་པས་མཛེས་པར་བྱས་པ་ཞིག་འདུག་པ་དེའི་འགྲམ་ན་ཤིང་སྔོན་པ་ཞིག་འདུག་པ་དེའི་དྲུང་ན་འབྲས་ཆན་ཚོད་མ་སྣ་ཚོགས་དང་བཅས་པས་གང་བ་ཞིག་འདུག་པ་མཐོང་ནས།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཁྱིམ་བདག་མགོན་མེད་ཟས་སྦྱིན་གྱིས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་ཚེ་དང་ལྡན་པ་སྐུལ་བྱེད་ཆེན་པོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཡོངས་སུ་གཟུང་༧བ་ཡངས་ཤིང་རྒྱ་ཆེ་བ་ཞིག་འདུག་པ་དེས་མཛོད་པ་བོས་ཏེ་སྨྲས་པ།",
    "སྟོང་ཐུབ་མཚམས་ཀྱི་བར་ན་མིའདུག་ཅིང་དེ་དོན་མཐུན་ཡུལ་ཀོ་ས་ལ་ནས་འོང་བ་གང་ཡིན་པ་དེའི་བསེལ་ཡང་བྱེད།",
    "ཁྱིམ་དུ་ཞུགས་ནས་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "དེ་ལྟ་ན་ཡང་དེསཅང་མི་སྨྲ་བ་ཁོ་ནར་འདུག་གོ།",
    "ཆུང་མས་དེ་ལཀྱིལན་གསུམ་གྱི་བར་དུ་དེ་སྐད་སྨྲས་ཀྱང་དེསཅང་མི་སྨྲ་བ་ཁོ་ནར་འདུག་ནས་ཡང་ཆུང་མས་སྨྲས་པ།",
    "ཁོ་བོ་ཇི་ལྟར་ལག་པ་ལ་འགྲམསཔ་གཏད་དེ་སེམས་ཁོང་དུ་༧ཆུད་ཅིང་མི་འདུག་ཏུ་རུང་།",
    "སེམས་བསྡུས་ཏེ་བག་ཡོད་པར་རྟོག་ཅིང་འདུག་གོ།",
    "དེ་ཕྱོགས་གང་ན་འདུག།",
    "གལ་ཏེ་མི་འདོད་ན་འདི་ཉིད་དུ་འདུག་ཤིག་དང་ཟས་དང་གོས་ཀྱིསལྒེམཁོ་བ་བསྟབཤེཔར་བྱའོ།",
    "དེ་དེ་ཉིད་དུ་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་པ་དང་།",
    "འདུག་པའི་མཚན་མ་ཡིད་ལ་གྱིས་ཤིག།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ལྷའི་བུ་ལག་བརྒྱུད་འབྲོག་གནས་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
