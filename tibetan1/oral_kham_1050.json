    "མ་བསྒོ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་མི་འདུག་པར་བསླབ་པར་བྱའོ།",
    "དེ་སྟན་དེ་ཉིད་ལ་གྱ་ཚོམ་དུ་འདུག་པ་དང་།",
    "སྟན་ལ་མ་བརྟགས་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་མི་བྱ་བར་བསླབ་པར་བྱའོ།",
    "དེ་ཁྲིའུ་དེ་ཉིད་ལ་ལུས་ཐམས་ཅད་ཀྱི་༧ལྗིད་ཀྱིས་ཕབ་སྟེ་འདུག་པ་དང་།",
    "ལུས་ཐམས་ཅད་ཀྱི་༧ལྗིད་ཀྱིས་མི་དབབ་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "རྐང་པ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "བརླ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "ལོང་བུའི་སྟེང་དུ་ལོང་བུ་མི་གཞག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "རྐང་པ་མི་དགུག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "རྐང་པ་མི་གདང་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "དེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་༧མི་གཏོར་བར་བསླབ་པར་༧བྱའོ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བསླབ་པར་བྱ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "ཇི་ཙམ་ན་མི་གཙང་བའི་དྲི་བྲོ་ཙོནས་དེ་ཙོལག་པ་འགྲམ་པ་ལ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་དང་།",
    "ཇི་ཙམ་ན་ལྡུམ་ཐམས་ཅད་མི་གཙང་བས་གཏོར་ཅིང་ཝས་ཀྱང་ཟོས་ཏེ་ཟོང་དུ་མི་རུང་བར་མཐོང་ནས་དེ་ལག་པ་འགྲམ་པ་ལ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་དང་།",
    "འདི་ཇི་ལྟར་འོང་བའི་སྟངས་ལས་ན་འདིས་བདག་ཟན་གཅོད་པར་བྱེད་དོ་སྙམ་དུ་རིག་ནས་དེ་ཤིང་ལྗོན་པ་དེ་ལས་བབས་ཏེ་༧འདུག་གོ།",
    "དགེ་སློང་དེ་ཤིང་ལྗོན་པ་ལ་མི་གང་ཙམ་དུ་འཛེགས་ཏེསྙིའདུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་འཛེགསལྒེཔར་མ་གནང་བས་ཇི་ལྟར་མཐོར་འཛེག་སྙམ་ནས་དེ་དེ་ཉིད་དུ་འདུག་པ་དང་།",
    "སྣར་ཞོལ་འདུག་གཡུང་པེ་དེའི་དཀྱིལ།",
    "༣༡ སྣར་ཞོལ་འདུག་གཡུང་ཐོ་བཙམས་ལི་པེ་སྣར་ཅོ་ཐོ་བརྩམས།",
    "༩༨ གཡུང་པེ་འདུག་སྣར་རྣམས།",
    "སྣར་ཁོངས་སུ་ཆུད་ཅིང་འདུག་༢༤ཉུ་སྣར་ཞོལ་ཀྱི།",
    "ཞོལ་སྒྲོག་གཡུང་རང་།",
    "༤༧༩ སྣར་ལྟ་ཅིསྨོས་འདུག་པར་ཤེས་པ།",
    "གཡུང་རང་།",
    "གཡུང་པེ་འདུག་གཡུང་ལི་པེ་ཅོ་ཀྱིས།",
    "བཞུགས་པ་ནི་འདུག་པའོ།",
    "དེ་ལྟར་འདུག་པ་དེ་ཡང་དེ་དག་བདག་མེད་པ་གཉིས་སྟོན་པའི་བདག་ཉིད་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉན་པའི་འོས་སུ་གྱུར་པ་ཡིན་ནོ།",
    "སྒོར་འདུག་པ་བདེན་ནམ་ཞེས་བྱ་བའི་བར་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་འཇམ་དཔལ་དབྱངས་ལ་འདྲི་བའོ།",
    "མུན་རུམ་གྱི་ནང་ན་བུམ་པ་ལ་སོགས་པ་འདུག་པ་བཞིན་ནམ།",
    "གནས་པ་ཞེས་བྱ་བ་ནི་འདུག་པ་སྟེ།",
    "དེ་ལ་དམིགས་ཤིང་འདུག་ཅེས་བྱ་བའི་བར་དུ་ཡིན་ནོ།",
    "སྤྱིའམ་བློ་ལ་གཟུགས་བརྙན་དུ་འདུག་པ་ཞིག་ཡིན་གྲང་།",
    "དུས་ཐམས་ཅད་དུ་ཆ་ཤས་དང་བཅས་པར་འདུག་པ་ཡིན་ནོ།",
    "ཡོན་ཏན་གང་དག་ཡིན་པ་གཉེན་པོ་གོམས་པ་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པར་འགྱུར་བ་སྟེ།",
    "སྒྲའི་དོན་མེད་དུ་ཟིན་ཀྱང་རང་བཞིན་ལ་གོ་འགལ་བ་ཅི་ཡོད་ཅེ་ན།",
    "ཞི་བ་འདི་གཉིས་ཀྱི་ནང་ན་ཤིན་ཏུ་ཞི་བར་འདུག་པ་ཡིན་ནོ་ཞེས་བྱ་བས་ནི་འདི་ཞི་བ་ཉིད་དུ་ངེས་པ་དང་།",
    "འདུག་གོ་ཞེས་བདག་རྣམ་པར་རྟོག་པར་གྱུར་ན།",
    "ཕྱི་མའི་མཐར་འདུག་པ་མ་ཡིན་ན་སྔོན་གྱི་མཐའ་ནས་མ་ཡིན་ཞེས་བྱ་བ་དེ་རིགས་པ་མ་ཡིན་ནམ།",
    "མ་བགྱིས་པ་ནས་མ་འགགས་པའི་བར་ནི་མཉམ་པ་ཉིད་དུ་འདུག་པ་ཡིན་ཏེ།",
    "བར་དུ་ཞེས་སྨོས་པས་ཐོག་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཉིད་ལ་སོགས་པའི་རྣམ་པ་རྣམས་གཟུང་ངོ།",
    "རྟག་པར་དུས་ཐམས་ཅད་དུ་འདུག་པའི་ངོ་བོ་ལ་བྱེད་པ་མེད་དོ་ཞེས་སྦྱར་རོ།",
    "གཞན་ཡང་རུང་བ་དེ་བཞིན་གཤེགས་པ་དེ་བཞུགས་པ་དེར་དགའ་བ་དང་གུས་པ་བསྐྱེད་ནས་ཕྱོགས་དེར་མངོན་དུ་བལྟས་ཏེ་འདུག་པར་བྱའོ།",
    "འོན་ཀྱང་དེ་དག་ལ་འདི་སྐད་ཅེས་ཡོན་ཏན་བསམ་གྱིས་མི་ཁྱབ་པ་ཡོངས་སུ་བསྒྲགས་པ་འདི་ཡང་དག་པར་ཟུང་ལ་འདུག་ཅིག་དང་ཞེས་བྱ་སྟེ།",
    "ཡང་ན་ཡིད་མ་གཏོད་ཅིག་ཅེས་བྱ་བ་ནི་མཉན་ཏོ་སྙམ་དུ་དེ་ལྟར་མ་འདུག་ཅིག་ཅེས་བྱ་བ་ཡིན་ནོ།",
    "འདི་ནི་འདུག་པ་དང་གོ་བར་བྱེད་པ་གཞིག་ལ་ཡང་སྦྱར་བར་བྱའོ།",
