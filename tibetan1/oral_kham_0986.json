    "ཉལ་ཤོམ་ཁྱིམ་ན་འདུག་འགྲེང་དང་།",
    "བྱ་བ་མ་ཡིན་པ་ལ་ཡང་རང་དགར་འཇུག་པས་རབ་ཏུ་བྱུང་བའི་ཕྱོགས་ལས་ཁྱིམ་པའི་ཕྱོགས་ཀྱི་རྐུན་མ་དང་ལྷན་ཅིག་འགྲོ་བ་སོགས་འབྱུང་ཉེ་བའི་ཕྱིར་རོ།",
    "ཀུན་སློང་རང་ལ་སྤགས་པར་ཤེས་པ་རང་དགར་དངོས་སུ་ཕུལ་བའི་གོང་དུ་འབུལ་ལོང་མེད་པར་སྔ་ཚོམས་སུ་སློང་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་རང་ཉིད་ཀྱི་དོན་དུ་ཐིངས་པའི་སྟན་བྱེད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་ཁེ་སྤོགས་འདོད་པས་རང་ཉིད་ཀྱི་དོན་དུ་སྐྱེད་འདོད་རྒྱུན་མ་ཆད་པ།",
    "ཀུན་སློང་རང་དགར་རང་ཉིད་ཀྱི་དོན་དུ་སློང་འདོད་རྒྱུན་མ་ཆད་པ།",
    "འདུ་ཤེས་མ་འཁྲུལ་བ་ཀུན་སློང་རང་དགར་རྔན་པ་མ་བྱིན་པའམ་འཐག་པ་སྐྱེད་པའི་གནང་བ་མ་ཐོབ་པ་རང་ཉིད་ཀྱི་དོན་དུ་འཐག་པ་སྐྱེད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་རང་དགར་རྙེད་པ་མ་བགོས་པའམ་རྙེད་པ་སྦེད་པ་ལ་མ་གཏད་པར་འཇོག་འདོད་རྒྱུན་མ་ཆད་པ།",
    "འདུག་པའི་གནས་དང་།",
    "ཀུན་སློང་རང་དགར་རྐུ་སེམས་ལས་གཞན་པས་བདག་ཉིད་ལ་བསྒྱུར་འདོད་རྒྱུན་མ་ཆད་པ།",
    "ཀུན་སློང་རང་དགར་བསམ་པ་ཐག་པ་ནས་སྐྱོ་སྔོགས་བྱེད་པའི་ཚིག་སྨྲ་འདོད་རྒྱུན་མ་ཆད་པ།",
    "ཀུན་སློང་རང་དགར་ཚིག་ལྔ་འམ་དྲུག་ལས་ལྷག་པར་སྟོན་འདོད་རྒྱུན་མ་ཆད་པ།",
    "ཉལ་ཤོམ་ཁྱིམ་ན་འདུག་འགྲེང་གཉིས་ལ་ཉལ་པོའི་གེགས་བྱེད་པར་ནུས་པ་ཙམ་དང་།",
    "ཀུན་སློང་རང་དགར་བསྙེན་པར་མ་རྫོགས་པ་དང་ཅིག་ཆར་རམ་དེའི་འཇུག་ཐོགས་སུ་འདོན་འདོད་རྒྱུན་མ་ཆད་པ།",
    "ཤིང་སྐད་ཙ་ན་ལ་སོགས་པ་སྡོང་བུ་བཏབ་པ་ལས་སྡོང་བུ་ཉིད་སྐྱེ་སྡོང་བུའི་ས་བོན་དང་།",
    "ཀུན་སློང་རང་དགར་ས་བོན་ནམ་སྐྱེ་བ་ཉམས་པར་བྱེད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "ཀུན་སློང་གནས་མལ་ཕན་ཕུན་དུ་འགྱུར་བར་བཞག་ནས་དེ་ཉིད་འདུག་པའམ་གཞན་དུ་འགྲོ་འདོད་རྒྱུན་མ་ཆད་པ།",
    "སྦྱོར་བ་དེ་ལྟར་བཞག་ནས་དེ་ཉིད་དུ་འདུག་པའམ་འགྲོ་བར་རྩོམ་པ།",
    "ཀུན་སློང་ནི་དེ་ལྟ་བུའི་གནས་སུ་རྩྭ་དང་ལོ་མའི་གདིང་བ་བཏིང་ནས་དེ་ཉིད་དུ་འདུག་པའི་ཚེ་གནས་ཕན་ཕུན་དུ་གྱུར་པ་རང་དགར་ཡལ་བར་འདོར་བའམ་གཞན་དུ་འགྲོ་འདོད་རྒྱུན་མ་ཆད་པ།",
    "སྦྱོར་བ་དེ་ལྟར་དེ་ཉིད་དུ་འདུག་པའི་ཚེ་གནས་ཕན་ཕུན་དུ་འགྱུར་བ་རང་དགར་ཡལ་བར་འདོར་བའམ་གཞན་དུ་འགྲོ་བར་རྩོམ་པ།",
    "ཀུན་སློང་རང་དགར་སྐྱོད་འདོད་རྒྱུན་མ་ཆད་པའོ།",
    "གང་དུ་འདུག་པའི་གནས་ནི།",
    "གང་ལ་འདུག་པའི་དངོས་པོ་ནི།",
    "སྦྱོར་བ་དེ་ལྟ་བུ་ལ་འདུག་པ་སོགས་བྱེད་པར་རྩོམ་པ།",
    "མཐར་ཐུག་འདུག་པའམ་ཉལ་བའི་བྱ་བ་རྫོགས་པའོ།",
    "གདིང་དང་འབྱུང་ལ་འདུག་དང་གོས་བྱེད་དང་།",
    "དབེན་པར་འདུག་འགྲེང་གཉིས་དང་སྦྱོར་བཅུག་དང་།",
