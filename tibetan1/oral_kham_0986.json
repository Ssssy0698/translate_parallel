    "སྲོག་ཆག་བཅས་དང་ཉལ་སར་འདུག་འགྲེང་དང་གཅེར་བུ་དམག་དང་ནི།",
    "གཉིས་པ་ཉལ་སར་འདུག།",
    "གང་དུ་འདུག་པའི་གནས་ནི།",
    "ཀུན་སློང་རང་དགར་ཉལ་པོ་ཤོམ་པའི་ཁྱིམ་ན་འདུག་འདོད་རྒྱུན་མ་ཆད་པ་སྦྱོར་བ་འདུག་པར་རྩོམ་པ།",
    "ཁ་ཅིག་མཐར་ཐུག་ཉལ་བའམ་འདུག་པ་ཞེས་གསུང་ངོ་ གསུམ་པ་འགྲེང་དང་ཞེས་པ།",
    "ཀུན་སློང་རང་དགར་འགྲེང་འདོད་རྒྱུན་མ་ཆད་པ།",
    "ཚོར་ཡང་རང་ཉིད་སེམས་གཞན་ལ་གཏོད་པ་ལ་སོགས་པ་ལ་ཉེས་བྱས་སོ།",
    "ཀུན་སློང་རང་དགར་མུ་སྟེགས་ཅན་ལ་སྟེར་འདོད་རྒྱུན་མ་ཆད་པ།",
    "དེ་ཡང་རང་ངམ་བསྐོས་པས་མེ་སྦར་བ་དང་།",
    "ཀུན་སློང་རང་དགར་དུས་མ་ཡིན་པར་ཁྲུས་བྱེད་འདོད་རྒྱུན་མ་ཆད་པ།",
    "ཆང་མ་གཏོགས་པའི་བཅས་རྐྱང་དང་རང་བཞིན་ནང་འདོམས་པ་ན་བཅོས་རྐྱང་བསྲུང་བ་དང་།",
    "རང་དགར་མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་སྟེ་ཟ་འདོད་རྒྱུན་མ་ཆད་པ།",
    "གཞན་གྱིས་བསྟབས་ཀྱང་རང་དགར་ཧ་ཅང་བསླངས་པ་དང་།",
    "འདུག་ཤིག་མ་སྨྲ་ཤིག་ཅེས་སོགས་བསྒོ་བའམ།",
    "ཀུན་སློང་རང་དགར་ཚད་ལས་ལྷག་པ་བྱེད་འདོད་རྒྱུན་མ་ཆད་པ།",
    "ཁྲི་བརྩེགས་མའི་སྟེང་དུ་འདུག་པ་རྣམས་ལ་ཉེས་བྱས་སོ།",
    "བདག་ཉིད་གྲོང་ངམ་ལམ་པོ་ཆེ་གང་ཡང་རུང་བ་ན་འདུག་པས་དགེ་སློང་མ་དེ་གཉིས་གང་ཡང་རུང་བ་ན་འདུག་པ་ལ་ངག་མཚན་ཉིད་ལྔ་ལྡན་གྱིས་བསླངས་ཏེ་གནས་གང་ཡང་རུང་བར་ཟ་བར་རྩོམ་པ་མཐར་ཐུག་མགུལ་དུ་མིད་པའོ།",
    "བདག་ཉིད་གྲོང་ན་འདུག་པས་དགེ་སློང་མ་གྲོང་དང་ལམ་པོ་ཆེ་ན་འདུག་པ་ལ་བསླངས་པའི་སོར་བཤགས་གཉིས་དང་།",
    "རང་ཉིད་ལམ་པོ་ཆེ་ན་འདུག་པས་དགེ་སློང་མ་གྲོང་དང་ལམ་པོ་ཆེ་ན་འདུག་པ་ལ་བསླངས་ཏེ་ཟོས་པའི་སོར་བཤགས་གཉིས་སོ།",
    "གཉིས་ག་ལམ་པོ་ཆེའམ་གྲོང་ན་འདུག་པ་ཉིད་དང་།",
    "དགེ་སློང་བདག་ཉིད་གྲོང་དང་ལམ་པོ་ཆེ་ན་འདུག་པས་དགེ་སློང་མ་གྲོང་ངམ་གང་ཡང་རུང་བ་ན་འདུག་པ་ལ་བསླངས་ཤིང་ཐོས་པ་ལ་དངོས་གཞིར་གསུངས་པ་དང་།",
    "དེ་ལྟར་ན་རྒྱ་ཆེར་འགྲེལ་ལ་སོགས་པ་རྣམས་ནས་དགེ་སློང་ལམ་པོ་ཆེ་ན་འདུག་པས་དགེ་སློང་མ་ལམ་པོ་ཆེ་ན་འདུག་པ་ལ་བསླངས་ཏེ་ཟོས་ན་དངོས་གཞི་སྐྱེད་པར་གསུངས་པ་དང་འགལ་བར་སྣང་ཞིང་།",
    "སྦྱོར་བ་ནི་རང་ལ་ཐོད་རྒལ་དུ་བྲིམས་པའམ་རིམ་བཞིན་དུ་བྲིམས་ཀྱང་རང་ལ་ལྷག་པོར་བྲིམས་པ་མ་བཟློག་པར་ཟ་བར་རྩོམ་པ།",
    "ཤམ་ཐབས་ཀྱི་མ་མཐའི་ཁ་མཉམ་པོར་འདུག་པར་མ་བགོས་པ་དང་།",
    "སྐ་རགས་ཀྱི་བར་བར་ནས་འབྲུའི་ཕུར་མ་སྟེ་ཐུམ་བུ་ལྟ་བུར་འདུག་པར་བགོས་པ་རྣམས་ལ་ཉེས་བྱས་ཏེ་བདུན་ནོ།",
    "འདུག་པར་བྱ་བ་དགུ་དག་དང་།",
    "ཁྱིམ་གཞན་དེར་ཁྱིམ་བདག་སོགས་ཀྱིས་མ་བསྒོ་བར་སྟན་ལ་འདུག་པ་དང་།",
    "སྟན་ལ་སྲོག་ཆགས་སོགས་ཡོད་མེད་མ་བརྟགས་པར་འདུག་པ་དང་།",
    "དལ་བུས་མ་ཡིན་པར་གྱ་ཚོམས་སུ་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་ཕབ་སྟེ་འདུག་པ་དང་།",
    "རྐང་པའི་སྟེང་དུ་རྐང་པ་བཞག་སྟེ་འདུག་པ་དང་།",
    "བརླའི་སྟེང་དུ་བརླ་བཞག་སྟེ་འདུག་པ་དང་།",
    "ལོང་བུའི་སྟེང་དུ་ལོང་བུ་བཞག་སྟེ་འདུག་པ་དང་།",
    "རྐང་པ་ཁྲི་ལ་སོགས་པའི་འོག་ཏུ་བཀུག་ཅིང་འདུག་པ་དང་།",
    "བརླ་གཉིས་བཤིབས་ཏེ་བྱིན་པ་དང་རྐང་པ་གཉིས་བར་ཐག་རིང་དུ་སོ་སོར་ཕྲལ་ཏེ་འདུག་པ་དང་།",
    "འདོམས་སྣང་བར་འདུག་པ་རྣམས་ལ་ཉེས་བྱས་ཏེ་དགུའོ།",
    "ལག་པ་ལ་མགྲིམ་པ་བརྟེན་ནས་འདུག་པ་དང་།",
    "བསླབ་པ་རྒན་རིམ་བཞིན་མ་ཡིན་པར་འཁོད་པའི་ཚེ་ཡང་འདུག་པའི་གྲལ་རིམ་བཞིན་མཐར་ཆགས་སུ་ཟས་མ་བླངས་པ་དང་།",
    "གླང་པོ་ཆེ་དང་རྟ་ལས་གཞན་པའི་བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "རང་དགར་རང་ཉིད་འདུག་པའི་ཕྱིར་གྱིས་འཇའ་ལི་ལ་སོགས་པའི་ཁྲིའུ་ཤོམ་དུ་འཇུག་ཅིང་དེ་ལ་འདུག་པ་དང་།",
    "འཐབ་ཀྲོལ་ཅན་ཏེ་སྡིག་གྲོགས་ཡོད་པའི་གནས་སུ་འདུག་པའི་ཕྱིར་འགྲོ་བ་དང་།",
    "ནོར་འདྲ་མེད་པའི་ཚེ་ཤི་བའི་རྫས་གང་ན་འདུག་པའི་མཚམས་ནང་དུ་གཏོགས་པ་ལས་གཞན་པས་བྱིན་གྱིས་བརླབས་པ་དང་།",
    "ནོར་འདྲ་ཡོད་པའི་ཚེ་ནོར་འདྲ་གང་ན་འདུག་པའི་མཚམས་ནང་དུ་གཏོགས་པ་ལས་གཞན་པས་བྱིན་གྱིས་བརླབས་པ་དང་།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སྟོད་པ་དང་།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སྟོད་པ་དང་རྐྱེན་ཡོད་ཀྱང་མུ་སྟེགས་ཅན་དངོས་སུ་འཁོད་པའི་འདུག་གནས་རྣམས་སུ་སྣམ་སྦྱར་མ་བགོས་པར་ཕྱིན་པ་དང་།",
    "སྣམ་སྦྱར་གྱི་སྟེང་དུ་འདུག་པ་དང་།",
    "ཁྱིམ་གཞན་དུ་ཀོ་ལྤགས་ལས་གཞན་པའི་སྟན་ཡོད་བཞིན་དུ་ཀོ་ལྤགས་ཀྱི་ཐགས་མས་རྒྱུས་པའི་ཁྲི་དང་ཁྲིའུ་ལ་སོགས་པ་ཡན་ཆད་ཀོ་ལྤགས་ཀྱི་སྟན་ལ་འདུག་པ་དང་།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་ལ་སོགས་པ་གཞན་དག་ལས་ཚུལ་མ་ཡིན་པས་ཐིལ་གྱིས་གནོན་པ་དང་།",
    "ཟས་ཀྱི་ཕྱིར་དུ་འགྲོ་བ་དང་འདུག་པའི་ཚེ་ཀླག་ཅོར་གྱི་སྒྲ་མ་སྐྱངས་པ་དང་།",
    "ངལ་བསོ་བ་ལ་སོགས་པའི་གནས་དབེན་པར་རང་དང་འཁོན་འཛིན་ཡོད་པའི་གང་ཟག་དང་ལྷན་ཅིག་འདུག་པ་དང་འགྲེང་བ་དང་།",
    "ཁྱིམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "དེ་ཉིད་བཟའ་བཏུང་ལོངས་སྤྱོད་པའི་ཕྱིར་བྱིན་ལེན་བླངས་ཏེ་འདུག་པ་དང་།",
    "རང་ཉིད་དགེ་སློང་གཞན་གྱིས་རྙེད་པའི་དུས་སུ་མགྲོན་དུ་མ་བོས་པར་དེར་བློ་སྔོན་དུ་བཏང་སྟེ་འདུག་པ་དང་།",
    "ལུང་འབོགས་པར་བྱེད་པ་འགྲེང་བ་ན་འགྲེང་བའི་སྤྱོད་ལམ་མ་བསྟེན་པ་དང་ལུང་འབོགས་པར་བྱེད་པ་འདུག་པ་དང་ཉལ་བ་ན་འདུག་པའི་སྤྱོད་ལམ་མ་བསྟེན་པ་དང་།",
    "སྟན་ལ་འདུག་ཏེ་ལུང་ནོད་པའི་ཚེ་སྟན་ཆེས་དམའ་བ་མ་ཡིན་པ་ལ་འདུག་པ་དང་།",
    "གསར་བུས་སྟན་ཆེས་དམའ་བ་ལ་འདུག་སྟེ་ལུང་ནོད་པའི་ཚེ་འབོག་པར་བྱེད་པས་བསྒོ་ཞིང་རྗེས་སུ་མ་གནང་བར་ཙོག་བུ་མ་ཡིན་པའི་སྤྱོད་ལམ་གྱིས་འདུག་པ་ལ་སོགས་པ་ལུང་ཇི་ལྟར་ནོད་བའི་བཅས་པ་ལས་འགལ་བ་དང་།",
    "སྟན་གཅིག་ལ་འདུག་པ་སོགས་དང་།",
    "གསེར་དངུལ་གྱིས་སྤྲས་པ་དྲིལ་བུ་གཡེར་ཁས་བཤིབས་པའི་གོས་ཀྱི་སྟེང་དུ་རྫི་བར་གསོལ་བ་ན་དེའི་སྟེང་དུ་འདུག་པ་སོགས་གནང་པ་ལྟ་བུ་དང་།",
    "རང་གཅིག་པུ་ལས་མེད་ན་སྤྱོད་ལམ་འདུག་ནས་བྱའོ།",
    "ཚུལ་དང་མཐུན་པར་ཙོག་ཙོག་པུར་འདུག་ཅིང་།",
    "ཞེས་ཚུལ་དང་མཐུན་པར་ཙོག་པུར་འདུག་སྟེ་ བཙུན་པ་དགོངས་སུ་གསོལ།",
