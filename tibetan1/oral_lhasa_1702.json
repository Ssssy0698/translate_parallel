    "བརྒྱ་རྩ་བརྒྱད་བརྗོད་པར་བྱའོ།",
    "དེ་ལྟར་བྱས་ན་འགྲུབ་པར་འགྱུར་རོ།",
    "སྔགས་སྟོང་བཟླས་བརྗོད་བྱས་ན་འགྲུབ་པར་འགྱུར་རོ།",
    "འགྲོ་ལ་རིམ་པར་སྟོན་ཕྱིར་སྤྲུལ་པ་རང་བྱུང་སྟོང་གསུམ་སྲེག་པར་མཛད་པ་ཉིད།",
    "གང་མིང་ཐོག་མར་ལག་ན་རྡོ་རྗེའི་གཟུངས་ཞེས་ཀུན་ལ་གྲགས་པར་གྱུར་པ་ཡི།",
    "དེ་ལ་གནོད་སྦྱིན་ཞེས་བྱ་བ་ནི་རི་རབ་ཀྱི་ཐ་མ་ལྕགས་རིས་ཡོངས་སུ་བསྐོར་བའི་རྩེ་ན་གནོད་སྦྱིན་གོས་སྔོན་ཅན་དག་གནས་པ་དེ་དང་རྟགས་མཐུན་པར་བསྟན་པའོ།",
    "འཇིགས་པའི་ང་རོ་ཅན་ཞེས་པ་ནི་ཧ་ཧ་དང་ཧཱུྃ་ཧཱུཾ་དང་ཕཊ་ཕཊ་ཀྱི་སྒྲས་གདུག་པའི་ཚོགས་ཀྱི་ང་རྒྱལ་འཇོམས་ཤིང་སྐྲག་པར་བྱེད་པའོ།",
    "དུག་དང་ང་རྒྱལ་ཕྲོགས་ནས་རྒྱན་དུ་བྱས་པའོ།",
    "ཀླུ་ནག་པོ་སེ་རལ་ཁར་ཐོགས་པ་ཞེས་པ་ནི་ཚངས་པ་ཉིད་ལ་ཡོད་པའི་རྟགས་སུ་གྱུར་པ་དེ་དང་མཐུན་པར་མ་དྲོས་པ་ནག་པོའི་མཐུ་ཕྲོགས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པའི་རང་བཞིན་གྱི་རྒྱན་དང་མཐུན་པར་བྱས་པའོ།",
    "རྔམ་པར་བསྟན་པའོ།",
    "དེས་ནི་གློག་དང་ཐོག་ལ་སོགས་པའི་འཇིགས་པ་རྣམ་པར་འཇིག་པར་བྱེད་པའོ།",
    "ལག་པ་བརྡབས་པའི་སྒྲས་འཇིགས་པར་བྱེད་པ་ཞེས་པ་ནི་ཁྱབ་འཇུག་ལ་སོགས་པ་དྲེགས་པ་ཅན་ཐམས་ཅད་སྐྲག་ཅིང་དངང་པར་བྱེད་པའོ།",
    "ཨ་ལ་ལ་ཞེས་སྒྲོགས་པར་བྱེད་པ་ནི་དྲག་པོའི་ང་རོ་སྟེ།",
    "གདུག་པ་ཅན་རྣམས་སྐྲག་པར་བྱེད་ཅིང་ཟིལ་གྱིས་མནན་པར་བྱེད་པའོ།",
    "དེའི་ཚད་ཀྱི་སྐུ་བསྟན་པ་ནི་འབུམ་ཕྲག་གཉིས་སུ་ཤེས་པར་བྱའོ།",
    "ཀླུ་ཐམས་ཅད་རླག་པར་བྱེད་པ་ཞེས་པ་ནི་ཀླུ་རིགས་བཞིའི་དུག་ཕྲོགས་ཏེ།",
    "སྟོབས་རྣམ་པར་འཇོམས་ཤིང་མ་རུངས་པ་སེལ་བར་བྱེད་པའོ།",
    "གད་རྒྱངས་ཆེན་པོ་སྒྲོགས་པས་ཀུན་དུ་འཁྲུག་པར་བྱེད་པ་ཞེས་པ་ནི་གད་རྒྱངས་ནི་ཧ་ཧ་སྟེ།",
    "གཤིན་རྗེའི་གཟུགས་ཅན་ཞེས་པ་ནི་ཡ་མ་ཞེས་བྱ་བ་སྐྲག་པར་བྱེད་པའོ།",
    "གསུང་བར་འགྱུར་བའི་རིག་སྔགས་འདི་ཉིད་མཆོག་ཡིན་པས་ནི་སྒྲུབ་པ་པོ་རྣམས་ཀྱིས་འདི་བརྗོད་པར་བྱའོ་ཞེས་པའོ།",
    "རིག་སྔགས་ཀྱི་སྦྱོར་བ་ལ་འཇུག་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཨ་དྷི་ཞེས་པ་ནི་ལྷག་པར་རོ།",
    "ཨུཏྠཱ་ད་ན་ཞེས་པ་ནི་ཡུལ་གཞན་དུ་སྐྲོད་པར་བྱེད་པའོ།",
    "ཏདྱ་ཐཱ་ཞེས་པ་ནི་འཆད་པར་འགྱུར་བའི་སྔགས་ཀྱིས་སྐུ་ལ་བསྐུལ་བའོ།",
    "ཏྲཱ་ས་ན་ཡ་ཕཊ་ཅེས་པ་ནི་ལྷ་མ་ཡིན་གྱི་གདོན་མེད་པར་གྱིས་ཤིག་པའོ།",
    "ཀུམྦྷཎྜོ་ཏྠཱ་ད་ནཱ་ཡ་ཕཊ་ཅེས་པ་ནི་སྨྱོ་བྱེད་ཀྱིས་བྱས་པའི་སྟོབས་ཕྲོགས་ཤིག་པའོ།",
    "པྲེ་ཏ་པི་ཤཱ་ཙ་བི་ནཱ་ཤ་ཀ་རཱ་ཡ་ཕཊ་ཅེས་པ་ནི་ཡི་དྭགས་དང་ཤ་ཟའི་ཚོགས་སྐྲོད་པར་བྱེད་པའོ།",
    "ཡཀྵ་ཨ་པསྨུ་ར་བི་ནཱ་ཤ་ཀ་རཱ་ཡ་ཕཊ་ཅེས་པ་ནི་གནོད་སྦྱིན་དང་བརྗེད་བྱེད་ཀྱི་ཚོགས་སྐྲོད་པར་བྱེད་པའོ།",
    "མཱ་ར་ཡ་མཱ་ར་ཡ་ཞེས་པ་ནི་གདུག་པ་ཅན་རྣམས་གསོད་པར་བྱེད་པའོ།",
    "ཁ་ཟས་ལྷག་པར་ཟ་བ་དང་།",
    "དེ་ལ་ཐོག་མར་མཎྜལ་བྱས་ཏེ་འཁོར་ལོ་རྩིབས་བརྒྱད་ཀྱི་ཐིག་བཏབ་ལ།",
    "ཀླུ་བཟློག་པར་འདོད་ན་སྨུག་ཤད་ཀྱི་ལྕུག་མའམ་བལ་པོ་སེའུའི་ལྕུག་མས་བྱའོ་ཞེས་པ་ནི།",
    "དེ་ལ་སྐུད་པ་དཀར་པོ་ལ་མདུད་པ་བརྒྱ་བྱས་ཏེ།",
    "ས་དེ་ཁམ་པའི་གའུ་སྲུབས་མེད་པར་བླུགས་ལ།",
    "པར་བུའི་དཀྱིལ་དུ་བུག་པ་སྨྱུག་མ་ཙམ་ཅིག་ཕུག་སྟེ།",
    "དེའི་ནང་ནས་ཕྱུང་ལ་སྣོད་ཀྱི་ནང་དུ་བླུགས་ལ་ཇག་རྐུན་བྱུང་བའི་དུས་སུ་གཏོར་ན་ལོག་པར་འགྱུར་རོ།",
    "ཁྱད་པར་དུ་རྐུན་པོ་ལ་ནོར་རྫ་ས་གང་ཡིན་པ་ལ་སྔགས་ཁྲོས་པའི་ཤུགས་ཀྱིས་བཏབ་ན་རྐུན་པོ་ལྡོག་པར་འགྱུར་རོ།",
    "དུག་ལ་ནི་རྩྭ་ཀུ་ཤས་བྱབ་པར་བྱའོ་ཞེས་པ་ནི།",
    "ས་ལ་གནས་པའི་གཏེར་དག་སྟོན་པར་འགྱུར་རོ།",
    "བའི་ལྕི་བ་ལ་སོགས་པ་རྣམ་པ་ལྔ་ས་དང་སྦྱར་ལ་ཞི་བའི་ཧོམ་ཁུང་དུ་བྱས་ཏེ།",
    "སྟེང་ན་བུ་ག་བྱས་པ་ལ་ཆུ་བཏང་སྟེ།",
    "སྤྱི་བོ་ལ་སོགས་པར་ཕུར་བ་བྱས་ཏེ་བཏགས་ན་ཡང་འཇིགས་པ་ཐམས་ཅད་ལས་ཐར་བར་འགྱུར་རོ།",
    "གདགས་པ་བྱས་ན་ཡང་ཐར་བར་འགྱུར་རོ།",
    "ཡང་ན་ཆུ་ལ་བསྔགས་ཏེ་སྟེང་འོག་ལ་སོགས་པར་གཏོར་ཞིང་བཏུང་བར་བྱའོ།",
    "བརྒྱ་རྩ་བརྒྱད་བརྗོད་པར་བྱའོ་ཞེས་པ་ནི་གོང་དུ་བསྙེན་པ་རྫོགས་པའི་རྣལ་འབྱོར་པས་ལས་ལ་སྦྱོར་བའི་དུས་སུ་རིག་པ་བརྗོད་པའི་གྲངས་ཀྱི་ཚད་དོ།",
    "དེ་ལྟར་བྱས་ན་འགྲུབ་པར་འགྱུར་རོ་ཞེས་པ་ནི་གོང་དུ་བསྟན་པའི་ལས་ཚོགས་དེ་དག་ལྟར་རོ།",
    "སྔགས་སྟོང་བཟླས་བརྗོད་བྱས་ན་འགྲུབ་པར་འགྱུར་རོ་ཞེས་པ་ནི་ཐ་མའི་ཚད་བསྟན་པ་སྟེ།",
    "ཇི་སྲིད་སྐྱོ་བར་མ་གྱུར་གྱི་བར་དུ་བརྗོད་པར་བྱའོ།",
    "ཇི་སྲིད་མཉེས་བྱས་གཞན་དོན་ལྷག་ལྷས་གནང་བ་བྱིན།",
    "གདུག་པ་འཇོམས་པར་བྱེད་པའི་མཆོག།",
    "བརྗོད་པར་བྱ་བ་དང་།",
    "དེའི་ཕྱིར་གོས་སྔོན་པོ་ཞེས་བྱ་བའི་ལག་ན་རྡོ་རྗེའི་གཟུངས་ཞེས་བྱ་བ་ནི་རྗོད་པར་བྱེད་པའོ།",
    "འཕགས་པ་ལག་ན་རྡོ་རྗེའི་གཟུངས་དང་སྟོབས་དང་མཐུ་ལ་སོགས་པ་གཟུངས་ཀྱི་སྒྲོ་ནས་བསྟན་པ་ནི་བརྗོད་པར་བྱ་བའོ།",
    "བརྗོད་པར་བྱ་བའི་ཕྱིར་རོ།",
