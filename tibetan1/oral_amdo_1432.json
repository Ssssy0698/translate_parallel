    "ཡང་ན་བུད་མེད་ནི་བློ་གཏད་མེད་པ།",
    "འཚོ་བའི་རིན་ཐང་ལྟ་ཚུལ་མང་པོར་ཤན་ཤུགས་ཐེབས་དང་ཐེབས་བཞིན་ཡོད་པ་སྨོས་མེད་རེད།",
    "འོན་ཀྱང་ཞིབ་ཏུ་བསམ་ན་བུད་མེད་དུ་སྐྱེ་བ་ནི་ནོར་འཁྲུལ་ཅིག་མིན་ལ།",
    "འོད་སྣང་གིས་བཅངས་པའི་རེ་བའང་མ་ཡིན་ནམ།",
    "ཕོ་སྐད་སྦོམ་པོར་ཅོ་འདྲི་བའི་མོ་སྐད།",
    "ཟ་མ་མོའི་སྐྱིད་སྡུག་གངས་མ་ཆར་བཀླགས་རྗེས་ཀྱི་དྲན་ཚུལ་ཐོར་བུ།",
    "ཟ་མ་མོའི་སྐྱིད་སྡུག་གངས་མ་ཆར་ཞེས་པའི་དེབ་འདིར་འཁོད་པའི་བསྒྱུར་རྩོམ་ཕུད་བྲིས་རྩོམ་ཕལ་མོ་ཆེ་ཡང་བསྐྱར་ཚར་གཅིག་བཀླགས་ཚར་དུས་ནམ་དཀྱིལ་སྔ་མོ་ནས་གཟུར་ཟིན།",
    "དེབ་ཏུ་གྲུབ་ཚར་རྗེས་སྔོན་གྱི་མ་རྩོམ་བཀླགས་པ་ལས་ཀྱང་ཡག་པའི་ཚོར་བ་ཞིག་ཡིད་ཀྱི་རེ་སྐོང་དུ་བྱུང་ཞིང་།",
    "གཤམ་ནས་རྩོམ་མཁན་ཁོང་མོ་ཐེ་བའི་ཀློག་མཁན་དག་གི་སྤྱན་སྔར་དབུལ་རྒྱུ་ཡིན།",
    "མོ་དང་འབྲེལ་འདྲིས་དང་གླེང་མོ་ཐེངས་མང་བྱེད་པའི་གོ་སྐབས་བྱུང་བས་རྩོམ་མཁན་ཞིག་གི་སྣང་བརྙན་ཡང་བག་ཆགས་ཁྲོད་མངོན་ཡོང་།",
    "ལྷག་ཏུ་ད་རེས་མོས་ཟ་མ་མོའི་སྐྱིད་སྡུག་གངས་མ་ཆར་ཞེས་པའི་དེབ་འདི་པར་སྐྲུན་བགྱི་བའི་གོ་རིམ་ཁྲོད་ཁོ་བོ་ནི་ཀློག་མཁན་ཆེས་ཐོག་མར་གྱུར་པས།",
    "ཕོ་སྐད་ཀྱི་འཇིག་རྟེན་ནས་མོ་སྐད་སྙན་ལྷང་ལྷང་ཞིག་སྒྲོག་པར་སྤོབས་པའི་ལམ་རྒྱགས་ཤིག་དང་ཡིད་ཆེས་ཀྱི་དཔུང་གྲོགས་ཤིག་དབེན་པ་ཡིན་ན་དཀའ་ཙམ་གདའ་སྟེ།",
    "ང་ཚོས་ད་རག་བར་དུ་ཨ་ཡེ་མ་ཡེའི་སྐད་དེ་ཐན་སྐད་དུ་བརྩིས་ནས་ཡོང་བ་ཡིན་པས།",
    "ཁོང་མོ་ཚོ་སྔར་སྲོལ་གྱི་བག་ཆགས་ལས་སད་མ་ཐུབ་པའམ།",
    "ཡང་ན་སད་ཀྱང་སྔར་སྲོལ་གྱི་ལྕགས་སྒྲོག་གི་མདུད་རྒྱས་ད་དུང་ཡང་ཁོང་མོ་ཚོའི་ལུས་ངག་ཡིད་གསུམ་གློད་ཡག་མིན་པས།",
    "ཁོང་མོ་ཚོའི་ཁྲོད་ན་མི་སྨྲ་བའི་བརྟུལ་ཞུགས་མཐུད་དེ་དང་དུ་ལེན་མཁན་མང་ཤོས་ཤིག་ཟིན་འདུག་པ་རེད།",
    "རང་གི་འཕག་འཚག་དང་རང་གི་ཤེད་ཤུགས་ལ་བརྟེན་ནས་དུམ་བུར་བཅད་ཅིང་རྒྱབ་ཏུ་གཡུག་ནས་སྤོབས་པ་ཆེར་བདོག་གིས་གོམ་པ་གཞུང་ལམ་གྱི་ཕྱོགས་སུ་བསྒྱུར་པ་ནི།",
    "རང་རང་གི་ན་གཞོན་གསར་པ།",
    "བོད་མོ་ཞེས་པའི་ཡུན་རིང་བོར་ངག་ལྐུགས་ནས་ལུས་པའི་ཚོགས་སྤྱི་གང་དེའི་གོམ་པ་ཆེན་པོ་གང་མདུན་དུ་སྤོ་ཐུབ་པ་གདོན་མི་ཟ།",
    "མ་མཐའ་ཡང་ང་ཚོའི་ཁྲོན་པ་ལྟ་བུའི་འཇིག་རྟེན་ཆུང་ངུ་འདི་སྐད་སྒྲ་སྣ་གཅིག་གིས་སྒེར་དུ་མ་བཟུང་བར།",
    "དྲག་ཞན་བར་མ་ཅི་ཡང་གྲག་རྒྱུ་ཡོད་པས་གང་ནི་སྙན་པོ་དང་གང་ནི་རྩུབ་མོ་ཡིན་པ་ད་གཟོད་ངང་གིས་ཤེས་ཐུབ་པ་མ་ཡིན་ནམ།",
    "ཁོང་མོའི་དེབ་འདིར་འཁོད་པ་དག་ནི་ང་ཚོའི་འཚོ་བའི་བར་གསེང་དག་ཏུ་རྒྱུན་པར་མཐོང་ཞིང་ཕྲད་པའི་སྣང་ཚུལ་རྒྱུན་ལྡན་པ་དག་ཡིན་ཀྱང་།",
    "ཆེད་དུ་ཞིབ་འཇུག་ནི་ལྷག་ཏུ་བྱེད་རིན་མེད་པར་རློམ་ནས་བསྒྱུར་བཞག་པ་ཡིན་མོད།",
    "ཁོང་མོ་ཚོའི་སེམས་ངོར་བག་ལ་ཞ་བའི་སྡུག་གི་ཁུར་བོ་དེ་དབོག་པར་མི་ནུས་ཀྱང་།",
    "སེམས་ཁྲལ་ཞིག་གིས་སྐྱེས་མ་རྣམས་ལ་བཀུར་བསྟི་དང་།",
    "ཁོང་མོ་ཚོའི་རྡུལ་ནག་གི་རླངས་པ་འཕྱུར་བའི་བསམ་པའི་འཇིག་རྟེན་དུ་འགྲུལ་བཞུད་ཀྱི་ཁ་ལོ་བསྒྱུར་དགོས་བྱུང་སོང་།",
    "རྩོམ་མཁན་འཇམ་དབྱངས་སྐྱིད་ཀྱིས་བྲིས་པའི་བུད་མེད་དང་འབྲེལ་ཡོད་ཀྱི་སྣང་ཚུལ་ཁ་ཤས་དང་བུད་མེད་ཀྱི་གཉའ་བཅག་པའི་མཐའ་འབྲས་ནམ་ཞིག་ང་ཡང་སྨྱོས་འདུག་མི་ཟེར་རམ་སོགས་ལས་མཐོང་བའི་གནས་ཚུལ་དང་གནས་ལུགས་དག་ནི་དངོས་འབྲེལ་སྐྱེས་པ་ཕོ་རྣམས་ཀྱི་སྣང་ངོར་དོན་དག་ཆུང་ཆུང་ཞིག་ཏུ་མཐོང་ལས་ཆེ་མོད།",
    "འཁྱོག་པོའི་བློ་སྤང་ཏེ་གཟུ་བོར་དཔྱད་པ་ཡིན་ན།",
    "དེ་དག་ནི་མི་རིགས་ཤིག་གི་རེ་བ་དང་མ་འོངས་པར་ཐད་ཀར་འབྲེལ་བ་དམ་ཟབ་ཡོད་པའི་དོན་དག་ཆེན་པོ་དག་དག་ཡིན་པ་སེམས་པ་རྨོངས་པས་ཟིན་པ་མིན་ན་འཕྲལ་མ་ཉིད་དུ་ཤེས་རྟོགས་འབྱུང་སྲིད་ལ།",
    "ང་ཚོས་ཆུང་ཆུང་དུ་བརྩི་བའི་དོན་དག་འདི་དག་གི་འགག་རྩ་ལ་ངེས་ཤེས་གསར་དུ་རྙེད་སྲིད་དོ།",
    "དེ་ལ་དཔེ་བརྗོད་རེ་བཞག་ཚེ།",
    "ང་ཚོས་ཀྱང་ཁོང་མོ་ཚོར་བརྩི་བཀུར་གང་ལེགས་བྱས་ཏེ།",
    "ཁོང་མོ་ཚོའི་བློ་རིག་དང་།",
    "མི་རིགས་ཤིག་གི་བློ་སྦྱོང་དང་འབྱུང་སྤུས་ཀྱང་དེ་བཞིན་མཐོ་རུ་འདེགས་ཐུབ་པ་གནས་ལུགས་ཀྱིས་ར་སྤྲོད་པ་ཡིན།",
    "མི་མོ་རྣམས་ཀྱང་མི་རུ་བཞེངས་ཏེ་མིག་མདངས་གསར་པ་ན་གཞོན་གསར་པ།",
    "ཁྱེད་རང་སྨྱོས་མི་འདུག་ངས་ཁྱེད་ཀྱིས་སྐད་སྙན་ལྷང་ལྷང་སྒྲོག་གིན་པ་ཐོས་བྱུང་།",
    "ང་ཚོའི་མི་མོ་རྣམས་ཀྱི་འཚོ་བའི་བརྙན་རིས་ངོ་མ་བོ་ནི་དེབ་འདིར་འཁོད་པ་བཞིན།",
    "དམའ་འབེབས་སོགས་ཀྱི་ལམ་ཁ་ཞིག་ན་ཉམ་ཆུང་གིས་འདུར་བཞིན་པ་དེ་ལགས་པས།"
  ]
}