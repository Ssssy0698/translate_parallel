    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "སྤྲུལ་པའི་སྐུ་ནི་མོས་པ་སྤྱོད་པའི་སོ་སོའི་སྐྱེ་བོའི་ངོ་གང་ལ་སྣང་བར་འགྱུར་རོ།",
    "ཉོན་མོངས་པའི་ཡིད་གནས་སུ་དག་པ་ནི་མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་སོ།",
    "དང་སྟེང་གི་ཕྱོགས་ཀྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དག་ན།",
    "ཤར་དང་ལྷོ་དང་ནུབ་དང་བྱང་དང་བྱང་ཤར་དང་ཤར་ལྷོ་དང་ལྷོ་ནུབ་དང་ནུབ་བྱང་དང་འོག་དང་སྟེང་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དག་ན།",
    "དེ་དག་བྱམས་པ་ཐོབ་པ་དེས་བྱོལ་སོང་གི་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧སྐྱེ་གནས་ནས་རྣམ་པར་ལྡང་ཞིང་།",
    "བྱོལ་སོང་གི་སྐྱེ་གནས་ཀྱི་འགྲོ་བ་ཞི་བའི་ལས་དང་།",
    "ཤར་དང་ལྷོ་དང་ནུབ་དང་བྱང་དང་བྱང་ཤར་དང་ཤར་ལྷོ་དང་ལྷོ་ནུབ་དང་ནུབ་བྱང་དང་འོག་དང་སྟེང་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དག་ན།",
    "ཤར་དང་ལྷོ་དང་ནུབ་དང་བྱང་དང་བྱང་ཤར་དང་ཤར་ལྷོ་དང་ལྷོ་ནུབ་དང་ནུབ་བྱང་དང་འོག་དང་སྟེང་གི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེད་མ་སྙེད་དག་ན།",
    "བྱང་སེམས་ཆེན་པོ་དེ་དག་ལས་དེ་དག་གིས་ཐོས་དེ་ཐོས་ནས།",
    "སྟེང་གི་བར་གྱི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་གང་ན།",
    "སྟེང་གི་བར་གྱི་ཕྱོགས་ཀྱི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དག་ན་མི་རྣམས་བསྡུ་བའི་དངོས་པོ་བཞིས་སྡུད་པ་མཐོང་སྟེ།",
    "བག་ཆགས་ཀྱི་མཚམས་སྦྱོར་བའི་ཉོན་མོངས་པ་ཐམས་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧ཅད་སྤོང་བ་སྟེ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་མེད་པ་སྟེ།",
    "འདུས་བྱས་སམ་འདུས་མ་བྱས་ཀྱི་ཁམས་རེས་བཅད་ཅིང་འབྲས་བུ་རྣམ་པར་འགོད་པར་མི་བྱེད་དོ།",
    "གསུངས་པའི་དོན་དེ་བདག་གིས་ཅི་ལྟར་འཚལ་བར་བགྱི།",
    "ཀུན་ནས་ཉོན་མོངས་བཅས་པ་ཡི་ རྣམ་པར་བྱང་བ་རྟོགས་པ་དང་།",
    "དེའི་རྗེས་ལ་རང་གི་དོན་འཁོར་གསུམ་རྣམ་པར་དག་པས་རབ་ཏུ་ཕྱེ་བའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ལ་གོམས་པ་ལ་དགོད་དོ།",
    "དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུ་སྒྲུབ་པ་དེ་དག་གི་ལེགས་པ་བརྗོད་ཅིང་མཐུན་པས་དགའ་བར་སྤྱོད་པ་ཡིན་ཞེས་པའི་དོན།",
    "བདག་གིས་གཟུགས་ལ་སྤྱད་པར་བྱའོ་ཞེའམ།",
    "བདག་དང་བདག་གིར་བྱ་བ་མེད་དེ་ཞེས་པ་ནས།",
    "རང་གིས་སྟོང་པའོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པར་ཡང་དག་པར་རྗེས་སུ་མཐོང་བས།",
    "རབ་འབྱོར་གང་ཁྱོད་ཀྱིས་འདི་སྐད་དུ།",
    "བཟོད་པ་བསྒོམ་མོ།",
    "བརྩོན་འགྲུས་བརྩམ་མོ།",
    "ཤེས་རབ་བསྒོམ་མོ།",
    "སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་ངེས་ཞེས་བགྱིའམ།",
    "སྲིད་པ་གཅིག་གིས་ཐོགས་པ་ནི་ངེས་པའོ།",
    "ངེས་པའི་བྱང་སེམས་ཆེན་པོ་ནི་ངན་སོང་རྣམས་སུ་སྐྱེ་བར་མི་འགྱུར།",
    "རབ་འབྱོར་ངས་བྱང་སེམས་ཆེན་པོ་ནི་ངན་སོང་དུ་མི་སྐྱེའོ།",
    "འདི་བྱང་སེམས་ཆེན་པོས་གང་རེག་པར་བྱེད་པ་དང་།",
    "གང་གིས་རེག་པར་བྱ་བ་དང་།",
    "སྟོང་པ་ཉིད་ཀྱང་རེག་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "རབ་འབྱོར་རྣམ་གྲངས་དེས་ན་ཁྱོད་ཀྱིས་འདི་ལྟར།",
    "རབ་འབྱོར་འདི་ལ་བྱང་སེམས་ཆེན་པོ་ཡུམ་ལ་སྤྱོད་པའི་ཚེ་ཕྱོགས་བཅུའི་ཕྱོགས་རེ་རེའི་འཇིག་རྟེན་གྱི་ཁམས་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་པོ་དེ་དག་ཐམས་ཅད་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་ངོ།",
    "བདག་གིས་ཤེས་རབ་བསྒོམ་མོ།",
    "འདིའི་དོན་དུ་ཤེས་རབ་སྒོམ་མོ་ཞེས་གསུམ་པོ་དེ་དག་ལ་མི་རྟོག་པ་སྟེ།",
    "འདིའི་དོན་དུ་དེ་རྣམས་སྒོམ་མོ་ཞེས་གསུམ་པོ་དེ་དག་ལ་མི་རྟོག་པ་སྟེ།",
    "བདག་མེད་པ་ལ་བདག་གི་འདུ་ཤེས་སུ་གྱུར་པ།",
    "དེ་ལ་གང་ལ་ལ་ཞིག་ཀུན་ནས་ཉོན་མོངས་པའམ་རྣམ་པར་བྱང་བར་འགྱུར་བ་ཡོད་དམ།",
    "ཅི་ལྟར་ཀུན་ནས་ཉོན་མོངས་པའམ་རྣམ་པར་བྱང་བར་འགྱུར་བ་མེད་པ་བཞིན་དུ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་ཡང་མེད་དོ།",
    "ཡང་དག་པར་མཐོང་བ་ནི་ཀུན་ནས་ཉོན་མོངས་པའམ་རྣམ་པར་བྱང་བར་འགྱུར་བ་མེད་དོ།",
    "ཅི་ལྟར་ཡང་དག་པ་མཐོང་བ་ལ་ཀུན་ནས་ཉོན་མོངས་པའམ་རྣམ་པར་བྱང་བར་འགྱུར་བ་མེད་པ་དེ་བཞིན་དུ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་མེད་དོ་ཞེས་སོགས་ཀྱི་དོན།",
    "ཡང་དག་པ་ལ་ཀུན་ནས་ཉོན་མོངས་པར་འགྱུར་བའམ་རྣམ་པར་བྱང་བར་འགྱུར་བ་ཡང་མ་མཆིས་དེ་བཞིན་དུ།",
    "ཡང་དག་པ་མ་མཐོང་བ་ལ་ཡང་ཀུན་ནས་ཉོན་མོངས་པའམ་རྣམ་པར་བྱང་བར་འགྱུར་བ་མ་མཆིས་ཏེ།",
    "དངོས་པོ་མ་མཆིས་པ་ལ་ཀུན་ནས་ཉོན་མོངས་པའམ་རྣམ་བྱང་མ་མཆིས་ཏེ།",
    "ངོ་བོ་ཉིད་ལ་ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་མ་མཆིས་པ་སྟེ།",
    "དངོས་པོ་མ་མཆིས་པའི་ངོ་བོ་ཉིད་ལ་ཀུན་ནས་ཉོན་མོངས་པ་དང་རྣམ་པར་བྱང་བ་མ་མཆིས་ན།",
    "དངོས་པོ་མ་མཆིས་པ་རྫས་མ་མཆིས་པ་ལ་བདག་གིས་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་པ་ནས།",
    "ལ་ལ་ནི་ཉོན་མོངས་པས་སྤྲུལ་པའོ།",
