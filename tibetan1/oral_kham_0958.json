    "མཉམ་མེད་ཆེན་པོ་རྣམས་དམྱལ་ཟངས་སུ་འཚེད་པའི་བྲིས་ཐང་བཞེངས་ཤིང་ཕྱོགས་དུ་མར་བཀྲམ་ནས་ཁམས་ཕྱོགས་ཀྱི་བླུན་པོ་རྣམས་ཀྱི་བློ་བསྒྱུར་བའི་ཐབས་བཤམས་པའང་བྱུང་འདུག་སྟེ།",
    "དེའི་ལྷ་ཡིན་ན་འཇིག་རྟེན་པ་ལོས་ཡིན་སྙམ་པའི་ཧམ་འགྲོས་ཀྱི་འཆལ་གཏམ་སྟེ།",
    "ཟླ་བ་དཀར་ཡང་མུན་པའི་ཞད་ཡོད་ཟེར་བ་དེར་གདའོ།",
    "བྱིས་པ་ཅོལ་ཆུང་རང་ཉིད་བསླུས་པར་ཟད།",
    "ཕལ་ཆེར་དོན་སྤྱི་ལྡོག་ནས་ཤན་ཕྱེད་ཀྱང་རང་ལྡོག་ཕན་ཚུན་ཤན་འདྲེས་ནས་གཟུགས་བརྙན་ལ་དོན་དངོས་སུ་འཁྲུལ་ནས་ལམ་ཞུགས་རྣམས་མགོ་རྨོངས་པའང་མང་དུ་སྣང་བས་སོ་སོར་རྣམ་པར་ཕྱེ་ན།",
    "ལར་བོད་རྣམས་ཀྱི་མཆུ་ལ་རྫི་བོ་མེད་པ་འདི་ཅིས་ཀྱང་སྟངས་ཞན་འདུག་གོ།",
    "གུ་རུ་རྡོ་ཙེ་དང་གུ་རུ་རྣོན་རྩེ་གཉིས་གཅིག་ཡིན་ཟེར་བ་སྣང་ཡང་མིན་པར་འདུག་གོ།",
    "ངོ་བོ་ཀ་དག་དང་རང་བཞིན་ལྷུན་གྲུབ་ཀྱི་ཉམས་ལེན་རྗེན་པར་སྟོན་པ་ཁྲེགས་ཆོད་དང་ཐོད་རྒལ་གྱིས་བསྡུས་པའི་རྫོགས་ཆེན་གྱི་མན་ངག་རྣམས་ཏེ།",
    "གདུལ་བྱ་རང་རང་སྣང་ངོ་རུ།",
    "དེ་ལྟར་ཡིན་པར་གདའ་སྟེ་སྡོམ་པས་རང་རྒྱུད་བསྡམས་ན་ལེགས་ཚོགས་ཡོན་ཏན་ཐམས་ཅད་ཀྱི་གཞི་རྟེན་ཡིན་པས་ས་ལམ་གྱི་ཡོན་ཏན་ཐམས་ཅད་རིམ་གྱིས་རྫོགས་པ་དང་།",
    "མངོན་རྟོགས་ལམ་རིམ་རྩ་བ་དང་རང་འགྲེལ།",
    "གཞན་དོན་རྒྱ་ཆེན་པོ་ཞིག་སྒྲུབ་པར་མ་ནུས་ན་ཐབས་གཏན་ནས་མི་འདུག་སྙམ་དུ།",
    "ཐོག་མར་ལམ་ཞུགས་ཀྱིས་བགྲོད་བྱའི་ལམ་ལ་དབྱེ་ན་ཚོགས་སྦྱོར་མཐོང་འདུག་སྒོམ་མི་སློབ་པའི་ལམ་ལྔ་དང་།",
    "འོ་ན་ཅིས་ཀྱང་ལེགས་པར་གདའ་བས་ལེགས་པར་སྨོས་ཤིག་ཀྱེ་རིགས་པར་སྨྲ་བ།",
    "སྡོམ་པའི་ངོ་བོ་གནས་འགྱུར་བས་རིགས་གཅིག་ཀྱང་རང་ལྡོག་ཐ་དད་དུ་འདོད་པས་དགག་དགོས་བརྩི་ནས་བསྲུང་དགོས་པར་འདོད་ཟེར་ན།",
    "བསྟན་པ་ཐམས་ཅད་འགལ་མེད་དུ་སྤྱོད་པ་བསྟན་འཛིན་དམ་པ་རྣམས་ཀྱི་ཕྱག་ལེན་ཡིན་པས་ཁྱེད་ཀྱིས་རིང་ལུགས་དེ་ལྟར་སྤྱོད་པ་ལེགས་པར་གདའ་བས་རྗེས་སུ་ཡི་རང་ངོ།",
    "རིང་ལུགས་ཁུངས་བཙུན་ཡིན་འདུག།",
    "སྐུ་གསུང་ཐུགས་རྟེན་མང་པོ་སྣང་བས་སྔོན་ནས་བོན་དར་མྱོང་བར་གདའ།",
    "རྒྱུ་འབྲས་སྤྱི་དང་རང་སྐལ་ལམ་གྱིས་མངོན་མཐོ་ངེས་ལེགས་ཕན་བདེའི་དཔལ་ལ་དངོས་དང་བརྒྱུད་ནས་དགྱེས་རྒུར་རོལ་བས་གནས་སྐབས་ཀུན་ཏུ་ཉེར་འཚོ་བ།",
    "སྡོམ་པའི་ངོ་བོ་གནས་འགྱུར་ནས་རིགས་གཅིག་ཀྱང་རང་ལྡོག་ཐ་དད་དུ་འདོད་པས་དགག་དགོས་བརྩི་ནས་བསྲུང་དགོས་པར་འདོད།",
    "ལུས་གྲིམ་ཞིང་སེམས་ཀློད་ལ་འདུག་སྟེ།",
    "ཕག་པར་ཇུས་གཏོགས་མི་འདུག་སོ་སོའི་ལས་འགན་སོ་སོས་སྒྲུབ་པར་མི་གཞ་ཀྱིས་ཇུས་གཏོགས་བྱེད་མི་དགོས་པའི་དཔེ།",
    "ཚེར་མ་རྐང་པར་ཚེར་མ་ཟུག་དུས་ཇོག་པ་དྲན་ཐུག་དུས་རྡོག་པ་དྲན་ཞེས་པར་གསལ།",
    "སྡུག་དུས་རང་སེམས་མ་ཞུམ་སྐྱིད་དུས་སྙོམ་ཆུང་བྱེད་དགོས་པ་དང་སྡུག་དུས་བག་འཁུམས་མི་རུང་བའི་དཔེ།",
    "སྡུག་དུས་མགོ་འཕང་མཐོ་དགོས་ཞེས་ཀྱང་ཟེར།",
    "དཀར་ཁ་གཙང་བ་ཆག་འདུག་བྱ་བ་མང་པོ་བྱས་པས་མི་ཕན་པས་བྱས་པ་དེ་ཡག་པོ་ཞིག་བྱེད་དགོས་པའི་དཔེ།",
    "སྐེ་རུས་པ་མེད་ཀྱང་ཀྲོང་ཀྲོང་རང་ལ་ཡོན་ཏན་མ་ཚང་ཡང་ནུས་ཤུགས་སྐྱེད་ཚུལ་གྱི་དཔེ།",
    "ཟློ་ཁལ་ཁར་འདུག་བསམས་ནས་སྟེང་རྩེག་འགྲོས་རྒྱག་འདུག་བསམས་ནས་ཡོབ་རྡུང་ལས་ཀར་ཧུར་ཐག་བྱེད་ཀྱི་འདུག་བསམས་ནས་ད་དུང་ལས་འགན་ལྗིད་དུ་གཏོང་བའི་དཔེ།",
    "བག་ཚ་བློས་མི་གཏོང་རང་ལ་མི་དགོས་པ་དེ་ཡང་ཞར་བྱུང་དུ་དང་ལེན་བྱེད་དགོས་པའི་དཔེ།་",
    "སྡུག་དུས་དགྲ་བོའི་དྭངས་མར་ལངས་དགའ་སྡུག་རྟག་བརྟན་མེད་པའི་དཔེ།་",
    "ཕོ་རྒོད་པོ་ག་འདྲ་ཞིག་ཡིན་རུང་རང་ཉིད་ཀྱི་འགོ་དཔོན་གྱི་ཁ་གཏད་དུ་ལངས་མི་ཐུབ་པའི་དཔེ།",
    "ཙི་ངམ་ཤོད་བྱེ་མས་རྐང་པ་འཚིག་དེ་ནས་ང་རང་སྤྱང་དུ་ཕྱིན་སྣ་བསུན་འཁེལ་ནས་སྤྱང་གྲུང་རྙེད་པའི་དཔེ།",
    "ཐོག་སེར་བ་ང་ཡི་མགོ་ལ་སྡང་མི་ཀུན་ལ་ཡག་པོ་བྱུང་བ་དང་རང་ལ་སྡུག་པོ་བྱུང་བའི་དཔེ།",
    "གཞན་ལ་བདེ་སྐྱིད་ཐོབ་ཀྱང་རང་ལ་ཆག་སྒོ་བྱུང་བའི་དཔེ།",
    "ཊྛི་དཔོན་རྣ་བ་མ་སྲབ་ཞིབ་ཏུ་བརྟག་གཡོག་ཞུ་ཞུ་མ་མང་རང་ཚུགས་ཟུངས།",
    "བ་ལ་མགོ་ཐག་བརྒྱབ་ནས་ཞོགས་ཇ་སྣུམ་ཞག་ཚིལ་ཚིལ་རྒྱུ་ནོར་ཕྱུག་པའི་སྐད་གྲགས་མེད་ཀྱང་རང་ལ་དགོས་པ་དེ་ལྡང་ངེས་ཡོད་པའི་དཔེ།",
    "ཚང་གསོག་དུས་རྗེས་ཟིན་པ་དགོས་འགྲོ་དུས་མཉམ་བསྐྱོད་མ་ཐུབ་ཀྱང་ལས་ཀ་བྱེད་སར་རྗེས་ལུས་མ་ཐེབས་པ་བྱེད་དགོས་པའི་དཔེ།",
    "རྡོ་ཆུང་ཡང་རྫ་གཅོག་རང་འཁོས་ཀ་ཞན་རུང་རང་ལས་ཀྱང་འཁོས་ཀ་ཞན་པ་དེ་དག་ཐུབ་པའི་དཔེ།",
    "ཙ་ཚ་༡ སྦུད་པ་ལྡིར་སྒྲ་ཆེ་ཡང་ལག་པའི་འོག་རྫིག་ཉམས་ཆེ་ཡང་རང་ཤུགས་གཏན་ནས་མེད་པའི་དཔེ།",
    "སྐུ་གྱོང་ལྕགས་ལ་ཐོགགཤིས་རྒྱུད་གྱོང་པོར་ཡ་བྱས་ན་སྦྱོང་རང་ལ་འཁེལ་བའི་དཔེ།",
    "ཨེམ་ཆི་ཁྲ་འདྲ་དགོས་བྱ་བ་འགག་རྩར་ཐུག་དུས་བྱེད་ཐབས་གཟབ་ནན་འཚོལ་དགོས་པའི་དཔེ།",
    "ཞཞབས་ཞ་བོ་རྐྱང་ཐོག་ཏུ་སླེབས་པ་ལན་གཅིག་གླུ་འདི་དུས་མི་ལེན་ག་དུས་ལེན།",
    "ལས་དུས་ང་རང་གཅིག་པུ་ཟ་མཁན་མང་བ་དང་ལས་ཀ་བྱེད་མཁན་ཉུང་བའི་དཔེ།",
    "ཁྱི་རིག་དུས་རྡོ་བཙལ་བྱ་ཐབས་ཟད་དེ་མི་བྱེད་ཀ་མེད་བྱེད་པའི་དཔེ།",
    "སྤར་རྡོ་ས་ལ་མི་ལྷུང་རང་ལག་ཏུ་ཡོད་པའི་དངོས་པོ་བོར་བརླག་ཏུ་མི་གཏོང་བའི་དཔེ།",
    "མི་སྡོད་སར་རང་རང་དོན་ལ་བསམ་བློ་གཏོང་དགོས་པ་ལྟར་གཞན་དོན་ལའང་བསམ་བློ་གཏོང་དགོས་པའི་དཔེ།་",
    "རང་ཡུལ་ཕག་ཚང་ཡིན་ཡང་གཞལ་ཡས་ཁང་རང་ཉིད་ཀྱི་བདེ་སྡུག་གོམས་གཤིས་སུ་གྱུར་པ་དེ་རང་ལ་དགའ་ཞེན་ཆེ་བའི་དཔེ།",
    "༣ ལ་མཐོན་པོ་འཛེག་དུས་སྐེད་པ་འདྲོང་།",
    "ཚེར་མ་ཟུག་དུས་རྡོག་པ་གལ་ཆེ་བའི་སྐབས་སུ་ཕན་ཐོགས་པའི་དཔེ།",
    "སྣང་བར་གང་ཤར་མི་འདུག།",
    "གློ་ཤ་ཤ་ཁག་ཁག་གྲི་སོ་སོ་རང་རང་གནས་ཚུལ་ཐ་དད་འབྲེལ་མེད་ཡིན་པའི་དཔེ།",
    "གྱི་ཤ་ལ་རྒྱག་དུས་རུས་ལ་གནོད།",
    "མེ་ཉིར་འདུག་དང་རྩོལ་དྲག་ལ་སོགས་སྤང་།",
    "ཁ་འདོན་སྨྲ་བརྗོད་སེམས་ལས་འགྲོ་འདུག་སྤང་།",
    "ཚོན་གང་མར་སྐབ་འདིར་ཡར་མར་ལྡོག་པ་ལྟར་འདུག་གོ།",
    "མ་དང་རང་རྩ་དར་ན་རབ་ཏུ་བཟང་།",
    "ཡང་ན་མ་དང་རང་རྩ་གཞི་ལ་གནས།",
    "ཇི་ལྟར་རྒོལ་ཀྱང་རང་ལ་ཚུགས་མི་འགྱུར།",
    "གྲོགས་ཚུ་བྱུང་བཟང་རང་རྩ་བཏང་སྙོམས་སོ།",
    "འགྲོ་འདུགས་སེམས་ལས་ཆུ་འཁྲུགས་སྤང་བར་བྱ།",
    "༧ ལྡོག་དུས་རླངས་མ་ཡལ་བར་ལྡོག་པ་ཚ།",
    "དྲི་ཟའི་རྒྱལ་ཞེས་ལྷ་ཞིག་འདུག་པ་དེས།",
    "མེ་ལྷ་ཡིན་ཟེར་གདོན་ཞིག་འདུག་པ་དེས།",
    "སྒྲ་གཅན་ཡིན་ཟེར་གདོན་ཆེན་ཅིག་འདུག་དེས།",
    "རྫས་རྣམས་རང་རང་ངོ་བོའི་ནུས་པའོ།",
    "འོལ་བ་དེ་དང་ཕྱོགས་མཐུན་རོ་ཙ་ནུས།",
    "རང་རང་ལ་བཙོས་ཆང་མ་ཞུ་བ་འཇུ།",
    "རང་རང་སྟོབས་ལྡན་དེར་ལྡོག་སྤང་བར་བྱ།",
    "སྟོན་འབྲིང་ཉ་ལ་རཀྟ་འཛག་དུས་བརྐོས།",
    "རང་རང་སྐྱོར་ཁའི་ཁ་ནས་གྱེན་བཅལ་གཏར།",
    "རྨ་ཆས་བལ་དཀྲིས་འགྲོ་འདུག་འགུལ་བསྐྱོད་གཟབ།",
    "རུ་རྟ་རྒྱམ་ཚྭ་རང་རང་གཉེན་པོ་བསྣན།",
    "དང་པོ་ཆུ་སྐྱུར་སྐྱུག་དུས་སེ་འབྲུ་དང་།",
    "༧མཁྲིས་ཐབས་སྐྱུག་དུས་དུག་ཉུང་ཏིག་ཏ་དང་།",
    "ཡ་མར་བབས་ན་ཐང་ཕྲོམ་བྱི་ཏང་ག་རང་རང་ཁ་བསྒྱུར་བསྣན་པ་མཆོག་ཏུ་བསྔགས།",
    "རྐུབ་བཅོས་འདུག་ཚུལ་རྐང་མཐིལ་བརྡུང་ལ་རྐང་མཐེབ་ནས།",
    "རང་རང་སྲེག་རྫས་རྣམས།",
    "ཆུས་བཤལ་སླར་ཡང་རང་དང་ལྗིད་མཉམ་པའི།",
    "ལ་སོགས་ཤེལ་རིགས་གང་ཡང་རང་ལྗིད་དང་།",
    "ཞག་གཅིག་ཆང་བཟང་རང་ནུབ་ཙམ་དུ་སྦངས།",
    "ཐུག་འབྲས་ཀུན་ཀྱང་རང་རིགས་འོ་མར་འཚོད།",
    "སིག་མ་བྲོ་བར་འདུག་ན་སླར་ཆུ་བསྣན།",
    "ཁྱད་པར་ཉི་མའི་ཟེར་དུག་ཕོག་དུས་སྤང་།",
    "ས་གཞི་རྟ་ཡིས་གང་ནས་གདའ།",
    "ཡུལ་ཁོས་ངར་གྱིས་གང་ནས་གདའ།",
    "མངལ་དུ་སྐྱེ་བ་བླངས་པ་དེའི་འོག་ཏུ་ལུས་རིམ་གྱིས་འཕེལ་ཏེ་དང་པོ་ནི་མེར་མེར་པོ་སྟེ་ཕྱི་སྤྲིས་མ་ལྟ་བུས་གཡོགས་ལ་ནང་ཤིན་ཏུ་སླ་བར་འདུག་པའོ།",
    "མེར་མེར་པོ་སྨིན་པ་ལས་ལྟར་ལྟར་པོ་སྟེ་ཕྱི་ནང་གཉིས་ཀ་སྤྲིས་མ་ལྟར་གྱུར་ཏེ་ཞོ་ལྟར་འདུག་ལ་ཤར་ནི་མ་གྱུར་པའོ།",
    "ཆོ་ག་བཞིན་དུ་འཐུང་བ་ཡང་རང་བཞིན་ལྔ་རིམ་གྱིས་འོད་གསལ་དུ་ཞུགས་པ་ལ་བྱའོ།",
    "སྣང་བའམ་སྟོང་པ་གསུམ་ནི་གཉིད་དང་བརྒྱལ་བ་དང་འཁྲིག་དུས་དང་ཆི་བའི་དུས་དང་ཏིང་ངེ་འཛིན་མཐུ་ལྡན་གྱིས་སྤྲོས་པ་ཐིམ་པར་བྱས་པའི་སྐབས་མ་གཏོགས་པ་རྣམས་སུ་མངོན་དུ་མི་འགྱུར་ལ།",
    "དེ་སྐད་སྨྲས་ནས་མདུན་འདུག་སྟེ།",
    "དེའང་རང་བཞིན་གྱིས་ཀུན་ལ་གནས་པ་དང་།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་ནས།",
    "བསྡུས་ནས་སླར་ཡང་རང་བཞིན་གྱིས།",
    "ཕྱིའི་དུས་དང་ཁ་ལྟ་ཕྱོགས་དང་འདུག་སྟངས་དང་།",
    "སྣང་བ་དང་རང་བཞིན་གཏན་ལ་དབབ་པ་དང་།",
    "སྣང་བ་གསུམ་དང་རང་བཞིན་གྱི་མཚན་ཉིད་བསྟན་པ་དང་།",
    "རབ་དབྱེ་ནི་སྣང་བ་གསུམ་དང་རང་བཞིན་བརྒྱད་ཅུའི་དབྱེ་བའོ།",
    "རྟོགས་པའི་ཕན་ཡོན་རྣམས་བསྟན་འདུག་ལ།",
    "ཞེས་གསུངས་ཤིང་རང་ཉིད་ཀྱིས་ཀྱང་དེ་ལྟར་བསྒྱུར་བའི་ཕྱིར་རོ།",
    "བི་བྷཱུ་ཏི་ཙ་ནྡྲས།",
    "བརྗོད་བྱ་དང་རང་བཟོའི་ཉེས་པ་སྤང་པ་དང་།",
    "འདོད་པ་དང་མྱ་ངན་ལ་སོགས་པར་ཁྱབ་པ་གྲུབ་ཅིང་རང་བཞིན་གྱི་མི་མཐུན་ཕྱོགས་པ་ཐ་མལ་པའི་ང་རྒྱལ་དང་།",
    "ཅི་དེའང་རང་བཞིན་གྱིས་གྲུབ་པ་ཞིག་གམ།",
    "ཛ་ཧཱུཾ་བཾ་ཧོ་རང་རང་སོ་སོའི་དམ་ཚིག་པ་དང་གཉིས་སུ་མེད་པར་གྱུར།",
    "འདིར་ཧཱུཾ་སོགས་ས་བོན་ལྔ་ཀ་འདུག།",
    "ཁོ་བོ་ཅག་དུས་ཀྱི་ཕོ་ཉས་ཁྲིད་པར་གྱུར་ན།",
    "ཡུལ་སྟེང་ནས་གྲུབ་པར་བཟུང་ནས་ཞེན་ཆགས་བྱས་པ་འདིས་ལན་འདུག་པས་གཉིས་སྣང་རགས་པ་འགགས་པའི་སྣང་མཆེད་ཐོབ་གསུམ་འོད་གསལ་དང་བཅས་པ་ཤར་བ་ན།",
    "དེ་ལེགས་པོ་ཞིག་བྱུང་ན་ད་གཟོད་འཆི་ཙ་ན་ཐ་མལ་གྱི་འཆི་བ་རང་དགའ་བར་མི་འགྲོ་བར།",
    "མགྲིན་པར་ཨོཾ་གྱི་སྒྲ་སྒྲོག་དུས་ཨ་ཐུང་གསུམ་འགྱུར་གྱི་ཡུན་ཡོད་པས་ཧཱུཾ་ལ་རིང་ཆ་གཉིས་དང་།",
    "ཁྲོ་བོ་བཅུ་ལས་འོད་ཟེར་མེ་འོད་ལྟ་བུ་སྟོང་གསུམ་ཁྱབ་པར་འཕྲོ་བ་རྣམས་ཀྱང་ཟེར་བ་འདུག་པ་དང་།",
    "དེ་ནས་འགྲོ་འདུག་ལ་སོགས་དང་།",
    "གདན་ས་བྱེད་པའི་ངེས་པ་རང་མི་འདུག་གསུང་སྟེ།",
    "འགྲོ་འཆག་ཉལ་འདུག་གང་བྱེད་ཀྱང་།",
    "ཞེས་མང་དུ་གསུངས་འདུག་པ་ལ།",
    "ངེད་ཀྱི་རྨི་ལམ་དུ་རྔོ་ཅིག་བརྡུངས་པས་རྟག་རྟག་ཟེརགདའ་གསུང་།",
    "བཅོས་མ་མ་ཡིན་པའི་རྡོ་རྗེ་འཆང་རང་དུ་མཐོང་ཞེསཀུན་གྱིས་གླེང་ཞིང་།",
    "དེ་ཡང་དབུས་གཙང་ཕྱོགས་མུ་མང་བར་འདུག།",
    "ང་རང་རང་སོར་ཞོག་གསུང་།",
    "དེར་རྗེ་བཙུན་ཉིད་ཀྱི་སྤྲུལ་པའི་སྐུ་འབུར་འདུག།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་སྟེ།",
    "ཨོཾ་ཨོཾ་བེ་རོ་ཙ་ན་ན་མ་ས་རྣམ་པར་སྣང་མཛད་དང་།",
    "ཨོཾ་ལྃ་ལོ་ཙ་ནི་ན་མ་ས་སྤྱན་མ་དང་།",
    "གཏོར་མ་བཤམས་པ་ལ་ཕྱོགས་པས་སློབ་དཔོན་ཤར་དུ་འདུག་ལ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་དྲུང་ཤར་ཕྱོགས་སུ་འདུག་ནས།",
    "གང་ཕྱིར་དངོས་ཀུན་རང་བཞིནགྱིས་རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས།",
    "གལ་ཏེ་དོམའང་གཅིག་དུས་ཅན།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།"
