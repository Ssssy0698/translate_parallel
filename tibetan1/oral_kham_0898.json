    "དེ་དུས་ཕྲན་གྱིས་ཀྱང་ཁོང་ལེགས་པོ་འདུག་ཅེས་ཟེར་མྱོང་།",
    "ད་ནི་འཕྱི་པོར་གྱུར་འདུག་པས་སྔ་ཙམ་ཕེབས་ན་ལེགས།",
    "ལིན་ཏའེ་ཡུད་ཀྱིས་དེ་ག་རང་ཡིན་འདུག་གཞན་གྱིས་བདམས་པའི་ལྷག་འཕྲོ་ཡིན་ན་ང་ལ་མ་སྤྲོད་ཅིག་ཟེར།",
    "གནང་རྒྱུ་ཡོད་ན་གནང་ཤོག་ཕྲན་ལ་བྱེད་སྒོ་ཡོད་པས་འདུག་ཁོམ་མེད་ཟེར།",
    "ཁ་ནས་གཤེ་ཚིག་ཀྱང་སྨྲ་བཞིན་འདུག་ཅེས་ལན་བཏབ།",
    "ཚང་མ་ཧ་ལས་ཏེ་ངེད་ཅག་ལ་ཐབས་འཚོལ་བྱེད་རོགས་ཟེར་འདུག་ཅེས་ལན་བཏབ།",
    "ཡིག་འབྲུ་བརྒྱད་པོ་འདི་དག་ནི་ཕྲན་གྱི་དེ་དང་ཆ་མཚུངས་ཤིག་འདུག་ཟེར།",
    "བཙུན་པས་ཡིག་འབྲུ་དེ་རྣམས་གསེར་ཆས་སྟེང་དུ་ཅི་ནས་བརྐོ་དགོས་བརྗོད་འདུག་ཟེར།",
    "རྗ་རྦའོ་ཡུད་ཟུང་མྱུར་དུ་ལངས་ཏེ་ལིན་ཏའེ་ཡུད་འདུག་ཏུ་བཅུག་སྟེ་ཤོའི་རྦའོ་དྲའེ་ཡིས་འཛུམ་དམུལ་དམུལ་དུ་དེ་ལྟར་གསུངས་དོན་ཅི་ཞིག་ཡིན་ཟེར་བར་ལིན་ཏའེ་ཡུད་ཀྱིས་ཁོང་ཕེབས་ཡོད་པ་སྔོན་ནས་ཤེས་ན་ཕྲན་འདིར་བཅར་དགོས་མ་མཆིས་ཟེར།",
    "སླེབས་པ་དང་ཁོང་ཕེབས་རྩིས་བྱེད་འདུག་ཟེར།",
    "ཡང་ཁ་བ་བབ་འདུག་པར་མ་ཟད།",
    "ཁོལ་བུ་རྣམས་ཀྱང་རང་གནས་སུ་བསློགས་ན་ཞེས་ཟེར།",
    "ཕྲན་པི་ཙིགང་རང་འཐུང་དུ་འཇུག་རོགས་ཞེས་ཞུ་བ་འཐེན།",
    "ཁྱེད་ཀྱིས་ཡིག་འབྲུ་གསུམ་པོ་འདི་དག་ལས་གང་ཞིག་ལེགས་པ་ལྷད་མེད་པར་དྲང་པོར་གསུངས་དང་ཞེས་ཟེར་བས་ལིན་ཏའེ་ཡུད་ཀྱིས་དེ་འཕྲལ་མགོ་བོ་བཏེག་སྟེ་བལྟས་པས་ཅང་ཡུན་ཞོན་ཞེས་པའི་ཡིག་འབྲུ་དག་འདྲེན་བྱེད་ཀྱི་ཡུལ་དུ་གྱུར་པ་དང་འཛུམ་འཚེར་འཚེར་དུ་ལེགས་པོ་འབའ་ཞིག་ཡིན་འདུག་པ་ཨེ་མ་མཚར།",
    "འོན་ཀྱང་རང་ཉིད་དབུལ་ཞིང་ཉམ་ཐག་པ་ངོ་ཚའི་གནས་བབས་སུ་འཁོད།",
    "གུས་ཚོ་བྲན་ཁོལ་འདི་དག་ནི་ཞབས་འགྱུཪ་ཇི་ཙམ་བསྒྲུབས་ཀྱང་རྡུང་རྡེག་དང་གཤེ་གཤེ་འཁུར་རྒྱུ་ལས་མི་འདུག་ད་ནས་བདག་ཚོར་ཐུགས་རྗེས་ཅུང་ཟད་བསྐྱངས་ན་ཅི་མི་ལེགས་ཞེས་ཟེར།",
    "ཁོང་གཅེན་གཅུང་གཉིས་མཛའ་ཞིང་གཅུགས་པས་རྣམ་པ་ཀུན་ཏུ་ཟ་འཐུང་འགྲོ་འདུག་མཉམ་དུ་རོལ།",
    "མང་དུས་སུ་ཉིན་བཅུ་ཙམ་འབབ་ཀྱི་འདུག་ཟེར།",
    "དེ་རིང་ཡང་ཁམས་མི་བདེ་ཙམ་འདུག་པས་ཆིབས་བསྒྱུར་གནང་མི་ཐུབ།",
    "དེ་ལྟར་གླེང་མུར་ཕྱི་ནས་སྐུ་ངོ་བགྲེས་གཞོན་གཉིས་དང་སྲས་སྲོས་རྣམས་ཕེབས་ནས་ད་ལྟ་ཚོམས་སུ་བཞུགས་འདུག་ཅེས་སྙན་སེང་ཞུས།",
    "ཁྱེད་ཀྱིས་བློ་སྒོ་ལེགས་པར་འབྱེད་པར་མཛད་ན་ཕྲན་ཡང་བློ་བདེ་བཟོད་བདེ་ཡོང་བ་འདུག་ཁྱེད་མྱུར་ཙམ་དུ་སྐྱེད་ཚལ་དུ་ཕེབས་ཨང་ཞེས་ཟེར།",
    "ཡང་ཇིན་ཧྲིར་ཁྱེད་རང་སེམས་སྦུབས་དོག་པོ་འདི་འདྲ་མ་བྱེད་ཨང་།",
    "རི་འདབས་ཁང་བཟང་འགའ་ཞིག་བསྐྲུན་ནས་འདུག།",
    "མངག་གཏོང་བྱས་པའི་མི་དེ་དག་ཕྱིར་ལོག་སྟེ་དེང་སང་ཇིན་ཧྲིའི་སྙུན་ཁམས་ལོད་པོ་མི་འདུག་ལ་དྲག་སྐྱེད་ཀྱང་མི་འདུག་ཅེས་སྙན་སེང་ཞུ་བཞིན་ཡོད།",
    "ད་ལྟ་དགུན་ཉི་ལྡོག་ཟིན་ནས་འགྱུར་བ་གང་ཡང་མི་འདུག་དྲག་སྐྱེད་ཡོང་མིན་ཡང་ཆ་མ་རྟོགས།",
    "ཝང་ཤིའི་ཧྥུངས་ཀྱིས་དེ་ག་རང་འདུག་བློ་བག་བསང་མཁན་ཞིག་བྱུང་ན་སྙམ་བཞིན་ཡོད་ཅེས་ཟེར།",
    "ཝང་རན་འདུག་ཟེར།",
    "བསམ་པར་ཝང་ཤིའི་ཧྥུངས་ཀྱིས་རང་ཉིད་ལ་གནག་སེམས་བཅངས་འདུག་སྙམ་ནས་ཁོང་ཁྲོ་སྐྱེས།",
    "ཕྲན་གྱི་བསམ་གྲོས་ལ་དགོས་དོན་མི་འདུག་མ་དགོངས་ཤིག་ད་ཆ་འཕེལ་ཞིང་འབྱོར་བའི་སྐབས་འདིར་མེས་པོའི་བང་སོའི་ཉེ་འགྲམ་དུ་འབྱུང་འགྱུར་པུར་མཆོད་དང་།",
    "རང་རང་བགྲོད་པའི་ལམ་བུ་རང་རང་སོ་སོས་འཚོལ་དགོས།",
    "ཅིག་ཤོས་འགྱོགས་བྱམས་སུ་གཞུག་ལ་ཁད་དུ་རྗ་ཀྲིན་གྱིས་དངུལ་འབབ་རྣམས་ནང་མ་ཁང་དུ་ཐད་དཀར་འབུལ་དགོས་སམ་ཡང་ན་གང་ཉིད་ཀྱི་གཟིམ་ཤག་ཏུ་འབུལ་རྒྱུ་གང་འགབ་ཅེས་དྲིས་པར་ཏད་ཆོན་གྱིས་ལན་དུ་ནང་མ་ཁང་དུ་བསྐྱལ་ན་ཁྱེད་རང་ལ་གྱོང་གུན་ཡོང་བས་དེ་ལས་དངུལ་དཀར་པོ་སྲང་ཆིག་སྟོང་ཐམ་པ་ཕྲན་གྱི་ཁྱིམ་བརྒྱུད་གནང་ན་ལེགས་ཞེས་ཟེར།",
    "ཁྱེད་ཀྱི་སྐུ་ཁམས་བདེ་མིན་བལྟས་ཐོག་དགུན་ཆས་ན་བཟའ་འགའ་ཤས་ཁུར་ཤོག་ཅེས་བཀའ་ཕེབས་ཀྱི་འདུག་ཞུས།",
    "ཁྱེད་ཐུགས་འདོད་ལྟར་གནང་དགོས་ཞེས་བཀའ་ཕེབས་འདུག་ཟེར།",
    "ངལ་བའི་འབྲས་སུ་གྲུབ་པ་སུ་ཡིས་རྟོགས་ཞེས་འཁོད་པ་ནི་དོན་དང་མཐུན་པ་ཞིག་རང་ཡིན་འདུག་ཅེས་ཟེར་གྱིན་ཁང་པ་གཞན་ཞིག་ཏུ་འཛུལ་བས་དེ་ན་ས་ཁྲིའི་སྟེང་དུ་སྤུན་འཁེལ་བྱེད་འཁོར་ལོ་ཞིག་ཡོད་པ་མཐོང་བ་ན་དེ་བས་ཁྱད་མཚར་པོར་མངོན།",
    "ཤེས་རབ་མས་མཆུ་སྒྲོས་གཉེར་ནས་ཇ་དཀར་ཡོལ་གང་ལའང་ཧབ་རྩོད་བྱེད་ཀྱི་འདུག་ངའི་ལག་ཏུ་སྦྲང་རྩི་ནི་ག་ལ་ཡོད་ཅེས་ཟེར།",
    "དེ་ནས་ཁོང་རྣམས་ཀྱིས་རང་རང་གོ་བབས་ལྟར་གྱི་མཆོར་རྒྱན་སྤྲས།",
    "ཨ་ཙི།",
    "ཡོལ་བ་ཚོན་ཁྲ་སོགས་ཉོ་བྱེད་དུ་ཉར་འཇོག་བྱས་ན་ཟེར་འདུག་ཅེས་བརྗོད་པས་རྗ་ལེན་གྱིས་མགོ་བོ་ལྕོག་ལྕོག་བྱེད་ཀྱིན་དུ་བྱུས་བཀོད་འདི་ལེགས་འདུག་ཅེས་ཟེར།",
    "ཁྱེད་རང་འཚབ་འཚུབ་བྱེད་མི་དགོས།",
    "གནའ་རབས་ཀྱི་རྒྱ་ལུགས་སུ་མི་ཤི་ན་ཕུང་པོ་ཉལ་ཁྲིར་མི་འཇོག་པར་སྨྱུག་ཕྱར་སྟེང་དུ་སྤོ་བའི་སྲོལ་འདུག་ལེའུ་བཅུ་བདུན་པ།",
    "ཁྱེད་ནི་མཁྱེན་རྒྱ་ཆེ་ཞིང་ཟབ་པར་འདུག་ཅེས་བསྔགས་བརྗོད་བྱས།",
    "བུ་འདིས་མ་བརྩམས་གོང་ནས་ཐོག་མར་གཞན་རྩོམ་གྱི་དགེ་སྐྱོན་གླེང་བ་འདི་ནི་སྤྱོད་ཡན་ཚུལ་དང་མི་ལྡན་པ་ཞིག་ཡིན་འདུག་ཅེས་ཟེར།",
    "གནས་འདི་ནི་སྤྲོ་སྣང་འཆར་བ་ཞིག་འདུག་ཟོལ་གྱིས་བཅོས་པ་ཡིན་ཡང་བཅོས་མིན་མངོན་སུམ་གྱི་ཉམས་སྣང་ལྷང་ངེར་འཆར་ཐུབ་པ་ཞིག་འདུག་པས་ཁོ་བོའི་བསམ་པ་ཡང་སོ་ནམ་གྱི་ལས་སུ་བཀོལ་བའི་ཕྱོགས་སུ་འདྲེན་པར་བྱེད།",
    "ཁོ་ལ་བྱ་རྒྱུ་ཅི་འདུག་བལྟ།",
    "ད་ནི་ཁོ་བོ་གཅིག་པུར་ལུས་རྒྱུ་ཡིན་འདུག་ཟེར་ནས་རབ་ཏུ་ཁྲོས་ཏེ་མལ་ཁྲིར་ཉལ་ནས་བསྡད་དོ།",
    "བསུང་ངད་འདི་ནི་ངོ་མཚར་ཅན་ཞིག་འདུག་བསུང་ལེབ་དང་།",
    "ཇི་ལྟར་ཡང་ཁོ་བོས་གཏམ་ཚིག་གཅིག་སྨྲས་པའི་ལན་དུ་ཁྱེད་ཀྱིས་མང་དག་ཅིག་བསྙད་འདུག་པས་ཁྱེད་ལ་སྣ་བསུན་ཞིག་མ་སྤྲད་ན་མི་ཤེས།",
    "མངར་ཁམ་བཅས་སྣ་གྲངས་ལྔ་ལས་མི་འདུག་གོ་ཞེས་གསོལ།",
    "ད་ནས་གང་བྱུང་མི་ཞུའོ་ཟེར་བས་ལིན་ཏའེ་ཡུད་ཀྱིས་འཛུམ་དམུལ་ཏེ་གཞན་ལ་འཕྱ་སྨོད་བྱེད་བཞིན་དུ་ད་དུང་སྔར་གྱི་གཏམ་རྒྱུད་ཡིན་ཟེར་འདུག་ཅེས་སྨྲས།",
    "གཅུང་པོ་རྦའོ་ཡུད་ཁོང་ཡིན་འདུག་ཁོང་ལ་ཁག་ཅི་ཡོད།",
    "ད་ནི་མ་མ་རྫི་རྡིབ་འདུག་གོ་ཞེས་ཟེར།",
    "རྫ་རྦའོ་ཡུད་ཀྱིས་ཉལ་ཁྲིའི་འོག་ན་དངུལ་སྤུངས་ནས་འདུག་པ་དེས་ཀྱང་མི་ལྡེང་ངམ་ཞེས་བརྗོད།",
    "ཐང་བྱེད་ཀྱི་འདུག་ཟེར་བར།",
    "རྗ་ཧོན་གྱིས་བློ་ཞུམ་ཞུམ་དུ་དོང་ཙེ་བརྒྱ་ཉིས་བརྒྱ་ཙམ་ཤོར་འདུག་ཅེས་ལན་བཏབ།",
    "རང་འབྱུང་རང་འབྱུང་ཡེ་ཤེས་འདི།",
    "སྐྱེ་འགག་གཉིས་མེད་ཁྱད་པར་གཅིག་དུས་གསུམ་ཡོད་པར་ལྟ་བ་ནི།",
    "འགྲོ་དང་སྡོད་དང་འདུག་དང་ཉལ།",
    "རྒྱལ་བས་རྨང་དྲག་དུས་སུ་བོན་དར་ནས།",
    "མེད་ཅིང་རང་བཞིན་རྣམ་པར་དག་པ་དབྱིངས་ཡིན།",
    "ང་རང་ལ་བལྟས་པས་ང་ཉིད་ཡེ་ནས་སེམས་ཉིད་ཉག་གཅིག་ཏུ་སྣང་།",
    "དོན་རྟོགས་ན་སྡུག་བསྔལ་དང་རང་བདེ་ཙམ་ན་ཡེ་ཤེས་བདེ་བ་ཡིན་ནོ།",
    "ས་རྡོ་འདུག་སྙམ་པའི་ཤེས་པ་མི་སྐྱེ་བ་བཞིན་དུ།",
    "དེ་ལྟར་རྟོགས་པའི་དོན་ལས་མི་འདའ་བར་འདུག་ན་སེམས་ཀྱི་སེམས་མཐོང་བ་ཡིན།",
    "སེམས་ཀྱི་ངོ་བོ་རང་ཅི་ལྟར་བུར་འདུག་ན།",
    "ཁ་དོག་བུ་རྒྱུཏུ་མི་འདུག་དབྱིབས་སུ་མི་འདུག་དཀར་དམར་དུ་མི་འདུག་ཅི་ལྟ་བའི་ངོ་བོ་ཡང་མི་འདུག་པ་ལ།",
    "གསལ་བར་འདུག་ཡོངས་སུ་རྒྱ་མ་ཆད་པར་འདུག་དེ་ཁོ་ནར་ལྟར་གནས་པར་བསྒོམ།",
    "གཞི་ངོ་བོའི་འདུག་ཚུལ་ནི།",
    "བོན་ཉིད་ཀྱི་ངོ་བོ་ཅི་ལྟར་འདུག་ན།",
    "གཞི་ངོ་བོའི་འདུག་ཚུལ་དང་།",
    "གཞིའི་འདུག་ཚུལ་ནི།",
    "དེས་ན་གཞི་མཉམ་པ་གཅིག་ཏུ་འདུག་དེ་ནི་གཞིའི་ངོ་བོའི་འདུག་ཚུལ་ལོ།",
    "ཅི་ལྟར་ཡང་འཆར་ཡིན་འདུག་ཅི་ལྟར་ཡང་འཆར་བ་དེ།",
    "དེ་ལ་གཞི་ངོ་བོའི་འདུག་ཚུལ་ཅི་ལྟ་བ་བཞིན་རྟོགས་པ་ལྟ་བ།",
    "གཞིའི་ངོ་བོའི་འདུག་ཚུལ་ལོ།",
    "གཞི་ངོ་བོའི་འདུག་ཚུལ།",
    "མ་ཡེངས་པར་འདུག་ན་གཅིག་ཅེས་བྱའོ།",
    "སྣང་སྲིད་སྣོད་ནིཙྪ་ཧུབ་བཅུད་འོད་དུ་མེར་མེར་འདུག་པར་བསམ།",
    "ཤེས་པ་འཕྲོས་ཏེ་རྨི་ལམ་ན་དགོངས་པ་གསལ་བར་འདུག་ན་ཅི་ཡང་བྱ་མི་དགོས།",
    "ལན་གཅིག་དུས་ཀྱི་ཐ་མར་བབ་ཙམ་ན།",
    "རྒྱལ་བས་རྨངས་དྲག་དུས་སུ་དར་བར་ཤོག་རྒྱ་རྒྱ་རྒྱ།",
    "ཇི་ལྟར་འདུག་རུང་མི་འདུག་རུང་།",
    "ལན་གཅིག་དུས་ཀྱི་མཐའ་མ་ལ་བབ་ཙམ་ན།",
    "བོན་ཉིད་ཀྱི་ལ་སྣང་ཡང་རང་བཞིན་མེད་པར་བཅད།",
    "འདུག་པའི་གནས་གཅིག་བསྟན་དུ་གསོལ།",
    "ཁོམ་མཐིང་དཀོར་ཁང་ནང་དུ་སྦས་ཏེ་བཞགནམ་ཞིག་དུས་ཀྱི་མཐའ་ལ་བབ་ཙམ་ན།",
    "བཟུང་དུ་ནི་ཉི་མའི་ཟེར་བཞིན་དུ་འདུག་ལ།",
    "ནམ་ཞིག་དུས་ལ་བབ་ནས་དར་བར་ཤོག།",
    "རང་ནི་མཚང་རང་ལ་འོང་པ་བཞིན།",
    "རྫོགས་པ་ཆེན་པོའི་ལུགས་ཀྱི་ལམ་རྩོལ་བ་མེད་པར་ལྷན་ནེ་འདུག་པས།",
    "མི་ལུས་ཐོབ་པར་དཀའ་བར་འདུག་གོ་ལ་སོགས་པའོ།",
    "བར་དུ་འདུག་པ་ལ་ཐ་དད་མེད་པའི་ཕྱིར་དང་།",
    "སྤྲིན་གྱི་དཔེས་སྣ་ཚོགས་རང་འབྱུང་རང་ཞིར་ངོ་སྤྲོད་དོ།"
  ]
}