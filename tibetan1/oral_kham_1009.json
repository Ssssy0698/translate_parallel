    "ཁོང་འདོད་པ་ཁེངས་པ་ཞིག་འདུག།",
    "འདིས་སེམས་ཚོར་དྲག་པོའི་སྒོ་ནས་ངོས་རང་ལ་དད་པ་དང་ཡིད་ཆེས་དང་འབྲེལ་བའི་དགའ་ཉེའི་ཚོར་བ་དྲག་པོ་ཞིག་སྦྱིན་གྱི་འདུག།",
    "ཁྱེད་རང་ཉིད་ཡང་ནས་ཡང་དུ་ཁོང་ཁྲོ་ལངས་པ་ཙམ་མ་ཡིན་པར།",
    "འཆི་བ་ག་དུས་ཡོང་མིན་ཆ་མེད་ཡིན་པར་བརྟེན།",
    "ད་དུང་ཁྱེད་ཀྱིས་མཐའ་མ་དེ་ག་དུས་ཡོང་མིན་ཤེས་ཀྱི་མེད།",
    "དོན་དུ་རང་བཞིན་གྱིས་གྲུབ་པར་སྣང་རུང་རང་བཞིན་གྱིས་གྲུབ་པས་སྟོང་པའི་ཚུལ་བཅས་ཀྱི་སྒྱུ་མ་ཞིག་དང་འདྲ།",
    "ངོས་ཀྱིས་དཔེ་དེབ་དེ་ཀློག་དུས།",
    "ངོས་རང་ལ་བརྟག་དཔྱད་འདི་འདྲ་ཞིག་ལ་མ་ལྟོས་པར་རྒྱུ་འབྲས་ཀྱི་རྟེན་འབྱུང་འཇོག་རྒྱུ་ནི་དཀའ་ཚེགས་ཆེན་པོ་མི་འདུག།",
    "རྗུད་པ་དང་རྒྱན་སྦྱར་བའི་འགྲེལ་པ་སེང་བཟང་རང་ཉིད་ཀྱིས་ཀྱང་མཛད་པའི་ཕྱིར།",
    "ཁ་ཅིག་གཞུང་མཛེས་པ་བསྐྱེད་པ་ཙམ་གྱི་ཕྱིར་དུ་མཛད་པར་བཞེད་ཀྱང་རང་ལུགས་ལ་རང་དོན་དང་གཞན་དོན་གཉིས་ཀྱི་ཆེད་དུ་མཛད་པ་ཡིན་ཏེ།",
    "ཡུམ་ལ་ཡང་རང་སྲས་འཕགས་པ་བསྐྱེད་པའི་ཡུམ་དང་།",
    "སྟོང་གསུམ་པོ་དེ་ཆགས་འཇིག་དུས་མཉམ་དུ་བྱེད་པའི་ཕྱིར།",
    "གནས་གྱུར་མཐར་ཐུག་པའི་ཚེནངོོ་བོ་ཉིད་སྐུར་འགྱུར་རུང་རང་བཞིན་གནས་རིགས་ཀྱི་མཚན་ཉིད་ཟེར་ན།",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་བར་མཐོང་བ་ཡཾ།",
    "ཁོས་ལམ་སེང་རང་བློས་ཅི་ལྕོགས་ཀྱིས་འགོག་ཐབས་བྱེད་པ་དང་མི་སེར་སྣ་ཅན་ཞིག་ཏུ་ཆགས་འགྲོ་བ་ཡིན།",
    "ཡང་གལ་ཏེ་ཁྱེད་རང་རྙོག་འཛིང་ཞིག་ལས་ཐར་བར་འདོད་ན།",
    "ཡིད་འཐད་མེད་པའི་མི་ལ་འགྲོ་ཐབས་འདུག་ཐབས་བྱེད་པ་ལས་དོན་དངོས་ཐོག་ཁོ་ཚོར་ཕན་པའི་ལས་ཀ་གང་ཡང་མི་བསྒྲུབ།",
    "བྱ་དངོས་གང་ཞིག་ཡིན་རུང་རང་ཉིད་ཀྱིས་འདོད་པ་དེ་ཨང་དང་པོར་འཇོག་པ་ཡིན།",
    "དམག་འཁྲུག་དང་ཡང་ན་འགལ་རྐྱེན་གང་བྱུང་རུང་རང་སོར་ཞི་འཇམས་སུ་གནས་ཐུབ་ཟེར།",
    "ཉམ་ཐག་པའི་ཉམས་འགྱུར་མངོན་ནའང་རང་གཤིས་བརྟན་པོ་དང་སྤྱང་གྲུང་འཛོམས་པོ་ཡོད།",
    "ཁྱིམ་དུ་བསྡད་ནའང་རང་སྟོབས་རང་སྤེལ་དང་འཚོ་བ་རང་ཚུགས་ཐུབ་པ་ཡིན།",
    "གལ་ཏེ་ཁྱེད་རང་སྡོད་ས་མེད་ཅིང་ནོར་གྱིས་སྟོངས་པ་ཡིན་ན།",
    "ཁོ་རང་ལ་དཀའ་ངལ་བྱུང་ཚེ།",
    "ལུག་ལོ་ཅན་གྱི་མི་དེ་ཁོ་རང་སྤྲོ་སྣང་ངམ་དགའ་པོ་ཡོད་པའི་བྱ་དངོས་ཤིག་དང་འཕྲད་ཚེ།",
    "གང་ཡིན་ཟེར་ན་ཁོ་ཚོར་སེམས་རྒྱུད་བཟང་པོ་དང་རང་གཤིས་ལེགས་པོ་ཞིག་ཡོད་པས་མ་ཚད།",
    "གལ་ཏེ་མི་གཞན་ཡར་རྒྱས་སུ་ཕྱིན་པའམ་གཞན་ལ་ཐོབ་པའི་དངོས་པོ་ཁོ་རང་ལ་མ་ཐོབ་པ་ཡིན་ན།",
    "གལ་ཏེ་ཁོ་ཚོས་ཁྱེད་རང་ལ་མགོ་བསྐོར་བཏང་ཟིན་ན་ཡང་།",
    "གལ་ཏེ་ཁྱེད་རང་ལ་བདེན་ཁུངས་རྩ་འཛིན་བརྟན་པོ་ཞིག་མེད་པར་ཁོ་ལ་བཀའ་བཀྱོན་གནང་པ་ཡིན་ན།",
    "ཁོ་ཚོའི་སེམས་སུ་ནམ་ཡང་རང་ཉིད་ལ་དགའ་ཞེན་བྱེད་ཀྱི་ཡོད།",
    "དེ་ལྟར་བྱུང་ཚེ་ད་གཟོད་ཁྱེད་རང་ལ་ལས་དོན་གྱི་རྒྱལ་ཁ་ཐོབ་ངེས་ཡིན།",
    "གལ་སྲིད་ཁྱེད་རང་ལ་སྒོར་དངུལ་བེད་སྤྱོད་བག་མེད་གཏོང་བའི་ངན་གཤིས་དེ་ཡོད་པ་ཡིན་ན།",
    "ཁྱེད་རང་ལའང་བཀག་འགོག་དེས་རང་ཉིད་བག་མི་བདེ་བ་ཞིག་ཡོང་མི་སྲིད།",
    "ཁྱེད་རང་ལ་ཞི་བདེ་བག་ཕེབས་ངང་ལས་ཀ་བྱེད་པའི་གོ་སྐབས་ཀྱང་ཡོང་ཐུབ་པ་ཡིན།",
    "ཁོ་ཞི་འཇགས་ངང་རང་ཉིད་ཀྱི་དགའ་གྲོགས་ལ་བསྟེན་ཞིང་།",
    "གཞན་གྱི་གཏམ་རྗེས་འབྲང་ཞིང་རང་ལ་གདེངས་ཚོད་མེད།",
    "སྟོབས་ཆེ་ལ་གཏུམ་ཞིང་རང་གཤིས་ཤིན་ཏུ་གྱོང་།",
    "འགྲོ་འདུག་སོགས་བྱ་བ་མང་ལ་ཕྲག་དོག་ཆེ།",
    "ཟས་ནོར་ལོངས་སྤྱོད་ལྡན་ཡང་རང་འདོད་ཤིན་ཏུ་ཆེ་བས་ན།",
    "རང་མཐོང་དང་རང་འདོད་ཆེ།",
    "གཞན་གྱིས་ངན་བསླབ་ཀྱང་རང་སེམས་དཔང་དུ་བཙུགས།",
    "ཕ་མེས་དབུལ་ཡང་རང་ཉིད་ཀྱིས་འབད་བརྩོན་ལ་བརྟེན་ནས་ཕྱུག་པོ་ཡོང་།",
    "ཡོ་ཡིན་ན་མའི་ལྟོ་གཡས་སུ་ཅོག་བུར་འདུག་སྟེ།",
    "དེ་འགོག་པ་མའི་སྒལ་ཚིགས་ལ་ཁ་བལྟས་ཏེ་འདུག་གོ།",
    "ཁམས་འཕེལ་འགྲིབ་མེད་དེ་བྱིན་པ་གཉིས་སུ་སླེབ་པ་ན་འཇིགས་སྐྲག་ཙ་ན་སྡུག་བསྔལ་ལོཔར་བཞུགས་པས།",
    "ལུས་འགྲོ་བ་དང་འདུག་པ་དང་འདེགས་པ་དང་འཛོཀ་སྤྱིན་ལྟ་བུ་ལ་གནས་ན་ས་ལྕེ་རོ་དང་སྤྲོད་པའོ།",
    "ད་འདི་སུ་ལ་ཡང་མི་འདུག་པས་ཤིན་རྣམ་པར་ཤེས་པའི་རང་གཟུགས་ཏེ།",
    "བྱད་དུ་ལམ་འོང་སྟེ་དེར་གཞན་པ་དེ་ཡང་དེ་ལྟར་མཐོང་བས་རང་གསང་བ་ནི་སྐུ་གསུང་ཐུགས་རྡོ་རྗེའི་བདག་ཉིད་ལྟ་བ་ངན་པ་དེ་ལྟར་མ་ཤི་བའི་བར་ལ་ལུས་འགྱུར་ཙ་ན་གཞན་འགྱུར་བའོ།",
    "ལམ་གྱི་ངོ་བོ་ཐབས་དང་ཤེས་རབ་ཡིན་པས་ལམ་འདུག་ལ།",
    "དེ་ནས་སྟན་ལ་འདུག་སྟེ་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་།",
    "བསྐུར་ཏེ་འདུག་པའོ།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "སུམ་ཀའང་སྔོན་བསགས་ལས་ཀྱི་རང་རང་དབུས་ཀྱི་གྲངས་ཉི་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱ་ལ་ཉིན་ཞག་འཕེན་པ་ལ་རགས་ལས་ཤིང་།",
    "བརྟག་དུས་ནམ་གྱི་ཚེ་བརྟག་རྟག་ལྟས་ཀྱི་འབྲེལ་བརྗོད།",
    "གལ་ཏེ་ཙོག་འདུག་བྱེད་ན།",
