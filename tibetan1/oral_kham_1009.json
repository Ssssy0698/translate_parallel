    "མི་ཐུབ་ཙ་ན་ནང་དུ་དལ་བུས་དང་།",
    "དེ་ལྟར་སྐྱིལ་ཀྲུང་ལ་འབྱོངས་ན་ཙོག་འདུག་ལ་སྦྱོང་།",
    "དེ་ལ་འབྱོངས་ན་འགྲོ་འཆག་ཉལ་འདུག་ཐོག་རྩྭའི་རྣལ་འབྱོར།",
    "ཞེ་སྡང་རང་བྱུང་ལྟ་བུ་དེ་ཕྱི་ཡུལ་རྐྱེན་ལས་མ་ཡིན་པར་འཁོར་འདས་དབྱེར་མེད་དང་བསྲེས།",
    "ཞེ་སྡང་རང་དག་ཨཱ་ལི་ཀཱ་ལིར་ཤར།",
    "རྣམ་གསུམ་དྲན་འཆག་ཉལ་འདུག་ཐམས་ཅད་དུ་སྦྱངས་ལ།",
    "དང་པོ་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "རྣམ་པ་ཉི་ཤུར་འདུས་པའི་དང་ཚུགས་པ་ཀུན་ཏུ་འཕྱོ་ཞིང་ལུས་དང་འདུག་གུ་ཚོལ་ལོ།",
    "དུར་ཁྲོད་ལ་སོགས་པར་དབུགས་བྲལ་གྱི་གདན་ལ་འདུག་སྟེ་འདི་སྐད་དོ།",
    "བཞོན་པ་བཅུ་དྲུག་དུས་དང་ནི།",
    "ཨོཾ་དཱིདྡྷ་ལོ་ཙ་ན་ཝིཀྲྀ་ཏ་ན་ན་མཧཱ་ཨཊྚ་ཧ་ས་ན་དེ་ནི་དཱིཔཱ་ཡ་སྭཱ་ཧཱས་མར་མེ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བར་ཨོཾ་ལས་འཁོར་ལོ་དཀར་པོ་རྩིབས་བརྒྱད་པ་ཨོཾ་གྱིས་མཚན་པ།",
    "ཨོཾ་དཱིཔཱ་ལོ་ཙ་ན་ཝི་ཀྲི་ཏཱ་ན་ན་མཧཱ་ཨཊྚ་ཧ་ས་ན་དེ་ནི་དཱིཔཱ་ཡ་སྭཱ་ཧཱ།",
    "སྟན་བདེ་བར་འདུག་ནས།",
    "ཨོཾ་དཱིཔཱ་ལོ་ཙ་ན་ཝི་ཀྲི་ཏཱ་ན་ན་མཧཱ་ཨཊྚ་ཧ་ས་ན་དེ་ནི་དཱིཔཱ་ཡ་སྭཱ་ཧཱས་མར་མེ།",
    "འདིའང་ཉེས་དམིགས་ཀྱི་སྒོ་ནས་དམ་ལ་གཞག་པར་གདའ་སྟེ།",
    "དེ་ནས་དཀྱིལ་འཁོར་ལ་གསོལ་བ་གདབ་པ་ནི་སློབ་དཔོན་གྱིས་བགྱི་བར་གདའ་སྟེ་ཞེས་བརྗོད་ནས།",
    "པདྨ་དང་ཉི་མའི་སྟེང་དུ་ཁྱེད་རང་རྣམས་རྡོ་རྗེ་འཇིགས་བྱེད་ཕྱག་གཉིས་པའི་ང་རྒྱལ་གྱིས་གནས་པའི་སྟེང་དུ་གདུགས་དཀར་པོ་གསེར་གྱི་ཡུ་བ་ཅན་དང་།",
    "ཞེས་བརྗོད་པས་ཁྱེད་རང་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "སློབ་དཔོན་གྱི་ཞལ་ནས་འོད་ཟེར་སྔོན་པོ་བྱུང་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་འོད་ཀྱི་ལམ་ནས་སློབ་དཔོན་གྱི་ཞལ་དུ་ཞུགས།",
    "ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་འོད་ཀྱིས་ལམ་ནས་སློབ་དཔོན་གྱི་ཞལ་དུ་ཞུགས།",
    "ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "ཞེས་བརྗོད་པས་ཁྱེད་རང་རྣམས་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་ཕོག་པས་དྲི་མ་དང་བྲལ་བའི་རང་བཞིན་དུ་གྱུར་པ་འོད་ཀྱི་ལམ་ནས་སློབ་དཔོན་གྱི་ཞལ་དུ་ཞུགས།",
