    "དེ་རྣམས་ཡ་ཉ་མ་མེ་ད་ཡ་ཙ་ནི་ར་ཛ་ས་དོ་རུ་ཎ་ཡོ་ནི་ར་རྣམས་སུ་གྱུར།",
    "ཨོ་རུ་རུ་སླུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིརྙི་ལོ་ཙ་ནེ་སརྦ་ཨརྦ་ས་དྷ་ནེ་སྭཱཧཱ།",
    "ས་གའི་འདུག་སྟངས་གཡས་བརྐྱང་དང་།",
    "ལྷ་སྐུའི་གསལ་སྣང་རང་ཤར་བ་ན།",
    "ཨོཾ་དི་སྟ་ལོ་ཙ་ན་བི་ཀྲི་ཏཱ་ན་ན་མཧཱ་ཨཊ་སྣ་ཧ་ས་ན་དིན་དི་ལྟ་ཡ་སྭཱཧཱ།",
    "སྒྱུ་མ་ལྟ་བུ་དང་རང་སེམས་སུ་རོ་མཉམ་པར་ཤེས།",
    "དེ་ཡང་རང་གཤིན་རྗེ་གཤེད་ཀྱི་སྐུ་ཁོང་སྟོང་དུ་གསལ་བཏབ།",
    "དེ་དང་རང་སེམས་དབྱེར་མེད་དུ་བསྲེས།",
    "འོན་ཀྱང་ད་ཕན་དེ་དག་ཆ་ཚང་ལ་དེབ་གཟུགས་སུ་དཔེ་སྐྲུན་གནང་མཁན་བྱུང་མི་འདུག་གཤིས།",
    "ཇི་ལྟར་བྱ་བའི་ཚུལ་ནི་བསྙེན་མཚམས་ལ་འདུག་ཉིན་གྱི་ཞག་ཁ་ཤས་ཀྱི་གོང་ནས་བསྙེན་པ་ལ་བར་ཆད་མི་འོང་བར་ལམ་དུ་འགྲོ་བའི་ཕྱིར་དུ།",
    "རང་འདུག་པའི་གནས་མལ་ལེགས་པར་བཟོ།",
    "གཞན་བྱེད་དགོས་ཐམས་ཅད་མཚམས་ལ་འདུག་ཉིན་ཡན་ལ་གྲུབ་པར་བྱས་ཏེ།",
    "དེ་ནས་མཚམས་ཀྱི་རིང་རང་འགྲོ་དགོས་མི་དགོས་ཀྱི་ས་མཚམས་སུ་འགོམ་ཡུག་མི་འགྲོ་བའི་སར་ས་ཡུལ་འོས་འགབ་ཡོད་ན་ཕྱོགས་བཞི་དང་མེད་ན་སྒོ་མདུན་ལྟ་བུར་མཚམས་ཐོ་སློང་།",
    "ཐུན་གྱི་སྐབས་སུ་བཟའ་བཏུང་དང་འགྲོ་འདུག་དང་བྱ་བྱེད་དང་གཏམ་སྨྲ་བ་སོགས་མི་བྱ་བར་ངག་བཅད་བྱ།",
    "དེ་ནས་མཚམས་ཀྱི་རིང་རང་ཉིད་འགྲོ་འདུག་བྱེད་དགོས་མ་དགོས་ཀྱི་ས་མཚམས་སུ་ས་ཡུལ་འོས་འགབ་ཡོད་ན་ཕྱོགས་བཞིར་ཐོ་བཞི་བརྩིགས་ལ་རྒྱལ་ཆེན་བཞིར་བསྐྱེད་པ་དང་མཆོད་གཏོར་ཕུལ་ཏེ་འཕྲིན་ལས་འཆོལ་བ་སོགས་བྱ།",
    "དེ་ནས་སྟན་ལ་འདུག་སྟེ།",
    "དེ་ལྟར་ཐུན་གྱི་ངོ་བོ་ལ་ཧ་ཅང་མྱུར་བ་དང་ཧ་ཅང་ངལ་བ་དང་ཡི་གེ་ཟུར་ཉམས་པ་སོགས་ཀྱི་སྐྱོན་དང་བྲལ་ཞིང་ཡིད་གཞན་དུ་མ་གཡེང་བར་བཟླས་པ་རྣམས་གྲངས་སུ་གཞུག་པ་ཡིན་གྱི་དེ་ལས་གཞན་དུ་བཟླས་པ་རྣམས་གྲངས་སུ་མི་གཞུག་པར་གསུངས་ཀྱང་ཐུན་མཚམས་སུ་ཡང་འགྲོ་འདུག་སྤྱོད་ལམ་ཐམས་ཅད་ཀྱི་སྐབས་སུ་སྔགས་བཟླས་ན་སྡིག་སྒྲིབ་དག་པ་དང་བར་ཆོད་མི་འཇུག་པ་སོགས་ཀྱི་ཕན་ཡོན་ཡོད་དེ།",
    "ཉལ་དང་མ་ཉལ་འདུག་པའམ།",
    "འཇིགས་བྱེད་དང་བདེ་མཆོག་སོགས་ལ་རང་སྔགས་ཀྱི་མཐར་ཧཱུྃ་ཛསྦྱར་བ་བརྗོད་པ་སོགས་སྔགས་རྒྱའི་བྱེད་ཚུལ་དུ་མ་འདུག་ཀྱང་།",
    "གཙོ་བོ་གང་རིགས་སུ་ཆོ་ག་གསུམ་བསྐྱེད་མཛད་འདུག་པས་འདིར་འཇུག་པ་བདེ་བའི་ཕྱིར་འདི་ལྟར་བྱ་སྟེ།",
    "འདི་ལ་བྷི་ཏ་བྷི་ཏ་ཟེར་བའང་འདུག་ཨོ་ཏྲ་ཊ་ཏྲ་ཊ་སརྦ་ཨཱ་ཝ་ར་ཎཱ་ནི་ཧཱུཾ་ཕཊ།",
    "སྡོམ་པ་གསུམ་དང་འགལ་བའི་བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་དང་བཀྲ་མི་ཤིས་པ་དང་ཁྱད་པར་དུ་ཡང་སྐབས་ཀྱི་མི་འདོད་པ་གང་ཡིན་གྱི་མིང་བཅུག་ནས་ཤཱནྟི་ཀུ་རུ་ཡེ་སྭཱཧཱ།",
    "ཁྲི་བཟང་པོར་འདུག་པ་སོགས་རྨི་བ་དང་།",
    "སྒྲུབ་པ་པོ་རང་ཉིད་རི་བོའམ་ཡིད་དུ་འོང་ཞིང་མཚན་ཉིད་དང་ལྡན་པའི་གནས་ལ་སོགས་པར་ཁྲུས་བྱས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་རྣམས་ཀྱང་རང་ལ་ཐིམ།",
    "ཡུམ་ཡང་རང་དམ་ཚིག་སེམས་དཔའ་ལ་ཐིམ།",
    "ཡུམ་ཡང་རང་དམ་ཚིག་སེམས་དཔའ་ལ།",
    "ཁྱད་པར་དུ་འགྲོ་འདུག་སྤྱོད་ལམ་སོགས་ཀྱི་སྐབས་ཐམས་ཅད་དུ་རང་བཞིན་མེད་པར་རྟོགས་པའི་ལྟ་བས་དྲངས་པའི་སྒྱུ་མ་ལྟ་བུའི་རྩི་དང་མ་བྲལ་བ་དང་།",
    "རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ་བདག་བསྐྱེད་རྫོགས་པར་བསྒོམ་ཏེ་ཉེར་བསྡུ་བྱས་པའི་རྗེས་སུ།",
    "བདེ་བའི་སྟན་ལ་ཚུལ་དང་མཐུན་པའི་སྤྱོད་ལམ་གྱིས་འདུག་སྟེ་འདི་ལྟར་བརྗོད་ཅིང་བསམ་པར་བྱའོ།",
    "བྲལ་བའི་དབྱིངས་དང་རང་སེམས་དབྱེར་མེད་པར།",
    "དེ་སྟེང་རང་སེམས་ཧཱིཡིག་གསལ་བར་བསྒོམ།",
    "དེ་ལས་ལངས་པའི་ཚེ་ང་ཞེས་པའི་ཐ་སྙད་བསྙོན་མེད་དུ་སྣང་ནའང་རང་ངོས་ནས་གྲུབ་པ་མི་འདུག་ལ།",
    "ཚུལ་དེས་སྒོམ་བྱེད་ཀྱི་ཤེས་པ་དང་རྟེན་བརྟེན་པའི་དཀྱིལ་འཁོར་སོགས་ཀྱང་རང་བཞིན་མེད་པར་གཏན་ལ་ཕབས་ཏེ་སྒྱུ་མ་ལྟ་བུར་འཆར་བ་ལ་བསླབ་པར་བྱ།",
    "རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "གཙང་སྦྲ་དང་ལྡན་པས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ནས་ཕྱག་གསུམ་བཙལ་ལ་གུས་པའི་སྤྱོད་ལམ་གྱིས་འདུག་ཅིང་།",
    "ཞེས་པདྨའི་འདུག་སྟངས་ཀྱིས་ཕྱག་རྒྱ་བཅས་ལ་གདན་འབུལ།",
    "ཚོགས་ཞིང་རང་གནས་སུ་གཤེགས་པར་གྱུར།",
    "རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ནས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "རང་རང་ཕྱོགས་སུ་ལེགས་པར་བཞུགས་གནས་སུ།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "པདྨའི་འདུག་སྟངས་ཀྱིས་པདྨ་དང་ཟླ་བའི་གདན་ལ་བཞུགས་པ།",
    "རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
