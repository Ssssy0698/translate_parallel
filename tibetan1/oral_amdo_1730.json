    "དེ་བཞིན་དུ་དགེ་སློང་གིས་བྱ་གར་གྱི་ཤ་བཟའ་བར་མི་བྱའོ།",
    "རབ་ཏུ་བྱུང་བ་རྣམས་ལ་སྦྱིན་པ་དག་གིས་ཤའི་བྱིན་ལེན་བསྟབས་པ་ན་དེ་ལ་ཟ་བ་པོས་འདི་དགེ་སློང་གིས་བཟར་མི་རུང་བའི་ཤ་བཅད་པ་མི་ཤ་དང་སྟག་གི་གོང་མ་དང་གླང་པོ་ཆེ་དང་རྟ་དང་ཀླུ་དང་རྨིག་གཅིག་པ་ལ་སོགས་པའི་ཤམ་ཡིན་ནམ་ཞེས་དྲི་བར་བྱ་ཞིང་།",
    "གལ་ཏེ་དང་པོས་དྲི་བ་ཉམས་ཏེ་མ་དྲིས་ན་དེའི་འོག་མའི་དགེ་སློང་གིས་དྲི་བར་བྱ་བའོ།",
    "རབ་ཏུ་བྱུང་བས་བལ་གླང་མོ་དང་བུད་མེད་ཀྱི་འོ་མ་བཏུང་བར་མི་བྱའོ།",
    "བཙུན་པ་བུད་མེད་ཀྱི་འོ་མ་འཚལ་དུ་རུང་ངམ།",
    "འདིར་གཞུང་ནི་བཙུན་པ་རེ་ཞིག་ཞུན་མར་དང་འབྲུ་མར་སྐྱེམས་དང་ལྷན་ཅིག་འདྲེས་པར་གྱུར་ན་འཚལ་དུ་རུང་ངམ།",
    "དགེ་སློང་གིས་ཏིལ་བྱིན་ལེན་བྱས་ཏེ་བཙགས་ན་དེའི་ཏིལ་མར་གཟོད་བྱིན་ལེན་བྱ་དགོས་ལ།",
    "རས་མ་དཀར་པོར་ཕུར་ནས་ཆང་གི་ཤུགས་དག་དང་བྲལ་བའི་སྣོད་མ་གང་བར་བཅང་བར་བྱ་ཞིང་།",
    "རེག་པ་བསྲུང་ངོ་ཞེས་བྱ་བ་ནི།",
    "ཕྱེ་མའི་ཕུར་མ་དེ་ཆང་དང་རེག་པར་མི་འགྱུར་བར་བྱ་བའི་ཕྱིར་བསྲུང་བར་བྱ་བའོ།",
    "གང་གི་ཕྱིར་རེག་པ་བསྲུང་དགོས་པ་དེའི་ཕྱིར་ཆང་གིས་མ་གང་བའི་སྣོད་ཆང་གི་ཤུགས་དང་བྲལ་བ་ཉིད་ཀྱི་ནང་དུ་དཔྱངས་ཏེ་གཞུག་པར་བྱའོ།",
    "གཞན་དུ་ན་གྱེན་དུ་ལྡུད་པས་རེག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་ཕྱེ་མ་ཆང་དང་རེག་པ་བསྲུང་བར་བྱ་བ་ཡིན་ཏེ་དེ་བཞིན་དུ་རྫས་གང་གིས་བཏུང་བ་དེ་རོ་མེད་པར་བྱེད་པར་འགྱུར་བའི་རྫས་དེ་དང་རེག་པ་ཡང་བསྲུང་བར་བྱ་བ་དང་།",
    "དུས་མ་ཡིན་པར་བཏུང་བ་ལ་ཟས་དང་རེག་པ་ཡང་བསྲུང་བར་བྱ་བའོ།",
    "ཕྱེ་མ་སྐམ་པོ་ཆང་གི་དྲིས་བསྒོས་པ་དང་སྦྱར་བའི་ཆུ་དེ་ཟས་དང་རེག་པ་དེ་ལས་དེ་ལྟར་བསྲུང་བར་བྱ་བ་ཉིད་མཛེས་པ་ཡིན་ཏེ་དེ་བཟང་བའོ།",
    "གང་གི་ཕྱིར་མཛེས་པ་བཟང་བ་དེའི་ཕྱིར་རས་མ་དཀར་པོས་བཙག་པར་བྱ་བའོ།",
    "དེ་ལྟར་ཡང་དགེ་སློང་གང་ང་ལ་སྟོན་པ་ཞེས་ཟེར་བ་ཁྱེད་ཅག་གིས་ཆང་ཐ་ན་རྩྭ་མཆོག་གིས་ཀྱང་མི་བླུད་མི་བཏུང་ངོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་སྒོག་སྐྱ་བཟའ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "གོས་དག་གི་དྲི་ནི་བཀྲུ་བ་དང་དུ་བདག་གིས་བསལ་ལོ་ཞེས་བྱ་བ་ནི།",
    "ཁ་ཅིག་ལས་བླ་གབ་མེད་པ་དང་མེ་ཁང་དང་མཆོད་རྟེན་གྱི་གཞི་དང་ཁྱིམ་བདག་གི་གཞིར་ཡང་ཞེས་སོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་གིས་དེ་གཉིས་ཕྱོགས་མི་དབེན་པར་གཞན་གྱི་ལག་ཏུ་ཡང་བྱེད་དུ་མི་གཞུག་ན་རང་གིས་བྱ་བ་ལྟ་ཅི་སྨོས་ཏེ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་ཤིང་དྲུང་ལ་སོགས་པ་དང་བླ་གབ་མེད་པ་ལ་སོགས་པ་དེར་གཡོས་དང་བཙོ་བ་གཞན་བྱེད་དུ་ཡང་མི་གཞུག་སྟེ།",
    "རུང་བའི་ཁང་པ་བྱིན་གྱིས་བརླབས་པའི་དུས་གཅིག་ནི་རུང་བའི་ཁང་པ་དེ་ཉིད་ཐོག་མའི་རྩིག་པའི་ཚེ་དང་པོ་སོ་ཕག་གི་གཅལ་འགྲེམས་པའི་ཚེའོ།",
    "དུས་བཞི་པོ་དེ་དག་ལས་གང་ཡང་རུང་བར་བྱིན་གྱིས་བརླབས་ཀྱང་རུང་གི།",
    "ཕྱིན་པ་དེ་དག་གིས་ཕྱིན་པ་ལས་གཞན་པའི་བྱ་བ་ཆུ་བཙག་པ་དང་གཙུག་ལག་ཁང་བསྒྲོ་བ་ལ་སོགས་པ་ཇི་སྲིད་དུ་མ་བརྩམས་པ་ཚུན་ཆད་དོ།",
    "དང་པོ་གཉིས་ལ་ནི་གང་ཟག་གིས་ཀྱང་ངོ་ཞེས་བྱ་བ་ནི།",
    "ཕྱིས་ལས་སར་པ་དང་བཅས་པ་ཉིད་དོ་ཞེས་བྱ་བ་དེ་གཉིས་ཀྱི་དུས་སུ་ནི་གང་ཟག་གིས་ཀྱང་ཕྱིན་གྱིས་བརླབ་ཏུ་རུང་བའོ།",
    "གང་ཟག་ཇི་ལྟ་བུས་ཤེན་དེའི་ཕྱིར་ལག་གི་བླས་སོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དང་པོ་ཤོས་ལ་ནི་འབའ་ཞིག་གིས་ཀྱང་ངོ་ཞེས་བྱ་བ་ནི།",
    "དང་པོ་གཉིས་ལས་ཀྱང་དང་པོ་ཤོས་ཏེ་དང་པོ་སོ་ཕག་འགྲེམས་པའོ་ཞེས་བྱ་བའི་དུས་དེར་ནི་གང་ཟག་གི་བླ་འབའ་ཞིག་གིས་ཀྱང་བྱིན་གྱིས་བརླབ་ཏུ་རུང་བའོ།",
    "འདིར་གང་ཟག་གིས་བྱིན་གྱིས་བརླབ་པའི་ཆོ་ག་དང་སྔགས་ཀྱང་གཞུང་དེ་ཉིད་ཡིན་ནོ།",
    "གཉིས་པ་ལ་ནི་དགེ་སློང་རབ་ཏུ་མང་པོ་དག་གིས་སེམས་བསྡུ་བས་སོ་ཞེས་བྱ་བ་ནི།",
    "ཕྱིས་ལས་སར་པ་དང་བཅས་པ་ཉིད་དོ་ཞེས་བྱ་བའི་དུས་དེར་ནི་དགེ་སློང་རབ་ཏུ་མང་པོ་དག་གིར་རུང་བའི་ཁང་པར་སེམས་བསྡུ་བས་བྱིན་གྱིས་བརླབ་པར་བྱ་བ་སྟེ།",
    "གཅིག་གིས་གཙུག་ལག་ཁང་དུ་མའི་བྱ་བ་བྱེད་པ་ལ་མི་མཛེས་པ་མེད་དོ་ཞེས་བྱ་བ་ནི།",
    "རུང་པའི་ཁང་པ་གཅིག་གིས་གཙུག་ལག་ཁང་དུ་མའི་བྱ་བ་ནང་དུ་བཅོ་བ་དང་ནང་དུ་ཞག་ལོན་པ་དག་བྱེད་པ་ལ་ནི་མི་མཛེས་པ་མེད་དེ་མཛེས་པ་ཁོ་ནའོ།",
    "དེས་གཙུག་ལག་ཁང་ཐམས་ཅད་ན་གནས་པ་དག་གིས་ནང་དུ་ཞག་ལོན་པ་དང་ནང་དུ་བཙོས་པ་ལ་སོགས་པའི་བྱ་བ་བྱེད་ན་དེ་མི་མཛེས་པ་མ་ཡིན་པར་ཤེས་པར་བྱ་བའོ།",
    "གཅིག་གིས་གཙུག་ལག་ཁང་དུ་མའི་བྱ་བ་བྱེད་པའི་རུང་བའི་ཁང་བ་འདིའི་མིང་ནི་བ་ལང་གི་གནས་ལྟ་བུ་ཞེས་བྱ་སྟེ།",
    "རུང་བའི་ཁང་པ་གཅིག་ལ་གཙུག་ལག་ཁང་མང་པོ་བ་ལང་ལྟར་ཁ་ཐ་དད་པ་དག་ནས་འཁོད་པ་དེ་ནི་བ་ལང་གི་གནས་ལྟ་བུའོ།",
    "འདིར་གཞུང་ནི་བ་ལང་གི་གནས་ལྟ་བུ་གང་ཞེ་ན།",
    "གནས་པའི་གཞི་ཁ་ཐ་དད་པ་དག་ནས་འཁོད་པ་ཞེས་བསྟན་པའི་རུང་བའི་ཁར་པ་དེ་ནི་གཙུག་ལག་ཁང་གི་གནས་འབྲེལ་པ་མེད་པ་ཐ་དད་པར་གྱུར་པ་དག་གི་རུང་བའི་ཁང་པ་ཉིད་དུ་བསྟན་པ་མ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "འདི་ལྟར་གཙུག་ལག་ཁང་གི་གནས་འབྲེལ་པས་བྱིན་གྱིས་བརླབ་པའི་རུང་པའི་ཁང་པ་ཉིད་ཡིན་ནོ།",
    "རང་གིས་བཙོས་པ་དང་།",
    "དགེ་སློང་གིས་བཙོས་པ་དང་།",
    "མུ་གེའི་ཚེ་དགེ་སློང་གིས་བཙོས་པ་དང་ལག་ཉར་བླངས་པ་དང་བྱིན་ལེན་མ་བྱས་པ་དག་བཟའ་བར་བྱའོ།",
    "རང་གི་ཟས་ཀྱི་གནས་ནས་ལྷག་མ་དེ་དྲང་བ་ལ་ལས་མི་རིགས་པར་སེམས་པ་གང་ཡིན་པ་དེ་བསལ་བའི་ཕྱིར་དེ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ནགས་ཀྱི་ཤིང་དག་གི་རུས་པ་ཡང་ཤིང་ཏོག་རུས་པ་ཅན་དག་ཡིན་པས།",
    "དེ་ལ་རེ་ཞིག་འབྲེལ་པ་བསྟན་པར་བྱ་སྟེ།",
    "ཞིང་ནི་གྲོང་གི་ཡུལ་གཅིག་ཡིན་པའི་ཕྱིར་རོ།",
    "ཞིང་གི་ཐེག་ཤས་བཙལ་བར་བྱ་བའོ།",
    "ཐབ་མོ་ལ་སོགས་པ་བླག་ཅོར་གྱི་སྒྲ་གཙུག་ལག་ཁང་དུ་མི་འབྱུང་མི་གྲག་པའི་ཕྱོགས་དེར་ལྷ་འབངས་ཀྱི་སྡུམ་པ་བྱེད་དུ་གཞུག་པའོ།",
    "ལྷ་འབངས་དང་རྩེ་རྒོད་ལ་སོགས་པ་མི་བླས་ཇི་སྙེད་དགོས་པ་གཙུག་ལག་ཁང་གི་ནང་དུ་འཇུག་པར་བྱའི།",
    "འདིར་གཞུང་ནི་བཙུན་པ་དགེ་སློང་གིས་ལོངས་སྤྱོད་མཆོག་བླང་དུ་རུང་ངམ།",
    "གླང་པོ་ཆེ་དང་རྟ་དང་རྔ་མོ་དང་བོང་བུ་དང་ར་དང་ལུག་དང་།",
    "ཁ་གཟར་དང་ཚྭ་ཁུག་བཅང་བར་བྱའོ་ཞེས་བྱ་བ་ནི་གང་ཟག་གིས་ཀྱང་ངོ།",
    "དེ་གཉིས་དང་ཕུལ་བའི་བཏུང་ཕོར་ལས་གཞན་པའི་ཁར་བའི་སྣོད་གང་ཟག་གིས་བཅང་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཁ་གཟར་དང་ཚྭ་ཁུག་དེ་གཉིས་དང་ཕུལ་བའི་བཏུང་ཕོར་ལས་གཞན་པའི་ཁར་བའི་སྣོད་དག་གང་ཟག་གིས་བཅང་བར་མི་བྱའོ་ཞེས་བྱ་བ་བདག་གིར་མི་བྱ་བའོ།",
    "གང་ཟག་གིས་ཀྱང་གཡོག་བཅད་བར་བྱ་བའོ།",
    "དགེ་སློང་མ་རྣམས་ཀྱིས་ནི་བུ་མོ་དག་བླང་བར་བྱ་བའོ།",
    "དེ་དག་གིས་དབུལ་བར་བརྩམས་པ་དང་།",
    "བྱིས་པ་དེ་དག་གི་ཉེ་དུས་གོས་ལ་སོགས་པ་དག་དགེ་སློང་ལ་ཕུལ་བ་བླང་བར་བྱའོ།",
    "དེའི་ཉེ་དུ་དག་གིས་མཇུག་ཏུ་བྱིས་པ་ཕྱིར་ལེན་པའི་ཚེ་བྱིས་པའི་རིན་ཉིད་དུ་གོས་ལ་སོགས་པ་ཕུལ་བ་ཡད་བླང་བར་བྱ་སྟེ།",
    "དེ་དག་གིས་བྱས་པ་ཤེས་པས་ཀྱང་ངོ་ཞེས་བྱ་བ་ནི།",
    "བྱིས་པ་དེ་དག་གིས་བྱས་པ་ཤེས་པས་དགེ་སློང་ལ་གོས་ལ་སོགས་པ་ཕུལ་བ་ཡང་བླང་བར་བྱའོ།",
    "དགེ་སློང་གིས་བྱིས་པ་དེ་དག་ཡོངས་སུ་བསྐྱངས་པའི་རིན་དང་རྔན་པ་དང་གླ་བདའ་བར་མི་བྱའོ།",
    "ཤིང་ཏོག་གི་རྙེད་པ་བདག་གིར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གཞན་གྱིས་ཤིང་ཏོག་གི་རྙེད་པ་ཕུལ་བ་དག་བླང་བར་བྱའོ།",
    "འདིར་གཞུང་ནི་བྲམ་ཟེ་དང་ཁྱིམ་བདག་དང་བ་ཅན་དག་གིས་དགེ་སློང་དག་ལ་ཤིང་ཏོག་དག་འབུལ་བར་བྱེད་བ་ན།",
    "བླང་བར་བྱ་ཞིང་བླངས་ནས་དགེ་སློང་དག་གམ་ཁྱིམ་པ་དག་གིས་བྲིམ་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་དག་གི་སྣོད་ཀྱང་ངོ་ཞེས་བྱ་བ་ནི།",
    "ཞུན་མར་ལ་སོགས་པ་དེ་དག་གི་སྣོད་བུམ་པ་ལ་སོགས་པ་ཡང་འབུལ་ན་བདག་གིར་བྱ་བའོ།",
    "ཞུན་མར་ལ་སོགས་པ་དང་དེ་དག་གི་སྣོད་དག་གོ།",
    "འདིར་གཞན་བྱེད་དུ་གཞུག་པ་ཡིན་གྱི་རང་གིས་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "དགེ་སློང་གིས་བཙོས་པའི་ཉེས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ལྷུང་བཟེད་ཀྱི་ནང་དུ་བསོད་སྙོམས་བླུགས་པ་གང་གིས་གཡོགས་པར་བྱེད་པ་དེ་ནི་ལྷུང་བཟེད་ཀྱི་ཁ་གཡོགས་ཞེས་བྱ་སྟེ།",
    "འདི་དང་ཁར་བའི་སྣོད་བཅང་བ་ལ་ཐུན་མོང་མ་ཡིན་པ་ཉིད་དུ་དོགས་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཕུལ་བའི་བཏུང་ཕོར་ལས་གཞན་པའི་ཁར་བའི་སྣོད་བཅང་བར་མི་བྱའོ་ཞེས་སྨོས་པ་དེ་ལ་དགེ་སློང་དང་དགེ་སློང་མ་དག་གི་ཐུན་མོང་མ་ཡིན་པ་ཉིད་དུ་དོགས་པར་མི་བྱ་བ་སྟེ།",
    "ཁ་གཟར་དང་ཚྭ་ཁུག་དག་དང་ཕུལ་བའི་བཏུང་ཕོར་ལས་གཞན་པའི་ཁར་བའི་སྣོད་བདག་གིར་མི་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདིར་གཞུང་ནི་སྐྱེ་དགུའི་བདག་མོ་ཆེན་མོ་གླད་པ་ན་ནས།",
    "ཅི་ཞིག་གིས་ཤེ་ན།",
    "ཆུ་མེད་ན་ཞོ་ག་ཆུ་དང་ཆུར་ཁུ་དང་རྩབ་མོ་ལ་སོགས་པས་རྐང་པ་དག་བཀྲུར་རུང་བའོ།",
    "རྒན་པའི་མཐའ་རེ་རེར་སྤྱི་བུངས་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གྲལ་ཚར་དུ་ཡོད་པའི་རྒན་པའི་མཐར་རེ་རེར་བཟའ་བ་དང་བཅའ་བའི་འདྲི་མ་སྒོའི་ཟས་ཀྱི་སྤྱི་བུངས་རེ་རེ་བྱའོ།",
    "གཙང་སྦྱོར་བ་ལ་སོགས་པ་ཟས་ཀྱི་ཞལ་ཏ་བྱེད་པ་དག་གིས་ཇེ་དང་པོར་འཚལ་མ་ཟོས་ཏེ་བྲིམ་པ་ལ་སོགས་པའི་ལས་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དགེ་སློང་དག་གིས་འདུས་པ་ཆེན་པོའི་ཚེ་དགེ་སློང་དག་བསྐོ་བར་བྱའོ།",
    "ཅི་ཞིག་གི་ཕྱིར་ཞེ་ན།",
    "ལྷུང་བཟེད་ཀྱི་གཞི་ལ་རྐང་པས་རེག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ལྷུང་བཟེད་ཀྱི་གཞི་ཡང་མིག་དང་ཞ་ཉེའི་དབྱར་འདབ་དང་བྱུག་རིས་དང་རྩྭ་ལ་སོགས་པ་དག་ལ་རྐང་པས་རེག་པར་མི་བྱའོ།",
    "གང་ལ་མགྲོན་དུ་བོས་པ་དེ་ལས་གཞན་རྙེད་པ་བདག་གིར་བྱེད་པ་ལ་མི་རིགས་པ་ཉིད་མེད་དོ་ཞེས་བྱ་བ་ནི།",
    "ཟས་གཞན་ལ་མགྲོན་དུ་པོས་པས་གཞན་རྙེད་པ་བདག་གིར་བྱེད་པ་ལ་མི་རིགས་པ་མེད་དོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རང་གི་ཟས་ལ་གཞན་མནོས་པ་ཉེས་པ་མེད་དོ་ཞེས་བྱ་བ་ནི།",
    "རང་གི་ཟས་ཟ་བའི་ཚེ་གལ་ཏེ་གཞན་གྱིས་ཟས་གཞན་སྦྱིན་པར་བྱེད་ན་དེ་མནོས་པའི་ཉེས་པ་མེད་པ་ཉིད་ཡིན་པའོ།",
    "དགེ་སློང་དག་གིས་སྡིག་བྱུང་བའི་གྱད་རྣམས་ལ་དྲིས་པ་དང་།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "སྡིག་བྱུང་བའི་གྱད་རྣམས་ཀྱིས་མགྲོན་དུ་བོས་པའི་དགེ་སློང་རྣམས་ལ་གྱད་ཀྱི་སྣ་ཆེན་པོ་ལ་གཏོགས་པ་སྣང་བྱེད་ཀྱིས་བཅའ་བ་དང་བཏུང་བ་དག་བྲིམས་པ་སྦྱིན་བདག་གིས་གནང་བ་དེ་ནི་སྦྱིན་བདག་གཞི་བོའི་ཁོངས་སུ་གཏོགས་པ་དང་འདྲའོ།",
    "བསམས་པའི་དོན་གྱིས་སྒྲའི་སྦྱོར་བ་རྣམ་པར་གཞག་གི་གྲགས་པས་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "འདི་ལྟར་བསོད་སྙོམས་ལ་དེ་སྐད་གསུངས་པ་ཡིན་མོད་ཀྱི།",
    "འདོད་པས་བསོད་སྙོམས་ལ་རེག་པ་ཞེས་བྱ་བ་ནི།",
    "ལ་ལག་གིས་འཛིན་པའོ།",
    "འདིར་གཞུང་ནི་དགེ་སློང་གིས་ཟོས་ནས་དུད་འགྲོ་ལ་ཁམ་མི་གཞག་པར་མི་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཁྱོད་ཁོ་ནས་འདི་བཟའ་བར་བྱའོ་ཞེས་དད་པས་སྦྱིན་པར་བྱ་བ་ཉིད་ཀྱི་མགྲོན་དུ་བོས་པ་ལ་བཟའ་བའི་ཕྱིར་ཉེ་བར་གཞག་པའི་ཟས་ལས་ནི་རྫོགས་ཀྱང་སྦྱིན་པར་མི་བྱའོ།",
    "དེ་དག་གི་ཆོ་ག་རྗེས་སུ་འབྲང་བས་སྔ་དྲོ་ལ་སོགས་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "གཉུག་མར་གནས་པ་དེ་དག་གི་ཟས་ཀྱི་ཆོ་གའི་རྗེས་སུ་འབྲང་བས།",
    "དེ་དག་ལ་གཏོར་མ་སྦྱིན་པ་ནི་སྔ་དྲོའམ་གུང་ཚིགས་སམ་ཕྱི་དྲོའམ་མཚན་མོ་ལ་སོགས་པར་གང་རིག་པར་བྱའོ།",
    "ཁ་ཅིག་གི་ཆོ་ག་ཡང་གཞན་ཡིན་ན།",
    "དེ་དག་ཆོ་ག་ཐ་དད་པ་ཉིད་ལ་དྲི་དང་མེ་ཏོག་དང་བདུག་པ་དང་གཏོར་མ་ལ་སོགས་པ་ཡང་རང་རང་གི་ཆོ་ག་བཞིན་ཐ་དད་པར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཨ་མྲ་རུས་པ་མ་ཆགས་པ་ཉིད་ཀྱི་གནས་སྐབས་སུ་བཟའ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཤིང་ཏོག་ཨ་མྲ་རུས་པ་མ་ཆགས་པའི་གནས་སྐབས་སུ་བཟའ་བར་མི་བྱའོ།",
    "གསོ་མ་ལ་སོགས་པ་དེ་དག་གི་ཐུག་པ་དག་བསྟེན་པར་བྱ་བ་ཉིད་མ་ཡིན་པར་དོགས་པར་མི་བྱ་བ་སྟེ།",
    "ཟས་ཟོས་པའི་རྗེས་ལ་ལྷག་མ་ཅན་གྱི་ལྷུང་བཟེད་ལ་སོགས་པའི་བཀྲུ་བཤལ་ཡང་གནས་པ་དག་གི་ལས་ཡིན་ནོ།",
    "ཟོས་ནས་ཀྱང་གནས་པ་དག་གིས་སྣོད་དང་བྱ་མ་བུམ་དག་བཀྲུས་ཏེ་བསྐུར་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གཞན་གཉིས་པ་ལ་སོགས་པ་དང་ལྷན་ཅིག་སྣོད་གཅིག་གི་ནང་དུ་ཟས་བཟའ་བར་མི་བྱ་བའོ།",
    "རང་གིས་གཞུག་གོ་ཞས་བྱ་བ་ནི།",
    "ལྷན་ཅིག་ཟ་བའི་ཚེ་དགེ་སློང་གཞན་གྱིས་ལག་བཏག་པ་ན་རང་གིས་ལག་གཞུག་པར་བྱ་བའོ།",
    "ལམ་འཇིགས་པ་དང་བཅས་ཤིང་འགྲོན་པ་དག་ཀྱང་ཐལ་ལམ་ཟས་བཅད་དུ་མི་རུང་ན་ལྷུང་བཟེད་བྱིན་གྱིས་བརླབས་པ་མི་གཏོང་བར་དེ་དག་དང་ལྷན་ཅིག་སྣོད་གཅིག་ཏུ་བཟའ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རང་གི་ལྷུང་བཟེད་བྱིན་ལེན་བྱས་ཏེ།",
    "སྒྲེན་མོ་དང་གོས་གཅིག་པས་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེ་གཡོག་དག་གིས་སྐྱོར་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "སྒྲེན་མོས་བཟའ་བར་མི་བྱའོ།",
    "དེ་གཡོག་གིས་གོས་ཀྱིས་སྐྱེར་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདི་ནི་སྒྲེན་མོའི་སྐབས་དང་གོས་གཅིག་པའི་སྐབས་གཉི་གར་གཏོགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཟན་གྱི་ཕྱིར་འདུག་ཅིང་བཀད་པའི་གང་ཟག་གིས་དངོས་པོ་འདི་བྱིན་ཅིག་ཅེའམ།",
    "ཟས་འདི་ཞིང་ལ་སོགས་པ་ལ་བརྟེན་ཏེ་བྱུང་བ་དང་དེ་དག་ལ་བརྟེན་ནས་སྲེད་པ་ལ་སོགས་པ་ཀུན་ནས་ཉོན་མོངས་པ་དག་འབྱུང་པའི་ཕྱིར་རོ།",
    "གསུམ་པ་ནི་སྲིན་བུ་དག་གིས་བཟའ་བར་འགྱུར་བ་དང་།",
    "བཟའ་བ་དེའི་དོན་དུ་རོལ་མོ་བྱེད་དུ་མི་འཇུག་གོ་ཞེས་བྱ་བ་ནི།",
    "ཟས་བཟའ་བ་དེའི་དོན་དུ་གླུ་གླིང་དང་སིལ་སྙན་ལ་སོགས་པའི་རོལ་མོ་བྱེད་དུ་གཞུག་ཅིང་བཟའ་བར་མི་བྱ་བའོ།",
    "དགེ་སློང་གིས་རོལ་མོ་བྱེད་དུ་བཅུག་པ་བཞིན་དུ་བཟའ་བར་མི་བྱའོ།",
    "ཁ་ནས་རོལ་མོ་བྱེད་པ་ཉིད་ལ་ནི་ཉེས་བྱས་ཕྲ་མོར་འགྱུར་རོ།",
    "ཟོས་ནས་གཙུག་ལག་གི་ཚིགས་སུ་བཅད་པ་གདོན་ཏོ་ཞེས་བྱ་བ་ནི།",
    "གང་གིས་དེ་དག་བྱ་ཞེ་ན།",
    "གལ་ཏེ་དགེ་སློང་དག་དུ་མ་ཉིད་ཡིན་ན་དེའི་ཚེ་དེ་དག་གི་གྲལ་གྱི་དང་བོ་པས་དེ་དག་བྱའོ།",
    "འཆད་པར་བྱེད་པ་གང་གི་འཁོར་དུ་བདག་ཉིད་བྱིན་པ་དེ་ལ་ཞུས་ཏེ་འཁོར་དེ་ཡང་འགྲོ་བར་བྱ་བའོ།",
    "ཡོན་འཆད་པ་ན་དགའ་བོ་དང་ཉེ་དགའ་དག་གི་མིང་སྨོས་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གང་གི་ཕྱིར་སྒྲེགས་པ་དང་འབྲེལ་པ་དེ་ཟས་ཡིན་པ་དེའི་ཕྱིར་མིད་པ་གཉིས་པ་ལས་གཞན་བ་མིད་པ་གཅིག་པས་དུས་མ་ཡིན་པ་ཉིད་མ་ཡིན་པ་དང་ཟས་སྤངས་པའི་ཚེ་སྒྲེགས་པ་འབྱུང་ན་བ་བཀྲུ་བར་བྱའོ།",
    "གང་དུ་གང་ཟག་གིས་ཀྱང་ཞལ་ཞལ་ལ་སོགས་པས་བྱི་དོར་བྱས་པའི་ཕྱོགས་དེར་ཡང་མཆིལ་མ་དོར་བར་མི་བྱའོ།",
    "འདིར་གཞུང་ནི་དགེ་སློང་གིས་ཟ་བའི་མདུན་དུ་མཆིལ་མ་དོར་བར་མི་བྱའོ།",
    "དགེ་སློང་གིས་མ་བཤམས་པའི་ཕྱོགས་སུ་ཡང་མཆིལ་མ་དོར་བར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེར་སོ་ཕག་གི་ཕྱེ་མའམ་བྱེ་མའམ་ཐལ་བ་དག་གིས་གཅལ་བླུགས་སོ་ཞེས་བྱ་བ་ནི་མཆིལ་མ་སྣོད་དེར་རོ།",
    "མི་བྲལ་བར་བྱ་བའི་ཕྱིར་གཙུག་ལག་ཁང་གི་གྲྭའི་ཀ་བ་བཞི་པོ་དག་གི་ངོས་སུ་ཡང་མཆིལ་མ་སྣོད་དག་གཞག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཤིང་ལྗོན་པ་དེ་དག་གི་དྲུང་དུ་ནི་མ་གཏོགས་སོ།",
    "གལ་ཏེ་གཙུག་ལག་ཁང་དུ་ནི་ནུབ་བམ་བྱང་གི་ཕྱོགས་སུའོ་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་གཙུག་ལག་ཁང་དང་འབྲེལ་བར་ཆབ་ཁུངས་བྱད་ན་གཙུག་ལག་ཁང་གི་ནུབ་བམ་བྱང་གི་ཕྱོགས་སུ་བྱའོ།",
    "གཙུག་ལག་ཁང་གི་སྒོ་ཕྱོགས་བཞི་གར་ལྟ་ཡང་རུང་སྟེ།",
    "འདིར་གཙུག་ལག་ཁང་གི་རྒྱབ་ཀྱི་ཕྱོགས་སམ་ཡས་ཀྱི་གཡོན་རོལ་གྱི་ཕྱོགས་ཀྱི་ཆབ་ཁུངས་བྱའོ།",
    "གསོང་ལྡོང་ངམ་ཕུག་རྡུགས་སོ་ཞེས་བྱ་བ་ནི།",
    "གསོང་ལྡོང་ཞེས་བྱ་བ་ནི་ཁུང་ལ་སྟོར་ཁུང་གི་ཝ་བཙུགས་པའོ།",
    "ཁུང་ལ་སྟོར་ཁུང་གི་ཝ་མ་བཙུགས་པ་ཁུང་ཉི་ཚེ་བརྐོས་པའོ།",
    "ཆབ་ཁུང་ས་ཡང་ཐོག་ནས་བཏོད་ན་འོག་གི་ཁུང་གི་ཕྱོགས་སུ་ཤིང་ཚེར་མ་ཅན་དག་བསྐྱེད་པར་བྱ་བའོ།",
    "ཆབ་ཁུང་སའི་ནང་གིས་ས་གཞིའི་སྟེང་དུ་དོང་གི་བུ་གུའི་ཉེ་འཁོར་གཡས་གཡོས་སུ་འདུག་པའི་རྐང་པ་གཉིས་བརྟེན་པའི་རྐང་རྟེན་རྟུག་ཤིང་ངམ་རྡོ་ལེབ་བམ་སོ་ཕག་དག་གཞུག་པར་བྱ་བའོ།",
    "ཆབ་ཁུང་སའི་ནང་དུ་འཇུག་པར་འདོད་པའི་གང་ཟག་གིས་སེ་གོལ་དང་ལུད་པ་ལ་སོགས་པའི་སྒྲ་དབྱུང་བར་བྱ་བའོ།",
    "ཁུང་གི་དཀྱིལ་དུ་བབ་པར་རོ།",
    "དེ་དང་འབྲེལ་བའི་དོན་ལས་གཞན་པས་དེ་དག་གི་དྲུང་དུ་འདུག་པར་མི་བྱའོ།",
    "དགེ་སྐོས་ཀྱིས་ཉི་མ་རེ་རེ་ཞིང་བྱི་དོར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ལོ་མ་ནི་ཕྱི་བར་བྱ་བའི་བོད་རྡོག་ལ་སོགས་པ་དག་གི་དཔེ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "དེའི་ཕྱིར་འོག་གཞིར་གྱོ་མོའོ་ཞེས་བྱ་བ་ནི།",
    "གང་གི་ཕྱིར་ས་སྣང་པ་བསྲུང་བར་བྱ་བ་དེའི་ཕྱིར་ཁྲིའུའི་བུ་གུ་དེའི་འོག་གཞིར་གྱོ་མོ་གཞུག་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "གྱོ་མོའོ།",
    "གྱོ་མོ་དེ་དྲིང་བར་མི་འགྱུར་བར་བྱ་བའི་ཕྱིར་དུས་དུས་སུ་བཀྲུ་བ་ལ་སོགས་པ་བྱ་བའོ།",
    "ཡུངས་མར་གྱིས་བསྐུ་བ་དེའི་དུས་ཀྱི་ཆེད་དུ་གྱོ་མོའི་འཐེབ་གཞན་བསྒྲུབ་པར་བྱ་བའོ།",
    "དུས་དེ་ལྟ་བུས་ན་གྱོ་མོ་དེ་ཉིད་ཀྱི་བཀྲུ་བ་ལ་སོགས་པའི་དོན་འགྲུབ་པར་འགྱུར་རོ།",
    "ཅི་ཞིག་གིས་དེ་ཕྱི་བར་བྱ་ཞེ་ན།",
    "དེ་དག་གིས་ཕྱི་བར་བྱའོ།",
    "སྔར་གཞག་པའི་ས་མ་འདྲེས་པ་དག་གིས་ཕྱིས་བཀྲུ་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "འཐོར་འཐུང་གིས་རྐང་རྟེན་དག་ཟེར་མ་དག་གིས་མི་ཉམས་པ་ཉིད་དུ་ཁད་ཀྱིས་དལ་བུས་དལ་བུས་སོ་ཞེས་བྱ་བ་ནི།",
    "འཐོར་འཐུང་བྱ་བའི་ཆེད་དུ་འཐོར་འཐུང་གི་སར་རྐང་རྟེན་བྱས་པ་དག་ཁྲུས་བྱེད་པའི་ཆུའི་ཟེར་མ་དག་གིས་མི་ཉམས་པ་ཉིད་དུ་ཁད་ཀྱིས་དལ་བུས་དལ་བུས་བཀྲུ་བཤལ་བྱ་བའོ།",
    "བདུན་པོ་དག་གིས་གཡོན་པའོ་ཞེས་བྱ་བ་ནི།"
  ]
}