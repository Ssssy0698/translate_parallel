    "རེ་ཞིག་འཇིག་རྟེན་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གི་ཕྱིར་པདྨ་ལ་སོགས་པ་རྣམས་ཀྱི་རྩ་བ་དང་འདབ་མ་དང་ཡལ་ག་དང་།",
    "ཐམས་ཅད་རྒྱུ་ལ་རེ་མེད་པར།",
    "སྣ་ཚོགས་གང་གིས་བྱེད་པ་ཡིན།",
    "སྣ་ཚོགས་གང་གིས་སྤྲུལ་པ་ཡིན།",
    "གང་གི་ཕྱིར་དེ་རྣམས་ཀྱི་ཁྱད་པར་སྣ་ཚོགས་པ་ཉིད་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གང་གང་གིས་རྗེས་སུ་འགྲོ་བ་ལྡོག་པའི་རྗེས་སུ་བྱེད་པར་རྟོགས་པ་དེ་ཉིད་ཀྱི་འབྲས་བུ་ཡིན་ཏེ།",
    "རྒྱུ་དབྱེ་གང་གིས་ཞེས་པ་ལ་སོགས་པ་དོགས་པ་སྤང་བ་སྨོས་ཏེ།",
    "གང་གིས་བྱས་ཞེས་པ་ནི་སུ་ཞིག་བྱས་ཤིང་།",
    "གང་གིས་རྒྱུའི་དབྱེ་བ་ཁྱད་པར་ཡིན་ནོ་ཞེས་བརྗོད་ནའོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ན་འབྲས་བུ་ཕྱིན་ཅི་ལོག་པ་ཡང་རང་གི་ལས་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཆེད་དུ་གཞན་གྱིས་དོགས་པ་ཅིའི་ཕྱིར་ཞེས་པ་ལ་སོགས་པ་སློང་བ་སྨོས་ཏེ།",
    "གང་གིས་ན་ལྷན་ཅིག་བྱེད་པའི་ཁྱད་པར་གྱིས་སྐྱེད་པ་འབྲས་བུ་སྐྱེས་པའི་ཡོན་ཏན་གྱི་ཁྱད་པར་ཕན་ཚུན་ཡོངས་སུ་གྱུར་པའི་ལྷག་པར་གྱུར་པ་ནི་གེགས་དང་མ་ཚང་བ་མི་སྲིད་ན།",
    "དེ་ལྟ་བས་ན་ཕྱིན་ཅི་མ་ལོག་པའི་འབྲས་བུ་སྐྱེད་པར་ཡང་རང་གི་རྒྱུའི་ནུས་པས་སྐྱེད་པ་ཉིད་ཡིན་ནོ།",
    "དམ་བཅས་པ་ཙམ་གྱིས་དེ་སུ་ཞིག་གིས་ཀྱང་འཛིན་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཏན་ཚིགས་ཀྱི་བྱེད་པས་དེ་སྒྲུབ་པར་བྱེད་པ་རང་ཉིད་ཀྱིས་སླར་ཡང་རྒྱུ་དང་བཅས་པ་ཉིད་དུ་ཁས་བླངས་པའི་ཕྱིར་མོ་གཤམ་ཡང་ཡིན་ལ།",
    "བདག་གི་མ་ཡང་ཡིན་ནོ་ཞེས་སྨྲ་བ་བཞིན་དུ་དམ་བཅས་པ་ལ་རང་གི་ཚིག་གིས་གནོད་པར་འགྱུར་ཏེ།",
    "དམ་བཅའ་འབའ་ཞིག་གིས་ནི་འདི་ལ་ཅི་ཞིག་འགྱུར།",
    "ཡུལ་ལ་སོགས་པ་ངེས་པ་མེད་པར་ཐལ་བའི་ཕྱིར་ལ།",
    "སེམས་པ་མེད་པ་འབའ་ཞིག་གིས་ཆུ་དང་འདམ་ལ་སོགས་པ་འདི་རྣམས་ཀྱིས་རྣམ་པ་སྣ་ཚོགས་པ་ནུས་པ་མ་ཡིན་ཏེ།",
    "འདིས་རང་གི་ཁྱིམ་དུ་བརྟགས་པའི་གཞལ་ཡས་དགོད་པ་དང་།",
    "རང་གིས་བྱས་པའི་དམ་པ་མ་ཡིན་པའི་ལས་ཀྱི་འབྲས་བུ་ཉེ་བར་ལོངས་སྤྱོད་པས་དེ་ལ་གཏོད་པ་དང་།",
    "རང་གི་བདེ་བ་སྡུག་བསྔལ་ལ།",
    "འབྲས་བུ་ཐམས་ཅད་ལ་ཡང་དེའི་བྱེད་པ་ཁས་བླངས་པ་ལ་འདི་ཉིད་ཀྱིས་མ་ངེས་པར་ཐལ་བར་འགྱུར་རོ།",
    "འོན་ཏེ་འདོད་ཆགས་དང་མ་བྲལ་བའི་ཕྱོགས་ཡིན་ན་དེའི་ཚེ་འདི་སྐྱེ་བོ་གཞན་དང་ཐུན་མོང་བར་ཡོད་ན།",
    "གཞན་དུ་ན་དེའི་ཚེ་དེ་ལྟ་བུ་དང་མཚུངས་པ་གཞན་དེ་ཡང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་གིས་ན་དེས་སྟེན་པར་མི་བྱེད།",
    "འཇིག་རྟེན་རང་གི་ལས་ཀྱི་ཞགས་པས་མདུད།",
    "རེ་ཞིག་གི་སྨྲས་འདི་བརྗོད་པ་ཡིན་ཏེ།",
    "ཤིན་ཏུ་ཐལ་ཆེས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་མོད་ཅེས་པ་ནི་འདི་ཉིད་ཡོད་དུ་ཆུག་ཅིག།",
    "དེ་ལྟར་ཡིན་མོད་འདི་ཤིན་ཏུ་མཚོན་པར་དཀའ་བའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་བསམ་པར་ནུས་པ་མ་ཡིན་ལ།",
    "དེའི་འབྲས་བུ་བསམ་གྱིས་མི་ཁྱབ་པ་ཡིན་དུ་ཆུག་མོད།",
    "དེ་ལྟར་ན་ཡང་གང་གིས་ན།",
    "ད་ནི་ཐམས་ཅད་ཐུན་མོང་བའི་སྐྱོན་རྒྱུ་ལ་ཞེས་པ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་གང་གིས་ན་རྟག་ཏུ་མི་བྱེད་དེ།",
    "དེ་ལྟར་ན་འགའ་ཞིག་གིས་འབྲས་བུ་བརྒྱ་ལ་ཆད་པར་ག་ལ་འགྱུར།",
    "རྒྱུ་དེ་ལས་ལས་དང་ཉོན་མོངས་པ་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱི་ཐོག་མ་སྟེ།",
    "ནི་ཞེས་པ་ནི་གང་གི་ཕྱིར་ཏེ།",
    "ཅི་ཕྱིར་འགའ་ཞིག་གིས་ལྟོས་འགྱུར།",
    "རེ་ཞིག་གང་རྣམས་རྟག་པ་ཡིན་ན་རྡུལ་ཕྲ་རབ་ལ་སོགས་པ་དེ་རྣམས་ཡོད་པའི་དངོས་པོ་མ་ཚང་བ་མི་སྲིད་དོ།",
    "གང་གིས་ན་ལྷན་ཅིག་བྱེད་པའི་རྒྱུ་དང་བྲལ་བས་མི་བྱེད་དོ་ཞེས་བརྗོད་པ།",
    "གང་གི་ཕྱིར་ཐ་ག་པ་ལ་སོགས་པ་རྣམས་སྔར་ནུས་པ་མེད་པ་ཉིད་ཡིན་ལ་ཡང་ཕྱི་ནས་ཐག་བཟངས་ལ་སོགས་པའི་ཚོགས་པ་རྙེད་པ་ལས་སྔར་མེད་པའི་ཚོགས་པ་རྙེད་པ་ཐོབ་པས་སྣམ་བུ་ལ་སོགས་པ་ཚོགས་པ་འབྲས་བུ་བྱེད་པ་ཡིན་ནོ།",
    "གཞན་དུ་ན་དེ་རྣམས་ཀྱང་སྔར་དེའི་ནུས་པ་ཡོད་པ་ན་དེ་བྱེད་པར་ཐལ་བར་འགྱུར་བ་བཟློག་ནུས་པ་མ་ཡིན་པས་དཔེ་བསྒྲུབ་བྱས་སྟོང་པ་ཡིན་ནོ།",
    "གཞན་ཡང་ཚོགས་པས་བསྐྱེད་ན་ཡང་དེ་ཉིད་རྒྱུ་ཡིན་ཏེ།",
    "མེད་པའི་རང་བཞིན་ལ་མོ་གཤམ་གྱི་བུ་བཞིན་དུ་བྱེད་པའི་ནུས་པ་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "བྱེད་པ་པོ་ཞེས་བྱ་བ་ནི་རང་གི་ངོ་བོས་མི་བྱེད་པ་མ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོ་འདི་ཡང་གཉུག་མའི་ནུས་པ་སྒྲའི་བརྗོད་བྱ་ཡིན་ཏེ།",
    "མ་ཡང་ཡིན་ལ་རང་བཞིན་གྱིས་མོ་གཤམ་ཡང་ཡིན་ནོ་ཞེས་པ་འདི་ཡང་འདི་ལྟར་ལྷ་རྣམས་དགའ་བར་བརྗོད་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་རེ་ཞིག་གཞག་གོ།",
    "གང་དག་དཔྱོད་པ་ལ་སོགས་པའི་རྒོལ་བ་རྣམས་རྡུལ་ཕྲ་རབ་རྣམས་རྟག་པ་ཡིན་ཏེ་རྡུལ་ཕྲ་མོ་རྣམས་སོ།",
    "འདི་རྣམས་རེ་ཞིག་རང་བཞིན་གྱི་གནས་སྐབས་ཡིན་ལ།",
    "འདི་ལྟར་དེ་རྣམས་ཀྱི་རྒྱུ་ནི་གང་གི་ཚེ་སྐྱེས་བུ་ཡུལ་ལ་ལོངས་སྤྱོད་པའི་རྣམ་པར་འདོད་པ་སྐྱེ་བ་དེའི་ཚེ་སྐྱེས་བུའི་འདོད་པ་རང་བཞིན་གྱིས་ཡོངས་སུ་ཤེས་ནས།",
    "ཡང་དེ་ཙམ་ལྔ་ནི་སྒྲ་དང་རེག་བྱ་དང་གཟུགས་དང་རོ་དང་དྲིའོ།",
    "མ་གྱུར་མོད་གཅིག་གི་རང་བཞིན་དེ་ཡོན་ཏན་གསུམ་གྱི་བདག་ཉིད་དེ།",
    "གང་གི་ཕྱིར་ཡོན་ཏན་དེ་རྣམས་ཀྱང་སོ་སོ་རེ་རེ་ལ་གསུམ་སྟེ་རྣམ་པ་གསུམ་གསུམ་མོ།",
    "དེ་བཞིན་དུ་དེའི་ཡོན་ཏན་ཡང་ཡོན་ཏན་གསུམ་གྱི་བདག་ཉིད་ཀྱིས་གཅིག་གི་རང་བཞིན་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཚེ་ཡང་འདི་ལྟར་རྣམ་པར་དཔྱད་པ་ན་ཡོན་ཏན་རྣམས་ཡོད་པ་མ་ཡིན་ལ།",
    "སྒྲ་ལ་སོགས་པ་སྟེ་སོགས་པའི་སྒྲ་སྨོས་པས་རེག་བྱ་ལ་སོགས་པ་གཟུང་ངོ།",
    "འང་གི་སྒྲ་ནི་སྔ་མ་བཞིན་ཡིན་ཏེ།",
    "གཞན་ཡང་གསལ་བ་བདེ་བ་ལ་སོགས་པའི་རང་བཞིན་ཡིན་ན་སྣམ་བུ་ལ་སོགས་པ་ཉིད་བདེ་བ་ལ་སོགས་པའི་བསྐྱེད་པར་བྱ་བར་འགྱུར་རོ་ཞེས་ཁྱོད་ཀྱིས་བདེ་སོགས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁྱོད་དེ་ཁྱོད་ཅག་ལ་རྒྱུ་ཉིད་དུ་འགྱུར་ཏེ།",
    "ཀྱང་གི་སྒྲས་ནི་ཉེས་པ་ལྷག་པ་བརྗོད་པར་འདོད་པ་ཡིན་ནོ།",
    "དེ་ཉིད་ཕྲ་མོ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ཉིད་གསལ་བར་གནས་པར་བྱས་ནས་དངོས་པོ་ལ་བརྟེན་པས་ཕྱི་ནས་མི་དམིགས་པའི་དུས་ན་ཕྲ་མོར་འགྱུར་བ་ཡིན་ཏེ།",
    "ཉིན་མོའི་སྐར་མ་ལ་སོགས་པ་བཞིན་དུ་མི་དམིགས་པའི་རང་བཞིན་ལ་ཡང་དག་པར་བརྟེན་པ་ཡིན་ནོ་ཞེ་ན།",
    "གང་སྟེ་གང་གི་ཕྱིར་རགས་པ་གསལ་བའི་ངོ་བོ་རང་བཞིན་དུ་ཡོད་ན་ཕྲ་བ་ཇི་ལྟར་ཡིན་ཏེ།",
    "དེའི་ཚེ་བདེ་བ་ལ་སོགས་པ་རྣམས་མི་རྟག་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "དེ་ནི་འདི་ཞེས་འབྲེལ་པ་རྟོགས་པ་ལ་ཐུག་པ་མེད་པར་ཐལ་བས་སོ།",
    "འདོད་པ་མ་ཡིན་པ་ཡང་ཁྱོད་དེ་ཡོད་པར་སྨྲ་བ་ཁྱོད་ལ་གནས་པ་ཉིད་དེ་ཡོད་པ་ཡིན་ནོ།",
    "གཞན་དུ་ན་སྔར་ཡང་དེ་ཡོད་པ་ཡིན་ན་ཕྱི་མ་བཞིན་དུ་སྔར་ཡང་དེ་དམིགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "གཞན་ཡང་ཐལ་བར་འགྱུར་བ་གཞན་འདི་ཡང་ཡོད་པ་འབྲས་བུར་སྨྲ་བ་ལ་བརྗོད་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་བརྗོད་པའི་ཉེས་པར་ཐལ་བར་མི་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་དེ་ཁོ་ན་ཉིད་ཤེས་པས་ཀྱང་རྒྱུ་ལས་འབྲས་བུ་ཡོད་དོ་ཞེས་ཤེས་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཐ་སྙད་པའི་སྐྱེ་བོ་ཐམས་ཅད་པའི་ཐུན་མོང་དུ་གནས་པ་ཡིན་ལ།",
    "འཇིག་རྟེན་པ་སྟེ་ཐ་སྙད་པའི་སོ་སོའི་སྐྱེ་བོ་ལ་ཡང་ཤེས་པ་གང་གིས་རྒྱུ་ལ་འབྲས་བུ་ཡོད་དོ་ཞེས་རྟོགས་པ་དེ་ཡོད་ལ་དེ་ཁོ་ན་ཉིད་ཤེས་པ་འབའ་ཞིག་ལ་ནི་མ་ཡིན་ནོ།",
    "འཇིག་རྟེན་པ་གཉི་ག་ལ་ཐུན་མོང་དུ་ངེས་པ་ཡིན་ནོ།",
    "དེས་འཇིག་རྟེན་པས་རྒྱུ་གང་གིས་མི་མཐོང་།",
    "འདི་ཡང་ཁོ་བོ་ཅག་གིས་འདོད་པ་ཉིད་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་ཡང་ཁྱེད་ཅག་ཀྱང་ཁོ་བོ་ཅག་གི་ཕྱོགས་སུ་ལྷུང་བ་ཡིན་ནོ།"
  ]
}