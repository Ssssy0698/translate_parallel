    "འོན་ཏེ་སྐུལ་བར་བྱེད་པའི་བདག་མེད་པར་སྲོག་ལ་སོགས་པར་འགྱུར་བ་ནི་མ་ཡིན་ཏེ།",
    "བྱ་མེད་ཁྱབ་པར་སྐུལ་བྱེད་དུ།",
    "སྦུད་པ་སྦུད་པར་བྱེད་པ་ཅི་བྱེད་པ་དང་བཅས་པས་སྐུལ་བར་བྱེད་པ་དང་བཅས་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ཁྱབ་པར་བྱེད་པ་མ་ཡིན་ཀྱང་ངོ།",
    "བདག་ནི་དེ་ལྟར་མ་ཡིན་པའི་ཕྱིར་ཅི་ལྟར་དེ་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཡིན།",
    "དེ་ལ་ཡང་སྐར་ཁུང་ནས་ལྟ་བར་བྱེད་པ་ལྟ་བུ་གཞན་ཡོད་པར་རིགས་པས་ཐུག་པ་མེད་པ་ཉིད་དོ།",
    "དེ་ལྟ་ཡིན་ན་དེ་དག་མེད་པར་གཞན་པ་ལས་ཀྱང་འབྱུང་ངོ་ཞེས་བྱ་བར་འགྱུར་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་ན་ལྡོག་པ་ཡང་ཡོད་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ཡིན་དང་དེ་དག་མེད་པར་གཞན་ལས་ཀྱང་འབྱུང་སྟེ།",
    "གཉི་གས་མེད་པར་བྱ་བ་ཡིན་ནོ་ཞེ་ན།",
    "རྟོགས་པ་ངེས་པ་ཡིན་ན་སྔོན་པོའི་རྣམ་པར་ཤེས་པས་སྔོན་པོ་རྟོགས་པར་འགྱུར་གྱི།",
    "དེ་ལྟ་མ་ཡིན་ན་འཁྲུལ་པ་དང་མ་འཁྲུལ་པ་རྣམ་པར་དབྱེ་བ་མེད་པར་འགྱུར་རོ།",
    "ཐ་སྙད་འགྲུབ་པར་འགྱུར་མ་ཡིན།",
    "དེ་ལྟར་ན་རྣམ་པར་རིག་པ་ཙམ་གཉིས་མེད་པ་ཡིན་པའི་ཕྱིར་ཐ་དད་པ་དང་ཐ་མི་དད་པ་དག་མ་ཡིན་ནོ།",
    "དེས་ན་དུ་བ་སྐྱེད་པར་བྱེད་པ་ནི་མེ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "དོན་དམ་པར་ན་རུལ་པ་ཡང་གཅིག་ཉིད་ནི་མ་ཡིན་གྱི།",
    "མེར་རྟོགས་པའི་ཡན་ལག་མེད་པར་ནི་དུ་བ་མི་སྐྱེད་པའི་ཕྱིར་དེ་ལ་འཁྲུལ་པ་མེད་དོ།",
    "འདི་ཉིད་ག་ལས་གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་མ་མཐོང་བ་ནི་ངེས་པར་རིགས་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "བསྐྱེད་པར་བྱ་བ་ཉིད་ནི་དུ་བ་ལ་སོགས་པའི་མཚན་ཉིད་མ་ཡིན་ཏེ།",
    "རྣམ་པར་དབྱེ་བ་ནི་རྒྱུ་དང་འབྲས་བུས་བྱས་པ་ཡིན་པའི་ཕྱིར་ཏེ་སྤྲོས་པས་ཆོག་གོ།",
    "ཤེས་བྱ་འཇིག་དང་བྱས་པ་ཉིད།",
    "ལྡོག་ཅན་མཚུངས་པར་བསྟན་པའི་ཕྱིར།",
    "ཚུལ་འདིས་ཐམས་ཅད་དཔག་པར་བྱ།",
    "ལྡོག་པ་ཅན་གྱི་གཏན་ཚིགས་ཐམས་ཅད་དཔེར་བརྗོད་པ་མཚུངས་པར་བསྟན་པའི་ཕྱིར།",
    "སློབ་དཔོན་གྱིས་ལྡོག་པ་ཅན་མཉན་པར་བྱ་བ་ཉིད་མ་ངེས་པར་བསྟན་པར་མཛད་པ་ཡིན་ཏེ།",
    "དེས་ན་ཚུལ་འདི་ཐམས་ཅད་ནི་སློབ་དཔོན་གྱི་དགོངས་པ་ལ་གནས་པ་ཡིན་ནོ་ཞེས་བསམ་པར་བྱའོ།",
    "གལ་ཏེ་མཉན་པར་བྱ་བ་ཉིད་རྟག་པ་དང་།",
    "ཅི་སྒྲ་ཉིད་ལས་ཐེ་ཚོམ་ཟ་བས་གཞན་དག་ཀྱང་ཐེ་ཚོམ་གྱི་རྒྱུ་ལ་བརྟེན་པ་མ་ཡིན་པར་འགྱུར་རམ།",
    "ཐེ་ཚོམ་གྱི་རྒྱུ་ནི་དེ་ཉིད་ཡིན་པར་བརྗོད་དོ།",
    "མཉན་པར་བྱ་བ་ཉིད་གོ་ཅི་ལྟར་ཐེ་ཚོམ་གྱི་རྒྱུ་ཡིན་ཞེ་ན།",
    "འགལ་བས་གང་ཚེ་གཅིག་ལྡོག་པར།",
    "ཕན་ཚུན་སྤངས་པས་འགལ་བ་གཉི་ག་ལས་གཅིག་ཏུ་ངེས་པར་ལྡོག་པ་ནི་མི་སྲིད་པས་འདིར་བཏང་སྙོམས་པར་གནས་པ་ནི་མི་འཐོབ་པ་ཁོ་ནའོ།",
    "མཉན་བྱ་ཉིད་ཀྱིས་བྱས་པ་མ་ཡིན་པ་མ་ཡིན་ནམ།",
    "དེ་གཏན་ཚིགས་ཀྱིས་བྱས་པ་ནི་མ་ཡིན་ནོ།",
    "གཉི་ག་ལའང་སྒྲུབ་བྱེད་ཡིན་པར་འགྱུར།",
    "གཅིག་ཏུ་ངེས་པར་ལྡོག་པར་བྱ་སྟེ་ཐེ་ཚོམ་ཟ་བ་ནི་མ་ཡིན་ནམ།",
    "གཅིག་ཏུ་ངེས་པར་གཉིས་ལས་ལྡོག་པར་མ་ངེས་པའི་ཕྱིར་རོ།",
    "གཅིག་ཏུ་ངེས་པར་ལྡོག་པའི་ཕྱིར་རོ་ཞེས་གསུངས་ཏེ།",
    "ལྡོག་པར་ངེས་ཏེ་གཞན་ལ་ནི།",
    "ལོག་པར་སླར་ཡང་དེ་ཉིད་ལ།",
    "ཐེ་ཚོམ་བྱེད་པར་ཅི་ལྟར་འགྱུར།",
    "གང་ཞིག་གང་ལས་ལྡོག་པ་དེ་ཅི་ལྟར་དེ་རྣམ་པར་གཅོད་པ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན།",
    "འོན་ཏེ་གཉི་ག་རྣམ་པར་གཅོད་པ་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཀྱིས་མི་རྟོགས་པའི་རྒྱུ་ཡིན་ནོ་ཞེ་ན།",
    "སྒྲུབ་པར་བྱེད་པས་གཏན་ཚིགས་ཉིད།",
    "རབ་སྒྲུབ་བྱེད་ཅེས་རྣམ་པར་གནས།",
    "བྱས་པ་ཉིད་ལས་ནི་རྟག་པ་ལས་ལྡོག་པས་མི་རྟག་པ་འཕེན་པ་ཡིན་ནོ་ཞེ་ན།",
    "གཞན་ལྡོག་ཉིད་ཀྱིས་དོན་བྱས་འགྱུར།",
    "རྗེས་སུ་དཔག་པ་ནི་གཞན་རྟག་པའི་སྒྲོ་འདོགས་པ་བཅད་པ་ཙམ་གྱིས་དོན་བྱས་པ་ཡིན་ཏེ།",
    "རྟག་པ་དང་མི་རྟག་པའི་རྣམ་པར་མི་རྟོག་པ་དག་ནི་གཅིག་བཟློག་པས་གཞན་རང་ཉིད་གནས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་མཉན་བྱ་ཉིད་ཀྱིས་གཉི་ག་ཡང་རྣམ་པར་བཅད་པ་ཡིན་ན།",
    "དེ་ལས་འགྲུབ་པ་མངོན་སུམ་གྱིས་གྲུབ་པར་འགྱུར་བའི་ཕྱིར་གཏན་ཚིགས་ཉིད་དུ་འགྱུར་རོ།",
    "མངོན་སུམ་གྱིས་གྲུབ་པ་གཏན་ཚིགས་གཞན་གྱིས་འགོག་པར་བྱེད་པའམ།",
    "སྒྲུབ་པར་བྱེད་པ་ཅི་ལྟར་འགྱུར།",
    "འོན་ཏེ་མངོན་སུམ་ནི་འགོག་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "མཉན་བྱ་ཉིད་ཀྱིས་གཉི་ག་རྣམ་པར་བཅད་པས།",
    "དེས་ན་ཐམས་ཅད་ཡིད་བརྟན་དུ་མེད་པར་འགྱུར་རོ།",
    "མངོན་སུམ་འགོག་པར་བྱེད་པ་མ་ཡིན་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་ཡིན་ན་ནི་སྒྲུབ་པར་བྱེད་པའི་རང་བཞིན་དུ་ཡང་མི་འགྱུར་རོ།",
    "སྒྲུབ་པར་བྱེད་པ་ནི་དངོས་པོ་རྟོགས་པར་བྱེད་པ་ཡིན་ལ།",
    "དངོས་པོ་ཡང་དེ་ལས་གཞན་དང་ཐ་དད་པ་མེད་པར་རྣམ་པར་བཅད་པ་རྟོགས་པར་མི་འགྱུར་རོ།",
    "འོན་ཏེ་གཞན་དང་འདྲེས་པར་འགྱུར།",
    "འགོག་པ་ཡང་ནི་མེད་པར་འགྱུར།",
    "འདི་རྣམ་པར་དཔྱད་པར་བྱ་སྟེ།",
    "དེ་ལྟ་མ་ཡིན་ཏེ་མ་བཟུང་ན་ནི་དོན་ལྡོག་པར་ཅི་ལྟར་ཡིན།",
    "གཞན་གྱིས་དེ་ལྟ་མ་ཡིན་པར་རྟོགས་ན་ཐམས་ཅད་ལ་ཡིད་བརྟན་དུ་མེད་དོ་ཞེས་བསྟན་ཟིན་ཏེ།",
    "དེས་ན་དང་པོའི་མཐོང་བ་དེ་གནོད་པར་འགྱུར་བ་ཡིན་གྱི།",
    "དེས་ན་གལ་ཏེ་མངོན་སུམ་གྱིས་སྒྲ་གཉི་ག་ལས་ལོག་པར་བཟུང་ན་དེའི་ཚེ་གཞན་ལས་ཐེ་ཚོམ་ཟ་བའམ་དེ་ལྟ་མ་ཡིན་པར་མི་འགྱུར་རོ།",
    "འོ་ན་ཅི་ལྟར་གཅིག་ཏུ་ངེས་པ་ལྡོག་པའི་ཕྱིར་རོ་ཞེས་གསུངས་ཤེ་ན།",
    "གཅིག་ཏུ་ངེས་པར་གདོན་མི་ཟ་བ་ཉིད་ལྡོག་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་མ་ཡིན་གྱི་འོན་ཀྱང་གཅིག་ཏུ་ངེས་པའི་གདོན་མི་ཟ་བ་ཉིད་ལྡོག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དེས་ན་དོན་དམ་པར་ན་ལོག་པ་མེད་པ་ཉིད་དོ།",
    "སྒྲུབ་པ་དང་དགག་པ་དག་ཏུ་ཐ་སྙད་བྱེད་པ་ཉིད་མེད་པར་འགྱུར་རོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ནི་དོན་བྱ་བས་སྟོང་པའི་ཕྱིར་དོན་བྱ་བའི་དོན་དུ་གཉེར་བ་རྣམས་ཀྱི་དོན་དུ་གཉེར་བར་བྱ་བ་ཉིད་མ་ཡིན་པར་འགྱུར་རོ།",
    "རང་དང་གཞན་གྱི་རྣམ་པར་འབྱེད་པ་མེད་པ་ནི་སུ་ཞིག་གང་ལའམ་ཅིའི་དོན་དུ་ཐ་སྙད་བྱེད་དེ།",
    "དེ་ལྟར་མ་ཡིན་ན་གོམ་གང་ཡང་ནི་འགྲོར་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཐ་སྙད་མི་སླུ་བ་ཉིད་སྒྲུབ་པར་བྱེད་པའི་ཤེས་པས་གཅད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་དངོས་པོ་མེད་པ་གཞལ་བྱ་ཁོ་ན་ཡིན་པའི་ཕྱིར།",
    "འོན་ཏེ་གཞལ་བྱ་ཉིད་མངོན་སུམ་གྱིས་ཡོངས་སུ་གཅད་པར་བྱ་བ་ལ་བརྗོད་ན་དེ་ལྟ་ཡིན་ན་མངོན་སུམ་ནི་དངོས་པོ་ལས་སྐྱེ་བ་ཡིན་པའི་ཕྱིར་དོན་བྱེད་པར་ནུས་པ་ཉིད་གཞལ་བྱ་ཡིན་ནོ།",
    "གལ་ཏེ་དགག་པ་ཉིད་ནི་ཐམས་ཅད་དུ་མི་དམིགས་པ་ཡིས་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་ཅེས་བྱ་བ་ལ་སོགས་པས་མི་དམིགས་པ་ཡང་གཏན་ཚིགས་གསུམ་པ་ཡིན་པར་བསྟན་པ་མ་ཡིན་ནམ།",
    "དེ་ལྟ་ཡིན་ན་མི་དམིགས་པའི་འབྲེལ་པ་བསྟན་པར་བྱ་དགོས་པ་ཡིན་ན།",
    "འོན་ཀྱང་བརྗོད་པར་འདོད་པའི་དངོས་པོ་ཉིད་ཀྱི་དངོས་པོ་མེད་པ་ཡིན་ནོ།",
    "དམིགས་པའི་མཚན་ཉིད་དུ་མ་གྱུར་པར་ཡོད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་དེའི་རྒྱུའམ་ཁྱབ་པར་བྱེད་པ་མེད་དོ་ཞེས་བྱ་བར་གྱུར་པ་དེ་ལྟ་ན་ནི་དེ་མེད་པར་འགྲུབ་པར་འགྱུར་རོ།",
    "གྲུབ་ན་ལྡོག་པར་འགྲུབ་པར་འགྱུར།",
    "དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པ་ཉིད་ཀྱི་ཁྱད་པར་ཅི་ལྟར་གྲུབ་ཅེ་ན།",
    "དེས་ན་གལ་ཏེ་གསོན་པོའི་ལུས་ལ་ཡང་བདག་ལྡོག་ན་སྲོག་ལ་སོགས་པ་ཡང་ལྡོག་པར་འགྱུར་རོ་ཞེས་བྱའོ།",
    "གལ་ཏེ་རྣམ་པར་གཅོད་པ་བསྒྲུབ་པ་ཉིད་ཀྱིས་གཏན་ཚིགས་ཐམས་ཅད་མི་དམིགས་པ་ཉིད་མ་ཡིན་ནམ།",
    "ཁས་བླངས་མེད་པར་དགག་པ་ཉིད།",
    "མ་ཡིན་སྒྲུབ་པར་བྱེད་ཕྱིར་རོ།",
    "འདིས་ནི་ས་ཕྱོགས་ལ་སོགས་པའི་དངོས་པོ་ལ་ཡང་མ་ཡིན་པ་སྒྲུབ་པ་མ་ཡིན་གྱི་འོན་ཀྱང་དངོས་པོའི་ངོ་བོ་ཁས་བླངས་པ་མ་བྱས་པར་དགག་པ་བསྒྲུབས་པ་ཡིན་ལ།",
    "དེས་ན་འབྲེལ་པར་མཚུངས་ཀྱང་ཡུལ་ཐ་དད་པའི་ཕྱིར་ཐ་དད་པ་ཁོ་ནའོ།",
    "རྗེས་སུ་དཔག་པས་ཡོད་པར་འཛིན།",
    "དུ་བ་མཐོང་བ་མེ་ཡོད་པར།",
    "རྗེས་སུ་དཔག་པ་མེད་པར་ཡང་ཡོད་པས་ན་འཁྲུལ་པའི་ཕྱིར་རོ།",
    "དམིགས་པར་བྱ་བ་མེད་པར་ནི།",
    "འདི་ལྟར་དམིགས་པར་རུང་བ་ཡང་ཡིན་ལ།",
    "འདི་ལྟར་གལ་ཏེ་དམིགས་པར་བྱ་བ་ཉིད་ནི་དེ་དོན་གྱི་ངོ་བོ་ཁོ་ནའོ།",
    "དེ་སྟེ་དམིགས་པར་བྱེད་པའི་དམིགས་པར་བྱེད་པ་པོ་ལ་གནས་པར་བརྗོད་ན།",
    "དེ་ལས་ལྡོག་པ་མེད་ན་ཡང་ཐ་དད་པར་ལྡོག་པ་མ་ཡིན་ཏེ།",
    "དམིགས་པ་ཉིད་ཡོད་པར་བརྗོད་དོ།",
    "ཐ་དད་པ་དུས་མཚུངས་པར་དམིགས་པས་དོན་རྣམས་དམིགས་པ་ནི་མ་ཡིན་གྱི།",
    "འོན་ཀྱང་དེར་རྗེས་སུ་ཆུད་པར་དམིགས་པར་བྱ་བའི་མཚན་ཉིད་དམིགས་པ་ཉིད་ལས་ཡིན་ནོ།",
    "དེའི་ཕྱིར་དམིགས་པ་ཉིད་ཡོད་པ་ཡིན་ལ་དེ་ལས་ནི་མི་དམིགས་པ་ཉིད་མེད་པ་ཡིན་ནོ་ཞེས་འཆད་པར་འགྱུར་རོ།",
    "དངོས་པོ་མེད་པ་རྣམས་ནི་དོན་དམ་པར་ཕན་ཚུན་ཐ་དད་པར་འགའ་ཡང་མེད་ཀྱི་འོན་ཀྱང་བུམ་པ་མེད་དོ།",
    "ཤིང་རྟ་མེད་དོ་ཞེས་ཁྱད་པར་དངོས་པོ་ཐ་དད་པས་ཐ་དད་པ་ཡིན་ནོ།",
    "དོན་དམ་པར་ནི་དགག་པར་བྱ་བ་ཐ་དད་ཀྱང་དངོས་པོ་མེད་པས་ཐ་དད་པ་མ་ཡིན་ནོ།",
    "དེའི་ཚེ་ལོག་པར་རྟོག་པ་མེད་པ་ཉིད་དོ་ཞེ་ན།",
    "ཐ་དད་པ་མེད་པར་མ་རྟོགས་པའམ་གྲངས་ཅན་པ་གང་དག་ཤིན་ཏུ་རྨོངས་པས་ན།",
    "ཐམས་ཅད་ཐམས་ཅད་ན་ཡོད་དོ་ཞེས་ཀུན་དུ་འཛིན་པ་དང་ལྡན་པ་ཡོངས་སུ་ཤེས་པ་དང་བྲལ་བའི་མི་ཤེས་པ་དེ་དག་ཤེས་པར་བྱ་བའི་དོན་དུ་རང་བཞིན་མི་དམིགས་པས་གཅིག་ཡིན་ནོ།",
    "འོན་ཏེ་དེར་བསྒྲུབ་པར་བྱ་བ་ཅི་ཞིག་ཡིན་ཞེ་ན།",
    "དཔེར་ན་སྲེག་པར་བྱེད་མིན་ཕྱིར།",
    "ཡུལ་དེ་མེད་པར་ངེས་པས་ནི་ཤེས་པ་དང་བརྗོད་པ་དང་ཐེ་ཚོམ་ཟློག་པར་བྱེད་དེ།",
    "དཔེར་ན་མེ་མ་ཡིན་ཏེ་སྲེག་པར་བྱེད་པ་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་བཞིན་ཏེ།",
    "དེ་མེད་ན་སྲིད་པར་ག་ལ་འགྱུར།",
    "འདི་ལྟར་སྲེག་པར་བྱེད་པ་མེད་པ་ལས་མེ་མེད་པ་ཉིད་ནི་གཞན་མ་ཡིན་ནོ།",
    "ཅི་ལྟར་སྲེག་པར་བྱེད་པ་ལས་མེ་གཞན་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "སྒྲུབ་པར་བྱེད་པ་དག་གཅིག་ཉིད་ཡིན་ཞེ་ན།",
    "བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པ་དག་ཐ་དད་པར་འགྱུར་དགོས་སོ་ཞེས་གང་བརྗོད་པ་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པའི་དངོས་པོ་དེ་ཉིད་འདིར་མ་གྲུབ་པས།",
    "དེ་ཅི་ལྟར་དེ་བཞིན་དུ་ཐ་དད་པར་གྲུབ་པ་མ་གྲུབ་པ་ནི་མ་གྲུབ་པས་མི་འགྲུབ་པོ།",
    "ཅི་སྲིད་དུ་གཞན་ལ་བསྒྲུབ་བྱ་དང་སྒྲུབ་བྱེད་ཀྱི་དངོས་པོར་རབ་ཏུ་མ་གྲུབ་པ་དེ་སྲིད་དུ་ཐ་དད་པར་མི་འགྲུབ་པ།",
    "ཅི་སྲིད་ཐ་དད་པར་མ་གྲུབ་པ་དེ་སྲིད་དུ་ཡང་བསྒྲུབ་བྱ་དང་སྒྲུབ་བྱེད་ཀྱི་དངོས་པོ་ནི་འབྲེལ་པ་ཡོད་ན་འགྱུར་བ་ཡིན།",
    "འབྲེལ་པ་རབ་ཏུ་འགྲུབ་པར་འགྱུར།",
    "རབ་ཏུ་འགྲུབ་པར་འགྱུར་མ་ཡིན།",
    "བྱས་པའི་འབྲས་བུ་འགྲུབ་མ་ཡིན།",
    "དེའི་ཕྱིར་མི་དམིགས་པ་ལས་དངོས་པོ་མེད་པར་མི་འགྲུབ་སྟེ།",
    "དེའི་བདག་ཉིད་ཀྱི་འབྲེལ་པ་ཡིན་ན་ནི་མི་དམིགས་པ་དེ་ཉིད་མེད་པ་ཡིན་པའི་ཕྱིར་ཐ་སྙད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "བློ་སྒྲ་ཐེ་ཚོམ་མེད་པར་འགྲུབ།",
    "ཐ་སྙད་ཐམས་ཅད་ན་ནི་མི་དམིགས་པའི་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "དེས་ན་རྒྱུས་འབྲས་བུ་སྒྲུབ་པར་མི་རིགས་ཏེ།",
    "གཞན་དག་རྗེས་སུ་མི་བརྗོད་པར།",
    "མཐོང་བ་དང་མ་མཐོང་བའི་ཁྱད་པར་ལས་མ་གཏོགས་པར་ནི་རྒྱུ་དང་འབྲས་བུ་ཉིད་གཞན་ཡོད་པ་མ་ཡིན་ནོ།",
    "འདིའི་འབྲས་བུ་ཞེས་བྱ་བའི་དོན་ནི་འདི་ཉིད་ཡིན་ཏེ་འདི་མེད་པར་ནི་མི་འབྱུང་ངོ་ཞེས་བྱ་བའོ།",
    "འོན་ཏེ་དེ་མེད་པར་མི་འབྱུང་ན།",
    "རྒྱུ་ཉིད་ལས་ནི་འབྲས་བུ་སྐྱེ་བ་ཞེས་བྱ་བ་ཉིད་རིགས་པར་འགྱུར།",
    "འོ་ན་ཇི་ལྟར་དོན་ཐ་དད་མེད་པར་སྒྲ་ཐ་དད་པར་འགྱུར་ཞེ་ན།",
    "གལ་ཏེ་ཅི་ལྟར་དེའི་བདག་ཉིད་མེད་པར་རང་བཞིན་མི་དམིགས་པ་རང་བཞིན་གཏན་ཚིགས་ཀྱི་ནང་དུ་འདུ།",
    "འདི་ལ་ལན་བཏབ་པ་ནི་མི་དམིགས་པ་ནི་དགག་པར་བྱ་བ་ལས་བཟློག་པའི་བདག་ཉིད་ཡིན་ནོ།",
    "ཐ་དད་པར་ནི་དཔེར་མ་བསྟན།",
    "འདིའི་རང་བཞིན་དུ་མེད་དོ་ཞེས་བྱ་བར་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནམ།",
    "གལ་ཏེ་རང་བཞིན་འདིས་དབེན་པར་མ་གྱུར་ན་འདི་ཡང་དེས་དབེན་པར་མི་འགྱུར་བའི་ཕྱིར་ཤིན་ཏུ་གསལ་བའི་དོན་ལ་གཞན་དག་ནི་ལྟ་ཅི་ཞིག་སྨོས།",
    "ཅི་ལྟར་འདི་མི་དམིགས་སོ་སྙམ་པའི་རྣམ་པར་རྟོག་པའི་ཡུལ་ཡིན་པའི་ཕྱིར་ན་དེ་ལྟར་ངེས་པའི་དམིགས་པ་དམིགས་པ་ཡིན་པ་དེ་བཞིན་དུ་མ་དམིགས་སོ་སྙམ་པའི་ངེས་པ་ལས་ཀྱང་མི་དམིགས་པ་ཉིད་ཡིན་ནོ།",
    "གལ་ཏེ་དངོས་པོ་མེད་པར་བསྒྲུབ་པའི་དངོས་པོ་མེད་པ་ཡོད་པ་ཉིད་ཀྱིས་ན་དངོས་པོ་རྣམས་ཁྱད་པར་འགྲུབ་པ་མ་ཡིན་ན།",
    "མྱོང་བ་ཁྱད་པར་ཅན་ཉིད་ལས།",
    "དོན་རྣམས་ཁྱད་པར་ཅན་དུ་རྟོགས།",
    "གལ་ཏེ་མྱོང་བ་ཁྱད་པར་དུ་ན་མྱོང་བ་གཞན་གྱིས་དབེན་པ་མེད་ན་ནི།",
    "མྱོང་བར་བྱ་བའི་ཁྱད་པར་རྟོགས་པ་ལ།",
    "གལ་ཏེ་རང་རིག་པར་དེའི་རང་བཞིན་གྱིས་མྱོང་བ་ཉམས་སུ་མ་མྱོང་ན་དེའི་ཚེ་ཁྱད་པར་རྟོགས་པར་མི་འགྱུར་རོ།",
    "དངོས་པོ་མེད་པར་རིགས་པས་རྟོགས་སོ་ཞེ་ན།",
    "དབྱེ་བ་མེད་པར་མྱོང་བ་ལ་དངོས་པོ་ཆོད་པ་རིག་པར་ནུས་པ་ཡོན་པ་མ་ཡིན་ཏེ།",
    "དྲན་པ་མེད་པར་དངོས་མེད་ཀྱི།",
    "ཁྱད་པར་གཞན་གྱི་མེད་པར་ཡང་།",
    "བཟློག་ཟླ་དྲན་པ་མེད་པར་ནི།",
    "བཟློག་པའི་ཟླ་དྲན་པར་ཡང་ཁྱད་པར་ཅན་ཡང་རིགས་མེད་པར་མ་ཡིན་ནོ།",
    "འོན་ཏེ་སྔར་ཁྱད་པར་ཅན་དུ་མྱོང་ངོ་ཞེ་ན།",
    "དེའི་ཕྱིར་གཞན་གྱིས་དབེན་པ་ཉམས་སུ་མྱོང་བའི་ངོ་བོ་ཉིད་ལས་ཐ་དད་པའི་རྣམ་པར་རྟོག་པ་ཡིན་ལ་ཐ་དད་པ་དེ་ཉིད་ནི་དེ་ལས་གཞན་མེད་པ་ཡིན་ནོ།",
    "བློ་ནི་རང་རིག་པ་ཉིད་གཞན་ལ་ལྡོག་པར་རབ་ཏུ་གྲུབ་ལ།",
    "དེ་ལས་ཀྱང་དོན་གྱི་ཁྱད་པར་ཡིན་པའི་ཕྱིར་མྱོང་བའི་ཐ་སྙད་ཡོངས་སུ་རྫོགས་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་ན་ཐུག་པ་མེད་པའི་ཕྱིར་མི་རྟོགས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་ཐ་སྙད་མེད་པར་འགྱུར་རོ།",
    "དངོས་པོ་མེད་པ་དེ་ནི་འགལ་ཟླ་དྲན་པ་མེད་པར་མི་འཇུག་གོ།",
    "འགལ་ཟླ་དྲན་པ་ཡང་མངོན་སུམ་གྱིས་ཐ་དད་པར་བཟུང་བ་ལས་འགྱུར་བ་ཡིན་པའི་ཕྱིར་དངོས་པོ་མེད་པར་དོན་མེད་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་ཡང་སྔོན་བཞིན་དུ་མངོན་སུམ་ཉིད་ཀྱིས་ཐ་དད་པར་འཛིན་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་དེར་ཡང་དངོས་པོ་མེད་པར་ཐ་དད་པ་མ་ཡིན་པས་ན་དངོས་པོ་མེད་པ་དོན་མེད་པ་ཉིད་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལྟ་ཡིན་ན་དེའི་ཚེ་ཡང་དྲན་པ་ལ་ལྟོས་པས་དེར་ཡང་དངོས་པོ་མེད་པ་འཇུག་པར་བྱེད་པའི་དྲན་པ་གཞན་ཡིན་པར་འགྱུར་བས་ཐུག་པ་མེད་པར་འགྱུར་རོ།",
    "འདི་ནི་ཁས་བླངས་ནས་བརྗོད་པར་ཟད་དེ།",
    "དེས་ན་དངོས་པོ་མེད་པ་ནི་འཇུག་པར་མི་སྲིད་པ་ཉིད་དོ།",
    "དེའི་ཕྱིར་གཞན་གྱི་ལྟ་བ་ལ་ནི་ཐ་དད་པར་རྟོགས་པ་མེད་པ་ཉིད་དོ།",
    "རང་བཞིན་ཁྱད་པར་ཅན་མྱོང་ལ།",
    "དེ་ལས་ཁྱད་པར་ཅན་མི་དམིགས།",
    "ཁྱད་པར་ཅན་གྱི་རང་བཞིན་དམིགས་པ་ཉིད་དེ་ལས་གཞན་མེད་པར་བསྒྲུབ་པ་ཡིན་ཏེ།",
    "ཁྱད་པར་ཅན་གྱི་རང་བཞིན་མྱོང་བ་མེད་པར་ནི་གཞན་དེར་མེད་པར་མི་འགྲུབ་པོ།",
    "གལ་ཏེ་ཁྱད་པར་ཅན་ཉམས་སུ་མྱང་བས་ནི།",
    "དེ་དེ་ལ་མེད་པར་ཅི་ལྟར་འགྱུར།",
    "རང་བཞིན་ཁྱད་པར་ཅན་མྱོང་ན།",
    "དེ་ཉིད་གྲུབ་པར་འགྱུར་མ་ཡིན།",
    "ཁྱད་པར་ཅན་གྱི་རང་བཞིན་མ་མྱོང་བ་ནི་དོན་མེད་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "གལ་ཏེ་བུམ་པ་ལ་སོགས་པའི་རང་བཞིན་ཁྱད་པར་ཅན་མྱོང་ངོ་ཞེ་ན།",
    "དེའི་ཁྱད་པར་ཅན་ཉམས་སུ་མྱོང་བ་གཞན་དང་གཞན་དངོས་པོ་མེད་པ་སྒྲུབ་པ་ཡིན་ལ་གཞན་མི་དམིགས་པ་ཉིད་དངོས་པོ་ཡང་དེའི་ཁྱད་པར་ཅན་དམིགས་པ་ཉིད་ཡིན་ནོ།",
    "འབྲེལ་པ་མེད་པའི་ཉེས་པར་མི་འགྱུར་རོ།",
    "རང་ཙམ་གྱིས་འཇུག་པ་དངོས་པོ་མེད་པའི་ཐ་སྙད་འཇུག་པར་བྱེད་པ་ཡིན་ནོ།",
    "མི་དམིགས་པ་ལས་རྟོགས་པར་འགྱུར།",
    "སྒྲུབ་པར་རིགས་པ་དང་ལྡན་ཡིན།",
    "དོན་མེད་པ་ཡང་འགྲུབ་པར་འགྱུར།",
    "གལ་ཏེ་དངོས་པོ་ནི་དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པ་མ་ཡིན་པའི་ཕྱིར་གཞན་གྱི་མངོན་སུམ་ལས་མེད་པར་མི་འགྱུར་ཏེ།",
    "དེའི་རྣམ་པར་ཤེས་པ་ལས་རང་བཞིན་གཞན་ཡིན་པའི་ཕྱིར་རོ།",
    "གཞན་དག་མེད་པར་ཅི་ལྟར་རྟོགས།",
    "དེས་དབེན་པ་ཉིད་མེད་པར་ནི་ཤེས་པ་གཞན་དམིགས་པས་ཤེས་པ་གཞན་མེད་པར་བསྒྲུབ་པ་མ་ཡིན་ནོ།",
    "འོ་ན་དེ་དམིགས་པའི་མཚན་ཉིད་ཀྱིས་འགྱུར་བ་ཞེས་བྱ་བའི་ཁྱད་པར་དུ་བྱ་བ་མ་ཡིན་ཏེ།",
    "མ་ཡིན་པར་དགག་པའི་རང་བཞིན་གྱི་དངོས་པོ་མེད་པ་ནི་མངོན་སུམ་གྱིས་གྲུབ་པོ།",
    "གལ་ཏེ་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ལས།",
    "གལ་ཏེ་དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པའི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་མེད་པ་མངོན་སུམ་གྱིས་གྲུབ་ན་འོ་ན་ཐམས་ཅད་དུ་མེད་པ་མངོན་སུམ་གྱིས་གྲུབ་པ་ཉིད་ལས་རང་བཞིན་མི་དམིགས་པ་ཞེས་བྱ་བ་མེད་པར་འགྱུར་རོ།",
    "ཡང་ན་གལ་ཏེ་རང་བཞིན་མི་དམིགས་པ་སྨོས་པ་ཉིད་མཁས་པ་ལ་ཡང་ཡིན་པར་འགྱུར་ཏེ།",
    "བལྟར་རུང་བའི་ཡོད་ན་ནི་དམིགས་པས་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པས་བསྒྲུབ་པར་སྨྲ་བ་རྣམས་ཀྱི་སྟོན་པ་ཡིན་ན།",
    "འདི་ནི་རང་བཞིན་མི་དམིགས་པར་སྨྲ་བ་ལ་ཡང་མཚུངས་སོ།",
    "དེའི་བདག་ཉིད་ཡིན་པས་ཁྱབ་པར་བྱ་བ་དང་ཁྱབ་པར་བྱེད་པ་མ་ཡིན་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "གང་ཞིག་འབྲས་བུ་དེ་ནི་རྒྱུ་ཁྱབ་པ་དང་ལྡོག་པ་མེད་པའི་ཕྱིར་དེའི་རང་བཞིན་དང་ཁྱད་པར་མེད་པས་ན་དེ་མི་དམིགས་པ་ནི་རང་བཞིན་མི་དམིགས་པ་ཉིད་དུ་བརྗོད་དོ་ཞེས་འབྲས་བུ་མི་དམིགས་པ་རང་བཞིན་མི་དམིགས་པའི་ཁོངས་སུ་འདུ་བ་ཉིད་དུ་འཆད་པའི་རྨོངས་པ་དེ་མྱོང་བ་མི་དམིགས་པ་རང་བཞིན་མི་དམིགས་པར་ཇི་ལྟར་མི་འཐད་དེ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་ཁྱད་པར་བྱེད་པ་མི་དམིགས་པ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཐག་རིང་པོར་ནི་ཁྱབ་པར་བྱ་བ་ལ་ལྟོས་ནས་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཡིན་ལ།",
    "དམིགས་པ་དག་ནི་ཕན་ཚུན་ཁྱབ་པའི་ཕྱིར་ཐ་དད་པར་བརྟགས་པར་མི་ནུས་སོ།",
    "ལྡོག་པ་སྒྲུབ་པར་ནུས་མ་ཡིན།",
    "ངེས་པར་བསྒྲུབ་བྱ་གཏན་ཚིགས་ལ།",
    "རང་བཞིན་མི་དམིགས་པ་འདིས་ནི་གཏན་ཚིགས་མི་མཐུན་པའི་ཕྱོགས་ལ་མེད་པ་ངེས་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཡུལ་ཐག་རིང་བ་ལ་སོགས་པར་ངེས་པ་མི་རུང་བའི་ཕྱིར་རོ།",
    "དང་པོ་རྒྱུ་དང་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་གང་ཡིན་པ་ནི་གཏན་ཚིགས་མི་མཐུན་པའི་ཕྱོགས་མཐའ་དག་ལས་ལྡོག་པར་ངེས་པར་བྱེད་པ་ཡོད་པ་ཡིན་ཏེ།",
    "འགལ་བས་ཁྱབ་པ་ལ་སོགས་པ་རྣམས་ཀྱང་གཞན་དུ་ཐ་དད་པར་བསྟན་པར་བྱེད་པར་འགྱུར་རོ།",
    "དེས་ན་འགལ་བ་མཐོང་བ་ལས་དམིགས་པ་མཚན་ཉིད་ཀྱིས་གྱུར་པ་མི་དམིགས་པར་བསྒྲུབ་པོ།",
    "དེ་ལ་ཡུལ་ཐག་རིང་པོ་ན་གནས་པའི་མེ་ལས་དམིགས་པའི་མཚན་ཉིད་དུ་གྱུར་པ་མི་དམིགས་པའི་རྗེས་སུ་དཔག་པས་གྲུབ་པས་མེད་པ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར།",
    "འདི་ལྟར་ཕན་ཚུན་སྤངས་ཏེ་གནས་པའི་མཚན་ཉིད་ཀྱི་འགལ་བས་ནི་དེའི་བདག་ཉིད་འགོག་པར་རབ་ཏུ་གྲུབ་སྟེ།",
    "ལྟོས་པ་དང་བཅས་པ་དང་ངེས་པར་འགྱུར་བ་ཡིན་ནོ།",
    "ངེས་པར་འགྱུར་བ་དང་།",
    "འགལ་བས་ཁྱབ་པ་དམིགས་པ་ཡང་གནོད་པ་སྒྲུབ་པར་བྱེད་པ་པོ་ཡིན་ནོ་ཞེས་ཅི་ནས་ཀྱང་བསྟན་པའི་དོན་དུའོ།",
    "འདི་ལྟར་དངོས་པོ་བྱུང་བའི་འཇིག་པ་ཡང་ངེས་པར་འགྱུར་བ་མེད་དེ་རྒྱུ་གཞན་ལ་ལྟོས་པའི་ཕྱིར་རོ་ཞེས་སྦྱོར་བ་མཐོང་བ་ཡིན་ནོ།",
    "དེའི་དབྱེ་བ་ནི་དེ་ལས་ཐ་དད་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "དེ་ལས་འབྲས་བུའི་གཏན་ཚིགས་ནི་འགལ་བའི་འབྲས་བུར་དམིགས་པ་ཡིན་ལ་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱང་འགལ་བས་ཁྱབ་པར་དམིགས་པ་ཡིན་ཏེ།",
    "མེ་མ་ཡིན་པ་དང་རྟག་པ་དག་མེད་པར་སྒྲུབ་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "རྗེས་སུ་མཐུན་པར་རྟོགས་ན་ནི།",
    "མི་རྟག་པ་ཡིན་ནམ་མེ་དང་ལྷན་ཅིག་འབྲེལ་ན་གཏན་ཚིགས་ཁྱབ་པར་བྱེད་པ་དང་འགལ་བ་དང་འགལ་བར་འགྱུར་བ་ཡིན་པས་དེ་མི་དམིགས་པའི་ངོ་བོར་རྟོགས་པ་ཡིན་ནོ།",
    "སྦྱོར་བ་ཙམ་ཞིག་ཐ་དད་པར་བྱས་པ་ཡིན་ནོ།",
    "འོན་ཏེ་དོན་དམ་པར་རྣམ་པར་གཅོད་པ་ཙམ་སྒྲུབ་པའི་ཕྱིར་མི་དམིགས་པ་ཉིད་དོ་ཞེས་འདོད་ན།",
    "ལྟོས་པ་དང་བཅས་པའི་ཕྱིར་ནི་འཇིག་པ་ངེས་པར་མི་འགྱུར་ཏེ།",
    "གཞན་ཡང་དེ་བཞིན་ཡིན་པས་འབྲས་བུ་ཡོད་པར་མི་ངེས་སོ།",
    "འོན་ཏེ་གྲུབ་པ་ལ་ཡང་ཁྱད་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལྟ་ཡིན་ན་ཁྱད་པར་གྲུབ་པ་ཉིད་དམ།",
    "གལ་ཏེ་དེ་གྲུབ་ན་དེའི་བདག་ཉིད་བྱ་བ་མི་ནུས་པའི་ཕྱིར་དེའི་བདག་ཉིད་ལས་ཐ་དད་པར་བྱ་བ་ཡིན་ན།",
    "དེ་ལྟ་ཡིན་ན་འདི་དེའི་ཕན་འདོགས་པར་བྱེད་པ་མ་ཡིན་པ་ཉིད་པས་འདི་དེའི་ཅི་ཞིག་ཡིན་ཏེ།",
    "འབྲས་བུ་ཐམས་ཅད་གྲུབ་བྱེད་པར།",
    "འཇིག་པར་བྱེད་པས་ཅི་ཞིག་ཡོད།",
    "ཆུ་མི་འགོག་པར་རགས་འཛུགས་པ་མ་ཡིན་ཏེ།",
    "འགལ་བ་འདི་ཡང་ཟློག་པར་བྱེད་པ་ཉིད་མ་ཡིན་ནམ།",
    "ཕན་ཚུན་སྤངས་པ་ཙམ་གྱིས་ནི་ཟློག་པར་བྱེད་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "འོན་ཏེ་དུས་གཞན་གནས་པར་གྲུབ་པ་འཇིག་པའི་རྒྱུ་སྟོང་པའི་མཚན་ཉིད་ཅན་གྱི་དངོས་པོ་མེད་པར་བྱེད་དོ་ཞེ་ན།",
    "དུས་གཞན་དུ་གནས་པ་ལ་དེ་དང་མི་འགལ་བའི་ལྟོས་པ་ཉིད་བྱས་པ་ནི།",
    "དེ་ཟློག་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཆུ་ཡང་བུམ་པ་སོ་མ་བཏང་བའི་ཟློག་པར་བྱེད་པ་ཉིད་དོ་ཞེ་ན།",
    "གལ་ཏེ་རྗེས་སུ་དཔག་པས་དུས་གཞན་དུ་གནས་པར་གྲུབ་པ་ཉིད་ལོག་པར་བྱེད་དོ་ཞེ་ན།",
    "དེ་ཉིད་ལོག་པར་བྱེད་མ་ཡིན།",
    "དེ་ཡང་ལྡོག་པར་བྱེད་པ་མིན།",
    "དེས་ན་དེ་གྲུབ་པ་ཡང་བདེན་པ་ཉིད་པས་ཅི་ལྟར་དེ་མེད་པར་འགྱུར།",
    "མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་མེད་པར་འགྱུར་རོ།",
    "དངོས་དེ་ཅི་ལྟར་འགྲུབ་པར་འགྱུར།",
    "བུམ་པ་ལ་སྔོན་དུ་འགྲོ་བ་ཅན་གྱིས་གཞན་དུ་གྱུར་པ་ནི་དེའི་ཞེས་བསྟན་པར་འགྱུར་བ་ཡིན་ན།",
    "ཅི་ལྟར་གཞན་དུ་གྱུར་པའི་མཚན་ཉིད་འཇིག་པར་ཡིན།",
    "ཅི་ལྟར་དེ་དེའི་འབྲས་བུ་ཡིན་པར་འགྱུར་ཞེ་ན།",
    "འཇིག་པ་ཡང་གཞན་གྱི་ཚེ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ནི་འཇིག་པ་ཡིན་པར་མི་འཐད་དོ།",
    "དེ་མེད་དོ་ཞེས་གཞི་མཐུན་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་འདིར་ཡང་གཞི་མཐུན་པ་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དངོས་པོ་མེད་པར་ཐ་དད་པར་སྨྲ་བ་ལ་མེད་དོ་ཞེས་གཞི་མཐུན་པ་མེད་པར་འགྱུར་རོ།",
    "དེས་ན་དངོས་པོ་མེད་པ་ན་དངོས་པོ་ལ་གཞན་མ་ཡིན་པ་དེའི་ཕྱིར་གཞི་མཐུན་པར་འགྱུར་རོ།",
    "དེས་ན་གཞན་དང་མ་འབྱོར་པར་རྟོགས་པ་སྐྱེས་པ་ཙམ་ལས་གྲུབ་པ་གཞན་ལ་མི་ལྟོས་སོ།",
    "དེ་ལྟ་མིན་པར་ཅི་ལྟར་འགྱུར།",
    "ལྟོས་ལ་བརྟེན་པར་མི་འདོད་བཞིན།",
    "སྐད་ཅིག་ཀྱང་དངོས་པོ་ཡོད་པའི་སྐབས་མེད་པར་འགྱུར་རོ།",
    "རྟག་ཏུ་ཡོད་པའམ་མེད་པར་འགྱུར།",
    "དེའི་བདག་ཉིད་དུ་གྱུར་པ་ཡིན་ལ་དེ་མེད་པར་ཡང་འགྱུར་རོ་ཞེས་བྱ་བར་མི་འཐད་དོ།",
    "འཇིག་པ་དང་མི་ལྡན་པར་འཇིག་པ་ཅན་དུ་ཅི་ལྟར་འགྱུར་ཞེ་ན།",
    "དངོས་པོ་སྔ་མ་ཁོ་ན་བཞིན་དུ་དམིགས་པར་འགྱུར་རོ།",
    "གཞན་གྱི་རང་བཞིན་འཕྲོག་པར་བྱེད་པ་མ་ཡིན་པ་ཞེས་བྱ་བ་གང་ཡིན་པའོ།",
    "གདོན་མི་ཟ་བར་འཇིག་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "འབྲེལ་པ་མེད་པའི་ནི་གཏན་ཚིགས་བསྒྲུབ་བྱ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "གང་ཞིག་གང་མེད་པར་ཡང་མཐོང་བ་དེ་ཅི་ལྟར་དེའི་རྒྱུ་ཅན་ཡིན།",
    "ཅི་ལྟར་འཇིག་པར་བྱེད་པ་ཉེ་བས་གྱོ་མ་ལ་སོགས་པར་གྱུར་པ་ན་བུམ་པ་ཕྱི་མ་དང་འབྲེལ་པ་མེད་པར་རྟོགས་པ་དེ་བཞིན་དུ་སྐྱེས་མ་ཐག་པར་ཡང་ཡིན་ནོ།",
    "འཇིག་པ་ཉིད་ཀྱིས་མི་འབྱོར་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "འཇིག་པ་ཉིད་ཀྱིས་དེ་བྱས་མིན།",
    "གང་ཞིག་གཞན་དུ་རྟོགས་པར་ནུས་པ་དེ་ནི་གཞན་དུ་གྱུར་པ་ཉིད་མ་ཡིན་ཏེ།",
    "མྱུར་བར་ནུབ་པར་འགྱུར་བའི་ཕྱིར།",
    "འཇིག་པར་ཐ་དད་པར་གྱུར་པ་ལ་མ་ཡིན་ནོ་ཞེས་གང་བརྗོད་པ་དེ་ཡང་མི་རུང་སྟེ།",
    "འོན་ཀྱང་ཕྱི་མ་དང་འབྲེལ་པར་རྟོགས་པའི་ངོ་བོ་ཉིད་ཡིན་ཏེ།",
    "ཅི་ལྟར་ཚོགས་པ་ཐ་མ་དེ་མྱུ་གུ་སྐྱེད་པའི་རང་བཞིན་དུ་ངེས་པར་དངོས་པོ་ཡང་དེའི་ཕྱིས་ཀྱི་དངོས་པོ་དང་འབྲེལ་པ་མེད་པའི་ཐ་སྙད་དུ་ངེས་པ་ཡིན་ནོ་ཞེས་ཅི་སྟེ་མི་འདོད།",
    "གཞན་ཡང་ལྟོས་པ་མེད་པ་ཉིད་ཀྱིས་སྤྱིར་དེ་ལ་ངེས་པ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "སྒྲ་དང་བུམ་པའམ་ལུས་ཅན་དག་ལུས་ཅན་མ་ཡིན་པར་རྟོག་པ་བཞིན་ནོ།",
    "དེ་ལ་ཁྱད་པར་དང་སྤྱི་དག་གོ་བར་བྱེད་པ་ཉིད་དུ་རྩོད་པ་སྤང་བ་ཡིན་ནོ།",
    "རྟག་གོ་ཞེས་བྱ་བ་ནི་གོ་བྱེད་ཡིན་པར་འགྱུར་རོ།",
    "ཁྱད་པར་ལ་ནི་ལྟོས་མ་ཡིན།",
    "གཞན་ལ་ལྟོས་པར་མ་མཐོང་ངོ།",
    "ལྡོག་པ་ཡོངས་སུ་རྫོགས་པ་ཡོད་པ་ལྟོས་པར་མི་འགྱུར་ཏེ།",
    "རྗེས་སུ་འགྲོ་བ་ཡོད་པ་ཙམ་ལྟོས་པར་འགྱུར་གྱི།",
    "རྟག་པ་ཉིད་རྣམ་པར་གཅོད་པས་གོ་བར་བྱེད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་མི་རྟག་པ་ལ་མཐོང་བ་དེ་ལྟར་ན་ཡང་རྟག་པ་མེད་པར་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "རྟག་པ་ལ་མེད་པར་མཐོང་བས་ནི་དེ་མེད་པར་སྒྲུབ་ན་ནི།",
    "ངེས་པར་ཕུང་པོ་བཞིན་དུ་འཇུག་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་མཐོང་བའི་མེ་ཉིད་ཐམས་ཅད་གོ་བར་བྱེད་པར་འགྱུར་གྱི།",
    "མཐོང་བའི་རྗེས་སུ་འབྲང་བས་ནང་དུ་སྡུད་པར་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "མཐོང་བས་ནི་སྣང་བ་ཉིད་ངེས་པར་བྱེད་ཀྱི་དེ་ལས་གཞན་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་མཐོང་བའི་སྒོ་ནས་འབྲེལ་པ་རྟོགས་པ་ནི་ཅི་ལྟར་ལྡོག་པས་འབྲེལ་པ་རྟོགས་པར་འགྱུར་རོ་ཞེ་ན།",
    "འདི་ཡང་འཚམ་པར་བརྗོད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟ་ཡིན་ན་འཁྲུལ་པར་འགྱུར་ལ།",
    "འཁྲུལ་པའི་ཕྱིར་ན་སྔ་མ་འབྲེལ་པ་ཉིད་ཡིན་པར་མི་འགྱུར་རོ།",
    "གཞན་དུ་རྟོགས་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "རྒྱུའི་སྤྱི་རྟོགས་པར་འགྱུར་གྱི་དེ་སྤྱི་ནི་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དུ་བ་འདི་ནི་སྒྲུབ་པར་བྱེད་པའི་ཁྱད་པར་རྣམས་གཅིག་འགའ་ཞིག་མེད་ན་མི་འགྱུར་བའི་ཕྱིར་འདི་མེད་པ་ལས་དུ་བ་ལྡོག་པ་ཡིན་ནོ་ཞེས་གཞན་སེལ་བ་ཉིད་ཀྱི་སྒོ་ནས་འབྲེལ་པ་བཟུང་བའི་ཕྱིར་སྒྲ་དང་རྟགས་ཀྱིས་ནི་ལྡོག་པ་ཉིད་བསྒྲུབ་པ་ཡིན་ནོ།",
    "རྣམ་གཉིས་དེ་མེད་ལ་མེད་པར་ངེས་པ་གང་ཡིན་པ་དེ་ནི་གཏན་ཚིགས་ཡིན་ཞིང་ཟློག་པར་ངེས་པ་ནི་དེ་ནི་འགལ་བ་ཡིན་ནོ།",
    "འགལ་བ་མི་འཁྲུལ་པ་ཅན་གྱི་ཡུལ་ཕྲོགས་པ་ནི་བསྒྲུབ་པར་བྱ་བ་ལ་འབྲེལ་པ་མ་ཡིན་པ་ཉིད་དོ།",
    "གར་ཡང་མཉནཔར་བྱ་བ་ཉིད།",
    "སློབ་དཔོན་གྱིས་གསུངས་པ།",
    "གལ་ཏེ་འདིར་འགའ་ཞིག་བྱས་པ་ཉིད་ཀྱང་མི་རྟག་པའི་གཏན་ཚིགས་སུ་མི་བརྗོད་ན་གོ་བར་བྱེད་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ཁས་ལེན་པའི་བྱེ་བྲག་ཉིད་ཤིན་ཏུ་དོགས་པར་ཆུད་པ་ཡིན་ནོ།",
    "གལ་ཏེ་སྒྲ་མི་རྟག་པར་ནི།",
    "འདོད་ན་སྒྲ་ཉིད་རྟག་པར་དེར།",
    "དེ་ལྟ་ཡིན་དང་ཐ་སྙད་མཐའ་དག་ཆད་པར་འགྱུར་རོ།",
    "མཉན་བྱ་ཉིད་ཀྱང་བྱས་པ་དང་གཏན་ཚིགས་ཀྱི་རིགས་མཚུངས་པ་ཡིན་ཏེ་དེས་ན་བྱས་པ་ཉིད་འདི་ཡང་བསྒྲུབ་པར་བྱ་བ་ལས་བཟློག་པ་འཁྲུལ་པ་མེད་པ་ཅན་ཡིན་པས།",
    "ཅི་ལྟར་གོ་བར་བྱེད་པ་ཉིད་མ་ཡིན་པ་དེའི་ཕྱིར་གཞན་གྱིས་ཁས་བླངས་པས་འགལ་བ་མི་འཁྲུལ་པ་ཡིན་གྱི་གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་སློབ་དཔོན་གྱི་དགོངས་པ་རྟོགས་པར་བྱ་སྟེ།",
    "བྱས་པ་མི་རྟག་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "རྟག་པ་མ་བྱས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་དང་།",
    "ནུས་པར་བྱེད་པ་ནུས་པའི་ཕྱིར་དང་།",
    "དཔེར་ན་སྒྲ་མི་རྟག་སྟེ་བྱས་པ་མི་རྟག་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་སྒྲ་ཡང་བྱས་པ་ཡིན་ནོ།",
    "སྒྲ་ནི་མི་རྟག་སྟེ་རྟག་པ་མ་བྱས་པའི་ཕྱིར་རོ།",
    "བསྒྲུབ་བྱ་སྒྲུབ་པར་བྱེད་པ་ལ།",
    "གལ་ཏེ་མེད་པ་འགའ་ཞིག་ལ་བྱེད་པ་མི་དམིགས་པ་དེ་ལྟར་ན་ཡང་ཐམས་ཅད་དེ་ལྟར་ཡིན་ནོ་ཞེས་བྱ་བའི་ཁྱབ་པ་ནི་ག་ལས་ཡིན་བཟློག་པའི་འབྲེལ་པ་མེད་པར་ནི་ལྡོག་པའི་ཁྱབ་པ་འགྲུབ་པ་མ་ཡིན་ནོ།",
    "མེ་ཡིས་དུ་ལ་ཁྱབ་པར་ནི།",
    "འགྲོ་བ་མཐའ་དག་ཏུ་བསྐོར་ཀྱང་དེ་དང་གཞན་ན་ཡང་མེད་དོ་ཞེས་ལྡོག་པའི་ཁྱབ་པ་རྟོགས་པར་ནུས་པ་ནི་མ་ཡིན་ཏེ།",
    "ཡུལ་དུས་ཁྱབ་པར་མཐའ་དག་བསྐོར་བ་ཉིད་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "དེས་ནི་ཡོད་པ་དང་མེད་པ་རབ་ཏུ་བསྟན་པའི་ཚུལ་གྱིས་གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པ་ཉིད་གསལ་བར་བྱས་པ་ཡིན་ནོ།",
    "ཚུལ་གསུམ་ལ་ལྷག་མ་ལུས་པ་རྟོགས་པར་བྱ་བའི་ཕྱིར་སྤྲོས་ལ།",
    "སྡང་ཡིད་རང་བཞིན་ཕྱོགས་བྱས་ནུས་པ་ནི།",
    "བདག་དང་གཞན་ལུགས་རིགས་དང་རིགས་མིན་དོན་འདིར་བྱས་འགྱུར་འདིར་ཆེར་རིགས།",
    "བྱས་ཏེ་དྲེགས་པའི་ཕྱིར་མ་ཡིན།",
    "དེས་ནི་འགྲོ་བ་ཀུན་གྱི་དོན་གྲུབ་པར།",
    "བམ་པོ་དྲུག་ཅུ་ལྷག་ཆད་མེད་པར་ཡོད་དོ།",
    "བྲང་འགྲོའི་རྒྱལ་པོས་འཁྱུད་མིན་ལེགས་པའི་བློ་ལའང་ལོག་པའི་ལམ་ཉིད་ཡིན་ཞེས་པར།",
    "ལེགས་པར་བསྟོད་པའི་བློ་ཅན་དེ་ཡི་ལམ་ལ་གོམས་བྱེད་རྩོམ་པའི་ལུས་ཅན་ནི།",
    "ལུང་ནི་ལྷག་པར་དོར་ནས་ནི།"
  ]
}