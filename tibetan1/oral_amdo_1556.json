    "ཡང་ལྷ་གཞུང་གཟུགས་ཀྱི་ཉི་མའི་ནང་དུ་གན་དྷི་བཟང་མོ་དང་པོ་གཟུགས་ཀྱི་ཉི་མའི་སྐྱེ་རོགས་བློ་ཤིན་ཏུ་ཉེ་བ་ཞིག་ལགས་ཀྱང་རྗེས་སུ་རྒྱལ་པོ་ཟླ་སེང་གི་བཙུན་མོ་ཆེན་མ་རིགས་ངན་བུ་མོས་གན་དྷེ་བཟང་མོ་ནོར་རྔན་གྱིས་བསླུས་ཏེ།",
    "མཐའ་མཇུག་གན་དྷེ་བཟང་མོས་གཟུགས་ཀྱི་ཉི་མར་དུག་སྦྱོར་བྱས་པ་དང་།",
    "གླང་ཆེན་སྲས་ཆུང་ངུ་བཅས་མོ་རང་གིས་བསད་པའི་ཁག་ངན་གཟུགས་ཀྱི་ཉི་མར་བཀལ་བར་བརྟེན་རྒྱལ་པོ་ཟླ་སེང་གིས་གཟུགས་ཀྱི་ཉི་མར་ཤ་ཟ་བདུད་མོའི་མིང་དང་བཅས་ཏེ་དུར་ཁྲོད་བསིལ་བ་ཚལ་དུ་ཕྱིར་མི་ལྡོག་པའི་རྒྱང་འབུད་གཏོང་དགོས་བྱུང་བ་སོགས་ཀྱི་བྱེད་གཏེ་ཕྲ་མེན་མཁན་དག་གི་མཚོན་རྟགས་ཡིན་ནོ།",
    "གར་གྱི་ཆ་བྱད་ལྔའི་ཁོངས་སུ་བཞད་གད་པའི་འགན་ཡང་དེ་དག་གིས་ལེན་སྲོལ་ཡོད།",
    "འབག་དམར་སྨུག་དེ་ནི་སྤྱིར་ཁྲོ་བའི་མཚོན་རྟགས་ཙམ་དུ་མ་ཟད་ད་ལན་ཧ་ཅང་བདུད་མོའི་འབག་གི་སྐབས་སུ་སྡུག་པའི་ཉམས་སུའང་བཀོད་ན་མཐུན་པར་སྣང་བ་ནི།",
    "ཁ་ནང་གི་མཆེ་བ་རིང་པོ་གོང་འོག་ཏུ་བཙིགས་པ།",
    "དྲི་ཟ་མོ་རྣམས་ནི་གཟུགས་མཛེས་ཤིང་ཡིད་དུ་འོང་བ་གླུ་གར་རོལ་མོ་འཁྲོལ་བ་ལ་མཁས་པ་སོགས་ཀྱི་འཇིག་རྟེན་ཁམས་དེ་ལྟ་བུར་གནས་པའི་ཡིད་ཅན་ཞིག་གི་མཚོན་རྟགས་སུ།",
    "ཡིད་འཕྲོག་ལྷ་མོའི་ཡབ་དྲི་ཟའི་རྒྱལ་པོ་ལྗོན་པ་གར་ལ་རོལ་བའི་ཚེ་ཅང་ཤེས་རྟ་ཡི་མགོ་བརྙན་གྱོན་པ་ཡང་།",
    "འཁྲབ་གཞུང་ནང་གི་ཡི་སྣའི་གཟུགས་བརྙན་བཀོད་པ་ལྟར་ལགས་སོ།",
    "ལྷ་གཞུང་པད་མ་འོད་འབར་ནང་གི་རྒད་མོ་སྤུན་ཚོང་མ་འདི་བཞིན་ལུས་རྒུད་པའི་སྟབས་ཀྱིས་སྡུག་པ་སྒུར་པོ་འཁར་བར་བརྟེན་པ།",
    "སྤྲུལ་པའི་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོ་དེ་མེ་མོ་གླང་གི་ལོར་ཡབ་གནམ་རི་སྲོང་བཙན་དང་།",
    "ཡབ་ཀྱིས་ཨ་མི་ཏཱ་བྷའི་ཞལ་སྦེད་ཕྱིར།",
    "ཨ་མི་ཏཱ་བྷའི་ཞལ་མཐོང་ཕྱིར་བསྙད་སྟབས།",
    "གསོལ་བ་བཏབ་མ་ཐག་ཏུ་ཙན་དན་ཀྱི་སྐུ་དེས་ཁྱོད་ཀྱིས་ང་ཡི་སྐུ་ཞིག་བཞེངས་ཤིག་ཅེས་གསུང་བྱོན་པ་དང་།",
    "ལྷོ་རྒྱ་མཚོའི་གླིང་གི་འཇག་མ།",
    "འཇིག་རྟེན་གྱི་ཁྱིམ་ཐབ་བཙུན་མོ་ཁབ་ཏུ་བཞེས་པར་དགོངས་ཏེ་ཐུགས་རྗེ་ཆེན་པོའི་སྐུ་རང་བྱུང་ལ་གསོལ་བ་བཏབ་པས་ཐུགས་ཀ་ནས་འོད་ཟེར་གཉིས་འཕྲོས་ཏེ།",
    "གཅིག་རྒྱ་ནག་ཏུ་སོང་།",
    "འོད་ཟེར་དེ་གཉིས་སོ་སོར་སོང་བའི་ཕྱོགས་སུ་གཟིགས་པས།",
    "བལ་པོའི་རྒྱལ་པོ་གོ་ཟེར་གོ་ཆ་ཞེས་བྱ་བར་སྲས་མོ་ལྷ་གཅིག་ཁྲི་བཙུན་ཞེས་བྱ་བ་དགུང་ལོ་བཅུ་དྲུག་ལོན་པའི་ན་ཚོད་ཅན་མཚན་དཔེས་མཛེས་ཤིང་།",
    "ལྷ་མོ་ཁྲོ་གཉེར་ཅན་གྱི་སྤྲུལ་པ།",
    "རིག་པའི་གནས་མཐའ་དག་དང་ལོངས་སྤྱོད་ལ་མངའ་བརྙེས་པ་ཞིག་འདུག་པ་གཟིགས་པ་དང་།",
    "ཡང་རྒྱ་ནག་རྒྱལ་པོ་ཐང་ཐའེ་ཛུང་ཞེས་བྱ་བར་སྲས་མོ་ལྷ་གཅིག་ཀོང་ཇོ་དགུང་ལོ་བཅུ་དྲུག་ལ་སོན་པ་ན་ཚོད་ཅན་མཚན་དཔེས་མཛེས་ཤིང་།",
    "ལྷ་མོ་སྒྲོལ་མའི་སྤྲུལ་པ།",
    "རྒྱ་བལ་སྲས་མོ་སྒྲོལ་མའི་སྤྲུལ་པ་གཉིས།",
    "ང་ཡི་བཙུན་མོར་བོད་དུ་གདན་དྲངས་ན།",
    "ཐོན་མ་ཀུན་ཏུ་བཟང་པོ་ལ་སོགས་པའི་སྣ་ཆེན་བློན་པོ་མི་བདུན་གྱིས་གཙོས་པའི་ནང་བློན་རྣམས་འོ་ཐང་མཚོ་འགྲམ་གྱི་ལྗོན་ཤིང་བསིལ་གྲིབ་འོག་ཏུ་རང་རང་གི་ཁྱོས་མའི་ཤ་བཟང་པོ་གཟུགས་རེ་ཁྱེར་ནས་གྲོས་རྭར་འཚོགས་པ་དང་།",
    "སྒྲོལ་མ་དཀར་སྔོན་སྤྲུལ་པའི་ཇོ་མོ་གཉིས།",
    "འདིར་ཡོད་བློན་པོ་ཐམས་ཅད་ནས་བཙུན་མོ་ཁྱད་འཕགས་ཅན་དེ་གཉིས་རྒྱལ་པོའི་ཁབ་ཏུ་འདྲེན་པར་གྲོས་འཆམས།",
    "ནུབ་ཕྱོགས་བལ་པོའི་ཡུལ་དུ་སོང་ཞིག་དོན་འགྲུབ་པར་འགྱུར་རོ།",
    "བལ་པོའི་རྒྱལ་པོས་བུ་མོ་སྟེར་མི་འདོད་པས་ཁྱོད་ལ་འདྲི་བ་ལན་གསུམ་དུ་བྱ་འོང་གི་འདྲི་བ་རེ་བཞིན་ང་ཡི་བཀའ་ཤོག་གི་སྒྲོམ་བུ་རེ་རིམ་གྱིས་སྤྲོད་ཅིག་ཅེས་བཀའ་ཤོག་སྒྲོམ་བུ་གསུམ་དང་བཅས་ནུབ་ཕྱོགས་བལ་པོའི་ཡུལ་དུ་བཀས་མངགས་སོ།",
    "ཁྱེད་ཀྱི་སྲས་མོ་ལྷ་གཅིག་ཁྲི་བཙུན་དེ།",
    "ང་ཅག་རྒྱལ་པོའི་བཙུན་མོར་གནང་དུ་གསོལ།",
    "ཞེས་ཞུས་པ་ན་བལ་པོའི་རྒྱལ་པོས་ཁྲེལ་ཞིང་དགོད་པ་དང་ཅི་ཡང་མི་སྨྲ་བར་མིག་བཙུམས་ནས་རིང་མོར་བསམས་རྗེས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "ང་ཡི་བུ་མོའི་གཉེན་ཟླ་དེ་མི་ཡོང་།",
    "བློན་པོ་མགར་གྱིས་སྤྲུལ་པའི་རྒྱལ་པོའི་བཀའ་ལུང་དེ་ཡིད་ལ་ཁྲ་ལམ་མེར་དྲན་ནས་བལ་རྗེར་བཙན་པོས་གནང་བའི་འཕྲིན་ཞིག་ཡོད་ཅེས་གསེར་ལས་བྱས་ཤིང་བལ་པོའི་ཡི་གེར་བཀོད་པའི་བཀའ་ཤོག་གི་སྒྲོམ་བུ་དང་པོ་དེ་བལ་རྗེའི་ཕྱག་ཏུ་ཕུལ་བ་དང་།",
    "བལ་རྗེས་གཟིགས།",
    "ཁྲི་བཙུན་བོད་རྗེའི་བཙུན་མོར་སྟེར་བར་བྱ།",
    "ཅེས་སྐུ་གསུང་ཐུགས་ཀྱི་རྟེན་བཞེངས་ནུས་མིན་ལན་དགོས་པའི་འདྲི་བ་གཉིས་པ་བྱས་པར་བོད་ཀྱི་བློན་པོས་ཡང་དངུལ་གྱིས་བྲིས་པའི་བཀའ་ཤོག་གི་སྒྲོམ་བུ་གཉིས་པ་དེ་བལ་རྗེའི་ཕྱག་ཏུ་ཕུལ་བས།",
    "བལ་རྗེས་བཀླགས་ནས་དེའི་ནང་ངས་ཉིན་མོ་གཅིག་ལ་སྐུ་ལུས་ཀྱི་བཀོད་པ་ལྔ་སྟོང་དུ་སྤྲུལ་ནས་བོད་དུ་གཙུག་ལག་ཁང་བརྒྱ་རྩ་བརྒྱད་བཞེངས་ཏེ་སྒོ་ཐམས་ཅད་ནུབ་ཕྱོགས་བལ་པོའི་ཡུལ་དུ་བསྟན་ལ་བཞག་གིས་དེ་ལ་ངོ་མཚར་མི་ཆེ་འམ་ཞེས་འཁོད་པ་མཐོང་བས།",
    "དེར་བལ་པོའི་རྒྱལ་པོའི་ཐུགས་དགོངས་ལ་འདི་ནི་ངས་ཐུབ་པར་དཀའ་བ་ཞིག་འདུག་བུ་མོ་མ་སྦྱིན་ན་ནི་ཁོས་དེ་ཙམ་གྱི་སྤྲུལ་པ་བྱས་ནས་དམག་དྲངས་ཏེ་ང་བསད།",
    "ང་ཡི་ལྷ་གཅིག་བོད་རྗེའི་བཙུན་མོར་སྟེར།",
    "ཡང་བློན་པོ་མགར་གྱིས་བཀའ་ཤོག་གི་སྒྲོམ་བུ་གསུམ་པ་དེ་བལ་རྗེའི་ཕྱག་ཏུ་ཕུལ་བས།",
    "བོད་རྗེར་རྣམ་སྤྲུལ་ཡང་བསམ་གྱིས་མི་ཁྱབ་པ་མངའ་བས་བུ་མོ་སྦྱིན་པ་རང་དྲག་སྙན་ནས།",
    "བལ་རྗེས་ལྷ་གཅིག་ཁྲི་བཙུན་ཡབ་ཀྱི་དྲུང་དུ་བཀུག་ནས་སྲས་མོ་ཁྲི་བཙུན་ལ་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "གཏན་གྱི་འདུན་མར་ཁྱོད་ཉིད་འགྲོ་བར་རིག་ཅེས་གསུངས་པ་དང་ལྷ་གཅིག་ཁྲི་བཙུན་དེས་ཡབ་ཀྱི་དྲུང་དུ་པུས་མོ་ས་ལ་བཙུགས་ནས་ཕུག་དང་བཅས་ཏེ་འདི་སྐད་ཅེས་གསོལ་ལོ།",
    "བརྩེ་བའི་ཡབ་གཅིག་བུ་མོ་བདག་ལ་གསོན།",
    "དེ་འདྲའི་ཡུལ་དུ་བུ་མོ་དགོངས་པ་ཞུ།",
    "བུ་མོ་ཁ་བ་ཅན་དུ་མ་ཕྱིན་ན།",
    "བུ་མོ་ཁྱོད་ཁ་བ་ཅན་དུ་ཕྱིན་ནས་ཁྱོད་ཀྱི་བསམ་རྒྱུད་དང་སྤྱོད་པ་འདི་ལྟར་གྱིས་ཤིག་ཅེས་ཡབ་ཀྱི་ཞལ་ནས་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "བུ་མོ་ཁ་བ་ཅན་དུ་ཕྱིན་ནས་ཀྱང་།",
    "ཁྲི་བཙུན་གྱི་ཆིབས་དྲེའུ་དཀར་མོ།",
    "སྐྱེལ་སྲུང་གི་བློན་པོ་དང་བལ་དམག་རྣམས་ཡབ་ཀྱི་བཀས་མངགས་སོ།",
    "དྲེའུ་དཀར་མོ་གཅིག་ལ་ཁྲི་བཙུན་ཆིབས།",
    "བལ་པོའི་བློན་དམག་གི་སྐྱེལ་མ་དང་བཅས་ཆིབས་རྡོག་ཐོན་ཏེ་ཤར་ཕྱོགས་བྷི་ཏའི་ནགས་སུ་ཕྱག་ཕེབས་པ་དང་།",
    "དེ་དོན་དྲི་བར་བྱ་བ་ལ་ནི་ཁོང་གིས་བལ་སྐད་མི་ཤེས།",
    "དེ་ལྟར་ཤིང་མོ་ལུག་གི་ལོ་ལ་དམར་པོ་རི་སྟེང་དུ་མཁར་གྱི་རྨང་བཏིང་།",
    "གྲྭ་བཞི་སོ་ཕག་གི་རྩིག་པ་དཔངས་ཀྱང་ཕྲེད་སུམ་ཅུ་རྩ་དྲུག་གི་ཚད་བསྐོར།",
    "མཐོ་ཞིང་རྒྱ་ཆེ་བ་སྟེ་ལོགས་རེ་ལ་རྒྱང་གྲགས་རེ་ཡོད་པ།",
    "དམར་པོ་རི་ཡི་དཀྱིལ་དུ་རྩེ་མོ་མཐོ་བ་གཅིག་དང་བཅས་སྟོང་དུ་ཚང་བ་དེ་རྣམས་ཀྱི་རྩེར་དར་དམར་སྐེད་ཁྲ་ཅན་བཏགས་པའི་མདུང་དམར་བཅུ་བཙུགས་ཤིང་།",
    "ཟབ་འདོམ་དོ་བྲུས་པར་ཤིང་སོ་ཕག་གིས་ཕུབ་སྟེ་ཟངས་མས་གཡོགས་པ།",
    "སིལ་ཁྲོལ་གྱི་སྒྲ་སྐད་རོལ་མོ་སྣ་ཚོགས་པར་གྲགས།",
    "ཉིན་མཚན་དང་ལམ་འཕྲང་གང་དུའང་རྗེ་བཙུན་སྒྲོལ་མར་གསོལ་བ་འདེབས་ཀྱིན་དུ་སོང་ཞིག་གསུངས་སོ།",
    "ལོགས་རེ་ལ་ཉིན་ལམ་རེ་ཙམ་གདའ་བའི་སྒོ་མོ་ཆེ་བཞི་ཡོད་པས།",
    "གེ་སར་དམག་གི་རྒྱལ་པོའི་བློན་པོ་བརྒྱ་ཐམ་པ་ཡང་རྒྱ་མོ་ཀོང་ཇོ་འདོད་པར་སླེབས།",
    "ཏ་ཟིག་ནོར་གྱི་རྒྱལ་པོའི་བློན་པོ་རྟ་པ་བརྒྱ་ཐམ་པ་ཡང་ཀོང་ཇོ་འདོད་པར་སླེབས།",
    "ཏ་ཟིག་བ་རྣམས་ནུབ་སྒོར་བསྡད།",
    "རྒྱ་ནག་གི་སྲས་རྒྱལ་བུས་གེ་སར་དམག་གི་རྒྱལ་པོ་ཁོང་དཔའ་རྩལ་ཆེ་བས་ལྷ་གཅིག་ཀོང་ཇོ་ཁོང་ལ་སྟེར་ཟེར་ནས་བར་ཆེན་བཏང་།",
    "ཡུམ་ན་རེ་ངེད་ཀྱི་ལོངས་སྤྱོད་ཆེ་བས་བོད་ཀྱིས་ངེད་ཚོའི་ལོངས་སྤྱོད་ཀྱི་དོ་མི་ནུས།",
    "ཏ་ཟིག་ནོར་གྱི་རྒྱལ་པོ་ལོངས་སྤྱོད་ཆེ་ཞིང་དུས་ངན་པ་བྱུང་ན་ཟས་ནོར་དགོས་པས་ལྷ་གཅིག་ཏ་ཟིག་ནོར་གྱི་རྒྱལ་པོར་སྟེར་ཟེར་ནས་བང་ཆེན་བཏང་།",
    "ལྷ་གཅིག་ཀོང་ཇོ་ན་རེ་མི་ཚེ་རིམ་གྱིས་འགྲོ་དགོས་པས་ན་གཙོ་བོ་མི་རང་གལ་ཆེ་སྟབས་བྷ་ཏ་ཧོར་གྱི་རྒྱལ་པོ་གཟུགས་བཟང་བས་ཧོར་ལ་འགྲོ་ཟེར་ནས་བང་ཆེན་བཏང་།",
    "བོད་བློན་རྣམས་ནི་མཇལ་བར་ཞུས་ཀྱང་སྒུག་ཏུ་བཅུག་ནས་ཞག་བདུན་སོང་བ་དང་།",
    "འཛམ་བུའི་གླིང་ན་ཁྲབ་འདི་ལ་གོང་ཐང་བཅད་པས་མི་ཆོད་འདི་ནི་ལྷ་གཅིག་གི་རིན་དུ་འབུལ་རྒྱུ་ཡིན་པས།",
    "ཁྱེད་ཀྱིས་ལྷ་གཅིག་མཛངས་མ་དེ་ངེད་བོད་ཀྱི་རྒྱལ་པོའི་བཙུན་མོར་གནང་བར་ཞུ་བྱས་པས།",
    "ང་ནི་རྒྱ་ནག་སྤྱི་བོའི་རྒྱལ་པོ་ནས་བཟུང་དེང་སང་གི་བར་དུ་རྒྱལ་རྒྱུད་མ་ཆད་པ་ཞིག་ཡིན།",
    "ཁྱོད་བོད་ཀྱི་རྒྱལ་པོས་ངའི་སྟོབས་དང་མངའ་ཐང་གི་དོ་མི་འཕེར།",
    "བློན་པོ་མགར་ན་རེ།",
    "འཕྲིན་རེ་ལ་རྒྱ་བོད་བར་ཕར་འགྲོ་ཚུར་འོང་བྱས་ན་ས་ཐག་རིང་བས་ལྷ་གཅིག་སྤྱན་འདྲེན་ཐུབ་པའི་ཐབས་མེད།",
    "རྒྱལ་པོས་ཁ་ཕྱེ་ནས་གཟིགས་པའི་ཚེ།",
    "མཐིང་ཤོག་ལ་གསེར་གྱིས་བྲིས་པའི་རྒྱ་ཡིག་གི་ནང་དོན་དུ།",
    "རྒྱལ་པོ་ན་རེ།",
    "ཁྱོད་བོད་ཀྱི་རྒྱལ་པོ་དེ་ཁ་ཕོ་ཆེ་བར་འདུག།",
    "ཁྱོད་བོད་ཀྱི་ཡུལ་ལ་གཙུག་ལག་ཁང་རྩིག་ནུས་པའི་སྟོབས་ཡོད་དང་མེད།",
    "དེ་ཡོད་ན་བུ་མོ་སྟེར་ལ་མེད་ན་མི་སྟེར།",
