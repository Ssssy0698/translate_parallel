    "ཚུར་ལ་གསོན་དང་བུ་མོའི་ཡབ་ཡུམ་གཉིས།",
    "བུ་མོ་སྣང་ས་བདག་ལ་གསན་པར་ཞུ།",
    "བུ་མོ་བདག་ལ་ཕ་མ་ལོས་ཀྱང་ཡོད།",
    "དགོང་མོ་ཉལ་བའི་རྟིང་མ་བྱས་ནས་ཟས་ཀྱི་གཡོས་སྦྱོར་དང་།",
    "དེ་ནས་བུ་མོ་སྣང་ས་འོད་འབུམ་དེ་དགུང་ལོ་ལྔ་གསུམ་བཅོ་ལྔ་ཙམ་ལོན་པའི་ཚེ་དབུས་གཙང་དྭགས་ཀོང་ཚང་མར་བུ་མོའི་སྙན་གྲགས་ཀྱིས་ཁྱབ་པ་ལ་བརྟེན་ནས་སྣང་ས་སློང་མི་མང་པོ་བྱུང་ཡང་།",
    "དེ་ནས་མི་འགྱངས་པར་ཡུམ་དེ་ཚེ་ཡི་དུས་བྱས་པས་ཡབ་སྲས་གཉིས་ཀར་བཙུན་མོ་མེད་པར་བརྟེན་ཡབ་ཀྱི་ཐུགས་དགོངས་ལ།",
    "དེའི་དུས་སུ་བུ་མོ་སྣང་ས་འོད་འབུམ་ཡང་།",
    "རྒྱན་གོས་འཛོམས་པ་བཅས་ཡབ་ཡུམ་གཉིས་ནས་ཀྱང་བུ་མོ་སྣང་ས་ཁྲོམ་ཐོག་གཅོད་ཕྱིར་གཏོང་འདོད་མཛད་དེ།",
    "རྟེན་རྣམས་ལ་ཕྱག་བསྐོར་དང་མཆོད་འབུལ་བྱས་མཇུག་དུས་སྟོན་གར་འཆམ་ལྟད་མོ་བལྟ་བར་བྱོན་ནས་བུ་མོ་རྣམས་དང་ལྷན་ཅིག་ཁྲོམ་མི་མང་གི་དབུས་ན་བཞུགས་པ་དང་།",
    "རི་བོང་བྱ་གླག་གིས་ཁྱེར་བ་བཞིན་དུ་འཁྲིད་ཡོང་སྟེ་དཔོན་སྒྲ་ཆེན་པས་ལག་པ་གཡོན་གྱིས་སྣང་སའི་ཐུ་གཤམ་ནས་བཟུང་།",
    "རེག་བྱ་འཇམ་པ་འདོད་ཡོན་ལྔ་ལྡན་ཁྱོད།",
    "ལྷ་ཀླུ་དྲི་ཟ་མི་སོགས་སུའི་བུ་མོ།",
    "བུ་མོའི་ཕ་ཡི་མིང་ལ་ཇི་སྐད་ཟེར།",
    "བུ་མོའི་མ་ཡི་མིང་ལ་ཇི་སྐད་ཟེར།",
    "བུ་མོ་ཁྱོད་རེའི་མིང་ལ་ཇི་སྐད་ཟེར།",
    "ཕྱི་ཡི་ལྕགས་རི་ནང་གི་ནོར་བུ་ཡིན།",
    "ཁྱོད་ཀྱིས་དེ་ཡི་ཁྱིམ་ཐབ་མི་བྱེད་དམ།",
    "ཞེས་སྨྲས་མ་ཐག་ཏུ་བུ་མོ་སྣང་སའི་ཐུགས་ལ་ངའི་ཁ་སྒོ་སྐྱེ་འབྲས་འདི་དགྲ་ལ་ལངས་ཏེ་འདོད་པ་དམ་པའི་ལྷ་ཚོས་འདོད་ཀྱང་།",
    "བུ་མོ་སྣང་སའི་ཕྱོགས་ལ་རྣ་བ་གསོན།",
    "ཡུལ་གྱི་མིང་ལ་ལྗང་གི་ཕད་ཁུད་ཟེར།",
    "ཨ་མའི་མིང་ལ་མྱང་ཚ་གསལ་སྒྲོན་ཟེར།",
    "ང་རེའི་མིང་ལ་སྣང་ས་འོད་འབུམ་ཟེར།",
    "མི་ཁྱིམ་ཕལ་བ་གཅིག་གི་བུ་མོ་ཡིན།",
    "དོ་ལོ་སྔོན་མོ་ཁ་དོག་མཚར་ན་ཡང་།",
    "བྱེའུ་ལྕོག་མོ་གཤོག་འགྱུར་མཁས་ན་ཡང་།",
    "བུ་མོ་སྣང་ས་སྐྱེ་འབྲས་ལེགས་ན་ཡང་།",
    "མི་ཆེན་དཔོན་པོའི་བཙུན་མོ་གང་ནས་ཡོང་།",
    "བུ་མོ་སྣང་ས་ཅིས་ཀྱང་གཏོང་གྲོགས་མཛོད།",
    "མོ་གསར་བག་མར་འགྲོ་བའི་རྟགས།",
    "ཞེས་ཟེར་བ་ཡིན་པས་བུ་མོ་འདི་ལ་ཁྱིམ་ཐབ་འཇིག་རྟེན་ལ་ཨེ་འགྲོ་ཞེས་དཔོན་པོས་བཀའ་འདྲི་གནང་ན་སེམས་ཀྱི་གཏིང་ནས་འགྲོ་འདོད་ཡོད་ཀྱང་མི་མང་ཚོགས་སར་འགྲོ་འདོད་མེད་པའི་སྤམ་རྫུ་ལོ་བྱེད།",
    "ལྟ་བས་མི་ངོམས་ལྷ་ཡི་བུ་མོ་འདྲ།",
    "བུ་མོ་སྤྱང་གྲུང་འཛོམས་ཀྱང་གླེན་མ་རེད།",
    "དམའ་བ་ས་ཡི་སྟེང་གི་པད་མ་གཉིས།",
    "རིང་བའི་མདའ་མོ་མཚལ་ལྟོང་རྒོད་སྒྲོ་དང་།",
    "ཐུང་བའི་གཞུ་མོ་ར་རྒོད་འཁྱིལ་བ་གཉིས།",
    "ཕལ་པའི་བུ་མོ་སྣང་ས་འོད་འབུམ་གཉིས།",
    "བུ་མོ་སྣང་ས་བག་མར་སློང་ཚར་བས།",
    "བར་པ་རྣམས་ཀྱིས་བུ་མོ་སློང་ས་མེད།",
    "མཐོ་བ་གནམ་ལ་འཕུར་སོང་ཟེར་ས་མེད།",
    "དམའ་བ་ས་ལ་འཛུལ་སོང་ཟེར་ས་མེད།",
    "རི་ནང་དཔོན་པོས་བུ་མོ་སྣང་ས་ནི།",
    "བུ་མོ་སྣང་སའི་སྤྱི་གཙུག་ལ་གཙུག་གཡུ་དང་།",
    "གཡོག་མོ་འཛོམས་པ་སྐྱིད་གཉིས་པོས་མདའ་དར་དང་།",
    "ཡུམ་མྱང་ཚ་གསལ་སྒྲོན་གྱིས་གཟིམ་ཆུང་ནང་ནས་གཟིགས་པས།",
    "རང་རེའི་ཁྱིམ་གྱི་སྒོ་དྲུང་མ་གི་ན།",
    "སྐུ་དོན་གང་ཡིན་ཁྱོད་ཀྱིས་ལེགས་པར་དྲིས།",
    "བུ་མོ་སྣང་ས་རང་ལ་ཡང་རྒྱན་འདོགས་བས་མཛད་དེ་འདི་ལྟར་གསུངས་སོ།",
    "བུ་མོ་སྣང་ས་འོད་དེ་འབུམ་པ་དང་།",
    "སྣང་སའི་ཡབ་ཡུམ་གཉིས་པོ་ཚུར་ལ་གསོན་ཡབ་ཡུམ་གཉིས་ཀྱི་བུ་མོ་སྣང་ས་འདི།",
    "མཐོ་བ་ནམ་མཁར་འཕུར་སོང་ཟེར་ས་མེད།",
    "དམའ་བ་ས་ལ་འཛུལ་སོང་ཟེར་ས་མེད།",
    "བུ་མོ་སྣང་སས་མི་འགྲོ་ཟེར་ས་མེད།",
    "ད་ནི་རི་ནང་རྒྱལ་པོའི་བཙུན་མོ་ཡིན།",
    "ཁྲོམ་ཚོགས་ནང་ནས་མཛེས་མ་ཁྱོད་མཐོང་སྟེ།",
    "གཙུག་གཡུ་མདའ་དར་སྣང་ས་རང་གིས་བླངས་ཏེ་དཔོན་པོའི་ཕྱག་ཏུ་ཕུལ་མ་ཐག་སླར་ཡང་སྣང་སའི་གཙུག་ཏུ་བཀོད་དེ་རི་ནང་པའི་དཔོན་གཡོག་གཉིས་ཕྱིར་ལོག་གོ།",
    "དེའི་ཚེ་བུ་མོ་སྣང་ས་འཇིག་རྟེན་གྱི་བག་མར་འགྲོ་འདོད་མེད་ཅིང་།",
    "བུ་མོ་སྣང་སའི་ཕྱོགས་ལ་ཚུར་གསོན་དང་།",
    "མི་ཡི་བུ་མོ་ལྷ་ཡི་མཚར་སྡུག་ཅན།",
    "རི་ནང་དཔོན་པོའི་ཇོ་མོར་འགྲོ་རོགས་མཛོད།",
    "ཅེས་ཡབ་ཡུམ་གཉིས་ནས་བཀའ་ནན་ཆེ་བར་མཛད་སྟབས་རེ་ཞིག་ཡབ་ཡུམ་གཉིས་ཀྱི་གསུངས་ནན་མ་ལྡོག་པར་མྱང་སྟོད་རི་ནང་པའི་ཁྱིམ་ཐབ་བྱེད་པ་ཞལ་གྱིས་བཞེས་པ་ན།",
    "བུ་བརྒྱ་ལས་ལྷག་པའི་བུ་མོ་སྣང་ས་མ།",
    "གཡུ་ཡི་སྒྲོལ་མ་གསུང་བྱོན་གཙོ་བྱས་པའི་སྐུ་གསུང་ཐུགས་རྟེན་བུ་མོ་ཁྱོད་ལ་སྟེར།",
    "གོས་ཀྱི་རིགས་རྣམས་བུ་མོའི་ནོར་སྐལ་ཡིན།",
    "འཛོམས་པ་སྐྱིད་སོགས་གཡོག་མོ་འདི་ད་ག་ཀྱང་།",
    "སྣང་ས་མི་སྒོ་འགྲིམ་པའི་གཡོག་མོར་གཏོང་།",
    "གདང་གི་བྱ་ཕོ་འདི་ལ་དཔེ་ལོང་ལས།",
    "ཞོགས་པ་ལངས་པའི་སྔ་མ་བུ་མོས་མཛོད།",
    "སྒོ་རྒྱུབ་ཁྱི་མོ་འདི་ལ་དཔེ་ལོང་ལས།",
    "དགོང་མོ་ཉལ་བའི་རྗེས་མ་བུ་མོས་མཛོད།",
    "འཁོར་དུ་བསྡུས་པའི་ཕྱག་ཕྱི་ཕོ་མོ་ལ།",
    "ཕ་མ་རྒན་རྒོན་བུ་མོ་སྣང་ས་བཅས།",
    "དེ་ནས་དཔོན་མོ་སྣང་ས་འོད་འབུམ་དེ་མྱང་སྟོད་རི་ནང་པའི་ཁྱིམ་དུ་འབྱོར་ནས་ལོ་ངོ་བདུན་ཙམ་སོང་བ་ན།",
    "ལྷག་པར་དཔོན་མོ་སྣང་ས་དེ་ནི་བུད་མེད་ཀྱི་སྐྱོན་ལྔ་སྤངས་ཤིང་།",
    "ནང་འཁོར་གྱི་གཡོག་ཕོ་མོ་དང་།",
    "མངའ་འབངས་མི་སེར་ཐམས་ཅད་ལའང་ཉེ་རིང་མེད་པའི་བྱམས་གཟིགས་སྐྱོང་བརྡར་མཛད་མཁས་པ།",
    "ཞིང་ལས་དང་སྣམ་ལས་བཟའ་བཏུང་གི་གཡོས་སྦྱོར་སོགས་ལའང་ལག་འབྲས་གཙང་ཞིང་།",
    "ལས་ཆོད་ཆེ་བ་བཅས་ལ་བརྟེན་ཏེ་རི་ནང་གི་དཔོན་གཡོག་བྱིངས་ཚང་མ་ནི་མཆོག་ཏུ་མོས་ཤིང་ལྷག་དོན་དཔོན་མོ་སྣང་ས་བུ་སྐྱེས་ཀྱི་ཨ་མ་ཡིན་པ་ཙམ་མ་ཟད།",
    "སྐུའི་སྐྱེ་འབྲས་མཚར་བ་ལ་བརྟེན་ནས་དཔོན་པོ་སྒྲ་ཆེན་པ་ཡབ་སྲས་གཉིས་ནི་དཔོན་མོ་སྣང་ས་དང་ཆུ་ཚོད་ཙམ་ཡང་འབྲལ་མི་ཕོད་པ་ལྟ་བུའི་བརྩེ་གདུང་ཆེ་བ་མཛད་ནས་བང་མཛོད་ཀྱི་ལྡེ་མིག་ཐམས་ཅད་སྣང་ས་ལ་སྤྲད་དེ་ཐུགས་བློས་འགེལ་རྩིས་མཛད་ཀྱང་།",
    "སྣང་ས་ལ་ཚང་མས་མི་ཁ་བྱམས་པར་བྱས་གཤིས་འཇིག་རྟེན་གྱི་གཏམ་དཔེར་ཆགས་སྡང་འདྲ་མཉམ་བུ་མོས་བྱེད།",
    "དཔོན་མོ་སྣང་སའི་བར་དུ་སེལ་འཇུག་དཀྲུག་ཤིང་གིས་ཞུ་ལོག་སྣ་ཚོགས་དང་།",
    "ཀྱེ་མ་ཀྱེ་ཧུད་བུ་མོ་སེམས་པ་སྐྱོ།",
    "མཛེས་པའི་གཟུགས་དང་བརྩེ་བའི་བུ་ཁྱོད་དང་།",
    "དཔོན་གྲགས་པ་བསམ་གྲུབ་ཀྱང་མེ་ཏོག་ལྡུམ་རྭར་བྱོན་ཏེ་དབུ་སྐྲ་བཀྲུས་ནས་སྣང་སའི་སྐུ་པང་དུ་དཔོན་པོའི་དབུ་བཞག་སྟེ་ཤིག་དང་སྲོ་མ་རྣམས་སྒྲུག་གི་ཡོད་པའི་དུས་སུ་ནམ་ཟླ་སྟོན་ཁར་སླེབས་པའི་མེ་ཏོག་རྙིང་པ་རྣམས་བ་མོས་བརྡུངས།",
    "གསར་པ་རེ་གཉིས་ཡོད་པ་རྣམས་ལ་གསེར་སྦྲང་དང་གཡུ་སྦྲང་ཟིར་དིར་དིར་འཁོར་གྱི་འདུག་པའི་རྐྱེན་བྱས་སྣང་སའི་ཐུགས་ལ་ཚེ་འདིར་དགོས་པའི་ཕ་མ་གཉིས་དང་ནི་མ་ཤི་གསོན་བྲལ་བྱུང་།",
    "དཔོན་མོ་སྣང་ས་ལན་གཅིག་བདག་ལ་གསོན།",
    "རི་ནང་དཔོན་པོའི་ཇོ་མོ་བྱེད་བཞིན་དུ།",
    "སྣང་སའི་འདོད་པ་བདག་གིས་བསྒྲུབ་པར་བྱ།",
    "ད་རེས་ཚུར་བཀའ་འདྲི་ཕེབས་དུས་ཟུར་ཙམ་ཞིག་ཞུ་ཐུབ་ན་རབ་ཏུ་ང་རང་གི་འདོད་པ་ལྟར་དམ་པའི་ལྷ་ཚོས་ལ་འགྲོ་བའི་དགོངས་པ་དགའ་མོ་གནང་ཨེ་ཡོང་།",
    "བུ་མོ་ཕ་མའི་དྲུང་དུ་སྡོད་པའི་དུས།",
    "སྣང་ས་རང་གི་ཡུལ་དུ་སྡོད་པའི་སྐབས།",
    "རི་ནང་དཔོན་པོའི་ཇོ་མོར་སླེབས་ནས་ཀྱང་།",
    "ཁ་རོག་བསྡད་ན་བུ་མོ་གླེན་མ་ཟེར།",
    "གཏམ་ལན་བྱས་ན་བུ་མོའི་ཕེར་ཤ་ཟེར།",
    "ཕྱི་ལ་ཕྱིན་ན་མགོ་ཡངས་འཆལ་མོ་ཟེར།",
    "གཡོག་པོ་གཡོག་མོའི་ཕྱོགས་ལ་བལྟས་ཙ་ན།",
    "རི་ནང་དཔོན་པོའི་ཇོ་མོ་བྱས་ན་བསམ།",
    "བུ་མོ་ཕ་མ་དྲན་པའི་སྐྱོ་གླུ་འདི།",
    "ལས་རྒྱབ་བྱེད་པར་ཡོང་སྟེ་ཚང་མ་བཙས་མ་རྔ་བའི་དུས་སུ་ལ་སྟོད་དིང་རིའི་ཕྱོགས་ནས་ཕེབས་པའི་རས་པ་བླ་སློབ་གཉིས་བཙས་མ་བརྡ་སར་བྱོན་ཏེ་སྣང་སའི་ཕྱོགས་ལ་ཞལ་གཟིགས་ནས་མགུར་འདི་གསུངས་སོ།",
    "ནུབ་རྒྱ་མཚོའི་ནང་གི་ཀླུ་མོ་འདྲ།",
    "བྱང་གཡུ་འབྲུག་སྔོན་མོའི་སྐད་དང་འདྲ།",
    "ཕར་ཚད་ཕར་ན་བཞུགས་པའི་ཨ་ལྕེ་ན་བཟའ་སྨུག་འཁྲིག་འཁྲིག་ཞལ་རས་སྣུམ་འཚིར་འཚིར་ཕ་གི་ལ་ཞུས་ཤོག་ཅེས་སྣང་སས་ཕྱག་མཛུབ་བཙུགས་ནས་བསྟན་པ་དང་།",
    "ནམ་ཞག་རྒྱུན་དུ་རྫུན་དང་ཁྲམ་དང་གཡོ་སྒྱུ་ཁོ་ན་ལ་མི་ཚེ་སྐྱེལ་བའི་ཟོག་སྟོང་རས་པ་ཁྱོད་ཚོའི་སྣ་ལེན་ངས་མི་ཤེས།",
    "གསུང་ངག་འཇོལ་མོ་ལས་སྙན་པ།",
    "ང་ཚོ་མྱང་སྟོད་རི་ནང་པའི་དཔོན་མོ་སྣང་ས་འོད་འབུམ་བྱ་བ་དེ་ཕ་གི་ཡིན་པས་དེ་ལ་ཞུས།",
    "ཡང་གཅིག་གསོན་དང་དཔོན་མོ་སྣང་ས་ལགས།",
    "ལག་ན་དབྱུག་པ་ཞིག་ཁྱེར་ནས་དཔོན་མོ་སྣང་སའི་མདུན་དུ་ཡོང་སྟེ་མིག་འབུར་ཚུགས་སུ་བལྟ་བ་དང་ལྷན་ཅིག་གླུ་འདི་བླངས་སོ།",
    "ནང་དུ་བསམ་ངན་དུག་གིས་ཟས་ལ་སྤྱོད།",
    "བུ་སྐྱེས་ཨ་མ་བྱས་ནས་དགོས་པ་ཆུང་།",
    "མྱང་སྟོད་རི་ནང་ཤོང་ཞིང་རིང་མོ་འདི།",
    "སྤྲང་མོ་ཁྱོད་ཀྱང་མ་སྡོད་མཉམ་དུ་སོང་།",
    "བདུད་མོ་མ་གསུངས་རྗེས་སུ་ཡི་རང་མཛོད།",
    "ཁྱོད་པང་དུ་བུ་དང་རྒྱུབ་ཏུ་ཕ་མིང་ཡོད་བསམ་པའི་ལྟག་ཤེད་ཀྱིས་ཕར་ལ་གཅིག་ལབ་ན་ཚུར་ལ་གཉིས་ལན་སློག་གི་འདུག་སྟེ།",
    "ཁྱོད་མྱང་སྟོད་རི་ནང་པའི་མནའ་མ་ཡིན་པ་ལས་ལྷག་པ་ང་མྱང་སྟོད་རི་ནང་པའི་མི་ངོ་བུ་མོ་ངོ་མ་ཡིན་པས་མ་ཆོག་ཕྱི་ནང་ལས་ཀའི་འགན་ཚང་མ་འཁུར་གྱི་ཡོད་པ་ཁྱོད་ཀྱིས་ད་དུང་མ་ཤེས་སམ།",
    "སྣང་སའི་དབུ་སྐྱ་བཏོགས་པ་རྣམས་མོ་རང་གི་ལག་ཏུ་ཁྱེར་ནས་ངུ་བཞིན་དཀྲུག་ཤིང་གི་གླུ་འདི་བཏང་ངོ།",
    "སྙིད་མོ་ནེ་ཙོ་ང་ལ་ཚུར་གསོན་དང་།",
    "རང་རེའི་དཔོན་མོ་སྣང་ས་འོད་འབུམ་ནི།",
    "རང་རེའི་ཤོང་ཞིང་རིང་མོའི་སྟེང་དུ་འབྱོར།",
    "དཔོན་མོ་སྣང་ས་ཟེར་བ་ཁ་སྒོ་སྐྱེ་འབྲས་ལེགས་པའི་ཐོག་ཏུ་བུ་སྐྱེས་ཀྱི་ཨ་མ་ཡིན་པ་ལ་བསམས་ནས་ངེད་རི་ནང་དཔོན་གཡོག་ཚང་མས་དགའ་བའི་འཛུམ་གྱིས་བསུས།",
    "ལན་གཅིག་ཚུར་ལ་ཉོན་དང་བདུད་མོ་སྣང་ས་འོད་འབུམ།",
    "མ་བཅོལ་ཟོག་སྟོང་རས་པར་སྣེ་ལེན་བྱས་པས་མི་ཆོག་ད་དུང་ང་ཡི་ནུ་མོར་བརྡུང་ཐག་བཏང་བ་གང་ཡིན།",
    "སྤྲང་ཁྱི་ཐོག་ཁར་བཏགས་པས་ནམ་མཁའི་སྐར་མར་སྨུག་གིས།",
    "བོང་བུ་ཆག་གིས་བསོས་པས་རྟ་ལ་ཕྲ་རྐང་གཏོང་གིས།",
    "ཆུ་ཉམས་མཉན་པས་ལོན་ནས་ཀོ་གྲུ་མཐིལ་རྡོལ་གཏོང་གིས།",
    "དཔོན་མོ་སྣང་སའི་ཐུགས་ལ་མདའ་བརྒྱབ་པས་མི་ཆོག་གཞུ་མཆོག་ངོམ་ཟེར་བའི་དཔེ་ལྟར།",
    "གཡོག་པོ་གཡོག་མོ་གཉིས་ལ་སྙན་གསོན་དང་།",
    "དཔོན་མོས་ཐུགས་དང་འགལ་བ་མཛད་སྲིད་ན།",
    "ཚེ་དང་གཏན་གྲོགས་བུ་སྐྱེས་ཨ་མ་ལ།",
    "རྨ་བཟོས་ཁྲག་གི་སྤྲིན་པས་གཡོགས་ནས་འདུག་མཛེས་པའི་སྐུ་ལུས་སྨྱུག་གསར་ལྡེམ་པ་དེ།",
    "སྤྱན་ཆབ་མ་བསིལ་དཔོན་མོ་སྣང་ས་ལགས།",
    "ཞེས་ཞུས་ཏེ་དཔོན་པོ་གྲགས་པ་བསམ་གྲུབ་དང་དཔོན་མོ་སྣང་ས་གཉིས་སོ་སོའི་གཟིམ་ཆུང་ལ་སྤྱན་དྲངས་སོ།",
    "མྱང་སྟོད་རི་ནང་པའི་དཔོན་མོ་སྣང་ས་འོད་འབུམ་དེ་རིགས་བཟང་གི་མཁའ་འགྲོ་མ་ཡིན་པ་དང་།",
    "སྐད་སྙན་པ་སྤྲེལ་རྩེད་ལ་མཁས་པ་གཅིག་ཏུ་སྤྲུལ་ཏེ་ཨ་ལྕེ་སྣང་སའི་གཟིམ་ཆུང་གི་རབ་གསལ་ཁ་འོག་ཏུ་བྱོན་ནས་སྤྲེའུ་དེར་རྩེད་མོ་སྣ་ཚོགས་བྱེད་བཅུག་པ་དང་ལྷན་ཅིག་སྤྲང་པོ་དེས་ཀླུ་འདི་བླངས་སོ།",
    "རབ་གསལ་ནང་ན་བཞུགས་པའི་དཔོན་མོ་ལགས།",
    "མ་ཡེངས་སྤྱན་ནི་སྤྲེལ་རྩེད་འདི་ལ་གཟིགས།",
    "སྤྲེའུ་ཨ་མ་རེ་ལ་སྤྲེལ་ཕྲུག་རེ།",
    "སྐེ་ལ་ཐག་པ་གཡོགས་དུས་འོ་རེ་བརྒྱལ།",
    "རྩེད་མོ་བསླབ་ཕྱིར་སྡུག་ལས་སྣ་ཚོགས་གཏོང་།",
    "བྱ་མོ་ཨ་མ་རེ་ལ་བྱ་ཕྲུག་རེ།",
    "རྐང་པར་ལྕགས་སྒྲོག་རྒྱག་དུས་འོ་རེ་བརྒྱལ།",
    "གསེར་སྦྲང་ཨ་མ་རེ་ལ་སྦྲང་བུ་རེ།",
    "མཛུབ་མོས་ཕུར་མཉེད་གཏོང་དུས་འོ་རེ་བརྒྱལ།",
    "ལུག་མོ་ཨ་མ་རེ་ལ་ལུ་གུ་རེ།",
    "གཡང་དཀར་ལུ་གུ་སྤང་གི་རྩི་བཅུད་ཟ།",
    "ཁོག་ལག་བཏང་སྟེ་གསོད་དུས་འོ་རེ་བརྒྱལ།",
    "དབུས་ཕྱོགས་མྱང་སྟོད་གསེར་གཞུང་རིང་མོ་ན།",
    "དམན་ཤར་ཨ་མ་རེ་ལ་བུ་མོ་རེ།",
    "བུ་མོ་མཛེས་མ་དཔོན་པོའི་བག་མར་སླེབས།",
    "བུ་མོ་ཁ་འབྲས་མཚར་བས་ལན་པ་ཡིན།",
    "གསུང་སྐད་སྙན་ཡང་ལྕང་གླིང་འཇོལ་མོ་འདྲ།"
  ]
}