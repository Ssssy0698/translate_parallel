    "གཅན་གཟན་གདུག་པརྣམས་དང་ལྷན་ཅིག་འདུགཔ་བླའི།",
    "དེ་འདུ་འཛི་ལ་མི་དགའབས་དུ་རུ་ཞེས་པའི་གླིང་ལྷོ་ཕྱོགས་ཀྱི་རྒྱ་མཚོའི་ནང་ན་འདུག་པའི་དབེན་པ་ལ་གནས་ནས་དཀའ་ཐུབ་དངབརྟུལ་ཞུགས་ལ་གནསས།",
    "ཡིདལ་བྱ་བའི་མན་ངག་བསྟན་པ་བཞིན་དུ་བསམ་གཏན་བྱེད་ཅིང་འདུག་གོ།",
    "འདི་འདིའི་ཆུང་མ་ཡིན་འདུག་ཀྱང་འཕྲོག་པར་བརྩམ་སྟེ།",
    "ཚབསྒོ་དེར་མཚོན་ཆ་ཐོགས་པའི་སྐྱེ་བོའི་ཚོགས་སྡོདཔ་དེ་ནས་ནང་དུ་ནང་བདུན་མི་དང་བྲམ་ཟེད་པོ་རྣམས་གོ་རིམ་བཞིན་སྤྱོད་ཅིང་རྒྱལ་པོ་ནི་ནང་དུ་སེངྒེའི་ཁྲིལ་འདུག་གོ།",
    "མཁསཔརྣམས་ཀྱང་རང་གར་ཅི་བདེ་བར་སྤྱོད་རིགས་ལ།",
    "རྒྱལ་པོའི་སྟན་ལ་འདུག་ན་གཟི་བརྗིད་དང་མཐུ་ཆེ་བ་དང་།",
    "དེ་ནས་དོང་བ་ལས་གནས་གཞན་ཞིག་ན་ཤིངཤ་ཀོ་ཏ་ཀ་ཇེལ་བྱ་རོག་ཅིག་འདུག་པ་དེས་དབྱུག་པ་ཅནཱམཐོང་ནས་གར་འགྲོ་དྲིས་པ་དང་།",
    "གནས་འདི་ཞེས་བགྱི་བ་ན་ཤི་ངཤ་ཀོ་ཏ་ཀ་དེ་ལ་བྱ་རོག་ཅིག་འདུག་པ་དེས་བདག་ཤིང་གཞན་གྱི་སྟེང་དུ་འདུག་ཚེ་སྐདམིསྙནལ།",
    "གྱོས་ཕོའི་ཁྱིམ་དའདུག་པའི་ཚོད་ལ་ཆགས་ནས་ཕ་མའི་ཁྱིམ་དུ་འགྲོ་འདོདལ།",
    "བདག་སྐྱེས་ནས་མཐོང་ཐོས་མ་མྱོང་བའི་ཀླན་ཀ་ཞིག་འཚོལ་ལོ་སྙམ་དུ་འདུག་པ་དང་།",
    "སང་སྟེ་བརྟགས་ནས་སྐྱེས་བུ་ཞིག་འདུག་པ་ཆེ་བ་ས་ལ་འགྲེ་ཞིང་དུ་བ་དང་།",
    "མི་གཅིག་སྟེང་དུ་ཞོན་ཏེ་འདུག་གོ།",
    "ཤིང་ཨུ་དུམ་བཱ་ར་སྨིན་པ་ཞིག་མཐོང་ནས་གཟུགས་ངན་དེལའཛེགས་ཏེ་ཟ་ཞིང་འདུག་པ་དང་།",
    "དེ་བྱུ་བས་གཟིར་ནས་ནན་གྱིས་ཤིང་དེ་ལ་འཛོགསནས་ཟ་ཞིང་འདུག་པ་དང་།",
    "ཉིམ་ལ་བལྟར་མི་བཟོད་པ་ལྟར་བྲམ་ཟེ་འདུག་འདུག་ཅིང་བསམ་བཞིན་དུ།",
    "དེ་ནས་དུས་གཞན་ཞིག་རྒྱལ་པོ་ཕྱོགས་བདག་དུས་ལས་འདས་ཏེ་བློན་པོ་སོགས་ཀྱིས་གཞོན་ན་རྡུལ་ཕྲནརྒྱཡསྲིདལྗབཞག་པས་རྒྱལ་པོ་རྡུལ་ཕྲན་ཞེས་པའི་མིང་འཐོབ་བོ།",
    "དེ་ནས་བྲམ་ཟེ་དེས་རྒྱལ་རིགས་ཀྱི་བུ་ཚེསནང་ཡངས་ལ་ཕྱི་ཤིང་རྟའི་དབྱིབས་ལྟར་འདུག་པའདི་ཆ་བདུན་དུ་འགེད་པ་སུ་ཞིག་ཡོད་ཟེར་ན།",
    "མཉན་ཡོནན་བྲམ་ཟེ་མདུན་ན་འདོན་ཞིག་འདུག་པའི་གན་དུ་དོང་བལ།",
    "ལམ་ཉམས་རྣམས་ནི་ངེས་པར་དོན་མིན་འགྲོ།",
    "ལྷ་འདི་ནི་མ་བཟུང་ཡང་རང་ཉིད་འོངས་པ་ལགས་སོ།",
    "དེནས་རྒྱལ་པོའི་འབྱོར་པ་ཆེན་པོས་རི་དྭགས་ཀྱི་དཔོན་པོ་གཟུགས་ཤིན་ཏུ་སྡུག་པ་དེསེང་གེའི་བྲེལ་འདུག་ཏུ་བཅུག་ནས།",
    "སོགས་དང་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་བར་ལ་སེམས་ཤིང་འདུག་པ་ལ།",
    "རྒྱལ་པོ་དགུ་བཅུ་རྩ་དགུ་པོས་དེའི་རྐང་པ་ལ་ཕྱག་བྱས་ནས་འཁོར་དུའདུག་གོ།",
    "དེ་ཡང་རང་སྟོབས་རྙེད་ནས་ཇེ་བརྟན་དུ་འགྲོ་ཞིང་ས་ཐོབ་ཕན་ཆད་སེམས་བསྐྱེད་པ་དེ་ཚེ་རབས་ཐམསཅད་དུ་ཉམས་པ་མེད་པར་མངོན་དུ་འགྱུར་རོ།",
    "དེ་དག་འགྲེད་པ་འདུག་གམ་འཆག་པ་དེར་དེ་བཞིན་གཤེགས་པའི་ཕྱིར་མཆོདརྟེན་བརྩིག་གོ།",
    "དེནས་ཁྱེའུ་དེས་ཕྱོགས་ཕྱི་དོར་མ་བྱས་པ་ཞིགཏུ་འདུག་ནས་ཅང་མི་སྨྲ་བར་གྱུར་ཅིང་ཉིནགཅིག་བན་ཡང་མ་ཟོས་སོ།",
    "ཁྱིམ་འདིར་འདུགལ་སྦྱིན་པ་དག་ཀྱང་བྱིན་ཅིག།",
    "འགྲོ་བ་འདི་ཡང་རང་བཞིན་མེད།",
    "དོན་ལ་གནམ་ས་ལྟར་ཆོད་པའི་གོ་དོན་ཆེ་ཆུང་ཡོད་པ་འདུག་པས།",
    "སྟག་ལྤགས་ཀྱི་ཤམ་ཐབས་དང་མི་ལྤགས་ཀྱི་གཡང་གཞི་གསོལ་བ་སྐྱིལ་ཀྲུང་ཕྱེད་པའི་འདུག་སྟངས་ཀྱིས་བཞུགས་པའི་མདུན་གྱི་འོག་རོལ་དུ་མ་མཐིང་ནག་འཕྲོ་འདུ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "འདུག་པའི་ལོང་མེད་དགྲ་བོའི་གཤེད་དུ་རིངས།",
    "དང་པོར་འདུག་ལ་དྲང་པོར་ལྟོས།",
    "རང་ལ་ཐིམ་ཞིང་རང་ཉིད་ཀྱང་།",
    "རང་རང་གནས་སུ་ད་གཤེགས་ཤིག།",
    "འོ་དེ་ཡང་ཁྱེད་རང་རྣམས་ཕ་རོལ་བན་བོན་སྔགས་པས་བྱད་དུ་བཅུག་པ་འདིར་འགྲོལ་བར་བྱེད་པ་སྐབས་སུ་བབས་པས།",
    "ཁྱེད་རང་ལ་གནོད་པར་བྱེད་པའི་བྱད་མ་རྦོད་གཏོང་དང་བཅས་པ་ཐམས་ཅད།",
    "དེ་ལྟ་བུའི་རྗེ་བཙུན་མ་ཡང་རང་རིག་ལས་ལོགས་སུ་མེད་པར་ཐག་གཅོད་པའི་ང་རྒྱལ།",
    "ཐུགས་ཀར་སླེབས་རྗེ་བཙུན་མའི་ཐུགས་སྲོག་དང་རང་རིག་དབྱེར་མེད་དུ་འདྲེས་པར་བསམ།",
    "འོད་ཀྱི་ཁང་པ་དངོས་ལ་འདུག་པ་དང་།",
    "ཕྱི་ལ་ཡང་སྐྱོན་རྩ་བ་ནས་མ་བྱུང་བ་འདུག་ཉེ་སྐོར་གྱི་ཡོ་བྱད་ཆུང་བ་རྣམས་ནས་ཁ་ཤས་ཕན་ཚུན་དུ་འཕངས་པ་རྣམས་དང་།",
    "རྡོ་ཐམས་ཅད་ཚ་ཆིལ་ལི་བ་འདུག།",
    "དེ་རྐྱེན་གྱིས་ཡས་མས་བར་གསུམ་དུ་གཏམ་ཆ་སྣ་ཚོགས་ཀྱིས་ཁྱབ་འདུག་པ་དང་།",
    "ངེས་འདྲོངས་པོ་ཡིན་འདུག་གསུང་།",
    "སྣང་སྲིད་མཁའ་འགྲོའི་སྤྲིན་གྱིས་ཁྱབ་འདུག་ཀྱང་།",
    "འདོད་ལྡན་སྐྱེ་བོ་ཐམས་ཅད་ཕོངས་ནས་འདུག།",
    "འབྲི་བྲང་ཐང་དུ་སླེབས་ནས་ཀྱང་ཉི་མ་རྒྱང་ཙམ་བསྡད་འདུག་པས་ཟླ་གྲོགས་སོགས་དེར་འདུས་ཚང་མ་ཉི་མ་གཉིས་ཀྱི་ཡུན་ཚད་བྱུང་ཞེས་མགྲིན་གཅིག་ཏུ་གླེང་སྟེ་ལྷ་གཅིག་འདི་ཉིད་ཀྱི་རྫུ་འཕྲུལ་དུ་ངེས་སོ།",
    "ཟག་མེད་ཕུག་པ་སོགས་འདུག་པ་མཇལ་དེར་བྲམ་ཟང་ཆེན་པོ་ཞིག་འདུག་པ་དེའི་དབུས་སུ་ཕ་བོང་ཐོག་ཚད་གསུམ་པ་ཁ་དོག་དམར་སེར་སྲུབས་མེད་འཇིགས་ཟིལ་ཤིན་ཏུ་ཆེ་བ།",
    "ཉེ་ལོགས་སུ་གཙང་པོ་རྦ་ཀློང་དྲག་ཏུ་འཁྲུག་ཅིང་ས་གཡོ་བ་ཙམ་གྱི་འུར་སྒྲ་འབྱིན་པ་འདུག།",
    "གཞན་དུ་ལུས་ཀྱིས་གཡོ་འགུལ་ཙམ་ཡང་བྱེད་མི་ཐུབ་པའི་ཚོད་དུ་སྣང་བས་སྒོ་ཁྲིར་འདེགས་པ་ལྟ་བུར་བྱས་ན་མ་གཏོགས་བགྲོད་ཐབས་མི་འདུག་རུང་།",
    "དེ་ནས་མར་ལྷུངས་ན་གཡང་རོང་ཐོག་ཚད་བདུན་ཙམ་གྱི་གཤམ་དུ་ཆུ་བོ་རྦ་ཀློང་དྲག་ཏུ་འཁྲུག་པས་རོ་ཙམ་ཡང་རྙེད་པ་མི་འདུག་ཟེར།",
    "ཚུར་ལྡོག་དུས་སྨྱུག་ལའི་གྱེན་དེ་གཅིག་པུར་ཡང་འགྲོ་རྒྱུ་བསམ་ལས་འདས་ནས་མི་འདུག་གོ།",
    "སྐྲ་རྦད་མགོ་དཔུང་པར་ཉིལ་བ་ཡུལ་དེ་ན་ཕྱུག་པར་གྲགས་པ་ཞིག་འདུག་པ་དེས་བསུ་བ་བགྱིས།",
    "པདྨོ་བཀོད་ནས་ཕྱིར་ལྡོག་དུས་ཟླ་གྲོགས་གཞན་རྣམས་རྗེས་ལ་བཞག།",
    "དེ་ནུབ་རིགས་ལྡན་མ་པདྨ་རོལ་མཚོ་རྗེས་མའི་གྲས་ཀྱི་ཟླ་གྲོགས་བྱིངས་དང་མཉམ་དུ་སྐུ་དཀར་དུ་སླེབས་པའི་རྨི་ལམ་དུ་ད་ཅིའི་འབྲུག་དང་གློག་སོགས་འཚུབ་ཉམས་དེ་རྡོ་རྗེ་ལེགས་པའི་འཁྲེན་ཆ་ཡིན་པས་སྐྱོན་མེད་ཅེས་ཟེར་བ་རྨིས་འདུག།",
    "སྨུག་དིང་ངེ་བ་ཞིག་འདུག་པར།",
    "སང་རང་དུས་སྟོན་ལ་རྡོ་རྗེ་སྐྱབས་བྱེད་ལགས་ཕེབས་མི་ཐུབ་པ་འདྲ།",
    "དུས་སྟོན་གྲོལ་ནས་དེ་ཉིན་རང་ལྷ་གཅིག་ཁོག་ཏུ་ཕེབས་པའི་ཐོག་གཏང་རག་འབུལ་དགོས་རྒྱུ་ཡིན་འདུག་ཀྱང་གཡེང་བས་འགྱངས་པས་ཉིན་གཉིས་པའི་ཐོག་ནས་གསོལ་འོ་སྐྲངས་ཏེ་སྙན་ཟུག་ཤིན་ཏུ་ཆེ་བ་དང་།",
    "རྒྱུད་མ་རུངས་པ་ནག་ཕྱོགས་ལ་དགའ་ཞིང་སྐྱེ་འགྲོའི་སྲོག་ལ་རྒོལ་བ་ཞིག་ཡིན་འདུག་པ།",
    "རང་རང་ལ་གང་ཤར་གྱི་སྣང་བ་དེ་ཕྱི་རོལ་ན་སྣང་ཡང་ནང་ན་མཆིས་ཏེ།",
    "རང་ལ་གྲོགས་ཐམས་ཅད་མི་དགའ་བ་འདུག་སྙམ་པ་དང་།",
    "ད་ངས་སྐུ་ཞབས་ཀྱིས་དབུས་པའི་མཆེད་ལྕམ་རྣམས་ལ་བཤགས་པ་འབུལ་དགོས་འདུག།",
    "གསུམ་པ་ཤིན་ཏུ་འཇམ་པར་འདུག་གསུངས།",
    "ཚུལ་བསྟན་དུ་སྤྱན་གཡས་ཕྱོགས་ཀྱི་འཁྲུངས་ལྷའི་འཚུབ་ཡིན་པར་དགོངས་ནས་དེའི་གསོལ་ཁར་ངོས་ཕེབས་གནང་ན་ཁྱད་ཨེ་ཡོང་དགོངས་པ་འདུག་ཅེས་ཕེབས་པ་བཞིན་འཕྲལ་དུ་སྤྱན་གཡས་སུ་བསྐྱོད།",
    "ཟླ་བཅུ་གཅིག་པར་དགོན་སྨད་རྒྱབ་ཀྱི་སྐུ་ལྷའི་དུས་གསོལ་འགྱངས་ན་ཞབས་ཀྱི་མཐེའུ་ཆུང་བསྣུན་པས་སྤྱན་གཡས་ནས་གསོལ་ཁ་འགྱངས་མིན་ཕྱོགས་གང་དུ་བཞུགས་ཀྱང་མཁྱེན་པ་ཞིག་འདུག།",
    "དེ་ནས་བཟུང་ད་ལྟའི་བར་དུ་སྐུ་བདེ་མིན་སྣ་ཚོགས་པས་གདེངས་ཁེལ་རྒྱུ་ཆེར་མེད་པ་ཞིག་འདུག་ནའང་རྫུ་འཕྲུལ་མི་སྲིད་པ་ཞིག་ཏུ་སེམས་ཏེ།",
    "དེ་ལས་ལྡོག་དུས་བདེ་བ་སོགས་མཐའ་གཅིག་དུ་རྟོགས་པར་དཀའ་བ་དང་།",
    "དཔེར་མཚོན་ན་རང་ཉིད་འདུག་པའི་ཁྲིས་ས་གཞི་ལས་འཕགས་པར་བྱེད་ཅིང་གཡོ་བ་མེད་པར་ལུས་བརྟེན་པའི་ཟུངས་སམ་གནས་བྱེད་པ་བཞིན་དུ་འབྲལ་མེད་དུ་མཛོད་ཅིག་པའི་ཐུགས་དམ་བསྐུལ་བའོ།",
    "ཁྱེད་རྣམས་རང་རང་གནས་ལ་གཤེགས།",
    "གླུ་ཆུང་ར་ཙ་ན་ཡི་གདངས།",
    "མཐུ་བྱད་རྦོད་གཏོང་རང་གཤེད་རང་ལ་ཕོབ།",
    "འོན་ཀྱང་རང་གསལ་སྣང་སྟོང་མ་འགགས་གཞིར།",
    "རང་རང་རྣམ་འགྱུར་ཤིན་ཏུ་གསལ།",
    "གསར་རྩོམ་གྱི་རང་སྟོབས་ལྷན་སྐྱེས་ཀྱི་རྣམ་རིག་དང་རང་སྣང་ཡིད་འཆར་གྱི་དབྱེ་བ་རྣམ་པར་འབྱེད་པ།",
    "སྒྱུ་རྩལ་སྣང་བརྙན་གྱིས་མཚོན་བྱའི་ཡུལ་གྱི་རང་མཚན་བྱེ་བྲག་པའི་རྣམ་པ་དངོས་རྣམས་མངོན་སུམ་ཇི་བཞིན་དུ་འཛིན་ཞིང་རང་སོར་འཇོག་གོ།",
    "རྩོམ་རིག་བསྟན་བཅོས་གང་མང་ལ་བལྟས་ཙ་ན་ངོ་མཚར་ཞིང་དགོད་བྲོ་བ་དང་གནས་ལུགས་ལ་མ་ངེས་ཀྱང་ངོ་མཚར་བའི་སྣང་བ་སྐྱེད་པ།",
    "རྩོམ་པ་པོ་རང་ཉིད་ཀྱང་རང་།",
    "གསར་རྩོམ་གྱི་རང་སྟོབས་ལྷན་སྐྱེས་ཀྱི་རྣམ་རིག་དང་རང་སྣང་ཡིད་འཆར་གྱི་དབྱེ་བ་རྣམ་པར་འབྱེད་པ།",
    "དོན་དངོས་ལ་སེམས་གཙོ་རིང་ལུགས་པ་གྲུང་པོ་དེ་དངོས་གཙོ་རིང་ལུགས་རྟུལ་པོ་ལས་དངོས་གཙོ་རིང་ལུགས་གྲུང་པོ་དང་ལྷག་པར་ཉེ་བར་འདུག་ཅེས་ལེ་ཉིན་གྱིས་མཚན་ཉིད་རིག་པའི་ཟིན་ཐོ་ཞེས་པར་གསུངས་སོ།",
    "སེམས་གཙོ་རིང་ལུགས་ཀྱི་རང་ཉིད་ངོམ་པའི་རྩོམ་རིག་སྒྱུ་རྩལ་གྱི་བསམ་པའི་དར་རྒྱུན་ལ་དགག་པ་རྒྱག་དུས་དེའི་སེམས་གཙོ་རིང་ལུགས་ཀྱི་བསམ་པའི་འགྲོ་སྲོལ་རྣམ་པར་སྤངས་ཏེ་གནས་ལུགས་དང་མཐུན་པའི་ས་ལེགས་ཆ་རྣམས་ལེན་དགོས།",
    "ངས་རང་ལ་བརྟགས་ན་མི་གཞན་ལ་རྟོག་པ་ནང་བཞིན་རང་ལུས་རང་འདོམ་གང་པོ་འདིར་འབྱུང་སྲིད་ཀྱི་འགལ་འདུ་དང་མི་མཐུན་པ་ཡོད་དོ་ཅོག་འདུས་འདུག་ལ་ལའི་བསམ་པར་ང་ནི་ང་རྒྱལ་ཆེ་བ་དང་འཆལ་ཡན་དང་ཨུ་ཚུགས་ཅན་དང་།",
    "ཡིད་སྙོམས་པར་གནས་ཤིང་རང་བག་ལྡན་པ་དང་འགྱུར་ལྡོག་ཆེ་ཞིང་མི་བརྟན་པ།",
    "ཉེ་འཁོར་ཚང་མ་གླེན་བླུན་གྱི་མི་དང་བྱ་བས་སྐོར་འདུག་པས་སྣང་བ་སྟོང་ཞིང་སྐྱོ་ཡི་རྒྱ་རུ་གཅུན་ཞིང་མནན་པ།",
    "རྣམ་དཔྱོད་ཀྱི་རིག་པ་ཅན་གྱི་རྩོམ་པ་པོའམ་སྙན་ངག་པས་ལར་ཕྱིའི་འཇིག་རྟེན་གྱི་སྣང་ཚུལ་ནང་སེམས་ཀྱི་དཔེ་རུ་སྣང་ཞིང་ཕན་ཚུན་མཚམས་སྦྱོར་མཁས་ཤིང་མཛེས་སྡུག་དང་ཟབ་བརླིང་རང་བཞིན་གྱི་དམིགས་རྣམ་གསར་དུ་སྐྲུན་ཅིང་སྦྱོར་བ།",
    "བརྗོད་བྱའི་དོན་དང་མི་སྣའི་སྣང་བརྙན་གྱི་བཞེངས་སྐྲུན་ལ་རང་མཚན་བྱེ་བྲག་པའི་རྣམ་པའི་ཉམས་དང་རང་གཤིས་མངོན་སུམ་བཞིན་ཐོན་ཞིང་མི་སེམས་འགུགས་པའི་གསོན་ཉམས་ཀྱི་དཔལ་དང་ནུས་པ་ལྡན་པར་སྐྲུན་དགོས།",
    "མཛེས་རྟོག་རང་བཞིན་དང་ཆགས་སྡང་རང་བཞིན་གྱི་འབྲེལ་བ།",
    "མི་དང་རང་བྱུང་།",
    "ཆགས་སྡང་རང་བཞིན་བཅས་བར་གྱི་འབྲེལ་བ་ཅི་ཡིན།",
    "དེར་བརྟེན་རྩོམ་རིག་ལ་སྟབས་བདེ་དང་སྟབས་བདེ་མ་ཡིན་པའི་དཀའ་ཚེགས་ཀྱང་ཆེ་བར་འདུག་ཉེ་གོར་གྱིས་མཛད་པའི་མཛེས་རྩལ་རིག་པ་ཞེས་པར།",
    "ཕྱི་མ་དེ་དར་ཆེ་བར་འདུག་སྤྱིར་བརྗོད་སྟངས་འདི་ལ་བརྟེན་ནས་རྩོམ་འབྲི་མཁན་ཉུང་ཤས་ཡིན།",
    "ཉམས་དང་འགྱུར་བ་དང་རང་གཤིས་ཀྱི་ངང་ཚུལ་སོགས་གསར་སྐྲུན་བྱེད་མི་ནུས་སོ།",
    "དེར་བརྟེན་རྩོམ་རིག་བསྟན་བཅོས་ཀྱི་བརྗོད་བྱའི་ནང་དོན་ནི་ལྟོས་མེད་ཀྱི་འདུ་ཤེས་སམ་ཕྱི་རོལ་ཡུལ་གྱི་བསམ་བློ་ཞེས་པའི་གང་ཡང་རུང་བའི་སྤྱི་མཚན་པ་ཞིག་གཏན་ནས་མ་ཡིན་ལ་རྩོམ་པ་པོའི་རང་གཤིས་ཀྱི་འདུ་ཤེས་འབའ་ཞིག་དང་རང་བསྟོད་ཁོ་ན་ཞིག་ཀྱང་གཏན་ནས་མ་ཡིན་ནོ།",
    "དེ་དག་ཕན་ཚུན་རྟེན་དང་བརྟེན་པའི་ཚུལ་དུ་གནས་ཞིང་འབྲེལ་འདུག་པས་ཧེ་གུར་གྱིས་རྣམ་པ་ནང་དོན་དུ་འགྱུར་བའི་རྩོད་སྒྲུབ་རང་བཞིན་གྱི་འབྲེལ་བ་གསལ་ཏུ་བསྟན་པར།",
    "བསམ་བློ་སྨྲ་བའི་འདོད་པ་ལྟར་དྲི་མས་མ་གོས་པའི་རང་བཞིན་ཅན་ཞིག་མ་ཡིན་ལ་མིའི་རང་གཤིས་ཀྱང་རང་བཞིན་ལྷན་སྐྱེས་སུ་གྲུབ་པའི་སྤྱི་མཚན་གྱི་དངོས་པོ་ཞིག་གཏན་ནས་མ་ཡིན་ཏེ།",
    "དངོས་སུ་བརྗོད་བྱར་བཟུང་བའི་དོན་རྣམས་ཀྱི་ངོ་བོ་དང་རང་བཞིན་ལྟར་སྔ་ཕྱི་གོ་རིམ་གྱི་ཕྲེང་སྤེལ་བ་ལ་བྱའོ།",
    "དེའང་བྱེད་པོ་རྩོམ་པ་པོའི་རྣམ་དཔྱོད་རིག་པའི་རྩལ་དུ་གཅིག་གྱུར་ཏུ་གྲུབ་འདུག་གཉིས།",
    "སྣང་ཡུལ་གང་ལ་བལྟས་ཀྱང་སྐྱོ་ཉམས་ཤིག་འདུག་པ།",
    "ཟློས་གར་དུ་དེ་འདྲ་མི་འོང་བས་ཟློས་གར་གྱི་བརྗོད་བྱའི་རྒྱུ་ཧ་ཅང་ཆུང་ལ་བཀག་རྒྱའང་ཆེ་བར་འདུག་གཉིས།",
    "སྣ་མང་རང་བཞིན་གྱི་ནུས་ཤུགས་ཆེ་བ།",
    "བརྙན་གཟུགས་སྒྱུ་རྩལ་གྱི་སྣ་མང་རང་བཞིན་ནི་རོལ་དབྱངས་དང་བརྙན་གཟུགས་ཟུང་འབྲེལ་དུ་སྦྱོར་བ།",
    "དེ་ཡང་མཚོན་བྱེད་རྣམ་པ་ལྟར་ན་འགུལ་རིས་དང་གསང་ཐག་འགུལ་གཟུགས་སམ་ཤོག་དུས་འདྲ་གཟུགས་བཅས་ཀྱི་གློག་བརྙན་གྱི་རྣམ་པ་སྣ་ཚོགས་པར་སྦྱོར་བ་ལྟ་བུའོ།",
    "སྐབས་འགར་ང་རང་དང་ཁ་བྲལ་ཏེ་སྐྱེས་དངོས་ཤིག་ཏུ་གྱུར་བར་སྣང་བ་དང་རང་ཡིད་ལ་ང་ནི་རྩྭ་ཞིག་གམ་འདབ་ཆགས་ཤིག་གམ།",
    "སྔོན་གྱི་བསམ་འདུན་ལས་ལྡོག་པར་གྱུར་པ་དང་རང་སེམས་ལས་འདས་པར་བྱུང་བས་རང་ཡང་ངོ་མཚར་ཞིང་ཐེ་ཚོམ་གྱི་དོགས་སྣང་སྐྱེས་པར་འཇུག་པའི་སྣང་ཚུལ་སྣ་ཚོགས་འབྱུང་ངོ།",
    "དེ་ཡང་ཧྥུ་ཅེ་ཡེ་ཧྥུ་ཡིས་སྔོན་འདང་ལ་མེ་ཏེ་ཁོ་རང་ལྕེབ་རྒྱག་ཏུ་འཇུག་གྲབས་བྱས་ལ་རྗེས་སུ་དེ་བྲོས་དམག་ཅིག་ཏུ་མ་བཅོས་ཀ་མེད་དུ་གྱུར་བ་ལྟ་བུ་སོགས་ཀྱི་དཔེ་མང་ངོ།",
    "གནའ་དཔེ་རིང་ལུགས་དང་རང་བྱུང་རིང་ལུགས།",
    "དེར་བརྟེན་དགེ་མིན་པའི་རྟོག་པ་འཆར་ཡན་རིང་ལུགས་ཀྱི་སྒྱུ་རྩལ་བསམ་བློ་ལ་ཉམ་ཐག་པ་དང་ཉམས་རྒུད་རུལ་སུངས་པའི་བསམ་བློའི་བག་ཆགས་ཀྱི་ཤུགས་ཆེ་བར་འདུག་སྟེ།",
    "སྤྱིར་དངོས་ཡོད་རིང་ལུགས་དང་རྟོག་པ་འཆར་ཡན་རིང་ལུགས་མ་ཡིན་པའི་གནའ་དཔེ་རིང་ལུགས་དང་རང་བྱུང་རིང་ལུགས།",
    "མི་དང་རང་བྱུང་ཁམས་ཆེན་པོའི་འབྲེལ་བའི་ཐད་ལ་རང་བྱུང་ཁམས་དེ་མུན་ནག་འཇིགས་རུང་དང་རྒུད་མདངས་ཤར་བའི་མྱ་ངམ་གྱི་ཐང་ཆེན་དུ་ལྟ་བ།",
    "དེ་དག་ལ་དངོས་ཡོད་རིང་ལུགས་དང་རྟོག་པ་འཆར་ཡན་རིང་ལུགས་གཉིས་ཀྱི་གྲུབ་ཆ་ལྡན་པས་དེ་གཉིས་ཟུང་འབྲེལ་དུ་སྤེལ་བའི་སྒྱུ་རྩལ་གྱི་ཉམས་ལེགས་པར་ཐོན་འདུག་རྩོམ་པ་པོ་རྣམས་ཀྱིས་སྲོལ་རྒྱུན་གྱི་ལེགས་ཆ་དེ་དག་མུ་མཐུད་དུ་རྒྱུན་འཛིན་ཅིས་ཀྱང་བྱེད་དགོས་པ་ལས་མཐའ་གཅིག་ཏུ་དགག་པ་དང་སྤོང་བ་གཏན་ནས་མི་འོས་སོ།",
    "དེར་བརྟེན་དངོས་ཡོད་འཚོ་བའི་སྣང་ཚུལ་དང་རང་བཞིན།",
    "ཁོང་རང་དང་བཅས་པའི་རྩོམ་པ་པོ་རྣམས་ཀྱིས་གསར་རྩོམ་ཁྲོད་དུ་གཟུགས་འགྱུར་གྱི་རྩོམ་སྟངས་སྤྱད་པ་བསྟན་བཅོས་ཡོངས་ཀྱི་དོན་དངོས་ནས་མཐོང་ཐུབ་སྟེ།",
    "ཀློག་མཁན་གྱིས་ཡང་བསྐྱར་གདེང་འཇོག་བྱས་པའང་རྩོམ་པ་པོའི་གདེང་འཇོག་དང་རང་བཞིན་དུ་མཐུན་དགོས་པ་ལས་ཡེ་ནས་ཐ་དད་དུ་འགྲོ་མི་འོས་པར་ཤེས་པར་བྱའོ།",
    "རྟོག་མཁན་ཀློག་པ་པོའི་འདུ་ཤེས་སུ་ཁོ་རང་དང་རྩོམ་པ་པོ་སྒྱུ་རྩལ་བ་གཉིས་དབྱེར་མེད་དུ་སྣང་བར་ངེས།",
    "ཁྱེད་རང་ལ་བསྟན་བཅོས་གཞན་དག་ལ་དཔྱོད་པའི་སྤོབས་ཚད་ཡོད་ཅིང་།",
    "རྗེ་བཙུན་འཇམ་དཔལ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་བློ་གྲོས་དཀར་ཆགམཆོག་སྩོལ།",
    "སྣ་ཚོགས་ཚོན་དང་ཕྲད་པའི་ཤེལ་བཞིན་གྲངས་མེད་གདུལ་བྱའི་རང་རང་སྐད་དང་མཐུན་པར་ནི།",
    "བདེ་འགྲོར་སྐྱེ་བའི་མཚན་མ་དེ་རྣམས་འདུག་ན་ཤིན་ཏུ་ལེགས།",
    "དྲི་ཟ་པི་ཙ་ན་ཞེས་བྱ་བའི་རིགས་དང་།",
    "ཚེ་འདས་བདེ་བ་ཅན་དུ་སྐྱེས་པའི་བྱང་སེམས་དེས་ཀྱང་རང་ཉིད་བདེ་བ་ཅན་དུ་སྐྱེས་པའི་རྒྱུ་བརྟགས་པས།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "བྱང་སེམས་དེས་ཀྱང་རང་ཉིད་བདེ་བ་ཅན་དུ་སྐྱེ་བའི་རྒྱུ་བརྟགས་པས།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱཧཱ།",
    "ཅེས་བརྗོད་ཅིང་རང་ཉིད་ལྷའི་ང་རྒྱལ་བསྟན་པར་བྱ།",
    "དེས་ཀྱང་རང་དང་རྫས་དེ་དག་ཐམས་ཅད་ལ་གཡས་སྐོར་གྱིས་ལན་གསུམ་བསང་གཏོར་བྱའོ།",
    "སྡོམ་པ་གསུམ་དང་འགལ་བའི་བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་དང་བཀྲ་མི་ཤིས་པ་ཐམས་ཅད་ཤཱནྟིཾ་ཀུ་རུ་ཡེ་སྭཱཧཱ།",
    "གཞི་བདག་སོགས་ལ་བསྔོ་ཞིང་རང་དང་ཆོ་ག་པ་རྣམས་ཀྱིས་ལོངས་སྤྱད་དེ་ཚིམ་པར་བྱའོ།",
    "དགའ་ཞིང་ཆགས་པར་བྱ་བའི་གནས་འདུག་གམ།",
    "ཕན་པར་འགྱུར་བ་ཅི་ཞིག་འདུག་པ་སོམས།",
    "བྲང་འགྲོའི་རྒྱལ་པོ་བསྐྱིལ་ཏེ་འདུག་པ་ལྟར།",
    "དམིགས་པ་ལྷའི་སྐུ་ལ་དམིགས་ནས་སྣང་ཡང་རང་བཞིན་མེད་པའི་ངེས་ཤེས་ཤུགས་དྲག་བསྐྱེད་ལ་ཟབ་གསལ་གཉིས་མེད་ཀྱི་ལྷའི་རྣལ་འབྱོར་ཅི་ནུས་སུ་བསྒོམ།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་དྷཱི་ཞེས་པའི་སྔགས་བརྒྱ་སྟོང་ཁྲི་འབུམ་སོགས་ཅི་ནུས་བཟླའོ།",
    "ཞེས་རྗེ་བཙུན་འཇམ་དཔལ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་བློ་གྲོས་མཆོག་སྩོལ་ཞེས་བྱ་བ་འདི་ནི།",
    "ༀཨ་ར་པ་ཙ་ན་རྣམས་ཡི་གེ་གྱེན་དུ་འགྲེང་བ་འོད་ཟེར་འབར་བ་སྔགས་ཀྱི་སྒྲ་སྒྲོག་བཞིན་པ་ཪེ་གསལ་བཏབ།",
    "ཨོཾ་དཱིཔྟ་ལོ་ཙ་ན་ཝི་ཀྲི་ཏཱ་ན་ན་མཧཱ་ཨ་ཊྚཊྚ་ཧཱ་ས་ན་དི་ནི་དིཔྟ་ཡ་སྭཱཧཱ།",
    "དེ་ནས་བཟླས་པ་ལ་འདུག་པ་ན།",
    "ཨོཾ་དཱིཔྟ་ལོ་ཙ་ན་ཝི་ཀྲི་ཏཱ་ན་ན་མཧཱ་ཨ་ཏྟཏྟ་ཧ་ས་དི་ནི་དཱིཔྟ་ཡ་སྭཱཧཱ།",
    "གཞལ་ཡས་ཁང་རང་ཡབ་ཡུམ་ལ་ཐིམ།",
    "ཨོྃ་བཛྲ་བེ་རོ་ཙ་ནི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ་སྭཱཧཱ།",
    "སོ་ལ་དྲེག་པ་ཆགས་ཤིང་ཉལ་འདུག་མི་ཤེས།",
    "ཕྱེད་འོག་མས་ཀྱང་རང་རྒྱུད་ཉིད་སྤངས་སོ་ཞེས་ཟེར་བ་དེ་ནི་ཤིན་ཏུ་མ་འབྲེལ་ཏེ།",
    "རྟགས་སྨོས་པ་ནི་འདི་སྐད་སྟོན་ཏེ་རྟགས་ཉིད་དུ་ངེས་པའི་འབྲས་བུ་དང་རང་བཞིན་རྗེས་སུ་དཔག་པའི་རྒྱུ་ཡིན་ནོ།",
    "འདུག་པའི་གྲུར་འཁྲུལ་པར་མི་འགྱུར་བ་དེས་ནི་བྱ་བའི་ཁྱད་པར་ཁོ་ནས་འཁྲུལ་པའི་རྒྱུ་ཡིན་ནོ།",
    "མངོན་སུམ་ཡང་རང་བཞིན་ཡོད་པའི་ཡུལ་ཅན་ཡིན་ནོ།",
    "དྲན་པའི་བག་ཆགས་སད་པ་ཡང་རུང་བའི་ཡུལ་ན་འདུག་པའི་དོན་ཁོ་ནས་བྱས་པ་ཡིན་པ་དེའི་ཕྱིར་དོན་གྱི་ཉེ་བར་སྦྱོར་བ་ནི་བྱེད་པ་དང་བཅས་པ་སྟེ་བྱེད་པ་དང་བཅས་པ་ཉིད་ལ་ཉེ་བར་སྦྱོར་བར་བརྗོད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་རུང་བའི་ཡུལ་ན་འདུག་པ་དེ་ཉིད་ནུས་པ་སད་པའི་རྒྱུ་ཡིན་ནོ།",
    "ཤིན་ཏུ་རིང་བ་ན་འདུག་པ་ནི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་དང་ལྡན་པས་ཕན་ཚུན་ཕན་འདོགས་པ་མ་ཡིན་ཏེ།",
    "དེ་ཡང་སྔ་མ་དང་ཕྱི་མར་གྱུར་པ་དག་ཉིད་ཡིན་པས་དེ་དག་དུས་གཅིག་ཏུ་ཡོད་པ་མ་ཡིན་ལ།",
    "འོན་ཀྱང་རང་བཞིན་མེད་པ་ཉིད་ཀྱིས་ཐ་སྙད་དུ་བྱ་བ་འབའ་ཞིག་ཏུ་ཟད་དོ།",
    "ངེས་པའི་བདག་ཉིད་མ་སྐྱེས་པ་ཡང་རང་རིག་པས་ཡུལ་དུ་བྱས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པའོ།",
    "བརྡ་མི་ནུས་པའི་རྣམ་པ་འདིས་ཀྱང་རང་རིག་པ་རྣམ་པར་རྟོག་པ་མེད་པར་བསྒྲུབས་པ་ཡིན་ནོ།",
    "འོན་ཀྱང་རང་བཞིན་གྱི་ཁྱད་པར་ཡང་ཡིན་ནོ།",
    "སྒྲ་ལ་སོགས་པའི་ཡུལ་རྣམ་པར་འཇོག་པ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་ཐ་དད་པ་རྣམས་ཐ་སྙད་དུ་བྱེད་པའོ།",
    "དཔེར་ན་གསལ་བའི་བདག་ཉིད་དུ་ཡོད་པའི་སྒྲོན་མ་ནི་རྒྱུའི་སྟོབས་ཀྱིས་ཉེ་བ་ན་འདུག་པ་ཉིད་གསལ་བར་བྱེད་པ་བཞིན་ནོ།",
    "དེ་ཡང་རང་བཞིན་གང་ཡིན་ཞེ་ན།",
    "དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་གཅིག་ལ་ཡང་རང་བཞིན་གྱི་ཁྱད་པར་གྱིས་བྱེད་པ་དང་བསྒྲུབ་པར་བྱ་བར་འགྱུར་རོ།",
    "རིག་པ་དེ་ཕྱི་རོལ་གྱི་ཡུལ་ཅན་དུ་ངེས་པ་ཉིད་ཀྱང་རང་རིག་པ་ཉིད་ཀྱི་རྗེས་སུ་འགྲོ་བ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཕྱི་རོལ་གྱི་དོན་དུ་སྨྲ་བ་ལ་ཡང་རང་རིག་པའི་རྗེས་སུ་འབྲངས་ནས་དོན་རྣམ་པར་འཇོག་པའི་ཕྱིར་རང་རིག་པའི་རང་བཞིན་ཁོ་ནར་རིགས་སོ།",
    "འོན་ཀྱང་ཕྱི་རོལ་གྱི་དོན་ཡོད་ཀྱང་རང་རིག་པ་ཉིད་འབྲས་བུར་རིགས་ཀྱི་དོན་རིག་པ་ནི་མ་ཡིན་ནོ།",
    "ཡུལ་དམིགས་པའི་དམིགས་པ་དེ་ཡང་རང་ཉིད་མ་གྲུབ་པ་རིག་པ་གྲུབ་པའི་ཐ་སྙད་དུ་བྱེད་པ་མ་ཡིན་ནོ།",
    "གཞན་ཏེ་དམིགས་པ་སྔ་མ་ཡང་རང་དང་གཞན་གྱི་རིག་པའི་རང་བཞིན་ཅན་དུ་འགྱུར་རོ།",
    "གཞན་ཡང་རང་དང་གཞན་རིག་པ་གཉིས་ཀྱི་འགལ་བ་ཇི་ལྟ་བུ་ཞིག་ཡིན།",
    "དེའི་ཕྱིར་རྣམ་པར་ཤེས་པའི་སྨྲ་བའི་ཚུལ་ལ་འཛིན་པའི་རྣམ་པར་རྟོག་པའི་རང་བཞིན་ནི་རང་རང་རིག་པའི་སྒྲུབ་པར་བྱེད་པར་འདོད་དེ།",
    "འོན་ཀྱང་རང་ཉིད་རྟོགས་པར་མི་ནུས་པ་དེ་དག་ལ་ཡིན་པ་དེ་བཞིན་དུ་ཚིག་ཀྱང་རང་ཉིད་བརྗོད་པར་མི་ནུས་པ་ལ་སྟོན་པ་ཡིན་ནོ།",
    "ཐ་མི་དད་པའི་ཕྱིར་ཏེ་ངོ་བོ་དང་རང་བཞིན་དག་ཐ་མི་དད་པའི་ཕྱིར་དེ་མེད་ན་རང་བཞིན་སྲིད་པ་མ་ཡིན་ནོ།",
    "དེ་ལས་ཁྱད་པར་ཅན་གྱི་ཞེན་པའི་ཡུལ་གྱི་རྒྱུ་དང་རང་བཞིན་དེ་ལྟ་བུ་ལ་རྟགས་ཅན་བློ་རྗེས་སུ་དཔག་པའི་ཤེས་པ་རྟགས་ཀྱི་སེམས་ལས་སྐྱེ་བ་ཡིན་ནོ།",
    "བསྒྲུབ་པར་བྱ་བ་ལས་དོན་གཞན་དང་རང་བཞིན་དག་གོ།",
    "བསྒྲུབ་པར་བྱ་བས་བྱས་པ་དང་རང་བཞིན་དུ་མངོན་སུམ་དང་།",
    "དེ་ངེས་ན་ནི་འབྲས་བུ་དང་རང་བཞིན་དག་ཀྱང་མེད་པར་ངེས་པར་འགྱུར་གྱི།",
    "ཅི་སྟེ་གཉི་ག་དུས་གཅིག་ཏུ་སྦྱར་བར་མི་བྱའོ་ཞེས་གཅིག་ངེས་པ་དང་ལྡན་པའི་ངག་སྦྱར་བར་བྱ་བར་བསྟན་ཏམ་ཞེ་ན།",
    "འོན་ཀྱང་རང་ཉིད་ཡོད་པས་དེ་མེད་པར་གོ་བར་བྱེད་པ་ཉིད་དུ་འགྱུར་ལ།",
    "དངོས་པོ་མེད་པ་དེ་ཉིད་ཀྱང་རང་ཉིད་ཡོད་པ་དང་མེད་པར་ཐ་སྙད་དུ་མི་ནུས་སོ།",
    "རང་རང་ལ་ངོ་བོ་ལ་གནས་པའི་རྒྱུའི་ཕྱིར་རོ།",
    "དེའི་བདག་ཉིད་ཀྱིས་འབྲེལ་པའི་རང་བཞིན་འདི་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་སུ་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་སྙམ་དུ་གལ་ཏེ་མཚན་ཉིད་གཅིག་ལ་དབྱེ་བ་མེད་པ་དེ་ལྟ་ན་ཡང་རང་བཞིན་གྱི་ཁྱབ་པ་ཁོ་ནས་གཞན་གེགས་བྱེད་པ་ཉིད་ཡིན་ནོ་སྙམ་ན།",
    "དེ་ཡང་རང་བཞིན་ཁྱད་པར་བྱེད་པ་ཡིན་ནོ།",
    "འདི་ལྟར་བླ་གབ་མེད་པ་ན་འདུག་པས་དུ་བའི་རྒྱུ་ཁྱིམ་གྱི་དག་ར་ན་ཡོད་ཀྱང་བལྟ་བར་མི་ནུས་ལ།",
    "དེའི་དོན་ནི་འདི་ཡིན་ཏེ་བལྟར་རུང་བ་ཁོ་ནའི་འབྲས་བུ་དང་རང་བཞིན་དང་འགལ་བ་དང་རྒྱུ་དང་འགལ་བ་དག་ཁོ་ན་དགག་པ་ཡིན་གྱི།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་བ་གང་དག་ལ་ཡོད་པ་དེ་དག་དང་ལྡན་པ་ཡིན་ནོ།",
    "ད་ལྟར་བ་ལ་ཡང་ཡུལ་གྱིས་ཆོད་པ་ཐག་རིང་བ་ན་འདུག་པ་ནི་ཉེ་བར་མཁོ་བ་མེད་ཅིང་།",
    "ཉེ་བ་ན་འདུག་པ་ཁ་ཅིག་ཀྱང་ཉེ་བར་མི་མཁོ་བ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བ་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པའོ།",
    "འོན་ཀྱང་རང་ཉིད་གྲགས་པ་ལས་ཀྱང་རྣམ་པར་གནས་པ་ཡིན་ནོ།",
    "རྒྱུ་དང་བྲལ་བ་མ་སྐྱེས་པ་རྣམས་ནི་ཡུལ་དང་དུས་དང་རང་བཞིན་ངེས་པར་མི་རུང་བའི་ཕྱིར་ངེས་པའི་རང་བཞིན་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་འགའ་ཞིག་ལ་ཉེ་བར་བརྟེན་པ་སྟེ།",
    "གནས་པའམ་མ་ཡིན་པ་ཡོངས་སུ་འདོར་བར་བྱེད་པ་དེའི་འགའ་ཞིག་པོ་དེ་འདོར་བའམ་བརྟེན་པའི་དངོས་པོ་དེ་ཉིད་ནི་གང་ལ་ཞེས་བྱ་བ་ཡུལ་དང་དུས་དང་རང་བཞིན་ལ་ཅུང་ཟད་འབྲེལ་པའི་རྒྱུ་ཡོད་པ་ཡིན་ཏེ།",
    "དངོས་པོ་རྣམས་ཀྱི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ཁོང་དུ་ཆུད་པ་ཡང་རང་བཞིན་གྱི་ཡུལ་ཅན་ཡིན་ནོ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་ཁྱད་པར་གྱིས་ཉེ་བར་མཚོན་པ་ནི་མེ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འོན་ཀྱང་རང་བཞིན་གཞན་ཡང་ཡིན་ཏེ།",
    "འོན་ཀྱང་རང་ཉིད་དེ་བདག་ཉིད་ཀྱི་ཡུལ་ཅན་གྱི་མི་དམིགས་པས་གྲུབ་པོ།",
    "དེ་བཞིན་དུ་བསྒྲུབ་པར་བྱ་བ་གཞན་ལྡོག་པར་ངེས་པར་བྱེད་པ་ཡང་རང་བཞིན་འབྲེལ་པ་ངེས་པ་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་པས་ན་དེའི་རྒྱུ་ཉིད་དུ་ངེས་པ་ཞེས་བརྗོད་དོ།",
    "ཕྱོགས་ཀྱི་བགེགས་དགྲ་རང་རང་དགའ་མར་བཅས།",
    "ཨུ་རྒྱན་ཉིད་དང་བེ་རོ་ཙ་ན་སོགས།",
    "ཀུན་ཏུ་ཁེངས་པ་ཡི་ང་རྒྱལ་ནི་བདག་འཛིན་དང་རང་བཞིན་གྱིས་བྲལ་བ་ཡོན་ཏན་རྡོ་རྗེ་དང་རིན་ཆེན་རིགས་རིན་འབྱུང་དང་།",
    "གཞན་ལ་ཕྲག་དོག་པ་ནི་བདག་གཞན་གྱི་རྟོག་པ་དང་རང་བཞིན་གྱིས་བྲལ་བ་སྟེ་ལས་ཀྱི་རིགས་དང་ཕྲིན་ལས་རྡོ་རྗེ་ཉིད་དུ།",
    "ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་མངོན་དུ་བྱེད་པའི་ལམ་གྱི་ཐོག་མ་འཇིག་རྟེན་པའི་ལམ་གྱི་ལོངས་སྐུར་ང་རང་སྨྲ།",
    "དཔེར་ནང་རང་བཞིན་གྱིས་གསེར་དང་ནམ་མཁའི་ཁམས་དང་ཆུ་ཁམས་འགྱུར་ཅ་པབ་མེད་པ་སྟོང་པ་དྭངས་པ་བཞིན།",
    "དེ་ལྟར་མྱོང་ཡང་རང་བཞིན་ཡང་དག་པའི་དབྱིངས་ཉིད་ལས་ཅུང་ཟད་ཀྱང་གཡོས་པའམ་གོལ་བའམ་ཉམས་པ་མེད།",
    "འདོད་བང་མཛོདཆགས་ཆེ་བའི་ཚད་འགྲོ་རུང་འདུག་རུང་འཁྱུད་པ་ལ་སོགས་པའི་མི་བཟད་དུག་གསུམ་འབར་བ་ཡིསསྐྱེ་རྒ་འགྲོ་བ་ཐམས་ཅད་ཀུན་ལ་རྣམ་པར་འཚེ་སྟེ།",
    "སོ་སོ་རང་ཉིད་ཞི་བདེ་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་འབྲས་བུ་བསྒྲུབ་འདོད་པ།",
    "འཕགས་པ་དགྲ་བཅོམ་པ་དང་རང་རྒྱལ་བ་སྟེ་ལྔ་པོ་དེ་དག།",
    "དེ་ལྟར་སྣང་བའི་སེམས་ཉིད་ཀྱང་རང་རིག་པ་གསལ་ལ་ངོ་བོ་མི་རྟོག་པ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བས་འདོད་པའི་ཕྱི་རོལ་དོན་དུ་གྲུབ་པ་ཡོད་པར་མི་བརྟག་གོ།",
    "དེའི་ཚེ་གཟུང་བའི་ཡུལ་མེད་པས་དེར་འཛིན་པའི་སེམས་ཀྱང་རང་རིག་པ་ཙམ་ལས་མེད།",
    "དེ་ལྟར་རིག་པས་སུམ་ཅུ་ཐམ་པ་བཅོསའཁྲུལ་སྣང་འདི་སྣང་ཡང་རང་བཞིན་མེད་པའི་སྒྱུ་མར་མ་བསྒྲུབ་ན།",
    "ཉེས་ལྟུང་རང་དང་གཞན་གྱི་དོན་དང་ལམ་དུ་མི་འགྱུར་བའི་མི་དགེ་མཐའ་དག་སྤངས་བྱ་ཞེ་བཞི།",
    "ཞེ་སྡང་ཅན་ལ་མི་བསྐྱོད་པ་ལ་སོགས་པ་དུ་མའི་རྣམ་པར་རྡོ་རྗེ་འཆང་རང་ཉིད་འགྱུར་སྟེ། མཉམ་སྦྱོར།",
    "མཆོད་རྫས་མེ་ཏོག་སྣ་ཚོགས་དང་རང་ལོངས་སྤྱོད་པའི་ཤིང་ཏོག་ལ་སོགས་པ་འབྲས་བུ་གཙང་མ་ཡོད་པ་དང་།",
    "དེ་ནི་ཡོད་མེད་རྟག་ཆད་ལ་སོགས་པའི་སྤྲོས་པ་ཀུན་དང་རང་བཞིན་གྱིས་བྲལ་བ་སྟེ།",
    "མཐར་གང་དུ་འགག་དབྱིངས་དང་ཁ་དོག་ཅིར་འདུག་མཚན་ཉིད་བལྟས་པས་མ་གྲུབ་སྐྱེ་མེད་རང་གྲོལ་ཀྱིས་སྤང་བར་བྱ།",
    "གཅིག་པུར་འདུག་ཀྱང་འཁྲིག་དང་བཅས།",
    "སྲོག་དང་བཅས་པའི་སྲོག་ཆགས་མི་ལ་སོགས་པ་གཞན་རྣམས་ཀྱང་རང་དོན་གྱི་དུས་ལ་བབ་ན་གསོད་པ་དང་།",
    "དེ་ལ་པ་གོར་བི་རོ་ཙ་ན་དང་།",
    "ཞེ་སྡང་རྡོ་རྗེ་ལ་སོགས་པ་རང་རང་རྒྱུད་ཀྱི་སྟོན་པ་དེས་གདུལ་བའི་གདུལ་བྱའི་དོན་དུ་གསུངས། ནམ་མཁའ་ཆེ།",
    "དུས་ནམ་ཞེ་ན་གདོད་ནས་སྤྲོས་པའི་མཐའ་ཐམས་ཅད་དང་བྲལ་བར་རྒྱུ་རྐྱེན་ལས་མ་བྱུང་རང་བཞིན་གྱིས་ལྷུན་གྱིས་གྲུབ།",
    "རྟེན་ཁྱད་པར་དུ་འཕགས་པ་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོས་འགྲོ་བ་ལམ་ལ་འགོད་ཅིང་རང་ཉིད་ཀྱི་ལམ་སྦྱོར་བ་གོ་འཕང་འགྱུར།",
    "རྟོག་དཔྱོད་སྣ་ཚོགས་ཀྱི་བློས་བཙལ་ཀྱང་གནས་ལུགས་ཅི་ཡང་མ་ཡིན་པའི་ཕྱིར་མ་རྙེད་ཅིང་རང་ལ་ལྷུན་གྲུབ་ཏུ་འདུག་ཀྱང་དེ་མ་ཤེས། བསམ་མི།",
    "འདི་ནི་ཡོད་པར་སྒྲོ་འདོགས་པ་དང་མེད་པར་སྐར་པ་འདེབས་པ་ཐམས་ཅད་དང་རང་བཞིན་གྱིས་བྲལ་བ་སྟེ།",
    "འགག་པ་སྣང་ངམ་མི་སྣང་རང་རིག་མ་བཅོས་པས་རང་བཞིན་ཐ་མ་བལྟས་བྱས་ན།",
    "དང་པོ་རབ་ཏུ་དགའ་བ་ལ་སོགས་པའི་ས་འགའ་ལ་ཡང་རང་བཞིན་གནས་པ་མེད་པའི་ཡེ་ཤེས་དེ་གནས་མི་ཅ་པབྱེད་སྟེ།",
    "མཐའ་མི་རྟོགས་ཤིང་རང་མགོ་འཁོར།",
    "མིང་མེད་ནང་ནས་ཤར་ཙ་ན།",
    "གཟུང་འཛིན་སྤྲིན་ཕུང་རང་སར་དྭངས།",
    "ཅིར་སྣང་རང་གྲོལ་བདེ་ཆེན་ལ།",
    "སེམས་ཉིད་འོད་གསལ་རྟོགས་ཙ་ན།",
    "རང་རང་རྟེན་རྣམས་མྱུར་སྤོངས་ཏེ།",
    "རང་རང་ཏིང་འཛིན་མ་ཞེན་པར།",
    "རང་ག་ཞཤུ་ཐམས་ཅད་ཀྱིས་དགེ་རྩ་གང་བྱས་ལ་དེ་ལེགས་འདུག་སྙམ་པ་དང་།",
    "ཐོས་བསམ་སྒོམ་གསུམ་ཟུང་དུ་འབྲེལ་བས་འང་གཞན་གྱི་རྒྱུད་ལ་བསྟན་པ་རྒྱས་པར་བྱས་ཚུལ་འདི་བསམསཤིང་འདུན་མའམ་བློ་རྩེ་གཏད་ས་ལེགས་ནས་གདའ།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "གཞུངག་ཚིགའོས་ཙམ་ལ་བརྟན་པ་མ་ཡིན་པར་བསྟན་བཅོས་ཀྱི་ལུས་ཡོངས་སུ་རྫོགས་པའིདོན་གྱི་ཁོག་ལེགས་བར་བསིགསཞས་ཤགང་འརྒྱུག་པའི་གོ་བ་བོགས་ཆེད་དུ་སྟེར་ནུས་པ་ཞིག་འདུག་པས་དད་པ་ཆེན་པོ་འཁྲུངས།",
    "ཁྱེདལ་མཛུབ་ཁྲིད་བྱེད་པ་ལལེགས་པའི་བསྒྲིམ་དགོས་པ་འདུག་གསུང་།",
    "རང་ཉིད་གཏན་དུ་བདེ་བའི་ལམ་སྒྱུ་རྙེད་བས་མདུན་མ་ལེགས་འདུག།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "ལེགས་པར་སྦྱངས་ཏེ་ཐེ་ཚོམ་ཆོད་པར་བྱས་ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "ཚུལ་འདི་བསམས་ཤིང་མ་དུཤན་ལེགས་ནས་གདའ།",
    "ཚུལ་འདིབསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་འཚིགས་ནས་གདའ།",
    "ཚུལ་འདི་བསམསཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "སྟར་ཤམམ་ཅུ་ཟ་། པོ་ལྷས་པ་ཡིན་ཟེར་བ་བགྲེས་ཉམས་ཅན་དབུ་རྒྱན་གསོལ་ཞིང་རྡོ་དྲིལ་བཟུང་བ་ཞིག་བཞུགས་འདུག་པ་དེའི་སྐུ་མདུན་ན་རྗེ་རང་བཞུགས་འདུག་པ་ལ།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "མི་གོ་བར་འདུག་ལགས་ཞུས་པས།",
