    "འདོམ་མི་སྣང་བར་སྟན་ལ་འདུག་པར་བྱ་ཞེས་སོ།",
    "དེ་བཞིན་དུ་ཉན་པ་པོ་ལམ་དུ་འགྲོ་བཞིན་པ་ལ་འཆད་པ་པོ་ལམ་མིན་པ་ཟུར་ལ་འདུག་པས་ཀྱང་འཆད་པར་བྱ་བ་མིན་ནོ།",
    "དེར་མ་ཟད་འགྲེང་བ་དང་ཉལ་བ་དང་འདུག་པ་དང་འཆག་པ་ལ་ཡང་ཀུན་མཁྱེན་གྱིས་བསྟན་པ་དེ་བཞིན་དུ་བྱ་སྟེ་ཞེས་བྱ་བའོ།",
    "ཅིག་ཤོས་གཞན་ཕྱོགས་ཀྱི་གནས་བརྟན་ལ་ཡང་རང་ཕྱོགས་ཀྱི་གནས་བརྟན་དེས་ནི་སྔར་བཞིན་བརྗོད་པར་བྱའོ།",
    "མེ་བཞི་ལྟ་བུ་དེས་ཀྱང་སྔར་བསྟན་པ་དེ་ལྟར་རྒན་པའི་མཐར་ནི་འདུག་སྟེ།",
    "ཉལ་ཤོམ་འདུག་འགྲེང་།",
    "མ་བསྒོ་བར་སྟན་ལ་འདུག་པ་དང་།",
    "སྐྱེས་པ་དེ་དང་ལྷན་ཅིག་ཏུ་འདུག་པར་མི་བྱ་བ་དང་།",
    "བཞིན་བཟང་མིག་ལམ་ན་མ་འདུག་ཅེས་སེ་གོལ་གཏོགས་ཏེ་ཞི་བས་བསྐད་དོ།",
    "ཡང་ནགས་ཁྲོད་དབེན་པར་འདུག་པའི་གནས་སྐབས་ལ་མཁས་པས་འབྲུ་མར་ལ་སོགས་པ་ཉེར་མཁོའི་སྣོད་ཉེ་བར་གཞག་པར་བྱ་སྟེ།",
    "བསྙེན་པར་རྫོགས་ནས་ལོ་བཅུ་མ་ལོན་ཞིང་ལྔ་ཕྲུགས་ཐ་མ་དང་མི་ལྡན་པ་དེ་ནི་གནས་ཀྱི་སློབ་དཔོན་མེད་པར་ངེས་པར་ཞག་གཅིག་ཀྱང་འདུག་པར་མི་བྱའོ།",
    "གནས་ཀྱི་སློབ་དཔོན་དེ་མེད་པར་འདུག་པར་མི་བྱའོ།",
    "མི་འདུག་པ་དང་།",
    "སྦྱིན་བདག་ཁོ་རང་རིན་ཇི་ཙམ་འཇལ་འདོད་པས་སླར་གཏང་བར་བྱའོ།",
    "མི་ནུས་ན་བཤོས་བསྣམས་ལ་བཞུད་ཅིག་ཅེས་སྨྲས་པ་སྟོན་པ་ལ་ཞུས་པས་དགེ་སློང་མ་འབའ་ཞིག་གནས་ནའང་དགེ་སློང་གཅིག་འོངས་ན་སྟན་ཡང་དང་པོར་ཞོག་ཅེས་པ་ལ་བརྟེན་ནས་དགེ་སློང་མ་གཅིག་པུ་སྟེ་འབའ་ཞིག་མགྲོན་དུ་བོས་པའི་དུས་ན་དགེ་སློང་མ་རྣམས་གྲལ་དུ་འཁོད་པའི་ཚེ་ན་གནས་གང་དུ་ཟས་ཟ་བ་ཉིད་ཀྱི་ཕྱིར་དུ་དགེ་སློང་འདུག་པའི་སྟན་ནི་དགེ་སློང་མ་རྣམས་ཀྱི་གྲལ་གྱི་དང་པོར་གཞག་གོ།",
    "གཞན་དག་གནས་ནས་ཕྱུང་བ་ཤི་བ་ན་གཅིག་རང་བཞིན་དུ་གནས་པའི་ཡོ་བྱད་དུ་མ་ཟད་གཅིག་གནས་ནས་ཕྱུང་བའི་ཡོ་བྱད་རྣམས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་རྣམས་ལ་རུང་བ་ཡིན་ནོ།",
    "ལྗོན་ཤིང་དང་ཉེ་འཁོར་དང་སྤོང་ས་དང་འདུག་ས་ལ་སོགས་སོ།",
    "མིའི་འགྲོ་འདུག་ཉུང་བའི་དབེན་པར་གནས་པར་བྱ་སྟེ།",
    "སླར་ཡང་དགེ་སློང་གཞན་གཙུག་ལག་ཁང་དེར་འཇུག་པ་བྱུང་ན་དེ་ལ་འདུག་གནས་སྦྱིན་པར་བྱའོ།",
    "དྲི་བ་པོ་དེ་ཡིས་དགེ་སློང་འདུག་པའི་ཐད་དུ་ཉེ་བས་སམ་འགྲོ་བཞིན་དུ་དྲིས་ཀྱང་རུང་ངོ།",
    "ཀུན་དགའ་བོས་ཞུས་པ་ལ་བརྟེན་ནས་ཁྱིམ་པའི་ཁྱིམ་དུ་ཀོ་ལྤགས་ཀྱི་སྟན་གྱི་སྟེང་དུ་འདུག་པ་ཙམ་རུང་ལ།",
    "ཤིང་ཁྲི་བརྟན་པ་ལ་ནི་གཉིས་འདུག་ཏུ་རུང་ངོ།",
    "དེ་ཡོལ་གང་ཞིག་དུས་རུང་ཟ་བྱེད་དེ།",
    "གནས་ལ་མ་རྟེན་པར་འདུག་པས་ཆོག་པ་སོགས་ནི་གསུང་བ་མེད་ཅིང་།",
    "དགེ་སློང་ལ་རུང་བའི་བཏུང་བའི་ཁྱད་པར་གང་ཞིག་དུས་ཀྱི་ཁྱད་པར་ཉིན་མཚན་ཀུན་ཏུ་ལོངས་སྤྱད་རུང་བའོ།",
    "དགེ་སློང་ལ་རུང་བའི་གོང་བུའི་ཟས་གང་ཞིག་དུས་ཐམས་ཅད་དུ་ལོངས་སྤྱོད་དུ་རུང་བའོ།",
    "དེ་ནི་སྤྱིར་བཅས་པ་དང་རང་བཞིན་གྱི་ཁྱད་པར་མ་ཕྱེད་ཅིང་།",
    "འགྲོ་འགྲེང་འདུག་ཉལ་བཞི་ལས།",
    "འདུག་ན་སྐྱིལ་ཀྲུངས་སུ་ཤོང་བ།",
    "དགེ་སློང་རང་ཉིད་འཁོར་ལོའི་དབྱེན་གྱི་སྦྱོར་བ་མཚན་ཉིད་པ་ལ་ཞུགས་པ།",
    "དབེན་པ་སྐྱབས་ཡོད་ན་འདུག་པའོ།",
    "ཅིག་ཤོས་ནི་དེའི་ཕྱི་རོལ་དུ་འདུག་པའོ།",
    "འདི་ལ་ནི་དགེ་སློང་རང་ཉིད་གོས་སློང་བར་རིགས་པ་ཡིན་མིན་གྱི་ཁྱད་པར་མེད་དེ།",
    "འདི་གཉིས་ནི་དགེ་སློང་རང་ཉིད་གོས་སློང་བར་རིགས་མི་རིགས་གང་ཡིན་ཡང་རུང་སྟེ།",
    "ཀུན་སློང་རང་དོན་དུ་འཆང་བར་འདོད་པ།",
    "ཀུན་སློང་ཐ་དད་དུ་འདུག་པར་འདོད་པ།",
    "རང་ཉིད་འདུག་སའི་གནས་གཉིས་ཀ་མཚམས་ཀྱི་ཕྱི་རོལ་ཡིན་པ་སྲིད་ལ།",
    "ཀུན་སློང་རང་དུས་ལས་འདས་པར་འཆང་འདོད་པ།",
    "དེ་ཡང་རང་ལ་གནས་མལ་སོགས་ངན་པ་སྟོབས་པ་པོ་མ་ཡིན་པའོ།",
