    "དཔངས་མཐོ་བའི་ཚོད་དུ་གདའ།",
    "འོན་ཀྱང་ཐུགས་རབ་ཀྱི་ཤུགས་ཀྱིས་ཅུང་ཟད་རྩུ་བ་ཉམས་འདུག་པས་དྲས་རྒྱག་དགོས།",
    "འདིའི་ཐད་བཞེད་པ་མི་མཐུན་པ་འགའ་ཞིག་གདའ་བས་ཞིབ་པར་སྙན་འགྲེལ་མི་འཇིགས་སེངྒེའི་ང་རོ་༣༡༧ དང་།",
    "སྔོན་དུས་ཀྱི་བོད་ཀྱི་རྒྱལ་པོ་རྣམས་ལ་སྐུ་བོན་བྱ་བ་ཞིག་ཡོད་པ་དེ་ཡིན་ཚོད་གདའ།",
    "རྒྱལ་པོ་དང་པཎ་གྲུབ་གཞན་སུ་དག་དུས་མཉམ།",
    "སྟོན་པ་ཞལ་བཞུགས་པའི་སྐབས་སྟོན་པའི་དྲུང་དུ་རྒྱུན་ཞུགས་ཀྱིས་མདུན་འདུག་པའི་ཞབས་ཞུ་བསྒྲུབས།",
    "མུ་སྟེགས་ངན་པ་རྣམས་ཀྱི་ཀླད་པ་འགེམས་ཞེས་བྱ་བའི་སྒྲར་འདུག་གོ་ཞེས་དེར་བྲམ་ཟེའི་རྒྱལ་པོ་རྒྱལ་བཤེས་ལ་སོགས་པ་མུ་སྟེགས་རྣམས་ཀྱིས་དམག་བྱས་ཏེ།",
    "སུ་འདུག་ལ་ཕུལ་ཅིག་ཟེར་བའི་སྒྲ་ཞིག་བྱུང་བ་ན་འོད་སྲུངས་ལ་ཕུལ་བས་ཀྱང་སུ་ཡང་མ་མཐོང་ཞིང་།",
    "དཀར་པོ་ལ་སོགས་པ་ཁ་དོག་ཕྱི་ནང་ལ་སོགས་པ་ཇི་ལྟར་འདུག་ལྟོས་ཤིག་གསུངས་པས།",
    "གང་ཡང་རང་བཞིན་དང་བྲལ་བའི་ཕྱིར་ལས་སྟོང་པའོ་ཞེས་རོང་དུ་ཚུད་པདུ་དག་པར།",
    "གལ་ཏེ་སླར་ཡང་རང་བཞིན་ཡོད་པ་ཉིདི་བས།",
    "གལ་ཏེ་ཡང་རང་བཞིན་མེད་པ་ལ་ཕྱིན་ཅི་ལོག་པ་རྣམསཀྱིས་ད་ཡོ་སུ་ཤེས་པས།",
    "གུར་རིགས་བསྡུས་ཀྱི་དཀྱིལ་ཆོག་དུས་ཀྱི་འཁོར་ལོའི་མངོན་རྟོགས།",
    "དཔའ་གོར་བེ་རོ་ཙ་ན་རཀྵི་ཏ་རྣམ་པར་སྣང་མཛད་སྲུང་བ་ཞེས་བྱ་བ་དང་།",
    "ཉེ་གནས་མ་གྲོག་པོ་གཅིག་ལ་དེའུ་འགྲིལ་བས་ཁྱིམ་དུ་ལོག་ཙམ་ན་མ་ཇོའི་སྔུན་དུ་སྒོག་པ་སྤར་གང་ཡང་འདུག་གོ།",
    "ཨ་ར་པ་ཙ་ན་འདི་བསྒྲུབ་གསུངས་ནས་བསྒྲུབས་པས།",
    "སྔ་དྲོ་ཉི་མ་ལ་འཐོན་ནས་བསྡད་ཙ་ན།",
    "སང་ཕོད་འགྲོ་སྙམ་ཙ་ན་སེས་གསུང་བ་ལྟར་བདེན་ཏེ།",
    "ས་སྐྱ་ནས་འོངས་པ་ཅིག་མཇལ་ཁ་ཞུ་ཡིན་གདའ་འོ་བྱས་ཏེ་ཞུས་པས་བཟའ་བཏུང་འདོད་པ་ཡིན་ནམ་བྱིན་གསུངས་ནས་མ་མཇལ།",
    "ཡར་ལན་མར་ལན་མང་པོ་གཅིག་བྱས་ཏེ་ས་སྐྱ་ནས་འོངས་པའི་འབུལ་བ་ཅིག་བདོག་པས་མཇལ་བྱས་འཕྲལ་ཐུགས་ཅོལ་ཆུང་བ་འདྲ་ཅིག་ཡོད་པས་ཁོང་རང་བྱོན་ནས་འབུལ་བ་ཅི་ཡོད་གསུངས་གསེར་ཅིག་བདོག་བྱས་པས།",
    "དེ་ལྟར་བྱས་པས་ཁོང་དམ་ཚིག་པ་བསམ་གྱིས་མི་ཁྱབ་པ་འདུག་པ་ལ་ངས་དེ་ལྟར་ཅུང་མ་ཤེས།",
    "འོ་ན་སྤྱོད་ལམ་གྱི་ལུགས་འདི་ལ་དཔག་ན་ང་རང་ནོར་བ་ཀ་ཡིན་ནམ་སྙམ་ནས་ལོག་པ་དང་།",
    "དེ་ནས་ས་སྐྱར་བཞུགས་ཙ་ན།",
    "སྔགས་ཀྱི་ཡིག་འབྲུ་འདྲ་ལས་མི་འདུག་གསུངས།",
    "བླ་ཆེན་གྱིས་ཚར་ཁར་ནམ་བྱོན་དྲིས་པས་གུང་ཐང་ཡན་ཆད་དུ་བྱོན་པ་ཡེ་མེད་ཟེར་ཏེ་སྐུའི་བཀོད་པ་བསྟན་པ་ཡིན་པར་འདུག་གོ།",
    "རྒྱལ་ཁམས་ཀྱི་མི་ལ་བལྟས་ན་སྔར་གྱི་ས་ན་མི་འདུག་སྟེ།",
    "ཁུ་སིམ་པོར་འདུག་པར་སྦྱང་བ་བྱོས།",
    "ཁྱེད་ཀྱི་སྡོད་སྟངས་གང་ཞིག་ཡིན་རུང་རང་ཉིད་ཀྱི་སྒལ་བ་བརྐྱངས་ཡོད་པ་དང་།",
    "གལ་ཏེ་ཁྱེད་རང་རྐུབ་སྟེགས་སྟེང་དུ་སྡོད་པའམ་དཀྱིལ་ཀྲུང་དུ་བསྡད་ཡོད་ན།",
    "གསུམ་པ་སྤྱང་གྲུང་དོད་པའི་འདུག་སྟངས་ཤིག་དགོས་ཤིང་།",
    "སྣང་བརྙན་དེ་དག་དང་རང་ཉིད་ཀྱི་བར་ལ་རྒྱང་ཐག་ཐུང་ངུ་ཞིག་འཛིན་དགོས།",
    "འདི་དང་ཧ་ཅང་མཚུངས་པའི་ལྟ་ཚུལ་ཞིག་དུས་རབས་བཞིའི་སྔོན་ལ་རྒྱ་གར་གྱི་ལྟ་གྲུབ་སྨྲ་བ་རྒྱང་འཕེན་པས་བཏོན་ཡོད།",
    "གལ་སྲིད་ཁྱེད་རང་གཅིག་པུས་མཚར་སྡུག་ལྡན་པའི་ཉི་ནུབ་ལ་ལོངས་སྤྱོད་བྱས་ཚེ།",
    "གལ་ཏེ་འདོད་པ་དེ་ནི་སྟོབས་ཤུགས་ཆེ་ཞིང་རང་ཉིད་དེར་གོམས་འདྲིས་ཡོད་ཚེ་དམིགས་པ་དེའི་སྟེང་དུ་བཞག་ཀྱང་ཕན་མི་ཐོགས།",
    "ཁྱེད་རང་ལེའུ་གོང་མའི་ནང་དུ་འགྲེལ་བརྗོད་བྱས་པའི་ཉམས་ལེན་ལ་ཞུགས་ཚེ།",
    "སེམས་དང་རང་ཉིད་འཚོ་སའི་ཡུལ་གྱི་འཇིག་རྟེན་བར་གྱི་འབྲེལ་བ་ནི་ཧ་ཅང་དམ་པོ་ཡིན་སྟབས།",
    "རང་ཉིད་འགྱུར་བ་མེད་ཅིང་རང་རྐྱ་འཕེར་བའི་བདག་ཅིག་ཏུ་མཐོང་བའི་འདུ་ཤེས་དེ་ནི་རང་གཅེས་འཛིན་ལས་བྱུང་བའི་འདོད་ཆགས་དང་།",
    "གཞན་ལ་ལྟོས་མེད་ཡིན་ཞིང་རྟག་བརྟན་དང་རང་རྐྱ་བ་ཡིན་པའི་བདག་ཅིག་ཡོད་པའི་འཁྲུལ་སྣང་དེ་གསལ་སྟོན་བྱས་ཏེ།",
    "ཆ་ཤས་ཀྱི་ཚོགས་པ་ཧྲིལ་པོ་འདི་ཡིས་ཀྱང་རང་ངོས་ནས་ཤིང་རྟ་འཁོར་ལོ་དེ་འགྲུབ་མི་ཐུབ།",
    "འཁྲུལ་སྣང་རང་བཞིན་གྱི་སྣང་བ་ཙམ་ཡོད་ཀྱང་།",
    "དེ་བཞིན་དུ་སེམས་ཀྱང་རང་ཉིད་ལ་སྣང་བ་ཙམ་དུ་གྲུབ་པ་ཞིག་ཡིན།",
    "ད་དུང་རང་ཉིད་གཉིད་ཁུག་པ་དང་།",
    "དེ་བཞིན་དངོས་གཟུགས་ཀྱང་རང་ངོས་ནས་གྲུབ་ཡོད་པ་ཞིག་མིན།",
    "འོས་འཚམས་ཀྱི་སྒོམ་སྒྲུབ་ཉམས་ལེན་ལ་བརྟེན་ནས་ཐག་གཅོད་བྱེད་རྒྱུ་ཞིག་ཡིན་པ་ལས་ཤེས་པའི་ཚད་བཀག་དང་ངོ་བོའི་ཐད་ཀྱི་འཁྲུལ་སྣང་རང་བཞིན་གྱི་ཤེས་རྟོགས་ལ་ཁུངས་འདེད་བྱེད་རྒྱུ་ཞིག་མིན།",
    "བྱས་པ་ལྟ་བུ་མི་འདུག་ཅེས་བརྗོད་ཆོག་པ་ལྟ་བུར་གྱུར་ཡོད།",
    "དེ་དག་ཐོབ་རྒྱུའང་ཤིན་ཏུ་དཀའ་སེ་བ་འདུག་ཀྱང་།",
    "ང་རང་རྩ་དགོངས་སམ་ལས་ཀ་མ་བྱས་པར་བསྡད་པ་ཡིན་ན།",
    "བོད་མིས་རང་རིགས་དང་རང་ཡུལ།",
    "མི་ལོ་༥ རིང་རང་ཉིད་ཀྱི་འཇོན་ཐང་དང་།",
    "རྒྱུ་རྐྱེན་གཙོ་ཆེ་བ་ཞིག་དུས་ཡུན་རིང་པོའི་བན་བོན་འགལ་ཟླ་ལས་བྱུང་ཡོད།",
    "སློབ་ཚོགས་བསྐྱངས་ཤིང་རང་ལུགས་གསར་གཏོད་བྱས་ཤིང་།",
    "ཚང་མས་བསྙེན་བཀུར་ལ་འགྲན་བསྡུར་བྱས་འདུག་ཇོ་བོ་རྗེ་བསམ་ཡས་སུ་ཕེབས་ཤིང་།",
    "བོད་ཀྱི་ས་མཚམས་ཚོ་ཤོག་ཚོས་རང་རང་མགོ་ཐོན་ཐབས་སུ་རྒྱུ་ནོར་གྱ་ནོམ་པ་སྤྲད་དེ།",
    "ང་རང་ཉིད་ཀྱང་མ་འོངས་པར་ཆབ་སྲིད་ནང་ཞུགས་འདོད་མེད་ཅེས་གསུངས་ཡོད།",
    "བྱས་འདུག་ཀྱང་།",
    "ཡི་གེའི་ནང་ད་དུང་དམིགས་དོན་གྲུབ་རྗེས་གུ་ཤྲི་ཁཱང་རང་ཉིད་ཀྱི་ས་ཆར་ཕྱིར་ལོག་དགོས་ཚུལ་བཀོད་ཡོད།",
    "ཅེས་བཀོད་འདུག་སྲིད་འཛིན་ཡོན་ཧྲི་ཁེ་ཡིས་བསྐྱར་དུ་འཕྲིན་ཡིག་ཕུལ་ཏེ།",
    "བོད་མི་ས་ཡ་གཅིག་དང་འབུམ་གཉིས་ལྷག་དུས་མ་ཡིན་པར་འཆི་འདས་བྱུང་ཡོད།",
    "འབྱུང་སྲིད་པའི་གཡུལ་འཐབ་ལ་རང་རང་ས་ནས་གྲ་སྒྲིག་བྱེད་བཞིན་ཡོད།",
    "གྲྭ་བ་ཚོ་སྲིད་དོན་ཚོགས་པའི་ནང་འཛུལ་ཞུགས་བྱ་རྒྱུར་ང་རང་འདོད་བབ་མེད།",
    "དགོས་པ་འདུག་གམ།",
    "དེའི་ཐད་ང་རང་བློ་བདེ་བོ་བྱུང་།",
    "ཁོ་ཚོས་ཚོད་དཔག་བྱས་པ་ལྟར་ན་སུམ་བརྒྱ་ལྷག་ཡོད་པར་བཤད། འཛམ་གླིང་སྟེང་ཨ་ཧྥེ་རི་ཀའི་རིགས་རྒྱུད་དབྱེ་འབྱེད་ལ་ངོ་རྒོལ་དང་ཝེ་ཏི་ནམ་དམག་འཁྲུག་ལ་ངོ་རྒོལ་སོགས་འཛམ་གླིང་རང་བཞིན་གྱི་ཚོགས་པ་དང་ལས་འགུལ་སྤེལ་མཁན་ཡོད་ནའང་།",
    "དཀའ་སྣང་ཅི་ཡང་ཤར་གྱི་མི་འདུག་དེར་བརྟེན།",
    "རྒྱ་གར་ནས་ཕྱིར་ཐོན་ཚར་འདུག་བལ་ཡུལ་གྱི་རྟེན་གཞི་དེའང་ལོ་བཅུ་ཕྲག་དུ་མའི་རྗེས་ཇེ་ཉུང་དུ་འགྲོ་ངེས།",
    "རང་ཅག་རྗེ་འབངས་ཚང་མ་རང་རང་སོ་སོའི་སྲོག་མགོ་ཐོན་ཐབས་ཙམ་གྱི་ཆེད་དུ་རྒྱ་གར་ཕྱོགས་སུ་ཡོང་བ་ཞིག་རྩ་བ་ནས་མིན།",
    "བོད་རིགས་ཡིན་ཕྱིན་རང་རང་སོ་སོའི་ཤེས་ནུས་གང་ཡོད་སྤྱི་དོན་ཐོག་ཕྱར་བ་གྲུ་འདེགས་བྱེད་དགོས་པ་མ་ཟད།",
    "རང་རང་སྐབས་བབས་བྱེད་སྒོ་འདི་བགྱིད་ལན་གསལ་སྐབས་བསྟུན་བྱ་རྒྱུ་ཡིན་ཞེས་གསུངས།",
    "མཁོ་ཆས་ཉོ་སྒྲུབ་ཀྱི་སྒྲིག་འཛུགས་བཟོས་པའང་བྱུང་འདུག་པས།",
    "དེ་བཞིན་ཞོར་ལས་ཀྱི་ཐོན་སྐྱེད་ཀྱང་བྱེད་བཞིན་ཡོད་ཅེས་བྲིས་འདུག་ས་རྒོད་གསར་སྦོལ་གྱི་དཀའ་ངལ་ལས་གཞན།",
    "དཀའ་ལས་ཁག་ཙམ་བྱུང་འདུག་ཀྱང་།",
    "ང་རང་འུ་ཐུག་སྟེ།",
    "ཁོ་རང་རྒྱུན་ནས་ཕྱི་ལ་ཐོན་གྱི་མི་འདུག་སྐབསདེར་ངའི་སེམས་སུ་མི་འདི་ལའང་རིམ་པ་གོང་མ་ཞིག་ཡོད་ངེས་ཡིད་ལ་འཁོར་ཏེ།",
    "༡༩༦༤ ལོར་གསེར་དངུལ་རྣམས་སྤུས་བསྒྱར་མཛད་པའི་ཕྱག་དངུལ་ཁོངས་ནས་ཧིན་སྒོར་ས་ཡ་བརྒྱད་༨སྐོར་ཞིག་ཡིད་ཆེས་དགེ་རྩའི་མ་རྩར་འཇོག་གནང་མཛད་ཡོད་འདུག་འོན་ཀྱང་སྟབས་མ་ལེགས་པ་ཞིག་ལ།",
    "སོ་དྲུག་དང་ལྔ་ཁྲི་བརྒྱད་སྟོང་བཞི་བརྒྱ་༣༦༥༨༤ཁ་བསླུས་སུ་ཤོར་བ་ཡོངས་གྲགས་ཐོགསྐབས་དེར་རང་གཞུང་བཀའ་ཤག་ནས་བདའ་འདེད་ནན་པོ་གནང་ཡོད་འདུག་ཀྱང་།",
    "སྐྱབས་བཅོལ་བོད་མིའི་གསོག་སྒར་བརྒྱད་ཡོད་ཚུལ་བྲིས་འདུག་ཀྱང་།",
    "འབྲུག་ཨ་སམ་སོགས་ལ་ལམ་བཟོར་བསྐྱོད་འདུག་༦ཊཱོན་ཨེ་ཝེ་ཌོན་གྱིས་བྲིས་པའི་གངས་ལྗོངས་ཕྱི་ལོཌ་ཀྱི་བཙན་བྱོལ་ཟིན་ཐོ་གངས་ལྗོངས་ནས་བཙན་བྱོལ།",
    "དབྱིན་ཡུལ་དུ་བོད་མི་༡༨༦ ཡོད་འདུག་དཔྱ་ཁྲལ་འབུལ་མི་༦ ཙམ་ལས་མེད་པ་དང་།",
    "འཇར་མན་དུ་བོད་རིགས་༩༨ ནང་རང་བཙན་ལག་དེབ་ཡོད་མི་༤ ནས་དཔྱ་ཁྲལ་གཙང་འབུལ་ཞུ་མི་༢༥ ལས་མི་འདུག་བྷེལ་ཇཱམ་དུ་བོད་མི་༣༡ ཡོད་པ་དང་།",
    "དཔྱ་ཁྲལ་འབུལ་ཐོར་ཞིབ་འཇུག་བྱས་པར་༡༩༩༥ ལོར་དཔྱ་ཁྲལ་འབུལ་མཁན་༤ བྱུང་འདུག་ཀྱང་།",
    "ཕྱི་ལོ་༡༩༩༧ ནས་༢༢ རིང་དཔྱ་ཁྲལ་དངུལ་འབོར་བརྒྱ་ཆ་༧༣་༧༥ཙམ་འཕར་ཡོད་འདུག་ལོ་དུས་དེའི་ནང་རྒྱ་གར་དང་ཨ་རི་གཉིས་ནས་དཔྱ་ཁྲལ་དངུལ་འབོར་བརྒྱ་ཆ་༡ཙམ་འཕར་ཆ་བྱུང་ཡོད་འདུག་ཅེས་གསལ།",
    "དཔྱ་ཁྲལ་འབུལ་དགོས་མཁན་གྱི་མི་འབོར་༩༦ ཡོད་ཁོངས་ནས་ཕྱི་ལོ་༢༡་༢ ནང་དཔྱ་ཁྲལ་འབུལ་མཁན་མི་འབོར་༨༡༧༤༨ འདུག་པས་རྒྱ་གར་ནང་ཡོད་བོད་མིའི་བརྒྱ་ཆ་༨༥ཙམ་ནས་དཔྱ་ཁྲལ་ཕུལ་འདུག་དེ་བཞིན་བལ་ཡུལ་ལྟ་བུར་ཆ་མཚོན་ན་འདས་པའི་ལོ་ཤས་ནང་བཙན་བྱོལ་བོད་མིའི་གྲངས་འབོར་འཕར་ཆག་ཇི་སྙེད་ཅིག་བྱུང་བར་བརྟེན།",
    "འབོར་༡༤༩༢ ཡོད་འདུག་རྒྱལ་ཁབ་གཞན་ཁག་༨ ནས་དཔྱ་ཁྲལ་འབུལ་མཁན་གྱི་མི་འབོར་གྲངས་༤༡༣ བྱུང་འདུག་མི་འབོར་རོབ་རྩིས་༢༣༡ ཡོད་འདུག་ཅེས་གསལ།",
    "འབྲུག་དང་རྒྱལ་ཁབ་གཞན་ནས་བཞི་ཆའི་གཅིག་ཙམ་ནས་དཔྱ་ཁྲལ་ཕུལ་མི་འདུག་རྒྱུས་ལོན་བྱས་པ་ལྟར་ན།",
    "ཁྲལ་འབབ་ཉུང་བ་ཆགས་འདུག་ཨ་རི་དང་ཡོ་རོབ་སོགས་ཕྱི་རྒྱལ་ཡུལ་ཁག་ཏུ་གནས་སྡོད་བོད་མི་ཚོར་མཚོན་ན།",
    "ཡང་ང་རང་སྒེར་གྱི་དཀའ་ངལ་གྱི་ངོས་ནས་ཆ་བཞག་ནའང་།",
    "དེར་བརྟེན་སྤྱི་འཐུས་འོས་ཁོངས་ནས་རྩ་དགོངས་ཞུས་པ་ཡིན་ཞེས་གསུངས་འདུག་༢་༢༡ ལོའི་ཟླ་༣ ཚེས་༡༥ ཉིན།",
    "ཁོ་རང་རྒྱ་གར་དུ་ཡོང་ནས་ལོ་ངོ་བཅུ་ཙམ་འགོར་བ་དང་།",
    "ད་ཡང་ལོ་གཉིས་འགོར་ཚར་འདུག་ཡིན་ནའང་དེང་སང་ཐའེ་ཝན་འོས་བསྡུའི་དུས་ཚོད་ལ་འཁེལ་ཏེ་ཟིང་ལོང་ཆེ་བ་དང་།",
    "ད་ལྟའི་ཆར་འགྲོ་མི་འགྲོ་དང་ག་དུས་འགྲོ་ཐུབ་མིན་ཐག་གཅོད་བྱས་མེད་ཅེས་གསུངས་བྱུང་།",
    "གསར་བཞེངས་གནང་རྩིས་ཡོད་ལུགས་འདུག་ཀྱང་།",
    "ཕ་ཡུལ་དུའང་ཕེབས་འདུག་ན་ནིང་ཟླ་༩ ནང་།",
    "གང་ཡང་འབྱུང་སྲིད་པའི་ངོས་འཛིན་བྱེད་ཀྱི་འདུག་འབྱུང་སྲིད་པའི་ཆ་དེ་དག་ལས།",
    "ནམ་ཨུ་ཡོན་སོགས་ཆེ་མཐོང་རང་བཞིན་གྱི་མིང་གནས་ཙམ་ལས།",
    "ཁོང་བོད་དུ་ལོག་དགོས་པ་མི་འདུག་ལ།",
    "བོད་ཀྱི་ལས་འགན་ཡང་ཞོར་ལྕོགས་གནང་དགོས་པ་མི་འདུག་བོད་དུ་ལོ་ན་གཞོན་པ་ཚོ་ཡར་སླེབས་ཡོད་པ་དང་།",
    "ཟླ་བ་ག་དུས།",
    "ཁོ་རང་ལ་གནས་ཚུལ་རྒྱུས་ལོན་གྱི་ལམ་ཁ་གཞན་ཡོད་མི་སྲིད།",
    "དེའི་ཁྲོད་ཀྱི་བརྒྱ་ཆའི་༨༢ ཙམ་བོད་མིའི་ཐོག་བཏང་འདུག་༡༩༩ ལོའིསྔོན་རྩིས་སུ།",
    "ཁོ་རང་ཉིན་དེར་ཆམ་པ་ཕོག་འདུག་ཀྱང་ཆེད་བཅར་གྱིས།",
    "ད་ཡང་ལོ་གཉིས་འགོར་ཚར་འདུག་ཡིན་ནའངདེང་སང་ཐའེ་ཝན་འོས་བསྡུའི་དུས་ཚོད་ལ་འཁེལ་ཏེ་ཟིང་ལོང་ཆེ་བ་དང་།",
    "ད་ལྟའི་ཆར་འགྲོ་མི་འགྲོ་དང་ག་དུས་འགྲོ་ཐུབ་མིན་ཐག་གཅོད་བྱས་མེད།",
    "འོ་ན་ང་རང་ཐའེ་ཝན་སྲིད་འཛིན་གྱི་འོས་བསྡུའི་ནང་ཞུགས་ཀྱི་ཡིན།",
    "ང་རང་རྩ་དགོངས་སམ་ལས་ཀ་མ་བྱས་པར་བསྡད་པ་ཡིན་ན།",
    "དཀའ་སྣང་ཅི་ཡང་ཤར་གྱི་མི་འདུག་དེར་བརྟེན།",
    "གོ་སྒྲིག་བྱས་པའི་དུས་བཅད་ཡོལ་ཟིན་འདུག་པས།",
    "དེའི་ཐད་ང་རང་བློ་བདེ་བོ་བྱུང་།",
    "གྲྭ་བ་ཚོ་སྲིད་དོན་ཚོགས་པའི་ནང་འཛུལ་ཞུགས་བྱ་རྒྱུར་ང་རང་ལ་འདོད་བབ་མེད།",
    "དགོས་པ་འདུག་གམ།",
    "རྒྱ་གར་ནས་ཕྱིར་ཐོན་ཚར་འདུག་བལ་ཡུལ་གྱི་རྟེན་གཞི་དེའང་ལོ་བཅུ་ཕྲག་དུ་མའི་རྗེས་ཇེ་ཉུང་དུ་འགྲོ་ངེས།",
    "ཚོགས་པ་ཁོ་རང་ལ་ལོ་ཚད་བཟུང་ཡོད་པ་དང་།",
    "མི་གཞནགྱིས་དེའི་ཐད་འབད་བརྩོན་བྱས་ན་དགག་བྱ་ཡང་བྱེད་ཀྱི་མི་འདུག་༦ཏིན་ཞའོ་ཕིན་བཞུགས་ཡོད་པའི་སྐབས་སུ།",
    "ཕ་ཡུལ་དུའང་ཕེབས་འདུག་ན་ནིང་ཟླ་༩ ནང་།",
    "འདི་ནི་ང་རང་སྒེར་གྱི་བསམ་ཚུལ་ཙམ་ཡིན།",
    "ཧུའུ་ཅིན་ཐའོ་དང་འབྲེལ་བ་མི་འདུག་རྒྱ་ནག་ཏུ་ཡོད་པའི་གྲོགས་པོ་ཁ་ཤས་ཀྱིས་བརྗོད་པ་ལྟར་ན།",
    "འཛམ་གླིང་སྟེང་ཨ་ཧྥེ་རི་ཀའི་རིགས་རྒྱུད་དབྱེ་འབྱེད་ལ་ངོ་རྒོལ་དང་ཝེ་ཏི་ནམ་དམག་འཁྲུག་ལ་ངོ་རྒོལ་སོགས་འཛམ་གླིང་རང་བཞིན་གྱི་ཚོགས་པ་དང་ལས་འགུལ་སྤེལ་མཁན་ཡོད་ནའང་།",
    "དཀའ་སྣང་ཅི་ཡང་ཤར་གྱི་མི་འདུག་དེར་བརྟེན།",
    "རྒྱ་གར་ནས་ཕྱིར་ཐོན་ཚར་འདུག་བལ་ཡུལ་གྱི་རྟེན་གཞི་དེའང་ལོ་བཅུ་ཕྲག་དུ་མའི་རྗེས་ཇེ་ཉུང་དུ་འགྲོ་ངེས།",
    "གསར་བཞེངས་གནང་རྩིས་ཡོད་ལུགས་འདུག་ཀྱང་།",
    "ཕ་ཡུལ་དུའང་ཕེབས་འདུག་ན་ནིང་ཟླ་༩ ནང་།"
  ]
}