    "བུ་མོ་དེ་བག་ཡོད་པས་ཁྱིམ་ན་གནས་པར་ནུས་པ་ཡིན་ནམ་ཞེས་འདྲིའོ།",
    "གལ་ཏེ་རི་དགས་འཛིན་གྱི་བུ་ནག་པོས་འདི་སྐད་ཅེས་བུ་མོ་དེ་ཏེ་པོར་མི་མཁས་པ་དང་ལེ་ལོ་ཅན་དང་སྒྲུབ་མི་ཕོད་པ་དང་།",
    "བུ་མོ་དེ་བག་ཡོད་པས་ཁྱིམ་ན་གནས་པར་མི་ནུས་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་གྱུར་ན་དེས་ན་དེ་དག་བུ་མོ་དེ་སློང་བར་མི་བྱེད་དོ།",
    "གལ་ཏེ་རི་དགས་འཛིན་གྱི་བུ་ནག་པོས་འདི་སྐད་ཅེས་བུ་མོ་དེ་ཏེ་པོར་མཁས་པ་དང་།",
    "བུ་མོ་དེ་བག་ཡོད་པས་ཁྱིམ་ན་གནས་པར་ནུས་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་གྱུར་ན་དེ་དག་བུ་མོ་དེ་སློང་བར་བྱེད་དོ།",
    "རི་དགས་འཛིན་གྱི་བུ་ནག་པོས་དེ་ལྟར་བསྟན་ནས་གང་ཡང་རུང་བ་དག་གི་བུ་མོ་སྦྱིན་ཉེས་པར་གྱུར་ན།",
    "དེ་དག་འདི་སྐད་ཅེས་བདག་ཅག་གིས་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་ལ་དྲིས་ནས་བུ་མོ་བྱིན་ན་ཁྱེའུ་དེ་མི་མཁས་པ་དང་།",
    "ཁྱེའུ་དེ་བུ་མོ་ལ་བཟའ་བ་དང་།",
    "གང་ཡང་རུང་བ་དག་གི་བུ་མོ་སྦྱིན་ལེགས་པར་གྱུར་ན་དེ་དག་འདི་སྐད་ཅེས་བདག་ཅག་གིས་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་ལ་དྲིས་ནས་བུ་མོ་བྱིན་ན་ཁྱེའུ་དེ་མཁས་པ་དང་།",
    "ཁྱེའུ་དེ་བུ་མོ་ལ་བཟའ་བ་དང་།",
    "དེ་བཞིན་དུ་གང་ཡང་རུང་བ་དག་གིས་བུ་མོ་བསླང་ཉེས་པར་གྱུར་ན།",
    "དེ་དག་འདི་སྐད་ཅེས་བདག་ཅག་གིས་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་ལ་དྲིས་ནས་བུ་མོ་བསླང་ན་བུ་མོ་དེ་མི་མཁས་པ་དང་།",
    "བུ་མོ་དེ་བག་ཡོད་པས།",
    "གང་ཡང་རུང་བ་དག་གིས་བུ་མོ་བསླང་ལེགས་པར་གྱུར་ན་དེ་དག་འདི་སྐད་ཅེས་བདག་ཅག་གིས་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་ལ་དྲིས་ནས་བུ་མོ་བསླངས་ན་བུ་མོ་དེ་མཁས་པ་དང་།",
    "བུ་མོ་དེ་བག་ཡོད་པས་ཁྱིམ་ན་གནས་པར་ནུས་པ་ཡིན་པས་གང་དག་ལ་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་གཏམ་འདྲེས་པ།",
    "དེ་དེ་ལྟར་རབ་ཏུ་བྱུང་ནས་ཀྱང་མཉན་ཡོད་པའི་བྲམ་ཟེ་དང་ཁྱིམ་བདག་རྣམས་དང་སྔོན་བཤེས་པ་ཉིད་ཀྱིས་དེ་དག་གི་གཏམ་འདྲེ་བ།",
    "ཁྱིམ་དུ་འཇུག་པར་བྱེད་པ་ཡིན་པས་གང་ཡང་རུང་བ་དག་ལ་བུ་མོ་སྦྱིན་པར་བྱ་བ་ཡོད་པ་དེ་དག་ཀྱང་རི་དགས་འཛིན་གྱི་བུ་ནག་པོའི་གན་དུ་སོང་སྟེ།",
    "འདི་སྐད་ཅེས་འཕགས་པ་ཁྱོད་ཀྱིས་ཁྱིམ་ཆེ་གེ་མོ་ཞིག་མཁྱེན་ཏམ།",
    "ཁྱེའུ་དེ་བུ་མོ་ལ་བཟའ་བ་དང་།",
    "ཁྱེའུ་དེ་བུ་མོ་ལ་བཟའ་བ་དང་།",
    "ལས་ཆེ་བ་ཡིན་ནོ་ཞེས་བསྟན་པར་གྱུར་ན་དེས་ན་དེ་དག་བུ་མོ་དེ་ཁྱེའུ་དེ་ལ་སྦྱིན་པ་མི་བྱེད་དོ།",
    "ཁྱེའུ་དེ་བུ་མོ་ལ་བཟའ་བ་དང་།",
    "ལས་ཆུང་བ་ཡིན་ནོ་ཞེས་བསྟན་པར་གྱུར་ན་དེས་ན་དེ་དག་བུ་མོ་དེ་ཁྱེའུ་དེ་ལ་སྦྱིན་པར་བྱེད་དོ།",
    "གང་ཡང་རུང་བ་དག་བུ་མོ་སློང་བར་བྱེད་པ་དེ་དག་ཀྱང་རི་དགས་འཛིན་གྱི་བུ་ནག་པོའི་གན་དུ་སོང་སྟེ་འདི་སྐད་ཅེས་འཕགས་པ་ཁྱོད་ཀྱིས་ཁྱིམ་ཆེ་གེ་མོ་ཞིག་མཁྱེན་ཏམ་ཞེས་འདྲིའོ།",
    "དེ་དག་དེ་ལ་འཕགས་པ་ཇི་ལྟ་དེ་ན་བུ་མོ་དེ་མཁས་པ་དང་།",
    "བུ་མོ་དེ་བག་ཡོད་པས་ཁྱིམ་ན་གནས་པར་རྔོ་ཐོག་པ་ལགས་སམ་ཞེས་འདྲིའོ།",
    "གལ་ཏེ་རི་དགས་འཛིན་གྱི་བུ་ནག་པོས་འདི་སྐད་ཅེས་བཞིན་བཟངས་དག་བུ་མོ་དེ་ཏེ་པོར་མི་མཁས་པ་དང་།",
    "བུ་མོ་དེ་བག་ཡོད་པས་ཁྱིམ་ན་གནས་པར་མི་ནུས་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་གྱུར་ན།",
    "དེས་ན་དེ་དག་བུ་མོ་དེ་སློང་བར་མི་བྱེད་དོ།",
    "གལ་ཏེ་རི་དགས་འཛིན་གྱི་བུ་ནག་པོས་འདི་སྐད་ཅེས་བཞིན་བཟངས་དག་བུ་མོ་དེ་ཏེ་པོར་མཁས་པ་དང་།",
    "བུ་མོ་དེ་བག་ཡོད་པས་ཁྱིམ་ན་གནས་པར་ནུས་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་གྱུར་ན་དེས་ན་དེ་དག་བུ་མོ་དེ་སློང་བར་བྱེད་དོ།",
    "རི་དགས་འཛིན་གྱི་བུ་ནག་པོས་དེ་ལྟར་བསྟན་ནས་གང་ཡང་རུང་བ་དག་གི་བུ་མོ་སྦྱིན་ཉེས་པར་གྱུར་ན་དེ་དག་འདི་སྐད་ཅེས་བདག་ཅག་གིས་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་ལ་དྲིས་ནས་བུ་མོ་བྱིན་ན་ཁྱེའུ་དེ་མི་མཁས་པ་དང་།",
    "ཁྱེའུ་དེ་བུ་མོ་ལ་བཟའ་བ་དང་།",
    "གང་ཡང་རུང་བ་དག་གི་བུ་མོ་སྦྱིན་ལེགས་པར་གྱུར་ན་དེ་དག་འདི་སྐད་ཅེས་བདག་ཅག་གིས་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་ལ་དྲིས་ནས་བུ་མོ་སྦྱིན་ན་ཁྱེའུ་དེ་མཁས་པ་དང་།",
    "ཁྱེའུ་དེ་བུ་མོ་ལ་བཟའ་བ་དང་།",
    "དེ་བཞིན་དུ་གང་ཡང་རུང་བ་དག་གིས་བུ་མོ་བསླང་ཉེས་པར་གྱུར་ན་དེ་དག་འདི་སྐད་ཅེས་བདག་ཅག་གིས་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་ལ་དྲིས་ནས་བུ་མོ་དེ་བསླངས་ན་བུ་མོ་དེ་མི་མཁས་པ་དང་།",
    "བུ་མོ་དེ་བག་ཡོད་པས་ཁྱིམ་ན་གནས་པར་མི་ནུས་པ་ཡིན་པས་གང་དག་ལ་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་གཏམ་འདྲེ་བ།",
    "གང་ཡང་རུང་བ་དག་གི་བུ་མོ་བསླང་ལེགས་པར་གྱུར་ན་དེ་དག་འདི་སྐད་ཅེས་བདག་ཅག་གིས་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་ལ་དྲིས་ནས་བུ་མོ་བསླངས་ན་བུ་མོ་དེ་མཁས་པ་དང་།",
    "བུ་མོ་དེ་བག་ཡོད་པས་ཁྱིམ་ན་གནས་པར་ནུས་པ་ཡིན་པས་གང་དག་ལ་རི་དགས་འཛིན་གྱི་བུ་ནག་པོ་གཏམ་འདྲེ་བ།",
    "སྐྱེས་པ་ལ་བུད་མེད་ཀྱི་ཚིག་གིས་ཆུང་མ་ཉིད་དམ།",
    "མཛའ་ན་མོ་ཉིད་དུ་སྨྱན་བྱེད་ན་མུ་སྟེགས་ཅན་དག་ཤེས་ལྡན་དག་ཤཱཀྱའི་བུའི་དགེ་སྦྱོང་འདི་དག་ནི་བུད་མེད་ལ་སྐྱེས་པའི་ཚིག་དང་།",
    "སྐྱེས་པ་ལ་བུད་མེད་ཀྱི་ཚིག་གིས་ཆུང་མ་ཉིད་དང་།",
    "མཛའ་ན་མོ་ཉིད་དུ་སྨྱན་བྱེད་དེ།",
    "ཁྱིམ་བདག་བསླབ་པའི་གཞི་ཡང་དག་པར་མ་བླངས་པ་གཞན་དག་ཀྱང་བུད་མེད་ལ་སྐྱེས་པའི་ཚིག་དང་།",
    "སྐྱེས་པ་ལ་བུད་མེད་ཀྱི་ཚིག་གིས་ཆུང་མ་ཉིད་དམ།",
    "མཛའ་ན་མོ་ཉིད་དུ་སྨྱན་བྱེད་ན།",
    "དགེ་སྦྱོང་མགོ་རེག་འདི་དག་ལ་སུ་ཞིག་བསོད་སྙོམས་སྦྱིན་པ་དང་བྱ་བར་སེམས་ཤེས་སྨོད་པར་བྱེད།",
    "ཡང་དགེ་སློང་གང་བུད་མེད་ལ་སྐྱེས་པའི་ཚིག་དང་།",
    "སྐྱེས་པ་ལ་བུད་མེད་ཀྱི་ཚིག་གིས་ཆུང་མ་ཉིད་དམ།",
    "བུད་མེད་ལ་སྐྱེས་པའི་ཚིག་དང་ཞེས་བྱ་བ་ནི་སྐྱེས་པའི་ཀུན་ཏུ་སྤྱད་པའི་བསམ་པའི་ཚིག་གང་ཡིན་པ་དེ་བུད་མེད་ལ་བརྗོད་པར་བྱེད་པས་སོ།",
    "སྐྱེས་པ་ལ་བུད་མེད་གྱི་ཚིག་གིས་ཤེས་བྱ་བ་ནི་བུད་མེད་ཀྱི་ཀུན་དུ་སྤྱད་པའི་བསམ་པའི་ཚིག་གང་ཡིན་པ་དེ་སྐྱེས་པ་ལ་རྗོད་པར་བྱེད་པས་སོ།",
    "ཆུང་མ་ཉིད་དམ་མཛའ་ན་མོ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་ཆུང་མ་བདུན་དང་།",
    "མཛའ་ན་མོ་བཅུ་ཉིད་དུའོ།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་ཕ་མ་དག་གིས་སྐྱེས་པ་ལ་བྱིན་ནས།",
    "ཁྱོད་ཀྱི་ཆུང་མ་སྐྱེ་དགུའི་བདག་མོ་བྱོས་ཤིག་ཅེས་ཆུ་ཚིགས་ཀྱིས་བྱིན་ཞིང་དེ་དེའི་ཆུང་མ་སྐྱེ་དགུའི་བདག་མོར་གྱུར་ནས།",
    "དེས་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱོད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པ་ཤིན་དུ་བསྲུངས་པ།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་སྐྱེས་པས་འདི་དག་གི་ཆུང་མ་སྐྱེ་དགུའི་བདག་མོ་བྱའོ་ཞེས་ཕ་མ་དག་ལས་རིན་ཆས་ཉོས་ཤིང་དེ་དེའི་ཆུང་མ་སྐྱེ་དགུའི་བདག་མོར་གྱུར་ནས་དེས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱོད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པ་ཤིན་དུ་བསྲུངས་པ།",
    "ཕ་རོལ་གྱི་ཡུལ་དུ་སོང་ནས་མ་ཕེབས་པ་ཕབ་ཅིང་།",
    "ཕེབས་པར་གནས་ནས་ཐོབ་རྒྱལ་དུ་སྒྲོགས་པར་བྱེད་པའི་ཚེ་དེ་ན་སྐྱེས་པས་རྒྱལ་པོ་རྒྱལ་མཚན་དུ་བྱས་ནས་བུད་མེད་དམ་གཞོན་ནུ་མ་གང་ཡིན་པ་འདི་བདག་གི་ཆུང་མ་སྐྱེ་དགུའི་བདག་མོ་བྱའོ་ཞེས་ཕྲོགས་ཤིང་དེ་དེའི་ཆུང་མ་སྐྱེ་དགུའི་བདག་མོར་གྱུར་ནས་དེས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱོད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པས་ཤིན་དུ་བསྲུངས་པ།",
    "ཆོམ་རྐུན་པ་དག་གིས་གྲོང་གཞོམ་པ་འམ།",
    "རང་གི་མགོ་རྒྱལ་མཚན་དུ་བྱས་ནས།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་འདི་བདག་གི་ཆུང་མ་སྐྱེ་དགུའི་བདག་མོ་བྱའོ་ཞེས་ཕྲོགས་ཤིང་དེ་དེའི་ཆུང་མ་སྐྱེ་དགུའི་བདག་མོར་གྱུར་ནས།",
    "དེས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་རང་གི་དད་པ་དང་།",
    "འདི་སྐད་ཅེས་རྗེའི་སྲས་ཚུར་སྤྱོན་ཁྱོད་བདག་གི་ཁྱིམ་ཐབ་མཛོད་ཅིག་དང་བདག་གིས་ཁྱོད་ཀྱི་བཙུན་མོ་སྐྱེ་དགུའི་བདག་མོ་བགྱིའོ་ཞེས་ཟེར་ཞིང་དེ་དེའི་ཆུང་མ་སྐྱེ་དགུའི་བདག་མོར་གྱུར་ནས་དེས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱོད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པ་ཤིན་དུ་བསྲུངས་པ།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་སྐྱེས་པའི་གན་དུ་འོངས་ཏེ་འདི་སྐད་ཅེས་རྗེའི་སྲས་ཚུར་སྤྱོན།",
    "ཁྱོད་ཀྱིས་བདག་ལ་གོས་དང་ཟས་སྩོལ་ཅིག་དང་།",
    "བདག་གིས་ཁྱོད་ཀྱིས་བཙུན་མོ་སྐྱེ་དགུའི་བདག་མོ་བགྱིའོ།",
    "ཞེས་ཟེར་ཞིང་དེ་དེའི་ཆུང་མ་སྐྱེ་དགུའི་བདག་མོར་གྱུར་ནས་དེས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱོད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པ་ཤིན་དུ་བསྲུངས་པ།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་སྐྱེས་པའི་གན་དུ་འོངས་ཏེ་འདི་སྐད་ཅེས་རྗེའི་སྲས་ཚུར་སྤྱོན།",
    "ཁྱོད་ཀྱི་ནོར་གང་ལགས་པ་དེ་དང་བདག་གི་ནོར་གང་ལགས་པ་དེ་དག་གཅིག་ཏུ་བསྡུས་ཏེ།",
    "བུ་མོ་གང་དག་མཆིས་པར་འགྱུར་བ་དེ་དག་ཀྱང་བདག་ཅག་ཤི་ཞིང་དུས་ལ་བབ་པ་དག་ལ་ཉུང་ངུ་འམ།",
    "དེས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱོད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པ་ཤིན་དུ་བསྲུངས་པ།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་སྐྱེས་པས་དེང་བདག་འདི་དང་ལྷན་ཅིག་དགའ་མགུར་སྤྱད་པར་བྱའོ་སྙམ་ནས་དེའི་དུས་སུ་གླས་ཤིང་ཡུད་ཙམ་ཕྲད་པར་གྱུར་ནས་དེས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པ་ཤིན་དུ་བསྲུངས་པ།",
    "མཛའ་ན་མོ་བཅུ་གང་ཞེ་ན།",
    "ཕུ་ནུ་མོས་བསྲུངས་པ་དང་།",
    "སྒྱུག་མོས་བསྲུངས་པ་དང་།",
    "དེ་ལ་མས་བསྲུངས་པའི་མཛའ་ན་མོ་གང་ཞེ་ན།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་གི་ཁྱིམ་ཐབ་ཤི་ཞིང་དུས་ལ་བབ་པར་གྱུར་ཏམ།",
    "ཚོར་བ་དག་གིས་ཉེན་པར་གྱུར་ནས།",
    "དེ་མའི་གན་ན་གནས་ཤིང་མས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱོད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པ་ཤིན་དུ་བསྲུངས་པ།",
    "དེ་ནི་མས་བསྲུངས་པའི་མཛའ་ན་མོ་ཞེས་བྱའོ།",
    "ཕས་བསྲུངས་པའི་མཛའ་ན་མོ་གང་ཞེ་ན།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་གི་ཁྱིམ་ཐབ་ཤི་ཞིང་དུས་ལ་བབ་པར་གྱུར་ཏམ།",
    "ཚོར་བ་དག་གིས་ཉེན་པར་གྱུར་ནས།",
    "དེའི་ཕའི་གན་ན་གནས་ཤིང་ཕས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱོད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པ་ཤིན་དུ་བསྲུངས་པ།",
    "དེ་ནི་ཕས་བསྲུངས་པའི་མཛའ་ན་མོ་ཞེས་བྱའོ།",
    "མིང་པོས་བསྲུངས་པའི་མཛའ་ན་མོ་གང་ཞེ་ན།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་གི་ཕ་མ་དང་།",
    "ཚོར་བ་དག་གིས་ཉེན་པར་གྱུར་ནས།",
    "དེ་མིང་པོའི་གན་ན་གནས་ཤིང་མིང་པོས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱོད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པ་ཤིན་ཏུ་བསྲུངས་པ།",
    "དེ་ནི་མིང་པོས་བསྲུངས་པའི་མཛའ་ན་མོ་ཞེས་བྱའོ།",
    "ཕུ་ནུ་མོས་བསྲུངས་པའི་མཛའ་ན་མོ་གང་ཞེ་ན།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་གི་ཕ་མ་དང་།",
    "ཚོར་བ་དག་གིས་ཉེན་པར་གྱུར་ནས།",
    "དེ་ཕུ་ནུ་མོའི་གན་ན་གནས་ཤིང་ཕུ་ནུ་མོས་དེ་འདི་ལ་གཞན་དག་འདོད་པ་དག་གི་ཕྱིར་སྤྱོད་པར་མ་གྱུར་ཅིག་ཅེས་བསྲུངས་པ་ཤིན་དུ་བསྲུངས་པ།",
    "དེ་ནི་ཕུ་ནུ་མོས་བསྲུངས་པའི་མཛའ་ན་མོ་ཞེས་བྱའོ།",
    "སྒྱུག་མོས་བསྲུངས་པའི་མཛའ་ན་མོ་གང་ཞེ་ན།",
    "བུད་མེད་དམ་གཞོན་ནུ་མ་གང་གི་ཕ་མ་དང་ཁྱིམ་ཐབ་ཤི་ཞིང་དུས་ལ་བབ་པར་གྱུར་ཏམ།",
    "ཚོར་བ་དག་གིས་ཉེན་པར་གྱུར་ནས།",
    "དེ་སྒྱུག་མོའི་གན་ན་གནས་ཤིང་།",
    "སྒྱུག་མོས་དེ་ལ་འདི་སྐད་ཅེས་ཁོ་མོའི་བུ་མཐོང་བ་གང་ཡིན་པ་དེ་ནི་ཁྱོད་མཐོང་བ་ཡིན་ལ།",
    "ཁྱོད་མཐོང་བ་གང་ཡིན་པ་དེ་ཡང་ཁོ་མོའི་བུ་མཐོང་བ་ཡིན་པས་ཁོ་མོའི་ཟས་དང་།",
