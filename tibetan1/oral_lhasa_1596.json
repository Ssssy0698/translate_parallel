    "གོང་མ་གོང་མའི་འབྲས་བུའི་ལྕིད་མི་རྟོགས་ན་ལྕིད་དེ་རྒྱུའི་ཡིན་པར་འགྱུར་རོ།",
    "དེ་དང་ཞིག་པར་གྱུར་ཀྱང་ནི།",
    "ཡན་ལག་ཅན་ནི་མཐོང་བ་མ་ཡིན་གྱི་འོན་ཀྱང་དེ་ནི་འབྲས་བུ་མཐོང་བ་ཉིད་ཡོད་པས་ཡོད་པར་རྣམ་པར་གཞག་པར་བྱ་བ་ཡིན་ནོ།",
    "འོ་ན་ཇི་ལྟར་སྲང་དམའ་བའི་ཁྱད་པར་མི་འཛིན་པའི་ཕྱིར་རོ་ཞེས་སློབ་དཔོན་གྱིས་དངོས་པོར་ངེས་པ་ཉིད་བརྗོད་ཅེ་ན།",
    "དམའ་བ་དེ་འབའ་ཞིག་བརྗོད་པ་ཡིན་ཡང་གཞན་དག་ཀྱང་སྟོན་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཅི་ལྟར་ཐམས་ཅད་མི་རྟོགས་པ་ཞེས་བྱ་བར་ཤེས་པར་བྱ་ཞེ་ན།",
    "འདི་ལ་ཤེས་པར་བྱ་བ་ཅི་ཞིག་ཡོད།",
    "ཡན་ལག་ཅན་གྱི་གནོད་པར་བྱེད་པའི་རིགས་པས་བསྟན་པ་ནི་འདི་ལས་གཞན་སློབ་དཔོན་གྱིས་གསུངས་པའི་དཔེར་བརྗོད་པ་དག་ཀྱང་རྟོགས་པར་བྱ་བ་ཡིན་ནོ།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བ་བསྟན་པའི་ཕྱོགས་དེ་དམ་བཅའ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རིགས་པ་ཅན་རྣམས་ཀྱི་ཕྱོགས་ཀྱི་ཡིན་ཏེ།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བར་གྱུར་པའི་ཕྱིར་བསྒྲུབ་བྱ་མ་ཡིན་ནམ།",
    "མ་གྲུབ་པའི་གཏན་ཚིགས་དང་དཔེ་དག་ནི་བསྒྲུབ་པར་བྱ་བར་འགྱུར་བ་ཡིན་པས་ན།",
    "གལ་ཏེ་ད་ལྟར་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཞེས་བྱ་བར་འགྲུབ་ན།",
    "དེས་ན་ཕྱིས་བསྒྲུབ་པར་བྱ་བར་འགྱུར་བ་བསྒྲུབ་བྱར་འགྱུར་རོ།",
    "ཅི་ལྟར་ཕྱིས་བསྒྲུབ་པར་བྱ་བ་འདི་ཉིད་དུ་འགྱུར་ཞེ་ན།",
    "དེའི་ཚེ་དེ་ལྟ་བུའི་བདག་ཉིད་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར་རོ།",
    "དེའི་ཚེ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་ཉེ་བར་བསྟན་པས་ན།",
    "དེའི་ཚེ་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "མ་གྲུབ་པ་ནི་གཞན་ལ་སྒྲུབ་པར་བྱེད་པར་ཡང་མི་འགྱུར་ཏེ་དེས་ན་དེ་ཕྱི་ནས་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་ནོ།",
    "དེས་ན་ཕྱིས་ཀྱི་ཚེ་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བསྟན་པར་བྱ་བ་དེ་དམ་བཅའ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་འདི་ཤེས་པར་བྱེད་པའི་སྐབས་མ་ཡིན་ན་འདིར་བདེན་པ་ཞིག་ན།",
    "ཐམས་ཅད་རྟོགས་པར་བྱེད་པ་ཡིན།",
    "དེའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བའི་སྒྲ།",
    "འདོད་པའི་ཁྱད་པར་ལ་བརྟེན་མིན།",
    "ཤེས་པར་བྱེད་པའི་སྐབས་ཀྱིས་གསལ་བར་བྱ་བ་བྱེད་པ་པོ་ལ་ལྟོས་པའི་བསྒྲུབ་པར་བྱ་བ་ལ་གཞན་པའི་བསྒྲུབ་པར་བྱ་བ་ཐམས་ཅད་བསྒྲུབ་པར་བྱ་བའི་སྒྲས་སྡུད་པར་བྱེད་པ་ཉིད་དོ།",
    "དེས་ན་བསྒྲུབ་པར་བྱ་བ་གཞན་རྣམ་པར་གཅོད་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "བྱེད་པ་པོའི་བསྒྲུབ་པར་བྱ་བ་རྣམ་པར་གཅོད་པ་ནི་ཤེས་པར་བྱེད་པའི་གཏན་ཚིགས་ཀྱི་སྐབས་ཡིན་པའི་ཕྱིར་རོ།",
    "དེས་ན་བསྒྲུབ་བྱའི་སྒྲ་ནི་འདོད་པའི་ཁྱད་པར་ལ་བརྟེན་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "བྱེད་པ་པོའི་བསྒྲུབ་པར་བྱ་བ་ལས་བཟློག་པ་ནི་ཤེས་པར་བྱེད་པའི་སྐབས་ཡིན་པའི་ཕྱིར་དེ་དང་མཚུངས་པ་མ་ཡིན་ནོ།",
    "མ་གྲུབ་དཔེར་ནི་བྱས་པ་ཡིན།",
    "སྒྲ་ནི་མི་རྟག་པ་སྟེ་བྱས་པའི་ཕྱིར་བུམ་པ་བཞིན་ནོ་ཞེས་གྲངས་ཅན་ལ་ལྟོས་ནས་སམ།",
    "གལ་ཏེ་སྐབས་ལ་མ་ལྟོས་པར་དམ་བཅའ་བའི་མཚན་ཉིད་བྱས་པ་ཡིན་ལ།",
    "འོན་ཀྱང་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་བསྟན་ཏེ།",
    "ལས་ཀྱང་བྱེད་པ་པོའི་ཕུགས་འདོད་ལས་ཡིན་ནོ་ཞེས་བྱ་བས་གང་ལ་ཁྱད་པར་དུ་འཕགས་པ་ཡོད་པའི་ཁྱད་པར་ཅན་ཡིན་ནོ།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་འདོད་པ་ནི་བྱེད་པ་ཡིན་པའི་ཕྱིར་ཕུགས་འདོད་མ་ཡིན་ནོ།",
    "བྱེད་པ་ཉིད་དུ་བརྗོད་པར་འདོད་པས་ན་ལས་ཉིད་མ་ཡིན་པ་བཞིན་ནོ།",
    "དེ་བཞིན་དུ་འདོད་པར་གྱུར་པ་ལས་ཡིན་གྱི་འདོད་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "གཞན་ཡང་མཚོན་པར་བྱ་བ་ཉིད་ཀྱི་སྐབས་སུ་བབ་པར་འགྱུར་བའི་ཡན་ལག་ལྔ་པོ་དག་ལས།",
    "སྒྲུབ་པར་བྱེད་པར་འགྱུར་བ་མ་ཡིན་པའི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་དམ་བཅའ་བ་ཡིན་ནོ་ཞེས་རྟོགས་པར་འགྱུར་རོ།",
    "ཁས་བླངས་པའི་གྲུབ་པའི་མཐའི་མཚན་ཉིད་ཀྱི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་དམ་བཅའ་བ་ཡིན་པར་རྟོགས་པའི་ཕྱིར།",
    "ཁྱད་པར་ཉེ་བར་བཀོད་པ་ཡི།",
    "དེ་གཏན་ཚིགས་ཉིད་དུ་ཁས་བླངས་ཀྱང་བསྒྲུབ་པར་བྱ་བ་གདོན་མི་ཟ་བར་ཁས་ལེན་པར་འགྱུར་བ་ཡིན་ཏེ།",
    "འོན་ཏེ་བསྒྲུབ་པར་བྱ་བ་དང་སྒྲུབ་པར་བྱེད་པའི་མཚན་ཉིད་ཀྱི་སྐབས་སུ་སྒྲུབ་པར་བྱེད་པའི་མཚན་ཉིད་སྤངས་པས་བསྒྲུབ་བྱ་ཉེ་བར་བསྟན་པ་དམ་བཅའ་བ་ཡིན་པའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་ཉིད་དམ་བཅའ་བ་ཡིན་གྱི།",
    "སྒྲུབ་པར་བྱེད་པར་བསྟན་པ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེས་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ནི་དམ་བཅའ་བ་ཞེས་བྱ་བས་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཐམས་ཅད་དམ་བཅའ་བར་འགྱུར་ཏེ།",
    "དེ་ལས་མ་གཏོགས་པ་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཡིན་པར་འགྱུར་རོ།",
    "ཡང་ན་སྒྲུབ་པར་བྱེད་པའི་བསྟན་པ་ལས་མ་གཏོགས་པའི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་དམ་བཅའ་བ་ཉིད་དོ་ཞེས་བྱ་བའི་རྣམ་པར་དབྱེ་བ་འདི་བྱ་བར་ཇི་ལྟར་ནུས།",
    "འདི་ལ་ལན་དུ་འཆད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བར་ཞེས་ལས་ལ་བྱ་རྐྱེན་མ་ཡིན་ནམ།",
    "ཐབས་ཉིད་དུ་འདོད་པ་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་མ་ཡིན་པས་དེ་ཅི་ལྟར་དེ་བསྒྲུབ་བྱ་ཉིད་དུ་འགྱུར་ཞེ་ན།",
    "འདི་ནི་མེད་དེ་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཐབས་ཉིད་ཀྱིས་བསྒྲུབ་བྱ་ཉིད་དུ་འདོད་པའི་ཕུགས་ཡིན་པའི་ཕྱིར་རོ།",
    "འདིར་ཁྱད་པར་དུ་འཕགས་པའི་རྐྱེན་ནི་ཁས་བླངས་པ་ཡང་མ་ཡིན་ནོ།",
    "ཁ་ཅིག་ནི་སྦྱོར་བའི་རྣམ་པར་དབྱེ་བ་ཁས་ལེན་པའི་ཕྱིར་ཏེ།",
    "དེས་ན་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ནི་དམ་བཅའ་བའོ་ཞེས་བྱ་བ་འདི་ནི་མི་རུང་ངོ།",
    "གལ་ཏེ་ཚོགས་པ་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ནམ།",
    "གཉིས་པོ་ཕན་ཚུན་ཁྱད་པར་ཅན།",
    "འདི་ནི་ཚོགས་པ་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་ན་མི་འབྱོར་པར་འགྱུར་རོ།",
    "འདི་ལྟར་ཚོགས་པ་ནི་ཚོགས་པ་ཅན་ལས་ཐ་དད་པ་མ་ཡིན་པའི་ཕྱིར་གཉིས་པོ་དེ་ཉིད་བསྒྲུབ་པར་བྱ་བར་འགྱུར་རོ།",
    "བསྟན་བཅོས་ཅི་བྱ་ཅི་རིགས་པར།",
    "རང་ཉིད་འཇུག་པར་འགྱུར་བ་ཡིན།",
    "ཅི་ལྟར་ཉེ་བར་བརྗོད་པའི་མཚན་ཉིད་དོན་ལ་མི་སྲིད་པའི་ཕྱིར་གཞན་དུ་བརྗོད་པར་བྱ་བ་དེ་བཞིན་དུ།",
    "གཏན་ཚིགས་ལ་སོགས་པའི་རང་བཞིན་ཡང་ཅི་ལྟར་གོ་བར་བྱེད་པར་འགྱུར་བ་གཞན་དུ་རྟག་པར་འགྱུར་རོ་དེ་བཞིན་དུ་དཔེའི་མཚན་ཉིད་ཀྱང་ཡིན་པས་ན་བསྟན་བཅོས་དོན་མེད་དོ།",
    "ཤེས་པར་འདོད་པའི་ཁྱད་པར་ཅན།",
    "འདི་ཤེས་པར་འདོད་པའི་ཁྱད་པར་ཅན་མ་ཡིན་པའི་ཕྱིར།",
    "གལ་ཏེ་གྲུབ་ན་ནི་ཇི་ལྟར་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པ་ཡིན།",
    "འདིར་རྩོད་པར་བྱེད་དེ།",
    "མ་ཡིན་ཏེ་གྲུབ་པ་དང་གསལ་བ་ཙམ་བཟློག་པར་འདོད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་གལ་ཏེ་རས་ཡུག་ཆེན་ཡིན་ན་བཏག་པར་བྱ་བ་མ་ཡིན་ལ།",
    "གལ་ཏེ་བཏག་པར་བྱ་བ་ཡིན་ན་རས་ཡུག་ཆེན་མ་ཡིན་ཏེ།",
    "རས་ཡུག་ཆེན་ཡང་ཡིན་ལ་བཏག་པར་བྱ་བ་ཡང་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འགལ་ལོ།",
    "དེ་ལ་སྨྲ་བ་པོའི་བསམ་པ་ནི་འདི་ཡིན་ཏེ་རས་ཡུག་ཆེན་དུ་འགྱུར་བ་འདི་བཏག་པར་བྱའོ་ཞེས་བྱ་བའོ།",
    "ཅི་ལྟ་བུར་ན་སྐུད་པར་བྱེད།",
    "གཞན་གྱིས་ཀར་ཀ་ཏི་ཀ་ཟོས་པས་གཞན་གྱི་སྣ་གཅོད་པར་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "ཆའི་སྒྲ་སྤྱིར་རྗོད་པར་བྱེད་པ་ཡིན་ཡང་།",
    "དེས་ན་ཕྱོགས་ཀྱི་སྒྲ་ནི་སྤྱི་རྗོད་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "གཞན་ཡང་འདི་ནི་བརྗོད་པ་འདོད་པ་རྗེས་སུ་གནང་བ་ཞེས་བྱ་བ་ཚར་གཅད་པའི་གནས་ཡིན་ནོ།",
    "ཁྱེད་ལ་ནི་དེ་ལྟ་མ་ཡིན་པའི་ཕྱིར་ཉེ་བར་བཏགས་པར་མི་རིགས་སོ།",
    "དངོས་སྲིད་གཞན་དུ་ཉེ་བར་བཏགས་པར་རྟོགས་པ་ནི་མ་ཡིན་ནོ།",
    "གཞན་ཡང་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ནི་ཕྱོགས་སོ་ཞེས་བྱ་བ་འདིར་སྔར་ངེས་པར་གཟུང་བར་འགྱུར་རམ།",
    "འོན་ཏེ་ཕྱིས་ངེས་པར་གཟུང་།",
    "བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ཉིད་དམ་བཅའ་བ་ཡིན་གྱི་སྒྲུབ་པར་བྱེད་པ་བསྟན་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "ཡང་ན་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ནི་དམ་བཅའ་བ་ཉིད་ཡིན་གྱི་གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བར་འགྱུར།",
    "གང་གལ་ཏེ་སྔར་ངེས་པར་བཟུང་ན་ནི་དོན་མེད་པར་འགྱུར་ཏེ།",
    "དེས་བཟློག་པར་བྱ་བ་གཏན་ཚིགས་བསྟན་པ་དམ་བཅའ་བ་ཉིད་ཡིན་པ་ནི་ཁྱད་པར་སྒྲུབ་པར་བྱེད་པ་གཏན་ཚིགས་ཀྱི་མཚན་ཉིད་དང་དཔེའི་མཚན་ཉིད་ཀྱིས་བཀག་པའི་ཕྱིར་ཏེ།",
    "ཕྱིས་ངེས་པར་འཛིན་ན་ནི།",
    "བསྒྲུབ་པར་བྱ་བའི་གཏན་ཚིགས་དང་།",
    "དཔེ་བསྟན་པ་ཡང་དམ་བཅའ་བ་ཉིད་དུ་འགྱུར་བས་མི་འདོད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་བསྒྲུབ་པར་བྱ་བ་ཉིད་བསྟན་པ་དམ་བཅའ་བ་ཡིན་གྱི།",
    "གྲུབ་པ་བསྟན་པ་ནི་མ་ཡིན་ནོ་ཞེས་པར་བཟུང་ན་སྐྱོན་ཅི་ཡོད།",
    "སྒྲུབ་པར་བྱེད་པ་ཐམས་ཅད་ནི་མ་གྲུབ་པ་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་ཉེ་བར་ལེན་པ་ཡིན་ནོ།",
    "བཟློག་པའི་དོན་དུ་ནི་ངེས་པར་བཟུང་བ་མ་ཡིན་ནོ།",
    "སྒྲུབ་པར་བྱེད་པ་དོགས་པའང་མེད།",
    "འདི་སྙམ་དུ་བསྒྲུབ་བྱ་ཉིད་དུ་བསྟན་པ་དམ་བཅའ་བ་ཞེས་སྔར་ངེས་པར་གཟུང་བས་ན།",
    "སྒྲའི་བྱ་བ་ལ་ལྟོས་ཏེ་མ་གྲུབ་པ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་གསལ་བའི་དོན་ཡིན་ཏེ།",
    "གཏན་ཚིགས་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱིས་ཁྱབ་པའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་ལ་ནི་དགོས་པ་མ་ཡིན་ནོ།",
    "ཅི་ལྟར་སྒྲའི་བྱེད་པ་ལ་ལྟོས་ཏེ་མ་གྲུབ་པ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པ་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཁོ་ནར་བསྟན་པ་ཞེས་བྱ་བས་སྤངས་པ་དེ་བཞིན་དུ་དཔེ་བརྗོད་པའི་ཤུགས་ཀྱིས་བསྒྲུབ་བྱ་སྒྲུབ་པར་བྱེད་པ་ནི་གཏན་ཚིགས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་མཚན་ཉིད་ཀྱིས།",
    "ཁྱབ་པའི་འབྲས་ཅན་ཡིན་པར་རྟོགས།",
    "སྔར་ངེས་པར་བཟུང་ན་དོན་མེད་པར་འགྱུར་བས་ན།",
    "འོས་མེད་པར་ཕྱི་མར་ངེས་པར་གཟུང་བ་ཡིན་ལ་དེ་ཡང་ཁྱབ་པའི་འབྲས་བུ་ཅན་ཡིན་ནོ།",
    "འདི་ལྟར་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ནི་དམ་བཅའ་བ་ཁོ་ནའོ་ཞེས་བྱ་བས་གལ་ཏེ་མཚན་ཉིད་གཞན་གྱིས་ཁྱབ་པ་ཉིད་ཡིན་པ་དེ་ལྟ་ན་ཡང་།",
    "རབ་ཏུ་སྒྲུབ་པར་བྱེད་མ་ཡིན།",
    "གཏན་ཚིགས་འདིས་བསྒྲུབ་པར་བྱ་བའི་དོན་བསྒྲུབ་པ་ནི་མ་ཡིན་ནོ།",
    "དེས་ན་འདི་ནི་ཕྱིས་ངེས་པར་གཟུང་བ་ཉིད་དོ།",
    "དེ་ལྟ་ཡིན་དང་མ་འབྲེལ་པའི་རྣམ་པར་བཅད་པའི་ཕྱིར་ཇི་སྙེད་དམ་བཅའ་བ་ཉིད་དུ་མི་འགྱུར་བ་དེ་ཐམས་ཅད་སེལ་བར་བྱེད་པ་ཡིན་ཏེ།",
    "དམ་བཅའ་བ་ཁོ་ནའི་དམ་བཅའ་བ་མ་ཡིན་པ་ནི་མ་ཡིན་ནོ་ཞེས་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཀྱིས་དམ་བཅའ་བ་མ་ཡིན་པ་དེ་ཡང་སེལ་ཏོ།",
    "གལ་ཏེ་ཐམས་ཅད་མི་རྟག་པ་ཡིན་ན་སྒྲ་རྟག་པར་ཅི་ལྟར་འགྱུར།",
    "གལ་ཏེ་གཏན་ཚིགས་སྐྱོན་དང་ལྡན་པའི་ཕྱིར་དོན་དེ་ལ་ཕན་འདོགས་པ་མ་ཡིན་པ་དེ་ཙམ་གྱིས་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "གལ་ཏེ་གཞན་ཡང་ལྟོས་པ་ཡང་ཕྱོགས་ཀྱི་ཉེས་པ་ཡིན་ན་དེའི་ཚེ་འགའ་ཡང་སྒྲུབ་པར་བྱེད་པའི་སྐྱོན་ཉིད་ཡིན་པར་མི་འགྱུར་ཏེ།",
    "སྒྲུབ་པར་བྱེད་པའི་སྐྱོན་རྣམས་ལོགས་སུ་མི་སྨོས་པ་ཉིད་དུ་འགྱུར་རོ།",
    "མ་གྲུབ་པ་ཉིད་ཀྱིས་དེ་བཟློག་པར་འགྱུར་གྱི་དམ་བཅའ་བའི་ཉེས་པ་ནི་མ་ཡིན་ནོ།",
    "ཅི་སྟེ་དེས་དམ་བཅའ་བའི་དོན་ཟློག་པར་བྱེད་པ་དེ་ལྟ་ཡིན་ན།",
    "དེ་ལྟར་དེ་ནི་བཟློག་པར་འགྱུར།",
    "མི་རྟག་པ་ནི་ཐམས་ཅད་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "ཁྱད་པར་ལ་ནི་གཞན་བརྗོད་ནས།",
    "བསྒྲུབ་པ་ཡང་གནོད་པར་བྱ་བ་དང་གནོད་པར་བྱེད་པའོ།",
    "དེ་ལ་གནོད་པར་བྱ་བ་དང་།",
    "གནོད་པར་བྱེད་པའི་དངོས་པོ་ནི་སྤྱི་དང་ཁྱད་པར་བསྒྲུབ་པ་དག་གོ།",
    "རྣམ་པ་ཐམས་ཅད་དུ་ཁྱད་པར་ནི་གནོད་པར་བྱེད་པ་ཡིན་ལ།",
    "སྤྱི་ནི་གནོད་པར་བྱ་བ་ཡིན་ནོ་ཞེས་གནས་ཏེ།",
    "འདི་ལ་ཡང་སྒྲ་རྟག་པ་ཡིན་ནོ་ཞེས་བྱ་བར་སྒྲ་ལ་རྟག་པ་ཉིད་ཀྱི་ཁྱད་པར་གཞན་བསྒྲུབས་པ་ཡིན་ལ།",
    "གནོད་པར་བྱ་བ་དང་གནོད་པར་བྱེད་པའི་དངོས་པོ་འཐད་པ་ཡིན་ནོ།",
    "བྲམ་ཟེ་ཐམས་ཅད་ལ་ཞོ་བྱིན་ཅིག་ཅེས་ཞོ་སྦྱིན་པ་སྤྱིར་འཇུག་པ་དང་དར་བ་སྦྱིན་པ་ཁྱད་པར་དུ་བསྒྲུབས་པས་གནོད་པ་བཞིན་ཏེ།",
    "དེའི་ཕྱིར་སྤྱི་རྗེས་སུ་འཇུག་པ་ཁྱད་པར་དེ་ཁྱབ་པ་མ་ཡིན་ནོ།",
    "མི་རྟག་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པར་འགྱུར་རོ།",
    "འོན་ཏེ་དམ་བཅའ་བ་དང་གཏན་ཚིགས་འགལ་བའི་དཔེ་འགའ་ཞིག་ཇི་ལྟར་རུང་བའང་བརྟག་པར་བྱ་བ་ཡིན་ཏེ།",
    "མི་རྟག་ཉིད་ཀྱིས་སེལ་ཞེས་གསུངས།",
    "འདིར་གཏན་ཚིགས་ཀྱིས་དམ་བཅའ་བའི་དོན་སེལ་བར་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "དེ་ནི་གཏན་ཚིགས་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྤྱི་ནི་ཁྱད་པར་མི་སྤོང་ཕྱིར།",
    "སྤྱི་ནི་ཁྱད་པར་མི་སྤོང་ཕྱིར།",
    "ཁྱད་པར་སྤངས་ན་ནི་སྤྱིའི་བདག་ཉིད་རྙེད་པ་མ་ཡིན་ཏེ།",
    "ཤིང་ཤ་པ་ཉིད་ནི་ཤིང་མ་ཡིན་ནོ་ཞེས་ཁྱད་པར་སྤོང་བ་མཐོང་ངོ་ཞེ་ན།",
    "ཐམས་ཅད་མེད་མིན་ཁྱད་པར་ཀུན།",
    "འོན་ཏེ་བརྗོད་པར་འདོད་པས་སྒྲ་གཅིག་པུ་ཉིད་ཐམས་ཅད་མ་ཡིན་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལྟར་ཡིན་ན་ཐམས་ཅད་མ་ཡིན་པའི་སྒྲ་སྒྲའི་རྣམ་གྲངས་ཡིན་པའི་ཕྱིར་དམ་བཅའ་བའི་དོན་གྱིས་ཕྱོགས་གཅིག་ཡིན་པས་མ་གྲུབ་པར་འགྱུར་ཏེ།",
    "གཏན་ཚིགས་ཉིད་དུ་མ་གྲུབ་པའི་ཕྱིར་མ་གྲུབ་པར་བརྗོད་དོ།",
    "ག་ལས་ཤེ་ན་ཤེས་བྱ་ཤེས་བྱེད་ནི་གོར་མ་ཆག་པར་ཐ་དད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྒྲ་ནི་སྒྲས་ཤེས་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "ཤེས་པར་བྱ་བ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "མ་གྲུབ་པ་ནི་མ་གྲུབ་པས་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "གྲུབ་པ་ནི་སྒྲུབ་པས་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཤུགས་ཀྱིས་སྒྲ་ཉིད་མི་རྟག་པར་འགྱུར་བའི་ཕྱིར་ཚོགས་པ་ཉམས་པ་མེད་དོ།",
    "དུ་བ་ཡིན་པའི་ཕྱིར་དུ་བ་མེ་དང་ལྡན་པར་མི་འགྱུར་བ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་ནི་སྤྱི་དང་ཁྱད་པར་གྱི་ངོ་བོས་ཐ་དད་པ་ཡོད་པའི་ཕྱིར་འགྱུར་བ་ཉིད་དོ།",
    "འདིར་ནི་སྒྲ་ཐམས་ཅད་ནི་རྟག་སྟེ་སྒྲ་ཡིན་པའི་ཕྱར་ཞེས་བྱ་བ་སྤྱི་དང་ཁྱད་པར་གྱི་དངོས་པོ་མེད་པ་ཉིད་དོ།",
    "འོན་ཏེ་ཡང་བསྟན་པར་བྱ་བ་ཉིད་དང་ལྡན་པར་མ་གྲུབ་པའི་ཕྱིར་མ་གྲུབ་པ་ཡིན་ནོ་ཞེས་བརྗོད་དེ།",
    "འདི་ལྟར་གང་ཞིག་ཡང་བསྟན་པར་བྱ་བའི་ཁྱད་པར་ནི་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "སྒྲ་ཡིན་པའི་ཕྱིར་མི་རྟག་གོ་ཞེས་བརྗོད་པར་བྱ་བ་ཡིན་གྱི།",
    "ཡང་བརྗོད་པར་བྱ་བ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "གཏན་ཚིགས་གཞན་ལ་ལྟོས་པར་འགྱུར།",
    "དེའི་ཕྱིར་ཡང་བསྟན་པ་ལ་བརྗོད་པར་འདོད་པ་གང་ཡིན་པ་དེ་འདིར་མེད་པའི་ཕྱིར་ན་མ་གྲུབ་པ་ཉིད་ཀྱི་སྐྱོན་ཡིན་ནོ།",
    "ཉེས་པ་དེ་ཡང་བསྡུ་བའི་སྒོ་ནས་ཉེས་པ་མེད་པར་བརྗོད་པའི་སྐབས་སུ་འགྱུར་བ་ཉིད་དོ།",
    "ངེས་པར་བརྗོད་པའི་སྐབས་སུ་ནི་ཕམ་ཟིན་པ་ལ་ཕམ་པ་མེད་པའི་ཕྱིར་དང་།",
    "དེ་ལྟ་ན་ཡང་གཏན་ཚིགས་དོན་མེད་པར་འགྱུར་རོ།",
    "ཤེས་བྱ་ཤེས་བྱེད་ནི་ཐ་དད་པར་མཐོང་བས།",
    "ཤེས་པར་བྱེད་ན་ནི་ཐ་དད་པ་ཡིན་ན།",
