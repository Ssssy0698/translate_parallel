    "གལ་ཏེ་སྤྱི་མེད་པར་ཐ་དད་པ་དེ་ཉིད་མི་རྟོགས་སོ་ཞེ་ན།",
    "འོ་ན་སྤྱི་རྣམས་ཀྱི་ཁྱད་པར་ག་ལས་རྟོགས་སྤྱི་གཞན་དང་ལྡན་ན་ནི་ཐུག་པ་མེད་དོ།",
    "དེའི་ཕྱིར་གདོན་མི་ཟ་བར་འདིས་གསལ་བ་རྣམས་ཐ་དད་པར་རྟོགས་པར་འགྱུར་བ་ཡིན་ལ།",
    "བྱེད་པས་ཁྱད་པར་འགྲུབ་མི་འགྱུར།",
    "གསལ་བ་མེད་པར་ནི་སྤྱི་ཉེ་བར་མཚོན་པ་མ་ཡིན་ནོ།",
    "གསལ་བ་མཐའ་དག་མཐོང་ན་ནི་སྤྱི་ངེས་པ་མཐོང་བའི་ཕྱིར་བརྡ་འཆོལ་བ་མེད་པར་འགྱུར་རོ།",
    "འདི་ལྟར་གསལ་བ་གཅིག་མཐོང་ནས་འདི་ནི་བ་ལང་ངོ་ཞེས་བརྡར་བྱས་པས་ཇི་ལྟར་སོ་སོར་ངེས་པའི་སྤྱི་རྟོགས།",
    "ཕྱུགས་ཉིད་ལ་སོགས་པའི་སྤྱི་དག་ལ་ནི་སྤྱི་འགའ་ཡང་ཐ་དད་པར་མ་རྟོགས་པར་བརྗོད་དོ།",
    "བ་ལང་ལ་ཡང་ཞེས་རང་ཉིད་ཐ་དད་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྤྱི་ནི་གསལ་བས་གསལ་བར་བྱ་བ་ཡིན་པའི་ཕྱིར་དེ་ལྟར་རྟོགས་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "འོ་ན་ནི་གཏན་མི་རྟོགས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་བུར་གྱུར་པའི་ཤེས་པ་བསྐྱེད་པ་ཉིད་སྤྱི་ཡིན་ནོ་ཞེས་ཕྱིར་ཟློག་པར་བྱེད་ན་ནི།",
    "མང་པོ་རྣམས་ཀྱིས་དེ་ལས་གཞན་དག་ལས་ལྡོག་པ་ཉིད་སྤྱི་ཡིན་གྱི་དེ་དང་རིགས་མི་མཐུན་པ་ལ་ལྡོག་པ་ཙམ་ལས་གཞན་པའི་སྤྱི་དེ་ནི་འདི་ཡིན་ནོ་ཞེས་བསྟན་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "སྤྱི་ནི་འདི་ཡིན་ནོ་ཞེས་བསྟན་པར་ནུས་པ་ཡིན་ཏེ།",
    "ཐ་དད་པ་མེད་པའི་ཕྱིར་བསྟན་པར་ནུས་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ཡང་ལན་མ་ཡིན་ཏེ།",
    "གསལ་བ་འགགས་ནས་ནི་སྤྱི་རྣམ་པར་གཞག་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "ཐ་སྙད་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གཞན་གྱི་ཐ་དད་པ་ནི་གཞན་དང་ལྡན་པར་མི་འགྱུར་རོ།",
    "སྤྱི་ཐ་དད་པ་མེད་པ་གསལ་བ་ལ་འཕྲོད་པ་འདུ་བའི་ཕྱིར་གསལ་བ་རྣམས་ཉིད་ཐ་དད་པ་མེད་པར་འགྱུར་རོ།",
    "དེས་ན་སྤྱི་ཐམས་ཅད་དང་ལྡན་པའི་ཕྱིར་བ་ལང་ཡང་རྟ་ལ་སོགས་པར་འགྱུར་རོ།",
    "གཞན་གྱིས་ཅི་བྱ་སྤྱི་ཁས་བླངས་ཀྱང་གསལ་བ་ལ་ཐ་དད་པ་དེ་ཉིད་སྤྱི་སྤྱི་གཞན་དག་ལས་འབྱེད་པར་བྱེད་པ་ཡིན་པར་འགྱུར་བས།",
    "འོ་ན་སྤྱིའི་ཁྱད་པར་ནི་གྲུབ་པ་ཉེ་བར་འཇོག་པ་ཡིན་ནོ།",
    "དབྱིབས་ཀྱང་ཁ་དོག་ལ་སོགས་པ་ལས་ཐ་དད་པ་ལ་རྟེན་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེས་ན་རྫས་ཉིད་ངོ་ཤེས་པར་རིག་པ་དང་ལྡན་པ་ཡིན་ནོ།",
    "དེས་ན་གང་ཞིག་གང་ལས་ཐ་དད་པའི་ཡུལ་ཅན་གྱི་རྣམ་པར་ཤེས་པས་གཟུང་བར་བྱ་བ་དེ་ནི་དེ་ལས་ཐ་དད་པ་ཡིན་ཏེ་དཔེར་ན་བུམ་པ་ལས་སྣམ་བུ་བཞིན་རྫས་ཀྱང་ཐ་དད་པའི་ཡུལ་ཅན་གྱི་ཤེས་པས་གཟུང་བར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་སོ་ཞེ་ན།",
    "དྲན་པ་མེད་པར་སྔ་མ་ནི།",
    "ཕྱོགས་ཀྱི་རྣམ་པར་དབྱེ་བ་དང་ལྡན་པའི་ཡན་ལག་མ་ལུས་པ་ལ་ཁྱབ་པའི་ཡན་ལག་ཅན་བུམ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "མངོན་སུམ་སྔོན་འགྲོ་མེད་པར་མིན།",
    "དེའི་ཚེ་ཡན་ལག་དང་ཡོན་ཏན་གཞན་རྣམ་པར་ཕྱེ་ན་དེ་ལ་བུམ་པ་གང་ཡིན་ཞེས་བྱ་བར་ཡང་འགྱུར་རོ།",
    "གལ་ཏེ་སོ་སོར་གདུང་འདེགས་པར་མི་ནུས་པ་རྣམས་གཞན་དུ་ནུས་པར་མཐོང་བ་མ་ཡིན་ནམ་ཞེ་ན།",
    "རྗེས་སུ་དཔག་པ་ནི་མངོན་སུམ་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་པའི་ཕྱིར་མངོན་སུམ་གྱིས་དེ་འབའ་ཞིག་པ་ཉིད་དུ་རྟོགས་པ་ཇི་ལྟ་བར་འགྱུར་བ་དེ་ལྟ་བུར་གྱུར་པ་ཉིད་རྗེས་སུ་དཔག་པས་རྟོགས་པར་བྱེད་དོ།",
    "དེས་ན་འབའ་ཞིག་པ་ཐ་དད་པར་གྱུར་པ་མངོན་སུམ་གྱིས་རྟོགས་པ་ཡིན་པའི་ཕྱིར་རྗེས་སུ་དཔག་པས་ཀྱང་དེ་ལྟ་བུར་གྱུར་པ་ཉིད་རྟོགས་པ་ཡིན་ནོ།",
    "འོ་ན་དེ་གཅིག་པ་ཉིད་རྗེས་སུ་དཔག་པ་ཉིད་ཀྱིས་ཡིན་ཏེ་དེས་ཡན་ལག་ཅན་བདེན་པ་ལ་བརྟེན་པར་འགྱུར་བའི་ཕྱིར།",
    "དོན་དམ་པའི་གཅིག་པ་ཉིད་གྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དོན་དེ་བྱེད་པ་ཉིད་ཀྱིས་དེ་ལ་གཅིག་པ་ཉིད་ཡིན་གྱི་དོན་དམ་པར་ནི་མ་ཡིན་ནོ།",
    "དེ་ཉིད་ཀྱི་དོན་བྱ་བ་བྱེད་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་ངེས་པ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "མེ་གཞན་གྱིས་ཀྱང་སྲེག་པར་བྱེད་པ་མཐོང་བའི་ཕྱིར་རོ།",
    "ཡང་ན་དང་པོ་མཐོང་བ་ནི་དངོས་ཀྱི་གཅིག་ཡིན་པར་བརྗོད་ལ།",
    "ཕྱིས་ནི་དེར་སྒྲོ་བཏགས་པ་ལས་དོན་བྱ་བས་བྱས་པ་ཉེ་བར་བཏགས་པ་ཡིན་ནོ།",
    "འོན་ཀྱང་ཐོག་མ་མེད་པའི་བག་ཆགས་ཀྱིས་བྱས་པའི་རྗེས་སུ་དཔག་པ་བརྒྱུད་པ་ལས་བྱུང་བ་ཡིན་པའི་ཕྱིར་དོན་དམ་པ་མ་ཡིན་ནོ།",
    "དོན་དམ་པར་ནི་རྣམ་དཔྱད་ན།",
    "དེ་ཉིད་གཞན་ཉིད་འགོག་པར་འགྱུར།",
    "དོན་དམ་པར་ནི་ཐ་མི་དད་ལ་ཀུན་རྫོབ་ཏུ་ནི་ཐ་དད་དོ་ཞེས་བྱ་བ་ནི་ནམ་མཁའི་གོས་ཅན་གྱི་ལྟ་བ་མ་ཡིན་ནོ།",
    "དཔག་བྱ་དཔོག་པར་བྱེད་པ་ཡི།",
    "བརྟེན་ནས་རྣམ་པར་གནས་པ་ཡིན།",
    "ལྡོག་པས་བྱས་པའི་ཐ་སྙད་པ་ཡོད་པའི་ཕྱིར་ཀུན་རྫོབ་པའི་ཐ་དད་པ་ལ་བརྟེན་པའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་ནི་ཐ་མི་དད་པ་མ་ཡིན་པ་ནི་མ་ཡིན་ནོ།",
    "མཐར་ཐུག་ཤེས་ལ་ཐ་དད་པར།",
    "བྱས་པ་དེས་ན་མ་གྲུབ་བསྟན།",
    "སྒྲ་དང་སྒྲ་ཉིད་ནི་དེ་ལྟ་མ་ཡིན་པས་ན་དེ་ཇི་ལྟར་ཐ་དད་པ་མེད་པར་དངོས་པོའི་རྐྱེན་དུ་འགྱུར།",
    "དངོས་པོའི་རྐྱེན་གྱིས་བརྗོད་པར་བྱ་བ་ཉིད་ལས་ཐ་དད་པ་ཡིན་ནོ་ཞེ་ན།",
    "དངོས་པོ་རྐྱེན་གྱིས་ཐ་དད་པར་འགྱུར་བ་ན་ཡང་དྲུག་པའི་ནུས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཐ་དད་པར་བརྗོད་པར་འདོད་ན་ནི་མ་གྲུབ་པ་ཉིད་དོ་ཞེས་གནས་སོ།",
    "སྒྲ་ལ་གནས་པའི་རྩོལ་བ་ལས་བྱུང་བའི་ཉིད་རྩོལ་བ་ལས་བྱུང་བ་གཞན་ལས་ཐ་དད་པ་ཡིན་གྱི་སྤྱི་རང་བཞིན་དུ་བརྗོད་པར་འདོད་པ་ནི་དེ་ལས་ཐ་དད་པ་མ་ཡིན་གྱི།",
    "མ་ཁྱབ་པ་ཉིད་ནི་ཁྱབ་པར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "དེས་ན་སྒྲ་ཉིད་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་འདི་ལས་རྗེས་སུ་འགྲོ་བ་མེད་པའི་ཕྱིར་སྐྱོན་ཉིད་ཡིན་པར་ཤིན་ཏུ་གསལ་གྱི།",
    "ཐ་དད་མེད་པས་མ་གྲུབ་པ་ཉིད་མེད་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "ཉེས་པ་གཞན་རྗོད་པར་བྱེད་པ་ནི་རིགས་པ་དང་འབྲེལ་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་གོང་བུ་གཞན་གཅད་པའི་ཕྱིར་རྭ་ཅན་ཉིད་ཕྱོགས་ཀྱི་ཁྱད་པར་ཡིན་པ་དེ་ལྟ་ན་ཡང་གཏན་ཚིགས་ཉིད་ན་འགལ་བ་མ་ཡིན་ནོ།",
    "བསྒྲུབ་པར་བྱ་བ་དང་འབྲེལ་པའི་གཏན་ཚིགས་དེ་བཞིན་དུ།",
    "རྟོགས་པ་ནི་སྒྲུབ་པར་བྱེད་པ་ཁོ་ནའོ།",
    "ཁྱད་པར་ནི་གདོན་མི་ཟ་བར་བསྒྲུབ་བྱ་ཉིད་ཡིན་པར་མཚོན་པའི་དུས་ན་ཡན་ལག་ཏུ་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "དེ་ལྷ་ཁང་ལ་སོགས་པ་ཉེ་བར་མཚོན་ནས་ད་ལྟར་ལོག་པ་ཡིན་ཡང་དུས་གཞན་དུ་ཡང་དེ་ཉེ་བར་མཚོན་པར་བྱེད་པ་བཞིན་ནོ།",
    "དེའི་འབྲས་བུ་ཁྱད་པར་གྱི་མཐར་ཐུག་པའི་བློ་ཡོད་པའི་ཕྱིར་རོ།",
    "ཁྱབ་པ་མཚུངས་པའི་བྱས་པ་ཉིད་དང་།",
    "མཉན་བྱ་ཉིད་ནི་ཉན་པའི་རྣམ་པར་ཤེས་པ་དང་འབྲེལ་པའི་ཕྱིར་མ་འབྲེལ་པ་ཉིད་ལས་ལོག་པ་ཡིན་ལ།",
    "གལ་ཏེ་སྒྲ་མཉན་པར་བྱ་བ་མ་ཡིན་པ་མེད་པ་དེ་ལྟར་ན་ཡང་།",
    "ཚོགས་པ་མེད་པའི་ཕྱིར་སྐྱེས་བུ་གཞན་ལ་ལྟོས་ནས་མཉན་པར་བྱ་བ་མ་ཡིན་པར་ཡང་འགྱུར་ལ།",
    "སྒྲ་མ་ཡིན་པར་ནི་སྐྱེས་བུ་གཞན་ལ་ལྟོས་ཀྱང་མི་འགྱུར་བའི་ཕྱིར་མཉན་པར་བྱ་བ་མ་ཡིན་པ་ལས་ལོག་པས་ནི་སྒྲ་ཉིད་མ་ཡིན་ནོ།",
    "འདུས་བྱས་ནི་མི་རྟག་སྟེ།"
  ]
}