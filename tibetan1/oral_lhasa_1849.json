    "ཐ་ན་ལོ་གསུམ་དུ་བཞུགས་པར་ཞུས་ཀྱང་མ་བཞུགས་པར་ང་ཕེབས།",
    "འཕྲལ་སེལ་འཚོ་ཙམ་ལས་གཞན་གང་ཡང་མ་བཞེས་པར་རང་ཡུལ་དུ་བྱོན།",
    "ཕྲིན་ལས་ཚེས་བརྒྱུད་དཔལ་མཁྱེན་གཉིས་ལས་མཆེད་དེ་འཛམ་གླིང་ཀུན་ཏུ་ཁྱབ་པས་རྗེ་འདིའི་ཆེ་བ་ལ་དགོངས།",
    "ཀུན་མཁྱེན་འཇིགས་མེད་དུ་ངོས་འཛིན་གནང་།",
    "བཏབ་འགྲུབ་པའི་འབྲེལ་ཚད་གུ་རུ་སྣང་སྲིད་ཟིལ་གནོན་གྱི་ཆ་བྱད་ཅན་ད་ལྟའི་བར་དུ་བཞུགས།",
    "བས་སྤྲུལ་གྱི་མཚན་དུ་མངའ་གསོལ་གྱིས་བཞུགས་སོ།",
    "གཉིས་པ་ཡུན་རིང་མ་བཞུགས།",
    "ཕྱིས་སྐུ་ཚེའི་སྨད་དུ་འཇིགས་མེད་རྒྱལ་བའི་མྱུ་གུའི་གདན་ས་རྫ་རྒྱལ་དགོན་གྱི་ཉེ་བཞུགས་ནས།",
    "དཔལ་དགེ་གོང་མའི་ཡིག་དྲུག་རྡོ་མཁར་ཁ་གསོ་གནང་སྟེ།",
    "མཁྱེན་བརྩེའི་སྲས་རིག་པའི་རལ་གྲི།",
    "ཨ་འཛོམ་འབྲུག་པ་རིན་པོཆེ་སོགས་སྔ་འགྱུར་གྱི་བསྟན་པའི་ཐུགས་སྲས་ཁྱད་པར་ཅན་རྣམས་དང་།",
    "པར་བྱུང་བ་ཡིན་གསུངས།",
    "སྤྲེལ་ལོ་སྤྲེལ་ཟླའི་ཚོགས་རྒྱས་པ་གནང་།",
    "ཐུགས་ཤིན་ཏུ་སྒམ་ཞིང་སུ་ལའང་མི་གནང་བས་འགོད་རྒྱུ་ཆེར་མེད་ལ་ཐུགས་སྲས་གཙོ་བོ་ལུང་རྟོགས་བསྟན་པའི་ཉི་མ་ལ་གསུང་འཕྲོས་ཕེབས་པ་འདི་ལྟར།",
    "དེ་བསྐྱེད་རིམ་ཡིན་སྙམ་ཡིད་ལ་མེད་གསུངས།",
    "དེམཁྱེན་བརྩེ་ཡེ་ཤེས་རྡོ་རྗེ་ལ་ཞུས་པས།",
    "ཐོས་པ་མེད་པ་སྲིད་པར་ཐོས་པ་དེ་བས་སྡིག་ཆེ་བས།",
    "གཞུང་བཟང་འདི་འདྲས་སྤྲོས་པ་མ་བཅད་ན།",
    "བརྒྱ་ཕྲག་གཞུང་ལ་ཅིག་ཆར་སྦྱངས་པར་འགྱུར།",
    "ཀུན་མཁྱེན་བླམའི་དགོངས་ཟབ་སྟོན་པ་ཡིན།",
    "གཞུང་འདི་མཇལན་ཨ་འཐས་མངོན་རློམ་འཇིག་ང་ལྟར་བྱས་ཀྱང་ཆོག།",
    "ནམ་ཡང་འདི་དང་འབྲལ་བར་མ་བྱས་ན།",
    "རྟོགས་པར་དཀའ་བ་རྟོག་གེའི་བསྟན་བཅོས་བཞིན།",
    "སྤྲོ་བ་མེད་ཀྱང་ཀུན་མཁྱེན་བརྒྱུད་པའི་གཞུང་།",
    "ཐོབ་པར་ངེས་ཀྱི་ངེས་ཤེས་ཡང་ཡང་སྐྱེད།",
    "ཀུནམཁྱེན་གཞུང་ལས་བྱིན་བརྒྱུད་ཐོབ་པ་ཡིན།",
    "ཅེས་གསུངས་པ་ལྟར་རོ།",
    "རྫོགས་ཆེན་དགོན་དུ་ཕེབས་རྒྱལ་སྲས་གཞན་ཡས་དང་མཇལ།",
    "དཔལ་སྤྲུལ་རིན་པོ་ཚེས་མཚན་དེ་ཅུང་ཟད་ཐུང་རྒྱལ་མཚན་དཔལ་བཟང་པོ་གྱིས་གསུངས་ཏེ།",
    "ཁྱད་པར་ནང་ཐུན་མིན་གྱི་རིགས་བདག་ཚེ་རབས་ལས་ཀྱི་བླམ་དཔལ་སྤྲུན་པོ་ཆེ་ཡིན་པས།",
    "དེ་ནས་བཟུང་མི་ལོ་ཉེར་བརྒྱད་ཀྱི་བར་དུ་ཉེ་གནས་ཀྱི་ཚུལ་དུ་དཔེན་སློབ་འབྲལ།  ། མེད་དུའནས་དང་གང་གསུངས་པ་ཐམས་ཅད་མ་གསན་པ་ཚིག་གཅིག་ཀྱང་མེད།",
    "འདི་དང་མི་ག་ཀུན་ག་བོན་ཚར་བརྒྱད་ཅུ་ཙམ་དུ་གསན་པར་གྲགས།",
    "སྣང་བའི་བདེན་འཛིན་འདི་བདེན་མེད་སྒྱུ་མའི་ཡོ་ལངས་སུ་ཤར་བ་ཡིན་གསུངས།",
    "འདི་དུས་ནུབ་བརྒྱུད་མར་གྲུ་གུ་ནུག་ང་། ཉར་ཚག་བྱེད་དུ་ཡོད་པར་རྨིས་པ་ནུབ་གཅིག་ཨ་བུས་གྲུ་གུ་བཤིག་པའི་དཀྱིལ་དུ་གསེར་གྱི་རྡོ་རྗེ་སེམས་དཔའ་ཞིག་སྤྲོད་པ་དང་།",
    "ལོ་གསུམ་གྲུབ་པ་མཇལ་དུ་བྱོན་པར་ཨ་བུས་ཁྱེད་འཚོ་བ་སྡུག་པོ་བྱུང་ངམ་གསུངས།",
    "དགུང་གྲངས་བཞི་བཅུའི་ནང་ཉིན་གཅིག་ལུང་གཅེས་གསུངས་ཏེ།་",
    "ལའི་རྣམཕེབས་སུ་ཉེ་ཡང་ངས་མི་མཇལ་བ་འདྲ།",
    "དེ་དུས་ཀུན་མཁྱེན་ཆེན་པོའི་ཞལ་ཐང་དང་དབུ་ཀླད།",
    "བྱང་སེམས་ཕུག་ཅེས་པར་བླློརི་དྭགས་དང་རྔོན་པ་མ་གཏོགས་མིའི་རྒྱུ་འགྲུལ་མེད་པའི་གནས་སུ།",
    "དེ་ནསའང་ཡུལ་ཤུ་གུ་ཤར་དུ་ཕེབས་སྤྱོད་འཇུག་དང་།",
    "ངལ་གསོ་སྐོར་གསུམ་གྱི་ཉམས་བནང་སྟེ་ལོ་བཅུ་གསུམ་བཞུགས།",
    "དགའ་རབ་རྡོ་རྗེ་སྟེ་རྡོ་རྗེའི་མཚན་ཅན་བརྒྱ་རྩལ་གྲགས་པ་སོགས་གཙོ་བོར་བྱས་པའི་གྲུབ་རྗེ་པདྨ་བདུད་འདུལ་སློབ་ཚོགས་རྣམས་དང་།",
    "གཏེར་མས་ཟུར་བརྒྱན་དགོས་གསུངས་ཏེ།",
    "ཁྲོམ་གྱི་པདྨ་རི་མཐོར་པོའི་ཆེས་སྒར་བཏབ་སྟེ་བཞུགས།",
    "སྒར་མདུན་དེར་ཡིད་ལེ་ཆུ་ཞེས་པའི་གཙང་ཆུ་ཞིག་འབབ་ཀྱི་ཡོད་པ་རྒྱང་གྲགསམ་དུ་ཆུ་སྒྲ་མེད་ས་ཡུལ་མི་རྣམས་ཀྱིས།",
    "རྫོགས་ཆེན་དགོན་དུ་ཕེབས་དགོས་ཞེས་ཆེད་ཕེབས་མཛད་ཀྱང་།",
    "ཁྱད་པར་བཀའ་ཁྲིད་གསུང་དུས།",
    "གང་དུ་བཞུགས་པའི་གནས་དེར་སད་སེར་མི་ཕྱུགས།",
    "དེ་ལྟས་བདུན་ཅུ་རྩ་གཉིས་བར་དུ་བསྟན་འགྲེ་ཡོངས་ཀྱི་དཔལ་མགོན་དུ་བཞུགས་ནས་སྐུ་སྙན་ཚུལ་བསྟན་སྐབས་ཞབས་བརྟན་ཕུལ་བས།",
    "བྱོན་ནས་སྐྱེ་དགུ་རྣམས་དད་པའི་ས་ལ་བཀོད་པར་མཛད་དོ།",
    "དགུང་ལོ་བདུན་པ་ཡི་གེ་ཀློག་བསྟན་དུས་བརྡ་བསྟན་པ་ཙམ་གྱིས་ཐོགས་མེད་དུ་མཁྱེན་པ་དང་།",
    "རྗོད་བྱེད་ཀྱི་སྒྲ་དག་ཅིང་བརྗོད་དེས་ལ་གསལ། ། བ་སོགས་བྱིས་པ་གཞན་དང་བསྒྲུན་དུ་བཞུགས།",
    "དེ་རྗེས་རྫོགས་སྤྲུལ་ལྔ་ད་བཞེས་མཚན་གཞོན་ནུ་པདྨ་ལེགས་གྲུབ་ཅེས་གནང་།་",
    "ངག་དགའ་འདི་ཡིན་གསུངས།",
    "རྟེན་སུམ་ལྡན་རྡོ་རྗེ་འཛིན་པ་གསེར་གྱི་རི་བོ་ལྟ་བུར་བཞུགས་ནས་རྒྱལ་བསྟན་གྱི་རྩ་བ།",
    "སྔ་ཕྱིར་རབ་བྱུང་རྐྱང་པ་སུམ་ཁྲི་གནང་བ་སོགས་མཁས་གྲུབ་ཀྱི་འབྱུང་གནས་སུ་མཛད།",
    "རྟོག་གེའི་ཚིག་ཁྲིད་སོགས་མིན་པར།",
    "ལྷག་པར་རྫོགས་ཆེན་སྙན་བརྒྱུད་ཁྲེགས་ཆོད་ལ་སེམས་རིག་ཤན་ཕྱེ་བའི་རིག་སྟོང་རྗེནཔའི་ཡེ་ཤེས་རང་ངོ་སྤྲད།",
