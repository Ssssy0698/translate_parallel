    "རྡོ་རྗེ་འཆང་ཆེན་པོའི་གོ་འཕང་སྟེ་འཐོབ་པར་འགྱུར་བའོ།",
    "ཡེ་ཤེས་སེམས་དཔའི་ཐུགས་ཀར་གནས་པར་བསམ་པར་བྱའོ།",
    "དེ་ལྟར་རྟག་པ་ཉིད་ཀྱིས་ཐུན་བཞིར་བསླབ་པར་ིབྱས་ན།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལྷ་དང་མི་རྣམས་ལ་རྗེས་སུ་སྟོན་པར་མཛད་པས་ན་སྟོན་པའོ།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འཆང་ཆེན་པོས་གསུངས་སོ།",
    "ཡེ་ཤེས་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།་",
    "ཡི་གེ་ཁཾ་ནམ་མཁར་བྱེད་པས་རྗེས་སུ་གཞིག་པའི་རིམ་གྱིས་དངོས་པོ་མེད་པར་བྱས་ལ།",
    "བདག་ཉིད་ཀྱང་རིམ་གྱིས་ཞུགས་པ་དེ་བྱས་ན།",
    "རྡོ་རྗེ་ཡེ་ཤེས་ནམ་མཁའ་དང་མཉམ་པར་འགྱུར་ཞིང་སེམས་དཔའ་གསུམ་གྱི་བདག་ཉིད་ཅན་གཅིག་ཏུ་འགྱུར་རོ།",
    "དེ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་ངོ་བོ་ཉིད་གཟུགས་ཀྱི་ཕུང་པོ་ལ་སོགས་པ་རྣམས་དང་།",
    "ཡེ་ཤེས་གསུམ་གྱི་བདག་ཉིད་ཅན་དུ་རང་ཉིད་ལ་རབ་ཏུ་ཞུགས་པར་འགྱུར་བས།",
    "དེ་དང་མཉམ་པར་གྱུར་ཅིང་རྣམ་པར་ཞུགས་པར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི།",
    "དེ་ལ་མཉམ་པར་བྱུང་བར་གྱུར་པས་ན་ནམ་མཁའ་རྡོ་རྗེའི་དམ་ཚིག་སྟེ།",
    "སྐུ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཏིང་ངེ་འཛིན་དེ་དག་ཐམས་ཅད་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་རྡོ་རྗེའི་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཆ་འཇམ་པ་ནི་རྣམ་པར་མི་འཇིག་པའོ།",
    "ཕྱིར་མི་ལྡོག་པ་རྣམས་ཀྱིས་ཡང་དག་པར་ལོངས་སྤྱོད་ཅིང་ཡུལ་དུ་བྱས་པས་ན།",
    "དེ་ཉིད་དམ་ཚིག་ཡིན་ལ་དེ་ཉིད་ནི་ཁམས་གསུམ་པ་རྣམས་ཚིམ་པར་བྱེད་པས་ན་ཟླ་བའོ།",
    "འོད་ཟེར་འབར་བའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཆ་༡ དེའི་དབུས་སུ་ཆུད་པར་ཡི་གེ་བློ་ལ་༧འོད་ཟེར་ཤིན་ཏུ་འབར་བ་སྟེ།",
    "བགེགས་ཐམས་ཅད་རྣམ་པར་འཇོམས་པས་ིན་མཚོན་ཆའི་མཆོག་སྟེ།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོ་དང་མཚུངས་པར་འགྱུར་བའོ།་།",
    "ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "ཡེ་ཤེས་ནི་ཕྱག་ན་རྡོ་རྗེ་སྟེ་དེ་སྐྱེད་པར་བྱེད་པའི་ཡི་གེ་ཨོ་ནི།",
    "དེ་བསྒོམས་པས་ནི་དེའི་རང་བཞིན་དུ་བྱས་པས་སོ།",
    "ཁ་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མེད་པ་ན་གནས་པའི་སྒྲ་རྣམ་པ་སྣ་ཚོགས་པ་རྣམས་རྣ་བའི་ལམ་དུ་གྲག་པར་གྱུར་པ་ན།",
    "དེ་སྐྱེད་པར་བྱེད་པའི་ཏིང་ངེ་འཛིན་ལ་ཡང་དེ་སྐད་ཅེས་བྱའོ།",
    "འོད་གསལ་བའི་དབུས་སུ་གནས་པར་རོ།",
    "དེ་དང་མཉམ་པར་གྱུར་པར་མཛད་པའི་ཕྱིར་རྡོ་རྗེ་དམ་ཚིག་གསུམ་སྟེ།",
    "དེ་སྐྱེད་པར་འགྱུར་རོ་ཞེས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འོད་དཔག་ཏུ་མེད་པ་སྟེ།་",
    "དེས་མཛེས་པར་གྱུར་པའི་དཔལ་གང་ཡིན་པ་དེ་ནི།",
    "སྔ་མ་བཞིན་དུ་དང་པོའི་རྣལ་འབྱོར་བྱས་ཏེ།",
    "དམ་ཚིག་ནི་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བ་སྟེ།་",
    "དེ་སྐྱེད་པར་བྱེད་པའི་ཡི་གེ་ཨོ་ཡང་དམ་ཚིག་ཨོ་ཡིན་ཏེ།",
    "དེ་དང་མཉམ་པར་གྱུར་པས་ན་རྡོ་རྗེ་དམ་ཚིག་གསུམ་སྟེ།",
    "ཡེ་ཤེས་ནི་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བའོ།",
    "དེའི་རྒྱ་མཚོ་ནི་གནས་ཏེ་དོན་ཡོད་པར་གྲུབ་པའོ།",
    "གདོན་མི་ཟ་བའི་དམ་ཚིག་ནི་དོན་ཡོད་པར་གྲུབ་པའོ།",
    "དེ་བཞིན་གཤེགས་པའི་དགོད་པས་ཀྱང་བསྐྱེད་པར་བྱའོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཀ་ནམ་མཁའི་དབྱིངས་ཀྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྐུ་གསུམ་ཨོ་ནི་རྡོ་རྗེ་རྣམ་པར་སྣང་མཛད་དོ།",
    "སྐུ་གསུམ་ིརྣམ་པར་སྣང་མཛད་ཡིན་ཏེ།",
    "རྡོ་རྗེ་དམ་ཚིག་གསུམ་ནི་རྣམ་པར་སྣང་མཛད་དོ།",
    "དེ་མིག་ཏུ་བསྒོམས་ཤིང་རྣམ་པར་བསམས་པས་རྣམ་པར་སྣང་མཛད་དེ།",
    "ད་རྡོ་རྗེ་འཆང་ཆེན་པོ་དང་སྔ་མ་བཞིན་དུ་དེ་མཉམ་པར་འགྱུར་རོ།",
    "རྣམ་པར་སྣང་མཛད་དང་གཟི་བརྗིད་འདྲ་ཞིང་ཡེ་ཤེས་ཀྱི་ངོ་བོ་ཉིད་དང་།",
    "དེ་སྒྲུབ་པར་བྱེད་པས་ན།",
    "ཞེས་བྱའོ་ཞེས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་རྣམ་པར་སྣང་མཛད་ཀྱིས་དེ་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "མང་ཐོས་བསཾ་ནས་གཏན་ལ་ཕབ་ཅིང་རྩེ་གཅིག་མཉམ་པར་བཞག་པ་ལས།",
    "ཕྱི་མ་རྒྱས་པར་བསྟན་པ་ནི་འདི་ལྟར།",
    "རྒྱལ་བ་ཀུན་གྱི་མཁྱེན།",
    "གང་ཚེ་ཤེས་དང་ཤེས་བྱ་སོགས་གསུངས་པ་བཞིན་ནོ།",
    "སྤྲུལཔའི་གཏེར་སྟོན་བདུད་འཇོམས་རྡོ་རྗེས་ཀྱང་དེ་ཡིན་པར་གསུངས།",
    "དེ་རྗེས་ཞག་གཉིས་གསུམ་ཙམ་ལ་མ་ཎིགསུངས།",
    "མཁྱེནཔའི་ཤེས་རབ་ཆེ་བ་དང་།",
    "ཁྲིད་སྦྱངསཡང་དེ་སྙེད་གྲུབ་པར་མཛད།",
    "རྗེ་ཉིད་ཀྱི་གསུངས་ལས།",
    "ཞེས་བསྔགས་པར་མཛད་པའི་ཀུན་མཁྱེནཡབོ་ས།",
    "ཀུན་མཁྱེན་མཆོག་སྤྲུལ་རིན་པོ་ཧེ་རུ་ཀ་དཔལ་སྐུ་ཞབས་མཁྱེན།",
    "བརྩེའཇིགས་མེདཡེཤེས་རྡོ་རྗེས་རིག་པབརྟུལ་ཞུགས་ཀྱི་སྤྱོད་པ་མཛད་ཅིང་ཕེབས་སྐབས་ཤིགཾརྗེ་འདིའི་ཉེ་སྐོར་དུ་བྱོན་ནས་དཔལ་དགེ་ས་བོས་ཏེ།",
    "བདུད་བཞི་སྟན་ཐོག་གཅིག་ཏུ་བཅད་པར་བཤད།",
    "ཅེས་གསུངས་པ་ཇི་ལྟ་བ་བཞིན་འཁྲུལ་པ་མེད་པ་བདུན་ལེན་དུ་བསྟར་བས་བདག་ཉིད་ཆེན་པོ་འདིས་ཀུན་སྤང་ཀུན་ཏུ་རྒྱུའི་ཚུལ་གྱིས་དབེན་པའི་གནས་སོགས་ངེས་མེད་དུ་ཕེབས་ཏེ།",
