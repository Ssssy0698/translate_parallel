    "ནོར་དང་ལང་ཚོ་མི་བརྟན་ཀྱང་།",
    "ཚངས་ཐིག་དཎྜིའི་རྒྱུད་མངས་འཁྲོལ་པ་ཁྱོད།",
    "སྐྱེས་བུའི་ཚེ་ནི་གློག་གི་ཟློས་གར་བཞིན།",
    "གཟིགས་ནས་འཇིག་རྟེན་ཡང་དག་བལྟ་ལ་བརྩོན།",
    "དམ་པའི་བརྩོན་འགྲུས་བག་ལ་ཉལ་གཟིགས་ནས།",
    "རིགས་གཟུགས་ཐོས་དང་ལང་ཚོས་དྲེགས་པ་དང་།",
    "རྗེས་སུ་ཕྱོགས་ནས་རང་གིས་རང་ཉིད་བཟའ།",
    "རང་གི་སེམས་ལ་འཁྲུགས་པ་ཆེར་སྟེར་བས།",
    "སྐྱེ་བོ་རྣམས་ནི་ཨ་མྲའི་འབྲས་བུ་བཞིན།",
    "མེ་དང་ཆུ་དང་གཡུལ་ངོར་སོང་བ་མང་།",
    "བདེན་པ་གཟིགས་པ་གང་ཞིག་མ་གཏོགས་པ།",
    "མཐོང་ན་མཚན་མོ་རྒྱུ་དང་ཆོམ་རྐུན་དང་།",
    "གྲགས་པ་ཉམས་པའི་བརྩོན་འགྲུས་རྩོམ་ལ་གཟིགས།",
    "ཡུལ་རྐྱེན་གྱིས་དགེ་སྦྱོར་བཅོམ་ཏ་རེ།",
    "དེ་དག་ལ་མོས་པ་མེད་ཟེར་ན།",
    "ལྟད་མོའི་འདུ་ཤེས་ཀྱང་ནོར་ཉེན་ཆེ།",
    "ཁྱད་པར་ཨ་ཁུ་ཁམས་པ་དང་།",
    "ཤུལ་རིང་གི་ངལ་དུབ་ངག་འཁྱལ་གྱིས་བསྒྲིབ།",
    "ངག་གི་ལས་ལམ་བཞིར་བསྙེན་སྒྲུབ་བྱེད།",
    "བརྩོན་འགྲུས་ལོག་ལམ་གྱི་ཕྱོགས་ལ་འཁྱོག།",
    "ལ་སོགས་རྣམ་རྟོག་གི་ཆོམ་རྐུན་རྣམས།",
    "གདོན་བགེགས་རང་གི་སེམས་ལ་ཚང་།",
    "གནས་སྐོར་གྱིས་ངན་སོང་སྒྲུབ་ཉེན་ཆེ།",
    "ཁྱེད་ཅག་གི་རྒྱུད་ཚོད་རིག་སྟེ་མཆི།",
    "ཁལ་མ་དང་ཚོང་ཟོག་ལམ་ཡིག་ལ་གདུང་།",
    "དེ་དག་གིས་དེ་འདྲ་ཨེ་མཛད་ལྟོས།",
    "ས་བཅུའི་སྤངས་རྟོགས་ལ་རེག་པའི།",
    "། བསམ་ཡས་གཙུག་ལག་ཁང་གི་གཏམ། ། བསམ་ཡས་གཙུག་ལག་ཁང་གི་གཏམ་འདོད་པའི་ཁམས་ཀྱི་རྣ་རྒྱན་ཞེས་བྱ་བ།",
    "དེ་ལ་བདག་ཅག་གི་སྟོན་པ་འཚོ་ཞིང་གཞེས་པའི་དུས་ན།",
    "རྒྱལ་རབས་ལྔ་ནས་འདིའི་དོན་ཤེས་པ་འབྱུང་ངོ་ཞེས་པ་ལྟར་ཨ་མི་དེ་ཝའི་ཞལ་སྐྱིན་སྲོང་བཙན་གྱི་རིང་ལ།",
    "དེའི་གྲོགས་སྦ་གསལ་སྣང་གིས་བྱས།",
    "ལྷ་ཁང་འབྱོངས་ནས་བཙན་པོའི་མནལ་ལམ་དུ་མི་དཀར་པོ་གཅིག་གིས་ས་གཞི་འདི་ཇོ་མོ་སྒྲོལ་མས་བྱིན་གྱིས་བརླབས་པ་ཡིན།",
    "དེ་ཤིང་རྟ་ལ་སྤྱན་དྲངས་པས་གཙུག་ལག་ཁང་གི་ཤར་སྒོར་བྱོན་པ་དང་ས་གཡོས།",
    "ཁྲི་ལ་བཞུགས་སུ་གསོལ་པ་ན་ཕྱྭ་མཁན་ན་རེ།",
    "མིག་གིས་མཐོང་ཚད་ངན་སོང་སྐྱེ་སྒོ་གཅོད།",
    "ཐུན་མོང་ཁྱད་པར་ཆེས་ཆེར་རྒྱལ་བར་འགྱུར།",
    "གང་གི་ཐོས་པས་ལས་རྣམས་ཀུན་ལས་གྲོལ།",
    "བཙུན་མོ་འོད་འཆང་མ་ནི་ཕྱི་ལ་འབྲངས",
    "དྲི་མེད་དྲི་བྲལ་ཁྱོད་ནི་གར་བཞུད་པ",
    "རེ་ཞིག་ནས་མཁའ་འགྲོ་མ་བྱེ་བ་ཕྲག་བརྒྱས་ཨོཾ་ཌི་ཡ་ན་སྤྲིན་ནག་འདུ་བའི་དུར་ཁྲོད་དུ་སྤྱན་དྲངས་ནས་བསྟི་སྟང་དང་།",
    "ཁ་རག་གི་རིའི་དཀྱིལ་བཤགས།",
    "ཕྱིས་ཨ་ཏི་ཤས་དཀོར་མཛོད་གླིང་གི་རྒྱ་དཔེ་གཟིགས་པ་ན།",
    "བུམ་ཐང་དང་བྲག་ལོ་ཕྲང་སོགས་ལྷོ་མོན་ཕྱོགས་ལ་སྐུ་རྗེས་བརྒྱ་དང་བརྒྱད།",
    "ཉོན་ཅིག་ལྷ་མོའི་གཟུགས་ཅན་ཡིད་འོང་མ",
    "དེ་ལ་འདུན་ཞིང་མོས་གུས་སུས་བྱེད་པ",
    "ཞེས་སོགས་གསུངས་ནས་ཁྲ་འབྲུག་གི་ཁྱམས་སུ་སློབ་དཔོན་ང་འདྲ་མ་བཞེངས།",
    "བཞུགས་ཁང་པད་མ་སྤུངས་པ་འདི་ཉིད་སྤྲུལ་པའི་བཟོ་བོའི་རྣམ་རིག་གིས་བསྐྲུན་པའི་ངོ་མཚར་གྱི་བྱེད་པ་དང་མཐུན་པའི་རྐྱེན་ལས།",
    "བདག་གི་ཡབ་ཅིག་ཁྲི་སྲོང་ལྡེའུ་བཙན་དེ",
    "ཐལ་ཟིན་ལྡོག་ཏུ་མེད་པའི་འགྱོད་པས་སླེབས",
    "ཞེས་ཧ་ཅང་གདུང་བའི་ཚོར་བ་དྲག་པོ་ཉམས་སུ་མྱོང་བས་རྣམ་པར་ཤེས་པའི་ཚོགས་ཀྱང་རང་གི་མཚན་ཉིད་མི་འཛིན་པའི་ངང་དུ་བརྒྱལ་བ་ན།",
    "གོར་མོའི་རྡོ་ལ་ཞབས་རྗེས་ཟུང་ཅིག་ལྷམ་མེར་བཞག་པ་ལས།",
    "ཉོན་མོངས་ལྔ་ཡི་ཆུ་བོའི་རླབས་ཕྲེང་དང་།",
    "སྣ་ཚོགས་ལས་ཀྱི་འདུ་འགོད་བརྒྱ་ཕྲག་གིས།",
    "དོ་ཟླ་མ་ཡིན་རང་བྱུང་བྲག་གི་སྐྱིབས།",
    "མཐོང་བའི་མོད་ལ་ཚེ་འདིའི་སྣང་བ་འགག།",
    "ཆགས་སྡང་ཚིག་གི་ཚེར་མ་ལྟ་ཅི་སྨོས།",
    "ལྗོན་པ་མཆོག་གི་ཡལ་གའི་བསྟི་སྟང་ནི།",
    "འདབ་ཆགས་ཁུ་བྱུག་སྔོན་མོའི་རྒྱང་གླུ་ཡིས།",
    "དགའ་མ་ལང་ཚོ་དར་བས་ཁེངས་པས་ཀྱང་།",
    "བདག་གི་སེམས་ཀྱང་འཇམ་ཞིང་དེས་པར་དུལ།",
    "དྲང་སྲོང་དེ་ལ་ཐལ་མོ་སྦྱོར་བྱེད་ན།",
    "དེ་ལྟར་དབེན་པར་སོང་བའི་དགོས་པ་ཡང་།",
    "ཟབ་མོའི་དོན་ལ་མི་མཇེད་ཇི་ལྟར་སྐྱེ།",
    "རང་གིས་རང་ལ་ངོ་ཚའི་ཁུར་བཀལ་ཞིང་།",
    "རྒྱལ་པོའི་སྲིད་ཀྱང་མོད་ལ་བརླག་ནུས་ན།",
    "རྐུན་པོ་ལ་སོགས་གཞན་དང་ཐུན་མོང་བའི།",
    "རང་གིས་བསགས་པ་གཞན་གྱིས་སྤྱོད་མཐོང་ངམ།",
    "རབ་ཏུ་འཇིགས་པས་དབེན་པའི་གནས་སུ་སོང་།",
    "མཁའ་འགྲོ་རང་བཞིན་གྱིས་འདུ་བའི་བྲག་རིའི་བ་གམ་ཆེན་པོ་རིང་མོ་ཅན་ཞེས་བྱ་བའི་གནས་སུ།",
    "གཏི་མུག་གི་རང་བཞིན་ལ་ཤུགས་ཀྱིས་གོམས་པའི་རྣམ་འགྱུར་འགོག་ཏུ་མེད་པས་མིག་མ་ལྕིབས་ཀྱིས་འགེབས་ཤིང་བདག་ཉིད་ལ་མེལ་ཚེའི་འི་འདུ་ཤེས་བཞག་ནས་ཉལ་བ་ལ་སོགས་བྱེད་དོ།",
    "མིག་མ་ལྕིབས་ཀྱིས་འགེབས་པ་དང་སྦྲགས་ཤིན་ཏུ་འདྲིས་ཤིང་ཡིད་གཏོད་པའི་ཚུལ་དུ་ཇ་ཡུན་ཅིག་ཏུ་ཉེ་བར་ཙུག་གེ་བསྡད་སོང་ངོ།",
    "ཁྱོད་སྤུ་སྡུག་རྨ་བྱའི་ལང་ཚོ་ཅན།",
    "ཁྱོད་གཟུགས་སྡུག་སྤུ་མདངས་མཚར་ཆེ་ཡང་།",
