    "ཐོད་པ་གསུམ་གྱི་སྒྱེད་པུ་བྱས་ལ་རོ་ལངས་ཀྱི་ཆོ་གས་སམ་རང་གིས་ིབྱས་པས་སོ།",
    "མངོན་སྤྱོད་ཀྱི་རྫས་ནི་ལན་ཚྭ་དང་སྐེ་ཚེ་དང་དུག་དང་ལོང་ིཏང་གི་ཁུ་བའོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ནི་འདོད་ཆགས་ལ་སོགས་པའོ།་།",
    "རྡོ་རྗེ་འཆང་གི་བཀའ་ཞེས་པ་ནི་རྡོ་རྗེ་འཆང་གི་བཀའ་ལུང་ངོ།",
    "རིམ་པ་འདི་ཉིད་ཀྱིས་ལྷ་ལ་སོགས་པ་རྣམས་ཀྱི་ཡང་བུ་མོ་འགུགས་པར་འགྱུར་རོ་ཞེས་བྱའོ།",
    "དེ་ཉིད་བསྟན་པའི་ཕྱིར་བུ་མོ་ཞེས་བྱ་བ་འདི་ཉེ་བར་མཚོན་པ་ཙམ་ཞེས་བསྟན་ཏོ།",
    "ནང་གི་བདག་ཉིད་ལ་གཞོལ་བ་ཞེས་བྱ་བ་ནི་ཕྱི་རོལ་གྱི་རྫས་ལ་མི་ལྟོས་པ་ལ་འཇུག་པའོ།",
    "འདིར་བསྒྲུབ་པར་དཀའ་བ་ནི་ཚངས་པ་ལ་སོགས་པ་འཇིག་རྟེན་པའི་ལྷ་དང་འཇིག་རྟེན་ལས་འདས་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱང་སྒྲུབ་པ་༧ པོ་ལ་མི་གཟིགས་པ་ཞེས་བྱའོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཆེན་པོའི་རྣལ་འབྱོར་པས་ཞེས་བྱ་བ་ནས་ངེས་པར་འགུགས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་དུ་རྡོ་རྗེ་འཆང་གི་ཏིང་ངེ་འཛིན་མངོན་དུ་བྱས་ལ།",
    "རྡོ་རྗེ་དཀྱིལ་འཁོར་ཞེས་བྱ་བ་ནས་དགུག་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དུ་ནི་མི་བསྐྱོད་པའི་རྣལ་འབྱོར་པས་འདོད་པའི་རྒྱལ་པོ་ཡོངས་སུ་གྱུར་པ་ལས་རྡོ་རྗེ་ལྕགས་ཀྱུ་ལ་གནས་པའི་ལྷའི་བུ་མོ་བསམས་ཏེ་རྡོ་རྗེ་ལྕགས་ཀྱུའི་སྦྱོར་བ་དེ་ཉིད་ཀྱིས་དགུག་པར་བསམ་པར་བྱའོ།",
    "ངག་གི་བཟླས་པ་དང་རྡོ་རྗེ་བཟླས་པ་ཞེས་བྱ་བ་ནི་བཟླས་པ་གཉིས་སོ།",
    "དེའི་དཀྱིལ་འཁོར་པ་རྣམས་མོ་ཞེས་པ་ནི་དམ་ཚིག་གི་རིགས་ཀྱི་འཁོར་རྣམས་སོ།",
    "དེ་རྣམས་ཀྱི་གཙོ་བོ་སྟེ་ཞེས་པ་ནི་ཁྲོ་བོའི་རྒྱལ་པོ་བཙུན་མོ་ཡིན་པས་སོ།",
    "རིག་པ་འདི་ཞེས་བྱ་བ་ལ་སོགས་པས་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འཆང་གིས་གང་གི་ཚེ་རིག་པ་འདི་གསུངས་པ་དེའི་ཚེ་ཀླུའི་རྒྱལ་པོ་འཇོག་པོ་ཅིལ་སོགས་པ་དང་གཟུགས་བཟང་མ་ིལ་སོགས་པའི་ཀླུ་མོ་རྣམས་འགུགས་པར་འགྱུར་རོ་ཞེས་རིག་༧ པའི་མཐུ་བསྟན་ཏོ།",
    "དེ་ལ་འདིར་ཆོ་ག་འདི་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཀླུ་དང་ཀླུ་མོ་རྣམས་དགུག་པའི་སྦྱོར་བ་བསྟན་ཏོ།",
    "དེ་ལ་ཟླ་བ་རེ་ལས་འབྱུང་།",
    "སྔགས་བཟླས་བརྗོད་བྱས་ནས་ཞེས་པ་ནི་ཆེ་གེ་མོ་ཀླུ་ཨཱ་ཀརྟ་ཡ་ཧྲི་ཞེས་བྱ་བ་དང་ལྡན་པ།",
    "ཆོ་ག་ཞེས་བྱ་བ་ལ་སོགས་པས་ཀླུ་མོ་དགུག་པ་ཡང་བུད་མེད་ཀྱི་ཐོད་པ་ལ་ཐམས་ཅད་དེ་ལྟར་བྱའོ་ཞེས་བསྟན་ཏོ།",
    "གང་གི་མགོ་ལ་ཡོད་པ་ཞེས་པ་འདིས་ཁྲོ་གཉེར་མ་འོད་དཔག་ཏུ་མེད་པའི་རིགས་དང་ལྡན་པར་བསྟན་ཏོ།",
    "ཡང་ན་བསྐྲད་པ་ནི་རང་གི་གནས་ནས་དགར་བར་བྱའོ།",
    "རྡོ་རྗེ་འཆང་ཆེན་པོའི་རྣལ་འབྱོར་པ་ཡང་ཐལ་བའི་ཆུས་གཤེར་བའི་གོས་གོན་པས་ལས་ིབྱའོ།",
    "ཚངས་མ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་འཇིག་རྟེན་གྱི་མ་མོ་བདུན་ནོ།",
    "དེ་རྣམས་ཀྱི་ཁང་པ་ནི་ལྷ་ཁང་སྟེ་མ་མོ་ནི་དྲག་པོའི་ལས་ལ་མཐུན་པས་སོ།",
    "ཐོད་པ་ཞེས་བྱ་བ་ནས་སྡུད་པར་བྱེད་པའི་ཚིག་གི་བར་དུ་ནི་མ་ཉམས་པའི་ཐོད་པའམ་གྲོ་ག་ལ་སོགས་པ་ལ་མངོན་སྤྱོད་ཀྱི་རྫས་ཀྱིས་ཁྲོ་བོའི་སྔགས་མིང་དང་བཅས་པར་བསྒྲུབ་བྱའི་མིང་བྲིས་ཏེ།",
    "ཁྲོ་བོའི་ཚིག་གིས་གཤིན་རྗེ་གཤེད་ལ་སོགས་པའི་སྔགས་བཟླ་ཞིང་དགྲ་བོའི་སྒོ་རུ་བརྐོས་ནས་སྦས་ན་དེའི་ཚེ་གནས་ལས་སྤོ་བའམ་འཆི་བར་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "ཁྲོ་བོའི་རྒྱལ་པོའི་ལུས་ལས་བྱུང་བའི་འབར་བའི་ཚོགས་ཀྱིས་ཀྱང་དེའི་འཁོར་མཐའ་ཡས་པ་བསྲེགས་ཤིང་ཐལ་བར་གྱུར་པར་བསམ་པར་བྱའོ་ཞེས་བསྟན་པར་བྱའོ།",
    "དམ་པའི་ཞལ་ནས་ཟབ་མོའི་གདམས་ངག་ལོངས།",
    "ཨ་མ་བདེ་གསལ་ལྷ་མོ་འབྲལ་བ་མེད།",
    "རྟག་ཏུ་ཟབ་མོའི་རིམ་གཉིས་ལམ་འདིར་སྒོམས།",
    "ཐབས་ཤེས་ཟབ་མོ་གཉིས་ལས་འདའ་བ་མེད།",
    "ཕ་མ་དྲན་ན་རང་གི་སེམས་ལ་ལྟོས།",
    "བློ་འདས་དབྱིངས་ན་ཕ་མ་ཡོད་རེ་ཀན།",
    "ཟབ་མོའི་དོན་བཟང་ལྷུག་པར་མཚོན་པ་དང་།",
    "སྙན་འཇེབས་ཚིག་གི་བུ་རམ་རོ་མངར་བའི།",
    "ཚིག་སྦྱོར་ཚུལ་ལ་མཁས་པའི་ངག་གི་དཔལ།",
    "ཞེས་གསུངས་པ་ལྟར་སྙན་ངག་གི་ཉམས་དང་ལྡན་པའི་ཚིག་སྦྱོར་མེད་ན།",
    "ཤེས་བྱའི་གནས་གཞན་ལ་ཅི་ཙམ་མཁས་ཀྱང་ནེ་ཙོའི་ཀློག་གི་ཚུལ་ལས་མ་འདས།",
    "སྙན་ངག་གི་ལམ་ནས་སྤེལ་བའི་ཕྱག་རྩོམ་ཡང་བགྲང་གིས་མི་ལང་བ་མཛད་འདུགད་རེས་མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་པར་སྐྲུན་བྱེད་འཆར་ཡོད་པའི་སྔོན་བྱོན་མཁས་པའི་ངག་རིག་རིན་ཆེན་གཏེར་མཛོད་ཅེས་པ་འདི་རུ།",
    "སྔོན་བྱོན་བོད་ཀྱི་ངག་རིག་མཁས་པའི་སོར་མོའི་འདུ་བྱེད་ཀྱི་རྩལ་ལས་བྱུང་བའི་བཅད་ལྷུག་སྤེལ་མ་གསུམ་གྱི་ལྗགས་རྩོམ་ཅི་རིགས་བཀོད་ཡོད་ཅིང་།",
    "ལ་ལར་ཤར་པའི་སྙན་ངག་མཁན་གྱི་རྩོམ་རིག་གི་ཉམས་འགྱུར་ལྡན་པ་དང་།",
    "ལ་ལར་ལྷོ་པའི་སྙན་ངག་མཁན་གྱི་རྩོམ་རིག་གི་ཉམས་འགྱུར་ལྡན་པ།",
    "ལ་ལར་ཤར་ལྷོ་ཟུང་གི་རྩོམ་ཉམས་འདྲེས་མར་སྤེལ་བ།",
    "ངག་རིག་གི་དགའ་ཚལ་སྔར་ལས་ལྷག་པར་རྒྱས་པར་སྨོན་པ་དང་བཅས་སྨྲས་པ།",
    "ཞིབ་མོའི་བློ་ཡིས་བདམས་འདི་དོན་དང་ལྡན།",
    "དབྱངས་ཅན་ངག་གི་སྙན་ཚིག་དགྱེས་པའི་གདངས།",
    "ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པས་བསྡུས་པའི་རྒྱན་གྱི་བྱེ་བྲག་མཐའ་ཡས་པའི་སྙན་ངག་གང་ཞིག་ཅེས་དང་།",
    "ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པས་བསྡུས་པའི་རྒྱན་གྱིས་བཅིངས་པ་ཞིག་ལ་སྙན་ངག་གམ་ངག་རིག་གི་ཐ་སྙད་དུ་འབོད་པས།",
    "དེང་སང་འུ་ཅག་གིས་འདོད་པའི་རྩོམ་རིག་དང་འདྲ་ཆེ་ཞིང་།",
    "དེབ་ཚོགས་འདི་སྒྲིག་སྐབས་སྤྱིར་སྲོལ་རྒྱུན་རྩོམ་རིག་དང་དེང་རབས་རྩོམ་རིག་གི་ས་མཚམས་ནི་དུས་ཀྱིས་ཕྱེ་ན་ཡང་།",
    "ངེད་ཅག་གིས་དུས་ཀྱི་དབྱེ་བ་ལས་གཞན།",
    "རྗོད་བྱེད་ཚིག་གི་སྦྱོར་བ་གསུམ་ལས་རྗོད་བྱེད་ཚིག་གི་སྦྱོར་བ་བོད་ཀྱི་སྐད་དང་ཡི་གེ་ཡིན་ནབོད་ཀྱི་རྩོམ་རིག་ཡིན་པར་གཞིར་བྱས་ནས།",
    "དེའི་ཕྱོགས་ནས་སྲོལ་རྒྱུན་དང་དེང་རབས་ཀྱི་ཀློག་པ་པོའི་མོས་པ་དང་བསྟུན་ནས་གཉིས་ཆ་ནས་བདམས་ཡོད།",
    "བོད་ཡིག་གི་ལམ་ནས་རྩོམ་པའི་རྒྱ་གར་དང་སོག་པོ་བཅས་ཀྱི་རྩོམ་པ་པོ་འདུས།",
    "ལུས་རྟེན་གྱི་ཆ་ནས་ཕོ་མོ་གཉིས་ཀ་ཡོད།",
    "ཡང་མཁས་པ་རེ་རེའི་རྩོམ་གྱི་སྒྲིག་སྟངས་ལ་ཐོག་མར་བསྟོད་ཚོགས་ཀྱིས་དབུ་དྲངས་ཏེ།",
    "བསྟོད་ཚོགས་ལ་མཚོན་ན་སྔར་གྱི་མཁས་པའི་གསུང་འབུམ་དུ་ཐོག་མར་ཡུམ་ཆེན་མོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་བསྟོད་པ།",
    "ཡང་ཐུན་མོང་མ་ཡིན་པ་གསང་བ་སྔགས་ཀྱི་ལུགས་དང་།",
    "ཡུལ་ལྷ་གཞི་བདག་གི་དང་།",
    "སྔོན་བྱོན་མཁས་པའི་ངག་རིག་རིན་ཆེན་གཏེར་མཛོད་ལ་ཁྱོན་པོད་ཉི་ཤུ་ཡོད་པ་ལས།",
    "མངོན་བརྗོད་ཆུ་བོ་སྟོང་གིས་ཡོངས་སུ་འཁྱུད།",
    "བསྟོད་པ་སྙན་ཚིག་དཔྱིད་ཀྱི་རྒྱལ་མོའི་རྒྱང་གླུ།",
    "བསམ་ཡས་གཙུག་ལག་ཁང་གི་གཏམ།",
    "གཞོན་ནུ་ནོར་བཟང་གི་རྟོགས་བརྗོད།",
    "རང་གི་སྤྱོད་ལམ་རང་གིས་ཁྲེལ་ནས་སྨྲས།",
    "ལྷ་མོ་གསེར་ཁྲི་བློ་བཟང་རྒྱལ་མཚན་སེངྒེ།",
    "འཕྲིན་ཡིག་གི་སྐོར་ཕྱོགས་གཅིག་ཏུ་བཀོད་པ།",
    "ཡུལ་མཆོག་དམན་དུ་མ་ལ་ཕུལ་བའི་སྤྲིངས་ཡིག་གི་སྐོར་སྒྲ་དོན་རྒྱན་གྱི་རོལ་མཚོ།",
    "མཚན་མོའི་འཕྲུལ་འཁོར་སེལ་བའི་ཆོ་ག་མཇུག་ཏུ་ཞུ་བའི་གཏམ།",
    "ཡན་ལག་གཅིག་པའི་གཟུགས་ཅན་ཐལ་འགྱུར་རྩ་རྒྱུད་རྨ་བྱའི་རུམ་ནས་འབྱུང་འགྱུར་ལུང་གི་ལྔ་ལྡན་སྒོ་ང་བརྡོལ་བ་ལས།",
    "ཕྱག་གིས་བླངས་ཤིང་འཕྲལ་རྐྱེན་མི་བསྲུན་བཅོམ།",
    "ཆ་ཤས་གཟུགས་ཅན་མངོན་སུམ་རྗེས་དཔག་འགལ་གྲུབ་བརྒལ་བརྟག་གི།",
    "སྐྱེས་པ་བུད་མེད་རི་ཤིང་རྒྱ་མཚོ་གོས་ནོར་རྟ་དང་གླང་ཆེན་སོགས།",
    "བརྟག་པ་བརྒྱད་ཀྱི་སྐྱེད་མོས་ཚལ་དུ་རྩེད་འཇོར་རོལ་པ་ཀློང་ཆེན་པ།",
    "སྒྲ་དབྱངས་ལྷ་མོ་འཇམ་པའི་རྡོ་རྗེ་ཡི།",
    "ཞལ་གཟིགས་ལུང་བསྟན་མངོན་གྱུར་ཀློང་ཆེན་པ།",
    "རང་གི་ངོ་བོ་སྟོན་པའི་སྲིད་པ་ཅན་ཨེ་དབྱིངས་ཤེས་རབ་གཎྜིའི་ཚལ་དུ་ཐབས་མཆོག་བདེ་གསལ་ཝཾ་ཡིག་གསར་བའི་ལེ་ཁ་ནིས།",
    "སྒྱུར་བགོད་ཕྲི་བསྣན་རྣམ་འགྱུར་བརྒྱ་ཡིས་རི་མོའི་གར་སྟབས་རྣམ་དག་གྲུབ་པས་བསྒྱུར་པ་ལས།",
    "གོ་ལའི་ངོས་ཀྱི་དྲང་སྲོང་རྒྱུ་སྐར་བཅུ་གཉིས་ཁྱིམ་དུ་དུས་བཞིའི་ལྟད་མོར་རྩེ་བ་མཐོང་།",
    "ལེའུ་དང་པོའི་ལྷོ་ཕྱོགས་བེ་དརྦྷའི་རབ་དྭངས་དང་ཁྱད་འཕགས་ཕུལ་བྱུང་བསྲེས་པ་རང་ལྟ་མཆོག་འཛིན་ཕྱོགས་རེའི་མིག་ཅན་ལྟ་གྲུབ་སྒོ་ངའི་སྦུབས་ལས་གྲོལ།",
    "ཀློང་ལྔའི་བདག་ཉིད་རྒྱལ་ཡུམ་འཕགས་མ་ཡིད་བཞིན་འཁོར་ལོས་ཞལ་གཟིགས་ལུང་བསྟན་ཀློང་ཆེན་པ།",
    "ནོར་འཛིན་བུ་མོའི་འགྲམ་པར་ཁྱུང་སྔོན་སྐྱེས།",
    "སྤུ་སྡུག་འཇའ་ཚོན་རི་མོས་བཀྲ་བའི་སྒྲོ་གཤོག་ཟླུམ་པོའི་རྨ་བྱ་མིན།",
    "ལུང་རྟོགས་ཡོན་ཏན་ཐིག་ལེ་མཆོག་མའི་བཞིན་གྱི་དཀྱིལ་འཁོར་མཐོང་བའི་མོད།",
    "དེ་ཉིད་བརྗོད་པའི་དཔེ་རྒྱན་ཕྱི་ནང་གཞུང་ལུགས་མང་དུ་ཐོས་པ་ལུང་གི་ཡོན་ཏན་ཕ་མཐའ་མི་དཔོག་འཛམ་བུ་ཆུ་བོའི་སུ་ཝརྣ།",
    "རྨད་བྱུང་གི་ཉམས་ལ་སྙམ་སྒྲས་མཛེས་པར་བྱས་པ་ཏིང་འཛིན་གྲུབ་པའི་དྲང་སྲོང་རྒན་པོའང་གནྡྷརྦ་ཡི་གླིང་བུས་སད།",
    "ཁེངས་པས་དྲེགས་པའི་འཁོར་ལོས་སྒྱུར་ཡང་ལྗོངས་རྒྱུའི་ཟོལ་གྱིས་ལྟད་མོར་ལྷགས།",
    "རྒྱུའི་དཔེ་རྒྱན་ཕྱོགས་རེའི་ལྟ་གྲུབ་སྨོན་པའི་ཆུ་ཡིས་ལྟོ་བ་སྦོས་པའི་ཀརྐ་ཊས།",
    "གསང་རྒྱུད་རྒྱ་མཚོར་འོལ་ཚོད་མཛུབ་མོས་ལོག་སྨྲའི་ཚད་དུ་དཔོག་པའི་ཚེ།",
    "བསྟན་ལ་རི་མོར་བགྱིས་པ་ཡིན་ནོ་གྲགས་པ་དོན་ལྡན་ཀློང་ཆེན་པ།",
    "གཏད་མེད་རང་གྲོལ་སྤྱོད་པར་གོམས་པས་རེ་དོགས་ཆོམ་རྐུན་ཟིལ་གྱིས་མནན།",
    "དེ་ཉིད་བརྗོད་པ་དང་ཕུལ་བྱུང་བསྲེས་པའི་རྒྱན་ཁྱོད་ཀྱི་སྤངས་རྟོགས་ནམ་མཁའི་མཐས་ཀྱང་ཐུག་པ་མེད་པའི་ངོ་མཚར་གཏམ་གྱི་བི་རོ་ཙ།",
    "གླིང་བཞིའི་སྣང་བྱེད་ཉི་ཟླ་ཟུང་གིས་ནོར་འཛིན་བུ་མོའི་རྣ་བའི་རྒྱན་དུ་བཏགས་པ་ལས།",
    "རབ་རྟོག་དོགས་སྒྲ་ཅན་མཚུངས་གང་གིས་རྒྱན་དྲུག་མཆོག་གཉིས་ཞུམ་ནུས་པའི།",
    "གཟུགས་སྐུའི་མཆོད་སྡོང་དཔལ་གྱི་མཆིམས་ཕུར་གདུང་ཆེན་ལྔ་དང་རིང་བསྲེལ་ཕྲ་མོའི་འབྱུང་གནས་སུ།",
