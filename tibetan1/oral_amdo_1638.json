    "དེ་ལྟར་རེ་ཞིག་མ་དཔྱད་ན་དགའ་བའི་བྲམ་ཟེ་ཉིད་ཁས་བླངས་ནས་སུན་འབྱིན་པ་བརྗོད་དོ།",
    "གང་ཞིག་རང་གི་ངོ་བོ་ཡིས།",
    "དེའི་རང་བཞིན་ལས་མ་རེག་པའི་རིག་པས་ཀྱང་གལ་ཏེ་རིག་པ་མ་ཡིན་ན་ནི་ཐམས་ཅད་ཀྱིས་ཐམས་ཅད་རིག་པར་འགྱུར་རོ་སྙམ་དུ་བསམས་པའོ།",
    "རང་གི་ངོ་བོ་མེད་པ་ལ།",
    "གང་གི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གལ་ཏེ་འབྲས་བུ་མཐོང་བ་ལས་ཀྱང་ཚོགས་པ་ཡིན་ནོ་ཞེས་ངེས་པར་མི་ནུས་པ་མ་ཡིན་ནམ།",
    "གང་གི་ཚེ་གསེར་ལ་སོགས་པ་ཞེས་བྱ་བའོ།",
    "མངོན་སུམ་ཁྱད་པར་ཇི་ལྟ་བུ་ཞིག་གིས་ཤེ་ན།",
    "འོ་ན་ཁ་དོག་དང་དབྱིབས་ལ་སོགས་པ་ཐུན་མོང་བ་དང་ལྡན་པ་གཞན་ཡང་བྲམ་ཟེར་འགྱུར་མོད།",
    "གང་གི་ཚེ་བྲམ་ཟེ་མ་ཡིན་པ་ལས་རྣམ་པར་བཅད་པའི་བྲམ་ཟེ་གནས་པ་མེད་པ་དེའི་ཚེ།",
    "དེའི་ཚེ་ཡང་དོགས་པ་སྔོན་དུ་སོང་བའི་རིགས་ལ་སོགས་པ་བརྟགས་པ་དོན་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ཡིན་ན་ནི་ཐམས་ཅད་བྲམ་ཟེ་ཉིད་དུ་ཐལ་བའི་ཕྱིར་རོ།",
    "རེ་ཞིག་དང་པོར་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་ལ་འཇུག་པའོ།",
    "གང་གི་ཚེ་མངོན་སུམ་ནུས་པ་མེད་པ་དེའི་ཚེ་ཉེ་བར་བསྟན་པ་ལས་ལོགས་སུ་སྐྱེས་བུའི་བྱེད་པ་མེད་པས་ནི་དོན་གྲུབ་པ་གང་ཡིན་ཡང་ཅི་ལྟར་ཉེ་བར་བསྟན་པ་གཅིག་པུའི་སྐྱབས་ཅན་ཡིན་ནོ་ཞེ་ན།",
    "གཞན་གྱི་ཧ་ཅང་ཐལ་བའི་ལན་དོགས་པ་ནི།",
    "གང་གི་ཚེ་འོད་སྲུངས་ལ་སོགས་པའི་རུས་དག་ཐ་དད་པ་ཐོག་མ་མེད་པ་ཉིད་ཡིན་པ་དེའི་ཚེ།",
    "བྱ་བ་བྱ་མིན་ཉིད་དུ་ཐལ།",
    "དེ་ལྟར་རེ་ཞིག་རྣམ་པར་མ་ཆད་པ་ཉིད་གླང་པོ་ཆེའི་ལྟ་སྟངས་ཀྱིས་བཏང་སྙོམས་སུ་བཞག་ནས་བྱ་བ་དང་ཐོག་མ་མེད་པ་ཉིད་ལ་ཐེ་ཚོམ་ཟ་བར་བརྗོད་པ་ཡིན་ནོ།",
    "བྲམ་ཟེ་མོ་དང་རྒྱལ་རིགས་ལས་སྐྱེས་པ་ནི་སུ་ཏའོ།",
    "བྲམ་ཟེ་མོ་དང་རྗེའུ་རིགས་ལས་སྐྱེས་པ་ནི་མ་རྐ་ཏ་ཞེས་བྱ་བ་སྟེ་གཏིང་རིངས་སོ།",
    "བྲམ་ཟེ་མོ་དང་དམངས་རིགས་ལས་སྐྱེས་པ་ནི་གཏུམ་པོ་ཞེས་བྱ་བ་ནི་དེ་དག་གི་གཙུག་ལག་གོ།",
    "དི་ཤེས་པས་ཞེས་བྱ་བ་ནི་དེ་ཤེས་པ་ལ་འབད་པ་དང་ལྡན་པ་དག་གིས་སོ།",
    "ཐམས་ཅད་དུ་སོང་བའི་ཁྱད་པར་གསལ་བར་བྱ་བ་ནི།",
    "གང་གི་ཕྱིར་དོན་དམ་པར་བྲམ་ཟེ་མ་གྲུབ་པའི་རྒྱུ་དེས་ནའོ།",
    "འགའ་ཞིག་གི་ལ་ཞེས་བྱ་བ་ནི་བྲམ་ཟེའི་འོ།",
    "གལ་ཏེ་རང་གི་ལུས་ཉིད་ལ་རིག་བྱེད་ཀྱི་རྗེས་སུ་སྒྲུབ་པ་གཞན་དང་གཞན་རྒྱུན་མི་འཆད་པ་ཡིན་ན།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་ལྟར་གསུམ་པོ་རྣམས་ཀྱི་ཕན་ཚུན་ལྟོས་པའི་མཚན་ཉིད་འབྲེལ་པ་ཡིན་མོད།",
    "རང་གི་བྱ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་དག་གིས་ཕན་ཚུན་འབྲེལ་པའི་མཚན་ཉིད་ཀྱི་འབྲེལ་པ་ནི་རིག་བྱེད་ཀྱིས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ཉིད་ངེས་སྦྱོར་སྨྲ་བ་རྣམས་ཀྱང་ངེས་སྦྱོར་དུ་རྣམ་པར་གནས་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྟོགས་པའི་དུས་ན་ཞེས་བྱ་བ་ནི་ངག་གི་དོན་རྟོགས་པའི་དུས་ནའོ།",
    "འོ་ན་ཁམས་ཀྱི་དོན་ལ་སོགས་པ་གནས་པའི་འབྲེལ་པ་ཉིད་དོན་ཡིན་པར་འགྱུར་མོད།",
    "གལ་ཏེ་འབྲེལ་པ་ཅན་གཅིག་མེད་ཀྱང་འབྲེལ་པ་མེད་པ་རང་གི་ངོ་བོ་སྣང་བར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "དེས་ན་ཅི་ལྟར་འབྲེལ་པ་ངག་གི་དོན་ཡིན་ན་དམིགས་པ་མེད་པར་ཐལ་བར་འགྱུར་ཞེས་དོགས་པ་ལ།",
    "རང་གི་ངོ་བོར་སྣང་བ་ནི་ཡོད་པའི་ཡུལ་ཅན་སྣང་བའི་ཕྱིར་དང་ཞེས་སྨོས་སོ།",
    "ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ་སྙམ་དུ་དགོངས་པའོ།",
    "རྟོགས་པའི་དུས་ན་ཞེས་བྱ་བ་ནི་ངག་གི་དོན་རྟོགས་པའི་དུས་ནའོ།",
    "དེ་ལྟར་བྱེད་པ་པོ་ཉིད་རྟོགས་མོད།",
    "གང་གིས་སྦྱོར་བར་བྱེད་པ་ཉིད་ཡིན་པས་མེད་པ་རྗོད་པར་བྱེད་པའི་མཉན་པ་དམིགས་པ་མེད་པ་ཉིད་དུ་འགྱུར་བ་བྱེད་པ་པོ་ཉིད་དུ་བསྐུལ་བར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "རུང་བ་ཉིད་ཀྱི་ཡུལ་རང་གི་བྱ་བ་ཅན་ནོ།",
    "མཆོད་སྦྱིན་ལ་སོགས་པ་རང་གི་བྱ་བ་ཡོད་པ་དེ་ནི་རང་གི་བྱ་བ་ཅན་ནོ།",
    "གང་གི་ཕྱིར་གཞན་གནའ་རབས་དག་གིས་བརྗོད་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ངེས་སྦྱོར་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིགས་སུ་བཅད་པ་གསུམ་མོ།",
    "ཁམས་ཀྱི་དོན་དང་མཐོ་རིས་འདོད་པའི་ཁྱད་པར་ཐ་དད་པ་གཉིས་ལ་ལྟོས་པས་དག་པ་ཉིད་ཉམས་པ་མ་ཡིན་མོད།",
    "རང་གི་ངོ་བོར་གྱུར་པའི་སྐུལ་བྱེད་ཉིད་ལ་ལྟོས་ནས་གོ་ཅི་སྟེ་མི་ཉམས་ཤེ་ན།",
    "དེས་ན་དེ་དག་གི་སྦྱོར་བ་སྟེ།",
    "དེས་ན་གཉི་ག་ལས་གྲོལ་བའི་ངེས་སྦྱོར་དག་གི་དོན་ཡིན་ནོ།",
    "ལོངས་སྤྱོད་པར་བྱེད་པ་དག་གིས་འབྲེལ་པར་ངེས་སྦྱོར་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བ་ལང་བཞིན་དུ་བདེ་བའི་བདག་པོ་ནི་ཡིན་ནོ་ཞེས་སྟོན་པ་ནི།",
    "གང་གི་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "སྤྱིར་བསྒྲུབ་བྱའི་རང་བཞིན་ཉིད་དུ་ཉེ་བར་མཚོན་པའི་རང་བཞིན་གང་གིས་དེའི་ཞེས་རྟོགས་པ་དེ་ཡང་ཞེས་བྱ་བ་ནི་ལྷག་མའོ།",
    "དེ་ལྟར་ངེས་སྦྱོར་ངག་གི་དོན་དུ་རྣམ་པར་བརྟགས་ནས།",
    "ངག་གི་དོན་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གང་གི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གང་གིས་ངེས་སྦྱོར་དུ་འགྱུར་བ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཡིན་པ་དེའི་ཕྱིར།",
    "གང་གིས་གཞན་དག་ཀྱང་བསལ་བ་གྲུབ་པར་འགྱུར་བ།",
    "འབྲེལ་པ་དང་ཚོགས་པའི་ཕྱོགས་རྣམས་སྤངས་ཏེ།",
    "ཐམས་ཅད་དུ་བྱ་བ་དང་ལྡན་པའི་སྐྱེས་བུ་མ་རྟོགས་པ་ཐུན་མོང་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བའི་ཚིག་གིས་ཀྱང་།",
    "དེ་ལ་གལ་ཏེ་ངེས་སྦྱོར་དག་གི་དོན་ཡིན་ན།",
    "སྣང་ན་ནི་ད་ལྟར་བ་ཉིད་དུ་འགྱུར་བས་མི་འཇུག་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་སྦྱོར་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྗེས་སུ་བརྗོད་པའི་ངག་གི་ནང་དུ་འདུས་པ་སྐྱེས་བུའི་བྱེད་པའི་སྒྲ་དང་།",
    "ངག་གི་བྱེད་པའི་ཕྱོགས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གཞན་གྱིས་བརྗོད་པ་ཉིད་འདྲི་བར་བྱེད་པ་ནི་ངག་གི་བྱེད་པའི་ཕྱོགས་ལ་ནི།",
    "དེ་ནིའི་སྒྲ་ནི་དང་གི་དོན་ནམ་ཁྱད་པར་གྱི་དོན་ཏོ།",
    "གང་གི་ཚེ་སྒྲའི་བྱེད་པ་ངག་གི་དོན་དུ་གྱུར་པས་ན།",
    "རང་གི་བྱ་བ་ལ་འཇུག་ན།",
    "རང་གི་བྱ་བ་ལ་འཇུག་ན།",
    "སྐྱེས་བུ་རང་གི་བྱ་བ་ལ་འཇུག་ན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རང་གི་བྱ་བ་དེ་ལ་ཡང་སྒྲས་བསྐུལ་བའམ་མ་ཡིན་ན།",
    "དིའི་ཚེ་ཞེས་བྱ་བ་ནི་ངག་གི་དོན་རྟོགས་པའི་དུས་ནའོ།",
    "རྟོགས་པའི་དུས་ན་ཞེས་གསུངས་ཏེ་ངག་གི་དོན་རྟོགས་པའི་དུས་ནའོ།",
    "གལ་ཏེ་རྣམ་པར་རྟོག་པ་ལ་གནས་པའི་རང་བཞིན་ཉིད་མཐོ་རིས་ཀྱི་རང་གི་ངོ་བོ་ཡིན་ན།",
    "བྱེད་པ་པོ་ཉིད་ཀྱིས་འབྲས་བུར་འགྱུར་བ་ནི་རེ་ཞིག་སྤང་བར་དཀའ་བའོ།",
    "བརྗོད་པར་བྱ་བ་ཉིད་ཀྱང་དངོས་སུ་མ་ཡིན་མོད་རྟོགས་པར་བྱ་བ་ཙམ་དུ་ནི་མི་འཐད་པ་མེད་དོ་ཞེས་བྱེད་པའོ།",
    "གལ་ཏེ་སྒྲས་བདག་ཉིད་ངེས་པར་སྦྱོར་བར་རྟོགས་ན་དེའི་ཚེ་ངེས་པར་སྦྱོར་བ་ཉིད་ངག་གི་དོན་དུ་ཐལ་གྱི།",
    "འདི་ཉིད་གསལ་བར་བྱེད་པ་ནི་རང་གི་ངོ་བོས་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གང་གི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དེ་ལྟ་ན་ཡང་རང་གི་འདོད་པ་ཁོ་ནས་སྐྱེས་བུ་འཇུག་པ་ཡིན་ནོ།",
    "ངེས་པར་སྦྱོར་བར་བྱེད་པ་པོའི་རྟོགས་པ་དམིགས་པ་མེད་པར་འགྱུར་མོད།",
    "རང་གི་བྱ་བས་སྟོང་པར་བདག་ཉིད་རྟོགས་པར་གསུངས་སོ།",
    "གང་གིས་གནོད་ཅེ་ན།",
    "དེའི་རང་གི་ངོ་བོ་སྣང་བ་ཡིན་ན།",
    "བདག་གི་དེ་ལྟར་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "བདག་གིས་ཞེས་བྱ་བ་ནི་ངེས་པར་སྦྱར་བྱས་སོ།",
    "ཁྱབ་འཇུག་གི་ལུང་ལ་སོགས་པ་ནི་སྐྱེས་བུས་བྱས་པར་གྲགས་པས་ན།",
    "གང་གིས་འདི་ལྟར་བརྗོད་པ་རང་གིས་མ་བྱས་པར་བདག་གིས་བྱས་སོ་སྙམ་པར་འཁྲུལ་པ་མཐོང་བ་ཡོད་དམ་སྙམ་དུ་དོགས་ན།",
    "རློམ་པར་འགྱུར་བ་འགའ་ཞིག་གི་རློམ་པའི་རྣམ་པ་སྨྲས་པ་ནི་ང་ཡིས་བྱས་པ་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་རང་གིས་བྱ་བར་སྟོན་པར་བྱེད་པ་པོ་མ་ཡིན་ན་ནི་དེའི་ཚེ་དེ་ལ་ཡང་འདིར་ནི་སྔར་ཡོད་པ་ཁོ་ན་ཡིན་གྱི།",
    "ཡང་ན་ཅི་གནའ་ཉིད་དུ་གནས་པའི་ལུང་ལ་སྤྱོད་པའི་རང་བཞིན་ཅན་རྨོངས་པས་རང་གིས་བྱས་པར་བརྗོད་ཅེས་འདིར་ཡང་ངེས་པ་མེད་དོ།",
    "ལུང་འདི་ནི་ཁྱབ་འཇུག་གིས་བྱས་སོ་ཞེས་བྱེད་པ་པོ་བརྗོད་པ་དོགས་པ་མེད་པར་འགྱུར་བ་དེས་ན་བྱེད་པ་པོ་སྟོན་པར་བྱེད་པ་མི་བརྗོད་པར་འགྱུར་ན།",
    "དེ་དོན་མེད་པ་ཉིད་མཐོང་ཞེས་བྱ་བ་ནི་རི་བོ་རིག་ལ་ནི་རིག་གི་རིག་བྱེད་བྱས་ལ།",
    "དོན་གཞན་དུ་རྟོགས་ན་ཞེས་བྱ་བ་འདི་ལ་ནི་ལན་བཏབ་ཟིན་མོད་ཀྱི་ལྷག་པ་བརྗོད་པའི་དོན་དུ་རྗེས་སུ་བརྗོད་པ་ཡིན་ནོ།",
    "རིག་བྱེད་དེར་ལྷ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་གཙུབ་ཤིང་ལ་སོགས་པ་བདེན་པའི་དོན་དུ་རྟོགས་པ་ནི་འཆད་པར་བྱེད་པའི་སྐྱེས་བུས་བྱ་བ་ཁོ་ནའོ།",
    "གལ་ཏེ་གང་དུ་དང་པོ་པ་མི་སྲིད་པ་དེར་ཐེ་ཚོམ་དུ་འགྱུར་མོད་གང་དུ་དོན་དང་པོར་སྲིད་པ་དེར་གོ་ཅི་ལྟར་ཐེ་ཚོམ་ཟ་ཞེ་ན།",
    "རེས་འགའ་ཙི་ཏྲའི་མཆོད་སྦྱིན་བྱས་ཀྱང་ཕྱུགས་ཕུན་སུམ་ཚོགས་པ་མ་ཐོབ་པའི་ཕྱིར་རོ།",
    "རེས་འགའ་ནུས་པ་མཐོང་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེ་ལྟར་དོན་གཞན་རྟོགས་པ་སྐྱེས་བུས་བྱས་པར་འགྱུར་མོད།",
    "གང་གི་ཕྱིར་སྦྱིན་སྲེག་གྱིས་ཤིག་ཅེས་ཟེར་བའི་རིག་བྱེད་ལས་བདག་ཉིད་ངེས་པར་སྦྱར་རོ་སྙམ་པའི་འཇིག་རྟེན་ཐམས་ཅད་ནི་བརྡའི་རྗེས་སུ་འབྲངས་པ་ཡིན་པས་དེའི་ཕྱིར་སྦྱིན་སྲེག་གྱིས་ཤིག་ཅེས་བྱ་བ་ལ་སོགས་པ་ཟེར་བའི་རིག་བྱེད་དུ་ངེས་པར་སྦྱོར་བ་ཉིད་དུ་རྟོགས་པ་ནི་སྐྱེས་བུས་བྱས་པ་ཁོ་ནའོ།",
    "ངེས་སྦྱོར་ངག་གི་དོན་ཡིན་པ་ལ་ཡང་ཉེས་པ་འདི་མཚུངས་སོ་ཞེས་བསྟན་པའི་ཕྱིར་ངེས་པར་སྦྱོར་བའི་སྒྲར་བྱས་ནས་གསུངས་སོ།",
    "ཀྱང་གི་སྒྲ་ནི་རིམ་པ་གཞན་དུ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་བརྗོད་མ་ཐག་པའི་ཚུལ་དེ་ལྟར་ཡིན་ན་རིམ་གྱིས་རྟོགས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་རིམ་གྱི་རྟོགས་ལ་རག་མོད་ཉེས་པ་ཅི་ཡོད་ཅེ་ན།",
    "རེ་ལྡེ་ལ་སོགས་པའི་ལས་གཅིག་པའི་ཕྱིར་ན།",
    "ཅི་ལྟར་བྱ་བར་འགྱུར་ཞེས་བྱ་བ་ནི་གཅིག་གི་ཚིག་གིས་མང་པོའི་ཚིག་ཏུའོ།",
    "འོ་ན་ནི་ཅི་ལྟར་རེ་ལྡེ་གྱིས་ཤིག་ཅེས་བྱ་བ་གཉིས་ཀྱི་ཚིག་ཏུ་འགྱུར་བ།",
    "དེ་བཞིན་དུ་ལྷས་བྱིན་དང་མཆོད་སྦྱིན་དག་གིས་རེ་ལྡེ་བྱེད་དོ་ཞེས་བྱ་བ་འདིར་ཡང་འགྱུར་རོ་ཞེ་ན།",
    "རང་གི་འདོད་པས་གཞུང་གཟུགས་པའི་ཕྱིར་གསུངས་པ་ནི།",
    "ཁོ་བོ་ཅག་གི་ལྟར་ན་ཞེས་བྱ་བ་བའོ།",
    "གང་གི་ཚེ་བརྗོད་པ་ཞེས་བྱ་བ་ནི་བྱེད་པ་པོ་ཞེས་འབྲེལ་ཏོ།",
    "གང་གི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་བསྡུ་བའི་ཚིགས་སུ་བཅད་པ་གཉིས་སོ།",
    "གཙོར་གྱུར་པ་མ་ཡིན་པའི་ཕྱིར་ནི་ངག་གི་དོན་ཉིད་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་ངེས་སྦྱོར་ངག་གི་དོན་དུ་བྱེད་པའི་ཚེ་ཡང་ངེས་སྦྱོར་ཉིད་གཙོ་བོ་ཡིན་ལ།",
    "དོན་འདི་ཡིན་ཏེ་དཔེར་མཆོད་དོ་ཞེས་བྱ་བ་འདིར་མཆོད་བྱེད་དོ་ཞེས་བྱ་བ་འཕངས་པ་དེ་བཞིན་དུ་མཆོད་སྦྱིན་གྱི་ཡུལ་ཅན་གྱི་རང་གི་བྱ་བ་སྐྱེད་དོ་ཞེས་ཤེས་པར་བྱ་བ་ཡིན་ནོ།",
    "དེས་ན་མཆོད་སྦྱིན་གྱི་ཡུལ་ཅན་རང་གི་བྱས་པ་ལས་སྐྱེས་པ་ཉིད་གཞན་ཡིན་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ཡིན་དང་རེང་རེང་པོ་ཙམ་གྱི་སྤྱིའི་མངོན་སུམ་དུ་འགྱུར་བ་ཡིན་ལ།",
    "དེས་ན་རེང་རེང་པོ་མཐོང་བ་ན་གཅིག་ལ་སྦྱར་བའི་ཕྱིར་ཐེ་ཚོམ་དུ་འགྱུར་བ་ཡིན་ནོ་ཞེ་ན།",
    "འོ་ན་ནི་འགའ་ཞིག་རེང་རེང་པོ་མཐོང་བས་སྔར་ཉམས་སུ་མྱོང་བས་གཞག་པའི་བག་ཆགས་སད་པ་ལས་གཅིག་ལ་གཉི་ག་མ་ངེས་པར་དྲན་པར་འགྱུར་བ་དེ་ཅི་ཐེ་ཚོམ་མ་ཡིན་ནམ།",
    "འོན་ཏེ་དེར་ཡང་རེ་ཞིག་སྔོན་མཐོང་བ་ལ་ལྟོས་པ་ཡིན་ནོ་ཞེ་ན།",
    "རྣམ་པ་གང་གིས་རྟོགས་པ་ཞེ་ན།",
    "དེ་གཞན་ཡིན་ན་ཞེས་བྱ་བ་ནི་རེང་རེང་པོ་ཉིད་དེའོ།",
    "གང་གི་ཕྱོགས་བར་མའི་གོ་སྐབས་སུ་འགྱུར་བ་གཞན་གང་རུང་བ་སྣང་བ་མི་གསལ་བ་ཡིན་པར་ནི་མི་སྨྲའོ།",
    "འོན་ཀྱང་གང་གིས་ཡུལ་ཡོད་པ་དང་མེད་པ་ནི་བློ་ལ་རག་ལས་པ་བློ་དང་ཡུལ་དག་ལ་ཉེ་བ་འགའ་ཞིག་ཡོད་པ་ཡིན་ནོ།",
    "གང་གི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "འབྲེལ་པའི་རྣམ་པར་དབྱེ་བ་གང་གིས་དབྱིབས་ལ་སོགས་པ་དེ་དག་ཉིད་ལའོ།",
    "རེང་རེང་པོ་ཙམ་དང་རྫས་ཙམ་ནི་འཐོབ་ཀྱི།",
    "དེ་དག་གི་གང་གི་ཚེ་རྫས་སམ་དབྱིབས་ཁ་དོག་ལས་གཞན་ཡིན་ན་དེའི་ཚེ་དེ་ཉིད་དེ་བཞིན་ཉིད་དུ་གསལ་བ་མི་གསལ་བའི་ཁ་དོག་སྣང་བའི་དུས་ཅན་སྔོན་ནམ་ཕྱི་མའི་མངོན་སུམ་ལ་ཅིས་མི་སྣང་སྟེ།",
    "འོན་ཏེ་ཡུལ་ཐག་རིང་པོར་སྐྱེས་བུ་དང་མཐོ་ཡོར་གྱི་རང་བཞིན་དང་བྲལ་བའི་རེང་རེང་པོ་ཙམ་དམིགས་པ་ཉིད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པ་དེ་ཉེ་བར་སྡུད་པ་ནི།",
    "ཐུན་མོང་བ་ནི་རེང་རེང་པོའི་སྤྱིའོ།",
    "བྱེད་དོ་ཞེས་བྱ་བ་འདིས་བསྟན་པར་བྱ་བ་མཆོད་སྦྱིན་ལ་སོགས་པའི་བྱ་བའི་ཁྱད་པར་རྣམས་ཀྱི་ཐུན་མོང་བའི་རང་བཞིན་སྤྱིའི་ངོ་བོར་བྱ་བ་ཞེས་བྱ་བ་ནི་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ན་དེར་ཡང་མི་གསལ་བར་སྣང་བའི་ཐ་སྙད་ཡོད་པར་ཐལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ནི་དེ་ལྟར་མ་འབྲེལ་ཏེ་ཞེས་གང་གིས་ཧ་ཅང་ཐལ་བར་འགྱུར་བ།",
    "དེས་ཀྱང་ཧ་ཅང་ཐལ་བ་མེད་དོ།",
    "ཁྱོད་ཀྱིས་བློའི་རང་བཞིན་དུ་བརྗོད་པ་མི་གསལ་བ་གང་ཡིན་པ་དེ་ཉིད་དོ།",
    "མཐོ་ཡོར་དང་མི་ལ་གནས་པའི་ཁ་དོག་གམ་དབྱིབས་སྣང་བ་ཡིན་མོད་ཀྱི།",
    "འོན་ཀྱང་སོ་སོའི་རང་བཞིན་དུ་མ་ཡིན་པར་ཐུན་མོང་གི་རང་བཞིན་དུ་སྣང་བ་འབའ་ཞིག་ཏུ་ཟད་དོ།",
    "གལ་ཏེ་དེ་ལྟར་དེ་དག་ལས་ཐ་དད་པ་མི་དམིགས་པའི་ཕྱིར་མེད་མོད་མི་གསལ་བའི་ཁ་དོག་དང་དབྱིབས་གོ་ཅི་ལྟར་མེད་པ་ཉིད་ཡིན་ཞེ་ན།",
    "གང་གིས་གནོད་ཅེས་དོགས་པ་ན།",
    "གང་གི་ཕྱིར་གསལ་བའི་རྣམ་པ་ཅན་སྐྱེས་ནས།",
    "དོགས་པ་དེ་ཉིད་ལ་རང་གི་འདོད་པས་རིགས་པ་བརྗོད་པ་ནི།",
    "མཆོད་སྦྱིན་དེ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་མཆོད་སྦྱིན་ལ་རང་གི་ནུས་པ་རྟོགས་ཀྱང་།",
    "གང་གི་ཚེ་མཆོད་སྦྱིན་མཐོ་རིས་ལ།",
    "གལ་ཏེ་བློ་དམིགས་པ་མེད་པ་ཡིན་མོད།",
    "སེལ་བ་སྒྲ་དང་རྣམ་པར་རྟོག་པ་དག་གི་ཡུལ་ཡིན་ནོ་ཞེས་བྱ་བ་ག་ལས་ཤེ་ན།",
    "ཡང་རང་གི་གཞུང་ལུགས་ལ་ལྟོས་ན་མི་སླུ་བའི་མཚན་ཉིད་ཁོ་ན་ལ་ཡང་མ་ཁྱབ་པར་སྟོན་པས་གལ་ཏེ་ཞེས་བྱ་བ་སོགས་པ་སྨོས་སོ།",
    "སྔོན་པོ་དང་གཡོ་བ་ཞེས་པ་ནི་སྔོན་པོ་ཉིད་དང་མི་གཡོ་བ་ཉིད་དག་གི་ཁྱད་པར་ཅན་དུ་གྱུར་པའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཁྱད་པར་ཐ་དད་པ་འཛིན་པ་བསྡུའོ།",
    "དེ་ཡི་འོག་ཏུ་བློ་གང་གིས།",
    "ཤེས་པ་ཞེས་བྱ་བས་སླུ་བ་ཅན་བཀག་པ་ཡིན་མོད་གཟུང་བ་འཛིན་པ་ནི་ཅི་ལྟར་ཞེ་ན།",
    "གལ་ཏེ་དེ་ཡང་སྔ་མ་དང་ཕྱི་མའི་ངག་གཅིག་ཏུ་ངེས་པ་དེ་ལྟ་ན་ཡང་སྔ་མ་དང་ཕྱི་མའི་མངོན་སུམ་དག་གི་བྱེད་པ་དེ་ལ་མེད་པའི་ཕྱིར་ན་འདི་ནི་ཐེ་ཚོམ་གྱི་གནས་ཡིན་ནོ་ཞེས་འཆད་པར་འགྱུར་རོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "གཅིག་ཉིད་ཀྱི་ཤེས་པ་ཉིད་ནི་རྩོད་པའི་ཡུལ་གྱི་གཅིག་ཉིད་བདག་གིས་བྱེད་པ་སྟེ།",
    "ད་ལྟར་བ་ཞེས་དངོས་པོར་བསྟན་པ་ནི་རང་གི་ངོ་བོས་ཐ་མི་དད་པར་བསྟན་པའི་དོན་དུའོ།",
    "དེའི་ཕྱིར་སྔ་མ་དང་ཕྱི་མ་དག་གི་གཅིག་ཉིད་ལ་རྩོད་པ་ཡིན་ནོ།",
    "དེ་ལྟ་མོད་ཀྱི་རྟོགས་པ་སྔ་ཕྱིར་གྱུར་པ་ཡིན་ནོ།",
    "ཐ་དད་པར་བརྟགས་པའི་རང་གི་ངོ་བོ་ཅན་གྱི་རྫས་སོ།",
    "མི་བྱེད་པའི་གནས་སྐབས་གཉི་གར་རྗེས་སུ་འགྲོ་ལ་མཆོད་སྦྱིན་བྱེད་པའི་གནས་སྐབས་ནི་རེས་འགའ་རྗེས་སུ་མི་འགྲོ་བས་ན་ལྡོག་པ་ཡིན་ནོ།",
    "རང་གི་བྱ་བ་དང་ཁམས་ཀྱི་དོན་ཡང་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་གཉི་ག་ལ་ཉེས་པ་གཞན་བརྗོད་པ་དྲན་པར་བྱེད་པ་ཡིན་ཏེ།",
    "མཐོང་བ་མེད་པ་ཞེས་བྱ་བ་ནི་དེའི་ཚེ་རང་གི་ངོ་བོ་མེད་པས་ན་མི་སྣང་བའི་ཕྱིར་རོ།",
    "འོ་ན་ཁྱེད་ཀྱི་རྗེས་སུ་དཔོག་པ་ལ་ཡང་རང་གི་ངོ་བོ་མི་སྣང་བའི་ཕྱིར།",
    "རང་གི་ངོ་བོ་མི་འཛིན་མོད་ཞུགས་པས་ངེས་པར་བྱས་པ་ཐོབ་པ་ནི་ཡོད་པ་ཡིན་ལ།",
    "གང་གིས་ངེས་པར་བྱས་པ་ཐོབ་པར་ངེས་པར་འབྲེལ་བ་ནི་མེད་དོ།",
    "བདག་གི་ནུས་པ་རྟོགས་པ་ནི་མཆོད་སྦྱིན་ལའོ།",
    "རེ་ཞིག་བདག་གིས་མཆོད་སྦྱིན་བྱ་བར་ནུས་སོ་ཞེས་ནུས་པ་རྟོགས་ན་མཆོད་སྦྱིན་གྱི་རྒྱུ་གང་གི་ཕྱིར་ཤེས་པ་སྔ་མས་དངོས་པོ་དེ་ཐ་མའི་རང་བཞིན་སྐད་ཅིག་གཞན་དང་བྲལ་བ་དང་།",
    "སྔ་ན་མེད་པར་ཞེས་བྱ་བ་སྐད་ཅིག་དེ་ལས་སྔོན་རོལ་དུ་མི་གནས་པར་འཛིན་པ་དེའི་ཕྱིར་ཤེས་པ་སྔ་མས་བཟུང་བ་ཉིད་ཕྱི་མའི་རང་གི་ངོ་བོ་དང་འདྲེ་བ་འགལ་བ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་མོད་ཅི་སྐྱོན་ཞེ་ན།",
    "གཞན་ལས་ཡིན་ན་ཡང་ཐམས་ཅད་ལས་འགྱུར་བར་ཐལ་ལོ་ཞེ་ན།",
    "དེ་ཉིད་འདི་མ་ཡིན་མོད།",
    "འདི་ཡང་འགྱུར་མོད།",
    "གང་ལ་ནུས་པའི་ཁྱད་པར་མེད་པ་དེ་ནི་སྐྱེད་བྱེད་མ་ཡིན་པ་ཉིད་པས་ཧ་ཅང་ཐལ་བ་ཡང་ཐག་རིང་དུ་སྤངས་པ་ཁོ་ནའོ།",
    "དཔེར་ན་རྒྱུ་རང་གི་མཚན་ཉིད་ཙམ་ཐ་མི་དད་པ་ཡིན་པ་དེ་བཞིན་དུ་བྱ་བ་ཡང་ཡིན་ནོ།",
    "དེའི་ཚེ་རྗེས་སུ་དཔག་པ་ལ་ཡང་ཐལ་བར་འགྱུར་ཏེ།",
    "དེ་ལྟར་ན་ངོ་ཤེས་པ་ལ་ཡང་སྔ་མ་དང་ཕྱི་མ་དག་གི་རྟོགས་བཞིན་པ་གཅིག་གི་མཚན་ཉིད་དོན་གཅིག་ཉེ་བར་བསྡུ་བ་ཡོད་པའི་ཕྱིར་གཅིག་པ་ཉིད་དོ།",
    "དེ་ལྟ་མ་ཡིན་ན་དངུལ་དོན་དུ་གཉེར་བ་ཉ་ཕྱིས་ལ་མི་འཇུག་པར་ཐལ་བར་འགྱུར་རོ།",
    "འགའ་ཞིག་གང་གི་དུས་ཀྱི་ཁྱད་པར་ལ་བརྟེན་པ་ཅན་ལ།",
    "གལ་ཏེ་ངེས་པ་ཡང་གཅིག་གི་ཐ་སྙད་ཉིད་མ་ཡིན་ནམ།",
    "རེ་ཞིག་ཕྱི་མ་འཛིན་པའི་མངོན་སུམ་གྱིས་སྔ་མ་མི་འཛིན་ན་ཞེས་བྱ་བ་འདི་གནས་པ་ཡིན་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་ན་སྐད་ཅིག་གཅིག་བཟུང་ན་དུས་ཀྱི་ཆའི་ཚོགས་མཐའ་དག་བཟུང་བར་ཐལ་ན།",
    "གལ་ཏེ་སྔ་མའི་རང་བཞིན་མ་རིག་མོད་དེ།",
    "རང་གི་ངོ་བོ་ཙམ་གྱིས་དོན་གྲུབ་པ་གཅིག་ཙམ་དུ་རྟོགས་པས་ནི་བརྗོད་པར་འདོད་པའི་ཁྱད་པར་མི་འགྲུབ་པོ།",
    "གང་གི་ཕྱིར་སྔ་མ་དང་ཕྱི་མ་དག་ལས་དོན་དམ་པར་གཅིག་ཉིད་མེད་པ་དེས་ནའོ།",
    "རང་གི་དོན་ལ་ཨ་ནཾ་གྱི་རྐྱེན་བཅུག་པས་ན་ཀུན་རྫོབ་པ་ཞེས་བརྗོད་ཀྱང་ཀུན་རྫོབ་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་གི་ཚེ་ངོ་ཤེས་པར་བྱ་བའི་ཡན་ལག་ཅན་གཅིག་ཉིད་མེད་ཅིང་གཟུང་བའི་དངོས་པོ་ཡང་ཞིག་པས་འཐོབ་པར་མི་ནུས་པ་དང་།",
    "བྱེད་པ་ཉིད་ཐུན་མོང་བ་ཡིན་པའི་ཕྱིར།",
    "དེ་ཁོ་ན་ཉིད་དུ་ནི་རྣམ་པར་རྟོག་པ་མེད་པ་རང་གི་རང་བཞིན་ཙམ་གྱིས་མཐར་ཐུག་པས་ན།",
    "དེ་དག་གི་ཡུལ་དུ་མ་བྱས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་བའི་ཕྱིར།",
    "རེ་ཞིག་རྣམ་པ་མེད་པ་ལ་ནི་དོན་རྟོགས་པ་ཉིད་འབྲས་བུ་ཡིན་ལ།",
    "དཔྱོད་པ་དང་ལྡན་པ་ལ་ནི་རང་གི་ངོ་བོ་རྟོགས་པ་ཁོ་ན་དོན་རྟོགས་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཤེས་པའི་རང་བཞིན་དུ་གྱུར་པའི་རྣམ་པ་ཉིད་དང་འབྲེལ་པས་ཡུལ་གྱི་ཁྱད་པར་རྟོགས་པར་རྣམ་པར་གཞག་པ་ཡིན་པ་དང་།",
    "དེ་ལ་རེ་ཞིག་ཕྱོགས་དང་པོ་སེལ་བ་ནི་རེ་ཞིག་ཅེས་བྱ་བའོ།",
    "ཤེས་པ་དག་གིས་དེ་དམིགས་སེལ།",
    "འོན་ཏེ་ཐམས་ཅད་དུ་ཁྱབ་པ་དམིགས་ཀྱིས་སེལ་བས་རང་གི་ཡུལ་དང་བྲལ་བ་ནི།",
    "རང་གི་རྒྱུ་ལས་སྐྱེས་པའམ་མ་སྐྱེས་པ་ཞིག་ཡིན་པར་འགྱུར།",
    "སེམས་པའི་རང་བཞིན་ཅན་གནས་སྐབས་ཐམས་ཅད་དུ་རྗེས་སུ་སོང་བའོ།",
    "སུན་འབྱིན་པར་བྱེད་པ་ནི་མ་སྐྱེས་པར་ཁས་ལོང་ཞིང་བདག་གི་རང་བཞིན་ལྷག་པ་ཡང་གནོད་མོད།",
    "ཅི་སྟེ་ཡང་བདག་གིས་བརྗོད་མ་ཐག་པའི་ཉེས་པ་འགྱུར་བ།",
    "སྔགས་ལ་སོགས་པའི་མཐུས་མིག་གི་ཡོན་ཏན་གྱི་ཁྱད་པར་ཐོབ་པའི་ཕྱིར་ཡང་དག་པར་མཐོང་ཡང་།",
    "གང་གི་ཕྱིར་ཉེས་པ་དང་བྲལ་བའི་གནས་སྐབས་ཉིད་ཡོན་ཏན་སྐྱེས་པའི་ཕྱིར་རོ།",
    "ཡོད་མོད་ཅི་དེ་ཙམ་གྱིས་ཡོན་ཏན་མ་ཡིན་པར་འགྱུར་རམ།",
    "གང་གིས་ཞེས་གསུངས་ཏེ་རྟོགས་པ་གང་གིས་སོ།",
    "དེའི་ནི་བདག་གིའོ།",
    "རང་རིག་གི་ངོ་བོ་ནི་སེམས་པ་ཅན་ཙམ་གྱི་རང་བཞིན་ནོ།",
    "རེ་ཞིག་འདི་ཉིད་ཀྱི་ལུགས་བསམ་པར་བྱའོ་ཞེས་སྨྲས་པ་ནི།",
    "ཐོབ་པར་བྱེད་པ་ཐུན་མོང་བ་རྣམས་ལ།",
    "དེ་ལ་རེས་འགའ་མི་འཐོབ་ཕྱིར།",
    "མི་འཐོབ་པ་དེ་ནི་གང་གི་ཚེ་འགའ་ཞིག་གིས་ཡུལ་ཕྲོགས་སམ།",
    "མི་མཐུན་པ་ཕྲ་མོ་གོམས་པ་ལས་ངེས་པར་འཛིན་ཏོ།",
    "འདི་ལྟར་དེ་མཐོང་ཉིད་ལ་ཞེས་བྱ་བས་ནི་མཐོང་བཞིན་པའི་རང་གི་མཚན་ཉིད་འཛིན་པ་ནི་མ་ཡིན་ཏེ།",
    "རྗེས་སུ་དཔག་པ་ཉིད་ལས་དོན་བྱ་བ་ངེས་པ་ཡིན་མོད།",
    "རྗེས་སུ་དཔག་པ་དོན་བྱ་བ་དང་འབྲེལ་པར་འཛིན་པའི་མངོན་སུམ་ལ་ལྟོས་མོད།",
    "དེས་ན་གང་གིས་གང་ཡང་རུང་བར་གནས་པར་མི་འགྱུར་བ་ཕན་ཚུན་བསྟེན་པར་ཅི་ལྟར་འགྱུར་ཞེ་ན།",
    "རང་གི་ངོ་བོ་ཡང་དེ་ཡིན་ལ་རང་གི་དམིགས་པའི་རྣམ་པ་ཡང་ཡིན་པ་དེ་གཅོད་པར་བྱེད་པ་སྟེ།",
    "གང་གི་ཕྱིར་འབྲེལ་པ་དེ་ལྟ་བུར་གྱུར་པ་ཡིན་པ་དེའི་ཕྱིར་དངོས་པོའི་གནས་ལུགས་སུ་མངོན་སུམ་དུ་འཛིན་པ་མ་ཡིན་ནོ་སྙམ་དུ་དགོངས་པའོ།",
    "དེའི་ཚེ་འཇིག་རྟེན་ཐམས་ཅད་དོན་ཀུན་མཐོང་བར་ཐལ་ལོ།",
    "རེ་ཞིག་འགའ་ཞིག་ཏུ་ལྷན་ཅིག་གི་ངོ་བོར་མཐོང་བ་ཡིན་ལ།",
    "ལྷན་ཅིག་པའི་ངོ་བོ་དེ་ནི་རེས་འགའ་བ་ཡིན་པས་སོ།",
    "ལྷན་ཅིག་གི་ངོ་བོར་མཐོང་བ་རྗེས་སུ་དཔག་པ་སྐྱེ་ན།",
    "བུམ་པ་དང་སྣམ་བུ་དག་ལ་ཡང་རེས་འགའ་བའི་ལྷན་ཅིག་གི་ངོ་བོ་ནི་ཡོད་པ་དེས་ན་དེ་དག་གཅིག་མཐོང་བ་ནི།",
    "གལ་ཏེ་ཡུལ་དང་དུས་གཞན་ཉིད་མི་འཛིན་མོད།",
    "གལ་ཏེ་མངོན་སུམ་གྱིས་ཁྱབ་པ་མི་འཛིན་མོད།",
    "དཔྱོད་པ་པ་རང་གི་ལུགས་ཉེ་བར་སྡུད་པར་བྱེད་པ་ནི།",
    "གདོན་མི་ཟ་བར་བདག་ཅག་གི་མཚན་ཉིད་ཁས་བླང་དགོས་སོ་ཞེས་སྨྲས་པ་ནི།",
    "གང་གི་ཚེ་གནོད་པར་བྱེད་པ་དེའི་ཚེ་ནི།",
    "འདི་སྙམ་དུ་གཞན་ལ་ཉེས་པར་བརྗོད་པ་འདིས་ནི་རང་གི་ཕྱོགས་ལན་ཅུང་ཟད་ཀྱང་མ་བཏབ་པོ།",
    "རང་གི་ངོ་བོའི་ཚིག་གི་རྣམ་པར་བཅད་པ་སྨྲས་པ་ནི།",
    "གལ་ཏེ་དེ་ལྟ་ཡིན་དུ་ཆུག་མོད་དེ་ལས་ཅིར་འགྱུར་ཞེ་ན།",
    "རང་གི་ངོ་བོ་ཉིད་རྟོགས་སོ་ཞེས་བྱ་བའོ།",
    "དེ་ཡང་རང་གི་ངོ་བོ་ཙམ་དུ་བཟུང་བ་ན།",
    "རང་གི་རང་བཞིན་རིག་པ་གང་ལ་འཇུག་པ་ལྡོག་པ་མེད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "དེ་ལྟར་རང་ལས་རང་གི་ངོ་བོ་རྟོགས་ཞེས་བྱ་བ་འདིས་དོན་དམ་པའི་བདེན་པ་བསྟན་ནས།",
    "ཤེས་རབ་འདོད་པ་ལ་སོགས་པ་ནི་རང་གི་ངང་གིས་འཇུག་པ་ཡིན་ནོ་སྙམ་དུ་བསམས་པའོ།",
    "ཐ་སྙད་ལས་ནི་ཞེས་བྱ་བ་ཡང་ཕྱིས་ཀྱི་དོན་བྱེད་པའི་ཤེས་པས་སོ་ཞེས་འཆད་པར་བྱེད་པ་དེ་དག་ལ་རིགས་པ་དང་འགལ་བ་དེ་ནི་རེ་ཞིག་བསྟན་པ་ཡིན་ནོ།",
    "གཟུགས་ཙམ་མཐོང་བས་རེག་བྱ་ལ་སོགས་པའི་ཚོགས་པའི་དོན་བྱ་བ་སྒྲུབ་པ་རྟོགས་པ་ན་ཞེས་བྱ་བ་རྣམ་པར་གནས་པ་ནའོ།",
    "དོན་བྱ་བ་ནི་རྒྱུ་གཞན་ལ་ལྟོས་པས་རེས་འགའ་བ་ཡིན་པའི་གཏན་ཚིགས་ཀྱི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་གཞན་དུ་བསྟན་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ནི་རང་གི་ལུགས་ཏེ།",
    "དོན་བྱ་བ་དེའི་བདག་ཉིད་རང་གི་ངོ་བོ་སྒྲུབ་པར་བྱེད་པའི་ཤེས་པ་གང་ལ་ཡོད་པ་དེ་ལ་དེ་སྐད་བརྗོད་དེ།",
    "དེ་དག་གི་མཐུ་ནི་ནུས་པ་སྟེ་ངེས་སོ།",
    "གང་གི་ཚེ་ཞེ་ན།",
    "སྨྲས་པ་ནི་གང་གི་ཚེ་ཞེས་བྱ་བ་ནས་དེའི་ཚེ་ཞེས་བྱ་བའི་བར་རོ།",
    "བརྗོད་པ་དེ་ཁོ་ན་ཉིད་དུ་དོན་བྱ་བ་མངོན་སུམ་དུ་བྱ་བར་མི་སྨྲ་བས་གང་གིས་ཉེས་པ་འདིར་ཐལ་བར་འགྱུར།",
    "དེ་ལ་ཇི་ལྟར་ཁྱབ་པ་འཛིན་པའི་དུས་ན་མངོན་སུམ་རང་གི་མཚན་ཉིད་ཀྱི་སྐད་ཅིག་འཛིན་པ་ཡིན་ཡང་།",
    "དེ་ལྟ་ན་ནི་འོ་ན་བུམ་པ་ལ་ཡང་གཟུགས་དམིགས་པ་ནི་རེག་པ་ལ་སོགས་པ་དམིགས་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ངེས་པ་མ་མཐོང་ངམ།",
    "གལ་ཏེ་དོན་བྱ་བ་ངེས་ན་རེས་འགའ་ཇི་ལྟར་མི་ཐོབ་ཅེ་ན་སྒྲུབ་པར་བྱེད་པ་ལ་ཡང་རེས་འགའ་མི་འཐོབ་པ་ཉིད་མཚུངས་སོ།",
    "ཅི་སྟེ་སྒྲུབ་པར་བྱེད་པ་ནི་ཡོད་པ་ཉིད་འགའ་ཞིག་གི་བཤིག་པའམ་མ་ཞུགས་པས་མ་ཐོབ་པར་ཟད་ཀྱི།",
    "དེས་ཁྱབ་པའི་ཕྱིར་ཁྱབ་བྱེད་དུ་འགྱུར་མོད་རྒྱུར་གོ་ཅི་ལྟར་འགྱུར་ཞེ་ན་ཐ་དད་པའི་ཞེས་སྨོས་སོ།",
    "ཡོད་པ་གང་ཡིན་པ་དེ་ཡང་ལྟོས་པ་ཐམས་ཅད་དང་བྲལ་བའི་ཕྱིར་ཅི་ལྟར་འགའ་ཞིག་གིས་སྐྱེད་པར་བྱེད་པ་ཡིན།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བ་ཡོད་པའི་རང་གི་ངོ་བོ་ཉིད་བསྟན་པར་བྱ་བའི་དོན་དུ་ཅི་ཞེས་འདྲི་བར་མཛད་དོ།",
    "དེ་ལྟ་ཡིན་མོད་ཅེ་ན་ཞེས་དོགས་པ་བསུ་ནས་ཡུན་རིང་དུ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འགྲོ་བཞིན་པ་ན་རྩྭ་ལ་རེག་པའི་ཤེས་པ་ལྟར་གཉིད་མཐུག་པོ་ལོག་པ་ལ་ཡང་།",
    "གང་གི་ཕྱིར་གོམས་པའི་ཁྱད་པར་གྱི་རྗེས་སུ་འགྲོ་བ་དང་།",
    "དེས་ན་འདི་འདིར་བྱེད་དོ་ཞེས་བྱ་བས་ནི་འདིའི་རང་གི་ངོ་བོ་ཉེ་བར་གནས་ན།",
    "འདིའི་རང་གི་ངོ་བོ་ཉེ་བར་གནས་པ་ཡིན་ནོ་ཞེས་བསྟན་པས་སྔ་མ་ལས་ཐ་དད་པ་མེད་དོ།",
    "དེ་ཉིད་སྨྲས་པ་ནི་རང་གི་ངོ་བོ་ལས་རང་གི་ངོ་བོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་རང་གི་ངོ་བོ་ལས་ཞེས་བྱ་བའི་ལྔ་པས།",
    "གལ་ཏེ་རང་གི་ངོ་བོ་གཉིས་དུས་གཅིག་གི་ཚེ་ཉེ་བར་འདོད་ན།",
    "རེ་ཞིག་སུན་འབྱིན་པར་སྨྲས་པ་ནི་མཐོང་བ་རང་གི་ངོ་བོས་ཁྱབ་བྱེད་ཉིད་དུ་རྟོགས་པ་མ་ཡིན་ཏེ།",
    "ཕྱེད་ཕྱི་མ་རྣམ་པར་འགྲེལ་པ་ནི་གང་གི་ཚེ་ཞེས་བྱ་བའོ།",
    "རང་གི་དུས་ཀྱི་ཁྱད་པར་ཅན་གྱིས་སོ་སྙམ་དུ་དགོངས་པའོ།",
    "ཡང་སྐྱེད་བྱེད་ཡིན་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པའི་རྒྱུ་ཉིད་ཡོད་པ་ནི་མ་ཡིན་གྱི།",
    "གང་གི་ཕྱིར་དེ་ལྟར་འདིར་རིགས་པས་མི་འཐད་པ་མེད་པ་དེའི་ཕྱིར།",
    "དེའི་ཕྱིར་རང་གི་ལུགས་ལ་སྒྲུབ་པར་བྱེད་པ་དང་འགལ་བ་མེད་པ་དང་རྣམ་པར་དཔྱད་བཟོད་པ་ཉིད་བླང་བར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "འབྲས་བུར་གྱུར་པ་དེས་དེ་བྱེད་པའི་རང་གི་ངོ་བོ་བསྟན་པ་ནི།",
    "རང་གི་དུས་ཉིད་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཐེ་ཚོམ་དེ་མེད་མོད།",
    "འགའ་ཞིག་གི་དོན་དང་འབྲེལ་པ་ནི།",
    "སྤྱིའི་སྟེ་དཔེ་དང་ཐུན་མོང་གི་རང་བཞིན་དུའོ།",
    "དེས་ན་མངོན་སུམ་གྱིས་ནི་མ་མཐོང་བའི་འབྲེལ་པ་རྗེས་སུ་དཔག་གིས་མི་རྟོགས།",
    "གཞན་དུ་ཧ་ཅང་ཐལ་བའི་ཕྱིར།",
    "གཞན་ལ་ལྟོས་པ་མེད་པའི་ཕྱིར་རང་གི་ངོ་བོ་ཙམ་རིག་པ་ལ་ནི།",
    "རང་ལས་རང་གི་ངོ་བོ་རྟོགས།",
    "གང་གིས་བསྟན་བཅོས་དོན་མེད་པར་འགྱུར།",
    "རྣམ་པར་རྟོག་པ་རང་གི་མཚན་ཉིད་ཀྱི་རྣམ་པ་ཅན་མ་ཡིན་ཡང་།",
    "རང་གི་མཚན་ཉིད་ཀྱི་ཡུལ་ཅན་དུ་ཐ་སྙད་འདོགས་ཏེ།",
    "མི་དྲན་པ་དེ་རང་གི་མཚན་ཉིད་ཀྱི་ཡུལ་ཅན་གྱི་ཤེས་པ་རྣམ་པར་རྟོག་པ་མེད་པའི་མཚན་ཉིད་དུ་བརྗོད་པའི་བསྟན་བཅོས་ཀྱིས་སེལ་ཏོ།",
    "ཡང་དག་གི་ཀུན་རྫོབ་ལ་གཙོར་བྱ་བའི་དོན་སྦྱོར་བ་ནི་དེ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གང་གི་ཕྱིར་ཐ་སྙད་ཀྱིས་རབ་ཏུ་གྲུབ་པའི་དོན་ལ་ཡང་བསྟན་བཅོས་ཉེ་བར་མཁོ་བ་དེ་ཉིད་ཀྱི་ཕྱིར།",
    "ཐ་སྙད་ལས་འདས་པ་མཐོ་རིས་དང་བྱང་གྲོལ་གྱི་ལམ་ལ་བསྟན་བཅོས་ཉིད་ཀྱིས་རྨོངས་པ་ཟློག་པར་བྱེད་དོ་ཞེས་རང་གིས་བརྟགས་པ་སེལ་བའོ།",
    "ཇི་སྲིད་འདིར་སོང་བ་དེ་ཐམས་ཅད་ནི་བསྟན་ཟིན་པ་ཉིད་དོ།",
    "པ་ནི་རང་གི་དོན་ལ་ཨཎ་ནོ།",
    "རེ་ཞིག་གཟུགས་ཙམ་མཐོང་བ་ཡིན་ལ།",
    "གལ་ཏེ་རང་གི་རྟོགས་པ་ངེས་པར་ཟིན་ན་ནི།",
    "དེས་ན་ཧ་ཅང་ཐལ་བར་མི་འགྱུར་རོ་སྙམ་པའི་དགོངས་པའོ།",
    "གལ་ཏེ་དེ་ལྟར་ཧ་ཅང་ཐལ་བ་མེད་མོད།",
    "གང་གི་ཚེ་ཞེས་བྱ་བ་ནི་མི་སླུ་བ་ཉིད་ཀྱིས་སོ།",
    "དེ་ནི་བདེན་མོད་ཀྱི་ཞེས་བྱ་བ་ནི་དོན་ཤེས་པར་བྱེད་པ་ལ་མི་སླུ་བ་ཉིད་ཉེ་བར་མཁོའོ་ཞེས་བྱ་བ་དེ་བདེན་པའོ།",
    "མདུན་ན་གནས་པའི་བུམ་པ་ལ་སོགས་པ་ལ་ཕྱི་རོལ་གྱི་དོན་དུ་ཡིད་ཆེས་པ་རྣམ་པར་འཁྲུལ་པའི་དོགས་པ་དང་བྲལ་བ་མོད་ལ་བྱུང་བར་འགྱུར་གྱི།",
    "དེ་བདེན་མོད་ཀྱི་ཕྱི་རོལ་གྱི་དོན་ཞེས་བྱ་བ་དང་དེའི་དོན་བྱ་བ་ནུས་པ་ཞེས་བྱ་བ་གཉིས་ནི་ལྡོག་པ་ཐ་དད་པ་ཡིན་ནོ།",
    "ཐུན་མོང་ཡིན་ལ་དོན་བྱ་བ་ནུས་པ་ནི་གཟུགས་ལ་སོགས་པ་འགའ་ཞིག་ཁོ་ན་ལ་ཡིན་ཏེ།",
    "དེ་ལ་གང་གི་ཚེ་མོད་ལ་དོན་བྱ་བར་ནུས་པར་རྟོགས་པ་དེའི་ཚེ་ནི་དེ་ཉིད་ཡིན་ལ་གང་གི་ཚེ་སྣང་བ་ཙམ་ཡིན་པར་རྣམ་པར་དཔྱད་པས་འདི་ནི་དོན་ཉིད་དོ་ཞེས་ངེས་པར་རྟོགས་པ་དིའི་ཚེ་ནི་འདི་འཇུག་པ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་དང་སྒྲ་དང་རི་མོ་ལ་སོགས་པ་ལ་འཐད་པ་ཉིད་ནི་འདིའི་བྱེད་པ་ཡིན་ནོ་ཞེས་བསྟན་ཏོ།",
    "རང་གི་མཚན་ཉིད་འཛིན་པའི་མངོན་སུམ་གྱིས་སྤྱི་ལ་སོགས་པ་མ་བཟུང་ངོ་སྙམ་དུ་བསམས་པའོ།",
    "རང་གི་མཚན་ཉིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་སྡུད་པའོ།",
    "དེ་ལྟ་ན་ཡང་རང་གི་འདོད་པའི་སྤྱི་ཅི་ལྟར་འགྲུབ་ཅེ་ན།",
    "གཞན་དུ་འགྱུར་བ་ནི་རང་གི་འདོད་པས་སོ།",
    "དེ་ལྟ་ཡང་རང་གི་རང་བཞིན་བསྐལ་པའི་ཕྱིར་རོ།",
    "རང་གི་མཚན་ཉིད་མ་ཤེས་པ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རང་གི་མཚན་ཉིད་དཔྱད་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་ཁོ་ན་ཡོད་པ་དང་མེད་པ་ཉིད་དུ་རྣམ་པར་གཞག་པའི་ཕྱིར་རོ།",
    "ཡོད་པ་དང་མེད་པ་ཉིད་དུ་རྣམ་པར་དཔྱད་པ་རང་གི་མཚན་ཉིད་དེ་ལའོ།",
    "དུས་ཕྱིས་ཀྱི་ལམ་ཞེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་ཀྱི་ཕྱིས་སོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རང་གི་མཚན་ཉིད་ཀྱི་ཕྱིར་རང་བཞིན་མ་ཡིན་ནོ།",
    "དེའི་རང་བཞིན་ནི་རང་གི་མཚན་ཉིད་ཀྱི་རང་བཞིན་ནོ།",
    "ཤིན་ཏུ་ཐ་དད་པའི་རང་གི་མཚན་ཉིད་ནི་མཐོང་ཡང་དེའི་དོན་བྱ་བ་འདི་ཡིན་ནོ་སྙམ་དུ་ངེས་པར་འཛིན་པ་མི་འཐད་པའི་ཕྱིར།",
    "གང་གི་ཕྱིར་སྤྱི་ཤེས་ཀྱང་།",
    "རང་གི་མཚན་ཉིད་ཁོ་ན་ལ་འཇུག་པ་དེའི་ཕྱིར།",
    "འཇུག་བྱེད་མ་ཡིན་མོད་དེར་ལྷག་པར་ཞེན་པ་ཙམ་དུ་ནི་འགྱུར་རོ་ཞེ་ན།",
    "གང་གི་ཚེ་ལྷག་པར་ཞེན་པ་སྤངས་ནས་རྣམ་པར་རྟོག་པ་ལ།",
    "དེས་རང་གི་བདག་ཉིད་ཁོ་ན་རྟོགས་པའི་ཕྱིར།",
    "གཉིས་སུ་མེད་པ་ཞེས་བྱ་བ་ནི་རིག་བྱ་རིག་བྱེད་མེད་པ་རང་གི་ངོ་བོ་རིག་པ་ཙམ་མོ།",
    "གཞན་ཞེས་བྱ་བ་ནི་རང་གི་མཚན་ཉིད་དང་མི་མཐུན་པའོ།",
    "ཅིའི་ཕྱིར་དེ་ལྟར་མི་བསྙད་སྙམ་པའི་དོགས་པ་སེལ་བའི་སྒོ་ནས་རྩ་བ་འབྲེལ་པ་ནི་རང་གི་མཚན་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ལན་དུ་ཤེས་པ་དེ་རང་གི་མཚན་ཉིད་ཤེས་པ་ལ་ཞེས་བྱ་བའོ།",
    "རང་གི་མཚན་ཉིད་ཤེས་པ་ལ་ཤེས་པའི་ཤེས་པ་གང་ཡིན་པ་དེ་ཞེས་བྱ་བའི་གཞལ་བྱ་འདི་ལ་ཤེས་པའི་རྟོགས་པ་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་གིས་འདི་ཞེས་བྱ་བ་གསུངས་སོ།",
    "རང་གི་མཚན་ཉིད་ཅེས་བྱ་བ་ནི་ཤེས་པའིའོ།",
    "ཤེས་པའི་རང་གི་མཚན་ཉིད་ཕན་ཚུན་ཐ་དད་པའོ།",
    "ངན་སོང་དུ་འགྲོ་བ་ལ་སོགས་པ་བར་དུ་གཅོད་པ་དང་བྲལ་བས།",
    "རང་གིས་སྒྲོ་མ་བཏགས་པའོ།",
    "གྲུབ་པའི་མཐར་ནི་གལ་ཏེ་ཡུལ་རང་གི་ངོ་བོ་ལས་ཐ་དད་པར་གྱུར་ན་དེའི་ཚེ་ཐ་དད་པའི་སྟོབས་གྱིས་རང་གི་ངོ་བོ་ཡང་ཐ་དད་པར་འགྱུར་བ་ཞིག་ན་དེ་ལྟ་ཡང་མ་ཡིན་ནོ།",
    "རང་རིག་པའི་རང་གི་ངོ་བོ་ཉིད་དེ་ལྟ་དེ་ལྟར་རྣམ་པར་གནས་པ་ཡིན་ནོ།",
    "དེ་ལ་གལ་ཏེ་བཏགས་པའི་ཐ་དད་པའི་ཆ་གཅིག་ལ་ལྟོས་ནས་གཞན་རིགས་པ་མ་ཡིན་ན་ནི་དེའི་ཚེ་དེ་ལ་ལྟོས་པས་གཞན་ལ་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "མངོན་སུམ་གྱི་རང་བཞིན་ཉིད་ཀྱི་ཞེས་བྱ་བ་ནི་དངོས་པོ་མཐའ་དག་མངོན་དུ་བྱེད་པ་ཉིད་ཀྱི་སྒྲས་ནི་གང་ཟག་གི་རང་བཞིན་འགོག་པ་ཡིན་གྱི་གཟུགས་ཀྱི་ཕུང་པོ་ནི་མ་ཡིན་ནོ།",
    "གྲུབ་པའི་གནས་སྐབས་སུ་ནི་ཐུན་མོང་མ་ཡིན་པ་ཁོ་ན་སྟེ།",
    "དངོས་པོ་མཐའ་དག་གི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་བཅོམ་ལྡན་འདས་ལ་ཡང་དག་པ་ཉིད་གསུང་བའི་རྒྱུ་དེའི་ཕྱིར་སྒྲུབ་བྱེད་དེ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་ཐམས་ཅད་གསུངས་པའི་འབྲས་བུའི་རྟགས་ཀྱིས་བཅོམ་ལྡན་འདས་ཀྱིས་དེའི་ཡུལ་ཅན་གྱི་མཁྱེན་པ་ཉིད་རྗེས་སུ་དཔོག་གི་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཞན་ཡང་ཞེས་བྱ་བ་ནི་ཕྱོགས་གཉིས་པ་བསྟན་པ་ཙམ་མོ།",
    "གང་གིས་ཞེས་སོ།",
    "འདས་པ་དང་མ་འོངས་པ་རང་གི་ངོ་བོས་སྣང་བ་ཇི་ལྟར་འགྱུར།",
    "རང་གི་ངོ་བོ་གསལ་ན་ཡང་ད་ལྟར་བ་ཁོ་ནར་འགྱུར་རོ།",
    "ཕྱིན་ཅི་ལོག་གི་རང་བཞིན་གྱི་དོན་མཐོང་བའི་ཕྱིར་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་འདས་པ་དང་མ་འོངས་པ་རྟོགས་པ་ཡང་ཅི་ལྟར་རྟོགས་ན་ཡང་ད་ལྟར་བ་ཉིད་དུ་ཐལ་ལོ་ཞེས་དོགས་ན།",
    "དེའི་ཚེ་འདས་པ་ལ་སོགས་པའི་དངོས་པོ་ཉེ་བར་གནས་པ་ནི་མ་ཡིན་པས་གང་གིས་ཧ་ཅང་ཐལ་བར་འགྱུར།",
    "གཞན་ལ་ནི་ཤེས་པ་རྣམ་པར་མེད་པ་ཉིད་ཀྱི་དངོས་པོ་ཉིད་གསལ་བའི་ཕྱིར་ད་ལྟར་བ་ཉིད་དུ་ཐལ་བར་བཟློག་པར་དཀའོ།",
    "གང་གི་ཚེ་དོན་མཐོང་བའི་དེ་མ་ཐག་པ་ཉིད་དུ་ངེས་པར་མ་རྟོགས་ན་ནི་དེའི་ཚེ།",
    "དེ་དག་ནི་རང་གི་བདག་ཉིད་དུ་གྱུར་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་བྱས་པས་བརྗོད་འདོད་མཐའ་དག་གིས་སྦྱར་བའི་སྔོན་པོ་སྒྲའི་དོན་ཐམས་ཅད་ཀྱི་རྗོད་བྱེད་དུ་འགྱུར་རོ།",
    "དེ་དག་གི་ངོ་བོར་ནི་བརྗོད་པར་འདོད་དང་གཞན་པ་ཉིད་དོ།",
    "གལ་ཏེ་ཡང་འདིར་གཟུང་བ་ཐ་དད་ཀྱང་འཛིན་པ་ཐ་དད་པར་ཁས་མི་ལེན་ན་འོ་ན་ནི་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པར་ཡང་ཐ་དད་པར་མི་འགྱུར་རོ་ཞེས་ཐལ་བར་སྟོན་པ་ནི་དེ་ལྟ་ན་ཡིན་ན་ཞེས་བྱ་བའོ།",
    "རྟོགས་པར་བྱེད་པ་དེའམ་གཞན་གྱི་དུས་ཐ་དད་པར་ཉེ་བར་མཚོན་པའི་དངོས་པོ་གང་ཞིག་ཅིག་གིས་བྱ་བར་རྟོགས་པ་དེ་གཅིག་ཁོ་ནའོ་ཞེས་བྱ་བར་བདེན་ནམ་ཅི་མི་བདེན་པ་ཉིད་སྟོན་པ་ཉིད་ཀྱིས་སྒྲུབ་བྱེད་ངོ་ཤེས་པ་སུན་ཕྱུང་བའི་ཕྱིར་རོ།",
    "དེའམ་གཞན་གྱིས་ཞེས་བྱ་བ་ནི་ཕལ་མོ་ཆེས་རྟོགས་པ་ཡིན་ཡང་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་གཞན་གྱིས་མ་ཤེས་མོད།",
    "ཅི་སྟེ་རྟག་པ་གཞན་ལ་མི་ལྟོས་མོད།",
    "དེའི་རང་གི་མཚན་ཉིད་དེ་རྟོགས་པ་དེ་མངོན་སུམ་དུ་བྱེད་པའོ།",
    "བདག་གི་རྣལ་འབྱོར་པ་ནི་གཞན་གྱི་སྡུག་བསྔལ་ལ་སོགས་པ་དམིགས་པའི་དངོས་པོ་ཉིད་དུ་རྟོགས་ལ་གཞན་ནི་རང་གི་ཤེས་པའི་བདག་ཉིད་དུ་རྟོགས་པས་ཉེས་པ་མེད་དོ་ཞེས་བྱ་བའོ།",
    "ཚིགས་སུ་བཅད་པ་གཅིག་གི་མཐར་བྱ་རོག་གི་དྲི་བས་ཅི་ཞེས་རྟོགས་པར་བྱ་བའི་ཕྱིར་རྣམ་པར་རྟོག་པ་གཅིག་གོ།",
    "གང་གི་ཞེས་བྱ་བ་ནི་ནུས་པ་དང་ལྡན་པས་སོ།",
    "བདག་གིས་བྲམ་ཟེ་ལ་བྱིན་ཏེ།",
    "རེ་ཞིག་འདི་ཉིད་ལ་སུན་འབྱིན་པ་གཞན་ཡང་ཅི་ལྟར་ཡོད་ཅེས་བྱ་བའོ།",
    "སེར་སྣ་ལ་སོགས་པས་ཟིན་པས་ཕྱིན་ཅི་ལོག་གི་ཉེས་པར་སྟོན་པ་ཡང་སྲིད་པའི་ཕྱིར་རོ།",
    "གང་གིས་ཐམས་ཅད་ལ་ལྟ་བའི་ཐམས་ཅད་མཐོང་བ་དང་།",
    "འོན་ཏེ་རང་བཞིན་སོ་སོར་ངེས་པའི་ཕྱིར་མེ་ཁོ་ནས་སྲེག་གི།",
    "གལ་ཏེ་འདི་དག་འབྲས་བུའི་བདག་ཉིད་ཡིན་མོད།",
    "གཞན་ཇི་ལྟར་ཕྱོགས་འགྲུབ་ན་གང་གི་སྒྲུབ་པ་ལ་གྲུབ་པའི་ཉེས་པར་འགྱུར་ཞེ་ན།",
    "ཡང་ན་ལྡོག་པ་ཁྱབ་པར་མ་བསྟན་པའི་མཐུན་པའི་ཕྱོགས་དང་མི་མཐུན་པའི་ཕྱོགས་ལ་མ་མཐོང་བ་ཙམ་ལ་ལྟོས་ནས་ལྡོག་པའི་ཕྱིར་ཐུན་མོང་མ་ཡིན་པའི་མ་ངེས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡང་རྫ་མཁན་རང་གི་བྱ་བའི་ཉེ་བར་ལེན་པ་ལ་སོགས་པ།",
    "འདིས་ཡང་དག་པར་སྦྱིན་པ་རང་གི་མཚན་ཉིད་ཀྱི་ཤེས་པ་ནི་མ་ཡིན་ནོ།",
    "རེ་ཞིག་དང་པོར་ཞེས་བྱ་བར་ནི་འཆད་པར་འགྱུར་རོ།",
    "དེ་ལྟར་མ་དམིགས་པ་ནི་ཐུན་མོང་ཡིན་པའི་ཕྱིར་རོ།",
    "ཐུན་མོང་གི་ལས་ཀྱི་སྐྱེད་པའི་ཕྱིར་ཞེས་བྱ་བའི་རྟོག་པར་ཡང་འགྱུར་བ་ཁོ་ནའོ།",
    "དེ་ལྟ་ན་རྟོག་པ་འདི་མཐའ་ཞིག་ཏུ་འགྱུར་རོ་ཞེ་ན་རི་ལ་སོགས་པ་མང་པོ་རྣམས་ཀྱང་བདག་གཅིག་གིས་བྱེད་དོ་ཞེས་བྱ་བའི་རྣམ་པར་རྟོག་པ་ཁོ་ནར་ཡང་འགྱུར་བ་ཁོ་ན་སྟེ།",
    "དེ་ནི་ཕན་པ་འགའ་ཞིག་རེས་འགའ་བྱེད་ལ་དོན་མ་ཡིན་པ་ནི་སྣ་ཚོགས་པ་བྱེད་པས་འདྲེས་པའི་བྱ་བ་ཅན་ཡིན་ཏེ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཕན་འདོགས་བྱེད་ཉིད་མི་འགྱུར་རོ་ཞེས་སྟོན་པ་ནི་རང་གི་བྱ་བ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ལན་དུ་དེ་ནི་དེ་ལྟར་གང་གིས་ཤེས་ཞེས་བྱ་བའོ།",
    "རང་གི་ཚིག་ཏུ་བརྗོད་པ་ཙམ་མོ་སྙམ་དུ་དགོངས་པའོ།",
    "འོན་ཏེ་རེ་ཞིག་རྫ་མཁན་ལ་ལྷན་ཅིག་སྐྱེས་པའི་མངོན་ཤེས་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "བྱིས་པ་ལ་སོགས་པའི་ཚེ་ཡང་ཡོད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེས་ན་དེའི་རེས་འགའ་བ་དེ་ཡང་མ་མཐོང་བ་འགའ་ཞིག་གི་ནུས་པ་ལས་ཡིན་པའི་ཕྱིར།",
    "དབྱིབས་དང་ལྡན་པ་གང་ཡིན་པ་དེ་དང་དེ་ནི་བློ་དང་ལྡན་པས་སྔོན་དུ་སོང་བ་ཡིན་ཏེ་ཞེས་གཉི་ག་ཡང་སྐྱེས་བུའི་འབྲས་བུའི་འབྲས་བུར་འདོད་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་གསལ་བ་མཐའ་དག་སེམས་པ་མེད་པའི་རང་བཞིན་ཅན་གཙོ་བོས་བཅུག་པ་ཡིན་པ་དེའི་ཕྱིར་བུམ་པ་ལ་སོགས་པ་ཡང་དེ་བཞིན་དུ་ཡིན་ནོ་སྙམ་དུ་དགོངས་པའོ།",
    "དཔེར་ན་རང་གི་བུ་ལོན་ཁྱེར་མཁན་ལ་གཏད་པའི་རྫས་ནོར་བདག་གིས་བླང་བར་བྱ་བ་ཡིན་ལ།",
    "ཤིང་གི་ས་བོན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ས་བོན་རིགས་མི་མཐུན་པ་ཞེས་བྱ་བ་ནི་གང་ཞིག་ས་བོན་ལ་ནུས་པའི་རང་བཞིན་དུ་རྣམ་པར་གནས་པའི་ཤིང་གི་དབྱིབས་དེ་དང་རིགས་མི་མཐུན་པའོ།",
    "དེ་ཉིད་སྨྲས་པ་ནི་འཇིམ་གོང་གི་ཞེས་བྱ་བའོ།"
  ]
}