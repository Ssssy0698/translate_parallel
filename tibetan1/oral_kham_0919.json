    "ཉེ་བའི་ཚལ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བུང་བ་ཁ་དོག་སྣ་ཚོགས་ཅན་ཁ་ཅིག་གསེར་གྱི་བྱ་ལྟ་བུར་འདུག་ལ།",
    "དེ་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་བུང་བའི་སྒྲ་སྙན་ཞེས་བྱ་བར་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་ལག་ན་ཡོལ་གོ་ཐོགས་པ་རྣམས་ཀྱི་། གནས་སྒྲ་ལ་ཆགས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "མིང་ནི་ཅི་ཞེས་བྱ་སྙམ་ནས་དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་བརྟགས་ན་ལྷའི་འཇིག་རྟེན་ན་ལྷ་རྣམས་ཀྱི་གནས་དྲིས་དྲེགས་དགའ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེ་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་ལག་ན་ཡོལ་གོ་ཐོགས་པ་རྣམས་ཀྱི་གནས་མེ་ཏོག་ཕྲེང་དགའ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་བརྟགས་ན་ལྷ་ལག་ན་ཡོལ་གོ་ཐོགས་པ་རྣམས་ཀྱི་གནས་ཀུན་ཏུ་ལྟ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་ལག་ན་ཡོལ་གོ་ཐོགས་པ་རྣམས་ཀྱི་གནས་རྟག་ཏུ་དགའ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "པདྨ་དཀར་སྤྱོད་ཅེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་སྣ་ཚོགས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་མཐོ་བར་གནས་ཞེས་བྱ་བ་འཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་རྒུན་ཆང་མྱོས་གནས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་ཆུ་བསིལ་གནས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྣམས་ཀྱི་གནས་སྒྲ་སྙན་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་ལྷའི་གནས་དེ་ལ་ཆགས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་སྐྱོར་ཆུས་སྐྱེས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་པི་ཝང་ཅན་གསུམ་པ་རྣམས་ཀྱི་གནས་ལུས་དཀར་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བྱའི་ཚོགས་མང་པོའི་སྒྲ་འབྱིན་པའི་རི་བོ་དེ་ལ་འཛེགས་ནས་རིའི་རྒྱལ་པོ་རི་རབ་དྲུག་ཁྲིས་བསྐོར་བ་དེ་རྣམས་ཀྱི་དབུས་ན་རིའི་རྒྱལ་པོ་རི་རབ་འདུག་པ་དེ་དག།",
    "ལྷའི་འཇིག་རྟེན་ན་ལྷ་ཕན་ཚུན་དགའ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་པི་ཝང་ཅན་གསུམ་པ་རྣམས་ཀྱི་གནས་ཡང་དག་ཆགས་སྤྱོད་ཅེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དབྱིབས་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པའི་སྒྲ་དང་ལྷ་རྣམས་ཀྱི་གླུ་དབྱངས་ཀྱི་སྒྲ་ཐོས་ན་སྙན་པ་དག་སྟེ།",
    "སྤྱོད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "འདབ་མ་ནི་གསེར་ཟེ་བ་རྡོ་རྗེར་འདུག་པ་རྣམས་ཀྱི་ནང་ན་དགའ་བར་བྱེད་དོ།",
    "དེ་ནས་ཡང་ཕ་དེ་དང་ལྷན་ཅིག་ཚལ་དེར་འདུག་པར་བྱེད་དོ།",
    "ལྷ་པི་ཝང་ཅན་གསུམ་པའི་གནས་སྤྱོད་པ་དང་ལྡན་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཇི་ལྟར་འདུག་པ་ནི།",
    "དེ་སེམས་བསྐྱེད་མ་ཐག་ཏུ་དཔག་བསམ་གྱིས་ཤིང་དེ་དག་ལས་འབྱུང་ཞིང་དེ་ནས་ཡང་དེ་མཛེས་པར་འདུག་སྟེ།",
    "གཟུགས་སྣ་ཚོགས་སུ་འདུག་པ་དག་བརྒྱ་བྱིན་འབའ་ཞིག་ལྟ་ལ།",
    "ཚལ་དེ་ན་བྱ་དངུལ་གྱི་ཁ་དོག་ཅན་དེ་དག་དེ་རྣམས་ལ་ཆགས་ཤིང་འདུག་པས་ཤིན་ཏུ་མཛེས་པར་བྱས་སོ།",
    "དེ་སེམས་ཤིང་འདུག་འདུག་པ་ལས་ཡུན་རིང་ཞིག་ལོན་པ་དང་།",
    "ཛམྦུ་ཆུ་བོའི་གསེར་བཟང་པོའི་སྟན་དེ་ཉིད་ལ་འདུག་པ་དང་།",
    "དེ་ནས་དེ་ལྟར་བརྒྱ་བྱིན་ལྷའི་སྟན་ལ་འདུག་ཅིང་ལྷའི་ཚོགས་ཀྱིས་ཡོངས་སུ་བསྐོར་ལ་གཟི་བརྗིད་འབར་བ་ན།",
    "བརྒྱ་བྱིན་ག་ལ་བ་དེ་ལོགས་སུ་ཕྱོགས་ནས་འདུག་སྟེ་བརྒྱ་བྱིན་ལ་འདི་སྐད་སྨྲས་སོ།",
    "དེ་དག་ཐམས་ཅད་དེ་བཞིན་འདུག་སྐྱེ་བོ་རྣམས་ནི་ཡོངས་སུ་འགྱུར།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་། པའི་ལྷ་རྣམས་ཀྱི་གནས་མཐོ་བ་ན་གནས་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་རི་རྩེན་གནས་བཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བལྟ་ན་སྡུག་པ་གནས་པ་ཞེས་བྱ་བའི་གནས་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཚལ་ཆེན་པོ་དེ་དག་བུང་བ་འདབ་མ་བེ་ཌཱུ་རྱ་ལ་ལུས་དངུལ་དུ་འདུག་པའི་ཚོགས་རྣམས་ཀྱིས་མཛེས་པར་བྱས་པ་ཡིན་ཏེ།",
    "དབྱིབས་སྣ་ཚོགས་སུ་འདུག་པ་བྱེ་བ་ཕྲག་སྟོང་དཀྲིགས་པ་དག་བྱུང་ངོ།",
    "མིག་རྒྱས་པ་ལྟ་བུར་འདུག་པ།",
    "དེ་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་ཕྱོགས་གཅིག་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེ་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཤིང་གསེབ་ན་གནས་པ་ཞེས་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཐད་ཀར་ལྟ་ཞིང་འདུག་པར་མི་བྱེད་པ་དང་།",
    "ལྷ་དག་ལྷའི་པདྨ་ལ་འདུག་ནས་གང་དུ་འགྲོ་བ་ངེར་ནམ་མཁའ་དེ་ལས་ལྷའི་བ་ཏུང་བས་གང་བའི་ལྷའི་སྣོད་དག་ལག་ཏུ་འོང་སྟེ་བཏུང་བ་དེ་དག་ལྷ་དང་།",
    "བེ་ཌཱུརྱ་ལས་བྱས་པའི་སྟེང་དུ་འདུག་ནས།",
    "བུང་བ་སྒྲ་འབྱིན་པ་ཁ་དོག་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པ་རྣམས་ཀྱིས་པདྨའི་རྫིང་བུ་དེ་དག་ཁེབས་པ་ཡིན་ཏེ།",
    "དེ་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་དགའ་བ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "སྐད་ཅིག་། གཉིས་པར་མི་འདུག་སྟེ།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ལ་རྟོག་པར་བྱེད་དེ་དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ས་རྣམ་མཛེས་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཆ་བྱད་སྣ་ཚོགས་སུ་འདུག་པ་དང་།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱིས་ཡོངས་སུ་འདུན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་འདྲེས་པའི་འགྲམ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ནེ་ཙོ་ཁ་དོག་སྣ་ཚོགས་སུ་འདུག་པ་ཁ་ཅིག་ཨནྡ་རྙིལ་ལྟ་བུ་དང་།",
    "གཡོགས་པའི་སྟང་ན་འདུག་པའམ།",
    "རིའི་རྒྱལ་པོ་རི་རབ་འདུག་པ་དེ་དག་ཐམས་ཅད་ལ་ལྟ་བར་བྱེད་དེ།",
    "མཐོ་བ་ན་རྒྱུ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་བཀྲ་བ་སྣ་ཚོགས་ཀྱིས་ཕྱེ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་སྦྱོར་བ་ལ་འཇུག་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེ་དག་དུས་ཡུན་རིང་དུ་རྩེ་བར་བྱེད་ཀྱང་བག་མེད་པ་ལ་གནས་པ་དག་ཁོང་དུ་མི་ཆུད་དེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་ཞིབ་ཏུ་དཔྱོད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེ་དང་ཐད་ཀར་འདུག་པ་ཡང་བྱེད།",
    "ཡིད་དུ་འོང་ལའང་འདུག་མི་བྱེད།",
    "ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཟླ་བའི་གནས་ལྟར་རྒྱུ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "གྲིབ་མ་དེ་དག་ལ་བསིལ་བར་འདུག་ཅིང་དེ་དག་ཀྱང་གདུང་བས་གདུངས་ལ་ཤིན་ཏུ་སྡུག་བསྔལ་། བར་གྱུར་པ་རྣམ་པ་དེ་ལྟ་བུའི་མ་བྱིན་པར་ལེན་པའང་ཡོངས་སུ་སྤོང་ཞིང་མི་བྱེད་ལ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཤིང་སཱ་ལ་ཟུང་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "འདུག་ཁྲི་དེ་དག་ཀྱང་སྡུག་པར་བྱས་ཤིང་རྐང་པ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་མཛེས་པར་བྱས་པའི་འདུག་ཁྲིའི་རྐང་པ་དེ་ལ་ཉེ་བར་བརྒྱན་པ།",
    "བཙུམས་ནས་འགྲོ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཁ་ཅིག་ནི་རྨ་བྱ་ལ་ཞོན་ཁ་ཅིག་ནི་བཞོན་པ་མེད་པར་ནམ་མཁའ་ལ་འདུག་སྟེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཀྱི་ནོར་བུ་འཕྱང་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "རི་ཆེན་པོ་འགུལ་བ་ལྟ་བུར་འདུག་པའི་གླང་པོ་ཆེ་དེ་ལ་ཞོན་པ་ནི།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ལ་རྟོག་དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་རིས་མཐུན་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "སྔོན་བསྒོམས་ཤིང་གོམས་པའི་བློས་སྨྲས་སོ་ དེ་ནས་གསར་དུ་སྐྱེས་པ་དེ་ཤིན་ཏུ་གཞོན་ལ་གཙང་གཙང་ལྟར་འདུག་པར་མཐོང་ཞིང་རྟོགས་ནས།",
    "གཟུགས་སྣ་ཚོགས་སུ་འདུག་པ།",
    "སྒྲ་ཤིན་ཏུ་སྙན་པ་འབྱིན་པ་བྱད་གཟུགས་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པ་དག་མཐོང་ངོ།",
    "དེ་བཞིན་དུ་ལྡུམ་བུའི་ནང་ག་ལ་བ་དེ་རྣམས་འདུག་པ་དང་དེར་ཡང་བྱ་དེ་དག་འདུག་པར་བྱེད་དོ།",
    "ངོ་བོ་ཉིད་ཀྱིས་ལུས་དཀར་ཤམ་ཉིད་དུ་འདུག་པ།",
    "དེ་ནས་ལྷའི་རྒྱལ་པོ་བརྒྱ་བྱིན་ཁང་བཟང་ཀ་བ་འབུམ་སྙེད་ཡོད་པའི་ནང་ན་རྒྱལ་བ་ཐོབ་པ་ཞེས་བྱ་བའི་སེང་གེའི་ཁྲིལ་འདུག་གོ།",
    "བདེ་བར་འདུག་པ་གཟི་བརྗིད་འབར་ཞིང་ལྷ་འབུམ་སྙེད་ཀྱིས་བསྐོར།",
    "མི་ཤིན་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་པ་རྣམས་ཀྱིས་དེད་པར་བྱེད་པ་ན།",
    "གཟུགས་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པའི་ལག་པ་དག་ན་རལ་གྲི་དང་།",
    "བཞིན་ཤིན་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་པ།",
    "ལུས་ཚལ་ཤིང་བསྲེགས་པ་ལྟར་འདུག་པར་བྱ་རོག་དང་།",
    "དེ་ལྟར་ལྷ་དེ་རྣམས་ཀྱིས་སྤྲུལ་པ་ཤིན་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་པ།",
    "ངོ་ཚ་ཤེས་པ་ཞེས་བྱ་བ་ནི་བདག་ཉིད་དབེན་པར་འདུག་ཅིང་བདག་ཉིད་འཇིགས་པར་སེམས་པའོ།",
    "སེམས་ལས་བྱུང་བ་དེ་དག་དུས་དེ་ལ་འབྱུང་ངོ།",
