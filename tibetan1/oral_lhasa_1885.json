    "གྲོགས་གང་དང་མཚུངས་པར་ལྡན་པ་དང་།",
    "ཚུལ་ཇི་ལྟ་བུར་ལོག་པར་ཞུགས་པ་དང་།",
    "མེད་པར་ལྟ་བ་དང་དམན་ལ་མཆོག་ལྟ་དང་།",
    "ཕྲ་རྒྱས་སྤངས་པར་མ་གྱུར་དང་།",
    "གཞན་གྱིས་མི་ནུས་པ་ལྟ་བ་དང་མཚུངས་ལྡན་གྱི་མ་རིག་པ་དང་གཞན་གྱི་ས་པའི་འདུ་བྱེད་ལ་ངའོ་སྙམ་དུ་མི་འཛིན་པར་བདག་ལྟ་ལས་གཞན་པའི་ལྟ་བ་བཞི་དང་།",
    "འོག་མ་དམན་པར་མཐོང་བས་ཁེངས་པ་ཡང་མེད་ལ།",
    "འོག་མ་ལས་མཆོག་ཏུ་འཛིན་པའི་ཕྱིར་རོ་ཞེས་གསུངས་ཏེ།",
    "ཡིན་པ་དེ་དག་ནི་འགོག་ལམ་དེ་དག་ལ་དངོས་སུ་དམིགས་པ་མ་ཡིན་པར་བལྟ་སྟེ།",
    "ལྟ་བ་མཚུངས་པར་ལྡན་པ་དང་བཅས་པའོ་ཞེས་པ་སྟེ།",
    "ཐེ་ཚོམ་དང་མ་རིག་པ་གཉི་གར་ཡང་གསུངས་ཏེ་ཕྲ་བའི་རྣམ་གཞག་གོ།",
    "མཚུངས་པར་ལྡན་པ་གང་ཞེ་ན།",
    "དམིགས་རྣམ་ལྷན་ཅིག་མཐུན་པར་རྟོགས་པས་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ནོ།",
    "ཁོང་ཁྲོ་བ་དང་མི་མཐུན་པ་ཇི་ལྟ་བར་ཐེ་ཚོམ་ཡང་དེ་བཞིན་དུ་མཚུངས་པར་མི་ལྡན་པ་ཡིན་ནོ་ཞེས་པ་སྟེ།",
    "ལྷག་མ་ང་རྒྱལ་དང་མ་རིག་པ་དང་ལྟ་བ་ནི་འཛིན་སྟངས་མི་མཐུན་པ་མེད་པའི་ཕྱིར་འདོད་ཆགས་དེ་དང་མཚུངས་པར་ལྡན་པ་ཡིན་ནོ།",
    "ང་རྒྱལ་དང་ལྟ་བ་དང་ཡང་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ནོ་ཞེས་བྱ་སྟེ།",
    "དེ་ལ་མཐའ་གཅིག་ཏུ་རྟོག་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ང་རྒྱལ་ནི་ཁོང་ཁྲོ་བ་དང་ཐེ་ཚོམ་དང་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ཏེ།",
    "མཚུངས་པར་ལྡན་པ་དང་།",
    "མ་འདྲེས་པའི་མ་རིག་པ་ནི་བདེན་པ་རྣམས་ཡང་ན་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་མི་ཤེས་པ་སེམས་ལ་འགེབས་ཤིང་སྒྲིབ་པ་དང་མུན་པར་གྱུར་པའོ།",
    "ལྟ་བ་ནི་ཞེ་འགྲས་པ་དང་བློ་མི་གནས་པ་ལ་རྟོག་མི་ནུས་པས་ཁོང་ཁྲོ་བ་དང་ཐེ་ཚོམ་དང་མཚུངས་པར་ལྡན་པ་ཡིན་ནོ།",
    "ཁེངས་པ་དང་རྟོག་པ་མེད་པས་འདོད་ཆགས་ང་རྒྱལ་དང་ལྟ་བ་རྣམས་དང་མཚུངས་པར་ལྡན་པ་མ་ཡིན་ནོ།",
    "གཞུང་ལ་ལར་མཚུངས་པར་ལྡན་ནོ་ཞེས་ཀྱང་འབྱུང་སྟེ།",
    "ལོག་པར་སྒྲུབ་པའི་ཐབས་ཡིན་པས་སྦྱོར་བ་དང་།",
    "དེ་ཁོ་ནའི་དོན་ལ་འགེབས་པར་བྱེད་པས་སྒྲིབ་པ་དང་།",
    "ལོག་པར་སྒྲུབ་པའི་ངོ་བོ་ཉིད་ཡིན་པས་ཉེ་བར་སྤྱོད་པ་དང་།",
    "སེམས་རྣམ་པར་གཡེང་བར་བྱེད་པས་ཟག་པ་དང་།",
    "འདོད་པས་ཕོངས་པར་བྱེད་པས་ཡོངས་སུ་གདུང་བ་དང་།",
    "རྒུད་པ་འདྲེན་པར་བྱེད་པས་འཁྲུག་པ་དང་།",
    "ཁྱད་པར་འཇིག་ཚོགས་ལྟ་བ་ཤེས་པ་ལ་སྒྲིབ་པ་ང་རྒྱལ་གྱི་ཀུན་ཏུ་སྦྱོར་བ་དང་།",
    "གནོད་བྱེད་འདིས་བདག་ལ་གནོད་པ་སྔར་བྱས་སོ་ད་ལྟར་བྱེད་དོ་ཕྱིས་བྱེད་པར་འགྱུར་རོ།",
    "ཡོན་ཏན་གྱི་ཁྱད་པར་མཚུངས་པ་བས་བདག་ཆེའོ་སྙམ་པའམ།",
    "དེ་ཉིད་རྟག་པའམ་ཆད་པའི་མཐར་འཛིན་པར་ལྟ་བ་དང་།",
    "རྒྱུ་དང་འབྲས་བུ་མེད་དོ་ཞེས་ལོག་པར་ལྟ་བའོ།",
    "གསུམ་པ་གང་ལ་རྒྱས་པར་གྱུར་ཚུལ་ནི།",
    "འབྱོར་བ་རྒུད་པའི་ཚེ་ཁོང་ཁྲོ་བའི་བག་ལ་ཉལ་རྒྱས་པར་འགྱུར་རོ།",
    "ཐེ་ཚོམ་གྱི་བག་ལ་ཉལ་རྒྱས་པར་འགྱུར་ཏེ།",
    "གནས་གྱུར་པའི་སྒོ་ནས་རྣམ་པར་གྲོལ་བར་མི་འགྱུར་ཏེ་དེ་དག་ལ་སྒྲིབ་པར་བྱེད་པ་དུག་གསུམ་དེ་མ་སྤངས་པའི་ཕྱིར་རོ།་",
    "རྣམ་པར་བྱང་བ་དང་མི་མཐུན་པའི་ཆ་ནས་གཞག་པའི་སྦྱོར་བ་ནི་བཞི་སྟེ།",
    "དེ་ཉིད་ལ་རྒྱུན་གྱི་ཡོངས་སུ་འཛིན་པས་ལྷག་པར་ཞེན་པ་དང་།",
    "དེ་དང་མི་འབྲལ་བར་འདོད་པས་སེམས་རྒྱུད་རྣམ་པར་བཅིངས་པ་དང་།",
    "རྒྱུན་གྱི་ཡོངས་སུ་འཛིན་པས་ལྷག་པར་ཞེན་པ་དང་།",
    "དེ་དང་མི་འབྲལ་བར་འདོད་པས་རྣམ་པར་བཅིངས་པ་དང་།",
    "ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་གཞག་པའི་ཡིད་དམ་སེམས་ཀྱི་རང་བཞིན་དུ་མ་བསགས་པའི་ལུས་ཀྱི་བར་དུ་གཅོད་པར་བྱེད་པའི་ཕྱིར་མདུད་པ་རྣམས་སོ་ཞེས་པ་སྟེ།",
    "ལྟ་ངན་ལ་མཆོག་ཏུ་འཛིན་པས་གནས་ལུགས་དང་མི་མཐུན་པར་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱེད་པས་ཤེས་བྱ་ལ་ལོག་པར་རྟོག་པའི་རྒྱུས་སེམས་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་མཐོང་བ་ལས་གཡེང་བར་བྱེད་དོ།",
    "ནང་དུ་བྱིང་ཞིང་ཞུམ་པར་བྱེད་པ་རྨུགས་པ་དང་གཉིད་ཀྱི་སྒྲིབ་པ་དང་།",
    "པ་མེད་པར་བྱེད་པའི་ཕྱིར་ཏེ།",
    "རྨུགས་གཉིད་ཀྱིས་ཞུམ་པར་བྱེད་པས་ཞི་གནས་ཏིང་ངེ་འཛིན་གྱི་དུས་ན་སྒྲིབ་པ་དང་།",
    "དེ་བཞིན་དུ་ཉེས་པར་སྤྱོད་པའི་ངོ་བོ་ནི་གསུམ་སྟེ།",
    "འདོད་ཆགས་ཀྱི་ཉེས་པར་སྤྱོད་པ་དང་།",
    "འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་དེ་དག་ལ་བརྟེན་ནས་སྲོག་གཅོད་ལ་སོགས་པ་ལུས་ཀྱི་ཉེས་པར་སྤྱད་པ་སྤྱོད་པ་དང་།",
    "གཞན་གྱི་ཉེས་པ་མི་བཟོད་པས་གནོད་པ་བྱས་པའི་རྒྱུ་ལ་ཐབས་སྣ་ཚོགས་ཀྱིས་ཡོངས་སུ་རྟོག་པའི་རྒྱུ་དང་།",
    "ལོགས་ཤིག་ཏུ་ནི་ཟག་པར་བསྟན།",
    "ཁྱད་པར་དུ་འདོད་པའི་ཡོན་ཏན་ལ་ཕྱི་རོལ་ཏུ་བལྟས་ཏེ་ཁམས་འོག་མར་ཟག་པའི་ཕྱིར་འདོད་པའི་ཟག་པའོ།",
    "པར་ཚུལ་བཞིན་མ་ཡིན་པར་ཡིད་ལ་བྱེད་པས་སྡུག་པ་དང་མི་སྡུག་པའི་མཚན་མ་འཛིན་པ་དང་།",
    "མཐུན་ཞིང་ཆགས་པར་མི་རིགས་པ་ཆོམ་རྐུན་ལ་སོགས་པས་ཡོ་བྱད་ཚོལ་བ་ལ་ཆགས་པའི་ཡོངས་སུ་གདུང་བ་ཆེན་པོས་ལུས་སེམས་ཡོངས་སུ་གདུང་བར་འགྱུར་བ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གགས་ལྔ་གསུངས་པ་གང་དག་ལགས་པ་དེ་དག་དུ་ནི་ཞི་གནས་ཀྱི་གགས་ལགས།",
    "དུ་ནི་གཉི་གའི་གགས་ལགས།",
    "འདྲེས་པར་གནས་པ་དང་ཅུང་ཟད་ཙམ་གྱིས་ཆོག་པར་འཛིན་པ་ནི་དེ་གཉི་གའི་གགས་ཡིན་ནོ།",
    "བདུན་པ་ལོག་པར་ཞུགས་པས་ཇི་ལྟ་བུ་ཞེ་ན།",
    "གཉིས་ལས་དང་པོ་སོ་སོས་ཡུལ་སོགས་ལ་ལོག་པར་རྟོག་ཚུལ་ནི།",
    "འདོད་ཆགས་ཇི་ལྟ་བར་ཁོང་ཁྲོ་བ་དེ་བཞིན་ནོ་ཞེས་པ་སྒོམ་སྤང་ཡུལ་མི་སྡུག་པ་ལ་ལོག་པར་ཞུགས་པ་དང་།",
    "ཆགས་སྡང་དེ་དག་སེམས་ལ་དམིགས་པའང་ཡུལ་ལ་ལོག་ཞུགས་སུ་རིག་པར་བྱའོ།",
    "ལྟ་བ་ངན་པས་སེམས་ཁེངས་པས་ལྟ་བ་ལ་ལོག་པར་རྟོག་པའོ།",
    "མཐར་འཛིན་པར་ལྟ་བ་དང་།",
    "ལོག་པར་ལྟ་བ་ནི་ཤེས་བྱ་ཕུང་པོ་ལྔ་ལ་སྒྲོ་འདོགས་པ་དང་སྐུར་བ་འདེབས་པའི་སྒོ་ནས་ལོག་པར་རྟོག་པའི་ལྟ་བ་མཆོག་ཏུ་འཛིན་པ་དང་།",
    "དེའི་སྐྱོན་གྱིས་བྱུང་བའི་སྤྱོད་པ་དམན་པ་ལ་མཆོག་དང་དག་གྲོལ་ལ་སོགས་པར་འཛིན་པའི་སྒོ་ནས་ལོག་པར་རྟོག་པའོ།",
    "ཐེ་ཚོམ་ནི་བདེན་པ་ལ་བློ་རྩེ་གཉིས་སུ་འཇུག་པས་གཉེན་པོ་ཡུལ་དང་བཅས་པ་ལ་ལོག་པར་རྟོག་པའོ།",
    "མ་རིག་པ་ནི་སྔར་གྱི་ཐམས་ཅད་ལའང་ཁྱབ་བྱེད་དུ་ཡོད་པས་ཡུལ་ལ་སོགས་པ་ཐམས་ཅདེ་ལ་ལོག་པར་རྟོག་པའོ།",
    "གཉིས་པ་ཐམས་ཅད་བདེན་བཞི་ལ་ལོག་པར་རྟོག་ཚུལ་ནི།",
    "གཉིས་པོའང་བཅུ་པོའི་གཞིའམ་གནས་བྱེད་པ་ཉིད་ཀྱིས་ཀྱང་ཕན་ཚུན་རྒྱུ་ཡིན་པས་ལོག་པར་སྒྲུབ་པའམ།",
    "དེ་ལྟར་འཛིན་པའི་སྒོ་ནས་ལོག་པར་རྟོག་པའོ།",
    "མུ་སྟེགས་པས་འགོག་ལམ་ཕྱིན་ཅི་ལོག་ཏུ་བཟུང་ནས་ཀྱང་ལོག་པར་རྟོག་པའོ།",
    "ཐམས་ཅད་རྒྱུན་འཆད་ཁར་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "འགག་ཁར་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "བསམ་གཏན་གསུམ་པ་ན་ནི་ཡིད་བདེ་མེད་པས་བདེ་བ་དང་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "དེ་ཡན་ཆད་བསམ་གཏན་བཞི་པ་དང་གཟུགས་མེད་དུ་ནི་བདེ་བ་ལ་སོགས་པ་མེད་པས་བཏང་སྙོམས་ཉིད་དང་མཚུངས་པར་ལྡན་ནོ།",
    "འགག་ཁར་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ང་རྒྱལ་ནི་ཡིད་ཀྱི་ས་པ་ཁོ་ན་ཡིན་པས་འདོད་པའི་ཁམས་ན་ཡིད་བདེ་བ་དང་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "བསམ་གཏན་དང་པོ་དང་གཉིས་པ་ན་ནི་ཡིད་ཀྱི་ས་པའི་བདེ་བ་དང་ཡིད་མི་བདེ་བ་དང་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "འགག་ཁར་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ཀུན་གཞི་ཤིན་ཏུ་སྦྱངས་པའི་བདེ་བས་ཚིམ་པར་བྱེད་པས་ན་བདེ་བའོ།",
    "བསམ་གཏན་བཞི་པ་དེ་ཡན་ཆད་དུ་ནི་གཞན་མེད་པས་བཏང་སྙོམས་ཉིད་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ང་རྒྱལ་གྱི་མཚུངས་ལྡན་ཇི་ལྟ་བ་བཞིན་དུ་དང་པོར་འཇིག་ཚོགས་ལ་ལྟ་བ་དང་ནས་མཐར་འཛིན་པར་ལྟ་བ་དང་།",
    "དེ་ཡན་ཆད་ན་བཏང་སྙོམས་ཁོ་ན་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ལྔ་པ་ལོག་པར་ལྟ་བ་ནི།",
    "འགག་ཁར་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "འགག་ཁར་བཏང་སྙོམས་དང་སམཚུངས་པར་ལྡན་ནོ།",
    "ཚོར་བ་གང་ཡོད་པ་འ་དེ་དང་མཚུངས་པར་ལྡན་ནོ།",
    "མཚུངས་པར་ལྡན་པ་ཅན་ཡིན་པས།",
    "ཁམས་དང་ས་གང་ན་ཚོར་བ་ལྔ་པོ་གང་ཡོད་པ་དེ་དང་མཚུངས་པར་ལྡན་པ་ཅན་ཞེས་བྱའོ།",
    "འགོག་ཁར་བཏང་སྙོམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ཡིད་ཀྱི་ས་པའི་ཚོར་བ་གང་ཡོད་པ་དེ་དང་མཚུངས་པར་ལྡན་ནོ།",
    "བདེ་སྡུག་ཅན་གྱི་ཕུང་པོ་ལ་དམིགས་པའི་ལྟ་བའང་བདེ་སྡུག་ལྡན་པ་ལ་སོགས་པ་གསུངས་སོ།",
    "འདོད་ཆགས་ཇི་ལྟ་བར་ཁོང་ཁྲོ་བ་དང་མ་རིག་པ་ཡང་དེ་བཞིན་དུ་ཚོགས་དྲུག་དང་མཚུངས་པར་ལྡན་ནོ།",
    "མིག་དང་རྣ་བ་དང་ལུས་དང་ཡིད་དེ་རྣམ་པར་ཤེས་པའི་ཚོགས་བཞི་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ལྟ་བ་ནི་ངེས་པར་རྟོག་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་ཚོགས་གཅིག་པུ་དང་མཚུངས་པར་ལྡན་ནོ།",
    "ང་རྒྱལ་ནི་ཕུན་སུམ་ཚོགས་པའི་ཁྱད་པར་ལ་འཇུག་པས།",
    "ཐེ་ཚོམ་གྱིས་མཐའ་གཉིས་སུ་འཛིན་པས་བཞི་ནི་དངོས་སུ་ལོག་པར་རྟོག་པ་དང་།",
    "ཁོང་ཁྲོ་ནི་མི་མཐུན་པའི་ལྟ་བ་སྡང་བས་ལྔ་ནི་ལོག་ཞུགས་ལ་ལོག་པར་རྟོག་པ་དང་།",
    "དེ་དང་མཚུངས་ལྡན་འདྲེས་པའི་མ་རིག་པ་དང་མ་འདྲེས་པའི་མ་རིག་པ་ནི་གནས་ལུགས་མི་ཤེས་པས་གཉི་ག་ལ་ལོག་པར་རྟོག་པའོ།",
    "ལམ་མེད་པར་འཛིན་པ་ལ་སོགས་པ་མཐོང་བས་སྤང་བར་བྱ་བ་རྣམས་ཀྱང་དེ་བཞིན་དུ་བཅུ་སྟེ།",
    "ལྟ་བ་དང་པོ་གཉིས་བདེན་པ་ཕྱི་མ་གསུམ་ལ་མི་འཇུག་པར་གསུངས་པ་ནི་རགས་པའི་རྣམ་གཞག་ཡིན་ལ།",
    "ཐེ་ཚོམ་དང་ལྟ་བ་ཕྱི་མ་གསུམ་ཀུན་བརྟགས་ཁོ་ན་ཡིན་པས་མ་གཏོགས་པར།",
    "མཐའ་མེད་པར་མ་བྱས་སོ་ཞེས་པ་དང་།",
    "མ་རིག་པ་སྟེ་བཞི་ཡང་ལྟ་བ་ལ་ལོག་པར་ཞུགས་པ་ཀུན་བརྟགས་ཀྱི་ཆ་རྣམས་མ་གཏོགས་པར།",
    "ཡུལ་ལ་ལོག་པར་ཞུགས་པར་ལྷན་སྐྱེས་ཀྱི་ཆར་གྱུར་པའོ།",
    "ཕྲ་བའི་རྣམ་གཞག་ལ་ལྷན་སྐྱེས་ཐམས་ཅད་སྒོམ་སྤང་དུ་གསུངས་ཤིང་།",
    "སའི་དངོས་གཞི་དང་མཐུན་པར་དྲུག་ཅར་སྒོམ་སྤང་དུ་བཞེད་དོ།",
    "ཤེས་བྱའི་སྒྲིབ་པ་རྣམས་སྒོམ་སྤང་ཞེས་ཀྱང་འཆད་པར་འགྱུར་རོ།",
    "ཐུབ་པས་ཤེས་རབ་དོན་དུ་གསུངས།",
    "མི་འཁྲུག་པའི་རྣམ་པར་གྲོལ་བ་རྣམ་གྲོལ་བླ་ན་མེད་པ་སྟེ།",
    "བསམ་པ་ཡང་ངོ་ཞེས་གསུངས་པ་ལྟར་སེམས་པ་ཡིད་ཁོ་ནའི་ལས་དང་།",
    "དེ་ནི་སེམས་པ་དང་དེས་བྱས།",
    "ཡང་དག་པར་འཛིན་པའི་སེམས་པ་དང་།",
    "འདི་བྱ་འདི་མི་བྱ་ཞེས་དཔྱོད་པར་ཞུགས་པ་ངེས་པའི་དང་།",
    "ཕྱི་མ་བསམ་པའི་ལས་སོ་ཞེས་གསུངས་ཏེ།",
    "སས་རྟེན་བྱེད་པ་དང་མཚན་ཉིད་ཀྱིས་མཚོན་པར་བྱེད་པ་ལ་སོགས་པ་བྱེད་པའི་ལས་དང་།",
    "རྣམ་པར་ཤེས་པས་ན་ཡིད་དེ་ལུས་ངག་མི་འཇུག་པའི་དུས་ཀྱི་དེ་མཚུངས་ལྡན་གྱི་ལས་སོ།"
  ]
}