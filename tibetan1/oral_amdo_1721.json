    "དགེ་ལེགས་སར་བ་སར་བའི་མེ་ཏོག་གིས།",
    "སྲོག་གི་ཕྱིར་ཡང་མི་གཏང་ངོ།",
    "ཐུན་མོང་སྣང་ངོར་ཡང་ལུང་དང་རྟོགས་པའི་ཡོན་ཏན་རྒྱ་མཚོའི་ཕ་རོལ་ཏུ་སོན་པ་རྡོ་རྗེ་འཆང་མཚན་བརྗོད་པར་དཀའ་བ་རྗེ་བཙུན་འཇམ་དབྱངས་ཐུབ་བསྟན་རྒྱ་མཚོ་དཔལ་བཟང་པོ།",
    "མཐོང་ནས་སྲོག་གི་ཕྱིར་ཡང་མི་གཏོང་བར།",
    "རང་གི་རྒྱུད་དང་གཞན་གྱི་རྒྱུད་སྨིན་པར་བྱེད་པའོ།",
    "དེ་ཙམ་ནི་ཐུན་མོང་གི་སྣང་བར་ཡང་ལུང་དང་རྟོགས་པ་ཟད་མི་ཤེས་པས་ཐུགས་ཀྱི་བང་མཛོད་ཡོངས་སུ་མཛེས་པ་མཉམ་མེད་དོན་ཀུན་གྲུབ་པའི་རྒྱལ་ཚབ་རྗེ་བཙུན་འཇམ་དབྱངས་ཐུབ་བསྟན་རྒྱ་མཚོ་དཔལ་བཟང་པོའི་མདུན་ནས་བར་མ་རབ་བྱུང་དང་ཚིགས་སྔ་མ་དགེ་ཚུལ་གྱི་སྡོམ་པ་རྣམ་པར་དག་པ་བཞེས་ཤིང་།",
    "ནན་ཏན་དང་བྲལ་ན་ཡང་སྐྱེ་བ་བཅུ་དྲུག་ཚུན་ལ་རྒྱལ་བ་རྡོ་རྗེ་འཆང་གི་རྒྱལ་ཐབས་ཟིན་པར་འགྱུར་བའི་ཐུན་མོང་མ་ཡིན་པ་རིགས་འཛིན་པའི་སྡོམ་པ་དང་འབྲེལ་བར་ལན་དུ་མའི་བར་བསྐྱར་བཞེས་གནང་སྟེ།",
    "སྐོམ་པས་གདུངས་པའི་སྐྱེ་བོ་དག་གིས་ཆུ་དོན་དུ་གཉེར་བ་བཞིན།",
    "གཞུང་ལུགས་ཆེན་མོ་རྣམས་ཀྱི་དོན་རིགས་པ་དྲི་མ་མེད་པས་འབྱེད་པ་ལ་ཐོག་མར་གལ་ཆེ་བ་བསྡུས་སྦྱོར་གཉིས་ཀྱི་དོན་ལན་དུ་མའི་བར་དུ་གསན་པར་མཛད་ཅིང་།",
    "ཞེས་རྡོ་རྗེ་འཆང་ཨ་བྷྱའི་ཞབས་ཀྱི་སྙན་དུ་ཕུལ་བ་རྗེ་དེ་ཉིད་ལས་བདག་གིས་ཐོས་སོ།",
    "སྲིད་རྩེར་བསྒྲེངས་པའི་སྙན་པ་དཀར་པོའི་སྤྲིངས་ཡིག་གི།",
    "བུ་མོའི་ཐོས་པ་འཛིན་པའི་དྲུང་ན་གར་དུ་བསྒྱུར།",
    "དམ་པའི་བསྔགས་པ་ཕྲ་མོས་མ་བཟུང་བའི།",
    "ཇི་བཞིན་ཁྱོད་ཐུགས་རྫིང་བུར་ཐུན་མོང་དང་།",
    "རང་རྒྱུད་ཨ་མྲའི་འབྲས་བུ་མ་སྨིན་པ།",
    "ཕ་མཐའ་བྲལ་བའི་སྦྱིན་སོགས་སོར་མོའི་གདུབ།",
    "བཟུང་བའི་མོད་ལ་རྒྱལ་སྲས་དམ་པའི་སྤྱོད།",
    "མ་ལུས་འདི་ཡི་ལག་མཐིལ་སྐྱེད་མོས་ཚལ།",
    "ད་ནི་རེ་ཞིག་སྐུ་ཚེ་འདིའི་མཛད་པ་ཡོངས་སུ་རྫོགས་པ་ན་བསམ་བཞིན་མཛད་པའི་ཐ་མ་བསྟན་པའི་ཚུལ་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་འཕྲལ་གདན་ས་ཆེན་མོའི་ལས་སྣེ་བླ་གྲྭ་བཅས་ཀྱི་འདུས་སྤྱི་ནས་བརྟན་བཞུགས་ཕུལ་བར་ཞལ་བཞེས་བཟང་པོ་དང་།",
    "རེ་ཤིག་དྭངས་སྐྱེད་ཆེ་ཙམ་བྱུང་བས་དེར་འཁོད་ཐམས་ཅད་དབུགས་ཕྱུང་བར་གྱུར་ཅིང་།",
    "རྟ་ཐབ་ཀྱི་བསུ་བ་དང་བཅས་ཨ་མཆོག་ཉི་མ་ལུང་དུ་ཕེབས་ཏེ་རོང་འབྲོག་ལ་ལ་བཙས་དང་དགྲ་ལྷ་དཔངས་བསྟོད་སོགས་གནང་།",
    "ཚེས་དགུ་ལ་ཧོར་ཚང་གི་བསུ་བ་དང་པོར་འབྱོར་ཞིང་།",
    "བཅུ་གསུམ་ཉིན་ཧོར་ཚང་དང་གཏེར་ལུང་སེར་སྐྱའི་ཆིབས་བསུ་བདག་གིར་མཛད་དེ་གཏེར་ལུང་བླ་བྲང་དུ་བསེ་མཆོག་སྤྲུལ་དང་ཞལ་འཛོམས་པར་དར་གནང་དང་གཟིགས་པ་རྒྱ་ཆེན་མཛད།",
    "བཅོ་ལྔ་ལ་ཧོར་ཚང་ཀིརྟིའི་སྒར་གསར་དུ་གྲགས་པ་དགེ་ལྡན་བསྟན་འཕེལ་གླིང་དུ་སེར་སྤྲེངས་དང་བཅས་འདུ་ཁང་ཆེན་མོར་ཞབས་སོར་བཀོད་པར་གསོལ་སྟོན་ཞུས་ཤིང་བླ་བྲང་དུ་གཞི་ཕབ།",
    "སྐུའི་སྙུན་གཞི་ཇེ་ལོད་དུ་སོང་བར་བརྟེན།",
    "དེ་སྐབས་ལྷ་མོ་ནས་བགྲེས་གཞོན་ཐམས་ཅད་བློ་མ་བདེ་བར་གནས་ཆུང་སྐུ་ཁོག་པའི་རྟེན་དུ་སྤྱན་དྲངས་པར་འཕྲིན་ལས་རྒྱལ་པོ་བབས་ཏེ་ལུང་བསྟན་མང་དུ་སྩལ་བ་ལས།",
    "བྱང་རྟ་མཆོག་གིས་སྟོང་གསུམ་བསྐོར་བའི་དུས།",
    "དགུང་གཡུ་འབྲུག་གི་ཁ་ནས་གཏམ་སྙན་ཐོས།",
    "ཤར་སྟག་མོའི་བུ་ལ་ཅོད་པན་འདོགས།",
    "གསོལ་ཁ་བར་འཆད་རྩོད་རྩོམ་གསུམ་གྱི་སྒོ་ནས་བསྟན་འགྲོའི་དོན་རྒྱ་ཆེན་བྱེད་རྒྱུ་བསམ་ཀྱང་དཀའ་མོ་ཞིག་རེད།",
    "ཅེས་གསུངས་པ་སོགས་རེ་ཞིག་ཞིང་འདིར་གདུལ་བར་བྱ་བ་རྣམས་ཀྱི་དོན་ཡོངས་སུ་རྫོགས་ནས་བསམ་བཞིན་སྐུའི་བཀོད་པ་བསྡུ་བ་ལ་ཕྱོགས་པར་གྱུར་ཏེ།",
    "སྐུ་དབོན་ལ་གཟིགས་ནས་ཞལ་འཛུམ་པ་དང་བཅས་གདངས་དམའ་བས།",
    "ཞེས་སྨྲེ་ངག་གིས་ཞུས་པར་འོ་ཡ་འོ་ཡ་ཞེས་གསུང་ཞིང་།",
    "ལོ་སྔ་མར་གཟིམས་ཁང་གི་ཁྱམས་སུ་མཚན་མོ་འུག་པས་སྐད་སྒྲོགས་པ་དང་།",
    "ཡོངས་འཛིན་དམ་པས་རང་ཅག་གིས་སོ་སོའི་གདོང་ལ་ལྟོས་ཏེ་ངུས་པས་མི་ཕན་པས་རེབ་གོང་དུ་རྡོ་རྗེ་འཆང་གདན་འདྲེན་དུ་འགྲོ་དགོས་ཞེས་གྲོས་མགོ་བཏོན་ཏེ་ཕོ་ཉ་བ་འཕྲལ་དུ་བརྫངས།",
    "འོན་ཀྱང་མི་ལེགས་པ་རེ་བྱུང་ན་འདི་ལྟར་གྱིས།",
    "དྲི་བཟང་གིས་བྱུགས་པ་དང་།",
    "གདན་ས་ནས་དད་འདུས་བླ་གྲྭ་ཕལ་མོ་ཆེ་སྔ་ཕྱིར་ཕེབས་ཏེ་ཐམས་ཅད་ནས་མྱ་ངན་གྱི་གདུང་ཤུགས་དྲག་པོས་གསོལ་བ་བ།",
    "རྡོ་རྗེ་འཆང་ཨ་བྷྱའི་ཞབས་ཀྱིས་ལྗགས་བཀོད་བཞིན་ཐུགས་དགོངས་ཟབ་མོ་ཡོངས་སུ་རྫོགས་པའི་ཆ་རྐྱེན་དུ།",
    "ལྷག་པའི་ལྷ་སྐུར་རྩོལ་མེད་ངང་གིས་གྲུབ།",
    "འདི་གའི་བླ་བྲང་ཆེན་མོ།",
    "ཨ་མཆོག་ཉི་མ་ལུང་།",
    "ཨ་མཆོག་སྨད་ཀྱི་ཚོ་བ་བརྒྱད།",
    "རྔ་བ་ནས་རྨེ་རྒྱལ་ཚ་ཁོ་ཕྱོགས་ནས་བསྟན་བདག་ཆེན་མོ་དེ་གའི་གྲྭ་ཚང་གི་བླ་གྲྭ་རྣམས་དང་།",
    "དངུལ་དྲུག་ཆིབས་ཆེ་ཆུང་སོགས་སྲང་སྟོང་ཕྲག་གཅིག་གི་ཁྱད་ནོར།",
    "གདན་ས་ཆེན་མོཪ་མང་ཇ་ཉིན་འཁྱོངས་ལྔ།",
    "གསེར་ཁྲི་དགོན་དུ་མང་ཇ་ཉིན་འཁྱོངས་གཉིས།",
    "མཆོག་སྤྲུལ་ཉི་མ་གཞོན་ནུའི་དགྱེས་ཞལ་མྱུར་བར་མཇལ་དུ་རེ་བས་གདན་ས་ཆེན་པོས་གཙོས་དགོན་ལག་དང་བཅས་པས་ཁུར་བཞེས་ཀྱིས།",
    "རེ་རེའང་གྲངས་མཐའ་ཡས་པ་བསྒྲུབས་པ་དང་།",
    "ཡུམ་ཨུ་རྒྱན་མཚོ་གཉིས་ཀྱི་སྲས་སུ་ད་ལྟའི་མཆོག་གི་སྤྲུལ་པའི་སྐུ་འདིའི་རྣམ་པར་བྱོན་ཏེ།",
    "གཞོན་ནུ་ནས་ལྷན་སྐྱེས་ཀྱི་མཛད་པ་བཟང་བོ་ཆེས་ཆེར་ངོམ་པས་སྤྲེལ་སྤྱི་ལོ་༡༩༤༤ལོར་འོས་ཐོ་བསྡུ་མཁན་ཕྱོགས་སོ་སོར་སོང་སྐབས་འོས་ཐོའི་གྲས་སུ་ཕེབས།",
    "ཁྱབ་བདག་ཨ་བྷྱའི་ཞབས་ནས་འཇིགས་མེད་བསྣན་ཏེ་བློ་བཟང་བསྟན་འཛིན་འཇིགས་མེད་ཡེ་ཤེས་རྒྱ་མཚོ་ཞེས་མཚན་གྱི་རོལ་མོ་ཡོངས་སུ་བསྒྲགས།",
    "བསིལ་བའི་རེག་པ་འབེབས་པ་ལས།",
    "བསྟན་ཀྱང་ཕན་བདེ་འབའ་ཞིག་གི།",
    "སྒོ་ལས་གཞན་དུ་མ་མཆིས་མོད།",
    "འགྱུར་བའི་རེ་བ་རྗེས་འཇུག་ཀུན་གྱིས་འཆའ།",
    "རྗོད་བྱེད་རང་བློས་གང་སྤོབས་ཀྱིས་བཅད་ལྷུག་སྤེལ་མའི་བདག་ཉིད་ཅན་རིམ་པར་ཕྱེ་བ་གསུམ་དུ་བཅད་དེ་རྒྱས་བསྡུས་འཚམས་པར་བརྗོད་ཟིན་པས་རྗེས་སུ་འཇུག་པ་དག་གིས་ཚུལ་འདི་ལ་བརྟེན་ནས་དད་པའི་ཁམས་བརྟས་པར་བྱས་ཏེ་ལེགས་ཚོགས་ཀྱི་རྩ་བ་ཚུགས་པར་བྱའོ།",
    "ཡོངས་ཤར་སྤྱན་རས་འགྲོ་ལ་གཟིགས་གང་ཉམ་ཐག་དབུགས་འབྱིན་ཆེན་པོ་སྟེ།",
    "རྒྱལ་བས་གཟིགས་པའི་ཡུལ་ལས་འདས་པ་ཡིས།",
    "དེ་ལས་ཉུངས་དཀར་གཞོན་ནུའི་ལུས་དང་ལུས་སྐྱེས་ཕྲ་མོའི་རྫིང་བུའི་སྤུན་ཟླར་རྗེས་སུ་དཔོག་པའི་ཆ་ཙམ་ཞིག།",
    "བདེ་སྡུག་ལས་ཀྱི་རི་མོ་རྣམ་བཀྲ་སྐྱེ་རྒུའི་ཡིད་ལ་ཀུན་དགའི་ཆར།",
    "རིག་བྱེད་དག་གི་ཅོད་པན་འཛིན་པ་ཅན།",
    "མགོན་པོ་གང་གི་འཕྲིན་ལས་ཀྱི་གདུགས་དཀར་སྒྲེང་བའི་བྱེད་པོ་སྐུ་མཆེད་དབོན་ཆུང་དགེ་ལེགས་རྒྱ་མཚོ་དང་།",
    "ལྷ་རེག་དྲི་བྲལ་དང་དངུལ་གོས་ཕྲུག་གི་རྟེན་དང་བཅས་བསྟར་ཏེ།",
    "ན་མོ་གུར་མཉྫུ་གྷོ་ཥཱ་ཡ།",
    "མངོན་སུམ་གཟིགས་པ་ལེགས་འདོམས་ཟུར་གྱིས་རྟོགས།",
    "ཁྱད་པར་ཀུན་གཟིགས་བློ་བཟང་འཕྲིན་ལས་ཞེས།",
    "གཅིག་ཉིད་གསུང་གིས་མ་སྦས་གསལ་བར་གདམས།",
    "བགྲེས་གཞོན་ངུར་སྨྲིག་འཛིན་པ་ཟུང་དག་གཟིགས།",
    "ལང་ཚོའི་མེ་ཏོག་ལྔ་ཕྲག་གཅིག་གི་འཛུམ།",
    "རྡོ་རྗེ་ནག་པོ་ཆེན་པོ་མངོན་སུམ་གཟིགས།",
    "སྟག་ཚང་དཔལ་གྱི་ལྷ་མོའི་གདན་ས་རུ།",
    "གཟུགས་སྐུ་ཛམྦུ་ནཱ་དའི་མཆོད་སྡོང་གི།",
    "ཞི་དྲག་མ་ངེས་གློག་ལྟར་འགྱུ་བ་གཟིགས།",
    "གཙང་བྱེད་སོ་ཡིས་རེག་པ་མིའུ་ཐུང་།",
    "མཛད་འཕྲིན་དུ་ཀཱུ་ལ་ཡི་གོས་གཅིག་གིས།",
    "ངོ་མཚར་སྣ་ཚོགས་གཟིགས་པ་བརྗོད་ལས་འདས།",
    "སྐུ་ཚེ་འདིར་ཡང་ན་ཚོད་ཕྲ་མོ་ནས།",
    "སྒྲིབ་བྲལ་གཟིགས་པ་དངར་བའི་རྟགས་སུ་འཁུམས།",
    "དངོས་དང་གཟུགས་བརྙན་དག་གིས་མཚོན་འོས་པ།",
    "ཆུ་ཁམས་ལང་ཚོས་རབ་དྲེགས་འདབ་ལྡན་ལ།",
    "འཇིགས་རུང་སྲིན་མོའི་འོ་མ་བཞོས་པའི་རྒྱུན།",
    "རྟེན་ཐང་གཟིགས་པའི་མོད་ལ་འདི་ཞེས་དགོངས།",
    "པཎ་ཆེན་མཆོག་གི་དགྱེས་ཞལ་ཐོག་མ་རུ།",
    "སྤྱན་རས་གློག་ལྟར་གཡོ་བ་མངོན་སུམ་གཟིགས།",
    "རབ་མྱོས་སྣ་ཚོགས་གཏམ་གྱི་ཡོ་ལང་གིས།",
    "གླང་འབུར་སྒང་དུ་ལྔ་མཆོད་ཆེན་མོའི་སྐབས།",
    "གློག་འོད་འཁྱུག་པ་ལྟ་བུ་གཟིགས་དེ་དག།",
    "རྡོ་རྗེ་གསང་བ་མཆོག་གི་དགའ་ཚལ་དུ།",
    "གཟིགས་པ་རབ་ཡངས་མ་སྦས་མཚོན་པར་མཛད།",
    "ཕྱི་ནང་ཐུན་མོང་ཉིད་ཕྱིར་མཚར་དུ་མེད།",
    "ཆེད་དུ་གཟིགས་ཏེ་བསམ་བཞིན་ཞི་བར་གཞོལ།",
    "མཆོད་འོས་ཏོག་གི་བློ་གྲོས་བེཌཱུརྱའི།",
    "ཐུན་མོང་མིན་པའི་མཛད་པ་ཡོད་དགུའི་གཟུགས།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་ཡུལ་དུ་མ་སོང་ན།",
    "ཅེས་པའི་བར་ཚིགས་བཅད་རེ་རེའི་མཐར།",
    "ཀྲུང་གོའི་བོད་རིག་པ་དཔེ་སྐྲུན་ཁང་གིས་བསྐྲུན་ཏེ་བཀྲམ།",
    "པེ་ཅིན་ཉུག་ཧྲན་ཧྲི་ཤིན་པར་ཁང་གིས་པར་བཏབ།",
    "རྣམ་རྟོག་སོར་མོའི་སྒྱུར་བ་ལྷུར་ལེན་པའི།",
    "ཨུ་རྒྱན་གྱི་དུར་ཁྲོད་རྒྱུ་སྐར་དཔལ་གྱི་རོལ་པར་བདུད་བཞིའི་གཡུལ་ལས་རྣམ་པར་རྒྱལ་མའི་ཚོགས་ཀྱི་གཙོ་མོ་བདག་མེད་མ་ལས་མཆོག་ཐོབ་ཅིང་།",
    "དཔལ་ལྡན་སུམ་ཅུ་རྩ་དྲུག་གི་ལུང་ཐམས་ཅད་ཀྱི་ཕ་རོལ་ཏུ་བརྒལ་བ།",
    "སེམས་ཀྱི་ངོ་བོ་བཏགས་པ་དང་ཞེན་གཟུང་གང་གིས་ཀྱང་མ་བསླད་པ་འདི་ཡིན་ལ།",
    "རང་གི་རང་བཞིན་སྒྲིབ་བྲལ་དུ་མངོན་དུ་གྱུར་བ་ལ་འགོད་པར་འདོད་པ་གཞན་ལ་དམིགས་པའི་སེམས་དང་།",
    "གལ་ཏེ་ཡོད་ན་དེ་གང་གིས་ཀྱང་གཞིལ་བར་མི་ནུས་ཏེ།",
    "དེ་ནི་སེམས་མ་བཅོས་པ་ལས་གཞན་གང་གིས་ཀྱང་འཆིང་མི་ནུས་ལ།",
    "དེ་ལྟ་བུའི་མ་བཅོས་པ་དེ་ཡང་འགའ་ཞིག་སེམས་མེད་པར་འདུ་ཤེས་པའི་རང་བཞིན་ཅན་གཟུགས་མེད་པའི་ཏིང་ངེ་འཛིན་གྱི་ཆར་གྱུར་པ་དག་མ་ཡིན་ནམ་སྙམ་དུ་རྟོག་མོད།",
    "དེ་ཉིད་རྣལ་འབྱོར་བླ་ན་མེད་པའི་རྒྱུད་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་ངེས་གསང་ཡིན་ཏེ།",
    "ཁ་ནས་བྲེ་མོའི་གཏམ་སྨྲས་པས།",
    "རྟེན་འདི་ཉིད་ཀྱིས་མཆོག་གི་སྤྲུལ་པའི་སྐུ་མངོན་དུ་བྱ།",
    "དེ་ནས་ཉི་མ་གུང་གིས་ཆ་ལ་མངོན་སྤྱོད་ཀྱི་འཕྲིན་ལས་ལ་བློ་སྦྱང་སྟེ།",
    "རྟེན་འདི་ཉིད་ཀྱིས་མཆོག་གི་སྤྲུལ་པའི་སྐུ་མངོན་དུ་བྱ།",
    "ཕོ་ཉ་དང་ཕོ་ཉ་མོ་ལྕགས་ཀྱུ་དང་ཞགས་པ་ལ་སོགས་པ་ཐོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས།",
    "འོད་ཟེར་གྱི་ལྕགས་ཀྱུས་དྲངས་ཏེ་ལྷ་དང་སྲུང་མར་བཅས་པ་ཐམས་ཅད་རང་གི་ལུས་དཀྱིལ་ལ་གཞུག་མ་དག་པའི་ལྔ་ཕུང་།",
    "འདོད་ན་བསྲུང་བཟློག་གི་སྔགས་དང་ཏིང་ངེ་འཛིན་ཡང་འདིར་སྦྱར།",
    "རྟེན་འདི་ཉིད་ཀྱིས་མཆོག་གི་སྤྲུལ་པའི་སྐུ་མངོན་དུ་བྱ།",
    "འཁོར་ལོ་ལས་འོད་ཟེར་དམར་པོ་ལྕགས་ཀྱུ་ལྟ་བུའི་ཚོགས་དང་ཕོ་ཉ་དང་ཕོ་ཉ་མོ་ལྕགས་ཀྱུ་དང་ཞགས་པ་ཨུཏྤལ་དམར་པོའི་གཞུ་ཐོགས་པ་ལ་སོགས་པ་དཔག་ཏུ་མེད་པ་སྤྲོས།",
    "སླར་ཡང་ལུས་དཀྱིལ་གྱི་ལྷའི་ཐུགས་ཀ་དང་སྦྱོར་མཚམས་ནས་བྱུང་བའི་འོད་རྣོན་པོས་རེག་པས་དེའི་བསྲུང་བ་རིགས་སྔགས་ཏིང་ངེ་འཛིན་ལ་སོགས་པ་དང་ཡེ་ཤེས་ཀྱི་ཕྱོགས་ཀྱི་ཕུང་སོགས་ཐམས་ཅད་དང་།",
    "རྟེན་འདི་ཉིད་ཀྱིས་མཆོག་གི་སྤྲུལ་པའི་སྐུ་མངོན་དུ་བྱ།",
    "འཁོར་ལོ་ལས་སྤྱན་མ་ལ་སོགས་པའི་ལྷ་མོས་བདུད་རྩིས་གང་བའི་བུམ་པ་དཀར་པོ་སོགས་ཐོགས་པ་རྣམས་དང་འོད་ཟེར་དཀར་པོ་རབ་འབྱམས་སྤྲོས།",
    "ངོ་སྤྲོད་གཅིག་གི་ཡུལ་ལ་རྩ་བ་ཟིན་པས་ཟབ་མོའི་དོན་ཕྱོགས་མེད་དུ་ཟིན་པར་བྱེད།",
    "སྐྱ་རེངས་ཤར་བ་ནས་གཉིད་སྲབ་མོའི་འོད་གསལ་ལས་སྒྱུ་མའི་རྩལ་མ་འགགས་པ་ལ་བསླབ་པའི་ཕྱིར།",
    "དེ་ནས་བསམ་གཏན་གྱི་ཡན་ལག་གིས་ཕྱག་རྒྱ་ཆེན་པོར་བཅིངས་པ་ལས།",
    "རིག་པ་སོར་གཞག་གི་རྒྱལ་ས་བཟུང་བས་བདེ་གསལ་མི་རྟོག་པའི་ཉམས་འཆར་བར་བྱེད།",
    "རྐྱེན་སྣང་གི་རྟོག་པ་སྒྱུ་མར་ཤེས་པས།",
    "གཉིས་སྣང་གི་ཤེས་པ་གྲོལ་བར་བྱེད།",
    "དེས་ལས་དང་ཡེ་ཤེས་དང་ཕྱག་རྒྱ་ཆེན་མོའི་རྒྱུ་ལས་སྐྱེས་པའི་སྟོང་གཟུགས་རབ་འབྱམས་སོ་སོ་རང་རིག་གི་མངོན་སུམ་དུ་བྱེད་པ་ནི།",
    "ཕྱི་མཚན་ཉིད་ཀྱི་གདམས་པ་ལ་བརྟེན་ནས་ཚོགས་ལམ་བློ་སྦྱོང་གིས་ལམ་བགྲོད།",
    "དེ་ཉིད་མོས་སྤྱོད་དུ་མོས་པས་འཇུག་པའི་དང་།",
    "གཤིས་ཀྱི་དེ་ཁོ་ན་ཉིད་རྟོགས་པ་ཞེས་བྱ་བའི་མིང་གིས་བསྙད་པ་ཡིན་ནོ།",
    "གང་ཟག་ནི་རྟག་པ་གཅིག་པུའི་ངོ་བོ་ཉིད་ཡིན་པར་གཞན་དག་གིས་བཏགས་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་དམ་གཞན་ཉིད་དུ་བརྗོད་དུ་མི་རུང་བའི་གང་ཟག་གིས་དངོས་པོ་ཡོད་པར་མི་རུང་སྟེ།",
    "གང་གི་རྣམ་པར་གཡེང་བའི་མི་ལྟ་བུའམ་སྤྲེའུ་བཞིན་དུ་སེམས་མི་གནས་པར་གྱུར་པ་ནི་རྒོད་པ་ཞེས་བྱ་ལ།",
    "དེ་ཉིད་ཉོན་མོངས་པ་རྣམས་རྣམ་པར་གནོན་པའི་གཞིར་གྱུར་པས་གཞི་ཤེས་ཀྱི་རྣམ་པ་ཞེས་བྱ་ལ།",
    "བྱིས་པ་རྣམས་ལ་སེམས་ཉིད་གཟུགས་ལ་སོགས་པ་ཕྱི་རོལ་དུ་ཆད་པ་བཞིན་དུ་སྣང་གི་དོན་དམ་པར་ན་འདི་ལ་གཟུགས་ལ་སོགས་པ་ནི་སེམས་ཀྱི་རྣམ་པ་ལས་གུད་ན་མེད་དོ།",
    "གང་གི་ཚེ་རྫུན་པའི་ངོ་བོ་ཉིད་གཟུགས་ལ་སོགས་པའི་རྣམ་པ་འཛིན་པས་སེམས་ཉིད་སྣ་ཚོགས་ཀྱི་རྣམ་པར་སྣང་བ་དེའི་ཚེ།",
    "སེམས་གང་གིས་ཡོངས་སུ་རྟོགས་པ་དེ་ཡང་སྟོང་པར་རྟོགས།",
    "དེ་དེ་ལྟར་ཤེས་རབ་ཀྱིས་དངོས་པོ་མཐའ་དག་གི་ངོ་བོ་ཉིད་ལ་སོ་སོར་བརྟགས་ནས་གང་ཞིག་ཀྱང་མི་དམིགས་པར་བསམ་གཏན་བྱེད་པ་དེའི་ཕྱིར་ཤེས་རབ་མཆོག་གི་བསམ་གཏན་པ་ཞེས་བྱའོ།",
    "མཛའ་བཤེས་དང་དགྲ་ལ་ཡང་སེམས་མཉམ་པ་ཉིད་དུ་བསྒོམ་མོ།",
    "རིམ་གྱིས་ཐ་མལ་པ་དང་དགྲ་ལ་ཡང་བསྒོམ་མོ།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པའི་ངོ་བོ་ཉིད་ཀྱི་རྣམ་པར་མི་རྟོག་པའི་གཟུགས་བརྙན་གྱི་ཞི་གནས་ལྷག་མཐོང་གི་གཟུགས་བརྙན་དུ་ལྡང་བ་སྟེ།",
    "མོས་པར་བྱེད་དོ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་ཐམས་ཅད་གཟིགས་ཏེ།",
    "ཞལ་ལུང་དུ་ཐལ་བྱུང་གི་སྟོང་པ་ཞེས་བསྙད་དོ།",
    "དེ་བས་རྣམ་རྟོག་གི་བཅོས་མས་སྒྱུ་མར་བརྟག་པ་མིན་གྱི་ཚོགས་དྲུག་གི་འཇུག་པ་གང་ཤར་ཉིད་ཀྱི་སྟེང་དུ་མཉམ་པར་གཞག་པ་རང་གིས་སྒྱུ་མ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་མངོན་དུ་འགྱུར་བ་སྟེ།",
    "བདག་གི་དེ་ཁོ་ན་ཉིད་དམ།",
    "དེ་ཉིད་ཟུང་འཇུག་གི་རིམ་པའང་ཡིན་ཞིང་།",
    "དེ་ནས་ས་བདུན་པའི་བར་དུ་ཉོན་མོངས་པའི་བག་ཆགས་ཀྱི་ལུས་ཕྲ་བ་སྦྱང་བའི་ཕྱིར་ཟུང་འཇུག་གི་ཏིང་ངེ་འཛིན་ཉིད་སའི་རིམ་པས་སྦྱངས་པ་ལས་ས་བརྒྱད་པར་མི་སློབ་པའི་ཟུང་འཇུག་འགྲུབ་སྟེ།",
    "དེ་ལ་འོག་སྒོ་སྟེང་གིས་འཆུན་པར་གྱུར་ན།",
    "སྟེང་སྒོ་འོག་གིས་འཆུན་པར་གྱུར་ན།",
    "ཉམས་མྱོང་གི་སྣ་བདེ་བས་འདྲེན་པར་བྱེད་པས།",
    "དེ་ནས་ཡང་དང་ཡང་དུ་ལས་ཀྱི་ཕྱག་རྒྱ་ལ་བརྟེན་ནས་གཟུང་འཛིན་ཕྲ་རགས་ཐམས་ཅད་བསྡུས་ཏེ་གཉིས་སྣང་གཅོད་པའི་རྒྱུན་སྤྱི་བོ་ནས་བརྩམས་ཏེ་མཐེ་བོའི་བར་གྱི་ནཱ་ཌི་སྟོང་ཕྲག་བདུན་ཅུ་རྩ་གཉིས་ལ་ཨཱ་ལི་ཀཱ་ལིའི་བདག་ཉིད་དུ་ཞུགས་པར་གྱུར་པས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སོ་སོ་རང་གི་རིག་པ་ཉིད་རྫོགས་པར་བྱེད་པའི་བདེ་བ་ཆེན་པོའི་ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཀྱི་དགའ་བ་བཞི་པོ་ཉིད་རེ་རེ་ཡང་བཞི་བཞིར་ཕྱེ་བས་ཁམས་ཟླ་བའི་ཆས་དབྱེ་བའི་རང་སའི་ས་བཅུ་དྲུག་གམ།",
    "རེ་དོགས་མེད་པའི་གནས་ལུགས་རྟོགས་པ་ཞེས་པའི་དོན།",
