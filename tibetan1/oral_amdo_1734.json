    "ཤེས་རབ་ཟབ་མོ་སྲོག་གི་ཟུངས་ཆེན་འགྲོ་བའི་མིག་ཏུ་རབ་བསྒྲུབས་ཏེ།",
    "ཚིགས་བཅད་ཕྱི་མ་འདི་གཉིས་དེང་དུས་ཀྱི་སྙན་ངག་སྨྲ་བ་རྫོགས་ཆེན་པ་པདྨ་སྐལ་བཟང་གི་གསུང་ལས་དྲངས་པའོ།",
    "དངོས་སྟོབས་རིགས་པའི་གད་རྒྱངས་རེ་རེས་ཀྱང་།",
    "མང་ཐོས་བསམ་འཕེལ་ནོར་བུའི་ཟེར་ཕྲེང་རྨོངས་མུན་སྲོག་གི་གཤེད་དུ་སྤྲོས།",
    "མཐར་ཆགས་ཚིག་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་རྣམ་རྫོགས་སྦྱོར་བའི་བཞེད་ལུགས་བཞུགས། ༥གི་འབྲུ་ངོ་གཉེར་བ་བྱིས་པའི་ཀློག་གི་ངང་ཚུལ་གཅིག།",
    "འབྲེལ་མེད་ཐལ་ཉོག་འཁོར་ལོ་བསྐོར་བ་མ་རབས་གསར་བུའི་བྱ་སྤྱོད་གསུམ།",
    "ཡོངས་སུ་འཛིན་པའི་དམ་པ་གང་གི་ཞབས་ཀྱིས་རེག་པའི་ཕྲ་མོའི་རྡུལ་ཡང་བདེ་ཆེན་འཁོར་ལོ་མཛེས་པའི་རྒྱན་དུ་ལན་གཅིག་མིན་པར་རབ་བཀོད་ཅིང་།",
    "གསོད་གཅོད་གཏུབ་གསུམ་གྱི་སྒོ་ནས་རང་གཞན་ཕུང་ལ་སྦྱོར་བས་ནགས་ཁྲོད་ཀྱི་གཅན་གཟན་གདུག་པ་ལས་ཀྱང་ཡ་ང་བའི་ཐ་ཆད་བླུན་པོ་དག་གི་རྗེས་སུ་མི་འབྲང་བར།",
    "རིགས་པའི་རྒྱབ་རྟེན་མཁས་པའི་གཞུང་ལུགས་བོར་ཏེ་རྣམ་རྟོག་གིས་བསྐྲུན་པའི་ཚིག་འཁྲི་སྐམ་པོ་འབའ་ཞིག་གི་ཐལ་ཕྲེང་མཐར་ཆགས་སུ་བཀོད་པ་རྩོད་པ་ལྷུར་ལེན་གྱི་བསྟན་བཅོས་སུ་བགྲང་བར་འོས་པ་དང་།",
    "གཞན་ཁ་ཅིག་གིས་རང་ལུགས་འདི་ཡིན་གྱི་ངེས་པ་སྤུ་ཙམ་ཞིག་མེད་པར་རྒན་པོའི་ཟེར་སྒྲོས་མིག་མཐོང་ལག་ཟིན་བྱུང་ངོ་ཅོག་ཕྱོགས་གཅིག་ཏུ་བསྡུས་པ་མུ་ཏོ་བའི་བརྒྱགས་ཕྱེ་དང་མཚུངས་པ་དང་།",
    "ཡང་འགའ་ཞིག་གིས་ནི་རྩ་འགྲེལ་མ་བུའི་ཡི་གེ་བཞིན་ཕལ་ཆེར་ཞུ་དག་བྱེད་བཏུབ་པའི་ཚོད་ཙམ་དུ་སོང་བཞིན་དུ་མིང་བྱང་བརྗེས་པའི་དཔེ་རྐུན་མ་ལ་བསྟན་བཅོས་སུ་བཏགས་པ་རྣམས་ནི།",
    "མཚོ་ཡི་ནང་གི་གསར་སྐྱེས་པདྨོ་བཞིན།",
    "མི་ཚེ་ཧྲིལ་པོར་ཐལ་མོ་བརྡབ་ན་ཡང་ཚིགས་བཅད་རེ་ཡི་དོན་འགྲེལ་དུ་བཅུག་ཚེ་འཁུན་བུ་ཤར་ཤར་དུ་ལུས་པ་ལ་ལ་དང་།",
    "ཡང་ཁོང་གིས།",
    "ལུང་དེ་རྣམས་ཡོད་པ་སྔ་མོ་ནས་མང་པོས་ཤེས་པས་ངས་བསྟན་བཅོས་བརྩམས་པར་བྱས་སོ་ཞེས་ཡུས་ཆེ་ཙམ་དུ་འགྱུར་བར་ཟད་དོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཞེས་གསུངས་པ་ལྟར་བློ་གྲོས་མཆོག་ལྡན་གྱི་མཁས་པའི་ཚོགས་སུ་འགྲེམ་པར་འོས་པའི་གཏམ་ཞིག་ནི་ཁོ་བོའི་ཁ་ནས་ཐོན་དཀའ་བར་འདུག་མོད།",
    "བརྒྱད་པོ་དེ་དག་གི་སྔ་ཕྱིའི་གོ་རིམ་ནི་ཚོང་པ་ཚོང་གི་ཁེ་སྤོགས་ཐོས་ན་དེ་ཡི་ཐབས་ལ་ངམ་ཤུགས་ཀྱིས་འཇུག་པ་བཞིན་ཐོག་མར་འབྲས་བུ་ལ་སྤྲོ་བ་བསྐྱེད་པའི་ཆེད་དུ་རྣམ་མཁྱེན་བསྟན་ཏོ།",
    "དེ་ཡི་དགོས་པ་ཡང་ཐོབ་བྱའི་ལུས་ཀྱི་ཁྱད་པར་མ་ངེས་པར་དེ་ཐོབ་པའི་ཆེད་དུ་གྱ་ཚོམ་དུ་མི་འཇུག་པ་ནི་རྟོག་དཔྱོད་དང་ལྡན་པའི་སྐྱེས་བུ་དག་གི་སྲོལ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་ཚོགས་གཉིས་ཀྱིས་འབྲས་བུ་རྣམ་མཁྱེན་སྒྲུབ་པ་ལ་ཐབས་ལ་མཁས་པ་དང་མི་མཁས་པའི་བྱེ་བྲག་གིས་ཉེ་རིང་གི་ཁྱད་པར་གཉིས་སུ་འགྱུར་རོ་ཞེས་ཤེས་པའི་ཆེད་དུ་དེ་ནས་གཞི་ཤེས་བསྟན་ཏོ།",
    "མཐར་གྱིས་པའི་དགོས་པའང་གོམས་པ་མཐར་ཐུག་པའི་སྟོབས་ཀྱིས་ཟག་པ་མེད་པའི་ཡོན་ཏན་རེ་རེ་བསྒོམས་པས་ཟག་མེད་ཡོན་ཏན་གྱི་རིགས་ཐམས་ཅད་མངོན་དུ་འགྱུར་བའི་ཆེད་དུ་ཡིན་ལ།",
    "རྩེ་མོའི་བརྒྱད།",
    "མཚོན་བྱེད་གཞན་རྣམས་ནི་ཡུལ་དེ་ཡི་ཡན་ལག་ཡིན་པས་དེ་ཡི་མིང་གིས་བསྟན་པ་ཙམ་མོ།",
    "འདི་དག་ནི་ཁོ་བོའི་རྣམ་རྟོག་གི་སྤྲོས་པ་འབའ་ཞིག་པ་ལགས་པས་ལུང་རིགས་མཁྱེན་པའི་མཁས་པ་དག་གིས་དཔྱད་པར་འཚལ་ལོ།",
    "ལམ་ཤེས་སྐྱེ་བའི་རྟེན་ལ་འགལ་རྐྱེན་ཉོན་མོངས་མངོན་འགྱུར་བ་མེད་པ་དང་།",
    "གསུམ་པ་དེ་ལ་ཡང་སྒྲིབ་པ་ཕྱོགས་རེ་བ་དང་མཐའ་དག་གི་གཉེན་པོའི་རིམ་པས་མཐོང་སྒོམ་གཉིས་རིམ་པ་བཞིན་དང་།",
    "བྱེད་ཅན་སྒོམ་ལམ་གྱི་ངོ་བོ་ལ་དམན་དང་མཆོག་གི་རིམ་པས་ཐོག་མར་ཟག་བཅས།",
    "འདི་གཉིས་ཀྱི་གོ་རིམ་ནི་དམན་མཆོག་གི་གོ་རིམ་ཡིན་ནམ་སྙམ་ལ།",
    "མི་མཐུན་ཕྱོགས་ངོ་ཤེས་ནས་སྤོང་བའི་ཆེད་དུ་སྐྱོན་ཡོན་ལ་སྤང་བླང་གི་སྒོ་ནས་སྒོམ་དགོས་པས་བསྒོམ་བྱ་སྦྱོར་བའི་རང་བཞིན་ངོས་ཟིན་པའི་ཕྱིར་མཚན་ཉིད།",
    "རྣམས་ཀྱི་ཉམས་ལེན་དུ་བྱས་པའི་འཕགས་སེང་གཉིས་ཀྱི་ལུགས་ལྟར་སྦྱར་བ་ཡིན་གྱིསདཀའ་འགྲེལ་སྦས་དོན་ཟབ་མོ་ལས་ནི།",
    "སྐྱོན་མེད་དེ་ཞེས་དོགས་སྤངས་ཀྱི་སྒོ་ནས་འབྲེལ་འཆད་པར་མཛད་འདུག་མོད།",
    "དེ་འདྲའི་དོགས་པ་དེ་གཞི་མེད་ཀྱི་དོགས་པ་ལྟ་བུ་ཞིག་ལས་སྐྱེ་འོས་པའི་གཞི་གང་ཡིན་ལེགས་པར་མ་ངེས་པས་འཆད་ཚུལ་དེ་རེ་ཞིག་བཏང་སྙོམས་སུ་མི་འཇོག་ཀ་མེད་བྱུང་ངོ།",
    "དམན་དང་མཆོག་གི་གོ་རིམ་སོགས་འདི་ལའང་ཡོད་པར་ངེས།",
    "དེ་ལྟ་མིན་པར་གཞུང་དུམ་བུ་རེ་ལ་གོ་བ་དུམ་བུ་རེ་བླངས་ཏེ་རྫ་ཆགས་སྤུངས་པ་ལྟར་ཕན་ཚུན་འབྲེལ་ཅི་ཡང་མེད་པ་ཞིག་ཏུ་གྱུར་ན།",
    "གཞུང་གི་གོ་བ་བསྐྱེད་པའི་བསྡུས་པའི་དོན།",
    "མོས་པ་རང་གི་དོན་དང་ནི།",
    "ཇི་ལྟ་ཇི་སྙེད་ནང་གི་ནི།",
    "ཡེ་ཤེས་གཟིགས་པ་དག་པས་ན།",
    "རྒྱུ་སྙེད་གཟིགས་པའི་ཡེ་ཤེས་ཀྱི་ཡུལ་དུ་བཞག་པ་རྣམས་དྲང་དོན་ཡིན་པར་གསུངས་ལམཚན་ནི་དེ་དག་ཀུན་རྫོབ་ཐ་སྙད་ཀྱི་རྣམ་གཞག་ཡིན་གྱི་དེ་ཁོ་ན་ཉིད་ཀྱི་གནས་ལུགས་གཏན་ལ་འབེབ་པ་མ་ཡིན་པའི་ཕྱིར་སྙམ་དུ་དགོངས་སོ།",
    "ཞིབ་ཏུ་དཔྱད་ན་ད་དུང་དོགས་པའི་ལྷག་རོ་ཅུང་ཟད་མེད་དམ་སྙམ་པའི་འོག་འགྱུ་ཞིག་བྱུང་ན་ཡང་རེ་ཞིག་ཁོ་བོའི་སྤྱོད་ཡུལ་དུ་གྱུར་པའི་ལན་ནི་དེ་ཙམ་ལགས་སོ།",
    "༥དེའང་དྲང་ངེས་འབྱེད་ཚུལ་འདི་འདྲ་སུས་ཀྱང་མ་དྲངས་པའི་རྟོག་བཟོ་ཨེ་ཡིན་སྙམ་པ་དག་གི་ངོར་མཁས་པ་གཞན་གྱི་གཞུང་ལུགས་ཀྱི་ཁུངས་ཙམ་བསྟན་པ་ཡིན་གྱིས།",
    "དམན་ལམ་སྔོན་སོང་གི་བྱང་སེམས་ཀྱི་རྒྱུད་ཀྱི་གང་ཟག་གི་བདག་མེད་དང་གཟུང་མེད་རྟོགས་པའི་རྣལ་འབྱོར་མངོན་སུམ་མམ།",
    "ལམ་གང་གིས་སྡུག་བསྔལ་ཡོངས་སུ་ཤེས་པ་དང་།",
    "ཞེས་ཚོགས་སྦྱོར་གཉིས་པོ་ལམ་བདེན་དངོས་མ་ཡིན་ཡང་ལམ་བདེན་གྱི་འཁོར་དུ་གཏོགས་པར་གསུངས་པ་རྣམས་ཀྱིས་ནི་གཉེན་པོ་རྣམ་བྱང་གི་ཕྱོགས་སུ་བསྟན་པ་ལྟ་བུ་དང་།",
    "ཞེས་དྲོད་རྩེ་གཉིས་རིམ་བཞིན་ཀུན་ཉོན་དང་རྣམ་བྱང་གི་གཟུང་རྟོག་དང་།",
    "༥བའི་སྲིད་པ་ལ་མི་ཕྱོགས་པ་ཡིན་མོད་ཀྱི།",
    "རང་ཡུལ་ལ་ཞེན་པའི་བློ་མིན་པར་ཐལ།",
    "རང་ཡུལ་ལ་ཞེན་པ་བཀག་པའི་བློ་ཡིན་པའི་ཕྱིར་ཞེས་རྟགས་ཁྱབ་ཚད་གྲུབ་ཏུ་བྱས་ནས་བཏང་འདུག་མོད།",
    "ཞེན་བློ་མིན་པར་ཐལ།",
    "མ་གྲུབ་ན་དེར་ཐལ།",
    "ཞེན་བློ་ཡིན་པར་ཐལ།",
    "ཞེས་འཕངས་ན་འཁོར་གསུམ་ཐོག་འབབ་པ་ལྟར་འགྲོ་བར་སྙམ་མོད།",
    "ཁྱོད་ཞེན་བློ་ཡིན་ན་ཞེན་པ་བཀག་པའི་བློ་ཡིན་པ་འགལ་ཞེས་ཚིག་ཙམ་ལ་འཐམ་པ་ཡིན་ན་ནི།",
    "བསྡུ་བའི་ལུང་གི་དོན་ནི་སྦྱོར་ལམ་གྱི་བློ་དེ་ལ་གཉེན་པོའི་ཆ་དང་ཟག་པའི་ཆ་གཉིས་ཡོད་པ་ལས།",
    "དེ་བས་སྦྱོར་ལམ་མཉམ་གཞག་ཙམ་དུ་མ་ཟད་ཚོགས་སྦྱོར་གང་རུང་གིས་བསྡུས་པའི་མངོན་རྟོག་ཡིན་ན་སྒྲིབ་གཉིས་གང་རུང་མིན་པས་ཁྱབ་ཅེས་མགྲིན་པ་གཟེངས་བསྟོད་དེ་སྨྲ་བར་བགྱིའོ།",
    "ཕལ་མོ་ཆེ་ཞིག་རང་ལུགས་དང་མི་མཐུན་པར་མ་ཟད་བརྒལ་ཞིང་བརྟག་པར་འོས་པའང་མང་པོ་ཞིག་འདུག་མོད།",
    "སྤྱིར་ཐེག་ཆེན་མཐོང་ལམ་དེ་སྐད་ཅིག་མ་གཅིག་དང་བཅུ་དྲུག་གང་ཡིན་རྩོད་པ་ཙམ་ལས་རྟག་མི་རྟག་གི་གླེང་སློང་གནང་མཁན་ཕལ་ཆེར་བྱུང་མེད་པ་འདྲ་ཡང་།",
    "ཡོངས་སུ་གྲགས་པའི་བོད་སྟོན་ཕལ་མོ་ཆེ་ཡི་སྙན་དུའང་དེ་ཙམ་འགྲོ་བར་དཀའ་མོད།",
    "ལུང་རྣམས་ནི་མང་བས་འཇིགས་ནས་འདིར་མི་འབྲི་མོད།",
    "དོན་དམ་དུ་མེད་མཉམ་དང་ཐ་སྙད་དུ་ཡོད་མཉམ་ཡིན་པའི་ཕྱིར་ཞེས་པའི་གཞུང་འདི་མ་གཟིགས་པའམ་གཟིགས་ཀྱང་དགོངས་བཞིན་དུ་ཁྱད་གསོད་གནང་བ་གང་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་རྣམ་རྫོགས་སྦྱོར་བའི་བཞེད་ལུགས་བཞུགས། ༥ཡིན་ཆ་མ་འཚལ།",
    "ཐོག་མར་འཕགས་པའི་མཉམ་གཞག་གི་ངོར་གཉིས་སྣང་ཐམས་ཅད་ནུབ་ནས་ཡུལ་དང་ཡུལ་ཅན་ཆུ་ལ་ཆུ་བཞག་ཏུ་འགྲོ་ཚུལ་ཇི་ལྟར་ཡོད་དེ།",
    "ཡུལ་ཅན་སྐྱེ་ཞིང་འགག་ལ་གནས་བཞིན་པའི་ངོ་བོ་གཉིས་རང་རང་གི་ས་ན་ཚུགས་མ་ཤོར་བར་ཡོད་པས་ཅི་ཙམ་དབྱེར་མེད་དུ་སོང་ཟེར་ཡང་ཆུ་དང་འོ་མ་འདྲེས་པ་བཞིན་ཕྱེ་རུང་གི་ཚུལ་དུ་ཡོད་པར་ངེས་སོ།",
    "རང་ཉིད་སྐྱེ་འགག་བྱེད་བཞིན་དུ་རང་ལ་སྐྱེ་འགག་དེ་མི་སྣང་ན་དེ་བེམས་པོ་རུ་ཐལ་བའི་ཐལ་བ་བརྒྱ་བྱིན་གྱིས་ཀྱང་ཟློག་པར་མི་ནུས་པས་སྐྱེ་འགག་མེད་པའི་ཕྱོགས་འདི་རིགས་ཤིང་འཐད་པར་སེམས།",
    "འོ་ན་མཉམ་གཞག་དེ་དོན་དམ་བདེན་པར་ཐལ་ལོ་ཞེ་ན་འདོད་པ་ཡིན་ལ་དེ་ལྟར་ན་ལམ་བདེན་མིན་པར་འགྱུར་རོ་སྙམ་ན་རྣམ་མཁྱེན་ལ་ཡང་མཚུངས་ཤིང་།",
    "རྣམ་མཁྱེན་ཀྱང་མི་རྟག་པར་འདོད་ན་ནི་འཇུག་པའི་དཀའ་འགྲེལ་དང་དངོས་འགལ་དུ་སོང་།",
    "དེ་ལའང་མི་བརྩི་ཟེར་ན་རེ་ཞིག་ཅི་ཡང་མི་སྨྲའོ།",
    "དཔེར་ན་སྟོན་པའི་གཟུགས་སྐུ་དེ་གནས་ཚོད་ཡེ་ཤེས་རྡོ་རྗེའི་སྐུ་ཡིན་ཡང་སྣང་ཚོད་གདོས་བཅས་ཤ་ཁྲག་གི་གཟུགས་སུ་སྣང་བ་བཞིན།",
    "ཐུགས་རྒྱུད་ཀྱི་མཁྱེན་པ་ཡང་དོན་དུ་སྐྱེ་འགག་མཐའ་དབུས་ཀུན་ལས་འདས་ཀྱང་སྣང་ཚུལ་ལ་འཇུག་ལྡང་རིམ་བྱུང་གི་རྣམ་ཅན་དུ་སྣང་བ་བསྙོན་དུ་མེད་པའི་ཕྱིར་རོ།",
    "ཡོངས་འཛིན་དམ་པའི་ཕྱག་གིས་ལེགས་ཕྱིས་པས།",
    "བུམ་འཛིན་མངོན་སུམ་དེ་རང་གི་ངོ་བོ་ལ་རང་རིག་ཡིན་ཡང་སྤྱིར་རང་རིག་མིན་པ་དང་།",
    "ཁྱོད་ཡུལ་དེ་ལ་རྗེས་དཔག་ཡིན་ན་ཁྱོད་ཡུལ་དེ་ལ་འཁྲུལ་ཤེས་ཡིན་པ་འབུད་ཅེས་པའི་འགལ་ཁྱབ་ཀྱི་ལན་འདི་གནས་སྐབས་ཀུན་ཏུ་འདེབས་ཤེས་པར་བྱའོ།",
    "ཐལ་རང་གི་སློབ་དཔོན་གཉིས་པོ་དོན་དང་ཐ་སྙད་གཉིས་ཀ་མི་མཐུན་ཞེས་གྲགས་ཤིང་།",
    "དེང་དུས་གཞན་ཕྱོགས་ཀྱི་མཁས་རློམ་ཁ་ཅིག་གིས།",
    "ཐལ་འགྱུར་བས་འཇིག་རྟེན་གྲགས་པའི་རྣམ་གཞག་བཞིན་དུ་ནང་ཚན་འགའ་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ཞིག་བདག་མེད་པས་ཀྱང་མེད་པའི་གོ་ཆོད་པར་བཞེད་དོ་ཞེས་སྨྲ་བར་ཐོས་མོད།",
