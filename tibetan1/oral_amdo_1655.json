    "འོན་ཀྱང་མི་ལོ་བཅུ་ཁ་ཞིག་འདས་སོང་བ་མ་རེད་དམ།",
    "ཧཱ་སན་ཕ་བུ་གཉིས་དེ་གར་ཡོད་མེད་ཐད་ང་ལ་གདེང་ཚོད་ཅི་ཡང་མེད།",
    "ཡང་ན་ཁོ་གཉིས་ཡུལ་གཞན་ཞིག་ལ་འཁྱམས་སོང་ནའང་ཐང་།",
    "གང་ལྟར་ངས་རེ་བ་བཅངས་ནས་ལམ་དུ་ཆས་པ་ཡིན།",
    "ཏག་ཏག་དེ་འདྲ་རེད།",
    "ཁོ་ཚོས་འུ་ཅག་གི་མེས་པོའི་ས་གཞིའི་སྟེང་བག་མེད་འདོད་ལོག་སྤྱད་པའི་རྣམ་སྨིན་གྱི་མཐུ་བཙན་པོས།",
    "ཁོ་ཚོས་རང་རེའི་ན་གཞོན་གང་མང་གི་གཅེས་སྲོག་ཕྲོགས་སོང་བ་རེད།",
    "ཨན་ལཱས་ཐུགས་རྗེས་གཟིགས་སོང་།",
    "མི་རྣམས་ཀྱིས་ང་ལ་ཁོའི་གྲོང་ཚོ་ཆུང་ཆུང་དེ་བསྟན།",
    "ངས་ད་ལྟ་ཐ་ན་གྲོང་ཚོ་དེའི་མིང་ཡང་བརྗེད་ཚར།",
    "སྣོལ་འཛིང་གི་ཡལ་ག་ཚེར་མས་ཁེབས་པའི་སྡོང་བོའི་གཞུང་རྟ།",
    "ཕུང་པོ་ཟགས་རུལ་དུ་གྱུར་མགོ་བརྩམས་འདུག་དེ་ནས་དཀྱོགས་སྐོར་ཞིག་བརྒྱབ་སྟེ་སོང་མཚམས་ངས་ས་ཁང་རྙིང་གོག་འགའ་མཐོང་།",
    "ས་གྱང་དེ་ཧ་ཅང་ཐུང་ངུ་ཞིག་རེད།",
    "ར་སྐོར་གྱི་ཟུར་ཞིག་ཏུ་སྟག་མའི་སྡོང་བོ་བཙུགས་ཡོད་ལ་སྡོང་བོའི་བསིལ་གྲིབ་འོག་ན་མེ་ཐབ་ཅིག་ཏག་ཏག་དེའི་འཁྲིས་སུ་སྐྱེས་པ་ཞིག་ལངས་འདུག་ཁོས་བྱེ་རློན་རྡོག་པོ་གཅིག་ཤིང་ཁེམ་ཞིག་གིས་ཐབ་ཀའི་ནང་ལྡེབས་སུ་སྦྱོར་རྩིས་བྱེད།",
    "ངས་ཁྱོད་ལ་གསལ་བོ་ཞིག་བལྟ་འདོད།",
    "ཁོ་སྔར་བཞིན་ལོ་མ་གཤགས་འདྲའི་མིག་འབྲས་ལྗང་གུ་ཅན་དེ་རེད།",
    "ཡ་མཆུའི་སྟེང་གི་རྨ་ཤུལ་ད་རུང་མངོན།",
    "སྔར་ལྟར་གདོང་པ་སྒོར་མོ་དེ་རེད།",
    "སྔར་ལྟར་མཛའ་བརྩེའི་འཛུམ་མདངས་དེ་རེད།",
    "ཁྱོད་ཀྱིས་ཅིས་ཀྱང་ཁོ་ངོས་ཟིན་ཐུབ།",
    "མོས་ཁང་པའི་གྲུ་ལོགས་ཤིག་ན་ཕྲག་ཁེབས་ཤིག་འཚེམ་བཟོ་བྱེད་ཀྱིན་འདུག་བལྟས་མ་ཐག་མངལ་སྦྲུམ་ཡོད་པ་ཤེས་ཐུབ།",
    "མོའི་དྭངས་ཤིང་མཛེས་པའི་མིག་ཟུང་ཁམ་ནག་དེས་གཏན་ནས་ང་ལ་ཐད་ཀར་བལྟས་མི་ཡོང་།",
    "འོན་ཀྱང་མོས་ཧཱ་སན་ལ་ལྟ་བའི་ངང་ཚུལ་དེ་མཐོང་ན།",
    "ས་འདམ་དང་གྱོ་མོས་བཟོས་པའི་ཁང་མིག་དེ་ལལྟ་སྐོར་ཟིན་རྗེས་ངས་དེ་ལྟར་དྲིས།",
    "ལྒང་བཞུ་སྒྲོན་མེ་གཅིག་བཅས་མ་གཏོགས་རྒྱུ་ནོམ་པ་ཞིག་གི་གྲིབ་མ་ཙམ་མི་མཐོང་།",
    "ཏག་ཏག་བྷ་རྨེ་དབྱང་མཁར་གྲོང་གི་ཕྱི་ལོགས་དེ་རེད་ཟེར།",
    "ཁྱོད་ཀྱིས་ཤེས་ཡོད་པ་དེ་བཞིན།",
    "ཁྱོད་ཀྱི་ཨ་ཕ་ངེད་གཉིས་ལྷན་ཅིག་ནར་སོན་པ་ཡིན་ལ།",
    "དེ་དུས་ང་ཚོ་ད་རུང་ཧ་ཅང་ཆུང་།",
    "དུས་དེར་ཁྱོད་ཀྱི་ཨ་ཕས་ཉིན་རྒྱུན་ཁང་པར་སྐོར་བ་རྒྱག་གིན་མཚམས་འཇོག་མེད་པར་ངུས་ཡོང་།",
    "ཁྱོད་ཀྱི་ཨ་ཕའི་ཁང་པའི་གནས་ཚུལ་ཡང་ཞིབ་རྒྱས་ངང་ཁོ་ལ་ཁ་བརྡ་བྱས།",
    "དེར་ཁྱོ་ཤུག་གཉིས་ཀས་ཕན་ཚུན་གྱི་གདོང་ལ་ལྟ་བ་ལས་ཅི་ཡང་མི་སྨྲ།",
    "ཁ་བརྡའི་ཞོར་ལ་ཧཱ་སན་གྱིས་གྲོང་ཚོ་དེ་ནི་ཁོའི་ཁྱིམ་ཡིན།",
    "ཁྱོད་ཀྱིས་ང་ལ་བཟོད་གསོལ་གནང་རྒྱུར་ངས་རེ་བཅངས་ཡོད།",
    "ཧཱ་སན་གྱིས་ཁྱོད་དང་འབྲེལ་བའི་དོན་བྱ་གང་མང་དྲིས་སོང་།",
    "ཁྱོད་ཀྱིས་གཉེན་བསྒྲིག་ཡོད་དམ།",
    "ཁྱོད་ལ་བྱིས་པ་སྐྱེས་ཡོད་དམ།",
    "ཁྱོད་ཀྱི་གཟུགས་པོའི་མཐོ་ཚད་ན་ག་འདྲ་ཡོད་དམ།",
    "ཁྱོད་ཀྱིས་ད་རུང་ཤོག་བྱ་སྤུར་རམ།",
    "ཁྱོད་བདེ་མོ་སྐྱིད་པོ་ཡིན་ནམ་ལ་སོགས་པ།",
    "ཁོས་ཁྱོད་ལ་འཕྲིན་ཡིག་ཅིག་བྲིས་ན་ངས་ཁྱོད་ལ་བརྒྱུད་སྤྲོད་བྱ་ཨེ་ཐུབ་ཟེར།",
    "ངས་ཁོར་སྔོན་ཆད་ཁྱོད་ཀྱི་ཨ་ཕར་ཁ་པར་ཐེངས་འགར་བཏང་མྱོང་ལ།",
    "དེ་དུས་ཁྱོད་ཀྱི་གནས་ཚུལ་ཐོས་ཙམ་བྱུང་ཞེས་ལབ།",
    "དེའི་འཕྲོར་ཁོས་ཁྱོད་ཀྱི་ཨ་ཕ་དྲིས་བྱུང་།",
    "ཁོས་ལག་པས་གདོང་པ་བཀབ་སྟེ་ཤ་ངུ་པགས་ངུ་བརྒྱབ་སོང་།",
    "དགོང་མོ་དེར།",
    "ཁོ་དང་ཧྥ་ཧྲ་ནཱ་གཉིས་ཕྱིར་ཁ་པུར་དུ་ལོག་སྟེ་ཁྱོད་ཀྱི་ཨ་ཕའི་གཞིས་ཀར་ང་དང་ལྷན་དུ་སྡོད་རྒྱུར་བློ་ཐག་བཅད་པ་ཡིན་ཟེར།",
    "ང་གནས་འདིར་ཡོང་བ་གཏན་ནས་འགྲིག་མ་སོང་།",
    "ང་གནས་འདིར་ཡོང་ནས་ཁྱོད་ལ་འདི་དག་ཡོད་ཚད་བློས་གཏང་དགོས་ཞེས་ལབ་པ་ཅི་འདྲའི་ཧོལ་རྒྱུག་ཅིག་རེད་ཨང་།",
    "ངེད་གཉིས་ཁྱོད་དང་ལྷན་དུ་སོང་ཆོག་ངེད་གཉིས་ཀྱིས་ཁྱོད་ལ་ལག་རོགས་བྱས་ནས་སྐུ་ངོའི་གཞིས་ཀར་གཉེར་ཁ་བྱས་ཆོག་ཟེར།",
    "ཁྱོད་ཀྱིས་དངོས་གནས་བསམ་བློ་ཡག་པོ་བཏང་ཡོད་དམ།",
    "ཁོང་གི་གཟིམ་ས་བདེ་བར་སྨོན་ཟེར།",
    "ཁྱོ་ཤུག་གཉིས་ཀས་རང་གི་ཁྱིམ་ནོམ་ཙམ་པོ་རས་ཧྲལ་གྲུ་བཞི་མ་ཞིག་གི་ཁུད་དུ་བླུགས་ཏེ་ཟུར་སྣེ་བཞི་ནས་ཕན་ཚུན་མདུད་པ་བརྒྱབ་རྗེས་ངའི་རླངས་འཁོར་ནང་བཞག་བྱུང་།",
    "ཧཱ་སན་གྱིས་སྐེ་ཕྱིར་དཀྱོགས་ཏེ་ཁྱོ་ཤུག་གཉིས་ཀའི་སྡོད་ཁང་དེ་ལ་ཆེས་མཐའ་མཇུག་གི་ཕྱི་མིག་བལྟས་པ་ངས་དྲན་སོས་ཐུབ།",
    "འདིར་སྡོད་མཁན་སུ་ཡང་ཡོད་པ་མ་རེད།",
    "ཧྥ་ཧྲ་ནཱ་ཁོ་གཉིས་ཀྱི་ཁྱིམ་ནོམ་ཙམ་པོ་གཅུད་པའི་རྡོག་ཁྲེས་དེ་སྒོ་ར་རྒྱབ་མའི་སྤྱིལ་བུ་དེའི་ནང་འཁྱེར་སོང་།",
    "གལ་སྲིད་དམག་འཁྲུག་མཇུག་བསྒྲིལ་སོང་ན།",
