    "དེས་ལུས་བརྟས་པར་བྱེད་པ་དང་།",
    "གླང་པོའི་གཅིན་བཏགས་རི་ལུ་བྱས།",
    "གྲིབ་མ་ལ་བསྐམས་ིལ་སྣཪ་བླུགས་པ་ལ་སོགས་པ་བྱས་ན་སྨྱོ་བྱེད་ཀྱི་གདོན་སེལ་བར་འགྱུར་རོ།",
    "བྱུགས་དང་བླུགས་པ་སྤྱད་པར་བྱ།",
    "རུལ་བའི་དུད་པས་བདུག་པར་བྱ།",
    "ལྟོགས་པ་ཉིད་དུ་བྱས་ཏེ་བསྐམ།",
    "རྫིང་བུ་ཆུ་ཉུང་བར་བཅུག་ལ་ལྟོགས་པ་ཉིད་དུ་བྱས་ནས་ལུས་བསྐམས་ན་ཡང་ཕན་ནོ།",
    "རྨད་དུ་བྱུང་བ་བསྟན་པར་བྱ།",
    "༢༡༧གྱུར་པའི་དངོས་པོ་བསྟན་པར་བྱའོ།",
    "ཆུ་ཚ་བས་ལུས་ལ་བསྲེག་པར་བྱའོ།",
    "མུན་ཁང་མི་ནི་མེད་པར་བཞག།",
    "ཡང་ན་རྡོ་དང་མཚོན་ཆ་མེད་པའི་ཁང་པ་མུན་ནག་དུ་གྱུར་པ་མི་མེད་པ་དག་ཏུ་གཞག་ོཔར་བྱའོ།",
    "སེང་གེ་ལ་སོགས་པས་སྐྲག་ཏུ་གཞུག་པར་བྱ་བའམ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ལས་བྱུང་བའི་སྨྱོ་བྱེད་ནི་འདོད་ཆགས་ལ་སོགས་པ་དེ་དག་ཉིད་ཀྱིས་གཅིག་ལ་གཅིག་གཉེན་པོར་བྱས་ཏེ་ཞི་བར་བྱའོ།",
    "ཆུ་བོ་གཉིས་འདུས་པའི་ལམ་དུ་སྦྱིན་པར་བྱའོ།",
    "ཕན་ལ་བརྩོན་ཞིང་གཙང་སྦྲ་ཆེ།",
    "གཙང་ཞིང་ལུས་དང་ངག་དང་ཡིད་ཀྱི་ལས་དྲི་མས་མ་གོས་པ་དང་།",
