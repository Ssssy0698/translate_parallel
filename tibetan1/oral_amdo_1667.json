    "ལོངས་སྤྱོད་ཀྱི་སྡུག་བསྔལ་ལས་བརྩམས་ཏེ་གཞན་དག་གི་ལོངས་སྤྱོད་རྒྱལ་པོ་དང་།",
    "ཡང་དག་པར་དགའ་བར་བྱེད་པ་དག་གིས་དུས་འདའ་བ་དང་།",
    "གཞན་དག་བཟའ་བ་དང་བཏུང་བ་སྦྱིན་པ་ལ་སོགས་པས་ཡོངས་སུ་བསྡུས་པ་ལས་འཇིག་རྟེན་པའི་དོན་གྱི་རྗེས་སུ་རྒྱུན་འཇུག་ཅིང་དོན་དུ་གཉེར་བ་རྣམས་ལ་འགྲོ་བ་དང་འོང་བ་བདག་གིར་བྱེད་དོ།",
    "རེ་ཞིག་ཐོག་མར་གནས་སྦྱིན་པར་བྱེད་དོ།",
    "རྔུབ་པ་དྲན་པ་བདག་གིས་འཇུག་པར་མཛད་དོ།",
    "སེམས་གནས་པར་ལ་རང་གི་དོན་ཐོབ་པར་ཕྱིར་ཡང་དག་པ་ཐབས་ཀྱིས་ལམ་སྟོན་པ་ནི་སྟོན་པའི་དབུ་སུམ་ཅུ་པའི་འགྲེལ་བཤད། ། མའི་ལམ་དང་།",
    "རང་གི་དོན་མཐར་མ་ཕྱིན་པ་ལ་བར་མ་དོའི་གནས་འདོར་དུ་འཇུག་པ་སྟེ།",
    "དེ་འདི་ལྟར་གཞན་དག་གི་སེམས་དང་མཐུན་པར་བྱེད་པར་འདོད་པ་ན་ཐོག་མ་ཁོ་ནར་དེ་རྣམས་ཀྱི་ངོ་བོ་དང་རང་བཞིན་ཤེས་པར་བྱ་བ་ནས།",
    "གང་གི་སེམས་དང་མཐུན་པར་བྱེད་འདོད་པར་གྱུར་པ་དེ་ལ་དེ་དང་མཐུན་པའི་ལུས་དང་ངག་གི་ཀུན་དུ་སྤྱོད་པས་དེའི་སྡུག་བསྔལ་དང་།",
    "གཅིག་པའི་ལུས་དང་ངག་གི་ཀུན་དུ་སྤྱོད་པ་གང་གིས་གཞན་དག་གི་སྡུག་བསྔལ་བ་དང་།",
    "བདག་ཉིད་ལ་ལུས་དང་ངག་གི་ཀུན་དུ་སྤྱོད་པ་གང་གིས་ཕ་རོལ་དག་ལ་སྡུག་བསྔལ་བ་དང་།",
    "བདེ་བ་ལ་རེག་པར་མི་གནས་པའི་ཕྱིར་འགྱོད་པ་སྐྱེད་པར་ཡང་མི་བྱེད་དོ།",
    "དེ་དག་གི་མདུན་དུ་མཛའ་བོ་ལ་སྨོད་པ་ཡང་མི་བྱེད།",
    "ཆད་པས་བཅད་པའམ་བསྐྲད་པར་བྱ་བ་དག་གིས་ཚར་བཅད་པའི་ལས་བྱེད་དོ།",
    "ཉེས་པ་འབྲིང་ལ་ནི་འབྲིང་གིས་སོ།",
    "བསྐྲད་པའི་ལས་ལ་ཉེས་པ་ཆུང་ངུ་དང་འབྲིང་དག་ལ་ནི་དུས་རེ་ཞིག་ཏུ་བསྐྲད་ནས་སླར་དགུག་པའི་ཚུལ་གྱིས་སྐྲོད་པར་བྱེད་དོ།",
    "དེ་དག་གིས་ཀྱང་དེ་ལྟ་བུ་མཐོང་སྟེ།",
    "ལུས་དང་ངག་གི་ལས་ཡོངས་སུ་དག་པར་འཇུག་པའོ།",
    "ཉོན་མོངས་པ་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་ཟིལ་གྱིས་མི་ནོན་ཅིང་མི་འཕྲོགས་པའི་ཕྱིར་བརྟན་པ་དང་།",
    "ལག་པ་དང་བོང་བ་ལ་སོགས་པས་བསྣུན་ཅིང་རྣམ་པར་འཚེ་བའི་རེག་པ་མི་འདོད་པ་དག་ཀུན་དུ་སྤྱོད་པར་མ་གྱུར་ཅིག་སྙམ་དུ་འདོད་ལ།",
    "དེས་བདག་གི་ཡིད་དུ་མི་འོང་བར་འགྱུར་བས་ན།",
    "གཞན་ཡང་དེ་ལྟར་འདོད་བཞིན་དུ་བདག་གིས་ལོག་པར་ཀུན་དུ་སྤྱད་པར་གྱུར་ན་དེས་དེ་དག་གི་ཡིད་དུ་མི་འོང་བར་འགྱུར་བའི་ཕྱིར།",
    "གང་བདག་དང་གཞན་དག་གི་ཡང་ཡིད་དུ་མི་འོང་བར་འགྱུར་བ་དེ་དག་གིས་གཞན་དག་ལ་ཅིའི་ཕྱིར་ཀུན་དུ་སྤྱོད་པར་བྱ་སྙམ་པ་དེ་སུམ་ཅུ་པའི་འགྲེལ་བཤད། ། ལྟར་སོ་སོར་བརྟགས་ནས་སྲོག་གི་ཕྱིར་ཡང་གཞན་དག་ལ་ཡིད་དུ་མི་འོང་བ་རྣམ་པ་བརྒྱད་པོ་ཀུན་དུ་སྤྱོད་པར་མི་བྱེད་པའོ།",
    "ཚར་གཅད་པར་བྱ་བ་རྣམས་ནི་ཚར་གཅོད་པར་བྱེད་ཅིང་ལུས་དང་ངག་གི་ལས་ཡོངས་སུ་དག་པར་འགྱུར་ཏེ།",
    "དགེ་སྦྱོང་གི་ཚུལ་དང་།",
    "གནས་མ་ཡིན་པར་འགྱོད་པ་མེད་པའི་ཕྱིར་ཧ་ཅང་ཡང་ཐལ་བ་མ་ཡིན་པ་དང་།",
    "དེ་ལྟར་ན་འདི་ནི་དེའི་མོད་ལ་ངན་སོངས་དུ་འགྲོ་བ་རྣམ་པར་བཅད་ཅིང་སྐྱེ་བར་འགྱུར་བ་མ་ཡིན་ནོ།",
    "འདི་ནི་ངན་སོང་རྣམ་པར་གཅད་པར་འདོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་འདི་ངན་སོང་རྣམས་སུ་སྐྱེ་བར་ནི་མི་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་ཡང་ངན་སོང་རྣམས་རྣམ་པར་མ་བཅད་ཀྱང་འདི་དེར་སྐྱེ་བར་མི་འདོད་དོ།",
    "གང་གིས་དེའི་མོད་ལ་ངན་སོང་རྣམ་པར་གཅད་པར་འདོད་པ་ཡང་འདི་ཐམས་ཅད་དུ་ངན་སོང་དུ་སྐྱེ་བར་མི་འདོད་པ་ཉིད་ཀྱང་མ་ཡིན་ཏེ།",
    "རིང་མོ་ཞིག་ནས་བརྒྱ་ལམ་ན་སྐྱེ་བར་འགྱུར་ན་ཡང་མྱུར་བ་ཉིད་དུ་དེ་ལས་ཐར་བར་འགྱུར་ཞིང་གནས་པ་ན་ཡང་དམན་པ་དག་ལྟ་བུར་མི་བཟད་པའི་ཚོར་བ་མྱོང་བར་མི་འགྱུར་ལ།",
    "རིང་མོ་ཞིག་ན་ངན་སོང་དུ།",
    "གཞན་ཡང་འདི་ལྟ་བུ་ངན་སོང་དུ་སྐྱེ་བར་སྨྲ་བ་ནི་རིགས་པ་མ་ཡིན་ཏེ།",
    "བདག་གི་དངོས་པོའི་ཕུན་སུམ་ཚོགས་པའམ།",
    "གང་གིས་ནི་འདི་མནོད་པར་བྱ་ཞེ་ན།",
    "གསུམ་པོ་དེ་དག་གི་ཁྱད་པར་རྟོགས་པར་བྱེད་པ་ཉིད་དོ།",
    "དེ་སྐད་ཅེས་སྨྲ་བ་ན་གལ་ཏེ་རབ་ཏུ་སྤྲོའོ་ཞེས་བྱ་བའི་ཚིག་སྨྲ་ཞིང་གདོང་དང་མིག་འགྱུར་བ་དག་གིས་ཉིན་ཞག་དག་འདའ་བར་བྱེད་ན།",
    "དེ་ལྟར་ན་གང་གིས་འདི་དོན་དུ་གཉེར་བ་ཡིན་གྱི།",
    "བདག་གིར་བྱ་དང་སྡིག་བཤགས་པ།",
    "གང་གི་ཕྱིར་མི་ཤེས་པའི་སྒྲིབ་པ་ཆེན་པོ་ཐམས་ཅད་དང་།",
    "ཕྱོགས་གཅིག་གིས་བསྒྲིབས་པས་མི་མོས་པར་འགྱུར་རོ།",
    "ཕན་པ་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པ་དང་།",
    "གཅིག་གི་མདུན་དུ་ལྷག་མ་རྣམས།",
    "ཉོན་མོངས་མི་སྤོང་བདག་སེམས་བཞིན།",
    "ཉོན་མོངས་དྲག་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ཕ་རོལ་རྒྱལ་ནས་འདི་དག་གིས་སྡོམ་པ་ལས་ཡོངས་སུ་ཉམས་པར་འགྱུར་བའི་ཕྱིར་ཕས་ཕམ་པའོ་ཞེས་བྱ་བ་ནི་ངེས་པའི་ཚིག་གོ།",
    "ཐམས་ཅད་དུ་དགེ་སློང་གི་བཞིན་དུ་ནི་མ་ཡིན་ཏེ།",
    "ཚེ་འདི་ལ་སླར་ཡང་དགེ་སློང་གི་དངོས་པོར་འགྱུར་བའི་སྐལ་པ་མེད་དོ།",
    "འདི་ནི་སྡོམ་པ་གཏོང་བ་འབའ་ཞིག་ཙམ་མོ།",
    "ཉོན་མོངས་དྲག་ལས་བྱུང་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "ཉོན་མོངས་པ་དྲག་པོ་ལས་བྱུང་བ་ཡིན་ཞིང་སྐྱེས་པ་གང་དག་ཡིན་པ་དེ་རྣམས་ནི་དེ་ལྟ་བུ་སྟེ།",
    "ཉོན་མོངས་དྲག་པོ་ནི་ཟག་པ་རྣམས་ཕྱིར་ཞིང་རྒྱུན་མི་ཆད་པར་ཀུན་དུ་སྤྱོད་ཀྱང་གང་འདི་ངོ་ཚ་ཤེས་པ་དང་།",
    "གང་གི་ཚེ་སླར་ངོ་ཚ་དང་ཁྲེལ་ཡོད་པ་ཆུང་ངུ་ཙམ་སྐྱེ་བ་དང་།",
    "གང་གི་ཚེ་ཡང་མྱུར་བ་ཉིད་དུ་ངོ་ཚ་བར་བྱེད་ཅིང་རང་ཉིད་ཀྱང་རུང་སྟེ།",
    "སྐད་ཅིག་གིས་ལྡོག་པ་དེ་ནི་ཆུང་ངུ་ལ་གནས་པར་རིག་པར་བྱའོ།",
    "སྡོམ་པ་ཕུལ་བ་ཡང་དགེ་སློང་གིས་བསླབ་པ་ཕུལ་བ་ལྟ་བུར་རིག་པར་བྱའོ།",
    "བདེན་མོད་ཀྱི་དེ་ནི་སྡོམ་པ་བླངས་པ་སྡོམ་པ་འཇིག་པའི་རྒྱུ་ནི་མ་ཡིན་ནོ།",
    "ངན་སོང་འགྲོ་བར་འགྱུར་རོ་ཞེས་རྒྱ་ཆེར་གསུངས་སོ།",
    "ཐལ་བར་བརླག་ནས་ཞེས་བྱ་བ་ནི་རྣམ་པར་འཚེ་བར་བྱས་ནས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དབྱིག་པ་དག་གིས་རྡེག་པར་བྱེད།",
    "རྙེད་པའི་གནས་དང་བྲལ་བར་རི་མོར་བྱ་བའི་སེམས་ཀྱིས་རབ་ཏུ་དགའ་བ་བསྐྱེད་པར་བྱ་བ་ཡིན་ན།",
    "དབྱིག་པ་དག་གིས་རྡེག་པར་བྱེད།",
    "རྙེད་པའི་གནས་དང་བྲལ་བར་རི་མོར་བྱ་བའི་སེམས་ཀྱིས་རབ་ཏུ་དགའ་བ་བསྐྱེད་པར་བྱ་བ་ཡིན་ན།",
    "ཟག་པ་འབྲིང་ནི་བདག་ལ་བསྟོད་པ་ལ་སོགས་པའི་རྒྱུར་གྱུར་པ་གང་ཡིན་པའི་ཉོན་མོངས་པ་ཉིད་དེ།",
    "ཀུན་ནས་དཀྲིས་པ་འབྲིང་གིས་བསྐྱེད་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཡང་དེ་རྣམས་ལ་ཐལ་མོ་སྦྱར་ཏེ་བྱ་བ།",
    "བྱས་ལ་དམའ་བའི་ཕྱོགས་སུ་ཙོག་ཙོག་པོར་འདུག་སྟེ་ཐལ་མོ་སྦྱར་ནས་ཐོག་མར་དངོས་པོ་བརྗོད་དེ།",
    "མཐོལ་ཞིང་བཤགས་ན་བདག་བདེ་བ་ལ་རེག་པར་གནས་པར་འགྱུར་གྱི།",
    "མ་མཐོལ་མ་བཤགས་པ་ན་ནི་བདེ་བ་ལ་རེག་པར་གནས་པར་མི་འགྱུར་རོ།",
    "གཅིག་གི་མདུན་དུ་ལྷག་མ་རྣམས་ཞེས་བྱ་བ་སྨོས་སོ།",
    "ཉོན་མོངས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ།",
    "དེ་ལྟར་བསྒྲུབ་པའི་གང་ཟག་མེད་ན་ཉོན་མོངས་པ་ཅན་དང་།",
    "ཕྱིས་ཡང་འདི་ལྟ་བུ་བདག་གིས་མི་བྱའོ་ཞེས་ཕྱིན་ཆད་སྡོམ་པར་ཡང་བྱེད་དོ།",
    "གཉིས་དང་གཅིག་གི་མདུན་ནི་མ་ཡིན་ནོ།",
    "ཟག་པ་ཆུང་ངུ་ནི་གཅིག་གི་མདུན་དུ་ཡང་བཤགས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ཉོན་མོངས་པ་ཅན་དང་།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པ་ཉིད་ནི་རང་རང་གི་སེམས་ལ་བཤགས་པ་དང་ལེགས་པར་བསྡམས་པས་ཀྱང་ལྡང་བར་འགྱུར་ཏེ།",
    "གང་གིས་ཇི་ལྟར་རང་གི་སེམས་ཀྱི་མདུན་དུ་བཤགས་པར་བྱ་བ་དེ་བཞིན་དུ་གང་ཟག་གཅིག་ཉིད་ཀྱི་མདུན་དུ་བཤགས་པར་བྱ་ཞེས་བསྟན་པ་ཡིན་ན་ནི་ལེགས་ན།",
    "གསུམ་ཁོ་ན་ཡིན་གྱི་གཉིས་སམ་གཅིག་གི་མདུན་དུ་ནི་མ་ཡིན་ཏེ།",
    "གཅིག་གི་མདུན་དུ་ཞེས་བྱ་བ་འདི་ལ་ཡང་གི་སྒྲེང་བལྟ་བར་བྱ་སྟེ།",
    "འདིའི་དོན་ནི་གཅིག་གི་མདུན་དུ་ཡང་སྟེ།",
    "གཞན་དུ་ན་གང་ཟག་གི་གྲངས་ཀྱིས་ཀྱང་སོ་སོར་བསྟན་པ་ལས་དོན་ཅི་ཞིག་ཡོད།",
    "དེ་ལས་ལྟག་པའི་གང་ཟག་གི་གྲངས་དགོས་པ་མེད་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་གང་ཟག་གི་གྲངས་ནི་རིགས་པ་ཡིན་ནོ།",
    "གཅིག་གི་མདུན་དུ་ལྷག་མ་རྣམས།",
    "ཉོན་མོངས་མི་མོངས་བདག་སེམས་ལ།",
    "བརྗེད་ངས་པ་ལ་སོགས་པས་བྱུང་བ་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པ་སྟེ།",
    "འདི་ལ་སྙོམ་ལས་དང་ལེ་ལོ་ལ་སོགས་པ་བྱེད་པ་ནི་ཉོན་མོངས་པ་ཅན་དུ་དགོངས་པའོ།",
    "མཆོད་ལས་གཞན་དུ་ཉོན་མོངས་མིན།",
    "ངག་གིས་དེ་རྣམས་ཀྱི་ཡོན་ཏན་རྣམས་ལས་བརྩམས་ཏེ་ཚིག་བཞི་པའི་ཚིགས་སུ་བཅད་པ་གཅིག་ཙམ་འདོན་པ་དང་།",
    "སྙོམ་ལས་དང་ལེ་ལོས་ཉིན་མཚན་འདའ་བར་བྱེད་ན་ཉོན་མོངས་པ་ཅན་གྱི་ཉེས་པར་འགྱུར་རོ།",
    "རང་བཞིན་གྱིས་ཉོན་མོངས་པ་ཅན་ཡིན་པའི་ཕྱིར་འདོད་པའི་སེམས་པ་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་ཉེས་པ་མེད་དོ།",
    "སྤང་བར་འདོད་ཀྱང་ཉོན་མོངས་པ་ཤས་ཆེ་བའི་ཕྱིར་ཟོལ་གྱིས་མནན་ནས་འཇུག་པ་ལ་ཉེས་པ་མེད་དོ།",
    "ཁོང་ཁྲོ་བ་ལ་སོགས་པས་གུས་པར་མི་བྱེད་ཅིང་སྟན་ལས་མི་ལྡང་ལ་སྟན་མི་སྟོབས་ན་ཉོན་མོངས་པ་ཅན་གྱི་ཉེས་པར་འགྱུར་རོ།",
    "ལེ་ལོ་ལ་སོགས་པ་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།",
    "ཡང་དག་པར་དགའ་བར་མི་བྱེད་པ་ནི་ཉོན་མོངས་པ་ཅན་གྱི་ཉེས་པར་འགྱུར་རོ།",
    "ལེ་ལོ་ལ་སོགས་པ་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།",
    "དེ་གཉིད་ཀྱིས་ལོག་པ་ལས་གཞན་དག་གིས་འདི་སད་པར་འགྱུར་བའི་འདུ་ཤེས་ཀྱིས་འདྲི་བ་དང་།",
    "གོས་ལ་སོགས་པ་རྣམས་ལ་ཉེ་བར་བོས་པ་ལས་ང་རྒྱལ་ལ་སོགས་པས་བདག་གིར་མི་བྱེད་པ་ནི་ཉོན་མོངས་པ་ཅན་གྱི་ཉེས་པར་འགྱུར་རོ།",
    "ལེ་ལོ་ལ་སོགས་པ་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།",
    "ལེ་ལོ་ལ་སོགས་པས་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།",
    "ལེ་ལོ་ལ་སོགས་པས་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཉེས་པར་འགྱུར་ཏེ།",
    "སྙོམ་ལས་ལ་སོགས་པ་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པ་སྟེ།",
    "གཞན་མང་པོ་དག་གི་སེམས་བསྲུངས་ན་ཉེས་པ་མེད་དོ།",
    "མ་དད་པ་དང་མ་གུས་པས་མི་སློབ་པ་ནི་ཉོན་མོངས་པ་ཅན་གྱི་ཉེས་པར་འགྱུར་རོ།",
    "ལེ་ལོ་ལ་སོགས་པས་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།",
    "རབ་ཏུ་བྱུང་བར་གྱུར་པས་ནི་རང་གི་བསླབ་པ་རྣམས་ངེས་པར་བསྲུང་དགོས་པའི་ཕྱིར་རོ།",
    "བདག་གི་དོན་ལྷུར་ལེན་པས་ནི་གོམས་པར་བྱ་བ་ཡིན་གྱི།",
    "ལེ་ལོ་ལ་སོགས་པས་ནི་ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའོ།",
