    "དང་པོ་མཛོད་དུ་འཇུག་པ་སོང་ནས་གཉིས་པ་རང་བཞིན་མ་བཅོས་པར་བྱའོ།",
    "དེ་གང་ལྟར་ན་མ་བཅོསམ་བཅོས་པ་དེ་གང་གི་རང་བཞིན་ལགས།",
    "ཇི་ལྟར་རྟོགས་པའི་ཚུལ་གྱིས་དེ་ལ་ལྟ་བའི་རང་བཞིན་དང་རྟོགས་པ་དེ་ལས་མི་འདའ་བའི་དམ་ཚིག་གི་རང་མབརྒྱ་འགྱུར་བཞིན་དང་དེ་ལྟར་ངང་ལས་མི་ཉམས་པར་ལུས་ངག་ཡིད་ཀྱིས་བྱ་བ་བྱེད་པ་སྤྱོད་པའི་རང་བཞིན་ཏེ་རྣམ་པ་བཞིར་གསུངས་པས་གསུམ་པོ་གོ་རིམས་བཞིན་ནོ།",
    "སྟོན་ནི་རང་གི་རང་བཞིན་སྟོན།",
    "ཅེས་བོས་ནསདེ་ལས་མི་འདྲའ་བའི་དམ་ཚིག་གི་རང་བཞིན་གང་ཞེ་ནཉེ་བར་བསྟན་པ་འདི་ལྟ་སྟེ།",
    "ཐིག་ལེ་ཉག་གཅིག་གི་ངང་ལས་འདའ་བ་མེད་པའོ།",
    "རྩ་བ་དང་ཡན་ལག་གི་བསྲུང་བར་བྱ་བའི་ཚད་གཟུང་དུ་ག་ལ་ཡོད་དེ་མེད་པར་གཏད་འཛིན་ཀུན་དང་བྲལ་བ་ནི་ཆབ་གེ་། ཕྱལ་བའི་དམ་ཚིག་ཆེན་པོ་ཞེས་ཀྱང་བྱ་སྟེདེ་ཉིད་ལས།",
    "དེ་ལྟར་གང་སུ་ཡང་རུང་བ་སྒོ་འདིར་བསྲུང་བའི་རྣམ་གྲངས་ཀྱི་མཚམས་དང་བྲལ་ཏེ་འདའ་ཉམས་ཀྱིས་དཀའ་ཐུབ་རེ་བདུན་མེད་པར་རིག་པ་ཀློང་དུ་གྱུར་ན་ནི་ཐིག་ལེ་བདེ་བ་ཆེན་པོའི་ངང་ལ་ཕྱོགས་རིས་མེད་པས་ན་གང་དང་ཡང་མི་འགལ་བ་དེས་ནི་དམ་ཚིག་ཐམས་ཅད་མ་ཉམས་པར་སྲུང་བའང་ཡིན་པས་མེད་པའི་དམ་ཚིག་ཆེན་པོ་ཞེས་ཀྱང་བྱ་སྟེསྔ་མ་ལསཕྱོགས་དང་གྲངས་ཀྱི་བསྲུང་བྱ་དང་།",
    "རྩོལ་བྲལ་ངེས་པའི་སྲོག་གིས་གནས།",
    "དམ་ཚིག་གིས་ཆིངས་ཀྱིས་བཅིངས་པར་བྱའོ།",
    "ཞེས་ཐོས་པ་དམ་པ་ཡོངས་སུ་དག་པར་བགྲོས་ཏེ་དམ་ཚིག་གི་ངོ་བོ་བསྟན་པའོ།",
    "གོས་རྒྱན་གྱི་རྣམ་པ་གང་ཡང་ཚ་གྲང་གིས་གདུང་བས་ལུས་སེམས་མི་ཉེན་པར་བྱེད་པའི་ཕྱིར་གནོད་པ་སྐྱོབ་པ་དེ་དག་གི་རྐྱེན་ཙམ་ལས་གཞན་ལྷག་པར་བཟང་བ་དང་མཛེས་པའི་རྒྱན་གྱི་ཕྱིར་དུ་བཅོས་། པར་མི་བྱ་བ་དང་གནས་གང་དུ་ཡང་ལུས་སྤྱོད་ཇི་ལྟར་བདེ་བ་ལྟར་བག་ཡངས་དང་ལྡན་པར་ལུས་དང་འཚམས་པར་སྦྱར་ཏེ་དོན་དང་ལྡན་པར་བྱ་བའོ།",
    "ཀློང་ཡངས་ཆུབ་པའི་རྣལ་འབྱོར་ལ་གནས་པས་བྱ་བ་གང་གིས་ཀྱང་བསྟངས་སུ་མེད་པའི་ཕྱིརམཆོད་རྟེན་མི་བརྩིག་པ་དང་གླེགས་བམ་མི་ཀློག་པ་ལ་སོགས་པ་དགུ་པོ་མི་བྱའོ།",
    "ལུས་ཀྱི་དྲོད་རྒྱས་ཏེ་མཚག་པར་རེ་བ་དང་ཉམས་བཔའི་ཕྱིར་ཁ་ཟས་ཟ་ཞིང་བཙལ་བ་ག་ལ་ཡིན་ཏེ་མ་ཡིན་པར།",
    "བསམ་གཏན་མཆོག་གི་ལམ་གྱི་བར་དུ་གཅོད་པ་བསལ་ཞིང་སྤང་བའི་དགོས་ཆེད་ཀྱི་ཕྱིར་དུ་ཕྱི་ཡི་གྲོང་ཡུལ་ལམ་འགྲོ་བ་གཞན་གྱི་གནས་དང་ནང་གི་རང་གནས་ཀྱི་ས་མཚམས་སུ་གྱུར་པའི་བར་དུ་རང་ཉིད་ཕྱིར་འགྲོ་བ་དང་གཞན་རྣམས་ནང་དུ་འོང་བའི་རྒྱུ་འགྲུལ་རྣམས་གཅད་པར་བྱ་བའི་རྟགས་ཐོ་ཡང་བརྩིགས་པར་བྱའོ་། བཞི་པ་ནི།",
    "རང་གི་དབྱིངས་ལས་གཡོས་པ་མེད།",
    "སྨིག་རྒྱུ་བཞིན་དུ་ལུས་རེད་ན།",
    "དེ་དག་གི་རྣལ་འབྱོར་མཆོག་གི་ལུས་སྤྱོད་དེ་རྣམ་གྲངས་བསྡོམས་ནས་ཉི་ཤུ་རྩ་བརྒྱད་དུ་འགྱུར་རོ།",
    "ངག་གི་སྤྱོད་པར་བཤད།",
    "འབྱོར་མཆོག་གི་ངང་གི་སྤྱོད་པ་རྣམ་པ་བཅུའོ།",
    "ཆགས་སྡང་གི་སེམས་ཀྱི་ཡིད་བྱེད་མེད་པ་དང་ཉེས་པ་འཆབ་སེམས་མེད་པ་དང་།",
    "ས་ལས་ཕྱིན་ཅི་ལོག་གི་སེམས་མེད་པས་ཁྲེལ་ཡོད་དང་མི་འབྲལ་བ་དང་།",
    "ཞེས་དམ་བཅའ་བ་འདུས་བསྟན་བཅོས་པ་གསུངས་པ་དེ་ཉིདརྟོགས་པ་དང་གོམས་པའི་ཐབས་གང་གིས་ཚུལ་ཇི་ལྟར་ཡོངས་སུ་ཤེས་པར་བགྱི།",
    "དེ་ལྟར་བསྟན་པ་བཞིན་དུ་གནས་སྐབས་ཀྱི་ཤེས་པར་བྱ་པའི་ཡུལ་ཐམས་ཅད་ཀུན་ལ་གྲངས་ཀྱི་རྣམ་པ་རྩ་བ་བཅུ་ཡི་བྱེ་བྲག་གི་ཁྱད་པར་གྱིས་གོང་འོག་གི་མབརྒྱ་འགྱུར་གྱ་མཐོ་དམན་གྱི་རིམ་པ་སྐྱེ་བོ་པ་དང་པོ་སེམས་བསྐྱེད་པ་ཡན་ཆད་ནས་བཟུང་སྟེ་མཐར་འབྲས་བུ་ཡོངས་སུ་རྫོགས་པ་ཐོབ་པའི་བར་དུ་རིམ་པས་དོན་ལ་སྦྱོར་བའི་ཏིང་ངེ་འཛིན་གྱི་ངོ་སྔ་གཉིས་བོ་འོག་ནས་གོང་དུ་འཕར་བས་སྔ་མ་སྔ་མ་རྒྱུ་དང་ཕྱི་མ་ཕྱི་མ་འབྲས་བུའི་ཚུལ་གྱིས་ཡེ་ཤེས་རེ་རེ་སྐྱེས་ཏེ་གཱང་སྒྲིབ་པ་བཅུ་པོ་དེ་དག་རེ་རེ་ནུབ་ཅིང་སྦྱོང་ནུས་པའི་རྩལ་དང་ལྡན་པར་འགྱུར་བའོ།",
    "དགུ་པོ་དེ་དག་རེ་རེ་ཡི།",
    "གང་གི་གཟུགས་བརྙནཞེས་པ་ནསབཅུ་དྲུག་ལྟ་བུར་སྣང་།",
    "དངོས་པོ་མེད་པར་ངོ་བོ་རང་སྣང་དང་མཐུན་པར་སེམས་སྐྱེ་ལུགས་ཀྱི་མཚོན་པར་འགྱུར་པའི་དཔེ་གཉིས་ཐུན་མོང་གི་རྣམ་གྲངས་སུ་བསྟན་པ་ནིདཔེར་ན་སྐར་མ་ཕྲུ་མོ་ལྟ་བུ་དང་།",
    "ཕྲ་མོ་ཙམ་གྱི་སྐར་མ་དང་།",
    "ཞེས་གསུངས་པས་དོན་གྱིས་ཐུན་མོང་མ་ཡིན་པའི་ལམ་འབའ་ཞིག་ཏུ་འགྱུར་ཏེ།",
    "རྟགས་དང་ཐུན་མོང་བ་དང་སྐབས་ཀྱི་སེམས་དེ་དག་འདུས་བསྟན་བཅོས་གསལ་མི་གསལ་གྱི་ཁྱད་པར་ས་གོང་འོག་ལྟར་སེམས་ཀྱི་སྐྱེད་དུ་འཕར་བས་ཕྱེ་བ་དང་།",
    "ཡང་དག་དོན་ལ་རེག་པ་ཉིད།",
    "རེག་པ་ཀུན་དངོས་རེག་དང་བྲལ།",
    "དམ་པ་སྔ་མ་རྣམས་ཀྱིས་ཤེས་རབ་ཀྱི་ཚོགས་དྲུག་གི་ངེས་གསང་དམ་པའམ།",
    "ཟླ་བ་ཚེས་བརྒྱད་པ་ལྟ་བུའི་རང་བཞིན་དུ་གསལ་ཞིང་སྣང་བར་འགྱུར་བའི་མཐོང་བ་དག་པ་འབྱུང་སྟེཐམས་ཅད་མཁྱེན་པའི་རང་བྱུང་གི་ཡེ་ཤེས་ཕྱེད་མངོན་དུ་བྱས་པའི་དཔེ་ཡིན་ནི་ཞེས་གསུངས།",
