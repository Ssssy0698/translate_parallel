    "དེས་དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཚེ་དང་ལྡན་པ་དགེ་སློང་མ་ལྷགས་པ་རྣམས་ལ་ཧཱུཾའདུན་པ་དང་ཡོངས་སུ་དག་པར་བརྗོད་དོ།",
    "འདིར་ལས་ཞེས་སྨོས་པའི་འདུག་ལྷིཔར་གཏོགས་པ་དང་རྗེས་སུ་མཐུན་པའི་ལས་སུ་བྱ་བ་ལ།",
    "བོད་པ་དང་མཐོན་པོར་འདུག་སྟེ།",
    "གལ་ཏེ་དེ་རྣམས་མི་གདའ་ན་བཅལ་བྱེབར་བགྱི་ཞིང་གལ་ཏེ་དེ་རྣམས་མ་རྙེད་ན་བོད་པར་བགྱིའོ།",
    "དེའི་ཕྱིར་ཤེས་པ་ཕྱིར་བཅོས་ཏེ་ཐམས་ཅད་དུ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དགག་དབྱེ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་འདུག་པར་བྱའོ།",
    "གང་ཞིག་དྲུང་ན་འདུག་པའི་དགེ་སློང་དེ་ལ་བྱིན་གྱིས་བརླབ་པར་བྱ་སྟེ།",
    "འདུག་པ་པོ་རྣམས་ཀྱི་དོན་དུ་སྟན་རྣམས་གནང་བ་དེ་མེད་པས།",
    "འབའ་ཞིག་ན་འདུག་སྟེའོ་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་གཅིག་པུ་འདུག་ན་སྟན་དེ་ལ་འདུག་སྟེ།",
    "གལ་ཏེ་གཉིས་པ་ཡོད་པར་གྱུར་ན་དེའི་མདུན་དུ་ཙོག་ཙོག་པོར་འདུག་སྟེ།",
    "འདུག་པ་དང་།",
    "ཕྱི་དྲོ་འདུག་པས་དེ་ལ་སྦྱར་བར་བྱའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ལ་ལར་སྔ་དྲོ་འདུག་པར་བྱ།",
    "ལ་ལར་གུང་ཚིགས་ལ་འདུག་པར་བྱ།",
    "ལ་ལར་ཕྱི་དྲོ་འདུག་པར་བྱ།",
    "དེ་ལས་ལྷག་པར་མཚམས་ཀྱི་ཕྱི་རོལ་དུ་འདུག་པར་མི་བྱའོ།",
    "རྩྭ་དྲུར་བ་བྲིམ་རྔུཔ་དང་མདུན་དུ་འདུག་པ་ཡང་འདིའི་ཡུལ་ཡིན་ནོ།",
    "མདུན་དུ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་གཞན་དུ་གནས་པ་དེ་ལྟར་ཁོ་ནར་རོ།་།",
    "དེར་མདུན་དུ་འདུག་པ་དགོས་པ་མེད་པ་དེ་ལྟ་བས་ན་དེ་ལ་མི་བརྟེན་པའོ།",
    "རྒན་པའི་མཐར་འདུག་སྟེ།",
    "རྒན་པའི་མཐའ་ལོགས་སུ་འདུག་སྟེ་ཞེས་བྱ་བ་རྟོགས་པར་བྱའོ།",
    "དབྱར་གྱི་ནང་དུ་བྱ་བས་འགྲོ་དགོས་ན་དགག་དབྱེ་བྱའོ་ཞེས་བྱ་བ་ནི་ཁས་བླངས་པ་བསལ་བར་གྱུར་པ་དེའི་ངོ་བོ་ཅུང་ཟད་སྐྱེས་པར་གྱུར་ན་གནས་པའི་ཕྱིར་མི་རིགས་པ་དབྱར་རལ་བ་རིགས་པའི་བྱ་བ་དེས་འགྲོ་བར་བྱེད་ཅིང་རང་དགར་འགྲོ་བ་མ་ཡིན་ཏེ།",
    "དེའི་དོན་དང་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱི།",
    "གཞི་ཡང་འཇོག་པར་བྱེད་ཅིང་གང་ཟག་ཀྱང་འཇོག་པར་བྱེད་པའིའོ་ཞེས་བྱ་བ་ནི་འོན་ཀྱང་ཚེ་དང་ལྡན་པ་ཅི་ནས་ཀྱང་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱི།",
    "མནོས་པ་དང་རང་བྱེད་པ་དང་།",
    "བླ་གབ་མེད་པར་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་དེ་དག་གཉིས་ཀ་ལ་ཡང་ཁྱེར་ཏེ་ཞེས་བྱ་བར་སྦྱར་བའི་ཚིག་གོ།",
    "དེར་ཉམས་སུ་མ་མྱོང་བ་དང་ལྡན་པ་ལ་ནི་མ་ཐོས་ཀྱི་བར་དུ་ཕན་ཡོན་རྗེས་སུ་འཇུག་གོ་ཞེས་བྱ་བ་ལ་མ་ཐོས་ཀྱི་བར་དུ་ཞེས་བྱ་བ་ནི་མཚམས་ཀྱི་ནང་ངམ་ཕྱི་རོལ་དུ་འདུག་པས་སོ།",
    "དེའི་ཕྱིར་འདུན་པ་མ་ཕུལ་བ་ལ་ནི་འདུག་ཏུ་ཟིན་ཀྱང་གཉིད་ལོག་གམ་སྟོམས་པར་ཞུགས་ལྟེན་མ་ཐོས་ཀྱི་བར་དུ་བཏིང་བ་དང་ཕྱུང་བ་མི་འབྱུང་ངོ་ཞེས་བྱ་བ་ལ།",
    "འདུག་ཏུ་ཟིན་ཀྱང་ཞེས་བྱ་བ་ནི།",
    "འདུག་ཏུ་ཟིན་ཀྱང་དེ་གཉིས་ཡོད་པ་ཡིན་ཏེ།",
    "གདིང་བ་རྔེད་པ་དང་ཞེས་བྱ་བ་ནི་འདུག་པ་ལས་ཇི་སྲིད་དུ་ཉེ་བར་ལོངས་སྤྱོད་པར་མི་བྱའོ།",
    "དགེ་སློང་རྣམས་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་འདུག་པར་གནང་སྟེ་གནས་མལ་སྦ་བའི་དོན་དུའོ།",
    "བཙུན་པ་སྟན་ཁྲ་བོ་ལ་འདུག་ཏུ་རུང་ངམ།",
    "ཁྲ་ཁྲ་བོ་༨མི་རུང་ངོ་ཞེས་བྱ་བ་ནི་རྔུགདིང་བ་ཁྲ་བོ་བཀྲ་བ་ཁྲ་ཁྲ་བོར་འདུག་པ་དེ་བཀག་པའོ།",
    "གང་ན་བྱིན་གྱིས་བརླབ་པར་བྱ་བ་འདུག་པ་དེའི་མཚམས་སུ་གཏོགས་པ་རྣམས་བྱིན་གྱིས་རློབ་༤པར་བྱེད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་གནས་གང་ན་བྱིན་གྱིས་བརླབ་པར་བྱ་བའི་དངོས་པོ་འདུག་པ་དེའི་མཚམས་སུ་གཏོགས་པའི་བྱིན་གྱིས་རློབ་པར་བྱེད་པ་པོ་རྣམས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལྷས་མ་གྲུ་བཞིར་འདུག་པ་དང་།",
    "དད་པས་སྦྱིན་པར་བྱས་པ་ཆུད་གསན་པར་མི་བྱ་བར་སྒེའདི་ལྟར་སྟན་ནང་ཚངས་ཅན་ལ་འདུག་པར་བྱའོ།",
    "སྟན་གཞན་ལ་ཡང་འདུག་པར་བྱའོ།",
    "དེ་ལ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་དེ་བརྫིས་ནས་འདུག་པའམ་ཉལ་བར་མི་བྱའོ།",
    "ཁྲ་ཁྲ་བོ་ལྡུ་མ་ཡིན་པ་ལས་གཞན་པ་ཁྲ་ཁྲ་བོར་འདུག་པ་དང་།",
    "སྣོད་སྤྱད་སྦེད་པ་ཞེས་བྱ་བ་དང་པོར་བྱས་ཏེ་འདུག་པར་བྱའོ་ཞེས་བྱ་བའི་མཐར་ཐུག་པ་དང་།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་མ་དྲས་་པ་དེས་གྲོང་དང་ཁྱིམ་གཞན་དག་ཏུ་འདུག་པ་དང་འཇུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "མུ་སྟེགས་ཀྱི་འདུག་གནས་སུ་ཡང་དེ་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་རྐྱེན་དེ་ལྟ་བུ་མེད་པར་སྣམ་སྦྱར་མ་དྲས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་འཇུག་པ་དང་འདུག་པར་མི་བྱ་སྟེ།",
    "འཁོད་ན་འདུག་པ་དང་འཇུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་རྐྱེན་དེ་ལྟ་བུ་དག་ཡོད་ཀྱང་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེར་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདིར་གཞུང་ནི་བཙུན་པ་ཀུན་དུ་རྒྱུའི་འདུག་གནས་སུ་སྣམ་སྦྱར་མ་མཆིས་པར་མཆིར་རུང་ངམ།",
    "ལ་བ་སྤུ་ཕྱིར་བསྟན་ཏེ་གྱོན་ལ་འདུག་པར་བྱ་ཞིང་ཉལ་བར་ཡང་བྱའོ།",
    "རྐང་པ་དང་བཅས་པའི་སྟན་ལ་འདུག་པ་ལ་གནས་མལ་རྐྱང་སྙེ་པ་མི་འགྲུབ་པའོ།",
    "ཁྱེམ་གཞན་དུ་གཞན་མེད་ན་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "ལྷན་ཅིག་ཏུ་འདུག་པ་དང་ཉལ་བར་ཡང་བྱ་བ་སྨོས་སོ།",
    "དུས་སུ་རུང་བའི་ནང་ན་འདུག་པའི་འཚོ་བའི་བར་དུ་བཅང་བ་ལ་དུས་སུ་རུང་བ་ཉིད་དང་།",
    "མུ་སྟེགས་ཅན་གྱེ་འདུག་གནས་དང་།",
    "གླེང་གཞི་རྣམས་ལས་དེ་སྤང་བ་༢འདུག་པ་ཞེས་བྱ་བ་དང་པོར་བྱས་ནས་དགེ་སློང་མའི་ཞེས་བྱ་བའི་མཐར་ཐུག་པར་གསུངས་པ་ཡིན་ནོ།",
    "རྩྭ་བམ་༥ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་སྟན་གཞན་མེད་པའོ།",
    "དེ་བཞིན་དུ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་དང་།",
    "སྤྱོད་ལམ་མཛེས་པས་ཟན་གྱི་ཆེད་དུ་འདུག་པར་བྱའོ།",
    "གཞན་གྱིས་༥མགྲོན་དུ་བོས་ནས་འདུག་པ་ལ་དེས་གནང་ན།",
    "གཞན་ཀྱིས་ཐུབྱིན་པ་ན་༧དེའི་ཁོངས་སུ་གཏོགས་པ་དང་འདྲའོ་ཞེས་བྱ་བ་ནི་གང་ཞིག་གཞན་གྱིས་ཆོམགྲོན་དུ་བོས་ན་ནི་འདུག་པ་ལ་སྦྱིན་བདག་དེས་གནང་ན་སྦྱིན་བདག་གཞན་གྱིས་སྦྱིན་པའོ།",
    "འདིར་ཉེ་དུ་རྣམས་ལ་ལག་པ་བསྙལ་དུ་བཅུག་པ་འདིར་གཞུང་ནི་ཕྱོགས་དབེེན་ཆོཔར་འདུག་སྟེ།",
    "ཟས་ཀྱི་རཱིཕྱིར་འདུག་པས་འདིའམ་འདི་ནས་བྱིན་ཅེས་འདྲི་མ་མཁན་ལ་བསྒོ་བར་མི་བྱའོ།་།",
    "དཀྱིལ་དུ་འདུག་པར་བྱའོ།",
    "དེ་དང་འབྱེལ་བའི་དོན་ལས་གཞན་པས་དེའི་དྲུང་དུ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "ལྟོ་འཛག་པས་ནི་མདུན་དག་ཏུ་ཕྱི་བ་ཙམ་བྱས་ཏེ་འདུག་པ་ལ་ཉེས་པ་མེད་དོ་ཞེས་བྱ་བ་ལ།",
    "དེ་ལས་གཞན་པས་ནི་ཆུ་ཡོད་ན་འཐོར་འཐུང་མ་བྱས་པར་ཡང་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "རང་བཞིན་དུ་གནས་ཏེ་སེམས་པ་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བ་འདི་ལ་གཞན་ཕམ་པ་ཐུབྱེད་པ་རྣམས་བསྟན་པའི་ཕྱིར་འཁྲུལ་པ་དང་བཅས་པ་ཞེས་བྱའོ།",
    "བདེ་འགྲོར་འགྲོ་བ་དང་རང་བཞིན་དུ་གནས་པའི་རྗེས་སུ་མཐུན་པ་ཉིད་ལས་སོ།",
    "གང་དུ་བྱེ་བྲག་གང་དང་ལྷན་ཅིག་པའི་འདུག་པ་ལ་རྗེས་སུ་མ་ཞུགས་པ་ཉིད་ཅེས་བྱ་བ་དེ་དང་པོར་བསྟན་པའི་ཕྱིར།",
    "དེ་བརྩམས་པ་འགྲོ་བའི་སེམས་ཀྱིས་བཏང་བ་ནི་སྤྱོད་ལམ་ལས་ཉམས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འདུག་པ་ཞེས་བྱ་བའི་སྤྱོད་ལམ་དེ་བརྩམས་ཤིང་སྔར་འདུག་པར་གྱུར་པ་ཧྥུགཞན་དུ་འགྲོ་བའི་སེམས་ཀྱིས་བཏང་བ་ནི་སྤྱོད་ལམ་ལས་ཉམས་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེས་ན་གང་ཟག་ལ་ལྷུང་བཟེད་ལ་སོགས་པ་བྱིན་གྱིས་བརླབ་པའི་ཚིག་དེ་ཡང་རང་བཞིན་དང་བྲལ་བ་ཉིད་ལ་ཉམས་པར་འགྱུར་རོ།",
    "ལྷག་པོར་ཡང་མདུན་དུ་ཙོག་པུར་འདུག་སྟེའོ་ཞེས་བྱ་བ་ནི་གང་ཟག་འདི་གང་ཟག་ལ་ཡང་ངོ་ཞེས་བྱ་བ་སྨོས་པས་སོ།",
    "བསྙེན་པར་རྫོགས་པར་བྱ་བའི་གང་ཟག་དེ་ཛྭཕ་གུའི་སྟེང་དུ་རྟིང་པ་ཉིད་དཱཀྱིས་འདུག་ཏུ་གཞུག་གོ།",
    "རྒན་པའི་མཐའ་ལོགས་སུ་ཙོག་པུར་འདུག་སྟེ་བརྗོད་པར་བྱའོ།་།",
    "འགྲེངས་ཏེ་འདུག་པ་འརྣམས་ཀྱིས་དུས་སུའོ།",
    "གསོ་སྤྱོང་དང་དགག་དབྱེ་དག་བྱིན་གྱིས་བརླབ་པའི་ཕྱིར་ཙོག་པུར་འདུག་སྟེ་བྱ་བར་གསུངས་པས་དེ་གཉིས་ཀ་ཤེ་ཡང་འདུག་སྟེ་བྱའོ།",
    "གང་དུ་མི་འདུག་པ་རྣམས་ཀྱིས་གནས་པར་རིགས་པ་ཡིན་ཏེ་འདུག་པ་རྣམས་ཀྱིས་ནི་མ་ཡིན་ནོ།་",
    "སྙེའདུག་རྟེཔའམ་མི་གནས་པ་རྣམས་ཀྱིས་དེར་ཡང་ནུས་པ་ཀྱེདེ་ལྟ་བུར་གྱུར་པ་ཉིད་ལ་བྱ་བ་བྱེད་པ་འགྲོ་བ་བཞིན་དུ་དོར་བར་ཀྲུམི་རིགས་པ་དེ་བས་ན།",
    "དེ་ལྟ་བུའི་ངོ་བོའི་རྐྱེན་རྣམས་ལ་གང་ལ་འགྲོ་བ་ཉིད་ལ་བྱ་བ་ཉིད་འདུག་པ་ལ་ཡང་དེའི་རྫས་བྱིན་གྱིས་བརླབ་པ་དང་།",
    "བཏང་བ་དག་ནི་འདུག་པ་ལ་ཡང་རིག་པར་བྱའོ།",
    "ལས་ནི་འདུག་པ་ཉིད་ཀྱིས་སོ་ཞེས་བྱ་བ་ནི་གསོལ་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་འདུག་པ་ཉིད་ཀྱིས་བྱའི་སྐྱེསྤྱོད་ལམ་གཞན་གྱིས་ཙོ་ནི་མི་བྱའོ།",
    "འདུག་པའི་གནས་ཐམས་ཅད་ལ་རྒན་རིམས་སུ་བསྐོ་བ་རིགས་པ་ཉིད་ཡིན་ནོ།",
    "འདུན་པ་ལ་སོགས་པ་ལེན་པ་དེས་ནམ་མཁའ་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་བསླབ་པའི་གཞི་བཅའ་བར་་མཛད་དེཤེ།",
    "མཚམས་གཞན་སྨོས་པ་ཉིད་ཀྱི་ཕྱིར་ནམ་མཁའ་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་ཅིའི་ཕྱིར་སྨོས།",
    "དེའི་ཕྱིར་རང་བཞིན་དུ་གནས་པ་མཚམས་ཀྱི་ནང་ན་འདུག་པ་ལའོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "རང་བཞིན་དུ་གནས་པ་མཚམས་ཀྱི་ནང་ན་འདུག་པ་ལའོ་ཞེས་གསུངས་པ་དེ་འདིར་ལུང་ཡིན་ནོ།",
    "ཁྱིམ་པ་ཡང་དག་པར་སྡོམ་པ་ཡང་རང་བཞིན་དུ་གནས་པ་ཉིད་ཡིན་ནམ་ཞེ་ན།",
    "གནས་སྐབས་ཇི་ལྟར་འདུག་པ་ལ་བྱ་ཞེ་ན།",
    "འདིར་གཞུང་ནི་མི་གནས་པར་འདུག་པར་མི་བྱའོ་ཞེས་གསུངས་པ་དེའི་དོན་ཅི་ལགས།",
    "ཡིད་དུ་འཐད་པའི་སེམས་ཉེ་བར་གནས་པ་ཡོད་པ་དེ་ལ་གནས་དེར་འདུག་པར་བྱའོ་ཞེས་གསུངས་པའི་གཞུང་གནང་༦བ་ཡིན་ནོ།",
    "སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "བརྗོད་པའི་ཡན་ལག་མེད་ན་དེའི་སེམས་མ་ཡིན་པ་ཉིད་འཆབ་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་བརྗོད་པའི་རང་བཞིན་དུ་གྱུར་པ་དང་རང་བཞིན་དུ་གནས་པ་དང་།",
    "སྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་ལ་སྙེ་འདུག་པར་ཡང་ངོ་ཞེས་བྱ་བ་ནི་ལྷན་ཅིག།",
    "སྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་དུ་མི་འདུག་པ་དང་།",
    "དེ་གཉིས་འདུག་པ་ནི་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་སྟན་ཆེས་དམའ་བ་ལ་འདུག་པར་བྱའི་མཉམ་པའམ་ཀྲུཤིན་ཏུ་མཐོ་བ་ལ་འདུག་པར་མི་བྱའོ།",
    "དེ་གཡོགས་མ་གཅིག་ཏུ་མལ་མི་བཤམ་ཧཱུཾཔ་དང་ཡོངས་སུ་གནས་པ་དག་མགུ་བར་བྱ་བ་སྤྱོད་པ་དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "འདུག་པ་ལ་ཐ་མར་འོས་པའི་ཆོ་ག་འདི་ཡིན་ཏེ།",
    "གསོ་སྤྱོང་དང་དགག་དབྱེ་གཞག་པར་ཞེས་བྱ་བ་ནི་གང་ཟག་འདི་འདུག་པ་དང་ལྷན་ཅིག་དགེ་སློང་རྣམས་ཀྱིས་གསོ་སྤྱོང་དང་དགག་དབྱེ་མི་བྱའོ་ཞེས་བྱ་བ་ཡིན་པར་རིག་པར་བྱའོ།་།",
    "ཕྱོགས་ཅིག་ཤོས་སུ་ཡང་རང་འགྲོ་བར་མི་བྱའོ།་།",
    "ཕྱོགས་གཉིས་པར་ཡང་རང་འགྲོ་བར་མི་བྱ་ལ་མངག་པ་གཏང་ཁྲུབར་མི་བྱ་བར་ལུས་ཀྱིས་ཀྱང་བསྡམ་པར་བྱ།",
    "ལྷན་ཅིག་འགྲོ་བ་དང་འདུག་པ་དང་ལྷན་ཅིག་འཆག་ཐུསར་འཆག་ཞྭཔ་དང་གཏམ་འདྲེ་བ་དང་ཕེབས་པར་སྨྲ་བ་ཡང་ངོ་ཞེས་བྱ་བ་ཡང་།",
    "སྤྱོད་ལམ་ཞེས་སྨོས་པ་ནི་འགྲོ་བ་དང་འགྲེང་བ་དང་འདུག་པ་དང་ཉལ་བས་བྱས་པས་གླེང་བ་བསྡུས་སོ།",
    "དགེ་སློང་ཤི་རི་ཀ་ཉིད་ཀྱིས་རྒན་པའི་མཐར་འདུག་སྟེ།",
    "ཁྱེམ་གཞན་ན་འདུག་པ་ཞེས་བྱ་བའི་སྒྲ་ལས་ཁྱེམ་གྱེ་ནང་ན་ཧཱུཾ་༧འདུག་པ་ཞེས་བྱ་བ་དང་སྦྱར་ཏེ་ཁྱིམ་པའི་ཁྱིམ་ན་འདུག་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྱིམ་གཞན་ན་འདུག་པ་ལ་ཡང་མ་གཏོགས་པར་མི་རིགས་ཏེ།",
    "ཁྱིམ་གཞན་ན་འདུག་པའོ།",
    "གང་དུ་འདུག་པའི་སྤྱོད་ལམ་བསྟེན་པར་བྱ་ཞེ་ན།",
    "རྗེས་སུ་གནང་བ་ལ་མི་ལྟོས་པ་ཉིད་ཀྱིས་རང་འདུག་པར་བྱའོ།",
    "གསར་བུས་རྗེས་སུ་གནང་བ་ལ་ལྟོས་ཏེ་འདུག་པར་བྱ་བ་བསྟན་པའི་ཕྱིར་གསར་བུས་ནི་བསྒོ་༡་ནའོ་ཞེས་བྱ་བ་སྨོས་ཏེ་ལུང་འབོགས།",
    "འདུག་པ་༡རིབསྟེན་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "མནོད་པར་བྱ་བ་མང་བ་ཉིད་ཡིན་ན་ཞུ་བར་བྱའོ་ཞེས་བྱ་བ་ནི་ལུང་མནོད་པར་བྱ་བའི་གཞུང་མང་བ་ཉིད་ཡིན་ན་འདུག་པའི་ཕྱིར་ལུང་འབོགས་པར་བྱེད་པ་ལ་ཞུ་བར་བྱའོ།",
    "མང་དུ་ནོད་ན་སློབ་དཔོན་ལ་ཞུས་ཏེ་སྟན་ཆེས་དམའ་བ་ལ་འདུག་ནས་ལུང་མནོད་ཛུཔར་བྱའོ།",
    "ཇི་སྟེ་ཉུང་དུ་ནོད་ན་ནི་ཙོག་པུས་འདུག་སྟེའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཐོས་པའི་ཉེན་ཀོར་ཆོམ་གཏོགས་པ་སྣང་བའི་ཉེན་ཀོར་དུ་འདུག་སྟེ་ཁ་ཏོན་བྱའོ་ཞེས་བྱ་བ་ནི་མཐོང་བའི་ཉེན་ཀོར་དུ་གནས་ནས་སོ།",
    "ཁྲིའུ་ལ་གཅིག་མ་ཡིན་པས་མི་བྱའོ་ཞེས་བྱ་བ་ནི་གཅིག་ཁོ་ན་དེ་ལ་འདུག་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལོ་གསུམ་ལས་ལྷག་པས་བར་དུ་ཆོད་པ་དང་ལྷན་ཅིག་སྟན་ལ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་ལོ་གསུམ་ལས་ལྷག་པའི་དུས་བསྙེན་པར་རྫོགས་པའི་བར་དུ་གྱུར་པས་བསྙེན་པར་སྡོགས་པའི་དུས་གཞན་གྱིས་ཏུ་བར་དུ་ཆོད་པ་ཉིད་དེ་དང་ལྷན་ཅིག་སྟན་ཐམས་ཅད་ལ་འཛེག་པ་ཉིད་བསྟེན་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "གང་ཡང་རུང་བར་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "བསྙེན་པར་མ་རྫོགས་པ་དང་ཡང་མི་བྱའོ་ཞེས་བྱ་བ་ནི་བསྙེན་པར་མ་རྫོགས་པ་དང་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "དེ་དག་གང་དང་གང་དུ་ཡང་རུང་སྟན་གཅིག་ལ་འདུག་པ་བསྟེན་པར་མི་བྱའོ།",
    "བབེེབ་པ་བྱིན་པ་དང་མི་བྱའོ་ཞེས་བྱ་བ་ནི་གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པ་བསྟེན་པར་མི་བྱའོ།",
    "དེ་ལ་རྒན་རིམས་སུ་མི་བྱའོ་ཞེས་བྱ་བ་ནི་འདུག་པ་དེ་ལ་རྒན་རིམས་སུ་མི་བྱའོ།",
    "འདུག་པ་ལ་ཉེ་བར་མཁོ་བའི་སྟན་ལ་སོགས་པ་རྣམས་ལ་༥ཇི་ལྟར་འོངས་པ་ཉིད་ཀྱིས་ལོངས་སྤྱད་པ་སྟེ།",
    "ཆད་ན་ཁྱེམ་དག་ཏུ་གཞག་གོ་ཞེས་བྱ་བ་ནི་ཆར་པ་ཆད་ན་དེའི་དྲུང་དུ་འདུག་པའི་སྣཁྱེམ་གང་ཡིན་པ་དེར་འདུགས་ཏེ་བཏགས་ཏེ་གཞག་གོ།",
    "དེས་དེའི་ཕྱིར་སྒོར་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "སྣང་གཡེལ་ཅན་དུ་མི་བྱའོ་ཞེས་བྱ་བ་ནི་འདུག་པར་ཏེ།",
    "གོས་མེད་པ་ཅན་གྱེས་མི་བྱའོ་ཞེས་བྱ་བ་ནི་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དཔུང་པ་གཉིས་མ་གཡོགས་པར་ཁྱེམ་པའི་དྲུང་དུ་མི་བྱའོ་ཞེས་བྱ་བ་ནི་རྔུལ་གཟན་གྱི་གོས་ཉིད་གོན་དུ་ཟིན་ཀྱང་དཔུང་པ་གཉིས་མ་གཡོགས་པར་ཁྱིམ་པའི་དྲུང་དུ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བས་འདི་གའི་ཉེ་འཁོར་ཞིག་ཏུ་སྒྲུབ་ཁང་ཆུང་ངུ་ཉལ་འདུག་རུང་ཙམ་ཞིག་རྩིགས་ཞེས་གསུངས།",
    "གཞན་དགའ་ཉེ་སུ་དང་འཕྲད་ཀྱང་གདོན་མཐོང་བ་ལྟར་བྱེད་ཀྱི་འདུག་པས་གནས་སྐབས་འཛུལ་ས་རྙེད་ཁག་ཙམ་བྱུང་།",
    "ཁང་ཚན་ནས་ཀྱང་བདག་པོ་བསྐྱོན་འདུག་ན།",
    "ནང་སྤང་རྒྱུའི་ཐད་ལ་ནི་སྔོན་གྱི་སྐྱེས་ཆེན་ལས་ཀྱང་ཕྲན་དཀའ་ལས་ཆེ་བར་འདུག་སྙམ་པ་ཡང་འཆར།",
    "དེ་མཐོང་བ་ན་གཞི་ནས་ང་རང་ཡང་སེམས་སྐྱོ་ནས་མཆི་མ་མང་པོ་ཤོར་བྱུང་།",
    "དེར་གནས་མཇལ་ཞུས་ཏེ་རི་བོ་མཐོན་པོ་དེ་བརྒལ་ནས་ཐུར་གཟར་པོ་ཤིན་ཏུ་རིང་བ་ཞིག་འདུག་པ་ལ་བབས་ཕྱིན་པས་བརྡ་ཆུ་ཁར་བསླེབས།",
    "ད་དོ་དགོང་རང་གཅིག་པུ་ཆུ་འགྲམ་འདིར་ལུས་པར་འདུག་བསམས་ནས་ཇ་གཅིག་བསྐོལ།",
    "ཁ་བ་དཀར་པོ་ཞེས་པའི་མཚན་འདོགས་ས་གཙོ་བོ་དེ་ཡིན་འདུག་ཅིང་།",
    "ཡང་མི་སྡིག་ཆེན་འགའ་ཞིག་དེར་བསླེབ་ན་ཆུ་རྒྱུག་འཕྲོ་ལ་གྱེན་དུ་ལྡོག་སྟེ་ཆད་འགྲོ་བ་སོགས་མཐོང་ཚུལ་སྣ་ཚོགས་ཤིག་འོང་སྐད་འདུག་ཀྱང་།",
    "དེའི་གཡས་གཡོན་དུ་ད་དུང་སྒྲུབ་ཕུག་དང་སྒྲུབ་ཆུ་རང་བྱོན་སོགས་ངོ་མཚར་བ་མང་པོ་ཞིག་མཇལ་རྒྱུ་ཡོད་འདུག་ཀྱང་ཆ་རྒྱུས་མེད་པར་བརྟེན་མཇལ་ཐུབ་མི་འདུགདེ་ནས་སླར་འཁོར་ཏེ་འགྲོ་རྩིས་བྱས་པ་ན་གནས་ཚང་དེའི་མི་ཐམས་ཅད་ངུས་ཏེམ་མཐར་ཟླ་བ་གཅིག་སྡོད་རོགས་ཟེར་ཡང་མ་ཉན་པར་ཐོན་ཕྱིན།",
    "དེ་ལ་འཛེགས་ཕྱིན་པས་རི་དེ་ཧ་ཅང་མཐོ་བའི་སྟབས་ཀྱིས་ཉིན་གཅིག་ལ་བརྒལ་མི་ཐུབ་པར་རི་སྐེད་ཙམ་དུ་ང་རང་གཅིག་པུར་ཞག་གཅིག་ལུས།",
    "དེ་ནས་ཕར་ཙམ་སྡོད་ཟེར་ཡང་མ་ཉན་པར་ཐོན་ཕྱིན་ཏེ་བདུན་ཞག་གཅིག་ཙམ་ནས་ཚ་བ་སྤོམ་མདའ་ཟེར་བར་བསླེབས།",
    "འོ་དེ་ལེགས་འདུག་གསུངས།",
    "སུ་བྱེད་པ་བྱུང་ཡང་ད་བསམས་ན་རིགས་ལམ་སྣ་གཅིག་ཀྱང་དཔྱིས་ཕྱིན་པ་ནི་ཤེས་མི་འདུགདེ་དུས་གདན་ས་སོ་སོ་ནས་ཕེབས་པའི་གྲྭ་ཚོགས་ཆེ་ཞིང་རྩོད་པ་སྨར་བ་དང་།",
    "འགོར་བར་བློ་ལ་འཇགས་འདུག་པ་ལ་བལྟས་ན།",
    "པས་ཀྱང་འཚུབ་པོ་འདུག་ཅེས་ཕེབས་བྱུང་བས་དངངས་སྐྲག་སྐྱེས་ཏེ་འཕྲལ་མར་སྒྲོལ་དཀར་ཚེ་སྒྲུབ་ཅིག་བྱས་པས་བར་ཆད་བཟློག་པའི་གདེངས་རྙེད།",
    "ང་རང་ལ་ལྷམ་དང་ཕྱུ་པ་མེད་ཀྱང་ངས་དགོན་གསར་བླ་བྲང་དུ་ཕྱིན་ཏེ་ཁྲུ་ཙེའི་རྒྱབ་ལྡན་ཕྱུ་པ་ཞིག་དང་།",
    "མགྱོགས་ཙམ་འགྲོ་བྱས་ཀྱང་མ་ཉན་པར་ལམ་དུ་ཅི་འགོར་བྱེད་ཀྱི་འདུག་མི་དེ་ནི་ཡུལ་གྱི་རྐུན་པོ་གཡོ་ཁྲམ་ཅན་ཞིག་ཡིན་འདུག་པས།",
    "དེ་དུས་ཁོ་བོའི་ལུས་ལ་གཟན་ཤམ་ཅུང་ལེགས་ཙམ་ཞིག་གྱོན་ཡོད་པས་ང་གུད་ཟུར་ནས་ཁྲིད་ནས་བསད་ལ་གཟན་ཤམ་འཕྲོགས་བསམས་འདུག་ཁོའི་ཁ་ནས་ཀྱང་ཉི་མའི་གུང་ལ་ནང་དུ་ཕྱིན་ན་སྦྱིན་བདག་ནས་ཨཱ་བཀའ་བཀྱོན་གསུང་ཡོང་།",
    "སྐབས་ཤིག་ན་ཇ་དང་ཚྭ་འདི་ཡང་ཉེས་དམིགས་ཆེ་བར་འདུག་སྙམ་ནས་ད་ཕྱིན་ཆད་ཆུ་འཁོལ་ལས་མི་འཐུང་ཞེས་དམ་བཅའ་ཤུགས་དྲག་བྱས།",
    "གཙོ་བོ་ནི་བཙོན་པ་རྣམས་ཀྱིས་ལས་ཀ་བྱེད་ལུགས་ལྟ་ཞིབ་བྱེད་པའི་ཆེད་དུ་ཡིན་འདུག་ཀྱང་།",
    "ང་རང་གཅིག་པུ་མ་གཏོགས་བཙོན་པ་གཞན་རྣམས་ནི་གཅིག་ལས་གཅིག་ཞེད་དུ་འཇོན་པ་འདུག་པས་ཟེར་མ་རྙེད།",
    "མགྱོགས་པོ་གྱིས་ཞེས་ཟེར་བར་འདུགཀྱང་།",
    "ང་རང་ནི་ནུས་ཤུགས་ཡོངས་སུ་རྫོགས་ནས་དབུགས་ཆད་ལ་ཁད་པ་བྱུང་།",
    "གཉིས་བཞག་འདུག་པས་དེར་བཙོན་པ་རྣམས་ཀྱིས་ཆབ་དོར་བ་མགོའི་ཐོག་ཏུ་ལྷུང་ལ་ཉེ་བ་དང་།",
    "ཕྱི་ཉིན་ནམ་ལངས་ནས་ལྟ་དུས་ངོ་ཤེས་པ་ཆེར་མི་འདུག་ཀྱང་།",
    "དོན་དུ་བཙོན་པ་ཕལ་ཆེ་བ་སྐུ་དྲག་སོགས་ཡ་རབས་སྤྱོད་བཟང་ཅན་ཤ་སྟག་ཏུ་འདུག་པས་ཡིད་དགའ་བར་བྱུང་།",
    "ཇི་ལྟར་འཁྱག་ཀྱང་གུ་ཐུང་སྟོད་ཐུང་སོགས་ཁྱིམ་པའི་གོས་མི་བགོ་བར་དཀའ་ཐུབ་དང་དུ་ལེན་པ་ནི་བསྟན་པ་ལ་བྱ་བ་ཅུང་ཟད་བྱས་འདུག་སྙམ།",
    "ལྟར་བྱེད་ཀྱིན་འདུག་ཀྱང་།",
    "ཕྲན་ལ་ནི་བཙོན་དུ་འདུག་རིང་གོས་བསྐྱལ་མཁན་ལྟ་ཞོག་རྩད་གཅོད་མཁན་ཙམ་ཡང་མ་བྱུང་ངོ།",
    "ལུས་ལ་གྱོན་རྒྱུ་སྐྱོ་བ་སོགས་ཕྱིའི་རྣམ་འགྱུར་རྦད་དེ་ཉམས་འདུག་ཀྱང་།",
    "གཉིས་སུ་དྲན་ཤེས་མི་བརྟན་པའི་སྟོབས་ཀྱིས་ད་ལྟ་ཚིག་རིས་ཕལ་ཆེར་བརྗེད་ནས་ཡིད་ཡུལ་དུ་མི་གདའོ།",
    "ཞག་བཅུ་སྐོར་ཞིག་ནས་སྐལ་བ་བཟང་པོ་དེ་འཇའ་ལྟར་ཡལ་འདུག་པའི་ཕྱིར་རོ།",
    "གཉིས་སུ་དམར་སྲུང་དམག་ལོ་ཆུང་རྣམས་ཀྱིས་དབྱེ་སེལ་མེད་པར་ཚང་མ་གང་བྱུང་དུ་གཏོར་ཏེ་ཕྲ་རྒྱན་རིན་ཐང་ཅན་རྣམས་ཀྱང་གཏོར་བཤིག་ཏུ་འགྲོ་བའི་ཉེན་ཁ་འདུག་གལ་ཏེ་སོ་སོས་ལག་པ་འཆང་ན་དགོས་པའི་གསེར་དངུལ་དང་ཕྲ་རྒྱན་སོགས་ཚུར་ཉར་ལ།",
    "གཡབ་པ་དོན་གྲུབ་ཚེ་རིང་ལགས་ནས་ལྷ་སོ་སོའི་གཟུངས་གཞུག་ནས་བྱུང་བའི་དམ་རྫས་ཀྱི་རིགས་དཔག་ཏུ་མེད་པ་ཞིག་བསྡུ་རྒྱུ་བྱུང་འདུག་པ་རྣམས་ཅུང་ཙད་ཀྱང་འཐོར་དུ་མི་འཇུག་པར་བདག་ལ་སྟེར་བྱུང་བ་དང་།",
    "མི་དཀར་པོ་ལ་ཞྭ་ནག་པོ་གཡོགས་རྩིས་བྱེད་མཁན་གྱི་མི་དེ་ནི་དེང་སང་ཡང་འདི་ན་གསོན་པོར་གནས་འདུག་ཅིང་།",
    "གནོད་ལན་འཇལ་ན་སྐབས་རྙེད་རིགས་སུ་འདུག་ཀྱང་གནོད་ལན་བྱེད་རྒྱུ་ལྟ་ཞོག་བྱེད་བསམ་པ་ཙམ་ཡང་མི་གདའོ།",
    "སྐུ་སྒེར་དྲུང་ཆེ་སོགས་ཐུགས་སུན་བྱུང་ཡོད་བཟོ་འདུག་པ་དང་།",
    "བར་སྐབས་ཤིག་བདུན་གསུམ་གྱི་རིང་རྡེའུ་བཅུད་ལེན་ཞིག་བཏང་ལོ་བྱས་ཀྱང་དགེ་སྦྱོར་ལ་དེ་ཙམ་གྱི་ཕན་ཐོགས་མ་བྱུང་བས་འདི་ལས་འཚོ་བ་ངན་ངོན་ཙམ་བསྟེན་ན་དགེ་སྦྱོར་ལ་བོགས་ཆེ་བར་འདུག་སྙམ་བྱུང་།",
    "བསམ་དོན་ལག་ལེན་དུ་མ་ཁེལ་བ་ནི་བློ་འགྱོད་ཀྱི་གནས་སུ་གདའོ།",
    "སྦྱོར་བ་ལག་ལེན་ལའང་དངོས་སུ་བཀལ་ཏེ་ལྟོ་སྐྱ་གོས་ཧྲུལ་གྱི་བརྟུལ་ཞུགས་ཡུན་རིང་པོའི་བར་དུ་བཟུང་བ་ནི་རྒྱལ་བ་སྲས་བཅས་དགྱེས་པའི་མཆོད་སྤྲིན་དུ་གྱུར་འདུག་སྙམ་སྤོབས་པ་ཡང་ཅུང་ཟད་སྐྱེས།",
    "བསམ་པར་སུ་དང་ཐུགས་ཕྲད་མེད་པར་ངག་བསྡམས་ནས་སྡོད་རྒྱུ་བྱུང་ན་དགེ་སྦྱོར་གང་ལེགས་དང་ས་ལམ་གྱི་རྟོགས་པའང་གཟུགས་བརྙན་ཙམ་ཡོང་རིགས་སུ་འདུག་ཀྱང་།",
    "འདུ་འཛི་ཟེར་བ་དགེ་སྦྱོར་གྱི་སད་སྐྱེན་ཆེ་ཤོས་སུ་འདུག་དེར་བརྟེན་འདུ་འཛིས་གཡེང་བ་བཙན་ཆོད་དུ་དོར་ནས་བསེ་རུ་ལྟར་སྡོད་རྒྱུ་བྱུང་ན་དགའ་བ་ལ་སྙམ་པ་ཡང་ཡང་འཆར།",
    "ཚེས་བཅུ་བདུན་ནས་ངག་བསྡམས་ཏེ་མཚམས་ལ་བསྡད་ཀྱང་ན་ཚ་ནི་ད་དུང་སངས་དྲག་ཕྱིན་མི་འདུག་པས་དགོང་དྲོ་གཉིད་མ་ཁུག་པའི་དཀའ་ངལ་ཅི་ཡང་བྱུང་བ་ལ་ས་སྔགས་ལས་ཕན་ཆེ་བ་མ་བྱུང་།",
    "ཉིན་སྔ་མར་རིན་སྤུངས་པ་དགེ་ཚུལ་སྒྲུབ་མི་ཞིག་ནས་ཧྲཱི་ཡིག་རང་བྱོན་ངོ་མཚར་བ་དེ་ཕུལ་འདུག་བོད་ཟླ་བཅུ་པའི་ཚེས་གཅིག་ནས་རྣམ་འགྲེལ་ཐར་ལམ་གསལ་བྱེད་འགོ་ནས་ཁྲིད།་",
    "ང་ཡིས་མ་བྱེད་ཐབས་འདུག་གམ།",
    "ཧ་ཅང་རང་སེམས་སྐྱོ་དྲགས་ནས།",
    "པས་སྔོན་འཆར་ལྟར་ན་གནམ་ཐང་དུ་སེར་སྦྲེང་ལ་བཅར་རྒྱུ་ཡིན་འདུག་ཀྱང་།",
    "དེ་ནས་དགོན་ནང་དུ་སེར་སྦྲེང་སོགས་གྲ་སྒྲིག་ཞུས་འདུག་རུང་དགྱེས་ཚུལ་ཅི་ཡང་མི་གནང་བ་ནི།",
    "དེའི་འོག་ཏུ་ལོ་མི་གནས་པས་རྒྱུན་ཐམས་ཅད་ཀྱང་རང་གྲུབ་པའི་དུས་ལས་དུས་གཉིས་པར་མི་སྡོད་པའི་སྐད་ཅིག་མ་ཡིན་ནོ་ཞེས་སོ།",
    "སྤྱིར་སྐྱེ་འཇིག་དུས་གཅིག་པ་དང་དེའི་ནང་ནས་ཀྱང་ཡུལ་དུས་རང་བཞིན་དབྱེར་མི་བྱེད་པའི་ཚུལ་འདི་ཤིན་ཏུ་རྟོགས་དཀའ་བར་མངོན་ནོ།",
    "རི་བོ་ལ་སོགས་པའི་དངོས་པོ་འགའ་ཞིག་དུས་ནམ་ཡང་མི་འགྱུར་བར་ཧྲང་ངེར་སྡོད་པ་མངོན་སུམ་དུ་མཐོང་བཞིན་པ་འདི་ལྟར་རོ་སྙམ་ན།",
    "བསྟན་དར་ལྷ་རམས་པས་སྔར་ལྟར་གསུངས་པ་སོགས་ཀྱང་དོགས་པ་འདི་མ་ཆོད་པའི་རྣམ་འགྱུར་དུ་འདུག་པའི་ཕྱིར་རོ།",
    "ད་དུང་ཡང་སྔར་ལས་ལྷག་ཙམ་ཞིག་མྱོང་མི་དགོས་པའི་ངེས་པ་ཅི་ཡང་མེད་པའི་སྐྱོན་ཆེན་པོ་འདི་ནི་མཐར་གཏུགས་ན་མི་རྟག་པ་མི་ཤེས་པའི་སྐྱོན་དུ་འདུག་པས།",
    "ཐ་ན་སྐད་ཅིག་སྔ་མའི་བདེ་བས་ཀྱང་ཕྱི་མར་ཕན་མི་ཐོགས་ན་གཞན་དང་གཞན་གྱིས་ལྟ་ཅི་སྨོས་པས་དེས་ན་སྐད་ཅིག་ཀྱང་མི་རྟག་ཅིང་མི་བརྟན་པའི་ཟག་བཅས་སྲིད་པའི་བདེ་བ་ལ་ཆགས་ཤིང་ཞེན་པ་ནི་བླུན་པ་བས་ཀྱང་ཆེས་བླུན་པར་འདུག་སྙམ་དུ་ནན་ཏན་གྱིས་བསྒོམ་དགོས་སོ།",
    "ཞེས་ཐག་བཅད་དེ་གསུངས་འདུག་པའི་ཕྱིར་རོ།",
    "ཕུང་པོ་ལས་བདེན་པའི་ཐ་དད་དུ་ཡང་གྲུབ་ས་མི་འདུག་སྙམ་དུ་ངེས་པར་བྱའོ།",
    "ཡོད་དགོས་པ་ལས་གང་དུ་ཡང་མི་འདུག་སྙམ་པ་བྱ་སྟེ།",
    "མངལ་ན་འདུག་པའི་སྔོན་རོལ་བློ་དེ་ནི།",
    "ཚུལ་འདི་ཡང་རང་བཞིན་གྱི་རྟགས་ལས་ཏེ།",
    "ཐ་ན་བསླབ་པ་སྣ་གཅིག་དུས་སྐད་ཅིག་མ་གཅིག་ཙམ་བསྲུངས་པ་ལའང་།",
    "ཡོན་ཏན་ཐམས་ཅད་ཁོ་རང་ལ་རང་ཆས་སུ་ཡོད་ལ།",
    "ཡོན་ཏན་དེ་ལ་ཞེན་ནས་འགག་ནས་འདུག་ན།",
    "ཨོབཛྲ་བི་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃཧཱུྃ་ཕཊ།",
    "བསྐལ་བ་འཇིག་དུས་ཀྱི་མེ་ལྟར་འབརཀའིཕྲེབ་འཁྲུག་པའི་དབུས་བཞུགས།",
    "ལགསུམ་ལས་མི་ཐུབ་པར་འདུག་ཟེར་བ་དང་།",
    "རྒན་དོར་ཞིས་རྒྱ་ནག་དང་རྒྱ་སེར་གྱི་རྩོམ་རིག་གཞུང་ལུགས་ལ་རྒྱབ་རྟེན་བཅོལ་འདུག་ཅེས་དགག་པ་བརྒྱབ་བྱུང་ལ།",
    "འདིར་གླེང་བར་བྱ་བའི་རྩོམ་རིག་གསར་པ་ལ་བོད་ཀྱི་རྩོམ་སྟེགས་སུ་དེང་རབས་རྩོམ་རིག་དང་དེང་རབས་སྙན་ངག་ཅེས་དེང་རབས་ཞེས་པའི་མིང་བརྡ་སྦྱོར་བ་རྒྱུན་འབྱམས་སུ་གྱུར་འདུག་ནའང་།",
    "མིའི་རིགས་ཀྱིས་རང་བྱུང་དང་རང་བྱུང་མ་ཡིན་པའི་མི་ཚེའི་འཇིགས་པ་སྣ་ཚོགས་ལ་གདོང་གཏོད་དུས།",
    "གསུམ་ན་གཞོན་ནུ་ཟླ་མེད་དང་ཡིད་འོང་མ་ལྟ་བུས་མཚོན་པའི་ལྷ་གཤིས་ཅན་གྱི་མི་སྣ་དང་དེའི་འཚོ་བའི་བྱུང་རིམ་གྱིས་བོད་མིའི་ནང་སེམས་ཀྱི་འཁྱེར་སོ་དང་རང་གཤིས།",
    "མི་དང་རང་བྱུང་།",
    "ངོ་བོ་དང་རང་བཞིན།",
    "ཀློག་པའི་སྤྲོ་ཤུགས་མི་འདུག་ཅེས་པ་དེའོ།",
    "མི་དང་རང་སྒེར།",
    "མི་དང་རང་བྱུང་དབར་གྱི་འདུམ་ཐབས་དཀའ་བའི་འགལ་འདུ་རང་བཞིན་དང་དེའི་གདོང་ཐུག་ལས་བྱུང་བའི་སྡུག་བསྔལ་བའི་མཇུག་འབྲས་མཐའ་དག་ལ་གོ་བ་ཡིན།",
    "གསར་རྩོམ་གྱི་ཆ་ནས་ཀྱང་ད་དུང་ཡང་རང་གཤིས་གསལ་བོ་ཞིག་མེད་པར་རྐང་སྙབ་ལག་སྙབ་ཀྱིས་རྡོག་ཐོན་བྱེད་པའི་ཐོག་མའི་དུས་རིམ་དུ་གནས་ཡོད།",
    "མི་གང་དེར་རང་གཤིས་དང་རང་ཚུགས་ཀྱི་བསམ་བློ་ཡོད་པ།",
    "གང་ལ་ལད་ཟློས་བྱེད་ཀྱིན་འདུག་ཟེར་ན།"
