    "རྒྱུ་རྟག་པ་ཅན་དུ་གྱུར་པ་ནི་སྡུག་བསྔལ་གྱི་རྒྱུ་ཟློག་པའི་དོན་དུ་འབད་པ་འབྲས་བུ་མེད་པར་འགྱུར་ཏེ།",
    "རྟག་ན་ཡང་ཇི་ལྟར་ཟད་པར་འགྱུར།",
    "སྡུག་བསྔལ་ཉིད་ཀྱི་ཁྱད་པར་གྱིས་ཏེ།",
    "འདི་ལྟར་རྟག་པའི་རྒྱུ་ཅན་ཉིད་ཀྱི་སྡུག་བསྔལ་མི་རྟག་པར་འགྱུར་རོ་ཞེ་ན།",
    "མི་མཐུན་ཕྱོགས་ལ་བརྟག་པར་བྱེད།",
    "འབྲས་བུ་སྡུག་བསྔལ་འཇིག་པར་མི་འགྱུར་བའི་ཕྱིར་མི་འཇིག་པའི་ངེས་པ་ཡིན་ནོ།",
    "འོ་ན་ནི་རྒྱུ་ཇི་ལྟར་ཟད་པར་འགྱུར་ཏེ།",
    "སྡུག་བསྔལ་གྱི་རྒྱུ་གཞོམ་པའི་ཕྱིར་སྡུག་བསྔལ་གྱི་རྒྱུ་དེའི་གཉེན་པོ་གང་ཡིན་པ་དེ་བརྟག་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་མ་རིག་པའི་གཉེན་པོ་བདག་མེད་པ་ལ་འབད་པར་བྱའོ།",
    "དེ་བས་ན་རྒྱུ་བཟློག་པར་མི་ནུས་སོ་ཞེ་ན།",
    "འདུས་བྱས་སྤྱོད་ཡུལ་ཅན་ཆགས་པ།",
    "གཞན་ལ་ཕན་པར་བརྩོན་པ་དང་ལྡན་པ་ནི་བདག་ཉིད་སྡུག་བསྔལ་བར་མི་འགྱུར་ཏེ།",
    "ལྷག་པར་རང་ལ་ཞེན་པ་ལས་ལུས་ལ་རལ་གྲི་ལ་སོགས་པས་བསྣུན་པའི་སྡུག་བསྔལ་དམིགས་པར་འགྱུར་རོ།",
    "འདུས་བྱས་ནི་ཟག་པ་དང་བཅས་པའི་དངོས་པོ་སྟེ།",
    "དེ་བས་ན་བདག་མེད་པ་མངོན་དུ་བྱས་པ་ལས་མི་རྟག་པའི་རྒྱུ་འཇིག་ཚོགས་ལ་ལྟ་བ་ལྡོག་པར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་འཆི་བ་ལ་སོགས་པའི་སྡུག་བསྔལ་མེད་པར་མི་འགྱུར་ཞེ་ན།",
    "བདེ་བ་གོམས་པར་མི་འགྱུར་བ་བཞིན་ཏེ།",
    "ཤེས་རབ་རྒྱས་པར་གྱུར་ན་རྣམ་པ་དུ་མ་དང་ལྡན་པའི་ཐབས་མང་པོ་མཐོང་བ་ལས་སྐྱོན་དང་ཡོན་ཏན་རྣམས་གསལ་བར་འགྱུར་བ་ཡིན་པའི་ཕྱིར།",
    "གལ་ཏེ་བདག་མེད་པ་མཐོང་བ་ལས་སྡུག་བསྔལ་ཞི་བར་འགྱུར་བ་དེ་ལྟ་ན་ཡང་ཐམས་ཅད་མཁྱེན་པ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་བདག་མེད་པ་མཐོང་བ་ལས་ཐམས་ཅད་མཁྱེན་པར་འགྱུར་ན།",
    "གང་འདི་བློ་གསལ་བའི་སྐྱེས་བུ་ཡང་དང་ཡང་དུ་ཐབས་མང་པོ་ལ་དུས་ཡུན་རིང་པོར་གོམས་པར་བྱས་ན།",
    "དེ་ལྟར་གོམས་པར་བྱེད་པའི་སྐྱེས་བུ་གོམས་པ་ལས།",
    "བཅོམ་ལྡན་འདས་གཞན་གྱི་དོན་དུ་འཇུག་པ་ཅན་བསེ་རུ་ལ་སོགས་པ་ལས་ཁྱད་པར་འདི་ཉིད་ཡིན་ཏེ།",
    "དེ་མེད་པར་ལས་དང་འབྲས་བུར་འབྲེལ་པར་ཇི་ལྟར་ཤེས་པ་ཡིན།",
    "དེ་ལ་གོམས་པར་ཇི་ལྟར་འགྱུར།",
    "དེ་མེད་པར་ཡང་ལས་དང་འབྲས་བུ་སྤྲོས་པ་མངོན་སུམ་དུ་བྱེད་པ་ཡིན་ནོ།",
    "འོན་ཀྱང་སོ་སོར་ངེས་པའི་དངོས་པོ་བདག་མེད་པར་མཐོང་བ་ན་བདག་མེད་པར་ཁྱད་པར་མེད་པས་ཐམས་ཅད་མཐོང་བར་འགྲུབ་པ་ཡིན་ན་ནི།",
    "དེ་མ་ཐག་ཏུ་ཉམས་སུ་མྱོང་བ་ལ་གོམས་པ་མེད་ན་ནི་དྲན་པ་མེད་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་རྒས་པའི་གནས་སྐབས་ན་བུས་པའི་ཚེ་མྱོང་བ་སྐད་ཅིག་ལ་དྲན་པ་དེ་བཞིན་དུ་གོམས་པ་ཕུལ་དུ་བྱུང་བ་ལས་སྐྱེ་བ་གཞན་དུ་མྱོང་བ་ཡང་དྲན་པའི་ཡུལ་དུ་འགྱུར་བའི་ཕྱིར་དྲན་པ་གོམས་པ་ལ་འབད་པར་བྱའོ།",
    "དེ་ལ་ཡང་དཔེར་ན་ཡུལ་གཞན་ནས་འོངས་པ་རིག་པ་དེས་ཡུལ་གཞན་དང་འབྲེལ་པས་བསྐྱེད་པའི་ཁྱད་པར་མཐོང་བ་ན།",
    "དེ་ནས་འོངས་པར་ངེས་པར་བྱེད་དེ།",
    "ལྷ་སྦྱིན་བཞིན་ཡུལ་གཞན་པ་ཡང་རྣམ་པར་གཅོད་པ་ཅན་དུ་ཤེས་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་དྲན་པ་གསལ་བ་ཡོད་ན་འཇིག་རྟེན་གཞན་ནས་འོངས་པའི་སྐྱེས་བུའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ཡོད་ན་སྐྱེ་བ་གཞན་ཁྱད་པར་དུ་གྱུར་པ་ཡང་ཤེས་པ་ཡིན་ཏེ།",
    "འདི་ནི་ལས་འདི་དང་ཡུལ་འདི་འབྲེལ་པར་སྔོན་ནས་ཡོད་པ་དེ་ལྟ་བུའི་རྣམ་པའི་ངོ་བོ་ཉིད་དང་ལྡན་པ་ལས་སོ་སོར་ངེས་པའི་ལས་དང་འབྲས་བུར་འབྲེལ་བ་རིགས་པ་སྐྱེ་སྟེ།",
    "དཔེར་ན་དུ་བའི་ངོ་བོ་ཉིད་ཕྲ་བ་ངེས་ན་རྒྱུ་རྩྭ་དང་ལོ་མ་ལ་སོགས་པའི་རང་བཞིན་ཡང་ཤེས་པར་འགྱུར་བ་ལྟ་བུའོ།",
    "རྒྱུའི་ངོ་བོ་ཉིད་ཤེས་ན་ཡང་དེའི་འབྲས་བུའི་ངོ་བོ་ཉིད་བརྒྱུད་ནས་ཤེས་པའི་ཕྱིར་ལས་དང་འབྲས་བུའི་འབྲེལ་པ་ཐམས་ཅད་ཤེས་པར་འགྱུར་རོ།",
    "བཅོམ་ལྡན་འདས་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དུ་འགྱུར་ཏེ།",
    "ཕན་ཚུན་རྒྱུ་དང་འབྲས་བུ་ལས་འདས་པར་ཤེས་བྱ་ཐམས་ཅད་སྐྱེ་བ་མ་ཡིན་པའི་ཕྱིར།",
    "རྗེས་སུ་དཔག་པའི་རིག་པས་ཇི་ལྟར་ཐམས་ཅད་མཁྱེན་པར་འགྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་མངོན་དུ་མཁྱེན་པ་ཅན་དུ་ཁས་བླངས་སོ་ཞེ་ན།",
    "གང་ཡང་ཐམས་ཅད་ལ་གོམས་པ་མི་སྲིད་པས་དེ་ཇི་ལྟར་ཐམས་ཅད་མངོན་དུ་བྱེད་པར་འགྱུར་ཞེས་སྨྲས་པ་དེ་ཡང་མི་འཐད་དེ།",
    "སྐྱེ་བ་དང་འཇིག་པའི་རྣམ་པར་གཞག་པ་ལ་རྟག་ཏུ་རང་བཞིན་གཅིག་པ་ཉིད་ཡིན་ལ།",
    "ཁྱད་པར་ཅན་གྱི་བྱེ་བྲག་ནི་བསྟན་བཅོས་ལ་སོགས་པ་ལ་ཡང་མཚུངས་སོ།",
    "རྩོད་པ་ལྷག་མ་ནི་ཐམས་ཅད་མཁྱེན་པ་གྲུབ་པར་གསལ་བ་ཡིན་ནོ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་ཇི་ལྟར་ཐབས་ལ་གོམས་པས་ཡིན་ཞེ་ན།",
    "འདི་ཉིད་བསྟན་པ་ཡིན་པར་འདོད།",
    "འོན་ཀྱང་ཐབས་ལ་གོམས་པ་ཉིད་བསྟན་པར་འདོད་དོ།",
    "བསྟན་པའི་དོན་ཐབས་གོམས་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "ཅེས་བྱ་བ་ལ་གོམས་པ་དང་བསྟན་པ་འདི་གཉིས་ནི་ཐམས་ཅད་རིག་པའི་རྒྱུར་གསུངས་སོ།",
    "ཐབས་གང་ཞིག་གོམས་པ་ལས་བཅོམ་ལྡན་འདས་བདེ་བར་གཤེགས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
