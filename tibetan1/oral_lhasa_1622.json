    "ཆང་ལ་སོགས་པའི་རྫས་ལ་བརྟེན་པའི་མྱོས་པའི་ནུས་པ་ཐ་དད་པར་གནས་པ་སྟེ་རྫས་གནས་ཀྱང་ཕྱིར་ལྡོག་པ་དང་ཕྱིས་མི་སྐྱེ་བའི་ཕྱིར་རོ།",
    "ནུས་པ་གསལ་བར་འགྱུར་ཞིང་ཡང་འཇིག་པར་འགྱུར་བའི་ཕྱིར།",
    "བུ་རམ་ལ་སོགས་པའི་དངོས་པོ་ལས་ནུས་པ་དོན་གཞན་དུ་གྱུར་པར་ཁས་མི་ལེན་ཀྱང་བརྡར་བཏགས་པ་བཞིན་དངོས་པོ་ལས་དངོས་པོའི་ནུས་པ་བཞིན་ཏེ་གང་ཞེས་ཐ་དད་པའི་རྣམ་པར་དབྱེ་སྟེ།",
    "འོ་ན་གལ་ཏེ་མེ་ལ་སོགས་པ་ལ་ནུས་པ་ཐ་དད་མེད་པ་དེའི་ཚེ་སྔགས་ལ་སོགས་པས་ཅི་ཞིག་འཇོམས་པར་བྱེད།",
    "ནུས་པ་བཀག་ཀྱང་མེ་མ་བཀག་པའི་ཕྱིར་ཐ་དད་པར་རིགས་སོ་ཞེ་ན་དེ་ནི་མ་ཡིན་ཏེ།",
    "དངོས་པོ་ཉིད་དེར་འཇིག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྟེན་མེ་ལ་སོགས་པ་མ་ཚང་བ་མེད་པར་གནས་ན་བརྟེན་པ་མེའི་ནུས་པ་འགག་པར་མི་འགྱུར་ཏེ།",
    "རྟེན་ཞིག་པ་ཉིད་ན་བརྟེན་པ་འཇིག་པར་རིག་པའི་ཕྱིར་རོ།",
    "ཐམས་ཅད་ཐ་དད་པར་སྒྲུབ་པར་བྱེད་པ་ནི་སྣང་བ་ཐ་དད་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "ཐ་དད་པར་བྱེད་པ་ནི་ཐ་དད་པར་སྣང་བའི་ཤེས་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་ལྟ་ན་ནི་དེ་ཉིད་སྣང་བ་ཐ་དད་པས་ཐ་དད་པར་བྱེད་པས་ན་གཞན་དོན་མེད་དོ།",
    "ཚེ་འདི་ལ་ནི་དེས་ཕན་བཏགས་པའི་ཁྱད་པར་མ་མཐོང་ངོ།",
    "གལ་ཏེ་ཡང་དེའི་མཛའ་བོ་ཉིད་དུ་གཞན་གྱིས་ཀྱང་ཤེས་པར་འགྱུར་བ་ལས།",
    "མཛའ་བོ་ནི་ལུས་ཀྱི་ནང་དུ་ཆུད་པ་ཡིན་པས་གཞན་གྱིས་ཇི་ལྟར་ཤེས་པར་འགྱུར་ཞེ་ན།",
    "ཕྱི་རོལ་དུ་རྟོགས་པར་འགྱུར་བ་ཇི་ལྟར་ལུས་ཀྱི་ནང་དུ་ཆུད་པར་འགྱུར་ཏེ།",
    "འོན་ཏེ་གཟུགས་ལ་སོགས་པ་ཡིན་ཡང་གཞན་གྱི་ལུས་ཡིན་པའི་ཕྱིར་རིག་པར་ནི་སྣང་ངོ་ཞེ་ན།",
    "འོ་ན་གཞན་གྱི་ལུས་ཀྱང་མི་རིག་པར་འགྱུར་རོ།",
    "ལུས་གཞན་དང་ལྷན་ཅིག་པར་ངེས་ན་ཤེས་པ་ཡན་གར་བ་ཇི་ལྟར་རྟོགས་པར་འགྱུར་ཏེ།",
    "ལུས་ཡན་གར་བ་མྱོང་བ་ཡིན་པའི་ཕྱིར་ལུས་དང་སེམས་དག་ལྷན་ཅིག་དམིགས་པར་ངེས་པ་ནི་མེད་དོ།",
    "མཚུངས་འགྱུར་རྣམ་པར་རྟོག་པ་ནི།",
    "ལུས་ཀྱི་ངོ་བོ་ཉིད་གཅིག་ཡིན་པའི་ཕྱིར་གཟུགས་ལ་སོགས་པ་ཐ་དད་པར་སྣང་བ་མ་ཡིན་ནོ།",
    "འདོད་ཆགས་ལ་སོགས་པ་རྣམ་པར་ཤེས་པ་དང་འབྲེལ་བ་ཡིན་ཡང་ཇི་ལྟར་མཚུངས་པ་ཉིད་དུ་མི་འགྱུར་ཞེ་ན།",
    "གང་ཚེ་ལུས་ལ་ལྟོས་མེད་པར།",
    "ཇི་ལྟར་དེ་ནི་ཡོད་པར་འགྱུར།",
    "དངོས་པོ་ཐམས་ཅད་ཤེས་པའི་ནུས་པ་དང་ལྡན་པའི་ཕྱིར་ཤེས་པ་སྐྱེད་པར་བྱེད་པའི་ཤེས་པ་འདོད་པ་མ་ཡིན་ནམ།",
    "དེ་ལ་ཞོ་ལ་སོགས་པའི་རང་བཞིན་ཡོད་པར་ཅི་ལྟར་འགྱུར།",
    "གལ་ཏེ་རང་བཞིན་གྱིས་ཡོད་ན་ནི་དེ་ཉིད་ཡོད་དོ་ཞེས་བརྗོད་པར་བྱ་བའོ།",
    "ཁྱད་པར་འདི་ཡི་རྟེན་ཅན་གང་།",
    "དེ་ནི་ཕུལ་བྱུང་འགྲིབ་པར་ལྡན།",
    "དེ་ལྟ་ན་ཡང་འདོད་ཆགས་ལ་སོགས་པ་ནི་ངེས་པ་མེད་པར་འགྱུར་ཏེ།",
    "དེ་ཐམས་ཅད་ཀྱིས་མི་འདོར་བའི་ཕྱིར་སྐྱེ་བ་དང་ལྡན་པ་ཐམས་ཅད་འདོད་ཆགས་དང་ལྡན་པར་གྲུབ་པོ་ཞེ་ན།",
    "ཐམས་ཅད་འདོད་ཆགས་མཚུངས་པར་སྲིད་པ་མ་ཡིན་ནམ།",
    "སྲོག་ཆགས་སྲོག་ཆགས་མ་ཡིན་པར་མི་འགྱུར་བ་དེ་བཞིན་དུ་འདོད་ཆགས་དང་བྲལ་བ་ཡང་ཡིན་པའི་ཕྱིར་རྩོད་པ་མེད་དོ།",
    "དེ་ལྟ་ན་འོ་ན་ནི་ཇི་ལྟར་སྲོག་ཆགས་ཉིད་དུ་ཁྱད་པར་མེད་པ་དེ་བཞིན་དུ།",
    "ཐམས་ཅད་འདོད་ཆགས་མཚུངས་པར་འགྱུར་ཏེ་སྲོག་ཆགས་བཞིན་ནོ།",
    "ཀུན་ལ་འདོད་ཆགས་མཚུངས་པར་འགྱུར།",
    "སྲོག་ཆགས་ཐམས་ཅད་ལ་འདོད་ཆགས་མཚུངས་པར་འགྱུར་ཏེ།",
    "དེ་བས་ན་ཇི་ལྟར་དྲོ་བའི་ཆེས་ཤིན་ཏུ་བ་ཡོད་ཀྱང་མེ་དྲོ་བ་དང་བྲལ་བ་ནི་མ་ཡིན་པ་དེ་བཞིན་དུ་འདོད་ཆགས་ལ་སོགས་པ་ལ་ཆེས་ཤིན་ཏུ་བ་ཡོད་ཀྱང་ཤིན་ཏུ་ཆད་པར་གྱུར་པ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་ཆེས་ཤིན་ཏུ་བ་ཡོད་ཀྱང་མེ་གཏན་མེད་པར་འགྱུར་བ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་བས་ན་རྟགས་ཁྱད་པར་དང་བཅས་པ་སྟེ།",
    "ལྡོག་པར་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "དེས་ན་གཟུགས་ལ་སོགས་པ་ཡུལ་ནི་ངེས་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་གདོན་མི་ཟ་བར་འདོད་ཆགས་ལ་སོགས་པའི་གྲོགས་ཙམ་བྱེད་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཡང་དང་པོ་སྐྱེས་པའི་སེམས་མའི་མངལ་དུ་གོམས་པ་ལས་སྐྱེས་པར་ཅིས་ཤེས་ཤེ་ན།",
    "དེ་ལྟ་ན་འོ་ན་ནི་དུ་བ་ཐམས་ཅད་ཀྱང་མེ་ལས་སྐྱེས་པར་གང་དུ་མཐོང་།",
    "མངོན་སུམ་གྱིས་ན་རྩྭ་མཆོག་ལ་གླང་པོ་ཆེ་ཡོད་པར་རྟོགས་པར་མི་ནུས་པ་དེ་བས་ན་ཐ་མི་དད་པར་མཐོང་བ་ཉིད་རྒྱུ་དང་འབྲས་བུའི་ཐ་སྙད་ཉམས་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཡང་འཇིག་རྟེན་ཕ་རོལ་ཡང་དེའི་རིགས་དཔགས་པ་ལས་ཐ་སྙད་དུ་འཇིག་རྟེན་ཕ་རོལ་ཡོད་པར་འགྱུར་ཏེ།",
    "དོན་དམ་པར་མ་ཡིན་ནོ།",
    "དུས་ཐ་དད་པར་སྐྱེ་མི་འགྱུར།",
    "བྱིན་གྱིས་རློབ་པས་ནི་བྱེད་པ་དང་བཅས་པར་འགྱུར་བའོ།",
    "དེ་བས་ན་འབྲས་བུ་དུ་མ་དུས་ཐ་དད་པར་བདག་ལ་སོགས་པ་རྟག་པ་ལས་སྐྱེ་བར་མི་འགྱུར་རོ།",
    "རྒྱུ་གཞན་པ་རྗེས་སུ་དཔག་པར་བྱ་སྟེ།",
    "གང་ཞིག་མེད་པར་འབྲས་བུ་མི་སྐྱེད་པས།",
    "འོ་ན་ནམ་མཁའ་ལ་སོགས་པ་དག་ཀྱང་མིག་ལ་སོགས་པ་བྱིན་གྱིས་རློབ་པར་བྱེད་པར་འགྱུར་ཏེ།",
    "རྟག་ཏུ་ཡོད་པའམ་མེད་པར་འགྱུར།",
    "སྡུག་བསྔལ་འདི་ནི་རྒྱུ་དང་བཅས་པར་ངེས་ཏེ།",
    "ལྟོས་པ་མེད་ན་རྒྱུ་དང་བཅས་པ་ཉིད་དུ་བསྟན་པར་འགྱུར་རོ།",
    "གནས་སྐབས་དང་ལྡན་པར་སྐྱེའོ།",
    "རྣོ་བ་ཉིད་དུ་ཁྱད་པར་དུ་བྱེད་ལ།",
    "ལྕགས་བྱེད་ན་ཡང་ས་ལ་སོགས་པ་ནི་བྱེད་པ་ནི་མ་ཡིན་པའི་ཕྱིར་ལྕགས་ལ་སོགས་པའི་ངོ་བོ་ཉིད་བྱེད་པའི་མགར་བ་མེད་ཀྱང་ཚེར་མ་ལ་སོགས་པ་ལ་རྣོ་བ་ཡོད་པའི་ཕྱིར་རྣོ་བ་ཉིད་མགར་བས་བྱས་པ་ནི་མ་ཡིན་ནོ།",
    "སྐྱེར་པའི་ས་བོན་མེད་པར་མང་པོ་དང་རྣོན་པོ་ཉིད་དུ་འགྱུར་ན་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་གཞན་དུ་མཐོང་བའི་ཕྱིར་རོ།",
    "རྟག་པ་དང་གཙོ་བོ་དེ་དག་ནི་སྔར་བཀག་པར་བྱས་པ་ཉིད་ཡིན་ནོ།",
    "གང་ཕྱིར་ཡུལ་གྱི་ཁྱད་པར་ལེན།",
    "མི་རྣམས་དེ་ཐོབ་བསམ་པས་བྱས།",
    "ལས་དང་ལུས་དང་མ་རིག་པ་ལས་གཞན་ལ་རབ་ཏུ་སྐྱེ་བའི་ནུས་པ་ཡོད་པར་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "ལེན་པ་ནི་ཡུལ་གྱི་ཁྱད་པར་འདོད་པ་སྟེ།",
    "བརྗོད་པར་འདོད་པའི་ཡུལ་ཐོབ་པར་སྲེད་པས་བྱེད་པའི་ཕྱིར་རོ།",
    "སྲིད་པ་འདོད་པ་ནི་མ་འོངས་པའི་སྐྱེ་བ་ལ་འདུན་པར་བྱེད་པའི་རྣམ་པའོ།",
    "གང་འདི་འདོད་པའི་སྲེད་པ་དང་སྲིད་པའི་སྲེད་པ་དང་བྲལ་བའི་སྲེད་པ་ཞེས་བྱའོ་ཞེས་གསུངས་སོ་ཞེ་ན།",
    "དགའ་བའི་ཁྱད་པར་གྱི་རྒྱུ་ཡིན་པའི་ཕྱིར།",
    "འཇིག་རྟེན་ཕ་རོལ་གྲུབ་པར་འགྱུར་རོ།",
    "རྒྱུན་ནི་འཕེན་པར་བྱེད་ཕྱིར་དང་།",
    "གཏི་མུག་དང་ལས་དག་ཡོད་ཀྱང་སྲེད་པ་མེད་པར་གང་དུ་ཡང་འཕེན་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དངུལ་དུ་འཁྲུལ་ན་ཡང་སྲེད་པ་མེད་ན་འཇུག་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "མ་ཆོད་པར་སྐྱེ་བའི་རྒྱུ་ལས་ཀྱང་མ་ཡིན་ཏེ།",
    "འགོག་པའི་རྣམ་པར་བརྗོད་དོ།",
    "དེ་ལ་རྣམ་པ་དང་པོ་བསྟན་པའི་ཕྱིར་སྡུག་བསྔལ་དེ་གཏན་དུ་བར་ཡོད་པ་མ་ཡིན་གྱི་འོན་ཀྱང་འགོག་པར་འགྱུར་རོ།",
    "སྡུག་བསྔལ་གྱི་རྒྱུ་དང་བྲལ་ན་སྡུག་བསྔལ་ཉིད་ཀྱང་ལྡོག་པར་འགྱུར་བའི་ཕྱིར་འགོག་པར་སྲིད་པ་ཡིན་ནོ།",
    "འོན་ཏེ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སྐྱེད་པར་ནུས་པ་ཐ་མའི་སེམས་ལ་ཡོད་ན་ནི།",
    "འོན་ཏེ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་ཐ་མིའི་སེམས་གྲོགས་བྱེད་པ་ཙམ་ཡིན་ཏེ།",
    "ཤེས་པ་གཞན་གྱི་ཉེ་བར་ལེན་པར་མི་འགྱུར་བས་ཐ་མ་ཉིད་ཡིན་ནོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་དག་ལ་རིགས་མཐུན་པ་ཡོད་པ་མ་ཡིན་ནམ།",
    "དེ་མེད་ན་ཡང་དེའི་གོང་མ་ཡང་མེད་པས་སྔ་མ་སྔ་མ་མེད་པར་འགྱུར་ཏེ།",
    "དེ་དག་སྔ་ཕྱིར་རྟོགས་ན་རིགས་པ་མེད་པར་བརྩད་པ་ཡིན་ནོ།",
    "འོ་ན་ཟླ་བ་གཉིས་སུ་སྣང་བ་ཡང་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "གཞན་ཡང་ཇི་ལྟར་དོན་བྱེད་པ་ནི་རྒྱུ་ཡོད་པ་དེ་ལྟར་བསྐྱེད་པར་བྱ་བའི་འབྲས་བུ་ཡང་ཡོད་དེ།",
    "ཡང་གང་རྒྱུའི་མཚན་ཉིད་ཅན་ཡིན་པས་དངོས་པོའི་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་ཡང་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་སྐྱེད་པར་ཐ་མའི་སེམས་ལ་ནུས་པ་ཡོད་ན་དེའི་ཚེ་ཐ་མའི་ཉིད་དུ་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་བརྗོད་པ་དེ་ནི་ཤིན་ཏུ་འབྲེལ་པ་མེད་པ་སྟེ།",
    "འདི་ལྟར་ཐ་མའི་སེམས་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་གྲོགས་བྱེད་པ་སྟེ།",
    "དེ་བཞིན་དུ་འདོད་ཆགས་དང་མ་བྲལ་བའི་རྒྱུན་ཆད་ཀྱང་ཐམས་ཅད་མཁྱེན་པའི་རྒྱུན་འཇུག་པ་ཡིན་ནོ།",
    "གང་ཡང་ཤེས་པ་ཡིན་པའི་ཕྱིར་ཐ་མའི་ཤེས་པ་ནི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་ཉེ་བར་ལེན་པར་འགྱུར་རོ་ཞེས་ཟེར་བ་འདི་ལ་སྨྲས་པ་ནི།",
    "ས་ཡང་སའི་ངོ་བོ་དང་ལྡན་པའི་ཕྱིར་མྱུ་གུའི་ཉེ་བར་ལེན་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱང་འདོད་ཆགས་དང་མ་བྲལ་བའི་སེམས་ལ་དམིགས་པ་ཡིན་གྱི།",
    "རྒྱུན་ཡང་དོན་དམ་པར་མེད་པའི་ཕྱིར་རོ།",
    "བཅིང་པ་ཡང་གཞན་ཡིན་པར་འགྱུར་ཏེ།",
    "ལོག་པར་སྒྲོ་འདོགས་གཞོམ་ཕྱིར་བརྩོན།",
    "གལ་ཏེ་མངོན་སུམ་མཐོང་བ་ལ་འཇུག་པར་མི་འགྱུར་རོ་ཞེས་བརྗོད་པ་དེ་ནི་འདོད་པ་ཁོ་ན་སྟེ།",
    "དེ་ཁོ་ན་ཉིད་མཐོང་བ་ནི་བདག་ནི་བློས་གང་དུ་ཡང་འཇུག་པ་མེད་པས་འབད་པར་བྱེད་པ་མེད་དེ་བླང་པ་དང་།",
    "འོན་ཏེ་བདག་ཅག་ལ་སོགས་པ་འཇུག་པར་མི་འགྱུར་རོ་ཞེས་རྩོད་ན་ནི་དེའི་ཚེ་བདག་ཅག་ལ་སོགས་པ་གཅིག་ཏུ་ཞེན་ནས་དེ་ཉིད་བཅིངས་ཤིང་གྲོལ་ལོ་ཞེས་གཅིག་པ་ཉིད་དུ་ཞེན་པ་ཡོད་པས་འཇུག་པར་རིགས་ཏེ།",
    "དོན་དམ་པར་དངོས་པོའི་སྟོབས་ལས་ནི་ཐ་སྙད་འདོགས་པ་མ་ཡིན་ཏེ།",
    "འོ་ན་གལ་ཏེ་འདོད་ཆགས་དང་བྲལ་བའི་ལས་ཀྱིས་གནས་པར་བྱེད་ན་དེའི་ཚེ་འཇིག་རྟེན་གཞན་དུ་བྱས་པའི་ལས་ཡོད་པའི་ཕྱིར།",
    "འོན་ཏེ་ལས་ཏེ་ནུས་པ་མེད་ན་ནི་འདོད་ཆགས་དང་བྲལ་བའི་གནས་པ་དེ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྔོན་གྱི་ལས་ཀྱིས་འཕངས་པའི་སེམས་ཀྱི་རྒྱུད་ལྡོག་པ་ལ་འབད་པ་མེད་པར་གནས་ཏེ།",
    "འཕངས་པ་ནི་རྩོལ་བ་མེད་པར་བཟློག་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "དེ་ཉིད་སྲེད་པ་དང་བྲལ་ན་སྔོན་གྱི་ལས་ཀྱིས་སྐྱེ་བ་གཞན་འཕེན་པར་བྱེད་མི་ནུས་སོ།",
    "དེ་ལ་ཁྱད་པར་སྨྲས་པ།",
    "འདོད་ཆགས་དག་ལ་ཁྱད་པར་ཆེ་སྟེ།",
    "ངོ་བོ་ཉིད་གཞན་རྟག་པ་དང་བདེ་བ་ལ་སོགས་པའི་རྣམ་པར་སྒྲོ་བཏགས་པའི་ཕྱིར་རོ།",
    "བརྩེ་བ་ནི་སྡུག་བསྔལ་གྱི་རྒྱུན་ཙམ་མངོན་སུམ་དུ་བྱས་པ་ཉིད་ནི་ལོག་པའི་ཤེས་པ་ལས་བཟློག་པའི་ཕྱིར་རོ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ཉེས་པའི་རྒྱུ་སྟེ་དེ་ཡང་ཡོད་པར་འཛིན་པའོ།",
    "གལ་ཏེ་འདོད་ཆགས་དང་བྲལ་བ་ལུས་དང་བཅས་པར་ཡོད་ན།",
    "གཞན་ཡང་སྐྱེ་བ་སྔ་མའི་ཉིང་མཚམས་སྦྱོར་བ་སྔོན་གྱི་ལས་ཀྱིས་བྱས་པའི་འདུ་བྱེད་ཟད་ན་སྐྱེ་བ་གཞན་དང་མཚམས་མི་སྦྱོར་བས་མི་གྲོལ་བ་མ་ཡིན་ནོ།",
    "གཞན་གྱི་ངོར་ནི་བཞུགས་པ་ཡིན།",
    "དེའི་ཚེ་དང་པོ་མཐོང་བའི་ལམ་ཉིད་ཀྱིས་རྒྱུན་དུ་ཞུགས་པའི་སྤང་བྱ་སྤངས་པར་འགྱུར་ཏེ།",
    "ལམ་མངོན་དུ་བྱས་པའི་ཕྱིར་རོ།",
    "ཤེས་རབ་ཕུལ་དུ་བྱུང་བར་གསལ་བ་ལམ་དང་པོ་ཉིད་སྐྱོན་མ་ལུས་པ་ཟད་པར་བྱེད་པའི་ཕྱིར་མཐོང་བའི་ལམ་དེ་ཉིད་ལམ་ཐམས་ཅད་ཀྱི་ངོ་བོ་ཉིད་ཡིན་ནོ།",
    "དངོས་པོས་སྐྱེད་པར་བྱེད་པ་མེད་པས་དེའི་བློ་ནི་མ་ཡིན་པའི་ཕྱིར།",
    "བདག་ལ་ཆགས་པ་མེད་པར་ཡང་།",
    "འཇིག་ཚོགས་ལ་ལྟ་བ་ལྷན་ཅིག་སྐྱེས་པ་དེ་མ་སྤངས་པས་མེད་པར་མི་འགྱུར་རོ།",
    "འགའ་ཞིག་ང་ཞེས་མ་མཐོང་བ་དེ་ནི་བདག་ལ་ཆགས་པར་མི་བྱེད་ཅིང་།",
    "ཇི་ལྟར་ཡང་སྲིད་པ་མེད་པར་འགྱུར།",
    "རང་རླག་པར་བྱེད་པ་ལ་འགོད་པར་དཔྱོད་པ་དང་ལྡན་པ་མི་རིགས་སོ།",
    "མི་དམིགས་པའི་ཕྱིར་འདི་མེད་པར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "དེ་གནས་ན་དེའི་རང་བཞིན་ཡང་ཟད་པར་བྱ་བར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་ལོག་པར་སྣང་བ་དང་།",
    "ཅི་སྟེ་དེ་ལྟ་ན་ནི་མ་རིག་པ་ཚངས་པ་ལས་ཐ་མི་དད་པ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "ཚངས་པ་དེ་ཡང་རྟག་ཏུ་གྲོལ་བར་གནས་ན་ཅིའི་ཕྱིར་འཇུག་པར་བྱེད།",
    "འོན་ཏེ་རིག་བྱེད་ལས་ཤེས་པ་ཚངས་པར་བརྗོད་པ་ཡིན་ནོ་ཞེ་ན།",
    "རིག་བྱེད་ལས་ཤེས་པར་གྱུར་པའི་ཚངས་པ་ནི་ལོག་པའི་ངོ་བོ་ཉིད་ཀྱིས་སྣང་བ་ཡིན་ཏེ།",
    "ཚངས་པ་འགགས་ན་མ་རིག་པ་རྒྱུན་ཆད་པར་ཇི་ལྟར་འགྱུར།",
    "རིག་པ་ལས་མ་རིག་པ་ལྡོག་པར་བྱེད་དོ་ཞེ་ན།",
    "ལྷན་ཅིག་བྱེད་པའི་གྲོགས་ལ་ལྟོས་ནས་ཀྱང་རྟག་པས་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་བཀག་པ་ཡིན་ནོ།",
    "སྡུག་བསྔལ་མེད་པ་སྐྱེད་པར་བྱེད་ཅིང་སྡུག་བསྔལ་དང་བྲལ་བར་གནས་ལ།",
    "དེ་བས་ན་རྟག་པ་དང་མི་རྟག་པ་དག་ཏུ་བརྗོད་པར་མི་བྱ་བ་མ་ཡིན་ནམ་ཞེ་ན་སྨྲས་པ།",
    "མི་རྟག་པ་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཞེས་བྱ་བ་འདིས་ནི་འདི་ལ་རྟག་པ་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བས་ཁྱབ་བྱེད་མི་རྟག་པ་མེད་ན་དོན་བྱེད་པ་མེད་པའི་ཕྱིར་བརྗོད་པར་བྱ་བ་མ་ཡིན་ན།",
    "འགལ་བར་འགྱུར་བ་དེའི་ཕྱིར་རྟག་པ་དང་མི་རྟག་པའི་ལྟ་བ་ཅན་ཁྲེལ་སྤངས་པ་དེ་ནི་རྟག་པ་ཞེས་རྗོད་པར་བྱེད་དོ།",
    "དེ་ལས་གཞན་པའི་ལམ་བདག་ཏུ་ལྟ་བ་ཡིན་ནོ་ཞེས་སྨྲས་པ་བསལ་བའི་ཕྱིར་ངེས་པར་འབྱིན་པ་ཞེས་བྱ་བ་རྣམ་པ་བཞི་པ་ཡིན་ནོ།",
    "ཀུན་གཞི་པ་ཡོངས་སུ་དགའ་བའི་ངོ་བོ་ཉིད་གནས་གྱུར་པར་འགྱུར་ཏེ།",
    "དེ་ཡིས་སྐྱེད་པར་བྱེད་པའང་ཡིན།",
    "སྲོག་ཆགས་རྣམས་ལམ་ལ་འཇུག་པར་བྱེད་པ་རྣམ་པར་ཤེས་པ་ཡིན་ཏེ།",
    "ཡུལ་ཉམས་སུ་མྱོང་བ་རྣམ་པར་ཤེས་པར་འགྱུར་གྱི།",
    "མྱོང་བ་མེད་ན་ནི་རྣམ་པར་ཤེས་པ་མ་ཡིན་ནོ།",
    "ཡུལ་དེ་ཡང་ཡོད་པར་འགྱུར་བའི་བདག་ཉིད་ཀྱིས་རྣམ་པར་ཤེས་པ་ནི་སྐྱེད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "རྣམ་པ་གཏོད་པར་བྱེད་ནུས་པའི་རྒྱུ་ནི་རྣམ་པར་ཤེས་པའི་ཡུལ་ཡིན་ནོ།",
    "ཡོད་པར་གྱུར་པའི་ངོ་བོ་ཉིད་དུ་ཤེས་པ་ཉིད་ཡུལ་ཡིན་ནོ།",
    "རྣམ་པར་ཤེས་པ་ནི་ཡུལ་དེ་འཛིན་པ་ཉིད་ཡིན་ནོ།",
    "བདག་ཏུ་འཛིན་པར་མི་འགྱུར་བ་མ་ཡིན་ནམ།",
    "རྒྱུ་གཞན་གྱིས་ནི་འཁྲུལ་པར་འགྱུར།",
    "རང་བཞིན་རྣམ་པར་ཤེས་པ་འདི་ལས་ཏེ།",
    "དད་པ་ལ་སོགས་པ་དམན་པ་དགྲ་བཅོམ་པར་གྱུར་པ་ཡང་འདོད་ཆགས་དང་བྲལ་བ་ལས་ཉམས་པར་གྱུར་ནས་ལམ་མངོན་དུ་བྱེད་པར་འགྱུར་བ་དང་།",
    "ལྡོག་པར་སྐྱེད་ནུས་ཡོད་མིན་ཏེ།",
    "གལ་ཏེ་ཡང་དད་པ་དམན་པ་ལ་སོགས་པའི་དགྲ་བཅོམ་པ་ལ་སྐྱོན་རྣམས་སྐྱེ་ན་ཡང་ནང་དུ་གྱུར་པའི་གནོད་པ་ཅན་སྐྱེད་ནུས་པ་ཅན་གྱི་རྒྱུད་ལ་སྐྱོན་གྱི་ཚོགས་རྣམས་ཤིན་ཏུ་སྐྱེད་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "ངོ་བོ་ཉིད་ནི་བརྩོན་པ་མེད་པར་བཟློག་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "སྐྱོན་མཐོང་ནས་ཡོན་ཏན་ལ་ལྡོག་པར་མི་བྱེད་དེ།",
    "ངོ་བོ་ཉིད་ནི་བཟློག་པར་མི་ནུས་ཏེ།",
    "ཡུལ་གནས་བཞིན་དུ་ཇི་ལྟར་ལམ་ལྡོག་པར་འགྱུར།",
    "འབད་པར་བྱས་ཀྱང་ལམ་ལ་གནོད་པ་ནི་མ་ཡིན་ནོ།",
    "བདག་ཏུ་འཛིན་པ་ཡོད་ན་གཅིག་ཀྱང་གཏན་དུ་ཆགས་པར་མི་འགྱུར་གྱི།",
    "ཕན་ཚུན་འགལ་བར་གྱུར་པ་ཡིན་ཡང་རིམ་པར་སྐྱེ་བ་ཉིད་དུ་འགྱུར་རོ།",
    "འགལ་བ་ཡིན་ཡང་གནོད་པར་མི་བྱེད་དོ།",
