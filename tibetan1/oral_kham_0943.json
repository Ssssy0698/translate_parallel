    "དུས་དེ་ཙ་ན་རྩིག་པ་དང་རི་བོ་ལ་ཐོགས་པ་མེད་པར་འགྲོ་བ་སོགས་སྣང་བ་ལ་ཅི་བྱ་བྱ་བཏུབ་པས།",
    "སྣང་ཐོག་ཏུ་སེམས་ཀྱི་འདུག་ཚུལ་རིག།",
    "སྣང་ཐོག་ཏུ་སེམས་ཀྱི་འདུག་ཚུལ་རིག་པ་ཞེས་བྱ།",
    "གཞན་ཡང་འདི་ལ་རིག་པ་སྐད་ཅིག་མ་ཞེས་ཀྱང་ཟེར་གྱི་འདུག་པ་དེའི་གོ་དོན།",
    "ཕྱི་མའི་གནས་སྐབས་སུ་ཡང་དེ་ཉིད་ལས་གཞན་དུ་འགྱུར་བ་མི་སྲིད་པས་དེ་སྐད་དུ་བཏགས་པར་འདུག་གོ།",
    "དེང་སང་མ་གོ་བ་མང་པོས་ངན་པ་སྡུག་སྡུག་ཞིག་ལ་བློ་གཏོད་ཀྱི་འདུག་སྟེ།",
    "སྣང་ཐོག་ཏུ་སེམས་ཀྱི་འདུག་ཚུལ་རིག།",
    "དེས་ཡང་དག་དང་དབྱིབས་གང་དུ་གྲུབ་འདུག་ལེགས་པར་བལྟས་པའི་ཚེ་སོགས་ཀྱིས་དགག་པ་ནི།",
    "སེམས་ཀྱི་ངོ་ལ་ལྟ་ཚུལ་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱིས་དཔྱད་པ་དེ་ལོས་ཡིན་ཀྱང་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ངོས་འཛིན་ལ་མ་མཐུན་པ་ཡིན།",
    "བང་ཆེན་ལན་བཅུ་གཉིས་བཏང་བས་ཤཱནྟི་པས་རྩོད་པ་ལ་འོང་མ་ནུས་དེས་མེ་ཏྲི་པ་ཆེན་པོ་རྩོད་མེད་དུ་བཀུར་བ་འདུག་པས་ཁྱེད་ཀྱི་ཀླུ་སྒྲུབ་ལུགས་སྐྱོར་བ་དང་ཨེ་མཐུན་མི་ཤེས་ཏེ།",
    "ཐོས་བསམ་ཀྱིས་དཔྱད་པ་ཁོ་ན་ཞི་གནས་དང་ཟུང་འཇུག་ཏུ་རྟོགས་པ་མ་ཤར་བར་འཆར་མི་ཐུབ་བོ་། ཡང་འཕྲོ་བ་ཞི་གནས་ཀྱི་སྒོམ་གྱི་གེགས་ལོས་ཡིན།",
    "གསན་རྒྱ་ཆེ་ཡང་གཞན་གྱི་ཐུགས་སུ་ཆུད་མི་འགྱུར་ཞེས་གསུངས་དེ་ཀར་འདུག་པས།",
    "ཞེས་པའི་དགོས་པ་སྟོར་ས་དེར་འདུག་སྟེ།",
    "བདེ་གསལ་མི་རྟོག་སྒོམ་གྱི་ཡང་རྩེ་ཡིན་ཟེར་བ་ཞིག་ཀྱང་འདུག་པ།",
    "ལས་དང་པོ་པ་ལ་བྱིང་བའི་རྒྱུ་ནི་དམིགས་པའི་འཛིན་སྟངས་ལྷོད་པ་ཡིན་པ་བདེན་ཀྱང་སེམས་བྱིང་བ་འདི་ནི་ཐ་མལ་པའང་བྱིང་ངེ་བ་ཞིག་འདུག་ཅེས་པ་ལྟ་བུ།",
    "ཞེས་པའང་བོད་སྨོན་མཆོང་ཡིན་པས་ཚར་བཅད་གསུམ་པར་ལྷུང་ངོ་། ལྟ་བ་དེ་ཡི་ཡན་ལག་ཡིན་ཞེས་པའང་རང་ཉིད་ཀྱི་བློ་སྐྱོན་ཏི།",
    "དེས་ན་དེས་ཅིག་ཅར་བ་བཀག་གོ་སྙམ་ནས་ཐ་སྙད་དེ་བཟོ་བ་ལ་འཇིགས་འཇིགས་ལྟ་བའང་གདའ་སྟེ།",
    "དམིགས་པ་དམིགས་ཁྱེར་གྱི་གནས་དེར་གདའོ།",
    "འདིར་རོ་གཅིག་དུས་། པ་། དེས་ན་ཆད་པར་བལྟ་བར་འགྱུར།",
    "འགག་དང་ཉ་ག་ཟིན་ཙ་ན་། ཚིག་ཚོགས་སྤྲིན་ཕུང་འཁྲིགས་གྱུར་ཀྱང་།",
    "རྒྱལ་བ་རྣམས་ཀྱིས་རྫོགས་ལྡན་གྱི་དུས་མཁོ་བའི་གཞུང་མང་པོ་རྣམས་རྩོད་དུས་འདིར་ཤིན་ཏུ་བསྡུས་ཏེ་བསྟན་པ་དེ་ལ་དགོངས་པར་འདུག་གོ།",
    "ཞེས་པར་གདའོ།",
    "ཁྱེད་རང་ལུགས་ཀྱི་གཞུང་ལུགས་ལ།",
    "འགྲོ་འཆག་ཉལ་འདུག་ལ་སོགས་པ།",
    "དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ།",
    "དུས་དེ་ཙ་ན་བྱིང་རྒོད་པར་གཡེང་མི་བྱ།",
    "དེའི་ཚེ་ཇི་སྲིད་འདོད་ཀྱི་བར་དུ་འདུག་པར་བྱའོ།",
    "བྱིང་ན་འདུག་ས་སེང་བར་བསྒོམ།",
    "སྟོང་ཉམས་སུ་ལུས་བར་སྣང་དུ་འདུག་པ་ལྟ་བུ།",
    "བདེ་ཉམས་ལུས་འཁྲིག་དུས་ལྟ་བུའི་བདེ་བས་མྱོས་པ།",
    "རིག་པ་ངང་ལ་བཞག་ཙ་ན།",
    "རྣམ་རྟོག་རང་བཞིན་གོ་ཙ་ན།",
    "འཛིན་པ་འདུག་ན་རྣམ་རྟོག་ཡིན།",
    "རྣམ་རྟོག་དེ་ཉིད་སེམས་སུ་འདུག།",
    "རང་རྒྱུད་ཕྱིན་ལ་སྒོམ་ལུགས་འདི་ལ་ངོ་བོའི་སྒོམ་ལུགས་སུ་འོང་ས་ཡེ་མི་འདུག་སྙམ་ནས་ཞུས་པས།",
    "བློས་ཅི་ཡང་མི་འཛིན་པ་གཉིས་མཐུན་པར་འདུག་བསམ་པ་དང་།",
    "དེ་ཡང་གཞན་ངོར་རྒྱུ་འབྲས་མི་བསླུ་ཞིང་རང་ལུགས་ལ་བསླུ་མི་བསླུ་བའི་རྣམ་གཞག་གང་ཡང་ཁས་མི་ལེན་ཟེར་བ་མ་ཡིན།",
    "དེས་ན་ཕྱོགས་སྔའི་ནམ་མ་ལངས་པར་གདའོ།",
    "དེ་ཡང་རང་བཞིན་གྱི་རིགས་ལ་བརྟེན་ཏོ།",
    "རང་རང་ངོ་བོས་སྟོང་།",
    "མི་རྟག་སྡུག་བསྔལ་སྟོང་བདག་མེད་ཀྱི་རྣམ་པ་ཉམས་སུ་མྱོང་དགོས་པར་འདུག་ལ།",
    "བཏང་སྙོམས་གསུམ་སྐྱེ་ཡི་འདུག་པ།",
    "དེ་ལ་ཕྱི་རོལ་དུ་གྲུབ་པར་བལྟ་བ་དག་པ་ཞིག་དགོས་གདའ།",
    "སེམས་འདུལ་ཤེས་ན་ཤེས་པའི་རབ་དེ་ཀར་འདུག་པ།"
  ]
}