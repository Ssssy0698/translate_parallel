    "རྣམ་པར་བྱང་བར་གནས་པ་དེ་ལྟ་དེ་ལྟ་བུར་གསོལ་ལོ།",
    "དེས་ཀྱང་སེམས་ཀྱིས་བཟོད་པར་བྱོས་ཤིག།",
    "གང་སྔ་དྲོ་ཁྲོས་པ་ལ་དེས་ཕྱི་དྲོ་བཟོད་པར་གསོལ་ཅིག།",
    "སུམ་བཅུ་རྩ་གསུམ་གྱི་ལྷའི་རིས་བཟང་པོར་སྐྱེས་ཏེ་བཅོམ་ལྡན་ལྡན་འདས་ལ་སེམས་མངོན་དུ་དད་པ་བསྐྱེད་པར་མཐོང་ངོ།",
    "བདག་འདིར་ཞག་མ་ལོན་པར་བཅོམ་ལྡན་འདས་ལ་ལྟར་འགྲོའོ་སྙམ་དུ་བསམ་སྲ་ནས།",
    "བདག་དེང་ཤིན་ཏུ་གཙང་བ་རྣམ་དག་མིག།",
    "སྐྱེ་རྒན་དང་འཆི་དང་འཆི་ལས་རྣམ་པར་བྲལ།",
    "ཞབས་གཉིས་ལ་ནི་ཕྱག་བྱས་དགའ་བ་སྐྱེས།",
    "དགེ་སློང་དག་སྲོད་དང་ཐོ་རངས་ལ་མི་ཉལ་བར་ཐུབ་པར་བརྩོན་པར་སྤྱོད་པ་རྣམས་ཀྱིས་མཐོང་བ་བཅོམ་ལྡན་འདས་ཀྱི་དྲུང་ན་རྒྱ་ཆེར་སྣང་བ་མཐོང་ནས་ཐེ་ཚོམ་དུ་གྱུར་ཏེ།",
    "དེ་བས་ན་དགེ་སློང་རྣམས་ཀྱིས་འདི་ལྟར་བསླབ་པར་བྱ་སྟེ།",
    "བཟོད་པའི་ཡོན་ཏན་བརྗོད་པར་བྱ་བ་དེ་ལྟར་དགེ་སློང་དག་ཁྱེད་ཀྱིས་བསླབ་པར་བྱའོ།",
    "བཙུན་པ་བསྙེན་པར་རྫོགས་པར་བགྱིད་ན་ཚེ་དང་ལྡན་པ་རྣམས་བདག་ལ་བསྙེན་པར་རྫོགས་པར་མ་བྱེད་ཅིག་ཅེས་མཆི་བཞིན་དགེ་སློང་རྣམས་ཀྱིས་བསྙེན་པར་རྫོགས་པར་བགྱིས་ན་བསྙེན་པར་རྫོགས་པ་ཞེས་བགྱི་འམ།",
    "བསྙེན་པར་མ་རྫོགས་པ་ཞེས་བགྱི།",
    "ཨུ་པཱ་ལི་བསྙེན་པར་རྫོགས་པ་ཞེས་མི་བྱ་སྟེ།",
    "བསྙེན་པར་རྫོགས་པར་བྱེད་པ་རྣམས་ཀྱང་འདས་པ་དང་བཅས་པར་འགྱུར་རོ།",
    "བསྙེན་པར་རྫོགས་པ་ཉིད་ཀྱང་བསླབ་པ་འབུལ་ན་བསྙེན་པར་མ་རྫོགས་ཞེས་བྱ་ན་བསྙེན་པར་རྫོགས་པར་བྱེད་པའི་ཚེ་ལྟ་ཅི་སྨྲོས།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་ཚུལ་ཕ་རྣམས་ལོ་ཉི་ཤུ་ལོན་ནས་བསྙེན་པར་རྫོགས་པར་བྱོས་ཤིག་ཅེས་གསུངས་ན།",
    "དེ་དགེ་སློང་རྣམས་ཀྱིས་ལོ་གྲངས་མ་རྟོགས་པས་ཐེ་ཚོམ་སྐྱེས་ཏེ་བསྙེན་པར་རྫོགས་པར་མི་བགྱིད་ན་དེ་དག་ལ་ཇི་ལྟར་ནན་ཏན་བགྱི་ཞེས་ཞུས་པ་དང་།",
    "ཨུ་པཱ་ལི་དེ་ལྟ་བུ་ནི་མཚན་ལས་སོ་སོར་རྟོགས་ལ་བསྙེན་པར་རྫོགས་པར་བྱོས་ཤིག།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་ལྟར་མཚན་ལས་རྟོགས་ལ་བསྙེན་པར་རྫོགས་པར་གྱིས་ཤིག་ཅེས་གསུངས་པ་དང་།",
    "དེ་ནི་མཚན་ཁུང་དང་མཚན་ལ་རྟོགས་ཏེ་དེ་སྟེ་ཡོད་ན་བསྙེན་པར་རྫོགས་པར་བྱའོ།",
    "དེ་སྟེ་མེད་ན་བསྙེན་པར་རྫོགས་པར་མི་བྱའོ།",
    "བཙུན་པ་དགེ་སློང་རྣམས་ཀྱིས་དགེ་སློང་ལ་དགེ་སློང་མའི་ལས་ཀྱིས་བསྙེན་པར་རྫོགས་པར་བགྱིས་ན་བསྙེན་པར་རྫོགས་པ་ཞེས་བགྱི་འམ།",
    "བསྙེན་པར་མ་རྫོགས་པ་ཞེས་བགྱི།",
    "ཨུ་པཱ་ལི་བསྙེན་པར་རྫོགས་པ་ཞེས་ནི་བྱ་སྟེ་བསྙེན་པར་རྫོགས་པར་བྱེད་པ་རྣམས་ནི་འདས་པ་དང་བཅས་པར་འགྱུར་རོ།",
    "ཨུ་པཱ་ལི་བསྙེན་པར་རྫོགས་པ་ཞེས་བྱ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གྲོང་དང་ཉེ་བའི་འཁོར་དུ་གསོ་སྦྱིན་བྱོས་ཤིག་ཅེས་གསུངས་པ་དང་།",
    "དེ་ལས་དགེ་སློང་ཕྱེད་ནི་གྲོང་དུ་ཞུགས་ཕྱེད་ནི་ཕྱི་རོལ་དུ་འཁོད་པས་དེ་དག་མ་འདུས་པར་གྱུར་ནས་གསོ་སྦྱིན་མ་བྱས་ཏེ།",
    "སྡོད་ན་འདས་པ་དང་བཅས་པར་འགྱུར་རོ།",
    "དགེ་སློང་རྣམས་གསོ་སྦྱིན་གྱི་ཚེ་གསོ་སྦྱིན་མ་བྱས་པར་མ་འགྲོ་ཤིག།",
    "སེམས་བསྐྱེད་པར་བྱོས་ལ་གསོ་སྦྱིན་བྱིན་གྱིས་རློབས་ཤིག།",
    "དེ་ནས་ཚིག་ཏུ་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "མ་བྱས་ན་འདས་པ་དང་བཅས་པར་འགྱུར་རོ།",
    "བཤགས་ཤིང་མཐོལ་ན་བདག་ལ་བདེ་བར་འགྱུར་གྱི།",
    "མ་བཤགས་མ་མཐོལ་ན་ནི་མ་ཡིན་ནོ།",
    "ཕྱིན་ཆད་སྡོམ་པར་དམ་འཆའ་མ་དམ་འཆའོ།",
    "ལྷ་དེ་ནི་མུ་སྟེགས་གཅེར་བུ་པ་མ་ལགས་ཀྱིས།",
    "དེས་དེ་ལྟར་གྱུར་པ་དགེ་སློང་རྣམས་ལ་རྒྱས་པར་སྨྲས་ནས་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་ཏེ།",
    "འཇིག་རྟེན་པ་ཐམས་ཅད་ཀྱི་གཙོ་བོ་ཡིན་པས་ན་གང་སྨྲས་པ་དེ་ནི་ལེགས་པར་སྨྲས་པ་ཡིན་གྱིས་དེ་ལ་ཐེ་ཚོམ་དུ་མ་བྱེད་ཅིག།",
    "བཙུན་པ་ནོངས་པ་དང་བཅས་པས་ནོངས་པ་དང་བཅས་པའི་མདུན་དུ་ནོངས་པ་བཤགས་སུ་རུང་དམ་ཨུ་པཱ་ལི་མི་རུང་ངོ།",
    "དེས་དེ་ལ་རྒྱས་པར་སྣྲས་པ་དང་།",
    "ཡུལ་གཞན་དུ་དོ་ངལ་དེར་དེ་དག་བཤགས་སོ།",
    "ངས་ནི་བསམ་པ་ལས་ཉེས་པ་ཕྱིན་པར་གསུངས་ཀྱིས་ཆད་པའི་ལས་ཀྱིས་ནི་མ་ཡིན་ནོ།",
    "ཆ་༡ བཟོད་ཤེས་ལྟ་བའི་ཁྱད་པར།",
    "ལས་ཀྱི་སྲིད་པ་སྒྲུབ་པར་བྱེད།",
    "རབ་ཏུ་བསྟན་པ་ཡིན་པར་འདོད།",
    "རྩ་བ་བརྟན་པར་བྱེད།",
    "རྒྱུན་གནས་པར་བྱེད།",
    "ཞིང་དུ་སྒྲུབ་པར་བྱེད།",
    "དམིགས་པ་ལ་ཀུན་ཏུ་རྨོངས་པར་བྱེད།",
    "རྣམ་པར་ཤེས་པའི་རྒྱུན་འཁྲིད་པར་བྱེད།",
    "ཁམས་ལས་མི་འདའ་བའི་ཚུལ་གྱིས་འཆིང་བའི་དོན་དུ་ཁྱབ་པར་བྱེད།",
    "གཞུང་དེ་ཉིད་སྒྲ་ཇི་བཞིན་པར་འཆད།",
    "ཚོར་བ་གསུམ་དང་མཚུངས་པར་མི་ལྡན་པའི་ཕྱིར།",
    "བྱེ་སྨྲའི་རིགས་པ་དེས་དེ་མི་ཁེགས་པར་བསྟན་པ་དང་།",
