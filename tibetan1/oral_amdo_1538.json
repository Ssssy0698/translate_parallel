    "འདི་ལྟར་བདག་གི་རྫས་ནི་ཤོ་གམ་བཀུམ་ལ།",
    "ཁྱོད་ཀྱི་རས་ཡུག་ཆེན་འདི་ནི་ཤོ་གམ་མ་བཀུམ་པས་གལ་ཏེ་ཤོ་གམ་པ་དག་རས་ཡུག་ཆེན་གྱི་ཤོ་གམ་འཚལ་ན་དོན་གྱིས་བདག་ཁོ་ནས་གཞལ་བར་བགྱི་བ་ལགས་པས་ཤོ་གམ་གྱི་གནས་ནས་བཟླས་ཏེ་དབུལ་བར་བགྱིའོ།",
    "དེད་དཔོན་དེས་འཕགས་པ་དག་ནི་མི་མཐུན་པར་བྱེད་པ་ཡིན་པས་འདི་ལ་བདག་གིས་དུས་ཤེས་པར་འགྱུར་རོ་སྙམ་དུ་ཤེས་ནས་དེད་དཔོན་དེས་དགེ་སློང་དེ་ལ་སྨྲས་པ།",
    "འཕགས་པ་དེས་བདག་བྲེལ་བས་ཁྱོད་ཀྱི་བསོད་སྙོམས་འགའ་ཡང་བསྒྲུབ་པར་རྔོ་མི་ཐོག་གིས་བཞུད་ལ་གྲོང་དུ་བསོད་སྙོམས་ལ་འཇུག་པར་མཛོད་ཅིག།",
    "འཕགས་པ་ཁྱོད་ལ་ཤོ་གམ་གཞལ་འཚལ་བའི་རྫས་ཅུང་ཟད་མཆིས་སམ།",
    "བཞིན་བཟངས་ཁོ་བོའི་རས་ཡུག་ཆེན་དེ་མ་བྱིན་པར་ལེན་པ་དག་གིས་བརྐུས་སོ།",
    "འཕགས་པ་དེ་ནི་ཁྱོད་ཀྱིས་མ་བརྐུས་ཀྱི་འདི་ལྟར་བདག་གིས་བརྐུས་པ་ལགས་ཏེ།",
    "དེས་ན་བདག་གིས་ཤོ་གམ་མ་ཐོབ་བོ།",
    "གང་གི་ཚེ་དགེ་སློང་དེ་ཤོ་གམ་གྱི་གནས་ནས་འདས་པ་དེའི་ཚེ་དེད་དཔོན་དེས་སྨྲས་པ།",
    "འཕགས་པ་ཅིའི་སླད་དུ་ཁོ་བོའི་རས་ཡུག་ཆེན་དེ་མ་བྱིན་པར་ལེན་པ་དག་གིས་བརྐུས་སོ།",
    "འཕགས་པ་དེ་ནི་མ་བྱིན་པར་ལེན་པ་དག་གིས་མ་བརྐུས་ཏེ།",
    "འདི་ལྟར་བདག་གིས་ཤོ་གམ་གྱིས་འཇིགས་པས་རང་གི་སྣོད་དུ་སྩལ་ཏེ་འཚལ་ཏེ་མཆིས་ན་ཇི་ལྟར་བགྱི་དབུལ་ལམ།",
    "འཕགས་པ་འདི་ལ་ཁྱོད་ཀྱི་ལུས་ཀྱི་ལས་ཀྱང་མ་མཆིས།",
    "གལ་ཏེ་ཡོད་དོ་ཞེས་བརྗོད་ན་ནི་ངེས་པར་ཤོ་གམ་གཞལ་དགོས་པར་འགྱུར་བས་དེའི་ཕྱིར་གང་གིས་ཤོ་གམ་ཡང་གཞལ་མི་དགོས་ལ་བརྫུན་དུ་སྨྲ་བར་ཡང་མི་འགྱུར་བའི་ཐབས་ཅི་ཡོད་སྙམ་དུ་ཤེས་ནས་དེ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "འཕགས་པ་ཁྱོད་ལ་ཤོ་གམ་གཞལ་འཚལ་བའི་རྫས་ཅུང་ཟད་མཆིས་སམ།",
    "རྒན་པོ་དེ་གང་གི་ཚེ་ཤོ་གམ་གྱི་གནས་ནས་འདས་པ་དེའི་ཚེ་སྨྲས་པ།",
    "ཚེ་དང་ལྡན་པ་ཁོ་བོ་ངལ་བས་ཁྱོད་ལ་བྱིན་པ་ནི་མ་ཡིན་གྱི།",
    "གཞན་ཡང་དགེ་སློང་གིས་ཤོ་གམ་གཞལ་དགོས་པའི་རྫས་ལམ་དུ་བཟླ་བར་མི་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་ཤོ་གམ་གཞལ་དགོས་པའི་རྫས་ལམ་དུ་བཟླ་བར་མི་བྱའོ་ཞེས་བཀའ་སྩལ་པ་ན།",
    "རི་བྲགས་དེ་ན་ཁྱིམ་བདག་ཕྱུག་པ་ནོར་མང་བ་ལོངས་སྤྱོད་ཆེ་བ་ཞིག་འདུག་ཅིང་དེ་ཡང་དད་པ་དང་ལྡན་པ་ཡིན་པས་དེས་དགེ་སློང་དེ་དག་འགྲོན་དུ་བོས་ཏེ་ཟས་བྱིན་ནས་རེ་རེ་ལ་གོས་ཕྲུགས་རེ་བསྐོན་པར་བྱས་པ་དང་།",
    "ཁྱིམ་བདག་བཅོམ་ལྡན་འདས་ཀྱིས་ཤོ་གམ་གཞལ་དགོས་པའི་རྫས་ལམ་དུ་བཟླ་བར་མི་བྱའོ་ཞེས་དགག་པ་མཛད་པས་དེའི་ཕྱིར་བདག་ཅག་གིས་ཇི་ལྟར་བླང་བར་བྱ།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "བདེ་བར་བརྒྱུས་མོད་ཀྱི།",
    "འོན་ཀྱང་ཁྱིམ་བདག་ཅིག་གིས་བདག་ཅག་ལ་ཟན་བྱིན་ཏེ་གོས་ཕྲུགས་རེ་བསྐོན་པར་བྱས་ན།",
    "དེ་ལ་བདག་ཅག་གིས་ཁྱིམ་བདག་བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་ཤོ་གམ་གཞལ་དགོས་པའི་རྫས་ལམ་དུ་བཟླ་བར་མི་བྱའོ།",
    "ཞེས་དགག་པ་མཛད་པས་དེའི་ཕྱིར་བདག་ཅག་གིས་ཇི་ལྟར་བླང་བར་བྱ་ཞེས་མ་བླངས་སོ།",
    "ཆོམ་རྐུམ་པ་དག་གིས་བགྲོད་པར་གྱུར་ཏོ།",
    "བ་ལང་གི་ལྕི་བ་བཙིར་བས་རུང་བར་བྱ་བ་འམ་བཀྲུ་བར་བྱའོ།",
    "དེ་ལ་དགེ་སློང་ཞིག་གིས་རས་ཡུག་ཆེན་བྱིན་ནས།",
    "འཕགས་པ་ཁྱོད་ལ་ཤོ་གམ་གཞལ་འཚལ་བའི་རྫས་ཅུང་ཟད་མཆིས་སམ།",
    "འཕགས་པ་དེ་ནི་ཁྱོད་ཀྱི་བཤེས་པ་མ་ལགས་ཀྱི་འདི་ལྟར་དེ་ནི་བདག་གི་བཤེས་པ་ལགས་ཏེ་དེས་ན་བདག་ལ་ཤོ་གམ་བྱུང་གིས་སྩོལ་ལ་བཞུད་ཅིག།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "དགའ་བོ་ཉེ་དགའ་ལྷུང་བཟེད་ནག་པོ་ཅན་འདི་དག་ནི་རྐང་པ་སྤྲེའུ་ཞག་གིས་བསྐུས་ཏེ།",
    "དེ་དག་གིས་དོན་འཐུན་བཙལ་བར་བརྩམས་པ་དང་།",
    "དེ་དག་གིས་བྱང་ལམ་དུ་འགྲོ་བའི་དོན་འཐུན་མཐོང་ནས་དེའི་དྲུང་དུ་སོང་སྟེ་སྨྲས་པ།",
    "བུད་མེད་ཀྱི་ཡུལ་གནས་ངན་ལེན་ཀུན་དུ་སྤྱོད་པ་ལགས་པས་ཁྱེད་ཅག་དེར་དགྱེས་པར་མི་འགྱུར་རོ།",
    "འཕགས་པ་དག་བདག་ཅག་གིས་ཁྱེད་ལ་དང་པོ་ཁོ་ན་ནས་བྱང་ལམ་ནི་མཐོན་དམན་ཅན།",
    "བུད་མེད་ཀྱི་ཡུལ་གནས་ངན་ལེན་ཀུན་དུ་སྤྱོད་པ་ལགས་པས་ཁྱེད་ཅག་དེར་དགྱེས་པར་མི་འགྱུར་རོ་ཞེས་མ་བགྱིས་སམ།",
    "འཕགས་པ་དག་བདག་ཅག་གིས་ཟོང་མ་བསྒྱུར་ཏེ།",
    "དེ་ལྟ་ལགས་མོད་ཀྱི་འོན་ཀྱང་བདག་ཅག་དང་།",
    "བཤེས་པའི་ཚོང་པ་གཞན་དག་མཆིས་པ་དེ་དག་གིས་ཟོང་བསྒྱུར་བས་དེ་དག་ལ་གཏད་པར་བགྱིས་དེ་དག་དང་ཐབས་གཅིག་བཞུད་ཅིག།",
    "ཇི་ཙམ་ན་ཡུལ་དབུས་ནས་ཕྱིར་འོང་བའི་དོན་འཐུན་འོངས་ནས་ཚོང་པ་དེ་དག་གིས་དོན་འཐུན་ཕྱིར་འོང་བ་དེ་དག་ལ་འོངས་པ་ལེགས་སོ་ཞེས་བརྗོད་པས་སོ་སོར་ཡང་དག་པར་དགའ་བར་བྱས་ཏེ་སྨྲས་པ།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "ཤེས་ལྡན་དག་ཡུལ་དབུས་སུ་ཁེ་སྤོགས་མང་པོ་གྲུབ་མོད་ཀྱི་འོན་ཀྱང་དེ་ན་གོས་དཀར་པོ་ཅན་ཆོམ་རྐུན་པ་ལྟ་བུ་ཤོ་གམ་དང་།",
