    "གལ་ཏེ་གོས་ཁ་དོག་སྣ་ཚོགས་དག་གིས་བཤམས་པ་ཡིན་ན་ཕྱོགས་ཐ་དད་པར་བརྗོད་པར་བྱའོ།",
    "རྐང་གིས་འགྲོ་བ་དང་།",
    "ཟུང་ཁྱོགས་ཀྱི་བཞོན་པ་དང་།",
    "ཁྱོགས་སྤྱིལ་དང་།",
    "དགེ་སློང་གི་རྐུན་སེམས་ཀྱིས་གྲུ་ཕུར་པ་ལ་བཏགས་པ་བསྐྱོད་པར་བྱེད་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "བདག་གིར་ཡང་མ་གྱུར་ཅིག་སྙམ་པས་རྫབ་ཏུ་སྦེད་པར་བྱེད་དམ།",
    "བུ་རམ་ཤིང་གི་ལས་ཀྱི་མཐའ་དང་།",
    "དེ་དག་ལན་འགའ་ནི་ཆུ་ཤིན་ཏུ་མོད་ཅིང་།",
    "དགེ་སློང་གིས་ཆུ་ཤིན་ཏུ་དཀོན་པའི་ཚེ་བདག་གི་འབྱོར་པར་གྱུར་ལ།",
    "གཞན་གྱི་རྒུད་པར་གྱུར་ཅིག་སྙམ་པས་བདག་གི་ས་ལུའི་རྣང་ལ་ཡུར་བ་གཏོང་བར་བྱེད་ཅིང་གཞན་གྱི་ལ་གཅོད་པར་བྱེད་ན།",
    "ཆུ་ཤིན་དུ་མོད་པའི་ཚེ་བདག་གི་འབྱོར་པར་འགྱུར་ལ།",
    "གཞན་གྱི་རྒུད་པར་གྱུར་ཅིག་སྙམ་པས་བདག་གི་ལ་གཅོད་པར་བྱེད་ཅིང་།",
    "བདག་གིར་ཡང་མ་གྱུར་ཅིག་སྙམ་པས་བདག་གི་ལ་ཡང་གཏོང་བར་བྱེད་ཅིང་གཞན་གྱི་ལ་ཡང་གཏོང་བར་བྱེད་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "ས་ལུའི་ལས་ཀྱི་མཐའ་ལ་ཇི་ལྟ་བ་བཞིན་དུ་བུ་རམ་ཤིང་གི་ལས་ཀྱི་མཐའ་དང་།",
    "དེ་ལ་ཟོང་ལྕི་ཞིང་རིན་ལྕི་བ་གང་ཡིན་པ་དེ་དང་ཟོང་ཡང་ཞིང་རིན་ཡང་བ་གང་ཡིན་པ་དེ་གྲུ་གཅིག་ཏུ་བཅུག་པར་གྱུར་པ་ལས་དེ་དག་གི་གྲུ་དེ་རྒུད་པར་གྱུར་ཅིང་འབྱོར་པར་མ་གྱུར་ཏེ་ཟོང་འཕྱོ་བ་ན།",
    "ཤེས་ལྡན་དག་བྱིང་བ་གང་ཡིན་པ་དེ་ནི་ཁོ་བོ་ཅག་གི་ཡིན་ལ།",
    "དགེ་སློང་གིས་ཟོང་བྱིང་བའི་ཕྱིར་ཁྲི་ལས་ལྡང་བར་བྱེད།",
    "གལ་ཏེ་བདེ་བ་མེད་པར་བྱ་བའི་བསམ་པས་དེ་ཡིར་ཡང་མ་གྱུར་ལ་བདག་གིར་ཡང་མ་གྱུར་ཅིག་སྙམ་པས་རྫབ་ཏུ་འཛུད་པར་བྱེད་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "ཟོང་ལྕི་ཞིང་རིན་ཐང་ཡང་བ་གང་ཡིན་པ་དེ་གྲུ་གཅིག་ཏུ་བཅུག་པར་གྱུར་པ་ལས་དེ་དག་གི་གྲུ་དེ་རྒུད་པར་གྱུར་ཅིང་འབྱོར་པར་མ་གྱུར་ཏེ་ཟོང་བྱིང་བ་ན།",
    "ཤེས་ལྡན་དག་འཕྱོ་བ་གང་ཡིན་པ་དེ་ནི་ཁོ་བོ་ཅག་གི་ཡིན་ལ།",
    "བྱིང་བ་གང་ཡིན་པ་དེ་ནི་ཅི་བདེ་ཁོ་ནར་འབྱིན་ལ་རག་གོ་ཞེས་ཐོབ་རྒྱལ་དུ་སྒྲོགས་པར་བྱེད་པ་ན་དགེ་སློང་གིས་ཟོང་འཕྱོ་བའི་ཕྱིར་ཁྲི་ལས་ལྡང་བར་བྱེད།",
    "བདག་གིར་ཡང་མ་གྱུར་ཅིག་སྙམ་པས་རྫབ་ཏུ་འཛུད་པར་བྱེད་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "ཆུའི་གནས་དག་ཏུ་རྫིང་བུ་སྣ་ཚོགས་དག་བྱས་ཤིང་རྫིང་བུ་དེ་དག་ཏུ་རྩེད་མོའི་བྱ་སྣ་ཚོགས་འདི་ལྟ་སྟེ།",
    "སེ་མོ་དོ་དག་དང་།",
    "མུ་ཏིག་གི་ཆུན་པོ་དག་གིས་བརྒྱན་པ་ལ།",
    "དགེ་སློང་གིས་དེ་ལ་སྦྱོར་བས་ཁྲི་ལས་ལྡང་བར་བྱེད།",
    "དུས་ཐམས་ཅད་པ་སྐྱེ་བོ་ཐམས་ཅད་ལས་བསྐྱབས་པ་དག་བསྐྱེད་པ་ལ་དགེ་སློང་གིས་དེ་ལ་སྦྱོར་བས་ཁྲི་ལས་ལྡང་བར་བྱེད།",
    "དུས་ཐམས་ཅད་པ་སྐྱེ་བོ་ཐམས་ཅད་ལས་བསྐྱབས་པ་དག་བསྐྱེད་པ་ལ་དགེ་སློང་གིས་དེ་ལ་སྦྱོར་བས་ཁྲི་ལས་ལྡང་བར་བྱེད།",
    "མེ་ཏོག་གི་ཤིང་ལ་འཛེག་པར་བྱེད།",
    "ཚུལ་མ་ཡིན་པས་སྡུག་བསྔལ་བར་བྱ་བའི་ཕྱིར་རྔོན་སྤྱད་བཙུགས་པ་ལ་དགེ་སློང་གིས་རྐུ་སེམས་ཀྱིས་རྔོན་སྤྱད་རྐུ་བར་བྱེད་ན་རྔོན་སྤྱད་ཀྱི་རིན་ཐང་བརྩི་བར་བྱ་ཞིང་དངོས་པོ་ཚང་ན་ཕམ་པར་འགྱུར་ལ།",
    "བདག་གིར་ཡང་མ་གྱུར་ཅིག་སྙམ་པས་སྲེག་པར་བྱེད་དམ།",
    "དགེ་སློང་གིས་རྔོན་སྤྱད་ལ་ཐོགས་པའི་རི་དགས་རྐུ་བར་བྱེད་ན།",
    "བདག་གིར་ཡང་མ་གྱུར་ཅིག་སྙམ་པས་གཏོང་བར་བྱེད་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "ཚུལ་མ་ཡིན་པས་སྡུག་བསྔལ་བར་བྱ་བའི་ཕྱིར་ཉ་སྡང་བཙུགས་པ་ལ་དགེ་སློང་གིས་རྐུ་སེམས་ཀྱིས་ཉ་སྡང་རྐུ་བར་བྱེད་ན་ཉ་སྡང་གིས་རིན་ཐང་བརྩི་བར་བྱ་ཞིང་དངོས་པོ་ཚང་ན་ཕམ་པར་འགྱུར་ལ།",
    "བདག་གིར་ཡང་མ་གྱུར་ཅིག་སྙམ་པས་སྲེག་པར་བྱེད་དམ།",
    "དགེ་སློང་གིས་ཉ་སྡང་ལ་ཐོགས་པའི་ཉ་རྐུ་བར་བྱེད་ན་ཉའི་རིན་ཐང་བརྩི་བར་བྱ་ཞིང་དངོས་པོ་ཚང་ན་ཕམ་པར་འགྱུར་ལ།",
    "བདག་གིར་ཡང་མ་གྱུར་ཅིག་སྙམ་པས་གཏོང་བར་བྱེད་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "དགེ་སློང་གིས་རྐུ་སེམས་ཀྱིས་མིའི་སྐལ་བའི་ཆུ་བདག་གིར་བྱེད་ན།",
    "གལ་ཏེ་དུད་འགྲོའི་སྐལ་བའི་ཆུ་བདག་གིར་བྱེད་ན།",
    "འདི་ལྟར་འཛམ་བུའི་གླིང་པའི་ཚོང་པ་རབ་ཏུ་མང་པོ་ནོར་སྒྲུབ་པ་དག་རྒྱ་མཚོའི་གྲུར་ཞུགས་ཏེ་རྒྱ་མཚོ་ཆེན་པོར་འཇུག་པ་ན་རྒྱ་མཚོ་ཆེན་པོ་ལན་ཚྭའི་རོ་འབའ་ཤིག་ཡིན་པས་དེ་དག་གིས་དེར་སྣོད་སྣ་ཚོགས་འདི་ལྟ་སྟེ།",
    "དགེ་སློང་གིས་རྐུ་སེམས་ཀྱིས་མིའི་སྐལ་བའི་ཆུ་བདག་གིར་བྱེད་ན།",
    "གལ་ཏེ་དུད་འགྲོའི་སྐལ་བའི་ཆུ་བདག་གིར་བྱེད་ན།",
    "སྟེང་གི་གཞིར་འཛེག་པ་དང་།",
    "དེ་ནས་ཡང་འབབས་ཤིང་འོག་གི་གཞིར་འབབ་པ་དང་།",
