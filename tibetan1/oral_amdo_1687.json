    "རྫོགས་པའི་རིམ་པ་ལ་ཕྲ་མོའི་རྣལ་འབྱོར་དང་།",
    "གཉིས་པ་ཡེ་ཤེས་སྐྱེ་ཚུལ་གྱི་ཐབས་གཏུམ་མོ་སྦར་བ་ནི།",
    "རྐང་ལག་གི་མཐེ་བོང་བསྐུམ།",
    "དེ་དག་གིས་ནི་ནང་དང་གསང་བའི་བསྐྱེད་རིམ་རྒྱུད་ལས་བསྟན་ཚུལ་དང་།",
    "དེ་ཡང་ཡེ་ཤེས་ཀྱི་རང་བཞིན་བློའི་ཡུལ་ལས་འདས་ཤིང་རང་གི་ངོ་བོས་སྟོང་པ་བདེ་སྟོང་ཟུང་དུ་འཇུག་པའི་རྫོགས་རིམ་ཟབ་མོའི་རྩིས་ཟིན་པར་བྱས་ནས།",
    "འབྲས་བུའི་ས་མངོན་དུ་བྱེད་པ་ལ་མོས་པས་མོས་པ་སྤྱོད་པའི་ས་ཡང་ཐོབ་པ་ཡིན་ལ།",
    "ངག་གི་སྒྲས་འགྲོ་དོན་དངོས་སུ་བྱེད་ལ།",
    "ཚེ་དེ་ཉིད་ལ་མཆོག་གི་འབྲས་བུ་མངོན་དུ་བྱེད་པས།",
    "ཧེ་རུ་ཀ་རིགས་ལྔ་གང་རུང་གི་རིག་འཛིན་བས་ན།",
    "ས་མོས་པས་སྤྱོད་པ།",
    "ཀུན་བཟང་རིགས་ལྔ་གང་རུང་གི་རིག་འཛིན་བས་ན།",
    "ནང་གི་རྩ་ཁམས་ལ་གནས་པའི་དཔའ་བོ་དང་མཁའ་འགྲོ་མ་རྣམས་ཞལ་དངོས་སུ་མཐོང་།",
    "རིགས་ཅན་གསུམ་ལ་མཆོག་གི་སྤྲུལ་པའི་སྐུ་དང་།",
    "དེ་དག་གིས་ནི་ནང་དང་གསང་བའི་བསྐྱེད་རིམ་རྒྱུད་ལས་བསྟན་ཚུལ་དང་།",
    "ཕུར་པ་བཏབ་པས་གྲམ་པར་སྐྱ་གསོབ་ཀྱིས་སོང་ཞིང་།",
    "སླར་ཆུ་བོ་སྔར་བས་ཀྱང་ཆེར་སོང་བ་ལ་སོགས་པ་གྲུབ་པ་བརྙེས་པའི་རྟགས་ཇི་ལྟར་བསྟན་པ་དང་།",
    "དེ་སྐབས་ཡར་ལྡོང་གི་ཚོང་པ་མང་པོ་ཡོང་པའི་ཚོང་ལྷ་རྒྱལ་པོ་ཤེལ་གིང་གིས་བྱེད་པ་ལས།",
    "སྤྱང་ཁུ་བཅུ་བཞི་པོ་ཐམས་ཅད་སྒྲུབ་ཁང་གི་ཐོག་ན་མར་རི་ཉིལ་བ་ལྟར་བྱུང་སྟེ་རྒྱལ་པོ་ཤེལ་གིང་སྐད་ཅིག་དེ་ཉིད་ལ་ཚར་བཅད་པ་ལྟ་བུ་གྲུབ་པ་བརྙེས་པའི་རྟགས་ཇི་ལྟར་བསྟན་པ་དང་།",
    "འཁོན་སྟོན་བལ་པོ་ཞེས་བྱ་བས་ཚ་མོ་རོང་གླང་གི་བྲག་ཕུར་རི་ཞེས་བྱ་བའི་བྲག་ཕུག་ཏུ་རྡོ་རྗེ་གཞོན་ནུའི་སྒྲུབ་པ་མཛད་པས་ཞལ་མངོན་སུམ་དུ་གཟིགས་པ་ལ་སོགས་པ་གྲུབ་པ་བརྙེས་པའི་རྟགས་ཇི་ལྟར་བསྟན་པ་དང་།",
    "ལྷོ་རོང་གི་སའི་ཆ་པ་ཏྲོ་སྟག་ཚང་སེངྒེ་བསམ་གྲུབ་ཀྱི་གནས་མཆོག་ཏུ་ཕྱག་ཕེབས་པར་བརྩམས་ཏེ་ལྷོ་རོང་ཕྱོགས་སུ་ཆིབས་ཁ་བསྒྱུར་བའི་ཚེ།",
    "ལྷོ་རོང་གི་ས་ཡུལ་ཐམས་ཅད་ཞབས་ཀྱིས་འཆག་པར་མཛད་དགོས་ཤིང་།",
    "ཞེས་ཁས་བླངས་སོང་བས།",
    "སྟག་ཚང་གི་འཕྲང་ཟིན་པར་ཕེབས་པའི་ཚེ།",
    "དེའི་དབུས་ནས་འཇའ་ཁ་དོག་སྔོན་པོ་ཞིག་རྒྱང་གིས་བྱུང་བ།",
    "དེའི་ཚེ་འཕྲང་དེའི་གཡས་གཡོན་གྱི་ལྗོན་ཤིང་གི་ཚོགས་ལ་བརྟེན་པའི་སྤྲ་དང་སྤྲེའུ་ལག་ན་ཤིང་གི་ཡལ་ག་ཐོགས་པ་མང་པོས།",
    "དེའི་དབུས་འོད་དཀར་པོ་ཞིག་གི་ཁྲོད་ན།",
    "དེའི་ཚེ་སྔགས་འཆང་ཉིད་ཀྱི་སྟག་ཚང་གི་ཕུག་པའི་གཡས་འཁྲིས་ན།",
    "སྐད་ཅིག་ཉིད་ལ་ཐུགས་ལ་ཐ་མལ་གྱི་རྣམ་རྟོག་གི་ཆ་ཤས་ཅུང་ཟད་ཡོད་པ་ཐམས་ཅད་ཁྲིག་འགགས་ནས།",
    "སློབ་དཔོན་ཡང་འོད་དུ་ཞུ་ལ་ཁད་འདུག་པ་གཟིགས་པས།",
    "སློབ་དཔོན་ཆེན་པོའི་སྐུ་དེ་སྔར་ལས་གསལ་བར་གྱུར་པའི་མོད་ལ།",
    "གདམས་པ་ཟབ་མོ་དང་ལུང་བསྟན་རབ་ཏུ་མང་པོ་གནང་ཞིང་།",
    "སྔགས་འཆང་ཉིད་ཀྱི་སྐུ་ལ་ཐིམ་པའི་ཐུགས་ཉམས་ཤིན་ཏུ་གསལ་བར་བྱུང་བའི་མོད་ལ།",
    "རེ་ཞིག་དེའི་ངང་ལ་འཇམ་སྟེ།",
    "ཉི་མ་ཡང་ཕྱི་མོར་སོང་འདུག་པས་མྱུར་དུ་བཞེངས་ནས།",
    "དཔལ་བཟང་དང་ཀུན་བཀྲས་བྱས་འགྱུར་སྒྲུབ་ཆེན་དགེ་སློང་ཀུན་དགའ་བ་རྣམས་ལ་སྔགས་འཆང་ཉིད་སྐུ་དངོས་ཀྱི་གསུང་ལས་ལྷོ་རོང་གི་པ་ཏྲོ་སྟག་ཚང་འདི་སློབ་དཔོན་གྱི་བྱིན་གྱིས་བརླབས་པའི་གནས་ཡིན་ངེས་སུ་འདུག་པས་ངོ་མཚར་ཡ་མཚན་ཅན་འདི་ལྟར་བྱུང་ཞེས་བཀའ་ཕེབས་གནང་བའི་གསུང་རྒྱུན་མ་ཉམས་པ་འཇམ་དབྱངས་སྐུ་མཆེད་སོགས་ལས་ཐོས་པ་དང་།",
    "ངེད་རང་གི་ཁ་སྐོང་དུ་སྦྱར་བའི།",
    "ཟ་ཉལ་འཆག་གི་རྣལ་འབྱོར་ལུས་སེམས་བདེ།",
    "དར་ནག་གི་གོས་གསེར་གྱི་ཐིག་ལེ་ཅན་ལ་སྦྲུལ་གྱི་སྐེ་རགས་བཅིངས་ཤིང་ཁྲམ་ཤིང་སྐེད་ལ་བཙུགས་པ་ཅིག་འདུག་པ་དེ་གཉིས་གསལ།",
    "ཆེན་པོ་འགའ་ཞིག་གི་སྲོག་བསྐྱབ་པའི་ཕྱིར་ལྷོ་ཕྱོགས་ཀྱི་བརྒྱུད་དུ་ཆིབས་ཀྱི་ཁ་ལོ་བསྒྱུར་སྐབས་ཤིན་ཏུ་གྲང་བའི་རེག་བྱས་ཉམས་ཐག་པར་བྱེད་པའི་བསིལ་བའི་ངད་ཆེན་པོ་དང་ལྡན་པའི་རི་བོ་ག་ལ་བ་དེར།",
    "རི་དྭགས་རྐྱང་ལ་སོགས་པ་རྣམས་ཀྱང་གྲང་བའི་ངད་ཀྱིས་ལུས་རེངས་ཤིང་ཡན་ལག་རྣམས་འཁོང་པར་བྱེད་པས་ན།",
    "དེང་སང་གི་དུས་འདི་དགུན་སྟོད་གྲང་བའི་དུས་ལ་བབ་ཅིང་།",
    "དབྱར་གྱི་དུས་རོང་གི་ལུང་པར་སླེབས་པ་ལྟ་བུའི་ཤིན་ཏུ་དྲོ་བའི་རེག་བྱ་དང་ལྡན་ཞིང་།",
    "དུས་རེ་ཞིག་སྐུའི་ཆ་ལུགས་སྔགས་ཆས་འདི་ཁ་གནང་ཚེ་གང་ས་ནས་ལེགས་ཚོགས་ཆེ་བ་ཡོད་སྣང་ལགས་པ་དང་།",
    "དེ་མཐུན་ཐུགས་དམ་ཐམས་ཅད་ཀྱི་སྔོན་ལ་བརྒྱ་རྩ་རེ་གནང་ཚེ་འཕྲལ་འཕྲལ་དངས་སྐྱེད་ཆེ་བ་ཡོད་ལགས་པ་དང་།",
    "དེ་ལྟར་གྲང་བའི་ངད་ལྡན་གྱི་རི་བོ་དྲོ་བའི་རེག་བྱ་དང་ལྡན་པར་མཛད་པ་ནི།",
    "གཞན་ཡང་ཐུན་མོང་མ་ཡིན་པའི་གདུལ་བྱ་འགའ་ཞིག་ལ།",
    "གཞན་ཡང་སྐབས་འདིར་རང་གི་སྲུང་མ་གང་བྱེད་ཀྱི་བསྐུལ་བྱ་བར་གསུངས་པས།",
