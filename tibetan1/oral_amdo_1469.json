    "མཐེ་བོ་གཉིས་ནི་སྐྱིལ་མོ་ཀྲུང་།",
    "གུང་མོའི་རྩེ་མོ་བསྙམས་པ་སྟེ།",
    "གུང་མོ་གཉིས་རྩེ་སྤྲད་དེ་བསྒྲེང་བའོ།",
    "མཛུབ་མོ་དག་ནི་རྩེ་མོ་དགུག།",
    "མཛུབ་མོ་གཉིས་རྩེ་སྤྲད་དེ་ཟླུམ་པོར་དགུག་པ་གུང་མོའི་ངོས་ལ་བཅར་བའོ།",
    "དེ་ནས་བདག་ཉིད་དེ་བཞིན་གཤེགས་པར་གྱུར་པ་ཞེས་པ་ནི་གོང་དུ་གསུངས་པའི་བྱིན་གྱིས་བརླབ་པའི་རིམ་པ་དེས་བྱིན་གྱིས་བརླབས་པས་བདག་ཉིད་དེ་བཞིན་གཤེགས་པ་གང་ལ་མོས་པ་བསྐྱེད་པ་དེའི་སྐུར་གྱུར་པ་དེ་གདན་སེང་གེའི་ཁྲི་ལ་བཞུགས་པར་བརྟག་གོ།",
    "ལག་པ་གཉིས་སོར་མོ་རྡོ་རྗེ་བཅིངས་པ་བསྡམས་པ་ལས་མཐེ་བོང་གཉིས་བསྙམས་ཏེ།",
    "གཤིབས་ལ་རྩེ་མོ་ཅན་དུ་བྱས་ལ་མཐེ་བོ་རྩེ་མོ་ཐད་ཀ་དེའི་སྟེང་ཙམ་དུ་མཛུབ་མོ་གཉིས་ཕན་ཚུན་རྩེ་སྤྲད་དེ།",
    "རང་གི་ལྕེའི་སྟེང་དུ་ཟླ་བའི་དཀྱིལ་འཁོར་དམིགས་པའི་དབུས་སུ་ཐུགས་ཀྱི་མཚན་མ་རྡོ་རྗེ་རྩེ་ལྔ་པ་ནས་འབྲུའི་ཚད་ཙམ་བསམས་ལ།",
    "དེ་བཞིན་གཤེགས་པ་གང་ཡང་རུང་བའི་ཞེས་པ་ནི་དེ་བཞིན་གཤེགས་པ་ལྔ་པོ་རང་བརྗོད་པ་དག་ལས་གང་ལ་མོས་པར་བྱས་པའི་བསམ་གཏན་ལ་གནས་པ་དེའི་སྐུར་མོས་པར་བྱས་ལ།",
    "རྡོ་རྗེ་ཉི་མའི་བར་ལ་ཐུག་གི་བར་དུ་བྱིན་གྱིས་བརླབ་པ་ལ་ནི།",
    "རང་གི་སྔགས་དང་རིག་པ་བཟླས།",
    "ཀུན་དང་ཐུན་མོང་དུ་གྱུར་པ་མ་ཡིན་པས་ན་གསང་བ་ཞེས་བྱའོ།",
    "དེ་དག་གི་གླུ་ཚིག།",
    "དེ་གང་ཞིག་གིས་རྣལ་འབྱོར་གྱིས་རྟོགས་པར་བྱེད་པའི་ཐབས་ནི།",
    "དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་དམ་ཚིག་གི་སེམས་དཔའ་ཆེན་པོ་དང་།",
    "སེམས་དཔའ་ཆེན་པོ་གང་ལ་མོས་པར་སྦྱོར་བ་བྱས་པ་དེ་བཞིན་དུ་བདག་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "དེ་ལ་རེ་ཞིག་དང་པོར་རྣལ་འབྱོར་པ་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཨོཾ་བཛྲ་ཨཉྫ་ལི་ཞེས་བྱ་བ་རྡོ་རྗེ་ཐལ་མོ་སྦྱར་བ་དང་།",
    "དེ་དག་གི་ཕྱག་རྒྱའི་རིམ་པར་བཅིང་བའོ།",
    "རྒོལ་བ་པ་ན་རེ།",
    "དེ་ཡང་དེ་བཞིན་གཤེགས་པའི་དམ་ཚིག་གི་སེམས་དཔའ་དང་།",
    "ཡིད་རང་གི་ལུས་ལ་དམིགས་པར་བྱ་སྟེ་ཞེས་པ་ནི་ཡིད་ཀྱི་ཕྱི་རོལ་དུ་འཇུག་པ་དགག་སྟེ་ནང་དུ་ཕྱོགས་པར་བྱ་བའི་ཕྱིར་བསྡུ་བ་ལ་ནི་ཡིད་རང་གི་ལུས་ལ་དམིགས་པར་བྱ་སྟེ།",
    "སོར་མོ་རྣམས་ཀྱི་རྩེ་མོ་རྡོ་རྗེ་བཅིང་བ་དེ་བཞིན་དུ་སྟོང་པ་ཉིད་ཀྱི་རྡོ་རྗེ་རྣམ་པར་མི་རྟོག་པ་སྟེ།",
    "དེ་ནས་སྐྱེ་བོ་མཐའ་དག་གི་སྡུག་བསྔལ་དང་།",
    "རབ་ཏུ་གསལ་ཞིང་དང་བར་བསམ་མོ།",
    "དེ་ལུས་དང་ཆ་བྱད་དང་རྒྱན་དང་ཆ་ལུགས་མཐུན་པར་བདག་དམ་ཚིག་གི་སེམས་དཔའ་ཆེན་པོར་གྱུར་པར་བརྟགས་ཏེ།",
    "དེ་རྗོད་པར་བྱེད་ཅིང་རང་གིས་རྟོགས་པའི་ཡེ་ཤེས་ཀྱི་ཟླ་བ་དེ་ཉིད་ཅེས་པ་ནི།",
    "འཇིག་རྟེན་གྱི་ཟླ་བ་ཡང་ཡོད་མོད་ཀྱི་དེ་ལས་ཁྱད་པར་དུ་གྱུར་པར་བསྟན་པའི་ཕྱིར་ན་ཡེ་ཤེས་ཀྱི་ཟླ་བའོ།",
    "ཟླ་བ་དེ་ཉིད་འོད་ཟེར་འཕྲོ་བ་དང་འདུ་བའི་ཚུལ་གྱིས་དམ་ཚིག་གི་ཕྱག་རྒྱར་གནས་པར་བརྟག་པ་སྐད་ཟེར་མོད་ཀྱི།",
    "འོད་ཟེར་འཕྲོ་བ་དང་འདུ་བའི་ཚུལ་གྱིས་དམ་ཚིག་གི་ཕྱག་རྒྱའི་མཚན་ཉིད་གང་འདོད་པ་དེར་བརྟག་པར་བྱའོ།",
    "རྡོ་རྗེ་དང་ཞེས་པ་ནི་སེམས་དཔའ་ཆེན་པོ་རྡོ་རྗེ་སེམས་དཔའི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་མཚན་ཉིད་དེ་མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་འཇོམས་པར་བྱེད་པའི་མཐུ་དང་ལྡན་པའོ།",
    "སེམས་དཔའ་ཆེན་པོ་རྡོ་རྗེ་རིན་ཆེན་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "སེམས་དཔའ་ཆེན་པོ་རྡོ་རྗེ་ལས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "སོགས་པའི་སྒྲས་ནི་སེམས་དཔའ་ཆེན་པོ་ལྷག་མ་རྣམས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་བསྡུ་བར་བྱའོ།",
    "རང་གི་རིགས་ལས་གསུངས་པའི་ཞེས་པ་ནི།",
    "སེམས་དཔའ་དེ་དག་རང་རང་གི་རང་གི་རིགས་གང་ཡིན་པ་དེའི་ཁ་དོག་དང་འོད་མདངས་ལ་སོགས་པའི་རྣམ་པ་འོག་ནས་འཆད་པ་དེ་བཞིན་དུ་གསལ་བར་བརྟག་པ་སྟེ།",
    "འདིར་དེ་དག་གི་གཅོ་བོར་གྱུར་པ་རང་རང་གི་རིགས་ཀྱི་འཁོར་ལོས་སྒྱུར་བ་བཞི་ཁོ་ནའི་བསྟན་ཏེ།",
    "རང་གི་ལྷའི་བྱེ་བྲག་ཇི་ལྟ་བ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་ཀྱི་རང་གི་ངོ་བོ་ཡང་བྱ་བ་ལ་སོགས་པ་དག་སྟེ།",
    "རྡོ་རྗེ་རྩེ་ལྔ་ནི་རྡོ་རྗེ་སེམས་དཔའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་ལྕགས་ཀྱུ་ནི་རྡོ་རྫེ་རྒྱལ་པོའི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "སོགས་པས་ནི་སེམས་དཔའ་ལྷག་མ་རྣམས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་མཚན་ཉིད་དང་རྣམ་གྲངས་སྡུད་པར་བྱེད་པ་སྟེ།",
    "དེ་དག་གི་ཁ་དོག་དང་གཟུགས་དང་ཞེས་པ་ནི།",
    "དང་པོར་སྦྱོར་བ་ཇི་ལྟར་བསམ་པའི་རྡོ་རྗེ་དང་ལྕགས་ཀྱུ་ལ་སོགས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱར་བརྟག་པར་བྱའོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་ཇི་ལྟར་བརྟགས་པའི་མཚན་ཉིད་དེ་དང་བདག་དབྱེར་མེད་པར་དམིགས་ཏེ།",
    "བདག་གང་ཡིན་པ་ཡང་དམ་ཚིག་གི་ཕྱག་རྒྱ་གང་ལྟར་བརྟག་པའི་མཚན་ཉིད་དུ་སྣང་བ་དེ་ལ་དམ་ཚིག་གི་ཕྱག་རྒྱ་གང་ཡིན་པ་དེ་ཡང་བདག་ཁོ་ན་སྟེ།",
    "བདག་དང་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ནི་སོ་སོ་མ་ཡིན་པ་ཐ་མི་དད་པར་མོས་པར་བྱ་བ་སྟེ།",
    "དམ་ཚིག་གི་པདྨ་བདག་གོ་ཞེས་པ་ཡང་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྡོ་རྗེ་ལ་སོགས་པའི་མཚན་ཉིད་རྣམས་ལས་སོ་སོའི་གཟུགས་སུ་བསྒྱུར་བའི་ཐབས་བསྟན་པ་དེ་ཡང་རྒྱུད་འདི་ཉིད་དང་གཞན་དག་ལས་གསུངས་ཏེ།",
    "ཞེས་པ་ནི་ཐོག་མ་མེད་པའི་དུས་ནས་རྣམ་པ་སྣ་ཚོགས་སུ་རྟོག་པའི་སེམས་ལས་དང་ཉོན་མོངས་པའི་བག་ཆགས་ཀྱི་དྲི་མ་ཅན་དུ་བྱས་པའི་སེམས་དཔའ་ཆེན་པོ་བརྟན་པའི་ཕྱིར་ན་སེམས་དཔར་བརྗོད་ཅེས་པ་ནི་དྲི་མ་དེ་དག་ཤེས་རབ་རྣམ་གསུམ་གྱི་སྒོ་ནས་སྦྱངས་ཏེ།",
    "གཞན་གང་གི་རྣམ་པས་ཀྱང་བསྐྱོད་པར་མི་ནུས་པས་ན་བརྟན་པ་སྟེ།",
    "དེ་དག་གིས་གང་དེ་བཞིན་དུ་བྱེད་ཅེ་ན།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱའི་མཚན་ཉིད་དུ་གནས་པར་བརྟགས་པའི་ངོ་བོ་དེ་ལའོ།",
    "བདག་དང་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཞེས་དབྱེར་མེད་པའི་ངོ་བོ་བས་ན།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་གང་གི་ངོ་བོར་བརྟགས་པའི་གཟུགས་དེ་ལ་དེ་བཞིན་གཤེགས་པའི་ཚོགས་སྤྱན་དྲངས་ནས་གཞུག་པར་བྱ་བ་སྟེ།",
    "དེ་ལྟ་བུ་མ་ལུས་པ་དག་གིས་དོན་བསྡུས་ཏེ་གྲངས་བགྲང་དུ་མེད་པས་ན།",
    "ཐུགས་རྡོ་རྗེ་དབྱིངས་ཇི་སྙེད་པ་དེ་དག་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ལ་ཞུགས་པས་སྔར་བསྟན་པ་བཞིན་དུ།",
    "བདག་གི་ལྷའི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་གཟུགས་ཞེས་པ་ནི།",
    "བདག་ཉིད་མོས་པར་གྱུར་པའི་ལྷ་ནི་བདག་གི་ལྷའོ།",
    "དེའི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་གཟུགས་ནི་རྡོ་རྗེ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་རྡུལ་སྙེད་པོ་ཐམས་ཅད་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་རྡོ་རྗེ་དབྱིངས་འདུས་པ་ལས་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་དམ་ཚིག་གི་སེམས་དཔའ་ཆེན་པོ་རྣམས་ཀྱི་སྐུ་འགྲུབ་པར་གྱུར་ཏོ་སྙམ་དུ་ང་རྒྱལ་བྱའོ།",
    "དེའི་རིགས་ཀྱི་སེམས་དཔའ་རྣམས་ཀྱང་དེ་དང་དབྱེར་མེད་པ་ནི་ཡིན་གྱིས་ཀྱང་།",
    "མིང་གི་ཆ་ཤས་ཀྱིས་ཚོད་ལྟར་མ་ཡིན་པས་ན།",
    "དེ་ནས་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་དམ་ཚིག་གི་སེམས་དཔའ་ཆེན་པོ་སྐུ་ཕྱག་རྒྱ་ཆེན་པོ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་སྦྱོར་བ་འདི་ལྟར་བྱ་བ་སྟེ།",
    "ཨོཾ་ས་མ་ཡ་སྟྭཾ་ཞེས་བརྗོད་པ་ནི་དམ་ཚིག་གི་སེམས་དཔར་སྐུ་བསྐྱེད་པའི་སྔགས་སོ།",
    "ཇི་ལྟར་བསམས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་ཅེས་པ་ནི།",
    "ཐུགས་ཡེ་ཤེས་ཆེན་པོའི་བདག་ཉིད་ཀྱི་མཚན་མར་གྱུར་པ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བས།",
    "འཕྲོ་འདུའི་ཚུལ་ནི་དང་པོར་འོད་ཟེར་འཕྲོ་བའི་དུས་ན་སྐུ་མང་པོ་དག་ཕྱོགས་བཅུར་འཕྲོས་ནས་དེ་ན་གནས་པའི་འགྲོ་བ་ཇི་སྙེད་པ་དག་གི་དོན་མཛད་པ་བཅུ་གཉིས་སམ་ཉི་ཤུ་རྩ་གཅིག་དང་ལྡན་པའི་ཚལ་དུ་མཛད་ནས།",
    "སྐུ་དེ་དག་སླར་འདུས་པ་ལས་དམ་ཚིག་གི་ཕྱག་རྒྱ་ལ་ཐིམ་པ་ལས།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་དང་བཅས་པར་འོད་དུ་ཞུགས་པ་ལས་ཀྱང་ཕྱག་རྒྱ་ཆེན་པོ་ཡོངས་སུ་རྫོགས་པའི་སྐུར་གྱུར་པར་བརྟག་གོ།",
    "དེ་བས་རང་གི་ལྷའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ལས་ཞེས་པ་ནི།",
    "རང་གང་ལ་མོས་པའི་སེམས་དཔའ་ཆེན་པོ་ནི་རང་གི་ལྷ་སྟེ།",
    "དེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི།",
    "དེ་ལས་གྱུར་པའི་དེ་ཉིད་ཀྱི་ལྷའི་གཟུགས་སུ་དེ་ལྟར་མོས་པར་བྱས་ན་དེ་བཞིན་དུ་འགྱུར་ཏེ།",
    "སོ་སོའི་དམ་ཚིག་གི་ཕྱག་རྒྱའི་མཚན་ཉིད་ལས་སེམས་དཔའ་ཆེན་པོ་རྣམས་ཀྱི་སྐུར་གྱུར་པ་སྟེ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་ཆེན་པོ་སྒྲུབ་པའི་ཕྱིར་དམ་ཚིག་གི་སེམས་དཔའ་སྦྱོར་བ་བྱས་པའོ།",
    "དམ་ཚིག་གི་སེམས་དཔའ་དེ་ལ་ཡེ་ཤེས་ཀྱི་སེམས་དཔའ་གཞུག་པར་བྱ་བ་སྟེ།",
    "མོད་ཀྱི་ཞེས་པ་ཐེ་ཚོམ་ཟ་བའི་ཚིག་སྟེ།",
    "ཁྱོད་ཀྱི་དགའ་བའོ་ཞེས་སྟོན་པ་སྟེ།",
    "རང་གི་ལྷའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ཏེ་ཞེས་པ་ནི།",
    "རང་གང་གི་བསམ་གཏན་མངོན་དུ་བྱས་པ་དེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "ཇི་ལྟར་ཡེ་ཤེས་ཀྱི་སེམས་དཔའ་ཆེན་པོ་རྣམས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་འོག་ནས་འཆད་པ་ལས་གང་ཡིན་པ་དེ་བཅིངས་ནས་རང་གི་ཕྱག་རྒྱའི་སེམས་དཔར་མོས་པར་བྱ་སྟེ།",
    "དམ་ཚིག་ཁྱོད་ནི་བདག་གོ་ཞེས་པའམ།",
    "དེ་ནས་རང་གི་ཕྱག་རྒྱའི་དམ་ཚིག་གི་སེམས་དཔར་བདག་ཉིད་བསྒོམས་ནས་ཞེས་པ་ནི།",
    "གང་དུ་བསྟན་པའི་སྔགས་དང་ཕྱག་རྒྱས་བདག་ཉིད་དམ་ཚིག་གི་སེམས་དཔར་བསྒོམས་ནས།",
    "རང་གི་ཕྱག་རྒྱ་སེམས་དཔའ་བདག་བསྒོམས་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྒྱུད་ཀྱི་གཏན་ཚིགས་སོ།",
    "གཞན་དག་ན་རེ་རྣམ་པ་ལྔའི་ཚུལ་གྱིས་སྐུ་ཕྱག་རྒྱ་ཆེན་པོ་ཡོངས་སུ་སྦྱོར་བར་བྱས་པ་ཁོ་ནས་ཆོག་སྟེ།",
    "འོ་ན་ཡང་རྒོལ་བ་པ་ན་རེ།",
