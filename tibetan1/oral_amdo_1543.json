    "རྗེའི་སྲས་ཁྱོད་བདེན་སྨྲ་ལ་ཡང་ཐུགས་མི་ཆེས་སམ།",
    "བུ་ཁྱོད་ཀྱི་མ་ཡར་མོ་འདིས་སྐྱེས་པ་གཞན་དང་ལྷན་ཅིག་དགའ་མགུར་སྤྱོད་པ་བདེན་ནམ།",
    "བུད་མེད་ཀྱི་ཡུལ་ནི་མ་བསླབས་པར་མཁས་པ་ཡིན་པས་དེས་དེའི་ཁ་ལག་པས་བཀབ་ནས་སྨྲས་པ།",
    "ཀུན་ཏུ་ཡང་བདེན་སྨྲ་དེས་མ་ཡར་མོ་ལ་ཡང་དག་པ་མ་ཡིན་པས་སྐུར་བས་དེ་ནི་བདེན་སྨྲ་མ་ཡིན་གྱི་བརྫུན་དུ་སྨྲ་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་སྒྲས་ཁྱབ་པར་གྱུར་ཏེ།",
    "ཁྱོད་ཉེས་པར་སྤྱོད་པ་ཡིན་གྱིས།",
    "ཁྱོད་ཁོ་བོའི་ཁྱིམ་ན་མ་འདུག་ཤིག།",
    "ཞེས་སྨྲ་མོད་ཀྱི་འོན་ཀྱང་འཇིག་རྟེན་དག་ཚིག་ངན་སྨྲ་བས་འཇིགས་ནས་ཁྱིམ་ནས་བསྐྲད་པ་དང་།",
    "དེ་མ་རངས་བཞིན་དུ་མིང་པོ་གཉིས་ཀྱི་ཁྱིམ་དུ་སོང་ངོ།",
    "སྲིང་མོ་ཁྱོད་ཅིའི་ཕྱིར་འདིར་འོངས།",
    "བདག་ཁྱིམ་ཐབ་ཀྱིས་རང་གི་ཁྱིམ་ནས་བསྐྲད་དོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཁྱོད་འདིར་ཡང་མ་འདུག་ཤིག།",
    "བདག་གིས་ཉེས་པར་མ་སྤྱད་དེ་འདི་ལྟར་བདེན་སྨྲ་མས་བསླུས་པ་དེས་ཡང་དག་པ་མ་ཡིན་པས་སྐུར་ཏེ་དེ་ནི་བདེན་སྨྲ་མ་ཡིན་གྱི་བརྫུན་སྨྲ་ཡིན་ནོ།",
    "དེ་གཉིས་འཇིག་རྟེན་དག་ཁ་ཟེར་བས་འཇིགས་པས་སོང་སྟེ་ཁྱིམ་བདག་དེའི་སྡུམ་ཚེས་ཀྱི་སྐྱེ་བོ་དག་ལ་དྲིས་པ་དང་།",
    "དེ་དག་ན་རེ་འདི་ནི་ཉེས་པར་སྤྱོད་པ་མ་ཡིན་གྱི་འདི་ལྟར་བདེན་སྨྲ་མས་བསླུས་པ་དེ་ཡང་དག་པ་མ་ཡིན་པས་སྐུར་ཏེ་དེ་ནི་བདེན་སྨྲ་མ་ཡིན་གྱི་བརྫུན་སྨྲ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "སྲིང་མོ་དེ་རང་གི་ཁྱིམ་ན་བསྲེལ་ཞིང་དེ་ལ་ཡང་གླན་ཀ་བཙལ་བ་ལྷུར་ལེན་ཅིང་འཁོད་དོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཁོ་བོ་ཅག་གཉིས་ཀྱང་ཁྱོད་ཀྱི་མིང་པོ་ཡིན་པས་ཆེ་བཞི་དབྱེ་བར་བྱའོ།",
    "དགེ་སློང་དག་དེ་ལ་དེའི་ཚེ་དེའི་དུས་ན་ཁྱིམ་བདག་གི་བུ་བདེན་སྨྲ་གང་ཡིན་པ་དེ་ནི་གྱད་བུ་ནོར་འདི་ཡིན་ནོ།",
    "དེའི་ཚེ་དེའི་དུས་ན་དེའི་མ་ཡར་མོ་གང་ཡིན་པ་དེ་ནི།",
    "དགེ་སློང་མ་མཛའ་མོ་འདི་ཡིན་ནོ།",
    "དེས་མ་ཡར་མོ་ལ་ཡང་དག་པ་མ་ཡིན་པས་སྐུར་བ་གང་ཡིན་པའི་ལས་དེའི་རྣམ་པར་སྨིན་པས་ལོ་བརྒྱ་ཕྲག་མང་པོ་དང་།",
    "དེས་ན་ད་ལྟར་དགྲ་བཅོམ་པ་ཉིད་ཐོབ་ཀྱང་དགེ་སློང་མ་མཛའ་མོས་ཡང་དག་པ་མ་ཡིན་པས་སྐུར་ཅིང་མཛའ་བོ་དང་།",
    "དགེ་སློང་དག་ཁྱོད་ཀྱིས་དེ་ལྟར་བསླབ་པར་བྱའོ།",
    "དེའི་འགྲམ་ན་ཚེ་དང་ལྡན་པ་གྱད་བུ་ནོར་ཉིན་མོ།",
    "གཅིག་གི་རྒྱབ་ཏུ་གཅིག་རྒལ་བར་བྱེད་པ་ཡིན་པས།",
    "ཇི་ཙམ་ན་རི་དགས་ཞིག་གིས།",
    "ཚེ་དང་ལྡན་པ་མཛའ་བོ་དེའི་ཚེ་ཡང་རེ་ཤིག་བདག་ཅག་གཉིས་གནས་ནས་དབྱུང་བའི་ལས་བྱས་ན་ཅི་ད་ཡང་གནས་ནས་དབྱུང་བའི་ལས་བྱེད་དུ་འཇུད་པར་འདོད་དམ་མཛའ་བོས་སྨྲས་པ།",
    "འདི་ལ་བདག་ཅག་གཉིས་གང་གི་དད་པ་འམ་ཡིད་ཆེས་པས་འགྲོ་བར་བྱ།",
    "ཚེ་དང་ལྡན་པ་དག་དེ་ནི་བདག་ཅག་གཉིས་ཀྱིས་མ་ཉེས་ཀྱི་འདི་ལྟར་བདག་ཅག་གཉིས་ཀྱི་མིག་དག་གིས་མཐོང་བས་མིག་དབྱུང་བར་བྱ་གྲང་།",
    "དགེ་སློང་རབ་ཏུ་མང་པོ་དག་གིས་ལེགས་པར་རབ་ཏུ་གླེངས་ཤིང་བརྟགས་པ་ན་དེ་གཉིས་ཀྱིས་སྨྲས་པ།",
    "དགེ་སློང་ཡང་ཞེ་སྡང་ལ་གནས་པས་ཞེ་སྡང་གིས་སྨྲས་སོ་ཞེ་ན།",
    "ཅི་ནས་ཀྱང་འདི་ཚངས་པར་སྤྱོད་པ་དང་དབྲལ་ལོ་སྙམ་ནས་ཤེས་བྱ་བ་ནི་ཅི་ནས་ཀྱང་འདི་དགེ་སློང་གི་ཚུལ་དང་དབྲལ་ལོ་སྙམ་ནས་སོ།",
    "དྲིས་ཀྱང་རུང་ཞེས་བྱ་བ་ནི་གཞན་དག་གིས་སོ།",
    "ཞེ་སྡང་གིས་སྨྲས་སོ་ཞེ་ན་ཞེས་བྱ་བ་ནི་སྐུར་བ་བཏབ་པར་གྱུར་ཏོ་ཞེས་ཟེར་ནའོ།",
    "ལྟ་བ་བསྒྱུར་ཏེ་འདི་སྐད་ཅེས་བདག་གིས།",
    "ཇི་ལྟར་བདག་གིས་ཤེས་པ་དེ་བཞིན་དུ་འཇིག་རྟེན་ཐམས་ཅད་ཀྱིས་ཀྱང་ཤེས་སོ་སྙམ་ནའོ།",
    "དེ་ན་དགེ་སློང་གང་དག་རྫུ་འཕྲུལ་ཐོབ་པ་དེ་དག་ནི་གང་གི་མིང་གིས་འཛམ་བུའི་གླིང་ཞེས་བྱ་བར་ཤེས་པའི་ཤིང་འཛམ་བུ་དེ་ལས་འཛམ་བུའི་འབྲས་བུ་ལྷགས་པ་ཁ་དོག་དང་།",
    "ཀ་པིད་ཐའི་ཚལ་ནས་དེ་དག་གི་འབྲས་བུ་ལྷགས་པ་ཁ་དོག་དང་།",
    "རོ་དང་ལྡན་པ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱེད།",
    "ནུབ་ཀྱི་བ་ལང་སྤྱོད་དུ་ཡང་སོང་།",
    "བྱང་གི་སྒྲ་མི་སྙན་དུ་ཡང་སོང་སྟེ།",
    "མ་རྨོས་མ་བཏབ་པའི་འབྲས་ས་ལུའི་འབྲུ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱེད།",
    "རྒྱལ་ཆེན་བཞིའི་རིས་ཀྱི་ལྷ་རྣམས་ཀྱི་ནང་དུ་ཡང་སོང་།",
    "སུམ་བཅུ་རྩ་གསུམ་པའི་རིས་ཀྱི་ལྷ་རྣམས་ཀྱི་ནང་དུ་ཡང་སོང་སྟེ་ལྷའི་བདུད་རྩི་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱེད།",
    "སྐྱེ་བོ་དང་མི་མང་པོས་གང་བ་དེ་དག་ཏུ་ཡང་སོང་སྟེ་བཅའ་བ་དང་།",
    "བཟའ་བ་གཙང་བ་བསོད་པ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱེད།",
    "འདི་ན་དགེ་སློང་གང་དག་རྫུ་འཕྲུལ་ཐོབ་པ་དེ་དག་ནི་གང་གི་མིང་གིས་འཛམ་བུའི་གླིང་ཞེས་བྱ་བར་ཤེས་པའི་ཤིང་འཛམ་བུ་དེ་ལས་འཛམ་བུའི་འབྲས་བུ་ལྷགས་པ།",
    "ཀ་པིད་ཐའི་ཚལ་ནས་དེ་དག་གི་འབྲས་བུ་ལྷགས་པ་ཁ་དོག་དང་།",
    "རོ་དང་ལྡན་པ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱེད།",
    "ནུབ་ཀྱི་བ་ལང་སྤྱོད་དུ་ཡང་སོང་།",
    "བྱང་གི་སྒྲ་མི་སྙན་དུ་ཡང་སོང་སྟེ།",
    "མ་རྨོས་མ་བཏབ་པའི་འབྲས་ས་ལུའི་འབྲུ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱེད།",
    "རྒྱལ་ཆེན་བཞིའི་རིས་ཀྱི་ལྷ་རྣམས་ཀྱི་ནང་དུ་ཡང་སོང་།",
    "སུམ་བཅུ་རྩ་གསུམ་པའི་རིས་ཀྱི་ལྷ་རྣམས་ཀྱི་ནང་དུ་ཡང་སོང་སྟེ།",
    "ལྷའི་བདུད་རྩི་དག་གིས་ལྷུང་བཟེད་བསྐང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱེད།",
    "མི་མང་པོས་གང་བ་དེ་དག་ཏུ་ཡང་སོང་སྟེ་བཅའ་བ་དང་བཟའ་བ་གཙང་བ་བསོད་པ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱེད།",
    "བདག་གིས་ཀྱང་གལ་ཏེ་རྫུ་འཕྲུལ་ཐོབ་པར་གྱུར་ན་བདག་གིས་ཀྱང་གང་གི་མིང་གིས་འཛམ་བུའི་གླིང་ཞེས་བྱ་བར་ཤེས་པའི་ཤིང་འཛམ་བུ་དེ་ལས་འཛམ་བུའི་འབྲས་བུ་ལྷགས་པ་ཁ་དོག་དང་།",
    "ཀ་པིད་ཐའི་ཚལ་ནས་དེ་དག་གི་འབྲས་བུ་ལྷགས་པ་ཁ་དོག་དང་།",
    "རོ་དང་ལྡན་པ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱ།",
    "ནུབ་ཀྱི་བ་ལང་སྤྱོད་དུ་ཡང་སོང་།",
    "བྱང་གི་སྒྲ་མི་སྙན་དུ་ཡང་སོང་སྟེ།",
    "མ་རྨོས་མ་བཏབ་པའི་འབྲས་ས་ལུའི་འབྲུ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱ།",
    "རྒྱལ་ཆེན་བཞིའི་རིས་ཀྱི་ལྷ་རྣམས་ཀྱི་ནང་དུ་ཡང་སོང་།",
    "སུམ་བཅུ་རྩ་གསུམ་པའི་རིས་ཀྱི་ལྷ་རྣམས་ཀྱི་ནང་དུ་ཡང་སོང་སྟེ།",
    "ལྷའི་བདུད་རྩི་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱ།",
    "མི་མང་པོས་གང་བ་དེ་དག་ཏུ་ཡང་སོང་སྟེ་བཅའ་བ་དང་བཟའ་བ་གཙང་བ་བསོད་པ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱ།",
    "དེའི་ཕྱིར་བདག་ཉིད་ལ་རྫུ་འཕྲུལ་གྱི་ལམ་སྟོན་པར་ནུས་པ་སུ་ཡོད་སྙམ་མོ།",
    "གོ་ཏ་མའི་བུ་ཁྱོད་ཀྱིས་ལྷག་པའི་སེམས་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔ་ནས་སོང་ནས་ཚེ་དང་ལྡན་པ་ཀུན་ཤེས་ཀོཎྜི་ནྱ་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "ལྷས་བྱིན་ཁྱོད་ཀྱིས་གཟུགས་ཚུལ་བཞིན་ཡིད་ལ་གྱིས་ཤིག་དང་།",
    "ཁྱོད་ལ་རྫུ་འཕྲུལ་དང་།",
    "ལྷས་བྱིན་ཁྱོད་ཀྱིས་ཚོར་བ་དང་།",
    "ཁྱོད་ལ་རྫུ་འཕྲུལ་དང་།",
    "ལག་བཟངས་ལ་སོགས་པ་གནས་བརྟན་ལྔ་བརྒྱ་པོ་དག་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "གནས་བརྟན་དག་གིས་བདག་ལ་རྫུ་འཕྲུལ་གྱིས་ལམ་བསྟན་དུ་གསོལ།",
    "དེ་ནས་གནས་བརྟན་ལྔ་བརྒྱ་པོ་དག་གིས་བཅོམ་ལྡན་འདས་དང་དགེ་སློང་གནས་བརྟན་གནས་བརྟན་རྣམས་ཀྱི་ཐུགས་ཡིད་ལ་རྣམ་པར་བལྟས།",
    "ལྷས་བྱིན་ཁྱོད་ཀྱིས་གཟུགས་ཚུལ་བཞིན་ཡིད་ལ་གྱིས་ཤིག་དང་།",
    "ཁྱོད་ལ་རྫུ་འཕྲུལ་དང་།",
    "ལྷས་བྱིན་ཁྱོད་ཀྱིས་ཚོར་བ་དང་།",
    "ཁྱོད་ལ་རྫུ་འཕྲུལ་དང་།",
    "འདི་ལྟར་ཚེ་དང་ལྡན་པ་འདི་དག་གིས་སྔར་བཅོམ་ལྡན་འདས་དང་ལྷན་ཅིག་ཡང་དག་པར་འགྲོས་པར་གྱུར་པས་དེས་ན་འགའ་ཡང་བདག་ལ་རྫུ་འཕྲུལ་གྱི་ལམ་སྟོན་པར་མི་བྱེད་ན་བདག་ལ་རྫུ་འཕྲུལ་གྱི་ལམ་སྟོན་པར་ནུས་པ་གཞན་སུ་ཡོད་སྙམ་མོ།",
    "ནམ་མཁའ་ལ་ཡང་དཀྱིལ་མོ་དཀྲུང་གིས་འགྲོ་སྟེ།",
    "བདག་ལ་གང་གི་མིང་གིས་འཛམ་བུའི་གླིང་ཞེས་བྱ་བར་ཤེས་པའི་ཤིང་འཛམ་བུ་དེ་ལས་འཛམ་བུའི་འབྲས་བུ་ལྷགས་པ་ཁ་དོག་དང་།",
    "ཀ་པིད་ཐའི་ཚལ་དེ་ལས་དེ་དག་གི་འབྲས་བུ་ལྷགས་པ་ཁ་དོག་དང་།",
    "ནུབ་ཀྱི་བ་ལང་སྤྱོད་དུ་ཡང་སོང་།",
    "བྱང་གི་སྒྲ་མི་སྙན་དུ་ཡང་སོང་སྟེ།",
    "མ་རྨོས་མ་བཏབ་པའི་འབྲས་ས་ལུའི་འབྲུ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱད་པར་བྱ།",
    "རྒྱལ་ཆེན་བཞིའི་རིས་ཀྱིས་ལྷ་རྣམས་ཀྱི་ནང་དུ་ཡང་སོང་།",
    "སུམ་བཅུ་རྩ་གསུམ་པའི་རིས་ཀྱི་ལྷ་རྣམས་ཀྱི་ནང་དུ་ཡང་སོང་སྟེ།",
    "ལྷའི་བདུད་རྩི་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱད་པར་བྱ།",
    "བཟའ་བ་གཙང་བ་བསོད་པ་དག་གིས་ལྷུང་བཟེད་བཀང་སྟེ་ཁྱེར་ནས་བདག་ཉིད་ཀྱང་ཡོངས་སུ་ལོངས་སྤྱོད་པར་བྱ།",
    "བདག་གིས་མ་ག་དྷའི་ཞིང་འདི་ན་མི་གཙོ་བོ་གང་ཡིན་པ་རྗེས་སུ་འཇུག་པར་བྱ་ན།",
    "མ་ག་དྷའི་ཞིང་འདི་ན་གང་རྗེས་སུ་འཇུག་པར་བྱས་ནས་ཚེགས་ཆུང་ངུས་སྐྱེ་བོ་ཕལ་པོ་ཆེའི་ཚོགས་ཀྱང་རྗེས་སུ་འཇུག་པར་འགྱུར་བའི་མིའི་གཙོ་བོ་རྗེས་སུ་འཇུག་པར་བྱ་བ་གང་ཡོད་སྙམ་མོ།",
    "བདག་གིས་གཞོན་ནུ་མ་སྐྱེས་དགྲ་རྗེས་སུ་འཇུག་པར་བྱ་སྟེ།",
    "ཚེགས་ཆུང་ངུས་སྐྱེ་བོ་ཕལ་པོ་ཆེའི་ཚོགས་ཀྱང་རྗེས་སུ་འཇུག་པར་འགྱུར་རོ་སྙམ་མོ།",
    "བཅོམ་ལྡན་འདས་ལ་དགེ་སློང་རབ་ཏུ་མང་པོ་དག་གིས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དཔེར་ན་དྲེའུ་མོས་མངལ་ན་གནས་པ་འཛིན་པ་ནི་གསོད་པར་འགྱུར་བ་དང་།",
    "དྲེའུ་མོས་མངལ་ན་གནས་པ་འཛིན་པ་ནི་ཟིལ་གྱིས་གནོན་པར་འགྱུར་བ་དེ་བཞིན་དུ་ལྷས་བྱིན་གྱི་རྙེད་པ་དང་བཀུར་སྟི་ཡང་གསོད་པར་འགྱུར་བ་དང་།",
    "ཁྱོད་ཀྱིས་འདི་ལྟར་བསླབ་པར་བྱ་སྟེ།",
    "དྲེའུ་མོ་རང་གི་མངལ་གྱིས་ལྟར།",
    "ཐུགས་ལས་ཆུང་ངུར་གནས་པར་འགྱུར་རོ་སྙམ་མོ།",
    "དེའི་ཚེ་ན་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ངན་སྤོང་གི་བུ་དག་ན་ཆུ་སྲིན་བྱིས་པ་གསོད་ཀྱི་རི་ལ་འཇིགས་རུང་གི་ཚལ་རི་དགས་ཀྱི་ནགས་ན་འདུག་གོ།",
    "བརྐྱང་བ་ལས་བསྐུམ་པར་བྱེད་པ་དེ་བཞིན་དུ་ཚངས་པ་ནོག་ཅན་ཚངས་པའི་འཇིག་རྟེན་ནས་མི་སྣང་བར་གྱུར་ནས་ངན་སྤོང་གི་བུ་དག་ཏུ་ཆུ་སྲིན་བྱིས་པ་གསོད་ཀྱི་རི་ལ་འཇིགས་རུང་གི་ཚལ་རི་དགས་ཀྱི་ནགས་སུ་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོའི་མདུན་དུ་འདུག་གོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ལ་ཚངས་པ་ནོག་ཅན་གྱིས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "འཕགས་པ་མོད་གལ་གྱི་བུ་མཁྱེན་པར་མཛོད་ཅིག།",
    "བདག་ཡོངས་སུ་ཉམས་སོ་སྙམ་དུ་མི་ཤེས་པར་གྱུར་གྱིས་བཙུན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་བཞུད་དེ་བྱོན་ནས་དོན་དེ་བཅོམ་ལྡན་འདས་ལ་རྒྱས་པར་གསོལ་ན་ལེགས་སོ།",
    "ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོས་ཚངས་པ་ནོག་ཅན་ལ་ཅང་མི་སྨྲ་བས་དང་དུ་བླངས་སོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོས་ཚངས་པ་ནོག་ཅན་སོང་ནས་རིང་པོ་མ་ལོན་པར་རིག་ནས།",
    "བརྐྱང་བ་ལས་བསྐུམ་པར་བྱེད་པ་དེ་བཞིན་དུ་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ངན་སྤོང་གི་བུ་དག་ནས་མི་སྣང་བར་གྱུར་ཅིང་།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས།",
    "ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོས་དེ་ལ་ཚངས་པ་ནོག་ཅན་དང་ལྷན་ཅིག་བར་དུ་གཏམ་བརྗོད་པ་ཅི་བྱུང་བར་གྱུར་པ་དེ་དག་ཐམས་ཅད་བཅོམ་ལྡན་འདས་ལ་རྒྱས་པར་གསོལ་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ལ་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "མོད་གལ་གྱི་བུ་ཁྱོད་ཀྱིས་ཆེས་སྔར་ལྷས་བྱིན་གྱིས་སེམས་ལ་སེམས་ཀྱིས་ཁྱབ་པར་བྱས་ཏེ་རིག་ནས་དེའི་འོག་ཏུ་ཚངས་པ་ནོག་ཅན་གྱིས་མ་བརྗོད་དམ།",
    "བདག་གིས་ཆེས་སྔར་ལྷས་བྱིན་གྱིས་སེམས་ལ་སེམས་ཀྱིས་ཁྱབ་པར་བགྱིས་ཏེ་རིག་ནས་དེའི་འོག་ཏུ་ཚངས་པ་ནོག་ཅན་གྱི་བརྗོད་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་དང་ཐབས་གཅིག་བར་དུ་བཀའ་མཆིད་འདི་གསུང་བའི་སྐབས་སུ་ལྷས་བྱིན་གྲོགས་དགེ་སློང་བཞི་པོ་ཀོ་ཀ་ལི་ཀ་དང་།",
    "ཀ་ཏི་མོ་ར་ཀ་ཏི་ཤྱ་དང་།",
    "རྒྱ་མཚོས་བྱིན་དང་ལྷན་ཅིག་བཅོམ་ལྡན་འདས་ག་ལ་བ་དེར་སོང་ངོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ལྷས་བྱིན་ཐག་རིང་པོ་ཁོ་ན་ནས་གཟིགས་སོ།",
    "གཟིགས་ནས་ཀྱང་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ལ་བཀའ་སྩལ་པ།",
    "མོད་གལ་གྱི་བུ་ལྷས་བྱིན་དེ་འོང་ཞིང་ད་མི་གཏི་མུག་ཅན་དེ་ངའི་མདུན་དུ་བདག་ཉིད་ཀྱི་བདག་ཉིད་ལུང་སྟོན་པར་བྱེད་གྱིས་ད་ཚིག་སྲུངས་ཤིག།",
    "བརྐྱང་བ་ལས་བསྐུམ་པར་བྱེད་པ་དེ་བཞིན་དུ་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་རྒྱལ་པོའི་ཁབ་ཀྱི་འོད་མའི་ཚལ་བྱ་ཀ་ལན་ད་ཀའི་གནས་ནས་མི་སྣང་བར་གྱུར་ཅིང་ངན་སྤོང་གི་བུ་དག་ཏུ་ཆུ་སྲིན་བྱིས་པ་གསོད་ཀྱི་རི་ལ་འཇིགས་རུང་གི་ཚལ་རི་དགས་ཀྱི་ནགས་སུ་གནས་པར་གྱུར་པ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་སོ།",
    "མོད་གལ་གྱི་བུ་གཉིས་ཀྱི་བསྔགས་པ་བརྗོད་ཅིང་།",
    "མགོ་ལན་གསུམ་ལྕོགས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔ་ནས་སོང་ངོ།",
    "ཟབ་ཡངས་ངག་གི་མཆོག་སྦྱིན་དེང་འདིར་སྩོལ།",
    "བདག་གི་ཡིད་ནི་ཚུལ་འདིར་ཞུགས་པར་གྱུར།",
    "གང་གིས་འདི་ལ་སྐལ་བཟང་དད་པའི་སྤུ་ལོང་གཡོ་ཞིང་འཛུམ་དཀར་ཟླ་བ་ཅི་ཡང་སྟོན།",
    "མཁས་རློམ་ལྗོན་པའི་སྡོང་གི་ཡལ་འདབ་ས་ལ་དུད་ཅིང་ཡིད་ནི་རྨོངས་པའི་འབྲས་བུ་ལྕི།",
    "སྐལ་ངན་ཕྲག་དོག་ཚེར་མའི་མལ་ན་སྨྲེ་སྔགས་འབོད་ཅིང་རང་གི་དེ་ཉིད་མ་ལུས་ངོམ།",
    "སྙན་ངག་ལང་ཚོའི་རྒྱན་དུ་བོས་པ་བཞིན།",
    "མཚན་མོ་རྒྱུ་བ་མུན་པར་བྱས་པ་སྙམ།",
    "ལག་པའི་འདབ་ཕྲེང་གཙུག་ན་ཐལ་སྦྱར་ཏེ།",
    "བླུན་རྨོངས་གྲོང་པའི་མགལ་དུམ་ཚིག་ཕྲེང་གིས།",
    "ལྔ་བརྒྱ་པ་རྣམས་ཀྱི་གཙུག་གི་ནོར་བུ།",
    "དམ་ཅན་རྒྱ་མཚོའི་ཚོགས་ཀྱིས་སྐུའི་སྣང་བརྙན་མངོན་སུམ་དུ་བསྟན་ནས་གསུང་གིས་ཕྲིན་ལས་འབད་མེད་དུ་བསྒྲུབ་པའི་མཐུ་སྟོབས་ཀྱི་མགོན་པོ།",
    "མགོན་ཁྱོད་འོག་མིན་ཆེན་པོའི་ཞིང་ཁམས་སུ།",
    "ནོར་འཛིན་ཁྱོན་གྱི་འགྲོ་རྣམས་ཇི་སྙེད་པ།",
    "བདག་གིས་ཇི་ལྟ་བུ་ལགས་ཞུས་པས།",
    "གང་འདྲ་ཡིན་ནམ་དབུས་སྨྱོན་པས་ངེད་རང་ཕག་མོ་གྲུ་པའི་སྤྲུལ་པ་ཡིན་ཟེར་གྱི་ཡོད་འདུག་དེ་ལྟར་ན་དེ་དུས་ཀྱི་སྲུང་མ་ཞིག་ཡིན་པ་འདྲ་གསུང་བས་དོན་གྱི་ངེས་པར་ཞལ་གྱིས་བཞེས་པར་སྣང་ཞིང་།",
    "ནཱ་རོ་མེ་ཏྲིའི་ཐུགས་བཅུད་ཆུ་ཀླུང་གིས།",
    "བསྐྲུན་མཛད་འཁོར་ལོའི་མགོན་པོ་ཁྱོད་གཅིག་པུ།",
    "ཕྱི་ལྟར་ན་ཧོར་པའི་སྲས་མོར་བྱེད་ཅིང་།",
    "བཀྲ་ཤིས་རྒྱལ་མོར་གྲགས་པ་ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོ་མའི་མཚན་དང་ལྡན་པ།",
    "སྒྱུ་འཕྲུལ་ལྷ་མོའི་ངང་ཚུལ་ཇི་བཞིན་གྱུར།",
    "ཡུམ་སོ་གཉིས་པ་དཀར་པོ་ཞེས་བྱ་བ་ས་མོ་སྦྲུལ་གྱི་ལོ་ནག་པ་ཟླ་བའི་ཡར་ངོའི་ཚེས་བཅུ་བཞི་སྐར་མ་ཁྲ་ལ་བབ་པའི་དུས་སྦྱོར་བཟང་པོའི་ཉི་དྲོས་ལ་སྐུ་བལྟམས་པར་གྱུར་ཏོ།",
    "ཉེ་འཁོར་ཐམས་ཅད་དུ་ལྷའི་མེ་ཏོག་གི་ཆར་ཆེན་པོ་བབས་པར་གྱུར་ཅིང་།",
    "དེ་ལ་སྐྱེ་བོ་དག་གང་གི་ལྟས་ཡིན་ནམ་གླེང་བ་ན་ཕལ་ཆེར་དེང་སང་རྡོ་རིང་པ་ལ་སྲས་ཁྱད་པར་ཅན་ཞིག་འཁྲུངས་ཡོད་འདུག་པས་དེའི་ལྟས་ཡིན་པར་ངེས་སོ་ཞེ་མཐུན་སྣང་གྲུབ་པར་བྱེད་ལ།",
    "དེ་ལྟར་གཞོན་ནུ་དེ་ནི་མཛེས་ཤིང་ལྟ་ན་སྡུག་པ་རང་བཞིན་གྱི་མཚན་དཔེའི་ཆ་ཤས་དང་ལྡན་པས་སྐྱེ་བོ་ཀུན་གྱི་མིག་གི་བདུད་རྩི་ལྟ་བུར་གྱུར་ཅིང་།",
    "ལན་ཅིག་གི་ཚེ་རྡོ་རིང་གི་གྲོག་པོ་ཞིག་གི་ནང་དུ་བྲོས་ནས་ཡིབ་བཞུགས་པ་ལས།",
    "བསྐྱེད་རིམ་གྱི་ང་རྒྱལ་དང་བཅས་པས་སྐུ་སྲུང་བརྒྱབ་པས་རྒྱང་རིང་དུ་བྲོས་པའི་སྐད་ངན་ཕྱི་རོལ་ཏུ་སྐྱེ་བོ་གཞན་དག་གིས་ཐོས་པས་ཀུན་གྱིས་ངོ་མཚར་བར་གླེང་བ་བྱུང་བར་སྣང་ངོ།",
    "ཐ་མལ་མུ་ཅོར་མིང་གི་ལྷག་མར་བྱས།",
    "རྒྱ་མཚོའི་ཕ་མཐར་བསྐྲད་པའི་ངུད་མོའི་སྒྲ།",
    "ཉི་ཤུ་དགུ་བྱུང་ངོ་ཅོག་གི་གཏོར་མ་དཔལ་འབར་དང་བཅས་པ་ས་སྐྱ་ཕྱོགས་སུ་འབུལ་བར་མཛད་པའི་ཚེའང་།",
    "ཁྱོད་གཙུག་ནོར་བུའི་ཅོད་པཎ་རབ་བཅིངས་ནས།",
    "ཁྱོད་བློའི་སྙིམ་པས་རབ་གསོལ་བས།",
    "སྐལ་བཟང་ལང་ཚོ་ཅི་ཡང་བལྟམས།",
    "དེ་ལྟར་རྗེ་བཙུན་རྡོ་རྗེ་འཆང་ཆེན་པོ་དེ་ཉིད་དང་སྐུ་སྐྱེ་བ་སྔ་མ་ཞིག་གི་དཔོན་སློབ་ཀྱི་འབྲེལ་བས་ཐུགས་མི་ཕྱེད་པའི་དད་པ་ཐོབ་པའི་སྟོབས་ཀྱིས།",
    "ཉ་ཕྱིས་ཀྱི་ཀ་པཱ་ལ་ཨ་རག་གིས་བཀང་བ་ཞིག་གནང་ནས་འཐུང་གསུང་བ་ལ་ཡབ་ཀྱིས་འདི་ན་ཚོད་གཞོན་པས་བཟི་ཡོང་ཞུས་པས།",
    "མི་འོང་འདི་ལ་ངེད་རིན་སྤུངས་པའི་མི་དྲག་པ་རང་ཞིག་རེ་བ་ཡིན་ཕུག་རྣལ་འབྱོར་པ་བཟང་པོ་ཞིག་འོང་ཉེན་ཡོད་གསུང་བས།",
    "སྐུ་རེགས་འཆིང་བ་ཚུན་གྱི་བསླབ་དོན་རང་གི་རིགས་སྲས་ལས་ཀྱང་ཐུགས་བརྩེ་བ་ལྟ་བུས་སྐྱོང་བ་མཛད་དོ།",
    "མུ་ཁྲི་བཙན་པོའི་རྣམ་འཕྲུལ་ས་སྐྱོང་གིས།",
    "དེ་ནས་རེ་ཞིག་རྡོ་རིང་དུ་ཕེབས་ཏེ།",
    "ནང་སོའི་བཀའ་གྲོས་སྙན་འདེབས་སྣེ་སྡོང་གི་ཀ་བཞི་དགོན་གསར་གྱི་དཔོན་ཚབ་སོགས་ཁུར་ལས་ཆེ་བར་བཞེས་ཤིང་།",
    "བསྟན་པ་ལ་དགའ་བའི་ལྷ་དག་གིས་ཆར་གྱི་རྒྱུན་དུས་སུ་ཕབ་སྟེ་ལོ་ཏོག་དང་འབྲུ་རྣམས་ཡོངས་སུ་རྒྱས་པ་དང་།",
    "རང་ཉིད་ཀྱང་ཕྱི་རོལ་ཏུ་རྒྱལ་སྲིད་ཀྱི་ཁ་ལོ་སྒྱུར་ཀྱང་ནང་དུ་ཡོངས་འཛིན་དམ་པ་རྣམས་བསྟེན་ནས་དེ་དག་གི་ཞལ་ལས་བྱུང་བའི་ཟབ་པ་དང་རྒྱ་ཆེ་བའི་གདམས་པ་རྣམས་རྩེ་གཅིག་ཏུ་ཉམས་སུ་བཞེས་ཤིང་ཐུགས་ཚིམས་པར་མཛད་པ་ཡིན་ནོ།",
    "བྱུགས་པའི་མོད་ལ་དགའ་བདེའི་ག་པུར་གྱིས།",
    "ནང་དུ་རིམ་གཉིས་རྟོགས་པའི་རྩེ་མོར་སོན།",
    "ཁྱོད་ཀྱི་སྒྱུ་འཕྲུལ་དྲྭ་བའི་ཟློས་གར་གྱིས།",
    "ཡིད་འོང་ལག་འགྲོ་ཕོ་མོ་མཁའ་ལ་སྤྱོད།",
    "ཁྱོད་ཉིད་གཅིག་པུས་བདག་གིར་མཛད་པ་སྙམ།",
    "བསྐྱང་ཕྱིར་ཁྱོད་ཀྱིས་འཁོར་ལོས་སྒྱུར་བ་ཡིས།",
    "གོང་དུ་སྨོས་པ་ལྟར་སྔ་མོ་ནས་རབ་ཏུ་བྱུང་བའི་ཐུགས་འདུན་ཤིན་ཏུ་ཆེ་བར་ཡོད་པ་དང་།",
    "ཡང་དང་ཡང་དུ་གསུང་གིས་བསྐུལ་བ་ལྟར།",
    "དུས་དེ་ཉིད་ནས་བཟུང་སྟེ་བསླབ་པའི་གནས་ཕྲ་ཞིང་ཕྲ་བའི་བར་ཐམས་ཅད་མིག་གི་འབྲས་བུ་ལྟར་གཅེས་པར་བསྲུང་བ་དང་བཅས་པའི་མཚམས་ལས་ཅུང་ཟད་ཀྱང་འདའ་བའི་གོ་སྐབས་མི་མངའ།",
    "ཨེ་མ་ཁྱོད་སྐུའི་མ་ཕམ་མཚོ།",
    "བྱང་གི་ཕྱོགས་འདིར་ཞུགས་སམ་ཅི།",
    "ཁྱོད་ས་སྐྱ་ལ་རྒྱུག་མི་འགྲོ་ན་བརྡུང་བ་ཡིན་གསོད་པ་ཡིན་ཟེར་བ་དང་།",
    "རེས་འགའ་ཁྱེད་མི་འགྲོ་ན་འདི་ལྟར་བྱེད་ཟེར་ཁོང་རྣམས་ཀྱིས་སྐུ་ཆས་ཐམས་ཅད་ཁྱེར་ནས་ས་སྐྱ་ཕྱོགས་སུ་འཕུར་འགྲོ་བ་སོགས་ཆོ་འཕྲུལ་གྱི་རྣམ་པ་བསམ་གྱིས་མི་ཁྱབ་པ་བྱུང་།",
    "ཁོ་ན་རེ་ད་ཅིས་ཀྱང་ས་སྐྱ་ལ་བྱོན་པ་དྲག་མི་འབྱོན་ན་ངས་ཕྱགས་ཕྱི་ལ་སྡོད་མི་ནུས་པར་འདུག་ཟེར་བ་ཞུས།",
    "ལས་མགོན་པུ་ཏྲ་མིང་སྲིང་གི་རྗེས་གནང་སོགས་དང་།",
    "དེ་དག་གི་རྒྱ་བོད་ཀྱི་ཡི་གེ་རབ་ཏུ་མང་པོ་ཕྱོགས་གཅིག་ཏུ་བསྒྲིགས་པ་མགོན་པོད་མེ་འབར་མར་གྲགས་པའི་ལུང་།",
    "ནང་སྒྲུབ་ཐུན་མོང་བ་ཡར་ཀླུངས་པ་ནས་བརྒྱུད་པ་དང་།",
    "ཐུན་མོང་མ་ཡིན་པ་གདུང་བརྒྱུད་རིམ་པ་ལས་བྱུང་བ།",
    "ནག་པོ་ཆེན་པོ་གདོང་བཞི་པའི་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡིན་པའི་རྗེས་སུ་གནང་བ།",
    "དཀར་མོ་ཉི་ཟླ་དང་།",
    "མགོན་པོའི་ཐུན་མོང་མ་ཡིན་པའི་མན་ངག་འདི་རྣམས་གདུང་བརྒྱུད་རིམ་པར་ངེད་ཀྱི་བར་ཆིག་བརྒྱུད་དུ་བྱོན་པ་ཡིན།",
    "མཁས་གྲུབ་བྱེ་བའི་གཙུག་གི་རྒྱལ་མཚན་རྩེར།",
    "ཁྱོད་ཐུགས་གཉིས་འཐུང་རབ་དྲངས་ཤིང་།",
    "དེ་ཚེ་དཔྱིད་ཀྱི་ཉི་གཞོན་སྦྲང་ཆང་གིས།",
    "གཟིགས་པའི་མོད་ལ་གཟུང་འཛིན་པདྨ་ཟུམ།",
    "རབ་དགའི་ཏིང་འཛིན་མིང་གི་ལྷག་མར་བྱས།",
    "རྒྱ་ཆེན་ལུང་གི་རྦ་རླབས་གཡོ།",
    "ཁྱོད་བློ་རྒྱ་མཚོའི་འཇིང་དུ་ཐིམས་པ་ན།",
    "འཛེགས་ནས་རང་གི་དེ་ཉིད་ཕྱོགས་བརྒྱར་སྟོན།",
    "ཕག་མོའི་གཞུང་དྲུག་གི་སྐོར་ལ་སོགས་དུ་མ།",
    "མཁྱེན་ལྡན་ཁྱོད་ཀྱི་ཐུགས་མཚོར་ཞུགས་པར་གྱུར།",
    "རྡོ་རྗེ་ཕག་མོའི་རྣམ་སྤྲུལ་རྗེ་བཙུན་མཚན་ལྡན་མ་ལ་སོགས་པ།",
    "ལྷག་པར་དཔལ་ལྡན་ས་སྐྱ་པའི་སྙན་བརྒྱུད་ཀྱི་གདམས་པ་ཟབ་མོ་རྣམས་ཡོངས་སུ་རྫོགས་པར་བཞུགས་པ་ནི་དུས་འདིར་རྗེ་འདི་བས་ལྷག་པར་ལྟ་ཞོག་མཉམ་པ་ཙམ་ཡང་སའི་སྟེང་ན་མེད་པར་ཐག་ཆོད་ཅིང་ངེས་པའི་ཤེས་པ་གཏིང་ནས་སྐྱེས་པས།",
    "ཞབས་འབྲིང་རིང་དུ་བསྟེན་པའི་ཞལ་སློབ་དག་གི་གསུང་ལས་ཉན་པས་ངོ་མཚར་གྱི་སྣང་བ་ཆེས་ཆེར་སྐྱེ་བར་འགྱུར་རོ།",
    "ཟུང་གིས་ལྷག་པའི་ཡོངས་འཛིན་བཅུ་ཕྲག་བདུན།",
    "ཁྱོད་ཐུགས་རྒྱ་མཚོའི་ལྗོངས་སུ་དལ་གྱིས་ཞུགས།",
    "མཁས་ཁྱོད་མཁས་པའི་བཤེས་གཉེན་མང་བསྟེན་ནས།",
    "ཟབ་ལམ་ཟབ་མོའི་བདུད་རྩིའི་གཏེར་དུ་གྱུར།",
    "བློ་ཆུང་ཕྱོགས་རེའི་ཁྲོན་པས་སེམས་ཁེངས་པའི།",
    "ཐུན་མོང་ཙམ་གྱིས་རང་མགོ་བསྐོར་བ་དག།",
    "ཕྲག་དོག་ཚིག་གི་ཕྲ་མ་ལྷུར་ལེན་པ།",
    "བདག་ལྟའི་ཚིག་གིས་བརྗོད་པར་ཅི་ཞིག་ནུས།",
    "གངས་ཅན་མཁས་པ་ཀུན་གྱི་རྩེ་མོར་སོན།",
    "རྗེ་བཙུན་ས་སྐྱ་པ་ཡབ་སྲས་སོགས་བོད་ཀྱི་མཁས་གྲུབ་དག་གི་བཞེད་སྲོལ་སོ་སོ་མ་འདྲེས་ལ་ཡོངས་སུ་རྫོགས་པ།",
    "ལྷག་པར་སྔ་མོ་ནས་ཐུགས་ཀྱི་འདུན་པ་ལ་ལྷོ་བོད་ཀྱི་མཚམས་སོགས་མི་མེད་ལུང་སྟོང་ཞིག་ཏུ་སྐུ་ཚེ་ཧྲིལ་པོ་སྒྲུབ་པ་ལ་སྒྲིལ་བའི་ཐུགས་མདུན་དྲག་པོ་ཡོད་འདུག་རྗེས་སུ་དེ་ནི་ཅུང་མ་གྲུབ་ནའང་།",
    "ཕྱི་རོལ་གྱི་སྣང་བ་དང་སྒོ་བསྟུན་ནས་སྤྲོས་བཅས་ཀྱི་རིམ་པའང་ཉིན་ཞག་རེའི་ནང་དུ་ཐུན་བཞིའི་ངེས་པས།",
    "སྔ་དགོངས་ཀྱི་ཐུན་ལ་ཐུགས་སྐབས་དང་བསྟུན་ནས་རེ་འགའ་འབྲིང་པོའང་མཛད་དོ།",
    "ནཱ་རོ་མཁའ་སྤྱོད་ཀྱི་སྒོམ་བཟླས་རྣམས་ཐུན་རེའི་ནང་དུ་མཛད།",
    "མི་མེད་དབེན་པའི་རི་སུལ་ཟབ་མོ་དེར།"
  ]
}