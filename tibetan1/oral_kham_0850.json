    "གལ་ཏེ་བྲོས་མ་ཐར་ན་ངས་ཁྱེད་རང་ལ་རྩ་བ་ཉིད་ནས་དཀའ་ངལ་བཟོས་མ་ཡོང་།",
    "གལ་སྲིད་ཁྱེད་རང་དངོས་གནས་འགྲོ་བསམ་གྱི་ཡོད་ན།",
    "ཡིན་ནའང་གང་འདྲ་ཟེར་ཕྱི་ལ་འཐོན་སྟངས་འདི་ད་ལྟ་ཁྱེད་རང་འབྲེལ་བ་མ་བྱེད།",
    "ཁྱེད་རང་གསུམ་གྱིས་ངོས་ལེན་གཏིང་ཟབ་ཞུ་དགོས།",
    "ངའི་སེམས་གཏིང་ནས་ངོས་ལེན་དང་བློ་འགྱོད་ཆེན་པོ་སྐྱེས་ཀྱི་འདུག་ངས་བཏོན་པའི་གྲོས་འགོའི་ནང་།",
    "ཟ་འབྲུ་གྲོན་ཆུང་ཡོང་ཆེད་ང་རང་ཁྱིམ་དུ་ཉི་མ་གསུམ་ལས་མ་བསྡད་པར་བོད་ལ་ལོག་ཡོང་བ་ཡིན།",
    "དངོས་གནས་ཡ་ང་བོ་ཞེ་དྲག་འདུག་བྱས་ཙང་།",
    "དམག་སྤྱི་ཁང་ནས་ད་ལྟ་རང་ང་ལ་བཀའ་ཞིག་ཕེབས་འདུག་པ་དེའི་ནང་།",
    "ངའི་བསམ་པར་ཡང་འདི་ལྟར་བྱས་ན་ཡག་པོ་འདུག་གང་ཡིན་ཟེར་ན།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་གཞུང་ལམ་འགྲམ་ཆུ་ཡུར་ཞིག་འདུག་པས།",
    "ང་རང་ཡང་ཡུར་པོའི་གྲིབ་ནག་ནང་གབ་སྟེ་ལག་ཏུ་ལག་འབོམ་ཁ་ཕྱེ་ནས།",
    "ལག་ཏུ་དབྱིན་ཇི་ཁ་རྡུམ་གྱི་མེ་མདའ་འཁྱེར་བའི་བོད་དམག་བརྒྱད་སྒོ་སྲུང་ཚུལ་དུ་ལངས་ནས་བསྡད་འདུག་དེའི་ནང་ནས་དམག་ཆས་ཅུང་ལེགས་ཤིང་།",
    "སྐབས་དེ་དུས་བོད་དམག་ཚོས་ང་མཐའ་སྐོར་ནས་ཝ་ལ་ཝ་ལ་ཞེས་བོད་སྐད་བརྒྱབ་སྟེ་ང་ལ་སྐད་ཆ་མང་པོ་འདྲི་ཡྀ་འདུག་ཀྱང་།",
    "ཁྱེད་རང་སུ་བརྩད་མཁན་ཡིན་པའ་ཞེས་འདྲི་དུས།",
    "ང་གཉིས་ཀྱི་སྐད་ཆ་ཕན་ཚུན་སུས་ཀྱང་གོ་བརྡ་འཕྲོད་ཐུབ་ཀྱི་མི་འདུག་ང་འུ་ཐུག་ཐབས་ཟད་དེ་ལྐུགས་བརྡ་བྱས་ནས་ངས་འཁྱེར་ཡོང་བའི་འཁྲུལ་མདའ་དང་ལག་འབོམ་སོགས་ལུས་ནས་བཀྲོལ་ཏེ་སྒོ་རའི་སྦུགས་ལ་ཡར་གཡུགས།",
    "དེ་འཕྲལ་ཁོང་ལ་བསམ་བློ་ཞིག་འཁོར་འདུག་པ་དེ་ནི།",
    "དེ་གར་སྔ་ས་ནས་གྲ་སྒྲིག་ཟིན་པའི་ཀོ་ནང་འཛུལ་སྐབས་རྒྱ་དམག་ཐོན་ཤོག་༡༥༥ པའི་དམག་མི་རྣམས་སྔ་དྲོའི་ལུས་རྩལ་རྩེད་དེ་བསྡད་འདུག་ཀྱང་།",
    "དེ་རྩིས་ཁྱེད་རང་ཁང་བདག་ཁང་གཉེར་སོ་སོས་ཁང་ཁོངས་སུ་སྡོད་མཁན་མི་མང་ཚང་མར་དོགས་འདྲོགས་གང་ཡང་མི་དགོས་པར་བློ་བག་ལྷིང་སྡོད་དགོས་པའི་གནས་ཚུལ་དྲིལ་བསྒྲགས་ཞིབ་ནན་བསྐྱངས་པས་མ་ཚད།",
    "སྐབས་དེར་ཁོ་རང་ལོ་༢༤ སླེབས་ཤིང་།",
    "གཞི་ནས་ཚང་མས་བསམ་ཤེས་ཐོན་ཏེ་གྲོས་དོན་འདི་ཡག་པོ་འདུག་ཅེས་འདི་རང་བྱ་རྒྱུར་ཐག་བཅད།",
    "ཨ་འབྲུུག་ནས་དེ་ཡག་པོ་འདུག་ཀྱང་སྔ་དུས་ཀྱི་མེ་མདའ་ཡིན་ན་ཕན་ཐོགས་མི་འདུག་ཟེར།",
    "བྱང་གནམ་མཚོ་ཁ་ནས་སྐྱ་ར་དཔལ་འབར་དུ་སླེབས་ཉེའི་མཚམས་ཀྱི་ས་ཆ་ཕལ་ཆེ་བ་བྱེ་ཐང་ཡིན་འདུག་པས།",
    "ཟམ་པ་སྲུང་མཁན་དམག་མི་གཉིས་ལས་མི་འདུག་ཀྱང་།",
    "དྲུག་ཅུ་ལྷག་ལ་རྨས་སྐྱོན་ཕོག་འདུག་ཅིང་།",
    "མི་སེར་ལག་ནས་འཕྲོག་བཅོམ་བྱས་པའི་རྒྱུ་དངོས་རིགས་རྣམས་དོ་བདག་སོ་སོར་ཕྱིར་སློག་རྩིས་སྤྲོད་བྱས་པར་མི་མང་ནས་དགའ་བསུ་བསྔགས་བརྗོད་ཞུས་འདུག་པ་ཙམ་དུ་མ་ཟད།",
    "ཁྱེད་རང་ཐུགས་ཁྲལ་གནང་མི་དགོས།",
    "ངས་ལས་འགན་མ་འགྲུབ་པར་ཁ་ཚུར་སློག་ནས་ཁྱེད་རང་མཇལ་བར་མི་ཡོང་ཞེས་ལབ་སྟེ་རྡོག་ཐོན་བྱས།",
    "དཔྲ་རྨོག་ཕྱོགས་ནས་ཁ་ཏ་ཟམ་པ་སྲུང་སྐྱོབ་ཆེད་རྒྱ་དམག་ལྔ་བཅུ་ཙམ་ཞིག་དཔུང་སྣོན་དུ་བཏང་འདུག་པ་དེ་དང་།",
    "རྡོ་ཁང་ཉིས་ཐོག་ཅིག་ཡོད་པ་དེའི་སྟེང་ཐོག་ཏར་ཁང་དང་ཕྱོགས་བཞིར་སོ་ལྟ་ཁང་ཡོད་འདུག་པས།",
    "ཕྱི་ལོ་༡༩༥༩ ཟླ་༣ ཚེས་༡ ཉིན་བོད་མི་སེར་སྐྱ་སྟོང་ཕྲག་མང་པོས་འུ་ཐུག་ཐབས་ཟད་ངང་རང་ཁྱིམ་ནས་ཕྱིར་ཐོན་ཏེ་ལྷ་སའི་ཁྲོམ་གཞུང་དུ་རུ་བསྒྲིགས་རྔམ་སྟོན་བྱས་ཏེ་རྒྱ་མི་བཙན་འཛུལ་བ་བོད་ནས་ཕྱིར་ལོག་བྱེད་དགོས།",
    "མགྲོན་ཆེའི་བཀའ་དགོངས་ལྟར་རིང་མདའ་བཀྲ་ཤིས་ཁ་རིང་ངོ་གྲངས་༥ དང་མེ་སྒྱོགས་༡ རྫས་མདེལ་རང་འགྲིགས་གཞུང་ལ་ཕུལ་འདུག་པ་དང་།",
    "ཕར་རྒོལ་དང་རང་ས་སྲུང་རྒྱུར་ངལ་བ་མེད།",
    "དེའི་ནང་ག་དུས་ཡིན་ནའང་དམག་ས་མདུན་མར་གདོང་མཆོངས་རྒྱག་མཁན་གྱི་དཔའ་རྒོད་ཁོངས་སུ།",
    "ཁོང་གཉིས་ཀྱི་འཚོ་རྟེན་ཚལ་འཚོང་ཁང་ཞིག་ཡོད་པ་དེ་གཞུང་བཞེས་བཏང་སྟེ་རྒྱ་ནག་ནང་སར་ཕྱིར་ལོག་བྱེད་པར་བཏང་འདུག་ཀྱང་།",
    "ད་ཆ་ང་གཉིས་ཀྱི་འཚོ་བར་དཀའ་ངལ་ཆེན་པོ་འདུག་པས་དངུལ་ཏོག་ཙམ་ཞིག་སྔ་འདོན་གཡར་རོགས་གནང་ཞེས་ལབ་པར།",
    "ཁྱེད་རང་བློ་བཟང་བཀྲིས་ཡིན་ནམ་ཞེས་འདྲིས་བྱུང་བས།",
    "ཁོ་རང་ལ་མངགས་པའི་ལས་ཀ་མི་བརྩད་གཅོད་བྱེད་རྒྱུ་དེ་ཡིན་པའི་ནང་ནས་གལ་ཆེ་ཤོས་མི་དངོས་སུ་བརྩད་ཆོད་ཐུབ་རྗེས།",
    "འདིར་གང་འདྲ་འདུག་སེམས་ཆགས་ཀྱི་འདུག་གས།",
    "བར་ཁྱམས་དང་སྒོ་ཕྱི་ནང་ཡོད་པ་དེར་སྐུ་སྒེར་གྱི་གཟིམ་ཤག་གནང་འདུག་བོད་མི་སྔོན་ལ་འབྱོར་བ་རྣམས་མེག་ལོ་གྷན་ཅིས་ཞེས་པའི་རི་གྲོང་ཆུང་ཆུང་དེའི་བྱང་ཤར་ངོས་ཀྱི་རི་ལྡེབས་ཤིང་གཅོད་དྲེགས་བྱས་པའི་ས་སྟོང་དུ་གནས་སྐབས་སྡོད་ཡུལ་སྙུགས་མའི་ཁང་པ་སྟར་པ་འགྲིགས་ནས་བརྒྱབ་ཡོད་པའི་ནང་བསྡད་འདུག་པ་དང་།",
    "རི་སྐེད་དུ་ཡུལ་མིའི་ཁང་པ་ཡང་བཅུ་གྲངས་ཤིག་འདུག་གྲོང་ཆུང་དེའི་ནང་རྒྱ་གར་བས་གཉེར་བའི་ཚོང་ཁང་ཆུང་ཆུང་གཅིག་དང་ཇ་ཁང་གཅིག་རང་ལས་མི་འདུག་ཀྱང་།",
    "ཁྱེད་གཉིས་སུའི་མི་ཁུངས་ཡིན་ཟེར་དྲིས་ཀྱི་འདུག་པས།",
    "ཁྱེད་གཉིས་སྔོན་ལ་འདིར་སྡོད་ཅིག་ཅེས་ལབ་ཀྱི་འདུག་པས།",
    "མི་ལ་གུས་ཞབས་དང་བརྩི་འཇོག་བྱེད་ཤེས་ཀྱི་འདུག་འདྲི་ཞིབ་འགོ་བཙུགས་དུས་ཁ་སྔོན་ནང་ལྟར་ས་ཆ་གང་ནས་ཡོང་བ་ཡིན།",
    "ཁྱེད་རང་བློ་བདེ་པོ་བྱེད།",
    "བྱས་ཙང་ང་ཁྱེད་གཉིས་བསུ་བར་ཡོང་བ་ཡིན་ཞེས་གསུངས་ཀྱི་འདུག་ང་གཉིས་ནས་ཁོང་ལ་བཀྲིན་ཆེ་ཞུས་རྗེས།",
    "ངའི་བསམ་པར་ཡག་པོ་རང་མི་འདུག་བསམ་ནས།",
    "ཁྱེད་རང་སླེབས་པ་ཏག་ཏག་བྱུང་།",
    "ད་དུང་ས་ཆ་དེའི་ནང་བསྐོར་ར་རྒྱབ་ནས་ལྟ་དུས་རྡོ་གང་འཚམ་འདུག་ཀྱང་ས་ཆ་དེ་ལས་ལྷག་པ་བདམ་ཡས་མེད་སྟབས།",
    "ལོ་དེར་ངས་རྩིས་རྒྱག་དུས།",
    "སྟོན་ཏོག་དང་ཚལ་ཞིང་བཅས་ཀྱི་ཡོང་འབབ་ཧིན་སྒོར་ཁྲི་ལྷག་བྱུང་འདུག་པས།",
    "གྲོང་པ་ཁྱིམ་མཚེས་ཀྱིས་རོགས་རམ་འོག་དུས་ཡུན་ཟླ་བ་གཅིག་ཙམ་རིང་དཀའ་ལས་བརྒྱབ་པ་བརྒྱུད་ས་ཆ་སྤྱི་བྲེ་གྲུ་བཞི་མ་བརྒྱད་ཅུ་ཙམ་ཡོད་པའི་ཁང་པ།",
    "སེམས་ལ་ག་དུས་ཡིན་ནའང་མ་སྐྱིད་པ་བྱུང་ནས་མི་གཞན་ལ་འཁང་ར་བྱས་ཏེ་དེ་ལས་སྐྱོབ་ཐབས་ཀྱི་ཐབས་ལམ་བཙལ་ཤེས་ཀྱི་མེད།",
    "ངའི་བསམ་པར་ཡག་རྟགས་མི་འདུག་དེ་ལས་འདི་ནས་གླང་ཆེན་ཐར་ས་མེད་པའི་ཤིང་སྡོང་ཆེན་པོ་འགའ་ཤས་མཉམ་དུ་རྩ་བ་འདྲེས་ནས་ཡོད་པའི་རྒྱབ་ཏུ་བསྐྱོད་དེ་ལག་པའི་ནང་སྟ་རི་དམ་པོར་ཟིན་བསྡད་པ་ཡིན།",
    "ཉིན་ཞིག་ཧྲུའུ་ཧྭ་ཡིས་ང་ལ་གསོས་ཕྲུག་དེར་མནའ་མ་ཞིག་བསུས་ནས་འགྲོ་སྟངས་བཟོས་ན་ཞེས་ལབ་ཀྱི་འདུག་པས།",
    "མཇལ་དར་དང་འབུལ་རྟེན་ཤོག་ཆག་བཅས་གྲ་སྒྲིག་བྱེད་རོགས་ཟེར་ཡང་ཡང་མངགས་ཀྱི་འདུག་ཉིན་གཉིས་པའི་སྔ་དྲོར་ཧྲུའུ་ཧྭ་ཡར་ལངས་རྗེས།",
    "གྲོངས་བཞག་ཅེས་ངུ་འབོད་བྱེད་ཀྱི་འདུག་པས།",
    "སྟབས་མི་ལེགས་པར་མི་ཚེའི་འཕེན་པ་རྫོགས་འདུག་མ་གཞི་ཁོང་རྒྱ་མི་རིགས་ཤིག་ཡིན་ནའང་།",
    "དེས་མ་ཚད་ད་དུང་མི་ལ་བུ་ལོན་ཧིན་སྒོར་བདུན་བརྒྱ་ཙམ་བཟོས་འདུག་པ་ཕ་ཚབ་ངས་སྤྲད་པ་ཡིན།",
    "ག་དུས་ཡིན་ནའང་ཕྱི་ལ་ལབ་རྒྱུ་རྐྱང་རྐྱང་བཟོས་པར་བརྟེན་མནའ་མས་ཁོ་པར་ཞབས་འདྲེན་པའ།",
    "ཡང་སྡུག་ར་བཟི་འདུག་གང་།",
    "ང་གཉིས་ཀྱི་ལྟོ་གོས་འགྲིག་ཙམ་འདུག་ཀྱང་།",
    "ཕྱི་ཟླ་༡༢ ཚེས་༡༦ གོང་ངེས་པར་དུ་ང་ཧུན་སུར་དུ་ཁོང་མཇལ་བར་ཤོག་ཅེས་བཀའ་ཕེབས་འདུག་པས་ངས་དུས་ཚོད་ཏག་ཏག་ལ་ཧུན་སུར་དུ་བསྐྱོད་དེ་ཁོང་མཇལ་ཁ་ཞུ་སྐབས།",
    "ད་དུང་གླང་བོ་ཆེའི་མཆེ་བ་ཆེན་པོ་ཞིག་དང་ཤིང་འབྲས་དང་ཞལ་ཟས་ཀྱང་མང་པོ་སྒྲིག་གཤམས་བྱས་འདུག་མི་རྣམས་ཀྱི་དོ་སྣང་ཆེ་ཤོས་བྱེད་ས་གཅིག་ཡོད་པ་དེ་ནི།",
    "དེའི་གཤམ་འོག་ཏུ་མ་ཎི་ལྷ་ཁང་ཆུང་ངུ་ཞིག་དང་སྐོར་ལམ་ཡོད་ཅིང་དེའི་ནང་མ་ཎི་ལག་སྐོར་བརྒྱ་སྐོར་ཞིག་བཞེངས་འདུག་སྐོར་ལམ་གྱི་དབུས་ཀྱི་མཐའ་དཀྱིལ་དུ་བོད་མི་དང་ས་གནས་ཡུལ་མིས་གཙོ་བོ་བྱས་པའི་ཚོང་ཁང་དང་དེབ་ཁང་།",
    "གཞན་ཡང་ཤིང་འབྲས་དང་ཚལ་རིགས་སྣ་ཚོགས་བཙོང་མཁན་གྱི་རུ་སྟར་བསྒྲིག་ནས་བསྡད་འདུག་ཅིང་།",
    "དེ་ཚོའི་ནང་ཁ་ཤས་ནི་དུས་རབས་བཅུ་གཉིས་དང་བཅོ་ལྔའི་སྐབས་བཞེངས་པའི་རིན་ཐང་བྲལ་བའི་བཟོ་རྩལ་གྱི་དངོས་རྙིང་ཡིན་འདུག་བར་ཁྱམས་སུ་བོད་ཀྱི་ས་བཀྲ་དང་།",
    "རྒྱ་བློ་བཟང་བཀྲིས་ཀྱིས་ངའི་ནང་དུ་ཡོང་ནས་མི་བསད་ཀྱི་འདུག་ཟེར་སྐད་བརྒྱབ་ཙང་།",
    "མགོ་ཡུར་ཏོག་ཙམ་འཁོར་གྱི་འདུག་ཅེས་ཞུས་པ་ཡིན།",
    "ཁྱེད་རང་ལ་སྤྲོད་ཟེར་ང་ལ་བསྐུར་གནང་བྱུང་།",
    "རྨ་ཁ་ཕལ་ཆེར་གསོས་ཤག་སྣང་དག་མི་འདུག་ཟེར་ཞུས་པ་ཡིན།",
    "ཏོག་ཙམ་མ་གཏོགས་གྲི་འགའ་ཤས་བརྒྱབ་ནས་རང་བསད་གྲབས་བྱས་འདུག་གང་།",
    "ད་བྱས་ན་ག་དུས་གཞིས་ཆགས་ལ་ལོག་ཕེབས་ཀྱི་ཡིན་པའ་ཞེས་འདྲི་དུས་རྒྱ་བློ་བཟང་བཀྲ་ཤིས་ཀྱིས་ཉི་མ་གཉིས་ཀྱི་མཇུག་ཏུ་འགྲོ་བགྱི་ཡིན།",
    "བློ་བཟང་བཀྲིས་ཡར་ལངས་ནས་བཀྲིས་བདེ་ལེགས་ཞེས་ལབ་ཀྱི་འདུག་ཁོ་བོས་མགྱོགས་པོ་ལག་པ་བཏང་བ་དང་ཆབས་ཅིག་ཞེས་རྒྱ་སྐད་བརྒྱབ་ནས་ང་ཚེ་རིང་དབངཕྱུག་ཡིན་ཟེར་ལབ་དུས།",
    "ཁྱེད་རང་བཞུགས་དང་ཞེས་ལབ་པ་ཡིན་པས།",
    "ང་ལ་ཇ་གང་བླུགས་ནས་ཅི་ནི་མང་དྲག་མི་འདུག་གང་།",
    "ངས་མིག་གཡས་པ་དེ་གང་འདྲ་འདུག་ཟེར་དྲིས་སྐབས།",
    "གཟུགས་པོ་ཆེན་པོ་རང་མེད་པ་དེས་གྲོད་ཁོག་ཆེན་པོ་ཆགས་པ་དེ་མངོན་གསལ་འདོད་པོ་འདུག་པས་ཕལ་ཆེར་གཟུགས་པོ་འཁོར་ནས་ཟླ་བ་བདུན་ཙམ་ཕྱིན་ཡོད་པ་ཚོད་དཔག་ཐུབ་ཀྱིས།",
