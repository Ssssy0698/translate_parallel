    "དཔའ་བོ་མཁའ་འགྲོ་རྣམས་ཀྱང་ད་ནང་འགྲོབའི་ཆས་བྱེད་འདུག།",
    "ཁམས་པ་མི་གསུམ་པོདེ་ལ་ཆད་ལས་ཤིག་ཕོག་ཡོད་པར་འདུག།",
    "དེ་ལས་ཆེར་བཀྲལ་ཏེ་བལྟས་པས་དྲུང་མི་བཞུགས་པར་འདུག།",
    "དགུང་ལོ་ལྔ་བཞེས་དུས་ནས་སེམས་ཀྱི་འགྲོ་འདུག་ངོ་མཁྱེན་ཞིང་བསྐྱེད་རིམ་ཡང་མཁྱེནལོ་བདུན་ནས་ཡི་གེ་འབྲི་ཀློག་ལ་བྱང་།",
    "དགུང་ལོ་བཞི་ལོན་ཙ་ན།",
    "གཞན་རྣམས་ཀྱིས་གཉིད་ཡུར་བ་མཐོང་འདུག་གསུངས།",
    "དེ་ཕྱིས་བདེ་ཆེན་དུ་སྒྲུབ་པ་བྱེད་པའི་བརྡར་འདུག།",
    "ཇོམ་ནགས་རྒྱལ་གྱི་གནས་དེ་མཁའ་འགྲོས་བྱིན་གྱིས་བརླབས་པ་ཡིན་པར་འདུག་སྙམ་པ་བྱུང་།",
    "དེ་ནས་དགུང་ལོ་ང་དྲུག་པ་ལ་བབ་པའི་ཚེ་དགའ་ལྡན་པ་མང་ཕེབས་ནས་ཕྱག་དཔེ་རྣམས་ཕྱག་རྟགས་ཀྱི་ས་མནན་ཞིང་ཕྱོགས་འདི་མྱུང་དུ་སླེབ་པར་འདུག་གསུང་ཁམས་པའི་གྲ་སློབ་ཀྱིས་ནན་གྱིས་སྤྱན་འདྲེན་ཞུས་པ་ལ།",
    "དེ་དྲུང་དུ་འབུལ་རྩིས་ཡིན་ཡང་ད་ལྟ་ཆུང་ཆུང་རང་ལས་མེད།",
    "དེར་ཉིན་བྱེད་གླིང་པའང་གཙང་ནས་ཕེབས་གྲུབ་འདུག་ཅིང་།",
    "འདུག་པ་དེ་སྐབས་གང་ཡིན་མ་ཤེས་འདུག་རྒྱལ་ཚབ་བས་ཆིབས་སྐྱེལ་བཅས་དཀར་རིགས་གཞུང་དུ་བཞུགས།",
    "ཕྱིས་ཡངས་བ་ཅན་གྱི་ཁྲིར་སླེབས་པར་འདུག།",
    "འོན་ཀྱང་ལུང་བསྟན་དང་རང་ཉམས་གཉིས་ཀ་བསྟུན་པའི་བར་ཆོད་ཆེ་བར་འི་དབྱར་སོས་ཙམ་ལ་གཙང་གཤིས་ཀྱི་ཡོད་པས་དེསེལ་གྲུབ་ན་བྱི་ལོགཏེར་འབྱིན་པར་བགྲོད་འདུན་ཞུ་ཞིང་ཉིད་ཀྱང་དེ་སྐབས་ཅི་ནས་ཕེབས་ཐུབ་བ་ཞིག་དང་།",
    "ལོ་མཇུག་དུས་གཏོར་སོགས་གནང་འོས་རྣམས་སྔ་འཁྱུད་ལྟར་སྐབས་སྐབས་སུ་ཡི་དམ་གྱི་བསྙེན་བསྒྲུབས་ཅི་རིགས་པ་མཛད་ཅིང་།",
    "སྒྲའི་རྒྱ་མཚོའི་ཟེར་བའི་སུ་པྲ་མཐའ་རྒྱས་པ་དེ་བློ་ནས་འདོན་འདུག།",
    "རྒྱལ་པོ་ཤིན་ཏུ་དད་པར་འདུག།",
    "ཟན་རིལ་ལས་ཀྱང་ཕེབས་ན་ལེགས་བཞེས་འདུག་པས་ཚང་མ་ཡིད་ཆེས་ཀྱིས་ཤར་ཕེབས་གནང་སྟེ་སྟོད་ལུང་མཚུར་ཕུའི་གདན་སར་བོད་ཟླ་བཞི་པའི་ཚེས་ཤར་ལ་ཕེབས་འབྱོར་བྱུང་བ་དང་།",
    "ཡང་སྲ་བརྐྱང་གོས་ཀྱི་གཏེར་ལྟ་བུར་འདུག་པས་དེ་ལ་བརྟེན་ནས་ཀོ་ལྤགས་ཀྱི་གཞིའོ།",
    "ད་ལྟ་བོད་ན་ཡོད་པའི་དགེ་སློང་མའི་རྣམ་འབྱེད་འདི་གཞི་ཐམས་ཅད་ཡོད་པར་སྨྲ་བའི་དགེ་སློང་མའི་རྣམ་འབྱེད་མ་ཡིན་པར་འདུག་སྟེ།",
    "ཙོག་ཙོག་པོར་འདུག་ཅིང་གསོལ་བ་བཏབ་པར་གྱུར་པ་གསུམ་དང་།",
    "འགྲེལ་ཆུང་ལས་ནི་ལ་ལ་ཞིག་མ་འོངས་ན་ཡང་གནས་གང་ལ་འདུག་པར་གནས་གནས་སུ་དྲི་ཞེས་པ་ཙམ་ལས་གང་ཟག་ལ་ཞུ་བར་གསལ་བར་མ་གསུངས་པ་དང་།",
    "འདུག་སྟེ་སྔགས་བཏབ་བམ།",
    "དུས་ཚིགས་ལ་ལྔར་ཕྱེ་བའི་དཔྱིད་ཟླ་གསུམ་པ་བཞི་པ་དབྱར་ཙམ་གྱི་ཟླ་བ་གཅིག་དང་གསུམ་པོ་དེ་དག་དུས་ཚིགས་བཞིར་ཕྱེ་བའི་དབྱར་ཟླ་ར་འབྲིང་ཐ་གསུམ་དང་དོན་གཅིག་པ་དང་།",
    "མི་གནས་པར་འདུག་པར་མི་བྱའོ།",
    "ཐ་ནའང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་ལ་འཛེམ་བག་དང་ལྡན་པའི་སྟེང་ཕམ་པས་མ་གོས་པ་ཞིག་ངེས་པར་དགོས་ཏེ།",
    "དེ་ཡང་འདུག་གནས་སུ་རྩ་བའི་སྐབས་ཀྱི་ཊི་ཀ་ལས།",
    "ཉེ་བར་འཁོར་དེས་ཀྱང་གཞན་ལ་གནས་པས་འདུག་པར་བྱའོ།",
    "བསྙེན་པར་རྫོགས་ནས་ལོ་བཅུ་མ་ལོན་པར་མི་གནས་པར་འདུག་པར་མི་བྱ་ཞེས་སྔར་སྨྲོས་ན།",
    "ཀོས་ཀོ་གཡས་པའམ་གཡོན་པ་གཅིག་ཁོ་ན་ཡོད་པའམ་ཀོས་ཀོ་མདུང་རྩེ་ལྟ་བུར་འདུག་པའི་ཀོས་སྨྱུང་དང་ནི།",
    "ཀོ་སྐོ་གཅིག་ཅེས་པ་ནི་ཀོ་སྐོ་མདུང་རྩེ་ལྟ་བུར་འདུག་པའོ།",
    "དམར་སེར་དང་དཀར་སྔོན་བཞི་ཁྲ་བོར་འདུག་པའི་མི་མཛེས་པའང་དེ་བཞིན་ནོ།",
    "འབྲེག་མཁན་ལ་བསྒོས་ནས་དགེ་སློང་རང་ལ་གཙུག་ཕུད་བྱེད༵་དུ་མི་གཞུག་གོ།",
    "མེད་ན་ཡུད་ཙམ་ཙོག་པུར་འདུག་ལ་ཁྲུས་རས་ཀྱིས་ཕྱི་བར་བྱའོ།",
    "ལུས་ཕྱིས་མེད་ན་ཡུད་ཙམ་ཞིག་སྟེ་ལུས་གཤེར་བ་མ་བསྐམས་ཀྱི་བར་དུ་ལུས་ལས་ཆུའི་ཐིགས་པ་མྱུར་དུ་འབྲུལ་བའི་ཕྱིར་ཙོག་པུར་འདུག་ལ་དེ་ནས་ཁྲུས་རས་ཀྱིས་ལུས་ཕྱི་བར་བྱའོ།",
    "མདུན་དུ་འདུག་སྟེ་མེར་མི་འདེའོ།",
    "འདིའི་ཐད་ཀྱི་རྩ་འགྲེལ་རྣམས་སུ་གྲངས་ས་མཐའ་ཅན་བྲིས་འདུག་པ་ཡིག་སྐྱོན་མིན་ན་ཇི་ལྟར་འགྲེལ་དཔྱད་པར་བྱའོ།",
    "ཟུང་དང་གོས་ཀྱི་གདང་མཐོན་པོ་ལ་འདུག་པའི་དངོས་པོ་དབབ་པ་ལ་སོགས་པས་སོ།",
    "གནས་པར་འོས་པ་ཡོངས་སུ་འཚོལ་བ་ལ་ཞུགས་པ་ནི་མེད་ན་མི་གནས་པར་འདུག་པ་ལ་ཉེས་པ་མེད་དོ།",
    "མི་གནས་པར་འདུག་པར་མི་བྱའོ་ཞེས་པའི་དམིགས་བསལ་ནི།",
    "ཉི་མ་གཅིག་ནི་འདུག་པར་བྱ་བ་ལས་ཆེད༵་དུ་གནས་བཅའ་བར་མི་བྱའོ།",
    "གཙུག་ལག་ཁང་དེ་ན་འདུག་ན་གནས་པས་ཉིན་པར་ལན་གསུམ་འགྲོ་བར་བྱའོ།",
    "གནས་འདུག་པའི་གཙུག་ལག་ཁང་དེ་ན་གནས་པ་ཡང་འདུག་ན་གནས་པས་གནས་ཀྱི་དྲུང་དུ་ཉིན་པར་ལན་གསུམ་དུ་འགྲོ་ཞིང་བྱ་བ་ཞུ་བར་བྱའོ།",
    "གནས་དེ་ལ་གནས་པས་བཞར་བར་བྱ་བ་སྟེ་ཐག་མི་རིང་བར་འདུག་པར་བྱའོ།",
    "གང་དང་ལྷན་ཅིག་ཏུ་གནས་གཅིག་ན་འདུག་པ་དང་ལམ་གཅིག་ཏུ་འགྲོ་བ་ལ་སོགས་པས་འདྲེས་པའི་སྨོན་འདྲིན་དང་།",
    "འདུག་པ་དང་ཕྱི་རོལ་ཏུ་ཡང་སོ་སོར་བརྟག་པར་བྱའོ།",
    "འདི་ལྟར་འདུག་པར་བྱ།",
    "འདུག་པར་མི་བྱའོ།",
    "གནས་ཀྱི་གོང་དུ་འདུག་པར་མི་བྱ་ཞིང་འགྲེང་བར་མི་བྱའོ།",
    "ཚངས་པར་སྤྱོད་པ་ལ་ཉེ་བར་གནས་པའི་སྡོམ་པ་མནོས་པ་དེ་སྒྲུབ་པའི་དོན་དུ་ཡང་དགེ་སློང་དབྱར་གནས་པར་ཁས་བླངས་པ་མཚམས་ཀྱི་ནང་ན་འདུག་པས་ཞག་བདུན་མན་ཆད་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "སྐྱེས་པ་དང་ནི་འདུག་མི་བྱ།",
