    "སྐབས་འདི་རེས་ཀྱི་ཡས་མས་སུ་དེ་འདྲའི་ཚོང་ལམ་འཛིན་མཁན་ཡོད་བཟོ་མི་འདུག་ད་དུང་གནམ་ཐང་བཟོ་རྒྱུ་བསྡད་ཡོད།",
    "ང་ཚོས་ཡ་ལན་བྱས་མེད་ཅིང་།",
    "ཁྱེད་རྣམ་པ་མེས་རྒྱལ་དུ་ཕྱིར་ལོག་ནས་བར་དེར་བཀའ་མོལ་ཐེངས་མང་པོ་གནང་ཡོད།",
    "བཀའ་མོལ་མང་པོ་གནང་བའི་དོན་འབྲས་ལ་ཁྱེད་རང་རྣམ་པའི་དགོངས་པར་ངོས་འཛིན་ཇི་ལྟར་གནང་མིན་ཀྲུང་དབྱང་ནས་སླར་ང་ཚོར་བཀའ་རྩད་ཡོང་རྒྱུར་བརྟེན་ང་ཚོས་གསལ་ཞུ་ཐུབ་པའི་དགོངས་ཚུལ་གསུང་རོགས་གནང་ཟེར།",
    "པེ་ཅིང་གི་དབུ་ཁྲིད་དཔོན་རིགས་ཁག་དང་མཇལ་མོལ་མང་དག་ཅིག་བྱུང་བ་རེད།",
    "དེར་མ་ཟད་ལོ་སྔོན་མའི་ནང་བོད་ཕྱི་ནང་གང་སར་ངོས་འཛིན་མི་བདེ་བའི་གནས་ཚུལ་འགའ་རེ་ཕན་ཚུན་གཉིས་ཀར་བྱུང་ཡོད་པ་དེ་དག་གི་ཐད་ལ།",
    "དེ་ནི་བོད་མི་རིགས་ཀྱི་འདོད་མོས་ལ་ཐག་གཅོད་བྱུང་མེད་པ་འདིས་གསལ་པོ་མཚོན་གྱི་ཡོད།",
    "མེད་རྣམས་དགའ་མོས་བྱས་ཡོད་སྲིད་ཀྱང་།",
    "མི་མེད་རང་མེད་དུ་ད་བར་གནས་པ་ལ་སོགས་པས་བོད་མི་རིགས་ཡོངས་སུ་རྫོགས་པའི་བསམ་བློར་འདོད་པ་ཡེ་ནས་མི་ཁེངས་པར་རེ་བ་ཁོ་ནའི་འོག་བསྡད་ཡོད་པ་དངོས་ཡོད་བརྗོད་མ་དགོས་པ་རེད།",
    "མུ་མཐུད་ཀྲུང་དབྱང་ལ་བཀའ་མོལ་ཞུ་འདོད་ཡོད།",
    "རིམ་པས་ཆ་རྐྱེན་ཚང་བའི་དུས་ཚོད་བྱུང་ན་བཀའ་མོལ་གནང་ཆོག་གི་རེད།",
    "ཀྲུང་དབྱང་གིས་ཚོང་རྒྱག་གི་མ་རེད།",
    "བོད་ནང་རྐྱེན་ངན་འོག་ཤི་སྐྱོན་བྱུང་བའི་གྲངས་ཐོ་ཞིབ་འཇུག་ཆེད་རང་རེ་ཕྱོགས་ཕན་ཚུན་ཐུན་མོང་གི་ཐོག་ཚོགས་ཆུང་ཞིག་བཙུགས་ནས་བསྐྱར་ཞིབ་བྱས་ན་ཞུས་པ་དེ་ཡོང་གི་ཡོད་དམ་བརྗོད།",
    "མི་མང་པོ་ཤི་སྐྱོན་བྱུང་ཡོད་པ་རེད།",
    "དེ་འདྲའི་མུ་ནས་བཀའ་མོལ་མཚམས་འཇོག་བྱས།",
    "ལམ་མཐུད་མཚམས་བར་ཕེབས་སྐྱེལ་པ་ཁག་ཅིག་དང་ཁ་གྱེས་ཏེ་ཧོང་ཀོང་དུ་བསྐྱོད་དེ་དགོང་མོར་མེ་ར་མ་མགྲོན་ཁང་དུ་བསྡད།",
    "རྒྱ་ནག་གི་དཔོན་ཁག་དང་སྔ་རྗེས་གླེང་མོལ་ཇི་བྱས་སྐོར་ཞིབ་གནས་སྙན་དུ་གསོལ།",
    "སོང་།",
    "ལས་དོན་ཡག་པོ་བྱུང་འདུག་འབྲེལ་ལམ་མུ་མཐུད་གནས་ཡོད་པ་དེ་གལ་ཆེན་པོ་རེད།",
    "བྱེད་བདེ་པོ་ཆགས་པ་རེད་ཅེས་ཕེབས་པ་དང་།",
    "ཕྱི་ནང་མི་སྣ་མང་པོས་རྒྱ་བོད་འབྲེལ་བའི་གནས་སྟངས་གསལ་པོ་བཟོ་དགོས་ཞེས་བརྗོད་མཁན་མང་པོ་ཡོད་པར་ཇི་དགེའི་སྐོར་བཀའ་མོལ་མཛད་པར།",
    "དུས་དེ་སྐབས་སུ་མི་ཕལ་ཆེ་བས་བོད་རང་བཙན་གསུང་གི་མེད་པའི་དོགས་གནས་ཆེན་པོ་ཡོད་པ་དང་།",
    "ཕྱི་རྒྱལ་གྱི་མི་སྣ་འགའ་ཞིག་གིས་གནས་ཚུལ་གསལ་པོ་ཤེས་ཐབས་སུ་བོད་རང་བཙན་རྩོད་ལེན་གསལ་པོ་མི་འདུག་ལངས་ཕྱོགས་གསལ་པོ་བྱུང་ན་ཁོང་ཚོས་ནུས་ཤུགས་ཆེན་པོ་སྤེལ་རྒྱུ་ཡོད་ཚུལ་ཤོད་མཁན་ཡང་ཡོད།",
    "ཕལ་ཆེར་མི་སྣ་དེ་ཚོའི་སྐྱེས་ཁུངས་དང་བོད་དོན་ར་མི་འཕྲོད་པས་ཡིན་ཚུལ་བརྗོད་མཁན་ཡང་བྱུང་མོད།",
    "འོན་ཀྱང་རང་བཙན་གསུང་གི་མེད་པ་ཡང་གསལ་པོ་བཟོ་གནང་གི་ཡོད་པ་མ་རེད།",
    "ང་ཚོས་བོད་མིར་དགོངས་དག་རྒྱབ་སྐྱོར་བྱེད་ཐུབ་ཀྱི་མེད་ཅེས་ཞུ་དགོས་པ་ཆགས་ཀྱི་རེད།",
    "རྒྱ་མིའི་དགོས་དོན་ངོ་མ་ཞིག་ཡིན་པར་ངོས་འཛིན་བྱས་ནས་ཁས་ལེན་ནམ་ཡང་བྱེད་ཀྱི་མིན་ཟེར་གྱི་ཡོད་རེད།",
    "གངས་ཅན་བོད་ཀྱི་རྒྱལ་ཁབ་ཀྱི་གཞུང་ངོ་མ་ཞིག་ཡིན་མོད།",
    "དེ་ནས་ཉིན་རེར་རེ་རེ་འཐུང་བས་སེང་དྲག་ཏུ་གྱུར་སོང་།",
    "ཁོང་ཚོས་པེ་ཅིང་དུ་རྒྱ་ནག་གི་འགོ་ཁྲིད་ཚོར་གོ་བསྡུར་དང་བསམ་ཚུལ་བརྗོད་རེས་ཀྱི་མཇལ་འཕྲད་ཡག་པོ་བྱུང་འདུག་པ་མ་ཟད།",
    "ཚད་ཚད་བསྡུར་བསྡུར་གྱིས་འབྲེལ་ཕམ་རྒྱུན་སྐྱོང་བྱེད་སྒོ་དེ་འདྲ་ཞིག་རེད།",
    "ངོས་རང་གཏན་དུ་ཕྱིར་ལོག་བྱ་རྒྱའི་སྐོར་གླེང་གཞི་རྩ་བ་ནས་ཆགས་ཀྱི་ཡོད་པ་མ་རེད།",
    "རྒྱ་ནག་ཕྱོགས་ནས་ང་གཏན་དུ་ཕྱིར་ལོག་བྱས་ཏེ་པེ་ཅིང་དུ་བསྡད་དགོས་ནན་བརྗོད་བྱས་པ་དེ་རང་གི་བོད་ནང་ལ་མུ་མཐུད་དེ་རྙོག་གྲ་ཡོད་པ་གསལ་པོར་བསྟན་པ་རེད།",
    "རྒྱ་ནག་གི་དཔོན་རིགས་ཚོས་ད་ལྟའི་བསམ་འཆར་བཏོན་པ་དེས་རྟགས་མཚན་ག་རེ་སྟོན་གྱི་ཡོད་དམ་ཟེར་ན།",
    "ཁོང་ཚོས་བོད་ཀྱི་གཞི་རྩའི་གནས་ཚུལ་དེ་ད་དུང་མ་ཤེས་པའམ།",
    "ཡིན་ནའང་ཕྱི་ལོ་༡༩༨༥ ལོར་འགྲོ་ཐུབ་ཀྱི་མ་རེད་ཅེས་སྩལ།",
    "མངོན་སུམ་དུ་མེ་མདའ་བརྒྱབ་སྟེ་སྐུ་གཤེགས་པ་བློ་ཕམ་ཆེ་བའི་རྐྱེན་ཆག་བྱུང་བ་རེད།",
    "སྐབས་དེར་བཀའ་ཤག་ནས་དང་པོར་སྐུ་ཁམས་དང་སྐྱེས་ཡོང་རེའི་ཞབས་བརྟན་འབད་སྒྲུབ་ཛ་དྲག་གིས་གནང་བ་དང་།",
    "རྒྱ་གར་གཞུང་གི་ཡར་རྒྱས་བརྟན་རླིང་ནུས་སྟོབས་བཅས་ལ་ཐུག་པ་ལྷང་ངེར་ཚོར་བས།",
    "རང་ཉིད་ནི་བོད་མི་རང་ཡིན་མོད།",
    "མགོ་ཆག་སྐྱོར་མཁན་སྐེ་དཀྱོག་ཟེར་བ་ལྟར་བོད་མིའི་རེ་བ་དུས་སྐད་ཅིག་ཏུ་འགྱུར་རྒྱུ་ལས་མི་སྣང་བ་གྱུར་པ་ནི་ངོས་རང་གི་ཚོར་སྣང་བྱུང་།",
    "ཕྱི་འབྲེལ་ལས་ཁང་གི་དཔོན་རིགས་ཨ་རིའི་ཡེ་ཤུའི་བླ་ཆེན།",
    "རྒྱ་གར་གཞུང་གི་སྲིད་བློན་གསུམ་པ་ཨིན་དྷར་གྷན་དྷི་རྐྱེན་འདས་བྱུང་ཚབ་ཏུ་རྒྱ་གར་གཞུང་འཛིན་ཀོང་རེ་སི་ཨ་ཡེའི་ཚོགས་པའི་དྲུང་ཆེ་ར་ཇིབ་གྷན་རྡི་སྲིད་བློན་དུ་ཚོགས་པ་རང་ཁོངས་ནས་མང་མོས་འོས་འདེམས་ཞུས་འདུགདེ་རྗེས་་གོང་ས་མཆོག་ལྷོ་ཕྱོགས་གཞིས་ཁག་དང་།",
    "གསར་འགོད་ལྷན་ཚོགས་ཐོག་གོང་ས་མཆོག་བོད་དང་རྒྱ་ནག་ལ་གཟིགས་སྐོར་དུ་ཕེབས་ཐུབ་མིན་སྐོར་དྲིས་ལན་སྩལ་བ་སོགས་ཆིབས་བསྒྱུར་གྱི་མཛད་དོན་ཁག་ལེགས་གྲུབ་ཕུན་སུམ་ཚོགས་པ་བྱུང་ཡོད་པ་དང་།",
    "ཡར་ཕྱོགས་༡༩༨༥ ཟླ་༡ ཚེས་༡༡༡༢ཉིན་གཉིས་རིང་འདེམས་ཐོན་བྱུང་མ་ཐག་པའི་རྒྱ་གར་གྱི་སྲིད་བློན་ར་ཇིབ་གྷན་རྡི་མཆོག་གི་བཞུགས་གནས་སུ་ཆེད་ཕེབས་འཚམས་འདྲི་མཇལ་འཕྲད་ཞིབ་ལྷོད་གནང་བ་མ་ཟད།",
    "རྒྱ་གར་གཞུང་གི་གལ་ཆེའི་དཔོན་རིགས་འགའ་ཤས་དང་འཚམས་འདྲི་མཇལ་འཕྲད་གནང་བ་རེད།",
    "སྐབས་དེ་དུས་རྒྱ་གར་གི་མགྲོན་ཁང་ཆེན་མོ་ཨ་ཤོ་ཀའི་ནང་དཔལ་ས་སྐྱ་པ་ཆེན་པོ་སྐྱབས་མགོན་བདག་ཁྲི་རྡོ་རྗེ་འཆང་ཆེན་པོ་མཆོག་མཇལ་བཅར་ཞུས་པ་དང་།",
    "ཁོང་གི་རྗེས་འབྲང་རྣམས་ཚུར་ལོག་གཏན་སྡོད་བྱས་ན་དགའ་བསུ་ཡོད།",
    "དམིགས་ཡུལ་ནི་རྒྱལ་ཁབ་གོང་བུ་གཅིག་གྱུར་སྲུང་སྐྱོབ་གནང་བའི་རེ་བ་ཡིན།",
    "གྲོས་མོལ་བྱས་པ་བརྒྱུད་རྒྱལ་ཡོངས་ཆབ་སྲིད་ཀྱི་ཀྲུའུ་ཞི་གཞོན་པ་ཡང་གནང་ཆོག་པ་དང་།",
    "ད་ཆ་བོད་དུ་ལོ་ན་གཞོན་པ་འཚར་ལོངས་བྱས་ཏེ་ལས་ཀ་ཡག་པོ་བྱེད་ཀྱི་ཡོད་རེད།",
    "བོད་དུ་གཟིགས་སྐོར་རྟག་པར་ཕེབས་ཆོག་ང་ཚོས་ཁོང་གི་རྗེས་འབྲང་རྣམས་ལ་བཀོད་སྒྲིག་འོས་འཚམས་གནང་གི་རེད།",
    "དེ་དག་གི་དགག་ལན་དུ།",
    "དེ་ནི་བོད་མི་རིགས་ཀྱི་འཐབ་རྩོད་དེ་ངོ་བོ་ཆུང་བསྒྱུར་ཆེད་གོང་ས་མཆོག་སྐུ་སྒེར་གྱི་གནས་ཚུལ་ཞིག་ཏུ་སྟོན་ཐབས་བྱས་པ་རེད།",
    "རྒྱ་ནག་གི་འགོ་ཁྲིད་ཚོས་མ་གོ་མ་ཤེས་པའི་ཟིན་པ་དེ་ལ་དོན་གྱི་ཕན་ཐོགས་གང་ཡང་ཡོང་གི་མ་རེད།",
    "བོད་མི་ས་ཡ་དྲུག་གིའདོད་བློ་ཁེངས་པའི་བདེ་སྐྱིད་བོད་རང་བཙན་གཙང་མ་དེ་ཡིན།",
    "བོད་མི་ལྟ་ཅི་འཛམ་གླིང་མི་མང་རྣམས་ཁྲེལ་བགད་ཤོར་བའི་གནས་ཤིག་རེད།",
    "དེ་ནི་རྒྱ་མིའི་འགོ་ཁྲིད་ཚོའི་རྨི་ལམ་སྐྱིད་པོ་ཞིག་རེད།",
    "རྒྱ་མིས་འདས་པའི་གནས་ཚུལ་བརྗེད་དུ་བཅུག་ན་དགའ་ཡི་རེད་ཟེར་བ་དེ།",
    "ཁོང་ཚོར་བོད་ཀྱི་རྩོད་རྙོག་སེལ་རྒྱའི་བསམ་འདུན་རྩ་བ་ནས་མེད་པར་བརྟེན་ང་ཚོས་བོད་གཞུང་ལ་དགོངས་བཞེས་བསྐྱར་ནན་ཞིག་གནང་དགོས་ཀྱི་འདུག་ཅེས་ཞུ་རྒྱུ་ཡིན།",
    "བར་ལམ་ཞིག་ནས་གོང་ས་མཆོག་གིས་བོད་དང་བོད་མིའི་གནས་སྟངས་རྟོག་ཞིབ་དང་།",
    "བོད་དོན་སྐོར་གྲོས་མོལ་ཆེད་བོད་དང་།",
    "བོད་ཀྱི་རྒྱལ་རབས་ལོ་རྒྱས་ཡོངས་གྲགས་ཁག་ཀྱང་བརྩི་མེད་ཐོག་བོད་འདི་རྒྱ་ནག་གི་ཆ་ཤས་སུ་ངོས་འཛིན་དང་།",
    "ང་ཚོས་མཛུབ་སྟོན་བྱ་རྒྱུར།",
    "གོང་ས་མཆོག་ལ་དགའ་ཞེན་བརྩི་བཀུར་རེ་སྒུག་ཞུ་བཞིན་དུ་ཡོད་པ་དེ་ནི།",
    "ང་ཚོའི་བོད་དོན་འཐབ་རྩོད་ཀྱི་རྨང་གཞི་གཞོམ་གཞིག་བྲལ་བ་ཞིག་ཡིན།",
    "བོད་མི་ས་ཡ་དྲུག་གི་འདོད་དོན་ཡོངས་སུ་མ་གྲུབ་བར་གོང་ས་མཆོག་བོད་དུ་གཏན་བཞུགས་ཕྱིར་ཕེབས་མཛད་ཀྱི་མ་རེད་ཅེས་དང་།",
    "དེང་སྐབས་རྒྱ་ནག་གིས་ཆབ་སྲིད་བརྟན་ལྷིང་དང་།",
    "བོད་དོན་ནི་བོད་མི་ཚོས་ཐག་གཅོད་བྱེད་དགོས་པས་གབ་རེས་འུར་རེས་ཞེས་པའི་སྐད་ཆ་ཡོང་དོན་མེད།",
    "ད་བར་གབ་རེས་འུར་རེས་རྒྱ་ནག་གཞུང་གིས་བྱས་ཡོད་པ་ལས་བོད་མིས་བྱས་པ་མེད།",
    "གོང་ས་མཆོག་དང་བཙན་བྱོལ་བོད་མི་རྣམས་ཕྱིར་ལོག་ཡོང་རྒྱུར་རྒྱ་ནག་གིས་དགའ་བསུ་ཞུ་བའི་རྣམ་པ་ཞིག་ཡོད་ཀྱང་།",
    "བོད་ཀྱི་བདེན་དོན་མཐའ་གསལ་ངེས་གཏན་ཞིག་མ་བྱུང་བར་རྒྱ་ནག་གི་གཡོ་འོག་ཏུ་མི་ཚུད་པར།",
    "གལ་སྲིད་གོང་ས་མཆོག་གཟིགས་སྐོར་ཞིག་ཏུ་ཕེབས་རྒྱུའི་དགོས་འདུན་ཆ་རྐྱེན་ཚང་ན་ལས།",
    "གྲོས་མོལ་བྱ་རིམ་ནང་རང་ཉིད་ཀྱི་བསམ་ཕུགས་ངོ་མ་དེ་འགྲུབ་ཐབས་ལལས་གཡོལ་དུ་མེད་པ་གཅིག་བཅས་ཆ་མི་མཚུངས་པ་གཉིས་སུ་གྱུར་སྟེ།",
    "རྒྱ་བསྐྱེད་རིང་ལུགས་ཀྱི་སྲིད་བྱུས་ནམ་ཡང་མི་འགྱུར་བ་གསལ་པོ་རེད།",
    "རྒྱ་ནག་ཕྱོགས་ནས་རང་བཙན་ཁས་ལེན་བྱེད་ཀྱི་མེད་པར་བརྟེན་རྩ་བའི་གྲོས་མོལ་བྱེད་པའི་རྨང་གཞི་དང་ཆ་རྐྱེན་གཏན་ནས་མི་འདུག་དེས་ན་ད་ཆ་བོད་གཞུང་ནས་རྒྱ་དམར་མཉམ་དུ་འབྲེལ་ལམ་གནང་རྒྱུ་དེ་མཚམས་འཇོག་གཙང་མ་གནང་དགོས་ཀྱི་འདུག་དེ་བས་གོང་ས་མཆོག་གི་མཛད་འཕྲིན་འཛམ་གླིང་ཡོངས་སུ་ཁྱབ་པའི་འོག་བོད་མི་ཡོད་དོ་ཅོག་ཆིག་སྒྲིལ་སྔར་བས་ཆེ་བ་བྱས་ཏེ་འཕྲལ་སེལ་དཀའ་ངལ་ལ་མགོ་མི་སྒུར་བར་ཕུགས་བསམ་མངོན་དུ་འགྱུར་ཆེད་འབད་བརྩོན་བྱེད་དགོས།",
    "པའི་རྒྱལ་ཁ་ལེན་རྒྱུའི་ཕྱོགས་སུ་གོམ་བགྲོད་བྱེད་དགོས་པའི་དུས་ལ་སླེབས་འདུག་དེ་ནི་ང་ཚོའི་བསམ་འདུན་ཞིག་ཡིན་ལ།",
    "བོད་རྒྱ་ཆེའི་མི་མང་ཚོགས་ཀྱི་བསམ་འདུན་ཞིག་ཀྱང་ཡིན།",
    "ང་ཚོའི་འདོད་བྱ་དང་འཐབ་རྩོད་ནི་བོད་ཆོལ་ཁ་གསུམ་ཁྱོན་ལ་རང་བཙན་གཙང་མ་ཞིག་ཡིན།",
    "ང་ཚོར་བོད་དགོས།",
    "ང་ཚོ་རྒྱ་གར་ས་གནས་ཁག་དང་།",
    "རང་ཉིད་མདུན་ལམ་རང་གིས་ཐག་གཅོད་བྱེད་པ།",
    "བོད་མི་ས་ཡ་དྲུག་གིས་གོང་ས་མཆོག་ཡང་དག་པའི་དབུ་ཁྲིད་ལ་དང་ལེན་མཐའ་གཅིག་ཏུ་ཞུ་བ་ལས།",
    "རྒྱ་ནག་གི་བཙན་འོག་ཏུ་སྡོད་འདོད་རྩ་བ་ནས་བྱེད་ཀྱི་མེད།",
    "དེར་བརྟེན་རྒྱ་ནག་གི་འགོ་ཁྲིད་ཚོས་རང་ཉིད་ཀྱི་འཁྲུལ་སྣང་ལ་བདེན་འཛིན་མ་བྱས་པར།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོའི་དབུ་ཁྲིད་འོག་བོད་རང་བཙན་གཙང་མ་མ་ཐོབ་པར་མུ་མཐུད་འཐབ་རྩོད་མཐའ་འཁྱོལ་བ་བྱ་རྒྱུའི་སེམས་ཐག་གཙང་མ་བཅད་ཡོད།",
    "བོད་མི་མང་གི་དགོས་འདུན་རང་བཙན་ཡིན་པ།",
    "རང་བཙན་གཙང་མ་ཞིག་མ་བྱུང་བར་འཐབ་རྩོད་མཇུག་འཁྱོངས་བྱ་རྒྱ་ཡིན་པ།",
    "རྒྱ་ནག་གིས་ཁ་མཁས་འཇམ་སྙན་ལ་མགོ་བོ་འཁོར་མི་སྲིད་པ་བརྗོད་ཚིག་ཡ་མ་ཟུང་དུ་ར་འཕྲོད་ཡོད་གནས།",
    "བོད་མི་ས་ཡ་དྲུག་པོ་རྒྱ་ནག་གི་བཙན་འོག་ཏུ་སྡོད་རྒྱུའི་འདོད་པ་ཡེ་ནས་མེད་པ།",
    "བོད་ཆོལ་ཁ་གསུམ་གྱི་མི་མང་གཅིག་སྒྲིལ་དམ་གཙང་གིས་སྔར་བས་ནུས་ཤུགས་འདོན་ཏེ།",
    "དེ་དག་གི་ཐད་ལ་ངོས་རང་གི་བསམ་ཚུལ་དུ་བྱས་ན།",
    "བརྗོད་དོན་ཚང་མ་བདེན་དོན་དངོས་ཤིག་རེད་ལ།",
    "བདེན་པར་འདོད་ཚུལ་འཛིན་པ་དེའང་དངོས་དོན་ཞིག་རེད།"
  ]
