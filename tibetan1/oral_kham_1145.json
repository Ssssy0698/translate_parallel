    "འོས་ལངས་ཀྱི་གནས་ཚུལ་ཕྱི་རུ་ཁྱབ་འདུག་ཅེས་བཤད།",
    "གསར་བརྗེར་ངོ་རྒོལ་བྱེད་པའི་དམག་དཔུང་ཕྱོགས་གང་ས་ནས་འཐོན་བཞིན་འདུག་པས།",
    "དམག་དཔུང་འདི་དུས་ངེས་མེད་དུ་རྩ་མེད་དུ་གཏོང་བའི་ཉེན་ཁ་འདུག་འདི་འདྲའི་ཛ་དྲག་ཆེ་བའི་གནས་ཚུལ་ལ་གདོང་གཏུག་སྐབས།",
    "མི་སེམས་ལ་གཡོ་འགུལ་ཐེབས་འདུག་པས།",
    "སྨྱུག་ཞྭ་ཞིག་རྒྱབ་ཏུ་ཁུར་འདུག་པ་དང་།",
    "མི་རྣམས་ཀྱིས་མགོ་བོ་སྒུར་ནས་བསམ་བློ་གཏོང་ཞོར་ནན་ཏན་ངང་བདམ་གསེས་བྱེད་ཀྱིན་འདུག་འགྲོའམ་འདུག་ངེས་པར་དུ་རང་ཉིད་ཀྱི་འགུལ་སྐྱོད་ཀྱིས་ལན་འདེབ་དགོས།",
    "ཁ་ཤས་ཀྱིས་ལྐོག་ཏུ་ལྡབ་ལྡིབ་ཅིག་འཆད་ཀྱིན་འདུག་ལ།",
    "འོས་ལངས་དམག་སླེབས་དུས་མཁར་སྒོ་ཕྱེ་འདུག་ལ།",
    "མི་ལྷག་དེར་ལངས་འདུག་དམག་དཔུང་གྲལ་བསྒྲིགས་རྗེས།",
    "ཁྲིན་དབྱིས་མིག་གཉིས་འབུར་ཚུགས་ཀྱིས་དམག་དཔུང་ཁྲོད་ཀྱི་དམིགས་ཡུལ་བཟང་པོ་མེད་པའི་ངན་ཤུགས་དེ་དག་ལ་བལྟས་འདུག་ཁ་ཤས་ཀྱི་ལག་ཏུ་ད་དུང་འཕྲོག་ཡོང་བའི་དངོས་པོ་འདུག་ལ།",
    "གལ་ཏེ་དམག་མིར་བརྙས་བྱེད་མཁན་འདུག་ན།",
    "གསར་བརྗེ་ལ་རྒྱལ་ཁ་ཐོབ་པར་ཁོ་རང་ཡིད་ཆེས་བརྟན་པོ་འདུག་ཚང་མ་དམག་སྤྱི་ཀྲུའུ་ལགས་ཀྱི་རྗེས་སུ་འདེད་པར་ང་ལ་ཡིད་ཆེས་ཡོད།",
    "མ་བསམས་ས་ནས་འཁྲུས་ཁང་ནང་དུའང་གནས་ཚུལ་འདི་འདྲ་གལ་ཆེན་འདུག་འདི་ནི་དོན་ངོ་མའི་ལྕགས་ལམ་བརྡོལ་བརྡོལ་རྒྱུགས་ཀྱང་རྩད་མ་ཆོད།",
    "རྐང་པར་ཀོ་པའི་འཇུར་རྟ་སེར་པོ་ཞིག་གྱོན་འདུག་ལག་ཏུ་ཁུག་མ་ཞིག་བཟུང་ཡོད་པས།",
    "ཧུའུ་ནན་ལྷོ་ཕྱོགས་ནས་འདུག་མི་བཟོད་པའི་གནས་ཚུལ་གོ་བས།",
    "ཀྲུའུ་ཏའེ་ཡི་འགོ་ཁྲིད་པའི་དམག་དཔུང་ཀའེ་ཏུའུ་ས་ཆར་ཐོན་འདུག་ཚུལ་ཡར་ཞུ་བྱས།",
    "གནམ་ངོས་ན་ཡི་གེ་འདི་དག་འདུག་གམ་ཞེས་དྲིས།",
    "ཅུང་མ་འགོར་བར་ཁོ་རང་ཉིད་ནས་འཕྲིན་ཡིག་འབྲི་ཐུབ་པ་བྱུང་།",
    "ཁྲིན་ཀོ་ཧུའེ་དང་གོ་མིན་ཏང་གཉིས་ཁྱི་སྤྱང་ངན་འབྲེལ་གྱིས་མི་སེར་ལ་གཉའ་གནོན་བྱེད་ཀྱི་འདུག་ལ།",
    "དགྲ་བོས་གྲ་སྒྲིག་བྱས་མ་ཚར་གོང་རང་འགུལ་གྱིས་ཕར་རྒོལ་བྱས་ཏེ།",
    "དུས་ཚོད་འགོར་འགྱངས་བྱས་མི་ཆོག་ཅེས་པའི་ཉེན་བརྡ་བཏང་འདུགསྤྱི་ཁྱབ་དམག་དཔོན་གྱིས་ཡུན་རིང་བསམ་གཞིག་བྱས་མཐར།",
    "དགྲ་བོའི་ཙུང་ཏུའེ་རུ་ཁག་སྔ་རྗེས་གཉིས་ཀྱི་བར་ཐག་ལ་ལེ་བར་བརྒྱ་ལྷག་འདུག་ཙུང་ཏུའེ་རུ་ཁག་རྗེས་མ་ཡང་རི་ལམ་སྟེང་བསྐྱོད་དགོས་པས་ལམ་བར་ནས་ཀྱང་དུས་ཚོད་མང་པོ་འགོར།",
    "ཀ་ཆུས་ཆུ་བོ་རྒྱས་འདུག་པར་ཁ་གཡར་ནས་མུ་མཐུད་བྱང་དུ་མི་བསྐྱོད་པར།",
    "སྤྱི་ཁྱབ་དམག་སྤྱི་ཀྲུའུ་ཏའེ་ཡིས་ལྷན་པ་བརྒྱབ་ཡོད་ཅིང་སྤུས་ཀ་ཞན་པའི་དམག་ལྭ་གྱོན་འདུག་ལ།",
    "ཟས་ཐུན་གཅིག་ལ་ཟས་ན་ག་ལ་འགྲིག་ཆེས་དཀའ་སྡུག་ཆེ་བའི་དུས་ད་དུང་ཐོན་མི་འདུག་ཅུང་མཚམས་བཞག་རྗེས།",
    "ལ་ལ་བཙོག་འདུག་རྩྭ་ས་ཡང་ཇ་ཁང་ཆེན་པོ་ཞིག་ཏུ་གྱུར་འདུག་སྤྱི་ཁྱབ་དམག་སྤྱི་ཀྲུའུ་ཏའེ་ཡང་ཚང་མ་དང་མཉམ་དུ་སྔོ་ཚོད་དཀར་ཡོལ་བཀང་བཟུང་ནས་སྲུང་དམག་འགའ་དང་མཉམ་དུ་བཙོག་སྟེ་ཡིད་ཚིམ་པའི་ངང་ཟས་ཟ་བཞིན་འདུག་བློ་མཐུན་ཚོས་ཀྲུའུ་ཏའེ་ཡིས་ཚང་མ་དང་མཉམ་དུ་སྔོ་ཚོད་ཟ་བཞིན་འདུག་ལ།",
    "འབྲས་ཁུ་འཁྱག་འདུག་ཚང་མས་ལིག་ཞིན་དང་ཀྲུའུ་དམག་དཔོན་གཉིས་ཅུང་ཆ་རྒྱུས་ཡོད་པ་ཤེས་པས།",
    "མི་ཚང་མས་མིག་ཆེ་རུ་ཕྱེ་ནས་དམག་སྤྱི་ཀྲུའུ་ལགས་ལ་ལྟ་བཞིན་འདུག་ལ།",
    "བྲག་བར་དུ་བཞུར་བཞིན་པའི་ཆུ་ཕྲན་གྱིས་གུ་ཅོ་སྒྲོག་བཞིན་འདུག་སྤྱི་ཁྱབ་དམག་དཔོན་གྱི་སྨིན་མ་ཅུང་འགུལ་ཙམ་བྱས་ལ།",
    "ཡིད་ཚིམས་པའི་ངང་དངོས་གནས་ཡག་པོ་ལས་འདུག་ཅེས་བཤད།",
    "ས་འདི་ནས་འདུག་པའི་གོ་སྐབས་དང་བསྟུན་ནས་ལུས་རྩལ་འགྲན་བསྡུར་ཞིག་སྤེལ་ཏེ།",
    "འཇར་དམག་སླེབས་སར་མེ་ལྕེ་ལྷོག་ལྷོག་ཏུ་འཕྱུར་བཞིན་འདུག་ལ།",
    "ས་གང་སར་རོ་ཡིས་ཁེངས་འདུག་གཅན་གཟན་ལྟ་བུའི་དམག་དཔུང་འདིས་གསོད་སྲེག་འཕྲོག་བཅོམ་གྱི་བྱ་བ་གང་མང་བསྒྲུབས།",
    "དམག་དཔུང་འདི་ནི་འགོ་ནས་མཇུག་བར་དུ་ང་རྒྱལ་གྱིས་ཁེངས་འདུག་ལ།",
    "ཡིན་ནའང་ཁོ་ཚོར་དམག་འཐབ་བཙན་པོ་ཞིག་རྒྱག་དགོས་པའི་བསམ་བློའི་གྲ་སྒྲིག་མི་འདུག་པའོ་དབྱི་ཡི་སྐད་ཆ་ལྟར་ན།",
    "བྱང་ངོས་སུ་སྐས་ཞིང་རིམ་པ་ལྟར་ཆགས་འདུག་ཕན་ཝུའུ་གཞུང་ལམ་ནི་མིན་ཀྲང་ཆུ་བོའི་ལྷོ་ངོས་ཀྱི་རི་འདབས་སུ་ཆགས་ཡོད།",
    "དམག་ཆས་སོགས་འཁྱེར་བའི་དམག་དཔུང་ད་དུང་པེ་ཚོ་རི་བོར་འདུག་ལ།",
    "མ་གྲོང་ན་རྗེས་སྲུང་དམག་དཔུང་ཉུང་ངུ་ཞིག་ལས་མི་འདུག་སྐབས་དེར།",
    "སྐབས་སྐབས་ལ་རྒྱང་ཤེལ་གྱིས་ལུང་བའི་ངོས་གཉིས་ཀྱི་དེའུ་འགོར་བལྟ་བཞིན་འདུག་དགྲ་དམག་ནི་ང་རྒྱལ་དང་སྤོབས་པས་ཁེངས་ཡོད།",
    "ཁ་ཤས་ཀྱིས་འུར་རྒྱག་བཞིན་འདུག་ལ།",
    "ཁ་ཤས་ཀྱིས་ངག་སྒོ་ཆེ་རུ་ཕྱེ་སྟེ་གླུ་དབྱངས་གྱེར་བཞིན་འདུགདགྲ་བོའི་སྐྱུག་བྲོ་བའི་རྣམ་པ་མཐོང་དུས།",
    "ལུང་པའི་གཏིང་རུམ་དུ་བཀག་ཡོད་པའི་དགྲ་བོ་ཉུང་ངུ་དེ་ཚོས་ད་དུང་འགོག་རྒོལ་བྱེད་རྩིས་འདུག་སྐབས་དེར།",
    "དགྲ་ལག་ནས་ཐོབ་པའི་དངོས་རྫས་སྤུངས་ན་རི་བོ་ཆུང་ཆུང་ཞིག་ལྟ་བུ་འདུག་དམག་སྤྱི་ཀྲུའུ་ལགས་ཀྱིས་དངོས་རྫས་དེ་དག་རྟ་ནོར་ལ་ཁེལ་ནས་དམག་སྒར་དུ་བསྐྱལ་བའི་བཀའ་བབས།",
    "དགྲ་བོའི་གནམ་གྲུས་རྣ་བའང་འོན་དུ་འཇུག་སྙམ་པའི་སྒྲ་བར་སྣང་ཁམངས་སུ་ཁྱབ་འདུག་གནས་ཚུལ་ཧ་ཅང་ཛ་དྲག་ཆེ་བས།",
    "རྒྱབ་ཕྱོགས་སུ་དགྲ་བོའི་རྗེས་འདེད་དམག་དཔུང་ཁྲི་ཁྲག་ཁ་ཤས་ཇེ་ཉེ་ནས་ཇེ་ཉེར་ཐོན་བཞིན་འདུག་མེ་སྒྱོགས་ཀྱི་སྒྲ་ཆེན་པོ་ཐོས་ཐུབ་པ་མ་ཟད།",
    "སྤྱི་ཁྱབ་དམག་སྤྱི་ཀྲུའུ་ལགས་བྲག་གཡང་གཟར་པོའི་སྟེང་ཡར་ལངས་འདུག་རྦ་རླབས་ལང་ལོང་དུ་འཕྱུར་བའི་མིན་ཀྲང་ཆུ་བོ་ཁོའི་མིག་མདུན་ནས་མགྱོགས་པོར་བཞུར་གྱིན་ཡོད།",
    "དེ་ཏག་ཏག་དམག་སྤྱི་ཀྲུའུ་ལགས་ཀྱི་གཟུགས་གཏོས་ཆེན་པོའི་སྟེང་ཕོགཁོས་བག་ལྷོད་ངང་ལྟ་ཞིབ་བྱེད་བཞིན་འདུག་ལ།",
    "ལག་པ་གེར་ཏེ་མཛུབ་སྟོན་བྱེད་བཞིན་འདུག་ཅིང་།"
  ]
}