    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ལྟའོ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "ཁམས་དང་སྐྱེ་མཆེད་ཀྱང་རང་སྟོང་དུ་མཚོན་ནུས་པའོ།",
    "གཟུགས་ཀྱི་མཚན་ཉིད་ཤེས་ན་གཟུགས་སྣང་རང་སར་གྲོལ་བའོ།",
    "དེར་རྡོ་རྗེའི་གདན་ལ་འདུག་པ་དང་།",
    "སློབ་དཔོན་དབྱིག་གཉེན་ཟེར་བའང་གདའ་ཕྱོགས་ཀྱི་གླང་པོ་དང་།",
    "དེའི་ཤེས་བྱེད་ཀྱང་རང་ཉིད་འཇིགས་པ་མེད་པའི་གོ་འཕངས་ལ་གནས་ནས།",
    "རང་རང་འཁོར་ལོའི་མགོན་དང་དབྱེར་མེད་པར།",
    "ཉམས་དགའ་བའི་གནས་སུ་འཇམ་པའི་སྟན་ལ་འདུག་ནས།",
    "ཨ་ར་པ་ཙ་ན་དྷཱིཞེས་ཡི་གེ་དྲུག་པ་ཇི་སྲིད་མི་སྐྱོའི་བར་དུ་བཟླ་བར་བྱ་ཞིང་།",
    "མཐར་ཚོགས་ཞིང་རང་ལ་བསྟིམ།",
    "ཁྲི་སྟན་མཐོན་པོ་ལ་འདུག་པ་དང་།",
    "སྒོས་རང་རང་སོ་སོ་ལ་ལུས་ངག་ཡིད་གསུམ་སྐྱོན་མེད་བསྐྲུན་པར་བྱེད་པའི་ཕ་དང་མ།",
    "དེ་ལྟར་སྒྲུབ་པ་ཡིན་ཞེས་ཞུ་བར་གདའ་བས་རྗེས་སུ་ཡི་རང་།",
    "རང་ལ་དེའི་འདུན་པ་མ་ཤར་ན་གཞན་གྱིས་བསྔོས་ཀྱང་རང་ཉིད་ཀྱི་སྨོན་འཇུག་དུ་སེམས་བསྐྱེད་པར་མི་འགྱུར་བས་སོ།",
    "སྦྱིན་པ་པོ་ཁྱེད་རང་འདུན་པ་འདི་ལྟར་མཛོད་ལ་བསྔོས་ཤིག།",
    "གནས་སུ་དེ་ཉིད་བཀུག་ནས་འདུག་པར་བསམ་ལ།",
    "ཁོང་རང་ཉིད་ལྷའི་ང་རྒྱལ་ལ་གནས་པར་བྱས།",
    "འཇིག་རྟེན་ལུགས་ཀྱི་རྣམ་གཞག་ལ་སོགས་པ་མང་ཞིག་གླེང་བར་གདའ་ནའང་།",
    "སྒོས་རང་རང་སོ་སོ་ལ་ལུས་སེམས་སྐྱོན་མེད་བསྐྲུན་པར་བྱེད་པའི་ཕ་མ།",
    "མི་རང་རང་སོ་སོའི་ཁེ་ཕན་ལ་བལྟས་ཏེ་ལ་དྭགས་མི་མངས་ཀུན་ལ་གནོད་པའི་ལས་སུས་ཀྱང་བྱེད་མ་དགོས།",
    "ལྷ་ཁང་སོ་མ་མང་པོ་ཞིག་བཞེངས་བཞིན་འདུག་དེ་ནང་བཞིན་ཡུལ་ཡུལ་ལ་མ་ཎི་དུང་ཕྱུར་སོགས་གསོག་སྲོལ་དར་བཞིན་འདུག་ཡིན་ནའང་མི་རང་རང་སོ་སོའི་སེམས་རྒྱུད་གྱོང་པོ་ཀུན་འདུལ་ཐབས་ལ་མ་འབད་ན།",
    "རང་རང་སོ་སོའི་མཚན་ཉིད་ཤེས་བྱེད་དུ་བཀོད་པས་ནི་མིང་དོན་གྱི་འབྲེལ་བ་གཞི་སོ་སོའི་སྟེང་དུ་ཤེས་པར་འགྱུར་ལ།",
    "ཉོན་ཡིད་ཀྱི་འཁོར་ན་ཡོད་པ་ནི་རང་རང་མཚན་ཉིད་པ་ཡིན་ཀྱང་།",
    "འདི་རྣམ་སྨིན་གྱི་རྒྱུ་ཡིན་བའི་ཚུལ་ཡང་རང་ལྡོག་ནས་འགྲུབ་བྱེད་ཀྱི་རྒྱུ་ཡིན་གྱི།",
    "ཁོ་རང་ཉིད་དེའི་དགག་བྱར་གྱུར་པའི་ཕྱིར་རོ།",
    "གོང་དུ་སྐྱེ་བའི་ཚེ་དང་རང་སར་སྐྱེ་བའི་ཚེ་ནི་མ་ཡིན་ཏེ།",
    "ཀུན་རྫོབ་ཏུ་བདེན་པ་ཡང་རང་ལུགས་ཀྱི་རིགས་པས་རྣམ་པར་བརྟགས་ནས་འཇོག་པ་ཡིན་གྱི།",
    "དེའི་སྤང་བྱ་སྐྱེ་འགག་དུས་མཉམ་པ་ལ་འཆད་པ་ནི།",
    "ཁོ་རང་ལ་ལྟོས་པའི་མཉམ་གཞག་ཡིན་ཀྱང་།",
    "མིང་ཡང་རང་བཞིན་མེད་པ་ཡིན།",
    "སྐྱེ་འགག་མེད་ཅིང་རང་བཞིན་གྱིས་ཞི་བར་གསུངས་པའི་དགོངས་པའོ།",
    "གོང་འཕོའི་སྐབས་སུ་འོག་མིན་འགྲོ་དང་།",
    "ཕས་ཀྱི་རྒོལ་བ་ཚར་གཅོད་ཅིང་རང་ཕྱོགས་གཞག་པའི་མཛད་པ་དང་།",
    "བཞི་པ་རྒོལ་བ་ཚར་གཅོད་ཅིང་རང་ཕྱོགས་གཞག་པ་ལ་གཉིས་ཏེ།",
    "ཀུན་རྫོབ་རང་རང་ངོ་བོས་སྟོང་པ་དང་།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་ཁོ་ནས་ཡིན་གྱི།",
    "སློབ་དཔོན་འདིས་ཐ་སྙད་དུ་ཡང་རང་རིག་ཁས་མི་ལེན་པ་ཡིན་ནོ་ཞེས་ཟེར་བ་དག་སྣང་ངོ།",
    "ཁྱེད་རང་རྒྱུད་སྨྲ་བ་ལ་འཇུག་པ་ཡིན་ནོ།",
    "ཡོད་དེ་དེ་ཡང་རང་ཉིད་ལ་གྲུབ་པའི་གཏན་ཚིགས་ཀྱིས་ཡིན་གྱི།",
    "རྟོག་གེ་དང་རང་རྒྱུད་ཀྱི་གཞུང་གཉིས་ཀ་ན་མི་སྣང་ལ།",
    "གང་ཡང་ཁྱེད་རང་ལྟར་ན་ཡང་།",
    "དེས་ཀྱང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་དང་དཔེ་མ་བརྗོད་པའི་ཕྱིར།",
    "ཟླ་བའི་ཞབས་ཀྱིས་ཀྱང་རང་ལུགས་ལ་བདག་གཉིས་ཁས་བླངས་པར་འགྱུར་ཏེ།",
    "འོ་ན་ཁྱེད་རང་ལྟར་ན།",
    "དང་པོ་གཉིས་གང་ལྟར་ཡང་རང་རྒྱུད་ཀྱི་གཏན་ཚིགས་ཡོད་པར་འགྱུར་ཏེ།",
    "བདག་མེད་པ་དང་རང་བཞིན་མེད་པ་འགོག་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཚེ་ནི་རང་བཞིན་མེད་པ་བཀག་ཀྱང་རང་བཞིན་དུ་མི་འགྱུར་ཏེ།",
    "ཁྱེད་རང་ལྟར་ན།",
    "ཡོད་པར་འཛིན་པའི་རྟོག་པ་གཉིས་དངོས་སུ་གནོད་བྱ་གནོད་བྱེད་དུ་འདུག་པ་ནི།",
    "ཐ་མར་ལྟ་བ་ཀུན་བཟློག་པའི་རིམ་པ་གཉིས་གཉིས་འདུག་པའི་ཕྱིར།",
    "བདེན་གྲུབ་ཅུང་ཟད་ཀྱང་མེད་པའི་རྟགས་ཀྱིས་བདེན་སྟོང་རང་བཞིན་གྱིས་མེད་པར་སྒྲུབ་པ་ཡིན་ཞེས་ཟེར་བ་ནང་འགལ་ལོ།",
    "ཀུན་གཞི་དང་རང་རིག་ཡོད་དམ་མེད་པར་འདོད་པ་གང་ཞིག་ཟླ་བའི་བཞེད་པ་ཡིན་ཡང་རུང་སྟེ།",
    "དེ་དང་དེ་བདེན་པ་དང་དེར་གྲུབ་པ་དང་རང་བཞིན་དང་དེར་གྲུབ་པ་དང་།",
    "བུམ་པ་བདེན་མེད་ལྟ་བུ་དེ་བུམ་པ་དཔྱད་གཞིར་བཟུང་ནས་དཔྱད་པའི་འབྲས་བུ་ཡིན་ཡང་ཁོ་རང་ཉིད་དཔྱད་གཞིར་བཟུང་ནས་མི་དཔྱོད་པ་དེ་སྲིད་དུ་དེ་ཡུལ་དུ་བྱེད་པའི་རྗེས་ཀྱི་ཤེས་བརྗོད་ཀྱི་ངོར།",
    "བདེན་པ་དང་རང་བཞིན་དང་དེ་ཁོ་ན་ཉིད་དང་དོན་དམ་པ་རྣམས་ཡོད་དོ་ཞེས་ཁས་ལེན་པ་འདི་ནི།",
    "བདེན་སྟོང་རང་ལྡོག་ནས་འདིར་དོན་དམ་པའི་བདེན་པར་ཁས་ལེན་ཡང་།",
    "དེ་ཡང་རང་བཞིན་དེ་ཉིད་འདིར་དོན་དམ་པའི་བདེན་པ་ཡིན་ཡང་།",
    "ཡང་རང་རྒྱུད་ཀྱི་གཞུང་གཞན་ལས་ཀྱང་དེ་དེར་གྲུབ་པ་ཡིན་ཏེ།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "བེ་རོ་ཙ་ནའི་ཞབས་ལ་ྎ བདེ་འདུས་བཀའ་བབས་བསྟན་པའི་ཤིང་རྟ་མཆོག།",
    "རང་བྱུང་རང་ཤར་དཀྱིལ་འཁོར་ལྷ་རྣམས་དང་།",
    "རྟག་ཏུ་འགྲོགས་ཀྱང་རང་ཞལ་མ་མཐོང་བར།",
    "ཪིན་པོ་ཆེ་མཆོག་ནས་བརྟག་པ་ཡང་བཟང་པོ་འདུག་ལ་བྱ་བ་དེ་ངེས་པར་དུ་འབད་པས་སྒྲུབ་དགོས་པའི་བཀའ་སྩལ་ཡང་ཡང་གནང་བ་དང་།",
    "སུ་ ཀུ་ཤའི་ཁྲེས་ལ་འདུག་ལ་བཟླས་བརྗོད་བརྩམ།",
    "ཞེས་གསུངས་པས་ལོངས་སྐུ་རང་དོན་ཡིན་པས་འཁོར་ཡང་རང་དོན་ཡིན་ནོ།",
    "གྲ་ཞ་གྷ་ཧ་ཙ་ནི་འཛིན་པའི་སེམས་སུ་འགྲོ་ལ་ཞ་པ།",
    "ལུས་དང་རང་བཞིན་གྱིས་གནས་པའོ།",
    "ཞ་གསང་ཕུའི་ཕྱྭ་པའི་བྲི་སྐུ་འོག་ན་ཡོད་པ་ཨཱ་ནནྡས་བྲིས་གསུང་བ་ངོར་གྱི་ཕྱག་དཔེ་ལ་གདའ།",
    "ན་མ་ཨཱརྱ་ཛྙ་ན་སཱ་ག་ར་བེ་རོ་ཙ་ན་བྱཱ་ཧ་རཱ་ཛཱ་ཡ།",
    "འདི་སྤྱོད་པའི་ཡན་ལག་ཏུ་གྱུར་པའི་ཕྱིར་འདིར་ཡང་རང་བྱིན་བརླབ་ཀྱི་རྗེས་ལ་གསུངས་ལ།",
    "ངོ་ཤེས་པ་རང་རང་ངོ་མི་ཤེས་པ་དང་མི་དང་ལྷ་ལ་སོགས་པའི་གཟུགས་ཐམས་ཅད་རྡོ་རྗེ་འཆང་ཆེན་པོར་བསྐྱེད།",
    "འདུག་སྟངས་ཞེས་བྱ་བ་སྟེ།",
    "བདག་རང་ཁྲུས་བྱས་ལ་སྟན་བདེ་བ་ལ་ཇི་ལྟར་འདུག་པས་འདུག་ལ།",
    "རྣལ་འབྱོར་བླ་ན་མེད་པའི་ལུགས་ཀྱིས་རྣམ་པར་རྟོག་པ་སྤོང་བས་ཤ་ལྔ་བདུད་རྩི་ལྔ་ལ་སོགས་པ་བསྟེན་པའི་ཕྱིར་མི་གཙང་བར་རྐྱང་འདུག་པས་ན་འགལ་བ་ལྟར་སྣང་ཡང་འགལ་བ་མེད་པར་ཤེས་པར་བྱའོ།",
    "གྲ་ཧ་ཙ་ནི་འཛིན་པའི་སེམས་སོ།",
    "ཁ་དོག་སྣ་ཚོགས་སུ་འདུག་པས་སམ།",
    "དེ་ལས་ཕྱག་མཚན་བརྒྱད་དུ་བསྐྱེད་ དེ་རྣམས་རང་རང་ས་བོན་མཚན།",
    "རང་རང་ས་བོན་ལས་འོད་སྤྲོས།",
    "སོ་སོར་རང་རང་ལ་བཅུག་མེས་པོའི་ཤུལ་བཞག་ལས།",
    "དེ་དག་དུས་ཇི་ཙམ་གྱི་དུས་སུ་སྐྱེ་སྙམ་པ་ལ་རྣམ་པ་སྣ་ཚོགས་པ་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "དེའི་གཡས་འགྲམ་གྱི་གོམ་པ་སུམ་ཅུའི་ས་ན་ཀྱ་ཀྱུར་སྟོད་ཕྱོགས་སུ་འཐེན་འདུག་པའི་རྐང་ལམ་དང་བཅས་པས།",
    "ནམ་ཟླ་སྟོན་དུས་སུ་བསླེབས་འདུག་པས་ནམ་མཁའི་ངོ་གདོང་ལྷག་ཏུ་དྭངས་ཤིང་གསལ།",
    "མདུན་ཕྱོགས་ཀྱི་གྲལ་ཤར་གསུམ་པའི་འདུག་སྟེགས་སུ་བསྡད་ཡོད་པའི་མགོ་ལ་ཞྭ་དཀར་གྱོན་ཡོད་པའི་ཧེ་རིགས་རྒད་པོ་དེས།",
    "ལམ་གྱི་གཡས་གཡོན་གཉིས་སུ་མ་གལ་གྱི་སྡོང་བོ་མང་བོ་གྲལ་དུ་བསྒྲིགས་འདུག་རྒྱུ་ལམ་དང་མཉམ་གཤིབ་ཀྱིས་མདུན་ལ་བསྲིངས་ཡོད་པའི་ཆུ་རྐ་ལས།",
    "དེའི་རྗེས་ཀྱི་མཐོང་ཐོས་སུ་གྱུར་བ་རྣམས་ད་ལྟ་ཡིད་ན་གསལ་བོར་མི་འདུག་པས་ངས་དྲན་ཚོད་དུ་འབྲི་བར་མ་སྤོབས།",
    "བལྟས་ཚོད་དུ་སྣང་ཚུལ་དེ་དག་ནི་ཆེད་དུ་ཁོང་རང་ཉིད་ཀྱི་དགའ་སྤྲོའི་སྣང་བ་མཚོན་བྱེད་ལ་གྲ་སྒྲིག་བྱས་པ་དང་འདྲ།",
    "ཉལ་ཁང་མདུན་ཐད་ཀྱི་ལྒང་ལི་རྩེད་ས་ན་སློབ་གྲོགས་འགས་ལྷང་ལི་རྩེད་བཞིན་འདུག་ཁོ་ཚོར་མཚོན་ན་འཇིག་རྟེན་འདི་ནི་ཆེས་ཡིད་གར་འོང་བའི་གླིང་ཕྲན་ཆུང་ཆུང་ཞིག་ཡིན་འདུག་ནམ་ཞིག་གླིང་ཕྲན་འདིར་འོངས་པ་དང་།",
    "སྟོབས་དང་ཤུགས་ཀྱིས་ངའི་དྲན་འཛིན་གྱི་བུ་གའི་ནང་དུ་བཙན་གྱིས་འཛུལ་བཞིན་འདུག།",
    "ཉེ་འགྲམ་གྱི་བྱ་དངོས་རྣམས་ང་དང་རྒྱང་བཀྱེད་བཞིན་འདུག་འོན་ཀྱང་སློབ་གྲོགས་ཚོའི་འུར་སྒྲ་ནི་ཇི་འདྲའི་རྣ་ལ་བོད་ཀྱི་དེང་རབས་བརྩམས་སྒྲུང་དཔེ་ཚོགས།",
    "འདུག་ཕན་ཚུན་ཁ་གཏད་དུ་ཡོད་པའི་སྒང་ལི་འཕེན་སའི་གཟེབ་དྲ་གཉིས་ནི།",
    "སློབ་གྲོགས་གཞན་རྣམས་ཀྱི་འདུག་སྟེགས་སྟོང་བར་ལུས་འདུག་ང་འདུག་སྟེགས་སུ་བསྡད་རྗེས་སློབ་ཁང་ནང་ཧྲིལ་བོར་ལྟ་ཡག་ཅིག་བྱས་ན་ཡང་།",
    "སློབ་གྲོགས་ཚོས་རང་རང་སར་ཅི་ཞིག་ལ་མ་ཁོམ་པར་འདུག་པས།",
    "ང་ལ་ལན་གདབ་རྒྱུ་ཅི་ཡང་མི་འདུག་པས་ཁ་རོག་གེར་མི་འདུག་ཀ་མེད་བྱུང་།",
    "རང་ཉིད་གང་ན་ཡོད་པ་ཡང་ཤེས་བཞིན་མི་འདུག་ཅེས་ང་ལ་གཤེ་གཤེ་བཏང་བྱུང་།",
    "འདུག་མི་བདེ་བའི་སེམས་ཁམས་དེ་ལ་ནུས་ཚོད་ཀྱིས་འཐབ་རྩོད་བྱས་པ་ཡིན།",
    "ང་ལ་མཚོན་ན་ཕྱིར་ལན་ཅི་ཡང་མ་སློག་པར་ཁ་རོག་གེར་འདུག་རྒྱུ་ལས་ཐབས་གཞན་ཅི་ཞིག་ཡོད།",
    "དེའི་ཕྱིར་དེ་རིང་ཡང་བསྐྱར་དུས་རབས་ཤིག་འདུག་སྙམ་བྱུང་།",
    "ཡོད་ཚད་དེ་འདྲའི་ལྐོག་གྱུར་ཞེ་མུག་པ་ཁོ་ནར་འདུག།",
    "ཐོག་ལ་ས་རྡུལ་ཆགས་ཡོད་པ་གཡས་འཐེན་གཡོན་འཐེན་བྱས་འདུག་པས།",
    "གང་ལྟར་ང་རང་མྱུར་དུ་ནར་ནར་སོན་ཚེ་འཇིག་རྟེན་གྱི་གནས་ལུགས་མང་སོན་པར་ཤོག་བོ་ཅིག་ཅར་ཏུ་རྟོགས་ཐུབ་པ་འདྲ།",
    "སློབ་ཁང་ནང་ལ་ཐོན་པ་ནས་ལྟོགས་སྐོམ་ལས་བྱུང་བའི་ཕྱོགས་དུ་མའི་མཉམ་སྒྲོག་རོལ་དབྱངས་ཤིག་ཁོག་པའི་གཏིང་ན་ཡང་ཡང་དཀྲོལ་བཞིན་འདུག་ངས་ངེས་པར་དུ་རྟོགས་བསྲན་བྱེད་དགོས།",
