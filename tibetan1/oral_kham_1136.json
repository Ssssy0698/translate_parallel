    "འདིའི་ཡན་གྱི་ནུས་པ་ཞིག་ང་ལ་ཡང་མི་འདུག་ཅེས་པའི་ཚིག་དེ་ནི།",
    "ང་ལ་དྲི་བ་དེར་ལན་སློག་འདོད་གཏན་ནས་མི་འདུག་ལ།",
    "དཔེ་ཀློག་ནི་ང་ལ་མཚོན་ན་འཚོ་བའི་ཆ་ཤས་སུ་གྱུར་འདུག།",
    "ཟིལ་ཤུགས་ཁོ་ནས་ཀྱང་ཕ་རོལ་བོ་སྤ་སྐོང་བར་བྱེད་ཁོ་ཐག་ཏུ་འདུག་པས།",
    "མེ་ཏོག་ཨ་གར་གྱི་སྡོང་བུ་དེའི་ལོ་མ་ཁ་ཅིག་སྔོ་ལྗང་དུ་གནས་འདུག་པ་མཐོང་།",
    "ལ་ལྷུང་ཚར་འདུག་ཤུལ་དུ་ལུས་ཡོད་པའི་སེར་བོར་གྱུར་བའི་ལོ་མ་འགས་ལྡུམ་ར་དེར་སྨྲ་མི་ཤེས་པའི་སྐྱོ་སྣང་གཞན་ཞིག་བསྐྲུན་འདུག་ལྡུམ་རའི་རྩྭ་སྔོན་རྣམས་ཀྱང་ད་ནི་རྙིད་པར་གྱུར་ཡོད་ཅིང་།",
    "ལྗང་སེར་འདྲེས་མའི་ཁ་དོག་ཏུ་གྱུར་འདུག་ང་ནམ་རྒྱུན་མེ་ཏོག་ལྡུམ་ར་དེའི་ཉེ་འགྲམ་བརྒྱུད་དེ་ཡར་འགྲོ་མར་འགྲོ་ཐེངས་མང་བོར་བྱས་མྱོང་ན་ཡང་།",
    "དོ་མི་མཉམ་པའི་ཆ་ཞིག་མངོན་གསལ་དུ་བྱུང་འདུག་པ་རྟོགས།",
    "སྐབས་དེའི་དྲན་ཚུལ་ལྷག་མ་ཞིག་ད་ལྟའང་ལུས་འདུག་སྟེ།",
    "གང་ལྟར་སྐབས་དེ་དག་ཏུ་བདག་ལ་ལས་ཀ་བ་དེ་དང་འབྲེལ་འདྲིས་བྱེད་པའི་ཁོམ་པ་མི་འདུག་དེ་བས་མི་དེ་ལ་དངོས་སུ་འབྲེལ་འདྲིས་བྱུང་དུས་ནི།",
    "ང་རང་བྲེལ་བྲེལ་འཚབ་འཚུབ་ཀྱི་མི་ཞིག་ཡིན་པའི་རྣམ་འགྱུར་མང་དུ་བསྟན་མྱོང་།",
    "མི་དེ་ངའི་གམ་ལ་བསླེབས་འདུག་ཁོའི་ངོ་ལ་ལྷད་མ་འདྲེས་པའི་འཛུམ་མདངས་ཤིག་མངོན་བཞིན་ང་རང་ཕྱི་ལ་ཡོང་དགོས་པའི་བརྡ་བསྟན་བྱུང་།",
    "ཁོ་རང་སྙན་ངག་པ་ཞིག་ཡིན་པ་ལ་ང་རང་དོགས་པ་མི་ཟ་ཐུ་མེད་དུ་གྱུར།",
    "དེ་བས་སྙན་ངག་འདིའི་རྩོམ་པ་བོ་ཁོ་རང་ཡིན་པའི་དོགས་པ་དེ་རིམ་གྱིས་མེད་པར་གྱུར།",
    "ང་རང་སྤྱོད་ཁང་ནས་ཕྱིར་དཔེ་མཛོད་ཁང་དུ་ལོག་སྐབས།",
    "རང་རང་སར་ཁ་རོག་གེར་མི་འདུག་ཐབས་མེད་བྱུང་།",
    "ང་རང་སྔོན་ཆད་ནས་སྙན་ངག་ལ་དགའ་མ་མྱོང་།",
    "དུས་ཚོད་ཀྱི་བཞུར་རྒྱུན་ལ་སྔ་ན་མེད་པའི་ཕྱིར་དྲན་གྱི་བག་ཆགས་སྣ་ཚོགས་བགོ་བཞིན་འདུག།",
    "ང་རང་གཞན་ལས་ཁྱད་དུ་འཕགས་པ་ཞིག་ཏུ་འགྱུར་མི་སྲིད་ཅིང་།",
    "སྐབས་ལ་ལར་བོད་མི་འདི་ཚོ་ལས་གླེན་པ་ཞིག་མི་འདུག་སྙམ།",
    "ང་རང་ཆུང་དུས་ནས་དགུན་གྱི་དུས་ཚིགས་འདི་ལ་ཡང་དགའ་བོ་མེད།",
    "ཟླ་ནས་ལོ་བྱས་ཏེ་སྨོན་འདུན་ཤོར་ཤོར་ལ་འདུག་མཁན་རྐྱང་ཡིན་པ་རྟོགས།",
    "ཟིན་བྲིས་སུ་བཏབ་པའི་འབྲི་དེབ་གཉིས་ལྷག་ལོན་འདུག་པས།",
    "ཉི་མ་དེར་ང་ལ་མཚོན་ན་མི་སུ་ལ་ཡང་ཁ་བརྡ་བྱེད་འདོད་མི་འདུག་པས།",
    "ངའི་སྣང་བ་ཞིག་ལ་ང་ཁོ་ན་མི་རྣམས་ཀྱིས་བས་མཐར་དེད་འདུག་ཅིང་།",
    "ང་རང་མཚན་ཉིད་སྨྲ་བའི་མཁས་པར་འགྱུར་རྒྱུར་ད་རུང་དུས་ཚོད་མང་བོ་ཞིག་བརྒྱུད་དགོས་པ་འདྲ།",
    "ད་ལྟ་ང་རང་ཡང་བསྐྱར་སྔར་ལས་ཀྱང་འགྲིག་ལམ་བརྩི་ཤེས་པའི་མི་ཞིག་བྱ་རྒྱུའི་དམ་བཅའ་བཞག་ཟིན་པ་འདྲ།",
    "སྤྱོད་ཁང་ནང་ནས་ང་ལ་གཅིན་སྐྱག་གཉིས་ཀ་མི་འདུག་ང་སྤྱོད་ཁང་འདིའི་ནང་ལ་འོངས་དོན་ཅི་ཞིག་ལ་གཡོལ་འདོད་པའི་ཕྱིར་མ་ཡིན་ནམ།",
    "ནམ་རྒྱུན་ལུས་དང་གྲིབ་མ་ལྟར་འགྲོགས་བཞིན་པ་དེ་ཡང་ང་ཡིན་པར་འདུག་ང་སྔོན་ཆད་ནས་དཔལ་ཆེན་རྡོ་རྗེ་ལ་སུན་སྣང་སྐྱེ་བཞིན་ཡོད་པའི་སེམས་ཁམས་དེས་ང་ལ་རྫུན་མགོ་སྐོར་བཞིན་པ་འདྲ།",
    "ཏག་ཏག་ང་རང་ལངས་སྡོད་ས་ནི་ཉིས་ཐོག་ནས་སུམ་ཐོག་ལ་འགྲོ་སའི་ཐེམ་སྐས་ཀྱི་ཁ་གཏད་ན་ཡོད་ཕྱིར།",
    "ཕལ་ཆེར་ངའི་འཚོ་གནས་དང་བཅས་པ་ཡོངས་སུ་བརྗེད་འདུག་པ་འདྲ།",
    "ང་རང་ཕྱི་ལ་ཡོང་དགོས་པའི་བརྡ་བརྒྱབ་བྱུང་།",
    "འདང་ཕྱི་མཐོང་མ་མྱོང་བའི་རྒྱབ་བསྙེས་ཡོད་པའི་འདུག་སྟེགས་སོ་མ་དེས་ཁང་བ་འདིའི་ནང་ལ་དེང་རབས་ཀྱི་མཁའ་དབུགས་ཤིག་བསྣན་འདུག་དྲ་མའི་ཐེམ་ཐོག་ན་གཟེངས་ཐོན་ལ་བྱིན་པའི་ཟངས་ཀྱི་སྒྲོམ་བུ་གཉིས་གཅིག་ལ་གཅིག་བསྙེས་ཏེ་བསླངས་ནས་བཞག་ཡོད་ཅིང་།",
    "ཕལ་ཆེར་རླབས་ཆེ་བའི་ལས་ཀ་ཅི་ཐོག་ལ་བླངས་འདུག་ཅིང་།",
    "པར་ངོས་དེའི་འདབས་སུ་ཡིག་འབྲུ་ཆེན་པོ་འགའ་གཟི་བརྗིད་དང་བཅས་ཏེ་བཀོད་འདུག་ངས་ཡིག་འབྲུ་དེ་དག་ལ་བལྟ་འདོད་ཤིན་ཏུ་ཆེ་ན་ཡང་།",
    "ཁང་མིག་འདི་སྔར་བཞིན་དལ་འཇགས་སེར་འདུག་ཅིང་།",
    "བརྗེད་འདུག་པ་འདྲ།",
    "ནང་དུ་འདི་ནི་ཕལ་ཆེར་རྒྱན་གཉིས་ཙམ་གྱིས་ཆེ་བ་ཡོད་ཅིང་བཞག་ཡོད་པའི་ཅ་དངོས་རྣམས་ཀྱང་ཅུང་གསར་བ་གསར་རྐྱང་སྒོའི་ནང་ཕྱོགས་ཀྱི་གྲུ་ག་ན་བཞག་ཡོད་པའི་ཁ་ལག་དུ་འདུག།",
    "ཁོའི་སྐད་ཆར་ཉན་གྱིན་ཉན་གྱིན་ང་རང་འདིར་འབོད་དགོས་དོན་ད་ཅི་ལས་ཀྱང་ལྐོག་གྱུར་ཞིག་ཡིན་པ་འདྲ།",
    "དེའི་ནང་དུ་ཤོག་གྲངས་དྲུག་འདུག་ཅིང་།",
    "ཞོགས་པ་དེའི་བྱ་བ་དངོས་རྣམས་ངའི་ཀླད་པའི་ནང་ན་གསལ་བོར་ལུས་འདུག་ཞོགས་པ་དེའི་ཆར་བ།",
    "ཕྱིར་ལོག་དུས་ང་གླ་འཁོར་ཞིག་དུ་བསྡད་པ་ཡིན།",
    "ཡོད་ཚད་ལ་བློ་ཡིད་ཚིམས་ཀྱིན་མི་འདུག་པའི་སེམས་ཁམས་དེའི་རྒྱབ་ན་རི་རབ་ལས་ཀྱང་ལྕི་བའི་གསང་བ་ཞིག་ཡོད་པ་འདྲ།",
    "ང་རང་སྔོན་ཆད་ཀྱི་རིན་ཆེན་ཡིན་མི་སྲིད་ལ་ཡིན་ཡང་མི་འོས།",
    "ལམ་ཕྲན་འདིའི་གཡས་གཡོན་གཉིས་སུ་ཐོད་དཀར་དང་མ་གལ་གྱི་སྡོང་བོ་བཙུགས་ནས་གཡོགས་འདུག་ཅིང་།",
    "ཐག་པ་སྦོམ་སྦོམ་དང་མཚུངས་པ་འགའ་གཏོད་འདུག་པས།",
    "པ་དྲག་པོ་དེ་མེད་པར་གྱུར་འདུག་ལ།",
