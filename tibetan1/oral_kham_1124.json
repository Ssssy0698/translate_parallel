    "ཕྱག་གཡས་རང་རང་སྒོ་ཆས་ལོག་འདྲེན་གཞོམ",
    "ཁོ་རང་ལ་ནི་བཟློག་པ་དང་",
    "དགྲ་བགེགས་ཀྱི་མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བྷ་སུ་ཏ་ཨི་དཾ་བྷ་ལིངྟ་ཁ་ཧི",
    "ལོ་ཟླ་ཞག་དུས་ཚེས་ལ་མ་འདའ་བར",
    "ཨོཾ་ཨཱ་ཧཱུྃ་དགྲ་བགེགས་ཀྱི་མ་ཧཱ་རཀྟ་མཱཾ་ས་ཙིཏྟ་གོ་རོ་ཙ་ན་ཁཱ་ཧི",
    "རང་རང་མཚན་དཔེའི་གཟི་བྱིན་རྫོགས།",
    "མཆོད་སྦྱིན་འདི་ཁྱེར་རང་རང་གནས་སུ་དེངས",
    "ཨོྃ་རུ་ཏྲ་མ་ར་ནི་མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བྷ་སུ་ཏ་ཨཱ་ཧཱུྃ",
    "ཨོྃ་ཨཱ་ཧཱུྃ་དགྲ་བགེགས་ཀྱི་མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བྷ་སུ་ཏ་ལ་ཁ་རཾ་ཁཱ་ཧི",
    "ཨོྃ་རུ་ཏྲ་མཱ་ར་ནི་མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་ཨོྃ་ཨཱ་ཧཱུྃ",
    "ལོ་ཟླ་ཞག་དུས་ཕྲ་མེན་དྲུག་ཅུ་བཞི",
    "ཨོྃ་ཨཱ་ཧཱུྃ་དགྲ་བགེགས་ཀྱི་མ་ཧཱ་མཱཾ་ས་རཀྟ་གོ་རོ་ཙ་ན་བྷ་སུ་ཏ་ལ་ཁ་རཾ་ཁཱ་ཧི",
    "མཆོད་སྦྱིན་འདི་ཁྱེར་རང་རང་གནས་སུ་དེངས",
    "ཨོྃ་རུ་ཏྲ་མ་ར་ཎི་མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་ཨཱ་ཧཱུྃ",
    "ཨོཾ་ཨཱ་ཧཱུྃ་དགྲ་བགེགས་ཀྱི་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་ལ་ཁ་རཾ་ཁཱ་ཧི",
    "ལན་གསུམ་དང་མཐར་ཚོགས་ཞིང་རང་ལ་བསྟིམས།",
    "མ་ཧཱ་མཱཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་ལ་ཁཱ་ཧི",
    "རིགས་ཀྱི་ཡུམ་འཁྲིལ་རང་རང་འཁོར་ཚོགས་འབུམ",
    "སྟོབས་བསྐྱེད་རང་རང་སྐུ་ལས་འོད་ཚོགས་འཕྲོས",
    "རང་རང་རིགས་མཐུན་དཔག་མེད་འཕྲོས",
    "གཡོན་འཆི་མེད་ཚེ་ཡི་བུམ་པ་འཛིན་ཅིང་རང་བྱུང་ཡེ་ཤེས་འོད་ཀྱི་ཀློང་དུ་གསལ་བའོ",
    "ཅེས་ཚོགས་ཞིང་རང་ལ་བསྟིམས་ནས།",
    "བཛྲ་རཱུ་པ་ཤབྡ་གནྡྷེ་རཱ་ས་སྤརྴེ་པཱུ་ཛ་ཧོ་མ་ཧཱ་མཾ་ས་རཀྟ་ཙིཏྟ་གོ་རོ་ཙ་ན་བ་སུ་ཏ་ཁ་རཾ་ཁཱ་ཧི",
    "ཞེས་པའང་རང་སློབ་ཡེ་ཤེས་རྒྱལ་མཚན་ནས་འདི་ལྟར་བྲིས་ཞེས་ཡང་ཡང་བསྐུལ་ཞིང་ཡི་གེའི་མཐུན་གྱུར་ཀྱང་མཛད་པར་བརྟེན་སྒོ་ཆེན་སྤྲུལ་མིང་ནས་གཏེར་གཞུང་དགོངས་པ་བཞིན་སྦྱར་བའོ།",
    "སྐྱབས་ཡུལ་གསལ་བཏབ་ནས་སྐྱབས་སུ་འགྲོ་བ་དང་སེམས་བསྐྱེད་ཡན་ལག་བདུན་པ་རྣམས་གྲུབ་ནས་ཚོགས་ཞིང་རང་ལ་བསྡུ།",
    "དེ་དག་ལ་ཡང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་བལྟའོ།",
    "དང་པོ་ནི་ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་བར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་སྟོང་བར་རྣམ་པར་ཡང་དག་པར་ཏེ་ཕྱིན་ཅི་མ་ལོག་པར་རྗེས་སུ་མཐུན་པར་རྟོག་ཕྱིར་བལྟ་བར་བྱ་ཞེས་པའོ།",
    "ད་ལྟའི་དཔེ་མང་པོར་འགྱུར་བྱུང་བཀོད་པ་མི་འདུག་གོ།",
    "པུ་ཏོ་བ་ཁོང་ཅི་མཛད་ཅིང་གདའ་གསུངས་པར།",
    "ཁམས་པ་ལུང་བ་ཁོང་ཅི་མཛད་ཀྱིན་གདའ་གསུངས་པར།",
    "ཁོང་ཁོང་སྒོམ་འབའ་ཞིག་མཛད་ཀྱིན་གདའ།",
    "སྣ་ཚོགས་རྡོ་རྗེའི་སྟན་ལ་ལེགས་པར་འདུག་པས།",
    "བྱ་རྒོད་ཕུང་པོའི་རིར་ཟླ་བ་གསུམ་བཞུགས་ནས་ཨ་ར་པ་ཙ་ནའི་བཟླས་པ་མཛད་པ་ན།",
    "འགྲོ་འདུག་དང་།",
    "ཉལ་དང་མ་ཉལ་འདུག་པ་དང་།",
    "སླར་ཡང་རང་ཐུགས་རྗེ་ཆེན་པོར་གསལ་བའི་སྐུ་ལས་འོད་ཟེར་ཕྱོགས་བཅུར་འཕྲོས།",
    "བཟླས་བྱའི་སྔགས་ལ་འདྲ་མིན་མང་ཙམ་འདུག་ཀྱང་།",
    "བཀོད་པ་ཅི་མཛེས་སུ་བཤམས་ཤིང་རང་དང་སྒྲུབ་རྫས་བར་ཐག་ཤིན་ཏུ་ཉེ་བར་བྱ།",
    "འདུག་སྟངས་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་ངམ།",
    "རང་ཉིད་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "རང་ཁ་ལྷོ་ནས་བྱང་དུ་ཕྱོགས་པར་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་འཁོད་དེ།",
    "རང་རང་སྐུ་ཡི་རྣམ་པར་སྤྱན་དྲངས་ཏེ།",
    "འབྲུ་གསུམ་ལན་གསུམ་བརྗོད་དེ་འདུག་གནས་ནི།",
    "དེ་ནས་འཇམ་ཞིང་བདེ་བའི་སྟན་ལ་པདྨའི་འདུག་སྟངས་ཀྱིས་ཁ་ཤར་དུ་ཕྱོགས་པས་འཁོད།",
    "ཞེས་སཱ་ཙྪ་འདེབས་པའི་ཆོ་ག་ལེགས་ཚོགས་ལྷུན་འགྲུབ་ཅེས་བྱ་བ་འདི་ནི་མཁས་གྲུབ་ཆེན་པོ་ཧ་ལ་ཧ་ཛ་ཡ་པཎྜི་ཏ་བློ་བཟང་འཕྲིན་ལས་ཀྱིས་མཛད་པའི་ཐུགས་རྗེ་ཆེན་པོའི་སྒོ་ནས་སཱ་ཙྪ་འདེབས་ཚུལ་ཞིག་འདུག་པ་ལ་གཞི་བྱས་ཏེ།",
    "མ་འདུག་གཏོར་མ་འདི་ཁྱེར་གཞན་དུ་དེངས།",
    "མར་མེ་བརྟག་པ་སོགས་ཀྱི་ཡི་གེ་མང་པོ་འདུག་ཀྱང་།",
    "དེ་ཡང་རང་གཞན་གྱི་སྡིག་སྒྲིབ་སྦྱངས་པའི་ཕྱིར་དུ་སྐྲ་དང་རུས་བུ་ལ་སྦྱངས་ཆོག་བྱས་ན་ཕན་ཡོན་ཤིན་ཏུ་ཆེ་བར་རྒྱུད་དང་བསྟན་བཅོས་ཚད་ལྡན་དུ་མ་ལས་གསུངས་པས།",
    "ཞེས་པ་འདི་ལན་གསུམ་བརྗོད་ནས་བླང་ཡང་ལེགས་པར་དམ་པ་གོང་མ་འགའ་ཞིག་གསུང་འདུག་ལགས།",
    "སྐྱབས་གནས་ཀུན་འདུས་ཁྱེད་རང་མཁྱེན་ནོ།",
    "ཕྱི་སྨིན་ནང་མ་སྨིན་པའི་ཚུལ་དུ་གདའ།",
    "དེ་ཕྱིར་སུས་ཀྱང་རང་ལ་མི་ཕན་པས།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་དང་།",
    "དེ་ལས་ཀྱང་ཉི་མ་འབུམ་ཕྲག་དུས་གཅིག་ལ་ཤར་བ་ལྟ་བུའི་འོད་ཟེར་འཕྲོས་ལུས་ཀྱི་ནང་ཐམས་ཅད་གང་།",
    "འདིར་ཚིག་རྐང་གཉིས་ཆད་འདུག་པས་མ་ཕྱི་ལག་ཏུ་མ་འབྱོར།",
    "ཡེ་ཤེས་པ་བདག་ཉིད་ལ་ཐིམ་ཞིང་ཕྱོགས་སྐྱོང་རང་གནས་སུ་གཤེགས་པར་གྱུར་བར་བསམ་ལ།",
    "དེ་ནས་སྟན་གྱི་འོག་ཏུ་འབྲུ་དཀར་གྱིས་པདྨ་འདབ་བརྒྱུད་བྲིས་པའི་སྟེང་དུ་འདུག་སྟངས་ནི།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ་སྭཱ་ཧཱ།",
    "ཛཱ་ལཱ་མུ་ཁེ་སཾ་ག་ལ་ལོ་ཙ་ནེ།",
    "ལུས་དཀྱིལ་ལྷ་རྣམས་རང་རང་གནས་སུ་ཐིམ།",
    "སྣོད་བཅུད་ཐམས་ཅད་བདེ་སྟོང་རང་བཞིན་གྱུར།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ།",
    "སྣོད་བཅུད་ཐམས་ཅད་བདེ་སྟོང་རང་བཞིན་གྱུར།",
    "སླར་ཡང་རང་ཉིད་ཁྲོས་མའི་སྐུར་གསལ་བའི།",
    "དེའི་ངང་ལས་སླར་ཡང་རང་ཉིད་རྡོ་རྗེ་མཁའ་འགྲོའི་སྐུར་བཞེངས་པར་གྱུར།",
    "ལེགས་ཆ་འདུག་ན་ཉམས་བཞེས་གསལ་འདེབས་མཛོད།",
    "ཉེས་ཆ་འདུག་ན་མེ་ལྷའི་ཞལ་དུ་ཕུལ།",
    "ཚོགས་ཞིང་གཤེགས་དང་རང་རྟེན་བསྟིམ་པའམ།",
    "ཡུལ་གྱི་ངོས་ནས་ཁོ་རང་ཡིན་ངེས་པའི།",
    "གདོན་དང་རང་སེམས་རྒྱལ་བའི་ཡེ་ཤེས་ཐུགས།",
    "ཁྱེད་ལ་ཞག་བདུན་གྱི་ཚེ་ལས་མི་འདུག་པས་ངེད་ཅག་ལ་རྗེས་ནས་གཏོར་མ་སྟེར་མཁན་མེད་ཟེར་བ་ལ།",
    "ཟླ་སྟེང་རང་རང་ས་བོན་སྔགས་བཅས་ལས།",
    "རང་རང་ས་བོན་སྔགས་ཀྱིས་བསྐོར་བ་ལས།",
    "གཞིས་སུ་འདུག་ན་རྒྱབ་བསྟེན་མཛོད།",
    "ལྷ་ཡི་སྟན་ལ་དེ་ལུས་འདུག་པར་ཤེས།",
    "གང་ལ་ལ་ཞིག་འདུག་པའམ།",
    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོ་བའི།",
    "ད་ལྟ་ཉིད་དུ་མྱུར་བ་ཉིད་འདུག་ས་འདི་ཉིད་དུ་བྱིན་གྱིས་རློབས་ཤིག།",
    "བོད་འདི་ཐོག་མ་ནས་བཟུང་རང་བཙན་ཡིན་པའི་ཆབ་སྲིད་ཀྱི་གྲུབ་ཆ་ལྡན་ཡོད་པ་དང་།",
    "རང་བཀུར་གྱི་མི་གཤིས་དང་རང་ཐག་རང་གཅོད་བྱེད་སེམས་ཀྱི་རྒྱུ་རྐྱེན་སོགས་ཕུད།",
    "བཙན་བྱོལ་དུ་ཡོད་པའི་བོད་མིས་རྒྱ་གར་དུ་བཟས་བཅད་ངོ་རྒོལ་དང་རང་ལུས་བསྲེགས་ཤིང་།",
    "འགའ་ཞིག་སྐུ་བཞིར་འདོད་པའང་རང་དོན་དོན་དམ་པའི་སྐུ་ལ་དག་པ་གཉིས་ལྡན་གྱི་ཆ་ངོ་བོ་ཉིད་ཀྱི་སྐུ་དང་།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "གཞན་དོན་ལས་མི་ལྡོག་པའི་སེམས་ཀྱིས་སུ་འཇུག་པ་སེམས་བསྐྱེད་དེ་ཆོ་གས་ཡང་དག་པར་བླངས་པར་གྱུར་པ་དེང་ནས་བཟུང་སྟེ་གཉིད་ལོག་གམ་སེམས་གཡེངས་པས་བག་མེད་པར་གྱུར་ཏམ་བརྒྱལ་བའམ་ར་རོ་བའམ་འགྲོ་འམ་འགྲེང་ངམ་འདུག་ཀྱང་རུང་།",
    "ཤིང་ལྗོན་པ་གང་ཞིག་ཁ་དོག་དང་དྲི་རོ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པའི་འབྲས་བུ་བཟང་ལ་མང་བའི་ལྗིད་ཀྱིས་ཡལ་ག་རྣམས་དུད་ཅིང་དམའ་བར་འདུག་པ་དང་།",
    "དུས་དེ་རིང་ཙམ་ཁོ་ནའང་མི་འཆིའོ་ཞེས་བག་ཕབ་སྟེ་ཡིད་དལ་དུ་བདེ་བར་འདུག་པ་ནི་རིགས་པ་མ་ཡིན་ཏེ།",
    "གདོན་མི་ཟ་བར་ཤི་ནས་མེད་པར་འགྱུར་བར་ངེས་ན་ཅིའི་ཕྱིར་བདག་ཉིད་ཡི་དལ་དུ་བདེ་བར་འདུག་སྟེ་འདུག་པར་མི་རིགས་སོ།",
    "༦ ཕྱེད་འདུག་ས་བཟང་གཞུང་དཞསྣར་ལ་བཞུགས།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "ཙ་ན་ཀར།",
    "གཞན་དག་དེའི་ཡོན་ཏན་བརྗོད་ཅིང་འདུག་ནའང་འགལ་བ་མི་སྨྲ་བར་རྗེས་སུ་མཐུན་པར་བརྗོད་དེ།",
    "སྤྱིར་ཡང་རང་བཞིན་གྱི་བྱ་བ་རྩོམ་པ་ཐམས་ཅད་སྡུག་བསྔལ་དང་བྲལ་བའི་དགའ་བ་ཐོབ་པའི་ཕྱིར་ཡིན་ཏེ་དེ་ལྟ་བུའི་དགའ་བ་དེ་ནི་རིན་ཆེན་པོ་ཉིད་ཀྱིས་ཉོ་ནའང་ཤིན་ཏུ་དཀོན་པ་དེ་ལྟ་བས་ན་གཞན་གྱིས་འབད་པས་བྱས་པའི་ཡོན་ཏན་ལ་ཕྲག་དོག་མེད་པ་ཉིད་ཀྱིས་རང་ཉིད་དགའ་བའི་བདེ་བ་ལ་ལོངས་སྤྱད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་ལུས་གཏོང་ནའང་ཅི་ནས་ཏེ་ངེས་པར་སྐྱེ་བ་འདི་དང་གཞན་དུ་ཡང་རང་གཞན་ལ་ཕན་པའི་དོན་རྒྱ་ཆེན་པོ་འགྲུབ་པའི་རྒྱུར་གཏང་ངོ་ཞེས་པའམ།",
    "ཞེས་པ་ལྟར་གདན་བཟང་པོ་ལ་འདུག་ཅིང་།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "ཉིན་པར་འདུག་པའི་སྤྱོད་ལམ་ནི།",
    "ཁྲི་ལ་སོགས་པར་སྡོད་པ་ན་ཡང་བག་མེད་པའི་རྣམ་འགྱུར་རྐང་པ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "མི་དགའ་བ་བྱས་ཀྱང་རང་སྡུག་པ་ཙམ་དུ་ཟད་ཀྱི་འདོད་པའི་དོན་ཅུང་ཟད་ཀྱང་མི་འགྲུབ་ཅིང་།",
    "གོམས་པའང་རང་ལ་རག་ལས་པས།",
    "ལུས་དེ་ལ་གནོད་པ་གཞན་སུ་ལ་ཁྲོ་སྟེ་ཁྲོ་བར་མི་རིགས་ཤིང་རང་ལ་ཁྲོ་བར་རིགས་ཏེ་ལུས་བཟུང་བས་ཉེས་པ་བའི་ཕྱིར་རོ།",
    "གནོད་ནའང་རང་ཉིད་ཉམས་པར་འགྱུར་ཚུལ་ནི།",
    "དེ་བས་ཀྱང་རང་གཞན་གྱི་ཡུན་རིང་པོའི་སྡུག་བསྔལ་མང་པོ་དག་རྩ་བ་ནས་གཞོམ་ཞིང་མེད་པར་བྱ་བའི་ཕྱིར་དུ་ལམ་གྱི་དཀའ་སྤྱད་ཀྱི་མི་བདེ་བ་ཆུང་ངུ་དང་དུ་བླངས་ཏེ་བཟོད་པར་བྱ་བར་རིགས་སོ།",
    "དང་པོ་སྐྱེ་བ་ནའང་རང་ཉིད་གཅིག་པུར་སྐྱེ་བར་འགྱུར་ཞིང་མཐར་འཆི་བ་ནའང་དེ་ཉིད་གཅིག་པུར་འཆི་བར་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་ནའང་རང་ཉིད་ཀྱང་གཞན་ཡིན་པའི་ལུགས་ལ་དེ་ཙམ་གཅིག་སེམས་སུ་འོང་བ་ཞེས་གྲགས་པ་ལྟར་རོ།",
    "དེ་འདུག་པ་ན་མུན་པ་མེད།",
    "གལ་ཏེ་གནས་སྐབས་ཚུལ་གཞན་དུ་མར་སྟོན་ཡང་རང་བཞིན་སྔར་གྱི་དེ་ཉིད་ཡིན་པའི་ཕྱིར་རྟག་པ་ཡིན་པ་མི་འགལ་ལོ་ཞེ་ན།",
    "དེར་མ་ཟད་ཁྱེད་རང་འདོད་པའི་བདག་སེམས་པ་ཅན་དང་གཙོ་བོ་སེམས་མེད་པ་དེ་དག་ཀྱང་དངོས་པོ་གཅིག་ཉིད་དུ་འགྱུར་ཏེ།",
    "དེ་ཡང་རང་བཞིན་བརྟགས་ཏེ་དགག་པ།",
    "སྣ་ཚོགས་སུ་སྣང་ཡང་རང་བཞིན་མེད་པར་མཚུངས་པའི་ཕྱིར་རོ།"
  ]
