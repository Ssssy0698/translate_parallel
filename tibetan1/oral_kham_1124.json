    "རྡོ་རྗེ་རྣོན་པོའི་གནས་སུ་ནི་རལ་གྲིའི་སྟེང་དུ་ནོར་བུ་འདུག་པར་བྲིའོ།",
    "ཞེས་བྱ་བ་ལ་འདིར་ཡང་སྒྲུབ་པའི་ཚེ་ཉིད་ན་ལས་ཀྱི་ཕྱག་རྒྱས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་པ་ན་དངོས་པོ་ཐམས་ཅད་ཀྱི་རྣམས་པ་ཐམས་ཅད་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་ཡིན་པའི་ཕྱིར་བྱ་བའི་ཚོགས་ཐམས་ཅད་ཡོངས་སུ་དག་པ་ཡིན་ལ།",
    "བདག་གམ་གཞན་གྱི་ཚེ་སྔ་མའི་རྣམ་པར་ཤེས་པར་འདོད་ན་གནས་དབེན་པར་འདུག་སྟེ།",
    "འདི་ཡང་བསྒྲུབ་པའི་དུས་ན་དགོས་པ་ཡིན་ལ་དེ་ཡང་དེ་བཞིན་གཤེགས་པ་ཟློས་པའི་བསྒྲུབ་པའི་དཀྱིལ་འཁོར་དུ་འཇུག་པ་ལ་སོགས་པའི་ཆོ་ག་བྱས་ལ་དབུས་སུ་འདུག་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་ནི་བསྒོམས་པའི་སྟོབས་ཀྱིས་མུན་ནག་ན་འདུག་སྟེ་མིག་ཕྱེ་ན་ཡང་རྡུལ་ཕྲན་སྲིན་བུ་མེ་ཁྱེར་ལྟ་བུ་ནམ་མཁའི་ཁམས་ལ་རྒྱུན་མི་འཆད་པར་སྣང་ཞིང་གཟུགས་ཐམས་ཅད་ཀུན་དུ་གསལ་བར་སྣང་བ་ལས་ན་དེས་འདི་ནི་དངོས་གྲུབ་ཀྱི་མཚན་མ་ཡིན་ནོ་བར་ཤེས་པ་སྐྱེ་བར་འགྱུར་རོ།",
    "དགའ་བར་འགྱུར་ཞེས་བྱ་བ་ནི་མདུན་དུ་འདུག་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "གནས་ཇི་བཞིན་པར་འདུག་སྟེ་ཞེས་བྱ་བ་ནི་གང་དུ་འདུག་པ་དེ་ནི་དེའི་གནས་ཡིན་ཞིང་དེ་ནི་བཟླས་པའི་ཁྱིམ་གྱི་ངེས་པ་སྟེ་གང་དུ་འདུག་པར་གནས་པ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་པའོ།",
    "ཇི་ལྟར་དེ་ལྟར་འདུག་ནས་ཀྱང་།",
    "པདྨའི་པདྨར་པདྨའོ་ཞེས་འཁོད་འདུག་ཀྱང་བསྡུར་མཆན་དུ་བཀོད་མེད།",
    "པེ་སྣར་འདོད་པའི་གནས་དེར་འདུག་པར།",
    "དག་ཅིང་རང་བཞིན་དྲི་མེད་པ།",
    "མཚམས་སུ་རང་རང་གནས་ཚད་ཀྱི།",
    "པེ་སྣར་དབྱི་ཞེས་འཁོད་འདུག་ཀྱང་བསྡུར་མཆན་དུ་བཀོད་མེད།",
    "དུས་ཀྱི་བསྙེན་པ་ནི་ལོ་འམ་ཟླ་བ་འམ་ཞག་དུས་ཀྱིས་བསྙེན་པར་བྱ་སྟེ་དེ་གང་ཡང་རུང་བས་སྔར་བསྙེན་པ་བྱས་ནས་གཟོད་སྒྲུབ་པ་ལ་འཇུག་པའོ།",
    "དཔེར་ན་དགྲ་མདའ་འཕེན་པ་ལ་སྦྱོར་བ་འདི་བྱས་ན་མདའ་གཞུ་འགེངས་བཞིན་དུ་འཕུམས་ཏེ་འདུག་གོ།",
    "དེ་སྟེ་མེད་ན་མི་འབོ་བར་འཁྱིལ་ཞིང་འདུག་གོ།",
    "དེ་ནས་ཆང་པ་ན་རྡོ་རྗེ་འདུག་པ་བཀྲོལ་ཏེ་བཏང་ན་སྣང་བར་འགྱུར་རོ།",
    "ཁྲི་ལ་འདུག་ནས་བླངས་ཏེ་ཞེས་པ་སྔོན་བསྙེན་པ་བྱས་ནས་ཤིང་ཁྲིའུ་ལ་འདུག་སྟེ་མཚན་གཅིག་སྒྲུབ་པའི་ཆོ་ག་བཞིན་དུ་བསྒྲུབ་པོ།",
    "འགྲོ་སྡོད་འདུག་ཉལ་གྱི་ཚུལ་བསྟན་པས་ཡི་རངས་པར་བྱས་ཏེ་སོ་སོར་དགྱེས་པར་བྱའོ།",
    "ཡི་གེ་སུམ་ཅུ་རྩ་གཉིས་ཀྱང་རང་བཞིན་མེད་པ་ཉིད་མཚུངས་པ་སྟེ།",
    "ལངས་པའམ་འདུག་པའམ་ཞེས་པ་དག་གོ།",
    "ཚོགས་ཀྱི་ནང་དུ་འཇུག་པ་ནི་འདྲེའི་ཚོང་འདུས་སུ་འདུག་པ་སྟེ།",
    "པེ་སྣར་འདུག་པེ་སྣར་བསྟན།",
    "པེ་སྣར་འཇིག་དུས་རབ་ཉིད།",
    "པེ་སྣར་དུ་བསྒྲུབ་ཅེས་འཁོད་འདུག་ཀྱང་བསྡུར་མཆན་དུ་བཀོད་མེད།",
    "འབྲོང་དང་རྔ་སྤུ་རིང་ཞིང་རྔ་རྩེ་གཟེངས་འདུག་མ་ཟད།",
    "ཕལ་ཆེར་འབྲོང་ཤུལ་ཆད་པའི་གནས་ཚུལ་བྱུང་འདུག་དེར་བརྟེན།",
    "རྔོག་མ་ཐུང་ཞིང་གྱེན་དུ་གཟེང་འདུགརྔ་མའི་མར་སྣེ་ན་རྔ་སྤུ་ཁམ་ནག་རིང་བོ་སྐྱེས་ཡོད།",
    "གཙོད་ལ་གཏན་ཁེལ་གྱི་གནས་ཤིག་མེད་པར་དུས་ཚིགས་དང་རྩྭ་ཆུའི་འགྱུར་ལྡོག་ལ་བསྟུན་ནས་གནས་སྤོ་བཞིན་འདུག་ཁ་ཟས་གཙོ་བོ་ནི་སྤང་རྩྭ་དང་ན་རྩྭ་ཡིན།",
    "དུས་ཚིགས་ཀྱི་འགྱུར་ལྡོག་དང་བསྟུན་ནས་གནས་སྤོ་བཞིན་འདུག་དཔྱིད་ཐོག་ཕྲུ་གུ་འཁྲིད་སྐབས་མ་གཏོགས།",
    "འགྲོ་བ་མིའི་རིགས་དང་རང་བྱུང་ཁམས་གཉིས་བསྐལ་པ་མ་སྟོངས་བར་དུ་འཆམ་མཐུན་མཉམ་གནས་བྱེད་དགོས་ན།",
    "རྐང་ལག་མྱུར་ཞིང་རྣ་ཟུང་གྱེན་ལ་བསླངས་འདུག་སྤྱང་ཀིའི་རྔ་མ་སྦོམ་ཞིང་རྔ་མས་ལུས་ཀྱི་རིང་ཚད་ཀྱི་སུམ་ཆའི་གཅིག་ཟིན་འདུག་རྔ་མ་ནམ་ཡང་མར་བསྣར་ཡོད།",
    "བོད་ཁམས་ན་ཉིན་དཀར་ཝ་ཞིག་རིག་རྒྱུ་ནི་ཕལ་ཆེར་དཀོན་པོར་གྱུར་འདུག་དུས་རབས་པའི་དུས་མགོ་ནས་བཟུང་།",
    "རྔ་མའི་རིང་ཚད་ཀྱིས་གཟུགས་ཀྱི་རིང་ཚད་ཀྱི་ཡན་ཟིན་འདུག་གསའ་ཡི་ལུས་ཧྲིལ་བོ་དཀར་སྐྱ་ཡིན་པ་དང་།",
    "གསའ་ཡི་བགྲོད་ལམ་ཕལ་ཆེར་གཏན་ཁེལ་ཡིན་ཞིང་ནངས་དགོང་ལ་ཡར་རྒྱུག་བྱེད་པར་བྲེལ་འདུག་གསའ་ནི་གྲིམ་པོ་གཏུམ་སྤྱོད་ཅན་གྱི་གཅན་གཟན་ཞིག་ཡིན་པས།",
    "གྲུམ་པ་ནི་ཞེ་སྡང་ཆེ་ནའང་རང་འགུལ་གྱིས་མིར་གནོད་པ་མི་བསྐྱལ།",
    "རྔ་མ་ཅུང་རིང་ཞིང་རྔ་མའི་རིང་ཚད་ལ་ལིས་སྨིས་འདུག་བ་ནས་ལིས་སྨིས་ཡོད།",
    "སྣ་ཁུང་ཡར་འཁོར་འདུག་ལུས་ཀྱི་སྤུ་མདངས་ནག་པོ་ཡིན་པ་དང་།",
    "རྩྭ་རྫུབས་སོགས་ན་གནས་འདུག་རི་བོང་ཉིན་དཀར་གཉིད་ལོག་པ་དང་།",
    "ནམ་ཡིན་ཡང་སྡོང་བོའི་ཡལ་གའི་སྟེང་དུ་ཞགས་དཀྲི་བྱས་ཏེ་ཁ་རོག་གེར་ཁ་ཟས་ལ་བསྒུག་འདུག་ཁ་ཟས་གཙོ་བོ་ནི་བྱི་བའི་རིགས་དང་འདབ་ཆགས་ཀྱི་རིགས།",
    "དུག་དང་ལུས་སྟོད་ཡར་འགྲེང་བའམ་མར་དཔྱངས་འདུག།",
    "ནགས་ཚལ་བཅས་ཀྱི་གསེང་ན་གནས་འདུག་པར་མ་ཟད།",
    "ནམ་རྒྱུན་མཚོ་ངོས་ལས་སྨིས་ཡོད་པའི་བར་སྣང་ན་ལྡིང་སྐོར་རྒྱག་པ་དང་ནམ་འཕང་སྟོད་བཞིན་འདུག་སྤྱིར་བྱ་རྒོད་གཅིག་གམ་བྱ་རྒོད་གཉིས་ནས་བྱ་རྒོད་གསུམ་ཙམ་བར་སྣང་དུ་འདུས་ནས་ཁ་ཟས་འཚོལ་བ་དང་།",
