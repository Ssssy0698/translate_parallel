    "གལ་ཏེ་སྐྱེ་བ་དེས་སྐྱེབཞིན་པ་གཞན་པ་སྐྱེད་པར་བྱེད་ན།",
    "དེ་སྐྱེདཐུག་པ་མེད་པར་འགྱུར།",
    "དེ་ཡངགཞན་གྱིས་སྐྱེད་ཅིང་དེ་ཡང་གཞན་གྱིས་སྐྱེད་དེ་མཐའ་མེད་པརའགྱུར་བས་དེ་ནི་མི་འདོད་དོ།",
    "ཇི་ལྟར་གཞན་སྐྱེད་པར་བྱེད་པ་དེསྐྱེད་པ་གཞན་མེད་པར་སྐྱེས་ན་ནི་ཐམས་ཅད་ཀྱང་དེ་བཞིན་དུསྐྱེ་བ་གཞན་མེད་པར་སྐྱེ་བར་འགྱུར་ཏེ།",
    "སྐྱེས་པས་གཞན་སྐྱེདཔར་བྱེད་དོ།",
    "ཡང་ན་འདི་ལྟར་སྐྱེ་བ་ཉིད་ནིསྐྱེད་པ་གཞན་མེད་པར་སྐྱེ་ལ་དངོས་པོ་གཞན་དག་ནི་སྐྱེད་པགཞན་མེད་པར་མི་སྐྱེའོ།",
    "ཞེས་ཁྱད་པར་གྱི་གཏན་ཚིགས་བསྟན་པརབྱ་དགོས་ན་དེ་ཡང་མི་བྱེད་པས་དེའི་སྐྱེ་བས་སྐྱེ་བཞིན་པ་གཞནསྐྱེད་དོ།",
    "སྐྱེ་བ་འཐད་པར་མི་འགྱུར་རོ།",
    "སྐྱེ་བ་འཐད་པར་མི་འགྱུར་ཏེ།",
    "དེ་ཡང་འཇིག་པ་ཟད་པར་འགྱུར་བས་ཟདཔ་ནི་སྐྱེ་བར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་སྐྱེ་བཞིན་པའིགནས་སྐབས་ན་འགག་པར་མི་འགྱུར་པ་ཉིད་དོ་སྙམ་ན།",
    "དེ་ལ་བཤདཔར་བྱ་སྟེ།",
    "གལ་ཏེ་དངོས་པོ་སྐྱེ་བཞིན་པ་ཉིད་ན་འགག་པར་མི་འགྱུར་བ་སྐྱེབཞིན་པ་ཉིད་དངོས་པོ་ཉིད་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "འདི་ལྟར་འཇིག་པ་ནིདངོས་པོའི་མཚན་ཉིད་དུ་བསྟན་པས་དེ་མེད་ན་ཇི་ལྟར་དངོས་པོ་ཡིནཔར་འགྱུར།",
    "དེ་ལྟ་བས་ན་སྐྱེ་བས་གཞནསྐྱེད་པར་བྱེད་དོ་ཞེས་བྱ་བ་དེ་ཡང་མི་འཐད་དོ།",
    "གཞན་གྱི་བདག་ཉིད་ཀྱང་སྐྱེད་པར་མི་བྱེད་པ་དེ་སྐྱེ་པཡིན་པར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "འདི་ལ་དངོས་པོ་གང་ཞིགགནས་པར་འགྱུར་ན་དེ་གནས་པ་གནས་སམ།",
    "གང་དང་ལྡན་པས་གནས་པར་བྱེད་དོ་ཞེས་བྱ་བར་འགྱུར་བའོ།",
    "དངོས་པོ་མ་གནས་པ་ཡང་གནས་པར་མི་བྱེད་དེ།",
    "གནས་བཞིན་ཡང་གནས་པར་མི་བྱེད་དེ།",
    "གནས་པ་དང་མ་གནས་པ་མ་གཏོགས་པར་གནས་བཞིན་པ་མིསྲིད་པའི་ཕྱིར་དང་།",
    "མསྐྱེས་གང་ཞིག་གནས་པར་བྱེད།",
    "གནས་པ་འཐད་པར་མི་འགྱུར་རོ།",
    "དངོསཔོ་འགག་བཞིན་པ་ལ་གནས་པ་འཐད་པར་མི་འགྱུར་རོ།",
    "དེལ་འདི་སྙམ་དུ་གནས་པའི་གནས་སྐབས་ན་འགག་པར་མི་འགྱུར་བཉིད་དུ་སེམས་ན།",
    "གང་གནས་པའི་གནས་སྐབསན་འགག་པར་མི་འགྱུར་བ་དེ་ནི་གནས་པའི་གནས་སྐབས་ན་དངོས་པོཉིད་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "འདི་ལྟར་འཇིག་པ་ནི་དངོས་པོའིམཚན་ཉིད་དུ་བསྟན་པས་དེ་མེད་ན་ཇི་ལྟར་དངོས་པོ་ཡིན་པར་འགྱུར།",
    "གང་དག་རྒ་དང་འཆི་མེད་པར།",
    "གནས་པ་ནི་གནས་པ་གཞན་གྱིས་ཀྱང་གནས་པརབྱེད་པ་མི་རིགས་པ་ཉིད་ཡིན་ལ།",
    "གནས་པ་དེ་ཉིད་གནས་པ་དེ་ཉིདགྱིས་ཀྱང་གནས་པར་བྱེད་པར་མི་རིགས་པ་ཉིད་དོ།",
    "གང་གནས་པར་མི་བྱེད་པ་དེ་གནས་པ་ཡིན་པར་ཇི་ལྟརའགྱུར།",
    "ཇི་ལྟར་གནས་པ་ད་གནས་པ་གཞན་གྱིས་གནས་པརབྱེད་པར་མིརིགས་ཤེ་ན།",
    "དེ་སྐྱེདཐུག་པ་མེད་པར་འགྱུར།",
    "གནས་པ་གཞན་མེད་པརགནས་པར་བྱེད་གྲང་ན།",
    "གལ་ཏེ་གནས་པ་གནས་པ་གཞན་གྱིས་གནསཔར་བྱེད་ན།",
    "དེ་ཡངགཞན་གྱིས་གནས་པར་བྱེད་ཅིང་།",
    "དེ་ཡང་གཞན་གྱིས་གནས་པར་བྱེདཔ་དེ་མཐའ་མེད་པར་འགྱུར་བས་དེ་ནི་མི་འདོད་དེ།",
    "དེ་ལྟ་བས་ནགནས་པ་ནི་གཞན་པ་གཞན་གྱིས་གནས་པར་མི་རིགས་སོ།",
    "ཅི་སྟེ་གནསཔ་དེ་གནས་པ་གཞན་མེད་པར་གནས་པར་བྱེད་དོ་སྙམ་ན་དེ་ལ་བཤདཔར་བྱ་སྟེ།",
    "ཇི་ལྟར་གཞན་གནས་པར་བྱེད་པ་དེ་གནས་པ་གཞན་མེདཔར་གནས་པ་དེ་བཞིན་དུ་ཐམས་ཅད་ཀྱང་གནས་པ་གཞན་མེད་པརགནས་པར་འགྱུར་ཏེ།",
    "གནས་པས་གཞན་གནས་པར་བྱེད་དོ་ཞེས་བྱ་བདོན་མེད་པའི་རྟོག་པ་འདིས་ཅི་བྱ།",
    "ཡང་ན་འདི་ལྟར་གནས་པ་ཉིདནི་གནས་པ་གཞན་མེད་པར་གནས་པ་ལ་དངོས་པོ་གཞན་དག་ནི་གནས་པགཞནམེད་པར་མི་གནས་སོ་ཞེས་ཁྱད་པར་གྱི་གཏན་ཚིགས་བསྟན་པར་བྱདགོས་ན་དེ་ཡང་མི་བྱེད་པས་དེའི་ཕྱིར་གནས་པ་ནི་གནས་པ་གཞནགྱིས་གནས་པར་མི་བྱེད་དོ།",
    "གང་གནས་པར་མི་བྱེད་པ་དེ་ནི་གནས་པཉིད་ཀྱང་མ་ཡིན་པས་དེའི་ཕྱིར་གནས་པ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་འགག་བཞིན་པ་ཡོད་པར་གྱུར་ན།",
    "འགགས་པ་འགག་པར་མི་བྱེད་དེ།",
    "མེད་པ་ལ་ཅི་ཞིག་འགག་པར་འགྱུར།",
    "མ་འགགས་པཡང་འགག་པར་མི་བྱེད་དེ།",
    "འགག་བཞིན་པ་ཡང་དེབཞིན་དུ་འགག་པར་མི་བྱེད་དེ།",
    "སྐྱེབཞིན་པསྐྱེད་པར་མི་བྱེད་དོ་ཞེས་སྨྲས་པ་དེ་བཞིན་ཏེ།",
    "མ་འགགས་པ་མ་གཏོགས་པར་འགག་བཞིན་པ་མི་སྲིད་པའི་ཕྱིརདང་།",
    "དེ་འགགས་ན་འགག་བཞིན་པ་མ་ཡིན་ཞིང་འགག་བཞིན་པ་འགོགཔར་བྱེད་དོ་ཞེས་ཀྱང་བྲྗོད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཅུང་ཟདའགགས་པ་དེ་འགོག་པ་མེད་པ་ཁོ་ནར་འགགས་ན་ནི་དེའི་ལྷག་མ་ཡངདེ་བཞིན་དུ་འགོག་པ་མེད་པ་ཁོ་ནར་འགག་པར་འགྱུར་པར་ངེས་སོ།",
    "ཅུང་ཟད་ནི་འགགས་པས་འགག་པར་བྱེད་པ་ལ་ཁྱད་པར་ཅི་ཡོད་པབྲྗོད་དགོསསོ།",
    "ཅི་སྟེ་དེའི་གང་དུ་ཅུང་ཟད་འགགས་པ་དེ་ཡང་འགག་པ་ཁོནར་བཀག་པ་ནི་དེ་ལྟ་ན་མ་འགགས་པ་འགགས་པས་འགག་པར་བྱེད་ཀྱིའགག་བཞིན་པ་འགག་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིརཅུང་ཟད་འགགས་པ་དེ་ནི་འགགས་པས་འགག་པར་མི་བྱེད་དེ།",
    "དེའི་ལྷག་མ་མ་འགགས་པ་གངཡིན་པ་དེ་འགགས་པས་འགག་པར་བྱེད་དོ་ཞེས་བྱ་བར་འགྱུར་ཏེ།",
    "ཞེས་གང་སྨྲས་པ་དེ་ཉམས་པརགྱུར་ཏོ།",
    "ཅི་སྟེ་དེའི་གང་ཅུང་ཟད་འགགས་པས་འགག་པར་བྱེད་ན་ནིདེལ་འགག་པ་གཉིས་ཀྱིས་བྱས་པའི་ཁྱད་པར་ཅན་དུ་འགྱུར་བ་ཞིག་ནམི་འགྱུར་ཏེ།",
    "འགག་པ་ཟིན་པ་དེ་ལ་ནི་ཡང་འགག་པར་བྱ་བའི་ཕྱིརབྱ་བ་འགའ་ཡང་རྩོམ་པར་མི་བྱེད་པར་དེའི་ཕྱིར་དེ་ནི་ཡང་འགགཔར་མི་བྱེད་དོ།",
    "མ་སྐྱེས་གང་ཞིག་འགག་པར་བྱེད།",
    "ཞེས་བྱ་བ་དེ་སྔར་བསྟནཟིན་པ་དེའི་ཕྱིར་མ་སྐྱེས་པ་གཞན་གང་ཞིག་འགག་པར་བྱེད་ཅེསབྱ་བ་དང་།",
    "འགག་པ་འཐད་པར་མིའགྱུར་རོ།",
    "འགག་པ་མི་འཐད་པར་མི་འགྱུར་རོ།",
    "ཇི་ལྟར་དངོས་པོ་མ་འགགས་པརགནས་པ་རྒྱུ་འགའ་ཞིག་ཁོ་ནས་འཇིག་པར་འགྱུར་བ་དེ་ནི་གཞོན་ནུཡན་ཆད་ཀྱི་མངོན་སུམ་དུ་ཡིན་པས།",
    "སྐབས་གང་དུ་འཇུག་པར་རྟག་པར་དེའི་གནས་སྐབས་དེ་ནིགནས་སྐབས་དེས་འགག་པ་ཉིད་དུ་མི་འགྱུར་ཏེ།",
