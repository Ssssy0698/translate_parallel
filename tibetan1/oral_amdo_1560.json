    "ཁ་ཅིག་གིས་ད་རུང་འདི་འདྲའི་བཙུན་མོ་རྙེད་པར་དཀའ་བས་ནག་རན་པ་གཅིག་ཕབ་སྟེ་བཞག་པ་དྲག་ཟེར་ཁ་མི་མཐུན་པ་མང་པོ་བྱུང་།",
    "དེས་ན་བདུད་བློན་དུག་གི་རལ་པ་ཅན་ཞེས་བྱ་བ་ཤིན་ཏུ་ཁྲོ་ཞིང་གཏུམ་པ།",
    "སྲོག་གཅོད་ཀྱི་ལས་ལ་ལྷག་པར་དགའ་བ་གཅིག་ཡོད་པ་དེས་གཙོས་སྡིག་བློན་རྣམས་ན་རེ།",
    "མཚན་མོ་ས་ཕྱོགས་ཐམས་ཅད་གདུག་པའི་མེ་ལྕེ་རབ་ཏུ་འབར་བ།",
    "ཁྱོད་གསུམ་གྱིས་འདི་དུར་ཁྲོད་ཁྲག་མཚོ་འཁོལ་བའི་གནས་སུ་ཁྲིད་དེ་གསོད་ཅིག།་",
    "དེ་ལྟར་བྱས་ན་ཁྱོད་གསུམ་ལ་རྔན་པ་རྒྱལ་པོའི་མངའ་རིས་གསུམ་ཆ་སྟེར་རོ་ཞེས་སྨྲས་པས།",
    "ཁོང་གཤེད་མ་གསུམ་པོས་དེ་མ་ཐག་ཏུ་གཟུགས་ཀྱི་ཉི་མའི་ཡན་ལག་རྣམས་ལྕགས་སྒྲོག་གིས་བསྡམས།",
    "མཛེས་པའི་རྒྱན་རྣམས་བཀྲོལ་ནས་ཚེར་མའི་ལྕག་གིས་བརྡུངས།",
    "རེ་བ་ནག་པོའི་གོས་ཀྱིས་སྐུ་སྨད་དཀྲིས།",
    "མཚར་ཞིང་ཡིད་དུ་འོང་བའི་བཙུན་མོ་གཟུགས་ཀྱི་ཉི་མ་གཤེད་མ་གསུམ་གྱིས་སྔ་ཐག་ཕྱི་ཐག་བྱས་དྲུད་པ་དང་བརྡེགས་པ་བརྡུངས་པ་ལ་སོགས་མཐོང་བས།",
    "མི་རྣམས་ཀྱིས་བྲང་བརྡུངས་ཤིང་འདུག་ལ་ལ་ཁུ་ཚུར་སེན་མོས་བྱེད་ཅིང་འདུག་ལ་ལ་ལུས་ས་ལ་བརྡབས་ཤིང་འདུག་ལ་ལ་དྲན་མེད་དུ་འགྱེལ།",
    "ཨ་ཕ་ཕ་ཡེ་ཟུག་གཟེར་འདི་འདྲ་ནི།",
    "ཨ་ཀ་ཁ་ཡེ་བུ་མོས་ཅི་ཉེས་པ།",
    "ཀྱེ་མ་ཡིད་འཕྲོག་རབ་མཛེས་ལྷ་གཅིག་བཙུན་མོ་ཁྱོད།",
    "དུས་པས་མིག་ནས་ཁྲག་གི་ཆར་པ་བབས།",
    "ལུས་གཟུགས་བསྲངས་ཀྱང་གོམ་པ་འཁྱར་མ་ཁྱོར།",
    "བུ་མོས་མ་ཉེས་ཉེས་ན་ཅི་སྨྲོས་མཆིས།",
    "ཁོ་མོས་སྡུག་བསྔལ་འདི་འདྲ་མཐོང་ཙ་ན།",
    "རང་ཤ་རང་གིས་ཟ་བ་ཡི་དྭགས་རིགས།",
    "རང་སྲོག་རང་གིས་གཅོད་པ་ཕྱེ་མ་ལེབ།་",
    "རང་ཤ་དྲོན་མོ་སྟེར་བ་ད་རེས་ཙམ།",
    "རང་ཡཔོ་རང་གིས་མ་སྨད་ལྷ་ཡི་སྲས།",
    "རྒྱལ་པོ་དང་བུ་མོས་བྱ་བ་ལན་ཅིག་ཟེར།",
    "ཁོ་མོ་ནག་ལས་མི་འགྲོལ་བའི་ཁར།",
    "ཁོང་འཁོར་འབངས་འདི་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ་ཚིག་ངན་གྱི་སྐུར་བ་མང་རབ་ཅིག་བཏབ་སོང་བས།",
    "རྒྱལ་པོས་མ་ལན་བུ་མོས་ཅི་ཉེས་པ།",
    "བདག་ཅག་རྣམས་ཀྱི་རེ་ལྟོས་སུ་ལ་བཅོལ།",
    "གཟུགས་ཀྱི་ཉི་མ་ཡང་ཁོང་རྣམས་ཀྱི་གདོང་ལ་གཟིགས་ནས་སྤྱན་ཆབ་མང་པོ་ཤོར་ཞིང་།",
    "མིག་གི་བུམ་ཆུས་བྱད་ལ་ལྷ་ཁྲུས་གསོལ།",
    "བཞིན་གྱི་དཀྱིལ་འཁོར་སོར་མོའི་ཐིག་ལེར་སྦྲན།",
    "སྐྲ་ཡི་མེ་ཏོག་སྤར་མོའི་སྙིམ་པས་གཏོར།",
    "མཁྱེན་པས་དགོངས་ལ་བརྩེ་བས་གཟིགས་སུ་གསོལ།",
    "རེ་བལྟོས་ས་གཞན་ན་མི་གདའ་བས།",
    "བསམ་འཕེལ་རེ་བ་སྐོང་བ་ཡིད་བཞིན་ནོར།",
    "ལྷ་གཅིག་བཙུན་མོའི་མཆོག་བདག་གསན་པར་ཞུ།",
    "བལྟས་ན་མཛེས་ཤིང་རེག་ན་འཇམ་པ་ལྟ་བས་ཆོག་མི་ཤེས་པ་འདི་ལྟར་ལ།",
    "ཁོ་མོ་གཅིག་པོ་གུམ་པ་ལ་ཁྱེད་རྣམས་ཚ་གྲང་ཅི་མཾཆིས།",
    "མར་ངན་སོང་ལ་སྦྱིན་གཏོང་སོགས་དགེ་རྩ་རྒྱ་ཆེན་བསྒྲུབ་པ་དང་།",
    "ཁོ་མོའི་བསམ་པ་དེ་ཡིས་རྫོགས་ཞེས་གསུངས་པས།",
    "ཁོ་མོ་ཡི་སྣང་ཚུལ་འདི་ལ་གཟིགས་དང་།",
    "འཁོར་འབངས་མངའ་ཐང་གི་ཕན་པ་གདའ་ཡེ།",
    "མཁར་དང་ཡུལཞིང་གི་ཕན་པ་གདའ་ཡེ།",
    "འཁོར་འབངས་དང་མངའ་ཐང་གི་དགོས་པ་མེད།",
    "ན་ལ་ལྟ་བུ་བུ་མོ་འཕྱོར་འདོད་ཀུན།",
    "མོ་ཁྲོམ་ནང་དུ་སྟོད་ཁ་ལྡང་།",
    "ཁྲུམ་དང་དབྱེན་གྱི་ཁྱོས་མ་ཁྱེར།",
    "ནོར་མཐོང་ཐམས་ཅད་རྒྱུན་དུ་རེ།",
    "མོ་མཐོང་ཐམས་ཅད་གྲོགས་སུ་རེ།",
    "ཕོ་མཐོང་ཐམས་ཅད་ཁྱོ་རུ་རེ།",
    "བུ་མོ་ང་ཡི་སྟེང་དུ་བབས་པ་འདི་ལ་ལྟོས།",
    "བུད་མེད་གཅིག་གི་མ་ཆོག་པར།",
    "ལོང་མེད་འཆི་བ་འདི་ལ་གཟིགས་མཛོད་དང་།",
    "ངེད་རང་རྣམས་ཡུལ་མི་ཁྱིམ་མཚེས་ན་ཟླ་ན་མཉམ་དགྲ་གཉེན་མ་ལུས་པ་ཐམས་ཅད་འཆི་བདག་གི་དྲུང་དུ་འགྲོ་བ་འདི་ལ་སོམས་དང་།",
    "ཁྱད་པར་བུ་མོ་གཟུགས་ཀྱི་ཉི་མ་ང་ཡང་ད་ལྟ་ཁྱེད་རྣམས་ཀྱི་ཁྲོད་ན་ཡོད།",
    "རུས་པ་དུམ་བུ་ཐོར་རེ་བ་དང་།",
    "སྒྲའི་ཉག་མ་ནར་རེ་བ་མིན་པ་མི་ལུས།",
    "དེ་སྐབས་རྒྱལ་པོའི་བཙུན་མོ་གཟུགས་ཀྱི་ཉི་མ་ཡང་ཤི་འདུག་ཟེར་བའི་མིང་སྟོང་པ་ཙམ་མ་གཏོགས་མི་ཡོང་།",
    "འཇིགས་སྐྲག་གི་སྡུག་བསྔལ་བཟོད་གླགས་མེད་པ་མྱོང་དུས།",
    "དེ་དུས་ངན་སོང་གསུམ་དུ་སྐྱེ་བས།",
    "ང་ནི་ཁྱོད་ཚོའི་སེམས་ཀྱིས་གདེང་འདི་ལ་ཞེ་རེ་ཁྲེལ།",
    "ཁོ་མོས་དམུལ་བ་དང་།",
    "དམ་ཚིག་རྣམས་ལ་ཉེས་ལྟུང་གི་དྲི་མས་མ་འགོས་པ་ཡིན།",
    "འདི་དག་བློས་གང་ལྕོགས་ཀྱི་ངོས་ནས་ཉམས་ལེན་རེ་ཅིས་ཀྱང་མཛད་པ་ཞུ།",
    "བསམ་པའི་སྒོ་ནས་ཉམས་ལེན་རེ་མཛད་པ་ཞུ།",
    "འཁོར་འབངས་རྣམས་ཀྱིས་མོས་གུས་དྲག་པོའི་གདུང་ཤུགས་ཀྱིས་འདི་སྐད་ཅེས་ཞུས་སོ།",
    "གང་དུ་གཤེགས་ཀྱང་ཐུགས་རྗེས་གཟིགས་སུ་གསོལ།",
    "འདི་ནང་ཚོགས་པའི་སྐྱེ་འགྲོ་ཕོ་མོ་རྒན་གཞོན་ཀུན་ན་རེ།",
    "ཁོ་མོ་ད་ལྟ་འཆིའང་།",
    "འགྱོད་མེད་གདེང་ལྡན་བྲམ་ཟེའི་བུ་མོ་ང་།",
    "ད་ལྟ་ཤི་ཡང་ཁོ་མོ་འགྱོད་པ་མེད།",
