    "མཚན་ལྡན་བུ་མོ་རྒྱལ་པོའི་ཁབ་བླངས་པར།",
    "བློན་པོ་དྷ་རིས་བུ་མོ་པདྨ་ཅན་གྱི་དྲུང་དུ་འོངས་ནས་འདི་སྐད་སྨྲས་སོ།",
    "མཛེས་སྡུག་ལང་ཚོ་ལྡན་པའི་པདྨ་ཅན།",
    "བུ་མོས་བློན་པོ་ལ་འདི་སྐད་ཅེས་ཞུས་སོ།",
    "བུ་མོ་བདག་ནི་ཕལ་པའི་བུ་མོ་ཡིན།",
    "བདག་འདྲས་རྒྱལ་པོའི་བཙུན་མོ་ག་ལ་འོས།",
    "ས་བདག་རྒྱལ་པོའི་བཙུན་མོ་དགོངས་པ་ཞུ།",
    "དེའི་སང་ཉིན་རྒྱལ་པོ་སྐྱེད་མོས་ཚལ་དུ་ཁྲུས་ཀྱི་རྫིང་བུའི་ཁར་བྱོན་པ་དང་།",
    "བུ་མོ་པདྨ་ཅན་ནང་བློན་རྡོ་རིས་ཁྲིད་དེ་རྒྱལ་པོར་ཕུལ་བས།",
    "བཙུན་མོར་མངའ་གསོལ་བ་སོགས་མེད་པར་ཁབ་ཏུ་བཞེས་པས་ཆབ་འབངས་རྣམས་ནས་འོས་མིན་གྱི་ཇོ་མོ་ཞེས་ལྐོག་ལབ་ཀྱིས་སྐུར་བ་འདེབས།",
    "དེའི་ཚེ་བུ་མོ་པདྨ་ཅན་གྱི་རྨི་ལམ་དུ་མགོན་པོ་འོད་དཔག་མེད་ཀྱི་སྲས་ཡིན་ཟེར་བའི་ཨ་ཙ་ར་རས་སེར་པོའི་ལྭ་བ་གྱོན་པ་ཕྱག་ན་འཁོར་ལོ་བསྣམས་པ་ཞིག་བྱོན་ནས་ཞག་ས་གཡར་དགོས་གསུངས་ཏེ་སྤྱི་བོར་ཐིམ་པ་རྨིས་སོ།",
    "དེའི་སང་ཉིན་བཙུན་མོས་རྒྱལ་པོ་ལ་ཞུས་པ།",
    "མདང་གསུམ་ཁོ་མོ་ཉལ་བའི་རྨི་ལམ་དུ།",
    "དེ་ཡི་མོད་ལ་ལུས་སེམས་བདེ་བས་ཁྱབ།",
    "དེ་ཉིད་ཁྱོད་ཀྱི་མངལ་དུ་ཞུགས་ལགས་ན།",
    "དེ་ནས་ཟླ་ཞག་ཐིམ་པ་དང་འོས་མིན་གྱི་ཇོ་མོ་དེ་ལ་སྲས་མཚན་དཔེས་སྤྲས་པ་འོད་དང་ལྡན་པ་ཞིག་འཁྲུངས་སོ།",
    "མཚན་མཁན་བྲམ་ཟེ་བྷ་དྲ་ལ་བསྟན་པས་སྲས་ཀྱི་སྐུ་ལུས་མཚན་དཔེས་སྤྲས་པ་དེ་མཐོང་བའི་མོད་ལ་འདི་སྐད་ཞུས་སོ།",
    "ཞེས་ཞུས་ཏེ་མཚན་གསོལ་མ་ཐག་ཏུ་མེ་ཏོག་གི་ཆར་དང་ས་གཡོ་བ་སོགས་དགེ་མཚན་གྱི་ལྟས་ཕུན་སུམ་ཚོགས་པ་བྱུང་ཞིང་།",
    "སྡུག་བསྔལ་བས་མནར་ཚུལ་རྣམས་གཟིགས་ནས་གཅུང་པོ་འཁོར་གཡོག་དང་བཅས་པའི་དབུས་སུ་འདི་སྐད་གསུངས་སོ།",
    "རང་ཅག་གཞོན་པའི་ལང་ཚོ་དར་བ་འདི།",
    "ལོ་དང་ཟླ་བ་ཞག་གིས་གཏུགས་ནས་ནི།",
    "མི་རྟག་སྡུག་བསྔལ་སྐྱོབས་ཤིག་སྤྱན་རས་གཟིགས།",
    "མི་རྟག་སྡུག་བསྔལ་སྐྱོབས་ཤིག་སྤྱན་རས་གཟིགས།",
    "མི་རྟག་སྡུག་བསྔལ་སྐྱོབས་ཤིག་སྤྱན་རས་གཟིགས།",
    "ནུབ་ཀྱི་ཕྱོགས་སུ་གཟིགས་པས་བུད་མེད་མང་པོས་ཐགས་འཐག་པ་དང་།",
    "ཡུམ་ཡང་རྒྱལ་པོའི་སྲས་མོ་ཡིན་སྟབས་ཀྱིས།",
    "ཡུམ་ཡང་ཕལ་པའི་བུ་མོ་ཡིན་པ་དང་།",
    "བྱིས་པ་མང་པོ་རྩེད་མོ་རྩེ་ཞིང་།",
    "བུ་ཚ་ལ་ལས་ས་ཕག་གི་ཁྲི་བརྩིགས་ཏེ་གཅིག་དེའི་སྟེང་དུ་བསྡད་ནས་རྒྱལ་བུ་དོན་གྲུབ་རྒྱལ་སའི་ཁྲི་འདོན་བྱེད་པ་ཡིན་ཟེར།",
    "ཤེས་རབ་ལྡན་པའི་ཕོ་གཞོན་མོ་གཞོན་རྣམས།",
    "བུ་ལ་རྒྱལ་ས་མ་ཐོབ་ན་ཨ་མ་ལ་མཐོང་དང་བརྩི་འཇོག་མི་ཡོང་བས་རྒྱལ་བུ་དོན་གྲུབ་འདི་མེད་པའི་ཐབས་ཤིག་བྱ་དགོས་སྙམ་ནས་བསམ་ངན་གྱི་སྣང་བ་ཤར་བར་གྱུར་ཏོ།",
    "དེ་ནས་སྐུབས་ཤིག་གི་ཚེ་འགྲམ་པ་གཡས་སུ་བཙག་བཅུག་གཡོན་དུ་རམ་བཅུག་ནས་ལུད་པ་སྔོ་དམར་ཤིག་གེ་བ་བྱས།",
    "རྒྱལ་པོའི་ཞལ་ནས་ཁྱོད་ཅིས་ན་བ་ཡིན་གསུངས་པས་ན་བ་ལ་ཟེར་ནས་ལན་མ་བཏབ།",
    "དེའི་ཚེ་རིམ་གྲོ་རྒྱ་ཆེ་གང་ཡོང་བྱས་ཀྱང་མ་ཕན་པས་རྒྱལ་པོས་མོ་མ་མངོན་ཤེས་ཅན་ལ་འདི་སྐད་གསུངས་སོ།",
    "ཚུར་ལ་ཉོན་དང་མོ་མ་མངོན་ཤེས་ཅན།",
    "ང་ཡི་བཙུན་མོ་དམ་པའི་བསྙུང་གཞི་འདི།",
    "མོ་མ་ནས་ཞུས་པ།",
    "རང་རེའི་བཙུན་མོ་དམ་པའི་བསྙུང་གཞི་འདི།",
    "ཕན་ཐབས་བཙུན་མོ་རང་ལ་དྲིས་པ་ལེགས།",
    "དེའི་ཚེ་རྒྱལ་པོ་ཡང་ཐུགས་ཁྲལ་གྱིས་ནོན་ནས་བཙུན་མོའི་བསྙུང་གཞི་ཅི་ཡིན།",
    "ད་ནི་བཙུན་མོ་རང་ལ་འདྲི་དགོས་དགོངས་ནས་བཙུན་མོ་ལ་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "བཙུན་མོས་ཞུས་པ།",
    "དེའི་ཚེ་བཙུན་མོས་འདི་སྐད་ཞུས་སོ།",
    "བདག་གི་སྲོག་ལའང་གནོད་པ་སྐྱེལ་བྱེད་པའི།",
    "རང་རེའི་རྒྱལ་བུ་དོན་གྲུབ་ཟེར་བ་འདི།",
    "བྲམ་ཟེ་མཚན་མཁན་གྱིས་ཀྱང་ང་རང་མ་ཤི་བར་རྒྱལ་ས་འཛིན་པའི་ལུང་བསྟན་ཡོད་པས་རང་རེའི་རྒྱལ་ས་མ་ཟིན་ན།",
    "མོ་མའི་ལུང་བསྟན་ཀྱང་བདུད་ཀྱི་ལུང་བསྟན་མིན་ལས་ཆེ།",
    "བདག་ལ་ཟག་པ་གསོག་པ་འདི་འདྲ་རྨི་ལམ་ཡིན་ནམ་མངོན་སུམ་ཡིན་དགོངས་ནས་ཅི་དྲག་ལ་ཐུག་འོན་ཀྱང་བཙུན་མོ་འདི་ལ་སྲས་གཅིག་ཀྱང་ཡོད།",
    "ཚུར་ལ་གསོན་དང་བཙུན་མོ་དམ་པ་ཁྱོད།",
    "དེ་བས་ཁྱོད་ལ་ཕན་ཕྱིར་བསྐྲད་པས་ཆོག་ཞེས་ཞལ་གྱིས་བཞེས་པས་ཅུང་ཟད་ན་བ་ལས་དྲག་བསྐྱེད་བྱུང་ངོ།",
    "རང་རེའི་རྒྱལ་བུ་དོན་རྣམས་གྲུབ་པ་འདི།",
    "ཁྱད་པར་བཙུན་མོ་དམ་པའི་སྲོག་ལ་གནོད།",
    "འོན་ཀྱང་བཙུན་མོའི་སྲོག་ཁག་ལེན་ནུས་ན།",
    "བཙུན་མོའི་སྲོག་ལ་གནོད་པ་ག་ལ་འོངས།",
    "གཞན་དུ་ནར་མོར་བསྟེན་པ་ག་ལ་རིགས།",
    "ཕལ་པའི་བཙུན་མོ་ཁྱེད་ལ་ཐུགས་ལོག་ནས།",
    "དེ་ལྟར་བཙུན་མོའི་ཕྲག་དོག་དུག་ཆུ་ཡིས།",
    "མགོན་མེད་བདག་གི་སྲོག་སྐྱོབ་དམ་པ་མཛོད།",
    "བློ་ཆུང་བདག་གི་ལས་འདི་གཟིགས་སམ།",
    "ས་འ་ཁྱག་གདན་དང་རྡོ་འཁྱག་སྔས་སུ་རེ།",
    "སྐུལ་མ་བཟང་པོའི་སློབ་དཔོན་འདི་དག་གིས།",
    "རང་རེ་ཚེ་འདིར་མཇལ་བར་མ་གྱུར་ཀྱང་།",
    "དེའི་ཚེ་རྒྱལ་བུ་དོན་གྲུབ་ཀྱི་ཐུགས་ལ་བདག་གི་ནུ་བོ་འདི་དང་འབྲལ་ཐབས་ནི་མི་འདུག་ངེད་གཉིས་ཀ་ཕྱིན་ན་ནུ་བོ་དོན་ཡོད་མེད་པས་ཡབ་ཡུམ་གཉིས་ཀ་ཐུགས་ཁྲལ་གྱིས་ཟིན་པར་ངེས་པ་མ་ཟད་རྒྱལ་རྒྱུད་ཀྱང་ཆད་འགྲོ་བ་འདུག་དགོངས་ནས།",
    "རང་སྡུག་རང་གིས་ཉོ་བ་ཁྱོད་འདྲ་ཨང་།",
    "ཡབ་ཡུམ་གཉིས་ཀྱིས་མ་གསན་བྱས་ཏེ་ཆིབས་རེ་དང་།",
    "གསུང་གི་བདུད་རྩིར་སྤྱོད་པའི་བསྐལ་བ་བྲལ།",
    "སྟག་གཟིག་དོམ་དང་དུག་སྦྲུལ་ཚོགས་རྣམས་དང་།"
  ]
}