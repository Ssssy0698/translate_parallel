    "མི་རོ་རེངས་པ་ལྟར་སོང་ནས་བྱ་ཀ་ལ་པིང་ཀ་ལ་སོགས་པའི་སྐད་སྙན་སྒྲོག་པའི་བྱ་རྣམས་ཀྱང་དེར་མི་གནས་པར་ཡུལ་གཞན་དུ་སོང་འདུག་ཡན་ལག་བརྒྱད་དང་ལྡན་པའི་མཚེའུ་དང་རྫིང་བུ་ལ་སོགས་ཀྱང་རང་སར་བསྐུམས་ནས་ཀོ་དོང་དུ་ལྟུང་།",
    "འཇག་མའི་སྤྱིལ་བུ་གཉིས་ཀྱང་བྱ་ཚང་དབྱུག་པས་དཀྲུགས་པ་ལྟར་ཐོར་རེ་ལོང་ངེར་སོང་ཞིང་།",
    "དུད་འགྲོ་ཤྭ་མོ་གཅིག་མིན་པ་གཞན་གཅན་གཟན་དང་རི་དྭགས་ཀྱི་ཚོགས་གཅིག་ཀྱང་མི་གནས་ཤིང་།",
    "ཤུ་བ་མོ་དེ་ཡང་ཟ་བཏུང་ལ་སོགས་དོན་དུ་མི་གཉེར་བར་འཇག་མའི་སྤྱིལ་བུ་ཧྲུལ་པོ་དེ་ལ་སྔས་བྱས་ཏེ་ཉལ་འདུག་པ་ལ།",
    "ཡབ་སྒོམ་ཆེན་དེ་ཉིད་ཡུལ་གཞན་ཞིག་གི་རྒྱལ་པོའམ།",
    "ཁྱོད་མི་འགྱུར་རྡོ་རྗེའི་སྐུ་བརྙེས་ཀྱང་།",
    "བདག་བུ་མོའི་མདུན་དུ་མ་བཞུགས་པར།",
    "བདག་བུ་མོའི་ངག་ལ་བྱིན་གྱིས་རློབས།",
    "འཇའི་རྣམ་པའམ་འོད་ཀྱི་རྣམ་པ་འདྲ་ཞིག་འཇག་སྤྱིལ་གྱི་ནང་དུ་འོད་དམར་སྒོར་སྒོར་ཕྱུང་ནས་དུད་འགྲོ་ཤྭ་མོ་དེའི་སྤྱི་གཙུག་ཏུ་འཐིམ་སོང་ངོ།",
    "དེ་ནས་ཤྭ་མོ་ལངས་ཏེ་སྣ་ཁྲི་ཁྲི་བ་ལན་གསུམ་བྱས།",
    "སྤུ་རྩེའི་ཟིལ་པ་རྣམས་སྤྲུག་འཇག་སྤྱིལ་ལ་བསྐོར་བ་ལན་གསུམ་བྱས་ཏེ་ཤར་ཕྱོགས་སུ་སོང་ངོ།",
    "དེ་ནས་བུ་མོ་གཟུགས་ཀྱི་ཉི་མས་ཀྱང་ཤྭ་མོ་དེའི་རྟིང་བདས་པས།",
    "དེ་ནས་ཡང་འོད་ཀྱི་གོང་བུ་དེ་ཤུ་མོ་ལ་འཐིམ།",
    "དེ་མ་ཐག་ཤྭ་མོ་ལངས་ནས་གཟུགས་ཀྱི་ཉི་མ་ལ་སྐོར་བ་ལན་གསུམ་བྱས་ཏེ་འཇག་སྤྱིལ་གྱི་ནང་དུ་སོང་ངོ།",
    "ཐོད་པ་ལས་གྲུབ་པ་རྣམས་ཐོར་སོང་འདུག་ཅིང་།",
    "ཕྱིས་སུ་ནུབ་གཅིག་གི་རྨི་ལམ་ན་ཁྱེའུ་ཆུང་ཤེལ་ཕྲེང་ཐོགས་པ་གཅིག་བྱུང་བ་རྨིས་པས།",
    "མོའི་ཐུགས་ལ་འདི་ངའི་ཡི་དམ་གྱི་སྤྲུལ་པ་གཅིག་ཡིན་ངེས་སྙམ་ནས།",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་མཆོག་སྤྱན་རས་གཟིགས།",
    "འཁྱམས་པས་མི་ཆོག་ཉོན་མོངས་ཆུ་རྒྱུན་འཕེལ།",
    "ཉོན་མོངས་འཕེལ་ཚེ་སྡུག་བསྔལ་མང་པོས་གཟིར།",
    "སྐྱབས་མཆོག་ཁྱོད་ཀྱིས་མགོན་སྐྱབས་མི་མཛད་དམ།",
    "ཤེས་བྱ་ཀུན་ལ་མངོན་སུམ་གཟིགས་ལགས་ན།",
    "ཁོ་མོ་གཅིག་པུ་འཁྱམས་པ་མ་གཟིགས་ན།",
    "མཁྱེན་བཟང་ཁྱེད་ཀྱི་མཁྱེན་པ་ཕྱོགས་རེ་ཙམ།",
    "ཁྱོད་མིན་བདག་ནི་སྐྱབས་གཞན་མ་མཆིས་ཏེ།",
    "རྣམ་གཡེང་ལེ་ལོའི་ངང་ནས་མགོན་ཁྱོད་ལ",
    "ཐུགས་རྗེ་ཆེན་པོ་འཕགས་མཆོག་སྤྱན་རས་གཟིགས།",
    "སྐལ་མེད་བདག་གི་ཤེས་སྤྱོད་འདི་འདྲ་ན།",
    "འོན་ཀྱང་མགོན་ཁྱོད་རྗེས་སུ་འདྲེན་པ་འདི།",
    "ཁྱོད་བཞིན་བདག་ཀྱང་དམ་བཅའི་ཁུར་ཁྱེར་ནས།",
    "སྐྱེ་བ་འདི་ལ་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་ཐོབ་པའི་སྐལ་བ་མེད།",
    "གན་དྷེ་བཟང་མོ་ལ་བསྟན་པས་དེས་ལན་པ་ཡིན་འདུག་སྙམ་པ་ཐུགས་ལ་དགོངས་ནས།",
    "ཕྱག་དཔེ་རྣམས་བཅུག་སྟེ་རབ་གནས་དང་བཀྲ་ཤིས་ཀྱང་མོ་རང་གིས་མཛད་དོ།",
    "མཚན་ཡང་རྣལ་འབྱོར་མ་ཐུབ་པ་ཆེན་མོ་ཞེས་གྲགས་སོ།",
    "བཙུན་མོ་གཟུགས་ཀྱི་ཉི་མ་དང་བྲལ་བའི་མྱ་ངན་གྱི་ཁུང་བུར་ཚུད་དེ།",
    "བཙུན་མོ་གཞན་ལས་ཕུལ་དུ་ཕྱིན་པ་གཟུགས་ཀྱི་ཉི་མ་དང་བྲལ་བའི་མྱ་ངན་གྱིས།",
    "རིགས་ངན་བུ་མོས་ཐོག་དྲངས་པའི་བཙུན་མོ་ལྔ་བརྒྱ་པོ་ལ་དགའ་མགུར་སྤྱོད་པ་ག་ལ་ཡོད།",
    "སྤྱན་གྱིས་ཀྱང་མི་གཟིགས་པའི་ཁར།",
    "ཡབ་རྒྱལ་པོས་སྲས་ཟླ་བའི་སེང་གེ་ལ་གཟིགས་ནས་ངའི་བུ་དེ་སྐུ་ལུས་འདི་ལྟ་བུར་སོང་བ་ཅི་ཡིན་ནམ་སྙམ་ནས་འདི་སྐད་ཅེས་གསུངས་སོ།",
    "རིགས་བཟང་ལང་ཚོ་ལྡན་པ་ཚུར་ཉོན་དང་།",
    "ལོང་ཚོ་རྒྱས་པའི་སྐུ་ལུས་རིད་པར་གྱུར།",
    "གཞོན་ནུ་བློ་ལྡན་མཆོག་ཁྱོད་ཚུར་ཉོན་དང་།",
    "ཉེ་ན་མིག་ལོང་ལུས་རྣམས་ཐལ་བར་རློག་འདི་འདྲ་ཅི་ཡིན་མི་ཤེས་བཏང་སྙོམས་ཞོག་ཉི་མ་འདིལ་མཐུ་སྟོབས་རྣམ་པ་གཉིས།",
    "བཙུན་མོ་སྐར་མའི་ཚོགས་བཞིན་འདུས་ལགས་ཀྱང་།",
    "བདག་གི་གཟུགས་མཛེས་ཉི་མ་དེ།",
    "བདག་གིས་གཅེས་པར་བཟུང་བཟུང་ནས།",
    "བདག་གིས་འབད་པ་དོན་མེད་སོང་།",
    "ཁྱོད་ཀྱི་གཅུང་པོ་ཟླ་བའི་གཞོན་ནུ་དང་།",
    "ལྷ་མོར་མ་འཛིན་ཕ་ཡི་བུ།",
    "རྒྱལ་བུ་ཟླ་བའི་སེང་གེ་ན་རེ།",
    "མྱ་ངན་མྱུར་དུ་སེལ་ཅིག་བྲམ་ཟེ་མཆོག་ག་ཅེས་ཟེར་ཞིང་གཟུགས་ཀྱི་ཉི་མ་དྲན་པའི་གདུང་ཤུགས་ཀྱིས་རྒྱལ་པོས་ཐོག་དྲངས་འཁོར་འབངས་རྣམས་ཀྱི་ལོངས་སྤྱོད་ཀྱི་གསུམ་ཆ་གཉིས་མོའི་དགེ་རྩར་སྦྱར་ཞིང་།",
    "རྣལ་འབྱོར་མ་ཐུབ་པ་ཆེན་མོ་རྒྱལ་ཁམས་ཕྱོགས་མེད་སྐོར་བའི་རྟིང་ལ།",
    "དེའི་ནུས་སུ་གན་དྷེ་བཟང་མོ་ཡང་ཡོད་པ་ཡིན་འདུག་པས།",
    "གན་ངྷ་བཟང་མོས་བཟའ་ཚང་འཁོར་གཡོག་རྣམས་ལ་ཁྱེད་རྣམས་ཕྱིར་ཐོན།",
    "དེ་ནས་གན་ངྷ་བཟང་མོས་རྣལ་འབྱོར་མའི་སྤྱན་སྔར་པུས་མོ་གཉིས་ས་ལ་བཙུགས།",
    "ལག་པ་གཉིས་ཐལ་མོ་སྦྱར་ནས་བཤགས་པའི་ཚིག་འདི་བཞིན་བརྗོད་དོ།",
    "བདག་སྡིག་མོ་ཆེ་ཡིན་པས་རྣལ་འབྱོར་མས་དགོངས་སུ་གསོལ།",
    "སློབ་དཔོན་ཆེན་མོ་བདག་ལ་དགོངས་སུ་གསོལ།",
