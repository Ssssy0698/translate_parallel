    "གང་ལས་དེ་ཆོད་པ་མེད་པར་འགྲུབ་པར་འགྱུར་པ་དེ་ལྟར་སྒྲུབ་པར་བྱེད་པ་དེ་ཉིད་ཀྱི་ཡང་བྱ་བ་དེ་ཉིད་ཡིན་ཏེ།",
    "རྣམ་པར་བཞག་པ་ཐོབ་པ་ཡིན་ནོ་ཞེས་སོ།",
    "དེས་ཁྱད་པར་དུ་བྱས་པ་བཀོད་པ་གཉིས་ཀྱི་དང་པོ་ལ།",
    "གཞན་གྱིས་ཁྱད་པར་དུ་བྱས་པ་སྟེ།",
    "རྒྱུས་བསྐྱེད་ཀྱི་བྱས་པ་དང་།",
    "མཚན་ཉིད་ནི་བཏགས་ཡོད་རྐྱང་པར་གྲུབ་ཀྱང་མཚན་ཉིད་དུ་གདོད་བྱ་དེའི་རྣམ་པར་གཞག་བྱ་མིན་པ་སྟེ།",
    "རྒྱུས་བསྐྱེད་བྱས་པར་མཚོན་པ་ལ་བྱས་པ།",
    "བྱས་པ་སྐད་ཅིག་མར་མཚོན་པ་ལ་སྐད་ཅིག་བུམ་པ་རྟག་པར་མཚོན་པ་ལ་འཇིག་མེད་བྱས་པ་བྱས་པར་མཚོན་པ་རྒྱུས་བསྐྱེད་བཀོད་པ་བཞིན་ནོ་ཞེ་ན།",
    "བྱས་པ་སོགས་མཚོན་བྱ་ཐམས་ཅད་མཚན་གཞིའི་རྟེན་དུ་རུང་བས་མཚན་གཞིའི་རྟེན་མིན་པ་མི་སྲིད་དོ།",
    "མཚན་ཉིད་ནི་རིམ་པ་ལྟར་མཚན་ཉིད་དང་མཚོན་བྱས་མ་ངེས་ལ་དབྱེ་བ་ཡང་མི་འཐད་དེ་མཚོན་གཞི་ཁོ་ནའི་སྐྱོན་དུ་མ་ངེས་པའི་ཕྱིར།",
    "བྱས་པར་མཚོན་པ་ལ་རྒྱུས་བསྐྱེད་དང་།",
    "བྱས་པ་མཚོན་གཞིར་བཀོད་པ་བཞིན་ནོ།",
    "འགལ་བ་དང་ཐེ་ཚོམ་ཟ་བ་ནི་བྱས་པར་མཚོན་པ་ལ་འཇིག་མེད་དང་།",
    "བུམ་པ་བྱས་པར་མཚོན་པ་ལ་རྒྱུས་བསྐྱེད་དང་།",
    "ཤིང་རྟག་པར་མཚོན་པ་ལ་ནོག་སོགས་འདུས་པ་བཀོད་པ་བཞིན་ནོ།",
    "ངོ་བོ་གཅིག་ཏུ་འབྲེལ་ཞིང་གཞི་ལྡོག་གཅིག་ལ་བརྟེན་པར་འགལ་ལོ།",
    "མངོན་སུམ་གྱིས་ཤེས་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "ཐ་སྙད་ཀྱི་ཡུལ་ཅན་མཚན་ཉིད་ཀྱི་གཏན་ཚིགས་དེ་ནི་ལན་གཅིག་ཐ་སྙད་ཞུགས་པ་ཉིད་ལས་ཐ་སྙད་དང་འབྲེལ་པར་ཤེས་པར་འགྱུར་ཏེ།",
    "མཚན་གཞི་དང་མཚན་ཉིད་གྲུབ་པ་ནི་མཚན་ཉིད་རྗེས་སུ་གྲུབ་ན་མཚན་གཞི་ཤེས་པར་བྱེད་ལ།",
    "མཚན་གཞི་དང་མཚན་ཉིད་ཀྱི་དངོས་པོ་མ་གྲུབ་པའི་ངག་ལ་ནི་མཚན་ཉིད་སྒྲབ་པར་བྱེད་དོ།",
    "རང་ལྡོག་ལ་བརྟེན་པར་དང་།",
    "གཞན་ལྡོག་མ་ཡིན་པར་མཚོན་ཚུལ་དང་།",
    "བུམ་པ་མཚོན་གཞི་བྱས་པའི་ཐ་སྙད་བྱར་རུང་རྒྱུ་རྐྱེན་ལས་སྐྱེས་པའོ་ཞེས་རྩ་བའི་སྦྱོར་བ་སྟེ།",
    "རྒྱུས་བསྐྱེད་ཀྱི་མཚོན་བྱའི་ཐ་སྙད་ལ་རྒྱུས་བསྐྱེད་ཀྱིས་བར་མ་ཆད་པར་མཚོན་པར་བྱར་རུང་ཡིན་མིན་གཉིས་ཀས་ཁྱབ་སྟེ།",
    "བྱས་པའི་མཚོན་གཞིར་རུང་བ་ལའང་བྱས་པ་མཚོན་པའི་གཞི་ཡིན་མིན་གཉིས་ཀས་ཁྱབ་སྟེ།",
    "བྱས་པའི་མཚོན་གཞིའི་མཚན་ཉིད་ཡིན་པས་དང་།",
    "བྱས་པའི་མཚོན་གཞི་མིན་པས་སོ།",
    "གཙང་ནག་པས།",
    "མཚན་ཉིད་ཀྱི་མཚན་གཞི་དེ་མཚོན་བྱ་དེ་། བརྟེན་གྱི་རིགས་མི་མཐུན་མཚན་ཉིད་ཐ་སྙད་ཀྱི་རང་ལྡོག་ལ་བརྟེན་པར་མ་ཞུགས་ཤིང་།",
    "མཚན་ཉིད་ཐ་སྙད་བྱར་རུང་མིན་ཏེ་མཚན་ཉིད་མིན་པས་སོ་ཞེ་ན་བུམ་པའི་ལྡོག་པའང་བུམ་པ་མིན་པར་མཚུངས་སོ།",
    "སྤྱིའི་བློ་རྣམ་པར་རྟོག་པ་ཅན་ལ་དེ་ལྟར་རྣམ་པ་གཅིག་ཏུ་སྣང་བའི་ཕྱིར་ལྡོག་པ་ལ་སྤྱི་ཞེས་བྱའོ་ཞེས་སོ།",
    "དེས་ན་མཚན་ཉིད་ཀྱི་བསལ་བྱ་བོད་བསྡས་སྨྲ་བ་རྣམས་ཀྱིས་ངོ་མ་ཤེས་པར་བསལ་བྱའི་རིགས་མི་མཐུན་དང་མཚོན་བྱ་དེ་རྟེན་གྱི་རིགས་མི་མཐུན་ཞེས་ཐ་སྙད་དུ་བྱེད་པ་ནི་ཆམེད་ཀྱི་རྒྱུས་གཏམ་དུ་ཤེས་པར་ཟད་དོ།",
    "མཚོན་བྱ་མིན་པའི་ཐ་སྙད་མཚོན་བྱ་ཡིན་པར་འགལ་ཞེས་པའི་ལན་ཡང་བསྟན་ཟིན་ཏེ།",
    "ཁ་ཅིག་དེ་བུམ་བྱས་ལ་མ་ཞུགས་ཤིང་རྒྱུ་བསྐྱེད་གཞི་བུམ་པ་མ་ཞུགས་ཤིང་བྱས་པའི་དོན་ལྡོག་ཡིན་པས་སྐྱོན་གཉིས་ཀ་མེད་དོ་ཞེས་པ་མི་འཐད་དེ།",
    "བུམ་བྱས་ལ་ཞུགས་ཀྱང་མཚན་ཉིད་ཐ་སྙད་མེད་པའི་གཞི་ལ་ཞུགས་པར་མི་འགྱུར་ཏེ།",
    "དེ་ཉིད་ཀྱིས་བྱས་པའི་མཚན་ཉིད་དུ་གྲུབ་པའི་ཕྱིར།",
    "བྱས་པའི་ཐ་སྙད་བརྟན་པའི་ཕྱིར་རོ།",
    "བྱས་པའི་མཚན་ཉིད་དུ།",
    "མཚོན་པའི་མཚན་ཉིད་དེ་རྒྱུས་བསྐྱེད་ཀྱི་གཞི་མཚོན་བུམ་བྱས་ལ་ཁེགས་ན་དེའི་ཕྱིར།",
    "ཁ་ཅིག་རྒྱུས་བསྐྱེད་དེ་བྱས་པའི་མཚན་ཉིད་དུམཚོན་པའི་མཚན་ཉིད་ཀྱི་ལྡོག་པ་མིན་ཞིང་རྟེན་གཞི་ཡིན་པས་སྐྱོན་གཉིས་པོ་མེད་ཅེས་པ་ནི་མི་འཐད་དེ།",
    "རྒྱུས་བསྐྱེད་བྱས་པའི་མཚོན་བྱ་དང་། མཚན་ཉིད་མིན་པའི་ཕྱིར།",
    "གཉིས་པ་གཞན་ལྡོག་མ་ཡིན་པར་མཚོན་ཚུལ་གཉིས་ཀྱི་དངོས་ལ།",
    "མཚོན་གཞི་མིན་པར་མཚོན་པའི་སྤྱི་སྦྱོར་ནི་སྐྱོན་ཅན་ཁོ་ནའོ།",
    "རྒྱུ་བསྐྱེད་རྒྱུ་བསྐྱེད་ཀྱི་མཚོན་མིན་པར་མཚོན།",
    "རྒྱུ་བསྐྱེད་མཚོན་བར་མ་ཆད་པར་མཚོན་པར་བྱར་རུང་མིན་པར་གྲུབ་པ་དང་བྱས་པ་བྱས་པའི་མཚོན།",
    "བྱས་པ་མཚོན་པའི་གཞིར་རུང་བ་མིན་པར་གྲུབ་པའོ།",
    "མཚོན་བྱ་མིན་པ་དེ་མཚོན་བྱ་ཡིན་ན་མཚོན་བྱའི་མཚན་ཉིད་བཀག་ནས་མཚོན་པར་འགལ་ལ།",
    "མིན་ན་མཚན་ཉིད་ལ་མི་ལྟོས་པར་འགྱུར་རོ་ཞེ་ན།",
    "རྟེན་གཞི་ཡིན་པས་རྣམ་འཇོག་ལ་ལྟོས་ཞེས་གསུངས་ངོ།",
    "མཚོན་བྱའི་མཚན་ཉིད་བཀག་པ་དེ་ཡིན་པར་བཀའ་གྲུབ་པས་དེ་མཚོན་དེ་མཚོན་བྱ་མིན་པ་རི་བོང་རྭ་ལ་གྲུབ་ཀྱང་མཚོན་བྱ་མིན་པའི་ཐ་སྙད་བྱར་རུང་བ་མ་གྲུབ་པ་བཞིན་ནོ།",
