    "ཡབ་བདག་ལ་མ་ཡར་མོ་འདིས་ཟས་ངན་པ་དང་།",
    "གོས་ངན་པ་བསྲེལ་དུ་སྩོལ་ཅིང་ཁུ་ཚུར་དང་ཐལ་ལྕག་དག་གིས་ཀྱང་ཡང་དང་ཡང་དུ་རྡེག་པར་བགྱིད་དོ།",
    "བཟང་མོ་ཁོ་བོས་ཁྱོད་ལ་དང་པོ་ཉིད་ནས་གཞན་ལས་སྐྱེས་པས་ནི་བྱ་བ་བྱེད་པར་ནུས་ཀྱི་མི་མཐུན་པར་སྐྱེས་པས་ནི་མི་ནུས་པས་ཁྱེའུ་འདི་ཁྱོད་ཀྱི་བུ་ཡིན་གྱིས་ཁྱོད་ཀྱིས་འདི་ལ་མཁོ་བ་བསྟབས་པར་བྱའོ་ཞེས་མ་སྨྲས་སམ།",
    "ཅིའི་ཕྱིར་ཁྱོད་ཀྱིས་འདི་ལ་ཟས་ངན་པ་དང་།",
    "གོས་ངན་པ་བསྲེལ་དུ་འཛུད་ཅིང་ཁུ་ཚུར་དང་ཐལ་ལྕག་དག་གིས་ཀྱང་ཡང་དང་ཡང་དུ་རྡེག་པར་བྱེད།",
    "རྗེའི་སྲས་བདག་གིས་འདི་བསླབ་པར་བགྱི་སྟེ།",
    "ཁྱོད་འདི་སློབ་པར་མ་བསྐོས་ཀྱིས་ཕྱིན་ཆད་འདི་ཟས་ངན་པ་དང་།",
    "ཐལ་ལྕག་གིས་ཡང་དང་ཡང་དུ་མ་རྡེག་ཤིག།",
    "ཁུ་ཚུར་དང་ཐལ་ལྕག་གིས་ཀྱང་ཡང་དང་ཡང་དུ་རྡེག་པར་བྱེད་དོ།",
    "བདག་གི་ཕས་མ་ཡར་མོ་འདི་དྲག་ཏུ་མ་བཟློག་པས་དེས་མ་ཡར་མོ་འདི་བདག་ལ་ཕྱིར་ཞིང་ཤས་ཆེར་ཟས་ངན་པ་དང་།",
    "ཁུ་ཚུར་དང་ཐལ་ལྕག་དག་གིས་ཀྱང་ཡང་དང་ཡང་དུ་རྡེག་པར་བྱེད་ཀྱིས་བདག་རབ་ཏུ་འབྱུང་དུ་འགྲོའོ་སྙམ་ནས།",
    "ཁྱེའུ་དེས་ཕ་ལ་ཡབ་ཁྱོད་ཀྱིས་བདག་གི་མ་ཡར་མོ་འདི་བཟློག་ཀྱང་འདིར་སླར་ཞིང་ཤས་ཆེར་བདག་ཟས་ངན་པ་དང་།",
    "ཁུ་ཚུར་དང་ཐལ་ལྕག་དག་གིས་ཀྱང་ཡང་དང་ཡང་དུ་རྡེག་པར་བགྱིད་ཀྱིས་བདག་རབ་ཏུ་འབྱུང་དུ་མཆིའོ།",
    "བུ་ཁྱིམ་བདག་གི་ཆུང་མ་འདི་གཏུམ་པ་བརྟུན་ངས་པ།",
    "དྲག་ཤུལ་ཆེ་བ་ཡིན་གྱིས་སོང་ལ་རབ་ཏུ་བྱུང་ཤིག་དང་།",
    "ཁྱོད་གསོན་པ་མཐོང་བར་ཡང་འགྱུར་གྱི།",
    "གལ་ཏེ་ན་ཁྱོད་ལ་གནོད་པ་བྱེད་པར་འགྱུར་བའི་གནས་ཀྱང་ཡོད་དོ།",
    "བཞིན་བཟངས་ཁྱོད་ཀྱིས་སེམས་བསྐྱེད་པ་ལེགས་ཏེ།",
    "བཞིན་བཟངས་དགེ་སློང་གི་ལས་ནི་གཉིས་ཏེ།",
    "ཁོ་བོ་ནི་བསམ་གཏན་པ་ཡིན་ན་ཁྱོད་བསམ་གཏན་དང་།",
    "ཡུལ་གཞན་དུ་འགྲོའོ་སྙམ་ནས་དེ་ཡུལ་གཞན་དུ་སོང་ངོ།",
    "བུས་ཕྲག་པ་གཅིག་གིས་ནི་ཕ།",
    "ཚོང་དཔོན་དེ་རྒྱལ་བྱེད་ཀྱི་ཚལ་དུ་སོང་བ་དང་།",
    "བུ་ཁྱོད་ཀྱིས་ཁོ་བོ་སྤངས་ཏེ་རབ་ཏུ་བྱུང་མོད་ཀྱི།",
    "ཁྱོད་དགེ་སློང་དུ་རེད་ཅིང་མང་དུ་ཐོས་པར་གྱུར་པ་ལེགས་ཏེ།",
    "དགེ་སློང་དེས་ཚོང་དཔོན་དེ་ལ་གང་གིས་ཚོང་དཔོན་དེ་དད་པ་སྐྱེས་པས་སྐྱབས་སུ་འགྲོ་བ་དང་།",
    "བདག་གིས་བུ་དེ་མ་བགྲོས་པར་གྱ་ཙོམ་དུ་འགྲོན་དུ་བོས་ན་བདག་གི་ཆུང་མ་དེ་ཡང་གཏུམ་པ།",
    "དེ་ལ་ཇི་ལྟར་བསྒྲུབ་པར་བྱ་སྙམ་མོ།",
    "ད་ནི་དེ་འགྲོན་དུ་བོས་ཟིན་པས་ཅི་བྱར་ཡང་མེད་ཀྱིས་བདག་གིས་གང་གིས་ཆུང་མ་དེ་འཁྲུགས་པར་མི་འགྱུར་བར་རྣམ་པ་ཐམས་ཅད་དུ་དགའ་བ་དང་སྙན་པའི་ཚིག་དག་གིས་ཐབས་བཤམ་པར་བྱའོ་སྙམ་ནས་དེ་ཁྱིམ་དུ་སོང་སྟེ་ཆུང་མ་ལ་སྨྲས་པ།",
    "བཟང་མོ་འཁྱམས་པ་དང་།",
    "བཟང་མོ་འགྲོན་དུ་བོས་ཀྱིས་ཟས་སྟ་གོན་གྱིས་ཤིག།",
    "ཆུང་མ་དེ་དེ་ལ་ཞེ་སྡང་གི་ཀུན་ནས་དཀྲིས་པ་དང་བྲལ་ནས་དེས་ཟས་བསིལ་བའི་རོ་དང་ལྡན་པ་གང་དག་ཡིན་པ་དེ་དག་ནི་དེ་ཉིད་ཀྱི་ཉིན་མོ་སྟ་གོན་བྱས།",
    "དེ་ནས་ཚོང་དཔོན་དེ་ཆུང་མ་དང་བཅས་པས་རང་གི་ལག་ནས་ཟས་བསོད་པས་དགེ་སློང་དེ་ཚིམ་པར་བྱས་ཤིང་རང་གི་ལག་ནས་བསྟབས་སོ།",
    "དེས་མ་ཡར་མོ་དེ་ལ་ཡང་གང་ཐོས་ན་དེས་ཀྱང་སྐྱབས་སུ་འགྲོ་བ་དང་།",
    "དེའི་བུས་བདག་གི་ཕ་ན་བར་གྱུར་ཏོ་ཞེས་ཐོས་ནས་དེ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དགེ་སློང་དེ་དེའི་དྲུང་དུ་དུས་དང་འཐུན་པའི་དུས་སུ་སོང་ནས་འདི་སྐད་ཅེས་ཡབ་ཁྱོད་ཀྱིས་མི་དགྱེས་པར་མི་བགྱི་སྟེ།",
    "གྲོལ་བའི་སྤོབས་པ་ཅན་དེ་གཞན་དུ་སྨྲ་བར་མི་འགྱུར་བས་བདག་སྡུག་བསྔལ་གྱི་ཚོར་བས་ཉེན་པ་ནི་ཐུན་མོང་མ་ཡིན་པས་བདག་གིས་བདག་ཉིད་གསོད་པར་བྱའོ་སྙམ་མོ།",
    "དེ་ལ་བྲན་མོ་མངག་གཞུག་མ་སྐྱོང་མ་ཞེས་བྱ་བ་སྦོམ་མོ།",
    "སྐྱོང་མ་འདི་ནི་སྦོམ་མོ་གླེན་མ།",
    "དམན་པ་ཡིན་པས་འདིས་བདག་སྲོག་དང་བྲལ་བར་བྱེད་ནུས་ཀྱིས་གཞན་གྱིས་ནི་མི་ནུས་སྙམ་མོ།",
    "ཚོང་དཔོན་དེའི་ཁྱིམ་དང་ཧ་ཅང་ཐག་མི་རིང་བ་ཞིག་ན་ཁྱིམ་བདག་ཅིག་གིས་བུས་ཆུང་མ་བླངས་པ་དེར་ཚོང་དཔོན་དེའི་ཆུང་མ་བྲན་མོ་མངག་གཞུག་མ་སྐྱོང་མ་དང་བཅས་ཤིང་འགྲོན་དུ་བོས་ཏེ་སོང་ངོ།",
    "སྟོན་མོ་ཟིན་ནས་ཚོང་དཔོན་གྱི་ཆུང་མས་སྐྱོང་མ་ལ་སྨྲས་པ།",
    "སྐྱོང་མ་ཁྱོད་སོང་ལ་ཚོང་དཔོན་གཉིད་ལོག་པར་མི་འགྱུར་བར་སྲུངས་ཤིག།",
    "ཁོ་མོ་ཡང་ཕྱི་བཞིན་འོང་ངོ།",
    "སྐྱོང་མས་རྗེ་མོའི་ཚིག་མཉན་ཏེ་ཁྱིམ་དུ་སོང་ནས་ཚོང་དཔོན་གྱི་དྲུང་དུ་ཕྱིན་པ་དང་།",
    "སྐྱོང་མ་ཁྱོད་ག་ལས་འདིར་འོངས།",
    "རྗེའི་སྲས་ཁྱིམ་བདག་ཆེ་གེ་མོའི་བུས་བག་མ་བླངས་པ་དེ་བདག་གིས་བལྟས་ཏེ་འཚལ་མ་འཚལ་ནས་མཆིས་སོ།",
    "གལ་ཏེ་ངས་ཁྱོད་དེ་ལྟར་བག་མར་གཏང་བར་བྱ་ན་ཁྱོད་དགའ་འམ།"
  ]
}