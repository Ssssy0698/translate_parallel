    "གལ་ཏེ་མི་བྱེད་ན་བདག་ཅག་གིས་འདི་གཞན་ལ་སྦྱིན་པར་བྱའོ།",
    "འདི་བདག་ཅག་གིས་བྱིས་པ་ནས་བསྐྱེད་པ་ཡིན་པས་གལ་ཏེ་གཞན་དུ་འགྲོ་བར་འགྱུར་ཞིང་རིགས་གཉིས་ག་ལ་མི་སྙན་པ་འབྱིན་པར་འགྱུར་ན་མ་ལེགས་ཀྱིས།",
    "བདག་གིས་འདི་བདག་གིར་བྱའོ་སྙམ་དུ་རིག་ནས།",
    "དེ་ལ་ན་ཟླ་དག་གིས་སྨྲས་པ།",
    "དེའི་གྲོགས་མོ་ཆེས་མཛའ་བ་ཞིག་ཡོད་པ་དེས་སྨྲས་པ།",
    "གང་གི་ཚེ་བདག་ཕུ་བོ་དེ་ལ་སྤྲིན་བཞིན་དུ་ལྟ་བར་འདོད་པ་དེའི་ཚེ་ན་ནི་དེ་མ་འོངས་ལ།",
    "ད་བདག་གིས་ཉེས་པར་སྤྱོད་པ་འདི་ལྟ་བུ་བྱས་ན་དེ་འོང་བར་གྱུར་ཏེ་ཁོན་རྣམས་ཀྱི་ནང་ན་འདི་ལྟ་སྟེ།",
    "བུད་མེད་ཀྱི་ཁོན་ཐ་ཆད་ཡིན་པས་བདག་ལ་གནོད་པ་བྱེད་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ལྟ་བུའི་གནས་ཡོད་ཀྱིས་བྲོས་ཏེ་འགྲོའོ་སྙམ་མོ།",
    "ཤཱཀྱའི་སྲས་ཀྱི་དགེ་སྦྱོང་འདི་དག་གིས་ཀོ་ས་ལར་བྱུང་བའི་རྒྱལ་པོ་གསལ་རྒྱལ་ལས་གཞོན་ནུའི་ཡོངས་སུ་སྤང་བ་ཐོབ་པས་དེ་དག་གི་ནང་དུ་རབ་ཏུ་བྱུང་ན་དེས་དེར་ཅི་ཞིག་བྱ་བར་འགྱུར་སྙམ་ནས།",
    "མཉན་ཡོད་རྒྱ་ཆེ་ལ་རང་གི་སྤྱོད་ཡུལ་དང་ཡབ་ཀྱི་ཡུལ་ཡིན་གྱིས་བསོད་སྙོམས་རྒྱུས་ལ་འཚོ་བར་གྱིས་ཤིག།",
    "དེ་སྤྱོད་ཡུལ་ལ་མི་མཁས་པས་གྲོང་རིམ་གྱིས་རང་གི་ཁྱིམ་དུ་ཞུགས་པ་དང་།",
    "ཁྱོད་ཀྱང་དེ་སྐད་ཅེས་ཅིའི་སླད་དུ།",
    "ཁྱོད་ཀྱིས་ཁོ་མོ་སྤངས་ཏེ་རབ་ཏུ་བྱུང་ཞེས་ཟེར་རམ།",
    "གང་གིས་ཚེ་བདག་ཕུ་བོ་དེ་ལ་སྤྲིན་བཞིན་དུ་ལྟ་བར་འདོད་པ་དེའི་ཚེ་ན་ནི་དེ་མ་འོངས་ལ།",
    "བདག་གིས་ཉེས་པར་སྤྱོད་པ་འདི་ལྟ་བུ་བྱས་ན་དེ་འོང་བར་འགྱུར་ཏེ།",
    "བུད་མེད་ཀྱི་ཁོན་ཐ་ཆད་ཡིན་པས་བདག་ལ་གནོད་པར་བྱེད་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ལྟ་བུའི་གནས་ཡོད་དོ།",
    "ཁྱོད་ཀྱིས་ནི་རེ་ཤིག་བདག་ཉིད་ཐར་བར་བགྱིས་ན།",
    "ཁོ་མོས་ཇི་ལྟར་བསྒྲུབ་པར་བགྱི།",
    "གལ་ཏེ་ཡིད་མི་ཆེས་ན་རྒྱལ་བྱེད་ཀྱི་ཚལ་དུ་སོང་ལ་ལྟོས་ཤིག།",
    "ཁྱོད་ཀྱང་དེ་སྐད་ཅེས་ཁྱོད་ཀྱིས་ཅི་ཞིག་རྗེས་སུ་བསྒྲུབས་ན་ཁོ་བོ་ལ་ཡང་མ་དྲིས་པར་རབ་ཏུ་བྱུང་ཞེས་ཟེར་རམ།",
    "གང་གི་ཚེ་བདག་ཕུ་བོ་དེ་ལ་སྤྲིན་བཞིན་དུ་བལྟ་བར་འདོད་པ་དེའི་ཚེ་ན་ནི་དེ་མ་འོངས་ལ།",
    "ད་བདག་གིས་ཉེས་པར་སྤྱད་པ་འདི་ལྟ་བུ་བྱས་ན་དེ་འོང་བར་འགྱུར་ཏེ།",
    "བུད་མེད་ཀྱི་ཁོན་ཐ་ཆད་ཡིན་པས་བདག་ལ་གནོད་པར་བྱེད་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ལྟ་བུའི་གནས་ཡོད་དོ།",
    "སྤོས་འཚོང་གི་ཁྱེའུས་སྨྲས་པ།",
    "ཁྱོད་ཀྱིས་ཁོ་བོ་ལ་ཅིའི་ཕྱིར་མ་སྨྲས།",
    "དེ་ནས་སྤོས་འཚོང་གི་ཁྱེའུ་དེས་རྫས་རྣོན་པོ་དག་ཕྱེ་མར་བྱས་ཏེ་བུ་མོ་ཞིག་གི་ལག་ཏུ་བྱིན་ནས་སྨྲས་པ།",
    "ཡང་ན་ཟླ་དག་གིས་མཐོང་ནས་དེ་དག་གིས་སྨྲས་པ།",
    "ཁྱོད་ཀྱི་མངལ་ན་གནས་པ་དེ་གར་སོང་།",
    "དེའི་གྲོགས་མོ་ཆེས་མཛའ་བ་དེ་དེའི་གན་དུ་སོང་སྟེ་སྨྲས་པ།",
    "གང་ཁོ་ན་ལས་འོངས་པ་དེ་ཁོ་ནར་སོང་ངོ།",
    "དེ་ཤཱཀྱའི་སྲས་ཀྱི་དགེ་སྦྱོང་རྣམས་ཀྱི་དགེ་སྦྱོང་གི་ཚུལ་ནི་ཚིག་གོ།",
    "འདི་ལྟར་བདག་གིས་རྗེས་སུ་ཡི་རང་བར་ནི་བགྱིས་སོ།",
    "ཡང་དགེ་སློང་གིས་གནས་དེ་ལྟ་བུ་ལ་རྗེས་སུ་ཡི་རང་བར་མི་བྱའོ།",
    "ཁྱོད་ཀྱི་ཁྱིམ་ཐབ་དོན་ལེགས་པར་གྲུབ་སྟེ་མཉན་ཡོད་དང་ཉེ་བར་འོངས་ཀྱིས་སྤྲོ་བ་སྐྱེད་ཅིག།",
    "དེས་བུ་མོ་མངག་གཞུག་མ་ལ་དྲིས་པ།",
    "ཁྱིམ་བདག་གི་ཆུང་མ་གར་སོང་།",
    "བུ་མོས་སྨྲས་པ།",
    "བཟང་མོ་ཁྱོད་ཁོ་བོ་འོངས་པས་མི་བདེ་བ་འམ།",
    "རྗེའི་སྲས་བདག་ཁྱོད་བྱོན་པས་མི་བདེ་བ་མ་མཆིས་ཏེ།",
    "བཟང་མོ་དེ་ནི་དེས་ཁྱོད་ཟིལ་གྱིས་མནན་པ་མ་ཡིན་གྱི་ཁོ་བོ་ཟིལ་གྱིས་མནན་པ་ཡིན་གྱིས་ལོངས་ཤིག་ཁོ་བོས་དེ་ལ་མཚམས་གཅད་པར་བྱའོ།",
    "རྗེའི་སྲས་ཁྱོད་བྱོན་པ་ཐོས་ནས་རབ་ཏུ་བྱུང་ངོ།",
    "ཁོ་བོ་དེར་ཡང་སོང་ལ་དེ་ལ་མཚམས་ཆེན་པོ་གཅད་པར་བྱའོ།",
    "དེ་དག་གིས་སྨྲས་པ།",
    "ཁོ་བོ་དེར་ཡང་སོང་ལ་དེ་ལ་མཚམས་ཆེན་པོ་གཅད་པར་བྱའོ་ཞེས་ཟེར་རོ།",
    "འདི་ལྟར་བདག་ཅག་རྒྱལ་པོས་གཞོན་ནུའི་ཡོངས་སུ་སྤང་བ་བྱིན་མོད་ཀྱི་འོན་ཀྱང་བདག་ཉེས་པ་དང་བཅས་པ་ཡིན་པས་གལ་ཏེ་ན་བདག་ལ་འདིར་ཡང་གནོད་པ་བྱེད་པར་འགྱུར་བའི་གནས་ཡོད་ཀྱིས་བྲོས་ཏེ་འགྲོའོ་སྙམ་ནས།",
    "ཁོ་བོ་དེར་ཡང་སོང་ལ་དེ་ལ་མཚམས་ཆེན་པོ་གཅད་པར་བྱའོ་ཞེས་མཆིའོ།",
    "འདི་ལྟར་བདག་ཅག་རྒྱལ་པོས་གཞོན་ནུའི་ཡོངས་སུ་སྤང་བ་སྩལ་མོད་ཀྱི་འོན་ཀྱང་བདག་ནོངས་པ་དང་བཅས་པ་ལགས་པས་གལ་ཏེ་ན་འདིར་ཡང་བདག་ལ་གནོད་པ་བགྱིད་པར་འགྱུར་བའི་གནས་མཆིས་ཀྱིས་བྲོས་ཏེ་མཆིའོ།",
    "བུ་དེ་ན་ཁོ་བོའི་མཛའ་བཤེས་དགེ་སློང་ཞིག་འདུག་གིས་དེ་ལ་སྤྲིང་ཡིག་བསྐུར་གྱིས།",
    "དེ་ཁྱོད་ལ་བྱམས་པས་རྗེས་སུ་སྐྱོང་བར་འགྱུར་རོ།",
    "བདག་གི་ལྷན་ཅིག་གནས་པ་བདག་གིས་ཁྱོད་ཀྱི་གན་དུ་གཏང་སྟེ་འོང་གིས།",
    "ཇི་ལྟར་ཁྱོད་དེའི་ཉེ་གནས་ཡིན་པ་དེ་བཞིན་དུ་ཁོ་བོའི་ཡང་ཡིན་གྱིས་བསླབ་པ་ལ་གུས་པར་གྱིས་ཤིག་དང་།",
