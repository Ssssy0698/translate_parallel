    "བློ་ཕྱོགས་པའི་ངང་ཨ་ཙི།",
    "སྐད་ཅིག་ཉིད་ཀྱི་བློ་ཉེས་དེས་ཀྱང་རང་ཉིད་འཕུང་བའི་གནས་སུ་ལྷུང་།",
    "གཡང་ཤམ་བྱས་ཤིང་གོམ་པ་དལ་བུར་སྤོས་ནས་བཏིང་ནས་ཉལ་འདུག་པའི་སྐབས་དེར་མཐའ་སིལ་སིལ་གྱི་དྲིལ་ཆུང་བར་མེད་དུ་དཀྲོལ་བཞིན་ཡས་པའི་རྩྭ་ཐང་ནི་དབེན་ཞིང་ཁུ་སིམ་མེར་མཆིས་མཆིས།",
    "ཡོངས་སུ་ཁྱབ་འདུག་ཨེ་མ།",
    "ང་རང་བྱམས་པའི་དྲིན་གྱིས་བསྐྱངས་ངོས་ནམ་ཡང་ཁྱེད་ཉིད་སེམས་ཁོང་དུ་བཅངས་པའི་བཤེས་གཉེན་དམ་པ་རྣམས་ཀྱང་འདི་རུ་ཡོད་།",
    "བས་ང་རང་ཅི་བྱ་གཏོལ་མེད་དུ་གྱུར་ནས་མགོ་བོ་རི་རིང་པོ་ཞིག་བརྩིགས་ནས་ལྕགས་རི་རིང་པོ་སྨད་པ་ན་བྱི་ལ་ཐང་ན་ཙོག་པུར་འདུག་པ་མཐོང་དང་ཁུང་བུའི་བར་དུ་ཟམ་པ་ཞིག་འཕངས།",
    "རང་སེམས་རང་ལ་མི་དཀར་བ་དང་རང་བློ་རང་ལ་མི་དྲང་བ་མི་སྲིད་པ་ཡིན་པས།",
    "དཔྱིད་ཟླ་གསུམ་ལ་ཐུག་དུས་ཟས་སྤར་ར་སྣེ་གསུམ་ཐོ་མི་ཐུག་པ་ཡང་གང་མང་མང་ཡོད།",
    "གཡས་གཡོན་དུ་བལྟས་པས་ཟུར་དེ་ན་ཁྱི་མགོ་ཞིག་འདུག་དེའི་སོ་ཞིག་ཕྱུངས་པ་དར་གྱིས་དྲིལ་ཏེ་ཁྱེར་འོངས་ནས་མ་ལ་བྱིན།",
    "ནས་རྒན་བཙོས་ནས་ཆང་བསྙལ་ཏེ་བསྒུག་འདུག་ཟེར་བས།",
    "ནོར་བུའི་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པའི་ལོ་འདབ་མཛེས་པ་དང་རང་བྱུང་བཅུད་དུ་སྨིན་པའི་མེ་ཏོག་འབྲས་བུ་ཕུན་སུམ་ཚོགས་པ་ཕྱོགས་ཀུན་ཏུ་རྒྱས་པས་ཤར་ལྷོ་ནུབ་བྱང་མཚམས་དང་བཅས་པའི་ནམ་མཁའི་དབྱིངས་ཐམས་ཅད་ཁྱབ་པ།",
    "འབངས་ལོ་ཆེན་བེེ་རོ་ཙ་ན།",
    "མདུན་དུ་གང་རང་ལ་སྡང་བར་བྱེད་པའི་དགྲ།",
    "རང་རང་སོ་སོའི་འདོད་པ་ལྟར་བདེ་བ་དང་སྐྱིད་པ་ཁོ་ན་བྱུང་ན་ཅི་མ་རུང་སྙམ་དུ་འབྲེལ་བ་བཞི་ལྡན་གྱི་སྒོ་ནས་ཡང་དང་ཡང་དུ་བསྒོམ་ཞིང་།",
    "གཞན་གནོད་བྱས་པའི་ལས་དེ་དག་ལ་བརྟེན་ནས་ལོངས་སྤྱོད་འགྲུབ་པ་ནི་སུ་ཡང་མི་འདུག་པའི་ཕྱིར་རོ།",
    "དེ་དག་ལ་སྡུག་བསྔལ་ཡོད་སྙམ་པའི་སྣང་བ་ཙམ་ཡང་མི་བྱེད་པར་འདུག་པ་འདི།",
    "ཤི་ཤ་དང་གསོན་ཁྲག་གཉིས་བསྲེས་ནས་སྔར་བསད་པ་དེའི་ནང་ལྟོ་གཡོས་ནས་ཟ་ཕོད་པ་འདི་ལས་ཀྱི་སྲིན་པོ་དངོས་སུ་འདུག་ད་ལེགས་པར་བསམ་ན་དུད་འགྲོ་དེ་དག་རྣམས་ཀྱི་སྡུག་བསྔལ་ལ་བལྟས་ནས།",
    "ཨ་ཙ་ར་མིག་ཕོར་ཁོག་ཙམ་བསྒྲད་པ་ལྔ་གཟིམ་ཁང་དུ་འདུག་པ།",
    "འབྲོམ་སྟོན་པས་པུ་ཏོ་བ་ཁོང་ཅི་མཛད་ཀྱིན་གདའ་གསུངས་པས།",
    "རང་གཞན་གྱི་ཡོ་བྱད་མང་པོས་རྟེན་གསུམ་འབའ་ཞིག་བཞེངས་ཤིང་གདའ་ཞུས་པས་སྔར་བཞིན་གསུངས།",
    "ཁོང་སྒོམ་འབའ་ཞིག་མཛད་ཀྱིན་གདའ་ཞུས་པས།",
    "ཁམས་པ་ལུང་པ་ཁོང་ཅི་མཛད་ཀྱི་གདའ་གསུངས་པས།",
    "དབུ་བཏུམས་ཏེ་བཤུམ་པ་འབའ་ཞིག་མཛད་ཅིང་གདའ་ཞུས་པས།",
    "དེ་བྲམ་ཟེ་སྒྲ་མཁན་རྣམས་ཀྱིས་བརྟགས་པས་མུ་སྟེགས་ངན་པ་རྣམས་ཀྱི་ཀླད་པ་འགེམས་ཞེས་བྱ་བའི་སྒྲར་འདུག་གོ།",
    "དེ་ཡིད་མི་ཆེས་ན་ང་རང་ཕྲག་པར་ཐོགས་ལ་མི་ཐམས་ཅད་ལ་སྟོན་དང་ཤེས་འོང་གསུངས།",
    "ཚོང་འདུས་སུ་ཕྱིན་ནས་མི་ཐམས་ཅད་ལ་ངའི་ཕྲག་པ་ན་ཅི་འདུག་གསུངས་པས།",
    "ཐམས་ཅད་ཀྱིས་ཅི་ཡང་མི་འདུག་ཟེར།",
    "དེ་དག་ཀྱང་རང་ཉིད་ཀྱི་མ་ཡིན་པར་གོམས་ནས་ད་ལྟའི་མ་དང་ཁྱད་མེད་པར་བྱུང་བའི་དུས་སུ།",
    "སྐྱ་བ་འཛིན་པ་གཉིས་ཀ་མི་ཤེས་པར་འདུག་པས།",
    "སྔོན་སྦྲང་པོ་ཞིག་རྒྱ་སྒོའི་འགགས་སུ་ཉལ་ནས་རྒྱལ་པོ་འདི་མགོ་ཆད་ནས་ཤི་སྟེ་ང་རང་རྒྱལ་པོ་བྱས་ན་ཇི་མ་རུང་སྙམ་པ་ཡང་དང་ཡང་དུ་བློ་ལ་སྐྱེས།",
    "དེས་ན་རྟག་ཏུ་གཞན་ལ་ཕན་སེམས་བསམ་པ་བཟང་པོ་ཁོ་ན་ལ་བསླབས་ན་ཚེ་འདིར་ཡང་རང་ཉིད་ཀྱི་བསམ་པའི་དོན་ཐམས་ཅད་ཡིད་བཞིན་དུ་འགྲུབ།",
    "ད་ནི་སེམས་ཁོ་རང་ལམ་ལ་བཞག་ནས་མ་ནོར་མ་འཁྲུལ་བའི་ལམ་བཟང་ལ་བསྒྱུར་རྒྱུ་གལ་ཆེ།",
    "ཁྱེད་རང་ཅི་ལྟར་འདོད་པ་དེ་གཞན་རྣམས་ཀྱང་དེ་ལྟར་འདོད་པ་ཡིན་པས་དེ་དང་སྦྱོར་ཅིག་གསུངས།",
    "གསུངས་པ་འདི་དག་ཟ་ཉལ་འགྲོ་འདུག་སོགས་སྤྱོད་ལམ་ཐམས་ཅད་དུ་ཚིག་བློ་ལ་བྱང་ནས་མཚམས་མཚམས་སུ་བཏོན་ན་སྐྱེ་སླ་བ་ཡིན།",
    "ངེད་གཉིས་ཀས་དྲངས་ཀྱང་མི་འདྲོང་བར་སྡུག་བསྔལ་བར་མཚུངས་པར་འདུག་པ་ལ།",
    "དེ་ཡང་རང་སྟོབས་རྙེད་ནས་ཇེ་བརྟན་དུ་འགྲོ་ཞིང་ས་ཐོབ་ཕན་ཆད་སེམས་བསྐྱེད་པ་དེ་ཚེ་རབས་ཐམས་ཅད་དུ་ཉམས་པ་མེད་པར་མངོན་དུ་འགྱུར་རོ།",
    "བུ་ཁོང་སླར་འོང་ནས་ཡང་མ་ལ་ངའི་རིགས་དེ་མ་ཡིན་པར་འདུག་རིགས་དངོས་གང་ཡིན་དྲིས་པས།",
    "ང་རང་ནོར་བུ་ལོན་པའི་རིགས་ཡིན་པར་འདུག་པས།",
    "མི་ནག་པོ་མིག་དམར་ལྗིག་གེ་བ་ལག་ན་ལྕགས་ཀྱི་དབྱུག་པ་རིང་པོ་ཐོགས་པ་ཞིག་འདུག་པ་ལ་མཁར་འདིའི་ནང་ན་ཅི་ཡོད་པ་ཡིན་དྲིས་པས།",
    "ཉེས་པ་བྱུང་ཟེར་བ་དེ་འདི་ཡིན་པར་འདུག་དགོངས་བཞིན་མཁར་དེའི་ནང་དུ་ཕྱིན་པས།",
    "ཟེར་བ་ཞིག་འདུག་པས།",
    "བྱ་བ་གཅིག་གདའ།",
    "ད་དུང་ཡང་རྒྱལ་པོ་དྲན་པ་མ་ཉམས་པར་འདུག་པས།",
    "གཞན་དོན་བྱེད་པའི་དུས་རང་དོན་གྱི་འཁྲི་བ་ཟད་ཙ་ན་ཡིན།",
    "སོར་ཐར་གྱི་སྲུང་སྡོམ་དག་པ་གཅིག་པུས་གར་ཡང་མི་ཕྱིན་པར་འདུག་གསུངས།",
    "དེ་ལྟ་བུ་ཞིག་མ་འགྲུབ་བར་འདུག་ཐབས་མི་འདུག་སྙམ་པ་དང་།",
    "རང་རང་ནས་ཀྱང་ང་དེ་དང་དེ་ལྟ་བུ་ཡིན་པས་གང་ཡང་མི་དགོས་སྙམ་པ་འདུག་སྟེ།",
    "རང་ལ་ཡང་འོ་བརྒྱལ་བར་འདུག་པས་ངེད་འཁོར་རྣམས་ཀྱིས་བྱེད་པར་ཞུ་ཞུས་པས།",
    "ནོར་མེད་ཙ་ན་དགྲ་དང་བྲལ།",
    "གཉེན་པོའི་མཆོག་གང་ཡང་རང་བཞིན་མེད་པར་ཤེས་པ་ཡིན།",
    "ཁྱེད་ལྟ་བུའི་མཁས་པ་བོད་ན་བཞུགས་བཞིན་དུ་ཁོ་བོ་བོད་དུ་འོང་མི་དགོས་པར་འདུག་གསུངས།",
    "ང་བོད་དུ་འོང་དགོས་པར་འདུག་གསུངས།",
    "ཕྱིན་དྲུག་ལམ་ལ་བསླབས་ཀྱང་རང་འདོད་བཅས།",
    "ལས་ཀྱི་སྒྲིབ་པ་ལའང་རང་བཞིན་དང་བཅས་པའི་ཁ་ན་མ་ཐོ་བ་གཉིས་ཡོད།",
    "གཞན་མའི་ལུགས་ལ་ཧ་ཱུྃ་ཡིག་དེ་ལས་འོད་ཟེར་སྤྲོ་བསྡུས་དོན་གཉིས་བྱས་པ་སོགས་ཡོད་ཀྱང་རང་ལུགས་ལ་མེད།",
    "གཞན་རྩ་བའི་དམ་ཚིག་ཉམས་པ་དག་དང་གཏམ་བསྲེ་ཞིང་འདྲེས་པ་དང་འགྲོ་འདུག་སོགས་སྤྱོད་ལམ་གྱིས་འབྲེལ་བ།",
    "གཞན་དུ་གསར་རྙིང་གང་ལ་ཡང་རང་རང་སོ་སོའི་ལུགས་ཀྱི་མཎྜལ་འབུལ་ཐབས་དུ་མ་ཡོད་ཅིང་།",
    "ཁོ་བོས་དངོས་གྲུབ་སྦྱིན་མི་ནུས་པར་འདུག་ཟེར།",
    "བོད་པྲེ་ཏ་པུ་རིའི་རྒྱལ་ཁམས་དངོས་སུ་འདུག་བོད་ཡུལ་ན་ཞིང་དག་པ་ཞིག་ལ་ནས་བྲེ་གང་སྦྱིན་པར་བཏང་བའི་སྦྱིན་འབྲས་ལ་ལོངས་སྤྱོད་མཁན་མི་འདུག་ཅེས་གསུངས།",
    "གང་ལགས་ཞུས་པས་ནོར་སྒྲུབ་བྱས་ཀྱང་རང་ལ་སྔོན་གྱི་སྦྱིན་འབྲས་མེད་ན་འོང་བ་ཡང་དཀའ་ཞིང་།",
    "རྣལ་འབྱོར་པས་གཅོད་སྐོར་རྒྱ་ཆེན་པོ་ཤེས་ན་ཡོན་ཏན་དཔག་ཏུ་མེད་པ་ཡོད་ལ་ཅུང་ཟད་ཙམ་ཤེས་པས་ཀྱང་རང་གཞན་ལ་ཕན་ཐོགས་པ་ཡིན་ནོ།",
    "ཟག་མེད་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་འདོད་རྒྱུ་ཡིད་བཞིན་གྱི་སྤྲིན་འཕྲོ་བའི་རོལ་པ་དང་རང་བཞིན་དུ་གྱུར་པར་བསམ།",
    "ཡང་རང་ཉིད་དམིགས་པ་ལ་གོམས་པོ་མེད་ན།",
    "དེ་དག་ཐམས་ཅད་ལ་རང་རང་གང་ལ་གང་འདོད།",
    "གཅོད་པ་ཙམ་པོ་དེས་ལྷ་འདྲེ་འདུལ་ཐུབ་བར་རློམ་པ་འདུག་ཀྱང་།",
    "དེ་ཙ་ན་ལྷ་འདྲེ་དང་ཡི་དྭགས་རྣམ་ཀྱིས་ཀྱང་དེའི་རྒྱུས་ལོན་ཏེ།",
    "འདི་ནང་ནས་ཆོད་ན་ཕྱིའི་བདུད་ཐམས་ཅད་མ་བཅད་ཀྱང་རང་ཤུགས་ཀྱིས་ཆོད་པར་འགྱུར་བ་ཡིན།",
    "གཞན་ངན་རུང་བདག་ལ་མི་གནོད་པས་ཁ་ཕྱིར་འཁོར་ནས་བདག་བསྟོད་གཞན་སྨོད་ཀྱི་བདུད་ལས་བརྩམ་མི་འདུག་པར།",
    "དེ་ཡང་རང་འབུལ་བའི་ནུས་པ་ཡོད་ན།",
    "ངེད་རྣམས་ལུས་ངན་འདི་ལྟ་བུ་བླངས་པས་ངོ་ཚ་ནས་འོང་མི་ཕོད་པར་འདུག་ཟེར།",
    "རྗེས་ཐོབ་ཟ་ཉལ་འགྲོ་འདུག་ལ་སོགས་པ་དག་པའི་སྣང་བ་འབའ་ཞིག་ལམ་དུ་ཁྱེར་དགོས།",
    "ཏ་ཐཱ་ག་ཏ་ཤྲཱི་བེེ་རོ་ཙ་ན་སྟེ་དེ་བཞིན་གཤེགས་པ་རྣམ་པར་སྣང་མཛད་དེ་ཉིད།",
    "ནངས་པར་རྟོགས་པ་སྐྱེས་ཏེ་མཚོ་ཀུ་ཏྲའི་འགྲམ་དུ་ཁྲུས་བྱས་ནས་འདུག་པ་ལ།",
    "ལོ་ཆེན་བེེ་རོ་ཙ་ན་རྣམས་ཀྱིས་ཞུས་པ་སྟེ།",
    "འོན་ཀྱང་རང་དོན་ཡིད་བྱེད་ཀྱིས་འཚང་རྒྱ་མི་ཐུབ་ཅིང་།",
    "དང་པོ་ཀ་ཁ་ག་ང་ནས་བརྩམས་ཏེ་ཡི་གེའི་ཀློག་སྦྱང་ཚུན་ཆད་ཕལ་པའི་གང་ཟག་རྣམས་དང་ཁྱད་མེད་དུ་སློབ་དགོས་ཀྱིན་འདུག་པས།",
    "གང་ལྟར་ཡང་གཞན་རྣམས་དང་ཅུང་ཟད་མི་འདྲ་ཙམ་འདུག་པས།",
    "དེས་ན་གཞན་ཤི་བོ་དང་འཆི་ཀ་མ་ལ་གདབ་པ་དང་རང་ཉིད་འཆི་བའི་ཚེ་ལས་ལ་སྦྱར་བའི་དུས་འདི་མི་དགོས།",
    "སྐྱོན་མཚང་དེ་དག་རང་ལ་ཡོད་དམ་མེད་ལེགས་པར་བརྟགཡོད་པར་འདུག་ན་སྐྱོན་ངོས་བཟུང་།",
    "ནང་རང་ལུས་བཙོག་པ།",
    "སང་ཉིན་ནས་རང་རང་ཁ་ཁ་སོ་སོའི་ཕ་ཡུལ་ཕྱོགས་བཞི་མཚམས་བརྒྱད་ལ་ཕེབས་རན་པས།",
    "དབེན་ཞིང་ཡིད་འོངས་བྲག་རིའི་དྲུང་འདུག་སྟེ།",
    "སྒོ་གོང་ན་གཡུའི་ལྷམ་ཆུང་ཞིག་བཏགས་འདུག་པའི་འོག་ལ་ཕྱིན་པས་བྱིས་པ་དམུས་ལོང་ཞིག་འདུག་པ་དེའི་མིག་ཕྱེས་ནས་ལོག་གོ་ཞེས་སྨྲས་པས།",
    "ཡབ་མེས་ཀྱི་ཐུགས་དམ་གཉན་པོ་གསང་བ་དེར་ཅི་འདུག་ཀློག་དང་གསུངས་པས།",
    "ཙནྡན་གྱི་སྡོང་པོ་འོད་ཟེར་འཕྲོ་བ་ཞིག་ལ་བསྐོར་བ་བྱེད་ཅིང་འོ་མ་གཏོར་བས་ལོ་མ་རྣམས་ཀྱང་འོ་མའི་དྲེག་པས་ཁེབས་ཏེ་འདུག་པ་ངོ་མཚར་དུ་བཟུང་།",
    "འོན་ཀྱང་ཐག་རིང་པོ་ནས་འོངས་ཏེ་འདུག་པས།",
    "བོད་ཀྱི་རྒྱལ་པོ་དེ་དད་པ་ཅན་ཞིག་ཡོད་པར་འདུག་ཀྱང་མཆོད་གནས་ཀྱི་རྟེན་མེད་ཟེར་བས།",
    "རྒྱལ་པོ་འདི་གཟུགས་དང་ཡོན་ཏན་རྨད་དུ་བྱུང་བ་ཞིག་འདུག་ཀྱང་།",
    "གཡུའི་སྦྲང་བུ་དང་མཚལ་གྱི་གཡུང་དྲུང་ཡང་གདའ་སྐད།",
    "ང་ཞག་བདུན་ན་འཆི་བར་འདུག་ཤི་བ་བཟོད་དེ་ཤུལ་དུ་རྒྱ་ཡུལ་ཕུང་བ་འདི་མ་ལེགས་བྱས་པས།",
    "ཁྱེད་རང་རིག་པ་ཅན་ཡིན་པས་ཐབས་ཅི་ཡོད་ཟེར་བ་ལ།",
    "རྒྱལ་པོའི་ཞལ་ནས་ལྷ་གཅིག་དེ་སྒྲོལ་མའི་སྤྲུལ་པ་ཡིན་པར་འདུག་པས་འཕྲུལ་ཆེ་བས་ན་གང་ནས་འོང་མི་ཤེས་ཀྱིས་ཕྱོགས་བཞི་གར་བསུ་བའི་དྲིལ་སྒྲོགས་ཤིག་ཅེས་གསུངས།",
    "ཁྱེད་ལ་ལྷ་འདུག་སྟེ་ང་ལ་ཡང་རྟེན་ངོ་མཚར་ཅན་གསུམ་། ཡོད་ང་ཆེན་མ་ཡང་ཡིན།",
    "ས་དགྲ་བརྒྱད་འདུག་སྟེ།",
    "ཡོན་ཏན་གྱི་རི་བཞི་འདུག་པས་ཕྱོགས་ཐམས་ཅད་ནས་དད་པ་ཅན་གྱི་སྐྱེ་བོ་འདུ་ཞིང་།",
    "ནམ་ལངས་པའི་ཚེ་དབུ་སྔས་ན་རྒྱུ་དེ་རྣམས་ཀྱི་ཤུལ་ན་བཅུ་གཅིག་ཞལ་ཡིད་བཞིན་ནོར་བུ་རྩ་ཕྱག་བརྒྱད་དང་ཞལ་བཅུ་གཅིག་ཏུ་ཀྲོང་ངེར་བྱོན་ནས་འདུག་གོ།",
    "བདག་ནི་ལྷ་། བཞེངས་དགོས་སྙམ་ནས་གདོད་མཆིས་པ་ལགས་ཏེ་འདི་ནི་རང་བྱུང་དུ་བྱོན་པར་གདའོ་ཟེར་སྐད།",
    "ན་བུན་འཁྲིགས་པ་སངས་ནས་བློན་འབངས་རྣམས་བརྩིག་ཏུ་ཕྱིན་པ་ན་རྩིག་པ་ཟིན་ནོས་འདུག་རྒྱལ་པོའི་ཞལ་ནས།",
    "བྱེ་མའི་གླིང་ན་། ལྷ་རྣམས་ཀྱི་ཞབས་རྗེས་ལ་པདྨ་དམར་ལམ་ལམ་དུ་འདུག་པ།",
    "ར་སའི་གཙང་ཁང་བྱང་མ་ན་ཐུགས་རྗེ་ཆེན་པོ་གཙོ་འཁོར་དགུ་པོ་གདན་ཁྲི་མེད་པར་གྲལ་བྱས་ཏེ་བཞེངས་ནས་འདུག་པ་ལ།",
    "ལྷོ་ངོས་ཀྱི་ལོགས་ལ་ཁ་སརྤཱ་ཎི་འཇིགས་པ་བརྒྱད་སྐྱོབ་ཀྱི་གླིང་དང་གང་ལ་གང་འདུལ་དེ་ལ་དེར་སྟོན་གྱི་གླིང་གཉིས་ཁ་དོག་རྫོགས་པར་བྲིས་པ་ལས་ལྷག་པར་རང་བྱུང་དུ་བྱོན་ནས་འདུག་པས་ཐམས་ཅད་ངོ་མཚར་སྐྱེས་ཏེ་ཕྱག་མཆོད་བྱས།",
    "རྒྱལ་པོ་ལ་མ་དད་དེ་འཕགས་པ་སྤྱན་རས་ག་ལ་ཡིན་བདུད་དུ་འདུག་པ་ཟེར་ནས་ལོག་སྟེ་མགོའི་ར་བ་ལ་དབུ་རར་མིང་ཐོགས།",
    "པིར་འདྲའི་དུས་སུ་གྱུར་ཙ་ན།",
    "མགོ་བོ་ནང་དུ་བཅུག་ནས་འདུག་པའི་ཚེ།",
    "བློན་པོ་བཅུ་དྲུག་པོས་ཀྱང་ཡོ་བྱད་དང་བཅས་ཏེ་ར་སའི་གཙུག་ལག་ཁང་དུ་སླེབས་ནས་ཕྱག་བྱེད་པར་ཕྱིན་ཙ་ན།",
    "ལྷ་འཕྲུལ་གྱི་ཞལ་སྔ་ནས་མཐའ་བཞི་ཕྱོགས་བརྒྱད་དུ་བཀའ་བཙན་ཆབ་སྲིད་ཆེ་སྟེ་ཤར་ཕྱོགས། ། རྒྱལ་པོ་ཆེན་པོ་རྒྱ་འདུག་པ་དང་།",
    "ལྷོ་ཕྱོགས་ཀྱི་རྒྱལ་པོ་ཆེན་པོ་རྒྱ་གར་དུ་འདུག་པ་ཡང་།",
    "ཆུང་ངོས་ལ་མཐོ་དོ་འདུག་གོ།",
    "བྱད་མི་མཚར་བ་འདུག་པས་བྲམ་ཟེ་ཡིན་ནམ་ཞེས་གླེང་།",
    "ད་ནི་བུ་འདིས་ཀྱང་བདག་ལ་ཕན་མི་ཐོགས་པར་འདུག་པས་བོད་ཡུལ་ཕུང་བའི་ཐབས་བྱའོ་སྙམ་ནས།",
    "དེ་ཙ་ན་འདི་སྙན་དུ་གསོལ་ཅིག་དང་དེས་རྒྱལ་བུ་དད་པ་སྐྱེའོ།",
    "བྲག་དམར་མགྲིན་བཟང་བཤིག་འདུག་པ་མཐོང་བས་སང་ཤིས་རྒྱའི་གླེགས་བམ་རྣམས་མཆིམས་ཕུའི་རྫ་ལ་སྦས།",
    "སློབ་དཔོན་ཆེན་པོ་ཤིན་ཏུ་མཉེས་ཏེ་གསུངས་པ་བོད་ཀྱི་དད་པ་ལ་གཡོ་ཟོལ་ཨེ་འདུག་བལྟས་པ་ཡིན་གྱི་གསེར་གྱིས་ཅི་བྱེད།",
    "ཐང་ལྷ་ལ་ཐུགས་ཆེར་ཁྲོས་ཏེ་མཐུ་རྩལ་ཅན་ཅིག་འདུག་པ་གསུངས་ནས།",
    "ཤམ་པོ་ཁོ་རང་གངས་ཞུ་བའི་རྩེ་ལ་བསྡད་ནས།",
    "ལྷ་ཁང་བྲེ་ཙམ་པ་ཞིག་བརྩིག་པ་དེ་ལས་འོས་པ་ཅང་གདའམ་ཟེར་བ་ལ།",
    "མནལ་ལམ་དུ་བྱུང་བ་དང་མཐུན་པར་བྲག་ལ་འོལ་སྤྱི་ཙམ་གདའ་བས།",
    "གཉིད་སད་ཙ་ན་མི་བཞི་ནི་མི་གདའ་ལ།",
    "ཡ་ལད་ནི་འདི་ཡིན་ཟེར་ནས་གསེར་ཁྲབ་གཅིག་གདའ་ཞེས་གསོལ་བས།",
    "མཁས་པ་བེ་རོ་ཙ་ན་ཡིས།",
    "ངས་དེ་རིང་ཤར་སྒོར་ཕྱིན་པས་མི་ཀུན་མཐུན་པར་རྗེས་འབངས་བསད་ན་འབངས་ཀྱིས་ལང་བ་མི་ཡོང་ཟེར་གྱིན་འདུག་བྱས་པས་རྗེ་འདར།",
    "ངས་ཞལ་ལྕེ་མི་ཆོད་པར་འདུག་གོ།",
    "ཕྱོགས་ཀྱི་དགྲ་ཐམས་ཅད་ཐུལ་བར་འདུག་ཟེར་སྐད།",
    "པ་གོར་ཧེ་འདོད་ཀྱི་བུ་བེ་རོ་ཙ་ན་དང་།",
    "པ་གོར་བེ་རོ་ཙ་ན།",
    "གཞན་ཡང་ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ན་དང་།",
    "བེ་རོ་ཙ་ན་ཚ་བ་རོང་དང་།",
    "བོད་ཀྱི་པཎྜི་ཏ་བི་རོ་ཙ་ན་གང་དུ་མཆིས་གསུངས་པས།",
    "ངེད་ཅག་བློན་པོ་ཀུན་རང་རང་སོ་སོར་བྱེར་ནས་འགྲོ།",
    "ཡང་རྒྱལ་བློན་འཛོམ་པ་དཔའ་བརྗིད་ཆེ་དགོངས་པ་གདའ་ན།",
    "མས་ཀྱི་སྒོ་འགག་ཏུ་ཨ་རྫི་བ་ཁྲོ་བོ་གཉིས་འདུག་པ་འདི་ཅི་ཡིན།",
    "ཡང་ལྤགས་པ་ལ་ལའི་། སྟེང་དུ་ཤ་ཐམས་ཅད་སྤུངས་ནས་བོན་ཆོག་གྱེར་འདུག་པ་ན།",
    "རྒྱ་གར་ཀླ་ཀློའི་མི་རིགས་ཀྱི་གྲིབ་བོན་ལྷ་གཡུང་དྲུང་རྣམས་ལ་ཕོག་འདུག་པས།",
    "ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ན་དང་ཐང་ནག་གཉིས་རྩོད།",
    "འཛམ་བུ་གླིང་ཐམས་ཅད་བོད་གྱི་རྒྱལ་པོས་མངའ་འོག་ཏུ་བསྡུས་ནས་གེ་སར་གྱི་ཡུལ་འཇོམས་སུ་འོང་བར་འདུག་ཅེས་ཐོས་ནས།",
    "ཞེས་གསུངས་ཤིང་ཟིལ་པ་ཕྲོམ་ཕྲོམ་དུ་འདུག་པ་ན།",
    "བེ་རོ་ཙ་ནས་མཛད་པ་དོན་གསལ་སྒྲོན་མེ།",
    "བེ་རོ་ཙ་ན་ལ་སོགས་པ་དགེ་སློང་ཉུང་ཤས་ཞིག་ལས་མ་བྱུང་།",
    "རིག་པ་བླུན་ཞིང་རང་ག་བ་མང་ལ།",
    "ཤར་ཕྱོགས་ན་རྒྱུ་འདུག་པ།",
    "བྱང་ཕྱོགས་ལ་བོད་ཀྱི་བློན་པོའི་མིང་རྣམས་འདུག་གོ།",
    "ཡང་ལོང་བས་ས་ལ་མནམ་ནས་འདི་ན་འདུག་ཟེར་བ་ལ་ལོང་ཁྲིད་ཀྱི་བལྟས་པས་སེར་ཀ་ལས་དུ་བ་བྱུང་རྗེས་མཐོང་།",
    "འདིརྫུ་འཕྲུལ་དང་ལྡན་པ་ཞིག་འདུག་། པས་ཡེར་པའི་ལྷ་ལུང་དཔལ་རྡོར་ཡིན་ངེས་ཟེར་ནས་བལྟ་བར་བཏང་བས།",
    "ནག་ཅན་གྱི་མི་འདི་ན་འདུག་སྟེ",
    "མདང་སྐྱེས་ཀྱི་བུ་ཆུང་ལ་སོ་ནི་གདའ།",
    "འཁོར་ལོ་ལྡེ་ཡིན་ཅེས་མངའ་རིས་གུང་ཐང་དུ་དཔེ་ཧྲུལ་ཀ་ཎི་ཀ་རྙིང་པར་བརྫངས་པ་ཞིག་ཏུ་འདུག་པ་འཐད་ངེས་སུ་སྣང་།",
    "འདི་རྒྱ་མཚོ་བགྲང་ཚུལ་བཅུ་ཚོ་བརྒྱ་ལ་གཅིག་ཏུ་བྱས་པ་སྟོང་ཕྲག་ལ་། བཞག་པ་ཡིན་འདུག་གོ།",
    "གཞན་ཡང་རྡོ་རྗེ་། དྲིལ་བུ་ནམ་མཁར་འཇོག་ཅིང་རང་སྒྲ་འཁྲོལ་བ།",
    "ནངས་པར་མནལ་སད་ཙ་ན་མངོན་མཛོད་ཀྱི་ཚིག་། དོན་མ་ལུས་པ་ཐུགས་ལ་འཁྲུངས།",
    "རྫུའཕྲུལ་དང་རྟོགས་པ་རྟོགས་ལྡན་རྒྱ་བོ་འདི་མཐོ་བར་འདུག་པ་ཞེས་གསུངས་པས།",
    "དྭགས་པོ་སོགས་སུ་དཔུང་ཁྱེར་བྱས་པའི་ས་མཚམས་ཀྱི་བྲག་ལ་ཨང་ལེན་གྱི་མིང་བྲིས་འདུག་ཟེར་བ་སོགས་དཔོན་ཆེན་ཞིག་ལ་དྲག་ཤུལ་འདི་ཉིད་ཆེ།",
    "ཉིད་ཀྱི་གསུང་འདི་ལྟར་ན་ངེད་ཀྱིས་སྔར་བརྩམས་པའི་རིགས་ལའང་བཅོས་བྱེད་དགོས་པར་འདུག་གསུངས་སྐད།",
    "སྐབས་ཤིག་དུས་བཞི་གཅིག་ཅར་བ་དང་རིམ་གྱིས་པའི་སྐོར་ལ་བགྲོ་གླེང་མཛད་པའི་ཚེ།",
    "རྗེ་འབངས་མཐའ་དག་རིགས་རུས་འཆོལ་བར་མི་སྤྱོད་པས་ཁུངས་། དང་ཡིག་ཚང་ལ་ནན་ཏན་དུ་བྱེད་པའི་སྲོལ་ཡོད་འདུག་ཀྱང་།",
    "ཅེས་པའི་ཚུལ་ལྟ་བུར་འགྲོ་བར་གདའ་ནའང་།",
    "མ་བྱུང་ན་བཞི་ཐོག་པའི་དྲུང་འཁོར་ལས་ཚན་ཞིག་ཞུས་འདུག་པ་ལྟར་དམ་གཉེར་ལ་བསྐོས།",
    "བདག་ཆེན་ཐུགས་གཏུམ་པས་གསོལ་གཟིམས་དམ་གཉེར་སོགས་ལ་བཀའ་བསྐྱོན་འཕྲལ་འཕྲལ་ཡོང་བ་ཞིག་འདུག་པས།",
    "ཉིན་གཅིག་ཨ་ཏུ་ལས་སི་ཏུ་རྟ་རར་ཁྲིད་ནས་རྟ་བྲེས་ཀྱི་ཁ་ཤིང་གོག་ལ་ཁད་གཅིག་འདུག་པ་དེ་བསྟན་ནས།",
    "ངེད་ཀྱི་པགས་པ་དམར་བཤུས་བྱེད་ཀྱི་འདུག་ཟེར་བ་བྱུང་ཡང་སྣེའུ་གདོང་ཁོག་ཡ་མ་གཏོད་སོགས་ཀྱི་བསླབ་སྟོན་རྣམས་མཛད།",
    "བཤལ་གཏར་གཉེན་པོས་ཚད་གཉའ་ཆག་དུས་སུ།",
    "སྣོད་ཀ་རུ་ཐུང་བྱིན་གཞུག་རང་རང་བུག་ཧར།",
    "གཉིད་ལོག་དུས་ན་ཟ་ཟི་བླ་འཆོལ་འདར།",
    "ཉལ་འདུག་པའི་དུས་ན་ཆུ་ནི་མར་ནག་འདྲ་ཞིང་།",
    "མིག་དམར་བུ་ནི་འཕྲལ་དུ་ན་བ་མི་ཚོར་བར་ན་རྒྱུ་གང་ཡང་མི་འདུག་སྙམ་ཡང་གཉིད་མེད་མཆིན་རྒྱས་གདོང་སྣུམ་སྣ་ཁྲག་འཛག།",
    "ཕྲན་ཚེགས་འགྲངས་ངོམས་འདུག་རྗེས་དྲག་ཤུལ་རྔུབས་དཀའ་བའོ།",
    "ཕྲན་ཚེགས་ནི་འགྲངས་ཤིང་ངོམས་པར་འདུག་པའི་རྗེས་ན་འཆི།",
    "ཡན་ལག་བཤལ་ལྗིད་ཚོར་བྲལ་ཉིང་འདུག་ལ་སོགས་དཀའ་བ་ཡི།",
    "སྟོབས་ལྡན་འཆི་ལ་འབྲིང་ནི་བཅོས་འདུག་ལ་སོགས་པ་དཀའ་བའི།",
    "དང་འབྱར་དང་གསེབ་ན་འདུག་པ་དང་།",
    "སྐྱ་སྨུག་གསེབ་ན་འདུག་པ་དང་།",
    "འདུག་སར་འཆི་བདག་ལག་ཏུ་འགྲོ།",
    "ཚབས་ཆེ་ཁྲག་ཏུ་འཁྲུ་སྐྱུག་ཕོག་དུས་འཆི།",
    "བསམ་སེར་ཕོག་ན་ལུས་སྦྲིད་གན་རྐྱལ་ཞག་གཅིག་དུས་ན་འཆི།",
    "རྩ་རྣམས་རང་རང་རྟགས་དང་ཁྱད་དེ་བཞིན་ཕོག་ས་གཉན་དང་མི་གཉན་དང་།",
    "ཚབས་ཆེ་བ་ཁྲག་ཏུ་འཁྲུ་སྐྱུག་བྱེད་ཅིང་ཕོག་དུས་སུ་རྟགས་སུ་གླང་ཐབས་བཞིན་ལྡང་ལ་དྲི་ཆུ་མི་འོང་སྡོམ་པ་དང་།",
    "མེ་ཉི་བསིལ་གྲིབ་སྙེག་ཅིང་འདུག་མི་ལྟར་འདུག་ཀྱང་འཁར་བའི་སྣོད།",
    "རྩ་ནི་སྦྱར་དུག་དུས་དང་མཚུངས་པ་ལ།",
    "ཐེམ་འབྲུ་དྲུང་ཞེས་གྲགས་པ་དེ་ཡིན་པས་དེ་ཡི་རྟགས་ནི་རྩ་ནི་སྦྱར་དུག་དུས་དང་མཚུངས་པ་སྟེ་འགྱུར་ལྡོག་མང་ལ་གདོན་རྩ་དང་འདྲ་ལ།",
    "ཁྲག་མེད་སྦུ་གུར་འདུག་པ་དང་།",
    "ལྡང་རངས་ཀྱི་དུས་སུ་རྒྱ་བོས་ཟིན་པ་བཅོས་སླ་ཞིང་།",
    "དཔའ་བོའི་འདུག་སྟངས་ཀྱིས་གནས་པའོ།",
    "དེ་ལྟ་བུའི་གནས་སུ་སྟན་བདེ་བ་ལ་འདུག་ས།",
    "དྲོ་ནས་སྟན་བདེ་བ་ལ་འདུག་ལ།",
    "དེ་ནས་རང་ཉིད་སྟན་བདེ་བ་ལ་འདུགནས།",
    "གང་དུ་ཡང་དག་དུས་ཀྱི་བདག།",
    "རང་བྱུང་རང་གསལ་མ་འགགས་ཤར།",
    "མཐའ་མར་འདུག་སྟངས་ཞིབ་འབྲི་བྱས་པ་ཡིན།",
    "ལག་པ་གཉིས་ཀྱང་འདར་བཞིན་འདུག་ཁོང་དངོས་གནས་ཐུགས་ཁྲོས་པར་ངེས།",
    "མཚན་བརྡ་སྒྲོག་མཁན་གྱིས་ཁོ་རང་མཆན་དུ་བཙིར་ནས་ཤིང་ཁང་དུ་ཕྱིན་པ་ལ།",
    "ཐོག་མཐའ་བར་གསུམ་དུ་མི་དེ་ངོ་མ་བཟང་བོ་འདུག་མི་དེ་ཧ་ཅང་བཟང་།",
    "རང་ཉིད་ཀྱི་བྱིས་པ་ལྔ་བོ་དེས་ཁོ་ལ་དཀའ་ལས་མི་ཉུང་བ་ཞིག་བཟོ་བཞིན་ཡོད་ཁོ་རང་སླེབས་ཟིན་པ་ཡིན་ནམ།",
    "སྐབས་དེར་སང་ནཱ་དངངས་སྐྲག་དང་བཅས་ཏེ་འདུག་སྟེགས་ལས་ཡར་ལངས་བྱུང་།",
    "ཁོ་རང་ཉིད་ལ་བསམ་བློ་གཏོང་བ་ཉུང་ཞིང་གཞན་ལ་བསམ་བློ་མང་དུ་གཏོང་བ་ཞིག་གོ་ཞེས་པ་ལྟ་བུའོ།",
    "མིའི་གཟུགས་བརྙན་ཚང་མ་མཉམ་འདྲེས་སུ་ཤར་འདུག་ཅིང་།",
    "ཅེས་བྲིས་འདུག་རིམ་པ་འདིར་རང་བྱུང་ཚན་པ་གསུམ་ཡོད་དེ།",
    "དོན་དངོས་སྟེང་མི་སྣའི་ཤེས་རྟོགས་ཆུ་ཚད་དང་རང་གཤིས།",
    "ང་རང་ཀླད་ངོས་དཀར་པོ་ཅན་གྱི་གྲུ་གཟིངས་ལ་བསྡད་པ་ན།",
    "ང་རང་ཕ་ཡུལ་གྱི་དབྱང་མའི་མེ་ཏོག་ལ་དགའ་ཞེས་པ་ལས་ང་ཡི་ཕ་ཡུལ་ནི་འབྲི་ཆུའི་ལྷོ་རྒྱུད་ན་ཡོད།",
    "ང་རང་སྐབས་སུ་ཞེས་པར་མཚོན་ན།",
    "ང་རང་ལ་ཕམ་ཉེས་བྱུང་བ་དང་མཚན་སྙན་ཐོབ་པའི་སྐབས་སུ་ཞེས་པ་དང་ཡང་ན་ང་རང་ལ་མཚན་སྙན་ཐོབ་པའི་སྐབས་སུ་ཞེས་པ་དང་བསྡུར་ན་ཅུང་འབྲི་དཀའ་བ་ལྟ་བུ།",
