    "དྲང་སྲོང་གི་དམོད་རིང་བརྗོད་ནས་ཀྱང་ཐལ་མོ་རྡེབ་བོ།",
    "ཐུན་ཐག་ཕྱིར་དྲངས་པའི་སྣེ་མོ་རང་གིས་བཟུང་གཡས་གཡོན་དུ་སྒྲོ་བཙུགས།",
    "འཕུང་རེའི་གུར་ཕུབ་སྟེ་ནང་དུ་མར་མེའི་མདངས་མི་འཕོག་པ་དང་ལིངྒ་ལ་བདུད་རྩི་མི་འཐོར་བ་གལ་ཆེ།",
    "ཐུན་སོ་སོའི་འགོར་ལས་བྱང་ཟོར་སྒྲུབ་སོགས་འཛབ་ལ་ཐུག་གི་བར་ཐུན་མོང་བ་ཇི་ལྟ་བ་ལ་གསེར་སྐྱེམས་ནས་བཟུང་དགུག་ཐུན་ཐལ་དེབ་ཀྱི་བར་རྒྱས་བསྡུས་ཇི་ལྟར་རིགས་པ་བྱ།",
    "རང་ཉིད་ཞེ་སྡང་རྡོ་རྗེར་གསལ་བ་ཡི་ཞེས་སོགས་བཟློག་པའི་དམིགས་པ་ཐུན་མོང་བའི་དུས་ལྟར་ལ་དེའི་མཇུག་ཏུ།",
    "རྡོ་རྗེའི་ལྟེ་བའི་ཧཱུཾ་གིས་བསྐུལ་བ་ཡིས།",
    "རྩེ་མོའི་ཕཊ་ལས་ཛ་དང་འོད་ཟེར་འཕྲོས།",
    "དགྲ་བགེགས་ཐལ་བར་གནོད་བྱེད་ལྡེབརྒྱད་གང་ཡིན་ཞིན་ལ་ལ་སྦྱོར་བྱེད་ན་སྔགས་དང་དམིགས་པའི་ཁ་སྒྱུར་བྱེད་ཤེས་དགོས་སོ།",
    "རང་ཉིད་ཞེ་སྡང་རྡོ་རྗེ་གསལ་བ་ནས་བཟུང་དམོད་རིང་གི་ཐལ་བརྡབ་པར་བྱ།",
    "རྡེབ་ཀྱི་བར་གོང་ལྟར་བྱ་ཞིང་ཐུན་གཏོར་གསར་བ་བཤམས་ནས་ཐུན་མཚམས་ལ་ཟོར་ཞོར་སྒྲུབ་བྱེད་པའི་བར་ཐུན་མོང་བ་དང་འདྲ་ལ་སྒྲུབ་པའི་དམ་ཚིག་རྣམས་ཀྱང་ཆ་མཚུངས།",
    "མངོན་སྤྱོད་ཀྱི་སྐབས་འདིར་ཐུན་ཐོག་མ་ཡན་པ་དང་ལྷ་དབྱེའི་སྒྲོམ་བུ་རེ་དཀར་པོ་ལ་མ་རེག་པ་གལ་ཆེ།",
    "ཕ་རོལ་ལྷས་སྟོབ་ཚེ་ན་དབྱེ་བའི་མན་ངག་ཟབ་མོ་བྱ།",
    "དེ་ལྟར་བཟློག་རྟགས་མ་བྱུང་གི་བར་ཐུན་དྲུག་ཏུ་ཉམས་སུ་བླངས་པས་རྟགས་༨ན་ཐོང་བ་དང་རྟག་གཏོར་གཏོང་བ་ནསང་ག་འགྲོལ་བའི་བར་འདྲ།",
    "ཕག་སྤྱང་ཐོད་པ་གཤིན་རྗེ་ཕོ་མོ་ས།",
    "མིང་ཙམ་བརྡ་ཙམ་མེད་པ་ཐལ་བར་རློག།",
    "བཟློག་བསད་ཀྱི་སྔགས་ཟབ་མོའི་འུར་བ་སློང་།",
    "ཉེས་པ་བསྒྲག་པ་ནས་བཟུང་དམོད་རིང་ཐལ་རྡེབ་ཀྱི་བར་གོང་ལྟར་ལ་ཐུན་རྡེག་པའི་ཚེ་བསད་པའི་དམིགས་རིམ་མན་ངག་ལྟར་བྱ།",
    "འོད་ཟེར་རྭ་དགུའི་རྩེ་མོའི་ཁོང་སྔགས་རྒོད་ལོག་ཏྲིའི་བཟློག་བསད་ལ་སྦྱོར་གྱི་གསལ་བྱེད་ཡི་གེ་གླང་སྤྱོན་སྣ་རྩེའི་མའ་འཁོར།",
    "ཐལ་བའི་རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་བསམ།",
    "དམར་ནག་ཕཊ་དགུ་བསྐུལ་ལས་རེ་དམར་པོ།",
    "ཐལ་བའི་རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་བསམ།",
    "ཐལ་བའི་རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་བསམ།",
    "ཐལ་བའི་རྡུལ་ཕྲན་བཞིན་དུ་བརླག་པར་བསམ།",
    "གཏོར་མ་འབུལ་ཚིག་གི་བ་ཀླ་ཤ་ཁྲག་གཏོར་མ་འདི་བཞེས་ལ་ཡན་བཟློག་བསད་ལྟར་ལ།",
    "གསེར་སྐྱེམས་ནས་བཟུང་ཐུན་བརྡེག་ཐལ་རྡེབ་ཀྱི་བར་གཏང་རྗེས་གྱེར་སྒོམ་རྩེ་གཅིག་ཏུ་བསྒྲིལ་ཏེ།",
    "ཁྱོད་ནི་རྒྱལ་བའི་སྲས་སུ་སྐྱེ།",
    "ཉེན་མོངས་དུག་ལྔ་རྩད་ནས་གཅོད།",
    "རྣོ་དཔལ་གཟི་འོད་རེག་ཙམ་གྱིས།",
    "ཐལ་བའི་རྡུལ་བཞིན་བརླག་པར་མཛོད།",
    "ཁྲོ་མོ་འབར་བའི་གཏུན་ཁུང་དུ།",
    "དབྱིངས་སུ་བསྟིམ་མོ་སམ་ཡ།",
    "ཁྱོད་ཀྱི་ཐུགས་དམ་དུས་ལ་བབ།",
    "དབྱིངས་སུ་བསྟིམ་མོ་སམ་ཡ།",
    "མ་མོ་བཙུན་བདུད་གཟའ་རྒྱལ་འགོང་།",
    "དབྱིངས་སུ་བསྟིམ་མོ་ས་མ་ཡ།",
    "ཞེས་དབུལ་ཞིང་བསྟབ་པས་དགྲ་གདོན་བྱད་མའི་ཤ་ཁྲག་རྣམས་ཁྲོ་རྒྱལ་དྲེགས་པའི་འཁོར་ཚོགས་དང་བཅས་པས་ཧབ་ཧབ་ཧུབ་ཧུབ་ཆེམ་ཆེམ་གསོལ་ཞིང་དགྱེས་པའི་གད་མོའི་འབྲུག་སྟོང་ལྡིར་བ་ལྟར་བསྒྲགས་ནས་ཚིམ་ཞིང་དགྱེས་པར་བསམ།",
    "དམོད་པའི་བདེན་སྟོབས་བརྗོད་པ་ནི།",
    "ཅིང་སོགས་ནས་ཟློག་ཏུ་ནན་གྱི་བར་སྔར་ཐལ་རྡེབ་ཀྱི་སྐབས་ལྟས་བྱ།",
    "བཅུ་དྲུག་པ་མངའ་གསོལ་ཐུགས་རྗེའི་ཟློས་གར་མ་དང་བཟློག་བསྒྱུར་ཐུན་མོང་བའི་སྐབས་ལྟར་བྱ།",
    "དམོད་པ་བྱ་ཞིང་ཐལ་མོ་བརྡབ།",
    "རྒྱས་པར་སྤྲོ་ན་ཐུན་བརྒྱབ་པའི་རྗེས་སུ་བཟློག་གཞུང་འདི་ཚར་རེ་བཏང་ན་ལེགས་གསུང་།",
    "ཐོག་ནས་གསེར་སྐྱེམས་འབུལ་ཞིང་ཟོར་འཕེན་པ་ཐུན་མོང་བའི་སྐབས་དང་འདྲ།",
    "སྒྲུབ་གཏོར་དེ་ཤེས་པ་སུམ་ལྡན་ཡིན་པས་དྲང་སྲོང་གི་དམག་ཚོགས་སུ་གསལ་བཏབ།",
    "ཚུལ་ལྡན་ཤེས་པ་ཉིན་མོའི་སྐར་མ་བཞིན།",
    "ང་ཚོའི་ཁེངས་པས་མཁས་གཞན་མི་བསྟེན་འགྱིང་།",
    "ལ་ལ་སྔོན་ནས་སོང་ཞེས་ཟོག་རྫུན་བྱེད།",
    "འགའ་ཞིག་ཨ་ཕའི་གསོལ་ཞལ་གཙང་བར་ཆེན།",
    "སྐད་ཅིག་གིས་རང་རིག་གྱིཡིག་དམར་པོ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "ཧྲཱི་ཁྱོ་ཧཱ་ཀྲོ་ཏ་པདྨཱ་ནྟ་ཀྲྀ་ཏ་ཧ་ཡ་སྣྲོ་ཝ་ཧཱུཾ་ཧཱུཾ་ཕཊ་ཡ་མ་རཱ་ཙ་དུ་ཏྲི་ཕུ་ཏི་ཧྲཱི།་",
    "གིས་མཚན་པ་ལས་འོད་ཟེར་འཕྲོས་པས་འཁོར་འདས་ཀྱི་རོ་བཅུད་ཐམས་ཅད་བསྡུས་ཏེ་གཏོར་མར་ཐིམ།",
    "ཐམས་ཅད་ཀྱང་དཔུང་ཚོ་གིས་བཞི་པའི་ཆ་ལུགས་སུ་འཇིགས་ཤིང་དཔའ་བ།",
    "དུང་སྤྱང་ཕོ་མོ་དང་།",
    "རྡོ་རྗེ་ཐལ་མོ་ཁ་ཕྱེ་བའི་ཕྱག་རྒྱ་དང་བཅས།",
    "ཞེས་སོགས་སྔགས་དྲུག་དང་ཕྱག་རྒྱ་དྲུག་གིས་བྱིན་གྱིས་བརླབས་ནས།",
    "སྙན་བརྗིད་རོལ་མོ་གྱེར་དབྱངས་བསམ་མི་ཁྱབ།",
    "དམ་རྫས་གཏོར་མ་ནང་གི་རྟེན་དུ་འབུལ།",
    "དཔལ་ལྡན་ལྷ་ཡི་ལྷ་མཆོག་ཁྱོད།",
