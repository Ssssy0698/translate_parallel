    "དྲུང་ཆེན་གཉིས་ངའི་འཁོར་ན་འདུག།",
    "ཉི་མ་འདི་ལ་སྡད་ཆོག་པ་འདུག་ཞུས།",
    "ཐམས་ཅད་མཁྱེན་པའི་སྐུ་པང་ན་ཉི་མ་འདུག་ཅིང་།",
    "ངལ་དུ་འདུག་གསུངས།",
    "ད་འོ་ན་ཁྱེད་རང་དཔོན་སློབ་བཀའ་གྲོས་གནང་བ་ཞུ།",
    "དེ་ལས་གཏན་མེད་ལ་བཟློག་པའི་ཐབས་མི་འདུག་ཕེབས།",
    "དེ་ཡང་བྱ་ལོའི་ནང་རང་དུ་དགོས།",
    "སྐུ་རིམ་གྱིས་ཕྱིར་བསྲིངས་པ་ཡིན་འདུག།",
    "རྗེ་རྡོ་རྗེ་འཆང་དེ་ཉིད་ལ་མཁན་སློབ་ཚང་མས་བྱབ་ཆུང་དུ་རྩི་བའི་བཀའ་བཀྱོན་ནེ་བ་བྱུང་འདུག།",
    "སྙན་དར་རང་བབ་ཏུ་བྱུང་བ་དངོས་གྲུབ་ཀྱི་མཚན་མར་འདུག།",
    "ཐོས་བསམ་གླིང་པའི་སློབ་དཔོན་དེ་རྨི་ལམ་གསལ་པོ་ཡོད་འདུག་པར།",
    "ལྷག་པར་མགོན་པོ་ཞལ་རྡོ་ལ་དངོས་སུ་ཐིམ་པ་ཡིན་འདུག་པ་ནས།",
    "དེ་ཡང་འབྲུག་པ་སྤྲུལ་པའི་སྐུས་དེ་སྐབས་དངས་དངས་དོད་དོད་མཛད་འདུག་ཀྱང་།",
    "དེའི་ཐང་ལ་རྗེ་དྲུང་ཀརྨ་༨༢བ་པ་ཡབ་སྲས་བཞུགས་འདུག་པ་དང་།",
    "ཕྱག་དང་གདན་སོགས་ལ་རྩེག་པོ་ཡོད་ཚོད་དུ་གདའ།",
    "རྒྱལ་ཁ་གཞན་ལ་བསྐུར་བ་ཞིག་ཡིན་པར་འདུག་ཀྱང་།",
    "སང་ཞོགས་ནང་དུ་རང་བྱོན་གྱིས་ཕེབས་ཟིན་འདུག་པས།",
    "འཆི་བདག་ཞལ་དབྱེ་བར་གྲགས་པ་དེ་གཙང་དུ་ཕེབས་དུས་འབུལ་བའི་ཁས་ལེན་ཞུས་འདུག་པ་ལྟར།",
    "ང་བཞད་པའི་རྡོ་རྗེས་བལྟས་ཙ་ན།",
    "གནམ་ཅུང་ཟད་འཚུབ་པ་ཞིག་འདུག།",
    "འདི་ལྟར་ན་ཞྭ་ནག་དེ་མཁའ་འགྲོ་མའི་སྐུ་ལ་བཟོས་ཟེར་བ་ཡང་མི་བདེན་པའི་ངེས་པ་མི་འདུག་གོ།",
    "དེ་དུས་གྲྭ་རྐྱང་ལས་སྤྲོས་པའི་མིང་ཆེ་བ་ཞིག་མི་འདུག་ཀྱང་།",
    "སླར་འབྲས་སྤུངས་སུ་ཕེབས་ཐོག་ཨལ་ཐན་རྒྱལ་པོས་ཁོང་རང་མཚོ་ཁ་ཕྱོགས་སུ་འབྱོར་རྩིས་སོགས་གནས་ཚུལ་འབུལ་བ་དང་།",
    "དེའི་སྲུང་མར་འདུག་པའི་སྟབས་ཀྱིས་ལུས་དངོས་སུ་བསྟན་ནས།",
    "སང་ནམ་ལངས་ཏེ་བལྟས་ཙ་ན་དོང་པུས་ནུབ་ཙམ་ལས་མི་འདུག་པས་ཐམས་ཅད་སྨྲ་མི་ཤེས་པའི་ཡ་མཚན་དུ་གྱུར།",
    "དེ་ནི་རྨ་ཆེན་སྤོམ་ར་དངོས་སུ་བསུ་བ་ལ་འོངས་པར་འདུག་ཀྱང་།",
    "ཞོར་ལ་འགྲོ་བ་འདུག་གསུངས་ནས་སྤོམ་རའི་གསོལ་ཆས།",
    "བྲམ་གཟུགས་ཀྱི་གཏོར་འབུལ་བསྡུས་པ་དང་རང་བསྟོད་རྣམ་དཔྱོད་མ་ཐུགས་རྩོམ་གནང་།",
    "རྒྱལ་པོ་ལ་ཡང་དགོངས་པར་གང་གཏད་ལས་སྤྲོས་པའི་ནན་ཆགས་མི་འགབ་ཚུལ་སོགས་ཞུ་ཡིག་རྒྱས་པར་འདུག་པ་ཁོ་བོས་ཀྱང་མཐོང་།",
    "ཞབས་དྲུང་སྤུ་ལུང་པས་དྲག་ལས་མང་པོ་མཛད་ཀྱིན་འདུག་པས།",
    "རྗེ་ཉིད་ཀྱི་ཞལ་གྱི་རླང་པ་ལས་མེ་ཏོག་པདྨ་དཀར་པོ་ཞིག་བྱུང་བའི་སྟེང་དུ་ཨ་ཡིག་འདུག་པ་ཨས་དཔལ་ནོ་ཡོན་གྱིས་གསལ་བར་མཐོང་།",
    "སྐུ་ཚེ་རིང་པའི་འཕེན་པའང་མེད་འདུག་པའི་སྟབས་ཀྱིས་བཏང་སྙོམས་སུ་བཞག།",
    "ད་ཡན་ནོ་ཡོན་དེ་སྡིག་ལ་རྔམས་ཤིང་མི་བསྲུན་པ་སྲིན་པོའི་རིགས་ཅན་ལྟ་བུ་ཞིག་ཡིན་འདུག་ཀྱང་།",
    "ཁོ་བོ་འགྲོ་ཁར་ཐུག་པ་ལ་བྱོན་པར་འདུག།",
    "གྱིས་ཀྱང་དེ་དང་མཐུན་པ་ཞིག་གསུངས་པ་ལ་ཡིད་ཆེས་ཀྱི་གནས་སུ་མཛད་དགོས་རྒྱུར་འདུག་ཀྱང་།",
    "ལྷ་དཀར་པོ་ཞིག་དང་མཇལ་བ་བྱུང་འདུག།",
    "འཁྲུངས་ནས་ཟླ་བ་བཅུ་ལས་མི་འགྲོ་བ་འདུག་སྟེ།",
    "ཞབས་དྲུང་ཐམས་ཅད་མཁྱེན་པའི་སྐུ་སྐྱེ་ཡིན་མིན་ཅི་ཡིན་རུང་ཐ་མལ་གྱི་ཉམས་ནི་མི་འདུག།",
    "གཞན་མ་བཱི་ཇིས་ལུང་བསྟན་འདྲ་མང་པོ་གསུངས་འདུག་སྟེ།",
    "སྔོན་མེད་པའི་ཡིད་ལ་དགའ་བའི་ཉམས་ལྷང་ལྷང་བ་ཤར་བ་བྱུང་འདུག།",
    "ཁྲི་མཐོན་པོ་སེང་གེའི་གཟུགས་ཀྱིས་བཏེག་པ་ཞིག་འདུག་པའི་འཁྲིས་སུ་སླེབས་ཙ་ན།",
    "ད་སྣེ་གདོང་རྩེར་འབུལ་དགོས་འདུག་བཀའ་ཕེབས།",
    "རྣམ་དཔྱོད་ཀྱི་རྩལ་ཅུང་ཟད་ཙམ་ཡང་མི་ལྡན་པའི་བླ་ཆེན་གྱི་མིང་གོག་སྐམ་པོ་ཐམས་ཅད་ལ་ཁོང་པ་ཐུགས་མགུ་མཁན་ཞིག་མིན་པ་འདུག་ཀྱང་།",
    "སྐུ་ཡོན་འབུལ་མཁན་ལ་ཡོན་ཏན་ཡོད་མེད་ཀྱི་རྣམ་དབྱེ་ཕྱེད་པོ་ཞིག་མེད་འདུག་པ་དང་།",
    "དོན་གཉིས་རླབས་པོ་ཆེ་ལྷུན་གྱིས་གྲུབ་པ་ཞིག་འོང་རྒྱུར་འདུག་ཀྱང་།",
    "རྒྱལ་ཁང་རྩེར་བཞུགས་སྐབས་ཡིན་འདུག་པས།",
    "ཁྱད་པར་ངེད་ན་ཚོད་མཐོས་པས་སོག་ཡུལ་དུ་སྐུ་ཞབས་སུ་སླེབ་པ་ཞིག་མི་ཡོང་འདུག་ཀྱང་།",
    "མཐོང་བས་དོན་དང་ལྡན་པར་གྲགས་པ་ཀུན་ལ་མ་བྱུང་འདུག།",
    "འདིར་ལོ་གསུམ་ཙམ་བཞུགས་ཀྱང་ཟླ་བ་གསུམ་ཙམ་གྱི་ཡུན་ཚད་ཀྱི་ཉམས་ལས་མི་ཡོང་བ་འདུག་པས།",
    "དགའ་ལྡན་སྤྱི་སྒེར་བྱིངས་ཀྱི་སྔོན་ལ་འབྱོན་པ་དེ་ཕྱག་མཛོད་གུ་ཤྲིས་ཁྱེད་རང་བྱིངས་ལས་གཡེར་དུ་འཐོན་པ་ཞིག་མཛོད།",
    "ཨ་བོ་ཧོར་འདྲའི་སྤྱོད་ཚུལ་དང་ལྡན་པ་ཞིག་མིན་པར་གདའ་ཡང་།",
    "དཀོན་ཅོག་ལ་གུས་ཤིང་རང་སྲིད་སྐྱོང་མཁས་པ།",
    "ལུགས་གཉིས་ཀ་ནས་འོས་པ་ཞིག་མི་འདུག་པས།",
    "མི་འགྱངས་པར་དག་པའི་ཞིང་དུ་གཤེགས་པ་སྟབས་མ་འགྲིག་འདུག།",
    "དེ་བདུད་ཀྱི་སྤྲུལ་པ་ཡིན་པའི་ཕྱོགས་མང་མང་པོ་ཞིག་འདུག་པ་ལ།",
    "བདག་བསྟོད་གཞན་བསྟོད་མང་པོ་ཞིག་འདུག་པའི་ནང་ནས་ཚིག་སྤྱོར་ལེགས་པར་མཐོང་།",
    "རང་ཉིད་ཀྱང་དད་སྤྲོས་ཀུན་ནས་བླངས་ཏེ་རྗེའི་ཞབས་དྲུང་རང་དུ།",
    "སྙན་སྒྲོན་ལེགས་པོ་ཡིན་འདུག།",
    "ཡ་མཚན་པའི་གནས་ཤིན་ཏུ་ཡིན་པར་གདའ།",
    "སྔ་ཕྱིར་བཀའ་ཕེབས་གནང་བའི་ལྷོངས་ལ་ཡང་གུས་ཉམས་ཆེ་བ་འདུག།",
    "གཡེར་ཁ་ཁལ་ཁེབས་སོགས་གྲ་གཅིག་པ་ཞིག་བྱུང་ན་ཡོང་རྒྱུར་འདུག།",
    "དེའི་ལན་དུ་ཕྱག་མཛོད་གུ་ཤྲིས་ང་རང་ཡང་དེ་ཀ་བསམ་སྟེ།",
    "བརྒྱ་ལ་བྱེད་དམ་སྟོང་ལ་བྱེད་ལྟ་བུར་འདུག་པས།",
    "ཡར་རྒྱབ་པས་ཞུས་པའི་ཟུར་ཙམ་དུ་ཡང་མི་སླེབས་འདུག།",
    "ད་ཆ་རང་ཕྱོགས་སུ་འགྱུར་བ་ལྟ་བུ་ཡིན་འདུག་པས།",
    "བྱ་རོག་འུག་པའི་བརྟུལ་ཞུགས་ཡུན་རིང་དུ་འཛིན་པ་ཞིག་ཡོད་འདུག་ཅིང་།",
    "འཕྲལ་གྱི་སྣང་ཚུལ་དབུ་བླ་རྣམས་ཀྱིས་གདུང་བརྒྱུད་ཞལ་ངོར་ཕྱག་འབུལ་བ་སོགས་འཇམ་དབྱངས་འཁོན་གྱི་རིགས་སུ་འཁྲུངས་པ་རྣམས་འགྲན་གྱི་ཟླ་མེད་དུ་འཛིན་པར་གདའ།",
    "ཡུལ་ཕྱོགས་རང་རང་གུས་མཆོད་བྱས།",
    "དུས་ཕྱིས་ཀྱང་མི་དེ་འདྲའི་རིས་འདུག་ཅེས་ཐུགས་ཁྲེལ་བའི་གསུང་འཕྲོས་ཡང་ཡང་གནང་།",
    "སོར་ཕྱེད་ཀྱིས་འཇལ་རིན་མི་གདའ་ཡང་།",
    "སྟོན་པ་ཤཱཀྱ་ཐུབ་པས་བྱམས་པའི་ཏིང་ངེ་འཛིན་གྱི་སྒོ་ནས་བདུད་བཏུལ་བར་འདུག།",
    "དན་འབག་ཡས་སྣ་མས་སྣ་ལ་ཐེམ་པ་བཅོལ་ནས་སྡོད་དགོས་པའི་དུས་ཚོད་འདི་ལ་ལས་སྦྱོར་མི་བྱེད་ན་ག་ཙ་ན་བྱེད།",
