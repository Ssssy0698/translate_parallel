    "སྔོན་འཇུག་གིས་མིང་གཞིའི་སྒྲ་གདངས་སྔོན་གྱི་ཆ་ལས་གཞན་དུ་འཕུལ་ཚེ།",
    "མིང་གི་བྱེ་བྲག་གཞན་ལའང་སྦྱོར་བ།",
    "མོ་ནི་བདག་དང་མ་འོངས་ཕྱིར།",
    "ཤིན་ཏུ་མོ་ནི་མཉམ་ཕྱིར་རོ།",
    "མིང་གང་གི་ནི་མཐར་སྦྱར་པ།",
    "ཞེས་པ་བཞིན་ཚིག་ཕྲད་དག་གི་སྦྱར་གཞི་ནི་མིང་ཡིན་པར་བསྟན་པ་ལས་རྣམ་དབྱེའི་ཚིག་ཕྲད་ཕལ་ཆེར་ཁྱད་གཞི་བརྗོད་པའི་མིང་ངམ་ངེས་བཟུང་གི་མིང་ལ་སྦྱོར་བའི་ནང་གསེས་ཀྱི་ཁྱད་པར་ཚིག་མཐའི་མིང་དོན་ཕྱི་མ་ལ་ལྟོས་ཕྱིར།",
    "ཚིག་གི་ཡས་མཐའི་ཁྱད་གཞི་བརྗོད་པའི་མིང་སོགས་བསྟན་པའི་རྗེས་སུ།",
    "ཚིག་གི་མས་མཐའི་བྱ་བ་བརྗོད་པའི་མིང་ངམ་དེ་དང་ནུས་མཚུངས་ཀྱི་མིང་དག་མ་བསྟན་ན་ཡ་བྲལ་དུ་གྱུར་པ་དང་གཅིག་དངོས་པོའི་མཚན་ཉིད་ལ་དོན་བྱེད་ནུས་པ་ཞེས་པ་བཞག་པ་ལྟར།",
    "བྱ་བ་ནི་བརྡ་སྤྲོད་རིག་པ་སྤྱི་དང་བྱེ་བྲག་ཚིག་གི་འགག་དོན་དུ་གྲུབ་པར་མ་ཟད།",
    "མིང་གཞན་དག་ལ་བལྟོས་པས་བྱ་ཚིག་བྱེད་ཚིག་འདས་ཚིག་གི་ཁྱད་པར་གཙོ་བོ་སྔོན་འཇུག་ལ་བརྟེན་ཅིང་།",
    "སྔོན་འཇུག་སྦྱོར་ཚུལ་ངེས་ན་བྱ་བའི་དུས་ཀྱི་ཁྱད་པར་ཡང་རང་བཞིན་གྱིས་རྟོགས་པར་འགྱུར་བ་བཅས་ཀྱི་ཕྱིར་རེད་དོ།",
    "འགྱུར་བ་ལྟོས་མེད་ཀྱི་ངང་དུ་སྐྱེས་འཇིག་གནས་རྙིང་གི་བྱ་བའི་རྒྱུན་ལ་བརྟེན་ནས་སྣང་གིན་ཡོད་པས།",
    "འཇིག་རྟེན་གྱི་གནས་ལུགས་རྟོགས་པ་ལ་བྱ་བའི་རང་བཞིན་དང་དེའི་རྟེན་འབྱུང་གི་དོན་ལ་བློ་འབྱོངས་དགོས་པས།",
    "སློབ་དཔོན་ཀླུ་སྒྲུབ་མཆོག་གི་ཞལ་ནས་ཀྱང་།",
    "འདི་ཡོད་ན་འདི་འབྱུང་གི་རིགས་པས་བཏགས་པ་ཡིན་ཕྱིར།",
    "བྱ་བྱེད་ལས་གསུམ་དང་དངོས་པོ་བདག་གཞན་གྱི་རྟེན་འབྱུང་གི་རིགས་པ་ལ་བློ་འབྱོངས་པར་གྱུར་ན།",
    "དངོས་མེད་བརྟེན་ནས་བཏགས་པའི་བརྟེན་ཅིང་འབྲེལ་འབྱུང་གི་རིགས་པའི་བདག་འབྲས་སུ་གྲུབ་པ་ལྟར།",
    "རྟགས་འཇུག་གི་སྔོན་འཇུག་དགོས་པ་ཅིའི་ཕྱིར་འཇུག་པའི་ཐད་དུ་བསྟན་པའི་དངོས་པོ་བདག་དང་གཞན་ཞེས་པའི་ཐ་སྙད་ཆ་འདི་ཡང་བྱ་བ་བརྗོད་པའི་མིང་གི་གྲུབ་ལུགས་ཀྱི་དོན་ལ་དགོས་པ་ལྷག་པོ་མེད་ཀྱང་།",
    "བྱ་བ་ཞིག་གི་འགྲུབ་རྐྱེན་སོ་སོའི་བར་གྱི་རྟེན་འབྱུང་གི་གནས་ལུགས་རྟོགས་པ་ལ་དབྱེ་སྒོ་གཞན་ཀུན་བས་ཀྱང་གལ་ཆེ་བ།",
    "བདག་གི་དངོས་པོ་ཡོད་མིན་ན།",
    "བྱ་བ་དེ་ནི་བྱེད་པ་པོ་དང་བྱ་ཡུལ་གཉིས་ཕན་ཚུན་འཕྲད་ཅིང་ལྟོས་པ་ལས་བྱུང་བའི་རྟེན་འབྱུང་གི་དོན་ཞིག་ཡིན་པ་གསལ་བར་བྱས་ཏེ།",
    "བྱ་བ་གང་ཡིན་ཡང་རྒྱུ་རྐྱེན་རྟེན་འབྱུང་གི་བདག་འབྲས་སུ་ངེས་ཤིང་།",
    "འདིར་བྱ་བའི་རྟེན་འབྱུང་གི་གནས་ལུགས་གསལ་སླད་དུ་དངོས་པོ་བདག་གཞན་གྱི་རྣམ་གཞག་བྱས་པ་རེད་དོ།",
    "བྱེད་པ་པོ་གཞན་དང་འབྲེལ་མ་འབྲེལ་ཕན་ཚུན་ལྟོས་གྲུབ་ཀྱི་གྲུབ་ལུགས་ལ་གཏན་སྲོལ་ག་འདྲ་ཡོད་པ་རེད།",
    "ལས་གང་ཞིག་བྱེད་པ་པོ་གཞན་དང་དངོས་སུ་མ་འབྲེལ་བར་རང་ཉིད་ངང་གིས་གྲུབ་པ་སོགས་བྱ་བྱེད་ཐ་མི་དད་པའི་ལས་ཚིག་རིགས་གཉིས་ཕན་ཚུན་ཟླ་བཅས་སུ་གྲུབ་པ་ལ་མིང་གཞིའི་དྲག་ཞན་དང་།",
    "དཀྱོག་དང་འཁྱོག་བཙུགས་དང་ཚུགས།",
    "འཚོད་དང་ཚོས།",
    "བྱ་བ་འདི་རིགས་ཀྱི་ཁྱད་པར་རྟོགས་པ་ལ་ཐོག་མར་མིང་གི་གྲུབ་གཟུགས་ལ་ནན་ཏན་བྱ་རིགས་སོ།",
    "བྱེད་པ་པོ་གཞན་དང་འབྲེལ་མ་འབྲེལ་བའི་ལས་ཚིག་གི་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "བྱེད་པ་པོ་གཞན་འབྲེལ་གྱི་ལས་ཚིག་གི་རྩོལ་བ་དྲག་ཅིང་སྒྲ་རྩུབ་པ་ཤས་ཆེ་ལ།",
    "བྱེད་པ་པོ་གཞན་དང་མ་འབྲེལ་བའི་ལས་ཚིག་གི་རྩོལ་བ་ཞན་ཞིང་སྒྲ་མཉེན་པ་ཤ་སྟག་ཡིན།",
    "མོ་ཡིག་ག་ཇ་ད་བ་ཛ་སོགས་འཐོབ་པའོ།",
    "བྱེད་པ་པོ་གཞན་དང་འབྲེལ་བའི་ལས་ཚིག་གི་སྔོན་འཇུག་ལ་ངེས་པ་མེད་དོ།",
    "བྱེད་པ་པོ་གཞན་དང་མ་འབྲེལ་བའི་ལས་ཚིག་གི་གཟུགས་འགྱུར་ཉུང་བའོ།",
    "བྱེད་པ་པོ་གཞན་དང་འབྲེལ་བའི་ལས་ཚིག་གི་བྱེད་པ་པོ་ནི་མི་ཡིན་ན་སྐུལ་ཚིག་ངེས་པར་འཐོབ་ཅིང་།",
    "བྱེད་པ་པོ་ཙམ་དང་བྱེད་པ་པོ་གཞན་གཉིས་ཀྱི་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "བྱ་བ་ཞིག་སྒྲུབ་མཁན་གྱི་བྱེད་པ་པོ་གཞན་མེད་པར་བྱ་བའི་ཡུལ་གྱི་དངོས་པོའི་སྟེང་གི་འཕོ་འགྱུར་སོགས་སྟོན་པའི་སྐབས་ཀྱི་བྱ་བའི་ཡུལ་དེ་ཡང་བྱེད་པ་པོ་ལས་ལོགས་སུ་མེད་པ་དང་།",
    "དེ་རིགས་ནི་བྱེད་པ་པོ་གཞན་དང་མ་འབྲེལ་བའི་ལས་ཚིག་གི་བྱ་བའི་ཡུལ་དང་ངོ་བོ་གཅིག་ཏུ་གྲུབ་པའི་དངོས་པོ་དེ་ཉིད་ལ་བྱེད་པ་བདག་བརྗོད་ཀྱི་སྒྲ་པོ་བོ་སོགས་སྦྱར་པ་ཙམ་ལས།",
    "དེ་དག་གི་ཁྱད་པར་གཙོ་བོ་འདི་ལྟ་སྟེ།",
    "རྟགས་ཀྱི་འཇུག་པའི་གཞུང་གི་ཆེས་དཀའ་ས་ནི་སྔོན་འཇུག་གི་དགོས་པ་ཅིའི་ཕྱིར་འཇུག་པའི་དོན་ཡིན་ལ།",
    "དེ་དག་ཕན་ཚུན་ལྟོས་ཏེ་བཞག་པའི་རྟེན་འབྱུང་གི་རྣམ་གཞག་ཆ་གཅིག་བསྟན་པ་དང་།",
    "དེ་དག་གིས་བསྒྲུབ་བྱའི་བྱ་བའི་ཡུལ་ལ་བྱ་དང་།",
