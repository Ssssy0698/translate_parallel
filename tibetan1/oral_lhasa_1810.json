    "དེས་ནི་སྣང་བ་ཡང་དག་པརཤེས་ལ།",
    "ཐེ་ཚོམ་ལ་སོགས་པས་རྣམ་པབཅུ་གཅིག་བར་དུ་གཅོད་པར་རིག་པར་བྱ་སྟེ།",
    "གང་ལ་བརྟེན་ནས་ཏིང་ངེ་འཛིན་གནས་པརའགྱུར་བའི་མཚན་མ་དེ་ལས་ཉམས་ན་གནས་པར་མི་འགྱུར་བའི་ཕྱིརརོ།",
    "དེ་ལ་ཐོག་མར་མ་བསམས་པར་གཟུགས་སྣང་བ་མཐོང་བ་ལས་ནིཐེ་ཚོམ་ཟ་བར་འགྱུར་རོ།",
    "བརྩོན་པ་ལྷོད་པ་ལས་ནི་ཡིད་ལམི་བྱེད་པར་འགྱུར་ཏེ།",
    "ཡང་ན་མིག་འཛུམས་པར་བྱེད་དམ།",
    "དེ་ཡང་གཟུགས་དེ་དག་ཡིད་ལ་མི་བྱེད་པར་འགྱུར་རོ།",
    "ཧ་ཅང་བཏུད་དེ་ཡིདལབྱེད་པའི་ཕྱིར་ཧ་ཅང་བརྟུན་ངས་པར་འགྱུར་རོ།",
    "ཧ་ཅང་བརྟུནངས་པའི་ཉེས་པས་ནི་ཧ་ཅང་ཞུམ་པར་བྱེད་དེ།",
    "གློ་གཉི་ག་ནས་སྲེག་པར་འཕུར་བ་བཞིན་ནོ།",
    "ཕྱི་རོལ་དུ་འདུ་ཤེས་པ་དེ་ནི་དེའི་ཏིང་ངེའཛིན་ལ་བར་དུ་གཅོད་པར་བྱེད་དོ།",
    "གཞན་ནི་དམའ་བར་བདག་ཉིད་ཀུནཏུ་འཛིན་པར་བྱེད་ན།",
    "ཕྱི་རོལ་དུ་འཇུག་པར་བྱེད་ཅིང་།",
    "གཟུགས་རྣམས་ལརྟོག་པར་བྱེད་པའི་ཕྱིར།",
    "གཞི་ལ་བར་དུ་གཅོད་པར་རིག་པར་བྱ་སྟེ།",
    "གཞིའི་མཚན་མ་རྣམས་ལསཉམས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ཁ་ཅིག་ནི་གཉི་གའི་མཚན་མ་ལསཉམས་པར་བྱེད་དོ།",
    "སྙོམས་པར་འཇུག་པ་དང་།",
    "ཟང་ཟིང་མེད་པ་ཞེས་བྱ་བ་ནི་དགེབའི་འཕགས་པ་ཉིད་དུ་སྟོན་པར་བྱེད་དོ།",
    "ཕྱིས་ནི་རགས་པའོཞེས་རྣམ་པར་སྨད་པ་དེ་ལྟ་བུ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡོངས་སུ་ཉམསཔར་མི་འགྱུར་བའི་ལམ་ཐོབ་པའི་ཕྱིར་རོ།",
    "ཕྱི་མ་ལ་རྣམ་པར་སྨིན་པ་བདེ་བ་ཞེས་བྱ་བ་ནིཕུང་པོ་ལྷག་མ་མེད་པའི་མྱ་ངན་ལས་འདས་པའི་བདེ་བ་ཐོབ་པརབྱེད་པའི་ཕྱིར་རོ།",
    "དྲན་བཞིན་དུ་སྙོམས་པར་འཇུག་ཅེས་བྱ་བ་ནིཏིང་ངེ་འཛིན་གྱི་མཚན་མ་ལེགས་པར་གཟུང་བ་མ་བྲྗེད་པའི་ཕྱིརརོ།",
    "དྲན་བཞིན་དུ་ལྡང་ཞེས་བྱ་བ་ནི་ལྡང་བའི་མཚན་མ་ལེགས་པར་གཟུང་བ་མ་བྲྗེད་པའིཕྱིར་རོ།",
    "དེལ་དགའ་བས་ནི་མཉན་པར་བྱེདདོ།",
    "བདེ་བས་ནི་ཡོངས་སུ་མཉན་པར་བྱེད་དོ།",
    "སྦྱོར་བའི་མཐརཐུག་པའི་ཡིད་ལ་བྱེད་པའི་ཚེ་ནི་ཀུན་ཏུ་ཁྱབ་པར་བྱེད་དོ།",
    "བསྟན་པཡང་མ་ཡིན་ལ་ཡོངས་སུ་རྫོགས་པར་ཡང་མ་ཡིན་ནོ།",
    "སྦྱོར་བའིམཐར་ཐུག་པའི་འབྲས་བུའི་ཡིད་ལ་བྱེད་པའི་ཚེ་ནི་དེས་ཅི་ཡངཁྱབ་པར་མ་གྱུར་པའམ།",
    "ཁྱབ་པར་བྱ་བ་མེད་དོ།",
    "ཉ་ཕྱིས་ཞེསབྱ་བ་ནི་འདོད་པ་རྣམས་ལས་དབེན་པ་ལས་སྐྱེས་པའི་དགའ་བ་དངབདེ་བ་ལས་བརྩམས་པའི་གདམས་ངག་རྗེས་སུ་བསྟན་པ་ཡིན་པར།",
    "ཆུས་གཏོརཏེ་བྲླན་ཞེས་བྱ་བ་ནི་རྟོག་པ་ཡོངས་སུ་དག་པའི་ལམ་ཡིན་པར།",
    "ཆལ་གྱི་གོང་བུ་ཞེས་བྱ་བ་ནི་ལུས་ཡིན་པར་བལྟའོ།",
    "ཕྱི་ནང་བཅས་པར་ཁྱབ་ཅེས་བྱ་བ་ནི་རྒྱུན་མིའཆད་པར་དགའ་བ་དང་བདེ་བ་དང་ལྡན་པ་སྟོན་པར་བྱེད་དོ།",
    "མིའཐོར་བ་ཞེས་བྱ་བ་ནི་རྣམ་པར་མི་གཡེང་བའི་ཕྱིར་རོ།",
    "གཉིས་པལ་ཡང་དཔེའི་བྱེ་བྲག་ཡོད་པར་བལྟ་སྟེ།",
    "མཚོ་བྲན་ནི་ནང་ཡང་དག་པར་དང་བའིཕྱིར་རོ།",
    "མཉེན་པར་བྱེད་པ་ལ་སོགས་པའིརྣམ་གྲངས་ནི་སྔ་མ་བཞིན་ནོ།",
    "མ་ཁྱབ་པ་མེད་ཅེས་བྱ་བ་ནིརྒྱུན་མིའཆད་པར་སྦྱོར་བའི་ཕྱིར་རོ།",
    "དེ་མེད་པའི་ཕྱིར་སྦུབས་ནུབ་པ་ཞེས་གསུངས་སོ།",
    "མཚུངསཔར་ལྡན་པས་ཏེ།",
    "ས་འོག་མའི་སྐྱོན་ལས་ཡང་དག་པར་འདས་པའིཕྱིར་རོ།",
    "དེ་བཞིན་དུ་བསམ་གཏན་བཞིཔ་ཡོངས་སུ་དག་པ་ཐོབ་པ་ནི་བརྟགས་པ་བག་ཡོད་པར་འཇུག་པ་སྟེ།",
    "ཤ་སྦྲང་དངསྦྲང་བུ་ལ་སོགས་པས་མི་ཚུགས་པར་སྟོན་ཏོ།",
    "ཡང་ན་སྒྲེ་བོར་གྱུར་པའི་ཉེས་པའདི་གཉིས་ལས་ཚུགས་པར་འགྱུར་བས་ན་དེ་གཉི་ག་མེད་པར་སྟོན་ཏོ།",
    "སོ་སོར་རྟོག་པའི་མཚན་མ་ཉིད་ལེགས་པར་རབ་ཏུ་ཞེས་བྱ་བ་ནི་སྔར་བཤདཔར་ཟད་པར་རིག་པར་བྱ་སྟེ།",
    "དེ་ལྟར་ན་རྣམ་པ་གཉིས་ཀྱིས་དེ་རྣམ་པར་གཞག་པརབལྟ་བར་བྱའོ།",
    "ཡོ་བྱད་ཅེས་ཀྱང་བྱའོ་ཞེས་གསུངས་ཏེ།",
    "དེདག་མཐུན་མཐུན་དུ་རིག་པར་བྱའོ།",
    "འཚོ་བ་ཡོངས་སུདག་པར་བྱེད་པས།",
    "གཞན་གྱི་སྒྲའི་རྒྱུ་ལས་བྱུང་བསནི་ཐོས་པ་ལས་བྱུང་བའི་ཡང་དག་པའི་ལྟ་བ་སྐྱེད་པར་བྱེད་དོ།",
    "ལོགཔར་ལྟ་བ་ལ་ལོག་པའི་ལྟ་བ་ཡིན་པ་དང་།",
    "ལོགཔར་ལྟ་བ་ལ་སོགས་པ་སྤོང་བ་དང་།",
    "ཡང་དག་པའི་ལྟ་བ་ལ་སོགསཔ་རྫོགསཔར་བྱ་བའི་ཕྱིར་སྤྲོ་བ་སྐྱེད་དོ།",
    "ཡང་དག་པའི་ལྟ་བ་ལ་སོགས་པ་རྫོགས་པར་བྱེད་པདེའི་བར་སྐབས་ཀྱི་སྦྱོར་བའི་ལམ་གྱི་ཚེ།",
    "ཡང་དག་པའི་རྩོལ་བ་དང་དྲན་པ་ཡངརྫོགས་པརབྱེད་དོ།",
    "རྫོགས་པ་དང་དུས་མཉམ་དུ་འཕགསཔའི་ཡང་དག་པའི་ཏིང་ངེ་འཛིན་ཀྱང་ཡོངས་སུ་རྫོགས་པར་འགྱུརརོ།",
    "ཡོངས་སུ་རྫོགསཔར་འགྱུར་རོ།",
    "མཐོང་བའི་སྙོམས་པར་འཇུག་པ་ལྔ་གང་ཞེ་ན།",
    "མཐོང་བལ་སྙོམས་པར་ཞུགས་པ་དེ་དག་ནི་མཐོང་བའི་སྙོམས་པར་འཇུག་པརྣམས་ཏེ།",
    "བསྒོམས་པས་སྤང་བར་བྱ་བ་རྣམ་པར་གནོན་པའི་གཉེན་པོདང་།",
    "དེ་ཙམ་གྱིས་ན་མི་སྡུག་པ་ཐམས་ཅད་སོ་སོརབརྟགས་པར་འགྱུར་རོ།",
    "དེ་ལ་ལྷག་པར་རྟོགས་ཤིང་ལྷག་པར་རྟོགསཤིང་ཞེས་བྱ་བ་ནི།",
    "རྣམ་པར་བསྡོས་པ་ལ་སོགས་པར་བརྟགས་པའིརྣམ།",
    "རྣམ་པར་ཤེས་པའི་རྒྱུན་ལ་སོ་སོརརྟོག་ཅེས་བྱ་བ་ནི།",
    "ཚེ་རབས་བརྒྱུད་མར་ཉིང་མཚམས་སྦྱོར་བ་ལས་ནི་འདུ་བྱེདཀྱི་རྐྱེན་གྱིས་རྣམ་པར་ཤེས་པ་ལ་སོ་སོར་རྟོག་གོ།",
    "འདོད་ཆགསདང་བྲལ་བ་ལ་སོགས་པའི་རྣམ་པར་སོ་སོར་རྟོག་གོ།",
    "ཡུད་ཙམ་དེ་དངདེ་དག་ལས་འདས་པ་ལས་ནི་རྣམ་པ་དུ་མ་མང་པོ་རྣམ་པ་སྣ་ཚོགསསུགཞན་སྐྱེ་ཞིང་གཞན་འགག་པར་སོ་སོར་རྟོག་གོ།",
    "དགྲ་བཅོམ་པ་ནི་གང་ལ་ཡང་མི་གནས་པར་སོསོར་རྟོག་སྟེ།",
    "འདུ་ཤེས་མེད་པའིསྙོམས་པར་འཇུག་པ་ནི་དགེ་རྒྱས་ཀྱི་འདོད་ཆགས་དང་བྲལ་ལ།",
    "དེ་ཡང་ཇི་ལྟར་སྙོམས་པར་འཇུག་ཅེ་ན།",
    "བསམ་གཏན་བཞི་པ་ལ་སྙོམས་པརཞུགས་ཏེ།",
    "འདུ་ཤེས་ལ་མི་ཕྱོགས་པའི་ཡིད་ལ་བྱེད་པ་བསྒོམ་ཞིངའདུ་ཤེས་བྱུང་ངོ་ཅོག་ལ་མི་ཕྱོགས་པར་གནས་ཏེ།",
    "འདིར་སྐྱེས་པ་ནི་སྙོམསཔར་ཡང་འཇུག་ལ་ལྡང་བར་ཡང་བྱེད་དོ།",
    "དེར་སྐྱེས་པ་ནི་སྙོམསཔར་ཞུགས་པ་ཁོ་ན་ཡིན་ནོ།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་གང་ཞེན།",
    "དེ་ཡང་ཇི་ལྟརསྙོམས་པར་འཇུག་ཅེ་ན།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ཀྱི་མཚན་མམེད་པ་ལ་སྙོམས་པར་ཞུགས་ཀྱང་རུང་།",
    "ཡང་ན་འགོག་པའི་མཚན་མམེད་པ་ལ་སྙོམས་པར་ཞུགས་ཀྱང་རུང་སྟེ།",
    "དེ་ལ་འདུ་ཤེས་མེད་འདུཤེས་མེད་མིན་སྐྱེ་མཆེད་ལ་སྙོམས་པར་ཞུགས་པ་ནི་དེའི་གོང་དུསེམས་ལྷག་པར་བཏང་སྙོམས་སུ་བྱེད་དེ།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེདམིན་སྐྱེ་མཆེད་ཀྱི་མཚན་མ་མེད་པ་ལ་སྙོམས་པར་ཞུགས་ཀྱངརུང་།",
    "ཡང་ན་འགོག་པའི་མཚན་མ་མེད་པ་ལ་སྙོམས་པར་ཞུགས་ཀྱངརུང་སྟེ།",
    "དེ་ལ་འདུ་ཤེས་མེད་འདུསྙོམས་པར་ཞུགས་པ་ཡང་དེ་དང་འདྲའོ།",
    "ཞི་གནསནི་དོན་འདིར་མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་བརྒྱད་ལབྱའོ།",
    "དེ་གཉིས་ལསགཅིག་མེད་ན་སྙོམས་པར་འཇུག་ཏུ་མི་རུང་བའི་ཕྱིར།",
    "གཉི་ག་ཚོགསན་གཅེས་སྤྲས་བྱེད་པར་འགྱུར་རོ།",
    "འགོག་པའི་སྙོམསཔར་འཇུག་པ་ན།",
    "འདུ་བྱེད་རྣམ་པ་གསུམ་ཇི་ལྟར་རིམ་གྱིས་འགག་པརའགྱུར་ཞེན།",
    "དེ་དག་བསམ་གཏན་གཉིས་པམན་ཆད་དུ་མཐར་གྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པའི་ཕྱིར་མཐརགྱིས་འགག་པར་འགྱུར་རོ།",
    "འགོག་པ་ལ་སྙོམསཔར་ཞུགས་པའི་སེམས་དང་སེམས་ལས་བྱུང་བ་རྣམས་འགག་པར་གྱུརན།",
    "རྣམ་པར་ཤེས་པ་ལུས་དང་ཇི་ལྟར་འབྲལ་བར་མི་འགྱུར་ཞེ་ན།",
    "འཇུག་པའིརྣམ་པར་ཤེས་པའི་ས་བོན་གྱིས་ཡོངས་སུ་ཟིན་པ་ཀུན་གཞི་རྣམཔར་ཤེས་པ་མེད་པ་མ་ཡིན་ཏེ།",
    "འགོག་པ་ལ་སྙོམས་པར་འཇུག་པ་ན།",
    "འདི་སྙམ་དུབདག་ནི་འགོག་པ་ལ་སྙོམས་པར་འཇུག་གོ་སྙམ་པའམ།",
    "སྙོམས་པར་འཇུག་བའི་དུས་ན་ནི།",
    "མངོནཔར་འདུ་བྱེད་པ་མེད་པར་སེམས་འགག་ལ།",
    "དེས་ཇི་ལྟར་སེམས་དེ་སྔར་ཡོངསསུ་སྦྱང་བ་བྱས་པ་ཡིན་ཞེ་ན།",
    "ལྡང་བ་དེལ་ཀུན་ཏུ་རྟེན་ཅིང་ལན་མང་དུ་བྱས་ཏེ།",
    "སྙོམསཔར་འཇུག་པ་དེ་ལས་ལྡང་བའི་ཚེ་ཤས་ཆེར་སྲིད་པ་ལ་དམིགས་པདང་།",
    "འདི་ལྟར་འགྱུར་རོ་སྙམ་དུ་མི་སེམས་པ་ནས་རྒྱས་པརསྦྱར་ཏེ།",
    "རྣམ་པར་ཐརཔ་དང་།",
    "སྙམ་པར་འཇུག་པ་རྣམས་ནི་བཤདཟིན་ཏོ།",
    "ནང་དུ་ཡང་དག་འཇོག་ལ་བརྩོན་པར་གྱིསཤིག་ཅེས་གང་གསུངས་པ་དེ་ལ་མལ་ཆ་དང་།",
    "དེ་ལ་ནང་དུ་ཡང་དག་འཇོག་ནི་ནང་དུ་སེམས་ཞི་གནསསྒྲུབ་པར་བྱེད་དོ།",
    "དྲན་བཞིན་དུ་སྒོམས་ཤིག་ཅེས་གངགསུངས་པ་དེ་ལ།",
    "མཁས་པར་བྱེད་པ་ལ་རྟག་འགྲུས་ཞེས་བྱའོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་བཞི་ལ་ཉེ་བརགནས་པའི་སེམས་ཡིན་པར་བསྟན་ཏོ།",
    "འཇིག་རྟེན་པའི་ཕུན་སུམ་ཚོགས་པ་སྒྲུབ་པར་བྱེད་དོ།",
    "དྲན་བཞིན་པ་ནི་འཇིག་རྟེན་ལས་འདས་པའི་ཕུན་སུམ་ཚོགསཔ་སྒྲུབ་པར་བྱེད་དོ།",
    "བསྟན་པར་བྱ་བ་ནི་དེ་གསུམ་ཁོ་ནར་ཟད་དོ།",
    "ཞི་གནས་ཀྱི་ལམ་ཡིན་པར་བསྟནཏོ།",
    "དེ་གཉིས་མྱུར་དུ་འགྲུབ་པར་འགྱུརབའི་ལམ་ཡིན་པར་བསྟན་ཏེ།",
    "སྔར་ཞི་གནས་ལ་ཡོངས་སུ་བྱང་བརབྱས་པའི་འོག་ཏུ་ལྷག་མཐོང་དང་ལྡན་པའི་ཏིང་ངེ་འཛིན་རྣམཔ་དེ་གཉིས་བསྒོམས་ན་ཤེས་བྱ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུསྣང་བརའགྱུར་རོ།",
    "སྙོམས་པར་འཇུགཔ་ལ་མི་མཁས་པ་ཇི་ལྟ་བུ་ཡིན་ཞེ་ན།",
    "ཟད་པར་གྱི་སྐྱེ་མཆེད་དང་།",
    "འགོག་པའི་སྙོམས་པརའཇུག་པ་ལ་མི་མཁས་པའི་ཕྱིར་རོ།",
    "སྙོམས་པར་འཇུག་པ་ལམཁས་པ་ཡིན་ལ།",
    "ཟད་པར་གྱི་སྐྱེ་མཆེད་བཅུའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིསྙོམས་པར་འཇུག་པ་དང་ལྡན་པ་ནས།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པརའཇུག་པའི་བར་གྱི་སྙོམས་པར་འཇུག་བ་དང་ལྡང་བ་ལ་མཁས་པལ།",
    "གཞན་ཡང་ཏིང་ངེ་འཛིན་མཁས་ལ་སྙོམསཔར་འཇུག་པ་ལ་མི་མཁས་པ་ཡོད་དོ་ཞེས་གསུངས་པ་ནི།",
    "སྙོམས་པར་འཇུག་པ་ལམཁས་པ་ཡིན་ལ་ཏིང་ངེ་འཛིན་ལ་མི་མཁས་པ་ཇི་ལྟ་བུ་ཡིན་ཞེན།",
    "དེ་བཞིན་དུ་སྙོམས་པར་ཞུགས་ཀྱང་།",
    "བདག་ནི་ཏིང་ངེ་འཛིན་འདིདང་འདི་ལ་སྙོམས་པར་ཞུགས་སོ་ཞེས་ཏིང་ངེ་འཛིན་དེའི་མིངདང་།",
