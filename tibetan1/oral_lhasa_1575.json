    "ཐ་སྙད་དུ་ཡང་སྔ་མ་ལ་སོགས་པར་ཡང་ཤེས་པ་ནི་དུས་རྟག་པ་དང་།",
    "ཤེས་པ་ཡིན་པའི་ཕྱིར་དཔེར་ན་གཟུགས་ལ་སོགས་པར་ཤེས་པ་བཞིན་ནོ།",
    "བཏགས་པར་ཡོད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "ཇི་ལྟ་བུ་ཞེས་བརྗོད་པར་བྱའོ།",
    "དོན་དམ་པར་ཇི་སྐད་བསྟན་པའི་ཚུལ་གྱིས་གཟུགས་ལ་སོགས་པའི་དངོས་པོ་གྲུབ་པ་མེད་པས།",
    "ཤིང་རྟ་དང་དམག་དང་ནགས་ཚལ་ལ་སོགས་པ་རྫས་སུ་ཡོད་པ་མ་ཡིན་པ་དག་ལ་ཡང་མེད་ཀྱང་ཡོད་དོ་ཞེས་བཏགས་པར་ཡོད་པའི་ཕྱིར་གཏན་ཚིགས་མ་ངེས་པ་ཉིད་ཀྱང་ཡིན་ནོ།",
    "དུས་ལྟ་ཡོད་པར་ག་ལ་འགྱུར།",
    "ཞེས་བརྗོད་པར་བྱ་སྟེ།",
    "བརྗོད་པ་ཁྱད་པར་ཅན་འཇུག་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "འདི་ན་གང་མེད་པ་དེ་ནི་བརྗོད་པ་ཁྱད་པར་ཅན་འཇུག་པའི་རྒྱུ་ཉིད་ཡིན་པར་མ་མཐོང་སྟེ།",
    "དུས་ནི་སབ་མ་བྱས་སོ་བྱེད་དོ་བྱེད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ཁྱད་པར་ཅན་འཇུག་པའི་རྒྱུ་ཉིད་ཡིན་པར་མཐོང་བས་དེའི་ཕྱིར་དུས་ནི་ཡོད་པ་ཁོ་ན་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "བྱས་པ་ལ་སོགས་པའི་བརྗོད་པ་ཁྱད་པར་ཅན་འཇུག་པ་ནི།",
    "བརྗོད་པ་ཁྱད་པར་ཅན་འཇུག་པའི་རྒྱུ་ཉིད་ནི་ཀུན་རྫོབ་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "སྐྱེ་མཆེད་གང་ཡིན་པ་དེ་ནི་མི་གནས་པ་དང་ངེས་པར་མི་གནས་པར་རབ་ཏུ་ཤེས་ཏེ།",
    "འདི་ལྟར་འཇིག་རྟེན་ནི་སྐད་ཅིག་ལས་ལྷག་པར་མི་གནས་པའི་ཕྱིར་རོ།",
    "ངེས་པར་མི་གནས་པར་རབ་ཏུ་ཤེས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་དང་།",
    "ད་ལྟར་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་དེ་དག་གྲུབ་པ་ཡིན་ནོ།",
    "ད་ནི་དུས་ངོ་བོ་ཉིད་མེད་པ་ཉིད་དུ་བསྟན་པའི་མི་མཐུན་པའི་ཕྱོགས་ཀྱི་ཁྱད་པར་དགག་པས།",
    "རབ་ཏུ་བྱེད་པ་འདས་མ་ཐག་པར་དུས་མ་གྲུབ་པས་གཏན་ཚིགས་ཀྱི་སྐྱོན་བསྟན་པའི་ཕྱིར་དུས་གྲུབ་ན་སྐྱོན་མེད་པས།",
    "འདོད་པའི་དོན་འགྲུབ་པར་བསྟན་པའི་ཕྱིར་འདིར་སྨྲས་པ།",
    "དོན་དམ་པར་དུས་ནི་ཡོད་པ་ཁོ་ནར་ཤེས་པར་བྱ་སྟེ།",
    "གང་ཡོད་པ་མ་ཡིན་པ་དེ་ནི་འབྲས་བུ་འགྲུབ་པའི་རྒྱུ་ཉིད་ཡིན་པར་མ་མཐོང་བས།",
    "དེའི་ཕྱིར་གཏན་ཚིགས་ཇི་སྐད་སྨོས་པའི་མཐུས་དོན་དམ་པར་དུས་ནི་ཡོད་པ་ཁོ་ན་ཡིན་ནོ།",
    "དེའི་ཕྱིར་རྗེས་སུ་དཔག་པ་ནི་ས་བོན་ལ་སོགས་པ་ཚོགས་པ་ཉིད་ལ་འབྲས་བུ་མྱུ་གུ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡོད་པ་མ་ཡིན་པར་གཟུང་བར་བྱ་སྟེ།",
    "ཚོགས་པ་ཉིད་ལ་མྱུ་གུ་ཡང་དེ་བཞིན་པས་དེའི་ཕྱིར་ས་བོན་ལ་སོགས་པ་ཚོགས་པ་ཉིད་ལ་འབྲས་བུ་མྱུ་གུ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡོད་པ་ན་ཡིན་པར་གཟུང་། བར་བྱའོ།",
    "འདིར་གྲངས་ཅན་དག་ལས་ཁ་ཅིག་ཕྱིར་ཟློག་པར་བྱེད་དེ།",
    "ཡིད་ངེས་པར་མི་གནས་པ་དང་།",
    "འདི་ལྟར་རྗེས་སུ་དཔག་པ་ལས་རྒྱུ་ནི་འབྲས་བུས་མི་སྟོང་པར་གཟུང་བར་བྱ་སྟེ།",
    "མངོན་སུམ་གྱི་གཟུང་བ་ཉིད་མ་ཡིན་པས་མངོན་སུམ་ཁོ་ནས་གཟུང་དུ་མེད་པའི་ཕྱིར་རོ་ཞེས་གཏན་ཚིགས་ཁྱད་པར་དང་བཅས་པ་བརྗོད་ན་ཡང་གཏན་ཚིགས་ཀྱི་དོན་མ་ངེས་པ་ཉིད་དེ།",
    "འདིར་གཟུང་དུ་མེད་པ་ཁོ་ནའི་ཕྱིར་རོ་ཞེས་ངེས་པར་གཟུང་བའི་ཕྱིར།",
    "དོན་དམ་པར་ནི་ཧ་ཅང་ཐག་རིང་པོ་ན་གནས་པ་ལ་སོགས་པའི་དངོས་པོ་དག་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དེས་མི་སྟོང་བའི་ཕྱིར་དཔེར་ན་དབྱུ་གུ་གསུམ་ལས་དབྱུ་གུ་གསུམ་གྱི་བདག་ཉིད་བཞིན་པས་ཐ་སྙད་དུ་ཡང་རྒྱུ་ལས་འབྲས་བུ་སྔ་ན་ཡོད་པ་སྐྱེ་བར་དམ་འཆའ་ན་རྗེས་སུ་དཔག་པས་གནོད་པར་འགྱུར་རོ།",
    "མངོན་སུམ་གྱི་གཟུང་བ་ཉིད་མ་ཡིན་པས་མངོན་སུམ་ཁོ་ནས་གཟུང་དུ་མེད་པའི་ཕྱིར་རོ་ཞེས་གཏན་ཚིགས་ཀྱི་ཁྱད་པར་དང་བཅས་པ་བརྗོད་ན་ཡང་གཏན་ཚིགས་ཀྱི་དོན་མ་ངེས་པ་ཉིད་དེ་ཞེས་གོང་དུ་གཏན་ཚིགས་ཀྱི་སྦྱོར་བ་བྱས་པ་དེར་ཡང་།",
    "ཇི་སྐད་བསྟན་པའི་ཚུལ་གྱིས་རྗེས་སུ་དཔག་པ་ལས་དེ་ཡོད་པ་ཉིད་དུ་བསྟན་པར་མི་ནུས་པའི་ཕྱིར་དང་།",
    "ཆ་ཕྲ་བ་ཉིད་ཡིན་པར་བསྟན་དཀའ་བའི་ཕྱིར།",
    "འབྲས་བུའི་བདག་ཉིད་གསལ་བར་ཡོད་པ་ཉིད་མ་ཡིན་པ་ཉིད་སྐྱེའོ་ཞེས་ཟེར་བ་དེ་དག་དགག་པ་ཡང་སྔ་མ་བཞིན་དུ་རྒྱས་པར་བྱའོ།",
    "རྒྱུ་ཅན་མ་ཡིན་མཚུངས་པར་འགྱུར།",
    "ཇི་སྟེ་རྒྱུ་དང་རྐྱེན་རྣམས་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "ཆ་མཉམ་པ་བསྐྱེད་པ་ལ་སོགས་པ་དག་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཆ་མི་མཉམ་པ་སྐྱེད་པ་ལ་སོགས་པ་དག་ཡིན་པར་རིག་པར་བྱའོ།",
    "རྒྱུ་རྐྱེན་མ་ཡིན་མཚུངས་པར་འགྱུར།",
    "དོན་དམ་པར་ས་བོན་ལ་སོགས་པ་རྒྱུ་དང་རྐྱེན་རྣམས་ནི་འབྲས་བུ་བསྐྱེད་པ་མ་ཡིན་པ་ཉིད་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "གལ་ཏེ་འབྲས་བུ་ནི་རྒྱུ་དང་རྐྱེན་རྣམས་ཀྱིས་བསྐྱེད་པར་བྱ་བ་ཉིད་ཡིན་ཏེ།",
    "བརྒལ་ཞིང་བརྟག་པ་མཚུངས་པར་ཉེ་བར་གནས་པའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་ནི་མ་མཐོང་སྟེ།",
    "དོན་དམ་པར་དེའི་སྐྱེ་བ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "འབྲས་བུ་སྔ་ན་མེད་པར་སྨྲ་བ་རྣམས་ཀྱི་རྒྱུས་འབྲས་བུ་ལ་རྒྱུ་བྱིན་ནས་འགག་པར་འགྱུར་རམ།",
    "འོན་ཏེ་མ་བྱིན་པར་འགག་པར་འགྱུར།",
    "གལ་ཏེ་རྒྱུས་འབྲས་བུ་ལ་རྒྱུའི་ནུས་པ་ཕུལ་ནས་འགག་པར་འགྱུར་ན།",
    "འོན་ཏེ་མ་བྱིན་བར་འགག་པར་འགྱུར་ན།",
    "དེའི་ཕྱིར་ཡང་རྒྱུ་འགགས་པ་ནི་འབྲས་བུ་སྐྱེད་པར་མི་བྱེད་དེ།",
    "འདི་ལ་འགལ་བ་བསྒྲུབ་པ་མེད་པས་དོན་འདི་གཞན་ལ་བསྟན་པར་བྱ་མི་དགོས་སོ།",
    "གལ་ཏེ་ཚོགས་པ་ཉིད་དང་ལྷན་ཅིག་སྐྱེ་བཞིན་པས་འབྲས་བུ་སྐྱེད་པར་བྱེད་དེ།",
    "སྐྱེད་པ་དང་བསྐྱེད་པ་ཉིད་དག་ལ་རྒྱུ་དང་འབྲས་བུ་དག་ཡོད་པས་དེའི་ཕྱིར་རྗེས་སུ་དཔག་པར་ནུས་ཏེ།",
    "དགག་པ་རྒྱས་པར་སྔར་བསྟན་པའི་ཕྱིར།",
    "གལ་ཏེ་རྒྱུ་དང་རྐྱེན་རྣམས་ཀྱི་ཚོགས་པ་ཉིད་ཀྱི་སྔ་རོལ་དུ་དེ་དག་མེད་པར་དེ་ཡོད་པར་གྱུར་ན་ནི་དེ་ལྟར་ན།",
    "དེའི་ཕྱིར་ཁོ་བོ་ཅག་ལ་འབྲས་བུ་ཡོད་པ་ཉིད་དུ་བསྒྲུབ་པར་བྱ་བའི་གསལ་བ་ཡོད་པ་ཉིད་དུ་ནི་རྗེས་སུ་དཔག་པར་མི་བྱ་སྟེ།",
    "རྒྱུའི་བདག་ཉིད་ཡིན་པར་འདོད་ནའོ།",
