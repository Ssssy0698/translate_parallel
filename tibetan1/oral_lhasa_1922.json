    "ོ་༡༣༩པའོ་། མི་བརྗོད་པ་ནི་མི་མཐུན་པའི་ཕྱོགས་དང་གཉེན་པོའི་མཐའ་དེ་ལ་གཞན་དག་ཡང་དག་པར་འཛིན་དུ་མི་འཇུག་པའི་ཕྱིར་རོ།",
    "དེ་རྟག་ཅིཔར་ཡོད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཡོད་པ་ཉིད་དང་མེད་པ་ཉིད་ཀྱི་དབུས་རྫས་ཉིད་དང་དོན་དམ་པར་མེད་པ་ལ་བཏགས་པར་ཡོད་དོ་ཞེས་བྱ་བ་ནི་གཉི་གའི་མཚན་ཉིད་ཡིན་ནོ།",
    "དེའི་གཉེན་པོ་འདུས་མ་བྱས་ལ་གཟུང་བའོ།",
    "འདིར་རྒ་ཤིའི་བར་ལ་ཞེས་བྱ་བའི་མཐའ་སྨོས་པ་ནི་རྣམ་པར་ཤེས་པ་དང་།",
    "རྣམ་པར་ཤེས་པ་ལ་གཟུང་བའོ་འཛིན་པའོ་ཞེས་བྱ་བ་ཡང་མཐའོ།",
    "འདུ་བྱེད་རྣམས་ཀྱི་གཉེན་པོ་ནི་འདུས་མ་བྱས་ཀྱི་ཡེ་ཤེས་སོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འདུས་མ་བྱས་གཞན་ལས་དབྱེ་བའི་ཕྱིར་གཉེན་པོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "འདུས་མ་བྱས་རྣམ་པ་བརྒྱད་ཅར་ཡང་འདིར་འདོད་དོ།",
    "དེའི་ཕྱིར་འདིས་འགག་པར་བྱེད་པས་འགོག་པའོ།",
    "དེ་ལ་འདིས་མ་རིག་པ་ལ་སོགས་པ་འགག་པར་འགྱུར་བས་ན།",
    "ཡང་ན་རིག་པ་དང་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "མ་རིག་པ་དངོས་པོ་མེད་པར་མཚུངས་པས།",
    "འདུས་མ་བྱས་དང་།",
    "རྣམ་པར་ཤེས་པ་དང་།",
    "དེ་འགོག་པ་ནས་འགོག་པ་དང་རྒ་ཤི་ཞེས་བྱ་བའི་བར་དུ་བརྗོད་པར་བྱའོ།",
    "རིག་པ་དང་མ་རིག་པ་འདི་ནི་གཉིས་སུ་མེད་དེ་གཉིས་སུ་བྱར་མེད་པར་ཤེས་པ་དེ་ཉིད་དེའི་རིག་པ་བསྐྱེད་པར་བྱ་བ་ཡང་མེད་ཅིང་མ་རིག་པ་དགག་པར་བྱར་ཡང་མེད་པ་དང་།",
    "དེ་འགོག་པ་ཐོབ་པར་བྱ་བ་ཡང་མེད་པ་དེ་ལྟར་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་གཉིས་སུ་དབྱེར་མེད་པའོ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་བག་ཆགས་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་གནས་པའོ་ཞེས་ཟེར་རོ།",
    "ཡང་སྲིད་པར་སྨོན་པའི་གཉེན་པོ་ནི་སྨོན་པ་མེད་པ་ཤེས་པ་སྟེ།",
    "ཡང་སྲིད་པར་སྨོན་པ་དང་བྲལ་བའམ།",
    "སྐྱེས་པའི་སེམས་དང་སེམས་ལས་བྱུང་༧༨ ༥དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ཐོབ་པ་རྣམས་ཀྱི་ནི་འཆི་བའི་སྲིད་པ་དེ་ཉིད་ཀྱི་འོག་ཏུ་སྐྱེ་བའི་སྲིད་པའོ།",
    "རྣམ་པ་བདུན་དུ་ཐ་དད་པར་གྱུར་པ་དེ་དག་དང་བྲལ་བ་ནི་རྣམ་པར་བྱང་བ་སྟེ།",
    "ལམ་དང་མྱ་ངན་ལས་འདས་པ་ནི་རྣམ་པར་བྱང་བ་སྟེ།",
    "དེ་ལྟར་ཚིག་རྣམ་པར་སྦྱར་བ་ཐ་དད་པའི་ཕྱིར།",
    "དེ་བཞིན་ཉིད་ལ་སོགས་པ་ནི་རྣམ་པར་བྱང་བའོ་སྙམ་དུ་སེམས་སོ།",
    "ཅི་རིགས་པར་ཞེས་བྱ་བ་ལ།",
    "སྨོན་པ་མེད་པ་ཤེས་པས་ཤེས་བྱ་སྨོན་པར་མི་བྱེད་དེ།",
    "སྨོན་པའི་སྟོང་པ་ཉིད་ནི་རང་བཞིན་གྱིས་སྨོན་པ་མེད་པའི་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "སྐྱེ་བ་མེད་པ་ཤེས་པས་ཤེས་བྱ་སྐྱེ་བ་མེད་པར་མི་བྱེད་དེ།",
    "ངོ་བོ་ཉིད་མེད་པར་ཤེས་པས་ཤེས་བྱ་ངོ་བོ་ཉིད་མེད་པར་མི་བྱེད་དེ།",
    "སྟོང་པ་ཉིད་ཤེས་པ་ལ་སོགས་པས་སྟོང་པ་ཉིད་དུ་མི་བྱེད་ཀྱི་ཤེས་པར་བྱ་བ་ཉིད་དོ།",
    "དེ་ལ་ལྟ་བ་རྣམས་ནི་སྟོང་པ་ཉིད་ཤེས་པས་སྟོང་པར་མི་བྱེད་དེ།",
    "སོགས་པའི་རྒྱུ་ནི་མཚན་མ་མེད་པ་ཤེས་པས་མཚན་མ་མེད་པར་མི་བྱེད་དེ།",
    "དེ་བཞིན་དུ་ཡང་སྲིད་པའི་རྒྱུན་ནི་ངོ་བོ་ཉིད་མེད་པར་ཤེས་པས་ངོ་བོ་ཉིད་མེད་པར་མི་བྱེད་པའི་བར་དུ་སྟེ།",
    "ཁོརྣམ་པར་དག་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "སྒྲོ་བཏགས་པ་དང་སྐུར་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "གང་རྟག་ཏུ་འདས་པའི་རྣམ་པར་རྟོག་པའི་རབ་ཏུ་དབྱེ་བ་དེ་ལས་འདི་ནི་གཞན་ཡིན་ཏེ་རྣམ་པར་རྟོག་པའི་མཐའ་ཀྱིགཉིས་རྣམ་པ་བདུན་ནོ།",
    "རྣམ་པར་རྟོག་པའི་རབ་ཏུ་དབྱེ་བ་བསྟན་པའི་ཕྱིར།",
    "དངོས་པོ་ཡོད་པར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ།",
    "དངོས་པོ་མེད་པར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ་ཞེས་པ་ིསྨོས་ཏེ།",
    "ཡང་ན་གང་ཟག་མེད་པའི་ཕྱིར་བདག་མེད་པ་ཡང་མེད་པར་འགྱུར་ཏེ།",
    "བདག་མེད་པ་ཡང་མེད་པར་ཤེས་པར་བྱའོ་ཞེ་ན།",
    "དེ་མེད་པ་ཡང་རྣམ་པར་རྟོག་པའི་མཐའོ།",
    "འོད་སྲུངས་གང་ཟག་རྣམ་པར་གཞིག་པའི་ཕྱིར།",
    "རྣམ་པར་བྱང་བའི་གང་ཟག་བསྐྱེད་པར་བྱ་བའི་ཕྱིར་སྟོང་པ་ཉིད་མ་ཡིན་གྱི་གང་ཟག་བསྐྱེད་པར་བྱ་བ་དང་།་",
    "གཞིག་པར་བྱ་བའི་དངོས་པོ་མེད་པའི་ཕྱིར།",
    "དུས་གསུམ་ཆར་དུ་ཡང་དེ་བཞིན་དུ་ཡོད་པར་བསྟན་པའོ།",
    "མི་སློབ་པའི་དུས་དག་ནའང་དེ་བཞིན་དུ་ཡོད་པར་བསྟན་པ་སྟེ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་ཡུལ་ཡིན་པར་བསྟན་ཏོ།",
    "ཞི་བར་བྱ་བར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ།་།",
    "སྤང་བར་བྱ་བ་དང་སྤོང་བར་བྱེད་པར་རྟོག་པས་སྟོང་པ་ཉིད་ཀྱིས་སྐྲག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེའི་ཕྱིར་གང་ཟག་སྤང་བར་བྱ་བ་མ་ཡིན་པར་འགྱུར་རོ།",
    "ཀུན་བརྟགས་པའི་ངོ་བོའི་གཟུགས་ལ་སོགས་པ་དེ་དག་བདག་བཞིན་དུ་རང་བཞིན་གྱིས་མེད་པར་མ་ཤེས་ནས་སྟོང་པ་ཉིད་ཀྱིས་སྐྲག་གོ།",
    "དེ་བས་ན་རྣམ་པར་རྟོག་པའི་མཐའ་དེ་གཉིས་ཡོངས་སུ་སྤང་བར་བྱ་བའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་དེ་ནི་རྔོ་མི་ཐོགས་ཀྱི་ལགས་སོ།",
    "དེ་ནི་འདི་སྐད་དུ་བསྟན་པར་འགྱུར་ཏེ།",
    "སྐྲག་པར་བྱ་བར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ།",
    "སྐྲག་པར་བྱ་བ་དེ་ལས་འཇིགས་པར་རྣམ་པར་རྟོག་པ་ཡང་མཐའ་སྟེ།",
    "གང་ལ་འཇིགས་པར་འགྱུར་བ་དེ་ནི་སྐྲག་པར་འགྱུར་བའོ་ཞེས་བྱའོ།",
    "ཅི་༡༣༩དེ་དང་འཇིགས་པ་དེ་ལ་གང་རྣམ་པར་རྟོག་པ་དེ་ནི་མཐའ་སྟེ།་",
    "དེ་དག་ལ་མི་འདོད་པའི་འབྲས་བུ་འཇིགས་པར་རྣམ་པར་རྟོག་གོ།",
    "དེའི་མཚན་མ་རྣམས་ཀྱིས་འཇིགས་ཤིང་སྐྲག་པར་འགྱུར་རོ།",
    "རིགས་མཐུན་པར་སྐད་ཅིག་ཀྱང་མི་གནས་པའི་ཕྱིར་རོ།",
    "གཟུང་བར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ།",
    "འཛིན་པར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ།",
    "འབྲས་བུས་ཤེས་པར་བྱར་ཡོད་བཞིན་དུ།",
    "རྣམ་པར་རྟོག་པའི་མཐའ་དེ་གཉིས་ཡོངས་སུ་སྤང་བའི་ཕྱིར།",
    "ཇི་ལྟར་འདིས་རྣམ་པར་རྟོག་པའི་མཐའ་འདི་གཉིས་ཡོངས་སུ་སྤོང་ཞེ་ན།",
    "ཝི་༡༣༩མེད་པར་ཤེས་པར་བྱས་ནས།",
    "དོན་དངོས་པོ་མེད་པར་ཤེས་པ་དེས་ཀྱང་རྣམ་པར་རིག་པ་ཙམ་དུ་ཤེས་པ་དེ་ཉིད་རྣམ་པར་བཟློག་གོ།",
    "དོན་དངོས་པོ་མེད་ན་རྣམ་པར་ཤེས་པ་མི་སྲིད་པའི་ཕྱིར་ཏེ།",
    "སྒྱུ་མ་བྱེད་པ་ལྟ་བུ་ནི་རྣམ་པར་རིག་པ་ཙམ་དུ་ཤེས་པའོ།",
    "སྤྲུལ་པའི་གནོད་སྦྱིན་ལྟ་བུ་ནི་དོན་དངོས་པོ་མེད་པར་ཤེས་པ་སྟེ།",
    "དོན་དངོས་པོ་མེད་པར་ཤེས་པ་ནི་རྣམ་པར་རིག་པ་ཙམ་དུ་ཤེས་པས་རབ་ཏུ་ཕྱེ་བའི་ཕྱིར་རོ།",
    "དོན་དངོས་པོ་མེད་པར་ཤེས་པས་ཀྱང་རྣམ་པར་རིག་པ་ཙམ་དུ་ཤེས་པ་དེ་ཉིད་ཟོས་ཏེ།",
    "དོན་ལ་དམིགས་པ་ནི་རྣམ་པར་རིག་པ་ཞེས་བྱ་བས།",
    "དོན་མེད་ན་རྣམ་པར་རིག་པ་ཙམ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "ཡང་དག་པ་ཉིད་དུ་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ།",
    "ལོག་པ་ཉིད་དུ་རྣམ་པར་རྟོག་པ་ཡང་མཐའ་སྟེ།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པའི་དུས་ན་ཡང་དག་པར་སོ་སོར་རྟོག་པ་ན་ཡང་དག་པ་ཉིད་དུའམ།",
    "ཡང་དག་པར་སོ་སོར་རྟོག་པར་མི་འགྱུར་རོ།",
    "བྱུང་མ་ཐག་ཏུ་ཤིང་དེ་གཉིས་ཚིག་པར་བྱེད་པ་དེ་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "སྐྱེས་མ་ཐག་ཏུ་ཡང་དག་པར་སོ་སོར་རྟོག་པ་ཉིད་ཚིག་པར་བྱེད་དོ་ཞེས་འབྱུང་ངོ།",
    "བྱུང་ནས་ཀྱང་ཤིང་གཉིས་ཚིག་པར་བྱེད་དོ།",
    "དེ་བཞིན་དུ་ཡང་དག་པ་ཉིད་ཀྱི་༧མཚན་ཉིད་མ་ཡིན་པ་ཡང་དག་པར་སོ་སོར་རྟོག་པ་ལས།",
    "སྐྱེས་ནས་ཀྱང་ཡང་དག་པར་སོ་སོར་རྟོག་པ་ཉིད་ཚིག་པར་བྱེད་དེ།",
    "རྣམ་པར་འཇིག་པར་བྱེད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གྱུར་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "ཡང་དག་པར་སོ་སོར་རྟོག་པ་ིའདི་ཟག་པ་དང་བཅས་པ་ཡིན་ཡང་།",
    "ཡང་དག་པ་ཉིད་ཀྱི་རྗེས་སུ་མཐུན་པའི་ཕྱིར་ཡང་དག་པར་སོ་སོར་རྟོག་པ་ཞེས་བྱ་བར་སྟོན་ཏོ།",
    "བྱེད་པར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ།",
    "མི་བྱེད་པར་ིརྣམ་པར་རྟོག་པ་ཡང་མཐའ་སྟེ།",
    "མཐུ་མེད་པར་རྟོག་པའོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "གལ་ཏེ་ཡེ་ཤེས་འདིས་མི་ཤེས་པ་སྤོང་ངོ་སྙམ་དུ་རྟོགས་ནས་དེ་སྤང་བའི་ཕྱིར་འཇུག་གོ་ཞེས་བྱ་བ་འདི་ནི་བྱེད་པའི་རྣམ་པར་རྟོག་པའི་མཐའོ།",
    "དེ་བས་ན་མི་ཤེས་པ་སྤང་བའི་མཐུ་མེད་དོ་ཞེས་བྱ་བ་འདི་ནི་མི་བྱེད་པར་རྣམ་པར་རྟོག་པའི་མཐའོ་། རྣམ་པར་རྟོག་པའི་མཐའ་དེ་གཉིས་ཡོངས་སུ་སྤང་བའི་ཕྱིར་དཔེ་མར་མེ་སྟེ།",
    "དཔེར་ན་མར་མེ་བྱུང་ན་མུན་པ་མུན་ནག་ཐམས་ཅད་མེད་པར་འགྱུར་ཡང་།",
    "འོན་ཀྱང་མར་མེ་ལ་བརྟེན་ནས་མུན་པ་མུན་ནག་མེད་པར་འགྱུར་བ་དེ་བཞིན་དུ།",
    "འོད་སྲུངས་ཡེ་ཤེས་སྐྱེས་ན་ནི་མི་ཤེས་པ་མེད་པར་འགྱུར་ཏེ།",
    "འདི་སྐད་དུ་བསྟན་པར་འགྱུར་ཏེ།",
    "ཕྱོགས་གང་དུ་བྱུང་བའི་ཕྱོགས་དེར་མར་མེ་ཡོད་པ་ཙམ་གྱིས་མུན་པ་མུན་ནག་ཐམས་ཅད་མེད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་རྒྱུད་གང་ལ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་སྐྱེས་པར་གྱུར་ན་དེ་ཡོད་པ་ཙམ་གྱིས་རྒྱུད་དེ་ལས་མི་ཤེས་པ་མེད་པར་འགྱུར་ཏེ།",
    "ཡེ་ཤེས་ནི་རྣམ་པར་མི་རྟོག་པ་དང་།",
    "སྐྱེ་བ་མེད་པར་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ།",
    "དུས་མཉམ་པ་ཉིད་དུ་རྣམ་པར་རྟོག་པ་ཡང་མཐའོ།",
    "དེ་ལྟར་དུས་ཇི་སྲིད་དུ་སྔོན་གཉེན་པོ་མ་སྐྱེས་པ་དེ་བཞིན་དུ་ད་ཡང་མི་སྐྱེའོ་སྙམ་པ་འདི་ནི་སྐྱེ་བ་མེད་པར་རྟོག་པའི་མཐའོ།",
    "གདོན་མི་འཚལ་བར་མ་མཆིས་པར་འགྱུར་རོ།",
    "མཐའ་གཉིས་སྤངས་པ་སྒྲུབ་པའི་འོག་ཏུ་ཁྱད་པར་ཅན་དང་ཁྱད་པར་མེད་པ་སྒྲུབ་པ་སྨོས་པས།",
    "ཁྱད་པར་མེད་པ་སྒྲུབ་པ་གང་ཞེ་ན་ཞེས་དྲིས་པ་དང་།",
    "ཁྱད་པར་ཅན་དང་ཁྱད་མེད་ནི།",
    "སེམས་ཙམ། ། ༡༣༩པར་བྱ།",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
    "གཞན་དག་པས་ཤས་ཆེར་གྱུར་པས་ན་ཁྱད་པར་ཅན་ཞེས་བྱ་སྟེ།",
