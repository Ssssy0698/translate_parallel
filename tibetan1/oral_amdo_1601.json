    "ལུས་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "སྐྱེ་བའི་ཀུན་ནས་ཉོན་མོངས་པ་སྟེ།",
    "དེ་བས་ན་བག་ཆགས་དང་བཅས་བའི་ཉོན་མོངས་པ་དད་ལས་དང་མི་ཤེས་པ་བསལ་ཞིང་སྤང་བར་བྱ་བའི་ཕྱིར་ཏེ།",
    "ཞེས་བྱ་བ་ནི་གང་གི་བསམ་པ་ཆུང་དུ་དང་།",
    "ཐུན་མོང་གི་ཚུལ་གྱིས་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གསོལ་ནས་ཐལ་མོ་སྦྱར་བྱས་ཏེ།",
    "ཡངས་པ་ནི་དཔྲལ་བའི་མཐར་ཐུག་གི་བར་དུ་ཞལ་གྱི་དཀྱིལ་འཁོར་རབ་ཏུ་ཁེབས་པ་སྟེ།",
    "ཉོན་མོངས་པ་དང་།",
    "ཡང་ན་ངན་སོང་གསུམ་གྱི་རྒྱུ་འདོད་ཆགས་དང་།",
    "ཡང་ན་ངན་སོང་གསུམ་གྱི་རྒྱུར་གྱུར་པ་བདག་དང་།",
    "ཚངས་པའི་གསུང་ནི་ཇི་ལྟར་ཡུལ་ཉེ་བར་གནས་པ་དག་གིས་ཐོས་པ་དེ་བཞིན་དུ་ཕྱི་རོལ་གྱི་ཡུལ་ཐག་རིང་བ་འཇིག་རྟེན་གྱི་ཁམས་རྣམས་ཀྱིས་ཀྱང་ཐོས་ཏེ།",
    "འགྲོ་ལ་ཕན་པའི་དོན་དུ་ཁྱོད།",
    "ལག་ན་རྡོ་རྗེ་ཁྱོད་ལེགས་སོ།",
    "དེ་ལྟ་བུའི་ཡོན་ཏན་གྱིས་ཕུལ་དུ་བྱུང་བ་དང་ལྡན་པའི་མཚན་ཡང་དག་པར་བརྗོད་པ་གང་གི་ཡིན་ཞེ་ན།",
    "ཁྱོད་ལ་ལེགས་པར་བསྟན་པར་བྱ།",
    "ཁྱོད་ནི་རྩེ་གཅིག་ཡིད་ཀྱིས་ཉོན་། བཅོམ་ལྡན་དེ་ནི་ལེགས་ཞེས་གསོལ།",
    "ཀྱེ་གསང་བའི་བདག་པོ་ཁྱོད་རྩེ་གཅིག་པའི་ཡིད་ཀྱིས་ཉོན་ཅིག་ཅེས་པ་སྟེ།",
    "ཚིག་གི་བདག་པོས་ཚིགས་སུ་བཅས་པ་འདི་གསུངས་པ་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "གསང་སྔགས་རིག་སྔགས་འཆང་བའི་རིགས་ནི་དེའི་རྒྱུད་ལ་གཟིགས་པའོ།",
    "རྣམ་པར་གཟིགས་པ་ནི་ངེས་པར་རྟོག་པར་མཛད་པ་སྟེ།",
    "འཚམ་པ་དང་མི་འཚམ་པ་དང་སྐལ་བ་དང་ལྡན་ནམ་མི་ལྡན་ཞེས་རང་གི་ངོ་བོ་ལ་ངེས་པར་རྟོག་པར་མཛད་པ་ནི་གཟིགས་པ་ཐམས་ཅད་ལ་དགོས་པ་ཡིན་པར་བལྟའོ།",
    "རིགས་ཆེན་གཙུག་ཏོར་ཆེར་གཟིགས་ནས།",
    "ཞེས་བྱ་བ་ལ་ཕྱག་རྒྱ་ཆེན་པོ་ནི་སྤྱན་ལ་སོགས་པ་རིག་པའི་རྒྱལ་མོ་རྣམས་སོ།",
    "ཚིག་གི་བདག་པོས་ཚིགས་སུ་བཅད།",
    "ཚིག་གི་བདག་པོས་ཚིགས་སུ་བཅས།",
    "ཁ་ཅིག་གཞན་དུ་ཡང་འཆད་མོད་ཀྱི་བཅོམ་ལྡན་འདས་ཀྱིས་རྟོན་པ་བཞི་གསུངས་ཏེ།",
    "ཚིག་འབྲུ་ཞེས་བྱ་བ་ནི་གང་ཞི་གནས་དང་ལྷག་མཐོང་གི་ཚོགས་བསྟན་པའོ།",
    "གཞན་ཡང་རྣམ་པར་ཤེས་པ་ནི་གང་མིག་གི་རྣམ་པར་ཤེས་པར་བྱ་བའི་གཟུགས་རྣམས་ལ་རྣམ་པར་རིག་པ་དང་།",
    "ལུས་ཀྱིས་ཤེས་པར་བྱ་བའི་རེག་བྱ་རྣམས་དང་།",
    "བདག་དང་བདག་གི་འམ།",
    "རང་གི་མཚན་ཉིད་ཀྱིས་ཕུང་པོ་དང་ཁམས་ལ་སོགས་བ་འདུས་བྱས་དང་འདུས་མ་བྱས་རྣམས་ཀྱི་རང་གི་མཚན་ཉིད་དང་སྤྱིའི་མཚན་ཉིད་རྣམ་པར་གནས་པ་ནི་མ་ཡིན་ཏེ།",
    "ཐམས་ཅད་དུ་སོང་བ་གཅིག་པར་བལྟ་བར་བྱ་བ་སྟེ།",
    "དངོས་པོ་རྣམས་སྐྱེ་བར་གྱུར་པ་ན་རང་གི་ངོ་བོ་ཉིད་དུ་གྱུར་པའི་རྒྱུ་ལས་སམ།",
    "མ་སྐྱེས་ཕྱིར་ཡང་གང་གི།",
    "བ་ལོང་གི་རྭ་ལྟོས་པའམ།",
    "རང་གི་ངོ་བོ་མ་བྱུང་བར།",
    "རྐྱེན་གཞན་གྱིས་ཀྱང་དོན་དམ་པར་མིག་ལ་སོགས་པས་མིག་གི་རྣམ་པར་ཤེས་པ་བསྐྱེད་པ་མ་ཡིན་ཏེ།",
    "རྟག་ཏུ་ཡོད་པ་དང་མེད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཤིན་ཏུ་གཟུགས་མེད་པ་རི་བོང་གི་རྭ་ལ་སོགས་པ་དང་འདྲ་ཞིང་།",
    "གཞན་དུ་འདི་དག་ཐམས་ཅད་མེད་པར་འགྱུར་ཞིང་གང་གི་ཕྱིར་དངོས་པོའི་ཕྱོགས་གང་ཡང་རུང་བ་འགའ་ཞིག་ལས་ཀྱང་དངོས་པོ་ཐམས་ཅད་རྟག་ཏུ་འགྱུར་བས་རྒྱུ་དང་འབྲས་བུ་ངེས་པ་མེད་པར་འགྱུར་རོ།",
    "དེ་བས་ན་ཐམས་ཅད་ལས་ཐམས་ཅད་དུ་སྐྱེ་བར་ཐལ་བར་འགྱུར་བ་བཟློག་དཀའ་བར་འགྱུར་བ་དང་།",
    "མེད་ན་གང་གི་རྐྱེན་དུ་འགྱུར།",
    "ཇི་ལྟར་དངོས་པོ་འགའ་ཞིག་གི་འབྲས་བུའི་ཁྱད་པར་དག་ཀྱང་དེ་དང་ཐ་མི་དད་པ་ཉིད་སྣ་ཚོགས་པར་མི་འགྱུར་ཏེ།",
    "རྣམ་པར་དབྱེ་བ་གང་གིས་བྱས།",
    "སྨྲས་པའི་ཉེས་པར་ཐལ་འགྱུར་བས།",
    "དེ་ལྟ་ནི་འོན་པ་དང་ལོང་བ་ལ་སོགས་པར་ཐལ་བར་འགྱུར་མིག་ལ་སོགས་པ་དང་ལྡན་ཅིག་འབྱུང་པའི་སྐད་ཅིག་ཕྱི་མས་བསྐྱེད་པའི་རྣམ་པར་ཤེས་པ་མི་འབྱུང་པོ།",
    "རྣམ་པར་ཤེས་པས་བསྐྱེད་པ་ཉིད་ཡིན་ན་ནི་རང་གི་ཆ་སྐད་ཅིག་མ་ཕྱི་མ་དང་མ་ཕྲད་པས་སྐད་ཅིག་མ་གཉིས་པ་ལ་མིག་ལ་སོགས་པ་མེད་པའི་ཕྱིར་རོང་བ་ལ་སོགས་པ་དེ་ཉིད་དུ་ཐལ་བ་ནི་བཟློག་བར་དགའོ།",
    "དེ་ཡང་བ་ལང་གི་རྭ་གཡས་གཡོན་རྒྱུ་དང་འབྲས་བུར་འདོད་པ་ནི་མི་རིགས་ཏེ།",
    "གལ་ཏེ་རྒྱུའི་རང་བཞིན་ཉིད་ཡིན་ན་ནི་དེ་ཉིད་རྒྱུ་དང་འབྲས་བུ་ལྷན་ཅིག་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་མོད་ཀྱི་དེའི་ངེས་པའི་ཐབས་གང་ཞིག་ཡོད་དེ།",
    "གང་གི་ཕྱིར་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པས་བསྒྲུབས་ནས་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོར་བརྗོད་པར་བྱའོ་ཞེན།",
    "ནམ་མཁའ་ལ་བྲིས་པའི་རི་མོ་དང་གཅིག་པ་ཉིད་དུ་གྱུར་པ་སྟེ།",
    "རིང་དུ་སོང་བ་ལ་ནི་ཐབས་ཀྱི་ཕ་རོལ་ཕྱིན་པ་ལ་སྤྱོད་པ་ཡིན་པས་ཨེ་སྟེ།",
    "མུ་ཁྱུད་ཀྱི་ནང་གི་ལྟེ་བ་ལ་ནི་ཨོཾ་མུ་ཨོཾ་ཞེས་བྱའོ།",
    "དེ་ལྟ་བུ་ནི་རེ་ཞིག་རྩིབས་དྲུག་པའི་འཁོར་ལོ་གཅིག་ཡིན་ནོ།",
    "གཞན་ཡང་མན་ངག་ལས་བརྒྱུད་པའི་འཁོར་ལོ་མང་དུ་ཡོད་མོད་ཀྱི།",
    "ཡང་ན་བདུད་བཞི་བཅོམ་པས་ན་ངེས་པའི་ཚིག་གི་ཚུལ་གྱིས་ཡི་གེ་བཱན་གྱིས་ན་བཅོམ་ལྡན་འདས་ཞེས་ཟེར་རོ།",
    "འོ་ན་ཇི་ལྟར་ན་དེ་བསྒོམས་པའི་སྟོབས་ཀྱིས་གསུང་གི་འཁོར་ལོ་རྫོགས་པར་འགྱུར་ཞེས་རྟོག་པ་ལ།",
    "ཚིག་ཐམས་ཅད་རབ་ཏུ་གསལ་བར་བྱེད་པའི་གསུང་གི་འཁོར་ལོའི་རྒྱུར་གྱུར་པའི་ཕྱིར་བརྗོད་པ་ཐམས་ཅད་ཀྱི་རྒྱུའི་མཆོག་ཡིན་ནོ།",
    "སོ་སོར་རང་གི་རིག་པའི་མཆོག་ཏུ་དགའ་བ་གཉིས་སུ་མེད་པའི་བདེ་བ་ཆེན་པོའི་ངོ་བོ་ཉིད་ཡིན་པས་ན་ཚིགས་ཏུ་བརྗོད་པ་སྤངས་པའོ།",
    "ཉོན་མོངས་ཀུན་གྱི་དགྲ་ཆེ་བ།",
    "དེས་ལྷའི་ལོ་སྟོང་གི་བར་དུ་འཁྲིག་པ་ཆེན་པོ་སྤྱད་ཀྱང་ཅུང་ཟད་ཙམ་ངོམས་པར་མ་བྱས་ཏེ།",
    "འོག་གི་ཕྱོགས་ན་གནས་པ་ལ་ཞལ་དང་པོ་དང་།",
    "ཡང་བཅོམ་ལྡན་འདས་ནི་བདག་དང་གཞན་གྱི་རྒྱུད་དུ་གཏོགས་པའི་ཉོན་མོངས་པ་ཅན་གྱི་དགྲ་བོའི་སྟོབས་འཇོམས་པར་མཛད་པས།",
    "ཉོན་མོངས་ཀུན་གྱི་དགྲ་ཆེ་བ།",
    "བ་སྦུའི་བུ་ག་ཐམས་ཅད་ནས་བྱུང་བའི་རྡོ་རྗེ་མེ་ལྟར་འབར་བའི་རྩེ་མོ་རྣམས་ཀུན་དུ་འབར་བས་ཁམས་གསུམ་ཐལ་བར་བྱས་ཏེ།",
    "ཉོན་མོངས་ཀུན་གྱི་དགྲ་ཆེ་བ།",
    "གཏི་མུག་ལས་བྱུང་བའི་སྲོག་ཆགས་ལ་འཚེ་བ་དང་ཉེ་བར་ལྡན་པའི་མཆོད་སྦྱིན་སྟོན་པས་རང་གི་རྒྱུད་དུ་གཏོགས་པའི་གཏི་མུག་གིས་ཀུན་དུ་རྨོངས་པའི་ཕྱིར་རོ།",
    "རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "བདག་གིར་ཤིན་ཏུ་ཆགས་པ་དང་།",
    "རྒྱལ་པོའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "རང་གི་ངོ་བོ་ཉིད་ལས་ཐ་དད་པའི་ནུས་པས་ནི་བདེ་བར་གཤེགས་པ་རྣམས་ཀྱི་བསྟན་པ་ལ་མེད་དེ།",
    "ངོ་བོ་ཉིད་མེད་ཅིང་སྒྱུ་མ་ལྟ་བུར་ལྷག་པར་མོས་པས་ནི་ཐམས་ཅད་ལེགས་པར་གནས་པ་ཡིན་ནོ།",
    "ཡང་ན་བདེ་བ་ཆེན་པོ་ནི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཚུལ་གྱིས་ལྷ་མོ་ཐམས་ཅད་ལ་རོལ་བར་མཛད་པས་དེ་རྣམས་ཀྱི་འདོད་པར་བྱ་བ་ཡིན་པས་དེ་ནི་འདོད་པ་ཆེན་པོ་སྟེ།",
    "འདྲེན་མའི་ཁ་དོག་གི་ཤིན་ཏུ་འབར་བས་ན་ཁ་དོག་ཆེན་པོ་སྟེ།",
    "རང་གི་འོད་ཀྱིས་ལྷ་ལ་སོགས་པའི་མདངས་ཟིལ་གྱིས་གནོན་པས་ན་ལུས་བོང་ཆེན་པོ་མངའ་བ་སྟེ།",
    "ཉོན་མོངས་ཆེན་པོ་ལྕགས་ཀྱུ་མཆོག།",
    "ཉེ་བར་དམིགས་པ་ལ་སོགས་པའི་ཉོན་མོངས་པ་སེལ་བར་བྱེད་པས་ན་མཚོན་ནོ།",
    "ཕྱི་དང་ནང་གི་གྲངས་པ་དང་ཡེ་ཤེས་ཀྱི་བྱེ་བྲག་གིས་ཁྱད་པར་དུ་གྱུར་པ་རབ་ཏུ་བསྟན་པའི་ཕྱིར།",
    "ཤེས་རབ་དང་རྟོགས་པ་དང་ཡེ་ཤེས་ཀྱི་ཤིན་ཏུ་ཕུལ་དུ་བྱུང་བས་ཁྱད་པར་དུ་འཕགས་པའི་ཕྱིར་གྲགས་པ་ཆེན་མོ་མངའ་བས་ན་གྲགས་ཆེན།",
    "ནང་གི་སེམས་ཀྱི་སྣང་བ་དང་ལྡན་པའི་ཚུལ་ཅན་བས་སྣང་བ་ཆེན་མོའོ།",
    "ད་ནི་ས་བཅུ་ལ་བཞུགས་ཤིང་སྦྱིན་པ་ལ་སོགས་པ་ཕ་རོལ་ཏུ་ཕྱིན་པ་བཅུའི་ཡོན་ཏན་གྱི་རང་གི་ངོ་བོས་ཤིན་ཏུ་ཕུལ་དུ་བྱུང་བའི་བདག་ཉིད་ཆེན་པོས་ཁྱད་པར་དུ་འཕགས་པར་བསྟན་པའི་ཕྱིར།",
    "ཉོན་མོངས་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པའི་ལྷའི་སྤྱན་ཡོངས་སུ་གཟིགས་པར་བྱ་བའི་ཕྱིར་མར་འདོད་པ་རྣམས་ལ་མར་མེ་སྦྱིན་པའོ།",
    "དེ་བཞིན་གཤེགས་པའི་ལྷའི་སྙན་ཡོངས་སུ་དག་པར་བྱ་བའི་ཕྱིར་རོལ་མོས་སྒྲ་འདོད་པ་རྣམས་ལ་རོལ་མོའི་སྒྲ་སྦྱིན་པའོ།",
    "དེ་བཞིན་གཤེགས་པའི་གཟིགས་ཆ་ཐོབ་པར་བྱ་བའི་ཕྱིར་མལ་ཆ་འདོད་པ་རྣམས་ལམ་ལ་ཆ་སྦྱིན་པའོ།",
    "བསམ་གཏན་གྱི་ཡན་ལག་དང་ཡན་ལག་གི་ཚོགས་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར།",
    "རྩེད་མོ་ཐམས་ཅད་གཏོང་བའི་སྦྱིན་པའོ།",
    "གཏི་མུག་གི་བསམ་པས་སྦྱིན་པ་མེད་དོ།",
    "ཕྱིན་ཅི་ལོག་གི་བསམ་པས་སྦྱིན་པ་མེད་དོ།",
    "ལན་ལ་རེ་བའི་སྦྱིན་པ་མེད་དོ།",
    "གཞན་གྱི་རེ་བ་ལ་བབ་པའི་སྦྱིན་པ་མེད་དོ།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ལ་རེ་བའི་སྦྱིན་པ་མེད་དོ།",
    "བདག་གི་ལག་མ་བདར་བའི་སྦྱིན་པ་མེད་དོ།",
    "སྦྱིན་པ་དེ་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་དང་མ་འདྲེས་པ་སྟེ།",
    "བདག་གི་འཁོར་གྱིས་ཆོག་པར་འཛིན་པས་ཕྲ་མ་མེད་པ་དང་།",
    "ངན་དུ་སྨྲ་བའི་ཚིག་གི་ལམ་བཟོད་པས་གནོད་སེམས་མེད་པ་དང་།",
    "གང་ལ་མིག་གི་མཚན་མར་སྒྲོ་བཏགས་པ་མེད་པ་དང་།",
    "འཐབ་མོ་མེད་པས་བཟོད་པར་བལྟའོ།",
    "རང་གི་སེམས་ལ་ངེས་པར་སེམས་པས་བཟོད་པར་བལྟའོ།",
    "རང་གི་ཡོན་ཏན་ཡོངས་སུ་རྫོགས་པའི་ཕྱིར་བསྔགས་པ་མ་ཡིན་པས་ཁོང་ཁྲོ་བར་མི་འགྱུར་པ་དང་།",
    "ཅི་བདག་གི་མིག་གཤེ་འམ་ཞེས་བཟོད་པའམ།",
    "དེ་བཞིན་དུ་ཅི་བདག་གི་རྣ་བ་དང་།",
    "བདག་ནི་ཉོན་མོངས་པ་ཟད་པ་ལ་བཟོད་ཀྱི་ཉོན་མོངས་པ་ལ་བདག་མི་བཟོད་དོ།",
    "བདག་ནི་རྣམ་པར་བྱང་བ་ལ་བཟོད་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པ་ལ་བདག་མི་བཟོད་དོ།",
    "གང་ཉོན་མོངས་པ་ཟད་པར་རྟོགས་པ་དེ་ལ་ཉོན་མོངས་པ་བསལ་བ་ཡང་མེད།",
    "ཉོན་མོངས་པ་ཟད་པར་སྒྲོ་འདོགས་པ་ཡང་མེད་དེ།",
    "ཉོན་མོངས་པ་ཉིད་སྟོང་པ་སྟེ།",
