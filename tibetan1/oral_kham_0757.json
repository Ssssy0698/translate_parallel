    "སྟོང་ཡངས་རྒྱ་མ་ཆད་པར་འདུག་སྟེ།",
    "མ་བདེ་ན་གུས་སོས་ལྷོད་ལ་བཞག་དེ་ལྟར་ཡི་གེ་གསུམ་གྱི་སྣང་བ་ཤར་ཙ་ན།",
    "དེའི་ལོ་མ་དར་དུ་འདུག་མེ་ཏོག་འོད་དུ་འདུག་འབྲས་བུ་ཤེལ་དུ་འདུག་ཁུ་བ་རྔུལ་ཆུ་འདུག་པ་ཞིག་བསྒོམས་ལ་འདྲིས་སུ་གཞུག་གོ།",
    "ན་ཁ་འཐེན་སྡོད་ན་ལྕགས་རྡེག་པ་ཅིག་སིགས་སིགས་སྒོར་སྒོར་འདུག་པར་བསྒོམ།",
    "འདུག་པ་གཉིས་ཀྱང་གོང་བཞིན་དུ་བསམ་པས།",
    "དབྱིངས་ཡེ་ཤེས་དབྱེར་མེད་དུ་གསལ་ཞིང་འདུག་མཁའ་ཡིས་འོད་གསལ་ལ་བཞིགས་གཞིགས་",
    "དེ་ཙ་ན་ཤེས་པ་འུབས་ཀྱིས་བསྡུས་ཙ་ན་གནན་ནན་",
    "དེ་བཞིན་དུ་སེམས་མ་ཡེངས་པར་མཉམ་པར་གནས་པའི་གཤེན་པོ་དེ་ཡང་རང་སྣང་སོ་མའི་ཡུལ་རང་ཤར་ལྷུག་པའི་ཤེས་པ་རྟོག་མེད་རང་གྲོལ་དུ་གནས་པ་ལ་ཡུན་བསྲིང་ངོ།",
    "གཡོ་བ་མེད་པས་མི་རྟོག་པའི་ཡུལ་ཤེས་སོར་བཞག་སྟེ་རང་སོར་འདུག་པའོ།",
    "འགྲོ་ས་མ་སྙེད་ཙ་ན་ཀློད་བཀྲོལ་བཤིག་གསུམ་གྱིས་ངལ་བསྭོ་གསོ་",
    "ཤེལ་བུམ་ཁ་བཅད་པའི་ནང་ན་འདུག་པར་བསྒོམས་སྟེ།",
