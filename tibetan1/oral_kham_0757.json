    "མི་ཁ་ཤས་ཀྱི་རྣམ་པ་ནི་ངས་ད་དུང་ཡང་རབ་རིབ་ཅིག་དྲན་གྱི་འདུགའཁྲུག་ཆ་དོད་ཅིང་།",
    "དར་ཤུད་ལན་མང་དུ་བརྒྱབ་པའི་རྐྱེན་གྱིས་ངོ་གདོང་ཡང་ནག་པོར་གྱུར་འདུགལུས་སེམས་ཤིན་ཏུ་བརྟན་པོ་ཅན་གྱི་མི་གཞན་ཞིག་ཡོད་པ་གང་དེས་ལྭ་བ་ནག་པོ་ཞིག་གྱོན་ཡོད་ཅིང་།",
    "གལ་ཏེ་ངས་མགྱོགས་མྱུར་གྱིས་ཐག་བཅད་ཟིན་ན་ཁ་པར་ཨང་གྲངས་འདི་བརྒྱུད་ནས་ཁོ་དང་འབྲེལ་བ་བྱས་ཆོག་འདུགང་དང་གེའུ་ཨོར་ཀི་ཧྥི།",
    "ཁོས་ནམ་རྒྱུན་ཞོགས་པར་བྱུག་རྫས་ཀྱི་མྱུ་གུ་བཀོལ་ནས་འབྲི་བཞིན་འདུག་ཅེས་བཤད།",
    "བྷེ་སུང་ཁོའི་ཉེ་འགྲམ་དུ་བསྡད་འདུག་ངས་རླངས་འཁོར་གྱི་ཅ་ལག་བསྡུ་བསྣོད་ཀྱི་ཁ་ཕྱེས་ནས་ལམ་ཆས་ཡོད་ཚད་དེའི་ནང་དུ་བཞག་དེའི་རྗེས་སུ་ང་དང་དྷི་ཉི་ཚི་བཅས་རླངས་འཁོར་གྱི་ལྟག་རྒྱབ་ཀྱི་འདུག་སྟེགས་སུ་བསྡད།",
    "ཟངས་སྐུད་ཀྱིས་ཚེམས་པའི་པགས་པའི་སྟོད་ལྭ་ཐུང་ཐུང་ཞིག་གྱོན་འདུག་ཁོའི་ཁ་ནང་དུ་ཀ་ར་ཆེན་པོ་ཞིག་བཟུང་ནས་ཟ་བཞིན་ཡོད།",
    "ཁོས་ང་ལ་གནམ་གཤིས་བཟང་འདུག་ཅེས་བཤད།",
    "ངའི་བསམ་པར་དོན་དག་སྐབས་འདིར་སླེབས་དུས་སུ་ཡོད་ཚད་སྔར་བཞིན་ཅང་ཐར་ཐོར་དུ་གྱུར་འདུག་པས།",
    "བྱིས་པ་རྣམས་ཀྱིས་གཞུང་ལམ་གྱི་སྟེང་དུ་སྤོ་ལོ་རྩེད་བཞིན་འདུག་དེའི་ཕྱོགས་ནས་མཚམས་མི་ཆད་པར་ཁོ་ཚོས་ཕོ་དྷི་ལོ་ཞེས་འབོད་པའི་སྒྲ་གྲག་ཡོང་།",
    "ཁོས་གཞུང་ལམ་བརྒལ་ནས་སྤོ་ལོ་པང་དུ་བཟུང་འདུག་བྱིས་པ་གཞན་དག་ཁོའི་རྗེས་སུ་འབྲངས་མི་ཕོད་པས།",
    "ཅ་ཨའོ་ཨེར་རོ་ཧྥུའི་འདྲ་པར་ཡང་འདུག་གྲུ་གཟིངས་ཀྱིས་རྒྱུན་ཆད་མེད་པར་རྒྱང་རིང་དུ་ཕྱོགས་ནས་བཞུད་ཅིང་།",
    "མེ་ཏོག་ལྡུམ་ར་དེའི་དཀྱིལ་དུ་ཁང་མིག་ཅིག་འགྱེང་ངེས་ལངས་འདུགགནས་འདིའི་ཁང་མིག་ཐམས་ཅད་ཀྱི་བཟོ་དབྱིབས་གཅིག་མཚུངས་ཡིན་ཏེ།",
    "རྩྭ་ཐང་དེའི་གཡོན་དུ་གནམ་གྲུ་འཇོག་སའི་ཁང་བ་ཞིག་འདུག་ལ།",
    "དར་ཤིང་ཆག་ནས་དུམ་བུར་གྱུར་འདུག་མི་རྣམས་ཀྱིས་གྲུ་གཟིངས་ཀྱི་མཐའ་གཉིས་ནས་ལྡེམ་སྟེ་གྲུ་གཟིངས་ལ་སྲུང་སྐྱོབ་བྱེད་པའི་རླངས་འཁོར་འཁོར་ལོ་རྙིང་བ་འགའི་ངོགས་སུ་བཀལ།",
    "ངས་ཀྱང་རང་ཉིད་གཙང་འགྲམ་འདིར་དུས་ཡུན་ཅི་ཙམ་ལ་བསྡད་པ་གསལ་བོ་དྲན་མི་འདུག་ངས་ཧྥུའུ་ལེ་ཏེ་ལ་བསམ་བློ་གཏོང་བཞིན་བསྡད།",
    "ལེ་མང་རང་དང་རྗེས་མཐུན་ཞེས་སོགས་གང་གང་མ་རྙེད་པ་དང་བཅས་ཏེ་བཀོད་པ་ནི་མུན་སྤྲུལ་འབའ་ཞིག་སྟེ་ངག་ལས་ཤེས་སོ།",
    "དང་པོ་ལྟར་ན་བརྗོད་དུ་མེད་ཀྱང་རང་རིག་པར་མི་འཐད་དེ་ནམ་མཁའི་མེ་ཏོག་སོགས་བཞིན།",
    "དེར་འདུག་པ་ལས།",
    "དེ་ཡང་རང་དང་གཞན་གྱི་མངོན་མཐོ་ངེས་ལེགས་ཀྱི་དོན་ཕུན་སུམ་ཚོགས་པ་སྒྲུབ་པ་ཅི་ལ་ཡང་མ་རག་པར་ཏེ་རག་མ་ལས་པར་ཆས་པ་སྟེ་ཕྱིར་མི་ལྡོག་པ་ཉིད་ཀྱི་གོ་ཆ་བརྟན་པར་བྱས་པ་དག་ཁོ་ནས་སོ།",
    "དེར་བཞུགས་ནས་ཏིང་ངེ་འཛིན་གང་དུ་ཏིང་ངེ་འཛིན་ཐམས་ཅད་འདུ་བ་དང་ཁོང་དུ་ཆུད་པས་འདུ་བ་དང་ཟེར་འདུག་ཁོང་དུ་ཆུད་པ་དང་རྗེས་སུ་འབྲང་བ་དང་འདུ་བར་འགྱུར་བའི་ཏིང་ངེ་འཛིན་གྱི་རྒྱལ་པོ་ཞེས་བྱ་བ་ལ་མཉམ་པར་བཞག་གོ་ཞེས་འབུམ་ཊཱིཀ་ཏུ་བསྒྱུར་རོ།",
    "གདན་སེངྒེའི་ཁྲི་དེ་ལ་བཞུགས་པས་འདི་ལྟ་སྟེ་དཔེར་ན་ཉི་མ་བསྒྲིབས་པ་མེད་པ་ནམ་མཁའི་དབྱིངས་ཡོངས་སུ་དག་པ་ན་འདུག་པའམ་ཟླ་བ་ཉ་བའི་དཀྱིལ་འཁོར་ལྟར།",
    "ཡེ་ཤེས་མེད་པར་བཞེད་ཅེས་ཟེར་བ་ནི་མི་བདེན་པར་སྣང་སྟེ་སྤྱིར་དེས་ལུགས་གཉིས་བཀོད་ཀྱང་རང་ལུགས་ལ།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "གཉིས་པ་དངོས་གཞི་བྱང་སེའི་སྡོམ་པ་སྦྱིན་པར་བྱ་སྟེ་འགྲེང་ངམ་འདུག་ཀྱང་རུང་བྱང་བཟང་ངོ།",
    "སེམས་བསྐྱེད་དེ་ཡང་རང་ཀིར་སོགས་དབྱེ་གཞི།",
    "ཐམས་ཅད་ཤེས་པ་ཉིད་ལ་ཤེས་པ་དང་མཐོང་བས་བལྟས་ནས་འདའ་བར་འདོད་པས་ཡུམ་བསྒོམ་ཞེས་ཨཱརྻས་དྲངས་དོན་འདུག་སོ།",
    "སྟེང་ན་འདུག་པ་ལ་བཀྱེད་དེ་མི་ལྟ།",
    "འོག་ན་འདུག་པ་ལ་བཏུད་༢༩",
    "གཡས་གཡོན་འདུག་པ་ལ་མིག་གཟུར་ཏེ།",
    "རྒྱབ་ན་འདུག་པ་ལ་འཇིང་པ་བསྒྱུར་ཏེ།",
    "ཐག་རིང་པོ་ན་འདུག་པ་ལ་སྒྲིམས་ཏེ།",
    "ལོ་ཙ་ན་ཞེས་པ་མིག་ཡིན་ལ།",
    "སྐྱེས་ནས་མྱོང་རང་འགྱུར་གྱི།",
    "ལན་གྲངས་གཞན་ལ་མྱོང་རང་འགྱུར་གྱི་ལས་ཅན་ནོ།",
    "བསམ་གཏན་སྤེལ་ན་འོག་མིན་འགྲོ།",
    "རྒྱུ་བསམ་གཏན་རང་སྤེལ་ན་འོག་མིན་འགྲོ།",
    "འོག་མིན་འགྲོ་ནི་༣༧༡",
    "ཕྱིར་མི་འོང་གོང་འཕོ་ད་ཕྱིས་འོག་མིན་འགྲོའི་མཚན་ཉིད།",
    "འོག་མིན་འགྲོ་ཡང་།",
    "དང་པོ་བྱང་སེ་ཕྱིར་མི་ས་བཅུ་པ་ཡིན་དགོས་འོང་འོག་མིན་འགྲོའི་མིང་ཅན་ནི།",
    "ལུས་ཀྱིས་མངོན་སུམ་དུ་བྱེད་པ་ཞེས་བྱ་བ་འོག་མིན་འགྲོ་ལས་གཞན་རྣམ་པ་གཉིས་སོ།",
    "ཇེ་ཆེ་ཇེ་ཆེར་འཕེལ་ཞིང་རྒྱས་པར་བྱ་བའི་བློ་བརྟན་དངོས་ཕྱིར་དུ་ཅུང་ཟད་ཀྱང་མི་གནས་དབྱིག་ཤིང་མི་འདུག་པར་བདག་མེད་བསྒོམས་པ་ལ་བརྩོན་འགྲུས་བརྟན་པོ་རྩོམ་པས་ཡེ་ཤེས་འགྲེལ་ཆེན་བསྒོམ་རིམ་དང་པོའི་ཐུབ་དགོངས་དངོས་ཀྱི་སྣང་དབྱིག་བ་འབྲིང་ཙམ་དུ་གསལ་བ་ནི།",
    "དེས་ན་སྤྱི་བརྗོད་པ་དང་རང་མཚན་བརྗོད་པའི་སྒྲ་འཇུག་པའི་དོན་བརྗོད་བྱ་བདེན་པ་མེད་དེ།",
    "སྐྱེ་བོ་དམིགས་པ་ཅན་ཕྱི་རོལ་ཞེན་པ་གསེར་ཟེར་ཡང་རང་བཞིན་ཡོད་པར་ཞེན་པའི་ངོར་དེ་སྐད་བརྗོད་པ་ཙམ་ཡིན་གྱིས་དོན་དམ་པར་དེ་ལྟར་ཡང་བཞག་ཏུ་མེད་དོ་སྙམ་དུ་བསམ་པའོ།",
    "ཡང་རང་རྒྱུད་ལྡན་གྱི་༤༤༤",
    "སློབ་དཔོན་རྗེས་འབྲང་བཅས་དང་རང་ཀིར་ནི།",
    "བྱང་སེའི་སྦྱོར་རྩེ་ལ་མཚུངས་པར་ལྡན་པ་གང་ཞིག་གཉེན་པོ་རྣམ་བྱང་རང་བཞིན་མེད་འཛིན་གྱི་གཟུང་རྟོག་གོ།",
    "ཟག་པ་མ་མཆིས་ཤིང་ཁམས་གསུམ་དུ་མ་གཏོགས་པའི་སེམས་གང་ལགས་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཆགས་པ་མ་མཆིས་པས་དེའི་ཕྱིར་བྱང་ཆེན་པོ་ཞེས་བྱའོ།་",
    "ཙ་ནི་འཆི་འཕོ་སྐྱེ་བ་མི་དམིགས་པས།",
    "ཨ་ར་པ་ཙ་ནའོ།",
    "གཞན་པ་སྟོན་ཅིང་རང་ཀིར་ཡང་དག་པར་འཛིན་པར་བྱེད་པ་ཡིན།",
    "དེ་དོན་དམ་པར་རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར་ན།",
    "སྟན་གྱི་མཐའ་སྟན་གཅིག་ལ་འདུག་ནས་ཇི་ཙམ་འདོད་དུ་ཟ།",
    "ཡང་ཡང་ཟ་བའི་གཉེན་པོ་ཕྱིས་མི་ལེན་པ་ནི་སྟན་ལ་འདུག་སྟེ་ཇི་ཙམ་ཟ་བར་ནུས་པ་དེ་ཙམ་བྱིན་ལེན་བྱས་ནས་ཟ་མི་བྱིན་ལེན་མ་བྱས་པར་མི་ཟ་བའི་ཞེས་ཛ་ཡ་ཨ་ནནྟས་སོ།",
    "འཇིག་རྟེན་ནའང་སུ་དག་ཚིག་བསྡམས་ཏེ་འདུག་པ་དེ་ཐུབ་པ་ཞེས་བྱའོ།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "མཐོང་བས་ཤིན་ཏུ་རྟོགས་པར་བྱས་ནས་དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ།",
    "དེ་གཅིག་པུ་དབེན་པར་འདུག་སྟེ་ཞེས་པ་ནས་ཞི་གནས་ཡོངས་སུ་འཚོལ་བར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལས་གཞན་པའི་རྣམ་པར་ཤེས་པ་ནི་ཇི་སྲིད་འཆི་བའི་བར་དུ་ལུས་མི་གཏོང་བའམ་ཁྱབ་པར་འདུག་པ་ནི་མེད་དོ།",
    "དེ་རྗེས་རིམ་ལྔ་གསལ་སྒྲོན་དགའ་ལྡན་དུ་མཛད་ཅིང་ཡི་གེ་པ་དཀའ་བཞི་པ་རིན་ཆེན་དཔལ་གྱིས་མཛད་འདུག་རིམ་ལྔ་གསལ་སྒྲོན་ལས།",
    "དགུང་ལོ་ང་ལྔ་པ་ལ་རིམ་ལྔ་གསལ་སྒྲོན་ཕྱི་ལོ་༡༤༡༡ལོར་མཛད་འདུག་དེ་རྗེས་རིམ་ལྔ་གདན་རྫོགས་དགའ་ལྡན་དུ་མཛད་དུས་ཡི་གེ་པ་དཀའ་བཞི་པ་རིན་ཆེན་དཔལ་གྱིས་མཛད་འདུག་རིམ་ལྔ་གདན་རྫོགས་ལས།",
    "ཚུལ་མིན་བྱ་སྤྱོད་ལ་གཏིང་ནས་མི་དགའ་ཞིང་རང་བཞིན་དྲང་པོ་ཅན་རྣམས་རྗེའུ་རིགས་དང་།",
    "དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "ཞེས་བྱ་བ་འདིའི་དོན་ནི་སྐྱེ་བོ་ཉེ་བ་ལ་ལྟོས་ཏེ་དགོངས་པ་ཡིན་ནོ་ཞེས་བྱ་བར་རྣམ་པར་འཆད་པར་བྱེད་པ་དེ་ཡང་རང་དགའ་ཙམ་གྱིས་ཉེ་བར་བརྟགས་པ་ཡིན་པའི་ཕྱིར་རིགས་པ་མ་ཡིན་པ་ཉིད་དེ།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན་སོགས་སད་མི་མི་དྲུག་དང་།",
    "གང་རང་བཞིན་སྟོང་པ་དེ་ནི་གདགས་སུ་མེད་པའོ།",
    "གང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་དེ་ནི་སྟོང་པ་ཉིད་ཡིན་ཞིང་།",
    "དེ་ཁོ་ན་ཉིད་ལའང་རང་བཞིན་ཡོད་མེད་ཚུལ་བཞིན་དུ་དཔྱོད་པའི་རིགས་པས་གནོད་པ་མི་འབབ་པ་ཞིག་ནི་ཐ་སྙད་ཡོད་པར་འདོད་ལ།",
    "དངོས་པོ་སྨྲ་བ་རྣམས་ནི་ཆུ་ཚ་བར་སྐྱེས་པ་དང་མེ་ཚ་བར་སྐྱེས་པ་ལ་རང་བཞིན་གྱིས་མི་སྐྱེས་མ་སྐྱེས་ཀྱི་ཁྱད་པར་མི་འདོད་པས་འཇིག་རྟེན་ན་བཅོས་མར་འཇོག་ན་རང་བཞིན་དུ་ཐ་སྙད་མི་བྱེད་པའི་ཚུལ་དེ་ཁས་མི་ལེན་ཞིང་རང་ལུགས་ལ་དེ་ཁས་ལེན་ནོ།",
    "འཇིག་རྟེན་ན་བཅོས་མར་འཇོག་ན་རང་བཞིན་དུ་ཐ་སྙད་མི་བྱེད་པའི་ཚུལ་དེ་ཁས་མི་ལེན་ཞིང་རང་ལུགས་ལ་དེ་ལྟར་ཁས་ལེན་ནོ།",
    "ཀུན་བཏགས་ཀྱིས་སྟོང་པའི་སྟོང་པ་ཉིད་ཡོངས་གྲུབ་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པར་བསྟན་ཏེ།",
    "མདུང་ཁྱིམ་གྱི་ཚུལ་དུ་གཅིག་ལ་གཅིག་རྟེན་ཅིང་འདུག་ལ་ཞེས་དང་།",
    "རྣམ་པར་སྨིན་པའི་རྣམ་པར་ཤེས་པ་དེ་ཡང་མིང་གཟུགས་དེ་ཉིད་ལ་བརྟེན་ཅིང་འདུག་གོ།",
    "དེ་ཡང་རྟེན་རྣམ་པ་དྲུག་ལ་བརྟེན་ཅིང་འདུག་སྟེ།",
    "ད་ལྟར་གྱི་དུས་ན་ཚེ་ཇི་སྲིད་པར་མདུང་ཁྱིམ་གྱི་ཚུལ་དུ་འདུག་གོ།",
    "རང་རང་འདོགས་བྱེད་ཀྱི་རྟོག་པ་ལ་བྱས་ན་གཏན་ཚིགས་ཕྱི་མ་སྟོན་ནོ།",
    "མདུང་ཁྱིམ་གྱི་ཚུལ་དུ་གཅིག་ལ་གཅིག་རྟེན་ཅིང་འདུག་མདུང་ཁྱིམ་ཡང་དུས་མཉམ་དུ་གཅིག་ལ་གཅིག་བརྟེན།",
    "སྐབས་དེར་གསུང་འབུམ་ལ་རྒྱས་པར་བལྟ་འདོད་པ་ལས་ང་རང་ལ་པར་སྐྲུན་གྱི་འགན་འཛིན་པའི་སྤོབས་པ་དང་འདུན་པ་གཏན་ནས་སྐྱེས་མ་བྱུང་།",
    "ཁང་དཀར་མཆོག་ནས་ཀྱང་ཐུགས་དགྱེས་བཞིན་ང་རང་བྱ་བ་སྒྲུབ་པ་ལ་ནན་ཏན་ཡིན་པ་དང་།",
    "དངོས་པོ་སྣ་ཚོགས་ཤར་ཡང་རང་སེམས་ཏེ།",
    "ཁྱབ་དང་གཟུགས་ཅན་མ་ཡིན་འགྲོ་འོང་མེད།",
    "སྣང་ཡང་རང་བཞིན་མེད་པ་ཆུ་ཟླ་འདྲ།",
    "འགྲོ་འཆག་ཉལ་འདུག་ཐམས་ཅད་ལྷུག་པར་ཞོག།",
    "བེ་རོ་ཙ་ན་རཀྵི་ཏ།",
    "བེ་རོ་ཙ་ན་རཀྵི་ཏ།",
