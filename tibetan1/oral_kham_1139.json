    "དེ་རྣམས་ཀྱང་སྟན་ལ་འཁོད་ནས་འདུག་པ་ལ།",
    "ལུམྦི་ནཱིའི་ཚལ་དབེན་པར་འགྲོ་བ་དང་འདུག་པའི་བློ་སྐྱེས་ཏེ།",
    "ཁྱེད་ཅག་རྒྱན་གྱིས་བརྒྱན་ལ་སིལ་སྙན་ཐོགས་ཏེ་ཤིང་རྟའི་མཆོག་འདིར་སྒྱུ་འཕྲུལ་བསེ་རུ་ལྟ་བུར་འདུག་ཏུ་ཆུག་ལ་ན་ཆུང་རྣམས་ཀྱིས་དྲོངས་ཤིག་ཅེས་སྨྲས་པ་དང་།",
    "ཞེས་ཕོ་ཉ་དང་དཀོར་སྒྲོམ་དག་དུས་དུས་སུ་རྒྱལ་བོ་ཟས་གཙང་ལ་བསྐུར་བར་བྱེད་དོ།",
    "ཡོན་ཆུས་རྐང་བ་ལ་གཏོར་ཅིང་སེང་གེའི་ཁྲི་ལ་འདུག་ཏུ་བཅུག་ནས་ཞེ་ས་དང་གུས་པ་དང་བཅས་པས་སྨྲས་པ།",
    "དྲུག་པ་ལ་གཙུག་ཕུད་བཞག་ནས་མ་མའི་པང་བར་འདུག་སྟེ་གསེར་གྱི་གཞོང་བར་འབྲས་དང་ཤར་བསྲེས་པའི་ཆན་གསོལ་བ་ན་མ་མས་བཀག་ཀྱང་མ་ཐུབ་པར་རྒྱལ་བོ་ལ་སྦྲན་ཏེ་སྐྱེ་བོའི་ཚོགས་མང་བོས་དབྲོག་པར་བརྩམས་ཀྱང་འཕྲོག་མ་ནུས་ནས།",
    "བཅད་པ་རྣམས་མ་འགྱེལ་བར་འདུག་གོ།",
    "ཁྱུ་མཆོག་ལྟ་བུར་འདུག་གོ།",
    "དེའི་ཚེ་ངང་བ་དང་རྨ་བྱ་ལ་སོགས་ཁང་བཟངས་སུ་འདུག་ནས་སྒྲ་མི་འབྱིན།",
    "ཞེ་སའི་ཚུལ་གྱིས་འདུག་ནས།",
    "བུ་འདིར་འདུག་ན་བདག་ཅག་ལ་ཕན་ཐོགས་པར་འགྱུར་ན་དམ་པ་སློངས་ཤིག་གསོལ་བ།",
    "དེ་ལྟར་བརྡ་སྤྲད་པ་དང་ས་འཚོ་མ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ལྷའི་བུ་རྣམས་ཀྱང་ད་ཇི་ལྟ་ཞིག་སྙམ་དུ་འདུག་པ་དང་།",
    "ལྷའི་བུ་ཉི་མ་དང་ཟླ་བ་གཉིས་པོ་ཡང་གློ་གཡས་གཡོན་ན་འདུག་པ་དང་།",
    "ཕར་འབྲོས་ཚུར་བྲོས་ཤིང་འདུག་ཏུ་མི་སྡུབ་བོ།",
    "ཞེས་གསུངས་པས་བསྔགས་ལྡན་མི་གཡོ་བར་འདུག་གོ།",
    "དེའི་ཚེ་འཇིག་རྟེན་སྐྱོང་བ་བཞི་ཡང་ཕྱོགས་བཞིར་འདུག་གོ།",
    "དེ་ནས་ཤཱཀྱ་མིང་ཆེན་ཕུ་ནུ་དང་བྲལ་བའི་སྡུག་བསྔལ་གྱིས་གདུངས་ལ་རང་ཉིད་ཀྱིས་བཟུང་བར་མ་ནུས་ཤིང་གཞན་གཉིད་སྟུག་པོས་ནོན་པས་ཅི་བྱའི་གཏོལ་མེད་དེ་འདུག་གོ།",
    "མིང་གཞན་རྣམ་པར་བམ་པ་དང་མི་གཡོ་བ་ཞེས་བྱ་བ་ལ་སྙོམས་པར་ཞུགས་ཏེ་འདུག་པ་དང་།",
    "ས་སྟེང་འདུག་ཅིང་འགྲེ་བ་འདི་སུ་ཞིག།",
    "རྐང་གཅིག་བཙུགས་དང་ཙོག་པུར་འདུག།",
    "ཁ་བུབ་དང་གན་རྐྱལ་དུ་ཡང་མི་གནས་པར་འདུག་གོ།",
    "ཡེ་ཤེས་ཀྱི་ལུས་འོག་མིན་ལྷའི་རྒྱལ་བོའི་གནས་ན་འདུག་པ་ལ།",
    "དེའི་ཚེ་བརྒྱ་བྱིན་དང་ཚངས་པ་དང་གནས་གཙང་མའི་ལྷ་རྣམས་ཀྱིས་བྲམ་ཟེར་སྤྲུལ་ཏེ་འདུག་པ་ལ།",
    "དེས་རྨོངས་ནས་ཕྱོགས་གང་དུ་ཕྱིན་ཀྱང་དགེ་སྦྱོང་མཛེས་པ་ཁོ་ན་གདའ་ཡི།",
    "མགོ་རྐང་བ་ལ་འདུག་ཅིང་རྐང་བ་མགོ་ལ་སྐྱེས་པ་དེ་བཞིན་དུ་ལག་པ་དང་རྐང་བ་དང་མགོ་དང་མིག་ལོག་པར་འདུག་པ།",
    "སྤྱི་ཚུགས་སུ་འདུག་ལ་ཁབ་ཀྱི་སྤུ་ཅན་དག་དང་།",
    "བདུད་ཀྱི་བུ་གཞན་ཞིག་ཁྲོས་ཏེ་དེ་གཅིག་པོར་འདུག་ན་ཇི་ག་ཞེས་སྤྲོས་སོ།",
    "ཚུལ་དེས་བདུད་སྡིག་ཅན་ཞུམ་ཞིང་ཅང་མི་སྨྲ་ལ་སྤྱི་བོ་སྨད་ནས་སེམས་ཁོང་དུ་ཆུད་ནས་འདུག་གོ།",
    "དེ་གཉིས་དེ་ལྟར་འདུག་པ་དང་།",
    "སུ་ཡང་མི་འདུག་པས་འཇིགས་པ་མེད་དོ་ཞེས་སྨྲས་སོ།",
    "རོལ་བའི་རྫིང་འགྲམ་ན་འདུག་ནས།",
    "ཞེས་བརྗོད་མ་ཐག་དེ་བཅོམ་ལྡན་འདས་ཀྱི་དྲུང་ན་འདུག་པ་མཐོང་སྟེ།",
    "གཡས་ན་སྟོབས་པོ་ཆེ་ལག་པ་བཞི་བ་ཡང་འདུག་སྟེ།",
    "དགེ་སློང་ལྔ་བོས་ཀྱང་དེ་བཞིན་གཤེགས་པ་ལ་ཕྱག་བཙལ་ནས་དུལ་བའི་ཚུལ་གྱིས་འདུག་གོ།",
    "འདུག་བཞིན་དུ་མི་མཐོང་བར་བྱིན་གྱིས་བརླབས་སོ།",
    "ཁྱིམ་བདག་དེའི་ཕྱིར་འདུག་ཤིག་དང་སྟན་དེ་ཁོ་ན་ལ་གཞོན་ནུ་འདུག་པ་མཐོང་བར་འགྱུར་རོ།",
    "ཅེས་པ་ལ་སོགས་པ་བློ་ཀ་གཉིས་བྲིས་ཏེ་འདུག་པ་བཅོམ་ལྡན་འདས་མ་གཏོགས་དེའི་དོན་སུས་ཀྱང་སྨྲ་བར་མི་ནུས་པ་ཞིག་ཡོད་པ་དེ།",
    "གནོད་སྦྱིན་གསེར་འོད་ཀྱིས་ལྕང་ལོ་ཅན་ན་དྲི་བ་དེ་འདུག་པ་མཐོང་ནས་བླངས་ཏེ་དཔྱད་ཀྱང་ཁོང་དུ་མ་ཆུད་ནས།",
    "དེ་ནས་འོད་སྲུངས་རང་ཉིད་སྦྱིན་སྲེག་བྱེད་དེ་ཡམ་སྲེག་ཤིང་བཙེར་ཧོམ་གཟར་ཐོགས་ཏེ་འདུག་པ་དང་།",
    "ཨངྒའི་རྒྱལ་བོ་དང་གཡུལ་བཀྱེས་པས་རྒྱལ་བོ་དེ་བསད་ནས་ཡུལ་ཨངྒར་འདུག་པ་དང་།",
    "རྟ་ཐུལ་གྱི་ཆ་བྱད་དུ་སྤྲུལ་ནས་དེ་གཉིས་འགྲོ་བའི་ལམ་གར་འདུག་ནས་སྨྲས་པ།",
    "དེའི་ཚེ་བདུད་སྡིག་ཅན་མྱ་ངན་གྱི་ཁང་བུ་ན་འདུག་ཅིང་སྟོང་ཆེན་གྱི་བདུད་ཐམས་ཅད་ཀྱང་དོགས་སྐྱེས་ནས་སེམས་ཤིང་འདུག་གོ།",
    "ཤཱ་རིའི་བུ་བསྙེན་པར་རྫོགས་ནས་ཟླ་བ་ཕྱེད་ལོན་པ་དེ་བཅོམ་ལྡན་འདས་ཀྱི་སྣམ་ལོགས་ན་བསིལ་ཡབ་གཡོབ་ཅིང་འདུག་པ་མཐོང་ནས་བཅོམ་ལྡན་འདས་ཀྱི་དྲུང་དུ་ཕྱིན་ཏེ།",
    "སྡུག་ཅེས་པ་དེ་ཕ་མ་དང་འགྲོགས་ནས་འོད་མའི་ཚལ་དུ་ཕྱིན་པ་ན་བཅོམ་ལྡན་འདས་ལ་ཕའི་འདུ་ཤེས་སྐྱེས་ཏེ་ཕ་ཕ་ཞེས་ཟེར་ཞིང་ཞབས་དྲུང་ཉིད་དུ་འདུག་པ་དང་།",
    "ཕས་དེ་ཉིད་དུ་འདུག་ནས་མ་གདུགས་ཚོད་ཤོམ་དུ་བཏང་སྟེ་ཞག་བདུན་དུ་གདུགས་ཚོད་གསོལ་ཞིང་།",
    "མ་མའི་པང་དུ་འདུག་པ་ལས་སློང་བ་དག་ལ་ཐགས་ཐོགས་མེད་པར་རྒྱན་བྱིན་པས།",
    "འཇིག་རྟེན་སྐྱོང་བ་བཞིས་ཞལ་ཆེ་སྤྱོད་པའི་ལུས་སུ་སྤྲུལ་ནས་འདུག་པ་ལ།",
    "ཕྱོགས་འགའ་ཞིག་མ་གཡོགས་པར་འདུག་པ་ལས།",
    "འོད་སྲུངས་ཀྱིས་དེ་ལྟར་འདུག་པ་མཐོང་ནས།",
    "རྒྱལ་བོ་ཟས་གཙང་རང་ཉིད་ཀྱིས་སྤྲིང་ཡིག་བྲིས་པ།",
    "རྒྱལ་བོས་ཡན་ལག་ཐམས་ཅད་ཀྱིས་འཁྱུད་ནས་སྟན་བཤམས་པ་ཉིད་ལ་འདུག་ཏུ་བཅུག་སྟེ།",
    "བདེ་བར་གཤེགས་པ་ལ་ཀུན་ནས་རྟོག་ཅིང་འདུག་གོ།",
    "སྒོ་བཞི་ན་ནི་རྒྱལ་བོ་ཆེན་པོ་བཞི་འདུག་གོ།",
    "མིའམ་ཅི་རྣམས་ཀྱིས་བསྐོར་ཞིང་ཉན་ཐོས་ཆེན་པོ་རྣམས་ཀྱང་འདུག་གོ།",
    "རྒྱལ་བོ་ཡུལ་འཁོར་སྲུང་སྒོ་ན་འདུག་ནས་དེས་ནང་དུ་མ་འགྲོ་སྡོད་ཅིག་ཅེས་བཟློག་གོ།",
    "མགུ་བ་སྐྱེས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "དེ་ནས་ཤཱཀྱ་དེ་རྣམས་གསོལ་བཞིའི་ལས་ཀྱིས་རབ་ཏུ་བྱུང་སྟེ་འདུག་པ་དང་།",
    "ལན་གསུམ་དུ་མ་གནང་བས་ཡུམ་ཕྱི་རོལ་གྱི་སྒོ་ཁང་དུ་འདུག་ནས་མཆི་མ་འབྱིན་ཏོ།",
    "ཡི་དྭགས་ལྔ་བརྒྱ་འདུག་པ་དང་དེ་སྔོན་གྱི་ལས་ཀྱི་འབྲེལ་བས་ཕན་ཚུན་མཐོང་སྟེ་གྲོགས་པོར་གྱུར་ཏོ།",
    "དེས་རྫུ་འཕྲུལ་དེ་བསྡུས་ནས་བཅོམ་ལྡན་འདས་དེའི་དྲུང་ན་འདུག་གོ།",
    "དེ་ནས་དེས་སྐད་ཅིག་ཙམ་གྱིས་འོངས་ནས་ཉེས་པ་བཤགས་ཏེ་འདུག་གོཤོག་ཅིག་བཅོམ་ལྡན་འདས་འོད་མའི་ཚལ་དུ་གཤེགས་ཏེ།",
    "སྒམ་པོ་དེ་ལུས་ཆེ་ལ་དམུས་ལོང་དུ་འདུག་པ་ལུས་རིལ་གྱིས་རྨས་གང་ཞིང་སྤྱི་བོ་ནས་རྐང་མཐིལ་གྱི་བར་སྲིན་ཞུགས་པས་མི་བཟོད་དེ་བརྒྱུགས་པ་ལས།",
    "དེ་ནི་མཁས་པ་གཡེར་བག་ཅན་ཁྱིམ་ན་འདུག་པ་ལས།",
    "འབྱོར་ལེན་སེམས་ལས་ཆུང་ངུར་འདུག་སྟེ་ནུ་བོའི་ངག་མ་ཉན་པས་ཉེས་ཏེ་ཅི་ཡང་བྱར་མེད་དོ།",
    "འཕགས་པ་གང་བོ་སྤུན་འདུག་གོ།",
    "དེ་ནི་མགོ་རི་ཆེན་པོ་བཞིན་དུ་འདུག་པ་མགྲིན་པ་སྐུད་པ་ལྟར་ཕྲ་བ་གོམ་པ་འབོར་མི་ནུས་པ་ལུས་ལ་ལྕགས་གཟེར་སུམ་བརྒྱ་དྲུག་ཅུས་བཏབ་པ་དེ་མཐོང་ནས།",
    "རྒྱལ་བོ་གསལ་རྒྱལ་གྱིས་ཁྲིའུ་ཞིག་བྱིན་པ་དང་དེ་དེ་ལ་འདུག་གོ།",
    "དེ་མགོ་སྨད་དེ་འདུག་གོ།",
    "མེ་ཏོག་དེ་བཅོམ་ལྡན་འདས་ཀྱི་དབུའི་སྟེང་ན་འདུག་པ་མཐོང་བས་ངོ་མཚར་དུ་གྱུར་ཏེ།",
    "མི་ལིནྡའི་བུ་ལ་ལྷས་སྦྲན་པས་དེས་གྲུའི་དངོར་འདུག་ནས་ཚ་བོ་དག་ཐར་བར་བྱས་པ་དང་གཞོན་ནུ་མ་སྐྱེས་དགྲ་པི་ལིནྡའི་བུ་ལ་བསྟོད་པར་བྱེད་དོ།",
    "རྒྱལ་བོ་ཁྲོས་ནས་བློན་པོ་རྣམས་ལ་ཁྱིམ་བདག་འདི་གཉིས་ཕྱིར་འོང་བ་དེའི་ཚེ་མགོ་བོ་ཆོད་ཅིག་ཀླུ་གཉིས་པོའི་ཞོ་ཤས་འཚོ་བ་དག་དེའི་ལམ་ན་འདུག་ནཔས་དེ་ཐོས་ནས་འཁྲུགས་ཏེ།",
    "དེ་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་མཐའ་འཁོབ་ཀྱི་གནས་མལ་རྟེན་ཅིག་དེ་སུམ་ཅུ་རྩ་གསུམ་དུ་ཤིང་ཤི་རཱི་ཥའི་གཞལ་མེད་ཁང་སྟོང་བར་འདུག་སྟེ།",
    "རྒྱལ་བོ་ཁྲོས་ནས་བློན་པོ་ལ་བསྒོས་ཏེ་དེ་གཉིས་ལ་ངའི་ཡུལ་དུ་མ་འདུག་ཅིག་ཅེས་བརྗོད་པས་དེ་གཉིས་དགའ་སྟེ་འོད་པའི་ཆུ་བྱུང་བ་རྒྱ་མཚོ་ཆེན་པོར་སླེབས་མ་ཐག་དེ་བ།",
    "རྒྱལ་བོས་ལན་གསུམ་གྱི་བར་དུ་སྨྲས་ཀྱང་ཅང་མི་ཟེར་བར་གཅིག་ལ་གཅིག་གྲུ་ཕུགས་བྱེད་ཅིང་ཡུལ་ཡུལ་བོ་དང་ཞུམ་ཞུམ་པོར་གྱུར་ནས་མགོ་སྨད་ཅིང་སྤོབས་པ་མེད་དེ་སེམས་ཁོང་དུ་ཆུད་ནས་འདར་ཞིང་འདུག་གོ།",
    "དེའི་ཚེ་ཀླུ་སོག་མ་མེད་དུ་སྐྱེ་བར་འགྱུར་བའི་བྲམ་ཟེ་མེས་སྦྱིན་ཡང་ཀྱི་ལ་ལྷོ་ཕྱོགས་ནས་འོངས་ཏེ་རྒྱལ་བོའི་ཁབ་ན་འདུག་གོ།",
    "གྲོགས་སུ་ཡང་མི་འདུག་ནས།",
    "དེ་ན་དྲང་སྲོང་ཞིག་གནས་པ་ལས་རབ་ཏུ་བྱུང་ནས་མངོན་ཤེས་ལྔ་བསྐྱེད་དེ་འདུག་གོ།",
    "སྡིག་ཅན་གྱི་སྲིན་བུ་པ་དྲའི་དེའི་སྤྱོད་ལམ་གྱིས་ལྷ་དང་མིའི་ཡིད་སྡུད་པར་བྱེད་པ་ཡིན་པས་སྔ་དྲོ་ནགས་ཁྲོད་དུ་འདུག་ནས།",
    "བསོད་སྙོམས་ལ་ཞུགས་པ་ན་ཆུང་མ་དབྱངས་ཅན་མས་བྲིད་ནས་བསླབ་པ་ཕུལ་ཏེ་སྔོན་གྱི་གནས་སུ་འདུག་པ་དང་།",
    "དགེ་སློང་སྟོང་ཉིས་བརྒྱ་ལྔ་བཅུ་དང་ཐབས་གཅིག་པ་ན་སྒྲ་གཅན་འཛིན་བསིལ་བའི་ཚལ་དུ་འདུག་པ་ལ་གནོད་སྦྱིན་རྣམས་ཀྱིས་གཙེས་པས།",
    "ཀླུ་སྡིག་ཅན་གྱིས་དེ་མཐོང་སྟེ་ཆེར་འཁྲུགས་ནས་སྒོ་བཅད་དེ་འདུག་གོསེམས་བསྐྱེད་པ་དང་།",
    "དེའི་ཚེ་ཐུབ་པའི་གནས་ཀུན་རྟེན་ན་འདུག་༩པའི་ཀླུ་ལྷག་མ་རྣམས་འདེང་བར་མ་ནུས་ནས་སྟོན་པ་ལ་བསྐྱབ་པར་གསོལ་ཞིང་།",
    "མ་འགགས་པ་རྣམས་ལ་རབ་ཏུ་དབྱུང་བར་ཞུས་པ་མ་གནང་བས་ཐེམ་པ་ལ་འདུག་ནས་སྐད་ཆེན་པོས་ངུས་སོ།",
    "དུས་སྔ་བ་ཞིག་ན་མཉན་ཡོད་ཀྱི་ཚོང་དཔོན་ཆུ་སྟོད་རབ་ཏུ་བྱུང་སྟེ་ཤིང་གླག་ཤའི་ཚལ་དུ་འདུག་ནས།",
    "འོག་ཕྱོགས་ནས་འཇམ་དཔལ་འཁོར་དྲུག་ཁྲིས་བསྐོར་བ་འོངས་ནས་པདྨ་དེ་ལ་འདུག་སྟེ་སྟོན་པ་ལ་འབེལ་མཆིན་ཞུས་ཤིང་།",
    "ཤཱ་རིའི་བུས་དེ་གན་རྐྱལ་དུ་སྡུར་བའི་སྒྲ་འབྱིན་ཅིང་འདུག་པར་བྱས་ནས་དགེ་སློང་དག་ཁྱེད་ཀྱིས་སྟོན་པ་གཉིད་ལོག་པའི་གནས་སྐབས་ལ་ལྟོས།",
    "ཡང་དེའི་ཚེ་འཁོར་རྣམས་ནམ་མཁའ་ལ་འཕགས་པ་སྙམ་བྱེད་ཅིང་བཀོད་པ་བརྩེགས་པའི་ཁང་བ་ན་འདུག་པ་ལ།",
    "བཅོམ་ལྡན་འདས་ཉིད་ཀྱི་སེང་གེའི་ཁྲི་འཕགས་པའི་དེ་ལ་ཕྱག་བྱས་ཏེ་འདུག་གོ།",
    "དེ་ནས་ཁྲས་ཕུག་རོན་ཞིག་བདས་པ་ཤཱ་རིའི་བུའི་གྲིབ་མ་ལ་འདུག་ཀྱང་འདར་བ་ལས་སྟོན་པའི་སྐུའི་གྲིབ་མ་ཕོག་མ་ཐག་འདར་བ་ཞི་ནས་སྡོད་དོ།",
