    "རང་བཟོའི་གཅམ་བུའི་ངག་སྒྲོས་མ་ཡིན་པར།",
    "སྒོ་གསུམ་བརྩོན་པ་ཆེན་པོས་ལེགས་པར་བསྒྲུབས།",
    "རིམ་པར་བཏབ་བོ་ཤིན་ཏུ་གསང་བ་གཅེས།",
    "དུས་གསུམ་མཁྱེན་པའི་སྤྱན་སྔར་བཤགས་པར་བགྱི།",
    "འགྲོ་ཀུན་བདེ་སྐྱིད་ཀྱི་དཔལ་ལ་སྤྱོད་པའི་བསྐལ་པ་བཟང་པོ་དང་ལྡན་པར་གྱུར་ཅིག་ཅེས་ཡེ་གེ་གཉིས་པར་སྤེལ་བ་ནི།",
    "འཕགས་བོད་པཎ་གྲུབ་བགྲང་ཡས་རྣམ་པར་རོལ།",
    "ཁྱད་པར་མཁའ་འགྲོ་གསང་བ་ཡེ་ཤེས་ཀྱིས།",
    "འཇའ་ཚོན་དབུས་ན་ཀུན་མཁྱེན་བློ་བཟང་གྲགས།",
    "མཐའ་ཀླས་འགྲོ་དོན་བགྱིད་པར་བྱིན་གྱིས་རློབས།",
    "སྤྱི་དང་ཁྱད་པར་འཇམ་མགོན་ཙོང་ཁ་བའི།",
    "དབོ་ཟླ་བའི་དཀར་ཕྱོགས་ཀྱི་དགའ་བ་གསུམ་པའི་ཚེས་ལ་གྲུབ་པར་སྦྱར་བ་དགེ་ལེགས་སུ་གྱུར་ཅིག།",
    "བཞེས་ནས་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "སྐུ་ཚེ་མཛད་འཕྲིན་ཕྱོགས་བཅུར་ཁྱབ་པར་ཤོག།",
    "ཁྱད་པར་མཁའ་འགྲོ་གསང་བ་ཡེ་ཤེས་ཀྱི།",
    "དངོས་གྲུབ་ལེགས་པར་འབྱིན་ལ་གསོལ་བ་འདེབས།",
    "ཁྱད་པར་སྔོན་གྱི་མཁའ་འགྲོའི་བཀའ་དམ་བཞིན།",
    "ཟབ་ལམ་རིམ་གཉིས་འདབ་གཤོག་རྣམ་པར་བཀྲ།",
    "སྙོམས་པར་ཞུགས་པའི་སྔོན་གྱི་སྐྱེ་བ་སོགས།",
    "བཀའ་ཉན་འཕྲིན་ལས་བསྒྲུབ་པའི་ཞལ་བཞེས་ཚུལ།",
    "འགྲུབ་པར་ལུང་བསྟན་མཛད་ལ་གསོལ་བ་འདེབས།",
    "ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བའི་རིག་སྔགས་དང་།",
    "འཇའ་ཚོན་ཀློང་བཞུགས་སྤྱི་བོར་ཕྱག་བྱུགས་ནས།",
    "ཉམས་རྟོགས་རྒྱས་པར་མཛད་ལ་གསོལ་བ་འདེབས།",
    "ཚུལ་བཞིན་འགོད་པར་མཛད་ལ་གསོལ་བ་འདེབས།",
    "མཛད་འཕྲིན་དགོངས་མཛད་ལྷུན་གྱིས་འགྲུབ་པར་ཤོག།",
    "བླ་རྒན་ཡོང་ན་འགྲོ་དགོས་ཟེར་བའི་བྱིས་པ་རྟགས་མཚན་ཁྱད་པར་ཅན་ཞིག་ཡོད་ཚུལ་གསུངས་པས་རང་ལ་སྔར་རྨི་ལམ་གྱི་མཚན་མར་ལན་གྲངས་དུ་མར་བྱུང་བའི་ཚུལ་དང་ཡང་ཡོངས་སུ་འགྲིག་པར་མཐོང་ནས་ཐུགས་ཤིན་ཏུ་མཉེས་ཤིང་།",
    "ཆུ་སྦྲུལ་ས་ག་ཟླ་བའི་ཚེས་བཅོ་ལྔའི་ཉིན་སྐུ་གོང་མའི་སྐུ་གདུང་མཆོད་རྟེན་ཡོངས་སུ་གྲུབ་ནས་སྐུ་མཆོག་མཐོང་བ་དོན་ལྡན་ནང་བཞུགས་སུ་གསོལ་ཏེ།",
    "བསྐལ་པ་རྒྱ་མཚོར་མི་སྐྱོ་སྤྱད་པར་བགྱི།",
    "ཡུ་བ་དམ་པ་འདི་བར་བསྟན་ནས་མ་ཉམས་པར་བྱུང་བ་ལ་ཐམས་ཅད་ངོ་མཚར་དུ་གྱུར་ཅིང་།",
    "ཐཱ་ལ་ཚང་ནས་ནམ་དུ་ཡང་ཁྱེད་ལ་ཐུགས་ལྷག་པར་དགྱེས་པས།",
    "རྒྱལ་བ་གོང་མའི་སྐྱེ་བར་ཞལ་བཞེས་པ།",
    "ལམ་རིམ་ཆུང་ངུ་སོགས་ཐུགས་འཛིན་གནང་བ་མ་ཟད།",
    "སྐུ་ཚེ་ཕྱི་མའི་ཚེ་འདུ་ཁང་འདི་ག་རང་དུ་མཚན་ཉིད་གྲྭ་ཚང་ལེགས་པར་བཙུགས་པ་མ་ཟད།",
    "རྙེད་པར་མ་གྱུར་སྲས་བཅས་རྒྱལ་རྣམས་ཀྱིས།",
    "མཆོག་ཏུ་མི་འགྱུར་བའི་བདེ་བ་ཆེན་པོར་རོ་མཉམ་པ་འོད་གསལ་ཕྱག་རྒྱ་ཆེན་པོའི་ངང་དུ་མཉམ་པར་བཞག་པའི་ཚུལ་བསྟན་ཏེ།",
    "དགོངས་རྫོགས་ཀྱི་ཆོ་ག་རྣམས་ལེགས་པར་བསྟར་ཞིང་།",
    "རླབས་ཆེན་ཐུགས་བསྐྱེད་བཟང་པོ་བཞེས་པ་བཞིན།",
    "ཅེས་བྱ་བ་ལྗགས་རྩོམ་གནང་བ་གྲྭ་ཚང་ལ་ཚོགས་འདོན་དུ་བཙུག་ནས་གསོལ་བ་རྩེ་གཅིག་བཏབ་པས།",
    "༡རིགས་ཕུན་སུམ་ཚོགས་པར་སྐུ་འཁྲུངས་ཤིང་དགེ་ཚུལ་གྱི་སྡོམ་པ་བཞེས་པའི་རིམ་པ།",
    "གཅིག་ཉིད་ལས་ཀྱང་གདུལ་བྱའི་ཁམས་ཀྱི་རྫིང་བུ་ཐ་དད་པར།",
    "ཁྱད་པར་ཡིད་ཅན་ཀུན་གྱི་དགའ་བདེའི་དཔལ།",
    "བརྗོད་པར་རྩོམ་པ་མཁས་རྣམས་བཞད་གད་རྒྱུ།",
    "དྲི་མེད་ལེགས་པར་གསུངས་པའི་རྗེས་འབྲངས་ཏེ།",
    "དེ་སྲས་བདག་ཉིད་ཆེན་པོ་རྣམས་ཀྱིས་སྐལ་བ་དང་ལྡན་བའི་གདུལ་བྱ་རྣམས་ཀྱི་དོན་དུ་གང་ལ་གང་འདུལ་གྱི་སྤྲུལ་པའི་བཀོད་པ་སྣ་ཚོགས་པ་མིག་འཕྲུལ་དང་ཆུ་ཟླའི་རོལ་གར་བཞིན་དུ་སོ་སོའི་སྐྱེ་བོའི་སྨྲ་བསམ་གྱི་ཡུལ་ལས་འདས་པ་དག་སྟོན་པར་མཛད་པ་ལས།",
    "དེ་ཡང་བདག་ཉིད་ཆེན་པོ་འདི་ཉིད་གང་དུ་སྐྱེ་བ་བཞེས་པའི་ཡུལ་ནི།",
    "ནོར་ལ་འཛིན་ཆགས་ཆུང་བ་སོགས་བསྔགས་འོས་ཀྱི་ཡོན་ཏན་དུ་མས་རྣམ་པར་བརྒྱན་པ་ཞིག་གོ།",
    "ཞུམ་པར་མ་བྱེད་སྤྲོ་བ་སྐྱེད།",
    "ཕྱག་དྲིལ་ན་བཟའ་སོགས་གནང་ཆ་སྦམ་མཐོ་བ་སྩལ་ཏེ།",
    "ཁྱེད་ཀྱི་སྐུ་ཚེ་གོང་མ་རྣམས་ནས་བསྟན་འགྲོའི་དོན་རླབས་ཆེན་མཛད་པ་བཞིན་ཉིད་ནས་ཀྱང་བསྟན་པ་ལ་བྱ་བ་རྒྱ་ཆེན་པོ་མཛད་དགོས་ཚུལ་གྱི་ཞལ་གདམས་མང་དུ་གནང་སྟེ།",
    "མཁྱེན་དཔྱོད་ཧུབ་ཀྱིས་ལྷག་མེད་གསོལ་བ་ན།",
    "མཁྱེན་ཡངས་རྒྱ་མཚོའི་ཀློང་དུ་ཞུགས་གྱུར་ཀྱང་།",
    "གདན་སར་ཕྱིར་ཕེབས་པའི་ལམ་བར་གྱི་སྒར་ཐོག་ཏུ་ཆར་བབ་སྟེ།",
    "བསྟན་འགྲོའི་དོན་དུ་དགུང་ལོ་བརྒྱད་ཅུར་བཞུགས་དགོས་ཚུལ་གྱི་བརྟན་བཞུགས་དང་སྐྱབས་འཇུག་ཞུས།",
    "ཕྱིར་ཕེབས་ནས་མ་འགྱང་བར་མ་དགོན་དུ་ཕེབས་ཏེ་ནག་པོ་ཆེན་པོ་གུར་ཞལ་རང་བྱོན་དང་།",
    "འདྲེས་ཀྱང་རྟག་ཏུ་གྲོགས་བྱེད་ཅེས་རྡོ་རྗེའི་གཡར་དམ་ཞལ་གྱིས་བཞེས་ཤིང་བཙན་མདུང་དང་བཅས་གནང་།",
    "དེ་ནས་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་ཆེན་པོར་བསྙེན་རྫོགས་ཀྱི་སྡོམ་པ་སྩལ་པའི་ལེགས་འབུལ་དུ་སྐུ་གསུང་ཐུགས་རྟེན།",
    "གཟེངས་བསྟོད་བཀའ་ཤོག་གདུགས་རྟ་དར་ཏོག་བཅས་སོགས་གནང་ཆ་སྦམ་མཐོ་བ་སྩལ།",
    "སྙེ་ཐང་བསམ་ཡས་སོགས་རྟེན་དང་གནས་ཁྱད་པར་ཅན་སོ་སོར་མཆོད་འབུལ་དང་བསྟན་འགྲོའི་ཕན་བདེ་རྒྱས་པའི་ཐུགས་སྨོན་རྒྱ་ཆེར་མཛད།",
    "ཕྱིར་ཕེབས་ཏེ་ཟླ་བ་བཅུ་གཉིས་པའི་ནང་མཚན་ཉིད་གསར་ཚུགས་ཀྱི་རིམ་གྲོ་ལ་ལྕགས་མཁར་ཚུགས་དགོས་པའི་གསུང་བཀོད་གནང་སྟེ།",
    "སླར་འཚོགས་ཏེ་བསྟན་འབར་མ་གསུངས་ནས་བསྟན་པ་ཡུན་རིང་དུ་གནས་པའི་ཐུགས་སྨོན་ཤུགས་དྲག་མཛད།",
    "སྐུ་རིམ་དམ་བཅའ་རྩོད་པ་སོགས་ལེགས་པར་བྱེད་པའི་བཀོད་ཁྱབ་མཛད།",
    "མཚན་དང་གཟུངས་སྔགས་ཁྱད་པར་ཅན་རྣ་ལམ་དུ་སྒྲོགས་པ།",
    "དེ་ནས་གདན་སར་ཕྱིར་ཕེབས་ནས།",
    "མཐའ་སྐོར་དུ་ཡིག་དྲུག་དང་འཁོར་ལོས་བར་མཚམས་མེད་པར་བསྐོར་བ་སོགས་ལྷར་བཅས་སྐྱེ་དགུའི་མཆོད་སྡོང་ཆེན་པོར་གྱུར་པའི་རྟེན་བརྟེན་པ་ཡོངས་སུ་རྫོགས་པ་ལོ་ལྔའི་ནང་དུ་ལེགས་པར་གྲུབ་སྟེ།",
    "ཧོར་ཚང་སྒར་ལུང་གཞུང་ལ་སྣར་ཐང་བརྒྱ་རྩའི་རྗེས་གནང་སྩལ་ཞིང་།",
    "ཤིང་སྒོ་དང་འབག་ཆེན་སོགས་ནས་རྒྱ་དཔོན་འགས་གདན་དྲངས་པར་སོ་སོར་བསྔོ་སྨོན་དང་ཤིས་བརྗོད་སོགས་གནང་ཞིང་།",
    "གུང་ཐང་བླ་བྲང་དུ་གསུང་འབུམ་གྱི་པར་བསྒྲུབ་པའི་ཐེབས་སུ་དངུལ་དང་རྟ་དྲེལ་བཅུ་ཕུལ།",
    "འདོད་ལྷ་སྣ་ཚོགས་ཀྱི་རྗེས་གནང་དང་།",
    "ཐུགས་རྗེ་ཆེན་པོ་སོགས་ལྷག་ལྷ་མང་པོའི་རྗེས་གནང་།",
    "ལྡེམ་ལྡེམ་ལུས་ཀྱི་སྡོང་བུ་རྣམ་པར་དུད།",
    "རྒྱལ་ཁམས་བསྐོར་བའི་ཚུལ་མིན་པར།",
    "ཕྱག་རྫས་ཀྱི་གནང་སྦྱིན་ཕངས་མེད་དུ་སྩོལ་བ་སོགས་ཐབས་མཁས་ཀྱི་མཛད་པ་སྣ་ཚོགས་པས་འདུམ་པར་མཛད་པ་དང་།",
    "ཟབ་ཡངས་མཁྱེན་བརྩེའི་སྤྲིན་སྔོན་བ་གམ་ནས།",
    "སྐུ་བསྙུན་ཅུང་ཟད་ཡོད་པས་ཞབས་ཕྱི་རྣམས་ནས་མ་ཕེབས་ན་བཟང་ཞེས་ནན་གྱིས་ཞུ་བ་ཕུལ་ཀྱང་མ་གསན་པར་ཆིབས་བསྐྱོད་དེ་གཟའ་ཚོང་སོགས་བརྒྱུད་ནས་སེ་བོ་རོང་དུ་ཕེབས།",
    "དགའ་ལྡན་ལྷ་བརྒྱ་མའི་ལུང་ཁྲིད་སོགས་རྒྱས་པར་སྩལ་ཞིང་དངོས་འབུལ་ཕོན་ཆེ་བ་སྤྱན་ལམ་དུ་བསྟར།",
    "ཞེས་སོགས་ཐེ་ཚོམ་དུ་འགྱུར་བའི་གསུང་མང་དུ་ཕེབས་ཀྱང་ཅི་ཡིན་གྱི་དོགས་པ་མ་ཞུགས་སྣང་།",
    "རྒྱལ་ཟླའི་བཅུ་དགུར་ལྕགས་མཁར་འཕེན་པའི་དུས་ཡིན་གསུངས་ཏེ།",
    "ཆེན་སྤྲུལ་པའི་སྐུ་བློ་བཟང་རྒྱལ་མཚན་སེངྒེ་དཔལ་བཟང་པོ་སྤྱན་དྲངས་ཏེ་མཆོག་ཁྲུས་སོགས་ཕུལ་བར་དངུལ་སྲང་ལྔ་བཅུ་དང་གོས་ཕྲུག་སོགས་ཀྱི་དངོས་འབུལ་བཏེགས་ཤིང་རྗེ་དེ་ཉིད་ནས་ཀྱང་གང་ཅིའི་བསླབ་སྟོན་དང་བཀའ་མཆིད་ཡིད་ཚིམ་པ་གནང་།",
    "འདིར་འབད་ལེགས་བྱས་དག་བྱེད་གཙང་མའི་ཆབ།",
    "ཅེས་པ་འདི་ཡང་གསོལ་བ་འདེབས་པ་པོ་ཉིད་ཀྱིས་པར་གྱི་མཐུན་རྐྱེན་ཡང་སྦྱར་ཏེ་བསྒྲུབས་པའི་སྨོན་ཚིག་ཏུ་བྱེད་པ་པོ་གོང་མཚུངས་སོ།",
    "ཟླ་བྲལ་ཐུགས་བསྐྱེད་གོ་ཆ་བཞེས་པ་བཞིན།",
    "འདུ་འབྲལ་མེད་པར་སྲུང་ཞིང་སྐྱོབ་མཛད་པས།",
    "མི་མཐུན་བགེགས་ཀྱི་གཡུལ་ལས་རྣམ་པར་རྒྱལ།",
    "ཡབ་གཅིག་མཁྱེན་གཏེར་བསྟན་པའི་སྒྲོན་མེ་ཡིས།",
    "ས་གསུམ་རྒུད་པའི་མུན་ཚོགས་འབྲོས་པར་ཆས།",
    "ཀུན་རྟོག་བཞོན་པར་བཅས་པ་དབྱིངས་སུ་བཅོམ།",
    "དབུས་གཙང་ཤར་རིའི་སྤོ་ནས་དལ་གྱིས་དྲངས།",
    "སྒྲིབ་མེད་ས་ལེར་མཁྱེན་ཅིང་གསུང་མཛད་པས།",
    "རྫོགས་ལྡན་མྱུ་གུ་གསར་བས་ཁྱབ་པར་མཛད།",
    "རྒྱུན་མི་ཆད་པར་བྱུང་ལ་གསོལ་བ་འདེབས།",
    "དཔག་ཡས་ངོམ་མེད་བཞེས་ལ་གསོལ་བ་འདེབས།",
    "བྱིས་བློའི་ཡུལ་ལས་འདས་པར་བཞེངས་པ་སོགས།",
    "རང་ཉིད་ཞི་བར་བགྲོད་ལ་མི་སེམས་པར།",
    "ཕྱིན་དྲུག་བསྡུ་བཞིར་སློབ་པར་གསོལ་བ་འདེབས།",
    "ཀུན་རྨོངས་དྲུངས་ནས་འབྱིན་པར་གསོལ་བ་འདེབས།",
    "ཁྱད་པར་ཡོངས་རྫོགས་ལམ་བཟང་སྒྲུབ་པ་ཡིས།",
    "གུ་ས་ལི་༧མི་ཕམ་དབྱངས་ཅན་དགེས་པའི་རྡོ་རྗེས་བྲིས་པའོ། ། རོང་ཆེན་བསྟན་པའི་སྒྲོན་མེ་ཆེན་པོ་སྐལ་བཟང་བློ་གྲོས་ཀུན་དགའ་ལུང་རྟོགས་རྒྱ་མཚོ་དཔལ་བཟང་པོའི་རྣམ་པར་ཐར་བ་གསེར་གྱི་གར་བུ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "གྲལ་དུ་བསྒྲིགས་པར་ཡབ་དང་སྲས་ཀྱི་ཚུལ།",
    "ཁྱད་པར་སྟོབས་བཅུའི་འདབ་སྟོང་གྲོལ་བ་ཡིས།",
    "རབ་གཙང་བསྟན་པའི་སྣང་བ་སྤྲོ་བའི་གཙོ།",
    "རྒྱལ་བའི་བསྟན་པ་ལ་བྱ་བ་རྒྱ་ཆེར་བགྱིད་པའི་དོན་དུ་བསྟན་འཛིན་གྱི་སྐྱེས་བུ་རིམ་པར་སྦྲུལ་པ་ནི་གོར་མ་ཆག་པ་ཞིག་གོ།",
    "སྐུ་གོང་མའི་ཡང་སྲིད་འཁྲུལ་མེད་དུ་ངོས་འཛིན་ཐག་གཅོད་གནང་བའི་སྐོར།",
    "འཇིག་རྟེན་གྱི་བློ་རིག་རྩལ་གསུམ་འཛོམས་པའི་དྲེགས་ལྡན་བར་མ་ཆད་པར་བྱུང་བ་ལས།",
    "ཞལ་བཞུགས་པའི་སྐབས་ལྟ་ཞོག་ཕྱི་རྗེས་ཀྱི་བྱ་བ་མང་པོ་ཡང་ལྗགས་བཀོད་ཀྱིས་ཟིན་པར་མཛད་པ་ཞིག་གོ།",
    "མ་སོགས་བདུན་བརྒྱུད་ཚུན་ཆད་ལེགས་པར་འབྲེལ་བའི་ཆོ་འབྲང་ཕུན་སུམ་ཚོགས་པ་གསུངས་པ་རྣམས་ཚང་བར་མངའ་བ་ཡིན་ནོ།",
    "དེ་ནས་བཟུང་རི་ཁྲོད་པ་དེས་གཙང་སྦྲ་དང་།",
    "དེའི་སྟོབས་ཀྱིས་ལུས་སེམས་བདེ་བ་ཁྱད་པར་བས་གང་བ་དང་།",
    "འབད་མེད་ལྷུན་གྱིས་གྲུབ་པར་མཛད་དུ་གསོལ།",
    "གང་ནས་ཕེབས་པའི་ཕྱོགས་སོགས་གསལ་བའི་རྨི་ལྟས་མཆོག་དམན་རྣམས་ལ་མང་དུ་བྱུང་བ་ལས་འདིར་ནི་མཚོན་བྱེད་ཙམ་སྟེ་ཞིབ་ཏུ་འགོད་པའི་ངལ་བ་མ་བྱས་སོ།",
    "རྡོ་རྗེ་འཆང་སཾགྷའི་ཞབས་ལ་ཡང་སྤྲུལ་མྱུར་གསལ་གྱི་དོན་སྐོར་ཞུས་པའི་ཕྱིར་ཕེབས་སུ་གསེར་ཞུན་གྱི་འཇམ་དབྱངས་བྲིས་སྐུ་སྟོང་ཚར།",
    "རྗེ་འདི་ཡབ་རྗེ་གོང་མའི་ཡང་སྤྲུལ་གྱི་འོས་ཐོ་གཅིག་ཆོག་ལྟ་བུར་བྱས་ཆོག་མིན་དང་།",
    "ཕྱིས་དོན་དང་འབྱོར་བས་ཐམས་ཅད་ཡ་མཚན་པར་གྱུར།",
    "རྒྱལ་བ་ཐམས་ཅད་མཁྱེན་པས།",
    "སྐུ་ཚའི་བྱིས་པ་དེ་ག་ལ་གཙང་སྦྲ་དང་ཞབས་རིམ་ལ་འབད་ན་ལེགས་ངོ་ཤར།",
    "དྲུང་འཁོར་རྣམས་སྐུ་ཁམས་བདེ་ཞིང་དོན་ཡོད་པའི་བྱ་བཞག་ལ་གཞོལ་བའི་ཐད་ནས་ཕྱག་བྲིས་རྟེན་ལྡན་བསྐུར་གནང་འདི་བཞིན་འབྱོར།",
    "འཕགས་ཆེན་དམ་པའི་གསང་གསུམ་གྱི་རང་བཞིན་མཚོན་པར་ག་ལ་ནུས་ཀྱང་།",
    "སྐུ་དབོན་ཆེ་ཆུང་ལས་གཞན་ལ་གསང་དམ་པར་མཛད་དེ།",
    "མགོན་པོ་གུར་ཞལ་གཉིས་ཀྱི་བསྐང་བཤགས་འབུམ་ཐེར་གཅིག་དང་ཁྲི་ལྔ་དང་སྟོང་ཁ་ཤས།",
    "རྒྱལ་པོའི་བསྐང་བཤགས་ཁྲི་ཁ་ཤས།",
    "ཞེས་གསུངས་པ་དང་།",
    "དབྱར་རས་གུར་ཞིག་ན་བཞུགས་སྐབས་ཐུགས་འཇིགས་པའི་རྣམ་པས་བྲོས་ཏེ་ཡབ་རྗེ་གོང་མའི་སྐུ་སྲིང་སྒྲོལ་མའི་པང་དུ་བཞུགས་པ་ན་ཉེ་འཁོར་གྱི་ཤིང་སྡོང་ཞིག་ལོག་པའི་འུར་སྒྲ་ཐོས་པ་དང་།",
    "རྗེ་འཇམ་དབྱངས་བཞད་པར་མཇལ་དུ་ཁྱེར་བས་ཕྱག་གཉིས་གདངས་ཙམ་ལས་ཕྱག་མཇལ་མ་གནང་བ་དང་།",
    "རྣམ་པར་དཀར་བའི་སྤྱོད་ཚུལ་སཱ་ལུའི་འབྲུ།",
    "ཅེས་པ་ནི་བྱིས་པའི་རོལ་རྩེད་སྐབས་ཀྱི་མཛད་པར་བསྔགས་པའི་བར་སྐབས་ཚིགས་བཅད་དོ།",
    "བཞུགས་གདན་རྒྱབ་ཡོལ།",
    "ཀུན་མཁྱེན་འཇམ་དབྱངས་བཞད་པའི་གསུང་ལན་གྱི་ཡི་གེ་གཉིས་ཕུལ་བར།",
    "ཁྱེད་ཅག་ཀུན་ཡིད་ཆེས་པའི་གནས་སུ་གཟུང་འོས་པ་ལགས་སོ།",
    "ལྷ་རྫས་སེར་བོ་དང་བཅས་རྒྱལ་ཚབ་ཚང་ལ་གནང་།",
    "བཞེས་སྤྲོ་སྣ་དགུདངུལ་རྟ་རྨིག་མ་གསུམ།",
    "ཚེས་བཅུ་གསུམ་ལ་གནས་སྒོའི་ཐང་དུ་བཞུགས་གནས་ཀྱི་གྲ་བསྒྲིགས་བགྱིས་པར།",
    "དེང་འདིར་མཆོག་སྤྲུལ་དམ་པར་རྡོ་རྗེ་ཚེ་ཡི་དངོས་གྲུབ་ཆར་དུ་སྙིལ།",
    "བཀྲ་ཤིས་གང་ཞིག་རྣམ་འདྲེན་ཡོངས་ཀྱི་མཁྱེན་རབ་མ་ལུས་གཅིག་བསྡུས་པ།",
    "གཞན་ཡང་ཀུན་མཁྱེན་འཇམ་དབྱངས་བཞད་པ།",
    "ཚོགས་པ་སུམ་སྟོང་ཙམ་ཚོགས་ཀྱང་བག་ཚ་བས་ཞུམ་པ་ཅུང་ཟད་ཀྱང་མེད་པར་སྐུ་གོང་མ་རྗེས་དྲན་གྱི་རྐྱེན་དུ་འགྱུར་བའི་མཛད་སྒོ་མང་ཙམ་ངོམ་པར་མཛད།",
    "ཤིས་བརྗོད་དང་བཅས་འབྲས་དཀར་གྱི་ཆར་ཕབ་སྟེ་བཞུགས་གྲལ་གྲོལ།",
    "ཧོར་ཚང་སོགས་ནས་ཁྲི་འབུལ་གྱི་མི་སྣ་ཟམ་མ་ཆད་པར་བྱུང་ཞིང་།",
    "ལོ་རྗེས་མའི་དྲུག་པའི་ནང་གུར་སྒར་དུ་བཞུགས་གདན་འཇགས་སྐབས་རྐ་ཆུ་ཁ་བས་གསོལ་རྡོར་སྐམ་ལུག་འགའི་སྲོག་ལ་བསྡོ་བར་རྩོམ་པ་ལ་སྤྱན་ཆབ་བཏང་སྟེ།",
    "སྦྱིན་བདག་ལ་མཇལ་ཁ་མ་གནང་བས་མཚོན་སྔ་ཕྱིར་བརྩེ་བའི་རང་མདངས་ཡང་ཡང་ངོམ་པ་ནི།",
    "དགུན་ལྷ་འབྲུམ་གྱི་དོགས་གཞིར་བརྟེན་ཁའི་རི་ཁྲོད་གཟིམ་ཁང་དུ་འགོལ་བཞུགས་སྐབས་རྒྱལ་ཚབ་མཆོག་ཧོར་ཚང་དུ་ཕེབས་རྒྱུའི་ཐོན་ཕྱག་ཏུ་ཕེབས་པར།",
    "ཨ་ལགས་མ་ཕེབས།",
    "མ་འགྱངས་པར་རྐྱང་ཚའི་ཆུ་རྒྱུད་དང་རྐེད་རྒྱུད་ནས་ཀྱང་ལྷ་འབངས་སུ་ཁས་བླངས་ཏེ་མཇལ་ཕྱག་ཏུ་བཅར།",
    "རིན་འབྱུང་གྲས་འཇམ་དབྱངས་དམར་སེར་གྱི་རྗེས་གནང་གསན་ཅིང་།",
    "སྐུ་དབོན་ཞི་བར་གཞོལ་བའི་དགེ་རྩ་ཡང་ཞར་ལ་བསྒྲུབ་པར་བྱའོ།",
    "ཚེས་བཅོ་ལྔ་ལ་རྨ་འགྲམ་བཞུགས་སྒར་ནས་ཕེབས་ཏེ་བཅུ་དྲུག་ལ་འཁྲུངས་གཞིས་སུ་བཞུགས།",
    "ཚེས་བཅུ་ལ་སྐུ་དབོན་དམ་པས་གཙོས་ཞབས་ཕྱི་བྱིངས་འབྱོར་ཏེ་ནང་རྒྱལ་ཐང་དུ་བཞུགས་གནས་ལྡིང་གུར་སེར་བོས་གཙོས་སྒར་ཆེན་བཏབ་པར་མ་ཡུམ་བླ་ཁོ་ནས་དཀར་དམར་གྱི་སྤྲོ་སྟོན་བཟབས།",
    "ཞབས་གྲས་བྱིངས་ནས་སྤོས་སྣ་དང་བཅས་དམིགས་བརྩེ་མ་དབྱངས་སུ་བྱས་ཏེ་ཁྲི་ཁར་སྤྱན་དྲངས་འཕྲལ་དཀར་ཕྱོགས་ལ་དགའ་བའི་ལྷ་ཀླུ་རྣམས་ཀྱིས་མཆོད་བཀུར་གྱི་ལྟས་སུ་ཁ་ཆར་འདྲེས་མ་བབས།",
    "ཁྲིར་ཕེབས་ཀྱི་ཐུགས་འཛིན་མཚམས།",
    "མཆོག་སྤྲུལ་མཐོང་བ་དོན་དང་ལྡན་པ་ཉིད་དགྱེས་འཛུམ་ཟླ་བའི་འོད་དཀར་དཀྲིགས་ཏེ་བཞུགས་སྟབས་ལྷོད་ཆགས་ཤིང་བརྗིད་བག་དང་ལྡན་པ་སོགས་རྗེ་གོང་མ་ཇི་ལྟ་བ་བཞིན་མཛད་ནས་ཕེབས་བྱམས་ལ་བཞུགས།",
    "ཅེས་གསུངས་པ་ལྟར་རང་ཅག་རྣམས་ཀྱི་རྣམ་འདྲེན་གོང་ན་མེད་པའོ་སྙམ་དུ་བཀུར་སྟི་དང་རིམ་གྲོ་ལ་བརྩོན་པའི་ཕྱིར་བསུ་བཀོད་ཀྱི་རིམ་པ་སྔ་ཕྱིར་བསྟར་བ་ལས།",
    "ཁྲིར་ཕེབས་ཀྱི་ལེགས་འབུལ་དང་བོར།",
    "དུང་གཡས་འཁྱིལ་མཆུ་གཤོག་དངུལ་ལས་བྱས་པ་སྲང་ལྔ་བརྒྱ་རི་བ།",
    "བཞུགས་གདན་རྒྱབ་རྟེན་རང་འགྲིགས་དང་བཅས་ཕུལ།",
    "ཡབ་བཞག་སྡོམ་དཔོན་པོ་སྦྱིན་པར་གོས་སྔོན་པོའི་ལྭ་བ་རྩེར་སོན།",
    "བཞུགས་གདན་རྒྱབ་རྟེན་བཅས་ཕུལ་ཅིང་།",
