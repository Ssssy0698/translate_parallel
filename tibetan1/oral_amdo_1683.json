    "སང་ཉིན་གྱི་དུས་ཚོད་སྟེང་གི་མེ་འཁོར་གྱི་སྤ་སེ་ཉོས་ཡོད་པས་སང་ཉིན་ང་རང་སྐྱེལ་མ་བྱེད་དུ་ཡོང་མི་ཐུབ།",
    "ཀུ་རེ་ཡིན།",
    "ཨང་བའི་དྲ་མིག་ཁ་ན་མིག་ཟུང་མཆི་མས་བརླན་པའི་བུ་མོ་ཞིག་འདུག་མེ་འཁོར་གྱིས་དུང་སྒྲ་རིང་མོ་ཞིག་བསྒྲགས་པ་དང་མཉམ་དུ་ཐག་རིང་ཐག་རིང་གི་ཡུལ་དེར་བགྲོད་མགོ་བརྩམས།",
    "སྐྱེལ་མ་བྱེད་མི་རྣམས་རང་རང་སར་ཐོར་སོང་།",
    "ཁོ་རང་དྲང་ཤ་ལེར་བསྲིངས་པའི་ལྕགས་ལམ་གྱི་འགྲམ་དུ་ཕུར་བ་བརྡབས་པ་ཇི་བཞིན་རྒྱང་རིང་དུ་བལྟས་འདུག་དགའ་སྐྱོ་འདྲེས་མའི་ཕྱིར་དྲན་དང་ཆང་རག་གིས་ཁོ་རང་བཟི་བ་ལྟར་གྱུར་ཡོད།",
    "ངས་བསམ་པར་ཕལ་ཆེར་ང་རང་ལ་ལམ་ནོར་ཐེབས་སོང་སྙམ།",
    "ངའི་རེ་སྨོན་དང་བརྩེ་དུང་གི་མེ་ཏོག་བཞད་པའང་བཅོམ་ལ་ཉེ།",
    "ཁྱོད་རང་དང་ཁ་གྱེས་ཁར་དངོས་གནས་འབྲལ་མི་ཕོད་ཅིང་ད་དུང་སྣང་ཚུལ་དེ་བསྐྱར་ཟློས་ཅི་ཙམ་བྱེད་དགོས་སམ།",
    "ཡིན་ནའང་འདི་ནི་ངས་བསམ་གཟས་ནས་བཙལ་བ་ཞིག་རེད།",
    "ཐེངས་འདིའི་གནས་ཚུལ་དེས་ང་ལ་ཕོག་ཐུག་ཆེན་པོ་ཞིག་བཏང་སོང་།",
    "གར་འཁྲབ་ཁང་གི་དམར་ལྗང་སེར་ཁྲའི་གློག་སྒྲོན་འོག་ཏུ་ཡོད་ཚད་ལ་ཕྱིར་དྲན་བྱས་ཆོག་ལ་མ་བྱས་ཀྱང་ཆོག་ཡིན་ནའང་མིག་ལམ་དུ་འཆར་བ་ནི་ཁྱོད་ཀྱི་གཟུགས་བརྙན་ཁོ་ན་རེད།",
    "ཁྱོད་ཀྱི་གནས་ཚུལ་ཕྲན་ཙམ་ཨེ་གོ་སྙམ་ནས་རོལ་དབྱངས་ཚན་པ་ཞིག་ལ་ལྷན་དུ་ཞབས་བྲོ་བརྒྱབ།",
    "ཁོས་ཁྱོད་ཀྱི་བཟང་མང་བོ་མང་བོ་ཞིག་བརྗོད་བྱུང་།",
    "ང་རང་ལྔ་བཞི་སྐབས་ཁྱོད་ལ་ལྟ་རུ་ཡོང་ཞེས་སྨྲས་པ་མ་ཡིན་ནམ།",
    "ཁྱོད་ཀྱིས་བཟོད་སྒོམ་བྱེད་པར་འཚལ།",
    "ཁྱོད་ཀྱི་དགའ་བསུ་མི་བྱེད་ནའང་ཐང་ཁྱོད་ཚོར་མི་འགྱངས་པར་དཀྱིལ་རྒྱུགས་ལེན་རྒྱུ་ཡིན་ནམ།",
    "ཁྱོད་རང་ཧ་ཅང་ཧ་ཅང་མཐོང་འདོད་སྐྱེས།",
    "འདི་ནི་ངའི་ཐལ་དྲག་པའི་རེ་འདོད་ཅིག་ཡིན་ཡང་སྲིད།",
    "ད་དུང་ཆང་རག་འཐུང་གི་ཡོད་དམ།",
    "ཁོས་དུ་བ་རྐང་གཅིག་ལ་མེ་བསྒྲོན་ཏེ་མལ་ཁྲིའི་ཐོག་ཀན་རྐྱལ་དུ་ལོགདྲ་མ་ལས་འཕོས་འོངས་པའི་དཀར་གསལ་ཟླ་འོད་ཀྱིས་ཁོའི་གདོང་རིས་དཀྱིལ་ལ་ཐིག་བཏབ་པ་ལྟར་དཀར་ནག་གི་ཆ་གཉིས་སུ་བགོས་ཤིང་།",
    "གཏིང་དུ་ལྷུང་བའི་མིག་ཟུང་ལ་གྲིབ་མ་སྟུག་པོ་རེ་བབས་ཡོད་ལ།",
    "དཀར་ཆ་འདུས་པའི་མཁུར་ཚོས་གཡོན་པའི་སྟེང་གི་རྨ་ཤུལ་རྙིང་བ་དེའང་ཅུང་གསལ་བོར་མཐོང་ཐུབ།",
    "མི་ཚེའི་ལྡེབས་རིས་ནི་ཇི་འདྲའི་དགའ་སྐྱོ་འདྲེས་མ་ཞིག་རེད་ཨང་།",
    "ང་ཚོ་ཕྱིར་ལོག་ཁར་པེ་ཅིན་བརྒྱུད་དེ་ཡོང་བ་ཡིན།",
    "ཁོ་མོས་མུ་མཐུད་དུ་སྤྲོ་སྣང་གིས་ང་ཚོ་གནམ་བདེ་སྒོ་མོ་ཆེའི་ཐང་ཆེན་དུ་ལྟ་སྐོར་ལ་འགྲོ་སྐབས།",
    "གནམ་བདེ་སྒོ་མོ་ཆེའི་ཐང་ཆེན་དུ་ཆས་པ་ནི།",
    "ཀ་ན་ཏའི་ཕོ་གསར་ཞིག་གིས་ང་དང་མཉམ་དུ་པར་བརྒྱབ་པར་མ་ཟད།",
    "ཁོ་མོས་ཀུ་རེ་དང་བཅས་ཁོའི་གདོང་ལ་བལྟས།",
    "ཁོས་དཔྲལ་གཉེར་སྟུག་པོ་ཞིག་བསྡུས་ཤིང་ཁ་རོག་གེར་ཉན་འདུགཁྱོད་ཁྱོད་ཁོང་ཁྲོ་ལངས་ཀིན་འདུག་ཧིན།",
    "འོ་ན་འོ་ན་ཁྱོད་ཀྱི་གདོང་གཤིས་སྔར་དང་མི་འདྲ།",
    "ངས་ཁྱོད་ལ་ཀུ་རེ་རྩེ་བ་ཡིན།",
    "ད་ཐེངས་ད་ཐེངས་བྱ་བ་ཅི་བྱུང་ཡུལ་ནས་ང་ལ་ཆུང་མ་ཞིག་བཙལ་སོང་།",
    "འདུ་འཛིས་དབེན་པའི་གནས་དེ་རུ་ཁོ་མོས་ནམ་ཞིག་ནས་བསགས་པའི་མཆི་མ་བཞུར་མགོ་ཚུགས།",
    "ཁྱོད་དུ་དོན་ཅི།",
    "འདི་ནི་ང་རང་ཧ་ཅང་སྤྲོ་བ་སྐྱེས་པའི་འཕྲིན་ཡིག་ཅིག་རེད།",
    "ང་རང་སླར་ཡང་དབེན་འཇགས་ཀྱི་རི་སྒང་སྟེང་དུ་འཛེགས་ཤིང་དགའ་མགུ་བརྗོད་ལས་འདས་པ་ཞིག་རེད་ཨང་།",
    "དེ་སྔའི་གནས་ཚུལ་བྱུང་རྗེས་ང་རང་ཁྱོད་ལ་སྔར་ལས་དུང་བ་སྐྱེས་ཤིང་།",
    "ཁྱོད་དང་འབྲལ་མི་ཕོད།",
    "ཁྱོད་རང་དེ་འདྲ་ཡིན་ནམ།",
    "ཁྱོད་ཀྱིས་འདི་ལྟར་བྱེད་ཕོད་དམ།",
    "ངས་ཁྱོད་ལ་བདེ་སྐྱིད་མང་བོ་ཞིག་ཁྱེར་ཡོང་མ་ཐུབ་པར་མ་ཟད།",
    "དེ་ལས་ལྡོག་སྟེ་ཁྱོད་སྐྱོ་སྡུག་གི་ཁྲོད་དུ་བཙུད།",
    "ཡིན་ནའང་ང་རང་སུན་སྣང་སྐྱེ་སྐབས་དང་ཁེར་རྐྱང་ཡིན་དུས་ཁྱོད་རང་དྲན་སྣང་དུ་གྱུར་པ་དང་།",
    "ཁྱོད་ཀྱིས་ནམ་ཡང་ང་ལ་རྫོགས་མཐའ་བྲལ་བའི་འི་ནུས་ཤུགས་ཤིག་སྦྱིན་པ་དང་འདྲ།",
    "རྗེས་ནས་ཁྱོད་ཀྱང་བདེ་སྐྱིད་ཀྱི་ངང་ནས་གར་འཁྲབ་ཁང་དུ་ཐེངས་མང་བོར་སོང་སྟེ་སྤྲོ་སྤྲོ་གཏོང་བར་འཚལ།",
    "གབསམ་གཏན་ལག་ངས་ཉིན་འདི་དག་གི་རིང་ལ་དུས་ཡུན་སྐར་ཆ་རེའང་སྐྱེལ་བར་དཀའ།",
    "ཕལ་ཆེར་མཐའ་མཇུག་གི་ལོ་མ་དམར་པོ།",
    "འདི་ནི་ང་རང་སྐྱེས་པ་ནས་ཐེངས་དང་པོར་ཕྲད་པའི་ཧ་ཅང་ཀྱག་ཀྱོག་ཆེ་བའི་ལམ་ཕྲན་ཞིག་རེད།",
    "ང་རང་གཅིག་པུ་རི་ཁུགས་ལ་སོང་ནས་ངུས།",
    "མཚན་མོ་ཐ་མག་འཐེན་པས་སྡུག་བསྔལ་སྔར་ལས་དྲག་ཏུ་ཕྱིན།",
    "ངས་ད་ལྟ་རང་གིས་རང་ལ་མནར་སྤྱོད་གཏོང་ཤེས་པར་གྱུར།",
    "ཁྱོད་ཀྱིས་ང་ལ་སྐྱོན་འཛུགས་མི་བྱེད་པར་མཁྱེན།",
    "རྗེས་སུ་ཁོ་མོ་དང་ངེད་གཉིས་ཁྱིམ་གཅིག་ཏུ་འགྲིག་མཐུན་འབྱུང་མི་སྲིད་ཅིང་།",
