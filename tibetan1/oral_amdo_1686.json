    "ཕུར་པ་གཅིག་མཚོ་ལ་བཏབ་པས་མཚོ་སྐམ་སྟེ་ཀླུ་ཕྲུག་ཚོ་ངུ་སྐད་དིར་གྱིས་སོང་ངོ།",
    "བར་སྣང་གི་ལྷ་དང་གཟའ་ཐམས་ཅད་ས་ལ་ལྷུང་བ་ལ་བརྟེན་ནས།",
    "དེ་དག་གིས་ནི་མཐུ་དང་དངོས་གྲུབ་ཇི་ལྟར་བརྙེས་པའི་ཚུལ་ལེགས་པར་བརྗོད་ཟིན་ནས།",
    "ལྷ་ས་ར་མོ་ཆེ་ལ་སོགས་པ་དང་།",
    "རྒྱ་ནག་རི་བོ་རྩེ་ལྔ་ནས་ཡེ་ཤེས་ཀྱི་སྤྱན་གྱིས་གཟིགས་པས།",
    "བར་སྣང་གི་ལྷ་ཕྲན་ཅིག་ཉིད་རང་གི་བུ་རུ་འོང་བའི་རྟགས་ཡིན་ཏེ་འོང་བའི་རྨི་ལམ་དེ་རབ་ཏུ་བཟང་ངོ་ཟེར་ནས་ཡབ་རྒྱལ་པོ་ཡང་ཤིན་ཏུ་དགྱེས་སོ།",
    "ཉོན་མོངས་པ་མི་སྐྱེད་པར་གྱུར་རོ།",
    "ཇོ་མོ་གསུམ་ཁབ་ཏུ་བཞེས་པ་ནི།",
    "ཕོ་སྐྱོང་བཟའ་རྒྱལ་མོ་བཙུན་རྣམས་ཁབ་ཏུ་བཞེས་པ་ལས།",
    "རྒྱལ་པོ་བདག་རང་གི་ཐུགས་དམ་སྔོན་ལ་ལྷ་ཁང་ཅིག་བཞེངས་དགོས་སྙམ་ནས་ཡང་ཡང་ཐུགས་དགོངས་བཀྱེ་བས།",
    "བཙད་པོས་དགུང་ལོ་ཉི་ཤུ་རྩ་གཅིག་ལོན་པ་སྟག་གི་ལོ་ལ་རྨངས་གདིང་བར་བཞེད་ནས།",
    "འགྲོ་བ་མི་རྣམས་ཀྱིས་མོས་པ་བྱེད་པའི་ས།",
    "ཁྱོད་ང་ལ་གདམས་ངག་འདོད་དམ་ཟེར་བ་ལ།",
    "དེ་ནས་རིག་འཛིན་དེས་དགེ་ཚུལ་དེ་ལ་ཁྱོད་རོ་ལ་དཔའ་བའི་རྟགས་ཡོད་པ་ཡིན་པས་མ་འཇིགས་པར་འདིའི་ལྕེ་ཆོད་ཅིག་ལྕེ་དེ་གསེར་གྱི་རལ་གྲིར་སོང་བ་དང་ང་ལ་བྱིན་ཅིག་དེ་གར་གཏད་སར་འགྲོ་བར་ནུས་པ་ཡིན་ཏེ།",
    "དེ་ཁྱོད་ལ་རྔན་པར་སྦྱིན་ནོ་ཟེར།",
    "རིག་འཛིན་ན་རེ།",
    "དེ་ལྟ་ཡིན་མོད་ངས་ལྟད་མོ་བལྟ་ཡིས་ཟེར་ནས་རི་རབ་ཀྱི་ཁར་སོང་ནས།",
    "རོ་གསེར་དུ་གྱུར་པ་དེ་དགེ་ཚུལ་ཁྱོད་གྱིས་ཤིག་འདིས་དགེ་སློང་ལྔ་བརྒྱའི་འཚོ་བ་ལྡངས་ཏེ།",
    "དེ་སྐད་ཟེར་ཏེ་ཁོ་རང་རལ་གྲི་ནམ་མཁའ་ལ་དབྱུགས་ཏེ་འོག་མིན་དུ་སོང་ངོ།",
    "བྷ་ལིཾ་བྱས་པས་བྱ་རོག་གིས་ཁྱེར་ནས་མཚོ་གཅིག་གི་དཀྱིལ་ན་དེའུ་ཡོད་པའི་ཁར་བཞག་དེའུ་དེའི་ཁར་གཙུག་ལག་ཁང་གཅིག་བརྩིགས་ཏེ།",
    "ས་ཁྲུ་གང་ཙམ་གྱི་འོག་ནས་འབྲས་དཀར་མོ་ཁལ་གཅིག་དང་།",
    "མཐུ་མོ་ཆེ་རྣམས་ཀྱི་གཏད་བྱས་ནས།",
    "ཉིན་མོ་བརྩིགས་པ་ནུབ་མོ་བཤིག་ནས་རྩིག་ཏུ་མ་སྟེར་རོ།",
    "དེ་ནས་བཀའ་ལུང་དེ་མངའ་བདག་གི་མནལ་ལམ་དུ་བྱུང་བ་སྐད་མཛད་ནས།",
    "དེ་ལ་འབངས་རྣམས་ན་རེ་འཐད་དོ་རིགས་སོ་ཟེར་ཀྱང་།",
    "དེ་རྣམས་ཐང་ཆད་ཉོན་མོངས་པས།",
    "དེའི་རྩེ་མོ་ལ་ཡོད་པའི་གཤིན་རྗེ་ནག་པོ་དང་།",
    "ད་ལྟ་རྡོ་བ་དེ་ས་ལ་ནུབ་ཀྱང་མོས་པ་བྱེད་པ་ཡོད་གསུང་ངོ།",
    "ཁྱེད་བང་ཆེན་པ་རྣམས་ཉོན་མོངས་ཀྱི་དོགས་ནས་ངས་འདིར་ཡོང་ནས་ཟླ་བ་གསུམ་འདིར་བསྡད་པ་ཡིན།",
    "ཁྱེད་རེ་འགོར།",
    "ང་ལ་སྣང་བ་ཐམས་ཅད་གསེར་དུ་ཡོད་པ་ཡིན་གསུངས་ནས་ཕྱག་གཡས་པ་གུང་ཐང་གི་གཡས་ཕྱོགས་སུ་བརྐྱངས་བས།",
    "ཁྱོད་རང་རྣམས་ང་ལ་ཡིད་ཆེས་པར་གྱིས།",
    "དུས་ཕྱི་མ་ལ་བོད་ཀྱི་གསེར་ཐམས་ཅད་མང་ཡུལ་དང་བལ་ཡུལ་དུ་འབོ་བར་འདུག་གི་གསུང་ངོ།",
    "བདེན་པར་གསེར་དུ་སོང་འདུག་དེར་སོ་སོར་ཡིད་ཆེས་སོ།",
    "མཇུག་མ་ཁམས་ཀྱི་གཡར་མོ་ཐང་དུ་སླེབ་པར་བྱས།",
    "སློབ་དཔོན་གྱི་དབུ་ཞྭའི་སྟེང་དུ་སོལ་བ་རུ་འཐོར་སོང་ནས་བླགས་མ་རྙེད་དོ།",
    "དེ་ནས་བཙང་པོ་ན་མར་བྱོན་ཏེ་དོན་ཁ་རིང་མོར་བྱོན་པ་དང་།",
    "ཞང་ཞུང་གི་དགྲ་ལྷ་སྲིད་པའི་རྒྱལ་མོ་མུ་ཚ་མེད་བྱ་བས་བར་ཆད་བྱ་བར་བརྩམས་ནས་རི་ཆེན་པོ་གཉིས་སུ་བརྫུས་ཏེ་སློབ་དཔོན་དཔོན་གཡོག་རྣམས་རི་བར་དུ་བཅིར་བར་བྱས་པས།",
    "བྲག་གི་ཁ་ན་ཕར་བྱོན་པས་མོ་རབ་ཏུ་དངངས་ཤིང་བྲེད་པར་གྱུར་ཏེ།",
    "དེར་སོར་ཟེར་སོང་ཙ་ན་ཁྲག་སྐམ་པོ་སྲན་མའི་རྡོག་པོ་བདུན་ཙམ་དུ་སོང་འདུག་གོ།",
    "དེ་ནས་མོ་ཡ་མཚན་སྐྱེས་བྲེད་ནས་མོ་དཔལ་མོའི་དཔལ་མཚོ་ལ་བྲོས་སོ།",
    "དེ་ནས་སློབ་དཔོན་གྱིས་དཔལ་མོའི་ལ་ཐོག་ཏུ་སྒྲུབ་པ་ཞག་བདུན་བསྒྲུབས་ཏེ་ཁྲོས་པ་ལས།",
    "མོ་ཤ་རུས་བྱེ་སྟེ་བྲེད་པ་ལ།",
    "སློབ་དཔོན་གྱིས་རྡོ་རྗེ་གཅིག་རྒྱབ་པས་མིག་གཡས་བཅེར་བ་དང་མོས་གུས་པས་བཏུད་དེ་ཞུས་པ།",
    "དེ་ནས་ཐེའུ་ཤ་མོ་ལུང་དུ་བྱོན་ཙ་ན།",
    "ལྕགས་སྒྲོག་གི་ཕྱག་རྒྱས་རྐང་ལག་བཞི་སྒྲོག་ཏུ་བཅུག་དྲིལ་བུའི་ཕྱག་རྒྱས་གཡག་དེ་བཙོག་བརྡུང་བྱས་པས།",
    "དེ་ནས་བྱང་ཟང་ཟང་དུ་བྱོན་ནས་བྱང་གི་འབྲོང་ཆེན་མོ་བརྒྱད་བཏུལ་ནས་དམ་ལ་བཏགས་སོ།",
    "གྲོམ་པ་རྒྱང་གི་ལྷ་ཁང་གི་རབ་གནས་ཀྱང་མཛད་དོ།",
    "ཐང་ལྷས་ཉམས་སད་པར་བྱ་བའི་ཕྱིར་གནོད་སྦྱིན་ཆེན་པོ་ཅིག་གི་ལུས་སུ་སྤྲུལ་ཏེ།",
    "བྱིས་པ་གཡུའི་ཟུར་ཕུད་ཅན་གཅིག་ཏུ་ལོག་གིས་སོང་བ་དང་།",
    "འདི་ལ་ངས་གྲོ་ཅིག་བསླང་གིས་གསུངས་ནས་གཤེགས་སོང་བས།",
    "གཡས་རུ་གཙང་གི་འགྲམ་དུ་ལྷ་ཁང་གི་རབ་གནས་མཛད་དོ།",
    "བྱང་ཕུག་མོ་ལ་སོགས་པ་རྣམས་ཀྱིས་བྱང་ཐུན་གསུམ་གྱི་ལྷགས་པ་ཐམས་ཅད་ཚོན་གཅིག་ཏུ་བྱས་ཏེ།",
    "འཁོར་རྣམས་ཀྱང་རེངས་ལ་ཁད།",
    "དེ་ནས་ཡང་གཙང་གི་གཙང་པོ་ལ་སྡོང་པོའི་གྲུ་ལ་རྒལ་ཏེ།",
    "ཁྱེད་རང་ཆུ་ཟེར་ཅིག་གསུངས་ཏེ་མཐུ་དང་ནུས་པ་ཕུལ་དུ་བྱུང་བའི་རྟགས་ཀྱིས་ཕྱག་འཁར་བྲག་ལ་རྒྱབ་པས་ཆུ་ཅི་འདོད་བྱུང་ནས་བསམ་པའི་དོན་ཐམས་ཅད་འགྲུབ་སྟེ་དིང་སང་གི་བར་དུ་ཡང་གཞོང་པའི་ལྷ་ཆུ་ཞེས་ཀུན་ལ་གྲགས་པ་འདི་ཡིན་ནོ།",
    "ང་ལ་ཕྱག་བྱེད་དེ་འོང་སྙམ་ནས་ཕྱག་ལ་མ་བཟླུམ་མོ།",
    "ཉོན་མོངས་ལོག་པའི་དགྲ་བོ་བཏུལ།",
    "ཁྱོད་གདོང་དམར་སྲིན་པོ་བོད་ཀྱི་རྗེ།",
    "ཉོན་མོངས་དུག་ལྔའི་རྒྱན་གྱིས་བརྒྱན།",
    "ཞེས་གསུངས་ནས་ཐལ་མོ་ཡ་གཅིག་དེངས་མཛད་ནས་ཕྱག་གཡས་ཀྱིས་བཙལ་བས།",
    "ཕྱག་དབུ་ཐོད་བུད་བུད་དུ་བཙལ་ནས་ཞབས་སྤྱི་བོར་བླངས་ཏེ།",
    "ཟས་ཀྱི་གྲབ་གྱིས་བཟོ་བོ་རྣམས་སླེབ་ཡོང་བ་ཡོད་གསུངས་མ་ཐག་བལ་པོ་རྡོ་བཟོ་བ་ལྔ་དཀྲོང་གིས་སླེབ་བྱུང་བས།",
    "ར་རྫི་གཅིག་གིས་ཤིན་ཏུ་ངོ་མཚར་སྐྱེས་ཏེ།",
    "ང་རང་ཡང་འདི་ལྟ་བུའི་མཆོད་རྟེན་ཞིག་འགྲུབ་ན་སྙམ་ར་དཀར་མོའི་འོ་མས་བརྫིས་པའི་ས་ཕག་གི་མཆོད་རྟེན་ཕྲུ་གང་ཞིག་བཞེངས་ཏེ་དཀར་རྩི་སྒྲན་པས།",
    "འདི་ལ་ངོ་མཚར་མཆོད་རྟེན་དུ་མིང་ཐོགས་གསུངས་པའང་དེང་སང་གི་བར་དུ་ཡོད་དོ།",
    "འཇིག་རྟེན་གྱི་སྤྱན་གཟིགས་སྣ་ཚོགས་དྲངས།",
    "ཟ་འོག་གི་སྨུག་བེར་སྐུ་ལ་གསོལ་ནས་བཞུགས་སོ།",
    "བོད་གནོད་སྦྱིན་ཕོ་མོའི་འདྲེ་ཡུལ་དུ་འདུག་པས།",
    "སློབ་དཔོན་གྱི་དབུ་ཞྭའི་སྟེང་དུ་སོལ་བའི་དུམ་བུ་གཅིག་ཏུ་སོང་ངོ།",
    "གངས་ཀྱི་རྩེ་མོ་ཞུད་པོར་སོང་བས།",
    "བན་ཆུང་ཁྱོད་ཀྱི་བཀའ་ནན་ཆེས་པས།",
    "དེར་སློབ་དཔོན་གྱིས་གཏོར་མ་འདི་ཁྱེར་ལ་མངའ་བདག་གི་དགོངས་པ་སྒྲུབས་ཤིག་གསུངས་པས།",
    "ཡང་ཁོ་ན་རེ།",
    "བྱང་ལ་བཙུན་མོ་ཆེ་དང་།",
    "དེར་དཔེ་དཀར་རང་གིས་ཕྱིན་པས་ཀྱང་མེ་འབར་ཏེ་བཤིག་མ་ཐུབ་ནས།",
    "དེ་རིང་གི་མོན་བུ་ཨ་ཙ་ར་དེ་ཡིན་ཐག་ཆོད་པས་སྔགས་ཅི་བཟླའི་ཡོད་དམ་སྙམས་ཉན་དུ་ཕྱིན་པས།",
    "དེ་ཡང་མཁྱེན་ཏེ་རྐང་པ་ལ་ཕུར་པ་གཅིག་བཏབ་པས་རྐང་པ་ཞ་ནས་དེར་འགོང་པོ་སྤུན་དགུས་ཁྱོགས་ལ་བཏེགས་ནས་ངུ་རྫི་དི་རི་རི་སོང་ངོ།",
    "དེ་ནས་ཁོས་ཞང་པོ་ཀླུ་ལ་ས་གཞི་ཐམས་ཅད་ནི་མོན་བུ་ཨ་ཙ་རས་འཕྲོགས།",
    "ད་ཁྱོད་རང་ཡང་སྐྱབས་སུ་སོང་ཟེར་ཏེ།",
    "ཐོག་མར་གནོད་སྦྱིན་གྱིས་སྤྱང་ཀི་ཁྲག་གི་རལ་པ་ཅན་དག་ཏུ་སྤྲུལ་ནས་གནོད་པའི་ཚུལ་དུ་བསྟན་པ་ལ།",
    "དེ་མ་ཐག་སྤྱང་ཀི་རྣམས་རྟ་མཆོག་ཞོན་པའི་སྐྱེས་བུ་བདུན་དུ་གྱུར་ནས་གནོད་སྦྱིན་ཆེན་པོས་བཟོད་གསོལ་ཕྱག་བཙལ་ཏེ་རང་གི་ཚུལ་རྣམས་ཞུས་པའི་ཚེ།",
    "དེ་དུས་ཀྱི་ལོག་ལྟ་ཅན་འགའ་ཞིག་གིས་ལོག་རྟོག་ངན་སྨྲས་བགྱིས་པ་ལ་དུས་མཚུངས་པའི་མཁས་པ་དག་གིས་འདི་སྐད་དུ།",
    "དཔེ་དཀར་དང་དཔེ་ཧར་དུ་སོང་བ་ཡིན་པ།",
    "སློབ་དཔོན་ཆེན་པོའི་གཙུག་ལག་ཁང་གི་སྲུང་མར་བསྐོས་པས་ན།",
    "གཙུག་ལག་ཁང་གི་མིང་རྒྱ་སྐད་དེ་དེའི་སྲུང་མ་ལ་ཐོགས་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དེ་ནས་སློབ་དཔོན་པདྨས་དགེས་བསྙེན་ཉི་ཤུ་རྩ་གཅིག་གཡའ་རི་མོ་དང་།"
  ]
}