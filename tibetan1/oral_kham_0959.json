    "གང་ཞིག་དུས་གསུམ་ཐམས་ཅད་ཀྱི།",
    "དེ་མའི་ལྟོ་ན་འདུག་པའི་ཚེ་ཇི་ལྟ་བུར་སྤྱོད་པ་དང་།",
    "མེར་མེར་པོར་འདུག་པ་ཇི་ལྟ་བུ་ཡིན་པ་དང་རྡོས་པར་གྱུར་པ་ཇི་ལྟ་བུ་ཡིན་པ་དང་།",
    "ནམ་ཡང་རང་བཞིན་མི་འགྱུར་ཏེ།",
    "གདུལ་བྱ་ཡང་དཀོན་པར་འདུག་པས།",
    "དེར་མནལ་ལས་སད་པ་ན་མདུན་དུ་མདུང་ལྕགས་གཏེར་མ་དང་ཐོ་བ་ཞིག་དངོས་སུ་བཞག་འདུག་པས།",
    "ཉིས་འགྱུར་སྟེང་འདུག་གནས་ཀྱི་འོག་མིན་ཡིན།",
    "འཁོར་དུ་འདུག་ན་རྒྱན་དུ་ཇི་ལྟར་འགྱུར།",
    "རང་རང་དབུ་རྒྱུན་རིགས་ཀྱི་ལྷ་ལྔའོ།",
    "འདུག་ན་རྒྱུན་དུ་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "ཆུ་མཚམས་ཡན་ཆད་རང་རང་དཔངས་དང་མཉམ།",
    "གཞན་ཡང་རང་བྱུང་སྐུ་གདུང་མཆོད་རྟེན་སོགས།",
    "རང་རང་ཕྱོགས་ནས་རྒྱ་མཚོར་འབབ་པའོ།",
    "དེ་དག་དུས་གཅིག་ཉི་མའི་འོད་ཟེར་གྱིས།",
    "ཁོ་རང་བྲོས་པའི་ལམ་ན་གོའུ་ཏ་མ།",
    "ནམ་ཞིག་ཙ་ན་ཁྱེའུ་གཉིས་བྱུང་བ།",
    "སྲས་དང་བཅས་ནས་བདེ་བར་གདའ་འོ་ཞུ།",
    "ཁྲུས་བྱས་སེང་གེའི་ཁྲི་ལ་འདུག་པ་ན།",
    "རང་རང་ལས་ཀྱི་སྐལ་བ་ལ་སྤྱོད་པར།",
    "ཁོ་རང་ཆགས་ནས་དགེ་སློང་ཕྱིར་འབྲང་སྐད།",
    "སེམས་མཆོག་བསྐྱེད་ན་འོང་བྱས་ཁོ་རང་དང་།",
    "ང་འདྲའི་རི་དྭགས་འདུག་པ་མ་སྨྲ་ཞེས།",
    "མཚན་དཔེས་བརྒྱན་པ་འཁྲུངས་ཏེ་ཁྱིམ་འདུག་ན།",
    "ལྷ་དེ་དག་ཀྱང་རང་རང་ཁྱིམ་དུ་ནི།",
    "འདུག་པའི་ཤཱཀྱ་ཐུབ་པའང་མཚན་གསོལ་གྲགས།",
    "གང་ལ་འདུག་པར་བརྟག་པའི་ཤཱཀྱ་ཡི།",
    "བརྒྱ་ལ་སྐྱེ་བོ་ཕལ་དང་ཞུགས་པར་གྱུར་ཀྱང་གདའ།",
    "སྒྱུ་རྩལ་ཤེས་བའི་རྒྱུད་ཡིན་ཁྱེང་རང་ནི།",
    "དེ་ཡི་ནུས་པ་བདག་ལ་མི་འདུག་གསུངས།",
    "འགྲོ་འདུག་ཉལ་དང་འཆག་པར་མི་བྱའོ།",
    "གྲལ་གྱི་མཐའ་རུ་ཞུམ་ཞིང་སྐྱེངས་ནས་འདུག།",
    "རང་རང་འདོད་པའི་ཟས་ཀྱིས་ཚིམས་པར་མཛད།",
    "རང་རང་ལུགས་དང་མཐུན་པར་གསུངས་པའང་ཡོད།",
    "བང་རིམ་བཞི་བོ་རང་རང་སུམ་ཆ་ཡི།",
    "བང་རིམ་བཞི་བོ་རང་རང་སུམ་ཆ་ཡི།",
    "རང་རང་སུམ་ཆའི་ཁ་པད་ཀྱིས་མཛེས་པའི།",
    "གཞན་ཡང་རང་བྱོན་འདུ་བྱེད་ལས་བྱུང་བའི།",
    "ངེས་ཚིག་དུས་ནི་བསྐལ་བ་གྲངས་མེད་པར།",
    "བཟའ་དང་བཏུང་བ་སྤངས་ནས་འདུག་པ་ལ།",
    "ཉེ་ལོགས་གཅེར་བུ་པ་ཞིག་འདུག་པ་དེའི།",
    "ཁོ་ཡིས་དེ་ནི་རྩིས་ལ་མཁས་འདུག་སྟེ།",
    "ཁྱིམ་བདག་རབ་ཏུ་བཟང་ཡང་དེར་འདུག་པ།",
    "གཅེར་བུ་བའང་ང་རྒྱལ་མདངས་ཉམས་འདུག།",
    "ཞེས་ཟེར་མ་འགགས་པ་ཡང་རང་གནས་ལོག།",
    "བསམ་བཞིན་མངལ་འཇུག་དུས་ལ་བབས་པ་དང་།",
    "ཡིད་དུ་འོང་བར་འདུག་ལ་རབ་དགའ་ནས།",
    "ང་ལ་ཉེས་པ་མེད་བཞིན་བརྡེག་འདུག་པས།",
    "སླར་ཡང་རང་ཡུལ་ཕེབས་ནས་ཕ་མ་ལ།",
    "དེ་ན་འདུག་པས་ཐོས་ནས་ཁོ་བོ་ཡིས།",
    "གང་ཡང་མི་ཤེས་འདུག་ཅིང་ཁོ་བོ་ནི།",
    "རབ་ཏུ་བྱུང་བས་ཅི་བྱེད་འདིར་འདུག་ཅིག།",
    "འདུག་པ་ལམ་ཆེན་པས་མཐོང་དགྲ་བཅོམ་དུ།",
    "རྗེས་ནས་དེ་ལྟར་འདུག་ཚུལ་སློབ་ཟེར་བར།",
    "ལྟ་སྟངས་ངང་ལ་འདུག་པར་ལམ་ཆེན་པས།",
    "ཅི་ཡང་མི་ཤེས་རབ་ཏུ་བྱུང་འདུག་ན།",
    "སྐྱེ་བོ་ཕལ་བས་སྨད་པར་འདུག་པ་འདིའི།",
    "ཕྱིན་པས་དེ་ན་ལྗོན་ཤིང་ཞིག་འདུག་པའི།",
    "ཤ་ལྤགས་རྣམས་སུ་རྡོལ་ནས་བྱིལ་བོར་འདུག།",
    "འགྲོ་དྲུག་རང་རང་གཟུགས་སུ་ཡོངས་སྤྲུལ་ནས།",
    "རྒྱ་མཚོའི་ཁ་རུ་འོང་ནས་འདུག་པ་ལ།",
    "འདུག་ལ་ངེད་གཉིས་ཀྱིས་ཀྱང་མི་ཚུགས་པའི།",
    "ཁྱིམ་ན་འདུག་ཚེ་བུ་དང་ཆུང་མས་བརྙས།",
    "རང་རང་ལས་དང་མཐུན་པར་མྱོང་ནས་སླར།",
    "འབྲས་བུ་མ་ཐོབ་ཕྱིར་ན་འདིར་ཚུལ་ཤིང་ལོང་ཅིག་གསུངས་པས་དེར་མ་འདུག་ཟེར་བའི་དོན་མ་ཡས་ཡན་ཡིན་མ་འདུག།",
    "གསུམ་པ་ཡིན་ཞེས་ཟེར་བའི་ལུགས་ཀྱང་འདུག།",
    "གསུངས་དང་མ་འོངས་བྱམས་མགོན་བྱོན་ཙ་ན།",
    "བཀའ་ཡི་བགྲོ་བ་བྱེད་པའི་ནང་ན་འདུག།",
    "དེ་ནས་ཁྱེད་རང་ཤེས་ཟེར་ཞག་བདུན་སྔོན།",
    "ཁྱེའུ་ལོ་བརྒྱད་ཟིལ་བ་ཕྲོམ་མེ་འདུག།",
    "ཁྱེད་རྣམས་རྒྱལ་ན་ང་རང་གངྒཱར་ལྕེབས།",
    "ང་རང་རྒྱལ་ན་ཁྱེད་རྣམས་ངའི་གྲུབ་མཐར།",
    "འདུག་ལ་ཤི་ན་ག་ལ་གར་ཡོད་དྲིས།",
    "བསྟན་པ་ཉམས་པར་བྱས་འདུག་དེ་བཟློག་པར།",
    "རིག་ལས་གསུངས་ཏེ་ཁོ་རང་ཐེམ་པར་བསྡད།",
    "ང་རང་ཕྱི་ལ་འདུག་གམ་ནང་དུ་འདུག།",
    "སྔོན་ཚེ་སློབ་དཔོན་གསེར་སྦྱིན་མཛད་ཙ་ན།",
    "མནལ་ལམ་དུ་ཡང་རང་དོན་ཡིད་བྱེད་སྤངས།",
    "འདུག་པ་མུ་སྟེགས་པ་ཡང་ཡིད་ཆེས་སོ།",
    "འདུག་པར་གདམས་སྙམ་ལོ་བདུན་ཅང་མི་སྨྲ།",
    "དེ་ལ་ཐམས་ཅད་ལྐུགས་པར་འདུག་ཅེས་ཟེར།",
    "མི་འདུག་ན་ནི་གངྒཱ་ལ་བསྐྱུར་ཅིག།",
    "གདུགས་ཀྱི་ཡུ་བར་བཟུང་ནས་འདུག་པ་ན།",
    "གུས་པའི་ཚུལ་གྱིས་འདུག་པས་རྒྱུ་དེ་ལ།",
    "མ་གནང་རང་རང་གཟུངས་ཀྱིས་བཟུང་བ་དང་།",
    "སྟ་གོན་བརྩོན་ཞིང་སང་ཕོད་ཙ་ན་ནི།",
    "དེ་ཡིས་སྒྲ་མི་ཤེས་པར་འདུག་ཟེར་བར།",
    "དེ་རྣམས་རང་རང་ངོ་བོའི་ཁྱད་པར་རོ།",
    "བཞུགས་ཀྱིན་འདུག་པ་དེ་ལ་ཕྱག་བསྐོར་བ།",
    "རྒྱལ་བོས་གླེགས་བམ་རྣམས་བརྟགས་རྟོགས་འདུག་ཀྱང་།",
    "རྒྱལ་བོས་རྟོགས་པར་འདུག་ཀྱང་མ་མཁྱེན་ཚུལ།",
    "འདུག་པ་རང་རང་ལུགས་ལ་གསལ་བཞིན་ནོ།",
    "ཁྲུས་ཀྱི་བྱ་བ་མཛད་ནས་འདུག་པ་ན།",
