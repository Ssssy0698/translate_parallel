    "རྒྱས་པར་ནི་སྔ་མ་བཞིན་ནོ།",
    "དེ་གཉིས་ལ་ཡང་གང་ལ་ལྟོས་ནས་གཞན་གང་ཡང་རུང་བ་འགྲུབ་པར་འགྱུར་བའི་གཡས་པའམ།",
    "གཡོན་པར་གྲགས་པ་གང་ཡིན་ཡང་གཞན་ཡང་།",
    "དེ་སྐད་ཟེར་ན་དེ་ལྟ་ན་ཡང་དེ་ནི་ལྟོས་པར་མི་རིགས་སོ།",
    "དེ་ནི་ལྟོས་པར་མི་རིགས་སོ།",
    "ཡང་ན་དེ་ནི་ལྟོས་པར་མི་རིགས་སོ།",
    "དེ་བཞིན་དུ་མེའི་ཕྱོགས་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "སྐྱེ་བ་ཅན་ཡིན་པའི་ཕྱིར་དཔེར་ན་རྣམ་པར་ཤེས་པ་བཞིན་ནོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "དེ་ལ་གསལ་བའི་ཁྱད་པར་ཅན་གྱི་དངོས་པོ་མེད་པའི་ཕྱིར་དཔེ་མེད་པ་མ་ཡིན་ནོ།",
    "རྟོག་གེའི་བསྟན་བཅོས་ཤེས་པ་ཉིད་ཀྱིས་སྒྲའི་མཚན་ཉིད་ལ་མཁས་སོ་ཞེས་ཕྱིར་ཟློག་པར་བྱེད་པ་བཞིན་ནོ།",
    "བསྲེག་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་བསྲེགས་པ་བཞིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པར་བརྗོད་པར་བྱའོ།",
    "འགྲོ་བ་པོ་མ་ཡིན་པ་དེ་དག་ལས་གཞན་པ་འགྲོ་བར་མི་བྱེད་པར་བསྟན་པ་དེ་བཞིན་དུ་དོན་དམ་པར་སྲེག་པ་པོ་དང་།",
    "དེ་དག་ལས་གཞན་པ་ཡང་སྲེག་པར་མི་བྱེད་པ་བསྟན་པར་བྱ་སྟེ།",
    "སྲེག་པ་པོ་མ་ཡིན་པའི་ཕྱིར་དང་གཉི་གའི་སྐྱོན་དུ་འགྱུར་བའི་ཕྱིར་བོང་བ་བཞིན་ནོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "རབ་ཏུ་བྱེད་པའི་དང་པོར་དོན་དམ་པར་ཉེ་བར་ལེན་པ་པོ་དང་ཉེ་བར་བླང་བ་དག་ཡོད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "དེས་ན་དོན་དམ་པར་ཕུང་པོ་ལ་སོགས་པ་དག་ཡོད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "མ་ལུས་པར་ནི་རྣམ་པར་བཤད།",
    "དོན་དམ་པར་བདག་ནི་ཉེ་བར་བླང་བ་དང་གཅིག་པ་ཉིད་མ་ཡིན་ཏེ།",
    "དོན་དམ་པར་བདག་ནི་ཉེ་བར་བླང་བ་ལས་གཞན་ཉིད་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་ཉེ་བར་བླང་བ་ནི་བདག་དང་གཅིག་པ་ཉིད་མ་ཡིན་ཏེ།",
    "དོན་དམ་པར་ཉེ་བར་བླང་བ་ནི་བདག་ལས་གཞན་ཉིད་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་ལྷས་བྱིན་གྱི་བདག་ནི་ལྷས་བྱིན་གྱི་ཉེ་བར་བླང་བ་ཉེ་བར་ལེན་པར་མི་བྱེད་དེ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་ལྷས་བྱིན་གྱི་བདག་གྲུབ་པ་དང་མ་གྲུབ་པ་ནི་ལྷས་བྱིན་གྱི་ཉེ་བར་བླང་བ་ལ་ལྟོས་པར་མི་བྱེད་དེ།",
    "དོན་དམ་པར་ལྷས་བྱིན་གྱི་ཉེ་བར་བླང་བ་ནི་ལྷས་བྱིན་གྱི་བདག་གྲུབ་པ་དང་མ་གྲུབ་པའི་ལྟོས་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "ལྷས་བྱིན་གྱི་བདག་ལྷས་བྱིན་གྱི་ཉེ་བར་བླང་བ་ཉེ་བར་ལེན་པར་མི་བྱེད་དེ་ཞེས་བྱ་བ་དེའི་ཅི་གཞན་ཉེ་བར་ལེན་པར་བྱེད་པ་ཡིན་ནམ།",
    "འོན་ཏེ་ཅི་ཡང་ཉེ་བར་ལེན་པར་མི་བྱེད་པ་ཡིན།",
    "གལ་ཏེ་གཞན་ཉེ་བར་ལེན་པར་བྱེད་པ་ཡིན་ན་ནི་ཕྱོགས་སྔ་མ་ལ་གནོད་དོ།",
    "ཅི་སྟེ་ཅི་ཡང་ཉེ་བར་ལེན་པར་མི་བྱེད་པ་ཡིན་ན་ནི་དཔེ་མེད་དེ།",
    "མཚན་ཉིད་ཀྱི་གཞིར་གྱུར་པ་རྣམ་པ་དེ་ལྟ་བུ་དག་ཏུ་ཤེས་པར་བྱའོ།",
    "དོན་དམ་པར་བུམ་པ་ནི་འཇིམ་པ་ལས་གཞན་ཉིད་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་འཇིམ་པའི་ཕྱོགས་ལ་སོགས་པ་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "སྤྱི་དང་ཁྱད་པར་དང་ལྡན་པ་ཉིད་དང་།",
    "དམ་བཅས་པའི་དོན་ཡང་རྣམ་པར་བརྟག་པར་བྱ་སྟེ།",
    "ཅི་སྟེ་རྒྱུའི་གསལ་བ་འབྲས་བུ་ལ་ཡོད་དོ་ཞེ་ན་ནི་གྲགས་པའི་གནོད་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་དེའི་གནས་སྐབས་ན་ཡང་དྲུག་ལྡན་ལ་སོགས་པའི་ཁྱད་པར་དང་བྲལ་བའི་སྒྲ་ལ་སོགས་པ་ཡོད་པའི་ཕྱིར་གྲགས་པའི་གནོད་པར་ཡང་མི་འགྱུར་ལ།",
    "ཁྱད་པར་བསལ་བའི་སྐྱོན་ཡོད་དོ།",
    "གྲགས་པའི་གནོད་པར་འགྱུར་ཏེ།",
    "སྐྱེས་བུ་ནི་སྒྲ་ལ་སོགས་པ་དམིགས་པར་བྱེད་པ་ན་ཕན་གདགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་དང་།",
    "ལྷས་བྱིན་གྱི་བདག་དང་མཆོད་སྦྱིན་གྱི་བདག་ཅེས་བྱ་བ་དག་ནི་ཁྱད་པར་ཡིན་པའི་ཕྱིར་རོ།",
    "འཇིམ་པའི་ངོ་བོ་ཉིད་ཡིན་པར་རྟོག་ན་ནི་གཏན་ཚིགས་ཀྱི་དོན་མ་གྲུབ་པ་ཉིད་དོ།",
    "གྲགས་པའི་གནོད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་སྣམ་བུ་ནི་རྒྱུ་སྤུན་གྱི་བདག་ཉིད་ཀྱི་གཟུགས་དག་དང་གཅིག་པ་ཉིད་མ་ཡིན་ཏེ།",
    "རྫས་ཡིན་པའི་ཕྱིར་དཔེར་ན་སབ་མ་བཞིན་ནོ་། དོན་དམ་པར་སྣམ་བུ་ནི་རྒྱུ་སྤུན་གྱི་བདག་ཉིད་ཀྱི་གཟུགས་དག་ལས་གཞན་ཉིད་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་རྒྱུ་སྤུན་གྱི་བདག་ཉིད་ཀྱི་གཟུགས་དག་ནི་སྣམ་བུ་དང་གཅིག་པ་ཉིད་མ་ཡིན་ཏེ།",
    "དོན་དམ་པར་རྒྱུ་སྤུན་གྱི་བདག་ཉིད་ཀྱི་གཟུགས་དག་ནི་སྣམ་བུ་ལས་གཞན་ཉིད་མ་ཡིན་ཏེ།",
    "མཚན་ཉིད་དང་མཚན་ཉིད་ཀྱི་གཞི་དག་ལ་ཡང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ།",
    "དེའི་ཕྱིར་དེ་ལྟར་དཔྱད་ན་དོན་དམ་པར་གཅིག་པ་ཉིད་དང་གཞན་ཉིད་མི་འཐད་དེ།",
    "སྤྲོས་པར་བྱེད་པ་དེ་རིགས་པ་མ་ཡིན་པར་སློབ་དཔོན་གྱིས་དགོངས་པ་ན།",
    "དེ་བཅས་ཉིད་དང་ཐ་དད་པར།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དཔེ་མེད་པར་བསྟན་པས།",
    "དོན་ཐ་དད་པ་མ་ཡིན་པའི་ཁྱད་པར་དང་ལྡན་པ་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ལྟར་མཐོང་བས་མངོན་སུམ་ཉིད་དུ་མཐོང་བ་ཡང་མི་མཐོང་ངོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་དེ་དག་གྲུབ་པ་ཡིན་ནོ།",
    "དོན་དམ་པར་ཕུང་པོ་ལ་སོགས་པ་དག་ཡོད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་མིང་དང་ཁྱད་པར་བསྟན་ནས།",
    "དེ་ཟད་པར་བྱ་བའི་ཕྱིར་མན་ངག་བསྟན་པའི་ཕྱིར་རོ།",
    "འདི་ལ་གང་མེད་པ་དེ་ལ་ནི་མིང་དང་ཁྱད་པར་བསྟན་པ་དང་།",
    "དེ་ཟད་པར་བྱ་བའི་ཕྱིར་མན་ངག་བསྟན་པར་ཡང་མི་རིགས་ཏེ།",
    "དེ་དག་ལ་ནི་མིང་དང་ཁྱད་པར་བསྟན་ནས་དེ་ཟད་པར་བྱ་བའི་ཕྱིར་མན་ངག་བསྟན་པ་འདི་ལྟ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དོན་དམ་པར་གསུངས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གལ་ཏེ་མིང་དང་ཁྱད་པར་བསྟན་ནས་དེ་ཟད་པར་བྱ་བའི་ཕྱིར།",
    "མན་ངག་བསྟན་པའི་དོན་དམ་པ་པ་ཡིན་པར་འདོད་ན་ནི།",
    "ཀུན་རྫོབ་པའི་གཏན་ཚིགས་ཡིན་པར་རྟོག་ན་ནི་དོན་། འགལ་བ་ཉིད་དང་དཔེ་མེད་དོ།",
    "ཐུབ་པ་ཆེན་པོ་ས་མིན་ཞེས་གསུངས།",
    "དེ་ལ་ཐོག་མ་དང་ཐ་མ་དག་མེད་པའི་ཕྱིར་སྔོན་དང་ཕྱི་མ་མེད་པར་གསུངས་ཏེ།",
    "ཐ་སྙད་དུ་ཡིན་གྱི་དོན་དམ་པར་ནི་མ་ཡིན་ཏེ།",
    "ཕན་གདགས་པར་བྱ་བ་ཉིད་དང་།",
