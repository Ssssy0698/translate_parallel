    "གང་ཡོད་པ་དེ་ནི་སྟོང་པ་ཉིད་ཡིན་པས་དེའི་ཕྱིར་དཔེ་འདི་ལས་རྗེས་སུ་དཔག་པར་བྱ་སྟེ།",
    "སྟོང་པ་ཉིད་ཀྱི་ཤེས་པ་རྣམ་པར་རྟོག་པ་དང་བཅས་པའམ།",
    "རྣམ་པར་རྟོག་པ་མེད་པའི་སྤྱོད་ཡུལ་དངོས་པོའི་བདག་ཉིད་གང་ཡིན་པ་དེ་ནི་ཡང་དག་པ་མ་ཡིན་ཏེ།",
    "ཤེས་པའི་སྤྱོད་ཡུལ་ཡིན་པའི་ཕྱིར་དཔེར་ན་སྟོང་པ་མ་ཡིན་པའི་ཤེས་པའི་སྤྱོད་ཡུལ་བཞིན་པས་དངོས་པོའི་དེ་ཁོ་ན་སྟོང་པའང་ཡོད་པར་ག་ལ་འགྱུར་ཏེ།",
    "རྗེས་སུ་དཔག་པས་གནོད་པའི་ཕྱིར་དང་མ་བྱས་པ་དང་།",
    "སྟོང་པའང་ཡོད་པར་ག་ལ་འགྱུར།",
    "རྣམ་པར་རྟོག་པ་ཡིན་པའི་ཕྱིར་དངོས་པོར་རྣམ་པར་རྟོག་པ་བཞིན་བས་སྟོང་པའང་ཡོད་པར་ག་ལ་འགྱུར་ཏེ།",
    "སྟོང་པའང་ཡོད་པར་ག་ལ་འགྱུར།",
    "གཉིས་སུ་སྤྱོད་པ་ལ་ནི་དངོས་པོའི་ངོ་བོ་ཉིད་ཀྱི་ཡུལ་ཅན་གྱི་བློའི་བྱེ་བྲག་ལས་སྒྱུ་མར་བྱས་པ་འདི་ནི་རྟ་ལ་སོགས་པའི་བདག་ཉིད་ཀྱིས་སྟོང་ངོ།",
    "མཚན་ཉིད་མེད་པར་སྣང་བ་མེད་པའི་ཚུལ་གྱིས་སྣང་བར་འགྱུར་བས་མི་སྟོང་པ་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན།",
    "སྟོང་པའང་ཡོད་པར་ག་ལ་འགྱུར་ཏེ།",
    "མེད་པར་བྱེད་པ་མ་ཡིན་པ་བཞིན་པས་དེ་མེད་ན་དེ་ཡོད་པར་འགྱུར་བ་མ་ཡིན་པའི་ཕྱིར་དེ་ནི་མ་བརྟགས་པར་སྨྲ་བ་ཡིན་ནོ།",
    "དངོས་ཉིད་མེད་པར་ངས་སྨྲས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་གཟུགས་སྟོང་ཞེས་བྱ་བར་མི་བརྟག་མི་སྟོང་ཞེས་བྱ་བར་ཡང་མི་བརྟག་གོ་ཞེས་གསུངས་པས།",
    "སྟོང་པ་མ་ཡིན་པར་རྣམ་པར་རྟོག་པ་བཞིན་དུ་རྣམ་པར་རྟོག་པ་དེ་ཡང་རྣམ་པར་མི་རྟོག་པའི་ཤེས་པའི་གེགས་ཡིན་པས་སྤང་བར་འདོད་པའི་ཕྱིར་དང་།",
    "ལྟ་ཀུན་ངེས་པར་འབྱིན་པར་གསུངས།",
    "དེ་དག་བསྒྲུབ་ཏུ་མེད་པར་གསུངས།",
    "དོན་དམ་པར་དངོས་པོ་རྣམས་ངོ་བོ་ཉིད་ཡོད་པར་ཤེས་པར་བྱ་སྟེ།",
    "ཕྲད་པར་འགྱུར་བ་ཡོད་མ་ཡིན།",
    "བལྟ་བར་བྱ་བ་དང་ལྟ་བ་དང་ལྟ་བ་པོ་དེ་དག་གཉིས་གཉིས་དང་ཐམས་ཅད་ཀྱང་ཕན་ཚུན་དུ་ཕྲད་པར་འགྱུར་བ་མེད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཆགས་པར་འགྱུར་བ་དང་།",
    "ཞེ་སྡང་བར་བྱ་བ་ལ་སོགས་པ་རྣམ་པར་བཞག་ནས།",
    "ཐམས་ཅད་ཀྱི་རྣམ་པ་གསུམ་གྱིས་ཕན་ཚུན་དུ་ཕྲད་པར་འགྱུར་བ་མེད་པར་དགག་པར་བརྗོད་པར་བྱའོ།",
    "དེ་ལ་འདོད་ཆགས་ནི་ལྷག་། པར་ཆགས་པའི་མཚན་ཉིད་དོ།",
    "ཡིད་ཅེས་བྱ་བ་དེ་དག་ལ་ཡང་མཉན་པར་བྱ་བ་དང་།",
    "དེ་བཞིན་དུ་བསྣམ་པར་བྱ་བ་དང་།",
    "ཐམས་ཅད་ཀྱི་རྣམ་པ་གསུམ་གྱིས་ཕན་ཚུན་དུ་ཕྲད་པར་འགྱུར་བ་མེད་པར་དགག་པ་ཡང་བརྗོད་པར་བྱའོ།",
    "དེ་ཕྱིར་ཕྲད་པར་མི་འགྱུར་རོ།",
    "ཕྲད་པ་ནི་སྦྱོར་བའི་རྣམ་གྲངས་ཏེ་དེ་ཡང་གཞན་ཡོད་ན་གཞན་དང་ཕྲད་པར་འགྱུར་བ་ཡིན་ན།",
    "ཆགས་པ་དང་ཆགས་པར་འགྱུར་བ་ལ་སོགས་པ་དག་ལ་གཞན་དེ་ཡང་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་ཕྲད་པར་མི་འགྱུར་རོ་ཞེས་མཇུག་བསྡུ་བའི་ཚིག་ཡིན་ནོ།",
    "མ་བྱས་པ་ཉིད་དུ་འབྲེལ་པ་དེ་ཡང་སྒྲ་ལ་མེད་ལ་བྱས་པ་ཉིད་ནི་ཡོད་པ་ལྟ་བུའོ་འདིར་སྦྱོར་བའི་ཚིག་ནི་དོན་དམ་པར་ལྟ་བ་པོ་ནི་བལྟ་བར་བྱ་བ་འམ།",
    "གཞན་ཉིད་མེད་པར་མ་ཟད་ཀྱི།",
    "མཉན་པར་བྱ་བ་དང་།",
    "འདིར་རྗེས་སུ་དཔག་པ་ནི་དོན་དམ་པར་བལྟ་བ་ནི་བལྟ་བར་བྱ་བ་ལས་གཞན་མ་ཡིན་ཏེ།",
    "བརྗོད་པར་བྱ་བ་ཁྱད་པར་ཅན་བརྟེན་པ་ཉིད་ལ་ལྟོས་པ་དང་བཅས་པ་ཉིད་ཀྱི་གཏན་ཚིགས་ཀྱི་དོན་ཀྱང་མ་གྲུབ་པ་ཉིད་མ་ཡིན་ཏེ།",
    "གཞན་མེད་པར་ཡང་རུང་བར་འགྱུར།",
    "གལ་ཏེ་གཞན་ཞེས་བྱ་བ་ངོ་བོ་ཉིད་ཀྱིས་གཞན་ལས་གཞན་ཡིན་པར་གྱུར་ན་དེ་ལྟ་། ན་གཞན་མེད་པར་ཡང་གཞན་དུ་རུང་བར་འགྱུར་ཏེ།",
    "དེའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་དཔེར་ན་ཐ་སྙད་ཀྱི་བདེན་པར་གྲགས་པའི་མེའི་དངོས་པོ་གཞན་ལ་མི་ལྟོས་པར་ཡང་ཚ་བའི་ངོ་བོ་ཉིད་དུ་འགྱུར་བ་བཞིན་ནོ།",
    "མཉན་པར་བྱ་བ་ལ་སོགས་པ་ལ་མི་ལྟོས་ཕར་གཞན་ཉིད་དུ་འགྱུར་བ་མེད་ལ།",
    "ཆགས་པ་ལ་སོགས་པ་དག་ཀྱང་འདོད་ཆགས་ལ་སོགས་པ་ལ་མི་ལྟོས་པར་གཞན་ཉིད་དུ་འགྱུར་བ་མེད་དེ།",
    "ཅི་སྟེ་ལྟ་བ་པོ་ནི་ལྟ་བ་ལ་སོགས་པ་ལ་ལྟོས་པ་མེད་པར་ཡང་གཞན་ཉིད་ཡིན་ཏེ།",
    "ལྟ་བ་པོ་ནི་ཡུལ་དུ་སྣང་བའི་རྣམ་པར་ཤེས་པའི་མཚན་ཉིད་དམ་དེ་དང་ལྡན་པའི་འདུ་བྱེད་ཀྱི་ཚོགས་བཞིན་ནོ།",
    "བལྟ་བར་བྱ་བ་ལ་གཞན་ཉིད་ངེས་པར་གནས་པ་ཁོ་ན་ཡིན་པས་དེའི་ཕྱིར་གཞན་ཉིད་གྲུབ་པས་བརྗོད་པ་ཁྱད་པར་ཅན་བརྟེན་པ་ཉིད་ལ་ལྟོས་པ་དང་བཅས་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་ཀྱི་དོན་མ་གྲུབ་པ་ཉིད་དོ།",
    "གཞན་དང་གཞན་མ་ཡིན་པ་ཉིད་གཞན་ཉིད་དང་ལྡན་པར་རྟོག་ན་ཡང་དོན་མེད་པ་ཉིད་དང་།",
    "དངོས་པོ་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་དུས་ཕྱིས་གཞན་ཉིད་དང་ལྡན་པར་རྟོག་ན་ཡང་དངོས་པོ་ནི་གཞན་ཉིད་དང་ལྡན་པ་མ་ཡིན་ཏེ།",
    "དོན་དམ་པར་ལྟ་བ་ནི་བལྟ་བར་བྱ་བ་ལས་གཞན་མ་ཡིན་ཏེ་ཞེས་དམ་བཅས་པ་དེའི་དོན་གང་ཡིན།",
    "བརྟག་པ་གཉིས་པ་ལ་ཡང་དོན་དམ་པར་ལྟ་བ་ནི་བལྟ་བར་བྱ་བ་ལས་གཞན་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ།",
    "དོན་དམ་པར་གཞན་ཉིད་ལ་གཞན་ཉིད་ཀྱི་ངོ་བོ་ཉིད་མེད་དེ།",
    "སྤྱི་དང་ཁྱད་པར་དང་ལྡན་པའི་ཕྱིར་དཔེར་ན་གཟུགས་ཉིད་བཞིན་ནོ།",
    "ཡང་ན་དོན་དམ་པར་གཞན་ཉིད་ནི་གཞན་ཉིད་ཀྱི་བློ་དང་སྒྲ་སྐྱེ་བའི་རྒྱུ་ཉིད་མ་ཡིན་ཏེ།",
    "བློ་དང་སྒྲ་ཁྱད་པར་ཅན་གྱི་རྒྱུ་ཡིན་པའི་ཕྱིར་དཔེར་ན་གཟུགས་ཉིད་བཞིན་ནོ།",
    "ཡང་ན་དོན་དམ་པར་གཞན་ཉིད་ཀྱི་བློ་ནི་གཞན་ཉིད་དང་ལྡན་པའི་བལྟ་བར་བྱ་བ་ལ་སོགས་པའི་ཡུལ་དངོས་དང་ལྡན་པ་མ་ཡིན་ཏེ།",
    "རྒྱས་པར་ནི་སྔ་མ་བཞིན་ནོ།",
    "རང་ལས་གཞན་ཉིད་ཡིན་པར་གྱུར་ན་མི་རུང་བའི་ཕྱིར་རོ།",
    "འདིས་སྤྱི་དང་ཁྱད་པར་དང་ཡོད་པ་ཉིད་དང་།",
    "ཚད་ལ་སོགས་པ་དག་ཀྱང་དགག་པར་བྱའོ།",
    "དེ་ལ་གལ་ཏེ་ཁྱེད་ཀྱིས་གཞན་ཉིད་ཀྱི་མཐའ་མེད་དོ་ཞེས་དེ་དགག་པ་བརྗོད་པས་གཞན་མ་ཡིན་པ་ཉིད་ཀྱིས་མཐའ་ཡོངས་སུ་བཟུང་བ་བྱས་པས་དེས་ན་མཛད་པའི་མཐའ་ལ་གནོད་པར་འགྱུར་རོ།",
    "དོན་དམ་པར་ལྟ་བ་པོ་ནི་བལྟ་བར་བྱ་བ་དང་གཞན་མ་ཡིན་པ་ཉིད་མ་ཡིན་ཏེ།",
    "བརྗོད་པ་ཁྱད་པར་ཅན་བརྟེན་པ་ཉིད་ལ་ལྟོས་པ་དང་བཅས་པ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་དེ་ལྟར་གཞན་མ་ཡིན་པ་ཉིད་ཀྱང་བཀག་པའི་ཕྱིར་མཛད་པའི་མཐའ་ལ་གནོད་པར་མི་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་ཕྲད་པ་པོ་དེ་དང་ལྡན་པའི་ཕྲད་པ་ཡོད་པ་ཉིད་དེ།",
    "བརྗོད་པ་ཁྱད་པར་ཅན་གྱིས་བརྗོད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་དང་།",
    "དཔེར་ན་ཟས་དང་འབྲེལ་པས་བརྗོད་པ་ཁྱད་པར་ཅན་གྱི་ཆ་ལ་བརྟེན་པའི་ཟ་བ་པོ་བཞིན་པས་ཕྲད་པ་པོ་བརྗོད་པ་ཁྱད་པར་ཅན་གྱིས་བརྗོད་པར་བྱ་བའི་ཕྲད་པ་པོ་དེ་ཡང་ཡོད་པས།",
    "རྣམ་པར་ཤེས་པ་ལ་ཡང་ཕྲད་པའམ་བྲལ་བ་མེད་དོ།",
    "རྣམ་པར་ཤེས་པ་ལ་ཕྲད་པའམ་བྲལ་བ་མེད་པ་གང་ཡིན་པ་དེ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་དེ་དག་གྲུབ་པ་ཡིན་ནོ།",
    "ད་ནི་དེ་བཞིན་དུ་སྟོང་པ་ཉིད་ཀྱི་མི་མཐུན་པའི་ཕྱོགས་ཀྱི་ཁྱད་པར་དགག་པས།",
    "དོན་དམ་པར་དངོས་པོ་རྣམས་ངོ་བོ་ཉིད་ཡོད་པ་ཡིན་ཏེ།",
    "དོན་དམ་པར་དངོས་པོ་རྣམས་ངོ་བོ་ཉིད་ཡོད་པ་ཉིད་དུ་ཁས་བླངས་ནས་ངོ་བོ་ཉིད་མེད་པ་ཉིད་དུ་དམ་མ་བཅས་པའི་ཕྱིར་དེས་ན་དམ་བཅས་པའི་དོན་ལ་སྐུར་བ་མ་བཏབ་པས་གཏན་ཚིགས་ཀྱི་དོན་མ་གྲུབ་པ་ཉིད་མ་ཡིན་ལ།",
    "མཁས་པར་རློམ་པ་གཞན་དག་གཞན་དུ་ཕྱིར་ཟློག་པར་བྱེད་དེ།",
    "མངོན་སུམ་དང་གྲགས་པའི་གནོད་པས་གནོད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་རྣམ་པར་ཤེས་པ་རྣམ་པར་བརྟགས་པའི་དངོས་པོའི་གཟུགས་ལ་དམིགས་པའི་སྐྱེ་བ་ཁས་མ་བླངས་པའི་ཕྱིར་དང་།",
    "མངོན་སུམ་དུ་དམིགས་པའི་དངོས་པོ་མངོན་སུམ་དུ་ཡོད་པ་ཉིད་དུ་བསྟན་པར་བྱ་དགོས་ན་དེ་ཡང་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ངོ་བོ་ཉིད་ནི་བྱས་པར་འགྱུར།",
