    "ཞེས་སྨྲས་པས་ཁོ་རང་ཤིན་ཏུ་ཡི་རངས་ཏེ།",
    "ཞེས་གཞན་ལ་སྐྱོན་བརྗོད་པ་དེ་རང་ཉིད་ལ་མི་འདོད་བཞིན་དུ་བབས་འདུག་སྟེ།",
    "འདིར་སློབ་དཔོན་གྱིས་སྔོན་འཇུག་ཕོ་ཡིག་ཡིན་ན་འདས་པ་དང་གཞན་སྒྲུབ་པར་འཇུག་པ་ཡིན་པས་ཁྱབ་ཅེས་སོགས་ཁས་བླངས་པ་འདུག་གམ།",
    "ཁྱབ་ཅེས་ཁས་བླངས་པ་ཞིག་མ་ཁྱབ་པར་འདུག་ན་སྐྱོན་ཡིན་ཡང་།",
    "ཞེས་གསུངས་འདུག་པའི་ཕྱིར་རོ།",
    "དཔྱད་ན་མ་ངེས་པ་སོགས་སྐྱོན་གྱི་ཆ་རྣམས་ལྷང་ངེར་མངོན་འདུག་གོ།",
    "དེས་ན་བརྡ་སྤྲོད་རིག་པས་མཚོན་པའི་བོད་ཀྱི་རིག་གཞུང་རྣམས་ནི་ལམ་ཁའི་རྩྭ་བཞིན་འདོར་བྱ་ཞིག་ལས་ཡང་དག་པ་ཞིག་ཡོད་ཚོད་མི་འདུག་གོ་སྙམ་དུ་བསམས་ཤིང་སྒྲོག་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "བརྒྱན་ཏེ་སྨྲས་ན་དོན་གྱི་ཐོག་ནས་ཀྱང་དེས་མ་ཆོག་པ་ཅི་ཡང་མི་འདུག་ལ།",
    "བར་འདུག་གོ།",
    "གཤིས་ངོ་བོར་གང་ཡང་རང་བཞིན་མ་གྲུབ་པ་དང་།",
    "འདི་ལ་འགའ་ཞིག་གཞན་སྟོང་ཞེས་མིང་འདོགས་སོ་ གཞན་སྟོང་དང་རང་སྟོང་ནི་ཅི་བརྗོད་ཀྱང་འགལ་བ་མེད་པར་སེམས་ལ།",
    "སྣང་ཙམ་ཁས་བླངས་པའི་རང་རྒྱུད་པའི་འཆད་ཚུལ་དེ་ལའང་རང་སྟོང་ཞེས་བརྗོད་དེ།",
    "ཞེས་གསུངས་པ་ཉིད་བློའི་མུན་པ་སེལ་བའི་སྒྲོན་མར་འདུག་གོ།",
    "འདི་ཡང་རང་བཞིན་གྱི་རྟགས་སོ།",
    "ཞེས་གསུངས་འདུག་པས་བག་ཡོད་པར་བྱ་དགོས་སོ།",
    "སོ་སོར་རྟོགས་པའི་མངོན་རྟོགས་ལས་ཀྱང་སྐད་ཅིག་མ་གཅིག་ཡིན་ཞེས་པའི་ལུགས་གཅིག་སྟེ་མི་མཐུན་པ་གཉིས་བཀོད་འདུག་པ་ལ།",
    "ཀྱིས་ཤེས་ནས་འདའ་བྱ་ཙམ་ཡིན་པ་བཀོད་འདུག་པའིཕྱིར་རོ།",
    "དུ་འདུག་རི་སུལ་དེ་དག་ན་འབྲུ་ཞིང་སྔོ་ཡེང་ངེ་བ་རྣམས་ཀྱི་འགྲམ་དུ་ཁང་པ་ཐ་ཐོར་དུ་མ་སྣང་།",
    "མཆོད་སྡོང་བྱིན་ཅན་བྱ་རུང་ཁ་ཤོར་དང་རང་བྱུང་མཆོད་རྟེན་འཕགས་པ་ཤིང་ཀུན་དག་རྒྱང་མ་ནས་ཀྱང་གྲོང་ངེར་མཇལ།",
    "དེར་སྒྱུ་འཕྲུལ་མ་ལ་བཅོམ་ལྡན་འདས་འཁྲུངས་པའི་རྡོ་སྐུ་རྙིང་པ་འགའ་ཞིག་ཀྱང་འདུག་ཉེ་འཁོར་ན་གཙུག་ལག་ཁང་མང་པོའི་ཤུལ་རྩིག་རྨང་ཕ་གུ་རིམ་པ་གསུམ་བཞི་ནས་མི་ལུས་ཕྱེད་ཙམ་ལ་སླེབས་པ་དག་དང་།",
    "འོག་ན་སྤྲིན་དཀར་པོའི་འདབ་མ་དག་ཐང་མ་བརྡལ་བ་ལྟ་བུའི་བར་སྣང་དུ་འབྱོར་ནས་འདུག་གོ།",
    "བོད་ཀྱི་ལོ་ཙ་བ་བོ་རོ་ཙ་ནས་བསྐྱུར་ཅིང་གཏན་ལ་ཕབ།",
    "དེ་ལ་དེ་ལྟར་སའི་མཚན་ཉིད་རིག་པའི་སྔགས་པས་ལུས་བཀྲུ་ཞིང་དྲི་ཞིམ་པས་ཇི་ལྟར་རྙེད་པས་གོས་དང་རྒྱན་ད་ང་ཅོད་པན་དང་བདེ་བའི་སྟན་མཐོན་པོ་ལ་འདུག་སྟེ།",
    "དེ་ནས་ལེགས་པར་བརྟགས་ཤིང་ཤིན་ཏུ་མཉམ་པའི་སའི་ཆར་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ནས་རས་རི་ས་༥ལ་སོགས་པ་བརྩམ་༦པར་འདོད་པའི་སྔགས་པས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ནས་སྔགས་པས་ཡོངས་སུ་བརྟགས་ཤིང་ཤིན་ཏུ་འཇམ་པའི་ས་ཕྱོགས་སུ་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དུས་སྦྱོར་བཟང་པོ་འཛོམ་པའི་ཉིན་ཞག་བཟང་པོ་ལ་ཁྲུས་དང་གཙང་སྦྲ་བྱས་ཏེ་གོས་དང་རྒྱན་བཟང་པོ་དབུ་རྒྱན་མེ་ཏོག་དང་བ་ཅས་པས་གྲོགས་བཟང་པོ་དང་ལག་པ་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པས་སྟན་ཐོག་མཐོན་པོ་འཇམ་པ་ལ་འདུག་སྟེ།",
    "ཞེས་བྱ་བས་བྱིན་གྱིས་བརླབས་པ་སྟེགས་བུའི་སྟེང་དུ་འདུག་སྟན་གཙང་མ་ལ་བཞག་ནས་དྲི་མ་སེལ་བ་རྣམས་ཀྱིས་དྲི་མ་བསལ་བར་བྱའོ།",
    "དེ་ནས་གོ་རོ་ཙ་ནའི་ཐིག་ལེ་བྱས་ཏེ་མེ་ཏོག་དང་བདུག་སྤོས་དང་།",
    "འདུག་ནས་གཏོར་མ་ཡང་དག་སྦྱིན།",
    "གོས་སོགས་རང་རང་སྔགས་ཀྱིས་ནི།",
    "དགང་གཟར་སྦྱིན་སྲེག་ཤིང་རང་བཞིན།",
    "རང་རང་ཕྱོགས་སུ་ལེགས་པར་བཞུགས་ནས་ཀྱང་།",
    "ཏནྠཱ་ཏ་ཨུད་ཌྷི་༢ཏྱ་ལོ་ཙ་ནཱ་ཡཱ་དུརྒ་ཏི་ཤོ་དྷ་ན་བི་དྷི།",
    "འཇམ་ཞིང་མཐོ་བའི་སྟན་འདུག་ལ།",
    "དེ་རྗེས་འདུག་པ་ལངས་ནས་ནི།",
    "རྒྱ་ཆེན་མཐོན་པོ་བདེ་བའི་སྟན་ལ་འདུག།",
    "དེ་རྗེས་ལངས་ན་ས་འདུག་པ་བལྟ་བར་བྱ།",
    "གཞན་གྱི་ཆེད་དུ་གླེང་བ་ནི་སྤྱན་སྔར་འདུག་ནས་བརྗོད་པ།",
    "ད་ནི་གཞན་སྤྲོ་བའི་ཕྱིར་ཙ་ནའི་འབྲུ་ཙམ་ནི་སྲན་ཙ་ན་ཀའོ།",
    "རང་རང་གཙོ་བོར་གྱུར་པའི་གནས་སུ་བསྒོམས་ན།་",
    "གཞི་དང་ཐབས་དང་རང་བཞིན་གསུམ།",
    "ཨོཾ་རུ་རུ་ཞེས་པ་ལ་སོགས་པ་ལོ་ཙ་ན་ལ་སོགས་པ་རིམ་པའི་སྔགས་གསུངས་པ་རྗེས་སུ་དྲན་ཞེས་ཏེ།",
    "སྤྲེའུའམ་ཉ་ཁྱི་བ་དང་ཁྱི་གུ་ལ་སོགས་པ་བྱུང་ནས་འདུག་པ་དེ་བརླག་༢པར་བྱའོ།",
    "དེས་གང་དགུག་པ་རྒྱན་རྣམས་རྫོགས་ཤིང་སེར་ལ་འགྱིང་བག་ཏུ་འདུག་པ་རལ་པའི་༢དབུ་རྒྱན་ཅན་དགུག་པའི་ཆོ་གས་སོ།",
    "དེ་ནས་བཅོམ་ལྡན་འད་ས་ཕྱག་ན་རྡོ་རྗེས་ཞེས་པ་ནས་འདུག་གོ་ཞེས་པའི་བར་རྣམས་ནི་ཡོངས་སུ་གཏད་༤པ་སྟེ།",
    "བོད་ཀྱི་ལོ་ཅཱ་བ་བེ་རོ་ཙ་ནས་བསྒྱུར་ཅིང་གཏན་ལ་ཕབ་པ་༢།་།་",
    "དེ་ལ་སེམས་ནི་དངོས་པོ་ཐམས་ཅད་ད་ང་རང་བཞིན་གྱིས་བྲལ་བར་ཡང་མཁྱེན་ལ།",
    "གཞན་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་༤རིམ་གྱིས་བསྟན་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་ཕྲག་དོག་ཀྱང་རང་བཞིན་མེད་དོ།",
    "འཇམ་པའི་སྟན་ལ་འདུག་ནས་ནི།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་ལ་འདུག་ནས།",
    "རང་རང་དག་ནས་གནས་ཕྱིར་རོ།",
    "རང་རང་ལྷ་དག་རང་བཞིན་སྐྱེ།",
    "རྟ་ཤ་ནི་རཏྣ་ལོ་ཙ་ན་དང་རིན་ཆེན་འབྱུང་ལྡན་གྱི་ཚུལ་དུ་སྤྱད།",
    "ཡང་ན་ཡན་ལག་མི་གཉིས་ཞེས་པ་ནི་གཟུངས་མ་དང་གཉིས་སུ་མེད་པའི་ཚུལ་དུ་འདུག་ནས་༐",
    "འདུག་༦ནས་ཞེས་པ་ནི་༧སྟན་དེ་གསུམ་གྱི་སྟེང་དུ་བདག་གོང་དུ་བསྟན་པའི་ཚུལ་དུ་འདུག་པའོ།",
    "ད་ང་བ་ནི་ཤེལ་ལྟ་བུར་འདུག་ཅིང་འོད་གསལ་བའོ།",
    "དབུས་སུ་གནས་པ་ནི་རྣལ་འབྱོར་པ་དེའི་དཀྱིལ་དུ་འདུག་པའོ།",
    "ཡང་ན་གསང་བ་ནི་ལོ་ཙ་ན་ལ་སོགས་པ་ཡུམ་གྱི་རང་བཞིན་དུ་གནས་པ་རྣམས་སོ།",
    "སེམས་ད་པའི་སྐྱིལ་ཀྲུང་ནི་འདུག་སྟངས་ས་སོ།",
    "ཞེས་པ་ནི་ད་བུ་སྐྲ་རལ་པར་འདུག་ཉིད་ཅོད་པན་དུ་བྱས་པའམ།",
    "ཞེས་པ་ལ་དེ་ལ་ཕྱག་གཡས་ཀྱི་དང་པོ་ཡེ་ཤེས་ལྔའི་རང་བཞིན་རྡོ་རྗེ་རྩེ་ལྔ་པ་ཁ་དོག་ཨིནྡྲ་ནཱི་ལ་ལྟར་འདུག་པ་ཕྱག་ཏུ་བསྒོམ་ཞེས་པ་དང་འབྲེལ་ཏོ།",
    "ཟླ་བ་རྩིབས་བརྒྱད་ལྟ་བུས་ནི་དབྱིབས་དང་ཁ་དོག་བསྟན་ཏེ་འཁོར་ལོ་དེ་རྩིབས་བརྒྱད་ལྡན་ཞིང་ཟླ་བ་བཞིན་དུ་དཀར་ལ་ཟླུམ་པོར་འདུག་པའོ།",
    "ཨུཏྤ་ལ་སྔོན་པོའི་ལོ་མ་བཞིན་དུ་ཞེས་པ་ནི་ཕྱག་ཐ་མ་ན་རལ་གྲིའི་ཁ་དོག་ཨུཏྤ་ལའི་འདབ་མ་བཞིན་དུ་འདུག་པ་༐",
    "ཞེས་པ་ནི་སྒྲུབ་པ་པོ་བདག་ཀྱང་དེ་ད་ང་ལྷན་ཅིག་དཀྱིལ་འཁོར་གྱི་དཀྱིལ་དུ་འདུག་ལ་བདག་ཉིད་དད་པའི་ལྷ་གང་ཡང་རུང་བ་ཕྱག་རྒྱ་བཞི་ད་ང་ལྡན་པར་བསྒོམ་ཞེས་པའི་དོན་ཏོ།",
    "ཞེས་པ་ནི་དེ་ལྟར་འདུག་ནས་ཐབས་དང་ཤེས་རབ་ཀྱི་ཕྱག་རྒྱ་གཉིས་གོང་དུ་བསྟན་པའི་ཏིང་ངེ་འཛིན་གསལ་བར་དམིགས་ལ་སྦྱོར་ཞེས་པའོ།",
    "འོད་ཟེར་སྣ་ཚོགས་པས་༢བརྒྱན་ཞེས་པ་ནི་སྐུ་ལས་དཀར་པོ་ལ་སོགས་པའི་འོད་ཟེར་སྣ་ཚོགས་དཀྲིགས་ཤིང་བསྐོར་བའི་ཚུལ་དུ་འདུག་པའོ།",
    "འབར་བའི་དབུ་ནི་གྱེན་དུ་བཅིངས་པ་ནི་དབུ་སྐྲ་སེར་སྐྱར་འདུག་པ་འབར་ཞིང་གྱེན་དུ་འཁྱིལ་པས་ཐོར་ཅོག་དུ་འདུག་པའོ།",
    "ཞབས་གཡས་བརྐྱང་བར་གནས་པ་ནི་འདུག་སྟངས་ཡིན་ཏེ་གཡས་བརྐྱང་ཞིང་གཡོན་བསྐུམ་པའོ།",
    "གཡས་བརྐྱང་འགྱིང་བའི་ཚུལ་དུ་གནས་པ་ནི་འདུག་སྟངས་སོ།",
    "ཅེས་པ་ནི་ཤིན་ཏུ་འཇིགས་པར་བྱེད་པའི་ཁྲོ་བོའི་ཆ་ལུགས་ཞལ་གསུམ་ཁྲོ་གཉེར་རིམ་པ་མང་བ་ལྗགས་ཀློག་༡བཞིན་བསྐྱོད་ཅིང་ཤིན་ཏུ་རྣོ་བའི་མཆེ་བ་གཙིགས་པ་ར་འདུག་པ།",
    "ཞེས་པས་༡ནི་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་འདུག་པ་བསྟན་ཏེ།",
    "ལོ་ཙ་ན་དང་།",
    "སེམས་ཆིག་བརྗོད་པ་ལྟ་༢ཞེས་པ་ནི་སེམས་ཙམ་དེ་ཡང་རང་བཞིན་མེད་དོ་ཞེས་པ་སྟེ།",
    "ནམ་མཁའ་ལྟ་བུར་སྦྱར་ནས་ཤིས་པ་སྐྱེད་ཅིག་ཅེས་བཀའ་སྩལ་པ་དེ་རང་རང་དང་རྡོ་རྗེ་འཆང་བ་གཉིས་སུ་མེད་པར་སྦྱར་བས་བཀའ་མཉན་ཏེ་ཞེས་པའི་དོན་ཏོ།",
    "ཞེས་པ་ཡང་རང་བཞིན་མེད་པ་སྟེ་དེ་ལས་བྱུང་བའི་དོན་ཏོ།",
    "ཡང་ན་གཟུང་བ་ལ་སོགས་པའི་རིམ་པས་སའི་དབུས་ན་འདུག་པའི་སློབ་དཔོན་ལ་གྲོགྲོགས་པོས་གསོལ་བ་བཏབ་པའི་དེ་མ་ཐག་ཏུ་ཐིག་ལ་སོགས་པའི་ལས་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "ཙ་ན་ཀ་ཞེས་པ་ནི་སྣང་བ་མཐའ་ཡས་ཀྱི་ཡིན་ནོ།",
    "ཀུན་དུ་སྤྱོད་པའི་ངོ་བོ་གང་ཡུལ་རྣམས་འདོད་པའི་ངོ་བོ་ལྟར་རང་རང་གནས་པས་ཕྱི་རོལ་གྱི་ངོ་བོ་སྤོང་བ་སྟེ།",
    "འབྲུ་ཙ་ན་ཀའི་ཐིག་ལེའི་འབྲས་བུ་ཞེས་སོ།",
    "གྱུར་པ་༦དེ་། ཞེས་པ་ནི་༧ཡིག་འབྲུ་དེ་ད་ག་ཙ་ན་ཀའི་ཚད་ཀྱི་ཐིག་ལེའི་དབུས་སུ་གནས་པའོ་། འགྲོ་དང་ཕྱིར་འོང་རྣམ་པར་བསྟན།",
    "ཡིག་འབྲུའི་ཚད་ཙ་ན་ཀའི་ཚད་ཙམ་༢ཐིག་ལེའི་དབུས་སུ་གནས་པ་ལས།",
    "ཞེས་པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་པེ་སྣར་ལ་ཆད་འདུག་པས་ཅོ་ད་ང་ད་པེ་བསྡུར་བྱས་ཡོད།",
    "འོད་ད་པག་མེད་ཀྱི་སྦྱོར་བས་༢འོད་དཔག་མེད་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་སྟེ།",
    "དེའི་སྟེང་དུ་མི་བསྐྱོད་པའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་ལ་ཡི་གེ་ཧཱུྃ་ལས་ལག་པ་གཡས་པར་རྡོ་རྗེ་བསྐྱེད་ལ་བསྒོམས་ན་རྡོ་རྗེའི་༢རིག་པ་འཛིན་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་འོད་ད་པག་མེད་ཀྱི་རྣལ་འབྱོར་པས་འོད་དཔག་མེད་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་སྟེ་ཡི་གེ་ཨཱ་ལས་ལྕགས་ཀྱུ་པདྨ་རིགས་ཀྱི་གཟུགས་སུ་རྣམ་པར་བསམས་ལ་འོད་དཔག་མེད་ལ་སོགས་པ་དགུག་༧པར་བྱའོ།",
    "ནམ་མཁའི་དབྱིངས་སུ་རྣམ་པར་སྣང་མཛད་ཀྱི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་སྟེ་གཡས་པའི་འཁོར་ལོ་ནམ་མཁའ་ད་ང་མཉམ་པར་རྣམ་པར་བསམས་ལ།",
    "འཕགས་པ་གཤིན་རྗེའི་༡གཤེད་ཀྱི་སྦྱོར་བ་བྱས་ལ་རྡོ་རྗེ་ནམ་མཁར་བཅོམ་ལྡན་འདས་ཀྱི་དཀྱིལ་འཁོར་རྣམ་པར་བསམས་ལ་གནས་ལྔར་གཤིན་རྗེའི་༢གཤེད་ཀྱི་སྦྱོར་བས་འདུག་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་འཕགས་པ་བདུད་རྩི་འཁྱིལ་པའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་དེའི་སྦྱོར་བས་འདུག་ལ་དེའི་སྔགས་ཀྱིས་ཁྲོ་བོ་བདུད་རྩི་འཁྱིལ་པ་རྡོ་རྗེ་ཕུར་བུར་བསམས་ཏེ།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭཱ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་ཏེ་ཁྲོ་བོ་གང་ཡང་རུང་བའི་སྦྱོར་བ་བྱས་ལ་དེའི་དཀྱིལ་འཁོར་ནམ་མཁའ་ལ་རྣམ་པར་བསམས་ནས་ད་ཀྱིལ་འཁོར་དེའི་དབུས་སུ་འདུག་སྟེ།",
    "དེའི་ད་ཀྱིལ་འཁོར་གྱི་ད་བུས་སུ་འདུག་སྟེ་རྣམ་པར་སྣང་མཛད་དགུག་པར་བྱའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་འཕགས་པ་བདུད་རྩི་འཁྱིལ་པའི་སྦྱོར་བ་བྱས་ལ་དེའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་རྣལ་འབྱོར་པ་འདུག་སྟེ།",
    "ཤར་ཕྱོགས་སུ་མི་བསྐྱོད་པའི་སྦྱོར་བས་འདུག་པའི་རྣལ་འབྱོར་པས་དབུས་སུ་ཡི་གེ་ཛཾཛཾ་ལས་ཉི་མའི་དཀྱིལ་འཁོར་དེའི་སྟེང་དུ་ཡི་གེ་ཛཾཛཾ་ལས་གསེར་གྱི་ཁ་དོག་ཅན་འོད་ཟེར་སེར་པོའི་ཚོགས་ཀྱིས་ནམ་མཁའ་གང་བའི་འོད་ཟེར་དེ་རྣམས་ཀྱི་སྒོ་ལ།",
    "ཡི་གེ་མཾ་ལས་འཕགས་པ་འཇམ་དཔལ་གྱི་གཟུགས་ཀྱིས་འདུག་ལ།",
    "ཞེས་པའི་གཡུང་དྲུང་རྟགས་བར་གྱི་ཡི་གེ་རྣམས་དེབ་འདིའི་ལྔེབ་༨༩༣པའི་བསྡུར་མཆན་༢པའི་མཚམས་སུ་པེ་སྣར་གཉིས་ལ་ལྷག་མ་འཁོད་འདུག་༩པེ་སྣར་རྣམ་པར།",
    "དེ་ནས་ཆར་དབབ་པའི་ས་ཕྱོགས་སུ་འདུག་ལ་གདུགས་དང་རྒྱལ་མཚན་དང་།",
    "ཡང་ན་མགོ་ལ་ཧྲཱི་བདུད་རྩིའི་ཚོགས་འོ་མ་ལྟ་བུར་འབབ་པ་བཀོད་ལ་ལུས་ལ་གནས་པའི་དུག་ངོ་བོ་ཉིད་ཀྱིས་ནག་པོར་འདུག་པའི་དྲི་མ་རིམ་གྱིས་སེལ་བར་བྱེད་པའི་འོད་ཀྱི་རྒྱུན་བསམས་ལ།",
    "གཤིན་རྗེ་གཤེད་ཀྱི་གཟུགས་ཇི་ལྟ་བ་བཞིན་དུ་གསང་བའི་གནས་སུ་བྱས་ལ་རབ་གནས་བྱ་ཞིང་རང་དེ་ལྟ་བུའི་སྦྱོར་བ་དང་ལྡན་པས་བསྟན་པ་ལྟར་བྱའོ།",
    "དགྲའི་༤རོ་ཙ་ན་ཞེས་བྱ་བ་ནི་དགྲའི་དྲི་ཆེན་ནོ།",
    "སྣང་མཛད་ནི་བེ་རོ་ཙ་ནའོ།",
    "སྐལ་བ་ད་ང་ལྡན་པ་གང་ཞིག་རྒྱུད་འདིར་སློབ་པ་དེ་ཡང་རང་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་༐",
    "གལ་ཏེ་འདུག་ཀྱང་བགེགས་བྱེད་༢༢ན།",
    "མཁའ་སྤྱོད་རབ་བསྒྲུབ་ཅེས་བྱ་བ་ནི་ནམ་མཁའ་ལ་འགྲོ་བའི་རིགས་འཛིན་ཏེ་སྔ་མ་ལྟར་བྱ་བ་བྱས་ཏེ་བསྒྲུབ་པའི་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ནས་མཚན་ཐོག་ཐག་བཟླས་ནས་ཐོ་རངས་ནམ་མཁའ་ལ་བྱ་ཁྱུང་ལྟར་འགྲོ་བར་འགྱུར་རོ།",
    "དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ནས་བཟླས་ན་དེའི་ཐོ་རངས་དེ་མི་སྣང་བར་འགྱུར་ཏེ་ལྷས་ཀྱང་མི་མཐོང་བར་འགྱུར་རོ།",
    "འདིར་ཡང་སྔ་མ་ལྟར་བྱ་བ་བྱས་ཏེ་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ནས་ཆུའི་སྣོད་ལ་རྡོ་ལ་སོགས་པ་བོར་བ་མི་འབྱིང་བ་ཐོ་རངས་གྲུབ་པ་ན་དེས་དེ་གྲུབ་བོ།",
    "གྱི་རླབས་ཀྱིས་༢བཅོམ་ལྡན་འད་ས་དེ་བཞིན་གཤེགས་པ་ཚེ་དཔག་མེད་ཀྱི་སྤྱན་སྔ་ན་འདུག་གོ།",
    "འཛམ་བུ་ཆུའི་གསེར་གྱི་རྒྱན་༩གྱིས་ལུས་ལ་བརྒྱན་ནས་ཧ་ཅང་ཡང་མི་༡རིང་བ་ཞིག་ན་འདུག་གོ།",
    "གང་རང་བཞིན་ལ་སོགས་པའི་ཁ་ན་མ་ཐོ་བ་སྤང་བར་སྟོན་པ་ལ་སོགས་པའི་ཕྱག་རྒྱ་གང་ཡང་རུང་བས་ཐེབས་ཤིང་ཆེན་པོ་བསྟན་པས་ཁྱབ་ན་ངེས་པར་དེས་བསྟན་པ་བླང་ང་ངོ།",
    "བདུད་རྩི་ལྔ་ནི་བེ་རོ་ཙ་ན་དང་།",
    "བསྲུང་བའི་དོན་དུ་དེ་བཞིན་དུ་། ཞི་བའི་རོ་ཙ་ནས་བཟུང་སྟེ།",
    "དེ་བཞིན་དུ་ཞི་བའི་འཁོར་ལོ་བྲི་བ་ལ་ནི་ཁྱད་པར་གྱི་རྫས་རོ་ཙ་ན་སྟེ་རྔུལ་དང་ཀླད་པ་གང་ཡང་རུང་བས་བྱའོ།",
    "ལྷོ་༢ཕྱོགས་སུ་འགན་སྟན་ཨ་ཤྭཏཱའི་༢༡ལོ་མ་སེར་པོས་བཀང་བའི་སྟེང་དུ་འདུག་སྟེ།",
    "ནུབ་ཀྱི་ཕྱོགས་སུ་ཁ་བལྟས་པ་༡དེའི་ཕྱོགས་སུ་འདུག་པར་བྱའོ།",
    "ཡི་གེ་དམར་པོའི་སྟེང་འདུག་ལ།",
    "གདུག་པའི་ཏིང་ངེ་འཛིན་ནི་སྤྲུལ་པའི་ཁྲོ་བོའི་ཚོགས་རྣམས་ཀྱིས་གདུག་པ་ཅན་གྱི་ཚེར་མ་ཕུར་བུའི་དབྱིབས་སུ་འདུག་པ་ལག་པ་གཡོན་དུ་ཐོགས་ནས་གཡས་པའི་ཐོ་བས་བརྡུང་༡ཞིང་།",
    "རོ་ཙ་ན་དང་རྒྱ་སྐྱེགས་དང་།",
    "ཞེས་པ་ནི་རོ་ཙ་ན་ནི་ཀླད་པའོ།",
    "དེ་སེལ་བར་བྱེད་པའི་རྩི་༢ནི་བེ་རོ་ཙ་ན་དང་བྱི་ཤྭ་དང་ཤུ་ཀྲ་དང་རཀྟ་༤དང་།",
    "དགྲ་ཡི་བེ་རོ་ཙ་ན་བླང་།",
    "ཞེས་པ་ལ་དགྲའི་བེ་རོ་ཙ་ན་ནི་དྲི་ཆེན་ནོ། ༐",
    "དེར་འདུག་སྔགས་བཟླས་བརྟུལ་ཞུགས་ཅན།",
    "དེ་ཡང་རང་ཉིད་དང་མཚུངས་པའོ།",
    "དེ་ནི་སྔོ་བསངས་སུ་འདུག་པ་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་སྣང་མཛད་ནི་བེ་རོ་ཙ་ན་སྟེ་དྲི་ཆེན་ནོ།",
    "རྡོ་རྗེ་འཆང་རང་ངོ་བོ་ཉིད།",
    "རྡོ་རྗེ་འཆང་རང་ངོ་བོ་ཉིད་ཅེས་བྱ་སྟེ་ཡེ་ཤིས་ལྔ་རོ་གཅིག་པའི་ངོ་བོ་ཉིད་ནི་རང་རིག་པ་སྟེ།",
    "དེས་རྣལ་འབྱོར་དུ་མི་འགྱུར་ཞིང་རང་རྒྱུད་ཀྱི་དྲི་མ་དང་བཅས་པས་ན་རྒྱུ་བར་མི་བྱའོ་། ཇི་ལྟར་བྱ་ཞེ་ན།",
    "སྣར་ལ་ཟླ་ཚེས་ཡོད་མེད་གཇིས་ཀ་འདུག་ཀྱང་བསྡུར་མཆན་དུ་བཀོད་མེད་༡༢༣ ༡པེ་སྣར་བརྟེན།",
    "སྣག་ཚ་ལ་སོགས་པ་ཡང་ཟློས་པར་གསུངས་པ་རོ་ཙ་ན་ཞེས་པ་གོ་རོ་ཙ་ནའོ།",
    "ག་ཏྲི་པ་ནི་རོ་ཙ་ན་ལ་སོགས་པ་སྟེ།",
    "འཁྲུལ་འཁོར་གྱི་རིམ་པ་བྲི་བའི་དོན་དུ་རོ་ཙ་ན་ལ་སོགས་ཏེ་༩གང་ལ་དེ་སྟོན་པའོ།",
    "རོ་ཙ་ན་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "ལྷོ་ལ་སོགས་པའི་སྒོ་རྣམས་སུ་ཡ་ཙ་ནི་ར་ཞེས་པའི་ཡི་གེ་བཞི་པོ་ཉི་མ་ལ་གནས་ཤིང་ནག་པོ་དང་།",
    "ཨོཾ་ཡཀྵེ་མ་མེ་ད་ཡ་ཙ་ནི་རཱ་ཛ་ས་དོ་རུ།་",
    "དེ་བཞིན་དུ་ཡི་གེ་ཙ་ནི་བེ་ཅོན་རྡོ་རྗེ་གཤིན་རྗེའི་དགྲའིའོ།",
    "གོ་རོ་ཙ་ན་བླངས་ཏེ་གྲོ་གའམ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ལ།",
    "དགྲ་བཅོམ་མ་ཐོབ་བཞིན་ཏྲེའུ་རྔོག་སོགས་མལ་ཆེན་པོར་འདུག་པ་ལྟ་བུ།",
    "ཕམ་པས་མ་གོས་ཤིང་རང་བཞིན་ཁ་ན་མ་ཐོ་བ་ལ་འཛེམ་པས་བཙུན་པའི་ཡོན་ཏན།",
    "རྒྱ་གར་གྱི་ཞོ་དོ་སྐར་དྲུག་འདུག་། དེས་ན་ཀརྵ་པ་ཎ་གསེར་གྱི་དོང་ཙེ་ཞིག་ཡིན་ལ།",
    "སྲང་ཆེན་ཞོ་དོ་མཐོ་ཙམ་ཡིན་འདུག།",
    "རྟོག་པས་བཏགས་ཙམ་དང་རྟོག་པས་བཞག་པ་དེ་དག་ལ་རང་རང་བྱ་བྱེད་འཐད་དེ། རིན་ཕྲེང་ལས།",
    "ས་བདུན་པར་མཉམ་པར་བཞག་དུས་འདུ་བྱེད་དགོས་པ་མིན་པ་ཁོ་ནས་ཟིལ་གྱིས་གནོན་པ་འདོད་ན་འཐད་སྙམ།",
    "ཞེས་ཐད་ས་བཅད་དུ་འཇིག་རྟེན་ཐ་སྙད་དུ་ཡང་རང་བཞིན་གྱི་གཞན་སྐྱེ་མེད་པར་སྟོན།",
    "ལུགས་འདིར་ཐ་སྙད་དུའང་རང་རིག་དང་ཀུན་གཞི་ཁས་མི་ལེན་ཟེར་ཡང་།",
    "ལུགས་འདིར་དོན་དམ་དུ་མ་ཟད་ཐ་སྙད་དུའང་རང་རིག་བཀག་པ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེ་ལྟ་ནའང་རང་རིག་པའི་རྒྱུ་ཅན་གྱི་དྲན་པ་མི་སྲིད་པ་ཉིད་དུ།",
    "རང་རང་ངོ་བོ་སྟོང་པའི་ཕྱིར།",
    "དེ་ཡང་རང་མཚན་གྱིས་གྲུབ་པར་བཞེད།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "དེ་ཡང་རང་རྒྱུད་ལ་ཡོད་པར་མྱོང་བས་གྲུབ་བོ།",
    "དེ་དྲངས་ཡོད་ཀྱང་རྗེས་ཐོབ་འདོད་པ་ལོས་ཡིན་སྤྱིར་སྲེད་འདི་སོགས་ཀྱང་སྤྱོད་འཇུག་ལེའུ་ཚན་གཅིག་ཡོད་པས་དེར་ཡིན་གསུངས།",
    "རང་རང་དངོས་པོ་སྟོང་པ་ངོ་བོའི་སྟོང་པའི་ཕྱིར།",
    "སྟངས་གཡས་བརྐྱང་ལ་སོགས་པ་སྟབས་འདུག་རྡོ་རྗེ་སྐྱིལ་ཟུང་སྟངས་བཟླས་བརྗོད་དང་།",
    "དཔེ་ལ་འདི་འདྲ་འདུག།",
    "ཞེས་དང་རང་བཞིན་རིག་པ་ཡེ་ནས་རྣམ་དག་ཐིག་ལེ་དང་།",
    "རྟོག་པའི་ཕྱོགས་སུ་མ་ལྷུང་རང་རིག་གདངས་ལ་འདུག།",
    "ཤེས་པའི་རྒྱུད་ལ་ངར་འཛིན་པའི་ཉོན་ཡིད་ཀྱི་རྣམ་དབྱེ་ཡིན་པར་ངེས་འདུག་ཞུ།",
    "དེ་ཡང་རང་རྒྱུད་པ་དང་མི་འདྲ་སྟེ།",
    "ཞལ་ནས་འདི་བར་ཆོད་དུ་འདུག་པས་དངོས་གྲུབ་ལེན་ལུགས་ཤེས་དགོས་གསུངས་པ་ན།",
    "དབྱིངས་ཀྱི་ལྷ་རྣམས་ཀུན་ཀྱང་རང་བསྟིམ",
    "སྟངས་སྟབས་དང་འདུག་སྟངས་ལས་ལ་སྦྱོར་བ་དང་སླར་བསྡུ་བ་བཞི་ནི་རིམ་པ་ལྟར་གཡས་བརྐྱང་ལ་སོགས་པ་དང་།",
    "དབྱིངས་ཀྱི་ལྷ་རྣམས་ཀུན་ཀྱང་རང་བསྟིམ་༴",
    "སྟངས་སྟབས་དང་འདུག་སྟངས་ལས་ལ་སྦྱོར་བ་དང་སླར་བསྡུ་བ་བཞི་ནི།",
    "དགའ་རབ་རྡོ་རྗེས་ཆོ་འཕྲུལ་རྩལ་དང་རང་སྣང་བའོ།",
    "ཆོ་འཕྲུལརྩལ་དང་རང་སྣང་བའོ།",
    "འབྲིང་རང་བཞིན་དང་འབྲས་བུའི་རྟགས་ལ་བརྟེན་ནས་རྟོགས་པ།",
    "བཞིན་བཅོས་བསླད་དང་བྲལ་བ་གྱི་སྣང་རང་རིག་པ་ཐམས་ཅད་དུ་རྩལ་མ་འགགས་པ་བ་རྟོགས་བྱར་གདམས།",
    "གཞན་ཡང་རང་ཉིད་ཀྱི་ཡིད་དང་མཐུན་ཞིང་།",
    "དེ་ནས་རང་རང་སོ་སོའི་བརྒྱུད་སྲོལ་རྣམས་མ་འདྲེས་པ་སྦྱར་བས་འཐུས་ལ།",
    "རྐང་པ་ས་ལ་མ་སྙོམ་པ་ལ་བཅད་གཏུབ་ཀྱི་ཐ་སྙད་སྦྱར་འདུག་པ་ནི་ངག་རྒྱུད་ངན་པས་བསླད་པ་ཡིན་གྱིས་ཤེས་བྱེད་མེད་པའི་ཁར་སྔོན་འགྲོ་དང་ཕྱི་རོལ་གཏོར་མ།",
    "སེམས་བསྐྱེད་ཀྱི་ཁྲིད་འདི་ཁྲིད་ཡིག་སྔ་མ་རྣམས་སུ་ཞིབ་ཆ་ཆེར་མི་འདུག་པས་ཅུང་གསལ་དུ་བཏང་བའོ།",
    "བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ།",
    "འདི་གཉིས་བདེ་མཆོག་དང་གོང་བསྣོལ་འདུག་ཀྱང་ཐ་སྙད་འདོགས་ཚུལ་ཙམ་ལས།",
    "ཡང་ན་མཆོད་ཡོན་གྱི་ཕྱག་རྒྱ་ལ་ནོར་བུ་མིག་གསུམ་པའི་ཕྱག་རྒྱ་ཞེས་མཚན་བཏགས་པ་ཡང་འདུག་གོ།",
    "འོན་ཀྱང་བློ་དམན་པ་རྣམས་འདི་ལྟར་གསལ་བཏབ་ཅིང་གསོལ་བ་འདེབས་པ་བློ་འཁྲུལ་ཚབ་ཆེ་བ་ཞིག་ཏུ་འདུག་གོ།",
    "སྔགས་དོན་ནི་གཞུང་སྔ་མ་རྣམས་སུ་མི་འདུག་ཅིང་།",
    "བཟུང་བའི་གང་ཟག་དུས་ཅི་ཙམ་གྱི་བར་བཟུང་བ།",
    "ཛ་ཧཱུྃ་བཾ་ཧོ་ལན་གཉིས་འདུག་པས་སྔ་མ་ལ་འགུག་གཞུག་སོགས་གྲུབ་ན།",
    "དེ་དག་ལས་ཀྱང་རང་ལ་ཁ་འཛིན་སྡོང་གྲོགས་བྱེད་པའི་མ་ལྟར་བྱམས་ཤིང་སྲིང་ལྟར་གདུང་བ་རྣམས་ལ་འབུལ་བ་སྟེ་དེ་དག་ཀྱང་གཙོ་བོར་ཡུལ་དེ་གྲུབ་པ་ནས་ལྷན་ཅིག་ཏུ་གནས་པ་ཡིན་གྱི།",
    "བྱེད་རྗེས་དོན་གྱིས་སྟོང་ལ་མང་ཞིག་འདུག་པ་མཁས་པར་གྲགས་པ་རྣམས་ཀྱིས་ཀྱང་ས་ཟིན་པ་ལྟར་བྱས་པས།",
    "བུ་རམ་དང་ཕྱེ་བསྲེས་པ་སོགས་ཟ་འདོད་ལ་བསམ་བློ་བཏང་བ་ལྟ་བུ་ཞིག་འདུག་པ་ཡང་ལྐོག་འདུན་མིན་ན་སྐྱོན་མེད་གཞན་མེད་མི་རུང་བའི་མ་ཡིན་ལ།",
    "ཁྱི་ཤ་རུལ་པ་གཅིག་ཕུལ་ན་བཟང་ངན་གྱི་རྟོག་པ་འདུག་མི་འདུག་མངོན་སུམ་གྲུབ་མཆིས།",
    "སྐབས་འདིར་ལུང་རིགས་ཀྱི་སྤྲོས་པ་ཆེ་ཙམ་དགོས་པ་འདུག་ཀྱང་ཡིག་ཚོགས་ལྕི་བ་དང་།",
    "ཞི་བདེ་དོན་གཉེར་རང་རང་ཕན་པའི་སེམས།",
    "འདི་ལའང་རང་ལུས་གཞན་ལུས་གཉིས་གང་རུང་ལ་བརྟེན་ནོ།",
    "དེ་ལྟར་མཉམ་བཞག་སྒྱུ་མ་ལ་བརྟན་པ་ཐོབ་ཅིང་རང་ས་ཟིན་པར་བྱས་ནས།",
    "དེ་རང་ཉིད་ཡིན་པར་བསྒོམས་ལ་སྔར་བཞིན་དུ་བསྟོད་སྨད་སོགས་མི་མཚུངས་པ་སྣ་ཚོགས་བྱས་ལ་དགའ་མི་དགའ་འདུག་གམ་མི་འདུག་བལྟ།",
    "བླང་དོར་དུ་འདུན་པར་འདུག་ན་གཉེན་པོས་ཚར་བཅད་དོ།",
    "དེ་ལ་དགའ་མི་དགའི་བླང་དོར་འདུག་གམ་མི་འདུག་བལྟས་ལ།",
    "འདུག་ན་ཡུལ་ཡུལ་ཅན་ཐམས་ཅད་སྒྱུ་མར་ཤེས་པའི་སྒོ་ནས་ལེགས་པར་སུན་ཕྱུང་སྟེ་བསྒོམས་པས།",
    "བླང་དོར་དུ་འདུག་པའི་ཡུལ་རྫུན་པོའི་རྗེས་ཤེས་གཉིས་ལས་བལྟས་པས་ཀྱང་ཁྱད་མེད་པར་བཅོས་མིན་གོ་བ་འབྱུང་ངོ།"
  ]
}