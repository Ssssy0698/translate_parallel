    "ཁས་བླངས་ཀྱི་དམ་ཚིག་ཉམས་ནས་འདུག་པ།",
    "ཨེ་རྣལ་འབྱོར་མ་འདི་ང་ལ་རྫུ་བར་འདུག་དེ་ཙུག་བྱ་དགོས་པ་དེ་ང་མིན་གསུངས་ནས་ཕྱག་ལྕག་བརྒྱབ་པས་བརྒྱལ་ལོ།",
    "རྟ་ནག་པོ་བཀྱུད་ནས་འདུག་པ་གསུངས་དེ་ཀ་ཕགས་ལགས་བྱས་པས།",
    "བརྡུངས་པས་ཞ་ཆུང་མ་འདི་རྒྱལ་ཁབ་ཡོངས་སུ་གྲགས་པ་ཞིག་ཡོང་བར་འདུག་གསུངས།",
    "ཞ་ཆུང་མ་འདི་སྒྲུབ་པ་མཐའ་རུ་ཐོན་པ་ཞིག་ཡོང་བར་འདུག་གསུངས།",
    "ད་ལྟ་རྒྱ་གར་ནའང་གདམས་ངག་ཁམས་འདུས་སྲོལ་བ་ལ་ཁོང་བས་མཁས་པ་མེད་པར་འདུག་ཟེར་བས།",
    "རྩའི་མདུད་པ་གྲོལ་དུ་འདུག་གསུངས་སོ།",
    "ཁོང་ལ་མངོན་ཤེས་པར་འདུག་སྙམ་པ་བྱུང་།",
    "མཁའ་འགྲོ་མ་ཀུན་རིངས་ཀྱིན་འདུག་གསུངས།",
    "བཀའ་རྒྱུད་ཀྱི་བདག་པོ་ལགས་པར་གདའོ།",
    "ཐ་མལ་གྱིས་མི་བགྲོད་པ་ཞིག་འདུག་དེའི་མཐའ་མ་ཞིག་ན།",
    "ཐུགས་རྗེ་ཆེན་པོའི་ཞིང་ཁམས་སུ་སྐྱེ་བར་འདུག་ད་ལྟ་ཕན་གདགས་ཐབས་མི་འདུག་གསུངས་སོ།",
    "དེ་སྒྲོལ་མ་དངོས་སུ་འདུག་དངོས་སུ་མཐོང་བ་ནི་ཤིན་ཏུ་ལེགས།",
    "དྷ་མ་རུ་དང་ཐུགས་དམ་ཤེལ་འཕྲེང་གཉིས་ཉི་ཟེར་ལ་བཀལ་ནས་འདུག་པ་མཐོང་།",
    "བལྟས་ཙ་ན་བར་སྣང་ལ་ལིང་ངེ་གདའོ།",
    "བཅུ་གཅིག་པ་ཆ་ག་ཀ་ནང་བཤོས་སྐྱེལ་དུ་ཕྱིན་ཙ་ན་ན་བཟའ་སྦུ་གུ་དང་ངེ་བྱས་ནས།",
    "ཞ་ཆུང་མ་བྱ་བ་ལགས་ཚོད་གདའ་བས།",
    "དེའི་དུས་སུ་དེ་རིང་ལས་ཅན་གཅིག་འོང་བར་འདུག་གསུང་ཙ་ན།",
    "ཁོ་རང་འགྲུབ་པའི་ལོ་ལ་དོན་ཤོར་དུ་ཆུགས་མཛོད།",
    "ཡང་ཙ་རི་ན་བཞུགས་ཙ་ན།",
    "འདི་རུ་ཆུ་ཞིག་དགོས་པར་འདུག་གསུངས་ནས།",
    "བུ་ནི་མེད་པའི་རྒྱལ་སྲིད་སྟོང་པར་འདུག།",
    "ཡབ་ཡུམ་གཉིས་ཀྱང་དུས་དེ་རིང་གཏམ་དེ་དགྲ་ལས་འཆི་ཉེན་ཆེ་བ་འདུག་སྙམ་དགོངས་ནས།",
    "འཆི་བ་ནམ་ཡོང་མི་འདུག་པའི།",
    "དེ་ནས་ནམ་ཞིག་དུས་ཀྱི་ཚེ།",
    "བདག་ཀྱང་རང་ཡུལ་ལོག་ཀྱང་རུང་།",
    "དང་པོ་སྒོམ་གྱིས་གསུངས་པས་ལུང་བསྟན་སླེབས་འདུག་པས།",
    "ལྕེབས་ནས་ཤི་ནས་རུང་དྲག་འདུག་ཟེར་ནས།",
    "ཨ་ཙ་མ་ང་རང་ལས་ངན་ཡིན།",
    "ལྷོའི་མི་རྣམས་བཟོད་པ་སྒོམ་གྱིན་འདུག།",
    "ན་ནིང་ལོ་ལ་གཞོན་ཅན་འདུག་པ་ན།",
    "ད་ལོའི་ལོ་ལ་རྒས་ནས་མི་འདུག་གོ།",
    "ད་ལོའི་ལོ་ལ་གཉེར་མ་གསུམ་ཙམ་འདུག།",
    "ད་ལོའི་ལོ་ལ་སྐུ་དཀར་དགུ་ཙམ་འདུག།",
    "ན་ནིང་ལོ་ལ་སོ་གྲལ་འགྲིག་པོ་འདུག།",
    "ན་ནིང་ལོ་ལ་གཟུགས་པོ་དྲང་པོར་འདུག།",
    "ན་ནིང་ལོ་ལ་སྨྲ་བ་བསྟན་པོར་འདུག།",
    "ན་ཚོད་རྒན་ནས་ཡོང་བ་མི་འདུག།"
  ]
}