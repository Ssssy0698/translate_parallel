    "ཁྱད་པར་གདན་ས་ཆེན་པོ་དང་ཉེ་བའི་ཆར་ནི།",
    "ལྡམ་བུ་དང་ལོ་མ་ཁ་དོག་སྣ་ཚོགས་པ་མཛེས་པར་བཀོད་པ་དུ་མས་ནི་བརྒྱན།",
    "རྗེ་འགྲོ་བའི་མགོན་པོའི་བར་གྱི་སྐུ་བརྙན་དག་རིག་བྱེད་ལ་མཁས་པའི་ཕུལ་དུ་ཕྱིན་པ་རྣམས་ཀྱིས་མཚན་ཉིད་དང་ལྡན་པར་བཞེངས་ཤིང་རབ་ཏུ་གནས་པ་ཚུལ་བཞིན་དུ་མཛད་དེ།",
    "བས་ཡིད་རྟོན་པར་འོས་པ།",
    "བཞུགས་གནས་འདག་སྦྱར་ནང་དུ་བྱེད།",
    "ཞེས་བཀའ་སྩལ་ཏེ་འདིའི་ཤུགས་བསྟན་དུ་གདན་ས་ཆེན་པོ་འདིའི་མ་འོངས་པའི་གནས་ལུང་བསྟན་པའི་རྣམ་བཞག་ཟབ་རྒྱས་ཡོད་པར་མཐོང་བས།",
    "རྟོག་གེ་པ་རྣམ་དཔྱོད་ཡོད་པར་རློམ་པ་རྣམས་སོ་བདུན་ཐར།",
    "བྱང་འཕགས་དང་ཉན་རང་སོགས་ཀྱིའང་ཆ་ཙམ་ཡང་དཔག་པར་མི་ནུས་ན།",
    "བཞེས་པ་འདྲེན་པར་ཞུས་ཏེ་ཡན་ལག་བདུན་པ་མཛོད་ཀྱི་བར་ལ་དཀར་གསུམ་གྱི་ཞལ་ཟས་ཁ་ན་མ་ཐོ་བ་མེད་པ་སྟ་གོན་བགྱིས་ཏེ་ནམ་སེང་ལ་བཞེས་པ་ཞུ།",
    "ཆབ་ཚ་བསྐོལ་ཞིང་བཞེས་པ་འོང་བར་ཞུས་ཏེ།",
    "དེ་ནས་གསུང་བཅད་མཛད་ནས་ཡུན་རིང་རབ་ཅིག་ཐུགས་དམ་ལ་བཞུགས་དེ་ནས་ཉེ་གནས་ཀྱི་གཏོར་ཇ་བསྐོལ་བའི་ཚུལ་གསོལ།",
    "ངོ་སྤྲོད་དང་ཞལ་ཏ་མང་དུ་གསུངས།",
    "དེ་ནས་གསུང་བཅད་མཛད་དེ་ཐུགས་དམ་ལ་བཞུགས།",
    "ཅི་ནས་ཀྱང་བརྩེ་བ་ཆེན་པོས་བཀའ་དྲིན་གྱིས་སྐྱོང་བར་འཚལ་ཞེས་ཞུས་པས་གནང་སྟེ་ཁམས་པའི་མགྲོན་པོ་ཟླ་བ་མར་ངོ་ལ་འོངས་པ་ཡང་སྐུ་ཁམས་བཟང་བའི་སྐབས་སུ་མཇལ་བ་ཡིན།",
    "འཇག་སྤྱིལ་དུ་སྤྱན་སྔར་གདན་དྲངས་སྐུ་རིམ་དུ་མཆོད་སྦྱིན་རྒྱས་པར་མཛད།",
    "འཛིན་གཉིས་དག་པས་མཁྱེན་གཉིས་ལྡན།",
    "མཁྱེན་དང་བརྩེ་དང་ནུས་ལྡན་པའི།",
    "སྤྱན་སྔར་དུས་གསུམ་བཤགས་པར་བགྱི།",
    "དུས་གསུམ་སྐུ་གསུམ་ཐོབ་པར་ཤོག།",
    "སྣང་བརྙན་གདན་འཛོམས་དུ་བཞུགས་པ་ཡིན་ནོ།",
    "འབྲོ་ཟངས་ཚལ་གྱི་གསེར་གྱི་པུ་ཏི་བདུན་ཅུ་ཉིན་གཅིག་ལ་ཕུལཾ་བ་སོགས་སྐུ་གཟུགས་དང་གླེགས་བམ་མཆོད་རྟེན་སོགས་ཆེས་མང་དུ་ཕུལ་བ་རྣམས་ཁྲི་འཕང་ན་བཟའ་དང་བཅས་ཏེ་བཞུགས་ཤིང་།",
    "སྔོན་གྱི་རྒྱལ་བ་ལ་ལྷག་པར་བྱ་བྱས་པ།",
    "ནོར་བཞི་ཨཱབརྒྱ་། ཤེས་པར་བྱེད་པའི་ཤེས་རབ་དང་།",
    "གཅིག་ཤེས་ཐམས་ཅད་གྲོལ་བའི་ཀུན་མཁྱེན་རྣམས་ནི་མངོན་སུམ་དུ་རྒྱུད་ལ་སྐྱེས།",
    "ད་ལྟར་གྱི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་གཅིག་པའི་བདག་ཉིད་དུས་གསུམ་ཤེས་བྱའི་དཀྱིལ་འཁོར་མ་ལུས་པ་མཁྱེན་པའི་ཡེ་ཤེས་བརྙེས་པ།",
    "ཕྱོགས་བཅུ་དུས་གསུམ་གྱི་འདྲེན་པ་རྣམས་ལས་ཡོན་ཏན་བཀོད་པ་ཀུན་གྱིས་ཁྱད་པར་དུ་འཕགས་པ།",
    "ལྷུན་པོ་ལྟར་ཡངས་ཤིང་མཛེས་པའི་གདན་སེང་གེའི་ཁྲི་ཆེན་པོའི་སྟེང་དུ་ཐུགས་མི་གཡོ་བ་མཉམ་པ་ཉིད་ལྷུན་གྱིས་གྲུབ་ཅིང་བཞུགས་པ།",
    "གཞན་སུས་ཀྱང་མ་བསྐོར་བའི་ལེགས་པར་༧ འ་པ།",
    "འདོན་དུ་བཅུག་པས་དངོས་གྲུབ་ཐོབ་པར་འགྱུར།",
    "སྤྱིར་གནང་བཀག་ལ་སོགས་པ་འབའ་ཞིག་གསུང་།",
    "ཤེས་གསུངས་བཀའ་བརྒྱུད་འདི་ཉིད་ཀྱི་གླིང་ཆེན་རས་པ་ལ་མངོན་གྱུར་གྱི་རྟོགས་པ་ཡོད་ཀྱང་གདུལ་བྱ་དེ་ཙམ་མ་བྱུང་།",
    "སྤྱོད་པ་རྣམ་པར་དག་པའང་གལ་ཆེ་གསུངས་ནས་ཞལ་ཏ་༢ མཛད་གླིང་དུ་ཤ་ཆང་ཡེ་མི་འགྲིམ།",
    "གཅིག་པུར་བསྡད་ན་རང་བདེ་འོང་བ་ཡིན།",
    "འཕྲལ་སྦྱིན་བྱས་ན་ཟན་གཏེར་འོང་བ་ཡིན།",
    "ཐམས་ཅད་སྟོང་ཞིང་བདག་མེད་པར་སྟོན།",
    "བསམ་གཏན་ལ་མཉམ་པར་འཇོག་དོན་དམ་དུ་ཐམས་ཅད་སྟོང་ཞིང་སྐྱེ་མེད་དུ་རྟོགས་པའི་ཤེས་རབ་རྒྱུད་ལ་བསྐྱེད་ཅིང་།"
  ]
}