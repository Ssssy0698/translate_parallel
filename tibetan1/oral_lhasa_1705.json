    "འདུམ་འགྲིག་ལེགས་འགྲུབ་མ་བྱུང་ཚེ་གཏུགས་བཤེར་བྱས་ཆོགཡིན་ཡང་དེ་ལས་ལྡོག་ན་མི་ཆོག་སྟེ།",
    "འགྲིམ་འགྲུལ་བྱུར་ཉེས་ལ་འདུམ་འགྲིག་བྱེད་པར་མི་གང་དག་ཞུགས་དགོས།",
    "འགྲིམ་འགྲུལ་བྱས་ཉེས་ལ་བྲོས་བྱོལ་བྱེད་པ།",
    "གལ་སྲིད་འགྲིམ་འགྲུལ་བྱས་ཉེས་དང་འབྲེལ་བའི་དོགས་གཞི་ཅན་གྱི་འཁོར་ལོ་མཐོང་ཚེ།",
    "འགྲིམ་འགྲུལ་བྱས་ཉེས་ལ་བྲོས་བྱོལ་མཁན་དང་འཁོར་ལོ་མ་རྙེད་ཚེ།",
    "ངེས་པར་དུ་འབྲི་དགོས་པ་ཞིག་མ་ཡིན།",
    "དེ་ལྟར་ཡིན་པས་འགྲིམ་འགྲུལ་བྱུར་ཉེས་ཁྲོད་དོ་བདག་བྲོས་བྱོལ་བྱས་པར་བྲོས་བྱོལ་མཁན་གྱིས་འགན་འཁྲི་ཡོངས་རྫོགས་འཁུར་དགོས།",
    "དོ་བདག་ཕྱོགས་གཞན་པར་ནོར་འཁྲུལ་ཡོད་པའི་བདེན་དཔང་ཡོད་ན།",
    "འགྲིམ་འགྲུལ་བྱུར་ཉེས་བྱུང་རྗེས་བྲོས་བྱོལ་བྱས་པར།",
    "འགྲིམ་འགྲུལ་བྱས་ཉེས་ལ་བྲོས་བྱོལ་མཁན་གྱིས་གྱོད་དོན་གྱི་རྗེས་ནས་ཡང་བསྐྱར་འཕྲུལ་སྒུལ་འཁོར་ལོའི་རིགས་བསྐོར་ཆོག་གམ།",
    "བསམ་པའི་གྱོང་གུན་གྱི་ཁ་གྲངས་གཏན་འཁེལ་བྱེད་པར་རྒྱུ་རྐྱེན་གང་དག་ཡོད།",
    "དེ་ནི་འགྲིམ་འགྲུལ་བྱུར་ཉེས་བྱུང་བ་ནས་འགྲིམ་འགྲུལ་བྱུར་ཉེས་ཀྱི་མཇུག་འབྲས་ཀྱང་ཀྱིཔརསྐྱིན་ཚབ།",
    "གཤགས་བཅོས།",
    "ངེས་པར་དུ་སྐྱིན་ཚབ་འཇལ་དགོས།",
    "ེངལ་རྩོལ་འགོར་འགྱངས་ཀྱི་སྐྱིན་ཚབ་རྩིས་རྒྱག་པར་རྒྱུ་རྐྱེན་གང་དག་ལ་བསམ་བློ་གཏོང་དགོས།",
    "བྱས་པའི་དུས་ཡུན་དང་།",
    "རྩིས་རྒྱག་སྐབས་སུ་ངལ་རྩོལ་ནུས་པ་ཤོར་བའི་ཚད་གང་འདྲ་ཞིག་ལ་སླེབས་ཡོད་པར་བསམ་གཞིགས་བྱེད་དགོས།",
    "མི་ལུས་ལ་རྨས་སྐྱོན་ཕོག་པའི་དངུལ་དེ་ངེས་པར་དུ་ཐེངས་གཅིག་ལ་སྤྲད་ཚར་བ་བྱེད་དགོས་སམ།",
    "འཕྲུལ་སྒུལ་འཁོར་ལོར་ངེས་པར་དུ་ཉེན་སྲུང་གཏོང་དགོས་སམ།",
    "ངེས་པར་དུ་ཉེན་སྲུང་གཏོང་དགོས།",
    "འཁོར་ལོ་ཡོངས་རྐུ་འཁྱེར་བྱས་པའི་ཉེན་སྲུང་དང་།",
    "འགྲིམ་འགྲུལ་བྱུར་ཉེས་བྱུང་རྗེས་སུ་སྐྱིན་ཚབ་ལེན་པར་བྱ་བ་གང་དག་བསྒྲུབ་དགོས།",
    "ཉེན་སྲུང་གཏོང་མཁན་གྱི་མཁོ་འདོན་བྱས་པའི་དཔང་ཡིག་ཚང་མ་དོན་དངོས་བློས་འཁེལ་བ་ཤ་སྟག་ཡིན་དགོས།",
    "ངེས་པར་དུ་ཡིད་འཇོག་བྱེད་དགོས་པ་ཞིག་ནི།",
    "ཉེན་སྲུང་སྐྱིན་ཚབ་ལེན་པར་གོ་རིམ་གང་དག་བརྒྱུད་དགོས་པ་ཡིན།",
    "ཉེན་སྲུང་སྐྱིན་ཚབ་ལེན་པར་གཤམ་གསལ་གོ་རིམ་བརྒྱུད་དགོས་ཏེ།",
    "གལ་ཏེ་རང་ཉིད་ལ་རྨས་ཕོག་ཡོད་ན་སྐུ་ཚབ་པར་བྱ་བ་དེ་བསྒྲུབ་ཏུ་འཇུག་དགོས།",
