    "ཁ་ཤས་ཀྱིས་གྲུམ་རྩེ་དང་སྤུ་ཕྲུག་སོགས་འཐག་ལས་བྱེད་ས་ནས་ཁྲག་གི་མིག་ཆུ།",
    "བྲག་གཡབ་སྐྱབས་མགོན་སྐུ་ཕྲེང་དགུ་པ་མ་དགོན་དུ་གསེར་ཁྲིར་མངའ་གསོལ་རྒྱས་པ་ཞུ་སྐབས་བོད་གཞུང་གི་སྐུ་ཚབ་ཏ་མདའ་ར་ས་རྒྱ་རྒན་གཏོང་གནང་མཛད་པ་དང་།",
    "གསེར་ཁྲིར་མངའ་གསོལ་གྱི་དགྱེས་སྟོན་ཆེན་མོ་ལེགས་པར་གྲུབ།",
    "བྱམས་མདུན་ཆིབས་རགས་ཆེན་མོའི་ནང་བུ་དགོན་གྱི་ལྡེ་འཆང་དང་གཉེར་དྲུང་བཅས་ཀྱི་ལས་ཞྭ་ལས་གོས་གྱོན་ཏེ་སྒེར་གྱི་གཡོག་འཁོར་རྟ་པ་ལྔ་བཅུ་དྲུག་བཅུ་ཙམ་དང་།",
    "སྐབས་དེར་ར་བྱམས་མདུན་བཅའ་སྡོད་ཏ་དང་དམག་གི་མདའ་དཔོན་ར་ས་རྒྱ་རྒན་དང་རུ་བརྒྱ་ལྡིང་སོགས་དཔོན་འཁོར་རྟ་དམག་བརྒྱ་དང་།",
    "དམག་གི་སྒྲིག་སྲོལ་ལྟར་གོམ་སྟབས་འགྲིག་པོས་བཤར།",
    "རྔ་ཆེན་དང་འབུད་དཀྲོལ་འདྲ་མིན་ཁ་ཤས་དང་བཅས་རྔམ་བརྗིད་ལྡན་པ་བསྐྱོད་དེ་ཕེབས་བསུ་ཞུས།",
    "ཕོ་མོ་རྒན་གཞོན་བརྒྱ་སྟོང་མང་པོས་གཟབ་འཕྱོར་དང་བཅས་སྤོས་དང་མེ་ཏོག་ཁ་བཏགས་སོགས་ཐོགས་བཞིན་ལག་གཉིས་ཐལ་མོ་སྦྱར།",
    "རྒྱལ་ཁང་གི་ཚོགས་ཁང་ཀ་བརྒྱ་མའི་ནང་དུ་མཛད་སྒོ་ཚུགས།",
    "སྐབས་དེར་རང་ཉིད་ཕྲུ་གུ་སོང་ཙང་དེ་ཙམ་ལས་ཞིབ་གནས་བརྗོད་མ་ཤེས།",
    "བྱམས་མདུན་ཁང་ཚན་གྱིས་ལྷ་མོ་འཁྲབས་པ།",
    "གླུ་གཞས་སོགས་ཀྱི་གཟིགས་འབུལ་ཞུས།",
    "ཇོ་འབུམ་ཐང་ནས་གནས་པོ་རྡོ་རྗེ་གུར་མགོན་ཐོག་ཕེབས་སྐབས་ལྷ་སྲུང་ཡུལ་པའི་རྟ་པ་ཉིས་བརྒྱ་ཙམ་མཉམ་ཆས་ཞུས་ཤིང་གནས་པོའི་ཐོག་ཞག་རེ་ཟུང་བཞུགས་ཏེ་གསོལ་མཆོད་རི་ཁྲུས་སོགས་གནང་རྗེས་བྱམས་མདུན་བར་ཆིབས་སྐྱེལ་ཞུས།",
    "སྐབས་འགར་གཅིག་ཀྱང་མེད་པ་ཡང་ཡོང་གི་འདུགབཙོན་པ་དེ་རྣམས་ནི་སྒེར་དོན་གྱི་ཆེད་མི་བསད་པ་དང་།",
    "ཉེས་པ་ཆེ་བ་ཁ་ཤས་ལོ་གསུམ་ནས་བདུན་བར་རྒྱང་འབུད་གཏོང་བ་བཅས་དང་།",
    "སྐྲ་ཡི་ལྟག་ཕུད་ལ་གཡུ་བྱུར་གྱི་ཕྲ་ཡོད་པའི་འགུ་ཡ་ཁ་ཤས་དང་བ་སོའི་ཐེབ་སྐོར་རྒྱག་མཁན་ཞིག་འདུག་དེའི་འཁྲིས་ལ་ལྟ་སྲུང་བྱེད་མཁན་ནང་ཟན་གཉིས་འདུག་ཀྱང་ལག་ཏུ་མེ་མདའ་དང་དབྱུག་པ་སོགས་གང་ཡང་མི་འདུག་མི་གསོད་མཁན་རེད་ཟེར་དུས་ཚང་མས་རྫབ་ཆེན་ཁོ་ཟེར་ནས་ཧ་ལས་ལས་བྱེད་ཀྱི་འདུག་མི་དེ་གདོང་དམར་ཤས་ཆེ་བ།",
    "རྒྱ་དང་ཁ་སྤུ་ཡོད་པ་ཞིག་འདུག་པ་དང་མི་གསོད་མཁན་རེད་ཟེར་དུས་རང་ཉིད་ཕྲུ་གུ་ཡིན་པར་སོང་།",
    "ཏོག་ཙམ་ཞེད་སྣང་གིས་འཁྲིས་ལ་བཅར་མ་ཕོད་པ་འདྲ་པོ་བྱུང་།",
    "ཁོས་མགོ་སྒུར་སྒུར་བྱས་ཏེ་ཁ་ནས་མ་ཎི་སྒྲ་ཐོས་ལ་མ་ཐོས་ཙམ་ཞིག་འདོན་གྱི་འདུག་ཉིན་རེ་ཆུ་ཚོད་གཉིས་གསུམ་ཙམ་རེ་ཉིན་གསུམ་ལ་བཞག་སོང་།",
    "དེ་རྗེས་གོ་ཐོས་ལ་མི་གསོད་མཁན་དང་རྐྱེན་འདས་སོང་བའི་ནང་མི་གཉིས་མོས་མཐུན་བྱུང་བར་བརྟེན།",
    "མི་སྟོང་སྤྲོད་ལེན་བྱས་ཏེ་གསོད་མཁན་དེ་གློད་བཀྲོལ་བཏང་བ་རེད་ཟེར།",
    "ཁྱོད་འདིར་བསྡད་ནས་ག་རེ་བྱེད་ཀྱི་ཡོད་ལབ་པས།",
    "ངས་བུད་མེད་འདི་ཡང་བཙོན་པ་ཡིན་གྱི་རེད་བསམ་སྟེ།",
    "བུ་མོ་ཁྱེད་བཙོན་པ་ཨེ་ཡིན་ལབ་པས།",
    "ཁོ་གཉིས་ཀ་གད་མོ་བགད་སོང་།",
    "མོ་ངའི་དགའ་རོགས་རེད་ཟེར་བ་དང་།",
    "བུད་མེད་དེས།",
    "དགའ་རོགས་མ་རེད་སྡུག་རོགས་རེད།",
    "དུས་ཇ་ཆང་འཐུང་རོགས་རེད།",
    "སྡུག་དུས་ཁྲེས་པོ་འཁུར་རོགས་རེད་ཟེར།",
    "ཐག་གཅོད་བྱས་ཚར་བའི་བཙོན་པ་ནི་ཉིན་གུང་ཕྱི་ལོགས་དོན་ཏེ་ནང་མི་དང་མཉམ་དུ་བསྡད་ཆོག་གི་རེད་ཟེར།"
  ]
