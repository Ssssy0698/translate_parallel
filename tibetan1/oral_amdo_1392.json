    "མེ་མདའ་བཟུང་བའི་རྒྱ་དམག་གིས་སྒོ་སྲུང་ཡོད་སྟབས་མིང་ནས་འབོད་ཀྱང་ཁོ་པ་ནང་ལོགས་ཐར་ཐུབ་ཀྱི་མ་རེད་ལབ་པ་ཡིན།",
    "སྔོན་མ་ནས་མདུན་ཆུང་མཆོག་གིས་དམ་ལ་བཏགས་ཏེ་སྲུང་མ་བསེ་ཁྲབ་པའི་འཁོར་དུ་བཅུག་པའི་གནས་ཚུལ་ཤོད་རྒྱུ་ཡོད་པ་དང་བྲག་གཡབ་པར་གནོད་པ་བྱེད་ཀྱི་མེད་པའི་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "བྲག་གཡབ་ཀྱི་སྲུང་མ་ཐུན་མོང་མ་ཡིན་པ་བསེ་ཡི་ཁྲབ་ཅན་བསྟེན་གསོལ་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "ད་ལྟ་བྲག་གཡབ་ཅེས་པ་དེ་ལ་སྔོན་མ་ཉག་རེ་ཞེས་ལབ་ཀྱི་ཡོད་པ་རེད།",
    "ཉག་རེ་དཔོན་ཚང་གི་ཁང་པའི་གྱང་རོ་ད་ལྟ་ཡང་མཐོང་རྒྱུ་ཡོད།",
    "གྲུབ་ཐོབ་ཉག་རེ་སེ་བོ་ཞེས་པའི་མཚན་དེ་ཉག་རེ་ནས་ཡིན་པ་ལས་བྱུང་བ་དང་།",
    "༡༩༤ ཞེ་གྲངས་ཀྱི་སྐོར་ལ་ས་དཀར་རྡོ་རྗེ་འཆང་གིས་གནས་པོ་རྡོ་རྗེ་གུར་མགོན་དང་།",
    "ཞེས་གསུང་ཡོད་པ་རེད།",
    "༡༩༥༩ ལོར་རྒྱ་ཁྲག་གི་མིག་ཆུ།",
    "ང་ཕ་ཡུལ་མཛོ་སྒང་ནས་ཡིན་ཟེར་མཁན་ཤ་སྟག་རེད།",
    "ཆེན་མོ་དང་།",
    "མགྲོན་གཉེར་ཆེན་མོ།",
    "དེ་གཉིས་སེར་མོ་བ་ཡིན་དགོས།",
    "དཔོན་རིགས་མཐོ་བ་རྣམས་བྲག་གཡབ་སྐྱབས་མགོན་མཆོག་ལ་བཀའ་བསྐོར་བའི་འོག་སྤྱི་མཛོད་རང་གིས་ཐད་བསྐོས་བྱེད་ཀྱི་ཡོད།",
    "ད་དུང་གམ་བཅར་གྲྭ་ཚང་དང་སྐུ་གམ་དུ་ལས་དོན་སྒྲུབ་མཁན་ཡང་ཡོད་པ་རེད།",
    "ལྤགས་ཁྲག་གི་མིག་ཆུ།",
    "བྲག་གཡབ་ནས་འབྲུ་ཁལ་དྲུག་སྟོང་ཕུལ་བ་རེད།",
    "དུས་ཚོད་ངན་པའི་ཁྲལ་ལ་གྱུར་ཞེས་པ་ལྟར་དེ་ནས་བཟུང་ལོ་ལྟར་བོད་གཞུང་ལ་དམག་ཕོགས་ཀྱི་མཐུན་རྐྱེན་ལོ་རེ་འབྲུ་ཁལ་དྲུག་སྟོང་རེ་འཇལ་དགོས་ཆགས་པ་དང་།",
    "དཔོན་དམག་ཁག་གཅིག་གིས་མི་སེར་ལ་བརྡབ་གསིག་གང་མཚམས་ཤིག་སྤྲད་ཡོད་པ་རེད།",
    "བྲག་གཡབ་ཀྱིས་ལོ་ལྟར་བོད་ཟླ་གསུམ་པའི་ཚེས་༣ ནས་བཟུང་བདུན་ཕྲག་གཅིག་གི་རིང་ལ་ཁྲག་གི་མིག་ཆུ།",
    "ཧམ་ཤད་བཙན་གནོན་སོགས་མི་ཆོག་རྒྱུའི་བཀའ་བསྒྱུར་གནང་གི་ཡོད་ཀྱང་དཔོན་རིགས་མང་པོ་ཞིག་གིས་ལག་ལེན་དེ་ལྟར་བྱེད་ཀྱི་མེད་པ་རེད།",
    "ཤྭ་བ་དང་གནའ་བ་སོགས་ཁྱུ་དང་ཁྱུ་ཡོད་པ་ནས་སྐབས་འགར་ཉིན་མོ་ཟོག་ཁྱུ་ནང་ཡོང་གི་ཡོད་པ་དང་།",
    "ས་སྨད་རྒྱུད་དབྱར་ཁ་གནའ་བ་ཁྱུ་དང་ཁྱུ་ཞིང་ཁར་ཡོང་ནས་ལོ་ཏོག་ཟ་གི་ཡོད་པས་ཆེད་དུ་སྲུང་མཁན་བཞག་སྟེ་འུར་རྡོ་དང་རྔ་བརྡུངས་ནས་དཀྲོག་དགོས་ཀྱི་ཡོད།",
    "ཁྱིམ་ཚང་དབུལ་ཕྱུག་ལ་མ་བལྟོས་པར་ཕྲུ་གུ་བུ་དང་བུ་མོ་དབྱེ་འབྱེད་ཆེ་རིགས་མེད་པར་ལོ་བདུན་བརྒྱད་ཙམ་ལ་སླེབས་ནས་རང་གི་ཁྱིམ་ནང་དང་།",
    "ཁྱིམ་ཚང་དབུལ་པོའི་བུ་དང་བུ་མོ་ལ་ལྟ་སྐྱོང་ཆེ་ཙམ་བྱེད་ཀྱི་ཡོད།",
    "སྙན་ངག་བཅས་བསླབ་ཁྲག་གི་མིག་ཆུ།",
    "རྒན་ཨ་མཁྱེན་ནི་༡༩༥༩ལོ་ནས་རྒྱ་མིས་འཐབ་འཛིངས་བཏང་བ་དང་།",
    "ཟས་གོས་ཀྱིས་དབུལ་བ་སོགས་སྡུག་བསྔལ་མྱངས་པ་རེད།",
    "ནང་ཟུར་བུ་བསམ་སྟོབས་ནི་༡༩༥༩ལོར་རྒྱ་དམག་གིས་མེ་མདའ་བརྒྱབ་ནས་བཀྲོངས་པ་རེད།",
    "འབྲི་ཤེས་མཁན་བརྒྱ་ཆ་ཉི་ཤུ་ཙམ་ཡོད་པ་རེད།",
    "ལྷ་མོ་འཁྲབ་པ་སོགས་དར་སྲོལ་ཆེ་ཙམ་ཡོད་པ་རེད།",
    "བྲག་གཡབ་དབུས་ནས་རྒྱལ་ས་ལྷ་སའི་བར་བསྐྱོད་ན་རྟ་ལམ་སུམ་ཅུ་སོ་དགུ་ཡོད་ཀྱང་དཀའ་ངལ་ཆེད་བསད་ཀྱིས་བོད་གཞུང་གི་དམག་མི་ཁྲི་ཚོ་གཉིས་དང་འགྲོགས་ཏེ།",
    "བྱས་པ་ལ་བོད་གཞུང་ནས་གཟིགས་བཟོས་རྒྱ་ཆེ་གནང་བ་དང་།",
    "ཕྱི་ལོ་༡༨༨༨ ལོ་དང་༡༩༤ ལོའི་སྐབས་དབྱིན་ཇིའི་དམག་གིས་བོད་ལ་དྲག་པོའི་བཙན་འཛུལ་བྱས་པར་བཙན་རྒོལ་རྒྱལ་སྲུང་གི་ཆེད་དུ་བྲག་གཡབ་དམག་སྟོང་ཕྲག་བརྒལ་བ་རྒྱལ་རྩེ་དང་།",
    "ཕག་རི་སོགས་ལ་བོད་གཞུང་དམག་དང་མཉམ་དུ་དཔའ་ངར་ཞུམ་མེད་ཀྱིས་དགྲ་བོའི་དཔོན་དམག་མང་པོ་བསད་རྨས་བཏང་ཡོད་པ་རེད།",
    "འབའ་ཐང་རྒྱུད་ནས་རྒྱ་དཔོན་དོ་ཐེ་ཟེར་བ་དེས་རྒྱ་དམག་སྟོང་ཕྲག་གཉིས་ཁྲིད་ནས་དཔུང་བསྐྱོད་བྱས་པ་ལ་བྲག་གཡབ་ཀྱི་ཡུལ་དམག་གིས་འགོག་རྒོལ་དྲག་པོ་བྱས་ཏེ་རྒྱ་དམག་བསད་རྨས་གང་འཚམས་ཐུབ་པ་བྱུང་ཡང་།",
    "རྒྱ་དམག་ལ་མེ་སྒྱོགས་དང་མེ་མདའ་དགུ་བོག་ཅེས་པ་མདེའུ་དགུ་རེ་བླུགས་ཆོག་པའི་འཕྲུལ་མདའ་སོགས་ཡོད་ཁྲག་གི་མིག་ཆུ།",
    "མི་གཅིག་གི་གཟུགས་པོའི་པགས་པ་བཤུས།",
    "ཡང་མི་གཅིག་གི་རྐང་ལག་བཞི་པོ་དུད་འགྲོ་མཛོ་བཞི་ལ་རྐང་ལག་བཏགས་ནས་ཤོག་སྦག་སྦར་བ་དང་དམག་མིས་འུར་དེད་བྱས་སྟབས་མཛོ་འདྲོགས་ཏེ་མིའི་རྐང་ལག་བཞི་པོ་འཕྲལ་ཟིན་ནའང་།",
    "རྒྱ་དམག་རྣམས་བང་སྒྲིག་སྔོན་མ་ཚོས་མེ་མདའ་དགུ་བོག་རྐང་ལག་གང་རུང་ལ་རེ་རེ་བརྒྱབ།",
    "མི་བཅུ་རེ་སྐེ་བཅད་མཚམས་མི་རེ་རེ་ཆ་འཕྲིན་སྐྱེལ་མཁན་ཡིན་ཟེར་ནས་བཏང་བ་མ་གཏོགས་མི་བརྒྱད་བཅུ་གྱ་གསུམ་ཉིན་གཅིག་ལ་སྐེ་བཅད་ནས་བསད་ཀྱང་དཔའ་མ་ཞུམ་པར་དེ་བས་རྒྱ་དམག་ལ་འཁོན་འཛིན་སྐྱེས་སྟེ་བྲག་དམག་གསུམ་བརྒྱ་དཔུང་སྣོན་དུ་འབྱོར་བ་དང་བཅས་དགྲ་ཤ་ལེན་རྒྱུའི་ཆེད་དུ་སྲུང་མ་བསེ་ཡི་ཁྲབ་ཅན་གྱི་སྐུ་ཐང་བྲིས་པའི་དམག་དར་གྱི་མདུན་དུ་མི་གཅིག་མ་ལུས་ཀྱང་རྒྱ་དམག་དང་དམར་འཛིང་བྱེད་པ་ལས་ཕྱི་གཤོལ་མི་བྱེད་ཅེས་དམ་བཅའ་བཞག་སྟེ་སླར་ཡང་ཕར་རྒོལ་བྱས།",
    "རགས་ཐོ་ཞེས་པའི་རི་ཞིག་ཡོད་པ་དེ་དམག་ཇུས་ཀྱི་ས་བབ་གལ་ཆེན་ཞིག་ཡིན་པ་རྒྱ་དམག་གིས་བརྟན་སྲུང་བྱས་ཡོད་པ་དེ་ཚུར་ལེན་ཕྱིར་ཁས་ལེན་བྲག་དམག་བཅུ་གསུམ་སྟག་རྒོད་ལྟར་མཆོངས་ཏེ་རགས་ཐོའི་སྟེང་གི་འཛིང་རགས་སྲུང་མཁན་རྒྱ་དམག་བཅོ་ལྔ་ཙམ་བསད་པ་དང་དེ་འཕྲོས་རྣམས་བྲོས།",
    "དཔའ་བོའི་ནང་མི་རྣམས་ལ་གཟིགས་གཟོས་བྱས།",
    "སྐབས་དེར་རང་རེའི་རྒྱལ་ས་ལྷ་ས་ནས་འགོ་བཙུགས་ཏེ་རིམ་བཞིན་རྒྱ་དམག་རྣམས་ཕྱིར་འབུད་གཏོང་གི་ཡོད་པའི་སྐབས་སུ།",
    "རྒྱ་དཔོན་གྱི་སྐྱེ་དམན་དང་ལུས་འབྲེལ་ང་བའི་གོ་སྐབས་དང་བསྟུན་ཏེ་རྒྱ་མིའི་དམག་བྱུས་གང་འཚམས་ཙམ་གས་ཐུབ་པར་བརྟེན་དམག་བརྒྱབ་ནས་རྒྱལ་ཁ་ཆེན་པོ་ཐོབ་པ་རེད།",
    "ཚའོ་དྭ་རིན་བཅས་ཀྱི་དམག་དཔུང་ལ་ཁྱོན་ཡོངས་ནས་ཕར་རྒོལ་བསྟུད་མར་བྱས།",
    "རུ་དཔོན་གཅིག་དང་དམག་མི་ཉིས་བརྒྱ་ཙམ་བྱམས་མདུན་གྲོང་པའི་སྣེ་ཙོང་ཁ་ཀླ་སྲས་ཟེར་བའི་གྲོང་ཚོ་དེ་བཟུང་ནས་རྒྱ་དམག་ལ་ཕར་རྒོལ་ཐེངས་ཁ་ཤས་བྱས་ཀྱང་ནུས་པ་མ་ཐོན།",
    "རྒྱ་དམག་གིས་བཀྲ་ཤིས་ཁང་གསར་གྱི་ལྕགས་རི་དང་།",
    "རྒྱབ་རི་འོ་འཛོམས་བཟུང་བ་དེས་རྒྱ་དམག་ལ་འགེབས་སྲུང་གི་ནུས་པ་ཆེན་པོ་ལྡན་ཡོད་པ་རེད།",
    "ཁྱོད་བསད་ཀྱང་ཧ་ལས་རྒྱུ་གང་ཡང་ཡོད་པ་མ་རེད།",
    "ཁོ་རང་གིས་རྒྱ་དམག་སྡོད་སའི་ཉེ་སར་གཅིག་པུར་ཕྱིན་ནས་རྒྱ་དམག་གིས་མ་ཚོར་བར་མྱུལ་ཞིབ་བྱས་རྗེས་ཕྱིར་ལོག་ནས་དམག་མི་ཚོར་ཕྱིར་བྲོས་མི་ཆོག་པའི་བཀའ་ཕབས་ཏེ་ཁོ་རང་གདོང་ལ་ཕྱིན་ནས་ལག་གཡས་པས་རྡོ་ཆེན་པོ་ཞིག་བཟུང་བ་དེ།",
    "མེ་སྟག་རྒྱ་དམག་གི་ཐོག་ཏུ་འཐོར་ཞིང་མེ་ཤི་ནས་དུ་བ་གནམ་ལ་འཕྱུར་བ་དང་།",
    "ཕྱི་ཉིན་ཕྱོགས་གཅིག་ནས་རྒྱ་དམག་གི་མཐའ་བསྐོར།",
    "དེ་གང་འདྲ་རེད་ཟེར་ན།",
    "བོད་དམག་གི་ཅ་ལག་འགེལ་བྱེད་རྟ་ཁལ་དང་།",
    "ཨ་ཟུར་དུ་ཡོད་པའི་བྱ་དྭ་རིན་གྱི་དམག་དང་བྲག་གཡབ་ཀྱི་ཡུལ་དམག་གཉིས་ཉིན་མཚན་ལྔ་དྲུག་ཙམ་དམག་འཐབ་བྱེད་བཞིན་པའི་སྐབས་དེར་བོད་གཞུང་གི་དམག་རུ་ཤོག་གཅིག་རྒྱབ་དཔུང་དུ་འབྱོར་ཞིང་དབྱིན་མདའ་ཁ་རིང་དང་།",
    "གྱི་དམག་དཔུང་ཕམ་ཉེས་སོང་བ་ཐག་ཆོད་ཟེར་ཏེ་སེམས་ཁྲལ་ཆེན་པོ་བྱས་པ་དང་།",
    "ལྷག་པར་དུ་༡༩༥༩ ནས་༡༩༦༡ ཀྱི་བར་བྲག་གཡབ་ཀྱི་བཙན་རྒོལ་རྒྱལ་སྲུང་དམག་སྟོང་ཕྲག་ལྔ་ཙམ་གྱིས་ཞུམ་པ་མེད་པའི་དམག་འཐབ་ནང་དཔའ་བོ་མང་པོའི་རང་སྲོག་བློས་བཏང་བྱས་པའི་དངོས་ཡོད་གནས་ཚུལ་མང་དག་ཅིག་ཡོད་པ་དེ་དེབ་འདིའི་ནང་གི་ལེའུ་བཞི་པར་གསལ་བས་འདིར་མ་བཀོད།",
    "ངའི་ཁྱིམ་ཚང་གི་མིང་ལ་རྡོ་གཅོད་ཚང་ཟེར།",
    "མདའ་ཡི་ཉེ་བ་གྲོང་ཚོ་བཅས་གྲོང་ཚོ་བཅུ་དྲུག་དཀྱུས་སུ་ཆགས་ཡོད།",
    "དེའི་ཤར་ངོས་རི་འདབས་སུ་ཆགས་ཤིང་རི་ཀླུང་ཚང་མ་སྤང་ཡིན་ལ་ལོ་ཐོག་ལོ་རེ་ཐེངས་རེ་ལས་སྐྱེས་ཀྱི་མེད།",
    "ཁྲག་གི་མིག་ཆུ།",
    "རྡོ་གཅོད་ལྟག་མ་ཚང་གི་བུ་དགེ་རྒྱལ་ནི་འབྲི་ཀློག་དག་གསུམ་དང་།",
    "བོད་ལ་རྒྱ་དམག་བཏང་སྟེ་བཙན་འཛུལ་བྱེད་སྐབས་དགེ་རྒྱལ་གྱིས་ལྷ་སྲུང་མངའ་རྒྱུད་གཉིས་ཀྱི་ཡུལ་དམག་ཁྲག་གི་མིག་ཆུ།",
    "གི་འགོ་གཙོ་བྱས་ནས་འཕྲུལ་མདའ་དགུ་བོག་དང་མེ་སྒྱོགས་ཡོད་པའི་རྒྱ་དམག་ལ་བོད་མདའ་དང་གྲི།",
    "དགེ་རྒྱལ་གཙོས་པའི་མི་མང་དག་ཅིག་རྨས་སྐྱོན་བྱུང་སྟབས་ཕྱིར་འཐེན་བྱེད་དགོས་བྱུང་བ་རེད།",
    "༡༩༡༢ ལོའི་ཡོངས་གྲགས་སུ་ཆུ་བྱི་དམག་འཁྲུག་ཅེས་རྒྱ་དམག་བོད་ནས་མཐར་སྤྲོད་གཏོང་སྐབས་རྟ་མགྲིན་ཚེ་རིང་གིས་ལྷ་སྲུང་ཡུལ་འབྲོག་གཉིས་ཀྱི་ཡུལ་དམག་གི་འགོ་ཁྲིད་ནས་བྱམས་མདུན་ཕྱོགས་དང་།",
    "ཨ་ཟུར་བཅས་ལ་རྒྱ་དམག་དང་འཐབ་འཁྲུག་བྱས་པའི་གནས་ཚུལ་ཡུལ་དེར་གྲགས་པ་ཆེ་ཙམ་ཁྱབ་ཡོད་པ་རེད།",
    "ངས་རྒྱ་དམག་གང་གསོད་གསོད་བྱས་ཡོད་པ་དེ་ནི་བསྟན་དོན་གྱི་ཆེད་དུ་ཡིན་པ་ལས་དེ་མིན་བསམ་བཞིན་དུ་འབུ་གྲོག་མ་ཙམ་ཡང་བསད་མ་མྱོང་ཟེར་གྱི་ཡོད་པ་རེད།",
    "ཁོང་གིས་ཡུལ་གྲོང་གི་ཕྲུ་གུ་རྣམས་ལ་ཡི་གེ་འདོན་རྒྱུ་བསླབས་ནས་ཨ་མཆོད་བྱེད་ཐུབ་པ་ཡོང་གི་ཡོད་པ་མ་ཟད།",
    "རྒྱལ་མཆོག་བཅུ་བཞི་པའི་སྐབས་ཀྱང་ཁོང་མ་གྲོངས་ཀྱི་བར་དུ་གཟིམ་འགག་ཞུ་རྒྱུ་བྱུང་ཡོད་པ་རེད།",
    "རྒྱུ་ཐོག་ཆད་པ་བཅད་པ་མ་ཚད་རི་དྭགས་བསད་པའི་ཁྲག་གི་མིག་ཆུ།",
    "ཕོ་ལེ་རོང་རྡོ་གཅོད་བཅས་ཁྱོན་བསྡོམས་དུད་ཚང་༡༨ ཡོད་པ་རེད།",
    "གཙོ་བོ་གནའ་རབས་ཀྱི་ཁྲག་གི་མིག་ཆུ།",
    "རྡོ་གཅོད་ཚང་གི་ཁང་པ་ནས་འབོད་རྒྱང་གང་ཙམ་སར་ལོ་བརྒྱ་ཕྲག་ཁ་ཤས་སོང་བའི་ལྕང་སྡོང་ཆེན་པོ་ཞིག་ཡོད་པ་དེ་རྡོ་གཅོད་ཀྱི་བླ་ཤིང་ཡིན་པར་བཤད།",
    "ཀེ་མི་གལ་ཆེན་ཤི་བའི་སྔོན་རྟགས་ཡིན་པར་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད་པ་ལྟར་ཡོང་གི་ཡོད་པ་རེད།",
    "ཕ་རྟ་མགྲིན་ཚེ་རིང་ཆུ་བྱི་རྒྱ་དམག་སྐབས་ཡུལ་དམག་གི་འགོ་ཁྲིད་བྱས་ཏེ་རྒྱ་དམག་དང་འཛིང་སྐབས་བྱས་རྗེས་ཆེན་པོ་བཞག་པར་བརྟེན་གོང་ས་བཅུ་གསུམ་པ་ཆེན་པོས་ཁྲལ་རིགས་འཇལ་མི་དགོས་པ་སོགས་འཁོད་པའི་བཀའ་ཤོག་བཀའ་ཐམ་ཅན་གནང་འདུག་པ་དེ་༡༩༥༩ ལོར་རྒྱ་དམག་ལ་ཤོར།",
    "ཁྱིམ་ཚང་གི་ས་ཞིང་ཡུལ་དེའི་ནང་ནས་ཆེ་ཤོས་ཤིག་ཡིན་པ་དེ་ལས་མཁན་དཔྱིད་ཀ་ནས་དགུན་ཁའི་བར་གཡོག་པོ་གཡོག་མོ་འམ་གླ་པ་ལྟ་བུ་ལྔ་དྲུག་ཙམ་བཞག་པ་དང་དགུན་གཡོག་རེ་གཉིས་ཙམ་བཅས་དེ་དག་ལ་གླ་ཆ་སྤྲོད་ཀྱི་ཡོད་པ་རེད།",
    "ཨ་མ།",
    "ཨ་མས་ང་ལ་སྤྲང་པོ་གཅིག་ལས་མི་འདུག་གམ་ཟེར།",
    "ཨ་མས་ཁྱེད་ཀྱི་བསམ་བློ་དེ་ཐབས་སྡུག་རེད།",
    "དཔེར་ན་ང་རང་གཉིས་སྤྲང་པོ་ཡིན་ན་དུད་ཚང་ཞིག་གི་སྒོ་ལ་ལྟོ་སློང་དུས་ང་ལ་སྤྲད།",
    "ཁྱེད་ལ་མ་སྤྲད་ན་ཁྱེད་བློ་ཕམ་གྱི་རེད་དམ།",
    "མ་བུ་ཡིན་ནའང་གྲོད་ཁོག་གཅིག་པ་རེད་དམ།",
    "ང་འགྲོ་དུས་ཁྱིམ་མཚེས་ཀྱི་སྒོར་བསྡད་འདུག་རྩམ་པ་སྤྲད་པས་ཁོ་གཉིས་དགའ་པོ་བྱུང་སོང་།",
    "ལོ་དེའི་ནང་གྲོང་པ་ཁྱིམ་མཚེས་ཀྱི་བུ་དང་བུ་མོ་བཅུ་ལྷག་ཙམ་ལ་ཕ་ཡིས་ཀློག་བསླབས་པ་དང་།",
    "དང་གཅེན་མོ་འཆི་མེད་ལྷ་མོ་བཅས་ལ་འབྲི་ཀློག་གཉིས་ཀ་བསླབ་ཀྱི་ཡོད་པ་དང་མཉམ་དུ་ང་རང་ལ་ཡང་ཀློག་བསླབ་རྒྱུའི་འགོ་ཚུགས་སོང་།",
    "བརྩོན་འགྲུས་ཞན་པོ་རེད།",
    "ཡོན་ཏན་མ་ལུས་བརྩོན་འགྲུས་རྗེས་འབྲངས་ཡིན་སོགས་འགྲེལ་བརྗོད་ཁྲག་གི་མིག་ཆུ།",
