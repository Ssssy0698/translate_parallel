    "དེ་ནས་རྡོ་རྗེའི་འདུག་སྟངས་ཕྱེད་ཀྱིས་འདུག་ལ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་དབུས་སུ་འདུག་ལ་ཡིད་ཀྱིས་དཀྱིལ་འཁོར་ཐམས་ཅད་ཡོངས་སུ་བརྟག་པར་བྱས་ནས་ནམ་མཁའི་ཕྱོགས་ནས་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་དགུག་པ་དང་།",
    "དེ་ནས་དབུས་སུ་འདུག་ནས་ནི།",
    "རྐང་པ་གཡས་པ་བརྐྱང་བའི་ཚུལ་གྱིས་འདུག་ནས།",
    "རྐང་པ་གཡོན་བརྐྱང་པའི་ཚུལ་གྱིས་འདུག་ལ།",
    "བདེན་བྲལ་གྱི་ཕྱོགས་སུ་རྐང་པ་མཉམ་པས་འདུག་ལ།",
    "ཆུ་ལྷའི་ཕྱོགས་སུ་རྐང་པ་མཉམ་པས་འདུག་ལ།",
    "གཡོན་པ་བརྐྱང་བའི་གནས་པས་འདུག་ལ།",
    "རྐང་པ་མཉམ་པར་གནས་པས་འདུག་ལ།",
    "རང་རང་ཕྱོགས་སུ་ལེགས་པར་བཞུགས་ནས་སུ།",
    "མདུན་དུ་འདུག་ནས་ཚིག་འདི་སྐད་དུ་གསལ་བར་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ནས་ཧཱུཾ་བཞིས་ཕུར་བུ་བཏོན་ལ་ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏི་ཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ་ཞེས་བྱ་བ་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་པའི་འོ་མས་ཕུར་བུ་དང་།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་སའི་དབུས་སུ་འདུག་ལ།",
    "ཡང་ཤར་ལྷོ་མཚམས་ཀྱི་ཆལ་འདུག་ནས།",
    "ཡང་ལྷོ་ནུབ་མཚམས་སུ་འདུག་ལ་བྱང་ཤར་མཚམས་སུ་སྲད་བུ་བརྐྱང་སྟེ་ཐིག་གདབ་པར་ཤེས་པར་བྱའོ།",
    "ལྷོ་ཕྱོགས་ཀྱི་ཆར་འདུག་ལ་བྱང་དུ་བལྟས་ཏེ་ཐིག་གདབ་པར་བྱའོ།",
    "བྱང་ཕྱོགས་ཀྱི་ཆའི་ཀ་བའི་ཐིག་ནི་ནུབ་ཕྱོགས་སུ་འདུག་ལ་ཤར་གྱི་ཕྱོགས་སུ་བལྟས་ཏེ་གདབ་པར་བྱ་སྟེ།",
    "ལྷོ་ཕྱོགས་ཀྱི་ཆའི་ཀ་བའི་ཐིག་ནི་ཤར་ཕྱོགས་ཀྱི་ཆར་འདུག་ལ་ནུབ་ཏུ་བལྟས་ཏེ་གདབ་བོ།",
    "དེ་ནས་ཡང་མདུན་དུ་འདུག་ལ་དེ་ཁོ་ན་ཉིད་འདི་ལན་ཅིག་བརྗོད་པར་བྱ་སྟེ།",
    "ཕྱི་རོལ་གྱི་དཀྱིལ་འཁོར་གྱི་ནང་དུ་སྣ་ཚོགས་པདྨའི་སྟེང་དུ་ཕྱག་རྒྱ་ཆེན་པོས་འདུག་ལ།",
    "གདན་དེ་ལ་དཔལ་རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱ་ཆེན་པོར་འདུག་ནས།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "ཨོཾ་བྷ་ག་ཝ་ཏི་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནེ་སྭཱ་ཧཱ་ཞེས་པའོ།",
    "ཨོཾ་བྷ་ག་ཝ་ཏི་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིངྦྷ་ལོ་ཙ་ནི་སརྦ་ཨ་རྠ་སཱ་དྷ་ནེ་སྭཱ་ཧཱ།",
    "དང་པོ་ཁོ་ནར་ཡིད་དུ་འོང་བའི་གནས་སྒྲའི་ཚེར་མ་ལ་སོགས་པ་དང་བྲལ་བར་སྟན་ཤིན་ཏུ་འཇམ་པོ་ལ་འདུག་སྟེ།",
    "བཀྲ་ཤིས་ཀྱི་འདུག་སྟངས་དང་།",
    "སེང་གེའི་གདན་གྱི་སྟེང་དུ་འདུག་པར་བྱའོ།",
    "དེ་ནས་འདུག་ལ་གསོལ་བ་གདབ་པར་བྱ་སྟེ།",
    "དེར་ཞུགས་ནས་འདུག་སྟེ་གནས་ཇི་ལྟ་བ་བཞིན་དུ་མདུན་དུ་གཞལ་ཡས་ཁང་ཆེན་པོ་བསམས་ཏེ།",
    "འགྲེང་ངམ་ཡང་ན་འདུག་ཀྱང་རུང་།",
    "མི་སྨྲ་བས་འཇམ་ཞིང་ཤིན་ཏུ་བདེ་བའི་སྟན་ལ་པདྨའི་འདུག་སྟངས་ཀྱིས་འདུག་པ།",
    "གོས་སྣ་ཚོགས་དང་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་འདུག་སྟེ།",
    "འདུག་པའམ།",
    "བསམ་གཏན་བཞིའི་རིམ་བཞིན་དམིགས་ནས་འོག་མིན་གྱི་གནས་སུ་འདུག་སྟེ།",
    "བསྐྱེད་པའི་རིམ་པས་འདུག་ནས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་གནས་སུ་རྡོ་རྗེ་སེམས་དཔའ་བསྒོམས་ལ།",
    "རྡོ་རྗེ་སེམས་དཔའི་ལག་ན་འདུག།",
    "དེ་ནས་དེ་ལ་རྡོ་རྗེ་ཕྱེད་མའི་འདུག་སྟངས་ཀྱིས་འདུག་སྟེ།",
    "དེ་བཞིན་གཤེགས་པའི་དམ་ཚིག་སེམས་དཔར་བསྐྱེད་ཀྱང་རུང་སྟེ་འདིར་རྣམ་པར་སྣང་མཛད་ཀྱི་གནས་སུ་འདུག་ལ་རྣམ་པར་སྣང་མཛད་དུ་གྱུར་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "དབུས་སུ་བདག་ཉིད་འདུག་ནས་ཁམས་གོང་མ་གཉིས་ཀྱི་ཏིང་ངེ་འཛིན་བསྐྱེད་དེ།",
    "དེ་ནས་སློབ་དཔོན་ཁྲུས་བྱས་ནས་མཉམ་པར་འདུག་སྟེ།",
    "ཨོཾ་ག་ག་ནེ་ག་ན་ལོ་ཙ་ནེ་ཧཱུཾ།",
    "ཨོཾ་གེ་ག་ནེ་གེ་ག་ན་ལོ་ཙ་ནེ་ཧཱུཾ།",
    "དེ་ནས་ཐུགས་ཀར་བྱོན་ནས་མི་བསྐྱོད་པའི་མདུན་དུ་འདུག་ནས་བཀའི་ལམ་ཞུ་བར་བསམ་པར་བྱའོ།",
    "གདོད་ནས་དག་ཅིང་རང་བྱུང་ང་།",
    "དེའི་རྗེས་ལ་ཡོལ་བའི་ནང་དུ་འདུག་ནས་འཁོར་ལོས་སྒྱུར་བའི་ཚུལ་དུ་བཟུང་ལ།",
    "འགྲོ་བ་འདི་ཡང་རང་བཞིན་མེད།",
    "དེ་ནས་ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷ་ལོ་ཙ་ནི་སརྦཱ་རྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ།",
    "གང་ཇི་ལྟར་འདུས་པ་ལ་སོ་སོར་དྲི་བཟངས་ཀྱི་ཐིག་ལེ་ཕུལ་ནས་དང་པོར་སྟོང་པའི་ངང་ལས་ཙོག་པུར་འདུག་ནས།",
    "རང་བཞིན་གྱིས་གྲུབ་པ་སོགས་ཀྱང་རང་རྒྱུད་པས་ཁས་ལེན་ཟེར་ན།",
    "ཐ་སྙད་དུ་ཕྱི་དོན་ཡོད་པར་ཁས་ལེན་ཅིང་རང་རིག་མེད་པར་ཁས་ལེན་པའི་ཕྱིར།",
    "མྱུ་གུ་ཞིག་པ་རང་དུས་ན་ཁོ་རང་ཞིག་པ་མིན་ཡང་།",
    "༨ན་མྱུ་གུ་ཞིག་དུས་སུ་མྱུ་གུ་ཞིག་པ་འགག་པ་ཡིན་པ་གང་ཞིག།",
    "དེས་ཁོ་རང་རྟོགས་པའི་ཕྱིར།",
    "ཐེག་ཆེན་མཐོང་ལམ་བར་ཆད་མེད་ལམ་དེས་ཁོ་རང་རྟོགས་པའི་ཕྱིར།",
    "སྔར་རྨུགས་པའི་དུས་སུ་དུག་ཞུགས་འདུག་སྙམ་དུ་དྲན་པ་སྐྱེ་བ་བཞིན་ནོ།",
    "ད་ལྟ་མགོན་ཁང་བཅས་ནས་ཡོད་ཅེས་གླེང་བ་འདུག་གོ། ཉ་",
    "ཕྱིས་རྟིང་མཇལ་བ་ན་རྨི་ལམ་དུ་བྱུང་བའི་དབྱིབས་དེ་ཀ་རང་དུ་འདུག་གསུང་ངོ། ཧ་",
    "ཁྱད་པར་དུ་གཙང་རང་ནས་བདུན་འབྱུང་ཞིང་།",
    "དེ་ལྟར་གསན་པར་འདུག་གོ།",
    "དེ་དུས་ཀྱང་དུས་འཁོར་གསུང་བར་འདུག་པའི་སྐབས།",
    "འོལ་ཁར་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་དང་།",
    "འདི་དག་ཀྱང་རང་ཅག་རྣམས་ཀྱི་སྣང་ངོ་ཙམ་ཡིན་གྱི་ཕྱོགས་བཅུའི་ཞིང་ཁམས་ཀུན་ཏུ་མཛད་༢༦ན་ཚུལ་ནི་བསམ་གྱིས་མི་ཁྱབ་པར་གོར་མ་ཆག་གོ།",
    "ཚུལ་འདི་བསམས་ན་མདུན་མ་ལེགས་ནས་གདའ།",
    "དོན་ཡོད་རྡོ་རྗེ་ལས་ཀྱི་རིགས་ཡིན་པས་རྗེས་སོར་རྗེའི་མནལ་ལམ་དུ་ཉ་དབོན་གྱིས་ཀརྨ་བཛྲ་ཞེས་འབོད་པ་བྱུང་བས་སྔགས་ཀྱི་གསང་མཚན་དང་རིགས་གཅིག་པར་འདུག་གསུང་བ་དང་མཐུན།",
    "ཚུལ་འདི་བསམས་ནས་མདུན་མ་ལེགས་ནས་གདའ།",
    "མ་ཏི་བྷ་དྲ་ཀིརྟི་ཞེས་པའང་འདུག་སྟེ།",
    "མེད་ན་མེད་གོ་ཆོད་པར་འཛིན་འདུག་པས།",
    "ཞེས་འབྲེལ་མེད་པའི་ལུང་ལོག་པར་སྨྲ་འདུག་ཀྱང་།",
    "བརྒྱ་ཕྲག་ཤིན་ཏུ་མང་བར་མཁས་པ་རྣམས་ཀྱིས་གྲངས་བཅད་མཛད་འདུག་ཅིང་།",
    "བཀའ་གཏེར་ཐམས་ཅད་ཀྱི་དགོངས་པ་གཅིག་ཏུ་འདུག་པས་དེ་ལྟར་མཛད་ན་མི་ལེགས་སམ།",
    "དེ་སྐད་བྱས་ན་ཤེས་པས་འདྲ་འདུག་སྟེ།",
    "བརྒྱ་བྱིན་གྱིས་གཤོལ་མེད་མའི་ཁྱིམ་དུ་ཞུགས་པ་གོ་ཏ་མའི་མངོན་ཤེས་ཀྱིས་རིག་སྟེ་ཕྱིར་ལོག་པས་ཆུང་མས་བརྒྱ་བྱིན་ལྟ་བར་སྦས་ཏེ་འདུག་པ་ལ་གོ་ཏ་མས་སྟན་བཤམས་ཏེ་གཉིས་ལ་ནི་རང་ཉིད་དང་ཆུང་མ་འདུག་ལ།",
    "མཁས་པ་ཆེན་པོ་ཞིག་ཡིན་པར་འདུག་བསམ་ཙམ་ལས་མེད།",
    "ཁོང་གསོ་སྦྱོང་ལ་ཕེབས་པའི་སྐབས་སུ་རི་ཐམས་ཅད་མགུལ་གྱི་ཡོད་པ་སྙམ་བྱེད་པ་ངེས་པར་འོང་བར་འདུག།",
    "དེ་ལ་ངེས་པར་ཡེ་ཤེས་པ་འབེབས་ཀྱི་ཡོད་པར་འདུག།",
    "དགའ་བ་གདོང་དུ་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "ངས་སྐྱེ་བ་སྔ་མ་ནགས་ཉུལ་བ་གཅིག་དྲན་འདུག་ཅེས་གསུངས་ལ།",
    "རི་ཟན་རྡོག་པ་རྣམས་ལ་ཐུག་གྲུབ་ཆེན་པ་ཁོང་རང་སློབ་དཔོན་ཨརྱ་དཱེ་བ་དང་།",
    "སྟོན་པར་འདུག་པས་འདིར་གསལ་བར་མ་སྨོས་སོ།",
    "བྱམས་པས་ལུང་བསྟན་པ་དང་སྟོན་པར་འདུག་པའི་དོན་ནི།",
    "རྒྱ་གར་དུ་སྐྱེས་ན་ཤནྟི་པ་དང་མཉམ་པ་གཅིག་འོང་བ་འདུག་གསུང་ངོ།",
    "བེ་རོ་ཙ་ནའི་སྐྱེ་བ་གཅིག།",
    "སློབ་དཔོན་པདྨས་མཛད་པ་ནི་དེའི་མཛད་པའི་ཕྱོགས་གཅིག་ཡིན་འདུག་པས།",
    "གང་ཞིག་ཆེན་པོའི་མི་རྣམས་སྨིན་པའི་སླད་དུ་ཞེས་པ་ན་ཡོད་གསུངས་ཏེ་དེ་དག་ནི་དུས་ཀྱི་འཁོར་ལོའི་རིང་ལུགས་ཀྱི་བདག་པོར་འགྱུར་བའི་མཚན་རྟགས་ཏེ་རྨད་དུ་བྱུང་བའི་གཏམ་ལྔ་བཅུ་རྩ་གསུམ་པའོ། གཞན་ཡང་སྔར་རང་ཡུལ་དུ་བཞུགས་སྐབས་ཇོ་བོ་ཆེན་པོ་མནལ་ལམ་དུ་བྱུང་བ་ཕྱིས་དབུས་སུ་ཕེབས་པ་ན་སྐུ་འདྲ་དངོས་དང་རྣམ་པ་གཅིག་ཁོ་ནར་འདུག་གསུངས་པ་དང་།",
    "གཞན་དགེ་དང་མི་དགེའི་ཡུལ་ཅི་ཞིག་མངོན་དུ་གྱུར་ཀྱང་བདེན་སྟོང་སྒྱུ་འདྲའི་བློས་མ་ཟིན་པ་ནི་མི་འོང་འདུག་ཅེས་རང་ཉིད་ཀྱིས་གསུངས་པ་དང་།",
    "དེ་ནི་ཁྱེའུ་རྫུ་འཕྲུལ་ཅན་གྱི་སྤྲུལ་པ་ཡིན་ཟེར་བ་གདའ་ན།",
    "ཚུལ་འདི་བསམས་ཤིང་འདུན་མ་ལེགས་ནས་གདའ།",
    "ཕྱོགས་འདིར་ཡང་པར་པི་ཀ་ཡི་ལྗིད་ཀྱིས་ནོན་པ་ཤས་ཆེ་ཡང་བདུད་གྲོགས་སུ་འདུག་པ་ལྟར་དམ་པ་འདིའི་འཕྲིན་ལས་ཀྱི་གཉེན་དུ་འགྱུར་བས།",
    "དོན་ལ་ཡང་དེ་ཁོ་ནར་གདའ་བ།",
    "འདི་ལ་ཇི་ལྟར་འབྱུང་དང་ཕྱི་མར་ཅིར་འགྱུར་བའི་ལུང་བསྟན་གསུམ་འདུག་པས།",
    "སྐུ་ཚེ་གཏིང་མ་དགའ་ལྡན་དུ་གཤེགས་པ་ལ་མི་མཐུན་པ་མི་འདུག་པས།",
    "དེ་དུས་ལུང་ཁུངས་བཙུན་པ་ཙམ་ཡང་ལེན་པ་དཀའ་བ་ཞིག་ཡོད་འདུག་པ་ནས།",
    "ད་ལྟ་ལུང་དྲངས་པ་འདི་རྣམས་ལ་༨ན་བར་ལྟ་བུ་བཏོན་འདུག་པས་ཐེ་ཚོམ་ཟོས་ལ།",
    "རྗེའི་དྲུང་ནས་ཀྱང་བཞུགས་འདུག་པ་ལ།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "ཐམས་ཅད་མཁྱེན་པ་བློ་བཟང་གྲགས་པ་འདི་སྔགས་མཚན་ཉིད་ཐམས་ཅད་ཀྱི་བསྟན་པའི་སྲོག་ཤིང་དུ་འདུག་ཅིང་།",
    "ཁྱད་པར་ཀླུ་སྒྲུབ་ཀྱི་ལྟ་བ་རྣམ་པར་དག་པ་འདི་རྗེ་མིན་པ་སུས་ཀྱང་ཤེས་པ་གཅིག་མི་འདུག་པས།",
    "བསམས་བཞིན་དུ་མཐའ་འཁོབ་དུ་སྐྱེ་བ་བཞེས་༡༢ན་པ་འདུག་པས།",
    "སྔར་ཀྱང་མཛད་པས་འགྲོ་ཕན་ཆེ་བར་བྱུང་འདུག།",
    "ཤར་དུ་བལྟམས་པ་བྱས་ན་ནི་མི་འགྲིག་འདུག་པས་ཡི་གེ་མ་དག་གམ་སྙམ་ནས་མ་བཅོས་པའི་ངེས་པ་མེད།",
    "དགའ་ལྡན་པའི་རྨོངས་ཞེན་ཐེན་ནས་ལན་མང་པོ་ཞིག་བཀོད་འདུག་པར་བརྟེན།",
    "ཁྱེད་རང་གང་དགོས་ཡི་དམ་ལ་ཞུས་པས་ཡོང་བར་སྣང་ཞེས་སོ།",
    "ཞེས་པ་འདི་འདྲེན་པ་ཞིག་འདུག་ཀྱང་མང་པོའི་ལུང་བསྟན་དུ་དྲངས་པས་ཐམས་ཅད་མཐུན་པ་མི་འདུག་གོ།",
    "ཡུན་རིང་རང་དུ་མ་བྱུང་བར་མངོན་སྟེ།",
    "བསྟན་པའི་མཇུག་བསྡུད་པའི་མགོ་ཡང་བརྩམས་འདུག།",
    "ཁྱེད་རང་མཁའ་སྤྱོད་འོང་བའི་མདུན་པ་ཐོང་གསུང་ཞེས་སོ།",
    "འདི་རྗེ་བཙུན་མའི་ཕྱག་མཚན་དུ་འདུག་པས།",
    "དེ་རྣམས་ཀྱི་རིམས་སུ་འཛིན་པར་འདུག།",
    "རབ་ཏུ་གདའ་ཡི་འདི་གཉིས་ཀྱི་ཡོན་ཏན་བརྗོད་ན་ཕར་མཐར་རྙེད་པ་ནི་དཀའ་བར་འདུག་གོ།",
