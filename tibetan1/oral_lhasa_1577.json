    "ལུང་ནོད་ཁ་ཏོན་བྱེད་པར་སྦྱར་བར་བྱ།",
    "དུས་ཚོད་ཤེས་ལ་ཤེས་བཞིན་ལྡན་པར་བྱ།",
    "འཇིགས་པ་མེད་ནས་དོན་ལ་བརྩོན་པར་བྱ།",
    "རྨོངས་པ་མེད་པར་གྱུར་ནས་རྒྱལ་བའི་སྲས།་།",
    "འདི་དག་ཐམས་ཅད་རྟོག་པ་མེད་ཡིན་པར་ནོ།",
    "བརྟག་པར་བྱ་ཕྱིར་དེ་ནི་གཟེངས་༤ཡང་བསྟོད།་།",
    "དེ་ལྟར་དེ་ནི་དཔྱོད་དུ་གཞུག་པར་བྱ།",
    "ཕན་པར་བྱ་ཕྱིར་རྗེས་སུ་བསྟན་པ་ཡིན།",
    "རྣམ་པར་སྨིན་དང་འཁོར་དང་མྱ་ངན་འདས།",
    "རྣམ་པར་དབྱེ་བ་རྒྱལ་བའི་སྲས་ཀྱིས་ཤེས།",
    "ཐམས་ཅད་མཁྱེན་པ་འདས་དང་བྱུང་རྣམས་དང་།",
    "དེ་ནི་དུས་གསུམ་ཐ་དད་མེད་པར་འཇུག།",
    "སྦྱོར་བ་ཕུན་སུམ་ཚོགས་པར་བརྗོད་པ་ཡིན།",
    "ཕན་པར་འདོད་དང་བདེ་བ་ཐོབ་བྱེད་དང་།",
    "འདྲེན་པར་བྱེད་ཅིང་རབ་ཏུ་དང་བར་བྱེད།",
    "ཐོས་པར་གྱུར་ཀྱང་བསམ་ལས་ནུར་བ་མེད།",
    "འཇིག་པར་འགྱུར་ཞེའམ་འཆགས་༦པར་འགྱུར་ཞེ་འམ།",
    "ངེས་པར་སེམས་ཤིང་ཐམས་ཅད་རྣམ་དཔྱོད་དེ།",
    "སྤྱོད་པ་ཡོད་དམ་མེད་ཅེས་ངེས་པར་དཔྱོད།",
    "རྣམ་པར་ཕྱེ་བ་ཕན་ཚུན་སྦྱར་བ་རྣམས།",
