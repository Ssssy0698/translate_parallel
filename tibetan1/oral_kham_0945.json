    "ཁོ་བོ་རྒྱ་ཕྱོགས་སུ་འགྲོ་དགོས་པ་འདི་མཁྱེན་པའི་རྟགས་སུ་འདུག་ཅེས་གསུང་བའང་སྣང་ངོ།",
    "རྗེ་ཉིད་ཀྱི་ཞབས་མཐུ་ཆེན་གནས་པའི་གཞི་ཡིན་པས་ཤིན་ཏུ་གཉན་པ་བྱེད་འདུག་ནའང་ཀྱིས་བཅགས་པ་ནས་བཟུང་དཀར་ཕྱོགས་ལ་དགའ་བའི་ལྟ་ཀླུ་རྣམས་སྟོབས་རྒྱས་ཏེ་ཡུལ་ཕྱོགས་།",
    "འོ་བན་རྒན་ང་དབེན་པའི་གནས་ནས་དབུས་གཙང་དུ་འགྲོ་དགོས་པ་འདི་བཞིན་མར་གྱི་དཀྱིལ་ནས་སྤུ་བཏོན་པ་བཞིན་སེམས་བག་འཚེར་བའི་རང་བཞིན་དུ་འདུག་ཀྱང་།",
    "སྐུ་ན་སྨིན་ཆེ་བར་མ་ཟད་དེ་སྔ་ཆིབས་གྲལ་གཡོར་ཆེ་དེ་རིགས་ཀྱི་ཁྲོད་དུ་ཕེབས་མྱོང་མེད་པས་སྔོན་ཚུད་དུ་ཕེབས་བཞེད་འདུག་དོན་ལྟར་ཐུགས་མཁོ་ཉེར་སྤྱད་དང་།",
    "རྣམ་འཇོམས་དང་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་དང་བཅས་སྙན་བརྒྱུད་ཀྱི་ལུགས་སུ་འབུལ་བར་མཛད།་",
    "འདི་ལྟ་བུའི་ལྟས་ཅི་ཡིན་ཞེས་དགྱེས་ཚུལ་མཛད་འདུག་པ་རྣམས་དམ་ཚིག་པ་ལ་ཡེ་ཤེས་པ་དངོས་སུ་ཞུགས་པའི་རྟགས་ཡང་དག་པའོ།",
    "དེའི་ཕྱི་ཉིན་ཡང་མགོན་པོ་ཉིད་ལ་འཕྲིན་བཅོལ་མཛད་པས་མགོན་པོའི་ཞལ་མདངས་ཉིན་སྔ་མ་ལས་སྣུམ་ཞིང་དགྱེས་ཞལ་གཟི་བརྗིད་དང་ལྡན་པར་བཞུགས་འདུག་པར།",
    "རྗེ་ཉིད་ནས་མགོན་པོ་དགྱེས་འདུག་པས་ད་ནི་ལེགས་པ་ཡིན་གསུངས་ཏེ་མཉེས་མཉེས་མཛད།",
    "གཞན་ཡང་རྗེ་འདི་ཉིད་ཀྱིས་མཛད་པའི་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་བློ་གྲོས་མཆོག་སྩོལ་ཞེས་བྱ་བ་དང་།",
    "རབ་གནས་རྒྱུ་འདུལ་འཛིན་ཆེན་པོས་མཛད་ཚུལ་ཞིག་འདུག་པ་རྣམས་སྒོ་མཐུན་པས་རྗེ་འདི་རྒྱུ་འདུལ་ཆེན་པོའི་སྐུའི་སྐྱེ་ཟླ་ཡིན་ནམ་སྙམ་ཤིང་།",
    "ཁྱད་པར་ཇོ་གདོན་མཚན་སྒྲོག་ཏུ་གནས་གཞི་ཕབ་ནས་གདུལ་བྱ་མཐའ་ཡས་པ་སྨིན་གྲོལ་ལ་འགོད་པར་མཛད་འདུག་ཅིང་།",
    "ད་ལྟ་དཀྲིག་བཅར་མ་བྱུང་ལགས་ཞུས་འདུག་པར།་",
    "ལྷ་ལྡན་དཔལ་ལྷའི་འདྲ་འབག་ནས་སྤྱན་ཆབ་ཀྱི་རྒྱུན་བབས་པ་སོགས་རྟགས་མཚན་ངན་པ་སྣ་ཚོགས་ཤིག་བྱུང་འདུག་པས་བློ་གཡེང་དུ་གྱུར་ཏེ་རྗེ་འདིའི་ཞབས་བརྟན་དུ་སྒྲོལ་མ་དང་།",
    "དཔེར་ན་རི་ཆེན་པོ་ཉིལ་བའི་ཚེ་ཕ་བོང་ཆེན་པོ་རིས་རྟེན་བྱས་ན་དེ་ལ་བརྟེན་ནས་རྡོ་མང་བོ་ཞིག་ཆགས་ཐུབ་ཀྱིན་འདུག་པ།",
    "ད་ལམ་གྱི་ལྷུན་ཚུལ་འདིའི་ཐོག་ཏུ་དགོངས་པ་གཞན་དོན་དུ་གཏང་ཚེ་ཁོ་བོ་བློ་ཤིན་ཏུ་ཕམ་པ་ཞིག་ཡོང་བ་འདུག་པས་སྙན་ཚུལ་འདི་འཕྲལ་དུ་དྭངས་པ་ཞིག་དགོས་ཞེས་ངག་མ་ཞུ་རྒྱུ་དང་།",
    "དེང་ལོ་ཆེན་རིན་ཆེན་བཟང་པོ་དགུང་ལོ་དགུ་བཅུ་གོ་དྲུག་བཞུགས་འདུག་ཅིང་།་",
    "རྟ་ནག་པའི་དྲུང་རམས་པ་ཡེ་ཤེས་བསྟན་པ་བརྒྱད་ཅུ་གྱ་གྲངས་ཙམ་ཨེ་ཡིན་གཞན་མི་སྣང་ལགས་ཞུས་འདུག་པར།",
    "དེ་རྣམས་ཕྲ་རྒྱན་དུ་ཕུལ་ཆོག་པའི་རྟེན་བཞེང་ཞིག་བྱེད་དགོས་པ་འདུག་ཁྱད་པར་གསེར་ཟངས་ལས་གྲུབ་པའི་རྗེ་བཙུན་བྱམས་མགོན་མི་ཚད་ཆེ་ཕྱོགས་ཙམ་པ་ཕྲ་རྒྱུན་ཤིན་ཏུ་ཕྱུག་པ་ཞིག་དང་།",
    "ཚེམས་གྲུལ་བ་རྡོག་དྲུག་འདུག་པ་རྣམས་ལ་སྐྱ་ཆོག་དང་།",
    "ཟླ་བ་ལྔ་པའི་ཚེས་བཅུ་བདུན་ནས་ཆབ་ཅུང་ཟད་བྲི་ཞིང་སྐུ་གཟུགས་ལྕི་བ་ཞིག་བྱུང་བར་ཉེ་གནས་ནས་ཨེམ་ཆི་ལ་ཕྱག་རྩ་ཞིག་གནང་ན་ཞུས་འདུག་པར།",
    "ཞབས་སྐྲངས་པ་འབམ་གྱི་ངོ་ཞིག་ཡིན་འདུག་པས་ཐོག་མར་གླང་ཆེན་བཅོ་བརྒྱུད་པ་ཐུན་གསུམ་ཙམ་བཞེས།",
    "བདག་ཉིད་ཀྱི་གཏམ་ངན་ལའང་མི་བཏུབ་ཙམ་འདུག་པས་ངེས་པར་དགོན་གནས་གསར་བསྐྲུན་བགྱིས་ཆོག་པའི་ཞུ་བ་ནན་ཆེ་བར་མ་ཟད།",
    "རྗེ་འདི་ཉིད་དགུང་ལོ་སོ་བདུན་པའི་དུས་སུ་བར་ཆད་ཀྱི་མཚན་མ་ཞིག་བྱུང་འདུག་པ།",
    "ཁྲུས་རིལ་བཅས་ཀྱིས་གྲིབ་དང་མི་གཙང་བ་བསྲུང་བ་ལ་ཤིན་ཏུ་བསྔགས་པ་ཞིག་འདུག་པ་དང་།",
    "འོན་ཀྱང་རང་ཉིད་དད་པའི་བགོ་སྐལ་དུ།",
    "མི་མང་པོ་འདུག་པ་ལ་དེ་ཙམ་ཐོབ་ཅི་དཀའ་སྙམ་ན།",
    "ཁ་འཐོར་དུད་འགྲོ་ཙམ་ལ་ལྟོས་ཀྱང་མི་ལུས་ཐོབ་མི་སྲིད་པའི་ཚོད་དུ་གདའ།",
    "རང་རང་ལས་ཀྱི་རྦ་ཀློང་དྲག་པོས་འཁྲུགས།",
    "དེ་ག་ལགས་ཏེ་དལ་འབྱོར་རྙེད་དཀའ་འདི་བསམ་ཙ་ན་གཉིད་ལོག་ལོང་རང་གདའ་ཡེ་གསུངས།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "གཅེས་དགུ་བཞག་ནས་འགྲོ་ལ་ཐུག་ཙ་ན།",
    "དེ་ལ་སོགས་ཏེ་མི་རྟག་དགོངས་ཏེ་གདའ།",
    "རང་བས་རྒན་པ་ཡང་ཇི་ཙམ་ཤི་འདུག་མཉམ་དང་གཞོན་པ་ཡང་ཇི་ཙམ་ཤི་འདུག་བསམས་ན།",
    "དེ་དག་ཀྱང་ཚེ་ཚད་ཐུབ་ནས་ཤི་བ་ཙམ་ཆེར་མི་འདུག་ཕལ་ཆེར་དུས་མིན་པར་བར་མ་དོར་ཤི།",
    "འཆི་ཁར་ཡང་རང་ཉིད་འགྱོད་པ་དང་མྱ་ངན་མི་བཟད་པའི་མེས་གདུངས་ཤིང་གདོང་མཆི་མས་གང་།",
    "ཅི་ཕྱིར་འདི་ལྟར་བདེ་བར་འདུག།",
    "མདུན་དུ་ཐར་མེད་འཆི་བའི་གཡང་སར་ཐུག་གང་དུ་བལྟས་ཀྱང་འགྲོ་ས་མི་འདུག་ན།",
    "སྐད་ཅིག་གནས་པའི་གདེང་ཡང་མི་འདུག་ན།",
    "བྲག་རྒྱབ་པ་ལ་ཉེ་གནས་ཀྱིས་དབྱར་ཤིང་གྲབ་བྱེད་རན་གདའ་ཞུས་པས།",
    "དཀྱིལ་འཁོར་གཉེན་པོ་འདྲལ་བ་སྟེ་ལོག་པ་བརྒྱད་ལ་སོགས་ཏེ་བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་ཇི་སྙེད་པ་ཐམས་ཅད་དེ།",
    "སྤུ་ཉག་མ་གཅིག་ལག་མཐིལ་ན་འདུག་ན་མི་བདེ་བ་དང་སྡུག་བསྔལ་མེད་དེ།",
    "ལག་མཐིལ་སྤུ་ཉག་གཅིག་འདུག་པ།",
    "གང་ཡིན་ཀྱང་སྡུག་བསྔལ་གྱི་སྣྲོན་མར་འདུག་སྟེ།",
    "དེ་ལས་ཐར་ཀྱང་མཚོན་ཆའི་ཐང་ལ་རྐང་པ་བཞག་དུས་འབིགས་ཤིང་བཏེགས་ན་འཚོ་བ་དང་།",
