    "ཞུས་ཆེན་གྱི་ལོ་ཙ་བ་བེ་རོ་ཙ་ནས་བསྒྱུར་པའོ་།",
    "ལུས་སེམས་ལྟ་བུར་ནི་སྣང་ཡང་རང་བཞིན་མེད་པར།",
    "སེམས་ཚིག་ཏུ་བརྗོད་པ་ལྟ་བུ་ནི་མིང་ཙམ་ལས་དོན་དུ་གྲུབ་པ་ཅི་ཡང་མེད་པ་སྟེ་བསྐྱེད་ཅིག་ཅེས་ཀྱང་རང་བཞིན་གཞིའི་འོད་གསལ་དང་ཟུང་འཇུག་ཏུ་གནས་པའོ།",
    "ཨ་ནས་ག་བསྟན་ལ་འདུག་ག་ནལའགའབྲཨཨ།",
    "དེ་ཡང་རང་བཞིན་དང་བཅས་པ་འོད་གསལ་དུ་སྟེ།",
    "དེ་ཡང་བཟང་པོའི་འདུག་སྟངས་ཀྱིས།",
    "རིགས་པའི་གནས་ལྔ་ལ་མཁས་པའི་པཎྜི་ཏ་ཆེན་པོ་གཅིག་ལགས་པར་གདའ།",
    "སངས་མ་རྒྱས་ཀྱང་རང་བཞིན་སྐྱེ་མེད་ཡིན་པས་ན་འཇམ་ལ།",
    "འདུག་ནས་ནི་ཞེས་པ་ནི་ཅི་བྱེད་ན་དང་པོར་ཁྲུས་བྱས་གོས་གསར་པར་གོན།",
    "སྔགས་དང་སྐད་ཅིག་དུས་སྙམ་བྱེད།",
    "དེ་ཡང་རང་རིགས་ཐམས་ཅད་སྤྲུལ་བྱས་ནས་ཞེས་པས་སོ།",
    "དེ་ནས་རྡོ་རྗེ་སློབ་དཔོན་དལ་གྱི་དབུས་སུ་འདུག་སྟེ་ཆེ་བའི་ང་རྒྱལ་བརྗོད་པ་ནི་ང་ནི་བཅོམ་ལྡན་རྡོ་རྗེ་འཆང་།",
    "ག་འདྲ་ཞིག་ལ་སྣག་འབྱུག་དུས་ཆེན་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་བད་འགོག་དུས་ཆེན་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་ལྷ་གཡག་དུས་ཆེན་ཟེར།",
    "ཅི་ཞིག་ལ་རྟ་རྒྱུག་དུས་ཆེན་ཟེར།",
    "ཅི་ཞིག་ལ་བྱང་ཐང་རྟ་རྒྱུག་དུས་ཆེན་ཟེར།",
    "ག་འདྲ་ཞིག་ལ་སྣག་འབྱུག་དུས་ཆེན་ཟེར།",
    "སྣག་འབྱུག་དུས་ཆེན་ནི་དྭགས་པོ་བའི་སྲོལ་རྒྱུན་དུས་ཆེན་ཞིག་ཡིན།",
    "དེ་ནི་མིང་གྲགས་ཆེ་བའི་སྣག་འབྱུག་དུས་ཆེན་ཡིན་ལ།",
    "ཟླ་དང་པོའི་ཚེས་བཅུ་བདུན་ཉིན་ལ་ཁེལ་འདུག་ཉིན་དེར།",
    "རྣམས་དེ་ལས་རྒྱལ་མི་ཐུབ་པས་དེ་ལྟར་མི་འདུག་ཀ་མེད་བྱུང་།",
    "ག་འདྲ་ཞིག་ལ་བད་འགོག་དུས་ཆེན་ཟེར།",
    "བད་འགོག་དུས་ཆེན་ནི་དྭགས་པོ་བ་མང་ཆེ་བ་མཐོན་པོ་རི་རྐེད་དུ་གནས་ཡོད་ལ།",
    "མེ་ཕུང་ནི་རང་རང་སོ་སོའི་གནས་སུ་གཡུགས་པ་ལས།",
    "དྲི་བག་འདྲ་ཞིག་ལ་ལྷ་གཡག་དུས་ཆེན་ཟེར།",
    "གཙང་སྦྲ་དང་དོད་ཀྱི་ཐད་ནས་ཀྱང་རང་ཉིད་ཀྱི་ཁ་ཟས།",
    "མཚོ་དང་ཀླུ་ལ་དུས་ངེས་ཅན་དུ་མཆོད་ན་ཆར་ཆུ་དུས་སུ་འབབ་ཅིང་རྒྱུ་ནོར་ལོངས་སྤྱོད་ཀྱི་དངོས་གྲུབ་ཅི་འདོད་དུ་བསྩལ་ཡོང་བར་སེམས་འདུགདྲི་བ།",
    "ཅི་ཞིག་ལ་རྟ་རྒྱུག་དུས་ཆེན་ཟེར།",
    "རྟ་རྒྱུག་དུས་ཆེན་དེ་དག་ཏུ་རྒྱུགས་ཆེན་དང་འགྲོས་བསྡུར།",
    "གཞན་ཡང་མཁས་པ་འགས་རག་དུང་དང་གླིང་བུ་སོགས་ལ་དྭགས་སུ་གསར་བཟོ་མཛད་དེ་པཎྜི་ཏ་སྤྱན་འདྲེན་ཞེས་གསུངས་འདུག་པས་དཔྱད་པར་ཞུ།",
    "ཅི་ཞིག་ལ་བྱང་ཐང་རྟ་རྒྱུག་དུས་ཆེན་ཟེར།",
    "བསྟན་རྒྱས་གླིང་སོགས་སུ་བསང་གསོལ་བྱེད་པའི་སྲོལ་ཡང་ཡོད་འདུགདྲི་བ།",
    "གྲུ་གུ་ཞེས་པ་ནི་བལ་སྐུད་གྲུག་རིལ་བྱས་ནས་གཙགས་པའི་ཆེ་ཆུང་ལ་ཁུར་ཚུར་ཙམ་ཞིག་ཡོད་པ་དེར་ཟེར།",
    "དུས་རྒྱུན་འཚོ་བའི་ཁྲོད་མི་རྣམས་ཀྱིས་ཐོན་སྐྱེད་ལག་ཆ་དང་འཚོ་བའི་ལག་ཆ་གཅིག་གོ་གཉིས་ཆོད་བྱེད་ཀྱིན་འདུག་སྟེ།",
    "ཁོ་རང་ས་འོག་ན་གནས་པའི་ས་བདག་ཅིག་ཡིན་ལ་གཟུགས་ནི་གྲོད་པུའི་དབྱིབས་ལྟར་དང་།",
    "མནའ་སྐྱེལ་སྟངས་ལ་རིགས་མི་མཐུན་པ་གང་མང་ཆགས་འདུགཞིག་ཡོད་དེ།",
    "ཁ་དོག་དཀར་བོར་འདུག་པ་འདི།",
    "མི་མཐུན་གཡུལ་ལས་རྒྱལ་བའི་ངོ་། ནང་ན་འདུག་པའི་གཡང་ཆ་འདི།",
    "རྒྱབ་ལ་ཆོ་རིལ་མིག་བཞི་འདོགས་པ་ནི་བྱིས་པ་གོམ་པ་ཅུང་སྤོ་ཐུབ་པའི་སྐབས་སུ་འགྲོ་འདུག་རྒོད་པའི་བྱིས་པ་མི་འབོར་བའི་ཆེད་དུ་ཆོ་རིལ་གྱི་སྒྲ་གྲག་ན་བྱིས་པ་གར་ཡོད་ཕ་མའི་ཤེས་པའི་ཆེད་དུ་ཡིན་ལ།",
    "དབུས་གཙང་པས་བོད་ཟླ་ལ་ཧོར་ཟླ་ཞེས་སྔོན་ལུགས་རྒྱུན་འབྱམས་ཀྱིས་འབོད་ཀྱིན་འདུག་ལ།",
    "ངོ་བོའི་ཆ་ནས་དབྱེ་ན་བོད་ཆང་དང་བོད་རག་དུས་ཡུན་གྱི་ཆ་ནས་དབྱེ་ན་ཞག་ཆང་དང་ཟླ་ཆང་།",
    "ད་དུང་རང་ཉིད་ལ་བདེ་སྐྱིད་ཁྱེར་ཡོང་བའི་རོལ་རྩེད་ཅིག་ཏུའང་རྩི་བཞིན་ཡོད་པས།",
    "དེ་འདུག་ས་ཡིན་པར་བརྗོད།",
    "དམའ་བར་འདུག་སྨྲས་བཟླས་པ་ཡིས།",
    "དེ་ལ་ཁོ་རང་ཡིན་པར་གྱུར་པའི་རྣམ་པར་རིག་བྱེད་ཀྱི་གཟུགས་དང་།",
    "འདིའི་འཇུག་དུས་ཀྱང་ཡོད་དེ།",
    "ཁོ་རང་ཡིན་པར་གྱུར་པའི་ཕྱིར་མི་འོང་གོང་བུ་འོག་མིན་འགྲོ་དང་།",
    "ཐོགས་བཅས་ཀྱི་གཟུགས་དང་ཐོགས་མེད་ཀྱི་གཟུགས་འགའ་ཡང་རང་བཞིན་གྱིས་མེད་དེ།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་མེད་པའི་ཕྱིར།",
    "ཕུང་པོ་ལྷག་མ་བཞི་པོ་དེ་ཡང་རང་བཞིན་གྱིས་མེད་དེ།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་མེད་པ་དེ་ཡིན་པའི་ཕྱིར།",
    "མུན་པའང་རང་དང་གཞན་གྱི་དངོས།",
    "ཕུང་པོ་རྣམས་དང་རང་བཞིན་གྱིས་གཞན་ཡིན་པའི་ཕྱིར།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རོལ་དོན་དུ་གྱུར་པའི་གཟུགས་གོང་དུ་བཀག་ཟིན་པ་དེའི་ཕྱིར། ཕྱི་རོལ་གྱི་དོན་ཡོད་ཀྱང་རང་རིག་པ་ཅི་ལྟ་བ་བཞིན་དོན་འགྲུབ་པའི་ཕྱིར།",
    "མི་དམིགས་པ་དང་རང་བཞིན་དང་འབྲས་བུའོ།",
    "བྱས་པ་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ལྡོག་ཁྱབ་དང་མ་ངེས་པའི་གཏན་ཚིགས་ཀྱི་གཞི་མཐུན་ཡིན་པ་དེ་བཅད་པར་བྱ་བའི་ཆེད་ཡིན་པའི་ཕྱིར། དེའི་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག།",
    "དེ་འདྲའི་དཔྱིད་དུས་ཀྱི་ཞིང་རང་འབྲས་ནས་མྱུག་འབྱུང་རུང་དུ་སྒྲུབ་པའི་རང་བཞིན་གྱི་རྟགས་ཡང་དག་ཡིན་ཏེ།",
    "དེ་སྒྲུབ་ཀྱི་སྒྲུབ་པའི་ཚུལ་གསུམ་གང་ཞིགརང་འབྲས་ནས་སྨྱུག་འབྱུང་རུང་དེ་དང་རང་བཞིན་གཅིག་ཡིན་པའི་ཕྱིར་རོ།",
    "སྔོན་རྒྱལ་པོ་སྤྱི་བོ་སྐྱེས་དང་བརྒྱ་བྱིན་གཉིས་སྟན་གཅིག་ལ་འདུག་པའི་ཚེ།",
    "ཕྱི་མ་མ་འཆགས་པའི་བར་དུ་འཇིག་རྟེན་སྟོང་པར་འདུག་པའི་ཡུན་ལ་བར་བསྐལ་ཉི་ཤུ་ཡོད་པ་དེ་ལ་སྟོང་པའི་བསྐལ་བར་འཇོག་ལ།",
