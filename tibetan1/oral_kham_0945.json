    "དུང་ལོ་སྐྱིད་ཀྱིས་ང་རང་མི་གཉིས་ལས་མེད་པར་ལས་སླ་ས་ཞིག་ནས་མཉམ་དུ་འགྲོ་ཟེར།",
    "དུང་ལོ་སྐྱིད་ཀྱིས་ང་རང་གཉིས་ལས་མེད་པར་སླ་ས་ཞིག་ནས་མཉམ་དུ་འགྲོ་བརྗོད།",
    "དུང་ལོ་སྐྱིད་ཀྱིས་ང་རང་མི་རྡོག་གཉིས་ལས་མེད་པར་ལས་སླ་ས་ཞིག་ནས་འགྲོ་ཟེར་བས་ཁོང་གཉིས་མཉམ་དུ་བྱེ་རི་ནས་བབས་པས་འཁྱུག་ཙམ་ཞིག་ལ་ལ་གཤམ་དུ་སླེབས།",
    "སྐབས་དེར་གཅུང་པོས་གཅེན་པོར་ཨ་ཇོ།",
    "རྔོན་པ་གཅུང་པོ་བློ་ཕྲན་བུ་མི་བདེ་བ་བྱུང་ཡང་རང་ཉིད་ཀྱིས་གཅེན་པོར་སྲུང་སྐྱོབ་གྲ་སྒྲིག་འཐུས་ཚང་བྱས་ཡོད་པས་མི་དོ་སྙམ།",
    "དེ་ནས་གཅུང་པོ་བྲག་ཟུར་གྱི་འདུག་གནས་སུ་སླེབས་སྐབས་གཅེན་པོ་ཉལ་སའ་ནང་ནས་གཅུང་པོ།",
    "ཁྱེད་མེད་ཤུལ་དུ་བདག་ཁྱེད་དྲན་པའི་གདུང་བ་བཟོད་ཐབས་མི་འདུག་པས་ཅི་དྲག་བསམ་ནས་ངུ་བ་ཡིན་ཞེས་བརྗོད།",
    "ཁྱེད་ཀྱི་སྐུ་འདྲ་ཞིག་ཡོད་ནའང་སེམས་ཅུང་ཟད་ཆགས་པ་ཞིག་ཡོང་བ་འདུག་ཟེར།",
    "ཚོང་དཔོན་གྱིས་ཨ་ཙི་ཁྱེད་འདི་འདྲ་ཐུགས་ཅ་སུན་པོ་གནང་ནས་གང་དྲག་ཕྲན་ལ་སོའོ་དང་།",
    "མུ་ཏིག་སྐྱུག་མཁན་གྱིས་གོས་ཆེན་གྱི་བློན་ཆས་ཆ་ཚང་གྱོན་ཞིང་རང་ཁྱིམ་ཕྱོགས་སུ་བསྐྱོད།",
    "ད་ཆ་ཁྱེད་རང་རྒྱལ་ཁབ་ཀྱི་བློན་པོར་གྱུར་རྗེས་ནམ་ཉིན་ཀུན་ཏུ་ཁྱེད་བསམ་མཁན་དམན་ཆུང་ང་བརྩེ་བས་དོར་རམ།",
    "དང་ཐོག་ང་རང་དེ་ཉིན་སེམས་སྐྱོ་ནས་བསྡད་པའི་སྐབས་ཁོས་བཙན་ཤེད་ཀྱིས་གནས་ཚང་གཡར་དགོས་ཟེར་བ་དང་།",
    "ཁྱིམ་མཚེས་ཀྱི་ཉམས་མྱོང་བཞིན་ལེགས་པར་གསོས་ཏེ་བདེ་ཐང་བྱུང་བས་འཕུར་ཁར་སྔར་བཞོན་ལབ་སོན་རྐང་གཅིག་བཀའ་དྲིན་ལེགས་གསོལ་དུ་སྦྱིན་པ་དེ་གོང་བཞིན་བྱུང་བས་དེ་ཁ་སྐོར་ཙ་ན་དེའི་ནང་ནས་ཟ་ཟིང་ལང་ལོང་ངང་ཕྲུ་གུ་ཁྱུ་གཅིག་ཐོན་ཏེ་པཱ་ཕ་ང་ལ་སྤགས་དགོས།",
    "ཁ་རྒྱུན་དུ་སེངྒེའི་སྐད་ཀྱིས་རི་དྭགས་ཐམས་ཅད་ཟིལ་གྱིས་གནོན་ཞེས་པ་ལྟར་སེངྒེ་རང་ཡིན་འདུག་སྙམ།",
    "ཁོང་གཉིས་བོང་བུའི་སར་འབྱོར་ན་སུས་ཀྱང་ཕྱིར་བཤོལ་མི་བྱེད་རྒྱུའི་དམ་བཅའ་བཞག་པར་མ་ཟད་སྤྱང་ཀིའི་སེམས་ལ་སྟག་བྲོས་ཡོང་སྙམ་ནས་ཁོ་རང་གཉིས་ཀྱི་མཇུག་མ་གཉིས་མདུད་པ་བརྒྱབས་ནས་འབྲེལ་ཏེ་ཕྱིན།",
    "འཁྲི་ཤིང་ནགས་ཀྱི་གསེབ་ཏུ་གསེར་གྱི་བྱིའུ་འབབས་འདུག་ཅེས་ཟེར།",
    "ཝ་ཁ་ནང་དུ་བཟོས་པས་ད་ཆ་ཆུ་ཡོངས་རྫོགས་ནང་ལ་འཛགས་ཀྱི་འདུག་ཟེར།",
    "མཆོད་གནས་ཀྱིས་སེམས་ལ་རང་ལ་བཞད་གད་བྱེད་འདུག་སྙམ་ནས།",
    "ཉིན་གཉིས་པར་ལུག་རྫི་སླེབས་ནས་མཆོད་གནས་ལ་ང་དེ་རིང་མིན་མངས་ཤིག་རྒྱག་འདོད་འདུག་བྱས་པས་མཆོག་གནས་ཀྱིས་དེ་ཡོང་ཞེས་བརྗོད་ནས་མིག་མངས་བརྒྱབས།",
    "ང་ཨེམ་ཆི་སློབ་འདོད་འདུགཔས་འདི་ནས་ང་ཁ་གྱེས་ཀྱི་ཡིན།",
    "ང་ལྕགས་བཟོ་སློར་པར་འགྲོ་འདོད་འདུག་ཅེས་གོང་བཞིན་བསྐྱོད།",
    "དེ་ལྟར་ཉིན་གཅིག་ལྟར་ལོ་དྲུག་བྱས་པས་ང་ལ་ཚོར་བ་གང་ཡང་མེད་པར་གླང་ཆུང་དེ་གླང་རྒན་དུ་གྱུར་འདུག་ལ།",
    "ང་རང་རང་སྟག་ཤར་དུ་གྱུར་འདུག་ངས་ལོ་དྲུག་སྔོན་དུ་གླང་ཆུང་བཀྱགས་པ་དང་།",
    "དེང་སྐབས་གླང་རྒན་བཀྱག་པར་ལྗིད་ལོས་ཁྱད་པར་མི་འདུག་བརྗོད།",
    "ལར་ནས་ཉ་དེ་ནི་མི་འཕྲུལ་ལྟ་བུར་བཟའ་ཟླའི་ལག་ནས་ནམ་མཁར་འཕུར་འཕུར་འདུག་ཅེས་བརྗོད།",
    "དེ་ན་ཁོ་ལ་གཡོ་རྒྱུ་སྒྱུ་གང་འདུག་བལྟ་ཆོག་ཅེས་བརྗོད།",
    "ཁོང་ཕ་རྒན་གཉིས་ཀྱི་རྐུན་མ་ཡ་མེད་དེ་འདུལ་ཐབས་མི་འདུག་སྙམ་ནས་དངུལ་ཕྲན་ཙམ་སྦྱིན་ནས་ཁོ་ཕྱིར་ཕུད་དོ།",
    "༡༩༨༨་༡ཨ་ཇོ་ཤགས་དཔོན།",
    "ཁྱེད་རང་དོགས་འདྲོག་ལངས་མི་དགོས།",
    "དེ་རིང་རྒྱལ་པོས་ཁྱེད་རང་ཤགས་རྒྱག་པར་བོས་ཤོག་གསུངས་པས་ལྟར་ཡོང་བ་ཡིན།",
    "ཨ་ཇོ་ཤགས་དཔོན་གྱིས་ཁྱེད་ཀྱི་རྒྱུད་མངགས་དང་།",
    "མི་ཚོས་ཟེར་སྐད་བྱས་ན་ཁྱེད་རང་ཤགས་དང་།",
    "དེ་ནས་ཨ་ཇོ་ཤགས་དཔོན་གྱི་མེས་པོའི་དུས་ཀྱི་བུ་ལོན་འབྲུལ་ཁལ་ཆིག་སྟོང་ལྔ་བརྒྱ་དེ་སྤྲོད་པའི་དམིགས་བརྟེན་གང་ཡང་མེད་ཀྱང་ཁ་རྩལ་གྱིས་དག་པར་བྱས་སོ།",
    "རྒྱལ་པོའི་ཁྱེད་རང་ཐེ་གཏོགས་མི་དགོས་ཞེས་ཟེར།",
    "རྒྱལ་སྲས་གང་དུ་འདུག་ཅེས་དྲིས།"
  ]
}