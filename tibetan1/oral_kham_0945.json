    "གཉེན་པོ་ཉིད་ཀྱང་རང་སར་གྲོལ།",
    "དེ་ནས་གཟུང་འཛིན་བདེན་མེད་དུ་རྟོགས་པའི་ཤེས་རབ་དེ་ཉིད་ཀྱང་རང་བཞིན་མེད་པར་གཏན་ལ་ཕབ།",
    "དེས་ན་དེ་ལྟ་བུའི་གཉེན་པོ་བདེན་པར་འཛིན་པའི་བློ་ཡང་རང་སར་གྲོལ་བ་སྟེ་བློས་གསར་དུ་བདེན་མེད་དུ་བཅོས་པ་མིན་པར་གདོད་མ་ནས་རང་བཞིན་མེད་པའི་དོན་ནོ།",
    "དེའི་ཚེ་ངེས་ངོར་ང་རང་བཞིན་མེད་པར་ངེས་པའི་ངེས་ཤེས་དམ་སྦྲེང་ངེ་བ་དང་།",
    "ཇི་ལྟར་མི་དག་ནགས་རིའི་ཁྲོད་འདུག་ནས།",
    "འདུག་པའམ་ཉལ་བ་ན་ཡང་རུང་སྟེ།",
    "དེ་ལྟར་སྦྱོར་བ་བཞིའི་སྒོ་ནས་རྐྱེན་ངན་ལམ་དུ་བསྒྱུར་ཚུལ་དེ་དག་ནི་རྒྱལ་བའི་སྲས་པོ་བཟང་པོ་དཔལ་གྱིས་ཤིན་ཏུ་གོ་བདེ་བར་གསུངས་འདུག་པ་དེ་ཁོ་ན་བཞིན་བྲིས་པ་ཡིན་ནོ།",
    "ད་དུང་འདི་དང་མ་བྲལ་ན་བདེར་མི་སྟེར་བ་འདུག་ཅིང་།",
    "མི་འདུག་པ་ལ།",
    "མཐོ་བ་ལ་ཕྲག་དོག་དམའ་བ་ལ་བརྙས་པ་མཉམ་པ་ལ་འགྲན་སེམས་བྱེད་པ་ཐམས་ཅད་ཀྱང་རང་གཅེས་པར་འཛིན་པས་ལན།",
    "ད་དུང་འདི་དང་མ་བྲལ་ན་བདེར་མི་སྟེར་བར་འདུག་ཅིང་།",
    "གཅིག་པུར་འདུག་ན་སེམས་ལ་བརྟག།",
    "དགྲ་ནང་ན་འདུག་པའི་བདག་འཛིན་ཐུལ།",
    "གནོད་པའི་ལན་འཇལ་བའི་དུས་བྱུང་ཙ་ན་གནོད་ལན་འཇལ་བ་དེ་སྤོང་བའོ།",
    "གང་ཟག་སུས་བྱས་ཀྱང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་ཡིན་པས་ཉེས་པ་ཁོ་ནར་འགྱུར་ཞིང་།",
    "ད་ལྟ་སྡོམ་པ་དང་དམ་ཚིག་ཚུལ་བཞིན་མི་བསྲུང་བ་རྣམས་ལ་ཚོས་བྱུགས་ཀྱང་མི་འགོ་བར་འདུག་པ་འདི་བག་ཡོད་ཉམས་པས་ལན་པ་ཡིན་པས་ཅིས་ཀྱང་བག་ཡོད་མ་ཉམས་པ་གལ་ཆེའོ།",
    "འདུག་གམ།",
    "ཀོ་ལོང་བྱས་ཀྱང་ཕན་པ་མེད་ཅིང་རང་རྒྱུད་འཚིག་ནས་རང་ཉིད་ཕུང་བར་འགྱུར་རོ།",
    "ཁོང་ཁྲོས་གཞན་ལ་མི་གནོད་ཅིང་རང་ལ་གནོད་པ་དང་།",
    "ཀོ་ལོང་གཙང་བཙན་པས་དམ་པར་གདའ་སྟེ།",
    "བསམ་གཏན་གྱི་ཁང་བུར་གཅིག་པུར་འདུག་ཚུགས་པ་དང་།",
    "ཞེས་པ་ལ་སོགས་པ་གྲོགས་དང་ལྷན་ཅིག་འདུག་པའི་ཚེ་ཇི་ལྟར་བྱ་བ་དང་།",
    "གཅིག་པུར་འདུག་པའི་ཚེ་ཇི་ལྟར་བྱ་བའི་ཚུལ་ཞིབ་པར་གསུངས་ཏེ།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
