    "སུས་བཅོས་པར་བྱ་ཞེ་ན་དེའི་ཕྱིར།",
    "གནས་མལ་གྱི་གཞི་ཆག་ཆག་དང་ཕྱག་དང་དང་ལྕིབ་འཇམ་པོའི་བྱུག་པས་བསྐུ་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "མལ་ཆ་དྲི་མས་གོས་པ་སྤྲུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཕྱག་དར་བྱས་པའི་འོག་ཏུ་མལ་སྟན་བཤམ་པར་བྱ་བའོ།",
    "མལ་ཆ་དང་སྟན་གྱི་གཞིའི་ཁྲི་ལ་སོགས་པ་རྡུལ་དང་བཅས་པ་ཉིད་ཡིན་ན་དེ་མ་སྤྲུགས་པའི་སྟེང་དུ་མལ་དང་སྟན་བཤམ་པར་མི་བྱའོ།",
    "དེ་ལྟར་རས་མར་བྱས་ཀྱང་ཁྲི་ལ་སོགས་པ་སྤྲུག་པར་མི་ནུས་པ་ཉིད་ཡིན་ན་ཇི་སྐད་སྨོས་པ་དེ་བཞིན་བྱ་བའོ།",
    "སྦྱིན་པ་པོ་མྱ་ངན་བསང་བའི་ཕྱིར་ཕུལ་བ་དེས་མཐོང་བར་གཞག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "སྒྲ་མི་སྙན་པའི་གཉེན་པོའི་ཕྱིར་ཚེས་བརྒྱད་དང་བཅུ་བཞི་དག་ལ་ཁྱམས་སུ་བཤམ་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ས་གཞི་སྤྱིལ་བ་འཇམ་པོ་མི་ཉམས་པར་བྱ་བའི་ཕྱིར་རོ།",
    "སྤྱིལ་བ་མི་ཉམས་པར་བྱ་བའི་ཕྱིར་ཡང་ན་ཁྲི་རྐང་དེའི་འོག་ཏུ་ཕུབ་མའི་ཕུང་བུ་བླུགས་པའམ་ཁྲི་རྐང་དེ་རས་མས་དཀྲི་བར་བྱའོ།",
    "གང་ཟག་ལ་ནི་རྣམ་པ་ཐམས་ཅད་རྗེས་སུ་མི་གནང་ངོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གང་ཟག་ལ་ནི་རྗེས་སུ་མི་གནང་ངོ།",
    "ཡལ་ག་གཉིས་པ་དང་མང་པོ་ཡང་དེ་བཞིན་ནོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "སྔས་ནང་ནང་ཚངས་ཅན་གྱི་རྣམ་པ་བསྟན་པའི་ཕྱིར་ཁྲུ་བཞི་དང་དོ་པ་ཉིས་བལྟབ་ཏུ་བྱས་ཏེ།",
    "སོ་སོར་བརྟག་པར་མ་བྱས་པར་ཉལ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "མལ་དང་སྟན་ལ་སོ་སོར་བརྟག་པར་མ་བྱས་པར་དེར་ཉལ་བར་མི་བྱའོ།",
    "ཉལ་བར་བྱེད་ན་སོ་སོར་བརྟགས་ཏེ་ཉལ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དྲན་པ་ཉེ་བར་མ་བཞག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་ཉལ་བར་མི་བྱ་བ་སྟེ།",
    "ཡིན་པར་རིག་པར་བྱའོ།",
    "གསུམ་ལས་ལྷག་པ་མང་བ་དང་ལྷན་ཅིག་ཁྲི་ལས་འཛེག་པ་ཉིད་བསྟེན་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ལྷག་པར་མང་པོ་དང་ལྷན་ཅིག་འཛེག་པ་ཉིད་བསྟེན་པར་མི་བྱ་བའོ།",
    "དེ་ནི་ཁྲི་ཐུང་དུའི་དཔེ་ཡིན་པར་བལྟ་བར་བྱའོ།",
    "བསྙེན་པར་རྫོགས་པའི་ལོ་གྲངས་ཡིན་གྱི་ན་ཚོད་ནི་མ་ཡིན་ཏེ།",
    "བསྙེན་པར་མ་རྫོགས་པ་དང་ཡང་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཟ་མ་དང་མ་ནིང་དང་མ་བསད་པ་ལ་སོགས་པ་དང་མུ་སྟེགས་ཅན་དང་མུ་སྟེགས་ཅན་དུ་ཞུགས་པ་དང་རྐུ་ཐབས་སུ་གནས་པ་དང་ཐ་དད་པར་གནས་པ་དང་གནས་པར་མི་བྱ་བ་དག་དང་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "འདིར་བསྙེན་པར་རྫོགས་པ་དང་བཅས་པ་ཞེས་སྨོས་པ་ནི།",
    "བསྙེན་པར་མ་རྫོགས་པ་དང་ཡང་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཟ་མ་དང་མ་ནིང་དང་མ་བསད་པ་ལ་སོགས་པ་དང་མུ་སྟེགས་ཅན་དང་མུ་སྟེགས་ཅན་དུ་ཞུགས་པ་དང་རྐུ་ཐབས་སུ་གནས་པ་དང་ཐ་དད་པར་གནས་པ་དང་གནས་པར་མི་བྱ་བ་དག་དང་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "འདིར་བསྙེན་པར་རྫོགས་པ་དང་བཅས་པ་ཞེས་སྨོས་པ་ནི།",
    "རྐུ་འཕྲོག་ནི་དཔེ་ཙམ་དུ་ཟད་དེ་ཆུད་ཟ་བར་འགྱུར་བ་དག་ལ་ཡང་ཆོ་ག་དེ་བཞིན་དུ་བསྒྲུབ་པར་བྱ་བའོ།",
    "གནས་སུ་མ་སོན་གྱི་བར་དུ་ཁྱེར་བར་བྱེད་པས་ལོངས་སྤྱད་པར་བྱ་བ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "གནས་གཞན་གྱི་ཟས་དང་ཡོ་བྱད་ཀྱི་རྙེད་པ་གནས་གཞན་དུ་ཡོངས་སུ་སྤྱད་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེ་དེ་ལ་སྦྱིན་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "འདིར་གཞུང་ནི་དགེ་སློང་གཞན་དུ་གནས་པས་གཞན་དུ་ཁྱེར་ཏེ་ཅུང་ཟད་ཅི་ཙམ་ཟོས་པ་ཐམས་ཅད་རིན་ཚང་བར་བྱས་ཏེ་འབུལ་དུ་གཞུག་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "མ་བསྐོས་པར་འཁོར་ཞིང་སྤྱད་པ་ལ་ཇི་ལྟར་འོངས་པས་ཡིན་གྱི་རྒན་རིམས་ཀྱིས་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "རྒན་རིམས་ཀྱིས་སྤྱད་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "དེ་མ་བསྒོས་ན་དང་པོ་སུ་འོངས་པ་དེ་ལ་གཡར་པོར་སྦྱིན་པར་བྱའོ།",
    "གལ་ཏེ་ཅིག་ཅར་བརྙས་པར་གྱུར་ན་ནི་ཅིག་ཅར་བརྙས་པ་དེ་རྒན་རིམས་ཀྱིས་སྤྱད་པར་བྱ་བའོ།",
    "གཞན་གྱི་མཐུས་དབྲོག་པར་མི་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེས་རྐང་པ་བཀྲུས་མ་ཟིན་གྱི་བར་དུ་གཞན་གྱི་རྐང་ཁྲུས་སའི་གོ་དབྲོག་པར་མི་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདི་ལ་རྒན་རིམས་སུ་མི་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "བྱ་བ་བྱས་ན་འཁོར་ཞིང་སྤྱད་པར་འདོད་པ་ཡོད་ན་བཅད་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "རྐང་ཁྲུས་ས་ལ་སོགས་པ་དང་ཆབ་ཁུང་ས་ལ་སོགས་པ་གཞན་འདོད་པ་ཡོད་ན་མི་བཅང་མི་བརྣོག་པར་གཏང་བར་བྱ་བའོ།",
    "བར་དུ་དོན་གྱི་ཆེད་ཉིད་དུ་ཁྲིའུ་ལས་ལངས་པ་ནི་བྱ་བ་བྱས་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "ང་དུང་ལས་སྔ་མ་བརྩམས་པ་མ་ཟིན་པས་བྱ་བ་བྱས་པ་ཉིད་མ་ཡིན་ཏེ།",
    "གཞན་ལ་ཡང་དེ་བཞིན་དུ་ཅི་རིགས་པར་སྦྱར་རོ།",
    "དེ་ནི་ཁྲིའུ་བྱ་བ་མ་བྱས་པར་ཁ་བརྔམ་དུ་འཕྲོག་པའི་སྐབས་མེད་པར་བྱ་བའི་ཕྱིར་རོ།",
    "དོན་ཡོད་ན་རྣམ་པ་དེ་ལྟ་བུ་ལས་བྲལ་པར་བྱས་པ་ལ་ཁ་ན་མ་ཐོབ་མེད་དོ་ཞེས་བྱ་བ་ནི།",
    "དོན་མེད་ན་ནི་བྲལ་པར་མི་བྱའོ།",
    "མཆིག་དེའི་སྟེང་ནས་ལན་ཚྭ་ལ་སོགས་པ་འཐག་པར་བྱེད་པའི་རྡོ་ལེབ་ཆུང་དུ་འཕྲེད་ཀར་གཞག་པའོ།",
    "ཅེས་བྱ་བ་ནི་འདྲེག་མཁན་གྱི་ལག་ཆའི་སྣོད་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "འདིར་གཞུང་ནི་ཤིང་དག་གཤེགས་པར་མི་ནུས་ནས།",
    "དེས་དགེ་སློང་ལ་གཡར་པོ་ཉིད་དུས་ལས་བྱས་པ་ཡན་ཆད་སྦྱིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "ས་ལས་བྱས་པའི་ཐབ་ཀྱང་ངོ་ཞེས་བྱ་བ་ནི།",
    "འཁར་བའི་གནང་བ་ཐོབ་པ་ཐམས་ཅད་ཀྱིས་འཁར་བ་བཅང་བར་བྱ་བའོ།",
    "འཁར་བ་གནང་བ་སྩལ་དུ་གསོལ།",
    "འདི་ནི་སྡིག་སྤྲུལ་ལ་སོགས་པའི་གཉེན་པོའི་ཕྱིར་རྗེས་སུ་གནང་བ་ཡིན་པས་དེའི་ཕྱིར་དེ་གསུམ་ཐ་དད་པར་ཤེས་པར་བྱའོ།",
    "ལྕགས་ཀྱི་བུ་གུ་ངོས་གཅིག་ཞབས་བཅུག་པ་བསྐོན་པར་བྱ་བའོ།",
    "དེ་ལྟ་བས་ན་སྡིག་སྤྲུལ་བཟློག་པའི་ཕྱིར་འཁར་བ་སྒྲ་ཅན་རྗེས་སུ་གནང་ངོ་ཞེས་བྱ་བའི་བར་དུ་གསུངས་པ་ཡིན་ནོ།",
    "སྨྱིག་མ་མཁན་གྱིས་བྱས་པ་འམ་ལོ་མ་ལས་བྱས་པའི་གདུགས་བཅང་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེ་ནི་སྐྱེ་བོ་ཐམས་ཅད་ཀྱི་དོན་དུ་གདུགས་ཁྲ་བོ་བཀྲ་བདག་བྱེད་པས་དེ་འདིར་ཉེས་པ་མེད་པར་བསྟན་པའི་ཕྱིར་སྨྱིག་མ་མཁན་གྱིས་བྱས་པའི་ཞེས་སྨོས་སོ།",
    "ལོ་མ་ལས་བྱས་བའི་གདུགས་ནི་འཕྲལ་གྱི་རང་བཟོར་བྱས་པ་ཡིན་ཏེ།",
    "ཡུ་བ་ནི་ལུས་ཀྱི་ཚད་དོ་ཞེས་བྱ་བ་ནི་གདུགས་ཀྱི་ཡུ་བའི་སྲིད་ཀྱི་ཚད་ནི་ལུས་ཀྱི་སྲིད་ཀྱི་ཚད་དང་མཉམ་པར་བྱའོ།",
    "ད་ནི་གནས་གཞན་ན་གནས་པའི་སྐབས་བརྗོད་པར་བྱ་སྟེ།",
    "གདོལ་བའི་ཁྱིམ་གྱི་གནས་དག་བསྟེན་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "སྤྱོད་ཡུལ་མ་ཡིན་པའི་གནས་ལྔ་པོ་དེ་དག་ཏུ་འཇུག་པར་མི་བྱའོ།",
    "དེའི་ཉེན་ཀོར་དུ་ལུང་དབོག་པར་མི་བྱ།",
    "བཀླག་པར་མི་བྱ།",
    "ཐོན་མི་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "འདིར་གཞུང་ནི་དུས་དུས་སུ་བསྐམ་པར་བྱའོ་གསུངས་པ་ཡིན་ནོ།",
    "རྟག་ཏུ་མེ་དང་ཆུ་ཡོད་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "འདིར་གཞུང་ནི་ཕྱེ་དང་སྦྲང་རྩི་དང་ཞུན་མར་ཅི་འབྱོར་བ་ཉེ་བར་གཞག་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཟས་ལས་ལྷག་རོལ་ལུས་པར་གྱུར་ན་ཡང་ཉེ་བར་གཞག་པར་བྱའོ།",
    "གང་དུ་ཕྱི་རོལ་སྣང་བ་ཐམས་ཅད་ཡིན་པར་རིག་པར་བྱའོ།",
    "དཔུང་པ་གཉིས་མ་གཡོགས་པར་ཁྱིམ་པའི་དུང་དུ་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེས་དགེ་སློང་རྗེས་སུ་གནང་བ་བྱེད་དུ་མ་བཅུག་པར་གཙུག་ལག་ཁང་དུ་འཇུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཅི་དེ་བཞིན་རྗེས་སུ་གནང་པར་བྱའམ་ཞེ་ན་དེའི་ཕྱིར།",
    "དྲི་བས་ཞེ་འགྲས་པ་མེད་པ་ཉིད་ངེས་པར་ཤེས་པར་བྱ་ཏེའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གནས་ཀྱི་ཡང་དག་པར་སྦྱར་བའི་སྐབས་རྫོགས་སོ།",
    "ད་ནི་སྤ་བའི་རྣམ་པར་གཞག་པ་དང་ཡོངས་སུ་བསྐྱང་བའི་སྐབས་བརྗོད་པར་བྱ་སྟེ།",
    "ཕྲེད་གཏན་དང་གནམ་གཟེར་དང་འཁོར་གཏན་དང་སྒོ་ལྕགས་དང་ལྡེ་མིག་ཀྱོག་པོ་དག་གཙུག་ལག་ཁང་བསྡམ་པའི་ཕྱིར་ཡང་དག་པར་སྦྱར་རོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་དག་ལྔ་པོ་འདི་དག་ནི་སྡོམ་པར་བྱེད་པ་དག་ཡིན་ཏེ།",
    "དེ་དག་གཙུག་ལག་ཁང་ན་བདོག་ན་ཐམས་ཅད་དགེ་སྐོས་ཀྱིས་བཅང་བར་བྱའོ་ཞེས་གསུངས་པ་དང་།",
    "གཙུག་ལག་ཁང་སོ་སོར་བརྟགས་སམ་ཞེས་དྲི་བར་བྱའོ་ཞེས་གསུངས་པ་དང་།",
    "དགེ་སྐོས་ཀྱིས་དགོངས་ཀར་གཙུག་ལག་ཁང་བསྡམས་ནས་སོ་སོར་བརྟག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེར་གྱུར་པས་ཉལ་བ་དང་སྙོམས་པར་འཇུག་པ་དག་སྤང་ངོ་ཞེས་བྱ་བ་ནི།",
    "མེལ་ཚེའི་ཐུན་པར་གྱུར་པ་དེས་ཉལ་བ་དང་སྙོམས་པར་འཇུག་པ་དག་ངེས་པར་སྤང་བར་བྱ་སྟེ།",
    "གཞན་དུ་ན་ཡིད་རྟོན་པ་ལ་འཁུས་པར་འགྱུར་རོ།",
    "རྫས་ཅི་རླག་པ་དགེ་སྐོས་འཇལ་དུ་གཞུག་པར་བྱ་བ་ཉིད་ཡིན་ཏེ།",
    "དེ་དག་ཇི་ཙམ་ཉམས་པར་བྱས་པ་དེ་ཙམ་གྱི་ཆ་དག་གོ་ཞེས་བྱ་བ་ནི།",
    "བསྡམས་པའི་ཕྱིར་ཡང་དག་པར་སྦྱར་བ་འཕྲེད་གཏན་ལ་སོགས་པ་དག་ལས་གཅིག་གམ་དུ་མའམ།",
    "མང་པོས་བསྡམ་པ་མ་བསྒྲུབས་ཤིང་ཉམས་པར་བྱས་ན་ཡང་དག་པར་སྦྱར་བ་དེ་དག་ཇི་ཙམ་མ་བསྒྲུབས་ཤིང་ཉམས་པར་བྱས་པ་དེ་ཙམ་གྱི་ཆ་དག་དགེ་སྐོས་འཇལ་དུ་གཞུག་པར་བྱ་བ་ཉིད་ཡིན་ཏེ།",
    "ཕྲེང་གཏན་ལ་སོགས་པ་སྡོམ་པར་བྱེད་པ་ཇི་སྙེད་ཡོད་པ་དེ་དག་ཐམས་ཅད་ཀྱིས་སྒོ་མ་བསྡམས་པར་གཞན་དུ་འགྲོ་བར་མི་བྱའོ།",
    "གལ་ཏེ་གནས་སྟོང་པར་ཞུགས་པར་གྱུར་པ་ན་དེར་ཆག་ཆག་ལ་སོགས་པ་བྱའོ་ཞེས་བྱ་བ་ནི་གནས་གང་དུ་ཞུགས་པར་གྱུར་པ་དེ་གལ་ཏེ་སྟོང་པ་ཡིན་ན།",
    "སྣོད་སྤྱད་བརྩམ་པ་མཁོས་སུ་དབབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གནས་གང་དུ་ཞུགས་པར་གྱུར་པ་དེ་ན་གལ་ཏེ་སྣོད་སྤྱད་དག་བསྡུ་བ་སོགས་མ་བྱས་པར་བརྩམ་པར་འཇུག་ན་དེ་དག་གནས་ཇི་ལྟ་བ་བཞིན་དུ་བསྡུ་བ་སོག་བྱ་ཞིང་མཁོས་སྲུང་བབ་པར་བྱའོ།",
    "སྣོད་སྤྱད་དེ་དག་གལ་ཏེ་བཀྲུ་བཤལ་ལ་སོགས་པ་བྱི་དོར་བྱ་བ་དེ་བཟོད་ཅིང་འོས་པ་ཡིན་ན་དེ་དག་བཀྲུ་བཤལ་ལ་སོགས་པ་བྱི་དོར་བྱ་སྟེ་མཁོས་སུ་དབབ་པར་བྱའོ།",
    "གལ་ཏེ་རུང་བར་བྱེད་པ་ཡོད་ན་སྔོ་སྲབ་པ་བྱེད་དུ་གཞུག་གོ་ཞེས་བྱ་བ་ནི་གལ་ཏེ་རྩེ་རྒོད་ལ་སོགས་པ་བསྙེན་པར་མ་རྫོགས་པ་དུང་བར་བྱེད་པ་ཡོད་ན།",
    "ད་ནི་ཕྱི་རོལ་གྱི་སྐབས་བརྗོད་པར་བྱ་སྟེ།",
    "འདིར་ཤིང་ལྗོན་པ་ཞེས་བྱ་བ་ནི་ན་གས་མ་དང་གེལ་པ་དང་ཁྲི་ཤིང་དང་ཏལ་ལ་སོགས་པ་དག་བསྟན་པར་རིག་པར་བྱའོ།",
    "གལ་ཏེ་འགྲོ་ན་དགེ་སློང་ལ་རྗེས་སུ་གཏད་དེ་འགྲོ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ་། བཅུ་པའི་བདག་ཉིད་ཀྱིས་བསྐྱང་པ་ཇི་ལྟར་བྱ་ཞེ་ན་དེའི་ཕྱིར་ལག་པ་དག་དང་རྐང་པ་དག་བཀྲུ་བ་དང་སོ་ཤིང་དོར་བ་དང་།",
    "ཁྲུས་བྱས་པ་ནི་བཅུ་པ་ཡིན་ནོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "བཅུ་པ་བྱ་བ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ལྷགས་པ་བསྐྱབ་པའི་ཕྱིར་དེའི་སྟེང་དུ་ཁུང་བུའི་སྦུབས་དབུབ་པར་བྱ་བའོ།",
    "རླངས་པ་ཕྱིར་དབྱུད་པའི་ཕྱིར་ཁང་བའི་སྦུབས་དེ་ལ་སྐར་ཁུང་གདོད་པར་བྱ་བའོ།",
    "གྲང་བ་བསྐྱབ་པའི་ཕྱིར་ཁོ་ནར་ཁང་བུའི་སྦུབས་དེའི་སྟེང་དུ་གཡོགས་པར་བྱ་བའོ།",
    "ཁང་བུའི་སྦུད་བ་དེ་ལས་ཆུའི་ཡུར་བ་གདོད་པར་བྱ་བའོ།",
    "འདིར་གཞུང་ནི་དེས་རྩ་བའི་ཐོག་ཡལ་དོར་བར་མི་བྱ་ཞིང་བྱི་དོར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ད་ནི་བྱ་བའི་སྐབས་བརྗོད་པར་བྱ་སྟེ།",
    "རྣམ་པར་འབྱེད་པ་ལས།",
    "འདིར་མཚན་མ་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་ཕྱིར་ལྷུང་བཟེད་ལ་སོགས་པ་ལ་མངོན་མཚན་བྱེད་པ་གང་ཡིན་པ་དེ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདིར་གཞུང་ནི་མཚན་མ་བྱེད་པ་ལ་ལྷུང་བ་མེད་དོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ད་ནི་ཀློག་པར་བྱེད་པའི་སྐབས་བརྗོད་པར་བྱ་སྟེ།",
    "རིམ་པ་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་གཅིག་ཏུ་བྱས་ཏེ་ཀློག་པའོ།",
    "དེ་དག་ལ་ཁོ་ན་ལྟ་བུར་བྱས་པར་གྱུར་ཅིག་སྙམ་པ་སྟེ།",
    "འདིར་བྱེ་བྲག་ཏུ་མ་སྨོས་པས་ཚིག་དང་དོན་གཉི་གར་ཤེས་པར་བྱའོ།",
    "གསུངས་པ་ཡིན་ནོ།",
    "ཅི་ཐམས་ཅད་ཀྱིས་བྱེ་བྲག་མེད་པར་རམ་ཞེ་ན་དེའི་ཕྱིར།",
    "གཞན་ལ་ལེགས་པར་གོ་བར་བྱེད་ནུས་ཤིང་ངོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གསང་སྔགས་ཕན་འདོགས་པར་བྱེད་པ་དག་གཟུང་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེ་ལ་གནོད་པར་བྱེད་པ་གང་ཡིན་པ་དེ་དག་ནི་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཀླག་པར་མི་བྱ་སྦྱར་བར་མི་བྱའོ།",
    "ཕན་འདོགས་པ་གང་ཡིན་པ་དེ་དག་ནི་དགེ་སློང་རྣམས་ཀྱིས་བཀླག་པར་བྱ་སྦྱར་བར་བྱའོ་ཞེས་གསུངས་པ་དང་།",
    "བཟོ་རྗེས་སུ་བསྒྲུབ་པ་དང་བསླབ་པ་དང་དེའི་སྣོད་ཉེ་བར་གཞག་པར་མི་བྱ་སྟེ་མཚོན་གྱི་ཤུབས་དང་ཁབ་རལ་དང་རམ་ཕྱིས་ནི་མ་གཏོགས་སོ་ཞེས་བྱ་བ་ནི།",
    "གཞན་ལ་བཟོ་བསླབ་པར་མི་བྱ་བ་དང་།",
    "བཟོ་སྤྱད་ཀྱི་སྣོད་ཉེ་བར་གཞག་པར་མི་བྱའོ།",
    "སྔོན་བཟོས་མཁན་ལས་རབ་ཏུ་བྱུང་བ་ཡིན་ན་ཁབ་རལ་ནི་མ་གཏོགས་སོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་མུ་གཅིག་པ་དག་ལའོ།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་བྱུང་ན་བསྒོས་ཏེ་འགྲོ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་མཚན་མཐུན་པ་དབེན་པའི་ཕྱོགས་སུ་འདྲེག་མཁན་གྱི་བྱ་བ་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "འདྲི་བར་རྩོམ་པ་ལ་ནི་ཉེས་པར་འགྱུར་ལ།",
    "ད་ནི་ཤི་བའི་སྐབས་དང་གཞག་པའི་སྐབས་སུ་གང་བྱ་བ་དེ་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་བསྲེག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་རོ་དེའོ།",
    "ཅི་གདོན་མི་ཟ་བར་བསྲེག་པར་བྱ་བ་ཁོ་ན་ཡིན་ནམ་ཞེ་ན་དེའི་ཕྱིར།",
    "སོ་སོར་བརྟགས་པས་ངེས་པར་བྱའོ་ཞེས་བྱ་བ་ནི་དེ་ལ་སྲོག་ཆགས་ཡོད་དམ་མེད་པའོ།",
    "ཡང་ན་ས་བརྐོས་པར་གཞུག་པ་འམ།",
    "མཆོད་རྟེན་ནི་རྣམ་པ་གཉིས་ཏེ་གཙང་ཁང་ཅན་ཉིད་དང་ཀ་བ་ལྟ་བུ་ཉིད་དོ་ཞེས་བྱ་བ་ལ་གཙང་ཁང་ཅན་ཉིད་ཅེས་བྱ་བ་ནི།",
    "བུམ་པའི་ཕྱོགས་ན་གཙང་ཁང་ཕྱུར་བུ་དང་ལྡན་པ་ཉིད་དོ།",
    "གཙང་ཁང་མེད་པ་ཀ་བའི་རྣམ་པ་ལྟ་བུར་བསྒྲེང་བ་ཉིད་དོ།",
    "དེ་ཡང་བསེ་རུ་ལྟ་བུའི་ཕྱིར་གསུངས་པ་ཡིན་གྱི།",
    "རྒྱུན་དུ་ཞུགས་པའི་ནི་གདུགས་གཉིས་སོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་དེ་བཞིན་གཤེགས་པའི་ཕྱོགས་ཀྱི་ཡུལ་ཉིད་དུ་གང་དེ་དག་གནས་པར་གྱུར་པའི་ཕྱོགས་དེར་འཁོར་དུ་བྱའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དཔེར་ན་མཆོག་ཟུང་གཅིག་ནི་བཅོམ་ལྡན་འདས་ཀྱི་མངོན་སུམ་ན་གནས་པར་གྱུར་པས།",
    "དེ་ཉིད་ཀྱི་མཆོད་རྟེན་ནི་དེ་བཞིན་གཤེགས་པའི་མཆོད་རྟེན་གྱི་སྤྱན་སྔར་བརྩིག་པར་བྱ་བ་ལ་སོགས་པ་ལྟ་བུའོ།",
    "འདི་ལ་རྒན་རིམས་སུ་མ་བྱ་བར་མ་བྱའི་ཞེས་བྱ་བ་ནི་མཆོད་རྟེན་གྱི་ཡུལ་འདི་ལ་ཉན་ཐོས་ཆེན་པོ་རྣམས་ཀྱི་མཆོད་རྟེན་རྒན་རིམས་སུ་བརྩིག་པར་བྱ་སྟེ།",
    "དེ་ལས་ཞིག་རལ་བཅོས་པའི་ཕྱིར་གཞག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "མཆོད་རྟེན་ལ་ཕུལ་བའི་རྫས་དེ་ལས་མཆོད་རྟེན་དེ་ཉིད་ཀྱི་ཞིག་རལ་བཅོས་པའི་ཕྱིར་གཞག་པར་ཡང་བྱ་བའོ།",
    "འདིར་གཞུང་ནི་དེ་ལ་དབྱིག་དང་གསེར་གང་ཡིན་པ་དེ་དག་མཆོད་རྟེན་དེ་ཉིད་ཞིག་རལ་དུ་གྱུར་པ་བཅོས་པའི་ཕྱིར་གཞག་པར་བྱའོ།",
    "རྩིག་པ་དག་རྒྱ་སྐྱེགས་ཀྱིས་བྲིའོ་ཞེས་བྱ་བ་ནི་ཁྲ་བོ་ལ་སོགས་པར་བྱུག་པའོ།",
    "མཆོད་རྟེན་ལ་གོས་ལ་སོགས་པ་དཔྱད་བའི་ཕྱིར་གཟེར་བུ་གདབ་པར་མི་བྱ་བའོ།",
    "མཆོད་རྟེན་གྱི་སྟེང་དུ་མར་མེ་གཟུགས་པར་མི་བྱའོ།",
    "འཇིག་པར་བྱེད་པ་བཟློག་པའི་ཕྱིར་སྦུབས་གཡོགས་ཀྱིས་གཡོགས་སོ་ཞེས་བྱ་བ་ནི།",
    "ཆར་པ་ལ་སོགས་པ་མཆོད་རྟེན་འཇིག་པར་བྱེད་པ་བཟློག་པའི་ཕྱིར་ངོས་ནས་སྐྱོར་པའི་སྦུབས་དང་སྟང་ནས་གཡོགས་པའི་གཡོགས་མས་གཡོགས་པར་བྱ་བ་སྟེ།",
