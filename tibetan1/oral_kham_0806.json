    "ཐམས་ཅད་གོང་ནས་གནང་བ་ཞིག་ཡོད་འདུག་ཅིང་།",
    "དེ་མིན་ལྷ་ཁང་ན་ཡོད་པའི་ཚའོ་དེ་བྱེད་དུ་བཅུག་པས་ཡོང་འདུག་ཅིང་།",
    "དེར་ད་དུང་དབྱིན་སྐད་དང་བོད་སྐད་ཁྲལ་ཁྲུལ་ཤེས་པའི་མི་ཞིག་འདུག་པ་དེའི་རོགས་རམ་དང་།",
    "དེར་འཕྲེད་ཞེང་ལ་ཕི་ཊི་བཅོ་ལྔ་ཙམ་ཡོད་པའི་གུར་ཕུབས་ཏེ་གང་སར་རྐུབ་སྟེགས་སྒོར་དབྱིབས་སུ་བསྒྲིགས་འདུག།",
    "ཐག་རིང་ནས་འབྲུག་སྒྲ་གྲགས་བཞིན་འདུག།",
    "ཕྱི་ལོ་༡༩༧༨ དང་༡༩༨༡ ལོར་ང་རང་རྒྱ་གར་དུ་བསྐྱོད་དེ།",
    "རང་ལོ་ལྔའི་ཐོག་ང་རང་ཡང་སྲིད་དམིགས་བསལ་ཞིག་ཏུ་ངོས་འཛིན་བྱུང་རྗེས།",
    "གཞན་དེའི་ནང་ང་རང་སྡོད་ཀྱི་ཡོད་ཅིང་།",
    "འོན་ཀྱང་ད་ཆ་ང་རང་གྱོད་པ་ཧ་ཅང་སྐྱེས་ཤིང་།",
    "ཐ་ན་འགྲུལ་བཞུད་ཀྱི་ཆེད་དུ་རྟ་ཡང་ཉོ་སྒྲུབ་གནང་ཚར་འདུག།",
    "དུས་ད་ལྟ་བར་རང་ཉིད་ལ་ནུས་པ་མེད་པས་མི་གཞན་པའི་དཀོར་རྫས་མང་པོ་བསགས་འདུག་སྙམ་ཞིང་།",
    "གལ་ཏེ་ཁྱེད་རང་སྐྱེ་བོ་ཕལ་བ་ཞིག་ཡིན་ན།",
    "གལ་ཏེ་ཁོ་རང་དང་ལྷན་དུ་བསྐྱོད་འདོད་ཡོད་ན།",
    "ངའི་སྣང་བར་མི་ཞིག་མདུན་ལ་ཤར་ཏེ་ཁོ་རང་ངའི་གཅེན་པོ་ཡིན་ཚུལ་བརྗོད་ཐོག།",
    "ལམ་སེང་ཁྱིམ་ལ་ལོག་འགྲོ་དགོས་ལུགས་བརྗོད་ཀྱི་འདུག།",
    "མི་དེར་རྟ་དཀར་པོ་ཞིག་འདུག་ཅིང་།",
    "དེ་བཞིན་ཟས་རིགས་ཀྱང་གང་འདོད་འདེམས་སྒྲུག་བྱ་རྒྱུ་འདུག།",
    "མ་གཞི་རྨ་དྲག་སྐྱེད་བྱུང་ན་ཡང་ངས་ལོ་གཅིག་ཙམ་རིང་གོམ་པ་ཡག་པོ་སྤོ་ཐུབ་ཀྱི་མི་འདུག།",
    "དེ་ཡང་ང་རང་གཅིག་པུ་ཡིན་ཞིང་།",
    "དེར་ང་རང་གུ་རུ་པདྨ་སཾ་བྷ་བས་སྒོམ་སྒྲུབ་གནང་སའི་ཕུག་པར་བསྐྱོད་འདོད་ཡོད།",
    "ང་རང་སྒྲུབ་ཕུག་དེར་སྒོམ་སྒྲུབ་བྱེད་སྐབས།",
    "དུས་ཡུན་གང་ཙམ་ནས་ཁོས་ང་ལ་མེ་ཤིང་ཟད་དེ་ལྷག་མི་འདུག་ཟེར་གྱི་འདུག།",
    "མཚོ་དེའི་དཀྱིལ་དུ་རི་བོ་ཡོད་པའི་གླིང་ཕྲན་ཞིག་འདུག་ཅིང་།",
    "རི་དེའི་ནང་བྲག་ཕུག་ཅིག་འདུག་པས་ངས་དེའི་ནང་ལོ་གསུམ་ཟླ་གསུམ་ཞག་གསུམ་རིང་སྒོམ་སྒྲུབ་བྱ་རྒྱུའི་འཆར་གཞི་བཏིང་པ་ཡིན།",
    "ལོ་གཅིག་སྒོམ་སྒྲུབ་བྱས་རྗེས་ང་རང་དཀའ་ངལ་ཁ་ཤས་ནང་ལྷུང་བྱུང་།",
    "དེ་ང་སྡོད་སའི་བྲག་ཕུག་ནས་མཚོའི་ཕ་རོལ་གྱི་ཆུ་ཁར་ཟུག་འདུག།",
    "འཁྱག་པ་ལས་གོས་དཀར་པོ་ལྟར་འོད་འཚེར་གྱི་འདུག།",
    "དགུན་ཁ་ཤར་དུས་ང་རང་སྒོམ་སྒྲུབ་མཇུག་སྐྱོང་བྱེད་པར་སྒྲུབ་ཕུག་ཏུ་བསྐྱོད་ཅིང་།",
    "དེ་དུས་དགུན་ཁ་ཡིན་སྟབས་མཚོའི་ཕར་ངོས་སུ་འཁྱག་པའི་ཐོག་ནས་བསྐྱོད་ཐུབ་ཀྱི་འདུག།",
    "ང་རང་གཉིད་ཡག་པོ་ཁུག་མ་ཐུབ་ལ།",
    "རོ་དེ་རྐང་པ་གཅིག་བཀྱག་སྟེ་ཉལ་སྟབས་སུ་འདུག།",
    "དེའི་སྟེང་སྡོད་རྒྱུར་ལས་སླ་པོ་མི་འདུག།",
    "ཕུང་པོའི་ཉེ་འཁོར་དུ་བྱ་རྒོད་འཁོར་ན་ཡང་རོ་ལ་ཐོགས་གཏུགས་བྱེད་ཀྱི་མི་འདུག།",
    "ཆོ་ག་དེ་ཚར་ནའང་བྱ་རྒོད་ཀྱིས་ད་དུང་རོ་ལ་ཐོགས་གཏུགས་བྱེད་ཀྱི་མི་འདུག།",
    "མི་བཅོ་ལྔར་འཆི་སྐྱོན་བྱུང་འདུག།",
    "ཅི་ཡིན་འདི་ཡིན་མ་ཤེས་གོང་ངེད་གཉིས་རལ་གྲི་ཐོགས་པའི་མི་བདུན་གྱིས་བསྐོར་ཚར་འདུག།",
    "དོན་དངོས་སུ་ཇག་ཚོགས་དེའི་ནང་ཇག་པ་དྲུག་ཅུ་ཡོད་འདུག་པ་དེས།",
    "རྒྱ་གར་ལ་འགྲོ་རྒྱུའི་བསམ་ཚུལ་དེ་ད་ལྟ་ཡག་པོ་བབས་ཀྱི་མི་འདུག་ཅེས་གསུངས་བྱུང་བར་བརྟེན།",
    "གལ་ཏེ་ཁྱེད་རང་བོད་ནས་འགྲོ་རྩིས་ཡོད་ན་རྒྱ་གར་ལས་བལ་ཡུལ་ལ་བསྐྱོད་དགོས་གསུངས།",
    "ང་རང་དེར་གནས་སྐབས་ཙམ་ལས་གཏན་སྡོད་བྱེད་ཀྱི་མེད་སྟབས།",
    "གལ་ཏེ་ཁྱེད་རང་ལ་འཚོ་བའི་རོགས་དངུལ་དགོས་ན།",
    "ང་ལ་ཞེད་སྣང་སློང་ཐབས་བྱེད་ཀྱི་འདུག་ཁོ་ལ་འུར་རྡོ་ཞིག་འདུག་པ་དེས་ང་ལ་གཞུ་རྩིས་བྱེད་ཀྱི་འདུག་པར་བརྟེན།",
    "དེ་ནུབ་ང་རང་གཉིད་སྐྱིད་པོ་ཁུག་བྱུང་།",
    "མེས་འཚིག་པ་ལྟ་བུའི་ཚོར་སྣང་བྱུང་འདུག།",
    "ངས་ཁྱེད་རང་སྔགས་པ་རྟོགས་པ་མཐོ་པོ་དེ་འདྲར་སླེབས་པ་ཞིག་ཡིན་པ་ཤེས་མ་བྱུང་།",
    "དེར་བརྟེན་ང་རང་ཡུལ་ཕྱོགས་གཞན་ལ་བསྐྱོད་འདོད་བྱུང་།",
    "ང་རང་དེར་འགྲོ་འདོད་བྱུང་།",
    "ང་རང་དངོས་གནས་ལོ་དགུའི་རིང་སྡོད་འདོད་མེད་ན་ཡང་དེ་བཞིན་བྱ་རྒྱུར་ཁས་བླངས་པ་ཡིན།",
    "ཐེངས་ཤིག་ཁོ་པས་རིམ་གྲོ་ཡ་མ་ཟུང་ཞིག་བསྒྲུབ་པ་ངས་དྲན་སོས་ཀྱི་འདུག་པ་སྟེ།",
    "ཚང་མ་རློན་པ་རློན་རྐྱང་ཡིན་ལ་ང་རང་ཉམས་ཐག་ཐག་ཏུ་གནས།",
    "དུས་སྐབས་འདིའི་གཡས་གཡོན་ལ་ང་རང་སེམས་གཏན་ནས་སྐྱིད་པོ་མ་བྱུང་།",
    "ང་རང་དྷ་རམ་ས་ལར་སྤོས་ཏེ་ང་དང་བཟའ་ཟླ་གཉིས་ཁག་ཁག་བྱས།",
    "ང་རང་ཡང་མཇལ་བཅར་བའི་ཁོངས་འབོད་འགུག་གནང་བྱུང་།",
    "དམིགས་བསལ་གདོན་འདྲེ་དེ་མངོན་མང་ཤོས་ཡིན་པའི་ཉལ་ཁང་ནང་སྡོད་མཁན་སློབ་ཕྲུག་ཚོར་འཇིགས་སྣང་ཆེན་པོ་བྱུང་འདུག།",
    "བྱ་བ་འདི་ཀུན་ལེགས་པར་གྲུབ་པར་ཁོང་ཐུགས་ཧ་ཅང་མཉེས་པོ་བྱུང་འདུག།",
    "དོན་དམ་གྱི་བསམ་ཚུལ་ནི་ང་རང་འཆི་བའི་རྗེས་སུའང་མུ་མཐུད་དེ་རྒྱུན་འཛིན་དགོས་པ་དེ་ཡིན།",
    "ངས་དེ་ལ་ཆེ་ཆུང་ལ་མ་ལྟོས་པའི་རོགས་རམ་བྱེད་དགོས་འདུག་སྙམ་ན།",
    "སེམས་ཀྱི་རྟ་ཕོས་ཁྱེད་རང་གང་ས་གང་ལ་འཁྲིད་ཀྱི་ཡོད།",
    "གལ་ཏེ་ཁྱེད་རང་ལ་ལས་བྲེལ་ཧ་ཅང་ཆེན་པོ་ཡོད་ན།",
