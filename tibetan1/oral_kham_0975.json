    "དེ་ན་བ་ལྟར་བཅོས་ནས་འདུག་གོ།",
    "ཆུང་མ་སྐྱེས་པ་གཞན་དང་ལྷན་ཅིག་འདུག་ཅིང་ས་འཛིན་པ་དེའི་ལག་པ་འཕྱང་བ་མཐོང་ནས།",
    "དེ་རྟ་ལས་བབས་ནས་ཤིང་དྲུང་ཞིག་ཏུ་འདུག་གོ།",
    "དེས་མར་མེ་བཟུང་ནས་འདུག་པ་དང་།",
    "མ་འོངས་ན་ཆད་པ་ཆེར་གཅད་དོ་ཞེས་བྱས་པས་གསོས་པ་སྐྲག་ནས་དེ་གཟུང་བའི་ཐབས་སེམས་ཤིང་འདུག་པ་དང་།",
    "དེ་རྒྱལ་པོའི་སྒོར་འདུག་ནས།",
    "འདི་ན་སུ་འདུག་དེད་དཔོན་གྱི་ཆུང་མའོ།",
    "འོ་ན་མལ་འདིར་འདུག་ཅིག་དེ་དེར་འདུག་པ་དང་།",
    "རྒྱལ་པོ་དང་ལྷན་ཅིག་ཉིན་ཞག་བདུན་གྱི་བར་དུ་འདུག་ཅིང་།",
    "ཇི་ལྟར་ར་བའི་དྲུང་ན་ཁྱི་འདུག་ཅེས་བརྟགས་པས་ནོར་ལྷས་བྱིན་གྱིས་ཐབས་ཀྱིས་བསད་པར་ཤེས་ནས་ཁྲོས་ཏེ་དེ་རྒྱ་སྐྱེགས་ཀྱི་ཁང་བར་བཅུག་ནས་བསྲེགས་སོ།",
    "སྔོན་རི་འོར་ཞིག་ན་བྲམ་ཟེ་མདུན་ན་འདོན་ཞིག་འདུག་གོ།",
    "དེས་ཁྱིམ་ན་འདུག་པ་རིལ་ལ་སྨྲས་སོ་སྙམ་ནས།",
    "ཉ་དང་རུས་སྦལ་དང་སྦལ་བ་མང་བོ་གནས་པ་དེ་ན་ཆུ་སྐྱར་ཞིག་ཉ་ཟ་ཞིང་འདུག་པ་ལས།",
    "རྒྱལ་པོ་དེ་ཞོ་ལ་དགའ་བས་ཞི་བ་ཞོའི་ཕོར་བ་ཐོགས་ཏེ་རྒྱལ་པོ་ཟན་ཟ་བའི་མདུན་ན་འདུག་པ་དང་།",
    "སྨད་འཚོང་གཅིག་པུ་འདུག་པ་དང་།",
    "ཉེ་དུའི་ཁྱིམ་འདུག་ཆུང་མ་བསྐྲད།",
    "དེས་དེ་དག་དང་ལྷན་ཅིག་མཆོད་རྟེན་ལ་ཕྱག་བཙལ་ནས་ཀླུའི་ཚོགས་ཀྱི་གུད་ལ་གདན་བཤམས་པ་ལ་འདུག་གོ་།",
    "གསུམ་པ་ནི་ཐག་རིང་བོར་འདུག་སྟེ་ལུང་ནོད།",
    "གསུམ་པ་ནི་ཐག་རིང་བོར་འདུག་སྟེ་ལུང་ནོད་དོ།",
    "བདག་དགྲ་བོ་རྣམས་ཀྱི་ནང་དུ་འདུག་པ་ལྟ་སྙམ་ནས་རིད་པར་གྱུར་ཏོ།",
    "ཁོ་བོ་དགྲ་བོ་རྣམས་ཀྱི་ནང་ན་འདུག་སྟེ།",
    "དྲོ་ཡོལ་བ་ན་གཙུག་ལག་ཁང་དེ་ཡང་སྔར་བཞིན་བྱུང་ཞིང་དགེ་སློང་དེ་དག་ཀྱང་སྤྱོད་ལམ་ཞི་བས་འདུག་གོ།",
    "སྡོད་ཅིག་ཅེས་སྨྲས་ནས་འདུག་གོ།",
    "འདི་ན་འདུག་བཞིན་དུ་དགའ་བྱེད་མཐོང་བར་གདོན་མི་ཟའོ།",
    "དེའི་རིན་གདའ་བར་མི་བྱའོ།",
    "བརྒྱ་བྱིན་གྱིས་ནམ་མཁའ་ལ་འདུག་བཞིན་དུ་ལྷའི་བདུད་རྩིས་ལྷུང་བཟེད་བཀང་བ་དང་།",
    "རྩྭ་བམ་ལ་འདུག་པར་བྱའོ།",
    "རྒན་རིམ་དུ་འདུག་ཅེས་བཀའ་སྩལ་པས།",
    "དགེ་སློང་མ་རྣམས་རྒན་རིམ་དུ་འདུག་པས་ཅ་ཅོར་གྱུར་པ་དེ་གསོལ་བས།",
    "ཟླ་བ་གསུམ་དུ་ངའི་དྲུང་དུ་སུའང་མ་འོང་ཞིག་འོངས་ན་གསད་དོ་ཞེས་དྲིལ་བསྒྲགས་ནས་ཟླ་བ་གསུམ་དུ་མི་སྣང་བའི་ཕྱོགས་ན་འདུག་གོ།",
    "མགོན་མེད་ཟས་སྦྱིན་གྱིས་ངོས་ནས་འབྲས་ས་ལུ་སྨིན་པ་ཤིང་རྟ་ལྔ་བརྒྱ་ཙམ་བཀང་སྟེ་བསྐུར་བས་བདུད་སྡིག་ཅན་གྱིས་ཀུན་དགའ་བོར་སྤྲུལ་ནས་ཤིང་རྟ་ལྔ་བརྒྱ་བོ་རྣམས་ཀྱི་མདུན་དུ་འདུག་སྟེ།",
    "རྒྱལ་པོ་མེས་བྱིན་བཀྲ་ཤིས་འོང་བ་ལ་སྡོད་ཅིང་འདུག་གོ།",
    "འོད་ལྡན་དེ་ན་འདུག་པ་དང་ཀུན་དགའ་བོས།",
    "མཛོད་ན་འདུག་གོ།",
    "དེ་དག་མི་དགའ་ནས་མཆི་མས་བརྣངས་ཏེ་འདུག་པ་གསོལ་བས།",
    "དྲན་པ་ཉེ་བར་བཞག་པ་རྣམས་སྤྱོད་ལམ་ལས་མ་འཁྲུགས་པར་དེ་ཉིད་ན་འདུག་གོ།",
    "རྣམ་པ་དེ་གཉིས་མི་གདའ་ན།",
    "ཁ་ཅིག་ནི་ཏིལ་གྱི་མར་འཁུར་འཚལ་བ་གདའོ།",
    "གསར་བུ་དག་དུས་ཚོད་ལས་འདས་ནས་ཟིན་ཆད་པ་དེ་གསོལ་བས།",
    "ཤིང་ཤི་རི་ཤ་ཀའི་གཞལ་མེད་ཁང་སྟོང་བར་འདུག་གོ།",
    "དེ་ན་སྟ་གོན་མི་འདུག་ནས་དྲིས་པས།",
    "དེ་དུས་གཞན་ཞིག་ན་སྐྱིལ་ཀྲུང་བཅས་ཏེ་འདུག་པ་དང་།",
    "བསླབ་པ་བྱིན་པ་གསུམ་དང་རང་བཞིན་གནས་པ་གཅིག་དང་།",
    "འདུག་པ་དང་ཉལ་བ་གང་ཁས་ལེན་པ་དེའི་ཕྱིར་བཅོས་བྱེད་དུ་གཞུག་གང་ཡང་ཁས་མི་ལེན་ན་ཆད་པའི་ལས་འོས་པ་ཡིན་པས།",
    "དགའ་བ་ཅན་གྱིས་འབད་རྩོལ་གྱིས་བསྒོམས་པས་དགྲ་བཅོམ་པ་ཟླ་ཐོབ་ནས་ཀྱང་སྔར་བཞིན་ལ་འདུག་ཅིང་།",
    "རྒན་རིམ་བཞིན་འདུག་པར་བྱ་ཞེས་པ།",
    "མ་གྲགས་སོགས་སོ་ ཡང་དགེ་སྐོས་ཀྱིས་གནས་བརྟན་གྱི་མདུན་དུ་འདུག་ནས།",
    "སྒྲ་གཅན་འཛིན་སྒོ་ན་འདུག་པ་དེསདེ་དག་ལྷས་བྱིན་གྱི་རྗེས་སུ་འབྲང་བ་མཐོང་ནས།",
    "ཤཱ་རིའི་བུས་ལུས་གན་རྐྱལ་གྱིས་སྡུར་བའི་སྒྲ་འབྱིན་ཅིང་འདུག་པར་བྱིན་གྱིས་བརླབས་སོ།",
    "སེང་གེ་མ་གཏོགས་རྐང་བཞི་བ་ཐམས་ཅད་ཀྱིས་ཡོངས་སུ་བསྐོར་ནས་འདུག་པ་སྨྲས་པས།",
    "གླང་བོ་ཆེ་དེས་ཆུ་ནང་དུ་ནུབ་ནས་འདུག་པ་དང་།",
    "གླང་བོ་ཆེ་དེ་རིང་ཞིག་འདུག་ནས་ལངས་ཏེ་བལྟས་པས་མ་མཐོང་ནས།",
    "རྒན་རིམ་ལ་ཕྱག་བྱས་ནས་ཙོག་ཙོག་པུར་འདུག་སྟེ་སྔར་ལྟར་སྨྲའོ།",
    "བརྟགས་ཤིང་བརྟགས་པའི་ཚིག་དུས་སུ་སྨྲའོ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་སྦྱིན་པ་ཞེས་བྱ་བ་རྣམ་ཐོས་ཀྱི་བུ་ལ་ནོར་གྱིས་འགྲན་པ་ཞིག་འདུག་པའི་ཆུང་མ་ལ་བུ་བཙས་ནས།",
    "དེ་ནས་སྟོན་པས་ཟས་སྦྱིན་གཙུག་ལག་ཁང་དུ་ཁྲིད་དེ་སྟན་ལ་འདུག་ནས།",
    "ཡུད་ཙམ་ཞིག་མི་སྨྲ་བར་འདུག་པ་ནི།",
    "ཕྱོགས་གཞན་དུ་འདུག་ལ་ཆུ་སྦྲེངས་ཤིག་དེས་ཕྱོགས་གཞན་ཞིག་ཏུ་འདུག་ནས་ཆུ་སྦྲེངས་པ་དང་།",
    "འདིར་འདུག་ལ་རྙེད་པ་ཁོ་བོ་ལ་བྱིན་ཅིག་དེ་དེར་གནས་ནས་ཕྱག་བདར་དང་བྱུག་པ་མ་བྱས་སོ།",
