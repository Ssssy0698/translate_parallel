    "གཞན་སྟོང་རང་སྟོང་འཛིན་པའི་དམིགས་གཏད་བྲལ།",
    "ལན་གཅིག་རྨི་ལམ་ཟིན་ཙ་ན།",
    "མ་བཟླས་པ་ལ་བཟླས་སོ་ཞེས་སྒྲོ་འདོགས་དང་འཁང་རང་ཁོ་ན་བྱེད།",
    "སྤྱོད་ལམ་རྣམ་བཞི་ཐམས་ཅད་དུའང་རང་ལུས་ཡི་དམ་དང་མི་འབྲལ།",
    "ཡིན་མིན་ཐེ་ཚོམ་མེད་པ་ཉམས་ལེན་སྐྱོང་བདེ་ཙམ་འདུག་པས།",
    "ད་ནི་བྱར་མེད་ཅོག་གེར་འདུག་པ་དམ་བཅའ་རང་ཡིན་ནོ།",
    "དོན་ལ་བྲག་ཅའི་སྒྲ་བཞིན་ཕན་གནོད་སྤུ་ཙམ་ཡང་མི་འདུག།",
    "འཁྲུལ་སྣང་རང་སར་གྲོལ་ལ་བཟང་ངན་སྤུ་ཙམ་ཡང་མི་འདུག།",
    "ནམ་མཁའ་འདི་ལ་བདེ་སྡུག་ཕན་གནོད་ཨེ་འདུག་ཧེ་ཧེ་ཨང་།",
    "འདོད་ལྡན་སྐྱེ་བོའི་སྣང་ངོར་དྲག་ཞན་ཆེན་པོ་རང་འདུག་སྟེ།",
    "ཆགས་བྲལ་རྣལ་འབྱོར་སྣང་ངོར་ལེགས་ཉེས་སྤུ་ཙམ་ཡང་མི་འདུག།",
    "ཐ་མལ་བྱིས་པའི་སྣང་ངོར་ཁྱད་པར་ཆེན་པོ་རང་འདུག་སྟེ།",
    "ང་རང་ཡང་རྔ་ཆེན་དུ་ཨར་པོ་ལ་ཟླ་བ་བཞི་ཙམ་མངགས།",
    "ང་རང་གསད་ནའང་འབུ་མི་གསོད་སྙམ་པའི་བློ་ཐག་ཆོད་པ་བྱུང་།",
    "ཁྱད་པར་ང་རང་ནས་ཀྱེ་རྡོར་དང་མཁའ་སྤྱོད།",
    "ང་རང་ནས་སློབ་སྟོན་དང་འཕོ་ལུང་ངོ་སྤྲོད་རྣམས་གང་དྲག་དང་།",
    "འགྲོ་འདུག་ཟ་ཉལ་སྤྱོད་ལམ་ཐམས་ཅད་དུ།",
    "བསྟན་པ་སླར་དར་གསུངས་པ་ཞིག་དང་ནུབ་ཕྱོགས་ཀྱི་ནམ་མཁའ་ཐམས་ཅད་ཡིག་འབྲུ་ཆེན་པོས་ཁེངས་འདུག་པ་རྣམས་བཀླགས་པས།",
    "ནམ་མཁའ་སྐྱེ་བ་མེད་ཟེར་བ་སོགས་འདུག་པ་དང་།",
    "ཡེ་ཤེས་རྟོག་པའི་ངོ་བོར་ཤེས་ཙ་ན།",
    "ལྷ་ཉིད་ཕུང་ཁམས་ངོ་བོར་ཤེས་ཙ་ན།",
    "ཡེ་ཤེས་དུག་ལྔའི་ངོ་བོར་ཤེས་ཙ་ན།",
    "ཅིར་སྣང་སྐུ་དང་ཡེ་ཤེས་ཤར་ཙ་ན།",
    "སྐུ་དང་ཡེ་ཤེས་རང་སྣང་ཤེས་ཙ་ན།",
    "རང་བྱུང་རིག་པའི་ནོར་བུ་རྙེད་པ་རང་དཀའ་འདུག།",
    "འབྲས་རྒྱུད་ལྷ་དང་རང་རིག་དག་པ་རུ་འཆར་བས།",
    "རྗེས་ཐོབ་འཁྲུལ་སྣང་རང་མཚན་གཟུང་འཛིན་གྱི་ནགས་ཚལ།",
    "གང་དུ་འདུག་ཀྱང་འཁོར་འདས་དབྱེར་མེད་ཀྱི་ཞིང་ཁམས།",
    "ཏིང་འཛིན་སྒྱུ་མའི་བོགས་འདོན་མེད་ཐབས་ནི་མི་འདུག།",
    "མ་བཅོས་གཉུག་མའི་རྒྱན་དུ་མེད་ཐབས་ནི་མི་འདུག།",
    "ནང་རང་བྱུང་རིག་པ་འབྲལ་མེད་ཀྱི་སྐྱོ་གྲོགས།",
    "འོན་ཀྱང་རང་ངོས་ནས་ལྐོག་ཏུ་ཆག་མེད་རྣམ་བཞི་རྒྱས་བསྡུས་ལ་མ་ལྟོས་པའི་མ་ཆོག་པ་དང་།",
    "འོན་ཀྱང་རང་ངོས་ཉམས་ལེན་འདི་ཙམ་སྟེ།",
    "འགྲོ་འདུག་ཟ་ཉལ་སྤྱོད་ལམ་ཐམས་ཅད་དུ།",
    "ཞབས་པད་བསྐལ་བརྒྱར་བརྟན་པའི་སྨོན་འདུག་ཞིག་ཞུའོ།",
    "ཇོ་བོ་ལ་སོགས་པའི་རྟེན་རྣམས་མེད་པར་ཇོ་བོ་བཞུགས་སའི་ཐད་དེར་རྒྱ་རྒན་འདྲ་ཞིག་མགོ་ཀྱོག་ཀྱོག་བྱས་ནས་བསྡད་འདུག་པ་དེ་ནི་གཙུག་ལག་ཁང་སོགས་བསྟན་པ་ལ་ཉམས་ཆག་ཆེན་པོ་འོང་བའི་རྟགས་དང་།",
    "ས་ལམ་བགྲོད་ལ་དཀའ་ཚེགས་མི་འདུག།",
    "ད་ལྟ་ཅུང་ཟད་འཕོ་རན་མི་འདུག་ཅེས་གསུངས་པ་ཞིག་རྨིས་པ་ན་གནས་སྐབས་ཚེ་ཡི་བར་ཆད་ལས་གྲོལ་ཞིང་།",
    "འབྱུང་རུང་རང་ཙམ་དུ་སྨྲས་པ་ཡིན།",
    "སླར་ཚུར་ལོག་པ་ན་མི་མང་པོའི་མགོ་ཐད་དུ་འཕུར་གྱིན་འདུག་པ་ཞིག་བྱུང་།",
    "དེའི་ནུབ་གཉིས་པར་ང་རང་བཙུན་མ་སྤེའུ་ཡི་གཟིམ་ཆུང་དེར་འདུག་པ་ན།",
    "དྲུང་ན་གཉེན་འདུན་ཁ་ཤས་འདུག་པ་ལ་འདི་རྨི་ལམ་ཡིན།",
    "བདེན་མིན་ང་འཕུར་ལ་ལྟོས་ཟེར་ཞིང་ནམ་མཁར་འཕུར་ནས་མདུན་དེར་ཆུ་ཆེན་པོ་ཞིག་འདུག་པར་ཡང་ཐོག་བརྫིས་བྱས་ཏེ་མཆོང་བ་སོགས་བདེན་མེད་ཀྱི་ཉམས་བཟང་པོ་འབྱོངས།",
    "ཡང་ཟླ་བ་དང་དེའི་ཚེས་བཅོ་བརྒྱད་ཀུན་མཁྱེན་ཀློང་ཆེན་པའི་དུས་དྲན་གྱི་ནུབ་ང་རང་ལྷ་ཁང་བྱང་ལྟ་བུ་ཞིག་ན་འདུག་པ་དེར་སྐུ་གཟུགས་མང་པོ་དང་།",
    "རང་ཡུལ་གྱི་ཡུམཁའ་འགྲོའང་ཐོར་ཅོག་སེར་བུན་ནེ་བཞུགས་འདུག་པའི་དབུ་ཐོག་ཏུ་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་བཅས་ནས་ཕར་འཕུར་ཚུར་འཕུར་བྱ་སྐབས།",
    "སེམས་ལ་སྐུ་དེ་རྣམས་ཞིབ་པར་མཇལ་ཏེ་ང་རང་དེར་མཚམས་ཤིག་ཀྱང་སྡོད་རྒྱུ་བྱུང་ན་སྙམ་སླར་ཚུར་ལོག་པ་ན་གཉིད་སད།",
    "ནག་པོ་ཆེན་པོའི་ང་རྒྱལ་གྱིས་མཧཱ་ཀཱ་ལ་འདོན་བཞིན་འཐབས་པས་ང་རང་རྒྱལ་བ་ཞིག་དང་ཡང་ནུབ་ཅིག་རྨི་ལམ་ཟིན་པ་ན་ནུབ་ཕྱོགས་སུ་འཕུར་ཕྱིན་པའི་ཚེ།",
    "བར་སྐབས་སུ་ཉམས་མྱོང་རྒྱུན་འཐོར་བ་དག་ཅུང་ཟད་སོར་ཆུད་པ་ལྟ་བུར་ཡང་འདུག།",
    "སྔོན་ཆད་ང་སྦྲུལ་ལ་ཤིན་ཏུ་འཇིགས་ཀྱང་ད་ནི་སྦྲུལ་ལ་འཇིགས་པ་རྩ་བ་ནས་མི་འདུག་ཟེར་བ་ཞིག་བྱུང་།",
    "ལོའང་ཤིན་ཏུ་ལེགས་པོ་བྱུང་སྐད་འདུག།",
    "རབ་བྱུང་བརྒྱ་ཕྲག་ལྷག་ཙམ་བསྒྲུབས་པ་སོགས་བྱ་བ་དོན་ཅན་འགའ་ཞིག་ཀྱང་བགྲང་རྒྱུ་འདུག་གོ།",
    "གཞན་བྱ་ཐབས་ཅི་ཡང་མི་འདུག་བསམ་ནས།",
    "ཤིན་ཏུ་ལེགས་ཚུལ་གསུངས་འདུག་ཅེས་གསུངས་པ་ལྟར།",
    "དེ་ནི་སྔ་ཉིན་མཁའ་འགྲོ་མ་རྣམས་བསུ་བ་ལ་ཕེབས་འདུག་ཡང་ཡང་གསུངས་པས།",
    "སྤྱན་འབྱེད་འཛུམ་རན་ཙམ་གསང་བ་སྦུབས་སུ་ནུབ་པ་སོགས་ངོ་མཚར་བའི་གཤེགས་ཚུལ་འདུག་པ་རྗེ་བླའི་གསུངས་ལས་ཐོས།",
    "ལོ་དང་ཟླ་བ་ཞག་དང་ཉི་མ་ནི་གཅིག་རྗེས་གཉིས་མཐུད་དུ་ཟད་འགྲོ་བར་འདུག།",
    "ཁོ་ལ་ཆེད་དུ་གཏད་དེ་འཕེན་དགོས་བསམ་སྟེ་གཏོ་དང་ཟློག་པ་ཞིག་ལ་ལྷ་སྔགས་ཏིང་ངེ་འཛིན་གྱི་ནུས་པ་གང་ཡོད་ཀྱིས་བསྒྲུབས་ཏེ་རྡོ་རྗེ་སློབ་དཔོན་གྱི་གོ་སར་འདུག་ནས་ཟོར་ལས་ཡིན་རློམ་གྱིས་བསྟན་པའི་ཆོམ་རྐུན་དུ་འགྱུར་བ་ལས།",
    "དེ་དུས་ཉམས་དང་རྟོགས་པ་འདི་སྐྱེ་སྙམ་པ་གང་ཡང་མི་འདུག་ཀྱང་།",
    "ཟས་གོས་སོགས་འདིར་སྣང་ལ་ཞེན་པ་ཆུང་བ་མངོན་སུམ་དུ་གདའ།",
    "གཞན་དག་ལ་ཕན་པའང་ཤུགས་ཀྱིས་འབྱུང་འདུག་ཅེས་གསུངས་པ་ལྟར།",
    "གཅེར་བུ་དམར་ཧྲེང་ངེར་ལངས་འདུག་པ་ལ།",
    "གཅིན་ཞིག་གཏོང་བ་ཁྲག་དམར་ཆིལ་བ་ཞིག་ཏུ་གྱུར་ནས་གདའ་བས།",
    "ང་རང་ལ་ཁ་ཞིག་ལ་སླེབས་འདུག།",
    "ཕར་ནང་ལུང་པ་ཞིག་ཡོད་པ་ལ་འགྲོ་སྙམ་ནས་ཡོད་ཙ་ན།",
    "ང་རང་དེའི་རྩ་ན་བསྡད་ནས།",
    "ཁྱེད་རང་འདི་ནས་འཕོས་ཏེ་གནས་འདི་དང་འདི་འདྲ་ཞིག་ཏུ་སྐྱེ་འགྲོ་བས།",
    "དེ་དུས་ཀྱང་ཁོ་རང་རྟ་ཞིག་ལ་ཞོན་ནས་མི་འགའ་ཡིས་སྐྱེལ་ནས་འགྲོ་བ་རྨིས།",
    "ང་རང་ཡོན་ཏན་དང་ཉམས་མྱོང་གང་ཐད་ནས་དབུལ་ཚུལ་ལ།",
