    "གནོད་པར་བྱེད་པའི་ངོ་བོའི་ཕྱིར།",
    "འདུ་བྱེད་པ་ཡང་ཐོག་མ་མེད་པ་ཅན་ཡིན་པའི་ཕྱིར་ཐ་སྙད་ཉིད་སད་པར་འགྱུར་བས་དེ་ལྟར་ཐ་སྙད་བྱེད་པ་ཡིན་ནོ།",
    "ཐ་དད་པར་ཉེ་བར་བསྟན་པའི་ངོ་བོ་དེ་ཉིད་དུས་ལ་སོགས་པར་བརྗོད་པ་ལ་སྟོན་པ་ཡིན་ཏེ།",
    "བྱ་བ་ཉིད་དུ་རྣམ་པར་འཇོག།",
    "དུས་ལ་ལྟོས་པར་འགྱུར་བས་ན།",
    "གནས་པ་མེད་པར་འགྱུར་བ་ཡིན།",
    "ཡིན་ན་ཐུག་པ་མེད་པར་འགྱུར།",
    "དུས་ཀྱི་ཡོན་ཏན་གང་ཡིན་པར་བརྗོད་པར་བྱ།",
    "དེས་ན་བདག་ཉིད་ཀྱི་སོ་སོར་ངེས་པ་འགའ་ཞིག་བརྗོད་པར་བྱའོ།",
    "འོན་ཏེ་དོན་རྣམས་གནང་བ་དང་འགོག་པ་ཡིན་ནོ་ཞེ་ན།",
    "གནང་དང་བཀག་པར་ནུས་ན་ནི།",
    "ཁྱད་པར་གཞན་ནི་འདོད་མེད་ཕྱིར།",
    "འདི་ལྟར་དུས་དང་ཡུལ་དང་བདག་དང་ནམ་མཁའ་ཞེས་བྱ་བ་འདི་དག་ནི་རྟག་པ་ཉིད་ལ་སོགས་པར་མཚུངས་པ་ཡིན་ནོ།",
    "འདིས་བྱས་འདིར་ནི་མ་ངེས་ཞེས།",
    "དེའི་ཕྱིར་ནམ་མཁའ་ལ་སོགས་པར་སྨྲ་བ་ནི་མ་ཡིན་པ་ཉིད་དོ།",
    "གལ་ཏེ་གང་ཞིག་གང་དུ་གནས་པར་དམིགས་པ་དེ་དེའི་ཡོན་ཏན་ཡིན་ན།",
    "དེ་ལ་ནི་རྩིག་པ་དང་ཤིང་ལ་སོགས་པ་རྟེན་གཞན་ཡོད་པའི་ཕྱིར་དེར་གནས་པར་རྟོགས་པས་ནམ་མཁའི་ཡོན་ཏན་མ་ཡིན་ནོ་ཞེ་ན།",
    "དེར་གནས་པར་དམིགས་ཀྱང་དེར་གནས་པ་མ་ཡིན་ཏེ།",
    "ནམ་མཁའ་ནི་གནས་པར་བྱེད་པ་ཉིད་ཀྱང་མ་ཡིན་ཏེ།",
    "གང་དུ་སྣང་བ་ཉིད་ཡོད་པ་དེར་ནམ་མཁའ་བཏགས་པའི་ཕྱིར་ནམ་མཁའ་ནི་བརྟགས་པར་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་སྒྲ་ནམ་མཁའི་ཡོན་ཏན་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ལེགས་པར་བརྗོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་དེ་ཡང་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་ན་ནི།",
    "རྟོག་པ་སྔོན་བྱས་བྱེད་པ་ནི།",
    "རྣམ་པར་དཔྱོད་བྱེད་སྐྱེས་བུ་ནི།",
    "འདིར་འདོད་པ་ཙམ་ནི་སྐབས་སུ་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་འདོད་པས་འཇུག་པ་དང་འགལ་བའི་རིགས་པ་བསྟན་པར་རིགས་པ་ཡིན་ནོ།",
    "ཐུག་པ་མེད་པར་བསྟན་པས་ན།",
    "ལོག་པར་རྟོགས་པ་བསལ་བའི་ཕྱིར།",
    "འདིར་ནི་རང་ཉིད་སྒྲ་བྱས་སོ།",
    "བསྟན་བཅོས་ཐམས་ཅད་ནི་ལོག་པར་རྟོགས་པ་བསལ་བའི་ཕྱིར་ཡིན་ཏེ།",
    "དེས་ན་འདིར་ཡང་བསྟན་བཅོས་ལས་མཐོང་བ་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་ལོག་པར་རྟོགས་པ་མེད་པ་ཡིན་ནོ།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་མ་ཡིན་པ་དང་།",
    "ཐུག་པ་མེད་པར་བསྟན་པས་སོ།",
    "གཞུང་ལུགས་ཀྱིས་བྱས་ཁྱད་པར་ནི།",
    "གཞན་གྱིས་བྱས་པ་ནི་མ་ཡིན་པ་དེ།",
    "རབ་འདོད་བརྟགས་པའི་ཁྱད་པར་ནི།",
    "མི་རྟག་པ་ཉིད་ལ་སོགས་པར་དཔྱོད་པ་བྱེད་པ་ནི་གྲུབ་པའི་རང་བཞིན་ལ་བྱེད་པ་ཡིན་ནོ།",
    "མ་གྲུབ་པའི་ཁྱད་པར་བླངས་པས་ཅི་ཞིག་བྱ།",
    "འོན་ཏེ་རྒོལ་བ་དེ་ལྟ་བུ་ཉིད་མི་རྟག་པར་སྒྲུབ་པར་འདོད་དོ་ཞེ་ན།",
    "དེ་ལྟ་མ་ཡིན་ནམ་མཁའི་ཡོན་ཏན་མ་ཡིན་པའི་སྒྲ་ནི་མི་རྟག་སྟེ་བྱས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་ཡང་འགྲུབ་པར་འགྱུར་ལ།",
    "ཅི་ལྟར་འདོད་པའི་དོན་གཞན་ཡང་འགྲུབ་པར་འགྱུར་རོ།",
    "ཅི་སྟེ་གྲུབ་པར་བསྟན་པ་ཡིས།",
    "ཅི་སྟེ་འདི་སྐད་འཆད་པར་བྱེད་དེ།",
    "དེ་ལྟ་མ་ཡིན་ན་དེ་རང་ཉིད་སྨོས་པས་ཁྱད་པར་དུ་བྱས་པས་དོན་གྱི་རིགས་ཅི་ཞིག་འགྲུབ་པར་འགྱུར།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་མ་ཡིན་ནོ་ཞེས་བསྒྲུབ་བྱ་ཉིད་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར་རང་ཉིད་སྨོས་པ་ཡིན་ཏེ།",
    "ཅི་ལྟར་བསྒྲུབ་བྱར་རྟོགས་པར་འགྱུར།",
    "ནམ་མཁའི་ཡོན་ཏན་གྱི་སྒྲ་མི་རྟག་སྟེ་ཞེས་བརྗོད་པའི་ཕྱིར་ན་མི་རྟག་པ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་གྱི་ནམ་མཁའི་ཡོན་ཏན་མ་ཡིན་ནོ་ཞེས་ཇི་ལྟར་ཤེས་ཏེ།",
    "སྒྲ་གང་ཡིན་པ་དེ་ནམ་མཁའི་ཡོན་ཏན་ཡིན་ནམ་འོན་ཏེ་ནམ་མཁའི་ཡོན་ཏན་གྱི་སྒྲ་གང་ཡིན་པ་དེ་མི་རྟག་པ་ཡིན་པར་སྒྲུབ་ཅེས་མི་ཤེས་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྒྲ་མཚུངས་ཀྱང་དེ་ཡང་སྐབས་ཉིད་ལས་རྟོགས་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེས་རྣམ་པར་གཟུང་བའི་དོན་ཡིན་ན་ནི་དེ་མི་འཐད་དོ་ཞེ་ན།",
    "དེ་ལ་རྩོད་པ་མཐོང་བའི་ཕྱིར་དེ་ཡང་ཕྱིས་བསྟན་པར་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པ་འགལ་བའི་དོན་གྱིས་མ་བསལ་བ་ལ་ཕྱོགས་ཡིན་ནོ་ཞེས་ཕྱོགས་ཀྱི་མཚན་ཉིད་མ་ཡིན་ནམ།",
    "ཐམས་ཅད་གཏན་ཚིགས་ནི་ཁྱད་པར་དང་རྗེས་སུ་འགྲོ་བ་མེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "འོན་ཏེ་འདི་ནི་ཕྱོགས་ཀྱི་ཡང་སྐྱོན་ཉིད་དེ་འགྲུབ་པར་མི་རུང་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེའི་སྐྱོན་གྱིས་ཕྱོགས་ཉིད་འགྲུབ་པར་མི་རུང་བའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཕྱོགས་ལ་ནི་སྒྲུབ་པར་མི་རུང་བ་ཉིད་ཀྱི་སྐྱོན་ཡོད་པ་མ་ཡིན་ཏེ།",
    "མི་རུང་ཡིན་ན་མངོན་སུམ་གྱིས་ཀྱང་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "དེ་ནི་སྤྱིའི་ཚུལ་གྱིས་ཕྱོགས་ཡིན་གྱི་ཁྱད་པར་གྱི་ཚུལ་གྱིས་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཚེ་དེས་མ་གྲུབ་པ་ལ་ཤིན་ཏུ་ཡང་མེད་པར་འགྱུར་ཏེ།",
    "དེ་བཞིན་དུ་རྗེས་སུ་དཔག་པའི་ཡུལ་ཡང་མངོན་སུམ་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་ཅི་ལྟར་ཕྱོགས་ལ་མངོན་སུམ་གྱིས་གནོད་པར་འགྱུར།",
    "གནོད་པ་ཞེས་བྱ་བ་དོན་འཇིག་པར་བྱེད་པ་ནི་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་མེད་དོ་ཞེས་ཤེས་པར་བྱེད་པ་ཡིན་ནོ།",
    "མི་དམིགས་པར་གནོད་པར་བྱེད་པའི་ཕྱིར་རྗེས་སུ་དཔག་པས་གནོད་པ་ཉིད་དོ།",
    "འོན་ཀྱང་མེ་ལ་སོགས་པའི་སྤྱི་བསྒྲུབ་པར་བྱ་བ་གང་ཡིན་པ་དེར་དེའི་གསལ་བའི་ཡུལ་ཅན་གྱིས་མངོན་སུམ་མེད་ན་རྗེས་སུ་དཔག་པ་འཇུག་པ་མ་ཡིན་ཏེ།",
    "མེ་ནི་ཚང་བང་ལ་སོགས་པར་མངོན་སུམ་གྱིས་རྟོགས་པ་ཉིད་དོ་ཕྱོགས་མངོན་སུམ་གྱིས་གནོད་པ་བྱ་བ་འདིར་ཡང་དོན་འདི་ཉིད་དོ།",
    "གལ་ཏེ་མངོན་སུམ་རྗེས་སུ་དཔག་པས་གསལ་བར་ཅི་ལྟར་དོགས་པར་འགྱུར་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་སེལ་བར་བྱེད་པ་མ་འབྲེལ་པ་བརྗོད་པ་ཡིན་པས་ན་ཟློག་པར་བྱེད་དོ།",
    "ཡང་ན་མཐོང་བ་དང་རྣམ་པར་བརྟག་པར་བྱ་བའི་དོན་དག་གཅིག་ཏུ་ཞེན་པའི་ཕྱིར་སྐྱོན་མེད་དོ།",
    "ལྟོས་པ་མེད་པར་མ་ཁྱབ་དང་།",
    "ཚིག་ཕྲད་མ་བྱས་ན་ནི་ཡང་མ་གྲུབ་པ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་བསྟན་པར་འགྱུར་ལ།",
    "དེའི་དོན་དུ་རང་ཉིད་སྨོས་པ་དོན་མེད་པར་འགྱུར་ཏེ།",
    "མ་བསལ་བའི་ཚིག་དང་ལྷན་ཅིག་སྨོས་པ་ནི་ལྡོག་པ་འགོག་པར་བྱེད་པའི་ཕྱིར་རོ་ཞེས་བསམ་པ་ཡིན་ནོ།",
    "མ་བསལ་བའི་ཚིག་མེད་པར་ནི་ལྡོག་པ་བསལ་བར་ནུས་པ་མ་ཡིན་ནོ།",
    "བསལ་བ་ཉིད་ཁྱབ་པར་འདོད་པ་ནི་མ་ཡིན་ཏེ།",
    "མ་བསལ་བའི་ཚིག་དང་ལྷན་ཅིག་ཡིན་ན་སྲིད་པར་ག་ལ་འགྱུར།",
    "དེས་ན་གལ་ཏེ་བསྟན་བཅོས་ལས་མཐོང་བའི་དོན་ཡང་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནི།",
    "བསྒྲུབ་པར་བྱ་བ་ཁས་བླངས་པ་ཕྱོགས་ཀྱི་མཚན་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཞེས་བསྒྲུབ་པར་སྔར་ཉིད་བསྟན་ཟིན་པ་ཡང་མ་ཡིན་ནམ།",
    "གཞན་དག་སྨྲས་པ་ནི་ཕྱོགས་ཀྱི་མཚན་ཉིད་བྱས་པ་འདི་ནི་རྣམ་འགྲེལ་བྱེད་པ་ཉིད་ཀྱིས་ཡིན་ནོ།",
    "དེའི་ལན་དང་ཁྱད་པར་བརྗོད་པ་ཡིན་ཏེ།",
    "དེས་ན་འདི་ནི་ཁྱད་པར་བརྗོད་པ་ཡིན་ནོ་ཞེས་སོ།",
    "བསྒྲུབ་པར་བྱ་བར་ཁས་བླངས་པ་ཞེས་བྱ་བས་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་འདོད་པ་དང་།",
    "འོན་ཏེ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་ཞེས་འཆད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "སྒྲུབ་བྱེད་ཉིད་དུ་འདོད་པ་ནི་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པ་མ་ཡིན་ནོ་ཞེ་ན་དེ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་ནི་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་ཡང་འདོད་པ་ཁོ་ནའོ།",
    "འོན་ཏེ་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཁོ་ནར་ཁས་བླངས་པ་ཞེས་ངེས་པར་བཟུང་བ་ཡིན་ན།",
    "དེའི་ཚེ་དེ་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་ཁས་བླངས་བཟློག་པའི་དོན་ཡིན་པའི་ཕྱིར་མ་བརྗོད་ཀྱང་།",
    "འོ་ན་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་ཁས་ལེན་པ་ནི་ཕྱོགས་ཁོ་ནའོ་ཞེ་ན་དེ་ལྟ་ཡིན་ན།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་ཁས་བླངས་པ་ཡང་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་ཁས་བླངས་པ་ཕྱོགས་པ་ཉིད་དུ་གྱུར་པས་ད་ནི་གཉི་ག་མི་སྲིད་པ་མ་ཡིན་ཏེ།",
    "བློས་བྱས་པའི་ཉེ་བ་བསྟན་བཅོས་བྱེད་པའི་འདོད་པ་ལ་ཡང་ཡོད་པའི་ཕྱིར་རོ།",
    "བསལ་བ་བསྒྲུབ་པར་བྱ་བར་ཁས་བླངས་པར་ཡང་འགྱུར་རོ།",
    "གལ་ཏེ་བསལ་བས་ནི་གནོད་པས་བསྒྲུབ་པར་བྱ་བར་ཁས་བླངས་པ་མེད་པའི་ཕྱིར་རོ།",
    "བསྒྲུབ་པར་འོས་པས་ན་བསྒྲུབ་བྱ་ཡིན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེ་ལྟ་ན་ནི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ནི་དམ་བཅས་པའི་ཞེས་བྱ་བ་འདི་ཡང་ཁ་ན་མ་ཐོ་བ་མེད་པར་འགྱུར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པར་འགྱུར་བ་འགལ་བའི་དོན་གྱིས་མ་བསལ་བ་ནི་ཕྱོགས་ཡིན་ནོ་ཞེས་བྱ་བའོ།",
    "རིགས་པའི་སྒོ་ལ་དེ་མེད་པའི་ཕྱིར་ཅི་ལྟར་ལྡོག་པ་བཀག་པར་འགྱུར་ཞེ་ན།",
    "འདོད་པར་འགྱུར་བ་ཞེས་བྱ་བ་ནི་བྱུང་བར་གྱུར་པའི་དུས་བརྗོད་པ་ནས་སྟའི་རྐྱེན་ཉིད་ཡིན་པས་བསྒྲུབ་བྱ་ཉིད་དུ་འདོད་པར་འགྱུར་བ་ལ་མི་འཇུག་པ་ན་དེ་ཉིད་ཀྱིས་དེ་བཟློག་པའི་ཕྱིར་སྐྱོན་མེད་དོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་འདོད་པ་སྨོས་པས་སྒྲུབ་པར་བྱེད་པར་བཀོད་པ་བསལ་བས།",
    "གལ་ཏེ་གཙོ་བོར་འགྱུར་བའི་བྱེད་པ་པོའི་མཐའ་དང་འབྲེལ་པ་མ་ཡིན་ན་ནི་རང་ཉིད་འདོད་པ་ཞེས་བྱ་བས་དུས་གཞན་གཅོད་པར་འགྱུར་བ་ཞིག་ན།",
    "འབྲེལ་པ་ཡིན་པ་དེས་ན་དུས་གཞན་དུ་འདོད་པས་ཡུལ་དུ་བྱས་པ་ཡང་ཕྱོགས་ཉིད་དུ་འགྱུར་རོ།",
    "འདོད་པར་གྱུར་པའི་ཚིག་དག་ལ།",
    "བསྟན་པར་བྱ་བ་ནི་ཕྱོགས་ཡིན་ནོ།",
    "འདོད་པར་གྱུར་པ་ཞེས་བྱེད་པའི་མཐའ་གཙོར་འགྱུར་བ་ཡིན་ཏེ།",
    "དེས་ན་དུས་གཞན་དང་འབྲེལ་པར་འགྱུར་རོ།",
    "དེས་ན་ངེས་པར་བཟུང་བས་དུས་གཞན་དུ་འདོད་པ་གཅོད་པ་ཡིན་ནོ།",
    "འདོད་པར་གྱུར་པའི་ཚེ་གང་དག་ནི་ཡན་ལག་མ་ཡིན་ཏེ།",
    "རིགས་པའི་སྒོར་འདོད་པར་བྱེད་པའི་ཚིག་ལ་ནི་ཡན་ལག་ཉིད་ཡིན་པས་ན།",
    "བསྟན་བཅོས་ཀུན་ལ་ལྟོས་མེད་པར།",
    "བསྟན་བཅོས་གང་འགའ་ཞིག་ཏུ་བདག་ཉིད་གནས་པར་བྱ་བ་དང་།",
    "དེའི་ཕྱིར་བསྟན་བཅོས་མཐའ་དག་ལ་མི་ལྟོས་པར་དེའི་འདོད་པ་བསྒྲུབ་བྱ་ཉིད་དོ།",
    "ཐམས་ཅད་རླག་པར་འགྱུར་བ་ལས།",
    "བུམ་པ་ཁྲོན་པར་ལྷུང་བས་ན།",
    "གལ་ཏེ་སྒྲུབ་པར་བྱེད་པའི་གཏན་ཚིགས་ཡོད་ན་ཅིའི་ཕྱིར་ཕྱོགས་མ་ཡིན།",
    "དེ་སྟེ་མ་ཡིན་ན་དེའི་ཚེ་གཏན་ཚིགས་ཀྱི་ཉེས་པར་འགྱུར་བས།",
    "དེ་ལྟ་ཡིན་ན་སྒྲུབ་པར་བྱེད་པ་དེ་ལ་ཡང་ཡིད་ཆེས་པ་མེད་པར་འགྱུར་རོ།",
    "ཡང་ན་གང་ལ་ཐེ་ཚོམ་བསྐྱེད་པར་ནུས་པ་ཡོད་པ་དེར་གཏན་ཚིགས་ཀྱི་ཡུལ་ཉིད་ཡིན་པར་འགྱུར་ཏེ།",
    "རྗེས་སུ་དཔག་པའི་གནོད་པ་ནི་རྣམ་པ་གསུམ་དུ་བསྟན་པ་བཞི་པ་ནི་མངོན་སུམ་གྱིས་གནོད་པ་ཡིན་པའི་ཕྱིར་གནོད་པ་རྣམ་པ་བཞིར་བསྟན་གྱི་གནོད་པར་བྱེད་པའི་གནོད་བྱེད་རྣམ་པ་གཉིས་ནི་མ་ཡིན་ནོ།",
    "ཕ་རོལ་པོ་ཉེས་པ་ཐམས་ཅད་དང་བྲལ་བ་ནི་ཐམས་ཅད་མཐོང་བ་མ་ཡིན་པས་རྟོགས་པར་མི་ནུས་པའི་ཕྱིར་ཏེ།",
    "ཐ་སྙད་འཆོལ་བས་རྗེས་སུ་དཔག་པ་ལས་ཀྱང་ངེས་པར་ནུས་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཚིག་འདི་འཇུག་པར་མི་འགྱུར་བར།",
    "ངའི་ཚིག་ལས་ནི་ཅུང་ཟད་ཀྱང་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་འདི་བརྗོད་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ནི་བདག་ཉིད་དུ་ཁོ་བོ་ཅག་ངལ་བར་བྱས་ནས་ཏེ།",
    "མ་དཔྱད་པར་བྱས་པ་ཡིན་ནོ།",
    "རྩོད་པའི་དོན་ནི་དངོས་པོ་ལ་གཏན་ལ་ཕེབས་པ་ཡིན་ནོ།",
    "མཚུངས་པར་བསྟན་ཕྱིར་བསྟན་བཅོས་དེའི།",
    "ཅི་སྟེ་འགའ་ཞིག་གྲུབ་པར་ཁས་ལེན་ན།",
    "འགའ་ཡང་ཤེས་པ་མེད་དོ་ཞེས་བརྗོད་པར་བྱ་བར་འགྱུར་རོ།",
    "བསྟན་བཅོས་ཁས་བླངས་སོ་ཞེས་ཅི་ལྟར་རྟོགས་པར་བྱ་ཞེ་ན་འདི་ནི་བདེན་ཏེ་དེ་ཉིད་ཀྱི་ཕྱིར་འདིར་བསྟན་བཅོས་དང་འགལ་བ་ལ་བསལ་བའི་དཔེ་མ་ཡིན་ཏེ་ཕྱོགས་ཙམ་ཞིག་བསྟན་པ་ཡིན་ཏེ།",
    "རྣམ་པ་འདི་ལྟ་བུའི་ཡུལ་ལ་ནི་གདོན་མི་ཟ་བར་བསྟན་བཅོས་ཁས་བླངས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་འདི་ཉིད་བསྟན་བཅོས་དང་འགལ་བ་ལ་བསལ་བའི་དཔེ་ཡིན་ནོ།",
    "གནོད་པར་བྱ་བ་དང་གནོད་པར་བྱེད་པའི་དངོས་པོ་ནི་མ་ཡིན་ནོ།",
    "སྔར་ཉིད་རྣམ་པར་བཟློག་པ་ཡིན།",
    "ཡུལ་གྱི་ཁྱད་པར་བསྟན་པ་ཡིན།",
    "ཕྱིར་ན་ཐ་དད་བྱས་པ་ཡིན།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་གནོད་པར་བྱེད་པར་ཁས་བླངས་པའི་ཕྱིར་ལུང་རྗེས་སུ་དཔག་པ་ལས་ཕ་རོལ་དུ་འགྱུར་བ་མ་ཡིན་ཡང་།",
    "ཡུལ་གྱི་ཁྱད་པར་བསྟན་པའི་ཕྱིར་རྗེས་སུ་དཔག་པ་ལས་ཐ་དད་པར་བྱས་སོ།",
    "རྗེས་སུ་དཔག་པ་ནི་གནོད་པར་བྱེད་པ་ཉིད་ཡིན་ལ་བསྟན་བཅོས་ནི་གེགས་བྱེད་པ་ཉིད་དོ།",
    "ལོགས་ཤིག་བྱས་པ་དོན་མེད་འགྱུར།",
    "དོན་མེད་པའི་ཕྱིར་སྨྲ་བ་པོ་མི་མཁས་པར་འགྱུར་རོ།",
    "ཡུལ་ཐ་དད་པར་མེད་ན་ནི་སོ་སོར་བསྟན་པ་དོན་མེད་དོ་ཞེ་ན།",
    "གལ་ཏེ་དེ་མི་འདོད་ན་ཅི་གནོད་པར་བྱེད་པ་ཡིན་ནམ།",
    "དེས་འདོད་ན་ཡང་གནོད་པར་བྱེད་པར་ཅི་ལྟར་འགྱུར།",
    "སྔར་ཁས་བླངས་པ་ཕྱིས་གཞན་དུ་བྱས་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "བྱས་ན་འགལ་བ་ཅི་ཞིག་ཡོད།",
    "སྐྱེས་བུའི་འདོད་པས་བྱས་པས་ན།",
    "གལ་ཏེ་བརྟགས་པར་མི་འཇུག་ན།",
    "དེ་ནི་ལན་བརྒྱར་བཀྲུས་བྱས་ཀྱང་།",
    "ཆང་བུམ་བཞིན་དུ་གཙང་མི་འགྱུར།",
    "ཁྲུས་བྱས་ཡང་འབྱུང་སྲིད་མ་ཡིན།",
    "དེ་ལྟ་མ་ཡིན་པར་ཁས་ལེན་ན་ནི་རྟོག་པ་སྔོན་དུ་བྱེད་པ་ཅན་དུ་མི་འགྱུར་རོ།",
    "དེའི་ཚེ་རང་བཞིན་གྱི་གཏན་ཚིགས་དངོས་ཉིད་ཡིན་པར་འགྱུར་རོ།",
    "འོན་ཏེ་ཁས་བླངས་པས་བྱས་པ་ཡིན་ན་དེའི་ཚེ།",
    "ཚིག་བཞིན་དུ་ཁས་བླངས་པ་ཉིད་པས་དེ་ཅི་ལྟར་འདི་གནོད་བྱེད་གཞན་ཡིན་པར་འགྱུར།",
    "ཐ་དད་ཕྱིར་འདིར་ལོགས་སུ་བྱས།",
    "གདོན་མི་ཟ་བར་ཁས་བླང་བར་བྱ་བའི་ཕྱིར་ལོགས་ཤིག་ཏུ་བྱས་སོ།",
    "དེས་ན་གཞན་རྟོགས་པར་བྱེད་པ།",
    "ཡང་ན་གྲགས་པ་ནི་བརྗོད་པར་འདོད་པའི་ཡུལ་ཅན་ཡིན་ལ།",
    "ཐ་དད་པར་ནི་བརྗོད་འདོད་པ།",
    "སྐབས་ཉིད་ལ་འཇུག་པར་བྱའོ།",
    "གྲགས་པའི་སྒྲས་བརྗོད་པར་བྱ་བའི་དོན་གཞན་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་མི་མགོའི་ཐོད་པ་མི་གཙང་ངོ་ཞེས་བྱ་བ་ལ་སོགས་པ་དག་ལ་ཡང་འགྱུར་རོ།",
    "འོན་ཏེ་བསྟན་བཅོས་ལས་བརྗོད་པ་གནོད་པར་མི་རིགས་སོ་ཞེ་ན།",
    "ཁྱད་པར་འཕགས་པར་འགྲུབ་པ་ནི་རབ་ཏུ་གྲགས་པ་ཡིན་པས་ན།",
    "དེས་བསྐྱེད་པར་འདོད་པའི་སྒྲས་བརྗོད་པར་བྱ་བ་ཉིད་གཡོ་བ་མེད་པའི་ཕྱིར་ཁྱད་པར་དུ་འཕགས་པ་གྲུབ་པའི་རང་བཞིན་ཉིད་དོ།",
    "ཚད་ཉིད་ཡིན་པར་བཟློག་ཕྱིར་རོ།",
    "འདོད་པའི་སྒྲའི་བརྗོད་པར་བྱ་བ་ཉིད་ནི་དེ་ལྟར་གཡོ་བ་མ་ཡིན་ཏེ།",
    "གནོད་པར་བྱེད་པའི་རྗེས་སུ་དཔག་པར་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ཡང་སྟོན་པར་འགྱུར་རོ།",
    "དོན་ལ་འདོད་པའི་སྒྲའི་བརྗོད་པར་བྱ་བ་ཉིད་སྐྱེས་བུའི་འདོད་པ་ཙམ་དང་རྗེས་སུ་འབྲེལ་པ་འགོག་པའི་རྗེས་སུ་དཔག་པ་ནི་འཇུག་པ་མ་ཡིན་ནོ།",
    "བ་ལང་ཉིད་ལ་སོགས་པ་སྤྱིའི་རང་བཞིན་དུ་བརྟགས་པ་འདོད་པའི་སྒྲས་བརྗོད་པར་བྱ་བ་ནི་དགག་པར་མི་ནུས་སོ།",
    "བརྟགས་པའི་དོན་གྱིས་མགུ་བ་འདོད་པ་ཙམ་གྱིས་བརྟགས་པ་ནི་དགག་པར་ནུས་པ་མ་ཡིན་ན་རིག་པ་ནི་དགག་པར་མི་ནུས་ཏེ།",
    "སྒྲའི་ཉེ་བར་ལེན་པ་དང་འབྲས་བུའི་དངོས་པོར་གྱུར་པ་བརྗོད་པར་བྱ་བ་ཉིད་ནི་དེས་གྲུབ་པའི་ཕྱིར་རོ།",
    "བྱུང་གྱུར་པར་གནས་གསལ་བ་དག།",
    "དེ་ལྟར་ཡང་དེ་ཡང་ཐ་སྙད་བརྟེན་པ་ཞེས་འཆད་པར་འགྱུར་རོ།",
    "དེ་ཡང་དགག་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "བག་ཆགས་དེ་ནི་འདོད་པ་ཙམ་གྱིས་བྱས་པའི་བརྡ་ངེས་པས་ན་སྤྱི་ངེས་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་གདོལ་པ་ལ་སོགས་པའི་རིགས་དང་འདི་ལ་ཕན་ཚུན་རྣམ་པར་དབྱེ་བ་ཅི་ཞིག་ཡོད།",
    "དེ་དག་ཀྱང་བོང་བུ་ལ་སོགས་པའི་རིགས་དག་ལས་ཁྱད་པར་མེད་དོ།",
    "འདི་ལ་ཞོ་དག་ལ་སོགས་པར་ནུས་པ་ཙམ་ཞིག་དགོས་པ་ཡིན།",
    "མི་ཙམ་འབྲེལ་པར་མི་འགྱུར་མིན།",
    "དེས་ན་རིགས་ནི་རྣམ་པར་རིགས་པའི་ཡུལ་ཉིད་དོ།",
    "མངོན་སུམ་ལ་སོགས་པ་ལ་ཡང་གཞལ་བའི་དོན་ཉིད་ཕྱོགས་ལྟར་སྣང་བ་ཞེས་བྱ་བ་དོན་གཞན་གྱིས་གནོད་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེའི་འདོད་པའི་སྒྲའི་བརྗོད་བྱ་བ་ལང་ལ་སོགས་པ་ནི་དགག་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "སྨྱོན་པ་མ་ཡིན་པས་དགག་པར་བྱ་བ་མ་ཡིན་ནོ།",
    "བྱས་པའམ་མ་བྱས་པ་རྣམས་ཀྱི།",
    "མི་མཐུན་པ་དག་གནོད་པར་འགྱུར།",
    "མཐོ་རིས་འདོད་པས་མེའི་སྦྱིན་སྲེག་གྱིས་ཤིག་ཅེས་བྱ་བ་ལ་སོགས་པ་ནི་ཁྱི་ཤ་ཟ་བ་ལ་སོགས་པ་ལ་དགག་པར་མི་ནུས་ཏེ།",
    "ཙམ་གྱི་སྒྲ་ནི་ཁྱད་པར་མེད་པར་གཟུང་བའི་དོན་ཏེ།",
    "ཟན་ཙམ་སྦྱིན་པར་འདོད་དོ་ཞེས་བྱ་བ་ཁྱད་པར་ཡོངས་སུ་འཛིན་པར་བྱེད་པ་མ་ཡིན་པ་བཞིན་ནོ།",
    "རྗེས་སུ་དཔག་པ་ཉིད་འཇུག་པར་འགྱུར་གྲང་ན།",
    "དེ་ཡང་དཔེ་མེད་པའི་ཕྱིར་སྲིད་པ་མ་ཡིན་ནོ་ཞེས་སྟོན་པར་འགྱུར་རོ།",
    "གལ་ཏེ་སློབ་དཔོན་གྱིས་སྒྲ་ལས་བྱུང་བའི་གྲགས་པས་ཞེས་གསུངས་ཀྱི་རུང་བ་ཉིད་ཀྱིས་ནི།",
    "གནོད་པར་མ་གསུངས་པ་མ་ཡིན་ནམ།",
    "འདོད་པའི་སྒྲའི་བརྗོད་པར་བྱ་བ་ཉིད་ནི་རུང་བ་ཉིད་མ་ཡིན་ནོ།",
    "ཅི་ལྟར་འགར་ཡང་བཟློག་པར་ནུས།",
    "རྗོད་བྱེད་འཇུག་པར་བྱེད་མ་ཡིན།",
    "བརྡ་འདོད་པར་ནི་ཅི་ལྟར་འགྱུར།",
    "རྟོགས་པར་མཐོང་བ་ཉིད་ཡིན་ནོ།",
    "འོན་ཀྱང་རིགས་པ་འདིས་ཡུལ་ལམ་དུས་འགའ་ཞིག་ལ་ཡང་སྒྲ་ཐམས་ཅད་བརྗོད་པར་འདོད་པ་ཡིན་ལ།",
    "འདི་ནི་བུམ་པ་ལ་ཟླ་བའི་སྒྲས་བརྗོད་པར་བྱ་བ་ཉིད་འགོག་པ་གང་ཡིན་པ་དེའི་ཚེ་ཡང་གྲགས་པས་བསལ་བ་ཡིན་ནོ་ཞེས་སྨྲས་ཟིན་ཏོ།",
    "རིགས་པ་འདིས་ཐམས་ཅད་ཐམས་ཅད་ཀྱིས་བརྗོད་པར་བྱ་བ་ཉིད་དུ་མཐོང་བའི་ཕྱིར་ཉེས་པ་མེད་དོ།",
    "བརྗོད་ན་མངོན་སུམ་གྱིས་གནོད་པར།",
    "རྟོགས་པ་ཕན་ཚུན་བརྟེན་པའི་ཉེས་པར་འགྱུར་རོ།",
    "སྔོན་གྱི་དོན་འཛིན་པར་བྱེད་པ་སྤངས་པའི་ཕྱིར།",
    "བརྡ་གཞན་དུ་བྱེད་པར་འགྱུར་བས་འགལ་བ་མེད་དོ།",
    "རྗེས་དཔག་མེད་པར་རི་བོང་ཅན།",
    "སྒྲ་ལས་དོན་རྟོགས་པར་ནི་མངོན་སུམ་ཡིན་པར་མི་འཐད་དེ།",
    "ཤེས་པ་གཞན་གྱི་དམིགས་པར་ཡང་སྟེ།",
    "ཁས་ལེན་ན་ཡང་འདིར་ཡང་བརྗོད་པར་བྱ་བ་ཡིན་ཏེ།",
    "འོན་ཏེ་རྗེས་སུ་དཔག་པའི་རང་བཞིན་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "འོན་ཏེ་དེར་སྔར་མཚམས་སྦྱོར་བ་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྡང་བ་ལ་སོགས་པས་གཞན་དུ་ཡང་འཆད་པར་བྱེད་པའི་ཕྱིར་རོ་ཞེས་བསྟན་ཟིན་ནོ།",
    "དེས་ན་མངོན་སུམ་གྱིས་མིན་ཞིང་རྗེས་དཔག་མེད་པའི་ཕྱིར་འཐད་པར་དཀའ།",
    "དེ་སྐད་སྨྲ་བ་ནི་རྟོགས་པས་གནོད་པར་འགྱུར་ལ།",
    "ཟླ་བ་གཉིས་སུ་རྟོགས་པ་བཞིན་ཞེས་བྱ་བ་དེ་ལ་གྲགས་པས་གནོད་པ་བསྟན་པར་བྱ་བ་ཡིན་ནོ།",
    "རྗེས་སུ་དཔག་པས་གནོད་བཞེད་པར།",
    "བརྡའི་དུས་སུ་འབྲེལ་པར་རྟོགས་པའི་ཕྱིར་རྗེས་སུ་དཔག་པ་ཉིད་དེ།",
    "སྒྲ་ནི་དོན་དམ་པར་རྐན་ལ་སོགས་པའི་བྱེད་པ་ཙམ་ལས་སྐྱེ་བ་ཡིན་གྱི་དོན་གྱིས་བསྐྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "ཉེ་བར་ལེན་པར་གྱུར་པའི་དོན་གང་ཞིག་བརྡ་གསལ་བར་བྱ་བ་དང་།",
    "གཞན་བརྗོད་པར་འདོད་པའམ།",
    "བརྗོད་པར་འདོད་པ་མེད་ན་དོན་དེ་བརྗོད་པར་འདོད་པ་མེད་ཀྱང་ཡོད་པའི་ཕྱིར་རོ།",
    "རང་བཞིན་བརྗོད་པར་བྱ་བ་ཡིན།",
    "ཉེ་བར་ལེན་པ་ཉིད་དུ་རྣམ་པར་གཞག་པ་ཉིད་བརྗོད་པར་བྱ་བ་ཡིན་ནོ།",
    "དེས་ན་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་ཉེ་བར་ལེན་པ་ཉིད་དུ་སྣང་བས་གནོད་པ་ཡིན་ནོ།",
    "འབྲས་བུ་ཉིད་དུ་མི་སྣང་བ་དེ་ཉིད་ནི་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "བརྗོད་བྱ་མ་ཡིན་པར་འགྱུར་རོ།",
    "དེ་བརྗོད་པར་འདོད་པ་མེད་ཀྱང་ཤིན་ཏུ་གོམས་པ་ལས་སྦྱོར་བ་དེའི་ཚེ་ཉིད་ལན་ཅི་སྟེ་མི་སྣང་ངམ།",
    "འོན་ཏེ་རྣམ་པར་རྟོག་པ་དེ་ལས་ཀྱང་དེར་ལྷག་པར་ཞེན་པས་དངོས་པོ་ཉིད་ལ་འཇུག་པའི་ཕྱིར་དེ་སྐད་བརྗོད་ན།",
    "དེ་ལྟ་ཡིན་ན་བརྗོད་པར་བྱ་བ་ཉིད་ལ་ཡང་དེ་བཞིན་ཉིད་དོ།",
    "རྗོད་བྱེད་ཀྱི་དངོས་པོ་མེད་པར་འགྱུར་བ་ཡང་མ་ཡིན་ཏེ།",
    "དགག་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "གྲགས་ཡུལ་བརྗོད་བྱ་ཡིན་པར་འདོད།",
    "དེས་ན་འདོད་པར་རག་ལས་པས།",
    "ཡོད་པ་ཉིད་ནི་ཟླ་བའི་སྒྲས་བརྗོད་པར་བྱ་བ་མ་ཡིན་པ་བུམ་པ་ལ་སོགས་པ་དག་ལ་གྲུབ་པའི་ཕྱིར་རོ།",
    "གང་ལ་ཡང་ཟླ་བ་མ་ཡིན་པར་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "རྗེས་སུ་དཔག་པ་མེད་ལ་སྒྲ་ལས་བྱུང་བའི་གྲགས་པའི་དོན་དང་འགལ་བས་གསལ་བ་དེ་ནི་ཕྱོགས་མ་ཡིན་ནོ་ཞེས་གསུངས་ཏེ།",
    "མེད་པ་ན་སྒྲ་ལས་བྱུང་བའི་གྲགས་པའི་རྗེས་སུ་དཔག་པ་གནོད་པར་བྱེད་པ་ཡོད་པ་དེ་ནི་ཕྱོགས་མ་ཡིན་ནོ།",
    "དེ་སྐད་དུ་གསུངས་པ་ནི་འདི་དགག་པར་མི་ནུས་པ་ཉིད་དམ།",
    "ངེས་པར་བྱེད་པ་ཡོད་ན་མི་ངེས་པ་ཡང་མ་ཡིན་ནོ།",
    "སྔ་མ་གཙོ་བོར་ཡིན་པ་དེའི་ཚེ་ནི་འགོག་པར་མི་ནུས་པ་ཡིན་ནོ།",
    "དེས་ན་རྗེས་སུ་དཔག་པ་མེད་པར་འགྱུར་བས།",
    "སྒྲ་ནི་ཉན་པའི་རྣམ་པར་ཤེས་པ་ལ་སྣང་བ་ཡིན་ལ་དེའི་དོན་ནི་རྣམ་པར་རྟོག་པའམ།",
    "རྗོད་པར་བྱེད་པ་ཉིད་ནི་མ་ཡིན་ལ།",
    "གལ་ཏེ་བརྟགས་ནས་གཞན་ལས་སྐྱེས་པའི་རྗེས་སུ་དཔག་པར་གཞན་གནོད་པར་བྱེད་པ་ཡིན་པར་འགྱུར་རོ།",
    "གཏན་ཚིགས་གཞན་ཡོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "འབྲས་བུ་དང་ནི་ལྡན་པར་འདོད།",
    "སྟོབས་དང་ལྡན་པའི་ཕྱོགས་བཟློག་པར་ནུས་པ་དེ་དོན་དུ་གཉེར་བ་ནི་དེ་ལས་གཞན་ལ་བཟོད་པ་མ་ཡིན་ནོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཕྱོགས་གཏན་ཚིགས་དང་ལྡན་པར་བསྟན་ཏེ།",
    "གཞན་དུ་ནི་སྒྲ་མཉན་པར་བྱ་བ་མ་ཡིན་པའམ།",
    "འདིར་གནོད་པར་བྱེད་པར་སྲིད་ཀྱི་མངོན་སུམ་དང་།",
    "རྗེས་སུ་དཔག་པ་གཉེན་པོ་མེད་པ་ཉིད་དུ་བརྗོད་པ་ཡིན་ནོ་ཞེས་འཆད་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་ནི་བརྗོད་པར་བྱ་བ་ཉིད་མ་ཡིན་ནོ་ཞེ་ན།",
    "སྒྲ་ནི་གང་དུ་ཡང་འཇུག་པར་མི་ནུས་པ་མ་ཡིན་ནོ།",
    "སྒྲ་ལས་བྱུང་བའི་གྲགས་པ་འདོད་པ་ཙམ་གྱིས་རྗེས་སུ་བྱེད་པ་གཞན་ལས་མི་མཐུན་པའི་ཕྱོགས་མེད་པར་རྟོགས་པ་ལྟོས་པ་ནི་མ་ཡིན་གྱི།",
    "གལ་ཏེ་ཡོད་པ་ཉིད་ནི་བརྗོད་བྱ་མ་ཡིན་པར་རྟོགས་པ་དེས་ན་བརྗོད་བྱ་མ་ཡིན་པས་ཁྱབ་པའི་ཕྱིར་ཅི་སྟེ་འགོག་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་ཡོད་པ་ཉིད་བརྗོད་བྱ་མ་ཡིན་ན་ཡོད་པའི་སྒྲ་ཉིད་ཀྱིས་ཇི་ལྟར་བརྗོད་པར་བྱ།",
    "གལ་ཏེ་གནོད་པར་བྱས་པ་ཡང་གནོད་བྱེད་དུ་དོགས་ན།",
    "དེས་ན་སྒྲ་ལས་བྱུང་བའི་གྲགས་པ་ཉིད་གནོད་པར་བྱེད་པ་ཡིན་གྱི།",
    "མེད་པར་སྟོན་ཡིན་དེ་ལྟ་བུའི།",
    "སྒྲ་ལས་བྱུང་བའི་གྲགས་པ་གཉེན་པོའི་ཕྱོགས་མེད་པར་བསྟན་པས་ནི་ཅི་ལྟར་རྗེས་སུ་དཔག་པ་འདི་གཉེན་པོའི་ཕྱོགས་མེད་པ་དེ་བཞིན་དུ་གཞན་ཡང་ཡིན་ནོ་ཞེས་བསྟན་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་འདོད་པ་ཙམ་ཉིད་ཀྱིས་སྦྱར་བས་རྗོད་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་བུམ་པ་ལ་ཡང་ཟླ་བ་ཉིད་ཡོད་པས་དཔེ་མེད་པར་འགྱུར་གྱི།",
    "གནོད་བྱེད་ཡིན་པར་མ་རྟོགས་སམ།",
    "མི་མཐུན་ཕྱོགས་ཀྱིས་གནོད་པར་ནི།",
    "གནོད་པ་ཡོད་ཀྱང་རྟོགས་པར་མི་ནུས་པའི་ཕྱིར་ཏེ།",
    "འདིས་བརྗོད་པར་འདོད་པའི་གྲངས་གཅིག་པ་ཅན་ཉིད་ཀྱང་བསལ་བ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་མངོན་སུམ་ལ་ཡང་བརྗོད་པར་བྱའོ་ཞེ་ན།",
    "མེད་པ་མིན་པར་སྒྲུབ་པར་བྱེད།",
    "གལ་ཏེ་འབྲེལ་པ་དང་མི་ལྡན་པའི་རྟོགས་པ་ལ་དངོས་པོ་ཡོད་པར་ཐེ་ཚོམ་ཟ་བའམ།",
    "གཞན་དུ་བརྗོད་པ་ནི་གྲུབ་པ་ཉིད་བསྒྲུབ་པར་འགྱུར།",
    "གཞན་པའི་གནོད་པར་བྱེད་པ་མི་སྲིད་པ་མ་ཡིན་ནམ།",
    "མངོན་དུ་མཐོང་བ་ཇི་ལྟར་མེད་པར་བསྒྲུབ་པར་ནུས་ཏེ།",
    "གཏན་ཚིགས་གཞན་གྱིས་མེད་པར་བསྒྲུབ་པ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "མངོན་དུ་བྱས་པའི་རྟོགས་པ་ནི།",
    "སྒྲ་ལ་སོགས་པ་མངོན་དུ་བྱེད་པའི་རང་བཞིན་འཁྲུལ་པའི་རྟོག་པ་ལ་ཡང་གནོད་པར་བྱེད་པ་མེད་པར་འགྱུར་རོ།",
    "སྣང་བའི་རང་བཞིན་འབྲེལ་པ་ཡོད་པ་ཡིན་པའི་ཕྱིར་མི་སྣང་ཡང་རྟོགས་པར་བྱ་བ་ཡིན་ནོ།",
    "གལ་ཏེ་དགོས་པ་འདི་ཙམ་དུ་ཟད་ན་མངོན་སུམ་དེ་ཉིད་དུ་གཉེན་པོ་མེད་པར་བསྟན་པའི་ཕྱིར།",
    "སྒྲ་ལས་བྱུང་བའི་གྲགས་པའི་རྗེས་སུ་དཔག་པ་ལ་དོན་གྱིས་བསྟན་པར་མི་འགྱུར་ཏེ།",
    "དེས་ན་དོན་འདིས་དང་པོར་ཐོབ་པར་རྒལ་བ་ཡིན་ནོ།",
    "ཤིན་ཏུ་རིང་བར་ངེས་བྱས་ཉིད།",
    "གལ་ཏེ་མི་མཐུན་པ་མེད་པ་ཉིད་རུང་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་རིགས་པས་ཐམས་ཅད་འདོད་པའི་སྒྲས་བརྗོད་པར་རུང་བ་དེའི་ཕྱིར་འདིར་དངོས་པོའི་སྟོབས་ཀྱིས་ཞུགས་པའི་རྗེས་སུ་དཔག་པ་ཉིད་དུ་འགྱུར་ཏེ།",
    "དེས་ན་སྒྲ་ལས་བྱུང་བའི་གྲགས་པའི་རྗེས་སུ་དཔག་པ་འདི་དངོས་པོའི་སྟོབས་ཀྱིས་ཞུགས་པའི་རྗེས་སུ་དཔག་པར་ཅི་ལྟར་འགྱུར།",
    "དངོས་པོ་མ་ཡིན་པ་ལ་གནོད་པར་བྱེད་པ་དེར་ཅི་འབྲེལ་པའི་སྟོབས་ལས་བྱུང་བ་གནོད་པར་འགྱུར་རམ་ཞེས་བྱ་བ་འདི་ཙམ་ཞིག་འདིར་དགོས་པར་བསྟན་པ་ཡིན་ནོ།",
    "ཡོད་པར་འགྱུར་ཞེས་ཇི་ལྟར་དཔྱོད་པར་འགྱུར།",
    "དོན་འདི་འདི་ལྟར་སྟོན་པར་བྱེད་པས་ན།",
    "དེ་སྤངས་པས་བྱས་ནས་ནི་འཇུག་པ་མཐོང་།",
    "སད་པའང་དེ་དང་མཚུངས་པར་གྲུབ་པ་ཉིད།",
    "གཞི་འཛིན་པ་ནི་སྐྱོན་པར་ནུས་མ་ཡིན།",
    "དེའི་ཕྱིར་འདི་ཉིད་དུ་གནོད་པ་མེད་པར་བསྟན་པ་ཞེས་བྱ་བ་འདི་རིགས་པ་ཡིན་ནོ།",
    "རྗེས་དཔག་མེད་པར་བརྗོད་པ་ཡིན།",
    "རྗེས་སུ་དཔག་པ་མེད་ཅེས་བྱ་བ་ནི་སྒྲུབ་པར་བྱེད་པ་ཞེས་བྱ་བ་དང་འབྲེལ་ལོ།",
    "ཟླ་བའི་སྒྲས་བརྗོད་པར་བྱ་བ་ཉིད་ལ་དངོས་པོའི་སྟོབས་ཀྱིས་ཞུགས་པའི་རྗེས་སུ་དཔག་པ་དངོས་པོ་སྒྲུབ་པ་ལ་སྟོན་པ་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་སྒྲུབ་པར་བྱེད་པའི་རྗེས་སུ་དཔག་པ་མེད་ན།",
    "རྗེས་སུ་དཔག་པ་འགོག་པས་བཟློག་པར་འགྱུར་རོ།",
    "རྗེས་སུ་དཔག་པར་མི་འདོད་པ་ཡང་མ་ཡིན་ཏེ།",
    "འདི་ལྟར་འདི་སྒྲ་ལས་བྱུང་བའི་གྲགས་པ་ཙམ་འབའ་ཞིག་གནོད་པར་བྱེད་པ་ཡིན་གྱི།",
    "རུང་བ་ཙམ་ཉིད་ན་མངོན་དུ་ཕྱོགས་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "འོན་ཏེ་ཡང་གལ་ཏེ་རྣམ་པར་མི་རྟོག་པ་ཡིན་པའི་ཕྱིར་དངོས་པོ་ཙམ་སྣང་བ་ཡིན་གྱི་བརྗོད་བྱ་རྗོད་བྱེད་ཀྱི་ངོ་བོ་མ་ཡིན་ན།",
    "འོ་ན་མངོན་སུམ་རྣམ་པར་རྟོག་པ་དང་བཅས་པར་འགྱུར་རོ་ཞེ་ན།",
    "སྔར་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར་ཏེ།",
    "གལ་ཏེ་ཕྱིས་ཀྱི་དུས་སུ་བྱུང་བའི་རྣམ་པར་རྟོག་པ་ཡུལ་མེད་པ་ཉིད་ཡིན་པས་ཅི་ལྟར་ན་དེས་རྣམ་པར་རྟོག་པ་མེད་པ་ཉིད་དུ་རྣམ་པར་འཇོག།",
    "དེས་ན་ཇི་ལྟར་རྣམ་པར་རྟོག་པ་མེད་པ་ཉིད་དུ་རྣམ་པར་འཇོག་ཅེ་ན།",
    "འདི་ལྟར་འདས་པ་དང་ད་ལྟར་བར་སྒྲུབ་པ་པོའི་མངོན་སུམ་ལོག་པའི་མཚན་ཉིད་ཀྱི་མི་དམིགས་པ་ནི་མེད་པའི་ཐ་སྙད་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལྟར་མ་ཡིན་ན་ཐ་སྙད་མེད་པར་འགྱུར་བའི་ཕྱིར།",
    "མངོན་སུམ་ལོག་པར་འགྱུར་བ་ལ།",
    "དངོས་པོ་འདི་རྣམས་བཅད་པར་ནི།",
    "བརྗོད་པར་བྱ་བ་དང་།",
    "རྗོད་པར་བྱེད་པའི་དངོས་པོ་ནི་ངས་མངོན་སུམ་གྱིས་བཟུང་ངོ་ཞེས་རྟོགས་པ་སུ་ཡང་མེད་དོ།",
    "མཐོང་བ་ཙམ་གྱིས་མ་བསྟན་པར།",
    "མཐོང་བ་མེད་པ་ཉེ་བར་བསྟན་པ་འདི་ནི་བརྗོད་པར་བྱ་བའོ།",
    "འདི་ནི་རྗོད་པར་བྱེད་པའོ་ཞེས་སྒྲ་དང་དོན་དག་འབྲེལ་པ་རྟོགས་པ་ནི་འགའ་ཡང་མེད་དོ།",
    "གཞན་དུ་ན་འཆད་པའི་རྣམ་པར་རྟོག་པ་མེད་པར་འགྱུར་རོ།",
    "རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ནི་གཞན་དུ་བསྒྲུབ་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "བྱེ་བྲག་པ་དག་རྗོད་པར་བྱེད།",
    "མངོན་སུམ་ཉིད་ལས་རྟོགས་པར་འགྱུར།",
    "རིགས་ཐ་དད་པ་མངོན་སུམ་གྱིས་གཟུང་བ་དག་ལ་འབྲེལ་པ་ངེས་པར་མི་འགྱུར་བ་ཡང་མ་ཡིན་ཏེ།",
    "ཡོངས་སུ་ངེས་པར་མི་འགྱུར་ཏེ།",
    "རིགས་མི་མཐུན་པར་གནས་ཕྱིར་རོ།",
    "དེ་བཞིན་དུ་མིང་དང་མིང་ཅན་གྱི་རྟོགས་པ་ནི་ཉེ་བར་བསྟན་པའི་རྗེས་སུ་འགྲོ་བ་དང་ལྡན་པར་མཐོང་བ་ཉིད་དོ།",
    "གཞན་ཉིད་དུ་ནི་བྱེད་པར་འགྱུར།",
