    "བྱང་ཆེན་རྒྱུར་བསྔོའི་རྩི་ཡིས་ལེགས་བྱས་ལྕགས།",
    "འཁོར་མཚོར་འགྲོ་ཀུན་སྒྲོལ་ནུས་རྣམ་མཁྱེན་གཟིངས།",
    "ཡོངས་སྨིན་མེས་པོའི་མཆེད་ཟླ་གཉིས་པར་ཤོག།",
    "གསལ་བ་དེ་སྲིད་དར་ཞིང་རྒྱས་པར་ཤོག།",
    "གཏན་གྱི་མདུན་མ་ལྷུན་གྱིས་གྲུབ་པར་ཤོག།",
    "འཆི་མེད་རྣམས་ཀྱིས་བཟང་པོའི་བསྐལ་པ་བཞེས།",
    "ལེགས་བྱས་འཛད་པ་མེད་པའི་སྟན་བཟང་པོར།",
    "འཛིན་པའི་སྨོན་པ་ཡིད་བཞིན་འགྲུབ་པར་ཤོག།",
    "མཉམ་པར་བརྩེ་ལྡན་ཟས་གཙང་སྲས་པོ་རྒྱལ།",
    "རྙེད་པར་དཀའ་ན་ཕྱོགས་འདིར་འགྲན་ནུས་སུ།",
    "བདག་གཞན་མཉམ་པར་རྗེ་བའི་སེམས་ཀྱི་བཟང་།",
    "སྲིད་པར་ཀུན་འཁོར་དགེ་དང་མཚུངས་མིན་པ།",
    "ཕན་བདེའི་ཙནྡན་ལྗོན་པར་གནས་འགྱུར་ཤོག།",
    "བསྐལ་བཟང་ལྔ་བརྒྱའི་དུས་འདིར་མངོན་སུམ་ཤོག་ཁྱད་པར་འདྲེན་པ་མཆོག་འདི་འཆི་མེད་ཚེར།",
    "ནམ་ཡང་གཡོ་བ་མེད་པར་རབ་བརྟན་ཤོག།",
    "བྱཱབཱརཱཀཱཤཾབིཥཎགགཎེགོམཧཱམུདྲཀཾཝཾབརྞཱརྡྷོརྩཀྲེཔརིཨུདཡཨེདྷཱཏུབིཤྭཱསུརཱཙ།",
    "སྐྱེ་དགུའི་ལེགས་བྱས་སྙེ་མ་དུད་པའི་ཞིང་།",
    "བརྡ་གཟུགས་བཀོད་པའི་ཁྱད་པར་ལྟ་བ་ལ།",
    "ཚུལ་བཞིན་བསྒྲུབ་པ་རྣམ་པར་དཔྱོད་པའི་རྩལ།",
    "རྟེན་དང་བརྟེན་པར་བཅས་པའི་གཙུག་ལག་ཁང་།",
    "ཕྱུར་བུར་ཀུན་ནས་གཏམས་པའི་དྲི་གཙང་ཁང་།",
    "མཉམ་པར་ལྟ་བ་དམ་པ་སྤྱི་ཡི་ལུགས།",
    "སྲི་ཞུར་ལེགས་བྱས་སྒྱུ་མའི་ཟང་ཟིང་ནོར།",
    "མེད་པར་སྒྲོ་བཏགས་ཉེས་མེད་ཨར་ལ་གཏོད།",
    "ལེགས་བྱས་བྱེ་བར་སྤེལ་བའི་ཕུལ་བྱུང་ཞིང་།",
    "ལྷ་མིའི་སྲིད་པ་རིམ་པར་བརྒྱུད་བརྒྱུད་ནས།",
    "དེ་འཛིན་འདུས་པར་བཅས་དར་འདབ་སྟོང་དབུས།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་ཐོབ་པའི་རྒྱུ་རུ་བསྔོ།",
    "བྱང་ཆེན་བར་དུ་འབྲལ་བ་མེད་པར་ཤོག།",
    "རྟེན་དང་བརྟེན་པར་བཅས་པའི་མཆོག་ཐུན་གྱིས།",
    "མ་ལུས་འཇོམས་པར་ནུས་པའི་བཅོམ་ལྡན་འདས།",
    "བྱང་ཆེན་མ་ཐོབ་པར་དུ་རྗེས་ཟུངས་ཤིག།",
    "མེད་ཚེ་ཡི་དགའ་སྟོན་མཆོག་སྦྱིན་པར།",
    "སྣང་དང་ཤེས་པའི་ཉམས་སུ་འགོག་མེད་པར།",
    "རས་དཀར་གཙང་མའི་ངོས་ལ་བཤར་འདི་མཚར།",
    "དཀར་ནག་ཅི་བྱས་བཏབ་པའི་ས་བོན་བཞིན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་འཐོབ་གྱུར་ཅིག།",
    "ཚངས་པ་རྒན་པོའི་བློ་ཡིས་མ་བྱས་ཤིང་།",
    "འཕྲོག་བྱེད་འཇུག་བཅུའི་རྣམ་འཕྲུལ་མ་ཡིན་པར།",
    "བློ་བཟང་མཐུ་སྟོབས་མཁྱེན་བརྩོན་བྱེད་པོས་བསྐྲུན།",
    "རྒྱུ་སྦྱོར་ལེགས་བྱས་འགུགས་པའི་ཆོ་ག་མཁན།",
    "རིང་མིན་ཀུན་མཁྱེན་ཡེ་ཤེས་འཐོབ་པར་ཤོག།",
    "འདི་ཕྱི་བར་གྱི་མདུན་མ་གྲུ་བཞི་པར།",
    "དུས་ཀུན་བཀྲ་ཤིས་དཔལ་གྱིས་ཁྱབ་པར་ཤོག།",
    "གྲུབ་ནས་ངལ་བ་མེད་པར་འགྲོ་རྒྱུད་ཀྱི།",
    "རྣམ་འདྲེན་སྐུ་གཟུགས་རྒྱུ་སྦྱོར་ཡོན་བདག་དང་།",
    "མེ་ཞལ་ཚེ་འབྱོར་མཚུངས་པར་རྟག་སྤྱོད་༦༦ན་ཅིང་།",
    "གྲངས་ཀྱི་ཁྱད་པར་ཇི་སྙེད་འཕགས་བོད་ཀྱི།",
    "ལུས་ངག་སེམས་ཀྱི་རྣམ་༦༦བ་པར་བཅོས་པའི་གར།",
    "མཁྱེན་བརྩེའི་རྣམ་དཔྱོད་མཚོར་ཤར་ཚད་ཀྱི་ཟླ།",
    "རྨོངས་པའི་ས་ལ་གར་ཁྲིད་མ་ཡིན་པར།",
    "སྲས་བཅས་རྒྱལ་བའི་སྐུ་གཟུགས་བྱེད་པ་པོར།",
    "ཡོངས་བརྒྱུད་དྲི་མེད་རྒྱལ་པོའི་རྣམ་པར་ཐར།",
    "ཉེར་འབད་པར་གྱི་ཆུ་འཛིན་སྟུག་པོ་ལས།",
    "སྐྱིད་པའི་ཉི་མ་དགུང་ནས་འཆར་པར་ཤོག།",
    "ལྷ་སྲས་ཁྲི་སྲོང་ལྡེ་བཙན་བཞེད་སྐོང་སླད།",
    "མ་ཕམ་མགོན་༦༩ན་གྱི་སྤྲུལ་པར་ལུང་ཟིན་པ།",
    "བྱས་ཏེ་གོས་དུམ་བཅུག་པ་ཙམ་མིན་པར།",
    "ཡེ་ཤེས་སེམས་དཔའི་བུང་བ་ཡོངས་བཀུག་པར།",
    "རབ་ཐོབ་ངེས་པར་ལེགས་པའི་ལམ་རྙེད་ཤོག།",
    "འཇིག་རྟེན་སྤྱི་དང་ཁྱད་པར་རུ་བཞིའི་ཡུལ།",
    "དཀར་མིན་འབྲས་བུའི་མིང་ཡང་མ་གྲགས་པར།",
    "བཟང་པོའི་སྐལ་བ་མངོན་སུམ་མཐོང་པར་ཤོག།",
    "རྒྱ་ཧོར་བོད་ཀྱི་ཕྲག་པར་རབ་ལྕི་ཤོག།",
    "དྲུང་འབྱིན་རྣམ་པར་རྒྱལ་བ་ཨ་རུ་ར།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་གནས་སུ་འགྱུར་བར་བསྔོ།",
    "ཉེས་དགྲས་མ་ཕམ་རྣམ་པར་རྒྱལ་བའི་ལྷ།",
    "ཇི་ལྟ་ཇི་སྙེད་རྣམ་པར་འབྱེད་པ་ཡི།",
    "ངོ་མཚར་བཀོད་པའི་བཞུགས་གནས་མཐའ་ཀླས་པ།",
    "ལྷ་སྔགས་ཡེ་ཤེས་མཐུ་ཡི་མཆོག་ཐུན་གྱི།",
    "ཐ་སྙད་ཤེས་བྱར་མཁྱེན་པའི་སྤྱན་རས་ཡངས།",
    "མཚུངས་པར་ལྟ་བའི་རྨོངས་དད་ཅན་མང་ཡང་།",
    "གཡུ་ལོ་བཀོད་པར་འཕགས་མ་སྒྲོལ་མ་ཡང་།",
    "སྙན་པའི་གྲགས་པ་འབར་བའི་ཐམས་ཅད་མཁྱེན།",
    "ལེགས་བྱས་ཕུང་པོར་སྤུངས་པའི་བྱེད་པ་པོ།",
    "སྤྱི་དང་ཁྱད་པར་མཉམ་མེད་བཙོང་ཁ་པའི།",
    "བདེ་སྐྱིད་དགའ་སྟོན་དཔལ་ལ་སྤྱོད་པར་ཤོག།",
    "དཀར་པོར་འཛག་པ་རྣམ་པར་སྨིན་པའི་ལས།",
    "པརིསཀལཧིཀལྤཔཱུརྦཤྩཁོབིཥྞུཛཱགེཀརུཎྱདྡྲཔཱཎྱུཏྤཏཱདེཝཔོདོགྲམཱཧོརྨིཀཏྱཀཀཋིཎཡཧིདྭིགཱཎོཥྞསོསཱཀནཱནཱཾཧིདཱཤསྱབྷཱུམཱིཀཔནྠསྱམཱུལདྲུམཱལྤདྲུམ།",
    "འགལ་མེད་གདམས་པར་ཤར་བའི་བཙོང་ཁ་པ།",
    "ཁ་ཕོར་གཙང་མའི་རྨོངས་དད་ཙམ།",
    "འོག་མིན་ལ་སོགས་དག་དང་མ་དག་གནས་ཀྱི་ཁྱད་པར་དུ།",
    "ཁྱད་པར་དོན་ལ་མི་རྨོངས་བརྡ་སྤྲོད་གཞུང་།",
    "བསམས་ཀྱིན་དོན་གྱི་རྒྱལ་བསྟན་ངེས་པར་འཛིན།",
    "ཡང་དག་མཛད་པར་གཟུར་གནས་སུ་མི་དད།",
