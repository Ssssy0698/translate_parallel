    "ཀུན་དག་འ་བོ་འཛམ་བུའི་གླིང་གི་གླིང་ལྟ་ཡང་ཞོག།",
    "ནུབ་ཀྱི་བབར་རྒྱལ་བ་ལྟ་ཡང་ཞོག་གི།",
    "ཨག་ཙེམ་ཐད་སྐྲ་དང་སེན་མོ་དང་།",
    "སེན་མོ་དད།་",
    "གཞན་གང་ཡང་རུང་བ་ཤེས་པ་ཞིག་གི་རུང་ངུ་སོང་སྟེ།",
    "བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་བྱས་ལ་པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ།",
    "བཙུགས་ཏེ་ཐལམོ་སྦྱར་ནས་ཚིག་འདི་སྐད་ཅེས་བརྗོད་པར་བ་སྟེ།",
    "གང་དོ་ནུབ་ཀྱིམཚན་མོ་འདི་དང་སད་ཉི་མ་ཤར་གྱི་བར་དུ་སྲོག་གཅོད་བ་སྔར་ཞིང་སྲོག་གཅོད་པ་ལས་སླར་ལོག་སྟེ།",
    "ཡན་ལ་ག་དང་པོ་འདས་བ་དག་འབགས་བ་དགྲ་བཅོམ་པ་དེ་དག་གི་བསླབ་པ་ལ་རྗེས་སུ་སླེབ་བོ།",
    "གླུ་གར་དང་རོལ་མོའི་སྒྲ་དང་།",
    "ག་ད་དོ་ནུབ་ཀྱི་མཚན་མོ་འདི་དང་།",
    "ཡན་ལག་བརྒྱད་པ་འདིས་བདག་འཕགས་པ་དགྲ་བཅོམ་པ་དེ་དག་གི་བསླབ་པ་ལརྗས་སུ་སློབ་པོ།",
    "ཐབས་ལ་མཁས་པ་གང་གིས་རྒྱ་མཚོ་ཆེ་ན་པོའིཆུ་འདི་ཙམ་སྟེ།",
    "དེ་ནས་བཙེམ་ལྡན་འདས་ལ་བྲམ་ཟེ་གནས་འཇོག་གིསའདི་སྐད་ཅས་གསོལ་ཏོ།",
    "བདག་གི་དོན་རྗེས་སུ་ཐོབ་པ།",
    "ཡང་ངག་པའི་ཤེས་པས་སེམས་ཤིན་དུ་རྣམ་པར་གྲོལབ་རྣམས་ཀྱིས་གངབར་གྱུར་པ་དེ་དག་ལ་གང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གཅིག་གིས་དེ་སྲིདབར་ངུ་འདི་ལྟ་སྟེ་ཡུལ་ཆེན་པོ་བཅུ་དྲུག་ལ།",
    "གནས་འཇོག་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུམོ་གད་དད་པ་དད་ལྡན་པ་འཕགས་པའིཡན་ལག་བརྒྱདདད་ལྡན་པའི་བསྙེན་གནས་ལ་ལན་ཅིག་གནས་པ་ནི་ལུས་དང་བྲལ་ན་རྒྱལ་ཆེན་བཞིའྀ་རིས་ཀྱིལྷ་རྣམས་དང་བསྐལ་པ་མཉམ་པརསྐྱེ་བདེ་ནིགནས་ཡིན་ཏེ།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུམོ་དད་བ་དང་ལྡན་པའཕགས་པའི་ཡན་ལག་བརྒྱད་དང་ལྡན་པའི་བསྙེན་གནསལལན་གཅིག་གནས་པ་ནི་ལུས་དད་བྲལན་སུམ་བཅུ་རྩ་གསུམ་གྱི་ལྷ་རྣམས་དང་སྐལ་པམཉམ་པར་སྐྱེ་བདེ་ནི་གནས་ཡིན་ཏེ།",
    "རིགས་ཀྱི་བུམོ་གད་དད་པ་དད་ལྡན་པ་འཕགས་པའི་ཡན་ལག་བརྒྱད་དང་ལྡན་པའི་བསྙེན་གནས་ལ་ལན་གཅིག་གནས་པ་ནི་ལུས་དང་བྲལ་ནས་འཐབ་བྲལ་གྱི་ལྷ་རྣམས་དད་སྐལ་པ་མཉམ་པར་སྐྱེ་བ་དེ་ནི་གནས་ཡིན་ཏ་གནས་འཇོག་ངས་འདི་ལས་དགོངསནས་ལྔའི་བདེ་བ་ལ་བརྟེན་ན་མིའྀ་རྒྱལ་སྲིད་དམན་ནོཞེས་བཀའ་སྩལཏེ།",
    "རིགས་ཀྱི་བུ་འམ་རིགས་ཀྱི་བུམོ་གང་དང་པ་དང་ལྡན་བ་འཕགས་པའི་ཡན་ལག་བརྒྱདཔའི་བསྙེན་གནས་ལལན་གཅིག་གནས་པ་ནི་ལུས་དང་བྲལ་ན་འཕྲུལ་དགའི་ལྷ་རྣམས་དད་སྐལ་པ་མཉམ་པར་སྐྱོ་བ་དེ་ནི་གནས་ཡིན་ཏེ།",
    "གནས་འཇག་ཁྱོད་འཕགས་པའི་ཡན་ལག་བརྒྱད་དང་ལྡན་པའི་བསྙེན་གནས་ལཉབར་གནས་པར་གྱིས་ཤིག།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ལ་བྲམ་ཟ་གནས་འདོག་གིས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འདི་སྐད་བ་དག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "སྦས་པ་དགགིསདེ་ཆུད་ཟ་བར་འགྱུརཏེ།",
    "གཞན་གྱི་བུད་མེད་རྒྱན་གྱིས་བརྒྱན་པ་དག།",
    "བརྟགས་ཏེ་འཇམ་པོའི་ཚིག་གིས་སྨྲ་བར་གྱིས།",
    "དེ་ནས་ཚ་དང་ལྡན་པ་འོད་སྲུང་ཆེ་ནཔོ་སྟ་ན་ལས་ལངས་ཏེ་གོས་ཚགས་བཅོས་ནས་བླགོས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ཏེ་ཐལེམོ་སྦྱར་ནས་པུས་མོ་ས་ལ་བཙུགས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ལ་འོད་སྲུང་གི་ས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཁར་སིལ་འདི་ཡོངས་སུ་འདི་འཛིན་པའོག་གང་ཡིན་པ་དེ་དག་ནི་གང་གི་སྤྱོད་པ་རྣམ་པ་བཅུ་དྲུག་བོ་འདི་ལྟ་སྟེ།",
    "གར་ཟག་དེ་འཕགས་པ་ཡིན་པར་མཚོན་པ་ཉིད་ཀྱིས་གུས་པ་སྐྱེད་པར་འགྱུར་བའི་ཕྱིར་འཕགས་པའིགཔ་ཟག་གི་རྟགས་ཤེས་བྱའོ།",
    "རྗེས་སུ་དྲན་པ་དྲུག་གི་གནས་གསུམ་ཐོབ་པ་དང་།",
    "བཙེམ་ལྡན་འདས་ལ་འོད་སྲུང་གིས་གསོལ་པ།",
    "དེ་ནི་དང་འད་རེ་བཞི་སྒྲིལ་སིལ་སྒྲིལ་བཅུ་གཉིས་སུ་བྱས་པའི་བསྟན་པ་དེ་སྐྱེད་དོ།",
    "གཉིས་སྒྲིལ་བུ་བྱམ་པ་ནི་དངཞིན་གཤེགས་པ་འོད་སྲུང་གིས་རྣམ་པར་གཞག་པ་ཡིན་ཏེ།",
    "ཡོན་བདག་གི་ཁྱིམ་དུ་ཕྱིནན་ཁར་སིལ་ལུས་དང་བྲལ་བར་མི་བྱ་བ་དད།",
    "ཡོན་བདག་གི་སྒེར་ཕྱིན་མ་དང་ལན་གསུམ་གྱི་བར་དུ་དཀྲོལ་བར་བྱའོ།",
    "གནས་ཁང་ན་བཞག་པའི་ཚེས་ལ་རེག་པར་མི་བྱ་བ་དང་།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "འདི་ནི་སྡུག་བསྔལ་འགོག་པར་འགྲེ་བའིལམ་མོ་ཞེས་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པ་ན་མིག་སྐྱེས་སོ།",
    "འང་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་ན།",
    "བུད་མེད་ཁྱིམ་ཐབ་མེད་པ་ན་ཁྲིས་ཐུག་པསེམས་སྡང་བས་ཡིན་ནོ།",
    "རིགས་ཀྱི་བུ་དད་རིགས་ཀྱི་བུ་མོ་རྣམས་ལ་བརྩེ་བས་སྨྲ་བར་བྱའོ།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ཅུས་གཅིགན།",
    "བྲམ་ཟེའི་བུ་ཁྱོདལ་ལས་རྣམཔར་འབྱེད་པ་བསྟན་གྱིས།",
    "དེ་ན་འདིལ་ཡོངས་སུ་འདྲི་བོད་པའི་དད་ཚུལ་ཅན་ལ་ལ་ཞིག་གི་དགེ་སྤྱོད་དང་བྲམ་ཟེ་མཁས་པ་ལ་འདྲི་བ་དང་།",
    "དཔེར་ན་བ་ལང་གི་བརྟུལ་ཞུགས་ཅ་ན་དང་།",
    "ཚེ་རབས་ལྔ་བརྒྱ་བདདག་གིས་ཟད་པར་འགྱུར་བར་ཟད་དེ།",
    "འཛམ་བུ་གླིང་གིཤིང་འཛམ་བུ་ཞེས་བྱ་བ་ཤིང་ཏོག་ལྡ་བརྒྱ་ཙམ་ཡོད་པ།",
    "བརྫུན་དུ་སྨྲ་བ་དང་ཕྲ་མ་དང་ངག་རྩུབ་པ་དང་ཚིག་ཀྱལ་བ་སྟེ་དགགི་ལས་བཞི་དང་།",
    "དེ་ནི་ལས་བྱས་ནས་ཆ་གེ་མོཞག་ཏུ་ཤོག་ཅིག་ཅེས་ཡོངས་སུ་མི་བསྔོ་བ་སྟེ།",
    "བཟའ་ཤིང་གིར་བར་ཕྱན་པ་དང་གྲོགས་པོ་དེ་དག་གིས་སྨྲས་པ།",
    "དེས་དེ་ལྟར་བྱའོ་ཞེས་ནས་ད་དག་གི་ངག་མཉན་ཏེ།",
    "དེ་དག་དད་ཡད་སྡ་མ་བཞིན་དུརྩེ་རྩེ་བ་ལས་དེ་དག་གིས་བསྒོ་བ།",
    "དེ་དག་གིས་མཉན་ཏེ་ཁྱིམ་དུ་ཕྱིན་ནས་མལ་བདག་སྲུར་ཞུགས་ཏེ་ཡུལ་གཞན་རུ་འགྲོའི་ཞེས་དྲིས་པ་དང་།",
    "བདག་གི་མས་སྨྲས་པ།",
    "བདག་གིས་ཀྱང་མི་འགྲོའོ་ཞེས་ཀོལྔ་མའི་ངག་མཉན་ཏེ།",
    "ངུས་གཞན་ཞིག་ན་བདག་བཟའ་ཤིང་གིར་བར་ཕྱིན་པ་དང་གྲོགས་བོ་རྣམས་ཀྱིས་ངེས་པར་འདོད་དོ།",
    "དེའི་ནང་ནས་ལྷ་མོ་བཞི་ཞིག་འཐོན་པ་ནས།"
  ]
}