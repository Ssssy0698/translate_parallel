    "འདིར་ཡང་རེག་པ་ལ་སོགས་པ་དག་ནི་གཉི་ག་ལྟར་ཡང་ངེས་པར་གཟུང་བར་མི་བྱ་སྟེ།",
    "དེ་དག་གཞན་དག་གི་རྐྱེན་ཀྱང་ཡིན་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་དེ་ལྟར་གྱི་དུས་སུ་གཏོགས་པ་དག་ནི་མ་རིག་པ་དང་འདུ་བྱེད་ཅེས་བྱ་བ་དག་གི་རྒྱུ་ལས་བྱུང་བ་བཞིན་ནོ།",
    "ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པས་འདུ་བྱེད་རྣམས་སྡུག་བསྔལ་བ་ལ་སོགས་པའི་རྣམ་པ་དག་གིས་འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་ཉིད་དམ།",
    "ནང་གི་ཡོངས་སུ་གདུང་བའི་མཚན་ཉིད་དོ།",
    "ཉོན་མོངས་པ་དང་།",
    "དཔེར་ན་རི་བོང་གི་རྭ་བཞིན་ནོ།",
    "དེ་ལ་རེ་ཞིག་སྔོན་གྱི་མཐའ་ལ་བརྟེན་པའི་ལྟ་བ་རྣམས་ལས་བརྩམས་ཏེ་དཔྱད་པར་བྱའོ།",
    "རིགས་པ་གང་གིས་ཤེ་ན།",
    "ཁྱོད་ཀྱི་བདག་ནི་གང་ཞིག་ཡིན།",
    "ཁྱོད་ཀྱི་བདག་ནི་མེད་པ་ཡིན།",
    "སྔར་བསྟན་པའི་ཚུལ་གྱིས་ལས་དང་བྱེད་པ་པོ་ཡིན་པའི་ཕྱིར་དཔེར་ན་བུད་ཤིང་དང་མེ་བཞིན་ནོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "རིགས་པ་གང་གིས་ཤེ་ན།",
    "དེ་ལ་སོགས་པར་ཐལ་བར་འགྱུར།",
    "མ་བྱས་པ་དང་ཕྲད་པ་ལ་སོགས་པར་ཐལ་བར་འགྱུར་རོ།",
    "། འདི་ལ་སྐྱོན་དུ་ཐལ་བར་འགྱུར།",
    "སྐྱེད་པར་བྱེད་པའི་རྒྱུ་སྔོན་ལས་དང་ཉོན་མོངས་པས་ཉེ་བར་བསགས་པ་ཞེས་བྱ་བའི་ཕུང་པོ་གཞན་མེད་པའི་ཕྱིར་རོ་། གཉི་ག་ནི་གཉི་ག་མ་ཡིན་པ་ཡང་མ་ཡིན་ཏེ།",
    "ཕྱིར་རྒོལ་བ་དག་ན་རེ་བདག་སྐྱེས་པ་ཁོ་ནས་ལྷ་ལ་སོགས་པའི་བྱ་བ་བྱེད་པ་ལ་སྦྱོར་བའི་ཕྱིར་ལྷ་ལ་སོགས་པ་དག་གིས་བདག་གཅིག་ཁོ་ན་ཡིན་པར་བསྟན་པར་བྱ་བ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "མཆོད་སྦྱིན་གྱི་བདག་གི་རྒྱུད་དག་བཞིན་ནོ།",
    "གལ་ཏེ་རྒྱུད་ཐ་དད་པ་དང་རྒྱུད་ཐ་དད་པ་མ་ཡིན་པ་དག་གི་གཞན་ཉིད་གཏན་ཚིགས་དཔེ་མ་གྲུབ་པ་ཉིད་ཡིན་ནོ་ཞེ་ན།",
    "ཕྱོགས་གཅིག་མི་ནི་ཡིན་གྱུར་ན།",
    "དེ་ལྟར་རེ་ཞིག་སྔོན་གྱི་མཐའ་ལས་བརྩམས་ཏེ།",
    "མཐའ་ཞེས་བྱ་བ་ནི་མུ་དང་། མཇུག་ཅེས་བྱ་བ་དག་གི་རྣམ་གྲངས་སོ།",
    "འདིར་ཡང་ཕྱོགས་གཉིས་ཀར་བསྟན་པའི་རྗེས་སུ་དཔག་པ་དག་གིས་གནོད་པའི་ཕྱིར་རོ།",
    "གང་གིས་ཐུགས་བརྩེ་ཉེར་བཟུང་ནས།",
    "ཉོན་མོངས་པ་བག་ཆགས་དང་བཅས་པའི་མེ་ཞི་བར་གྱུར་པའི་ཕྱིར་དང་།",
    "དཔེར་ན་མོ་གཤམ་གྱི་བུའི་ལྟ་བ་ལ་སོགས་པ་བཞིན་ནོ།",
    "རྟོགས་པར་བྱ་བ་ཉིད་དང་བརྗོད་པར་བྱ་བ་ཉིད་ལ་སོགས་པའི་གཏན་ཚིགས་དག་གི་ཕྱིར་རོ་ཞེས་ཀྱང་རྗེས་སུ་དཔག་པ་རྒྱས་པར་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་དག་གི་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་ནི་བསྒྲུབ་པར་བྱ་བ་ངེས་པར་གཟུང་བ་སྟེ།",
    "མ་གྲུབ་པ་ཡིན་པའི་ཕྱིར་དཔེར་ན་རི་བོང་གི་རྭའི་ཡོན་པོ་ཉིད་བཞིན་ནོ།",
    "ཡན་ལག་ཚང་བའི་ཚིག་གང་གི་སྒྲུབ་པ་ཡིན་ཞེས་བརྗོད་པར་བྱའོ།",
    "ཚིག་གི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་དཔེར་ན་སུན་འབྱིན་པ་ལྟར་སྣང་བའི་སྒྲུབ་པ་ལ་སོགས་པ་བཞིན་ནོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "དེ་ལ་འདིར་རབ་ཏུ་བྱེད་པའི་དོན་ནི་ཕ་རོལ་པོ་དག་གིས་སྒྲུབ་པ་སྨྲས་པའི་སུན་དབྱུང་བ་བརྗོད་པས་ལྟ་བ་སྟོང་པ་ཉིད་དུ་བསྟན་པ་ཡིན་ནོ།",
    "ཉེཀྲུང་ད་རག་པ་བ་འཇུག་གནས་བཀའ་བསྟན་དཔེ་སྡུར་ཁང་གིས་དཔེ་བསྡུར་ཞུས།",
    "༡༥༩བསྡུར་འབྲས་རེའུ་མིག་༡༦༨༦༣ འཕགས་པ་ཡོན་ཏན་བསྔགས་པ་དཔག་ཏུ་མེད་པ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༢༥བསྡུར་འབྲས་རེའུ་མིག་༢༦༨༦༩ འཕགས་པ་ཙནྡན་གྱི་ཡན་ལག་ཅེས་བྱ་བའི་གཟུངས།",
    "༢༡༢བསྡུར་འབྲས་རེའུ་མིག་༢༡༣༨༧ འཕགས་པ་རིག་སྔགས་ཀྱི་རྒྱལ་པོ་སྒྲོན་མ་མཆོག་གི་གཟུངས།",
    "༢༤༢བསྡུར་འབྲས་རེའུ་མིག་༢༤༢༨༧༦ བཅོམ་ལྡན་འདས་སྣང་བ་མཐའ་ཡས་ཀྱི་གཟུངས་སྔགས།",
    "༢༤༤བསྡུར་འབྲས་རེའུ་མིག་༢༤༥༨༧༧ འོད་དཔག་མེད་མཐོང་བར་འགྱུར་བའི་གཟུངས།་",
    "༢༤༧བསྡུར་འབྲས་རེའུ་མིག་༢༤༧༨༧༨ འཕགས་པ་པདྨའི་སྤྱན་ཞེས་བྱ་བའི་གཟུངས།་",
    "༢༤༩བསྡུར་འབྲས་རེའུ་མིག་༢༥༨༧༩ སྣང་བ་མཐའ་ཡས་རྗེས་སུ་དྲན་པ།་",
    "༢༥༢བསྡུར་འབྲས་རེའུ་མིག་༢༥༢༨༨ ཟླ་བའི་འོད་ཀྱི་མཚན་རྗེས་སུ་དྲན་པ།་",
    "༢༥༨བསྡུར་འབྲས་རེའུ་མིག་༢༥༨༨༨༣ འཕགས་པ་དྲི་མ་མེད་པ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༢༦༨བསྡུར་འབྲས་རེའུ་མིག་༢༦༩༨༨༤ འཕགས་པ་ཁྱད་པར་ཅན་ཞེས་བྱ་བའི་གཟུངས།་",
    "༢༩༨བསྡུར་འབྲས་རེའུ་མིག་༢༩༩༨༨༧ འཕགས་པ་བྱམས་པའི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་གཟུངས་སྔགས་དང་བཅས་པ་༣བསྡུར་མཆན།",
    "༣༡༣བསྡུར་འབྲས་རེའུ་མིག་༣༡༤༨༨༩ འཕགས་པ་ཀུན་དུ་བཟང་པོའི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་གཟུངས་སྔགས་དང་བཅས་པ།་",
    "༣༢༤བསྡུར་འབྲས་རེའུ་མིག་༣༢༥༨༩ འཕགས་པ་ལག་ན་རྡོ་རྗེའི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་གཟུངས་སྔགས་དང་བཅས་པ་༣༢༦བསྡུར་མཆན།",
    "༣༣༢བསྡུར་འབྲས་རེའུ་མིག་༣༣༣༨༩༡ འཕགས་པ་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པའི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་གཟུངས་སྔགས་དང་བཅས་པ་༣༣༤བསྡུར་མཆན།",
    "༣༤༢བསྡུར་འབྲས་རེའུ་མིག་༣༤༣༨༩༢ འཕགས་པ་སྒྲིབ་པ་ཐམས་ཅད་རྣམ་པར་སེལ་བའི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་གཟུངས་སྔགས་དང་བཅས་པ་༣༤༤བསྡུར་མཆན།",
    "༣༩༤བསྡུར་འབྲས་རེའུ་མིག་༣༩༧༨༩༧ འཕགས་པ་ནོར་བུ་ཆེན་པོ་རྒྱས་པའི་གཞལ་མེད་ཁང་ཤིན་ཏུ་རབ་ཏུ་གནས་པ་གསང་བ་དམ་པའི་གསང་བའི་ཆོ་ག་ཞིབ་མོའི་རྒྱལ་པོ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༤༥༣བསྡུར་འབྲས་རེའུ་མིག་༤༦༨༩༨ འཕགས་པ་མེ་ཏོག་བརྩེགས་པ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༤༧༣བསྡུར་འབྲས་རེའུ་མིག་༤༧༤༩ འཕགས་པ་གཟུངས་ཆེན་པོ།་",
    "༤༨༤བསྡུར་འབྲས་རེའུ་མིག་༤༨༤༩༢ འཕགས་པ་བྱམས་པས་དམ་བཅས་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༤༨༧བསྡུར་འབྲས་རེའུ་མིག་༤༨༧༩༣ འཕགས་པ་སྒྲིབ་པ་རྣམ་པར་སེལ་བ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༤༩བསྡུར་འབྲས་རེའུ་མིག་༤༩༩༤ འཕགས་པ་འཇམ་དཔལ་གྱི་ཞལ་ནས་གསུངས་པ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༤༩༢བསྡུར་འབྲས་རེའུ་མིག་༤༩༣༩༥ འཕགས་པ་འཇམ་དཔལ་གྱིས་དམོད་བཙུགས་པ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༤༩༦བསྡུར་འབྲས་རེའུ་མིག་༤༩༦༩༦ འཕགས་པ་འཇམ་དཔལ་གྱི་མཚན།་",
    "༤༩༨བསྡུར་འབྲས་རེའུ་མིག་༤༩༨༩༧ རྗེ་བཙུན་འཕགས་པ་འཇམ་དཔལ་གྱི་ཤེས་རབ་དང་བློ་འཕེལ་བ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༥བསྡུར་འབྲས་རེའུ་མིག་༥༡༩༨ འཕགས་པ་འཇམ་དཔལ་གྱི་སྔགས་ཡི་གེ་འབྲུ་གཅིག་པའི་བྱེ་བ།་",
    "ཐམས་ཅད་བྱམས་ཤིང་མོས་པར་འགྱུར་བའི་ཆོ་གའི་ལེའུ།་",
    "༦༤༩བསྡུར་འབྲས་རེའུ་མིག་༦༥༤༩༡༤ ས་བཅུ་པའི་གཟུངས།་",
    "༦༦༢བསྡུར་འབྲས་རེའུ་མིག་༦༦༣༩༡༥ འཕགས་པ་དོན་ཡོད་ཞགས་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༦༦༩བསྡུར་འབྲས་རེའུ་མིག་༦༧༩༡༦ འཕགས་པ་ཀུན་དུ་བཟང་པོ་ཞེས་བྱ་བའི་གཟུངས།",
    "༦༧༧བསྡུར་འབྲས་རེའུ་མིག་༦༧༨༩༡༧ འཕགས་པ་ནཱི་ལ་ཀུཎྜ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༦༨༨བསྡུར་འབྲས་རེའུ་མིག་༦༩༩༡༩ འཕགས་པ་མེ་ཁ་ལ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༧༢༢བསྡུར་འབྲས་རེའུ་མིག་༧༢༢༩༢༤ སེང་གེ་སྒྲས་དམ་བཅས་པའི་གཟུངས།་",
    "༧༣བསྡུར་འབྲས་རེའུ་མིག་༧༣༡༩༢༦ འཕགས་པ་སྒོ་མཐའ་ཡས་པས་སྒྲུབ་པ་ཞེས་བྱ་བའི་གཟུངས།",
    "༧༥༤བསྡུར་འབྲས་རེའུ་མིག་༧༥༨༩༢༧ འཕགས་པ་སྒོ་བཟང་པོ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༧༧༡བསྡུར་འབྲས་རེའུ་མིག་༧༧༤༩༢༨ འཕགས་པ་སྒོ་དྲུག་པ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༧༧༧བསྡུར་འབྲས་རེའུ་མིག་༧༧༨༩༢༩ འཕགས་པ་ཡི་གེ་དྲུག་པའི་རིག་སྔགས།་",
    "༧༨༡བསྡུར་འབྲས་རེའུ་མིག་༧༨༢༩༣ ཚིགས་སུ་བཅད་པ་གཉིས་པའི་གཟུངས།་",
    "༧༨༤བསྡུར་འབྲས་རེའུ་མིག་༧༨༥༩༣༡ འཕགས་པ་ལུས་ཀྱི་དབྱིབས་མཛེས་ཞེས་བྱ་བའི་གཟུངས།་",
    "༧༩༤བསྡུར་འབྲས་རེའུ་མིག་༧༩༥༩༣༣ མཆོད་རྟེན་གཅིག་བཏབ་ན་བྱེ་བ་བཏབ་པར་འགྱུར་བའི་གཟུངས།་",
    "༧༩༨བསྡུར་འབྲས་རེའུ་མིག་༧༩༨༩༣༤ འཕགས་པ་གཙུག་གི་ནོར་བུ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༨༤བསྡུར་འབྲས་རེའུ་མིག་༨༦༩༣༥ འཕགས་པ་རྒྱལ་མཚན་གྱི་རྩེ་མོའི་དཔུང་རྒྱན་ཅེས་བྱ་བའི་གཟུངས།་",
    "༨༡༡བསྡུར་འབྲས་རེའུ་མིག་༨༡༣༩༣༦ འཕགས་པ་གསེར་ཅན་ཞེས་བྱ་བའི་གཟུངས།་",
    "༨༡༩བསྡུར་འབྲས་རེའུ་མིག་༨༢༡༩༣༧ འཕགས་པ་ཐམས་ཅད་ལ་མི་འཇིགས་པ་རབ་ཏུ་སྦྱིན་པ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༨༣༡བསྡུར་འབྲས་རེའུ་མིག་༨༣༢༩༣༩ འཕགས་པ་འགྲོ་ལྡིང་བའི་རིག་སྔགས་ཀྱི་རྒྱལ་པོ།་",
    "༨༣༨བསྡུར་འབྲས་རེའུ་མིག་༨༣༩༩༤ འཕགས་པ་གཞན་གྱིས་མི་ཐུབ་པ་མི་འཇིགས་པ་སྦྱིན་པ་ཞེས་བྱ་བ།་",
    "༨༥བསྡུར་འབྲས་རེའུ་མིག་༨༥༡༩༤༢ སྟོང་འགྱུར་ཞེས་བྱ་བའི་གཟུངས།་",
    "༨༥༤བསྡུར་འབྲས་རེའུ་མིག་༨༥༤༩༤༣ འཕགས་པ་འཇིགས་པ་ཆེན་པོ་བརྒྱད་ལས་སྒྲོལ་བ་ཞེས་བྱ་བའི་གཟུངས།་",
    "༨༥༧བསྡུར་འབྲས་རེའུ་མིག་༨༥༧༩༤༤ འཕགས་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཕྲག་བརྒྱ་པའི་གཟུངས།་",
    "༨༥༩བསྡུར་འབྲས་རེའུ་མིག་༨༥༩༩༤༥ འཕགས་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཕྲག་ཉི་ཤུ་ལྔ་པའི་གཟུངས།་",
    "༨༦༡བསྡུར་འབྲས་རེའུ་མིག་༨༦༡༩༤༦ འཕགས་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བརྒྱད་སྟོང་པའི་གཟུངས།་",
    "༨༦༥བསྡུར་འབྲས་རེའུ་མིག་༨༦༥༩༤༨ ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གཟུང་བར་འགྱུར་བའི་གཟུངས།",
    "༨༦༧བསྡུར་འབྲས་རེའུ་མིག་༨༦༨༩ག་ཕ་རོལ་ཏུ་ཕྱིན་པ་བཅུ་ཐོབ་པར་འགྱུར་བའི་གཟུངས།",
    "༨༧༢བསྡུར་འབྲས་རེའུ་མིག་༨༧༢༩༥༡ ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཕྲག་བརྒྱ་པ་གཟུང་བར་འགྱུར་བའི་གཟུངས།་",
    "༨༧༤བསྡུར་འབྲས་རེའུ་མིག་༨༧༤༩༥༢ འཕགས་པ་ཕལ་པོ་ཆེ་གཟུང་བར་འགྱུར་བའི་གཟུངས།་",
    "༨༨༢བསྡུར་འབྲས་རེའུ་མིག་༨༨༢༩༥༦ འཕགས་མ་སོ་སོར་འབྲང་མ་ཆེན་མོ་གཟུང་བར་འགྱུར་བའི་གཟུངས།་",
    "༨༨༦བསྡུར་འབྲས་རེའུ་མིག་༨༨༧ཏེ།",
    "ཆག་གི་ཟུར་མཆན།",
    "བཙུན་མོ་སྲས་བཅས་སོ་སོའི་འཁོར་ཀུན་དང་།",
    "བེའུ་འདྲ་དཔལ་གྱི་ལྷ་མོ་འོད་ཟེར་ཅན།",
    "སྲས་འཕན་དུང་ཅན་རི་མཁར་ནག་མོ་དང་།་།",
    "མ་བདུན་སྲིང་༤མོ་བདུན་དང་སྲིང་མོ་བཞི།",
    "ནག་མོ་ཆེན་མོ་རལ་པ་གཅིག་ལ་སོགས།",
    "ལྷ་མོ་ཆེན་མོ་གནོད་སྦྱིན་ཆེན་མོ་དང་།",
    "སྲིན་༥མོ་ཆེན་མོ་ཤ་ཟ་ཆེན་མོ་དང་།",
    "གང་གི་མིང་ལའང་བཀྲ་ཤིས་དཔལ་འབར་བ།",
    "ཀྱེ་རྒྱལ་བའི་སྲས་ཁྱོད་ཚུར་ཤོག།",
    "ཞིང་གི་མཚན་ཉིད་ནམ་མཁའ་ལྟ་བུར་ཡང་ཤེས་པར་གྱིས་ཤིག།",
    "བདག་ཅག་ཉོན་མོངས་མཚོན་གྱིས་རྨས་༦པ་རྣམས།",
    "གང་གིས་གང་ལ་སྤྱི་བོས་མཐུ་སྐྱེད་ཅིང་།་།",
    "ཟབ་མོ་རྒྱལ་བའི་བཀའ་ལ་ཀུན་གསོན་ཅིག།",
    "བསྡུར་འབྲས་རེའུ་མིགགཟུངས་འདུས།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་དུས་གཅིག་སྨོན།",
    "རེ་བ་ཐམས་ཅད་ཡོངས་སུ་སྐོང་བ།",
    "ལུས་དང་ངག་དང་ཡིད་ཀྱི་ལས་ཀྱི་མཐའ་དོན་ཡོད་པ་ལ་མོས་པ།",
    "འདིས་འཁྱོད་ལ་སྟོན་པར་འགྱུར་རོ།",
    "དེ་ནས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པས་བཅོམ་ལྡན་འདས་ལ་མངོན་དུ་ཕྱོགས་ཏེ་འདུག་ནས་སོར་མོ་བཅུའི་༧ཐལ་མོ་སྦྱར་ཏེ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཐམས་ཅད་མཁྱེན་ཅིང་ཐམས་ཅད་གཟིགས་པ་བཅོམ་ལྡན་འདས་ཉིད་ཀྱིས་ཅིའི་སླད་དུ་མི་བཤད།",
    "འདིས་༡ཁྱོད་ལ་སྟོན་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་བཞིན་གཤེགས་པས་རྫུན་བདག་ལ་དགོངས་ན་བདག་གིས་སྐྱེས་བུ་དམ་པ་འདི་ལ་དྲི་བར་བགྱིའོ།",
    "འཇམ་དཔལ་ཁྱོད་ཀྱིས་ཏིང་ངེ་འཛིན་རྡུལ་ཕྲ་རབ་ཀྱི་རྡུལ་སྙེད་ཐོབ་པ་ཡིན་ན་ནསདེ་བཞིན་གཤེགས་པ་ལ་གསོལ་བ་གདབ་ཅི་དགོས།",
    "ཁྱོད་ཀྱིས་ཚིག་འདི་ལེགས་པར་སྨྲས་ཏེ།",
    "ཡང་རིགས་ཀྱི་བུ་ཁྱོད་ནི་སྟོང་པ་ཉིད་ལ་གནས་པའི་ཏིང་ངེ་འཛིན་བསམ་གྱིས་མི་ཁྱབ་པ་དང་ལྡན་པའོ།",
    "༥རྒྱལ་བའི་སྲས་ཁྱོད་ཀྱིས་བདག་ལ་སྐབས་ཕྱེ་ན་ཁྱོད་ལ་བདག་ཡི་གེ་འབྲུ་གཉིས་ཤིག་འདྲིའོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་དག་པའི་སྒོ་འདི་ནི་མོས་པར་བགྱི་དཀའ་བ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་ཇི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའི་དོན་བདག་གིས་འཚལ་བ་ལྟར་ན་ཉན་ཐོས་ཀྱིས་ནི་༦",
    "འོ་ན་ཅི་ཁྱོད་སོ་སོའི་སྐྱེ་བོའམ།",
    "འོ་ན་ཅི་ཁྱོད་སློབ་པའམ།",
    "འོ་ན་ཁྱོད་ཅི་ཤེས་རབ་དང་ལྡན་པའི་མཆོག་ཡིན་ནམ།",
    "ཤེས་རབ་དང་ལྡན་པའི་མཆོག་ཀྱང་མ་ཡིན་ན་དེ་ཉིད་ཁྱོད་དམིགས་པ་ཅན་དུ་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་ཁོ་བོ་ནི་སྐྱེས་བུ་དམ་པ་རྒྱ་མཚོ་ལྟར་གཏིང་དཔག་དཀའ་བ་ཁྱོད་དང་འགྱེད་པར་མི་བྱེད་དོ།",
    "བཙུན་པ་ཤ་ར་དྭ་ཏིའི་བུ་ཁྱོད་ནི་རྒན་རབས་ཐུ་བོ་མཆོག་ཡིན་གྱིས་བཙུན་པ་ཤ་ར་དྭ་ཏིའི་བུ་དེ་སྐད་མ་ཟེར་ཅིག།",
    "རིགས་ཀྱི་བུ་དོན་དེ་ཉིད་ཤེས་པར་བྱ་བའི་ཕྱིར་ཁྱོད་ལ་དཔེ་བྱའོ།",
    "རིགས་ཀྱི་བུ་དོན་དེ་ཉིད་ཤེས་པར་བྱ་བའི་ཕྱིར་ཡང་ཁྱོད་ལ་དཔེ་བྱའོ།",
    "རིགས་ཀྱི་བུ་དེ་བཞིན་དུ་ཁྱོད་ནི་སྟོབས་དང་ལྡན་པ།",
    "དཔེར་ན་མི་དམུས་ལོང་གིས་ཤུལ་དུ་མཆི་བའམ།",
    "དེ་བཞིན་དུ་གླང་པོ་ཆེ་ཆེན་པོ་ལྟ་བུ་འདི་དག་གི་མདུན་༤ན་བདག་ནི་དམུས་ལོང་དང་མཚུངས་པར་མཐོང་སྟེ།",
    "ཤ་ར་དྭ་ཏིའི་བུ་དེ་བཞིན་དུ་ཁྱོད་ནི་ཏིང་ངེ་འཛིན་མཐའ་ཡས་ཤིང་བསམ་གྱིས་མི་ཁྱབ་པ་ཐོབ་པ་ཡིན་ནོ།",
    "མོས་པ་དང་རྣམ་པར་གྲོལ་བ་དུ་མ་ཤེས་པ་དང་།",
    "སྙོམས་པར་འཇུག་པའི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ལྷའི་མིག་གི་ཤེས་པ་དང་།",
    "ངག་གི་ལས་འབྲས་བུ་ཡོད་པ་དང་ལྡན་པ་ཡིན།",
    "གང་ཟག་གཞན་རྣམས་ཀྱི་བསམ་པ་ཤེས་པར་བྱེད་ཅིང་མོས་པ་ལ་རྟོག་༢པ་ཡིན།",
    "ཉོན་མོངས་པ་རྒྱུ་བ་རྟོགས་པར་བྱ་བ་ལ་མཁས་པ་ཡིན།",
    "འཇིག་རྟེན་གྱི་ཁམས་གྲངས་མེད་པ་སེམས་གཅིག་གིས་འདའ་བར་བྱེད་པ་མང་བ་ཡིན།",
    "ངག་གི་ལས་ཤེས་པར་མི་ནུས།",
    "ཀུན་དུ་རབ་ཏུ་ཆེམ་ཆེམ་མོ།",
    "ལྷའི་རྒྱན་ཕྲེང་གི་སྤྲིན་གྱི་ཆར་དང་།",
    "འཁོར་འདི་ལྟ་བུ་དག་གི་ནང་དུ་ཚིག་འབྲུ་འདི་དག་གིས་དོན་འདི་ཉིད་སྟོན་ཏེ།",
    "འཇིག་རྟེན་ཀུན་གྱི་མོས་པ་ཅི་འདྲ་དང་།",
    "ཉོན་མོངས་ཟད་པ་རྟོགས་པར་བྱ་བའི་ཕྱིར།",
    "འོད་ཟེར་རྩེ་མོ་རེ་ལས་འོད་ཟེར་རྣམས།",
    "དེ་དག་རང་གི་ལག་ཏུ་མངོན་སྤྲུལ་ཏེ།",
    "དུས་གསུམ་དག་གི་དེ་བཞིན་གཤེགས་རྣམས་དང་།",
    "དེ་བཞིན་གཤེགས་པས་གང་ཞིང་རང་བྱུང་གི།",
    "ཕྱོགས་བཅུ་དག་གི་འཇིག་རྟེན་ཐ་དད་པར།་།",
    "དངན་སོང་ས་རྣམས་དག་ཏུ་གནོད་གྱུར་པའི།",
    "དེ་ནི་རང་གི་ས་ལས་ཡོངས་མི་ལྡོག།",
    "དེ་དག་རྣམས་ཀྱི་མོས་པ་སྤྱོད་པར་བྱེད།",
    "དེ་དག་ཉོན་མོངས་རྒྱུད་དང་བག་ཆགས་དང་།",
    "སྐྲ་ཐིགས་གཅིག་གིས་ཆུ་ཚད་གཟུང་དུ་རུང་།",
    "བཅོམ་ལྡན་འདས་གཟིགས་སུ་གསོལ།",
    "ཤ་ར་དྭ་ཏིའི་བུ་སོང་ལ་བརྒྱ་བྱིན་དང་།",
    "ཁྱེད་ད་ཕྱིས་འགྱོད་པར་གྱུར་ཏ་རེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་༤སྤྱན་སྔར་འཁོད་ནས་ཐལ་མོ་སྦྱར་ཏེ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུས་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་༨",
    "རིགས་ཀྱི་བུ་ཁྱོད་ནི་ཤེས་རབ་ཟབ་པ་སྟེ།",
    "ཁོ་བོས་ནི་ཁྱོད་དང་འགྱེད་མི་ནུས་སོ།",
    "རིགས་ཀྱི་བུ་ཁོ་བོ་ཉན་གྱིས་ཁྱོད་ཀྱིས་ཤོད་ཅིག།",
    "ལྷའི་བུ་མོ་མང་པོ་ཡང་འདུས་པར་གྱུར་ཏོ།",
    "དགེ་སློང་གི་འཁོར་དང་།",
    "ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་དང་།",
    "རྒྱལ་རིགས་དང་བྲམ་ཟེ་དང་ཁྱིམ་བདག་གི་འཁོར་དག་ཀྱང་འདུས་པར་གྱུར་ཏོ།",
    "ཤ་ར་དྭ་ཏིའི་བུ་སོང་ལ་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་དང་།",
    "སྐྱེས་བུ་དམ་པ་ཁྱོད་ཀྱིས་ཤོད་ཅིག།",
    "ཤ་ར་དྭ་ཏིའི་བུ་སྟོང་པ་ཉིད་གང་གི་ཚིག་བླ་དགས་ཡིན།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཇི་ལྟ་བུ་བསྟན་པ་དེ་དག་ཐམས་ཅད་ནི་སྟོང་པ་ཉིད་བསྟན་པ།",
    "འཇམ་དཔལ་འདི་དག་ནི་མི་གཏི་མུག་པ་དེ་དག་གི་སྐྱོན་དུ་གྱུར་པའོ།",
    "རེག་དཀའ་བ་དང་།",
    "ཀུན་ཏུ་བཟང་པོ་ཁྱོད་ཀྱིས་ཞུས་པ་དེ་ལེགས་པར་ཞུས་སོ།",
    "དེ་དག་ནི་བསྐལ་པ་སྟོང་དག་གིས་ཀྱང་བརྗོད་པར་མི་ནུས་སོ།",
    "སྐྱེས་མ་ཐག་ཏུ་ལྕགས་ཀྱི་འཁོར་ལོས་མི་གཏི་མུག་པ་དེ་དག་གི་མགོ་བཅད།",
    "བྲམ་ཟེ་གཞན་དག་གིས་ལྟ་ག་ལ་ནུས་ཏེ་ཅི་སྨོས།",
    "བཅོམ་ལྡན་འདས་དགེ་སློང་དེ་ལྟ་བུ་དེ་དག་གིས་དད་པས་སྩལ་བ་ཇི་ལྟར་ཡོངས་སུ་འཇུ་བར་འགྱུར།",
    "ལས་ཀྱི་སྒྲིབ་པ་འདི་ལྟ་བུ་དག་ནི་བདག་གིས་རྨི་ལམ་ན་ཡང་མཐོང་བར་མ་གྱུར་ཅིག།་",
    "རང་གི་ལས་ཀྱི་བགོ་སྐལ་ལ་སྤྱོད་པ།",
    "རང་གི་ལས་བརྟན་པར་བྱ་བ་སྟེ།",
    "ངག་གིས་ཉེས་པར་སྤྱོད་པ་དང་ལྡན།",
    "དེ་བཞིན་གཤེགས་པ་དག་ཉོན་མོངས་པ་རྣམས་དང་ལྷན་ཅིག་གནས་པ་ནི་མ་ཡིན་ནོ།",
    "ཤ་ར་དྭ་ཏིའི་བུ་དེ་བཞིན་དུ་དེ་བཞིན་ཙིགཤེགས་པ་དག་ཀྱང་ཉོན་མོངས་པ་རྣམས་༡དང་ལྷན་ཅིག་མི་གནས་སོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་རབ་འབྱོར་གྱིས་བཅོམ་ལྡན་འདས་ཀྱིས་བསྟན་པ་འདི་ཐོས་ནས་ཐལ་མོ་སྦྱར་ཏེ་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "རབ་འབྱོར་དེ་དག་གི་ལྕེ་ནི་དཔག་ཚད་འབུམ་པར་འགྱུར་ཏེ།",
    "རབ་འབྱོར་མི་གཏི་མུག་པ་དེ་དག་གི་ལས་ཀྱི་སྒྲིབ་པ་ནི་དེ་ལྟ་བུར་འགྱུར་རོ།",
    "རི་མོར་བགྱིའོ།",
    "བཅོམ་ལྡན་འདས་བདག་གིས་ཀྱང་རིགས་ཀྱི་བུའམ།་",
    "རིགས་ཀྱི་བུ་མོ་དེ་དག་ཀུན་ཏུ་བསྲུང་བར་བགྱིའོ།",
    "ཤིན་ཏུ་དྲི་མེད་བཞིན་ལྡན་ཁྱོད་ཀྱི་བསམ་པ་མཆོག།",
    "བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ནས་པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་ཏེ་༡ནི།",
    "བཅོམ་ལྡན་འདས་ག་ལ་བ་དེ་ལོགས་སུ་ཐལ་མོ་སྦྱར་བ་རིབཏུད་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "བདུད་སྡིག་ཅན་གྱི་རང་གི་ཁྱིམ་ཀུན་དུ་འབར་བ་མཐོང་སྟེ།",
    "དམ་པ་ཡིན་མོད་ཀྱི།",
    "ཚངས་པ་དང་འཇིག་རྟེན་སྐྱོང་བ་དེ་དག་ལ་ཀྱེ་གྲོགས་པོ་དག་ཁྱོད་༤ཀྱིས་ཚིག་འདི་ལེགས་པར་སྨྲས་པ་ལེགས་སོ་ལེགས་སོ་ཞེས་བྱ་བ་བྱིན་ནོ།",
    "ཀུན་ཏུ་རབ་ཏུ་ཆེམ་ཆེམ་མོ།",
