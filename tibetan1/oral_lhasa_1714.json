    "ཁ་རྒྱ་སྨད་པ་སོགས་ཀྱིས་བཀུར་སྟི་དང་བཅས་སྟག་མགོའི་ཐང་དུ་ཤག་ཆུའི་ཞིང་སྐྱོང་ཆེན་པོ་བསང་རྫས་ཀྱིས་མགུ་བར་བྱས།",
    "རྡོ་རྗེ་འཆང་ནས་ཕྲན་བུ་ཐུགས་ལ་བཏགས་ཏེ་མགྱོགས་ཤད་ཀྱིས་ཕེབས་པ་བཀའ་དྲིན་ཤིན་ཏུ་ཆེ་ཞེས་ཐུགས་ཧ་ཅང་དགྱེས་ཉམས་མཛད།",
    "གཙོས་སྒར་ལུང་སོགས་ཀྱི་ལོ་གསར་འབུལ་མི་རིམ་པར་བྱུང་།",
    "གདན་ས་སོགས་ནས་ཞབས་རིམ་ཉིན་མཚན་མེད་པར་བསྒྲུབས།",
    "ཇི་ལྟར་ནོད་པའི་བསླབ་བཞེས་སོགས་གསུང་ཞིང་།",
    "ཞེས་སོགས་ཚིགས་བཅད་གཅིག་གསུངས་ནས།",
    "དེས་ཆོག་གསུང་ཞིང་རིམ་གྱིས་སྐུ་ཇེ་ལྷོད་དུ་གྱུར་པར།",
    "གཟིམས་མལ་དུ་བཞུགས་པ་དང་མཉམ་དུ་ཕྱག་གཡས་ཞལ་འགྲམ་དུ་བཞག་གཡོན་པ་བརྐྱངས་ཏེ།",
    "སེངྒེ་ཉལ་སྟབས་ཀྱིས་བཞུགས་ནས།",
    "སྙན་སྐུལ་ཕུལ་བ་ལྟར་མཆོག་སྤྲུལ་མྱུར་འབྱོན་གྱི་སྨོན་ཚིག་འཕྲལ་དུ་བཀའ་རྩོམ་གནང་།",
    "རྡོ་རྗེ་འཆང་ནས་ཀྱང་གཏམ་ངན་གསན་འཕྲལ་ནས་ཉིན་མཚན་སྦྲེལ་ཏེ་ཕེབས་པ་བཅུ་དགུ་ལ་འབྱོར་བར་བརྟེན།",
    "ཡང་རྗེ་རྡོ་རྗེ་འཆང་ཆེན་པོར་ཡང་སྙན་སྐུལ་ཞུས་པ་ལྟར་མྱུར་འབྱོན་དང་རྗེས་འཛིན་སྨོན་ཚིག་བཀའ་རྩོམ་གནང་བ་དང་།",
    "རིམ་པར་འཁྲུངས་གཞིས་ནས་ཡབ་རྗེ་དམ་པ་སོགས་དང་།",
    "གནམ་གང་ཉིན་ཉི་མ་ནུབ་ཙམ་ན་སྐུ་གདུང་བཞུགས་གནས་དང་གདན་སའི་བར་འོད་དམར་པོས་སྦྲེལ་བ་བྱུང་བ་ནི་རྗེས་སུ་འཛིན་པའི་རྟགས་ཁྱད་པར་ཅན་དུ་མངོན།",
    "སྐུ་གཟུགས་ལ་སོགས་རུས་པ་ལས།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "བསྐྱེད་རིམ་པ་ལ་ལྷ་སྐུ།",
    "ཞེས་གསུངས་པའི་མཛད་པ་འཁྲུལ་བ་མེད་པའོ།",
    "རྟེན་འདི་ལ་བརྟན་པར་བཞུགས་སུ་གསོལ།",
    "མཁས་བཙུན་བཟང་པོའི་རྣམ་པར་འཛོམས་པ་དང་།",
    "སླར་ཡང་སྤྲུལ་པའི་ཟློས་གར་འཁྲུལ་བ་མེད་པས་རྗེས་སུ་བཟུང་བའི་རིམ་པར་ཕྱེ་བ་སྟེ་གསུམ་པའོ།",
    "སྲིད་ཞིའི་རྩེ་ལ་འདྲེན་པའི་ཁུར་བཞེས་པས།",
    "ཐོ་ཅོ་མེད་པར་སྤངས་རྟོགས་ལྷུན་གྱིས་གྲུབ།",
    "རབ་དཀར་སེམས་ཀྱིས་སྙན་ཚིག་རྨད་བྱུང་སྦྲང་རྩིའི་དོག་པར་ཡོངས་སུ་བསྒྲུབས་ཏེ་སྐལ་བཟང་མགུ་བའི་དཔལ་དུ་སྤྲོས།",
    "དུས་ཀྱི་དྲི་མས་རྙིང་བ་མེད་པར་སྲིད་པའི་མཐར་ཡང་གསལ་གྱུར་ཅིག།",
    "རྟག་ཏུ་ཟད་མི་ཤེས་པར་བྱོ་ནས་དགེ་མཚན་སྣང་བ་འབར་གྱུར་ཅིག།",
    "བསྐལ་པའི་མཐར་ཡང་གཡོ་བ་མེད་པར་མཛད་བཟང་གསེར་གྱི་ཐང་མ་འགྲེམ།",
    "སྙིགས་མའི་དུས་ཀྱི་ཐམས་ཅད་མཁྱེན་པ་མཁན་ཆེན་རྡོ་རྗེ་འཆང་རྗེ་བཙུན།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་སྤྱོད་ཡུལ་དང་།",
    "བྱིས་བློས་དཔོག་པར་མི་ནུས་འོན་ཀྱང་ནི།",
    "སྒྲོལ་བསྟོད་དབྱངས་སུ་བསྒྲགས་པས་རྐྱེན་བྱས་ཏེ།",
    "སྤྱན་དང་མངོན་ཤེས་མངའ་བའི་ཞལ་བཞེས་མཛད།",
    "རྨི་ལམ་ཟིན་པའི་ཞལ་བཞེས་འཕྱུགས་མེད་སྩལ།",
    "རྣམ་པར་སྣང་མཛད་བསྟན་པ་སྲུང་བའི་གཙོར།",
    "ལྐོག་གྱུར་རྗེན་པར་གསུངས་པ་གྲངས་མང་ཡང་།",
    "གསང་བ་རྒྱལ་རྣམས་མཉམ་པར་འཇུག་པ་འདིའི།",
    "བཞུགས་པའི་གཏམ་འདི་གསེར་གྱི་གར་བུ་སྟེ།",
    "ཨེ་མ་སྲིད་ཞིར་མཐོ་བའི་ལེགས་བྱས་ནི།",
    "དམ་པའི་མགོན་གྱིས་ཕོངས་པ་མེད་པར་ཤོག།",
    "རྒྱལ་ཚབ་བདག་ཉིད་ཆེན་པོ་ཐར་འདོད་འགྱུར་མེད་རྒྱ་མཚོའི་བཀས་གནང་སྐྱེས་དང་བཅས་ཡང་ཡང་བསྐུལ་བ་བཞིན།",
    "༢་༧ལོའི་ཟླ་༡་པར་པར་གཞི་དང་པོ་བསྒྲིགས།",
    "༢་༧ལོའི་ཟླ་༡་པར་པར་ཐེངས་དང་པོ་བཏབ།",
    "། ཞི་བྱེད་ཀྱི་ཁྲིད་དམ་པའི་དགོངས་རྒྱན་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "གང་བློ་རྒྱ་མཚོའི་རོལ་པར་ཞུགས་ཉིད་ཀྱི།",
    "སྐྱེ་རྒུའི་ཚོགས་ལ་དག་པར་སྣང་བའི་ཕུལ།",
    "བདག་ཀྱང་ཡང་དག་པའི་ཕུལ་གྱི་གཏམ་འདི་སྨྲེང་བ་ལ་སྤོབས་པ་དང་ལྡན་པར་གྱུར་ཏོ།",
    "བསྒོམ་བྱ་ལག་ལེན་གྱི་འཕྲང་ལ་གཞལ་བས་འཆུག་ས་མེད་པར་བསྟན་པ་གཉིས་ལས།",
    "སྒྲིབ་པ་ཀུན་ལས་རྣམ་པར་གྲོལ།",
    "གཉིས་པ་བསྒོམ་བྱ་ལག་ལེན་གྱི་འཕྲང་ལ་གཞལ་བས་འཆུག་ས་མེད་པར་བསྟན་པ་ལ།",
    "མཐོང་བ་ཙམ་གྱིས་དངངས་པར་འགྱུར།",
    "ཕྱི་མ་ཉིང་འཁྲུལ་ལྟ་བུའི་བློ་ཡིན་པས་སྤང་དཀའ་བ་ལྟར་དུ་འཁྲུལ་པར་སྣང་བ་དང་དེའི་གཉེན་པོ་བཅོས་མ་མཐའ་དག་ཀྱང་མཚུངས་ཤིང་།",
    "ཕྱིས་ཐག་པ་ཉིད་དུ་མཐོང་བའི་དུས་གཉིས་གར་ལྟ་བ་པོའི་བློས་བཅོས་མ་བཅོས་མ་གཏོགས་ཐག་པའི་གནས་ཚུལ་ལ་ཁྱད་པར་མེད་པ་བཞིན་དུ་འཁོར་འདས་གཉིས་ཀྱང་རྟོགས་པ་དང་མ་རྟོགས་པའམ།",
    "སེམས་ཀྱི་བབས་སྤྲོས་པའི་མཐའ་ཐམས་ཅད་དང་བྲལ་བ་དེ་ཉིད་བློས་བཞག་གང་ཡང་མ་ཡིན་པའི་བདེ་བ་ཆེན་པོ་རང་རིག་པའི་མཚན་ཉིད་ཅན་གྱིས་མངོན་དུ་བྱེད་པ་ལ་མིང་མ་བཅོས་པར་བསྙད་པ་སྟེ།",
    "བོགས་འདོན་པ་ལ་མཁས་པར་བྱ་བ་ནི།",
    "སྤྱོད་པ་རིགས་ངན་གྱི་བུར་བྱས་པས་འཇིག་རྟེན་གྱི་ཆེ་ཐབས་འཇིག་པར་བྱེད།",
    "སྒོ་གསུམ་ཐ་མལ་དུ་བསྡད་པས་རྒྱུད་ལ་ཚོགས་གཉིས་རྫོགས་པར་བྱེད།",
    "དེས་ལྷ་བདུད་དུ་མི་འབབ་པར་བྱེད།",
    "དེ་ལྟ་བུར་མཉམ་པར་འཇོག་པ་ལ་ཡང་ལྟོ་གོས་ལ་གྱོང་བསྐུར་བས་སྡུག་བསྔལ་བསྲན་ཚུགས་པར་བྱེད།",
    "སྐྱབས་གནས་ཀྱི་ཡུལ་གཅུད་ལ་བོར་བས་རྒྱུད་ལ་དངོས་གྲུབ་རྣམ་པ་གཉིས་ཐོབ་པར་བྱེད།",
