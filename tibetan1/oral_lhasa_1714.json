    "འཇམ་དབྱངས་དཀར་པོ་དང་རིགས་གསུམ་སྤྱི་སྒྲུབ་ཀྱི་ལྗགས་བསྙེན་སོ་སོར་སྦྱིན་སྲེག་བཅས་གནང་བ་མགོ་ཟླའི་ཉི་ཤུ་ལ་གྲུབ།",
    "ཚོགས་ལངས་སོགས་སྔར་རྒྱུན་བཞིན་གནང་།",
    "དགོན་དེར་གཞི་ཕབ་འཕྲལ་ཞམ་རིང་བ་དམངས་ཕྱིར་ལོག་སྐྱབས་རྗེ་ཐུབ་བསྟན་ཉི་མའི་འཁྲུངས་གཞིས་ནས་འཚམས་ཞུ་དང་གདན་འདྲེན་ནན་ཆེར་ཞུས་པར་སྐབས་བསྟུན་གྱི་གསུང་ལན་དང་།",
    "རྩོད་གྲྭ་རྒྱུན་ཆགས་གནང་།",
    "ཉེར་བདུན་ལ་གསེར་ཁའི་དགོན་དུ་ཡབ་སྲས་ལྷན་ཅིག་ཆིབས་བསྐྱོད་གནང་བར་རྐང་རྩའི་སྐྱ་སེར་ནས་ཆིབས་བསུ་སེར་སྦྲེང་གང་ལྕོགས་བསྟར།",
    "དངུལ་བྲེ་ཆེན་ལྔ་དང་གོས་ཕྲུག་ནང་མཛོད་བཅས་ཀྱི་དངོས་འབུལ་ཞུས་པར་ཐམས་ཅད་ཕྱིར་སློག་མཛད།",
    "རྗེ་ཐམས་ཅད་མཁྱེན་པས།",
    "མཁས་པའི་བཤེས་ལ་བརྟེན་ཏེ་ལེགས་པར་སྦྱངས།",
    "ཞེས་གསུངས་པ་ལྟར་བཤེས་གཉེན་བསྟེན་ཚུལ་གྱི་སྒོ་ཐམས་ཅད་ཕྱག་ཏུ་བཞེས་པས་ལེགས་ཚོགས་ཀྱི་རྐང་ཚུགས་པར་མཛད་དོ།",
    "ཇི་ལྟར་ནོར་བུའི་གླིང་དུ་ཕྱིན་པའི་དེད་དཔོན་ཆེན་པོས་ཡིད་བཞིན་གྱི་ནོར་བུ་རིན་ཐང་མེད་པས་གྲུ་བོ་ཆེའི་ནང་བར་མཚམས་མེད་པར་བཀང་སྟེ་རང་ཡུལ་དུ་ལྡོག་པ་བཞིན།",
    "ཡབ་སྲས་འབྲལ་མི་ཕོད་པའི་ཉམས་དང་བཅས་མཇལ་དཪ་རྩེ་སྤྲོད་གནང་ཞིང་།",
    "མ་བརྟགས་ཉོ་བའི་ཚུལ་མིན་པར།",
    "ཤག་རའི་གནས་སུ་བདེ་མཆོག་ཚོགས་འཁོར་དང་བསང་མཆོད་མཛད།",
    "ཟླ་མཇུག་བཅད་རྒྱ་གནང་།",
    "ཡོངས་འཛིན་ཚང་གྲྭ་སའི་བརྩི་བཞག་ལ་ཐུགས་ཞེན་ཆེ་བས་རྭ་སྟོད་བསྡུས་གྲྭ་གཙོར་འདོན་གནང་བར།",
    "སྐྱེ་སྲིད་དེ་སྲི་གེགས་ཅན་ཡིན་སྟབས་མེས་པོ་ཚེ་ཐར་ནས་ཐུགས་དམ་བརྟག་པ་ནན་ཞུ་བགྱིས་པར།",
    "ཉེར་གཅིག་ཉིན་མ་དགོན་དུ་ཕེབས་ནས་མགོན་ཁང་སོ་སོར་མཆོད་ཚོགས་དང་འཕྲིན་བཅོལ།",
    "བཅོ་ལྔར་མཁའ་རི་ལ་བཙས་དཔངས་བསྟོད་གནང་།",
    "འདི་སྐབས་མཚན་ལམ་ལ་བསྙད་ནས་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་སྐུ་འབུམ་དུ་མྱུར་དུ་ཕེབས་ངེས་ཞེས་གསུངས་པ་རྗེས་སོར་ཇི་བཞིན་ཐིག་ནས་ངོ་མཚར་བ་བྱུང་།",
    "ཉེར་གཅིག་ལ་འཁྲུངས་གཞིས་སུ་ཕེབས།",
    "ནག་པ་ཟླ་བའི་ཚེས་གསུམ་ལ་བཞུགས་སྒར་བཏེགས།",
    "དགྱེས་རྩེར་སོན་ཏེ་གཟེངས་བསྟོད་ཀྱི་གསུང་རྗེན་པ་གནང་།",
    "ཐེ་བོ་ནས་ཆར་དཀོན་ཆེ་སྟབས་ཆར་འབེབས་ཀྱི་མགོན་དུ་སྤྱན་འདྲེན་ནན་ཆེ་བ་ལྟར་ཉེར་གཅིག་ལ་ཆིབས་བསྐྱོད་པར།",
    "བཞུགས་སྒར་གྱི་ཤུལ་དུ་ལྷ་ཁང་ཞིག་བཞེངས་ཏེ་དེར་འགྲོ་མགོན་བསྟན་པ་རབ་རྒྱས་ཀྱི་སྐུ་བརྙན་དང་བཀའ་ཤོག་བཞུགས་སུ་གསོལ་ནས་དགེ་སློང་འགས་དབྱར་གནས་དང་དུས་འབྲེལ་གསོ་སྦྱོང་རྒྱུན་འཛུགས་བྱེད་དགོས་པ་དང་།",
    "ལོ་ཤས་རིང་སྡིག་སྤྱོད་བྱས་མི་ཆོག་ཚུལ་གྱི་བཀའ་སྩལ་ཏེ་མི་འཇིགས་པ་སྐྱབས་ཀྱི་སྦྱིན་པ་རྒྱ་ཆེན་པོ་གནང་།",
    "རྒྱན་དྲུག་མཆོག་གཉིས་ཀྱི་གཞུང་གང་ལ་ཡང་ནམ་འདོད་མཇལ་བའི་རྐྱེན་དུ་བཀའ་དྲིན་ཆེ་ཞེས་དགྱེས་ཚོར་ཆེན་པོ་གནང་།",
    "སྐབས་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་གསེར་ཁོག་ཏུ་ཕེབས་པ་དང་འཛོམས་པས་ཡུན་རིང་བསྒུགས་དགོས་བྱུང་སྐབས་ཀྱང་།",
    "ཞེས་པ་དང་མཐུན་པའི་དགོངས་པ་མངོན་དུ་བྱས་ཤིང་།",
    "བཅོ་ལྔའི་ཉིན་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་གསེར་ཁོག་ནས་ཆིབས་ཞལ་བསྒྱུར་སྐབས།",
    "བཅོམ་ལྡན་འདས་ཚེ་མཐའ་ཡས་པ་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་ཆེན་པོའི་ཞལ་གྱི་དཀྱིལ་འཁོར་ཐོག་མར་མཇལ་བར་མཛད།",
    "ཞེས་གསུངས་པ་ལྟར་ཐུགས་ཟག་མེད་ཀྱི་དགའ་བདེ་ཁྱད་པར་ཅན་གྱིས་གང་བར་གྱུར་ཏེ།",
    "ཚུལ་དེ་ལ་བརྟེན་ནས་རྟོགས་པའི་ཡོན་ཏན་སྔར་མ་འཁྲུངས་པ་མང་ཞིག་འཁྲུངས་ཚུལ་སྦ་གསང་མེད་པར་རྗེ་ཨ་བྷྱའི་ཞབས་ལ་གསུངས་པར་མངོན་ལ།",
    "ཞེས་ཞལ་གདམས་དང་འབྲེལ་བར་རྟེན་སྐལ་དུ་ཐམས་ཅད་མཁྱེན་པ་རང་ཉིད་ཀྱིས་རྒྱུན་བསྣམས་སྐུ་འགག་བཞེས་འཕྲོ་དང་།",
    "གོས་ཕྲུག་དང་སྤོས་སོགས་གནང་སྦྱིན་སྤམ་མཐོ་བ་དང་།",
    "ཡོངས་འཛིན་རྣམ་གཉིས་སོགས་ལའང་དེ་མཐུན་བབ་བསྟུན་གྱི་གནང་སྦྱིན་སྩལ་ཅིང་སྐུ་བཅར་རྣམས་ལ་མཆོག་སྤྲུལ་དམ་པའི་བསྔགས་བརྗོད་ཡང་ཡང་གནང་།",
    "ཟི་ལིང་དུ་མ་ཀྲུའུ་ཞིར་དངོས་འཕྲད་མཛད་པར་ཀྲུའུ་ཞི་ནས་ཀྱང་བཀུར་སྟི་ཆེས་ཆེར་བགྱིས་ཤིང་།",
    "ཚེས་གཉིས་ལ་སྒར་ཆེན་དུ་ཕེབས།",
    "པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་ཞེས་གླེང་།",
    "ལིམ་བིའི་སྐྱེད་ཚལ་ལ་ཆགས་པར།",
    "རྗེ་ཉིད་ནས་ཀྱང་བསྙེན་སྒྲུབ་ཟབ་ནན་གནང་བ་དང་།",
    "བསམ་གཏན་སྒྲུབ་ལ་བརྩོན་པར་བྱ།",
    "ཐུན་བཞིའི་རྣལ་འབྱོར་ལ་ལེ་ཤོར་མེད་པར་ཐུགས་བརྩོན་ཆུ་བོའི་རྒྱུན་བཞིན་དུ་བསྟེན་ཏེ།",
    "བྱི་ལོའི་ཟླ་ཤོལ་དང་བཅས་ཟླ་ངོ་བཅུ་བཞིའི་བར་དུ་འགྲུས་པར་མཛད་དོ།",
    "སྐབས་ཀྱི་བཟླས་དམིགས་རྣམས་སྙན་བརྒྱུད་ཇི་ལྟ་བ་བཞིན་དུ་ཐུགས་ཉམས་སུ་བསྟར་བའི་སྒོ་ནས་ཡི་དམ་ཞི་ཁྲོའི་ཐུགས་རྒྱུད་བསྐུལ་ཅིང་ཕྲ་རགས་ཀྱི་ལྷའི་གསལ་སྣང་ལ་གོམས་པར་མཛད་དོ།",
    "དབྱར་གྱི་དུས་དབྱར་ཞལ་བཞེས་མཛད།",
    "ཡོངས་འཛིན་དམ་པར་སྐུ་ཁམས་དྭངས་དགོས་ཀྱི་ཞུ་འབུལ་སྤྱན་ཆབ་ཡུན་རིང་འདོན་བཞིན་གནང་བར།",
    "རིམ་གྱིས་ཡབ་སྲས་གཉིས་སྐུ་ཁམས་དྭངས་པར་གྱུར།",
    "སྔར་མཚན་ལམ་དུ་མི་མང་བོ་ཞིག་སླེབས་པར་སྐུ་མཚམས་རལ་བར་དགོངས་ནས་བཀག་ཀྱང་མ་ཁོག་པ་ཞིག་བྱུང་བ་ཡང་དྲུང་ཆེན་པ་འདའ་བའི་ལྟས་སུ་གླེང་།",
    "ཅེས་ཡི་རངས་དང་བཅས་གསུངས་པར་མཛད།",
    "དངོས་གྲུབ་ཀྱི་རྫས་བཞེས་ཏེ་ཚོགས་འཁོར་རྒྱས་པ་གནང་ཞིང་།",
    "དེའི་ཕྱི་དྲོ་ནས་ལས་གཤིན་གྱི་ལྗགས་བཟླས་ལ་འགྲུས་པར་མཛད།",
    "བདུད་ལས་རྣམ་པར་རྒྱལ་བའི་ལྷ།",
    "སྒོ་གསུམ་གཡེངས་པའི་སྦུབས་སུ་མ་ཆུད་པར།",
    "བྱས་ཏེ་སྐལ་བཟང་ཀུན་དགའི་ལོངས་སྤྱོད་རྒྱས།",
    "བཅུ་གཅིག་ལ་རྐྱང་ཚའི་ཆབ་ཚན་དུ་ཕེབས་པའི་ཞོར་ལ་ལ་བཙས་ལ་གཏེར་འབུལ་དང་བསང་གཏོང་སོགས་ཡོན་བདག་སོ་སོའི་འདུན་པ་བསྐངས།",
    "བཅུ་དྲུག་ནས་ཉིན་བདུན་གྱི་རིང་ཆབ་བཞུགས་དང་།",
    "མཇུག་ཏུ་ཚོགས་ཀྱི་འཁོར་ལོ་དང་བསང་སོགས་ཀྱིས་འདས་མ་འདས་ཀྱི་ལྷ་མི་མཐའ་ཡས་པ་ཚིམ་པར་མཛད།",
    "ཕྱི་ཉིན་ཡབ་སྲས་ལྷན་དུ་མཆོད་མཇལ་ལ་ཕེབས་ནས་ཐུགས་སྨོན་གྱི་མཚམས་སྦྱོར་དང་།",
    "གྲོ་ཞུན་ཟླ་བའི་ཚེས་གཅིག་ནས་བཟུང་སྲོད་དུས་རྣམས་སུ་དཀྱིལ་ཆོག་དགོངས་པ་རབ་གསལ་གྱི་སྟེང་ནས་དུས་འཁོར་གྱི་ས་ཆོག་ནས་རྡུལ་ཚོན་གཤེགས་གསོལ་གྱི་བར་ཕྱག་ལེན་ཞི་བཏིག་ཆ་ཚང་བར་གསན་བཞེས་དང་།",
    "ཁ་གྱ་རི་ཁྲོད་པ་རྗེ་འདིའི་ཞབས་བརྟན་དུ་ཆེད་དམིགས་ཀྱིས་ལོ་བདུན་མཚམས་བཅད་བྱས་པའི་སྒྲུབ་ཁང་དུ་ཞག་བཞུགས་གནང་།",
    "སྐེད་རྒྱུད་རྣམས་སུ་འཕྲིན་ལས་ཀྱི་འཇུག་པ་གདུལ་བྱའི་སྐལ་བ་དང་འཚམ་པར་བསྐྱངས་རྗེས་བསུ་བ་སེར་སྦྲེང་དང་བཅས་རྒྱལ་ཟླའི་དགའ་བ་དང་པོར་གདན་སར་ཕྱགས་ཕབ་ཅིང་།",
    "ལམ་བར་རྐ་ཆུ་ཁ་དང་གཅའ་རོ་ལ་ཕེབས་བཞུད་དང་།",
    "ཉེར་བདུན་ལ་རྒྱལ་བློན་སོགས་སེར་སྐྱ་མང་བོའི་ཆིབས་སྐྱེལ་དང་བཅས་བཞུགས་སྒར་བཏེགས།",
    "དབོ་ཟླའི་ཚེས་གཉིས་ལ་མཆོད་ཡོན་ལྷན་རྒྱས་བྲག་དཀར་ལ་བཙས་བསྟད་དེ་བསང་བཏང་ཞིང་གཉན་རྒོད་ཐང་དུ་ཉིན་འགར་བཅགས་མལ་བྱས་སྒང་གདན་སའི་གྲྭ་ས་སོ་སོའི་འཚམས་ཞུ་བ་འབྱོར།",
    "བཅུ་དགུ་ལ་མཁར་དགུའི་ང་རོ་དཔོན་སྲས་སོགས་ཀྱིས་སྐྱེལ་ཐུང་དང་བཅས་བཞུགས་སྒར་བཏེགས།",
    "བསུ་རིམ་དང་བཅས་ཉེར་གཅིག་ལ་རོང་ཆེན་ལྗགས་ནག་པའི་གདན་ས་ཁྱད་པར་ཅན་མ་དགོན་དུ་ཕྱགས་ཕེབས།",
    "ནག་ཟླའི་ཚེས་བདུན་ལ་བཅད་རྒྱ་གྲོལ་བསྟུན་རྔ་བའི་དགོན་གསར་དང་མཆོག་རྩེ་རྒྱལ་པོ་ནས་མངགས་པའི་འཚམས་ཞུ་བ་སོ་སོར་མཇལ་ཁ་གནང་།",
    "མཆོག་རྩེ་རྒྱལ་པོར་འདོད་བསྟུན་གྱི་བཀའ་ལན་དང་སྦྲགས་སྐུ་བརྙན་དང་བཞེས་འཕྲོའི་སྐུ་འགག་སོགས་སྐུར་གནང་མཛད།",
    "བཅུ་དགུ་ལ་འཁྲུངས་གཞིས་སུ་བཞུགས་གདན་ཕབ་ནས།",
    "ཉེར་ལྔ་ལ་བཞུགས་སྒར་བཏེགས་ཏེ་ཉེར་བདུན་ལ་མཁར་དགུའི་འབྲོག་རུའི་དཔོན་ཚང་དུ་ཞག་བཞུགས་སྟེང་རིམ་གྲོ་སོགས་གསུངས་པར་ཡོན་འབུལ་རྒྱ་ཆེར་བསྟར།",
    "རྒྱལ་པོ་ཆེན་པོ་དཔལ་མགོན་འཕྲིན་ལས་པར།",
    "ཆབ་འབངས་ཀྱི་བདེ་སྐྱིད་སྤེལ་ཚུལ་སོགས་ཞལ་བཀོད་མཐིལ་ཕྱིན་པར་སྩལ།",
    "འདེབས་པའི་རྩལ་ལ་ཚིམས་པ་མེད་པར་སྦྱངས།",
    "མགོན་འདིའི་སྤངས་རྟོགས་དཔོག་པར་མི་འགྱུར་རམ།",
    "ལྷ་ཁང་སོ་སོར་མཆོད་མཇལ་དང་སྦྲེལ་ཐུགས་སྨོན་མཛད་པར་བརྟེན་མི་རིང་བར་ཉིན་འགར་ཆར་བསྟུད་མར་འཇོ་བ་བྱུང་བས་ཞིང་པ་རྣམས་ཤིན་ཏུ་ཚིམས།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "རྗེ་བློ་བཟང་འཕྲིན་ལས་པའི་གསུང་འབུམ་དང་དངོས་སྐྱེས་ཀྱི་རྫོངས་པ་གནང་།",
    "དེ་ལ་མཁས་པར་གྱུར་པ་ན།",
    "རྒྱལ་ཟླའི་མཇུག་པར་གསན་བསམ་རྒྱུན་མ་ཆད་པར་འགྲུས་པར་མཛད།",
    "མི་མཁྱེན་པའི་ཚུལ་གནང་བ་དང་།",
    "ཡོངས་འཛིན་དམ་པ་སླར་ཕེབས་སྐབས་རྗེ་འདིས་སྐྱེལ་ཐུང་དང་།",
    "ལྷ་དར་རྩེ་སྤྲོད་གནང་ཞིང་འབྲལ་མི་ཕོད་པའི་རྣམ་པ་མཛད།",
    "དེ་གའི་སེར་མང་ནས་ཞུས་ངོར་ལྷ་ཆེན་གུར་དཀར་གྱི་བསང་མཆོད་གསར་རྩོམ་གནང་སྟེ་བསང་བཏང་བར་ཞིང་སྐྱོང་དགའ་བའི་རྟགས་མང་དུ་ཤར།",
    "མྱུར་འབྱོན་སྨོན་ཚིག་ལྗགས་རྩོམ་ངོས་ཐུགས་སྨོན་མཛད་ཉེར་བཞིའི་ཉིན་དཀྱིལ་འཁོར་རྒྱ་མཚོའི་མངའ་པར་དངོས་འབུལ་བསྟར།",
    "ཕེབས་ཉིན་སྐུ་དབོན་ཆེ་བས་གཙོས་ཞབས་ཕྱི་དྲག་རིམ་གྱིས་བསུ་བ་འདུས་པ་རྒྱ་མཚོའི་སེར་སྦྲེངས་རྗེ་རང་ནས་བསུ་ཐུང་སྟེང་མཇལ་དཪ་རྩེ་སྤྲོད་བཅས་རི་ཁྲོད་གཟིམས་ཆུང་གསར་བར་ཕྱགས་ཕབ་པར་གསོལ་སྟོན་སྟེང་ཡབ་སྲས་ཐུགས་ནང་གཤིན་པའི་གསུང་འཕྲོས་མང་དུ་མཛད།",
    "མཚོ་གཏེར་བསང་མཆོད་སོགས་འདོད་བསྟུན་གནང་ཞིང་དབྱུག་ཟླའི་བཅུ་གཅིག་ལ་གདན་སར་འབྱོར།",
    "མགོན་པོའི་རྗེས་གནང་།",
    "གྲུབ་ཆེན་བརྒྱད་ཅུའི་རྗེས་གནང་།",
