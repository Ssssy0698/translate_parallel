    "ཤེས་བྱ་མ་། དངོས་པོའི་འདུག་ཚུལ་འབེབས་ཤིང་།",
    "ཡང་བསམ་གྱིས་མི་ཁྱབ་པར་བཞུགས་འདུག།",
    "ཁྱེད་རང་རྣམས་མང་ཡུལ་སྐྱིད་གྲོང་དུ་འདོང་།",
    "འདི་རྣམས་མི་གདའ།",
    "གྲོགས་མེད་གཅིག་པུར་འདུག་ལ་འདུས།",
    "འདིར་ནི་རང་བཞིན་རྫོགས་པ་ཆེན་པོའི་འདུག་སྟངས་གསུམ་གྱིས་གཟེར་བསྡམ།",
    "གང་ཤར་ཀྱང་རང་བཞིན་གྱིས་མ་གྲུབ་པར་གསུམ་ག་ཟུང་འཇུག་ཆེན་པོར་ཤེས་པར་གྱིས་དང་།",
    "དགའ་བར་འགྱུར་བའི་རྫིང་བུ་སོགས་ཡིད་དགའ་དགའ་ལྟར་འདུག་པ།",
    "སོགས་བློ་སལ་གཞན་གྱིས་ཀྱང་ལན་མང་དུ་བསྒྲགས་ནས་ནན་ལྕགས་ཐར་གསུམ་གྱིས་ཞུ་དག་བགྱིས་ཤིང་རང་ཉིད་ཀྱིས་ཀྱང་ལན་གྲངས་དུ་མར་ནན་ཏན་གྱིས་དཔྱད་ཞུས་ཀྱིས་གཏན་ལ་ཕབ་པའི་རྩིས་ཡིན་ཀྱང་རྒྱུད་རྣམ་གས་སང་བཧཱུྃ",
    "རྫོགས་པ་ཆེན་པོ་ངེས་དོན་རིག་པའི་གསུང་རང་བྱུང་བདེ་བའི་འཁོར་ལོ་ལེའུ་སོ་གསུམ་པ་བི་མ་ལ་དང་པ་དེཧ་། གཉགས་ཀྱིས་བསྒྱུར་བ།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནས་བསྒྱུར་བ།",
    "བོད་ཀྱི་བནྡྷེ་བེ་རོ་ཙ་ནས་བསྒྱུར་བ།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་དགེ་སློང་བེ་རོ་ཙ་ནས་དྷ་ཧེ་ནའི་འདུ་ཁང་རྙིང་རྒྱུད།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་པ་གོར་བེ་རོ་ཙ་ནས་བསྒྱུར་བ།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནས་བསྒྱུར་བ།",
    "རྡོ་རྗེ་སེམས་དཔའ་ནམ་མཁའ་ཆེ་རྒྱས་པ་ཡི་གེ་མེད་པའི་རྒྱུད་ལེའུ་བརྒྱད་པ་བོད་ཀྱི་དགེ་སློང་བེ་རོ་ཙ་ན་དང་།",
    "བོད་ཀྱི་དགེ་སློང་བེ་རོ་ཙ་ནས་བསྒྱུར་བ་ལ་ཕྱིས་སྐད་གསར་བཅད་ཀྱིས་ཀྱང་བཅོས་པ།",
    "བོད་ཀྱི་དགེ་སློང་བེ་རོ་ཙ་ནས་བསྒྱུར་ཅིང་གཏན་ལ་ཕབ་པ་ལ་ཕྱིས་སྐད་གསར་བཅད་ཀྱིས་ཀྱང་བཅོས་པ།",
    "ལེའུ་ཞེ་ལྔ་པ་དྷ་ན་སཾ་སྐྲྀ་ཏ་དང་བེ་རོ་ཙ་ནས་བསྒྱུར་བ།",
    "ཉ་ནང་ལེའུ་བཅུ་དྲུག་ཅན་ཡོད་ཀྱང་འདི་དང་འདྲ་མིན་འདུག་པས་བཞག།",
    "སྤྱི་དངོས་པོ་བ་མེད་པའི་ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས་ཏེ།",
    "ཐ་སྙད་ཀྱི་དུས་སུ་བཞོ་བཀལ་ལ་སོགས་པའི་དོན་བྱེད་པའི་བ་ལང་རང་མཚན་པ་རྣམས་ལ་མི་བསླུ་བར་ཡོད་པར་འདོད་ཏེ།",
    "རིགས་མཐུན་མི་མཐུན་གྱི་དངོས་པོ་ཀུན་ལས་ཐ་དད་པའི་བ་ལང་རང་མཚན་ནས་བརྒྱུད་ནས་བརྟེན་པ་ཅན་ཡིན་པའི་ཕྱིར།",
    "བ་ལང་རང་མཚན་པ་ལ་བརྒྱུད་ནས་བརྟེན་པ་ཅན་ཡིན་ཏེ།",
    "བ་ལང་རང་མཚན་པ་ལས་བརྒྱུད་ནས་བརྟེན་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྐྱེས་བུས་བྱས་པར་གྲུབ་པའི་འཇིག་རྟེན་པའི་ངག་ཚིག་གཞན་དང་རང་བཞིན་མཚུངས་པའི་ཕྱིར།",
    "ནམ་མཁའ་རྟག་ཀྱང་རང་འཛིན་ཤེས་པ་བསྐྱེད་པར་མཐོང་བའི་ཕྱིར་ཞེ་ན།",
    "རང་རྒྱུ་ཀུན་སློང་རིམ་ཅན་གྱི་འབྲས་བུ་དང་རང་འཛིན་པའི་སེམས་ཉན་ཤེས་རིམ་ཅན་གྱི་རྒྱུ་ཉིད་དུ་གྲུབ་པའི་ཕྱིར།",
    "འབྲས་བུ་མི་བསྐྱེད་པའི་གནས་སྐབས་དང་རང་བཞིན་ཁྱད་པར་མེད་པའི་ཕྱིར།",
    "གལ་ཏེ་ཞིང་དང་ཆུ་ལུད་ལ་སོགས་པ་རྣམས་མྱུ་གུ་མི་བསྐྱེད་པའི་གནས་སྐབས་དང་རང་བཞིན་ཁྱད་པར་མེད་ཀྱང་མྱུ་གུས་བསྐྱེད་པའི་རང་བཞིན་ཁྱད་པར་མེད་པའི་རྟགས་མ་ངེས་སོ་ཞེ་ན།",
    "སྡུག་བསྔལ་མྱོང་བ་པོ་དང་དེ་ལས་གྲོལ་བ་པོའི་བདག་དོན་ལ་མེད་ན་ཡང་རང་སྡུག་བསྔལ་ལས་གྲོལ་བར་བྱ་བའི་ཕྱིར་དུ་ལམ་ལ་བརྩོན་དགོས་ཏེ།",
    "གསལ་བ་ཡོད་མེད་དུས་ཀུན་གྱི་ཚེ་ཡང་རང་འཛིན་ཤེས་པ་བསྐྱེད་པའི་ནུས་པ་མེད་པར་འགྱུར་རོ།",
    "ཐོག་མ་མེད་པའི་དུས་ཅན་གྱི་ཤིང་རང་མཚན་མཐོང་བ་གོམས་པའི་བག་ཆགས་ཀྱིས་སྤྲུལ་ཞིང་བསྐྱེད་པའི་སྒོ་ནས་སྣང་བརྟགས་གཅིག་ཏུ་ཞེན་པ་ཡིན་པའི་ཕྱིར།",
    "ཤིང་རང་མཚན་མཐོང་བའི་བག་ཆགས་ལས་བྱུང་བའི་འཁྲུལ་པའི་སྣང་བ་ཡིན་པའི་ཕྱིར།",
    "དེ་དང་རང་རྒྱུ་རྐྱེན་གསུམ་མཚུངས་པ་ལས་བྱུང་བ་ཅན་ཡིན་པའི་ཕྱིར།",
    "རང་རང་རིག་བྱ་ཐ་དད་ཀྱི།",
    "གལ་ཏེ་སྔོ་སོགས་དེ་བདེ་སོགས་དང་རང་བཞིན་གཅིག་པའི་ཕྱིར་དེ་གཉིས་ཤེས་པས་ཅིག་ཆར་འཛིན་ཞེ་ན།",
    "ད་རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རང་འཛིན་མངོན་སུམ་དང་རང་དྲན་པའི་ཤེས་པ་དེའི་དུས་ན་ཁྱེད་རྣམས་ཞིག་ནས་མེད་པའི་ཕྱིར་ཏེ།",
    "བློ་ཚུལ་གཉིས་སྒྲུབ་པར་བྱེད་པའི་རིགས་པས་དུས་ཕྱིས་དོན་རྟོགས་ཐ་དད་དུ་དྲན་པའི་རྟགས་ཀྱིས་ཀྱང་རང་རིག་པ་ཕལ་ཆེར་ཞར་ལ་གྲུབ་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་དེ་ཡང་རང་ལས་རྫས་གཞན་གྱི་ཤེས་པ་ཕྱི་མས་མྱོང་ངོ་ཞེ་ན།",
    "དེ་མི་ནུས་པ་ལས་གཞན་དུ་ནུས་ན་ཡུལ་ཕྱི་རོལ་གྱི་དོན་ནི་ཉེ་བ་ན་དེ་ཉེ་བའི་ཕུང་པོ་ལྔ་ཆར་ཅན་གྱི་སྐྱེས་བུ་འགས་ཀྱང་རང་བློ་མྱོང་བར་མི་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "རང་འཛིན་ཤེས་པའི་ཉེར་ལེན་དང་རང་མྱོང་བའི་ངོ་བོར་གནས་པ་ནི་ནང་སེམས་ཀྱི་གཟུང་བའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར།",
    "རྒོལ་བའི་འདོད་ཡུལ་བསྒྲུབ་བྱར་ཤེས་པའི་དོན་དུ་ཡང་རང་སྒྲ་སྨོས་མི་དགོས་པར་འགྱུར་ཏེ་མ་སྨོས་ཀྱང་རྒོལ་བའི་འདོད་ཡུལ་བསྒྲུབ་བྱར་བྱེད་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེ་ལ་ལྟོས་པ་མེད་པར་ཡང་རང་འབྲས་ཉན་ཤེས་བསྐྱེད་པའི་ཕྱིར་ཏེ་རྟག་པའི་ཕྱིར་རོ།",
    "སེམས་ཀྱི་ངོ་བོ་སྟོང་གསལ་འདུས་མ་བྱས་པ་དེ་ཀའི་ངང་དུ་ཤིག་གེར་འདུག་པ་ལ་གནས་པ་དང་།",
