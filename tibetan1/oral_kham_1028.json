    "ཀུན་དགའ་བོས་ཐོས་པས་སྦྱིན་བདག་ཅིག་དེ་ལ་ཟན་སྦྱིན་དུ་བཅུག་པ་དང་དེའི་ལས་ངན་གྱིས་ལས་དེས་བརྗེད་པ་དང་ཉིན་གསུམ་སྨྱུང་བར་འདུག་གོ།",
    "མིའི་ལུས་ཀྱི་དབྱིབས་སུ་འདུག་པ།",
    "ངས་ནི་འཕྱེ་བོ་ཁྲི་ལ་འདུག་པ་ཁྱེད་ས་ཇི་ཙམ་རྙེད་པ་ཀུན་བྱིན་ནས།",
    "བལྟས་མཁན་ལ་དྲིས་པས་ཁོང་ན་འདུག་པའི་མཐུར་བསྟན་ཏོ།",
    "ཡང་རི་སྤོས་ངད་ལྡང་ལ་རྨ་བྱ་བལྟས་སྡུག་ཅེས་བྱ་བ་ལྡིང་བས་སྟོན་པ་མཐོང་སྟེ་བབས་ནས་ཞབས་དྲུང་དུ་འདུག་གོ།",
    "མ་དག་པ་དེའི་མདུན་དུ་འདུག་སྟེ་ཚེ་དང་ལྡན་པ་དགོངས་ཤིག།",
    "དག་དང་མ་དག་རང་རང་བྱེད།",
    "འདིར་འདུག་ན་ནི་སྔ་མ་དེ་རྣམས་ཀུན་གྱིས་འཚེ།",
    "བྱིས་པའི་ནང་ན་འདུག་པ་ཚུལ་བཞིན་མ་ཡིན་པའི་སེམས་དང་ལྡན་པ།",
    "ཁྱེའུ་ཡིན་ན་ནི་གཡས་ལོགས་ནས་ཙོག་པུར་ལག་པ་གཉིས་གདོང་ལ་བཀབ་ནས་སྒལ་བ་ལ་བལྟས་ཏེ་འདུག་གོ།",
    "རྫིང་ན་འདུག་པའི་འདུ་ཤེས་སོ།",
    "སྦལ་པ་དྲུང་ན་འདུག་པ་དེ་ལྟ་མིན།",
    "ཡང་རང་བཞིན་གྱིས་ཡིད་དུ་མི་འོང་ཞིང་མི་མཐུན་པ་པའི་གནས་དང་།",
    "ཀ་ཡིད་དུ་འོང་ཡང་འདུག་མི་བྱེད།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་ཐམས་ཅད་ཟིལ་གྱིས་གནོན་པས་རྒྱལ་པོ་ལྟ་བུའོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བ་དང་།",
    "ཟུང་དུ་འབྲེལ་བ་གཉིས་ཀྱིས་ཉན་ཐོས་དང་རང་རྒྱལ་ཟིལ་གྱིས་གནོན་ཏེ་ཐབས་དང་ཤེས་རབ་བོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་ལས་ཁྱད་པར་དུ་འཕགས་པ་ལྔ་སྟེ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བའི་རྣལ་འབྱོར་པ་དང་བསྟེན་པ་དང་།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བའི་སེམས་དང་འབྲས་བུ་ལ་འཇིགས་པར་ལྟ་བར་གྱུར་ཅིག།",
    "ཙོག་ཙོག་པོར་འདུག་ཀྱང་རུང་།",
    "དག་དང་མ་དག་རང་རང་བྱེད།",
    "ཐེག་མཆོག་དུས་གསུམ་རྒྱལ་སྲས་ལམ་གྱི་སྡོམ།",
    "ཀ་དག་ཅད་ཟིལ་གྱིས་གནོན་ཏེ་ལྷག་གེར་འདུག་གོ།",
    "དམིགས་པ་ལ་འདུག་པ་ཐོབ་པ་དང་།",
    "བསླབ་པའི་གཞི་ལྔ་ལ་གནས་པ་དང་བརྟན་པོར་འདུག་པ་དང་མི་ལྷོད་པར་གནས་པར་བསླབ་བོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་དུ་བསྔོ་བ་དང་།",
    "ཡལ་བར་བོར་ཞིང་མི་འདུག་གོ།",
    "ཡང་རང་ལ་སྲོག་ཡོད་པས་དེ་གཅོད་པ་དང་།",
    "ཡང་རང་གཅིག་པུའི་དོན་དང་ཕན་པ་འདོད་པས་ཀྱང་གཞན་ལ་གནོད་པ་དང་ཁྲོ་བར་མི་རིགས་ན།",
    "འགྲོའམ་འཆག་གམ་ཉལ་ལམ་འདུག་པ་ན་ཡང་ཞི་གནས་མི་འདོར་རོ།",
    "གྱུར་རྣམས་ཀུན་རིག་དུས་གསུམ་ཤེས་པ་ཡིན།",
    "སོ་སོར་རྟོག་དང་རང་བཞིན་ཉིད་སྟོབས་ལས།",
    "ཡང་ཉན་ཐོས་ལ་སོགས་པ་དང་འགྲོགས་ན་དགའ་བར་མི་བྱེད་ཅིང་རང་བས་དེ་དག་རྙེད་པ་དང་བཀུར་སྟི་ཆེ་བར་གྱུར་ཀྱང་རྒྱུ་གཉིས་ཀྱི་བདག་ལ་རྟོག་སྟེ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ངེས་པ་དང་།",
    "དེ་བཞིན་དུ་ཉན་ཐོས་དང་རང་རྒྱལ་གྱིས་སྤང་བ་དང་།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་ཡིད་ལ་བྱེད་པ་ཐམས་ཅད་དང་།",
    "སྒྲུབ་ཅིང་འདུག་པ་ན་ཁྱིམ་ལ་ལྟ་བ་མེད་པའོ།",
    "འཆག་ཅིང་འདུག་དང་འགྲེང་དང་ཉལ་བ་ནའང་།",
    "གང་རང་བཞིན་གྱིས་སྟོང་པ་དེ་གདགས་སུ་མེད་པའོ།",
    "བློས་མ་བཞག་པར་གྲུབ་པ་དང་རང་མ་གྲུབ་བཞིན་དུ་བློས་བཞག་པ་ཙམ་དག་ཕན་ཚུན་རྣམ་པར་གཅོད་པའི་འགལ་བ་ལས་གཉིས་ཁོ་ནར་གྲུབ་ཅིང་གཞན་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "གསུངས་ཞེས་བྱ་བ་ནི་བདེན་པའི་དབྱེ་བ་འདི་ཡང་རང་དགར་བཞག་པ་མ་ཡིན་གྱི།",
    "ལྷ་དང་ལྷ་མིན་འགྲོ་བ་རྣམས་ནི་འདིར་བརླག་གོ།",
    "དེ་ནི་འཆག་འདུག་འགྲེང་ཞིང་གནས་པའི་ཚེ།",
    "ས་ཆེན་པོའི་འབྲུ་ལྟར་ཉན་ཐོས་དང་རང་རྒྱལ་དམིགས་པ་ཅན་ཐམས་ཅད་ཀྱི་ཟག་པ་མེད་པ་རྣམ་པར་གྲོལ་བའི་འབྲས་བུ་དང་།",
    "ལེགས་སྤོང་རང་གཞན་དོན་ཀུན་མྱུར་བར་འགྲུབ།",
    "སྒྲ་ལ་འཆེལ་ཞིང་འདུག་པར་མ་བྱེད་པར།",
    "འདོད་ཆགས་ཞེ་སྡང་རང་བཞིན་སྟོང་པ་ཉིད།",
    "འདིར་ཉམས་སུ་མྱོང་བའམ་རྣམ་པར་རྟོག་པ་ལའང་རུང་སྣང་བ་ཙམ་འགོག་ན་ནི་ཐམས་ཅད་དུའང་རང་རིག་པ་དང་།",
    "དེ་ལྟར་ན་བརྟགས་ཤིང་དཔྱད་ནས་འཇུག་པ་དང་མ་བརྟགས་པའི་ཚུལ་མི་མཐུན་པས་མི་སྣང་བར་བརྗོད་པ་ཡང་རང་དགར་ཟད་དེ།",
    "རང་ཉིད་གསལ་བ་ཙམ་མྱོང་རང་རིག་སྟེ།",
    "གཅིག་དང་དུ་མ་མེད་པ་དང་རང་བཞིན་མེད་པ་ཉིད་ཀྱང་བྱས་པ་དང་མི་རྟག་པ་ལྟར་ལྡོག་པ་ལ་ལྟོས་པའི་ཐ་དད་པ་བློའི་ཡུལ་དུ་གྲུབ་པའི་ཕྱིར་རོ།",
    "གཞན་ཡང་རང་བཞིན་བྱས་མིན་ལྟོས་འགལ་ཕྱིར།",
    "རང་དང་གཞན་གྱིས་ཡང་དག་པར་ཡོད་པར་སྨྲས་པའི་དངོས་པོ་ཐམས་ཅད་ལའང་རང་ལ་སོགས་པ་ལས་སྐྱེ་བ་མེད་པས་སོ།",
    "འོན་ཀྱང་རང་བཞིན་གྱིས་མེད་པ་དང་ཡོད་པ་ལ་ནི་རིམ་གྱིས་ཀྱང་ཡོད་པ་དང་མེད་པ་འགལ་བ་ཉིད་དོ།",
    "དེས་ན་ནུས་པ་སོ་སོར་ངེས་པ་ཁས་བླངས་ཀྱང་རང་བཞིན་འགལ་བ་ནི་བྱ་བར་ནུས་པ་མི་སྲིད་དེ།",
    "གོམས་པའི་འཇུག་ཐོགས་པ་དང་རང་བཞིན་ཁྱད་པར་མེད་པའི་རྣམ་རྟོག་ཡིན་པའི་ཕྱིར།",
    "ཁྱད་པར་དུའང་རང་གཞན་ལ་སྡུག་བསྔལ་གྱི་རྒྱུན་མི་ཉུང་བར་འཕེལ་བའི་རྒྱུ་ལོག་པའི་བསྟན་བཅོས་བྱེད་པ་དང་དེའི་རྗེས་སུ་འཇུག་པ་རྣམས་ལ་དེ་ལྟ་ཁོ་ན་མཆོག་གཏན་ལ་ཕེབས་པ།",
    "སྦྱིན་པ་པོས་ཀྱང་རང་རིག་པ་དང་གཞན་རིག་པས་ཐམས་ཅད་ཤེས་པར་ནུས་སོ་ཞེས་བསམ་པའོ།",
    "མེད་དང་ཡོད་དང་རང་བཞིན་སྟོང་པ་དང་།",
    "ཁོང་དུ་ཆུད་པ་དེའང་རང་དང་སྤྱིའི་མཚན་ཉིད་ལ་རྣམ་པར་མི་རྟོག་པས་རྒྱུ་བ་མེད་ཅིང་སྐྱེ་བ་མེད་པའི་ཤེས་རབ་ལས་སྐྱེ་བ་མ་གཏོགས་པ་གཞན་ལས་མ་ཡིན་ལ།",
    "འདིའི་ཕན་ཡོན་གྱི་ཁྱད་པར་ནི་གསེར་དེ་ཉིད་མགར་བ་མཁས་པས་སྲེལ་ན་དྲི་མའི་བག་ཀྱང་ཟད་ཅིང་སྐྱེ་འབྲིང་མེད་པར་སྲང་དྲངས་ཚད་བཞིན་འདུག་པ་ལྟར།",
    "དེ་ཉིད་ཀྱང་དུ་ཟིན་ཀྱང་རང་བཞིན་རྟོག་པར་མ་ནུས་པས་བསམ་གྱིས་མི་ཁྱབ་པ་ཉིད་དེ།",
    "གཞན་དོན་དང་རང་དོན་སྔ་ན་མེད་པ་སྐྱེ་བ་དང་།",
    "འགྲོ་ལ་ཕུན་ཚོགས་ཕན་བདེའི་གཞི་འདུག་ན།",
    "སྒྲུབ་བོ་བདེ་བའི་སྟན་འདུག་ནས།",
    "དེལྟརགསུས་པ་ཡིན་འདུག།",
    "གནསཔ་དེ་ཡང་རང་བབས་སུ་གནས་པའི་ངོ་བོ་མ་བརྗེད་ཙམ་དུ་དྲན་འདུན་གྱིས་སྐྱོང་བ་ལས།",
    "འདུགནའདུག་གོ་ཞེསབྱ་བར་རབ་ཏུ་ཤེས་སོ།",
    "འགྲེངས་པ་དང་འདུག་པའང་ཤེས་བ།",
    "ཉལ་འདུག་ཀྱང་དེ་ཐོག་ཏུ་སེམས་མ་ཡེངསབ་སྟེ།",
    "ཞེསགསུངས་འདུག་པ་འདི་ཐུགས་ཤིན་ཏུ་བདེན་ཏེ།",
    "དེ་ཡངསེམས་ཁོ་རང་རང་ལུགས་མ་བཅོས་པར་བཞག་ཀྱང་།",
    "རྣམ་རྟོག་ཁོ་རང་གང་འགྱུ་འགྱུར་བཅུག་ནས་རྫི་བོ་མཁས་པས་ཕྱུགས་འཚོ་བ་བཞིན་དུ་ལྷོད་ཆ་གཙོ་བོར་བཏོནམས་སྐྱོང་བ་གལ་ཆེ།",
    "མ་ཡེངས་རང་བཞིན་ཤེས་ཙམ་དེ་ལས་གཞན་པའི་བཟོ་བཅོས་མི་བྱེད་པ་མ་བཅོས་པར་འདུག་བརྒྱུན་འཚོ་བྱེད་པ་དེ་ཀའི་རྒྱུན་ལྷོད་ཆ་གུ་ཡངས་དེ་ཀ་ལྷུག་པར་སྐྱོང་དགོསཔ་ཡིནཏི།",
    "བཀག་པས་ཁེགས་པ་མི་འདུག་དིང་རི་བ།",
    "དེ་ཡང་བྲམ་ཟེ་ལྟ་བུ་རུང་བས་བཀལ་བའི་སྐུད་པ་དེ་གྲིམས་ལྷོད་སྙོམས་པའི་དཔེ་རུ་འཇོག་དགོས་པ་ཡིན་པར་འདུག།",
    "གཉིས་འཛིན་བྱ་རྩོལམེད་པའི་སེམས་ཀྱི་ངོ་བོའང་ཆས་རང་བབས་ཀྱི་ཐོག་ཏུ་ཤིགས་སེ་ཀློད་མཉམ་བར་རང་ལུགས་སུ་འཇོག་རྒྱུ་ནཡིན་པར་འདུག།",
    "རྣམ་རྟོགཞམ་དྲན་དྲན་དེར་ངོས་བཟུང་ལ་ཁོ་རང་ཐོག་ལ་གློད་ལ་ཞོག།",
    "གཞན་རྟགས་གང་ཡང་མེད་པའི་སྙོམསསྙོམས་ཤིག་དང་མི་འདྲབ་ཡིན་འདུག།",
    "དེ་ཀདྲན་པས་ངོས་བཟུང་ཁོ་རང་ལ་སྒོམགྱི་དངོས་གཞི་བཅོལ་ནས་བསྐྱང་།",
    "དེ་ཀར་ཉམས་ལེན་གྱི་མཐིལ་སོའང་བྱསཞ་ཆོག་པར་འདུག་བསམ་པའི་གོ་བ་བླངསདང་རང་ཐག་བཅད་པ་སྔོན་དུ་བཏང་ནས།",
    "དེ་བཞིན་ཡིད་ཀྱི་ཡུལ་དུ་ལེགས་ཉེས་བཟང་ངན་ཕྲ་རགས་ཀྱི་རྣམ་རྟོག་ཅིཤར་ཡང་རང་སེམས་ཡིན།",
    "དེ་ཀའཛིན་པའི་རྣམ་རྟོག་ཡིན་པས་འཇོན་པའི་རྣམ་རྟོག་ཁོ་རང་ངོས་བཟུང་སྟེ་དེ་ཐོག་ཏུ་གློད་དེ་འཇོག།",
    "ཇི་ལྟར་འདུག་པ་དེ་ཀ་རང་ཉམས་སུ་ལེན་པ་ཡིན།",
    "ཞེསྡང་རང་གྲོལབསྟེ།",
    "འཇིག་རྟེན་ཕལ་པ་དང་ཁྱད་མེད་པས་ཡོད་འདུག་པའི་མཆང་དང་སྐྱོན་ཤིན་ཏུ་ཆེ་བ་དང་།",
    "དྲ་ཐོག་ཏུ་བཟང་རྐྱེན་དེ་ལམ་དུ་མི་སློང་བ་སོགས་སྣ་ཚོགས་ཡོང་བར་འདུག་སྟེ།",
    "ཅེས་གསུངས་པ་ནི་སྐྱིད་སྡུག་ལམ་ཆེན་གཏོང་ལེན་དང་བསྒྲགསཔ་ཤིན་ཏུ་ལེགས་པར་འདུག་པའི་དོན་ཉམས་སུ་ལེན་ན།",
    "གཞན་ཡང་ལས་དང་འགྲོའདུག་དྲག་པོ་བྱས་པས་ཐང་ཆད་པ་དང་།",
    "སྤྱིར་དོན་དམ་གཏོགས་འཁྲུལཔ་ལོས་ཡིན་ཏེ།",
    "དེངརང་ཕྱག་ཆེན་གྱི་ནང་ན་སྤྱི་ཙམ་མ་གཏོགས་སཐམས་ཅད་རྒྱས་པ་སོ་སོར་མི་འདུག་སྟེ།",
    "དེའི་དོན་མུ་སྟེགས་ལྷག་སྤྱོད་པས་ལོའཅུགཉིས་སུ་ཏིང་ངེ་འཛིན་གཅིག་ལ་གནས་པ་དེའི་ལག་པར་བྱི་བས་ཚང་བཅས་ཏེ་བཅད་པ་ཞེསྡང་སྐྱེསཔས་སླར་དུདའགྲོར་སྐྱེསཔ་ཡིན་འདུག།",
    "ངོ་བོ་ས་བཟུང་དང་བྲལ་བ་ཞིག་ཡིན་འདུག་པ་ལ།",
    "རང་བྱུང་རང་ཞི་དང་སྨྲའོ།",
    "འདི་ལྟར་རྟོགས་པའི་ལྷག་མཐོང་གཤའམ་འདི་རྟོགས་ཕྱིན་ཆད་གཞན་གྱི་བྱ་རྩོལ་མི་དགོས་པ་ཞིག་འོང་བར་འདུག་པའོ།",
    "བལྟ་བྱ་ལྟ་བྱེད་གཉིསམེད་དུ་ལ་བཟླ་བའི་དོན་ཇིབཞིན་རྟོགས་པ་དེ་ཡིན་པར་འདུག།",
    "འོན་ཀྱང་འདིར་འཕྲལ་རྟོགས་སླརྒྱུས་དཔྱད་པར་གསུངས་འདུག་པ་དེ་ལྟར་དང་།",
    "ལུས་མཉམ་བཞག་དང་འབྲལ་བར་བྱེད་དགོས་པར་འདུག་ཅི་ལྟར་དཔྱད་པའི་ཚུལ་དེའང་དཔེར་ན་བསམ་བློ་གཏོང་བ་ལྟ་བུ་ཞིག་བྱས་ན་དོན་མེད་པ་ཁ་ཕྱིར་བལྟས་ཡིན།",
    "དེའི་རྣམ་པ་འཇའ་འོད་དང་ཉི་ཟླདང་མར་མེའི་འོད་ལྟ་བུར་འདུག་གམ་སོག་ལག་པ་བརྟག།",
    "འོད་མདངས་མེད་པ་འདྲ་ནའང་གསལ་དུ་འདུག་གམ་བརྟག།",
    "སྣང་ཡང་རང་བཞིན་མེད།",
    "ཇི་ལྟརཡལ་འདུག་སོགས་ལེགས་པར་བརྟགས།",
    "ཐམས་ཅད་རང་སྣང་རང་གྲོལ་ཡིན།",
    "དེའང་རང་དོན་འགྲུབ་ནས་གཞན་དོན་བྱེད་པའི་སྐབས་དེར་ཡང་།",
    "རིགཐོགནས་གཉིས་སུ་འདུག་གམ་ལྟོས་དང་།",
    "དྲི་མ་སྟོང་རང་རིག་དབྱེར་མེད།",
    "སྐྱེས་བུ་ཇིབདེར་འདུག་པ་ལ་ལྟ་བ་པོས་དགྲ་གཉེན་དུ་བཟུང་བ་བཞིན་ནོ།",
    "དེ་ལྟ་མ་ཡིན་པའི་ཐ་མལ་གྱི་ཤེསཔའིའདུག་ཚུལཇིལྟ་བ་རྟོགས་དཀའ་བའི་གནས་སུ་བཤད།",
    "དགག་སྒྲུབཀྱི་རྩོལ་བ་མི་བྱ་བར་མི་རྟོག་པར་འདུག་ཀྱང་རུང་།",
    "གཉིས་མེད་ཀྱི་ཡེ་ཤེས་རང་དུ་འདུག་ཨང་སྙམ་པའི་གོ་བ་བྱུང་ན།",
    "དར་ཡང་རང་གཤིས་རང་ངོ་ཤེས་ཙམ་དྲན་ཤེསདངམབྲལ་བ་ཞིག་ནི་དགོས་ཤིང་གལ་ཆེ།",
    "སེམས་ཉིད་རང་གཤིས་ཇི་ལྟར་འདུག་པ་དེ་ལ་བཟོ་བཅོསམེད་པ་བྱས།",
    "བློམཉམ་བཞག་འདོད་ཀྱི་ཞན་པ་དང་བྲལ་ཞིང་གཤིས་མདངས་ཀུན་ལ་རྩིས་གདབ་རང་སར་གྲོལ་བ་ཞིག་འདུགཞ་དཀ་ཡིན་ཏེ།",
    "སྐུ་གསུམགྱི་རང་ཞལ་སྟོན་གྱི་གདའ་སྟེ།",
    "གསལ་འགྲིབ་མེད་པ་འོད་གསལ་འཁོདཡུགཏུ་འགྲོབ་ཞིག་དགོས་ཚོད་ཡིན་པར་འདུག།",
    "དེའངསེབ་གྱི་ངོ་བོ་སྟོང་པ་ཉིད་དེ་དང་རང་མདངས་སྣ་ཚོགས་དེགཉིས་དབྱེར་མེད་གཅིག་ཏུ་རྟོགས་པའི་གཤིས་མདངས་འདྲེས་པསན།",
    "གདོད་མའི་གནས་ལུགས་ཀྱིའང་རངཉིད་ཀྱིས་མཐོང་མེད་ཀྱི་ཚུལ་དུ་མཐོང་ཞིང་དོན་དུ་ཐམས་ཅད་ཕྱག་རྒྱ་ཆེན་པོ་ཡིན་བགོ།",
    "ཞིམ་པས་ཚོགས་ལ་ཆགས་པམི་ཞིམ་པ་སྣ་ཚོགས་ལ་སྡངབ་སོགས་། མི་བྱེད་པ་གང་ལྟར་འདུག་པ་དེ་ངོས་བཟུང་ནས་དེ་ཉིད་ཀྱི་ཐོག་ཏུ་ལྷོད་དེ་ཤེས་བཞིན་དུ་སྐྱོང་ཞིང་།",
    "ཤིང་ལ་ཞེ་སྡང་སྐྱེས་ས་བཅག་པའི་འབྲས་བུས་མགོ་ལ་ཤིང་སྡོང་སྐྱེས་ཏེ་ཤིང་སྡོང་དེ་ཆ་གསབསྐྱོད་དུས་སྡུག་བསྔལ་ཆེ་ཞིང་རྣག་ཁྲགམང་པོ་ཡོང་བ་ཞིགཅུངབ་ཡིན་འདུག་པ།",
    "རྣམག་ནི་ལྕགས་ཀྱི་སྤར་བུ་དགུའི་ཐུགས་སུ་བཅུག་ཀྱང་འདུག་པ་མིན་ཞེས་གསུངསསོ།",
    "ངེད་རང་དེ་འདྲ་མི་བྱེད་པས་དང་པོས་སེམས་གནས་འགྱུགཉིས་ཁྱད་མེད་པ་གང་ལྟར་གནས་ཅི་ལྟར་ཤརཡང་རང་སེམས་ཁོ་རང་ག་ཅིག་པུ་དེ་ཀའི་གཤིས་ཀྱི་རོལ་པའམཆོ་འཕྲུལ་ཡིན་པ་ཤེས་དགོས་ཏེ།",
    "དོན་དམ་པར་ཀུན་ཀྱངགཉིས་མེད་ཀུན་ཁྱབ་རྣམ་དག་ཏུ་ཡོད་པར་གདའ་བས།",
    "དེའི་རང་ངོ་ཤེས་བར་བྱས་ནས་དེའི་སྟེང་དུ་ལྷོད་དེ་ཤིག་གེར་བཞག་པས་སྦྲུལ་གྱི་མདུད་པ་བཞིན་དུ་རང་ཤར་རང་གྲོལ་དུ་འགྲོ་བས་རྟོགས་པ་ལ་སྐྱོན་དུ་མི་ལྟ་བར་ཁོ་རང་སྟེང་དུ་ཀློད་ལ་མ་ཡིངས་ཙམདུ་འཇོག་པ་ཁོ་ན་ཟབ་པ་སྟེ།",
    "དེ་ལ་བདེན་འཛིན་སྤངས་ནས་ངོ་ཤེས་ཙམཅས་ནས་ཀློད་པས་སའམ་ཐམ་ཅད་ཁོ་རང་ལ་ཚང་བ་ཡིན་ཏེ།",
    "རྒྱུ་འབྲས་ལ་ངེས་ཤེས་སྐྱེས་ཙ་ན།",
    "ཟོ་ཚོའི་ཉིང་རྡལ་ཡང་རྫུན་པོར་གདའ།",
    "ཀ་བློ་གཏད་ཅིག་འདུག་གམ་མི་འདུག་སོགས།",
    "དེས་ན་འདི་ཚོ་ཕན་བཏགས་དགོས་འདུག་བསམ་ཞིང་།",
    "མི་གང་བྱེད་འདུག་ཅིང་ག་སལ་ལ་བསྲིང་དགོས་པར་གདའ།",
    "དེའང་རང་ལ་མཚན་ཉིད་དང་ལྡན་པའི་བླམཞིག་ཡོད་ཅིང་།",
    "དྲའདུནམེད་ན་བསྒོམ་སྟོར་གསུངས་འདུག་པ་དེ་ཚོར་བསམ་དགོས་རྒྱུ་ཡིན།",
    "དེ་ལྟར་རྩེ་གཅིག་དུས་སུ་འང་དྲན་པ་གལ་ཆེ་བ་ཡིན།",
    "ཅེས་གསུངས་འདུག་སྟེ།",
    "ཚེ་རབས་ཀུན་ཏུ་གཞན་དོན་དཔག་མེད་འགྲུབ་པ་ཡིན་པར་འདུག།",
    "རང་དོན་འགྲུབ་ནས་བཞའདོན་དུས་བབ་རྒྱལ་པོ་རྒྱལསར་བཞུགས་པ་བཞིན་ཚུར་རུབ་རུབ་འདུས་པ་ཞིག་དགོས་པ་ཡིན་ཚོད་འདུག་གོ།",
    "གཞན་དོན་བསམ་པས་དེའང་ལེགས་བོ་ལོས་ཡིན་ཏེ།",
    "དེ་ལ་སྒྲོ་འདོགས་ཆོད་ན་དེ་དག་དང་སེམས་གནས་དུས་ཀྱིས་ངོ་བོ་ལ་ཁྱད་པར་ཅི་འདུག་ལྟ།",
    "དེ་དག་གོངོ་བོདང་སིམ་གྱི་ངོ་བོ་ལ་ཁྱད་པར་ཅི་འདུག་ལྟ་བ་རྣམས་དམིགས་པསོགོར་ཕྲལ་ཏེ་ཞག་འགར་སྒྲོ་འདོགས་གཅོད།",
    "ཐ་མལ་ཝཾགྱིས་གསགང་འདུག་ཅི་བྱུང་ཅི་ཤར་དེ་ཀ་བསྒོམ་གྱི་རང་བཞིན་སྟོང་པའི་རྣམ་འགྱུར་དོན་ལ་སྐྱེ་འགགསམེད་བ།",
    "དཔྱད་དགོས་པར་འདུག།",
    "དེ་ཡང་རང་ཉིད་ཐོས་བས་ས་པས་གདམས་ངག་གོ་བས།",
    "སེམས་གནས་ལུགས་འདི་ལྟ་བུ་འདུག་བསམ་པ་གོ་བ་དང་།",
    "དེ་ཙུག་ཡིན་པར་འདུག་སྙམ་དུ་བློ་ཡུལ་དུ་བྱུངབདེ་རྣམཱལ་གོ་ཡུལ་བྱ་བ་ཡིན།",
    "སྡུག་ཐུག་ཙ་ནཱ་མཆུ་ན་བ་ལ་ཐུག།",
    "ནཱན་ལྟར་བསྒོམ་བྱ་སྒོམ་བྱེད་མི་འདུག་སྙམས་ཉམས།",
    "ཞེས་གསུངས་འདུག་ཅིང་།",
    "རོ་གཅིག་དུས་སུ་མཚན་ཉིད་རྟོགས།",
    "ཅེས་པ་རང་སའམཉམ་བཞག་དུས་དྲན་འཛིན་ཐུ་བྱས་ནས་ཉམས་མྱོང་ངོས་བཟུང་ཅན་སྐྱོང་ཞིང་།",
    "ཀུན་གཞིའི་རྣམ་པར་ཤེས་པ་འདུག།",
    "སྐྱེ་མེད་ལས་ནི་འདའ་བ་རྩེ་གཅིག་འགག་འདུག་ས",
    "རོ་གཅིག་དུས་སུ་འཇའ་ལུས་ཀྱི་སྐུར་རྟོགས།",
    "རོགཱཅིག་དུས་སུ་རྣམ་རྟོག་བསྒོམ་དུ་ཤར།",
    "གནས་འགྱུ་རོམཉམ་དུའདྲེས་ཤིང་རང་ངོ་ཤེས་པའི་དྲན་རིག་ཡོད་བ་ཞིག་དགོས་ཏེ།",
    "རངམིན་པའི་དྲན་རྟོག་ཅིག་འདུག་གམ་ལྟོས་དང་།",
    "ད་ལྟ་གྱི་ཤེས་པ་ཁོ་རངལུལ་མེད་དུ་རང་ངོ་ཤེས་པའོ།",
    "སྤྲོས་བྲལ་དུཉམས་རྟོགས་ཀྱང་ཡུལ་ཡུལ་ཅན་གྱི་ཆ་བག་ཙམ་འདུག་ན་ངོ་བོ་མམཐོང་།",
    "པདང་རང་བཞིན་གྱི་གནས་ལུགས་འདྲེས་ནས།",
    "ད་དུང་རྟོགས་པ་དེ་བ་གོམས་བག་བྱ་རྒྱའམ་གསལ་དུ་འགྲོ་རྒྱུ་ཅུང་ཟད་ཅིག་འདུག་ན་ངོ་བོ་མ་མཐོང་།",
    "དེ་ཀ་སྦྱང་དགོས་པ་འདུག་གོ།",
