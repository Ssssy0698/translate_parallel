    "གཞན་ལེ་ལོ་ཅན་མཐོང་ཙ་ན་རང་བརྩོན་འགྲུས་ཆེར་འགྲོ་བ་ཞིག་དགོས་པ་ཡིན།",
    "གཞན་འདོད་ཆགས་ཅན་མཐོང་ཙ་ན་རང་གཉེན་པོ་ཆེར་འགྲོ་བ་ཞིག་དགོས་པ་ཡིན།",
    "གཞན་ཞེ་སྡང་ཅན་མཐོང་ཙ་ན་རང་བཟོད་པ་ཆེར་འགྲོ་བ་ཞིག་དགོས་པ་ཡིན།",
    "གཞན་གཏི་མུག་ཅན་མཐོང་ཙ་ན་རང་ཤེས་རབ་ཆེར་འགྲོ་བ་ཞིག་དགོས་པ་ཡིན།",
    "གཞན་ལོག་ལྟ་ཅན་མཐོང་ཙ་ན་རང་དག་སྣང་ཆེར་འགྲོ་བ་ཞིག་དགོས་པ་ཡིན།",
    "གཞན་བློ་སྣ་མང་པོ་ཅན་མཐོང་ཙ་ན་རང་བརྟན་དུ་འགྲོ་བ་ཞིག་དགོས་པ་ཡིན།",
    "གཞན་བློ་སྣ་དྲེད་པ་མཐོང་ཙ་ན་རང་ངེས་འབྱུང་ཆེར་འགྲོ་བ་ཞིག་དགོས་པ་ཡིན།",
    "གཞན་སྡུག་བསྔལ་ཅན་མཐོང་ཙ་ན་རང་བྱང་སེམས་ཆེར་འགྲོ་བ་ཞིག་དགོས་པ་ཡིན་གསུངས།",
    "སྔོན་དགེ་སློང་ཞིག་ལྷུང་བཟེད་ལ་ཆགས་པས་དེ་མ་ཐག་པར་ལྷུང་བཟེད་ཀྱི་ནང་དུ་སྦྲུལ་ཞིག་ཏུ་བརྫུས་ཏེ་སྐྱེས་ནས་འདུག་པ་ན།",
    "གྲུ་ལྕི་འདུག་པས་རྐྱལ་ཤེས་པ་ཡོད་ན་གཅིག་ཙམ་ཐོན་རོགས་གྱིས།",
    "གཅིག་པུར་འདུག་ཚེ་ལྷ་ཡིས་མི་ཁྲེལ་བར།",
    "ཁོས་ཁ་ཕྱེས་ཏེ་བལྟས་པས་ཤ་རུ་འདུག་ཟེར།",
    "འགྲོ་འདུག་ལ་སོགས་པའི་སྤྱོད་ལམ་ཐམས་ཅད་གཞན་ལ་ཕན་པའི་བསམ་པ་དང་མི་འབྲལ་བའི་རྣལ་འབྱོར་གཅིག་པུས་ལམ་དུ་ཁྱེར་ཏེ།",
    "དེ་རང་ལ་འཛོམས་འདུག་ན་དགའ་བ་བསྒོམ།",
    "ཆགས་སྡང་སྤངས་ཤིང་དབེན་པ་བསྟེན་ནས་དལ་བར་བསྡད་དུ་ཕུང་པར་གདའ་བས།",
    "འདི་ཤིན་ཏུ་ངོ་མཚར་ཆེ་བར་གདའ་གསུངས།",
    "ཞེ་འགྲས་པ་མེད་ཀྱང་རང་བཞིན་གྱིས་གནོད་པ།",
    "དགའ་བར་བྱ་བའི་རོ་ནི་ནང་ན་འདུག།",
    "ཁོང་རང་ཡང་ངེས་ཤེས་སྐྱེས་ནས།",
    "ཕངས་པར་འདུག་གསུང་ནས་མ་གནང་།",
    "ད་ལྟའི་དུས་ལ་ཤིན་ཏུ་མང་ཞིང་ཕལ་ཆེར་འདི་ཁོ་ནར་འདུག་ཅིང་།",
    "ཡང་བདག་གཅེས་འཛིན་ཇི་འདྲ་འདུག་བལྟ།",
    "དྲག་པོ་རྣམས་ཁ་འཇམ་འཁྲུལ་པའི་བདུད་ཀྱིས་བསླུས་ནས་གདའ།",
    "ཕྱུག་པོ་རྣམས་ཟང་ཟིང་ནོར་གྱི་བདུད་ཀྱིས་བསླུས་ནས་གདའ།",
    "ལན་ཆགས་བུ་སྤེལ་གྱི་བདུད་ཀྱིས་བསླུས་ནས་གདའ།",
    "དགྲ་སྡང་གདོང་འཛུགས་བདུད་ཀྱིས་བསླུས་ནས་གདའ།",
    "བདུད་ངོ་མ་ཤེས་པ་ཁོ་ན་མང་བར་གདའ།",
    "ཀོ་ལོང་གཙང་བཙན་བས་དམ་པར་གདའ་སྟེ།",
    "འཇིག་རྟེན་བློས་བཏང་བ་འགའ་ཡང་མི་གདའ།",
    "ཞང་ཞུང་བ་བྱ་བ་གཉིས་ཡོད་དེ་གདན་ས་སུ་བྱེད་མ་འཆམ་འདུག་ཟེར།",
    "བདག་གཅེས་འཛིན་གྱི་འཁྲི་བ་གཏན་ནས་མེད་པ་གཅིག་བྱུང་བར་གདའ་སྟེ།",
    "ཟབ་དགུའི་གདམས་ངག་ཐོས་ཀྱང་རང་རྒྱུད་མཚོ་གཏིང་རྡོ་བ་ལྟར་གྱུར་པའི།",
    "ཐུན་མཐར་ཚོགས་ཞིང་རང་ལ་བསྟིམས་ནས།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "འདི་དག་དུས་གཅིག་ལ་ལན་བརྒྱ་རྩ་བརྒྱད་བཟླས་ན།",
    "རང་ཉིད་སེང་ཁྲི་ལ་འདུག་པ་དང་།",
    "གནས་ལྔའི་ལྕུག་ཕྲན་རྩེ་ལ་མ་ཚོར་ངང་ཕེབས་འདུག།",
    "སྲིད་པའི་དབུལ་བ་སེལ་ལ་དཀའ་རྒྱུ་རང་མི་འདུག།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "དེ་ཡང་བསྐལ་པ་འཇིག་དུས་ཀྱི་མེ་ལས་ཚ་ཞིང་།",
    "ལག་ཏུ་བླངས་ཚེ་བྱེའུ་ཁྲས་ཁྱེར་བ་ལྟ་བུའི་སྡུག་བསྔལ་ཡོད་པར་འདུག་དེ་ནས་རིམ་གྱིས་རྒས་པའི་ཚེ།",
    "འདུག་ན་བུབ།",
    "དེ་ཡང་རང་ཉིད་མངོན་མཐོ་དང་ཞི་བདེ་དོན་གཉེར་ཙམ་གྱི་ཆེད་དུ་སྐྱབས་སུ་འགྲོ་བ་ནི།",
    "ད་ལྟ་དེའི་ནུས་པ་བདག་ལ་མི་འདུག་པས།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "ཤེས་རབ་ཀྱང་ཆེན་པོ་འདུག་པས།",
    "མ་དེའི་གམ་དུ་ཞིག་མའི་ནང་དུ་བདག་ཉལ་བའི་སྟེང་ནས་གོས་སེར་པོ་ཞིག་བཀབ་འདུག་པར་རྨིས་པས།",
    "སྔོའི་རིགས་ཁ་དོག་དམར་སེར་དུ་སྣང་བ་འདབ་མའི་དབྱིབས་རྒྱ་ཇ་བཟང་པོ་དང་འདྲ་རུང་བ་གཟུགས་དང་ལང་ཚ་ཡིད་དུ་འོང་ཞིང་དྭང་བ་འདྲེན་པ་མང་པོ་སྐྱེས་འདུག་པ་ལས།",
    "གཞན་འདོད་ཡོན་ཐམས་ཅད་ལ་ཆགས་པ་དང་བྲལ་བར་བྱེད་པའི་ཡ་མཚན་ཅན་དུ་འདུག་ནས།",
    "ཇི་སྲིད་གནས་དེར་བཞུགས་ཀྱི་རིང་ལ་ནི་རི་ཀླུང་མཐའ་དག་གང་འདུག་ཀྱང་།",
    "ང་ལས་ཀྱང་ཁྱེད་སྨྱོ་བར་འདུག་ཅིང་།",
    "སྐུ་སྲོག་ལ་འཐུད་དུ་མི་འདུག་པའི་བཀའ་སྩལ་གསལ་པོར་གནང་ཀྱང་།",
    "སྔ་ཐོག་ཕན་ཐོགས་སྲིད་པ་ཙམ་ཡིན་འདུག་ཀྱང་།",
    "མེ་བོང་གཉིས་ཆུའི་འཁྲིས་ཕྱེད་ནུབ་ཙམ་ན་མ་ཤི་བར་འདུག་པ་མཐོང་ནས་ཐག་པའི་ཞུར་ལ་དྲངས།",
    "གྲོགས་པོ་ཁྱེད་འདིར་དགོན་གསར་འདེབས་པར་འདུག་ཟེར་བའི་གཏམ་ཚ་ར་བྱུང་བ་མི་དག་ལ་ཆེ།",
    "ཁྱད་པར་རྒྱལ་ཆེན་རྩེའི་ཡར་ཁུགས་ནས་དམིགས་ཅུང་ཟད་ཁྲ་བ་ཞིག་འདུག་རུང་།",
    "གོལ་མ་ཙཱ་ར་ཟེར་བ་ཞིག་འདུག་པ་ལུང་པ་དེའི་ཕུ་ན་ཕ་དམ་པའི་བསྒྲུབ་གནས་བྲག་དཀར་ཤར་ནུབ་བྱ་བ་དང་།",
    "མཁར་རྩེ་བས་ནི་སྔགས་པ་གཞན་ཡང་མང་པོ་བྱེད་འདུག་ཅིང་།",
    "ལྷ་ས་སོགས་དང་ཉེ་རིང་མཚམས་པོ་ཅིག་འོང་བར་འདུག་པས།",
    "ཁྱེད་ཀྱི་ས་ཕྱོགས་དེ་ལེགས་པོ་རང་ཅིག་འདུག་ཟེར་བས།",
    "ཁྱེད་རང་དོ་ནུབ་འདིར་བཞུགས།",
    "རྟོགས་ལྡན་པ་ལ་སའི་དཔྱད་རྣམས་ལེགས་པོ་འདུག་ཅིང་།",
    "ས་དམིགས་ཀྱང་སྐབས་ལ་བབ་པར་འདུག་པས།",
    "ས་དེ་མཁར་རྩེ་བས་དཔལ་གནས་པ་ལ་དམག་འཐེན་པའི་རྟེན་སོར་གནང་བ་ཡིན་འདུག་པས་དེའི་ས་ཚབ་གནང་བར་ཞུ་བ་སོགས་དོག་འགྲོལ་དགོས་པས།",
    "ལུང་པ་འདི་ན་ནི་ཤིང་མི་འདུག་ཅུང་ཟད་ཆེས་པ་ཨེ་ཡིན་གསུང་བ་ལ།",
    "ཁང་རུལ་གྱི་རྡོ་ཕུང་ཆེན་པོ་ཅིག་འདུག་པ་ལ།",
