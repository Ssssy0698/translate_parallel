    "བླ་གབ་མེད་པར་འདུག་པར་མི་བྱའོ།",
    "དེས་དེ་ཁྱེར་ཏེ་བླ་གབ་སྟེང་གཡོགས་མེད་པར་འདུག་པར་མི་བྱའོ།",
    "དབྱུང་བའི་བློ་སྔོན་དུ་མ་བཏང་བར་སྲ་བརྐྱང་རང་ཉིད་བཏིང་བའི་འཇུག་པ་དང་བྲོལ་བ་དང་།",
    "བདག་ལ་སྲ་བརྐྱང་མི་དགོས་སོ་སྙམ་དུ་སེམས་བསྐྱེད་པས་ཀྱང་དབྱུང་བ་གྲུབ་པར་ཊཱི་ཀ་དང་རང་འགྲེལ་ལས་གསུངས་སོ།",
    "དེའི་ཕྱིར་འདུན་པ་མ་ཕུལ་བ་ལ་ནི་འདུག་ཏུ་ཟིན་ཀྱང་གཉིད་ལོག་གམ་སྙོམས་པར་ཞུགས་ན་མ་ཐོས་ཀྱི་བར་དུ་བཏིང་བ་དང་ཕྱུང་བ་མི་འབྱུང་ངོ།",
    "གང་ན་བྱིན་གྱིས་བརླབ་པར་བྱ་བ་འདུག་པ་དེའི་མཚམས་སུ་གཏོགས་པ་རྣམས་བྱིན་གྱིས་རློབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "གནས་གང་ན་བྱིན་གྱིས་བརླབ་པར་བྱ་བ་འདུག་པ་ཉིད་ཀྱི་གནས་དེའི་མཚམས་སུ་གཏོགས་པ་རབ་ཏུ་བྱུང་བ་རྣམས་ནི་དངོས་པོ་དེ་བྱིན་གྱིས་རློབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེས་ན་གང་ན་ནོར་རྫས་དེ་འདུག་པའི་མཚམས་དེར་གཏོགས་པ་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "འོ་ན་མཚམས་གཉིས་སོགས་ཀྱི་བར་ན་ཤི་བའི་ཡོ་བྱད་འདུག་པ་ལ་སུས་བྱིན་གྱིས་བརླབ་ཅེ་ན།",
    "དེ་ཉིད་འདུག་པ་ཉིད་ཀྱི་མཚམས་དེའི་ཁོངས་སུ་ཤི་བའི་ཡོ་བྱད་ཐོག་རིང་པོ་མཚམས་ཐ་དད་གཞན་ན་འདུག་པ་ཡང་གཏོགས་པ་ཉིད་ཡིན་ནོ།",
    "དེ་ལ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ།",
    "མུ་སྟེགས་པའི་འདུག་གནས་སུ་སྣམ་སྦྱར་འཁྱེར་དགོས་པར་གསུངས་པ་ལས་གྱོན་དགོས་པར་གསུངས་པ་མེད་དོ།",
    "སྣམ་སྦྱར་དེ་ལ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་མ་དྲས་པ་དེས་གྲོང་དང་ཁྱིམ་གཞན་དག་ཏུ་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཡང་དེ་བཞིན་ནོ།",
    "འཁོད་ན་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "འདུག་པར་མི་བྱའོ།",
    "གོང་དུ་སྨོས་པའི་རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་སྣམ་སྦྱར་མ་དྲས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཡང་འཇུག་པ་དང་འདུག་པར་མི་བྱ་བ་སྔ་མ་དེ་བཞིན་ནོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེ་ན་མུ་སྟེགས་ཅན་འཁོད་ན་ནི་རྐྱེན་དེ་ལྟ་བུ་དག་ཡོད་ཀྱང་འདུག་གནས་དེར་སྣམ་སྦྱར་མ་དྲས་པས་སམ་མེད་པར་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "ལྭ་བ་བཟློག་སྟེ་གྱོན་པས་འདུག་པར་བྱ།",
    "ཁྱིམ་གཞན་དུ་གཞན་མེད་ན་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོ།",
    "གཙུག་ལག་ཁང་དུ་ནི་ཀོ་ལྤགས་ཀྱི་སྟན་ལ་འདུག་པར་མི་བྱ།",
    "འདུག་གམ་ཉལ་ན་འགལ་ཚབས་ཅན་དུ་འགྱུར་རོ་ཞེས་གསུངས་པ་དང་།",
    "གཞུང་འབྲུམ་ཅན་ཐམས་ཅད་ཀྱིས་ཀྱང་སྔར་བསྟན་པ་དེ་བཞིན་དུ་རྐང་པའི་གནས་སུ་གདིང་བ་དང་མཆིལ་ལྷམ་དུ་བགོ་བ་དང་འདུག་པ་དང་ཉལ་བར་ཡང་བྱ་བ་ཡིན་ནོ།",
    "སྡོང་པོ་དང་ལོ་མ་ཐམས་ཅད་ཀྱི་ཁ་དོག་སྔོ་ལྗང་དུ་འདུག་པ།",
    "ཤིང་ཀན་ཙ་ན་དང་ཀཱ་པཱི་ཏ་ལ་དང་ཨ་ཤོད་ཐ་དང་ཨུ་དུམ་ཝཱ་ར་དང་ནྱ་གྲོ་དྷ་རྣམས་ཀྱིའོ།",
    "དེ་ཡང་རང་དུས་ལས་འདས་ན་བྱིན་གྱིས་བརླབས་ཀྱང་གསོག་འཇོག་མི་ཁེགས་པའི་ཕྱིར་རོ།",
    "དགེ་སྦྱོང་མེད་ན་དགེ་སློང་རང་ཉིད་ཀྱིས་བསྡུ་བར་བྱའོ།",
    "གདོང་ལ་གཏར་ཀ་བྱ་ན་རྩ་གང་ན་འདུག་པའི་སྟེང་དུ་བྱས་པ་ནི་ཉེས་མེད་དོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དང་།",
    "གནས་དེར་ཕྱིན་ནས་ཆུ་བཙག་པ་དང་གནས་ཁང་བསྐོ་བ་ལ་སོགས་པ་བྱ་བ་གཞན་བརྩམ་པ་དངོས་སུ་མ་བྱས་པ་དང་སྟན་ལ་སོགས་པ་ལ་འདུག་སྟེ་ངལ་བསོ་བ་དངོས་སུ་མ་བྱས་ལ་དེ་གཉིས་བྱ་བའི་མཚམས་ལ་ཐུག་པ་ཚུན་ཆད་ཀྱི་དུས་དེ་ནི་དགེ་སློང་དག་ཕྱིན་པ་ཉིད་ཀྱི་དུས་དེ་ཉིད་དོ།",
    "གཉིས་པ་འདུག་པར་བྱ་ཚུལ་ཞར་བྱུང་དང་བཅས་པ་ནི།",
    "རྩྭ་བམ་ལ་འདུག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་འདུག་པར་བྱའོ།",
    "སྟན་གཞན་མེད་ན་རྩྭ་བམ་ལ་འདུག་པར་བྱའོ།",
    "དེ་ལ་འདུས་པ་ཆེན་པོ་བྱུང་ནས་རྒན་རིམ་དུ་འདུག་ཅེས་བཀའ་བསྩལ་པ་དང་།",
    "གཉིས་གསུམ་ཙམ་རྒན་རིམ་དུ་འདུག་ལ།",
    "དེ་བཞིན་དུ་སྒྲ་བསྐྱུངས་པ་དང་ཤིན་ཏུ་བསྡམས་པ་དང་སྤྱོད་ལམ་མཛེས་པ་དང་ཆ་ལུགས་མཛེས་པས་ཟན་གྱི་ཆེད་དུ་འདུག་པར་བྱའོ།",
    "གཞན་དུ་མགྲོན་དུ་བོས་པ་ན་འདུག་པ་ལ་དེས་གནང་ན་གཞན་གྱིས་བྱིན་པ་ནི་དེའི་ཁོངས་སུ་གཏོགས་པ་དང་འདྲའོ།",
    "སྦྱིན་བདག་གཞན་དུ་དགེ་སློང་མགྲོན་དུ་བོས་པ་ན་འདུག་པ་ལ་སྦྱིན་བདག་དེས་གནང་ན་སྦྱིན་བདག་དེ་ལས་གཞན་གྱིས་དགེ་སློང་དེ་ལ་བཟའ་བཏུང་བྱིན་པ་ནི་སྦྱིན་བདག་སྔོན་མ་དེའི་ཟས་ཀྱི་ཁོངས་སུ་གཏོགས་པ་དང་འདྲའོ།",
    "ཟན་གྱི་ཕྱིར་འདུག་པས་འདིའམ་འདི་ནས་བྱིན་ཅིག་ཅེས་འབྲིམ་མཁན་ལ་གོ་བར་མི་བྱའོ།",
    "དབྱིབས་ཟླུམ་རིལ་ཁ་དོག་ཕལ་ཆེར་དཀར་སེར་དུ་འདུག་པའི་ཡུངས་ཀར་དང་།",
    "ཟན་གྱི་ཕྱིར་ཟས་ཀྱི་གནས་སུ་འདུག་པས་དངོས་པོ་འདི་བྱིན་ཅིག་ཅེས་པའམ་ཟས་ཀྱི་སྤྱི་བུངས་འདི་ནས་བྱིན་ཅིག་ཅེས་འབྲིམ་མཁན་ལ་བརྗོད་ཅིང་གོ་བར་མི་བྱའོ།",
    "དཀྱིལ་དུ་འདུག་པར་བྱའོ།",
    "དེ་དང་འབྲེལ་བའི་དོན་ལས་གཞན་པས་དེའི་དྲུང་དུ་འདུག་པར་མི་བྱའོ།",
    "ལྟོ་འཛག་པས་ནི་ཐ་མའི་མདུན་དག་ཏུ་ཕྱི་བ་ཙམ་བྱས་ཏེ་འདུག་པ་ལ་ཉེས་པ་མེད་དོ།",
    "དེ་ལས་གཞན་པས་ནི་ཆུ་ཡོད་ན་འཐོར་འཐུང་མ་བྱས་པར་འདུག་པར་མི་བྱའོ།",
    "ལྟོ་འཛག་པ་དེ་ལས་གཞན་པས་ནི་ཆུ་ཡོད་ན་འཐོར་འཐུང་སྟེ་བཀྲུ་བཤལ་མ་བྱས་པར་འདུག་པར་མི་བྱའོ།",
    "ལུང་གཞི་ལས་འདུག་པ་དང་བྱ་བ་དང་གསོ་སྦྱོང་གྱིས་ཤིག་ཅེས་པའི་བྱ་བ་ཞེས་པས་གསོལ་བ་འབའ་ཞིག་པ་དང་།",
    "དེ་ལ་གསོལ་བཞིའི་ལས་བྱས་པས་ཞར་ལ་འཁོར་རྣམས་ལ་ཡང་མཐུན་པ་སྦྱིན་པ་སོགས་ཀྱིས་དོན་གྲུབ་སྟེ་དགེ་སློང་རང་བཞིན་དུ་གནས་པར་འགྱུར་ཚུལ་ཤེས་དགོས་སོ་ཞེས་གསུངས་པ་ལྟར་ཤེས་པར་བྱའོ།",
    "མི་འདུག་པར་འགྲེང་བ་ནི་ཁ་སྐོང་བ་ཉིད་མ་ཡིན་ནོ།",
    "སྤྱོད་ལམ་ཐ་དད་པར་འདུག་པས་ཐ་དད་པ་ཉིད་དུ་ཡིད་ལ་སྣང་བའི་ཕྱིར་རོ་ཞེས་ཊཱི་ཀ་ལས་སོ།",
    "འདུག་པར་གཅིག་པའི་ཕྱིར་རོ་ཞེས་འདུལ་ཊཱིཀ་རིན་ཕྲེང་སོགས་ལས་གསུངས་པ་ལྟར་ཤེས་པར་བྱའོ།",
    "འདུག་པའི་སྤྱོད་ལམུ་ལས་མ་ཉམས་པ་དང་།",
    "འདུག་པའི་སྤྱོད་ལམ་ཉམས་པ་ལ་སོགས་པས་བཟློག་ན་མི་ཆགས་སོ།",
    "འདུག་པའི་སྤྱོད་ལམ་དེ་བརྩམས་པ་སྟེ་སྔར་འདུག་པ་ལས་གཞན་དུ་འགྲོ་བའི་སེམས་ཀྱིས་འདུག་པའི་སྤྱོད་ལམ་བཏང་སྟེ་སྟན་ལས་ལངས་བ་ནི་སྤྱོད་ལམ་ལས་ཉམས་པ་ཡིན་ནོ།",
    "ལྷག་བོར་ཡང་མདུན་དུ་ཙོག་པུར་འདུག་སྟེའོ།",
    "ལས་ནི་འདུག་པ་ཉིད་ཀྱིས་སོ།",
    "གསང་སྟེ་སྟོན་པའི་སྐབས་མ་གཏོགས་པར་ནི་སྟན་ནང་ཚངས་ཅན་དང་འཇམ་པོ་ལ་སོགས་པ་ལ་ཅི་བདེར་འདུག་ཏུ་གཞུག་པའོ།",
    "དབྱར་དང་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་པ་ནི་ཙོག་པུར་འདུག་སྟེ་བྱའོ།",
    "གསོལ་བ་དང་བཞིའི་ལས་ཐམས་ཅད་ནི་འདུག་པ་ཉིད་ཀྱིས་བྱ་དགོས་སོ།",
    "གཞན་ཡང་མཆིལ་ལྷམ་ཕུད་ཅིང་འདུག་ལཾ།",
    "འགྲོ་འདུག་དང་།",
    "ཤིང་དྲུང་དང་ནེའུ་གསིང་ལ་སོགས་པ་འདུག་པའི་གནས་ཐམས་ཅད་ལ་ནི་བསླབ་པ་རྒན་རིམ་དུ་བསྐོ་བར་བྱའོ།",
    "འགྲེང་ན་ཁ་སྐོང་བར་མི་འོས་པས་འདུག་ནས་མཚམས་གཅིག་ཏུ་རྐང་པ་ཡ་གཅིག་བཞག་ལ་མཚམས་གཅིག་ཏུ་རྐང་པ་ཡ་གཅིག་བཞག་ན་དགེ་སློང་དེ་མཚམས་གཉིས་ཀར་གནས་པ་ཉིད་དོ།",
    "འོན་ཀྱང་རང་འགྲེལ་ལས།",
    "ཅི་ཡང་མི་སྨྲ་བར་ཁ་བཙུམ་སྟེ་འདུག་པ་མི་བརྩན་གྱི།",
    "དེ་ཡང་རང་དང་ལྟ་བ་ཐ་མི་དད་པ་ལ་གོ་བར་བྱ་བའོ།",
    "ཀརྨ་ཤ་ཏཾ་དང་རང་འགྲེལ་དང་ཁྲི་ཀ་སོགས་ལས་ཀྱང་དེ་ལྟར་མཇུག་སྡུད་ཀྱི་རྗེས་སུ་བྱེད་པར་གསུངས་སོ།",
    "སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "ནོར་ཏེ་ཕྱིན་ནས་དེའི་སྟན་ལ་འདུག་ཅེས་ཟེར་ཡང་དེའི་སྟན་ལ་འདུག་པར་མི་བྱའོ།",
    "སྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་པས་འདུག་པར་ཡང་ངོ།",
    "སྤོ་མགུ་སྤྱོད་པ་དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་དྲུང་དུ་སྟན་ཆེས་དམའ་བ་ཉིད་ལ་འདུག་པར་བྱ་བ་ལས་གཞན་མཐོ་བའམ་མཉམ་པས་འདུག་པར་ཡང་ངོ་སྟེ་མི་བྱའོ་ཞེས་སྔ་མར་སྦྱར་རོ།",
    "སྟན་གཅིག་ལ་འདུག་པར་མི་བྱ་བ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་རང་འགྲེལ་ལས་སོ།",
    "དེ་གཉིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ངོསཾ་དང་སྟེང་གཡོགས་མ་གཅིག་ཏུ་ཉལ་མི་རུང་བས་དེར་མལ་བཤུམ་པར་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ལ་བརྗོད་པ་དང་བཅས་པ་ཉིད་དང་ཕུར་པ་དང་བཅས་པ་ཉིད་དགུ་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ལ་གདམས་ངག་དང་གསོ་སྦྱོང་དང་དགག་དབྱེ་དང་གསོལ་བ་དང་བརྗོད་པ་དག་གཞག་པར་མི་བྱའོ།"
  ]
}