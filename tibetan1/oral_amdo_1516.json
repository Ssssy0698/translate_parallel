    "འོད་ཟེར་སླར་འཕྲོས་སྣོད་བཅུད་ཐ་མལ་གྱི་སྣང་ཞེན་སྦྱངས་ཏེ་འཇམ་དཔལ་གཤིན་རྗེའི་གཤེད་ཀྱི་སྐུ་གསུང་ཐུགས་ཀྱི་རང་བཞིན་དུ་སད་པར་མོས་ལ་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "མོན་པ་བཞི།",
    "ཐུགས་ཀའི་སྔགས་ཕྲེང་གི་འོག་ཏུ་ཐིམ་པས་ལས་ཀྱི་གཤིན་རྗེའི་ཚོགས་ཀྱི་ནུས་སྟོབས་འབར་བར་མོས་ལ་སྔགས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཉོན་མོངས་གཅོད་པའི་རལ་གྲི་དང་།",
    "གཟུང་འཛིན་འཆིང་བའི་ལྕགས་སྒྲོག་གིས།",
    "དུར་ཁྲོད་དཔལ་གྱི་ཆས་གོས་ཀྱིས་མངའ་གསོལ་བར་མོས་ཤིག་རྒྱན་སོ་སོའི་གཟུགས་བརྙན་བྲིས་པའི་ཙཀླི་གནས་རྣམས་སུ་རིམ་པར་སྦྱིན་ལ།",
    "ཡེ་ཤེས་བསམ་ཆེ་བཙན་ཉོན་མོངས་ཚོགས་ཀུན་རྣམ་དག་པའི།",
    "སྟག་གི་པགས་པས་མངའ་སྔགས་འདྲ།",
    "ཐལ་ཆེན་ཚོམ་བུས་མངའ་སྔགས་འདྲ།",
    "དཔྲལ་བར་ཐལ་ཆེན་གྱི་ཚོམ་བུ་བྱ།",
    "ཞག་གི་བྱུག་པས་མངའ་སྔགས་འདྲ།",
    "དེས་ནི་དེ་རིང་ཁྱོད་ལ་ཞི་བྱེད་བཀྲ་ཤིས་ཤོག།",
    "དེས་ནི་དེ་རིང་ཁྱོད་ལ་ཞི་བྱེད་བཀྲ་ཤིས་ཤོག།",
    "དེས་ནི་དེ་རིང་ཁྱོད་ལ་ཞི་བྱེད་བཀྲ་ཤིས་ཤོག།",
    "མཆོག་གི་དངོས་གྲུབ་ཐོབ་པར་ཤོག།",
    "ཨོཾ་མཉྫུ་བཛྲ་མ་ཧཱ་ཤྲཱི་ཧེ་རུ་ཀ་ཡ་མཱནྟ་ཀ་བཛྲ་ཨ་མྲྀ་ཏ་ཨ་བྷི་ཥིཉྩ་ཧཱུྃ།",
    "མགྲིན་པའི་རྩ་བརྒྱད་ལ་མོན་བདུད་ཡབ་ཡུམ།",
    "ཡན་ལག་བཞི་ལ་སྒོ་བ་བཞི་སོགས་ལྷའི་དཀྱིལ་འཁོར་དུ་རྫོགས་པ་སྤྱི་བོར་སྤྱན་དྲངས་པས་ཐུན་མོང་གི་དངོས་གྲུབ་སྩོལ་བར་མོས་ཤིག།",
    "ཐུན་མོང་དངོས་གྲུབ་ཐོབ་པར་ཤོག།",
    "དགྱེས་པས་འོད་དུ་ཞུ་བའི་བདུད་རྩི་གྲུབ་པའི་དངུལ་ཆུ་ལྟ་བུར་འཁྱིལ་བ་ཁྱེད་རང་རྣམས་ཀྱིས་མྱང་བས་ཐུན་མོང་གི་དངོས་གྲུབ་རྣམས་ཐོབ་པར་མོས་ཤིག།",
    "ཅེས་བརྗོད་དེ་བམ་ལས་ཅུང་ཟད་བཅད་པ་བུར་ཆང་དང་སྦྱར་ཏེ་བྱིན་ལ་མྱང་དུ་གཞུག་དེས་ནི་ཐུན་མོང་གི་དངོས་གྲུབ་རྣམས་ཐོབ་པར་འགྱུར་ཞིང་།",
    "དེང་ཕྱིན་ཆད་གྲུབ་པ་ཆེན་པོ་བརྒྱད་སོགས་ཐུན་མོང་གི་དངོས་གྲུབ་རྣམས་སྒྲུབ་པས་རང་གཞན་གྱི་དོན་གྱིས་ཤིག།",
    "ཞེས་དུག་ཁྲག་སྤྱི་བོར་བཞག་དུག་ཁྲག་གི་ལྷ་ཚོགས་རྣམས་ལས་འོད་ཟེར་འཕྲོས་པས་བདེ་གཤེགས་ཞི་ཁྲོ་ལྷ་སྲིན་དྲེགས་པ་རྣམས་ཀྱི་མཐུ་སྟོབས།",
    "ཁྱད་པར་བརྟན་གཡོའི་དུག་གི་ནུས་སྟོབས་རྣམས་བསྡུས་ཏེ་ཐིམ།",
    "དགྱེས་པས་འོད་དུ་ཞུ་ནས་དུག་ཁྲག་གི་རྒྱ་མཚོ་དམར་ནག་འཁྲུགས་པ་མྱང་བ་ཙམ་གྱིས་རྡོ་རྗེའི་ལུས་གྲུབ་ཅིང་མཐུ་སྟོབས་ནུས་རྩལ་བསྐྱེད་པ།",
    "གཏོར་བ་ཙམ་གྱིས་སྲིད་གསུམ་བརླག་པར་བྱེད་ནུས་པར་གྱུར་པ་ཁྱེད་རང་རྣམས་ཀྱིས་མྱོང་བས་རྡོ་རྗེའི་ལུས་གྲུབ་ནས་མཐུ་སྟོབས་ནུས་རྩལ་རྒྱས་པར་མོས་ཤིག།",
    "འཆི་མེད་ཚེའི་དངོས་གྲུབ་ཐོབ་པར་མོས་ཤིག།",
    "ཡེ་ཤེས་རྡོ་རྗེའི་ཕྱག་རྒྱས་རྒྱས་བཏབ་པས་མི་འགྱུར་རྟག་པ་དམ་པའི་སྐུ་ཐོབ་པར་མོས་ཤིག་ཧཱུྃ།",
    "སློབ་དཔོན་དང་གཙོ་བོ་ཐ་དད་མེད་པའི་ཐུགས་ཀའི་ཧཱུྃ་གི་འོད་ཟེར་གྱིས་ཕྱོགས་བཅུའི་རྒྱལ་བ་སྲས་དང་བཅས་པ་ཐམས་ཅད་གཤེགས་པ་གཤེགས་མ།",
    "ཉིན་མོ་བདེ་ལེགས་མཚན་བདེ་ལེགས།",
    "དམ་ཚིག་བསྡུས་ཏེ་ཁས་བླངས་པ་དང་གཏང་རག་གི་མཎྜལ་སོགས་རྗེས་བསྡུ་ཡང་བྱའོ།",
    "འོད་གསལ་དེས་ཉོན་མོངས་མཐར་བྱས་ཏེ་བསྡིགས་པས་ཧཱུྃ་སྒྲོག་པ།",
    "མཚན་དཔེའི་དཔལ་ཆེན་པོ་དང་ལྡན་ཞིང་ཡེ་ཤེས་ཉིད་བཞིན་ལག་གི་རྣམ་པར་ཤར་བའི་སྐུ་ཆེན་པོ་ཁམས་གསུམ་མ་ལུས་ཁྱབ་པར་བྱེད་པའི་འོད་ཟེར་གྱི་ཕུང་པོའི་གཟི་བརྗིད་ཆེན་པོ་དང་ལྡན་པ།",
    "བསྟོད་པ་ནི་ཡོན་ཏན་དེ་དག་བརྗོད་པའི་ངག་གི་ལས་དང་།",
    "འདུད་པ་ནི་ཡོན་ཏན་མཐོང་བའི་སྒོ་ནས་ལུས་དང་སེམས་ཀྱི་འདུད་པ་ཡིན་པས་དོན་དེ་ལྟར་དྲན་བཞིན་པས་མགོ་བོ་དུད་དེ་ཐལ་མོ་སྦྱར་ནས་བསྟོད་པ་འདིའི་རྗེས་ཟློས་མཛོད།",
    "ཁྱོད་ཀྱི་ཞབས་ཀྱི་བཀའ་དྲིན་གྱིས།",
    "ཡེ་ཤེས་ནུས་པ་ཟབ་མོ་ཐོབ།",
    "ཕྱོགས་དུས་ཀྱི་བདེ་གཤེགས་ཞི་ཁྲོ་ཐམས་ཅད་འཇམ་དཔལ་ཁྲོ་ཆུ་དུག་གདོང་གི་སྐུ་གསུང་ཐུགས་ཀྱི་ཕྱག་རྒྱའི་རྣམ་པར་ཆར་དྲག་ཏུ་བབས་པ་ཙམ་དུ་བྱོན་ནས་ཁྱེད་རང་རྣམས་ལ་མཚོ་ལ་ཁ་བ་བབས་པ་བཞིན་དུ་ཐིམ་པའི་མོས་པ་མཛོད།",
    "ཞེས་དྲག་ཏུ་བཟླ་ཞིང་རོལ་མོའི་སྒྲ་བྱ་ཡེ་ཤེས་འབེབས་རྫས་ཀྱི་དུད་པས་བདུག་གོ།",
    "ཀྱེ་དཔལ་ཆེ་གེ་མོ་ཞེས་བྱའོ།",
    "ལྗགས་འདྲིལ་ཞིང་དུག་གི་ཁ་རླངས་སྤྲིན་ནག་ལྟར་བསྐྱོད་པ།",
    "སྤྱན་དམར་པོ་གསུམ་གསུམ་སྡང་མིག་ཏུ་གཟིགས་པ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་དགྲ་སཏྭ་འཕྱར་ཞིང་གཡོན་བདུད་ཀྱི་ཙིཏྟ་སྲོག་རྩ་དང་བཅས་པ་བསྣམས་པ།",
    "སྐུ་ལས་དུག་གི་མེ་དཔུང་བསྐལ་པ་འཇིགས་པའི་མེ་ལྟར་འབར་བར་གྱུར།",
    "རིག་མ་སྐད་ཅིག་གིས་ཡུམ་རྡོ་རྗེ་རོ་ལངས་དུག་ཏིག་མ་ནག་མོ་ཅུང་ཟད་ཁྲོ་ཞིང་ཆགས་པའི་ཉམས་ཅན།",
    "བཅུ་དྲུག་ལོན་པ་ལྟར་ལང་ཚོ་ལ་བབས་པ།",
    "མགྲིན་པའི་རྩ་འདབ་ལ་མོན་པ་བཞི་དང་བདུད་པོ་བཞི་སོ་སོའི་ཡུམ་དང་བཅས་པ།",
    "ལུས་ཀྱི་རྩ་ཁམས་ཐམས་ཅད་ལ་འཁོར་དང་སྤྲུལ་པའི་གཤིན་རྗེ་ཕོ་མོའི་ཚོགས་ཐམས་ཅད་གསལ་ལ་མ་འདྲེས་པར་གནས་པ།",
    "ཡབ་ཀྱི་གསང་གནས་མི་དམིགས་པ་སྟོང་པའི་ངང་ལས་ཧཱུྃ་སྔོན་པོ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་ལྔ་པ་རྩེ་མོར་ཨོཾ་ལས་བྱུང་བའི་ནོར་བུ་དཀར་པོ་ཨོཾ་གྱིས་མཚན་པ།",
    "ཐུགས་ཀའི་ས་བོན་གྱི་འོད་ཟེར་གྱིས་ཕྱོགས་བཅུའི་དེ་བཞིན་གཤེགས་པ་སྲས་དང་བཙུན་མོར་བཅས་པ་ཐམས་ཅད་སྤྱན་དྲངས།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་མཉྫུ་བཛྲ་མ་ཧཱ་ཤྲཱི་ཧེ་རུ་ཀ་ཡ་མཱནྟ་ཀ་མ་ཧཱ་བོ་དྡྷི་ཙིཏྟ་ཨ་བྷི་ཥིཉྩ་ཧོ་ཞེས་ཁྱོར་བ་གཡས་པར་སྦྱིན།",
    "རིག་མ་ལངས་ཏེ་རང་གི་པདྨ་ལ་གནས་པའི་བྱང་སེམས་དེ་པདྨ་ལས་ཁྱེད་རང་རྣམས་ཀྱི་ལྗགས་ཀྱིས་གཞིབ་པའི་མོས་པ་མཛོད།",
    "བདེ་བ་དེས་སྟོང་པ་ངེས་པའི་བདེ་སྟོང་དབྱེར་མེད་ཀྱི་ཡེ་ཤེས་སྐྱེས་པའམ་སྐྱེས་པར་མོས་ལ།",
    "དེའང་གདུལ་བྱ་ལ་མཆོག་གི་དངོས་གྲུབ་སྦྱིན་པར་བྱེད་པའི་བྱེད་ལས་ཀྱི་ཁྱད་པར་དང་ལྡན་པའི་གཉིས་སྣང་གིས་མི་ཕྱེད་པའི་རྡོ་རྗེ་མཆོག་ཏུ་མི་འགྱུར་བའི་བདེ་བ་ཆེན་པོའི་ཡེ་ཤེས་དང་ལྡན་པ་དང་།",
    "དག་པ་གཉིས་ལྡན་གྱི་ཡང་དག་པའི་མཐར་སླར་མི་ལྡང་བའི་ཚུལ་གྱིས་མཉམ་པར་བཞག་སྟེ་རོ་གཅིག་ཏུ་གྱུར་པས་མཐར་ཐུག་གི་ཁྱད་པར་ལྡན་པ་དང་།",
    "མཆོག་སྦྱིན་རྡོ་རྗེ་མཆོག་ཁྱོད་འདུད།",
    "ཡང་དག་མཐར་གྱུར་ཁྱོད་ལ་འདུད།",
    "ལྟེ་བར་འདོད་ཆགས་གཤིན་རྗེའི་གཤེད་དམར་པོ་པདྨ་དང་ཐོད་ཁྲག་བསྣམས་པ་དུར་ཁྲོད་ཀྱི་ཆས་ཀྱིས་བརྒྱན་པ་ཡུམ་དབྱངས་ཅན་མ་དམར་མོ་གྲི་ཐོད་འཛིན་པས་འཁྱུད་པ།",
    "རང་རང་གི་རིགས་དང་མཐུན་ཞིང་ལོ་བཅུ་གཉིས་ནས་ཉི་ཤུའི་བར་གྱི་ན་ཚོད་ཅན།",
    "ལྷ་མོ་ཕྱག་རྒྱ་ཆེན་མོ་འདི།",
    "ལྷན་སྐྱེས་སྟེར་བས་ཆེན་མོ་ཡིན་ལ།",
    "རིག་མ་ལ་བརྟེན་ཏེ་བདེ་བ་ཆེན་པོ་བསྐྱེད་པ་འདི་མེད་པར་ཐབས་གཞན་གྱིས་ནི་འཚང་མི་རྒྱ་བ་ངེས་ལ་དེ་བས་ན་རིག་མ་ལྷ་མོ་འདི་ནི་འཚང་རྒྱ་བའི་ཐབས་ཀྱི་མཆོག་ཡིན་ནོ།",
