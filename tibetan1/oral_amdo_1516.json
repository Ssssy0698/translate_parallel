    "ཐུགས་ཀྱི་མོས་པས་དཀྱིལ་འཁོར་དངོས་ལ་འདོར་བའི་ཐུགས་དམིགས་མཛད་དེ་དངོས་སུ་མེ་ཏོག་འདོར་བའི་དཀྱིལ་འཁོར་ལོགས་སུ་བྱས་པ་འདི་ཉིད་ལ།",
    "ཕྱི་རོལ་དུ་ལྟུང་ན་དངོས་གྲུབ་ཕྲ་མོ་ལས་མི་འགྲུབ་ཅེས་ལུང་བསྟན་ནོ།",
    "རང་གི་ལྷས་རྗེས་སུ་འཛིན་པ་ལ་གེགས་བྱེད་ཀྱི་སྡིག་སྒྲིབ་དང་།",
    "དེ་ལས་ཡེ་ཤེས་ཀྱི་མེ་རབ་ཏུ་འབར་བ་འཕྲོས་པ་མིག་འབྲས་ཀྱི་ཨོཾ་ཡིག་ལ་ཕོག་པས་དེའི་སྟེང་གི་མ་རིག་པ་ལ་སོགས་པའི་སྒྲིབ་གཡོགས་ཀྱི་དྲི་མ་ཐམས་ཅད་ལྷག་མེད་དུ་བསྲེགས།",
    "ཁྱོད་ཀྱི་མིག་ནི་འབྱེད་པར་བརྩོན།",
    "དམ་ཚིག་མཆོག་ཏུ་ཁྱོད་འགྱུར་གྱིས།",
    "མཆོག་དང་ཐུན་མོང་གི་དངོས་གྲུབ་ཀུན་ནི་ཕུན་སུམ་ཚོགས་པ་ཐོབ་པར་ཡང་འགྱུར་བས།",
    "འདི་ན་བཅོམ་ལྡན་འདས་འཇམ་དཔལ་གཤིན་རྗེའི་གཤེད་ཁྲོ་ཆུ་དུག་གདོང་གི་དཀྱིལ་འཁོར་མངོན་སུམ་དུ་བཞུགས་པ་ལགས་ཏེ།",
    "ཉོན་མོངས་པའི་གདུང་བ་དང་མ་རིག་པའི་མུན་པ་སེལ་བའི་ཟླ་ཉི།",
    "དུག་གསུམ་མ་སྤངས་གནས་སུ་དག་པས་དཔྲལ་བར་ཐལ་ཆེན་གྱི་ཚོམ་བུ།",
    "བདུད་བཞི་བཅོམ་ཞིང་བདེ་ཆེན་གྱི་རོ་ལ་རོལ་པས་གཡོན་དང་པོས་ཐོད་པ་ཁྲག་གིས་གང་བ།",
    "རྣལ་འབྱོར་གྱི་དཀྱིལ་འཁོར་དཀྱིལ་འཁོར་ཆེན་པོ་བདག་གིས་མཐོང་།",
    "ཅེས་རྒྱུ་གཉིས་དང་རྐྱེན་བཞི་ཚོགས་པའི་རྒྱུ་རྐྱེན་གྱི་མཐུ་བསམ་གྱིས་མི་ཁྱབ་པ་ལས་ཟབ་མོ་སྔགས་ཀྱི་རྟོགས་པ་ཁྱད་པར་ཅན་དངོས་སུ་སྐྱེ་བའམ།",
    "སྐྱེ་རུང་གི་ནུས་པ་རྒྱུད་ལ་འཇོག་པའོ།",
    "ངོ་བོའི་ཁྱད་པར་དམ་ཚིག་གིས་བསྡུས་པའི་སྡོམ་པ།",
    "ངན་སོང་ཐམས་ཅད་མེད་པ་དང་།",
    "མ་གྲུབ་པའམ་མི་སྤྲོ་ན་ཡིད་ཀྱིས་མོས་པས་ཀྱང་རུང་ངོ།",
    "སྦྱང་བྱ་ང་རྒྱལ་དང་ཕྲག་དོག་བྱེད་པ་པོ་དང་བྱ་བའི་འབྲེལ་བ་ཅན་ཡིན་པས་དོན་དུ་རིགས་ལྔ་ཀ་ཚང་བར་དགོངས་མོད།",
    "དྲིལ་བུ་དོན་གྲུབ་ཁོ་ན་སྦྱོར་བར་མཛད་པ་རོ་རྐྱང་གི་དག་པ་དང་སྦྱར་ན་དོན་གཅིག་ཀྱང་འདིར་རྡོར་དྲིལ་གཉིས་པོ་སྤྱིར་ཐབས་ཤེས་ཀྱི་མཚོན་དོན་ཡིན་པ་ལྟར་རྡོ་རྗེ་ནི་ཐུགས་མི་འགྱུར་བ་བདེ་བ་ཆེན་པོ་ཐབས་ཀྱི་མཆོག་ཡབ་འཇམ་དཔལ་གཤིན་རྗེའི་གཤེད་དང་།",
    "དེ་དག་གི་སྐབས་སུ་དམིགས་རྣམས་ནི།",
    "ཁྲོ་བོ་ཁྲོ་མོའི་ཚོགས་ཕྱག་བརྙན་ཕོ་ཉར་བཅས་པ་སྤྱན་དྲངས་ཏེ་ནམ་མཁར་འཁོད།",
    "གླུ་གར་མཛད་ཅིང་རོལ་མོ་བརྡུང་།",
    "བདེ་སྟོང་གི་མོས་པ་བྱེད་ཚུལ་དེའི་ཐོག་དེ་འདྲའི་ཆུ་རྒྱུན་གྱིས་ཐོག་མེད་ནས་བསགས་པའི་སྡིག་སྒྲིབ་ཐམས་ཅད་དང་།",
    "དེ་ཡང་ཆུ་རང་ག་བ་ཞིག་ཡིན་ན་བདེ་བ་སྐྱེ་བ་དང་དེ་འདྲའི་ནུས་པ་འཇོག་པ་སོགས་མི་འབྱུང་མོད་ཀྱང་།",
    "འདིར་ནི་རྣམ་པ་ཆུ་ལ་ངོ་བོ་དོན་དམ་པའི་ལྷ་བདེ་སྟོང་གི་ཡེ་ཤེས་ཁོ་ནར་མོས་དགོས་པས་དེ་ཉིད་ཀྱིས་རྒྱུད་ལ་བདེ་བ་བསྐྱེད་པ་དང་།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་རྡོ་རྗེས་མཚན་པའི་དགྲ་སཏྭ་དང་།",
    "སླར་ཡང་སློབ་དཔོན་དང་གཙོ་བོ་ཐ་མི་དད་པའི་ཐུགས་ཀའི་ཧཱུྃ་གི་འོད་ཟེར་གྱིས་ཕྱོགས་བཅུའི་རྒྱལ་བ་ཡབ་ཡུམ་འཁོར་དང་བཅས་པ་སྤྱན་དྲངས།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་རྡོ་རྗེ་འཁོར་ལོ་པདྨ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་འཁོར་ལོ་རྡོ་རྗེ་ཨུཏྤལ་དཀར་པོ།",
    "ལྷོར་མཾ་སྔོན་པོ་ལས་མ་མཱ་ཀི་སྔོན་མོ་སྔོ་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་གསུམ་རྡོ་རྗེ་འཁོར་ལོ་ཨཏྤལ་སྔོན་པོ།",
    "ནུབ་ཏུ་པྃ་དམར་པོ་ལས་གོས་དཀར་མ་དམར་མོ་དམར་ནག་དཀར་བའི་ཞལ་གསུམ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་པདྨ་རྡོ་རྗེ་འཁོར་ལོ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་སྣ་ཚོགས་རྡོ་རྗེ་འཁོར་ལོ་ཨུཏྤལ་ལྗང་སེར།",
    "ཞབས་པདྨའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "སླར་ཡང་སློབ་དཔོན་དང་གཙོ་བོ་ཐ་མི་དད་པའི་ཐུགས་ཀའི་ཧཱུྃ་གི་འོད་ཟེར་གྱིས་ཕྱོགས་བཅུའི་རྒྱལ་བ་སྲས་དང་བཅས་པ་ཐམས་ཅད་གཤེགས་པ་གཤེགས་མ།",
    "གླུ་གར་མཛད་ཅིང་རོལ་མོ་སྣ་ཚོགས་པའི་སྒྲ་སྒྲོག་གུར་གུམ་ལ་སོགས་པའི་མེ་ཏོག་གི་ཆར་འབེབས་ཤིང་།",
    "དྲི་མ་ཐམས་ཅད་དག་པར་མོས་མཛོད།",
    "ཞེ་སྡང་གི་དྲི་མ་སྦྱངས།",
    "ཡུམ་ཕག་མོ་སེར་མོ་ཕག་ཞལ་ཅན་གྲི་ཐོད་འཛིན་པས་འཁྱུད་པར་གྱུར།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་འཁོར་ལོ་རྡོ་རྗེ་པདྨ་དཀར་པོ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་ནོར་བུ་རྡོ་རྗེ་འཁོར་ལོ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་པདྨ་རྡོ་རྗེ་འཁོར་ལོ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་རལ་གྲི་སྣ་ཚོགས་རྡོ་རྗེ་འཁོར་ལོ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་རྡོ་རྗེ་འཁོར་ལོ་པདྨ།",
    "ཞབས་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་པདྨས་མཚན་པའི་དགྲ་སཏྭ་དང་།",
    "སྐུ་སྐེད་ཡུམ་དབྱངས་ཅན་མ་དཀར་མོ་གྲི་ཐོད་འཛིན་པས་འཁྱུད་པར་གྱུར།",
    "དུག་གི་ཁ་རླངས་སྤྲིན་ནག་ལྟར་གཏིབས་པ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་རྡོ་རྗེའི་དགྲ་སཏྭ་འཕྱར་ཞིང་གཡོན་གསུམ་ཙིཏྟ་སྲོག་རྩ་དང་བཅས་པ་བསྣམས་པ།",
    "དུག་གི་མེ་དཔུང་འབར་བའི་དབུས་སུ་བཞུགས་པའི་སྐུར་གྱུར།",
