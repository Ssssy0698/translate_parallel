    "ལྷག་པར་ཞེན་པ་དེའི་སྤྱིའི་རྣམ་པ་ཉིད་ཡིན་ནོ།",
    "རྣོ་བ་དང་ཞེས་བྱ་བ་ནི་རྣམ་པར་འབྲེལ་པའོ།",
    "ཇི་ལྟར་ངོ་བོ་མཚུངས་པ་ཉིད་དུ་རྣམ་པར་གཞག་སྙམ་ན།",
    "གཅིག་ཉིད་དུ་ལྷག་པར་ཞེན་པས་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་ཤེས་པའི་རང་ལ་དོན་དུ་ལྷག་པར་ཞེན་ཀྱང་སྤྱི་ཇི་ལྟར་ཡིན་ཏེ།",
    "འདི་ལས་ཅི་ཞིག་འགྲུབ་པར་འགྱུར་སྙམ་ན།",
    "སྤྱིའི་རྣམ་པ་ཅན་དུ་གྲུབ་པའི་ཤེས་པའི་རྣམ་པ་ཁྱད་པར་ཅན་ནི་སྤྱིའི་ངོ་བོ་ཡིན་ཏེ་ཞེས་འབྲེལ་ཏོ།",
    "གལ་ཏེ་རྣམ་པའི་ཁྱད་པར་ཤེས་པ་ནི་བདག་ཉིད་ཡིན་པས་ན།",
    "ཀུན་རྫོབ་ཏུ་ལྷག་པར་ཞེན་པ་གང་ཡིན་པ་དེས་སོ།",
    "དངོས་སུ་སྐྱེས་ནས་རྣམ་པར་རྟོག་པར་འགྱུར་རོ་སྙམ་ན་བག་ཆགས་ཀྱི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་སྣང་བ་དང་རྣམ་པར་བརྟག་པར་བྱ་བ་གཅིག་ཏུ་བྱས་ནས་སྒྲུབ་པའི་རང་བཞིན་ཉིད་སྤྱིར་བརྗོད་པ་ཡིན་ནོ།",
    "དེ་ནི་བརྒྱུད་པས་ཞེས་གསུངས་སོ།",
    "ལྡོག་པའི་དོན་རྣམས་ལ་ཞེས་གསུངས་སོ།",
    "འཇུག་པར་བྱེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་དེ་ནི་ལྷག་པར་ཞེན་པ་ལས་སྤྱིའི་རང་བཞིན་ནོ་ཞེས་བྱ་བར་འབྲེལ་ཏོ།",
    "གལ་ཏེ་ཕྱོགས་འདི་ལ་ཇི་ལྟར་ལྡོག་པ་ཅི་ཡིན་སྙམ་ན་ལྡོག་པ་ཉིད་ནི་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་རྣམ་པར་རྟོག་པའི་རྣམ་པ་ལྡོག་པའི་རང་བཞིན་གྱི་སྤྱིར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "ལྡོག་པ་དང་འབྲེལ་པས་ཞེས་གསུངས་ཏེ།",
    "གསལ་བའི་རང་བཞིན་དུ་ལྷག་པར་ཞེན་པ་ཡིན་ན་ཁྱད་པར་མཚོན་པ་མེད་པའི་གསལ་བ་ཉིད་སྤྱིར་འགྱུར་གྱི།",
    "འཇུག་པར་བྱེད་པ་ཉིད་མ་ཡིན་པར་ཞེས་སྨྲས་སོ།",
    "འདི་ནི་ཁས་བླངས་ནས་བརྗོད་པར་ཟད་ཀྱི།",
    "འདི་ནི་ཡོད་པ་ཡང་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་ནི།",
    "འདི་ལྟར་ཤེས་པའི་རང་བཞིན་དངོས་མིན་དེ་བྱེད་པར་བཟུང་བའི་རང་བཞིན་མ་ཡིན་ནོ།",
    "བརྡར་བྱས་པ་ནི་མ་ཡིན་ནོ།",
    "ཞེས་གསུངས་སོ།",
    "བརྗོད་བྱ་ཡིན་པར་རྟོགས་ཀྱང་དོན་དེ་མ་རྟོགས་ན་མི་འཇུག་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བརྗོད་བྱ་ཡིན་ཡང་དངོས་པོ་མ་ཡིན་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "གཟུགས་ལ་སོགས་པས་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་གཉིས་པ་སེལ་བའོ།",
    "དེ་ལ་མིང་ལ་སོགས་པ་མ་འབྲེལ་པ་དང་དོན་དང་འབྲེལ་པ་ལ་ནི་འབྲེལ་པ་མེད་ན་ཡང་འཇུག་པ་མི་འཇུག་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པས་སུན་འབྱིན་པར་བརྗོད་པར་མི་འགྱུར་རོ།",
    "གང་ལ་མ་རྟོགས་པའི་དོན་ལ་འཇུག་པར་འགྱུར།",
    "འཁྲུལ་ན་ཅི་སྐྱོན་སྙམ་ན་འཁྲུལ་ན་ཞེས་གསུངས་སོ།",
    "དམིགས་པ་མེད་པར་འགྱུར་བའི་སྐྱོན་སྤངས་པའི་དོན་དུ་མིང་དང་མཚན་མ་གཞན་དང་གཞན་རྟོགས་ན་ནི་ཐུག་པ་མེད་དོ་ཞེས་བརྗོད་པ་ནི་དེ་ལ་ཡང་ཞེས་གསུངས་ཏེ།",
    "དེ་བཞིན་དུ་ཡང་གཞན་དང་གཞན་ནི་བརྟག་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེས་ན་མིང་དང་མཚན་མར་སྣང་བའི་རྟོགས་པ་ནི་འཁྲུལ་པ་མ་ཡིན་པ་དེས་ན་ཇི་ལྟར་དེས་དོན་ལ་འཇུག་པར་འགྱུར།",
    "དཔེ་ཡང་བསྒྲུབ་བྱའི་ཕྱོགས་སུ་བསླན་པ་ན་དེའི་སྟོབས་ཀྱིས་ཀྱང་འདི་འགྲུབ་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་ནི་དེའི་ཕྱིར་ཞེས་བྱ་བའོ།",
    "སྐྲ་ལས་མི་རྟོགས་པ་ནི་དོན་གྱི་གཟུགས་བརྙན་ཡིན་པའི་ཕྱིར་དོན་དུ་འཁྲུལ་པར་འགྱུར་ཞིང་དེ་ལས་ནི་དོན་ལ་འཇུག་པ་ཡིན་ནོ།",
    "དེ་བཞིན་ཟད་པར་བསྒོམས་པ་ལ་སོགས་པར་མཚན་མ་རྟོགས་པ་ན་སའོ་ཞེས་ལྷག་པར་ཞེན་པ་ལས་འཇུག་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དུས་ཀུན་དུ་འཁྲུག་པ་ལས་འཇུག་པར་མི་འགྱུར་རོ།",
    "གང་མིང་ལ་འཇུག་པར་མཐོང་བས་འཇུག་པར་མི་འགྱུར་རོ།",
    "མཐོང་ན་ནི་ལོང་བ་དང་ལྐུགས་པར་འགྱུར་བས་སྐྲའི་ཐ་སྙད་ཉམས་པར་འགྱུར་རོ།",
    "འོན་ཏེ་ཐོག་མ་མེད་པའི་མ་རིག་པའི་བག་ཆགས་ལས་དེ་ལྷག་པར་ཞེན་པ་ཉིད་དེ།",
    "ཡུལ་ལ་འཁྲུལ་འགྱུར་ཞེས་གསུངས་སོ།",
    "དེ་ཞེས་བྱ་བ་ནི་རྣམ་པ་དང་བཅས་པའི་རྣམ་པར་ཤེས་པ་སྨྲ་བ་ལ་བརྗོད་པ་གང་ཡིན་པ་དེ་མེད་དོ།",
    "རྣམ་པར་ཤེས་པ་དང་ཕྱི་རོལ་གྱི་དོན་ལས་ཐ་དད་པའི་མིང་ནི་ཚད་ཅན་མིན་ཏེ།",
    "དེ་སྐྱེད་པའི་ཁྱད་པར་མ་གྲུབ་པའི་ཕྱིར་ལྡོག་པའི་རྗེས་སུ་དཔག་པ་གྲུབ་པ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ལུས་ཅན་དང་ལུས་ཅན་མ་ཡིན་པ་ཞེས་གསུངས་སོ།",
    "ཡུལ་འདི་ཉིད་དུ་ཞེས་བྱ་བ་ནི་འཁྲུལ་པའི་རྣམ་པར་བརྗོད་པ་ཡིན་ནོ།",
    "ཡུལ་མེད་པའི་ཞེས་གསུངས་སོ།",
    "གང་ལྷག་པར་ཞེས་བྱ་བ་ནི་སུན་འབྱིན་པ་གཞན་དེ་མིང་དང་མཚན་མ་གང་ངོ།",
    "གལ་ཏེ་གཞན་ལ་ལྷག་པར་ཞེན་པ་ལས་ཀྱང་འཇུག་པ་མཐོང་བ་ཡིན་ནོ་སྙམ་པར་དོགས་པ་བསུ་བ་ནི།",
    "དེས་ན་ཞེས་བྱ་བ་ནི་གང་དུ་དངུལ་དུ་ལྷག་པར་ཞེན་པ་ནའོ།",
    "མིང་དང་མཚན་མའི་ཞེན་པ་ལས་ཡང་དེ་ལྷར་འཇུག་པ་ཡིན་ནོ་སྙམ་ན་མིང་དང་ཞེས་གསུངས་སོ།",
    "ཡུལ་ཡོངས་སུ་འཛིན་ན་ཞེས་གསུངས་སོ།",
    "ཡུལ་ནི་མི་གནས་པར་ཡང་ཁས་བླངས་པ་ཡིན་ཞེས་དགོངས་པའོ།",
    "དོན་གང་ལ་ཡང་དེ་ལྟར་འཇུག་པ་ཡིན་ནོ་སྙམ་ན་མིང་དང་ཞེས་གསུངས་སོ།",
    "ཡུལ་ནི་མི་གནས་པར་ཡང་ཁས་བླངས་པ་ཡིན།",
    "རྣམ་པར་དབྱེ་བ་མེད་པའི་ཕྱིར་རོ།",
    "དོན་ལས་ཐ་དད་པར་རྟོགས་པ་ནི་མེད་དོ།",
    "ཡུལ་མེད་པ་ཡིན་ནོ་སྙམ་དུ་དོགས་པ་བསུ་ནས་སྔར་ནི་ལྷག་པར་ཞེན་པར་བྱས་པའི་དངུལ་སྐྲ་ཤད་བཞིན་ཡུལ་དེར་མངོན་སུམ་གྱིས་གཟུང་བའི་ཕྱིར་ཡུལ་དང་བཅས་པར་བརྗོད་པ་ཡིན་ལ།",
    "ལྷག་པར་ཞེན་པར་བྱས་པའི་དངུལ་ནི་ཕྱི་རོལ་ན་མེད་པའི་ཕྱིར་ཡུལ་མེད་པ་ཡིན་གྱི་ཞེས་བྱ་བའོ།",
    "དོན་ལ་ཡང་དངུལ་གྱི་ཡུལ་མེད་པ་ཡིན་ནོ་ཞེས་འབྲེལ་པར་བྱ་བའོ།",
    "མིང་དང་མཚན་མ་དོན་ལས་ལྷག་པར་ཞེན་པར་བྱས་པ་ནི་ཡུལ་མེད་པ་མ་ཡིན་ཏེ།",
    "འདི་ནི་ལྷག་པར་མེད་པ་དེ་ནི་ཡུལ་མེད་པ་ཡིན་ཏེ།",
    "དཔེར་ན་སྐྲ་ཤད་ལ་སོགས་པ་འདི་ནི་འཐད་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་ནི་དངུལ་ནི་ཞེས་པའོ།",
    "དེས་ན་འཇུག་པའི་ཡུལ་ཡིན་ནོ་སྙམ་དུ་དོགས་པ་བསུ་ནས་བྲམ་ཟེ་ཞེས་གསུངས་སོ།",
    "ཇི་ལྟར་བྲམ་ཟེའི་ཁྱེའུ་ལ་ཉེ་བར་བཏགས་པའི་མིང་རྟོགས་པར་བྱེད་པ་མིང་བཏགས་པས་བཟུང་བ་དེ་བཞིན་དུ་དོན་ནི་སྒྲ་ལས་བྱུང་བའི་རྟོགས་པ་འཁྲུལ་པས་འཛིན་པ་ནི་མ་ཡིན་ཏེ།",
    "གཞན་དུ་ནི་ཞེས་བྱ་བ་ནི་མ་རྟོགས་པར་རོ།",
    "འཆད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་མིང་དང་མཚན་མ་བཞིན་དུ་འདིར་ཡང་སུན་འབྱིན་པར་མཚུངས་སོ་ཞེ་ན།",
    "རྣམ་པར་རྟོག་པ་དང་པོ་བསལ་བའི་དོན་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "མིང་དང་མཚན་མ་ནི་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པས་རྟོགས་པ་མི་གསལ་བའི་རྣམ་པ་ཅན་ནོ།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པའོ།",
    "དེ་ན་གསུངས་ཏེ་རྣམ་པར་རྟོག་པས་རྟོགས་པའི་མིང་ལ་སོགས་པ་ལའོ།",
    "དོན་གྱི་རྣམ་པ་ཉིད་ཁས་ལེན་པ་ལ་ཡང་སུན་འབྱིན་པ་བརྗོད་པར་འགྱུར་རོ།",
    "རྣམ་པར་རྟོག་པས་རྟོགས་པའི་མིང་དང་མཚན་མ་འཁྲུལ་པས་ན་དོན་གྱི་རྣམ་པ་ཅན་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་དག་ལས་གྲུབ་པ་ཡིན་གྱི་མིང་དང་མཚན་མ་ལས་ནི་དོན་གྱི་རྣམ་པ་ཉིད་མ་གྲུབ་པོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པ་མེད་པའི་ཕྱོགས་ལ་ཡང་འཛིན་པར་བྱེད་པ་དེ་ཉིད་ཁས་བླངས་ནས་རང་ཉིད་ལན་འདེབས་པ་ནི་དེ་དོན་གྱི་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པས་རྟོགས་པ་དེའི་དོན་དང་ལྡན་པར་དོགས་པ་བསུ་བ་ནི་ཅི་སྟེ་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་རྟོག་པས་རྟོགས་པའི་རྣམ་པ་མིང་དང་མཚན་མ་ཞེས་བྱ་བ་དེ་ནི་དོན་བྱ་བ་བྱེད་པ་མ་ཡིན་པས་ནའོ།",
    "དོན་བྱ་བ་བྱེད་པ་ཉིད་དུ་སྒྲོ་བཏགས་པ་ལས་འཇུག་པར་དོགས་པ་བསུ་བ་ནི།",
    "ལྷག་པར་སྒྲོ་བཏགས་པ་ལས་ཞེས་བྱ་བའོ།",
    "དེ་ལྟ་མ་ཡིན་པ་ཞེས་པས་ནི་ཤེས་པའི་རྣམ་པ་ལ་སྒྲོ་བཏགས་པར་ཁས་ལེན་ནའོ།",
    "མིང་དང་མཚན་མ་ལ་དོན་བྱ་བ་བྱེད་པ་སྒྲོ་བཏགས་པར་འགྱུར་ལ།",
    "དེ་བས་ན་ཤེས་པའི་རྣམ་པ་ཉིད་ལ་ལྷག་པར་སྒྲོ་འདོགས་པར་འཐད་པ་ཡིན་ནོ།",
    "དེ་ལ་ཡང་ཞེས་བྱ་བ་མིང་དང་མཚན་མར་སྣང་བ་ལ་ཡང་ཤེས་པའི་རྣམ་པ་ལ་ཕྱི་རོལ་དུ་འཁྲུལ་པ་བཞིན་དུ་འཁྲུལ་པ་ཉིད་དུ་འདོད་ན་ནི་མིང་དང་མཚན་མ་ཅུང་ཟད་ཀྱང་མེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཤེས་པའི་རྣམ་པ་བཞིན་དུ་མིང་དང་མཚན་མ་ལ་སྒྲོ་བཏགས་པ་ཡང་དོན་ལ་འཇུག་པར་བྱེད་པ་ཉིད་ཡིན་ནོ་སྙམ་དུ་དོགས་པ་བསུ་བ་ནས་ཤེས་པའི་དོན་གྱི་རྣམ་པ་ཅན་དུ་ཁས་ལེན་ན་ནི་ཞེས་གསུངས་སོ།",
    "དོན་གྱི་རྣམ་པ་ཉིད་ལ་སྒྲོ་བཏགས་པ་ཡིན་པར་རིགས་ཏེ་ཤེས་པའི་བདག་ཉིད་ཡིན་པས་མ་མཐོང་བའི་ཕྱིར་རོ།",
    "བདག་ཉིད་ཐམས་ཅད་ཀྱིས་ཞེས་བྱ་བ་ནི་དེའི་རྣམ་པར་ཤེས་པ་ཁ་སྐོང་ངོ།",
    "དེ་ན་རྣམ་པར་རྟོག་པའི་རྣམ་པར་ཤེས་པ་ཡང་དོན་ཁོ་ན་ལྟར་ཁས་བླང་བར་བྱ་བ་ཡིན་ནོ།",
    "རྣམ་པ་འདི་ནི་ཞེས་གསུངས་སོ།",
    "ཤེས་པ་ཐམས་ཅད་ཡུལ་ནི་ཐ་དད་པ་ཅན་ཁོ་ན་ཡིན་པའི་ཕྱིར་ན་མ་འཁྲུལ་པ་དང་རྣམ་པ་མེད་པར་སེམས་བློ་ཤེས་པ་ཐམས་ཅད་ནི་དོན་དང་ལྡན་པར་མི་འཐད་དེ་རྨི་ལམ་ལ་སོགས་པར་ཕྱི་རོལ་མེད་པར་ཤེས་པ་མཐོང་བའི་ཕྱིར་རོ།",
    "འདུ་བྱེད་ལས་ཀྱང་མིན་ཞེས་གསུངས་སོ།",
    "འགལ་བ་དམིགས་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པ་ནི་སྔོན་པོ་ལ་སོགས་པར་ཞེས་གསུངས་སོ།",
    "དེ་ཤེས་ཡིན་ཞེས་གསུངས་སོ།",
    "མདུན་ན་གནས་པའི་རྣམ་པར་དབྱེ་བར་མྱོང་བ་ཙམ་གྱི་དོན་དང་ལྡན་པ་ཡིན་ནའོ།",
    "དམིགས་པ་དང་བཅས་པ་ཡིན་ན་ཡང་ཞེས་བྱ་བ་རྣམ་པར་དབྱེ་བ་ཡོད་པར་དོགས་པ་བསུ་བའོ།",
    "ཅི་ཐམས་ཅད་དམིགས་པ་དང་བཅས་པ་ཡིན་ནམ་འོན་ཏེ་དམིགས་པ་མེད་པ་ཡིན་ཞེས་བྱ་བ་འདི་ལ་ལན་གང་ཡིན་ཞེས་དོགས་པ་ལ་ལན་དུ་དམིགས་པ་མེད་པ་ཉིད་དོ་ཞེས་གསུངས་སོ།",
    "འདི་ཉིད་དེ་ཁོ་ན་ཡིན་པར་ཇི་ལྟར་འགྱུར་སྙམ་དུ་དོགས་པ།",
    "འདི་ལྟར་དམིགས་པ་དང་བཅས་པར་ནི་མི་འཐད་དོ་ཞེས་འབྲེལ་ཏོ།",
    "ཇི་ལྟར་ཞེ་ན་རྨི་ལམ་ལ་སོགས་པ་དག་ན་ཞེས་གསུངས་སོ།",
    "གལ་ཏེ་སད་པའི་གནས་སྐབས་ན་དམིགས་པ་དང་བཅས་པ་ཉིད་དམིགས་པའི་ཕྱིར་གཞན་དུ་ཡང་དེ་ལྟར་ཅི་སྟེ་མི་འདོད་པ་ཞེས་དོགས་པ་བསུ་ནས་བཟློག་པར་ཞེས་བྱ་བའོ།",
    "འདི་ཉིད་གསུངས་པ་ནི་དམིགས་པ་དང་བཅས་པ་ཉིད་ནི་ཞེས་བྱ་བའོ།",
    "གཞན་དུ་ཞེས་བྱ་བ་ཕྱི་རོལ་མེད་པར་ཡང་མཐོང་བའི་ཕྱིར་རོ།",
    "སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པ་ཉིད་མིང་དང་མཚན་མ་ཡིན་ནོ་ཞེ་ན་མིང་དང་མཚན་མ་ལ་ནི་ཞེས་གསུངས་ཏེ།",
    "ཅིའི་ཕྱིར་མི་འབད་ཅེ་ན་རྣམ་པ་དེ་ནི་ཞེས་གསུངས་ཏེ།",
    "བཅད་པའི་ནང་ནས་ཞེས་གསུངས་སོ།",
    "མེའི་འབྲས་བུ་ཞེས་གསུངས་སོ།",
    "སྲེད་པར་མི་ནུས་པ་ནི་མེ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "གྲུབ་པའི་མཐའ་སྨྲ་བས་གལ་ཏེ་ཞེས་གསུངས་སོ།",
    "ཅིའི་ཕྱིར་སྙམ་ན་ཡུལ་དེ་ཉིད་དུ་ཞེས་གསུངས་སོ།",
    "རྣམ་པ་དང་བཅས་པའི་ཁྱད་པར་ཡོད་ན་ནི་ཐམས་ཅད་འཛིན་པ་མ་ཡིན་ནོ་ཞེས་དགོངས་པའོ།",
    "སྔོན་མཐོང་ན་འདུ་བྱེད་པའི་སྟོབས་ཀྱིས་རྣམ་པར་དབྱེ་བ་ཡོད་པར་འགྱུར་རོ་ཞེས་བརྗོད་པ་ནི་སྔོན་གྱི་རང་བཞིན་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་སྔོན་གྱི་རང་བཞིན་མཐོང་བ་ན་རྣམ་པར་ཕྱེ་ནས་མཐོང་བ་འཐད་པ་ཡིན་ནའོ།",
    "གཅིག་སྣང་བ་ལ་ལོག་པར་འདོད་དམ་ཡང་ན་སྣང་བ་ལ་ལོག་པར་འདོད།",
    "གལ་ཏེ་ཞེས་བྱ་བ་ནི་རྣམ་པར་འབྲེལ་པའོ།",
    "ཐམས་ཅད་ཅེས་གསུངས་ཏེ་ཐམས་ཅད་ཅེས་བྱ་བ་ནི་སད་པས་མཐོང་བའི་བདེན་པའི་སྔོན་པོ་ལ་སོགས་པའོ།",
    "རྣམ་པར་དབྱེ་བར་ནི་མི་འགྱུར་རོ།",
    "དེ་ནི་དང་པོ་གསལ་བའི་ཕྱིར་ཅི་སྟེ་ཞེས་གསུངས་སོ།",
    "དོན་རྣམ་པ་གཞན་དུ་གྱུར་པ་གཞན་དུ་འཛིན་པར་བྱེད་པ་གང་ཡིན་པའོ།",
    "གྲུབ་པའི་མཐའ་ནི་དོན་གྱི་རང་བཞིན་མེད་པར་མཐོང་བའི་ཕྱིར་རྟོགས་པ་དམིགས་པ་མེད་པ་ཉིད་ཡིན་གྱི།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ནི་སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པར་རོ།",
    "འདུ་བྱེད་ལས་ནི་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་ཞེས་བྱ་བ་ནི་མཐོང་བའི་སྔོན་པོ་ལ་སོགས་པའི་རྣམ་པར་རོ།",
    "དུས་གཞན་པ་ཡང་མཐོང་བ་དང་འཐོབ་པར་ཡང་ཅི་སྟེ་མི་འགྱུར་བ་ཞེས་བརྗོད་པ་ནི་ཐོབ་པ་ཡང་ཞེས་བྱ་བའོ།",
    "ཐོབ་པར་མི་ནུས་ན་ལྟ་བར་ཡང་ནུས་པ་ཇི་ལྟར་འགྱུར།"
  ]
}