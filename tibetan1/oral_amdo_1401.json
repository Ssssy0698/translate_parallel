    "ངས་ཁྱོད་འགྲོ་རུ་བཅུག་ཆོག་ཟེར།",
    "ཉི་མ་ནུབ་ཕྱོགས་ཀྱི་ས་གནམ་འབྲེལ་མཚམས་ན་སྤྲིན་པ་ཤར་མོ་ཞིག་ཡོད་པ་དེའི་ཕག་ཏུ་ཡལ་བ་དང་།",
    "རིམ་བཞིན་ས་རུབ་ནས་ཕན་ཚུན་མོག་ཙམ་ལས་མཐོང་མི་ཐུབ་པར་གྱུར།",
    "གལ་ཏེ་ཁྱོད་རང་འགུལ་ཙམ་བྱས་ན་ངས་ཁྱོད་གསོད་ཁོ་ཐག་ཡིན།",
    "དོན་༡་ སྤྲང་ཕྲུག་གལ་ཏེ་ཁྱོད་རང་འགུལ་ཙམ་བྱས་ན་ངས་ཁྱི་མོ་འདི་གསོད་ཁོ་ཐག་ཡིན།",
    "ལྟས་ངན་དེས་ཁོ་མོ་ཁྲིད་ནས་འགྲོ་སྲིད།",
    "མའོ་སི་མེ་མདའ་དེ་ལག་ལ་བཟུང་ནས་ཧ་ཅང་སེམས་ཆུང་སྒོས་རྟ་དེ་ཞོན་ནས་ཕར་ལ་སོང་།",
    "ས་སྟོང་གི་བོའུ་སྐད་དེ་ལྷག་པར་གསལ་ཞིང་ཡུན་རིང་བར་དུ་བྲག་ཅའི་རྒྱུན་བསྲིངས།",
    "ཁོ་མོ་གཞན་ལག་ལ་ཤོར་ནས་ཁོས་མི་བསད་པ་དང་ཁོ་མོ་ཚུར་མ་ལོན་བར་དུ་ད་རུང་ཅི་ཙམ་གསོད་དགོས་ཁོས་ཀྱང་མི་ཤེས།",
    "ཁོས་མི་བསད་ཟིན་པས་རང་ཉིད་ལའང་ཉིན་གཅིག་གི་བདེ་བ་མེད་ལ་གལ་ཏེ་རང་སྲོག་འཚམས་འདོད་ན་ངེས་པར་དུ་མེ་མདའ་རིང་ཐུང་གཉིས་ལ་མདེའུ་མཛད་མེད་ཅིག་དང་རྟ་བཟང་བོ་ཡན་ན་མེད་པ་ཞིག་དགོས་པ་དེ་ཉོ་བའམ་ལེན་དུ་ཡོང་བ་རེད།",
    "རྩྭ་ཐང་གི་ཇག་པ་ཚོས་འཕྲོག་ཅེས་པའི་ཚིག་འདི་ཡག་བསྒྱུར་བྱས་ཏེ་བླངས་ཟེར་ལ།",
    "ཨ་ལགས་བླངས་ན་སྐྱིད་པོ་རེད།",
    "གལ་ཏེ་ཨ་ལགས་འབྲོང་གིས་ཁོ་གཉིས་གཡོ་འཚོང་བྱས་པ་མིན་ན་ད་ལྟ་ཁོ་རང་ཁོ་མོ་དང་མཉམ་དུ་ཡོད་སྲིད་པ་དང་།",
    "༢༡༢ ཨ་ལགས་འབྲོང་གིས་དལ་ལྷོད་བག་ཕེབས་ཀྱིས་ཁོ་བོར་བལྟ་ཙམ་བྱས་ནས་གང་དུ་མཐོང་མྱོང་བ་འདྲ་ཟེར།",
    "ཁོས་རང་གི་སྐེ་ན་ད་རུང་ཨ་ལགས་འབྲོང་གི་ཕྱག་མདུད་ཡོད་པ་ཡིད་ལ་དྲན་ཏེ་འཐེན་ཐེངས་གཅིག་གིས་དུམ་བུར་བཅད་ནས་འོ་ན་ཁྱོད་ཀྱིས་འདི་ངོས་ཟིན་གྱི་ཡོད་དམ།",
    "ད་རུང་གཅིག་བུ་མོ་ཞིག་གི་སྐེ་ན་ཡོད་ཟེར།",
    "ཨ་ལགས་འབྲོང་གིས་ད་གཟོད་མི་འདི་སྟོང་དཔོན་དང་མཉམ་དུ་ཡིད་ལ་ཤར་བ་དང་།",
    "ད་གཟོད་མི་འདིའི་དམིགས་ཡུལ་མི་ལེགས་པ་ཤེས་ནའང་ད་རུང་ངོ་མདངས་མི་འགྱུར་བར་ཅི་རེད།",
    "ཁྱེད་ཚང་གིས་གཟིགས་ན་དེ་འདྲ་ཨེ་རེད།",
    "འགྲོ་དྲུག་གཡོ་འཚོང་བྱེད་པའི་འབྲོང་ཚང་ཡིན་ནམ་ཁོ་རང་རིམ་བཞིན་ཁོང་ཁྲོ་ལངས་ཏེ་རང་ཚོད་འཛིན་ཐབས་བྲལ།",
    "སྨྱོན་པ་ཞིག་རེད།",
    "རེད་ཡ།",
    "ཁོས་ལག་གི་ཕྱག་མདུད་དེ་ཨ་ལགས་འབྲོང་གི་མདུན་ལ་གཡུག་སྟེ་ཆོག་གི་ཐོག་མར་ཁྱོད་ཀྱིས་ང་རང་གི་དངུལ་སྒོར་དེ་ཕྱིར་བྱིན་ཟེར།",
    "ཁོ་ལ་དངུལ་སྒོར་གཅིག་བྱིན་ཨ་ལགས་འབྲོང་གིས་གྲྭ་བ་ཞིག་ལ་དེ་ལྟར་བཤད།",
    "ང་ལ་ངེས་པར་དུ་ང་རང་གི་དངུལ་སྒོར་དེ་དགོས།",
    "ཅི་ཞིག་ཁྱོད་རང་གི་དངུལ་སྒོར་དེ་ཧིན།",
    "ཁྱོད་རང་གིས་ངོས་ཟིན་ན་ལེན་རྐྱང་བྱོས།",
    "འདི་ཚང་མ་ཁྱོད་ཀྱིས་གཞན་རྣམས་གཡོ་འཚོང་བྱས་པའི་ཡོང་འབབ་ཨེ་ཡིན།",
    "ཡིན་ནའང་ཨ་ལགས་འབྲོང་གིས་མེ་མདའི་དོ་ཟླ་དབྱུག་པས་མི་ནུས་པ་ཤེས་ནས་ཁོ་ལ་འཁྱེར་དུ་ཆུགས།",
    "ཁྱོད་ཀྱིས་དེ་འདྲའི་གནས་ལུགས་ཟབ་མོ་ཤེས་ན་སྔར་ནས་མ་བླངས་ན་འགྲིག་པ་ལ་ཁོས་ཁྲེལ་དགོད་དང་བཅས་དངུལ་ཏ་ལེན་གང་བོ་རྟ་རྒྱབ་ཏུ་གཡུག་མ་ཐག་ལྡེམ་མྱུར་གྱིས་ཁ་ཕྱིར་འཁོར་ཞོར་མེ་མདའི་ཀླད་པ་སྟོང་གཅུས་ཤིག་བྱས་ནས་འོ་ན་ཁྱོད་རང་མི་རྟག་པ་ཨེ་ཡིན་ཟེར།",
    "ད་ནི་རང་ཚོད་བཟུང་ན་དགའ་ཟེར་ནས་དབྱུག་པ་གནམ་ལ་འཕྱར་ནའང་སེམས་ནས་ཨ་ལགས་འབྲོང་གིས་སྡོད་ཅེས་བཀག་ན་ཅི་མ་རུང་སྙམ་སྟེ་ཨ་ལགས་འབྲོང་གི་གདོང་ལ་བལྟས་མོད།",
    "འདི་ནི་ཨ་ལགས་འབྲོང་གི་སྐད་གདངས་མིན་པ་ཁོ་ཚོས་གསལ་བོར་ཤེས་ནའང་སྐབས་འདིར་འདི་ནི་བདུད་འདྲེའི་སྐད་གདངས་ཡིན་ཡང་ཆོག་ཁོ་ཚོས་དྲག་ཏུ་རེ་སྒུག་བྱེད་བཞིན་པ་ནི་སྡོད་ཅེས་པའི་ཚིག་འདི་ཡིན།",
    "ཁྱོད་ཚོ་ད་རུང་འཆི་འདོད་མེད་ན་ཕར་སོང་།",
    "བུད་སོང་ཞེས་པ་འདི་ནི་བླ་གྲྭ་ཚོས་རྒྱུན་དུ་ཐོས་སྲིད་པ་དང་།",
    "བུད་སོང་ཞེས་པ་འདིས་ཁོ་ཚོར་བཟའ་བཏུང་དང་རྒྱུ་ནོར་མཚོན་གྱིན་ཡོད་པ་རེད།་",
    "དེའི་ཕྱིར་སྔོན་ཆད་ཡིན་ན་བུད་སོང་ཞེས་པ་འདི་ནི་ཇི་འདྲའི་བྱམས་བརྩེ་ལྡན་ཞིང་ཇི་འདྲའི་ཡིད་དུ་འོང་བ།",
    "ཇི་འདྲའི་རྣ་བར་སྙན་པའི་ཚིག་ཅིག་རེད་ཨང་།",
    "ང་ངའི་ཁྱིམ་ན་དངུལ་མང་བོ་ཁྱོད་ལ་སྟེར།",
    "རྟ་འདི་ཁྱོད་ལ་སྟེར།",
    "གྲྭ་བ་འདི་ཚོ་ཁྱོད་ལ་སྟེར་ཟེར།",
    "རྟ་འདི་སྟེར་འདོད་མེད་ཀྱང་ངའི་རེད།",
    "ང་ལ་ད་རུང་ཁྱོད་ཀྱི་སྲོག་དགོས།",
    "ཨ་ལགས་འབྲོང་གི་མིག་མཐར་མཆི་མ་འཁོར་ཞིང་རིམ་བཞིན་སྐྱོ་གདུང་ཆེན་པོས་ངུས་ཏེ་ཁ་ཆུ་སྣ་ཆུ་མིག་ཆུ་གསུམ་མཉམ་དུ་བབས།",
    "ཁོས་སྣང་ཚུལ་འདི་ལ་བལྟ་བཞིན་སེམས་ལ་མ་གཞི་ཁོ་རང་སྐྱེ་བོ་ཕལ་བ་ཞིག་ལའང་དོ་བར་མི་འདུག་སྙམ་སྟེ་ཞེན་པ་ལོག་ཅིང་ཚིག་པ་ཟོས་ནས་མུ་མཐུད་དུ་རྩེད་སྤྱད་བྱེད་དགོས་བསམ་སྟེ་ཨ་ལགས་འབྲོང་གི་དཔྲལ་བར་བོའུ་མཆུ་གཏད་ནས་མ་ཤུ་མནན་རྗེས་ཤིན་ཏུ་ཧ་ལས་པའི་ཚུལ་ཀྱིས་ཨ་ཙི།",
    "ཁོས་ཧབ་ཆ་ཡིད་ཚིམས་པ་ཞིག་བརྒྱབ་རྗེས་ཨ་ལགས་འབྲོང་གི་རྟ་ལ་ཞོན་ཏེ་ཨ་ལགས་བླངས་ན་སྐྱིད་པོ་རེད།",
    "ངས་ཁོ་མོ་ཕྱིར་ལོན་རེག་བར་དུ་ཁྱོད་ལ་ཉིན་གཅིག་གི་བདེ་བའང་ཡོད་མི་སྲིད་ཟེར་ནས་བུད་སོང་།",
    "ཨ་ལགས་བླངས་ན་སྐྱིད་པོ་རེད།",
    "སྐད་ཆ་འདི་ད་ལྟ་ཕལ་ཆེར་ཁོ་བོར་ཁ་བྱང་དུ་སོང་ཡོད།",
    "ཡིན་ནའང་ཐོག་མར་རང་ལ་དཀྲུམ་མདའ་བཟང་བོ་ཞིག་དགོས་བསམ་སྟེ་ཚོང་ར་ཉུལ་བཞིན་སོང་ཞིང་རིང་བོ་མ་འགོར་བར་མེ་མདའ་བཙོང་ས་ཞིག་ལ་འཕྲད།",
    "རི་དྭགས་རྔོན་བྱེད་དགོས་སམ་མི་གསོད་བྱེད་དགོསཡོན་བདག་གིས་འཛེམ་བག་མེད་པར་དེ་ལྟར་དྲིས།",
    "འདི་ནི་ལྗར་པན་ནས་ཐོན་པ་རེད།",
    "འདི་ནི་དབྱིན་ཇི་ནས་ཐོན་པ་རེད།",
    "དཀྲུམ་མདའ་བཟང་བོ་ཡན་ན་མེད་པ་དགོས་ན་ངའི་རྗེས་སུ་ཤོག་ལོ་ལྔ་བཅུ་ཡས་མས་ཀྱི་གྲྭ་བ་ཕྱོར་བོ་མགོ་སྐྲ་ནག་ཀྲིག་ཀྲིག་བྱེད་པ་ཞིག་གིས་སྐད་དམའ་མོས་དེ་ལྟར་བཤད།",
    "ད་དེ་ངོ་མ་ཡིན་ནམ་ཁོ་རང་ཡ་མཚར་སོང་།",
    "རེམ་པར་ཤོག་ཁོས་རྟ་ཁྲིད་ནས་ཡར་འགྲོ་མར་འོང་བྱེད་བཞིན་པའི་མི་ཚོགས་ཁྲོད་ནས་གྲྭ་བ་དེ་མིག་གིས་མ་བཏང་བར་རྗེས་དེད་ནས་སོང་བ་དང་།",
    "གྲྭ་བ་དེས་ཀྱང་ཕྱིར་བལྟ་རེ་བྱེད་བཞིན་མགྱོགས་མྱུར་གྱིས་སོང་སྟེ་གྲྭ་ཤག་ཅིག་གི་རྒྱ་སྒོར་སླེབས་པ་ན་གཞི་ནས་ཁོ་བོར་སྒུག་བསྡད།་",
    "ཁྱོད་ལ་ངོ་མ་དཀྲུམ་མདའ་བཙོང་རྒྱུ་ཡོད་དམ་ཁོས་ཐེ་ཚོམ་ངང་དེ་ལྟར་དྲིས།",
    "སེམས་བདེ་མོ་བྱོས།",
    "གྲྭ་བ་དེས་ཐོག་མར་ཁོ་བོར་ཇ་བླུགས་ཤིང་མདུན་ལ་གོ་རེ་བཞག་སྟེ་དལ་གྱིས་བཞེས།",
    "དལ་གྱིས་བཞེས་ཟེར་ནས་སྣེ་ལེན་བྱས་ནའང་ཁོས་མི་ཟ་མི་འཐུང་བར་ཡང་ཡང་དཀྲུམ་མདའ་སྟོན་ཟེར་བས་གྲྭ་བ་དེས་ཁོ་རང་ཁང་བ་གཞན་ཞིག་གི་ནང་དུ་ཁྲིད་དེ་སྒམ་ལྟར་བཟོས་པའི་ཉལ་ཁྲི་ཆེན་པོ་ཞིག་གི་སྟེང་གི་ཉལ་ཆས་ཕར་དེད་དེ་ཤིང་ལེབ་འགའ་བླངས་པ་ན་མེ་མདའ་རིང་ཐུང་གཉིས་ཀ་རྣམ་པ་སྣ་ཚོགས་ཡོད།",
    "མ་གྲྭ་བ་དེས་དཀྲུམ་མདའ་རེ་རེ་ཡར་བླངས་ཏེ་འདི་ནི་ཁ་ན་ཏ་ནས་ཐོན་པ་རེད།",
    "འདི་ནི་རྒྱ་ནང་ནས་བཟོས་པ་རེད་ཟེར་ཞོར་རེ་རེ་བཞིན་ཁོའི་ལག་ལ་བཞག་ཁ་ན་ཏ་ཟེར་བ་ཅི་ཞིག་རེད།",
    "དེ་ནི་རྒྱལ་ཁབ་ཅིག་གི་མིང་རེད་གྲྭ་བ་དེས་མཚམས་ཤིག་དཀྲུམ་མདའ་ཞིག་ཡར་བླངས་ཏེ་ཕར་བལྟས་ན་ཁྱོད་རང་དཀྲུམ་མདའ་ལ་དེ་འདྲའི་ཆ་རྒྱུས་མེད་པ་འདྲ།",
    "ངས་ཁྱོད་ལ་དྲང་མོར་བཤད།",
    "འདི་ནི་འཇར་མན་རྒྱལ་ཁབ་ནས་ཐོན་པ་རེད།",
    "མདེལ་སྒྲོམ་ནང་ལ་མདེའུ་ཉི་ཤུ་མནན་རྗེས་མཛུབ་གུ་འགུལ་རྐྱང་བྱས་ཆོག་ལ་བོའུ་རིང་ཞིག་གི་རྒྱག་ཚད་དང་གཅིག་འདྲ་ཡིན།",
    "ཁྱོད་ཀྱིས་བལྟས་ན་ཇི་འདྲ་རེད་ཟེར་ནས་ཁོའི་ལག་ལ་བཞག་འདི་ནི་རྡེའུ་ཉི་ཤུ་རུ་གྲགས་པའི་དཀྲུམ་མདའ་ཞིག་ཡིན་ལ།",
    "དང་བོ་འཇར་མན་གྱི་འཆལ་མོ་ཞིག་གིས་གསར་བཟོ་བྱས་ཤིང་།",
    "ཕར་བལྟས་ན་ཁྱོད་རང་མེ་མདའ་ལ་ཧ་ཅང་ཆ་རྒྱུས་ཡོད་པ་འདྲ།",
    "ཁྱོད་རང་གིས་ལྟོས་ཟེར་ནས་ཁོའི་ལག་ལ་བཞག་པ་དང་།",
    "དག་པ་གང་དང་པ་ཆོག་གི་ང་ལ་རིང་བོ་གཅིག་དང་ཐུང་བ་གཉིས་དགོས།",
    "ད་རུང་ངའི་བོའུ་རྡུགས་འདི་ཁྱོད་ལ་རིན་མེད་དུ་བྱིན་པ་ཡིན།",
    "གྲྭ་བ་དེ་རེ་ཞིག་གྲགས་འགུལ་མེད་པར་གྱུར་ཞིང་མཚམས་ཤིག་ངོ་མ་ཨེ་ཟེར།",
    "བོད་ངོ་མ་ཡིན་གྲྭ་བ་དེས་ཁོ་རང་རིང་བོའི་བར་དུ་སྐྱེལ་མ་བྱས་ཤིང་ཡང་དང་ཡང་དུ་སྐྱེས་ཕོ་རབ་ཟེར་ན་ཁྱོད་འདྲ་ཡིན་འོས།",
    "ང་རྒྱུན་དུ་ཡོང་སྲིད་པར་མ་ཟད་དུས་ནམ་ཞིག་ངས་ཁྱོད་སྦྲང་ནག་བཞིན་དུ་གསོད་ངེས་ཡིནཁྱོད་ཚོ་བླ་གྲྭ་རྣམས་ཅི་ཞིག་ཡིན་པ་ངོས་གསལ་བོར་ཤེས་སོང་།",
    "འཕྲུག་ལྭ་ནག་པོ་ཞིག་དང་སྲིན་བལ་གྱི་ཚི་ལེན་ནག་པོ་ཞིག་འོད་ཀྲིག་ཀྲིག་གི་འཇུར་རྟ་ཡུ་རིང་ཟུང་བཅས་གོན་ཡོད་ལ།",
    "བོའུ་རིང་གི་མདེལ་སྟར་ཞིག་སྐྱེད་པར་བཅིངས་ཤིང་དཀྲུམ་མདའི་མདེལ་སྟར་ཞིག་ཕྲག་པ་གཡོན་པའི་སྟེང་ནས་སྐེད་པ་གཡས་པའི་བར་དཀྲིས་པ།",
    "ད་ཁོ་རང་ལུག་རྫི་ཞིག་གི་གམ་ལ་སོང་ནས་སྟོང་དཔོན་ཚང་གི་རུ་བ་གང་དུ་ཡོད་པ་དྲིས།",
    "ཁོའི་སེམས་ལ་གནས་ཚུལ་རེ་རྒྱུས་ལོན་བྱེད་ཐུབ་ཀྱང་སྲིད་བསམ་སྟེ་སར་བབས།",
    "རྭ་ཙེ་ཨེ་ཡོད་ལུག་རྫི་དེས་སློང་མོ་བྱེད་པ་ལྟར་མུ་མཐུད་དུ་འཛུམ་དམུལ་དམུལ་དང་གཉའ་སྒུར་སྒུར་བྱས།",
    "དེ་དང་དེ་མ་གཞི་ཁྱོད་ལ་དུ་ཆད་བྱུང་སོང་།",
    "སྟོང་དཔོན་རྒད་པོར་ཡང་དེང་སྐབས་གཉིད་བདེ་མོ་ཡོང་གིན་མེད།",
    "བུད་མེད་ཅིག་གི་དོན་དུ་ཁོའི་འཁོར་གཡོག་གཉིས་གཞན་གྱིས་བསད་པ་དང་།",
    "ཅུང་ཙམ་མིན་ན་ཁོའི་སྲོག་ཀྱང་ཤོར་སོང་ད་ལྟ་བུད་མེད་དེའི་གནས་བབ་ཇི་འདྲ་རེད།",
    "ཁོ་མོ་ཉིན་མཚན་གཉིས་ཀར་ངུ་བ་ལས་ཟས་ཁམ་གང་ཡང་མི་ཟ་ཟེར།",
