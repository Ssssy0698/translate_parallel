    "ཌ་ཁོས་སླར་ཡང་བོའུ་རིང་བླངས་ནས་བརྒྱབ་ཏེ་མི་རྟ་འགའ་བསད་མཐར་དེ་ཚོས་རྨས་མ་རྣམས་ཀྱང་བསྐྱུར་ནས་ཁྱི་རྐུན་གྱི་རྔ་མ་བཅད་པ་ལྟར་བྲོས་སོང་།",
    "གལ་ཏེ་དེ་འདྲ་མིན་ན་ངས་དངུལ་མང་བོ་བརླག་སྟེ་ཁྱོད་ཚོ་ངོས་ནས་ཅི་བྱེད་སྟོང་དཔོན་གྱིས་ཁོ་མོའི་གདོང་ལ་གཅིག་བལྟས་ནས་འོན་ཀྱང་ང་ལ་འགྱོད་པ་མེད་ཟེར།",
    "ཟླ་བ་ད་ཅི་ཞིག་འགྱོད་པ་མེད་ཐོན་ཀྲང་གིས་ལག་མཐིལ་གཉིས་ཀ་གནམ་ལ་བསྐོར་ནས་ལྡེམ་ལྡེམ་བྱེད་ཞོར་ཧོས་ཏ་ཡ།",
    "ངའི་དམག་མི་ཉི་ཤུ་ལྷག་ཤོར་ན་ཁྱོད་ལ་ད་རུང་འགྱོད་པ་མེད་བཟང་གི་ང་ཚོའི་གྱོང་གུད་འཇལ་སྐབས་ད་གཟོད་ཁྱོད་ལ་འགྱོད་པ་ཨེ་ཡོད་བལྟ་ཟེར།",
    "བོད་ཇག་གཅིག་ཚར་གཅོད་མ་ནུས་པར་ང་རང་ཕྱིར་འགྲོ་ས་མེད་ལ་ངའི་དམག་མི་ཉི་ཤུ་ལྷག་གི་གྱོང་གུད་མ་འཇལ་བར་ཁྱོད་ཀྱང་འདི་རུ་འདུག་ས་མེད།",
    "ཁྱོད་ཀྱིས་ཐོག་མར་ང་ལ་སྤྲང་ཕྲུག་དེའི་མགོ་བོ་ཁྱེར་ཤོག་རྗེས་སུ་ངས་ཁྱོད་ཀྱི་གྱོང་གུད་ལྡབ་འགྱུར་གྱིས་སྤྲོད་ངེས་ཡིན།",
    "ཡིན་ནའང་ད་ནི་གང་ལྟར་ཆུ་ཁར་ཐོན་ནས་རྟ་ཁ་འཐེན་ཐབས་མེད་བསམ་སྟེ་དེ་མ་ཐག་ཕྱོགས་གཞན་དུ་སོང་བའི་དམག་རྣམས་ཀྱི་རྗེས་སུ་མི་མངགས་ནས་གཅིག་ཏུ་བསྡུས་རྗེས་སེམས་ཁམས་ལྷོད་ལ་ཕབས་ཏེ་སྟོང་དཔོན་ཡང་གདན་དྲངས་ནས་འཐབ་ཇུས་ལ་གྲོས་བསྡུར་བྱས།",
    "དེའི་ཕྱིར་ངའི་རེ་བ་ནི་སྟོང་དཔོན་མཆོག་གིས་ང་ཚོར་མཛུབ་སྟོན་བཀོད་འདོམས་གནང་རྒྱུ་དང་བེ་སང་ལ་བཀའ་ཕབས་ནས་ང་ཚོའི་འཐབ་འཁྲུག་ལ་རམ་འདེགས་བྱེད་དགོས་ཟེར།",
    "གལ་ཏེ་ངས་གང་འདོད་དུ་དམངས་ལ་བཀའ་ཕབས་ནས་འཐབ་འཁྲུག་ལ་བཀོད་འདོམས་བྱེད་ནུས་ན་དེ་འདྲའི་དངུལ་མང་བོ་བརླགས་ནས་ཁྱོད་ཚོ་གདན་འདྲེན་བྱེད་དགོས་དོན་མེད།",
    "དེའི་ཕྱིར་ངས་བལྟས་ན་ངའི་ལས་འགན་ནི་ཁྱོད་ཚོའི་གྱོང་གུད་སྐྱིན་ཚབ་སྤྲོད་རྒྱུ་དེ་ཡིན་པ་དང་ཁྱོད་ཀྱི་ལས་འགན་ནི་ང་ལ་སྤྲང་ཕྲུག་དེའི་མགོ་བོ་ཁྱེར་ཡོང་རྒྱུ་དེ་ཡིན་ཟེར་ནས་བུད་སོང་།",
    "གོ་ཐོན་ཀྲང་ཐབས་ཟད་དེ་སྟོང་དཔོན་གྱི་རྗེས་སུ་ཡུལ་སྐད་ཀྱིས་དམོད་མོ་ཡིད་ཚིམས་པ་ཞིག་བྱས་རྗེས་ཚང་མས་སེམས་ཆུང་བྱོས།",
    "གལ་ཏེ་སུ་ཞིག་གིས་རང་ཉིད་བོད་ཇག་དེ་ལ་གསོད་དུ་བཅུག་ན་ངས་སུ་གསོད་ངེས་ཡིན་ཟེར་བ་ན་ཚང་མས་ཧབ་ཆ་ཤོར་བས་ཁོ་རང་སྔར་ལས་ཁྲོས་པར་གྱུར་ཏེ་ཚང་མས་གསལ་བོར་ཉོན།",
    "གལ་ཏེ་སུ་ཞིག་གིས་བོད་ཇག་དེ་ཤོར་དུ་བཅུག་ན་ངས་སུ་གསོད་ངེས་ཡིན་ཟེར།་",
    "ཕྱུགས་རྫི་ཚོས་ཀྱང་རྒྱང་ཕྱོགས་ན་རིམ་བཞིན་ཕྱུགས་ཁྱུ་ཚུར་འདེད་བཞིན་ཡོད་པས་ཐོན་ཀྲང་གིས་རི་མོ་རྐོས་མ་ཅན་གྱི་བྲང་འདོགས་ཆུ་ཚོད་ཅིག་བླངས་ནས་བལྟ་ཙམ་བྱས་རྗེས་ནངས་ཀ་སྔ་མོ་ནམ་ལངས་མ་ཐག་ལམ་ལ་ཆས་ཟེར་ནས་སྟོང་དཔོན་གྱི་གམ་ལ་སོང་།",
    "སྟོང་དཔོན་ཚང་ལ་སྦྲ་རྒན་གཙོ་བྱས་པའི་སྦྲ་ཆེ་ཆུང་མང་བོ་ཡོད་པ་དང་སྦྲ་ཆུང་བ་རྣམས་གྱི་ནང་ན་ཆུན་མ་རེ་བསྡད་ཡོད།",
    "ཁོ་མོ་ཁྲིད་ཡོང་བ་ནས་སྟོང་དཔོན་ཆུན་མ་གཞན་གྱི་གམ་ལ་འགྲོ་བ་ཤིན་ཏུ་ཉུང་བར་མ་ཟད་དོན་དག་རེ་ཡོད་དུས་མ་གཏོགས་སྦྲ་རྒན་ནང་ལའང་མི་འགྲོ་བར་སྦྲ་སོ་མ་ཞིག་གི་ནང་ན་ཁོ་མོ་དང་མཉམ་དུ་བསྡད་ཡོད་པ་དང་།",
    "ལྷག་པར་དུ་ད་ལྟ་ཁོ་མོར་མངལ་ཆགས་ཡོད་པས་ཁོ་རང་དུས་ཐུང་ཙམ་ལའང་ཁོ་མོ་དང་ཁ་མི་བྲལ་བར་ལུས་དང་གྲིབ་མ་ཇི་བཞིན་མཉམ་དུ་བསྡད་ཡོད།",
    "འོན་ཀྱང་ད་ལྟ་མཐོང་བ་ནི་གྲངས་ཀ་མང་བ་མ་གཏོགས་རེ་རེ་ཁྱི་རྒྱག་གི་དབྱུག་པ་ལའང་མི་དོ་བས་ཁོ་རང་རྩ་བ་ནས་རེ་ཐག་ཆད་འདུག་དེའི་ཕྱིར་ཁོས་ཐོན་ཀྲུང་ལའང་དང་ཐོག་ལྟར་བརྩི་བཀུར་མི་བྱེད་པར་མ་ཟད་ད་རུང་ཟུར་ཟའི་ཚུལ་གྱིས་ཁྱོད་ཀྱིས་ང་ལ་ཇག་པ་རྟ་ནག་ཅན་གྱི་མགོ་བོ་ཁྱེར་ཡོང་བ་ཨེ་ཡིན་ཟེར།",
    "རང་ཀ་ཅ་ན་ཁས་ངས་སང་ཉིན་ཁྱོད་ལ་ཁྱེར་ཡོང་ངེས་ཡིན།",
    "ཧིན་ཐོན་ཀྲང་ཧ་ཅང་མ་དགའ་བར་དེ་མ་ཐག་ཕྱིར་འཁོར་ནས་སོང་སྟེ་ཕྱི་ཉིན་ནམ་ལངས་མ་ཐག་ལམ་ལ་ཆས།",
    "ཚོང་དམག་ལམ་ལ་ཆས་པ་ན་གཟས་ནས་དེ་ཚོར་རང་ཉིད་མཐོང་དུ་བཅུག་རྗེས་མདུན་རིའི་རྩེ་ལ་བྲོས་ཏེ་མདེའུ་ཏ་ལེན་གང་གི་ཁ་ཕྱེས་ནས་གམ་ལ་བཟུང་ཞིང་ཞོན་རྟ་ཉལ་དུ་བཅུག་ནས་བསྡད།",
    "ང་བཟོ་ཚོང་དམག་རི་འདབས་ནས་ཡར་འགོས་པ་ན་ཁོས་བོའུ་རིང་ཕར་བསྲིངས་ཏེ་བསྟུད་མར་མདེའུ་ལྔ་བརྒྱབ་རྗེས་སླར་ཡང་བོའུ་ཁོག་ལ་མདེའུ་ལྔ་མནན་ནས་བརྒྱབ་སྟེ་མི་རྟ་འགའ་བསད་པས་ཚོང་དམག་རྣམས་ཕྱིར་འཁོར་མོད།",
    "ཁོས་ཀྱང་དམིགས་འབེན་སོ་ཁུང་དུའང་མ་བླངས་པར་བསྟུད་མར་མེ་མདའ་གསུམ་བརྒྱབ་པ་ན་ཕ་རོལ་གྱི་དཀྲུམ་མདའ་སྒེའུ་ཁུང་ཕྱི་ལ་ལྷུང་སོང་།",
    "ད་བར་ག་དངཀ་ཀ་ཁ་ཁང་བ་འདི་ཨ་ལགས་འབྲོང་གི་མཆོད་ཁང་ཡིན་ལ་ཐོན་ཀྲང་གི་རས་ཞྭ་དཀར་པོ་དེའི་ནང་ལ་ཀླད་གོར་ལག་མཐིལ་ཙམ་དང་མཉམ་དུ་སྟོན་སྐུ་ཞིག་གི་པང་དུ་ལྷུང་འདུག་པ་དང་།",
    "༡ ཁོས་དཀྲུམ་མདའི་མཆུ་ཡིས་ནང་ན་ཀླད་གོར་ཅན་གྱི་རས་ཞྭ་དེ་ཡར་དཔྱངས་ཏེ་དེ་གར་ཧ་ལས་ཤིང་ཧོན་ཐོར་ནས་སྡོད་པའི་ཨ་ལགས་འབྲོང་གི་པང་ལ་གཡུག་སྟེ་འདི་ཚང་མ་སྟོང་དཔོན་དང་ཁྱོད་གཉིས་ཀྱིས་བཟོས་པ་རེད།",
    "འོན་ཀྱང་གལ་ཏེ་ཁྱོད་ཀྱིས་ཁོ་མོ་ངའི་གམ་ལ་མངགས་ཐུབ་ན་ངས་ཁྱོད་སྲོག་ཐར་བཏང་ཆོག་ཟེར།",
    "བློ་གལ་ཏེ་ཁྱོད་ཀྱིས་གཡོ་འཕྲུལ་འཁྲབ་ན་ཐོན་ཀྲང་ནང་བཞིན་ཡིན་ཁོས་ཨ་ལགས་འབྲོང་གི་ལག་གི་ཀླད་གོར་དེར་མཛུབ་སྟོན་ཞིག་བྱས།",
    "གང་ལ་རེམ་པར་སོང་།",
    "ཨ་ལགས་འབྲོང་གིས་ཐོན་ཀྲང་གི་ཀླད་གོར་དེ་སྟོང་དཔོན་གྱི་ལག་ལ་བཞག་ནས་གལ་ཏེ་ཁྱོད་རང་ད་རུང་གསོན་འདོད་ན་ཁོ་མོ་ཕྱིར་སྤྲོད་རིན་རེད་ཟེར།",
    "ཁོ་རང་བདུད་འདྲེ་མིན་ན་ཅི་ཞིག་ཡིན་སྟོང་དཔོན་གྱི་ཁ་ཤའང་སྔོན་པོར་གྱུར་སོང་མོད།",
    "འོན་ཀྱང་མ་ཁར་སོ་བཏབ་ནས་གང་ལྟར་གྱུར་ཀྱང་ངས་ཁོ་མོ་བདུད་འདྲེའི་ལག་ལ་མི་སྤྲོད་ཁོ་ཐག་ཡིན་ཟེར་ནས་ཨུ་ཚུགས་གཡག་ལྟར་བྱས་པས་ཨ་ལགས་འབྲོང་ཡང་ཐབས་ཟད་དེ་ཨ་ཙི་ཨ་ཙི།",
    "ཇི་འདྲའི་མི་ཡ་མཚན་ཞིག་རེད་ཨང་ཟེར་ནས་ཀླད་པ་དམར་པོ་དེ་ཌ་རུ་གཡུག་གཡུག་བྱས།",
    "བློ་༡ རྗེ་བཙུན་འཕགས་མ་སྒྲོལ་མ་ཁོ་མོས་མྱུར་དུ་ཀླད་གོར་དེ་ཕར་གཡུག་ཅིང་ཞེན་པ་ལོག་ནས་སྐྱུག་ཞོར་ཁོ་རང་ངོ་མ་འདྲེ་རུ་གྱུར་བ་ཨེ་ཡིན་ཟེར།",
    "གལ་ཏེ་འདྲེ་མིན་ན་མཱ་ཇག་དམག་གིས་ཀྱང་འགྲན་ཟླ་མེད་པ་སུ་ཡོད།",
    "གལ་ཏེ་འདྲེ་མིན་ན་ཐོན་ཀྲང་གི་ཀླད་ཀོར་བཀོག་མཁན་སུ་ཡོད།",
    "ཨང་གལ་ཏེ་འདྲེ་མིན་ན་ཐོན་ཀྲང་གི་ཀླད་ཞོ་འཐུང་མཁན་སུ་ཡོད་ཟེར།",
    "ཨ་ཧོ་ཁོ་མོས་སྨྲེ་ངག་དྲག་ཏུ་བཏོན་ནས་བརྒྱལ་ལ་ཁད་བྱས་ཤིང་མུ་མཐུད་དུ་སྐྱུག་ནས་དབུགས་ཀྱང་ཆད་ལ་ཁད་བྱས།་",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་ད་རུང་ཁོ་རང་བདུད་འདྲེ་མ་རེད་བསམ་ན་ཁྱོད་རང་ད་ལྟ་ཉིད་ལ་ཁོའི་རྗེས་སུ་སོང་ཆོག་ངས་ཁྱོད་མི་འགོག་ཁོ་ཐག་ཡིན་ཟེར།",
    "ར་མ་རེད་ཡ།",
    "ཁྱོད་རང་སྐྱོབ་ཐུབ་མཁན་ནི་ཁྱོད་རང་གཅིག་པོ་ལས་མེད་དེ་ཨ་ལགས་འབྲོང་གིས་སླར་ཡང་ནམ་རྒྱུན་དད་འབངས་རྣམས་ཀྱི་དྲི་བར་དྲིས་ལན་སྟེར་བ་ལྟར་མིག་ཟུང་བཙུམ་ནས་བདུད་འདྲེ་ཡིན་ཡང་ཁོ་རང་དགའ་བའི་མི་དེའི་ཁ་ལེན་པས་ཁྱོད་རང་དངོས་སུ་སོང་ནས་ཁོ་ལ་རང་ཉིད་ཁོའི་རྗེས་སུ་འགྲོ་འདོད་མེད་པ་དང་།",
    "ང་ཚོའི་ལས་ཁྱོད་རང་ངེས་པར་དུ་འགྲོ་དགོས།",
    "ཡིན་ནའང་བདུད་འདྲེ་ལ་གཡོ་སྒྱུ་ཁྲམ་གསུམ་འཛོམས་པས་ཁ་འཇམ་ཚིག་སྙན་གྱིས་སླར་ཡང་ཁྱོད་རང་བསླུ་རྩིས་བྱེད་སྲིད་ལ་ཁྱོད་ཀྱིས་དེ་ལ་གཏན་ནས་ཉན་མི་རུང་།",
    "ཀྱི་ཁྱོད་ཀྱིས་ངེས་པར་དུ་རང་ཉིད་སེམས་གཏིང་ནས་ཁོའི་རྗེས་སུ་འགྲོ་འདོད་མེད་པ་དེ་ཁོ་ལ་ཤེས་སུ་འཇུག་དགོས་པ་དང་ཁྱོད་ལ་མངལ་ཆགས་ཡོད་པ་དེའང་ཁོ་ལ་ཤེས་སུ་འཇུག་དགོས་ལ་དེ་ལྟར་བྱས་ན་ཁོས་ད་གཟོད་ཁྱོད་རང་བཙན་གྱིས་ཁྲིད་མི་སྲིད།",
    "འ་ཁྱོད་རང་གཏན་ནས་སྐྲག་མི་དགོས།",
    "ཁོང་ཁ་གང་ལྟར་གྱུར་ཀྱང་ངས་ཁོ་མོ་གཅིག་པོ་མི་མངགས་ཁོ་ཐག་ཡིན་སྟོང་དཔོན་གྱིས་དཀྲུམ་མདའ་རུམ་ལ་བཅུག་ནས་ལམ་ལ་ཆས་པ་ན་ཨ་ལགས་གཉིས་ཀྱིས་སྟོབས་ཤུགས་གང་ཡོད་བཏོན་ནས་བཀག་ཀྱང་མ་ཕན་པས་ཨ་ལགས་གཡག་གིས་གལ་ཏེ་ཁྱོད་རང་ངེས་པར་དུ་འགྲོ་རྒྱུ་ཡིན་ནའང་མཚོན་ཆ་གཏན་ནས་འཁྱེར་མི་རུང་།",
    "ངས་ཁོ་མོ་ཁྱོད་ལ་མི་སྤྲོད་པ་མིན་པར་ཁོ་མོ་ཁྱོད་ཀྱི་རྗེས་སུ་འགྲོ་འདོད་མི་འདུག་དེའི་ཕྱིར་ཁྱོད་ཀྱིས་གཡག་ལ་ཆུ་སྐོམ་མེད་ན་མགོ་བོ་མར་མནན་ནས་ཅི་བྱེད།་",
    "མི་རློམ་ན་ཁྱོད་ཀྱིས་ཁོ་མོར་དངོས་སུ་དྲིས་ཆོག་ཟེར།",
    "འཁྱོག་པ།",
    "ཁྱོད་ཀྱིས་ཁོ་མོར་འཇིགས་སྣང་སྐུལ་བཞིན་འདུག་མིན་ཁོ་མོས་ཁེངས་དྲེགས་དང་འཚེར་སྣང་གི་ཉམས་ཀྱིས་སྟོང་དཔོན་གྱིས་ང་ལ་གཏེན་ནས་འཇིགས་སྣང་སྐུལ་མ་མྱོང་ལ་ད་ལྟའང་སྐུལ་གྱིན་མེད།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་ནམ་རྒྱུན་ང་ཚོར་ཕུང་དཀྲུག་མི་བྱེད་ན་ང་རང་དེ་བས་ཀྱང་སྐྱིད་པས་ཁྱོད་རང་གཞན་ལ་འགྲོ་རོགས།",
    "ངས་ཁྱོད་ལ་ཞུ་བ་བྱས་པ་ཡིན།",
    "གང་ལྟར་ད་ལྟ་ང་ལ་མངལ་ཡང་ཆགས་ཡོད་པས་སྟོང་དཔོན་དང་འབྲལ་ཐབས་མེད་ལ་ཁྱོད་ཀྱི་ལག་ཟུང་མི་ཁྲག་གིས་དམར་བོར་གྱུར་ཡོད་པས་འུ་གཉིས་མཉམ་དུ་སྡོད་ཐབས་མེད།",
    "དེའི་ཕྱིར་ཁྱོད་རང་གཞན་ལ་འགྲོ་རོགས།",
    "ངས་ཁྱོད་ལ་ཞུ་བ་བྱས་པ་ཡིན་ཟེར།",
    "ད་ལོ་ནས་ན་ཨ་ལགས་ཡིན་རུང་འོ་བྱེད་འདོད་པའི་མཆུ་སྒྲོས་དེ་ལས་མུ་མཐུད་དུ་ངས་ཁྱོད་ལ་ཞུ་བ་བྱས་པ་ཡིན་ཟེར།",
    "ཕར་བལྟས་ན་ཁྱོད་རང་ངོ་མ་སྐྱིད་པ་འདྲ།",
    "ངས་ཁྱོད་ལ་ཞུ་བ་བྱས་པ་ཡིན།",
