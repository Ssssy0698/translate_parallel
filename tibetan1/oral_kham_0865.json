    "སྡོང་པོ་དཀར་ཞིང་ཕྲ་བར་འདུག།",
    "ཞེས་བཞེད་པ་མི་མཐུན་པ་མང་ཡང་རང་ལུགས་ནི།",
    "ཞེས་བྱ་བ་ལ་དུར་བྱིད་དེའི་རྩ་བ་དམར་ནག་ཏུ་འདུག་པ་ནི་གཅིག་ཡིན་ལ།",
    "ཞུན་ཆེན་གྱི་སྣང་གསལ་སོགས་སྐབས་ཐོབ་དམིགས་གསལ་གསུངས་འདུག་པས་ན།",
    "རང་རང་ཡུལ་གྱི་སྐད་ཀྱིས་ནི།",
    "ཤ་གསེབ་ཏུ་མདེའུ་ལུས་པ་གང་ན་འདུག་བརྟག་པའི་ཆ་བྱད་ལ་ཐོག་མར་མགོ་བོའི་དབྱིབས་སྲན་མ་ལྟར་ཟླུམ་པ་ཞིག་བཏང་སྟེ་བརྟག་པར་བྱའོ།",
    "གང་ཞིག་དུས་གསུམ་དྲི་མེད་པར།",
    "རང་རང་འཕྲོད་ཟས་རྒྱུན་དུ་བསྟེན།",
    "ཞེས་སོགས་རྒྱས་པར་དེ་དང་ཟླ་ཟེར་དང་རང་འགྲེལ་དང་རྒྱུད་ཆེན་སོགས་སུ་བལྟ་བར་བྱའོ།་།",
    "རང་རང་དུས་མ་ཡིན་པར་གསོག་ལྡང་ཉིད།",
    "སོ་སོར་མ་འདྲེས་རང་རང་དུས་ཉིད་ལས།",
    "གཅིག་ཏུ་འདུས་ན་ཀུན་ལ་ཁ་གནོན་སོ་སོར་བཏང་ཞིང་དེ་བཞིན་དུ་ལྡན་པ་དང་འདུས་པ་དང་རང་རང་ཆ་མཉམ་དུ་འདུག་ན་གཉེན་པོའང་བབསིལ་དྲོད་ཆ་མཉམ་དུ་སྦྱར།",
    "གཅིག་ཤོས་ཆུང་བར་འདུག་ཚེ་གཉེན་པོ་ཡང་།",
    "ལུས་ཀྱི་མེ་དྲོད་རང་གནས་འདུག།",
    "ཡིད་འོང་སྙན་ཚིག་བསིལ་གནས་དལ་བར་འདུག།",
    "དེ་སྟེང་རང་རང་ཡུལ་ལྷ་མ་ལྷ་དག།",
    "སྡོད་པར་འདུག་ལུགས་ཚུགས་ཐུབ་ཅིང་།",
    "འདུག་ཚུལ་ཁེངས་ཅན་ཞིག་འདུག་པ་།",
    "འདི་འདྲ་ཞིག་འདུག་གང་ཡིན་ཞུ་ལོ་འདབ།",
    "མཆོག་དམན་སུ་ལ་འདུག་ཀྱང་ཐབས་ཉིད་ཀྱིས།",
    "ཤེས་རྒྱུད་ལེགས་ཉེས་ཇི་ལྟར་འདུག་བརྟག་ཅིང་།",
    "དགོངས་བཞེད་དེ་ཀ་ཡོད་འདུག་པ་ནས།",
    "རིག་འཛིན་པད་མ་འཕྲིན་ལས་ཀྱི་བཀའ་བརྒྱད་དྲག་པོ་རང་བྱུང་རང་ཤར་གྱི་དཀྱིལ་འཁོར་རྣམས་སུ།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་རྗེས་གནང་བཅས་ལ་ཤོག་གྲངས་༤།",
    "སྐུའི་ཡོངས་འཛིན་ཐོག་མ་ཀུན་བཟང་རྩེ་པ་ཐུགས་ཤིན་ཏུ་མགུ་པོ་བྱུང་བས་སྐུ་གོང་མ་དང་ཁྱད་པར་མི་འདུག་ཅེས་བསྔགས་པ་ཆེས་ཆེར་མཛད་དོ།",
