    "ཡང་རང་བཞིན་ལྷུན་གྲུབ་ཀྱི་དོན་དམ་འདུས་བྱས་སུ་ཁས་ལེན་ན་ནི་རང་བཞིན་ལྷུན་གྲུབ་ཀྱི་དོན་དམ་ཞེས་པའི་དོན་དམ་ཡང་བཏགས་པ་ཙམ་དུ་ཟད་པ་ལས་བདེན་གཉིས་ཀྱི་ཟླས་དབྱེ་བའི་༢༨བ་",
    "ཁྱེད་ལ་འཇམ་དབྱངས་ཀྱིས་བསྟན་པའི་རྟགས་ཀྱི་དགག་བྱ་དངོས་པོའི་བྱ་བྱེད་རང་བདེན་པའི་སྟེང་དུ་སྡོད་ལུགས་ཀྱིས་གྲུབ་པའི་བྱ་བྱེད་རང་བདེན་པ་གཉིས་པའི་ལྷན་སྐྱེས་ཀྱི་འཁྲུལ་པའི་བདག་ལྟའི་དམིགས་མྱོང་ནི་ཅུང་ཟད་ཙམ་ཡང་རང་གཞན་སུའི་རྒྱུད་ལ་བཀར་ཡང་མི་སྣང་བའི་ཕྱིར།",
    "ཁྱེད་འདོད་པའི་བདེན་འཛིན་ལྷན་སྐྱེས་དེ་འདྲ་ནི་ཁྱེད་རང་རྣམས་ཀྱི་ངག་ལས་འདི་ལྟར་དུ་ཐོས་ཏེ།",
    "སློབ་དཔོན་ཀླུ་ཞབས་ཀྱི་དགོངས་པའང་རང་གཞན་གྱི་ཕྱོགས་བཟུང་ནས་༣༦ན་",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱིས་སྟོང་པར་མཐོང་བ་ཡི།",
    "བྱང་སེམས་སོ་སྐྱེས་ཀྱང་རང་ཤ་སྟེར་བ་ལ་གུས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "བསམ་གཏན་གསུམ་པ་མན་གྱི་མི་རྣམས་ཀྱི་ཚོར་བ་བདེ་བའང་རང་རྒྱུ་ཟས་གོས་ལ་སོགས་པའི་ལོངས་སྤྱོད་སྡུག་བསྔལ་གྱི་རྒྱུ་ཅན་ཡོད་ན་འབྱུང་ཞིང་།",
    "འདུག་པའི་རྗེས་བརྗོད་བྱས་པ་མ་གཏོགས་དེ་ལྟ་བུའི་རྩོད་པས་མི་བརྫི་བའི་རྩོད་པ་ལས་གྲོལ་སྐབས་ན།",
    "དེ་ལྟའི་དོན་བྱེད་པ་དེའང་རང་བདེན་པ་ཡིན་ཅིང་།",
    "རང་རང་སོ་སོར་རྣམ་རྟོག་གཏིང་ཚུགས་མི་འདུག་པའི་ཕྱིར།",
    "དེ་ཡང་རང་རྒྱུད་དུ་ཇི་ལྟར་བཀོད་ཅེ་ན།",
    "ཡང་རང་ལུགས་ལ་དམ་བཅའ་མེད་པའོ་ཞེས་༨༢ན་",
    "དེ་ལྟར་དོན་བྱེད་པས་དངོས་པོ་དེའང་རང་བདེན་པ་ཡིན་ཅིང་།",
    "འོ་ན་རང་ལུགས་དང་རང་ཕྱོགས་ཅུང་ཟད་ཀྱང་མ་བཞག་བཞིན་གཞན་ཁོ་ན་སུན་འབྱིན་པ་ནི་དགོས་པ་མེད་དེ།",
    "ཁོ་བོས་བདག་སྐྱེ་ཡོད་པར་རང་ལུགས་ཚད་གྲུབ་ཏུ་འདོད་པ་དེ་དགག་པར་བྱ་བའི་ཆེད་དུ་སུན་འབྱིན་གྱི་བདག་སྐྱེ་མེད་ཅེས་སྨོས་ཀྱང་རང་༡༧ན་",
    "འདིར་ནི་རྩོད་པའི་ཆེད་དུ་ངག་ཀྱང་རང་ལུགས་ཀྱི་དེར་གྲུབ་པ་ཞིག་འགོད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་སྒྲུབ་པའི་ངག་འགོད་ཀྱང་རང་བཞིན་མེད་པར་སྒྲུབ་པའི་སྒྲུབ་ངག་འགོད་པ་ནི་གཏན་མིན་ཏེ།",
    "རྩོད་པ་བཟློག་པའི་འགྲེལ་པ་མཛད་པ་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་ཀྱང་རང་རྒྱུད་ཀྱི་སྦྱོར་བའི་ངག་མ་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་དངོས་སུ་བྲིས་གདའ་བས་དེའི་ཤུགས་ལ་ལྟ་བས་ཡེ་ཤེས་ཚོགས་སོག་ལ་འཇུག་པ་ན།",
    "རང་ལུགས་ཀྱི་ཕྱོགས་གང་ཡང་མི་འཛིན་པའི་སྐབས་སུ་ལེགས་ལྡན་འབྱེད་སྒྲུབ་བྱེད་ཐ་སྙད་དུའང་རང་བདེན་པའམ་རང་རྒྱུད་དེ་ལྟར་སྦྱོར་བར་བྱེད་དོ།",
    "ཁྱེད་རང་ཉན་ཐོས་པ་ལ་དོན་དམ་གཏན་ཚིགས་སུ་བྱེད་ན་མ་གྲུབ་པའི་དོན་ཉིད་དང་།",
    "ཡང་ས་མྱུག་དུས་མཉམ་དུ་མེད་དོ་ཞེས་པ་དེ་མི་རིགས་ཏེ།",
    "ས་མྱུག་དུས་མཉམ་གཞན་དུ་གྲུབ་སྟེ།",
    "དཔེ་སྲང་མདའི་མཐོ་དམན་དུས་གཅིག་ཅར་གྱི་ཚེ་བྱེད་པ་ཡིན་ན་ཡང་འདིར་དོན་རྒྱུ་འབྲས་ཀྱི་སྐྱེ་འགག་དུས་གཅིག་པ་མེད་པའི་ཕྱིར་དཔེ་དེས་དོན་དེ་ཡོད་༡༣༥ན་",
    "དོན་རྒྱུ་འབྲས་ཀྱི་སྐྱེ་འགག་དུས་གཅིག་པ་ཡོད་པ་མིན་ཅིང་ཞེས་དུས་མཉམ་ཡོད་པ་མིན་ཏེ།",
    "ཁོ་ཁོ་རང་མ་ཡིན་པར་འགྱུར་ལ།",
    "འཁོར་འདས་གཉིས་སུ་མེད་པར་འདུག།",
    "སྣང་སེམས་གཉིས་སུ་མེད་པར་འདུག།",
    "ངན་དང་ལེགས་ཉེས་ལ་སོགས་པའི་དངོས་པོའི་ངོ་བོ་ཉིད་དུ་གྱུར་པ་ཅུང་ཟད་ཀྱང་མེད་པར་མཉམ་པ་ཉིད་དང་ངང་ཚུལ་གཅིག་པ་ཉིད་དང་རང་བཞིན་གཅིག་པ་ཉིད་དང་ཐ་མི་དད་པར་མཚུངས་པ་ཉིད་དང་ཐ་མི་དད་པ་དང་གཞན་མ་ཡིན་པའི་དེ་བཞིན་ཉིད་དུ་ཚུལ་གཅིག་གོ་ཞེས་གསུངས་པ་ཡིན་གྱི།",
    "རང་གསལ་ཅིར་ཡང་སྣང་ཞིང་གདའ།",
    "དེ་ཡང་དངོས་སྨྲ་བའི་དོན་དམ་གྱི་མཚན་གཞི་འདིར་ཀུན་རྫོབ་ཏུ་འགྱུར་བ་ཡང་རང་རྒྱུད་ཀྱི་གཞུང་ལས།",
    "སྔོན་པོ་སོགས་ནི་བདེན་པར་སྣང་ཞིང་རང་བཞིན་སྟོང་པ་ཉིད་ནི་དེ་ལ་སྒྲིབ་བྲལ་དུ་མི་སྣང་བས་དོན་དམ་པའི་རང་བཞིན་དང་ལོག་པའི་ཀུན་རྫོབ་ནི་ཀུན་རྫོབ་བདེན་པ་མིན་ཅིང་།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་དེ་ཡང་ཉན་ཐོས་དང་རང་སངས་༡༥༨བ་",
    "དེར་ཡོད་པས་ཡོད་པར་མ་གྲུབ་ཅིང་རང་ལུགས་ལ་ཡོད་པར་བཞག་མ་ཐུབ་པ་ལ་དོན་དམ་པར་མེད་ཅེས་མིང་དུ་གདགས་པའི་ཡོད་པ་མ་ཡིན་པ་དེ་ལ་ནི་མེད་པར་དགག་ཙམ་ལས་དེ་ལ་རིགས་པས་དཔྱད་བཟོད་པར་གྱུར་ནས་སླར་ཡོད་པར་གྲུབ་སྟེ།",
    "དགོས་ནའང་ཁྱེད་རང་ལ་ནང་འགལ་དུ་འགྱུར་རོ་ཞེས་སྐྱོན་རྒྱས་པར་བརྗོད་ཟིན་པའི་ཕྱིར་མི་འཐད་ལ་༡༧༨བ་",
    "ཡོད་པར་སྣང་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པའི་ཕྱིར།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "འཇིག་པའི་འགགས་པ་དངོས་པོ་བ་ལ་དེ་ལྟའི་ཚེ་སྐྱེ་འགག་དུས་མཉམ་གྲུབ་ཏུ་ཆུག་ཀྱང་ཞིག་པའི་འགགས་པ་དངོས་མེད་ལ་དུས་མཉམ་མི་རུང་སྟེ།",
    "འཇིག་པ་ལ་འཇིག་རྒྱུ་དོན་གཞན་མེད་ཀྱང་རང་ཉིད་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་ལས་འཇིག་བྱེད་ཀྱི་རྒྱུར་ཡང་བལྟོས་མེད་དུ་གྲུབ་བོ་ཞེས་དཔལ་ལྡན་ས་སྐྱ་པཎྜི་ཏས་རིགས་གཏེར་རྩ་འགྲེལ་ལས།",
    "དཔྱད་ན་སྐྱེ་འགག་དུས་མཉམ་ལ་སྐྱེ་བ་མི་འགྲུབ་སྟེ།",
    "འགགས་ཞིག་དུས་ཀྱིས་མ་བསྡུས་པའི་ཕྱིར།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པའི།",
    "འདིའང་རང་ལུགས་ལ་སྒྲུབ་པ་ནི་མ་ཡིན་གྱི།",
    "རྣག་འབབ་པའི་ཀླུང་སོགས་དངོས་པོ་གསར་སྐྱེ་འགྲོ་བ་ཕན་ཚུན་ལ་སྒྲིབ་ཀྱང་འགྲོ་བ་རང་རང་ལ་མི་སྒྲིབ་པར་དོན་བྱེད་པ་ཅན་གྱི་དངོས་པོ་རང་བདེན་པར་ཡོད་ཅེས་སྨྲ་དགོས་པར་འགྱུར་ན།",
    "དགོངས་འགྲེལ་གྱི་བསྟན་བཅོས་བརྩམས་པ་ཐམས་ཅད་མིའི་རྟེན་ལ་མཛད་ཅེས་ཐག་ཆོད་ཆེན་པོ་ཞིག་བྱས་འདུག་པ།",
    "གཞན་གྱིས་གཞན་འཛིན་པ་མེད་ཀྱང་རང་རིག་པ་ནི་ཡོད་དེ།",
    "ཡང་རང་རིག་མེད་ན་དེ་ཉིད་ཀྱིས་དེ་མ་མྱོང་བར་ཡང་འགྱུར་བ་དང་།",
    "དོན་དམ་དུ་གྲུབ་པ་འགོག་པ་ཡིན་ན་ཀུན་གཞི་དང་རང་རིག་ལ་ཆེད་དུ་བཀར་ནས་འདི་ཙམ་གྱི་དགག་པ་བྱེད་མི་རིགས་པར་འགྱུར་ཏེ།",
    "དངོས་སྨྲ་བ་དང་རང་༢༣༣བ་",
    "རབ་རིབ་ཅན་གྱི་སྐྲ་ཤད་ཀྱི་བདེན་འཛིན་བཟློག་པའི་ཆེད་དུ་སྐྲ་ཤད་སྣང་ཡང་རང་བཞིན་མེད་དོ་ཞེས་སྨྲ་བ་ལྟར།",
    "ཀུན་རྫོབ་ཐ་སྙད་དུའང་རང་ལུགས་ཀྱི་ཡོད་མེད་གང་དུ་ཡང་ཁས་མ་བླངས་པའི་ཕྱིར།",
    "དངོས་འཛིན་གྱི་འགལ་འདུ་ཅིར་ཡང་གདའོ།",
    "དག་དུས་རྟག་ཏུ་རྒྱུ་ཡིན་མིན་ཐམས་ཅད་ལས་ཀྱང་སྐྱེ་བར་འགྱུར་ཏེ།",
    "རབ་རིབ་ཅན་ལ་བརྒལ་ཞིང་བརྟག་པ་ཕར་འདུག་ཅིག།",
    "འཁོར་འདས་འཆིང་གྲོལ་གྱི་རྒྱུ་འབྲས་འདི་ཐམས་ཅད་ལ་ངོ་བོ་ཉིད་དང་རང་བཞིན་ཡོད་ན་དེ་ལྟར་དེ་བཅོས་མིན་དང་།",
    "ད་འཇིག་རྟེན་སྤྲོས་དང་བྲལ་ཙ་ན།",
    "གཞན་ལུགས་ཀྱང་འགོག་དོན་མི་འདུག་པས།",
    "དེས་ན་དངོས་པོ་འགའ་ཡང་རང་བཞིན་གྱིས་ཁས་མ་བླངས་ཏེ་རྐྱེན་འདི་པ་ཙམ་གྱི་རྟེན་འབྱུང་རྣམ་པར་བཞག་པའི་ཕྱིར།",
    "དཔྱོད་བྱེད་དཔྱད་བྱ་ཉིད་ཀྱང་རང་བཞིན་གྱི།",
    "དེ་ལྟར་གསུངས་པ་སྐྱེས་བུ་དམ་པ་ཐམས་ཅད་ལ་མཐོང་ཐོས་ཙམ་ཡང་མི་འདུག་པའི་ཕྱིར་རོ།",
    "དངོས་པོའི་འཇིག་ཞིག་ཐམས་ཅད་དངོས་པོ་ཡིན་པར་ཁྱེད་རང་འདོད་ཅིང་ཞིག་དངོས་ལས་འབྲས་ཀྱི་རྟེན་གྱི་གང་ཟག་ཡིན་པར་རིགས་ན་འཇིག་དངོས་དེ་ཡིན་པ་ལའང་གནོད་བྱེད་མེད་ཅིང་སྒྲུབ་བྱེད་མཚུངས་པའི་ཕྱིར།",
    "སློབ་དཔོན་ཆེན་པོ་ཟླ་བ་གྲགས་པས་འཇུག་པ་རྩ་འགྲེལ་འདིར་རྒྱས་པར་བཀག་གདའ་བས་ཐར་འདོད་རྣམས་ལེགས་པར་སོམས་ལ་མིག་མེད་གཡང་ས་ཆེན་པོ་ལ་གོམ་པ་འདོར་བའི་རྗེས་སུ་མིག་ལྡན་དག་བག་གཟོབས་ཤིག།",
    "གང་ཚེ་དེ་སྐད་སྨྲ་ཞིང་རང་ཕྱོགས་ཁོ་ན་རྣམ་འཇོམས་པ།",
    "དེས་ན་ཁོ་བོ་ཅག་སུན་འབྱིན་དབྱུང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་ཁས་མ་བླངས་པས་རང་ཚིག་ལ་འགལ་བ་མེད་ཅིང་།",
    "འབྲས་ལ་རང་བཞིན་ཡོད་པར་རྟོག་ནས་དཔྱད་རིགས་པ་ལྟར་གསལ་བྱེད་ཀྱི་རྒྱུ་འབྲས་ལའང་རང་བཞིན་ཡོད་པར་རྟོག་ནས་དཔྱད་རིགས་པར་མཚུངས་པ་དེ་ཉིད་འཇུག་པའི་གླགས་ཡོད་པའི་ཕྱིར་ཏེ།",
    "སུན་འབྱིན་དབྱུང་རང་བདེན་པ་ཞིག་རང་ལུགས་ལ་ཁས་བླངས་ནས་ལན་དེ་ལྟར་བརྗོད་ན་ད་དུང་ལྟག་ཆོད་ཀྱི་མཚུངས་པ་སྤང་མི་ནུས་པའི་ཕྱིར་ཁྱེད་ཀྱི་ལན་དུ་བྱ་བའི་རྩོད་སྤང་དེ་མི་རིགས་པ་ཉིད་དོ།",
    "ཐ་སྙད་པར་ཡང་རང་ལུགས་སུ་བསྒྲུབ་བྱ་སྒྲུབ་བྱེད་གང་བཞག་པ་དེ་ཉིད་ཀྱི་སྤྲོས་པ་ཉེ་བར་མ་ཞི་བའི་ཕྱིར།",
    "རང་བཞིན་གྱིས་གྲུབ་པའི་རང་བཞིན་ནི་བདེན་པ་གཉིས་ཀར་ཡང་རང་བཞིན་དུ་མི་རུང་ངོ་ཞེས་བརྗོད་ལ།",
    "དེ་ལྟར་བརྗོད་པའི་རང་བཞིན་དེར་རང་བཞིན་དུ་མ་གྲུབ་ཀྱང་རང་བཞིན་དུ་སྒྲོ་བཏགས་ནས་གཞན་བྱིས་པས་བཏགས་པའི་རང་བཞིན་དེ་བཟློག་པའི་དགོས་པའི་ཆེད་དུ་ཀུན་རྫོབ་ཐ་སྙད་དུའང་རང་བཞིན་དེ་ལྟ་༣༢༣ན་",
    "ཐ་སྙད་དུའང་རང་ལུགས་ཀྱིས་གྲུབ་པའི་རང་བཞིན་དང་།",
    "ངོ་བོ་ཉིད་ཀྱིས་བདེན་པར་གྲུབ་བོ་ཞེས་སྨྲ་བའི་ངོ་བོ་ཉིད་མེད་སྨྲ་དེ་ནི་འཕགས་པའི་ཡུལ་དང་གངས་ཅན་གྱི་ཁྲོད་དུ་སྔོན་མ་བྱུང་བས་ངོ་བོ་ཉིད་དང་རང་བཞིན་སྨྲ་བའི་རང་བཞིན་མེད་སྨྲ་བ་འདིའང་ཅི་ལྟ་བུ་ཞིག་ཡིན།",
    "མགོན་པོ་ཀླུ་སྒྲུབ་ལ་དཔལ་ལྡན་ཟླ་བས་དངོས་ཀྱིས་བསྙེན་པར་ཇོ་བོ་རྗེ་དཔལ་ལྡན་ཨ་ཏི་ཤས་གསུངས་པའི་ཕྱིར་ན་ཁྱེད་རང་འདོད་པའི་རྫོགས་ལྡན་གྱི་དུས་མ་རྫོགས་པར་ཟླ་གྲགས་༣༣༡ན་",
    "ཤེས་བྱ་དངོས་པོ་རང་རང་ལ་བདག་བདེན་ཡོད་པ་དེ་རྟགས་ཀྱི་དགག་བྱའི་བདག་ཤེས་བྱ་རང་རང་ལ་ཡོད་པ་དེ་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "ཀུན་རྫོབ་ཐ་སྙད་ཚད་གྲུབ་རང་རང་ངོ་བོས་མི་སྟོང་ཞིང་།",
    "རང་རང་རིས་མཐུན་ཕྱོགས་བཅུར་རྒྱས་པ་ལ།",
    "ཡང་ཇོ་ནང་པ་ནི་ཀུན་རྫོབ་བདེན་པར་རང་རང་ངོ་བོས་སྟོང་པས་རང་སྟོང་དང་།",
    "རྣམ་རྫུན་པས་ཀྱང་རང་ལུགས་སུ་རང་སྟོང་ཁས་མི་ལེན་ཅིང་།",
    "དེ་ཏིང་ངེ་འཛིན་དེ་ཐོབ་མ་ཐག་པདྨ་དེ་ལ་འདུག་པར་ཀུན་ཏུ་སྣང་ངོ།",
