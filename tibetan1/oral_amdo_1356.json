    "ཛཱིབ་འཁོར་གཉིས་ཕྱི་ལོགས་དེར་སླེབས་སོང་།",
    "ཨ་རི་བ་དེ་གཅིག་དང་ང་ཚོ་གཅིག་ལ་བསྡད་ནས་ད་དུང་ཡང་ཆུ་ཚོད་དྲུག་གི་རིང་སོང་།",
    "ང་ཚོ་ཇི་ཙམ་ཞིག་ཁ་སྐོམ་ཡོད་པ་དེ་ངས་དྲན་གྱི་འདུག་ང་ཚོ་ལྡི་ལི་དང་རྡོ་རྗེ་གདན།",
    "ཝ་ར་ཎ་སི་བཅས་སུ་སོང་མྱོང་ཡོད་ནའང་།",
    "ང་ཚོ་བོད་མི་ཚོ་ནི་གནམ་གཤིས་ཚ་པོ་ལ་གོམས་ཡོད་པ་མ་རེད།",
    "ང་ཚོ་གཙང་པོ་ཞིག་ལ་ནམ་ཐུག་གི་སྐབས་སུ་ང་ཚོས་ཆུ་འཐུང་ཆེད་ཐེངས་ཁ་ཤས་ཀྱི་རིང་འགོག་དགོས་བྱུང་།",
    "ང་ཚོས་བཀག་ཐེངས་རེ་རེ་བཞིན།",
    "འདིའི་ནང་དངོས་གནས་མི་མང་པོ་ཞིག་གིས་ཐེ་ཇུས་བྱས་ཡོད་དམ།",
    "ང་ཚོ་ལ་རྒྱ་གར་གྱི་ཟསརིགས་སྤྲད་ནས་ཏོག་ཙམ་རིང་ངལ་གསོ་རྒྱག་བཅུག་བྱུང་།",
    "དེ་ནས་ང་ཚོ་མེ་འཁོར་ས་ཚིགས་ཤིག་ལ་འཁྲིད་སོང་།",
    "ང་ཚོ་ནི་བཙོན་པ་སྐོར་གཅིག་མེ་འཁོར་གྱི་ནང་བསྐྱལ་གྱིན་ཡོད་པ་ལྟ་བུ་མཐོང་ཆེད་དུ་པཱ་ཀི་སི་ཐན་གྱི་དམག་མི་ཚོས་ང་ཚོའི་མཐའ་བསྐོར་ནས་ཡོད།",
    "ངའི་བསམ་ཚུལ་ལ་དེ་ལྟར་བྱས་ན་མི་སུ་ཞིག་གིས་ང་ཚོ་ལ་དྲི་བ་གང་ཡང་འདྲི་གི་མ་རེད།",
    "ཁོང་ཚོས་ང་ཚོ་ནི་གྲལ་རིམ་ཡག་ཤོས་ཀྱི་ནང་འགྲུལ་མི་གཞན་གང་ཡང་མེད་པར་བཞག་སོང་།",
    "ང་ཚོ་ཡིད་འགུལ་ཐེབས་སོང་།",
    "ཧ་ཅང་གིས་གྱ་ནོམ་པ་རེད་འདུག་དེ་ནས་མི་གཅིག་གིས་འཁྲུག་པ་བླུགས་པའི་ཆུ་འཁྱེར་ནས་ཡོང་སོང་།",
    "ང་ཚོ་ཧ་ཅང་ཡ་མཚན་པ་རེད།",
    "ང་ཚོ་འཛམ་གླིང་གི་ཚ་བ་ཆེ་ཤོས་ཀྱི་ས་ཆ་ཞིག་ལ་ཡོད་ཅིང་།",
    "ཁོང་ཚོ་ལ་འཁྲུག་པ་ཞིག་ག་ནས་རག་པ་རེད།",
    "ང་ཚོ་མེ་འཁོར་ཐོག་ནས་ཡུན་རིང་པོ་ཞིག་ལ་སོང་།",
    "དེ་ནས་ང་ཚོ་རས་ཀྱིས་གཡོགས་པའི་ཊཀ་འཁོར་ལ་སྤོར་བཅུག་སོང་།",
    "ཡང་བསྐྱར་ཡུན་རིང་པོ་ཞིག་ལ་སོང་།",
    "ཉི་ཧོང་གི་ཨོ་ཀི་ན་ཝ་ཡི་ཀ་ཌི་ནཱ་ཞེས་པའི་ཁོངས་སུ་ཡོད་ལ།",
    "རྒྱུན་ལྡན་མིན་པའི་ལས་དོན་ཆེད་གོ་སྒྲིག་བྱས་པའི་གནམ་གྲུ་ཞིག་རེད་ལ།",
    "ང་ཚོ་རྒྱབ་ཀྱི་སྐས་འཛེགས་བརྒྱུད་ནས་གནམ་གྲུ་ལ་བྲེལ་མྱུར་གྱིས་སོང་།",
    "སྒེའུ་ཁུང་ཚང་མའི་སྒེའུ་ཡོལ་བརྒྱབ་སོང་ལ་ང་ཚོ་ལ་སྒེའུ་ཁུང་འབྱེད་བཅུག་མ་སོང་།",
    "ཧ་ལམ་དེ་མ་ཐག་ཏུ་ང་ཚོ་འཕུར་སོང་།",
    "གནམ་གྲུ་ཞིག་གི་ནང་དུ་སླེབས་པ་དེ་ཇི་ཙམ་གྱིས་ཁྱད་མཚར་པོ་དང་སྤྲོ་ཉམས་ཅན་ཞིག་ཡིན་པ་དེ་ཁྱེད་རང་གིས་ཤེས་དགོས།",
    "གལ་སྲིད་ཁྱེད་རང་གིས་དེའི་སྐོར་ལ་བསམ་བློ་བཏང་ན་གནམ་གྲུའི་མགྱོགས་ཚད་དེ་དངོས་གནས་འགྲོ་བ་མིས་བྱེད་ཐུབ་པ་ཞིག་མ་རེད།",
    "ནང་པའི་གཏམ་རྒྱུད་ཅིག་གི་ནང་སྲིན་པོ་མིག་སྔོན་པོ་ཅན་ཞིག་གིས་མི་གཅིག་རྒྱ་མཚོའི་ཕ་རོལ་དུ་འཁྱེར་བའི་སྒྲུང་ཞིག་ཡོད་པ་རེད།",
    "ང་ཚོས་འཁྱུག་ཙམ་རེ་ལྟ་ཐུབ་དུས་ང་ཚོ་རྒྱ་མཚོའི་ཐོག་རྒྱ་ནག་ལྷོ་ཕྱོགས་རྒྱ་མཚོ།",
    "འཕུར་གིན་ཡོད་པ་མཐོང་ཐུབ་ཀྱི་འདུགའདི་ནི་ང་ཚོས་ཐེངས་དང་པོར་རྒྱ་མཚོ་ཞིག་མཐོང་བ་དེ་རེད།",
    "དེ་ནི་ང་ཚོ་ཚང་མ་ལ་ཧ་ཅང་དགའ་སྤྲོ་ཡོང་བ་ཞིག་རེད།",
    "ང་ཚོ་ཐའེ་ཝན་དུ་ཡོད་པའི་དམག་སྒར་ཆེན་པོ་ཞིག་གི་ནང་དུ་འཕུར།",
    "དོན་དངོས་སུ་དེ་ནི་ཉི་ཧོང་གི་ཨོ་ཀི་ན་ཝ་རེད།",
    "ཡིན་ན་ཡང་ང་ཚོས་ཚོད་དཔག་བྱས་པ་ཡིན།",
    "གང་སར་ཡོད་པའི་ཨ་མི་རི་ཀའི་གནམ་གྲུ་དག་གི་གཡས་གཡོན་དུ་ད་དུང་རྒྱ་མི་མང་པོ་ཞེད་པོ་འདུག་ཁང་པ་དེ་ཚོའི་ཐོག་རྒྱ་ཡིག་བྲིས་འདུག་མི་དེ་ཚོ་ཉི་ཧོང་པ་རེད་ལ་ཡི་གེ་དེ་ཚོ་ཡང་ཉི་ཧོང་གི་སྐད་རེད།",
    "ང་ཚོ་རི་འབུར་ཞིག་གི་རྩེར་ཡོད་པའི་ཁང་པ་དམག་སྒར་ལ་ཁ་མར་བལྟས་པ་ཞིག་གི་ནང་དུ་བཞག་སོང་།",
    "དེར་དོན་དག་གཉིས་བྱུང་སོང་།",
    "གཅིག་གིས་ང་ཚོ་ཁོང་ཁྲོ་ཟ་བཅུག་སོང་ལ་གཅིག་གིས་ང་ཚོ་དགའ་བཅུག་སོང་།",
    "དེར་གཟུགས་པོ་བརྟག་དཔྱད་བྱེད་ཆེད་གྱོན་ཆས་ཕུད་དགོས་པ་རེད་ཟེར།",
    "དང་པོ་དེ་ལ་ང་ཚོ་ནི་གཟུགས་པོ་ཐང་ཐང་དང་སྟོབས་ཅན་ཤ་སྟག་ཡིན་ཙང་དེ་ནི་དུས་ཚོད་འཕྲོ་བརླག་ལ་བཏང་བ་ཞིག་རེད་བསམས་སོང་།",
    "གཉིས་པ་དེ་ལ་བོད་མི་ཚོ་ནི་གཅེར་བུར་ལངས་ནས་ཡར་མར་འགྲོ་གི་མ་རེད།",
    "ཡིན་ན་ཡང་ཁོ་ཚོས་དེ་ནི་གཟུགས་པོ་བརྟག་དཔྱད་བྱེད་པའི་ཆ་ཤས་ཤིག་རེད་ཅེས་ཨུ་ཚུགས་བརྒྱབ་སོང་།",
    "གང་ལྟར་ཡང་ཁོང་ཕེབས་པ་ནས་ང་ཚོ་ལྷོད་ལྷོད་ཆགས་བྱུང་ལ།",
    "ང་ཚོའི་གཟུགས་པོའི་བརྟག་དཔྱད་ཀྱང་ཚད་ལྡན་སླེབས་པ་རེད།",
    "བདུན་ཕྲག་རྗེས་མ་དེར་ཨ་མི་རི་ཀ་བ་ཚོས་ང་ཚོ་འདྲི་བརྩད་བྱས་ནས་དུས་ཚོད་བསྐྱལ་བ་རེད།",
    "ཡིན་ན་ཡང་ང་ཚོའི་སུ་གཅིག་གིས་ཀྱང་སྐབས་དེ་དུས་ཤེས་ཀྱིན་ཡོད་པ་མ་རེད།",
    "དེ་ཚོ་ཚང་མ་ང་ཚོ་ལ་ཧ་ཅང་གི་ཁྱད་མཚར་པོ་དང་གསར་པ་རེད།",
    "རོ་ཇཱར་ཨི་མེཀ་ཐེ་ནི་ཕྱི་རྒྱལ་གྱི་གནས་སྟངས་འདྲ་མཚུངས་ཤིག་གི་ནང་བརྫངས་ཡོད་པ་རེད།",
    "དེའི་གོ་དོན་ནི་འཇབ་དམག་གཅིག་པུ་མ་རེད།",
    "དེའི་ཁར་གསང་ཞིབ་དང་གནས་ཚུལ་གཏོང་སྟངས་སོགས་ཚུད་ཡོད་པ་རེད།",
    "དེ་ནི་སྣེ་པཱན་གྱི་དཔེ་མཛོད་ཁང་དུ་ཡོད་པའི་བོད་སྐོར་གྱི་དེབ་གཅིག་པུ་དེ་རེད།",
    "ང་ལས་ཀའི་ནང་ཞུགས་ནས་ལོ་ལྔ་མ་གཏོགས་སོང་མེད་ལ།",
    "དེ་ནི་གཞན་གྱིས་མི་བྱེད་པ་ཤས་ཆེ་བ་ཞིག་ལ་བརྟེན་ནས་ང་ལ་བོད་ཀྱི་ལས་དོན་འདི་ཕོག་པ་རེད།"
  ]
}