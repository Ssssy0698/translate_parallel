    "མི་སུ་གཅིག་གིས་ཀྱང་ཨ་མི་རི་ཀ་ཕམ་ཐུབ་ཀྱི་མ་རེད།",
    "ང་ཚོ་ཧ་ཅང་དགའ་སོང་།",
    "ཁོང་རྟ་ཐོག་ནས་ཕྱིར་ཕ་ཡུལ་དུ་ཕེབས་རྒྱུ་རེད་ལ་ས་ཆ་གཡང་ས་དོག་སར་སླེབས་སྐབས་ཞབས་ཐང་ལ་ཕེབས་དགོས།",
    "མ་མཐའ་ལ་ཡང་ཆབ་སྲིད་ཀྱི་ལས་ཀ་དེ་ཆད་ལུས་སུ་འཇོག་གི་རེད།",
    "ཆབ་སྲིད་ཀྱི་སྐད་ཆ་དག་གིས་ལྡི་ལི་རུ་ངོས་རང་གི་དུས་ཚོད་མང་ཤོས་བཟུང་ཞིང་ངོས་རང་གི་གནས་བསྐོར་ཇེ་ཐུང་དུ་བཏང་།",
    "བོད་ནང་གི་བོད་མི་ཚོའི་ཆེད་དུ་ངོས་རང་གི་ལས་འགན་དེ་མེད་པ་ཡིན་ན་ངོས་རང་དགའ་བསུ་དང་བཅས་ཆབ་སྲིད་ཀྱི་ལས་ཀ་ནས་དགོངས་ཞུ་བྱེད་འདོད་བྱུང་།",
    "རྣ་ཐོས་ལ་ཡི་རི་རྩེ་དེར་ངོས་ཀྱིས་རྒྱ་གར་དང་འབྲས་ལྗོངས་ཀྱི་རང་གི་གྲོགས་པོ་མཐའ་མ་རྣམས་ལ་ག་ལེར་བཞུགས་ཞུས་པ་ཡིན།",
    "དེས་ཁྱོན་བསྡོམས་ཀྱི་དམག་མིའི་གྲངས་འབོར་དེ་སྟོང་ཕྲག་ཉིས་བརྒྱ་ལས་སླ་བོར་བརྒལ་བ་ཆགས་ཡོད།",
    "ཁོང་གིས་རང་གི་མ་འོངས་སྐོར་གྱི་ཐུགས་ཁྲལ་དང་དགག་བྱ་རིགས་ཚང་མ་ཐོ་བཀོད་པའི་ཡི་གེ་ཞིག་བྲིས་ཏེ་པེ་ཅིན་དུ་བཏང་བ་རེད།",
    "འཇིགས་སུ་རུང་བའི་འཐབ་འཛིང་དེ་དག་ད་དུང་ཇེ་རྩུབ་ཏུ་སོང་།",
    "ད་ནི་ཉེས་པ་བཀལ་བའི་མི་ཚོའི་ཆུང་མ་དང་བུ་མོ་རྣམས་ཀྱང་མང་ཚོགས་ཁྲོད་དུ་ཉེས་འགལ་གྱི་ཆ་ཤས་ལེན་དགོས་པའི་བཙན་ཤེད་བྱས།",
    "མི་ཚང་མ་ཡོད་ས་དེར་བུད་མེད་རྣམས་ཀྱི་གྱོན་པ་ཡོངས་རྫོགས་ཕུད་དུ་བཅུག་ཅིང་།",
    "གལ་སྲིད་ཁྱོ་ག་དེས་ནག་ཉེས་རྣམས་ཁས་ལེནམ་བྱས་པ་ཡིན་ན་བུད་མེད་ཚོར་ཁྱོ་གའི་མདུན་དེར་བཙན་གཡེམ་བྱས།",
    "དེ་ཚོས་ཧ་ཅང་དགའ་མོས་དང་བཅས་བཀའ་བརྩི་དང་ལེན་ཞུ་རྒྱུ་དང་ཆ་ཤས་ལེན་རྒྱུའི་འདོད་པ་བྱེད་ཀྱི་ཡོད།",
    "ད་དུང་ཐ་ན་མི་གཞན་རྣམས་ཀྱི་མདུན་དེར་ཁྱོ་ག་ལ་བཙན་ཤེད་ཀྱིས་ཆུང་མར་འཁྲིག་སྤྱོད་བྱེད་བཅུག་ཅིང་དེའི་རྗེས་ལ་ཁོ་དམར་གསོད་བཏང་བ་དང་།",
    "དེ་ནས་ཁོའི་ཆུང་མ་དང་བུ་མོ་ཚོ་རྒྱ་མིའི་དམག་མི་ལ་སྤྲད་པའི་གནས་ཚུལ་བྱུང་ཡོད།",
    "ལན་མང་པོར་ཁོང་ཚོས་དམར་གསོད་མ་བཏང་གོང་དེ་ལ་བསྟུད་མར་བཙན་གཡེམ་བྱེད་པ་འདི་ལས་བུད་མེད་ཆེས་ཉུང་ཤས་ཤིག་ཐར་ཡོད་པ་རེད།",
    "ད་ནི་ཁོང་ཚོ་ལས་འཕྲོག་འཁྱེར་བྱས་པ་ཡོད་ཚད་ཀྱི་ཁར།",
    "གུང་ཁྲན་ཏང་གིས་ཁོང་ཚོའི་མཚོན་ཆ་རྩིས་ལེན་བྱེད་དགོས་བསམས་ཡོད།",
    "ཁོང་ཚོ་དམག་འཁྲུག་གི་སྐབས་སུ་ཤི་ན་ཁྱད་ག་རེ་ཡོད་རེད།",
    "ཁོང་ཚོའི་ཐབས་ལམ་གཞན་དག་དེ་ག་རེ་རེད།",
    "མགོན་པོ་བཀྲ་ཤིས་ཡོད་མེད་ལ་མ་ལྟོས་པར་འགོག་རྒོལ་དེ་ཚུགས་ཟིན་ཡོད་ལ་མུ་མཐུད་ནས་ཇེ་ཆེར་འགྲོ་གི་རེད།",
    "དོན་གཅིག་རང་གཅིག་ཆད་པ་ནི་བཀྲམས་ནས་ཡོད་པའི་འགོག་རྒོལ་བ་རྣམས་ཆིག་སྒྲིལ་གྱི་དམག་དཔུང་ཞིག་ཏུ་གོ་སྒྲིག་བྱེད་མཁན་ཞིག་དགོས་པ་དེ་རེད།",
    "བོད་གཞུང་གིས་རྒྱ་མི་ལ་དོ་ཕོག་འགྲོ་བའི་ཞེད་སྣང་བྱེད་པ་དེ་རེད་ལ།",
    "དཀའ་རྙོག་དེ་ནམ་ཡང་གཏན་མེད་དུ་མི་འགྲོ་བ་ཞིག་རེད།",
    "ཁོང་མགྲོན་གཉེར་ཆེན་མོ་ཕ་ལྷ་ལ་ཐུག་ཐེངས་རེ་རེ་བཞིན་ནས་ལན་ནི་དུས་རྒྱུན་ནས་གཅིག་རང་རེད།",
    "འདི་ནི་དུས་ཚོད་མ་རེད།",
    "འདི་ནི་ང་ཚོས་བྱེད་རྒྱུའི་ལས་ཀའི་ཁ་ཕྱོགས་དེ་མ་རེད།",
    "ང་ཚོས་བཟོད་བསྲན་བྱེད་དགོས།",
    "༡༩༥༧ ལོའི་ལོ་སྟོད་ལ་བསྐྱར་དུ་བསམ་བློ་བཏང་སྐབས་མགོན་པོ་བཀྲ་ཤིས་ཀྱིས་རང་གི་སྒེར་ངོས་ཀྱི་ལས་ཀ་དག་དང་ལྷག་པར་དུ་བོད་གཞུང་གི་མི་སྣ་སྣ་ཚོགས་ཤིག་ལ་གྲུབ་འབྲས་མེད་པའི་ཐུག་འཕྲད་བྱས་པ་དེ་ཚོ་ནི་དུས་ཚོད་འཕྲོ་བརླག་ཏུ་བཏང་བ་ཞིག་རེད་མི་ཚང་མས་དེ་མོས་མཐུན་མི་བྱེད།",
    "འདི་ནི་ཁོས་ཐོག་མར་འཆར་གཞི་བཀོད་པ་དེ་ལ་འབད་མེད་དུ་བྱུང་བའི་སྣོན་མ་ཞིག་ཡིན་སྲིད་མོད།",
    "གནས་སྐོར་ལ་མིང་གཡར་བའི་འོག་ནས་ཁོང་གིས་རིན་ཐང་ཆེ་བའི་གནས་ཚུལ་མང་པོ་རྒྱུས་ལོན་བྱས་ཡོད་པ་རེད།",
    "ཁོ་ཐ་ན་མར་རྒྱ་གར་ལ་ཡང་ཕྱིན་པ་རེད་ལ།",
    "ཞོར་དེར་ཁོས་མདེའུ་དང་མཚོན་ཆའི་གོ་མཛོད་སུ་ལ་ཡོད་མེད་དེ་ཤེས་རྟོགས་བྱུང་བ་རེད་ལ།",
    "དེ་དག་ཚང་མ་ནག་ཚོང་རྐྱང་རེད།",
    "དམིགས་བསལ་རྒྱལ་ལོ་ཡིས་༡༩༥༡དང་ཡང་ན་༡༩༥༢ལོ་སྟོད་ཙམ་ཞིག་ལ་ཀ་ལི་ཀ་ཏར་ཐོག་མའི་འབྲེལ་བ་དེ་བཙུགས་ཡོད་པ་རེད།",
    "༡༩༥༢༥༣ བར་དེར་ཕོན་ཆེར་རྒྱ་གར་དུ་ཡོང་བའི་སྐྱབས་བཅོལ་བ་ཚོ་ལ་ཡང་འབྲེལ་བ་བཟུང་ཡོད་པ་རེད།",
    "འགོག་རྒོལ་བྱེད་རྒྱུ་ནི་ཡ་ལན་བྱེད་ཕྱོགས་ཁོ་ན་དེ་ཡིན་པ་ལ་ཁོང་བློ་འགུག་ཡོང་ཐབས་ཀྱི་འབད་བརྩོན་མུ་མཐུད་ནས་བྱས་པ་རེད།",
    "ཕ་ལྷ་སུ་རེད།",
    "རིན་ཐང་ཆེ་བའི་དགོངས་བཞེས་གནང་ཕྱོགས་བཅས་ཀྱི་ཐད་རྒྱབ་རྟེན་གནང་སའི་མི་དེ་རེད།",
    "ཕ་ལྷ་ནི་འགོག་རྒོལ་ཚོ་ལ་ཤ་ཞེན་ཡོད་པ་ནི་ཏན་ཏན་རེད།",
    "ཕ་ལྷའི་སྒེར་གྱི་ཚོར་བ་རྣམས་ཇི་འདྲ་ཞིག་ཏུ་སོང་ཡོད་ནའང་།",
    "དེ་ནས་སྟབས་ལེགས་པ་ཞིག་ལ་སྲིད་འཛིན་ཨེ་སེན་ཧོ་ཝར་གྱིས་བོད་མི་ཚོས་ཨ་རིའི་རོགས་པ་ཡོད་མེད་ལ་མ་ལྟོས་པར་འགོག་རྒོལ་བྱེད་རྒྱུ་ཡིན་པའི་སྐོར་གྱི་གནས་ཚུལ་འབྱོར་བ་རྣམས་ཀློག་གིན་ཡོད་ཅིང་ཧ་གོ་གི་ཡོད་ལ།",
    "མ་མཐའ་ལ་ཨ་མི་རི་ཀས་བྱེད་ཐུབ་པ་ནི་འགོག་རྒོལ་སྐོར་ཁག་གིས་ཇི་ཙམ་གྱིས་རང་ངོས་ནས་བྱེད་ཐུབ་པ་དེ་ཙམ་གྱི་རོགས་རམ་དང་སྒོར་མོ་སྤྱོད་ཐུབ་པ་དེ་རེད་ཅེས་ཐག་གཅོད་བྱས་པ་རེད།",
    "ཨེ་སེན་ཧོ་ཝར་ཚོད་རྩིས་ནང་མཚམས་འདི་ལ་ཁོང་ཚོ་ལས་སླ་བོར་གཡུགས་ནས་འཇོག་རྒྱུ་ནི་ཧ་ཅང་མི་རུང་བ་ཞིག་ཡིན་པ་རེད།",
    "ཨ་རིའི་དམིགས་ཡུལ་ནི་རྒྱ་ནག་བརྟན་ལྷིང་མེད་པ་བཟོ་རྒྱུ་དེ་རེད་ལ།",
    "རྒྱལ་ལོ་དོན་གྲུབ་དང་མཉམ་དུ་ལས་དོན་འདི་ལྟ་རྟོག་བྱེད་ཆེད་ཁོ་རྒྱ་གར་ལ་འཕུར་བ་རེད།",
    "ཁོང་གི་ཤུགས་བསྟན་གྱི་བཀའ་འཁྲོལ་མེད་པར་འདི་ལྟར་བྱས་པ་རེད་ཅེས་ཡིད་ཆེས་བྱེད་དཀའ་བ་ཞིག་རེད།",
    "ཁོང་གིས་ཅི་ཞིག་ལ་བཀའ་འཁྲོལ་གནང་གི་ཡོད་པ་མ་ཤེས་བཞིན་དུ་བཀའ་འཁྲོལ་གནང་ཡོད་སྲིད་པ་ཞིག་རེད།",
    "བཀའ་ཤག་གི་པར་རིས་ཚད་ལྡན་ཞིག་འབྲི་ན་ཁོང་ཚོས་གྲིབ་ནག་ཅན་གྱི་པོ་ཏ་ལའི་ཁང་མིག་ཅིག་ཏུ་པུས་མོ་ས་ལ་བཙུགས་ནས་ཁ་བཙུམས་ཤིང་།",
    "མཛུབ་མོ་རྣམས་ཀྱིས་ཁ་བཀབ་པ་ཞིག་འབྲི་དགོས་རྒྱུ་རེད།",
    "ཤུཧཧཧཟེར་བ་ནི་ལྷ་སའི་ཆབ་སྲིད་པ་ཚོའི་ཁ་ནས་འདོན་པའི་མ་ཎི་རེད།",
    "ཧ་ཅང་གསལ་བའི་དོན་དག་ཅིག་ནི་གང་རེད་ཟེར་ན།",
    "ཨ་ཐར་དང་ཁོའི་ཁམས་པའི་གྲོགས་པོ་ལྔ་ལ་མཚོན་ན་རྫོགས་མཐའ་མེད་པའི་བཀའ་བློན་སྦུག་གི་སྒུག་ཡུན་དེ་ཧ་ལམ་ཚར་སོང་བར་རོལ་འདིར་ཕར་ལྷ་ས་ན།",
    "སྐབས་ཐོག་གཅིག་གི་རིང་མགོན་པོ་བཀྲ་ཤིས་ཀྱིས་ཤ་ཞེན་གྱི་སྟོབས་ཀྱིས་དེ་འདྲའི་ཞབས་འདེགས་ཤིག་ཞུ་རྒྱུའི་ཆེད་དུ་བསམ་བློ་གཏོང་བཞིན་ཡོད་ལ།",
    "གཡུ་བཅས་ཕོན་ཆེ་བྱུང་བ་རེད།",
    "བུད་མེད་ཚོས་སྒེར་གྱི་རྒྱན་ཆ་རྣམས་ཕུལ་ཞིང་ཐ་ན་སྤྲང་པོ་ཚོས་ཀྱང་གང་ཐུབ་རེ་ཕུལ།",
    "རྐོས་མཁན་བཅུ་དྲུག་རི་མོ་བ་དྲུག་བཟོ་པ་བརྒྱད།",
    "དེའི་སྟེང་དུ་ལས་རོགས་སུམ་ཅུ་སོ་དྲུག་གླས་ཏེ་རང་རང་གི་ལག་རྩལ་རྣམས་དཀྱུས་གཅིག་ཏུ་སྤུངས་ནས་ཁྱད་ནོར་འདི་བསྐྲུན་རྒྱུ་བྱས་པ་རེད།",
    "སྒྱུ་རྩལ་པ་དག་གིས་རང་གི་ལག་རྩལ་རྣམས་དཀྱུས་གཅིག་ཏུ་སྤུངས་པའི་ཤུལ་དེར་མགོན་པོ་བཀྲ་ཤིས་ལྷོ་ཁ་དང་ཀོང་པོ།",
    "ཁམས་བཅས་སུ་ཕྱི་ཚུལ་གྱིས་ཞལ་འདེབས་བསྡུ་བའི་ཟོལ་གྱིས་སོང་ཞིང་།",
    "ཀོང་པོ་ནས་ཡིན་པ་ལོ་ན་ཉི་ཤུ་ཅན་གྱི་ཐུབ་བསྟན་དར་རྒྱལ་ཡང་རང་གི་ཕ་ཚོང་པ་ཕྱུག་པོ་དང་ལྷན་དུ་དགོང་མོ་དེར་དེ་ན་ཡོད།",
    "མི་ཚང་མས་གསེར་ཁྲི་བཞེངས་ཕྱོགས་ཀྱི་སྐོར་ལ་གྲོས་བསྡུར་བྱེད་ཀྱིན་འདུག་དེ་ནས་མགོན་པོ་བཀྲ་ཤིས་གཟབ་ནན་ཆེ་རུ་སོང་ཞིང་མི་ཚང་མ་ཁུ་སིམ་མེར་བཏང་།",
    "ང་ཚོའི་མི་ཚེའི་འགྲོ་ལུགས་དེ་ལ་དམའ་འབེབས་བྱས་སོང་།",
    "ང་ཚོའི་ལུང་པའི་མི་བསད་སོང་།",
    "ང་ཚོ་ངེས་པར་དུ་མཉམ་འབྲེལ་བྱེད་དགོས་ལ་ང་ཚོས་ངེས་པར་དུ་སྒེར་གྱི་ཁེ་ཕན་ཆུང་ཚགས་རིགས་བརྗེད་པར་བྱེད་དགོས།",
    "ཁོས་མི་རྣམས་ལ་མནའ་བསྐྱལ་བཅུག་པ་རེད།",
    "མི་དེ་ཚོས་ད་ནས་བཟུང་གུང་ཁྲན་ཏང་གི་བཙན་འཛུལ་མཇུག་མ་རྫོགས་བར་དུ་རང་སྲོག་བློས་བཏང་གིས་རྒྱ་མི་ལ་འཛིང་གི་ཡིན་ཞེས་མནའ་ཚིག་བོར་བ་རེད།",
    "ཁོང་ཚོའི་གསང་བའི་ཚོགས་པ་དེ་ལ་ནི་ཆུ་བཞི་སྒང་དྲུག་ཟེར་ཞིང་།",
    "དེ་ནི་ཁམས་ཀྱི་གནའ་བོའི་མིང་ཞིག་ཡིན་པ་རེད།",
    "ཁམས་ཡོངས་རྫོགས་སམ་ཆིག་སྒྲིལ་ཟེར་བ་རེད།",
    "ཁོའི་ལོ་ཟླ་དག་གི་ནང་སྡུག་བསྔལ་ཆེས་མང་བ་མཐོང་མཁན་ཞིག་གི་མྱ་ངན་གྱི་མིག་ཅིག་བགྲད་ཡོད།",
    "དེ་མིན་གྱི་འཇིགས་སུ་རུང་བ་དག་གིས་གྲའུ་དཔོན་རང་གི་དམག་མི་ངོ་ལོག་པ་སྐོར་ཁག་ཆུང་བ་ཞིག་དང་བཅས་ནུབ་ཕྱོགས་སུ་བྲོས་འགྲོ་དགོས་པ་བཟོས།",
    "དགོང་མོ་དེར་མགོན་པོ་བཀྲ་ཤིས་ཀྱི་ཁྱིམ་དུ་གྲའུ་དཔོན་ནི་དགའ་སྤོབས་ཀྱིས་ཁེངས་པར་གྱུར།",
    "མགོན་པོ་བཀྲ་ཤིས་ཀྱི་ལྟ་ཚུལ་ནི་ངའི་མི་མང་གི་ལྟ་ཚུལ་རེད་འདུག་རྒྱ་མིའི་མཉམ་དུ་ཞི་མོལ་བྱེད་ཐབས་བྱེད་པ་ལ་ནང་དོན་ག་རེ་ཡོད་རེད།",
    "དེས་ང་ཚོ་ཅི་གང་ལའང་སླེབས་པ་བཟོ་གི་མ་རེད།",
    "དེ་ནས་ཨ་མི་རི་ཀ་བ་རྣམས་ང་ཚོའི་རྒྱབ་ཏུ་ཡོད་ཅེས་ང་ཚོ་ལ་ཡིད་ཆེས་སྐྱེས་སོང་ལ།",
    "གང་ལྟར་ཡང་དུས་ཚོད་གང་འཚམས་ཤིག་གི་སྐབས།",
    "ང་ཚོས་བཅིངས་འགྲོལ་དམག་མཐར་སྐྲོད་བྱེད་པ་ལ་ལམ་ལྷོང་ཡོང་གི་རེད།",
    "ང་ཚོ་ཕུགས་རེ་དེའི་ནང་ཆིག་སྒྲིལ་བྱས་ཡོད།",
    "དེ་ནས་བཟུང་ང་ཚོ་ནམ་ཡང་རྒྱབ་བཤིག་མ་བརྒྱབ།",
    "མགོན་པོ་བཀྲ་ཤིས་ཀྱིས་ང་ཚོ་ལ་ཕྱོགས་ཤིག་དང་ལམ་ཁ་ཞིག་སྤྲད་པ་རེད།",
    "ང་ཚོས་ཁོང་ལ་ཡིད་ཆེས་གཙང་མ་བྱས་པ་རེད།",
    "མཐའ་མ་དེར་ང་ཚོས་རང་གི་མགོ་བཀྱགས་ནས་འགྲོ་ཐུབ་པ་ཡོད།",
    "ཆུ་བཞི་སྒང་དྲུག་གིས་རང་གི་དར་ཆ་ཞིག་བཟོས།",
    "མ་རིག་པ་ནི་དམར་པོའི་རིང་ལུགས་ཀྱི་རྒྱུ་རྐྱེན་དེ་རེད།",
