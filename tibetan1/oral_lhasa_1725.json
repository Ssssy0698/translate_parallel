    "རྣམ་པར་འགྱུར་བ་བསྟེན་པའི་དུས་ན་ནི་དེ་ཡང་ཐ་སྙད་དུ་བྱར་མི་རུང་བ་ཉིད་ཡིན་ནོ།",
    "དེའི་ཕྱིར་དེའི་སྐབས་ཀྱི་དཔེ་བརྗོད་པར་བྱ་སྟེ་ཁྱིམ་པ་དག་དང་ཆུང་མ་མ་ནིང་དང་།",
    "སྟོད་གཡོགས་བཅས་པ་ལས་ལྷག་པར་ལེན་པ་དང་སྦྱིན་བདག་དེ་གཉིས་སམ་ཐག་པ་དེ་གཉིས་ལས་རིན་དང་སོ་སོ་བ་དང་འཐག་ཏུ་འཇུག་པ་དང་།",
    "མཚན་གཉིས་པ་དང་ལྷན་ཅིག་ཉལ་བ་དང་དེ་དག་དང་ནུབ་གསུམ་ལས་ལྷག་པར་ཉལ་བ་དང་མ་ནིང་ཕོ་དང་མཚན་གཉིས་པ་དང་ལྷན་ཅིག་སྐྱེས་པ་མེད་པར་ལམ་དུ་འགྲོ་བ་ལ་ནི་ཉེས་བྱས་སོ།",
    "ཉོ་ཚོང་བྱས་ཏེ་ཐོབ་པ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "ཕྱི་རོལ་པའི་རབ་ཏུ་བྱུང་བ་ལས་ལྷུང་བཟེད་དོ་གསུམ་ལས་ལྷག་པར་བླངས་ཏེ་ཟོས་པ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "དགེ་སློང་དང་དགེ་སློང་མ་བསྙེན་པར་རྫོགས་པ་ཅན་མ་ཉམས་པ་ཉིད་ནི་བསླབ་པ་དག་ལ་ཡན་ལག་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་དང་དགེ་སློང་མ་བསྙེན་པར་རྫོགས་པ་ཅན་མ་ཉམས་པ་ཉིད་ནི་དགེ་སློང་དང་དགེ་སློང་མའི་བསླབ་པ་དག་ལ་ཡན་ལག་ཡིན་ཏེ།",
    "ཉམས་པ་བསྙེན་པར་རྫོགས་པའི་རྟགས་ཅན་ཉིད་ཀྱང་མ་ཡིན།",
    "དགེ་སློང་མ་སུན་ཕྱུང་བ་དང་དགེ་སློང་སུན་ཕྱུང་བ་བསྙེན་པར་རྫོགས་པའི་རྟགས་ཅན་ཉིད་ཀྱང་མ་ཡིན་སྔོན་བསྙེན་པར་རྫོགས་ནས་ཕམ་པར་འགྱུར་བ་བྱུང་བ་ཉིད་ཀྱང་བསླབ་པ་དག་ལ་ཡན་ལག་མ་ཡིན་ནོ།",
    "ཡི་དགས་ལ་སོགས་པ་རབ་ཏུ་བྱུང་ཞིང་བསྙེན་པར་རྫོགས་པ་རྣམས་དང་།",
    "མི་མ་ཡིན་པ་མ་རབ་ཏུ་བྱུང་ཞིང་བསྙེན་པར་རྫོགས་པ་དང་།",
    "འཚེད་པ་དང་རྨེལ་དུ་བཅུག་ན་ཉེས་བྱས་སོ།",
    "རིན་ཐང་སོ་སོ་བ་དང་སྐུར་བ་ཐོབ་ན་ཡང་ཉེས་བྱས་སོ།",
    "འགྲོ་བ་གཞན་དུ་གཏོགས་པའི་དགེ་སློང་མ་ལམ་བསྐོས་པར་སྟོན་པ་དང་།",
    "སྔངས་པར་བྱེད་པ་ཡང་ཉེས་བྱས་སོ།",
    "གཞི་མེད་པར་སྐུར་བ་འདེབས་པ་པ་དང་།",
    "བསླབ་པ་ལ་ཉེ་བར་འཇོག་པ་སྤོང་བ་ཡང་ཉེས་བྱས་སོ།",
    "དེ་དག་དགེ་སློང་དག་རྩོད་པ་ལ་ཉན་རྣ་བྱེད་པ་ཡང་ཉེས་བྱས་སོ།",
    "མི་མ་ཡིན་པ་རབ་ཏུ་བྱུང་ཞིང་བསྙེན་པར་རྫོགས་པ་དག་རྩོད་པ་ལ་ཉན་རྣ་བྱེད་པ་ཡང་ཉེས་བྱས་སོ།",
    "དེ་དག་གྲལ་རིམས་སུ་མ་ཕེབས་པར་འབྲིམ་དུ་འཇུག་པ་མ་བཟློག་པར་ཟ་བ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "དགེ་སློང་མ་རྣམས་ལ་ཡང་ཐམས་ཅད་དུ་རྣམ་པ་འདི་བཞིན་དུ་རིག་པར་བྱའོ།",
    "འདིར་དཔེ་དག་བརྗོད་པར་བྱ་སྟེ་ཁས་བླངས་པས་ཁས་མ་བླངས་པ་ལ་གོས་བྱིན་ནས་ཕྲོགས་པ་དང་།",
    "སྐྱོ་སྡོགས་བྱས་པ་དང་།",
    "ཁས་བླངས་པས་ཁས་མ་བླངས་པའི་དགེ་སློང་མ་རྣམས་ལ་མ་བསྐོས་པར་སྟོན་པ་དང་།",
    "ཁས་མ་བླངས་པས་ཁས་བླངས་པའི་དགེ་སློང་མ་རྣམས་ལ་མ་བསྐོས་པར་སྟོན་པ་དང་།",
    "ཁས་མ་བླངས་པས་ཁས་བླངས་པའི་ཁྱིམ་ནས་ལྷུང་བཟེད་དོ་གསུམ་ཙམ་ལས་ལྷག་པར་ལེན་པ་དང་།",
    "ཁས་བླངས་པས་ཁས་མ་བླངས་པའི་ཁྱིམ་ནས་ལྷུང་བཟེད་དོ་གསུམ་ཙམ་ལས་ལྷག་པར་ལེན་པ་དག་ནི་ཉེས་བྱས་སོ།",
    "སྔངས་པར་བྱེད་པ་དང་།",
    "ཅན་ཉིད་ནི་ན་སྨད་པར་བྱ་བ་སྟེ།",
    "འདིར་མི་མ་ཡིན་པ་དང་ལྡན་པའི་དཔེ་དག་ལ་ནི་རྒྱུ་གཉིས་ཀྱིས་ན་སྨད་པར་ཤེས་པར་བྱ་སྟེ།",
    "བསྙེན་པར་རྫོགས་པའི་ཞེས་མ་སྨོས་སོ།",
    "འཐག་ཏུ་བཅུག་པ་དང་འཐག་པ་བསྐྱེད་པ་དང་བྱིན་ཕྲོགས་བྱས་པ་དང་བརྟད་པ་ལས་བྱུང་བ་ཞག་བཅུ་ལས་ལྷག་པར་འཇོག་པ་དང་།",
    "གནས་མལ་མ་བསྡུས་པར་འགྲོ་བ་དང་།",
    "ཁྲི་དང་ཁྲིའུ་རུང་བ་མ་ཡིན་པའི་ཁྲི་རྐང་ཁྲུ་གང་ལས་ལྷག་པར་བྱེད་པ་དང་།",
    "ཟས་རུང་བ་མ་ཡིན་པ་གསོག་འཇོག་བྱས་པ་དང་།",
    "བཟའ་བ་དང་བཅའ་བ་རུང་བ་མ་ཡིན་པ་གཅེར་བུ་པ་དང་གཅེར་བུ་མ་ལ་སྦྱིན་པ་ཡང་ཉེས་བྱས་ཏེ།",
    "དེ་ནི་སྦྱིན་པ་པོ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་སྦྱིན་པར་བྱེད་པ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "ཆུང་བ་ཁ་མ་བསྒྱུར་བར་གྱོན་པ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "དེ་བཞིན་དུ་ལྷུང་བཟེད་རུང་བ་མ་ཡིན་པ་དང་ཆུང་བ་ཞག་བཅུ་འམ་ཞག་གཅིག་ལས་ལྷག་པར་འཆང་བ་དང་།",
    "ལྷག་པ་བཙལ་བ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "རྔ་བལ་ལ་སོགས་པ་རུང་བ་མ་ཡིན་པས་སྟན་ལ་སོགས་པ་བྱེད་པ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "ལྷུང་བཟེད་གཅིག་སློང་བ་དང་གོས་གཅིག་འཁྲུར་འཇུག་པ་ཡང་ཉེས་བྱས་སོ།",
    "བརྟད་པ་ལས་བྱུང་བ་ཞག་བཅུ་ལས་ལྷག་པར་འཇོག་པ་དང་།",
    "འདིར་དཔེ་བརྗོད་པར་བྱ་སྟེ་གཞན་གྱི་དོན་དུ་འཁྲིག་པ་དང་ལྡན་པ་སྨྲ་བ་དང་།",
    "གཞན་གྱི་དོན་དུ་དགེ་སློང་མ་ཉེ་དུ་མ་ཡིན་པ་ལ་གོས་འཁྲུར་འཇུག་པ་ལ་སོགས་པ་ནི་ཉེས་བྱས་སོ།",
    "དེ་ལ་བདག་ཉིད་མ་གཏོགས་པར་དོན་དུ་གཉེར་བ་གཞན་ཡོད་པའི་ཕྱིར་རོ།",
    "བསྙེན་བཀུར་བསྔགས་པ་དག་ཀྱང་སྦོམ་པོར་རིག་པར་བྱ་སྟེ།",
    "དགེ་སློང་གཞན་གཅིག་གམ་དུ་མའི་དོན་དུ་སྲིན་བལ་དང་བལ་ནག་པོ་འབའ་ཞིག་དང་ཆ་གཉིས་ལས་ལྷག་པའི་སྟན་བྱེད་དུ་འཇུག་པ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "ཤིང་བལ་གྱིས་གོས་པར་བྱེད་པ་ལ་སོགས་པ་ཡང་ཉེས་བྱས་སོ།",
    "གྲལ་རིམས་སུམ་ཕེབས་པ་འབྲིམ་དུ་འཇུག་པ་མ་བཟློག་པ་ཡང་ཉེས་བྱས་སོ།",
    "རྣམ་པར་རིག་བྱེད་ལ་ནི་དོན་གོ་བའོ་ཞེས་བྱ་བ་ནི།",
