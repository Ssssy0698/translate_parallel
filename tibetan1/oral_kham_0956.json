    "མདའ་ཤ་གྲོ་བ་འི་སྙན་དུ་གདའས་ནས།",
    "རྟ་མགོ་ག་ལ་འདུག་པར་མདའ་གཆིག་འཕངས་པ་ལས།",
    "རྒྱལ་པོ་ར་མ་ན་བཟང་ཞིང་འོད་ཆགས་པར་འདུག་པས།",
    "བུ་ཁྱེད་སྤུན་གཉིས་ཀྱི་རྟེན་བྱེད་ཆིང་འདུག་གོ་ཞེས་གསུངས་ནས།",
    "སྲིན་པོ་མདའ་ཤ་གྲོ་བ་དང་ལོ་དུ་མར་འདུག་པ་ལས།",
    "རང་རང་སོ་སོའི་རྩོམ་རིག་སྒྱུ་རྩལ་ཕུན་སུམ་ཚོགས་པ་རུ་རྟོགས་བརྗོད་དེ་ལས་ཕན་པའི་ས་བོན་ཡང་ལེགས་པར་བླངས་པས།",
    "དེའི་ཟུར་ལོགས་སུ་སྤྱང་གྲུང་འཛོམས་པའི་དགོ་བ་དག་ཀྱང་བག་ཡངས་པོར་རྒྱུ་བཞིན་གདའོ།",
    "དགེ་སློན་སློང་བེ་རོ་ཙ་ནའི་ལུས་སུ་སྤྲུལ་ཏེ།",
    "དགེ་སློང་བེ་རོ་ཙ་ནའི་སླད་དུ།",
    "བོད་སྐད་དུ་སྐུ་དང་གདུང་དང་རང་བསྲིལ་བཅས་ཀྱི་དོན།",
    "འཇུག་དུས་ཡབ་ཡུམ་ཁྲིལ་གྱིས་འཁྲིལ་བར་བསམ།",
    "འགྲོ་འདུག་ལས་ཁུར།",
    "བདེ་བས་ཡིད་ཚིམ་ཞིང་རངས་པས་རངས་མ།",
    "དེར་ཡང་རང་བཞིན་ལས་གཡོ་བ་མེད་པ་ནི་འཁོར་ལོའི་དབུས་སུ་ལྟ་བའི་དོན་ཏེ།",
    "འདི་ལ་ཉི་ཟླའི་ཟེར་གྱིས་ཡེ་ཤེས་ངོ་སྤྱོད་པ་ཞེས་གསུངས་པའི་ཉི་ཟླའི་ཟེར་དེ་གསལ་ཡང་རང་བཞིན་མེད་པས་མཚོན་ནས་སྣང་ལ་རང་བཞིན་མེད་པ་བསྐྱེད་རིམ་སྒྱུ་མའི་སྒོམ་རིམ་བསྟན་པ་ཡིན་ལ།",
    "སྒྱུ་མར་སྣང་ཙམ་དེ་ཡང་རང་། བཞིན་མ་གྲུབ་པར་རྟོགས་པས་དང་།",
    "བསྲུང་བྱ་སྲུང་བྱེད་ཀྱི་འཁོར་གསུམ་ཡང་རང་བཞིན་མེད་པའི་སྒྱུ་མར་རྟོགས་པས་བསྲུང་འཁོར་སོགས་མི་དགོས་པའོ།",
    "བཟང་ངན་སྒྱུ་མ་ཅིར་སྣང་རང་གྲོལ་འགྱུར།",
    "ཅིར་སྣང་རང་གྲོལ་འགྱུར་གྱིས་བསྟན་པའང་ཡིན་ནོ།",
    "རིག་དུས་ན་རིག་བྱ་རིག་བྱེད་ལས་གྲོལ་བས་གཟུང་འཛིན་སྤྲོས་བྲལ་གྱི་གནས་ལུགས་ལེགས་པར་མཐོང་བས་ཡིན་ལ།",
    "ཨཱ་རིང་པོ་བཞག་དུས་ཀྱི་འཁོར་ལོར།",
    "འཆར་དུས་སུ་ཡང་རང་ཚུལ་ལས་གཡོས་པ་མེད་པའོ།",
    "རྣལ་འབྱོར་པས་གྲོང་འཇུག་བྱེད་པའང་རང་དོན་ལ་ལམ་སྦྱོར་བ་ཉིད་དམིགས་གཏད་ཀྱི་གཙོ་བོར་བྱས་པས་སོ།",
    "ཐབས་ཀྱི་རྐང་པ་རྒྱབ་ཏུ་བཅིངས་ནས་བསྐྱོད་པ་སྟེ་ནཱ་རིའི་འདུག་སྟངས་ཞེས་ཀྱང་བྱ་ལ།",
    "ཅིར་ཡང་གཞི་མེད་རང་བྱུང་རང་ལ་ལྟོས།",
    "སེམས་ཉིད་འཚོ་མ་ཐུབ་པར་འཁྲུལ་པའི་རྣམ་པར་རྟོག་པ་གཟུང་འཛིན་གཉིས་སུ་སྣང་བའི་བདག་ཉིད་ཀྱི་རྣམ་པ་ལས་གྱུར་པ་སྟེ་དེ་ལྟ་བུའི་རྣམ་པ་ཅིར་སྣང་རང་བཞིན་མེད་པའམ་རང་ཚུགས་ཐུབ་པ་མེད་པའི་ཕྱིར་གཞི་རྩ་བྲལ་བ་དང་།",
    "དང་རང་ལས་འཕྲོས་པའི་སྣང་རྟོག་ཇི་སྙེད་པ་ནི་འཇིག་རྟེན་པ་སྟེ།",
    "དེ་བས་སྒྲུབ་པ་པོས་སྣང་རྟོག་ཐམས་ཅད་ཀྱང་རང་བཞིན་ཤེས་པར་སྤྱོད་པས་དེ་བཞིན་ཉིད་ཀྱི་བདག་ཉིད་ཀྱི་རྗེས་སུ་འགྲོ་བ་སྟེ།",
    "ཅིའི་ཕྱིར་གཤིས་གདངས་ཟུང་འཇུག་བདེ་ཆེན་དང་ལོངས་སྐུར་བཞག་ཙ་ན།",
    "གདངས་སྟོང་གཟུགས་ཀྱང་དེ་ལས་སྤྲོས་པ་དང་རང་བཞིན་བདེ་བར་ཡོད་པས།",
    "སྒྲིབ་པ་ཆེད་དུ་མ་སྤངས་ཀྱང་རང་ལུགས་མཐོང་བས་དེ་དག་པ་རང་དག་གོ།",
    "དེ་ལ་དོན་གྱི་འོད་གསལ་ནི་སྣང་གསུམ་དང་རང་བཞིན་བརྒྱད་ཅུ་དངོས་ཀྱི་གཉེན་པོར་གྱུར་པ་ཡིན་ཀྱང་།",
    "གཉིད་བསམ་གཏན་དུ་བསྲེ་ཞིང་རང་བཞིན་འོད་གསལ་དུ་བསྲེ་བ།",
    "རྟོག་པ་དང་ཉམས་སྣང་རང་གྲོལ་དུ་གཏོང་བའོ།",
    "འོན་ཀྱང་རང་ཉིད་མྱོས་པར་མི་འགྱུར་ཞིང་།",
    "སྣང་བ་དེ་ཐམས་ཅད་ཀྱང་རང་བཞིན་བདེ་ཆེན་ལས་མི་འདའ་བས་དེ་དག་ལ་དམ་ཚིག་ཅན་དུ་བརྗོད་དོ།",
    "བདེ་ཆེན་རང་ངོས་ནས་སྨོས་པ་། དང་རང་བཞིན་སྟོང་པ་དང་དབྱེར་མེད་ཀྱི་ངོས་ནས་སྨོས་པའི་ཁྱད་ཙམ་དུ་ངེས་པ་ལས།",
    "གང་ཟག་རྒྱུན་ཆད་དོགས་པ་དེ་འཇིག་ལྟ་ལ་སླར་མཐར་ལྟ་བ་ཉིད་དུ་བྱས་པ་ལ་ངོས་བཟུང་འདུག་པའི་ཕྱིར།",
    "བྱས་མ་ཐག་ཏུ་ཡིན་གྱི་དུས་གཞན་གྱི་བར་དུ་གསོན་པོར་འདུག་ཀྱང་མ་ཡིན་པར་འགྱུར་རོ།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་བྱུང་རང་རྒྱལ་དང་དེ་བཞིན་གཤེགས་པ་དང་གཉིས་ནི་རིམ་པ་བཞིན་དུའོ།",
    "ཡང་རང་རྒྱལ་འཇུག་གནས་གཉིས་ཀ་ཤེས་པ་དང་རྟག་ཏུ་རྨོངས་པ་གཉིས་འགལ་བའི་ཕྱིར།",
    "རྒ་ཤི་ལ་འབྲས་བུ་མེད་ན་གཉེན་པོ་མ་བསྟེན་ཀྱང་རང་འགགས་སུ་འགྱུར་རམ་སྙམ་ན།",
    "ལྷན་ཅིག་དུས་མཉམ་པའི་ཁུངས་སུ་མི་རུང་སྟེ།",
    "འཛམ་བུའི་ཚལ་ན་འདུག་པའི་སོ་སྐྱེ་གཅིག་ལ་བྱིན་ན།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཁ་ཅིག་ཟླ་བ་བཀས་པ་ལྟ་བུར་འདུག་གོ།",
    "ཁ་ཅིག་ནི་པདྨ་སྣ་ཚོགས་ཀྱི་དབྱིབས་སུ་འདུག་གོ།",
    "ཁ་ཅིག་ནི་ཤིང་རྟའི་དབྱིབས་སུ་འདུག་གོ།",
    "གཙོ་བོ་དང་རང་བཞིན་གཅིག་པ་མེད་དེ།",
    "བཀའ་བརྒྱུད་པ་ཏི་སེ་དང་མ་ཕམ་གངས་ཅན་དང་མ་དྲོས་པ་ཡིན་པར་འདོད་པ་ལ་རིགས་པ་དང་འགལ་བ་ཡིན་ཟེར་བ་ཞིག་བྲིས་འདུག་པའི་རིགས་པ་ནི་འདི་ཡིན་པར་སྣང་སྟེ།",
    "དབྱར་ཟླ་ཐ་ཆུང་དང་དགུན་ཟླ་ཐ་ཆུང་ནས་ཉི་མ་༢༨༥ན་ཟློག་ཟེར་བ་སོགས་སྣ་ཚོགས་ཤིག་བྱུང་འདུགམཆིམས་བློ་བཟང་བའི་ཊཱི་ཀར།",
    "འཇིག་རྟེན་པའི་ཐ་སྙད་ནི་ངེས་པ་མེད་དོ་ཞེས་བྲིས་གདའ་ལ།",
    "དེང་སང་དབྱར་དགུན་གྱི་ཉི་ཟློག་དབྱར་དགུན་གྱི་འབྲིང་པོ་ཧོར་ཟླ་ལྔ་པ་དང་བཅུ་གཅིག་པ་ལ་ཟློག་འདུག་པས་གནོད་དེ།",
