    "དེ་དག་གི་དོན་དེ་མཐོང་བ་སྟེ་སྒྲུབ་ནུས་པའི་རྟེན་བདེ་འགྲོ་ལ་བཀོད་པ་ལས་བདེ་བ་མྱོང་བ་དང་།",
    "ཇི་ལྟར་ཡིད་བཞིན་གྱི་ནོར་བུས་དོན་བྱའོ་སྙམ་པའི་རྟོག་པ་མེད་ཀྱང་དུས་ཅིག་ཅར་དུ་སྤྱོད་ཡུལ་ཏེ་ཉེ་འཁོར་ན་གནས་པ་རྣམས་ཀྱི་ཡིད་ལ་རེ་བའི་བསམ་པ་ཀུན་སོ་སོར་རྫོགས་པར་བྱེད་པ་ལྟར།",
    "དེ་བཞིན་དུ་འགྲོ་བ་ཤིན་ཏུ་སྐལ་བ་ངན་པ་རྣམས་ཀྱིས་རང་གི་ཡིད་འདིར་བདེ་བར་གཤེགས་པ་མཐོང་བ་རྙེད་པར་དཀའ་བར་ཤེས་པར་བྱ་སྟེ།",
    "ཉོན་མོངས་པས་ཟིན་ཏེ་བསྒྲིབས་པའི་ཕྱིར།",
    "ཇི་ལྟར་སྒྲ་བརྙན་གྱི་བྲག་ཆ་སྐྱེས་བུ་གཞན་གྱི་ངག་གི་རྣམ་པར་རིག་བྱེད་ཀྱི་རྐྱེན་ལས་བྱུང་ཞིང་སྣང་བ་ནི་ཀུན་སློང་གི་རྣམ་པར་རྟོག་པ་མེད་ལ།",
    "བྱེད་པ་ལྕེ་རྐན་སོགས་ཕྲད་ནས་བརྗོད་པར་བཟོ་བའི་འབད་རྩོལ་མེད་ཅིང་རང་གི་ངོ་བོ་ཕྱིའི་དོན་དང་ནང་གི་ཤེས་པ་གང་ནའང་མི་གནས་པ་ལྟར།",
    "དེ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པའི་གསུང་ཉན་པ་པོ་གཞན་གྱི་རྣམ་རིག་ལས་བྱུང་ཞིང་སྣང་བ་ཡང་ཀུན་སློང་གི་རྣམ་པར་རྟོག་པ་མེད་ལ།",
    "རང་གི་ངོ་བོ་ཕྱི་དོན་དང་ནང་ཤེས་པའི་བདག་ཉིད་གང་ནའང་གནས་པ་མ་ཡིན་ནོ།",
    "ཟབ་མོའི་སྤྱོད་ཡུལ་ལ་འཇུག་པའོ།",
    "ཇི་སྐད་བསྟན་པའི་དགོས་པ་དེ་དག་གི་དོན་དུ་བེ་ཌཱུརྻའི་ས་གཞི་ལ་བརྒྱ་བྱིན་གྱི་གཟུགས་བརྙན་ཤར་བ་ལ་སོགས་དཔེ་རྣམ་པ་དགུ་བརྗོད་པ་དེ་ལ་ནི་དཔེ་དགུ་པོ་དེའི་བསྡུས་དོན་ངེས་པར་བཟུང་ངོ།",
    "གསུང་གི་གསང་བ་དང་།",
    "ཕྲིན་ལས་ཀྱི་ཚུལ་གང་ཟག་གང་གིས་རྟོགས་པ་དང་།",
    "རྒྱལ་བ་རྣམས་ཀྱི་གསུང་གི་གསང་བ་དེ་ནི་ཡི་གེ་མེད་ཀྱང་སྣ་ཚོགས་སུ་སྣང་བ་ནི་བྲག་ཅ་བཞིན་ནོ།",
    "མོས་པའི་ཕན་ཡོན་ནོ།",
    "གང་ཟག་གང་ཞིག་འཇིག་རྟེན་འདི་ན་བྱེད་ལས་སྲིད་པ་གསུམ་གྱི་ཉོན་མོངས་པའི་མེ་འཇིལ་བར་བྱེད་པའི་ལྷའི་གནས་བསམ་གཏན་བཞི་དང་།",
    "གང་གི་ཕྱིར་ན།",
    "ཤེས་རབ་ཉོན་མོངས་ཤེས་བྱ་ཀུན་སྤོང་ཞེས་བརྗོད་ན་སྤང་བྱ་སྒྲིབ་གཉིས་གང་ཞེ་ན།",
    "འཆལ་ཚུལ་ལ་སོགས་པ་ལྔ་ཡི་རྣམ་པར་རྟོག་པ་གང་ཡིན་པ་དེ་ནི་ཉོན་མོངས་པའི་སྒྲིབ་པར་འདོད་དོ།",
    "དེ་དག་གི་བསྡུས་པའི་དོན་ནོ།",
    "ཟླ་བའི་འོད་ལ་བརྟེན་ནས་ནང་གི་རྐྱེན་མིག་དང་ལྡན་པའི་གང་ཟག་གཟུགས་ལ་ལྟ་བ་དེ་བཞིན་དུ།",
    "ནང་གི་རྐྱེན་ཤེས་རབ་ཀྱི་མིག་དང་།",
    "གང་གི་ཕྱིར་ན་རྒྱལ་བ་ལས་ཆེས་མཁས་པའི་གང་ཟག་འགའ་ཡང་འཇིག་རྟེན་འདི་ན་ཡོད་པ་མིན་པའི་ཕྱིར་ཏེ།",
    "ཉོན་མོངས་པ་རྨོངས་པ་མ་རིག་པའི་བདག་ཉིད་ཅན་རྣམས་ཀྱིས་འཕགས་པ་རྣམས་ལ་སྐུར་པ་འདེབས་པ་དང་།",
    "དཔེར་ན་གོས་གཙང་མ་ཚོན་གྱིས་རྣམ་པར་བསྒྱུར་དུ་རུང་གི་སྣུམ་གྱིས་གོས་པ་ནི་དེ་ལྟར་མིན་པ་བཞིན་ནོ།",
    "མོས་པ་དམན་པ་སྟེ་རང་བཞིན་གྱིས་དམན་པ་ལ་མོས་པའི་ཕྱིར་ཏེ།",
    "རྡོ་རྗེའི་མེ་སྟེ་ཐོག་གིས་ནི་ཚེ་འདིར་སྲོག་དང་བྲལ་བ་ཙམ་བྱེད་པ་སྲིད་ཀྱི།",
    "རང་གི་ཕ་དང་མ་དང་དགྲ་བཅོམ་པ་གསོད་པར་བྱེད་པས་བྱ་བ་མིན་པ་བྱེད་པ་དང་།",
    "གཉིས་པ་དེ་དག་གི་བསྡུས་པའི་དོན་ནི།",
    "གང་ཞིག་རྒྱལ་བའི་བསྟན་པ་འབའ་ཞིག་གི།",
    "བློ་དམན་ཞེས་སོགས་ཚིགས་བཅད་གཅིག་གིས་ཉམས་པའི་རྒྱུ་དང་།",
    "དེ་ནས་ཇི་ལྟར་ཟབ་མོ་ཞེས་སོགས་ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱིས་ཉམས་པའི་འབྲས་བུ་བསྟན་པ་ཡིན་ནོ།",
    "ཟབ་མོའི་དོན་གྱི་ནོར་བུ་འབར་བ་ཅན།",
    "ཚིག་དོན་ཕུན་ཚོགས་ངག་གི་ཆུ་འཛིན་ལྡན།",
    "སྒྲ་ཚད་ཟུང་གི་ངང་པའི་གཤོག་ཡངས་ཅན།",
    "ཉི་ཟླ་གླིང་བཞིའི་ཁྱོན་དུ་རྒྱུ་བ་དང་།",
    "ཕུན་ཚོགས་ངག་གི་སྤོབས་པ་སྩོལ་མཛད་པ།",
    "ལྷག་པའི་ལྷ་ལ་གཙུག་གི་ནོར་བུས་འདུད།",
    "ཉན་རང་ཡང་ཕུང་པོ་སོགས་ཀུན་ལ་མུན་པ་བཅོམ་པར་འདོད་མོད་ཀྱི་གཏན་ནས་བཅོམ་པ་ཞེས་བྱ་བ་ནི་མ་ཡིན་ཏེ།",
    "ཉོན་མོངས་པ་ཅན་མ་ཡིན་པའི་མི་ཤེས་པ་དང་མ་བྲལ་བའི་ཕྱིར།",
    "ཉོན་མོངས་པའི་དྲི་མ་མེད་པ་ཟག་མེད་ཀྱི་ཤེས་རབ་རྗེས་འབྲང་དང་བཅས་པའོ།",
    "གཟུགས་ཁམས་ན་ཐོས་བྱུང་དང་སྒོམ་བྱུང་གི་ཤེས་རབ་ཡོད་ཅིང་བསམ་བྱུང་གི་ཤེས་རབ་མེད།"
  ]
}