    "སྐྱེ་མཆེད་དྲུག་གི་རིགས་དེ་བཞིན་ཉིད་ཇི་ལྟ་བ་དེ་བཞིན་དུ་རྟོགས་པ་ཐོབ་པའི་ཕྱིར།",
    "རི་མོ་མཁན་གྱི་དཔེས་སྟོན་པ་ནི།",
    "དེ་ནས་སའི་མངའ་བདག་རྒྱལ་པོས་རི་མོ་མཁན་དེ་དག་ལ་རི་མོའི་གཞི་རས་བྱིན་ནས་འདི་སྐད་ཅེས་རས་འདི་ལ་རི་མོ་མཁན་ཁྱེད་ཀུན་གྱིས་རྒྱལ་པོ་ངའི་གཟུགས་རྫོགས་པ་ཞིག་གྱིས་ཤིག་ཅེས་བསྒོ་བ་དང་།",
    "དེ་ནས་རི་མོ་མཁན་དེ་དག་གིས་རྒྱལ་པོའི་བཀའ་དེ་ནི་ཐོས་ཏེ་རང་རང་གིས་གང་ཤེས་པའི་རི་མོ་དེ་བྲི་བའི་ལས་ལ་རབ་ཏུ་སྦྱོར་རོ།",
    "ཡན་ལག་དེ་རྣམས་འབྲི་བྱེད་རི་མོ་མཁན་གྱིས་མཚོན་པའི་དོན་གང་ཡིན་ན།",
    "ལྗོན་ཤིང་གི་མྱུ་གུ་སོགས་དེ་དག་གི་རྒྱུ་ཤིང་གི་འབྲས་བུ་ཆུང་ངུ་ལ་ཡོད་པ་དང་།",
    "ཇི་ལྟར་མི་སྡུག་པའི་པདྨ་ཟུམ་པ་དེའི་ཁོང་ན་བདེ་བར་གཤེགས་པ་གནས་པ་ལྷའི་མིག་དང་ལྡན་པ་འགའ་ཞིག་གིས་མཐོང་ནས་དེ་དབྱུང་བའི་དོན་དུ་པདྨའི་འདབ་མ་གཅོད་པར་བྱེད་པ་ལྟར།",
    "ཇི་ལྟར་སྦྲང་ཚང་སྦྲང་རྩིས་གང་བ་སྲོག་ཆགས་བུང་བ་བྱེ་བ་ཁྲག་ཁྲིག་སྟོང་གིས་བསྒྲིབས་པ་ཞིག་སྦྲང་རྩི་དོན་དུ་གཉེར་བའི་མིས་མཐོང་ནས་སྦྲང་མ་དེ་དག་བསལ་ཏེ་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་སྦྲང་རྩིའི་བྱ་བ་བྱེད་པ་དེ་བཞིན་དུ།",
    "ཉོན་མོངས་པ་ནི་དེའི་སྒྲིབ་བྱེད་སྦྲང་མ་དང་འདྲ་ཞིང་།",
    "ཇི་ལྟར་དབུལ་པོ་ཞིག་གི་ཁྱིམ་ནང་གི་ས་འོག་གཏེར་ཆེན་པོ་ཡོད་པར་གྱུར་ལ།",
    "ཆུ་ལུད་སོགས་ཀྱི་ཚོགས་པ་དང་ལྡན་པ་ལས་རིམ་གྱིས་ལྗོན་ཤིང་གི་རྒྱལ་པོའི་དངོས་པོར་འགྲུབ་པ་ལྟར་རོ།",
    "གོ་འབྱེད་པའི་ནམ་མཁའི་རྐྱེན་རྣམས་ཀྱིས་ཏ་ལ་དང་ཨ་མྲ་སོགས་ཀྱི་འབྲས་བུའི་སྦུབས་ཀྱི་གསེབ་ནས་ས་བོན་གྱི་ནུས་པ་དེ་ལས་ཤིང་སྐྱེ་བ་ཇི་ལྟ་བར།",
    "ཇི་ལྟར་མི་མོ་གཟུགས་ངན་ཞིང་དབུལ་བ་མགོན་མེད་པ་འགའ་མགོན་མེད་པའི་ཁྱིམ་གྱི་གནས་སུ་འདུག་པར་གྱུར་པ་དེའི་མངལ་ན་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོའི་དཔལ་འཛིན་པར་བྱེད་པ་ན།",
    "བུད་མེད་དེས་རང་གི་ལྟོ་ན་ཡོད་པའི་མི་བདག་མི་ཤེས་པ་ལྟར་རོ།",
    "ཇི་ལྟར་བུད་མེད་ལུས་ལ་དྲི་མ་དང་བཅས་པའི་གོས་གྱོན་ཞིང་མི་སྡུག་པའི་གཟུགས་དང་ལྡན་པ་ཞིག་ས་བདག་འཁོར་ལོས་སྒྱུར་བ་རང་གི་མངལ་ན་གནས་ཀྱང་དེ་མ་ཤེས་པས་མགོན་མེད་པའི་ཁང་པར་འདུག་ནས་དབུལ་བ་དང་ཞུམ་པ་སོགས་ཀྱི་སྡུག་བསྔལ་མཆོག་མྱོང་བ་ལྟར།",
    "ཇི་ལྟར་འཇིམ་པའི་ནང་གི་གསེར་ཞུན་བླུགས་པའི་རྟའི་གཟུགས་སོགས་ཡན་ལག་ཚང་བས་རྒྱས་པ་དང་།",
    "ཇི་ལྟར་འདོད་པ་བཞིན་བསྒྱུར་དུ་རུང་བས་ན་ཞི་བ་དག་ཕྱི་རོལ་ནས་སའི་རང་བཞིན་འཇིམ་པས་གཡོགས་པ་ཅན་དེ་མཐོང་ནས་ནང་དུ་གསེར་གྱི་གཟུགས་དེ་ཡོད་པར་ཤེས་པའི་ལྷ་བཟོ་བ་དག་ནང་གི་གསེར་གྱི་གཟུགས་ལ་གཡོགས་པའི་ས་འདམ་སྦྱང་བར་བྱ་བའི་ཕྱིར་ཕྱི་རོལ་གྱི་སྒྲིབ་གཡོགས་སེལ་བར་བྱེད་པ་ལྟར་རོ།",
    "གཉིས་པ་དེ་དག་གི་དོན་བསྡུ་བ་ལ།",
    "འབྲས་ཤུན་གོས་ཧྲུལ་བུད་མེད་ཀྱི།",
    "ཉེ་བའི་ཉོན་མོངས་པའི་སྦུབས་ཀྱི་གསལ་བའི་དབྱེ་བས་ཕྱེ་ན།",
    "བྱང་སེམས་བཞི་པོ་དེ་ལ་དྲི་མ་དགུ་པོ་དེ་དག་གིས་གོ་རིམ་བཞིན།",
    "འདིར་རིགས་གཉིས་ལ་དཔེ་རེ་རེ་དང་།",
    "ཉོན་མོངས་སྦུབས་ན་གནས་པ་དེ།",
    "དཔེ་དག་གིས་ནི་ཤེས་པར་བྱ།",
    "བཞི་པ་ཁམས་དེ་གང་ཟག་གང་གིས་རྟོགས་པ་བསྟན་པ་ལ་གསུམ་སྟེ།",
    "སྤྲིན་མཐོང་མཁའ་ལ་ཉེ་བཞིན་འདིར་ཁྱོད་ཕྱོགས་ཅིག་བློ་གྲོས་ཅན།",
    "བློ་མིག་དག་པའི་འཕགས་མཆོག་གིས་ཀྱང་ཐམས་ཅད་མཐོང་མ་ལགས།",
    "ཤེས་བྱ་མཐའ་དག་མཁའ་དབྱིངས་ཁྱབ་པ་དེ་དག་གིས་ཀུན་མཐོང་།",
    "རང་བཞིན་རྣམ་དག་གི་ཕྱོགས་ཅིག་མཐོང་མི་མཐོང་ལ་སྦྱོར་བ་ནི་མ་ཡིན་ནོ།",
    "ཡང་ཁམས་འདི་ལ་རྣམ་བྱང་གི་དམིགས་པ་བདག་མེད་གཉིས་གསར་དུ་བཞག་པར་བྱ་བ་ཅུང་ཟད་མེད་དེ།",
    "དེ་ལྟར་བལྟས་པས་ཡང་དག་པ་གང་ཟག་གི་བདག་མེད་མཐོང་ན་ཉོན་མོངས་པའི་སྒྲིབ་པ་ལས་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ།",
    "ཁམས་ཉོན་མོངས་པའི་སྦུབས་ན་གནས་པའི་ཚུལ་དཔེ་དགུ་དག་གིས་བསྟན་པ་དང་འགལ་བ་དང་།",
    "དྲི་བཅས་དེ་བཞིན་ཉིད་ཀྱི་རྣམ་པར་བཞག་པ་མི་རུང་བར་ཐལ་བས་སོ།",
    "ཁམས་འདི་ལ་ཀུན་ནས་ཉོན་མོངས་པའི་རྒྱུ་དྲི་མ་ངོ་བོ་ཉིད་ཀྱིས་ཡོད་པ་བསལ་བར་བྱ་བ་ཅི་ཡང་མེད་དེ།",
    "འབྲལ་རུང་གི་མཚན་ཉིད་ཅན་ཡིན་པའི་ཕྱིར།",
    "རང་བཞིན་རྣམ་དག་གི་ཁམས་དང་རྣམ་པར་དབྱེ་བ་མེད་པའི་མཚན་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "ཁམས་དེ་གང་ཟག་གང་གིས་རྟོགས་པ་བསྟན་ཟིན་ཏོ།",
    "དེ་ལྟར་ཁམས་དེ་འཕགས་མཆོག་གིས་ཀྱང་རྟོགས་པར་དཀའ་ན་བྱིས་པ་ལས་བརྩམས་ཏེ་བསྟན་པ་ལ་དགོས་པ་ཅི་ཡོད་ཅེས་པའོ།",
    "ཀུན་རྫོབ་ཏུ་ཉོན་མོངས་པའི་ཉོན་མོངས་པ་དང་།",
    "ལས་ཀྱི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "ལས་ཉོན་དེ་དག་གི་རྣམ་སྨིན་གྱི་དོན་སྐྱེ་བའི་ཀུན་ནས་ཉོན་མོངས་པ་དང་གསུམ་པོ་ནི་སྤྲིན་ལ་སོགས་པ་བཞིན་དུ་བརྗོད་དོ།",
    "ཉོན་མོངས་ནི་སེམས་ཀྱི་རང་བཞིན་མ་ཡིན་པ་དང་།",
    "བློ་ཕྱིན་ཅི་ལོག་གིས་བསྐྱེད་པ་དང་།",
    "ཕྱིན་ཅི་ལོག་གི་དམིགས་པ་ཡིན་པས་སོ།",
