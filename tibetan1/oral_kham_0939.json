    "ལ་ལ་ནི་ཤིན་ཏུ་ནོངས་ཀྱང་རང་གཤིས་ངན་པས་བསྙེམས་ཏེ་ངོ་གདོང་གྱེན་དུ་བཏེགས་ཏེ་འཁོད་དོ།",
    "ཕྲེང་སྟོན་བཞིན་དུ་རང་རང་སོ་སོའི་བཞུགས་གནས་སུ་ཞི་ཞིང་དལ་ལ་བག་ཕེབས་ཀྱིས་འཁོད་ནས་གནས་སོ།",
    "ང་ནི་དགའ་སྐྱོ་ཁོ་ནའི་ཁྲོད་དུ་དུས་ཀྱི་བགྲང་བྱ་བདུན་གཉིས་བཅུ་བཞི་ཙམ་ཚོར་མེད་དུ་འདས་ཟིན་འདུག་པས།",
    "རི་རབ་ལྷུན་པོ་ས་ཡིས་གཡོས་ཀྱང་རང་ཚུགས་བརྟན་པོས་འགྱིང་ངེར་བཞུགས།",
    "རྟ་བདུན་བདག་པོ་སྤྲིན་གྱིས་བསྒྲིབས་ཀྱང་རང་བཞིན་འོད་ཟེར་ས་གཞི་འགེང་།",
    "སྦྱངས་པའི་སེར་གསེར་བཟང་ས་རུམ་བཙུད་ཀྱང་རང་ལྡན་འོད་སྣང་མཁའ་ལ་འཚེར།",
    "འདོད་པའི་ཕྱིར་དུ་ལུས་སེམས་མནར་བའི་སྡུག་བསྔལ་མེད་པའི་སྐྱིད་སྡུག་ཅིག་འདུག།",
    "ཅེས་ཞལ་ནས་ལྷང་ལྷང་དུ་འདོན་རྗེས་ཨ་ཙི།",
    "གནས་འདི་ག་ནས་ཁོ་རང་ལ་རྨང་གཞི་བརྟན་པོ་ཞིག་ཚུགས་ཐུབ་པ་བྱུང་ལ།",
    "དེ་ནས་ཁོ་རང་ཁྱིམ་དུ་མི་སྡོད་ཐབས་མེད་དུ་གྱུར་ཅིང་།",
    "ཁོ་རང་ཡང་རྗེས་སུ་རྒྱ་གར་ནས་ཚེ་ལས་འདས།",
    "ཁོ་རང་ཞང་པོ་བཟའ་མི་གཉིས་དང་ཁ་གྱེས་ཏེ།",
    "དེ་དུས་ཁོ་རང་ལོ་ཡིན།",
    "ཁོ་རང་ཁྱིམ་ཚང་གང་དུ་བསྡད་ཚེ།",
    "གྱང་གཉིས་ཀྱི་བར་ན་བསྐུངས་ཡོད་པའི་ཁོ་རང་ཕྱིར་འཐེན་ཏེ་མེ་མདའ་བརྒྱབ་ཏེ་བསད།",
    "སྟོབས་ཤུགས་ཀྱིས་ཁེངས་འདུག་པས་ཡིན།",
    "ཁོ་རང་ལྐོག་ཏུ་ལས་ཀ་མི་བྱེད་ཀ་མེད་དུ་གྱུར།",
    "ཁོ་རང་ཧྲང་ཧའེ་རུ་མ་བསླེབས་སྔོན།",
    "ཁོ་རང་ནི་སྤྱང་གྲུང་ངང་ཧུའུ་ཉིན་ཁྭ་བརྒྱུད་དུ་བདེ་བླག་ངང་བགྲོད་ཀྱིན་ཡོད་ཅིང་།",
    "ཆུ་བོར་ཟམ་པ་འཐེན་སྐབས་མི་འདུག་ལ།",
    "དུས་འདི་ནས་བཟུང་ཁོ་རང་དམར་དམག་རྒྱང་བསྐྱོད་ཀྱི་རུ་ཁག་དང་གྱེས་ཏེ།",
    "ཁོ་རང་ཞི་མའོ་ཀྲའོ་གཞི་ནས་ཁ་བྲལ་ཏེ་ཧྲང་ཧའེ་རུ་འགྲོ་བའི་གྲུ་གཟིངས་སུ་བསྡད།",
    "ཁོ་རང་ཀྲུང་དབྱང་རྩ་འཛུགས་པུའུ་རུ་འགན་ཁུར་དུས་ཀྱི་ལོ་བདུན་གྱི་རིང་ལ།",
    "ཁོ་རང་ཐོག་མར་རྩ་འཛུགས་པུའུ་རུ་ཐོན་དུས།",
    "སྐྱོན་བརྗོད་དང་རང་སྐྱོན་ངོས་ལེན་བྱེད་པའི་ཐད་ལ།",
    "སྐྱོན་བརྗོད་བྱེད་པ་དང་རང་སྐྱོན་ངོས་ལེན་བྱེད་པའི་ཐད་ལ།",
    "དུས་ནམ་ཞིག་ལ་སྐྱོན་བརྗོད་དང་རང་སྐྱོན་ངོས་ལེན་གྱི་བྱ་བ་དེ་ཡག་པོ་བསྒྲུབས་ནུས་ན།",
    "དུས་ནམ་ཞིག་ལ་སྐྱོན་བརྗོད་དང་རང་སྐྱོན་ངོས་ལེན་གྱི་བྱ་བ་དེ་ཡག་པོ་ཞིག་བསྒྲུབ་མ་ནུས་ཚེ།",
    "ཁོ་རང་རི་འགོར་འཛེགས་མི་ཐུབ་པས།",
    "ཁྲིན་ཡོན་གྱིས་ད་དུང་རང་ཉིད་ཀྱི་ཁྱིམ་གཞིས་ཆུང་ཆུང་དེ་ཡང་འཛུགས་བྱུང་།",
    "ཁོ་རང་སྐྲག་ཐག་ཆོད་ནས།",
    "ང་རང་ནི་དམག་དོན་ལ་འཇོན་པོ་མེད་ཀྱང་།",
    "སྐར་ལྔའི་དར་དམར་བདེ་མི་འདུག།",
    "ཞབས་བྲོ་རྩེན་པ་བགྲོད་དཀའ་འདུག་ཅེས་ཟེར།",
    "དངོས་གནས་བཟང་འདུག་ཅེས་སྨྲས།",
    "ང་ནི་ཁྱེད་ལ་དྲི་རྒྱུ་ཞིག་འདུག་དྲིས་ན་ཆོག་གམ།",
    "ཡིན་ནའང་དོན་དངོས་སུ་ཁོ་རང་རྫས་འགྱུར་བཟོ་གྲྭ་རུ་བསྡད་པའི་དུས་ཚོད་ཤིན་ཏུ་རིང་བས།",
    "ནམ་རྒྱུན་མི་གཞན་གྱིས་ཁོ་རང་ཟ་མ་ཟ་རུ་བོས་ཚེ།",
    "ལྟ་སྐུལ་བས་ཁོ་རང་ལ་བསྐུལ་མ་ཡང་ཡང་བྱས་ཚེ།",
    "བལྟས་ཚོད་ཀྱིས་ཁོ་རང་ཕལ་ཆེར་ལྷན་པ་ཆེ་ཆུང་བརྒྱབ་ཡོད་པའི་ལྭ་བ་འདིར་ལྷག་པར་དགའ་བ་འདྲ།",
    "རལ་ནས་གྱོན་ཐབས་མི་འདུག་པས།",
    "ཡང་བསྐྱར་པེ་ཅིན་དུ་ལོག་ལོ་དེའི་ལྔ་གཅིག་དུས་ཆེན་གྱི་སྐབས་སུ།",
    "ངས་བསམ་ཚུལ་ལ་གཏན་ཁེལ་བྱས་འདུག་དེར་བརྟེན།",
    "ཁོ་རང་དང་ཏིང་ཞའོ་ཕིང་སོགས་ཀྱིས་དག་སེལ་གྱི་ལས་འགན་ཁུར་བྱུང་ལ།",
    "མཐོང་བས་ཚིམ་པ་མི་འདུག།",
    "ཕྱོགས་ནས་སྔོན་མ་བཀྲ་ཤིས་ལྗོངས་ཀྱི་གྲྭ་སྒྲུབ་བརྒྱུད་གཉེན་འཕྲད་དུ་ཕེབས་པའི་སྐབས་ཡིན་འདུག་པས་དེའང་སྟབས་ཅིག་ཏུ་བོས་ཤིང་།",
    "སྐབས་དེའི་རིང་སྐུ་གསུང་ཐུགས་རྟེན་འབུལ་མི་དང་དངོས་པོ་སོ་སོའི་མཚན་སོགས་ཁམས་པ་སྒར་གྱི་དཀར་ཆག་ལས་གསལ་པོར་འཁོད་འདུག་པས་འདིར་ཡིག་ཚོགས་ལ་འཇིགས་ཏེ་འབྲི་བའི་ངལ་བ་མ་བྱས།",
    "དེ་དུས་ལས་རིགས་རྒྱ་བོད་སེར་སྐྱ་མི་དམངས་མི་ཉུང་བ་ཙམ་ནས་ལས་ཤུགས་རྒྱག་བཞིན་འདུག་པས།",
    "ཐོག་སོ་གཉིས་པའི་གྱང་བརྡུང་བཞིན་འདུག་རིམ་བཞིན་གཙུག་ལག་ཁང་བཞི་ཐོག་ཕྱི་ནང་གཙང་བཟོ་གྲུབ་པ་དང་།",
    "ནས་འདིའི་བར་སྐུ་རབས་གསུམ་ལས་འགྲོ་ཐབས་མ་མཆིས་པས་ཡིག་ནོར་བྱུང་བ་ཡིན་འདུག་སྙམ་པས་བརྟག་པར་བྱའོ།",
    "བཀའ་དང་བསྟན་བཅོས་ཡོངས་སུ་གྲགས་པ་རྣམས་དང་རང་ལུགས་ཐུན་མིན་གྱི་གདམས་པ་རྣམས་ལ་ཐོས་བསམ་གནང་ཡུལ་ཞིག་སྟེ།",
    "འགན་བཞེས་མྱོང་ཡོད་འདུག་དེ་དག་ནི་སྤྱི་ལོ་༡༩༥༩ལོའི་སྔར་གྱི་ཐང་རྙིང་ཡི་དམ་བདེ་མཆོག་ཡབ་ཡུམ།",
    "ཁོང་རང་ཉིད་སྐུ་ཚེ་ཧྲིལ་པོར་སྒྲུབ་པ་ལ་བཞུགས་རྒྱུའི་དམ་བཅའ་མཛད་ཡོད།",
    "དགུང་ལོ་དགུ་ནས་བཅོ་ལྔའི་བར་འབྲི་ཀློག་དང་རང་ལུགས་ཀྱི་ཕྱག་བཞེས་དང་རིག་པའི་གནས་ལྔར་སྦྱངས་པ་མཛད།",
