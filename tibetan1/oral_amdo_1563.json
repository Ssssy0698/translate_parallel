    "དེ་ནས་བྱང་ཕྱོགས་ལ་གཟིགས་པས་བྱང་ཕྱོགས་ཐག་རིང་གི་རི་མགོ་གངས་ཀྱིས་གཡོགས་པ་ཞེ་ཅིག་དང་།",
    "ཕྱོགས་དེར་ཁ་ཆར་རྒྱུན་ཆད་མེད་པར་འབབ་པ་གཟིགས་པས་སྐྱོ་ཤས་ཆེ་པའི་ཡུལ་དེའི་ཐད་དྲགས་ནས་རིང་པོའི་སར་རྒྱལ་པོ་ཉིད་པེབས་དགོས་པ་འདུག་སྙམ་ནས་ཐུགས་ངལ་ཞིང་སྤྱན་ཆབ་མང་དུ་བསིལ་ཞིང་ཞལ་ཏ་མ་རྣམས་ལ་གཟིགས་ནས་འདི་སྐད་དོ།",
    "ཚུར་ལ་ཉོན་དང་འདིར་འདུས་བུ་མོ་རྣམས།",
    "རིགས་ངན་རྔོན་པའི་ལག་ཏུ་བུ་མོ་ཐེབས།",
    "བུ་མོས་ལས་ངན་གང་དུ་བསགས་སམ་ཅི།",
    "གཅིག་གིས་གཅིག་ལ་འཆང་སྟེ་རེ་ཞིག་དེར་ལུས།",
    "དེ་ལྟ་བུའི་མཛད་པ་ལ་གཞིག་ནས་ཞབས་འབྲིངས་ཕོ་མོ་ཀུན་ངལ་བར་གྱུར་ཅིང་།",
    "ཁྱོད་ཉིད་རི་མགོ་མཐོན་པོའི་ཡངས་ཐོག་ཏུ།",
    "སླར་ཡང་བུ་མོ་གསོས་པས་ཡ་མཚན་ཆེ།",
    "མཐོང་བས་བུ་མོའི་གདུང་བ་ཀུན་སེལ་ཅིང་།",
    "གཞོན་ནུ་ནོར་བཟང་བུ་མོ་བདག་ལ་གསོན།",
    "བྱང་ཕྱོགས་མིག་གིས་མཐོང་བའི་ས་ཆ་ཡང་།",
    "རྒྱལ་པོའི་ཕྱག་ཕྱིར་བུ་མོ་འཁྲིད་དུ་འཚལ།",
    "སྤྱོལ་པོ་ཡབ་སྲས་རང་སྐུ་ལུས་གཅེར་བུ་བྱས་མི་མང་པོ་ཞིག་གིས་བསྐོར།",
    "ཨ་མ་ཡིད་འཕྲོག་ཡོང་ནས་འགྱངས་དགོས།",
    "གོ་མཛོད་སྟེང་གི་བཀའ་རྒྱུ་ཚོམས་ཆེན་ནས།",
    "ནོར་བཟང་འཁོར་འབངས་ཕྱོགས་འགྲོའི་དཔོན་གཡོག་གིས།",
    "ཨ་མ་ཡིད་འཕྲོག་མཚོན་པའི་གཞིས་སྡོད་ཀྱི།",
    "བུ་ཆུང་འགྲོ་དགོས་ཨ་མ་ཡིད་འཕྲོག་གིས།",
    "དྲན་ཤེས་ང་ཡིས་མོལ་བའི་ལས་རྣམས་སྒྲུབས།",
    "ཞེས་ཡབ་ཀྱིས་དཔོན་འབངས་ཀུན་ལ་བཀའ་སྩལ་བས་སོ་སོར་འཁྲི་བའི་ལས་དོན་ཇི་བཞིན་དང་དུ་བླངས་པའི་སང་ཉིན་གཞིས་བྱེས་དཔོན་གཡོག་རྐྱེན་གཟབ་འབྱོར་བཅས་ལྷོ་སྒོའི་ཐང་དུ་འཛོམ་པའི་མཛོད་སྟེང་ཚོམས་ཆེན་ནང་གི་གོ་ཆ་འདོན་པའི་ལྡེ་མིག་རྣམས་ཡུམ་དང་ཡིད་འཕྲོག་མ་བློན་པོ་བཅས་ལ་ཡབ་ནས་སྩལ་བས་འདི་སྐད་དོ།",
    "ཚུར་ལ་ཉོན་དང་ཨ་མ་ཡིད་འཕྲོག་མ།",
    "གོ་མཛོད་སྟེང་གི་བཀའ་རྒྱ་ཚོམས་ཆེན་ན།",
    "མདའ་མོ་འདི་ལ་གནམ་ལྕགས་ཐོག་འབེབས་ཟེར།",
    "གཟིག་ཤུགས་འདི་ལ་མུན་པའི་འོད་སྣང་ཟེར།",
    "རྒྱལ་པོའི་སྐུ་ལ་གཟིག་ཤུབས་གསོལཾ་ཟེར་ན།",
    "མངོན་སྤྱོད་སེར་བའི་མདའ་མོའི་མཚོན་ཆ་དེས།",
    "བཀའ་དྲིན་ཅན་གྱི་ཡུམ་ཆེན་ཨ་མ་དང་།",
    "ཨ་མ་ཡིད་འཕྲོག་གཉིས་ལ་གཞོན་ནུ་ངས།",
    "ཨ་མ་ཡིད་འཕྲོག་གཟིམ་ཆུང་གཅིག་ཏུ་བཞུགས།",
    "བུ་མོས་ཨ་མའི་བཀའ་བཞིན་དང་དུ་ལོངས།",
    "ཨ་མས་བདག་ལ་བྱམས་བརྩེས་སྐྱོང་བ་བཞིན།",
    "ཞེས་གསུངས་ནས་བུ་མོའི་གཙུག་རྒྱན་དེ་རྒྱལ་པོས་ཡུམ་གྱི་ཕྱག་ཏུ་ཕུལ་ནས་འདི་སྐད་དོ།",
    "ཡིད་འཕྲོག་གཙུག་རྒྱན་བཅས་པ་ཨ་མ་ཁྱེད་ལ་བཅོལ་ལོ།",
    "ང་དང་ཡིད་འཕྲོག་ལྷ་མོའི་སྐྱབས་ཡུལ་གཞན་ན་མ་མཆིས།",
    "བུ་མོའི་སྲོག་ལ་བབས་པའི་འཇིགས་པ་བྱུང་ན་མ་གཏོགས།",
    "གཙུག་རྒྱན་ཡུམ་ཆེན་ཨ་མས་ཐུགས་བཅག་གནང་རོགས་གནང་དང་།",
    "བུ་མོ་མཆི་མ་མ་གཏོང་བདག་ཉིད་སེམས་ཀྱང་ཕམ་པ།",
    "ཡུམ་ཆེན་ན་རེ།",
    "ཚུར་ལ་གསོན་དང་དགོངས་དང་བུ་ཆུང་གི་ནོར་བཟང་།",
    "མ་ཤི་གསོན་བྲལ་ཡོང་བ་མ་བུ་གཉིས་ལ་བྱུང་སོང་།",
    "དང་པོར་ཁྱོད་ཉིད་མ་སྐྱེས་ཨ་མ་བློ་ཐག་ཆོད་འགྲོ།",
    "སྐྱེས་པའི་ནོར་བཟང་གཅིག་པོ་དགྲ་བོའི་ཡུལ་ལ་བརྫངས་སོང་།",
    "བུ་ཆུང་བྱང་ནས་འཁོར་འཁོར་ཨ་མའི་ཚེ་ཡིས་མི་ཐུབ།",
    "ཞེས་གསུངས་པས་ཡིད་འཕྲོག་ན་རེ།",
    "གསེར་བྱ་ངང་པའི་བློ་གཏད་མཚོ་མོ་ཁྱེད་ལ་བཅོལ་ཡོད།",
    "མཚོ་མོ་འཁྱགས་པས་བསྡམས་ན་ངང་པ་མོན་ལ་ལོག་འགྲོ།",
    "ཡིད་འཕྲོག་ལྷ་མོའི་བློ་གཏད་ནོར་བཟང་ཁྱེད་ལ་ཞུས་ཀྱང་།",
    "རྒྱལ་པོ་བྱང་ལ་བྱོན་ན་བུ་མོ་ཡུལ་ལ་ལོག་འགྲོ།",
    "བུ་མོ་ཡུམ་གྱི་དྲུང་དུ་སྡོད་འདོད་མེད་པ་མིན་ཏེ།",
    "རབ་གསུམ་རྒྱལ་པོའི་རྗེས་སུ་བུ་མོ་འཁྲིད་རོགས་གནང་དང་།",
    "དེ་མིན་ལྗོན་པའི་ཡུལ་ལ་བུ་མོ་སློག་རོགས་གནང་མཛོད།",
    "རྒྱལ་པོ་ན་རེ།",
    "བུ་མོ་དེ་ལྟར་མ་གསུང་བུ་ཆུང་བདག་ལ་གསོན་དང་།",
    "དེ་འདྲའི་ཡུལ་ལ་བུ་མོ་བགྲོད་པའི་ས་ནི་མེད་དོ།",
    "ཉིན་མོ་མི་མེད་མཚན་མོ་འདྲེ་སྲིན་ཐམས་ཅད་ཚོགས་ཡོང་།",
    "ལྷག་དོན་རང་རེ་གཉིས་ཀ་དག་པོའི་ལག་ཏུ་ཚུད་ཡོང་།",
    "དེ་ལྟར་མ་གསུང་ལྷ་སྲས་ཨ་མའི་དྲུང་དུ་བཞུགས་དང་།",
    "ལ་བཙས་དང་པོར་ཨ་མས་སྐྱེལ་མ་གྱིས།",
    "ཅེས་བཀའ་སྩལ་ནས་ཡབ་ཆེན་རང་གིས་ཞབས་གྲས་རྣམས་ལ་བཀའ་བསྒོས་ནས་རྡོ་བཅལ་དུ་ནོར་བཟང་ལ་སྐྱེལ་ཆང་གི་ཐོག་དར་དང་བཅས་འདི་སྐད་དོ།",
    "བདག་གི་ཞུས་པའི་ཚིག་འདི་ཡབ་ཀྱི་ཐུགས་ལ་བཅང་དགོས།",
    "ཨ་མ་ཡིད་དཕྲོག་གཉིས་ལ་ཡབ་ཀྱིས་བརྩེ་བས་སྐྱོང་དགོས།",
    "ཨ་མ་ཡིད་འཕྲོག་བློ་སེམས་ཕམ་དུ་འཇུག་པ་མ་གནང་།",
    "ནོར་བཟང་ན་རེ།",
    "ཚུར་ལ་གསོན་དང་གཏན་གྲོགས་བཙུན་མོ་ཡི་ལྔ་བརྒྱ་། རྣ་བ་གཞན་ལ་མ་ཡེངས་ནོར་བཟང་ང་ལ་གསོན་དང་།",
    "ཁྱེད་ཅག་བཙུན་མོ་ལྔ་བརྒྱ་སྐུ་ཁམས་བཟང་བར་བཞུགས་ཤིག།",
    "མ་ཤི་ཚེ་རིང་བྱུང་ན་ངང་གིས་ངང་གིས་མཇལ་ཡོང་།",
    "ལོ་ངོ་བཅུ་གཉིས་བར་ལ་ཨ་མའི་ན་སོས་མི་ཐུབ།",
    "ཨ་མ་ངས་ཀྱང་སྨོན་པ་ནན་ཏན་དུ་བྱེད་དོ།",
    "ཅེས་གསུངས་ནས་དངུལ་ཕོར་བདུད་རྩིས་བསྐང་བ་ཕྱག་ཏུ་ཕུལ་རྗེས་ནོར་བཟང་གིས་ཡུམ་གྱི་ཕྱག་ལ་འཆང་ནས་འདི་སྐད་དོ།",
    "བྱམས་བརྩེ་བཀའ་དྲིན་ཅན་གྱི་ཨ་མ་བདག་ལ་གསོན་དང་།",
    "བུ་ཆུང་བྱང་དུ་འགྲོ་བ་ལ་ཨ་མ་ཐུགས་ངལ་མི་དགོས།",
    "ཨ་མ་སྐུ་ན་མཐོ་བས་བུ་ཆུང་སེམས་པ་སྐྱོ་བྱུང་།",
    "བསམ་ཞིང་ཨ་མའི་བཀའ་དྲིན་འཁྱེར་ས་ནི་མི་འདུག།",
    "བྱམས་པའི་པང་དུ་བཞེས་པ་བསམ་ཞིང་ཨ་མ་དྲན་བྱུང་།",
    "འཇམ་པ་ལུས་ལ་གཡོག་པ་བསམ་ཞིང་ཨ་མ་དྲན་བྱུང་།",
    "ནུ་ཞོ་སྐུ་ནས་བཏུང་བ་བསམ་ཞིང་ཨ་མ་དྲན་བྱུང་།",
    "བྱམས་པའི་སྤྱན་གྱིས་གཟིགས་པ་བསམ་ཞིང་ཨ་མ་དྲན་བྱུང་།",
    "སྙན་པོའི་མིང་ནས་འབོད་པ་བསམ་ཞིང་ཨ་མ་དྲན་བྱུང་།",
    "བདག་ཉིད་བྱང་ནས་ཚུར་འཁོར་ཨ་མའི་སྐུ་ཚེས་ཐུབ་ན།",
    "རང་རེ་མ་བུ་གཉིས་ཀྱི་བསམ་དོན་འགྲུབ་པ་འདུག་སྟེ།",
    "ཁྱོད་ཉིད་མི་རིང་ཞབས་སོར་བསྐྱོད་པ་ནས།",
    "ཐུགས་ལ་བསམ་པའི་རེ་བའི་དོན་འབྲས་རྣམས།",
    "ངལ་བར་མི་བྱ་སྔོན་དུ་མོལ་བ་བཞིན།",
    "ཨ་མའི་བཀའ་བཞིན་ལེགས་པར་སྒྲུབ་པ་དང་།",
    "མི་རིང་རང་གི་ཡུལ་དུ་ཡོང་བ་ཡིན།་།",
    "ལུས་སེམས་གཉིས་ཀའི་བཅུད་དུ་ད་རེས་བྱུང་།",
    "ཨ་མ་མ་མ་འདི་འདྲའི་སེམས་ཉིད་ཀྱི་ཙསྐྱོ་བ།",
    "ཞེས་རྒྱལ་པོའི་སྟག་དོང་གི་དཀར་ཐག་ནས་བཟུང་སྟེ་སྤྱན་ཆབ་བསིལ་བས་རྒྱལ་པོ་ན་རེ།",
    "ཨ་མ་མ་མ་བུ་ཆུང་ང་ཡི་སེམས་ཉིད་ཀྱི་སྐྱོ་བ།",
    "དེ་རིང་ལྷ་སྲས་ཡིད་འཕྲོག་གིས་སྟག་དོང་གཡས་ནས་བཟུང་བྱུང་།",
    "བུ་མོའི་ཐུགས་དང་བསྟུན་ན་ཡབ་ཀྱི་བཀའ་དང་འགལ་འགྲོ།",
    "བུ་མོ་དེ་ལྟར་མ་མཛད་བསམ་བློ་ཞིབ་ཏུ་ཐོངས་དང་།",
    "ཞེས་གསུངས་པས་ཡིད་འཕྲོག་མ་ན་རེ།",
    "བུ་མོས་བསམ་བློ་བཏང་ནས་ཞག་མ་མང་ཙམ་སོང་ངོ།",
    "འབྲི་དང་བེའུ་འཕྲལ་ཡང་རྡང་གི་ཕན་ཚུན་ཡིན་འདུག།",
    "བྱོལ་སོང་མ་བུ་དུང་བའི་བྱེད་པ་ལ་གཞིག་ཀྱང་།",
    "རྒྱལ་སྲས་དེ་ལྟར་མ་གསུང་བུ་མོ་བྱང་ལ་འཁྲིད་མཛོད།",
    "གསེར་བྱ་ཁ་ཡ་བྲལ་བ་མཚོ་མོ་མ་ན་མི་མདུག།",
    "འཇོལ་མོ་ཁ་ཡ་བྲལ་བ་ལྕང་གླིང་མ་ན་མི་འདུག།",
    "ལས་ངན་ཕུང་བྱེད་མ་ལ་ཡེ་ཤེས་དབྱིངས་ནས་གཟིགས་ཤིག།",
    "ཅེས་གསུང་ཞིང་སྐད་དང་བཅས་བཤུམ་པས་རྒྱལ་པོ་ན་རེ།",
    "བུ་མོ་ཡིད་འཕྲོག་ལྷ་མོ་འབྲལ་འདོད་སེམས་ལ་མེད་དེ།",
    "ཡིད་འཕྲོག་མཆི་མ་མ་གཏོང་རང་རེའི་ཚེ་ལ་གཟན་པ།",
    "ཤ་སྒྲད་འདི་ནི་མདའ་མོའི་སྟོང་ཚོད་ལ་དགོས་སོ།",
    "བསན་པ་ཨེ་བྱུང་ལྷ་སྲས་ཡིད་འཕྲོག་གི་ལྷ་མོ།",
    "ཅེས་རྒྱལ་པོའི་ཕྱག་གིས་ཡིད་འཕྲོག་མའི་ཞལ་རས་ཕྱིས་པས་ཡིད་འཕྲོག་ན་རེ།",
    "བུ་མོའི་སེམས་ཀྱི་རྟེན་ཆས་གནང་བ་བཀའ་དྲིན་ཆེ་སྟེ།",
    "ཡིད་འཕྲོག་གཞོན་ནུ་དྲན་པས་ཉིན་མཚན་འཁྱོལ་དུས་མི་འདུག།",
    "དེ་ལ་བུ་མོ་བདག་གི་རེ་བའི་བློ་གཏད་བཅོལ་ལོ།",
    "ཞེས་ཞུས་པས་རྒྱལ་པོས་རྒྱ་གྲི་དེ་བཞེས་སྐུ་འབྱར་ནང་མ་དེ་ཡིད་འཕྲོག་མར་གནང་བས་གཞོན་ནུའི་སྐུ་འབྱར་དེ་བུ་མོའི་གདོང་ལ་བཀབ་ནས་སྤྱན་ཆབ་བསིལ་ཞིང་བཞུགས་པས་ནོར་བཟང་དཔོན་གཡོག་སྐད་ཅིག་ཉིད་ལ་རིང་པོའི་སར་ཕེབས།",
    "སླར་ཡང་བཞེངས་ནས་རྒྱལ་པོའི་ཕེབས་རྗེས་སུ་རིང་པོའི་སར་སྤྱན་གྱིས་གཟིགས་ཤིང་བཞུགས།",
    "དེ་ཚབ་ང་ལ་མ་སྐྱེས་བུ་མོ་ཁྱེད།",
    "རང་གཉིས་མ་བུ་གཅིག་སེམས་གཅིག་གིས་འཛིན།",
    "ངལ་བར་མི་བྱེད་ཨ་མའི་ཡིད་འཕྲོག་མ།",
    "ཞེས་གསུངས་པས་ཡིད་འཕྲོག་མ་ན་རེ།",
    "ཚུར་ལ་གསོན་དང་ཡུམ་ཆེན་ཨ་མ་ལགས།",
    "སྐྱེས་པའི་ཨ་མ་ལྗོན་པའི་ཡུལ་དུ་ལུས།",
    "བུ་མོ་མ་སྐྱེས་ཨ་མ་ཁྱོད་མིན་པ།",
    "མཐོང་ཐོས་ཉེ་བའི་ས་ན་རེ་གནས་མེད།",
    "དྲིན་དུ་ཚོར་རོ་ཨ་མ་ཐུབ་ས་རྗེ་ཅན།",
    "ཞེས་གཅིག་གིས་གཅིག་ལ་དགྱེས་པས་མ་བུ་ལས་ཀྱང་ལྷག་པའི་དུང་སེམས་མཛད།",
    "ཨ་མ་ཡིད་འཕྲོག་རྣམ་གཉིས་ཀྱི།"
  ]
}