    "བྱ་མང་བསམ་སྦྱོར་ངན་པའི་མི་འཁྱམ་ཁྱོད།",
    "མཚོ་མོ་ཀླུ་བཅས་སྔར་ལྟར་བཟོ་དགོས་པའི།",
    "སྔགས་པ་ཞུམ་སྟེ་ངོན་པས་ཅི་ཟེར་བསྒྲུབས།",
    "མཚོ་ཡང་སྔར་བཞིན་སོང་ནས་ཀླུ་ཡང་གསོས།",
    "ཕྱིན་པས་སྐྱིད་ལ་ཡ་མཚན་ལྟད་མོ་ཆེ།",
    "བུ་མོ་མང་པོ་ཁྲུས་ལ་ཡོང་བ་ཡིན།",
    "དེ་རྣམས་རྔོན་པའི་ཡིད་དུ་སོང་བ་ལ།",
    "དྲང་སྲོང་བཀའ་བཞིན་རྒྱལ་པོའི་བཙུན་མོར་ཕུལ།",
    "ཞེས་ཞུས་པས་རྒྱལ་བློན་རྣམས་ངོ་མཚར་ཡ་མཚན་སྐྱེས་ཤིང་པད་མཚོར་མཚོ་རྫས་འདེབས་པའི་དོ་དམ་ལ་འགྲོ་མི་ནང་བཟན་འགའ་རེ་ནས་རྔོན་པ་ངོ་ཤེས་ནས་ཡིད་ཆེས་པར་གྱུར་ཅིང་།",
    "དེ་ཉིན་རྒྱལ་པོ་དང་ལྷ་མོ་མཇལ་བས་ལྷ་རྣམས་ཀྱིས་བཀྲ་ཤིས་མངའ་གསོལ་གྱི་མེ་ཏོག་གི་ཆར་ཕབ།",
    "བར་སྣང་ནས་ལྷའི་རོལ་མོའི་སྒྲ་སྒྲོག་ཅིང་ངོ་མཚར་བའི་ལྟས་ཕུན་སུམ་ཚོགས་པ་བྱུང་ཞིང་།",
    "རྒྱལ་པོ་ན་རེ།",
    "ཁྱོད་ཀྱིས་བྱང་ཕྱོགས་ཡུལ་ལ་དྲིན་ཆེན་པོས།",
    "ཁྱོད་ལ་བདག་རྐྱེན་མཐོང་བཟོས་བྱ་འོས་པས།",
    "རྔོན་པས་གང་བསམ་རེ་བ་ཡིད་སྐྱོང་བ།",
    "ཇོན་པས་འདོད་དེ་ཞུ་འོས་སང་མོལ་ཞིག།",
    "ཕྱི་ནས་དགྱེས་སྟོན་ཞུ་མི་གོ་རིམ་སོགས་རྒྱལ་ཁབ་ཆེན་པོའི་བྱ་གཞག་རླབས་པོ་ཆེའི་མཛད་བཟང་གི་བཀའ་བགྲོས་ཤིང་།",
    "ཞལ་ཏ་མ་ཀུན་དགའ་དཔལ་མོ་དང་།",
    "ས་འབྲུག་ཟླ་བ་བརྒྱད་པའི་ཚེས་ཉི་ཤུ་རེས་གཟའ་ཕུར་བུ་དང་།",
    "དེ་ནས་མུ་མཐུད་བཙུན་མོ་ལྔ་བརྒྱར་ཤིང་ཁྲི་བརྒྱབ།",
    "མདུན་གྲལ་གྱི་འགོར་རྔོན་པོ་དྲོ་ངཇམ་སྟག་པགས་གསུམ་བརྩེགས་ཀྱི་གདན་ལ་བཞག་ཕྱི་ནང་གི་འབངས་རྣམས་གོ་རིམ་གྱིས་གཡས་གཡོན་དུ་བསྡད།",
    "ཞལ་གྲོ་གསོལ་སྟོན་ཟབ་རྒྱས་སྔར་ཡ་གྲགས་པ་མཛད་ཅིང་ཡངས་ཐོག་གི་རྩེར་ལྷ་གསོལ་རྔ་བརྡུང་།",
    "ལྟད་ཡོ་མིག་མི་ཁོམ་པ་ལྟ་བུའི་རྣམ་སྤྱོད་དེར་ལྷ་རྣམས་བྱང་ཕྱོགས་པར་སྨོན་པའི་ལྟད་མོར་འདུ་བའི་སྐབས་ཇོན་པར་མཐོང་བཟོས་ཀྱི་བྱ་དགའ་ལེགས་སྐྱེས་སྩལ་བའི་གཏན་ཚིག་ཏུ།",
    "དཀར་ཕྱོགས་སྐྱོང་བའི་ལྷ་ཀླུ་རྣམས་ཀྱི་དཔུང་ཚོགས།",
    "ཁྱད་པར་རྒྱ་གར་ལྷོ་བྱང་གི་སྐྱེ་བོ་སེར་སྐྱ་མཆོག་དམན་བར་མ་ཉེ་འགྱངས་གང་ན་གནས་པ་རྣམས་ཀྱི་བསམ་ཞིང་གོ་བར་འཇགས་གྱུར།",
    "མིང་དུ་བཛྲ་པ་ཏི་ཤྲཱི་ཧ་ན་ཞེས་མིང་གི་གཟེངས་བསྟོད།",
    "བཙུན་མོ་ལྔ་བརྒྱའི་འདམ་ཁ་ཅི་འདོད་ཀྱི་གནང་ཆ་བཟང་པོས་ཇོན་པ་དབུལ་བའི་སྡུག་བསྔལ་ལས་གྲོལ་ཞིང་།",
    "ཡིད་འཕྲོག་མ་མཚར་བས་ལྟ་ན་ཆོག་མི་ཤེས་པའི་སྙན་གྲགས་དེར་འདུས་སྐྱེ་བོ་ཕོ་མོ་ཀུན་ནས་གླེང་ཞིང་།",
    "ཡིད་འཕྲོག་མཐོང་རྗེས་བཙུན་མོ་ལྔ་བརྒྱ་ཀུན་སྤྲེའུ་ལྟར་སོང་འདུག་ཅེས་ངོ་ལྐོག་ཏུ་གླེང་ཞིང་།",
    "རྒྱལ་པོ་ཉིད་ནི་ཡིད་འཕྲིག་མ་བྱུང་རྗེས་བཙུན་མོ་ལྔ་བརྒྱ་བསྙེལ་བར་ཉེ་ཞིང་།",
    "ལེགས་པར་བུ་མོ་བདག་ལ་ཚུར་གསོན་དང་།",
    "ཁྱོད་ཉིད་མཐོང་བ་ཙམ་གྱིས་དུག་གསུམ་གྱི།",
    "བུ་མོའི་སྲོག་བླུ་མཛད་པའི་དྲིན་ཆེན་པོ།",
    "རྒྱལ་པོ་ཉིད་ནས་ཡིད་འཕྲོག་གི་ཕྱག་ལ་འཆང་ནས་འདི་སྐད་དོ།",
    "ཁྱོད་མིན་གཞན་ལ་བདག་བློ་སྟོན་སྲིད་དམ།",
    "ཞེས་གསུངས་ཤིང་གཅིག་གིས་གཅིག་ལ་དགྱེས་པའི་སྐད་ཅིག་ཀྱང་འབྲལ་མི་ཕོད་པ་དེའི་མཛད་པ་མཐོང་ན་སྐྱེ་བོ་གཞན་རྣམས་ཀྱང་སྡུག་བསྔལ་དང་བྲལ་ཞིང་ཡིད་ལ་བདེ་སྐྱིད་བྱུང་བ་དང་།",
    "ཞེས་པ་ལྟར་འབྱུང་པོས་རྒྱུས་བརླམས་པའི་བཙུན་མོ་ལྔ་བརྒྱ་ཁྲོ་ལངས།",
    "ཡིད་འཕྲོག་མེད་བུའི་ཐབས་ལ་ཞི་དྲག་གང་གི་སྒོ་ནས་ཅི་ལེགས་གང་ལེགས་ཞེས་པའི་ནང་གྲོས་བྱས་ཀྱང་རྒྱལ་པོ་ཉིད་ཀྱི་དགོངས་པར་ཕོག་དོགས་རིམ་ལུས་ཀྱིས་ཡུན་རིང་སོང་།",
    "མཐར་བཙུན་མོ་དེ་རྣམས་ཀྱི་ཁྲོད་ནས་ན་རྒན་པ་གཡོ་འཁྲུལ་ལ་མཁས་པ་དོན་འགྲུབ་དཔལ་མོ་ཟེར་བ་ནས་འདི་སྐད་དོ།",
    "ཚུར་ལ་ཉོན་དང་རང་རེ་ལྔ་བརྒྱའི་ཚོགས།",
    "རྐང་འཁྱམས་ཡིད་འཕྲོག་ལྷ་མོ་ཟེར་པ་འདི།",
    "རྒྱུན་གོས་གཡོག་མོ་ལ་སོགས་ཅི་འདོད་སྤྲད།",
    "མི་འཁྱམས་ཉ་པས་བསྐུལ་བའི་བུ་མོ་ལ།",
    "རང་ཅག་ལྔ་བརྒྱ་རང་རང་ཕ་མིང་གིས།",
    "སྟེང་སློང་བོས་སྐྱེལ་བྱས་པའི་བཙུན་མོ་ཞེས།",
    "སྔར་གྱི་དུས་སུ་བཙུན་མོ་ལྔ་བརྒྱ་ཟེར།",
    "ཕྱིན་ཆད་གཡོག་མོའི་མཐོང་ཡང་བྱེད་པར་དཀའ།",
    "ཞེས་སྨྲས་པས་བཙུན་མོ་རྒན་པ་དེས་ཇི་ལྟར་ཟེར་བར་ཀུན་ཁ་འཆམས་ནས།",
    "དེའི་སང་ཉིན་བཙུན་མོ་ཁ་གོ་ཆོད་པ་བཞི་གསང་ཐབས་ཀྱིས་འགྲོ་བར་ཐག་བཅད།",
    "བདག་ཅག་བཙུན་མོའི་ཕྱོགས་སུ་སྙན་གསོན་དང་།",
    "ཡིད་འཕྲོག་ཅེས་པའི་མིང་བཏགས་བཙུན་མོར་འཛིན། ། དགྱེས་སྟོན་ལེགས་བསྐྱེད་སྔར་མ་གྲགས་སུ་མཛད།",
    "རྒྱན་གོས་གཡོག་མོ་ལ་སོགས་མང་དུ་སྩལ།",
    "མ་ཐར་ཟླ་བ་དུ་མ་སོང་ལགས་གཤིས།",
    "ལྟ་བ་ཉིན་རེ་བཞིན་དུ་ཇེ་མཐོར་འགྲོ།",
    "བཙུན་མོའི་འདོད་དོན་འདི་འདྲ་སྒྲུབ་མཛད་ན།",
    "ལྔ་བརྒྱས་བསྒྲུབ་པོ་ཐུགས་རྗེས་མྱུར་དུ་གཟིགས།",
    "ཞེས་ཞུས་པས་ཧ་རི་ན་རེ།",
