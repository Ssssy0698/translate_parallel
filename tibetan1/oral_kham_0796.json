    "འདུག་སྟེགས་དང་།",
    "རྩིག་པས་བསྐོར་བའི་གྲོང་ལ་ནི་ཇི་ཙམ་དུ་བ་ལང་དྲུག་དང་ལྡན་པའི་ཤིང་རྟ་སྨྱིག་མ་ཅན་གྱིའམ་བྱ་གག་སྤར་ནས་འདུག་པའི་ལམ་གྱིས་ཁྱབ་པའོ་ཞེས་བྱ་བ།",
    "བྱ་གག་སྤར་ནས་འདུག་པའི་ཞེས་བྱ་བ་ནི་ལམ་ཇི་ཙམ་ན་འདུག་པ་དེ་ནི་འདིའམ་སྔ་མ་གང་ཡང་རུང་བ་ཉེན་ཀོར་ཡིན་ནོ།",
    "བུ་དེ་རྣམས་ཇི་སྙེད་པ་དག་དང་འབྲེལ་པ་ཇི་སྙེད་པ་ཡོད་པ་རྣམས་དང་མནའ་མ་ཇི་སྙེད་པ་དེ་རྣམས་འཁོད་པ་ཐམས་ཅད་ལ་ཕྱིས་གནོན་བྱས་ཤིང་འདུག་པའམ།",
    "ཕྱིས་གནོན་མ་བྱས་ཤིང་འདུག་པར་གྱུར་པ་ཞེས་བྱ་བ་འདི་ལ་ཕྱིས་གནོན་མ་བྱས་ཤིང་འདུག་པར་ཡང་འགྱུར་ཏེ།",
    "ཐམས་ཅད་ལ་ཕྱིས་གནོན་མ་བྱས་ཤིང་འདུག་ལ་ཞེས་བྱ་བ་འདི་ལ་ཐམས་ཅད་ཕྱིས་གནོན་མ་བྱས་པར་འདུག་པར་ཡང་འགྱུར་ཏེ།",
    "སོ་སོར་ཉེ་བར་འདུག་པའི་མཚན་མ་འདི་གཉིས་ནི་གནས་ཀྱིས་ཞེས་བྱ་བའོ།",
    "གང་ཞིག་དུས་ཚིགས་གསུམ་པོ་དག་ལས་དུས་ཚིགས་གང་ཡང་རུང་བའི་དུས་ཚིགས་སུ་སྤྱད་པ་གང་ཡིན་པའོ་ཞེས་དུས་ཟད་པའི་ངོ་བོ་བརྗོད་པའོ།",
    "ལེགས་པར་སྦྱོར་བ་ནི་སྟན་འདི་ལ་འདུག་ཅེས་ཟེར་བ་ལ་དེའི་ཕྱིར་རོ་ཞེས་ཟེར་བ་དང་།",
    "གང་ཞིག་དུས་མཉམ་པ་ལ་དེ་བས་ན་དུས་མཉམ་དུ་འདིས་བརྩམས་པ་ལ་ཉེས་བྱས་མ་བྱས་པ་ཉིད་མ་ཡིན་ཏེ།",
    "སུ་ཞིག་དེ་ལ་རྗེས་སུ་འདོད་ཅིང་འདུག་པ་ཞེས་བྱ་བ་འམ།",
    "གནས་མལ་འདུག་པའི་ཕྱོགས་ནས་བརྩམས་ཏེ།",
    "འདུག་པའི་ཞེས་བྱ་བ་ནི་གནས་དེར་འདུག་པའི་སྟེ་མཐར་ཐུག་པ་ཡང་ཉེས་བྱས་འདི་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཅི་འགྲེང་སྟེ་བལྟ་བར་བྱ་བ་འམ་ཞེ་ན་མ་ཡིན་ཏེ་དེའི་ཕྱིར་འདུག་སྟེའོ།",
    "དེའི་ཕྱིར་འདུག་པ་ལའོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེའི་ཞེས་བྱ་བ་ནི་འདུག་པའོ།",
    "གང་ལ་དེ་དག་བྱེད་པ་པོ་དག་ཅེས་བྱ་བ་འདིར་འདུག་པའི་གནས་ལས་ཐོབ་པ་འཇུག་པ་བརྗོད་པར་བྱ་སྟེ།",
    "བདག་པོ་ཁྱིམ་པ་དང་ལྷན་ཅིག་འཇུག་པ་གང་ཡིན་པ་དེ་ནི་བདག་པོ་ཁྱིམ་པ་དང་བཅས་པའི་འདུག་གནས་སོ།",
    "འདུག་གནས་སོ་ཞེས་བྱ་བ་ནི་འདི་ལས་འདིར་བྱེད་པ་པོ་རྣམས་ཞེས་བྱ་བ་འདི་ལས་ཡོངས་སུ་གྱུར་པ་ལ་སོ་སོར་ཉེ་བར་གནས་པའོ།",
    "འདུག་གནས་གཅིག་ཏུ་ཞག་ལོན་པའི་དགེ་སློང་མི་ན་བས་བསོད་སྙོམས་གཅིག་བཟའ་བར་བྱའོ།",
    "དེའི་ཕྱིར་འདུག་པའོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "ཁ་ཟས་སྤངས་པ་དང་འདུག་པ་ཆོག་ཤེས་པའི་གནས་ལ་སྤངས་པ་གང་ཡིན་པ་དེ་ནི་སྤངས་པ་ཡིན་ཞེས་བྱ་བ་ནི་འདིར་བསྡུས་པའི་དོན་ཏོ།",
    "མཚམས་ཀྱི་ཕྱི་རོལ་དང་མི་འཐོབ་པའི་ཕྱོགས་དང་མདུན་མ་ཡིན་པ་ན་འདུག་པ་ལས་ལྷག་བོར་བྱ་བ་མི་འབྱུང་ངོ་ཞེས་བྱ་བ་ནི་མཚམས་ཀྱི་ཕྱི་རོལ་ན་གནས་པ་དང་།",
    "མདུན་མ་ཡིན་པ་ན་འདུག་པ་ལས་ཞེས་བྱ་བའི་བསྡུ་བའོ།",
    "མ་དྲིས་པར་ཟ་ན་གཞིའི་འདུག་གནས་པ་དག་ལ་ནི་ཉེས་བྱས་སུ་འགྱུར་ལ།",
    "དགེ་སློང་དག་ཁང་ཁྱིམ་གྱི་འདུག་གནས་སུ་ཟན་ཟ་ན།",
    "མ་དྲིས་པར་ཟོས་ན་ཁང་ཁྱིམ་གྱི་འདུག་གནས་པ་དག་ལ་ནི་ཉེས་བྱས་སུ་འགྱུར་ལ།",
    "དེར་ཡང་རང་བཞིན་ཅན་ཡིན་གྱི་བཅོས་པ་མ་ཡིན་ནོ།",
    "གང་ཞིག་འདུག་པ་ལ་མ་ལོན་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ནང་དུ་ཞག་མ་ལོན་པ་ཉིད་དུ་མི་འགྱུར་ཞེས་བྱ་བ་དེ་ལ་འདི་བསྟན་པའོ།",
    "སྣོད་ཕྱོགས་ན་འདུག་པ་དེས་ཀྱང་ས་དེར་བཙོས་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "སྣོད་རུང་བ་མ་ཡིན་པའི་ཕྱོགས་ན་འདུག་པ་ནི་དཔེར་ན་སར་གཞག་པའམ་རྒྱུད་ནས་སོ།",
    "འཚོད་པར་བྱེད་པ་པོ་དེ་ན་འདུག་པ་ཉིད་ཀྱིས་ནི་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི།",
    "དེས་དེར་ཁུ་བ་བྱིན་ལེན་བྱས་པ་ན་སྣུམ་བག་འཐོན་ཅིང་སྟེང་དུ་ཞག་ཉ་མིག་ཆགས་ཤིང་འདུག་ནས་དགེ་སློང་དེ་འགྱོད་པ་སྐྱེས་པ་དང་།",
    "བཞིན་བཟངས་མིག་ལམ་ན་མ་འདུག་ཤིག་ཅེས་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེ་སྐད་བརྗོད་ཀྱང་མིག་ལམ་ན་འདུག་ན་དེའི་ཚེ་ཇི་ལྟར་བྱ་ཞེ་ན།",
    "དེའི་ཕྱིར་མི་འདུག་ན་དབྱུག་གུ་སྐམ་ཁས་དལ་བུ་དལ་བུས་རྫ་མའམ་བུམ་པར་བཅུག་སྟེ་ཁ་བཅད་ནས་བུ་ག་བཏོད་དེ་བསལ་བར་བྱའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ཅི་དེ་གཉིས་གནས་གང་ན་འདུག་ཀྱང་རུང་ངམ་ཞེ་ན།",
    "དེའི་ཕྱིར་མངོན་སུམ་དུ་བརྣགས་པས་འདུག་ནའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "ན་སྨད་པ་དེ་བས་ན་མཐར་ཐུག་པའི་རྩེ་གཅིག་པ་ཉིད་ནི་འདིར་གནས་ཀྱི་ཚིག་དང་སྔ་མ་ནི་འདུག་པའི་ཚིག་གོ།",
    "སྟན་ལ་གནས་ཤིང་འདུག་པའི་ཉེས་པ་འདི་ནི་གཞན་ཏེ་འདུག་པ་ལ་ཡང་སྔ་མའོ་ཞེས་རིག་པར་བྱའོ།",
    "དེའི་ཕྱིར་དེ་དག་མེད་པར་དེར་ཉིན་མཚན་གཉིས་ལས་ལྷག་པར་འདུག་ནའོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "དེ་ལས་གང་དུ་ལྷག་པར་འདུག་ནའོ་ཞེས་བྱ་བ་འདི་ནི་ཉིན་མཚན་དག་གོ།",
    "དགོས་པ་མེད་ན་སྔ་མ་ལ་ཡང་ངོ་ཞེས་བྱ་བ་ནི་རིགས་པའི་ཚུལ་གྱིས་དགོས་པ་མེད་ན་སྔ་མ་ཡང་ཉིན་ཞག་གསུམ་པར་འདུག་པ་ལས་གནས་པ་གང་ཡིན་པ་དེ་ལ་ཡང་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཟླ་བའི་རྣམ་པ་ལྟ་བུ་ཞེས་བྱ་བ་ནི་མདུན་དུ་ཡང་རུ་དངར་རྒྱབ་ཏུ་ཡང་རུ་དངར་གློར་ཡང་རུ་དངར་ལ་དབུས་ན་རྒྱལ་པོ་འདུག་པའོ།",
    "ཤིང་རྟའི་དབྱིབས་ལྟ་བུ་ཞེས་བྱ་བ་ནི་མདུན་དུ་ཡང་རུ་དངར་གློར་ཡང་རུ་དངར་ལ་རྒྱབ་ན་རྒྱལ་པོ་འདུག་པའོ།",
    "གཡུལ་ངོའི་རྣམ་པ་ལྟ་བུ་ཞེས་བྱ་བ་ནི་མདུན་དུ་ཡང་རུ་དངར་རྒྱབ་དུ་ཏུ་ཡང་རུ་དངར་ལ་དབུས་ན་རྒྱལ་པོ་འདུག་པའོ།",
    "འདུག་པ་ལ་ནི་སྐྱོན་མེད་པའི་ཕྱིར་དང་ཉམས་པ་མེད་པའི་ཕྱིར་ཏེ།",
    "དེ་བས་ན་འདུག་པ་ལ་བསྒྲུབ་པས་སོ།",
    "འདི་ལ་གཅིག་པ་ཉིད་ཀྱི་ཕྱིར་འདུག་པ་ཉིད་དག་ལ་འདིར་ཐོབ་པ་ལ་བསྡུས་པ་འདི་ཡིན་ནོ།",
    "གནས་སྐབས་འདི་ལ་འདུག་པ་འདིའི་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བ་ཉིད་དོ།",
    "འདུག་པའི་དབུས་སུ་གནས་པ་ལ་ནི་འཁོར་གྱི་དབུས་ཀྱི་དངོས་པོ་ཉིད་ལ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེ་གཉིས་གནས་གང་ལ་ཡང་རུང་བ་ན་འདུག་པ་བྱེད་པ་པོ་ཡིན་ནམ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "གཙུག་ལག་ཁང་དང་དེའི་ཉེ་འཁོར་ན་འདུག་པ་ནི་མ་གཏོགས་ཏེ་ཞེས་བྱ་བ་འདིའི་དོན་ཏོ།",
    "དེ་ཡལ་བར་མི་དོར་ཞེས་བྱ་བ་ནི་གཙུག་ལག་ཁང་ན་འདུག་པའམ།",
    "འདིར་གཞུང་ནི་ཞུ་བ་ཁ་ཅིག་ལས་དགེ་སློང་གསེར་གྱི་སྟེགས་བུ་ལ་འདུག་ན་ཉེས་བྱས་སོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདུག་པའི་ཕྱིར་གནས་མལ་ཡང་ངོ་ཞེས་བྱ་བ་ལ།",
    "དེ་རྣམས་ལ་འདུག་པར་མི་བྱེད་ཅིང་།",
    "ཀྱང་ངོ་ཞེས་བྱ་བའི་སྒྲ་ནི་མི་རྟག་པས་ཉེན་པར་གྱུར་པ་ཡིད་ལ་བྱེད་པས་འདུག་པར་བྱའོ་ཞེས་བྱ་བའི་རྗེས་སྙེག་པའི་ཕྱིར་རོ་སྙམ་དུ་ཤེས་པར་བྱས་ནས་ཞེས་བྱ་བ་ནི་ཁྱིམ་པའི་ཡིན་ནོ་སྙམ་དུ་ཤེས་པར་བྱས་ནས་སོ།",
    "གཞན་གྱི་ཚེ་ཞེས་བྱ་བ་ནི་བསྣུན་པའི་དུས་ཀྱི་འོག་དུས་གཞན་གྱི་ཚེ་ཤི་ནའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བས་ན་འདུག་པ་ལྟེ་བ་ཙམ་དུ་སོན་པ་ལ་དངོས་གཞིའི་བྱེད་པ་ཉིད་ནི་མ་ཡིན་ནོ།",
    "དེ་བྱེད་པ་ལ་ཉེ་བར་བསྐོར་ཏེ་འདུག་པར་མི་བྱའོ།",
    "འགལ་བར་བྱེད་པའོ་ཞེས་བྱ་བ་ནི་དེ་ལས་བཟློག་སྟེ་མི་འདུག་པ་དང་མི་འགྲོ་བ་དང་གནས་མལ་མི་ལེན་པ་དང་གཙུག་ལག་ཁང་མི་ལེན་པ་དང་མི་སྨྲ་བའོ།",
    "མལ་སྟན་ཆེན་པོ་ལ་འདུག་པ་འམ་ཉལ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "འདུག་པ་བཀག་པར་གཏོགས་པའོ།",
    "ཁྲི་རྩེག་མའི་སྟེང་དུ་འདུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "ཞེས་སོགས་བཀོད་གནང་འདུག་པས།",
    "ཀར་འབྲུག་གཉིས་སུ་གདའ་ནའང་།",
    "རང་སེམས་མངོན་དུ་གྱུར་ཙ་ན།",
    "གྲངས་མེད་གསུམ་ཡང་བརྫུན་པོར་གདའ།",
    "ཀཱ་བློ་གཏད་ཅིག་འདུག་གམ་མི་འདུག་སོམས།",
    "ཚིག་འབྲུ་གཅིག་ལ་འགྲེལ་མི་ཐུབ་པའི་གནས་སྟངས་ཀྱིས་ལན་བཏབ་མི་འདུག་གམ།",
    "རང་དང་མཉམ་པ་དག་དང་རང་ལས་ཁྱད་པར་འཕགས་པ་ཡི་ཕ་རོལ་པོ་ནུས་པ་དང་ལྡན་པ་རྣམས་ལ་བལྟ་ཞིང་བསྡུར་བར་བྱ་སྟེ།",
    "དེ་ལྟ་བུའི་སྒྲ་མཉན་པ་ཚིག་རྩུབ་པོ་ཡིད་དུ་མི་འོང་བ་དེ་ཡང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "རྒྱུ་ཚུལ་མིན་ཡིད་བྱེད་ཀྱི་རྟོག་པ་དེ་རྣམས་མེད་པར་འབྲས་བུ་འདོད་ཆགས་ཞེ་སྡང་ལ་སོགས་པ་རང་རང་ལ་ངོ་བོ་ཡོད་པ་ཞིག་གམ།",
    "སྲིད་པ་ལ་ཞེན་པ་ཅན་ནི་སྲིད་པ་འདི་ནས་ངེས་པར་འབྱུང་རང་བཞིན་འོད་གསལ་ཕྱག་རྒྱ་ཆེན་པོའི་ལམ་གྱི་ཆ་ལགཔའང་བྱ་བར་ནི་ཧ་ཅང་དཀའ་བ་ཡིན།",
    "དངོས་པོ་འགའ་ལ་ཡང་རང་བཞིན་བཅས་པ་ཞིག་རྙེད་པར་མི་ནུས་ཏེ།",
    "རྒྱུ་དང་རྐྱེན་གྱི་དངོས་པོ་ནི་ཀུན་ལ་མ་ཚོགས་བཞིན་དུ་འདུ་བ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་པས།",
    "དེ་ནི་གསུམ་ཆ་ལའང་རང་བཞིན་གྱིས་ཡོད་པ་ནི་མ་ཡིན་ནོ།",
    "དངོས་སྨྲའི་ཕྱོགས་ལ་གནོད་པ་ཡོད་ཅིང་སྒྲུབ་བྱེད་མེད་པར་བསྟན་པ་དང་རང་བཞིན་འོད་གསལ་ཕྱག་རྒྱ་ཆེན་པོའི་ལམ་གྱི་ཆ་ལགགཉིས།",
    "དེས་ན་གཏན་ཚིགས་དེ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པ་ཞིག་ཅི་ཡང་མེད་དོ།",
    "ཟུང་འཇུག་ཀྱང་རང་བཞིན་མཉམ་པ་ཉིད་དུ་གཏན་ལ་ཕབ་པས་གཉིས་མིན་གྱི་སྤྲོས་མཐའ་ལས་གྲོལ་བ་ཞེས།",
    "ཀླན་ཀ་རིགས་པ་སྨྲ་བ་གཟུར་གནས་སུས་རང་བཞིན་འོད་གསལ་ཕྱག་རྒྱ་ཆེན་པོའི་ལམ་གྱི་ཆ་ལགཀྱང་བརྗོད་པར་ནུས་པ་མ་ཡིན་ཏེ་དངོས་པོ་སྟོབས་ཤུགས་ཀྱི་རིགས་པས་ཡུལ་ལམ་ཤེས་བྱའི་གནས་ལུགས་དང་འདུག་ཚུལ་དངོས་དང་མཐུན་པར་གཏན་ལ་དབབ་པའི་ཕྱིར།",
    "རྗེ་འདི་ཉིད་ཀྱི་བསླབ་སྦྱངས་དང་ཕྲིན་ལས་སྐྱོང་བའི་དུས་དེ་ཙ་ན།",
    "དེ་འདྲ་དེ་ནི་བཀའ་ཐོག་མཐའ་གང་ན་འདུག་ཀྱང་བདག་བཟློག་པའི་འཁོར་ལོ་ཞེས་བྱའོ།",
    "ཞེས་པ་རང་ལུགས་སུ་ཡང་ཁས་ལེན་པར་འདུག་པས་སོ་སྙམ་དུ་བསམ་པ་ཡིན་ལ།",
    "ཐམས་ཅད་ཀྱང་རང་བྱུང་ཡེ་ཤེས་ཉིད་ཡིན་བས་དུས་གསུམ་རྒྱལ་བ་དང་ཁམས་གསུམ་པ་རིལཔ་དེ་ཉིད་དུ་བ་རྫུ་། འདུས་པས་ལམ་ཆེན་པོར་སྟོན་པའོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་བའི་ལྟ་བ་གལ་བ་བསལ་བའི་ཕྱིར།",
    "རྐྱེན་མ་ཚང་བས་དམིགས་ཐམས་ཅད་བྲལ་བ་ཞེས་བྱ་བ་ཡང་གོམས་པའི་འདུ་ཤེས་སྒྲས་མུན་པའི་མཐར་འདུག་པས་ཟུག་རྔུར་འགྱུར་པ་ཡར་ལས་དད་འབྲས་བུ་ལ་སོགས་པ་ཀུན་ཀྱིམཆོག་ཏུ་གྱུར་པ་ནི།",
    "ཡང་རང་བཞིན་ཆ་འཕྲད་གང་འཛིན་པ།",
    "ཐམཾས་ཅད་ཀྱང་རང་རིག་པ་ཉིད་རང་སྣང་བའི་ཕྱིར།",
    "ལྡང་ན་ཡང་ངོ་བོ་ཉིད་དུ་ཤེས་པ་ཐམས་ཅད་ཀྱང་རང་ཉིད་དུ་གསལ་བ་ནི་གསུམ་པའི་བདེ་བ་སྟེ།",
    "ཡེ་ཤེས་ལྔ་དང་རང་བྱུང་ཡེ་ཤེས་ཀྱིས་ཀུན་ལ་རྒྱས་བཏབ་པསཨུ་མཐའམི་རྙེད་དེ་སྐུར་ཤར་བའོ།་།",
    "དད་དང་རང་བཞིན་མི་འཐུད་པ་སྒྲུབ་པའི་རིགས་པས་ལྟོས་པའི་ཕྱིར་ཕན་ཚུན་རྒྱུ་དང་",
    "དེ་ཉིད་ཅིར་ཡང་རང་སྣང་བས་དོན་བྱེད་པ་ནི་ཡབ་ཐབས་ཀྱི་ངོ་བོ་ཉིད་དོ།",
    "རང་བྱུང་ཡེ་ཤེས་གཏིང་ཕྱིན་པརམཇལ་བས་འགྲོ་ཉལ་འདུག་སྡོད་ལོངས་སྤྱོད་དུ་སྤྱོད་པ་རིལ་ལ་སྤྱད་ཀྱང་གོལ་བ་མེད་དེ་ཡང་དག་པའིམཛད་སྤྱོད་ཉིད་དུ་སྨིན་ཟིན་ཏོ།",
    "ངང་དང་རང་བཞིན་དང་བདག་ཉིད་ཆེན་པའི་ཕྱིར།",
    "རང་ཉམ་དུ་འདུག་གོ་ཞེ་ན།",
    "ངང་དང་རང་བཞིན་དང་བདག་ཉིད་ཆེན་པོའི་གཏན་ཚིགས་དང་།་",
    "བདེར་འདུག་རིགས་པ་མ་ཡིན་ཕྱིར།",
    "བློ་ཡང་རབ་ཏུགྱུརཔ་རྣམས་དོན་དང་མཐུན་པར་འདུག་པ་ནི་གནས་པ་ཞེས་བྱའོ།",
    "སྐྱེ་བ་མེད་ཅིང་འགག་མེད་གཡུང་དྲུང་རང་བཞིན་གནས།",
    "གནས་ལ་མཐོ་དམན་འདུག་པར་ཁྱེད་ཀྱིམཐོང་ངམ་ཅི་།",
    "ཨ་ར་པ་ཙ་ན་ཞེས་བྱ་བ་སྟེ་འདོད་པ་ཐམས་ཅད་ཐོབ་བོ།",
    "གདོད་ནས་དག་ཅིང་རང་བྱུང་བ།",
    "རོ་ཙ་ནི་རོ་ཙ་ནི།",
    "བི་ནཱ་ཤ་ནི་ཞེས་ཀྱང་འདུག་མཆན།",
    "ཨོཾ་ལོ་ཙ་ནེ་བ་སུ་དེ་སྭཱ་ཧཱ།",
    "ཨོཾ་བེ་རོ་ཙ་ན་ཧཱུྃ་ཨཀྵོ་བྷྱ།",
    "འདི་ལ་ཡི་གེ་བརྒྱ་དང་བཅུ་བདུན་འདུག་གོ།",
    "ཏིལ་མེ་ཆུར་དོར་བ་རྣམས་རྒྱས་སྤྲོས་སུ་འདུག་ཀྱང་།",
    "སྤྱན་འབྱེད་སྔགས་རྗེས་རབ་གནས་རྒྱུད་ན་སྔགས་འདི་འདུག་དཔྱད།",
    "སྤྱིར་ནི་ལོ་ཟླ་ཞག་དུས་དང་།",
    "ཉིན་ཞག་དུས་ཀྱི་ལོངས་སྤྱོད་དོ།",
    "གསལ་ཞིང་རང་སྒྲ་འོད་འབར་དགེ།",
    "དེས་འགྲེ་ལོ་ཟླ་ཞག་དུས་དང་།",
    "ཙ་ནི་ཤིའམ་ནུབ་པར་འདོད།",
    "རྒྱུ་སྐར་རང་རང་ཐད་ཀ་རུ།",
    "དེ་ལས་སྐྱེས་བུ་རང་རང་ལ།",
    "ཡང་ན་ཟ་ཛར་བསྡུ་ཞེས་འདུག།",
    "འཇམ་ལྟ་བུར་མ་ལ་བསྡུ་ཟེར་བ་འདུག་ཀྱང་དཔྱད་དགོས།",
    "ཁྱད་པར་བྱ་བྱེད་འགྲོ་འདུག་འཛེམ།",
    "ཡིད་ཅན་སྐྱེ་བོར་ཆང་སྦྱིན་བྱ། གར་འདུག་ཡུལ་གྱི་མིང་སྐར་དང་།",
    "རྒྱལ་རྗེ་དམངས་རིགས་རང་རང་དང་།",
    "ཕལ་པའང་ཁྱིམ་ཐབས་ཕོག་དུས་དང་།",
    "རགས་པ་ཡིན་ཀྱང་བྱ་སླ་བའི་ཕྱིར་ཡིན་ནོ་སྙམ་དུའང་མི་སེམས་པར་རྣམ་དག་ཏུ་འཛིན་པ་ཤ་སྟག་ཏུ་འདུག་པས་སོ།",
    "དུས་སྦྱོར་རང་རང་འཆར་ཚད་གང་།",
    "མིག་བགོས་རང་རང་ཕྱེད་པའི་ཚད།",
    "གཟའ་རྣམས་རང་རང་སྐྱེས་ཁྱིམ་ལ།",
    "རང་རང་ཞིང་བདག་གཟའ་ཞུགས་པའི།",
