    "རྟག་པར་ཕྱིན་ཅི་ལོག་སྤང་བའི་ཐབས་བསྟན་པ་སྟེ།",
    "ལུས་དོན་མ་ཡིན་པ་འདྲེན་པ་འདིས་ཅི་ཞིག་བྱ་ཞེས་དེ་ལ་བརྙས་པ་ཐོབ་པར་འགྱུར་བ་དེ་ལ་བརྙས་པ་ཡོངས་སུ་སྤང་པའི་ཕྱིར།",
    "སྨྲས་པ་གལ་ཏེ་ལུས་བསང་བར་བྱས་པ་ཡིན་ན་ནི།",
    "བརྗོད་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་ལུས་སྡུག་བསྔལ་ཐམས་ཅད་ཀྱི་སྣོད་འདི་ལ་གུས་པར་མི་བྱ་སྟེ།",
    "དེ་ནས་རིང་པོ་མ་ལོན་པར་དེ་འགྲོ་བའི་མདུན་ན་ཤ་ཟ་མཆོག་ཏུ་མི་སྡུག་པ་ཞིག་གནས་པར་གྱུར་ཏོ།",
    "དེས་ཀྱང་དེ་ཁོ་ན་ལྟར་བྱས་སོ།",
    "དེ་ལྟར་སྡུག་བསྔལ་བ་དང་མི་རྟག་པར་བལྟས་པས་ལུས་ལ་ལྷག་པར་ཆགས་པ་བཏང་སྟེ།",
    "དེ་མེད་པས་སྡུག་བསྔལ་ཐམས་ཅད་མེད་པར་འགྱུར་རོ།",
    "བདེ་བ་ཕལ་ཆེ་བ་ཉིད་ཀྱི་ཕྱིར་སྡུག་བསྔལ་ལ་གཅིག་ཏུ་འཇིགས་པར་མི་རིགས་སོ་ཞེའོ།",
    "སྡུག་བསྔལ་ལ་ནི་འཇིགས་པར་བྱ་དགོས་པ་ཁོ་ན་སྟེ།",
    "དེའི་ཕྱིར་སྡུག་བསྔལ་ཆེན་པོས་ཟིལ་གྱིས་མནན་པའི་བདེ་བ་ཡོད་དུ་ཟིན་ཀྱང་སྐྱོབ་པར་མི་བྱེད་དོ།",
    "གལ་ཏེ་བདེ་བ་ཤིན་ཏུ་ཆེ་བ་ཞིག་ཡོད་པར་འགྱུར་ན་ནི་དེ་སྡུག་བསྔལ་གྱིས་ཟིལ་གྱིས་གནོན་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལྟ་ན་ཡང་སྡུག་བསྔལ་དང་རོ་གཅིག་པའི་ལུས་ལ་བདེ་བ་བསྒྲུབ་པར་མི་ནུས་པ་ཉིད་ཀྱི་ཕྱིར།",
    "རང་བཞིན་ནི་སྤང་པར་མི་ནུས་སོ།",
    "ཁྲོན་པར་ཡིབ་པ་ལ་གླང་པོ་ཆེ་བཞིན་ཏེ།",
    "འགའ་ཞིག་གླང་པོ་ཆེ་མྱོས་ཚབས་ཆེ་བ་ལྕགས་ཀྱུ་མེད་པས་ཇི་ལྟ་ཇི་ལྟར་བདས་པ་དང་ཁྲོན་པར་གབ་པར་བྱེད་ཅིང་ཁྲོན་པའི་ཕྱེད་དུ་ཕྱིན་ནས་བདག་ཐར་བར་སེམས་ཏེ།",
    "འདི་ན་ཕོངས་པར་གྱུར་པའི་སྐྱེས་བུ་ནི།",
    "མི་ཉེ་བ་ཡང་ཤིན་ཏུ་འབད་པས་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་པ་ཉིད་ཀྱི་ཕྱིར་འདོད་བཞིན་པ་ན་དེ་རྙེད་ཀྱི།",
    "འཇིག་རྟེན་ནི་ཆགས་པས་རྙེད་པར་དཀའ་ཞིང་གཞན་ལ་རག་ལས་པའི་བདེ་བ་ལ་གུས་ཀྱི།",
    "བདེ་ཉིད་རྙེད་པར་དཀའ་ཕྱིར་རོ།",
    "དེ་དག་གཉིས་ནི་མཚུངས་པར་སྣང་།",
    "དེའི་ཕྱིར་དེ་གཉིས་བརྟེན་པ་ན་དེ་དག་ཀྱང་མཚུངས་པར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་དེ་ལྟར་ལུས་སྡུག་བསྔལ་གྱི་བདག་ཉིད་ཅན་མ་ཡིན་ནོ་སྙམ་ན་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ནས་འཇིགས་པས་དེ་ལ་ཡིད་མི་བདེ་བ་སྐྱེས་པར་གྱུར་ཏོ།",
    "ཡང་མི་གཉིས་པ་དམན་པ་ཞིག་རྒྱལ་པོ་དེས་ཆོགས་ཤིག་ཅེས་གླང་པོ་ཆེ་དེ་ལ་བསྐྱོན་པ་དང་དེས་མ་ནུས་པར་གྱུར་ཏེ།",
    "དེ་ལ་གཅིག་ལ་ཡིད་ཀྱི་སྡུག་བསྔལ་ཡོད་པར་གྱུར་ལ།",
    "དེ་ལྟར་ཡོངས་སུ་རྟོག་པར་བྱེད་པ་འདི་ལ་ཡིད་ཀྱི་བདེ་བ་འབྱུང་ལ།",
    "བདེ་བ་འབྱོར་དུ་ཟིན་ཀྱང་གཞན་གྱིས་གནོད་པར་དོགས་པ་རྣམས་ལ་ལོངས་སྤྱོད་རྒྱུན་ཆད་པའི་རྟོག་པས་ཕྱིས་ཡིད་ཀྱི་བདེ་བ་དེ་ལྡོག་པར་འགྱུར་ཏེ།",
    "གང་ཞིག་སྡུག་བསྔལ་གྱི་གནོད་པའི་མཐུ་འགོག་པར་བྱེད་པའི་རྟོག་པ་ནི་འགའ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ནས་རོ་གཅིག་སྟོན་པར་གྱུར་ཏོ།",
    "དེའི་ཕྱིར་སྡུག་བསྔལ་དང་ལྡན་པར་འགྱུར་རོ།",
    "དེ་ལ་བདེ་བ་ཡོད་པར་སེམས།",
    "གལ་ཏེ་བདེ་བ་ཞེས་བྱ་བ་ཡོད་པར་མི་འགྱུར་ན་ནི།",
    "བདེ་བ་ཇི་ལྟ་ཇི་ལྟར་འཕེལ་བར་འགྱུར་བ་ནི་དེ་ལྟ་དེ་ལྟར་འཕེལ་བཞིན་པ་དེ་ལས་བཟློག་པར་མཐོང་ངོ།",
    "གལ་ཏེ་རང་བཞིན་གྱིས་བདེ་བར་འགྱུར་ན་ནི་དེ་ལས་བཟློག་པ་ཡོད་པར་མི་འགྱུར་བ་ཞིག་ན།",
    "ལུས་དང་སེམས་ཆེས་ཤིན་ཏུ་ཉེ་བར་འཇོམས་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་བརྒྱ་བྱིན་གྱི་སྟན་ཕྱེད་འདོད་པས་འོག་ཏུ་ལྷུང་བའི་ཕྱིར་ང་ལས་ནུའི་བདེ་བ་གཞལ་དུ་མེད་པར་འཕེལ་བཞིན་པ་ལ་ཡང་བཟློག་པ་མཐོང་བ་དེ་ལྟར་སྡུག་བསྔལ་ལ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་དེ་ལྟར་ན་སྡུག་བསྔལ་ཆེས་སྟོབས་དང་ལྡན་པས་ཡང་དག་པར་མནན་པའི་ཕྱིར་ལུས་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཁོ་ན་ཡིན་པས་བདེ་བ་མེད་དེ།",
    "རྒྱལ་པོ་མྱ་ངན་མེད་ལ་བཙོན་རྭ་ཉམས་དགའ་ཞེས་བྱ་བ་ཞིག་ཡོད་པར་གྱུར་ལ།",
    "དེ་བཞིན་དུ་རྐྱེན་དག་ཡོད་བཞིན་དུ་བདེ་བ་ཁོ་ན་བཟློག་པར་འགྱུར་གྱི།",
    "ལྷ་སྦྱིན་བདེ་བ་དང་ལྡན་ནོ།",
    "ཞེས་བྱ་བའི་བརྗོད་པར་མི་འགྱུར་བ་ཞིག་ན།",
    "དེའི་ཕྱིར་དེ་ལྟར་ན་དུས་གསུམ་ལ་ཁྱབ་པའི་འཆི་བས་འཆི་བཞིན་པ་ན་བདེ་བ་དང་ལྡན་པར་འགྱུར་རོ་ཞེས་རྣམ་པ་ཐམས་ཅད་དུ་མི་རིགས་སོ།",
    "ཆང་འཐུང་བ་ལ་གོམས་པར་བྱས་སོ།",
    "གཞན་ཡང་དེ་ལས་གཞན་པ་སྡུག་བསྔལ་གྱི་རྒྱུ་བར་མེད་པར་ལྷགས་པ་ལས་ཕལ་ཆེ་བ་ཉིད་ཀྱི་ཕྱིར་ཡང་སྡུག་བསྔལ་ལ་བདེ་བའི་འདུ་ཤེས་མི་རིགས་སོ།",
    "སྡུག་བསྔལ་གྱི་རྒྱུ་ལུས་ལ་གནོད་པར་བྱེད་པ་བཀྲེས་པ་དང་།",
    "བྱ་བར་ཇི་ལྟ་བུར་ན་རིགས་པར་འགྱུར།",
    "གལ་ཏེ་མེའི་ཁམས་མེད་པར་གྱུར་ན་ནི།",
    "ཆུའི་ཁམས་ནི་མེའི་ཁམས་ལ་གནོད་པར་བྱ་བའི་ཕྱིར་ཡིན་ལ།",
    "མེའི་ཁམས་ཀྱང་ཆུའི་ཁམས་བསྐམ་པར་བྱ་བའི་ཕྱིར་རབ་ཏུ་ཞུགས་སོ།",
