    "ལྟ་བ་ལ་ཆགས་པར་འགྱུར་བའི་རྩོད་པ་ཡང་ལྡོག་གོ།",
    "གནས་བརྟེན་པར་བྱ་བ་རྒྱུ་འགའ་ཞིག་རྙེད་ནས་འགའ་ཞིག་ལ་འཛིན་ཏོ།",
    "གལ་ཏེ་དངོས་པོ་དེ་ཡིད་དང་མཐུན་པར་གནས་ན་ནི་དེའི་ཚེ་དེ་ལ་རྗེས་སུ་ཆགས་པ་བཟློག་པར་དཀའ་བར་འགྱུར་རོ།",
    "བྱིས་པ་བདེན་པར་འདུ་ཤེས་པས།",
    "ཡུལ་གྱི་གཟེབ་ལ་ཐོགས་པར་འགྱུར།",
    "ཆགས་པ་མེད་ན་དངོས་པོ་རྣམས་ལ་དེའི་བདག་ཉིད་དུ་ཆགས་ཤིང་འཇུག་པ་མེད་པས་ཡུལ་གྱི་འདམ་ལ་ཆགས་པར་མི་འགྱུར་ཏེ།",
    "བློ་མཆོག་དག་ནི་རྣམ་པར་གྲོལ།",
    "དེ་ཡང་ཉེས་པར་སེམས་པ་སེམས་པ་དང་།",
    "ཉེས་པར་སྨྲ་བ་སྨྲ་བ་དང་།",
    "དེ་ལྟར་བྱིས་པ་དེ་དག་མི་གཙང་བཞིན་དུ་གཟུགས་ལ་ཆགས་བས་རྒྱུས་ན་ཚསོ།",
    "བར་མ་ནི་གང་དག་མི་གཙང་བ་ལ་ཇི་ལྟར་གནས་པ་བཞིན་དུ་སྨོད་ཅིང་གཟུགས་ལ་སྡུག་བསྔལ་བརྒྱ་ཕྲག་དུ་མ་བསྩགས་པར་མཐོང་སྟེ།",
    "ན་གཟུགས་ལ་འདོད་ཆགས་དང་བྲལ་བར་གྱུར་ལམ་ནས་བསམ་གཏན་དང་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་འཐོབ་སྟེརྣམའདོད་པའི་ཁམས་སའ་ལས་ཤིན་ཏུ་འདས་པ་དེ་དག་ནི་བར་མའོཟླ་བ་ས་ཅུ་གང་དག་གཟུགས་ཀྱང་ངོ་བོ་ཉིད་ཀྱིས་མེད་དེ།",
    "དོན་དེ་ཉིད་རྣམ་པར་དབྱེ་བ་བསྟན་པའི་ཕྱིར།",
    "སྡུག་ཆེས་པ་ལ་ཆགས་པར་འགྱུར།",
    "སྒྱུ་མའི་སྐྱེས་བུ་ལྟར་དབེན་པར།",
    "མཐོང་ན་བ་བས་མྱ་ངན་འདས་པར་འགྱུར།",
    "སྒྱུ་མའི་སྐྱེས་བུ་བཞིན་དུ་འགྲོ་བ་དབེན་ཞིང་སྟོང་སྟེམཆནམྱ་ངན་ལས་འདས་པ་མཐོང་ནས་གང་དག་མྱ་ངན་ལས་འདས་པར་གྱུར་པ་བ་དེ་དག་ནི་བློའི་མཆོག་དང་ལྡན་པ་སྟེ།",
    "བྱིས་པ་རྣམས་ནི་འདོད་པ་ལ་ཆགས་པར་ཤེས་པར་བྱའོ།",
    "སྒྱུ་མའི་སྐྱེས་བུ་བཞིན་དུ་འགྲོ་བ་དབེན་པར་མཐོང་ནས་མྱ་ངན་ལས་འདས་པ་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "དེ་གཉིས་ལ་ཡོངས་སུ་མི་རྟོག་པའི་ཕྱིར་རྣམ་པར་མི་རྟོག་པ་ཡིན་ནོ།",
    "བྱིས་པ་རྣམས་ནི་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པས་མྱ་ངན་ལས་འདས་པར་མི་འཐད་དོ།",
    "མི་ཆགས་པ་ཡོད་པར་འགྱུར།",
    "དམིགས་པ་མེད་པས་ངེས་པར་མྱ་ངན་ལས་འདའོ།",
    "དེའི་ཕྱིར་དེ་ལྟར་རྣམ་པར་དཔྱད་ན།",
    "གང་དག་རྣམ་པར་དབེན་པ་ལ།",
    "དམ་པ་གཉིས་ནི་ཐོབ་པར་ཤོག།",
    "རིགས་པ་དྲུག་ཅུ་པ་འདི་རྣམ་པར་ཕྱེ།",
    "མུ་སྟེགས་ཅན་རྟོག་གེ་ངན་པར་སྨྲ་བའི་ཚོགས་ཐམས་ཅད་ཀྱི་མུན་པ་མང་པོ་རྣམ་པར་འཇོམས་པ།",
    "དེ་བཞིན་གཤེགས་པ་བཀའ་མཐའ་གཉིས་རྣམ་པར་སྤངས་པའི་ནམ་མཁའི་དཀྱིལ་ཐོས་པ་དང་བསམ་པ་ལས་བྱུང་བའི་ཡེ་ཤེས་ཀྱིས་སྣང་བར་གྱུར་ན།",
    "གནས་པ་ཡང་དག་པ་མ་ཡིན་པའི་ཕྱིན་ཅི་ལོག་རྣམ་པ་སྣ་ཚོགས་ཀྱི་ཚ་བས་གདུངས་བའི་འགྲོ་བ་མཐའ་དག་བསིལ་བར་མཛད་པའི་ཟླ་བ་འོད་ཟེར་དྲི་མ་མེད་པ་དཔག་ཏུ་མེད་པར་གྲགས་པ་ཡིན་ཏེ།",
    "རྣམ་པར་ཕྱེ་ནས་རིམ་གྱིས་དོན་དམ་སྟོན་གྱུར་པ།",
    "གང་དག་སྡུག་བསྔལ་བ་དེ་དག་ནི་རྟག་ཏུ་སྐྱོ་བ་སྐྱེད་པར་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་མི་གཙང་བའོ།",
    "དེ་འདི་ད་ལྟའི་སྙན་དངགས་མཁན་གྱིས་རྣམ་གཉིས་བྱས།",
    "བསྟན་བཅོས་བཞི་བརྒྱ་པ་དེ་ནི་ད་ལྟའི་སྙན་ཇི་ལྟར་བཀོད་པ་ཕྱེ་ནས་རྣམ་པ་གཉིས་སུ་བྱས་ཏེ།",
    "དེ་ལྟར་བྱས་དང་བཀོད་པ་སྔ་མ་ཡང་ཡོངས་སུ་བསྐྱངས་པར་འགྱུར་ལ།",
    "དེས་ཕན་གདགས་པར་བྱ་བ་རྣམས་ལ་ཕན་བཏགས་པར་ཡང་འགྱུར་བསྟན་བཅོས་ཀྱི་དོན་བརྗོད་པར་འདོད་པ་མཐའ་དག་བླངས་པས་རང་དང་གཞན་གྱི་དོན་ཏེ།",
    "ཡང་དག་པར་འགྲུབ་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་མཚན་ཉིད་སོ་སོར་བྱས་ནས་སྨྲ་བར་བྱེད་པ་དེའི་གཞུང་ལུགས་སོ་སོར་སྨྲ་བ་ཤིན་ཏུ་བབ་ཅོལ་ཡིན་ཏེ།",
    "བཞི་སྒྲ་མི་མངོན་བྱས་པ་དང་།",
    "དེ་ལ་ཕུང་པོ་ལྔ་རྒྱུར་བྱས་ནས་གདགས་པའི་གང་ཟག་ནི་སྐྱེ་བའི་གནས་དེ་དང་དེར་འཇིག་ཅིང་རབ་ཏུ་འཇིག་པས་འཇིག་རྟེན་ནོ།",
    "དེས་བསྟན་པ་ལས་སྐྱེས་པ་འཇིག་རྟེན་ལས་འདས་པའི་ལམ་གྱི་འོད་ཀྱིས་སེམས་ཀྱི་རྒྱུད་སྦྱང་བར་བྱས་ཤིང་།",
    "གཞན་རབ་ཏུ་སྦྱོར་བ་པོ་མ་ཡིན་པ་ཉིད་ཀྱིས་ན་རང་ཉིད་ཀྱིས་ཆད་པ་གཅོད་པར་བྱེད་པ།",
    "རལ་གྲི་རྣོན་པོ་གདེངས་པ་ལྟར་སྲོག་གཅོད་པར་བྱ་བའི་ཕྱིར་ཞུགས་པ་ཡོད་པ།",
    "གསོན་པ་དེ་ལ་རག་ལས་པ་དེས་འཆི་ལྟས་ཀྱིས་ཟིན་པ་ལྟར་རམ་སྐྲའམ་གོས་ལ་མེ་ཤོར་བ་ལྟར་བྱས་ཏེ་བག་ཡོད་པར་སྤྱོད་པས་དེ་ཕྱིར་བཅོ་བ་དག་ལ་བརྩོན་པར་བྱ་དགོས་ཏེ།",
    "མར་མེ་འདེགས་པས་རབ་ཏུ་བཀྱོན་པར་བྱས་པའི་རྒྱལ་པོ་དང་།",
    "འཇིགས་པ་དང་བཅས་པའི་གྲོང་དུ་བསྡད་པའི་མི་བཞིན་ནོ།",
    "དེ་ལྟར་ཡིན་ན་ཡང་དེ་བས་ཆེས་སྔར་དེ་ཟློག་པར་བྱེད་པ་པོ་བྱ་བ་གསོན་པ་ཡོད་པ་ཡིན་ཏེ།",
    "དེའི་དོན་དུ་ཞུགས་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "འགྲོས་བཤོལ་མེད་པར་འཆི་བདག་དྲུང་དུ་འགྲོ།",
    "ཡང་ཇི་ལྟར་གཞན་གསད་པར་བྱ་བའི་ཕྱིར་གཤེད་བྱེད་བསླང་བ་དང་།",
    "གཞན་གསོད་པར་མ་ནུས་པས་སློང་བ་པོ་དེ་ཉིད་བསད་ཀྱི་གཞན་ནི་མ་ཡིན་པ་དེ་བཞིན་དུ་སྐྱེས་པ་གནས་པར་བྱ་བར་མི་ནུས་པའི་ཕྱིར་འཆི་བ་ཉིད་བྱ་བ་ཡིན་གྱི་གསོན་པ་ནི་མ་ཡིན་ཏེ།",
    "གསོན་པ་ནི་སློང་བ་པོ་བསོད་པར་བྱེད་པ་ལྟར་བལྟ་བར་བྱའོ།",
    "འདིར་འཆི་བ་ཕྱིར་ཟློག་པར་བྱེད་པ་གསོན་པ་ནི་ཡོད་པ་ཉིད་དེ།",
    "མ་འོངས་པའི་དུས་ཐུང་བའམ་རིང་བ་ཉིད་དུ་ཡོངས་སུ་གཅད་པར་མི་ནུས་པ་དེ་བཞིན་དུ་འདས་པ་ཡང་ཐུང་བའམ་རིང་བ་ཉིད་དུ་ཡོངས་སུ་བཅད་པར་མི་ནུས་ཏེ།",
    "དེའི་ཕྱིར་མ་འོངས་པ་རིང་བ་ཉིད་དུ་ཡོངས་སུ་བརྟགས་པ་ལས་ཡིད་བརྟན་པར་མི་རིགས་ཏེ།",
    "གཞན་གྱི་ནི་མ་ཡིན་ནོ་ཞེས་སྨྲས་པར་གྲག་སྟེ།",
    "ཡང་དཔེར་ན་ལམ་འཇིགས་པ་དང་བཅས་པར་ཞུགས་པ་ཞིག་རྐུན་པོའི་ཚོགས་ཉེ་བར་གནས་པས་འཇིགས་བཞིན་དུ་ཡང་མི་འཇིགས་པ་སྐད་དུ་སྨྲས་ཤིང་།",
    "མང་པོ་ནི་ལུས་སོ་ཞེས་འཆི་བའི་འཇིགས་པས་སྐྲག་པར་སྨྲ་སྟེ།",
    "འོན་ཀྱང་གང་ཕྲག་དོག་མེད་པར་འཇོམས་པ།",
    "ཡང་ཇི་ལྟར་བས་རྒྱལ་པོ་ཆོམ་རྐུན་གྱི་དེད་དཔོན་གསད་པར་བྱ་བ་སང་གསད་པར་བྱ་དགོས་ཞེས་བཀའ་ལུང་སྩལ་ས་པ་དང་།",
    "དེ་དག་གསད་པ་དེ་ཕན་པར་འགྱུར་བ་ཡང་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "ག་འགའ་ཞིག་འཆི་བས་འགའ་ཞིག་ལ་ཕན་འདོགས་པར་ཡང་མི་འགྱུར་རོ་ན་ས།",
    "དེས་དེ་བཟུང་བའི་ཕྱིར་དམག་མངགས་པ་དང་དེས་དེ་འབུལ་གྱིས་བཅོས་པར་གྱུར་ལ།",
    "དེ་ཡང་ཁོ་ན་ལྟར་བཅོས་པར་གྱུར་ཏོ།",
    "དེས་བཅོས་སུ་མེད་པར་གྱུར་པ་དེ་བཞིན་དུ།",
    "༡རྒ་བ་དང་ན་བ་དང་འཆི་བ་དག་ཤེས་པར་བྱའོ།",
    "ཡང་ཇི་ལྟར་ཁྲུས་འ་མཁན་ཞིག་ཁྱིམ་ཁོལ་གྱི་བྲམ་ཟེ་རྣམས་ཀྱི་གོས་དག་ཆུད་གསན་ནས་ཐབས་ཀྱིས་བསྟུན་པར་བྱེད་ཀྱི།",
    "དེ་ལྟར་རྒྱལ་པོ་ན་བཟའ་བརླག་པ་དང་སློབ་དཔོན་ཁ་ཅིག་དག་རྒྱལ་པོ་མཐར་འགྲོ་ཞོན་ཆད་པར་བྱེད་དེ།",
    "གང་གཱའི་དོ་ཟླ་གོ་ད་ཝ་རིའི་ཀླུང་ཞེས་རྣམ་པར་གྲགས་པར་གྱུར་པ་གང་།",
    "ཞེས་ཞུ་གསོལ་བྱས་པར་གྲག་གོ།",
    "དེ་ནི་ད་ལྟར་ངེས་པར་ཟིན་པའི་ཕྱིར་འཇིགས་པ་འདྲེན་པར་བྱེད་པ་མ་ཡིན་ནོ་སྙམ་ན།",
    "གསད་པར་བྱ་བའི་ཕྱུགས་རྣམས་ལྟར།",
    "མི་སྣང་བར་འགྱུར་ན་ནི་དེ་དེ་སྐད་བརྗོད་པར་རིགས་པ་ཞིག་ན།",
    "དུ་མ་ཞིག་ནི་ཤི་ཟིན་ཞིང་འཆི་བཞིན་པར་རྟོགས་སོ།",
    "འདི་ལྟར་སྟོན་བརྒྱའམ་སྟོང་ན་འཆིའོ་ཞེས་ངེས་པར་མི་ཟིན་ཏེ།",
    "འཆི་བའི་དུས་ལ་ངེས་པར་མེད་པ་ཉིད་ཀྱིས་འཇིགས་པར་བྱ་དགོས་བཞིན་དུ་དེ་ཉིད་ཀྱིས་མི་འཇིགས་སོ་ཞེས་བྱ་བ་འདི་ནི་ཆེར་བླུན་པ་ཉིད་དེ།",
    "དེ་ནས་རང་ཉམས་ཀྱིས་ཤེས་པར་འགྱུར་རོ།",
    "འཆི་བའི་འདུ་ཤེས་མངོན་དུ་བྱས་ལ་བག་ཡོད་པར་བྱ་བར་རིགས་ཏེ།",
    "དེ་ལྟ་ན་ཡང་དཔའ་བོ་ཐོབ་པར་བྱ་བ་རྙེད་པ་དང་བཀུར་སྟི་དང་སྙན་པ་སྒྲུབ་པ་ལྷུར་ལེན་ཞིང་།",
    "གཡུལ་ངོ་མཚོན་ཆ་རྣོན་པོ་བབས་པས་ཉམ་ང་བར་གྱུར་པར་ཡང་སྡུག་བསྔལ་མེད་པ་རྣམས་ནི།",
    "དེའི་ཕྱིར་འཆི་བའི་འཇིགས་པ་ནི་སྡར་མ་ཁོ་ན་ལ་མི་དགའ་བ་སྐྱེད་པར་བྱེད་པ་ཡིན་གྱི།",
    "དེས་ཀྱང་ཕར་ཆགས་པ་ཁོ་ནར་བལྟས་ཀྱི་ཚུར་འབྲེལ་པ་ནི་མ་ཡིན་པས་ཆགས་པའི་རྗེས་སུ་མཐུན་པར་དགོད་སྐྱོ་བྱས་ནས་དེ་ཕོངས་པར་གྱུར་ཏོ།",
    "ཡང་བྲམ་ཟེ་ཞིག་ལ་བུ་གསུམ་ཡོད་པར་གྱུར་ལ།",
    "དེས་འོངས་ནས་བསླངས་པར་གྱུར་ཏོ།",
    "འབྲིང་པོ་བཙོངས་པར་གྱུར་སྙམ་གྱིས།",
    "དེར་སྔར་བསགས་པའི་ནོར་གྱི་ཕུང་པོ་ཟད་པས་དེ་ལ་ཅི་ཡང་མ་བྱིན་པར་གྱུར་ཏོ།",
    "ནམ་ཞིག་ན་དེ་ལས་དེའི་བུ་གཉིས་སྐྱེས་པར་གྱུར་ལ།",
    "དེས་ཀྱང་དེ་ལྟར་བྱས་པར་གྱུར་ཏོ།",
    "དེའི་རྣམ་པར་སྨིན་པ་ནི་དེ་ཁོ་ནས་ཉམས་སུ་མྱོང་བར་བྱ་བ་ཡིན་ནོ།",
    "རིན་སྦྱིན་པར་བྱ་ཡིས་ཞེས་ཏེ་ཆང་མང་པོ་འཐུངས་ལ།",
    "དེ་ཡང་ཡོད་པར་མ་གྱུར་པ་དང་།",
    "དེས་དེ་བཟུང་ནས་ཅོ་དྲིས་པར་གྱུར་ཏོ།",
    "འདི་ལྟར་ཡི་གེ་ཨ་ལ་སོགས་པའི་ཡིག་འབྲུ་རྣམས་ཆེས་སྐྱེན་པར་བརྗོད་པ་ན།",
    "སྐད་ཅིག་ཅེས་བྱ་བ་ནི་དུས་འགྲིབ་བའི་མཐར་ཐུག་པར་གྱུར་པ་ལ་བྱ་ལ།",
    "ཇི་ལྟར་རྣམ་པར་ཤེས་པ་སྐད་ཅིག་མ་ཡིན་པ་དེ་བཞིན་དུ་འདུ་བྱེད་ཐམས་ཅད་ཀྱང་སེམས་ལྟར་སྐད་ཅིག་མ་ཡིན་ཏེ།",
    "བརྗོད་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་རྒ་བ་ལ་རྣམ་པར་སྣང་བས་རྒྱུན་དག་ལ་མངོན་བར་ཞེན་པར་མི་བྱ་སྟེ།",
    "དེ་ལྟ་ན་ཡང་དེ་གཉིས་ཇི་ལྟར་བུ་ལ་ཡོད་པར་མྱ་ངན་གྱི་རྒྱུར་འགྱུར་བ་དེ་ལྟར་རང་ལ་ཡོད་པ་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་དེ་ལ་བརྗོད་པར་བྱ་སྟེ།",
    "གང་ཞིག་སྐྱོན་མཚུངས་པ་ཉིད་ཀྱིས་སྤྲོ་བར་བྱ་བར་གྱུར་ཅིང་གཞན་དག་ལ་དེ་སྨྲ་བ་པོར་འགྱུར་བ་དེ་ནི་སྨད་པར་འོས་པར་ཇི་ལྟར་མི་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་གཞན་དག་ལ་ཡང་འཆི་བདག་བབས་པ་ངེས་པར་ཟིན་པར་བྱས་ཏེ་ཆེས་ཤིན་ཏུ་ཡིད་དབྱུང་བར་བྱའི།",
