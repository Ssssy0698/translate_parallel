    "འ་༹ཇམ་དཔལ་ཅི་ནམ་ཡང་སེམས་པར་གྲོལ་བ་ཐོབ་པར་འ་༹གྱུར་བ་ཞིག་ན།",
    "རྣམ་པར་གོལ་བ་ཅི་ཡང་མྱེད་དོ།",
    "སྟན་ལས་ལངས་སྟེ་དོང་ནས་འ་༹དི་སྐད་དུ་གལ་ཏེ་རྣམ་པར་གྲོལ་བ་ཡང་མྱེད།",
    "རྣམ་པར་གྲོལ་བི་སེཾས་ཀྱང་མྱེདྣ།",
    "གལ་ཏེ་འ་༹ཇིག་རྟེན་ལས་ངེས་པར་བྱུང་བ་མྱེད་ན།",
    "བགྱི་ལགས།",
    "ཤིན་ཏུ་སྐྲག་པར་འ་༹གྱུར་རོ།",
    "རྣམ་པར་བྱང་བ་ཅི་ལས་བྱུང་བར་གྱུར།",
    "རྣམ་པར་བྱང་བ་མྱེད་པི་ཕྱིར་རོ།",
    "རྣམ་པར་སྨྱིན་པི་འ་༹བྲས་བུ་ཐོབ་པར་འ་༹གྱུར་རོ།",
    "དེ་ཉིད་རྣམ་པར་བྱང་བ་ཞེས་བྱ་སྟེ།",
    "རྣམ་པར་བྱང་བ་འ་༹མ།",
    "ཟག་པ་མྱེད་པི་སེམས་ཐོབ་པར་གྱུར་ཏོ།",
    "ཟག་པ་མྱེད་པི་སེམས་ཐོབ་པར་གྱུར་ཏོ།",
    "ཅད་རབ་དུ་ཞི་བར་བགྱིད་ལགས་སོ།",
    "དམ་ཚིག་དང་མཁྱེན་པའ་ི༹་བྱེ་བྲག།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐམས་ཅད་མཁྱེན་པའ་ི༹་ཡེ་ཤེས་དང་ལྡན་བ།",
    "རྣམ་པར་སྣང་མཛད་ཆེན་པོ་རྟག་པ།",
    "ཟླ་བ་ལྟ་བུས་མཛེས་པར་པར་བྱས་པ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་བཞུགས་པ།",
    "ཤེས་རབ་ཕ་རོལ་དུ་ཕྱིན་པའ་ི༹་ཚུལ་འ་༹དི་ཡང་དག་པར་སྟོན་ཏེ།",
    "འ་༹དི་ལྟར་རབ་དུ་དགའ་༹་བ་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི།",
    "འ་༹དོད་ཆགས་ཀྱི་མདའ་༹་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "སྡུག་པའ་ི༹་འ་༹ཆིང་བ་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནྀ།",
    "ལྟ་བ་རྣམ་པར་དག་པི་གནས་དེ་ནྀ་འ་༹དི་ལྟ་སྟེ།",
    "དགའ་༹་བ་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི།",
    "སྲེད་པ་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ་བྱང་ཅུབ་སེམས་དཔའ་༹་འ་ི༹་གནས་སོ།",
    "སྙེམས་པ་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི།",
    "རྒྱན་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི།",
    "འ་༹དོད་ཆགས་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "ཞེ་སྡང་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "གཏི་མུག་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "ཐམས་ཅད་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "མངལ་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "ཡིད་ཚིམ་བར་བྱེད་པ་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "ལུས་བདེ་བ་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "ངག་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ་བྱང་ཅུབ་སེམས་དཔའ་༹་འ་ི༹་གནས་སོ།",
    "ཡིད་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ་བྱང་ཅུབ་སེམས་དཔའ་༹་འ་ི༹་གནས་སོ།",
    "གཟུགས་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "སྒྲ་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "དྲི་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "རོ་རྣམ་པར་དག་པའ་ི༹་གནས་དེ་ནི་འ་༹དི་ལྟ་སྟེ།",
    "ཁམས་གསུམ་མ་ལུས་པ་མཐའ་༹་དག་ནི་འ་༹ཇིག་རྟེན་གསུམ་པོ་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བ།",
    "མྱུར་དུ་བླ་ན་མྱེད་པ་ཡང་དག་པར་རྫོགས་པའ་ི༹་བྱང་ཅུབ་དུ་མངོན་བར་རྫོགས་པར་འ་༹ཚང་རྒྱ་བར་ཡང་འ་༹གྱུར་རོ།",
    "བཅོམ་ལྡན་དེ་བཞིན་གཤེགས་པ་ཤག་ཀྱ་ཐུབ་པ་ཡང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་སྤྲོས་པ་མྱེད་པ་ཉིད་དུ་རིག་པར་བྱ་འོ།",
    "མྱུར་དུ་བླ་ན་མྱེད་པ་ཡང་དག་པར་རྫོགས་པའ་ི༹་བྱང་ཅུབ་དུ་མངོན་བར་རྫོགས་པར་མཚང་རྒྱ་བར་ཡང་འ་༹གྱུར་རོ།",
    "འ་༹ཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའ་ི༹་རྡོ་རྗེ་ཞེས་བྱ་བའ་ི༹་ཕྱག་རྒྱ་བཅིངས་ནས།",
    "འ་༹དོད་ཆགས་ཐམས་ཅད་རྣམ་པར་དག་པས།",
    "འ་༹ཇིག་རྟེན་ན་ཞེ་སྡང་ཐམས་ཅད་རྣ་པར་དག་པར་འ་༹གྱུར་རོ།",
    "ཞེ་སྡང་ཐམས་ཅད་རྣམ་པར་དག་པས།",
    "འ་༹ཇིག་རྟེན་ན་དྲི་མ་ཐམས་ཅད་རྣམ་པར་དག་པར་འ་༹གྱུར་རོ།",
    "དྲི་མ་ཐམས་ཅད་རྣམ་པར་དག་པས།",
    "འ་༹ཇིག་རྟེན་ན་ཤེས་པ་ཐམས་ཅད་རྣམ་པར་དག་པར་འ་༹གྱུར་རོ།",
    "ཤེས་པ་ཐམས་ཅད་རྣམ་པར་དག་པས།",
    "འ་༹ཇིག་རྟེན་ན་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་རྣམ་པར་དག་པར་འ་༹གྱུར་རོ།",
    "གོས་པར་མྱི་འ་༹གྱུར་ཏེ།",
    "མྱུར་དུ་བླ་ན་མྱེད་པ་ཡང་དག་པར་རྫོགས་པའ་ི༹་བྱང་ཅུབ་མངོན་བར་རྫོགས་པར་འ་༹ཚང་རྒྱ་བར་ཡང་འ་༹གྱུར་རོ།"
  ]
