    "ཆིབས་ཞབས་གཞན་རྣམས་མགྲོན་ཁང་གཞན་དག་ཏུ་གྲ་སྒྲིག་ཞུས་འདུག་པ་དང་།",
    "རྣམ་ཀུན་ཁོ་པ་དམག་དམངས་མཉམ་དུ་དཀའ་ངལ་མཉམ་མྱོང་བྱེད་པའི་གོམས་གཤིས་ཡོད་མཁན་ཞིག་ཀྱང་ཡིན་འདུག་དེ་སྔོན་མའོ་ཙེ་ཏུང་ཅིང་ཀང་རི་བོར་སྡོད་པའི་སྐབས་སུ་ཁོ་པས་མའོ་ཡི་རྗེས་སུ་འབྲངས་ཤིང་།",
    "རྒྱ་མིའི་ཞི་དྲག་དཔོན་དམག་ཉང་སར་འཇབ་རྒོལ་བཅས་ཀྱིས་འཐབ་འཛིངས་བྱས་པའི་གནས་ཚུལ་དེ་གང་ས་གང་དུ་བྱུང་འདུགས་གནས་དེ་ཚོར་གནས་པའི་རྒན་བྱིས་མང་པོ་རང་ཉིད་ཀྱི་གཅེས་པའི་ཕ་ཡུལ་དུ་གནས་ཐབས་བྲལ་ཏི་དངོས་ནོར་ཁྱེར་གང་ཐུབ་དང་།",
    "དེ་འོག་དམག་དཔོན་འགའ་ཤས་བཅས་སླེབས་འདུག་པ་དང་བཅིངས་འགྲོལ་དམག་བརྒྱ་ལྷག་ཙམ་ཟམ་པའི་གཡས་གཡོན་དུ་བཀྲམས་འདུག་དམག་དཔོན་ཝང་ཁང་དེས།",
    "མི་དེའི་ཁ་ཐབས་གང་འདྲ་ཞིག་འདུག་གམ།",
    "ཟམ་པའི་གཡས་གཡོན་དུ་རྒྱ་དམག་༣ ནས་༤ སྐོར་སླེབས་འདུག་པ་དེ་རྣམས་ལ་དེང་རབས་ཅན་གྱི་དྲག་ཆས་སྤྲས་ཤིང་དམག་ས་ཆེན་པོར་སླེབས་པ་ལྟར་མེ་མདའི་ཁ་ཟམ་པའི་ཕྱོགས་བཞིར་གཏད་ནས་སྡིགས་སྐུལ་ལྟ་བུ་བྱེད་བཞིན་འདུག་དེ་རྣམས་ཀྱི་ཁྲོད་ནས་དམག་དཔོན་ཆུང་བ་ཞིག་ཕྲན་སར་ཡོང་ནས།",
    "ག་དུས་བླངས་ན་ཡང་འགྲིག་ཅེས་བརྗོད་པ་དང་ཆབས་ཅིག་དངུལ་འཛིན་ཞིག་ཀྱང་སྤྲད་བྱུང་།",
    "གྲོགས་པོ་ཁྱེད་རང་ཐུགས་བློ་བདེ་པོ་གནང་རོགས་གནང་།",
    "དམག་དཔོན་ཐན་ཀོན་སན་གྱི་བཏང་ལུགས་ཟེར་གྱི་འདུག་ཁོང་ནས་རྒྱ་མིའི་དམག་སྒར་ནང་ཟློས་གར་ཞིག་སྟོན་རྒྱུའི་གྲ་སྒྲིག་བྱས་པ་ལྟར།",
    "ཁོང་གཉིས་མཉམ་དུ་ལམ་སེང་ཡོང་རོགས་ཞེས་ཨུ་ཚུགས་བྱེད་ཀྱི་འདུག་པས།",
    "དེ་རིང་ཁྱེད་རང་སྐད་བཏང་ནས་གྲ་སྒྲིག་བྱེད་སྟངས་སྐོར་གོ་བསྡུར་བྱ་རྒྱུ་ཡིན།",
    "ཁོ་པས་གལ་སྲིད་ཕེབས་ལམ་དུ་སྲུང་ཆ་འཇོག་དགོས་ཀྱི་འདུག་ན།",
    "ཁྱེད་རང་དོགས་པ་བྱེད་མི་དགོས།",
    "དོགས་པ་སྐྱེས་དགོས་པ་ཞིག་ཆགས་ཀྱི་འདུག་ཞུས་པར།",
    "ཞུ་སྒོ་གང་ཅིར་གཟབ་གཟབ་གནང་དགོས་ཀྱི་འདུག་ཅེས་གསུངས་པར།",
    "གདན་འདྲེན་ཞུས་ན་རྩ་བ་ནས་འགྲིགས་ཀྱི་མི་འདུག་ཅེས་ནན་པོ་ཞུས་པར།",
    "ལྷ་ཞོལ་གཉིས་ནས་མི་དམངས་ཆུ་ལུད་པ་ལྟར་ནོར་གླིང་དུ་ཡོང་བཞིན་འདུག།",
    "སྐབས་དེར་གཞུང་སྒོའི་ཕྱིར་མི་དམངས་འདུ་འཛོམས་བྱེད་བཞིན་འདུག་ད་དུང་ལྷ་ཞོལ་གཉིས་ནས་གཞུང་ལམ་བརྒྱུད་མུ་མཐུད་མི་མང་པོ་རྒྱུགས་ཡོང་བ་དང་།",
    "ཁྱེད་རང་བཀའ་བློན་ཚོར་དེའི་འགན་ཡོད།",
    "རང་རང་སོ་སོར་ཡོད་པའི་གོ་མཚོན་འཁྱེར་ཏེ་སྲུང་བྱ་ཞུ་སྒོ་ཡང་འགན་ལེན་ཞུས།",
    "འོན་ཀྱང་དཔའ་ངར་ལྡན་ཞིང་གཉའ་རུས་མི་ཆག་པར་གསང་ཐབས་ཀྱི་སྒོ་ནས་རྒྱ་མིར་འཐབ་རྩོད་ཀྱི་ལས་འགུལ་བརྩམས་པར་བརྟེན་ཀུན་བཟང་ལགས་ཁོང་རང་དང་།",
    "བསར་པ་དགོས་དོན་མི་འདུག་ཅེས་གསུངས་པ་ལྟར་ལ་གནས།",
    "ཡེང་དུ་ཕེབས་ཚུལ་གྱིས་ཕེབས་སྒུག་ཞུས་འདུག།",
    "ཁ་དང་དམག་བཞི་ལྔ་ཙམ་བཅས་ཆིབས་པ་ཁྲིད་ནས་ཕེབས་སྒུག་ཞུས་འདུག་པར་༧གོང་ས་མཆོག་ནས་ཁྱེད་སུ་ཡིན་པཱ་ཞེས་བཀའ་འདྲི་གནང་བར།",
    "སོ་ནམ་པ་རྣམས་དཔྱིད་ལས་བྱེད་བཞིན་འདུག་པས།",
    "ལ་གཤམ་ནས་སྦན་ཙ་གྲུ་ཁ་དེ་ཙམ་ས་ཐག་རིང་པོ་མེད་སྟབས་ཁྱུག་ཙམ་ལ་ཕེབས་ཏེ་གྲུ་ཁར་ཕེབས་སྐབས་དེ་གར་ཀོ་གྲུ་ཕེབས་སྒྲིག་ཞུས་འདུག་གཙང་པོ་ཕ་ཁའི་འགྲམ་དུ་བསྟན་སྲུང་དང་བླངས་དམག་དང་།",
    "སྐབས་མཚམས་ལན་གསལ་འབུལ་རྒྱུ་བྱས་འདུག།",
    "གཏོར་སྐྱོན་ཕྲན་ཙམ་ལས་མ་བྱུང་བ་དེ་ནི་མི་རྣམས་ཀྱིས་བློ་ཡུལ་ལས་འདས་པའི་ངོ་མཚར་ཅན་གྱི་གནས་ཚུལ་བྱུང་འདུགལྷ་ས་བ་ཚོས་བརྗོད་གསལ།",
    "མེ་མདའ་སྦག་སྦག་མང་པོ་བརྒྱབ་སྟེ་མི་སེར་དཀྱུས་མ་མང་པོ་བསད་འདུག།",
    "ཆང་ཁྱིམ་སྐལ་བཟང་ཐུབ་བསྟན་གཉིས་དེ་གར་ཕེབས་སྒུག་ཞུས་ནས་བཞུགས་འདུག་པ་རྒྱ་གར་གཞུང་ནས་༧གོང་ས་མཆོག་དང་།",
    "རང་ཅག་རྣམས་ནས་མྱངས་པའི་སྡུག་བསྔལ་ལ་གདུང་སེམས་མཉམ་སྐྱེད་བྱེད་པའི་རྣམ་འགྱུར་སྟོན་གྱི་འདུག།",
    "ཞེས་གསུངས་པ་ལྟར་མངོན་སུམ་དུ་བྱུང་འདུག།",
    "རྒྱབ་ངོས་སུ་སྐུ་སྲུང་བ་འགའ་ཤས་སྡོད་ཤག་བཅས་གོ་སྒྲིག་ཞུས་འདུག་དེའི་རྒྱབ་ཀྱི་རི་རྩེའི་གཡས་གཡོན་དུ་ཁང་ཆེན་གཉིས་ཡོད་པར་ཡོངས་འཛིན་བགྲེས་གཞོན་རྣམ་གཉིས་དང་།",
    "གསུང་ཞབས་རྣམ་གྲྭ་འགའ་ཤས་ཀྱི་བཞུགས་ཡུལ་གོ་སྒྲིག་ཞུས་འདུག་བཀའ་བློན་ཤན་སྣེ་གཉིས་དང་།",
    "རྒྱ་མིའི་རྒྱུགས་ཁྱི་བྱེད་མཁན་བོད་མི་འགའ་ཤས་ཀྱང་སྐབས་ཤིག་རིང་བེད་སྤྱོད་བྱས་ཟིན་རྗེས་དམར་གསོད་བཏང་བའི་གནས་ཚུལ་བྱུང་འདུགཀློག་པ་པོ་རྣམས་ལ་དཔེ་མཚོན་ཞིག་ཞུ་རྒྱུར།",
    "གཅིག་ལ་སྨས་སྐྱོན་བྱུང་འདུག།",
    "དམ་པ་དེ་ཉིད་ལ་སྦྱང་སྟོབས་ཀྱི་ཡོན་ཏན་དེ་ཙམ་མེད་ཀྱང་རང་བཞིན་སྐྱེས་སྟོབས་ཀྱི་བློ་གྲོས་ཆེ་བ་དང་།",
    "སྔ་མའི་ཁོངས་སུ་འདུས་པར་གདའ།",
    "གཅིག་ནམ་གྲུབ་ཙ་ན་གཅིག་ཀྱང་འགྲུབ་ཅིང་ཡང་དག་པར་ན་ཐོག་ཐ་མེད་པས་སྔ་ཕྱི་མ་གྲུབ།",
    "གནས་ལུགས་སྤྲོས་བྲལ་དུ་འདོད་པར་གདའ།",
    "བཀག་པའི་གསལ་ཁ་གང་ཡང་མི་གདའ།",
