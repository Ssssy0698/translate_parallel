    "གཡས་གསུམ་ལྷ་ས་མི་ས་གདོན་གྱི་ས།",
    "ལྷ་སར་བྱུང་ན་བསྟེན་པའི་ལྷ་སྲུངས་བཅོས།",
    "བྱང་ཤར་ས་བདག་རིགས་འཛིན་བཅོས་པར་བྱ།",
    "དེ་ཕྱིར་མཁས་པས་ཆུ་ལ་བརྟག་པར་བྱ།",
    "དབེན་པར་ཆ་ལག་བཅོ་བརྒྱད།",
    "དྲོད་བཅུད་བསྟེན་པ་ཟས་ཀྱི་མེདྲོ་སར་བསྡད་པ་སྤྱོད་ལམ་གྱི་མེའོ།",
    "དེ་དག་གང་ལ་གང་དགོས་ཤེས་པར་བྱ།",
    "གཉེན་པོའང་དེ་དང་བསྟུན་ལ་བཅོས་པར་བྱ།",
    "དེས་ན་འདུ་བ་ལྷག་ཆད་མེད་པར་ཆ་ལག་བཅོ་བརྒྱད།",
    "ཚ་སེལ་གྲང་སེལ་གཉིས་སུ་ཤེས་པར་བྱ།",
    "རྣ་བའི་རྣག་ཁྲག་ཟུག་གཟེར་འཇོམས་པར་བྱེད།",
    "པར་བ་ཏ་བཞི་བསྣན་པས་སེལ་བར་བྱེད།",
    "ལོག་པ་མནན་དང་རྣམ་དགུར་ཤེས་པར་བྱ།",
    "བརྟན་པ་འཇམ་པོར་འབྲུམ་བུ་མེད་པར་བརྟག།",
    "འཁྲུ་བ་གསར་རྙིང་མ་ལུས་གཅོད་པར་བྱེད།",
    "ཚོས་པར་བཙོས་ལ་ཁུ་བ་ཡང་ཡང་བཏོན།",
    "ཆུ་འཇམ་བསྲེས་ལ་ལུས་ཀུན་དག་པར་བཀྲུ།",
    "ལྟོ་བ་མ་གཏོགས་བསྐུ་མཉེ་འཐེམ་པར་བྱ།",
    "ཁཎྜ་བྱས་ཏེ་སྣ་མ་ཚིག་པ་དེ།",
    "རྒྱུན་སྦྱོངས་ཚད་པ་རྙིངས་རྙོགས་འདོན་པར་བྱེད།",
    "མཐའ་མ་འབྲིང་རབ་རིམ་པས་ཤེས་པར་བྱ།",
    "ཕན་ཡོན་ཆམ་རྒན་མཚུལ་པར་ཞེན་པ་དང་།",
    "བྱང་བ་རྒྱ་ཚྭ་དྲི་ཆུར་སྦྱར་བྱས་ལ།",
    "པགས་པ་མ་འཆུས་ཆ་སྙོམས་དམ་པར་བསྡམ།",
    "གདབ་ཐབས་རྩ་མ་འཆུས་པར་མཐེ་བོས་སྡོམ།",
    "རྩ་ཆེན་སྒང་གཤགས་རྩ་ཕྲན་སྨྱུག་ཁར་གདབ།",
    "ཆུ་གྲོག་བླུད་ཅིང་གསུར་དུད་བྱུག་པ་བྱས།",
    "སྐྲངས་ན་ཚྭ་མར་ཁྲི་གཞོབ་བྱུག་པར་བྱ།",
    "སྐྲན་ལྷེན་མེ་དྲོད་ཉམས་ལ་གདབ་པར་བྱ།",
    "སྦོ་འཁྲོག་འཁྲུ་བ་འཇམ་ལ་གདབ་པར་བྱ།",
    "ཕན་ཡོན་རྩ་ཡི་འགྲོས་ལམ་འགེག་པར་བྱེད།",
    "མ་ཞུ་འཇུ་ཞིང་ལྷེན་སྐྲན་བཤིག་པར་བྱེད།",
    "རང་བྱུང་ཆུ་ཚན་ནང་དུ་ཞུགས་བྱས་ནས།",
    "སྐར་ཆུ་བརྡེག་གམ་གྲོད་པར་བླུགས་པས་བདུག་མིག་ལ་མཚོན་ཕོག་བཙན་སྐྲངས་ཚ་ཞིང་དམར།",
    "གངས་ཆུ་གྲོད་པར་བླུགས་ལ་ལྕིད་མེད་བདུག།",
    "གཉིད་མེད་ལུས་ལ་སྣུམ་གྱིས་བྱུག་པར་བྱ།",
    "བསྐུ་མཉེ་ཀུན་ལ་དེ་བཞིན་ཤེས་པར་བྱ།",
    "བཅའ་སྒ་འབྲུ་མར་སྦྱར་བས་བྱུག་པར་བྱ།",
    "ལུས་ཀུན་དག་པར་བཀྲུ་བ་ལེན་ལྔ་བྱ།",
    "མགྱོགས་ན་འབྲོས་ལོང་མེད་པར་སྣོད་ལ་འཛུགས།",
    "སྤྱོད་ལམ་འགོལ་དང་དྲོ་བའི་གནས་སུ་བསྡད།",
    "སུག་སྨེལ་བུ་རམ་དྲུག་འགྱུར་སྦྱར་བྱས་ལ།",
    "རྒྱམ་ཚྭ་ཚྭ་བཏབ་ལྟོ་སྟོང་བསྟེན་པར་བྱ།",
    "བསྐམ་སར་རྔུལ་མ་བྱུང་ཙམ་རན་པར་གཅག།",
    "སྤྱི་སྡོམ་ཉི་ཤུ་རྩ་ལྔས་ཤེས་པར་བྱ།",
    "ཁྱད་པར་མགོ་ལུས་མ་ལུས་བརྡུང་སྙམ་བྱེད།",
    "མི་འཕྲོད་མ་ཞུ་མི་གཙང་འདྲེས་གཡོས་པས།",
    "ཁ་ཟས་མི་འཇུ་དང་ག་འགག་པར་བྱེད།",
    "བསིལ་ལ་ཡང་བའི་ཟས་ཀྱིས་བཅོས་པར་བྱ།",
    "མེ་དང་ཉི་མས་དྲོས་ཚེ་ཁྱད་པར་ན།",
    "མགོ་དང་མིག་རུས་ལྷག་པར་ན་བ་དང་།",
    "དོན་མེད་ན་ཞིང་བྱས་མེད་དྲག་པའོ།",
    "ཉིན་པར་ལྟོགས་པའི་དུས་ན་བདེ་བར་ཚོར།",
    "སྤྱི་བཅོས་ལེའུ་ཉེར་ལྔར་ཤེས་པར་བྱ།",
    "ཁ་སྦྱར་རྫར་བླུགས་བོང་མེས་ཚོས་པར་བསྲེག།",
    "རྩ་ཆུ་ཚ་ཞིང་དང་ག་འགགས་པར་འགྱུར།",
    "མཐའ་མ་གྲང་བ་ཟད་པར་གྱུར་པ་ལ།",
    "འདྲེས་པར་ཟོས་པས་མི་འཕྲོད་ནུས་པ་འཐབ།",
    "ཁྱད་པར་གང་མ་ཞུ་བའི་ཟས་དེ་གནོད།",
    "གོས་སྲབ་ལུས་གྲང་ཉལ་བོ་མང་དུ་བྱས།",
    "ཅོང་ཞི་སོལ་བའི་མེ་ལ་ཚོས་པར་བསྲེག།",
    "ཀ་རས་རྟ་བྱས་ཆུ་སྐོལ་ཕུལ་བཏང་ན།",
    "མ་ཞུ་ལྷེན་སྐྲན་འདྲིལ་བ་བཤིག་པར་བྱེད།",
    "ཤ་བསྐམ་ཤེད་ཆུང་འགྲངས་ན་ཁྱད་པར་ན།",
    "དྲོད་བཅུད་གནོད་ན་ཚ་སྐྲན་ཡིན་པར་བཤད།",
    "ལག་པས་ལེགས་པར་མྱང་བས་མཐོང་བར་འགྱུར།",
    "མཁལ་སྐྲན་ཆུ་ལུམས་བྱས་ལ་བྱིན་གཞུག་གཏར།",
    "གཏར་ག་བཤལ་དང་ཆུ་ལུམས་བསྟེན་པར་བྱ།",
    "ཟུངས་སུ་མ་སྨིན་པར།",
    "ངན་ཁྲག་མཆིན་མཚེར་རྒྱས་པས་མ་ཐུབ་པར།",
    "ཆུ་མཚམས་པགས་པ་སྲབ་པར་ཆུ་ཐུར་དབུག།",
    "ཡུངས་ཀར་མར་བཞིན་ལུས་ཀུན་ཁྱབ་པར་གནས།",
    "ཁྱད་པར་གྲང་ཞུམ་ཆད་ན་སྨིན་པ་ཡིན།",
    "མཆིལ་སྣབས་མང་ལ་ཤེས་པ་རྨོངས་པར་བྱེད།",
    "གོས་དྲོར་གྱོན་ལ་ཉི་གྲིབ་མཚམས་སུ་བསྡད།",
    "ཁྱད་པར་རང་ཉིད་སྨིན་པའི་ཚ་བ་ལ།",
    "དེའི་ནང་པར་དཔྱི་དང་དཔུང་བ་མན་ཆད་བྲན།",
    "དེ་ཡི་ཕྱི་དེ་ནང་པར་ལུས་ཀུན་བྲན།",
    "ལུས་ཟུངས་སྲེག་པར་བྱེད་པས་རྒྱས་ཞེས་བྱ།",
    "གསུམ་ཡར་དྲུག་ཡར་སྐོམ་དུ་བསྟེན་པར་བྱ།",
    "ལག་པའི་མཐིལ་དྲེག་འགོགས་ན་འཕྲང་ལ་ཕེབས།",
    "རླངས་པ་སངས་བུལ་ཀུ་ཡ་མཐུག་པར་འོང་།",
    "རྣག་མཁྲིས་ལྕགས་གཡའ་ཆགས་ན་གབ་པར་ཤེས།",
    "གཞུག་ཏུ་གཏིང་ཚད་སླེབ་ན་གནོད་པར་ཚོར།",
    "མཐའ་མར་ཚ་བ་སླེབས་ནས་ཕན་པར་ཚོར།",
    "ཟས་སྤྱོད་མ་བསྡམས་ལྷུག་པར་གཏང་བ་དང་།",
    "བ་ཤ་ཀ་དང་རྣམ་པར་ཡུ་གུ་ཤིང་།",
    "འགྲམས་འཁྲུགས་གཟེར་ཆུང་ལུད་པ་གཙང་བ་དང་།",
    "ཁུར་མང་སྐྱབས་ཚོད་ཆུ་གྲོག་བསྟེན་པར་བྱ།",
    "ཁྱད་པར་དུག་ཐབས་ལུད་པ་དུད་ཁུ་ལ།",
    "ཁྱད་པར་མགོ་བོ་ན་ཞིང་དང་ག་འགག།",
