    "ཁྱད་པར་མཉན་བྱ་དེ་སྒྲ་ལ་རྟག་པ་རྣམ་པར་གཅོད་པ་དང་།",
    "སློབ་དཔོན་གྱིས་མཉན་པར་བྱ་བ་ཉིད་ནི་ཅི་ལྟར་ཡང་རྣམ་པར་གཅོད་པའི་གཏན་ཚིགས་མ་ཡིན་པའི་མི་ཕྱིར།",
    "ཞེས་གསུངས་པ་དང་ནང་འགལ་ལོ།",
    "སློབ་དཔོན་གྱིས་མ་མཐོང་བ་ཙམ་གྱིས་ལྡོག་པ་དག་ལ་འགོག་པར་བྱེད་ན་དེ་ཡང་རིགས་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་པ་དང་འགལ་ལོ།",
    "དེ་དང་རྣམ་ངེས་སུ་དྲངས་པའི་མ་མཐོང་བ་ཙམ་གྱིས་མི་སྣང་བ་དག་ལ་འགོག་པར་བྱེད་ན།",
    "ཞེས་གསུངས་པ་གཉིས་ཀྱི་ཁྱད་པར་ཇི་ལྟར་ཡིན་ཞེ་ན།",
    "ཁྱད་པར་མེད་དེ།",
    "དེས་ན་མཐོང་བ་དག་ལ་འགོག་པར་བྱེད་ན།",
    "མི་སྣང་བ་དག་ལ་ཞེས་སོགས་ཀྱི་ལུང་འདྲེན་པ་རྣམ་འགྲེལ་ངེས་ཀྱི་ཁྱད་པར་མ་གོ་བ་ཡིན་ནོ།",
    "རང་ཉིད་ཀྱིས་ལུང་གཉིས་ཀའི་དོན་ཅི་ཡིན་གཏོལ་མ་བྱུང་བ་གསལ་བར་བྱས་པ་ཡིན་ལ།",
    "སྐྱུ་རུ་ར་དེ་ལ་གཅིག་སྨིན་པ་དང་རོ་ནུས་ཁྱད་པར་ཅན་དུ་མཐོང་བ་ན།",
    "ཡུལ་ལ་སོགས་པའི་ཁྱད་པར་བས་རྫས་སྐྱུ་རུ་ར་ལ།",
    "རྩོད་གཞི་མ་ངེས་པར་འཕངས་ན་རིགས་པའི་ཚུལ་ལས་འདས་ལ་འདིར་ནི་རྩོད་གཞི་དང་སྐྱུ་རུ་ར་ཡིན་པར་མཚུངས་ན།",
    "རོ་ནུས་ཁྱད་པར་ཅན་ཡིན་པར་མཚུངས་པས་ཁྱབ་པ་ལ།",
    "དེ་དང་སྐྱུ་རུ་ར་ཡིན་པར་མཚུངས་ཀྱང་།",
    "གཏན་ཚིགས་མི་མཐུན་ཕྱོགས་ལ་མ་དམིགས་པ་གང་ཡིན་པ་དེ་ཁོ་ན་མི་མཐུན་ཕྱོགས་ལ་མེད་པར་སྒྲུབ་བྱེད་ཡིན་ནམ།",
    "བདག་དང་ས་ལ་ཤེས་པ་ཡོད་པ་དང་སོགས་པས་རྒྱུ་འོ་མ་ལ་ཞོ་མ་དམིགས་ཀྱང་དེ་དག་མེད་པར་སྒྲུབ་མི་ནུས་པའི་ཕྱིར།",
    "དེ་ཡང་བྱེ་བྲག་པ་གསོན་ལུས་ལ་བདག་མ་མཐོང་ཡང་ཡོད་པར་འདོད་ཅིང་།",
    "སྲོག་ལྡན་དེ་སྒྲུབ་ཀྱི་མི་མཐུན་ཕྱོགས་ལ་མ་མཐོང་བས་མི་མཐུན་ཕྱོགས་ལ་མེད་པ་གྲུབ་པར་འདོད་པ་དང་།",
    "སྐྱེས་བུ་ཕ་རོལ་པོ་ཀུན་མཁྱེན་མིན་པར་སྒྲུབ་པའི་རྟགས་མི་མཐུན་ཕྱོགས་ལ་མ་མཐོང་བས་དེ་ལ་མེད་པར་གྲུབ་པར་འདོད་པ་དང་།",
    "གྲངས་ཅན་འོ་མ་ལ་ཞོ་མ་མཐོང་ཡང་ཡོད་པར་འདོད་པ་དང་།",
    "འདུས་བསགས་མིག་སོགས་བདག་དོན་བྱེད་པར་སྒྲུབ་པའི་མི་མཐུན་ཕྱོགས་ལ་མ་མཐོང་བས་དེ་ལ་མེད་པ་གྲུབ་པར་འདོད་པ་རྣམས་ནང་འགལ་ཞེས་བྱ་བའི་དོན་ནོ།",
    "སྒྲུབ་རྟགས་གཉིས་ཀྱི་ཁྱབ་པ་ངེས་པ་འབྲེལ་བ་ངེས་པ་ལ་ལྟོས་པར་སྒྲུབ།",
    "དེ་བཞིན་དུ་རྒྱུ་ལོག་པ་ཡིས་ནི་འབྲས་བུ་ལྡོག་པར་འགྱུར་ཏེ།",
    "ཅིག་ཤོས་ལོག་པས་ཇི་ལྟར་གཞན་གྱི་རྟགས་ལྡོག་པར་འགྱུར་བ་མི་འཐད་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་རྟགས་ཀྱི་ལྡོག་ཁྱབ་ངེས་པ་ལ་རྟགས་དེ་སྒྲུབ་ཀྱི་མི་མཐུན་ཕྱོགས་མཐའ་དག་ལ་མེད་པར་ངེས་དགོས་ན།",
    "མ་དམིགས་པའི་རྟགས་ཀྱིས་རྟགས་དེ་སྒྲུབ་མི་མཐུན་ཕྱོགས་མཐའ་དག་ལ་མེད་པར་ངེས་པར་བྱེད་དགོས་ལ།",
    "དེ་ལྟ་ན་སྐབས་ཀྱི་ཕྱི་རྒོལ་གྱིས་རྟགས་ཀྱི་ལྡོག་ཁྱབ་ངེས་པ་ལ་སྐབས་ཀྱི་ཕྱི་རྒོལ་གྱིས་རྟགས་དེ་ཉིད་གང་ལས་ལྡོག་པའི་གཞི་མི་མཐུན་ཕྱོགས་མཐའ་དག་ངེས་དགོས་པར་འགྱུར་རོ།",
    "ངེས་པར་རྟགས་ཀྱི་ལྡོག་གཞི་མི་མཐུན་ཕྱོགས་མཐའ་དག་ངེས་པ་ལ་ལྟོས་དགོས་པར་མི་འདོད་དེ།",
    "དེ་རྫས་སུ་གྲུབ་པ་ལ་ལྟོས་དགོས་པར་མི་འདོད་ཅེས་སྦྱོར་བ་ནི།",
    "མི་མཐུན་དཔེ་རྫས་སུ་གྲུབ་པར་ཁྱབ་བམ།",
    "རང་བཞིན་མ་དམིགས་པའི་རྟགས་ཀྱི་མི་མཐུན་དཔེ་རྫས་སུ་གྲུབ་པས་ཁྱད་པར་བསྟན་ལ།",
    "བློ་གྲོས་ཀྱིས་ཤཱཀྱ་བློའི་འབྲེལ་བའི་དོན་ཁོང་དུ་མ་ཆུད་པར་ཟད་ཅིང་།",
    "ཅི་རིགས་པ་ཞེས་གསུངས་པས།",
    "ལྡོག་པ་ལ་ཐེ་ཚོམ་ཟ་བ་ལྡོག་ཁྱབ་ཀྱི་སྐྱོན་མ་ཡིན་པར་བསྟན་པ་ཡིན་ནོ།",
    "ཞེས་པའི་སྐབས་སུ་འགལ་སྤོང་དེ་ཉིད་རང་ཉིད་རང་འགྲེལ་དུ་གསུངས་པ་དོན་མེད་པ་དང་ཟློས་པའི་ཉེས་པ་གཉིས་ཀ་རུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "འབྲེལ་བ་དེ་ཉིད་མ་ཤེས་པ་ཤེས་པར་བྱ་བའི་ཕྱིར་དུ་སྟོན་པ་དང་།",
    "གཏན་ཚིགས་འབའ་ཞིག་བརྗོད་པར་ཟད་ཅིང་།",
    "ཁྱབ་པ་མ་དྲན་པ་དྲན་པར་བྱ་བའི་ཕྱིར།",
    "ཁ་ཅིག་དངོས་སུ་དྲན་པ་དེའི་དོན་གྱི་ཤུགས་ཀྱིས་ཅིག་ཤོས་དངོས་སུ་མ་སྨྲས་པ་དེ་ཡང་གོ་ཞིང་དྲན་པར་ནུས་པས་སོ།",
    "ཅིག་ཤོས་ངེས་པར་ཡོད་པའི་ངེས་པ་གང་སྟེ་ངེས་པ་དེ་འདྲ་མི་འཐད་པས་འབྲས་བུ་ཡོད་པས་རྒྱུ་ཡོད་པར་སྒྲུབ་པ་མི་འཐད་པར་འགྱུར་རོ།",
    "བྱས་པ་གྲུབ་ཙམ་ནས་མི་རྟག་པ་ཡིན་པར་འགྱུར་ཏེ།",
    "དེས་ན་བྱས་པ་ཡིན་པས་མི་རྟག་པ་ཡིན་པར་སྒྲུབ་པ་ཁྱབ་པ་འཁྲུལ་བར་འགྱུར་རོ།",
    "བྱས་པ་དེ་མི་རྟག་པ་དང་འབྲེལ་མེད་ཡིན་ན།",
    "མི་རྟག་པ་དེ་བྱས་པའི་རྒྱུའམ་འབྲས་བུ་གང་ཡིན།"
  ]
}