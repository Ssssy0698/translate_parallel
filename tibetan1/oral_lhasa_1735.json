    "དྲན་པ་འདི་ཉིད་ལ་ཡེངས་པར་ཤེས་པས།",
    "མཁས་རྣམས་དེ་ཡིས་རྣམ་པར་གྲོལ།",
    "དྲན་མེད་ཀྱི་དབྱིངས་སུ་ལྡོག་པར་འགྱུར་བས།",
    "ཐོངས་པར་གྱུར་ན་མི་གཡོ་བརྟན་པར་གནས།",
    "མ་རྟོགས་པ་དེ་ཉིད་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ལས་གྲོལ་བས།",
    "ཕྱིས་སེམས་གསོད་ཤེས་པའི་དྲུང་དུ་སེམས་ཐག་བཅད་པར་བྱའོ།",
    "རྟོགས་པའི་རྣལ་འབྱོར་པས་ལྷན་ཅིག་སྐྱེས་པས་ཁྱད་པར་འཕགས་པས།",
    "རྣམ་རྟོག་ཤས་ཆེ་བས་ཡིད་ལ་བྱས་པ་ནི།",
    "དེ་ཡིས་བདག་ཉིད་བརྟན་པར་འགྱུར་བ་ཡིན།",
    "ལུས་ཀྱི་འཆིང་བ་རྣམ་པར་འཆད་པར་འགྱུར།",
    "ལུས་དང་སེམས་ཀྱི་གཙང་བ་འདི་ཁྲུས་དང་དུས་དང་གནས་ཁྱད་པར་ཅན་གྱིས་ལུས་དག་པར་བྱ་ཟེར།",
    "དེ་ཡང་ཟླ་བའི་རྒྱ་མཚོ་ལ་སོགས་པ་ལ་ཁྲུས་བྱས་པས།",
    "ཕྱིན་དེ་བལྟས་པས་རྟོགས་པར་གང་སྨྲ་བ།",
    "འདུས་བྱས་ལ།",
    "གདུང་བས་འབྲས་བུ་མེད་པར་མ་བྱེད་ཅིག།",
    "རིགས་མེད་དེ་ལ་མཆོད་ན་ལས་ཀྱི་མཐའི་ཚོགས་ནི་ཡང་དག་ཟད་པར་འགྱུར།"
  ]
