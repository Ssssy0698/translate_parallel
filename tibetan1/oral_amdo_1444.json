    "མི་བརྟན་པར་བསམས་པའི་རྩེ་མོའི་ཆ་ནི་རྟེན་དང་སྐྱབས་སུ་རུང་བར་འདུག་པས།",
    "རྩེ་མོའི་ཆ་ཉིད་ལ་རྟེན་ཏེ།",
    "ཀུན་དུ་བརྟགས་པ་དང་བྲལ་བ་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་ཕྱིན་ཅི་མ་ལོག་པར་ཡོངས་སུ་གྲུབ་པའི་མཚན་ཉིད་ཅན་གྱི་ལམ་དང་འབྲས་བུར་བཅས་པ་ཅིག་འདོད་ནས།",
    "འོ་ན་རྣལ་འབྱོར་སྤྱོད་པ་དག་གིས་ཀུན་རྟོག་པ་ནི།",
    "དེ་ནི་འདི་ལྟར་རང་གི་གྲུབ་པའི་མཐའ་ཀུན་ཏུ་བརྟགས་པར་འཛིན་པར་ནི་སུའང་མི་བྱེད་དོ།",
    "འདི་ལྟར་བྱེད་པ་སྟ་རེ་ལས་ཤིང་བྱ་བ་དུམ་བུ་གཉིས་སུ་གྱུར་པ་ཡིན་པའི་ཚེ།",
    "སྟ་རེ་རང་ལ་རང་གཅོད་ཅེས་ནི་སྒྲུབ་པར་མི་བྱེད་དོ།",
    "ཉོན་མོངས་དང་།",
    "ཉེ་བའི་ཉོན་མོངས་དང་།",
    "ཀུན་ནས་ཉོན་མོངས་པ་ཅེས་བརྗོད་པ་ན།",
    "མ་འདོམ་པའི་སྐབས་ལ་ལར་ནི་ཐུན་མོང་དུ་གྱུར་པའང་ཡོད་པ་བཞིན་དུ།",
    "གྲོགས་པོ་རྣམས་ལྷན་ཅིག་གནས་པའི་ཀླགས་མེད་དེ་ཞེ་སྡང་གི་ཡུལ་དུ་གྱུར་པ་ལྟ་བུའོ།",
    "རི་བོང་གི་རྭའང་ཀུན་རྟོག་པས་མ་བརྟགས་པས་མི་སྣང་བ་ཡིན་ཏེ།",
    "འདི་ལྟར་རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་བློ་ཕྱིན་ཅི་ལོག་གིས་མཐོང་བ་ནི་བརྟགས་པ་ཞེས་གདགས་སོ།",
    "སྒྲ་འདི་གཉིས་ནི་ཐུན་མོང་ཡིན་ཏེ།",
    "འདི་ལྟར་ཕྱིན་ཅི་ལོག་གིས་མཐོང་བ་ལའང་རྟོགས་པའི་སྒྲ་འཇུག་སྟེ།",
    "དེ་བས་ན་འདི་ལྟར་ཕྱིན་ཅི་ལོག་གི་རྣམ་པར་རྟོག་པའི་བློས་ཀུན་དུ་བརྟགས་པ་ཞེས་བྱ་བ་ནི།",
    "གང་ཞིག་གིས་ཕྱིན་ཅི་མ་ལོག་པའི་བློས་རྟོགས་པར་བཞག་པ་དེ་ཉིད།",
    "གཞན་གྱིས་ཕྱིན་ཅི་ལོག་གི་བློས་བརྟགས་པ་ཡིན་པར་སྒྲུབ་སྟེ།",
    "དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་ཐམས་ཅད་རང་གི་ས་བོན་ལས་སྐྱེའོ་ཞེས་བརྗོད་པ་དང་།",
    "རང་གི་ས་བོན་ལས་སྐྱེ་ཞེས་བརྗོད་པས།",
    "བརྟགས་སྣང་མ་ཡིན་པའི་ཤེས་པ་རང་གི་བདག་ཉིད་ཐོབ་པ་མེད་དོ།",
    "ནང་གི་འཇིག་ཚོགས་ལ་ལྟ་བ་དང་།",
    "ཉོན་མོངས་པ་ཅན་གྱི་ཡིད་འཁོར་དང་བཅས་པའང་མ་དམིགས་བཞིན་དུ་སྤོངས་སོ།",
    "ངག་གི་ལམ་དང་བྲལ་བ་ལས་སྐྱེས་པ།",
    "དེ་ཡང་གང་ཞིག་གིས་ངེས་པའི་དོན་དུ་བསྟན་པ་དེ་གཞན་གྱིས་དྲང་བའི་དོན་དུ་སྟོན་པར་ཡང་བྱེད་ལ།",
    "རྒྱལ་བའི་བཀའ་རྣམས་ལས་ཡོད་པ་དང་མེད་པའི་ཚིག་གིས་བསྟན་པ་ཐམས་ཅད་ཀྱི་དགོངས་གཞི་ནི།",
    "ཡོད་པ་དང་མེད་པའི་ཚིག་གིས་བསྟན་པ་ཐམས་ཅད་ཀྱི་དགོངས་གཞི་ནི།",
    "རྒྱལ་བའི་བཀའ་རྣམས་ལས་ཡོད་པ་དང་མེད་པའི་ཚིག་གིས་བསྟན་པ་ཐམས་ཅད་ཀྱི་དགོངས་གཞི་ནི།",
    "དེ་ལ་མན་ངག་གིས་དོན་གཏན་ལ་ཇི་ལྟར་ཕབ་ཅེ་ན།",
    "སྒྲ་འདི་རྣམས་ཀྱང་རེས་འགའ་ནི་དོན་གྱི་བྱེ་བྲག་མེད་པར་སྟོན།",
    "རེས་འགའ་ནི་ཚིག་གི་སྒོ་ཇི་ལྟ་བ་བཞིན་དུ་ཚིག་གི་ཡུལ་སོ་སོར་ཡོད་པར་སྟོན་ཏེ་སྐབས་ཀྱིས་སྦྱར་རོ།",
    "བདག་ཅག་གི་གྲུབ་པའི་མཐའ་འདི་དག་ནི།",
    "འདུ་བྱེད་སེམས་པ་དང་མཚུངས་པར་ལྡན་པ་གང་གིས།",
    "གང་གི་ཚེ་འཁོར་ལོར་སྣང་བ་དེའི་ཚེ་འགལ་མེར་མི་སྣང་ངོ།",
    "གང་གི་ཚེ་འགལ་མེར་སྣང་བ་དེའི་ཚེ་འཁོར་ལོར་མི་སྣང་ངོ།",
    "དོན་འདིས་རྫོགས་པ་ཆེན་པོའི་ཚུལ་ལས་ཉོན་མོངས་པ་ཉིད་རྣམ་པར་གྲོལ་བའི་ལམ་ཆེན་པོ།",
    "ལས་ཉིད་རང་བྱུང་གི་ཡེ་ཤེས།",
    "རང་བྱུང་གི་ཡེ་ཤེས་དང་།",
    "དེ་ལ་གཅིག་པའི་ཐ་སྙད་ཐམས་ཅད་ཀྱང་དུ་མ་བློ་ཟློག་པར་འདྲ་མོད་ཀྱི།",
    "མི་དམིགས་པའི་བྱེ་བྲག་གིས་ཕྱེ་བ་ཡིན་ནོ།",
    "ཀ་བ་བྱས་པ་ནི་ཀ་བ་རང་གི་ངོ་བོ་ལ་གནས།",
    "བུམ་པ་བྱས་པ་ནི་བུམ་པ་རང་གི་ངོ་བོ་ལ་གནས་ཏེ།",
    "རང་རང་གི་མཚན་ཉིད་ཅན་ཡིན་པར་དམིགས་ཀྱང་།",
    "གཉིས་ག་ཡང་བདག་དང་བདག་གི་མཚན་ཉིད་ཀྱིས་སྟོང་པའོ་ཞེས་བརྗོད་ན།",
    "གཅིག་བརྒྱ་ཞེས་གཅིག་གི་ཐ་སྙད་འཇུག་པ་བཞིན་ནོ།",
    "གཉིས་ནི་མེད་དོ་གཅིག་ནི་ཡོད་དོ་ཞེས་དངོས་པོ་གཅིག་གི་བློ་མི་གཏོང་བ་འདི་ནི་གྲངས་ཀྱི་གཅིག་པ་ཞེས་བྱའོ།",
    "དེ་ལ་གང་དག་རང་གི་གྲུབ་པའི་མཐའ་སྒྲུབ་པར་འདོད་ཅིང་།",
    "གང་ཟག་གིས་སྟོང་པའི་ཕུང་པོ་ཡོད་པར་སྟོན་པར་ནི་མི་བྱེད་པའོ།",
    "གང་ཟག་གིས་སྟོང་པའི་ཕུང་པོ་སྟོན་པར་བྱེད་པ་ལྟ་བུའོ།",
    "རང་གི་གྲུབ་པའི་མཐའ་འང་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་དག་གི་གཞི་ཡང་རྣམ་པ་གཉིས་ཏེ།",
    "དེ་དག་གི་གཞི་ཡང་རྣམ་པ་གཉིས་ཏེ།",
    "བློ་འདི་གཉིས་ནི་རང་བཞིན་གྱིས་ལྡན་མོད་ཀྱི།",
    "འདི་ལྟར་གྲངས་ཀྱིས་མ་ཕྱེ་རྒྱ་ཆེ་ཆུང་གིས་མ་ཕྱེ་སྟེ།",
    "ཇི་ཙམ་དུ་མིང་གིས་ཁྲིད་པའི་དོན་དེ་ལ་ངོ་བོ་ཉིད་ཅེས་བྱའོ།",
    "དེ་བས་ན་རྣམ་པར་རྟོག་པའི་བློ་གང་གིས་མིང་དང་མིང་ཅན་བསྲེས་ཏེ་གཅིག་དུ་ཞེན་པར་བྱས་ནས།",
    "ངོ་བོ་ཉིད་དེ་ལ་བརྟེན་ནས་བྱེ་བྲག་གང་གིས་ངོ་བོ་ཉིད་དེ་རྣམ་པར་ཕྱེ་སྟེ་ཁྱད་པར་དུ་བྱས་པས་ཁྱད་པར་ཞེས་བྱའོ།",
    "མེ་ཏོག་གི་ཟེའུ་འབྲུ་ཉིད་ཀྱང་མེ་ཏོག་ཡིན་མོད་ཀྱི།",
    "མེ་ཏོག་གི་སྤྱི་ཟེའུ་འབྲུས་འབྱེས་པར་བྱེད་པ་ལྟར།",
    "དཔེ་བྱད་ཉིད་ཀྱང་མཚན་གྱི་ཁོངས་སུ་གཏོགས་མོད་ཀྱི།",
    "བུམ་པ་མི་རྟག་ཅེས་བྱ་བ་ལྟ་བུ་ཚིག་གང་གིས་ངོ་བོ་ཉིད་དེ་བྱེ་བྲག་དུ་འབྱེད་པར་བྱེད་པས་དེ་སྐད་དུའོ།",
    "ཁྱད་པར་གྱི་ཚིག་གང་གིས་ངོ་བོ་ཉིད་དེ་བྱེ་བྲག་ཏུ་འབྱེད་པར་བྱེད།",
    "བུམ་པ་དང་རེ་ལྡེ་དང་རྟ་དང་གླང་པོ་ལ་སོགས་པ་ཐ་དད་དུ་སྒྲུབ་པར་བྱེད་དོ།",
    "བུམ་པའི་ངོ་བོ་ཉིད་གཅིག་ལ་ཁ་དོག་དང་དབྱིབས་དང་རེག་བྱ་དང་མཚན་ཉིད་དག་སོ་སོར་འབྱེད་དོ།",
    "གཟུགས་ནི་བོང་ཚོད་ཀྱིས་མི་ཐུབ།",
    "རང་གི་གྲུབ་པའི་མཐའ་ནི་རིལ་པོར་འཛིན་པའི་བློས་ངོ་བོ་ཉིད་གཅིག་གི་རྫས་ཡོད་པར་བསྒྲུབས།",
    "རྫོགས་པ་ཆེན་པོའི་ཚུལ་ལ་རིགས་པ་དེ་དག་གིས་ཕྱོགས་ཆ་ཙམ་དུའང་སླེབས་པ་མེད་དེ།",
    "དཔེར་ན་རྒྱ་མཚོ་ཆེན་པོའི་གཏིང་དང་ནམ་མཁའི་མཐའ་མདའ་རྒྱང་དང་མིག་རྒྱང་གིས་གཞལ་བར་འདོད་པ་བཞིན་ནོ།",
    "རས་ཡུག་གི་དཀར་པོ་བྱ་བ་ལྟ་བུ་ཡོད་པ་དང་ཡིན་པར་སྟོན་པའི་རྐྱེན་མེད་པའང་དོན་དེ་ལས་མི་འདའོ།",
    "གཞན་ཡང་རིགས་པ་ཉིད་ཐལ་བར་གྱུར་ནས་སླར་གནོད་པ་དམིགས་པར་ཟད་དེ།",
    "མེ་ཤེལ་ལ་ཚ་བའི་རེག་པ་ཡོད་པ་ལྟ་བུའོ།",
    "རིགས་པ་བཞིའི་ཐལ་བ་ནི།",
