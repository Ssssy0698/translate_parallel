    "ཉོན་མོངས་པའི་འཆིང་བར་གྱུར་ན་སྒྲིབ་པར་བསྟན་པའོ།",
    "དེ་བས་ན་རང་གི་རང་བཞིན་རང་བཞག་ན་བདེ་བ་ཆེན་པོར་རང་གནས་བཞིན་དུ།",
    "ཀུན་ཏུ་བཟང་མོ་ཡིན་པ་དང་།",
    "ཅིར་སྣང་ཡང་རང་གི་ངོ་བོ་མ་གྲུབ་པས།",
    "ཀུན་ཏུ་བཟང་མོ་ཡིན་པ་ཞེས་བྱའོ།",
    "དེ་ལ་མན་ངག་གི་རྩ་བ་གསུམ་ནི།",
    "བློ་ལ་བཅད་པའི་མན་ངག་གི་དམ་པ་ཡིན་ཡང་།",
    "ལུང་གི་སྒྲ་ལ་རྟེན་པའང་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དཔལ་རྡོ་རྗེ་སེམས་དཔའ་གཉིས་པ་ཡིན་པ་དེའི་ཕྱིར་རོ།",
    "དེ་ལ་ཤེས་བཞིན་ནི་དྲན་པ་དང་ཤེས་རབ་ཀྱི་བྱེ་བྲག་གང་གིས།",
    "དེ་ལྕགས་ཀྱུ་དང་ལྕགས་ཐག་གིས་མ་ཟིན་ན།",
    "འདོད་ཆགས་ལ་སོགས་པ་ཉོན་མོངས་པ་རྣམས་དང་།",
    "བྱིང་རྒོད་ལ་སོགས་པ་ཉེ་བའི་ཉོན་མོངས་པ་རྣམས་ཀྱི་རྒུན་ཆང་འཐུངས་ཏེ།",
    "ཤིན་ཏུ་འཁྲུགས་ཤིང་ཉོན་མོངས་པར་གྱུར་པ་ལ།",
    "དེ་ལྟར་རེ་དོགས་ཆེན་པོ་གཉིས་ཡོད་པས།",
    "རེ་དོགས་ཀྱི་བློ་དང་བྲལ་བས་བསྲུང་བ་དང་མི་བསྲུང་བ་གཉིས་མེད་པར་རྟོགས་པའི་བློ་དང་ལྡན་པ་སྟེ།",
    "གཟུངས་ཀྱིས་ཟིན་ཅིང་དུལ་བས་ཡུལ་སྲུང་བའི་རེ་བའི་བློའང་མི་སྐྱེ་སྟེ།",
    "དེ་ལ་བཏང་སྙོམས་ནི་ཉོན་མོངས་པ་མེད་པར་གནས་པའི་བློ་གང་ཞིག།",
    "མ་བཅོས་པའི་ངང་ལ་ལྷུན་གྱིས་གནས་པ་ཙམ་མོ།",
    "ཕན་འདོགས་པར་ཡང་མི་རེ་བས་རེ་དོགས་དང་བྲལ་བའི་བློ་དང་ལྡན་པ་བཞིན་དུ།",
    "ད་ནི་དོན་དེ་དག་ཉིད་ལུང་གི་ཁུངས་ཀྱི་སྒོ་ནས་བསྟན་ན།",
    "དེ་བས་ན་གཞུང་གི་ཚོགས་ཀྱི་ཚིག་གིས་བསྟན་ཏོ།",
    "རྨི་ལམ་དག་གི་བདེ་དང་སྡུག་བསྔལ་ཡང་།",
    "རང་བཞིན་ཉིད་ནི་ཡོང་གིས་བཅོས་མི་དགོས།",
    "ད་སུ་ཞིག་གིས་གང་ཞིག་བསྒོམ།",
    "གང་གིས་ཤེས་ནས་རྩོལ་བ་ཀུན་སྤངས་ཏེ།",
    "སྤང་བླང་གི་རྩོལ་བ་ཐམས་ཅད་ངང་གིས་ཞི་སྟེ།",
    "སེམས་ཀྱི་རྟོག་པ་བྱུང་ཚོར་སྣ་ཚོགས་སྐྱེ་བ་ཇི་ལྟར་བྱ་ཞེ་ན།",
    "མ་བཅོས་མ་བྱས་རང་གི་ངང་གིས་གསལ།",
    "སུས་ཀྱང་མ་བྱས་པར་རང་གི་ངང་གིས་གསལ་བར་བཞག་གོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དངོས་པོ་རྣམས་ཀྱི་མཐའ་ཞིབ་མོའི་བློས་བརྟགས་ན།",
    "གང་གིས་གང་ལ་བསྒོམས་པས་འབྲས་བུ་ཅི་ཞིག་འཐོབ་སྟེ།",
    "རྣམ་བྲལ་གང་ལ་མཆོག་དང་ཐ་མ་མེད་པའི་ལམ་མཆོག་འདི་བསྒོམ་མོ།",
    "རང་གི་ངོ་བོ་མ་གྲུབ་པས་རྗེས་སུ་མི་འབྲང་སྟེ་རང་ཞིར་གཞག་པའི་དོན་གསུངས་པ།",
    "འོན་ཀྱང་དེ་དག་གིས་འཇིགས་པར་མི་བྱའོ།",
    "གང་གི་ཕྱིར་འཇིགས་པ་ཐམས་ཅད་སེལ་བ་ནི་སྟོང་པ་ཉིད་ཡིན་ཏེ།",
    "སེམས་ལའང་དངོས་པོ་མེད་པས་རྟོག་པ་ངང་གིས་མེད་དེ།",
    "རྣལ་འབྱོར་གྱི་སྐྱེས་བུ་གང་གིས་དོན་དེ་རྟོགས་ཤིང་རྡེང་དུ་གྱུར་ཏེ།",
    "དེ་ཉིད་རྣལ་འབྱོར་གྱི་སྐྱེས་བུ་གང་གིས་རྟོགས་ཤིང་རྡེང་དུ་གྱུར་པས།",
    "ཇི་སྲིད་དུ་འཁྲུལ་རྟོག་གི་རྐྱེན་མ་ཟད་པ་དེ་སྲིད་དུ།",
    "གཞན་ཡང་སྣང་རྟོག་གི་རྗེས་སུའང་འབྲང་དུ་མེད་པར་སྟོན་ཏེ།",
    "དེ་ལྟ་བུའི་བློ་གང་གིས་མཚན་མ་མེད་པ་ལའང་གནས་རྟེན་མི་འཆའ་ན།",
    "དཔེར་ན་ནམ་མཁའ་ནི་རང་གི་མཚན་ཉིད་མེད་པའི་ཕྱིར།",
    "ལུས་ངག་གི་འདུ་བྱེད་ཐམས་ཅད་ཀྱང་དེ་འདྲའོ།",
    "བསྔོ་བའི་ཆ་ཤས་འཕྲ་མོའི་ཡུལ་ལས་བྱུང་བ་སྟེ།",
    "བསྔོ་བའི་ཆ་ཤས་འཕྲ་མོ་དང་མ་བྲལ་ཞིང་།",
    "ཆ་ཤས་འཕྲ་མོ་ཞེས་བྱ་བ་ནི།",
    "རེ་སྨོན་ཀྱི་མཐའ་ལ་གནས་པས་བླང་དོར་གྱི་མཐར་ལྷུང་བའི་བློ་ཉིད་རྣམ་པར་རྟོག་པ་ཡིན་ནོ།",
    "འཁྲུལ་སྣང་གི་ངོ་བོ་ཉིད་གང་ཡིན་པ་དེ་ཉིད་ངོ་བོ་ཉིད་ཀྱི་སྐུ་ཞེས་བྱ།",
    "སེམས་རང་གི་ངོ་བོར་མ་གྲུབ་པས་རྟོག་པ་རང་བཞིན་གྱིས་མེད་དེ།",
    "རང་བྱུང་གི་ཡེ་ཤེས་རང་ཤར་པ་ཡིན་ནོ།",
    "དཔེར་ན་རི་བོང་གི་རྭ་ཞེས་བརྗོད་ན།",
    "རི་བོང་གི་རྭ་གཏན་མེད་པའི་ཕྱིར།",
    "དེ་བས་ན་རི་བོང་གི་རྭའི་དོན་དང་རི་བོང་གི་རྭའི་སྒྲ་གཉིས་དོན་མེད་པ་དང་དོན་ལ་བརྗོད་པ་མ་མྱོང་བས་དངོས་པོར་མ་གྲུབ་པར་འདྲའོ།",
    "གང་གི་ཕྱིར་ནམ་མཁའ་ནི་ངོ་བོ་ཉིད་མེད་པའི་ཕྱིར་མ་སྐྱེས།",
    "སེམས་འཛིན་འཕྲ་མོ་དེ་ལ་ཡོད།",
    "སྨིགས་རྒྱུ་ལ་བསམས་ཏེའང་སྨིགས་རྒྱུ་ཁྱོད་རྟེན་གང་ལ་ཡང་མ་གནས་ཤིག།",
    "ནམ་མཁའ་ཁྱོད་ནམ་མཁའི་རང་བཞིན་དུའང་མ་གནས་ཤིག།",
    "སྨོན་པ་མེད་པའི་ཏིང་ངེ་འཛིན་སྡུག་བསྔལ་སེལ་བའི་མཚན་ཉིད་རྣམས་བསྒོམ་མོ།",
    "ཐམས་ཅད་དུ་རང་གི་ངོ་བོ་གྲུབ་པ་མེད་པར་རྟོགས་པས།",
    "གང་ང་མེད་པ་རྣམས་ཀྱི་ནི་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་གི་རང་བཞིན་ཉིད་རྣམ་པར་གྲོལ་བ་ཡིན་ནོ།",
    "བདག་གིས་ཉོན་མོངས་པ་ཐམས་ཅད་སྤངས་སོ་སྙམ་དུ་རློམ་སེམས་ཡོད་ནའང་།",
    "འཕགས་པ་ཀུན་ཀྱིས་གཟིགས་པའི་ཡུལ་དང་གྲུབ་པའི་གནས་ཀྱང་།",
    "སྤང་བླང་གི་བློ་ཆ་ཤས་འཕྲ་མོ་ཙམ་ཡོད་པ་དེ་སྲིད་དུ།",
    "ལམ་གྱི་རང་གི་ངོ་བོ་མ་ཡིན་ནོ།",
    "གཟུགས་དང་ཚོར་བ་འདུ་ཤེས་དང་།",
    "ཇི་ཙམ་རྟོག་མེད་ཟབ་མོ་ཞིག།",
    "མི་རྟོག་ཟབ་མོའི་ཉམས་མྱོང་བ།",
    "དུས་གང་གི་ཚེ་རྣམ་པར་མི་རྟོག་པའི་དོན་ཟབ་མོ་གཞན་ལ་བསྟན་པའི་ཐབས་མེད་པ་ཞིག།",
    "རང་གི་བློས་ཉམས་སུ་མྱོང་ངོ་ཞེ་ན།",
    "དཔེར་ན་ལན་ཚའི་རོ་ནི་མི་དང་དུད་འགྲོ་ཕལ་མོ་ཆེས་ཀྱང་ཐུན་མོང་དུ་ཉམས་སུ་མྱོང་བ་ཡིན་མོད་ཀྱི།",
    "ཟབ་མོའི་གྲངས་སུ་མི་ཆུད་དེ་རྣམ་པར་རྟོག་པ་ཞིག་དུ་ཟད་དོ།",
    "གཅིག་པུར་སྨྲ་བའི་བྱེ་བྲག་གིས་ཅུང་ཟད་ཐ་དད་པར་བཞག་པའང་ཡོད་ན།",
    "རྒྱ་མཚོ་ཆེན་པོའི་སྟེང་གི་བར་སྣང་ལ་བྱ་འཕུར་བའི་རྒྱ་མཚོའི་ནང་ན་གནས་པ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཀྱི་སྤྱན་ཀྱིས་གཟིགས་ན་མི་གཡོ་བ་མ་ཡིན་ནོ།",
    "གཞན་ཡང་ཤེས་བྱའི་སྒྲིབ་པའི་རང་གི་ངོ་བོ་ཡང་།",
    "མཉམ་བཞག་གི་དུས་ན་སེམས་གནས་པ་ཐོབ་པ་ན།",
    "དེ་བཞིན་གཤེགས་པའི་རང་བཞིན་མཐོང་ནི་མཐོང་གི་ལེགས་པར་མ་མཐོང་ངོ།",
    "ཉན་ཐོས་རྣམས་ནི་ཞི་གནས་ཀྱི་ཤས་ཆེ་ལ་ལྷག་མཐོང་གི་ཤས་ཆུང་བས།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ནི་ཞི་གནས་དང་ལྷག་མཐོང་ཟུང་དུ་འབྲེལ་བས་ལེགས་པར་གཟིགས་སོ།",
    "སྣང་རྟོག་མངོན་དུ་རྒྱུ་ལོག་པ་ཙམ་ལ་རེ་ཤིག་ཚད་བཞག་པར་ཟད་དེ།",
    "གང་གི་ཚེ་ཏིང་ངེ་འཛིན་ལས་ལངས་པའི་དུས་ནའང་།",
    "རང་གི་སེམས་ཀྱི་རང་བཞིན་ཇི་ལྟ་བ་བཞིན་རྟོགས་ཤིང་གོམས་པར་བྱས་པ་ཁོ་ན་མ་ནོར་བའི་ལམ་ཡིན་པས།",
    "ཐབས་དང་ཤེས་རབ་ཀྱི་སྤྱོད་པ་ཟབ་མོས་གྲོལ་བར་མཛད་པས།",
    "ཀུན་ཏུ་བཟང་མོ་ཡིན་པ་དང་།",
    "ཐབས་དང་ཤེས་རབ་ཟབ་མོའི་མཛད་སྤྱོད་ལ་མངའ་བརྙེས་པའི་དོན་ཏོ།",
    "འགྲོ་བ་རྣམས་ཀྱི་ཐུན་མོང་གི་སྤྱོད་པ་འདི་ཉིད་ཡིན་མོད་ཀྱི།",
    "དེ་ལྟར་མི་སྣང་ཡང་ཐབས་དང་ཤེས་རབ་ཀྱི་རང་བཞིན་ནི་ཡན་ལག་སྤྲོས་པ་བཞིན་དུ་ཐུན་མོང་དུ་ཁྱབ་པས།",
    "སྒྱུ་མཁན་རི་མོའི་རྣམ་པ་བཞིན།",
    "རི་མོའི་རྣམ་པ་གཞི་མཐོན་དམན་མེད་བཞིན་དུ།",
    "དམིགས་པ་དང་བཅས་ཅིང་འབྱུང་འཇུག་གི་རྟོག་པ་དང་བཅས་པའི་སྒྲིབ་པས།",
    "རང་གི་ཉེ་བར་ལེན་པའི་འདུ་བྱེད་བཀག་ནའང་སེམས་ཉིད་ཀྱང་འགག་པའམ་འགག་པ་ལ་ཐུག་པར་འགྱུར་བས།",
    "དེ་བས་ན་འདུ་བྱེད་གཞན་བཀག་ལ་རང་གི་འདུ་བྱེད་མི་དགག་གོ།",
    "ལྷག་མཐོང་གི་སྒྲིབ་པ་གསུམ་ལ།",
    "བྱུང་ཚོར་སྐྱོན་ལྔ་སྤང་བར་བྱ།",
    "བྱུང་ཚོར་གཉིས་སུ་སྣང་བའང་།",
    "ཕྲ་རགས་ཀྱི་བྱེ་བྲག་དང་རྣམ་པའི་བྱེ་བྲག་གིས་ཁྱད་པར་དབྱེ་སྟེ།",
    "བྱུང་ཚོར་ནི་འབྱུང་འཇུག་གིས་ཕྱེ།",
