    "སུམ་ཅུ་པའི་གཞུང་དུ་གཙོ་བོར་རྗེས་འཇུག་གི་བྱ་བ་འཆད་པ་ཡིན་པར་གསུངས་པ་ནི་དོན་ལ་གནས་སོ།",
    "རྗེས་འཇུག་གང་གིས་ཚིག་ཕྲད་གང་སྐྱེད་པ་དང་།",
    "དེས་དོན་གང་གསལ་བར་བྱེད་པ་བསྟན་པ་དང་གཅིག་ལྷག་བཅས་ཀྱི་སྟེཡིག་གི་ས་མགོ་གཙོར་བྱས་ཏེ་བསྟན་པ་དང་གཉིས།",
    "རྗེས་འཇུག་གི་དགོས་པ་གལ་ཆེ་བར་ནན་གྱིས་བསྟན་པ་དང་གསུམ་གྱིས།",
    "གཞུང་འདིའི་བསྟན་བྱ་གཙོ་བོ་རྗེས་འཇུག་གི་རྣམ་གཞག་ཡིན་པ་ཤེས་ཐུབ་བོ།",
    "རྗེས་འཇུག་འ་ཡིག་གི་མཐའ་ལ་ས་དྲག་སྦྱོར་གྱིན་ཡོད་ཀྱང་།",
    "ཕྱི་ནང་གི་བློན་པོ་རྣམས་ལ་བཀའས་རྨས།",
    "ལྷ་སྲས་ལྡེ་སྲོང་གྀ་སྐྱ་རིང་ལ་རྗེ་བློན་མོལ་ཏེ།",
    "དོན་གྱི་འཁྲུལ་བ་སྤོང་ཕྱིར་རྗེས་འཇུག་འ་ཡིག་གི་མཐར་ས་དྲག་སྦྱོར་བ་དོར་པར་གྱུར་ཀྱང་།",
    "རྗེས་འཇུག་དེ་དག་ས་དྲག་གི་འཇུག་ཡུལ་དུ་མཚུངས་ཤིང་།",
    "སྟེ་ཡིག་རྗེས་འཇུག་དེ་དག་དང་ཚེག་བར་ཕྱེ་ཚེ་སྟེ་ཡིག་རང་དང་བར་ཚེག་མ་ཕྱེ་ན་ས་ཡིག་གཅིག་གིས་མིང་སྔ་མའི་ཡང་འཇུག་དང་ཚིག་ཕྲད་ཕྱི་མའི་མགོ་ཅན་གྱི་གོ་ཆོད་པར་བྱས་པས་མཚོན་ཕྱིར།",
    "གི་དང་འི་སོགས་ཀྱིས་དུས་ཡུན་རིང་པོ་ཞིག་ལ་བྱེད་སྒྲ་དང་རྒྱན་སྡུད་ཀྱི་དོན་ཡང་སྟོན་པ་རིམ་གྱིས་ཚིག་ཕྲད་ཀྱི་སྒྲ་དོན་གཉིས་ཀ་ཇེ་ཞིབ་ཏུ་ཕྱིན་པ་ལས།",
    "འབྲེལ་སྒྲའི་ནང་གསེས་གི་ཡིག་གི་ཨཱ་ལི་ཕྱིས་ཏེ་རྗེས་འཇུག་ང་ཡིག་སྦྱར་པའི་གང་སྒྲའང་རྒྱན་སྡུད་ཀྱི་དོན་ལ་འཇུག་པའི་བཟོ་ལྟ་གསལ་ཡང་།",
    "གནའ་དེང་གི་བོད་སྐད་གང་ལའང་གང་སྒྲ་རྒྱན་སྡུད་ཀྱི་དོན་ལ་འཇུག་པ་མེད་པས།",
    "སུམ་ཅུ་པའི་གཞུང་གི་དོན་གྱི་ཞིབ་ཆ་ལ་ནན་ཏན་བྱ་དགོས་སོ།",
    "དེ་ལས་ལྡོག་ན་ཚིག་ཕྲད་ཀྱི་སྒྲ་དེ་རང་གི་ངོས་ན་བསྟན་དོན་ངེས་ཅན་ཡོད་མེད་ཀྱི་ཁྱད་པར་གསལ་པོར་མཆིས་ཏེ།",
    "དོན་ཐོབ་ལྟར་རྗེས་འཇུག་གང་ཞིག་གི་རྗེས་སུ་སྦྱར་ན།",
    "སུ་དང་དུ་ཞེས་པ་བསྟན་བྱ་ངེས་པ་ཅན་དུ་སྣང་བས་སྐད་རིགས་གཞན་དུ་མིང་གི་གྲས་སུ་བཞག་ཀྱང་།",
    "སྒྲ་གང་ཞིག་གི་ངོས་ན་བསྟན་དོན་ངེས་ཅན་རེ་ཡོད་ཚེ།",
    "གང་མིང་གི་ནི་ཡ་མཐའ་རུ།",
    "དེ་ཡང་སྟེ་དང་ཏེ་ཡིག་གི་ཟླ་ལ་དྲངས་ཏེ་ལྷག་བཅས་ཀྱི་ཚིག་ཕྲད་དུ་བྱས་པ་ནི།",
    "དེ་ཉིད་རང་གི་སྒྲ་མཐུན་པ།",
    "ཞེས་གསུངས་པ་ལྟར་སྔ་མ་རྗེས་འཇུག་གི་ནུས་པས་རྟགས་མཚུངས་དང་བརྗོད་བདེ་གང་རུང་གིས་རྗེས་འཇུག་ན་ར་ལ་ས་དང་།",
    "ད་དྲག་གི་མཐར་ཏེ་ཡིག་དྲངས་པས་དེ་ཡང་འདིར་དྲངས་པ་དང་།",
    "གང་ཞིག་གིས་ནི་སྔ་མ་ལ།",
    "རྗེས་འཇུག་ད་དང་ཡང་འཇུག་ད་ཡིག་གི་ཁྱད་པར་ཞིབ་ཏུ་ཕྱེ་སྟེ།",
    "དེ་དག་གི་རྗེས་སུ་ཚིག་ཕྲད་གང་ཞིག་སྦྱོར་བའི་ཞིབ་ཆ་བསྟན་ན་ཡང་།",
    "རྗེས་འཇུག་ས་དང་ཡང་འཇུག་ས་ཡིག་གི་ཁྱད་པར་མ་ཕྱེ་བར།",
    "ད་བ་ས་ཀྱི་ག་ང་གི།",
    "དེ་དག་གི་མཐར་ཚིག་ཕྲད་སྦྱར་ཚེ་ཁྱད་པར་ཡོད་མེད་ཀྱི་དོགས་པ་འཆིང་གིན་ཡོད་པས།",
    "ཞེས་པའི་དྲག་མཐའ་ནི་ད་དྲག་དང་ས་དྲག་གཉིས་ཀ་ལ་བྱས་ཀྱང་མི་རུང་བ་མེད་མོད།",
    "ས་མཐའ་དང་ས་དྲག་གི་ཚིག་ཕྲད་ལ་ཁྱད་པར་མེད་པས།",
    "དེ་ལྟ་བུ་མ་གཏོགས་ས་མཐའ་དང་ས་དྲག་གི་མཐར་སྦྱར་རྒྱུའི་ཚིག་ཕྲད་རྣམས་ལ་རྣམ་ཀུན་ཁྱད་པར་མེད་པས།",
    "ཡི་གེའི་འབྲུ་ནི་རེ་རེ་བཞིན།",
    "མཆུ་མ་རེག་ཙམ་དུ་ཟུམ་ཞིང་འཕང་སྨད་དེ་འབྱིན་པའི་རྣམ་པ་ཡི་གེར་བྲིས་པ་ནི་སྟེ།",
    "དེ་ནི་མིང་གཞི་དག་གི་ཞབས་ལ་སྦྱོར་ཞིང་བཀུག་པའི་རྣམ་པར་འབྱིན་པས་ཀྱུ་སྟེ་ཞབས་ཀྱུར་བཏགས་པ་ཡིས།",
    "དེ་དག་ལ་བཞིའི་གཟུགས་བྱས་པ་ནི་སྒྲ་དེ་དག་གི་འབྱིན་སྟངས་དང་།",
    "ན་རོ་ཞེས་པ་ནི་ཡི་གེའི་གཟུགས་རིས་ཀྱི་མིང་ཙམ་མོ།",
    "བྱེད་སྒྲ་དང་བྱེད་པ་པོ་གཞན་དང་འབྲེལ་བའི་ལས་ཚིག་གི་བར་ན་འབྲེལ་བ་ཇི་འདྲ་ཡོད།",
    "ཞེས་གིས་ཀྱིས་གྱིས་འིས་བཞི་དང་།",
    "གིས་སོགས་ཀྱི་སྒྲ་སྦྱར་པ་ཐམས་ཅད་ལ་བྱེད་པ་པོ་རུ་འདོགས་པ་མ་ཡིན་པར།",
    "གིས་སོགས་དང་མཐར་སྦྱར་འོག་མའི་མིང་དོན་གྱིས་གང་ལ་སྦྱར་བྱའི་མིང་དེ་བྱེད་པ་པོའམ་བྱེད་པའི་དོན་དུ་བསྒྲུབས་པ་དང་།",
    "གིས་སོགས་བྱེད་སྒྲ་སྦྱར་པ་ནི་བྱེད་པ་པོ་གཞན་གྱིས་སྒྲུབ་པའི་བྱ་བྱེད་ཐ་དད་པའི་ལས་ཚིག་ཡིན་པས།",
    "གིས་སོགས་སྒྲ་ཡིས་བྱེད་པོ་སྒྲུབ་བྱེད་ན།",
    "དེ་ནི་བྱེད་པ་པོའམ་བྱེད་པ་ཞིག་གིས་སྒྲུབ་པ་སྟོན་ན།",
    "བྱེད་པའི་སྒྲ་ཡོད་ན་བྱེད་པ་པོའི་སྒྲ་ཞིག་ཅིས་ཀྱང་ཡོད་པའང་ངེས་པར་གིས་སོགས་བྱེད་པའི་སྒྲ་སྦྱར་བ་ལ་ལྟོས་ཕྱིར།",
    "གིས་སོགས་བྱེད་པའི་སྒྲ་ངེས་པར་སྦྱར་བའི་བྱ་བ་ཞིག་ཡིན་ན།",
    "གིས་སོགས་བྱེད་སྒྲ་ནི་བྱེད་པ་པོ་གཞན་དང་འབྲེལ་བའི་ལས་ཚིག་ཡིན་མིན་ལ་དཔྱོད་བྱེད་ཀྱི་རྟགས་མཚན་གལ་ཆེན་ཞིག་ཡིན་པར་མ་ཟད།",
    "ཚིག་དེ་རིགས་ཀྱི་འགྲུབ་རྒྱུ་གལ་ཆེ་བ་ཞིག་ཀྱང་རེད་དོ།",
    "མོ་ནི་བདག་དང་མ་འོངས་ཕྱིར།",
    "ཤིན་ཏུ་མོ་ནི་མཉམ་ཕྱིར་རོ།",
    "ཚེ་ཏན་ཞབས་དྲུང་མཆོག་གིས་ཀྱང་།",
    "བྱ་བ་རིགས་གཉིས་ཀྱི་ཁྱད་པར་གིས་སུམ་ཅུ་པའི་སྐོར་གྱི་དྲི་བ།",
    "བྱ་བ་གང་ཞིག་བྱེད་པ་པོ་གཞན་ཞིག་གིས་སྒྲུབ་པ་ཡིན་ན།",
