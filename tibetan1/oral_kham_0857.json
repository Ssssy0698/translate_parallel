    "སྒྲུབ་པའི་གཏོར་མ་ཡང་རང་ཁོ་ནས་དངོས་གྲུབ་དུ་བླང་།",
    "ཡང་རང་ཉིད་བསྡད་ཡོད་པ་འི་རི་བོ་ནི་ཚུར་རི་ལྟ་བུར་སྣང་ལ་མི་དེས་དེ་ལ་ཚུར་རི་ཞེས་བརྗོད་པར་མ་ཟད་བློས་ཀྱང་ཐག་གཅོད་པ་ནི་མངོན་སུམ་བསྙོན་དུ་མེད་པ་ཞིག་ཏུ་ཟད་པ་ཁོ་ནའོ།",
    "གལ་སྲིད་ཁོ་རང་མི་གཙང་བ་ཟ་བའི་རིགས་ཡིན་པས་སྐྱོན་མེད་ཟེར་ན།",
    "གོ་དོན་ཆ་ཚང་ཞིང་རང་རྐྱ་འཕེར་བའི་གཞུང་ལུགས་ཤིག་མ་བྱུང་།",
    "ངན་འགྲོའི་གཡང་ལས་སྐྱོབ་པ་ཀྱི་ཡོན་ཏན་གཉིས་དང་ལྡན་པ་ཞིག་དགོས་པར་བསྟན་འདུག་གོ།",
    "ལུང་ཞེས་པ་རྗོད་བྱེད་ཙམ་ལ་གོ་དགོས་འདུག་དེའི་ཁོངས་སུ་བཀའ་དང་བསྟན་བཅོས་གཉིས་འདུ་སྟེ།",
    "མཇུག་བསྡུ་བ་སོགས་ཚིག་ཟིན་ལ་དངོས་སུ་བཀག་འདུག་པ་དང་།",
    "བཅུ་པ་རྩོད་པ་གཉིས་ཚིག་ཟིན་ལ་དངོས་སུ་བཀག་འདུག་པ་དང་།",
    "བཅུ་དྲུག་པ་ཚར་གཅོད་སོགས་ཀྱང་ཚིག་ཟིན་ལ་དངོས་སུ་བཀག་འདུག་གོ།",
    "དག་པའི་མངོན་སུམ་དང་བཞི་གསུངས་འདུག་ཀྱང་།",
    "ཅ་ཅོ་ཆེ་བ་ལས་འདོད་ཆགས་དང་བྲལ་བ་མ་ཡིན་པ་ཞེས་སོགས་ཀྱིས་རིམ་པ་ལྟར་འབྲས་རང་མ་དམིགས་པའི་རྟགས་ཡང་དག་གསུམ་བསྟན་འདུག་གོ།",
    "མངོན་རྗེས་ཀྱི་མཚན་ཉིད་དངོས་སུ་བསྟན་འདུག་སྟེ།",
    "གསར་རྟོགས་ཀྱི་ཤེས་པའང་ཡིན་དགོས་པའི་ཞིབ་ཆ་བཏོན་འདུག་འདིར་ཤེས་དགོས་པ་ཞིག་ལ།",
    "ཞེས་གསུངས་ཏེ་དགག་པ་གནང་འདུག་གོ།",
    "ད་དུང་མ་ཤེས་དོན་གྱི་གསལ་བྱེད་ཀྱང་ཞེས་པའི་དོན་མ་ཤེས་པའི་ཤེས་པར་བྱེད་པའི་ནུས་པ་ཡོད་པ་ཙམ་ལ་བཀྲལ་འདུག་པར་མ་ཟད།",
    "བོད་དུའང་རྟགས་རིག་ཅེས་པའི་གཏན་ཚིགས་རིག་པའི་གཞུང་རང་རྐྱ་བ་བྱུང་ཡོད།",
    "དེའི་ཕྱིར་བོད་བརྒྱུད་ནང་བསྟན་ཁྲོད་སྐྱེས་བུ་གསུམ་གྱི་སྐྱབས་སུ་འགྲོ་ཚུལ་ལའང་ཁྱད་པར་ཕྱེས་འདུག་སྟེ།",
    "གནང་སྦྱིན་བཟང་པོ་གནང་ནས་ངེད་ཀྱིས་ཁྱེད་ལ་གནས་ཚང་ཞིག་གཡོར་དགོས་པ་འདུག་པས་དེ་ཐོང་ཞིག་གསུངས།",
    "ཁོང་རང་ཉིད་ཀྱིས་གསང་ས་བཅད་གཉིས་པ།",
    "འདི་ཐོན་གསུངས་ཏེ་སྐུ་ཚེ་དེ་ལ་ཚིགས་བཅད་རྩོམ་པའི་ཐོག་མ་ཡིན་པར་གྲགས་པ་སོགས་ལ་བརྟེན་ནས་སྐབས་དེའི་མི་རྣམས་ཀྱིས་རྟ་ནག་ཕུ་ན་ཐམས་ཅད་མཁྱེན་པའི་སྐུ་སྐྱེ་ཡོད་པ་འདུག་ཟེར་བའི་གྲགས་པ་ཆེན་པོ་བྱུང་།",
    "ཐ་ཐོར་འགའ་འདུག་པ་གཞིར་བཅས་ན།",
    "ཞེས་སོགས་ཀྱི་ལུང་ཁུངས་ཤིན་ཏུ་མང་པོ་འདུག་པ་དེ་དག་ནི།",
    "དེ་གཉིས་ཤས་ཆེར་གདོང་ཅན་གཉིས་ཀྱི་ཆོ་འཕྲུལ་དུ་འདུག་གོ།",
    "ཡིན་ནའང་རང་ཉིད་དབུལ་བོ་ལས་ཐར་ཐབས་བྲལ་ཞིང་།",
    "དེ་བས་ལུགས་འདིས་བདག་ཀུན་ལ་ཁྱབ་པའི་རྟག་པ་དང་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་ཅིག་ཏུ་ཁས་བླངས་ཡོད་ས་བཅད་གཉིས་པ།",
    "ལུགས་འདིས་ནམ་མཁའ་གོས་སུ་འདོད་པས་ལུས་གཅེར་བུར་འདུག་དགོས་ཤིང་།",
    "མི་སྡོང་རྩའི་བསིལ་འོག་ན་འདུག་པ་ལ།",
    "ཐ་ན་གྱོན་གོས་ཀྱང་གྱོན་མི་ཆོག་པར་ལུས་གཅེར་བུར་འདུག་དགོས་གོས་དཀར་བས་འདོད་རྔམ་དང་བྲལ་བའི་སྒོ་ནས་ཉེར་མཁོའི་པར་བཤད།",
    "གནའ་བོའི་སིངྒ་ལ་ནི་ཚོང་ལས་ཀྱི་རྒྱལ་ཁབ་ཆེན་པོ་ཞིག་ཡིན་པར་བསྟན་འདུག་སྟེ།",
    "ཞེས་པས་སྐབས་དེའི་སིངྒ་ལའི་བདག་པོ་སྟེ་རྒྱལ་པོ་ནི་འབོད་འགྲོགས་ཡིན་པའང་དངོས་སུ་བསྟན་འདུག་ལང་ཀ་མ་ལ་ཡ་ཡི་རིར།",
    "རྟགས་མཚན་ལྟ་བུར་གྱུར་འདུག་གོ།",
    "ཟུང་དུ་འབྲེལ་བ་སོགས་ཀྱི་སྣང་ཚུལ་ཡང་འདུག་སྟེ།",
    "བེམ་པོ་ཐབ་ཏུ་འཇོག་དུས་ནང་མི་དང་ཤ་ཚ་བའི་མི་ཁོ་ནས་འཇོག་དགོས་ཤིང་།",
    "དེ་བས་ངེས་པར་ཉིན་བདུན་ལ་འདོན་དགོས་པ་དང་དགེ་སློང་བདུན་གྱིས་འདོན་དགོས་པའི་ངེས་པ་མི་འདུག་གོ།",
    "རབ་ཡིན་ན་རང་ཉིད་སེང་གེ་འགྱིངས་སྟབས་སུ་འདུག་པ་དང་།",
    "དབྱེ་ཚུལ་གཞན་ཡང་འདུག་སྟེ།",
    "ཡིད་བྱེད་ཀྱིས་རང་དང་མཚུངས་ལྡན་གྱི་སེམས་རང་ཡུལ་ལ་གཏོད་པར་བྱེད་ཀྱང་རང་སྟོབས་ཀྱིས་ཤེས་རབ་སྐྱེད་པར་མི་བྱེད་ལ།",
    "འདུ་ཤེས་མེད་པ་དང་འགོག་པའི་སྙོམས་འཇུག་དུས་ཀྱི་སེམས་ཁེགས་པའི་གནས་སྐབས་གཉིས་ཏེ།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་འཇུག་དང་འགོག་པའི་སྙོམས་འཇུག་དུས་ཀྱི་སེམས་ཁེགས་པའི་གནས་སྐབས་གཉིས་ཏེ་འདུས་མ་བྱས་བརྒྱད་དང་།",
    "མཁས་པ་སོ་སོའི་བཞེད་ཚུལ་མི་འདྲ་པ་མང་དུ་འདུག་ཀྱང་།",
    "འཕགས་པའི་བདེན་པ་ལ་དངོས་སམ་བརྒྱུད་ནས་ལོག་པར་མི་འཇུག་ཅིང་རང་ཡུལ་ཁ་ཕྱིར་བལྟས་བར་འཇུག་པའི་ཤེས་པ་ཡིན་པའི་ཕྱིར།",
    "ད་དུང་ལྟ་བའི་ལུགས་ཀྱི་རྫས་ལྡོག་ནི་བཙུན་མ་ཕུད་སྤྱོད་ཡིན་ཞེས་ངག་རྒྱུན་དུ་གྱུར་འདུག།",
    "ཕྱི་རྒོལ་ཏེ་ལན་འདེབས་མཁན་དམ་བཅའ་པ་ཞིག་བདམས་ནས་ཚང་མའི་གྲལ་མགོ་རུ་འདུག་ཏུ་འཇུག་དགོས།",
    "ང་རང་གཡང་ལ་ཟགས་ལ་ཁད་ཀྱི་ཤི་གསོན་གྱི་སྐེ་རྩ་ལ་སླེབས་པའི་སྐབས་དེར།",
    "ངས་མེ་མདའ་རྒྱག་འགོ་ཚུགས་མ་ཐག་ཁྱེད་རང་ཡར་ལངས་ནས་རྒྱུགས་དགོས།",
    "ཨོག་དཀར་གདོང་ཅན་ཞིག་ལམ་གྱི་དཀྱིལ་ལ་འགྲེངས་འདུག་ངས་ཁོའི་ཐོག་ནས་དོ་སྣང་བྱུང་བ་དང་པོ་ནི།",
    "ང་རང་རབ་བྱུང་བྱེད་པའི་ཕྱོགས་ལ་དཀའ་སྤྱད་ཆེན་པོ་དགོས་པ་བྱུང་བས།",
    "འདི་ཁོ་ན་ལ་སྦྱངས་འདུག་སྙམ་པ་དང་།",
    "འདི་ཁོ་ན་ལ་སྦྱངས་འདུག་སྙམ་པ་དང་།",
    "འདི་ཁོ་ན་ལ་སྦྱངས་འདུག་སྙམ་པ་དང་།",
    "ནེའུ་གསིང་སྔོན་པོའི་ཐང་གཅིག་ལ་རྡོ་དཀར་ལ་འཇམ་པ་གཅིག་འདུག་པས།",
    "ཟག་བཅས་ཀྱི་བདེ་བ་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཡིན་ཟེར་བ་དེ་ཤིན་ཏུ་བདེན་པར་འདུག།",
    "དེ་མིན་ན་ཕྱུ་པའི་སྐུ་འབུམ་ལ་མི་མཇལ་བ་འདུག་གསུང་ནས་མཉེས་ཚོར་ཆེན་པོ་མཛད།",
    "འདི་ནས་གཞན་དུ་མི་འབྱོན་པར་གསོལ་བ་ཐོབ་ཟེར་ཞིང་འདུག་པའི་སྣང་བ་གཅིག་བྱུང་།",
    "ཞབས་དྲུང་པ་རྣམས་ཀྱིས་ད་ལན་རང་སྐུ་ཁམས་ཀྱིས་མི་ལྕོག་པར་གདའ་བས།",
    "ལམ་རང་སོ་བསོད་ཅིང་དགེ་སྦྱོར་འཕེལ་བར་འདུག་གསུངས་ནས།",
    "ཡུས་ཆེ་ཆེ་ལྟར་འདུག་པའི་སྣང་བ་གཅིག་བྱུང་།",
    "དེ་ད་དུང་ལྷང་ལྷང་འདུག་གསུང་།",
    "སོ་བསོད་པ་དགེ་སྦྱོར་འཕེལ་བར་འདུག་པས།",
    "མ་ཚོར་བར་བསྡད་ན་རང་འཐད་པར་འདུག་སྟེ་མི་ཉན་ཡོང་གསུང་།",
    "ཞུས་ན་མང་རབ་གསུང་བའི་རིགས་སུ་འདུག་པས།",
    "འོ་ནའང་དགོས་པ་གཅིག་འདུག་པས་བྲིས་ཤིག་གཅིག་གསུང་ནས།",
    "འདིར་སྡོད་མི་དགོས་པས་ཁྱེད་རང་རྣམས་རང་སར་ཉོལ་ཞིག།",
    "ཐུགས་བསྐྱེད་གཅིག་མཛད་ཅིང་འདུག་པ་དང་།",
    "ཡིད་ལ་བྱེད་པ་དང་རང་རྒྱུ་རྐྱེན་གསུམ་པོ་དེ་ལས་སྐྱེས་པའི་༡ ༡ ན་ཤེས་པ་ཡིན་པའི་ཕྱིར།",
    "འཇིག་རྟེན་ན་ལོག་པར་གོ་བ་དང་ཐེ་ཚོམ་ཟ་ན་ཅུང་ཟད་ཀྱང་མ་གོ་བར་འདུག་ཅེས་གྲགས་པ་ལྟར།",
    "ཆ་མེད་ཀྱི་སྤྱི་གཅིག་དང་རང་བཞིན་གཅིག་ཏུ་ན་༣ ཐ་འབྲེལ་བའི་ཕྱིར།",
    "སྒྲ་རྟོག་སེལ་བས་མས་བ་ས་ཟླའཇུག་ཅིང་རང་མཚན་གཅིག་དང་ཐ་དད་ལ་སེལ་བའི་འཛིན་སྟངས་མུ་བཞི་པས་ས་སྲིད་པའི་ཕྱིར་༣ ར།",
    "ཤིང་མ་ཡིན་པ་ལས་ལོག་པར་སྣང་བའི་མཚན་གཞིར་ཤིང་རང་མཚན་པ་ཡང་ཡོད།",
    "དགག་སྒྲུབ་ཀྱི་གཞི་ཡིན་པ་བཀག་འདུག་སྙམ་དུ་གོ་ན་ལོག་པར་གོ་བ་ཡིན་ཏེ།",
    "བརྡའི་ཡུལ་དང་རང་མཚན་འགལ་བར་འདོད་པ་ཐན་ལོག་འབའ་ཞིག་ཡིན་ནོ།",
    "ཟླ་༧བ་༥སྙཐ་སྙད་དུས་ནའང་དེ་ལྟར་གོ་ཞིང་རང་མཚན་ལ་ཞེན་ནས་ཞུགས་པས་དོན་ཐོབ་པ་འཐད་པ་དེའི་ཕྱིར་གསུམ་རྩོད་པ་སྤང་བ་ལ་ལྔསྤྱི་བརྗོད་བྱར་ས་ལ་ས་འདོད་པ་དང་མཚུངས་པ་སྤང་བ་དང་།",
    "དེས་ན་མ་ས་རིགས་པ་ལྟར་སྣང་རང་ལུགས་ལ་ཁས་ལེན་པ་མི་རིགས་པས།",
    "ཡང་རང་ལྡོག་གཞི་ལྡོག་འབྱེད་པའི་ནུས་པ་མེད་ཅིང་།",
    "མཚོན་བྱ་མ་ཡིན་པའི་ཐ་སྙད་བྱ་རུང་༤མཚོན་བྱའི་མཚན་གཞི་ཡིན་ཡང་རང་ལྡོག་མ་ཡིན་པ་སོགས་དང་།",
    "ཡང་རང་རྒྱུད་ལ་རིག་པ་ཙམ་གྱིས་རིག་པ་ཕྱི་མ་སྐྱེད་པར་གྲུབ་ད་པས།",
    "སྒྲ་མི་རྟག་པར་དམ་བཅའ་བའི་རྟོག་པ་འཁྲུལ་པ་ཡིན་ཡང་འཁྲུལ་པ་ལ་འཁྲུལ་པར་ཤེས་མི་ད་དགོས་པར་སྒྲ་དོན་དང་རང་མཚན་སོ་སོར་མ་ཕྱེ་བར་དམ་བཅའ་བའི་དོན་ཡིན་གྱི།",
    "དང་བ་དང་རང་ཚིགས་ཀྱིས་བསལ་བ་གཉིས་སུ་ཕྱེ་ནས་གསུངས་པའི་ལྔ་པོ་ཀུན་༣ན་ལས་བཏུས་སུ་མངོན་སུམ་དོན་དང་རྗེས་དཔག་དང་།",
    "ལུང་དང་རང་ཚིག་ཁས་བླངས་པའི་རྟགས་འབྲས་རྟགས་ལས་གཞན་གངས་བ་མིན་ལ།",
    "ཁས་བླངས་སྔ་ཕྱི་འགལ་བ་དང་རང་ཚིག་དངོས་ཤུགས་འགལ་བ་གཉིས་སུ་བཞེད་པའི་ཕྱིར།",
    "དེའི་འགྲེལ་པ་དང་བཅས་པ་རྣམས་ལེགས་པར་རྟོགས་ཤིང་རང་༡ ༢༧བ་ཕྱོགས་སྒྲུབ་པ་དང་།",
    "༤ ནསང་རངས་ས་ལ་དེ་ལ་ཚོགས་མཐའ་ཡས་པས་བརྒྱན་པ་དགོས་པའི་ཕྱིར་རོ།་",
    "ཇི་ས་ལྟར་ཁྱེད་རང་ལྟར་ན་ཀུན་བཏགས་པའི་ངོ་བོ་ཉིད་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་ཅི་ལ་ཡང་མི་ལྟོས་པ་ཁོ་ན་ཡིན་པར་ཁས་བླངས་པའི་ཕྱིར།",
    "ཆུང་ངུ་དེ་ལ་ཡང་རང་ག་བ་གཅིག་དང་།",
    "སྐྱེས་ཚར་འདུག་པའི་ཕྱིར་སྙམ་ན་དེ་ལ་ངེས་པ་མེད་དེ།",
    "དུས་ལོ་དེ་ཙམ་གྱི་བར་དུ་མ་འདུག་པར་འགྲོ་བར་བྱ།",
    "ལོ་དེ་ཙམ་གྱི་བར་དུ་མ་ལངས་པར་འདུག་པར་བྱ།",
    "སློབ་དཔོན་དང་འདི་གཉིས་ཀྱང་འཇམ་དཔལ་རྩ་རྒྱུད་ནས་ལུང་བསྟན་འདུག་པས་སྐྱེས་ཆེན་དམ་པའོ།",
    "བདེ་མཆོག་དུས་འཁོར།",
    "གྲུབ་པ་ཐོབ་པ་ཡང་མང་དུ་བྱུང་འདུག་ཅིང་།",
    "དེ་ཡང་རང་བཟོ་ཙམ་མ་ཡིན་པར།",
    "འོག་མིན་འགྲོ་ལ་འཕར་བ།",
    "འོག་མིན་འགྲོ་དབྱེ་གཞིར་བྱས་ནས་འཕར་བ་གསུམ།",
    "མཁས་པ་ཁ་ཅིག་མཁྱེན་གསུམ་གྱི་དོན་རྣམ་ཐམས་ཅད་མཁྱེན་གསུམ་གྱི་རྣམ་པར་བཞེད་ཀྱང་རང་ལུགས་ལ་དེ་ནི་མ་ཡིན་ཏེ།",
    "སེམས་བསྐྱེད་གཉིས་ཀྱིས་ཀྱང་རང་འབྲས་སྐུ་གསུམ་གྱི་འབྲས་བུ་བསྐྱེད་ནུས་ཞིང་།",
    "དེའི་ཚེ་བྱང་སེམས་དེ་གདན་དབུས་མ་ལ་འདུག་ཅིང་།",
    "དེ་ཡང་རང་གཞན་སྡུག་བསྔལ་གྱིས་མནར་ཚུལ་བསམ་པ་ལ་ནི།",
    "དེའི་མཇུག་ཏུའང་ཉམས་སུ་ལེན་ཚུལ་ཞིག་གནང་འདུག་པ་འདི་གཉིས་གང་ཡིན་མི་གསལ་ཡང་གཙོ་བོ་སྔ་མ་ཉིད་ཡིན་པ་གཞིར་བཅས་ནས་ལན་འབུལ་བར་བྱ་སྟེ།",
    "དེའི་ཞེན་ཡུལ་ལ་བདེན་གྲུབ་བམ་བདག་དང་རང་བཞིན་ཞེས་ཟེར་ཡང་བདེན་གྲུབ་ཡིན་པ་མེད་པ་བཞིན་ནོ།",
    "སེམས་ཙམ་པས་གཟུང་བ་ཕྱི་རོལ་དོན་གྱིས་སྟོང་བ་ལ་བྱ་བྱེད་འཐད་པར་བཞེད་ལ་དེ་དང་རང་རྒྱུད་པ་གཉིས་ཀས་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་ཀྱིས་སྟོང་པ་དང་།",
    "དེ་དག་རང་རང་སོ་སོ་ནས་མཐའ་གཉིས་སུ་ལྷུང་བར་མི་འདོད་དེ།",
    "དེ་ནས་ལྷག་མར་ཅི་ཞིག་ལུས་འདུག་སྙམ་ནས་བལྟས་པས་རྗེས་ཐོབ་ཏུ་གཟུགས་སོགས་རྣམས་སྒྱུ་མ་ཙམ་མམ།",
    "དངོས་པོའི་གནས་ལུགས་ཅི་ཡང་མིན་པའི་སྟོང་པ་དང་བློས་ཅི་ཡང་མི་འཛིན་པ་གཉིས་མཐུན་པར་འདུག་སྙམ་དུ་བསམ་པ་དང་།",
    "རྒྱལ་བ་ཉིད་ཀྱང་རང་བསྟན་ལ།",
    "དེ་ལྟ་ནའང་རང་ཉིད་སྐྱོན་དང་བཅས་ཤིང་སྟོན་པ་སྐྱོན་མེད་དུ་བསྟན་པའོ།",
    "སྤྱིར་རིགས་དེ་ལ་རྒྱས་འགྱུར་གྱི་རིགས་དང་རང་བཞིན་གནས་རིགས་གཉིས་ཡོད་ལ།",
    "འོན་ཀྱང་གཞན་གཅེས་པར་འཛིན་ཅིང་རང་ཡལ་བར་འདོར་བ་གསུངས་པ་མང་བས།",
    "གཞུང་འདི་སྙན་ངག་དང་མངོན་བརྗོད་ཀྱི་བརྡས་བཅིངས་པ་ལྟ་བུ་མ་ཡིན་འདུག་པས་ཕྱི་མ་འཐད་པར་སེམས་ཀྱང་བརྟག་གོ།",
    "བི་རོ་ཙ་ན་མར་པ་མི་ལ་རྗེ།",
    "ད་ལྟ་ཚོགས་གསོག་སྒྲིབ་སྦྱོང་ལ་དམིགས་ནས་འཇིགས་བྱེད་བཅུ་གསུམ་མ་འདི་ལ་སྟོང་རྩ་མཛད་པ་མང་འདུག་ཀྱང་།",
    "དེ་ཡང་རང་ཅག་རབ་ཏུ་བྱུང་བ་ཐམས་ཅད་ཀྱིས་འཇུག་པར་བྱ་བའི་གཞི་ནི་ཐོས་བསམ་སྒོམ་གསུམ་ཡིན་ལ།",
    "ཉམས་ལེན་གྱི་བསྐུལ་མ་རུ་འདུག་པ།",
    "ཉམས་ལེན་གྱི་དངོས་གཞི་རུ་འདུག་པ།",
    "དགེ་སློང་མ་འདི་བདག་ལ་ཆགས་ནས་འདུག་གོ་སྙམ་དུ་ཤེས་པའི་འདུ་ཤེས་གཉིས་ཡོད་དེ།",
    "དེ་ཅང་མི་སྨྲ་བར་འདུག་པ་དང་།",
    "དབེན་པ་ན་འདུག་པ་ལ་ཡང་ཚུལ་དེ་བཞིན་དུ་སྦྱར་རོ།",
    "ཉལ་སར་འདུག་དང་བགྲེང་བ་དང་།",
    "ཁྱད་པར་དུའང་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་འགྲེང་པ་དང་།",
    "དགག་བྱ་ནི་ཆགས་པ་འཕེལ་བ་དང་རང་ལ་གནོད་པའོ།",
    "ཏིལ་འབྲུས་ཁྲ་བོར་བྱས་པ་སྤེན་རྩེ་ལྟར་འདུག་པ་ལ་ལྟོས།",
    "སྐབས་འདི་ཉིད་ཀྱི་འགྲེལ་ཆུང་ལས་ནི་དགེ་སློང་མ་ཁྲིའི་ཐོག་ན་འདུག་ལ།",
    "རྩྭ་དང་སོག་མ་ལ་སོགས་པ་དེའང་མ་བཤམས་པ་ལ་འདུག་ན་ནི་ཉེས་བྱས་སོ།",
    "སོག་མ་ལ་སོགས་པ་ཡིན་ཡང་རས་ཀྱིས་གཡོགས་པའི་སྟན་ལ་འདུག་པའི་དོན་དུ་ཕྱི་རོལ་ཏུ་བཤམས་པ་ལ་ནི་མ་བསྒོ་བར་འདུག་ན་ཉེས་བྱས་སོ།",
    "སོག་མ་ལ་སོགས་པ་རས་ཀྱིས་གཡོགས་པ་དེ་ཡང་མ་བཤམས་པ་ལ་ནི་མ་བསྒོ་བར་འདུག་ན་ཁ་ན་མ་ཐོ་བ་རྫོགས་པར་འགྱུར་རོ།",
    "དགག་བྱ་ནི་རང་རིགས་ལ་གནོད་པ་དང་རང་བཞིན་གྱིས་དགག་བྱར་འགྱུར་བའོ།",
    "དགེ་སློང་མ་དེ་ཡང་ཆུ་སྣོད་གཅིག་ཐོགས་ཏེ་དེའི་མདུན་ན་སྡོད་ཅིང་འདུག་གོ།",
    "སྲིན་བལ་བརྟན་བྱུང་དབེན་པར་འདུག་པ་བཞི།",
    "ཉལ་སར་འདུག་འགྲེང་གཉིས་དང་གདིང་མེད་སྤྱོད།",
    "ཁྱིམ་དུ་མ་བསྒོ་བར་སྟན་ལ་འདུག་པ་དང་།",
    "འདུག་གནས་འདུས་ཟ་ཉལ་ཤམ་གཉིས།",
    "མི་སྨྲ་མ་གུས་དུས་མིན་འགྲོ།",
    "རིམ་གཉིས་འདུག་གནས་ཕྱེ་དང་ནི།",
    "དྲུང་ན་འདུག་ཀྱང་ཟིན་པའི་མངོན་ཞེན་མི་རྫོགས་པར་མྱོང་བས་གྲུབ་བོ།",
    "སྦྱོར་བཅུག་ཡང་ཡང་འདུག་གནས་དང་།",
    "ཉལ་ཤོམ་འདུག་འགྲེང་གཉིས་ནི་གཉིས་ཀ་ཚོགས་པ་ལས་གྱུར་པའོ།",
    "འདུག་པ་མ་གཏོགས་དགུ་དག་དང་།",
    "གོས་ལ་སྤྱི་ཚད་དང་རང་ཚད་གཉིས་ལས།",
    "འདི་དག་ཀྱང་རང་དོན་ཡན་ལག་ཏུ་དགོས་པར་འདུས་སོ།",
    "གོས་སྟན་དང་ནི་འདུག་གནས་པ།",
    "ཡན་ལག་དུས་མ་ཚང་ན་ཆེས་ན་སྨད་དུ་འགྱུར་ཏེ།",
    "བདག་མེད་པའོ་སྙམ་དུ་སེམས་ཏེ་འདུག་ལ།",
    "ནམ་མཁའ་ལ་འདུག་པ་དང་།",
    "འདིར་དགེ་སློང་ལ་བརྗོད་ན་འདུག་སྟེ་ལན་གསུམ་བརྗོད།",
    "ཀརྨ་ཤ་ཏམ་ལས་དགེ་སློང་འགའ་ཞིག་རྒྱལ་པོ་ལ་སོགས་པས་བཟུང་སྟེ་མཚམས་ཀྱི་ནང་ན་འདུག་ན་ཞེས་སོ།",
    "མཚམས་པོ་ཆེའི་ནང་ཡིན་པ་སྟེ་ལུང་གཞི་ལས་མཚམས་ཆེན་པོ་བཅད་པ་དེར་དགེ་སློང་རྣམས་ཀྱིས་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱའོ་ཞེས་གསུངས་ལ།",
    "ལྔ་པ་ཚུལ་ཇི་ལྟར་བསྟབ་པ་ནི་ལྡེ་མིག་ཐོགས་ཏེ་མདུན་དུ་འདུག་ནས་ཡོན་ཏན་ཇི་ལྟ་བ་བཞིན་དུ་བརྗོད་ཅིང་བསྟབ་པའོ།",
    "ལོ་མ་ཚང་བ་དག་ནི་མི་གནས་པར་འདུག་པའི་ལོ་གྲངས་མ་ཚང་བ་སྟེ།",
    "ལུང་གཞི་ལས་མཚམས་ཆེན་པོ་བཅད་པ་དེར་དགེ་སློང་རྣམས་ཀྱིས་འདུག་སྟེ།",
    "མཚམས་གཞན་དུ་ན་སྲ་བརྐྱང་རང་འཇུག་བྲལ་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྲ་བརྐྱང་བཏིང་ནས་ཟླ་བ་ལྔ་ལས་འདས་ན་ཡང་རང་ཞིག་ཏུ་གྱུར་པ་སྟེ།",
    "བབས་ན་ཡང་རང་ཞིག་ཏུ་གྱུར་པ་སྟེ།",
    "ཊིཀ་ལས་སྲིད་དུ་བཏང་བའི་ཚལ་བུ་རྣམས་ཀྱི་སྣ་མཐོན་དམན་དུ་འདུག་པས།",
    "ལུང་ལས་གཙུག་ལག་ཁང་དུ་ནི་ཀོ་ལྤགས་ཀྱི་སྟན་ལ་འདུག་པར་མི་བྱ།",
    "ཉལ་བར་མི་བྱ་ཞེས་བཀག་ཀྱང་ཁྱིམ་གཞན་དུ་གཞན་མེད་ན་ཀོ་ལྤགས་ལ་འདུག་པར་བྱ་ཞེས་གནང་ངོ།",
    "ཟན་གྱི་ཕྱིར་འདུག་པས་འདིའམ་འདི་ནས་ཞེས་པ་ལ་སོགས་པས་བསྟན་ཏོ།",
    "དང་པོ་སྦྱོར་བའི་དུས་སུ་ལུས་ཀྱིས་ཚུལ་བཞིན་དུ་འདུག་པ་དང་།",
    "དེ་བཞིན་དུ་འདུག་པར་བྱའོ།",
    "དེ་ཡང་མི་འདུག་པར་འགྲེང་བ་མ་ཡིན་པ་དང་།",
    "མཐོང་བའི་ཉེན་ཀོར་དུ་འདུག་ཏུ་བཅུག་ནས།",
