    "སློབ་དཔོན་རང་ཉིད་འཆད་པར་འགྱུར་བའི་བསྟན་བཅོས་མཐའ་དག་གི་བརྗོད་པར་བྱ་བའི་དོན་དགོས་པ་དང་བཅས་པ་སྟོན་ཞིང་།",
    "དེ་བཞིན་གཤེགས་པ་ལ་བསྟན་བཅོས་རྩོམ་པའི་རྒྱུ་ཅན་གྱི་ཕྱག་མཛད་གང་གིས་རྟེན་ཅིང་འབྲེལ་པར་འབྱུང་།",
    "དེ་ལྟར་ན་འདི་ནི་རེ་ཞིག་ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱི་སྤྱིའི་དོན་ཡིན་ནོ།",
    "ཡན་ལག་གི་དོན་ཡང་རྣམ་པར་དབྱེ་བར་བྱ་སྟེ།",
    "གང་གའའི་ཆུ་ནི་མངར་མོད་ཀྱི།",
    "མིག་དང་གཟུགས་ལ་བརྟེན་ནས་མིག་གི་རྣམ་པར་ཤེས་པ་འབྱུང་ངོ་ཞེས་བྱ་བ་འདི་ལྟ་བུ་ལ་སོགས་པའི་ཡུལ་འདིར་ནི་མིག་དང་གཟུགས་ལ་བརྟེན་ནས་ཞེས་དོན་གྱི་ཁྱད་པར་དངོས་སུ་ཞལ་གྱིས་བཞེས་ཤིང་།",
    "ཨི་ཏྱའི་སྒྲ་དེ་ལ་ཕན་པའི་མཐའ་ཅན་ཡིན་ན་ནི་མིག་དང་གཟུགས་ལ་བརྟེན་ནས་མིག་གི་རྣམ་པར་ཤེས་པ་འབྱུང་ངོ་ཞེས་བྱ་བ་འདིར་པྲ་ཏི་ཏྱའི་སྒྲ་མི་ཟད་པར་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "གང་ཞིག་ཁ་ཅིག་ན་རེ་རྟེན་ཅིང་ཞེས་བྱ་བའི་ཉེ་བར་བསྒྱུར་བ་ནི་ཟློས་པའི་དོན་ཡིན་པའི་ཕྱིར་དང་།",
    "རེ་ཞིག་གཞན་གྱི་ཕྱོགས་རྗེས་སུ་བརྗོད་པ་ལ་མི་མཁས་པ་ཉིད་དོ་སྙམ་མོ།",
    "དེ་ལྟར་ན་རེ་ཞིག་སློབ་དཔོན་ནི་རྗེས་སུ་བརྗོད་པ་ལ་མི་མཁས་སོ།",
    "དེ་ཡང་མི་རུང་སྟེ་མིག་དང་གཟུགས་ལ་བརྟེན་ནས་མིག་གི་རྣམ་པར་ཤེས་པ་འབྱུང་ཞེས་གསུངས་པ་འདི་ལ་དོན་གཉི་ག་མེད་པའི་ཕྱིར་རོ་ཞེས་སུན་འབྱིན་སྨྲས་པ་གང་ཡིན་པ་དེ་ཡང་མི་འཐད་དོ།",
    "རང་གི་དངོས་པོར་དེ་མ་སྐྱེས།",
    "འདི་སྐྱེས་པའི་ཕྱིར་འདི་སྐྱེ་བ་སྟེ་ཞེས་བྱ་བ་རྐྱེན་འདི་དང་ལྡན་པ་ཉིད་ཀྱི་དོན་ནི་རྟེན་ཅིང་འབྲེལ་པར་འབྱུང་། བའི་དོན་ཏོ་ཞེས་རང་གི་ལུགས་རྣམ་པར་གཞག་པ་དེ་ཡང་འཐད་པ་མ་ཡིན་ཏེ།",
    "རང་གི་དངོས་པོར་དེ་མ་སྐྱེས།",
    "ཞེས་ཡན་ལག་གི་དོན་དང་རྗེས་སུ་འབྲེལ་པ་ཉིད་དུ་ཞལ་གྱིས་བཞེས་པའི་ཕྱིར་རོ།",
    "དེ་དག་བཀག་པས་ནི་དངོས་པོ་ཀུན་རྫོབ་པ་རྣམས་ཀྱི་རང་གི་ངོ་བོ་ཀུན་རྫོབ་པ་ཇི་ལྟར་གནས་པ་བཞིན་གསུངས་པར་འགྱུར་རོ།",
    "སྐྱེ་བས་ན་སྐྱེ་བ་སྟེ་བདག་ཉིད་ཀྱི་དངོས་པོར་རེད་པའོ།",
    "གང་གིས་རྟེན་ཅིང་འབྲེལ་པར་འབྱུང་།",
    "འཐད་པ་གང་གིས་བདག་ལས་སྐྱེ་བར་མི་འགྱུར་བ་དེ་ནི།",
    "དེ་དག་གི་སྐྱེ་བ་དོན་མེད་པ་ཉིད་དུ་འགྱུར་བའི་ཕྱིར་དང་།",
    "ཤིན་ཏུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དངོས་པོ་བདག་གི་བདག་ཉིད་དུ་ཡོད་པ་རྣམས་ལ་ནི་ཡང་སྐྱེ་བ་ལ་དགོས་པ་མེད་དོ།",
    "འདི་ལ་ཁ་ཅིག་གིས་དེ་ནི་རིགས་པ་མ་ཡིན་ཏེ།",
    "ཐལ་བར་འགྱུར་བའི་ཚིག་ཡིན་པའི་ཕྱིར་སྐབས་ཀྱི་དོན་ལས་བཟློག་པས་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "སྐྱོན་འདི་དག་ཐམས་ཅད་ནི་རིགས་པ་མ་ཡིན་པར་ཁོ་བོ་ཅག་གིས་མཐོང་ངོ།",
    "དེ་ལ་རེ་ཞིག་གཏན་ཚིགས་དང་དཔེ་མ་བརྗོད་པའི་ཕྱིར་དང་ཞེས་གང་སྨྲ་བ་དེ་ནི་མི་རིགས་སོ།",
    "གང་གི་ཕྱིར་བདག་ལས་ཞེས་བྱ་བ་ནི་ཡོད་པ་རྒྱུ་ཉིད་དང་དེ་ཉིད་སྐྱེའོ་ཞེས་སྨྲས་པ་ཡིན་ལ།",
    "ཁྱོད་ཀྱིས་སྐྱེས་པ་སླར་ཡང་སྐྱེ་བར་མི་འདོད་ཅིང་།",
    "དེའི་ཕྱིར་ཁྱེད་ཅག་གི་རྩོད་པ་ནི་འཐད་པ་དང་བྲལ་བ་དང་།",
    "རང་གིས་ཁས་བླངས་པ་དང་འགལ་བ་ཡིན་ནོ་ཞེས་ཕ་རོལ་པོ་བདག་ལས་སྐྱེ་བར་འདོད་པ་ལ་འདྲི་བར་བྱེད་པ་ཡིན་ཏེ།",
    "གང་ལས་གཏན་ཚིགས་དང་དཔེ་བཀོད་པ་འབྲས་བུ་དང་བཅས་པར་འགྱུར་བ་འདི་དག་ཙམ་ཞིག་གིས་བརྩད་པ་ན་ཅི་ཕ་རོལ་པོ་ཁས་ལེན་པར་མི་བྱེད་དམ།",
    "འོན་ཏེ་ཕ་རོལ་པོ་རང་གི་ཁས་བླངས་པ་དང་འགལ་བས་བརྩད་། པས་ཀྱང་མི་ལྡོག་ན་ནི།",
    "གང་ལ་གྲངས་ཅན་པ་དག་གིས།",
    "ཞེས་བྱ་བར་གང་ལ་གྲངས་ཅན་པ་དག་གིས་ཕྱིར་ཟློག་པར་བྱེད་པར་འགྱུར་ལ།",
    "ནང་གི་སྐྱེ་མཆེད་རྣམས་དག་ལས་སྐྱེ་བ་མེད་དེ་ཞེས་བྱ་བའི་རང་གི་རྒྱུད་ཀྱི་དམ་བཅའ་བ་ལྟ་ག་ལ་ཡོད།",
    "གཉི་ག་ལ་གྲུབ་པའི་རྗེས་སུ་དཔག་པས་གཞན་གྱི་དམ་བཅའ་བསལ་བར་མ་གྱུར་མོད།",
    "གཞན་གྱི་དམ་བཅའ་བ་ལ་རང་གི་རྗེས་སུ་དཔག་པས་འགལ་བ་བརྗོད་པར་ནི་བྱ་དགོས་པས།",
    "གང་གི་ཕྱིར་དོན་གང་ཞིག་གང་གིས་དམ་བཅས་པ་དེས་ནི་རང་ཉིད་ཀྱིས་ངེས་པ་བཞིན་དུ་གཞན་དག་ལ་ངེས་པ་བསྐྱེད་པར་འདོད་པས།",
    "དོན་འདིའི་འཐད་པ་གང་གི་སྒོ་ནས་ཁོང་དུ་ཆུད་པའི་འཐད་པ་དེ་ཉིད་གཞན་ལ་བསྙད་པར་བྱ་དགོས་སོ།",
    "དེའི་ཕྱིར་རང་གིས་ཁས་བླངས་པའི་དམ་བཅས་པའི་དོན་གྱི་སྒྲུབ་པར་བྱེད་པ་ནི་ཕ་རོལ་པོ་ཁོ་ནས་ཉེ་བར་དགོད་པར་བྱ་བ་གང་ཡིན་པ་འདི་ནི་རེ་ཞིག་ལུགས་མ་ཡིན་ནོ།",
    "དཔེ་མེད་པའི་ཕྱིར་རང་གི་དམ་བཅའ་བའི་དོན་གྱི་སྒྲུབ་པར་བྱེད་པ་ནི་ཁས་འཆེས་པའི་རྗེས་སུ་འབྲངས་པ་འབའ་ཞིག་ཉེ་བར་བཀོད་པ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བར་གང་རང་གི་དམ་བཅའ་བའི་དོན་གྱི་སྒྲུབ་པར་བྱེད་པ་ལ་ནུས་པ་མེད་པ་འདི་ཉིད་འདིའི་སུན་འབྱིན་པ་ཆེས་གསལ་པོ་ཡིན་ཏེ།",
    "ཅི་སྟེ་ཡང་རང་གི་རྗེས་སུ་དཔག་པས་འགལ་བ་གདོན་མི་ཟ་བར་བརྗོད་པར་བྱ་བ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ལ་དེ་དག་ཅེས་བྱ་བ་འདིས་ནི་རང་གི་བདག་ཉིད་དུ་ཡོད་པ་འཛིན་པ་ཡིན་ནོ།",
    "དེ་ལ་རང་གི་བདག་ཉིད་དུ་ཡོད་པ་ཞེས་བྱ་བ་འདིས་ནི་གཏན་ཚིགས་འཛིན་པ་ཡིན་ནོ།",
    "རང་གི་བདག་ཉིད་དུ་ཡོད་པ་ལ་ཡང་སྐྱེ་བ་དོན་མེད་པ་ཉིད་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདི་ན་ཇི་ལྟར་བུམ་པ་ལ་སོགས་པ་མདུན་ན་གནས་ཤིང་གསལ་བ་རང་གི་བདག་ཉིད་དུ་ཡོད་པ་ནི་ཡང་སྐྱེ་བ་ལ་མི་ལྟོས་པར་མཐོང་བ་དེ་བཞིན་དུ།",
    "འཇིམ་པའི་གོང་བུ་ལ་སོགས་པའི་གནས་སྐབས་ན་ཡང་གལ་ཏེ་རང་གི་བདག་ཉིད་དུ་ཡོད་པའི་བུམ་པ་ལ་སོགས་པ་ཡོད་དོ་སྙམ་དུ་སེམས་ན་ནི་དེའི་ཚེ་ཡང་རང་གི་བདག་ཉིད་དུ་ཡོད་པ་དེ་ལ་སྐྱེ་བ་ཡོད་པ་མ་ཡིན་ནོ།",
    "རང་གི་བདག་ཉིད་དུ་ཡོད་པ་ཉིད་ཀྱིས་གྲངས་ཅན་ལ་རང་ཉིད་ཀྱིས་རྗེས་སུ་དཔག་པས་འགལ་བ་བརྗོད་པ་མཛད་པ་ཡིན་ཏེ།",
    "གཏན་ཚིགས་འགལ་བའི་དོན་ཉིད་དུ་དོགས་པ་ག་ལ་ཡོད་དེའི་ཕྱིར་རང་གི་རྗེས་སུ་དཔག་པས་འགལ་བ་བརྗོད་པ་ན་ཡང་ཇི་སྐད་སྨྲས་པའི་ཉེས་པ་བརྗོད་པ་མེད་པའི་ཕྱིར།",
    "བུམ་པ་ལ་སོགས་པ་ཞེས་བྱ་བ་སོགས་པའི་སྒྲས་ནི་སྐྱེ་བར་འདོད་པའི་དངོས་པོ་མ་ལུས་པ་བསྡུ་བར་འདོད་པའི་ཕྱིར་སྣམ་བུ་ལ་སོགས་པ་དག་གིས་མ་ངེས་པར་འགྱུར་བ་ཡང་མ་ཡིན་ནོ།",
    "རང་གི་བདག་ཉིད་དུ་ཡོད་པའི་ཕྱིར།",
    "ཐལ་བར་འགྱུར་བ་བཟློག་པའི་དོན་དང་། ཡང་ཕ་རོལ་པོ་ཉིད་འབྲེལ་པ་ཡིན་གྱི།",
    "རང་བཞིན་མེད་པར་སྨྲ་བས་རང་བཞིན་དང་བཅས་པར་སྨྲ་བ་ལ་ཐལ་བ་བསྒྲུབས་པ་ན་ཐལ་བ་ལས་བཟློག་པའི་དོན་ཅན་དུ་ཐལ་བར་ག་ལ་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་ཐལ་བ་སྒྲུབ་པ་ནི་ཕ་རོལ་པོའི་དམ་བཅའ་ལ་འགོག་པ་ཙམ་གྱི་འབྲས་བུ་ཅན་ཡིན་པའི་ཕྱིར་ཐལ་བ་ལས་ཟློག་པའི་དོན་དུ་འགྱུར་བ་ཡོད་པ་མ་ཡིན་ནོ།",
    "མཚན་ཉིད་མེད་པར་ཐལ་བར་འགྱུར།",
    "ཐལ་བར་འགྱུར་ཏེ་དོན་གང་ཡང་།",
    "རྒ་ཤིའི་མཚན་ཉིད་ཐལ་བར་འགྱུར།",
    "ཞེས་བྱ་བ་ལ་སོགས་པས་ཕལ་ཆེར་ཐལ་བ་སྒྲུབ་པ་ཁོ་ནའི་སྒོ་ནས་གཞན་གྱི་ཕྱོགས་སེལ་བར་མཛད་དོ།",
    "དེ་ལ་རེ་ཞིག་གང་འདི་སྐད་དུ་འདིར་སྦྱོར་བའི་ཚིག་ཏུ་འགྱུར་བ་ནི།",
    "དོན་དམ་པར་ན་ནང་གི་སྐྱེ་མཆེད་རྣམས་བདག་ལས་སྐྱེ་བ་མེད་པར་ངེས་ཏེ།",
    "འགོག་ན་ཡང་ཁས་བླངས་པས་གནོད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "བདག་གིས་མ་བྱས།",
    "དེ་ནི་རེ་ཞིག་དེ་ཉིད་མིན།",
    "དེ་དག་གི་རྣམ་པར་གཞག་པ་ནི་ཀུན་རྫོབ་ཏུ་ཡང་ཁས་བླངས་པ་མེད་པའི་ཕྱིར་རོ།",
    "རང་གིས་དོན་དམ་པར་མིག་ལ་སོགས་པའི་སྐྱེ་མཆེད་རྣམས་ཁས་མ་བླངས་པའི་ཕྱིར་རོ།",
    "འོ་ན་དོན་དམ་པར་ཞེས་བྱ་བ་འདི་གང་གི་ཁྱད་པར་ཡིན།",
    "སྨྲ་ན་ཡང་ཕ་རོལ་པོ་དག་གིས་མིག་ལ་སོགས་པ་རྣམས་རྫས་སུ་ཡོད་པ་ཉིད་དུ་ཁས་བླངས་པའི་ཕྱིར་དང་།",
    "གང་གི་ཚེ་རབ་རིབ་ཅན་གྱིས་སྐྲ་ཤད་ལ་སོགས་པ་ལྟར་ཕྱིན་ཅི་ལོག་གིས་ཡོད་པ་མ་ཡིན་པ་ཡོད་པ་ཉིད་དུ་འཛིན་པ་དེའི་ཚེ་ནི་ཡོད་པར་གྱུར་པའི་དོན་ཆ་ཙམ་ཡང་དམིགས་པར་ག་ལ་འགྱུར།",
    "གང་གི་ཚེ་རབ་རིབ་ཅན་མ་ཡིན་པས་སྐྲ་ཤད་ལ་སོགས་པ་ལྟར་ཕྱིན་ཅི་མ་ལོག་པས་ཡང་དག་པ་མ་ཡིན་པ་སྒྲོ་མི་འདོགས་པ་དེའི་ཚེ་ན་ཡང་གང་གིས་ན་དེའི་ཚེ་ན་ཀུན་རྫོབ་ཏུ་འགྱུར་བ་ཡོད་པ་མ་ཡིན་པར་གྱུར་པའི་དོན་ཆ་ཙམ་ཡང་དམིགས་པ་ག་ལ་ཡོད།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ཕྱིན་ཅི་ལོག་པ་དང་ཕྱིན་ཅི་མ་ལོག་པ་དག་ཐ་དད་པ་དེའི་ཕྱིར་ཕྱིན་ཅི་མ་ལོག་པའི་གནས་སྐབས་ན་ཕྱིན་ཅི་ལོག་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་ན།",
    "ད་བཞིན་དུ་མིག་གི་སྤྱི་ནི་སྟོང་པ་ཉིད་དང་སྟོང་པ་ཉིད་མ་ཡིན་པར་སྨྲ་བ་དག་གིས་ཀུན་རྫོབ་ཏུ་ཡང་ཁས་མ་བླངས་ལ།",
    "གང་གི་ཕྱིར་ཇི་སྐད་བསྙད་པའི་དོན་འདི་ནི་རྟོག་གེ་བ་འདིས་རང་ཉིད་ཀྱིས་ཁས་བླངས་པ་ཡིན་ནོ།",
    "ནང་གི་སྐྱེ་མཆེད་རྣམས་སྐྱེད་པར་བྱེད་པ་རྒྱུ་ལ་སོགས་པ་ནི་ཡོད་པ་འོ་ན་ཡིན་ཏེ།",
    "འདིར་ཁྱོད་ཀྱི་གཏན་ཚིགས་ཀྱི་དོན་དུ་འདོད་པ་གང་ཡིན་དེ་བཞིན་གཤེགས་པས་ཀུན་རྫོབ་ཏུ་དེ་སྐད་གསུངས་པའི་ཕྱིར་རམ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་འདིས་རང་ཉིད་ཀྱི་ཚུལ་འདིས་གཏན་ཚིགས་མ་གྲུབ་པར་ཁས་བླངས་པ་དེའི་ཕྱིར།",
    "དོན་དམ་པར་ན་ནང་གི་སྐྱེ་མཆེད་རྣམས་དེ་དག་གི་རྐྱེན་གཞན་དག་ལས་སྐྱེ་བ་མེད་དེ།",
    "ཡང་ན་དོན་དམ་པར་གཞན་གྱིས་བརྗོད་པར་འདོད་པའི་མིག་ལ་སོགས་པ་ནང་གི་སྐྱེ་མཆེད་འགྲུབ་པར་བྱེད་པ་དག་རྐྱེན་མ་ཡིན་པར་ངེས་ཏེ།",
    "ཇི་ལྟར་འདིས་ནང་གི་སྐྱེ་མཆེད་རྣམས་སྐྱེས་པ་ཁོ་ན་ཡིན་ཏེ།",
    "དེ་དག་གི་ཡུལ་དང་ལྡན་པའི་ཐ་སྙད་ཁྱད་པར་ཅན་བྱེད་པའི་ཕྱིར་རོ།",
    "ཞེས་གཞན་གྱིས་བརྗོད་པའི་གཏན་ཚིགས་འདི་ལ་མ་གྲུབ་པར་བརྗོད་པར་འདོད་པས་འདི་སྐད་དུ་འོན་ཏེ་དོན་དམ་པར་རྣལ་འབྱོར་པ་མཉམ་པར་གཞག་པའི་ཤེས་རབ་ཀྱི་མིག་གིས་དངོས་པོ་རྣམས་ཀྱི་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་ཉིད་མཐོང་བའི་སྐྱེ་བ་དང་འགྲོ་བ་ལ་སོགས་པ་དག་ཡོད་པར་བསྒྲུབས་ན་ནི།",
