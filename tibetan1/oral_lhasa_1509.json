    "ཀླ་ཀློ་གདུག་པའི་མཐའ་དམག་ཟློག་པར་མཛོད།",
    "རྣལ་འབྱོར་བཅོལ་བའི་ཕྲིན་ལས་སྒྲུབས་པར་མཛོད།",
    "ཅེས་བརྗོད་པས་གོང་ལྟར་གཏོར་མ་བླངས་ཤིང་ཕྲིན་ལས་སྒྲུབ་པར་ཞལ་གྱི་བཞེས་པར་བསམ་ལ་གཏོར་མ་ཕྱི་རོལ་དུ་འབུལ་ལོ།",
    "དེ་ལྟར་འཇམ་དཔལ་རིགས་གསུམ་ཁྲོས་པ་ལས་ཀྱི་གཤིན་རྗེ་ཁྲོ་ཆུ་དུག་གདོང་ནག་པོའི་དཀྱིལ་འཁོར་ལ་ཚོགས་མཆོད་འབུལ་བའི་ཆོ་ག་འདི་ནི་རང་གཞན་ལ་ཉེར་མཁོར་མཐོང་ནས་དུས་ཞབས་ནུས་མེད་ཀྱི་སྔགས་ཆུང་འཇམ་དཔལ་རྡོ་རྗེ་ཞེ་སྡང་རྔམས་ཆེན་ནག་པོ་གནམ་ལྕགས་མེ་འབར་རྩལ་གྱིས་རབ་ཚེས་ཤིང་གླང་སྣྲོན་ཟླའི་ཚེས་དེ་ཉིད་གྲངས་ལ་གྱིང་ཕུ་དཔལ་གྱི་ནགས་ཁྲོད་ཁྲོ་ཆུ་བདུད་འདུལ་གླིང་དུ་སྦྱར་བ་དགེ་ལེགས་འཕེལ། ། བཅོམ་ལྡན་འཇམ་དཔལ་ཁྲོ་བོ་གཤིན་རྗེའི་གཤེད་ཁྲོ་ཆུ་འབར་བ་དུག་གདོང་ནག་པོའི་སྒྲུབ་ཕྲིན་རྒྱས་པ་མཐུ་སྟོབས་རབ་འབར་སྣང་སྲིད་ཀུན་འཇོམས་བདུད་ལས་རྣམ་པར་རྒྱལ་བྱེད་ཅེས་བྱ་བ་བཞུགས་སོ།",
    "དགྲ་བགེགས་བསྣོལ་བའི་གདན་ལ་བརྟན་པར་བཞུགས།",
    "སྡིག་སྒྲིབ་དམ་ཚིག་ཉམས་ཆག་མཐོལ་ལོ་བཤགས།",
    "ཕྲིན་ལས་རྣམ་བཞི་སྒྲུབ་པར་གསོལ་བ་འདེབས།",
    "དཀོར་བདག་ལ་སོགས་ལྷ་སྲིན་འབྱུང་པོའི་ཚོགས།",
    "གཙང་སྦྱར་གཏོར་མ་གསེར་སྐྱེམས་འདི་བཞེས་ལ།",
    "འདོད་ཡོན་གླུད་དང་གཏོར་མས་ཚིམ་པར་བྱོས།",
    "འབྲས་བུ་ཤ་ཆང་སོགས་ཀྱིས་ངོམ་པར་གྱིས།",
    "བགེགས་ཚོགས་རྡུལ་དུ་བརླག་པར་གདོན་མི་ཟ།",
    "སྟེང་ཕྱོགས་དགྲ་སྟའི་གུར་དགྲ་སྟའི་ཐོག་འོག་ཀྱང་དགྲ་སྟའི་དགྲ་སྟའི་འདུ་འཕྲོ་ཕྱོགས་མཚམས་དགྲ་སྟས་དགྲ་སྟའི་ཚྭ་དགྲ་སྟའི་མཚམས་ཨོཾ་པརྴུ་ཧཱུྃ།",
    "ཨོཾ་གྱིས་དག་པར་བྱས།",
    "ལྷ་བསྐྱེད་སྤྱན་འདྲེན་བཞུགས་ཕྱག་དང་།",
    "བྱད་མ་ལྷ་སྲུང་དང་བཅས་པས་དྲན་ན་འཆི་བ།",
    "རིགས་གསུམ་མགོན་དང་དུས་གསུམ་བདེ་གཤེགས་བཞུགས།",
    "སྟོང་གསུམ་སྐྱེ་འགྲོ་ལྷ་སྲིན་རྔུབས་ཏེ་གསོལ།",
    "སྟོབས་ནུས་ཚེ་བསོད་དྭངས་མ་འདྲེན་པར་བྱེད།",
    "ཕྱག་གདུབ་སོགས་བྱས་རྡོ་རྗེའི་གོ་ཁྲབ་གསོལ།",
    "མགྲིན་པར་པདྨའི་སྟེང་དུ་ཨཱ་དམར་པོ།",
    "ཁྲག་འཐུང་ཡབ་ཡུམ་རྣམས་ཐོད་པའི་ཁང་བུར་བཞུགས་པས་དབུ་བརྒྱན།",
    "མཁྱེན་བརྩེ་ནུས་པའི་ཡེ་ཤེས་ལམ་སེ་ལམ།",
    "གསུམ་པ་བཞུགས་སུ་གསོལ་བ་ནི།",
    "འབུལ་ལོ་བཞེས་ལ་མཐུ་སྟོབས་དངོས་གྲུབ་སྩོལ།",
    "ལས་སྦྱོར་གྱི་དུས་སུ་ཁྱད་པར་གྱི་དྲག་མཆོད་སྐབས་འདིར་འབུལ།",
    "འཆི་བདག་བཅུ་གཉིས་སྲོག་རྩ་གཅོད་པར་བྱེད",
    "དྲག་པོའི་ཕྲིན་ལས་ཐོགས་མེད་སྒྲུབ་པར་བྱེད",
    "སྐབས་འདིར་ལྷ་སྐུའི་གསལ་སྣང་ལ་སེམས་རྩེ་གཅིག་ཏུ་འཛིན།",
    "དག་པ་དྲན་ལ་སེམས་དང་ལྷ་སྐུ་རོ་མཉམ་གཉུག་མ་དོན་གྱི་ཡེ་ཤེས་ཀྱི་ངང་དུ་མཉམ་པར་བཞག་གོ།",
    "པར་དམིགས་ལ།",
    "འོད་ཟེར་ཨོཾ་དཀར་རྣམ་པར་བསྡུས་ཏེ་ཐིམ།",
    "འཆི་མེད་རྡོ་རྗེའི་ལུས་མཆོག་འགྲུབ་པར་བྱས།",
    "འོད་ཟེར་ཨཱ་དམར་རྣམ་པར་བསྡུས་ཏེ་ཐིམ།",
    "འོད་ཟེར་ཧཱུྃ་སྔོན་རྣམ་པར་བསྡུས་ཏེ་ཐིམ།",
    "གཟུངས་དྲན་མངོན་ཤེས་ཏིང་འཛིན་འགྲུབ་པར་བྱས།",
    "ཧྲཱི་ཨཱ་འི་རྣམ་པར་བསྡུས་ཏེ་ཐིམ་པ་ཡིས།",
    "དུར་ཁྲོད་ཀྱི་ཆས་ཀྱིས་བརྒྱན་ཅིང་ཞབས་གཡས་བསྐུམས་གཡོན་བརྐྱངས་པའི་དོར་སྟབས་ཀྱིས་པད་ཉིའི་གདན་ལ་བཞུགས་པ།",
    "ལས་མྱུར་དམར་པོ་གྱད་ཆེན་དོང་བདག་མུན་པའི་སྐྱེས་གཅིག་སོགས་འཇིག་རྟེན་གྱི་གཤིན་རྗེའི་ཚོགས་དང་བཅས་པ་མཆོད་ཅིང་མཉེས་པར་བྱས།",
    "བདེ་ཆེན་ཡེ་ཤེས་རྒྱས་པ་ཐུགས་ཀྱི་དངོས་གྲུབ་རྣམས་ཐོབ་པར་བསམ།",
    "བྱང་སེམས་རྣམས་ཤེས་སྒྲིབ་ལས་གྲོལ་བར་བྱས་ཏེ་ཐམས་ཅད་ཀྱང་བཅོམ་ལྡན་འདས་གཤིན་རྗེའི་གཤེད་ཀྱི་གོ་འཕང་ལ་བཀོད་པར་བསམ།",
    "ཡང་འོད་ཟེར་སེར་པོ་འཕྲོས་པས་སྣོད་བཅུད་ཀྱི་ཡོན་ཏན་རྒྱས་པར་བྱས།",
    "འཁོར་འདས་ལམ་གསུམ་གྱིས་བསྡུས་པའི་དཔལ་ཡོན་ཐམས་ཅད་འོད་ལྔའི་ཐིག་ལེ་ནོར་བུ་བུམ་བཟང་དཔག་བསམ་གྲུབ་རྫས་བཀྲ་ཤིས་རྫས་རྟགས་ཀྱི་རྣམ་པར་བསྡུས།",
    "རང་ལུས་དང་གནས་ཁང་ཐམས་ཅད་ཁེངས་པས་ལེགས་ཚོགས་ཡོན་ཏན་རྒྱས་པར་བསམ།",
    "ཐུགས་སྲོག་ཐམས་ཅད་ཨོཾ་ཧཱུྃ་ཏྲཾ་ཧྲཱི་ཨཱ་སོགས་ཡིག་འབྲུའི་རྣམ་པར་བསྡུས་ཏེ་རང་དང་ཐུགས་སྲོག་ལ་ཐིམ།",
    "རང་རིག་གཉུག་མ་གསལ་སྟོང་རྒྱ་ཡན་ཆེན་པོའི་རང་མདངས་ལྷ་སྐུར་སྣང་བཞིན་མེད་པར་རང་ཤར་བ་དེ་ཉིད་དྲན་ཙམ་དང་།",
    "འོན་ཀྱང་གྲངས་དུས་ལ་ངེས་པ་མེད་པས་རྟགས་ཚད་གཙོ་བོར་བཟུང་བར་གསུངས་སོ།",
