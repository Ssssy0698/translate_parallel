    "རང་རང་སོ་སོས་མ་གོ་གོ་ཕྱིར་ཏེ།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་གཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "མི་སུ་ཡིན་ཡང་རང་ཉིད་ལ་ནག་ཉེས་ཡོད་པའི་ར་སྤྲོད་བཙན་སྐུལ་བྱེད་མི་ཆོག་གྱོད་གཞི་དང་འབྲེལ་བ་ཡོད་པའམ་གྱོད་དོན་གནས་ཚུལ་རྒྱུས་ཡོད་པའི་སྤྱི་དམངས་ཐམས་ཅད་ལ་ངེས་པར་དུ་གཞན་ངོས་དང་འདང་ངེས་ཀྱི་སྒོ་ནས་དཔང་རྟགས་འདོན་སྤེལ་བྱེད་པའི་ཆ་རྐྱེན་ཡོད་པའི་འགན་ལེན་བྱ་དགོས།",
    "འོན་ཀྱང་རང་ཉེས་འགྱོད་བཤགས་བྱས་པ་ཡིན་ན།",
    "མི་སུ་ཡིན་ཡང་རང་ཉིད་ལ་ནག་ཉེས་ཡོད་པའི་ར་སྤྲོད་བཙན་སྐུལ་བྱེད་མི་ཆོགགྱོད་གཞི་དང་འབྲེལ་བ་ཡོད་པའམ་གྱོད་དོན་གནས་ཚུལ་རྒྱུས་ཡོད་པའི་སྤྱི་དམངས་ཐམས་ཅད་ལ་ངེས་པར་དུ་གཞན་ངོས་དང་འདང་ངེས་ཀྱི་སྒོ་ནས་དཔང་རྟགས་འདོན་སྤེལ་བྱེད་པའི་ཆ་རྐྱེན་ཡོད་པའི་འགན་ལེན་བྱ་དགོས།",
    "འོན་ཀྱང་རང་ཉེས་འགྱོད་བཤགས་བྱས་པ་ཡིན་ན།",
    "སྤྱི་དམངས་དེའི་ལུས་ཁམས་ཀྱི་གནས་ཚུལ་ལ་བལྟས་ནས་འོས་འཚམས་འདུག་ན་དེ་ཉིད་ལའང་བསམ་འཆར་འདྲི་དགོས།",
    "གནས་སྐབས་འདུག་མིའི་ཁྲོད་ཀྱི་ལོ་ན་མ་སོན་པའི་སྐྱེ་བོས་བྱ་སྤྱོད་ངན་པ་སྤེལ་པ་ཡིན་ན།",
    "ལས་ཀ་བྱེད་ཡུན་མ་ཡིན་པའི་དུས་སུ་མི་དམངས་ཉེན་རྟོག་པས་སོ་སོའི་འགན་འཁྲིའི་ཁོངས་སུ་གཏོགས་པའི་གནས་ཚུལ་ཛ་དྲག་ཅན་དང་ཐུག་དུས་འགན་འཁྲི་བསྒྲུབ་དགོས།",
    "ཐེབས་རྩའི་རྒྱུ་ནོར་ཆ་ཚང་བ་དང་རང་ཚུགས་ཐུབ་པར་འགན་ལེན་ཏན་ཏིག་བྱེད་རྒྱུ།",
    "མཐུན་སྦྱོར་དང་རང་གཅུན་གྱི་ནུས་པ་འདོན་སྤེལ་བྱེད་པ།",
    "རྒྱལ་ཁབ་ཀྱིས་ཞིང་ལས་ཐོན་སྐྱེད་དང་འབྲེལ་བ་ཡོད་པའི་སྐྱེ་དངོས་ཀྱི་དངོས་རིགས་ཐོན་ཁུངས་སྲུང་བའི་ལམ་ལུགས་བཙུགས་ནས་སྐྱེ་དངོས་ཀྱི་སྣ་མང་རང་བཞིན་སྲུང་རྒྱུ་དང་།",
    "རྡོ་རམས་པའི་དམ་བཅའ་བཞུགས་ཁྲི་དེའི་མདུན་ནས་འཇོག་དགོས་ཀྱི་འདུག།",
    "རབ་བྱུང་བསྙེན་རྫོགས་ཀྱང་ཤིན་ཏུ་མང་པོ་བསྒྲུབ་གནང་འདུག།",
    "དེ་ནས་རྒྱུན་རིང་མ་བཞུགས་པར་བོད་ལ་ཕྱིར་ཕེབས་གནང་འདུག།",
    "ལག་ཁྱེར་སོགས་ཀྱིས་དཀའ་ངལ་ཤིན་ཏུ་ཆེན་པོ་འདུག།",
    "དེའི་ཕྱོགས་ལ་བོད་མི་ཡང་ཕལ་ཆེར་གྲངས་ཉིས་བརྒྱ་ཙམ་ཡོད་འདུག།",
    "དེའི་སྐབས་ཏཱ་ཁུ་རི་སོགས་ཁལ་ཁའི་ལུང་པ་རྣམས་སུ་དེ་ཙམ་གྱི་འགྱུར་བ་ཕྱིན་མི་འདུག།",
    "དེའི་འགྲམ་ལ་ཨང་ཆུ་ཟེར་བའི་ཆུ་ཆེན་པོ་ཞིག་འདུག།",
    "ཆུའི་མཐའ་གཉིས་འཁྱགས་པ་ཞུ་ནས་ཆུ་ཡང་རྒྱུགས་བཞིན་འདུག།",
    "ཉི་མ་ཡང་ཞེ་དྲག་ཡག་པོ་འདུག།",
    "དེའི་ལོར་སོག་པོའི་གྲྭ་རྒྱུན་ཉིས་བརྒྱ་སྐོར་ཡོད་པ་ནས་ཁལ་ཁ་མི་ཚན་ལ་གྲྭ་རྒྱུན་བཞི་བཅུ་ཞེ་བདུན་འདུག།",
    "ཤུགས་ཆེ་བ་ཤིང་རྟའི་སྲོལ་འབྱེད་གསེར་ཕྲེང་རྩོད་དགོས་ཀྱི་འདུག།",
    "དེ་དུས་གྲྭ་ས་གཞན་ནས་ཀྱང་ཕེབས་མཁན་མང་པོ་མི་འདུག།",
    "ལ་ཆེན་པོ་རྒྱབ་དགོས་པས་དཀའ་ངལ་དང་ཤིང་གཅོད་བྱེད་ལག་ཆ་མེད་པས་ཤིང་ཐོབ་ཁག་པོ་འདུག།",
    "དམ་བཅའ་ཚུགས་སྐབས་རྟགས་གསལ་གཏོང་སར་འགྲོ་དུས་ཕལ་ཆེར་འཚང་གས་ཐར་གྱི་མི་འདུག།",
    "དེར་བརྟེན་སྐེད་རགས་འོག་སོགས་ལ་ཤིག་ཡང་རྒྱབ་བཞིན་འདུག།",
    "དང་པོ་ནས་ང་རང་ཤེས་རབ་འབྲིང་ཙམ་ལས་མེད།",
    "མཚོ་ཁར་ཡོད་དུས་འབྲུག་སྐད་རྒྱབ་ནས་སེར་བ་གཏོང་བ་སོགས་འཚུབས་པོ་ཞེ་དྲག་འདུག།",
    "གནས་སྐོར་ལ་དུས་ཡུན་ཟླ་བ་ཕྱེད་དང་གཉིས་ཙམ་འགོར་འདུག།",
    "བྱུང་ན་དེང་སང་ཡང་གཅིག་དགོས་འདུག།",
    "བོད་ལ་ཕན་ཐོགས་པའི་པཎྜི་ཏ་གཞན་ནི་མི་འདུག།",
    "པཎྜི་ཏ་གདན་མི་འདྲེན་པར་ཁྱེད་རང་ངེད་ཀྱི་འོག་ཏུ་ཞུགས་ཟེར་བ་ལ་ནི།",
    "གསེར་ང་རང་ཙམ་རྙེད་པ་ཤིན་ཏུ་རྔམས་ཆེ་ན།",
    "ད་འདིས་བོད་ཀྱི་མི་ནོར་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་ནས་འདུག་ལགས་ཀྱི།",
    "ཁྱེད་རང་རྣམས་བློ་ཕེབས་པར་གཟིམ་ཟེར་བ་ལ།",
    "ད་ལྟ་ཁོང་རང་ལ་གསེར་སྲང་ཕྱེད་ཕུལ་ལ།",
    "ཚེ་ནི་བོད་དུ་བྱོན་ན་ཐུང་བར་འདུག་གསུངས།",
    "དེ་ནས་ཇོ་བོས་བལ་ཡུལ་དང་བོད་དུ་ཡང་གནས་རྟེན་ཁྱད་པར་ཅན་མང་དུ་ཡོད་འདུག་པར་མཇལ་བ་དང་སྤྲགས་ཡུད་ཙམ་ཞིག་ཕེབས་ཆོག་པར་གནས་བརྟན་ལ་གསོལ་བས།",
    "རང་རང་གར་གར་སྤྱོད་ཅིང་།",
    "ཁུ་སྟོན་གྱིས་ངའི་མིང་མི་འདུག་གསུངས་པར།",
    "སོགས་ཁོངས་ན་འདུག་ཞུས་པས་སོགས་ཁོངས་སུ་འཇོག་འོས་པའི་མི་དེ་ང་མིན་ཞེས་སྔོན་ལ་བྱོན་པས་ཐམས་ཅད་འུར་ལངས་པ་ལྟར་ཕེབས་བསུར་བྱོན།",
    "སྔར་བཀོད་ལྟར་དགུང་ལོ་བཅུ་གསུམ་པར་གསུངས་པ་མང་འདུག་ཀྱང་དགུང་ལོ་བཅུ་པའི་མེ་ཁྱི་ལོ་ལ་རྒྱལ་སར་བྱོན།",
    "དེའི་འཁོར་རྣམས་དང་བསུ་མི་རྣམས་ཀྱང་རང་ལ་ཐིམ་པར་མཐོང་བས།",
    "དེ་ཕྱིན་ཆད་མ་བརྟགས་མ་དཔྱད་པའི་དུས་ནའང་ངའི་ལུས་འདི་ལ་བརྙས་བཅོས་མི་ཉན་སྙམ་ནས་གཅེས་སྤྲས་དང་གཙང་སྤྲ་ལ་བརྩོན་པ་སོགས་རང་ཤུགས་ཀྱིས་བྱུང་འདུག་གསུངས།",
    "ཁྱེད་ཀྱི་བུར་འདུག་པ་ཐིག་པ་ཡིན་གསུངས་པ་ལ་སོགས་པའི་གསང་པའི་གནས་དུ་མ་གསུངས།",
    "ཐོས་བསམ་སོགས་མཛད་པའི་རིམ་པ་ཐམས་ཅད་དེ་དང་མཐུན་པར་བྱུང་འདུག་གསུངས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་།",
    "སྔར་གྱི་འཇམ་སྐྱའི་ཊཱིཀ་ལ་ལྟོས་ན་ཤིན་ཏུ་གསལ་ཞིང་གོ་བ་བསྐྱེད་པ་ཞིག་འདུག་པས་ཐུགས་སྤྲོ་བར་གྱུར་ཏེ།",
    "ཁམས་ཀྱང་མ་བདེ་ཞིང་ཕར་ཚད་འཆད་དགོས་པ་འདིས་འཕྲལ་ལ་འཆད་པ་མི་འགྲུབ་འདུག།",
    "དེ་ལྷག་དོན་ལ་ཁྱད་པར་མི་འདུག་ཀྱང་ད་ལྟའི་མཚན་ཉིད་པ་རྣམས་ལ་གྲགས་པ་དང་བསྟུན་ནས།",
    "ཁོང་གསུང་བར་བཞེད་པ་འདུག་པ་ལ།",
    "བོད་ཀྱི་གྲུབ་ཐོབ་ཏུ་བྱེད་པའི་རྟོགས་པ་བཟང་ཤོས་མཐར་ཐུག་པ་དེ་ཐུགས་ལ་འཁྲུངས་འདུག་ནའང་།",
    "དེ་དུས་གྲྭ་ས་ན་པོ་ཏི་གཞན་རྣམས་ཀྱི་གྲྭ་སྐོར་བྱེད་པའི་ལུགས་མ་དར་འདུག་པས་མ་བྱས་གསུངས་སོ།",
    "དེ་དུས་འགྲེལ་ཆེན་གསུངས་ནས་ལེའུ་དང་པོ་རྫོགས་པའི་མཚམས་ལ་འདུག་པས།",
    "བསྐྱེད་རིམ་དང་མཐུན་པས་བསྐྱེད་རིམ་ཡོངས་སུ་རྫོགས་པར་འོངས་པ་འདུག།",
    "དེའི་མདུན་ན་རྗེ་རང་ཉིད་ཀྱང་བཞུགས་འདུག་པ་ལ།",
    "ཕྱིས་མཇལ་བ་ན་སྐུའི་རྣམ་པ་མནལ་ལམ་དུ་བྱུང་བ་དེ་ཉིད་རང་དུ་འདུག་གསུངས་སོ།",
    "སྔགས་ཀྱི་དངོས་གྲུབ་ཐམས་ཅད་ལམ་གྱི་རྩ་བ་བཤེས་གཉེན་བསྟེན་ཚུལ་ལ་རག་ལས་འདུག་པས།",
    "ཞེས་གསུངས་པ་དེ་ལ་དཔྱད་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་གོ།",
    "བཙལ་ཀྱང་ཤིན་ཏུ་རྙེད་དཀའ་ཞིང་ཕྱིན་ཅི་ལོག་ཏུ་བཟུང་ན་གོལ་ས་དང་ཉེས་དམིགས་ཀྱང་གཞན་ལས་ཆེ་བར་འཕགས་པ་ཀླུ་སྒྲུབ་ཡབ་སྲས་ཀྱིས་ཡང་ཡང་གསུངས་འདུག་པས།",
    "མི་གོ་བ་འདུག་ལགས་ཞུས་པ།",
    "སྐབས་སུ་བབས་པ་ན་ངས་ད་ལྟ་ས་བོན་བཏབ་པ་འདི་རྣམས་ཀྱིས་ཀྱང་རྐྱེན་བྱས་ནས་ལེགས་པར་གོ་བ་ཞིག་མྱུར་དུ་འོང་བར་འདུག།",
    "རྗེ་བཙུན་གྱིས་སྔར་བཞིན་ཉམས་སྣང་རང་གར་བ་མིན་པས་གསོལ་བ་དྲག་པོ་ཐོབ།",
    "མྱུར་དུ་རྗེས་སུ་འཛིན་པར་འདུག་གསུངས་ནས།",
    "དེའི་འོག་ན་ཤིད་ཟན་གཏོང་བ་ཡིན་ཟེར་བའི་ཡི་གེ་ཞིག་བྲིས་འདུག།",
    "ལེགས་པར་འཆད་མཁན་ནི་དཀོན་འདུག།",
    "བསྟན་པའི་འཇུག་སྒོ་རྣམ་དག་ཅིག་འདུག་སྟེ་འཇུག་མཁན་མི་འདུག།",
    "རྗེ་ཉིད་ཞལ་ཤིན་ཏུ་ནས་འཛུམ་ཞིང་བཞད་ཆུང་དང་སྦྲགས་ནས་ད་ཅི་གདའ་ཞེས་ཡང་ཡང་གསུངས་ཤིང་།",
    "བེཌཱུརྱ་སེར་པོར་ཁྲི་ཡོད་གསུངས་འདུག།",
    "ཨ་ར་པ་ཙ་ན་བདུན་སྟོང་།",
    "ད་ཐོས་དུས་ཙ་ན་བསམ་སྒོམ་བསྡོ།",
    "བསམ་དུས་ཙ་ན་ཐོས་སྒོམ་བསྡོ།",
    "སྒོམ་དུས་ཙ་ན་ཐོས་བསམ་བསྡོ།",
    "ལས་དང་པོ་པས་དང་པོར་གནས་ལུགས་འཚོལ་བ་ན་མཐའ་བཞི་གང་དུའང་དཔྱད་མ་བཟོད་པའི་ཚེ་རིགས་པ་དེས་སྐྱེ་སོགས་ཐམས་ཅད་ཁེགས་པར་འདུག་སྙམ་དུ་དགོངས་ནས།",
    "ཕར་བཏགས་ཙམ་མིན་པར་གདགས་གཞིའི་ངོས་ནས་ཡོད་ན་བཏགས་དོན་འཚོལ་ལུགས་གདགས་གཞིའི་ངོས་ནས་ཇི་ལྟར་འདུག་བཙལ་བ་ཡིན་པས་དེའི་ཚེ་རྙེད་རྒྱུ་ཞིག་ངེས་པར་ཡོད་དགོས།",
    "རང་རྒྱུད་པས་བདེན་པར་མེད་ཀྱང་རང་མཚན་གྱིས་གྲུབ་ཅེས་པ་ལ།",
    "དོན་ལ་མེད་པ་རང་དུ་འདུག་གོ་སྙམ་ན།",
    "དེ་ལས་རྗེས་ཐོབ་ཏུ་ཚུར་ལངས་ནས་བཀག་པ་དེའི་ཤུལ་ན་ལུས་པ་ཅི་འདུག་པ་བལྟས་པ་ན།",
    "འདོད་པའི་ཆགས་སྲེད་ཀྱི་གདུང་པ་སངས་ཙ་ན་འདོད་ཡོན་ལ་སྤྱད་ཀྱང་མི་གནོད་སྟེ།",
    "རང་རང་སྐུ་ཡི་དབྱིབས་དང་ཕྱག་མཚན་སོགས།",
    "རང་རང་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་ཡི།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "ཉེས་ལྟུང་དྲི་མས་མ་གོས་དཀའ་བར་གདའ།",
    "རང་རང་སྐད་དུ་བསྒྱུར་ཚུལ་སྟོན་ཅིང་བསླབས།",
    "རང་རང་སྐད་རྣམས་འདྲེས་མར་བསྒྱུར་བ་ལས།",
    "བསླབ་པ་གསུམ་ལ་ཉམས་ལེན་ཚུལ་བཞིན་དུ་མཛད་པར་གྲགས་པ་ལྟར་ཡོད་ཚོད་དུ་གདའོ།",
    "གྲོགས་ངན་གྱི་ངག་ལ་མི་ཉན་ཅིང་རང་ཚུགས་ཟིན་པ་དང་།",
    "དུར་ཁྲོད་འཇིགས་སུ་རུང་བ་ཞིག་དེ་ན་གདའ།",
    "ཞེས་བཀའ་གནང་འདུག།",
    "མདུན་ན་འདུག་པའི་རི་བོ་མ་མཐོང་ཞིང་།",
    "དངོས་པོའི་སྤྱི་དང་དངོས་པོའི་བྱེ་བྲག་གང་རུང་མ་ཡིན་པའི་བྱེ་བྲག་གཉིས་ལ་མུ་གསུམ་ལས་མི་འདུག།",
    "སོ་སོ་སྐྱེ་བོ་རྣམས་རང་རང་སོ་སོའི་རྟོག་ངོར་འཆར་མི་འཆར་ལ།",
    "ཨུ་ཐུག་དུས་ཀྱི་ལན་མ་ཡིན་ནོ།",
    "ཡང་རང་རྒྱུད་པ་མན་ཆད་ཀྱི་ལུགས་ལ།",
    "ཕན་ཆ་ཤིན་ཏུ་ཆེ་བར་འདུག་ཅེས་ནན་ཏན་ཆེན་པོས་ཞུ་མཆིད་ཚིགས་བཅད་ཀྱི་ལམ་ནས་སྤེལ་བ་འདི་ལྟར།",
    "སྐབས་འདིར་ཡན་ལག་བདུན་པའི་ཚིགས་སུ་བཅས་པ་མང་ཙམ་འདུག་ཀྱང་ཡི་གེ་མང་བས་མ་བྲིས།",
    "གང་སྣང་ཐམས་ཅད་ཡིག་འབྲུ་ཤིན་ཏུ་ཆེ་བ་མང་པོས་གང་ནས་ཁྲ་ཆེམ་ཆེམ་འདུག་པ་ལ།",
    "ལྡེབ་ཕྲེང་མི་ཚང་བའང་འདུག་པས་དེ་རྣམས་སྟོང་པ་མི་བཞག་ཀ་མེད་བྱུང་བ་བཅས་ལ་བརྟེན་ནས་ད་དུང་ཞུ་བཅོས་མ་ཐུབ་པ་ཤིན་ཏུ་མང་བ་དང་།",
    "ཡིག་ནོར་ཡིན་ངེས་རྣམས་དག་བཅོས་གནང་འདུག།",
    "དོགས་གཞི་ཅན་ནམ་ཐག་མ་ཆོད་པའི་ཚིག་དོན་རྣམས་མ་དཔེ་སོར་བཞག་ལས་བཅོས་མི་འདུག།",
    "དེ་ཡང་རང་བཞིན་གྱི་རྒྱུད་དུ་གབ་པ་ནི་མཚོན་བྱའི་རྒྱུད་རང་ལ་རང་ཆས་སུ་གནས་ཀྱང་རྟོག་པས་སྒྲིབ་པའི་ཕྱིར་གབ་པ་སྟེ།",
    "དེ་དག་ཐམས་ཅད་ཀྱང་རང་བཞིན་དབྱེར་མི་ཕྱེད་པ།",
    "འོ་ན་སེམས་དཔའ་ཡབ་ཡུམ་འཁོར་དུ་འདུག་པས་རྒྱན་དུ་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "འོ་ན་ནང་དང་གསང་བའི་མཚན་དཔེ་དེ་དག་སྐུའི་རྩ་ཁམས་སུ་འདུག་པས་རྒྱན་དུ་ཇི་ལྟར་འགྱུར་སྙམ་ན།",
    "རྡོ་རྗེ་ནི་རྟོག་ཚོགས་སུ་སྣང་ཡང་རང་བཞིན་ལྷའི་དཀྱིལ་འཁོར་དུ་ངེས་པས་དབྱེར་མི་ཕྱེད་པའི་དོན་ཏེ་སྤྱིའི་མཚན་ནོ།",
    "ཐུགས་རིག་པ་རང་སྣང་འབའ་ཞིག་ཏུ་འདུག་པའི་ཕྱིར།",
    "མས་སྦྱང་རང་རྒྱུད་པ་མེད་པའི་ཕྱིར།",
    "རང་རྒྱུད་པ་འབའ་ཞིག་ཏུ་འདུག་པའི་ཕྱིར།",
    "ཚང་ན་ཀུན་ཏུ་བཟང་པོ་དང་ཐུབ་དྲུག་མི་འདུག་པས་གསལ།",
    "འོ་ན་སྟོན་པ་དྲུག་པའི་ཐུགས་དགོངས་མཐར་ཐུག་པ་ཨ་ཏི་ཡིན་པར་འདུག་པ་ལ།",
    "དེ་ཡང་རང་རིག་ཨར་སྣང་བ་དེ་ཉིད་གཟུང་འཛིན་གྱི་སྐྱོན་དང་བྲལ་ཞིང་ཉེས་པས་མ་གོས་པས་དཀར་བ་སྟེ་གསལ་བའི་ཚད་བཞི་དང་ལྡན་པའོ།",
    "ཙ་ནི་སྤྱན་གྱི་སོགས་རྐང་པ་ལྔ་སྟེ།",
    "རྟོག་པ་ནི་ཆད་པར་ལྟ་བའང་རང་རྒྱུད་པར་ཡོད་པ་མ་ཡིན་ཏེ་དག་པའོ།",
    "བདེ་བའི་ཡེ་ཤེས་ཞེ་གཉིས་པོ་ཡང་རང་བཞིན་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ངོ་བོ་འདུས་མ་བྱས་པ་ཉིད་དངོས་པོ་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་བློ།",
    "བྱམས་པས་ནི་གདུང་བ་སྐྱོབ་པས་ཀླུ་ཤིང་འཛིན་པ་ལ་སོགས་པས་མཚོན་ནས་གཞན་རྣམས་ཀྱང་རང་རྟགས་ཀྱིས་མཚོན་པ་སྟེ།",
    "སྟོན་པ་ནི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དང་རྒྱུད་གཅིག་དང་དུ་མ་ལས་གྲོལ་བར་འདུག་ལ།",
    "ཆགས་པའི་དམ་ཚིག་དུས་ཡིན་ནོ།",
    "དེ་ཡང་རང་རྩ་བའི་ལྷ་བསྐྱེད་པའི་ས་བོན་ལས་འོད་ཟེར་འོག་མིན་དུ་འཕྲོས།",
    "ཞེས་འདུག་པའི་ཕྱིར་དེ་བཞིན་གཤེགས་པའི་གསུངས་མིན་པར་འགྱུར་རོ་ཞེས་མགོ་བསྒྲེའོ།",
    "དང་པོར་སྒྲུབ་པ་ལ་འཇུག་དུས་འདོད་པའི་དོན་མ་གྲུབ་ཀྱི་བར་དུ་བསྒྲུབ་བོ་སྙམ་པའི་དམ་ནོས་པ་བཞིན་དུ་མཐར་སྐྱེལ་བར་བྱ་ཞིང་།",
    "བཞི་པ་ལྟར་ན་ཡུམ་བྱིན་གྱིས་བརླབ་ཅིང་གདན་གཅིག་ལ་འདུག་པའོ།",
    "ཟག་མེད་ཀྱི་བདེ་བས་ལུས་མགོ་མཇུག་མ་ལུས་པར་ཁྱབ་ཙ་ན་རྟོག་ཚོགས་ཐམས་ཅད་སྐུ་དང་ཡེ་ཤེས་སུ་གསལ་བའོ།",
    "འདིས་མཉེས་པ་ཆེན་པོའི་གླུས་ཉིད་ཀྱི་དཀྱིལ་འཁོར་ལ་བསྟོད་པའི་ལེའུ་སྟེ་བཅུ་བཞི་པའོ། ། འདིར་འོ་ན་མཉེས་པའི་ལེའུ་བྱ་བ་འདུག་པས་རྒྱལ་བ་ལ་མཉེས་མི་མཉེས་མངའ་ན་གཟུང་འཛིན་ཅན་དུ་འགྱུར་རོ་ཞེ་ན།",
