    "ཡོད་པར་ནི་རློམ་གྱིན་འདུག་ཟེར།",
    "དེའི་ཕྱགས་ཕྱིར་སློབ་དཔོན་ཀུན་རྒྱལ་དང་ཁྱེད་རྣམ་གཉིས་ཀྱང་འདུག་པས་ངས་སྤྱན་འདྲེན་རྣམས་བསྐྲད།",
    "ང་རྒྱ་བོ་འདིའི་དུར་ཡིན་པས་རྒྱ་དུར་ཟེར་བར་འདུག་གསུང་།",
    "སྐུ་དྲིན་ལ་གསུངས་ནས་སྤྱན་ཆབ་མང་དུ་འབྱོན་གྱི་འདུག་གསུང་།",
    "དེ་སྒྲོན་གསལ་གྱི་སྦྱོར་དྲུག་ལོགས་སུ་ཕྱུང་བ་ལྟ་བུར་འདུག་གསུང་།",
    "ཉིན་ཞིག་གླ་བ་གཅིག་ནགས་བསེབ་ན་འདུག་པས།",
    "དེ་རྣམས་ཀྱི་ཁྲོད་ན་མར་ཐེགས་པས་ཕྱག་ན་མི་མགོ་ཞིག་འདུག་པ་ལ་ཅི་ཡིན་དགོངས་པའི་ཚེ།",
    "འདི་ཁྱེད་རང་ལ་གནོད་པ་དེའི་མགོར་འདུག་ཟེར།",
    "འདིར་རྒྱུན་ཏུ་སྐུ་མདུན་ཁོ་ནར་སྡོད་དགོས་པ་འདི་ཡང་མདུན་མའི་ཕུགས་བཟང་པོ་ཞིག་མི་འདུག་བསམ་ནས་འདུན་མ་བསྒྱུར་འདོད་ཆེན་པོ་བྱུང་བ་ཡིན་གསུང་།",
    "བདག་ཙ་རི་ཕྱོགས་ལ་འགྲོ་འདོད་པ་ཐོན་པར་འདུག་ལགས་སམ་ཞེས་ཞུས་པས།",
    "ཕྱི་ཤོལ་ཆེན་པོ་རང་འདུག་ནའང་ཐོན་པར་འདུག་གསུང་པའི་ལུང་བསྟན་བཟང་པོ་བྱུང་།",
    "ཁོང་ཅི་ཡང་མི་ཟེར་ཡང་གཏམ་དེ་བྱང་རྩེ་བ་ལ་སྐྱལ་འདུག།",
    "དཀའ་གནས་ལམ་རིམ་གྱིས་མི་ཤོད་པ་མང་དུ་འདུག།",
    "དེ་བླངས་པས་ཕམ་པ་འོང་བར་གསུངས་འདུག་པ།",
    "ད་འོ་ན་ཁྱེད་རང་ཇི་ལྟར་མཛད་གསུང་།",
    "དེ་རིང་འདི་ནས་ཕེབས་པ་ལ་ལྟ་བར་འདུག།",
    "གང་སྐྱལ་རྣམས་ལ་འཛད་རྒྱུའང་མི་འདུག།",
    "སྲིས་སྨེ་བ་དངོས་གྲུབ་ཏུ་འདུག།",
    "རྗེས་ཀྱི་མི་རྣམས་ལ་དད་པ་མི་འདུག་པ་གསུང་།",
    "ཙ་རི་སྒྲ་བརྙན་སྣ་ཚོགས་ཐོས་པའི་གནས་ཡིན་ཟེར་བ་བདེན་པར་འདུག་གསུང་།",
    "ན་ཡབ་འཛུམ་མི་སྟོན་པ་རྣམས་ཀྱང་འཛུམ་སྟོན་གྱི་འདུག་གསུང་།",
    "སྟག་ལུང་པ་མཁའ་སྤྱོད་པའི་སྐུ་སྐྱེ་ཞིག་ཡིན་ཟེར་བ་བདེན་པར་འདུག་བསམ།",
    "དེ་རྗེས་ཁོང་རྣམ་གཉིས་འདྲ་པོ་མི་འདུག།",
    "ནང་སྤྱད་ཀྱི་དངོས་པོ་ས་ཞིང་དང་བཅས་པ་ཁོང་རང་ལ་བསྐྱུར་ནས།",
    "ཁྱེད་ཀྱིས་ཀྱང་སྤྱན་འདྲེན་པའི་ཁས་བླངས་ཕུལ་འདུག་པ་བཞིན།",
    "ཕྱི་ནས་སྤྱན་འདྲེན་པ་ཡང་ཤིན་ཏུ་དཀའ་བར་འདུག།",
    "བཙུན་ཆེན་ཡེ་ཤེས་བློ་གྲོས་དང་། ཟེར་བ་འདུག་པ་ཞུས་པས།",
    "ཁྱད་པར་ཁོང་རང་དུས་འཁོར་ལ་ཤིན་ཏུ་མཁས་པས་སྤྱིར་དུས་འཁོར་སྐོར་དང་།",
    "དབྱིབས་སུའམ་ཞེས་བརྟགས་པར་གསུངས་འདུག་པ་གསུངས་པས།",
    "ཁོང་ཅི་ཡང་མི་གསུངས་པར་འདུག།",
    "འདི་མ་གོ་བས་འདི་ཞུ་དགོངས་ནས་སྤྱན་སྔར་ཐེགས་པའི་ཚེ་སྐུ་མདུན་དུ་མ་ཕེབས་ཙམ་ལ་ཕལ་ཆེར་གོ་ཡོང་པར་འདུག།",
    "དེའི་ཚོད་དུ་འདུག་སྟེ།",
    "ཁོང་རང་སྐྱིད་པོ་བྱེད་གསུང་ཟེར་བ་དང་།",
    "ངའི་འཆད་ཉན་ཞིང་འདི་ངེད་རང་དཔོན་སློབ་གཉིས་ཀས་ཞུས་ནས་ཁྱེད་རང་བཟུང་བ་འཐད་གསུང་བའི་ཞལ་ཏ་བཟང་པོ་ཕེབས་པ་ལ།",
    "ཁོང་ཁ་རྡུང་བྱེད་ཀྱིས་འདུག་པས་བཞག་བཏང་ཟེར།",
    "འབེན་ཕྱི་རོལ་ཏུ་བཙལ་བར་འདུག།",
    "ད་དེས་ཅུང་ཟད་མི་འོང་བར་འདུག།",
    "ཁོ་རང་གང་བྱེད་ལ་ཁྲོ་བ་སྟོན་པར་མི་མཛད་པས་སྔར་ལྟར་འགྲོགས་ཐུབ།",
    "གྲི་གཅིག་གྱེན་དུ་བསླངས་འདུག་པ་དེ་སུས་བྱས་དགོངས་ནའང་།",
    "ཞེས་བྱ་བར་འདུག།",
    "འདིར་སྦྱིན་བདག་རྣམ་པ་ཡང་ཤིན་ཏུ་གུས་པར་འདུག་པས་ངེད་ཀྱིས་གཞིས་ཀྱང་ཞུས་ནས་འབུལ།",
    "དེ་གཉིས་ཀྱང་རྗེ་བཙུན་གཙང་བར་འདུག།",
    "འཁོར་ངན་གྱི་རྗེས་སུ་བང་མི་འདུག།",
    "རས་ཕྱམ་དང་ཞྭ་ཐེབ་གྱོན་ནས་འདུག་པ་ལ།",
    "གཞན་འདི་ཡིན་མི་གསལ་བའི་ནག་ནོག་མང་དུ་འདུག་པ་རྣམས་ལ།",
    "ད་ལན་ཁྱེད་རང་ཡང་འགོག་པ་ལ་སྙོམས་པར་ཞུགས་དགོས་པ་ཡིན་ཟེར་བ་དང་།",
    "ཕ་ཟད་དེ་ན་ཆུ་ཞིག་འདུག་པ་དེ་བསྟན་ནས།",
    "ལར་བབས་ལྕི་བར་འདུག་གསུང་།",
    "གླང་པོ་ཆེ་དེའང་མེད་པས་གཅིག་པུར་འདུག་ནས་ནམ་མཁའ་འཕུར་ཕྱིན་པས་ནགས་ཚལ་དང་རྩི་ཤིང་མང་དུ་སྐྱེས་པ་དང་།",
    "སྐུ་སྐྱེ་དེ་ལ་ཕྱག་རྒྱ་ཆེན་པོའི་རྟོགས་པ་འཆར་བར་འདུག་གམ་ཞུས་པས།",
    "དེར་མི་གཡོ་བའི་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་ཤཱཀྱ་ཐུབ་པས་བྱས་པ་ཞིག་འདུག་པས།",
    "རྒྱུ་རབ་ཀྱི་ཕུ་ན་ཡར་ཐེགས་པས་དེ་ན་ཁང་པ་གཅིག་འདུག།",
    "བྱ་རྒོད་ལྔ་ལ་ལྕགས་ཐག་བཏགས་པ་དེ་རྣམས་ཀྱང་ཁྱི་བཞིན་དུ་འཐེན་ཞིང་འདུག།",
    "གཡས་ན་གཏོར་མ་ཞིག་ལ་ཕུར་པ་ཞིག་བཙུགས་འདུག་པའི་ཞལ་འོག་མ་བཞི་ནག་པོར་ཡོད་པ།",
    "དེ་ལ་ཟླ་བོ་གཞན་ཡང་འདུག་པས་གདན་ཞིག་བཤམས་སྣང་བ་ལ་བཞུགས་ཟེར།",
    "འདི་ངན་བྱེད་གཅིག་ཏུ་འདུག་དགོངས་ནས།",
    "མཐུ་པ་ཞིག་ཏུ་འདུག་པས་ཐམས་ཅད་ཀྱིས་རྡོ་རྒྱོབ་གསུངས་པས།",
    "སྒོ་དེའི་ཕྱི་རོལ་གྱི་རྡོ་ཁྲོད་རྣམས་ལ་ཡུངས་ཀར་དང་སྲན་མ་བསྲེས་པ་མང་དུ་གཏོར་འདུག་པས།",
    "ཚོན་སྐུད་སྣ་ལྔས་བྲེས་འདུག་པས་འདི་སུས་བྱས་པ་ཡིན་གསུངས་པས།",
    "ད་ནི་བྲོས་པས་མི་ཐར་བར་འདུག་དགོངས་ནས་ནམ་མཁའ་ལ་འཕུར་ཏེ་གཤེགས་པས།",
    "སྒང་སྟོད་ཀྱི་ཐད་དེ་ན་མཁར་རིང་པོ་ཞིག་འདུག་པས་དེའི་ཁར་བབས་ནས་སྐུ་ངལ་གསོས་པས་དེའི་ཕ་ཟད་ན་གཡམ་པའི་སྒོ་ཡོང་པ་ཞིག་འདུག།",
    "ད་ས་ག་ནས་སམ་ལས་རྟ་པ་དེ་རྣམས་ཀྱང་བདུད་ཡིན་པར་དགོངས་ཙ་ན་དེ་རྣམས་ཀྱང་མཁར་རྩ་དེར་སླེབ་བྱུང་ནས།",
    "དེར་བྱད་ཀྱི་མཚན་མར་འདུག་པས་འདི་རྣམས་ཀྱི་ཁྲོད་དུ་མ་ལྷུང་བ་ཞིག་བྱའོ་དགོངས་ཙ་ན།",
    "ད་དེ་ད་ལྟ་ཟིན་ཡོང་བར་འདུག་ཟེར་ནས་དགའ་སྤྲོ་ཆེན་པོ་བྱེད་ཅིང་འདུག་གསུང་ངོ།",
    "ན་བཟའ་སྤུ་བོ་ཆེ་སྔོན་པོ་ཞིག་མནབས་ནས་འདུག་པ་ལ་བྱིན་བརླབས་ཞུས་པས་སྟེགས་དེ་ལ་གཅིག་ཀྱང་མ་སྙོགས་པ་ཞིག་བྱུང་བས།",
    "ན་བཟའ་སྤུ་བོ་ཆེ་སྔོན་པོ་ཞིག་མནབས་ཡོད་པར་འདུག་གསུངས་པས་དེ་ཁ་འདུག་ཟེར་ནས་ཁོ་ངོ་མཚར་དུ་གྱུར་བྱུང་།",
    "བདག་པོ་འདིའི་རིང་ལ་མི་སངས་པར་འདུག།",
    "འཕན་ཡུལ་ན་བཞུགས་པ་སྙམ་བྱེད་པ་ཞིག་ལ་འཕན་ཡུལ་གྱི་ལུང་བ་དེའི་རི་ཐམས་ཅད་ནགས་ཚལ་ཤིན་ཏུ་བཟང་བོས་ཁེབས་འདུག།",
    "ཤིང་དེ་རྣམས་ཀྱི་སྟེང་ན་བྱ་རོག་དཔག་ཏུ་མེད་པ་འདུག་པ་རྣམས་ཕུ་མདའ་ཐམས་ཅད་ནས་འདུས་ཏེ།",
    "ཟེར་བ་ཡོད་པ་དེ་དྲན་ནས་དེའི་དོན་དུ་བསམ་པའི་ལུགས་བྱེད་ཅིང་འདུག།",
    "ཚིག་དེའི་དོན་ནི་དེ་མིན་པར་འདུག་གསུང་།",
    "དེ་ནས་ཉི་མ་ནུབ་ཙ་ན་ཡབ་ཀྱི་ཕུའི་རྫ་སྟོངས་ཆེ་བ་མཚོ་ཆེན་པོ་གཉིས་ཀྱི་བར་ན་ཕར་ལམ་ཡོད་པ་ཞིག་ཏུ་ཕེབས།",
    "རུས་པའི་རྒྱུན་རྣམས་ཀྱང་རབ་ཏུ་དཀར་བ་ཞིག་གར་སྟབས་ལིང་ངེ་བཞུགས་འདུག།",
    "ལུང་པ་རལ་གསུམ་འདུག་པའི་དབུས་མ་དེ་སྐུ་ལུས་སུ་གྱུར།",
    "རྡོ་ལ་འབུར་དུ་དོད་པ་སྙམ་བྱེད་པའི་པཎྜི་ཏ་འཁོར་དང་བཅས་པ་ཧ་ཅང་ཁ་དོག་མཚར་བ་མིན་ཙམ་ཞིག་འདུག།",
    "ད་དེ་དཔོན་སློབ་ཀྱང་སྔར་བཞིན་མི་འོང་བར་འདུག་ཟེར་བས།",
    "ཕ་ཟད་ནས་དངོས་སུ་བཞུགས་འདུག་དགོངས་པ་བྱུང་།",
    "དབོན་པོ་ཁྱེད་ཀྱིས་ངའི་ཡོན་ཏན་ལ་པོ་ཏི་འདི་ཙམ་ཞིག་ཤེས་པར་འདུག་ཟེར་བའི་ཚད་ཅིག་ཞོག་གསུང་བས།",
    "ཁྱད་པར་རྣམ་འགྲེལ་ལ་མཁས་པ་ཡིན་ཞུ་བར་གདའ་ཞུས་པས།",
    "ཅེས་བྱ་བའི་དུས་ལ་ཁོ་བོ་བབ་འདུག།",
    "འོན་ཀྱང་མཐོང་བ་ཐམས་ཅད་ལ་མི་གོ་བ་མི་འོང་པར་འདུག་གསུང་།",
    "སྐབས་སུ་དེ་རིང་དེ་བློ་བསྐྱེད་ཆེ་ཞེས་གསུང་བའང་མང་དུ་གནང་བར་འདུག།",
    "དེ་རིང་འདི་ཙམ་ཞིག་གསུང་ངོ་དགོངས་ཏེ་ཐུགས་ཀྱིས་ལེགས་པར་དཔྱད་པ་རྣམས་ཉན་པ་པོས་སླེབ་པའི་ཚེ་ཁོ་རང་དང་འཚམས་པ་ཞིག་མ་གཏོགས་མི་འཆར་བར་འདུག་གསུང་།",
    "ད་ལན་མི་བབས་པར་འདུག་ཅེས་བྱ་བའི་གཏམ་ཡང་གཉུག་མར་གནས་པར་དག་ལ་ཡོད་དེ།",
    "དེའི་དོན་གྱིས་ད་ལྟར་ཡིད་ལ་བྱས་དུས་སུ་ཡང་སྐྱིད་སྣང་ཆེ་བར་འདུག་གསུང་།",
    "མི་ཁྲིད་མ་ཉན་པ་དང་ལྷན་དུ་རྒྱུད་ཞུ་བ་འདི་ཐན་ཆེ་བ་ཞིག་འདུག་ཟེར།",
    "དེའི་རྒྱུན་མ་ཆད་པར་ཕྱིའི་རྒྱ་མཚོ་ཆེན་པོར་འདྲེས་འགྲོ་བའི་མནལ་ལམ་ཞིག་ཀྱང་བྱུང་བས་དེ་འཕྲིན་ལས་ཀྱི་རྟགས་སུ་འདུག་གསུང་།",
    "སྐུ་ལུས་ཀྱི་འབྱུང་པ་རྣམས་བསྡུས་པས་ཡུན་དུ་མི་བཞུགས་པར་འདུག་ཅེས་སྨྲས་ཏེ།",
    "ལྷ་ལ་ཡེ་ཤེས་པ་ཐུགས་ཀྱི་སྟོབས་བསྐྱེད་ནས་འབེབས་ཤིང་འདུག་པས།",
    "ལས་སྒྲིབ་ཆེ་བ་ཡིན་པར་འདུག།",
    "དེ་ཉིད་ཕེབས་པར་འདུག་ཟེར་ནས་ཐམས་ཅད་ཀྱིས་བྱ་ར་བྱས།",
    "མིན་པར་འདུག་མིན་པར་འདུག་ཟེར་ནས་རིའི་མར་སྣ་དེ་ལ་ཕེབས་བྱོན་པ་དང་།",
    "སོ་མ་ས་ས་གསོད་བསོད་དགོངས་པར་འདུག་གསུང་།",
    "དེ་ནས་ཞིབ་ཏུ་ལྟ་དུས་ལྷ་བཟོ་འབྲིང་ཙམ་དུ་འདུག་གསུང་།",
    "བློས་ཐག་ཆེན་པོ་ཞིག་བཅད་འདུག་གོ།",
    "སྐུ་མདུན་དུ་བྱིན་པའི་ཚེ་བྱིན་ལ་བསམས་པས་ས་བསམ་ཡང་བརླབས་ཀྱང་གཞན་དང་མི་མཉམ་པ་ཞིག་འདུག་ཅེས་ཡང་དང་ཡང་དུ་སྒྲོགས་པར་མཛད་དོ།",
    "དེ་དང་འབྲལ་བར་འདུག་དགོངས་ནས་དེའི་ལན་དུ།",
    "ཞལ་རོག་ཏུ་བཞུགས་པར་འདུག།",
    "བཞེད་པ་དང་མི་འབྱོར་བ་མི་འདུག་ན་དུས་ཚིགས་ཐག་ཆོད་ལ་ཤོག།",
    "སླར་སྐུ་མདུན་དུ་འོངས་ཏེ་སང་རང་ལ་དུས་གནང་ཡོད་ཞུས་པས་དགྱེས་ཆེས་ཏེ།",
    "གཞན་སུས་ཀྱང་མ་ཚོར་བར་འདུག།",
    "དེ་ཁྱེད་རང་རྣམ་གཉིས་ཀྱི་བྱིན་བརླབས་སུ་འདུག་གསུང་།",
    "བུམ་པ་ཡུམ་ལོ་ཙ་ནར་བསྒོམས་ལ་སྔགས་འདི་བརྒྱ་འམ་ནུས་ཚད་བཟླས་སོ།",
    "ཨོཾ་རུ་རུ་ཕུ་རུ་ཛཱ་ལ་སིདྡྷི་ལོ་ཙ་ན་སྭཱ་ཧཱ།",
    "ཨོཾ་རུ་རུ་ཕུ་རུ་ཛ་ཡ་སིདྡྷི་སི་ཏ་ན་ལོ་ཙ་ན་སྭཱ་ཧཱ།",
    "རུལ་འགྲོ་བར་འདུག་གོ་ཟེར་བ་ཅིག་བྱུང་།",
    "གར་འདུག་གཞན་དུ་འཚོལ་བའི་བར་ལ།",
    "དད་པ་དང་ཤེས་རབ་འདུག་པས།",
    "འཚེངས་འདུག་སྟེ་ཞེས་གསུངས།",
    "ན་ཉིང་དབུས་ལ་འགྲོ་འདོད་འདུག་པ་ངེད་ཀྱིས་བཀག་པས་ལན་ད་ལོ་ཅིས་ཀྱང་རྒྱུག་གསུང་།",
    "སྔར་གཞན་ལ་མ་གནང་པའི་ཟིན་བྲིས་ཁྱད་པར་ཅན་མཛད་འདུག་པ་གནང་།",
    "ཐུགས་དམ་མཐིལ་དུ་འདུག་པ་དང་།",
    "ས་སྐྱ་པའི་བྱང་སེམས་ཛྙཱ་ན་ཤྲཱྀ་ལ་དངོས་སུ་གསན་འདུག་པས།",
    "བསྟན་པའི་མཐར་ཐུག་དུས་ཀྱི་འཁོར་ལོ་ལག་ལེན་ལ།",
    "དེ་ཡི་མདུན་ན་ང་འདུག་སྟེ།"
  ]
}