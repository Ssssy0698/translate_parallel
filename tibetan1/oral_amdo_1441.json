    "དམྱིགས་མེད་ཐུགས་རེས་ཀུན་ནས་བརླན།",
    "དགེ་ལེགས་ཤར་རྱིའྱི་རེ་ནས་མངོན་བྱུང་ཀུ་དྷ འྱི་མཛེས་པ་རབ་ཏུ་འཛིན།",
    "ཐུགས་རེའྱི་བསྱིལ་ཟེར་ཀུན་ལ་སྙོམས་ཤྱིང་ཕན་བདེའྱི་རྱི་བོང་རགས་ཀྱིས་མཚན།",
    "བདུད་རྱིའྱི་འོད་གཏེར་དབྱངས་ཅན་ལྷ་མོས་བདག་བོའྱི་ཀུ་མུད་རྱིང་དུ་སོངས།",
    "བདག་ཡྱིད་ག་཈ྱིས་འཐུང་སོང་གྱུར་པས།",
    "བང་རྱིམ་རེ་རེར་ཡང་།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་རོམ་སྙན་ངག་ཨའྱི་དབྱངས་ངེས་སོགས་ཁག་གསུམ་གྱི་འགྲེལ་བ།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་རོམ་སྙན་ངག་ཨའྱི་དབྱངས་ངེས་སོགས་ཁག་གསུམ་གྱི་འགྲེལ་བ།",
    "གང་དེ་འཛིན་མའྱི་ཁྱོན་ཡངས་ཡངས་པའྱི་རྒྱལ་སྱིད་སྱིད་ལ་རབ་བརེ་བྱམས་པའྱི་ཐུགས་ནྱི་དུལ་བ་ཡྱིས།",
    "གང་གྱི་མཐུ་ཡྱིས་ཐུབ་བསྟན་བསྟན་པའྱི་རྒྱལ་མཚན་མཚན་མོ་རྒྱུ་འདྲའྱི་ནག་ཕོགས་རྣམས་ཀྱིས་མྱི་བཟོད་པ།",
    "གང་དུ་གུས་པས་རབ་འཛིན་འཛིན་མའྱི་དཀྱིལ་འཁོར་འཁོར་ལོས་བསྒྱུར་ཞྱིང་སོང་བའྱི་གསུང་གྱིས་བསྐུལ་བ་དང་།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་རོམ་སྙན་ངག་ཨའྱི་དབྱངས་ངེས་སོགས་ཁག་གསུམ་གྱི་འགྲེལ་བ།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་རོམ་སྙན་ངག་ཨའྱི་དབྱངས་ངེས་སོགས་ཁག་གསུམ་གྱི་འགྲེལ་བ།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་རོམ་སྙན་ངག་ཨའྱི་དབྱངས་ངེས་སོགས་ཁག་གསུམ་གྱི་འགྲེལ་བ།",
    "རེ་འཇྱིགས་མེད་རྱིགས་པའྱི་བོ་གྲོས་ཀྱི་རང་གྱི་བྱུང་བ་བརོད་པ་བདེན་གཏམ་རྣ་བའྱི་བདུད་རྱི་སོགས་ཀྱི་གེང་གཞྱི་དང་མཇུག་བྱང་གང་རུང་དུ།",
    "མ་གཞྱི་རེ་ཙོང་ཁ་པ་ཆེན་པོ་ནྱི་གངས་ཅན་མཁས་པ་ཡོངས་ཀྱི་གཙུག་རྒྱན་ཡྱིན་པར་མ་ཟད།",
    "རྱིགས་ལམ་ཕ་མོ་འབྱེད་པའྱི་རྣམ་དཔྱོད་དང་།",
    "སྱིར་ཁོང་གྱིས་མཛད་པའྱི་བསྟོད་ཆེན་བཞྱི་སོགས་གཙོས་པའྱི་སྙན་ངག་གྱི་བསྟན་བཅོས་ཕལ་མོ་ཆེ།",
    "ཀུན་མཁྱེན་ཁྱོད་དང་དབྱེར་མ་མཆྱིས།",
    "མཁས་མང་དབུས་ན་ཡོན་ཏན་གཏེར་ཆེན་ཁྱོད།",
    "དམྱིགས་པ་མེད་པའྱི་ཐུགས་རེ་ནྱི་ཆུ་བོ་ལྟར་རྒྱུད་ཆད་མེད།",
    "རེ་ཐམས་ཅད་མཁྱེན་པ་ནྱི་དེ་ལྟ་མ་ཡྱིན་པར་ཁོང་གྱིས་མཛད་པའྱི་བསྟན་བཅོས་རྣམས་ལ་ཚིག་ལ་གཟྱིགས་ན་རོམ་པའྱི་ལྟད་མོ་ཡོད་པ།",
    "སྙན་ངག་གྱི་བསྟན་བཅོས་རེ་གྲས་ནོར་བང་ཨོ་རྒྱན།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་རོམ་སྙན་ངག་ཨའྱི་དབྱངས་ངེས་སོགས་ཁག་གསུམ་གྱི་འགྲེལ་བ།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་རོམ་སྙན་ངག་ཨའྱི་དབྱངས་ངེས་སོགས་ཁག་གསུམ་གྱི་འགྲེལ་བ།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་རོམ་སྙན་ངག་ཨའྱི་དབྱངས་ངེས་སོགས་ཁག་གསུམ་གྱི་འགྲེལ་བ།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་རོམ་སྙན་ངག་ཨའྱི་དབྱངས་ངེས་སོགས་ཁག་གསུམ་གྱི་འགྲེལ་བ།",
    "བར་དུ་རེན་དེ་ལ་ཡོན་ཏན་བརྙེས་པའྱི་ཚུལ།",
    "གཞོན་དུས་ནས་བཟོ་གསོ་སྒྱུ་རལ་སོགས་འཇྱིག་རེན་ལུགས་ཀྱི་བསྟན་བཅོས་དང་རྱིག་བྱེད་ཐམས་ཅད་ཁོང་དུ་ཆུད་པ།",
    "བསྡུ་བཞྱི་ཕྱིན་དྲུག་གྱི་སོད་པས་རང་གཞན་དོན་ག་཈ྱིས་རོགས་པར་རེ་ཙོང་ཁ་པ་བོ་བཟང་གྲགས་པ།",
    "ཤ་རེ་ཙོང་ཁ་པ་བོ་བཟང་གྲགས་པ།",
    "མཐར་བོད་ཡུལ་ནས་གཟྱིགས་སྐུའྱི་བཀོད་པ་བསྡུས་པ་སོགས་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡྱིན་པའྱི་མཛད་པ་རྣམས་བརོད་ཡོད།",
    "བར་དུ་རེན་དེ་ལ་ཡོན་ཏན་ཕུན་སུམ་ཚོགས་པ་བརྙེས་ཚུལ།",
    "རེན་དེ་ལ་ཡོན་ཏན་བརྙེས་པའྱི་ཚུལ།",
    "ཤ་ཚོགས་ལེགས་ལམ་གྱི་རེ་མོ་རུ།",
    "དེ་ལ་འདྱིར་རེ་བདག་཈ྱིད་ཆེན་པོས་ལམ་རྱིམ་ཆེན་མོར།",
    "རེན་དེ་ལ་ཡོན་ཏན་བརྙེས་པའྱི་ཚུལ།",
    "བརྙེས་ནས་བསྟན་པ་ལ་བྱ་བ་མཛད་པའྱི་ཚུལ་གསུམ་དུ་ཇོ་བོ་ཆེན་པོའྱི་ཡོན་ཏན་འགངས་ཆེ་རྱིགས་མ་ཚང་བ་མེད་པར་འདུས་པ་རེའྱི་དགོངས་པར་གནས་པ་བཞྱིན།",
    "རེན་དེ་ལ་ཡོན་ཏན་བརྙེས་པའྱི་ཚུལ།",
    "ཚིག་གྱི་སོར་བ་ཕུན་སུམ་ཚོགས་པ་ལ་བརེན་ནས།",
    "ཞེས་དང་། རྒྱལ་བ་ཐམས་ཅད་ཀྱི་མཁྱེན་བརེ་གཅྱིག་ཏུ་བསྡུས་པ་ལྔ་བརྒྱ་པ་རྣམས་ཀྱི་གཙུག་གྱི་ནོར་བུ།",
    "སྐབས་དེར་རེ་ཙོང་ཁ་པ་སྐུ་འཚོ་བཞེས་གནང་ཡོད་པས།",
    "རེ་འདྱི་ཐེངས་ག་཈ྱིས་པར་གཙང་ཕོགས་སུ་ཕེབས་པ་ནྱི།",
    "སྐབས་དེར་རྒྱལ་རེ་སེ་སྱིད་རབ་བརན་ཀུན་བཟང་འཕགས་ཀྱིས་རེ་འདྱི་དང་ཀུན་མཁྱེན་རོང་སྟོན་པ་ག་཈ྱིས་རོད་གེང་མཛད་དགོས་པར་བསྐུལ་མ་ཞུས་པ་ལྟར་རྒྱལ་རེ་གཙུག་ལག་ཁང་དུ་ཕེབས་པ་དང་།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་འབུམ་པོད་ཀ་བ།",
    "ཤ་ཐར་དེ་དག་ལ་ཞྱིབ་མོར་མཇལ་ན་ཤེས་པར་འགྱུར་ལ།",
    "རེ་འདྱི་཈ྱིད་རེ་ཙོང་ཁ་པ་ལས་དགུང་གྲངས་཈ྱི་ཤུ་ལྷག་ལས་མྱི་ཆུང་བ་དང་སས་ཀྱི་ཐུ་བོའང་ཡྱིན་པས།",
    "འོལ་ཁ་རེ་དྲུང་བོ་བཟང་འཕྱིན་ལས།",
    "ཀུན་མཁྱེན་འཇམ་དབྱངས་བཞད་པའྱི་རྡོ་རེ།",
    "དེ་ལྟ་མོད་ཀྱི་ཚུལ་དེ་ནྱི་སེ་བོ་ཕལ་མོ་ཆེ་དག་གྱིས་བསམ་པར་བྱ་དཀའ་བའྱི་གནས་ཡྱིན་པའྱི་ཕྱིར་དང་།",
    "དོན་རྱིམ་པ་རེའྱི་རོགས་མཚམས་སུ་བར་སྐབས་ངལ་གསོའྱི་ཚིགས་བཅད་ཁ་ཤས་ཡོད།",
    "རེ་ཙོང་ཁ་པའྱི་གསུང་འབུམ་པོད་ཀ་བ།",
    "ཐུན་མོང་མ་ཡྱིན་པའྱི་མཛད་རྣམ་སྐོར་ལོགས་སུ་བཀར་ཏེ་བསྟན་བཅོས་མཛད་པ་མྱི་མཐོང་།",
