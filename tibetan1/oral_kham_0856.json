    "ཞེས་པས་ཁྱེད་རང་རྣམས་ཁྲིད་དེ།",
    "དང་པོ་ཕན་ཡོན་གྱི་སྒོ་ནས་དམ་ལ་བཞག་པའི་དོན་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལྟེ་བར་ལཾ་ལས་སའི་དཀྱིལ་འཁོར་གྲུ་བཞི་སེར་པོ་རྡོ་རྗེས་མཚན་པ་ལ་ཉི་མར་ཧཱུྃ་སྔོན་པོ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་མིག་དར་གྱིས་བཅིངས་བཞིན་དཀྱིལ་འཁོར་ལ་བལྟར་བཅུག་ནས་མིག་སྔར་ཅི་སྣང་ཞེས་དྲིས་པ་ལ།",
    "སློབ་དཔོན་གྱིས་ཁྱེད་རང་རྣམས་ཀྱི་མིག་སྔར་ཅི་སྣང་ཞེས་དྲི།",
    "ད་ཁྱེད་རང་རྣམས་ལག་ཏུ་རྡོ་རྗེ་བཟུང་ལ་རྡོ་རྗེའི་སྟངས་སྟབས་ཀྱི་གར་དང་བཅས་འཁྱིལ་སྔགས་ཟློ་བཞིན་དཀྱིལ་འཁོར་ལ་བསྐོར་བ་ལན་གསུམ་བྱེད་པའི་ཐུགས་འདུན་མཛོད།",
    "ཡང་ན་དམིགས་ཀྱང་རུང་སྟེ་ཁྱེད་རང་རྣམས་སྤྱན་དམིགས་འདི་བཞིན་དུ་སྒོམས་མཛོད།",
    "ཁྱེད་རང་རྣམས་རྡོ་རྗེ་འཆང་ཆེན་པོའི་སྐུར་བསྒོམས་ཞལ་དཀྱིལ་འཁོར་ལ་ཕྱོགས་ཏེ་བཞུགས་མཛོད།",
    "ཞེས་གསུངས་པ་ལྟར་བྱ་བ་ཡིན་པས་ཁྱེད་རང་རྣམས་སྤྱན་དམིགས་འདི་བཞིན་དུ་སྒོམས་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཕྱག་གཡས་འགྱིང་བའི་ཚུལ་གྱིས་རྡོ་རྗེ་བཟུང་བའི་ཐུགས་འདུན་མཛོད།",
    "ཁྱེད་རང་རྣམས་ཕྱག་གཡོན་དཀུར་བརྟེན་པའི་ཚུལ་གྱིས་དྲིལ་བུ་བཟུང་བའི་ཐུགས་འདུན་མཛོད་དྲིལ་བུ་ཨཱ་ལས་བྱུང་བ།",
    "སྟངས་སྟབས་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "ཅེས་ལན་གཅིག་ཁྱེད་རང་རྣམས་དེང་ནས་བཟུང་བཅོམ་ལྡན་འདས་གང་ཡིན་དེའི་མཚན་བཅུག་སྟེ།",
    "ཁྱེད་རང་རྣམས་ཕྱག་རྒྱ་དང་བཅས་ཕྱོགས་བཞི་སྟེང་འོག་ཀུན་ཏུ་མདའ་འཕང་བའི་ཚུལ་གྱིས་འདིའི་རྗེས་ཟློས་མཛོད་སརྦ་ཏ་ཐཱ་ག་ཏ་ཨ་ནུ་རཱ་ག་ཡ་མི།",
    "ཁྱེད་རང་རྣམས་ཀྱིས།",
    "དེས་ཀྱང་སྐྱེ་གནས་གུར་ཀུམ་ལ་སོགས་པའི་ཆུས་དྲི་ཞིམ་པར་བྱས་གོས་དང་བྲལ་བ་ལག་པས་བསྐྲད་དེ་ཁྱེད་རང་རྣམས་ལ་སྟོན་ཏེ།",
    "ཚིག་འདི་དག་རིག་མའི་བརྟུལ་ཞུགས་ལ་སྦྱར་བར་མཛད་འདུག་པས་དེ་བཞིན་བགྱི་བ་ལ།",
    "ཅེས་གསུམ་པའི་ལུང་དོན་ཅུང་ཟད་གོ་སླ་བར་འདུག་པས་བཀྲལ་མ་དགོས་སོ།",
    "དེ་ལ་སྐྱེས་པ་ཡིན་ན་ཁྱེད་རང་རྣམས་བདེ་མཆོག་ཏུ་བསྒོམས་ནས།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "ཁྱེད་རང་རྣམས་རྣམ་སྣང་སོགས་རིགས་ལྔར་རིམ་པ་བཞིན་གསལ་བཏབ་སྟེ།"
  ]
}