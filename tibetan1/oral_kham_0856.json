    "མི་དེ་དག་དང་པོར་ཀོ་གྲུར་འདུག་དུས་ཀོ་གྲུ་ལག་ནས་ཤོར་དུ་དོགས་ནས་དམ་པོར་འཇུས།",
    "འཆི་བ་བློ་ལ་སྐྱེས་པ་རང་ཞིག་དགོས་པར་འདུག་གསུངས།",
    "དེའི་ནང་ནས་ཀྱང་རང་ཉིད་འཆི་བ་མི་རྟག་པ་བསམ་པ་གལ་ཆེ།",
    "རང་ཉིད་འདུག་ས་དང་མལ་ས་ལྟ་བུར་སྐུ་གསུང་ཐུགས་རྟེན་མང་པོ་བཞུགས་སུ་བཅུག་ན།",
    "ང་རང་ལྟ་བུ་ཕལ་བ་ལ་མཚོན་ན།",
    "མི་དྲན་དགུ་དྲན་ལྟ་བུར་འདུག་ཀྱང་།",
    "ཤྭ་བ་གཅིག་འགྲངས་ཆེ་བས་འགྲོ་མ་ཤེས་པར་ཉལ་ནས་འདུག་པ་ལ།",
    "གཉེན་པོའི་ཕྱོགས་ཉུང་བར་འདུག་ན་གསུངས།",
    "འཁྲུག་པ་ཆེན་པོའི་སྐབས་སོ་པའམ་བྱ་ར་པ་རྒྱུན་མི་ཆད་པར་འདུག་པ་ལྟར་དུ།",
    "བྱེད་ཀྱིན་འདུག་གསུངས།",
    "རྟོལ་དུས་མེད་པའི་འགྲོན་པོར་འདུག་ན་གསུངས།",
    "རྟོལ་དུས་མེད་པའི་འགྲོན་པོར་གྱུར་འདུག་ཅེས་པ་ཡིན།",
    "དགེ་སློང་ཡིན་ན་ཁ་ཟས་སོགས་ཉམ་ཐག་བྱས་ཏེ་འདུག་དགོས་པས་ཁྱབ་པ་མེད།",
    "བྱ་ཁྱུ་ཡིས་འཚོ་བ་སྟེ་བྱ་ཁྱུ་དང་ཁྱུ་བྱས་ནས་འདུག་པ་ལྟར་དུ།",
    "རི་དྭགས་དམན་མ་ཅན་ཏེ་རི་དྭགས་རྨས་མ་ཅན་དེ་ནི་རང་གཅིག་པུར་འདུག་པ་ལྟར་དུ།",
    "ཞབས་ཞུ་པས་གནས་བརྟན་དེ་ལ་ནངས་ཇ་འདྲེན་གྱིན་འདུག་པ་ལ།",
    "རྗེས་སུ་འགྲོ་ས་སྲུང་བར་དགའ་དགའ་སྤྲོ་སྤྲོའི་ངང་འདུག་ཀྱང་ངན་འགྲོ་མ་གཏོགས་མེད་ཅེས་པ་ཡིན།",
    "སྤྲེའུ་ཡོད་སའི་གནས་དེར་བྱ་གླག་ཡས་མར་དུ་ཤུགས་ཀྱིས་འཕུར་ཏེ་བྱུང་ཙ་ན།",
    "ཚང་བུག་གཏིང་རིང་བརྐོས་ནས་འདུག་པ་ལྟར་དུ།",
    "སྐྱིབས་སུ་སྡོད་ཅེས་པ་ཕག་ཏུ་སྡོད་ཅེས་པའམ་དེ་ལ་བརྟེན་ནས་འདུག་དགོས་ཞེས་པའི་དོན་ཡིན།",
    "༣ ཐང་འདུག་མི་བདེ་ཞེས་པ་ནི།",
    "ཁ་བ་ཉིན་མཚན་བསྟུད་མར་བབས་ཀྱང་སྐྱོན་མི་འདུག་སྟེ།",
    "རང་ཉིད་འདུག་སའི་ཁང་པ་ཡོད་པ་ཡིན།",
    "སྡོམ་པ་དེ་དག་སྲུང་མ་ཐུབ་པས་ཚེ་འདི་ཕྱི་གཉིས་ཀར་སྡིག་སྡུག་གཏམ་ངན་གསུམ་གྱི་རྒྱུ་ལས་ཅི་ཡང་མི་འདུག་ཅེས་པ་ཡིན།",
    "སྤྱོད་པའི་འགྱིང་བག་ཅེས་པ་འགྲོ་སྟངས་འདུག་སྟངས་ལ་ཆེ་ཚུགས་སྟོན་པའི་དོན་ཡིན།",
    "༡ ཨ་ཇོ་རྡོར་ལེགས་ཞེས་པ་ནི།",
    "གསོལ་མཆོད་ཅུང་འཕྱིས་པའི་ཚེ་ཁོ་རང་བསྟེན་མཁན་རྣམས་ལ་གནོད་པ་སྐྱེལ་དུ་ཡོང་སྟེ་ཚོར་ངས་ཤིན་ཏུ་ཆེ་བ་ཡིན།",
    "སྐྱོན་འདུག་ཚད་ལོངས་ནས་ཡོང་གསུངས།",
    "སྐྱོན་འདུག་ཚད་ལོངས་ནས་ཡོང་།",
    "མནའ་མའི་ངའི་བུའི་མནའ་མ་བྱས་ཏེ་མི་འདུག་པར་དོགས་ཏེ།",
    "ཤེས་རབ་ནི་ཤིན་ཏུ་ཆེ་བ་ཞིག་ཡིན་ཞེས་ཞུས་ཙ་ན།",
    "སྐྱོན་མཚང་རང་ལ་ཡོད་དོ་རི་ཁྲོད་པ།",
    "སྟན་ལ་འདུག་ཅེས་པ་སྟེ་དཔེ་གཉིས་ཀྱིས་བསྟན་ཡོད་པ་ཡིན།",
    "སྟན་ལ་འདུག་ནས་མང་ཡུལ་ལྡོན་ཏེ་ཞེས་པ་ཁ་དཔེ་ཞིག་ཡིན།",
    "བུ་བུ་ཟེར་ཏེ་ངུ་བཞིན་འདུག་པ་ལ།",
    "མཇལ་བ་དེ་ལ་རྒྱ་གར་ན་གཏམ་གསར་བ་ཇི་འདྲ་འདུག་ཅེས་དྲིས་པས།",
    "ཕན་སེམས་ཅི་འདུག་ལྟོས་ཤིག་གསུང་ངོ།",
    "ང་རང་བཞིན་གྱིས་གྲུབ་པར་འཛིན་པའི་ང་དེ་དགག་བྱའི་ང་ཡིན།",
    "འདུག་པ་དང་།",
    "སྣུན་ན་བྱེ་ཚང་བྱེ་ཕྲུག་ཅན་ཞིག་འདུག་པས་དེ་ལ་ཚོམ་ནས་འདུག་སྐད།",
    "གཏན་ནས་མེད་པ་དང་རང་བཞིན་གྱིས་མེད་པ་གཉིས་ཀྱི་ཁྱད་པར་ཤེས་དགོས།",
    "བསམ་བཞིན་དུ་རྫུན་མི་སྨྲ་བ་དང་ཞེས་པ་གཞན་ལ་གནོད་པ་སྐྱེད་པ་དང་རང་དོན་བསྒྲུབ་པའི་ཆེད་དུ་རྫུན་མི་སྨྲ་བ་ཞེས་པ་ཡིན།",
    "གཞན་སྤྱོད་ལམ་རྣམ་བཞི་ནི་འགྲོ་འཆག་ཉལ་འདུག་བཞི་ཡིནགྱི་སྡིག་རྐྱེན་དུ་ཅི་མི་འགྲོ་བྱ་ཞེས་པ་དད་ལོག་སྐྱེས་ཏེ་ཉེས་པ་གསོག་པའི་རྟེན་དུ་མི་འགྲོ་བ་བྱ་ཞེས་པ་ཡིན།",
    "ཡག་པོ་འདུག་ཅེས་དཀྲིས་པ་མིན།",
    "དགོས་ཀྱིན་འདུག་དང་པོ་ཕ་མའི་ཁྱིམ་ནས་རབ་ཏུ་བྱུང་བ་དེ་སླ་བར་བྱུང་ལ།",
    "ཉན་ཐོས་དང་རང་སངས་རྒྱུས་ལས་ཀྱང་ཁྱད་པར་དུ་འཕགས་པ་ཡིན་ཏེ།",
    "མཉམ་པར་འདུག་ན་གཞན་དོན་གཙོ་བོར་བྱེད་དགོས་ཞེས་པ་ནི།",
    "ལྕགས་གོང་མེ་ལྕེ་འབར་བ་ཟོས་པ་ལས་ཀྱང་རང་ལ་གནོད་ཚབས་ཆེ་བ་བསྟན་ཡོད།",
    "ཚོད་དུ་འདུག་སྟེ་གསུངས།",
    "རྒྱལ་ཁམས་ཀྱི་ནོར་རྫས་ཐམས་ཅད་དུས་གཅིག་ཏུ་མངོན་ཏུ་སྤུངས་ཀྱང་ཆོག་ཤེས་མི་ཡོང་བའི་ཚོད་དུ་འདུག་ལ།",
    "དར་གྱི་སྟེང་དུ་མེན་བརྩེགས་ནས་གོན་པའི་ཚོད་དུ་འདུག་སྟེ་གསུངས།",
    "བོངས་ཀྱི་སྙོམས་ཙ་ན་ཞེས་པ་གཟུགས་ཀྱི་རིང་ཐུང་ལྟ་བའི་ཚེ་ན་ཞེས་པ་ཡིན།",
    "དེར་བལྟོས་ན་ཕྱུགས་དང་ལུག་འཚོས་ན་བཟང་ཟེར་མི་འདུག་དཔེ་དེ་བཞིན་དུ།",
    "འདུག་ན་གསུངས།",
    "དབེན་པར་ཡང་འདུག་ཚུགས་ན།",
    "ཉན་ཐོས་དགྲ་བཅོམ་པ་དང་རང་རྒྱལ་དགྲ་བཅོམ་པའི་གོ་འཕང་ཙམ་ཐོབ་འདོད་ཀྱི་སེམས་དང་བྲལ་ཅིང་།",
