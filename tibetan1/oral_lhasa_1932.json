    "རྣམ་པར་སྨིན་པའི་འབྲས་བུ་བསྟན་པ་སྟེ།",
    "ཡོན་ཏན་དེ་ལྟ་བུ་ཐོབ་པར་འདོད་པས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཡོན་ཏན་དེ་ལྟ་བུ་ཐོབ་པར་འདོད་པས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དང་སྦྱར་རོ།",
    "དེ་ལྟ་བུ་ཐོབ་པར་འདོད་པས་ཞེས་བྱ་བ་དང་སྦྱར་རོ།",
    "དེ་ལྟ་བུར་འདོད་པས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ས་གཞི་རྡོ་རྗེའི་རང་བཞིན་དུ་མ་གྱུར་ན་སས་མི་ཐེགཅིང་འགས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བུའི་ཡོན་ཏན་ཐོབ་པར་འདོད་པས་ཞེས་བྱ་བ་དང་སྦྱར་རོ།",
    "དེ་ལྟ་བུའི་ཆེ་བའི་བདག་ཉིད་ཐོབ་པར་འདོད་པས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཡོན་ཏན་དེ་ལྟ་བུ་དང་ལྡན་པར་འདོད་པས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དང་སྦྱར་། རོ་།",
    "ད་ནི་ཇི་ལྟར་བརྩོན་པར་བྱ་བ་བསྟན་པའི་སྐབས་དབྱེ་བའི་ཕྱིར།",
    "སྤྱོད་པ་དང་མི་སྤྱོད་པ་རྣམས་དོན་དམ་པར་དམིག་བ་སུ་མེད་པ་བསྟན་ཏོ།",
    "ཇི་ལྟར་སྤྱད་པར་བགྱི་ཞེས་ཞུས་པའི་ལན་དུ་དེ་ལྟར་སྤྱད་པར་བྱའོ་ཞེས་བསྟན་པའི་ཐ་ཚིག་གོ།",
    "ཇི་ལྟར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བའི་གཏན་ཚིགས་བསྟན་ཏོ།",
    "གཟུགས་ཀྱི་རང་བཞིན་དོན་དམ་པར་ཡོད་པར་མ་གྲུབ་པ་ཉིད་སྟོང་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་སྟེ།",
    "སྟོང་པ་ཉིད་ཀྱང་གཟུགས་སོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གཟུགས་དང་སྟོང་པ་ཉིད་དོན་དམ་པར་ཐ་དད་པ་མ་ཡིན་ཏེ།",
    "གཉིས་ཀ་ཡང་དོན་དམ་པར་སྟོང་པའི་རང་བཞིན་དུ་གཅིག་གོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དོན་དམ་པར་དངོས་པོ་ཡོད་པར་མ་གྲུབ་པོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྒྱུ་མ་མཁན་གྱིས་རྟ་དང་གླང་པོ་ཆེ་ལ་སོགས་པ་སྒྱུ་མར་བྱས་པ་རྣམས་རྟ་དང་གླང་པོ་ཆེ་ལ་སོགས་པའི་རང་བཞིན་དུ་ཡོད་པ་མ་ཡིན་ཡང་རྟ་དང་གླང་པོ་ཆེ་ལ་སོགས་པའི་གཟུགས་སུ་སྣང་བ་དང་འདྲའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དོན་དམ་པར་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དོན་དམ་པར་རྗེས་སུ་མི་མཐོང་བ་བསྟན་པའོ།",
    "དམིགས་སུ་མེད་པའི་སྒོ་ནས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་ན་ཤེས་རབ་ཁྱད་པར་ཅན་ཐོབ་པར་འགྱུར་བའི་ཕན་ཡོན་བསྟན་པ་སྟེ།",
    "ཁྱད་པར་དུ་འཕགས་པ་བསྟན་པའི་ཕྱིར་ཤ་ར་དྭ་ཏིའི་བུ་དེ་ཇི་སྙམ་དུ་སེམས་ཞེས་བྱ་བ་ལ་སོགས་པ་དོན་དམ་པར་བྱེ་བྲག་མེད་དུ་ཟིན་ཀྱང་།",
    "ཕྱིར་མི་ལྡོག་པའི་ས་ཐོབ་པར་གནས་པ་དང་།",
    "སྦྱིན་པའི་འབྲས་བུ་ཚེ་རབས་ཕྱི་མ་ལ་རྣམ་པར་སྨིན་པ་ཆེན་པོར་འགྱུར་རོ་ཞེས་བསྟན་པའོ།",
    "ད་ནི་བརྩོན་པར་བྱེད་པ་རྣམས་ཀྱི་མཚན་ཉིད་བསྟན་།"
  ]
}