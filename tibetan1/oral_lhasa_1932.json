    "བདུད་ཀྱི་ལས་ཐམས་ཅད་ལས་ཡང་དག་པར་འདས་པ་ཞེས་བྱ་བས་ནི་ཅིས་ཀྱང་མི་བརྫི་བའི་མཐུ་དང་ལྡན་པ་བསྟན་ཏེ།",
    "ཕྱིའི་མཚན་ཉིད་རྣམ་པར་དབྱེ་ཞིང་།",
    "དེ་ལྟར་སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་དང་ལྡན་ཞིང་སྤོབས་པ་ཕུན་སུམ་ཚོགས་པ་།",
    "གཟུགས་བརྙན་ལྟ་བུར་ཁོང་དུ་ཆུད་པ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "སྤྱོད་པའི་ཤུགས་ཀྱིས་བཙལ་ཞིང་འབད་མི་དགོས་པར་ལྷུན་གྱིས་གྲུབ་པ་ཉིད་དུ་འབྱུང་སྟེ།",
    "སྤྱོད་པ་དེ་དག་ལ་ཡང་དངོས་པོ་དང་མཚན་མར་མི་འཛིན་ཅིང་མ་ཆགས་པར་སྤྱོད་པ་ནི།",
    "དཔེར་ན་སྒྱུ་མ་མཁན་གྱིས་རྟ་དང་གླང་པོ་ཆེ་ལ་སོགས་པའི་དངོས་པོ་སྣ་ཚོགས་བྱས་པ་རྣམས་ཁ་དོག་དང་དབྱིབས་ལ་སོགས་པའི་ཁྱད་པར་སྣ་ཚོགས་སུ་སྣང་ཡང་ཡང་དག་པར་ཡོད་པ་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "སྨིག་རྒྱུ་ལ་ཆུའི་དངོས་པོ་མེད་པར་ཡང་དེ་ལ་དམིགས་ནས་ཆུའི་འདུ་ཤེས་སྐྱེ་ཞིང་།",
    "བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་པ་རྣམ་པ་སྣ་ཚོགས་པར་སྣང་ཡང་དངོས་པོའི་རང་བཞིན་དུ་ཡོང་པ་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "སྒྲར་རྟོག་པའི་རྣམ་པར་ཤེས་པ་འཁྲུལ་པ་ལས།",
    "ཡུལ་གྱི་ཁྱད་པར་དང་སྤྲིན་དང་ཉེ་བའི་རྒྱུས།",
    "འགྲོ་བ་དང་འོང་བ་ལ་སོགས་པའི་བྱ་བ་རྣམས་ཇི་ལྟར་ཡོད་པར་འགྱུར་སྙམ་དུ་སེམས་པ་ལ།",
    "རྣམ་པར་མི་རྟོག་པ་ལྷུན་གྱི་ས་གྲུབ་པ་དང་།",
    "སྤྱོད་པ་ལ་འཇུག་པ་ཁོང་དུ་ཆུད་པར་བྱ་བ་ལ་མཁས་པའི་ཡོན་ཏན་བསྟན་པ་སྟེ།",
    "སྤྱོད་པ་རྒྱ་ཆེན་པོ་ཁོང་དུ་ཆུད་པར་བྱ་བ་ལ་མཁས་པར་གྱུར་པ་དགགོ་ཞེས་བསྟན་པའོ།",
    "གཞན་རྟོགས་པར་བྱེད་དུ་འཇུག་པ་ལ་ཡང་མཁས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མཐར་འཛིན་པར་ལྟ་བ་དང་།",
    "ལོག་པར་ལྟ་བ་དང་ལྟ་བ་མཆོག་ཏུ་འཛིན་པ་དང་།",
    "ཀུན་རྫོབ་དང་དོན་དམ་པའི་བདེན་པ་རྣམས་བདག་དང་གཞན་གྱིས་རྟོགས་པར་བྱ་བའི་ཐབས་ལ་མཁས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དོན་དམ་པར་དངོས་པོ་མི་ལྟ་ཡང་།",
    "བདག་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་ཁོང་དུ་ཆུད་པར་བྱ་བ་ལ་མཁས་པ་ཞེས་བྱ་བས་ནི་ཡེ་ཤེས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པའི་རྒྱུས།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་དེ་དག་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རྟོགས་པར་བྱ་བ་ལ་མཁས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ནི་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱས་པའི་འབྲས་བུ་དང་ལྡན་པ་བསྟན་པ་སྟེ།",
    "ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་བཞེད་པ་རྣམས་ཡུན་རིང་དུ་བཞུགས་པར་བྱ་བའི་ཕྱིར་གསོལ་བ་འདེབས་པ་ལ་མཁས་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དཀོན་ཞིང་རིན་ཆེ་བས་མཆོད་ཅིང་བཀུར་སྟི་བྱ་བར་འོས་པ་ཡིན་པར་བསྟན་པ་དང་།",
    "སེང་གེ་རྣམ་པར་རོལ་པའི་ཏིང་ངེ་འཛིན་ཏེ།",
    "ཏིང་ངེ་འཛིན་གྱི་རྒྱལ་པོ་ཞེས་བྱ་བ་ལ་མཉམ་པར་གཞག་གོ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཏིང་ངེ་འཛིན་གྱི་རྒྱལ་པོའི་ཆོ་འཕྲུལ་བསྟན་ཏེ།",
    "ཏིང་ངེ་འཛིན་གྱི་རྒྱལ་པོ་ཞེས་བྱ་བ་ཡང་ཏིང་ངེ་འཛིན་འདི་ལ་མཉམ་པར་གཞག་ནས།",
    "འདུ་བར་འགྱུར་བ་ཞེས་གསུངས་ཏེ།",
    "དེ་ལ་འདུ་བ་དང་ཁོང་དུ་ཆུད་པ་ཞེས་བྱ་བས་ཏིང་ངེ་འཛིན་དེ་དག་ཐམས་ཅད་རྣམ་པར་མི་རྟོག་ཅིང་མི་གཡོ་ལ།",
    "དེ་ལ་དེ་ནས་བཅོམ་ལྡན་འདས་དགོངས་ཤིང་ཡང་དག་པར་མཁྱེན་པས་ཏིང་ངེ་འཛིན་དེ་ལས་བཞེངས་ཏེ།",
    "དེ་ལ་དེ་ནས་བཅོམ་ལྡན་འདས་དགོངས་ཤིང་ཡང་དག་པར་མཁྱེན་པས་ཞེས་བྱ་བས་ནི།",
    "དེ་ལྟར་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་གཞག་པ་ལས།",
    "འོད་ཟེར་ཁ་དོག་དྲུག་པོ་དེ་དག་ཕྱོགས་བཅུར་རྣམ་པར་འཕྲོས་ན་དྲུག་ཅུར་འགྱུར་རོ།",
    "དོན་དུ་བསྒྲུབ་པ་མང་བའི་ཕྱིར་འོད་ཟེར་ཁ་དོག་སྣ་གཅིག་ལས་ཀྱང་དེ་སྙེད་དུ་འཕྲོས་པར་རིག་པར་བྱའོ།",
    "ཞབས་གཉིས་ལ་སོགས་པ་སྐུའི་ཡན་ལག་དང་ཉིང་ལག་ཕལ་ཆེར་གཉིས་གཉིས་ཡོད་པ་བརྩན་པར་བྱས་ནས་ལན་གཉིས་སུ་བཟླས་ཏེ་གསུངས་པར་རིག་པར་བྱའོ།",
    "དེ་ལ་འོད་ཟེར་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་དྲུག་ཅུ་པོ་དེ་དག་ཐམས་ཅད་ཀྱིས་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་འདི་ཐམས་ཅད་སྣང་བར་བྱས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་འཇིག་རྟེན་གྱི་ཁམས་རྣམས་ཀུན་དུ་སྣང་བར་བྱ་བའི་དོན་སྒྲུབ་པ་བསྟན་ཏོ།",
    "གཙང་སྦྲ་ཆེ་བ་དང་།",
    "འདུ་ཤེས་མེད་པའི་སྲིད་པར་སྐྱེས་པ་དང་།",
    "ལྐུགས་པ་ལ་སོགས་པར་གྱུར་པ་དང་།",
    "ལོག་པར་ལྟ་བར་གྱུར་པ་དང་།",
    "དེའི་ཚེ་བཅོམ་ལྡན་འདས་གདན་སེང་གེའི་ཁྲི་དེ་ཉིད་ལ་བཞུགས་པས་འདི་ལྟ་སྟེ།",
    "གཙང་མའི་གནས་དང་བཅས་པ་ཟིལ་གྱིས་གནོན་པར་ཞུགས་ཤིང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་འཇིག་རྟེན་ལྷ་དང་བཅས་པ་རྣམས་ཟིལ་གྱིས་མནན་ཏེ་བཞུགས་སོ་ཞེས་བསྟན་ཏེ།",
    "དཔལ་གྱིས་ནི་མི་རྣམས་ཟིལ་གྱིས་མནན་ཏེ་བཞུགས་སོ།",
    "དཔལ་དང་ལྡན་པས་ལྷང་ངེས་བཞུགས་སོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "ལྷ་ཐམས་ཅད་ཀྱིས་དེ་བཞིན་གཤེགས་པའི་སྐུ་བལྟ་བས་ཆོག་མི་ཤེས་པ་མཐོང་ནས་འདི་སྙམ་དུ་སེམས་པར་གྱུར་ཏེ།",
    "སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་གྱི་ཁམས་ཙམ་དུ་གནས་པར་གྱུར་པ་དང་།",
