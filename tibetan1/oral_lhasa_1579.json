    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱང་རྟག་པར་དགོངས་པ་དང་།",
    "བྱིན་གྱིས་རློབ་ཅིང་བཞུགས་སོ།",
    "ཕྱོགས་བཞི་ཀུན་ན་ཡང་དེ་བཞིན་གཤེགས་པའི་གཟུགས་བརྙན་གནས་པར་འགྱུར་རོ།",
    "སྐུ་གཟུགས་དང་མཆོད་རྟེན་དེ་འོག་མིན་གྱི་གནས་ཀྱི་ལྷས་ཀྱང་ཡོངས་སུ་བསྐྱང་བ་དང་།",
    "ལག་ན་རྡོ་རྗེ་དེས་ན་མཐུ་འདི་ནི་༡༡ཡོན་ཏན་གྱི་ཁྱད་པར་འདི་ལྟ་བུར་བྱིན་གྱི་༡༥རླབས་༡་ཀྱིས་བྱིན་གྱིས་བརླབས་པ་ཡིན་ནོ།",
    "གང་ན་རིང་བསྲེལ་གྱི་ཕྱག་རྒྱའི་གཟུངས་འདི་སྟོན་པར་བྱེད་དམ།",
    "གཟུགས་བརྙན་གྱི་ནང་དུ་འཇོག་པར་བྱེད་པ་དེར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱང་གཅིག་ཏུ་རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་རྗེས་སུ་འབྲང་ཞིང་བཞུགས་པར་འགྱུར་རོ།",
    "ཐམས་ཅད་དུ་དེ་བཞིན་གཤེགས་པའི་བྱིན་གྱི་༥རླབས་༦ཀྱིས་བྱིན་གྱིས་བརླབས་པར་འགྱུར་རོ།",
    "བཀྲ་ཤིས་དང་བཅས་པར་གྱུར་ཏོ།",
    "ཞུ་ཆེན་གྱི་ལོཙྪ་བ་བནྡེ་གཙང་༥དེ་བེན་དྲ་རཀྵི་ཏས་བསྒྱུར་ཅིང་ཞུས་ཏེ་གཏན་ལ་ཕབ་པཚོ་༤༥ བསྡུར་མཆན།",
    "གཡུང་ལི་པེ་ཅོ་པར།",
    "རྒྱལ་པོ་ཆེན་པོ་བཞི་ལ་སོགས་པ་གཙང་རིས་ཀྱི་མགོན་པོ་རྣམས་དང་ཐབས་ཅིག་༡༧ཏུ་བཞུགས་སོ།",
    "མིང་ཉན་པར་བྱེད་ན།",
    "སྒྲིབ་པ་ཐམས་ཅད་དག་པར་འགྱུར་རོ།",
    "བཅུ་གཅིག་ཀུན་དུ་འོད་ཀྱི་ས་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་གདོན་མི་ཟ་བར་རྒྱལ་རིགས་ཤིང་སཱ་༡༦ལ་ཆེན་པོ་ལྟ་བུར་སྐྱེས་ནས་རྡོ་རྗེ་འཛིན་པའི་ས་ཐོབ་པར་འགྱུར་རོ།",
    "འཇིམ་པའི་གོང་བུ་ལ་ལན་ཉི་ཤུ་རྩ་གཅིག་བཟླས་བརྗོད་བྱས་ཏེ།",
    "མཆོད་རྟེན་གཅིག་བཏབ་ན་བྱེ་བ་བཏབ་པར་འགྱུར་རོ།",
    "བརྒྱ་བཏབ་པའི་གྲངས་དང་ཕན་ཡོན་ནི་འཕགས་པ་ཉན་ཐོས་ཀྱི་དགྲ་བཅོམ་པ་རྣམས་ཀྱིས་ཀྱང་བརྗོད་པར་མི་ནུས་སོ།",
    "ཁྲི་བཏབ་པའི་གྲངས་དང་ཕན་ཡོན་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་ཀྱང་བརྗོད་པར་མི་ནུས་སོ།",
    "འབུམ་བཏབ་པའི་གྲངས་དང་ཕན་ཡོན་ནི་ཕྱོགས་བཅུ་དུས་གསུམ་གྱི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་ཀྱང་བརྗོད་པར་མི་ནུས་སོ།",
    "སྔོན་གྱི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་མ་གཏོགས་སོ།",
    "སའི་ཕྱོགས་སུ་གཏོར་བས་སའི་ཕྱོགས་དེ་ཉིད་ཀྱང་དེ་བཞིན་གཤེགས་པའི་བཞུགས་གནས་དཔག་ཏུ་མེད་པར་འགྱུར།",
    "དེ་ལྟར་ས་གཞི་༩དེ་བཞིན་གཤེགས་པའི་བཞུགས་གནས་སུ་བྱིན་གྱིས་བརླབས་༡་ཏེ།",
    "ས་ཕྱོགས་དེ་ཡང་ཤིན་ཏུ་བཀྲ་ཤིས་ཤིང་བྱིན་ཆགས་པར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་རྣམ་པར་དག་པའི་རྒྱུར་འགྱུར་རོ།",
    "བག་ཆགས་ཐམས་ཅད་མ་ལུས་པར་བྱང་ཞིང་བཅོམ་པར་འགྱུར་རོ།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་༢འོད་ཟེར་ཆེན་པོ་དེས་སྤོས་ཆུ་དེ་ཁྱབ་པར་གྱུར་ནས།",
    "དེ་ནས་འཇིམ་པ་དེ་ཉིད་དེ་བཞིན་གཤེགས་པའི་སྐུ་བསམ་གྱིས་མི་ཁྱབ་པར་བྱིན་གྱིས་བརླབ་པ་ནི།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་བསམ་གྱིས་མི་ཁྱབ་པའི་རྒྱུ་རྐྱེན་དང་ལྡན་པར་འགྱུར་རོ།",
    "འབི་འབེ་ཉིད་ལས་ཡེ་ཤེས་ཀྱི་འོད་ཟེར་གྱི་སྤྲིན་གྱིས་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་མཐའ་ཡས་པར་འཕྲོས་ཤིང་ཁྱབ་སྟེ།",
    "འགྲོ་བ་མང་པོའི་དོན་བྱེད་པར་འགྱུར་རོ།",
    "འོད་ཟེར་ཀྱི་སྤྲིན་ཕུང་དེ་དག་སླར་འབི་འབིའི་ནང་དུ་འདུས་པས་ཀྱང་དེ་ཉིད་ཡེ་ཤེས་རིན་པོ་ཚའི་རང་བཞིན་ཤེལ་སྒང་ཧཱུཾ་རལྟར་ཡོངས་སུ་དག་པར་འགྱུར་རོ།",
    "མུ་དྲའི་ཕྱག་རྒྱར་བྱས་པའམཡི་གེར་བྲིས་པའམ།",
    "དེ་བཞིན་གཤེགས་པའི་ཐུགས་ཡེ་ཤེས་དང་ལྡན་པར་འགྱུར་རོ།",
    "ནང་དུ་སྩོལ་བའི་ཚེ་རིག་༦པའི་སྔགས་འདི་བརྗོད་པར་བྱའོ།",
    "ཨོ་བཛྲ་གརྦྷེ་སྭཱ་ཧཱ་ཞེས་བྱ་བ་བཟླས་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་ཡེ་ཤེས་དེའི་ནང་དུ་འདུས་ཤིང་ཞུགས་པར་འགྱུར་རོ།",
    "འགྲོ་བའི་དོན་ཡིད་བཞིན་དུ་མཛད་པར་འགྱུར་རོ།",
    "དབུས་དང་ཕྱོགས་བཞིར་མཆོད་རྟེན་བཞུགས་པའི་ས་ཀུན་དུ་གུར་གུམ་དང་།་",
    "མཆོད་རྟེན་གཞག་པའི་ས་གཞི་ཐམས་ཅད་པདྨ་འདབ་མ་བརྒྱད་པར་བྲི་བར་བྱའོ།",
    "ཨོཾ་སུ་པྲ་ཏིཥྛ་སྟུ་༨བེ་སྭཱ་ཧཱ་ཞེས་ལན་གསུམ་བཟླས་ཏེ་མཆོད་རྟེན་བཞག་ན་བདག་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པར་སྤྱོད་པར་འགྱུར་རོ།",
    "ཨོཾ་བཛྲ་པདྨཱ་༡་ས་ཡ་ཡེ་སྭཱ་ཧཱ་ཞེས་ལན་གསུམ་དུ་༡བཟླས་ལ་རྡོ་རྗེ་དང་པདྨའི་གདན་ལ་བཞུགས་སུ་གསོལ་ཞེས་བྱས་ལ།",
    "གང་བྲིས་པའི་དབུས་རྣམས་སུ་ཡི་གེ་ཨ་དཀར་པོ་གནས་པ་ལས་རིག་༡་པ་ཆེན་པོའི་༡་སྔགས་འདི་བརྗོད་པར་བྱ་སྟེ།",
    "ཨོཾ་ཨ་ཙནྡེ་ངམཎྜལ་ཧཱུྃ་ཕཊ་ཅེས་གྲངས་ཇི་ཙམ་རན་༡༥པར་བཟླས་ན།",
    "སླར་སྐུའི་ནང་དུ་ཐིམ་པར་འགྱུར་ཏེ།",
    "ཆར་གྱི་རྒྱུན་བཞིན་དུ་འབབ་པར་འགྱུར་རོ།",
    "འཁོར་ཕུན་སུམ་ཚོགས་པ་ཚུལ་བཞིན་དུ་དགོངས་ཏེ་དམིགས་པར་བྱའོ།",
    "དེ་དག་ལས་ཡེ་ཤེས་ཀྱི་ཕྱིའོད་ཟེར་སྣ་ཚོགས་འབྱམ་ཀླས་པར་རིགས་ལྔ་ཕྱོགས་བཅུར་༧འཕྲོས་པ་ལས་དེ་བཞིན་གཤེགས་པའི་སྐུའི་སྤྲིན་གྱིས་ནམ་མཁའི་མཐས་རི་ཀླས་ཤིང་།",
    "ཐུགས་རྡོ་རྗེ་ཉིད་དུ་གྱུར་པར་དམིགས་ལ།",
