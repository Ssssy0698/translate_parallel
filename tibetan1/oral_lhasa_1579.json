    "མཆོད་རྟེན་སྐུ་གདུང་དང་བཅས་པའི་དྲུང་དུ་བཟླས་བརྗོད་འབའ་ཞིག་༡ཁྲི་བྱས་ནས་ཚེས་བཅྭ་༢ལྔའི་ཟླ་བ་ཉ་ལ་ཤིན་ཏུ་ཁྲུས་བྱས་ཏེ།",
    "བསམ་པ་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།་།",
    "གང་འདོད་པ་དེ་རྙེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་མཚམས་མེད་པ་ལྔའི་༥ལས་བྱས་པ་༤ཞིག་ཡིན་ན་ཡང་དེས་དུས་གསུམ་དུ་བསྒྲུབས་ན་གདོན་མི་ཟ་༥༥བར་མཐོང་བར་འགྱུར་རོ།",
    "ཡིད་གཉིས་བསྐྱེད་པར་མི་བྱའོ།",
    "ནང་པར་ལངས་ཏེ་བཟླས་བརྗོད་བརྒྱ་རྩ་བརྒྱད་བྱས་ན་དོན་ཐམས་ཅད་འགྲུབ་༧པར་འགྱུར་རོ།",
    "ཆོམ་རྐུན་གྱིས་འཕྲོག་པར་མི་འགྱུར་ཏེ།",
    "དགྲས་འཇིགས་པར་མི་འགྱུར།་",
    "ཞག་བཞི་པས་ལུས་ལ་ཚུགས་པར་མི་འགྱུར་རོ།",
    "ལུས་ལ་བྱད་ཀྱིས་ཚུགས་པར་མི་འགྱུར་རོ།",
    "འཇིགས་པ་ཐམས་ཅད་རབ་ཏུ་འཇོམས་པར་བྱེད་པ་ཡིན།",
    "ཡོན་ཏན་ཐམས་ཅད་གྲུབ་པར་བྱེད་པ་ཡིན།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ཡིན།",
    "དེ་བཞིན་གཤེགས་པའི་དེ་ཁོ་ན་ཉིད་གྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "ལྷ་ཁང་དུ་ཞུགས་༢ཏེ་བཟླས་བརྗོད་བྱས་ན་ལྷ་ཐམས་ཅད་དེས་ཅི་བསྒོ་བ་བཞིན་བྱེད་པར་འགྱུར་རོ།",
    "ལག་ན་རྡོ་རྗེའི་མདུན་དུ་བཟླས་བརྗོད་བྱས་ན་མཆོག་ཐམས་ཅད་སྟེར་ཅིང་མཐོང་བར་ཡང་འགྱུར་རོ།",
    "ཅི་སྨྲས་པ་དེ་སྦྱིན་པར་བྱེད་དོ།",
    "སེར་བ་ཐམས་ཅད་བཀག་༦པར་འགྱུར་རོ།",
    "ཆར་མི་འབབ་པའི་ཚེ་ཀླུའི་རི་རི་གཟུགས་བྱས་ཏེ།",
    "ལུས་ནི་ལི་ཁྲིས་བྱུག་པར་བྱའོ།",
    "བུམ་པ་གང་བ་བཞི་གཞག་པར་བྱའོ།་།",
    "པོག་པོར་བཞི་གཞག་༡་པར་བྱའོ།",
    "བུམ་པ་བཞི་གཞག་པར་བྱ་སྟེ།",
    "ཚོན་སྣ་ལྔའི་བ་དན་གདགས་པར་བྱའོ།",
    "ཏུ་རུཥྐ་ཞུབསྲེག་པར་བྱའོ།",
    "འབྲས་བུ་དང་མེ་ཏོག་གཞག་༡༩པར་བྱའོ།",
    "སྟོང་རྩ་བརྒྱད་ཚང་བར་བཟླས་ན་དེ་ནས་ཀླུ་རྣམས་ཆར་གྱི་རྒྱུན་འབེབས་༢༢པར་བྱེད་དོ།",
    "ཀླུའི་མཚེའུར་གཏོར་ན་ཆར་གྱི་རྒྱུན་འབེབས་པར་བྱེད་དོ།",
    "སེར་བ་ཐམས་ཅད་བཅིངས་པར་འགྱུར་རོ།",
    "ཡུངས་ཀུར་སྙེལ་བརྒྱ་རྩ་བརྒྱད་བཟླས་བརྗོད་བྱས་ཏེ་ལོག་འདྲེན་གྱི་ཀླད་པར་བཏབ་ན་ལོག་འདྲེན་ཐམས་ཅད་བཅིངས་པར་འགྱུར་རོ།",
    "འོ་མས་བཀྲུས་ན་ཕྱིར་སོས་པར་འགྱུར་རོ།",
    "ལས་གང་དང་གང་ཁོ་ན་བྱ་བའི་ལས་དེ་དང་དེ་དག་འགྲུབ་པར་འགྱུར་རོ།",
    "གཙང་མས་གོས་གཙང་མ་བགོ་བར་བྱ་སྟེ།",
    "བཟླས་བརྗོད་འབུམ་བྱས་ན་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མཐོང་བར་འགྱུར་རོ།",
    "སུམ་འབུམ་བྱས་ན་དཀྱིལ་འཁོར་ཐམས་ཅད་དུ་ཞུགས་པར་འགྱུར་རོ།",
    "གསང་སྔགས་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "བཞི་འབུམ་བྱས་ན་རིག་འཛིན་ཐམས་ཅད་ཀྱི་འཁོར་ལོས་སྒྱུར་བར་འགྱུར་རོ།",
    "ལྔ་འབུམ་བྱས་ན་ལྷ་མ་ཡིན་གྱི་སྒོ་ཐམས་ཅད་འབྱེད་པར་འགྱུར་རོ།",
    "ཀླུའི་གནས་ཐམས་ཅད་འབྱེད་པར་འགྱུར་རོ།",
    "དྲུག་འབུམ་བྱས་ན་གཏེར་ཐམས་ཅད་འབར་བར་འགྱུར་རོ།",
    "བཟླས་བརྗོད་བདུན་འབུམ་བྱས་ན་ཚེ་རབས་ཐམས་ཅད་དྲན་པར་འགྱུར་རོ།",
    "བཟླས་བརྗོད་བརྒྱད་འབུམ་བྱས་ན་རིན་ཆེན་ཕྱག་རྒྱའི་ཏིང་ངེ་འཛིན་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་དང་ཕྲད་པར་འགྱུར་༦ཏེ།",
    "དེ་ལ་སོགས་པ་གོང་ནས་གོང་དུ་ཡོན་ཏན་གྱི་ཁྱད་པར་ཐོབ་པར་འགྱུར་རོ།",
    "མཚམས་མེད་པ་ལྔ་བྱས་པའམ།",
    "མནར་༩༥༥མེད་པར་གཞོལ་བ་ཡང་རུང་དེ་དག་ཐམས་ཅད་ཀྱིས་ཅིབཟླས་བརྗོད་འབུམ་བྱས་ན་ལས་ཀྱི་སྒྲིབ་པ་ཐམས་ཅད་བྱང་བར་འགྱུར་རོ།",
    "ཕྱིར་མི་ལྡོག་པར་འགྱུར།",
    "སྐྱེ་བ་དྲན་པར་འགྱུར།་",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་༤ནོདགོངས་པར་འགྱུར།",
    "མིག་རྣམ་པར་དག་པ་དང་།",
    "རྣ་བ་རྣམ་པར་དག་པ་དང་།"
