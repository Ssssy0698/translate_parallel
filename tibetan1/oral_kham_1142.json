    "མ་ཟིན་པའི་སྒྲ་རྣམས་ཀྱང་རང་འཁྲོལ་དུ་ཆེམ་ཆེམ།",
    "སྔགས་འཆང་རྣམས་དྲག་པོའི་ལས་དང་མཐུན་པའི་ཆ་བྱད་དང་འདུག་སྟངས་ཀྱིས།",
    "ས་ལམ་རིམ་བགྲོད་ཀྱི་འབྲས་བུ་དང་ཕྲིན་ལས་རྣམས་བརྗོད་བྱར་བྱས་པའི་ཀུན་འཁོར་ཞིག་ཉེ་དུས་བྲིས་འདུག་པ་དེ་ཉིད་དེབ་ཀྱི་མཛེས་རྒྱན་ཙམ་དུ་དམིགས་ཏེ་མཇུག་ཏུ་བཀོད་པ་ལས་གཞན་པའི་ཡས་མས་ཀྱི་འབྲེལ་བ་ཡོད་ལ་མེད་གང་ཡང་འབྲི་འགོད་མ་བྱས་པར་ཡིག་ཚོགས་ཉུང་ཐབས་བྱས་ཡོད།",
    "ས་ཞེས་ལུང་བསྟན་གྱི་ཡི་གེ་གསལ་བ་ཡོད་འདུག་གཞན་ཡང་དཔལ་ལྡན་དུས་གསུམ་མཁྱེན་པའི་ཞལ་ནས་མཚུར་ཕུ་འདིར་ཞྭ་ནག་ཅན་གསུམ་འོང་ཞེས་བཀའ་བསྩལ་པའི་ཞྭ་ནག་ཅན་གསུམ་ནི།",
    "གསུང་གཅིག་ཐོས་པས་ལྷ་མིའི་སྐྱེ་བ་འབུམ་ཐོབ་ཅེས་གྲུབ་ཆེན་ཀརྨ་པཀྴིས་ཞལ་གྱིས་བཞེས་པ་སོགས་རྒྱལ་བ་ན་རིམ་ཐམས་ཅད་ཀྱི་གསུངས་གསང་མང་དུ་ཡོད་འདུག་ཀྱང་འདིར་དེ་ཙམ་དུ་བསྡུའོ།",
    "ཁྱེད་རང་གང་འདོད་གསུངས་ཏེ་དབུ་སེམས་སོགས་གཏམ་རྙིང་ལྟར་འདི་འདོད་ཞུས་པ་ན།",
    "རིམ་འགྲོ་པས་རྒྱལ་བའི་ཞབས་ཕྱི་ཡོངས་སུ་གྲུབ་ནས་ག་ནག་རྡ་རསནཀུང་དཔོན་སློབ་གཉིས་ཀའི་མཛད་པ་བསྡུ་ཚར་བ་དེ་འདྲའི་གཏམ་གསར་སར་སྙན་བརྒྱུད་དུ་འཛིན་པ་གལ་མི་ཆེ་བའི་ལས་སུ་འདུག་གོ།",
    "རྗེ་སམི་བསྐྱོད་རྡོ་རྗེའི་གསུང་ལྐོག་གྱུར་ཐམས་ཅད་གསལ་བར་བསྟན་པའི་ཟུར་པ་ཞིག་མཆིས་པ་ལ་ཞིབ་པ་འདུག་དགུང་ལོ་ང་གཅིག་པ་གངས་ནནགསར་ཆགདང་རིས་སལ་ཡངས་ཅན་གྱི་གཙུག་ལག་ཁང་བཞེངས་པར་མཛད་པ་སོགས་སསྐུ་གསུང་ཐུགས་ཀྱི་རྟེན་བཞེངས་པའང་བགྲང་ལས་འདས།",
    "ད་དུང་གཞན་འགའ་ཞིག་འདུག་ཀྱང་འདིར་མ་བྲིས་རྒྱུདེ་ལྟར་རྗེ་འདིས་བསྟན་འགྲོའི་དོན་བསམ་གྱིས་མི་ཁྱབ་པ་མཛད་དེ།",
    "དགུང་ལོ་བཅོ་བརྒྱད་པར་གཤེགས་འདུག།",
    "རྗེ་ཉིད་ལ་ཞུ་བའི་ཞམ་རིང་ཚུལ་མཐུན་ཡོད་ན་ཡབ་སྲས་དེ་དག་ལ་ཁྱད་པར་དབྱེར་མེད་པའི་བཀའ་བསྩལ་ལོག་ལྟའི་སྨག་རུམ་མ་ལུས་དཔྱིས་འབྱིན་པ་ཡང་དག་པའི་ལམ་གསལ་བ་ཞིག་གནང་རྒྱུར་འདུག་པ་ལ་དེ་ལྟར་མ་བྱུང་ཞིང་།",
    "གསུངས་པ་རྣམས་ལུང་བསྟན་ལྟ་བུར་འབྱུང་ཉེ་བ་འདུག་དངོས་སུ་རྟགས་ཀྱི་མཚན་མས་ཀྱང་གྲུབ་སྟེ།",
    "མཉན་ཡོད་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "ཁྱིམ་བདག་དེ་ཅང་མི་སྨྲ་བར་འདུག་པ་དང་།",
    "ཤེས་ལྡན་དག་ཅིའི་ཕྱིར་ལག་པ་ལ་འགྲམ་པ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག།",
    "ཤེས་ལྡང་དག་གལ་ཏེ་ཁྱེད་ཅག་ཡིད་མི་ཆེས་ན་ཚུར་ཤོག་སྲང་དུ་འདོང་དང་རང་ཉིད་ཀྱིས་མཐོང་བར་འགྱུར་རོ།",
    "ཆུང་མ་དང་རྩ་ལག་དང་བཅས་པ་བཙོན་རར་བཅུག་སྟེ་གསད་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ལྟ་བུའི་གནས་ཡོད་དོ་ཞེས་ཟེར་ཞིང་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "དེ་དག་དེ་ལྟར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་ན་ཉེ་དགའས་སྨྲས་པ།",
    "འདི་ལྟར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག།",
    "ལྷོ་ནས་སྐྱེས་པ་གཉིས་ཤིག་འདུག་སྟེ།",
    "ཚེ་དང་ལྡན་པ་པི་ལིན་དའི་བུ་གྲུ་དང་ཉེ་བ་ན་འདུག་པ་མཐོང་ངོ།",
    "ཁ་ཅིག་ནི་བེ་རོ་ཙ་ནས་མཛད་པར་འདོད།",
    "ཤེས་ཀྱང་རང་གཞན་ཕན་མི་ཐོགས།",
    "སྡོད་སར་འདུག་ལུགས་ཚུགས་ཐུབ་ཅིང་།",
    "དཔྱད་ལྔའི་ལུམས་ལ་བདུད་རྩི་ལྔ་ལུམས་དང་རང་བྱུང་ཆུ་ཚན་གྱི་ལུམས་ལྟ་བུ་ཆུ་ལུམས་དང་།",
    "རོ་ཙ་ནི་ཁམས་ལ་རག་ལས།",
    "རྟེན་བླ་དང་དེ་བརྟེན་པའི་ཚེ་ཡང་རང་མལ་དུ་གནས་ལ།",
    "ཟེར་བའང་འདུག་ཤུ་དག་གླ་བས་ཡིག་རྩ་མནན",
    "རྒྱ་གར་མ་བྷ་ཏ་དྷི་ཟེར་བའང་འདུག་སུ་ཐ་རྦད་རྦད",
    "གཞུང་བཞིན་སྤྱོད་དང་བསླུས་ན་ང་རང་ཤེས།",
    "སློབ་དཔོན་གསང་ཞིང་རང་ཆེ་འབྱིན་པ་དང་།",
    "སློབ་དཔོན་འདི་ཡིན་གསང་ཞིང་རང་མཁས་འདོད་ཀྱི་ཚེ་བ་འབྱིན་པ་དང་།",
    "འདུག་ན་བརླག་པར་གདོན་མི་ཟ།",
    "གནས་གསུམ་འབྲུ་གསུམ་མཚན་དང་རང་ཐུགས་ལས།",
    "འོད་འཕྲོས་རང་རང་གནས་ནས་སྤྱན་དྲངས་གྱུར།",
    "གངས་ཅན་མིག་གཅིག་བེ་རོ་ཙ་ནའི་ཞབས།",
    "བློ་བཟང་རང་ལུགས་སྨྲ་བའི་སེང་གེ་ལ།",
    "བརྩེགས་པ་ཉུང་ན་ཕྱིར་བསྲིངས་ཏེ་ཆ་སྙོམས་ཐིག་ཁ་སྐོང་བ་སོགས་རང་རང་ལུས་འགྱུར་ཅི་ཡོད་མཛེས་པར་བྱ་ལ།",
    "ཀློག་དུས་གཟུགས་གཅིག་ལ་སྐབས་ཀྱི་དབྱེ་བ་ཤེས་དགོས་པ་ཨུ་དང་ཌ།",
    "གཟུངས་འབུལ་གྱི་ལག་ལེན་དུ་པདྨ་སྤུངས་པ་གནང་བས་དོན་གཉིས་ཀ་འགལ་བ་མི་འདུག་རུང་།",
    "དེའི་ཕྱོགས་བཞིར་རང་རང་རིགས་བཞིའི་ཕྱག་རྒྱའང་འདྲི་བར་བཤད།",
    "བང་རིམ་བཞི་བྲེ་དང་བགམ་ནས་ས་འཛིན་བར་རྣམས་གྲུ་བཞི་རང་རང་སུམ་ཆ་དབུས་སུ་འབུར་དུ་དོད་པ་དེའི་དབུས་སྟེང་སྐས་གསུམ་བསྒྲིགས་ནས་བ་གམ་སྟེང་བཙུགས་པ་ལྷ་བབས་མཆོད་རྟེན།",
    "ཡོན་ཏན་མི་མཁས་འདུག་མི་ཚུགས།",
    "གོ་ཆ་འཇིག་པ་ལྕགས་མདའི་འཕྲུལ་འཁོར་རྣམས་དང་རང་ཕྱོགས་སྲུང་བ་རལ་གྲིའི་འཕྲུལ་འཁོར།",
    "གཞན་ཡང་རྟ་དཔྱད་མི་དཔྱད་ཐོར་བུར་ཡོད་འདུག་པ་རྣམས་སྐབས་འདིར་མངས་ཀྱིས་དོགས་ལ།",
    "བོད་དུ་འདི་དང་རང་འགྲེལ་ཟླ་ཟེར་བཅས་པ་སོགས་མ་གཏོགས་གཞན་གསུམ་མ་འགྱུར་ལ།",
    "ཟུཪ་མཁར་བློ་གྲོས་རྒྱལ་པོ་ཡང་རང་བྱུང་བའི་རྗེས་འབྲངས་པའི་གསོ་དཔྱད་རང་ཚུགས་བོར་བའི་ཕྱི་ལྟར་བཀའ་ནས་ལྟར་པཎྜི་ཏའི་བསྟན་བཅོས་གསང་བ་པོད་རྩོམ་དུ་བཞེད་པ་སོགས་ལ་བརྟེན་བཀའ་མིན་པའི་གླེང་གཞི་ཆེ་ཞིང་།",
    "མན་ངག་རྒྱུད་ཀྱི་སྐབས་མཆན་དབྱེ་བ་སོགས་མཁས་པ་མི་དགུ་སོགས་ཀྱིས་འགྲེལ་པ་མང་དག་བརྩམས་གླེང་ཡང་རང་སྤང་ལས་ལུང་རིགས་གང་དང་ཡང་མ་འབེལ་ལ།",
    "དེ་ཐོག་བེ་རོ་ཙ་ན་ཡིས།",
    "གངས་རིའི་ཁུ་བྱུག་སོགས་ཁྱིམ་གྱི་སྟེགས་བུ་སོགས་སུ་འདུག་ནས་༢ སྐད་སྙན་སྒྲོག་པ།",
    "ཡུམ་གྱི་ལྷུམས་ན་བཞུགས་པའི་སྐུ་མེའི་ཕུང་པོ་ལྟ་བུ་འདུག་པའི་སྣང་བས་དཔག་ཚད་ལྔའི་བར་ཁྱབ་ཅིང་།",
    "ལུམྦཱི་ནཱིའི་ཚལ་དབེན་པར་འགྲོ་བ་དང་འདུག་པའི་བློ་སྐྱེས་ཏེ།",
    "དྲུག་པ་ལ་གཙུག་ཕུད་བཞག་ནས་མ་མའི་པང་པར་འདུག་སྟེ།",
    "༣ངང་བ་དང་རྨ་བྱ་སོགས་ཁང་བཟང་ལ་འདུག་ནས་སྒྲ་མི་བསྒྲགས་ལ།",
    "བུ་འདིར་འདུག་ན་བདག་ཅག་ལ་ཕན་ཐོགས་པར་འགྱུར་ན།",
    "དེ་ནས་ག་ཡའི་ལྷོ་ཕྱོགས་ལྟེང་རྒྱས་དགའ་དགའ་ལྟར་འདུག་པ་ཆུ་ནེ་རཉྫ་ན་ལྷོ་ནས་བྱང་དུ་བབས་པ།",
    "ཐུགས་ཀྱིས་ཐུགས་མངོན་དུ་བསྡམས་ཏེ་མཁའ་ཁྱབ་ཀྱི་བསམ་གཏན་ནམ་རྣམ་པར་བམ་པ་དང་མི་གཡོ་བ་ཞེས་པ་ལ་སྙོམས་པར་ཞུགས་ཏེ་འདུག་པས།",
    "ཁ་བུབ་གན་རྐྱལ་དུ་མི་གནས་པ་འདུག་ཚེ་མུ་སྟེགས་རིགས་འདུལ་ཐ་དད་པས།",
    "འདོད་ལྷ་རྣམས་ཀྱིས་བསྲུང་ཕྱིར་ཕྱོགས་བཞིར་འདུག་ཅིང་།",
    "ཡུམ་ཡི་ཆད་དེ་རོལ་པའི་རྫིང་འགྲམ་ལ་འདུག་ནས་རྒྱལ་བུ་དོན་གྲུབ་ཀྱི་བང་ཚད་ཀྱི་ཕ་བོང་ལ་སྲས་བསྐྱོན་ཏེ།",
    "གནས་དེར་མེ་ལྕེ་ཀུན་ཏུ་འབར་བའི་པདྨའི་གདན་ལ་བཞུགས་པའི་གཡས་ན་སྟོབས་པོ་ཆེ་འདུག་སྟེ།",
    "དགེ་སློང་ལྔ་པོས་ཀྱང་ཕྱག་བཙལ་གུས་པའི་ཚུལ་གྱིས་འདུག་ཚེ་སྐུ་ལས་འོད་བཀྱེ་བས་སྡུག་བསྔལ་རྒྱུན་བཅད།",
    "གཞོན་ནུ་དོན་གྲུབ་ཀྱང་འདི་འདྲ་འདུག་གམ་སོགས་འཆར་ཀར་དྲིས་པས་བདག་ནི་ཅུང་ཟད་ཙམ་ལགས་སོ།",
    "ངའི་མདུན་ན་སྨྲ་ཞིང་འཆག་པ་དང་འདུག་པ་ལ་ཡང་བལྟ།",
    "ཉ་པ་ལྔ་བརྒྱས་གསོད་པའི་སྲོག་ཆགས་ཀྱི་གྲར་འདུག་པ་སྟོན་པས་སྲོག་ཆགས་རྣམས་སླར་ཆུར་གཏོང་པའི་བཀའ་བསྩལ།",
    "རྒྱལ་པོ་འདི་གོོ་ཏ་མའི་ཕྱོགས་བྱེད་རྒྱལ་པོ་གསལ་རྒྱལ་དེ་གཟུ་བོ་ཞིག་ཡོད་འདུག་པ་དེའི་མདུན་དུ་འགྲོའོ།",
    "དེའི་ཚེ་རབ་འབྱོར་ཤིང་དྲུང་ཞིག་ན་འདུག་པས།",
    "བུ་ཐ་ཆུང་དགའ་བྱེད་གཅིག་པུ་འདུག་པ་དེ་ལ་ལྷུང་བཟེད་བཀང་མི་མཐོང་བར་བྱིན་གྱིས་བརླབས་ཏེ་བཞག་པ་འཕྲོག་མ་འོངས་ནས་བཙལ་བས་མ་རྙེད་ཅིང་མ་མཐོང་།",
    "དགྲ་བཅོམ་ལྔ་བརྒྱར་རང་རང་ལས་ཀྱི་རྒྱུ་བ་ལུང་བསྟན།",
    "མི་ཤིགས་པའི་གཞི་ཆུ་བོ་དབྱིག་ལྡན་གྱི་ནུབ་གྱད་ཀྱི་དབུ་རྒྱན་བཏགས་པའི་མཆོད་རྟེན་གྱི་དྲུང་དུ་སྤོས་ཤིང་སྣ་ཚོགས་བརྩིགས་རིན་ཆེན་དར་ཟབ་ཀྱིས་བརྒྱན་པར་པུར་སྒྲོམ་ཡང་མཁའ་ལས་དལ་གྱིས་བབས་པ་ཁ་ཕྱེ་ནས་སྤོས་ཤིང་སྟེང་ཕུར་སྒྲོམ་བཞག་སྟེ་མེ་སྒྲོན་གྱིས་སྲེག་ཀྱང་རང་ཤིར་གྱུར་ཚེ།",
    "ཞེས་བསྐུལ་བ་ལྟར་ཉིན་མཚན་གྱི་ཐུན་དང་པོར་འཆག་ཅིང་འདུག་པའི་སྒྲིབ་པ་སྦྱངས།",
    "གང་ཟག་དུས།",
    "པ་གོར་ཧེ་འདོད་ཀྱི་བུ་བེ་རོ་ཙ་ན་དང་།",
    "འདུག་པ་དང་འགྲེང་བའི་ཁྱད་པར་མ་གཏོགས་སྔར་ལྟར་རོ།",
    "༡༧༢ མ་བསྒོས་པར་གཞན་གྱི་སྟན་ལ་འདུག་པ།",
    "༡༧༣ མ་བརྟགས་པར་འདུག་པ།",
    "ཆང་འཚོང་མའི་སྐྱ་བ་གསེར་དུ་འདུག་པ་མཐོང་ནས་དེ་ལ་ཞུས་པས་གསེར་འགྱུར་གྲུབ།",
    "མངའ་བདག་ཁྲི་རལ་གྱི་དུས་གཏན་ལ་ཕབ་པ་ལས་རྙེད་པར་གྲགས་པའི་དཔེ་རྒྱུན་ཞིག་ཀྱང་འདུག་ཅིང་།",
    "དེ་གཉིས་གྲགས་མི་ཆེ་བའི་སྟབས་བརྒྱད་སྟོང་འགྲེལ་ཆེན་སོགས་སུ་འདི་གཉིས་ཀྱི་ལུང་མི་འདུག་པས་མཆོད་རྟེན་ནས་བྱུང་བ་རང་འཐད་འདྲ་ཞེས་འབྱུང་ཞིང་།",
    "གཞན་ཡང་དེང་སང་རང་ཕྱོགས་སུ་གྲགས་ཆེ་བ་རྩེས་ཐང་པ་འབྲས་སྤུངས་སྒོ་མང་།",
    "གཞན་ཡང་དིང་སང་རང་ཕྱོགས་ལ་འབྲས་སྤུངས་སྒོ་མང་།",
    "དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "ཐེམ་པའི་སྟེང་ན་འདུག་སྟེ་ང་ཕྱི་ལ་འདུག་གམ་ནང་ན་འདུག་ཟེར།",
    "མི་སྲིད་པའི་ཧར་མར་མེས་སྐར་མ་མི་མཐོང་བའི་བསྔགས་པ་སོགས་ནས་ལེགས་པ་ཞིག་མི་འདུག་ཀྱང་།",
    "རི་བོ་བྱ་རྐང་ཅན་དུ་ཡང་གསུངས་དེ་དག་རྣམས་མཁའ་འགྲོ་དང་ཀླུ་སོགས་ཀྱིས་རང་རང་ཡུལ་དུ་ཁྱེར་བ་སླར་གྲུབ་པ་ཐོབ་པ་རྣམས་ཀྱིས་བླངས་པ་དང་།",
    "ཁྱེའུ་མ་ཉམས་པར་མདངས་དང་ལྡན་པར་འདུག་པ་སླར་སྤོས་ཆུ་དང་འོ་མ་སོགས་ཀྱིས་ཁྲུས་བྱས་དར་དཀར་དྲི་མེད་ཀྱི་ལྟེབ་ཏུ་བླངས་པའི་ཚེ་ནམ་མཁའ་ནས་ལྷ་རྣམས་ཀྱིས་བཀྲ་ཤིས་ཚིག་དང་མེ་ཏོག་གཏོར།",
    "ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ནས་མཛད།",
    "བེ་རོ་ཙ་ན་སྟོབས་ལྡན་ནག་པོ།",
    "ཁྱེའུ་ལྟ་ན་སྡུག་པ་ལོ་བརྒྱད་པ་ཞིག་འདུག་པ་དང་།",
    "ཁྱེའུ་འདི་པདྨའི་འབྱུང་གནས་སུ་འདུག་ཟེར་པདྨ་འབྱུང་གནས་སུ་མཚན་གསོལ།",
    "ནང་དུ་འགྲོ་ཟེར་ཁྲིད་པར་དགེ་སློང་མ་མཐོང་བས་སྤྲོ་བ་སྐྱེད་པ་ཞིག་འདུག་པ་དང་མཇལ་ཞིང་ཕྱག་དང་བསྐོར་བ་བྱས།",
    "རོམ་བུ་གུ་ཧྱ་ཙ་ནྡྲར་བསྟན་པ་བསྲུང་བའི་ངན་སྔགས་གསན།",
    "མདུན་ན་ནེ་གུ་དྲུང་དྲུང་པ་ཅིག་འདུག་ནས།",
    "རྒོད་ལྡེམ་གྱི་རང་བྱུང་རང་ཤར་ག་༡༡༣ མདུན་༢།",
    "བཀའ་བརྒྱད་རང་བྱུང་རང་ཤར་ག་༡༤༧མདུན་༢།",
    "འདི་ལ་གཞན་ཡང་སྐོར་དང་གདོད་གཏད་སོགས་མང་དུ་ཡོད་འདུག་པ་ནི་གཏེར་སྟོན་གྱིས་གབ་ནས་དེང་སང་རྒྱུན་མི་སྣང་ངོ།",
    "ཡིད་དུའང་འདི་ཙམ་ཡིན་འདུག་བསམ་གདེངས་མ་ཁེལ་བས་བརྗོད་བྱ་དེ་བཞིན་དུ་བགྱིས་པ་ཡིན་ཀྱང་།",
    "ས་བདག་ཟིན་ཕུང་རང་ཡང་ངན་པ་གཞིར་བཅས་ཀྱང་དེ་དང་གདུག་རྩུབ་འབྲས་སོགས་ཚང་མ་ཆུང་ངུ་མེད་པའི་རིགས་དང་།",
    "བསྟན་བཅོས་མ་རང་དུའང་སྔ་སོར་དགག་པ་མཛད་དུས་ལུས་པའི་ལོག་ལམ་འཁྲུལ་པའི་རིགས་འདུག་ན་ཡང་བསྐྱར་གྱི་མ་བུ་ཟུང་དུ་དགག་པ་ཐ་དད་མཛད་པར་རིགས་ཤིང་།",
    "བསྟན་བཅོས་མ་རང་དུའང་སྔ་སོར་དགག་པ་མཛད་དུས་ལུས་པའི་ལོག་ལམ་འཁྲུལ་པའི་རིགས་འདུག་ན་ཡང་བསྐྱར་གྱི་མ་བུ་ཟུང་དུ་དགག་པ་ཐ་དད་མཛད་པར་རིགས་ཤིང་།",
    "བསྟན་བཅོས་རྩོམ་ཞིང་རང་སྐད་ཐོན་པ་འབྱུང་",
    "ཆུ་བོ་གངྒཱ་དང་ཕྱིའི་རྒྱ་མཚོའི་ནང་མཐའི་བར་ན་འདུག་ཅེས་སོགས་བྱུང་ལགས་ཤིང་།",
    "ཞེས་གནང་འདུག་པ།",
    "རི་རབ་དང་ལུས་ཀྱི་རྫ་མ་དེ་ག་སྦྱར་ན་གཞི་དོགས་ངན་ལས་མ་འདས་ཀྱང་གོ་ཕྱོགས་སྣ་ཚོགས་ཀྱིས་ཚོམ་པ་འདུག་པས་སྙན་སྒྲོན་དུ་ཕུལ། ལྔ་པ།",
    "རིམ་བཞིན་རང་རང་འབྱུང་ཁམས་ཀྱི།",
    "པཎ་གྲུབ་སོགས་བསྟན་པའི་གསལ་བྱེད་དུ་གྱུར་པ་རྣམས་ཀྱི་འཁྲུངས་ལོ་སོགས་ལོ་ཚིགས་ཀྱི་ངེས་པ་འདིའོ་ཞེས་པ་ཡང་གལ་ཆེ་ངེས་སུ་འདུག་ལགས་པ།",
    "ལོ་འདིའི་ངོས་འཛིན་རྒྱུད་གསུངས་པའི་ལོར་བྱེད་དགོས་ཞེས་བཀའ་དྲིན་བསྐྱངས་འདུག་པ་དང་།",
    "གོང་ས་སྐྱབས་མགོན་དམ་པ་འདིའི་རྒྱལ་རབས་རྫོགས་ལྡན་གཞོན་ནུ་ལས་ལྕགས་རྟར་འཁྲུངས་ལྕགས་འབྲུག་ལ་གཤེགས་ཚུལ་འདུག་པ་དེས་ན་དགུང་ལོ་ཡང་དོན་གཅིག་བཞུགས་འདྲ་ཞིང་།",
    "ཡང་ཉུང་བ་ལོ་དྲུག་སོགས་མང་པོ་བྱུང་བ་རྩོད་ཡིག་ཚོར་འདུག་པ་དང་།",
    "རྐང་པ་ཕྱེད་པའི་སྐོར་འདིའང་འོང་བབས་དེ་བཞིན་སྙན་འབུལ་ཞུ་མི་བྱུང་ཚེ་དགོངས་དག་པ་འདུག་ཅིང་།",
    "ཞེས་སོགས་གནང་འདུག་པ་དག་རྩིས་གཙོ་བ་དག་མནར་བྱེད་པར་ལྷད་སོགས་བྱེད་གྲུབ་རྣམ་འབྱེད་དུ་གསུངས་ནའང་།",
    "ཟླ་འཛིན་མཚན་དགུང་ལྟ་བུར་རིལ་འཛིན་ཡོད་ཚེ་མཇུག་མའི་སྐབས་ཚེས་ལོངས་ཟད་དུས་དང་ལྟ་སྣང་འགྲིག་འགྲོ་བ་དག་བྱེད་དུ་འདུག་ལགས་པར་མ་ཟད།",
    "དེ་ནས་བཀའ་རྩོམ་འདིར་བལྟས་པས་ཤེས་པ་འདུག་རུང་རང་གཞན་སྔར་གྱིས་རྗེས་ཀྱིས་གསལ་ཞིང་རྣམ་མཁྱེན་ཁྲེལ་བའི་རྒྱུ་ལས་མ་འདས་ལགས།",
    "བོད་དུ་རང་རང་རིགས་རུས་ལ།",
    "ཡང་ན་རྒྱུད་སོ་སོའི་དགོངས་མཚོན་ཡིན་གྱི་གསལ་བྱེད་བྱུང་ན་ཚོམ་པ་སེལ་འདུག་བསམས་པ་སྙན་སྒྲོན་དུ་ཕུལ། དྲུག་ཅུ་པ་ཐུན་ཕྱེད་ཕྱི་ནང་གཉིས་ཤོག་ཁྲ་ཉུང་ལ་དོན་འདུས་ངོ་མཚར་བ་ལས་གཞན་མ་དོགས་འབུལ་མ་རྙེད།",
    "ད་ཕན་འདི་ལ་ཐུགས་དོགས་འཕྲོས་རིགས་སུ་ལ་ཡང་མ་བྱུང་གཤིས་ལེ་ཐོ་སྦྱོར་འགྲོ་ལ་སོགས་པའི་སྤྱོད་ཁྲ་རྣམས་གསུང་བོད་སྐད་དུ་འབྱོན་པ་ལས་འོས་མ་མཆིས་འདུག་ལགས་ཤིང་།",
    "དེ་ནས་ཕག་ཞག་བདུན་བརྩི་བ་ཧྭ་འགྱངས་ཆེ་བ་༩༥དི་འགལ་དོགས་ཚོམ་པ་སེལ་ཞིང་མ་དག་པའི་ཁུངས་འབྱིན་ཇི་ལྟར་ཡོད་བསམས་སྙན་སྒྲོན་དུ་ཕུལ། དོན་བདུན་པ་ལེའུ་བཅུ་བདུན་པའི་ཞག་གསུམ་རྣམ་དབྱེ་འདི་གོ་དོན་ཕིགས་པའི་རྩ་བ་ལྟ་བུ་ཡིན་འདུག་ཀྱང་།",
    "བ་ལུགས་སོགས་སྔ་སོར་ཡང་བཀའ་རྩོམ་འདི་ལས་གསལ་ཐེབས་མི་འདུག་རུང་།",
    "གྱ་བཞི་པ་ལྐོག་གྱུར་གྲངས་ཀྱི་དོན་རྟོགས་ཟེར་བ་མེ་མདའ་ཐུབ་པས་བགྲངས་པ་སོགས་འོང་འདུག་རུང་།",
    "ག་སྨྱུག་འབྱོར་ཚད་ཀྱིས་བསླད་པའི་འདི་ལྟ་བུའི་ངེས་པའི་ཁུངས་དོན་དང་འགལ་མེད་འཆད་ཐུབ་པ་ཞིག་མི་འདུག་པ་དང་།",
    "རྐང་མཐིལ་ལས་སྐྱེས་པ་སྟོབས་ཀྱི་འཁོར་ལོས་སྒྱུར་བར་གནང་འདུག་པ་སྐྱེ་གནས་ཀྱང་ཅུང་ཟད་མི་མཐུན་ཞིང་།",
    "དེ་སྔོན་ནས་དར་ཚར་བ་འདྲ་ཞིག་འདུག་པ་དང་།",
    "རིན་ཆེན་གཏེར་མཛོད་སོགས་འགར་ཀླུང་རྟ་ཆད་བསབ་ཀྱི་སྐབས་སའི་དོད་འདྲེན་ལུགས་བྱུང་བ་ཇི་ལྟར་ཡིན་ལ་དོགས་པ་ཤར་བ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་ཐམ་པ་སྤུག་སོགས་ཀྱི་ལུགས་ཀྱི་ཟླ་ཞག་དུས་ཚོད་ཀྱི་ཁམས་བརྩི་ལུགས་ཉིད།",
    "དར་གུད་སྐབས་འདིར་ལོ་ཟླ་ཞག་དུས་བཞིར་སྦྱོར་བ་གནང་བ་ལྟར།",
    "འགྲོ་བ་སྤྱི་ལ་ཡང་རྫུན་ཟོབ་ཀྱི་སླུ་བྲིད་མེད་པའི་ཤིན་ཏུ་བཀའ་དྲིན་ཆེ་འདུག་ཅིང་།",
    "འགྲོ་བ་རྣམས་ཀྱང་བླང་དོར་བློས་ཁོལ་ན་སྤྱི་བྱེ་བྲག་ཏུ་བལྟས་ཆོག་མ་བཀའ་དྲིན་ཚད་བཟུང་དུ་མེད་པར་ཆེ་བ་བྱུང་འདུག་ལགས་པ་ནས་དོགས་གནས་ཆེ་བ་གཞན་མ་མཆིས་ལགས་རུང་།",
    "ལོ་ཟླ་ཞག་དུས་སྲོག་ཁམས་བཞི།",
    "ལོ་ཟླ་ཞག་དུས་བཞི་ཡི་ཁམས།",
    "དང་པོ་ལོ་ཟླ་ཞག་དུས་སྤར་ཁ་དང་།",
    "འགྲེལ་པ་ལག་ཏུ་བྱུང་ཡང་རྡེལ་རྩ་དང་འགྲེལ་ཆུང་སོགས་ཁ་འཐོར་བའི་ཆང་འགྲིལ་སྔར་ཕན་ཁྲིགས་ཆགས་འདི་ལྟ་བུའི་ལྟོ་འབྱོར་མེད་གཤིས་ལག་ལེན་སྣ་ཚོགས་ལས་ངེས་པ་འདིའོ་ཞེས་གཏིང་ཚུགས་མི་འདུག་པར།",
    "ཅི་སྟེ་དཔོན་གཙོ་བ་དང་སྦྱར་ནས་བརྩི་བ་སོགས་ལ་དཔྱད་ཡུལ་སོམ་ཉིར་འདུག་པ་འདི་ཇི་ལྟར་ཞུ་རྒྱུ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་སོ་བརྒྱད་པ་སྐོར་མགོ་བཅུ་གཅིག་པ་འདོ་ཆེན་རྟའི་རྩིས་སོགས་བདག་པོའི་ལོ་རྟ་དང་སྦྱར་ནས་བརྩི་བ་ལས་མ་འདས་རུང་།",
    "འདིར་ཞིབ་པའི་སྐོར་མགོ་ཞེས་གནང་བ་འདི་བྲན་གཡོག་ལ་ཡིན་པའི་ཤེས་བྱེད་ཅིག་མེད་ན་སོམ་ཉིར་གྱུར་དོགས་པ་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་ཞེ་གཅིག་པ་ཁོག་པ་དྲུག་ཅུ་པ་སོགས་པའི་རྩིས་ཕྲན།",
    "དེ་མིན་ལུགས་ཀར་བརྗོད་པ་གནང་ན་ད་དུང་རྡེལ་ཞག་བཅུ་གསུམ་མ་ཞེས་སོགས་པའི་ཀེག་རྩིས་མང་བས་འདི་ལ་དགོངས་པ་ཇི་ལྟར་ཡིན་ཐེ་ཚོམ་བྱུང་བ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་ཞེ་གསུམ་པ་ལེའུ་ཉེར་བརྒྱད་པ་རྟགས་ཕྲན་གྱི་སྐོར་འདི་མ་གཞི་གཤམ་བསྡོམས་སུ་བཀའ་དྲིན་ཆེ་འདུག་པ་ལྟར་ཅུང་ཟད་མི་བཙན་པ་འདྲ་ཞིག་འདུག་རུང་།",
    "གནམ་ལ་ཉི་ཟླ་སྐར་གསུམ་འཛོམ་། ཟེར་བ་འདི་རྙིང་པ་ཚོར་ཀྱང་ཡོད་འདུག་ཅིང་།",
    "བོན་རྩིས་སོགས་སྣ་ཚོགས་པ་ཡང་འདུག་ལགས་པ་ནས་དཔྱད་དཀའ་རུང་།",
    "ཁྱིམ་ཞག་དང་བསྟུན་ན་བཀའ་རྩོམ་འགྲིག་པ་ལྟ་བུ་འདུག་རུང་འདི་ཁྱིམ་ཞག་དང་བསྟུན་པའི་ཤེས་བྱེད་དང་།",
    "ཁྱིམ་ཞག་རྣམ་དག་ཡིན་ཚེ་རགས་པ་ཞེས་གནང་བ་འདིར་སྐྱོན་གྱི་དོགས་པ་ཙམ་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལ།་",
    "ངན་པ་གནས་སྤར་ཐུབ་པ་སོགས་དགེ་དུ་མ་ཞིག་ཡོད་པ་ཡིན་འདུག་ཀྱང་།",
    "ད་ལྟ་བསྡུས་དོན་བཅུ་གསུམ་མའི་རྩ་བ་བློར་བཟུང་ནས་དེ་ནང་ལྟར་བྱེད་སྲོལ་འདུག་ལེགས་པ་ད་ཆ་བཀའ་རྩོམ་ཚོགས་ཆེས་པས་བློར་བློ་ཐ་མས་མི་ཟིན་ཅིང་།",
    "སྦྱིན་བདག་དང་རྩིས་པས་མ་ནུས་དོགས་པ་ཙམ་ལས་གཞན་མ་འགྲོ་བ་སྤྱི་སྒོས་ཚང་མར་བཀའ་དྲིན་གྱི་དཔལ་དུ་ཆེ་འདུག་ལགས་ཤིང་།",
    "སྦས་བཅད་ཅན་དང་སྦས་བཅད་མེད་པ་གཉིས་ཀར་མི་འདུག་པ་འདིར།",
    "ཞེས་འདུག་པའི་རྐང་གཅིག་པོ་འདི་ཆད་པར་དོགས་སྐྱོན་བྱུང་ལགས་པ་དང་།",
    "དེ་ལྟར་མིན་ན་དགྲ་དང་འཕྲལ་རྐྱེན་དེར་དམིགས་བཟུང་ཇི་ལྟར་འབྱུང་ལ་དོགས་ངན་འདུག་པ་དང་།",
    "ལོ་ཟླ་ཞག་དུས་བཞི་བརྩེགས་ན།",
    "ལོ་ཟླ་ཞག་དུས་ཁམས་སྤར་ཁ་དང་གཅིག་པ་ཡིན་ཚེ་དེ་ཉིད་ཁམས་ལ་མང་བས་གང་གཙོ་ཆེ་བ་དང་།",
    "ཡང་ན་སྤར་ཁ་དེ་དག་ལ་འཆར་བ་ལྟ་བུའི་རྩིས་ཤིག་ན་རྩ་ཁུངས་ལ་དོགས་གནས་སུ་གྱུར་པ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་ང་གསུམ་པ་ཕུང་པོ་གཏོང་བའི་སྐོར་འདིར་མ་གཞི་སྒོར་མར་ཐུགས་ཞིབ་ཀྱི་བཀའ་དྲིན་ཆེ་འདུག་ཀྱང་ཕྱེད་དང་བཞི་རྩིས་ཀྱི་སྐོར་འདི།",
    "ཞེས་འདུག་ལགས་ཀྱང་།",
    "ཁུངས་རྣམ་དག་ཡེ་མི་སྣང་ཞིང་སྒྲུབ་བྱེད་རྣམ་དག་གཞན་ཡང་མི་འདུག་པས་རྟོག་བརྟགས་སོ།",
    "ཞག་ཕྱེད་བཞིར་བརྒྱལ་སྟབས་སུ་གནས་ཟེར་བ་མི་འདུག་ལགས་ཤིང་།",
    "འཁོར་ལུགས་སྣ་ཚོགས་པའི་སྤང་བླང་འདི་ཡིན་གྱི་ངེས་པ་རང་རང་སོ་སོའི་རྨོངས་ཞེན་ཕྱོགས་འདེད་ལས།",
    "དེ་བཞིན་ཟླ་འཁོར་ཞག་དུས་ཀྱི་ས་བདག་མང་བར་གསུངས་ཤིང་།",
    "དེང་སང་བྱིངས་མངས་ལ་རྩ་འགྲེལ་ཙམ་ལས་གསུང་འབྱོན་པ་ཞིག་མི་འདུག་ལགས་རུང་།",
    "དོན་ཕུར་པ་ལ་བརྟེན་པའི་བཅོས་ཡིན་པ་ཙམ་ལས་བཅོས་ཀྱི་རིམ་པ་མི་གཅིག་པ་གཉིས་བྱུང་བ་དགོངས་པ་མཐུན་པ་ཡིན་མིན་ལ་དོགས་པ་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་དོན་དྲུག་པ་རིའི་རྒྱབ་མདུན་དབྱེ་སྐབས།",
    "ཞེས་པས་འབྲུག་ལྷ་ཐེ་གྲུམ་མི་གཅིག་པ་སོགས་ཀྱི་དོགས་གནས་འོང་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་བརྒྱད་ཅུ་པ་ས་དགྲ་གནོན་བྱེད་ཀྱི་སྲོག་ཆགས་ཀྱི་གཟུགས་བརྙན་ལ་གཟུངས་འབུལ་དགོས་པ་སོགས་ལ།",
    "རྒྱུ་འབྲས་ཁྱད་དུ་གསོད་པ་ཡང་འོང་འདུག་པ་འདི་ལ་དོགས་པ་ཙམ་ཤར་བ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་གྱ་བཞི་པ་བླ་གནས་ཀྱི་སྐོར་འདི་མི་མཐུན་པའི་རིགས་མང་བ་ལས།",
    "འདི་གཉིས་མི་གཅིག་པར་དོགས་གནས་འདུག་པ་སྙན་སྒྲོན་དུ་ཕུལ། བརྒྱ་གྱ་ལྔ་པ་དབྱངས་འཆར་ནུབ་ཀྱི་རྩིས་དུས་འཁོར་སྐབས་དབྱེ་བ་ཕྲ་བར་འདི་ལྟར་གསུངས།",
    "རྩིས་པས་ཀྱང་གང་ཅི་ནས་བལྟ་མི་ཐུབ་པའི་ལོང་མེད་པ་ཞིག་འོང་འདུག་ལགས་ཀྱང་།",
    "གཞན་ལུགས་གཟའ་རང་རང་ཆ་ཤས་བཅོ་ལྔ་ཚུན་འདུག་ཚེ་རང་ཡུལ་འགྲོ་ས་ནས་ཕར་དང་།",
    "དུས་འཁོར་ལུགས་སུ་བརྩི་ན་ཇི་ལྟར་དང་བརྩི་དགོས་མིན་དོགས་པ་འདུག་པ་དང་ཆར་འབེབས་རྩིས་འབྲས་ཀྱི་སྐབས།",
