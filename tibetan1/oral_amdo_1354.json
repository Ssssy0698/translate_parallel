    "ས་གནས་མི་དམངས་གུང་ཁྲན་ཏང་གི་བཙན་གནོན་འོག་ཚུད་པར་ཐོག་མའི་འདོད་པ་མི་ཁེངས་པ་དེ་གང་མྱུར་གྱིས་ཟིང་ཆའི་ངོ་བོར་བསྒྱུར།",
    "གུང་ཁྲན་ཏང་གིས་དྲག་ཤུགས་ཀྱིས་ཕར་རྒོལ་བྱས།",
    "མཐའ་མཇུག་དེར་ཁོ་རང་མའོ་ཙེ་ཏུང་གིས་གསར་དུ་བསྐོས་པའི་ཏང་གི་གཞུང་འཛིན་པའི་མདུན་དུ་འཁྲིད་ཅིང་།",
    "གལ་སྲིད་ཁོང་གིས་གུང་ཁྲན་ཏང་གིས་བཏོན་པའི་དགོས་འདུན་རྣམས་ཁས་བླངས་ཚེ།",
    "ཁོང་ནི་ཆབ་སྲིད་ཀྱི་རིན་ཐང་དཔག་ཏུ་མེད་པ་ཡོད་པ་ཞིག་རེད།",
    "ངས་ཉན་དགོས་བྱུང་བ་ནི་ཆེས་གདུག་རྩུབ་ཅན་ཞིག་ཡིན་པས་ངས་རང་གི་ཚོར་བ་འགོག་དཀའ་བ་བྱུང་།",
    "དེ་ནི་གལ་སྲིད་ང་ལྷ་སར་སླེབས་ནས་བོད་གཞུང་གིས་གུང་ཁྲན་ཏང་གི་དམག་མི་རྣམས་བཅིངས་འགྲོལ་གཏོང་མཁན་གྱི་ངོ་བོར་ཡོང་རྒྱུ་དེ་ལ་དགའ་བསུ་བྱེད་པ་ཞིག་བཟོ་ཐུབ་པ་དང་རྒྱ་ནག་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་དེ་མཐུན་གྲོགས་ཤིག་ཏུ་ངོས་ལེན་བྱས་པ་ཡིན་ན།",
    "ང་ལྷ་སའི་གཞུང་འཛིན་པ་བཟོ་རྒྱུའི་ཁས་ལེན་ཙམ་ལས་ཅི་ཡང་མ་རེད།",
    "མཚམས་འདི་ལ་སླེབས་དུས་ཁོ་ཚོས་ཐ་ན་ངས་སྤུན་ནང་དམེ་བྱེད་པ་ཡང་གནས་སྟངས་འདི་འདྲའི་འོག་དགོས་མཁོ་བྱུང་ན་བྱེད་འོས་པ་ཞིག་ཡིན་པ་ཧ་ལམ་གསལ་པོར་ཤེས་བཅུག་སོང་།",
    "ཁོ་རང་ལ་རྒྱ་མིའི་བསྐྱལ་མཁན་མེད་པར་ཟླ་བ་གསུམ་རིང་གི་ལྷ་སའི་འགྲུལ་བཞུད་དེ་བྱེད་དུ་བཅུག་པ་རེད།",
    "ཁོང་གིས་ཕྱག་རྒྱ་ཞིག་གིས་གདོན་གྱི་ཆོ་འཕྲུལ་འགོག་གི་ཡོད་པ་ལྟ་བུ་ཞིག་གནང་བ་དང་བཅས་ང་ལ་ཡར་ལངས་དགོས་པའི་བརྡ་བསྟན་སོང་།",
    "ཡུད་ཙམ་རིང་ང་ཚོས་ཕན་ཚུན་གྱི་མིག་ལ་བལྟས།",
    "སྤྱན་ཤེལ་གྱི་རྒྱབ་དེ་རུ་ཁོང་གིས་ང་ལ་བཅངས་པའི་བརྩེ་སེམས་དང་ཐུགས་ཁུར།",
    "ངའི་སྤུན་གྱིས་ང་ལ་དགའ་པོའི་ངང་ནས་ཐུགས་རྗེ་ཆེ་ཞེས་གསུངས་ནས་ཕེབས་སོང་།་",
    "ཁོང་ཚོས་བོད་འདི་གཅིག་པུས་གུང་ཁྲན་ཏང་ལ་ཁ་གཏད་བྱེད་ཐུབ་པའི་ནུས་པ་མེད་པ་ཚོར།",
    "ཁོ་ཚོ་ལ་ཕྱི་ལོགས་ཀྱི་རོགས་རམ་དགོས་པ་ནི་གསལ་པོ་རེད།",
    "ཐ་ན་ཁེར་འདུག་རིང་ལུགས་པ་ལ་དགའ་མཁན་འདི་ཚོས་ཀྱང་ད་ནི་མཐོང་གི་ཡོད།",
    "བཀའ་ཤག་གི་ངོས་ནས་དེ་ནི་ཐག་གཅོད་གལ་ཆེན་ཞིག་ཡིན་ཏེ།",
    "ད་བར་དུ་བོད་ནི་རང་རློམ་ཅན་གྱི་ཚོགས་པ་ཞིག་ཏུ་གྱུར་ཡོད་པ་རེད།",
    "དེ་ནི་ཨེལ་སེལ་ཝ་ཌོར་རྒྱལ་ཁབ་རེད།",
    "ཁོང་ཚོས་བོད་གཞུང་དེ་ཞི་མོལ་གྱི་ཅོག་ཙེའི་ཐོག་ཡོང་དུ་འཇུག་རྒྱུའི་འདོད་པ་བྱས་པ་རེད།",
    "ནེཧ་རུ་ཡིས་རྒྱ་ནག་གི་ཀུན་སློང་སྐོར་ལ་སྐད་ཆ་དྲིས་སྐབས།",
    "རྒྱ་མི་སླེབས་པ་ནི་འཐབ་འཛིང་གི་ངོ་བོ་མིན་པར་རོགས་སྐྱོར་ཡིན་པ་དང་།",
    "ཡིན་ན་ཡང་ཟླ་བ་དང་ཟླ་བ་སོང་རིམ་བཞིན་རྒྱ་མི་རྣམས་བོད་དུ་གཏན་སྡོད་བྱེད་པ་ཞིག་ཏུ་མཐོང་བ་རེད།",
    "མའོ་ཡིས་ནེཧ་རུ་ལ་ཁོའི་ལས་ཀ་གཅིག་པུ་ལ་མགོ་འཁོར་རྒྱུ་ལས་གཞན་བྱུས་གཏོགས་མེད་ལུགས་བརྗོད་པ་རེད།",
    "ད་དུང་ཁོས་ནེཧ་རུ་སྒེར་ལ་ཚིག་གིས་བརྒྱབ་ནས།",
    "ཆེས་སྡུག་ཇག་ཅིག་ཏུ་བརྩིས་པའི་རྒྱ་གར་གཞུང་གི་ལྟ་སྟངས་དེའི་ཐད་ཀྲུང་གོ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱིས་རྒྱ་ནག་ལ་མི་དགའ་མཁན་ཚོའི་ཤུགས་རྐྱེན་ཐེབས་ཡོད་མེད་མི་ཤེས་མོད་དེ་ལྟར་ཡིན་པར་ངོས་འཛིན་བྱེད་ཀྱི་ཡིན།་",
    "དེའི་རྐྱེན་གྱིས་ནེཧ་རུ་ནི་དབྱིན་ཇི་དང་ཨ་མི་རི་ཀའི་ཆུ་སྦྱིན་བྱིས་པ་རེད་ཟེར།",
    "དེའི་མཇུག་འབྲས་སུ་གནས་ཚུལ་ཇི་འདྲ་ཡིན་པའི་ཐད་ཁོ་ཚོ་ལ་གོ་རྟོགས་ཡག་ག་ཡོད་པ་རེད་ལ།",
    "དེའི་སྣེ་ཁྲིད་ཀྱི་རྗེས་སུ་འབྲངས་རྒྱུ་ནི་ཉེན་ཁ་མེད་པ་ཞིག་ཏུ་མཐོང་བ་རེད།",
    "དབྱིན་ཇིས་སྣེ་འཁྲིད་བྱེད་འདོད་བྱེད་ཀྱི་མེད་པ་དེ་རེད།",
    "སྟོབས་ཆེན་དབྱིན་ཇི་ནི་ད་ཆ་སྟོབས་ཆེན་གང་ཡང་མ་རེད།",
    "ཁོང་ཚོ་དབུས་ཨེ་ཤེ་ཡ་ནས་ཧ་ལམ་ཕྱིར་འབུད་བཏང་ཡོད་ཅིང་།",
    "འདི་ནི་རང་གི་ཆབ་སྲིད་བརྗེ་བསྒྱུར་བྱས་ནས་ཤུགས་རྐྱེན་ཡོད་པ་བཟོ་བའི་དུས་ཚོད་ཅིག་མ་རེད།",
    "རང་གི་ཐེ་བྱུས་མེད་པ་བྱེད་པ་ཡང་ལས་སླ་བོ་ཞིག་མིན་པ་ནི་བདེན་པ་རེད།",
    "ང་ཚོས་ངོས་འཛིན་བྱེད་རྒྱུ་ལ།",
    "རྒྱ་གར་གྱིས་འདི་འདྲའི་རྣམ་འགྱུར་བཟུང་ན་ང་ཚོས་ཀྱང་དེ་ལྟར་བྱེད་པའི་གྲ་སྒྲིག་བྱེད་དགོས་ཀྱི་རེད་བསམས།",
    "དེ་འདྲའི་རྟགས་མཚན་ནི་མཐོང་ས་ན་མི་འདུག་བོད་ཀྱི་གནས་བབས་ཐད་རང་གི་སྒེར་གྱི་འདོད་ཚུལ་ཇི་འདྲ་ཞིག་བྱུང་ཡོད་ནའང་།",
    "ཡང་ན་གསར་དུ་རང་བཙན་ཐོབ་པའི་རྒྱ་གར་གཞུང་གིས་བོད་ཐོག་གི་ལངས་ཕྱོགས་གང་ཡིན་གྱི་ལྡོག་ཟླར་འགྲོ་རྒྱུ་དེ་རེད།",
    "ཨ་རིའི་གཞུང་ལ་དེ་ལྟར་བསམ་བློ་གཏོང་དགོས་པའི་རེ་སྐུལ་ནན་ཆེར་བྱས་པ་རེད།",
    "གལ་སྲིད་གང་ལྟར་ཨ་མི་རི་ཀ་ལ་བོད་ལ་ཆབ་སྲིད་དང་དམག་དོན་གཉིས་ཀའི་ཐད་ནས་རོགས་སྐྱོར་བྱེད་རྒྱུའི་འདོད་པ་དངོས་གནས་ཡོད་ན།",
    "གལ་སྲིད་རྒྱ་མིས་དེ་ཤེས་ཚེ་དེའི་ནང་རྒྱ་གར་གྱི་ཐེ་བྱུས་ཡོད་པར་བརྩི་གི་རེད།",
    "ཨ་མི་རི་ཀས་དབྱིན་ཇིའི་ཉེན་བརྡ་ལ་ཉན་པ་རེད།",
    "བློ་འདྲིའི་ཆེད་རྒྱ་གར་ལ་འབྲེལ་གཏུགས་བྱས་པ་དང་ཨ་མི་རི་ཀས་བོད་མི་ཚོར་དམག་ཆས་ཀྱི་རོགས་སྐྱོར་བྱེད་རྒྱུའི་འདོད་པ་ཡོད་ཚུལ་བརྗོད་པ་རེད།",
    "རྒྱ་གར་གྱིས་དགག་ཕྱོགས་བཟུང་སྟེ་དབྱིན་ཇིས་སྔོན་ཚུད་ནས་ཤེས་པ་ཇི་བཞིན་ཨ་མི་རི་ཀ་བ་ཚོར་ཡང་བསྐྱར་བསམ་བློ་གཏོང་རོགས་ཞུས་པ་རེད།",
    "གལ་སྲིད་རྒྱ་གར་གཞུང་གིས་ཨ་རིས་བོད་ལ་རོགས་སྐྱོར་བྱེད་རྒྱུར་མངོན་ཆུང་གིས་བཀའ་འཁྲོལ་བྱས་པ་རྒྱ་མིས་ཤེས་ཚེ་དེའི་ལན་ཇི་འདྲ་ཞིག་བྱེད་ཀྱི་རེད།",
    "བོད་ནང་བཙན་རྒྱལ་རིང་ལུགས་པའི་གསང་འཆར་ཡོད་ཟེར་བའི་གུང་ཁྲན་ཏང་གི་ལྟ་ཚུལ་སྨྱོན་པ་དེའི་ར་སྤྲོད་ཐུབ་པ་ཡོང་གི་རེད།",
    "རྒྱ་གར་གྱིས་ཨ་མི་རི་ཀ་ལ་ཞུ་བ་འཐེན།",
    "ཁྱེད་ཚོས་འདིར་ཐེ་བྱུས་བྱས་ན་ང་ཚོ་ལ་དཀའ་རྙོག་ཁོ་ན་བཟོ་གི་རེད།",
    "རྒྱ་གར་གཞུང་གིས་རེ་བ་མེད་པའི་ངང་ནས་བོད་ལ་རོགས་རམ་བྱེད་རྒྱུར་དགག་པ་བྱས་བྱུང་ལ།",
    "རྒྱ་གར་གྱི་ལག་ནས་རོགས་སྐྱོར་མུ་མཐུད་ལེན་པའམ་རྒྱ་གར་བརྒྱུད་བོད་ལ་མཚོན་ཆ་གཏོང་བའི་ཆོག་མཆན་ཐོབ་པ་བྱ་རྒྱུ་ནི་ལས་སླ་པོར་ཡོང་བ་ཞིག་མ་རེད།",
    "ཅེས་བྲིས་པ་རེད།",
    "བོད་ལ་བཙན་འཛུལ་བྱས་པ་རེད་དམ།",
    "བོད་དེ་རང་བཙན་གྱི་རྒྱལ་ཁབ་ཅིག་རེད།",
    "བོད་ནང་དཀའ་རྙོག་ཡོང་སྲིད་པ་དེ་ཚོ་ད་ནི་ཇེ་ཆུང་ལ་སོང་ཡོད་དེ།",
    "ནེཧ་རུ་ཡིས་འཚམས་འདྲིའི་ཡི་གེ་བཏང་པ་རེད།",
    "གཟབ་སྤྲོས་རྒྱ་ཆེ་ཙམ་ཡོད་ནའང་མཛད་སྒོ་དེ་ནི་སྤྲོ་བ་མེད་པ་ཞིག་རེད།",
    "ཁམས་དང་དེར་ཡོད་པའི་དམག་དཔུང་ཚང་མ་ཤོར་པ་རེད།",
    "བོད་ཀྱིས་རྒྱ་མི་བཟློག་སླད་དུ་ཆབ་སྲིད་དང་དམག་དོན་གྱི་རོགས་རམ་ཞུ་བའི་སྐུ་ཚབ་བཏང་བ་རྣམས་ཨ་རི་དང་དབྱིན་ཇིའི་གཞུང་གིས་ངོས་ལེན་བྱེད་རྒྱུའི་ཁས་ལེན་མ་བྱས་པ་རེད།",
    "མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ཀྱིས་བོད་ནང་རྒྱ་ནག་གིས་བཙན་འཛུལ་བྱས་པར་བརྩི་སེམས་མེད་པ་རེད།",
    "རྒྱ་གར་གྱིས་དམག་དོན་དང་ཆབ་སྲིད་ཀྱི་རོགས་རམ་མཁྲེགས་པོ་ཞིག་སྤྱོད་ཀྱི་མེད་པ་རེད།",
    "ཧ་ལམ་རྒྱ་མི་ཚོས་རང་གིས་དུས་ཚོད་ནམ་ཡིན་འདམས་ནས་ལྷ་སའི་ནང་གོམ་པ་བརྒྱབ་ཐུབ་པ་ཡོད་པ་རེད།",
    "ཁོ་ཚོའི་ཀླད་པ་བསྒྱུར་ཡོད་པ་རེད།",
    "གུང་ཁྲན་ཏང་གིས་ང་ཕོད་ཡོངས་སུ་བཀུག་ཡོད་དམ།",
    "ཁོ་སྒེར་གྱི་བདེ་ཐང་དེ་རང་གི་བློ་མཐུན་གསར་པ་ཚོ་དང་མཉམ་འབྲེལ་བྱེད་རྒྱུ་ལ་རག་ལས་ཡོད་པའི་གནས་སྟངས་ཆ་ཚང་བ་ཤེས་པར་གྱུར།",
    "བོད་མིའི་འགོག་རྒོལ་མངོན་གསལ་གྱིས་ཡོད་པ་དེ་ཁས་ལེན་མ་བྱས་པ་རེད།",
    "བོད་མི་མང་ལ་གུང་ཁྲན་ཏང་གི་སྐོར་ལ་དོགས་པ་མང་པོ་ཡོད་པ་རེད།",
    "ང་ཚོས་གུང་ཁྲན་ཏང་ལ་འབྲེལ་བ་བྱེད་རྒྱུའི་ཐབས་ཤེས་བྱས་པ་ལ་འབྲས་བུ་མ་བྱུང་བར་བརྟེན་ང་ཚོས་ས་མཚམས་ལ་སྲུང་དམག་བཞག་ནས་ང་ཚོའི་ལུང་པ་དང་ང་ཚོའི་ས་ཆ་སྲུང་ཐབས་བྱས་པ་ཡིན།",
    "ཡིན་ན་ཡང་ང་ཚོས་རྒྱ་མི་ལ་ཕར་རྒོལ་བྱས་མེད།",
    "ཉིན་མོའི་སྐབས་དང་ཐ་ན་མཚན་མོའི་ཚེ་ཡང་ཁོང་ཚོས་དགའ་སྤྲོའི་གླུ་དབྱངས་ལེན་པ་དང་འདོན་པ་དབྱངས་སུ་གྱེར་པ་རྣམས་གོ་ཐུབ་ཅིང་།",
    "ད་ནི་གལ་སྲིད་ཁོང་ཚོས་ཞི་བའི་བཅིངས་འགྲོལ་ཐོབ་འདོད་ན།",
    "བོད་མི་ཚོས་ངེས་པར་དུ་བཙན་རྒྱལ་རིང་ལུགས་པ་མཐར་སྐྲོད་གཏོང་དགོས་པ་དང་མེས་རྒྱལ་ཁྱིམ་ཚང་ཆེན་པོའི་པང་དུ་ལོག་དགོས་པ་ཧ་གོ་ཡོད་པ་རེད།་",
    "ཁོང་ཚོས་མའོ་ཙེ་ཏུང་གི་འོད་ཟེར་དེ་མགྱོགས་མྱུར་ལྷ་ས་དང་བོད་ཡོངས་སུ་འཕྲོ་བའི་རེ་བ་བྱས་པ་རེད།",
    "མའོ་ཙེ་ཏུང་གི་འོད་ཟེར་ཡོད་མེད་གང་ཡིན་ཡང་།",
    "དེ་ནས་ཕྱི་ལོགས་ཀྱི་འབྲེལ་ལམ་བཅད་པ་རེད།",
    "མཐའ་མ་དེར་ཁོ་རང་དང་ཁོ་རང་གི་ལས་ཞབས་སུམ་ཅུ་སོ་དྲུག་ཚོར་ལྷ་ས་ལ་འབྲེལ་བ་བྱེད་དུ་བཅུག་སྐབས།",
    "རྒྱ་མི་རྣམས་དགྲ་བོ་མ་རེད།",
    "གལ་སྲིད་དགྲ་བོ་ཡིན་ན་ཡང་ཁོ་ཚོའི་དམག་མིའི་སྟོབས་ཤུགས་སྣང་མེད་དུ་བྱེད་པ་ནི་ཆུད་ཟོས་ཀྱི་རང་བཞིན་ཞིག་རེད།",
    "རྒྱ་མིས་དངོས་གནས་འདོད་པ་ནི་གྲོས་མཐུན་ཞིག་རེད།",
    "བོད་མི་ཚོས་མིང་རྟགས་བརྒྱབ་པའི་ཞི་བའི་གྲོས་མཐུན་ཞིག་རེད་ལ།",
    "ཞེས་འཁོད་རྒྱུ་དེ་རེད།",
    "ཅེས་པ་དེ་རེད།",
    "བཀའ་ཤག་གིས་དེ་ཁས་ལེན་བྱེད་ཀྱི་མེད།",
    "གྲོས་མཐུན་ཡོད་མེད་ལ་མ་ལྟོས་པར་བཅིངས་འགྲོལ་དམག་ནུབ་ཏུ་རྒྱལ་སའི་ཕྱོགས་སུ་ཡོང་རྒྱུ་བཀག་པའི་རྒྱུ་རྐྱེན་དེ་ག་རེ་རེད།",
    "བཀའ་ཤག་གིས་རྒྱུན་ལྡན་མིན་པའི་མགྱོགས་མྱུར་གྱི་བྱེད་ཕྱོགས་ཤིག་བཙལ་པ་རེད།",
    "པོ་ཏ་ལའི་མཛོད་ཁང་ནས་གསེར་དངུལ་ཕོན་ཆེ་དབོར་འདྲེན་བྱེད་རྒྱུ་ནི་ཐོག་མའི་ལས་དོན་གྱི་བཀའ་རྒྱ་དེ་རེད།",
    "དེ་ནི་སྡོད་གནས་སྟོང་པ་བཟོས་པ་ཞིག་རེད།",
    "གཞུང་གི་ལྷག་མ་ཙམ་ཞིག་རྒྱལ་སའི་ནང་སྡོད་རྒྱུ་ཡིན་པ་རེད།",
    "བཀའ་ཤག་གིས་འབྲེལ་ལམ་རྣམས་མི་གཅོད་རྒྱུའི་ཐག་གཅོད་བྱས།",
    "སྐུ་དྲག་ཚོས་རང་གི་འགྲུལ་སྒམ་བརྒྱངས་བཞིན་པའི་སྐབས་དེ་དག་ཏུ་ང་ཕོད་ཀྱི་ཡིག་འབྲེལ་རྣམས་ལྷ་ས་ལ་འབྱོར་བཞིན་བསྡད་པ་རེད།",
    "དེའི་མཇུག་འབྲས་གང་འདྲ་ཡོང་གི་རེད།",
    "ང་ཕོད་ཀྱིས་ཞི་མོལ་གཙོ་འཛིན་པ་བྱེད་རྒྱུ་ཡིན་ཟེར་བ་དེ་ལ་མཚོན་ན་དོན་དག་ཁ་གསལ་ཞིག་རེད།",
    "བོད་གཞུང་གི་མི་སུ་གཅིག་གིས་ཀྱང་གཙོ་འཛིན་གྱི་འགན་དེ་འཁྱེར་འདོད་བྱེད་ཀྱི་མེད།",
    "དེ་ནི་ལྷ་སའི་ལས་བྱེད་ཡོངས་ཀྱིས་བསམས་པ་དེ་རེད།",
    "རྒྱ་ཡིས་བཙན་འཛུལ་མ་བྱས་གོང་དུ་བོད་ནི་ཧ་ལམ་ཁེར་རྐྱང་གི་རྒྱལ་ཁབ་ཕུན་སུམ་ཚོགས་པ་ཞིག་ཡིན་ལ།",
    "ཆབ་སྲིད་ཀྱི་སྣེ་མོ་འཛིན་མཁན་ཚོའི་ཁྲོད་དུ་ཕྱི་རྒྱལ་ལ་གོམ་པ་བརྒྱབ་མྱོང་མཁན་ནི་མི་གྲངས་བཅུ་ལས་ཉུང་གི་རེད།",
    "ཨ་མི་རི་ཀ་ཡང་ལས་སླ་པོར་ཁུ་སིམ་མེར་མ་བསྡད།",
    "ད་དུང་ང་ཚོས་ཡིད་ཆེས་པ་ཞིག་ལ།",
    "བོད་དེ་རང་བཙན་གྱི་རྒྱལ་ཁབ་ཅིག་ཡིན་པའི་ངོས་འཛིན་བྱེད་རྒྱུ་ལ་ཆབ་སྲིད་ཀྱི་ཁག་ཐེག་དང་དགོངས་བཞེས་སྤྲད་ཐུབ་པ་ཞིག་རེད།",
    "དབྱིན་ཇིའི་གཞུང་ཤུགས་དྲག་གིས་རྒྱ་གར་གྱི་རྒྱབ་ཏུ་ལངས་ནས་གཡོ་འགུལ་མེད་པར་བསྡད།",
    "མཐར་ཨ་མི་རི་ཀས་དབྱིན་རྒྱའི་བག་ལ་ཉལ་གྱི་ཁ་ཕྱོགས་འདིའི་ནང་།",
    "ཡང་བསྐྱར་རང་ཉིད་མི་འདོད་བཞིན་དལ་འགྲོས་བྱེད་དགོས་བྱུང་བ་རེད།",
    "བོད་ལྟ་བུའི་རེ་བ་མེད་པའི་རྒྱལ་ཁབ་ལ་སྲུང་སྐྱོབ་མི་བྱེད་ན།",
    "མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ཅི་ཞིག་གི་ཆེད་དུ་རེད།",
    "ལེཀ་སེག་སེ་སི་ཡི་རྟོགས་དཀའ་བའི་འཕྲུལ་འཁོར་དེས་ལོ་ན་བཅུ་གྲངས་ལ་སོན་པའི་དབུ་འཁྲིད་འདི་འུ་ཐུག་བཅུག་མེད་ནའང་ཐུགས་སྐྱོ་བཅུག་ཡོད་པ་རེད།",
    "རྒྱ་གར་གཞུང་གི་སྐུ་ཚབ་ཀྱི་རྣམ་འགྱུར་དེ་ཚོ་ཡང་དེ་མཚུངས་ཀྱིས་སེམས་སྐྱོ་བ་ཞིག་རེད།",
    "དེ་ནི་སྔོན་མ་སུ་གཅིག་གིས་ཀྱང་ང་ཚོར་དམག་དོན་གྱི་རོགས་རམ་བྱེད་ཀྱི་མི་འདུག་ཟེར་བ་ལས་ཀྱང་ཆེས་ཡིད་སེམས་སྐྱོ་བ་ཞིག་རེད།",
    "ད་ནི་ང་ཚོའི་གྲོགས་པོ་ཚོས་ཐ་ན་ང་ཚོས་རང་གི་བདེ་སྡུག་སྙན་སེང་ཞུ་བ་ལ་ཡང་རོགས་པ་བྱེད་ཀྱི་མེད་པ་རེད།",
    "ང་ཚོས་ང་ཚོ་ནི་རྒྱ་ནག་གི་དམག་དཔུང་འབོར་ཆེན་ཚོའི་ཆེད་དུ་གཡུགས་བཞག་པ་ཞིག་ཚོར་བྱུང་།",
    "བོད་ཀྱིས་ལེ་ཀ་སེལ་སེག་སི་ལ་སྐུ་ཚབ་གཏོང་རྒྱུའི་འཆར་གཞི་དེ་ཕྱིར་འཐེན་བྱས་པ་རེད།",
    "རང་གི་འདམ་ཁ་ཉག་གཅིག་ནི་གུང་ཁྲན་ཏང་དང་མཉམ་དུ་ཞི་མོལ་བྱེད་རྒྱུ་དེ་ཡིན་པ་མཐོང་བ་རེད།",
    "ང་ཕོད་ཞི་མོལ་གྱི་གཙོ་འཛིན་དུ་འདམས་པ་རེད།",
    "སྔོན་མ་ཇི་བྱུང་བཞིན་རྒྱ་ནག་གི་རོགས་རམ་འཚོལ་རྒྱུའི་མོས་མཐུན་ཡོད་པ།",
    "བཀའ་ཤག་གིས་དགོས་འདུན་འདི་ཚོ་ཡིག་ཐོག་ཏུ་བཀོད་པ་ཇི་བཞིན་རྒྱ་མི་རྣམས་ཀྱིས་བསྐྱར་མོལ་བྱས་ཏེ་ཚུར་སྤྲོད་བྱེད་རྒྱུ་ཡིན་པའི་ཡིད་ཆེས་ཤིག་བྱེད་ཀྱི་ཡོད་དམ།",
    "གཅིག་བྱས་ན་བཀའ་ཤག་གིས་ཁོ་ཚོ་ཡ་ཏུང་དུ་བྲོས་བྱོལ་གཙང་ཟིན་མ་བྱས་བར་དུ་དུས་ཚོད་འགོར་འགྱངས་སུ་གཏོང་བ་ཙམ་ཞིག་ཡིན།",
    "བཀའ་ཤག་གིས་སྐུ་ཚབ་གཉིས་ཀྱི་ལག་ཏུ་ང་ཕོད་ལ་སྒེར་གྱི་ཡི་གེ་ཞིག་བཏང་དེའི་ནང་གསང་བརྡ་ལྟ་བུ་གང་ཡང་མེད་དེ།",
    "སྲང་ལམ་དུ་ཟིང་ཆ་མི་སློང་ཆེད་ཁོང་དང་ཁོང་གི་སྐུ་ཞབས་ཚོ་མཚན་མོར་ཐོན།",
    "འགྲུལ་པ་རྣམས་ལྷོ་ཕྱོགས་སུ་བསྐྱོད་རིམ་བཞིན་མཐོ་སྒང་ཁྱོན་ཡོངས་སུ་ཁ་བ་བུ་ཡུག་འཚུབ།",
    "༡༩༥༡ ཟླ་བ་༡ ཚེས་༧ཉིན་ཁོང་ཚོ་ཡ་ཏུང་ལ་འབྱོར།",
    "ལོ་ན་བཅུ་གྲངས་ལ་སོན་པ་དེས་ཉི་མ་གཅིག་གི་དུས་ཚོད་མང་ཆེ་བ་སྒོམ་གྱི་ནང་བསྐྱལ།",
    "ཡིན་ན་ཡང་ཁོའི་གཟིམས་ཤག་གི་ཕྱི་རོལ་དེར་གཞུང་ཞབས་ཚོ་ནི་ཁ་མ་འཆམ་པ་ཤུགས་དྲག་པོ་ཞིག་དང་བཅས་གསོན་པོར་བསྡད་ཡོད།",
    "དེ་ནི་ས་མཚམས་བརྒལ་ནས་སོང་ན་བཙན་བྱོལ་ལ་འགྲོ་རྒྱུ་དེ་རེད་ཟེར།",
    "ཞྭ་སྒབ་པ་འབྱོར་དུས་ཁོའི་ཞུ་བྱ་ནི་རེ་བ་བྲལ་བ་ཞིག་རེད།",
    "ནེཧ་རུ་ནི་བོད་ལས་རྒྱ་ནག་རང་གི་གྲོགས་པོ་བྱེད་འདོད་ཆེན་པོ་ཡོད་པ་རེད་ཅེས་ཞུས་པ་རེད།",
    "དེ་ནི་དེ་འདྲའི་ལས་སླ་པོ་ཞིག་རེད།",
    "ཡ་ཏུང་ལ་དགུན་ཁ་དེར་རེ་བའི་འོད་ཟེར་གཅིག་སླེབས་པར་གྱུར།",
    "དམིགས་བསལ་བོད་ནང་བཙན་འཛུལ་ལ་འགོག་རྒོལ་བྱས་པའི་བདེན་དཔང་ཡོད་སྟབས་བོད་ལ་དངོས་པོའི་རོགས་སྐྱོར་བྱེད་རྒྱུའི་འདོད་པ་ཡོད་ཅེས་འཁོད་ཡོད་པ་རེད།",
    "ཨ་རིའི་ལས་བྱེད་ཚོས་དེའི་ལན་ལ་རེ་སྒུག་བྱས།",
    "ལན་དེ་རྩ་ནས་མ་ཡོང་བ་རེད།",
    "བོད་མི་ཚོས་ལན་མ་བརྒྱབ་པ་རེད།",
    "གང་ཡིན་ཟེར་ན་ཁོང་ཚོས་ལན་རྒྱག་སྟངས་ཤེས་ཀྱི་མེད་པ་རེད།",
    "མ་མཐའ་ལ་ཡང་མགྲིན་གཅིག་དབྱངས་གཅིག་གིས་ཤེས་ཀྱི་མེད་པ་རེད།",
    "ཁོང་རྒྱ་གར་ལ་ཕེབས་རྒྱུ་རེད་ཟེར་བའི་སྐད་ཆ་དེ་ཚོ་ག་རེ་རེད།",
    "བར་ཆད་ཆེ་བ་དེ་ཡོད་པ་རེད།",
    "ཞི་མོལ་གྱི་ས་ཆ་བརྗེས་ནས་པེ་ཅིན་ལ་འགྲོ་རྒྱུ་རེད།",
    "དེའི་མཇུག་འབྲས་ནི་ཧ་ཅང་གི་ཡིད་མུག་པ་ཞིག་རེད།",
    "གྲོས་མཐུན་གནས་སྟངས་ཡོངས་རྫོགས་ཐག་ཇེ་རིང་དུ་སོང་ནས་ནམ་མཁའི་མཐའ་ལ་སླེབས་ཀྱི་ཡོད་པའི་སྣང་བ་བྱུང་ཞིང་།",
    "གཞི་རྩར་འཛིན་དགོས་པའི་མི་མང་ནས་ཕར་གྱེས་པ་རེད།",
    "བསྟུན་དཀའ་བའི་གཞུང་གི་འགོག་རྐྱེན་དང་ལྷན་དུ།",
    "༧གོང་ས་མཆོག་གིས་ཡང་བསྐྱར་ང་ཕོད་ལ་སྐུ་སྒེར་གྱི་ཕྱག་ཡིག་ཅིག་བསྩལ་ཏེ།",
    "བཅིངས་འགྲོལ་དམག་གི་སྐོར་སྲུང་དམ་པོའི་ངང་ང་ཕོད་དང་ཁོའི་ལས་རོགས་དྲུག་དེ་ཟླ་བ་བཞི་པའི་བདུན་ཕྲག་གསུམ་པའི་ནང་པེ་ཅིན་ལ་འབྱོར་པ་རེད།",
    "ཁོས་རང་གི་ལས་རོགས་ཚོར་སྐུ་ཚབ་ཚོས་ཡ་ཏུང་ལ་གནས་ཚུལ་གལ་ཆེའི་རིགས་ཡར་ཞུ་བྱེད་མི་དགོས་མོད།",
    "ང་ཕོད་ཀྱིས་ཁོ་ཚོ་ལ་ཁས་ལེན་བྱས་པ་རེད།",
    "ཉི་ཧོང་གི་གཞུང་ཚབ་ཁང་རྙིང་པའི་ཚོགས་ཁང་རིང་མོ་ཞིག་གི་ནང་དུ་ཞི་མོལ་དེ་འཚོགས་ཤིང་།",
    "འབོལ་གདན་རིང་པོ་གྲལ་སྒྲིག་པ་ཞིག་གི་ཐོག་རྒྱ་བོད་གཉིས་ཁ་གཏད་དུ་བསྡད།",
    "ཏང་གི་དུས་ཚོད་འཕྲོ་བརླག་ལ་མི་གཏོང་རྒྱུ།",
    "དེ་ནས་འདི་ཞི་མོལ་ཟེར་བ་དེའི་དབུ་འབྱེད་ཀྱི་ཉིན་མོ་དེ་རེད།",
    "ཧ་རཱར་ནི་ཡ་ཏུང་ནས་ལྡི་ལི་ལ་འབྱོར་པ་རེད།",
    "འདི་ནི་༧གོང་ས་མཆོག་ལ་ཐད་ཀར་འབྲེལ་བ་མགོ་འཛུགས་རྒྱུའི་དུས་ཚོད་ཏག་ཏག་ཅིག་རེད་བསམས་པ་རེད།",
    "འཛམ་གླིང་གནས་སྟངས་ཀྱི་འགྱུར་བ་དག་གིས་རྒྱ་ནག་དམར་ཤོག་གིས་བོད་ས་འཛིན་རྒྱུ་དཀའ་ལས་ཁག་པོ་ཞིག་མ་བཟོས་པ་དེ་སྲིད་དུ།",
    "རྒྱུ་ནོར་གང་ཞིག་ལྷ་ས་ལ་ཕྱིར་གཏོང་བྱས་ཡོད་ན་མཐའ་མཇུག་དེར་རྒྱ་ནག་དམར་ཤོག་གིས་བདག་འཛིན་བྱེད་ཀྱི་རེད།",
    "ལྷ་ས་རྒྱ་ནག་དམར་ཤོག་གི་ལག་པར་ཤོར་སྲིད་པའི་གཡོ་སྒྱུའམ་དམག་དཔུང་གི་ཉེན་ཁ་ཡོད་བཞིན་དུ་༧གོང་ས་མཆོག་ལྷ་ས་ལ་ཕྱིར་ཕེབས་རྒྱུ་ཡོད་པ་མ་རེད།",
    "གལ་སྲིད་རྒྱ་ནག་དམར་ཤོག་པས་ཁོང་གི་བྲོས་བྱོལ་ལ་འགོག་རྐྱེན་བྱེད་པ་ལྟ་བུ་མཐོང་ཚེ།",
    "༧གོང་ས་མཆོག་གིས་སེ་ལོན་ལ་སྐུ་ཚབ་ཐེངས་གཅིག་གཏོང་འཐུས་ཞེས་བསམ་འཆར་འབུལ་གྱིན་ཡོད།",
    "སྐུ་ཚབ་འདི་ཚོས་སེ་ལོན་གཞུང་དང་གོ་བསྡུར་གྱིས་༧གོང་ས་མཆོག་གི་རྒྱུ་ནོར་རྣམས་འཕྲལ་མྱུར་སེ་ལོན་ལ་དབོར་འདྲེན་ཡོང་ཐབས་བྱེད་དགོས།",
    "སྐུ་ཚབ་འདི་ཚོས་ད་དུང་གལ་སྲིད་༧གོང་ས་མཆོག་གིས་བོད་བཞག་ནས་ཕེབས་དགོས་ཤར་ཚེ་སེ་ལོན་དུ་༧གོང་ས་མཆོག་དང་ཁོང་གི་ནང་མི་ལ་སྐྱབས་བཅོལ་ཡོང་བའི་ཆོག་མཆན་རག་ཐབས་བྱེད་དགོས།",
    "སེ་ལོན་གཞུང་གིས་སྐྱབས་བཅོལ་གྱི་ཆོག་མཆན་བླངས་ཟིན་པའི་རྗེས་སུ་རྒྱ་གར་གཞུང་ལ་གལ་སྲིད་ཁོང་དང་ཁོང་གི་ནང་མི་རྣམས་བོད་ནས་ཐོན་དགོས་བྱུང་དུས་རྒྱ་གར་བརྒྱུད་དེ་སེ་ལོན་དུ་འགྲོ་ཆོག་པའི་འགན་ལེན་གནང་རོགས་ཞུ་དགོས།",
    "གལ་སྲིད་༧གོང་ས་མཆོག་དང་ཁོང་གི་ནང་མིར་སེ་ལོན་རྒྱལ་ཁབ་ཏུ་སྐྱབས་བཅོལ་བརྟན་པོ་ཞིག་མ་ཐོབ་ན།",
    "ཁོང་ལ་གོ་ལའི་ནུབ་ཕྱོགས་ཀྱི་གྲོགས་པོའི་རྒྱལ་ཁབ་གཞན་པ་ཚོའི་ནང་ཏན་ཏན་སྐྱབས་བཅོལ་ཞུ་ས་ཞིག་རག་གི་རེད་ལ།",
    "དེའི་ནང་ཨ་མི་རི་ཀ་ཡང་ཚུད་ཡོད།",
    "བྱིས་པ་འདིའི་ཕྱོགས་གཉིས་ལས་ཐོག་མར་གང་འདེམས་དཀའ་བ་དེ་འདྲའི་སྐབས་སུ་འགུག་ཐབས་བྱེད་པ་ཡང་མ་འོས་པ་ཞིག་མ་རེད།",
    "ཕྱོགས་གཅིག་སྟེ་ཨ་མི་རི་ཀ་ཡིས་ཁོང་བྲོས་བྱོལ་དུ་ཤོག་ཟེར་གྱི་ཡོད་ལ།",
    "ཕྱོགས་གཞན་པ་རྒྱ་ནག་གིས་འགུག་ཐབས་སྤྱད་ནས་མགོ་སྐོར་འོག་ཚུད་པའི་རེ་བ་བྱེད་ཀྱི་ཡོད་ལ།",
    "དེ་ལྟར་མ་བྱུང་ཕྱིན་བཙན་ཤེད་ཀྱིས་གཉེན་སྒྲིག་བྱེད་པ་ནི་ཡོད་ཡོད་ཡིན་པ་རེད།",
    "ཤིན་ཏུ་ནས་མ་རུངས་པ་ཞིག་རེད།",
    "མ་མཐའ་ལ་ཡང་དེ་ནི་ཤེས་ཟིན་པའི་ལྐོག་བྱུས་ཤིག་རེད།",
    "༧གོང་ས་མཆོག་གིས་ཨ་རིས་དགའ་རོགས་བྱེད་པ་འདིའི་རྒྱབ་ཀྱི་ཀུན་སློང་གི་སྐོར་ལ་དངོས་གནས་ཅི་ཞིག་མཁྱེན་གྱི་ཡོད་དམ།",
    "ཤོག་གུའི་སྟེང་ལས་རྟགས་མེད་པ་དང་ཤོག་གུའི་འགབ་ཏུ་མིང་རྟགས་བརྒྱབ་མེད་པ་ཨ་མི་རི་ཀས་ཡི་གེ་དེ་འབྱོར་ས་ནོར་པ་ཡིན་ན་དགོས་པའི་སྔོན་ཚུད་ཀྱི་གཟབ་གཟབ་བྱས་པ་རེད།",
    "མི་ཚང་མས་པེ་ཅིན་གྱི་ཞི་མོལ་དེ་ཟླ་བ་མང་པོར་འགོར་རྒྱུ་དང་།",
    "ད་དུང་ང་ཕོད་ཀྱིས་བོད་ཀྱི་རྒྱལ་ཁབ་ལ་ཁེ་ཕན་གཏན་ནས་མེད་པ་མ་ཡིན་པའི་གྲོས་མཐུན་ཞིག་འབྱིན་ཐུབ་སྲིད་པའི་གོ་སྐབས་ཡོད་པ་རེད་ཅེས་བསམས་པ་རེད།",
    "གལ་སྲིད་ཞི་མོལ་ལ་ལམ་ལྷོང་མ་བྱུང་བ་ཡིན་ནའང་།",
    "ད་ལྟའི་ཆ་ལ་པེ་ཅིན་དུ་ཞི་མོལ་འགྲོ་བཞིན་ཡོད།",
    "གལ་སྲིད་ཞི་མོལ་དེ་འཐོར་པ་ཡིན་ན་ཁོང་གིས་ཨ་མི་རི་ཀས་གང་ཡོང་ཅི་ཡོང་གིས་རོགས་པ་བྱེད་པའིརེ་བ་དང་བཅས་ཧེན་ཌེར་སོན་ལ་འབྲེལ་བ་བྱེད་རྒྱུ་ཡིན་ཞེས་འཁོད་ཡོད་པ་རེད།",
    "པེ་ཅིན་ན་ཅི་ཞིག་བྱེད་ཀྱིན་ཡོད་མེད་ཐད་ཁོང་གིས་ཅི་ཡང་ཤེས་ཀྱི་མེད།",
    "ཡ་ཏུང་ན་ཡོད་པའི་འཕྲལ་སེལ་གཞུང་གིས་ཞི་མོལ་མགོ་འཛུགས་བྱས་པ་ནས་བཟུང་ང་ཕོད་ནས་ཚིག་གཅིག་ཀྱང་ཐོས་མེད།",
    "པེ་ཅིན་དུ་ཞི་མོལ་ཕར་བཞག་མཐའ་ན་བགྲོ་གླེང་ཙམ་གྱི་རྣམ་པ་ཞིག་ཀྱང་ཡོང་གི་མེད།",
    "ང་ཚོར་ཁོང་ཁྲོ་མ་སློང་ཟེར་བ་སོགས།",
    "བོད་མིའི་སྐུ་ཚབ་རྣམས་ཀྱིས་ངོས་ལེན་ཏག་ཏག་ཅིག་ལ་འབབ་ཆེད་རྐང་བཙུགས་ནས་བཟོས་པའི་ཚིག་ངན་བཅས་རེད།",
    "ཁོ་ཚོའི་སྒེར་གྱི་ཐོག་ཐུབ་ཚོད་དང་བོད་མི་མང་གི་ཐོག་དམག་ཤུགས་སྤྱོད་རྒྱུ་ཡིན་ཞེས་དམའ་འབེབས་དང་བརྙས་བཅོས།",
    "ཉེན་བརྡ་བཏང་བ་རེད།་",
    "ཅོག་ཙེའི་སྟེང་དུ་འཆར་ཟིན་ཡོད་མ་རེད།",
    "ཚིག་འབྲུ་ལ་བསྐྱར་བཅོས་བྱས་ཏེ་དུས་ཚོད་འཕྲོ་བརླག་ལ་གཏོང་དགོས་དོན་ཡོད་མ་རེད།",
    "མའོ་ཙེ་ཏུང་གི་འོད་ཟེར་དེ་ཁོང་ཚོའི་ཐོག་འཕྲོ་གི་རེད།",
    "བོད་ཀྱིས་བཙན་རྒྱལ་རིང་ལུགས་པའི་བཙན་ཤུགས་བོད་ཀྱི་ས་མཚམས་ནས་མཐར་སྐྲོད་གཏོང་རྒྱུ་དང་མེས་རྒྱལ་ཁྱིམ་ཚང་ཆེན་མོའི་ནང་སླར་ལོག་རྒྱུ།",
    "གུང་ཁྲན་ཏང་གིས་ད་ཡོད་བོད་ཀྱི་ཆབ་སྲིད་ལམ་ལུགས་ལ་བསྒྱུར་བཅོས་མི་གཏོང་རྒྱུ་དང་།",
    "ཆིག་སྒྲིལ་མེད་པ་དེ་ནི་དམར་ཤོག་གིས་ཆ་ཚང་བར་བེད་སྤྱོད་བྱེད་རྒྱུའི་འདུན་པ་ཡོད་པ་རེད།",
    "༧རྒྱལ་བ་པཎ་ཆེན་ཟུང་གི་གོ་གནས་དེ་ནི་སྐུ་གོང་མ་དག་གི་སྐབས་སུ་བྱུང་བའི་བཟང་སྒང་གི་འབྲེལ་བ་ཚུར་མངོན་བྱེད་དགོས་པ་ཞིག་ཡིན།",
    "གུང་ཁྲན་ཏང་གིས་བོད་ཀྱི་ཕལ་སྐད་དང་ཡིག་སྐད།",
    "གུང་ཁྲན་ཏང་གིས་བོད་མིའི་ཞིང་ལས་དང་བཟོ་ལས།",
    "བཅོས་བསྒྱུར་གྱི་ངོ་བོ་ནི་རྒྱ་མིས་གང་འདོད་ཅིག་ལས་བོད་མི་མང་ཆེ་བས་གང་འདོད་པ་དེ་ཡོང་གི་མ་རེད།",
    "ད་དུང་བོད་མི་ཚོ་འདི་ལྟར་ཆགས་ཀྱི་རེད།",
    "བོད་མི་ཚོ་ནི་ད་ཆ་བོད་མི་ཙམ་ཞིག་མ་རེད།",
    "ལྷ་སའི་གཞུང་གིས་བཅིངས་འགྲོལ་དམག་ལ་ཟས་རིགས་དང་ཕྱུགས་ཟས།",
    "དེ་བཞིན་གྱི་ཉིན་རེའི་དགོས་མཁོ་རྣམས་ཉོ་རོགས་དང་དབོར་རོགས་བྱེད་རྒྱུ།",
    "ང་ཕོད་དང་ཁོའི་ལས་རོགས་ཚོས་༡༩༥༡ ཟླ་༥ ཚེས་༢༣ ཉིན་གྲོས་མཐུན་ལ་མིང་རྟགས་བརྒྱབ་པ་རེད།",
    "རྒྱ་མིས་བོད་མིའི་སྐུ་ཚབ་ཚོར་རང་རང་གི་མིང་རྟགས་འཁོད་ས་དེར་རང་རང་གི་དམ་ཕྲུག་རྒྱག་དགོས་ཞེས་བཀའ་བཏང་དུས་བོད་མི་ཚོས་ཁོང་ཚོས་དམ་ཕྲུག་འཁྱེར་མེད་ཅེས་ལན་བརྒྱབ་པ་རེད།",
    "ང་ཕོད་ཀྱིས་མའོ་ཙེ་ཏུང་ལ་ཐུག་འཕྲད་བྱས་པ་རེད།",
    "དེ་ནི་རྒྱུན་ལྡན་གྱི་གུང་ཁྲན་ཏང་གི་ཁ་གཡང་དུ་ཡོད་པའི་གཏམ་སྙན་དག་གིས་ཁེངས་ཡོད་པ་ཞིག་རེད།",
    "དེ་རིང་ང་ཚོས་ཀྲུང་དབྱང་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་དང་ཀྲུའུ་ཞི་མའོ་ཙེ་ཏུང་གི་དབུ་འཁྲིད་འོག་ཆིག་སྒྲིལ་དང་རྒྱལ་ཡོངས་ཀྱི་མི་རིགས་ཚང་མ་མཉམ་འབྲེལ་བྱས་པ་ཁོ་ན་བརྒྱུད།",
    "ང་ཚོས་ང་ཚོའི་ཐུན་མོང་གི་དགྲ་དྲག་པོ་བཙན་རྒྱལ་རིང་ལུགས་པའི་བཙན་ཤེད་མཐར་སྐྲོད་གཏོང་ཐུབ་པ་དང་།",
    "དེ་ནི་འགྲམ་པ་ཐང་དུ་ལྷུང་ངེས་པའི་ཡ་མཚན་ཅན་གྱི་ཕྱིར་བསྒྲགས་ཤིག་རེད།",
    "མའོ་ཡིས་ཧ་ཅང་མཁས་པའི་རྒྱལ་ཁ་ཞིག་བླངས་པ་རེད།",
    "དེ་ནི་རང་གིས་ཇི་ཙམ་དགོས་འདོད་ན་དེ་ཙམ་གྱི་བཅིངས་འགྲོལ་དམག་བོད་དུ་བཏང་ཆོག་གི་རེད།",
    "བོད་འདིས་གཞུང་འབྲེལ་གྱིས་རྒྱ་ནག་གི་ཆ་ཤས་ཤིག་བྱེད་རྒྱུའི་མོས་མཐུན་བྱས་པ་རེད་ཅེས་མཇུག་སྡོམ་རྒྱག་གི་རེད།",
    "བོད་ཀྱི་ལྷོ་མཐའ་འདིར་ད་ནི་དབྱར་སྟོད་རེད།",
    "གོམ་པ་བརྒྱ་ཕྲག་ཁ་ཤས་ཤིག་སོང་ན་ཉི་མ་བཞག་ནས་ལྡིང་བའི་ཆུ་སྤྲིན་གྱིས་གཡོགས་པའི་གནམ་སྔོན་པའི་འོག་ཏུ་ལམ་ཆུང་དེ་ཇེ་མཐོར་སོང་འདུག་ལམ་ཆུང་དེ་རྒྱུགས་ཆུ་ཞིག་གི་རྗེས་སུ་སོང་བ་དེ་ལྕང་སྡོང་དག་གིས་སྲུང་ཡོད་ཅིང་།",
    "དེའི་ཕ་རོལ་དེར་རྡོ་ཕ་བོང་གི་ཚོགས་ཤིག་འདུག་ལ།",
    "རི་སྐྱེས་ཀྱི་འབྲོང་སིལ་གྱི་ཕུང་ཚོགས་དང་།",
    "ཁོང་གིས་རང་གི་སྒེའུ་ཁུང་ནས་མར་གཟིགས་ཏེ་ཧ་ལས།",
    "ང་ཚོས་དེའི་ཆ་རྐྱེན་ཁག་གོ་དུས་ཧ་ཅང་ཡ་མཚན་པོ་བྱུང་།",
    "གུང་ཁྲན་ཏང་གི་ཁ་གཡང་སྣ་ཚོགས་པ་དང་།",
    "ཆ་རྐྱེན་རྣམས་ཧ་ཅང་ཐབས་སྡུག་པོ་དང་ང་ཚོའི་བསམ་ཡུལ་ལ་ཡོད་པ་ཚང་མ་ལས་གདུག་རྩུབ་ཆེ་བ་ཞིག་རེད།",
    "ཁོང་གིས་གྲོས་མཐུན་ལ་ངོ་རྒོལ་བྱེད་དགོས་སམ།",
    "གལ་སྲིད་ཁོང་གིས་དེ་ལྟར་གནང་ན་མཇུག་འབྲས་ག་རེ་ཡོང་གི་རེད།",
    "ལྷག་མའི་འཛམ་གླིང་གིས་ཁོང་ལ་ཡིད་ཆེས་བྱེད་ཀྱི་རེད་དམ།",
    "གུང་ཁྲན་གྱི་དམག་མིས་གཏོར་བཅོམ་བྱེད་ཀྱི་རེད་དམ།",
    "ཡིན་ན་ཡང་རྒྱ་གར་ནི་ཉིན་མ་གཅིག་གི་རྟ་ལམ་རེད།",
    "མ་མཐའ་ལ་ཡང་ཨ་མི་རི་ཀའི་བསམ་ཚུལ་ལ།",
    "ཁོའི་སྤུན་ཆུང་བ་བོད་ནས་ཐོན་དགོས་པའི་སྐུལ་མ་བྱས་པ་རེད།",
    "ཁོང་གིས་ཨ་མི་རི་ཀ་ནས་སྐྱབས་བཅོལ་ཡོང་རྒྱུ་ལ་ཐུགས་འདོད་གནང་གི་རེད།",
    "གནོད་བསྐྱལ་བཅུག་ཨ་མི་རི་ཀས་ནི་དམར་ཤོག་བཙན་འཛུལ་གང་ན་ཡོད་ན་ཡང་དེ་ལ་ཁ་གཏད་གཅོག་རྒྱུའི་དམ་བཅའ་བྱས་ཡོད་ལ།",
    "དེའི་གོ་དོན་ནི་རང་གི་སྐད་ཆ་དོན་ཐོག་ལ་གནས་རྒྱུ་དེ་རེད།",
    "ཨ་མི་རི་ཀའི་འགྱུར་བཅོས་བཏང་བའི་ལངས་ཕྱོགས་དེ་དབྱིན་ཇི་དང་རྒྱ་གར་གྱི་ཁྲོ་གཉེར་དང་མཐུན་པར་གྱུར།",
    "བོད་ཀྱིས་རྒྱ་གར་གཞུང་ནས་མཛའ་བརྩེ་ཆེན་པོ་ཞིག་ཐོབ་རེ་བྱེད་རྒྱུ་ཁག་པོ་རེད།",
    "ཁོས་ལས་དོན་འདིའི་ཁྱོན་ཡོངས་ཀྱི་རང་གི་ལག་པ་དེ་བཀྲུ་འདོད་ཡོད་པའི་རྣམ་འགྱུར་བསྟན་པ་རེད།",
    "པེ་ཅིན་ཏུ་ཡོད་པའི་བོད་མིའི་སྐུ་ཚབ་རྣམས་ཟླ་དྲུག་པའི་ཟླ་མཇུག་བར་དུ་པེ་ཅིན་དུ་བསྡད་པ་རེད།",
    "ང་ཕོད་རང་གི་རྒྱ་མིའི་ལས་རོགས་གསར་པ་ཚོའི་མཉམ་དུ་པེ་ཅིན་དུ་བསྡད།",
    "བཅིངས་འགྲོལ་དམག་བོད་དབུས་སུ་སླེབས་སྐབས་བཀོད་འདོམས་པ་བྱེད་རྒྱུ་ཡིན་པའི་དམག་སྤྱི་ཀྲང་གིས་སྣེ་འཁྲིད་པའི་རྒྱ་མིའི་སྐུ་ཚབ་ཀ་ལི་ཀ་ཏ་ལ་འཕུར།",
    "སྐབས་དེ་ཙམ་ལ་བོད་མི་ཚོར་ཨ་མི་རི་ཀའི་ལམ་སྟོན་འབྱོར་ཡོད།",
    "བོད་དམག་འགོག་རྒོལ་རུ་ཁག་ལྟ་བུ་ཞིག་ཨ་མི་རི་ཀས་རྒྱབ་གཉེར་བྱས་ཏེགིས་གུང་ཁྲན་ཏང་གིས་བོད་ལ་བཙན་འཛུལ་བྱེད་པ་ལ་རྒོལ་འཛིང་བྱས་ཆོགསྟབས་ཉེས་པ་ཞིག་ལ།",
    "ཁོང་ཚོས་ཕར་འཁྲུག་སློང་མ་བྱས་ན།",
    "གང་ལྟར་ཁོང་གིས་ཐག་གཅོད་གནང་བ་ནི་དམག་སྤྱི་ཀྲང་ཉིན་ཤས་ཀྱི་རྗེས་སུ་ཡ་ཏུང་འབྱོར་ཚར་ནས་མ་གཏོགས་ཇི་བྱེད་ཐད་ཐག་གཅོད་མི་བྱེད་རྒྱུ་དེ་ཡིན་གསུངས་སྐབས།",
    "ཁོང་ཚོས་རང་གི་ལྕེ་ལ་སོ་བཏབ་ནས་སྡོད་རྒྱུ་འཁེལ་བ་རེད།",
    "ཨ་མི་རི་ཀ་དང་གཞན་པ་སུ་ཡིན་གྱི་མཉམ་དུ་མོས་མཐུན་ཞིག་བྱས་ན་དེའི་ནང་དོན་ནི་དམག་རྒྱག་རྒྱུ་རེད།",
    "ཨ་མི་རི་ཀ་ནི་མེལ་ལེ་སྟོང་ཕྲག་ཁ་ཤས་ཀྱི་ཕ་རོལ་ལ་ཡོད་པ་རེད།",
    "མཚམས་འདིར་ཨ་མི་རི་ཀའི་འཕྲིན་ཡིག་མང་བ་དང་ཐ་ན་ཝ་ཤིན་ཊོན་གྱི་འགན་ལེན་ཇེ་གསལ་དུ་བཏང་བའི་ཡི་གེ་ཡ་ཏུང་དུ་འཕངས།",
    "སྐུ་རྟེན་ཁོང་གིས་རྒྱན་གོས་ཆས་ལུགས་ཆ་ཚང་སྤྲས་ནས་ཕེབས།",
    "ཇི་ལྟར་ཁྱེད་རང་གིས་སའི་ཐོག་ཁོང་ཚོའི་སྐུ་ཚབ་ཡིན་པ་ངོས་ལེན་བྱེད་ངེས་ཀྱི་ཐུགས་རེ་གནང་ཐུབ།",
    "ང་ཁོང་ཚོར་ཐུག་འདོད་བྱེད་ཀྱི་མེད།",
    "ཁོས་སྤྱོད་པ་ཇི་འདྲ་ཞིག་སྟོན་གྱི་ཡོད་པ་མི་སུ་ཞིག་གིས་ཀྱང་ཤེས་ཀྱི་མེད།",
    "ཁོ་ཤ་ཞེན་ཅན་ཞིག་ཡིན་རྒྱུ་རེད་དམ་ཡང་ན་བཙན་འཛུལ་བ་ཞིག་གི་ངོ་བོར་ཡོང་གི་རེད།",
    "ངས་ཅི་ཞིག་མཐོང་རེ་བྱེད་ཀྱི་ཡོད་པ་ཏག་ཏག་མི་ཤེས་མོད།",
    "ངས་གང་མཐོང་བ་ནི་མི་གསུམ་གྱིས་གོས་སྐུ་བོའི་ཐོག་དམག་ཞྭ་སྣ་ལེབ་གོན་ཡོད་པ་དེ་རེད།",
    "རེ་བ་མེད་པ་ཞིག་མ་རེད།",
    "རྒྱུན་ལྡན་ནས་དེས་ཁོང་གི་ཐུགས་ཇེ་གསལ་དུ་བཏང་།",
    "ཁོང་ཉོབ་སྣང་ཅན་གྱི་ན་གཞོན་ཞིག་ཇི་བཞིན་འདིར་འབྱོར་པ་རེད།",
    "མི་ཚོས་རང་གི་འཇིག་རྟེན་དུ་གསར་པ་གསར་རྐྱང་ཞིག་སྟེ།",
    "ཟིང་ཆའི་ཀུ་ཅོ་དེ་དག་གྲུབ་རྗེས་བོད་མི་ཚོས་གློག་འཕྲུལ་ཁ་གཡང་གི་བྲོ་བ་ཐོག་མ་དེ་མྱངས།",
    "ང་ཕོད་ཚོགས་ཁང་གི་དཀྱིལ་དུ་སོང་།",
    "ཁོང་ཚོས་དྲིན་ཆེན་ཀྲུའུ་ཞི་མའོ་ཡི་དབུ་འཁྲིད་འོག་ཏུ་མི་རིང་བར་ལོངས་སུ་སྤྱོད་རྒྱུའི་ཡར་རྒྱས་ཀྱི་ཕྲེང་ཚོགས་ལ་བསྔགས་བརྗོད་མི་བྱེད་པ་ཡིན་ནམ།",
    "འདི་ནི་ལྷ་ས་ཡི་གོ་སྐབས་རླབས་ཆེན་ཞིག་རེད་ལ།",
    "མའོ་ཡི་གཏོང་ཕོད་འདི་དག་ངོས་ལེན་མི་བྱེད་པ་ནི་ལྟས་ངན་གོད་ཆག་ཅིག་ཡིན་རྒྱུ་རེད།",
    "འདི་ནི་བོད་དེ་དེང་རབས་ཀྱི་འཇིག་རྟེན་དུ་འཛུལ་རྒྱུའི་དུས་ཚོད་རེད།",
    "མའོ་ཀྲུའུ་ཞིས་ཁོང་ཚོ་ལ་ལམ་ཁ་སྟོན་གྱི་རེད།",
    "ཁོང་ཚོས་ཤོག་གུ་ཟ་ངེ་ཟིང་ངེ་ཞིག་ལ་པེ་ཅིན་ནས་མིང་རྟགས་བརྒྱབ་པ་དེ་ལ་བདག་པོ་ག་རེ་བྱས་ནས་རྒྱག་དགོས་པ་རེད།",
    "གནས་ཚུལ་ལྷག་མ་རྣམས་ནི་འབྲེལ་མེད་དོན་གཞན་རེད།",
    "ཡིད་སྐྱོ་བའི་བདེན་དོན་ཞིག་གང་རེད་ཟེར་ན།",
    "སྒེར་དོན་ཁོག་བཅུག་བྱེད་པའི་ལྷ་སའི་སྐུ་དྲག་ནི་རྒྱུན་ལྡན་ཞིག་ཡིན་པ་ལས་དམིགས་བསལ་བ་ཞིག་མ་རེད།",
    "ཉུང་ཤས་ཤིག་གིས་འཛམ་གླིང་ཕྱི་རོལ་གྱི་གནས་ཚུལ་ལ་སེམས་ཁུར་བྱེད་ལ།",
    "སྒེར་དོན་ཁོག་བཅུག་དེ་ལྷ་སའི་མི་སེར་དཀྱུས་མ་ཚོ་ལ་ཡང་ཡོད་པ་རེད།",
    "ཇི་སྲིད་གུང་ཁྲན་ཏང་གིས་ཁོང་ཚོ་ལ་ལག་པ་མ་འཆང་བ་དེ་སྲིད་དུ་མི་དམངས་བཅིངས་འགྲོལ་དམག་སླེབས་པ་དེས་ཁོ་ཚོ་ལ་བསུན་གཙེར་འཕར་མ་ཞིག་བྱས་མེད་པ་རེད།",
    "ཁོང་ཚོའི་རིག་གཞུང་རྒྱུན་འཛིན་བྱེད་པ་དང་།",
    "ཀྲུའུ་ཞི་མའོ་ཙེ་ཏུང་དང་ཀྲུང་དབྱང་གི་དབུ་འཁྲིད་འོག་ཏུ་ནུས་ཤུགས་ཆེན་པོས་བོད་ནང་གི་མི་དམངས་བཅིངས་འགྲོལ་དམག་ལ་རོགས་རམ་ཞུས་ཏེ་རྒྱལ་ཁབ་ཀྱི་བདེ་སྲུང་ཇེ་བརྟན་དང་།",
    "མཐའ་མཇུག་འདིར་མའོ་ཡི་བཙན་ཤེད་ཀྱིས་སམ་མངལ་སྦྲུམ་ནས་གཉེན་སྒྲིག་པ་དེ་མཇུག་སྒྲིལ་བ་རེད།",
    "ད་ནི་སྤྱན་རས་གཟིགས་ཀྱི་ཡང་སྤྲུལ་གྱི་དཔྲལ་བར་སྐར་མ་དམར་མོ་ཞིག་བཏགས་ཡོད་པ་རེད།",
    "འཆི་བ་ནི་གཤིན་རྗེ་ཟེར་བའི་བདུད་ཆགས་པ་ཅན་ཞིག་རེད།",
    "ཁོའི་སྲིང་མོ་ཆུང་མའི་ཚུལ་དུ་ཡོད་པ་དེ་ཅུང་ཟད་ཡིད་དུ་མི་འོང་བ་ཞིག་ཡིན་མོད།",
    "སྔགས་ཀྱི་ཆགས་པའི་ནང་མོའི་རྐང་པ་གཉིས་གཤིན་རྗེའི་བརླ་ཤ་སྦོམ་པོ་དེར་འཁྱིལ་ནས་ཡོད།",
    "གཤིན་རྗེ་ནི་དུས་རྒྱུན་ནས་ཡོད་པ་ཞིག་མ་རེད།",
    "ཁོས་ལོ་ལྔ་བཅུའི་རིང་བྲག་ཕུག་ཅིག་ཏུ་སྒོམ་བརྒྱབ་པ་རེད།",
    "མཚན་མོ་གཅིག་ལ།",
    "ཁོ་གཉིས་ཀྱིས་དྲང་སྲོང་མ་མཐོང་བར་གླང་གི་མགོ་བཅད་པ་རེད།",
    "རྒད་པོས་སྲོག་མ་གཅོད་ཅེས་ཞུ་བ་འཐེན་པ་རེད།",
    "དྲང་སྲོང་དེ་མ་གྲོངས་པ་རེད།",
    "ཁོ་ཡར་ལངས་པ་རེད།",
    "གླང་གི་མགོ་བླངས་ནས་རང་གི་མགོ་མེད་པའི་སྐེ་ལ་བསྐོན་པ་རེད།",
    "དེ་ནས་ཁོ་རང་གཤིན་རྗེའི་ངོ་བོར་བསྒྱུར་པ་རེད།",
    "གཤིན་རྗེས་མིའི་རིགས་ཡོད་ཚད་བཅོམ་པར་འཇིགས་ནས་བོད་མི་ཚོས་རྒྱལ་བ་ཤེས་རབ་ཀྱི་རང་བཞིན་འཇམ་པའི་དབྱངས་ལ་གསོལ་བ་བཏབ་པ་རེད།",
    "འཇམ་པའི་དབྱངས་ཀྱིས་ས་འོག་ཏུ་ཆེས་གཏིང་ཟབ་སའི་གཤིན་རྗེའི་སྦས་ཡུལ་བཙལ་ནས་ཁོ་དང་དམག་བཀྱེ་བ་རེད།",
    "འཇམ་པའི་དབྱངས་ཀྱིས་གཤིན་རྗེའི་གཟུགས་བརྙན་ཆེན་པོ་ཞིག་བཟུང་ནས་ཁྲོ་བོའི་རྣམ་པར་སྤྲུལ་པ་རེད།",
    "འཇམ་པའི་དབྱངས་ཀྱི་སྤྲུལ་པ་གསར་པ་འདི་ལ་གཤིན་རྗེའི་གཤེད་དུ་བཏགས་པ་རེད།",
    "གཤིན་རྗེས་རང་གི་གཟུགས་བརྙན་ལྡབ་འགྱུར་མ་འདི་དག་མཐོང་ནས་ཧོན་འཐོར་ནས་ཤི་བ་རེད།",
    "ཁོང་གིས་སྐྱེ་འཆི་མཐའ་མེད་པ་ལ་མུ་མཐུད་ནས་ལྟ་རྟོག་བྱེད་ཀྱི་ཡོད་ལ།",
    "འགྱུར་བ་དེ་ནི་འཁྲུལ་སྣང་ཞིག་རེད་ལ།",
    "དེའི་རྐྱེན་གྱིས་དངོས་སུ་ཡོད་པ་མ་རེད།",
    "དངོས་པོ་ཚང་མ་འགྱུར་བ་འགྲོ་གི་ཡོད།",
    "དངོས་པོ་ཚང་མ་འཁྲུལ་སྣང་རེད།",
    "ཆུའི་ནང་ཤར་བའི་ཟླ་བའི་གཟུགས་བརྙན་ཞིག་རེད།",
    "ཁོ་རང་སྤྱི་སོ་ཡི་ལས་རོགས་སུ་འདམས་པ་རེད།",
    "ཞིང་པའི་བུ་དེ་ལ་འདི་ནི་ཧ་ཅང་གི་ཁེ་ཕན་ཆེན་པོ་ཞིག་དང་འགྲུལ་བཞུད་བྱེད་པའི་གོ་སྐབས་ཤིག་རེད།",
    "ཨ་ཐར་གྱིས་རང་གི་ཨ་མ་ལ་གྱེས་མཇལ་ཞུས་ནས་སྤྱི་སོའི་ཇ་ཚོང་གི་རྟ་པའི་ཁོངས་སུ་ཞུགས་པ་རེད།",
    "ཁོང་ཚོས་ཇ་ལྷ་ས་ལ་འཁྱེར་ཏེ་བཙོང་ནས་ཁེ་བཟང་ཆེ་ཙམ་ལེན་རྒྱུའི་རེ་བ་བྱེད་ཀྱི་ཡོད།"
  ]
}