    "རྣལ་འབྱོར་མངོན་སུམ་དང་གསུམ་འདོད་ཅིང་རང་རིག་མངོན་སུམ་མི་འདོད་དོ།",
    "བསེ་རུ་ལྟ་བུ་ཞེས་པ་རི་དྭགས་བསེ་རུ་ནི་དུས་རྒྱུན་དུ་རང་གཅིག་བུར་འདུག་རྒྱུར་དགའ་བའམ་ཡང་ན་བསེ་རུ་ལ་རྭ་གཅིག་མ་གཏོགས་མེད་པ་ལྟར།",
    "དྲི་བཅས་པས་ནམ་མཁའི་ངོ་བོ་ལ་སྤྲིན་གྱིས་སྒྲིབ་པ་ཡོད་ཀྱང་རང་བཞིན་ལ་མ་སྒྲིབ་པ་དང་།",
    "ཆུ་ཡི་ངོ་བོ་ལ་རྙོག་མ་སོགས་ཞུགས་པ་ཡོད་ཀྱང་རང་བཞིན་ལ་ཞུགས་པ་མེད་དེ།",
    "བུམ་པ་རང་རྐྱ་ཐུབ་པའི་རྫས་ཡོད་དུ་གྲུབ་པ་སོགས་མེད་རྒྱུའི་ཀུན་བཏགས་སམ་དགག་བྱའི་ཀུན་བཏགས་ཡིན། དི་གསུམ་པོ་རང་ངོས་ནས་གྲུབ་པ་དང་རང་བཞིན་གྱིས་གྲུབ་པར་འདོད་ཀྱང་།",
    "འདིའི་ལུགས་ལ་བདེན་པར་གྲུབ་པ་དང་རང་མཚན་གྱིས་གྲུབ་པ་དོན་གཅིག་རྟོག་པས་བཏགས་ཙམ་མ་ཡིན་པར་གྲུབ་པ་བདེན་པར་གྲུབ་པའི་དོན་ཡིན།",
    "དེས་ན་རྗེས་དཔག་དང་རང་དོན་རྗེས་དཔག་དོན་གཅིག་སྟེ།",
    "ཡང་དག་ཀུན་རྫོབ་ཡིན་གྱི་ལོག་པའི་ཀུན་རྫོབ་མ་ཡིན་པ་རང་ཉམས་སུ་མྱོང་བའི་རང་རིག་ལ་རང་ཉིད་སྣང་བ་ལྟར་གྲུབ་འདུག་པས་ཡིན་ནོ་ གཉིས་པ་ཡུལ་ཅན་ལ།",
    "སེམས་ཙམ་པའི་ལུགས་ལ་རྟོག་པས་བཏགས་ཙམ་ཞེས་པའི་ཙམ་སྒྲས་རང་མཚན་གྱིས་གྲུབ་པ་གཅོད་ཀྱང་རང་ངོས་ནས་གྲུབ་པ་མི་གཅོད་དེ།",
    "སེམས་ཙམ་པས་ཙམ་སྒྲས་གཅོད་བྱ་ལ་དེ་ཙམ་གྱིས་མ་ཁྱབ་སྟེ་ཡོངས་གྲུབ་ཀྱང་རང་མཚན་གྱིས་གྲུབ་ལ།",
    "རང་རིག་འདོད་མཁན་རྣམས་ཀྱིས་རང་རིག་མཚུངས་ལྡན་འདུ་བྱེད་ཡིན་པས་རང་དང་མཚུངས་ལྡན་ཡོད་པའི་ཆ་ནས་བཞག་པ་ཡིན་ཡང་རང་དང་མཚུངས་ལྡན་མེད།",
    "དཔལ་ལྡན་ཟླ་བས་སྐྱེ་ན་བདག་སྐྱེ་དང་གཞན་སྐྱེ་གཉིས་སུ་མ་ངེས་པ་བཞིན་དུ་མྱོང་བ་ལ་ཡང་རང་མྱོང་དང་གཞན་མྱོང་གཉིས་སུ་ཡང་མ་ངེས་ལ།",
    "གདགས་གཞི་ཁོ་རང་བཞག་ན་འགྲིགས་པའི་ཕྱིར།",
    "ཡང་དེ་ཐོབ་མ་ཐག་པ་དང་རང་རྒྱལ་སྦྱོར་ལམ་ཐོབ་མ་ཐག་པ་ལ་མུ་བཞི།",
    "ས་ཇི་བཞིན་དུ་རང་རང་དྷ་དང་ ཞེས་སོ།",
    "འོག་མིན་འགྲོ་འཕར་གསུམ་ཞེས་པའི་དངོས་བསྟན་གྱི་གཟུགས་སུ་ཉེར་འགྲོ་ཕྱིར་མི་འོང་འོག་མིན་མཐར་ཐུག་འགྲོ་དབྱེ་གཞིར་བྱས་ནས་དེ་ལས་ཕྱེ་བའི་འཕེར་བ་དང་།",
    "གཞན་སེམས་ཙམ་པ་དང་རང་རྒྱུད་པའི་ལུགས་ལ་མེད་དེ།",
    "རྩོམ་པ་པོ་དག་རང་རང་སོ་སོའི་ཁམས་དང་དམིགས་སྣང་ཁྱད་པར་བ།",
    "དེ་ལྟར་ཕྱིན་ན་དེ་ཡི་སྤྱོད་སྒོ་དང་རིན་ཐང་ཡང་རང་བཞིན་གྱིས་མར་ཆག་འགྲོ་ཡི་འདུག་པར་མ་ཟད།",
    "ཁ་བརྡ་ཡི་གཞུང་ལུགས་ཤིག་རིམ་གྱིས་ཆགས་ནས་རིག་པའི་གནས་སྣ་མང་པོར་སྤྱོད་རུང་བར་གདའ་ན།",
    "དོན་བརྗོད་རང་བཞིན་གྱི་ངོས་ནས་ཕན་ཚུན་ངོ་བོ་མཚུངས་ཤིང་རང་བཞིན་གཅིག་ཏུ་འདུག་པས།",
    "ད་ལྟའི་རྣམ་པ་བཅས་འཕེལ་རིམ་གསུམ་དུ་བཀར་ཏེ་ཉམས་ཞིབ་ཅུང་རྒྱས་པར་མཛད་འདུག་པས།",
    "ཚིག་རྒྱན་གྱི་བསྟན་བཅོས་འདི་གཞིར་བྱས་ནས་བརྩམས་སྒྲུང་རང་ལ་ཚིག་རྒྱན་གྱི་བསྟན་བཅོས་ཤིག་ཡོད་ཆོག་ཆོག་ཡིན་པ་སོགས།",
    "མི་རྩཚོ་ཟློང་རྨ་འདི་ལའང་ཚིག་ཐག་བཅད་ནས་སྨྲ་སྤོབས་པར་མི་འདུག་སྟེ།",
    "དཔའ་ཞིང་རང་བཞིན་དྲང་བ།",
    "སྤྱི་མཚན་ཅན་གཉིས་ཀྱི་ཁོངས་སུ་བསྡུས་པའི་སྐྱོན་འདུག་པས་ལག་ལེན་གྱི་སྐབས་སུ་ཟོན་དགོས་པར་གདའ་འོ།",
    "ཕྱི་མ་ལ་འཇུག་དུས་རྗོད་པ་པོ་དང་།",
    "མི་རིགས་སམ་སྐད་རིགས་གཞན་གྱི་གཞུང་དང་ལྟ་གྲུབ་དག་ལ་དཔེ་ལྟ་དགོས་པ་མི་འབྱུང་རང་འབྱུང་དུ་ཆགས།",
    "བརྗོད་དང་རང་ངོས་ཀྱི་གོ་བ་གཏིང་ཟབ་ལ་སྣ་མང་བ།",
    "རྩོམ་པ་པོ་ལ་འཇུག་དུས་ཀྱང་མངོན་སུམ་གྱི་རྩོམ་པ་པོ་དང་སྦས་པའི་རྩོམ་པ་པོ།",
    "འཇིག་རྟེན་སྐྱ་བོའི་ལོངས་སྤྱོད་དང་འགྲོ་འདུག་ཉལ་འཆག་སོགས་དང་འབྲལ་བ་མེད་པར་གནས།",
    "དུས་རབས་བཞི་པའམ་ལྔ་པའི་དུས་ཙ་ན་སློབ་དཔོན་བྷ་ར་ཏ་ཡིས་ཟློས་གར་གྱི་བསྟན་བཅོས་ཞེས་བྱ་བ་བརྩམས་གནང་ཡོད་ཅིང་།",
    "སྒྲུང་འབྲིང་གསུམ་གྱི་རྣམ་གཞག་འདི་ཀུན་ལ་སྤྱི་ཁྱབ་ཏུ་སྤྱོད་ཅིང་འདུག་པར་མཐོང་བས།",
    "འདིའི་ཚིག་ངོས་ཀྱི་དོན་ནི་དངོས་པོའམ་རྫས་གསར་ཞིང་ཆུང་བ་ཞིག་ལ་གོ་བར་འདུག་སྟེ།",
    "གནའ་རབས་སྒྲུང་རིང་ལ་མཚོན་ན་ཧ་ལམ་དེ་ལྟ་ཞིག་ཡིན་པར་འདུག་ནའང་།",
    "ལྕགས་གྱི་སྦལ་པ་འགོ་རྒུ་ཁུར་ལ་ཁུར་ཏེ་གདའ།",
    "ཆེས་སྔ་བར་ཧ་ལམ་སྤྱི་ལོ་སྔོན་གྱི་ལོ་ཉིས་སྟོང་ལྷག་ལ་འདེད་ཐུབ་པར་འདུག་སྒྲུང་དེར་མེ་སོ་ཕོ་ཐཱ་མི་ཡ་ཡི་དཔའ་བོ་སྟེ་རྒྱལ་པོ་གྷིལ་གྷ་མེ་ཤི་ཡི་མཛད་པའི་སྐོར་བྲིས་ཡོད།",
    "དོན་བརྗོད་ཀྱི་ཐབས་རྩལ་ཞིག་བེད་སྤྱད་ཡོད་འདུག་ཅེས་ཀྱང་སྨྲ་རུ་རུང་བ་སྟེ།",
    "མི་རྣམས་ཀྱིས་བླང་དོར་ལ་སྤྱོད་དགོས་པའི་ཚད་གཞི་དང་འགྲོ་འདུག་ཉལ་འཆག་ལ་བསྲུང་དགོས་པའི་ལམ་སྲོལ་ལྟ་བུར་ཆགས་ཀྱི་ཡོད་པས།",
    "གོང་བུ་རྒལ་ཏེ་གདའ།",
    "གཉིས་སུ་ལྷ་རབས་ཀྱི་བྱེད་ནུས་སམ་དགེ་མཚན་དག་ཀྱང་མཐར་ཐུག་མི་རང་ཉིད་ལ་རག་ལས་ཡོད་པའི་དོན་བརྗོད་ཀྱི་དགོངས་པ་ཞིག་བསྟན་འདུག་པར་བརྟེན།",
    "བྱེད་ནུས་ཀྱི་སྟེང་ནས་ཆབ་སྲིད་ཀྱི་དགོས་མཁོ་ཞིག་ལ་དམིགས་ཡོད་པ་མངོན་སུམ་གྱིས་གྲུབ་འདུག་སྙམ་པ་སྟེ།",
    "ཏི་དཀར་ཞེས་པ་རུ་ཕྱི་རོལ་མུ་སྟེགས་པའི་རྒྱལ་ཁམས་སུ་གཡུལ་བཤམས་པའི་ངང་ཚུལ་བྲིས་ཡོད་འདུག་མཚོ་སྣ་བ་སྟོབས་རྒྱལ།",
    "གཞན་ཡང་སྤྱི་ལོ་སྔོན་གྱི་དུས་རབས་གསུམ་པ་བཞི་པའི་སྐབས་སུ་གུ་ནཱ་དྷྱ་ཞེས་བྱ་བས་ཡུལ་མི་རང་བཞིན་པའི་སྐད་དུ་གཏམ་རྒྱུད་ཆེན་པོ་ཞེས་པའི་དམངས་ཁྲོད་ཀྱི་སྒྲུང་ཕྱོགས་གཅིག་ཏུ་བསྒྲིགས་པ་ཞིག་བྱུང་འདུག་པ།",
    "དེའི་རྩོམ་ལུས་ཀྱང་ལྷུག་པ་ཤས་ཆེ་བའི་སྤེལ་མ་ཡིན་པར་འདུག་གོ།",
    "གྷི་རི་སི་ལ་སྤྱི་ལོ་སྔོན་གྱི་དུས་རབས་དྲུག་པ་ཡས་མས་ནས་བཟུང་སྒྲུང་ངམ་གཏམ་རྒྱུད་ཀྱི་རྩོམ་ལུས་དེ་རིགས་བྱུང་ཡོད་འདུག་གོ།",
    "གཏམ་གྱི་དོན་ཡིན་པར་འདུག་སྟེ་དེ་ལ་མི་སྣའི་སཱ་གྷ་དང་།",
    "མི་ལོ་བཞི་བཅུ་འགྲོ་བར་འདུག་ཅིང་།",
    "རིགས་ལམ་དང་དགོངས་ཚུལ་འདི་སྔར་ནས་གསལ་ཁ་དོད་ཅིང་ཞིབ་ཆ་ལྡན་པ་ཞིག་ཡོད་དུ་འདུག་གོ།",
    "རྒྱུ་ཆ་བཅས་ཁག་གསུམ་གྱི་ལམ་ནས་གཞུང་ལུགས་སྤྱིའི་ངོ་སྤྲོད་མཛད་འདུག་ས་བཅད་དང་པོ།",
    "ད་ལྟ་བའི་དུས་སུ་གཞི་ནས་གཏམ་སྦྱོར་གྱི་མགོ་བརྩམས་གདའ་བས།",
    "མང་དུ་ཐོས་པ་རྒྱ་མཚོའི་ཆུས་བརླན་པར་བྱས་པ་ཞིག་ཀྱང་འདུག་པ་ལྟ་བུ་དང་།",
    "དེ་དག་ཀྱང་རང་བཞིན་དུ་གྲུབ་པ་ཞིག་དང་།",
    "སྐབས་འདིའི་ང་ཞེས་པ་ནི་དོན་གྱི་བྱུང་བ་གང་དེའི་རྗོད་པ་པོ་རང་ཡིན་པ་ལས་ཉམས་མྱོང་རང་བཞིན་ཅན་གྱི་རྩོམ་པ་པོ་ག་ལ་ཡིན་ཏེ་མ་ཡིན།",
    "དེའི་འགྲོ་འདུག་དང་སྦྲགས་ནས་སྣོད་ཀྱི་འཇིག་རྟེན་ནམ་བརྟན་པར་གནས་པའི་ཡུལ་གྱི་བཀོད་པ་མང་པོ་འབྲི་ཐུབ་ཀྱི་ཡོད་པ་ལ་གོ་ཡང་རུང་བས།",
    "འགྲོ་འདུག་ཉལ་འཆག་དང་ཡང་ཁ་འབྲལ་དུ་མེད་པར་རག་ལས།",
    "སྒྲ་སྡུད་འཕྲུལ་ཆས་ཀྱི་དུས་བརྡ་ལ་སོགས་ཀྱིས་དུས་ཀྱི་འགྱུར་བ་དང་རང་བཞིན་མཚོན་པར་བྱས་པས།",
    "དེས་ན་དོན་བརྗོད་ཀྱི་བྱེད་ནུས་གཙོ་བོ་ཞིག་ནི་དུས་ཀྱི་རིགས་གཅིག་དུས་ཀྱི་རིགས་གཞན་ཞིག་ཏུ་བསྒྱུར་བར་བྱེད་པ་ཞིག་ཏུ་ངེས་སོ།",
    "རྗེས་སུ་བྱུང་བའི་ཧོར་གླིང་གཡུལ་འགྱེད་ཀྱི་བྱུང་བ་དང་ཡང་ཆ་མཚུངས་སུ་འདུག་པས།",
    "སྔ་ཕྱི་དྲན་པའི་ནམ་མཁའ་གདའ་ཟེར་རོ།",
    "དེ་ལྟར་བརྟག་དུས་སྔ་ཕྱིའི་གོ་རིམ་ལས་རྟགས་དང་།",
    "སྐད་མང་རང་བཞིན།",
    "དེ་ནི་དང་པོ་སྦྱོར་བ་ལ་སོགས་པ་དང་རང་བཞིན་ལ་སོགས་པའོ།",
    "གང་ཞིག་དུས་གསུམ་རྡོ་རྗེ་ནི་དུས་གསུམ་གྱི་དེ་བཞིན་གཤེགས་པའི་རང་བཞིན་ནི་རང་བཞིན་ཅན་ནོ།",
    "གཞན་གསོས་དལ་དུ་འདུག་པ་དང་།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ིས་བསཞིམེད་འགྱུར་བའི་དུས།",
    "སྒྲུབ་པོ་བདེ་བའི་སྟན་འདུག་སྟེ།",
    "ཅེས་དང་རང་སེམས་རྩ་བ་ཚདལ་རིག་པ་གཅེར་བུར་ཞོག།",
    "ངེལ་བ་རྟོག་པ་དེ་ཚོར་མ་ཐག་ར་ཡོངས་འདུག་སྙམ་པའི་སེམས་དེ་ཀ་ལ་ལྟོས།",
    "དེ་ལགནས་པའི་ངང་ནས་སེམས་ཀྱི་ངོ་བོ་དཙིལྟ་བུ་ཞིག་འདུག་དྲིས་ལ།",
    "གསལ་ཧྲིག་གེ་བ་ལ་རྗེན་ནེ་བ་ཞིག་འདུག་དྲིས་པས།",
    "རྙིང་མ་ལྟར་འདུག་ཟེར་ནསེམས་ངོ་མཐོང་བ་ཡིན།",
    "དེ་ནས་དྲིས་པས་སེམས་དེ་གང་ཡང་མི་བྱེད་པར་སྡོད་འདུག་ཟེར།",
    "དེ་ལྟབལྟས་པས་སྣང་བ་དེ་འགགས་འགྲོ་འདུག་གམ།",
    "ཕྱིམལྟར་རོ་སྙམན་རྟོག་པ་ཚུར་བཀུག་ནས་སྒོམ་ལ་བཞག་པ་གསལ་སྟོང་དུ་འདུག་གམ།",
    "ཐོལ་སྐྱེས་གང་ཤར་ཐམས་ཅད་རྗེས་མེད་ཤིགས་འགྲོ་འདུག་བལྟའོ།",
    "སྣང་བ་འཛིན་མེད་དུ་ལྷུང་ངེ་བ་ཞིགཡོང་བས་དེའི་དུས་ན་རང་དང་སྣང་བ་སྣང་སྟོང་ཡུལ་མེད་དུ་ལྷང་ངེ་འདུགན།",
    "སེམས་དེ་དངོས་པར་འདུག་གམ་དངོས་མེད་དུ་འདུག་སྐྱེ་འགག་ཁ་དོག་དབྱིབས་སོགས་ཨེ་འདུག།",
    "རྟོག་པ་རང་དང་རྟོག་པའི་ཡུལ་དང་དེ་སྔ་༢གྱི་རྟོག་པའམ་སེམསལ་ཁྱད་པ་ཅི་འདུགསོགས་ཀྱང་ནང་ནས་སྒྲོ་འདོགས་ཆོད་ངེས་ཐག་ཆོད་པར་ལྟ།",
    "དེ་གཉིས་ཁྱད་ཨེ་འདུག་བལྟསཏེ་ཡུལསྣང་བ་དང་ཡུལ་ཅན་རྟོག་པའི་ཁྱདཔར་ཅི་འདུགལྷ།",
    "འབའ་ཞིག་ཏུ་འདུག་པ་གནས་འགྱུ་གཉིས་ཀ་གསལ་སྟོང་རྗེན་པ་དེ་ལས་མ་འདས་པར་འདུག་པར་རྟོགས་ན་ཅུང་ཟད་རྟོགས་པ་ཡིན།",
    "ངོས་གཟུང་མི་འདུག་སྙམ་པའི་ཀད་དེ་བ་ཡང་མེད་ལ་གཡམེད་འཛིན་མེད་དུ་ངོས་གཟུང་མེདཔརཤར་གྲོལ་དུས་མཉམན་པོའཕྲོད་པ་ཊྛིན་ཞིང་གཞན་ཡང་རྟོག་པ་རྟོག་པའི་ཡུལ་གནས་དུས་དང་འགྱུ་དུས་ཀྱི་སེམས་སྔར་གྱི་སེམས་སྤང་རྟོག་པསོགས་ལའང་བཟང་ངན་དང་ཁྱད་པར་ཅུང་ཟད་མེད་པར་གསལ་རིག་རྗེན་པར་རྟོགས་པ་དང་།",
    "ཨེཔཱརལླཡཾ་ཞེས་པའི་སྔགས་ཀྱིས་བསྐུལ་བའི་ཚཙོག་པུའི་འདུག་སྟངས་བྱས་ལ་རྐང་པ་གཡས་ཀྱི་མགོ་བོས་གཡོན་མཐེབ་མན།",
    "སྣང་སྲིད་སེམས་སུ་འདུས་གདའ།",
    "དེ་ལ་ངོས་བཟུང་མེད་པར་གདའ།",
    "ཀ་ཟླ་རིག་པ་གསལ་བའི་ངང་དུ་གདའ།",
    "མ་བཅོས་ལྷག་པར་བཞག་པར་གདའོ།",
    "སྡིག་བཅུ་སྲུང་དུ་མེད་པར་གདའོ།",
