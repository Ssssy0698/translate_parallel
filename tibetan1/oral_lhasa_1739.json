    "འདི་ཉིད་ལས་རྣམ་པ་ཐམས་ཅད་སྟོན་པར་བྱེད་པའོ།",
    "ཐུགས་ཞེས་བྱ་བ་ནི་གཉིས་སུ་མེད་པར་རྟོགས་པའོ།",
    "སྐུ་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྣམ་པ་ཐམས་ཅད་ནས་ཐམས་ཅད་དུ་ལྷུན་གྱིས་གྲུབ་པར་ཕྱི་དང་ནང་ཡང་དག་པར་རིག་པའི་སྐུ་གཅིག་པུས་ཀྱང་སྟེ།",
    "ཞེས་བྱ་བ་ནི་བདེ་བ་ཆེན་པོའི་རྣམ་པར་སྒེག་པས་རོལ་པ་དང་ལྡན་པ་སྟེ།",
    "དེ་ཡིས་སྙོམས་པར་འཇུག་པའོ།",
    "སླར་ཡང་དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་བཞིན་ཉིད་འབའ་ཞིག་རྣམ་པ་ཐམས་ཅད་དུ་བདག་པོར་གྱུར་པ་ཉིད་བསལ་བ་དང་བཞག་པ་དང་བྲལ་བ་ཇི་ལྟ་བར་རྟོགས་པར་བྱ་བ་ཡིན་པས་ན།",
    "ཕུང་པོ་ལ་སོགས་པ་དེ་རྣམས་ཀྱེའི་རྡོ་རྗེའི་རྣམ་པར་འཕྲུལ་པ་སྟེ།",
    "གསལ་ཞིང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཇི་ལྟ་བ་བཞིན་ཉེ་བར་དམིགས་ཤིང་ཡོད་པའི་གཟུགས་ལས་མ་འདས་པར་མངོན་སུམ་དུ་ཉམས་སུ་མྱོང་བས་དང་།",
    "དམིགས་པ་མེད་པར་ཉམས་སུ་མྱོང་བར་བྱ་བ་ཡིན་པས་སོ།",
    "འཕྲོ་བ་ནི་ཇི་ལྟར་ཡོད་པ་བཞིན་དུ་ཡང་དག་པར་འཕྲོ་བ་སྟེ།",
    "སེམས་དང་སེམས་ལས་བྱུང་བའི་དབྱེ་བ་རྣམ་པར་ཉམས་ལ་ཞེས་བྱ་བ་ལ།",
    "དེ་གཉིས་ཀྱི་དབྱེ་བ་རྣམ་པར་ཉམས་པ་ནི་དེ་ཡོངས་སུ་དོར་བ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་དང་ཉེ་བའི་རྟོག་པ་དང་བྲལ་བ་ལས་སོ།",
    "དེ་བཞིན་ཉིད་གཅིག་པུའི་རྒྱུ་ལས་རྣམ་པ་ཐམས་ཅད་པ་དང་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ནི་ཆེན་པོའོ།",
    "དེ་བཞིན་དུ་དེ་ཡང་དག་པའི་རྟོག་པས་མཉེས་ཤིང་རྣམ་པར་དག་པ་ལས་ཐམས་ཅད་དུ་དྲི་མ་མེད་ཅིང་ཕུལ་དུ་བྱུང་བའི་སྣང་བ་འཆར་བའོ།",
    "མཛེས་ཞེས་བྱ་བ་ནི་ཁྱད་པར་དུ་གྱུར་པའི་དེ་བཞིན་ཉིད་ཀྱི་རང་བཞིན་གྱི་སྣང་བས་སོ།",
    "འོན་ཀྱང་ཡང་དག་པའི་རྟོག་པ་དག་པ་ལས་ཀྱང་ལྷན་ཅིག་སྐྱེས་པ་མཆོག་ཏུ་གསལ་བར་འགྱུར་རོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ཡང་དམིགས་པ་ལ་རྩོལ་བས་དེ་རྟོགས་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "ཞེས་བྱ་བ་ནི་བདག་དང་གཞན་གྱི་ཐ་སྙད་སྒྲོ་འདོགས་པར་བརྩོན་པས་ཉེ་བར་གནས་པའི་སེམས་སོ།",
    "ཀུན་དུ་བྱས་ནས་ཞེས་བྱ་བ་ནི་གཉིས་ཀྱི་བག་ཆགས་ལྷག་པར་བརྟན་པར་བྱས་པས་ན་ཀུན་དུ་བྱས་ཞེས་བྱའོ།",
    "དེ་བཞིན་དུ་གང་ཡང་རུང་བའི་རིགས་ལ་གང་ཅི་ཡང་རུང་བའི་མི་ཕན་པའི་བྱ་བས་ཀྱང་གཉིས་སུ་མེད་པར་སྤྱོད་པ་ཅན་གྱི་རྫོགས་པའི་རྣལ་འབྱོར་པ་ངལ་བར་མི་འགྱུར་བའོ།",
    "ད་ནི་གཉིས་སུ་མེད་པ་གསལ་བར་ཉམས་སུ་མྱོང་བ་བརྗོད་པར་བྱ་སྟེ།",
    "ཡང་དག་རིག་པ་ནི་རྣམ་པར་འགྱུར་བ་མེད་པ་ཡང་དག་པར་རིག་པའོ།",
    "སྟུག་པོའི་དགའ་བས་ཞེས་བྱ་བ་ནི་འདི་ལས་དམིགས་པ་དང་བྲལ་བ་ཉིད་ཀྱིས་བར་མ་ཆད་པར་འདོད་པ་ལ་མངོན་དུ་ཕྱོགས་པའི་མཚན་ཉིད་ཀྱི་དགའ་བ་དང་པོའོ།",
    "དེ་ལ་མངོན་དུ་ཕྱོགས་པ་ལས་རབ་ཏུ་སྟོབས་སུ་གྱུར་པའི་བདེ་བ་འབའ་ཞིག་ཡང་དག་པར་རིག་པ་མཆོག་ཏུ་དགའ་བའོ།",
    "རོ་ནི་དེ་ཉམས་སུ་མྱོང་བ་གོམས་པས་རྣམ་པར་རྩེན་པའོ།",
    "ད་ནི་རྣམ་པར་འགྱུར་བ་མེད་པའི་རང་བྱིན་གྱིས་བརླབ་པའི་རིམ་པ་བསྟན་པ་བརྗོད་པར་བྱ་སྟེ།",
    "རང་བྱིན་གྱིས་བརླབས་པ་ཞེས་བྱ་བ་ནི་རང་ལྷག་པར་གནས་པར་ནུས་པའོ།",
    "རང་བྱིན་གྱིས་བརླབ་པའི་རིམ་པ་དེ་ཉིད་རྒྱས་པར་བསྟན་པའི་ཕྱིར།",
    "དེ་ཡིས་མཚོན་པར་བྱེད་པ་ལ་གསུམ་པའོ།",
    "རྟོགས་པར་བྱ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་བྱུང་བ་རྟོགས་ཤིང་རྟོགས་ཐོབ་པ་སྟེ།",
    "འདིས་རྟོགས་པས་ན་རྣམ་པར་རྟོག་པས་ཏེ།",
    "དེ་སྦྱིན་པར་བྱེད་པའོ།",
    "རྣམ་པར་མི་རྟོག་པ་ནི་རྟོག་པ་མེད་ཅིང་དཔྱོད་པ་མེད་པའོ།",
    "འདིས་རྣམ་པ་ཐམས་ཅད་ཀྱི་མཆོག་དང་ལྡན་པར་བསྟན་པ་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་དག་དང་འབྲེལ་པ་མེད་པའི་ཕྱིར་ཡོད་པར་དམིགས་པས་སྟོང་པའི་དངོས་པོའོ།",
    "འདི་མཐོང་བ་ཡང་འདིས་ཀུན་ནས་མཚུངས་པར་ཐམས་ཅད་ལ་སྒྲིབ་པར་བྱེད་པས་ན་འཇིག་རྟེན་གྱི་ཐ་སྙད་ནི་ཀུན་རྫོབ་ཡིན་ལ།",
    "མྱ་ངན་འདས་ཞེས་བརྗོད་པར་བྱ།",
    "དོན་དམ་པ་དེ་ཉིད་ཀྱི་རང་བཞིན་བསྟན་པར་བྱ་བའི་ཕྱིར་གསུངས་པ།",
    "མཐའ་གསུམ་ཞེས་བྱ་བ་ནི་རྟོགས་པར་བྱ་བ་དང་།",
    "རྟོགས་པའི་ངོ་བོ་ཞེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་མཐའ་དག་དང་བྲལ་བས་བླུན་པའི་རང་བཞིན་མ་ཡིན་པའོ།",
    "དོར་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་བསལ་བ་དང་གཞག་པ་དང་བྲལ་བས་མཉམ་པར་མི་འཕྲོགས་པའོ།",
    "གནས་ཞེས་བྱ་བ་ནི་དེ་རྣམས་ལ་ཡོངས་སུ་གྲུབ་པའི་རྣམ་པ་དབྱེར་མེད་པར་རོ།",
    "ཐོགས་པ་མེད་པ་ནི་མཚོན་པར་བྱ་བའིའོ།",
    "རྣམ་པར་འགྱུར་བ་དང་བྲལ་བ་ནི་ལྷན་ཅིག་སྐྱེས་པས་སོ།",
    "ལེགས་པར་གནས་པ་ནི་གཡོ་བ་མེད་པ་ཉིད་ཀྱིས་སོ།",
    "གཅིག་ནི་སྣ་ཚོགས་པར་རྟོགས་པ།",
    "དེ་ཉིད་རྒྱས་པར་བསྟན་པའི་ཕྱིར་རྣམ་པ་ཞེས་བྱ་བ་ནི་དེ་དང་དེ་ལྟ་བུར་ཡང་དག་པར་རིག་ཅིང་སྣང་བ་ནི་རྣམ་པ་སྟེ།",
    "སྣམ་བུ་མེད་ན་ཞེས་སོགས་ནི་རྟོགས་པར་སླའོ།",
    "དེ་བཞིན་དུ་ཕུལ་དུ་བྱུང་བའི་རང་བཞིན་གྱི་ལྷན་ཅིག་སྐྱེས་པ་སྤྱོད་ཡུལ་མ་ཡིན་ཞིང་གཡོ་བ་མེད་པ་ལས་དེ་ལྟ་བུ་ཉིད་ཀྱི་རང་བཞིན་དུ་ཉེ་བར་སྟོན་པ་གསུངས་ནས།",
