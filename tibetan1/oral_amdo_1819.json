    "ལྷག་པ་རྗེ་རྡོ་རྗེ་འཛིན་ཉིད་ཀྱིས་ཚེ་སྒྲུབ་རྣམས་ལ་ཐུགས་བརྩོན་ལྷུར་བཞེས་མཛད་པས་རེ་ཞིག་ནས་སྐུ་ལུས་ལས་འབུ་མཐོ་གང་ཙམ་ཞིག་མངོན་སུམ་དུ་འཐོན་པས་འཕྲལ་དུ་སྙུན་གཞི་ལས་གྲོལ་བའང་རྗེ་རྡོ་རྗེ་འཆང་ཉིད་ཀྱི་སྐུ་དྲིན་དུ་ཡང་དག་པར་འཁུམས་ལགས།",
    "ཀུ་རུ་ཀུལླེའི་རྗེས་གནང་ཐུན་མོང་བ།",
    "ཞེས་གླེང་བ་དང་ལྷན་ཅིག་དད་མོས་དང་དགའ་མགུ་ལྷག་པར་ཆེ་བའི་དཔལ་ལ་འགོད་པར་མཛད།",
    "གནས་དེར་ཕ་བོང་ཆེན་མོ་ཞིག་མཆིས་པ་དེ་མེད་པ་མཛད་དགོས་ཚུལ་གསོལ་བ་བཞིན་ལ་ཡང་།",
    "གཞིས་རྩེ་ཕྱོགས་ནས་ངོར་དུ་ཆིབས་བསྒྱུར་གྱི་སྐབས་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཞལ་ཕྱག་ཡོངས་སུ་རྫོགས་པ་ཞིག་གཟིགས་ཤིང་།",
    "ཐར་རྩེ་ཕེབས་འཕྲལ་ཐར་རྩེ་རྡོ་རྗེ་འཆང་གི་གསུང་ལས།",
    "ལོ་དེའི་གྲོ་བཞིན་གྲང་ཆེན་སྐུ་རིམ་པ་རྣམས་ལ་ཁྲོ་བཅུའི་རྗེས་གནང་དང་གཏོར་བཟློག་གི་ལྗགས་ལུང་བཅས་དང་།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "ཟག་མེད་བདེ་ཆེན་མགོན་པོའི་རང་ཞལ་གཟིགས།",
    "ནང་གི་ཟུག་རྔུའི་རང་གཟུགས་ཕྱིར་དབྱུང་ནས།",
    "དད་ལྡན་སློབ་བུའི་རེ་བའི་ཡོལ་གོ་རྫོགས།",
    "ཕོ་ཉའི་སྔ་རོལ་ཡེ་ཤེས་དབྱིངས་གཟིགས་ནས།",
    "གུར་གྱི་མགོན་པོ་ལྷ་བརྒྱད་ཐུན་མོང་མ་ཡིན་པ།",
    "པཎ་ཆེན་དམར་པོ་ནས་བརྒྱུད་དེ་ཞང་པ་ལ་བཀའ་བབས་པའི་དམག་ཟོར་ལྷ་མོ།",
    "སྒྲོལ་མ་དཀར་མོའི་རྗེས་གནང་རྣམས་ཏེ་ཟབ་རྒྱས་གདམས་པའི་བསིལ་ཟེར་གྱི་བདུད་རྩིས་ས་སྤྱོད་ཐུགས་ཀྱི་ཀུནྡ་དཀར་གསལ་བཞིན་རས་ཀྱི་མེ་ཏོག་ཕྱོགས་ཀྱི་བུ་མོར་ངོམ་པའི་དགའ་སྟོན་ལ་བཀོད་པའི་མཐུ་ལ་བརྟེན་ནས།",
    "ས་བསྟན་ནོར་འཛིན་དཔལ་མོའི་ལྗོངས་འདིར་དར་ཞིང་རྒྱས་ལ་ཡུན་རིང་གནས་པའི་ཐུགས་སྨོན་རྒྱལ་སྲས་མཆོག་གི་སྤྱོད་པས་དུས་འདའ་བར་མཛད་དོ།",
    "ཉིན་གཅིག་བསེ་མགོན་བཞུགས་ཡུལ་ནས་སྐུ་མདུན་ལ་རྒྱང་གིས་མཛད་པ་ལྟ་བུ་དང་།",
    "ཉིན་གཅིག་ས་ལོཙྪ་བའི་ཕྱག་རྔ་གནང་མུར་ལྤགས་ལྡེབས་ལ་འོད་འཁྱུག་པ་ཉེ་གནས་དང་ཐུན་མོང་དུ་གཟིགས་ཤིང་།",
    "དེ་སྐབས་མཁའ་འགྲོ་འདུ་བའི་དུས་ཀྱི་ཚེ་ཞིག་རྗེ་རྡོ་རྗེ་འཆང་ཉིད་ནས་དམ་ཅན་མོན་བུ་པུ་ཏྲའི་ཐུན་མོང་མ་ཡིན་པའི་གསང་རྟེན་གཉིས་གསར་བསྐྲུན་གྱིས།",
    "ནུབ་ཕྱོགས་ཀྱི་ནམ་མཁར་མི་ནག་དུང་ལོང་ཅན་གཉིས་གྲོས་བྱེད་པའི་ཚུལ་གྱིས་ངེད་རང་ཚོ་ཐོག་མར་རིན་སྤུངས་ལ་ཕྱིན།",
    "དེ་ནས་དུམ་ཙམ་ཞིག་ནས་འཁར་རྔར་སོར་མོ་བསྣུན་པ་ལྟ་བུའི་སྒྲ་ཞིག་བྱུང་ནས་ལྡིར་ཆོམ་རྣམས་ཡར་འོང་སྟེ་དབུ་རྩེ་རྙིང་མའི་གསེར་ཕིབས་སྟེང་སོང་བ་འདྲ་མོ་ཞིག་བྱུང་བའི་སང་ཉིན་དབུ་རྩེའི་གསེར་ཕིབས་ཁར་ཡང་ཁྲག་རློན་འཐོར་རེ་བ་དང་།",
    "འཁོར་ཚོམས་ལྷོ་འགྲམ་ལ་ཆེ་བ་རྟ་དང་ཆུང་བ་ར་ལུག་གི་རྨིག་རྗེས་འདྲ་མོ་གདན་ནས་ལ་མང་དུ་བྱུང་བ་སོགས་ནི་ཀུན་གྱིས་དགོངས་གསལ་ལྟར་ལགས།",
    "འདི་ཡིན་མེད་ཅིང་དོན་གྱིས་སྟོངས་པའི་ཐུགས་བསུན་འོ་བརྒྱལ་ཅན་ཞིག་གིས་ཐུགས་རྒྱུད་འཁྲུགས་བཞིན་དུ།",
    "དེ་སྐབས་ཐོ་རེངས་སྔ་བ་ནས་བཟུང་སྒྲུབ་མཆོད་ཡན་ལ་རྡོ་རྗེ་གཞོན་ནུའི་བསྙེན་མཚམས་སྔོན་འགྲོའི་སྟོད་ལས་རྡུལ་མཚོན་གྱི་དཀྱིལ་འཁོར་སྒྲུབ་གནང་གིས་དབྱངས་ཉིས་རྫོགས་སུམ་རྫོགས་ཀྱི་གཏོར་བསྔོ་ཡན་ཆད།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "ཟབ་མོའི་དཀྱིལ་འཁོར་དབྱིངས་སུ་རྗེས་བཟུང་ནས།",
    "ངོ་མཚར་ལྟས་བཟང་གྲོལ་བའི་ལང་ཚོ་ཅན།",
    "ནག་ཟླའི་ནང་འཇམ་དབྱངས་གཟི་འོད་འབར་བའི་ཞབས་མཐིལ་ལ་ལྗགས་བལྡག་མཛད་པའི་མུར་སྐུའི་གཡོན་འཁྲིས་དེ་ན་འཕགས་པ་ཀླུ་སྒྲུབ་དང་ཞི་བ་ལྷའི་སྣམ་སྦྱར་བརྩེགས་པ་ཞིག་གཟིགས་པ་དང་།",
    "འཇམ་མགོན་ཨ་མེས་ཞབས་ཀྱིས་ལན་གསུམ་གྱི་བར་དུ་ཞལ་བསྟན་ཏེ་རྗེས་སུ་བཟུང་བ་ལགས།",
    "རྗེ་རྡོ་རྗེ་འཆང་ཉིད་ཀྱི་ཐུགས་རྗེ་ཐུགས་བསྐྱེད་ཕྲིན་ལས་ལས་ཤར་བའི་མཐུན་འགྱུར་གྱི་རོལ་མོ་འཁྲོལ་བ་སོགས་ཀྱི་མཐུ་ལས་ཉེ་ཞོའི་གདོན་བགེགས་ཀྱི་བསམ་སྦྱོར་དམིགས་མེད་ཀྱི་དབྱིངས་སུ་རྒྱས་བཏབ་ནས་རིམ་གྱིས་གདན་ས་ཆེན་པོར་ལེགས་པར་ཕེབས་ཏེ།",
    "དེའི་ཚེ་དེའི་དུས་སུ་གདན་སའི་ལུགས་ཟུང་གི་མཛད་སྒོ་རྣམས་འཇམ་མགོན་མཐུ་སྟོབས་ཀྱི་མཚན་ཅན་མཆོག་ནས་གང་གི་བཀའ་ལུང་གི་ཁུར་བཟོད་པར་མཛད་ཅིང་།",
    "འཆི་བདག་ལས་ཀྱི་གཤིན་རྗེ་ཕུར་ཁང་གི་སྒོ་ཚད་དང་མཉམ་པ་ཞིག་ཀྱང་བཀའ་ཉན་པའི་ཚུལ་གྱིས་གཟིགས་སོ།",
    "དེ་དག་གི་དོན་བསྡུ་ན།",
    "དབྱུག་ཟླའི་ཚེས་གཉིས་ནས་ལམ་གཏོར་དང་དྲུག་ལ་གདན་ས་འོག་རྩེ་གདོང་གི་ཕྱོགས་ལ་ཆིབས་བསྐྱོད་དེ་བཅུ་གཅིག་ལ་རྩེ་གདོང་དུ་ཕེབས་ནས་ཞག་གཉིས་ལྕང་ཅན་མགོན་ཁང་དུ་ཕྲིན་འཆོལ་ཟབ་རྒྱས་ཀྱིས་བཅུ་བཞིས་མཆོད་ཐོག་གདན་ས་དེ་ཉིད་དུ་ཕུར་པ་སྒྲུབ་མཆོད་གསར་འཛུགས་མཛད་གོང་གཟའ་སྐར་སོགས་གཟིགས་ཡུལ་དུ་མ་གྱུར་ཀྱང་འགྲུབ་སྦྱོར་རང་འགྲིག་དང་གྲོལ་ཉིན་ཉེར་བདུན་ལའང་འགྲུབ་སྦྱོར་རང་འགྲིག་བཅས་རྗེ་རྡོ་རྗེ་འཆང་ཉིད་ཀྱི་ཐུགས་བསྐྱེད་དང་།",
