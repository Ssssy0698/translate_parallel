    "གང་ཟས་ཆེས་ཆེར་ཟ་བ་དེ་ནི་ཁ་དོག་ངན་པར་གྱུར་ཏོ།",
    "སའི་བཅུད་མེད་པར་གྱུར་པ་ན་ས་ཞག་ཁ་དོག་ཕུན་སུམ་ཚོགས་པ།",
    "བདག་ཅག་ལས་གང་ཟས་ཆེས་ཆུང་ངུ་ཟ་བ་དེ་ནི་ཁ་དོག་དང་ལྡན་པར་འགྱུར་ལ།",
    "གང་ཟས་ཆེས་ཆེར་ཟ་བ་དེ་ནི་ཁ་དོག་ངན་པར་གྱུར་ཏོ།",
    "ས་ཞག་མེད་པར་གྱུར་པ་ན་མྱུ་གུའི་ཚལ་ཁ་དོག་ཕུན་སུམ་ཚོགས་པ།",
    "བདག་ཅག་ལས་གང་ཟས་ཆེས་ཆུང་ངུ་ཟ་བ་དེ་ནི་ཁ་དོག་དང་ལྡན་པར་འགྱུར་ལ།",
    "གང་ཟས་ཆེས་ཆེར་ཟ་བ་དེ་ནི་ཁ་དོག་ངན་པར་གྱུར་ཏོ།",
    "མྱུ་གུའི་ཚལ་མེད་པར་གྱུར་པ་ན་མ་རྨོས་མ་བཏབ་པའི་འབྲས་སཱ་ལུའི་འབྲུ་སོ་བ་མེད་པ།",
    "དག་པ་གཙང་བ་སོར་བཞི་པ་ཀུན་ནས་མ་དཀྲིས་པ་ནུབ་བརྔས་ནས་ནང་རྒྱལ་ཞིང་ཕྱིར་སྐྱེ་ལ།",
    "འབྲས་ཀུན་ནས་དཀྲིས་པར་གྱུར་ཅིང་བརྔས་སོ་ཅོག་ཀྱང་ཕྱིར་མི་སྐྱེ་ལ།",
    "འདི་ནི་ངའི་འོ་ཞེས་མུ་ཐུག་རྣམ་པར་གཞག་པར་བྱ་བ་སྙམ་ཞེས་དེ་དག་འདུས་ཤིང་ལྷགས་ནས།",
    "འདི་ནི་ངའི་འོ་ཞེས་མུ་ཐུག་རྣམ་པར་འཇོག་པར་བྱེད་དོ།",
    "ཁྲིད་པར་བྱེད་ཅིང་འཁོར་གྱི་ནང་དུ་སྣང་བའི་བར་དུ་བྱེད་དོ།",
    "ཁྲིད་པར་བྱེད་ལ།",
    "བདག་ཅག་ལས་གང་ཆད་པས་གཅད་པར་བྱ་བ་ཡང་ཆད་པས་གཅོད་པར་འགྱུར་ཞིང་།",
    "ཕན་གདགས་པར་བྱ་བ་ལ་ཡང་ཕན་འདོགས་པར་འགྱུར་ལ།",
    "ཕན་གདགས་པར་བྱ་བ་ལ་ཡང་ཕན་ཐོགས་ཤིག།",
    "སྨས་པ་ལས་སྐྱོབ་པར་བྱེད་པས་རྒྱལ་རིགས་རྒྱལ་རིགས་ཤེས་བྱ་བའི་མིང་དུ་གྱུར་ཏོ།",
    "ལོ་མའི་སྤྱིལ་པོ་དག་བྱས་ནས་གནས་བཅས་ཏེ་འཁོད་དོ།",
    "ནང་པར་ཡང་ནང་པར་གྱི་ཟས་འདོད་པས་གྲོང་དུ་བསོད་སྙོམས་ལ་ཞུགས་སོ།",
    "ཡལ་ག་དང་ལོ་མའི་སྤྱིལ་པོ་དག་བྱས་ནས་གནས་བཅས་ཏེ་འཁོད་ཅིང་།",
    "རྒོངས་ཀར་ཡང་རྒོངས་ཀའི་ཟས་འདོད་པས་གྲོང་དུ་བསོད་སྙོམས་ལ་འཇུག་པར་བྱེད།",
    "ནང་པར་ཡང་ནང་པར་གྱི་ཟས་འདོད་པས་གྲོང་དུ་བསོད་སྙོམས་ལ་འཇུག་པར་བྱེད་པ་ནི་དཀའ་བ་བྱེད་པ་ཡིན་ནོ་སྙམ་ནས།",
    "རིག་བྱེད་དག་སྦྱོར་བར་བྱའོ་ཞེས་གནས་བཅས་ཏེ་འཁོད་པར་གྱུར་ཅིང་།",
    "བཏུང་བས་ཚིམ་པར་བྱའོ་ཞེས་དེ་དག་དེ་ན་སྦྱིན་པ་དག་སྦྱིན།",
    "སྐྱེ་བོ་འགྲོན་པ་འོངས་ཤིང་ལྷགས་པ་རྣམས་ལ་ཅི་ནུས་ཅི་ལྕོགས་སུ་བཟའ་བ་དང་བཏུང་བས་ཚིམ་པར་བྱེད་དོ།",
    "ལས་ཀྱི་གནས་སོ་སོར་སྒྲུབ་པར་བྱེད་དོ་ཞེས་བྱ་བ་ལས་རྗེའུ་རིགས་རྗེའུ་རིགས་ཤེས་བྱ་བའི་མིང་དུ་གྱུར་ཏོ།",
    "མ་བྱིན་པར་ལེན་པའི་རྐྱེན་གྱིས་ཆུ་བུར་ཕྱུང་ངོ།",
    "མ་བྱིན་པར་ལེན་པའི་རྐྱེན་གྱིས་ཆུ་བུར་ཕྱུང་ངོ།",
    "དགེ་སློང་དག་དེ་ལྟ་བས་ན་འདི་ལྟར་བསླབ་པར་བྱ་སྟེ།",
    "འདོད་ཆགས་སྤང་བའི་ཕྱིར་འབད་པར་བྱའོ།",
    "གཏི་མུག་སྤང་བའི་ཕྱིར་འབད་པར་བྱ་སྟེ།",
    "དགེ་སློང་དག་ཁྱེད་ཀྱིས་དེ་ལྟར་བསླབ་པར་བྱའོ།",
    "ཕམ་པར་འགྱུར་བ་གཉིས་པ་རྫོགས་སོ།",
    "ཕམ་པར་འགྱུར་བ་གསུམ་པའི་སྤྱི་སྡོམ་ལ།",
    "ཕེབས་པར་སྨྲ་བ།",
    "འགྲོགས་བཤེས་སྨོས་འདྲིན་འཐུན་པར་བརྗོད་པ་གཉིས་ཤིག་འཁོད་དོ།",
    "ཚེ་དང་ལྡན་པ་སྐྱོང་བ་ཅིའི་ཕྱིར་སྒྲ་སྒྲོགས་པར་བྱེད།",
    "ཚེ་དང་ལྡན་པ་སྐྱོང་བ་རབ་ཏུ་བྱུང་བའི་སེམས་ཉེ་བར་གཞག་པར་གྱིས་ཤིག།",
    "བཀྲེས་པར་གྱུར་ཏོ།",
    "སྐྱོང་བས་དགེ་སློང་དེ་དག་ལས་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྗེས་སུ་བསྲུང་བ་དང་བརྐམ་ཆགས་ཉིད་ཀྱིས་ཅུང་ཟད་ཅུང་ཟད་ལོངས་སྤྱད་པ་དང་།",
    "སྐྱོང་བ་ཉེས་པ་དང་བཅས་པས་ཡི་གེ་བསྒྱངས་ཏེ་སྨྲས་པ་བྱས་སོ།",
    "ཚེ་དང་ལྡན་པ་སྐྱོང་བ་ཅིའི་ཕྱིར་དེ་སྐད་ཀུ་ཅོ་འདོན་པར་བྱེད།",
    "ཕེབས་པར་སྨྲ་བ།",
    "འགྲོགས་བཤེས་སྨོས་འདྲིན་མཚུངས་པར་བརྗོད་པ་གཉིས་ཤིག་འཁོད་དོ།",
    "ཅིའི་ཕྱིར་འདི་གཉིས་སྡུད་པར་མི་བྱེད།",
    "སོ་ཤིང་དག་འབུལ་བར་བྱེད་ནས་དགེ་སློང་རྣམས་ཀྱིས་ཀྱང་དེ་གཉིས་ལ་ལྷུང་བཟེད་ཀྱི་ལྷག་མ་སྦྱིན་པར་བྱེད་དོ།",
    "ཁྲག་རྟས་ཤིང་དེ་གཉིས་སྟོབས་དང་སྙེམས་པ་དང་ལྡན་པར་གྱུར་ཏོ།",
    "ཁོ་བོས་ཁྱེད་གཉིས་དད་པས་སྦྱིན་པར་བྱས་པས་བསྐྱེད་བསྐྱེད་ན་ད་ཅིའི་ཕྱིར་ཉེས་པར་སྤྱོད་པའི་ལས་འདི་ལྟ་བུ་བྱེད།",
    "ཕའི་ལས་རྗེས་སུ་སྒྲུབ་པས་ནི་དེ་ལྟ་མ་ལགས་ཀྱི་མཆིའོ་ཞེས་དེ་གཉིས་ཀྱིས་དེའི་ཚིག་ཚིག་མ་ཡིན་པར་བྱས་ཏེ་དོང་ནས།",
    "ལུས་ཞིག་ན་ཡང་ལྷ་རྣམས་ཀྱི་ནང་དུ་སྐྱེ་བར་འགྱུར་བས་རྣམ་པ་ཐམས་ཅད་དུ་བདག་ཉིད་གསད་པར་བྱའོ་སྙམ་དུ་སེམས་སོ།",
    "ཡང་བདག་ཉིད་གསོད་པར་བྱེད་པ་ནི་སྡུག་བསྔལ་བ་ཡིན་གྱིས།",
    "གཞན་གྱི་སྲོག་གཅོད་པས་འཚོ་བར་བྱེད་པ་ཡིན་པས་དེ་གཉིས་ཀྱི་བདག་གསོད་པར་ནུས་ཀྱི།",
    "དེ་གཉིས་ཁོ་བོས་དད་པས་སྦྱིན་པར་བྱ་བས་བསྐྱེད་བསྐྱེད་ན་དེ་གཉིས་ད་ཉེས་པར་སྤྱོད་པའི་ལས་བྱ་བ་ལ་ཞུགས་ཤིང་ཕའི་ལས་རྗེས་སུ་སྒྲུབ་པར་བྱེད་དེ།",
