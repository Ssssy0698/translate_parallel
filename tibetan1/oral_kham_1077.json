    "མཁར་རྗོད་བཙན་པོར་འདུག་པ་དང་།",
    "སྐབས་གཞན་དུ་འདུ་འགྲོ་འདུག་སྤྱོད་ལམ་རང་དུགའ་བའི་དུས་སུ་ཡང་རུང་སྟེ་དདམ་ཤུགས་དྲག་པོསཔོ་ཏ་ལ་སོགས་དག་པའི་ཞིང་མཆོག་ནས།",
    "རྗེ་ཁྱེད་རང་རྣམས་ཀྱིས་བྱིན་གྱིས་རློབས།",
    "དེ་ལྟར་འབར་མ་ཟད་ལོ་ཟླ་ཞག་དུས་ནམ་འཆིལ་ངེས་པ་མེད་པས་དེ་རིང་ཙམ་ཡང་མི་འཆིབའི་གདེདས་མེད།",
    "ཀ་དག་ལྷུན་གྲུབ་ཀྱི་ཀུན་བཟང་རང་ཞལ།",
    "འཚོལ་དགོས་མི་འདུག་སྟེ་འཚོལ་མཁན་རད་ཡིན།",
    "ཚེ་ཚུལ་གྱིས་འདིར་འདུག་སྙམ་པ་ཡི།",
    "དེ་གཉིས་གང་ཡངམ་ཡིན་པའི་རྣམཔའཆར་ཚུལ་ཞིག་མིའདུག་སྙམ་དུ་ཐག་བཅད་དོ།",
    "མེཤེལ་ས་བོན་སྐྱུད་དང་སྤུས་ དཔེ་འདི་རྣམས་བཏགས་པས་ཀྱང་རང་བཞིན་གྱིས་བདག་མེད་པ་དར།",
    "ཇིལྟར་མི་དག་གངས་རིའི་ཁྲོད་འདུག་ནས།",
    "དོར་བ་མེད་པསྟོང་པ་ཉིད་དང་རང་བཞིན་སྟོང་པ་ཉི་ད་དུང་།",
    "དེ་ཡང་རང་བཞིནགྱིས་སྟོང་པའོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "རྒྱས་པར་བསྒོམ་བྱ་དེ་ཡང་རང་སྟེང་དུ།",
    "རང་བདེ་འདོད་ཀྱང་རང་དོན་གཙོར་བཟུད་སྟེ།",
    "སྐལ་བ་བགྲང་ཡས་འདས་ཀྱང་རང་གཞན་དོན་འགྲུབ་པའི་ཁར།",
    "ཁ་ཤར་དུ་བལྟས་ཏེ་འདུག་ལ།",
    "སྤྱི་བོ་ཚུགས་སུ་འདུག་པར་བསམས་ལ།",
