    "འོབས་ཀྱིས་བསྐོར་བ་ནི་དེ་ཉིད་འདུག་གནས་ཏེ།",
    "གྲོང་གཅིག་པའི་འདུག་གནས་གཅིག་གང་ཞེ་ན།",
    "སྤུན་མང་པོའི་ཁྱིམ་སྒོ་གཅིག་པ་ཞིག་ན་སྒོ་ཉིད་འདུག་གནས་ཡིན་ཏེ་གྲོང་དུ་གནས་སམ་འདུག་ན་སྤང་བར་མི་འགྱུར་རོ།",
    "བདག་ལ་བསྐོན་ཅིག་ཅེས་བྱ་བ་ནི་གཉི་གས་བདག་དུས་སུ་བྱིན་ཅིག་པའི་དོན་ཏོ།",
    "དགེ་སློང་དེས་ཕོ་ཉ་དེ་ལ་ཚེ་དང་ལྡན་པ་ཕོ་ཉ་དགེ་སློང་རྣམས་ནི་གོས་ཀྱི་རིན་ལེན་དུ་མི་རུང་སྟེ་བདག་ཅག་དུས་སུ་གོས་ཤིག་རྙེད་ན་ནི་ལེན་ཏོ་ཞེས་བྱ་བ་དེ་སྐད་སྨྲོས་ཤིག།",
    "བྱིན་ན་ནི་ལེགས་མ་བྱིན་ན་ལན་ལྔ་དྲུག་ཏུ་སྣང་བའི་ཕྱོགས་སུ་འདུག་ཤིག།",
    "འདུག་གནས་པར་ཁྱིམ་དང་ཞིང་དང་།",
    "དགེ་སློང་མ་གཉིས་ཀྱང་ངལ་ཏེ་ཉལ་ཞིང་འདུག་པ་གཞན་གྱིས་མཐོང་ནས་ཁྱེད་གཉིས་ཅིའི་ཕྱིར་ཉལ་ཞེས་སྨྲས་ན།",
    "ཕྱག་བྱས་ནས་བསྐོར་ཞིང་དད་དད་ལྟར་བྱས་ཏེ་དགེ་སློང་གཞན་ནི་མེད་རྒན་ཞུགས་ཤིག་དེ་ན་འདུག་པ་དེ་ལ་འདི་གཙུག་ལག་ཁང་འབྱོར་པའམ་བྲེལ་བའི་གནས་ཞེས་དྲིས་ན་དགེ་སློང་དེས་མ་གོ་ནས་གཙུག་ལག་ཁང་ནི་འབྱོར་པའོ་ཞེས་སྨྲས་ནས་རྒན་ཞུགས་དེས་འདི་ན་བྲེལ་བ་མ་ཡིན་གྱི་ཡོ་བྱད་དང་ལྡན་ཞིང་འབྱོར་པའི་གནས་ཡིན་ཏེ།",
    "དེ་ཡང་ཕྱི་རོལ་གྱི་གཞུང་གཞན་ལ་རབ་ཏུ་མཁས་ཤིང་གཞན་དང་རབ་ཏུ་འགྱེད་པ་ལ་བརྩོན་པ་ཞིག་འདུག་གོ།",
    "འདུག་པ་དང་།",
    "འཆར་བ་ནི་ལམ་དུ་ཁྱིམ་པ་དག་དང་གཏམ་བྱེད་ཅིང་འདུག་པ་དང་།",
    "ཁྱེད་མ་འདོང་བར་འདུག་ཤིག་དང་།",
    "དེ་ནས་བསྙེན་དགའ་བོ་ཡང་ལམ་ན་མི་འཕྲད་དོ་ཅོག་དང་གཏམ་ཟླ་ཡོད་ཀྱི་བར་དུ་འཁྱལ་ཞིང་འདུག་གོ།",
    "དེ་ཡང་རྒན་ཞུགས་ལ་གནོད་པར་བསམས་ནས་ཡང་ཐོག་ནས་རྒན་ཞུགས་ལ་བོས་པ་དང་དེ་གང་ན་ཟེར་བའི་ཐད་ཀར་ཁྲིའི་རྩ་བ་གཟེར་བུ་མེད་པ་འབྱུང་སླ་བའི་སྟེང་དུ་ལྕིད་ཀྱིས་དྲག་ཏུ་ཕབ་སྟེ་འདུག་པས་ཁྲིའི་རྩ་བ་ལྟུང་ནས་རྒན་པོའི་འཕྲལ་པ་ལ་ཕོག་སྟེ།",
    "དེ་ལྟར་གྱུར་པ་དགེ་སློང་དག་ལ་བྱས་པ་སྙན་དུ་བདས་ནས་ཁྲི་རྩ་བ་འབྱུང་སླ་བ་ལ་འདུག་ཏུ་མི་གནང་བར་བསླབ་པ་བཅས་སོ།",
    "ཁྲི་བཀན་ཏེ་འདུག་པ་ལ་ལྕིད་ཀྱིས་ཕབ་ཀྱང་ཉེས་པ་མེད་དོ།",
    "ཆུང་མ་རྙིང་པ་སྦེད་མའི་ཁྱིམ་དུ་ཕྱིན་ཏེ་དེར་སྟན་བཏིང་བ་ལ་འདུག་ནས་སྔོན་ཇི་ལྟར་བསྙེན་པ་དང་།",
    "སྦེད་མ་འབའ་ཞིག་ལྷ་ཁང་ནས་ཕྱག་ཅིང་འདུག་པའི་གན་དུ་ཚེ་དང་ལྡན་པ་འཆར་བ་འོངས་ནས་ཁོང་གཉིས་སྔོན་ཇི་ལྟར་རྩེ་ཞིང་དགའ་བ་དང་།",
    "གཞན་ནི་གོང་ན་འདུག་པ་བཞིན་དུ་སྦྱར་རོ།",
    "བདག་ནི་ལས་ཆེས་ཏེ་ཉམ་ཆུང་ཞིང་ཉལ་ཞིང་འདུག་གོ།",
    "སྤྱོད་ལམ་ལས་ཉམས་པ་ནི་གང་ལ་སྟན་འདུག་པ་དེ་ལས་ལངས་པ་སྟེ།",
    "ལས་དུས་ནི་དགེ་སློང་དག་ཅིག་ཕྱག་དར་དང་དཀྱིལ་འཁོར་དག་བྱས་པས་ཆད་དེ་ཉལ་ཞིང་འདུག་པ་སྙན་དུ་བདས་ནས་རྗེས་སུ་གནང་སྟེ།",
    "བདག་ཅག་དུས་སུ་ནི་ཟན་མ་རྙེད་དེ།",
    "དགེ་སློང་སྨྱེ་ངན་བྱེད་པའི་གནས་སུ་འདུག་ཏུ་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "འཕགས་པ་འཆར་བ་ནི་དེ་ཙམ་རྣམ་པར་གྲོལ་བའི་བསམ་གཏན་བྱེད་ཅིང་འདུག་གོ།",
    "སྤྱད་ཟིན་ནས་བལྟས་ན་འཆར་བ་འདུག་པར་མཐོང་ནས།",
    "སྨྱེ་ངན་བྱེད་པའི་གནས་སུ་འགྲེང་ཞིང་འདུག་ཏུ་མི་གནང་བའི་བསླབ་པ་བཅས་སོ།",
    "གཙུག་ལག་ཁང་ལམ་ཀ་ན་འདུག་པའི་ལམ་ཀ་ནས་འདོང་བ་དང་།",
    "རི་བྲགས་ཀྱི་གྲོང་དེ་ཉིད་ཀྱང་ད་རུང་མ་ཕེབས་ནས་རྒྱལ་པོ་ཡང་ཕྲུ་མ་དེ་ཉིད་དུ་འདུག་གོ།",
    "རྒྱལ་པོ་དང་བློན་པོས་འདུག་ཤིག་ཅེས་བསྒོ་བའམ།",
    "དགའ་བོ་གོས་ངན་པ་ཞིག་གྱོན་བཞིན་དུ་འདུག་པ་གནས་བརྟན་གོས་ངན་པ་འདི་ངས་བཀྲུའོ་ཞེས་ནས།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྣམ་ཕྱི་ས་ན་འདུག་པ་དང་།",
    "འདུག་ན་ཡང་ངོ།",
    "དགེ་སྦྱོང་སྤངས་པ་དང་ལྷན་ཅིག་བསྟེན་ཅིང་འདུག་ཏུ་མི་གནང་བའི་གླེང་གཞི་ནི་མཉན་དུ་ཡོད་པ་ན་སྟེ།",
    "དེ་གཉིས་ཀྱི་ཁང་པ་བརྩིགས་ཤིག་དུས་དུས་སུ་འོང་ངོ་ཞེས་དུས་བྱས་སོ།",
    "ཛེ་ཏའི་ཚལ་དུ་བསྒུགས་ན་བསྙེན་དགའ་བོའི་གདོང་ལས་ཚོན་ཞིག་འདུག་པ་མཐོང་སྟེ།",
    "གཙུག་ལག་ཁང་དང་ཀུན་དགའི་མཚམས་ཀྱི་ནང་ན་འདུག་པའོ།",
    "མཉན་དུ་ཡོད་པ་ན་འཕོང་རྩལ་སློབ་པ་དག་ཅིག་འདུག་པར་མཐོང་སྟེ།",
    "ཚེ་དང་ལྡན་པ་ཨུ་པཱ་ལི་ནི་སྐམ་ལ་འདུག་གོ།",
    "འཕགས་པ་དེ་ཡང་སྒོ་གཅོད་ཅིང་ནང་ན་འདུག་པ་དང་།",
    "ལམ་གྱི་བར་དུ་གང་ན་རྫིང་བུ་ཞིག་ཆུས་གང་ཞིང་འདུག་པའི་གན་དུ་ཕྱིན་པ་དང་།",
    "ཅང་མི་སྨྲ་བར་བཞབས་ཏེ་ཉན་ཅིང་འདུག་ཅེས་བྱ་བ་ནི་ཅང་མི་ཟེར་བར་འཇབ་པའོ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་སྒོ་ཞེས་བྱ་བ་ནི་ཁྱིམ་དེ་ན་ཁྱིམ་པ་གང་འཁོད་པའོ།",
    "རྒྱལ་པོ་གསལ་རྒྱལ་ཀྱང་དེར་འདུས་ཏེ་འདུག་གོ།",
    "ཚེ་དང་ལྡན་པ་སྔོན་འདི་ན་འདུག་ཅེས་བྱ་བ་ནི་དེ་དག་གང་ཡིན་པའོ།",
    "དགེ་སློང་ཁ་ཅིག་ནི་འོག་ཁང་ན་ཟན་ཟ་ཁ་ཅིག་ནི་སྒོ་ཁང་ན་ཟ་ཞིང་འཁོད་པ་ལས་དེ་ན་དགེ་སློང་མ་ཞིག་བསྒོ་ཞིང་འདུག་ན།",
    "གྲོང་དུ་ཇི་ལྟར་འཇུག་ཅིང་ཁྱིམ་དུ་འདུག་པར་བྱ་བ་དང་།",
