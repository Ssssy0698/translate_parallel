    "དེ་ལ་ནང་ལུས་ཀྱི་ཆ་རྣམས་རྫོགས་པར་ཤེས་དགོས།",
    "ཕྱི་ནང་གཞན་གསུམ་སྦྱོར་བའི་བསྐྱེད་རིམ་ཇི་ཙམ་རྒྱས་པ་ཙམ་གྱིས་རྫོགས་རིམ་གྱི་སྨིན་བྱེད་ཁྱད་པར་དུ་འགྱུར་ལ།",
    "དེས་སྨིན་པར་བྱས་པའི་རྫོགས་རིམ་གྱི་ཆ་དང་།",
    "དེ་ཡང་འགྲེལ་པར།",
    "དེའི་ཚེ་ཀུན་རྫོབ་ཀྱི་སྣང་བ་མ་ལོག་པར་ཡོད་ཀྱང་དེའི་རྗེས་སུ་མི་འཇུག་པར།",
    "གཟུགས་སྐུའི་རྣམ་པ་ལམ་བྱེད་དུ་འགྱུར་ཞིང་དམིགས་པ་ལྷའི་རྣམ་པ་ལ་དམིགས་ནས་འཛིན་སྟངས་ཀྱི་རྣམ་པ་རང་བཞིན་མེད་པར་རྟོགས་པ་དང་།",
    "ཁམས་གསུམ་པོ་ཚིགས་སུ་བཅད་པ་འདི་ཡིས་རྣམ་པར་དཔྱད་པར་བྱ་སྟེ།",
    "འདི་དག་ལ་ལོག་པར་རྟོག་པ་དུས་འཁོར་གྱི་སྒྲུབ་ཐབས་པདྨ་དཀར་པོའི་ཞལ་ལུང་ལ་ལོག་རྟོག་སེལ་ཚུལ།",
    "འགོག་པའི་ཚུལ་སྒྲུབ་ཐབས་སུ་གསུངས་པའི་དོན་བསྡུས་ན།",
    "འདིར་ཤུ་ནྱ་ཏཱ་སོགས་ཀྱི་སྔགས་དོན་སྒོམ་དགོས་པར་གསུངས་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
    "གང་ཡང་རུང་བ་གཅིག་འཐད་པ་དང་གཞན་མི་འཐད་པར་བསྒྲུབ་མི་ནུས་ཏེ།",
    "ཞེས་དཔེའི་སྒོ་ནས་འགྲེལ་ཆེན་ལས་གསུངས་པ་དང་།",
    "འདི་ལྟར་ཤེས་པར་བྱ་སྟེ།",
    "རྒྱ་མཚོ་དྲུག་དེའི་ཕྱི་རོལ་ཏུ་འོག་ཏུ་ཆུའི་དཀྱིལ་འཁོར་གྱི་མཐའ་སའི་དཀྱིལ་འཁོར་གྱི་ཕྱི་ནས་བསྐོར་བ་ལ་རྒྱ་མཚོ་བདུན་པར་བྱས་པས་མཚོ་བདུན་ཞེས་ཟེར།",
    "རི་རབ་ཀྱི་ལྟེ་བ་དང་མཐུན་པར་སྣ་ཚོགས་པདྨ་སོར་དྲུག་པ།",
    "ཕྱི་རོལ་གྱི་ཟླ་ཉི་སྒྲ་གཅན་དུས་མེ་དང་མཐུན་པར་དེའི་དབུས་སུ་ཡང་དེ་དག་བསྐྱེད་པ་ཡིན་ནོ།",
    "དེ་ཡང་མགྲིན་པའི་སོར་གོང་མ་བཞི་ཡན་ཆད་དུམ་བུ་བཞིར་བྱས་པ་ལ་གཟུགས་ཁམས་ཀྱི་གནས་བཞི་ཚན་བཞི་དང་སྦྱོར་བ་ཡིན་ཞིང་།",
    "ཁམས་ལས་ཁམས་གོང་མར་འཇོག་པ་བཞིན་དུ་ཡ་ནས་གོང་ན་ཡོད་པ་བཞིན་མཛད་ནས་རྣམ་གཞག་བྱས་པའོ།",
    "ཞིབ་ཏུ་འགྲེལ་པ་ལས་རྟོགས་པར་བྱ་སྟེ་འདིར་མངས་སུ་དོགས་པས་མ་སྤྲོས་སོ།",
    "ཐིག་ལེ་སྟེང་དུ་བྱས་པས་ཁམས་དཀར་པོ་སྟེང་ནས་ཞུ་བ་མཚོན་ཞིང་།",
    "དེ་ལས་ལྷར་བསྐྱེད་པ་༢༨བ་ནི་བདེ་བ་ཆེན་པོའི་ཡེ་ཤེས་ཀྱི་གཟུང་རྣམ་སྟོང་གཟུགས་ཀྱི་འདོད་ལྷ་ཡབ་ཡུམ་གྱི་སྐུར་ཤར་བ་མཚོན་པར་བྱེད་དོ།",
    "ཟླ་བའི་དཀྱིལ་འཁོར་ལ་ཨ་སོགས་དབྱངས་སུམ་ཅུ་དང་ཐིག་ལེ་དང་རྣམ་པར་བཅད་པ་སྟེ་སུམ་ཅུ་རྩ་གཉིས་པོ་རྣམས་མཚན་སུམ་ཅུ་རྩ་གཉིས་ཀྱི་དོན་དུ་གཡོན་དང་གཡས་སུ་བསྐོར་བས་དགོད་པར་བྱའོ།",
    "ཞེས་སོགས་ཀྱི་ཟླ་ཉིའི་སྟེང་དུ་དབྱངས་གསལ་འགོད་པར་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
    "གསུངས་ཤིང་དབྱངས་གསལ་གྱུར་པ་ལས་ཀྱང་ཟླ་ཉི་བསྐྱེད་དགོས་ན།",
    "ཟླ་བ་གཉིས་དང་ཉི་མ་གཉིས་བསྐྱེད་དགོས་པར་འགྱུར་ནའང་།",
    "ཞེས་གསུངས་པའི་མེ་ནི་དུས་མེ་ཡིན་ལ།",
    "དེའི་འགྲེལ་པར།",
    "ཟླ་བ་དང་ཉི་མ་དང་མེ་ཡང་དག་པར་ལྡན་པ་དེ་ཉིད་དཀྱིལ་འཁོར་གྱི་གདན་ནོ་ཞེས་གསུངས་པས་ནི་རྩ་བའི་མེ་ཞེས་པའི་སྒྲས་སྒྲ་གཅན་ཡང་འཕངས་པར་སྟོན་གྱི།",
    "དུས་མེ་གདན་དུ་མེད་པར་སྟོན་པ་༢༩ན་མིན་ནོ།",
    "ལྟེ་བ་མན་ཆད་ཀྱི་ཡེ་ཤེས་ཀྱི་ཁམས་དུས་མེའི་རྩ་དུང་ཅན་མ་གཉིས་ཀ་བསྟན་པར་ཤེས་པའི་ཕྱིར་དུང་ཅན་མའི་རྩ་ལ་སྒྲ་གཅན་གྱི་རྩའི་ཐ་སྙད་ཀྱིས་གསུངས་པ་ཡིན་ནོ་ཞེ་ན།",
    "འོ་ན་གདན་གྱི་སྐབས་སུ་ཡང་འགྲེལ་པར་སྒྲ་གཅན་གྱི་ཐ་སྙད་ཀྱིས་དུས་མེའི་གདན་ཡང་བསྟན་པར་ཁས་བླང་བར་རིགས་སོ།",
    "དུས་མེའི་ས་བོན་སོ་སོར་མ་གསུངས་པ་ཅི་ཡིན་ཞེ་ན།",
    "ཨོཾ་ཨ་ཨ་སྟེ་ཟླ་བ་དང་ཉི་མ་དང་སྒྲ་གཅན་གྱི་གདན་རྣམས་སོ་ཞེས་གསུངས་པས་ནི།",
    "གཞན་ཡང་གཙོ་བོའི་གདན་ལ་དུས་མེ་མེད་པར་འདོད་པ་ནི།",
    "ཞེས་གསུངས་པའི་ལུང་གསལ་ཁ་ཅན་འདི་ལྟ་བུ་ལ་དངོས་སུ་བསྙོན་པར་བྱེད་པའོ།",
    "གཡོན་རྐྱང་མ་ལ་གཙོ་བོར་བརྟེན་པ་ཁམས་དཀར་པོ་འོག་ནས་སྟེང་དུ་དྲངས་ཏེ་གཙུག་ཏོར་དུ་བརྟན་པར་བྱས་པ་མཚོན་པའི་ཞབས་གཡས་པ་དམར་པོ་བརྐྱངས་པ་དང་།",
    "དེ་ཉིད་སྙོམས་པར་ཞུགས་པ་ལ་བརྟེན་ནས་སེམས་བདེ་སྟོང་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱི་ངོ་བོར་བསྐྱེད་པ་ལས་འབྲས་བུའི་སྐབས་སུ་སྐུ་སྟོང་གཟུགས་ཀྱི་དུས་ཀྱི་འཁོར་ལོ་ལ་སྟོང་གཟུགས་ཀྱི་སྣ་ཚོགས་ཡུམ་གྱིས་འཁྱུད་པ་དང་།",
    "དེ་ལྟར་འབྲས་བུའི་གནས་སྐབས་སུ་དབུགས་ཀྱི་རྒྱུ་བ་མ་ལུས་པར་འགག་པའི་སྲོག་ཆེན་པོ་ནི་དུས་ཞེས་བྱ་ལ།་",
    "ཅེས་གསུངས་པ་ལྟར་རོ།",
    "བཞི་བཞིར་བྱས་པའི་གསུམ་ཚན་དག་པས་མགྲིན་པ་གསུམ་དང་།",
    "བཞིར་བྱས་པ་དག་པའི་ཞལ་བཞི་དང་།",
    "གཉིས་གཉིས་སུ་བཅད་ནས་དྲུག་ཚན་དུ་བྱས་པ་དག་པའི་ཕྲག་པ་དྲུག།",
    "དུས་སྦྱོར་ཕྱེད་པ་ཉི་ཤུ་རྩ་བཞིར་བྱས་པ་དག་པའི་ཕྱག་ཉི་ཤུ་རྩ་བཞི།",
    "རྣམ་པར་དག་པ་མི་བསྐྱོད་པའི་ངོ་བོ་དཀྱིལ་འཁོར་གྱི་བདག་པོ་དེས།",
    "དེ་ནས་མངལ་དུ་ཟླ་བ་ལྔ་པ་དང་དྲུག་པ་ལ་ཕུང་པོ་དང་ཁམས་ཚོགས་པ་དེ་ལ་བརྟེན་ནས་སྐྱེ་མཆེད་དྲུག་སྐྱེ་བ་དང་མཐུན་པར་སེམས་དཔའ་སེམས་མ་རྣམས་༨ ༣༢ན་སྤྲོ་བར་བྱེད་ལ།",
    "ཡེ་ཤེས་ཀྱི་ཁམས་ལས་སྐྱེས་པའི་ཡིད་དང་སྒྲ་རྣམ་པར་དག་པའི་ཀུན་བཟང་དང་སྒྲ་རྡོ་རྗེ་མ་གཉིས་ཡེ་ཤེས་ཀྱི་ཁམས་དག་པ་རྡོར་སེམས་ལྟ་བུ།",
    "འདི་དག་གང་དུ་འགོད་པའི་གནས་སྒྲུབ་ཐབས་སུ་མཛད་པ་བཞིན་འགྲེལ་པར་གསལ་བར་ཡོད་ལ།",
    "མགྲིན་པའི་འཁོར་ལོ་ལ་རྩ་འདབ་སོ་གཉིས་ཡོད་པའི་སུམ་ཅུ་ཡུད་ཙམ་འབབ་པ་གཉིས་སྟོང་པའི་རྩ་སྟེ་དེ་ལྟར་མགྲིན་པ་ནས་སྤྲུལ་པའི་འཁོར་ལོའི་བར་གྲུ་བཞིར་བྱས་པ་དེ་གྲུབ་པ་དང་།",
    "དེ་ཡང་དཔྲལ་བ་ནས་གསང་བའི་པདྨའི་མཐར་གྲུ་བཞིར་བྱས་པས་མཚོན་ཞིང་།",
    "ཚེས་ཞག་སུམ་བརྒྱ་དྲུག་ཅུར་བྱས་པ་དང་།",
    "འདི་རྣམས་ཀྱི་ས་བོན་དུ་གྱུར་པའི་སྔགས་ཀྱི་ཡི་གེ་ཁམས་ཀྱི་སྒོ་ནས་གསུངས་ཤིང་།",
    "དེ་ལ་བརྟེན་ནས་ཐབས་ཤེས་སུ་འགྱུར་ཚུལ་ཡང་རྟོགས་པར་བྱ་སྟེ།",
    "དེ་ཡང་ཤེས་རབ་ལ་ཐབས་ཀྱི་ཉིས་འགྱུར་དུ་བྱས་ནས་ལྷོ་བགྲོད་ལ་གསལ་བྱེད་རྐྱང་པ་དབྱངས་ཐུང་དུ་སྲོག་ཏུ་ཞུགས་པ་དང་།",
    "ཞག་ཐམས་ཅད་ཀྱི་གསལ་བྱེད་ཀྱི་ཡི་གེ་བརྩེགས་པ་མེད་པར་རྐྱང་པ་འབའ་ཞིག་གསུངས་ལ།",
    "ཁམས་ཀྱི་སྐྱེ་རིམ་དང་མཐུན་པར་སྦྱར་བ་རྣམས་ཀྱི་ས་བོན་དུ་སྦྱོར།",
    "གཞན་སྐྱེ་རིམ་ལ་མངལ་དུ་ལུས་གྲུབ་པ་དང་མཐུན་པར།",
    "ལྷ་རྣམས་སྐྱེ་བའི་རིམ་པ་དང་མཐུན་པར་སྦྱོར་བས།",
    "འཆད་པར་འགྱུར་བའི་ས་བོན་དང་པོར་གྱུར་པ་རྡོ་རྗེའི་མཐའ་ཅན་ནི་འདི་རྣམས་ཀྱི་མཚན་དུའགྱུར་རོ།",
    "ཞེས་ཙ་རྡོ་རྗེ་མ་སོགས་ས་བོན་ཐོག་མར་སྦྱར་བར་གསུངས།",
    "མངལ་དུ་ཟླ་བ་དགུའི་མཐར་ལུས་རྫོགས་པ་དང་མཐུན་པར་ལྷ་རྣམས་རྫོགས་པར་བསྐྱེད་པའོ།",
    "ཡིན་པས་འདིར་གསལ་འདེབས་པ་ནང་འགྲུབ་པའི་དུས་ནང་ལ་སྦྱོར་བའི་ཐུགས་འཁོར་གྱི་དག་པ་དང་མཐུན་པར་གྲུབ་ཟིན་གསལ་འདེབས་པའོ།",
    "དེའི་འོག་ཏུ་རང་ལུགས་ཀྱི་འཐད་པ་སྒྲུབ་པ་བརྗོད་པར་བྱའོ།",
    "ཐུགས་དཀྱིལ་གྱི་སྒྲུབ་ཐབས་ཡན་ལག་བཞི་པར།",
    "ཞེས་པ་ཙམ་ལས་བསྐྱེད་ཚུལ་གཞན་མ་གསུངས་ཀྱང་དཔལ་ལྡན་རྒྱུ་སྐར་གྱི་དཀྱིལ་འཁོར་དུ་ཟླ་ཉི་བསྐྱེད་པའི་རྗེས་སུ།",
    "འདུ་ཤེས་ཀྱི་ཕུང་པོར་སྐྱེད་པར་བྱེད་པ་སྣང་བ་མཐའ་ཡས་སོ།",
    "འདུ་བྱེད་ཀྱི་ཕུང་པོ་སྐྱེད་པར་བྱེད་པ་དོན་ཡོད་གྲུབ་པའོ།",
    "ཞེས་གསུངས་པ་འདི་རྣམས་དང་འགལ་བར་མངོན་སུམ་དུ་གྲུབ་པ་ན།",
    "འདིར་ཕྱག་མཚན་སྔགས་ཀྱི་རིམ་པ་བཞིན་བསྐྱེད་པར་འདོད་པའི་ལུགས་འགྲེལ་ཆེན་ལས་ལྷ་རྣམས་སྐྱེ་བའི་དུས་སུ་རྒྱན་ཐམས་ཅད་དང་བཅས་པར་སྐྱེ་སྟེ།",
    "ཞེས་གསུངས་ཤིང་།",
    "དེ་ལྟར་གསུངས་པའི་དགོངས་པ།",
    "ཤེས་རབ་ཕ་རོལ་ཕྱིན་མས་འཁྱུད་པའི་རྣམ་པར་ཤེས་པ་དག་པའི་བདག་ཉིད་མི་བསྐྱོད་ལྟར།",
    "དེ་མི་འཐད་པར་བསྟན་ནས་རང་ལུགས་ལ་དང་པོ་གཉིས།",
    "ཁ་དོག་ལྗང་ཁུ་དང་སྔོན་པོ་ཡིན་པས་ཁྱབ་པར་གང་དུ་ཡང་མ་བསྟན་ཞིང་།",
    "ལོག་པར་རྟོག་པའི་ཚུལ་དང་དེ་དགག་པ་གཉིས།",
    "དེས་ན་མགོ་རྒྱལ་གྱི་ལྷ་སྔོན་པོ་ཡིན་པ་དང་།",
    "ད་ནི་མི་བསྐྱོད་པའི་རིགས་སྤྲོ་བ་གསུངས་པ།",
    "ད་ནི་རྡོ་རྗེ་སེམས་དཔའི་རིགས་སྤྲོ་བ་གསུངས་པ་ཞེས་པ་ནས།",
    "ཀླུ་རྣམ་པར་རྒྱལ་བ་སྟེ།",
    "རྡོ་རྗེ་སེམས་དཔས་རྒྱས་བཏབ་པ་ལས་ཐམས་ཅད་སྒྲུབ་པར་བྱེད་པའོ།",
    "ཚཞེས་པས་གསལ་བར་གསུངས་པའི་ཕྱིར་རོ།",
    "དྲག་པོ་དཀར་པོ་སོགས་ཨ་བྷ་ཡའི་ལུགས་ལེགས་པར་སྨྲ་བ་དག་ནི།",
    "ད་ནི་དེ་ལ་དགག་པ་བརྗོད་པར་བྱ་སྟེ།",
    "ཡེ་ཤེས་ལེའུ་ནས་གསུངས་པ་བཞིན་བྱེད་དགོས་པ་ལ་ཤེས་བྱེད་མེད་ན།",
    "ཡེ་ཤེས་ལེའུ་ལས་གསུངས་པ་དེ་སྒྲུབ་ཐབས་ཀྱི་སྐབས་འདིའི་ལྷའི་བསྐྱེད་ཆོག་སྟོན་པ་ཡིན་པའི་ཕྱིར་ཞེས་ཟེར་ན།",
    "སྐབས་དེར་སྨྲས་པ་དེ་དག་འགྲེལ་པར་བསྲུང་འཁོར་གྱི་སྐབས་དེར་མ་བསྟན་པས་དེ་ལྟར་བྱེད་པ་ལ་ཤེས་བྱེད་གང་ཡང་མེད་པར་འགྱུར་ཏེ།",
    "ཡེ་ཤེས་ལེའུ་ལས་སྐབས་དེར་གསུངས་པ་དང་།"
  ]
}