    "དེའི་རྗེས་སུ་མཆོད་བསྟོད་བྱས་ཏེ་གཤེགས་སུ་གསོལ་བ་དང་།",
    "འདིས་འགྲེལ་པ་ལས་གསུངས་པའི་དོན་གྱི་རིམ་པ་ཇི་ལྟ་བ་བཞིན་མཛད་པར་དགོངས་ལ།",
    "དངོས་སུ་མཛད་པ་ཕལ་ཆེ་བ་ནི་འགྲེལ་པ་ལས་གསལ་བར་གསུངས་སོ།",
    "གཞན་ཕྱག་མཚན་སོགས་ཁྱད་པར་མེད་པར་གསུངས་པ་ནི་སྔར་བསྲུང་འཁོར་གྱི་སྐབས་སུ་དེ་ལྟར་སྔགས་དང་ཕྱག་རྒྱས་དགོད་པར་བྱ།",
    "ཞེས་གསུངས་པ་བཞིན་རྡོ་རྗེ་ཤུགས་ཀྱི་ཕྱག་མཚན་སོགས་སྔགས་ཀྱིས་འགོད་པར་འདིར་ཡང་བསྟན་པ་ཡིན་ཞིང་།",
    "ཟད་པར་དང་གཟའ་རྣམས་ཀྱི་ཕྱག་མཚན་མི་མཐུན་པ་ལ་སོགས་པ་ལུགས་སྣ་ཚོགས་པ་དང་།",
    "གཉིས་པ་འགྲེལ་ཆེན་ལས་ཇི་ལྟར་གསུངས་པའི་ཚུལ་ནི།",
    "ཆོ་གའི་ཡན་ལག་རྣམས་གོ་རིམ་འཁྲུགས་པ་དང་མི་གསལ་བའི་ཚུལ་གྱིས་གསུངས་པ།",
    "མཁའ་འགྲོ་མ་རྣམས་ལ་གཏོར་མ་སྦྱིན་པ་སོགས་ཀྱིས་བགེགས་བཟློག་པར་གསུངས།",
    "ཚོགས་ཀྱི་སྔགས་ཀྱི་ཚིག་རྣམས་ནི་ལེའུ་ལྔ་པ་ལས་སྔགས་འདི་བརྗོད་པར་བྱ་སྟེ།",
    "ས་སླང་བ་སྦྱངས་པ་སོགས་བར་བར་དུ་གསུངས་པ་རྣམས་མི་དགོས་པས་དོར་ཏེ།",
    "གསུམ་པ་འགྲེལ་པའི་དགོངས་པ་དང་མཐུན་པར་རང་ལུགས་འཇོག་པའི་ཚུལ་ལ་གསུམ།",
    "འོག་ཏུ་དངོས་གཞིའི་སྐབས་སུ་བྱེད་པ་དང་ཟློས་པར་འགྱུར་བས་སོ་སྙམ་ན།",
    "ལམ་ལ་བརྟེན་པར་བྱས་ཏེ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་ཧོ་ཧཾཀྵཔྲཛྙ་པ་ཡོ་སོགས་གསུངས་སོ།",
    "དེས་ན་བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པས་ཀྱང་།",
    "དེའི་དགོས་པ་སྐབས་འདིར་བྱས་པས་ཀྱང་འགྲུབ་པ་དང་།",
    "པར་གསུངས་ཀྱང་།",
    "སྐབས་འདིར་རྡོར་སེམས་ཡེ་ཤེས་ཀྱི་ཁམས་དག་པའི་ས་བོན་ཀྵལས་བསྐྱེད་པར་གསུངས་པ་དང་མཐུན་པར་མཛད་པ་ཡིན་ནོ།",
    "དེའི་རྗེས་སུ་སྐུ་གསུང་ཐུགས་ཡེ་ཤེས་རྣམ་པར་དག་པ་བྱ་བའི་ཚུལ་དངོས་ནི།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་ཧོ་ཧཾཀྵཔྲཛྙ་པ་ཡོ་ཞེས་སོགས་ཀྱི་སྔགས་བརྗོད་ནས་བྱ་བར་གསུངས་པའི་སྔགས་དོན་ནི་ཐབས་དང་ཤེས་རབ་ཀྱི་བདག་ཉིད་སྐུ་གསུང་ཐུགས་ཡེ་ཤེས་༡༢ན་རྡོ་རྗེའི་བདག་པོ།",
    "ཕུང་པོ་ཁམས་སྐྱེ་མཆེད་རྣམས་རང་བཞིན་མེད་པར་གཞི་ཚུགས་ཤིག།",
    "ཞི་བ་དང་རྒྱས་པ་ལའོ་ཞེས་འགྲེལ་ཆེན་ལས་དངོས་སུ་གསུངས་པ་བཞིན་འདིར་སྐབས་སུ་བབ་པས་མཛད་ལ།",
    "འདི་ལས་གཞན་མི་དགོས་པར་འདོད་པ་ནི་དོན་མ་རྟོགས་པ་སྟེ།",
    "དེའི་འོག་ཏུ་ཕྱག་རྒྱ་དང་སྔགས་ཀྱིས་ཡན་ལག་ཐམས་ཅད་བྱིན་གྱིས་བརླབས་ཏེ་སྐུ་གསུང་ཐུགས་ཡེ་ཤེས་རྣམ་པར་དག་པར་བྱ་བ་ལ་ཐོག་མར་ཕྱག་རྒྱ་བཅིང་བའི་དོན་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
    "དེ་ནས་ལག་པ་གཉིས་ཟླ་ཉི་ཧཱུཾ་དང་བཅས་པ་ཡོངས་སུ་གྱུར་པ་ལས་རྡོ་རྗེ་རྩེ་ལྔ་པར་བསྐྱེད་ཚུལ་འདི་དག་འགྲེལ་པ་ལས་གསལ་བར་གསུངས་ཤིང་།",
    "སྔོན་དུ་ཞིང་སྐྱོང་ལ་གཏོར་མ་བྱིན་ནས་བདུད་བགེགས་བསྲེག་པར་གསུངས་པ་ནི།",
    "སྐབས་འདིར་གཏོར་མ་སྦྱིན་པའི་སྔགས་ཀྱི་ཚིག་ཨི་དཾ་སྠཱ་ནཾ་ཏྱ་ཀཏྭ་བ་ཤྱེ་མཎྜལ་བྷུ་ཕྱྭ་ཞེས་པའི་དོན་གནས་འདི་དོར་ནས་དཀྱིལ་འཁོར་གྱི་ཕྱི་རོལ་གྱི་གཞི་གནས་པར་མཛོད་ཅེས་པ་ཡིན་ནོ།",
    "འགྲེལ་པར་ཞིང་སྐྱོང་ལ་ས་བསླང་བ་སྐབས་གཞན་གང་དུ་གསུངས།",
    "དུས་ཞབས་པའི་སྒྲུབ་ཐབས་ཡན་ལག་བཞི་པ་ལས་སྔོན་འགྲོ་གཏོར་མ་བྱས་༡༣བ་ནས་བགེགས་བསྲེག་པར་གསུངས་པ་དང་འགལ་ལོ་སྙམ་ན།",
    "བསྲུང་མ་དྲུག་ཅུའི་གཏོར་མ་མ་མཛད་པར་དེའི་དགོས་པ་ཕྱོགས་གཅིག་སྒྲུབ་པའི་ཕྱིར་སྔོན་འགྲོ་གཏོར་མ་མཛད་པ་ཡིན་ཏེ།",
    "དེ་དང་སྐབས་འདིའི་ཞིང་སྐྱོང་ལ་གཏོར་མ་སྦྱིན་པར་གསུངས་པའི་ཞིང་སྐྱོང་མི་གཅིག་སྟེ།",
    "འདིའི་ཞིང་སྐྱོང་ནི་ས་ཕྱོགས་དེར་གནས་པའི་ཡུལ་བདག་གྲོང་བདག་གནས་བདག་གསུམ་ལ་གསུངས་པའི་ཕྱིར་རོ།་།",
    "རྡོ་རྗེ་དེ་རྣམས་ལས་ཕྱོགས་སོ་སོར་འོད་ཟེར་འཕྲོས་པས་བདུད་དང་བགེགས་བསྲེག་པར་གསུངས་ནས།",
    "སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་སྦྱོར་བ་བརྗོད་པར་བྱ་སྟེ།",
    "འདིར་དང་པོར་སྒྲུབ་ཐབས་ཀྱི་ལེའུ་ལས་འཆད་པར་འགྱུར་བའི་རིམ་པས་ཁ་རྣམ་པར་དག་པ་དང་།",
    "དེ་ལྟར་བྱས་པས་འགྲེལ་པར་བསྲུང་མ་གཞན་རྣམས་ཀྱང་ཁང་ཀྱང་བརྩེགས་དང་རྭ་བའི་ཕྱི་ནང་དུ་འགོད་པར་གསུངས་དེ་ལས་གཞན་པའི་འདོད་ཚུལ་སྣ་ཚོགས་པ་རྣམས་ལ་པདྨ་དཀར་པོའི་ཞལ་གྱི་ལུང་ལས་གནོད་པ་གསུངས་པ་རྣམས་བཟློག་ཏུ་མེད་དོ།",
    "འགྲེལ་པར་འཁོར་ལོ་རྩིབས་བཅུ་པ་ལ་ཁྲོ་བོ་འགོད་པར་གསུངས་པ་ནི།",
    "རྭ་བ་ལྷའི་ཁ་དོག་ནི་ཁམས་ཀྱི་སྐྱེ་རིམ་དང་མཐུན་པར་ནང་ནས་རིམ་པ་བཞིན་དཀར་དམར་ནག་པོ་གསུམ་དང་།",
    "ཡུལ་འཁོར་གྱི་མཚམས་ཇི་ཙམ་ཡིན་འགལ་བར་དངོས་སུ་མ་གསུངས་ཀྱང་།",
    "ཐོག་མར་བསྲུང་འཁོར་དང་ཁང་བརྩེགས་ཀྱི་དབུས་སུ་བསྐྱེད་པར་གསུངས་པའི་རྡོ་རྗེ་ཤུགས་ལ།",
    "དེར་གསུངས་པ་དེ་ཡུམ་ཅན་ཡིན་ཞིང་།",
    "གལ་ཏེ་ཡེ་ཤེས་ལེའུ་ལས་གསུངས་པ་མཁའ་འགྲོ་མའི་འཁོར་གྱིས་བསྐོར་བ་དེ་ཡིན་ནོ་ཞེ་ན།",
    "ཡེ་ཤེས་ལེའུའི་༡༧ན་འགྲེལ་བ་ཀློག་པ་ཙམ་ཡང་མ་བྱས་པར་ཟད་དོ།",
    "ལེའུ་དེར་མཁའ་འགྲོ་མའི་ཚོགས་ཀྱི་སྔགས་ཀྱི་ཚིག་རྣམས་ནི་ལེའུ་ལྔ་པ་ལས་སྔགས་འདི་བརྗོད་པར་བྱ་སྟེ།",
