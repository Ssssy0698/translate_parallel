    "བསམ་པ་ཚེམ་བུ་ལ་འགྲོ་བས་གནས་སུ་མི་འདོད་པར་གདའ་ཞུས་པས།",
    "དུས་གཅིག་ཙ་ན་ཐག་པ་གཅུས་པས་ལག་པ་ལ་ཆུ་བུར་བྱུང་ནས་དེ་མ་བཟོད་པར་དབེན་པ་ཞིག་ཏུ་ངུ་ཡིན་བསྡད་པ་ན།",
    "རོའི་རྩར་ངུ་ཡིན་འདུག་ཡང་བུ་ཚ་ཐམས་ཅད་ཀྱང་ཤི་ནས་དུར་ཁྲོད་དེར་བསྐྱལ་ཏེ་སྡུག་བསྔལ་དྲག་པོས་ངུ་འབོད་བྱས་པས།",
    "ཁྱེད་རང་ཡང་འཆི་སྟེ་མི་འཇིགས་སམ་གསུངས་པས།",
    "ཁམས་གསུམ་རྐང་པའི་འོག་ན་འདུག་པ་རྨིས་པས་དང་།",
    "རྐུན་མའི་བསམ་པར་ཐོག་མར་ཁོང་རང་ལ་དྲིས་ནས།",
    "ཁྱེད་རང་ཡང་ལྷ་བཟོ་བར་འབྲིར་ཆུག་ཅིག་བྱས་པས།",
    "སློབ་དཔོན་བྱ་རི་པ་ཞེས་བྱ་བ་ལ་གསེར་ཏོ་ལོ་སུམ་བརྒྱ་དང་མུ་ཏིག་ལ་སོགས་པའི་ནོར་དཔག་ཏུ་མེད་པ་ཞིག་གདའ་བ་ལས།",
    "ཆུ་བོ་གངྒཱར་ཁྲུས་ལ་ཕྱིན་པས་བེ་བུམ་ཞིག་ཆུས་ཁྱེར་བྱུང་བ་བཟུང་སྟེ་བལྟས་པས་བདུད་རྩིའི་སྒྲུབ་ཐབས་སུ་འདུག་པ་དང་།",
    "དུར་ཁྲོད་དུ་འདུག་ཅིང་།",
    "ཁོང་རང་བྲམ་ཟེ་གཞོན་ནུའི་ཆ་བྱད་ཅན།",
    "ཁོང་རང་བྲམ་ཟེའི་ཆ་བྱད་དུ་འབྲི།",
    "སློབ་དཔོན་ཨ་ཙིནྟ་འབྲས་བརྡུང་བ།",
    "གལ་ཏེ་རྒྱུ་ནོར་གསོག་མཁན་མང་ལ་འགྲོ་གྲོན་བྱེད་མཁན་ཉུང་ན་གསོག་པ་མགྱོགས་ལ་འཛད་པ་དལ་བས་རྟག་ཏུ་རྒྱུ་ནོར་གྱིས་ཕྱུག་འདུག་གོ།",
    "དམ་པ་ནི་གནས་གང་དུ་ཡོད་ཀྱང་སྤྲོ་སྣང་སྐྱེས་འདུག་གོ།",
    "ཆང་འདྲེན་སྟེང་སྐྲ་ལོ་དཀར་ནག་ལྟར་འདུག་པ་ནི་རྒན་པ་ཚོར་གུས་བཀུར་བྱེད་པའི་ཆེད་དུའོ།",
    "མུ་མཐའ་བྲལ་བས་དངོས་དགུ་སྤེལ་ལ་ནམ་མཁར་ཀྲོང་ངེར་ལངས་འདུག་གོ།",
    "སྐྱེས་བུ་དམ་པས་རྟག་པར་རང་བློ་སྦྱང་གཤེར་བྱས་བས་འགྱོད་པ་མེད་པ་དང་རང་ལའང་ངོ་གནོང་མི་དགོས་སོ།",
    "གནམ་གྱིས་དོན་དངོས་ཡོད་དོ་ཅོག་སྐྱེལ་འདྲེན་གྱི་བྱ་བ་བྱས་ཀྱང་ཅིའང་མི་སྨྲ་ལ་དྲིའང་མི་བྲོ་བས་མུ་མཐའ་དང་བྲལ་འདུག་གོ།",
    "ཡང་རྒྱལ་ཁབ་ཞིག་ཏུ་སླེབས་ཙ་ན།",
    "ཁོ་རང་ཁྲོན་པའི་ནང་དུ་འབབ་བམ།",
    "བྱམས་ལྡན་ཞེས་པ་དེས་ནི་ཉིད་རང་ཚུགས་ཐུབ་ལ་གཞན་ཡང་རང་ཚུགས་ཐུབ་པར་བྱེད་པ་སེམས་སོ།",
    "བཞིན་འཛུམ་དམུལ་ལེར་གདའོ།",
    "བྱམས་པའི་སྐོར་གྱི་གསུང་ནི་དབུ་ཞབས་ཀུན་ཏུ་ཁྱབ་འདུག་པས་ཉུང་ཞེས་ཅི་ལྟར་ཞེ་ན།",
    "མི་རང་རང་སོ་སོས་འདོད་པ་སྨྲས་ཆོག་གོ།",
    "ཝེ་རྒྱལ་བོས་ཁྱེད་ལ་རྒྱལ་སྲིད་སྐྱོང་རོགས་བྱེད་པར་སྒུག་འདུག་པས།",
    "ཐ་ན་ཀླ་ཀློའི་ཡུལ་དུ་ཕྱིན་ཀྱང་རང་ལུགས་སྤེལ་ཐུབ་པ་ཞིག་གོ།",
    "ཁོང་ཉིད་དེར་འགྲེང་འདུག་པར་ཕྲན་གོམ་འགྲོས་མགྱོགས་པོས་ཁྱམས་ར་བརྒྱུད་པའི་ཚེ།",
    "ང་རང་གདན་ཞུ་བྱེད་མཁན་དེས་ང་རང་ཕྱིན་པ་དོན་མེད་དུ་གཏོང་ངམ།",
    "དེ་ལའང་བསམ་བློ་གཏོང་དགོས་པས་རང་དགར་འདུག་པ་ལས་ལྷག་གོ།",
    "གནམ་འོག་ཀུན་ལ་ཚུལ་མིན་གྱི་སྤྱོད་པ་ཤྭ་འོད་ལྷུང་ལྷུང་དུ་རྒྱུག་པ་བཞིན་ཁྱབ་འདུག་པས།",
    "ཕུགས་འདུན་འགྱུར་བ་མེད་ཅིང་རང་ལུས་ལ་སྐྱོན་གྱིས་མ་གོས་པ་ནི་པོ་དབྱི་དང་ཧུའུ་ཆིའོ།",
    "དེ་ལྟ་བུའི་བསམ་བློ་གནམ་འོག་སྐྱོང་བའི་བླང་བྱ་དང་མཐུན་པ་ནི་རྒྱུ་རྐྱེན་གང་ལ་ཐུག་འདུག་གོམེང་ཙི།",
    "དར་མ་སྟོབས་ལྡན་ཚོ་ཕྱོགས་བཞིར་འཁྱམས་འདུག་པ་མི་ཁྲི་ཕྲག་ལ་སླེབས།",
    "འདུན་མ་དེ་གང་ལ་སླེབས་ན་བློ་སྤོབས་ཀྱང་དེ་ལ་སླེབས་འདུག་གོ།",
    "བྱམས་བརྩེ་ལྡན་པའི་གནས་སུ་འདུག་པ་ན་ད་གཟོད་ཆེས་ཕུགས་འདུན་དང་མཐུན་ནོ།",
    "དངོས་གནས་བདག་རང་ལ་ཐུག་འདུག་ཅེས་སོ།",
    "གནའ་དུས་ཀྱི་སྐྱེས་བུ་དམ་པ་དཔོན་པོ་ལ་འདུག་གམ།",
    "དཔོན་པོར་འདུག་གོ།",
    "གག་གག་ཅེས་གྲག་འདུག་པ་འདི་ཅི་བྱ་ཞེས་སོ།",
    "ཧ་ཅང་དྲག་པོ་མིན་ནའང་རང་ཉིད་ལ་ཉེན་ཁ་ཡོད་པ་དང་རྒྱལ་ཁབ་ཀྱི་སྟོབས་ཤུགས་ཇེ་ཞན་དུ་འགྲོའོ།",
    "ཕ་མ་ལ་སྲི་ཞུ་བྱེད་མཁན་ཁོ་ནས་མི་ཚེ་ཧྲིལ་བོར་དེ་ལ་ཡིད་སྨོན་འཆའ་འདུག་གོ།",
    "ཁོས་གཞུང་དོན་དུ་བྲེལ་བ་ཆེ་བས་ཕ་མར་བསྙེན་བཀུར་བྱེད་མ་ཐུབ་པར་དངན་པ་འཐེན་བཞིན་འདུག་དོན་དག་འདི་དག་གཞུང་དོན་ལས་གཅིག་ཀྱང་མེད་ལ།",
    "ལོ་གསུམ་འགོར་རྗེས་སུ་ཐའེ་ཅ་ལ་འགྱོད་པ་སྐྱེས་ཏེ་རང་གནོང་རང་འགྱོད་སྒོས་ཐུང་ད་བྱི་ལ་བསྐྱེད་དོ།",
    "རྗེ་བོས་སྤྱོད་ཡོན་གཉིས་ལྡན་ལ་བསྙེན་བཀུར་བྱས་ཚེ་དཔོན་པོར་འདུག་གོ།",
    "ལོ་ལྔ་བཅུ་ལ་སླེབས་སྐབས་ད་དུང་ཕ་མ་ལ་ཡིད་སྨོན་བྱེད་འདུག་ཅེས་སོ།",
    "མེང་ཙིས་གནའ་བོའི་བྱམས་སྤྱོད་ལྡན་པ་ཚོས་རང་སྲུང་རང་བཀུར་གྱི་གཤིས་ཀའི་སྐོར་གླེང་ཐ་ཙྪཱཙྪཱ་ར་ཙྪཱཙྪཱ་༡༣༩ མེང་ཙིས་སུང་ཀུའུ་ཅན་ལ་སྨྲས་པ།",
    "ཉམ་ཐག་དུས་སུ་རང་ཉིད་འཐུས་ཚང་དུ་གཏོང་ལ།",
    "ཐེང་ཀེང་ལ་དེའི་ནང་ནས་གོ་གནས་མཐོ་བ་དང་འཇོན་ཐང་ཆེ་བ་གཉིས་ལྡན་འདུག་གོ།",
    "དངོས་ལ་བཙན་པོ་ཨུ་ཚུགས་མི་བྱེད་པ་དང་རང་གཤིས་ཡིན་ལ་ངེས་པར་དོན་གཉེར་བྱེད་འོས་པའི་སྤྱོད་བཟང་རྣམས་ལ་བརྩོན་ལེན་བྱེད་དགོས་པར་བཞེད་དོ།",
    "ཨ་ར་པ་ཙ་ན་དཀར་པོའི་སྒྲུབ་ཐབས་ཤེས་རབ་འཁོར་ལོ།",
    "རྐྱེན་སྣང་རང་གྲོལ་ཟབ་དོན་འདུས་པ་རྣམས་དང་།",
    "ཡང་ལན་གཅིག་སྲས་མུ་ཁར་བཞག་ནས་ཡུམ་གྱིས་ཞིང་ལ་ཡུར་མ་མཛད་ཅིང་ཡོད་ཚེ་སེར་བ་བབ་པས་བརྗེད་དེ་ནང་དུ་ཕེབས་མ་ཐག་དྲན་ཏེ་ལེན་དུ་བྱོན་པས་སྲས་མི་འདུག་པས་ངུ་ཞིང་ཁྱིམ་དུ་ལོག་པ་ན།",
    "དེ་ལ་བལྟ་བའི་སྣང་བ་ཤར་ཙ་ན་ལུང་པའི་མདའ་བྱེ་མའི་རི་ཆུང་དང་འབབ་ཆུ་ཡོད་པའི་ས་ནས་རྟ་པ་བསེ་ཁྲབ་དང་དྲིལ་བུ་གཡེར་ཁས་བརྒྱན་པ་གཅིག་དང་།",
    "གཞི་དྲུག་དུས་བཅུ་དངོས་པོ་བཅུ་བདུན་དང་།",
    "རང་རང་མི་དགེས་བསྐྱེད་པའི་སྡུག་བསྔལ་ནི།",
    "རང་རང་སྔོན་དགེས་བསྐྱེད་པའི་བདེ་འབྲས་ནི།",
    "ལྷ་མིན་རྣམས་ལའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "སྡོམ་དང་དམ་ཚིག་འཆལ་ཞིང་རང་རྒྱུད་རྩུབ།",
    "དེ་ཡང་རང་ཉིད་འཇམ་དཔལ་བསམས་པ་ཡི།",
    "རང་རང་ལྟ་ལ་ཆགས་ཏེ་ཀུན་ཏུ་སྨད།",
    "འགྲོ་ཉལ་འདུག་དང་ཟས་ལ་སོགས་པ་ནའང་།",
    "དབྱིངས་ལ་སྣང་སྟོང་རང་བཞིན་གཉིས་མེད་པས།",
    "རང་རང་རྒྱུད་ལས་ཇི་སྐད་གསུངས་བཞིན་བསྒོམ།",
    "འདུག་པའི་ཕྱིར་རོ།",
    "ཁྲི་དང་ཁྲི་གཞན་དག་ཀྱང་རབ་ཏུ་མང་པོ་དག་བཤམས་པ་ལ་ལྷ་རྣམས་འདུག་ནས་བྱ་བ་དང་བྱ་བ་མ་ཡིན་པ་བགྲོ་བའི་གནས་དག་ཡོད་དོ།",
    "རྩེ་གཅིག་ནང་དུ་གནས་ཤིང་རང་གསལ་ལ།",
    "འདུག་གནས་སུ་དོན་བྱེད་ནུས་པ་ལ་གྲགས་ལ།",
    "ནམ་མཁའ་ལ་འགྲོ་ཞིང་ནམ་མཁའ་ལ་འདུག་པ།",
    "གཟུགས་སུ་འདུག་ནས་ལོངས་སྤྱོད་པ་དག་ཡོད་དོ།",
    "དེ་ནས་ཟླ་བ་ཤར་བས་འདི་ཡང་དེའི་ཟླ་བོར་འདུག་ཟེར་ནས་ཟླ་བར་བཏགས་སོ།",
    "དེའི་འོག་ཏུ་མུ་གུའི་ཚལ་ཁ་ཏོག་ཀ་ཏཾ་པུ་ཀའི་མེ་ཏོག་ལྟར་སེར་བ་ལ་ཡུན་རིང་དུ་ཟ་ཞིང་འདུག།",
    "ཡ་ཐོག་མ་ཐོག་དུས་མཉམ་པ་སྟེ་བསྡོམས་པ་དང་།",
    "གཞི་དྲུག་དུས་བཅུ་དངོས་པོ་བཅུ་བདུན་དང་།",
    "སྣོད་ཀྱང་རང་བཞིན་གྱིས་འཇིག་པའི་ཚུལ་ནི།",
    "གཉིས་པ་ཆུས་འཇིག་དུས་གསུམ་པ་མི་འཇིག།",
    "རང་རང་མི་དགེས་བསྐྱེད་པའི་སྡུག་བསྔལ་ནི།",
    "རང་རང་སྔོན་དགེས་བསྐྱེད་པའི་བདེ་འབྲས་ནི།",
    "ལྷ་མིན་རྣམས་ལའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "རྟའི་མཆོག་མཐོན་མཐིང་དུ་འདུག་པ་སྤྲིན་གྱི་བཞོན་པ་༢",
    "ཅན་ཐམས་ཅད་ནི་དེའི་༡༡བ་ལག་ན་འདུག་པའོ་ཞེས་པ་དང་།",
    "དེའི་ལག་ན་འདུག་པའི་ཕྱིར་རོ་ཞེས་པ་དང་།",
    "ཟུར་གྱིས་འདུག་པ་དང་།",
