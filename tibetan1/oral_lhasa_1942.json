    "དེ་དག་གཅིག་པར་མ་ངེས་སོ་ཞེས་བསྟན་ཏོ།",
    "གསུམ་པ་རང་བཞིན་མེད་པར་སྨྲ་བ་ལ་གནོད་པ་སྤང་བ་ནི།",
    "ཇི་ལྟར་མཐོང་ཐོས་ཤེས་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས། ༩པ་དག་སྟེ།",
    "རྩོད་པའི་སྐབས་འདིར་ནི་སྡུག་བསྔལ་སྐྱེད་པའི་རྒྱུ་བདེན་པར་རྟོག་པའི་ཡུལ་དགག་པ་ཡིན་ནོ།",
    "དེ་ཉིད་དང་གཞན་ཕན་ཚུན་རྣམ་པར་གཅོད་པའི་འགལ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཡོད་པས་ཀྱང་འཛིན་པ་དང་དོན་དམ་པར་མི་འགྲུབ་སྟེ་སྒྱུ་མ་བཞིན་ནོ།",
    "དཔེར་ན་ཐག་པ་ལ་སྦྲུལ་དུ་སྣང་བའི་གཞི་ཐག་པ་གནས་པ་བཞིན་ནོ་ གཟུགས་ལ་སོགས་པ་གཟུང་འཛིན་དུ་སྣང་བ་མི་བདེན་པ་འདི་རྣམས་ཀྱང་རྟེན་རང་རིག་པ་བདེན་པ་ལ་བརྟེན་པར་འདོད་ནས་རྒོལ་བ་ནི་གལ་ཏེ་ཞེས་པ་རྩ་བ་གཉིསཏེ།",
    "ང་རིག་པ་དེ་དོན་བྱེད་པ་དང་ལྡན་པར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "ཇི་སྟེ་སེམས་གཉིས་སྣང་དང་བྲལ་ཡང་དེ་བཞིན་གཤེགས་པར་མི་འགྲོ་ན་ཅི་སྟེ།",
    "༩སྟོངས་པར་མི་འགྱུར་བར་བྱ་བའི་དོན་དུ་ཡིན་ན།",
    "དེ་ཁས་བླངས་པས་ཅི་བྱ་ཞེས་འདོད་པ་ལ་གནོད་པར་སྦྱར་རོ།",
    "གནོད་པ་དེ་དག་སྤངས་པས་ལེགས་པར་གནས་པ་ན།",
    "དེ་རྟོགས་པའི་བློ་ཡང་ཇི་ལྟ་བའི་ཤེས་བྱའི་ས་རྟོགས་པའི་ཡང་དག་པའི་ལྟ་བ་ཡིན་པར་དོན་གྱིས་གྲུབ་ཅིང་།",
    "སྒྱུ་མ་ལྟ་བུར་རྟོགས་པའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཀུན་རྫོབ་ཀྱི་ཡུལ་ཅན་དེ་ལམ་དུ་སྒྲུབ་པས་དཔེ་དོན་མི་མཚུངས་པར་སྟོན་པ་ན།",
    "དང་པོ་ཕྱོགས་གཅིག་སྒྱུ་མར་རྟོགས་པ་ཙམ་གཉེན་པོ་མ་ཡིན་པས་དཔེ་དང་འགལ་བ་མེད་པར་སྟོན་པ་ནི་དེ་བྱེད་པ་ནི་ཞེས་པ་རྩ་བ་བཞི་སྟེ།",
    "དེ་ཡང་ཕྱོགས་འགའ་ཞིག་སྟོང་པར་མཐོང་བའམ།",
    "ཐམས་ཅད་སྟོང་པའི་མཚན་ཉིད་ཅན་སྒྱུ་མ་ལྟ་བུར་རྟོགས་ཀྱང་གོམས་པར་མ་བྱས་ན་དེ་ཙམ་གྱིས་རྣམ་པར་གྲོལ་བར་མི་འགྱུར་ཏེ།",
    "མེད་པར་འཛིན་པ་སྤོང་བ་ནི་ཅི་ཡང་ཞེས་པ་ནས་རྩ་བ་གཉིས་ཏེ་ཅི་ཡང་མེད་དོ་ཞེས་གོམས་པསནི།",
    "བརྫུན་པ་ཡང་མེད་ཅེས་གསུངས་པ་བཞིན་ནོ།",
    "དེ་ལྟན་ཅི་ཡང་མེད་ཅེས་རྟོག་པའི་ཤེས་པའི་ཡུལ་དུ་མེད་པ་ཞིག་གནས་པར་མི་འགྱུར་རམ་ཞེ་ན།",
    "དངོས་མེད་ཅེས་པའམ་ཅི་ཡང་མེད་པར་ཞེས་པར་མི་གནས་པ་ཉིད་དོ།",
    "དགག་བྱ་དམགྲུབ་པར་དེ་ལ་བརྟེན་པའི་བཀག་པ་ཡང་མི་འགྲུབ་པས་མེད་པ་ཉིད་ཀྱང་མི་དམིགས་སོ་ཞེས་གྲུབ་བོ།",
    "ཡང་ན་རྟེན་བྲལ་བ་ཞེས་པ་ནི་བློ་འཇུག་པའི་རྟེན་དམིགས་པར་བྱ་བ་དང་བྲལ་བའོ་ཞེའོ།",
    "དེ་ལྟར་དགག་བྱའི་དངོས་པོ་མེད་ན་དེ་ལ་ལྟོས་པའི་བཀག་པའི་དངོས་པོ་མེད་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "དེ་ཕྱིར་ཡོད་པར་མི་བརྟག་ཅིང་།",
    "མེད་པར་ཡང་ནི་མི་བརྟག་གོ།",
    "ལྟ་ཀུན་ངེས་པར་འབྱིན་པར་གསུངས།",
    "དེ་དག་གསོར་མི་རུང་བར་གསུངས།",
    "དམིགས་པ་མེད་པར་རབ་ཏུ་ཞི་ཞེས་པའང་ཁ་ཅིག་ནི་སེམས་གཏན་མེད་པའོ་ཞེའོ།",
    "མེད་པར་འཛིན་པ་སྤོང་བ་དང་།",
    "ཤེས་པར་མེད་པའི་ཡེ་ཤེས།",
    "དོན་དམ་པར་སྤྲོས་བྲལ་དུ་མེད་ཀྱང་སྤྲོས་པར་མི་འགྱུར་དེ་གཉི་ག་དང་བྲལ་ལོ་ཞེ་ན།",
    "དོན་དམ་བློའི་སྤྱོད་ཡུལ་མིན་ཞེས་པ་ནི་ཡོངས་གཅོད་དུ་མ་གྲུབ་པས་དམིགས་ཡུལ་དུ་མེད་པར་དགོངས་པའོ།",
    "དངོས་པོ་ཁ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "འདི་སྐད་བརྗོད་པར་བྱའོ།",
    "བློའི་ཡུལ་དུ་གྱུར་ན་ནི་དེ་ཉིད་སྤྲོས་པ་ཡིན་ཏེ་སྒྲ་དང་རྣམ་པ་རྟོག་པར་ཞེན་ནས་ཡུལ་དུ་བྱར་རུང་བའི་ཕྱིར་རོ།",
    "ཤེས་བྱ་མ་ཡིན་པའི་བུམ་པ་ནི་མི་སྲིད་པས་དངོས་འགལ་རྣམ་པར་བཞག་ཏུ་མེད་དོ་ཞེ་ན།",
    "དོན་དམ་པའི་བདེན་པ་ཅིར་ཡང་མ་གྲུབ་པ་ལ་དངོས་འགལ་ལ་སོགས་པ་གང་ཡང་རྣམ་པར་བཞག་ཏུ་མེད་དོ།",
    "དགག་བྱ་རྣམ་པར་བཅད་པ་ཙམ་གྱི་མེད་དགག་ཉིད་ཀུན་རྫོབ་པ་ཡིན་ནམ།",
    "དེའི་ཕྱིར་འདི་ནིརྟོག་གེ་རྣམ་པར་འཁྱམས་པར་ཟད་དོ།",
    "བཞི་པདེའི་ཕྲིན་ལས་འཇུག་པ་དམིགས་པ་ལ་མི་ལྟོས་པར་སྟོན་པ་ནི།",
    "རི་དྭགས་རུ་རུར་སྐྱེ་བ་ལེན་པ་ལ་སོགས་པ་སྐྱེ་བའི་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས། ༩སྤྲུལ་པ་དང་།",
    "དེ་ལ་མྱ་ངན་ལས་འདས་པ་ཞེས་པ་ནི་རྣམ་པར་རྟོག་པ་རྒྱུན་བཅད་པ་སྟེ་རྡོ་རྗེ་ལྟ་བུའིཏིང་ངེ་འཛིན་གྱི་རྗེས་ལ་ཐོབ་པའོ།",
    "སེམས་ཀྱང་མཉམ་ལ་འབྲས་བུའང་མཉམ་ཞེས་གསུངས་སོ།",
    "དོན་མ་ཡིན་པར་གསལ་ལོ།",
    "དམིགས་པ་མེད་པར་རབ་ཏུ་ཞི་བ་ཡང་མར་མེ་ཤི་བ་ལྟ་བུར་ཐུགས་ཀྱི་འཇུག་པ་མེད་པའོ།",
    "ལུང་དེ་བདེན་པར་མི་འཛིནན།",
    "དེ་ཉིད་ལ་རྩོད་པ་སྤངས་པས་གཙོ་བོར་གཏན་ལ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "༡༩དབབ་པར་འདོད་ནས།",
    "རྒྱལ་བའི་ཡུམ་ལས་གཟུགས་ནས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པའི་བར་ལ་དམིགས་པའི་ཚུལ་གྱིས་གནས་པར་མི་བྱའོ།",
    "ཞེས་པ་ལ་སོགས་པ་གསུངས་པས་སོ།",
    "གལ་ཏེ་ལུང་ནས་དེ་ལྟར་གསུངས་པ་དང་ལུང་དེ་དགོས་པ་ཅན་ཡིན་ནོ་ཞེ་ན།",
    "བསྟན་པ་སྡུད་པའི་ཕྱིར་དང་གནས་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེའི་ལན་ནི་དེ་དེ་མ་ཐག་ཏུ་དེར་འགྱུར་རོ་ཞེས་པ་སྟེ་སྡུག་བསྔལ་མེད་པར་འགྱུར་རོ།",
    "གཞན་ཡང་སྲེད་པའི་རྒྱུ་ཚོར་བ་ཡོད་པས་སྲེད་པ་ཡོད་པར་མི་འགལ་བར་སྟོན་པ་ནི་ཚོར་བའི་ཞེས་པ་རྩ་བ་གཉིས་སོ།",
    "དེས་ན་དམིགས་པ་ཅན་ལནི་འདུ་ཤེས་མེད་པའི་སྙོམསཔར་འཇུག་པ་བཞིན་དུ་འགྱུར་རོ།",
    "འོན་ཀྱང་དེ་ཉིད་འབྲས་བུ་མཐར་ཐུག་པ་བྱ་བ་བྱས་པ་ཁུར་བོར་བ།",
    "༩བསྔལ་མི་གནས་པར་རང་དང་གཞན་གཉིས་ཀའི་དོན་གྲུབ་པའོ།",
    "ཤེས་བྱའི་སྒྲིབ་པསནི་ཐམས་ཅད་མཁྱེན་པ་ལ་སྒྲིབ་པར་བྱེད་པས་ན་དེ་དག་ཉིད་མུན་པ་ཡིན་པའི་གཉེན་པོའོ།",
    "དེ་ལྟར་དོན་ཆེ་ཡང་ཐམས་ཅད་ལ་སྐུར་བ་འདེབས་པས་དེ་ལ་འཇུག་པར་མི་སྤྲོ་བོ་སྙམ་ན།",
    "འཇིགས་པ་པོའི་བདག་མགྲུབ་པས་དེ་ལ་འཇིགས་པར་མི་འོས་པ་ཞིག་ལཏེ་ཞེས་པའོ།",
    "དེ་ལྟར་ཁམས་ལྔ་པོ་གཟུགས་ཀྱི་ཕུང་པོ་ལ་བདག་མེད་པར་བསྟན་ནས།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་མཚུངས་པར་ལྡན་པ་དང་བཅས་པ་ལ་བདག་མེད་པས་མིང་བཞིའི་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "སྒྲ་ཤེས་པའི་སྐྱེས་བུ་རྟག་ན་དུས་ཐམས་ཅད་དུ་སྒྲ་འཛིན་པར་འགྱུར་རོ།",
    "སྒྲ་ཤེས་རྟག་ཏུ་གནས་ཀྱང་ཤེས་བྱ་སྒྲ་རྟག་ཏུ་ཡོད་པར་མ་ངེས་པས་དེ་ལྟར་མི་འགྱུར་རོ་སྙམ་ན་ཤེས་བྱ་མེད་ན་ཞེས་པ་རྩ་བ་གཉིས་སོ།",
    "ཡང་ན་རྩ་བ་གཉིས་པོ་དེ་འདོད་པ་ལ་གནོད་པར་སྦྱར་རོ་ཞེའོ།",
    "སྒྲ་མི་ཉེ་བ་དེས་ན་སྒྲ་དེའི་ཡུལ་ཅན་གྱི་ཤེས་པ་ཡང་མེད་པས་སྒྲ་ཤེས་མི་རྟག་པར་གྲུབ་བོ།",
    "བལྟ་བྱའི་རྣམ་པར་དམིགས་པ་གཉིས་འགལ་བ་གཅིག་ཏུ་མི་འཐད་པའོ།",
    "དོན་དམ་པའི་ཤེས་པ་གཅིག་ཉིད་ཀྱི་ཡུལ་གཟུགས་དང་སྒྲ་ལ་སོགས་པར་ལྟོས་ནས་སྒྲ་འཛིན་དང་གཟུགས་འཛིན་ལ་སོགས་པ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "དཔེ་ཉིད་མ་གྲུབ་པར་སྟོན་པ་ནི་གཅིག་ནི་ཞེས་པ་སྟེ།",
    "ཅེས་ཚུ་རོལ་མཐོང་བའི་བློའི་ཡུལ་ལས་འདས་པར་འདོད་ལ།",
    "སེམས་པས་དེ་ལ་ཅིང་ཡང་མ་བྱས་པས་བེམས་པོ་ལས་མ་འདས་སོ།",
    "བདག་མེད་པ་ལ་གནོད་པ་གཉིས་སྤང་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "ལས་བྱས་པ་དོན་མེད་ཅིང་མ་བྱས་པ་དང་ཕྲད་པར་འགྱུར་རོ་ཞེས་བྱ་བའོ།",
    "ལན་ལ་ལྔ་ལས་དང་པོ་ཁས་བླངས་པའི་སྒོ་ནས་མཚུངས་པར་སྟོན་པནི།",
    "ཚོར་བ་བདེ་སྡུག་ནི་འབྲས་བུ་ཉམས་སུ་མྱོང་བའི་གཞི་ཐ་དད་པར་ཡུ་བུ་གཉིས་ཀ་ལ་མཚུངས་པར་གྲུབ་པས།",
    "ལས་བྱ་བའི་སྐབས་དང་འབྲས་བུ་མྱོང་བའི་སྐབས་འདིར་བདག་བྱེད་པ་མེད་པར་ཡང་གྲུབ་སྟེ།",
    "ཁྱེད་ལྟར་ན་རྟག་པ་ཡིན་པས་ལས་དང་འབྲས་བུའི་བྱེད་པ་མེད་པར་ཡང་མཚུངས་པ་ཉིད་དོ་ཞེས་གསུང་ངོ",
    "དེས་ན་རང་དང་གཞན་གྱི་སྡུག་བསྔལ་ཉེ་བར་ཞི་བའི་དོན་དུ་འབྲས་བུ་དང་ལྡན་པའི་རྨོངས་པ་འཁྲུལ་པའི་ངོའི་སྤྱོད་ཟློག་པར་མི་བྱའོ།",
    "ངར་འཛིན་དང་པོ་འཕེལ་བྱེད་བདག་བདེན་པར་འཛིན་པ་ལ་དགོངས་པའོ།",
    "འོ་ན་འབྲས་བུ་རྨོངས་པ་དེ་ལས་ཀྱང་སྡུག་བསྔལ་གྱི་རྒྱུ་ངར་འཛིན་འཕེལ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "འདི་ཡང་ཉན་ཐོས་པས་ནི་ལུས་གཙང་བར་འཛིན་པའི་གཉེན་པོར་ལུས་མི་གཙང་བར་བསྒོམས་པ་དང་།",
    "སེམས་བདག་ཡོད་པར་འཛིན་པའི་གཉེན་པོར་སེམས་བདག་མེད་པ་དང་།",
    "དེ་ལ་ལུས་ཀྱིས་མཚོན་ནས་གཟུགས་ཀྱི་ཕུང་པོ་རང་བཞིན་མེད་པར་འཆད་པ་ནི་ལུས་དྲན་པ་ཉེ་བར་བཞག་པའོ།",
    "དང་པོ་ལྟར་ན་ཆ་ཤས་དང་བཅས་པར་འགྱུར་བས་གཅིག་ཡིན་པ་ཉམས་སོ་ཞེས་སྟོན་པ་ནི་གལ་ཏེ་ཞེས་པ་རྩ་བ་བཞིའོ།",
    "རྩོད་པ་དེ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས། ༩སྤངས་བ་ལ་གཉིས་ལས་འཁྲུལ་པའི་རྒྱུ་ནི་ཇི་སྲིད་རྐྱེན་ཚོགས་དེ་སྲིད་དུ།",
    "མ་རིག་པ་ལ་སོགས་པ་རྐྱེན་ཚང་བ་དེ་སྲིད་དུ་ལུས་སུ་བདེན་པར་འཁྲུལ་པ་ཡང་མི་ལྡོག་པས་དཔེ་དོན་མཐུན་ཞིང་།",
    "འཁྲུལ་པའི་རྐྱེན་མ་རིག་པ་ལ་སོགས་པ་ལོག་ན་ནི་འཁྲུལ་པ་ཉིད་དུའང་ཤེས་པར་འགྱུར་བས་མཐུན་ནོ་ཞེས་འཁྲུལ་པའི་ཤེས་བྱེད་ནི་དེ་བཞིན་ཞེས་པ་ལ་སོགས་པའོ།",
    "དེ་ལྟར་གཅིག་མ་གྲུབ་ན་གཅིག་ཚོགས་པའི་དུ་མ་ཡང་མ་གྲུབ་པས་གཅིག་དང་དུ་མ་དང་བྲལ་བའི་ཕྱིར་ལུས་ཀྱི་མཚོན་པ་གཟུགས་ཀྱི་ཕུང་པོ་རང་བཞིན་མེད་དོ་ཞེས་ཤེས་པའི་ལུས་བདེན་པར་འཛིན་པ་ལྡོག་པའི་འཁྲུལ་པའི་ཤེས་བྱེད་དོ།",
    "བྱེད་པ་པོ་སྐྱེས་བུར་རྟོག་པ་ལ་སྣང་བ་བཞིན་དུ་ལག་པ་ལ་སོགས་པའི་ཆ་ཤས་འདུས་པས་རྐྱེན་བྱས་ནས་ལུས་གཅིག་པར་ཡང་རྟོག་པ་ལ་སྣང་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ལག་པ་ལ་སོགས་པར་སྣང་ཞིང་།",
    "རྡུལ་ཕྲན་གྱིས་རྐྱེན་བྱས་ནས་ཆར་སྣང་ངོ།",
    "ཚོར་བའི་རང་བཞིན་མ་གྲུབ་པར་སྟོན་པ་ནི་ལྔ་ལས་དང་པོ་སྡུག་བསྔལ་དོན་དམ་དུ་མ་གྲུབ་པ་ནི་སྡུག་བསྔལ་ཞེས་པ་རྩ་བ་གཉིས་ཏེ།",
    "ནམ་ཡང་འཐད་པ་མ་ཡིན་ནོ་ཞེསགསུངས་པ་བཞིན་དུ།",
    "མ་མྱོང་བའི་ཕྱིར་སྡུག་བསྔལ་དེ་ཚོརབ་ཇི་ལྟར་ཡིནཏེ་ཚོར་བ་མ་ཡིན་པར་འགྱུར་རོ།",
    "བདེ་བ་སྟོབས་དང་ལྡན་པས་ཟིལ་གྱིས་མནན་པའི་ཚེཡང་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "ཕྲ་ཉིད་དེ་ཡང་དེའི་ཞེས་གསུངསཏེ།",
    "ཕྲ་ཉིད་ཡང་དེའི་ཞེས་འདོན་པ་བསྒྱུར་ཏེ་ཤེས་པར་བྱའོ།",
    "རྣམ་པར་དཔྱད་པའི་དོན་དེ་རྣལ་འབྱོར་དུ་བྱས་པས་ཁམས་བརྟས་པར་བྱེད་པ་ཡིན་པས་དེ་ལྷུར་བྱས་པ་ནི་དེ་ཉིད་ཕྱིར་ན་ཞེས་པ་སྟེ།",
    "དེ་ལྟར་དོན་ལྔས་ཚོར་བ་མགྲུབ་པར་བསྟན་ནས།",
    "འཇུག་པ་ནི་ཆེ་བ་དང་སྐབས་ཡོད་པར་འཇུག་པས་སོ།",
    "ཚོར་བའི་རྐྱེན་ཚོགས་པ་ཙམ་ཡིན་པས་དེའི་རྣམ་པར་ཤེས་པ་ལས་འགལ་བ་ཅི་ཡོད་སྙམ་ན།",
    "ཚོགས་པ་ལའང་ཞེས་གསུངས་ཏེ།",
    "དེས་གྲུབ་པའི་དོན་གཞན་འབྲས་བུ་མེད་པར་བརྗོད་པ་ནི་གང་ཚེ་ཞེས་པ་སྟེ།",
    "སེམས་དྲན་པ་ཉེ་བར་བཞག་པ་ནི་རྣམ་པར་ཤེས་པ་དྲུག་རང་བཞིན་མེད་པར་སྟོན་པ་ཡིན་པ་ལས།",
    "དང་པོ་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་རང་བཞིན་མེད་པར་སྟོན་པ་ནི་ཡོདཞི་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "གཅིག་ན་རྣམ་པར་དབྱེ་བ་ལན་དེ་བརྗོད་དུ་མེད་དོ།",
    "འདུས་མ་བྱས་རྣམས་བཅསཔནི།",
    "རྣམ་པར་རིག་བྱེད་མ་ཡིན་པའི་གཟུགས་དང་།",
    "སོ་སོར་བརྟགས་པའི་འགོག་པ་དང་སོ་སོར་བརྟགས་པ་མ་ཡིན་པའི་འགོག་པ་སྟེ་འདུས་མ་བྱསགསུམ་རྫས་སུ་འདོད་པ་ནི་བྱེ་བྲག་ཏུ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "ཅེས་གསུངས་པ་ལྟར་ཀུན་རྫོབ་ནི་སྐྱེ་བ་ཁོ་ན་ལྟརཡིན་ལ་ཁྱེད་ཀྱིས་ནི་ཤེས་བྱ་ལས་སྔར་ཤེས་ཡོད་ན་ཞེས་པ་ལ་སོགས་པའི་རིགས་པས་སྐྱེ་བ་འགོག་པ་དེ་ལྟ་ན་ནི་ཀུན་རྫོབ་ཀྱང་མེད་པར་འགྱུར་ལ།",
    "ཀུན་རྫོབ་སྐྱེ་བར་རྟོག་པ་བློ་འཁྲུལ་པ་གཞན་གྱིས་བརྟགས་པས་ཡོད་དོ་ཞེས་བརྟགས་པས་ཡོད་པར་གྲུབ་བོ་ཞེ་ན།",
    "སྐྱེ་བ་མེད་པ་ཞེས་བྱ་བ་གཞལ་བྱ་བདེན་པར་གྲུབ་པས་བློ་རིགས་ཤེས་སུ་སྒྲུབ་དགོས་ལ།",
    "སྐྱེ་བ་མེད་པར་ཡང་རིགས་ཤེས་ཀྱིས་བསྒྲུབ་དགོས་པས་ཕན་ཚུན་བརྟེན་ནོ་ཞེས་བསམས་ནས་རྟོག་དང་ཞེས་པ་རྩ་བ་གཉིས་སོ།",
    "སྔ་བ་དང་ཕྱི་བ་གང་ལས་སྐྱེ་བར་མི་འགྱུར་བ་དེ་ལྟར་ཀུན་ནས་ཉོན་བ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "དེ་ཉིད་སྟོང་པར་དཔྱོད་ན་དེ་ལ་ཡང་དཔྱོད་བྱེད་གཞན་དགོས་པས་ཐུག་པ་མེད་དོ་ཞེ་ན།",
    "སྐྱེ་བ་མེད་པར་རྟོགས་བྱེད་ཀྱི་བློས་ཡུལ་ཐམས་ཅད་སྐྱེ་མེད་དུ་རྟོགས་ཀྱང་།",
    "གལ་ཏེ་ཡུལ་ཅན་དེ་ཡང་སྐྱེ་མེད་དུ་བློ་གཞན་གྱིས་རྟོགས་དགོས་ན་ག་པ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དང་པོ་ཡུལ་དང་ཡུལ་ཅན་གྱི་རྣམ་པར་བཞག་པ་སྤྱིར་བརྗོད་པ་ནི་རྟོགས་དང་ཞེས་པའོ།",
    "གལཏེ་ཡུལ་དང་ཡུལ་ཅན་དོན་དམ་པ་ཡིན་ན་ཐུག་པ་མེད་པར་འགྱུར་ན་གང་ཚེ་ཞེས་པའོ།",
    "དེ་ལྟར་ན་ཡུལ་ཅན་མི་དཔྱད་པས་ཡུལ་ཅན་སྐྱེ་མེད་དུ་རྟོགས་པར་མི་འགྱུར་རམ་སྙམ་ན།",
    "བུ་མེད་པར་ཕ་མི་འབྱུང་ངོ་ཞེ་ན་འོ་ཞེས་འཆད་པ་ནི་མུན་སྤྲུལ་དུ་ཟད་དོ།",
    "ཐ་སྙད་རྒྱུ་ལས་གྲུབ་པའི་འབྲས་བུ་རྒྱུ་རྟོགས་པར་བྱེད་པ་བཞིན་དུ།",
    "ཡུལ་ལས་སྐྱེས་པའི་ཡུལ་ཅན་གྱིས་ཀྱང་རྟོགས་པར་འདོད་ནས་མྱུ་གུ་ཞེས་བྱ་བ་ལ་སྩོགས་པས་བརྩད་པ་ལ།",
    "སྨྱུགུ་གྲུབ་པར་རྟོགས་པའི་ཤེས་པ་ཁས་བླངས་ཀྱང་མི་མཚུངས་ཏེ།",
    "ཤེས་བྱ་ཡོད་པ་ལ་བརྟེན་ནས་རྟོགས་ན་ཕན་ཚུན་བརྟེན་ལ་རང་རིག་པ་ཡང་སྔར་བཀག་ཅིང་རྟོགས་པར་བྱེད་པའི་ཤེས་པ་གཞན་ཡང་མེད་པའི་ཕྱིར་རོ་ གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "དོན་དམ་པརགྲུབ་པ་མེད་དོ་ཞེས་པ་ནི་བསྒྲུབ་བྱའོ།",
    "རྩོགས་ཞེས་པ་ནི་རང་བཞིན་གྱིས་སྐྱེས་པའི་ཚེར་མ་དང་བཟོ་བོས་ལེགས་པར་བྱས་པ་དག་འདྲ་ཞིང་།",
    "ས་བོན་ལ་སོགས་ལས་སྐྱེས་པའི་ཨུཏྤལ་དག་ཀྱང་རྣམ་པར་མཚུངས་པར་སྣངན།",
    "འབྲས་བུའི་དབྱེ་བ་གང་ཇི་སྙེད་པ་ཐམས་ཅད་ནི་རྒྱུ་ཉིད་ཀྱི་རྣམ་པར་དབྱེ་བ་ལས་ཡིན་ཏེ།",
    "གཙང་བ་ཞེས་བྱ་བ་རྣམས་ཀྱི་མཚན་ཉིད་ཅན་དུ་འདོད་པ་ཡིན་ན།",
    "བདག་འབྲས་བུ་ཡིན་པར་འདོད་ན།",
    "གལ་ཏེ་ལྟོས་པ་མེད་པར་མ་གྲུབ་སྟེ།",
    "གལ་ཏེ་ཚོགས་པ་དོན་མེད་པར་མི་འགྱུརཏེ་མ་ཚོགས་པའམ་ཚོགས་ཀྱང་འདོད་པ་མེད་ན།",
    "དེ་ནས་ཆུ་དང་ས་ལ་སོགས་པ་ཡང་ཚུལ་དེ་ལྟར་ཆགས་ཏེ་པདྨའི་སྦུབས་ཆེན་པོ་གཅིག་ཕྱིའི་རྒྱ་མཚོ་ཆེན་པོ་ནས་བྱུང་པར་གྱུར་ཏོ།",
    "དེ་རིམ་གྱིས་སྨིན་པར་གྱུར་པ་ལས་ཚངས་པ་ཆེན་པོ་བྱུང་སྟེ།",
    "རྣམ་པར་འགྱུར་བ་ལས་གྱུར་པ་དང་།",
    "དེ་ལས་ཚོགས་ནི་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "ཅེས་དེརྣམས་ཐ་དད་པར་ཤེས་པ་ནི་གྲོལ་བའི་རྒྱུར་སྨྲའོ།",
