    "༩། སྤྱོད་འཇུག་ཤེས་རབ་ལེའུའི་འགྲེལ་པ་བཞུགས་སོ།",
    "ཤེས་རབ་དེ་ཡང་སེམས་མཉམ་པར་བཞག་པར་ལྟོས་ཤིང་།",
    "ཞེས་གསུངས་ཞིང་།",
    "དེ་ནི་སྐྱེ་བ་བརྒྱུད་པ་དུ་མར་བསྒོམས་པས་ཐོབ་པར་བྱ་བ་ཡིན་པས།",
    "དེ་ལྟར་ཕ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས། ༩རོལ་ཏུ་ཕྱིན་པ་གཞན་ཐམས་ཅད་ཀྱིས་སྒྲུབ་པར་བྱ་བའི་ཕྱིར་དང་།",
    "མྱ་ངན་ལས་འདས་པའི་འབྲས་བུ་སྒྲུབ་པའི་གཙོ་བོ་ཡིན་པར་ཚིགས་སུ་བཅད་པ་ཕྱེད་ཕྱེད་ཀྱིས་བསྟན་ནོ།",
    "བདེན་པ་གཉིས་ལེགས་པར་ཤེས་པས།",
    "ཤེས་རབ་རྣམ་པར་བཤིག་ནས་རྡུལ་ཙམ་མི་དམིགས་ཚེ།",
    "ཞེས་གསུངས་པས་སོ།",
    "དང་པོ་ལ་ཡང་བདེན་པ་གཉིས་ཀྱི་རང་བཞིན་རྣམ་པར་བཞག་པ་དང་།",
    "བདེན་པ་གཉིས་ཀྱི་རང་བཞིན་རྣམ་པར་བཞག་པ་ལ་གསུམ་ལས།",
    "བརྗོད་པར་བྱ་བ་ཙམ་སྟེ།",
    "གཉིས་པ་ནི་ཀུན་རྫོབ་ལབརྟེན་ནས་ཟག་པ་འཕེལ་བ་ལྟར་དོན་དམ་པའི་བདེན་པར་དམིགས་པ་ལ་བརྟེན་ནས་ཀྱང་ཟག་པ་འཕེལ་བར་འགྱུར་བས།",
    "གསུམ་པ་ནི་དོན་དམ་པ་ལ་ཕན་ཚུན་དབྱེ་བ་མེད་པ་ལྟར་ཀུན་རྫོབ་ལ་ཡང་དབྱེ་བ་མེད་པར་འགྱུར་བས་བུམ་པ་དང་སྣམ་བུ་ལ་སོགས་པ་རིལ་གྱིས་རྫས་གཅིག་ཏུ་འགྱུར་རོ།",
    "དོན་དམ་པ་ཡང་མཐོང་བ་དང་ཐོས་པ་ལས་ཐོས་བསམ་ལ་སོགས་པས་ལོགས་སུ་བཙལ་མི་དགོས་པར་འགྱུར་རོ།",
    "ཀུན་རྫོབ་དེར་མ་འདུས་པ་ལས་ལོགས་སུ་དམིགས་པར་འགྱུར་ལ།",
    "བུམ་པ་མི་རྟག་པར་མཐོང་ཡང་སྒྲ་ལ་ཕྱིན་ཅི་ལོག་ཏུ་རྟག་པར་འཛིན་པ་མི་ལྡོག་པ་བཞིན་ནོ།",
    "དོན་དམ་ཡང་ཀུན་རྫོབ་ཀྱི་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "ཀུན་རྫོབ་བཙལ་ན་མ་རྙེད་པ་ཙམ་དོན་དམ་མ་ཡིན་པར་འགྱུར་བའོ།",
    "རྣམ་པར་བྱང་བའི་དམིགས་པ་དོན་དམ་པ་གཉིས་ཐ་དད་པ་སོ་སོར་དམིགས་སུ་རུང་བའི་ཕྱིར་དཔེར་ན་བུམ་པ་དང་སྣམ་བུ་སོ་སོར་དམིགས་པ་བཞིན་ནོ།",
    "དེའི་ཕྱིར་ཆགས་པ་ཟད་པ་ཉིད་ཀྱི་ཚེ་ཆགས་པ་དང་བཅས་པར་འགྱུར་རོ།",
    "ཡིན་ན་སོ་སོའི་སྐྱེ་བོ་ཐམས་ཅད་ཀྱིས་བུམ་པ་ལ་སོགས་པའི་འདུས་བྱས་མཐོང་བ་ན་སྐད་ཅིག་མའང་མཐོང་བས་འཕགས་པའི་བདེན་པ་མཐོང་བར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཐམས་ཅད།",
    "བྱས་པ་དང་སྐད་ཅིག་མ་དངོས་པོ་གཅིག་པ་ལ་ཡང་ཉེས་པ་བཞི་པོ་མཚུངས་སོ།",
    "གལ་ཏེ་བྱས་པ་དང་སྐད་ཅིག་མངོབོ་གཅིག་ཀྱང་ལྡོག་པ་ཐ་དད་པས་ཉེས་པ་བཞི་པོ་དེ་མེད་དོ་ཞེ་ན།",
    "སྒྱུ་མ་རིགས་གྲུབ་ཏུ་འདོད་པ་ལྟར་བདེན་པ་གཉིས་ཀྱང་དངོས་པོ་གཅིག་ལ་ལྡོག་པ་ཐ་དད་པར་ཁས་ལེན་པ་ལ་ཉེས་པ་བཞི་པོར་མི་འགྱུར་རོ།",
    "དེས་ན་བདེན་པ་གཉིས་མཚན་ཉིད་ཀྱང་ཐ་དད་མེད་པར་འདོད་པ་ལ་གཅིག་པའི་ཕྱོགས་ཀྱི་སྐྱོན་བཞི་བརྗོད་ལ།",
    "འོ་ན་བདེན་པ་གཉིས་དངོས་པོ་གཅིག་ལ་མཚན་ཉིད་ཐ་དད་པར་འདོད་པ་ལ་ཉེས་པ་ཅི་ཡོད་ཅེ་ན།",
    "འདི་ལྟར་ཡང་དག་མཐའ་ནི་འདུས་བྱས་ཀྱི།",
    "ཡོད་མེད་དངོས་པོ་མཁྱེན་པ་པོ།",
    "ཅེས་གསུངས་པ་དང་།",
    "སྐྲ་ཤད་ཀྱིས་དབེན་པར་མ་འདུས་པའི་སྐྲ་ཤད་དུ་སྣང་བ་མེད་པའི་ཕྱིར་རོ།",
    "ཚུ་རོལ་མཐོང་བའི་བློས་ཡུལ་དུ་བྱས་པའི་ཤེས་བྱ་འདི་མཐའ་དག་ནི་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ཡིན་ལ།",
    "མཚན་ཉིད་མེད་ཅེས་བྱ་བ་ལ་སོགས་པ་མཚན་ཉིད་མེད་པ་ཞེས་བྱ་བའི་མཚན་ཉིད་འགའ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "འོན་ཀྱང་བརྗོད་པའི་ཀུན་རྫོབ་ཉེ་བར་བཟུང་ནས་མཚན་ཉིད་དུ་གྲུབ་པར་འདོད་པ་འགའ་ཞིག་དགག་པའི་ཕྱིར་དེ་ལྟར་བརྗོད་པར་ཟད་དེ།",
    "དེ་ཁོ་ན་ཉིད་ལ་སྒྲིབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "རྒྱལ་བ་རྣམས་ཀྱིས་གང་གསུངས་པ།",
    "མཁས་པ་སུ་ཞིག་རྟོགས་མི་བྱེད་ཅེས་གསུངས་སོ།",
    "བདེན་པའི་ཤེས་བྱ་ཡུལ་དུ་བྱས་པ་ནི་ཅི་ཡང་མེདདོ།",
    "སྤྲོས་པ་མེད་པ་ཡང་ཡིན་ཏེ་སྒྲ་དང་རྣམ་པར་རྟོག་པའི་ཞེན་ཡུལ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡོད་པ་དང་མེད་པ་གཉིས་སམ་རྟག་པ་དང་མི་རྟག་པ་སོགས་པར་མ་གྲུབ་པས་སོ།",
    "མི་གསུང་བཞུགས་པར་རྒྱ་ཆེར་བཤད།",
    "དོན་དམ་པ་ལ་ནི་སེམས་ཀྱི་རྒྱུ་བ་ཡང་མེད་ལ་ཡི་གེ་རྣམས་ལྟ་ཅི་སྨོས་ཞེསཔ་ལ་སོགས་པ་གསུངས་སོ།",
    "བློན་ཀུན་རྫོབ་ཡིན་པར་བརྗོད་ཅེས་སྨོས་ཏེ།",
    "ཀུན་རྫོབ་ཀྱི་བདེན་པ་ལས་བཟློག་པ་དོན་དམ་པའི་བདེན་པ་ནི་བློའི་ཡུལ་མ་ཡིན་པར་གྲུབ་བོ།",
    "བློའི་ཡུལ་དུ་གྱུར་པ་ནི་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "དེ་ནི་ཇི་ལྟ་བ་མཁྱེན་པའི་མངོན་སུམ་གྱིས་དོན་དམརྟོགས་པའི་ཚུལ་ཡིན་ལ།",
    "དེ་ནི་ཇི་སྙེད་པ་མཁྱེན་པའི་མངོན་སུམ་གྱིས།",
    "དཔོན་གྱིས་བློ་ཐམས་ཅད་འཁྲུལ་པར་བསྒྲུབས་པས།",
    "དེ་ཡངའདི་ལྟར་གལཏེ་བློ་ནི་ཀུན་རྫོབ་ཡིན་པར་བརྗོད་ཅེས་བློ་ཐམས་ཅད་འཁྲུལ་པ་ཀུན་རྫོབ་ཡིན་པར་བརྗོད་པ་དེ་གྲུབ་ན།",
    "འཁྲུལ་པ་དེའི་ཡུལ་མཐའ་དག་ཀུན་རྫོབ་ཀྱི་བདེན་པར་འགྲུབ་ལ།",
    "དེའི་ཕྱིར་དོན་དམ་པའི་བདེན་པ་བློ་འཁྲུལ་པ་དེའི་ཡུལ་ལས་འདས་པར་ཡང་གྲུབ་པ་ཞིག་ན།",
    "བློ་ཐམས་ཅད་འཁྲུལ་པར་བསྒྲུབས་པས་བདེན་པ་གཉིས་ཀྱི་མཚན་ཉིད་སྒྲུབ་པ་ནི་གསུམ་ལས།",
    "དང་པོ་གནོད་པའི་ཡུལ་བློའི་རྣམ་པར་དབྱེ་བ་སྔོན་དུ་བྱེད་པ་ནི་དེ་ལ་ཞེས་པ་ནས་རྩ་བ་གཉིས་སོ།",
    "དེ་ལ་ཕལ་པ་དག་ནི་བློས་འདི་ལྟར་སྣང་བ་འདི་རྟག་པ་དང་གཅིག་པུདངགཙང་བ་ལ་སོགས་པར་ངེས་པར་བྱས་པ་ལ་རྣལ་འབྱོར་གྱི་འཇིག་རྟེན་གྱིས་བྱས་པའི་ཕྱིར་མི་རྟག་ཅེས་པ་དང་།",
    "ཆ་སྣ་ཚོགས་དང་བཅས་པའི་ཕྱིར་གཅིག་མ་ཡིན་ཞེས་པ་ལ་སོགས་པས་ཡུལ་ལ་གནོད་པ་ན་ཡུལ་ཅན་ཕལ་པའི་བློ་སྟེ་འཁྲུལ་པར་གྲུབ་བོ།",
    "གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "འགག་པར་འགྱུར་བ་མ་ཡིན་ནོ་ཞེས་པ་ལ་སོགས་པས་བློའི་ཡུལ་ལ་གནོད་པས་མུ་སྟེགས་པའི་བློ་འཁྲུལ་པར་གྲུབ་བོ།",
    "དེས་ན་བྱེ་བྲག་ཏུ་སྨྲ་བའི་བློ་ཡང་འཁྲུལ་པར་གྲུབ་བོ།",
    "སེམས་ཙམ་པ་ཡང་གཉིས་ལས་རྣམ་བདེན་པས་སྣང་བ་ཐམས་ཅད་ཤེས་པའི་རྣམ་པར་བདེན་ནོ་ཞེས་འདོད་པ་ལ།",
    "རྣམ་པ་ཡང་དཀར་དམར་སྣ་ཚོགས་སུ་སྣང་བའི་ཕྱིར་ཤེས་པ་ཡིན་པར་འགལ་ལོ།",
    "གཏན་མེད་པའི་དོན་སྣང་བ་བརྫུན་པ་ཁོ་ན་ཡིན་ལ་འཛིན་ཆར་སྣང་བའི་ཤེས་པ་བདེ་སྡུག་ལ་སོགས་པ་ནི་དོན་དམ་པར་ཡོད་དོ་ཞེས་འདོད་པ་ལ།",
    "མེད་ན་བློ་ཐམས་ཅད་འཁྲུལ་པར་འདོད་པ་ཉམས་སོ།",
    "འཁྲུལ་པར་སྒྲུབ་བྱེད་ཡོད་ན་ཡང་རྟེན་ལུས་དང་བསམ་པ་ནས་བཟུང་སྟེ་བསམ་གཏན་གྱི་བར་ཐམས་ཅད་ཀྱི་བསྒྲུབ་བྱ་ནི་ཤེས་རབ་ཡིན་ན།",
    "ཤེས་རབ་ཀྱི་ཡུལ་ཡང་སྟོང་པ་ཉིད་ཅེས་པ་ཡིན་པར་མི་འདོད་དེ།",
    "དམིགས་པ་མེད་པར་རབཏུ་ཞི།",
    "ཞེས་གསུངས་སོ།",
    "གཟུང་འཛིན་མེད་པར་མཐོང་བས་གནོད་ཅིང་རྣམ་རིག་ཙམ་དུ་མཐོང་བ་ལ་ཡང་སྣང་མེད་པའི་ཡེ་ཤེས་ཀྱིས་གནོད་པས་བློ་འཁྲུལ་པར་གྲུབ་པ་ན།",
    "དོན་དམ་པའི་བདེན་པ་བློའི་ཡུལ་མ་ཡིན་པར་གྲུབ་ལ།",
    "ན་བདེན་པ་གཉིས་ཀྱི་མཚན་ཉིད་རྣམ་པར་བཞག་པ་གྲུབ་བོ།",
    "རྣལ་འབྱོར་གྱི་བློ་གནོད་བྱར་ངེས་པར་བྱ་བའི་ཕྱིར་བཀོད་པའམ་ཡང་ན་འཕགས་པའི་གནོད་བྱེད་གོང་མ་གོང་མ་ཉིད་ཡིན་པ་ལ་འགལ་བ་ཅི་ཡོད་དེ།",
    "བློ་ཐམས་ཅད་འཁྲུལ་པར་འདོད་ན་ས་དང་པོ་ཡན་ཆད་ཐོབ་པའི་འཕགས་པ་རྣམས་སྦྱིན་པ་ལ་སོགས་པ་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྤྱོད་པ་དང་།",
    "དོན་ཐམས་ཅད་མི་བདེན་པ་དང་བློ་ཐམས་ཅད་འཁྲུལ་པར་མཁྱེན་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "དགོས་པ་ཉེ་བར་བཟུང་ནས་མ་དཔྱད་པར་བསྟན་པ་བཞིན་དུ།",
    "འབྲས་བུའི་དོན་དུ་མ་དཔྱད་པར་འཇུག་སྟེ།",
    "མ་དཔྱད་པ་སྟེ་བརྟག་དཔྱད་མ་བྱས་པའི་བློའི་ཡུལ་སྣ་ཚོགས་དང་བཅས་པའི་བློ་མི་འདོར་བ་ལ་འགལ་བ་ཅི་ཡོད་དེ་དཔྱད་ན་དེ་དག་ཀྱང་མི་གནས་པའི་ཕྱིར་རོ།",
    "དེ་ཡངཡང་དག་ཉིད་དུ་རྟོགས་པར་བྱེད་ཀྱི།",
    "སྒྱུ་མ་ལྟ་བུར་མི་རྟོགས་པསརྣལ་འབྱོར་པ་དང་འཇིག་རྟེན་པ་མི་མཐུན་པས་རྩོད་པར་བྱེདདོ།",
    "དེའི་ཕྱིར་རྟོགས་པ་ལ་ཁྱད་པར་མེད་པར་ག་ལ་འགྱུར།",
    "དེ་ལྟར་བདེན་པ་གཉིས་ཀྱི་རང་བཞིན་རྣམ་པར་བཞག་པ།",
    "མ་དཔྱད་པར་འཇུག་པའི་བློའི་ཡུལ་དུ་གྲགས་པ་ཙམ་གྱིས་གྲུབ་པ་ཡིན་གྱི།",
    "གཙང་བའི་མཚན་ཉིད་དུ་མངོན་སུམ་དུ་གྲུབ་བོ་ཞེས་མ་དཔྱད་པའི་བློས་བརྟགས་པ་ཙམ་ཡིན་པ་བཞིན་ནོ།",
    "དགོངས་ཏེ་གསུངས་པའི་དགོས་པ་བསྟན་པ་ནི་འཇིག་རྟེན་ཞེས་པ་སྟེ།",
    "དངོས་པོར་འཛིན་པ་ཤས་ཆེ་བ་བློ་གྲོས་དམན་པརྣམས་དོན་དམ་པར་རང་བཞིན་མེད་པ་ལའམ།",
    "བསྟན་པ་ལ་རིམ་གྱིས་གཞུག་པའི་དོན་དུ་མགོན་པོས་ཕུང་པོ་ལ་སོགས་པའི་དངོས་པོ་དང་སྐད་ཅིག་མ་ལ་སོགས་པ་དག་བདེན་པར་ཡོད་པ་སྐད་དུ་བསྟན་པར་ཟད་ཀྱི་ཡང་དག་པ་ནི་མེད་དོ།",
    "ཐམས་ཅད་ཡོད་ཅེས་བརྗོད་པར་བྱ།",
    "ཕྱིསནི་རྣམ་པར་དབེན་པའོ་ཞེས་གསུངས་སོ།",
    "དེ་ཁོ་ན་སྐད་ཅིག་མ་ཆ་ཤས་མེད་པར་ཡོད་ན་དུས་རིང་པོའི་རྩ་བྱེད་དུ་འགལ་ཏེ།",
    "ཐོག་མ་དབུས་ཀྱང་བརྟག་པར་གྱིས།",
    "འཇིག་རྟེན་སྐད་ཅིག་ལ་མི་གནས་ཞེས་གསུངསཏེ།",
    "དུས་ཀྱི་ཆ་ཤས་བཞིགས་ན་སྐད་ཅིག་མ་མ་གྲུབ་པར་དགོངས་པའོ།",
    "འཇིག་རྟེན་ལ་ལྟོས་དེ་ཉིད་མཐོང་ཞེས་གསུངས་ཏེ།",
    "འཇིག་རྟེན་པ་རྟག་པ་ལ་སོགས་པར་འཛིན་པའི་ཕྱིན་ཅི་ལོག་བློ་ཅན་ལ་ལྟོས་ནས།",
    "རྟག་པར་འཛིན་པ་དང་སྐད་ཅིག་ཏུ་རྟོགས་པ་གཉིས་དོན་དམ་པར་འཁྲུལ་པར་ཁྱད་མེད་པ་བཞིན་དུ་ཀུན་རྫོབ་ཏུ་ཡང་འཁྲུལ་པར་ཁྱད་མེད་པར་ཁྱེད་འདོད་པ་ལ།",
    "དེས་ན་འཁྲུལ་པར་ཁྱད་མེད་པ་ཙམ་གྱིས་རྟག་པར་འཛིན་པ་ལ་སོགས་པའི་འཇིག་རྟེན་པ་ལ་ལྟོས་ཀྱང་།",
    "སྐད་ཅིག་མ་རྟོགས་པ་དེས་རྟག་འཛིན་མི་གནོད་པར་འགྱུར་ཏེ་དེ་གཉིས་སྟོབས་མཚུངས་པས་སོ།",
    "དེ་བས་ན་དོན་དམ་པར་གང་ཡང་མ་གྲུབ་པར་མཚུངས་ཀྱང་།",
    "ཀུན་རྫོབ་ཏུ་འཁྲུལ་པ་དང་མ་འཁྲུལ་བའི་ཁྱད་པར་གྲུབ་པས་འཇིག་རྟེན་ལ་ལྟོས་ནས་དེ་ཉིད་མཐོང་བར་གསུངས་ཀྱི།",
    "ཡང་དག་པར་ན་སྐད་ཅིག་མར་སྣང་བ་དེ་ཡང་མི་བདེན་པའི་དོན་སྣང་བ་ཡིན་པས་འཁྲུལ་པ་ལས་ག་ལ་འདས།",
    "དེ་ལ་ལུང་གཞན་གྱིས་གནོད་པ་སྤང་བ་ལ་བཞི་ལས་དང་པོ་ཚོགས་ཀྱི་རྟེན་གསུངས་པས་མི་གནོད་པནི།",
    "སྲིད་པ་གཞན་རྗེས་སུ་འཛིན་པའི་རྒྱུན་རྗེས་སུ་འཇུག་པར་ལྟར་གསུངས་པ་ཡིན་ལ་སྒྱུ་མའི་རྟ་གླང་ནི་ཤི་ནས་ཡང་མི་སྐྱེ་བ་ཡིན་པས་ཇི་ལྟར་འཐད་སྙམ་ནས་རྒོལ་བ་ནི་གལ་ཏེ་ཞེས་པའོ།",
    "དེའི་ལན་དུ་གཉིས་པ་ཉིང་མཚམས་སྦྱོར་བ་གསུངས་པས་མི་གནོད་པ་ནི་ཇི་སྲིད་ཅེས་པ་ལ་སོགས་པ་སྟེ།",
    "རྒྱུན་རིང་བ་ཙམ་གྱིས་བདེན་པར་མི་འགྲུབ་ལ་རྒྱུན་ཐུང་བ་ཙམ་གྱིས་བརྫུན་པར་མི་འགྲུབ་པ་ནི།",
    "གསུམ་པ་ལས་ཀྱི་རྟེན་གསུངས་པས་མི་གནོད་པ་ནི་སྒྱུ་མའི་ཞེས་པ་སྟེ།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་དོན་དམ་མྱ་ངན་ལས་འདས་པ་དང་།",
    "འོན་ཏེ་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་དོན་དམ་པར་མྱ་ངན་ལས་འདས་པ་དང་།",
    "དེས་ན་ཡེ་ཤེས་རྒྱུན་ཆད་པར་འདོད་པ་ནི་མི་ལེགས་ཏེ།",
    "དེ་དག་ལོག་ན་སྒྲིབ་པ་མཐའ་དག་མ་སྤངས་པར་འགྱུར་ཏེ།",
    "དོན་དམ་པར་བློ་ཐམས་ཅད་ཀྱི་ཡུལ་བདེན་པར་མ་གྲུབ་པས་འཁྲུལ་ཞེས་ཐ་སྙད་དུ་བྱས་ལ།",
    "ཞེས་གསུངས་སོ།",
    "སྐུའི་ཕྲིན་ལས་ཡེ་ཤེས་སྔོན་དུ་འགྲོ་ཞིང་ཡེ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་འགྲེལ་པ་བཞུགས།",
    "གོམས་པའི་ཡན་ལག་དང་མ་བྲལ་ན་གསལ་བ་རབ་ཀྱི་མཐར་ཐུག་པར་འགྲོ་སྟེ།",
    "གས་མཉམ་པར་མ་བཞག་པ་མི་མངའོ་ཞེས་པའི་ལུང་དང་།",
