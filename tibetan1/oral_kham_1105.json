    "སང་བལྟས་པས་ཉིན་པར་བྲིས་པ་དང་ཁྱད་མི་འདུག་པ་དང་།",
    "རང་རང་སོ་སོའི་སྣང་ངོར་མང་དུ་གསུངས་ཤིང་།",
    "རྡོ་རྗེ་རྣལ་འབྱོར་མ་ཡིན་སྙམ་པ་ཅིག་འདུག་པ།",
    "འདི་ཀ་ཙམ་པའི་དེ་བཞིན་གཤེགས་པ་མང་པོས་ཞིང་འདི་ཐམས་ཅད་གང་འདུག་གསུངས།",
    "སུས་ཀྱང་ཅི་ཡང་བསྲེགས་པ་མི་འདུག་པས།",
    "དགེ་སྦྱོར་བ་ཁོ་ན་སྡོད་ས་ཅིག་དགོས་པ་འདུག་གསུངས་ནས་དེ་ཚོའི་ཞལ་ཏ་མཛད་པ་དང་།",
    "ཁྱེད་ཀྱི་འདི་སྔོན་ལས་སུ་གདའ་བས་ཕུག་སངས་སངས་རང་མི་འགྲོ།",
    "སྤྱིར་སློབ་དཔོན་ཉིད་ཐུགས་དམ་ཅིག་མཛད་ན་ལེགས་པར་གདའ་གསུངས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "དེའི་རྗེས་སེམས་ཟིན་ནས་ཏིང་ངེ་འཛིན་མང་པོ་སྐྱེས་ཏེ་སྒོམ་ཆེན་བཟང་པོ་ཅིག་བྱུང་འདུག་གོ།",
    "འདུག་ཀྱང་ངེས་པ་ཆེར་མེད་པ་འདྲ།",
    "དེ་རྗེས་ཐོག་ཏུ་གྲོགས་མེད་གཅིག་པུར་བསྡད་ཙ་ན།",
    "ཐུགས་སྒྲ་སོགས་བྱུང་ཙ་ན་ཁང་ཁྱིམ་སོགས་སྣང་བ་རང་དགའ་མ་འདི་འཆར།",
    "དེ་ལམ་འབྲས་པའི་ངོ་བོ་ཉིད་གསུམ་སྐྱོང་ཚུལ་དེ་ཀ་ལ་ཉམས་ལེན་བྱས་པའི་འབྲས་བུར་འདུག་གསུངས།",
    "དུས་ཅིག་ཞི་བའི་གཡག་བདུན་རྐུན་མས་ཁྱེར་འདུག་པ།",
    "ང་ཡང་མ་ཤི་ཙམ་དང་འཕྲད་པར་འདུག་གསུངས་ནས་སྐུ་མཚམས་སྔར་བས་དམ་དུ་བཏང་།",
    "སླེབས་འཕྲལ་སྐྲ་མདུན་དུ་མཇལ་བས་སྐ་བསྙེལ་པོ་རང་ལས་མི་འདུག་ན་ཡང་ཤིན་ཏུ་མཉེས།",
    "ནམ་མགོན་ཡང་དེ་སྐད་ཟེར་གྱིན་འདུག་ན་ཡང་།",
    "ད་ཕན་འདུག་གསུང་།",
    "ཉིན་ཕྱེད་ཙམ་དུས་དྲུང་ནས་ན་ནིང་ནས་ཐུགས་དམ་འཕེལ་པོ་ནི་བྱུང་གདའ།",
    "ཁྱེད་རྣམས་དེ་རིང་ཕུལ་བའི་གདན་འདི་ཡང་བཞི་འདུག་པས་ལོ་བཞི་སྡོད།",
    "ཁྱེད་རང་ཡང་དགེ་སྦྱོར་ལ་དྲིལ་བ་འཐད།",
    "མི་ཉུང་བ་འདི་བས་དགེ་སྦྱོར་དྲག་པ་མི་འདུག་གསུངས།",
    "ད་སྤྲོས་པ་མང་པོ་ཁམས་ཀྱིས་མི་ནུས་པ་འདུག་པས།",
    "དེ་ཚེ་སྣང་བ་ཐམས་ཅད་སྟོང་གཟུགས་ཀྱི་ཚེ་དཔག་མེད་ཀྱི་སྐུ་འབའ་ཞིག་ཏུ་འཆར་གྱིན་འདུག་པས།",
    "ཕྱི་མ་ལ་ཡང་ཚེ་རིང་པོ་ཅིག་འོང་བར་འདུག་གསུངས།",
    "ད་འགྲོ་བར་གདའ།",
    "བློ་སྦྱོང་ན་འདུག་པའི་ཁ་རག་པའི་གཏམ་རྒྱུད་དང་འདྲ་གསུངས།",
    "འདིའི་གཟུགས་ཀྱང་གསོལ་ཇ་བ་ལ་མཛེས་རྒྱུ་ཡང་མི་འདུག་པ་དང་།",
    "ས་སྐྱ་པའི་བསྟན་པ་ལ་ཁྱད་ཆེ་བར་གདའ་སྟེ།",
    "སྒོ་རུམ་གྱི་ཕྱག་དཔེའི་དཀར་ཆག་ཏུ་འདུག་པས་ཐུགས་དགེས་ཏེ་བདག་ཆེན་དྲུང་དུ།",
    "བདག་ཆེན་གྱི་དྲུང་ནས་དཀོན་གཉེར་ལ་ཁོང་ཕྱག་དཔེ་རྣམས་ལ་ལྟ་རྟོག་ཚར་གཅིག་བྱེད་འདོད་པར་འདུག་པས།",
    "དང་ར་དང་ཁང་པ་རྣམས་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་པའི་སྐས་ལ་འཛེགས་བྱོན་པས།",
    "དེ་ནས་མཚམས་དེའི་ཤར་འགུག་ཅིག་ན་བཞུགས་གདན་ཅིག་མཛད་འདུག་པ་ལ་བཞུགས་ནས།",
    "མནལ་ལམ་དུ་ས་བཟང་ན་བཞུགས་འདུག་པའི་རྣམ་པ་ཞིག་ལ།",
    "བྱ་སྤྱོད་གཉིས་པོ་འདི་དིང་སང་བཀའ་མ་ཆད་ཙམ་ལས་མི་འདུག་པས།",
    "འདི་གཉིས་སོས་པ་ཅིག་བྱུང་ན་བོད་དུ་བསྟན་པ་ཡོངས་སུ་རྫོགས་པ་ལེགས་པོ་ཅིག་འོང་བ་འདུག་སྙམ་སྟེ།",
    "འདི་ད་དུང་ཡང་འདོད་པ་བཞིན་སོས་པ་ཅིག་བཞག་ས་མེད་པ་འདི་སེམས་ཀྱི་གཙེར་པ་ཅུང་ཆེ་བར་འདུག་ཅེས་གསུང་བ་འདི་ནི།",
    "ཞིང་སྟེང་ཕ་ཏ་ན་ས་སྐྱའི་གུར་མགོན་ལྕམ་དྲལ་གྱི་འཆམས་སྐུ་དེ་གཉིས་བཞུགས་འདུག་པ་ཡིན་ཁང་པ་ཕ་ཏ་ན་འོང་བ་ལ་བལྟ་བ་ཡིན་པ་འདུག་ཅེས་གསུང་བ་ནི།",
    "ཁྱེད་རང་རྣམས་འདི་ཚོ་རུ་ལས་དཀའ་བྱས་ན།",
    "ཁྱེད་རང་ཨེན་ཚ་ཁར་ཕྱིན་ནས་ལས་དཀའ་བྱས་ན་ཡོན་རྫོངས་ཐམས་ཅད་གསེར་དུ་འོང་བས་འགྲོ་ན་ངས་བསྐྱལ་ཟེར་ཡང་།",
    "སྐ་ལུས་ལ་ཤིན་ཏུ་གཟན་པར་འདུག་ཅིང་།",
    "དེ་ལ་སྤྱིར་ཡར་ལུངས་སུ་ཕེབས་པ་དེས་སྐུ་ཚེ་ལ་བར་ཆད་ཅུང་ཟད་ཅིག་བྱུང་འདུག་གསུངས་ནའང་།",
    "སྐུ་ཚེའི་བར་ཆད་ལ་སོགས་པས་སྐྱོན་ཅན་དུ་འགྲོ་བ་མི་འདུག་ནའང་།",
    "སྐུ་གཟུགས་ལ་ཤེད་མེད་པ་ཁོ་ན་འདུག་སྟེ།",
    "རྗེ་བཙུན་གྱི་སྐུ་ཅིག་ཁ་བུབ་ཏུ་བཞུགས་འདུག་པ།",
    "ཆེན་པོ་ཀུན་བསོད་པས་གར་དང་དཔའ་བོ་མཛད་ཀྱིན་གདའ།",
    "དབུ་ཡོན་ཡོན་མཛད་ཀྱིན་གདའ་ཞེས་ཞུས་པས།",
    "སྐྲ་གཟུགས་ཕྲུག་ཕྲུག་མཛད་ཅིང་སྤྱན་འབྲུ་ཚུགས་སུ་མཛད་ཀྱིན་འདུག་པ།",
    "གར་བྱེད་མཁན་དེ་པ་རིག་མ་བཅུ་དྲུག་ཡིན་པ་འདུག་གམ་གསུངས།",
    "དེའི་སྤྲོས་པ་ནི་ཆོད་འདུག་གཞན་སེམས་ཀྱི་ལྷག་མ་ཅུང་ཟད་ཀྱང་མེད་ཅེས་གསུངས།",
    "གཞན་ལ་རྐྱེན་སྡུག་བྱུང་ཙ་ན།",
    "སེར་པོ་ལ་སོགས་པ་རབ་ཏུ་མང་པོ་བྱོན་འདུག་པ་རྣམས་གོས་དར་གྱི་ན་བཟའ་བཟང་པོ་དང་དྲི་བཟང་དང་བཅས་ཏེ།",
    "རྗེ་འདིའི་དགོངས་པ་ལ་བདག་ལ་དེ་ཙམ་གྱི་ཁུར་གནང་བྱུང་ཙ་ན་ལམ་འབྲས་ཤིག་ཞུ་གཞན་མི་འོང་ཀྱང་དགེ་སྦྱོར་གྱི་གཙོ་བོ་དེ་ལ་བྱེད་དགོས་པར་འདུག་དགོངས་པ་བྱུང་།",
    "སྤྱོད་རྒྱུད་ལ་ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ།",
    "ཀུན་རྫོབ་སེམས་བསྐྱེད་ཀྱི་སྒོ་ནས་བདག་འཛིན་འཇོམས་པའི་ཐབས་མཆོག་ཏུ་གྱུར་པ་འདི་ཁོ་ནར་འདུག་དགོངས་པ་བྱུང་།",
    "བཟའ་བའི་དམ་ཚིག་དུས་ཁྱད་པར་ཅན་དང་།",
    "དགེ་སྦྱོར་ལ་གནོད་ཅེས་ཁོ་རང་ལ་གསུངས་པ་དང་།",
    "ངོར་ནས་ཆིབས་པ་བོ་དོང་བར་བསྐྱལདེར་དོལ་པའི་པོ་སོ་སྟག་ལའི་ཚ་བོ་ཤི་ནས་བོ་དོང་ན་ཆོ་ག་བྱེད་ཀྱིན་འདུག་དེར་པོ་སོས་རྟ་བཟང་པོ་གཅིག་ཕུལ་བ་ལ་ཆིབས་པ་མཛད་དེ་ཡར་ཕེབས་ཅིང་།",
    "རིམ་གྲོ་བྱས་པ་ཁྱེད་རང་རྣམས་ལ་ཕན་པས་བྱས་ཀྱང་འགལ་བ་མེད།",
    "རྟགས་ཕྱི་མ་གཉིས་ཀྱི་གསལ་ཁ་འདི་ཡིན་གསུང་བར་མི་འདུག་དེ་ནས་སྨིན་དྲུག་ཟླ་བ་ཕྱི་མའི་ཚེས་གཉིས་ཀྱི་ཉིན་སྐུ་གཟུགས་ཀྱིས་མ་ལྕོགས།",
    "ཡང་ནུབ་གཅིག་རྨི་ལམ་དུ་ཐུབ་པ་འཁོར་ཇོ་བོ་ཡང་འདུག་བཅས་གདུགས་ཚོད་གསོལ་གྱིན་འདུག་པའི་གྲལ་གཤམ་ན།",
    "མི་དེ་ཐུགས་རྗེ་ཆེན་པོ་ཡིན་པར་འདུག་གསུངས།",
    "བོད་ཀྱི་རྒྱལ་བློན་རྣམས་བྱང་སེམས་སུ་འདུག་ཁྱད་པར་ལྷ་བཙུན་ཁུ་དབོན་བྱང་སེམས་སུ་འདུག།",
    "ཅེས་གསུངས་གདའ་བ་གསུངས་པས།",
    "སྒོམ་ཙ་ན་སྐྱེ་བའི་རྒྱ་མཚོ་མཐར་དབྱུང་།",
    "སྤྱན་སྔ་རུག་པ་ན་བཞུགས་ཙ་ན།",
    "རང་དང་སྐལ་མཉམ་ཙམ་དུ་བལྟ་བའང་མ་བྱུང་འདུག་པས།",
