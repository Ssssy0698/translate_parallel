    "ཡབ་ཀྱི་སྐུ་དུས་ལྟར་ཆབ་སྲིད་ཀྱི་གནས་བབ་བརྟན་བརླིང་ལྡན་པའི་ངང་ནས་རྒྱུན་འཛིན་གནང་བ་རེད།",
    "ཡབ་སྟག་རི་གཉན་གཟིགས་སྐུ་འཚོ་བཞུགས་སྐབས།",
    "ལས་ཀའི་རིམ་པ་མང་ཆེ་བར་རང་བཞིན་གྱིས་རྒྱུས་མངའ་གཏིང་ཟབ་ལྡན་པ་ཞིག་ཏུ་གྱུར་ཡོད་པ་རེད།",
    "ཡབ་སྟག་རི་གཉན་གཟིགས་ཀྱི་ཕུགས་འདུན་དང་།",
    "ཞི་དྲག་གི་གནང་ཐབས་མང་ཆེ་བ་མཁྱེན་གྱི་ཡོད་ལ།",
    "ཕྱི་ནང་གི་རྒྱུ་རྐྱེན་མང་པོ་ཞིག་ལ་ལྟོས་ནས་ཡོད་པ་ཞིག་ཡིན་པ་ཁོང་གིས་གསལ་པོ་མཁྱེན་གྱི་ཡོད།",
    "ཡབ་སྟག་རི་གཉན་གཟིགས་ཀྱི་སྐུ་དུས་སུ་ཐོག་མར་བོད་ལ་གསང་བའི་ཐོག་ནས་འབྲེལ་བ་འཛུགས་མཁན་དང་།",
    "རྗེས་སུ་གཉིས་མོས་ཀྱི་གྲོས་མཐུན་དང་མནའ་འཇོག་བྱེད་མཁན།",
    "སྔ་མོ་བོད་ཀྱི་རྒྱལ་ཕྲན་ཞིག་སྟེ།",
    "སྔ་མོ་ཡུལ་འདིའི་མིང་ལ་ཡུལ་ངས་པོ་ཞེས་ཟེར་ཡང་།",
    "ཡབ་སྟག་རི་གཉན་གཟིགས་ལྟར་ཆབ་སྲིད་ཀྱི་འཇོན་ཐང་ཡོད་པ་དང་།",
    "དཔའ་ངར་བློ་སྟོབས་ལྡན་པ་ཞིག་ཡིན་མིན་ལ་དོགས་པ་ཆེན་པོ་ཞིག་རང་བཞིན་གྱིས་ཡོང་གི་ཡོད་སྟབས།",
    "སྤྱིར་བཏང་གི་འབྲེལ་ལམ་བསྐྱར་གསོ་དང་རྒྱུན་འཛིན་བྱས་པ་ཙམ་མ་གཏོགས།",
    "ཡབ་སྟག་རི་གཉན་གཟིགས་ཀྱི་སྐུ་དུས་ལྟར་ཡིད་ཆེས་བློ་འགེལ་ཆ་ཚང་བྱེད་ཐུབ་ཀྱི་མེད་པ་རེད།",
    "ཁོང་ཚོས་བོད་ཀྱི་ཕྱོགས་ལ་ཡིད་ཆེས་དང་བློ་འགེལ་ཆ་ཚང་བྱེད་ཐུབ་ཀྱི་མེད་པའི་རྣམ་འགྱུར་གསལ་པོ་ཚོར་གྱི་ཡོད་ཀྱང་།",
    "དཔའ་ངར་བློ་སྟོབས་ལྡན་པ་ཞིག་ཡིན་པའི་བརྡ་སྟོན་ཡང་གནང་གི་ཡོད་པ་རེད།",
    "མཇལ་འཕྲད་དང་གྲོས་མོལ་རིམ་པར་གནང་བའི་བརྒྱུད་རིམ་ནང་།",
    "དབའ་དབྱི་ཚབ་སོགས་གནམ་རི་སྲོང་བཙན་ཡང་ཡབ་སྟག་རི་གཉན་གཟིགས་ལྟར།",
    "བློ་རིག་སེམས་རིག་གི་འབྲེལ་བ་གཏིང་ཚུགས་པ་ཞིག་བྱུང་བའི་གཞི་རྩའི་ཐོག་ནས་གསང་བའི་གྲོས་མོལ་རིམ་པར་བྱས་པའི་མཐའ་མ།",
    "ཟིང་པོ་རྗེའི་ཐོག་བཙན་པོའི་དཔུང་དམག་འདྲེན་རྒྱུའི་དུས་ཚོད་གཏན་འཁེལ་ཐུབ་པ་བྱུང་བ་རེད།",
    "བཙན་པོ་གནམ་རི་སྲོང་བཙན་གྱིས་རྟ་དམག་ཁྲི་ཕྲག་ལྷག་གི་དཔུང་སྣེ་དྲངས་ཏེ།",
    "ཕར་རྒོལ་ཐེངས་གཅིག་གིས་ཟིང་པོ་རྗེའི་མཁར་གྲོང་གི་ལྟེ་བ་མཁར་སྤུར་བ་བླངས་ཏེ།",
    "དུས་དེ་ནས་བཟུང་འཕན་པོ་བྱ་བའི་ཡུལ་འདི་བོད་ཀྱི་བཙན་པོའི་མངའ་ཁོངས་སྙོན་མེད་དུ་གྱུར་པ་རེད།",
    "མུ་མཐུད་གསང་གྲོས་ཀྱི་འཆར་བཀོད་ལྟར་རིམ་གྱིས་གཙང་གི་ཕྱོགས་དང་།",
    "ཡབ་བཙན་པོ་སྟག་རི་གཉན་གཟིགས་ཀྱི་ཕུགས་འདུན་ལྟར།",
    "སྐབས་དེར་སྟོབས་ཤུགས་ཆེ་བའི་རྒྱལ་ཁབ་གྲུ་གུ་ཡང་བོད་ཀྱི་དཔུང་དམག་གིས་ཆམ་ལ་ཕབ་སྟེ་མངའ་འོག་ཏུ་བསྡུས་པར་མ་ཟད།",
    "ཅེས་བཙན་པོ་ཁོང་ལ་གནམ་རི་སྲོང་བཙན་ཞེས་པའི་མཚན་གྱི་གཟེངས་བསྟོད་ཕུལ་བ་རེད།",
    "རང་གི་རྒྱལ་ཁབ་དེ་འཕེལ་རྒྱས་ལྡན་པ་དང་།",
    "སྟོབས་ཤུགས་ལྡན་པ་ཞིག་ཡོང་ན་སྙམ་པའི་རེ་བ་ཡོད་པ་སྨོས་མ་དགོས།",
    "འོན་ཀྱང་སེམས་ཁོང་དུ་ཡོད་པའི་རེ་བ་དེ་མངོན་འགྱུར་ཡོང་ཐུབ་མིན་ནི།",
    "རེ་བ་ཡོད་པ་ཙམ་གྱིས་ཕུགས་འདུན་དེ་མངོན་འགྱུར་ཡོང་བའི་ངེས་པ་ག་ལ་ཡོད།",
    "རང་གི་མིག་སྔའི་གནས་ཚུལ་ལས་དེའི་འབྱུང་རྐྱེན་དང་རྒྱབ་ལྗོངས་ཀྱི་རྒྱུ་ཚོགས་ལ་བསམ་བློ་ཞིབ་ཚགས་གཏོང་མཁན་ཞིག་ཡིན་པས།",
    "དེའི་ངོ་གདོང་གི་དཀའ་ངལ་དང་རྣམ་འགྱུར་སེལ་ཐབས་བྱས་པ་ཙམ་མ་ཡིན་པར།",
    "དཀའ་ངལ་དེ་དག་གི་འབྱུང་རྐྱེན་ལ་འཚོལ་ཞིབ་བྱས་ཏེ།",
    "དཀའ་ངལ་དང་འགོག་རྐྱེན་དེ་རིགས་བསྐྱར་ཟློས་སུ་མི་ཡོང་བའི་ཐབས་ལ་འབད་པ་གཙོར་འདོན་གནང་གི་ཡོད།",
    "རྒྱལ་ཁབ་དང་མི་རིགས་དེའི་མང་ཚོགས་རྣམས་འཕེལ་རྒྱས་ཀྱི་ནུས་པ་དང་སྟོབས་ཤུགས་ལྡན་པ་ཡོང་ཐུབ་མིན་ལ་རག་ལས་པ་དང་།",
    "མཐུན་རྐྱེན་ཡང་གྲ་ཇེ་རྒྱས་སུ་གཏོང་བར་འབད་བརྩོན་གནང་གི་ཡོད་པར་མ་ཟད།",
    "བཙན་པོའི་ཐུགས་རེ་གཙོ་བོ་ནི།",
    "ལག་ཐབས་དར་འཕེལ་ཡོང་བའི་ཐུགས་རེ་ཆེན་པོ་གནང་གི་ཡོད་ཀྱང་།",
    "རང་གི་འདོད་པ་ཁེངས་པ་ཞིག་ཡོང་ཐུབ་ཀྱི་ཡོད་མེད་གང་ལྟར་ཡང་།",
    "འོན་ཀྱང་སྐབས་དེའི་མི་རྣམས་ཀྱིས་བཙན་པོ་ཁོང་གི་བཀའ་དྲིན་ཇི་བཞིན་རྟོགས་ཡོད་མེད་ཆ་མ་འཚལ་ཡང་།",
    "སྐབས་དེ་དུས་བཙན་པོའི་ཐུགས་རེ་གནང་བ་ལྟར།",
    "བཙན་པོ་ཁོང་གིས་རྨང་གཞི་བརྟན་པོ་བཏིང་བ་དང་འབྲེལ་བ་གཏིང་ཟབ་ཡོད་པ་སྨོས་མ་དགོས།",
    "བྱང་ནས་ཚྭའི་གཏེར་ཁ་ཕྱེ་བ། ། མི་མང་ཆེ་བར་རང་གི་མི་ཚེའི་འཚོ་བའི་ཁྲོད་ནས།",
    "བསམ་བློའི་གོ་རྟོགས་དང་ཉམས་མྱོང་དེ་དག་གི་རྨང་གཞིའི་ཐོག་ནས།",
    "སྒྱུ་རྩལ་གྱི་རིགས་སྣ་ཚོགས་ཤིག་གསར་གཏོད་ཐུབ་པ་ཡོང་གི་ཡོད་པ་ནི།",
    "ཐ་ན་མིའི་འཚོ་བའི་ཁྲོད་ཀྱི་བཟའ་བཏུང་གི་རིགས་ཀྱང་འདི་ལྟར་འཕེལ་རྒྱས་ཕྱིན་པ་ཤ་སྟག་རེེད།",
    "རྒྱུན་གྱི་འཚོ་བའི་ནང་གི་ཉམས་མྱོང་དང་ཚོད་བལྟ་ནི།",
    "ཉམས་མྱོང་དང་ཚོད་ལྟ་མཉམ་བསྲེས་བྱེད་པ་ནི།",
    "རྒྱུན་གྱི་འཚོ་བའི་ནང་ཉམས་མྱོང་གསོག་པ་དང་ཚོད་ལྟ་གནང་བར་ཐུགས་སྣང་ཆེན་པོ་མཛད་ཀྱི་ཡོད།",
    "ཕྱི་ནང་གི་རྒྱུ་རྐྱེན་དང་བརྒྱུད་རིམ་ངེས་ཅན་ཞིག་ཡོད་དགོས་པ་ལྟར།",
    "མིའི་འཚོ་བའི་ནང་གི་ཉིན་རེའི་བཟའ་བཏུང་ཚུན་ཆད་ཀྱང་།",
    "ཕྱི་ནང་གི་རྒྱུ་རྐྱེན་དང་བརྒྱུད་རིམ་ངེས་ཅན་ཞིག་ལ་བརྟེན་ནས།",
    "ཁོང་གིས་ཟས་ཀྱི་བྲོ་བ་ཚུན་ཆད་ལ་ཡང་ཞིབ་མོས་རོ་མྱོང་གནང་སྟེ།",
    "བཟའ་བཏུང་གི་རོ་བཅུད་གཉིས་ཀ་འཕེལ་རྒྱས་ཇི་ལྟར་གཏོང་དགོས་པའི་ཐད་ལ་རྒྱུན་དུ་དགོངས་པ་བཞེས་གནང་གི་ཡོད།",
    "ཁོང་ཅག་གིས་ཚྭའི་བྲོ་བཅུད་དང་བྱེད་ནུས་ཀྱང་རྟོགས་ཐུབ་མེད་ཀྱང་།",
    "གདོང་གི་ནག་ཐིག་དང་ཤ་འཛེར་རིགས་གཙང་སེལ་ཐུབ་པ་བཅས་ནུས་པ་སྣ་ཚོགས་ལྡན་པ་ཞིག་ཡིན་པར་ཤེས་རྟོགས་བྱུང་བས།",
    "ཁོང་གི་སྐུ་དུས་སུ་བྱང་ཚྭའི་གཏེར་ཁ་ཕྱེས་ཏེ།",
    "བོད་ཁམས་ཡོངས་སུ་ཚྭ་ལ་ལོངས་སྤྱོད་པའི་དར་སྲོལ་ཆེན་པོ་བྱུང་བ་རེད།",
    "བཙན་པོ་ཁོང་གིས་བྱང་ཚྭ་དབུས་སུ་དྲངས་པའི་རྗེས་སུ།",
    "ཚྭ་ནི་བོད་མིའི་འཚོ་བའི་ནང་གི་རྒྱུན་སྤྱོད་ཀྱི་དགོས་མཁོ་ཆེན་པོ་ཞིག་ཏུ་གྱུར་པར་མ་ཟད།",
    "སྐབས་དེར་ཕུང་གཡག་ཐལ་ཀ་བྱ་བའི་གནས་སུ་བྱང་འབྲོང་སྨྱོན་པ་ཞིག་ཐུགབྱང་འབྲོང་སྨྱོན་པ་དེས་ངར་སྐད་སྒྲོགས་ཤིང་།",
    "གནས་དེ་ག་རང་དུ་བྱང་འབྲོང་སྨྱོན་པ་ས་ལ་འགྲིལ་སོང་བ་རེད།",
    "བྱང་གི་ཚྭ་གཏེར་ཡོད་སའི་ཐད་དུ་སླེབས་པ་ན།",
    "འབྲོང་ཤ་རྟ་ཐོག་ནས་ས་ལ་ལྷུང་བས་ཤའི་ཆ་ཤས་མང་པོ་ཞིག་ལ་ཚྭ་འགོས་པ་རེད།",
    "ཐོག་མའི་སྐབས་བཙན་པོ་ལ་ཡ་མཚན་གྱི་སྣང་བ་ཞིག་བྱུང་བ་རེད།",
    "ཞིབ་འཇུག་གི་རིགས་ལམ་དམིགས་བསལ་བ་ཡོད་མཁན་ཞིག་ཀྱང་ཡིན་པས།",
    "འབྲོང་ཤ་ས་ལ་ལྷུང་སའི་ས་གནས་དེ་དང་འབྲེལ་བ་ཡོད་པའི་དོགས་པ་ཆེན་པོ་ཞིག་རང་བཞིན་གྱིས་བྱུང་བ་རེད།",
    "ཁོང་ཚོས་ཞིབ་ཏུ་ལྟ་བའི་སྐབས།",
    "ཞིབ་འཇུག་གི་བརྒྱུད་རིམ་དེའི་ཐོག་ནས་བྱང་ཚྭའི་གཏེར་ཁ་འབྱེད་ཐུབ་པ་བྱུང་ཡོད་ལ།",
    "འཕེལ་རྒྱས་ཡོང་བར་འབད་བརྩོན་གནང་གི་ཡོད།",
    "སྔོན་མ་ཡབ་སྟག་རི་གཉན་གཟིགས་ཀྱི་སྐུ་དུས་སུ།",
    "གནམ་རི་སྲོང་བཙན་གྱིས་རང་གི་ཡབ་ཀྱིས་གསར་གཏོད་དང་རྨང་གཞི་བརྟན་པོ་མཛད་པ་དེའི་ཐོག་ནས།",
    "སྔར་ལས་ཀྱང་ཚོང་ལས་ཀྱི་བྱ་བ་རྒྱ་ཇེ་ཆེར་བཏང་སྟེ།",
    "རྒྱ་ཁྱོན་སོགས་ཀྱི་ཐོག་ནས་བཙན་པོ་གནམ་རི་སྲོང་བཙན་གྱི་དུས་སྐབས་ནི།",
    "བོད་འདི་སྟོབས་ཤུགས་ལྡན་པའི་རྒྱལ་ཁབ་ཅིག་ཡིན་པའི་རྣམ་པ་གསལ་འདོན་མཛད་ཐུབ་ཡོད་པ་རེད།",
    "བཙན་པོ་གནམ་རི་སྲོང་བཙན་གྱིས་འདི་ལྟར་རང་གི་རྣམ་དཔྱོད་དང་དངོས་པོ་བརྗེ་ལེན་གྱི་ཚོང་ལས་བྱེད་བཞིན་པ།",
    "རང་ཚུགས་བརྟན་པོས་གནས་ཐུབ་པའི་རྒྱལ་ཁབ་ཅིག་གི་ངོ་བོར་འཕེལ་རྒྱས་བཏང་གནང་ཡོད།",
    "སྟོབས་ཤུགས་དང་མངའ་ཐང་གི་འཕེལ་རྒྱས་དེ་དག་ནི།",
    "ཕྱི་ནང་གི་རྒྱུ་རྐྱེན་དང་བརྒྱུད་རིམ་ངེས་ཅན་ཞིག་ལ་བརྟེན་ནས་བྱུང་བ་ཡིན་པ་སྨོས་མ་དགོས་ཀྱང་།",
    "རང་གི་སྐུ་སྲོག་རྒྱལ་ཁབ་ཀྱི་དོན་དུ་དོར་བ། ། བཙན་པོ་གནམ་རི་སྲོང་བཙན་གྱིས་རྒྱུན་དུ་བོད་ཁམས་འཕེལ་རྒྱས་སུ་གཏོང་བ་ནི།",
    "རྒྱལ་ཁབ་འཕེལ་རྒྱས་ཀྱི་དོན་དུ་རང་གི་སྐུ་སྲོག་གཏོང་དགོས་ཀྱང་ཕངས་སེམས་གཏན་ནས་མི་མཛད་མཁན་ཞིག་དང་།",
    "བཙན་པོ་ཁོང་འབངས་མང་ཚོགས་ལ་ལྷག་བསམ་རྣམ་དག་དང་།",
    "མང་ཚོགས་ཀྱིས་ཀྱང་ཁོང་ལ་མི་མང་སྐྱོང་བའི་བྱམས་ལྡན་གྱི་རྒྱལ་པོ་ཞིག་ཏུ་བརྩིས་ཏེ།",
    "བཙན་པོ་རང་ཉིད་མང་ཚོགས་ཀྱི་རྒྱབ་སྐྱོར་དང་གཞི་རྩ་ལྡན་པ་ཞིག་ཡིན་པའི་སྤོབས་པ་ཆེན་པོ་ཡོང་གི་ཡོད་ཀྱང་།",
    "མང་ཚོགས་ཀྱིས་བསྐུར་བའི་རེ་བ་དང་ཡིད་ཆེས་ནི།"
  ]
}