    "བསྟན་སྲུང་ཁྱེད་རྣམས་བདག་ཅག་གི།",
    "རེ་བའི་ཤིང་རྟ་འགེངས་ཕྱིར་བསྔོ།",
    "ཡུམ་རུ་ཡོང་བཟའ་སྟོང་རྒྱལ་ན་མོ་ཚོ་གཉིས་ཀྱི་སྲས་སུ་སྐུ་འཁྲུངས།",
    "རྣོ་ཟ་མང་དགར་བྱ་བ་བཙུན་མོར་བཞེས་པར་སྲས་ཁྲི་གཉན་བཟུང་བཙན་འཁྲུངས།",
    "འོན་ཀྱང་བཙན་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་བཙན་གྱིས་ཞི་དྲག་གི་གནང་ཐབས་སྣ་ཚོགས་ལ་བརྟེན་ནས།",
    "རྒྱལ་ཁབ་ཀྱི་ཆབ་སྲིད་བརྟན་ལྷིང་རྒྱུན་འཁྱོངས་ངང་ནས་ཡར་རྒྱས་གོང་སྤེལ་མཛད་པར་མ་ཟད།",
    "རིགས་ཤིག་གིས་མེས་དབོན་རྣམ་གསུམ་གྱི་དང་པོར།",
    "རྒྱལ་པོ་ཉེར་བདུན་བོན་ལུགས་ནི་བོད་ཀྱི་མང་ཚོགས་ཡིད་ཆེས་དང་དད་གུས་ཞུ་ཡུལ་གཙོ་བོ་ཞིག་ཏུ་གྱུར་ཡོད།",
    "བོད་ཀྱི་མང་ཚོགས་ཀྱི་བསམ་བློ་དང་མངོན་འདོད་ནི་སྔར་ལས་གྲུང་པོ་དང་རྣམ་དཔྱོད་ལྡན་པ་ཞིག་ཏུ་འགྱུར་བཞིན་ཡོད་པར་བརྟེན།",
    "རྒྱལ་ཁབ་དེ་དང་མི་རིགས་དེའི་མང་ཚོགས་ཀྱི་གཞི་རྩ་ལ་བརྟེན་ནས་གྲུབ་ཡོད་པ་སྨོས་མ་དགོས་པས།",
    "མང་ཚོགས་ཀྱི་བསམ་བློའི་མངོན་འདོད་དང་།",
    "བཙན་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་བཙན་གྱིས་མང་ཚོགས་ཀྱི་བསམ་བློ་དང་།",
    "བོད་ཁམས་ཁྱོན་ཡོངས་ལ་བརྟན་ལྷིང་མེད་པའི་ཡོ་འཁྱོམ་ཆེན་པོ་ཞིག་ཡོང་ངེས་ཡིན་པར་བརྟེན།",
    "བཙན་པོས་ཛ་དྲག་གི་གནས་བབ་དེ་ལ་རན་པའི་སྲིད་བྱུས་གང་འདྲ་ཞིག་འཛིན་དགོས་པ་དང་།",
    "མང་ཚོགས་ཀྱི་འཚོ་བ་དང་བསམ་བློ་བཅས་དུས་རབས་དང་མཐུན་པར་འཕེལ་རྒྱས་ཡོང་ཐུབ་པའི་དགེ་མཚན་ཆེན་པོ་ལྡན་པའི་གནས་ལུགས་འདི་ཡང་།",
    "བཙན་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་བཙན་གྱིས་གསལ་པོ་རྟོགས་ཀྱི་ཡོད་པ་རེད།",
    "སྒེར་པའི་ཆབ་སྲིད་ཀྱི་ཁེ་ཕན་རྐྱང་པ་ལ་དམིགས་པའི་སྲིད་དོན་པའི་ཤོག་ཁག་རྨོངས་དད་ཞེན་ཁོག་གིས་ཡིད་བརླམས་པའི་མང་ཚོགས་དཀྱུས་མ་བཅས་དཔུང་ཁག་སྟོབས་ལྡན་ཞིག་གིས་ནུས་ཤུགས་ཡོད་དགུ་རྩལ་འདོན་བྱས་ཏེ།",
    "འོན་ཀྱང་བཙན་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་བཙན་གྱིས་རང་གི་མིག་མདུན་དུ་འགོག་རྐྱེན་ཇི་ཙམ་ཡོད་མེད་ལ་མ་ལྟོས་པར།",
    "དེ་ལ་མང་ཚོགས་ཀྱི་བདེ་སྐྱིད་དང་མངོན་འདོད་སྒྲུབ་པའི་ནུས་པ་མེད་པར་གྱུར་ཟིན་པས།",
    "ད་དུང་ཡང་དེ་ལ་ཨུ་ཚུགས་དང་ཞེན་ཁོག་གིས་མཁྲེགས་འཛིན་བྱས་ན།",
    "བསམ་བློའི་གོ་རྟོགས་འཕེལ་བར་ལས་འགུལ་རིམ་པར་བརྩམས་གནང་གི་ཡོད།",
    "བཙན་པོས་འདི་ལྟར་ཕྱི་ནང་གི་འགོག་རྐྱེན་རིགས་གང་ཐུབ་ཀྱིས་གཙང་སེལ་བྱས་ཏེ།",
    "གསུང་གི་རྟེན།",
    "ཡིན་ན་ཡང་མང་ཚོགས་ཕལ་ཆེ་བ་ནི།",
    "ཤིན་ཏུ་དཀའ་ཁག་གི་གནས་སུ་གྱར་ཡོད་པ་རེད།",
    "གསར་དུ་གདན་འདྲེན་ཞུས་པའི་སྐུ་གསུང་ཐུགས་རྟེན་དེ་དག་གི་བཞུགས་གནས་སུ་གཙུག་ལག་ཁང་ཞིག་ཀྱང་གསར་དུ་བཞེངས་ཏེ།",
    "སྐུ་གསུང་ཐུགས་རྟེན་དེ་དག་གཙུག་ལག་ཁང་གསར་པའི་ནང་དུ་བཞུགས་སུ་གསོལ་བ་རེད།",
    "བཙན་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་བཙན་གྱིས་རང་གི་ཡབ་མེས་རྒྱུད་ཀྱི་མེས་པོ་གྲི་གུམ་བཙན་པོའི་སྐུ་དུས་སུ།",
    "བཙན་པོ་ཁོང་གིས་བོད་ཁམས་སྐྱོང་བ་ལ་མིག་སྔར་འདེམས་ཀ་གཉིས་ལས་ལྷག་མེད་པ་རེད།",
    "བཙན་པོས་རང་གི་ཚེ་སྲོག་དང་མངའ་ཐང་སྲུང་སྐྱོབ་བྱ་བའི་དོན་དུ།",
    "སྔ་མོའི་གནས་སྟངས་གང་ཡིན་པ་དེ་གར་རང་སོར་འཇོག་རྒྱུ་དང་།",
    "བོད་རྒྱ་ཆེའི་མང་ཚོགས་ཀྱི་མངོན་འདོད་དང་དགོས་མཁོ།",
    "མང་པོ་ཞིག་གིས་འདི་སྐབས་དེའི་བོན་ལུགས་ལ་དད་ཞེན་ཆེ་བའི་བློན་པོ་ཞིག་ཡིན་ལུགས་ཀྱང་བཤད།",
    "རང་གི་འཕྲལ་གྱི་ཁེ་ཕན་སྒྲུབ་ཐབས་དང་།",
    "བློ་མཛངས་པའི་བློན་པོའི་ཚོགས་ལ་ཡང་གྲོས་བསྡུར་ལན་མང་གནང་གི་ཡོད་པ་རེད།",
    "ཐག་གཅོད་གནང་ཟིན་པའི་ལས་དོན་ཐོག་མང་ཚོགས་སྐུལ་འདེད་བྱེད་མ་ཐུབ་ན།",
    "ཐག་གཅོད་བྱེད་མཁན་གྱི་གང་ཟག་གི་ཀུན་སློང་ཡང་དག་པ་དང་།",
    "ཐག་གཅོད་དེར་མང་ཚོགས་ཀྱི་ཁེ་ཕན་སྒྲུབ་པའི་ནུས་པ་ཇི་ཙམ་ཡོད་མེད་བཅས་ལ་རག་ལས་པར་མ་ཟད།",
    "ཐག་གཅོད་དེ་ལ་མོས་མཐུན་བྱེད་པའི་རྒྱབ་དཔུང་ནུས་ཤུགས་ཅན་ཞིག་ཡོད་མེད་ལ་ཡང་རག་ལས་ཀྱི་འབྲེལ་བ་ཆེན་པོ་ཡོད་པ་རེད།",
    "བསམ་བློ་གཅིག་གྱུར་གྱི་རྒྱབ་དཔུང་བརྟན་པོ་ཡོང་བའི་ཐབས་སུ་འབད་བརྩོན་གནང་གི་ཡོད་པ་རེད།",
    "འགལ་བ་ཅན་གྱི་ཐག་གཅོད་གཉིས་ལས་དོན་གཅིག་གི་སྟེང་དུ་ཡོང་ཐབས་མེད་པས།",
    "བློ་ཁ་མང་པོ་མཐུན་པའི་ཕྱོགས་ལ་ཐག་གཅོད་ཡོང་བར་འབད་བརྩོན་གནང་གི་ཡོད།",
    "རང་གིས་གསར་དུ་འགོ་འཛུགས་བྱེད་བཞིན་པའི་ལས་དོན་གྱི་རིགས་ལ།",
    "རང་གི་མི་ཚེ་ཡང་གཞན་ངོ་སྲུང་བའི་བྲན་གཡོག་ངོ་མ་ཞིག་ཏུ་གྱུར་ཏེ།",
    "རང་གི་བསམ་ཡུལ་ན་མེད་པའི་ལས་ངན་གནོད་ཚབས་ཅན་མང་པོ་ཞིག་རང་བཞིན་གྱིས་བསྒྲུབ་དགོས་པར་གྱུར་ཏེ།",
    "རང་གི་ལུས་སྲོག་ཚུན་ཆད་བདེན་དོན་དང་དམངས་ཀྱི་བདེ་དོན་གྱི་ཆེད་དུ་བློས་བཏང་མཛད་པ་ལ་བརྟེན་ནས།",
    "བཙན་པོ་ཁོང་བོད་ཁམས་སུ་ཤེས་རབ་ཀྱི་སྣང་བ་འདྲེན་པའི་སྐྱེས་བུ་རླབས་ཆེན་ཞིག་ཏུ་གྱུར་ཐུབ་ཡོད་པ་རེད།",
    "གཉན་པོ་གསང་བར་མཆོད་ཅིང་བཀུར་བ། ། འགྲོ་བ་མིའི་སེམས་ནང་གི་ཡུལ་གོང་མ་ལ་མཆོད་ཅིང་བཀུར་བའི་འདུ་ཤེས་ནི།",
    "བསམ་བློའི་གཏིང་གི་ཡིད་ཆེས་དང་།",
    "ལྐོག་གྱུར་གྱི་ནུས་པ་ལ་བརྟེན་ནས་མདུན་མ་ཆེན་པོ་སྒྲུབ་པའི་གསང་བའི་སྒུལ་ཤུགས་ནུས་པ་ཅན་ཞིག་ཀྱང་ཡིན་པ་རེད།",
    "རྒྱ་ཆེ་བ་རྒྱལ་ཁབ་ཀྱི་ལས་དོན་ནས་བཟུང་སྟེ་ཁྱིམ་ཚང་གི་ཉིན་རེའི་ལས་དོན་བར།",
    "དེ་དང་མཉམ་དུ་ལྐོག་གྱུར་གྱི་ནུས་པ་གཞན་པ་ཞིག་ལ་བརྟེན་དགོས་པར་ཡིད་ཆེས་གཏིང་ཟབ་གནང་མཁན་ཞིག་ཆགས་ཡོད་པ་རེད།",
    "བཙན་པོ་རང་གི་མྱོང་བ་ལས་གྲུབ་པའི་འཇིག་རྟེན་ལྟ་ཚུལ་དང་འབྲེལ་བའི་ལས་དོན་སྒྲུབ་སྟངས་ཁྱད་པར་བ་ཞིག་ཀྱང་ཆགས་ཡོད་པ་རེད།",
    "གནས་ལུགས་སྟོང་གི་རྒྱབ་དཔུང་དང་ལྡན་པའི་བསམ་བློ་ཡང་དག་པའི་ལྟ་ཚུལ་ཞིག་ཡིན་ཏེ།",
    "སྔོན་དང་ད་ལྟའི་སྐྱེས་བུ་གཟུ་བོར་གནས་ཤིང་ཤེས་རབ་ཀྱི་རྩལ་རྫོགས་པ་མང་པོ་ཞིག་གིས་ཀྱང་།",
    "ཤའི་མིག་གི་མཐོང་སྣང་ལས་བརྒལ་བའི་ལྐོག་གྱུར་གྱི་ནུས་པ་ལ་ཡིད་ཆེས་མཛད་ཅིང་།",
    "རང་ཉིད་ཀྱི་ནུས་པས་མི་འདང་སའི་ཡུལ་དུས་དང་གནས་སྟངས་མང་པོ་ཞིག་ཡོང་གི་ཡོད་པ་སྨོས་མ་དགོས་ལ།",
    "རང་གི་ནུས་ཤུགས་གང་ཡོད་འདོན་དགོས་པ་སྨོས་མ་དགོས་ཀྱང་།",
    "མིག་གིས་མི་མཐོང་བའི་ལྐོག་གྱུར་གྱི་ནུས་པ་གཞན་པ་ཞིག་ཡོད་པ་ཁས་མི་ལེན་མཁན་ཚོའི་རློམ་སེམས་ཀྱི་ལྟ་ཚུལ་ཞིག་ཡིན་པ་རེད།",
    "རང་གི་བསམ་བློ་དང་གནང་ཐབས་དེ་མ་ནོར་བ་དང་ཡང་དག་པ་ཞིག་ཡོང་གི་ཡོད་མེད་ནི།",
    "རང་གི་མྱོང་བ་དང་དངོས་ཡོད་གྲུབ་འབྲས་གཞི་ལ་བཞག་པའི་ཐོག་ནས་ཐག་གཅོད་བྱ་དགོས་པ་དང་།",
    "དེ་ནི་ཐག་གཅོད་གནང་སྟངས་མ་ནོར་བ་དང་ཡང་དག་པ་ཞིག་ཡིན་པའི་གཟིགས་ཚུལ་བརྟན་པོ་ཡོད་པ་རེད།",
    "ཁོང་ཚོས་རང་ཉིད་ཀྱི་མྱོང་བ་དང་མིག་སྔའི་གྲུབ་འབྲས་ལ་ཡིད་ཆེས་གནང་བ་མ་གཏོགས།",
    "རྣམ་དཔྱོད་རྨད་དུ་བྱུང་བའི་མཛད་པ་ཞིག་ལ་ངོས་འཛིན་གནང་གི་ཡོད་པར་མ་ཟད།",
    "ཡང་དག་པ་ཞིག་ཡིན་པའི་སྒྲུབ་བྱེད་འགྲན་ཟླ་མེད་པ་ཞིག་ཏུ་གྱུར་ཡོད་པ་རེད།",
    "བཙན་པོ་དགུང་ལོ་དྲུག་ཅུ་ཟིན་པའི་བགྲེས་སོང་ཞིག་ཏུ་གྱུར་ཡོད་ཀྱང་།",
    "ཁོང་གིས་སྐུ་གསུང་ཐུགས་རྟེན་དེ་དག་ལ་མཇལ་བའི་རྗེས།",
    "བཙན་པོ་རང་ཉིད་ཀྱི་དད་པའི་སྟོབས་དང་སྐུ་གསུང་ཐུགས་རྟེན་དེ་དག་གི་བྱིན་མཐུ་ལ་བརྟེན་ནས།",
    "བཙན་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་བཙན་དགུང་ལོ་བརྒྱ་དང་ཉི་ཤའི་བར་བདེ་སྐྱིད་ལྡན་པར་འཚོ་གནས་ཐུབ་པ་བྱུང་བ་རེད།",
    "རང་གི་མིག་མཐོང་ལ་གྲུབ་པའི་མྱོང་བ་མངོན་སུམ་པ་དེ་ལ་བརྟེན་ནས།",
    "ཤིན་ཏུ་ངོ་མཚར་ཅན་དང་ལྐོག་གྱུར་གྱི་ནུས་པ་ཁྱད་པར་བ་ལྡན་པ་ཞིག་ཡིན་པར་ཡིད་ཆེས་ལྡོག་ཏུ་མེད་པ་ཞིག་ཡོང་རྒྱུ་ཡིན་པ་སྨོས་མ་དགོས་པ་རེད།",
    "རྒྱལ་པོ་དགུང་ལོ་དྲུག་ཅུ་པ་སླར་ན་ཚོད་དར་ལ་བབས་པའི་ལང་ཚོ་ལྟར་ཡ་མཚན་དུ་གྱུར་ཅིང་།",
    "གཉན་པོ་གསང་བ་ཞེས་པའི་མཆོད་གནས་དེ་དག་གི་ཤུགས་རྐྱེན་དང་།",
    "ཁོང་གི་ཤལ་འཛིན་རྗེས་རབས་པ་ཚོ་ལ།",
    "ཤིན་ཏུ་གཅེས་པའི་གདམས་ངག་གི་དྭངས་མའི་ཚུལ་དུ་གསོལ་སྩལ་མཛད་ཡོད་པ་རེད།",
    "རྒྱལ་པོའི་སྐུ་གཤེན་སོགས་ཀྱིས་འགོག་རྐྱེན་བྱ་རྒྱུ་ཡིན་པ་བཙན་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་བཙན་གྱིས་གསལ་པོར་མཁྱེན་གྱི་ཡོད་པ་རེད།",
    "ལས་གཞི་དེ་ལ་བཀག་འགོག་བྱེད་མཁན་གཅིག་ཀྱང་མ་བྱུང་བ་རེད།",
    "བོད་དུ་བོན་ལུགས་དར་ཤུགས་ཆེ་བའི་སྐབས་རྒྱལ་པོ་སོ་སོར་སྐུ་གཤེན་རེ་ཡོད་ལ།",
    "དངོས་སུ་བཀག་འགོག་བྱེད་མཁན་ཡང་མཚམས་མ་ཆད་པར་ཡོང་གི་ཡོད་པར་བརྟེན།",
    "བཙན་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་བཙན་གྱིས་རང་གི་མིག་སྔར་འགོག་རྐྱེན་གྱི་རྒོལ་འཛིངས་ཇི་ཙམ་མང་པོ་ཡོད་མེད་ལ་མ་ལྟོས་པར།",
    "བཙན་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་བཙན་གྱིས་རང་གི་ཕུགས་འདུན་ད་ལྟར་མངོན་གྱུར་མ་བྱུང་ཡང་།",
    "ཞེས་ལུང་བསྟན་གྱི་ཚུལ་དུ་ཞལ་ཆེམས་ཀྱང་མཛད་ཡོད་པ་རེད།",
    "ཤིན་ཏུ་གཟིགས་རྒྱང་ཡངས་པའི་བཙན་པོའི་ཞལ་ཆེམས་འདི་ནི།",
    "བཙན་པོ་ཁོང་གིས་སྔོན་དཔག་མཛད་པ་ལྟར་དོན་དངོས་སུ་ཡང་།",
    "ཕྱི་ནང་གི་འགོག་རྐྱེན་དང་གནོན་ཤུགས་ཇི་ཙམ་ཡོད་མེད་ལ་མ་ལྟོས་པར།",
    "ཅེས་རང་གི་ཤལ་འཛིན་པ་ཚོར་སྐུ་གསུང་ཐུགས་རྟེན་འདི་དག་ལ་མཆོད་བཀུར་དང་།",
    "བདག་ཉར་གཅེས་སྐྱོང་བྱ་དགོས་པའི་ཐུགས་རེས་ཞལ་ཆེམས་མཛད་པ་རེད།",
    "ལྷག་པར་དུ་བཙན་པོས་རང་གི་རྒྱལ་སྲིད་འཛིན་པའི་བུ་རྒྱུད་ཕྱི་མ་དང་།",
    "གཉན་པོ་གསང་བའི་མཆོད་གནས་དེ་དག་རྒྱུན་གནས་མི་ཐུབ་པའི་འགོག་རྐྱེན་སྣ་ཚོགས་བྱ་རྒྱུའི་ཉེན་ཁ་གཟིགས་ཀྱི་ཡོད་སྟབས།",
    "གཉན་པོ་གསང་བའི་དགོངས་དོན་མངོན་གྱུར་ཡོང་ཐབས་ཀྱི་ལམ་སྟོན་རིམ་པ་མཛད་ཡོད་པ་རེད།",
    "གདུག་རྩུབ་ཆེ་བའི་གོམས་སྲོལ་ངན་པ་འདི་ལ་འགྱུར་བ་གཏོང་དགོས་པ་བསམ་བློའི་ཟུར་ལ་ཡང་འཁོར་གྱི་མེད་པ་རེད།",
    "བཙན་པོ་ལྷ་ཐོ་ཐོ་རི་གཉན་བཙན་གྱིས་བོད་ཀྱི་གོམས་སྲོལ་འདི་བཟང་པོ་ཞིག་ཏུ་གཏན་ནས་གཟིགས་ཀྱི་མེད་ཀྱང་།",
    "མོ་རང་ཕྱིར་ནང་དུ་ཕྱིན་པ་མཐོང་བ་རེད།",
