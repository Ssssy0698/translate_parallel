    "དུས་བསྒོ་མཐར་གཅིག་ལས་མི་མཛད་པ་སྔ་དྲོ་སྡོམ་པ་ཐོབ་པའི་བསྒྲུབ་བྱ་གཅིག་དང་ཕྱི་དྲོ་ཐོབ་པ་ཞིག་ལ་བསླབ་པ་རྒན་གཞོན་མེད་པའི་རྩིང་སྐྱོན་དུ་འདུག་མཱ།",
    "ཞེས་གསུངས་པ་འདི་ནུས་པ་ཤིན་ཏུ་ཆེ་བ་འདུག་གོ།",
    "སོ་ཐར་གྱི་སྡོམ་པ་སྐད་ཅིག་དང་པོ་དེ་ལ་ཁོ་རང་དུ་གྱུར་པའི་རྣམ་པ་སཾ་ན་ཆརིག་བྱེད་ཀྱི་གཟུགས་དང་།",
    "པའ་བཀཆུ་༦ པརང་རང་ཆོ་གས་རིམ་བཞིན་དུ།",
    "རྐང་ངས་མ་པ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "རང་རང་གཞུང་ལུགས་བཞིན་བྱེད་ན།",
    "སྡོམ་གསུམ་གནས་འགྱུར་ཀྱང་སྤྱིར་བཏང་དམིགས་བསལ་ལས་ཐམས་ཅད་ལ་ཁྱབ་པར་བཞེད་པའི་ངེས་པ་མི་འདུག་ཅིང་།",
    "རྒྱ་བོད་ཀྱི་མཁས་གྲུབ་ཕལ་ཆེར་བཞེད་༨༧བ་པ་མཐུན་པར་འདུག་པས།",
    "སྐྱེས་པ་དང་ནི་འདུག་མི་བྱ།",
    "ཞེས་ལོ་ཆེན་བློ་ལྡན་ཤེས་རབ་ཀྱི་ཆེ་བརྗོད་འདི་ལ་བཅུ་བདུན་དང་པོར་བསྟན་ལ་ཞུགས་པ་དགེ་ཚུལ་ཙམ་མིན་པའི་ངེས་པ་མི་འདུག་ཅིང་།",
    "དེ་ལ་རྟིང་པ་གཉིས་ཀྱིས་མནན་ནས་ཙོག་ཙོག་པུར་འདུག་ཏུ་བཅུག་ནས་ཞེས་གསུངས་པ།",
    "ཕ་གུའི་སྟེང་དུ་རྩྭ་བཏིང་བ་ལ་རྟིང་པ་གཉིས་ཀྱིས་མནན་ཏེ་ཙོག་ཙོག་པུར་འདུག་ཏུ་བཅུག་སྟེ།",
    "ཞེས་བྱ་བ་ལ་ཕ་གུའི་སྟེང་དུ་རྟིང་པ་གཉིས་ཀྱིས་མནན་ནས་ཙོག་ཙོག་པུར་འདུག་ཏུ་གཞུག་པ་ཡུན་རིང་ཙོག་ཙོག་པུར་འདུག་པ་སྡུག་བསྔལ་བ་དེའི་ཕྱིར་བནའདི་རྗེས་སུ་གནང་སྟེ།་",
    "རྫོགས་པར་བསྙེན་པར་བྱ་བ་ལ་སོགས་པའི་སྐབས་ཐམས་ཅད་དུ་རྫོགས་པར་བསྙེན་པར་བྱ་བའི་གང་ཟག་དེ་ཕ་གུའི་སྟེང་དུ་རྐང་པ་གཉིས་ཀྱིས་འདུག་ཏུ་གཞུག་པར་བྱའོམ།",
    "སྟེང་དུ་རྟིང་པ་གཉིས་ཀྱིས་འདུག་ཏུ་གཞུག་གོ།",
    "མི་གནས་པར་འདུག་པར་མི་བྱ།",
    "དེ་ལ་འདུག་པ་ཉལ་བར་མི་བྱའོ།",
    "རྒྱུ་ལས་༣ཚོན་ཆེན་བརྒྱད་ཀྱི་ཁ་བསྒྱུར་བྱེད་པ་བཀག་འདུག་ཀྱང་།",
    "དེ་ནི་རུང་བ་དང་རང་མིང་ཉིད་ཀྱིས་ཞེས་པས་ཆོད་དོ།",
    "གོས་ཀྱི་རྒྱུད་དང་རང་བཞིན་དང་།",
    "ལམདུན་དུ་ཙོག་པུར་འདུག་སྟེ།",
    "ལངས་པ་མིན་པར་ས་ལ་འདུག་བཞིན་པ།",
    "ཉི་མ་ཕྱེད་བར་འདི་ནི་དུས་ཡིན་ཏེ་པ་དེ་ཡོལ་གང་ཞིག་དུས་རུང་ཟ་བྱེད་དེ།",
    "ནག་དུས་ཡིན་པ་ལ་མ་ཡིན་པར་འདུ་ཤེས་པ་དང་།",
    "ཡུལ་དེ་རྒན་ན་ཕྱག་བྱ་ཙོག་པུར་འདུག་སྟེ་གཉིས་ཀའི་ལག་པ་གཡོན་གྱི་མཐིལ་དུ་བཞག།",
    "འདུན་ཐམས་ཅད་འདུག་ཅིང་མཐུན་པར་གྱུར་པ་ལ་དགེ་སློང་གནས་པ་དང་གཉུག་ཅན་ནུབ་པ་༡༣༩ན་མར་གནས་༥པ་རྣམས་ཀྱིས་མཚམས་ཆེན་པོའི་ཕྱོགས་བཞིའི་མཚན་མ་བརྟན་པོ་བཙུགས་པ་དག་བརྗོད་པར་བྱའོ།",
    "འདུག་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱའོ།",
    "སན་༥ བཅས་འདིར་གཞུང་ནི་ཉེ་བར་འཁོར་ལས་ཐམས་ཅད་ནི་འདུག་ས་དང་བཅས་པ་ཡིན་ཏེ་ནང་།",
    "བ་ས་༡༤གལ་ཏེ་དེ་དག་མི་གདའ་ན་བཙལ་བར་མི་བགྱི་ཞིང་།",
    "ང་རང་དེ་བླངས་ནས་རྒྱུག་པར་མི་བྱའོ།",
    "ནམ་མཁའ་ལ་འདུག་པར་མི་བྱའོ།",
    "ནས་ཟས་རྩིག་པའི་ཕྱི་རོལ་གྱི་འདོམ་གང་ཚུན་ལའང་བསྲུང་མཁན་འཇོག་པ་ལྟ་སྣང་ལ་ཕྱག་ལེན་གཙང་བ་ས་འདྲ་ཞིག་འདུག་ཀྱང་།",
    "བསྐྲད་པ་ལ་སོགས་པའི་ལས་གང་ལ་བྱ་ཡུལ་གྱི་དགེ་སློང་རྣམས་ལས་ཀྱི་ཁ་སྐོང་དུ་མི་འོས་པ་ལ་གསུངས་འདུག་༣།་",
    "ལག་ལེན་བཟང་གསུང་བ་ལགས་པར་གདའ་བ་ཤིན་ཏུ་མད་པའི་གསུང་ཡིན་སྙམ་པ་བྱུང་ཞིང་།",
    "གལ་ཏེ་རྟོག་དཔྱོད་ཞུགས་ན་ཆེ་ཆུང་རི་དང་མཉམ་པ་འདི་མ་མཐོང་དགོས་པའི་ཚོད་དུ་འདུག་བསམ་པ་བྱུང་ཟེར་བ་ལ།",
    "ད་ལྟར་གྱི་རིགས་པ་བསྒྲེས་པས་ཤེས་བསམ་པ་བྱུང་ཟེར་བ་འདུག་པ་ལ།",
    "གཉིས་ཀྱིས་མནན་ནས་ཙོག་ཙོག་པུར་འདུག་ཏུ་བཅུག་ནས།",
    "ཅེས་རྒྱས་པར་གསུངས་པ་འདི་རྣམས་ས་དགེའི་མཁས་པ་རྣམས་ལ་ཡང་གྲགས་ཆེ་བར་མི་འདུག་པས་བློ་གསལ་ཟ་པ་རྣམས་ལ་བསྐྱེད་ཐོན་པའི་ཕྱིར་དུ་གསུང་ཇི་ལྟ་བ་བཞིན་བཀོད་པ་ཡིན་ནོབ།",
    "བཅོ་ལྔ་རྣམས་ལ་རིམ་པ་བཞིན་རྒྱལ་ཆེན་བཞིའི་གཡོག་དང་བུ་དང་རང་ཉིད་འོང་བར་གསུངས་པས་དུས་བཟང་གསུམ་ཀ",
    "དཀའ་བའི་གནས་༣པ་ནང་རང་གྲོལ་ཡིན་པའི་ཕྱིར་ཏེ།་",
    "འཆབ་ཉེས་ཡོད་མེད་དུ་འདུག་ལ་འཆབ་ཉེས་མེད་པ་ལ་མཐོལ་བའི་དོན་མེད་པས་ཅིག་ཅར་བའི་ཐ་སྙད་དོན་དང་མི་མཐུན་ནོན།་",
    "མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་ཏུ་བཅུག་ལ།",
    "མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་ཏུ་བཅུག་ཅིང་།",
    "ཡོངས་སུ་དག་གོ་ཞེས་༡༨༦ན་ཁོ་ན་ཉིད་མཆི་ཡིན་གདའོ།",
    "མི་གནས་པར་འདུག་པར་མི་བྱའོ།",
    "མདུན་དུ་ཙོག་༧བཔུར་འདུག་པའི་ཕྲག་པ་གཡོན་པ་ལ་གདིང་བ།",
    "མིན་ན་བར་ཆད་དང་མི་ལྡན་པ་གདའ་ལགས་ཞེས་བརྡ་སྤྲོད།",
    "བརྙན་པོ་ཚུན་ཆོད་ཀྱིས་ཐམས་ཅད་ཚང་བར་ཡོད་པ་ཡིནའདུག་བཞི་པ་བསམ་པ་མཐུན་པའི་རྐྱེན་ལ།",
    "འབྲིང་རང་རྒྱལ།",
    "དེ་ཡང་རང་གཅིག་པུའི་དོན་དུ་མ་ཡིན་གྱི།",
    "ཅི་ལ་ལོངས་སྤྱོད་ཀྱང་སྡུག་བསྔལ་གྱི་ལོངས་སྤྱོད་ལས་མི་འདུག་པས།",
    "ཁྱེད་རང་ལེགས་སོ་གྱིས་བྱས་ལ།",
    "དེ་ནས་གསང་ཆ་༣་སྟོན་དེས་བསྒྲུབ་བྱའི་གན་དུ་ཕྱིན་ལ་རང་ལ་ཕྱག་གསུམ་འཚལ་དུ་བཅུག་ནནང་ནས་འ་མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་ཏུ་བཅུག་སྟེ།",
    "ཁྱེད་རང་རྗེས་ཟློས་བགྱི་མི་འཚལ།",
    "སྔར་བཞིན་ཕ་གུའི་སྟེང་ན་དུ་འདུག་ཅིག་ཅེས་བསྒོ་ལ།",
    "ལས་གྲལ་དེར་མི་འདུག་པར་འགྲེང་བ་མ་ཡིན་པ།",
    "རྫུ་འཕྲུལ་གྱིས་ནམ་མཁའ་ལ་འདུག་པ་ལྟ་བུའོ།",
    "དེའང་མཐའ་གཉིས་སུ་མ་ལྷུང་བ་ཞིག་ན་འདགོས་སོ་ཞེས་སྤྱིར་འདོམས་པ་འདིར་གདའ།་",
    "གཉིས་པ་ངལ་ཞིང་དུབ་པའི་མཐའ་སྤོང་བ་འདིར་གདའ་ལྷག་པར་རྙེད་ན་ལྷག་པར་རྙེད་ན་དར་རམ།",
    "ཞེས་ངལ་ཞིང་དུབ་པའི་མཐའ་སྤོང་བ་འདིར་གདའ།་",
    "ལྷག་པར་རྙེད་ན་ལོངས་སྤྱད་པས་ཆོག་གོ་ཞེས་སྟོན་པ་ངལ་ཞིང་དུབ་པའི་མཐའ་སྤོང་བ་འདིར་གདའཁང་པ་འམ།",
    "ལྷག་པར་རྙེད་ན་ཞུན་སྤྱད་པས་ཆོག་གོ་ཞེས་སྟོན་པ་ངལ་ཞིང་དུབ་པའི་མཐའ་སྤོང་བ་འ་དིར་གདའ་མར་རམ།",
    "ཞེས་སྤྱིར་འདོམས་པ་འདིར་གདའ།",
    "༧དེའི་ཆར་གཏོགས་གྲོག་སྦུར་གསོད་པ་སྲོག་གཅོད་ཀྱི་སྦྱོར་དངོས་མཇུག་གསུམ་ཐམས་ཅད་སྤོངས་ཤིག་ཅེས་འདོམས་པ་འདིར་གདའསགནས།",
    "ཚུར་གནོད་པ་བྱུང་ཀྱང་ལན་མི་བྱེད་པར་བཟོད་པ་བསྒོམ་དགོས་སོ་ཞེས་འདོམས་པ་འདིར་གདའ།",
    "ད་གཉེན་པོ་བསྐྱེད་པ་བསྲུང་དགོས་ཞེས་འདོམས་པ་འདིར་གདའ།",
    "པྲགསོལཨ་ད་ལྟར་སབ་དེ་རྣམས་ཇི་ལྟར་སློབ་པ་བཞིན་བསླབ་དགོས་སོ་ཞེས་འདོམས་པ་འདིར་གདའ།",
    "གྲོགས་ནི་ཡོན་ཏན་ཐམས་ཅད་ཀྱི་འབྱུང་གནས་ཡིན་གུཔའི་ཕྱིར་གུས་པར་བྱེད་དགོས་སོ་ཞེས་འདོམས་པ་འདིར་གདའ།",
    "མངོན་རྟོགས་བསླབ་པ་གསུམ་གྱི་རྒྱུད་ཕྱུག་པར་བྱེད་དགོས་སོ་ཞེས་པ་འདིར་གདའ།",
    "གུས་པས་རྗེས་སུ་བསྒྲུབ་པ་ལྷུར་༣བ་ལོང་ཞིག་ཅེས་འདོམས་པ་འདིར་གདའ།",
    "བསྒྲུབ་བྱ་བསྙེན་རྫོགས་སྒྲུབ་བྱེད་ཀྱི་ཐབས་བག་ཡོད་ལ་སྦྱོར་བ་འདིར་གདའ།",
    "ཕྱིས་འབོགས་༢༤ ༣ན་པ་པོ་མེད་ཀྱང་རང་ཉིད་ཀྱིས་རྟེན་གྱི་དྲུང་དུ་བླངས་པས་སྐྱེ་བ་ཡིན་ཏེ།",
    "དེའི་མདུན་དུ་རང་ཉིད་ཙོག་ཙོག་པུར་འདུག་སྟེ།",
    "ཤས་ཤེས་པའམ་པའི་སྡོམ་པ་བླངས་ནས་ཉིན་ཞག་གཅིག་སྤོང་བར་ཁས་བླངས་པས་སྐ་གཟུགས་ཅན་གྱི་སྡོམ་པ་མ་ཤི་བར་དུ་ཁས་བླངས་པ་ལ་དང་ལུང་པ་མི་གཅིག་པས་གཏོང་དོན་ཡང་བ་མི་འདུག་ཅིང་།",
    "༣་༣དམའ་བར་འདུག་སྨྲ་བཟླས་པ་ཡིསཆད།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱིས་ལྷ་ཡི།",
    "བདག་དུས་འདི་ནས་བཟུང་སྟེ་སང་ཉི་མ་མ་ཤར་གྱི་བར་དུ་བསྙེན་གནས་ཡན་ལག་བརྒྱད་པར་བཙུན་པས་གཟུང་དུ་གསོལ།",
    "དེ་ཡོལ་གང་ཞིག་དུས་རུང་ཟ་བྱེད་དེཆས།",
    "འདུག་པ་དང་འགྲེང་བའི་ཁྱད་པར་མ་རབ་གཏོགས་སྔར་ལྟར་རོ།",
    "༡༧༣ བསར་པར་གན་མ་བསྒོས་པར་གཞན་གྱི་སྟན་ལ་འདུག་པ།",
    "༡༧༤ མ་བརྟགས་པར་འདུག་པ།",
    "ང་རང་ལ་ཕན་པར་མ་ཟད།",
    "དག་ཡིག་བློ་ལ་བྱང་ཆ་བྱུང་འདུག་པར་མ་ཟད།",
    "ཚོགས་གཏམ་བཏང་སྟེ་དམའ་འབེབས་བྱེད་ཀྱི་འདུག་ཟེར་བ་ཞིག་གོ་བྱུང་།",
    "འོན་ཀྱང་ད་ལྟ་ཁྱེད་རང་ལ་རྒྱུགས་འབུལ་སྟངས་ལ་བལྟས་ན།",
    "དེར་བརྟེན་མ་འོངས་པར་བོད་ཡུལ་འདི་གང་འདྲ་ཞིག་ཆགས་རྒྱུ་ཡིན་པར་ང་ལ་སེམས་འཚབ་ཆེན་པོ་འདུག་ཚིག་མཚམས་འདིར་སླེབས་པའི་སྐབས།",
    "འདུག་པ་དང་།",
    "ཟས་ཟོས་༧ཀྱི་འོག་ཏུ་ཁྱིམ་པ་འདུག་པ་ལ་མ་བསྒོ་བར་ཁྱིམ་རྣམས་སུ་རྒྱུ་བར་བྱེད་པ་དང་།",
    "༣པེ་སྣར་འདུག་སྣར་དང་།",
    "རྟོགས་པའི་སྒོ་ནས་ནི་མངོན་སུམ་དུ་བྱ་བའོ་། དུས་སུ་གཏམ་ཞེས་བྱ་བ་ནི་ཕ་རོལ་པོ་སྟན་དམའ་བ་ལ་འདུག་པ་ལ་སོགས་པའི་སྒོ་ནས་ཉན་པ་དང་འདོད་པ་དང་ཉན་པར་འོས་པར་ཤེས་ཤིང་འདི་ནི་སྔར་གཏམ་བྱ་བའི་དུས་ཡིན་ནོ།",
    "རངས་པར་བྱེད་པ་ནི་ཡང་དག་པར་བླངས་ཏེ་འདུག་པ་རྣམས་ལའོ།",
    "གུས་པར་བྱ་བ་ནི་སེམས་དམའ་བས་སྟན་༧དམའ་བ་ལ་འདུག་སྟེ།",
    "ཞིག་པ་ནི་གང་ཞིག་ིན་ལུས་རོར་འདུག་པའོ།",
    "རྒྱགས་པར་འགྱུར་བ་ནི་རྒྱགས་པའི་རྒྱུ་ཀུན་ཏུ་བསླངས་ནས་འདུག་པའོ།",
    "ནང་སྟེ་འདུག་པ་ནི་འཁྲུགས་པའི་མཇུག་ཏུ་གདོང་ཁྲོ་གཉེར་དང་བཅས་པར་གནས་ཤིང་ཚིག་ཏུ་མི་སྨྲ་བའོ།",
    "ཇི་ལྟར་འདུག།",
    "སླ་བ་ཡིན་ཏེ་འགྲོ་ཡང་རུང་སྡོད་ཀྱང་རུང་འདུག་ཀྱང་རུང་ཉལ་ཡང་རུང་སྟེ་སླ་བའི་ཕྱིར་དང་།",
    "ས་བོན་དེ་ཡང་དེ་ཉིད་ཀྱི་ས་བོན་འདུག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འབྲས་བུ་འབྱིན་པར་ནུས་པ་ནའོ།",
    "སྒལ་ཚིགས་ཕྱོགས་སུ་མདུན་གྱིས་ཕྱོགས་ཤིང་ཞེས་བྱ་བ་ནི་མ་དང་བསྟེན་པར་འདོད་པས་ཞུགས་པའི་ཕྱིར་སེམས་དེ་དང་རྗེས་མཐུན་པར་འདུག་པ་ལ་བྱའོ།",
    "ལྟོ་ན་གནས་སོ་ཞེས་བྱ་བ་ནི་འདུག་པའོ།",
    "ཕྱི་མ་ལ་མཐོ་རིས་སུ་འགྱུར་བའི་སྦྱིན་པ་དག་དུས་དུས་སུ་སྦྱིན་པར་མི་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ལྟ་བུའི་གནས་སྐབས་སུ་འདུག་གོ་ཞེས་ཟེར་རོ།",
    "འཇིག་རྟེན་ན་ཡང་འགྲོ་འོང་སྐྱེལ་འདུག་པ།",
    "གལ་ཏེ་འགའ་ཞིག་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པ་ལ་དགའ་བ་དང་ལྡན་པ་མ་ཡིན་དུ་ཟིན་ཀྱང་རང་བཞིན་གྱིས་ཆུང་བ་དང་།",
    "དོན་གང་རང་ལ་ངེས་ན་གཞན་ལ་ཡང་གོ་བར་བྱེད་པའི་ཕྱིར་རོ།",
    "མངོན་སུམ་ནི་ནོར་བ་ཉིད་ཡིན་ཡང་རང་རིག་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "བསམ་པ་དང་རང་བཞིན་ཤེས་ནས་ལྷན་ཅིག་འགྲོགས་པར་བྱ་ཞིང་།",
    "རང་བཞིན་གྱིས་རྨོངས་པར་འདུག་པ་ཉིད་ནི་ཞུམ་པ་ཞེས་བྱ་བས་བསྟན་ཏོ།",
    "བཀུར་སྟིར་བྱ་བར་འོས་པ་རྣམས་ལ་ཡང་ལངས་ནས་མདུན་དུ་བསུ་བས་སྟན་སྟོབས་པར་བྱེད་ཅེས་བྱ་བ་ནི་སྟན་ལ་འདུག་ཅིག་པར་གོ་བར་བྱེད་པའོ།",
    "སོ་སོར་བརྟགས་པ་ནས་སེམས་གཟུའོ་ཙམ་དུ་རྣམ་པར་གཞག་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེ་ལྟ་བུར་ཡོངས་སུ་གཟུང་བའི་ཚོགས་དེ་དག་ལ་ཡང་རང་ལ་ཕན་པ་ནི་མེད་པ་ཉིད་དོ།",
    "དེས་ན་སྨྲས་པ་གང་དག་ཐག་རིང་པོ་ན་འདུག་པ་ཡང་རུང་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "དྲུང་ན་འདུག་པ་རྣམས་ཞེས་བྱ་བའོ།",
    "རྣམ་པ་འདི་དག་དུས་གཅིག་ཏུ་མཁྱེན་པའི་ཕྱིར་སྨྲས་པ།",
    "སྟན་ཆེས་མཐོན་པོ་ལ་འདུག་པ་ལ་མ་ཡིན།",
    "༩ ༤༥གཉེན་རྣམས་ཀྱི་དཔོན་ཡིན་ན་ཡང་སོ་སོ་རང་རང་བདག་པོར་གྱུར་པ་ཡིན་པའི་ཕྱིར་བྲན་ནི་མ་ཡིན་པས་དེའི་ཕྱིར་སྟོབས་ཀྱིས་ཕྲོགས་ནས་སྦྱིན་པར་མི་བྱའོ།",
    "སྐྱིད་དེ་བར་འདུག་པ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཚོགས་ཀྱི་ནང་ན་འདུག་ཀྱང་སེམས་དབེན་པར་གྱུར་ཏེ།",
    "གནས་ཤིང་ཞེས་བྱ་བ་བསྟན་པ་ནི་འདུག་པས་ཞེས་བྱ་བའོ།",
    "བཟོད་པ་གོམས་པར་བྱས་པས་མངོན་དུ་ཕྱོགས་པར་གྱུར་པས་འདུག་པ་ནི་གནས་པའོ།",
    "ཞེས་བྱ་བ་ལ་རྒྱུན་དུ་གནས་ཤིང་གཅིག་ཏུ་རྒྱུད་ལ་ཞེན་པར་འདུག་པ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "མིའི་༡༤༥་འོད་ཀྱི་བཞིན་དུ་འདུག་གོ་ཞེས་བྱ་བའི་དོན་བསྟན་པ་ནི།",
    "བདུད་ཀྱི་ཡུལ་ན་འདུག་པར་སྣང་བ་ཡང་ཡིན་ཞེས་བྱ་བའི་དོན་ནི།",
    "མུ་སྟེགས་ཀྱི་གནས་ཐམས་ཅད་ན་ཡང་འདུག་པར་སྣང་ལ།",
    "བྱས་པས་ཡོང་བར་བདོག་ཐུབ་པའི་མངལ་ཟླ་མེད་པར་གདའ་བས་ལུང་ལྟར་ན།",
    "ཁྲ་ཟླའི་སྐར་མ་རྒྱལ་ལ་བབ་པ་ལ་བལྟམས་ཟེར་དགོས་པར་གདའ་ལགས།",
    "དྲུག་བརྒྱ་དང་གཅིག་འདས་པ་ཟེར་དགོས་པ་གདའ་ལགས།",
    "སྦྲང་རྩིའི་དུས་སུ་དེར་བྱུང་བས་དེའི་མཚམས་འཛིན་པར་གདའ་ལགས།",
    "དག་ཅེས་གཉིས་ཚིག་སྨོས་པས་དེའི་ཡང་ཚ་བོ་ཟླ་འོད་ནི་འདས་པར་ཞེས་པར་བསྒྱུར་དགོས་པར་གདའ་བས་བསྒྱུར་བ་ཞུ།",
    "སྒྲོན་མེ་ལ་སོགས་པ་མི་འདུག་བྱས་པས་སློབ་དཔོན་གྱིས་གླུ་བླངས་པ།",
    "དེར་འདི་ནུས་པ་ཐོན་པ་གཅིག་འདུག་པས་ཏི་ལོ་པ་ཡིན་ནམ་སྙམ་པ་དང་ནཱ་རོ་པ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ནཱ་རོ་པས་ད་རུང་གསོལ་བར་འདུག་སྙམ་སྟེ།",
    "ཕྱོགས་རྣམས་སྟོང་ཞིང་རང་ཡང་རྣམ་པར་གྲོལ་ གང་དང་གང་བལྟས་དེ་ནི་རྟག་ཏུ་དེ་ཡིན་ཏེ།",
    "དེ་རིང་རྣལ་འབྱོར་པ་ཞིག་བརྡུངས་ཏེ་ཨ་དེས་པའི་གཅུང་པོ་ཡིན་པར་འདུག་པས།",
    "ལོག་ནས་བྱུང་བ་ལ་བལྟས་པས་ཁ་ན་ཕྱི་བའི་ཤ་འདུག་པ་ཕྱུང་བས་ཞིའོ།",
    "དེ་ནས་མར་ལ་བྱོན་ཙ་ན།",
    "ཁོང་དམ་ཚིག་པར་འདུག་པས་ཡར་བྱོན་གྱིས།",
    "འདུག་སྟངས་སྔོན་དུ་འགྲོ་བའི་ཏིང་ངེ་འཛིན་དང་སྔགས་སོ།",
    "ཙོག་ཙོག་པོར་འདུག་ཅེས་པ་ནི།",
    "སྟན་ལ་འདུག་པ་མ་ཡིན་གྱི་གོང་གོང་པོར་བྱ་བའོ།",
    "གནས་སྦྱིན་པའི་མཐའ་ནི་ནུབ་གཅིག་གནས་ཏེ་འདུག་པས་སོ་ཞེས་པ་ཡིན་ཏེ།",
    "དེ་ལ་སེང་གེའི་སྐུ་ཞེས་པ་ནི་ཡིད་ཀྱིས་སྔོ་བ་ལྟ་བུའང་ལྕང་ལོར་འདུག་པའོ།",
    "སེར་བ་དང་སྔོ་བ་དང་དཀར་བ་ནི་རང་བཞིན་གྱིས་དེ་ལྟར་འདུག་པ་ལ་བྱ།",
    "ར་༡༧༩༤༢གཏུན་གྱིས་བརྡུངས་པ་ལྟ་བུར་ལུས་སམ་མགོ་ལེབ་༧ལེབ་པོར་འདུག་པ་ལ་བྱ།",
    "ཀོསྐོ་གཅིག་ཅེས་པ་ནི་ཀོསྐོ་མདུང་རྩེ་ལྟ་བུར་འདུག་པའོ།",
    "ཕྲག་མིག་ཅེས་པ་ནི་མགྲིན་པ་རོར་ནུབ་པའི་མིག་ཕྲག་པ་དང་མཉམ་པར་འདུག་པའམ་ཕྲག་པ་གཡས་གཡོན་ལ་མིག་ཡོད་པའོ།",
    "ིཚུན་ཆད་ཅེས་པ་ནི་གྲོང་ངམ་གཙུག་ལག་ཁང་བཞི་ལ་འདུག་པ་རྣམས་ཀྱིས་སྐྲ་བྲེགས་པ་ནི་སོར་གཉིས་སྲིད་དུའང་མི་གཞག་པར་བྲེགས་པའོ།",
    "གཙུག་ལག་ཁང་དུ་ཁྲུས་བྱེད་ན་སྟོར་ིཁུང་ག་ལ་འདུག་པར་ཁྲུས་བྱ་བའོ།",
    "མེད་ན་སྐད་ཅིག་ཙོག་ཙོག་པོར་འདུག་ལ་ཁྲུས་རས་ཀྱིས་ཕྱི་ཞེས་པ་ཡིན་ནོ།",
    "མདུན་དུ་འདུག་ལ་མེ་མི་འདེ་ཞེས་པ་ནི་བསྲོ་གང་དུ་འོངས་པའི་ཚེ་སྔ་ན་འཁོད་པའི་མདུན་བཅད་ལ་མེ་འདེ་བར་མི་བྱའོ།",
    "རྩུབ་པོར་རུས་སྦལ་གྱི་གཟུགས་ལྟ་བུའོ་ཞེས་པ་ནི་རྐང་པ་བཀྲུ་བའི་གཞི་ཉིད་རྡོ་ལས་རུས་སྦལ་གྱི་གཟུགས་ལྟ་བུ་རྒྱབ་རྩུབ་པོར་འདུག་པར་བྱོས་ཤིག་པའོ།",
    "ཚུལ་ཕྱི་མར་ཞུགས་པ་ལས་གནས་མེད་པར་གྱུར་ན་ཟླ་བ་གཉིས་ལས་ལྷག་པར་མ་འདུག་ཤིག་པའོ།",
    "གོང་དུ་གནས་མེད་པར་མ་འདུག་ཅིག་ཅེས་པ་དེའི་བྱེ་བྲག་བསྟན་པའི་ཕྱིར།",
    "མེད་པ་ཚོལ་བའི་ཚེ་གནས་པར་འོས་པ་མི་གནས་པར་འདུག་ཀྱང་ཉེས་མེད་ཅེས་པ་ཡིན་ཏེ།",
    "གནས་མེད་པར་འདུག་ཀྱང་ཉེས་པ་མེད་པར་སྟོན་པའོ།",
    "ཞག་ལྔ་ལོན་གྱི་བར་དུ་གནས་མེད་པར་འདུག་ཀྱང་སླ་བའོ།",
    "ཞག་ལྔའི་བར་དུ་གནས་མེད་པར་འདུག་པའི་ཚེ་རྙེད་པ་བླང་དུ་རུང་ངམ་མི་རུང་ཞེ་ན།",
    "སྒོ་བརྡུང་ཞིང་ནང་ན་འདུག་པ་ཤེས་པར་བྱ་ཞེས་པ་ནི་དགེ་སློང་གཞན་གྱི་གནས་ཁང་དུ་འགྲོ་ན་གནས་པ་ཉི་ཚེ་མ་ཡིན་གྱི་སུས་ཀྱང་རུང་སྟེ།",
    "མི་འདུག་ཅེས་པ་ནི་དེའི་མདུན་བཅད་ལ་འགྲེང་ིབའམ་འདུག་པ་མ་བྱེད་ཅིག་པའོ།",
    "འདི་ལྟ་བུར་བྱད་ལག་སྲེལ་ཞིང་འདུག་ཀྱང་སོ་སོའི་མཚན་ཡོད་པས་ན་མ་ནིང་ལ་སོགས་པ་མ་ཡིན་ཏེ་སྡོམ་པ་འཆགས་སོ།",
    "དཀྲེ་སྤྱི་ཞེས་པ་ནི་སྤྱི་བོ་དཀྲེ་ལྟར་སྨྱུག་མྱུག་པོར་འདུག་པའོ།",
    "མིག་གཟེའུ་ལྟར་འདུག་པ་དང་།",
    "སེར་པོ་དཀར་པོ་དམར་པོ་གཅེའུ་རྣ་ཞེས་པ་ནི་རྣ་བ་འདི་རྣམས་ལྟར་འདུག་པའོ།",
    "སྐྲ་སྔོན་པོ་ཞེས་པ་ནི་སྐྲ་རམས་ཁར་འདུག་པའོ།",
    "དེ་ལ་རིང་པོ་ཞེས་པ་ནི་སྤྱི་རིངས་སུ་འདུག་པའོ།",
    "ཏ་ལའི་མགུལ་པ་ཞེས་པ་ནི་མགུལ་པ་ཉེར་ཉེར་པོར་འདུག་པའོ།",
    "མ་ཚོར་བ་དང་རང་བཞིན་ཉམས་པའི་སྐབས་དང་།",
    "བདར་བ་ཕྱི་རོལ་དུ་བྱས་ལ་ནང་དུ་ལྡུགས་པ་དང་བདར་བ་ནང་དུ་བྱས་ལ་ཕྱི་རོལ་དུ་འབོ་བ་ལྟ་བུའང་རངས་པར་འགྱུར་བའོ།",
    "དབེན་པ་ནི་གསུམ་སྟེ་ཞེས་པ་ནི་བསྐོར་བའི་སྒོ་བཅད་དེ་འདུག་པ་དང་།",
    "མཚམས་སུ་འདུག་པ་སྤོས་ན་འདིས་མ་སྐོངས་པ་ཡིན་ཞེས་པ་ནི་འོབས་སམ་མུ་ཚིགས་ལ་སོགས་པའི་མཚམས་སྤོས་ཤིང་བསྒྱུར་ན་རྐུན་པོར་མི་འགྱུར་བ་མ་ཡིན་པའོ།",
    "དེར་མི་གནས་པས་དབྱར་གྱི་གོས་སྐལ་མི་མནོད་ཅེས་པ་ིདབྱར་གནས་དེ་ན་མ་འདུག་པས།",
    "གཞན་ཡང་དུག་ཕྱེ་མ་རླགས་ཤིང་རང་བཞིན་ཉམས་ཏེ་གཏོང་བ་བྲང་དུ་བསྣུན་པ་འཁྲུལ་འཁོར་འཛོལ་རོ་སློང་བ།",
    "མ་བསམས་པར་ལྟོ་མཉེས་པའི་མ་དང་མངལ་ནི་སྦོམ་པོའོ་ཞེས་པ་ནི་མངལ་ན་འདུག་པ་བསད་པའི་ཕྱིར་མའི་ལྟོ་མཉེས་པ་ལས་མངལ་ན་འདུག་པ་ནི་མ་ཤིའི་མ་བསད་པར་མ་བསམས་པ་ལྟ་བུ་ཤི་བ་ལྟ་བུ་གསོད་པར་ཤོམ་པའི་སྦོམ་པོ་ཡོད་པར་ཟད་ཀྱི་མ་ཤི་བ་ཉེས་མེད་པར་མི་འགྱུར་བའོ།",
    "དེའི་ཚུལ་དུ་འདུག་པས་སོ་ཞེས་པ་ཡིན་ཏེ།་",
    "དབེན་པ་ན་འདུག་པ་དང་འགྲེང་བའོ་ཞེས་པ་ལ་སོགས་པ་ཡིན་ཏེ།",
    "རྒྱུས་ཤེས་བཞིན་དུ་ཤིང་ངམ་རྩིག་དྲུང་འདི་ལྟ་བུ་ཞིང་ན་སྡོད་ཅིང་འདུག་གོ་ཞེས་བསྟན་ན་སྦོམ་པོར་འགྱུར་བའོ།",
    "དཔེར་ན་དངོས་སུ་མིག་ལམ་ག་ན་འདུག་ལ།",
    "དེ་ལ་གནས་ཤེས་པ་དེར་འདུག་པ་ཙམ་གྱིས་གནས་སུ་མི་འགྱུར་བས་ན་དེ་མཚན་ཉིད་སྟོན་པ་ནི།",
    "འགྲོ་བ་དང་འདུག་པ་དང་ཐུལ་ཡབས་ཀྱིས་ཇི་ཙམ་སླེབས་པའི་ཁོངས་སོ་ཞེས་པ་ཡིན་ཏེ།",
    "༡༨ ༩ཤིང་ལོ་འདབ་ཆགས་པ་ཞིག་ཏུ་འདུག་ན།",
    "ཆོད་པས་ཁྱེར་ན་མི་བླང་ཞེས་པ་ནི་མི་གཅིག་གཉིས་ཀྱིས་ཆོད་པའི་འོག་ན་འདུག་པས་ཁྱེར་ན་ང་འདོད་དོ་ཞེས་དེ་ལ་མ་སློང་ཤིག་པའོ།",
    "འབྲལ་བའི་ཞག་དུས་ངེས་པར་སྟོན་པ་ནི།",
    "ལོ་ལྔ་བསོད་སྙོམས་སོ་ཞེས་པ་སྦྱིན་བདག་དུས་འདིའི་བར་དུའང་མེད་ན་ཡང་ཉེན་ཀོར་གྱི་གཙུག་ལག་དང་།",
    "ར་༡༧༩ལྟར་མ་གྱུར་ཏེ་རང་བཞིན་ནི་སྔོན་གྱི་སོ་ན་འདུག་པ་ཉེས་པར་བྱས་ན་ནི་ཕྱེད་དུ་འགྱུར་བ་མ་ཡིན་པའང་སྟོན་པའོ།",
    "གང་དུ་དཔང་འཛུགས་པར་འགྱུར་བ་དེར་མི་འདུག་པར་བྱ་ཞེས་པ་ནི་འཐབས་ཤིང་རྩོད་པ་ལ་སོགས་པའི་དཔང་དུ་འགྱུར་བ་ཙམ་གྱི་ཚོད་ན་དེ་ན་མ་འདུག་པར་བྱོལ་ཅིག་པའོ།",
    "འདུན་པ་ལ་སོགས་པ་ཉིད་ཀྱི་ལས་སུ་བྱ་བ་རྣམས་ཀྱང་ཟླ་ལ་གྱིས་ཤིག་པར་སྟོན་པའོ་། བྱ་ར་བྱ་ཞེས་པ་ནི་ཕ་ཟད་ན་འདུག་པའི་དགེ་སློང་དེས་ཁྱིམ་པ་དོང་ངམ་མ་དོང་བ་ལ་སོགས་པ་བགས་ཀྱིས་ལྟ་ཞིང་བྱ་ར་གྱིས་ཤིག་པའོ།",
    "འདུག་ནའོ་ཞེས་པ་ཡིན་ཏེ་གནས་དེ་དག་ལྟ་བུ་ན་འདུག་ན་གདོད་ཉེས་པར་འགྱུར་བའོ།",
    "ཇི་ཙམ་གྱིས་འདུག་པར་འགྱུར་ཞེ་ན།",
    "རྐུབ་བཞག་པ་ཙམ་གྱིས་དེ་ཉིད་དོ་ཞེས་པ་ཡིན་ཏེ་རྐུབ་ས་ལ་བཞག་པ་ཙམ་གྱིས་འདུག་པར་ཆུད་པའོ།",
    "ཞག་གཉིས་སུ་འདུག་ན་ཉེས་བྱས་སུ་སྟོན་པའོ་། བདག་པོ་མེད་ན་ཡང་ངོ་ཞེས་པ་ནི་བདག་པོ་མེད་པའི་འོག་ཏུ་ལན་གཉིས་ཟོས་ན་ཉེས་བྱས་སུ་སྟོན་པའོ།",
    "འདུག་ནས་སོ་ཞེས་པ་ཡིན་ཏེ་འདུག་པའི་གནས་ནས་ལངས་ནས་གདོད་ཉེས་པར་འགྱུར་བའོ།",
    "འདུག་གོ་ཅོག་ལས་སམ་ཞེ་ན།",
    "གནས་སུ་གནའ་ནས་གྱེས་པ་ནི་མ་ལུས་པ་མ་ཡིན་ཞེས་པ་ནི་ཤིང་ལྟ་བུ་གནའ་ིནས་གནས་ཀྱི་ནང་དུ་སྐྱེས་ཤིང་འདུག་པ་ཞིག་ན་ཡང་མཚམས་ཀྱི་ནང་དུ་ལུས་པ་ཡིན་ནོ་བར་སྟོན་པའོ།",
    "རྩ་བ་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་ལ་ལོ་མ་ནང་དུ་བོ་བ་དང་རྩ་བ་ནང་དུ་ཟུག་ལ་ལོ་མ་ཕྱི་རོལ་དུ་བོ་བ་དང་།",
    "ཡང་ཐོག་རྩེག་མའང་དེའོ་ཞེས་པ་ནི་ཁང་པ་བརྩེགས་པ་དུ་མར་འདུག་པ་ཞིག་ན་ཉེ་སྤྱོད་ཀྱི་ཁོངས་སུ་གཏོགས་པར་སྟོན་པའོ།",
    "གྲུའི་ངོར་ཡང་ངོ་ཞེས་པ་ནི་གྲུར་འཇུག་པའི་ཚེ་ན་ཡང་གྲུའི་ངོར་མ་འདུག་ཤིག་པའོ།",
    "མངོན་སུམ་མཚམས་ཀྱི་ནང་རྣལ་མའི་ཕྱོགས་ན་འདུག།",
    "༢༩ ༥ན་འདུག་ཅེས་པ་ནི་སྟེང་དང་ཤོད་ལྟ་བུའམ་སྟེགས་བུ་ལ་སོགས་པ་ཁྲི་འཕང་མཐོན་དམན་མ་ཁྱེར་བར་ས་མཉམ་པའོ།",
    "བསོད་སྙོམས་ཁྱེར་ཏེ་འོངས་པ་ལས་ཁ་རོག་པར་འདུག་གམ་བཀྱིགས་པ་དང་འོ་ན་ཅི་སློང་ཞེས་པ་འདྲི་བ་ནི་ཅི་བདེར་བསྟབས་པའོ་ཞེས་པ་ཡིན་ཏེ།",
    "སེ་གོལ་གཏོགས་ལ་བཞིན་བཟངས་མི་སྣང་བའི་ལམ་དུ་འདུག་ཤིག་ཅེས་བྱ་ཞེས་པ་ཡིན་ཏེ་སྙད་འདི་སྐད་དུ་གྱིས་ལ་སྐྲོད་ཅིག་པའོ།",
    "ཇི་ལྟར་འདུག་པས་ཤེ་ན་མངོན་སུམ་གྱི་ཚུལ་གྱིས་འདུག་ནའོ་ཞེས་པ་ཡིན་ཏེ་གབ་ཅིང་བཞབས་པས་ནི་མ་ཡིན་གྱི་མངོན་སུམ་དུ་འདུག་ཅིང་སྨྱོན་ིངན་གྱི་བར་དུ་གཅོད་ན་གདོད་ཉེས་པར་འགྱུར་བའོ།"
  ]
}