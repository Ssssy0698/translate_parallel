    "ཞེས་ལུང་ལས་གསུངས་པས་རྣམ་འགྱུར་ཅི་ཡང་མ་བྱས་པ་རང་མཐའ་གཅིག་ཏུ་བཞེད་ནུས་པ་དཀའ་བ་འདྲ་སྙམ་ལགས། དྲི་བ་བཅོ་ལྔ་པ་སྙོན་དོར་གྱི་དོན་གཞན་ཅུང་ཟད་བསྟན་པ་ནི་དེ་ཁ་ལྟར་རོ། དྲི་བ་བཅུ་དྲུག་པའི་སྐབས།",
    "དངོས་བརྒྱུད་ལྷན་ཅིག་མི་གནས་པའི་འགལ་བ་སོགས་ཀྱི་ཐ་སྙད་རིགས་ལམ་འདིའི་སྐབས་འདིར་བྱས་པ་ཆེར་མ་མཐོང་ཡང་།",
    "ཤས་ཆེ་ཙམ་བྱས་ཀྱང་སྐྱོན་མེད་པ་འདྲ།",
    "ཡང་དག་འགྲོགས་པར་རབ་བསྟན་པ།",
    "མཚུངས་པར་བྱས་ནས།",
    "ཞེས་གསུངས་པའི་མཚུངས་པར་བྱས་པས་བྱས་གོ་ཆོད་ན་ནི་འདི་ཡང་ཡིན་ལ།",
    "གཞན་ཡང་སྒྲ་མཉམ་པར་འབབ་མི་འབབ་དང་།",
    "མི་མཚུངས་པ་མཚུངས་པར་བྱས་མ་བྱས་ཀྱི་ཁྱད་ཀྱང་ཡོད་དོ།",
    "ཆོ་ག་གཅིག་པར་རབ་བསྡུས་ནས།",
    "བསྟོད་པ་བྱས་པ་ཆ་ཞེས་བརྗོད།",
    "དེ་བཞིན་མིན་པར་བསྟོད་པ་ལྟར་སྣང་བའི་སྨད་པའི་དང་།",
    "ཁྱད་པར་མེད་པར་སྔར་བརྗོད་ནས།",
    "དེ་ནི་དོན་གཅིག་པར་འདོད་དཔེར།",
    "གསུང་བ་འདི་འཁྲ་ས་ཅུང་དྲག་པར་གོ་ལགས། དྲི་བ་ཉི་ཤུ་པའི་ལན།",
    "ཡོན་ཏན་ལམ་ནི་རྣམ་པར་མཛེས།",
    "རྗེས་སུ་བརྩེ་སོགས་ཁྱད་པར་ལ།",
    "ཞེས་སོགས་དེ་དག་རྒྱན་དུ་རིགས་པར་གསུངས་སྣང་བ་ལ་བཀའ་ཇི་ལྟར་སྩོལ།",
    "ཞེས་པ་བཞིན་སྦྱོར་ཚུལ་ཤེས་པས་སྦྱར་ན་གོང་མ་རྣམས་ལའང་སྐྱོན་དུ་མི་འགྱུར་བའི་གནས་སྐབས་ངེས་པར་ཡོད་དོ།",
    "ཞེས་གསུངས་ཤིང་འདི་ལ་སྐྱོན་མེད་ཀྱི་དམིགས་བསལ་ཀྱང་མེད་དོ།",
    "དེ་ཙམ་ལས་གཞན་པའི་གོང་མ་ཐམས་ཅད་ཁྱུད་དེ་མཛད་ནས་དམིགས་བསལ་སྐྱོན་མེད་མ་ཡིན་པར་བསྒྲུབས།",
    "ཚེ་འདིའི་བསྒྲུབ་བྱས་མྱོས་པའི་གླང་ཆེན་ཕལ།",
    "སྐྱེ་བར་ལྡན་པའི་ལེགས་བྱས་ཡངས་པའི་གཟུགས།",
    "རྣམ་པར་དག་པའི་དངོས་པོར་བྱེད་གྱུར་ཅིག། །",
    "གང་ཞིག་དངོས་དང་དངོས་མིན་ལས་གྲོལ་ཤེས་རབ་ཐབས་ཆེན་དབྱེར་མེད་འདུས་མ་བྱས་པའི་གར།",
    "རྣམ་པར་མི་རྟོག་དབྱིངས་ལས་སྐྱེས་པའི་ཡེ་ཤེས་སྣང་བས་འགྲོ་ཀུན་གཏི་མུག་ལས་སྲུངས་ཤིག།",
    "འདབ་མའི་ཕྱོགས་རྒྱ་རྣམ་པར་གྲོལ་བའི་འཛུམ།",
    "རྣམ་པར་རྒྱལ་བའི་མཚན་མས་དགའ་ལྡན་ལྷའི།",
    "༨སྦྱར་བའི་ཕུལ་བྱུང་རྒྱན་ལེགས་བྱས་གསེར་གྱི་འཁོར་ལོ་ཕྱོགས་དང་གླིང་།",
    "ཀུན་ཁྱབ་བསིལ་བའི་སྣོད་གཙང་གཅིག་ཉིད་དུ།",
    "ཆེན་ཕུན་སུམ་ཚོགས་པའི་དཔལ་དུ་མས་མདུན་བལྟས་ཏེ་བལྟམས་པའི་ཕྱིར་པོའི་འབྱོར་པས་འགེངས་དེ་བལྟམས་པར་གྱུར།",
    "རྣམ་པར་སྣང་མཛད་སེར་སྐྱའི་གཞིར་གཤེགས་པ།",
    "ཕང་པར་ཉལ་ལས་ལྷས་བསྟན་དུ་ཆུ་དཀོན་སེར་སྐྱར་ཆུ་ཆེས་པའི་གཉིད་པའི་རྒྱ་ནང་དུ།",
    "དུས་རླབས་ཡོལ་བ་མིན་པར་འཇུག་པའི་མཚོ།",
    "གང་ལས་རྣམ་པར་གྲོལ་བ་ཉེར་ཞིའི་རྫིངས།",
    "རྫོགས་པར་བཀྲུས་ཚེ་སྲིད་པ་སྒྱུ་མའི་མཚང་།",
    "༣༢ རྣམ་པར་མི་རྟོག་ཡེ་ཤེས་དེ་ལས་སླར།",
    "རྨོངས་བྲལ་བདུད་རྩིའི་ནམ་དུ་ལངས་བྱས་ཀྱང་།",
    "༣༧ ངེས་པར་བསྟན་པའི་རྒྱན་རྒྱལ་བའི་ཐུགས་རྗེ་རིས་མེད་ཀུན་ཕན་འདོད།",
    "༣༨ གནས་ལྔར་སྨོན་པ་གྲུབ་པའི་ལེགས་བྱས་དུང་།",
    "གཡས་སུ་འཁྱིལ་བའི་ལྟོ་བ་མ་རྙོངས་པར།",
    "རྒྱུན་གྱིས་འཚོ་བ་རྣམ་པར་དག་པའི་འདབ།",
    "ཁམས་ལ་སྙོམས་པར་ཞུགས་པ་དྲན་པའི་དགྲ།",
    "༤༦ ལེགས་བྱས་ཤིང་རྟས་དྲངས་པའི་ཐུབ་ཆེན་བཀས།",
    "འཛིན་པར་བྱེད་དེ་ཡབ་སྲས་མཇལ་བའི་རྒྱུད།",
    "མཆེད་ཟླས་རིག་པའི་དཔལ་ཀུན་དོན་ཡོད་པར།",
    "༥༣ སྔོན་འབྱུང་སྦྱར་གཟུགས་མ་གཅིག་དྲིན་ལམ་ཡངས་པར་རྣམ་འདྲེན་གྱི།",
    "སྦྱིན་པའི་ཁྱད་པར་འབྲས་བུ་འཇིག་རྟེན་ལས།",
    "ཤིས་བརྗོད་གེ་སར་རལ་པ་གསིག་བཞིན་པར།",
    "༦༣ ལེགས་བྱས་ནྱ་གྲོ་དྷ་ཤིང་མཛེས་པའི་ཏོག།",
    "ཚངས་སྤྱོད་དུལ་བའི་འབྲས་བུས་རྣམ་པར་རྒྱན།",
    "ས་གསུམ་མྱ་ངན་མེད་པར་བྱེད་ཞལ་གྱིས།",
    "༦༨ ཀུན་མཁྱེན་ཞབས་རྡུལ་ཐིག་ལེས་མཚན་མ་ཐག།",
    "འགགས་པར་གྱུར་དེ་ལེགས་ལེན་གཉིས་བསྡུས་པ།",
    "བཀོད་པའི་ཁྱབ་པར་མེ་སྐྱེས་རབ་བྱུང་གཏལ།",
    "༧༩ མཐའ་དག་གཟུགས་ཅན་ལྷག་བསམ་དུས་ཚིག་བཟང་པོས་ལེགས་བྱས་ལམ།",
    "བརྒྱས་འབྱོར་གདངས་ཅན་དཔྱིད་དེ་བསྔགས་པར་འོས།",
    "ཉམས་པར་བྱས་དེ་ལྷས་བྱིན་མ་རུང་སྤྱོད།",
    "རང་མིང་རྣམ་པར་འགྱུར་བའི་སློང་བ་པ།",
    "༩༦ ལེགས་བྱས་སྣང་བ་འགོག་ལ་ཆས་གྱུར་པའི།",
    "འགྲམ་པར་ལེན་ཚུལ་གཅིག་ལས་དུ་མའི་དངོས།",
    "ལེགས་པར་སྦྱོར་བའི་སྔ་དྲོ་བརྩམས་པ་ནས།",
    "འབྲས་བུ་མེད་པར་བསྟན་པ་མི་ཐིལ་སོགས།",
    "༡༤ ནྱ་གྲོ་དྷས་མཚོན་ལེགས་བྱས་ལམ་སྣང་མཛད།",
    "༡༥ ལེགས་བྱས་ཟས་སྐལ་ཉམས་སུ་བླངས་པའི་མེར།",
    "༡༧ བྱ་བའི་རང་བཞིན་བརྗོད་པ་བདེན་པའི་རྗེས་འབྲང་སེམས་ནི་རྣམ་པར་གྲོལ།",
    "འཆི་མེད་ལམ་རབ་རྫོགས་པར་འགེངས་ཞུགས་ཏེ།",
    "མི་ཉམས་མཉམ་པར་གནས་པའི་རྒྱུ་བདུན་གསུངས།"
  ]
}