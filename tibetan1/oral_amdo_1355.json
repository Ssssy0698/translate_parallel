    "དེ་ལྟར་བྱེད་ཀྱི་མ་རེད།",
    "དུས་ཚོད་རན་པོ་ཞིག་ལ་ངང་སྒུག་བྱེད་པ་དང་ཞེན་པ་ལོག་སའི་རྒྱ་མི་རྣམས་ལ་འཐབ་འཛིང་ད་དུང་བྱེད་རྒྱུའི་ཆེད་ཁོང་ཚོས་རང་ཉིད་གྲ་སྒྲིག་བྱས་པ་རེད།",
    "བོད་གཞུང་གིས་རྒྱ་མི་དང་ཞི་མོལ་བྱེད་རྒྱུའི་སྐོར་ཤ་སྟག་ལ་བསམ་བློ་བཏང་པ་རེད།",
    "༡༩༥༥ ལོར་ངོས་རང་རྒྱ་ནག་ནས་ཚུར་ལོག་ཡོང་དུས་ལམ་ཁ་ལ་ཟླ་བ་གཉིས་ལྷག་ཙམ་ཞིག་གི་དུ་ས་ཚོད་བཏང་པ་ཡིན།",
    "རྒྱ་མི་ལ་མི་དགའ་བའི་བསམ་བློ་ཤུགས་ཆེན་པོ་ཡོད་པ་ནི་ཧ་ཅང་གསལ་པོ་རེད།",
    "དུས་ཚོད་དེ་ལ་ངའི་སེམས་ནི་ལམ་ཁ་གཞན་ཞིག་ཏུ་འགྲོ་གི་ཡོད།",
    "ངས་ཁམས་པ་ཚོའི་ཁྲོད་ནས་མཐོང་བ་ནི་ཁོ་ཚོ་རྒྱ་མི་ལ་མི་དགའ་བ་ཙམ་མ་ཡིན་པར་ཁོང་ཚོས་བོད་རང་བཙན་གྱི་བསམ་ཚུལ་ཞིག་སྐྱེད་སྲིང་བྱེད་ཀྱིན་ཡོད་པ་དེ་རེད།",
    "དེ་ནི་ལུང་པ་ཡོངས་རྫོགས་ལ་ཧ་ཅང་དགའ་འོས་པའི་གནས་ཚུལ་ཞིག་རེད།",
    "རྒྱ་ནག་དང་ལྷ་ས་བར་གྱི་ལམ་དེ་གྲུབ་པ་རེད།",
    "ཡིན་ན་ཡང་ལམ་ཁ་དེ་གྲུབ་མ་ཐག་ཏུ་ས་གནས་འདིར་ས་ཡོམ་ཆེན་པོ་བརྒྱབ་པ་རེད།",
    "ཁམས་རྒྱུད་དུ་ཡོད་པའི་ལམ་ཁ་ཕོན་ཆེ་བ་ཞིག་རྩ་བ་ཉིད་ནས་གཏོར་བ་རེད།",
    "ང་ཚོ་ལ་ནི་༧རྒྱལ་བ་སྐུ་ཕྲེང་རིམ་བྱོན་ལ་དམིགས་བསལ་གྱི་འབྲེལ་བ་ཞིག་ཡོད་པ་རེད།",
    "བཅིངས་འགྲོལ་དམག་གིས་འབྲེལ་བ་དེའི་སྐོར་དང་།",
    "དམིགས་བསལ་གྱིས་ཆབ་སྲིད་ཀྱི་ཆ་དེ་ཏོག་ཙམ་ཤེས་ཀྱི་འདུག་སྟབས་ཁོ་ཚོ་དེ་ལ་རྩ་བ་ནས་མ་དགའ་བ་རེད།",
    "ཁྱེད་རང་ལི་ཐང་གི་མི་ཚོ་སྡུག་ཇག་རེད།",
    "ཁྱེད་རང་ཚོ་རྩུབ་པོ་རེད།",
    "ཁྱེད་ཚོས་ང་ཚོའི་གོ་མཛོད་ནས་རྐུ་འཕྲོག་བྱས་པ་རེད།",
    "བྱེད་ཚོས་ང་ཚོའི་ཚོང་ཟོག་སྐྱེལ་འདྲེན་ལ་སྒུག་ར་བརྒྱབ་པ་རེད།",
    "ཁྱེད་རང་ཚོས་ཅིག་བྱེད་ཤེས་པ་དེ་ནི་རྐུན་མ་རྒྱག་རྒྱུ་དང་འཕྲོག་བཅོམ་བྱེད་རྒྱུ་དེ་རེད།",
    "ཐ་ན་ཁྱེད་རང་ཚོས་རང་གི་མེ་མདའ་ཡག་ཤོས་རྣམས་མཆོད་ཤོམ་གྱི་སྒང་ལ་འཇོག་གི་རེད།",
    "ཁྱེད་ཚོ་ནི་བོད་ནང་གི་དཀའ་རྙོག་བཟོ་མཁན་སྡུག་ཤོས་དེ་རེད།",
    "ཅེས་ལབ་པ་རེད།",
    "ལི་ཐང་དང་མི་ཉག་གི་བར་དུ་དྲེལ་ལམ་ཡག་པོ་ཞིག་ཡོད་པ་རེད་ལ།",
    "རྒྱ་མི་ཚོས་དེ་ལ་མོས་མཐུན་བྱས་པ་རེད།",
    "ཡིན་ན་ཡང་ཁོང་ཚོས་བོད་མི་ཇི་ཙམ་ཡོང་གི་ཡོད་མེད་ཐད་ཅི་ཡང་ཤེས་ཀྱི་ཡོད་པ་མ་རེད།",
    "མི་སྟོང་ཕྲག་བཅས་ཏེ་ཡོང་པ་རེད།",
    "ལི་ཐང་ན་མི་གཅིག་ཀྱང་ལྷག་ཡོད་པ་མ་རེད།",
    "ཁོང་ཚོ་ཚང་མ་མི་ཉག་གོང་དཀར་ན་ཡོད་པ་རེད།",
    "དེ་ནི་ང་ཚོའི་མི་ཚེའི་ནང་གི་ལས་ཀ་ཆེས་གལ་ཆེ་ཤོས་དེ་རེད།",
    "དེར་བརྟེན་ང་ཚོ་སྐད་བརྒྱབ་ནས་ངུས་པ་རེད།",
    "རྒྱ་མིའི་དམག་མི་རྣམས་འཚབ་ཤ་ལངས་སོང་།",
    "རྙོག་ཁྲ་དེ་འདྲ་ལྷགས་དུས་དགོས་ངེས་ལ་བརྟེན་དམག་མི་དེ་ལས་མང་བ་རྒྱུགས་ནས་སླེབས་སོང་།",
    "ཁོང་ཚོ་ང་ཚོ་ལ་རྩ་ནས་དགའ་གི་མི་འདུགགང་ཡིན་ཟེར་ན།",
    "དེ་ནི་ཁོང་ཚོས་ལི་ཐང་གི་མི་རྣམས་བོད་ནང་གི་དཀའ་རྙོག་བཟོ་མཁན་སྡུག་ཤོས་དེ་རེད་ཟེར་བ་དེ་ཏག་ཏག་རེད་ལ།",
    "འགྲོ་སོང་བཅས་ཀྱི་ཞིབ་ཕྲའི་རྩིས་ཁྲ་ཉར་དགོས་པ་བཟོས།",
    "ལྷ་སའི་སྲང་ལམ་ཁག་གི་རྒྱབ་ཏུ་གཅིག་ལག་གཅིག་གིས་བརྒྱུད་དེ་བཀྲམས།",
    "ལན་དེ་ཡང་གསལ་པོ་རེད།",
    "མི་མང་སྲང་ལམ་ཁག་ཏུ་ཤོར་ནས་ཁོང་ཁྲོའི་སྐད་འབོད་བྱས་པ་རེད།",
    "ལྷ་སའི་གང་ས་གང་དུ་ཇེ་མང་དུ་སོང་བའི་གཞུང་རྒོལ་སྦྱར་ཡིག་གིས་ཁེངས་པ་རེད།",
    "བཅིངས་འགྲོལ་དམག་གི་ལྟ་རྟོག་པ་ཁག་ཅིག་ལ་ཕར་རྒོལ་བྱས་པ་རེད།",
    "བོད་ཀྱི་ལོ་གསར་དང་སྟབས་བསྟུན་གྱིས་དྲག་པོའི་ངོ་རྒོལ་དེ་ཡང་འཇམ་པ་རེད།",
    "ཁོང་ཚོའི་བཅོས་བསྒྱུར་གཞན་རྣམས་ལག་ལེན་ཆ་ཚང་བ་ཞིག་མ་བསྟར་བར་དུ་མི་ཐུབ།",
    "སྤྱིར་བཏང་བ་ཞིག་བཅས་རེད།",
    "ལི་ཐང་སྐལ་བཟང་ནི་དེའི་གྲས་ཀྱི་གཅིག་རེད།",
    "དུས་ཚོད་སྔ་ཕྱི་ཞིག་རེད་མ་གཏོགས་གྱེན་ལངས་ཆེན་པོ་ཞིག་ཡོང་རྒྱུ་ཡིན་པ་ནི་ངའི་ནང་མི་ཚང་མ་ལ་མཚོན་ན་ཧ་ཅང་གསལ་པོ་ཆགས་བྱུང་།",
    "ལྷ་ས་ན་གནས་ཚུལ་དེ་ཚོ་དངོས་གནས་ཚབས་ཆེ་རུ་འགྲོ་གི་ཡོད་པ་རེད།",
    "ཕྱི་རྒྱལ་གྱི་དམག་མིའི་བསུན་གཙེར་ཇེ་མང་དུ་སོང་བ་དེས་འབྲོག་པའི་མི་ཚེ་ནི་ཆགས་འཇིག་གི་མཚམས་ལ་བསྐྱལ་བ་བཅས་བྱུང་ཡོད་པ་རེད།",
    "ཡིན་ན་ཡང་རྒྱ་མི་ཚོས་རྩིས་ནོར་ཆེ་ཤོས་ཤིག་བརྒྱབ་པ་ནི་རང་གི་ཞི་འཇམ་མ་ཡིན་པའི་ངང་ནས་མེ་མདའ་རྩིས་ལེན་བྱེད་ཐབས་བྱས་པ་དེ་རེད།",
    "འདི་ནི་མཐའ་དོན་ཞིག་རེད།",
    "ཞག་མ་གཅིག་ལ་མཚོན་ཆ་རྣམས་བཙན་ས་ཞིག་ལ་སྦས་པ་རེད།",
    "ཁྱིམ་མི་བཅས་ཀྱི་སྲུང་སྐྱོབ་པ་ཡིན་པའི་རིན་ཐང་དེའི་རྩ་ཆེའི་ཆ་ཤས་ཤིག་རེད་ལ་རྒྱུ་དངོས་གཞན་རྣམས་དེ་ཙམ་གཟབ་ནན་གྱིས་བདག་སྐྱོང་བྱེད་ཀྱི་མ་རེད།",
    "ཁོ་ཚོ་དེའི་ཆེད་དུ་འཛིང་དགོས་པ་རེད་ལ།",
    "གང་ལྟར་ཡང་དེ་ནི་ཁམས་པ་མང་པོ་ཞིག་ལ་བྱེད་འདོད་ཡོད་པ་དེ་ག་རང་རེད།",
    "མཚོན་ཆ་འཕྲོག་རྒྱུའི་ཉེན་བརྡ་བཏང་བ་འདི་ལྟ་བུའི་བོད་མི་ཚོའི་ཧ་ཅང་གི་རྡོག་རྩ་གཅིག་སྒྲིལ་ནི་བྱ་བ་གཞན་པ་གང་ཞིག་གིས་ཀྱང་ཡོང་མེད།",
    "ཡང་དེའི་ཚབ་ལ་ཁོང་ཚོ་ལ་ཨ་རོ་ཞེས་བོས་ཡོད།",
    "གཅིག་བྱས་ན་ནང་པའི་ཐང་ག་དག་གི་ནང་ཡོད་པའི་སྣང་བརྙན་དེ་ཚོས་ལན་གྱི་ཆ་ཤས་ཤིག་བརྒྱབ་ཡོད་ཀྱི་རེད།",
    "དཔེ་མཚོན་གཞན་ཞིག་ནི་གླིང་གེ་སར་རྒྱལ་པོ་རེད།",
    "གླིང་གེ་སར་ནི་རང་གི་གཡུལ་རྟ་ལ་ཆིབས་ནས་གོ་ཆ་ཆ་ཚང་གྱོན་ཏེ་གཡུལ་ངོར་ཆས་པ་ཞིག་རི་མོར་བྲིས་ཡོད་ལ་དེ་ལྟར་དྲན་པར་བྱེད་པ་རེད།",
    "གང་ན་གལ་སྲིད་ཁྱེད་རང་གིས་སྲུང་སྐྱོབ་གྲ་སྒྲིག་བྱས་མེད་ཚེ།",
    "ཇག་པ་རྣམས་ཁྱེད་རང་གི་གྲོང་ཚོ་ཆུང་ཆུང་དེར་འཛུལ་ནས་ཁྱེད་ཀྱི་འཇིག་རྟེན་གྱི་དངོས་པོ་ཡོད་ཚད་འཁྱེར་ཞིང་ཁྱེད་ཀྱི་ནང་མི་དུམ་བུར་གཅོད་པ་དང་།",
    "གལ་སྲིད་གཅིག་གི་སྲོག་བཅད་ན་སྲོག་བརྒྱ་ཕྲག་སྐྱོབ་ཀྱི་ཡོད་ན་དང་།",
    "ཁྱེད་རང་གིས་སྡིག་ལས་བསགས་པ་རེད།",
    "དེ་ག་རེད།",
    "དེ་ནི་ཁྱེད་རང་ལ་འོས་ཤིང་འཚམས་པ་དེ་རེད།",
    "ཁྱེད་རང་གིས་རང་གི་ལས་སྤྱད་ནས་གཞན་ལ་རོགས་པ་བྱས་ཡོད་ན།",
    "ཁྱེད་རང་གི་ཆག་ཡངས་རང་བཞིན་ཅན་གྱི་ཀུན་སློང་གི་སྟོབས་ཀྱིས་མཐའ་མ་དེར་ཁྱེད་རང་གི་བཟང་ཕྱོགས་སུ་བསྐོར་སྲིད་པའི་རེ་བ་བརྒྱབ་ཆོག་གི་རེད།",
    "ཁོང་ཚོ་ཁ་ཟས་ཉུང་ངུ་ཞིག་ལ་བརྟེན་ནས་འཚོ་ཐུབ་ཅིང་།",
    "ཟླ་བ་ནི་དངོས་གནས་མཚོ་ནང་མེད་མོད།",
    "དེ་ནས་ཡང་བསྐྱར་ཟླ་བ་མཚོ་ནང་དུ་ཡོད་པ་རེད།",
    "ཁོང་ཚོས་ང་ཚོ་ལ་མཚོན་ཆ་དང་མདེལ་རྫས་ཀྱི་གོ་མཛོད་ཆེན་པོ་ཡོད་པ་ཤེས་འདུག་ཁོང་ཚོས།",
    "རྒྱུ་དངོས་རྣམས་ད་ནི་གུང་ཁྲན་ལ་བདག་གི་རེད།",
    "བོད་འདི་ད་ནི་རྒྱ་ནག་རེད།",
    "གྲོང་མི་ཚང་མ་མེ་མདའི་འོག་ནས་དེ་ལ་བལྟ་བཅུག་སོང་།",
    "ཁྱེད་རང་ཚོ་ད་དུང་ཡང་དུད་འགྲོ་ནང་བཞིན་འདུག་དེས་ན།",
    "དེ་རིང་ཁྱེད་རང་ཚོས་འདམ་ཁ་བྱེད་དགོས་པ་རེད།",
    "གལ་སྲིད་ཁྱེད་ཁྱེད་རང་ཚོས་ང་ཚོར་དམག་འཁྲུག་རྒྱག་བཅུག་ན།",
    "ཁྱེད་རང་ཚོ་ཤོར་གི་རེད་ལ་དེ་ནི་ལམ་ཁ་ནག་པོ་རེད།",
    "དེ་ལ་ཐག་གཅོད་བྱེད་རྒྱུ་ག་རེ་ཡོད་པ་རེད།",
    "ང་ཚོ་རང་གི་ཁྱིམ་ཚང་ཡིན་ན་ཡང་རང་གི་གང་ཡིན་པ་དང་ད་བར་དུ་རང་བདག་བྱས་པ་གང་ཡིན་པ་དེ་རྩིས་སྤྱོད་བྱེད་ཀྱི་མ་རེད།",
    "གལ་སྲིད་དང་ཐོག་ནས་དེ་ཁྱེད་རང་གི་ཡིན་ན།",
    "ལི་ཐང་ལ་རྟགས་བརྒྱབ་ཚར་པ་རེད།",
    "ཁོང་ཚོ་འབྲུག་སྐད་ཅན་གྱི་ཆར་སྤྲིན་ནག་པོ་ཞིག་ཆགས་རིམ་བཞིན།",
    "འགོར་འགྱངས་འོས་མཚམས་ཤིག་བྱས་པའི་རྗེས་སུ་བཀའ་ཤག་གིས་རྒྱ་མིའི་འདོད་པ་སྐོང་དགོས་བྱུང་པ་རེད།",
    "མི་མང་གི་ཁོང་ཁྲོའི་ངར་སྐད་ཀྱིས་རྣ་འོན་པར་བྱེད།",
    "རྒྱ་མི་ཚོས་རྒྱལ་གཅེས་དཔའ་བོ་འདི་རྣམས་རང་གི་ལག་པར་འཛིན་འདོད་མ་བྱས།",
    "དེ་ནས་བོད་ཀྱི་ས་ཐོག་ནས་རྒྱང་འབུད་གཏོང་རྒྱུ་ཡིན་སྐོར་བཤད།",
    "མི་མང་གིས་དེ་ཚོ་བརྗེད་མེད་ལ་བརྗེད་ཀྱི་མ་རེད།",
    "མི་མང་གི་འབྲེལ་ལམ་གྱི་ཐད་ནས་ན་ཚ་ཕོག་པ་ནི་རྒྱ་མི་གཅིག་པུ་ཡང་མ་རེད།",
    "དེ་ཚོའི་ལག་པར་ཡང་ཁྲག་འགོས་ཡོད་པ་རེད།",
    "དེ་ཚོ་ཡང་མཐའ་མ་དེར་རྒྱ་མིའི་འདོད་པའི་འོག་ཏུ་མགོ་སྒུར་ནས་ལྷ་ས་ཡི་མི་ཡག་ཤོས་རྣམས་དམར་མཆོད་དུ་ཕུལ་བའི་ལྷ་གླང་གསུམ་དང་མཚུངས་པར་རྩིས་འབུལ་བྱེད་མཁན་རེད།",
    "སྟེང་ན་སྡོད་པའི་སྔར་མ་ཚོས་ལན་གཅིག་ལ་ཆུང་ངུ་རེ་བྱས་ཏེ་བོད་འདི་ཕར་སྤྲོད་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "ཆབ་སྲིད་ཀྱི་རྒྱུན་འཛིན་ཐད་རང་གི་ལྟ་ཚུལ་ཇི་ཡོད་བརྗོད་སྐབས་ཀིརྟི་ལྷུན་གྲུབ་ཀྱིས།",
    "རྒྱ་མི་ཚོར་ཁོང་ཁྲོ་བྱེད་པ་ཡང་ལས་སླ་བོ་ཞིག་རེད།",
    "བཀའ་ཤག་དང་སྐུ་དྲག་ཚོ་ཡང་ཡར་པོ་ཏ་ལའི་ནང་ཡོད་པ་རེད་པ།",
    "ང་པོ་ཏ་ལ་བརྒྱུད་ནས་འགྲོ་ཐེངས་རེ་རེ་ལ་ངའི་གྲོད་ཁོག་ལ་ཟུག་རྒྱག་གི་འདུགང་ངོ་ཚ་བྱུང་།",
    "མགོ་ལོག་གི་ས་ཆ་དེ་བོད་རྒྱའི་ས་མཚམས་ལ་འབྲེལ་ཡོད་སྟབས་ཁོང་ཚོ་ནི་མི་འབོར་གནས་སྤོརགྱི་ཉམས་མྱོང་ཐོག་མར་བསགས་མཁན་དུ་གྱུར།",
    "མའོ་ཡིས་རྒྱ་མིའི་ཞིང་པ་སྟོང་ཕྲག་སྐོར་མགོ་ལོག་གི་རྩྭ་ཐང་དཀྱིལ་དུ་གནས་སྤོར་བྱས།",
    "བཅིངས་འགྲོལ་དམག་གིས་ཀྱང་ཚུར་རྒོལ་བྱས།",
    "མགོ་ལོག་པ་ཚོས་འཇིགས་རུང་གི་ཀི་སྒྲ་སྒྲོག་པ་དང་བཅས་ཉིན་གཉིས་ཀྱི་རིང་དགྲ་བོ་དང་གཡུལ་བཀྱེས།",
    "མགོ་ལོག་གི་རྟ་བ་ཉིས་སྟོང་མ་ཟིན་ཙམ་དང་མཉམ་དུ་ས་གནས་དེར་སྡོད་པའི་ཁ་ཆེའི་ཇག་རྒོལ་པ་དང་བཅས་ཐག་ཉེར་ཡོད་པའི་རྒྱ་དམག་གི་དམག་སྒར་ལ་བང་བླངས་ནས་རྒྱུགས།",
    "གྲི་དང་མེ་མདའ་ཐོགས་པ་ཁོང་ཚོས་རྒྱ་ཡི་དམག་སྒར་དེར་ནམ་མ་ལངས་གོང་ཙམ་ལ་ཕར་རྒོལ་བྱས་ཏེ་ཡ་མཚན་པ་བཟོས་ཤིང་།",
    "མགོ་ལོག་གི་ཕྱོགས་ནས་སྲོག་ཤོར་བ་ཉུང་ཉུང་ཡིན་ལ་སྐབས་དེར་ཁོང་ཚོས་མཚོན་ཆའི་རིགས་ཕོན་ཆེ་བླངས།",
    "རྒྱལ་ཁ་དེ་ཅུང་ཟད་ཙམ་གྱི་རིང་ལ་རེད།",
    "རྒྱ་མི་དེ་ལས་ཀྱང་འབོར་ཆེ་བ་ཞིག་སླེབས་ཏེ་མགོ་ལོག་གི་ཕྱུགས་ཟོག་བརྐུས།",
    "བརྒྱུད་རིམ་འདིའི་ནང་མགོ་ལོག་པ་ཕོ་མོ་དང་བྱིས་པ་བཅས་སྟོང་ཕྲག་ཁ་ཤས་དམར་གསོད་བཏང་།",
    "རང་གི་ཁྱིམ་མི་དང་ཁྱིམ་ཚང་།",
    "མི་ཚེའི་འགྲོ་སྟངས་བཅས་ཚང་མ་ཤོར་བའི་མྱ་ངན་གྱིས་ཁེངས་པའི་མགོ་ལོག་པ་ཚོས་རྒྱ་མི་དུས་ཚོད་ཅི་ཙམ་འགོར་ན་ཡང་ཁོང་ཚོའི་མཐའ་མ་ལ་མ་ཐུག་གི་བར་དུ།",
    "འཛམ་གླིང་ཕྱི་ལོགས་ལ་ཆ་བཞག་ན་ཁོང་ཚོས་མགོ་ལོག་གི་གྱེན་ལོག་སྐོར་ཤེས་རྒྱུ་ལ་ལོ་མང་པོ་འགོར་གྱི་རེད།",
    "ཁམས་ཀྱི་ལྷོ་མཐའ་ན་ཡང་གནས་སྟངས་རྣམས་གོང་མཚུངས་ཀྱིས་དྲག་རྩུབ་ཅིག་རེད།",
    "བཅིངས་འགྲོལ་དམག་གིས་བསྐོར་བའི་རྒྱ་མིའི་ལས་བྱེད་ཚོ་ཆ་ཕྲེང་ལ་ཡོང་ནས་དོན་དེ་བཙན་ཤེད་ཀྱིས་བྱེད་འཇུག་སྐབས་ཁམས་པ་ཚོས་ཕར་རྒོལ་བྱས་ཏེ་མི་གཅིག་ལ་ཐུག་གི་བར་དུ་བསད་པ་རེད།",
    "བཅིངས་འགྲོལ་དམག་གིས་དེའི་སྐྱིན་ཚབ་ལེན་ཆེད་དམག་དཔུང་ཆེས་འབོར་ཆེན་འཁྲིད་ཡོང་བ་དང་།",
    "ཁ་ཤས་ནི་དེར་སྐྱབས་བཅོལ་ལ་ཡོང་བ་རེད་ལ།",
    "བོད་མི་ཚོས་དེ་མ་ཉན་པ་རེད།",
    "རྒྱ་མི་ཚོར་གནམ་གཡུགས་འབོམ་ཡོད་པ་རེད།",
    "དེ་ཏན་ཏན་རེད།",
    "གང་ཡིན་ཟེར་ན་རྒྱ་མི་ཚོས་གལ་སྲིད་ས་ཐོག་ནས་ཕར་རྒོལ་བྱས་པ་ཡིན་ན་ཁོང་ཚོར་ཤི་རྨས་ཚབས་ཆེ་ལྷགས་ཀྱི་ཡོད་པ་ཤེས་ཡོད།",
    "འབོམ་གཡུགས་ནས་བསམ་གཏན་གླིང་ལེབ་ལེབ་བཟོས་སོང་།",
    "བྱིས་པ་ཆེས་མང་པོ་ཞིག་བསད་པ་རེད།",
    "ངའི་བསམ་ཚུལ་ལ་མི་ག་ཚོད་ཅིག་བསད་ཡོད་པ་སུ་གཅིག་གིས་ཀྱང་ཤེས་ཀྱི་མ་རེད།",
    "ཡིན་ན་ཡང་མ་མཐའ་ལ་ཡང་སྟོང་ཕྲག་གཅིག་དང་གཉིས་བསད་ཡོད་པ་རེད།",
    "ངའི་ཕ་དང་ཨ་ཞང་གཉིས་ནི་དཀའ་རྙོག་བཟོ་མཁན་གྱི་གཏེ་བོ་དེ་གཉིས་ཆགས་ཡོད་པ་རེད།",
    "རྒྱ་མིས་ཁོ་གཉིས་ཆ་བཟུང་བ་རེད།",
    "ང་ཚོའི་ཁྱིམ་གྱི་རྒྱུ་དངོས་དང་ས་ཞིང་ཡོད་ཚད་གཞུང་བཞེས་བཏང་པ་རེད།",
    "ངའི་ཨ་མ་དང་སྤུན་ཆུང་བ་རྣམས།",
    "སྲིང་མོ་བཅས་སྤྲང་པོ་བཞིན་སྲང་ལམ་དུ་གཡུགས་པ་རེད།",
    "དེ་ནས་གནམ་འབོམ་གྱིས་གང་ལྟར་གཏོར་སྐྱོན་མ་བྱས་པར་ལུས་པའི་མཛོད་ཁང་ཆེན་པོ་ཞིག་ཡོད་པ་དེའི་ནང་བཅུག་པ་རེད།",
    "བླ་སྤྲུལ་དང་བཅས་པའི་ཆ་ཕྲེང་གི་མི་བརྒྱ་ཕྲག་བརྒལ་བ་དེའི་ནང་བཅུག་ཡོད་པ་རེད།",
    "གནས་སྟངས་ཧ་ཅང་སྐྱོ་པོ་རེད།",
    "སྒེའུ་ཁུང་ཡོད་པ་མ་རེད།",
    "ཁོ་ཚོར་དུས་རྒྱུན་ནས་གཅར་རྡུང་བྱས་ཡོད་པ་རེད།",
    "མང་པོའི་རུས་པ་བཅག་ཡོད་པ་རེད་ལ་གཟུགས་པོའི་ནང་དུ་རྨས་སྐྱོན་བཟོས་ཡོད་པ་རེད།",
    "ཁོ་ལ་ཉིན་བརྒྱད་ཀྱི་རིང་ཟས་སྤྱད་ཡོད་པ་མ་རེད།",
    "དེ་འདྲའི་གནས་སྟངས་འོག་ཁོང་ལོ་གཅིག་དང་ཕྱེད་ཀ་ལ་བཙོན་འཇུག་བྱས་པ་རེད།",
    "ནམ་རྒྱུན་ནས་མུ་གེ་ཕྱེད་ཀ་ཙམ་མྱོང་གི་ཡོད།",
    "དེར་ཁོ་རང་ལམ་བཟོ་རུ་ཁག་ཅིག་ཏུ་ངལ་རྩོལ་བསྒྱུར་བཀོད་བྱས་པ་རེད།",
    "ཁོང་ལམ་བཟོ་རུ་ཁག་དེར་ལོ་གསུམ་བར་དུ་འཚོ་ཐུབ་ཡོད་ཅིང་དེ་ནས་ཐང་ཆད་དྲགས་ནས་གྲོངས་པ་རེད།",
    "ངའི་ནང་མི་གཞན་པ་རྣམས་ཆ་ཕྲེང་གི་ས་ཆ་ནས་ཐོན་མི་ཆོག་པའི་བཀག་རྒྱ་བྱས་ཤིང་ངལ་རྩོལ་རྩུབ་པོ་ལ་བཙན་བཀོལ་བྱས་པ་རེད།",
    "འཐབ་འཛིང་ནི་ཧ་ཅང་གི་ཐབས་སྡུག་ཅིག་སྟེ་རྒྱ་མིས་ང་ཚོ་ལ་བྱས་ཚད་ཀྱི་ནང་ནས་སྡུག་ཤོས་དེ་རེད།",
    "ཁོང་ཚོ་སྟེགས་བུའི་སྟེང་མ་བཞག་གོང་ནས་གཅར་རྡུང་བྱས་ཡོད་པ་རེད་ལ།",
    "ཁོང་ཚོས་མགོ་སྒུར་ནས་འདུག་དགོས་པ་རེད་ལ་དེས་ཁོང་ཚོ་ནི་ངོ་ཚ་ཆེན་པོ་ཡོད་པ་མཐོང་གི་རེད།",
    "གལ་སྲིད་ཁོང་ཚོས་ཡར་བལྟས་པ་ཡིན་ན་ཁོང་ཚོའི་མགོའི་ཟུར་གཅིག་ལ་མེ་མདའི་ཡུ་བས་གཞུ་གི་རེད།",
    "ཁོང་ཚོའི་སྐེ་ལ་བྱང་བུ་ཞིག་བཏགས་ཡོད་པ་དེའི་ཐོག་མི་མང་གི་དགྲ་བོ་ཞེས་བཀོད་ཡོད་པ་རེད།",
    "གལ་སྲིད་མི་གཅིག་གིས་སྡིགས་དམོད་མ་བྱས་ན།",
    "ཁོ་རང་སྟེགས་བུའི་སྟེང་ཡོང་མཁན་རྗེས་མ་དེ་རེད།",
    "བོད་མི་ཚོ་ཕན་ཚུན་གཅིག་གིས་གཅིག་ལ་སྡིགས་དམོད་བྱེད་པ་དང་གསང་ཉུལ་བྱེད་པའི་སྐུལ་མ་བཏང་བ་རེད།",
    "མི་ཚང་མ་རང་གི་གྲོང་པ་ཁྱིམ་མཚེས་ཀྱི་དགྲ་ཟླ་བཟོས་པ་རེད།",
    "མི་གཅིག་གིས་ཀྱང་གཞན་པ་སུ་གཅིག་ལའང་ཡིད་ཆེས་བྱེད་མི་ཐུབ་པ་རེད།",
    "དམར་གསོད་གཏོང་བ་དེ་འདྲ་ཧ་ཅང་མང་པོ་ཡོད་པ་རེད།",
    "ངའི་སྤུན་རྒན་པ་གཅིག་སྟེགས་བུའི་སྟེང་བཞག་ནས་ཤི་ཤི་བར་དུ་གཅར་རྡུང་བཏང་བ་རེད།",
    "ཉག་རོང་ནི་དུད་ནག་ཚོང་པ་ཨ་བརྟན་གྱི་ཕ་ཡུལ་རེད།",
    "དེ་ནས་ཁོ་ཚོས་འཐབ་འཛིང་བཙུགས་པ་རེད།",
    "དམའ་འབེབས་བྱེད་པ་བཅས་བྱས་ཤིང་མཚམས་རེར་སྲོག་ཐོག་བཏང་བ་རེད།",
    "རྒྱ་མིའི་དམག་མི་རྣམས་ཁོའི་ཁྱིམ་དུ་སོང་ནས་ཁོའི་ཨ་མ་དང་ཆུང་མ།",
    "ཁོང་ཁྲོ་འབར་བའི་བུད་མེད་ལོ་གཞོན་མིང་ལ་རྡོ་རྗེ་གཡུ་སྒྲོན་ཟེར་བ་ཞིག་ཡོད་ལ།",
    "མོས་ཁོང་ཚོའི་ནང་མི་རྣམས་དམར་བསད་བཏང་བ་ཤེས་པ་དང་།",
    "ཉག་རོང་གི་ཁྱིམ་ཚང་ཉེས་མེད་རྣམས་ཀྱི་ཆེད་དུ་མོས་ཕར་རྒོལ་བྱེད་རྒྱུའི་མནའ་ཚིག་བོར་བ་རེད།",
    "དེ་ནས་མོས་དེ་ཚོར་མེ་མདའ་རྣམས་གྲ་སྒྲིག་བྱེད་དགོས་ཞེས་བཀའ་བཏང་བ་རེད།",
    "མོས་བོད་ཤར་ཕྱོགས་གང་སར་ཡི་གེ་བཏང་ནས་རྒྱ་མི་ལ་གདོང་ལེན་བྱེད་ཆེད་ལངས་དགོས་པའི་རེ་སྐུལ་བྱས་པ་རེད།",
    "མོས་ཁྱོ་གའི་ཕྱུ་པ་གོན་ཏེ་ལག་མདའ་ཞིག་འཁུར་ནས་དགྲ་བོ་དང་གཡུལ་འགྱེད་ཆེད་རང་གི་དཔའ་རྟུལ་ཚོའི་མདུན་བླངས་ནས་རྒྱུགས་པ་རེད།",
    "ཤུལ་ལུས་ཀྱི་རྒྱ་དམག་དང་ལས་བྱེད་རྣམས་འབྲུག་མོའི་མཁར་དུ་སོང་ནས་མུ་མཐུད་བསྡད།",
    "ཡིན་ན་ཡང་མཁར་དེའི་རྩིག་གྱང་མཐོན་པོ་རྣམས་ནི་དེ་འདྲའི་ཚུར་རྒོལ་འགོག་ནུས་པ་ཞིག་རེད་འདུག་མེ་སྒྱོགས་ངོ་རྒོལ་པ་ཚོར་དེ་འདྲ་མེད།",
    "མེད་པའི་རྐྱེན་གྱིས་ནང་དུ་འཛུལ་དཀའ་བ་ཞིག་རེད།",
    "ཟླ་བ་གཅིག་གི་རྗེས་སུ་དཀར་མཛེས་ནས་དམག་ཨང་བཅོ་བརྒྱད་པའི་དམག་མི་བརྒྱད་བརྒྱ་མཁར་གྱི་ནང་བཅུག་པའི་དཀའ་ངལ་འོག་གི་རང་གི་བློ་མཐུན་རྣམས་གློད་རྒྱུའི་ཆེད་ཡོང་བ་རེད།",
    "རྡོ་རྗེ་གཡུ་སྒྲོན་ཉག་རོང་སྟོད་དུ་ཁོ་ཚོ་དང་ཐུག་ནས་ཕམ་པར་རྒྱག་ཐུབ་པ་བྱུང་བ་རེད།",
    "རྒྱ་དམག་བཞི་བརྒྱ་ཙམ་བསད་པ་རེད།",
    "ཡིན་ན་ཡང་ཉིས་བརྒྱ་ཙམ་གྱིས་མཐའ་སྐོར་བའི་མཚམས་གཤགས་ནས་མཁར་གྱི་ནང་འཛུལ་ཐུབ་པ་བྱུང་བ་རེད།",
    "རྡོ་རྗེ་གཡུ་སྒྲོན་པར་འགྲོ་དགོས་པ་བཟོས་ཤིང་མཐའ་སྐོར་བ་ལས་གྲོལ་བ་རེད།",
    "ཡིན་ན་ཡང་འཁྲུག་འཛིང་བྱེད་པ་དེ་ཇེ་ཆེར་སོང་ནས་ཟླ་གཅིག་ཙམ་གྱི་ཡུན་འགོར་བ་རེད།",
    "དེའི་རྗེས་ནས་རྒྱ་མིའི་གྲངས་འབོར་དང་མཚོན་ཆ་སྤུས་ལེགས་དེ་ཚོས་རྒྱལ་ཁ་ལེན་པའི་མགོ་བཙུགས་པ་རེད།",
    "རྒྱ་མི་ཚོ་ལ་ཤི་རྨས་ཆེན་པོ་བྱུང་ཡོད་དེ་ཉིས་སྟོང་ཙམ་བསད་ཅིང་ཆེས་མང་པོ་ཞིག་རྨས་ཡོད་པ་རེད།",
    "དཔོན་རིགས་ཉིས་བརྒྱ་ཙམ་བསད་ཡོད་པ་རེད།",
    "མཁར་རྙིང་གི་ཕྱི་རོལ་དེར་མཛད་སྒོ་རྒྱ་ཆེ་བ་དང་ཁོ་ཚོའི་རོ་རྣམས་དུར་འཇུག་བྱས་པ་རེད།",
    "ངོ་རྒོལ་པ་ཚོ་རི་ལ་སོང་ནས་མུ་མཐུད་ནས་ཇག་རྒོལ་རྒྱ་ཆེར་བྱེད་པའི་མགོ་བཙུགས་པ་རེད།",
    "ཉིན་མ་རེ་རེ་བཞིན་ཁོང་ཚོའི་གྲངས་འབོར་ནི་ཇེ་ཆེར་སོང་བ་རེད།",
    "དེ་འདྲ་ལ་ནུབ་ཕྱོགས་པ་ཚོས་རྔན་པའི་རྔོན་པ་ཞེས་བརྗོད་ཀྱི་རེད།",
    "ཁམས་པ་ཚོ་མཁར་གྱི་ནང་དུ་བཅུག་ཟིན་པའི་མཚམས་དེ་ལ་བཅིངས་འགྲོལ་དམག་ལྔ་བརྒྱ་ཐམ་པས་རི་དེའི་མཐའ་བསྐོར་བ་རེད།",
    "བདུན་ཕྲག་གཉིས་ཀྱི་རིང་ལ་བོད་མི་ཚོ་བཙོན་པ་བྱས་པ་རེད།",
    "ཉིན་ལྟར་ཁོང་ཚོ་ལ་དམའ་འབེབས་དང་སྡིགས་དམོད་བྱས་ཤིང་ཉེན་བརྡ་བཏང་པ་རེད།",
    "ཁོང་ཚོས་མའོ་ཡི་རྨི་ལམ་དེ་ཁས་ལེན་མ་བྱས་པ་རེད།",
    "ཉིན་གསུམ་གྱི་རྗེས་སུ་བཙོན་པ་ཚོས་མཁར་གྱི་སྐོར་སྲུང་བ་ཚོས་ལྟ་རྟོག་བྱེད་ཀྱིན་མེད་པ་དེ་ཤེས་པ་རེད།",
    "དེའི་མཚན་མོ་དེ་ག་རང་ལ་ཁོང་ཚོ་ཐག་ཉེའི་རི་རྒྱུད་ཁག་ཏུ་བྲོས་པ་རེད།",
    "ཁོང་གིས་ལོ་མང་རིང་གུང་ཁྲན་ལ་མི་དགའ་བ་མངོན་སུམ་འཛེམས་མེད་ཀྱིས་གནང་བ་རེད།",
    "སྐྱ་སེར་གཉིས་ཀ་གཅིག་མཚུངས་ཀྱིས་ད་ནི་ཐབས་ཤེས་བཙལ་ཏེ་འཛིང་རྒྱུའི་དུས་ཚོད་ཡིན་པའི་ཐག་གཅོད་བྱས་པ་རེད།",
    "ང་ཚོ་ལ་ཤོར་རྒྱུ་གང་ཡང་མེད་ལ་གཅིག་བྱས་ན་ང་ཚོ་འཛིང་ན་ཐོབ་རྒྱུའི་གོ་སྐབས་ཆུང་ཆུང་གཅིག་ཡོད་རེད།",
    "དེ་ནི་ང་ཚོས་མ་འཛིང་པར་བཞག་ན་ང་ཚོ་གསོད་ཀྱི་ཡིན་པའམ་ཡང་ན་གཡོག་པོ་ཆགས་ཀྱི་ཡིན་པ་དེ་རེད།",
    "གྲོང་གི་ནང་དུ་བང་ཆེན་ཞིག་སླེབས་ནས་བཅིངས་འགྲོལ་དམག་ཕོན་ཆེ་བ་ཞིག་ལི་ཐང་གི་ཕྱོགས་སུ་ཡོང་གི་ཡོད་པ་དང་།",
    "མི་ཚང་མ་བྲེལ་ཟིང་བྱས་ནས་སྦས་ཡིབ་བྱས་པའི་རང་རང་གི་མཚོན་ཆ་རྣམས་བླངས།",
    "མི་ཚང་ཕྱུག་པོ་དཔེར་ན་མགོན་པོ་བཀྲ་ཤིས་ཀྱི་མི་ཚང་ལྟ་བུ་ལ་ཆ་བཞག་ན་ཁོང་ཚོའི་སྒེར་གྱི་གོ་མཚོན་ཁང་ཡོད་པ་རེད།",
    "ང་ཚོའི་ས་གནས་ཀྱི་དཔོན་རིགས་གཡོན་རུ་དཔོན་གྱིས་ང་ཚོ་ལ་རོགས་པ་བྱེད་ཆེད་འབྲོག་པ་མང་པོ་བསྡུས་འདུག་གཡོན་རུ་དཔོན་ནི་ངའི་གྲོགས་པོ་ཞིག་ཡིན།",
    "ཁོ་ནི་གཞོན་གཞོན་ལོ་ན་ཉི་ཤུ་རྩ་ལྔ་ཙམ་རེད།",
    "ཁམས་པའི་རྩིས་ཀྱིས་དེ་ཙམ་ཆེན་པོ་མ་རེད།",
    "དུས་ཚོད་དེ་ཙམ་ཞིག་ལ་ཁོང་དང་ཁོང་གི་དམག་མི་རྣམས་ཀྱིས་རྒྱ་མིའི་དམག་སྒར་བཅོམ་པ་དང་བཅིངས་འགྲོལ་དམག་ཉུང་ཁག་ལ་ཕར་རྒོལ་བྱེད་པ་སོགས་ཀྱི་འཇབ་རྒོལ་མང་པོ་ལ་ཞུགས་ཚར་འདུག་ཅིང་།",
    "གཡོན་རུ་དཔོན་གྱིས་ཁོའི་དམག་མི་འཁྲིད་ནས་ལི་ཐང་ལ་ཡོང་རྒྱུའི་ཆེད་དུ་དེའི་ཁར་འབྲོག་པ་སྟོང་ཕྲག་བརྒལ་བ་བསྡུས་པ་རེད་ལ།",
    "དེ་ནི་ང་ཚོ་ལ་ངེས་པར་མཁོ་བ་ཞིག་རེད།",
    "བཅིངས་འགྲོལ་དམག་གིས་འདིས་སྐོར་གོ་ནས་ཁོ་ལི་ཐང་ལ་སླར་མ་ཡོང་གོང་ལ་གསོད་རྒྱུའི་ཐག་གཅོད་བྱས་པ་རེད།"
  ]
}