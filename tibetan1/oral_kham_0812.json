    "དེ་བཞིན་བགྲོད་མིན་འགྲོ་བ་དང་།",
    "ཆུ་ཀུན་ཐ་མལ་འདུག་ལས་རབ་ཏུ་གཡོས།",
    "འདི་ལྟར་གདའ་བ་རྒྱ་མཚོ་གང་ཞིག་ལགས།",
    "དེ་ལྟར་གདའ་བའི་རྒྱ་མཚོ་འདི་གང་ལགས།",
    "རྒྱ་མཚོའི་ནང་དུ་འདུག་པའི་གྲུ་མཛེས་པ།",
    "མདུན་གྱི་ནམ་མཁའ་ལ་བྱུང་སྟེ་འདུག་པར་གྱུར་ཏོ།",
    "བཙོང་རྒྱུ་དེ་ནི་བུམ་པ་འདི་ན་འདུག།",
    "དེ་རྨོད་པའི་ལུས་བཞིན་བུམ་པ་འདི་ན་འདུག།",
    "ཆ་དང་པོའི་གནས་ན་པད་མའི་རྩ་བ་ནི་མེད་པད་མའི་ལོ་མ་ནི་རྒྱན་འཁྲུགས་ཤིང་འདུག་པ་མཐོང་ནས།",
    "འདུག་ཅིང་ལངས་དང་འགྲོ་བའི་རི་དྭགས་འགའ་ཞིག་ཏུ།",
    "འདུག་ཅིང་སོ་སོར་བོ་དོང་པཎ་ཆེན་གྱི་གསུང་འབུམ་ལས།",
    "ཅུང་ཟད་གང་ནས་ཀྱང་མྱང་ཞིང་བདག་ཉིད་ཆོག་ཤེས་པ་ལ་ཞུགས་ཤིང་འདུག་གོ།",
    "དེ་བཞིན་སྐྱེ་བོ་འདི་ཡང་རང་ཉིད་བྱས་པའི་ལས།",
    "རྒྱན་བཟང་པོ་དགའ་དགའ་ལྟར་འདུག་པ་ལ་ལྟར་འགྲོ་བས་ཕས་ཀྱང་གནང་སྟེ།",
    "གཤིན་རྗེའི་དགྲ་ནི་གཅིག་པུ་འདུག་ཀྱང་ཡོང་མི་ཐུབ།",
    "ཁམས་དང་རང་བཞིན་མཁྱེན་ནས་དེས།",
    "མ་མའི་པང་པ་ན་འདུག་པར་གྱུར་པ་ལས་ཁྱེའུ་དེས་དགེ་སློང་རྒྱང་རིང་པོ་ནས་ཉི་མ་ཤར་བ་ལྟར་འོང་བ་མཐོང་ངོ།",
    "སྤྱན་སྔར་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་སྟེ།",
    "བྲམ་ཟེ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "གཞོན་ནུ་འཇིགས་ཤིང་འདུག་པའི་ཚེ།",
    "དེ་དག་རང་རང་རྒྱལ་སྲིད་སྐྱོང་།",
    "སྙིམ་པའི་པད་མ་སྦྱར་ཏེ་འདུག།",
    "དེ་ན་འདུག་ནས་བསམ་གཏན་བཞི་དང་།",
    "དབེན་ཞིང་ཡིད་དུ་འོང་བའི་གནས་སོ་སོར་འདུག་པ་ལ།",
    "བར་བར་ཏེ་བཀྲེས་ཏེ་ཟར་འགྲོ་བའི་ལམ་བཀག་སྟེ་འདུག་གོ།",
    "མཆེ་བའི་བར་ན་འདུག་པའི་ཤ་ཡང་འཕྲོག་ནུས་ན།",
    "ནགས་ཚལ་སྟུག་པོ་དེ་ན་གནས་བཅས་ཤིང་འདུག་འདུག་པ་ལས།",
    "སེང་གེའི་ཁྲིའི་སྟེང་ན་འདུག་ཅིང་།",
    "དེ་ནས་མི་དེས་རི་དྭགས་རུ་རུ་དེ་བག་ཕབ་ཅིང་འདུག་པ་མཐོང་ནས་རྒྱལ་པོ་ལ་བསྟན་པ།",
    "དེ་གཉིས་ཀྱི་བར་དུ་འདུག་སྟེ།",
    "དེ་ཉིད་སྐྱེངས་བཞིན་ཅན་དུ་འདུག་པ་མཐོང་།",
    "དེ་དང་ལྷན་ཅིག་ཏུ་འདུག་པ་རིགས་སོ།",
    "ཕྱག་དར་ཁྲོད་ཀྱི་ཚེམ་བུ་དྲུབ་ཅིང་འདུག་གོ།",
    "དེ་དང་ཉེ་བའི་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "དེ་བཞིན་དུ་སེམས་འཁྲུལ་པ་མེད་ཅིང་རབ་ཏུ་ཕྱག་དར་ཁྲོད་ཀྱི་ཚེམ་བུ་འདྲུབ་ཅིང་འདུག་གོ།",
    "མཐུ་མེད་ཞུམ་ནས་རབ་ཏུ་ཞི་བར་འདུག།",
    "མིའི་བདག་པོ་ནི་སེང་གེའི་ཁྲི་ལ་འདུག་པར་ལགས་སོ།",
    "འདི་ལ་འདུག་གམ་ཉལ་ན།",
    "ཅུང་ཞིག་མགོ་སྨད་དེ་འདུག་གོ།",
    "མཁས་པ་རྣམས་ཀྱང་རང་དགར་ཅི་བདེར་སྤྱོད་པར་རིགས།",
    "རིང་པོ་ནས་དོར་བའི་དམག་ཚོགས་ལ་སྡོད་ཅིང་འདུག་གོ།",
    "གླང་པོའི་ཕྲུ་གུ་འདུག་པའི་ཚོང་པའི་ཚོགས་ནི་མཐོང་བར་གྱུར།",
    "ལྷ་ལགས་བདག་ཅག་ནི་བྱང་ཕྱོགས་ནས་འོངས་ཞེས་བྱ་བ་སྨྲ་ཞིང་འདུག་གོ།",
    "དེ་ནས་བྱང་ཕྱོགས་ཀྱི་གཏམ་སྐབས་སུ་བབ་པ་ལ་ཚོང་པ་རྣམས་ཀྱི་བདག་པོ་རྡོ་རྗེ་དབྱིག་པ་ཅན་ཞེས་བྱ་བའི་རྒལ་པོ་ལ་ཆེ་བའི་བདག་ཉིད་བརྗོད་ཅིང་འདུག་གོ།",
    "མཆེ་གཉིས་པའི་དཔུང་པར་གླང་པོ་སྐྱོང་བ་འདུག་པ་ལ།",
    "ཡུད་ཙམ་ཡུད་ཙམ་དུ་ལུས་ནི་སྐྱེད་ཅིང་འདུག།",
    "ཁྲོས་བྱས་འདུག་སྟེ་སྐདཅིག་ཙམ་གྱིས་གཡོ་མེད་མིག་ཅན་ནི།",
    "ཇི་ལྟར་བུང་བ་མི་སྨྲ་བར་ནི་འདུག་པར་འགྱུར།",
    "དེ་ལྟར་བྱའོ་ཞེས་ཟླ་བས་ཀྱང་ཁས་བླངས་པ་ལ་དང་པོའི་ཟླ་བའི་མིང་དེ་རྣམས་ཀྱིས་འབྲི་ཞིང་འདུག་གོ།",
    "འདི་ཐམས་ཅད་ཁྱེད་ལ་རྣམ་པར་འཇིག་པའི་ཕྱིར་འདུག་པའི་བདག་ཉིད་ཅན་གྱི་དུམ་བུ་འཛིན་པའི་གཡོ་བའི་རྣམ་པར་སྤྱོད་པ་སྟེ།",
    "མདའ་མདེའུ་རྣོན་པོ་ཅན་ཕྱུང་ནས་བདག་ཉིད་ཆེན་པོ་གང་ན་འདུག་པ་དེའི་ལོགས་སུ།",
    "རྟ་དེ་ཞོན་པ་མེད་པར་གྲོག་པོའི་ཁ་ན་འདུག་པ་མཐོང་ངོ།",
    "རྟ་བཞག་སྟེ་ངལ་གསོ་ཞིང་འདུག་པའི་གནས་ཀྱང་མེད།",
    "གཡང་ས་ནས་ལྷུང་སྟེ་སྣད་པའི་ཚོར་བ་མྱོང་བ་ནི་སེམས་ལ་ཁྱབ་པར་གྱུར་ཏེ་འགྲེ་ཞིང་འདུག་པ་མཐོང་ངོ།",
    "གྲོག་པོའི་ནང་ན་འདུག་པ་ཡི།",
    "འབབ་ཆུའི་འགྲམ་ཞིག་ན་ཡང་འདུག་པ་གོར་མ་ཆག་གོ།",
    "ལུས་སྣད་ལ་ཡུན་རིང་དུ་ཟམ་པ་བྱེད་ཅིང་འདུག་འདུག་པས་དུབ་པའི་བོ་དོང་པཎ་ཆེན་གྱི་གསུང་འབུམ་ལས།",
    "ངོ་མཚར་བའི་ཡིད་ཅན་བདག་ཉིད་ཆེན་པོ་དེ་དང་ཉེ་བར་འདུག་པར་གྱུར་ཏོ།",
    "དེ་ནས་རྒྱལ་པོ་དེ་གུས་པ་དང་བཅས་པས་ཉེ་བར་འདུག་སྟེ་བདེ་འམ་ཞེས་དྲིས་ཏེ།",
    "བར་སྣང་ལ་ནི་འདུག་ནས་སུ།",
    "རལ་པའི་ཚོགས་རྣམ་པར་བཅིངས་པའི་ཅོད་པན་ཅན་གྱི་མགོ་བོ་ལ་འདུག་ནས་ཅུང་ཟད་དམའ་བའི་ཚང་བརྩམས་པར་བྱས་ཏེ།",
    "རྒྱན་བཟང་པོ་དགའ་དགའ་ལྟར་འདུག་པ་ལ་འགྲོ་བར་ཕས་ཀྱང་གནང་སྟེ།",
    "དགའ་དགའ་ལྟར་འདུག་པ་དང་མི་མང་པོ་སྣ་ཚོགས་ཆས་པ་འདུས་པ་རྣམས་ལ་ཡང་སེམས་ལ་ཆགས་པར་སླར་ལོག་སྟེ།",
    "ནགས་དང་ཁྱིམ་ན་འདུག་ཀྱང་འཆི་བདག་འོང་འགྱུར་ལ།",
    "འོན་ཏེ་འདི་སྐད་ཅེས་ས་ཆེན་པོ་ནི་ཡངས་ལ་ཕྱི་ཤིང་རྟའི་དབྱིབས་ལྟར་དུ་འདུག་པ་འདི།",
    "ས་ཆེན་པོ་ནང་ཡངས་ལ་ཕྱི་ཤིང་རྟ་ལྟར་འདུག་པ་འདི་ལ་བདུན་དུ་འགོད་ཤེས་པ་སུ་ཞིག་ཡོད།",
