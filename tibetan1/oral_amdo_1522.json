    "ངེད་རྣམས་རྩོམ་སྒྲིག་གི་བྱ་བར་ལས་དང་པོ་བ་ཡིན་པ་དང་།",
    "ལྷག་པར་ང་ཚོའི་ལས་དོན་གང་ཅིའི་ཐད་ལྷག་བསམ་རྣམ་དག་གིས་སློབ་སྟོན་དང་།",
    "ཞུ་དག་གི་རོགས་ཕན་གནང་མཁན་གྱི་གཞིས་བྱེས་སྤྱི་སྒེར་རྣམས་དང་།",
    "རྩ་གསུམ་ཞལ་གཟིགས་དག་སྣང་ཉེར་ལྔའི་བདག།",
    "སྙན་ངག་གི་མཚན་ཚངས་སྲས་བཞད་པའི་རྡོ་རྗེ།",
    "གང་གི་སྤྲུལ་གཞི་འཕགས་མཆོག་སྤྱན་རས་གཟིགས་ཀྱི་ཆེ་བའི་ཡོན་ཏན་དང་།",
    "དཔལ་ཕག་མོ་གྲུ་པའི་བློན་པོའི་གདུང་རྒྱུད་དུ་ཡབ་བདུད་འདུལ་རབ་བརྟན་དང་།",
    "དགུང་ལོ་བཅོ་ལྔ་བཞེས་པ་ལྕགས་ལུག་སྤྱི་ལོ་༡༦༣༡ ལོར་དུས་ཟིང་གི་རྐྱེན་པས་ཡར་ལུང་དང་།",
    "བསྙེན་རྫོགས་བཞེས་ནས་ལོ་གྲངས་ལྔ་སོང་བ་ནས་སྐུ་ཚེ་མ་རྫོགས་བར་བསྒྲུབ་བྱ་སྟོང་ཕྲག་མང་པོར་དགེ་ཚུལ་སློང་གི་སྡོམ་པ་སྩལ་ཅིང་།",
    "དགུང་ལོ་ཉེར་བདུན་བཞེས་པ་ཆུ་ལུག་སྤྱི་ལོ་༡༦༤༣ ལོར་དེབ་ཐེར་དཔྱིད་ཀྱི་རྒྱལ་མོའི་གླུ་དབྱངས་མཛད་པ་དང་།",
    "དགུང་ལོ་བཞི་བཅུར་ཕེབས་པ་མེ་སྤྲེལ་སྤྱི་ལོ་༡༦༥༦ ལོར་རྩིས་དཀར་ནག་གི་དྲིས་ལན་མཛད།",
    "རྣམ་རྒྱལ་གྲྭ་ཚང་གི་གཉེར་པ་བློ་བཟང་སྦྱིན་པ།",
    "བོད་གཞུང་གི་ལས་དོན་གལ་ཆེའི་རིགས་དགོངས་སྐོར་ཞུ་རྒྱུ་ཙམ་ལས།",
    "སྐུ་བཅར་རྣམ་རྒྱལ་གྲྭ་ཚང་གི་འཆམ་དབྱངས་རྩ་ཚིག་གསར་རྩོམ་མཛད།",
    "བསྒྲུབ་བྱ་ཁྲི་ཕྲག་མང་པོར་དགེ་ཚུལ་སློང་གི་སྡོམ་པ་སྩལ་བ་དང་།",
    "གྲྭ་ཚང་གི་འདོན་ཆ།",
    "༢ན་ཨེཀཔཪྻངྐམཱཤྭཀྱབྲྀཀྵེཙཔྲྀཥྤཱཤྲཡོབཱརནིརྨཱམཡོཔདྷྱཡ་སྐྱིལ་ཀྲུང་གཅིག་གིས་མྱ་ངན་མེད་ལྗོན་ལ།",
    "རྒྱབ་བརྟེན་མཆོག་གི་སྤྲུལ་པའི་སྒྱུ་མ་མཁན།",
    "དྲན་པས་སྲིད་ཞིའི་གདུང་སེལ་མཛའ་ན་མོ།",
    "སྐྱོན་གྱི་རྙོག་མའི་རྡུལ་ཆ་ཕྲ་མོས་ཀྱང་།",
    "རྫོགས་པ་ཁྱོད་ཉིད་གཅིག་པུའི་ངང་ཚུལ་ཙམ།",
    "ཟད་མིན་དེ་ཕྱིར་ཚངས་པ་ཐལ་སྦྱར་ནས།",
    "ཡིད་སྲུབས་ཕྱོགས་ཀྱི་དམོད་པས་ལུང་རྟོགས་ཟླ།",
    "སྲོག་གི་འཚོ་བ་དོན་དང་ལྡན་གྱུར་ཅིག།",
    "གོམ་པའི་རི་མོ་རྒྱལ་ཕྲན་བྱེ་བའི་མགོར།",
    "ཀུན་ཚང་ཚོང་འདུས་དར་བ་རྣམ་ཐོས་བུའི།",
    "རཱགབིནྡུརྦྷབཱསྠིཏྱཤཾསུཁྱརཱསཱདཡགཱརྠིཔྲཱརྠབུདྷེཪྶབྷཾ།",
    "རྒྱུ་དེས་མཐོ་རིས་དགའ་ཚལ་ལྟ་ཞོག་གི།",
    "མགོན་ཁྱོད་དྲིན་ལས་གཞན་དུ་གང་གིས་བྱས།",
    "མིག་གིས་མངོན་སུམ་མཐོང་བཞིན་༤བ་ཡལ་འདོར་བ།",
    "བདག་ལ་དགེ་སློང་གཅིག་ཅིག་གིས།",
    "རྡོ་རྗེ་རྩེ་མོ་ལས།",
    "གཙུག་ལག་གཉིས་པ་ཤེས་པའི་སོར་མོའི་གར།",
    "ལེགས་བསྒྱུར་སྒྱུ་མའི་རྣམ་འཕྲུལ་གཟིགས་མོར་མཚར།",
    "ཆུ་བྱི་ས་སྐྱོང་བློ་བཟང་མཐུ་སྟོབས་ཀྱིས་ར་ས་འཕྲུལ་སྣང་གི་མཎྜལ་ར་བའི་ལྕགས་ཁྲ་གསར་བརྗེས་ཀྱི་ནུབ་ཕྱོགས་སུ་ར་མ་ལུག་གི་ཚགས་སོགས་རྒྱས་པར་སྤེལ་བའི་ཁ་ཡིག་མཆོད་སྤྲིན་འཛད་མེད་འཁྱིལ་བའི་ཕྱག་རྒྱ།",
    "ཛམྦུའི་ལྗོན་པས་མཚན་༧ན་པའི་གླིང་གི་རྒྱན།",
    "མགོན་དེའི་བརྟེན་པ་ཞིང་ཁམས་ཞིང་གི་གཙོ།",
    "རྨད་བྱུང་བཀོད་པས་རི་མོར་ཚར་དངར་བ།",
    "ཇི་ལྟ་ཇི་སྙེད་གནས་ཚུལ་ད་ག་རེ།",
    "ལྡན་ཁྱོད་མཆོག་གི་ཉེ་ལམ་ལ་སྲེད་བཙོན།",
    "མགོན་ཁྱོད་མཛད་༨ན་པས་མཁའ་ཁྱབ་དེ་སྙེད་ཚད།",
    "ཡངས་པའི་ནོར་འཛིན་དཔལ་མོའི་མངལ་ཆེན་བསྐྲུན།",
    "མ་སྨད་ཕུན་ཚོགས་འདོད་པའི་རེ་སྐོང་ཁྲོ།",
    "རབ་སོང་རྒྱུ་སྦྱོར་བྱས་པ་དོན་༩ན་ལྡན་ཤོག།",
    "མི་མཛད་༡ན་ཚིག་གི་མཆོད་སྦྱིན་མཚོ་བྱུང་ལྷ།",
    "༡༢ན་ཨཛིཏམུཀུཊནཱཐཏེཔཱལཏཱུཨཱབྷིབུདྱིནྟཡ་རཏྣཔཱུརྦཱསནེབཛྲརཏྣཱཀནཱིརྨཱཎཀཱཡེམཧཱཡུབརཛནཏམོགམཱནོབལོབུཀྐིཡཉྩཱཧིཤ་ྐརིསཏྐེཏུཤུཀླཤྴིརེབནྡྷཥེཀཱཏཨཱིབཾཏཐཱ།",
    "མི་ཕམ་མགོན་པོས་ཉེ་བར་དམ་བཅས་གཟུངས་ཀྱི་ཕན་ཡོན་ཐོས་པའི་མོད་ལ་བདག་ཡིད་ཕྲོགས།",
    "མགོན་ཁྱོད་མཚན་དཔེའི་སྣང་བརྙན་འབར་བ་ཉི་མའི་དངོས་པོ་བརྒྱ་ཡིལུས།",
    "བརྒྱ་ཕྲག་དུ་མར་སྤེལ་ལེགས་གཟིགས་མོ་རུ།",
    "མ་སོང་གཞན་ཕན་ལྷག་བསམ་གྱིས་དྲངས་བཞེངས།",
    "མ་རྒན་ཡིན་ནོ་ཅོག་གི་བདེ་བའི་གཞི།",
    "འཚོ་བའི་རེ་བ་དོན་དང་ལྡན་པར་ཤོག།",
    "དགའ་བ་བརྒྱ་པའི་གནམ་གྱི་ཤེ་མོང་ལུང་།",
    "ཕན་པ་བསྒྲུབས་སོ་ཅོག་གི་ཡིད་ཅན་རྣམས།",
    "ཆིང་གིས་གནམ་གྱི་བརྒྱུད་པ་དའི་བུང་ཧུང་ཐའི་ཇིའི་ཧོར་གོས་འབྲུག་རིས་མ་ཁ་བཅུ་གཉིས།",
    "རྣམ་བཀྲ་རི་མོ་གཡས་འཁྱིལ་དཔལ་གྱི་མགུར།",
    "དུ་མས་ལུང་ཁུངས་འཚོལ་དང་དཀར་ཆག་གི།",
    "རྒྱུན་བཟང་པད་དཀར་སྲད་བུའི་སྲོག་གི་ཟུངས།",
    "སྟུག་པོ་ལས་སློང་ལྷག་བསམ་སྐྱ་རེངས་ཀྱིས།",
    "འཇུངས་པའི་ཐང་ལ་བརྒྱུགས་ནས་རྩེ་མོའི་དར།",
    "རང་གི་འདི་ཕྱི་ཙམ་བདེའི་ཕུབ་མ་ཙ།",
    "འབྲས་དཀར་ལོ་ལེགས་ཤུགས་ལས་ངང་གིས་འབྱུང་།",
    "གངས་ལྗོངས་རྒྱལ་སྲུང་ཚོམ་བུའི་དོ་ཤལ་ཆེ།",
    "ཐུབ་བསྟན་ཨ་མྲའི་སྡོང་པོ་དར་དྲག་རྩེར།",
    "མངོན་སུམ་གཟིགས་པ་འཇམ་མགོན་བཙོང་ཁ་པའི།",
    "གཡོས་མལ་སྣག་ཤོག་གིས་མཚོན་ཡོ་བྱད་ཀུན།",
    "ནམ་མཁའི་ངོ་བོ་ངང་གིས་ལྷུན་གྲུབ་ལྟར།",
    "ཚངས་པའི་གསུང་གི་ཤེས་བྱའི་གནས་ཀུན་རྟོགས།",
    "གསལ་གསལ་མགོན་ཁྱོད་བདག་ཡིད་ལ་ཞུགས་ནས།",
    "ཀུན་གཟིགས་མགོན་པོའི་གོ་འཕང་མ་འཐོབ་བར།",
