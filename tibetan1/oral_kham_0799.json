    "ཆུ་སྲིན་གྱི་གྲེ་བར་ཡོད་པའི་ནོར་བུ་ནི་ཁོ་རང་མགོ་ལུས་ཕྲལ་ན་ཡང་ཕྱིར་མི་གཏོང་བ་ལྟ་བུ་དགོས་གསུངས་པ་སྟེ།",
    "འབོལ་འབོལ་སྟན་ས་ལ་འདུག་འདུག་སྙམས་དང་།",
    "ཞེས་རྐང་པ་བཞི་ཀར་བར་ཆོད་ཅིང་མ་ཆོད་པའི་ཐོག་དབུས་ཀྱི་ཟུང་ལྡན་འདི་ནི་རྐང་པ་རང་རང་ཐོག་དབུས་ཀྱི་གཟུགས་མཛེས་མཛེས་ཞེས་བར་མ་ཆོད་པས་ཟློས་ཤིང་ཐོག་དབུས་ཀྱི་བར་ན་གཟུགས་གཞན་གྱིས་ཆོད་པའི་རྒྱན་འདིས།",
    "རྐང་པ་དང་པོའི་འགོ་མཇུག་ལ་གཤེན་ཞེས་པའི་གཟུགས་གཅིག་ཏུ་སྨོས་པས་ཟུང་དུ་འདུག་པ་དང་།",
    "གཟུགས་བརྙན་གསལ་གསལ་མེད་ལ་ལྟོསཞེས་རྐང་པ་དང་པོ་ཟུང་གནས་འོག་མའི་ཟུང་ལྡན་དང་གཉིས་པ་དབུས་ཟུང་སོགས་རིམ་བཞིན་གནས་མི་མཚུངས་ཤིང་རང་གནས་སུ་བར་མ་ཆོད་པར་ཟུང་ད་སྨོས་པ་སྟེ།",
    "ཞིས་རྐང་པ་དང་པོ་དང་བར་མ་གཉིས་སོགས་ཟུང་ལྡན་གྱི་གནས་ཐོག་དབུས་དང་རྐང་པ་ཕྱི་མ་དང་བར་པ་གཉིས་ཕན་ཚུན་སོ་སོར་ཐོག་དབུས་བསྣོལ་ཞིང་རང་ས་ན་བར་མ་ཆོད་པར་ཟུང་དུ་ཟློས་པ་སྟེ་འདིས་བསྟན་བྱ་ནི།",
    "བསགས་བསགས་རི་བོའི་གཏོས་ལ་གཞིགཅེས་རྐང་པ་དང་པོ་དབུས་ཟུང་ལྡན་དང་གཉིས་ཐོག་ཟུང་སོགས་རིམ་བཞིན་སོ་སོར་བསྣོལ་བས་རང་རང་བར་མ་ཆོད་པའི་ཟློས་ཤིང་སྨོས་པའི་རྗེས་མཐུན་འདིས་ནི།",
    "བོན་དང་འཇིག་རྟེན་གང་ལ་ཡིན་ཀྱང་རང་ཉིད་མཐོན་པོའི་གོ་ས་ཐོབ་པའི་དུས་སུ་ལས་འབྲས་ལ་ཞིབ་ཏུ་བརྩི་སྟེ་ཕྱོགས་རིས་མེད་པར་གང་ཐད་ནས་དྲང་པོ་དྲང་བཞག་དགོས་པ་ནི་ཤིན་ཏུ་གལ་ཆེ་སྟེ།",
    "ཚིག་རྐང་སོ་སོའི་ཐོག་མ་དང་ཐ་མ་ཅི་རིགས་ཕན་ཚུན་བསྣོལ་ཞིང་རང་གནས་སུ་གཟུགས་ཟློས་ཏེ་བརྗོད་པ་ལ་གཟུགས་གཞན་གྱིས་བར་མ་ཆོད་ཅིང་ཐོག་མཐའི་གཟུགས་ཅི་རིགས་པར་བརྗོད་པའི་རྗེས་མཐུན་ཞིག་ལ་བར་མ་ཆོད་པའི་ཐོག་མཐའི་རྗེས་མཐུན་ཞེས་བརྗོད་པའོ།",
    "དེ་བཞིན་སྔ་ཞེས་སྔ་མ་ཐོག་མ་ཟུང་ལྡན་དང་བར་མ་ཐ་མའི་ཟུང་ལྡནམ་དང་ཕྱི་མ་ཐ་མའི་ཟུང་ལྡན་སོགས་སྔ་ཕྱི་ཕན་ཚུན་རིམ་བཞིན་བསྣོལ་ཞིང་འདིས་ནི་རང་རྒྱུད་མ་ཐུལ་རིགས་གཅིག་པར་ཟོས་པ་ལ་བར་མ་ཆོད་པ་སྟེབའི་རང་མཁས་འདོད་དང་གྲགས་འདོད་ཡིན་པར་རློམ་ཞིང་རང་བཞིན་ངོ་བསྟོད་ཇི་ཙམ་བྱས་ན་དེ།",
    "གནས་ཚོད་དྲང་པོར་བརྗོད་ན་ཁྲོ་བའི་མི་འགའའཛུམ་མུལ་མུལ་འདུག་པ་འདི་ཙམ་གྱིས་དགའ་ནས་རང་ཚུགས་སྟོན་ཏེདག་རང་རྒྱུད་མ་ཐུལ་བའི་རྟགས་དངོས་སོ་ཞེས་པའོ།",
    "རང་རང་འདོད་དོན་སྒྲུབ་ལ་ཁྱད་པར་མེད།",
    "རང་རང་གནས་ལུགས་མི་རྟོགས་བཞིནགཞུང་ལས།",
    "རང་རང་གོང་མའི་ལུགས་བཟང་དེ།",
    "ཞེས་རྐང་པ་དང་པོ་གཉིས་ཀྱི་ཐོག་མར་རང་རང་ཞེས་པའི་ཚིག་སོ་སོ་ནས་ཟུང་ད་ཟློས་ཤིང་ཕྱི་མ་གཉིས་ནི་དེ་ལས་རིགས་དང་གནས་གཞི་ལྡོག་པ་ཐ་མར་སྙམས་སྙམས་ཞེས་པའི་གཟུགས་ཟུང་དང་ལྡན་པ་ལ་སྔ་ཕྱི་འགོ་སྟེ།",
    "ཟིན་མེད་ལས་ལ་སྒྱིད་ལུག་ལུག་བྲག་ཕུག་ཆུང་ཆུང་རང་ཤོང་ཙམ།",
    "རྐང་པ་རང་རང་སྔ་ཕྱིའི་དབྱངས་གཞན་གྱི་བར་ཆོད་པ་ཞིག་ལ་གོ།",
    "མཐར་བར་མ་ཆོད་པ་ཟློས་པ་སོགས་རྐང་པ་རི་ལ་སྔ་ཕྱི་གཉིས་གཉིས་ཟློས་ཤིང་རང་སར་བར་མ་ཆོད་ཅིང་སྔ་ཕྱིའི་དབྱངས་གསལ་ཐ་དད་པ་སྟེ་སྔ་ཕྱི་ཐོག་དབུས་སམ་དབུས་མཐའ་ཕན་ཚུན་བསྣོལ་བའི་བར་ཆོད་པའི་སྦྲག་མའི་རྗེས་མཐུན་ཞེས་བྱའོ།",
    "ཡིན་ཀྱང་མང་མང་འགྲོ་རང་རང་།",
    "དོན་གྱི་འདུག་ཚུལ་སྟོང་སངས་སངས།",
    "ཚིག་རྐང་རང་སྐྱ་ཐུབ་པ་ཞིག་ལན་བཞི་ལྡབ་སྨྲ་བྱེད་པ་སྟེ།",
    "བྱ་བ་གང་ལ་ཞུགས་ན་ཡང་རང་བས་གཞན་གཅེས་པའི་སྒོ་ནས་བསམ་པ་བཟང་པོ་གསེར་ལྟ་བུ་བསྐྱེད་ནས།",
    "ཇི་ལྟར་འབད་ཀྱང་རང་མཚང་མུར་བར་སྟོན།",
    "སྙན་པའི་གནས་སུ་ལེགས་འདུག་སྟེ།",
    "མེ་ཏོག་ཆེན་པོའི་ཟིའུ་འབྲུར་རང་ཉིད་འདུག།",
    "མགོ་བོར་བཞག་ཅིང་རང་ལ་ཐིམ་པར་བསྒོམ།",
    "རྩྭ་འབྲེག་དུས་ཀྱི་གྲོགས་པོ་ཡིན་ཞེས་མཚམས་སྦྱོར་བྱས།",
    "དེ་མ་ཟད་ནཐན་ཨན་མན་ནས་ཉིན་འགར་ཞག་འདུག་བྱས།",
    "འོན་ཀྱང་ལིའུ་ཧྲའོ་ཆི་སོགས་ཧའེ་ལན་པའོ་ནས་ཁྲི་ཐ་བར་ཀྱི་མེ་འཁོར་ལ་འདུག་དུས་ཡང་བསྐྱར་དཀའ་ངལ་དང་ཕྲད།",
    "དེ་མ་ཟད་ལྔ་གཅིག་དུས་ཆེན་གྱི་སྐབས་སུ་ཁྲོམ་སྐོར་བྱས།",
    "ཁོ་ཚོས་རང་རང་ས་ནས་ཚོད་མ་ཉོ་བ་དང་ཆང་ཉོ་བ་སོགས་ཀྱི་ལས་ལ་བྲེལ།",
    "རྒྱལ་གཅེས་གཞོན་ནུ་རྣམས་ཀྱི་སེམས་ཁམས་མཚོན་པའི་འདས་ཚིག་ཚོམས་ཁང་ནང་དུ་ཁྱབ་འདུག།",
    "ཁ་གཡང་སྒྲོག་དུས་ཐབས་ཇུས་ལ་མཉམ་འཇོག་བྱ་དགོས།",
    "འོན་ཀྱང་ཁོས་ཚོད་འཛིན་བྱས་པའི་ནང་དུ་ཚུད་ནས་འདུག་མི་རུང་།",
    "དགྲ་དམག་ཚར་གཅོད་བྱ་རྒྱུ་དང་རང་ཉིད་ལ་སྲུང་སྐྱོབ་བྱ་བར་འབད་དགོས།",
    "དམག་བསྐྱོད་དང་ཞག་འདུག་བྱ་བའི་དུས་ཚོད་ཇེ་ཐུང་དང་ཇེ་མྱུར་དུ་གཏོང་དགོས།",
    "ལངས་པ་དང་ནི་འདུག་པ་དང་།",
    "གདུག་པ་ཐམས་ཅད་ཀྱི་གནས་ནི་འདུག་ས་སྟེ།",
    "རང་རང་ཡིད་བཞིན་མངོན་སུམ་ཉིད་དུ་ཐོབ་པར་འགྱུར་བ་དེ་ཕྱིར་འདིར།",
    "ཕྱི་བསྭེའི་ཁང་པ་ལྟར་དམར་ལྷག་གེ་བར་འདུག་པ།",
    "མ་ཧཱ་གོ་རོ་ཙ་ན་ཁཱ་ཧི་མ་ཧཱ་བ་སུ་ཏ་ཁཱ་ཧི།",
    "གནོད་བྱེད་གང་ན་འདུག་ཀྱང་འགུགས་པའི་རྟགས།",
    "འཆི་དུས་བསྟོངས་པའི་འཁྱེར་སོ་ཅི་འདུག།",
    "དབེན་ནས་དྲི་བཟང་སྲང་གསུམ་དང་ཁ་བཏགས་ཞིག་ལས་མ་གནང་འདུག་པར་ངེད་ནས་དེ་ལས་དྲག་ཙམ་མ་ཕུལ་ན་ཡང་མི་ཡོང་ཚུལ་ཞུས།",
    "རྗེས་སུ་དེའུ་མ་བཏང་ཀ་མེད་ཀྱི་ཁས་ལེན་བྱེད་དགོས་བྱུང་འདུག་པར།",
    "ཁྲིའུ་ཞེས་བྱ་བ་ནི་འདུག་པིའོ།",
    "ཀྲི་གཅིག་ལ་ནི་གཉིས་འདུག་བའོ།",
    "སྔ་ནས་འཁོར་པར་ཞེས་བྱ་བ་ནི་སྔ་ནས་འདུག་པར་རོ།",
    "འདུག་པར་བྱེད་ན་ཞེས་བྱ་བ་ནི་འདུག་པར་བྱེད་པའམ།",
    "དེ་འདུག་པ་ན་ཀྲིའི་རྐང་པས་ཁང་ཏོག་རྡོལ་བར་བྱས་ས་ཏེ།",
    "འདུག་གམ་ཞེས་བྱ་བ་ནི་འདུག་པར་བྱེད་པའོ།",
    "འདུག་གནས་གཅིག་ཏུ་ཟོས་ནས་བསོད་སྙོམས་ཕྱི་མ་ཤོས་ཀྱང་ཟ་བར་བྱེད་པ་དང་།",
    "དགེ་སློང་མ་གང་མི་ནས་བར་འདུག་གནས་གཅིག་ན་འདུག་པས་བསོད་སྙོམས་ལན་གཅིག་བཟའ་བར་བྱ་སྟེ།",
    "འདུག་ནས་གཅིག་ཏུ་ཉལ་ན་ཞེས་བྱ་བ་ནི་མུ་སྟེགས་ཅན་གྱི་གནས་སུ་ཉལ་ནའོ།",
    "དགེ་སློང་མས་ཇི་ཙམ་ཅུང་ཟད་འདུག་གནས་སུ་གནས་སམ།",
    "འདུག་གནས་སུ་ཟས་བ་ན་གནས་པ་ན་དེ་ལ་ཉེས་བྱས་སོ།",
    "འདུག་ནས་སུ་གནས་ཤིང་གཞན་དུ་ཟ་ན་འདུག་གནས་སུ་གནས་པ་ན་དེ་ལ་ཉེས་བྱས་སོ།",
    "ཁུར་བ་འདུས་དག་དུས་མིན་དང་སོགས་འཇོག་མ་འཇོག་མ་བྱིན་ལྔ་པ་ཡིན་སྲོག་ཆགས་བཅས་པ་དག་དང་ནི།",
    "གྲོལ་བར་གསུངས་ནས་འདུག་པས།",
    "འདོད་ཀྱང་རང་འཆིང་ཞིང་གཞན་ལ་གནོད་པ་དང་།",
    "ལྟ་བ་ལོག་ཅིང་ཆགས་སྡང་རང་དཀར་སྤྱོད་དེ།",
    "དེ་ཉིད་སྣང་སྟོང་ཟུང་འཇུག་རང་བྱུང་རང་སྣང་དུ་བྷེ་ཞིང་རྩལ་སྦྱོང་པའོ།",
    "ཆང་དང་རང་མཐོང་ལྟ་སྤྱོད་ཉམས།",
    "ཐམས་ཅད་རང་བྱུང་རང་སྣང་བའོ།",
    "ཅེས་བ་ལ་སོགས་གསུངས་སོ་ ཨ་ཏི་ནི་གཉིས་དང་གཉིས་མེད་ཀྱིས་ཕྱོགས་ལ་མི་གནས་ཤིང་རང་གྲོལ་གོ།",
    "སྐལ་ལྡན་གདུལ་བྱ་ངོས་དག་དུས།",
    "རྣམ་རྟོག་མ་སྤང་རང་ཞི་བས།",
    "དེ་ལ་སོགས་པ་ལུང་མན་ངག་དུ་མ་ནས་གསུངས་པར་འདུག་གོ།",
    "གླེང་ཡང་འུབ་ཆུབ་གདའ་ཁྱབ་པས།",
    "ཚང་ཞིང་རང་བཞིན་གྱིས་གནས་པ།",
    "གཉིས་སུ་མེད་པར་ངོ་སྤྲོད་ཅིང་རང་གྲོལ་དུ་བསྟན་ལ་འབེབས་པ་ཡིན་ཏེ།",
    "ཀུན་ཀྱང་རང་བྱུང་ཡེ་ཤེས་ཉིད།",
    "དེས་ན་ཅི་ལྟར་སྣང་ཡང་རང་བྱུང་ཡེ་ཤེས་རང་སྣང་།",
    "ཅིར་སྣང་རང་བྱུང་ཡེ་ཤེས་མངོན་སུམ་དུ་མཐོང་བས་ཡུལ་མེད་རངགསོལ་གྱིས་ལྟ་བ་དང་།",
    "སྤང་བྱ་དང་གཉེན་པོ་གཉིས་སུ་མེད་པ་རང་སྣང་རང་གྲོལ་དུ་ཉམས་སུ་ལེནཔ་ཡིན་ཏེ།",
    "དགག་སྒྲུབ་སྤང་བླང་མེད་པར་འདུ་བྱུང་རང་སྣང་ཉིད་དུ་ཉམས་སུ་བླངས་ཏེ།"
  ]
}