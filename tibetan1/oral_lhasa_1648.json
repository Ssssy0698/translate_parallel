    "གཡེལ་བ་མེད་པར་རྟག་ཏུ་གྲོགས་མཛོད་ཅིག།",
    "རབ་བྱུང་བཅུ་བདུན་པའི་མེ་གླང་ཟླ་༡ ཚེས་༥ ཕྱི་ལོ་༡༩༩༧ ཟླ་༡༢ ཚེས་༤ ལ་སྦྱར་བ་དགེའོ། ། གཏོར་འབུལ་ཁག་བཞུགས་སོ། ། ཧྲཱི་ཀ་དག་ལྷན་སྐྱེས་བདེ་ཆེན་རོལ་པ་ལས།",
    "དད་པས་འབུལ་ལོ་བརྩེ་བས་དགྱེས་བཞིན་བཞེས། ཧྲཱི་སྣང་མཐའི་མགོན་པོའི་ཐུགས་ཀྱི་ཀློང་ཡངས་ནས།",
    "གྲི་ཐོགས་བཤན་པའི་ཚོགས་ལ་བསྟོད་པར་བགྱི།",
    "རྒྱལ་བ་ཀུན་གྱི་མཁྱེན་བརྩེ་གཅིག་བསྡུས་པ།",
    "ཁྱད་པར་མཁས་མང་བརྒྱ་ཕྲག་འདུ་བའི་གནས།",
    "འདིར་གཤེགས་དམ་རྫས་མཆོད་གཏོར་རྒྱ་ཆེན་བཞེས།",
    "ཅེས་པ་འདི་ནི་༧པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་བློ་བཟང་ཡེ་ཤེས་ཀྱིས་མཛད་པའོ། ཧཱུཾ།",
    "མ་དད་ལོག་པར་སྒྲུབ་པའི་གདོན་དང་བགེགས།",
    "ཐོགས་པ་མེད་པར་མྱུར་དུ་གཤེགས་སུ་གསོལ།",
    "དྲེའུའི་སྟེང་བཞུགས་གདུག་པ་ཚར་གཅོད་སྐུ།",
    "ཇི་སྲིད་དྲན་པ་དེ་སྲིད་རྟག་ཏུ་བཞུགས།",
    "རྒྱས་པར་འགེངས་པ་འཁོར་དང་བཅས་ལ་འབུལ།",
    "གཡེལ་བ་མེད་པར་རྟག་ཏུ་གྲོགས་བྱེད་ཤོག། ཀྱེ།",
    "མཆོད་གཏོར་དམ་རྫས་གཏོར་མ་འདི་བཞེས་ལ།",
    "ཐོགས་པ་མེད་པར་གནས་འདིར་གཤེགས་སུ་གསོལ།",
    "ཁྱད་པར་ལུས་ཅན་ཀུན་གྱི་ཕན་བདེའི་གཞི།",
    "ཁྱད་པར་ཚེ་རིང་མཆེད་ལྔ་བསྟན་མའི་ཚོགས།",
    "སྲིད་པའི་ལྷ་དགུ་རྗེ་ཡི་མགུར་ལྷ་སོགས།",
    "བོད་སྐྱོང་ལྷ་སྲུང་གཉན་པོ་མཆེད་འཁོར་རྣམས།",
    "གདུང་བས་འབོད་དོ་འདིར་བྱོན་མགྲོན་དུ་བཞུགས།",
    "མི་གཙང་ཉེས་ཀུན་སེལ་བའི་བསང་མཆོད་དང་།",
    "བག་མེད་ལེ་ལོས་ནོངས་པ་ཅི་མཆིས་བཤགས།",
    "ལྷག་པར་གངས་ཅན་མགོན་པོ་དང་།",
    "བཞེད་དོན་ལྷུན་གྱིས་འགྲུབ་པར་མཛོད།",
    "བོད་སྐྱོང་ལྷ་སྲུང་གཞི་བདག་ཆེ་ཕྲ་བསྙེན་ཅིང་བསྟོད་དེ་འཕྲིན་ལས་བསྐུལ་བ་འདི་ལྟ་བུ་ཞིག་བྱུང་ན་བོད་ལྗོངས་སྣོད་བཅུད་ཀྱི་རྒུད་པ་ཞི་བ་སོགས་ཀྱི་དགོས་པ་འགའ་ཞིག་མཐོང་སྟེ་བྲིས་ཤིང་།",
    "རྣམ་གྲོལ་ནོར་བུའི་གླིང་དུ་བགྲོད་པར་ཤོག།",
    "ལུས་ངག་རིག་བྱེད་མཐུ་དང་ལྡན་པར་ཤོག།",
    "ལམ་བཟང་བསྒྲུབ་ལ་བར་ཆད་མེད་པར་ཤོག།",
    "རྣམ་པར་སྣང་མཛད་མངོན་དུ་བྱེད་པའི་ཐབས།",
    "དང་པོ་སྦྱོར་ཏིང་འཛིན་རྫོགས་པར་ཤོག།",
    "མཆོད་ཅིང་ཆེད་དུ་བརྗོད་པས་བསྔགས་པར་ཤོག།",
    "ཕྱག་རྒྱ་བཞི་ཡིས་ལེགས་པར་རྒྱས་བཏབ་པས།",
    "སྒོ་གསུམ་བྱ་བའི་དྲི་མ་འཁྲུད་པར་ཤོག།",
    "མཚན་མེད་རྣལ་འབྱོར་བསྒོམ་ལ་བརྩོན་པར་ཤོག།",
    "གཞན་དོན་ཕུན་ཚོགས་འཕྲིན་ལས་འགྲུབ་པར་ཤོག།",
    "ཁྱད་པར་སྤྱན་སྟོང་མངའ་བའི་ལེགས་བྲིས་སྲས།",
    "སྔགས་དང་ཏིང་འཛིན་ཕྱག་རྒྱས་བཀུག་ནས་ཀྱངབགེགས་སྡིག་དྲི་མ་མ་ལུས་སྦྱངས་བྱས་ཏེ།",
    "ཕུན་ཚོགས་བདེ་འགྲོའི་རྟེན་ལ་འགོད་པར་ཤོག།",
    "དག་པའི་ཞིང་ཁམས་མཆོག་ཏུ་འདྲེན་པར་ཤོག།",
    "ཐབས་མཁས་སྤྱོད་པ་ཡོངས་སུ་རྫོགས་བྱས་ནས།",
    "སྣང་སྟོང་ལྷ་སྐུར་གསལ་བའི་ངང་ཉིད་ནས།",
    "ལེགས་པར་མཐོང་ནས་རྒྱལ་སྲས་སྡོམ་པ་ལ།",
    "ཐ་མལ་སྣང་ཞེན་དྲི་མ་འཁྲུད་པར་ཤོག།",
    "ཡིད་ནི་འོད་གསལ་དབྱིངས་སུ་འདྲེན་པར་ཤོག།",
    "མཐར་ཐུག་དོན་ལ་སྒྲོ་འདོགས་ཆོད་པར་ཤོག།",
    "རྣམ་དག་དམ་ཚིག་སྡོམ་པར་གསུངས་པ་ལ།",
    "ཡིད་ཀྱི་བསམ་པ་ཀུན་གྱིས་འབད་མེད་པར།",
    "སྦྱོར་བ་ཚོགས་བསགས་ཆོ་ག་བཞིན་བྱས་པས།",
    "མ་ལུས་ཚར་གཅོད་འཕྲིན་ལས་འགྲུབ་པར་ཤོག།",
    "གང་དུ་འཚང་རྒྱའི་ཞིང་ཀུན་དག་བྱས་ནས།",
    "དཀྱིལ་འཁོར་རྒྱལ་མཆོག་མྱུར་དུ་འགྲུབ་པར་ཤོག།",
    "ཕྱི་ནང་བཟླས་པ་ཡོངས་སུ་རྫོགས་པར་ཤོག།",
    "ལས་ཀྱི་རྒྱལ་པོ་མཆོག་ནི་འགྲུབ་པར་ཤོག།",
    "སྤྱོད་པ་གསུམ་དང་བཅས་པ་འགྲུབ་པར་ཤོག།",
    "ལུས་དབེན་སོར་སྡུད་བསམ་གཏན་རྫོགས་པར་ཤོག།",
    "བཅུ་གཉིས་མི་ཤིགས་ཐིག་ལེར་སྡུད་པར་ཤོག།",
    "སྤྱོད་མཆོག་རྣམ་གསུམ་ཡོངས་སུ་རྫོགས་པར་ཤོག།",
    "འཆི་ཚེ་ཡིད་ལ་དགའ་བ་རྒྱས་པར་ཤོག།",
    "གོ་འཕང་མཆོག་ལ་འགོད་པར་ཤོག།",
    "མྱུར་དུ་འཛད་པའང་ནམ་ཡང་མི་ཟད་པར།",
    "བཤེས་གཉེན་དམ་པ་ཚུལ་བཞིན་བསྟེན་པར་ཤོག།",
    "འཇིག་པར་སླ་དང་ངན་འགྲོའི་སྡུག་བསྔལ་དང་།",
    "ལེགས་པར་བསམས་ལ་ངེས་པ་བརྟན་པོ་ནི།",
    "ཕྱིན་དྲུག་བསྡུ་བ་བཞི་ལ་སྤྱོད་པར་ཤོག།",
    "ཇི་སྐད་གསུངས་བཞིན་བསྲུང་བར་ཁས་བླངས་པའི།",
    "ཤེས་ནས་བསྒོམས་པས་དེ་བཞིན་འགྲུབ་པར་ཤོག།",
    "རྡོ་རྗེ་ལུས་ཀྱི་གནས་ལུགས་རྟོགས་པར་ཤོག།",
    "འདུས་པ་སོགས་ཀྱིས་མཚོན་པར་གྱུར་པའི་དོན།",
    "དཀྱིལ་འཁོར་རྫོགས་པར་བསྐྱེད་པའི་ཐབས་སུ་ནི།",
    "ལེགས་པར་ཤེས་ནས་ཐུན་བཞིར་བསྒོམས་པ་ཡིས།",
    "འདུས་ནས་དབུས་ཀྱི་དྷཱུ་ཏཱིར་འཇུག་པར་ཤོག།",
    "རྫོགས་པར་བསྐྱེད་ནས་དངོས་གྲུབ་མཆོག་བརྙེས་ཏེ།",
    "ཧཾ་ཡིག་བདུད་རྩིའི་རྒྱུན་གྱིས་མཉེས་བྱས་པས།",
    "རྗེས་གཞིག་རིམ་པས་འོད་གསལ་འཇུག་པར་ཤོག།",
    "ལངས་པར་གྱུར་ཚེ་གང་ཤར་སྣོད་བཅུད་ཀུན།",
    "གཟུང་འཛིན་རྣམ་པར་རྟོག་པའི་བག་ཆགས་ཀུན།",
    "ཡོངས་སུ་སྦྱོང་ལ་ཐོགས་པ་མེད་པར་ཤོག།",
    "སྒྱུ་མ་ལྟ་བུའི་ཏིང་འཛིན་རྫོགས་པར་ཤོག།",
    "མངོན་དུ་བྱས་མཐར་དཔལ་ལྡན་རྡོ་རྗེ་འཆང་།",
    "སློབ་པའི་ཟུང་འཇུག་མངོན་དུ་འགྱུར་པར་ཤོག།",
    "འཁྲུལ་བའི་བག་ཆགས་མ་ལུས་འཇོམས་པར་ཤོག།",
    "གཡེལ་བ་མེད་པར་རྟག་ཏུ་གྲོགས་མཛད་ཤོག།",
    "མཚན་ཉིད་ལྡན་པས་རྗེས་སུ་འཛིན་པར་ཤོག།",
    "འཁོར་གསུམ་རྣམ་པར་དག་པའི་མཆོད་སྦྱིན་གྱིས།",
    "སྐད་ཅིག་ཉིད་ལ་དྲུངས་ནས་འབྱིན་པར་ཤོག།",
    "རྣམ་སྣང་རྣམ་པར་དག་པའི་བདག་ཉིད་ཅན།",
    "རྣམ་པར་བསྒོམས་པས་མ་དག་ཞིང་སྦྱངས་ཏེ།",
    "རྒྱལ་བའི་ལོངས་སྐུ་མྱུར་དུ་འགྲུབ་པར་ཤོག།",
    "སྤྲུལ་པའི་སྤྲིན་གྱིས་ས་གསུམ་ཁྱབ་བྱས་ནས།",
    "དག་པའི་རྟེན་དང་བརྟེན་པར་རྟག་འཆར་བ།",
    "ལས་ཀྱི་རྒྱལ་པོ་མཆོག་ནི་འགྲུབ་པར་ཤོག།",
    "སྐུ་གསུམ་གོ་འཕང་ཚེ་འདིར་ཐོབ་པར་ཤོག།",
    "སེམས་དབེན་མཐར་ཐུག་ཏིང་འཛིན་འདྲེན་པར་ཤོག།",
    "སྒྱུ་མ་ལྟ་བུའི་ཏིང་འཛིན་རྫོགས་པར་ཤོག།",
    "བདེན་པར་འཛིན་པའི་ས་བོན་དྲུངས་འབྱིན་ཤོག།",
    "སྐད་ཅིག་ཉིད་ལ་བདེ་བླག་འགོད་པར་ཤོག།",
    "དམ་པའི་མགོན་གྱིས་རྗེས་སུ་འཛིན་པར་ཤོག།",
    "རབ་འབར་དྲག་པོས་བདུད་བགེགས་བསྲེག་པར་ཤོག།",
    "ཁང་བརྩེགས་གདན་དང་བཅས་པ་འགྲུབ་པར་ཤོག།",
    "ནམ་མཁའི་དབྱིངས་ཀུན་ཁྱབ་པར་རྟོགས་བྱས་ཏེ།",
    "སྦྱོར་བ་ཚོགས་བསགས་ཆོ་ག་བཞིན་བྱས་པས།",
    "རླབས་ཆེན་ཚོགས་རྣམས་ཡོངས་སུ་རྗོགས་པར་ཤོག།",
    "རྡོ་རྗེའི་ལུས་ཀྱི་གནས་ལུགས་རྟོགས་པར་ཤོག།",
    "གཅིག་ཏུ་འདྲེས་པའི་ཧཾ་ཡིག་བསྒོམས་བྱས་པས།",
    "ཡབ་ཡུམ་སྙོམས་པར་ཞུགས་པའི་ས་བོན་ལས།",
    "ལེགས་པར་མཚོན་པའི་བསྒྲུབ་པའི་ཡན་ལག་མཆོག།",
    "མཐའ་ཡས་འགྲོ་བ་སྨིན་པར་བྱེད་པར་ཤོག།",
    "ཡན་ལག་དྲུག་ལ་གོམས་པར་བྱེད་པར་ཤོག།",
    "བྱིང་རྒོད་བྲལ་བས་རྩེ་གཅིག་འཇོག་པར་ཤོག།",
    "ཐིག་ལེར་བཅས་པའི་རྟགས་དྲུག་རྫོགས་པར་ཤོག།",
    "ལུས་སེམས་ཤིན་སྦྱངས་བདེ་བ་འདྲེན་པར་ཤོག།",
    "གྲུབ་ཟིན་བརྟན་པར་བྱེད་པའི་རྣལ་འབྱོར་གཉིས།",
    "མངོན་ཤེས་ལྔ་དང་བཅས་པ་འགྲུབ་པར་ཤོག།",
    "ཁྱད་པར་ཅན་རྣམས་ཤར་ཏེ་བྱང་སེམས་ཀྱིས།",
    "གཡོ་མེད་བརྟན་པར་འཛིན་པའི་རྣལ་འབྱོར་གྱིས།",
    "དུས་མིན་འཆི་བའི་བདུན་ཚོགས་ཉམས་པར་ཤོག།",
    "སྟོང་གཟུགས་ཡབ་ཡུམ་མཉམ་པར་སྦྱོར་བའི་སྐུར།",
    "འོད་ཟེར་ཁ་དོག་སྣ་ཚོགས་འགྱེད་པར་ཤོག།",
    "མཉམ་པར་སྦྱོར་བས་ཕྱག་རྒྱའི་རང་སྟོབས་ཀྱིས།",
    "ལེགས་པར་དྲངས་པའི་འགྱུར་མེད་བདེ་བ་ཆེ།",
    "དེ་ལྟར་སྨོན་པའི་གནས་རྣམས་གེགས་མེད་པར།",
    "འགྲོ་བའི་ཡིད་ཀྱི་མུན་པ་བསལ་བྱས་ནས།",
    "ཁྱབ་ཀྱང་ཉམས་པར་གྱུར་པའི་ཕྱོགས་དེར་ནི།",
    "ཕན་བདེའི་གཏེར་དེ་གསལ་བར་བྱེད་པར་ཤོག།",
    "ཐེག་མཆོག་བཤེས་གཉེན་འབད་པས་མཉེས་བྱས་ནས།",
    "དཔང་དུ་བཞག་ནས་ལེགས་པར་ཁས་བླངས་པའི།",
    "གསང་དོན་ལེགས་པར་ཕྱེ་བ་འདི་ཡིས་ཀྱང་།",
    "གཞུང་ལུགས་གདམས་པར་འཆར་བའི་རྐྱེན་བྱས་ནས།",
    "བློ་གྲོས་ཐོགས་པ་མེད་པར་འཇུག་པར་ཤོག།",
    "སྔོན་གྱི་ཞལ་བཞེས་དམ་བཅའ་མ་གཡེལ་བར།",
    "ངེས་པར་འཇོམས་ཚེ་བདག་ཀྱང་རྗེས་སུ་ཟུངས།",
    "གླང་བོ་ཆེ་ཡིས་གླང་བོ་རྣམ་པར་འཇོམས།",
    "ཀླ་ཀློའི་རྒྱུན་ནི་རབ་ཏུ་བཅད་བྱས་ནས།",
    "རྒྱས་པར་མཛད་ཚེ་བདག་ཀྱང་རྗེས་སུ་ཟུངས།",
    "དྲང་སྲོང་དག་ལ་མཆོད་བྱས་པས།",
    "དཀའ་ཐུབ་ཡུན་རིང་བསྟེན་བྱས་ཤིང་།",
    "བཟོད་བརྟུལ་རྟག་ཏུ་བསྟེན་བྱས་ཤིང་།",
    "དཀའ་ཐུབ་ནགས་དག་བསྟེན་བྱས་ཤིང་།",
    "བྱམས་པས་གསལ་བར་སྨིན་བྱས་ཤིང་།",
    "ཡང་དག་ལྟ་ལ་བཀོད་བྱས་པས།",
    "ལྟ་བའི་ཆུ་ལས་བསྒྲལ་བྱས་ཏེ།",
    "མཁྱེན་བརྩེ་ནུས་པ་མཐར་སོན་བདེན་པའི་འཐུས།",
    "ཡིད་ཆེས་འདུན་པའི་སྤྲོ་དགོས་འཇུག་པར་ཤོག།",
    "དེ་ཀུན་བདག་ལ་ཡོངས་སུ་སྨིན་པར་ཤོག།",
    "ལྷག་པར་སྔ་འགྱུར་བསྟན་པའི་གསལ་བྱེད་རིས་མེད་རྒྱལ་བསྟན་ལ་ཐུགས་བརྩོན་ཉམས་བཞེས་མཛད་ཅིང་།",
    "ལྟ་སྤྱོད་གཙང་མའི་བརྒྱུད་པ་སྤེལ་བའི་ཕྱིར།",
    "ཟ་འོག་དགུ་བརྩེགས་ཁྲི་ལ་སློབ་དཔོན་བཞུགས",
    "བེེ་རོས་གཙོ་བྱས་ལོ་ཙཱ་རྣམ་གསུམ་བཞུགས",
    "དུས་གསུམ་མཁྱེན་པའི་རྒྱལ་སྲས་ཆེན་པོ་ལགས",
    "ཤེས་བྱ་ཐམས་ཅད་མཁྱེན་མཛད་པའི",
    "དབྱིངས་རིག་རྣམ་པར་ཤེས་པའི་ཡབ",
    "དྲུག་པ་བཞུགས་པའི་གནས་བརྒྱད་བསྟན་པ་ནི",
    "སྙན་གྲགས་ཕྱོགས་བཅུར་དགའ་བའི་ཚལ་དུ་བཞུགས",
    "ཕྱོགས་ལྷུང་མེད་པ་སོ་སོའི་གླིང་དུ་བཞུགས",
    "བྱང་སེམས་འབྱོངས་བས་སེངྒ་ལ་རུ་བཞུགས",
    "བདག་འཛིན་བློས་བཏང་ལྕང་ར་སྨུག་པོ་བཞུགས",
    "རྒྱལ་པོས་གདན་དྲངས་བསམ་ཡས་དབུ་རྩེར་བཞུགས",
    "བཞུགས་པའི་གནས་བརྒྱད་ཀྱི་ལེའུ་སྟེ་དྲུག་པའོ",
    "ང་ཆེ་ང་བཙན་གསུངས་པའི་སྒྲུབ་རྟགས་བསྟན",
    "བདུད་བློན་རྣམས་ཀྱིས་དབྱེན་དབྱེན་ཧས་ཧས་བྱས",
    "མངའ་བདག་རྒྱལ་པོས་སྤྲུལ་པ་འགྱེད་པར་ནུས",
    "ཨོ་རྒྱན་ང་ཡི་སྤྲུལ་པ་ཡིན་པར་ངེས",
    "རྒྱལ་པོ་ཆེན་པོ་ལེགས་པར་ཉོན",
    "ང་ཡི་ལྷ་ཁང་རྣམས་ཀྱང་འཇིག་པར་བྱེད",
    "གསང་སྔགས་བསྟན་པ་དར་ཞིང་རྒྱས་པར་འགྱུར",
    "ལྷ་ས་དམར་པོ་རི་ལ་ལྷ་ཁང་འབྱུང་",
    "དེ་སྐད་གསུངས་པས་རྒྱལ་པོ་སྤྱན་ཆབ་ཤོར",
    "འདྲེན་པའི་སྐྱེས་བུ་སློབ་དཔོན་ཆེན་པོ་ལགས",
