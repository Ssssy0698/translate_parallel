    "རེ་ཞིག་རྩོད་པ་ནི་རྩོད་པ་ལྷུར་ལེན་པས་བརྩད་པར་བྱ་བ་ཡིན་ཏེ།",
    "བུམ་པ་བྱའོ་ཞེས་བསྒྲུབ་པར་བྱ་བ་བསྟན་པ་དམ་བཅའ་བར་ཐལ་བར་འགྱུར་རོ།",
    "དམ་བཅའ་བ་ཉིད་ཀྱི་སྒོ་ནས་སྒྲུབ་པར་བྱེད་པར་འགྱུར་མོད།",
    "རང་གི་དོན་ལ་ལྟོས་ནས་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "ཚིག་གི་བདག་ཉིད་ཀྱི་ཁྱད་པར་དུ་བྱས་པའི་ཕྱིར་སྐྱོན་མེད་དོ་ཞེས་ལན་གདབ་པོ།",
    "ཚིག་གིས་དེ་ཡི་མཚན་ཉིད་བཞི།",
    "བདག་གི་དོན་ཉིད་བསྒྲུབ་བྱ་ཡིན་ཡང་།",
    "དེས་ན་དེ་བསལ་བའི་ཕྱིར་རང་གི་ངོ་བོ་དང་ཚིག་ཕྲད་དང་།",
    "དོན་གྱི་བརྗོད་པ་བསྒྲུབ་བྱ་མ་ཡིན་ན་ངག་གི་དོན་ཤེས་པ་ཉིད་དུ་མི་འགྱུར་ལ།",
    "བདག་གི་དོན་གཞན་བསྒྲུབ་བྱར་འདོད།",
    "བདག་གི་དོན་དེ་ནི་མ་བརྗོད་ཀྱང་འདོད་པས་ཁྱབ་པའི་བསྒྲུབ་བྱ་ཡིན་ཞེས་བསྟན་པའི་དོན་དུ་འདོད་པ་སྨོས་སོ།",
    "རྟོགས་པ་དང་མི་ལྡན་པ་ཉིད་དུ་ཐལ་བའི་ཕྱིར་རོ།",
    "དེ་ནི་རྒོལ་བ་ཉིད་མ་ཡིན་སྐྱོན་འདི་ཉིད་དེ་ལ་མོད་ལ་འགྱུར་རོ།",
    "དེ་ཡང་སྐྱོན་ཡོད་མོད་ཕྱིར་རྒོལ་བ་ཡང་ཡང་དག་པའི་སྐྱོན་མི་བརྗོད་པའི་ཕྱིར་སྐྱོན་དུ་འགྱུར་རོ་ཞེ་ན་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་ངག་ནི་རྣམ་པར་གཅོད་པའི་འབྲས་བུ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "འགའ་ཞིག་གིས་འགའ་ཞིག་འདོད་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་རང་ཉིད་ཀྱི་སྒྲས་འདི་ནི་བསྟན་བཅོས་བྱེད་པའི་འདོད་པ་བཟློག་པའི་ཕྱིར་བྱས་པ་ཡིན་ནོ།",
    "བསྒྲུབ་མིན་འོ་ན་ཁྱོད་ཀྱི་དེ།",
    "བདག་གི་དོན་ནི་ངེས་ཀྱིས་བསྒྲུབ་བྱ་མ་ཡིན་ཏེ།",
    "དེ་ཙམ་གྱིས་གཞན་བཟློག་ན་རང་གི་ཕྱོགས་བསྒྲུབ་པའི་འབད་པ་བྱས་པས་ཅི་བྱ།",
    "དེ་ལྟ་མ་ཡིན་ན་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "ངག་གི་མཐར་ཐུག་བརྟགས་ནས་ནི།",
    "མཁས་པའི་སྐྱེ་བོ་མཐའ་དག་གི་ལུགས་ནི་འདི་ཉིད་ཡིན་ནོ།",
    "མིག་ལ་སོགས་པ་ནི་གཞན་གྱི་དོན་ཡིན་ནོ་ཞེས་བྱ་བ་འདིར་ཡང་ངག་གི་དོན་ནི་བདག་གི་དོན་ཏོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "གལ་ཏེ་གང་ལ་རྩོད་པ་གང་ལས་བདག་འགྲུབ་པའི་བདག་གི་དོན་ཉིད་དེ་ཁོ་ན་བསྒྲུབ་པར་བྱ་བ་མ་ཡིན་ན།",
    "གང་གི་ཕྱིར།",
    "གང་གིས་རྒོལ་བ་འདོད་པ་འགྲུབ་ལ་ཕྱིར་རྒོལ་བ་འདོད་པ་མ་ཡིན་པ་འབྲེལ་པའི་ཁྱད་པར་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "འདི་ལྟར་ཚུ་རོལ་མཛེས་པ་བ་དག་ན་རེ།",
    "འོན་ཏེའབའ་ཞིག་གྲུབ་པ་ཡིན་མོད་ཀྱི།",
    "དེའི་ཚེ་ཡང་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "གང་གི་ཕྱིར་ལུས་མ་གྲུབ་ན་གསལ་བ་མེད་པའི་ཕྱིར་སྤྱི་ག་ལ་ཡོད།",
    "བ་ལང་གི་གསལ་བ་མེད་པར་ནི་སྤྱི་སྲིད་པ་མ་ཡིན་ནོ།",
    "ཕན་ཚུན་རྟེན་པའི་ཉེས་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེས་ན་འདི་ནི་མ་མོ་གཤམ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་བཞིན་དུ་རང་གི་ཚིག་དང་འགལ་བ་ཡིན་ནོ།",
    "ཅི་གཏན་ཚིགས་ཀྱིའམ་དེ་སྟེ་ཚིག་གི་ཡིན།",
    "རེ་ཞིག་གཏན་ཚིགས་ཀྱིས་ནི་མ་ཡིན་ཏེ།",
    "བརྗོད་པར་འདོད་པ་གཞན་དུ་གྱུར་ན་གཞན་ཡང་སྒྲུབ་པར་བྱེད་པ་ལ་རག་མོད་ཅེ་ན།",
    "འོན་ཏེ་ཚིག་གི་ཤུགས་ཀྱིས་ཡིན་ནོ་ཞེ་ན།",
    "ཚིག་གི་ཤུགས་ཀྱིས་ནི་དོན་འགྲུབ་པ་མ་ཡིན་ཏེ།",
    "མཚན་མོ་ཟ་བར་དེར་མིན་ཏེ།",
    "རང་གིས་མཐོང་བ་སྟོན་པ་ནི།",
    "ཅི་ལྟར་ངག་གི་ཤུགས་ཀྱིས་ཐོབ་པའི་སྐྱེས་བུ་མ་གྲུབ་པ་དེ་ཞིན་དུ་མི་རྟག་པ་ཉིད་མ་གྲུབ་པོ་ཞེ་ན།",
    "གཞན་དང་རྗེས་སུ་འགྲོ་བས་གཞན་སྒྲུབ་ན་ནི་ཧ་ཅང་ཐལ་བར་འགྱུར་རོ།",
    "འདིར་ཚིག་གིས་ངེས་པ་ཐོབ་པ་ནི་མ་ཡིན་ཏེ།",
    "ཟ་བ་ནི་དངོས་པོའི་ཤུགས་ཀྱིས་གཅིག་ལ་ངེས་པ་ཡིན་གྱི་ཚིག་གི་ཤུགས་ཀྱིས་ནི་མ་ཡིན་ཏེ།",
    "ཟ་བ་པོའམ་སྟེར་བ་པོ་བསྐུལ་བ་རང་གི་འདོད་པས་འཇུག་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་སྤྱི་ཉིད་སྒྲ་ལ་མ་གྲུབ་པའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "འབའ་ཞིག་གིས་རྗེས་སུ་འགྲོ་བ་མཐོང་བས་དེའི་ཁྱད་པར་ཅན་ཉིད་གྲུབ་པ་ཡིན་ཏེ།",
    "དེས་ན་ནང་གི་ཁྱབ་པ་མི་འགྲུབ་པོ།",
    "གཞན་ཁྱབ་པས་གལ་ཏེ་གཞན་འགྲུབ་ན་ནི་ཐམས་ཅད་ཀྱིས་ཐམས་ཅད་འགྲུབ་པར་ཐལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "བསྒྲུབ་བྱ་ཡང་རང་གི་ངོ་བོ་ཉིད་བཟུང་ནི་རྗེས་སུ་དཔག་པས་ཅི་བྱ།",
    "ཁ་ཅིག་ན་རེ་བསྟན་བཅོས་ལ་མཐོང་བ་ནི་བསྒྲུབ་པར་བྱ་བ་ཉིད་ཡིན་ཏེ།",
    "དེ་ལ་གནོད་པས་ནི་གཏན་ཚིགས་དང་དམ་བཅའ་བ་དག་གི་སྐྱོན་དུ་འགྱུར་ཞེའོ།",
    "ལུང་གི་དོན་སྟོན་པའི་ཕྱིར་ལུང་ཞེས་བརྗོད་དེ་གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ།",
    "དེ་ཉིད་ནི་ལུང་གི་དོན་གཞན་ལ་སྟོན་པས་ན།",
    "ལུང་གི་དོན་ཡིན་ནོ།",
    "ཅི་ལྟར་བསྟན་བཅོས་སམ་གཏན་ཚིགས་གཞན་འགའ་ཞིག་གིས་དེ་ལ་ནམ་མཁའི་ཡོན་ཏན་ཉིད་བསྒྲུབ་པར་བྱ་བ་ལྟར།",
    "སྐད་ཅིག་གཅིག་ནི་རང་གི་རྒྱུ་ཉིད་ལས་ཡིན་ནོ།",
    "དེ་ནི་རང་གི་རྒྱུ་ལས་སྐྱེས་པ་ཡིན་པས།",
    "དེ་བཞིན་དུ་བསྒྲུབ་བྱའི་སྤྱིའི་ཕྱོགས་གཅིག་གི་ཁྱད་པར་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པའོ་ཞེ་ན།",
