    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་ལ་འང་དེ་བཞིན་གཤེགས་པ་མྱི་དམྱིགས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་འང་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་མྱི་དམྱིགས་སོ།",
    "སྐྱེ་མཆེད་དྲུག་གི་དེ་བཞིན་ཉིད་ལ་འང་དེ་བཞིན་གཤེགས་པ་མྱི་དམྱིགས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་འང་སྐྱེ་མཆེད་དྲུག་གི་དེ་བཞིན་ཉིད་མྱི་དམྱིགས་སོ།",
    "རེག་པའི་དེ་བཞིན་ཉིད་ལ་འང་དེ་བཞིན་གཤེགས་པ་མྱི་དམྱིགས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་འང་རེག་པའི་དེ་བཞིན་ཉིད་མྱི་དམྱིགས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་འང་ཚོར་བའི་དེ་བཞིན་ཉིད་མྱི་དམྱིགས་སོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་ལ་འང་དེ་བཞིན་གཤེགས་པ་མྱི་དམྱིགས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་འང་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་མྱི་དམྱིགས་སོ།",
    "མྱིག་གི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "མྱིག་གི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ཀེའུ་ཤི་ཀ་དེ་བཞིན་གཤེགས་པ་གང་ཡིན་པ་དེ་ནི་རེག་གི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "རེག་གི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "སྣའི་འདུས་ཏེ་རེག་༺འབུམ་ཆ་",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "སྐྱེ་མཆེད་དྲུག་གི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "སྐྱེ་མཆེད་དྲུག་གི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "རེག་པའི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "རེག་པའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་དང་ལྡན་པ་ཡང་མ་ཡིན།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་༺འབུམ་ཆ་",
    "ན་མོ་གུ་རུ་ལོ་ཀི་ཤྭ་ར་སྡྱ་ལ་ཤུ་ནྱ་ཏཱ་རཱ་ཛཱ་ཡ།",
    "ཤཱཀྱའི་རྒྱལ་སྲས་ཏོག་གྱུར་གང་གི་སྐུ།",
