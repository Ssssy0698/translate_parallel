    "རྒྱུ་དང་རྲེན་གིས་མ་བསྲེད་པའྟོ།",
    "ཕྱིར་བས་པ་཈ིད་དུ་ཡྟོད་པའི་གཟུགས་དང་ཚོར་བ་ལ་སྟོགས་པའི་དྟོན་ཡང་བསླུ་བར་སྟོ་སྟོར་སང་བའྟོ་ཞྲེས་བ་སྲེ།",
    "གང་ཞིག་གཟུགས་དང་ཚོར་བ་ལ་སྟོགས་པ་འདི་དག་཈ྲེ་བར་དམིགས་པའི་རང་བཞིན་དྲེ་ནི་བས་པ་སྲེ།",
    "དངྟོས་པྟོ་བས་པ་མ་ཡིན་པ་མྲེད་ལ་གང་ཞིག་གི་རང་བཞིན་ནྟོ་ཞྲེས་པའི་མིང་ཡིན་པར་འགྱུར་ན།",
    "འཇིག་རྲེན་གི་ཐ་སད་ལ་བརྲེན་ནས་དྟོན་དམ་པའི་བདྲེན་པ་ཞྲེས་བརྟོད་ལ།",
    "འྟོན་ཀང་འཇིག་རྲེན་གི་ཐ་སད་དུའྟོ།",
    "གཞན་གི་རྲེན་ལ་མི་ལྟྟོས་པའི་ཡྲེ་ཤྲེས་ལ་ལྟྟོས་ནས་མ་ཡིན་ནྟོ།",
    "ཁྟོ་བྟོ་ཅག་གནས་པ་ལ་སྟོགས་པ་འགྲེགས་པར་བྲེད་པ་ལུང་གིས་གནྟོད་པ་གྟོ་སྐབས་ག་ལ་ཡྟོད་ཅྲེས་བ་སྲེ།",
    "ལུང་གིས་བརྩད་པ་རིགས་པ་མ་ཡིན་ལ།",
    "འདུས་བས་རྣམས་ནི་དུས་གསུམ་གིས་རྣམ་པར་གནས་ལ་འདུས་བས་མྲེད་ན་དུས་གསུམ་ག་ལ་ཞིག་དྲེ་ལ་ད་ལྟར་བའི་དུས་མྲེད་པས་དངྟོས་པྟོ་མྲེད་ལ།",
    "རང་གི་སའི་དྟོན་ལ་འམ་གི་སའྟོ།",
    "ཆྟོས་཈ིད་ལ་གནས་པ་རྣམས་གཞན་གི་དྟོན་མི་མཛད་པའི་ཕྱིར་རྟོ།",
    "ཡང་ན་རང་གིས་རྟོགས་པའི་ཆྟོས་཈ིད་ཁྟོ་ན་སྟོ་བཏགས་ནས་རྟོད་བྲེད་དང་བརྟོད་བའི་ཐ་སད་ལ་གནས་ཏྲེ་཈ྲེ་བར་སྟོན་པར་མ་གྱུར་ན།",
    "བདག་གིས་ཆྟོས་཈ིད་ཟབ་མྟོ་ཟབ་མྟོར་སང་བ་མཐྟོང་དཀའ་བ་རྟོགས་དཀའ་བ་བརག་དཀའ་བ།",
    "དྲེ་བདག་གིས་གལ་ཏྲེ་གཞན་ལ་བསན་པར་གྱུར་ཀང་གཞན་གིས་ཤྲེས་པར་མི་འགྱུར་གི།",
    "དྲེ་ནི་དྲེ་སང་ན་བཅྟོམ་ལྡན་འདས་ཆྟོག་ཤྲེས་པ་ལ་གནས་པ་ཐུགས་སྟོ་བར་འགྱུར་གི།",
    "ཚངས་པ་བདག་གིས་ཚོགས་ཆྲེན་པྟོས།",
    "དྲེའི་ཕྱིར་ན་ངྲེས་པར་འདི་རྣམས་ཀིས་ཇི་ལྟར་གནས་པའི་འཇིག་རྲེན་གི་ཐ་སད་ནི་འཇིག་རྲེན་པའི་དྟོན་བྲེད་པའི་ཐབས་ཀི་ཕྱིར་ཐྟོག་མ་཈ིད་དུ་ཁས་བླང་བར་བ་སྲེ།",
    "འཇིག་རྲེན་པས་རྟོགས་པའི་ཐབས་སུ་གྱུར་བ་འཇིག་རྲེན་གི་ཐ་སད་ཁས་མ་བླངས་པར་འཇིག་རྲེན་པས་རྟོགས་པར་བྲེད་ནུས་པ་མ་ཡིན་ནྟོ།",
    "འདི་ནི་རབ་ཏུ་གགས་པའི་དཔྲེ་གཅིག་ཙམ་སྟོབ་དཔྟོན་གིས་བརྟོད་པར་འདྟོད་པའི་དྟོན་བསྒྲུབ་པའི་ཕྱིར་཈ྲེ་བར་བསྡུ་བར་བའྟོ།",
    "བདག་གི་འྟོ་ངའི་འྟོ་ཞྲེས་མངྟོན་པར་ཞྲེན་པ་ནི་ང་ཡིར་འཛིན་པའྟོ།",
    "དྲེ་ལས་བདག་དང་བདག་གིར་འཇུག་པའི་ཕྱིར་རྟོ།",
    "ངྲེས་པའི་ཚིག་གི་ཚུལ་གིས་བདྲེ་བར་གཤྲེགས་པ་ངར་འཛིན་པ་དང་ང་ཡིར་འཛིན་པ་ཤིན་ཏུ་སྤངས་པས་གནས་ཀང་ང་དང་ངའི་ཞྲེས་གསུངས་ཏྲེ།",
    "བརྟོད་བ་མྲེད་པར་རབ་ཏུ་བྲེད་པ་རྟོགས་ཀི་བར་གིས་སྟོན་པར་འགྱུར་རྟོ།",
    "དྲེའི་ཕྱིར་གནས་པ་ལ་སྟོགས་པ་འདི་དག་གི་རྟོད་བྲེད་ནི་བརྟོད་བ་མྲེད་པ་སྲེ།",
    "དངྟོས་པྟོ་ཀུན་གིས་རང་བཞིན་སྟོང་།",
    "དྲེ་ལ་བདག་མྲེད་པ་཈ིད་དྟོ་ཞྲེས་བ་བ་ནི་ཚིག་གི་ལྷག་ཟླ་གགས་ཆུང་བ།",
    "དཔྱྟོད་པར་བྲེད་པའི་ཕྱིར་མཐྟོང་བ་པྟོའྟོ་ཞྲེས་བ་བ་ལ་སྟོགས་པ་རྣམས་དྲེའི་མིང་གི་ཁྱད་པར་རྟོ།",
    "ཞྲེས་པའི་ཚིག་གིས་཈ྲེ་བར་ལྲེན་པ་ལས་དྲེ་཈ིད་དང་གཞན་པ་རྣམ་པ་ལྔས་དཔྱད་ན་མི་སིད་པས་བདག་མྲེད་དྟོ་ཞྲེས་བའྟོ།",
    "གང་གི་ཕྱིར་བདག་མིན་ཅྲེས་བདག་དགག་པ་སྔར་བཞིན་ནྟོ།",
    "བདག་མ་གྲུབ་པས་ཀང་འཇིག་རྲེན་གི་ང་དང་ང་ཡིར་འཛིན་པའི་རྟོད་བྲེད་ཀང་བརྟོད་བས་སྟོང་པའྟོ།",
    "ཁ་ཅིག་ནི་ཕྱི་རྟོལ་གི་དམིགས་པ་ལ་ལྟྟོས་པ་མྲེད་པར་སྲེམས་དང་སྲེམས་ལས་བྱུང་བ་སྲེ་སྲེ།",
    "དྲེའི་ཕྱིར་ཕྱི་རྟོལ་གི་དམིགས་པ་ལ་མི་ལྟྟོས་པའི་སྲེམས་དང་སྲེམས་ལས་བྱུང་བ་ནི་མྲེད་དྟོ།",
    "རིགས་པས་དཔྱད་ན་ཕྱི་རྟོལ་གི་དམིགས་པ་མི་སིད་ལ།",
    "དྲེའི་ཕྱིར་ཕྱི་རྟོལ་གི་དྟོན་ལ་མི་ལྟྟོས་པར་སྲེམས་དང་སྲེམས་ལས་བྱུང་བ་ཁྟོ་ན་ཁས་བླང་བར་བའྟོ་ཞྲེ་ན།",
    "ཇི་ལྟར་ཁྱྟོད་ཀིས་དཔྱད་པས་ཕྱི་རྟོལ་གི་དམིགས་པ་མི་སིད་ལ།",
    "ཕྱི་རྟོལ་གི་དམིགས་པ་བཞིན་དུ་སྲེམས་དང་སྲེམས་ལས་བྱུང་བ་ཡྟོད་ཟླ་གགས་ཆུང་བ།",
    "པ་཈ིད་རྣམ་པ་ཐམས་ཅད་དུ་གཏང་བར་བྟོས་ཤིག་སར་ཡང་གཞན་ཞིག་གིས་སྨྲས་པ།",
    "མྟོ་གཤམ་གི་བུ་ལ་དམིགས་པའི་རྣམ་པར་ཤྲེས་པ་མི་འབྱུང་སྲེ།",
    "འྟོ་ན་མྟོ་གཤམ་གི་བུ་ཞྲེས་པའི་མིང་འདི་཈ིད་འདིའི་རྣམ་པར་ཤྲེས་པའི་དམིགས་པར་ཡྟོད་པ་མ་ཡིན་ནམ།",
    "མྟོ་གཤམ་གི་བུའི་ས་ཐྟོས་པ་ན་གལ་ཏྲེ་འདིའི་མིང་཈ིད་མྟོ་གཤམ་གི་བུ་ལ་དམིགས་པའི་རྣམ་པར་ཤྲེས་པའི་དམིགས་པར་འགྱུར་ན།",
    "དྲེའི་ཚེ་མྟོ་གཤམ་གི་བུ་མྲེད་དྟོ་ཞྲེས་པ་ན་དྲེ་཈ིད་ཀི་མིང་ཡང་མྲེད་པར་འགྱུར་ན།",
    "མྟོ་གཤམ་གི་བུ་ནི་དངྟོས་པྟོ་མྲེད་པ་སྲེ།",
    "རྣམ་པར་ཤྲེས་པ་ལ་རང་གི་རྣམ་པར་གཏྟོད་པའི་དྟོན་ནི་དམིགས་པའི་དྟོན་ཏྟོ་ཞྲེ་ན།",
    "གལ་ཏྲེ་དྲེ་ལྟ་ན་མྟོ་གཤམ་གི་བུ་མྟོ་གཤམ་གི་བུ་ལ་དམིགས་པའི་རྣམ་པར་ཤྲེས་པ་ལ་རྣམ་པར་གཏྟོད་དམ་ཅི།",
    "དྲེ་ལྟར་ན་དངྟོས་པྟོ་མྲེད་པ་དང་རྣམ་པ་དག་འགལ་བས་འདི་ནི་མྟོ་གཤམ་གི་བུ་བཞིན་དངྟོས་པྟོ་཈ིད་དུ་མི་འགྱུར་ཏྲེ།",
    "ཡྟོངས་སུ་གཅྟོད་པའི་རང་བཞིན་གི་ཕྱིར་རྟོ།",
    "གང་གི་ཕྱིར་དམིགས་པའི་རྣམ་པ་ལས་ཐ་དད་པའི་རྣམ་པར་ཤྲེས་པའི་ངྟོ་བྟོ་མྲེད་དྟོ།",
    "རྣམ་པར་ཤྲེས་པ་དངྟོས་པྟོ་མྲེད་པ་ན་ཡང་མྟོ་གཤམ་གི་བུ་ནི་དངྟོས་པྟོ་མྲེད་པའྟོ་ཞྲེས་ཇི་སྐད་བརྟོད་དྟོ།",
    "དྲེ་ཡང་ཡུལ་གི་རྣམ་པ་མ་བཟུང་བས་སྲེ་བ་ཐྟོབ་པར་མི་བྲེད་དྟོ།",
    "དྲེའི་སྲེ་བ་ལས་སྔ་རྟོལ་གི་གནས་སྐབས་཈ིད་ལ་བརག་པར་བ་ན།",
    "གལ་ཏྲེ་ཡང་མྟོ་གཤམ་གི་བུ་ལ་དམིགས་པའི་རྣམ་པར་ཤྲེས་པས་དངྟོས་པྟོ་མང་པྟོ་ལ་དམིགས་པར་འགྱུར་ན།",
    "དྲེ་ལྟ་ན་སྔྟོན་པྟོའི་ས་ལ་མ་ལྟྟོས་པར་སྔྟོན་པྟོའི་རྣམ་པའི་རྣམ་པར་ཤྲེས་པ་བཞིན་མྟོ་གཤམ་གི་བུའི་ས་ལ་མ་ལྟྟོས་པར་དྟོན་རྟོགས་ལ་རག་ན་རྟོགས་པ་ནི་མྲེད་དྟོ།",
    "གལ་ཏྲེ་ལས་དང་཈ྟོན་མྟོངས་པའི་རྒྱུ་ཅན་གི་རྣམ་པར་ཤྲེས་པ་དྲེ་ལྟར་མ་གྱུར་ཀང་ཟག་པ་མྲེད་པའི་རྣམ་པར་ཤྲེས་པ་མྱ་ངན་ལས་འདས་པའི་དམིགས་པ་ལ་རག་ཏུ་འཇུག་པར་འགྱུར་རྟོ།",
    "གལ་ཏྲེ་གང་གི་དངྟོས་པྟོ་མྲེད་པ་རྣམ་པར་ཤྲེས་པས་དམིགས་ནའྟོ།",
    "སར་ཡང་འདིའི་གཏན་མྲེད་ཀི་རྣམ་པར་ཤྲེས་པ་མྟོ་གཤམ་གི་བུའི་ས་ལ་ལྟྟོས་པ་བཞིན་ནྟོ།",
    "ལྷ་སྦྱིན་ནི་འཇིག་རྲེན་ན་ཟ་བའི་བ་བ་རྟོགས་པའི་རྒྱུར་དམིགས་པས་དྟོན་དྲེས་ན་ལྷ་སྦྱིན་གི་ས་དྟོན་དང་ལྡན་པའྟོ།",
    "མྟོ་གཤམ་གི་བུ་བསན་ཀང་འཇིག་རྲེན་པ་ལ་མི་དམིགས་ལ།",
    "དྲེའི་ཕྱིར་མྟོ་གཤམ་གི་བུའི་ས་འདི་ཡང་བསྒྲུབ་བའི་དྟོན་གིས་སྟོང་པའྟོ།",
    "རྣམ་པར་ཤྲེས་པ་ཡང་སའི་དྟོན་མངྟོན་པར་ཤྲེས་པ་རྣམས་ལ་དྟོན་གིས་སྟོང་པའི་ས་ལ་དམིགས་པའྟོ།",
    "དྲེ་ལ་ད་ལྟ་བའི་དངྟོས་པྟོ་ལ་ལྟྟོས་ན་དྲེའི་སྲེ་བའི་སྔྟོན་རྟོལ་གི་གནས་སྐབས་ལ་སྔ་ན་མྲེད་པ་ཞྲེས་རྣམ་པར་འཇྟོག་ལ།",
    "འདི་ལྟ་སྲེ་མྟོ་གཤམ་གི་བུ་ལྟ་བུའྟོ།",
    "འདི་ནི་ཤར་གི་ཕྱྟོགས་སུ་ཞྲེས་཈མས་སུ་མྱྟོང་བ་མ་ཡིན་ནམ།",
    "རབ་རིབ་ཅན་གི་སྐྲ་དང་སྦྲང་བུ་ལ་སྟོགས་པའི་དྟོན་མྲེད་ཀང་རང་གིས་ཅིའི་ཕྱིར་཈མས་སུ་མ་མྱྟོང་།",
    "གིས་ཡང་དག་པའི་དྟོན་གི་དངྟོས་པྟོར་རྣམ་པར་གཞག་པར་མི་ནུས་སྟོ།",
    "དྲེ་བཞིན་དུ་བདག་གི་རང་བཞིན་དང་འགལ་བས་ཆྟོས་ཐམས་ཅད་ནི་བདག་མྲེད་པ་ཁས་བླངས་སྟོ།",
    "དྲེའི་ཕྱིར་བདག་གི་རང་བཞིན་དང་འགལ་བའི་བདག་མྲེད་པའི་རང་བཞིན་གི་ཕྱིར་རམ།",
    "དྲེ་ཡང་ཡྟོད་ལ་དྲེའི་ཕྱིར་བདག་གི་ཆྟོས་མྲེད་པས་ཆྟོས་ཐམས་ཅད་མིང་ཙམ་མ་ཡིན་ནྟོ་ཞྲེ་ན།",
    "མུ་སྲེགས་བྲེད་ཀི་ཡྟོངས་སུ་བརགས་པའི་བདག་གི་དངྟོས་པྟོ་མྲེད་པ་དང་།",
    "རང་བཞིན་གི་རྣམ་གངས་ལ་བདག་མྲེད་པ་཈ིད་དུ་བསན་པ་ན་དྟོན་ཆྲེན་པྟོ་སྲེ་བར་འགྱུར་རྟོ།",
    "དྲེ་ཡང་མུན་ནག་གི་ནང་དུ་གྱུར་པའི་སྲེས་བུའི་རྣམ་པ་ལ་ཡྟོངས་སུ་བརགས་པ་བཞིན་དུ་ཉུང་ཟད་ཀིས་ཤིན་ཏུ་ཕྱིན་ཅི་ལྟོག་པས་ཡྟོངས་སུ་བརགས་ཀི།",
    "བདག་གི་བརག་པ་བརྲེན་པ་ཐྲེར་ཟུག་པ་ཡྟོངས་སུ་འགྱུར་བའི་ཆྟོས་ཅན་མ་ཡིན་པས་སྟོང་པར་གྲུབ་བྟོ་ཞྲེས་སྟོ།",
    "མིག་ལ་བརྲེན་ནས་བཏགས་པའི་བདག་གིས་སྟོང་པ་དང་རང་བཞིན་གིས་སྟོང་པ་཈ིད་དུ་ལུང་འདིས་གསལ་བར་མཛད་ཀི།",
    "ནང་གི་བྲེད་པའི་སྲེས་བུ་དང་བལ་བ་ནི་མ་ཡིན་ནྟོ།",
    "དྲེ་ལ་མིག་ནི་བདག་གིས་སྟོང་ངྟོ་ཞྲེས་པ་ཕུང་པྟོ་དང་ཁམས་དང་སྲེ་མཆྲེད་ལ་བརྲེན་ནས་གང་ཞིག་ལ་བཏགས་ལ་བདག་དྲེ་ནི་ཕུང་པྟོ་དང་ཁམས་དང་སྲེ་མཆྲེད་ལ་རྣམ་པ་ལྔས་མྲེད་ཀང་ཕུང་པྟོ་དང་ཁམས་དང་སྲེ་མཆྲེད་ལ་བརྲེན་ནས་འདྟོགས་ལ།",
    "གང་གི་ཕྱིར་མིག་ལ་དཔྱད་པ་ན་བདག་མི་སིད་པ་དྲེའི་ཕྱིར་མིག་ནི་བདག་གིས་སྟོང་པ་སྲེ།",
    "འདི་ལྟ་སྲེ་ལྷ་སྦྱིན་གིས་སྟོང་པའྟོ་ཞྲེས་སྟོ།",
    "མིག་ནི་བདག་དང་བལ་བའི་ཕྱིར་སྟོང་པའྟོ་ཞྲེས་བདག་མྲེད་པས་བདག་གི་ཅུང་ཟད་ཀང་ཡྟོད་པ་མ་ཡིན་ནྟོ་ཞྲེས་བ་སྲེ།",
    "བདག་གིར་བ་བ་དང་བལ་བས་སྟོང་ལ།",
    "བདག་གིར་བ་བའི་རང་བཞིན་ལས་ཐ་དད་པའི་མིག་གཞན་ཡྟོད་པ་མ་ཡིན་ནྟོ།",
    "མིག་ལ་བརྲེན་ནས་བདག་ཏུ་བཏགས་པ་དང་ལྡན་པ་བཞིན་བདག་གིས་བདག་ཏུ་བས་པས་འདི་ནི་བདག་གི་བ་ཞྲེས་བ་ལ།",
    "ཡང་ན་བདག་གི་ས་ནི་རང་བཞིན་གི་རྣམ་གངས་ཏྲེ།",
    "མིག་བདག་གིས་སྟོང་ངྟོ་ཞྲེས་བ་བ་ནི་རང་བཞིན་གིས་ཞྲེས་བ་བའི་དྟོན་ཏྟོ།",
    "བདག་གི་བས་ཞྲེས་པ་རང་བཞིན་དང་འབྲེལ་བའི་གང་སུ་ཡང་རུང་བས་ཞྲེས་པའི་དྟོན་ཏྟོ།",
    "མིང་དང་གཟུགས་ཀི་རྲེན་གིས་སྲེ་མཆྲེད་དྲུག་གྟོ་ཞྲེས་པས་མིང་དང་གཟུགས་ལ་བརྲེན་ནས་བྱུང་བའི་ཕྱིར།",
    "གང་གི་ཚེ་འདི་ལྟར་འཇིག་རྲེན་པ་ལ་མིག་མྲེད་དྟོ་ཞྲེས་མྲེད་ན་དྲེའི་ཚེ་ཁྟོ་བྟོ་འཇིག་རྲེན་པ་མིག་མྲེད་པར་ཁས་ལྲེན་ནྟོ་ཞྲེས་ཇི་ལྟར་སྨྲ།",
    "དངྟོས་པྟོ་རྣམས་ཀི་རང་བཞིན་མཆྟོག་ཏུ་རྲེས་སུ་ཚོལ་བ་཈ིད་ནི་དྲེའི་ཕྱིན་ཅི་མ་ལྟོག་པའི་ལམ་དྲེ་ཡང་རང་བཞིན་མྲེད་པ་སྲེ་བ་མྲེད་པའི་རང་བཞིན་གི་ཕྱིར་སང་བ་མྲེད་པའྟོ་ཞྲེས་བ་སྲེ།",
    "དམིགས་པ་མྲེད་པ་རྣལ་འབྟོར་པ་སུ་ཞིག་གིས་ཁྟོང་དུ་ཆུད་པར་འགྱུར་བ་ཞིག་གྟོ།",
    "མིག་ནི་རང་གི་མཚན་཈ིད་མ་གྲུབ་པ་཈ིད་རང་གི་མཚན་཈ིད་གྲུབ་པ་ལྟ་བུར་བིས་པ་རྣམས་ཀིས་རྟོགས་པས།",
    "དྲེའི་ཕྱིར་ཀུན་རྟོབ་ཏུ་མིག་གི་རང་གི་མཚན་཈ིད་མྲེད་དྟོ།",
    "ཡང་ན་ཀུན་རྟོབ་ཏུ་མིག་ཡྟོད་ལ་དྟོན་དམ་པར་མྲེད་དྟོ་ཞྲེས་པའི་ཚིག་གི་རིགས་པ་ཡང་གདྟོན་མི་ཟ་བར་ནུས་པར་རུང་ན་ཡང་།",
    "དྲེ་ལྟ་ན་ཡང་རང་གི་མཚན་཈ིད་ཁས་ལྲེན་པ་དང་སྤྟོང་བ་དག་ནུས་པ་དང་ལྡན་པ་མ་ཡིན་ནྟོ།",
    "དངྟོས་པྟོ་རྣམས་ཀི་རང་གི་མཚན་཈ིད་ཁས་བླངས་པ་དྲེ་ནི་སྒྱུ་མ་ལ་སྟོགས་པའི་དཔྲེ་རུང་བ་མ་ཡིན་ཏྲེ།",
    "རང་གི་མཚན་཈ིད་ཁས་བླངས་པ་ལ་སྒྱུ་མ་ལ་སྟོགས་པའི་དཔྲེ་དང་འབྲེལ་པ་མྲེད་པའི་ཕྱིར་དང་།",
    "གལ་ཏྲེ་ཡིན་ན་དྲེའི་ཚེ་དྲེ་ནི་རང་བཞིན་གིས་སྟོང་པ་཈ིད་མ་ཡིན་ནྟོ།",
    "རང་བཞིན་དུ་སྲེས་པ་སྲེལ་བར་བྲེད་ན་སྟོན་འདིར་འགྱུར་གི།",
    "འདི་དག་བདྲེན་པར་མངྟོན་པར་ཞྲེན་པ་མཆྟོག་ཏུ་འཛིན་པ་ལུས་ཀི་མདུད་པ་དྲེའི་ག་཈ྲེན་པྟོར་ཁྟོ་བྟོས་མིག་རང་བཞིན་མྲེད་པར་རྣམ་པར་གནས་པ་཈ིད་མིག་རང་བཞིན་མྲེད་པའྟོ་ཞྲེས་པའི་ཚིག་གིས་ཤྲེས་པར་བྲེད་ཀི།",
    "ཇི་སྐད་སྟོས་པའི་སྟོན་དུ་ཐལ་བར་མི་འགྱུར་རྟོ།",
    "དྲེ་ལྟ་ན་མིག་དྲེ་ནི་རང་བཞིན་གང་ཞིག་གིས་སྟོང་པ་རྣམ་པར་གཞག་པ་ཡྟོད་པ་སྲེ།",
    "འདི་ལྟར་ཁང་པ་ལྷ་སྦྱིན་གིས་སྟོང་ངྟོ་ཞྲེས་བརྟོད་པ་ན།",
    "གང་དུ་དགྲེ་སྦྱྟོང་ངམ་བམ་ཟྲེ་དག་དྲེ་ཡང་གང་ཞིག་གིས་སྟོང་པ་མི་འདྟོད་ན་དྲེ་ནི་སྟོང་པ་ལས་ཕྱིན་ཅི་ལྟོག་ཏུ་ཞུགས་པའྟོ་ཞྲེས་སྟོ།",
    "སྲེས་ནས་ཡྟོད་པ་ལ་འདི་ནི་ཡྟོད་པའྟོ་ཞྲེས་རུང་གི་མ་སྲེས་པ་ལ་ནི་མ་ཡིན་ནྟོ།",
    "དྲེ་ནི་ཚིག་ཙམ་གིས་སྨྲ་བའྟོ།",
    "གལ་ཏྲེ་ཁྟོ་བྟོ་ཅག་གིས་བདག་མྲེད་པར་གྱུར་ན།",
    "བརྫུན་གིས་སླུ་བའི་ཆྟོས་ཅན་དངྟོས་པྟོར་གྱུར་པ་ལ་རང་བཞིན་མྲེད་པས་དྲེའི་ཕྱིར་དངྟོས་པྟོར་གྱུར་པ་དྲེ་དྲེའི་རང་བཞིན་གིས་སྟོང་ངྟོ།",
    "གང་ཡང་འདིར་ལྷག་མ་ཞྲེས་པ་ནི་བརྫུན་པ་སླུ་བའི་ཆྟོས་ཅན་རང་གི་མཚན་཈ིད་མ་གྲུབ་པ།",
    "རང་བཞིན་ལ་སྟོ་མ་བཏགས་པས་ཕྱིན་ཅི་མ་ལྟོག་པ་ལ་གནས་ཏྲེ་ཕྱིན་ཅི་ལྟོག་གིས་བསྲེད་པའི་འཁྟོར་བ་ངྲེས་པར་སྤྟོང་ཞིང་རག་པར་སྨྲ་བར་མི་ཟླ་གགས་ཆུང་བ།",
    "ཇི་སྐད་དུ་སྟོས་པའི་དཔྱད་པ་རྣམས་སྲེམས་ལ་གིས་ཤིག་ལུང་འདི་ལས་ཀང་འདི་གསལ་བར་བྲེད་པས་སྲེམས་ལ་ཞྟོག་ཅིག་ཇི་སྐད་དུ།",
    "སིག་རྒྱུ་དང་མཚུངས་འགྟོ་ཀུན་ཤྲེས་པར་གིས།",
    "དྲེ་ལྟར་ཡང་བདག་དང་བདག་གི་བས་སྟོང་པར་བསྒྲུབས་པས་མིག་རང་བཞིན་མྲེད་པར་བསྒྲུབས་ནས།",
    "སར་ཡང་མིག་གི་རང་བཞིན་སྟོང་པར་བསྒྲུབ་པའི་ཕྱིར་གསུངས་པ།",
    "དྲེ་བཞིན་དུ་ཡང་བདག་གི་སས་ནི་རང་བཞིན་གི་རྣམ་གངས་ཀི་ཕྱིར་སྟོན་མྲེད་དྟོ།",
    "ནི་རང་བཞིན་གི་མིང་གི་བྲེ་བག་ཡིན་གི་ནང་གི་བྲེད་པའི་སྲེས་བུའི་ནི་མ་ཡིན་ཏྲེ།",
    "འདི་ལྟར་མ་རིག་པའི་རྲེན་གིས་འདུ་བྲེད་ཅྲེས་བ་བ་ལ་སྟོགས་པའྟོ།",
    "དྲེ་ལྟར་ཡང་བདག་དང་བདག་མྲེད་ཅྲེས་པ་ལ་ཡྟོད་པ་མ་ཡིན་ནྟོ་ཞྲེས་པ་ཚིག་གི་ལྷག་མའྟོ།",
    "ཁ་ཅིག་གིས་སྨྲས་པ།",
    "དྲེ་བཞིན་དུ་སྔར་གི་དྲེ་མ་ཐག་པའི་བདག་དང་བདག་མྲེད་པ་དང་ཡང་འབྲེལ་ཏྟོ།",
    "དྲེ་ལ་འདིར་རྲེ་ཞིག་སྔར་གི་རྟོག་པ་བརྟོད་དྲེ།",
    "གང་གི་ཕྱིར་ཕ་རྟོལ་པྟོའི་བདག་གི་ས་ལ་བརྟོད་བའི་དྟོན་བདག་ཡྟོད་པ་མ་ཡིན་ཏྲེ།",
    "རང་གི་སྲེ་པ་དག་ཀང་སྨྲ་སྲེ།",
    "ནང་གི་བྲེད་པའི་སྲེས་བུ་དང་བལ་བའི་བདག་མྲེད་པ་ཕུང་པྟོ་ཙམ་ཡྟོད་ལ།",
    "ཡང་རང་གི་སྲེ་པ་ཁ་ཅིག་ནི་འདི་སྐད་སྨྲ་སྲེ།",
    "གང་གི་ཚེ་ཡང་འདི་ལྟར་བདག་དང་བདག་མྲེད་པ་སྲེ།",
    "དྟོན་གིས་སྟོང་པར་གྲུབ་བྟོ།",
    "དྲེ་ལྟ་ན་ཡང་གང་ཞིག་དྟོན་གིས་སྟོང་པའི་ཚིག་དྲེ་དྲེ་བཞིན་དུ་ཡྟོད་ལ།",
    "འྟོ་ན་མྟོ་གཤམ་གི་བུའི་བརྟོད་པ་བརྟོད་བའི་དྟོན་གིས་སྟོང་ཡང་བརྟོད་བ་ལས་གཞན་པ་ཡྟོད་པས་བརྟོད་པ་ཡྟོད་དྟོ་ཞྲེ་ན།",
    "ཡང་ན་ཚིག་ནི་དྟོན་གིས་སྟོང་པར་བསྒྲུབས་ལ།",
    "ས་ཡང་ས་གཞན་གི་བརྟོད་བ་ཡིན་པས་དྟོན་཈ིད་ལ་དྟོན་དྲེ་ཡང་མྲེད་པ་཈ིད་དྟོ་ཞྲེས་བ་ལ།",
    "གཟིགས་ནས་གསུངས་པ་བརྟོད་འགའ་མྲེད་ཅྲེས་སྟོ།",
    "ཁྟོ་བྟོས་སྒྱུ་མའི་ནྟོར་གིས་ཕྱུག་པྟོར་བྲེད་པའམ་སིག་རྒྱུའི་ཆུས་ཁྱྟོད་ཀིས་ཆུའི་གདུང་བ་སྲེལ་བར་བྲེད་པའམ།",
    "གལ་ཏྲེ་ཁྱྟོད་དྲེ་ཁྟོ་ན་཈ིད་ལ་ཕྱིན་ཅི་ལྟོག་ཏུ་གྟོ་བ་དག་སྤྟོང་བ་དག་གིས་ལྟོག་པར་སྒྲུབ་པར་མི་བྲེད་ཅིང་ཆྟོས་཈ིད་ཟབ་མྟོ་ལ་གུས་པ་ཡང་སྲེད་ན་དྲེའི་ཚེ་ཁྱྟོད་ཀི།",
    "དངྟོས་པྟོ་ཀུན་གི་རང་བཞིན་སྟོང་།",
    "རང་བཞིན་གིས་སྟོང་པ་ནི་རང་བཞིན་དང་བལ་བ་ཞྲེས་བ་བའི་དྟོན་ཏྟོ།",
    "མྱ་ངན་ལས་འདས་པ་ནི་རག་པ་མ་ལུས་པ་སྲེ་བ་མྲེད་པའི་རང་བཞིན་རང་གི་མཚན་཈ིད་ཅུང་ཟད་ཀང་མྲེད་པ་སྲེ།",
    "དྲེ་ལྟར་ན་ཆྟོས་རྣམས་ཀི་དྲེ་ཁྟོ་ན་཈ིད་ཕྱིན་ཅི་མ་ལྟོག་པར་བརྲེན་པར་འགྱུར་གི་གཞན་དུ་མ་ཡིན་ནྟོ།",
    "རྲེ་ཞིག་མྱ་ངན་ལས་འདས་པ་སྡུག་བསྔལ་དང་བལ་བ་ཙམ་ལ་རང་བཞིན་མྲེད་པ་ནི་རུང་གི་ཕྱི་དང་ནང་གི་ཆྟོས་འདུ་བྲེད་དང་མྱུ་གུ་ལ་སྟོགས་པ་དང་།",
    "མ་རིག་པ་དང་ས་བྟོན་ལ་སྟོགས་པ་རྒྱུ་དང་རྲེན་གིས་཈ྲེ་བར་བསྲེད་པའི་བདག་཈ིད་དུ་ཡྟོད་པ་རྣམས་ཇི་ལྟ་བར་རང་དང་སི་དང་ཐུན་མྟོང་དུ་཈མས་སུ་མྱྟོང་བའི་རང་གི་མཚན་཈ིད་མྱ་ངན་ལས་འདས་པ་ལས་ཤིན་ཏུ་བསྐལ་པའི་མཚན་཈ིད་རྣམས་ཇི་ལྟར་རང་བཞིན་གིས་སྟོང་པ་཈ིད་དུ་བསྒྲུབས་པར་ནུས།",
    "དྲེའི་ཚེ་འཕགས་པ་དང་འཕགས་པའི་ལམ་གིས་ཅི་དགྟོས་པར་འགྱུར།",
    "ཇི་ལྟར་འཕགས་པའི་ལམ་གིས་མངྟོན་དུ་བས་པའི་འཕགས་པས་ཆྟོས་རྣམས་ཀི་ཆྟོས་཈ིད་གཟིགས་པར་གྱུར་པ་དྲེ་ལ་རང་བཞིན་ནྟོ་ཞྲེས་རིགས་ཏྲེ།",
    "ཇི་ལྟར་ན་འདི་རྣམས་མྱ་ངན་ལས་འདས་པ་དང་མཚུངས་ན་རང་བཞིན་གིས་སྟོང་པའྟོ།",
    "དྲེ་ཇི་ལྟར་ཁྟོ་བྟོ་ཅག་གིས་འདི་རྟོགས་པར་ནུས་ཤྲེ་ན།",
    "སར་ཡང་ཅི་ཞིག་འདིར་འཕགས་པས་བསན་པའི་རིགས་པ་གང་གིས་ཆྟོས་རྣམས་ཀི་ཆྟོས་཈ིད་མྱ་ངན་ལས་འདས་པ་དང་མཚུངས་པར་རིགས་པས་མངྟོན་སུམ་དུ་འགྱུར་ཞྲེ་ན།",
    "དྲེ་ཡང་ཇི་ལྟར་སཱ་ལུའི་མྱུ་གུ་སྲེད་པའི་ཡན་ལག་གི་དངྟོས་པྟོར་གྱུར་པ་དྲེ་བཞིན་ནས་ཀི་མྱུ་གུ་ལ་སྟོགས་པ་ཡང་ངྟོ།",
    "མྱུ་གུ་ལ་སྟོགས་པའི་རྒྱུ་ལས་སྲེས་པའི་འབས་བུ་ས་ལ་སྟོགས་པའི་རྣམ་པ་དང་རྲེས་སུ་འབྲེལ་པ་མ་ཡིན་ལ་སཱ་ལུའི་ས་བྟོན་གི་རྣམ་པ་དང་རྲེས་སུ་འབྲེལ་ཏྟོ་ཞྲེས་བའྟོ།",
    "ཡུལ་གཅིག་ལ་རྒྱུ་རྲེན་གི་སའི་སྦྱྟོར་བ་བཅྟོམ་ལྡན་འདས་ཀིས་མཛད་དྟོ།",
    "རྒྱུ་དང་རྲེན་གིས་བསྲེད་པའི་དངྟོས་པྟོ་རྣམས་ཁྟོ་ན་རང་བཞིན་ནྟོ་ཞྲེ་ན།",
    "ངྲེས་པར་འདི་སྐད་བརྟོད་པར་བ་སྲེ་རྒྱུ་དང་རྲེན་གང་ལས་རང་བཞིན་གང་ཞིག་སྲེ་ན་དྲེ་ཅི་དྲེ་རྣམས་ལ་ཡྟོད་པ་ལས་དྲེ་སྲེ་བར་འགྱུར་གི།",
    "ཡྟོད་བཞིན་པ་ན་དམིགས་པར་ཐལ་བ་དང་།",
    "རྒྱུ་གཅིག་གིས་བསྒྲུབ་པར་བ་བ་཈ིད་དུ་འགྱུར་རྟོ།",
    "འབས་བུ་གཅིག་དུམ་བུར་སྲེ་བར་ཐལ་བར་འགྱུར་ལ།",
    "རྒྱུ་ཐ་དད་པ་ན་ཡང་རྒྱུ་དུ་མས་འབས་བུ་སྲེད་པར་ཐལ་ལྟོ།",
    "གང་གི་ཚེ་འབས་བུ་རྒྱུ་ལ་སྟོགས་པ་ལ་མི་གནས་པའི་ཕྱིར་དྲེ་དྲེ་རྣམས་ལས་མི་སྲེ་ལ།",
    "གང་ཡང་དྲེ་ནི་ད་ལྟར་ན་དྲེས་ན་དངྟོས་པྟོ་རྣམས་ཀི་རང་བཞིན་མྲེད་པས་དངྟོས་པྟོ་ཐམས་ཅད་མྱ་ངན་ལས་འདས་པ་དང་མཚུངས་པ་རང་བཞིན་གིས་སྟོང་པར་གྲུབ་བྟོ།",
    "འདིར་ཁ་ཅིག་གིས་སྨྲས་པ།",
    "རྒྱུ་དང་རྲེན་གི་གངས་བཞིན་དུ་འབས་བུ་རྣམས་ཡྟོད་པར་ཁྟོ་བྟོ་ཅག་ཁས་མི་ལྲེན་ལ།",
    "རང་གི་མཚན་཈ིད་དུ་ཡྟོད་པའི་ཕྱིར་རྟོ་ཞྲེ་ན།",
    "གང་ཞིག་དངྟོས་པྟོ་རྣམས་ཀི་རང་གི་མཚན་཈ིད་གྲུབ་པར་འདྟོད་ན།",
    "དྲེའི་རང་གི་མཚན་཈ིད་དྲེ།",
    "དྲེ་ལྟ་ན་ཡང་རྒྱུ་ལ་འབས་བུའི་རང་གི་མཚན་཈ིད་ཡྟོད་པ་མ་ཡིན་ཏྲེ།",
    "ཡང་ན་མྲེད་ན་མྲེད་བཞིན་པའི་རང་བཞིན་གི་འབས་བུ་ནི་དྲེ་ལྟ་ན་ཡང་མྲེད་པའི་ཕྱིར་འབས་བུ་རག་ཏུ་ཡྟོད་བཞིན་པ་མིན་ལ།",
    "ཡྟོད་བཞིན་པ་མ་ཡིན་པའི་ཕྱིར་རི་བྟོང་གི་རྭ་བཞིན་སྲེ་བ་མྲེད་དྟོ།",
    "དྲེ་ལྟ་ན་ཡང་ག་཈ིས་ཀི་ཚུལ་གིས་སྲེ་བར་འགྱུར་རྟོ་ཞྲེ་ན།",
    "སྲེ་བ་ཡྟོད་ན་ཡྟོད་པར་འགྱུར་གི་སྲེ་བ་མྲེད་པ་ལ་གནས་པ་དང་འགག་པ་མི་འཐད་དྟོ་ཞྲེས་བ་སྲེ།",
    "དྲེ་ལས་གནས་པ་ལ་སྟོགས་པའི་ཚིག་དྟོན་གིས་སྟོང་པར་གྲུབ་ལ།",
    "གནས་པ་དང་སྲེ་བ་དང་འཇིག་པ་དང་བལ་བའི་དངྟོས་པྟོ་རྣམས་རང་གི་མཚན་཈ིད་ཡྟོད་པར་ག་ལ་འགྱུར་ཞྲེས་བ་སྲེ།",
    "དྲེ་སྲེད་པས་ཡྟོད་པར་འགྱུར་གི།",
    "འྟོན་ཀང་གང་གིས་རྒྱུ་རྲེན་གི་ཚོགས་པ་཈ྲེ་བ་ལས་མ་སྲེས་པ་དྲེ་཈ིད་བསྲེད་པར་བ་བའྟོ་ཞྲེ་ན།",
    "དྲེ་སུ་ཞིག་གི་རྒྱུ་དང་རྲེན་གང་གིས་བསྲེད་པར་བ་བའི་འྟོ།",
    "སར་ཡང་སུ་ཞིག་གིས་བསྲེད་པར་བ་ན།",
    "གང་དྲེའི་རྒྱུ་དང་རྲེན་གིས་སྟོ་ཞྲེས་བརྟོད་པ་ན་ཕན་ཚུན་བརྲེན་པ་ཐྟོབ་པར་འགྱུར་ན་ཕན་ཚུན་དག་མ་གྲུབ་པས་ག་཈ི་ག་ཡང་མྲེད་པའི་ཕྱིར་མ་སྲེས་པ་བསྲེད་བ་མིན།",
    "དང་པྟོའི་མཐའ་ཅན་གི་གཏན་ཚིགས་སུ་བསན་པའི་ཕྱིར་དངྟོས་པྟོ་གཅིག་ལ་སྲེས་པ་དང་མ་སྲེས་པ་དུས་གཅིག་པ་མི་སིད་དྟོ་ཞྲེས་བ་སྲེ།",
    "གང་གི་ཚེ་དྲེ་ལྟར་སྲེས་པ་བསྲེད་བ་མ་ཡིན་ལ་མ་སྲེས་པ་ཡང་བསྲེད་བ་མ་ཡིན་ཞིང་སྲེས་པ་དང་མ་སྲེས་པའི་སྲེ་བཞིན་པ་ཡང་བསྲེད་བ་མ་ཡིན་པས།",
    "གང་གི་ཚེ་བསྲེད་པ་ཞྲེས་བ་བ་དྲེ་ལ་མི་སིད་པ་དྲེའི་ཚེ་སྲེ་བ་མྲེད་དྟོ་ཞྲེས་བ་བ་གྲུབ་བྟོ།",
    "འདིར་ཡྟོད་བཞིན་པའི་མ་཈མ་པའི་ས་བྟོན་དང་ལྕགས་སྲེག་གི་གྟོང་བུ་ལ་སྟོགས་པ་ལ།",
    "གཞན་དུ་གལ་ཏྲེ་འབས་ལྡན་གི་སས་ཁྱད་པར་དུ་བས་པར་མ་གྱུར་ན།",
    "རྒྱུའི་རྟོད་བྲེད་ལ་འབས་ལྡན་གི་སའི་དྟོན་མ་ཚང་བར་འགྱུར་རྟོ།",
    "ཞྲེས་བརྟོད་པའི་ཤུགས་ལས་དྟོན་གིས་ཐྟོབ་ན།"
  ]
}