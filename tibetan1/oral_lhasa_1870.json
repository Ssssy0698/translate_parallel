    "རྡོ་ཕ་ཝང་གསད་ོཔར་འདོད་པས།",
    "ཀྵི་རི་ཀ་ན་ཏའི་ལོ་མས་ཉི་མ་ལ་ལན་བདུན་བདུག་པར་བྱའོ།",
    "དངུལ་སྦྱང་བར་༩འདོད་པས་ནི་ར་བ་སིའི་ཁུ་བས་ལན་བདུན་གྱི་བར་དུ་ལྕགས་བཞིན་དུ་གསད་པར་བྱའོ།",
    "ཇི་ལྟར་དངུལ་ཆུ་གསད་ཾཔ་བཞིན་དུ་བི་མ་ལ་ཡང་གསད་པར་བྱའོ།",
    "གོང་བུའི་རྫས་ནི་ཞིབ་པར་བརྡུངས་། གུ་གུལ་དག་དང་རབ་ཏུ་སྦྱར།",
    "དེ་དག་སྦྱོར་བ་དེ་ལྟར་བྱས་པས་ཁྲུས་ཀྱི་ཆོ་གའི་སྦྱོར་བའི་རྣམ་པ་ཡིན།",
    "དྲི་སྦྱར་བའི་མིག་མངས་རིས་ཀྱི་སྦྱོར་བ་ཚིག་ལེའུར་བྱས་པ་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་མཛད་པ་རྫོགས་སོ།",
    "རྣམ་གྲངས་རྒྱས་པར་རབ་བརྗོད་ན།",
    "༩༤༣བའི་རྣམ་པ་ཐམས་ཅད་ལ་དྲིའི་འདུ་འཕྲོད་སྣ་མཐུན་པར་སྦྱར་བ་དང་།",
    "གཞག་པ་གོ་རིམས་ཀྱིས་ངེས་པར་བསྟན་པ་ཡིན་ནོ།",
    "ལུས་མཆོག་མ་ཞེས་བྱ་བ་ནི་སྙན་༤པར་བོད་པའི་ཚིག་གོ།",
    "སྔ་མ་ནི་སྦྱོར་བ་རྣམ་པ་ཐམས་ཅད་ཀྱི་སྤྱིའི་ཆ་གྲངས་མཉམ་པར་གཏན་ལ་དབབ་པའི་ཕྱིར།",
    "འདིས་སྤོས་སྣ་བཞི་པའི་སྦྱོར་བ་རྣམ་པ་ཉི་ཤུ་ཡོད་པར་རིག་པར་བྱའོ།",
    "ཀུན་ཏུ་རུ་བཞི་པོ་རྣམས་གཞག་པ་བྱས་ན་ཆ་བཅོ་བརྒྱད་ཡོད་པའི་སྤོས་སྣ་བཞི་པོའི་སྦྱོར་བ་རྣམ་པ་ཉི་ཤུར་འགྱུར་ཏེ།",
    "དེ་ལྟར་སྤོས་ཀྱི་སྦྱོར་བ་རྣམ་པ་ཉི་ཤུ་པོ་དེ་དག་ལས་གང་ཡང་རུང་བ་གཅིག་སྦྱོར་བར་འདོད་ན་སྤོས་སྣ་བཞི་པོ་ཆ་བཅོ་བརྒྱད་པོར་བྱས་པ་རྣམས་ཕྱེ་མར་བཏགས་ལ།",
    "ཕྱེ་མར་བཏགས་པས་གདབ་ཅིང་འདྲེས་ཾཔར་བྱའོ།",
    "ལྡེ་ཾགུ་བྱས་ལ་རྗེའུ་གསར་བའི་ནང་དུ་ངོས་ལ་བྱུགས་ཏེ་ཅུང་ཟད་མ་སྐམས་པར་བྱས་ལ།",
    "སྤོས་ཀྱི་དུད་པ་འཐུལ་བར་བྱས་པའི་སྟེང་དུ་ཁ་སྦུབ་ཏུ་བཞག་ཅིང་དུད་པ་གཞན་དུ་མ་ཤོར་བར་བདུག་གོ།",
    "འདི་རྣམས་ཆ་བསྙམས་པ་ཕྱེ་མར་བཏགས་ེཔ་བུ་རམ་ཉིད་ཀྱིས་སྦྲུས་པ་དེས་བདུག་པར་བྱའོ།",
    "ཕྱི་མའི་སྤོས་སྣ་བཞི་པོ་འདི་ཉིད་ཆུ་ཐབས་སུ་བྱས་ཏེ་བྱུག་པའི་གོར་ཡང་སྤྱད་པར་བྱའོ།",
    "འབྲས་བུ་མི་བཟད་པ་སྐྱེད་པའམ་ཡང་ན་འབྲས་བུ་མེད་པའི་ཕྱིར་དེར་བྱ་བ་བརྩམ་པར་མ་གསུངས་སོ།",
    "ཚེས་བཅུ་གཅིག་པ་ལ་རྣམ་པར་ཤེས་པའོ།",
    "ཚེས་བཅུ་གཉིས་པ་ལ་རྣམ་པར་ཤེས་པའོ།",
    "དཔྱིད་ཟླ་ར་བའི་ཚེས་གཅིག་ལ་རྣམ་པར་ཤེས་པའོ།",
    "ཚེས་གཉིས་པ་ལ་རྣམ་པར་ཤེས་པའོ།",
    "ཚེས་གསུམ་པ་ལ་རྣམ་པར་ཤེས་པའོ།",
    "ཚེས་ལྔ་པ་ལ་རྣམ་པར་ཤེས་པའོ།",
    "ཚེས་དྲུག་པ་ལ་རྣམ་པར་ཤེས་པའོ།",
    "ཚེས་བརྒྱད་པ་ལ་རྣམ་པར་ཤེས་པའོ།",
    "ཚེས་དགུ་པ་ལ་རྣམ་པར་ཤེས་པའོ།",
    "ཚེས་བཅུ་པ་ལ་རྣམ་པར་ཤེས་པའོ།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་སྐྱེས་པའི་བུ་ནི།",
    "ཕྲག་དོག་ཅན་དང་ནོར་དང་ལྡན་པར་འགྱུར་ཏེ།",
    "ཁྲུས་བྱས་ན་དགའ་བ་དང་།",
    "ཁྲུས་བྱས་ན་འདོད་པའི་གོས་ཐོབ་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་བྱ་བའི་ལས་རྣམས་ནི།",
    "ཁྲུས་བྱས་ན་སྐྲག་པ་དང་།",
    "མིང་དང་གཟུགས་ཀྱི་ཉི་མ་ལ་བྱ་བའི་ལས་རྣམས་ནི་འབྲོས་པར་བྱ་བ་དང་།",
    "ཁྲུས་བྱས་ན་གཉེན་རྣམས་སྐྲག་པ་དང་།",
    "གོས་གསར་པ་བགོས་ན་དགའ་བར་འགྱུར་ཞིང་མྱུར་བར་ཟད་པར་འགྱུར་རོ།",
    "ཁྱིམ་དུ་འཇུག་པར་བྱ་བ་དང་།",
    "ནོར་དང་འབྲུ་དང་རྫས་བསགས་པར་བྱ་བ་རྣམས་མ་ཐོགས་ཤིང་མྱུར་བ་དང་།",
    "ཁྲུས་བྱས་ན་འཇིགས་པ་ཆེ་བ་དང་།",
    "སྨད་འཚོང་མ་དང་འགྲོགས་པ་དང་གྲོགས་པོ་བྱ་བ་དང་ལས་ཐམས་ཅད་འགྲུབ་པ་དང་སྨྲང་སྤང་བར་བྱ་བ་དང་མགོ་བཀྲུས་ན་བཟའ་བ་དང་བཏུང་བའི་དགའ་སྟོན་དང་ཁྲུས་བྱས་ན་བཟང་བ་དང་གོས་གསར་པ་བགོས་ན་བཟང་པོར་འགྱུར་བ་དང་ཉི་མ་དེ་ལ་གོས་བགོ་བར་བྱའོ།",
    "མགུ་བ་དང་ཁྲུས་བྱས་ན་དགའ་བར་འགྱུར་བ་དང་གོས་སར་པ་བགོས་ན་ཡུན་དུ་མི་འཆང་བར་འགྱུར་ཏེ།",
    "ལས་ཆེན་པོ་བྱ་བ་དང་ཕྱུག་པོའི་ནོར་འཕྲོག་པར་བྱ་བ་དང་།",
    "ཁྲུས་བྱས་ན་ན་བར་འགྱུར་བ་དང་བགོས་ན་ཡུན་དུ་མི་འཆང་བར་འགྱུར་རོ།",
    "མ་རིག་པའི་ཉི་མ་ལ་ཤར་ཕྱོགས་སུ་འགྲོ་ན་ལེགས་པར་འོང་ངོ།",
    "འདུ་བྱེད་ཀྱི་ཉི་མ་ལ་ཤར་གྱི་ཕྱོགས་སུ་འགྲོ་ན་དོན་རྙེད་ཅིང་ལེགས་པར་འོང་ངོ།",
    "ལྷོའི་ཕྱོགས་སུ་འགྲོ་ན་བདེ་ཞིང་སྐྱིད་པར་འོང་ངོ།",
    "ནུབ་ཀྱི་ཕྱོགས་སུ་འགྲོ་ན་ཀུ་ཅོ་དང་ཕྲ་མ་དང་ཕྲད་པར་འགྱུར་རོ།",
    "༩༥༩ན་དཔལ་ཆེན་པོ་དང་ཕྲད་པར་འགྱུར་རོ།",
    "ལྷོའི་ཕྱོགས་སུ་འགྲོ་ན་བསམ་པ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
    "ནུབ་ཕྱོགས་སུ་འགྲོ་ན་བསམ་པ་ཡོངས་སུ་རྫོགས་པ་དང་དགོས་པ་འགྲུབ་པར་འགྱུར་རོ།",
    "ནུབ་ཀྱི་ཕྱོགས་སུ་འགྲོ་ན་ཀུ་ཅོ་དང་སྐྲག་པ་ཆེན་པོ་དང་ཕྲད་པར་འགྱུར་རོ།",
    "བྱང་ཕྱོགས་སུ་འགྲོ་ན་དོན་འཕེལ་བར་འགྱུར་ཞིང་དུས་རིང་པོ་ནས་ལྡོག་པར་འགྱུར་རོ།",
    "ཚོར་བའི་ཉི་མ་ལ་ཤར་ཕྱོགས་སུ་འགྲོ་ན་མགུ་བ་དང་སྔོན་གྱི་མྱ་ངན་སངས་པར་འགྱུར་རོ།",
    "ནུབ་ཕྱོགས་སུ་འགྲོ་ན་ཤི་བའི་སྒྲ་ཐོས་པར་འགྱུར་རོ།",
    "བྱང་ཕྱོགས་སུ་འགྲོ་ན་ཡིད་བདེ་བ་དང་སྒྲ་སྙན་པ་ཐོས་པར་འགྱུར་རོ།",
    "སྲེད་པའི་ཉི་མ་ལ་ཤར་ཕྱོགས་སུ་འགྲོ་ན་གོས་རྙེད་པར་འགྱུར་རོ།",
    "མྱ་ངན་ཅུང་ཟད་དང་ལེགས་པར་འོང་བར་འགྱུར་རོ།",
    "ནུབ་ཀྱི་ཕྱོགས་སུ་འགྲོ་ན་ཤི་བའི་སྒྲ་ཐོས་པར་འགྱུར་རོ།",
    "བྱང་ཕྱོགས་སུ་འགྲོ་ན་བདེ་བ་དང་ཡིད་བདེ་བར་ལྡོག་པར་འགྱུར་རོ།",
    "ནུབ་ཕྱོགས་སུ་འགྲོ་ན་ཅུང་ཟད་འཇིགས་པར་འགྱུར་རོ།",
    "༣༡༨བསམ་པ་ཡོངས་སུ་རྫོགས་པ་དང་བདེ་བར་ལྡོག་པར་འགྱུར་རོ།",
    "ནུབ་ཕྱོགས་སུ་འགྲོ་ན་ཅུང་ཟད་འཇིགས་པར་འགྱུར་རོ།",
    "བྱང་ཕྱོགས་སུ་འགྲོ་ན་བསམ་པ་ཡོངས་སུ་རྫོགས་པ་དང་བདེ་བར་ལྡོག་པར་འགྱུར་རོ།",
    "ལྷོ་ཕྱོགས་སུ་འགྲོ་ན་ལེགས་པར་འོང་བ་དང་ཡིད་བདེ་བ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
    "ནུབ་ཀྱི་ཕྱོགས་སུ་འགྲོ་ན་དོན་བྱས་པ་དང་ཡིད་བདེ་བར་ལྡོག་པར་འགྱུར་རོ།",
    "བྱང་ཕྱོགས་སུ་འགྲོ་ན་དོན་རྙེད་པ་དང་བདེ་བར་ལྡོག་པར་འགྱུར་རོ།",
    "སྐྱེ་བའི་ཉི་མ་ལ་ཤར་ཕྱོགས་སུ་འགྲོ་ན་དོན་རབ་ཏུ་རྙེད་པ་དང་དེ་ལྟར་འཇིགས་པར་འགྱུར་རོ།",
    "ལྷོ་ཕྱོགས་སུ་འགྲོ་ན་བཟང་བར་འགྱུར་བ་དང་སྒྲ་སྙན་པ་དང་ཐོས་པར་འགྱུར་རོ།",
    "བྱང་ཕྱོགས་སུ་འགྲོ་ན་དོན་རྙེད་པར་འགྱུར་རོ།",
    "རྒ་ཤིའི་ཉི་མ་ལ་ཤར་ཕྱོགས་སུ་འགྲོ་ན་མྱུར་དུ་སླར་ལྡོག་པར་འགྱུར་རོ།",
    "ལྷོ་ཕྱོགས་སུ་འགྲོ་ན་ཚིག་སྙན་པ་ཐོས་པར་འགྱུར་རོ།",
    "ནུབ་ཕྱོགས་སུ་འགྲོ་ན་སྐྲག་པར་འགྱུར་རོ།",
    "ཉི་མ་དགུ་པ་ལ་ངེས་པར་རྙེད་པར་འགྱུར་རོ།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་ནོར་སྟོར་ན།",
    "ཉི་མ་ཉི་ཤུ་རྩ་གཅིག་ན་རྙེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་ཉི་མ་གཉིས་པ་ལ་མ་རྙེད་ན་ཕྱིས་རྙེད་པར་མི་འགྱུར་རོ།",
    "འགའ་དང་རྩོད་པས་དེས་སྟོན་པར་བྱེད་དེ་རྫས་དེ་ངེས་པར་རྙེད་པར་འགྱུར་རོ།",
    "༢༡༨༩༦༢ངེས་པར་རྙེད་པར་འགྱུར་རོ།",
    "སྲིད་པའི་ཉི་མ་ལ་ནོར་སྟོར་ན་རྐུན་མ་དེ་ཤར་ཕྱོགས་ནས་འོངས་པ་སྟེ་ཅུང་ཟད་བཟོད་པར་མི་ནུས་པ་སྤྱད་པ་བློ་ཟླ་བོ་གཞན་ལ་མི་སྟོན་པ་དེའི་གཉེན་གྱིས་སྟོན་པར་བྱེད་དོ།",
    "གལ་ཏེ་ནན་གྱིས་བཙལ་དེ་ཡུན་མི་རིང་བར་རྙེད་པར་འགྱུར་རོ།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་ན་བར་གྱུར་ན་ཉི་མ་ལྔ་པ་དང་བརྒྱད་པ་ལ་མ་ཤི་ན།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་གོས་རྙེད་དོ།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་རྩོད་པ་འབྱུང་ངོ།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་རྣ་བ་གཡས་པ་ངུ་ན་ཤིན་ཏུ་མགུ་བ་ཐོབ་པོ།",
    "རྣ་བ་གཡོན་པ་ངུ་ན་ཤི་བ་ཐོས་པར་འགྱུར་རོ་། ལེན་པའི་ཉི་མ་ལ་རྣ་བ་གཡས་པ་ངུ་ན་འགའ་ཞིག་དབུགས་འབྱིན་ནོ།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་སྒྲ་གྲག་ན་བཟང་ངོ།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་འགུལ་ན་མགྲོན་པོ་འོང་ངོ།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་ལྟོགས་ན་འཇིགས་པ་འབྱུང་ངོ།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་སྦྲིད་ན་འདྲི་བ་འོང་ངོ།",
    "གོས་ཚིག་ན་དོན་ཉམས་པར་འགྱུར་རོ།",
    "གོས་ལ་སྣུམ་འབག་ན་གོས་རྙེད་པར་འགྱུར་རོ།",
    "རྣམ་པར་ཤེས་པའི་ཉི་མ་ལ་རྐང་པའི་སྒྲ་གྲག་ན་གཞན་མུ་སྟེགས་འོང་ངོ།",
    "གོས་ཚིག་ན་ནོར་ཅུང་ཟད་རྙེད་པར་འགྱུར་རོ།",
    "བྱ་རོག་སྐད་སྒྲོག་ན་སྡུག་པ་དང་ཕྲད་པར་འགྱུར་རོ།",
    "བྱ་རོག་སྐད་སྒྲོག་ན་སྐྲག་པར་འགྱུར་རོ།",
    "ཚོར་བའི་ཉི་མ་ལ་རྐང་པ་ནས་སྒྲ་གྲག་ན་དོན་དང་དོན་མེད་པ་གཉིས་དང་ཕྲད་པར་འགྱུར་རོ།",
    "བྱ་རོག་སྐད་སྒྲོག་ན་དོན་མེད་པར་འགྱུར་རོ།",
    "བྱི་བས་གོས་ཟོས་ན་གོས་ཆེན་པོ་རྙེད་པར་འགྱུར་རོ།",
    "གོས་ལ་སྣུམ་གྱིས་གོས་ན་ཚིམ་པར་འགྱུར་རོ།",
    "ས་གཡོས་ན་དཔོན་པོའི་ལས་གཞན་གྱིས་སུན་འདོན་པའམ་དགྲས་ཡུལ་འཇོམས་པར་འགྱུར་རོ།",
    "ཐོབ་པར་འདིར་ནི་སོམ་ཉི་མེད།",
    "བྱ་བ་གྲུབ་པར་རྣམ་པར་བསྟན།",
    "སྙན་པར་བརྗོད་པར་འགྱུར་བ་དང་།",
    "ཐམས་ཅད་འབྲས་བུ་མེད་པར་འགྱུར།",
    "དེ་ལ་མཚན་མ་རྣམ་པར་བསྟན།",
    "ཇི་ལྟར་འདི་ནི་ལེགས་པར་གནས།",
    "དེ་ཡི་འབྲས་བུ་ཐོབ་པར་འགྱུར།",
    "དེ་ཡི་དོན་ནི་སྤང་བར་བྱ་སེང་གེས་ངེས་པར་དོན་འགྲུབ་ཅིང་།",
    "ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས། ། ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པཞེས་བྱ་བའི་གཙུག་ལག།",
    "རིགས་ཅིཔ་དེ་ནི་ཐོབ་པར་འཚལ།",
    "ས་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས་༩༧༧གཡོ་བ་ཡི་འབྲས་བུ་དང་།",
    "དེ་དག་ཐམས་ཅད་མ་ལུས་པར།",
    "བདེ་སྡུག་ངེས་པར་རྟོགས་བྱེད་པ།",
    "ཡུལ་རྣམས་ཀྱང་འཁྲུག་པར་འགྱུར་ཏེ།",
    "ཡང་དུས་མཚམས་མ་ཡིན་པར་ཉི་མ་དང་ཟླ་བ་གཟས་ཟིན་པར་གྱུར་ན།",
    "དེ་ཡང་ངེས་པར་རྒྱལ་པོ་འཇིགས་པར་རིག་པར་བྱའོ།",
    "ཕན་ཚུན་དུ་གསོད་པར་འགྱུར་རོ།",
    "གཡོ་བར་གྱུར་པ་དེའི་ཚེ་རྒྱལ་པོ་གསོད་པར་འགྱུར་རོ།",
    "རྩུབ་པར་གྱུར་པ་དེའི་ཚེ་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "རྩུབ་ཅིང་ཉམས་པར་གྱུར་པ་དེའི་ཚེ་འཆར་བ་མེད་པར་འགྱུར་ཞིང་།",
    "དཀྱིལ་འཁོར་ཆུང་བར་གྱུར་པ་དེའི་ཚེ་ན་འཕྲལ་འཕྲལ་དུ་ཆར་པ་འབབ་པར་འགྱུར་རོ།",
    "གཟའ་རྣམས་ཀྱི་ཡང་ཟིལ་གྱིས་ནོན་པར་འགྱུར་རོལ།",
    "གཟའ་རྣམས་ཕན་ཚུན་དུ་མཐོ་ཞིང་ཞུམ་པར་ཡང་གྱུར་པ་དེ་ནིལུས་ཅན་རྣམས་ཤིན་ཏུ་མནར་བར་འགྱུར་བར་བསྟན་ཏོ།",
    "ནབ་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས་༩༨༡སོ་དང་།",
    "ཁྲོན་པ་རྣམས་ཀྱི་ཆུ་ཡང་སྐེམ་པར་བྱེད་པ་སྟེ།",
    "ཡུལ་པར་བར་དང་།",
    "ལུས་འཕགས་དག་ཀྱང་ཉེན་པར་འགྱུར།",
    "རྒྱལ་པོ་རྣམས་ལ་ཡང་དམག་འདྲེན་པར་འགྱུར་ཞིང་།",
    "དྭགས་དག་ཀྱང་འཇིགས་པ་མེད་པར་ཡང་སྐྲག་ཅིང་འདྲོག་པ་དང་།",
    "༢༡༨༩༨༢བསླད་ཅིང་ཕན་ཚུན་ཐོབ་པར་འགྱུར་རོ།",
    "ནམས་བྱ་བར་བརྩམས་ཤིང་བསམ་པ་ཐམས་ཅད་ཀྱང་འགྲུབ་པར་མི་འགྱུར་ལ།",
    "སྐྱེ་དགུ་རྣམས་ཀྱང་ཕན་ཚུན་དགའ་བ་དག་བྱེད་ནས་མི་མཐུན་པར་ཡང་འགྱུར་ཞིང་ཉིན་མཚན་དུ་ཕྱོགས་རྣམས་སུ་གནས་མེ་ཞི་བར་ཡང་མི་འགྱུར།",
    "སྤྲིན་ཡང་ཆར་པ་འབེབས་པར་མི་འགྱུར།",
    "དེ་བཞིན་དུ་འདོད་འཇོ་དག་ཀྱང་འོ་མ་མེད་པར་འགྱུར་བ་དང་།",
    "ལྟེང་ཀ་ལ་སོགས་པ་ཡང་སྐམ་པར་འགྱུར་ཞིང་།",
    "ཡུལ་འཁྲུག་པར་ཡང་འགྱུར།",
    "རི་དྭགས་རྣམས་ཀྱང་འདྲེན་པར་འགྱུར།",
    "བདེན་བྲལ་གྱི་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས་༩༨༣ལྷ་དང་།",
    "བ་འོ་མ་མང་བ་ཉིད་དུ་ཡང་ཤེས་པར་བྱའོ།",
    "སྐྱེད་ཀྱིས་འཚོ་བ་ཐམས་ཅད་ཀྱིས་ཀྱང་རྙེད་པའི་མཆོག་རྙེད་པར་འགྱུར་ཞིང་།",
    "མཆོད་སྦྱིན་གྱི་བྱ་བ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་ཞིང་།",
    "རིག་ིཔར་བྱེད་པའི་རྒྱལ་པོ་ཐམས་ཅད་ཀྱང་ས་སྲུང་བར་བྱེད་པར་འགྱུར་བ་དང་།",
    "འབྲས་བུ་སྨིན་པར་བྱེད་པ་དང་།",
    "སྤྲིན་རྣམས་དོན་མེད་པར་མ་ཡིན་ཏེ།",
    "ས་གཞིར་ཆར་པ་ལེགས་པར་འབབ་པར་འགྱུར་བ་དང་།",
    "མི་རྣམས་ཀྱི་བྱ་བ་ཇི་ལྟར་བརྩམས་པ་རྣམས་ཀྱང་ཕལ་ཆེར་གྲུབ་པར་འགྱུར་ཞིང་ལུས་ཅན་རྣམས་ལ་ཡང་གནོད་པ་བྱེད་པ་རྣམས་དང་།",
    "བ་ལ་སོགས་པ་རྣམས་ཀྱང་ཡང་དག་པར་འཇིག་པར་འགྱུར་རོ།",
    "སྐར་མདའི་ལྟས་ལ་སྐར་མདའ་འདི་དག་ནི་དེ་དག་ནི་མཚན་མ་བསྟན་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "འཇིག་རྟེན་དག་ན་རྟགས་སྟོན་པར་བྱེད་པ་སྟེ།",
    "རྩུབ་པ་ནི་འཇིགས་པར་བྱེད་པ་རྣམས་དང་།",
    "ས་སྟེངས་སུ་ལྷུང་ཞིང་བཟློག་ཕྱོགས་སུ་འགྲོ་བར་འགྱུར་ེན་ཡུལ་དེར་ཞི་བ་མ་ཡིན་པར་འགྱུར་རོ།",
    "གནོད་པར་གྱུར་པའི་ཡུལ་དག་ཏུ་དམག་འགྱེད་དུ་འཇུག་པ་ིཡང་བྱེད་པར་འགྱུར་རོ།",
    "དེའི་འོག་ཏུ་རང་བཞིན་གྱིས་དམག་ཁོ་ནས་འཇིག་རྟེན་རྣམས་འཆི་བར་བྱེད་པར་འགྱུར་རོ།",
    "དེ་དག་ལྷུང་བ་དག་རྗེས་སུ་མཚན་ཉིད་ཡང་དག་པར་རབ་ཏུ་བརྗོད་པར་བྱ་སྟེ།",
    "སྣ་ཚོགས་༢༡༨འཐུལ་བ་དག་ཏུ་ལྷུང་བ་དེར་ནི་རྒྱལ་པོ་ལ་གནོད་པར་འགྱུར་རོ།",
    "གང་དུ་སྐར་མདའ་ཉི་མ་ལ་མངོན་དུ་ཕྱོགས་ཏེ་ལྷུང་བ་ནི་ཤིན་ཏུ་འཇིགས་པར་བྱེད་པར་འགྱུར་རོ་།",
    "འི་ཚེ་རྒྱལ་པོ་ལ་ཡང་གནོད་པར་འགྱུར་རོ།",
    "གང་དུ་སྐར་མདར་ལྷུང་ཞིང་གཟའ་མིག་དམར་ལ་གནོད་པ་བྱེད་པ་དེར་ནི་དམག་དཔོན་གསོད་པར་འགྱུར་ཞིང་།",
    "གལ་ཏེ་སྐར་མདའ་འབབ་པ་ཉི་མའི་བུ་སྤེན་པ་ལ་གནོད་པར་བྱེད་པ་དེར་ནི་སྣ་བོའི་གཙོ་བོ་དང་།",
    "མཚོན་གྱིས་ིའཚེ་བ་ཡང་རབ་ཏུ་ཟད་པར་བྱེད་པར་འགྱུར།",
    "སྐར་མདའ་རྟའི་དབྱིབས་ལྟ་བུ་ནི་རྒྱལ་པོའི་དམག་ལ་གནོད་པར་འགྱུར་རོ།",
    "ཁ་ཊཱཾ་གའི་དབྱིབས་ལྟ་བུ་ནི་ཡུལ་དང་རྒྱལ་པོར་བཅས་པ་ལ་གནོད་པར་འགྱུར་རོ།",
    "རྒྱལ་པོ་དང་བཅས་པ་ལ་གནོད་པར་འགྱུར་རོ།",
    "སྣ་ཚོགས་༢༡༨༩༨༨རྒྱལ་པོ་གསོད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་མཆོད་སྦྱིན་གྱི་ལས་རྣམས་འཇིགས་པར་འགྱུར་རོ།",
    "ཟླ་བའི་འོད་ཟེར་ལྟར་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས་༩༨༩དཀར་བ་དང་།",
    "ཤེལ་ལྟ་བུར་གྱུར་ན་ནི་ལོ་ལེགས་པར་འགྱུར་རོ།",
    "གསེར་གྱི་འོད་ལྟ་བུར་གྱུར་ན་ནི་མེས་འཁྲུག་པར་འགྱུར་རོ།",
    "འདི་སྐད་དུ་གང་བསྟན་པ་ནི་ཟླ་བ་གཉིས་མ་ལུས་པར་དེའི་རྣམ་པར་སྨིན་པར་འགྱུར་བར་བརྗོད་དོ།",
    "མུ་གེ་ཡང་སྟོན་པར་བྱེད་དོ།",
    "འདམ་རྫབ་ཅན་མི་བཟད་པ་འབྱུང་ལ་ལོ་ཏོག་ཀྱང་ཆུད་ཟོས་པར་འགྱུར་ཞིང་ཆོམ་རྐུན་དག་ཀྱང་འཕེལ་བར་འགྱུར་རོ།",
    "ནམ་མཁའ་ལ་སྤྲིན་མེད་པར་འབྲུག་ཟེར་བ་དང་།",
    "སྐར་མདའ་དག་ཀྱང་ལྷུང་བར་གྱུར་ན་དེར་ལོ་གཅིག་ཚུན་ཆད་དུ་འཇིག་རྟེན་ཀུན་དུ་ཟད་པར་འགྱུར་བར་རིག་པར་བྱ་ཞིང་།",
    "རྟ་བྲེས་དང་གླང་པོ་ཆེའི་བྲེས་སུ་བབ་ན་དེའི་སྲུང་མ་ངེས་པར་འཇིགས་ཬཔར་འགྱུར་རོ།",
    "ཡུལ་འཁོར་དང་བཅས་པ་འཇིགས་པར་བྱེད་པའོ།",
    "ཡུལ་འཁོར་འཇིག་པར་འགྱུར་བར་རིག་པར་བྱའོ།",
    "ཆར་པ་འབབ་པར་འགྱུར་ཞིང་ལོ་ལེགས་པ་དང་།",
    "དེ་བཞིན་དུ་ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "འཇིག་རྟེན་ལ་གནོད་པར་བྱེད་པ་སྤྱང་ཀི་དང་།",
    "བྱི་བ་དང་བྱེ་བ་ལ་སོགས་པ་དག་ཀྱང་ཀུན་ནས་འབབ་པར་འགྱུར་རོ།",
    "འབྲུག་སྒྲ་ཡང་ིིིགྲག་པ་དེའི་ཚེ་ནི་ཆར་པ་ཆེན་པོ་འབབ་པར་འགྱུར་ཞིང་།",
    "རྒྱལ་པོ་རྣམ་པར་རྒྱལ་བ་དང་།",
    "ཐུབ་པ་ཆེན་པོ་དྲང་སྲོང་གར་གས་ལྟས་ཀྱི་རྣམ་པ་བསྟན་པ་བཞུགས།",
    "དེ་བཞིན་དུ་བ་ལང་རྫིའི་གནས་དེར་རབ་ཏུ་འཇིག་པར་འགྱུར་རོ།",
    "སྐྲ་ཤད་ལ་སོགས་པས་མངོན་དུ་གང་བ་དེ་དག་ཏུ་ནི་ངེས་པར་ཉེ་འཁོར་གྱི་སྐྱེ་བོའི་སྐལ་བ་ཟད་པའི་ལྟས་སུ་བསྟན་པ་ཡིན་ནོ།",
