    "དྲིལ་བུས་ཧོ་མདུན་གྱི་ནམ་མཁར་ཆར་བབ་པ་བཞིན་དུ་བྱོན་པ་ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ངག་ཡིད་གསུམ་ལ་སིབ་སིབ་ཐིམ་པའི་མོས་པ་གྱིས།",
    "སྤོས་ཀྱིས་བདུག་ཅིང་རོལ་མོ་བསྒྲག།",
    "མཎྜལ་ལ་པདྨ་འདབ་བརྒྱད་སྟེང་ཚོམ་བུ་ལྔའམ་དགུ་བཀོད་པ་དཀྱིལ་འཁོར་ལྷར་མོས་ལ།",
    "གཙོ་བོ་མཆོག་ལ་འཁོར་ཐུན་མོང་།",
    "བདག་གི་མིག་འདི་དབྱེ་རུ་གསོལ།",
    "བུ་ཁྱོད་ཀྱིས་ནི་མི་ཤེས་པའི།",
    "རབ་རིབ་འཇམ་དཔལ་བདག་གིས་བསལ།",
    "དེ་རིང་ཕན་ཆད་བུ་ཁྱོད་ཀྱིས།",
    "རང་བཞིན་ནམ་རྣམ་པ་ནི་རང་བྱུང་གི་ཡེ་ཤེས་ལས་ཕྱག་རྒྱ་ཆེན་པོ་ཟིལ་གྱིས་གནོན་པའི་དཀྱིལ་འཁོར་རྟེན་བརྟེན་པ་དང་བཅས་པར་རང་ཤར་བས་ལྷུན་གྲུབ།",
    "དེ་ལྟར་སྐུ་གསུམ་གྱི་རོལ་པ་རང་རང་གི་དོན་ལ་སྤྱོད་པ་ནི།",
    "ཉོན་མོངས་བག་ཆགས་བྱང་གྱུར་ཅིག།",
    "གཡོན་བརྐྱང་གིས་བཞུགས་པའི་སྤྱི་བོར་ཨོཾ།",
    "ཁྲོ་བོ་དང་ཁྲོ་མོའི་རྒྱལ་མོ་རྣམས་ཀྱིས་བགེགས་སྐྲོད་པའི་མོས་པ་གྱིས།",
    "ཡུམ་ཁྲོས་མ་ན་བཟའ་དཀར་མོ།",
    "རང་བཞིན་གསུང་གི་ལྷ་རུ་གསལ།",
    "ཨོཾ་ཨེ་ཀ་ཡ་མ་བུདྡྷ་ཨ་བྷི་ཥིཉྩ་མཱཾ།",
    "སྐྱེས་པ་བུད་མེད་རིམ་པས་ནི།",
    "ཉོན་མོངས་པ་བཞི་གསང་བའི་གཤེད་བཞི།",
    "སེམས་བྱུང་གི་རྒྱུ་བ་ཞག་དང་ཟ་གཤེད།",
    "གཤེད་དང་མོན་བདུད་ཞག་དང་སྒོ།",
    "སྐུ་གསུང་ཐུགས་ནི་ཉོན་མོངས་དུག་གི་དགྲར།",
    "ཡེ་ཤེས་རང་མདངས་སྲིད་གསུམ་སྲོག་གི་དགྲར།",
    "རྔམས་པའི་མོན་པ་ཕོ་མོ་བཞི་བཞི་དང་།",
    "རབ་འཇིགས་བདུད་བཞི་བདུད་མོ་ནག་མོ་བཞི།",
    "ཕུང་བྱེད་སྦས་པའི་མ་མོ་བཞིས་འཁྱུད་པ།",
    "བདུད་དང་གཤིན་རྗེ་མ་མོ་གནོད་སྦྱིན་ཚོགས།",
    "རྒྱས་འདོད་རེ་རེས་བསྐུར་བ་ཡིན།",
    "སྤྱི་བོར་ཟླ་བའི་སྟེང་དུ་ཨོཾ་དཀར་པོས་རྒྱས་བཏབ་པའི་མོས་པ་གྱིས།",
    "དགྱེས་པ་དཔའ་མོའི་གླུ་དབྱངས་བསྟུན།",
    "ངན་སོང་གསུམ་པོ་ལྟ་བས་བསྒྲལ།",
    "གསུང་གི་དངོས་གྲུབ་ཆེན་པོ་སྩོལ།",
    "ཕྱག་རྒྱ་ཟིལ་གནོན་མཆོག་གི་ལམ།",
    "བདག་གི་ངག་ཐིམ་བསམས་ནས་འདུག།",
    "གསུང་གི་སྔགས་ནི་ལན་གསུམ་བྱིན།",
    "དེ་ནས་རྡོ་རྗེས་མགྲིན་པར་ཐིག་ན་མསྶརྦ་ཏ་ཐཱ་ག་ཏ་ཝཱ་ཀ་བཛྲ་སིདྡྷི་ཨ་བྷི་ཥིཉྩ་ཨཱ་མགྲིན་པར་པདྨ་དམར་པོ་འདབ་མ་བརྒྱད་པ་ལ་ཨཱ་དམར་པོས་རྒྱས་བཏབ་པར་མོས།",
    "ཉོན་མོངས་གཅོད་བྱེད་རལ་གྲི་དང་།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་གིས་མིག་དར་བཅིངས་ལ།",
    "རྡོ་རྗེ་ནོར་བུའི་རྩེ་མོ་ནས་ཡུམ་གྱི་རྩཀཱ་ཀ་མུ་ཁའི་སྒོར་དཀར་དམར་རོ་གཅིག་ཏུ་འདྲེས་པ། རིག་པའི་སྟོབས་ལྡན་སྦྱོར་བའི་མཐུས།",
    "ཨེ་ཀ་ཡ་མ་པྲ་ཏཱིཙྪ་ཧོ་ཡབ་ཀྱི་བྱང་སེམས་དཀར་ཆར་མོས་པའི་ཐོད་ཆང་སྦྱིན།",
    "ཡུམ་གྱི་དམར་ཆར་མོས་པའི་ཐོད་ཆང་ཚར་གཅིག་སྦྱིན།",
    "དེ་ནས་རང་གི་ལྕེ་ཡིས་མྱང་།",
    "ཐལ་ཆེན་ཚོམ་བུ་དཔྲལ་བར་བཏབ།",
    "ཧཱུྃ་ཐལ་ཆེན་ཚོམ་བུ་འདི་བཏབ་པས།",
    "ཧཱུྃ་ཞིང་གི་གཡང་གཞི་ཆེན་པོ་འདི།",
    "སྟག་གི་ཤམ་ཐབས་སྨད་ལ་དཀྲིས།",
    "དེའི་གི་གུ་ན་ར་ཏ་གསུམ་ལས་འོད་དཀར་དམར་མཐིང་ཁ་སྤྲོས།",
    "འོད་ཀྱི་ཐིག་ལེ་གཅིག་ཏུ་གྱུར་པའི་མོས་པ་གྱིས།",
    "ཨྱེ་ཨྱེ་ཨྱེ་ཡ་མ་ནྲྀ་བྷྲཱུཾ་བཛྲ་ཨཱ་ཡུ་ཥེ་ཧཱུྃ་ཛ་ཞེས་པས་ཚེ་གལ་སྤྱི་བོར་བཞག་ཚེ་ཡི་ལྷ་མོ་བདུད་རྩིར་ཞུ་ནས་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་ཞུགས།",
    "འཆི་མེད་ཀྱི་བདུད་རྩིས་ལུས་དཀར་མེར་གྱིས་གང་བའི་མོས་པ་གྱིས།",
    "བྱེད་པ་ངག་གི་སྒྲིབ་པ་དག།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་གིས་མིག་དར་འཆིང་།",
    "བུ་ཁྱོད་སྐལ་པ་རབ་ཏུ་འགྱུར།",
    "ནམ་མཁའ་བར་སྣང་ས་གཞི་ཐམས་ཅད་འོད་ཀྱིས་དམར་ལམ་ལམ་གྱུར་པའི་མོས་པ་གྱིས།",
    "ཕུང་པོ་ཁམས་སྐྱེ་མཆེད་ཀྱི་སྣང་བ་ཐམས་ཅད་སྒྱུ་མ་ལྟ་བུའི་ཡེ་ཤེས་ཀྱི་ལྷའི་རོལ་མོར་སད་པའི་མོས་པ་གྱིས།",
    "ཐམས་ཅད་དཔའ་བོ་དཔའ་མོའི་ཚོགས།",
    "ན་མོ་ཆེ་བའི་ནང་ནས་ཆེ་བའི་མཆོག།",
    "འཇམ་དཔལ་ཕྱག་རྒྱ་ཆེན་པོ་ཟིལ་གྱིས་གནོན་པའི་དཀྱིལ་འཁོར་གྱི་ལྷར་སྐད་ཅིག་གིས་གསལ་བའི་དམ་ཚིག་སེམས་དཔའ་ལ།",
    "ཆང་གི་ཀ་ལི་གཞག་ནས་སུ།",
    "བདག་གི་མཐེབ་མཛུབ་ཟླ་བས་ཟག་དང་འདྲེས།",
    "ཨོཾ་ཨཱ་སརྦ་པཉྩ་ཨ་མྲྀ་ཏ་ཧཱུྃ་ཧྲཱི་ཋ་ཐམས་ཅད་བདུད་རྩིར་སྐྱ་མེར་ཞུ།",
    "ཨེ་ཀ་ཡ་མ་ཨ་དྷི་པ་ཏི་ཏི་ར་སིདྡྷི་ཧོ་གཙང་དམེའི་རྟོག་པ་མེད་པར་མཉམ་ཉིད་ཆེན་པོའི་ངང་དུ་རོལ་པས་ལུས་ཐམས་ཅད་ཟག་པ་མེད་པའི་བདུད་རྩིས་སྐྱ་མེར་གྱིས་གང་བས་བདེ་ཆེན་ལྷུན་གྱིས་གྲུབ་པའི་མཆོག་གི་སྐལ་པ་ཅན་དུ་གྱུར་པའོ།",
    "བརྩོན་འགྲུས་ཅན་ཚེ་གཅིག་གིས་འཚང་རྒྱ་བས།",
    "འཁོར་ལོ་རྐང་འོག་དུང་འབུད་ཅིང་།",
    "ད་ནི་ཁྱོད་ཀྱིས་སློབ་དཔོན་གྱིས།",
    "ཨེ་ཀ་ཧེ་དུན་བྷྱོ་ཟློག་ཡ་མ་རཱ་ཙ་བྷྱོ་ཟློག་མ་མོ་ཨེ་ཀ་ཛ་ཊི་བྷྱོ་ཟློག་མཱ་ར་ཡ་ཟློག་མ་མོ་ཨེ་ཀ་ཛ་ཊི་ཐུན་བྷྱོ་ཟློག་ཕུ་ས་ནཱ་ག་གཏད་ཁྲཾ་བྷྱོ་ཟློག་ཕྱུང་ཕྱུང་།",
    "འབྲུ་ནག་གི་གཏོར་ཆེན་ལྕགས་སྡིག་གཏོར་བཟློག་སྐབས་ཀྱི་ལག་ལེན་བཞིན་འཕང་ནས་བརྟན་སྐྱོང་གཏོར་བྲོའི་བར་དང་།",
    "ཤིང་ཐོག་སོགས་བཟའ་བཏུང་གི་བྱེ་བྲག་སྣ་ཚོགས་པ་བཤམས་ནས།",
    "སོགས་ཀྱིས་བྱིན་དབབ་ཅིང་རོལ་མོ་བྱ།",
