    "མི་ལོ་བཅུའི་རིང་མཛད་འགན་བཞེས་པ་བཅས་ཁྱོན་མི་ལོ་ཉི་ཤུའི་རིང་ཚོགས་གཙོ་དང་བཀའ་ཁྲིའི་མཚན་གནས་ཐོག་ཆེས་ཁྱད་དུ་འཕགས་ཤིང་མཁས་མཛངས་ལྡན་པའི་སྒོ་ནས་མཛད་འགན་བཞེས་ཏེ།",
    "མཛད་པ་ཀུན་གྱི་མཆོག་གསུང་གི་མཛད་པའི་ཕྱག་རྗེས་ཀྱི་སྐོར།",
    "སྐྱེས་མཆོག་དེས་རང་རེ་བོད་འབངས་རྣམས་ཀྱི་ཆེད་དུ་སྐུ་གསུང་ཐུགས་གསུམ་གྱི་མཛད་པ་རླབས་པོ་ཆེ་ཇི་སྙེད་ཅིག་བཀྲིན་བསྐྱངས་ཡོད་པ་ལས།",
    "འདིར་མཛད་པ་ཀུན་གྱི་མཆོག་གསུང་གི་མཛད་པའི་ཕྱག་རྗེས་ཀྱི་སྐྱེས་བཟང་ཁྱད་དུ་འཕགས་པ་ཇི་ལྟར་སྤེལ་ཡོད་སྙམ་ན།",
    "རིགས་ལམ་ཕྲ་མོ་ཕྱེད་པའི་རྣམ་དཔྱོད་དང་།",
    "ཚིག་སྦྱོར་ཚུལ་ལ་མཁས་པའི་ངག་གི་དཔལ།",
    "གཙུག་ལག་སློབ་ཁང་གི་རིགས་གླུ་རྩ་འགྲེལ།",
    "དཔྱད་གསུམ་རྣམ་པར་དག་པའི་རིགས་པའི་ལམ་ནས་ལེགས་པར་དཔྱོད་ཅིང་ངེས་ཤེས་རྣལ་མ་འདྲེན་པར་བྱེད་པའི་རིགས་ལམ་ཕྲ་མོ་ཕྱེད་པའི་རྣམ་དཔྱོད་ཀྱི་མཐུ་ཕུལ་དུ་བྱུང་བ་དང་ལྡན་ཞིང་།",
    "ཕྱོགས་རེ་བ་དང་རགས་པ་རེས་ཚིམས་པ་ཡོངས་སུ་དོར་ཏེ།",
    "ཐུན་མོང་སྣང་ཚོད་ལྟར་གྱི་སྤྱི་སྒོས་ཤེས་བྱའི་གཙུག་ལག་སློབ་ཁང་གི་རིགས་གླུ་རྩ་འགྲེལ།",
    "སྤྱི་བྱེའི་ཤེས་བྱའི་གནས་ལ་གཅིག་ཏུ་བརྩོན་ཞིང་འདུན་པའི་བློ་ལྡན་ཐོས་འདོད་དོན་གཉེར་ཅན་དག་གི་རེ་བའི་སྐོམ་པ་ཡོངས་སུ་སེལ་ནུས་ངེས་ཀྱི་རྨད་དུ་བྱུང་བའི་གསུང་གི་མཛད་པའི་ཕྱག་རྗེས་རྒྱ་ཆེ་ཞིང་རྣམ་གྲངས་མང་དུ་མཆིས་སོ།",
    "ཐོགས་པ་མི་མངའ་བའི་གང་གི་མཁྱེན་རབ་རྣམ་དཔྱོད་ཀྱི་ནུས་རྩལ་ལ་བརྟགས་ན།",
    "གང་གི་གཞན་འགྲན་མ་མཆིས་པའི་ཕུལ་བྱུང་རྣམ་དཔྱོད་ཀྱི་རྩལ་དང་།",
    "དེ་དག་གི་དང་པོ།",
    "དེ་དང་ཕྱོགས་མཚུངས་འདི་གའི་གཙུག་ལག་སློབ་ཁང་ནས་སྤར་བསྐྲུན་ཞུས་པའི་དཔེ་དེབ་བརྒྱ་ཕྲག་བརྒལ་བ་དག་གི་ཞུ་ཆེན་གྱི་ཆེད་བརྗོད་བོད་སྐད་དང་ཧིན་སྐད་ཐོག་བཞུགས་པ་དག་དང་།",
    "གླུ་ཐལ་སྦྱར་མའི་གླེང་བརྗོད།",
    "གཙུག་ལག་སློབ་ཁང་གི་རིགས་གླུ་རྩ་འགྲེལ།",
    "བཀའ་ཤག་གི་གསུང་འཕྲིན་ཇི་སྙེད་ཅིག་དང་།",
    "བོད་ཀྱི་ད་ལྟའི་ཛ་དྲག་གནས་བབ་དང་ང་ཚོའི་ལས་འགན།",
    "བཙན་བྱོལ་བོད་གཞུང་གི་གྲུབ་འབྲས་སྤྱི་དང་བྱེ་བྲག་གི་སྐོར་དང་།",
    "འགི་འི་ཞི་ད་ལྟའི་བོད་ཀྱི་གནས་སྟངས་དང་འབྱུང་འགྱུར་ཇི་ཡོང་སྐོར།",
    "ཀརེཝཱཀ་འདེག་ཆུག་ཤག་བདེ་ཤེ་ཊེ་ཤུ་གེའཚུ་བདེན་པ་ལ་བར་ཆད་འབྱུང་སྲིད་ཀྱང་དེ་ཕམ་མི་སྲིད་པའི་སྐོར།",
    "གཙུག་ལག་སློབ་ཁང་གི་རིགས་གླུ་རྩ་འགྲེལ།",
    "ཞི་བདེའི་ལེགས་བྱང་གི་སྐོར་ལ་ནང་པའི་ཕྱག་རྗེས་སམ་མཐུན་འགྱུར།",
    "རྒྱ་གར་རྒྱ་ཁྱབ་རྒྱལ་ཡོངས་གཙུག་ལག་སློབ་ཁང་གི་འགན་འཛིན་རིགས་བདག་ལྷན་ཚོགས་ཀྱི་ཚོགས་གཙོའི་གསུང་བཤད།",
    "རྩོམ་རིག་གི་སྐོར།",
    "རིག་གཞུང་གི་སྐོར།",
    "སློབ་ཁང་གི་དམིགས་ཡུལ་དང་མ་འོངས་པའི་མདུན་ལམ་སྐོར།",
    "བོད་ཕྲུག་ན་གཞོན་ཚོར་དམིགས་པའི་གང་ཉིད་ཀྱི་ཐུགས་རེ།",
    "གཙུག་ལག་སློབ་ཁང་གི་རིགས་གླུ་རྩ་འགྲེལ།",
    "༧གོང་ས་མཆོག་གི་ཆབ་སྲིད་ཀྱི་ལྟ་གྲུབ་སྐོར།",
    "མོན་གྷོཊ།",
    "བོད་གཞུང་གི་ངོ་སྤྲོད་དང་མི་མང་གི་སྟངས་འཛིན་བྱེད་ཕྱོགས།",
    "དེ་དག་གི་ཁོངས་སུ་མ་འདུས་པ་ཡང་ཇི་སྙེད་ཅིག་ཡོད་པའི་ཕྱིར་རོ།",
    "དེ་དག་ཏུ་མ་ཟད་སྐྱེས་མཆོག་དེའི་གསུང་གི་མཛད་པའི་ཕྱག་རྗེས་ཆེས་གླེང་བརྗོད།",
    "གཙུག་ལག་སློབ་ཁང་གི་རིགས་གླུ་རྩ་འགྲེལ།",
    "བོད་ཀྱི་གྲོས་ཚོགས་དང་སྲིད་བྱུས་ཉམས་ཞིབ་ཁང་གིས་འདོན་སྤེལ་གནང་བའི་དེབ་ཕྲེང་ཁག་བཞི་ལ་ངོ་ཤོག་༣༨ ༧༡ དང་།",
    "སྤར་བསྐྲུན་སོགས་ཀྱི་ལམ་ནས་མང་ཚོགས་ཀྱི་འདུན་སར་སླེབས་ཐུབ་པ་བྱེད་རྒྱུ་དེ་ནི་ཕན་རླབས་དང་དགོས་གལ་ཤིན་ཏུ་ཆེ་བའི་གནས་སུ་མངོན་ནོ།",
    "གཙུག་ལག་སློབ་ཁང་གི་རིགས་གླུ་རྩ་འགྲེལ།",
    "གླུ་དབྱངས་འདིའི་ཐོག་མའི་དབུ་འབྱེད་ལྟ་བུར་གཙུག་ལག་སློབ་ཁང་གི་ངོས་ནས།",
    "གདན་ས་ཁག་གི་གྲྭ་ཚང་སོ་སོའི་ཐུན་མིན་གྱི་འདོན་རྟ་དབྱངས་ཙམ་དུ་མ་ཟད།",
    "༧གོང་ས་༧སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གི་ཆིབས་སྒྱུར་གྱི་སྐབས་མ་གཏོགས་གཏོང་མི་ཆོག་པའི་གླུ་དབྱངས་ཁྱད་པར་ཅན་དེ་འདྲ་ཡང་ཡོད་པར་གསུངས་པ་དེ་དག་གིས་ལེགས་པར་མཚོན་ནུས་སོ།",
    "དེ་བཞིན་སློབ་ཁང་གི་དབུ་འཛིན་ནམ་ཁྲི་པ་ལ་ཀུལ་པ་ཏི་སྟེ་རིགས་བདག་དང་ཉེ་བའི་རིགས་བདག་སོགས་བརྗོད་པར་བྱེད་པས་ཟླས་དྲངས་ཏེ།",
    "སྤོབས་པ་ཁྱད་པར་ཅན་ཞིག་བསྐྲུན་པའི་ཆེད་དུ་བླང་རྒྱུའི་གླུ་དབྱངས་ཤིག་ལ་གཙུག་ལག་སློབ་ཁང་གི་གླུའམ་རིགས་ཀྱི་གླུ་ཞེས་བརྗོད་ཅིང་།",
