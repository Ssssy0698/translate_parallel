    "ཨ་བྱ་ཏ་ནཱི་ནི་བསྒྱུར་ན་སོང་ཟིན་ཞེས་པ་སྟེ་འདས་པ་ཙམ་གྱི་དོན་ལ་སྦྱོར་ཏེ།",
    "དབྱངས་མཐའ་ཅན་རྣམས་ཀྱི་སིཙ་ལ་པ་རསྨེ་ལའོ་ཞེས་པས་ཛིའི་ཨི་ཨེ་རུ་སོང་བའི་འཕེལ་བ་སྟེ།",
    "ཨུ་པ་དྷཱ་ནཱ་མིན་ནའི་ཞེས་པས་བྷུའི་ཨུ་ཨོ་རུ་སོང་བའི་ཡོན་ཏན་ནོ།",
    "སའི་ཥཉིད་དོས་ས་ཥ་རུ་སོང་བ་མཚམས་སྦྱར་བ་ལས་ཁྱོད་བདག་གིས་སྐྱོང་པ་མ་བྱུང་ཞེས་པར་འགྱུར་བ་ལྟ་བུའོ།",
    "སྲོག་གི་རྒྱུན་གྱི་བྱིངས་ཛཱི་བ་ལ་ཨཱ་ཤཱི་ཥའི་རྣམ་དབྱེ་ཡཱཏ་སྦྱིན་ཏེ་མཚམས་སྦྱར་བ་ལས་ཁྱོད་འཚོ་བར་གྱུར་ཅིག།",
    "ཨི་ཨེ་རུ་སོང་བའི་ཡོན་ཏན་མཚམས་སྦྱར་བ་ལས་སང་ཀློག་པར་འགྱུར་ཞེས་པ་ལྟ་བུའོ།",
    "འདོད་པའི་དོན་ལ་རེ་བའི་སེམས་གོ་བར་བྱེད་ལའང་པཉྩམི་རྣམས་སྦྱོར་ཏེ།",
    "ཨགི་ཧོ་ཏྲ་ཛུ་ཕ་ཡཱཏ།",
    "འང་གི་སྒྲས་པཉྩམཱི་ཡང་སྦྱོར་ཏེ།",
    "ན་མིན་མཐའི་ཞེས་པས་ཨུ་ཨོ་རུ་སོང་བ་མཚམས་སྦྱར་བ་ལས་ཁྱོད་རེ་ལྡེ་བྱེད་ཅེས་པ་ལྟ་བུའོ།",
    "སུ་སོགས་ཀྱི་ཐུང་ངུའོས་མྱུའི་ཨུ་ཐུང་དུ་གཉིས་ག་རྣམས་ཀྱི་ཨི་ཡིག་གིས་ནའི་ཨ་ཨཱིའོ།",
    "ན་མོ",
    "ཨོཾ་གུ་རུ་ཨ་ཡུ་སིདྡྷི་ཧཱུྃ་ཧྲཱི་ཨ་མ་ར་ཎི་ཛི་བནྟི་ཡེ་སྭཱ་ཧཱ་ཅི་ནུས་བཟླ",
    "མ་བུ་བདེ་སྲུང་གི་རྒྱུན་ཤེས།",
    "མ་བུ་བདེ་སྲུང་གི་རྒྱུན་ཤེས།",
    "རང་ཉིད་ཀྱི་ཉམས་མྱོང་གིས་ཀྱང་ཟུར་བརྒྱན་པར་བྱས་ཏེ་རྩོམ་སྒྲིག་བྱུང་བའི་དཔེ་དེབ་འདི་ལ་ལྟ་ཚུལ་ཙམ་བརྗོད་ན།",
    "གཅིག་ནས་བུད་མེད་ཀྱི་ལུས་ཁམས་སྐྱེ་ལུགས་དང་།",
    "མ་བུ་བདེ་སྲུང་གི་དགོས་ངེས་རང་བཞིན་ཁ་གསལ་ཞིང་གོ་རིམ་ཡོད་པ།",
    "བར་སྐབས་ཀྱི་གསལ་བྱེད་རི་མོ་དཔེ་དོན་འབྱོར་བ་བཅས་ཡིན་པས་ཁྱབ་བརྡལ་དུ་འགྲོ་བའི་ཆ་རྐྱེན་ཚང་བ།",
    "བཞི་ནས་མིག་སྔར་མ་བུའི་བདེ་སྲུང་སྐོར་ལ་ཆེད་དུ་ཞིབ་འཇུག་བགྱིས་པའི་བོད་ཡིག་གི་དཔེ་དེབ་མ་མཐོང་བས་ཐོག་མའི་སྐྱ་རེངས་ལྟ་བུའི་ནུས་པ་འབྱུང་ཐུབ་པ།",
    "ཕྲུ་གུ་བཙས་རྗེས་ཀྱི་མ་བུ་བདེ་སྲུང་གི་གལ་ཆེན་རང་བཞིན།",
    "ཨ་མའི་ནུ་མར་བདག་སྐྱོང་བྱེད་སྟངས།",
    "བུད་མེད་ཀྱི་མངལ་སྦུབས་སུ་སྐྱི་མོ་སྲབ་མོ་རིམ་པ་ཞིག་ཡོད་པ་དེ་ལ་མངལ་སྐྱི་ཟེར།",
    "བུད་མེད་ནི་ལོ་བཅུ་གཅིག་ནས་བཅུ་གཉིས་ཀྱི་སྔོན་ལ་མངལ་ཇེ་ཆེར་གྱུར་པ་ལས་གཞན་འགྱུར་ལྡོག་ཧ་ཅང་ཆུང་།",
    "ལང་ཚོ་དར་བའི་སྐབས་སུ་མངལ་སྐྱི་དེར་ཟླ་རེར་འགྱུར་ལྡོག་ཐེངས་རེ་འབྱུང་ངེས་ཡིན།",
    "མོ་རྩི་ཟགས་ཐོན་བྱུང་བ་དེ་ཉུང་བ་ནས་མང་བར་འགྱུར་བ་དང་།",
    "མངལ་སྦུབས་ནང་སྐྱིའི་རྒྱུན་འཁྱོངས་ནུས་པ་ཤོར་ཞིང་འཁུམས་ཏེ་རྩ་བ་ནས་ཉམས་པ།",
    "ཟླ་མཚན་ནི་བུད་མེད་ཀྱི་མངལ་ཁྲག་གི་སྙིགས་མ་ཟླ་བ་རེ་རེ་བཞིན་དུས་ལྟར་དུ་མངལ་སྒོ་ནས་འཛག་པར་འགྱུར་བ་སྟེ།",
    "ཟླ་བ་རེ་བཞིན་དཀར་ཕྱོགས་དུས།",
    "བུད་མེད་ལོ་ན་བཅུ་གསུམ་ནས་བཅུ་བཞི་ལོན་རྗེས་རིམ་གྱིས་ཟླ་བ་རེ་རེ་བཞིན་ཟླ་མཚན་འབབ་ལ།",
    "སྤྱིར་བཏང་དུ་ཟླ་མཚན་དེའང་ཟླ་རེར་ཐེངས་རེ་ཡོང་གི་ཡོད་པར་མ་ཟད།",
    "ཟླ་མཚན་ཕལ་ཆེར་ཟླ་རེར་ཉིན་ཉེར་བརྒྱད་ནས་སུམ་ཅུ་བར་ཐེངས་རེ་འབྱུང་རྒྱུ་ཡོད།",
    "བུད་མེད་ལ་ལར་ཟླ་སྔོན་མའི་ཚེས་གྲངས་དེའི་སྔོན་གྱི་ཉིན་གཉིས་ནས་གསུམ་དུ་ཟླ་མཚན་འབབ་པ་དང་།",
    "ཐེངས་རེའི་ཟླ་མཚན་འབབ་པའི་དུས་ཡུན་ཉིན་གསུམ་ནས་བདུན་བར་ཡིན་པ་དང་ཟླ་མཚན་གྱི་འབབ་ཚད་ཧ་ལམ་ཧཧོའོ་ཧྲིན་བར་ཡིན།",
    "བུད་མེད་ལང་ཚོ་དར་ལ་བབ་པའི་དུས་སུ་ཟླ་མཚན་འབབ་པ་ནི་གཟུགས་ཁམས་ཀྱི་རྒྱུན་ལྡན་སྣང་ཚུལ་ཞིག་ཡིན།",
    "དུས་རྒྱུན་དུ་ཕྱིའི་མོ་མཚན་གྱི་གཙང་སྦྲར་སྲུང་འཛིན་བྱེད་དགོས་ཏེ།",
    "ཆུ་ཁོལ་དྲོ་འཇམ་ནང་དུ་ཀའོ་མིན་སོན་ཅ་བསྲེས་ནས་འདུས་ཚད་ཉིན་རེར་ཐེངས་གཅིག་ལ་བཀྲུས་ན་བཟང་།",
    "ལུས་དང་རྐང་ལག་ཆུ་གྲང་མོའི་ནང་དུ་འཛུལ་མི་རུང་།",
    "སྐབས་རེར་རྒྱུ་ཞབས་སྦོས་བརྒྱངས་བྱེད་པ་སོགས་ཀྱི་མངོན་ཚུལ་ཡོད།",
    "ཟླ་མཚན་འབབ་པའི་ཉིན་ལྔ་ནས་བཟུང་ཨན་གོང་ཧོང་ཐིས་ཐོང་ཉིན་རེར་ཐེངས་རེ་དང་ཐེངས་རེར་ཧའོ་ཁེ་རེ་བསྟུད་མར་ཉིན་ཉི་ཤུ་ལ་འཐུང་བའམ་ཡང་ན་ཟླ་གསུམ་གྱི་རིང་ལ་འཐུང་དགོས།",
    "ཡང་ན་ཁི་ཏེ་ཡུན་ཧའོ་ཁེ་ཉིན་རེར་ཐེངས་གསུམ་ལ་འཐུང་བ་དང་།",
    "སྐབས་རེར་ཟས་འཇུ་དཀའ་བ།",
    "ཡང་ན་སྐྱེ་ལམ་ནས་ཟགས་ཁུ་འབབ་ལ་ཟླ་མཚན་མི་ཆོད་པར་རྒྱུན་དུ་འབྱམས་པར་བྱེད་པའམ་རེ་འགའ་ཟླ་མཚན་དུས་སུ་མི་འབབ་པ་སོགས་ཀྱི་གནས་ཚུལ་ཡོད།",
    "གདོང་གི་ཁ་དོག་དམར་ཞིང་སྣུམ་པ།",
    "ཡང་ན་འོལ་མོ་སེ་མེ་ཏོག་དང་ལུག་མིག་སྟོང་ཟིལ།",
    "ལང་ཚོ་དར་བའི་བུད་མེད་ལོ་བཅོ་བརྒྱད་ལ་སླེབས་ཀྱང་ཟླ་མཚན་རྩ་བ་ནས་མི་ཡོང་བ་དང་།",
    "བུད་མེད་དེ་ལང་ཚོ་དར་ལ་བབ་ན་ཡང་།",
    "མཆུ་སོ་དང་སེན་མོར་སྐྱ་བོར་ཆགས་པ།",
    "དཀར་པོ་ཆིག་ཐུབ་གདུས་པའི་ཐང་དགུང་མོ་ཡང་ཡང་འཐུང་དགོས།",
    "བདུན་ཕྲག་གཅིག་ལ་ཐེངས་རེ་བྱའོ།",
    "མང་ཆེ་བ་ནི་གཉེན་སྒྲིག་མ་བྱས་པ་དང་ཡང་ན་སྦྲུམ་ཆགས་པའི་བུད་མེད་ལ་ན་བ་ཡིན།",
    "ལང་ཚོ་དར་བའི་བུད་མེད་ལ་ཟླ་མཚན་ཐོག་མར་འབབ་པ་དང་ཡང་ན་ཟླ་མཚན་འབབ་པའི་སྐབས་སུ་ལུས་ཕུང་མི་བདེ་བ་དང་མཁལ་རྐེད་ན་བ།",
    "རྐེད་པ་ན་བ་དེ་དུས་ཚོད་འགའ་རེ་དང་ཡང་ན་ཉིན་གཅིག་ནས་གཉིས་ལ་རྒྱུན་སྲིང་བྱེད་ངེས་ཡིན།",
    "ཉེ་ལམ་ལོ་བཅུ་གསུམ་ནས་བཅུ་དགུ་བར་གྱི་ལོ་ཆུང་བུད་མེད་རྣམས་ལ་རྐེད་པ་ན་བ་ཧ་ཅང་མང་།",
    "མི་ཁ་ཤས་ཀྱིས་བཟོད་བསྲན་བྱེད་དཀའ་བ་རེད།",
    "ལོ་ཆུང་བུད་མེད་ཁ་ཤས་ལ་ཟླ་མཚན་ཐད་ཀྱི་ངོས་ཟིན་ཡང་དག་པ་ཞིག་མེད་པས།",
    "བསམ་པའི་ཁུར་བོ་ལྕི་དྲགས་པ་རེད།",
    "ཟླ་མཚན་ཆད་ནས་ཞག་བཅུ་གཅིག་གི་རིང་ལ་བུའི་ས་བོནསྟེ་ཁམས་དམར་གསོག་བཞིན་པའི་དུས་ཡིན་པ་དང་།",
    "བུད་མེད་ཀྱི་ཟླ་མཚན་རྒྱུན་ལྡན་ཡིན་ན།",
    "བུད་མེད་ལ་ལར་རྒྱུ་ཞབས་དང་མཁལ་རྐེད་ན་བའི་གནས་ཚུལ་ཡང་ཡོད།",
    "ལུས་ཤུགས་ཀྱི་ངལ་རྩོལ་ལྕི་མོ་དང་།",
    "བུད་མེད་ལ་མངལ་ཆགས་པ་ནི།",
    "སྦྲུམ་བུའི་ཚེ་སྲོག་གི་མགོ་བརྩམས་པ་ཡིན་ཞིང་།",
    "ཁམས་དམར་ཐོན་དུས་ནི་ཐེངས་རྗེས་མའི་ཟླ་མཚན་མ་ཡོང་གོང་གི་ཉིན་བཅུ་བཞི་ཡས་མས་ཡིན།",
    "རང་ཤུགས་སུ་མེད་པར་འགྲོ་བ་རེད།",
    "རྒྱུན་ལྡན་གྱི་སྐྱེས་ཚད་ལོན་པའི་བུད་མེད་ཅིག་ལ་མཚོན་ན།",
    "སྦྲུམ་འགོག་གི་བྱ་ཐབས་ཅི་ཡང་བཀོལ་མེད་ཚེ།",
    "དེ་ནི་མངལ་ཆགས་རྗེས་མངལ་སྣོད་ཇེ་ཆེར་སོང་སྟེ་གཅིན་ལམ་ལ་གནོན་ཤུགས་ཐེབས་པའི་རྐྱེན་གྱིས་ཡིན།",
    "བརྟག་ཐབས་ཆེས་སླ་མོ་ནི་གཅིན་ཁུའི་རྫས་འགྱུར་ལ་བརྟག་དཔྱད་བྱས་ནས།",
    "བུད་མེད་ལ་མངལ་ཆགས་རྗེས་སེམས་ཁམས་དང་ལུས་ཁམས་ལ་འགྱུར་ལྡོག་རབ་དང་རིམ་པ་འབྱུང་སྲིད་པས།",
    "འགྱུར་ལྡོག་དེ་དག་ནི་བུད་མེད་མང་ཤོས་ལ་མཚོན་ན་རྒྱུན་ལྡན་ཡིན་པས་སེམས་ཁྲལ་དང་མི་བདེ་བའི་སྣང་བ་སྐྱེ་མི་དགོས་མོད།",
    "འོན་ཀྱང་བུད་མེད་ལ་ལར་མངལ་ཆགས་རྗེས་རྒྱུན་ལྡན་མིན་པའི་གནས་ཚུལ་འབྱུང་སྲིད་པས་དེར་དོ་སྣང་བྱ་དགོས།",
    "དུས་མཚུངས་སུ་མ་འོངས་པའི་བྱིས་པའི་བདེ་ཐང་དང་མ་བུའི་བདེ་ཐང་གི་ཆེད་དུ།",
    "གོང་གསལ་གྱི་སྣང་ཚུལ་དེ་དག་གི་བྱུང་ཚད་ཇེ་ཉུང་དུ་གཏོང་ཐུབ།",
    "ཁྲག་གི་ཤོང་ཚད་དེ་མངལ་མ་ཆགས་པའི་སྔོན་ལས་འཕར་སྣོན་བྱུང་ཡོད་པ་དང་།",
    "འཚོ་བཅུད་ལ་ཤུགས་སྣོན་བྱེད་པ་ནི་ཚོད་འཛིན་ཅི་ཡང་མེད་པར་ཟ་མ་གང་བཟང་གི་རིགས་ཟ་བ་མིན་པར།",
    "སྤྱིར་བཏང་གི་བཟའ་བཏུང་རིགས་གདམ་གསེས་འོས་འཚམས་དང་།",
    "སྦྲུམ་མར་མངལ་ཆགས་ནས་དུས་བར་དང་དུས་མཇུག་ཏུ་སླེབས་ཚེ་ཉིན་རེའི་ཟ་མའི་ནང་དུ་ཟས་རིགས་གཙོ་བོ་སྤྱི་རྒྱའི་དང་།",
    "ནངས་དགོང་ཕྱི་རོལ་ཏུ་འཆམ་འཆམ་ལ་སོང་ན་ཟས་འཇུ་བ་དང་ཁྲག་རྒྱུ་བར་ཕན་ཞིང་།",
    "གལ་ཏེ་ལུས་ཤུགས་ཕུད་ཆེ་ན་བུ་སྣོད་ཀྱི་སྡུད་གཏོང་གི་ནུས་པར་ཤུགས་རྐྱེན་ཐེབས་ནས་ཕྲུ་གུ་མངལ་ལས་ཤོར་བ་དང་ཡང་ན་སྔ་བཙའ་ཡི་གནས་ཚུལ་འབྱུང་སླ་བ་རེད།",
    "དེ་ལྟར་བྱས་ན་བུ་སྣོད་ཀྱིས་མངལ་འོག་གི་སྡོད་རྩར་གནོན་ཤུགས་ཐེབས་ཚད་ཇེ་ཡང་དུ་གཏོང་ནུས་པས།",
    "སྦྲུམ་སྲིང་ཆགས་བཞིན་པའི་སྐབས་ཡིན་མོད།",
    "ཁྱད་པར་དུ་གཉེན་སྒྲིག་གི་རྗེས་སུ་རང་ཤུགས་ཀྱིས་ཕྲུ་གུ་མངལ་ཤོར་བྱུང་མྱོང་བའི་བུད་མེད་ཀྱིས་འདོད་སྤྱོད་བྱ་རྒྱུ་གཏན་འགོག་བྱ་དགོས།",
    "དེ་ལྟར་མ་བྱས་ན་ཕྲུ་གུ་མངལ་ཤོར་འབྱུང་སླ་བ་རེད།",
    "ལྷག་པར་དུ་ཕྲུ་གུ་བཙའ་རན་པའི་སྔོན་གྱི་ཟླ་གཅིག་གི་རིང་ལ།",
    "རུས་ཀྲང་གི་འཕེལ་རྒྱས་ལ་ཚོད་འཛིན་ཐེབས་རྐྱེན་རྐང་ལག་ཐུང་བའི་ཡ་མ་གཟུགས་ཅན་དུ་འགྱུར་སྲིད་པ་ལྟ་བུ་རེད།",
    "སྦྲུམ་བུའི་ནུས་པ་ཇེ་ཞན་དུ་སོང་སྟེ།",
    "མངལ་ཆགས་སྐབས་སུ་དུ་བ་འཐེན་པའི་སྦྲུམ་མས་བཙས་པའི་བྱིས་པ་དེ་དུ་བ་འཐེན་མ་མྱོང་བའི་སྦྲུམ་མས་བཙས་པའི་བྱིས་པ་དང་བསྡུར་ན་བྱིས་པའི་ལུས་ཕུང་གི་ལྗིད་ཚད་ཁེ་ཙམ་ཡང་བ་རེད།",
    "མངལ་ཆགས་པའི་དུས་སུ་བུད་མེད་ལ་ཞེ་མེར་ལངས་ནས་སྐྱུག་པ་དང་གཉིད་ཆེ་བ།",
    "དེ་བས་ཉིན་གཅིག་ལ་ཟས་ཉུང་ཉུང་རེ་དང་ཐེངས་མང་བོར་ཟ་དགོས་པ་ལས་ཐེངས་གཅིག་ལ་ཟས་མང་བོ་ཟ་མི་རུང་ལ།",
    "མངལ་དུ་ཕྲུ་གུ་ཆགས་རྗེས་བུ་སྣོད་རིམ་གྱིས་ཇེ་ཆེར་སོང་ནས་རུས་གཞོང་ནང་ངོས་ཀྱི་ཁྲག་རྩ་མང་བོར་བཙིར་གནོན་བྱས་པས་ཁྲག་རྩའི་ཁྲག་གི་རྒྱུ་བ་ལ་བར་ཆད་བྱེད་པ་དང་།",
    "ཉིན་རེའི་དུས་ཚོད་འདྲ་མིན་ནང་དུ་རྐང་པ་ཡར་བཀྱགས་ནས་ངལ་གསོ་དགོས།",
    "མ་རྨོས་ལོ་ཏོག་གི་གེ་སར་ལས་བཟོས་པའི་ཇ་འཐུང་ན་ཕན་ཐོགས་ཡོད།",
    "ཕྲུ་གུ་བུ་སྣོད་ནང་དུ་སྡོད་པའི་ཟླ་མཇུག་དེར་ཕྲུ་གུའི་གནོན་ཤུགས་ཀྱི་རྐྱེན་པས་ཨ་མའི་རྐང་པ་སྐྲངས་ཡོད།",
    "འཚོ་བཅུད་ཀྱིས་མ་འདང་བས་ཟུངས་ཁྲག་ཞན་པའམ་ཚྭ་མང་བོ་ཟ་མཁན་གྱི་བུད་མེད་ལ་སྐྲངས་པ་ཤས་ཆེ།",
    "མ་བུ་བདེ་སྲུང་གི་བྱ་བ་འདི་ཁྱབ་གདལ་དུ་གཏོང་རྒྱུ་ནི་ང་ཚོའི་ལས་འགན་གལ་ཆེན་ཞིག་ཡིན།",
    "དེ་བས་ད་ལྟ་མ་བུའི་བདེ་སྲུང་གི་བྱ་བར་རྒྱལ་ཁབ་ཡོངས་དང་འཛམ་གླིང་ཧྲིལ་པོས་མཐོང་ཆེན་བྱེད་བཞིན་པའི་སྒང་ཡིན་ལ།",
    "དར་རྒྱས་ཆེ་བའི་རྒྱལ་ཁབ་ཨ་མེ་རི་ཁ་ལྟ་བུར་མཚོན་ན་དུས་རབས་ཉི་ཤུའི་ལོ་རབས་དྲུག་ཅུ་དང་བདུན་ཅུའི་སྔོན་ནས་མ་བུའི་བདེ་ཐང་ལ་དོ་སྣང་བྱས་ཏེ།",
    "ཐབས་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་མ་བུའི་བདེ་སྲུང་གི་བྱ་བར་ཤུགས་སྣོན་བྱེད་ཀྱིན་ཡོད།",
    "ཁྱེའུ་སྐྱེ་མ་ཐག་ནས་ཟླ་བ་ལྔ་ནས་དྲུག་གི་རིང་ལ་ཨ་མའི་འོ་མ་བསྟེན་ན་ཤིན་ཏུ་ལེགས།",
    "ཨ་མའི་འོ་མར་བསྟེན་ན་བྱིས་པ་ནར་སོན་པ་དང་བདེ་ཐང་ཡོང་བ་ལ་ཕན་པར་མ་ཟད།",
    "ཆམ་རིམས་སོགས་ལ་འགོག་གི་ནུས་པ་ཡང་ཡོད་པས་ཨ་མའི་ནུ་མ་ལྡུད་པར་ཤུགས་སྣོན་བྱ་རྒྱུ་ཤིན་ཏུ་གལ་ཆེ།",
    "མངལ་ཆགས་པའི་སྐྱི་ཐུམ་དེའི་ངོས་གཅིག་ནི་བུ་རོགས་དང་འབྱར་པའི་སྐྱི་པགས་སྲབ་མོ་ཞིག་ཡིན།",
    "གསུས་པའི་ཕྱི་ཕྱོགས་སུ་ལག་པས་རེག་བརྟག་བྱས་ན་དཔྱད་འབྲས་ལེགས་པོ་ཞིག་ཐོབ་མི་ཐུབ།",
    "མངལ་ཆགས་ནས་ཟླ་བ་གསུམ་སོང་བའི་རྗེས་སུ་སྦྲུམ་མའི་གསུས་པ་དང་མངལ་ཞབས་རེག་ཐུབ་པ་དང་མངལ་ཁོག་རིམ་བཞིན་ཇེ་ཆེར་རྒྱས་ལ།",
    "མངལ་ཆགས་རྗེས་ཀྱི་ཟླ་རེ་རེའི་སྦྲུམ་བུའི་ལུས་ཕུང་སྐྱེ་འཕེལ་འབྱུང་སྟངས་ནི་འདི་ལྟ་སྟེ།",
    "ཕོ་མོའི་དབྱེ་བའང་འབྱེད་ནུས་ལ།",
    "རྐང་ལག་བཞི་བོ་རང་འདོད་དུ་འགུལ་ཐུབ་པས་སྦྲུམ་བུའི་སྐྱེ་འཕེལ་ཡོངས་སུ་སྨིན་པ་རེད།",
    "ཀལྟེ་བ་ནས་མར་སོར་གཅིག་གི་བར།",
    "ལྟེ་བ་ནས་གྱེན་དུ་སོར་གང་གི་བར།",
    "སྦྲུམ་མའི་བུ་སྣོད་རིམ་བཞིན་ཇེ་ཆེར་སོང་ནས་ཟླ་བ་གསུམ་ལོན་རྗེས་ཕལ་ཆེར་རྨོངས་རུས་འབྲེལ་མཚམས་ཀྱི་སྟོད་ལ་རེག་ཐུབ།",
    "མངལ་ཆགས་ནས་ཟླ་བ་བདུན་གྱི་སྔོན་ལ་ཟླ་བ་རེར་ཐེངས་རེ་བརྟག་ན་ཆོག་ཟླ་བརྒྱད་ནས་དགུར་སླེབས་ཚེ་ཟླ་བ་ཕྱེད་ཀའི་ནང་ཐེངས་རེ་བརྟག་དགོས།",
    "ཟླ་བ་དགུ་འགོར་རྗེས་རབ་ཡིན་ན་གཟའ་འཁོར་རེ་ལ་ཐེངས་རེ་བརྟག་ཞིབ་བྱེད་དགོས།",
    "མངལ་ཆགས་པའི་སྐབས་སུ་སྦྲུམ་མ་མང་བོ་ཞིག་གི་རྐང་བ་ཅུང་ཙམ་སྐྲངས་ཤིང་ཁྱད་པར་དུ་རྐང་བའི་བོལ་གོང་དང་ལོང་ཚིགས་དག་སྐྲངས་པ་དང་།",
    "མཛུབ་མོས་མནན་ན་མཐེབ་རྗེས་ཅུང་ཟད་ཙམ་མ་གཏོགས་མི་འབབ་པ།",
    "སྤྱིར་བུད་མེད་མངལ་ཆགས་སྐབས་བུ་སྣོད་ཀྱི་ལྗིད་ཚད་གཡས་ཕྱོགས་སུ་འཁོར་ནས་ཁོག་སྨད་སྡོད་རྩར་རྞྞ་གནོན་ཤུགས་ཐེབས་པའི་ཕྱིར།",
    "དེར་སྔོན་འགོག་དང་ཚོད་འཛིན་གྱི་ནུས་པ་ལྡན་པར་མ་ཟད།",
    "རྒྱུན་ལྡན་གྱི་བཀོལ་ཚད་ལ་ཐེངས་རེར་ཁེ་བར་ཡིན།",
    "ཡང་ན་ཅན་གྱི་ལིའུ་སོན་མེ་ཧའོ་ཧྲིན་ཅན་གྱི་རྒུན་འབྲུམ་མངར་ཆ་ཧའོ་ཧྲིན་ཡི་ནང་དུ་བསྒྱུར་ནས་དུས་ཚོད་སྐར་མ་ལྔའི་ནང་དལ་མོར་སྡོད་རྩར་ཁབ་རྒྱག་པ་དང་།",
    "ཧྲོང་ཆིན་ཁི་ཉའོ་སའེ་ཧའོ་ཁེ་ཉིན་རེར་ཐེངས་གཉིས་འཐུང་དགོས།",
    "འཕྲེད་དུ་གནས་སྟངས་དང་གསུམ་མོ།",
    "སྦྲུམ་མའི་གཡས་ཕྱོགས་སུ་ལངས་ཏེ་བུ་སྣོད་ཀྱི་མཐིལ་ཞབས་གཡས་གཡོན་གཉིས་སུ་ལག་མཐིལ་གྱིས་གནོན་ཤུགས་སྙོམས་པོས་ག་ལེར་རེག་དུས།",
    "བུ་སྣོད་ཀྱི་མཐིལ་ཞབས་ཆེ་ཞིང་ངེས་གཏན་མེད་པའི་དངོས་པོ་ཟླུམ་པོ་ཅུང་སྲ་མཁྲེགས་ཅན་ཞིག་ལ་རེག་ཐུབ་པ་ནི་ཆུའི་སྟེང་གི་ལྒང་བུ་ལ་རེག་པའི་ཚོར་སྣང་ཡོད།",
    "ཁ་ཅིག་གིས་རྐང་བ་གཉིས་ཀྱི་གཅིག་གྱེན་དུ་བསྲིངས་ཏེ་མངལ་གནས་རང་གི་ཐོད་པར་ཐུག་ཡོད་པ་དང་ལག་པ་གཉིས་ཀྱིས་བྲང་ཁ་སྐྱོར་བའི་ཚུལ་དུ་གནས་ཡོད་ཟེར།",
    "དུས་ཚོད་སྐར་མ་རེར་ཐེངས་བར་ལྡིང་བ་ཡིན།",
    "སྦྲུམ་མའི་འཕར་རྩ་ནི་དུས་ཚོད་སྐར་མ་རེ་ལ་ཧ་ལམ་ཐེངས་ཙམ་ལྡིང་ཞིང་སྐབས་འགར་ཉན་ཆས་ཀྱིས་གོ་ཐུབ།",
    "སྦྲུམ་མའི་རྒྱུན་ལྡན་གྱི་དབུགས་ཀྱི་རྒྱུ་བ་ནི་དུས་ཚོད་སྐར་མ་རེར་བར་ཡིན་པ་དང་།",
    "རྒྱུག་རྩ་དེ་ཆུང་རྐྱེན་ཇེ་ཆེར་སོང་བའི་མངལ་སྦྲུམ་པ་དེ་ཤོང་མི་ཐུབ་ཅིང་།",
    "བུ་སྣོད་དང་ནུ་མ་ཇེ་ཆེར་མི་འགྲོ་བ་རེད།",
    "མངལ་ཆགས་པའི་རྗེས་སུ་སྐྱེ་ལམ་ནས་ཁྲག་ཉུང་ངུ་ཤོར་ནས་རིམ་བཞིན་ཇེ་མང་དུ་སོང་བ་དང་།",
    "ཁྲག་གི་གནོན་ཤུགས་ཆག་པ་སོགས་ཀྱི་མངོན་ཚུལ་ཡོད།",
    "ཕོ་མོ་གཉིས་ཀའི་ཕྱོགས་ན་ཡོད་དེ།",
    "བུད་མེད་ཀྱི་ཕྱོགས་ནས།",
    "སྐབས་རེར་རླིག་འབྲས་སྐྲངས་ནས་ཚ་རྒྱག་པ།",
    "བྱ་སྒོང་བཙོས་ནས་ཟོས་ན་ཁུ་བ་འཕེལ་ཞིང་ཁུ་བའི་ཕྲ་ཕུང་གི་གསོན་ཚད་ཀྱང་མང་དུ་འགྲོ་བ་ཡིན།",
    "སྐར་མ་དྲུག་ནས་བདུན་ཙམ་ལ་ཐེངས་རེར་གཟེར་བ་དང་།",
    "གཟེར་གྲངས་ཇེ་མང་དུ་སོང་སྟེ་སྐར་མ་གསུམ་ནས་ལྔའི་ནང་དུ་ཐེངས་རེར་གཟེར་བ་དང་།",
    "དེ་ནི་ཕྲུ་གུ་དངོས་སུ་བཙའ་བའི་རྟགས་ཡིན་ཕྱིརགྲ་སྒྲིག་གི་བྱ་བ་ཡོད་ཚད་ལེགས་བསྒྲུབ་བྱ་དགོས།",
    "དམར་བོ་མཐོང་བ་ནི་མངལ་ལམ་ནས་ཁྲག་ཉུང་ཙམ་རེ་བཞུར་མགོ་བརྩམས་པ་ལ་ཟེར།",
    "རང་ཁྱིམ་ནས་བཙའ་ན་ངེས་པར་དུ་བྱིས་པ་མང་དུ་བཙའ་མྱོང་བའི་བུད་མེད་ཅིག་བཙའ་གྲོགས་སུ་བསྟེན་དགོས།",
    "སྦྲུམ་མ་ལ་ལར་ཟླ་གྲངས་ལོངས་ཁའི་གཟའ་འཁོར་གཉིས་ཙམ་ལ་དུས་ངེས་མེད་དུ་གཟེར་ཟུག་ལངས་ནས་དུས་ཚོད་ཕྱེད་ཀའི་ནང་ལ་གཟེར་ཐེངས་གཅིག་རེ་ལངས་པ་དང་།",
    "སྐབས་འགར་དུས་ཚོད་གཉིས་རེའི་ནང་ལ་གཟེར་ཐེངས་གཅིག་རེ་ལངས་པས་བྱིས་པ་བཙའ་སྐབས་ཀྱི་གཟེར་རྒྱག་ཚུལ་དང་མི་འདྲ།",
    "གཟེར་མཚམས་ཀྱི་དུས་ཚོད་ཐུང་ངུར་ཕྱིན་ནས་ཕལ་ཆེར་ཆུ་ཚོད་སྐར་མ་ཉི་ཤུ་ནས་སུམ་ཅུའི་ནང་དུ་གཟེར་ཐེངས་གཅིག་རེ་ལངས་པ་དང་།",
    "ཐེངས་རེའི་གཟེར་ཡུན་དུས་ཚོད་སྐར་མ་བཅུ་ནས་ཉི་ཤུའི་བར་ཡིན།",
    "དེ་ནས་གཟེར་ལངས་པ་རིམ་གྱིས་ཇེ་མང་དང་ཇེ་དྲག་ཏུ་སོང་ནས་མངལ་ཁ་འབྱེད་པར་ཉེ་བའི་ཚེ་དུས་ཚོད་སྐར་མ་གཉིས་ནས་གསུམ་ནང་དུ་སྐྱེ་གཟེར་ཐེངས་རེ་ལངས་ཏེ་ཕྲུ་གུའི་མགོ་མར་བབས་པ་དང་།",
    "མངལ་ཁ་ཕྱེ་སྟེ་བུ་སྣོད་དམ་ལྷོད་བྱེད་པ་སྔར་ལས་ཇེ་དྲག་ཏུ་སོང་སྟེ་ཧ་ལམ་དུས་ཚོད་སྐར་མ་རེ་ལ་ཐེངས་རེ་གཟེར་ལངས་ཤིང་།",
    "ཕྱིར་བུད་པ་དང་ནང་དུ་ནུབ་པ་ཐེངས་མང་བྱས་རྗེས་ད་གཟོད་ཕྲུ་གུའི་མགོ་ཡོངས་རྫོགས་ཕྱིར་འབུད་ཐུབ།",
    "མངལ་གནས་ཕྲུ་གུའི་མགོ་མྱུར་དུ་ཕྱིར་འབུད་ཐུབ།",
    "མངལ་གནས་ཕྲུ་གུའི་མགོ་ཕྱིར་འབུད་སྐབས་ངོ་རྒྱབ་ཕྱོགས་ལ་འཁོར་ཡོད་སྦྲུམ་མ་གན་རྐྱལ་དུ་ཉལ་སྐབས་སྦྲུམ་བུའི་ངོ་གདོང་མར་འཁོར་ཡོད་མངལ་གནས་ཕྲུ་གུའི་མགོ་ཡོངས་རྫོགས་ཕྱིར་བུད་རྗེས་ངོ་གཡོན་ཕྱོགས་སམ་གཡས་ཕྱོགས་གང་རུང་དཔེ་རིས།",
    "ཕྲག་མགོ་གཉིས་ཕྱིར་བུད་རྗེས་མངལ་གནས་ཕྲུ་གུའི་ལུས་ཧྲིལ་པོ་ཧ་ཅང་བདེ་བླག་ངང་ཕྱིར་འབུད་ཐུབ།",
    "བྱིས་པ་བཙས་རྗེས་བུད་སྣོད་ཀྱི་དམ་ལྷོད་གནས་སྐབས་སུ་མཚམས་འཇོག་ལ།",
    "ཕྲུ་གུའི་རྐང་བ་གཉིས་བཟུང་ནས་མགོ་ཐུར་ཏུ་བསྟན་ཏེ་འཕོངས་ཚོས་དང་རྐང་མཐིལ་ལ་ཐལ་ལྕག་གིས་ག་ལེར་གཞུས་ཏེ་ངུ་སྐད་འདོན་དུ་བཅུག་ནས་དབུགས་གཏོང་རྒྱུར་སྐུལ་འདེད་གཏོང་དགོས།",
    "ཕྲུ་གུ་ངུ་འབོད་བྱེད་ཀྱིན་ཡོད་ན་འཕོངས་ཚོས་དང་རྐང་མཐིལ་ལ་ཐལ་ལྕག་གིས་གཞུས་མི་དགོས།",
    "ལྟེ་ཐག་གི་འཕར་འགུལ་མཚམས་བཞག་པ་དང་།",
    "ལྟེ་བའི་རྩ་བ་ནས་སོར་བཞི་དང་ཡང་ན་དྲུག་གི་མཚམས་ནས་སྐུད་པ་བསྒྲིལ་མས་དམ་པོར་བསྡམས་ཏེ་དཀྱིལ་ནས་གཅོད་དགོས།",
    "ལྟེ་ཐག་བཅད་རྗེས་སྣེ་མོ་སང་རས་གཙང་མའི་ལྟེ་ཐུམ་གཞན་ཞིག་གིས་ལེགས་པར་དཀྲི་དགོས།",
    "ལྟེ་ཐུམ་དཀྲིས་རྗེས་ཕྲུ་གུ་གྲང་སླ་བས་མྱུར་དུ་ཉལ་ཐུལ་ལམ་ལྭ་བ་དྲོན་པོ་ཞིག་གིས་བཏུམས་ནས་བསྙལ་དགོས་སོ།",
    "སྦྲུམ་མས་རང་ཁྱིམ་དུ་ཕྲུ་གུ་བཙའ་ལེན་བྱ་བའི་གྲ་སྒྲིགབུད་མེད་ཀྱིས་ཕྲུ་གུ་བཙའ་རྒྱུ་དེ་ནི་དོན་ཆེན་ཞིག་ཡིན་ཞིང་།",
    "རང་ཁྱིམ་དུ་ཕྲུ་གུ་བཙའ་ན་ཁྱིམ་དུ་མ་བཙའི་སྔོན་ནས་གྲ་སྒྲིག་གི་བྱ་བ་བྱེད་དགོས་ཏེ།",
    "སྐྲག་སྣང་གི་བསམ་ཚུལ་སེལ་དགོས་ཤིང་།",
    "དེ་ལྟར་བྱས་ན་ལུས་ཀྱི་སྟོབས་ཤུགས་ཟད་འགྲོ་བ་རེད།",
    "བྱིས་པ་བཙས་རྗེས་བང་མ་ཁྲག་གིས་བརྒྱལ་འགྲོ་བ་དང་།",
    "ཕྲུ་གུ་བཙས་རྗེས་ཀྱི་མ་བུ་བདེ་སྲུང་གི་གལ་ཆེན་རང་བཞིན།",
    "ཤིང་ཏོག་བ་དམ་ལ་ཕུག་སོགས་ཤིང་ཏོག་དང་ཚོད་མའི་རིགས་ཀྱང་ཟོས་ཆོག་ཤ་ཁུ་མང་ཙམ་འཐུང་ན་འོ་མ་ཇེ་མང་དུ་འབབ་ཐུབ།",
    "ཨ་མས་བཅུད་རྫས་ཀྱི་རིགས་མང་བོ་ཟོས་ཚེ་ཕྲུ་གུའི་ལྟོ་ཆས་ཏེ་ཨ་མའི་འོ་མ་ཇེ་མང་དུ་འགྲོ་བས་དེའི་རིས་བསྟེན་རྒྱུ་ནི་དོན་གལ་ཆེན་ཞིག་རེད།",
    "ཆིན་མེ་སུའུ་རྩིས་གཞི་ཁྲི་དང་ཡང་ན་ཞན་ཧྥུན་ཨང་ཅན་ཁྲི་བཅས་བསྲེས་ཏེ་ཉིན་རེར་ཐེངས་གཅིག་ལ་སྡོད་རྩར་གནམ་ཁབ་རྒྱག་དགོས།",
    "ཨ་མའི་ནུ་མར་བདག་སྐྱོང་བྱེད་སྟངས།",
    "ཕྲུ་གུ་སྐྱེས་པའི་ཉིན་མོ་ནས་བཟུང་ཨ་མས་འོ་མ་སྟེར་མགོ་ཚུགས་པ་ཡིན་ཏེ།",
    "ཕྲུ་གུས་ནུ་མ་སྟོང་བར་བཏང་རྗེས་སླར་ཡང་ནུ་མའི་ནང་དུ་འོ་མ་འབབ་པ་རེད།",
    "ནུ་རྩེ་ཐུང་ཐུང་ཡིན་པའི་བུད་མེད་ལ་རྨ་ཁ་འདི་འབྱུང་ཉེན་ཆེ།",
    "ན་ཟུག་མེད་པའི་ནུ་མའི་ནང་གི་ཤ་སྐྲན་དེ་ལ་འབྲས་སྐྲན་ཡང་ཟེར།",
    "ཆུ་ཚ་མོ་དང་ཡང་ན་ཅན་གྱི་ལིའུ་སོན་མེ་བཀོལ་ནས་ཉིན་རེར་ཐེངས་གསུམ་ནས་བཞི་དང་།",
    "ཐེངས་རེར་དུས་ཚོད་སྐར་མ་ཉི་ཤུ་ནས་སུམ་ཅུའི་བར་ལུམས་རྒྱག་དགོས།",
    "ཐུའུ་མེ་སུའུ་ཉིན་རེར་ཐེངས་གསུམ་ལ་ཁེ་རེ་འཐུང་དགོས།",
    "སྦྲུམ་མས་བྱིས་པ་བཙས་ནས་དུས་ཚོད་བཅུ་གཉིས་འགོར་རྗེས་ནུ་མ་ལྡུད་ཆོག་ཕྲུ་གུ་དམར་འབྱར་གྱི་ཟས་ཡག་ཤས་ནི་ཨ་མའི་འོ་མ་ཡིན།",
    "དུས་ཚོད་གསུམ་ནས་བཞིའི་བར་ལ་ནུ་མ་ཐེངས་རེ་བླུད་ན་བྱིས་པས་ཟས་འཇུ་བ་ལ་ཕན་པ་ཡོད།",
    "ནུ་མ་བསྣུན་ཐེངས་རེར་ཆུ་དྲོ་འཇམ་གྱིས་ནུ་མགོ་བཀྲུས་ན་ཤིན་ཏུ་བཟང་ཞིང་།",
    "ཨ་མའི་འོ་མ་འཐུང་མཁན་གྱི་ཕྲུ་གུ་རྣམས་གཟུགས་པོ་བདེ་ཐང་ཡིན་ལ་ཤུགས་ཀྱང་ཆེ།",
    "ཕྲུ་གུས་ཨ་མའི་འོ་མ་བཞིབས་ན་འོ་མ་མང་དུ་འཕེལ་རྒྱུར་ཕན་ཐོགས་ཡོད།",
    "ཕྲུ་གུས་ཨ་མའི་འོ་མ་བསྟེན་དགོས་པར་མ་ཟད།",
    "ཨ་མའི་འོ་མ་ཉུང་སྐབས་སྐོམ་པ་ཧ་ཅང་མང་བོ་འཐུང་དགོས།",
    "མཛོ་མོའི་འོ་མ་དང་འོ་ཕྱེ་སྐམ་པོ་ནང་དུ་ཆུ་ཁོལ་དྲོ་འཇམ་བསྲེས་ནས་འཐུང་བ་དང་དེ་མིན་སྟོབས་སྐྱེད་པའི་ཟས་རིགས་གང་མང་སྟེར་དགོས་ལ།",
    "ནུ་མ་ལྡུད་སྐབས་ཨ་མ་ཙོག་པུར་བསྡད་དེ་ལག་པ་གཅིག་གིས་བྱིས་པའི་རྒྱབ་སྐྱོར་བ་དང་ལག་པ་གཅིག་གིས་ནུ་མ་བསྐྱོར་དགོས།",
    "བྱིས་པ་བཙས་ནས་ཉིན་གསུམ་ནས་བཞི་འགོར་ན་ཨ་མ་གློ་ཉལ་བྱས་ཏེ་ནུ་མ་བླུད་ཆོག་ལན་རེར་ནུ་མགོར་རྨ་ཁ་བྱུང་ནས་ན་ཟུག་ལངས་པའམ་ཐ་ན་ཁྲག་འོང་སྲིད།",
    "མཆན་ཁུང་གི་མེན་བུ་སྐྲངས་པ་སོགས་ཀྱི་སྣང་ཚུལ་ཡོད།",
    "སྦྲུམ་མས་བྱིས་པ་བཙས་ནས་དུས་ཚོད་བཅུ་གཉིས་འགོར་རྗེས་ནུ་མ་བླུད་ཆོག་ཕྲུ་གུ་དམར་འབྱར་གྱི་ཟས་ཡག་ཤས་ནི་ཨ་མའི་འོ་མ་ཡིན།",
    "དེ་བས་ཨ་མའི་འོ་མ་ནི་ཕྲུ་གུར་མཚོན་ན།",
    "ཨ་མས་ཕྲུ་གུར་ནུ་མ་མི་ལྡུད་པ་ཇེ་མང་ནས་ཇེ་མང་དུ་འགྲོ་བཞིན་པའི་སྲོལ་ངན་འདི་ཤུགས་ཆེན་གྱིས་བཀག་སྟེ།",
    "སྤྱིར་ཕྲུ་གུ་བཙས་རྗེས་ཀྱི་ཆུ་ཚོད་དྲུག་ནས་བཅུ་གཉིས་སོང་མཚམས་སུ་ནུ་ཞོ་འབབ་མགོ་རྩོམ་པ་ཡིན།",
    "ཨ་མའི་འོ་མའི་ནང་དུ་སྤྲི་དཀར་རྫས་རིགས་དང་འཚོ་བཅུད་ལྡན་པའི་གྲུབ་ཆ་གང་མང་འཛོམས་ཤིང་།",
    "གསར་སྐྱེས་ཕྲུ་གུ་ནུ་ཞོས་གསོས་ན་དེའི་གཟུགས་པོར་སྟོབས་སྐྱེད་པར་ཕན་པ་ཆེ་ཞིང་ཨ་མའི་འོ་མ་ནི་རང་ཤུགས་སུ་འབབ་པའི་ཟས་རིགས་མེད་དུ་མི་རུང་བ་ཞིག་ཡིན།",
    "ནུ་མ་ལྡུད་ཐེངས་རེར་ཕལ་ཆེར་སྐར་མ་བཅུ་ནས་བཅོ་ལྔ་ཡིན།",
    "ནུ་མ་གཉིས་རེས་མོས་ཀྱིས་ལྡུད་དགོས་པ་དང་།",
    "ནུ་མ་ལྡུད་ཐེངས་རེར་ཆུ་དྲོ་འཇམ་གྱིས་ནུ་མགོ་བཀྲུ་དགོས།",
    "ཨ་མའི་འོ་མ་བཟང་པོ་དེ་རྒྱུན་མི་ཆད་པའི་ཕྱིར་དུ་ཟས་སྐོམ་བཅུད་ཆེ་བའི་རིགས་མང་ཙམ་ཟ་བ་དང་།",
    "སྤྱིར་མ་བུ་བདེ་སྲུང་གི་རྒྱུན་ཤེས་ལྟར་ན་ནུ་མ་ལྡུད་པའི་དུས་ཡུན་ནི་ཕྲུ་གུ་བཙས་རྗེས་ཀྱི་ཉིན་དང་པོ་ནས་ཟླ་བ་བཅུ་གཉིས་ལོན་པའི་བར་དུ་བླུད་ན་བཟང་ངོ།",
    "བུད་མེད་ཁ་ཅིག་ལ་ཕྲུ་གུ་སྐྱེས་ནས་ཉིན་བཅུ་ནས་བཅོ་ལྔའི་ནང་ཁྲག་མང་བོ་མི་ཡོང་བར་ཆུ་ཚོད་ཉེར་བཞིའི་ནང་དུ་ཧའོ་ཧྲིན་བར་ཡོང་བ་དང་།",
    "བུད་མེད་མང་ཆེ་བ་ཞིག་གིས་བྱིས་པ་བཙས་རྗེས་ཁྲག་མང་བོ་ཤོར་ནས་ཤི་བར་མ་ཟད།",
    "དེའི་ཕྱིར་བུ་རོགས་ཀྱི་ཆ་ཤས་རེ་རེ་ལ་བརྟག་དཔྱད་ཞིབ་མོ་བྱེད་དགོས།",
    "དང་པོ་ནི་ཤའི་སྐྱི་མོའམ་ནང་རོལ་གྱི་འབྱར་སྐྱི་དང་།",
    "བུད་མེད་ལ་ལས་ཕྲུ་གུ་བཙས་རྗེས་གཙང་སྦྲ་ལེགས་པོ་མི་བྱེད་པར།",
    "ཕྲུ་གུ་བཙས་རྗེས་ཀྱི་གཟའ་འཁོར་དྲུག་གི་ནང་དུ་ཁྱོ་ཤུག་གིས་འདོད་སྤྱོད་བྱེད་པ་དང་།",
    "ཁ་དོག་ཀྱང་དྭངས་མོར་འགྱུར་ལ་ཕལ་ཆེར་ཕྲུ་གུ་བཙས་རྗེས་ཀྱི་གཟའ་འཁོར་གསུམ་ཡས་མས་སུ་གཙང་མར་འགྱུར་སྲིད།",
    "མངལ་ཁྲག་གི་བཞུར་ཚད་ཇེ་མང་དུ་འགྲོ་སྲིད་པར་མ་ཟད།",
    "མི་མི་ཉུང་བ་ཞིག་གིས་ཟླ་མཚན་མ་ཡོང་ན་སྦྲུམ་ཆགས་མི་སྲིད་སྙམ་པ་དང་།",
    "སྦྲུམ་འགོག་བྱ་རྒྱུ་རྒྱུན་འཁྱོངས་མ་བྱས་ན་སླར་ཡང་སྦྲུམ་ཆགས་པའི་མཇུག་འབྲས་འབྱུང་ངོ།",
    "དེ་ནི་གནས་ལུགས་མ་ཤེས་པའི་རྟགས་རེད།",
    "སྦྲུམ་མ་ཆགས་ན་ད་གཟོད་ཟླ་མཚན་ཡོང་ངེས་རེད།",
    "དེའི་ཕྱིར་ཕྲུ་གུ་བཙས་རྗེས་སུ་གཟའ་འཁོར་དྲུག་གི་ནང་དུ་ཁྱོ་ཤུག་གཉིས་ཀས་འདོད་སྤྱོད་བྱེད་སྐབས་སྦྲུམ་འགོག་གི་ཐབས་ལམ་སྤྱོད་རྒྱུ་རྒྱུན་འཁྱོངས་བྱེད་དགོས།",
    "བུད་མེད་མང་ཤོས་ཤིག་ལ་ཕྲུ་གུ་བཙས་རྗེས་ཀྱི་ཉིན་གཉིས་ནས་གསུམ་ནང་དུ་ནུ་ཆུ་འབབ་རྒྱུ་ཡོད།",
    "ཕྲུ་གུ་བཙས་རྗེས་ཆུའི་རིགས་རིམ་བཞིན་ལུས་ནས་ཕྱི་རོལ་དུ་བཏང་ཟིན་པས་ཉིན་རེའི་གཅིན་གཏོང་ཐེངས་ཇེ་མང་དུ་སོང་སྟེ།",
    "ཐེངས་རེར་ཆ་སྙོམས་བྱས་ན་ཧའོ་ཧྲིན་ཙམ་གཏོང་སྲིད།",
    "ཕྲུ་གུ་བཙས་པའི་རྗེས་སུ་ལུས་སྟོབས་ཉམས་ཡོད་པས་རྔུལ་ཆུ་འབྱུང་སླ་ཞིང་མཚན་མོར་རྔུལ་ཆུ་དེ་བས་ཀྱང་མང་ངོ།",
    "སྐྱེས་མས་ཕྲུ་གུ་བཙས་རྐྱེན་ལུས་ཁམས་ཧ་ཅང་ངལ་ཞིང་དུབ་ཡོད་པ་རེད།",
    "ཉིན་གསུམ་པར་མལ་ཁྲི་ལས་བབས་ནས་འགུལ་སྐྱོད་བྱ་ཆོག་མོད།",
    "འོན་ཀྱང་ལས་ཀ་ལྗིད་མོ་ལས་མི་རུང་།",
    "ཕྲུ་གུ་བཙས་རྗེས་ཉིན་རེར་དུས་ཚོད་བཅུ་ཡས་མས་སུ་གཉིད་ཐུབ་པར་ཁག་ཐེག་བྱ་དགོས།",
    "ཉིན་རེར་ཟ་མ་ཟ་ཐེངས་ལྔ་ནས་དྲུག་བར་བྱས་ཆོག་ཅིང་།",
    "ཤིང་ཏོག་གི་རིགས་ཀྱང་ཟ་ཆོགབྱ་སྒོང་ནི་འཚོ་བཅུད་ལྡན་པའི་ཟས་རིགས་ཤིག་ཡིན་རུང་།",
    "སྤྱིར་བཏང་དུ་ཟ་ཐེངས་རེར་བྱ་སྒོང་གཅིག་ནས་གཉིས་ཙམ་ཟས་ན་ལེགས།",
    "གོམས་སྲོལ་རྙིང་བའི་འགྲོ་ལུགས་ལྟར་དུ་ཟླ་གཅིག་གི་རིང་ལ་ཁ་ལག་མི་འཁྲུད་པ་དང་སོ་མི་གཤལ་བ།",
    "མགོ་མི་འཁྲུད་པ་ནི་གཙང་སྦྲ་མིན་པའི་རྟགས་ཡིན་ཞིང་སྐྱེས་མའི་ལུས་ཁམས་ལའང་ཕན་ཐོགས་ཅི་ཡང་མེད་མོད།",
    "འོན་ཀྱང་ཆུ་གྲང་མོས་གཏན་ནས་འཁྲུད་མི་རུང་།",
    "མཚན་ཕྱིའི་གཙང་སྦྲར་དོ་སྣང་བྱས་ཏེ་དུས་རྒྱུན་དུ་མོ་མཚན་གྱི་ཕྱི་ཕྱོགས་འཁྲུད་རྒྱུ་རྒྱུན་འཁྱོངས་བྱེད་དགོས།",
    "ནུ་མར་གཙང་སྦྲ་བྱེད་རྒྱུ་རྒྱུན་འཁྱོངས་བྱ་དགོས་ཏེ།",
    "ཕྲུ་གུ་བཙས་རྗེས་ཀྱི་ཉིན་གཉིས་དང་གསུམ་ནས་མགོ་བརྩམས་ཏེ་མལ་ཁྲིའི་སྟེང་དུ་ལུས་རྩལ་སྦྱོང་དགོས་ཚུལ་གོང་གི་དཔེ་རིས་ལྟར་རོ།",
    "ཁྱེའུ་བཙས་རྗེས་ཀྱི་ཉིན་ཉེར་བརྒྱད་ནས་ལོ་གཅིག་གི་བར་ལ་ཁྱེའུའི་དུས་རིམ་ཟེར།",
    "ཉིན་རེར་ལུས་ཕུང་སྤྱི་རྒྱ་རེར་འོ་མ་ཧའོ་ཧྲིན་ཡས་མས་དགོས་པ་དང་།",
    "ཐེངས་རེར་ཆེས་མང་ན་ཧའོ་ཧྲིན་ལས་འདའ་མི་རུང་།",
    "ཉིན་རེར་ལུས་ཕུང་སྤྱི་རྒྱ་རེར་ཕལ་ཆེར་ཆུ་ཧའོ་ཧྲིན་མཁོ་བ་ལྟར་ཁ་གསབ་བྱ་དགོས།",
    "འོ་མ་མངར་མོ་མིན་ན་བྱིས་པས་འཐུང་མི་འདོད་པའི་གོམས་གཤིས་ཆགས་སྲིད།",
    "ཐེངས་རེར་ཐོག་མར་མའི་འོ་མ་སྣུན་པ་དང་རྗེས་སུ་འབྲིའམ་མཛོ་མོའི་འོ་མ་སོགས་ཀྱིས་དགོས་མཁོ་ལྟར་སྙོར་རྒྱུ་དང་།",
    "བ་དང་འབྲི་སོགས་ཀྱི་འོ་མ་རྐྱང་རྐྱང་གིས་མའི་འོ་མའི་ཚབ་ཐེངས་གཅིག་བྱས་རྗེས་དེ་གཉིས་རེས་མོས་སྒོས་བསྣུན་དགོས།",
    "ཉ་ཤ་སྒོ་ང་ལྟ་བུ་རེད།",
    "ཐེངས་རེར་ཟས་རིགས་གསར་བ་སྣ་གཅིག་མ་གཏོགས་བསབས་མི་རུང་།",
    "ཐོག་མར་མཚན་མོར་ནུ་མ་སྣུན་ཐེངས་ཇེ་ཉུང་ཏུ་གཏོང་བ་ནས་མགོ་བཟུང་སྟེ་ཉིན་མོར་རམ་འདེགས་ཟས་རིགས་ཇེ་མང་དུ་བཏང་ནས་རིམ་བཞིན་དུ་ནུ་མ་སྣུན་མཚམས་གཅོད་དགོས།",
    "བྱིས་པའི་ལུས་ཕུང་རྒྱས་པའི་མྱུར་ཚད་བལྟོས་བཅོས་ཀྱིས་ཇེ་དལ་དུ་སོང་ཡོད་རུང་ནུ་མ་སྣུན་མཚམས་གཅོད་པའི་དུས་སུ་སླེབས་ཡོད་པས།",
    "ཆུ་བཅས་གཙོར་བཟུང་སྟེ་བྱིས་པའི་མ་ལག་ཁག་གི་སྐྱེ་ལུགས་ནུས་པ་ཤུགས་ཆེ་རུ་གཏོང་བ་དང་།",
    "ཐན་ཆུའི་འདྲེས་སྦྱོར་དངོས་རྫས་བཅས་ཀྱི་བསྡུར་ཚད་ནི་ཡིན།",
    "ལྟ་ཚུལ་དེ་དག་ལ་ཕྱོགས་རེ་བའི་རང་བཞིན་ཚད་ངེས་ཅན་ཞིག་ཡོད།",
    "མཆུ་ཏོ་དང་སེན་མོ་སྨུག་པོའམ་སྔོ་ནག་ཏུ་འགྱུར་བ།",
    "སྐེ་མཇིང་རེངས་པ།",
    "ཡང་ན་ཅན་གྱི་རྒུན་འགྲུམ་མངར་ཆའམ་ཚྭ་ཆུ་ཧའོ་ཧྲིན་ཡི་ནང་དུ་ཆིན་མེ་སུའུ་བརྩི་གཞི་ཁྲི་རེ་བསྲེས་ཏེ་ཉིན་རེར་ཐེངས་གཅིག་ལ་སྡོད་རྩའི་ནང་དུ་གནམ་ཁབ་རྒྱག་དགོས།",
    "འགོར་ན་ཆུ་གསོག་པ་ཇེ་མང་དུ་སོང་བ་དང་བསྟུན་ནས་བྲང་ཁའི་ཟུག་རྔུ་ཇེ་ཆུང་དང་ཡང་ན་མེད་པར་འགྲོ་བར་མ་ཟད།",
    "གཞན་ཡང་ལེན་མེ་སུའུ་ཉིན་རེར་ཐེངས་གཉིས་ལ་ཁེ་རེ་ཁབ་རྒྱག་དགོས།",
    "ལྷག་པར་དུ་མཚན་མོར་ལུ་བ་ཚབས་ཆེ་བ།",
    "མིག་འབྲས་སྐྱི་མོའི་འོག་ཁྲག་ཐོན་པ་དང་།",
    "ཟིན་ཏིག་གི་གཞུང་ལྟར་ན།",
    "སྒོག་པ་རྡོག་མ་གཉིས་དང་ཚོད་དཀར་རྩ་བ་ཁེ་ཕྱེ་མ་ཀ་ར་ཁེ་བཅས་གདུས་ཏེ་ཉིན་རེར་ཐེངས་གཉིས་ནས་གསུམ་བར་ལྡུད་པ་དང་བསྟུད་མར་ཉིན་གཉིས་ལ་ལྡུད་དགོས།",
    "ཡིས་ཨན་ཏིན་ཁྲོན་ཉིན་རེར་ཐེངས་གཉིས་དང་ཐེངས་རེར་ཁེ་རེ་འཐུང་བ་དང་།",
    "ཡང་ན་ལིས་ཧྥུའུ་ཕེན་ཉིན་རེར་ཐེངས་གཅིག་དང་ཐེངས་རེར་ཧའོ་ཁེ་ནངས་མོ་ལྟོ་སྟོང་ལ་འཐུང་དགོས།",
    "དབྱི་ཡན་ཅིན་ཉིན་རེར་ཐེངས་གསུམ་དང་ཐེངས་རེར་ཧའོ་ཁེ་རེ་འཐུང་བ་དང་།",
    "དེའི་ཞོར་དུ་ལེན་མེ་སུའུ་ཉིན་རེར་ཐེངས་གཉིས་ལ་ཁེ་རེའི་ཁབ་རྒྱག་དགོས།",
    "བྱིས་པ་ལ་ཉུང་ཙམ་རེ་ལྡུད་དགོས།",
    "མི་དར་མ་ལ་ཉིན་རེར་ཐེངས་གསུམ་དང་ཐེངས་རེར་ཧའོ་ཁེ་བཀོལ་དགོས།",
    "ལེན་མེ་སུའུ་བྱིས་པ་ལ་ཉིན་རེར་ལུས་ལྕི་སྤྱི་རྒྱ་རེར་ཧའོ་ཁེ་བཀོལ་ནས་ཁབ་རྒྱག་པ་དང་།",
    "མི་དར་མར་ཉིན་རེར་ཐེངས་གཉིས་རེ་དང་ཐེངས་རེར་ཁེ་རེ་བསྡོམས་པས་ཟླ་བ་དྲུག་ལ་ཁབ་རྒྱག་དགོས།",
    "དེ་ཡང་ཆེར་སོང་ན་ཕན་ཚུན་འདྲེས་ནས་ཇེ་ཆེར་འགྲོ་བ་ཡིན་ལ།",
    "ཝེ་ཧྲིན་སུའུ་ཧའོ་ཁེ་རེ་ཉིན་རེར་ཐེངས་གསུམ་ལ་ལྡུད་དགོས།",
    "མྱུར་བའི་རང་བཞིན་གྱི་རློན་འབྲུམ་ལས་གྱུར་པ་ཞིག་ཡིན་པས་སྐྱི་པགས་མཐུག་པོར་འགྱུར་བ་དང་ཤའི་རི་མོ་ཇེ་ཟབ་དུ་འགྲོ་བ།",
    "ཕྲུ་གུའི་ངོ་དང་མགོ་པགས་ལ་འབྱུང་སླ་བ་རེད།",
    "ཉིན་རེར་ཐེངས་གཉིས་རེ་བརྗེ་དཀོས།",
    "མྱུར་བའི་རང་བཞིན་གྱི་རློན་འབྲུམ་ལ་སླེ་ཏྲེས་ཞོ་སྐྱེར་ཤུན་ཞོ་དར་མཚར་ཞོ་ཆུ་རྒྱ་མ་གཅིག་ནས་གཉིས་ནང་དུ་གདུས་རྗེས་དྲོ་འཇམ་སྐབས་སུ་ཉིན་རེར་ཐེངས་གསུམ་ནས་བཞི་བཀྲུ་དགོས།",
    "སྐྱི་པགས་ལ་གཙང་སྦྲ་བྱེད་རྒྱུ་རྒྱུན་འཁྱོངས་བྱེད་དགོས།",
    "ཉིན་རེར་ཐེངས་གཅིག་རེ་ཁབ་རྒྱག་དགོས།",
    "ཉི་མ་གཉིས་རེར་ཐེངས་གཅིག་རེ་དང་།",
    "ལག་རྐོང་དང་རྐང་རྐོང་དེསརྐང་ལག་གི་སེན་མོར་གནོད་སྐྱོན་ཐེབས་ན་སེན་མོའི་དབྱིབས་དང་ཁ་དོག་འགྱུར་བ་དང་མཐུག་པོར་འགྲོ་བ།",
    "ཀཎྚ་ཀ་རི་བཅས་སྒྲུབ་བསྲེགས་བཏང་བའི་ཐལ་བ་མར་རྙིང་དང་སྦྱར་ནས་བྱུག་པ་དང་།",
    "ལྕུམ་རྩ་ཆ་དང་སྐྱེར་ཤུན་ལི་ཤི་བཅས་ལ་ཞོ་གསུམ་རེ།",
    "ཆུའམ་ཡང་ན་ཚུའུ་རྒྱ་མ་གང་གི་ནང་དུ་བསྐོལ་ནས་དུས་ཚོད་སྐར་མ་བཅུ་ཙམ་ལ་གདུས་ཏེ་ཁུ་བ་བཀོལ་ནས་ཉིན་རེར་སྐར་མ་བཅོ་ལྔ་ནས་ཉི་ཤུ་བར་དུ་སྦང་དགོས།",
    "ཚ་བ་རྒྱས་ནས་ཉིན་གསུམ་ནས་བཞི་འདས་རྗེས་འབྲུམ་བུ་འབྱུང་མགོ་བརྩམས་ཏེ་ཐོག་མར་རྣ་ལྟག་གི་སྐྲ་མཚམས་ནས་བྱུང་སྟེ།",
    "མིག་དང་སྣ་ཁུང་ཁ་སྦུག་བཅས་ལ་གཙང་སྦྲ་བྱེད་པར་རྒྱུན་འཁྱོངས་བྱེད་དགོས།",
    "ལེན་མེ་སུའུ་ཟླ་ཉིན་རེར་ཐེངས་གཉིས་ལ་ཁེ་རེ་ཁབ་རྒྱག་དགོས།",
    "གློ་ལུ་བྱུང་ཚེ་བྱིས་པའི་གློ་ལུ་འཇགས་ཁུ་ཉིན་རེར་ཐེངས་གསུམ་ལ་ཧའོ་ཧྲིན་ལྡུད་དགོས།",
    "འཇུ་སླ་བོ་མིན་པ་དང་རུལ་མྱགས་སུ་སོང་བའི་ཟ་མ་ཟོས་པའི་རྐྱེན་ལས་བྱུང་བ་ཡིན།",
    "གང་ཐུབ་ཀྱིས་ཨ་མའི་འོ་མར་བསྟེན་དགོས།",
    "ཉིན་རེར་ལུས་ལྕི་སྤྱི་རྒྱ་རེ་ལ་ཧའོ་ཁེ་ཐེངས་བཞིར་བགོས་ནས་འཐུང་ཆོག་ཐན་སོན་ཆིན་ནཱ་ཁེ་དང་།",
    "ཉིན་རེར་ལུས་ལྕི་སྤྱི་རྒྱ་རེ་ལ་ཧའོ་ཁེ་ཡི་ཚད་གཞི་ལྟར་ཐེངས་ཁ་ཤས་བགོས་ནས་འཐུང་དགོས།",
    "པེ་ཀྲུའུ་བརྔོས་མ་པདྨའི་འབྲས་བུ་རྣམས་ཞོ་རེ་དང་།",
    "ཞའོ་མུའུ་ཕེན་དར་མ་ལ་ཐེངས་རེར་ཁེ་དང་ཉིན་རེར་ཐེངས་གསུམ་ལ་འཐུང་དགོས།",
    "ཡང་ན་ཉིན་རེར་ཐེངས་རེའི་ཁབ་རྒྱག་དགོས།",
    "དུས་རྒྱུན་དུ་དྲི་ཆེན་དང་འདྲེས་ནས་ཕྱིར་ཡོང་གིན་ཡོད་ལ།",
    "ཆུས་ཧུའེ་ལིན་ཉིན་རེར་ཐེངས་གཉིས་དང་ཐེངས་རེར་ཁེ་རེ་ཉིན་བདུན་ནས་བཅུ་ལ་འཐུང་དགོས་པ་དང་།",
    "ཡང་ན་ཁྲང་ཁྲོང་ཆིན་ཉིན་རེར་ཐེངས་གཅིག་ལ་ཧའོ་ཁེ་རེ་འཐུང་རྒྱུ་དང་།",
    "འབུ་ཕྲུག་ཤིན་ཏུ་མང་ན་ལུས་ལ་པགས་འབྲུམ་དང་ཆུ་བུར་འབུད་པ་དང་སྐྱི་པགས་ལ་ཟ་འཕྲུག་ལངས་པ།",
    "ལུད་པ་དང་གཅིན་སྐྱག་གི་དོ་དམ་ལ་ཤུགས་སྣོན་བྱེད་དགོས་པ་དང་།",
    "ཆུས་ཧུའེ་ལིན་ཉིན་རེར་ཐེངས་གཉིས་རེ་དང་ཐེངས་རེར་ཁེ་རེ།",
    "ཡང་ན་ཁྲང་ཁྲོང་ཆིན་ཉིན་རེར་ཐེངས་གཅིག་ལ་ཧའོ་ཁེ་རེ་འཐུང་རྒྱུ་དང་།",
