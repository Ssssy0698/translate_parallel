    "དེ་ནས་ལུས་སྦྱང་ལ་ལངས་འདུག་གཉིས་ལས།",
    "དེ་ནས་སྟན་བདེ་བ་ལ་འདུག་སྟེ་ལུས་ཀྱི་འཁྲུལ་འཁོར་སྔར་ལྟར་ལ།",
    "རྣམ་རྟོག་དྲན་པ་སྤང་བླང་དང་བཟོ་བཅོས་མེད་པ་རིག་ཐོག་ནས་གློད་ཅིང་རང་ཤར་རང་གྲོལ་བྱེད་དགོས།",
    "གཉེན་འབྲེལ་གྱིས་མཐའ་བསྐོར་ཀྱང་རང་ལ་མི་ཕན་པ་སོགས།",
    "ས་ལ་ཞག་ཀྱང་ཐིམ་སྟེ་ཞག་དུས་ཚོད་ཀྱིས་འཛད།",
    "དེ་ལྟ་བུའི་དུས་པོ་ཆེ་དེས་གཏུག་ཙ་ན།",
    "ཚད་གསུམ་ལྡན་པའི་སྐྱེས་བུ་དུ་མས་དམ་པ་མཆོག་ཉིད་ལ་ངོས་བཟུང་མཛད་འདུག་པ་དང་།",
    "ཐམས་ཅད་རང་རྩལ་རང་སྣང་རང་དེངས་ནས།",
    "བོད་ཁམས་ཡུལ་གྱི་རྣམ་པ་གསལ་པོར་དོད་ཅེས་འཁོད་འདུག་པ་ལྟར།",
    "ཕྱོགས་བསྡུས་དབྱེ་ཞིབ་གཞིར་བཟུང་སྟེ་གནའ་བོའི་བང་སོའི་ཤུལ་རྗེས་འདི་ལྕགས་རིགས་ཡོ་ཆས་དུས་སྐབས་སམ་བོད་བཙན་པོའི་དུས་ཐོག་མའི་དུས་སྐབས་སུ་གཏན་འཁེལ་བྱས་པ་ཡིན་ཞེས་ཞིབ་འཇུག་པས་བཀོད་འདུག།",
    "གྱང་རོ་དེ་དག་དུས་ཡུན་གང་ཙམ་ཕྱིན་མིན་མི་ཤེས་ཀྱང་གྱང་རོའི་ནང་དུ་སྐྱེས་པའི་ཤིང་སྡོང་ཆེན་པོ་ཁ་ཤས་རྒས་ནས་སྐམ་ཡོད་པ་ཡང་མཐོང་རྒྱུ་ཡོད།",
    "ཡང་རང་ཉིད་ཀྱི་བུ་ཕྲུག་ལའང་བསམ་བློ་མ་བཏང་བར་ཁྱིམ་ཚང་དེ་ལ་གཙང་ཕྱག་ཐེངས་གཉིས་པ་བརྒྱབ་ནས་འགྲོ་མཁན་དེ་འདྲ་དེ་སྔ་མཐོང་གསལ་ལགས།",
    "འཁོད་འདུག་པ་ལྟར།",
    "བཙན་པོ་ལྷ་སྲས་ཤ་ཁྱིའི་སྐུའི་རིམ་གྲོ་ཆེད་རང་ཉིད་ཀྱི་སྲོག་ལ་ཐུག་པ་མན་ཆད་ཀྱི་ཆོ་ག་གང་ཡོད་བསྒྲུབས་ཤིང་རང་ཉིད་སྲོག་ལ་ཕངས་མེད་ཞུས་རྐྱེན།",
    "བརྙས་གཙེར་གཏོང་བཞིན་འདུག་ན།",
    "གོར་ཥའི་སྣ་ལེན་ཁྱེད་རང་གྱིས།",
    "རྒྱལ་བ་བཟང་པོའི་བར་འགལ་བ་ཚབས་ཆེ་བའི་གོ་སྐབས་དེ་ཕག་གྲུས་དམ་འཛིན་བྱས་ནས་རྒྱལ་ཁ་བླངས་ཡོད་བཟོ་འདུག་༢ ཕག་གྲུའི་སྐོར།",
    "ཀོང་པོ་ཨོ་རོང་པ་ཉམས་ཉེས་ཚུལ་དང་ཇུན་གར་གྱི་གཏམ་སྙན་ལ་བོད་འབངས་བླུན་པོ་ཁག་གཅིག་མགོ་བོ་རྨོངས་ཏེ་ཕམ་ཉེས་ཚུལ་རྣམས་འཁོད་འདུག་པས་འདིར་ཕུན་སུམ་ཚོགས་པའི་ཡན་ལག་ཚུལ་དུ་རྒྱས་ཙམ་བཀོད་དོ།",
    "པས་སེ་ཞེས་པའི་ཆོ་ལོ་ཡང་མཉམ་པོར་དྲིལ་བསྒྲགས་པར་གྱུར་ཏོ་ཞེས་འཁོད་འདུགང་ཕོད་པར་དཔོན་གནས་ཐོབ་རྗེས་པས་སེ་སོགས་ཀྱིས་ཁང་ཆེན་པ་བསད་པའི་སྐོར་གླེང་བ།",
    "སྲས་སྐུ་བགྲེས་ལ་རིགས་སྲས་མ་བྱུང་སྟབས་རབ་ཆད་པར་གདའ།",
    "ཡུལ་དེར་གནས་བཅའ་བའི་མི་རྣམས་ནི་བདུད་སྲིན་དང་ཀླ་ཀློ་ལྟ་བུར་བཀོད་འདུག་པ་ཏེ།",
    "དཔའི་སྤྲུལ་པ་ཞིག་བྱོན་པར་འདུག་ཟེར།",
    "ཁྱེད་རང་ཅི་དགར་གྱིས་ལ་སྦྱིན་པར་ཐོང་གསུངས་པ་དང་།",
    "ཕ་རོལ་ཅི་འདོད་སྟེར་བ་རྫུན་མར་འདུག་དམ་བཅའ་དེ་དང་འགལ་བ་ཀྱེ་མ་ཧུད།",
    "བདག་ལ་ཁྱད་མེད་ཁྱེད་རང་ཅི་དགའ་མཛོད།",
    "རྒྱལ་བུ་ཐོངས་ལ་བདག་ཅག་གསོད་པར་ཞུ་ཞེས་རྒྱལ་བུའི་བསླུ་མར་བརྗེ་ནུས་མང་དུ་བྱུང་བར་གདའ།",
    "དགྲ་བོ་དགའ་ཞིང་རང་ཉིད་བརླག་པ་ཡིས།",
    "དུག་མཚོ་ཁོལ་མའི་རྦ་རླབས་སེམས་པ་སྐྱོ་ འདི་ནས་ཐར་བའི་དུས་ནི་མི་འདུག་པས།",
    "ལུས་དང་སྲོག་ལ་འཕངས་པ་མི་འདུག་སྟེ།",
    "ཕར་ལམ་ཟླ་དྲུག་ཚུར་ལམ་ཟླ་བ་དྲུག་ལོ་དུས་རང་ཡུལ་སླེབས་པ་སྙམ་པ་འདུག་དེ་ཡི་བར་དུ་དལ་གྱིས་བྱོན་ན་མི་ལེགས་སམ་ཞེས་ཞུས་པར།",
    "དེར་སྲས་གསུམ་ཡབ་ཡུམ་གྱི་མཚན་ནས་འབོད་ཅིང་ངུས་སོ་ཞེས་འཁོད་འདུག་པ་ལྟར།",
    "ཡུམ་གཉིས་ཀྱི་ཕྱག་དང་བསྐོར་བ་ལ་སོགས་མཆོད་ཅིང་བསྟོད་དོ་ཞེས་པར་གཞིགས་ན་དེ་ལྟ་བུའི་ངོ་མཚར་གྱི་གནས་ཞིག་ཀྱང་བྱུང་བར་གདའ།",
    "ཕ་མ་ལ་སོགས་རང་ཡུལ་དྲན་པ་འདུག་ཅེས་ཞུས་པར།",
    "རང་རང་སོ་སོའི་ས་རིས་ཡང་",
    "དུས་རྟགས་ངེས་པར་བལྟ་ཞིང་རང་ཉིད་སྒྲུབ་ལ་བརྩོན",
    "ཡུལ་ལམ་བྱེས་གསུམ་གར་འདུག་ཀྱང་",
    "ཙ་ནི་ཀླུ་བདུད་རྡོ་རྗེ།",
    "རྡོ་རྗེའི་ར་བ་མེ་རིས་ཡོངས་སུ་བསྐོར་བའི་རྣམ་པ་ཞེས་འཁོད་འདུག་༢ གནས་ཡོངས་སུ་བསྐོར་བའི་ཕྱིའི་རྣམ་པ་དང་།",
    "ཁྱེད་རང་ཡང་འཐུང་གསུངས།",
    "ཁོང་རང་ལྷ་འདྲེ་ཟིལ་གནོན་གྱི་ཏིང་ངེ་འཛིན་ལ་ཞག་བདུན་བཞུགས་པས།",
    "ལུས་སྲོག་ལ་ལྟོས་པ་མེད་པ་ཞིག་འདུག་སྟེ།",
    "ལུང་པ་དེའི་བྱང་ངོས་ཀྱི་མཛེས་སྡུག་ལྡན་པའི་ཧི་མ་ལ་ཡི་རི་བརྒྱུད་ཀྱི་ལ་ཆེན་དེར་དམག་རི་ལར་འབོད་ཀྱིན་འདུག་ཅིང་།",
    "ཕྱིས་སུ་ཀུན་དགའ་དོན་འགྲུབ་ཀྱིས་འཁྲུལ་ལ་བརྟེན་ནས་སྤངས་མདའི་ཡུལ་མི་རྣམས་ཀྱིས་མི་རྒོད་ནགས་ཚལ་དེ་ཡང་མར་ལྟང་རང་བྱོན་གྱི་སྤུན་ཟླར་བསྒྱུར་བཟོ་བྱས་འདུག་ཟེར།",
    "ཞེས་འཁོད་འདུག་པ་དང་།",
    "ལྷག་པར་དུ་རྩ་ཀླུ་བདུད་རྡོ་རྗེ་ཆུ་འགྲོ་བ་འདྲེན་པ་སོགས་ཀྱི་བཀོད་པ་ཁྱད་དུ་འཕགས་པས་ཡོངས་སུ་བསྐོར་བའི་དབུས་འདིར་ཀོང་པོ་བུ་ཆུ་གསེར་གྱི་ལྷ་ཁང་འདི་ཉིད་གསེར་བྱ་གནམ་ལ་ལྡིང་འདྲའི་གསེར་འོད་ཆེམ་མེར་གནས་སོ་ཞེས་འཁོད་འདུག་༣ ནང་རྟེན་སྐོར་ནི།",
    "འཇམ་དཔལ་ཁྲོ་བོ་ཡང་ཟློག་མེའི་སྤུ་གྲི་བཅས་ཡོད་པ་གསལ་འདུག་ཀོང་སྨད་རྒྱ་ལ་སེང་དོང་དུ་བཞུགས་པའི་གཤིན་རྗེའི་རང་བྱོན་སྐོར་དང་།",
    "ནང་སྒོ་ན་དཔལ་རྟ་མགྲིན་བཞུགས་འདུག་པ་ལ་ཡང་གནང་བ་ཞུས་ནས་ཕྱིན་པས།",
    "མཐར་ཐུག་གང་ལ་འབྱོན་ཞུ་ཡིན་འདུག།",
    "ཞེན་པ་ཙམ་ཡང་མི་བྱ་འོ་ ཞེས་པའི་དོན་མ་གོ་འདུག་ལོག་ལྟ་བྱས་པས་ལན།",
    "ཁོས་ལྟ་བ་ལ་ཕྱིན་པས་གཡུ་ཐོག་པ་ཁྱིམ་ན་འདུག་པ་མཐོང་བས།",
    "ཁྱེད་སྒྲུབ་ཐོག་ཏུ་འདུག་པ་ངོ་མ་ཤེས།",
    "ས་འོག་དོང་དུ་བཅུག་དུས་སུ།",
    "ང་རང་གསང་བའི་མཁའ་འགྲོ་ཡིན་ཟེར་རོ།",
    "ཁྱི་དང་བྱ་ལ་སོགས་པའི་རྣམ་པར་ཞབས་པུས་གཡོན་གྱི་འོག་ན་དབུགས་ལྷེབ་ལྷེབ་འདུག་སྤྱན་དྲག་པོའི་ལྟ་སྟངས་ནམ་མཁའི་ཁམས་ལ་མཛད་པས།",
    "གཟའ་སྐར་རྣམས་འཇིགས་ཤིང་སྐྲག་ནས་མདངས་མེད་པར་ཧྲིབ་བེ་འདུག་པ་རྣམས་ལ།",
