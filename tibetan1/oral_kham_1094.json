    "དུས་ནམ་ཡང་རང་རྒྱུད་གདུང་གདུང་ནས།",
    "རང་འཆི་ཁར་ཐུག་དུས་འགྱོད་པ་འབྱུང་།",
    "གཏམ་གྱི་མཐའ་མ་ཁ་ཆེམས་འཇོག་དུས་དེར།",
    "མཁས་ཀྱང་རང་རྒྱུད་མི་ཐུལ་ང་ཆེའི་རྒྱུ།",
    "སྤྲང་པོ་འགྲོ་དགོས་བསམ་པ་ཡེ་མི་གདའ།",
    "དུས་ད་ལྟར་སྡུག་བསྔལ་མྱོང་རན་འདུག།",
    "དུས་ད་ལྟར་རང་རྒྱུད་བསྲེགས་ནས་གདའ།",
    "དུས་ད་ལྟར་ཡིད་རྩ་འཁུམས་ནས་གདའ།",
    "སྦྱིན་དགེ་ཚོགས་ཀྱི་རྒྱགས་ཕྱེ་མི་འདུག་གམ།",
    "གནས་ཕ་རོལ་ཡུལ་དུ་འགྲོ་དགོས་གདའ།",
    "ཡོད་དགོས་པར་མཆིས་ཏེ་མི་གདའ་བ།",
    "དུས་ད་ལྟར་བོན་རྒན་སྐྱོ་སྟེ་གདའ་།",
    "དགྲ་འཆི་བདག་གཤིན་རྗེ་འདི་འང་ནམ་སླེབ་ཆ་ནི་མི་འདུག་པར།",
    "དུས་ད་ནི་སྤྲང་རྒན་སྐྱོ་སྟེ་གདའ།",
    "ནམ་ཡང་རང་སེམས་རང་ལ་དཀར་ངེས་པས།",
    "མཐོ་ཡང་རང་ལ་མི་ཕན་ཀུན་དང་འགྲས།",
    "མཁས་ཀྱང་རང་རྒྱུད་མི་ཁྲོལ་རྩོད་པ་འཕེལ།",
    "ནམ་ཕུགས་མི་རྟག་ངེས་ཀྱང་འདུག་ཆུས་གཟབ།",
    "ཟས་ནོར་འཁོར་ལ་ཆགས་ཞེན་ཚེ་འདུག་ན།",
    "སེམས་ལ་ཁེངས་དུས་ཙམ་ཞིག་མི་འདུག་ན།",
    "ཟོས་ཀྱང་སེམས་ལ་ངོམས་དུས་མི་འདུག་ན།",
    "ནམ་ཡང་རང་ངན་མ་གཏོགས་མེད་ངེས་ན།",
    "མི་ཚེ་འདི་རིང་པོ་མི་འདུག།",
    "གདོང་མིག་ཅེར་ཅེར་བལྟས་ཀྱང་རང་གཤིས་ནི་མ་མཐོང་།",
    "ཕཊ་སྒྲ་ངར་སྐད་བཅས་ཡང་དམིགས་རྩལ་ནི་མི་འདུག།",
    "མངར་དགུ་སྐོམ་དུ་བཏུང་ཡང་ངོམས་དུས་ནི་མི་འདུག།",
    "དེ་མིན་ལྷ་སྒོམ་སྔགས་བཟླས་དགོས་པ་ཡང་མི་འདུག།",
    "ཟིན་མེད་བྱ་བ་མ་མང་རོ་ལྟར་འདུག།",
    "ཕྱི་མར་ཕན་པའི་དགེ་སྦྱོར་བྱས་འདུག་གམ།",
    "སྤྱོད་ལམ་གང་ཡང་རང་ཁར་མི་ཤོར་བར།",
    "སླར་ཡང་རང་ལུས་ལྷར་གསལ་བདུད་རྩིའི་ཆར།",
    "འདི་ལྟར་ཟ་ཉལ་འགྲོ་འདུག་ལ་སོགས་པ།་",
    "ལམ་གང་ཡང་རང་ཁར་མི་གཏོང་ཞིང་།",
    "མཁོ་བ་རང་རང་ལ་མང་མང་ཡང་རྙེད་དཀའ་ན།",
    "ངས་ནི་ཡང་ཡང་རང་ལ་བརྟགས་བྱས་པས།",
    "སང་ཕོད་བཞེ་ཕོད་འདུག་ཆུས་ལ་བརྩོན་ཏེ།",
    "ངས་ནི་འདི་ཕྱི་གཉིས་མེད་བྱེད་ཀྱིན་འདུག།",
    "ངས་ནི་རང་གཞན་གཉིས་མགོ་བསྐོར་གྱིན་འདུག།",
    "གཅིག་པུར་འདུག་པས་ལེ་ལོ་ཇེ་ཆེ་བྱུང་།",
    "ང་ལ་རྟོཊ་པ་དེ་འདྲ་འཆར་གྱིན་འདུག།",
    "ང་ནི་གོལ་ས་བཞི་ལ་གོལ་ཉན་འདུག།",
    "ང་ནི་རིག་པ་དུམ་བུར་ཆོད་ཀྱིན་འདུག།",
    "ལོངས་སྤྱོད་སྒྲུབ་ཀྱང་རང་བཞིན་རྙེད་དཀའ་ཞིང་།",
    "བསྟན་དང་འགྲོ་བའི་དོན་ཆེན་བྱུང་ཚུལ་འདུག།",
    "སྡུག་འདི་ཆགས་པ་མི་འདུག་སྐུ་ཚེ་རིང་།",
    "གར་ཕྱིན་གར་འདུག་སྤྲང་པོའི་ཚུལ་བཟུང་ལ།",
    "དྲན་རྟོག་རང་བྱུང་རང་ཤར་རང་གྲོལ་གྱི་ངང་དུ།",
    "ནམ་འཆི་ངེས་པ་མི་འདུག་དེ་བས་།",
    "བཞག་མཁན་རང་ཡང་རང་བཞིན་མ་གྲུབ་སྟེ།",
    "བསྒོམས་ཀྱང་རང་ལ་མ་བསྒོམ་ཀྱང་ནི་རང་།",
    "བདེ་བའི་གདན་ལ་གཡོ་མེད་འདུག།",
    "འདུག་ས་རི་ཁྲོད་མིན་པའི་གནས་ས་མེད།",
    "རིག་རིག་མཐོང་མཐོང་རང་སྐྱོན་མི་སྤང་བར།",
    "ཚེ་འདིའི་ཆུས་དང་རང་སྲིད་ཉམས་དོགས་ནས།",
    "ད་ནི་ལྷ་ཡང་མི་བསམ་ལྷ་ཡང་རང་།",
    "ད་ནི་འདྲེ་ཡང་མི་བསམ་འདྲེ་ཡང་རང་།",
    "ད་ནི་ཅི་བྱུང་མ་བྱུང་རང་དགར་བྱེད།",
    "དང་པོ་སེམས་འདི་གར་འདུག་ལྟོས།",
    "མི་ལུས་ཐོབ་པའི་ཕན་པ་མི་གདའ་ལགས།",
    "ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "དགེ་སྦྱོར་བྱེད་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "ཐོས་བསམ་སྦྱོང་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "བསྙེན་སྒྲུབ་བྱེད་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "དྲང་སྲོང་ཡིན་ལོས་ཕན་པ་མི་གདའ་ལགས་།",
    "གཞན་ཕན་བསྒྲུབ་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "གསང་སྔགས་ཡིན་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "མཁས་པ་ཡིན་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "དབེན་པ་བསྟེན་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "བསྐྱེད་རྫོགས་སྒོམ་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "བཟླས་བརྗོད་བྱེད་ལོས་ཕན་པ་མི་གདའ་ལགས་།",
    "སེམས་ངོ་འཕྲོད་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "ཉམས་ལེན་བྱེད་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "ལྟ་བ་རྟོགས་ལོས་ཕན་པ་མི་གདའ་ལགས་།",
    "སྤྱོད་པ་དག་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "འབྲས་བུ་བསྒྲུབ་ལོས་ཕན་པ་མི་གདའ་ལགས་།",
    "སྒོམ་ཆེན་ཡིན་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "པ་མི་གདའ་ལགས།",
    "རྟོགས་པ་མཐོ་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "ཡིན་ལུགས་ཤེས་པས་ཕན་པ་མི་གདའ་ལགས།",
    "ཐུན་བཞིར་སྐྱོང་ལོས་ཕན་པ་མི་གདའ་ལགས།",
    "རང་རང་སྨིན་པར་འགྱུར་བ་ལྟར།",
    "དེ་ཡང་རང་ཉིད་ཞི་བདེ་ཙམ་མ་གཏོགས།",
    "སིལ་བུ་གསེར་དངུལ་ལེན་དང་གནས་གཅིག་འདུག།",
    "འདུག་ན་ཁ་སྦུབ་གན་རྐྱལ་རྐང་རྐྱང་དང་།",
    "འདོད་ཀྱང་རང་དོན་ཁོ་ན་འདོད་པ་དང་།",
    "ཁེ་གྲགས་འདོད་དང་རང་ཆེ་འབྱིན་པ་དང་།",
    "ལོངས་སྤྱོད་འབྱོར་པ་ཆེ་ཡང་རང་སྡུག་གཞི་མ།",
    "འཆི་ཁར་ཐུག་དུས་འགྱོད་ཀྱང་ཕྱིས་པས་མི་ཕན།",
    "འདུག་པའི་གནས་ནི་མི་ནག་ཁང་ཁྱིམ།",
    "ལོ་ཟླ་ཞག་དུས་ཀུན་གྱི་དང་པོ་ལ་།",
    "ཡིས་འཁྱེར་དང་རང་བཞིན་སྟོང་པ་དང་།",
    "ཤ་ཆང་བཟའ་བཏུང་ཐབས་ཤེས་ཀྱི་རོལ་པ་ཞེས་བྱ་བ་ཡིན་ཟེར་ཞིང་སྲོག་གཅོད་པའི་ཤ་ཁྲག་ལ་ལོངས་སྤྱོད་པར་འདུག་སྟེ།",
    "སེམས་ཉིད་གནས་ལུགས་ཀྱི་དོན་ལ་མཉམ་པར་བཞགས་ཀྱིན་སེམས་ཞི་བར་གནས་ཙ་ན།",
    "རིག་པའི་ཡེ་ཤེས་གསལ་སྒྲིབ་མེད་པར་རང་ལ་རང་ཤར་དུ་རྒྱུད་ལ་བསྐྱེད་ཅིང་བསྒོམ་ཙ་ན།",
    "སྤྱོད་ཚུལ་རྣམ་པར་དག་ཅིང་ལུས་ཀྱི་འདུག་སྟངས་གཟོབ་ནས་ཡོད་ཙ་ན།",
    "ཆང་འཐུང་བ་ཙམ་གྱིས་སྔར་གྱིས་འདུག་ཚུག་ཅིག་ནས་རོ་ཉལ་དང་རྐང་རྐྱང་གཞོག་སྙེལ་ལ་སོགས་བྱེད་ཅིང་དམ་པའི་སྤྱན་ལམ་དུ་མི་མཛེས་པ་དང་།",
    "ཞི་དུལ་དང་བག་ཡོད་ཀྱི་བསླབ་པ་ལ་གནས་ཤིང་ཚུལ་དང་ལྡན་ཙ་ན།",
    "བྱམས་པ་ལ་སོགས་སྟོབས་ལྔ་རྒྱུད་ལ་བསྐྱེད་ཅིང་དོན་ལ་གནས་ཙ་ན།",
    "འཕྲུལ་ངག་བདེན་པའི་བོན་ལ་ཉན་ཅིང་ཐོས་བསམ་སྦྱང་ཙ་ན།",
    "གཞན་གྱི་གནོད་པ་བྱེད་པ་སོགས་ལ་ཁོང་མི་ཁྲོ་ཞིང་སྲན་དང་བཅས་པས་བཟོད་པ་སྦྱང་ཙ་ན།",
    "གཡག་འདི་ཞེས་བྱ་བ་གསོད་ན་ཤ་ཚོན་པོ་ཆེ་འདུག་སྙམ་པའི་སྐབས།",
    "གཞན་ཡང་སྣ་ད་དང་ཁ་དུ་ལ་སོགས་འཐུང་པའི་མི་དེ་ལ་དུག་རྫས་དེ་དག་མེད་པ་ཞག་གཅིག་ཀྱང་འདུག་ཐབས་མེད་པ་ལྟར་གྱུར་ནས་འདོད་ཆགས་ཀྱིས་སྣ་ད་འཐུང་འདོད་སྐྱེས་ནས།",
    "གཞན་ཡང་རང་ལུས་ལ་ཞི་ཁྲོའི་ལྷ་ཚོགས་གནས་པ་རྣམས་ཀྱང་།",
    "རྟ་ཐམས་ཅད་དེ་ག་ལ་བདག་མེད་དུ་བསྐྱུར་ནས་ཁོ་རང་རི་ནག་ར་བྱ་བ་ལ་བྲོས་ཏེ་དགེ་སྦྱོར་བྱེད་ཀྱིན་འདུག་ཟེར།",
