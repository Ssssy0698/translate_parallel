    "ང་རང་ད་ལྟ་ལོ་གྲངས་ན་ཚོད་གཞོན་པ་ཡིན།",
    "འཆི་བ་འདི་མི་རྟག་པའི་རང་བཞིན་ཡིན་ཚོད་དུ་འདུག་ཀྱང་།",
    "མ་བྱིན་པ་བླངས་པས་ཚེ་རབས་ཐམས་ཅད་དུ་དབུལ་པོར་འགྱུར་ཞིང་རང་ལ་ནོར་རྫས་ཡོད་ཀྱང་གཞན་གྱིས་རྐུ་འཕྲོག་བྱེད་ཤོར་བ་དང་།",
    "གཙང་སྦྲ་ཆུང་བ་དང་དངོས་གྲུབ་མྱུར་བའི་ལྷ་ཞིག་དགོས་པ་ལ་དེའང་མི་འདུག་ད་ནི་ང་རང་ཤི་ན་དགའ་སྙམ་པ་ཞིག་ཐུགས་ལ་ཤར་བས།",
    "ཞལ་བཅུ་གཅིག་པའི་སྨྱུང་གནས་འདི་ཕན་ཡོན་ཤིན་ཏུ་ཆེ་ཡང་འདི་ནུས་པ་ཤིན་ཏུ་ཉུང་བར་འདུག་གསུངས།",
    "དེ་ནས་ཚེ་འཕོས་མ་ཐག་ཏུ་བདེ་བ་ཅན་དུ་སྐྱེ་བར་འདུགསྨྱུང་གནས་རྣམ་དག་ཚར་བརྒྱད་བྱས་ཤིང་།",
    "དེ་ནས་ཞལ་འཛུམ་ཞིག་མཛད་དེ་ཧེ་འགྲོ་བའི་སྐྱབས་མགོན་ཆེན་པོ་ཞིག་འོང་བར་གདའ་ཡི་གསུངས་ཏེ་ཐུགས་དགྱེས་པས་རྗེས་སུ་བཟུང་ནས།",
    "ལུང་བསྟན་ཅིག་དེར་འོང་བར་གདའ་ཡི་གསུངས་པའི་ལུང་བསྟན་ལ་བརྟེན་ནས།",
    "དེ་ནས་མདུན་དུ་གུས་པའི་སྤྱོད་ལམ་གྱིས་འདུག་སྟེ་རྗེས་ཟློས་བྱེད་དགོས་ཤིང་།",
    "སླར་ཡང་རང་ཉིད་ཀྱི་དད་གུས་གདུང་ཤུགས་དྲག་པོའི་སྒོ་ནས་ཐུགས་རྒྱུད་བསྐུལ་ཏེ་མཁྱེན་པར་གསོལ་བ་ལ།",
    "མཐོན་པོ་ཤིང་ཁྲི་ཡིན་ཀྱང་ཁྲུ་གང་ལས་ལྷག་པ་སོགས་ཀྱི་སྟེང་དུ་འདུག་པར་མི་བྱ་ཞིང་།",
    "ལུས་ཀྱི་ཁ་དོག་མི་མཛེས་པ་ཞིག་ཏུ་སྐྱེས་འདུག།",
    "ཚེ་འཕོས་མ་ཐག་ཏུ་བདེ་བ་ཅན་དུ་སྐྱེ་ངེས་པར་ཅན་དུ་འདུག་ཅེས་གསུངས་པ་དང་།",
    "ཤར་དུ་ཁ་བལྟས་ཙོག་པུར་འདུག་ལ།",
    "ན་མ་ཨཱརྱ་ཛྙཱ་ན་སཱ་ག་ར་བེ་རོ་ཙ་ན་བྷ་ཧ་རཱ་ཛཱ་ཡ།",
    "བར་དུ་ལག་བཞག་ཙོག་ཙོག་པོར་འདུག་ནས།",
    "ཙོག་པུར་འདུག།",
    "ཁོ་རང་དགྲ་བཅོམ་པའི་འབྲས་བུ་ཐོབ་པས་ངོ་མཚར་ཆེ་གསུངས།",
    "ལྷ་མཐོང་འདྲེ་མཐོང་བྱེད་པ་འཆི་བ་སྐད་ཅིག་ཡུད་ཙམ་ཡང་མི་དྲན་པ་ཚེ་འདིའི་བྱ་བ་སྒྲུབ་པ་ཞིག་འདུག་སྟེ།",
    "ཆང་ཕོར་གང་བཏུང་བས་གསོ་སྦྱོང་དང་འགལ་ནས་ད་ལྟ་རོད་ཤིན་ཏུ་ངན་པའི་ཤེས་པ་མཐོ་དམན་ཅན་གཅིག་ཏུ་སྐྱེས་གདའ་སྟེ།",
    "འོད་དཔག་མེད་པ་ཡི་དམ་བྱེད་པ་གདའ་གསུངས།",
    "དེ་ནས་ཚེ་དུས་བྱས་ནས་བདེ་བ་ཅན་དུ་སྐྱེ་བར་གདའ་གསུངས།",
    "རྔོ་བཏོག་ཚོང་དང་འགྲོ་འདུག་ལ་སོགས་པ།",
    "འདི་ཉིད་དུ་བཙུད་པས་ད་ནི་ཐར་ཁུང་མི་འདུག་ཅིང་།",
    "ཞེས་ཡང་ཡང་བརྗོད་འདུག་དགོས།",
    "གནས་པ་པོ་མིན་འགྲོ་བ་མིན།",
    "དེ་ཉིད་དང་གཞན་ཉིད་དུ་བརྗོད་དུ་མེད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་དོ་ཞེས་ཀྱང་བརྗོད་པར་མི་ནུས་ཏེ།",
    "བགྲོད་པར་བྱ་བའི་ལས་ལམ་གསུམ་ཀ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ན་དེའི་ཁོངས་སུ་འདུས་པས་སྐྱེ་མཆེད་རྣམས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་དོ་སྙམ་ན།",
    "སྨིག་རྒྱུ་ལ་སོགས་པའི་དཔེས་ཐ་སྙད་དུ་ཡོད་ཀྱང་རང་བཞིན་གྱིས་མེད་པ་བསྒྲུབ་པར་བྱ་བ་དང་མཚུངས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཁོ་བོ་ཅག་དུས་གསུམ་རྫས་སུ་འདོད་པས་མ་འོངས་པ་ན་རྩ་བའི་སྐྱེ་བ་སྐྱེ་བཞིན་པ་ཡོད་པ་དེས་སྐྱེ་བའི་སྐྱེ་བ་བསྐྱེད་པར་བྱེད་ལ།",
    "མེད་པ་དེ་ཡིས་སྐྱེ་བའི་སྐྱེ་བ་དེ་བསྐྱེད་པར་ནི་འདོད་ལ་རག་ན་ཡང་རང་ཉིད་མ་སྐྱེས་ཤིང་མེད་པས་མ་སྐྱེས་པ་གཞན་སྐྱེད་པར་ཡང་མི་ནུས་པའི་ཕྱིར།",
    "སྣང་མུན་ཡུལ་གཅིག་ཏུ་འགལ་བས་མར་མེ་དང་ནི་ཡུལ་གཞན་གང་དག་ལ་མར་མེ་དེ་འདུག་པ་ན་བསལ་བྱའི་མུན་པ་མེད་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་དུས་གཉིས་པར་འགག་བཞིན་མ་ཡིན་པ་དེ་ནི་དངོས་པོར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "མཚན་ཉིད་སྐྱེ་དང་གནས་དང་འཇིག་པ་རྣམས་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་ཕྱིར་ན་འདུས་བྱས་ཀྱི་མཚན་གཞི་གཟུགས་སོགས་རྣམས་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཉེ་བར་ལེན་པ་པོའི་བདག་གཉིས་ཕན་ཚུན་ལྟོས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་མི་འགལ་ཏེ།",
    "སྔ་ཕྱི་ལ་ལྟོས་པ་དགག་དུས་མཉམ་ལ་ལྟོས་པ་དགག་གྲུབ་མ་གྲུབ་ལ་ལྟོས་པ་དགག་དོན་བསྡུ་བའོ།",
    "ལྟོས་པ་ཉིད་ཀྱང་རང་བཞིན་གྱི་མ་གྲུབ་སྟེ།",
    "རང་ཉིད་སྔ་ཞིང་རང་དང་གཞན་གྱི་རྒ་ཤི་ཕྱི་བ་ཡིན་པའི་ཕྱིར།",
    "བརྫུན་ཞིང་རང་བཞིན་མེད་པ་ཡིན་པས།",
    "ཁྱབ་བྱེད་རང་བཞིན་དང་ནི་གཞན་དངོས་དག་ཡོད་ན་དངོས་པོ་གྲུབ་པར་འགྱུར་ན་ཡང་རང་བཞིན་དང་གཞན་དངོས་མ་གྲུབ་པའི་ཕྱིར།",
    "ཆུད་མི་ཟ་དེ་ཡང་རང་བཞིན་ལུང་དུ་མ་བསྟན་པ་སྟེ།",
    "དེས་ན་ལས་ཐ་སྙད་དུ་འགགས་ཀྱང་རང་བཞིན་གྱིས་མི་འགག་པའི་དོན་ནི།",
    "ཟ་བ་པོ་དེ་ཡང་རང་བཞིན་གྱི་མ་གྲུབ་སྟེ།",
    "འདས་པ་ལ་ལྟོས་པ་དང་མ་ལྟོས་པར་མ་གྲུབ་པ་དེའི་ཕྱིར་ད་ལྟར་བྱུང་བ་དང་མ་འོངས་པའི་དུས་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་པའོ།",
    "རྒྱུ་ལ་འབྲས་བུ་ཡོད་མེད་བརྟག་སྟེ་དགག་ནུས་པ་ལ་བརྟག་སྟེ་དགག་དུས་ལ་བརྟག་སྟེ་དགག་བྱ་བ་ལ་བརྟག་སྟེ་དགག་པའོ།",
    "འབྲས་བུ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའམ།",
    "འབྲས་བུ་ཞེ་སྡང་རང་བཞིན་གྱིས་ཡོད་པར་ག་ལ་འགྱུར་ཏེ།",
    "འཇིག་རྟེན་པའི་ཐ་སྙད་ཟོ་ཤིག་འདུག་ཤིག་ཅེས་སོགས་ནི་ཀུན་ལའང་གནོད་པ་བྱེད་པ་ཡིན་ནོ།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྟོང་པ་དེ་ནི་བརྟེན་ནས་གདགས་པ་ཡིན་ཏེ།",
    "སུམ་རྟགས་ཀྱི་དོགས་གཅོད་དྲི་བ་དྲི་ལན་མཛདརིགས་སེགས་ཁག་མང་རྣམས་ལ་ཞིབ་འཇུག་ཆོར་བྱས་ཀྱང་དེ་དག་ཚང་མར་ཐུ་མི་ངལ་བསོ་ཞེས་བྱ་བ་ལ་སོགས་པ་མིང་ཚིག་པ་ཤ་སྟག་འདུག་རུང་།",
    "ཞེས་སོགས་གསུངས་འདུག་པའི་དགོངས་པ་ལྟར་ཀྱང་འང་ཡང་གསུམ་གྱིས་དོན་ལ་སྐུགས་༢་ཚོག་རྒྱུན་རུང་གཤསཾམ་དོར་བ་དང་།",
    "སྡུད་ཚིག་དང་ཚིག་སྔ་ཕྱི་མཚམསསྦྱོར་སོགས་དུམལ་འཇུལ་བསནས་སྐྲུན་ལས་ཀྱིསྒྲ་ལས་ཅུང་ཟད་ལྷག་གོ་ཞེས་གསུངས་འདུག་པ་བཅས།",
    "དེམ་བྱུང་ཞེས་སོགས་བཀོད་འདུག་རུང་།"
  ]
}