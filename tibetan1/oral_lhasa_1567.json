    "ཕྱོགས་ལས་རྣམ་རྒྱལ་གྱི་སྤྱོད་པ་བྱས་པས་ས་དང་པོ་མཐོང་བའི་ལམ་མངོན་དུ་བྱས།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "དེ་ཐམས་ཅད་གང་ཟག་དེའི་ངོར་རྟེན་དང་བརྟེན་པར་བཅས་པའི་དཀྱིལ་འཁོར་དུ་ཤརབས།",
    "མ་དག་པའི་སྣང་བ་ཐམས་ཅད་ཅུང་ཟད་ཀྱང་མེད་པར་འགྱུར་བ་ཡིན་ལ།",
    "མཐར་ཐུག་གཟུགས་ཀྱི་སྐུ་འགྲུབ་པར་བྱེད།",
    "དེ་ལ་ནི་ལམ་གཞན་གྱི་སྤྲོས་པ་ཅིའང་མི་དགོས་གསུངས།",
    "དུས་མིན་ལྷ་ནི་གསོད་པར་བྱེད།",
    "གསང་བའམ་སྣང་བའི་འཆི་ལྟས་གསུམ་གྱི་སྒོ་ནས་བརྟག་པར་བྱེད།",
    "རྐྱེན་མེད་པར་སྔར་ལས་ཉམས་སྣང་གསལ་བ་དང་།",
    "དེ་བཞིན་དུ་གཡོན་ནས་ཞག་གསུམ་ལས་ལྷག་པར་རྒྱུ་ན་ཞི་རྒྱས་ཀྱི་ལས་ཅི་རིགས་འགྲུབ་པའི་ལྟས་དང་།",
    "མཚམས་སུ་བཞག་ནས་མཁྲིག་མའི་ཐད་དུ་རྦད་ཀྱིས་ཆོད་པར་སྣང་བ་རྣམས་ནི་ངེས་པར་འཆི་བའི་ལྟས་ཡིན་ལ།",
    "རང་གཅེར་བུར་བྱས།",
    "རོ་གཏུམ་པ་འདྲ་ན་བསླུ་མི་ཐུབ་པར་བཤད།",
    "ཚེ་འཕེལ་ཞིང་འཕྲལ་རྐྱེན་ཐམས་ཅད་སེལ་ནུས་པ་ཡིན་གསུངས།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "ཨོཾ་ཨཱ་ཧཱུྃབཟླས་པའི་བར་བདག་རྣལ་འབྱོར་སྲུང་བ་སྔར་བཞིན་བྱས་ནས།",
    "ནན་ཏན་གྱི་ཚུལ་དུ་ཞག་བདུན་ལ་སོགས་པར་བསྒོམ་གསུངས།",
    "དེ་གང་བྱས་ཀྱང་ལྟས་དེ་དག་ཞི་བར་མ་ནུས་ན་དུས་ལ་བབས་པ་ཡིན་པས་ཚེ་འདི་ལ་ཡིད་མ་ཞེན་པར་བྱས།",
    "མི་བཞུགས་ན་རང་ཉིད་ཀྱི་རྡུལ་ཚོན་ནམ།",
    "སེམས་གནོང་འགྱོད་མེད་པར་བྱས།",
    "དེ་ནས་ཞེ་ལྔའི་བར་དུ་ཐམས་ཅད་འཕེལ་འགྲིབ་མེད་པར་བརྟན།",
    "དེ་ལ་རང་སེམས་བསྲེས་ནས་འཛིན་མེད་དུ་འཇོག་རིག་པ་ཧུར་ཕྱུང་ནས་ཡེ་མ་ཡེངས་པར་བྱེད།",
    "གསང་རྟགས་སྲིན་བུ་མེ་ཁྱེར་ལྟ་བུ་འབྱུང་གསུངས།",
    "སྟོན་གྱི་ནམ་མཁའ་དྭངས་པའི་དབྱིངས་ལྟ་བུ་ཞིག་རྗེན་པར་འཆར་ལ།",
    "སྐབས་འདིར་གཙོ་བོར་སྣང་བ་བསྒྱུར་བའི་འདའ་ཁ་མ་བྱ་གསུངས།",
    "རིག་པ་བརྗོད་མེད་དུ་འཇོག་ཁྱད་པར་ཟས་ཟ་བ་དང་།",
    "དེས་བཏགས་པའི་གསང་མཚན་རྣམས་དྲན་པ་གལ་ཆེ་གསུངས།",
    "སྔོན་བྱུང་སྲིད་པའི་ཤ་ཚུགས་ཅན་སོགས་གསུངས་ཏེ།",
    "དེ་དག་འཁྲིག་པར་མཐོང་ན་རིམ་བཞིན་གླིང་གཞན་གསུམ་དུ་སྐྱེ་བའི་ལྟས་ཡིན་ལ།",
    "བསྣམ་བྱའི་འོད་ཤར་བའི་ཚེ་དེ་དག་ལ་སེམས་མ་ཆགས་ཤིང་ཞེན་པ་མེད་པར་བྱས།",
    "སྐྱེ་གནས་ངན་པ་ངེས་པར་བསྲུང་བ་ཡིན་ཏེ།",
    "ཀྵེ་ཏྲ་པ་ལས་བསྲུང་པ་བཞིན་ནོ་གསུངས།",
    "སྐུ་བཞིའི་རང་བཞིན་གྱིས་ལྷུན་གྲུབ་མྱུར་དུ་ཐོབ་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "ལྷ་ཁང་མུན་པ་ཅན་དུ་སྒྲོན་མེ་བཏེག་པ་ལྟར་ཅིག་ཆར་ལམ་གྱིས་གསལ་བར་བྱས་པ་རིམ་བཞིན་གསལ་འདེབས་པར་བྱེད།",
    "སྤྲོ་ན་སྣང་སྲིད་ཐམས་ཅད་ལྷར་གསལ་བས་བླང་ན་ཆོག་གསུངས།",
    "ལྷ་སྣམ་དང་པོའི་ཕྱོགས་མཚམས་སུ་སེམས་དཔའ་བརྒྱད།",
    "དྲུག་པ་ལྟར་ན་བསྟོད་པ་རིན་ཆེན་འབྱུང་ལྡན་གྱི་ཡན་ལག་ཡན་གྲུབ་པར་བྱའོ།",
    "འབྲས་དུས་བཅུ་གསུམ་རྡོ་རྗེ་འཛིན་པའི་སས་བསྡུས་ཀྱི་སྐུ་བཞི་རང་བཞིན་གྱིས་ལྷུན་གྲུབ་དངོས་ཡིན་སྙམ་དུ་ང་རྒྱལ་བྱས།",
    "དེ་ཀའི་ངང་དུ་འཛིན་པ་མ་ཞུགས་པར་ཆད་དེ་འཇོག་རྣམ་པ་སྤྱི་ལ་སེམས་གཟུང་བ་ནི་དེ་ལྟའི་རྣམ་འཕྲུལ་གདངས་འགག་མེད་དུ་ཤར་བའི་ལྷ་བརྒྱ་ལྔ་བཅུ་རྩ་བདུན་མགྲོན་ཐབས་ཀྱི་ལྷ་ཉི་ཤུ་རྩ་གཉིས་དང་བཅས་པ་འདི་རྣམས་འབྲས་དུས་བཅུ་གསུམ་རྡོ་རྗེ་འཛིན་པའི་ས་ལ་བཞུགས་པའི་ལྷ་དེ་དང་དེ་དངོས་ཡིན་སྙམ་དུ་སེམས་འཛིན་པར་བྱེད།",
    "སྤྱི་བོར་སླེབས་པས་མུན་ཁུང་དུ་སྒྲོན་མེ་བཏེག་པ་ལྟར་སྤྱི་པོ་འོད་ཀྱི་རང་བཞིན་ཉི་མ་བྱེ་བའི་གཟི་མདངས་དང་ལྡན་པ་སྤུས་བྲིས་པ་ཙམ་ཞིག་ལ་སེམས་བོ་སྣ་ཚོགས་རྡོ་རྗེར་གནས་པ་དེ་གསལ་བར་བྱས།",
    "ཉི་མ་ཤར་བ་བཞིན་གསལ་བར་བྱས་པར་བསམ།",
    "སྤྱི་གཙུག་ནས་རྐང་མཐིལ་གྱི་བར་གྱི་པགས་པ་རྒྱུར་བྱས་པ་ལས་བྱུང་བའི།",
    "རྡོ་རྗེ་སྔོན་པོ་ནས་འབྲས་ཙམ་གྱིས་གོ་མཚམས་མེད་པར་གཏམས་པའི་རྡོ་རྗེའི་གུར་དང་བླ་བྲེ།",
    "བ་སྤུ་ཐམས་ཅད་རྒྱུར་བྱས་པ་ལས་བྱུང་བའི་ཡེ་ཤེས་ཀྱི་སྣང་བ་ལས་གྲུབ་པའི་མདའ་སྟོང་དང་སྒྲོ་ལ་སོགས་པ་མཚན་ཉིད་ཚང་བ་རྡོ་རྗེ་ཕྱེད་པའི་མདེའུ་ཅན།",
    "མཆོག་མ་ལ་བ་དན་གྱིས་མཚན་པ་ལ་སེམས་འཛིན་པར་བྱེད།",
    "དེ་ནས་ལྟོ་བའི་ཤ་ཁྲག་སོགས་རྒྱུར་བྱས་པ་ལས་བྱུང་བའི་ཆུའི་ཐམས་ཅད་རྒྱུར་བྱས་པ་ལས་བྱུང་བའི་མེའི་དཀྱིལ་འཁོར་གྲུ་གསུམ་དམར་པོ་མེ་འབར་བཞིན་པ་རཾ་དཀྱིལ་འཁོར་ཟླུམ་པོ་དཀར་པོ་ཤེལ་བུམ་ཆུས་གང་བ་ལྟབུ་བུམ་པ་ལཨས་མཚན་པ་ལ་སེམས་བཟུང་།",
    "ལག་མཐིལ་གཉིས་ཀྱི་ཤ་རུས་སོགས་རྒྱུར་བྱས་པ་ལས་བྱུང་བའི།",
    "བྱང་སྣ་ཚོགས་རྡོ་རྗེས་མཚན་པ་ལ་སེམས་འཛིན་པར་བྱེད།",
    "འོད་ཚུར་འདུས་ཐུགས་ཀའི་ཧཱུཾ་ལ་ཐིམ་པར་བསམ།",
