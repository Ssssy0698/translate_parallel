    "སྔ་ས་ནས་གྲ་སྒྲིག་བྱས་པའི་མར་ཇ་དེ་རག་སྐྱོག་གིས་དཀྲུག་དཀྲུག་བྱས་ནས་མགྲོན་པོ་རྣམས་ཀྱི་ཕོར་པའི་ནང་དུ་བླུགས།",
    "མོ་རང་ཁོམ་པ་ཅུང་ཟད་བྱུང་བ་དང་བུ་དགྲ་འདུལ་གྱི་གམ་དུ་བསྡད་དེ་དགྲ་འདུལ་ལ་ཤ་ཏིག་རེ་རེ་བཞིན་དང་།",
    "སྤགས་འཆང་བུ་རེ་རེ་སྟེར་ནས་ཨ་མའི་བུ།",
    "ཟ་འཐུང་ཡང་ཡིད་ཚིམས་པ་མ་བྱུང་བས་ད་རེས་ཚང་མས་འཛེམས་མེད་པར་དགོད་ཞོར་ཟ་ཞོར་གྱི་སྤྲོ་སྣང་གི་རྣམ་པས་ཁེངས།",
    "མི་རྒས་ན་ཡུལ་དྲན་ཞེས་པ་རང་རེད།",
    "དེང་སང་ལོ་ན་ཆེ་རུ་འགྲོ་དུས་ཕ་ཡུལ་དྲན་ཏེ་མཚན་མོའི་གཉིད་ལམ་དུ་ཡང་རང་ཡུལ་གྱི་ས་ཆ་ཁོ་ན་རྨིས་ཀྱི་འདུག།",
    "རང་ཡུལ་མི་སྐྱིད་པ་མིན་མོད།",
    "ཁྱོད་ཀྱིས་བསམ་བློ་བཏང་པར་འཕྱུག་མི་སྲིད།",
    "ང་ཚོ་འདིར་ཉིན་ཤས་བསྡད་ནས་རུ་བ་སྤོས་ན་བསམ་གྱི་འདུག་ཅེས་རྦད་དེ་ཚིག་ཐག་ཀྱང་མ་བཅད་པར་ཚང་མར་མིག་འགྲིམ་སྒྲུང་གི་སྨད་ཆ།",
    "ཉིན་བཞི་པའི་ཉིན་གུང་མ་ཟིན་ཙམ་ལ་བྱང་ཤར་གྱི་ཐང་ཆེན་དེ་ནས་ཐལ་རྡུལ་ནམ་མཁར་འཕྱུར་བཞིན་ཤིན་ཏུ་ཆེ་ལ་རིང་བའི་སྦྲུལ་ནག་ཅིག་འཁྱུག་པ་ལྟར་རུ་བསྟར་བསྒྲིགས་པའི་རྟ་པ་སྟོང་ཕྲག་གཅིག་ལྷག་ཙམ་ཞིག་ཡོང་གི་འདུག་པས་ལུང་པ་དེའི་སྐྱེ་བོ་ཕོ་མོ་རྒན་གཞོན་ཚང་མ་སྒོར་དོན་ཏེ་ཧང་སང་ནས་ལག་པས་ཉི་འོད་འགེབ་ཀྱིན་དུ་རྒྱང་བལྟ་བྱས།",
    "སྐྱ་མི་མང་པོ་འདི་འདྲ་ངོ་མ་ཡ་མཚན་རེད།",
    "རྒྱ་སོག་ཧོར་གསུམ་གྱི་ཚོང་འགྲུལ་ཡར་མར་འགྲོ་མཁན་མང་པོ་ཡོད་མོད།",
    "བུད་མེད་རྣམས་སྨྲ་བརྗོད་ཀྱི་སྤོབས་པ་དང་བྲལ་ནས་འཇིགས་གཡེར་བར་གྱུར།",
    "ཨ་ཕ་ང་ཁྲིད་དང་།",
    "ཀོང་དོང་དུ་གབ་ནས་དེ་རིང་རང་ཕྱོགས་མེ་བཏང་ཤུལ་གྱི་ཐལ་བ་མེད་པར་བཟོ་རྒྱུར་གདོན་མི་ཟ་ཡང་མ་འཆི་བར་འཐབ་རྒྱུའི་བློ་ཐག་བཅད་དེ་བུད་མེད་དང་།",
    "བྱིས་པ་རྒན་འཁོགས་རྣམས་ལྷས་སྒྲུང་གི་སྨད་ཆ།",
    "དེའི་ཚེ་མི་རྐྱང་གཅིག་ལག་ཏུ་མདའ་མདུང་སོགས་མཚོན་ཆ་གང་ཡང་མ་ཐོགས་པར་ཐད་ཀར་ཁོང་ཚོའི་ཕྱོགས་སུ་ཡོང་ནས་ལག་གཡུག་བྱེད་ཀྱི་འདུག་ཁོང་ཚོས་སྔར་བས་དོགས་ཟོན་ཆེར་སྐྱེད་ཀྱིས་མེ་སྒྲོན་ཟིན་པའི་སྦི་སྡིའི་སྣེ་མོར་ཕུ་བཏབ་སྟེ་མེ་མདའ་རྒྱག་ཆོག་ཆོག་བྱས།",
    "མི་དེས་དོགས་ཟོན་སྤུ་ཙམ་མེད་པའི་སྒོ་ནས་ལག་པ་གཉིས་རྒྱབ་ཏུ་བཞག་ནས་ཨ་ལ་ལ་མོ་ལ་ལ་རེད་ཅེས་ཚིག་འབྲུ་མེད་པའི་གླུ་ཆུང་གྱེར་བཞིན་ཐད་ཀར་ཁོང་ཚོའི་ཕྱོགས་སུ་ཡོང་།",
    "ད་གཟོད་མི་དེ་དང་ཁོང་ཚོ་བར་ཐག་ཧ་ཅང་ཉེ་བས་དེའི་གྱོན་པ་དང་གཟུགས་བྱད་ཀྱང་གསལ་པོ་མཐོང་གི་འདུག་པ་སྟེ་མཐའ་བཞི་གྱེན་དུ་འགྱུར་པའི་རྒྱ་གར་ཡང་ཞྭ་རྙིང་སོང་ཞིག་གི་འོག་ནས་སྟོང་སྐུད་དམར་པོའི་སྐྲ་གཞུག་རྣ་བ་གཡོན་མའི་ཐད་ནས་ཐུར་དུ་དཔྱང་ནས་འདུག།",
    "ཕུ་དུང་གི་ཁ་ནས་མཐོང་གི་འདུག།",
    "ད་གཟོད་ཁོ་རྩྭ་འབུར་ཞིག་གི་སྟེང་དུ་ལངས་ནས་ཝ་ཡེ།",
    "ཁྱོད་ཚོ་སྐྲག་སྣང་བྱེད་དགོས་ལེ་མ་རེད།",
    "ཁྱོད་ལ་ཅི་དགོས།",
    "མི་དེས་དེར་ཡོད་ཚང་མར་མིག་འགྲིམ་ཞིག་བྱས་ཏེ་ངོ་གདོང་ལས་འཛུམ་མདངས་འཕྱུང་སྟེ་ང་སྟོང་དཔོན་གྱི་བཀའ་ལྟར་ཁྱོད་ཚོ་འདིར་ཡོད་ཀྱི་མེ་མདའ་དེ་དག་ཚོང་མིན་སྐད་ཆ་འདྲི་བར་ཡོང་བ་ཡིན་ཟེར།",
    "ཁྱོད་ཚོ་ག་ནས་ཡིན་ཞེས་དྲིས།",
    "མི་དེས་ང་ཚོ་ནི་ཧོར་ཚོ་སོ་དགུའི་དམག་མི་ཡིན།",
    "ང་ཚོར་ད་དུང་མེ་མདའ་མང་པོ་མེད་པས་ལམ་བརྒྱུད་ནས་ཉོ་སྒྲུབ་བྱེད་ཀྱི་ཡོད།",
    "ང་ཚོས་ད་གིན་ཁྱོད་ཚོའི་ལག་ཏུ་མེ་མདའ་ཡོད་པ་མཐོང་བས་ང་ཚོའི་སྟོང་དཔོན་རྡོ་དགས་ང་འདིར་མེ་མདའ་དེ་དག་ཚོང་མིན་སྐད་ཆ་འདྲི་བར་བཏང་བྱུང་།",
    "གལ་སྲིད་ཁྱོད་ཚོས་འཚོང་རྩིས་མེད་ན་ཨུ་ཚུགས་བྱེད་ཀྱི་མིན་ཞེས་རང་གི་ཡོང་དོན་བཤད།",
    "གཞོན་ནུ་དེ་དག་གི་སྟོང་དཔོན་རྡོ་དགའ་ནི་དབྱིན་འགོག་དམག་འཁྲུག་ཐེངས་གཉིས་པའི་སྐབས་ཧོར་ཚོ་སོ་དགུའི་སྟོང་དཔོན་ཡིན་ཞིང་།",
    "སྒྲུང་གི་སྨད་ཆ།",
    "ཁྱོད་ཚོའི་མེ་མདའ་ཚོང་གི་ཡིན་ནམ་མིན།",
    "འགྲིག་གི་རེད།",
    "ང་ཚོ་མཉམ་དུ་འགྲོ་ཞེས་མི་དེས་སྣེ་ཁྲིད་ནས་ཁོ་ཚོ་དམག་སྒར་དུ་ཕྱིན།",
    "ཁོ་ཚོ་ཕེབས་སོང་ཞེས་བཤད།",
    "གུར་དེའི་སྦུག་ཏུ་ལོ་ན་བཞི་བཅུའི་ཡས་མས་བྱས་པའི་མི་བོ་ངོ་གདོང་སྨུག་ལ་ཟ་འགྲམ་གཡས་གཡོན་དང་ཡ་མཆུའི་སྟེང་དུ་སྨ་ར་ཐར་ཐོར་སྐྱེས་པ་ཞིག་གི་མགོར་ཝ་དམར་གྱི་ཞྭ་མོའི་རྒྱབ་ཏུ་བྱ་རྒོད་ཀྱི་སྒྲོ་རྐང་གསུམ་སྒར་བ་ཞིག་གྱོན་ནས་འདུག་ཕལ་ཆེར་ཆིང་རྒྱལ་རབས་ཀྱི་དཔོན་རིགས་ཀྱི་ཞྭ་མོའི་ལྟག་རྒྱབ་རྨ་བྱའི་མཇུག་སྒྲོ་ཡིན་པས་དེར་ལད་མོ་བྱས་པ་ཡིན་པ་འདྲ།",
    "ཁོ་ཚོས་གུས་ཐག་རིང་གི་སྦྲ་ནགགུས་ཞུམ་ཞུམ་གྱིས་ཕུ་དུང་གཡས་པ་ཕྲག་པའི་སྟེང་ནས་མདུན་དུ་བླངས།",
