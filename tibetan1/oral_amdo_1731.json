    "གང་གི་ཚེ་གཟེངས་བསྟོད་པ་དེ་བྱ་ཞེ་ན་དེའི་ཕྱིར་བརྗོད་པ་བྱས་མ་ཐག་ཏུའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གང་གིས་བསྐྲད་པར་བགྱིས།",
    "ནན་ཐུར་བྱེད་པ་དེ་དག་གིས་མ་བསྐོས་ན་ནན་ཐུར་བྱས་པ་ལ་བཟོད་པ་མི་འཆགས་སོ་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་དགེ་སློང་གཞན་དག་ནན་ཐུར་བྱས་པ་དེ་ལ་བཟོད་པ་བྱེད་འདོད་ན་ཅི་ནས་ཀྱང་ནན་ཐུར་བྱེད་པ་དག་གིས་དེར་བསྐོས་པ་ཉིད་དུ་འགྱུར་བ་དེ་ལྟར་བྱ་ཞིང་དེ་ལ་བཟོད་པར་བྱའོ།",
    "འདིར་གཞུང་ནི་རྣམ་པར་འབྱེད་པ་ལས་ཚེ་དང་ལྡན་པ་ཁྱོད་གནས་འདི་ནས་སོང་ཤིག་ཅེས་བྱ་བ་དང་།",
    "དགེ་སློང་བྲམ་ཟེའི་བུ་མོས་ཞུས་པ་ལས་ཀྱང་བསྐྲད་པ་ཞེས་བྱ་བའི་དོན་ཅི་ལགས་ཉེ་བ་འཁོར་ལས་དེའི་མིང་ཡིན་ཏེ།",
    "དགེ་སློང་བྲམ་ཟེའི་བུ་མོས་ཞུས་པ་ལས་གནས་ནས་ཕྱུང་བ་གྲོགས་དང་བཅས་པར་བརྗོད་པར་བགྱི་འམ།",
    "གང་གིས་འདི་གནས་ནས་ཕྱུང་བ་ཡིན་ནོ་ཞེས་བྱ་བར་ཤེས་ལ་དེ་མི་སྤོང་བ་དེ་ལ་ཉེས་པ་འདིར་འགྱུར་གྱི་མི་ཤེས་པ་ལ་ནི་མ་ཡིན་ནོ།",
    "གང་གིས་གནས་ནས་ཕྱུང་བར་ཤེས་པ་དེས་ལྷན་ཅིག་གནས་པ་དང་།",
    "དེ་ནི་ལོངས་མི་སྤྱད་པར་བྱ་བའི་ཕྱིར་སོང་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ནི་ལོངས་མི་སྤྱད་པར་བྱ་བའི་ཕྱིར་སོང་བ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་བཅད་པ་དང་ཕྱུང་བ་དེས་ནི་མ་ཡིན་ནོ།",
    "མ་གྲུབ་ན་གཙུག་ལག་ཁང་གི་རྫས་ཀྱིས་སོ་ཞེས་བྱ་བ་ནི།",
    "བཅོལ་ཏེ་མ་གྲུབ་ན་གཙུག་ལག་ཁང་གི་རྫས་ཀྱིས་ཕྱིར་བཅོས་པར་བྱ་བའོ།",
    "འདི་ནི་འདི་ལྟ་བུ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པས་དངོས་པོའི་རང་གི་ངོ་བོ་ངེས་པར་འཛིན་པ་ནི་རྣམ་པར་གཏན་ལ་འབེབས་པ་སྟེ།",
    "འདི་ལྟར་དེས་གཞན་ལ་བཅོལ་བས་འབད་པར་བྱ་བའམ་རང་གིས་བྱ་བས་ཀྱང་རུང་ངོ།",
    "ནན་ཐུར་གྱི་རྒྱུ་ཉེ་བར་གནས་པ་དེའི་བདག་ཉིད་ཀྱི་རང་གི་ངོ་བོར་གྱུར་པའི་དོན་གང་ཡིན་པ་དེ་ནི་དེའི་དོན་ཏོ།",
    "གཞན་གྱིས་མིང་དང་ཚིག་གི་སྒྲ་བརྗོད་པ་དེས་བསྡིགས་པའི་ནན་ཐུར་གྱི་ལས་བྱ་བའི་རྒྱུ་འཐབ་ཀྲོལ་བྱེད་པ་ཉིད་གང་ཡིན་པ་དེ་བརྗོད་པའི་ལས་འཆགས་པ་སྟེ།",
    "གལ་ཏེ་བསྡིགས་པའི་ནན་ཐུར་གྱི་རྒྱུ་ཉེ་བར་གྱུར་ལ་དེའི་དོན་དུ་བསམ་པས་བསྐྲད་པ་ལ་སོགས་པའི་མིང་གིས་ནན་ཐུར་གྱི་ལས་བྱེད་ན་དེ་ལྟ་ན་ཡང་བསྡིགས་པའི་ནན་ཐུར་གྱི་ལས་ཉིད་འཆགས་པར་འགྱུར་རོ།",
    "དེའི་མིང་གི་དོན་འདོད་པ་ཉིད་དུ་མི་སེམས་ན་ནན་ཐུར་གྱི་རྒྱུ་ཉེ་བར་གནས་པ་དེའི་ལས་མི་འཆགས་སོ།",
    "དེ་དག་གི་རྒྱུ་ནི་ཐ་དད་པ་ཉིད་དོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནི་ལོངས་མི་སྤྱོད་པའི་ཕྱིར་སོང་བའི་ཕྱིར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ལོངས་སྤྱོད་པའི་ཕྱིར་སོང་བ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ནན་ཐུར་གྱི་ལས་དག་ལ་ཐུན་མོང་མ་ཡིན་ག་དོགས་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ནན་ཐུར་གྱི་ལས་དག་ལ་དགེ་སློང་དང་དགེ་སློང་མ་ཐུན་མོང་མ་ཡིན་པར་དོགས་པར་མི་བྱ་སྟེ།",
    "གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་ལྷུང་བཟེད་ཁས་དབུབ་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "རྣམ་པ་གང་གིས་དེ་རྣམ་པར་གཞག་པར་བྱ་ཞེ་ན་དེའི་ཕྱིར་གསོལ་བས་སོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་སོ།",
    "གང་གི་ཕྱིར་དེ་ཁས་ཕུབ་པ་དེའི་དོན་བརྗོད་པར་བྱ་སྟེ།",
    "དགེ་སློང་གིས་ཁྱིམ་བདག་བཞིའི་གནས་བཞི་པོ་དག་ཏུ་ལྷུང་བཟེད་བཞི་ཁས་དབུབ་པར་འགྱུར་བ་མཆིས་སམ།",
    "ཐ་ན་གནས་ནས་ཕྱུང་བ་ཕན་ཆད་རང་གི་ཕྱོགས་དང་མཐུན་པ་མ་ཡིན་པའི་ཁྱིམ་དུ་དེ་མི་འཆགས་སོ་ཞེས་བྱ་བ་ནི།",
    "ཐ་ན་གནས་ནས་ཕྱུང་བ་ཕན་ཆད་ནས་རང་གི་ཕྱོགས་དང་མཐུན་པ་མ་ཡིན་པ་ཚུན་ཆད་ཀྱི་དགེ་སློང་གིས་ཡོན་བདག་གི་ཁྱིམ་དུ་ལྷུང་བཟེད་ཁས་དབུབ་པ་དེ་མི་འཆགས་སོ།",
    "འདིར་གཞུང་ནི་དགེ་སློང་ཁས་བླངས་པ་དག་གིས་ཁས་མ་བླངས་པ་དག་གི་ཁྱིམ་བདག་རྣམས་ཀྱི་ཁྱིམ་དག་ཏུ་ལྷུང་བཟེད་ཁས་དབུབ་པར་བྱེད་ན་ཁས་མ་ཕུབ་པར་བརྗོད་པར་བྱའོ།",
    "དེ་བཞིན་དུ་གནས་ནས་ཕྱུང་བ་དག་གིས་རང་བཞིན་དུ་གནས་པ་དག་གི་ཁྱིམ་བདག་རྣམས་ཀྱི་ཁྱིམ་དག་ཏུ་ལྷུང་བཟེད་ཁས་དབུབ་པ་བྱེད་ན་ཁས་མ་ཕུབ་པར་བརྗོད་པར་བྱའོ།",
    "དེ་བཞིན་དུ་གནས་པར་མི་བྱ་བ་དག་གིས་ཁྱིམ་པ་དག་རྣམས་ཀྱི་ཁྱིམ་དག་ཏུ་ལྷུང་བཟེད་ཁས་དབུབ་པར་བྱེད་ན་ཁས་མ་ཕུབ་པར་བརྗོད་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་འགའ་ཞིག་གིས་གོ་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གསོལ་བ་འབའ་ཞིག་གི་སྔགས་ནི།",
    "ཐབས་གང་གིས་ལྡང་བར་འགྱུར་ཞེན་དེའི་ཕྱིར་བསླབ་པ་སྤྱོད་པས་སོ་ཞེས་བྱ་བ་སྨྲས་སོ།",
    "བསླབ་པ་སྤྱོད་པ་དེ་གང་གིས་བསྒྲུབ་པར་བྱ་ཞེ་ན།",
    "གང་གི་ཚེ་དགྲ་བཅོམ་པ་ཉིད་ཐོབ་པ་དེའི་ཚེ་ན་ནི་བསླབ་པ་བྱིན་པ་ཞེས་མི་བྱ་སྟེ།",
    "དེ་དག་གིས་ནི་གང་ཟག་གཅིག་གི་མདུན་དུ་བཤགས་པས་ཆོག་གི།",
    "སིལ་བུ་དག་ལས་དེ་ལྟ་བས་ན་གང་དག་རྣམ་པ་དེ་ལྟ་བུར་རང་བཞིན་གྱིས་ངོ་ཚ་ཤེས་པ་དང་ལྡན་པ་དེ་དག་གིས་ནི་གཅིག་གི་མདུན་དུ་བཤགས་པར་རྗེས་སུ་གནང་ངོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "ཀོ་ཤཱམྦཱི་པ་དང་དམར་སེར་ཅན་གྱི་གཞི་གཉིས་ལ་ཕྱིར་བཅོས་པའི་གཞི་ཞེས་བྱ་བའི་མིང་གཞན་དུ་བྱས་ཏེ་ཕྱིར་བཅོས་པར་བྱ་བའི་གང་ཟག་གི་བྱེ་བྲག་ཐམས་ཅད་བསྟན་པའི་ཕྱིར་རོ།",
    "གང་གིས་བཅབས་པའི་སེམས་གཞག་པས་ནི་ཕྱིས་བརྗེད་པར་གྱུར་དུ་ཟིན་ཀྱང་འཆབ་པའི་ཉེས་པ་ཁོ་ནར་འགྱུར་བས་དེའི་ཕྱིར་བཅབས་པའི་སེམས་མ་བཞག་པ་ཞེས་བྱེ་བྲག་ཏུ་བྱས་ཏེ།",
    "བྱས་སམ་མ་བྱས་ཞེས་བྱ་བས་ནི་ཅི་བདག་གིས་དེང་ལས་ཤིག་བྱས་སམ་འོན་ཏེ་མ་བྱས་སྙམ་དུ་ལས་ཀྱི་འཇུག་པའི་སྐབས་ལ་དོགས་པ་བསྟན་ཏོ།",
    "ཅི་ཞིག་ཅེས་བྱ་བ་ནི་བདག་ཉིད་དེང་བདག་ལས་ཤིག་བྱས་སོ་ཞེས་དེ་ལྟར་ལས་བྱས་པ་ཉིད་དུ་ཡིད་ལ་སྣང་བས་ན་བདག་གིས་ལས་དེའི་ངོ་བོ་ཉིད་ཅི་ཞིག་བྱས།",
    "ཇི་ལྟ་བུ་ཞིག་ཅེས་བྱ་བས་ནི་བདག་གིས་དེང་ཁུ་བ་འབྱིན་པའམ་ལུས་ཀྱིས་རིག་པ་ལ་སོགས་པའི་ངོ་བོ་ཉིད་ཀྱི་ལས་བྱས་ན།",
    "འདིར་གཞུང་ནི་ཀུན་ཤེས་པར་འདོད་པའི་དགེ་སློང་གིས་ཀྱང་བསླབ་པ་འདི་ལ་བསླབ་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཡོངས་སུ་གནས་པ་དང་མགུ་བ་སྤྱོད་པའི་གནས་སྐབས་བསྙེན་པར་རྫོགས་པ་དང་གནས་ནས་ཕྱུང་བ་དང་ཐ་སྙད་རུང་བའི་འདུ་ཤེས་ཉམས་པ་ཡོངས་སུ་གནས་པ་དང་མགུ་བ་མི་སྤྱོད་པའི་སར་སོང་ནས།",
    "དུས་ནི་འདི་སྲིད་དུ་བཅབས་པའི་མི་བཅབས་པ་དེའི་ཕྱིར་བདག་གིས་སྤྱད་པ་འདི་བླངས་ཏེ་འདི་སྲིད་ནི་སྤྱད་ཟིན་ཏོ།",
    "སྤྱད་པར་བྱ་བ་ཉིད་ལ་དག་པའི་མཐའ་ཅན་ཉིད་ཀྱི་བྱེ་བྲག་གིའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དག་པའི་མཐའ་ཅན་ཉིད་ཀྱི་བྱེ་བྲག་གི་དུས་ཏེ་ཡུལ་དེ་ལ་ཉུང་བ་ཉིད་དུ་མི་འགྱུར་བའི་དུས་དེ་ལྟ་བུ་བརྟེན་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེའི་ཕྱིར་དག་པའི་མཐའ་ཅན་ཉིད་ཀྱི་བྱེ་བྲག་གི་དུས་ལ་སྟེ།",
    "དེའི་བྱེ་བྲག་གི་ཞེས་བྱ་བ་ནི་ཡོངས་སུ་གནས་པར་སྤྱད་པའི་དུས་ཀྱི་དང་པོ་དག་པའི་མཐའ་ཅན་དེའི་བྱེ་བྲག་གི་དུས་ཏེ།",
    "ཡོངས་སུ་གནས་པ་སྤྱད་པའི་དུས་གང་ལ་དག་པའི་དུས་ཀྱི་མཐའ་དང་བཅབས་པའི་དུས་ཀྱི་བྱེ་བྲག་ཟླ་བ་བཞི་ལ་སོགས་པ་ཡོད་པ་དེ་ནི་དག་པའི་མཐའ་ཅན་ཉིད་ཀྱི་བྱེ་བྲག་གིས་དུས་ཞེས་བྱ་སྟེ།",
    "ཇི་ལྟར་ཉུང་བ་ཉིད་དུ་མི་འགྱུར་བ་དག་པའི་མཐའ་ཅན་ཉིད་ཀྱི་བྱེ་བྲག་གི་དུས་ལ་བརྟེན་པར་བྱ་ཞེན་དེའི་ཕྱིར།",
    "དག་པའི་མཐའ་ཅན་ཉིད་ཀྱི་བྱེ་བྲག་གི་དུས་ཟླ་བ་བཞི་ལ་བརྟེན་བར་བྱ་བའོ།",
    "ཟླ་བ་བཞི་ཞེས་སྨོས་པས་ནི་དཔེ་སྟེ་ཉུང་བ་ཉིད་དུ་མི་འགྱུར་བ་དག་པའི་མཐའ་ཅན་ཉིད་ཀྱི་བྱེ་བྲག་གི་དུས་ཟླ་བ་གསུམ་མམ་ལྔ་ལ་སོགས་པ་ལ་བརྟེན་པར་བྱའོ།",
    "གང་གི་ཚེ་བཅབ་པ་རྗོད་པར་བྱེད་པ་དེའི་ཚེ་ནི་སྔགས་ཀྱི་ཚིག་དུས་ཉུང་བ་ཉིད་དུ་མི་འགྱུར་བ་དཔག་ཏུ་མེད་པ་བཅབས་པས་ཞེས་བྱ་བ་ལ་བརྟེན་པར་བྱའོ།",
    "གང་གི་ཚེ་ཡོངས་སུ་གནས་པ་ལ་སོགས་པར་སྤྱད་པར་བྱ་བ་ཉིད་རྗོད་པར་བྱེད་པ་དེའི་ཚེ་ནི་སྔགས་ཀྱི་ཚིག་དུས་ཉུང་བ་ཉིད་དུ་མི་འགྱུར་བ་དག་པའི་མཐའ་ཅན་ཟླ་བ་བཞི་ཡོངས་སུ་གནས་པ་ཞེས་བྱ་བ་ལ་བརྟེན་པར་བྱའོ།",
    "གང་གི་ཚེ་མགུ་བར་བྱ་བ་ལ་སོགས་པ་སྤྱད་པར་བྱ་བ་ཉིད་རྗོད་པར་བྱེད་པ་དེའི་ཚེ་ནི་སྔགས་ཀྱི་ཚིག་དུས་ཞག་དྲུག་ཁོ་ན་ལ་བརྟེན་པར་བྱའོ།",
    "དེ་དག་གིས་སྔགས་ཀྱི་ཚིག་འདི་ལྟར་སྦྱར་བར་བྱ་སྟེ།",
    "དགེ་སློང་གིས་གནང་བར་མཛོད་ཅིག་དང་།",
    "ལྕི་བ་ཉིད་དང་བསམ་པ་དྲག་པོས་བྱས་པ་ཉིད་དག་གིས་དང་པོ་ཉིད་དུའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཉིན་མཚན་གྱི་ཐ་མའི་ཆ་མ་ཡིན་པ་ཞེས་བྱ་བ་སྐྱ་རེངས་འཆར་བའི་སྐད་ཅིག་གི་མདུན་རོལ་ཚུན་ཆད་དེ།",
    "བརྗོད་པའི་ཡན་ལག་ཉེ་བར་གནས་སུ་ཟིན་ཀྱང་རྐྱེན་འགའ་ཞིག་གིས་བདག་ཉིད་དེར་བརྗོད་དུ་འགྲོ་བའི་སྐབས་མེད་དམ།",
    "གཞན་དུ་སོང་བས་བརྗོད་པ་མ་བྱས་ན་དེ་ལྟར་ན་ཡང་བཅབས་པར་མི་འགྱུར་བ་ཁོ་ན་ཡིན་ནོ།",
    "འདི་སྐད་བསྟན་ཏེ་སོང་སྟེ་མ་བརྗོད་ན་བདག་ལ་བཅབས་པའི་ཉེས་པར་འགྱུར་རོ་སྙམ་དུ་དོགས་པའི་བསམ་པས་གལ་ཏེ་བརྗོད་པའི་ཡན་ལག་གི་དྲུང་དུ་མི་འགྲོ་འམ།",
    "གལ་ཏེ་གནས་དེ་ནས་གཞན་དུ་སོང་བར་གྱུར་ན།",
    "གཞན་དུ་སོང་བས་ནི་ཉེས་བྱས་སུ་འགྱུར་བའོ།",
    "ད་ནི་ས་གཞན་ན་གནས་པའི་སྤྱོད་པའི་གཞི་བསྡུ་བའི་ཕྱིར་ཡོངས་སུ་གནས་པ་དང་མགུ་བར་བྱ་བ་སྤྱོད་པ་དག་གིས།",
    "ཡོངས་སུ་གནས་པ་དང་མགུ་བར་བྱ་བ་སྤྱོད་པ་དག་གིས་ཞེས་སྨོས་པས་ནི་གཞི་ནས་སྤོ་བ་དང་།",
    "ཐལ་མོ་སྦྱར་བ་ཞེས་བྱ་བ་ནི།",
    "ཐལ་མོ་སྦྱར་ཞིང་འདུད་པའོ།",
    "དེ་གཉིས་ཀྱིས་མི་བྱ་བ་གང་ཡིན་པ་དེའི་སྐབས་གཞན་དག་གིས་ཀྱང་དེ་དག་ལའོ་ཞེས་བྱ་བ་ལ།",
    "ཕྱག་དང་མངོན་དུ་ལྡང་བ་དང་ཐལ་མོ་སྦྱར་བ་དང་།",
    "གུས་པའི་ལས་དག་བདག་གིར་མི་བྱའོ་ཞེས་ཇི་སྐད་བསྟན་པ་དག་གོ།",
    "གཞན་དག་གིས་ཀྱང་ངོ་ཞེས་བྱ་བ་ནི།",
    "རང་བཞིན་དུ་གནས་པ་དག་གིས་ཀྱང་ངོ།",
    "རང་བཞིན་དུ་གནས་པ་དག་གིས་ཡོངས་སུ་གནས་པ་དང་།",
    "གོམ་པ་མདུན་དུ་ཐལ་བར་འདོར་བ་དག་གིས་བཅག་པར་མི་བྱ་བའོ།",
    "ཕྱི་བཞིན་འབྲང་བའི་དགེ་སྦྱོང་གིས་བདག་ཉིད་ལས་གཞན་པས་ཁྱིམ་དག་ཏུ་འགྲོ་བ་ཡང་ངོ་ཞེས་བྱ་བ་ནི།",
    "གཙུག་ལག་ཁང་གི་སྒོ་དག་དབྱེ་བར་བྱ།",
    "དེ་དག་ཏུ་དགུན་ནི་ཆུ་དྲོན་མོ་གཞག་པར་བྱ།",
    "ཚ་བའི་དུས་སུ་ནི་ཆུ་གྲང་མོ་གཞག་པར་བྱ་བའོ།",
    "དེ་གཉིས་ཀྱིས་གཙུག་ལག་ཁང་གི་ཝའི་ཁ་དག་བསྩལ་བར་བྱ་བའོ།",
    "དེ་དག་གིས་འདུག་པ་ལ་སོགས་པ་ནི་བསྙེན་པར་རྫོགས་པ་ཐམས་ཅད་ཀྱི་མཐའ་ཉིད་དོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་གི་གྲལ་དེར་ཐམས་ཅད་ཀྱི་ཐ་མར་འདུག་པ་དང་འགྲོ་བ་ལ་སོགས་པ་བྱའོ།",
    "སྔར་སྟན་བཤམ་མོ།",
    "མཚན་མོ་དུས་དང་མཐུན་པའི་ཆུ་ཞེས་བྱ་བ་གྲང་བའི་དུས་སུ་ནི་དྲོ་བ།",
    "གིར་མི་བྱའོ་ཞེས་ཇི་སྐད་བསྟན་པའི་སྤྱོད་པ་འདི་ལ་དེའི་ངོ་བོ་ཉིད་ཚོལ་བ་བྱིན་པ་དང་བསླབ་པ་བྱིན་པ་དག་ཀྱང་སྤོ་བ་དང་མགུ་བར་བྱ་བ་སྤྱོད་པ་དེ་དང་འདྲ་སྟེ་དེ་གཉིས་ཀྱི་སྤྱོད་པ་ཡང་འདི་དག་ཉིད་ཡིན་ནོ།",
    "རང་གི་བཟོད་པ་གསོལ་བའི་སྔགས་ནི།",
    "འདི་སྐད་བསྟན་ཏེ་ཡོངས་སུ་གནས་པ་བྱས་ལ་མགུ་བ་བྱ་བ་མ་སྦྱིན་གྱི་བར་དུ་ནི་རེ་ཞིག་ཆོ་ག་འདི་ཡིན་ལ།",
    "དབྱུང་བར་མི་བྱེད་པའི་བར་དུ་ནི་རེ་ཞིག་ཆོག་འདི་ཡིན་ལ།",
    "དེ་དག་ལ་ཧ་ཅང་ཐལ་བར་འགྱུར་བ་དམིགས་ཀྱིས་བསལ་བའི་ཕྱིར་གདོན་པ་ནི་མི་བྱ་བ་ཉིད་དོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གཞན་དག་གིས་གནས་ནས་ཕྱུང་བ་སྤང་བར་བྱ་བ་ཁོ་ནའོ་ཞེས་བྱ་བ་ནི།",
    "གཞན་ཡང་དེ་ལ་ལུས་སམ་ངག་གི་འདྲེ་པར་གྱུར་པ་ཆུད་ཟད་ཀྱང་སྤྱད་པར་མི་བྱའོ།",
    "རང་བཞིན་དུ་གནས་པ་མ་ཡིན་པ་ཞེས་བྱ་བས་གཞན་ན་གནས་པ་དག་ལ་གང་ཟག་སྤོ་བ་དང་མགུ་བར་བྱ་བ་སྤྱོད་པ་དང་བསླབ་པ་བྱིན་པ་དག་གི་སྤོ་བ་དང་།",
    "གང་ན་གཞན་གསུམ་ལ་སོགས་པ་དེ་དག་གི་མིང་རྣམ་པ་ཐམས་ཅད་སྤྱོད་པ་དེར་དེ་སྤྱད་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཡང་གཞི་ནས་བསླང་སྟེ་མགུ་བར་བྱ་བ་དེ་དག་གིས་མིང་རྣམ་པ་ཐམས་ཅད་སྤྱོད་པའི་གནས་དེར་སྤོ་བ་ལ་སོགས་པ་དེ་སྤྱད་པར་མི་བྱ་སྟེ།",
    "དེ་བས་ན་གཙུག་ལག་ཁང་ན་གཞན་གསུམ་ལ་སོགས་པ་དེ་དག་གི་མིང་རྣམ་པ་ཐམས་ཅད་སྤྱོད་པ་དག་འཁོད་པ་དེར་གང་ཡང་སྤྱད་པར་མི་བྱ་བའོ།",
    "དང་པོ་གཉིས་ཀྱིས་གཞན་དུ་སྐྱ་རེངས་འཆར་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གཞན་པའི་མཚམས་སུ་སྐྱ་རེངས་འཆར་བར་མི་བྱ་བའོ།",
    "གལ་ཏེ་ཡུན་རིང་དུ་སྤྱད་པར་བྱ་བ་ཉིད་མ་ཡིན་ན་ཉིན་རེ་ཞིང་ངོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གལ་ཏེ་སྤོ་བ་ཡུན་རིང་དུ་སྤྱད་པར་བྱ་བ་ཉིད་མ་ཡིན་ན་ཉིན་རེ་ལན་རེ་བརྗོད་པར་བྱ་བ་ཉིད་ཡིན་ནོ།",
    "ཡུན་རིང་དུ་སྤྱད་པར་བྱ་བ་ཉིད་འདི་ལ་ནི་ཉི་མ་གསུམ་མམ་བཞི་ཞིང་ལན་རེ་བརྗོད་པར་བྱ་བ་ཉིད་ཡིན་ནོ།",
    "བདག་དགེ་སློང་མིང་འདི་ཞེས་བགྱི་བ་སྤོ་བ་བགྱིད་པས་དགེ་སློང་འཐབ་ཀྲོལ་བགྱིད་པ་མཚང་འདྲུ་བར་བགྱིད་པ་འཐབ་མོ་བགྱིད་པ།",
    "དེ་དག་གིས་བདག་ལ་གཞི་འདི་གླེང་བར་འགྱུར།",
    "དྲན་པར་བགྱིད་པར་འགྱུར་བས་བདག་གིས་ཚེ་དང་ལྡན་པ་དག་གི་མདུན་དུ་སྤོ་བ་སླར་གཏང་བར་བགྱིའོ།",
    "ཡང་བླངས་ཏེ་སྤྱོད་པར་བགྱིད་ན་ཚེ་དང་ལྡན་པ་དག་གིས་བདག་ངོ་ཚ་མ་མཆིས་པར་མི་གཟུང་དུ་གསོལ།",
    "བདག་དགེ་སློང་མིང་འདི་ཞེས་བགྱི་བ་སྤོ་བ་བགྱིད་པས་དགེ་སློང་འཐབ་ཀྲོལ་བགྱིད་པ་མཚང་འདྲུ་བར་བགྱིད་པ་འཐབ་མོ་བགྱིད་པ།",
    "དེ་དག་གིས་བདག་ལ་གཞི་འདི་གླེང་བར་འགྱུར།",
    "དྲན་པར་བགྱིད་པར་འགྱུར་བས་བདག་གིས་ཚེ་དང་ལྡན་པ་དག་གི་མདུན་དུ་སྤོ་བ་སླར་གཏང་བར་བགྱིའོ།",
    "ཡང་བླངས་ཏེ་སྤྱོད་པར་བགྱིད་ན་ཚེ་དང་ལྡན་པ་དག་གིས་བདག་ངོ་ཚ་མ་མཆིས་པར་མི་གཟུང་དུ་གསོལ།",
    "དགྲ་བོ་སོང་ནས་ཕྱིར་ཡང་དེ་བཞིན་དུ་བླང་བར་བྱ་སྟེ།",
    "དགེ་སློང་འཐབ་ཀྲོལ་བགྱིད་པ་མཚང་འདྲུ་བར་བགྱིད་པ་འཐབ་མོ་བགྱིད་པ།",
    "དེ་དག་གིས་བདག་ལ་གཞི་འདིས་གླེང་བར་འགྱུར་དྲན་པར་བགྱིད་པར་འགྱུར་བས།",
    "བདག་གིས་དེ་སྐད་ཐོས་ནས་དགེ་སློང་རྣམས་ཀྱི་མདུན་དུ་སྤོ་བ་སླར་བཏང་བ་ཕྱིར་རྒོལ་བ་མི་མཛའ་བ་དེ་དག་སླར་མཆིས་ལགས་པས་བདག་སྤོ་བ་ཡང་སླར་ལེན་ཏོ།",
    "ཉིན་མཚན་བཅད་པར་ནི་མི་འགྱུར་མོད་ཀྱི།",
    "དེ་བས་ན་དགེ་སློང་གིས་ལྷའི་མིག་གིས་མཐོང་བས་གླེང་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནས།",
    "དེ་ལ་ཁྱོད་ཕྱིས་བདག་ལ་མཐོང་བ་དང་ཐོས་པ་དང་དོགས་པའི་གནས་གསུམ་གྱིས་དགག་དབྱེ་མ་བྱེད་ཅིག་ཅེས་དགག་དབྱེ་འཇོག་པར་མི་འཆགས་པའོ།",
    "རང་གིས་འཇོག་ཏུ་འཇུད་ན་ཡང་མི་འཆགས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བྱས་པ་དང་བྱེད་པའི་རང་གི་ངོ་བོ་མ་རྟོགས་པ་ཉིད་ན་ཡང་གླེང་བ་མི་འཆགས་སོ་ཞེས་བྱ་བ་ལ་བྱས་པའི་རང་གི་ངོ་བོ་མ་རྟོགས་པ་ཉིད་ཅེས་བྱ་བ་ནི།",
    "འཕགས་པ་ཆེ་གེ་མོས་ཉེས་པ་བྱས་ཞེས་ནི་ཐོས་ཀྱི་ཉེས་པ་འདི་དང་འདི་ལྟ་བུ་བྱས་ཞེས་ནི་མ་ཐོས་སོ་ཞེས་ཟེར་བའོ།",
    "བྱེད་པའི་རང་གི་ངོ་བོ་མ་རྟོགས་པ་ཉིད་ཅེས་བྱ་བ་ནི།",
    "ཆེ་གེ་མོ་ཞིག་གིས་ཞེས་ནི་མ་ཐོས་སོ་ཞེས་ཟེར་བ་སྟེ།",
    "དེས་བསྲུང་བར་བྱ་བ་དག་གི་དབུས་སུ་གླེང་བར་མི་བྱ་བའོ།",
    "གང་ལྕགས་ལས་བྱས་པའི་གསལ་ཤིང་གིས་འཛུགས་པར་བྱེད་པ་དེ་ནི་ལྕགས་ཀྱི་གསལ་ཤིང་ཅན་ཏེ།",
    "ཚེ་དང་ལྡན་པ་ཁྱོད་ལ་བརྗོད་པ་དང་བཅས་པ་ཉིད་བྱས་ཁྱོད་ཀྱིས་གནས་འདི་ནས་མ་ཞུས་པར་འགྲོ་བར་མི་བྱའོ།",
    "འཇོག་པར་བྱེད་པ་དག་གིས་གཞག་པ་དེ་དང་ལྷན་ཅིག་ཏུ་བྱ་བ་ཡང་འདིར་བཟོད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "འཇོག་པར་བྱེད་པའི་དགེ་སློང་གང་དག་གིས་གསོ་སྦྱོང་དང་དགག་དབྱེ་གཞག་པ་གང་ཡིན་པ་དེ་གང་ཟག་དེ་དང་ལྷན་ཅིག་བྱ་བ་གང་ཡིན་པ་དེ་ཡང་སྐབས་འདིར་དེ་ལ་བཟོད་པ་བྱ་བ་ཡིན་གྱི།",
    "ཚིག་འབའ་ཞིག་གིས་བཟོད་པར་བྱ་ཞིང་བག་ཡོངས་སུ་བྱ་བར་མ་ཟད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེའི་ཚེ་དེ་ལ་ཕུར་པ་དང་བཅས་པ་ཉིད་དུ་བྱ་བ་སྟེ་ཕུར་པ་དང་བཅས་པའི་སྐབས་འདི་ནི་མ་མོ་ལས་འབྱུང་ངོ།",
    "ཐོས་པ་ནི་རྣམ་པ་གསུམ་སྟེ་བྱ་བའི་མཚན་མ་དང་གཞན་ཕེབས་པར་སྨྲ་བ་དང་རང་གིས་རྗེས་སུ་ཐོས་པའོ་ཞེས་བྱ་བ་ལ།",
    "རང་གི་རྗེས་སུ་ཐོས་པ་ཞེས་བྱ་བ་ནི།",
    "ཆེ་གེ་མོ་ཞིག་གིས་འདི་ལྟ་བུ་བྱས་སོ་ཞེས་གཞན་དག་ནི་ལོགས་ཤིག་ན་གཏམ་ཟེར་བ་རང་གིས་ལོགས་ཤིག་ནས་རྗེས་སུ་ཐོས་པ་གང་ཡིན་པའོ།",
    "འདི་ལ་དགེ་སློང་དག་གིས་རྣམ་པ་གང་དག་དང་།",
    "གསོ་སྦྱོང་གི་ལས་ཀྱི་དུས་མ་ཡིན་པ་གཞན་དུ་གསོ་སྦྱོང་དེ་གཞག་པར་མི་བྱ་བའོ།",
    "འཇོག་པར་བྱེད་པ་བུད་མེད་ཀྱིས་གཞན་སྐྱེས་པའི་གཞག་པ་ཉིད་བྱེད་དམ་བྱས་པ་ཉིད་ན་གཞག་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "གཞག་པར་བྱས་པ་ཉིད་ཀྱི་འོག་ཏུ་གལ་ཏེ་མཚན་གྱུར་ཏམ་དང་པོ་ཉིད་ནས་བུད་མེད་དུ་གྱུར་པ་ཉིད་ཀྱིས་འཇོག་པར་བྱེད་པ་བུད་མེད་ཡིན་པར་གྱུར་ལ།",
    "དེ་ནི་འཇོག་པར་བྱེད་པ་བུད་མེད་ཉིད་ཀྱིས་གཞན་སྐྱེས་པའི་གསོ་སྦྱོང་དང་དགག་དབྱེ་གཞག་པ་ཉིད་བྱེད་དམ་བྱས་པ་ཉིད་ནི་གཞག་པ་ཉིད་མ་ཡིན་ཏེ།",
    "འོ་ན་གང་གི་ཚེ་འཇོག་པར་བྱེད་པ་བུད་མེད་ཀྱིས་འཇོག་ཏུ་བཅུག་ནས་སྐྱེས་པ་ཉིད་དུ་གྱུར་ན་ཇི་ལྟར་བརྗོད་པར་བྱ་ཞེ་ན།",
    "དེ་ལྟ་བས་ན་བུད་མེད་ཀྱིས་འཇོག་ཏུ་བཅུག་ནས་སྐྱེས་པ་ཉིད་དུ་གྱུར་ཀྱང་གཞག་པ་ཉིད་མེད་དོ།",
    "དགག་དབྱེའི་གཞིའི་ཞུ་བ་ལས་བཙུན་པ་རེ་ཞིག་དགེ་སློང་གིས་དགེ་སློང་གི་དགག་དབྱེ་འཇོག་པར་བགྱིད་ཅིང་།",
    "བཙུན་པ་རེ་ཞིག་དགེ་སློང་མས་དགེ་སློང་མའི་དགག་དབྱེ་འཇོག་པར་བགྱིད་ཅིང་གང་གིས་འཇོག་པར་བགྱིད་པ་དེ་མཚན་གྱུར་ཏེ་དགེ་སློང་དུ་གྱུར་ན་གཞག་པར་བརྗོད་པར་བགྱིའམ།",
    "གཅིག་པ་ཉིད་མ་ཡིན་པའི་གཞུང་ནི་དགག་དབྱེའི་གཞིའི་ཞུབ་ལས་བཙུན་པ་རེ་ཞིག་ཁས་བླངས་པ་དག་གིས་ཁས་མ་བླངས་པ་དག་གི་དགག་དབྱེ་འཇོག་པར་བགྱིད་ན་གཞག་པར་བརྗོད་པར་བགྱིའམ།",
    "བཙུན་པ་རེ་ཞིག་ཁས་མ་བླངས་པ་དག་གིས་ཁས་བླངས་པ་དག་གི་དགག་དབྱེ་འཇོག་པར་བགྱིད་ན།",
    "འདི་ནི་ལུས་ཀྱིས་ཕ་རོལ་གནོད་པ་དང་རེག་པ་སྤང་བའི་ཕྱིར་རོ།",
    "བར་དུ་གཞན་གྱི་གནས་ཁང་གིས་ཆོད་པ་གནས་ཁང་བསྒོ་བས་ཀྱང་སྦྱིན་པར་བྱ་བ་ཉིད་ཡིན་ལ།",
    "རང་གིས་ཀྱང་མནོད་པར་བྱ་བ་ཉིད་ཡིན་ནོ།",
    "དེའི་ཕྱིར་དེ་ལས་གཞན་པ་དག་དང་ཚོགས་ཏེ་ལས་བྱས་ན་ཡང་མི་འཆགས་པ་ལ་ཕན་ཚུན་མི་མཐུན་པ་ཉིད་དུ་ཡང་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ནི།",
    "ཚིག་གི་ལན་ལ་སོགས་པ་ཀུན་དུ་སྨྲ་བ་སྦྱིན་པའོ།",
    "མིག་གིས་རྒྱུན་དང་ལྡན་པར་བལྟ་བའོ།",
    "ཁ་ཅིག་ལས་ནི་ཚིག་གིས་ཐོས་པ་དད་བཅས་པར་གཞན་ལའོ་ཞེས་བྱ་བ་ནི།",
    "ཁྱོད་ཀྱི་སྟོན་པ་ཐུགས་རྗེ་དང་ལྡན་པས་དེས་ན་འདི་རྗེས་སུ་གནང་ངོ་ཞེས་གཞན་ལ་ལན་གདབ་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཁྱེད་ཅག་གིས་སྤྱོད་པའི་སྤྱོད་པ་ལ་སོགས་པ་དང་གསོ་སྦྱོང་དད་དགག་དབྱེ་ཉམས་པ་གང་ཡིན་པ་དེ་དག་བརྗོད་པར་བྱའོ།",
    "དེ་དག་གིས་གསོལ་བའི་སྔགས་ནི།",
    "དེ་དག་གིས་གསོལ་བའི་སྔགས་ནི།",
    "འཇུག་ཏུ་ཐལ་མོ་བརྡབས་ཏེ།",
    "དེ་དག་གིས་འཚོ་བའི་བར་དུ་བཅང་བར་བྱིན་གྱིས་བརླབས་པའི་ལན་ཚ་དུས་སུ་རུང་བ་དང་།",
    "ལམ་གྱི་རུང་བ་ཞེས་བྱ་བ་ནི་དེ་དག་གིས་རྒྱང་གྲགས་ཕྱེད་དུ་ཡང་སོང་སྟེ།",
    "དེ་དག་གི་སྤངས་པ་ན་ལྷག་པོར་བྱེད་དུ་མ་བཅུག་པར་སོར་མོ་གཉིས་ཀྱིས་རེག་པར་བྱས་ཏེ་བཟོད་པ་གང་ཡིན་པའོ།",
    "དེ་དག་གིས་ཞོ་དང་འོ་མ་དག་དཀྲུགས་ཏེ་དུས་མ་ཡིན་པར་ཡང་འཐུངས་པ་གང་ཡིན་པའོ།",
    "དེ་ནི་དེ་དག་གིས་རང་གི་ངོ་བོ་ཡིན་པར་བལྟ་བར་བྱའོ།",
    "མཐུན་པའི་གསོ་སྦྱོང་ལ་སོགས་པ་དེ་དག་གང་གི་ཚེ་བྱ་ཞེ་ན།",
    "དགེ་སློང་གིས་གསོ་སྦྱོང་མ་ཡིན་པར་གསོ་སྦྱོང་མི་བྱའོ།",
    "བྲམ་ཟེའི་བུ་མོའི་སྐབས་བསྡུ་བའི་ཕྱིར།",
    "འདི་ལ་སོ་སོའི་རང་གི་ལས་ནི་འཆགས་སོ་ཞེས་བྱ་བ་ནི།",
    "རང་གི་ཕྱོགས་དང་མཐུན་པ་མ་ཡིན་པ་ལ་ནི་མི་འཆགས་སོ་ཞེས་བྱ་བ་ནི།",
    "འདིར་གཞུང་ནི་ཞུ་བ་ལས་བཙུན་པ་རེ་ཞིག་ཀོ་ཤཱམྦཱི་པའི་དགེ་སློང་ཕྱོགས་གཉིས་སུ་འདུས་ཤིང་མཆིས་པར་གྱུར་ན།",
    "ད་གཉིས་གང་གིས་དགེ་སློང་མ་རྣམས་ལ་བསྟན་པར་བགྱི།",
    "ཉེ་བ་འཁོར་གཟུ་བོ་དག་གིས་མཚམས་ཀྱི་ཕྱི་རོལ་དུ་སོང་སྟེ་བསྟན་པར་བྱ་བའོ་ཞེས་གསུངས་པ་དང་།",
    "བྲམ་ཟེའི་བུ་མོས་ཞུས་པ་ལས་ཀྱང་གལ་ཏེ་གཟུ་བོ་དག་མེད་ན།",
    "ཡངས་པ་ཅན་གྱི་དགེ་སློང་དག་གི་ས་གཞི་བཅུ་ཕྱུང་བ་ན།",
    "སྲིད་མོ་དག་ཇེ་མཐུན་པར་གྱིས་ཤིག་ཅེས་མཐུན་པ་ཉིད་ལ་ངེས་པར་སྦྱར་བར་བྱའོ།",
    "གལ་ཏེ་ཉུང་བ་ཉིད་ཡིན་ལ་ཅིག་ཤོས་ནི་དེ་ཉིད་ཡིན་ན་གང་གིས་ཕང་པར་ཕུལ་བའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཕང་བ་ཞེས་སྨོས་པ་ནི་ལག་པ་དང་རྐང་པའི་དྲུ་བདག་གི་དཔེ་ཡིན་ནོ།",
    "བདག་ཅག་གིས་ཤ་བཟའ་བར་མི་བྱའོ།",
    "བདག་ཅག་གིས་བཏུང་བར་མི་བྱའོ།",
    "བདག་ཅག་གིས་བཟའ་བར་མི་བྱའོ།",
    "དགེ་སྦྱོང་གོ་ཏ་མ་ནི་གོས་དྲས་པ་གྱོན་ཏེ་བདག་ཅག་གིས་བགོ་བར་མི་བྱའོ།",
    "བདག་ཅག་གིས་ཤ་བཟའ་བར་མི་བྱའོ།",
    "བདག་ཅག་གིས་བཏུང་བར་མི་བྱའོ།",
    "བདག་ཅག་གིས་བཟའ་བར་མི་བྱའོ།",
    "བདག་ཅག་གི་ས་བགོ་བར་མི་བྱའོ།",
    "བདག་ཅག་གིས་གྲོང་དུ་གནས་པར་བྱའོ།",
    "ཚེ་དང་ལྡན་པ་དག་ཁྱེད་ཅག་ལས་གང་བརྟུལ་ཞུགས་ཀྱི་གནས་ལྔ་པོ་འདི་དག་གིས་དག་པ་དང་གྲོལ་བ་དང་།",
    "ལྷག་མ་རྣམས་ཀྱང་དེ་བཞིན་དུ་བརྗོད་པར་བྱའོ་ཞེས་གསུངས་པ་ལ་རྩོད་པ་བཞི་པོ་གང་དག་ཡིན་པ་དེ་དག་གི་རང་གི་ངོ་བོ་ངེས་པར་གཟུང་བའི་ཕྱིར།",
    "འཁྲུག་ལོང་གི་རྒྱུ་བཞིའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཚིག་གི་ཕྱིར་སེམས་གཞོལ་བ་གང་ཡིན་པ་དེ་ནི་འདིར་འཁྲུག་ལོང་ཞེས་བྱའི་ཁྲོ་བ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཚིག་གི་ཕྱིར་སེམས་གཞོལ་བ་འཁྲུག་ལོང་ཡིན་ལ་དེ་ཉིད་རྩོད་པ་ཡིན་ན།",
    "དེའི་རང་བཞིན་ཉིད་དེ་རང་གི་ངོ་བོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལྟར་དངོས་པའི་དེ་བཞིན་ཉིད་ལ་ལོག་པར་བསྒྲུབ་པ་དེ་ནི་འཁྲུག་ལོང་གི་རྒྱུ་དང་པོ་ཡིན་ནོ།",
    "དེ་ཅིའི་ཕྱིར་ཁྱོད་ཀྱིས་འདི་བླངས་ཤེ་འམ་བྱིན་ཞེ་འམ་ལུས་སུ་བསྐོས་པ་འདི་མ་བྱས་ཞེས་འགྱེད་པ་གང་ཡིན་པ་དེ་ཡང་དངོས་པོའི་དེ་བཞིན་ཉིད་མ་ཡིན་པ་མ་ཡིན་ཏེ།",
    "འདི་ནི་འཁྲུག་ལོང་གི་རྒྱུ་གཉིས་པ་ཡིན་ནོ།",
    "འཁྲུག་ལོང་གི་རྒྱུ་གསུམ་པ་ཡིན་ཏེ།",
    "གསོལ་བ་ལ་སོགས་པའི་ལས་ལ་མཐུན་པ་མི་སྦྱིན་པ་སྟེ་དེ་ནི་འཁྲུག་ལོང་གི་རྒྱུ་བཞི་པ་ཡིན་ཏེ།",
    "འཁྲུག་ལོང་གི་རྒྱུ་བཞི་པོ་དེ་དག་གིས་བསྐྱེད་པའི་འཁྲུག་ལོང་བཞི་པོ་དེ་དག་ཇི་ལྟར་ཉེ་བར་ཞི་བར་འགྱུར་ཞེ་ན་དེའི་ཕྱིར།",
    "འདི་ལྟར་དངོས་པོའི་རང་གི་ངོ་བོ་ལ་ལོག་པར་བསྒྲུབ་པ་ནི་ཐེ་ཚོམ་ཞེས་བྱ་སྟེ།",
    "རྣམ་པར་ཤེས་པས་ན་རང་གི་ངོ་བོའི་ཉེས་པ་དང་།",
    "རྣམ་པར་མི་ཤེས་པ་ན་རང་གི་ངོ་བོའི་ཉེས་པས་སོ།",
    "འགྱེད་པ་གཉིས་རང་གིས་མ་ནུས་ན་ཆོགས་པར་དབྱུང་བ་ངག་གིས་ལེགས་པར་བསྒྲུབ་པོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གལ་ཏེ་འགྱེད་པར་བྱེད་པའི་གང་ཟག་དེ་གཉིས་རང་གིས་རྩོད་པ་དེ་ཉེ་བར་ཞི་བར་བྱེད་མི་ནུས་ན་ཚོགས་པར་དབྱུང་བ་དག་གིས་དོན་དེ་ལེགས་པར་བསྒྲུབ་ཅིང་མཐའ་གཅིག་ཏུ་བྱའོ།",
    "བདེན་མོད་ཀྱི་དེ་ནི་ཕྱོགས་གཉིས་སུ་རྣམ་པར་གནས་པས་དེ་ལ་གཉིས་ཉིད་དུ་གྱུར་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཚོགས་པར་དབྱུང་བ་ཇི་ལྟ་བུ་དག་གིས་ཤེ་ན།",
    "དེའི་ཕྱིར་དགེ་སློང་དག་གིས་སོ་ཞེས་བྱ་བ་སྨྲས་སོ།",
    "ཇི་སྙེད་དག་གིས་ཤེ་ན་དེའི་ཕྱིར་གཅིག་ཡན་ཆད་ཀྱིས་སོ་ཞེས་བྱ་བ་སྨྲས་སོ།",
    "ཕྱོགས་ཅིག་ཤོས་སུ་ཡང་མ་སོང་ལ་གཉིས་པར་ཡང་མ་སོང་བ་གང་ཡིན་པའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རྩོད་པ་གཅིག་གི་ཕྱིར་འཕྲལ་ལ་བསྐོ་བར་བྱ་བ་ནི་མ་ཡིན་ནོ།",
    "འདིར་འཐབ་མོ་མི་སྐྱེད་པ་བསྐོ་བར་བྱ་བ་ཉིད་དོ་ཞེས་བྱ་བ་ནི།",
    "མ་མོ་ལས་འདི་སྐད་དུ་གསུངས་ཏེ།",
    "ལུས་དང་ངག་གིས་མི་འཇུག་པ་དང་།",
    "ཞེ་སྡང་གིས་འགྲོ་བ་མ་ཡིན་པ་དང་།",
    "གཏི་མུག་གིས་འགྲོ་བ་མ་ཡིན་པ་དང་།",
    "བརྟན་པ་ཞེས་བྱ་བས་ནི་ལུས་དང་ངག་གིས་མི་འཇུག་པ་བསྡུས་སོ།",
    "དས་ནི་གཏི་མུག་གིས་འགྲོ་བ་མ་ཡིན་པ་ཞེས་བྱ་བ་ཡན་ཆད་བསྡུས་ཏེ།",
    "གལ་ཏེ་དགེ་སློང་གཟུ་བོ་དག་གིས་རྩོད་པ་དེ་ཉེ་བར་ཞི་བར་བྱེད་མ་ནུས་ན།",
    "གསལ་བ་དང་གསལ་བའི་ཡང་གསལ་བ་གང་ཡིན་པ་དེ་དག་གིས་རྩོད་པ་དེ་ཉེ་བར་ཞི་བར་བྱེད་མ་ནུས་ཤིང་།",
    "གསལ་བའི་ཡང་གསལ་བ་དག་གིས་ནི་གསལ་བདག་ལའོ།",
    "གསལ་བདག་གིས་ནི་གཟུ་བོ་དག་ལའམ།",
    "གཟུ་བོ་དག་གིས་ནི་རྒོལ་བ་དང་ཕྱིར་རྒོལ་བ་དག་ལའོ།",
    "གནས་བརྟན་དག་གིས་ནི་རྩོད་པ་སྦེད་པ་ལའོ།",
    "རྩོད་པ་འདི་གནས་ཆེ་གེ་མོ་ཞེས་བགྱི་བར།",
    "གང་ཟག་ཆེ་གེ་མོ་ཞེས་བགྱི་བ་དང་།",
    "དེ་དག་གིས་དགེ་སློང་གསལ་བའི་ཡང་གསལ་བ་དག་བསྐོས་ན།",
    "དགེ་སློང་གསལ་བའི་ཡང་གསལ་བ་དེ་དག་གིས་ཀྱང་རྣམ་པར་ཞི་བར་བགྱིད་རྔོ་མ་ཐོགས་ཏེ།",
    "རྩོད་པ་འདི་གནས་ཆེ་གེ་མོ་ཞེས་བགྱི་བར་གང་ཟག་ཆེ་གེ་མོ་དང་།",
    "མིང་ཆེ་གེ་མོ་ཞེས་བགྱི་བ་ལས་གཞི་འདིའི་སླད་དུ་བྱུང་ནས།",
    "དགེ་སློང་གསལ་བའི་ཡང་གསལ་བ་དེ་དག་གིས་ཀྱང་རྣམ་པར་ཞི་བར་བགྱིད་རྔོ་མ་ཐོགས་ཏེ།",
    "དེ་དག་གིས་གསལ་བ་རྣམས་ལ་ཕུལ་བ་ལས་གསལ་བ་རྣམས་ཀྱིས་དགེ་སློང་ལ་ཕུལ་ནས།",
    "མ་མོ་འཛིན་པ་རྣམས་ལ་དབུལ་ལོ།",
    "དེ་དག་གིས་གནས་བརྟན་མཐུ་དང་ལྡན་པ་ལའོ་ཞེས་བྱ་བ་ནི།",
    "མ་མོ་འཛིན་པ་དེ་དག་གིས་རྩོད་པ་ཕྱིར་ཕུལ་བདེ་གནས་བརྟན་གྲགས་པ་བས་ཀྱང་ཆེས་གྲགས་པ།",
    "རྩོད་པ་འདི་གནས་ཆེ་གེ་མོ་ཞེས་བགྱི་བར་གང་ཟག་ཆེ་གེ་མོ་ཞེས་བགྱི་བ་དང་།",
    "མིང་ཆེ་གེ་མོ་ཞེས་བགྱི་བ་ལས་གཞི་འདིའི་སླད་དུ་བྱུང་ནས་ཡུན་འདི་སྲིད་ཅིག་ལགས་ཏེ།",
    "དེ་དག་གིས་དགེ་སློང་གསལ་བའི་ཡང་གསལ་བ་དག་བསྐོས་ན།",
    "དགེ་སློང་གསལ་བའི་ཡང་གསལ་བ་དེ་དག་གིས་ཀྱང་རྣམ་པར་ཞི་བར་བགྱིད་རྔོ་མ་ཐོགས་ཏེ།",
    "མ་མོ་འཛིན་པ་རྣམས་ལ་ཟླ་བ་དྲུག་གི་མཐའ་ཚུན་ཆད་དུ་ཕུལ་ན།",
    "དེ་དག་གིས་ཀྱང་རྣམ་པར་ཞི་བར་བགྱིད་རྔོ་མ་ཐོགས་ནས།",
    "དེ་དག་གིས་བདག་རྩོད་པ་སྤེད་པ་མིང་འདི་ཞེས་བགྱི་བ་ལ་སྩལ་ཏེ།",
    "དེས་དེ་གཉིས་ལས་བདག་གིར་བྱ་བ་ཐན་འདག་རྫས་དང་སོ་ཤིང་ཡན་ཆད་ཅུང་ཟད་ཀྱང་སྤང་བར་བྱའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཚོགས་པར་དབྱུང་བདག་གིས་རྒྱུད་གཅིག་ཏུ་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཇི་སྐད་བསྟན་པའི་རྣམ་པ་དག་གིས་འགྱེད་པའི་ཕྱིར་རྩོད་པ་ཉེ་བར་ཞི་བར་བྱ་བའི་རྣམ་པ་ཇི་སྐད་བསྟན་པ་དེ་དག་ལ་འདི་ལྟ་སྟེ།",
    "དེའི་ཕྱིར་གནས་བརྟན་གྱི་མཐར་ཐུག་པ་དག་ཡོངས་སུ་ཉོན་མོངས་པར་གྱུར་བ་དག་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གང་གིས་འདི་ལ་བརྟེན་པར་བྱ་ཞེ་ན་དེའི་ཕྱིར།",
    "ཆེས་མང་པོའི་བློས་ལེགས་པར་གཞག་པ་འདི་ལ་ཚུལ་ཤིང་བྲིམ་པས་རྒོལ་བ་དང་ཕྱིར་རྒོལ་བ་དག་གིས་བློ་བཟུང་ཞིང་འདྲང་བར་བྱ་བ་ཉིད་ཡིན་ན།",
    "དགེ་སློང་ཚུལ་ཤིང་འདྲིམ་པ་མིང་འདི་ཞེས་བགྱི་བ་འདི་ཚུལ་ཤིང་འདྲི་མ་མོ།",
    "དེའི་ཚུལ་ཤིང་དག་ནི་ཡ་ཡོ་ཅན་དང་ཁྱར་ཁྱོར་ཅན་དང་ཆས་ཆུས་ཅན་དང་ཁ་དོག་དན་པ་དང་དྲི་ངན་བ་དང་རག་པ་རྩུབ་པ་ཉིད་དག་ཡིན་ནོ།",
    "བདག་དགེ་སློང་གྱད་བུ་ནོར་ལ་དགེ་སློང་མ་མཛའ་མོས་ཡང་དག་པ་མ་ལགས་པ་གསོབ་གསོག་བརྫུན་གྱིས་སྐུར་ཏེ།",
    "བདག་ལ་དགེ་སློང་དག་གིས་གཞི་དེས་གླེང་བས།",
    "དགེ་སློང་གྱད་བུ་ནོར་འདི་ལ་དགེ་སློང་མ་མཛའ་མོས་ཡང་དག་པ་མ་ལགས་པ།",
    "གང་གི་ཕྱིར་སྨྱོས་པའི་གནས་སྐབས་དང་ལྷན་ཅིག་ཐ་སྙད་འགའ་ཡང་མེད་པ་དེའི་ཕྱིར་སྨྱོས་པའི་གནས་སྐབས་སུ་ལྷག་པར་སྤྱོད་པ་བྱས་པས་གླེང་བ་ཡང་མེད་པ་ཁོ་ནར་འགྱུར་བས།",
    "དགེ་སློང་གི་ཚུལ་མ་ལགས་པ་རྗེས་སུ་མཐུན་པ་མ་ལགས་པ་རུང་བ་མ་ལགས་པ་ཚུལ་དང་མཐུན་པ་མ་ལགས་པ་མང་དུ་སྤྱད་ཅིང་སྨྲས་ཏེ་བརྩལ་ནས་མིག་གྱུར།",
    "དགེ་སློང་གི་ཚུལ་མ་ལགས་པ་རྗེས་སུ་མཐུན་པ་མ་ལགས་པ།",
    "གང་ལ་དགེ་སློང་གི་ཚོམས་གཅིག་ཀྱང་མ་ལུས་པར་དགེ་སློང་མཐའ་དག་ཕྱོགས་དང་གཞན་གྱི་ཕྱོགས་སུ་རྣམ་པར་གནས་པས་འཁྲུག་ལོང་དུ་གྱུར་པའོ།",
    "འཁྲུག་ལོང་མེད་པ་ལ་ཁས་བླང་པ་འབའ་ཞིག་གི་ཕྱིར་བཅོས་པར་བྱ་བ་དེ་ནི་ཁས་བླངས་པའི་བྱ་བས་རྩོད་བ་ཞི་བར་བྱ་བ་ཞེས་བྱ་བ་སྟེ།",
    "གླེང་བར་བྱ་བ་དང་གླེང་པ་པོ་དང་དེ་དག་གི་རྗེས་སུ་འབྲང་བ་རྣམས་ཀྱིས་རྒོལ་བ་དང་ལན་མངོན་སུམ་དུ་བྱུང་བ་གང་ཡིན་པ་དེ་ནི་སྔོན་དུ་བརྟན་བ་ཡིན་པའི་ཕྱིར་མིང་དེ་སྐད་ཅེས་བྱས་སོ།",
    "དེ་ལྟར་ན་འདིར་ཚིག་གི་དོན་འདི་འབྱུང་སྟེ།",
    "འདི་ལ་རྒོལ་བ་ལ་དང་ལན་གྱི་ཚིག་དག་མངོན་སུམ་དུ་བྱུང་བ་དག་གིས་འདུལ་ཞིང་ཞི་བ་ཡིན་གྱི།",
    "གཅིག་གིས་ཕྱིར་བཅོས་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "འགྱེད་པར་གྱུར་ཅིང་གནས་ཏེ་ཕྱོགས་དང་གཞན་གྱི་ཕྱོགས་སུ་རྣམ་པར་གནས་པ་ནི་བདག་ཅག་གིས་མ་རྙེད་དེ་རྙེད་པ་མ་ཡིན་ནོ།",
    "ཕྱོགས་དང་གཞན་གྱི་ཕྱོགས་སུ་རྣམ་པར་གནས་པ་ནི་བདག་ཅག་གིས་མ་རྙེད་དེ་རྙེད་པ་མ་ཡིན་ནོ།",
    "མཐོལ་ཞིང་བཤགས་ན་བདག་བདེ་བ་ལ་རེག་པར་འགྱུར་རོ།",
    "སྡོམ་མོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ལྷན་ཅིག་གིས་དངོས་པོས་གླང་བ་ཉིད་དུ་རུང་ངོ་ཞེས་བྱ་བ་ནི།",
    "གང་ཟག་གིས་གང་ཟག་ལ་གླེང་བར་བྱེད་པ་དང་།",
    "གང་ཟག་གིས་གང་ཟག་གཉིས་ལ་དང་།",
    "གང་ཟག་གིས་གང་ཟག་མང་པོ་ལ་དང་།",
    "གླེང་བར་བྱེད་པའི་སྐབས་ལྷན་ཅིག་གིས་དངོས་པོར་བསྟན་པ་དེ་དག་བསྡུའོ།",
    "ལྷན་ཅིག་གིས་དངོས་པོས་རུང་བའོ།",
    "གིས་བྱ་བར་མ་ངེས་པའོ།",
    "གླེང་བ་པོ་ལུས་དང་ངག་དག་གིས་བསྡམས་པ་ཉིད་དང་།",
    "ལུས་དང་ངག་དག་གིས་བསྡམས་པ་ཉིད་དང་།",
    "མི་བགྲང་ཞིང་སྨད་པ་དང་དེའི་ཚིག་གིས་ཅུང་ཟད་ཀྱང་བསྒྲུབ་པར་མི་བྱའོ།",
    "ལོག་པར་སྟོན་པའི་རྣམ་པ་དེ་ལྟ་བུ་མ་ཡིན་པ་ལུས་དང་ངག་དག་གིས་བསྡམས་པ་དང་།",
    "དུས་ཞེས་སྨོས་པས་ནི་མཚན་མོ་བྱས་པས་གླེང་བ་དང་།",
    "ཉིན་མོ་བྱས་པས་གླེང་བ་ལ་སོགས་པ་བསྡུས་སོ།",
    "གང་གི་ཚེ་གླེང་བའི་གང་ཟག་ཉེས་པ་ཁས་མི་ལེན་པ་དེའི་ཚེ་ཇི་ལྟར་ངེས་པར་བྱ་ཞེ་ན།",
    "འདིར་གཞུང་ནི་སྲིལ་བུ་དག་ལས་བཙུན་པ་རེ་ཞིག་དགེ་སློང་གཉིས་ལ་ཐ་དད་པར་སྨྲ་བ་དང་།",
    "གང་གི་ཚིག་གཟུང་བར་བགྱི།",
    "གཞན་དེ་ཡང་དྲི་བར་བྱ་ཞིང་དེའི་ཚིག་གིས་ཅིག་ཤོས་ཀྱི་ཚིག་གཟུང་བར་བྱའོ།",
    "དྲི་བར་བྱ་ཞིང་གལ་ཏེ་དེ་ནི་སྲིང་མོ་འགའ་ཞིག་ཀྱང་ཡོད་དོ་ཞེས་ཟེར་ན་གཉི་ག་ལ་དྲི་བར་བྱའོ།",
    "གལ་ཏེ་འདིས་རྒྱལ་རིགས་མོ་དང་ལྷན་ཅིག་མི་ཚངས་པར་སྤྱོད་པ་མ་བྱས་ཀྱི།"
  ]
