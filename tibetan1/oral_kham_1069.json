    "ཕུང་པོ་ལས་དོན་གཞན་དུན་མི་འདུག།",
    "ཕུང་པོ་ལས་དོན་གཞན་དུའང་ང་མེདན་ང་རང་བཞིན་གྱིས་མེད་དགོས།",
    "ཡོད་རྒྱུ་རྡུལ་ཙམ་ཡང་མི་འདུག་སྙམ་པའི་ངེས་བ་ལྷང་ལྷང་བ་ཤད་ཆན་སྐྱེས་པ་དང་།",
    "རྒྱའབྲས་དང་བྱ་བྱེད་འཇོག་པ་ཞིག་ནི་འདུག་པའི་ཕྱིར།",
    "ད་དུང་ཡང་མྱོང་དགོས་པར་འདུག་པ་འདི་ལ་རྒྱུ་གཞི་ཡོད་པར་ངེས།",
    "ཞེན་ཚད་བདེན་ཞེན་དུ་འདོད་པའི་ལུགས་དང་ཁྱད་པར་མི་འདུག་པས།",
    "འདིའི་གཉེན་པོ་རང་དུ་འདི་འདྲ་ཞིག་བསྒོམ་ན་འགྲོ་བ་འདུག།",
    "ཡང་ད་ལྟ་སོ་སྐྱེ་ལ་གང་སྣང་ཐམས་ཅད་རང་བཞིན་གྱིས་གྲུབ་པར་སྣང་འིའཆར་ལུགས་ཡིན་ཟེར་བཞིན་དུ་ཡང་སེ་སྐྱ་ལ་གང་སྣང་ཐམས་ཅད་སྣང་བ་ལྟར་མེད་ཟེར་འི་ནུས་པའི་ཆེན་གཅིག་འདུག་པ།",
    "དེ་འདྲའི་སྣང་རྔུལ་ཅི་འདྲ་ཞིག་བྱུང་ཡང་ཀུན་བཏགས་ཡིད་དཔྱོད་འབའ་ཞིག་ཡིན་གསུང་བ་འདུག་བ།",
    "ངེད་རང་ལ་འཆར་སྒོ་འདི་འདྲ་འདུག་པ་སྔར་ནས་ཐིགས་རྒྱུརང་དུ་འདུག་ཁ་ལ་སྙམ་པ་ཞིག་བྱུང་གསུང་།",
    "འདེན་སྦྲུལ་གྲྭ་བ་ཞིག་འདུག་སུམ་ནས་སྐྲག་དངངས་ཆེན་པོ་བྱུང་བའི་ཚེ།",
    "དེ་ལ་དགག་བྱ་སྦྱར་ནས་ངའོ་སྙམ་དུ་བཛིན་པ་དགོས་པར་གསུངས་འདུག་པས།",
    "རང་མཚན་གྱིས་གྲུབ་པ་སྔ་ཕྱི་བ་ལ་ལྟོས་པའི་འབྲེལ་བ་བཞག་ས་མི་འདུག་པའི་ཕྱིར།",
    "ཕུང་པོ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཐ་དདམ་ཡིན་ཏེ།",
    "ང་དེ་ཕུང་བོ་དང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཐ་དད་ཡིནན།",
    "མ་ཤི་ཁ་ལ་སེམས་ཁྲལ་བྱེད་རྒྱུར་མི་འདུག་པ་ལ་མི་ཤིབ་ལ་སེམས་ཁྲལ་ཡོང་བ་འདུག་པའི་ཕྱིར་དང་།",
