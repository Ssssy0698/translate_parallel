    "དེ་ནས་འཆི་ཞག་ཉེར་དྲུག་པ་དང་རང་བཞིན་ས་གཉིས་ཀྱིས་རྩ་འདབ་དྲུག་པ་གཅོད་པར་བྱེད་ཅིང་།",
    "དེ་ནས་འཆི་ཞག་ལྔ་དང་རང་བཞིན་ས་སུམ་བརྒྱ་ཞེ་ལྔས།",
    "འཆི་ཞག་ལྔ་དང་རང་བཞིན་ས་གྱ་གཉིས་ཀྱི་ཁྱིམ་བཞི་པ་དང་།",
    "འཆི་ཞག་གཅིག་དང་རང་བཞིན་ས་ཉེར་བརྒྱད་ཀྱིས་ཁྱིམ་དྲུག་པ་དང་།",
    "ཞག་གཅིག་དང་རང་བཞིན་ཉེར་བདུན་གྱིས་ཁྱིམ་བདུན་པ་དང་།",
    "ཞེས་འཆི་ལྟས་དང་རང་བཞིན་པ་གྲངས་མཉམ་དུ་རྒྱུ་བ་ལ་སྟོང་བརྒྱ་ཉེར་གཉིས་དང་མངལ་གྱི་རྩ་མ་ཆགས་པའི་ཞག་སུམ་ཅུ།",
    "ཞེས་བཀོད་པའི་ཚིག་ཆེས་གོ་དཀའ་བར་འདུག་ཀྱང་ཞེན་དོན་འདི་ཡིན་པར་སྣང་སྟེ།",
    "ཞག་འདི་བསགས་པས་ཁྱིམ་ལོ་གོ་བདུན་ཙམ་ན་ཁྱིམ་ལོ་བརྒྱར་མ་ལོངས་པས་ལོ་གསུམ་ཕྱོགས་གསུམ་ལོངས་པ་ནས་ཁྱིམ་ལོ་བརྒྱར་ལོངས་འོང་འདུག་པས།",
    "ད་དུང་བསྟན་པའི་མཐར་ཐུག་དུས་འཁོར་རང་ལ་གྲགས་པའི་འཇིག་རྟེན་པའི་དུས་འཁོར་ཀྱི་དངོས་གྲུབ་འཇིག་རྟེན་ལས་འདས་པ་ལས་འཇིག་རྟེན་པའི་དུས་འཁོར་ཀྱི་དངོས་གྲུབ་མ་ཐོབ་པའི་ཕྱིར།",
    "དེ་ནས་རྡོ་རྗེའི་སྐུ་ཉི་མ་ལྟར་གཟི་བརྗིད་འབར་ཞིང་ཡེ་ཤེས་ཀྱང་རང་རིག་པ་དྲན་པ་ཉམས་པ་མེད་པ་ལས་མི་གཡོ་བ་དང་།",
    "རྐང་སོར་རྣམས་དྲག་ཏུ་བསྐུམ་པ་ལ་ཡུམ་པདྨའི་འདུག་སྟངས་ཀྱིས་འཁྱུད་པར་བྱ་སྟེ།",
    "དེས་བེ་རོ་ཙ་ན་ལ་གསུངས་པའམ།",
    "ལྟ་བའི་གདེང་རང་བྱུང་ཡེ་ཤེས་ཀྱི་མན་ངག་དང་།",
    "འོང་མིན་འགྲོ་བ་མ་ཡིན་ཞིང་།",
    "ངེས་པའི་དོན་ལ་གཞོལ་བ་ན་གཞན་ལུགས་དགག་པ་དང་རང་ལུགས་འཇོག་པ་འགར་ཡང་མཛད་པ་མ་ཡིན་ལ།",
    "མ་འཁྲུལ་པ་རང་བདེན་པ་རང་རང་ཕྱོགས་རང་བདེན་པའི་འགོག་བྱེད་དང་།",
    "དེ་ལྟ་ན་ཡང་རང་བློ་དང་འཚམས་པའི།",
    "རང་རང་སོ་སོའི་སྒྲུབ་ཐོབ་གཟི་འོད་ཅན།",
    "སྟན་གཅིག་ལ་འདུག་ནས་ཇི་སྲིད་ཚིམ་པ་དེ་སྲིད་དུ་ཟ་ཞིང་སྟན་དེ་ལས་ལངས་ནས་ཡང་མི་ཟ་བ་དེ་ནི་སྟན་གཅིག་པ་ཞེས་བྱའོ།",
    "འདུག་ནས་ཇི་སྲིད་ཟ་བ་ཐམས་ཅད་མ་བླངས་པ་དེ་སྲིད་ཟས་མི་ཟ་ཞིང་།",
    "ཁྲིའམ་སྟེག་བུའམ་རྩྭའི་སྟེང་ལ་ཙོག་པུར་འདུག་སྟེ་དུས་ཇི་སྲིད་ཀྱི་བར་དུ་འདའ་བར་བྱེད་ཅིང་ཁྲིའམ་རྩིག་པའམ་ཤིང་ངམ་རྩྭའི་སྟན་ལ་བརྟེན་ནས་རྒྱབ་བམ་གློས་འབེབས་པར་མི་བྱེད་པ་དེ་ལྟ་བུ་ནི་ཅོག་པུ་པ་ཡིན།",
    "རོལ་ཆའི་བྱེ་བྲག་བརྡུང་བ་རྣམས་བར་ཁང་དུ་བཞག་ནས་ཡང་ཐོག་ཏུ་ཁྲི་སྟེང་དུ་དབུས་ཀྱི་གཙོ་བོར་གྱུར་པས་ཉེ་བར་འདུག་སྟེ།",
    "༩ བཅོས་མ་མ་ཡིན་གྱི་འོན་ཀྱང་རང་ལས་སྐྱེས་ཤིང་བདག་ཉིད་ལས་སྐྱེས་པ་ཡིན་ན་ཡང་།",
    "ཐུགས་རྡོ་རྗེ་དང་དེའི་རྡོ་རྗེ་ཅན་རྣམས་ཐུགས་རྡོ་རྗེ་དང་རང་ལ་ཐིམ།",
    "ཞེས་གསོལ་བ་བཏབ་པས་གསུང་རྡོ་རྗེ་དང་དེའི་རྡོ་རྗེ་ཅན་རྣམས་གསུང་རྡོ་རྗེ་དང་རང་ལ་ཐིམ།",
    "སྐུ་རྡོ་རྗེ་དང་དེའི་རྡོ་རྗེ་ཅན་རྣམས་སྐུ་རྡོ་རྗེ་དང་རང་ལ་ཐིམ།",
    "ཉི་ཤུ་རྩ་ལྔ་ལྷག་པའི་བརྒྱ་ཕྲག་གང་ཞིག་དུས་དང་དགུ་ཡི་མི་རྣམས་ཀྱི་ནི་འཇིག་རྟེན་ཚད།",
    "རང་རང་ལུས་ཀྱི་དེ་དེའི་ཆ་དག་ལ།",
    "གཞན་རྣམས་སྦོམ་ས་རང་རང་དཀྱུས་ཀྱི་སྐོར།",
    "མཐུན་པ་མི་དགོས་རང་རང་དབྱིབས་བཞིན་བྱ།",
    "རང་རང་ལུགས་བཞིན་བྱས་པས་འགལ་བ་མེད།",
    "ཨོཾ་བ་བེ་རོ་ཙ་ནཱི་ཡེ་ཱུཾ་ཱུཾ་ཕཊ་ཕཊ་ཱ་ཧཱ།",
    "རང་ཉིད་ཤར་རམ་ལྷོར་ཁ་ཕྱོགས་པས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "འདི་རུ་མ་འདུག་གཞན་དུ་དེངས།",
    "ཁྱེད་ཧོར་གྱི་གདན་འདྲེན་ལ་བྱོན་ན་འགྲོ་དོན་ཆེན་པོ་འོང་བར་འདུག་ཀྱང་སྐུ་ཚེ་ཐུང་འདུག་ཅེས་གསུངས་པ་དྲན་ཏེ་ཐབས་སྣ་ཚོགས་ཀྱིས་བྱོལ་ཏེ་མ་བྱོན།",
    "ཉིན་དང་བོར་ངའི་ལག་ན་དཀར་མེ་གཉིས་འདུག་པའི་འོད་ཆེས་ཆེར་འབར་ནས་འཇིག་རྟེན་ཐམས་ཅད་གསལ་བར་བྱེད་པ་ཞིག་རྨིས།",
    "སོ་དྲེག་ཆགས་ན་རའི་ལྤགས་པ་གོན་ནས་ཤར་དུ་བལྟས་ཏེ་རའི་འདུག་སྟངས་ཀྱིས་ཉི་མ་རྩེ་ཤར་ལ་རའི་སྐད་ལན་གསུམ་གདོན་ནོ།",
    "མིག་གྱེན་དུ་ལྡོག་དུས།",
    "ལག་དེབ་འདི་བཞིན་སྒྱུར་སྒྲིག་དུས་ཡུན་ཐུང་བ་དང་།",
    "གཞན་དང་གཞན་གྱི་རྗེས་སུ་འདུག་པ་དང་།",
    "བདེ་བ་ལ་སོགས་པའི་ཡུལ་མྱོང་བ་ལ་བལྟས་ནས་སྲིད་པའི་ཡན་ལག་འདི་དག་འདུག་པ་དེ་ནི།",
    "འདུག་པ་དང་།",
    "འབྲས་བུ་ཐན་བུཚོགས་པ་དང་རང་བཞིན་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "སེམས་རྣལ་དུ་འདུགཔ་ཉིད་དང་།",
    "མ་བརྩལ་རང་འབྱུང་རང་སེམས་།",
    "རྨི་ལམ་རང་སྣང་རང་སེམས་ངང་།",
    "དྲི་གདའ་སྤོས་རིའི་གནས་དེ་རུ།",
    "རིག་པའི་ཡེ་ཤེས་ལྔ་ཡང་རང་སེམས་སྟོང་པའི་ཀློང་།",
    "མ་རིག་འཁྲུལ་པ་རྣམས་ཀྱང་རང་སེམས་སྟོང་པའི་ཀློང་།",
    "འོག་མིན་ཞིང་ཁམས་ཀྱི་ཀུན་བཟང་རང་སེམས་སྟོང་པའི་ཀློང་།",
    "འོག་མིན་གྱི་ཀུན་བཟང་དང་རང་རྒྱུད་ཀྱི་ཀུན་གཞི་ཡང་སེམས་སུ་ཟད།",
