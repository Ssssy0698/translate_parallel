    "ང་ལ་དུག་སྐད་ཅིག་ལས་མེད་པས་ཁ་དེ་ལ་དུག་ནི་བཟེད་པར་འདུགཞུ་དུག་ཅིག་བྱུང་ན་མ་འགྱོད་པ་གྱིས་ཨང་།",
    "ཞི་བདེའི་སྔོ་སྐམ་ཁྱེར་ཉེན་འདུག།",
    "ཧྲིག་གེ་འདུག་ཀྱང་ངོ་མ་ཤེས།",
    "མཁས་པས་བལྟས་ན་གཅིག་ཏུ་འདུག།",
    "དུས་ད་ལྟ་ཇ་མཆོད་དང་བྱི་མཆོད་གཉིས་སུ་འདུག་ད་ལམ་ཇ་མཆོད་འདི་ལྟར་འཕུལ།",
    "ད་ལྟ་དགས་པོའི་སྐོམ་དུ་འདུག།",
    "མི་ལྟོགས་རྣམས་ཀྱིས་བཏུངས་ཙ་ན།",
    "ཁྱེད་ཀྱི་མཚན་ནི་བཞི་རུ་འདུག།",
    "མི་གནོད་འདུག་ན་རྒྱག་ཚད་བཞེས་པ་ཞུ།",
    "ད་ལྟའི་ལུས་ནི་སྣ་ཚོགས་ལེན་གྱི་འདུག།",
    "འཆི་མེད་གནས་སུ་ཕྱིན་པ་མི་འདུག་པ།",
    "དོན་དམ་བདེན་པ་མེད་ཟེར་སྨྲ་མཁན་འདུག་སྟེ།",
    "ཕ་རོལ་མགུར་ཡང་རང་ལ་གནོད་པ་འདྲ།",
    "བསམ་པ་མ་རྫོགས་རིལ་སྡོད་པ་དཀོན་པོ་འདུག་གོ།",
    "གཡོག་སྐྱེན་པ་སུ་ལ་ཡང་མི་འཇིགས་པ་མང་པོ་འདུག་སྟེ།",
    "རྒས་ཁར་འགྱོད་པ་མི་སྐྱེ་བ་མང་པོ་མི་འདུག་གོ།",
    "འཁོར་འདས་རོ་གཅིག་ཏུ་རྟོགས་པ་དཀོན་པོ་འདུག་གོ།",
    "གཏེར་བཏོན་ཤོག་སེར་ཁྱེར་ནས་ལུང་བསྟན་ཤོད་མཁན་མང་པོ་འདུག་སྟེ།",
    "ཐད་ལྡན་མངོན་ཤེས་ཤོད་མཁན་དཀོན་པོ་འདུག་གོ།",
    "སྐྱེས་ནས་འཆི་བ་དང་འགྲོགས་པ་ནི་སུས་ཀྱང་མ་ཚོར་བ་འདུག་གོ།",
    "ནོར་བུ་གཞན་དུ་འཚོལ་བ་ནི་ཅུང་རང་མ་དགོངས་པ་ཡིན་པ་འདྲ།",
    "གདན་དགུ་བརྩེགས་ཀྱི་སྟེང་དུ་སླེབས་ཙ་ན།",
    "ཐབས་ལམ་ཁ་ལ་ཤོར་བའི་དུས་ཙ་ན།",
    "རྒྱལ་ཁམས་ཕྱོགས་མེད་བསྐོར་བའི་དུས་ཙ་ན།",
    "དང་པོའི་ཕ་ཡུལ་འདི་རུ་སླེབས་ཙ་ན།",
    "ཕ་ཚན་ཕ་སྤུན་ཀུན་དང་འགྲོགས་ཙ་ན།",
    "ཚེ་འདིའི་འདུན་མ་མཚར་པོ་ཚོ་མཐོང་ཙ་ན།",
    "ཟེར་བའི་ཡི་གེ་འདུག་པས་ཨ་ཅེ་ཁྲ་འབུར་གྱི་ཕར་ཐོས་ཚོར་ནས།",
    "ཐབས་ཤེས་ཉི་ཟླ་འཆར་ཞིང་གདའ།",
    "འོན་ཀྱང་འགྱོད་པ་མི་འདུག་པས།",
    "ཁྱེད་རང་རྣམས་བྱུང་ན་དེ་ལྟར་མཛོད།",
    "ངོ་སྤྲོད་དམར་ཁྲིད་ཟབ་རུང་རང་ཞལ་མི་མཐོང་བར།",
    "མིག་འཛུམ་ཕར་རིག་ཚུར་རིག་འདྲེ་མཐོང་མཐོང་བྱེད་འདུག་པ་ལ་ཡིད་མ་རངས་ནས་སྐྱོ་གླུའི་ཚུལ་དུ་མ་ཎི་བྲོ་བརྡུང་བྱས་སོ།",
    "ཨ་ཞང་ཁྱུང་སྐྱབས་གླུ་ལ་དགའ།",
    "ཤར་ཀུན་བཟང་གླིང་ནས་བལྟས་ཙ་ན།",
    "གྱེར་གླིང་བརྒྱབ་ནས་བལྟས་ཙ་ན།",
    "ཆུ་ཕུ་ཡུལ་ཐོས་མཐོང་ཙ་ན།",
    "དགག་སྒྲུབ་མིན་པ་མི་འདུག་པ།",
    "འོ་ན་ཁྱེད་རང་ཐེགས་པར་ཞུ།",
    "བློ་གཏད་ཐུབ་པ་ཤཱཀྱ་ཐུབ་པ་ལས་མི་འདུག།",
    "སྐྱོ་བ་སྐྱེ་མཁན་གཅིག་ཀྱང་མི་འདུག་གོ།",
    "ཁྱེད་རང་ཐུགས་ལ་གང་འདོད་ལག་ལེན་གྱིས།",
    "ཁྱག་རུམ་ཐམས་ཅད་ཆུ་རུ་བཞུ་རུད་བཏུབ་པ་ཙམ་འདུག་སྟེ།",
    "གླིང་བཞི་གླིང་ཕྲན་དུ་ཆུ་མཚོ་རུ་དཀྱིལ་རུང་བཏུབ་པ་ཙམ་འདུག་སྟེ།",
    "ཤིང་སྒོ་འདྲ་འཛུགས་པའི་རྒྱལ་པོ་དེ་ཁྱེད་རང་ཡིན་པ།",
    "འབེབས་རང་བཏུབ་པ་ཙམ་གདའ་སྟེ།",
    "ས་ཆ་ཡུལ་ཕྱོགས་གཅིག་ཏུ་བསྡད་ཀྱང་ལྟོ་གོས་འཕྱིད་པ་ཙམ་འདུག་སྟེ།",
    "ཡར་སྟོད་བསམ་འགྲུབ་བདེ་ཆེན་ཕྱོགས་ལ་ཕྱིན་ཙ་ན།",
    "འདིས་མི་ཆོག་ལེ་མང་པོ་དགོས་ཟེར་ཞུ་བ་ནན་གྱིས་འབུལ་འདུག་ལ།",
    "རྟ་དེ་ལ་སྐྱོན་ཅིག་འདུག་པས་སྐྱོན་བཙོང་བྱས།",
    "དེ་བཞིན་འདུག་ན་ཚོང་སློག་ཞོ་གང་གྱིས་ལ་སློག་པ་དེ་ཡིན།",
    "ཕ་མ་རྒས་ཁར་ཡིད་ཐག་རྩ་བ་ནས་གཅོད་པ་འདི་ཅི་ཡིན་པ་འདུགསྔགས་བོན་ཚོས།",
    "བཅོལ་པོ་ལེན་མཁན་ཁོ་རང་ལ་རྩད་གཅོད་མཛོད།",
    "ར་སོགས་དཔོན་མགོན་གླང་ཤ་ཞིམ་ཟེར་བ་དཔེར་འདུག་པས།",
    "སྐྱོན་རྐྱང་པ་བརྗོད་པ་མ་ཡིན་འདུག་པ་ནས་བར་མཚམས་བྱས།",
    "ཁྱེད་གཉིས་ཀྱི་ལན་རྩ་རྟ་དེ་ཡིན་འདུག་པས་གོང་ལ་འཕུལ།",
    "དགོས་ཞུ་བར་འདུག་པས།",
    "རང་རང་སོ་སོའི་ལས་ལ་སྤྱོད་པ་སྲིད་པ་སྤྱི་ལུགས་ཀྱི་བབས་སུ་འདུག་པ་དང་།",
    "འཇིག་རྟེན་དག་ཀྱང་བདེ་བར་ཤོགགསུངས་པ་འདུག་པ་ལྟར།",
    "སྒོས་སུ་གྲི་གུ་གཞིས་ཀ་སུས་འཛིན་ཀྱང་དཔོན་གཡོག་ཟས་སྐོམ་གྱི་སྐལ་ཐོབ་ཏུ་འདུག་པ།",
    "ངེད་རང་ལ་ཐུགས་རྗེས་དང་ནུས་པ་འདུག་ན།",
    "དྲང་པོས་དགྲ་ལ་ལོ་བ་ནི་གང་ནའང་དཀའ་འདུག།",
    "སྐྱོ་པོས་མི་ཚེ་འཕྱིད་པ་དེས་རི་ཀླུང་ཁེངས་འདུག།",
    "གང་ལྟར་བྱས་ཀྱང་སེམས་ཀྱི་ལྷག་མར་འདུག།",
    "རྐང་རྗེས་འདུག་པ་དཀྱིལ་འཁོར་ཡིན།",
    "སྐྱིད་འདུག་ཞུལ་བ།",
    "ཁྱེད་རང་རྣམས་ར་ལུང་ལ་ཕྱིན་ན་སྐུ་མཚམས་དང་མ་འགྲིག་ཚེ་མཇལ་ཀ་རང་ཡོང་ངམ།",
    "ཁོ་རང་ཤི་ཡོད་ཟེར་བ་བྱུང་འདུག་གོ།",
    "བདག་རང་ཚུལ་པ་རིང་བ་ཅིག་ཁོང་ལ་གསོལ་བ་འབུལ་ཆས་སོགས་རང་བརྒྱ་འབུལ་འདུག་ང་ལ་རྩམ་པ་ལྕགས་ཕོར་གང་དང་ཤ་ཉག་ཆུང་ཅིག་ཐུད་ལེབ་ཅིག་འགྱེད་ལ་བལ་ཁྱིར་ཅིག་ལས་མ་བྱུང་།",
    "ཁོང་རང་དངོས་སུ་ཕེབས་པ་དང་ཁྱད་མེད་ཅིག་བྱུང་།",
    "ང་རང་ཉིན་རྒྱུན་ཉིན་གུང་དུས་དུས་ཚོད་ཕྱེད་ཙམ་ལ་གཉིད་པ་ཡིན།",
    "ཨ་ཞང་ཚེ་རིང་རྒྱུ་ལ་དགའ་བས་སྔ་གཞུག་ཏུ་ཐེངས་འགའ་ལ་གནས་སུ་སྐྱེལ་ན་ཡང་ཕྱིར་ལྡོམ་ཡོང་།",
