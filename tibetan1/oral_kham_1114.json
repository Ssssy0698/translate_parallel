    "པད་མ་དཀར་སྤྱོད་ཅེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་སྣ་ཚོགས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་མཐོ་བར་གནས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་རྒུན་ཆང་མྱོས་གནས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་ཆུ་བསིལ་གནས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་བརྟན་དགའ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྣམས་ཀྱི་གནས་སྒྲ་སྙན་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་ལྷའི་གནས་དེ་ལ་ཆགས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་སྐྱོར་ཆུས་སྐྱེས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་པི་བང་ཅན་གསུམ་པ་རྣམས་ཀྱི་གནས་ལུས་དཀར་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བྱའི་ཚོགས་མང་པོའི་སྒྲ་འབྱིན་པའི་རི་བོ་དེ་ལ་འཛེགས་ནས་རིའི་རྒྱལ་པོ་རི་རབ་དྲུག་ཁྲིས་བསྐོར་བ་དེ་རྣམས་ཀྱི་དབུས་ན་རིའི་རྒྱལ་པོ་རི་རབ་འདུག་པ་དེ་དག་ཐམས་ཅད་མཐོང་ངོ།",
    "ལྷའི་འཇིག་རྟེན་ན་ལྷ་ཕན་ཚུན་དགའ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་པི་བང་ཅན་གསུམ་པ་རྣམས་ཀྱི་གནས་ཡང་དག་ཆགས་སྤྱོད་ཅེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དབྱིབས་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པའི་སྒྲ་དང་།",
    "ཟེ་བ་རྡོ་རྗེར་འདུག་པ་རྣམས་ཀྱི་ནང་ན་དགའ་བར་བྱེད་དོ།",
    "རི་བོའི་བར་ན་གནས་པར་འགྱུར་ལ་གཉེན་ཆེ་བ་དང་འབྲེལ་པ་དང་རང་དགར་གནས་པ་དང་།",
    "ལྷ་པི་བང་ཅན་གསུམ་པའི་གནས་སྤྱོད་པ་དང་ལྡན་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཇི་ལྟར་འདུག་པ་ནི་འདི་ལྟ་སྟེ།",
    "དེ་ནས་ཡང་དེ་མཛེས་པར་འདུག་སྟེ།",
    "གཟུགས་སྣ་ཚོགས་སུ་འདུག་པ་དག་བརྒྱ་བྱིན་འབའ་ཞིག་ལྟ་ལ།",
    "བརྒྱ་བྱིན་གྱི་སྟན་ཕྱེད་ལ་འདུག་ནས།",
    "ཚལ་དེ་ན་བྱ་དངུལ་གྱི་ཁ་དོག་ཅན་དེ་དག་དེ་རྣམས་ལ་ཆགས་ཤིང་འདུག་པས་ཤིན་ཏུ་མཛེས་པར་བྱས་སོ།",
    "བེ་ཌཱུརྱའི་ཚལ་དྲི་མ་མེད་པ་དེར་ཞུགས་ནས་ཐགས་སུ་བཏགས་པ་མ་ཡིན་པའི་ལྷའི་སྟན་ཁྲ་བོ་བཏིང་བའི་སྟེང་དུ་འདུག་གོ།",
    "འདུག་ནས་དེའི་ལེགས་པར་བྱས་པའི་ལས་དང་།",
    "འཛམ་བུ་ཆུ་བོའི་གསེར་བཟང་པོའི་སྟན་དེ་ཉིད་ལ་འདུག་པ་དང་།",
    "དེ་ནས་དེ་ལྟར་བརྒྱ་བྱིན་ལྷའི་སྟན་ལ་འདུག་ཅིང་།",
    "བརྒྱ་བྱིན་ག་ལ་བ་དེ་ལོགས་སུ་ཕྱོགས་ནས་འདུག་སྟེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་མཐོ་བ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་རི་རྩེ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བལྟ་ན་སྡུག་པ་གནས་པ་ཞེས་བྱ་བའི་གནས་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཚལ་ཆེན་པོ་དེ་དག་བུང་བ་འདབ་མ་བེ་ཌཱུརྱ་ལ་ལུས་དངུལ་དུ་འདུག་པའི་ཚོགས་རྣམས་ཀྱིས་མཛེས་པར་བྱས་པ་ཡིན་ཏེ།",
    "དབྱིབས་སྣ་ཚོགས་སུ་འདུག་པ་བྱེ་བ་ཕྲག་སྟོང་དཀྲིགས་པ་དག་བྱུང་ངོ།",
    "འགྲོ་བ་དེ་རྣམས་ཀྱི་ཤིང་རྟ་འབུམ་ཕྲག་དུ་མའི་མུ་ཁྱུད་ཀྱིས་གསེར་གྱི་རྡུལ་བསླང་སྟེ་ནམ་མཁའ་ཁྱབ་པར་བྱས་ནས་འདུག་གོ།",
    "མིག་རྒྱས་པ་ལྟ་བུར་འདུག་པ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་ཕྱོགས་གཅིག་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཤིང་གསེབ་ན་གནས་པ་ཞེས་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཐད་ཀར་ལྟ་ཞིང་འདུག་པར་མི་བྱེད་པ་དང་།",
    "དེ་ནས་ཡང་ཤིང་གསེབ་ན་གནས་པའི་ལེགས་པར་བྱས་པ་རྣམས་ཀྱི་ལས་ཀྱི་མཐུ་ནི་ལྷ་དག་ལྷའི་པད་མ་ལ་འདུག་ནས་གང་དུ་འགྲོ་བ་དེར་ནམ་མཁའ་དེ་ལས་ལྷའི་བཏུང་བས་གང་བའི་ལྷའི་སྣོད་དག་ལག་ཏུ་འོང་སྟེ།",
    "དེ་ནས་ལྷའི་རྒྱལ་པོ་བརྒྱ་བྱིན་ཡང་པད་མ་འདབ་མ་སྟོང་ལ་སྡོང་བུ་ལྷའི་གསེར་དང་བེ་ཌཱུརྱ་ལས་བྱས་པའི་སྟེང་དུ་འདུག་ནས།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཤིང་རྟ་སྣ་ཚོགས་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བུང་བ་སྒྲ་འབྱིན་པ་ཁ་དོག་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པ་རྣམས་ཀྱིས་པད་མའི་རྫིང་བུ་དེ་དག་ཁེབས་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་གང་དངུལ་གྱི་ལྟོར་འདུག་པ་དེའི་སྒྲོ་གསེར་ལ།",
    "ཤིང་གེལ་བ་སྣ་ཚོགས་དག་ཕན་ཚུན་འཛིངས་པར་འདུག་ལ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་དགའ་བ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "སྐད་ཅིག་གཉིས་པར་མི་འདུག་སྟེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ས་རྣམ་མཛེས་ན་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་ས་ཡོངས་འདུ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་འདྲེས་པའི་འགྲམ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ནེ་ཙོ་ཁ་དོག་སྣ་ཚོགས་སུ་འདུག་པ།",
    "གཟུགས་དང་ཆ་བྱད་སྣ་ཚོགས་སུ་འདུག་པ།",
    "རིའི་རྒྱལ་པོ་རི་རབ་འདུག་པ་དེ་དག་ཐམས་ཅད་ལ་ལྟ་བར་བྱེད་དེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་ཀུན་དུ་གསལ་བར་སྤྱོད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་ཐམས་ཅད་ཀྱང་ཟིལ་གྱིས་མནན་ནས་འོད་ཀྱི་ནང་དུ་འདུག་སྟེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་དམའ་བ་དང་མཐོ་བ་ན་རྒྱུ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་བཀྲ་བ་སྣ་ཚོགས་ཀྱིས་ཕྱེ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་སྦྱོར་བ་ལ་འཇུག་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེ་དག་དུས་ཡུན་རིང་དུ་རྩེ་བར་བྱེད་ཀྱང་བག་མེད་པ་ལ་གནས་པ་དག་ཁོང་དུ་མི་ཆུད་དེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་ཞིབ་ཏུ་དཔྱོད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེ་དང་ཐད་ཀར་འདུག་པར་ཡང་བྱེད།",
    "ཡིད་དུ་འོང་ལའང་འདུག་མི་བྱེད།",
    "དེ་ནས་བརྒྱ་བྱིན་གྱི་སྔོན་ན་འདུག་པའི་ལྷ་དེ་དག་ཐམས་ཅད་བཅོམ་ལྡན་འདས་ལ་ཡིད་དད་པ་སྐྱེས་སོ།",
    "ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཟླ་བའི་གནས་ལྟར་རྒྱུ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "གྲིབ་མ་དེ་དག་ལ་བསིལ་བར་འདུག་ཅིང་དེ་དག་ཀྱང་གདུང་བས་གདུངས་ལ་ཤིན་ཏུ་སྡུག་བསྔལ་བར་གྱུར་པ་རྣམ་པ་དེ་ལྟ་བུའི་མ་བྱིན་པར་ལེན་པ་ཡང་ཡོངས་སུ་སྤོང་ཞིང་མི་བྱེད་ལ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཤིང་སཱ་ལ་ཟུང་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "འདུག་ཁྲི་དེ་དག་ཀྱང་སྡུག་པར་བྱས་ཤིང་རྐང་པ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་མཛེས་པར་བྱས་པའི་འདུག་ཁྲིའི་རྐང་པ་དེ་ལ་ཉེ་བར་བརྒྱན་པ་འདི་ལྟ་སྟེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་མིག་ཕྱེ་ཞིང་འགྲོ་བ་དང་བཙུམས་ནས་འགྲོ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཁ་ཅིག་ནི་བཞོན་པ་མེད་པར་ནམ་མཁའ་ལ་འདུག་སྟེ།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ནོར་བུ་འཕྱང་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "རི་ཆེན་པོ་འགུལ་བ་ལྟ་བུར་འདུག་པའི་གླང་པོ་ཆེ་དེ་ལ་ཞོན་པ་ནི།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་རིས་འཐུན་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེ་ནས་གསར་དུ་སྐྱེས་པ་དེ་ཤིན་ཏུ་གཞོན་ལ་གཙང་གཙང་ལྟར་འདུག་པར་མཐོང་ཞིང་རྟོགས་ནས།",
    "བྱ་ཁ་དོག་དང་དབྱིབས་དང་འགྲོས་དང་གཟུགས་སྣ་ཚོགས་སུ་འདུག་པ།",
    "བྱད་གཟུགས་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པ་དག་མཐོང་ངོ།",
    "དེ་བཞིན་དུ་ལྡུམ་བུའི་ནང་ག་ལ་བ་དེ་རྣམས་འདུག་པ་དང་དེར་ཡང་བྱ་དེ་དག་འདུག་པར་བྱེད་དོ།",
    "ངོ་བོ་ཉིད་ཀྱིས་ལུས་དཀར་ཤམ་ཉིད་དུ་འདུག་པ།",
    "དེ་ནས་ལྷའི་རྒྱལ་པོ་བརྒྱ་བྱིན་ཁང་བཟངས་ཀ་བ་འབུམ་རྙེད་ཡོད་པའི་ནང་ན་རྒྱལ་བ་ཐོབ་པ་ཞེས་བྱ་བའི་སེང་གེའི་ཁྲི་ལ་འདུག་གོ།",
    "བདེ་བར་འདུག་པ་གཟི་བརྗིད་འབར་ཞིང་ལྷ་འབུམ་སྙེད་ཀྱིས་བསྐོར།",
    "མི་ཤིན་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་པ་རྣམས་ཀྱིས་དེད་པར་བྱེད་པ་ན།",
    "ལུས་དང་གཟུགས་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པའི་ལག་པ་དག་ན་རལ་གྲི་དང་དབྱུག་པ་དང་ཞགས་པ་ནི་ཐོགས།",
    "བཞིན་ཤིན་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་པ།",
    "ལུས་ཚལ་ཤིང་བསྲེགས་པ་ལྟར་འདུག་པ།",
    "དེ་ལྟར་ལྷ་དེ་རྣམས་ཀྱིས་སྤྲུལ་པ་ཤིན་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་པ།",
    "ངོ་ཚ་ཤེས་པ་ཞེས་བྱ་བ་ནི་བདག་ཉིད་དབེན་པར་འདུག་ཅིང་བདག་ཉིད་འཇིགས་པར་སེམས་པའོ།",
    "སེམས་དང་སེམས་ལས་བྱུང་བ་དེ་དག་དུས་དེ་ལ་འབྱུང་ངོ།",
    "ལྷའི་བུ་གཞན་སྟན་དེ་ལ་འདུག་པར་མི་མཐོང་སྟེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་འཁོར་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བཞིན་འཛུམ་ལ་ནོར་བུས་ལྟོ་སྔོ་བསངས་སུ་འདུག་པ།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་མཐོ་བར་སྤྱོད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
