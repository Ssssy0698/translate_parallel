    "རང་བཞིན་གྱིས་རྨོངས་པར་འདུག་པ་ཉིད་ནི་ཞུམ་པ་ཞེས་བྱ་བས་བསྟན་ཏོ།",
    "གང་དུ་འདུག་པའི་གནས་སྐྱེ་བོའི་རྒྱུན་ལུགས་མེད་པ་ཉིད་ཀྱིས་ས་ཕྱོགས་དབེན་པ་ཉིད་དང་།",
    "འདུག་པ་ལའོ་ཞེས་སྔར་སྨོས་པ་ལས་འདིར་ཁྱད་པར་ནི་དགེ་སློང་དང་དགེ་སློང་མ་གཉིས་ཀ་འགྲེང་བ་ལའོ།",
    "དགེ་སློང་དེའི་ཉེ་དུས་བརྩིག་ཏུ་བཅུག་པའི་འདུག་གནས་ཉེ་དུ་བདག་པོ་ཡིན་པ་དེར་ཞག་གཅིག་ལས་ལྷག་པར་གནས་ཤིང་བསོད་སྙོམས་གཅིག་ལས་ལྷག་པར་ཟོས་ན་ཡང་ཉེས་བྱས་སོ།",
    "སྟན་གང་ལ་འདུག་པ་དེ་ལས་ལངས་པའོ།་",
    "སྟན་གང་ལ་འདུག་པ་དེ་ལས་ལངས་པའོ།",
    "འཚེད་པར་བྱེད་པའི་གང་ཟག་དང་བཙོ་བར་བྱ་བའི་རྫས་གཉིས་ཀ་མཚམས་ནང་ན་འདུག་པ་ཁོ་ནར་མ་ཟད་དོ།",
    "བཙོ་བར་བྱ་བའི་རྫས་དེ་མཚམས་ཀྱི་ཕྱི་རོལ་ཏུ་འདུག་པ་བཙོས་ན་འཚེད་པར་བྱེད་པའི་མི་དེ་མཚམས་ཀྱི་ནང་དེ་ན་འདུག་པ་ཉིད་ཀྱིས་ནི་རྫས་དེ་མཚམས་ཀྱི་ནང་དུ་བཙོས་པར་མི་འགྱུར་རོ།",
    "དེས་ན་དགེ་སློང་རང་བཞིན་གནས་པས་བྱིན་ལེན་བྱས་པ་ནི་དགེ་སློང་བསླབ་པ་བྱིན་པས་ཟར་རུང་ལ་དགེ་སློང་རང་བཞིན་གནས་པས་གསོག་འཇོག་བྱས་པ་དང་ལག་ཉར་བླངས་པ་ནི་དགེ་སློང་བསླབ་པ་བྱིན་པས་ཀྱང་ཟར་མི་རུང་ངོ།",
    "འབྲིམ་བྱེད་ཀྱི་སྐལ་བ་མཁན་སློབ་ཀྱིས་བླངས་ན་འབྲིམ་བྱེད་ཀྱིས་མི་འཐོབ་པ་སྟེ་ཐོབ་པར་མི་རིགས་པའི་བཟང་པོ་ཐོབ་ན་འབྲིམ་པར་བྱེད་པ་པོ་དེའི་གྲལ་གར་བབས་པའི་ལྟག་འོག་དྲུང་ན་འདུག་པའི་གྲལ་ཟླ་སུ་ཡིན་པས་སོ།་",
    "བྱིན་ལེན་བྱས་པའི་ཟས་འདྲིལ་བ་ནི་རང་འདུག་པའི་གནས་ནས་སམ་སྟན་ལས་མ་འཕགས་པས་ལེན་ནུས་པ་ཉིད་ཡིན་ན་བྱིན་ལེན་མ་ཞིག་གོ།",
    "ལུང་ལས་བསོད་པ་ལ་མགྲོན་དུ་བོས་པ་ན་ངན་པ་སློང་ན་དེ་སློང་བ་ལ་ཉེས་བྱས་སུ་འགྱུར་ལ་ཟ་བ་ལ་ཡང་ཉེས་བྱས་ཉིད་དུ་འགྱུར་རོ་ཞེས་མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པའི་རྣམ་འབྱེད་ལས་གསུངས་པ་སྐབས་འདིར་བསྡུས་པའོ།",
    "ཚགས་རྟེན་སྣོད་དེ་ནི་ངོས་གཉིས་ནས་བུ་གུ་གཅིག་ལ་ལུང་ཐག་གཅིག་ཀྱང་བྱ་བུ་གུ་གཅིག་ལ་ལུང་ཐག་གཉིས་སུ་གྱེས་པ་བྱ་སྟེ་ཤིང་བུ་གསུམ་ལ་བཏགས་ན་ཡང་འདུག་ཏུ་བཏུབ་བོ།",
    "སྦྲུལ་སེལ་བ་ཇི་ལྟར་བྱ་ཞེ་ན་སེ་གོལ་གྱི་སྒྲ་ཕྱུང་སྟེ་དེའི་འོག་ཏུ་ཀྱེ་བཞིན་བཟང་ཞེས་བོས་ནས་མིག་ལམ་ན་མ་འདུག་པར་མི་རྣམས་ཀྱི་སྤྱོད་ཡུལ་དུ་མི་འགྱུར་བ་དེར་འདུག་ཅིག་ཅེས་བརྗོད་པར་བྱའོ།",
    "དབེན་པར་བརྣག་པས་འདུག་ན་ཉེས་བྱས་སུ་འགྱུར།་",
    "སུ་ལ་རུང་བ་ཞེ་ན་དགེ་སློང་རང་དང་གཅེར་བུ་དེ་ལ་དུད་པའི་ཟས་བྱིན་ནའོ།",
    "མཆུ་སྒྲང་ཤིང་བུ་ལས་བྱས་པའི་རྒྱུད་གཅིག་པར་འདུག་པའི་བྱིས་པ་དག་རྩ་བ་ཆ་བྱད་ཡིན་ནོ།",
    "དྲི་བཟང་པོ་དང་མེ་ཏོག་འཕྲེང་རྒྱུད་དེ་གཉིས་ནི་གཞི་གང་ལ་བཞག་པར་བྱ་ཞེ་ན་རང་ཉིད་འདུག་པའི་གནས་དེའི་རྩིག་པའི་ངོས་ལའོ།",
    "ཉེས་བྱས་ཏེ་འདུག་ཏུ་མི་བཏུབ་པའི་ཕྱིར་རོ།",
    "འདུག་ན་ཉེས་བྱས་སོ།",
    "ཉལ་ལམ་འདུག་ན་ཉེས་བྱས་སོ།",
    "དེའི་དམིགས་བསལ་ནི་ཁྱིམ་པའི་ཁྱིམ་གཞན་དུ་མལ་སྟན་ཆེ་མཐོ་ལས་གཞན་མེད་ན་མལ་སྟན་མཐོན་པོ་དང་མལ་སྟན་ཆེན་པོ་ལ་སྔ་མ་ཤོས་འདུག་པར་བྱའི་ཉལ་བར་མི་བྱའོ།",
    "འདུག་ན་ཉེས་བྱས་སོ།",
    "དགེ་སློང་རང་ངམ་གཞན་བསྐོས་པས་གོས་པར་བྱས་པས་སོ།",
    "ནམ་མཁའ་འམ་གྲོང་ལ་སོགས་པ་གནས་གང་ཡང་རུང་བ་ན་དགེ་སློང་མ་དེ་འདུག་པ་དེ་ལས་དགེ་སློང་ནམ་མཁའ་ལ་འདུག་པས་བླངས་ཏེ་ཟན་ནི་སོ་སོར་བཤགས་པར་བྱ་བའི་དངོས་གཞི་ཕྱེད་ཉེས་བྱས་སྐྱེད་པ་ཉིད་དོ།",
    "གལ་ཏེ་ཚིག་དེ་ཉེ་བར་གདགས་སུ་ནི་མི་རུང་བའི་ས་ཐག་དེ་ཙམ་ན་དགེ་སློང་མ་དེ་འདུག་ན་དེ་ལ་མ་བསྒོ་བར་ཟོས་ན་ཉེས་བྱས་ཀྱི་བྱེད་པ་པོའོ།",
    "སོ་སོར་བཤགས་པར་བྱ་བ་རྣམས་རྫོགས་སོ། ། ཤམ་ཐབས་ནི་མཚོན་པ་སྟེ་མཐང་གོས་ཀྱང་རྒྱ་ཅི་ནས་ཀྱང་ཟླུམ་པོར་འདུག་ཟླུམ་པོ་ཞེས་བྱ་བ་ནི་མ་མཐའི་ཁ་མཉམ་པར་འདུག་པར་འགྱུར་བ་དེ་ལྟར་བགོ་བར་བྱའོ།",
    "ལྟེ་བའི་གོང་དུ་ཤམ་ཐབས་མ་ལྟེབས་པ་སྟེ་ཏ་ལའི་ལོ་མ་ལྟར་ལྟེབས་ཤིང་འདུག་པ་མ་ཡིན་པར་རོ།",
    "སྐ་རགས་མཐོ་དམན་དུ་བཅིངས་བའི་བར་ན་ཤམ་ཐབས་ལྷུག་པོའི་ནང་ན་འབྲུའི་ཕུར་མ་སྟེ་ནས་འབྲུ་འཐུམ་པོ་བཏུམས་པ་ལྟར་འདུག་པ་བློ་ནས་ཕྱི་རོལ་གྱི་རིམ་པའི་གྲྭ་ཕུར་མ་ལྟར་འདུག་པ་མ་ཡིན་པར་རོ།",
    "ཙོག་ཙོག་པོར་འདུག་ལ་མཆོང་ཞིང་མི་འགྲོའོ།"
  ]
}