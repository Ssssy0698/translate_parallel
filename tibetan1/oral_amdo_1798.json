    "ཨེ་མཚོན་པའི་གྲུ་གསུམ་གྱི་ནང་དུ་ཝཾ་མཚོན་པའི་ཟླུམ་པོ་གཡོན་པའི་སྲིན་ལག་གིས་བྲིས་པའི་ནང་དུ་དཀྱིལ་འཁོར་གྱི་ལྷ་ཐམས་ཅད་གཟུགས་བརྙན་ལྟར་གསལ་བར་དམིགས་ཏེ།",
    "ཡུ་མོ་མི་བསྐྱོད་རྡོ་རྗེ་ལ།",
    "སྲས་དྷརྨེ་ཤྭ་རེ་ལ།",
    "གྲུབ་ཐོབ་སེ་མོ་ཆེ་ནམ་མཁའ་རྒྱལ་མཚན་ལ།",
    "དེ་ནས་གསུང་གི་དཀྱིལ་འཁོར་ལ་འདི་ལྟ་སྟེ།",
    "ཨོཾ་བཛྲ་ཙན་དྲྭ་ཡ་ན་མ་ཨོཾ་བཛྲ་སཱུནཱ་ཡཱ་ན་མ་ཨོཾ་བཛྲ་མཾ་ག་ལཱ་ཡ་ན་མ་ཨོཾ་བཛྲ་བུདྷཱ་ཡ་ན་མ་ཨོཾ་བཛྲ་བྲིཧ་སྤ་ཏྱེ་ན་མ་ཨོཾ་བཛྲ་ཤུ་ཀཱ་ཡ་ན་མ་ཨོཾ་བཛྲ་ཤ་ནེ་ཤྩ་རཱ་ཡ་ན་མ་ཨོཾ་བཛྲ་ཀེ་ཏ་བེ་ན་མ་ཨོཾ་བཛྲ་རཱ་ཧ་བེ་ན་མ་ཨོཾ་བཛྲ་ཀཱ་ལཱ་ག་ན་ཡེ་ན་མ་ཨོཾ་བཛྲ་བྷུ་བེ་ན་མ་ཨོཾ་བཛྙཱ་གསྟུ་ཡཱ་ན་མ་ཨོཾ་སརྦ་ནཀྵ་ཏྲ་བྷྱོ་ན་མ་ཨོཾ་དྭ་ད་ཤ་རཱ་སི་བྷྱོ་ན་མ་ཨོཾ་ཥོ་ཌ་ཤ་ཀ་ལཱ་བྷྱོ་ན་མ་ཨོཾ་ད་ཤ་དིག་པཱ་ལེ་བྷྱོ་ན་མ་ཨོཾ་བཛྲ་ནན་དི་ཀེ་ཤྭ་རཱ་ཡ་ན་མ་ཨོཾ་བཛྲ་མཧཱ་ཀཱ་ལ་ཡ་ན་མ་ཨོཾ་བཛྲ་གྷཎ་ཊཱ་ཀརྞྞ་ཡ་ན་མ་ཨོཾ་བཛྲ་དྷཱི་གི་ཎ་ན་མ་ཨོཾ་སརྦ་ཀྵེ་ཏྲ་བཱ་ལེ་བྷྱོ་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
    "རང་གི་ལྕེ་རྩེ་སྨིན་མཚམས་སྤྱི་གཙུག་གསུམ་དུ་ཆང་གི་ཐིག་ལེ་བྱས་ནས་བདུད་རྩི་མྱངས་པས།",
    "དེ་དག་གི་དོན་མོས་པ་ཡིད་བྱེད་ཀྱིས་ཀྱང་ལེགས་པར་དྲན་པར་བྱ་སྟེ་ཆོ་ག་འདི་ནི་ལས་དང་ཡེ་ཤེས་ཀྱི་ཕྱག་རྒྱ་གཉིས་ཀ་ལ་ཡང་ཚུལ་འདི་ཉིད་དོ།",
    "བཅུ་གཉིས་པ་བསྟོད་པ་ནི་ནང་གི་ལེའུ་ལས།",
    "མཆོག་སྦྱིན་རྡོ་རྗེ་མཆོག་ཁྱོད་འདུད།",
    "ཡང་དག་མཐར་གྱུར་ཁྱོད་ལ་འདུད།",
    "རྒྱས་དགྱེས་པ་ཁྱོད་ལ་འདུད།",
    "མེད་པ་ལས་བྱུང་ཁྱོད་ལ་འདུད།",
    "ནམ་མཁའ་ལས་བྱུང་ཁྱོད་ལ་འདུད།",
    "ཡེ་ཤེས་ལས་བྱུང་ཁྱོད་ལ་འདུད།",
    "ཐམས་ཅད་ཐམས་ཅད་ཁྱོད་ལ་འདུད།",
    "ཡེ་ཤེས་སྐུ་ཉིད་ཁྱོད་ལ་འདུད།",
    "ཤེས་དང་ཤེས་བྱ་གཅིག་གྱུར་རྒྱལ་བ་མཆོག་གི་དམ་ཚིག་ཡན་ལག་རྣམ་པབཅུ་གཉིས་ཀྱི།",
    "རྟ་ལ་སོགས་པ་སྦྱིན་པ་རྣམ་བཅུ་གང་གིས་སྦྱིན་པ་དོན་གཉེར་རྣམས་ལ་བྱིན།",
    "ཤཱཀྱ་ཐུབ་པ་གང་གི་ཤེས་རབ་དང་ནི་ཡེ་ཤེས་སྟོབས་ཀྱིས་ཡིད་ལས་བྱུང་བ་དག།",
    "རང་གི་རྡོ་རྗེ་ནས་བཀུག་རང་གི་དཔྲལ་བ་དང་ནི་རྡོ་རྗེ་གཙུག་ཏོར་ཆེན་པོར་ཁྲིད།",
    "རེག་བྱ་གཟུགས་དང་སེམས་མེད་རང་བཞིན་དང་ནི་སྐྱེས་བུ་མེད་ཅིང་འཆིང་དང་གྲོལ་དང་བྱེད་པོ་མེད།",
    "སྤྲོ་བྱེད་ནུས་པའི་ངོ་བོ་གློག་གི་མེ་དང་མཚུངས་ཤིང་ཉི་མ་བཅུ་གཉིས་དག་གི་གཟི་བརྗིད་ཅན།",
    "དམ་པ་རྣམས་ལ་ཞི་བའི་གཟུགས་ནི་རང་གིས་བྱས་པའི་ཉམས་མྱོང་མི་བཟད་རྣམས་ལ་མི་བཟད་པ།",
    "གང་གིས་ལས་གང་རབ་བྱས་རང་གི་སེམས་ལ་ཆོ་ག་བཞིན་དུ་དེ་ཡི་འབྲས་བུ་དེ་བསྐྱེད་པ།",
    "སྟེང་འོག་ཀུན་ནས་དཀར་ལྗང་སྣ་ཚོགས་ཁ་དོག་ཆེན་པོ་གཅིག་གི་གཟུགས་ཏེ་ཐུང་ངུ་རིང་པོ་དང་།",
    "ཤིན་ཏུ་རིང་པོ་ཡོན་ཏན་མེད་ཅེས་ཡོན་ཏན་དང་བཅས་བུད་མེད་སྐྱེས་པའང་སྐྱེས་པ་བུད་མེད་མིན།",
    "གང་ཞིག་ཀུན་གྱི་རྟེན་གཅིག་བྷ་ག་བཟང་མོ་མཆོག་གི་བྷ་ག་ཁྱོད་ལ་འདུད་དེ་ཁྱོད་ལ་འདུད།",
    "ཕྱག་རྒྱ་ཆེན་མོ་དེ་ལ་འདུད།",
    "རྒྱས་པ་ལ་སྤྲོ་ཞིང་ལོང་ཡོད་ན་རྒྱ་བོད་ཀྱི་མཁས་གྲུབ་རྣམས་ཀྱིས་མཛད་པའི་བསྟོད་པ་ཆེན་པོ་དག་གིས་ཇི་ལྟར་མོས་པ་ལྟར་བསྟོད་པར་བྱའོ།",
    "དཀྱིལ་འཁོར་ཐིག་གི་རྣམ་དབྱེ་བྱ།",
    "དེ་ཡི་དབུས་བཙལ་ལྷོ་བྱང་གི།",
    "གསུམ་གའི་སྒོ་ནི་རང་རང་གི།",
    "ཀ་བ་ཞེང་དུ་ཆ་ཆུང་རེ།",
    "ཕྱོགས་རེར་བཞི་བཞི་བཅུ་དྲུག་གི།",
    "ཕྱོགས་མཚམས་ལྷ་གནས་རེའུ་མིག་བརྒྱད།",
    "ཞེང་དུ་ཆ་ཆུང་གསུམ་གསུམ་མོ།",
    "ཕྱོགས་བཞི་མཚམས་བཞིའི་རེའུ་མིག་ཏུ།",
    "ཆ་ཆུང་དྲུག་དྲུག་གསུམ་འཁྱོག་པའོ།",
    "གཉིས་ཐིག་ཆ་ཆུང་གསུམ་རྩེར་རེག།",
    "དང་པོ་ངོས་ཐིག་རྩེ་མོར་རེག།",
    "ཟུར་ཐིག་བར་དུ་སོང་བའོ།",
    "གདུང་དང་མྱོས་བསྲུང་ལྷ་མོའི་གནས།",
    "བརྩེགས་མ་དང་པོའི་གདུང་གི་སྲིད།",
    "ལྷ་མོའི་གནས་གསུམ་ཆ་ཆུང་བཞིར།",
    "ཞེང་དུ་ཆ་ཆུང་རེ་རེའི་བར།",
    "བརྩེགས་མ་བར་བའི་གདུང་གི་སྲིད།",
    "ལྷ་མོའི་གནས་གསུམ་རྒྱ་དང་དཔངས།",
    "རེ་རེའང་ཆ་ཆུང་བཞི་གསུམ་ཞེང་།",
    "བརྩེགས་མ་གོང་མའི་གདུང་གི་སྲིད།",
    "ལྷ་མོའི་གནས་གསུམ་རྒྱ་དང་དཔངས།",
    "ཧར་མི་འདེགས་པའི་གདུང་གི་སྲིད།",
    "ཕྱི་མ་གསུང་གི་རྩ་ཐིག་ཡིན།",
    "གསུང་གི་མདའ་ཡབ་ཐིག་ལས་ཕྱིར།",
    "ཟླུམ་པོ་བཅུ་གཉིས་རེ་རེ་ཡང་།",
    "བཅུ་དྲུག་ཆ་རེ་ཕྱི་རོལ་དུའོ།",
    "གསུང་གི་ཚད་ལས་ཉིས་འགྱུར་དུ།",
    "རྟ་བབས་སྔར་བཞིན་ངེས་མོད་ཀྱི།",
    "གསུང་གི་རྣལ་འབྱོར་མ་ཡི་གནས།",
    "དེ་ལྟར་བློ་དམན་པ་དག་གིས་གོ་བདེ་བར་ཚིགས་སུ་བཅད་པ་ནི་ཐིག་གདབ་པའི་ངེས་པའོ།",
    "རྟ་བབས་ནང་མའི་བརྩེགས་བར་པའི་ལྷ་མོའི་གནས་དབུས་མ་ལ་འབྲི་བའི་ཚེ་དེ་ལྟར་བྱ་དགོས་པ་ཡང་འགྲེལ་ཆེན་ལས།",
    "ཀ་བ་ཟུང་དག་སོར་མོ་ཕྱེད་པ་ཕྱེད་ཙམ་བཀྱེད་ནས་རྣལ་འབྱོར་མ་རྣམས་ཀྱི་པདྨ་བྱའོ།",
    "འོན་ཀྱང་ཕྱོགས་སུ་སོང་བའི་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་གྱི་རྟ་བབས་ཀྱི་འོག་ཏུ་གནས་པ་ནི་རིམ་པ་གཉིས་པའི་མྱོས་པ་བསྲུང་བ་ལ་སོགས་པ་ཆ་ཆུང་བཞིའི་གནས་སུ་ཀ་བ་གཉིས་ཀྱི་ཆ་ཆུང་ཕྱེད་བསྣུར་ནས་བྲི་བར་བྱའོ།",
    "མྱོས་པ་བསྲུང་བ་ལ་སོགས་པ་ཆ་ཆུང་བཞིའི་གནས་སུ་ཞེས་པ་ནི་ལྷ་མོའི་གནས་ལ་དཔངས་ཆ་ཆུང་གསུམ་ཡོད་པ་དང་མྱོས་པ་བསྲུང་བ་ཆ་ཆུང་གཅིག་ཡོད་པ་བསྲེས་པས་དཔངས་ཆ་ཆུང་བཞིར་འགྱུར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "༤བརྩེགས་བར་མའི་གདུང་གི་ཚད་འཆད་པ་ན།",
    "དེ་དག་གི་མགོ་བོའི་སྟེང་དང་ཀ་བ་བཞིའི་སྟེང་དུ་འོག་གི་སྣམ་བུའི་ཕྱེད་ཀྱི་ཆས་སྣམ་བུར་འགྱུར་ཏེ།",
    "འོག་གི་སྣམ་བུ་ཞེས་པ་བརྩེགས་འོག་མའི་གདུང་ཡིན་ལ།",
    "སྐུའི་རྩ་ཐིག་ནས་རྩ་ཐིག་གི་བར་ལ་ཁྲུ་བཞི་བརྒྱ་དང་།",
    "དེ་ལྟར་ན་མ་ལ་ཡའི་སྐྱེད་མོས་ཚལ་གྱི་གཞལ་ཡས་ཁང་འདི་ལ་རྩ་ཐིག་ནས་ཤར་དུ་སྒོ་ལོགས་ཟད་མཚམས་བར་ལ་སྒོ་ཚད་གཉིས།",
    "བྲི་བྱ་ལ་དེ་ལྟར་མི་འོང་བར་རྟ་བབས་ཀྱི་བུམ་པའི་རྩེ་མོ་ཟད་མཚམས་ནས་འོང་ན།",
    "བསླང་བ་ལའང་རྟ་བབས་ས་ལ་བསྙལ་ན་གང་དུ་རྩེ་མོ་སླེབ་འོང་བའི་མཚམས་ནས་འོང་དགོས་པས།",
    "མ་ལ་ཡའི་གཞལ་ཡས་ཁང་གི་ཕྱོགས་གཅིག་གི་རྩ་ཐིག་ནས་རྡོ་རྗེ་རྭ་བའི་བར་ལ་ཆ་ཆེན་དགུ་ཡོད་པའི་ཕྱིར་ཁྲུ་ཕྱེད་དང་ལྔ་བརྒྱ་ཡོད་དགོས་པས།",
    "ཡང་ན་ཟླུམ་ཐིག་གི་ཕྱི་མཐའི་བར་འགྲོ་དགོས་ཀྱི་ཚངས་ཐིག་དང་ཟླུམ་ཐིག་མ་ཕྲད་པའི་བར་སྐབས་སུ་ཐིག་གང་གིས་ཀྱང་མ་ནོན་པའི་ས་སྟོང་སྒོ་ཚད་གཅིག་འོང་དོན་མེད་ལ།",
    "ཞེས་གསུངས་པའི་གཞུང་གསལ་ཁ་ཅན་འདི་དང་འགལ་ལོ་ཞེས་འགོག་མོད་ཀྱང་།",
    "ཧར་མི་ཕྱོགས་ཀྱི་སུམ་ཆ་སྟེང་ཡིན་པས་རྟ་བབས་ཀྱི་མཇུག་གི་ཆ་མ་ཡིན་ཀྱང་། ༉བྲིས་པའི་ཚེ་སུམ་གཉིས་ནང་དུ་དོར་ཞིང་སུམ་ཆ་ཕྱིར་ལུས་པའི་སུམ་ཆ་པོ་དེ་ནི་རྟ་བབས་ཀྱི་ཐིག་གི་མཇུག་གི་ཆ་ཡིན་པས་མཇུག་གི་ཆར་སའི་དཀྱིལ་འཁོར་ཡོད་པ་ལ་མཐར་ཡོད་ཅེས་གསུངས་ཏེ།",
    "རྟ་བབས་ཀྱི་བརྩེགས་འོག་མ་གཉིས་རྫོགས་ཤིང་གོང་མའི་ཡང་མྱོས་བསྲུང་གི་མཚམས་ནས་ཟླུམ་ཐིག་དང་པོ་སྐོར་བ་ཡིན་པས།",
    "ཐིག་སྐུད་དེས་ཟུར་ཐིག་བརྒྱབ་ན་མདའ་ཡབ་ཀྱི་རྩེར་ཐིག་གིས་མི་སླེབ་པས་ཇི་ལྟར་བྱ་སྙམ་ན།",
    "ཐིག་སྐུད་གཞན་ཞིག་གིས་གདབ་པའང་རུང་སྟེ།",
    "དེ་ནས་རང་གི་འདོད་པས་ཟུར་ཐིག་གདབ་པར་བྱ་སྟེ།",
    "ངག་འདོན་གྱི་རིམ་པ་རྣམས་ཀྱང་མཆོག་ཏུ་གསལ་ཞིང་རྒྱས་པར་བཞུགས་མོད།",
    "དཔའ་བོ་དཔའ་མོ་རྣམས་རྫོགས་ནས།",
    "རེ་རེ་ཡི་ཡང་།",
    "བྱས་ནས་མེ་ཏོག་ཐོགས་ཏེ་ཐལ་མོ་སྦྱར་ནས།",
    "བདག་དང་བདག་གིར་འཛིན་པ་སྤང་།",
    "རང་གི་སྤྱི་བོར་ཨོཾ་ལས་པདྨ་དཀར་པོ་འདབ་མ་བརྒྱད་པའི་ལྟེ་བར་རྀ་ལས་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་ཀྵདང་རྡོ་རྗེ་ལས་སྐྱེས་པའི་རྡོ་རྗེ་སེམས་དཔའ་སྔོན་པོ་སྔོ་དམར་དཀར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་པ་གསུམ་ན་རྡོ་རྗེ་གྲི་གུག་དགྲ་སྟ།",
    "གི་དམ་ཚིག་པ་དང་རོ་མཉམ་དུ་གྱུར།",
    "སླར་ཡང་ཐུགས་ཀའི་ཧཱུཾ་གི་འོད་ཟེར་གྱིས་སྤྱན་དྲངས་པའི་ཡུམ་རྣམས་ཀྱིས།",
    "རྡོ་རྗེ་སེམས་དཔའི་ཐུགས་ཀའི་ཧཱུཾ་གི་མཐར་ཡི་གེ་བརྒྱ་པས་བསྐོར་བ་ལ་དམིགས་ནས།",
    "ཅེས་ཉེར་གཅིག་རེ་བཟླས།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱི་སྡིག་སྒྲིབ་དང་དམ་ཚིག་ཉམས་ཆག་ཐམས་ཅད་དག་གོ་ཞེས་གསུངས་ནས་རང་ལ་ཐིམས་པས་རང་གི་སྒོ་གསུམ་དང་རྡོ་རྗེ་སེམས་དཔའི་སྐུ་གསུང་ཐུགས་དབྱེར་མི་ཕྱེད་པར་གྱུར།",
    "དཀྱིལ་ཆོག་གི་ཕུར་གདབ་ཀྱི་སྐབས་སུ།",
    "མེད་ན་བཟུང་བར་མོས་ལ་ཕུར་བུ་བསྐུལ་བར་བྱ་སྟེ།",
    "འོན་ཀྱང་ཕྱག་ལེན་ལ་ཕྱོགས་བཞི་དང་སྟེང་འོག་གི་ཕུར་བུ་བསྐུལ་བ་ཙམ་མཛད་དོ།",
    "བགེགས་དེ་དག་གི་སྤྱི་བོར་ཕུར་བུ་རྣམས་ཟུག་པར་གྱུར།",
    "གཡས་སྔོན་འགྲོའི་གཞི་བཅའ་བྱས་ཏེ་པུས་མོ་གཡོན་དང་རྐང་མཐིལ་གཡས་པ་ས་ལ་བཙུགས་ཏེ།",
    "ནུབ་ཀྱི་ནུབ་ཏུ་སྟེང་འོག་གི་ཕུར་བུ་གདབ་བོ།",
    "བདག་དང་སྒྲུབ་གྲོགས་རྣམས་ཀྱི་རྐང་པའི་མཐིལ་གཉིས་སུ་ཧཱུཾ་ཧཱུཾ་ལས་རྡོ་རྗེ་འབར་བ་རེ་རེ།",
    "དེ་བཞིན་དུ་གཙོ་བོའི་མདུན་དང་གཡས་དང་རྒྱབ་ན་གནས་པ་རྣམས་དང་ཡང་དེ་ཇི་ལྟ་བར་བྱས་པའི་ཁ་སྦྱོར་ཕྱོགས་རེ་རེར་བཞི་བཞི་སྟེ་བཅུ་དྲུག་བྱའོ།",
    "པུས་མོ་གཉིས་དྲང་པོར་བརྐྱངས་པའོ།",
    "རྡོ་རྗེ་རྩེ་ལྔ་པའི་ཕྱག་རྒྱས་རྐང་མཐིལ་གཉིས་ལ་རེག་སྟེ།",
    "རྐང་མཐིལ་གཉིས་སུ་ཧཱུཾ་ཧཱུཾ་ལས་རྡོ་རྗེ་རྩེ་ལྔ་པ་རེ་རེ།",
    "དེ་ནས་རལ་གྲིའི་ཕྱག་རྒྱས་རྐང་མཐིལ་གཉིས་ལ་རེག་ནས།",
    "རྐང་མཐིལ་གཉིས་སུ་ཡཾ་ཡ་ལས་བྱུང་བའི་རལ་གྲི་ནག་པོ་རེ་རེ།",
    "རྐང་པ་གཡས་པའི་རྩེ་མོ་ས་ལ་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
    "འཁོར་ལོའི་ཕྱག་རྒྱས་རྐང་མཐིལ་གཉིས་ལ་རེག་ལརྐང་མཐིལ་གཉིས་སུ་ལཾ་ལ་ལས་འཁོར་ལོ་སེར་པོ་རེ་རེ།",
    "པདྨའི་ཕྱག་རྒྱས་རྐང་མཐིལ་གཉིས་ལ་རེག་ནས།",
    "རྐང་མཐིལ་གཉིས་སུ་ཝཾ་ཝ་ལས་པདྨ་དཀར་པོ་རེ་རེ།",
