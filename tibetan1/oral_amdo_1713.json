    "ཕངས་པ་ཞིག་ལ་ད་ལྟ་མང་བོ་ཞིག་གིས་རང་གི་བདག་མོར་འགྱུར་བའི་རེ་བའང་བྱེད་ཀྱིན་མི་འདུག་ཤེས་རབ་ཀྱི་ཚོམས།",
    "ཁོང་གི་གསུང་གང་ལ་ཡང་ང་རྒྱལ་དང་སྤོབས་པས་ཁེངས་འདུག་པ་ལས་བརྩེ་བ་དེ་འདྲ་མྱོང་མི་ཐུབ།",
    "དགག་པ་དེ་དག་གིས་ཁོང་གི་ལྟ་བ་སྲོག་ཏུ་བྱས་འདུག་ལ་ཁོང་གི་ལྟ་བ་དེ་ནི་ནང་བའི་གཞི་ལམ་འབྲས་བུའི་རྣམ་གཞག་སྲོག་ཏུ་བྱས་པའི་རི་བོ་དགེ་ལུགས་པའི་ལྟ་གྲུབ་ཅིག་ཀྱང་རེད།",
    "དེ་ལ་བལྟས་ན་གཞུང་ལུགས་ཀྱིས་ཁོང་གི་སྙན་ངག་ལ་ཤུགས་རྐྱེན་ཆེ་བ་ཤེས་ཐུབ།",
    "སྤྱིར་བཏང་གི་འཚོ་བ་ཞིག་མ་ཡིན་པར་ལྟ་བ་སྲོག་ཏུ་བྱས་པའི་སྙན་ངག་ཡིན་པ་ཤེས་ཐུབ།",
    "སྒྲ་རྒྱན་དེ་རིགས་ནི་ཧོབ་ཀྱིས་བལྟས་ན་ཐ་སྙད་ཚིག་གི་རོལ་རྩེད་ཅིག་ཏུ་མཐོང་མོད།",
    "སྤྱིར་སྙན་ངག་གི་བྱ་དཀའ་བ་སྤེལ་དུས་སྙན་ངག་པ་རང་གི་རྩོམ་གཤིས་ཉམས་འགྲོ།",
    "དེ་ནི་མི་ཤེས་པ་དག་ལ་མཚོན་ན་ཁོང་གི་གསུང་ལ་ཡི་ག་མི་ཞིམ་པ་ཞིག་ཏུ་བྱས་ཡོད་ན་ཡང་མཁས་པ་དག་ལ་མཚོན་ན་དེ་ནི་ཀུ་རེ་གཏམ་གྱི་ཤགས་འགྱེད་ཅིག་ལས་མ་འདས་ཤིང་ཀུ་རེ་དེ་ལས་ཀྱང་ཁོང་གི་མཁས་པ་དག་ལ་ངོམ་དུ་རི་བའི་རྣམ་དཔྱོད་ཅིག་མངོན་འདུགསྤྱིར་ན་སྙན་ངག་པ་ཞིག་གི་རྩོམ་གཤིས་ལས་སྙན་ངག་པའི་གཤིས་ཀ་མཚོན་དཀའ་ན་ཡང་གཏན་ནས་མཚོན་མི་ཐུབ་པ་ཞིག་གཏན་ནས་མིན།",
    "དེ་བས་ཁོང་གི་སྙན་རྩོམ་ཀློག་པའི་ཚེ་ཕལ་ཆེར་ཁོང་ཉིད་ཀློག་པ་ལྟ་བུའི་ཚོར་སྣང་སྟེར།",
    "དེ་བས་ཁོང་གི་རྩོམ་གཤིས་ནི་བརྗོད་བྱ་དང་འབྲེལ་བ་མ་ཡིན་པར་རང་གཤིས་དང་བསྟུན་པའི་རྩོམ་གཤིས་རེད།",
    "གཞན་ལ་དམའ་འབེབ་དང་ཟུར་ཟ་ལ་དགྱེས་མོད་དེ་ཡང་ཁ་རི་ཁ་ཐུག་ཡིན།",
    "དེ་བས་ཟུར་ཟ་དག་ཀྱང་ཟུར་ཟ་རུ་མ་སོང་བས་དམའ་འབེབ་ཏུ་སོང་འདུག་འདི་ནི་ཁོང་གི་ཐུགས་རྒྱུད་དྲང་བོའི་ཚུལ་ལས་མ་འདས།",
    "ཁོང་གི་ཐུགས་རྒྱུད་དྲང་མོ་དེ་རྣམ་དཔྱོད་ཀྱིས་གྲུབ་ན་ཡང་།",
    "ཁྱོད་ནང་བ་ཞིག་ཡིན་ལ་ང་ཡང་ནང་བ་ཞིག་ཡིན་པའི་ཆ་ནས་ངས་ཁྱོད་ཀྱི་ཤིས་ཚིག་འདིར་དང་ལེན་བྱེད་མི་ཐུབ།་",
    "ངའི་སྐད་ཆ་འདིར་ཡ་རབས་ཀྱི་སྤྱོད་སྟངས་བྲལ་ཞིང་ཁོག་རྒྱ་ཆུང་བའི་རང་རྟགས་ཀྱང་མངོན་སྲིད་མོད།",
    "རེད་དེ།",
    "དེ་རིང་སྤྱི་ལོ་ལོའི་ཟླ་པའི་ཚེས་རེད།",
    "སྤྱིར་ན་ངས་ཉིན་འདི་ལ་དོ་སྣང་བྱས་མ་མྱོང་ལ་བྱེད་ཀྱང་མི་སྲིད་མོད།",
    "རྒན་པོ་ལྭ་བ་དམར་བོ་གྱོན་པ་ཞིག་ཀྱང་འདུག་བོད་པ་ཚོས་དགའ་སྤྲོ་ཆེན་པོས་རོལ་བཞིན་འདུག་པས་ང་ཚོས་ཅི་ཡིན་མ་ཤེས་ན་ཡང་སྤྲོ་བ་ཆེན་པོས་རོལ་བ་ཡིན་ཟེར།",
    "ངོ་མ་རི་བོང་ཅལ་འདྲོགས་རེད།",
    "རི་བོང་ཅལ་འདྲོགས་ཀྱིས་མཚོན་པ་ནི་རང་ཚུགས་མེད་པ་དེ་རེད།",
    "མཐོང་ཆུང་གི་དྲི་མ་ཙམ་ཡང་མེད་དོ།",
    "འོ་ན་ཡེ་ཤུའི་འཁྲུངས་སྐར་འདི་རྩེད་མོ་དང་འབྲེལ་ཡོད་པས་ཡིན་ནམ།",
    "འདི་ཚོ་བོད་ལ་ཤ་ཚ་ནས་ཡོང་བ་མ་རེད།",
    "བོད་ལ་བསླུ་བྲིད་བྱེད་པའི་ཆེད་དུ་ཡོང་བ་རེད།",
    "ཁོ་ཚོའི་སྒོར་མོ་དང་འཛུམ་མདངས།",
    "མཛའ་བཤེས་བཅོས་མ་དེ་དག་གིས་བོད་མིའི་དད་པ་ཉོ་བར་ཡོང་བ་རེད།",
    "མོས་བོད་ཀྱི་ནང་མ་ཁང་དག་གི་བྱ་སྤྱོད་དེ་མཐོང་དུས་སེམས་ལ་ཅི་འདྲ་ཞིག་འཆར་རམ།",
    "མོས་ཁོ་ལ་བཟུང་བའི་འབྲེལ་བ་ནི་གྲོགས་པོའི་འབྲེལ་བ་མིན་པར་ཁོ་ལ་བསླུ་བྲིད་གཏོང་བའི་ཆེད་ཡིན་པ་ད་གཟོད་ཤེས་ཟེར།",
    "དེ་ནས་བཟུང་ཁོ་དང་ཁོ་མོ་བར་གྱི་འབྲེལ་བ་དེ་མཇུག་བསྡུས་ཟེར།",
    "དེ་བས་འདི་ནས་བོད་མི་ཡོངས་ཀྱི་བསམ་གཞིག་དང་དར་སྤེལ་དུ་གཏོང་དགོས་པ་ཞིག་རེད།",
    "ངའི་སྐད་ཆ་འདི་ཐོས་རྗེས་ལ་ལ་མི་དགའ་བའང་སྲིད་མོད།",
    "རྒྱ་ནག་པ་གཅིག་ཇེ་ཉུང་དུ་བུད་སོང་།",
    "རེད་དེ།",
    "གཟུ་བོ་མིན་པའི་དཔྱད་བརྗོད་ཅིག་གི་རྗེས་སུ་དཔྱད་བརྗོད་པ་ལོང་བ་སྐོར་ཞིག་གིས་ཁུ་ཚུར་འཕྱར་ནས་དོར་ཞི་ཚང་ལ་འཆོར་གྱིན་འདུག་ངའི་དགོད་བྲོ་བ་དེ་རིམ་བཞིན་ངུ་བྲོ་བ་ཞིག་ཏུ་གྱུར།",
    "ཡིན་ནའང་ཁོང་གི་ལུང་དང་རིགས་པ་དེར་སུས་ཀྱང་གནས་ལུགས་ཀྱིས་དབྱེ་ཞིབ་བྱས་མེད་མོད།",
    "འུར་ཟིང་ངེར་འགྲོ་བ་ནི་གནས་ལུགས་ཤིག་གིས་གནས་ལུགས་ཤིག་ལ་རྒོལ་བ་དེ་རེད།",
    "དོན་ངོ་མར་ཁོང་ཚོ་སློབ་དཔོན་དོར་ཞི་ལ་ལན་འདེབས་པའི་ནུས་པ་མེད་པ་དེ་རེད།",
    "ཕངས་པ་ཞིག་ལ་འདི་དག་གི་གྲས་སུ་རྒྱ་གར་དུ་བཞུགས་པའི་ཧོར་གཙང་ཤེས་རབ་ཀྱི་ཚོམས།",
    "འཇིགས་མེད་ཀྱང་འདུས་མོད་ནང་བསྟན་གྱི་རིགས་པར་སྦྱངས་མྱོང་བ་འདིས་ཅིའི་ཕྱིར་ལུང་དང་རིགས་པ་དེར་དབྱེ་ཞིབ་བྱེད་མ་ཐུབ་པར་ཟུར་གསུམ་མ་དག་གི་རྗེས་སུ་འབྲང་བ་ཡིན་ནམ།",
