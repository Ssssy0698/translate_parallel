    "གནའ་དུས་སུ་མི་རྣམས་ཀྱིས་ངག་གི་དབྱངས་རྟ་ལ་ལག་བརྡ་སྦྱར་ཏེ་བརྡ་བྱེད་ཅིང་།",
    "ཀེ་རི་སིའི་མཁས་པ་ཏེ་མོ་ཁི་རི་ཐི་ཨུས་ཞེས་པས་སྤྱི་ལོ་སྔོན་གྱི་དུས་རབས་གསུམ་པའི་གོང་དུ།",
    "མི་རྣམས་ཀྱི་ཐོག་མར་དགའ་སྐྱོ་ཆགས་སྡང་གི་འགྱུར་བ་སྣ་ཚོགས་འདོན་ཚེ།",
    "རྗེས་སུ་རིམ་གྱིས་ངག་གི་ཆ་ཤས་རེ་ལ་དོན་རེ་གྲུབ་སྟེ་སྐད་ཆ་བྱུང་བར་སྨྲ་བ་ནི།",
    "གཞན་དུ་ན་ཀེ་རི་སིའི་མཚན་ཉིད་རིག་པའི་མཁས་པ་ས་ཏོ་ཁ་ཞེས་པས་རང་བྱུང་ཁམས་སུ་སྲོག་ཆགས་སྣ་ཚོགས་པས་སྐད་སྣ་ཚོགས་འབྱིན་པ་སོགས་ཀྱི་ལད་མོ་ཟློས་ཏེ།",
    "གཅིག་གིས་ཐོལ་བྱུང་དུ་སྐད་ཅིག་བཏོན་པའི་རྗེས་འབྲངས་ཤིང་།",
    "གོང་གི་བཞེད་སྒོ་དེ་དག་རང་རེའི་སྐད་ཆ་འདིར་སྦྱར་ན།",
    "ཡབ་ལྷ་བདག་དྲུག་གི་རྒྱུད་ལས་ཁྲི་བདུན་ཚིགས་ཀྱི་སྲས་ཤིག་གིས་བོད་རྗེ་མཛད་པས་མཚོན་ཏེ།",
    "བོད་ཀྱི་མི་རྒྱུད་བྱེ་བྲག་པ་ཞིག་གམ་ཡུལ་གྲུ་ག་གེ་མོའི་སྐད་ནི་ལྷ་ལས་བྱུང་བ་དང་གཅིག་ཕ་སྤྲེའུ་དང་མ་བྲག་སྲིན་མོའི་གདུང་རྒྱུད་ལས་བྱུང་བའི་སྤྲེའུ་རྣམས་ལ་ཕ་སྤྲེའུ་སྒོམ་གྱིས་གྲོ།",
    "ཤགས་སེ་ཤག་ཅེས་པ་ལྟ་བུའི་མིང་གི་བྱེ་བྲག་མང་པོ་བྱུང་བ་ནི།",
    "མི་ནི་ཆགས་སྡང་གི་འགྱུར་བ་གསལ་བའི་སྲོག་ཆགས་ཤིག་ཡིན་ཞིང་།",
    "ཐ་ན་སྐབས་རེར་བསྟན་བྱ་གང་ཡིན་ལག་བརྡས་སྟོན་པ་ནི།",
    "དེ་དག་གི་བར་ན་འབྲེལ་བ་ཅི་ཡོད།",
    "སྐད་ཆ་ནི་རང་གི་བྱེ་བྲག་སྨྲ་བརྗོད་དུ་མའི་མཚོན་ཐབས་ལ་བརྟེན་པའི་སྤྱི་འདུས་ཀྱི་ཕུང་པོ་ཞིག་ཡིན་ཞིང་།",
    "སྐད་ཆ་ཞེས་པ་ཞིག་གཞི་མ་གྲུབ་མོད།",
    "སྨྲ་བརྗོད་རང་ཐད་དུ་རྗོད་མཁན་རང་གི་སྐད་ཆའི་གོམས་གཤིས་དང་།",
    "སྐད་ཆའི་བརྗོད་ཐབས་སྤྱི་དང་མི་མཐུན་པའི་སྨྲ་བརྗོད་དག་ནི་བརྒྱ་ལ་མི་ཞིག་གིས་ངག་ནས་སྨྲས་པ་ཡིན་ཡང་།",
    "རང་གིས་བརྗོད་འདོད་ཀྱི་དོན་དེ་གཞན་ལ་བརྡ་རུ་སྤྲོད་མི་ཐབས་པའི་ཕྱིར་གྱིས།",
    "ཐུན་མོང་དུ་གྲུབ་པའི་མིང་ཕྲད།",
    "མཚན་གཞི་རེད་དོ།",
    "སྤྱི་སྐད་དང་ཡུལ་སྐད་གཉིས་ནི་སྐད་ཆའི་མཚོན་སྟངས་ཀྱི་རྣམ་པ་གཞན་ཞིག་རེད།",
    "སྤྱིར་སྐད་ཆ་གང་ཡིན་ཡང་ཡུལ་འཁོར་ངེས་ཅན་ཞིག་ཏུ་གནས་པའི་མི་རྣམས་ཀྱིས་ཐུན་མོང་དུ་བརྗོད་པའི་བརྡ་ཐབས་ཀྱི་མ་ལག་ཅིག་ཡིན་པས་ཡུལ་སྐད་མ་ཡིན་པ་མེད་ཀྱང་།",
    "སྒྲའི་སྦྱོར་ཚུལ་ཅི་རིགས་ཀྱི་ཆ་ན་ཐུན་མོང་གི་སྐད་ཆ་དང་མི་མཐུན་པའི་ཆ་ཡོད་པ་དེ་ལ་བྱ་ཡང་།",
    "ཡུལ་གྲུས་བཅད་པའི་ཡུལ་སྐད་གང་ཡིན་ཡང་སྐད་ཆ་ཞིག་གི་ཡུལ་སྐད་ཡིན་ན།",
    "སྐད་ཆ་ཞིག་གི་སྤྱི་སྐད་ཅེས་པའང་སྟོང་པའི་ངང་དུ་འཁོར་གྱིན་གདའ་བ།",
    "ཚིག་གི་སྦྱོར་ཐབས་སྤྱི་ལ་ཁྱད་པར་གང་ཡང་མ་མཆིས་པར་ཚིག་མཐའི་དྲི་བ་གསལ་བྱེད་ཀྱི་སྒྲ་ཙམ་ཐ་དད་དུ་སྣང་བ།",
    "ཞེས་པའི་སྤྱི་མཐུན་གྱི་བརྗོད་པ་གཅིག་གིས་མཐུན་པར་སྡུད་ཅིང་།",
    "སྒྲ་གདངས་ཀྱི་འབྱིན་སྟངས་ཕྱོགས་རེ་བའི་ཁྱད་པར་ཙམ་དུ་འཁུམས་སོ།",
    "སྐད་ཆའི་མཚོན་སྟངས་གཞན་ཞིག་ནི་ངག་ཐོག་གི་སྐད་ཆ་དང་ཡིག་ཐོག་གི་སྐད་ཆའི་ཁྱད་པར་ཡིན་ཏེ།",
    "སྤྱིར་ཡིག་ཐོག་གི་སྐད་ཆའི་སྦྱོར་བ་དམ་ཞིང་ཚིག་སྟེགས་ཉུང་བ།",
    "ངག་ཐོག་གི་སྦྱོར་བ་དང་ཁྱད་པར་སྐད་རིགས་ཀུན་ལ་ཡོད་ཀྱང་།",
    "ཡུལ་གྲུ་སོ་སོའི་མི་རྣམས་ཀྱི་ངག་གི་སྦྱོར་བའི་རྩ་བའི་སྒྲ་གདངས་ཕྱོགས་བསྡུས་བྱས་པའི་ཡི་གེའམ་ཡི་གེའི་གདངས་ལ་བརྟེན་པའི་མིག་གི་བལྟ་བྱའི་སྐད་ཆ་ནི་ཡིག་ཐོག་གི་སྐད་ཆ་དང་།",
    "མིག་གིས་བལྟ་བྱའི་ཡི་གེའི་སྦྱོར་བ་རྣམས་སྒྲ་རུ་བཀླག་ན་ངག་ཐོག་གི་སྐད་ཆར་འགྱུར་བར་མ་ཟད།",
    "རང་གིས་ཤེས་པའི་ཕ་སྐད་ཅི་ཐུབ་ཀྱིས་བུ་རྒྱུད་ལ་སྤེལ་དགོས་པ་ནི་མི་ཞིག་གིས་ཕ་མེས་ཀྱི་རྒྱུ་ནོར་སྲུང་བ་དང་།",
    "ལར་སྐྱེས་པའི་མིས་རང་གི་སྐྱེས་རྒྱུད་མ་ཤེས་ན།",
    "ནགས་ཁུང་གི་སྤྲེའུ་འདྲ།",
    "མོན་ཕྲུག་ཡལ་བོར་དང་འདྲ་ཞེས་པ་ལྟར།",
    "མི་རིགས་ཤིག་གི་སྐད་ཆ་ནི་སྐད་ཆ་དེའི་བདག་པོ་རྣམས་ཀྱིས་ལོ་ཟླ་བགྲང་ལས་འདས་པའི་ནང་ལ་ལས་རིགས་གང་བྱས་པ་དང་།",
    "དམའ་མོ་མཚོ་ལ་བརྟེན་པ་རྣམས་ཉ་སྲིན་ཟས་སུ་སྤྱོད།",
    "དཀྲོལ་བྱའི་རོལ་མོ།",
    "བཅིབ་བྱའི་ཆིབས་པ་དང་བཅས་པར་ཁྱད་པར་ཅི་ཞིག་བདོག་པ་རང་གི་ཕ་སྐད་དུ་གསལ་པོར་མངོན་ཞིང་།",
    "ཕ་སྐད་ཚིག་གཅིག་གིས།",
    "ཁྱད་པར་དུ་དེང་གི་དུས་ལ་བུ་ཕྲུག་ཁེར་སྐྱེས་མང་ཞིང་།",
    "བཞི་རུ་ན་མི་རིགས་ལ་འཆང་བའི་ལ་རྒྱ་རང་གི་ཕ་སྐད་ཀྱིས་མཚོན་པ།",
    "སྐད་ཆ་མ་གཏོགས་པར་མི་རིགས་ཤིག་གི་བསམ་བློ་དང་།",
    "ཆུ་སྲིན་མཚོ་ལ་གནས་བཞིན་དུ་རང་རང་གི་གཟི་ཉམས་སྐྱེད་ཅིང་སྟོབས་ཤུགས་སྲུང་བ་ལྟར།",
    "ལྔ་རུ་ན་རང་གི་ཕ་སྐད་ནི་རང་ལ་གོམས་པའི་ལག་ཆ་ཆེས་སྟབས་བདེ་པོ་ཡིན་པ།",
