    "གཡར་མིང་གི་འབྱུང་ཁུངས་རྒྱ་ཆེ་བར་སྣང་བ་དང་གསུམ།",
    "ཞེ་སའི་མིང་གི་སྤྱོད་སྒོ་རྒྱ་ཆེ་ཞིང་།",
    "ཚིག་གི་སྦྱོར་བ་ལ་ཆ་ཤས་རིང་པོ་སྤྲོས་པ་དང་ལྔ་ཡོད་པ་ཡིས།",
    "གསུམ་དུ་ན་མིང་གི་གྲུབ་ལུགས་བོད་ཁམས་སྤྱི་དང་མཐུན་ཞིང་།",
    "གཡར་མིང་གི་འབྱུང་ཁུངས་ཁྱབ་སྐད་ཆ་རིག་པའི་སྐོར་གྱི་དྲི་བ།",
    "བཞི་རུ་ན་བརྡ་རྙིང་པ་མང་ཞིང་ཞེ་སའི་སྦྱོར་བ་ཉུང་ལ་རོང་འབྲོག་གི་བར་ལ་གོ་བརྡ་སྤྲོད་ཁག་པོ་མེད་པ་དང་།",
    "ཡུལ་ཁམས་འདི་ནི་གནའ་ནས་དབུས་གཙང་དང་ཁད་ཐག་རིང་པོས་སྐད་གསར་བཅད་སྔ་ཕྱི་ལག་ལེན་མཐའ་འཁྱོལ་བ་བྱེད་མ་ཐུབ་པ་དང་།",
    "བོད་པ་རྣམས་ལྟོས་བཅས་ཀྱིས་ལྷན་དུ་འདུས་ཤིང་རི་ལུང་གི་འཕྲང་བརྒལ་བ་ཅུང་ཉུང་ཞིང་།",
    "མིང་གི་གྲུབ་ལུགས་སྤྱི་དང་མཚུངས་ཤིང་བརྡ་རྙིང་པ་ཅུང་མང་ལ།",
    "རོང་པའི་སྐད་ཆར་ཡུལ་ལུང་གི་ཁྱད་པར་ཆེ་བ་དང་གསུམ།",
    "གཡར་མིང་གི་འབྱུང་ཁུངས་རྒྱ་ཆུང་བ་དང་བཞི།",
    "ཡུལ་ལུང་གིས་བཅད་པའི་སྐད་ཆ་སོ་སོ་ལ་རང་རང་གི་ས་གནས་ཀྱི་གོམས་སྲོལ་དང་།",
    "ཤར་རྒྱལ་མོ་ཚ་བ་རོང་དང་།",
    "རྒྱལ་མོ་ཚ་བ་རོང་ལ་ལྕགས་ལ་དང་།",
    "ཡུལ་སྐད་བྱེ་བྲག་པའམ་གཞན་གང་ཞིག་གི་ཁོངས་སུ་སྡུད་པ་ལ་གླེང་ལུགས་འགའ་རེ་མཆིས་ཀྱང་།",
    "རྒྱལ་རོང་སྐད་དུ་ཁྱད་གཞི་བརྗོད་པའི་མིང་གི་སྔོན་ལ་དེ་དང་ད་ཞེས་པ་སྦྱོར་བ།",
    "བྱ་བ་བརྗོད་པའི་མིང་གི་གོང་ལ་ཀ་སྒྲ་སྦྱོར་བ།",
    "རྒྱལ་མོ་ཚ་བ་རོང་གི་སྐད་ཆ་ནི་བོད་ཡིག་གི་སྦྱོར་བ་ཇི་བཞིན་མགོ་འདོགས་འཕུལ་རྟེན་གྱི་ཡི་གེ་སོ་སོའི་སྒྲ་ཕྲལ་ཞིང་ཟུར་ཕྱིན་པར་འབྱིན་པའི་གནའ་བོའི་བོད་སྐད་ཀྱི་སྦྱོར་བ་མ་ཉམས་པར་ཉར་ཡོད་པའི་ཡུལ་སྐད་ཁྱད་པར་བ་ཞིག་ཡིན་པ།",
    "ཞེས་པ་སོགས་ཀྱིས་གསལ་བར་བསྟན་པའི་ཀློག་སྟངས་ཡང་དག་རྒྱལ་མོ་ཚ་བ་རོང་གི་སྐད་ན་ད་དུང་གསལ་བར་སྣང་བ་ཡིས།",
    "རྒྱལ་མོ་ཚ་བ་རོང་གི་གཙོས་པའི་ཡུལ་མཐའི་སྐད་ཆར་གཞན་སྐད་ཀྱིས་ཤན་མ་ཐེབས་པ་ནི་བོད་སྐད་ཀྱི་ཐོག་མའི་རྣམ་པ་ཡིན་པ་བཅས་གསལ་བར་བྱེད་པའོ།",
    "མིང་གི་སྦྱོར་བ་མཚུངས་པ།",
    "འགའ་ཞིག་གིས་དབུས་གཙང་སྐད་རྨང་དུ་བརྟེན་པ་དང་།",
    "རེ་འགའ་ཞིག་གིས་ཁམས་པའི་སྐད་ཆ་གཙོར་འཛིན་པ།",
    "ཡུལ་སྐད་གཅིག་ཁོ་ན་གཞིར་བྱས་ན་བོད་སྐད་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་སྦྱོར་བ་ཡོངས་སུ་རྫོགས་པ་གཅིག་ཀྱང་མི་འདུག་ཅིང་།",
    "བོད་པ་རྒན་དར་གཞོན་པ་སུ་དང་གང་གིས་ཀྱང་སྐད་ཆ་རིག་པའི་སྐོར་གྱི་དྲི་བ།",
    "རང་གི་ཡུལ་སྐད་ཀྱི་ཐུན་མོང་མ་ཡིན་པའི་མིང་གི་སྦྱོར་བ་དང་ཚིག་གི་སྦྱོར་སྟངས་དོར་ཞིང་།",
    "ཀུན་ལ་གོམས་ཤིང་སྤྱི་ལ་གྲགས་པའི་ཐུན་མོང་གི་སྦྱོར་ལུགས་ལྷུར་ལེན་པ་དང་།",
    "དབྱངས་ཡིག་གི་སྒྲ་གདངས་དབུས་གཙང་གི་སྐད་ལྟར་ཞེས་པར་འབྱིན་པ་དང་།",
    "གསལ་བྱེད་སུམ་ཅུ་རང་རང་གི་སྐྱེ་གནས་དང་མཐུན་པར་སྒྲ་རྩོལ་དྲག་ཞན་གྱི་ཁྱད་པར་ལྟར།",
    "རྒྱལ་མོ་ཚ་བ་རོང་སོགས་ཡུལ་སྐད་དག་པ་ཞིག་གཞིར་བརྟེན་ཏེ་གཅིག་སྡུད་བྱེད་པ་དང་།",
    "མིང་གི་ཐད་དུ་སྔར་བཀས་བཅད་རིམ་པ་སྔ་ཕྱི་མཛད་པའི་གཏན་སྲོལ་ཡོངས་སུ་བརྩི་བའི་ཁར།",
    "གསར་བྱུང་གི་ཐ་སྙད་རྣམས་འཕྲལ་འཕྲལ་དུ་གཅིག་གྱུར་བཟོ་ཞིང་།",
    "ཡིག་ཐོག་གི་ཐ་སྙད་རྣམས་བཀོལ་སྤྱོད་ཡག་པོ་བྱེད་པ་དང་།",
    "ཡུལ་གྲུ་སོ་སོར་ཐུན་མོང་དུ་གྲུབ་པ་དང་།",
    "བོད་པ་སྤྱིས་གོ་བའི་སྐད་ཆ་ཞིག་ད་ལྟ་ངང་གིས་འཆག་གིན་ཡོད་པས་བསམ་པའི་དཔང་བསྐྱེད་དེ།",
    "ཡུལ་ཁམས་བྱེ་བྲག་པ་གཅིག་གི་མི་དག་ལ་ཡུལ་སྐད་དེའི་སྒོ་ནས་ལབ་གླེང་བྱེད་པ་དང་།",
    "དབུས་གཙང་གི་སྐད་ཀྱིས་བོད་སྐད་འཕེལ་འགྱུར་གྱི་གནས་སྟངས་གསར་པ་མཚོན་པ་དང་།",
    "ལྷག་པར་འབྲོག་པའི་སྐད་ལ་རོང་སྐད་ལྟ་བུའི་ཡུལ་ལུང་གི་སྐད་ཆའི་ཁྱད་པར་ཆེན་པོ་མེད་ལ།",
    "ཡུལ་སྐད་གཅིག་གི་སྐད་ཆ་རིག་པའི་སྐོར་གྱི་དྲི་བ།",
    "ཡུལ་གང་དུ་ཕྱུགས་ཟོག་འཚོ་སྐྱོང་གི་འབྲོག་པའི་ལས་ཀ་བྱེད་པ་ཡིན་ན།",
    "ཀླུང་སྡོད་བོད་པའི་སྐད་ལ་རིམ་གྱིས་འགྱུར་བ་ཇེ་ཆེར་སོང་བ་རྗེས་སུ་དཔག་གོ།",
    "སྐད་ཆའི་ཡུལ་དུས་ཀྱིས་བསྐལ་པའི་སྐྱོན་བཟློག་ཕྱིར་རང་ཡུལ་དུ་གསར་བསྐྲུན་དང་གཞན་ཡུལ་ནས་གཡར་སྤྱོད་གང་རུང་གི་ཐབས་ཀྱིས་སྐད་ཆ་ཟིན་འགོད་བྱེད་པའི་ཡི་གེ་རྗེས་སུ་བྱས་པའི་ལུགས་ཤིག་བཅས་ཡོད་པ་ལས།",
    "མཚོན་བྱའི་སྐད་ཆ་རང་སྟེང་གི་འཕེལ་འགྱུར་དང་།",
    "ད་ལྟའི་དུས་སུ་བོད་ཡིག་གི་སྦྱོར་བ་དང་ཁ་སྐད་ཀྱི་བར་ལ་ཁྱད་པར་ཅུང་བྱུང་བ་ནི།",
    "ཡི་གེའི་སྦྱོར་བ་ཁ་སྐད་དང་ཇི་བཞིན་བསྟུན་ཆོག་ལ་བསྟུན་ཡང་ཐུབ་མོད་དེ་བཞིན་མ་བྱས་པས་ཡི་གེའི་སྦྱོར་བར་བཀོད་པའི་སྐད་ཆ་དང་།",
    "གཅིག་ཏུ་ན་ཡིག་ཐོག་ཏུ་དགོལ་བྱའི་མིང་གི་སྦྱོར་བ་ཕུན་སུམ་ཚོགས་ཀྱང་དམངས་བྱིངས་ཀྱི་ཁ་སྐད་དུ་མིང་བརྡ་གྱ་ནོམ་པ་མ་མཆིས་པ།",
    "ངག་ཐོག་ཏུ་རང་རང་གི་ཡུལ་སྐད་ལྟར་སྦྱོར་བ་སྣ་ཚོགས་སུ་སྤེལ་བ།",
    "ཁོང་ཚོ་ནང་ལ་ཕེབས་ཀྱི་རེད་ལྷ་སའི་སྐད་དང་།",
    "ལྔ་རུ་ན་ཡིག་ཐོག་གི་སྐད་ཆ་རང་བཞིན་གྱིས་ཚགས་དམ་ཡང་།",
    "ངག་ཐོག་གི་སྦྱོར་བ་རང་བཞིནགྱིས་ཚགས་ལྷོད་པས།",
    "དབྱངས་གསལ་དང་དེ་དག་གི་སྦྱོར་བ་ལས་བྱུང་བའི་ཡི་གེ་དག་གི་སྐད་གདངས་གང་དག་པ་དེ་ལྟར་བརྗོད་པས་གཞི་བྱས།",
    "ངག་ཐོག་དང་ཡིག་ཐོག་གི་སྒྲ་གདངས་གཅིག་གྱུར་ཡོང་བར་བརྩོན་པ་དང་གསུམ།",
    "བོད་མི་ཐུན་མོང་གིས་གོ་བའི་སྤྱི་སྐད་ཅིག་འཆག་པ་བཅས་ཐབས་ལྔ་ཡི་སྒོ་ནས་ཁ་སྐད་ཀྱིས་ཡིག་སྐད་ལ་བསྟུན་པ་དང་།",
    "སློབ་དཔོན་དོར་ཞི་མཆོག་གིས་ཀྱང་།",
    "རི་མོས་དོན་གང་མི་བརྗེད་རྟགས་བཏབ་ཕྱིར།",
    "དང་ཐོག་སྐད་དང་རི་མོར་འབྲེལ་བ་མེད།",
    "རི་མོ་གང་ཞིག་ཆ་ཤས་འགར་བསིལ་ཏེ།",
    "གནའ་མིས་རང་གི་མྱོང་བ་ཡི་གེར་བཀོད།",
    "རི་མོ་ཡུལ་ལྟར་བྲིས་པ་ཡི་གེ་དང་།",
    "དོན་མང་མཚོན་པའི་ཇུ་ཐིག་མོ་ཐབས་ཀྱི།",
    "བོད་ཡིག་ཕྱི་མོར་ནཱ་ག་ཁ་ཆེ་དང་།",
    "གཟུགས་ཀྱི་ཕྱི་མོར་བལྟས་ཕྱིར་འགལ་བ་མེད།",
    "ཡི་གེའི་འབྲུ་ཡི་བཀླག་ཚུལ་རེ་རེ་བཞིན།",
    "རྗེས་འཇུག་མེད་པའི་མིང་གི་སྦྱོར་བ་མེད།",
    "དོན་ལྡན་མིག་གི་དགའ་སྟོན་ཉིད་དུ་སྣང་།",
    "བྲིས་མཁན་མཁས་པའི་ཕྱག་གི་ལྟད་མོ་ཆེ།",
    "བྱཉྫ་ན་ནི་གསལ་བྱེད་ཅེས་པ་སྟེ་ཡི་གེ་ལ་བརྟེན་ནས་མིང་ཚིག་གི་བརྗོད་པ་གསལ་བར་བྱེད་པས་ན་དེ་སྐད་ཅེས་བྱ་ཞིང་།",
    "འདིའི་གསལ་བྱེད་ཅེས་པའང་ཀ་ཕྲེང་གི་གསལ་བྱེད་གཅིག་པུར་ངོས་འཛིན་མི་རུང་ངོ།",
    "ཡི་གེ་ལ་བརྟེན་ནས་ཤེས་བྱ་ཡོད་དགུའི་མིང་ཚིག་གི་དོན་མཐའ་དག་ངག་ཏུ་རྗོད་པར་བྱེད་པས་ན་དེ་སྐད་ཅེས་བྱའོ།",
    "ཆ་ཤས་རེ་རེར་བསྟན་བྱ་ངེས་ཅན་རེ་མེད་པས་འདོད་རྒྱལ་ལྟར་བཏགས་པའི་མིང་ཞིག་ཡིན་མཆིའོ།",
    "ཡི་གེ་རེ་རེ་བས་དོན་གང་ཡང་མི་སྟོན་པར་དབྱངས་གསལ་གྱི་ཡི་གེ་དུ་མ་ལྷན་དུ་འདུས་ན་ད་གཟོད་དོན་ཞིག་ལ་གཞོལ་བས།",
    "རང་རེའི་བོད་པའི་ཡི་གེ་འདི་ནི།",
    "ཡི་གེའི་འབྲུ་ནི་རེ་རེ་བཞིན།",
    "ཞེས་པ་བཞིན་ཡི་གེ་རེ་རེའི་སྒྲ་གདངས་ཀྱི་འབྱིན་ལུགས་ལྟར་ཡི་གེའི་གཟུགས་རིས་བཟོས་སྟབས།",
    "ཡི་གེའི་ངེས་ཚིག་སོ་སོ་བ་ལ་མཚོན་བྱ་ཐ་དད་པ་རེ་ཡོད་ན།",
    "ངེས་ཚིག་གཅིག་གིས་ཡིག་རིགས་ཀུན་ལ་ཁྱབ་པ་ཤིན་ཏུ་དཀའ་ཡང་།",
    "སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་ཞེས་པ་ནི་ཇི་འདྲ་ཞིག་ལ་གོ་བ་དང་།",
    "དེ་དང་སྐད་ཆའི་བར་གྱི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "བརྡ་རྟགས་བཅས་ལ་རི་མོ་ལས་ལྷག་པའི་དོན་མཚོན་གྱི་ནུས་པ་ཆེ་བས་ཡི་གེའི་ཁྱབ་ཁོངས་སུ་སྡུད་པ་ནི་སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་རིག་པའི་བཞེད་ལུགས་རེད་ལ།",
    "སྲིད་པ་ཆགས་པའི་དུས་སྐབས་ཀྱི་སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་ཡིན་ན།",
    "དོན་ལྡན་གྱི་རི་མོ་གང་ཞིག་རིམ་གྱིས་འཕེལ་ཏེ་སྐད་ཆ་དང་ལྟོས་གྲུབ་ཀྱི་འབྲེལ་བ་གྲུབ་ཅིང་།",
    "ཡི་གེ་འགའ་ཞིག་གིས་སྐད་ཆའི་ཆ་ཤས་ལས་དོན་ལྡན་གྱི་མིང་དག་མཚོན་ཐུབ་ཀྱང་དོན་མེད་ཀྱི་ཚིག་ཕྲད་དག་མཚོན་མི་ཐུབ་ལ།",
    "ཡི་གེ་རེ་འགས་མིང་དང་ཚིག་ཕྲད་ཀྱི་སྒྲིག་རིམ་ལྟར་སྐད་ཆའི་ཆ་ཤས་དག་ཆད་ལྷག་མེད་པར་ཟིན་འགོད་བྱེད་ཐུབ་པ་ལ་ད་གཟོད་ཡི་གེ་རྣལ་མའམ་ཡི་གེ་ཆ་ཚང་བ་ཟེར་བའི་ཕྱིར་གྱིས།",
    "ཁམ་རིས་གཏན་ཆགས་པའི་རི་མོ་དག་སྐད་ཆའི་གྲུབ་ཆ་གང་ཞིག་དང་ལྟོས་གྲུབ་ཀྱི་འབྲེལ་བ་གཏན་ཆགས་སུ་གྱུར་ཅིང་།",
    "སྐད་ཆའི་སྦྱོར་བ་དག་གི་སྒྲིག་རིམ་དང་བསྟན་དོན་དག་དང་ཇི་བཞིན་མཚུངས་པར་གྱུར་ན།",
    "སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་དང་སྐད་ཆའི་སྦྱོར་བའི་བར་ལ་ད་དུང་ལྟོས་གྲུབ་ཀྱི་འབྲེལ་བ་གྲུབ་མེད་ལ།",
    "ཡི་གེ་དང་སྐད་ཆའི་བར་ལ་འབྲེལ་བ་གྲུབ་པ་ནི་སྒྲ་དོག་འཇུག་གི་ཡི་གེ་རེད་དོ།",
    "དེ་དང་སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་དག་གི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "སྤྱིར་བྲིས་རིས་སྣ་ཚོགས་པ་ནི་སྐད་ཆ་དང་འབྲེལ་མེད་དུ་སྤྱོད་བཞིན་པ་ལས་ནམ་ཞིག་དེ་དག་གི་འབྲི་ལུགས་གཏན་ཆགས་ཤིང་བསྐྱར་དུ་བཀོལ་ཀྱང་བསྟན་དོན་འགྱུར་བ་མེད་པར་སྐད་ཆའི་ཆ་ཤས་དག་དང་ལྟོས་གྲུབ་ཀྱི་འབྲེལ་བ་གྲུབ་པ་ནི་ཡི་གེ་རྣལ་མ་ཡིན་པས།",
    "སྐད་ཆའི་རྗེས་སུ་བྱུང་ཞིང་སྐད་ཆ་ཉར་འཇོག་བྱེད་པའི་དོན་མཚོན་ནམ་སྒྲ་མཚོན་གྱི་བྲིས་རིས་ཀྱི་བརྡ་རྟགས་ཤིག་ལ་སྒྲ་དོག་འཇུག་གི་ཡི་གེ་ཞེས་བརྗོད་པས།",
    "བྲིས་རིས་ཀྱི་ནང་དུ་སྐད་ཆ་དང་འབྲེལ་བ་གང་ཡང་མེད་པའི་སྒྱུ་རྩལ་གྱི་རི་མོ་དང་།",
    "སྒྲ་དོག་འཇུག་གི་ཡི་གེ་ངོ་མ་ནི་སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་རུ་འདུ་ཡང་།",
    "སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་ནི་སྤྱི་དང་ཁྱབ་བྱེད་ཡིན་པ་དང་།",
    "སྒྲ་དོག་འཇུག་གི་ཡི་གེ་ནི་བྱེ་བྲག་དང་ཁྱབ་བྱ་ཡིན་ཕྱིར།",
    "འཇིག་རྟེན་འདིར་མི་རིགས་སོ་སོས་རང་སར་སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་མང་པོ་བཟོས་སུ་ཟིན་ཀྱང་།",
    "དེ་དག་ལས་ཉུང་ཤས་ཤིག་གིས་སྐད་ཆའི་ཆ་ཤས་དག་ཆད་ལྷག་མེད་པར་ཟིན་འགོད་བྱ་ཐུབ་ཕྱིར།",
    "རི་མོ།",
    "བྲིས་རིས་སོགས་ནི་ཕན་ཚུན་འབྲེལ་བ་མེད་པའི་བརྡ་རྟགས་ཐོར་རེ་བར་སྣང་ཞིང་།",
    "མི་རིགས་མང་པོ་ཞིག་གིས་ཅུང་ཟད་འཐུས་ཚང་དུ་གྲུབ་པའི་ཡི་གེ་ཞིག་ཡུལ་གཞན་དག་ནས་གཡར་སྤྱོད་བྱས་ཏེ།",
    "སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་ཡོད་པའི་མི་རིགས་དག་ལ་རང་གི་སྐད་ཆ་ཡོད་ཀྱང་།",
    "ཡི་གེ་རྣལ་མའི་འབྱུང་རྐྱེན་གཙོ་བོ་གང་དག་རེད།",
    "འཇིག་རྟེན་དུ་བྱུང་བའི་ཡི་གེ་དག་གི་ཐུན་མོང་གི་འབྱུང་རྐྱེན་ཕྱོགས་གཅིག་ཏུ་དྲིལ་ན་གཙོ་ཆེ་བ་གསུམ་སྟེ།",
    "རྒྱ་ཡིག་གི་སྐོགས་རུས་ཡི་གེའི་ནང་དོན་ལས་གཙོ་ཆེ་བ་མོ་ལྟས་ཡིན་པ་དང་།",
    "གནའ་བོའི་ཨེ་ཇིབ་ཀྱི་ཆུ་བོ་ནལ་ལེའི་བཞུར་རྒྱུན་དུ་བྱུང་བའི་ལྷ་རིས་ཡི་གེ་ཡང་བཙུན་པ་དག་གིས་མཆོད་རྫས་སོགས་ཀྱི་སྟེང་ལ་དངོས་པོའི་འདྲ་གཟུགས་ཇི་བཞིན་བྲིས་པ་ལས་རིམ་གྱིས་འཕེལ་པས་མཚོན་ཏེ།",
    "ཡི་གེའང་ཡུལ་དེ་ནས་མཆེད་ཅིང་འཕེལ་པ་རེད་དོ།",
    "སྤྱི་ལོའི་མགོ་མ་ཚུགས་པའི་གོང་གི་ལོ་ནས་བར་ལ་མེ་སོ་བྷོ་ད་མའེ་ཡའི་ཕྱོགས་ཀྱི་སུ་མེར་བ་རྣམས་ཀྱིས་གཟེར་དབྱིབས་ཡི་གེ་བཀོལ་སྤྱོད་བྱས་པའི་ནང་དོན་གྱི་ལྷག་ནི་ཚོང་འགྲུལ་གྱི་ཟིན་ཐོ་ཡིན་པ་དང་།",
    "ལྷག་པར་སྤྱི་ལོ་སྔོན་གྱི་ལོ་ཙམ་གྱི་སྐབས་ལ་ཧྥི་ཉེ་ཅིའི་མི་རྣམས་ཀྱིས་དང་ཐོག་ཚོང་ཟོང་གི་དབྱེ་བ་དགར་བྱེད་དུ་བཀོལ་པའི་ཡི་གེ་དག་ལས་འཛམ་བུ་གླིང་གི་སྒྲ་སྦྱོར་གྱི་ཡིག་རིགས་མཐའ་དག་མ་གཅིག་ལས་མཆེད་པའི་བུ་རབས་ཚ་རྒྱུད་ལྟར།",
    "སྤྱི་ལོ་སྔོན་གྱི་ལོ་ཙམ་ལ་ཆིན་གྱི་རྒྱལ་པོ་ཐོག་མས་སྐབས་དེའི་ཡི་གེ་འབྲི་ལུགས་གཅིག་གྱུར་བྱས་པས་རྒྱ་ཡིག་གི་མ་ལག་འཐུས་ཚང་དུ་གྱུར་པ་དང་།",
    "ཡི་གེ་དག་གི་འབྱུང་ཁུངས་ཇི་འདྲ་རེད།",
    "གནའ་བོའི་མི་རིགས་གང་གིས་ཀྱང་མི་བརྗེད་པའི་ཐོ་འགོད་པ་དང་།",
    "རང་གི་སེམས་འདུན་མཚོན་པ་ཅི་རིགས་ཀྱི་སླད་དུ་རི་མོའི་རྣམ་པའི་བརྡ་རྟགས་ཐོར་རེ་བ་སྣ་ཚོགས་བྱས་པ་སྐད་ཆ་དང་འབྲེལ་བར་བཟོ་ཐབས་མེད་ཅིང་།",
    "ལྷ་རིས་ཡི་གེམ་ཡའི་ཡི་གེརྒྱའི་ཡི་གེའཇང་གི་ཡི་གེ་བཅས་ཉུང་ཤས་ཤིག་ལས་མེད་པ་དང་།",
    "ཚོང་ཟོང་གི་རྟགས་སུ་བཀོལ་པའི་ཡི་གེ་དག་ཐོག་མར་ཀེ་རི་སིའི་ཡུལ་ལ་དར་ཅིང་།",
    "ལ་ཏིང་གི་ཡི་གེ་བྱུང་སྟེ།",
    "ཡི་གེ་ཞིག་མི་རིགས་རང་གིས་གསར་དུ་བཟོ་བ་ལ་བལྟས་པས་གཞན་ཡུལ་ནས་གཡར་ཞུ་བྱེད་པ་ལས་སླ་ཞིང་།",
    "རྒྱ་གར་གྱི་ཡི་གེ་དང་སྒྲ་མཚན་ཡི་གེ་གཞན་དག་གི་ཤན་ཞུགས་ལས།",
    "མི་རིགས་དང་རྒྱལ་མཚེས་འགའ་རེས་རྒྱ་ཡིག་སྟབས་བདེར་གཏོང་བའམ་རྒྱ་ཡིག་གི་ཁམ་རིས་སྤྱད་དེ།",
    "རྒྱ་ཡིག་གི་རྣམ་པ་ཅན་གྱི་དབྱངས་གསལ་གྱི་ཡི་གེ་གསར་དུ་བཟོས་ཏེ།",
    "རྒྱ་ཡིག་ལ་བརྟེན་པའི་ཁོ་རེ་ཡའི་ཡི་གེ་དང་།",
    "མི་རིགས་ཀུན་ལ་ཐུན་མོང་དུ་གྲུབ་པས།",
    "བརྒྱ་ལ་ཡི་གེ་ཡོད་པའི་མི་རིགས་དག་གིས་ཀྱང་ཐ་སྙད་གཡར་སྤྱོད་དང་།",
    "གཡར་མིང་དག་གི་སྒྲ་ཟུར་ཅུང་ཟད་སྒྱུར་གྱིན་སྒྱུར་གྱིན་སྤྱོད་པའི་ཐོག་མི་རིགས་གང་ལ་ཡི་གེ་ཞིག་སྔར་མེད་ན་གང་ཞིག་གཡར་བྱའི་ཡི་གེ་དེ་ལ་དཔེར་བལྟས་ཀྱང་ཡི་གེ་དེ་དང་ཁྱད་པར་འབྱེད་ཕྱིར་དུ།",
    "སི་མོ་ནི་ཏེ་སི་རྣམ་ཡི་གེ་རིག་པའི་སྐོར་གྱི་དྲི་བ།",
    "འཇང་ཡིག་ལྟ་བུ་ནི་མི་རེ་འགའི་མཛད་རྗེས་སུ་བགྲང་དཀའ་ཡང་།",
    "གནའ་བོའི་ཧྥི་ཉེ་ཅིའི་གསལ་བྱེད་རྐྱང་པའི་ཡི་གེ་བཅུ་དྲུག་གི་སྟེང་དུ་ཀེ་རི་སིའི་ཕ་ལ་མེ་ཏེ་སི་དང་སི་མོ་ནི་ཏེ་སི་རྣམ་གཉིས་ཀྱིས་ཡི་གེ་བརྒྱད་སྔ་ཕྱིར་བསྣན་ཏེ།",
    "སྒྲ་རེ་ཡི་གེ་རེའི་མིང་དུ་བཏགས་པའི་ཀེ་རི་སིའི་ཡི་གེ་གསར་དུ་བསྐྲུན་པ་དང་།",
    "བློ་གྲོས་དང་ལྡན་པའི་མཁས་པ་རེ་འགའི་མཛད་འཕྲིན་དུ་ངེས་པས།",
    "ཡི་གེ་ཞིག་སྐད་ཆ་གང་རུང་ཞིག་གི་མཚོན་རྟགས་སུ་འགྱུར་བ་ལ་ཆ་རྐྱེན་གང་དག་ཚང་དགོས།",
    "དོན་དང་ལྡན་པའི་ངག་གི་སྦྱོར་བ་གང་ཞིག་མིའི་ཚོགས་པ་ཞིག་གི་ཐུན་མོང་གི་བསམ་བློ་རྗེ་བྱེད་ཀྱི་བརྡ་ཐབས་གཏན་ཆགས་པ་ཞིག་ཏུ་གྱུར་པ་ནི་ད་གཟོད་སྐད་ཆ་ཡིན་པས།",
    "རི་མོ་དེ་ནི་བྲིས་རིས་རང་ག་བ་ཞིག་མ་ཡིན་པར་སྐད་ཆ་ཞིག་གི་མཚོན་རྟགས་བྱེད་པའི་ཆ་རྐྱེན་འཛོམས་པ་ཡིན་ཡང་།",
    "མི་རིགས་གང་ཞིག་གི་བསམ་བློ་གཏོང་སྟངས་ནི་ཡུལ་གྱི་རིམ་པར་ལྟོས་ཤིང་སྐད་ཆའི་སྒྲ་རྒྱུའི་ཆ་ལ་དང་དོད་མི་བྱེད་པར་གཙོ་བོ་རྡོག་པོ་རིལ་འཛིན་གྱི་སྒོ་ནས་དོན་ལ་གཞོལ་བ་རྒྱ་སྐད་ལྟ་བུ་ལ་ཡི་གེའང་ཆ་ཤས་ཅི་ཙམ་འདུས་ཀྱང་སྒྲ་རེ་རེའི་མཚོན་བྱེད་མ་ཡིན་པར་རྗོད་བྱེད་རིལ་པོ་གཅིག་ཏུ་བྱེད་པ་འདྲ་གཟུགས་སམ་དོན་མཚོན་གྱི་ཡི་གེ་ལ་བྱེད་པ་དང་།",
    "ད་ལྟར་ཤེས་པའི་འཛམ་གླིང་གི་ཡི་གེ་ཆེས་སྔ་ཤོས་ནི་གང་རེད།",
    "དེའི་ད་ལྟའི་གནས་སྟངས་ག་འདྲ་རེད།",
    "ཨ་སུར་རྒྱལ་རབས་དག་གི་དུས་སྐབས་ཀྱི་སྐད་ཆ་ཟིན་འགོད་བྱས་ཤིང་།",
    "ཏ་ཟིག་གི་སྐད།",
    "ཡིག་འབྲུ་འདུས་མའི་རིགས་ནི་དོན་མྱོང་དང་སྒྲ་གཟུགས་ཡི་གེ་ལས་འཕེལ་པ་རེད་ལ།",
    "ཡིག་རིགས་འདི་ནི་ཆེས་ཐོག་མར་རི་མོའི་རྣམ་པ་ཅན་གྱི་ཡི་གེ་ཞིག་ཡིན་པ།",
    "འདམ་བུ་ལས་བྱས་པའི་སྨྱུ་གུས་འཇིམ་པ་ལེབ་མོའི་ངོས་ལ་མནན་པའི་ཚུལ་དུ་བྲིས་པས།",
    "གཟེར་དབྱིབས་ཡི་གེ་ཏ་ཟིག་གི་ཡུལ་ལ་དར་རྗེས།",
    "ཏ་ཟིག་གི་སྒྲ་སྦྱོར་ཡི་གེ་འདི་རིམ་གྱིས་ཨ་ལ་མའི་ཡི་གེས་བདས་ཏེ་སྤྱོད་སྒོ་ཉམས་པར་གྱུར་པས་མཚོན་ཏེ།",
    "རྒྱ་ཡིག་གི་བཟོ་ལུགས་ལ་ཇི་ལྟར་དཔྱད།",
    "འཇིག་རྟེན་འདིར་བློའི་ཡུལ་དུ་བྱ་རུང་བའི་ཤེས་བྱའི་རྣམ་གྲངས་མཐའ་ཡས་པ་རྣམས་མིག་གི་ཡུལ་དུ་བསྟན་ཐབས་བྲལ་ཞིང་།",
    "ཤེས་བྱའི་བྱེ་བྲག་རེ་ལ་ཡི་གེའི་གཟུགས་རེ་བྱེད་པ་ནམ་ཡང་མི་སྲིད་པའི་ཁར།",
    "སྐད་ཆ་ཞིག་ལ་ཡི་གེ་ཞིག་བྱེད་པའི་མཐར་ཐུག་གི་དགོས་པ་ནི།",
    "ཡི་གེ་རེ་རེ་ངོས་ཟིན་པ་ཙམ་གྱིས་མི་ཆོག་པར།",
    "ཡི་གེ་གཅིག་གི་ཆ་ཤས་ཤིག་ནི་དོན་གྱི་མཚོན་བྱེད་དང་།",
    "བརྗོད་དོན་རེ་ལ་གང་འདོད་དུ་སྒྲ་རེ་མིང་དུ་བྱེད་པའི་ལས་ཀའི་མཇུག་དྲིལ་བ་ལྟར།",
    "བརྗོད་དོན་རེ་ལ་འདྲ་གཟུགས་དང་།",
    "དོན་མྱོང་གི་ཡི་གེ་རེ་བཟོ་བའི་ཡི་གེ་རྣམ་གྲངས་གང་འདོད་དུ་སྤེལ་པའི་ལས་ཀ་མཇུག་རྫོགས་པར་བྱས་པ་ཙམ་དུ་མ་ཟད།",
    "ཡི་གེ་དེ་ཉིད་ཀྱི་མ་ལག་ཆ་ཚང་ཞིང་ནུས་པ་ཆེར་བསྐྱེད་པའི་ལས་ཀ་བླ་ན་མེད་པ་ཞིག་རེད་དོ།",
    "འཇང་གི་ཡི་གེ་རུ་རིམ་པ་བཞིན་དང་།",
    "ལྟ་བུའི་ཡི་གེ་དག་གི་ཆ་ཤས་འགྲོན་བུའི་མཚོན་བྱེད་ལ་བྱེད་པ་ནི།",
    "གནའ་བོའི་དུས་ཤིག་ལ་འགྲོན་བུ་ཚོང་ཟོང་བརྗེ་རེས་ཀྱི་དངུལ་ལོར་ལྟ་བུར་སྤྱད་པའི་མངོན་རྟགས་ཡིན་པའི་ཐོག་ཏུ།",
    "࿉རིམ་གྱིས་ལག་མི་བདེ་བ་དག་གིས་བྲིས་པའོ།",
    "བོད་ཡིག་གི་སྦྱོར་ལུགས་ལྟར་ཡི་གེ་དག་ལ་ཕོ་དང་།",
    "ཕོ་མོའི་ལས་སྒོ་དང་བསྟུན་པ་སོགས་ཀྱིས་མཚོན་ཏེ།",
    "ད་ལྟར་ཉར་འདུག་པའི་གནའ་བོའི་ཡི་གེ་དག་གི་བྲིས་དཔེ་ལ་བལྟས་ན།",
    "སྤྱི་ལོ་མ་ཚུགས་པའི་གོང་གི་ལོ་གོང་རོལ་གྱི་མེ་སོ་བྷོ་ད་མའེ་ཡ་ཞེས་པའི་ཡུལ་དུ་སུ་མེར་བ་རྣམས་ཀྱིས་གསར་དུ་བྱས་པའི་གཟེར་དབྱིབས་ཡི་གེ་ནི་འཛམ་གླིང་ཡི་གེ་ཀུན་གྱི་སྔ་ཤོས་ཡིན་ཞིང་།",
    "གེ་དེ་གཉིས་ལ་ལྟོས་པས་ལོ་ཉིས་སྟོང་ཙམ་གྱིས་འཕྱིས་པའི་སྤྱི་ལོའི་གོང་གི་ལོ་ལྷག་ཡི་གེ་རིག་པའི་སྐོར་གྱི་དྲི་བ།",
    "ཁོ་རེ་ཡ།",
    "ནུབ་ཕྱོགས་ཀྱི་ཨ་མེ་རི་ཀའི་གླིང་ནི་ཨེ་ཤ་ཡ་དང་ཨ་ཧྥུ་རི་ཀའི་གླིང་ལ་ལྟོས་པས་ཡི་གེ་འབྱུང་འཕྱི་ཡང་།",
    "ཡི་གེ་དེ་ནི་མ་མཐའ་ཡང་སྤྱི་ལོ་མ་ཚུགས་གོང་གི་དུས་རབས་འགའ་ཞིག་གི་ནང་དུ་བྱུང་བར་མཁས་པ་དག་སྨྲའོ།",
    "འཇང་གི་ཡི་གེ་ཞེས་བྱ་བའི་བྱུང་ཚུལ་ལ།",
    "སྔོན་གྱི་དུས་ཤིག་ལ་སྐྱེས་བུ་ཆེན་པོ་ཞིག་གི་བུ་ཕྲུག་སྤུན་གསུམ་རྒྱ་བོད་འཇང་གི་ཡུལ་གྲུ་ཐ་དད་དུ་སྡོད་སྐབས།",
    "བོད་ཡིག་འཇང་ཡིག་གསུམ་བཟོས་པར་སྐད་པ་དང་གཅིག་བོན་གྱི་སྟོན་པ་གཤེན་རབ་མཆོག་གིས་སྟོན་པའི་བསྟན་པ་འདི་ཉིད་གསར་དུ་མཛད་མ་ཐག་པའི་དུས་དེ་ལ།",
    "ཁོང་གི་ཐུགས་སྲས་མཐའ་པ་ཐར་དང་།",
    "འཇང་ས་ཐང་གི་དམག་ས་སྒོའི་ཁྱིམ་དུ་སྟོན་པ་མང་པོ་བསྡུས་པ་རྣམས་ཀྱིས་སྔར་ཡོད་ཀྱི་སྟོན་པའི་ཡི་གེ་དེ་ཉིད་འབྲི་དཀའ་བར་མཐོང་སྟེ།",
    "འཇང་པའི་སྐད་ལ་རྡོར་བརྐོས་ཤིང་བརྐོས་ཏེ་རྡོ་བ་དང་ཤིང་གི་སྟེང་ལ་བཏབ་པའི་བརྡ་རྟགས་ཞེས་པ་འདི་ནི།"
  ]
}