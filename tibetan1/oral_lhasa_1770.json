    "སྐྱེ་བ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་སྐྱེ་བ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྒ་ཤི་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་རྒ་ཤི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞི་ཞེས་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ། ༺འབུམ་ཆ་",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ནང་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ཕྱི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར། ༺འབུམ་ཆ་",
    "སྟོང་པ་ཉིད་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར། ༺འབུམ་ཆ་",
    "སྟོང་པ་ཉིད་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ནང་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ཕྱི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ། ༺འབུམ་ཆ་",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོར་བ་མྱེད་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ནང་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ཕྱི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ནང་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ཕྱི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་༺འབུམ་ཆ་",
    "སྐྱེ་བ་མྱེད་པ་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ནང་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ཕྱི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་༺འབུམ་ཆ་",
    "པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར། ༺འབུམ་ཆ་",
    "འགག་པ་མྱེད་པ་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ནང་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ཕྱི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ། ༺འབུམ་ཆ་",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ནང་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ཕྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ཕྱི་ནང་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ཆེན་པོ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་དོན་དམ་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་འདུས་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་རང་བཞིན་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "པ་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ། ༺འབུམ་ཆ་",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་ཡང་དག་པར་སྤོང་བ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་ཡང་དག་པར་སྤོང་བ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་ཡང་དག་པར་སྤོང་བ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་ཡང་དག་པར་སྤོང་བ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་ཡང་དག་པར་སྤོང་བ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་ཡང་དག་པར་སྤོང་བ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་ཡང་དག་པར་སྤོང་བ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ། ༺འབུམ་ཆ་",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོབས་རྣམས་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་སྟོབས་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོབས་རྣམས་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་སྟོབས་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོབས་རྣམས་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་སྟོབས་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོབས་རྣམས་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་སྟོབས་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོབས་རྣམས་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་སྟོབས་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོབས་རྣམས་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་སྟོབས་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "སྟོབས་རྣམས་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་སྟོབས་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "ཆུབ་ཀྱི་ཡན་ལག་རྣམས་ཤེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་སྟོང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྟོང་པ་ཉིད་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་མཚན་མ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "མཚན་མ་མྱེད་པ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་སྨོན་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྨོན་པ་མྱེད་པ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་སྐྱེ་བ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "སྐྱེ་བ་མྱེད་པ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་འགག་པ་མྱེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "འགག་པ་མྱེད་པ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "ཞི་བ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་དབེན་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར།",
    "དབེན་པ་འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མྱི་འགྱུར་རོ།",
