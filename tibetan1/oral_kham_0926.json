    "གནས་པ་བཞི་འམ་ལྷག་པ་དག་འདུག་ཅིང་མཐུན་པར་གྱུར་པ་ན་དེ་དག་འདི་སྙམ་དུ་སེམས་ཏེ་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དག་ཡོད་ན་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དེ་དག་མེད་ཀྱང་རུང་་དེ་ཉིད་དུ་འདུག་ཀྱང་རུང་་སོ་སོར་གྱུར་ཀྱང་རུང་་ཐག་རིང་པོར་གྱུར་༧",
    "པ་ན་དེ་དག་འདི་སྙམ་དུ་སེམས་ཏེ་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དག་ཡོད་ན་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དེ་དག་མེད་ཀྱང་རུང་་དེ་ཉིད་དུ་འདུག་ཀྱང་རུང་་སོ་སོར་གྱུར་ཀྱང་རུང་་ཐག་རིང་པོར་གྱུར་ཀྱང་རུང་སྙམ་ནས་དབྱེན་གྱིས་དོན་དུ་གཉེར་བ་དབྱེན་གྱི་ཡོ་བྱད་ཅན་༥",
    "འདི་སྙམ་དུ་སེམས་ཏེ་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དག་ཡོད་ན་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དེ་དག་མེད་ཀྱང་རུང་་དེ་ཉིད་དུ་འདུག་ཀྱང་རུང་་སོ་སོར་གྱུར་ཀྱང་རུང་་ཐག་རིང་པོར་གྱུར་ཀྱང་རུང་སྙམ་ནས་དབྱེན་གྱིས་དོན་དུ་གཉེར་བ་༧",
    "མཐོང་ན་དེ་དག་འདི་སྙམ་དུ་སེམས་ཤིང་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དག་ཡོད་ན་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དེ་དག་མེད་ཀྱང་རུང་་དེ་ཉིད་དུ་འདུག་ཀྱང་རུང་་སོ་སོར་འདུག་ཀྱང་རུང་་ཐག་རིང་པོར་གྱུར་ཀྱང་རུང་སྙམ་ནསདབྱེན་གྱིས་དོན་དུ་གཉེར་༦",
    "འདི་སྙམ་དུ་སེམས་ཏེ་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དག་ཡོད་ན་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དེ་དག་མེད་ཀྱང་རུང་་དེ་ཉིད་དུ་འདུག་ཀྱང་རུང་་སོ་སོར་གྱུར་ཀྱང་རུང་་ཐག་རིང་པོར་གྱུར་ཀྱང་རུང་སྙམ་ནས་དབྱེན་གྱིས་དོན་དུ་གཉེར་བ་དབྱེན་གྱི་ཡོ་བྱད་༣",
    "འདི་སྙམ་དུ་སེམས་ཏེ་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དག་ཡོད་ན་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དེ་དག་མེད་ཀྱང་རུང་་དེ་ཉིད་དུ་འདུག་ཀྱང་རུང་་སོ་སོར་གྱུར་ཀྱང་རུང་་ཐག་རིང་པོར་གྱུར་ཀྱང་རུང་སྙམ་ནས་དབྱེན་གྱིས་དོན་དུ་གཉེར་བ་དབྱེན་༣",
    "པས་བྱུགས་པ་དང་་གནས་མལ་བཤམས་པ་དང་་འབྲུ་མར་གྱི་མར་མེ་བུས་པ་དག་མཐོང་ན་དེ་དག་འདི་སྙམ་དུ་སེམས་ཏེ་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དག་ཡོད་ན་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དེ་དག་མེད་ཀྱང་རུང་་དེ་ཉིད་དུ་འདུག་ཀྱང་རུང་་སོ་༦",
    "གཏང་རག་དག་ཐོས་ན་དེ་དག་འདི་སྙམ་དུ་སེམས་ཏེ་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དག་ཡོད་ན་་དགེ་སློང་གང་དག་མ་ལྷགས་པ་དེ་དག་མེད་ཀྱང་རུང་་དེ་ཉིད་དུ་འདུག་ཀྱང་རུང་་སོ་སོར་གྱུར་ཀྱང་རུང་་ཐག་རིང་པོར་གྱུར་ཀྱང་རུང་སྙམ་ནས་དབྱེན་གྱིས་༤",
    "བརྒྱ་ལ་བློ་ལོག་ན་རང་གཞན་ཀུན་ཕུང་ཁ་སྦྱོར་བ་ཞིག་འོང་བ་འདུག་པསྭ།",
    "ཆུང་སྟེ་ནོར་ཞིང་ཁང་དང་བཅས་པ་སྐྱེལ་བར་འདུག་ཟེར།",
    "འཕྲལ་གྱི་སྙན་པ་ཤིན་ཏུ་ཆེ་བར་འདུག་པས།",
    "བལ་པོར་ཕེབས་ནས་ཉིན་གཅིག་རི་སུལ་ཅིག་ནི་མི་མང་པོ་ལོང་ལོང་འདུག་པ་ལ་ཅི་ཡིན་དྲིས་པས།",
    "གཉོས་ཀྱིས་བལ་སྐད་གོ་ཤིང་འདུག་པས་མ་དགའ་བར།",
    "ཀུ་སུ་ལའི་སྒོམ་བྱེད་ཅིང་ཡོད་འདུག་པས།",
    "ཁྱེད་རང་ངའི་ཕྱི་ལ་འགྲོ་ན་གསེར་མཉམ་དུ་བྱེད།",
    "རྨེ་ཏི་བའི་སར་ཡང་རྫོངས་བར་འདུག་ཅིང་།",
    "ཁོང་ང་ལ་གཤེ་ཞིང་མི་འདུག་གམ་གསུང་།",
    "ད་གསེར་ཕལ་ཆེར་རྫོགས་འདུག་པས།",
    "གཞན་ཡང་ལམ་གྲོགས་འགའེ་ཟུང་འདུག་པ་ལ།་",
    "ང་རང་མཐོང་ཆེ་མ་ཡིན་ཏེ།",
    "བསུ་མི་དང་བཅས་ཁ་རག་ཏུ་སླེབ་པར་གདའ།",
    "དོན་གོལ་བ་གདའ་ན་བཟོད་པར་གསོལ།",
    "གྲོགས་ཧ་དུ་དཀར་པོ་ལ་སོགས་པ་རྣམས་དོགེས་པར་གདའོ།",
    "མནལ་སད་ནས་ཀྱང་གསུང་རྣམས་མ་བརྗེད་པར་འདུག་སྟེ་དགའ་སྤྲོ་དང་བཅས་པའི་ངང་ནས་མང་ཡུལ་དུ་ཕེབས་ཏེ།",
    "དོན་འཁྲུལ་པར་གདའ་ན་བཟོད་པར་གསོལ།",
    "ཡབ་ཡུམ་གཉིས་ནི་སྐུ་གཤེགས་འདུག་སློབ་དཔོན་དང་ཇོ་བོ་གཅེན་པོ་རྣམས་ཀྱིས་སྣ་ལན་བཟང་པོ་མཛད།",
    "སྒང་རྒྱུད་ན་མི་མང་པོ་ལོང་ལོང་འདུག་པ་ལ།",
    "ང་དང་རུས་ཀྱི་ཕ་ཚན་དུ་ཡང་འགྲོ་བ་འདུག་ཅིང་།",
    "རྙིང་པ་འགའ་ཞིག་ཀྱང་གསོལ་འདུག་པ་ལ།",
    "ན་བཟའ་སོ་མ་གཞན་ཡང་འགའ་འདུག་པ་ལ་མི་བཞེས་པ་འདི།",
    "ཕྱག་རྫ་ས་ལ་སྲེད་པོ་རང་འོང་རིགས་སུ་འདུག་པས།",
    "དེ་ལུགས་ཅིག་བྱེད་པས་བློ་མ་བརྟག་དགོས་པར་འདུག་སྙམ།",
    "གཞན་ཡང་གདའ་བ་ལ་དང་པོ་ནས་མི་གསོལ་བ་ཅི་ལགས་ཞུས་པས།",
    "ཕྱག་རྫས་ལ་སྲེད་པ་ལྟ་བུ་དེ་སྐྱོན་དུ་མི་འདུག་ཡོན་ཏན་དུ་འདུག་སྙམ་ནས་མར་པ་མགོ་ལེགས་ལོས་འབྲེལ་སད་པའི་ཕྱིར།",
    "ཡར་བལ་བོད་མཚམས་སུ་ཐོན་ཙ་ན།",
    "ཡུལ་ལ་སྟོད་ཚོ་བཞིར་ཕྱིན་ཙ་ན།",
    "གོ་ལུགས་ད་གོངས་པ་འདི་ལྟར་གདའ།",
    "དོན་ལ་ལྟ་སྒོམ་སྤྱོད་འབྲས་ཇི་ལྟར་བཞེད་པ་འདུག་གསུངས་པ་ལ།",
    "ལོ་ཙཱ་བ་ཁྱེད་ཀྱི་འདུ་ན་མ་གཤའ་མར་གྲུབ་གདའ་གསུང་ངོ།",
    "ཁོང་འབྱོན་ཞིང་འདུག་པ་ལ་གཤེགས་སྐྱེལ་བྱས།",
    "ནག་ཚོ་ལོ་ཙཱ་བས་སྒྲོན་གསལ་འཆད་ཅིང་འདུག་པའི་སར་ཕེབས་པ་ལས།",
