    "རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མང་ཟས་སྤྱ་ནེ་གྱ་ཀུན་དགའ་རབ་ནབཞུགས་སོ།",
    "ངས་འདི་སྐད་ཅེས་བཀའ་སྩལ་ཏོཞེས་གྱིས་ཤག།",
    "བཀའ་བཅག་པར་གྱུར་ན།",
    "ཁཆིག་ནི་རྒྱུན་དུ་ཞུགས་པ་ནས་དགྲ་བཅོམཔའིབརདུ་ཐོབ་པར་གྱུརཏོ།",
    "ཕྱིར་མི་ལྡོག་པའིསལ་གནས་པར་གྱུར་ཏོ་།",
    "ཚིམ་པར་གྱུར་ནས་ཐམསཅད་ལ་སྐྱིད་རྗེའིསམསསྐྱེ་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ལེགས་པར་འོངས་སོ་ཞེས་བཀའ་སྩལ་པས་སྐ་དང་ཁ་སྐུ་རང་བྱི་སྟེ།",
    "འདི་ལྟར་རིགསཚེ་ཞིང་མཐོ་ལ་ཡོན་ཏན་འཕགས་པར་ཆེ་ཞིང་།",
    "དེ་མ་ཐག་ཏུ་ཟག་པ་ཟད་པར་གྱུར།",
    "དཔེ་མེདཔར་མདའ་བྱད་ལེགས་པ་བལྟ་ན་སྡུག་པ།",
    "རི་ལུད་ཚིག་པར་བྱེད་དོ།",
    "རྩ་ཁྲི་དང་འདྲ་སྟེ་མཆེད་པར་འགྱུར་རོ།",
    "དེའི་བུ་ཡད་ཡོད་པར་གྱུར་ཏོ།",
    "བསོད་སྙོམས་ཕུལ་ནས་མཆེདཔ་བྱས་སོ།",
    "དེའི་ཕྱིར་དེ་བཞི་ན་གཤེགས་པ་དང་ཕྲད་ནས་སེམས་རྣམ་པར་གྲོལ་ཏེ་དགྲ་བཅོམ་པཐོབ་བོ།",
    "རྒྱ་དེལ་བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློངམ་ཨུདཔ་ལས་ནི་ལེགས་པར་བསྟན་ཏོ།",
    "རྣམ་པར་གྲོལབར་གྱུང་ཏོ།",
    "རྒྱལཔོས་དེསྐ་དཅེ་ས་ཐོས་པ་དང་རབ་ཏུ་མྱ་ངན་གྱིས་ཡི་མུག་པར་གྱུར་ཏེ།",
    "བཅོམ་ལྡན་འདས་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བནབཞུགས་སོ།",
    "ས་ས་རྒྱས་ཀྱིས་ཀྱང་ལྷུང་བཟེད་སྨད་ནས་ཕུལ་བ་བཞེས་སོ།",
    "འཛམ་བུ་གླིང་དུམཆོད་རྟན་བརྒྱདཁྲི་བཞི་སྟོད་ཅིགཅར་བྱེདཔར་འགྱུར་རོ།",
    "དེ་ལྟར་དེ་བཞིན་གཤེགས་པའི་སྐུ་གཟུགས་བརྒྱད་ཁྲི་བཞི་སྟོད་བྲིས་ཏེ།",
    "བཙེམ་ལྡན་འདས་ཀྱིས་དེ་སྐདགསུངས་པ་ལ།",
    "བཅོམ་ལྡན་འདས་མཉན་ཡོད་ན་རྒྱ་ཐ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་དགའར་བ་ན་བཞུགས་སོ།",
    "བཅོམ་ལྡན་འདས་ནི་འཇིག་རྟེན་གྱི་གཙོ་བོ་ཡོན་ཏན་དཔག་ཏུ་མ་མཆིས་པ་ཡེ་ཞེས་བསམ་གྱིས་མི་ཁྱབ་པ་ལགསན།",
    "གསེར་གྱི་བུམ་པ་གཅིག་བྱས་ཏེ།",
    "སྦྲུལ་དེ་ཡང་ལོ་གྲངས་མང་དུ་ལོན་པས་ཆེའི་དུས་བྱས་ནས།",
    "བྱས་པ་གཟོ་བོའི་དྲིན་ཡང་དྲནཔ་མ་བྱས་པས།",
    "བཙོ་ནི་ལ་ཁ་ཟས་སྦྱིན་པར་བྱས་པ་དྲན་ཏེ།",
    "གདོནཐ་མསཅདཀྱིས་གནོདཔར་བྱེད་པར་མི་ནུས་སོ་ཞེས་ཐོས་ཀྱིས།",
    "ཁང་བུ་བརྩེགས་པའི་ཤར་ཕྱོགས་ཀྱི་སྐར་ཁུང་ནས་དེ་མའི་འོད་ཟེར་བྱུང་བཞུབ་ཕྱོགས་ཀྱི་ངོས་ལ་ཤར་ཞིང་ལྷན་པ་བཞིན་དུ་བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ཀུན་དགའ་བོ་ལ་དགོད་ཤིང་དགྱེས་པར་ཉེ་གནས་ཀུན་གྱིས་རྟོགས་ནས།",
    "དེ་བཞིན་གཤེགས་པ་ལ་བསྙེན་བཀུར་བྱས་ན།",
    "བཙུན་པ་ཤཱརའི་བུ་བདག་ནི་བཅོམ་ལྡན་འདས་ལ་བསྙེན་བཀུར་བྱེད་པར་མི་དངདོ།",
    "བདག་བཅོམ་ལྡན་འདས་ལ་བསྟེ་ནི་བཀུར་བགྱིད་པར་མི་དད་དོ།",
    "དད་པར་གྱིས་ཤིག།",
    "དེ་བཞིན་གཤེགས་པ་ལ་བསྙན་བཀུར་བྱས་ན།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བདག་ལ་འདོད་པ་འདི་གསུམ་གནང་ན།",
    "བདག་ལ་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་འདི་སྐད་དུ་ད་གེ་སློད་ཀུན་དགའབོ་ན་གོས་དང་།",
    "བརྒྱ་ལ་མཁབ་པ་དང་གཞན་ཡང་མུ་སྟེགས་ཅན་ཀུན་དུ་རྒྱུ་རྣམས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འགྲོ་པའི་དུས་ལ་བབ་པ་དང་གཞན་མུ་སྟེགས་ཅན་ཀུན་དུ་རྒྱུ་འདིདག་ནི་བཅོམ་ལྡན་འདས་ཀྱི་གསུངས་པ་ལ་ལན་ལྡོན་པར་སྤོབས་སོ།",
    "འདི་དག་ནི་ལན་ཉེང་བརྒྱད་ལྡོན་པར་མི་སྤོབས་སོ།",
    "བཅ་འ་བ་དང་བཟའ་བ་འདི་ནི་བཅོམ་ལྡན་འདས་ལ་བདེཞིངགསོ་དཔར་འགྱུར།",
    "ཚེ་དང་ལྡན་པ་ཀུན་དགའ་བོ་བཅོམ་ལྡན་འདས་ལ་བསྟན་བཀུར་བྱེད་པར་དངཔར་བྱས་པ་དང་བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་ཀུན་དགའ་བོ་ནི་མཁས་པ་ཅན་ཏེ།",
    "དེ་ནས་བཙས་སྟོན་བྱས་ནས་མཚན་མཁན་བཀུག་སྟེ།",
    "དབྱར་རྒུན་དང་སྟོན་དཔྱིད་ཀྱི་གནས་ཀྱངསོ་སོར་བྱས་ཏེ་ལོངས་སྤྱོད་བྱེད་དུ་བཅུག་གོ།",
    "དེ་ལ་ཁ་བརྒྱ་ཅིག་ནི་བདག་ཅག་བག་མ་བྱས་པས་ཆོམ་པོས་བཅོམ་སྟེ།",
    "བདགཅོག་ནི་ཕ་མས་རྒྱུད་ཀྱིས་བསོད་པའི་ལས་བྱེད་དེ་འདི་མ་བྱས་ན་མི་འཚོའོ་ཞེས་ཟེར་རོ།",
    "ཕའི་བང་མཛོད་སྟོངས་པར་བྱ་བར་མི་རིགས་ཀྱི།",
    "སྐྱེ་བོ་མང་པོ་ལ་ཕན་ཐོགས་པར་འགྱུར་བ་བསམས་ནས་མི་དག།",
    "འདི་ལ་ནི་ཉན་པ་མེད་ཀྱིས་མ་སེམས་པར་འཇུག་ཅིག་ཅེས་བསྒོའོ།",
    "ཡབ་ཡུམ་གྱིས་མཁྱེན་པར་མཛོད་ཅིག།",
    "དེ་ཙམ་གྱི་བར་དུ་བྱ་བར་བརྩམས་པ་མཐར་མ་གྲུབ་གྱི་པར་དུ་མི་གཏོངབས།",
    "ཡིད་བཞིན་དུ་འགྲོ་བར་གནང་ངོ་ཞེས་སྨྲས་པ་དང་།",
    "ཕ་མ་དང་སྐྱེལ་བ་ཐམས་ཅད་འདུས་ཏེ་མཆི་ཕྱག་བྱས་ནས།",
    "བྲམ་ཟེ་དེའི་ཁྱིམ་དུ་སོངབས་བྲམ་ཟེ་དེ་ལས་སྦྱིན་པ་ཆེན་པོས་གསོར་སྲད་སུམ་སྟོར་བསླངབར་བྱས་སོ།",
    "ཁྱེའུ་དེས་གསར་བསླངས་པ་དང་བྲམ་ཟེས་ཀྱང་སྦྱིནཔ་ངགནང་ནས།",
    "ལོངས་སྤྱོད་ཟད་མི་ཤེས་པར་གྱུར་ཏོ་ཞེས་སྨྲས་ནས།",
    "བདག་ཅག་ཀྱང་ཕྱིར་ཁྱིམ་ངུ་མི་ཕྱིན་ཏེ་ཐམས་ཅད་འཁྱམས་པར་འགྱུར་རོ།",
    "ཡིད་བཞིན་གྱི་ནོར་བུ་རིན་བོཆེ་ཡབ་སྦྱིན་ནོ་ཞེས་བྱས་པ་དང་།",
    "རན་པོ་ཆེ་ནི་ཤིན་དུ་ཡང་རྙེད་པར་དཀའ་སྟེ།",
    "བསྙེན་བཀུར་བྱེད་པར་ཤོག་ཤིག་ཅེས་སྐྱོནལམ་བཏབ་པོ།",
    "ཅིའི་ཕྱིར་རྒྱ་མཚོ་འདིསྐམས་པར་མི་ནུས་ཞེས་སྨྲས་སོ།",
    "རྡུལ་མི་འཐུལ་བར་བྱས་པའིའོག་ཏུ།",
    "མུན་པ་ནས་མུན་པར་འགྲོབས།",
    "ཀུན་དགའ་བོ་འདི་ཀླུའི་རྒྱལ་པོ་བྱེད་པན་ཡངང་ལ་བསྙེན་བཀུར་བྱས་ཏེ།",
    "བཞུགས་པ་ལ།",
    "རྒྱལ་པོའྀ་གདུང་རྒྱུད་མི་འཆད་པར་བྱའོ་སྙམ་བསམས་ནས།",
    "རྒྱལ་བོ་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མད་ཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བན་བཞུགས་སོ།",
    "སྐྱེ་བ་ཕྱི་མའི་རྣམ་པར་སྨིན་པས་འཇིགས་ཏེ།",
    "ཤཱཀྱའི་རིགས་ཀྱང་རིགས་སུན་པར་བགྱིས་སོ།",
    "ལྷ་སྦྱིན་གྱིས་འདས་པའི་དུས་ན།",
    "རྙེ་པ་༨༨གྲགས་པའི་སླད་དུ་ལུས་དང་སྲོག་སྟོར་བའི་ལས་བགྱིད་པ་ཇི་ལྟ་བ་ལགས་ཞེས་གསོལ་པ་དང་།",
    "ལམ་རིད་བནས་ཞག་བདུན་གྱིས་གནས་སུ་མཕྱིན་པར་རྒྱགས་ཆད་དེ་སྲོག་དང་བྲལ་དུ་ཉེ་ནས་ལེགས་ཚོལ་དང་།"
