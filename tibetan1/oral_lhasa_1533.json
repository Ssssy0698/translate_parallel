    "སོ་ཚིས་ཞིག་སྟེ་དབུལ་འཕོངས་པར་གྱུར་ཏོ།",
    "དེའི་རྒྱུ་དེའི་ཏན་གྱིས་ཚེའི་དུས་བྱས་ནས་ཀྱང་ཁྱིམ་བདག་དེའི་ཁྱིམ་དུ་སྐྱེས་ཏེ།",
    "བཅོམ་ལྡ་ནའདས་མཉན་ཡོདན་ཆལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མདཟས་སྦྱིན་གྱི་ཀུན་དགའ་ར་བ་ན་བཞུགས་སོ།",
    "བདག་པས་ལྷག་པར་བཟང་བ་དེ་སུ་ཞིག།",
    "འཁོར་མང་པོ་དེ་དག་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་ལ་ཡིད་རངས་ཏེ་མངོནཔར་དགའོ།",
    "གལ་ཏེ་སྣོན་ལམ་བཞིན་དུ་མ་བྱས་ན་གདོན་མི་ཟ་བར་མི་སྡུག་པརམཐོ་བཙམས་སོ་སྙམ་བསམས་ནས་རྟེན་སྲུང་བའི་ལྷ་དེས་མ་ནི་བ་དྲལ་གསོལ་ཏོ།",
    "སྣོན་པ་བཞནི་ངུ་མ་བྱས་ན་རྟེན་ཡང་བཤིག་སྟེ་མི་སྡུག་པར་བྱའོ་ཞེས་དམ་བཅས་པས།",
    "རིགས་ཐ་མལ་པར་སྐྱེས་ན་སླའོ་ཞེས་སྨྲས་པ་དང་བརྒྱ་བྱིན་སྨྲས་པ།",
    "རྒྱལ་པོའི་ཁབ་ཀྱྰ་བློན་པོ་ཆེན་པོའི་བུ་ལགས་སོ།",
    "རྒྱལ་པོས་འགུམ་པར་བགྱིས་པ་ལས་ཀྱང་འདི་ལྟར་མ་གུམ་སྟེ།",
    "འབྲས་བུ་ཐོབ་པར་བྱས་པ་དེ་ནི་འདི་ཡིན་ནོ།",
    "དད་དང་ཕྲད་ནས་འབྲས་བུ་མཆོག་ཐོབ་པར་གྱུར་ཏོ།",
    "བཅོམ་ལྡན་༢དས་མཉན་ཡོད་ན་རྒྱལ་བུ་རྒྱལ་བྱེད་ཀྱི་ཚལ་མགོན་མེད་ཟས་སྦྱིན་གྱི་ཀུན་ངགའ་ར་བ་ན་བཞུགས་སོ།",
    "བསམཔ་ཤིན་དུ་དཀ་པར་གྱུར་ཏོ།",
    "དེ་ལྟར་དཀའ་མགུརངས་པས་མི་སྡུག་པ་ཐམས་ཅད་མེད་པར་གྱུར་ཏེ།",
    "མི་སྡུག་པ་དང་རྩུབ་པ་ཡང་མེདཔར་གྱུར་ཏོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྐུ་དང་སྟ་ཟུར་ཡནཅད་མངོནཔརབསྟནཏེ།",
    "རྒྱུན་དུ་ཞུགས་ལས་སུ་པ་ཐོབ་པར་གྱུར་ནས་བཅོམ་ལྡན་འདས་ཀྱང་སླར་གཤེགས་སོ།",
    "དེའི་ཆུང་མ་རབ་ཏུ་མཛེས་ཤིང་བཟང་ལ་དཔེ་ཟླ་མེད་པར་མཐད་ནས།",
    "བྱད་བཞིན་མི་སྡུག་པ་ལུས་ཀྱི་ལྤགས་པ་རྩུབ་པ་འདི་ནི་དེ་མི་སྡུག་ཅེམཁན་ཕོའ་བྱས་སོ།",
    "ཁྱིམ་དེའི་མི་ཐམས་ཅད་ཀྱིས་ཆོ་འཕྲུལ་དེ་མཐོང་བང་བྱས་ནས་ནམམཁའ་ལས་བབ་ཏེ་དེའི་ཁྱི་མཇུ་གཤེགས་སོ།",
    "བརྒྱ་པར་གྲོལ་བར་གྱུར་ཏོ།",
    "འཁོརམད་པོ་ཐམས་ཅད་བཅོམ་ལྡན་འདས་ཀྱིས་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་བསྟན་པ་ཐོས་ནས།",
    "བསམ་པ་ཤིན་དུ་དག་པའི་དད་དད་པ་དང་ལྡན་པར་གྱུར་ཏོཏོ།",
    "ལ་ལ་ནི་ཕྱིར་མ་ལྡོག་བའི་ས་ལ་གནས་པར་གྱུར་ཏེ།",
    "དེབཞིནརུ་ཕ་མ་གཉིས་ཀྱིས་གསེར་གྱི་དོང་ཙེ་ལག་མཐིལ་ནས་བླངས་པས་བང་མཛོད་གང་ཡང་བུའི་ལག་ནས་དོད་ཙ་ཟད་བརྒྱ་པར་མ་གྱུར་ཏོ།",
    "ཁྱེའུ་དེ་ཕྱིསཆེར་སྐྱེསནས་པ་མ་ལ་བདག་རབ་ཏུ་འབྱུད་དེ་ཞེས་གསོལ་པ་དང་ཐམས་ཀྱང་ཡིད་བཞིན་དུ་གནང་ངོ་ཞེས་སྨྲས་སོ།",
    "བསྙེན་པར་རྡོགསནས་བརྩོན་འགྲུས་སུབསྒོམས་པས་དགྲ་བཅོམ་པ་ཐོབ་པར་གྱུར་ཏོ།",
    "རྟག་པར་ཉོན་ལ་ཤིན་ཏུ་ཡིད་ལ་བཟུང་ཤིག་དང་ཁྱེད་ལ་བསྟན་པར་བྱའོ་ཞེས་བཀའ་སྩལ་པ་དང་ཀུན་དགའ་བོས་དེ་བཞིན་རུ་ཐོས་ཕི་",
    "པར་འཚལ་ལོ་ཞེས་གསོལ་ཏོ།",
    "ལ་ལ་ནི་བྱརམ་ལྡོག་པའི་ས་ལ་གནས་པར་གྱུར་ཏེ།",
    "ཐོས་པར་འདོད་ན་ལེགས་པརཉན་ཅིག།",
    "བཅོམ་ལྡནའདས་ཀྱིས་དགེ་སློ་ལེགས་པར་འོདསསོ་ཞེས་བྱ་བ་གནང་ནས་སྐྲ་དང་ཁ་སྤུརང་བྱི་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་བསྟན་པས་ངགྲ་བཅོམ་པར་གྱུར་ཏེ།",
    "ལ་ལ་ནི་འབྲས་བུ་དང་པོ་ནས་འབྲས་བུ་བཞིཔའིབར་དུཐོབ་པར་གྱུར་ཏོ།",
    "ལ་ལ་ནི་ཕྱིར་མི་ལྡོག་པའི་མ་ལ་གནས་པའི་སེམས་སྐྱེས་པར་གྱུར་ཏོ།",
    "བཅོམ་ལྡན་འདས་རྒྱལཔོའི་ཁབ་བྱ་ཀ་ལན་དག་གནས་པ་འོདམའི་ཚལ་ན་བཞུགསསོ།",
    "དགེ་སློང་དེ་དག་ད་སྐད་སྨྲས་པ་ཐོསནས་དེ་བཞིན་དུབ་ཅོམ་ལྡན་འདས་ལ་རྒྱས་པར་གསོལ་བ་དང་།",
    "བདུད་རྩིའི་ཆུས་ཁྱེད་ཀྱི་རྡུལ་དང་དྲི་མ་བཀྲུས་ཏེ་འདོད་པའི་ཚིག་པ་ཡོངས་སུ་དག་པར་ཤོག་ཤིག་ཅེས་དམ་བཅས་སོ།",
    "བཅོམ་ལྡན་འདས་རྒྱལ་བུ་རྒྱལ་བྱེདཀྱི་ཚལ་མགོ་ན་མད་ཟས་སྦྱིནགྱིཀུན་དགའར་བ་ན་བཞུགས་སོ།",
    "ཁྲག་ལས་ངོམས་པར་འཐུང་ངུ་བཅུ།",
    "འདོདཔས་གདུངས་པ་ལས་ཤིན་ཏུ་བདེ་བའི་མྱ་ངན་ལས་འདས་པ་ལས་འགོད་པར་ཤོག་ཅིག་ཅེས་སྣུམསོ།",
    "རྒྱལ་པོ་བྱམས་པའི་སྟོབས་ཀྱིས་སྦྱིནཔབྱས་པའིལེའུ་སྟེ་བཅུ་གཉིས་པའོ།",
    "བདག་གཅིག་པུ་མ་གཏོགས་པར་འདིདག་ཐམསཅདནི་རྫུ་འཕྲུལ་ཆེ་མཐུ་ཆེ་བརསོ་སོར་སྟོན་ཏོ་སྙམ་བསམས་སོ།",
    "ལྷ་བདག་ཅག་རྣམས་ནི་ཆོ་འཕྲུལ་དད་ལྡན་ཞིང་ཤེས་པར་སྨྲ་བ་ལགས་ན།",
    "རྒྱལ་མཚན་དདབ་དན་བཙུགས་ཏེ་ཤིན་རྩ་མཛེས་པར་བརྒྱན་ཏོ།",
    "ངེ་ཉིད་དུས་མཁྱེན་ཏོ།",
    "དེ་ནས་སྟོན་པ་དྲུག་པོས་རྒྱལ་པོ་ཤུན་ཙིན་དལ་བདག་ཅག་དག་སྦྱོ་དགོ་ཏ་མ་ལ་ཆོ་འཕྲུལ་འགྲན་པར་གྱིས་ཤིགཅེས་གསོལ་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དཉིད་ངུས་མཁྱེནནོ་ཞེས་བཀའ་སྩལ་ཁོ།",
    "བཅོམ་ལྡན་འདས་དཉིད་ཇུས་མཁྱེན་ཏོ་ཞེས་བཀའ་སྩལ་ཏོ།",
    "ཏིཀི་ཙ་ཤི་རིའི་མདི་དག་དེ་བཞིན་གཤེགས་པ་བཞུད་པར་གདོད་ཤེས་ནས་སྟོན་པ་དྲུགཀྱད་དེའི་རྗེས་སུ་དོང་ངོ།",
    "ར་འདི་བུས་མཁྱེན་ནོ་ཞེས་བཀའ་སྩལ་ཏོ།",
    "ཡུལ་བཱ་རཱ་ཎ་སཱིའི་མརྣམས་ཀྱིས་ཀྱང་དེ་བཞིན་གཤེགས་པ་བཞུད་པར་གདོད་རྟོགས་ནས་སྟོན་པ་དྲུག་བོ་ཡང་རྗེས་སུ་དོང་ངོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དཀིར་ངུས་མཁྱེན་ནོ་ཞེསབཀའ་སྩལ་ཏོ།",
