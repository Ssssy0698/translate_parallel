    "ང་ལ་དུག་ལོག་ལེགས་ཤོས་དེ་གཡོགས་ནས་ཨ་ཞང་པིམ་པལ་ཅུག་ལ་རྩིས་སྤྲད་དེ།",
    "བལྟས་ན་ཡིད་མུག་པ་ཞིག་འདུག་སྒེའུ་ཁུང་ཚང་མར་ལྕགས་ཀྱི་ཁྲ་མ་ཡོད་པ་མཐོང་།",
    "སྤོབས་ཉམས་དང་ལྡན་པ་ཞིག་འདུག་ཀྱང་།",
    "ས་ཆ་འདི་རྒྱུས་མེད་གསར་པ་དང་གོམས་འདྲིས་མེད་པས་ཁྱད་མཚར་ཚོར་གྱི་འདུག་ཅེས་ཞུས་ཏེ།",
    "ཁྱེད་རང་བུ་འདི་དང་མཉམ་དུ་ཏཱ་སེ་རྩེས་དང་།",
    "གང་ཡང་ལབ་འདོད་མི་འདུག་ཅེས་ཞུས་པ་ཡིན།",
    "ད་ང་ནང་ལ་ལོག་འདོད་འདུག་ཅེས་ཞུས་པས།",
    "ད་ལྟ་ང་ཁྱིིམ་ལ་ལོག་འདོད་འདུག་ཞུས་པར་ལྕམ་ཧབི་ཤཱམ་གྱིས།",
    "ཁང་པར་དཀར་ཆ་ཕྲན་བུ་འདུག་དེ་ནི་ཁང་མིག་ཆེན་པོ་ཞིག་ཡིན་པ་དང་།",
    "དེ་མུར་ལུས་པ་ནང་བཞིན་འདུག་རས་དེའི་དབུས་སུ་དོ་སྣང་བྱེད་འོས་པའི་དངོས་པོ་ཞིག་འདུག་ཀྱང་།",
    "ཁོས་ཁྱེད་རང་ནང་ལ་སུས་བཏང་བྱུང་།",
    "ཁོ་པ་ང་དང་ལོ་མཉམ་ཡིན་ཚོད་འདུག་ཀྱང་།",
    "ང་ལས་གཟུགས་རིང་བ་འདུག་ཁོས་ལག་པ་གནམ་ལ་བརྐྱངས་ཏེ་ངའི་སྟེང་དུ་མཆོངས་ཡོང་སྐབས།",
    "ཁོ་རང་ཕམ་ཉེས་བྱུང་བས་ད་ནི་ཁོའི་ཤུགས་ཀྱང་ཟད་འདུག་པ་མ་ཟད།",
    "ཁྱེད་རང་ལ་འདོད་པ་ཡོད་ན།",
    "ཞེས་འདྲི་དུས་ངས་ལགས་འདུག་ཞུས་སྐབས།",
    "ཁྱེད་རང་གཟུགས་པོ་རིང་དུ་ཕྱིན་འདུག་ཅེས་གསུངས་པ་ལས་དེ་མིན་དེ་ཉིན་གང་ཡང་གསུངས་མ་བྱུང་།",
    "ཨེས་ཊིལ་ལཱ་མི་འདུག་ཅེས་བརྗོད་ཀྱི་འདུག་ཨུ་ཚུགས་གང་འཚམ་བརྒྱབ་འབྲས་ནང་ལ་བཏང་ནས་ང་ལ།",
    "དེ་ནས་ང་རང་རྒྱལ་སྒོ་ནས་ཐོན་ཚར་མ་ཐག་རྒྱལ་སྒོ་དེ་བརྒྱབ།",
    "བྷི་ཌི་ནི་ང་རང་དང་ལོ་མཉམ་ཡིན་པ་མ་ཟད་ཆུང་དུས་ནས་འདྲིས་ཆེན་པོ་ཡོད།",
    "ངས་དེ་ལྟར་བྱེད་འདོད་མི་འདུག་སྨྲས་པས།",
    "ཚུར་ཡོང་སྐབས་ཡ་མཚན་གྱི་རྣམ་འགྱུར་དང་བཅས་མི་ཁྱད་མཚར་ཞིག་འདུག་པ་དེས་ཇཱོ་དང་།",
    "ང་གཉིས་ལ་སྐད་ཆ་ཤོད་རྒྱུ་ཡོད་ལུགས་ཤོད་ཀྱིན་འདུག་ཟེར།",
    "ཁོ་རང་ལ་ཕན་ཆེད་དུ་འདི་ནས་དགོངས་འཁྲོལ་ཞུ་བར་བང་ཆེན་དུ་བཅར་བ་ཡིན།",
    "དེར་བརྟེན་ཁོ་དང་བྲལ་རྒྱུའི་དོན་དུ་ཁྱེད་རང་ལ་གང་དགོས་ཀྱི་འདུག་གམ།",
    "ཁྱེད་རང་ས་ཁང་ཕ་གཞིས་ཀྱི་བདག་པོ་ཞིག་ཆགས་ཀྱི་ཡོད་སྐོར་ཤོད་དགོས་ཞེས་ང་ལ་བཀའ་མངགས་བྱུང་བ་མ་ཟད།",
    "གལ་ཏེ་ཁྱེད་རང་ལ་ཁོ་སུ་ཡིན་ནམ་སྙམ་པའི་དོགས་པ་ཡོད་ཚེ།",
    "ངས་ཇཱོ་ལ་ལྟ་བཞིན་དུ་ལམ་སེང་ཡོང་ཐུབ་པ་འདུག་ཞུས་པས།",
    "སྐུ་ཞབས་ཇཱག་གྷར་གྱིས་ཁྱེད་རང་ཡོང་བ་ལ་ཐོག་མར་གྱོན་ཆས་གསར་པ་འགའ་ཤས་དགོས།",
    "བདུན་ཕྲག་འདིའི་རིང་ཁྱེད་རང་ལ་དངུལ་ཕྲན་བུ་དགོས་ཀྱི་ཡོད་འགྲོ།",
    "ད་ཁྱེད་རང་འདི་ནས་ག་ཚོད་མགྱོགས་པོ་ཐོན་ཐུབ་པ་བྱས་ན་ལེགས་པ་ཡོད།",
    "ཁྱེད་རང་ཡིན་ནམ།",
    "ངས་ཁྱེད་རང་མཇལ་འཕྲད་བྱུང་བའི་རྐྱེན་གྱིས་ང་ལ་རྒྱུ་དངོས་འཐོབ་རྒྱུའི་གོ་སྐབས་འདི་བྱུང་བས།",
    "ངས་ལགས་འདུག་ལྕམ་ཧབི་ཤཱམ།",
    "ང་རང་འཛམ་གླིང་ཡོངས་རྫོགས་ཀྱི་བདག་པོ་ཡིན་སྙམ་པའི་ཚོར་བ་ཞིག་སྐྱེས་བྱུང་།",
    "ཁྱེད་རང་སྐུ་ཞབས་ཕིབ་ཡིན་པས།",
    "སྐུ་ཞབས་ཇཱག་གྷར་ཁྱེད་རང་ལ་བསྒུགས་ནས་བཞུགས་ཡོད།",
    "མིག་ནག་པོ་འོད་དང་ལྡན་པ་ཞིག་འདུག་ང་གཉིས་མཉམ་དུ་འགྲོ་སྐབས།",
    "ད་ཁྱེད་རང་ལ་ང་དགོས་ཀྱི་འདུག་གམ།",
    "དབུ་སྐྲ་སྔོ་སྐྱ་ཅན་གྱི་མི་དྲག་རང་གཤིས་བཟང་པོ་ཞིག་འདུག་པ་དེའི་སར་ང་འཁྲིད་དེ།",
    "རང་གཤིས་སྤོབས་པ་ཆེན་པོ་དང་དོགས་པ་ཅན་ཞིག་འདུག་སི་ཊར་ཊོབ་ནི་མི་སྣང་བ་སྐྱིད་པོ།",
    "ངས་ཡ་མཚན་ཆེན་པོའི་སྒོ་ནས་ངའི་བསམ་པར་ཁྱེད་རང་ཁོང་ལ་མཉེས་པོ་འདུག་དྲན་བྱུང་།",
    "ཁྱེད་རང་ཐུག་ན་དགའ་པོ་ཡོང་རྒྱུ་ཡིན་སྐོར་འཁོད་འདུག་ཅེས་གསུངས།",
    "ཁྱེད་རང་བདེ་པོ་ཡིན་པས།",
    "གཞན་ལ་མཐོང་ཆུང་བྱེད་མཁན་ཞིག་ཡིན་པ་དྲན་གྱི་འདུག་གམ།",
    "ད་ལྟ་ཁྱད་མཚར་གྱི་ཚོར་བ་ཞིག་སྟེར་གྱི་འདུག་འོན་ཀྱང་དེ་ཉིན་ང་སྐྱིད་པོ་ཞེ་དྲགས་བྱུང་།",
    "ཁྱེད་ཀྱིས་ང་ལ་ངུ་ཤོར་བཅུག་པ་དྲན་པ་གསོས་ཀྱི་འདུག་གམ།",
    "ཨེས་ཊིལ་ལཱ་ཁོང་རང་ལན་ཌན་ལ་ཡོང་རྒྱུ་དང་།",
    "བདུན་རྗེས་མའི་གཟའ་ཟླ་བའི་ཕྱེད་ཡོལ་ཆུ་ཚོད་༣ པར་འདས་མཆོད་བྱ་རྒྱུ་ཡིན་སྐོར་འཁོད་འདུག་དེ་ནི་ངའི་མི་ཚེའི་ལམ་ཆེན་ནང་རོ་ཁང་ཞིག་སྒོ་ཕྱེས་པ་ཐོག་མ་ཡིན།",
    "ང་རང་བློ་ཕམ་དང་སེམས་སྡུག་ཆེན་པོ་ཞིག་བྱུང་།",
    "ཡི་གེ་དེ་ཨེས་ཊིལ་ལཱས་བཏང་འདུག་དེའི་ནང་འདི་འདྲ་འཁོད་གསལ།",
    "ངས་ཁྱེད་རང་ག་པར་འགྲོ་མཁན་ཡིན།",
    "སྐས་འཛེགས་ཀྱི་བཞུ་མར་ཚང་མ་ཤི་ནས་མི་འདུག་མཚན་གྱི་ཆུ་ཚོད་༡༡ པའི་སྟེང་དུ་ངས་དེབ་ཀྱི་ཁ་བརྒྱབ་སྐབས།",
    "སྐྲ་སྔོ་སྐྱ་རིང་པོ་ཡོད་པ་ཕལ་ཆེར་ལོ་དྲུག་ཅུ་ཙམ་ལ་སླེབས་པའི་མི་ཞིག་འདུག་པ་ངས་ངོ་མ་ཤེས།",
    "ནང་ལ་ཡོང་འདོད་འདུག་གམ།",
    "ང་ནང་ལ་ཡོང་འདོད་འདུག་ཅེས་ལན་བཏབ་བྱུང་།",
    "ཁོ་པས་སྐེ་དཀྲིས་རས་ཁྲ་ཁྲ་ཆེན་པོ་ཞིག་སྐེ་ལ་དཀྲིས་འདུག་ཁོ་ནི་མགོ་ཀླད་དམར་ཡིན་པ་དང་།",
    "མ་འགྲོ་སྔོན་ལ་གཅིག་འཐུང་དགོས་བསམ་གྱི་འདུག་ཅེས་ཟེར།",
    "གལ་ཏེ་ང་རང་ཕྱུག་པོར་གྱུར་བ་ཡིན་ན།",
    "ཁྱེད་རང་ཁོའི་ཁང་པ་དེར་བཞུགས།",
    "མི་ག་འདྲ་ཞིག་འདུག་གམ།",
    "སྐབས་དེར་བྱེད་རྒྱུ་ནི་གང་ཡང་མི་འདུག་ངས་མེ་བཏང་།",
    "ཁྱེད་རང་གྲུ་གཟིངས་ནང་ཡོད་དུས་མིང་ཞིག་འདུག་བསམ་བྱུང་།",
    "མདང་དགོང་ཁྱེད་རང་འདིར་ཡོང་སྐབས།",
    "ཁྱེད་རང་ལ་ལན་ཌན་དུ་ངོ་ཤེས་མཁན་ཡོད་དམ།",
    "ཁྱེད་རང་ཉེན་ཁ་ལས་ཐར་བའི་ཆེད་དུ་ཅི་ཞིག་བྱེད་དགོས་ཀྱི་ཡོད་མེད་དང་།",
    "ཁྱེད་རང་དུས་ཡུན་རིང་ལོས་ག་ཙམ་འདི་གར་སྡོད་ཀྱི་ཡོད་མེད་ང་ལ་ཤེས་འདོད་ཡོད།",
    "ངས་ཁྱེད་རང་ག་པར་སྡོད་ཀྱི་ཡིན་ནམ།",
    "ཧཱར་བྷཊ་ཕྱིར་མ་འཁོར་གོང་ལ་ཁོ་པ་གནས་སྡོད་བྱེད་སའི་ཁང་པ་ཁ་ཁུ་སིམ་པོ་ཞིག་ཐབས་ཤེས་བྱ་རྒྱུ་ལས་ཡག་ག་གཞན་མི་འདུག་སྙམ་པ་བྱུང་།",
    "དེར་སྟབས་ལེགས་པ་ཞིག་ལ་ངའི་ཨ་ཞང་པོརོ་ཝིསིའི་ཆེད་དུ་ཐོག་རྩེག་དེར་ཁང་པ་ཞིག་ཐོབ་བྱུང་།",
    "ཁྱེད་རང་སྐམ་པོ་དང་གདོང་སེར་པོར་གྱུར་འདུག་གྲོགས་པོ།",
    "ངས་ཁྱེད་རང་ལ་དེའི་སྐོར་ཆ་ཚང་ཞུས་ཆོག་ཅེས་བརྗོད།",
    "ང་རང་གསུམ་མེའི་མདུན་དུ་བསྡད་དེ།",
    "ཀོམ་པི་སོན་ནི་མི་དྲག་ཞིག་དང་ང་རང་ནི་ཕལ་པ་ཐ་ཤལ་ཞིག་ཡིན་པའི་ཕྱི་ཚུལ་གྱི་རྣམ་པ་མངོན་གྱི་འདུག་ཁུངས་སྐྱེལ་དང་དཔང་རྟགས་ར་སྤྲོད་བྱེད་སྐབས་ནག་ཉེས་མང་ཆེ་བ་ངའི་ཐོག་ཏུ་བབས།",
    "ང་རང་ལ་བསམ་བློ་རྩ་བ་ནས་མ་བཏང་བར་ཁོ་དྲུད་དེ།",
    "ཅེས་བྲིས་འདུག་ངས་དེབ་ཁ་བརྒྱབ་སྟེ་ཧཱར་བྷཊ་ལ་མགོ་གཡུག་ཙམ་བྱས།",
    "ངས་ཧཱར་བྷཊ་ལ་ང་ཕྱི་རྒྱལ་ལ་མ་ཕྱིན་གོང་ལ་ཨེས་ཊིལ་ལཱ་ཐེངས་གཅིག་ཐུག་དགོས་འདུག་བཤད།",
    "འཚིག་ཤུལ་དེ་ཚོ་ཉེན་ཚབས་ཆེ་བ་མི་འདུག་ང་ཁང་པ་དེར་བསྡད་ནས་དགོས་པ་ཆེ་བ་གང་ཡང་བྱེད་ཐུབ་ཀྱི་མེད་སྟབས།",
    "ང་རང་ནང་དུ་སླེབས་དུས་ཐང་ཆད་པ་དང་།",
    "ད་ངས་ཁྱེད་རང་ལ་གནས་ཚུལ་དེ་དག་གོ་ཐོས་བྱུང་ཚུལ་དང་།",
    "དེར་ཁྱེད་རང་མ་རྙེད་ཙང་།",
    "དེ་བཞིན་ཁོ་རང་ཉེན་ཁའི་ནང་ཚུད་ཡོད་པའི་སྐོར་འགྲེལ་བརྗོད་བྱས་ཙང་།",
    "ཁོས་ཀྱང་གལ་ཏེ་ཁྱེད་རང་ཁོ་པའི་མཉམ་དུ་ཕྱིན་ན།",
    "ངས་ཁྱེད་རང་གཉིས་འགྲོ་རྒྱུའི་གོ་སྐབས་ངེས་ཅན་ཞིག་རན་པ་དང་བརྡ་གཏོང་ཆོག་ཅེས་བརྗོད།",
    "དེའི་དོན་དུ་ཁོ་རང་ངོ་མ་འགྲོ་དགོས་ཀྱི་ཡོད་པ་མ་ཟད།",
    "ཧཱར་བྷཊ་ཀྱིས་ཁོ་པ་དེར་འདུག་གམ།",
    "ཁོས་ཟླ་གམ་རིང་པོ་ཞིག་གྱོན་ནས་ལག་ཕད་ནག་པོ་ཞིག་འཁྱེར་འདུག་ཁོ་གྲུ་ནང་དུ་སྡོད་སྐབས་ལག་པ་གཅིག་ངའི་དཔུང་པའི་སྟེང་དུ་བཞག་སྟེ་བརྗོད་གསལ།",
    "ཞེ་དྲགས་ཡག་པོ་བྱས་འདུག་བརྩེ་བའི་བུ།",
    "མགྲོན་ཁང་དེ་རྫོར་པོ་འདུག་ཀྱང་ཐབ་ཚང་ནང་དུ་མེ་ཡག་པོ་དང་།",
    "གྲུ་དེ་ས་ཆ་གཞན་ཞིག་ཏུ་བཞག་པ་ཡིན་འགྲོདེ་མིན་ན་ཁྱེད་ཚོས་མི་མཐོང་བ་མི་སྲིད།",
    "གཞན་གྱིས་དོ་སྣང་ཡོང་ཆེད་གྲུ་སྐྱ་བཞི་ཅན་གྱི་གྲུ་ཞིག་ཡར་རྒྱུགས་མར་རྒྱུགས་བྱེད་པ་དེ་གནས་ཚུལ་མི་ལེགས་པ་ཞིག་ཡིན་པ་ངའི་སེམས་ནས་བྲལ་གྱི་མི་འདུག་ཁང་མིག་གཞན་དེར་ཧཱར་བྷཊ་ཉལ་རྒྱུ་དང་།",
    "སྐྱ་བ་འཛིན་མཁན་གྱི་མི་བཞི་འདུག་གྲུའི་ཁ་ལོ་པ་གཅིག་དང་མི་གཞན་དག་དྲུག་པ་དེས།",
    "ཧཱར་བྷཊ་ནི་སྔོན་ནས་དེའི་ནང་དུ་འདུག་ཀྱང་།",
    "ང་རང་མེག་ཝིཅ་དང་འགྲོགས་ཏེ་ལན་ཌན་ལ་ལོག་ན་འགྲིག་པའི་དགོངས་བཞེས་ཀྱང་གནང་།",
    "ངས་ཇཱོ་ལ་གང་བྱས་པ་ལས་ལྷག་པའི་མི་ཞིག་འདུག་སྙམ་བྱུང་།",
    "ཁོ་ནི་འདས་གྲོངས་སུ་འགྱུར་རྒྱུ་ཡིན་པ་གཏན་འཁེལ་འདུག་ཀྱང་།",
    "གལ་ཏེ་ང་རང་མེད་ཀྱང་ངའི་བུ་དེ་མི་དྲག་ཅིག་ཆགས་ཐུབ་པ་མཐོང་བྱུང་།",
    "ད་ནི་ཁོའི་དབུགས་གཏོང་ལེན་བྱེད་རྒྱུ་ལ་ཡང་ཞེད་སྣང་སྐྱེ་དགོས་པ་ཆགས་འདུག་ཁོས་མིག་ངའི་གདོང་ལ་བལྟས་ནས་སྡོད་རྒྱུའི་འབད་རྩོལ་བྱེད་ཀྱི་འདུག་ཀྱང་།",
    "ཁོ་རང་གང་དུ་ཡོད་མེད་ཀྱང་ཤེས་ཀྱི་མི་འདུག་ཁོས་སྐད་ཤུགས་ཆུང་ངུའི་ངང་ནས་ཐེངས་གཅིག་ཕིབ།",
    "ཁྱེད་རང་འདི་གར་ཡོད་དམ།",
    "ང་རང་ཡང་འབྱུང་ཁམས་མི་བདེ་བའི་རྐྱེན་གྱིས་སྐབས་ཤིག་རིང་གནས་ཚུལ་གཞན་དག་གང་ཡང་མི་ཤེས་པ་ལྟ་བུར་གྱུར།",
    "བརྗོད་པར་ངས་བུ་ལོན་ག་ཚོད་འདུག་གམ།",
    "ད་ཁྱེད་རང་ཡོང་ན་ལེགས།",
    "ཟེར་བར་ངས་དེ་ནས་ཁྱེད་རང་རྟག་པར་འདིར་བསྡད་དམ།",
    "དེ་རྗེས་ཇཱོ་ཡིས་ང་རང་ཡག་པོ་དྲག་སྐྱེད་མ་བྱུང་བར་དུ་སྐད་ཆ་ཞེ་དྲག་མ་ཤོད་བརྗོད་པ་དང་།",
    "སང་ཉིན་དེར་ངས་ཇཱོ་ལ་ལྕམ་ཧབི་ཤཱམ་དྲག་སྐྱེད་བྱུང་འདུག་གམ།",
    "ཇཱོ་ངའི་ནང་དུ་ཡོང་སྟེ་ང་ལ་ད་ནངས་ཞོགས་པ་ནང་བཞིན་བདེ་ཐང་འདུག་གམ།",
    "ལམ་སེང་དུག་ལོག་གྱོན་ཏེ་ཇཱོ་ཡི་ཁྱིམ་དུ་ཕྱིན་པས་ཁོང་དེར་བསྡད་མི་འདུག་ལམ་སེང་ཞོགས་ཇ་འཐུང་སའི་རྒྱ་ཅོག་ཡོད་ས་དེར་ཕྱིན་པས།",
    "ཁྱེད་རང་ད་ཆ་དྲག་སྐྱེད་བྱུང་ཙང་ང་མེད་ན་སྟབས་བདེ་ཡོང་རྒྱུར་བརྟེན་ང་ཕྱིན་པ་ཡིན།",
    "ཟླ་བ་དྲུག་པའི་གནམ་གཤིས་ནི་ཡིད་དུ་འོང་བ་འདུག་ནམ་མཁའ་སྔོ་བསངས་ཅན་གྱི་དབུས་སུ།",
    "ཕལ་ཆེར་གོ་ཚོད་ཡིན་ཀྱང་ད་དུང་ཁུ་སིམ་མེར་འདུག་སེམས་ལ་ཞེད་སྣང་དང་བཅས་ཉེ་འགྲམ་དུ་སླེབས་དུས།",
    "ངས་ཇཱོ་ཁྱེད་རང་ཡང་ཡག་པོ་ཆགས་འདུག་ཅེས་བརྗོད་པར་ཇཱོ་ཡིས།",
    "ང་རང་ལ་དངོས་ཆས་གང་ཡོད་ཚང་མ་བཙོངས།",
    "ཁྱེད་རང་ཆང་ས་རྒྱག་དགོས།",
    "ཁྱེད་རང་ལ་བསམ་བློ་འཁོར་གྱི་འདུག་གམ།",
    "ཁྱེད་རང་ད་ལྟའང་ཕྱི་རྒྱལ་ལ་བཞུགས་ཀྱི་ཡོད་དམ།",
    "ངས་ཁྱེད་རང་ཡང་ཡང་བསམ་བློ་འཁོར་གྱི་འདུག་བརྗོད་པར་ངས་འདུག་གམ།",
    "དུས་ཀྱི་ངོ་བོ་དགག་དུས་ཀྱི་སྒྲུབ་བྱེད་དགག་པའོ།",
    "དུས་གསུམ་པོ་གཅིག་ལ་གཅིག་གནས་པ་མི་སྲིད་པའི་ཕྱིར་རོ་ མ་འོངས་པ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་ཡོད་པ་མ་ཡིན་ཏེ།",
    "མི་རྟག་པ་ཉིད་གང་ཡིན་པ་དེ་ཉིད་དངོས་པོ་དེ་དང་རང་བཞིན་གྱིས་གཅིག་ཡིན་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་ཀུན་ལའང་རང་བཞིན་གྱིས་གནས་པ་མེད་པར་འགྱུར་ཏེ།",
    "དྲན་པ་ཞེས་པ་ནི་འགགས་ཤིང་རང་བཞིན་མེད་པ་ལོག་པའི་དོན་ལ་དམིགས་ནས།",
    "འདུ་ཤེས་དེ་ཡང་རང་བཞིན་གྱིས་མེད་དེ།",
    "མཚན་ཉིད་ཀྱིས་ཀྱང་མཚན་གཞི་བུམ་པ་ནི་གང་དུ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པར་ཡོད་པ་མ་ཡིན་པ་༤༤བ་དེར་ནི།",
    "རྫས་བརྒྱད་ཚོགས་པ་ཡང་རང་བཞིན་གྱིས་གཅིག་ཉིད་དུ་མི་རིགས་ཏེ།",
    "རྡུལ་རྫས་བརྒྱད་པོ་ཕན་ཚུན་འདུས་ཀྱང་རང་བཞིན་གྱིས་གཅིག་ཏུ་མི་འགྱུར་བ་དེས་ན་སྟེ་དེའི་ཕྱིར་རོ།",
    "ཡོད་མེད་སྐྱེ་བ་བརྟགས་པ་དགག་ཐོག་མཐའ་བར་གསུམ་ལ་བརྟགས་པ་དགག་རང་གཞན་གཉིས་ལ་བརྟགས་པ་དགགརིམ་དང་ཅིག་ཅར་བརྟགས་པ་དགག་དུས་གསུམ་ལ་བརྟགས་ལ་དགག་པའོ།",
    "འཇིག་པ་དང་རང་བཞིན་གྱིས་ཐ་དད་པ་ཡིན་པའི་ཕྱིར།",
    "ཡང་རང་བཞིན་གྱིས་གཅིག་ཡིན་ན།"
  ]
}