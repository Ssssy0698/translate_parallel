    "ཞེས་གསུང་འདུག་པ་བཞིན་བསམ་བློ་ཐོངས།",
    "དེ་ནས་རིམ་གྱིས་ཉིན་མང་པོའི་བར་དུ་དབུ་ཕར་འདུལ་མཛོད་ཀྱི་སྟེང་ནས་གོ་རིགས་ཟུང་འབྲེལ་གྱི་རིགས་ལུང་ནམ་མཁའ་ནས་ཆར་བབས་པ་ལྟ་བུ་བྱུང་བ་ལ་ཁོ་རང་ཅུང་ཟད་ཀྱང་ཞུམ་པ་མེད་པར་རིགས་ལམ་ཕྱེ་སྟེ།",
    "དྲུག་ཅུ་པ་གཉིས་མགོན་ཁང་ནས་བསྔོ་བ་འདི་སྐུ་ཕྱོགས་ནས་གསུང་བཀོད་ཡིན་པས་དུས་བབས་ལོས་ཡིན།",
    "ང་རང་ལ་ཡང་བྲེལ་བ་ཡོད་སྟབས་མང་པོ་ཞུ་ལོང་མ་བྱུང་།",
    "སླར་ཡང་རང་ཉིད་ཀྱིས་སྒེར་མཇལ་ཞུས་པས།",
    "ཁྱེད་གདོང་གྲལ་མགོར་སྡོད་མཁན་གྱི་ཞབས་དྲུང་ཡིན་པས་འཇོག་བདེ་ཞིང་རྩོད་མེད་འདུག་གསུངས་པར།",
    "སྒོ་རུ་བཀྲ་ཤིས་རྒྱ་མཚོ་སོགས་བཅུ་ལྷག་ཙམ་བཞུགས་འདུག་པས་ཤིན་ཏུ་ཞེ་གཙང་བ་བྱུང་།",
    "བློ་རྩེ་གཏད་མི་ཤེས་པར་འདུག་ལགས་ཞུས་པར།",
    "དམ་ཅན་ལ་རིགས་མང་པོ་ཡོད་ཀྱང་རྒྱུད་པའི་དམ་ཅན་འདི་བསང་གསུར་ལ་ལྟོས་པ་མི་འདུག་འཆད་ཉན་དང་འགྲིག་ལམ་ལ་དགའ་བ།",
    "རོང་བོ་ཤ་བི་ནར་ལ་བསོད་སྙོམས་མཛད་དུས་དགུང་ཞིག་བཞུགས་སའི་ལྟག་ན་གུར་ཞིག་འདུག་པ་སུའི་ཡིན་དྲིས་པར་རོང་བོ་ནོ་མིན་ཧན་རང་ཡུལ་ལ་ཕེབས་ཡོད་ཟེར།",
    "རོང་བོ་ཚང་ལ་སྐུ་ཞབས་མཆོག་སྤྲུལ་འཁྲུངས་པའི་སྐད་ཆ་འདུག་གསུངས།",
    "མཆོག་སྤྲུལ་གྱི་དོན་སྐོར་ལ་ཐུགས་ཁུར་ཤིན་ཏུ་ཆེ་བས་མཚན་ལམ་དེ་འདྲ་མང་པོ་བྱུང་འདུག་ཀྱང་ཕལ་ཆེར་ཐུགས་བརྗེད་གནང་བའི་ཚུལ་དང་།",
    "ཁྱེད་འགྲུལ་བ་བྱིངས་མྱུར་དུ་འོང་མ་ཐུབ་ཀྱང་མི་སྣ་ངོ་བོ་གང་ཡིན་འཕྲལ་དུ་ཕེབས་དགོས་ཚུལ་ནན་ཏན་འདུག་དོན་ལྟར་དཀའ་བཅུ་དཔོན་གཡོག་བཞི།",
    "ཁོང་དཔོན་གཡོག་ལ་ཡང་ཡི་གེ་ཞིག་གནང་འདུག་པར།",
    "རྗེ་འཇམ་དབྱངས་བཞད་པ་དེ་ཉིད་རང་ལ་དུས་གསུམ་གྱི་རྒྱལ་བ་ལས་ཀྱང་ལྷག་པའི་བཀའ་དྲིན་ཅན་ཡིན་པས་འདི་སྐོར་ལ་གྲོགས་ལྡན་ཧུར་ཐག་གཏོང་རྩིས་ཡིན་ཞེས་ཕེབས་འདུག་ནང་སོས་ཀྱང་མགྱོགས་མྱུར་གྱི་ཆེད་དུ་ཁོང་རྣམས་ལ་རྟ་འུལ་ཉི་ཤུ་ཙམ་ཕུལ།",
    "ས་རྟ་འདི་ལོ་གྱ་དགུ་པ་ཡིན་འདུག་པས་མཆོག་སྤྲུལ་གདན་སར་ཕེབས་རྒྱུའི་སྐོར་སོགས་ལ་བལྟ་བ་ཨེ་ཡིན་༧ མ་ཀ་ཟ་༧ཏཾ་ཏཾ་ཀཾ་པ་དགོངས་ཐུགས་ངལ་ཆེ་བའི་གནས་ཚུལ་ཞུས།",
    "ལོ་བཅུ་སྐོར་ཙམ་གྱི་གོང་ནས་ཁྱེད་ཚོར་གེགས་ཆག་ཆེན་པོ་བྱུང་འདུག་ཨང་གསུངས།",
    "ཐུགས་བསམ་བཞེས་པས་སྐྱབས་མགོན་དག་ཞིང་ལ་ཕེབས་པའི་ལྕགས་ཕག་དེ་ལོ་གྱ་གསུམ་པ་ཡིན་འདུག་ཅིང་།",
    "ལོ་རྗེས་མའི་དཔྱིད་ཚུན་ཆད་ལ་ལྷ་སར་ཕེབས་ངེས་དང་བཞུགས་རྩིས་ཀྱང་འདུག་གསུང་བར་བརྟེན་སྒུག་སྡོད་མཛད་ཀྱང་མ་ཕེབས་པས་ཐོག་ཏུ་མ་ཁེལ་གསུངས།",
    "ཡ་མཚན་འདི་ལ་དགོངས་གཞི་ཞིག་འདུག་ཟེར།",
    "དགོན་ནང་ནས་འདུག་དགོས་དང་།",
    "དེ་སྐབས་སྔར་གྱི་ལ་བཙས་དང་གསོབ་བཞེངས་ཏེ་གཟི་མདངས་དང་ལྡན་པའི་གཟིམས་རྨིས་ཡང་བྱུང་འདུག་ལོ་མཇུག་ལ་བེག་ཙེ་གཏོར་སྒྲུབ་ཚུགས།",
    "ཡང་རྗེ་འདི་བྱང་ཤར་ཕྱོགས་ཀྱི་རི་ངོས་ཤིག་ན་བཞུགས་འདུག་པར།",
    "གཅིག་རྒྱུད་ཆེན་སྦྱིན་པ་དཔལ་བས་མཛད་པའི་ལེའུ་བཅུ་གཉིས་པ་ཡན་གྱི་འགྲེལ་པ་ཡིན་འདུག་རྒྱུད་པའི་ཁྲིའི་སྐབས་ལོ་བདུན་ནས་དགོངས་པ་ཞུས་ཏེ་ཚེ་མཚམས་འདོད་ཀྱང་དབུས་ལ་འགྲོ་དགོས་བྱུང་བ་རྒྱུད་ཊིཀ་སྔ་མ་དེ་དང་།",
    "མི་བཅུ་འདུག་པ་ཐམས་ཅད་གཏན་འཕུད་མཛད་པས་དེ་ནས་བཟུང་སྲོལ་ངན་རྒྱུན་ཆད།",
    "མཁར་སྒོ་བླངས་ཏེ་མཁར་ནང་ནས་རྒྱ་འདུག་ཚུལ་མེད་པ་བཟོས།",
    "གནས་ཚང་བཙལ་ཏེ་འདུག་རྒྱུ།",
    "མཚོ་འཁྱིལ་ཡན་ཆད་ནས་སྐམ་ལུག་བསད་མི་ཆོག་པ་སྔོན་གྱི་བཀས་བཅད་ཡིན་ཀྱང་ཅུང་ཟད་ཉམས་འདུག་པ་ཞིབ་ཚགས་དང་།",
    "དགོན་མཐར་ལྕགས་རི་ཞིག་ཡོད་ན་བཟང་བས་རག་རྒྱ་ལ་མ་ཎི་འཇོག་ཚུལ་བཀོད་པ་༧ སྐུ་ཞབས་ནས་གནང་བ་ཡིན་ཀྱང་འཕྲལ་དུ་དཀའ་གསུང་འདུག་དེ་བཞིན་དུ་ཚོགས་གཏམ་གལ་ཆེན་ཞིག་ཡིན་ཀྱང་གསེར་ཁྲི་རྣམ་གཉིས་ལ་ཞུ་སམ་ཚུན་ཆད་ཀྱི་སྒོ་ནས་དགོངས་བསྟུན་མ་ཞུས་པ་མེད་གསུངས་ལ།",
    "དོགས་པ་ཡོད་པ་རྣམས་ཀྱང་རང་བབས་སུ་བྲིས་ན་ངེད་ཀྱིས་དག་ཐེར་བྱས་ཆོག་ཐོག་མར་ཤོག་བུའི་ངོས་ལ་ཆ་ཡངས་པར་བྲིས་ཏེ་སྲུབ་འཇུག་བརྫང་ཆོག་པ་དགོས།",
    "སླར་སྐུ་བདེ་ཐག་ཚོད་ནས་འཆད་ཉན་སོགས་ཡུན་དུ་གནང་དགོས་པས་འཕྲལ་ལ་དེ་སྐོར་གྱི་ཐུགས་ཁྲལ་དང་མནོ་སེམས་མང་པོ་མ་བཞེས་པ་བཟང་གསུང་འདུག་ཡང་བསྐྱར་གནང་བ་ཞུས་ན་བྱས་པར།",
    "ཡང་ལྕགས་ཀྱི་སེར་བ་ཁུ་ཚུར་ཙམ་འབབ་པ་སོགས་ཀྱི་མཚན་ལམ་དང་།",
    "རྗེས་སོར་ཐུགས་གཏིང་ནས་མཉེས་པ་དཀའ་ཡང་གསུང་སེམས་ལ་བཟུང་ནས་རང་གར་མ་བསྡད་འདུག་དགོངས་པ་ཞིག་ཅིས་ཀྱང་བྱ་སྙམ་དགོས།",
    "བདར་ཤ་གཅོད་ཚུལ་ཁྱད་ཆེན་པོ་བཏོད་འདུག་དགོངས་ཏེ་ཇེ་མཉེས་སུ་འགྲོ་བ་ཞིག་གལ་ཆེ།",
    "སྔ་སོར་སྐྱབས་མགོན་གོང་མ་དབུས་ཕེབས་རྗེས་མའི་དུས་གདན་སར་ཕྱིར་ཆིབས་བསྒྱུར་སྐབས་འབྲས་སྤུངས་ཐབ་བསུའི་སྟེང་དུ་གནས་ཆུང་རང་བབས་བརྒྱབ་སྟེ་ཕེབས།",
    "མགོ་མཇུག་མེད་པའི་བྱ་བ་འདི་བཞིན་བྱེད་རྒྱུ་ཡིན་ན་ངེད་ཁྲི་ལ་འདུག་མི་ཐུབ་ཅེས་གསུང་ནན་ལྕི་བར་ཕེབས།",
