    "བཙན་བྱོལ་བོད་གཞུང་ནི་རྒྱལ་ཁབ་ཀྱི་གཞུང་ཞིག་ཡིན་ཤག་བྱེད་པ་དང་།",
    "བོད་མིར་བསྟོད་པ་ཙམ་གྱི་འདོད་ཚུལ་གླེང་བ་དེ་ཙམ་ནས་བོད་རང་བཙན་ཡོང་ཤག་བྱེད་མཁན་མང་པོ་ཡོད།",
    "གོང་ས་མཆོག་ཨ་རི་ནས་ལྡི་ལི་གསར་པར་ཞབས་འཁོད།",
    "དཔེ་ཅི་ལ་སྲིད་བསམ་སྟེ་བཀའ་ཟུར་སྟག་ལྷའི་མགྲོན་ཤག་ཏུ་བཅར་ཏེ་སྒོ་འབརྡ་བཏང་སྟེ་ནང་དུ་བསྐྱོད་པར།",
    "ཕྲན་གསུམ་གྱི་ཕྲག་པར་ཡོད་པའི་ལས་འགན་འདིའི་རྒྱབ་བརྟེན་ས་གཙོ་བོ་རྒྱ་གར་གཞུང་དང་།",
    "སྐབས་དེར་གོང་ས་མཆོག་༡༩༨༤ ཟླ་༩ ཚེས་༡༥ ཉིན་བཞུགས་སྒར་ནས་ཆིབས་ཐོན་གྱིས་ཨ་རིར་ཐེངས་གསུམ་པ་ཕེབས་བཞུགས་རིང་།",
    "རྒྱ་གར་སྲིད་འཛིན་མཆོག་ལ་ཐུགས་གསོའི་འཚམས་འདྲི་ཞུ་གནང་མཛད་པ་སོགས་དེབ་བཅུ་གཅིག་པ།",
    "བོད་ཀྱི་གོ་གནས་ཀྱང་གཅིག་ལྕོགས་གནང་དགོས་ཀྱི་མེད།",
    "དེ་དང་ཆབས་ཅིག་གཞིས་བྱེས་བོད་མི་ཚང་མས་བོད་དོན་བདེན་པའི་འཐབ་རྩོད་ལ་ནུས་ཤུགས་རྩལ་བཏོན་སྔར་ལྷག་དགོས་པའི་འབོད་བསྐུལ་ཤུགས་ཆེ་བྱ་རྒྱུ་ཡིན་ཞེས་བཀའ་ཤག་ལ་ཡིག་ངག་གཉིས་ཐོག་ནས་གསུང་པ་དང་།",
    "རྒྱ་ནག་ཏུ་སྐུ་ཚབ་ཐེངས་མང་གཏོང་གནང་མཛད་པ་བཅས་ལས།",
    "སེམས་ཁམས་ཆགས་ཚུལ་སོགས་རྒྱ་ནག་དང་ཐ་དད་ཡིན་པ་བསྲེས་ཀྱང་མི་འདྲེས་པར་ཚན་རིག་བདེན་དོན་གྱི་ཐག་བཅད་དེ་ཡོད་པ་འཛམ་གླིང་ཀུན་གསལ་ཞིག་ཡིན་པར་བརྟེན་སྲིད་བྱུས་ལྷུག་གཏོང་ཟེར་བ་དང་།",
    "ཕྱིར་ལོག་ཕེབས་མཚམས་བོད་དུ་བཞུགས་མི་དགོས་པར་པེ་ཅིང་དུ་བཞུགས་དགོས་ཞེས་སྔ་ཕྱི་མི་མཚུངས་པ་དང་།",
    "བོད་ཀྱི་བདག་པོ་བླ་ན་མེད་པ་གོང་ས་མཆོག་བོད་དུ་བཞུགས་མི་ཆོག་པའི་ཧམ་ཤེད་འདོད་ཚུལ་དམར་རྗེན་དུ་ཐོན་པ་དེས།",
    "དེ་ཤེས་པར་མཛོད།",
    "གོང་གསལ་གྱི་བདེན་དོན་ཁག་གཉིས་པོ་དེ་གཞི་འཛིན་ས་བྱས་ཏེ་ཡང་དག་པའི་སྲིད་བྱུས་འཛིན་དགོས།",
    "བོད་གཞུང་བཀའ་ཤག་དང་བཅས་པར་བོད་རང་བཙན་མ་དགོས་པ་ལྟ་བུ་དང་།",
    "བོད་མི་ཡོངས་ཀྱི་དངོས་དོན་འདོད་ཚུལ་ཇི་ཡོད་མ་མཁྱེན་པ་ལྟ་བུ་བརྗོད་པའི་རང་བཞིན་དུ་ཆགས་པ་ཁག་ཅིག་བྱུང་།",
    "རྒྱ་དམར་གྱིས་རང་བཙན་ཁས་ལེན་བྱེད་ཀྱི་མེད་སྟབས་བོད་གཞུང་ནས་རྒྱ་ནག་དང་འབྲེལ་བ་མཚམས་འཇོག་གནང་དགོས་པ།",
    "རང་བཞིན་གྱིས་གྲུབ་པའི་བོད་རྒྱལ་ཁབ་རང་བཙན་དུ་གཙང་མར་ཡོད་པ་དེས་བོད་རང་བཙན་དགོས་ལུགས་མེད་པ་དང་།",
    "རྒྱ་ནག་རི་པན་གྱི་དྲག་གནོན་བྱེད་རིང་བཅས་སུ་བོད་རྒྱལ་ཁབ་རང་བཞིན་གྱིས་རང་བཙན་གཙང་མར་གནས་ཡོད་པ་དང་།",
    "བོད་རང་བཙན་གྱི་གནས་སྟངས་ཇི་འདྲ་ཡིན་མིན་ལ་མ་ལྟོས་པར།",
    "ཤེས་ནས་བྱས་པ་ཞིག་ག་ལ་ཡིན།",
    "དང་མེས་འཚིག་མེར་གཏུགས་ཀྱི་འབྲེལ་ལམ་གནང་རྒྱུ་གལ་ཆེ་ཡིན་པ་དང་།",
    "བོད་རང་བཙན་དགོས་འདུན་མི་གསུངས་པར།",
    "བོད་ཆོལ་ཁ་གསུམ་གྱི་མི་མང་རྣམས་གཅིག་སྒྲིལ་དམ་གཙང་དུ་གནས་དགོས་པ་ནི་ཤིན་ཏུ་གལ་ཆེ།",
    "ཡིན་ནའང་གཅིག་སྒྲིལ་དམ་གཙང་ཞིག་ཡོང་དང་མི་ཡོང་ནི།",
    "བོད་རྒྱལ་ཁབ་རང་བཙན་གཙང་མར་གནས་པའི་སྐབས་སུ་ཆོལ་གསུམ་བོད་མི་རྣམས་གཅིག་གྱུར་མ་བྱས་ཏེ།",
    "སྔ་རབས་སུ་ཤིན་ཏུ་ནས་ཐ་དད་ཁེར་གཙང་དུ་གནས་པའི་བོད་དེ།",
    "དམག་མཁོའི་ཡོ་ཆས་གང་ལྟར་ཞི་དྲག་ལས་དོན་ཚང་མ་དྲག་པོའི་གནོན་ཤུགས་འོག་བོད་ཀྱི་ལས་དོན་གཙོ་བོ་བྱས་ཡོད་པ་དེ་ནི་གཏན་ཆགས་པའི་ངོ་བོ་དེ་ཙམ་མཚོན་མི་ཐུབ་པ་ཡིན།",
    "ཟད་མི་ཤེས་པ་གཞི་བརྟན་དམ་པར་འགྱུར་རྒྱུ་གདོན་མི་ཟ་བ་ཡིན།",
    "དུས་གཅིག་ཙམ་མིན་པར།",
    "གོང་ས་མཆོག་རྒྱ་ནག་པེ་ཅིང་དུ་བཞུགས་དང་།",
    "བོད་དུ་བཞུགས་ཟེར་བའི་ཐད་ལ།",
    "སེམས་ཐག་གཙང་བཅད་ངང་མེས་རྒྱལ་གོང་བུ་གཅིག་གྱུར་དང་།",
    "བློ་མཐུན་ཧུའུ་ཡའོ་པང་ནས་འགོ་ནས་མཇུག་བར་གཙོ་སྐྱོང་གནང་བ་དང་།",
    "ཇི་ལྟར་བྱས་ནས་བོད་ལ་ངོས་འཛིན་དེ་ལས་གཏིང་ཟབ་པ་དང་།",
    "གཅིག་ནི་བོད་ཀྱི་ཁྱད་པར་གྱི་རང་བཞིན་ཁོ་ནར་མཐོང་བ་ལས།",
    "བོད་དེ་རང་རྒྱལ་དུ་ཁྱད་པར་གྱི་རང་བཞིན་ཧ་ཅང་ཆེན་པོ་ཡོད་པའི་ས་ཆ་ཞིག་ཡིན་ཞིང་།",
    "བོད་ཀྱི་ཁྱད་པར་གྱི་རང་བཞིན་མཚོན་ཚུལ་གཙོ་བོ་གཤམ་གསལ།",
    "བོད་ཀྱི་ཁྱད་པར་གྱི་རང་བཞིན་དེ་རིགས་ནི།",
    "སླར་ཡང་ངོ་ལོག་ཟིང་འཁྲུག་ཆེན་པོ་ལངས་མི་ཡོང་ངམ་སྙམ་པ་བཅབཅས་སེམས་ཁྲལ་བྱེད་དགོས་དོན་མེད་ཅེས་སོགས་དང་།",
    "མི་དྲག་རིགས་ལ་དོན་མེད་ཉེས་འོག་ཏུ་བཏང་སྟེ་རྡུང་རྡེག་བྱས་པའི་མི་ངོ་ཡོད་པ་དང་།",
    "ལོ་བཅུ་ཕྲག་དུ་མའི་རིང་ལ་ཉམས་ཚོད་བླངས་པའི་ཐོག་ནས་ཁོང་རྣམ་གཉིས་ཀྱི་གནང་ལུགས་གནང་སྟངས་སྔ་ཕྱི་བར་གསུམ་དུ་ཡག་པོ་ཡིན་པ་དང་།",
    "ཏཱ་ལའི་ནི་ཁ་བྲལ་བྱ་བ་བྱས་ནས་ཕྱི་རྒྱལ་ལ་བྲོས་ཤིང་།",
    "ལྷག་པར་དུ་གོང་རིམ་མི་སྣ་དང་།",
    "བོད་མི་དམངས་ལ་དྲིན་ལན་ལོག་འཇལ་བྱས་པ་མ་ཟད།",
    "ཏང་ཕྱིའི་ཡོན་ཏན་ཅན་བློ་འདུན་པར་གདན་ཞུ་བཅས་བྱེད་དགོས་ཞེས་བཀོད་ཡོད།",
    "རང་ཉིད་ཀྱིས་ནོར་འཁྲུལ་ངོས་ཟིན་པ་ཡོ་བསྲང་བྱས་ཚེ་རྩད་གཅོད་དང་ཆད་གཅོད་བྱེད་མི་དགོས།",
