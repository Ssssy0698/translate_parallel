    "དོན་དུ་ཡིད་ཆེས་གཏན་ནས་མེད་པར།",
    "གྲལ་རིམ་གཙང་མ་ཞེས་པའི་ཞིང་འབྲོག་མི་དམངས་བྱིངས་རྣམས་ལ།",
    "ལོག་སྤྱོད་པ་ཟེར་བའི་མིང་འདོགས་བྱས་པ་རྣམས་ལ་མནར་གཅོད་བཏང་བ་དང་།",
    "བཙོན་འཇུག་བྱས་པའི་འོག་ནས་ཤི་བ་རྣམས་ཀྱི་ཤུལ་ལུས་ཡོད་པ་སེར་སྐྱ་ཡོངས་རྫོགས་མ་གྲོས་བསམ་པ་གཅིག་མཐུན་དུ་ཡོད་པ་ནི།",
    "བོད་རང་བཙན་གཙང་མ་ཞིག་མ་བྱུང་བར་རྒྱ་དམར་ལ་ཡིད་ཆེས་སྐྱེ་ཐབས་མེད་པ།",
    "བོད་མི་དམར་གསོད་བྱེད་པའི་ལག་དམར་མ་ཡིན་པར།",
    "འགྲོ་སྡོད་ཀྱི་འཐབ་ལེན་འབྲེལ་འགྲུལ་ཐུབ་མཁན་རྣམས་ནས་སྔོན་བྱས་ལ་འགྱོད་སེམས་དང་བློ་ཕམ་གྱིས་རྒྱ་དམར་ལ་ཁོང་ཁྲོ་ཆེ་བ་དང་།",
    "རྒྱ་དམར་ནི་དེ་འདྲ་མིན་པར་མི་སྲོག་ལ་ཕངས་སེམས་ཡེ་ནས་མེད་པ་དང་།",
    "ད་དུང་བོད་མིའི་མི་སྲོག་ལ་ཕངས་སེམས་དེ་བབས་ཀྱང་མེད་པ་ཡིན་སྟབས་ཆབ་སྲིད་ལས་འགུལ་བྱས་ན་དྲག་གནོན་བྱ་རྒྱུ་རང་ཡིན་པས་བོད་མི་རྣམས་ཀྱིས་སྙུགས་བསྲིང་པའི་ཡུལ་མེད།",
    "གྲལ་རིམ་གྱི་ཉེས་ཞྭ་གཡོག་པའི་འོག་བཅས་སུ་བསྡད་དགོས་ཐུག་པའི་འཕྲོས་ལྷགས་རྣམས་ནི།",
    "བོད་མི་མང་ཁ་ལོ་བྱེད་པའི་ནུས་པ་ཤུགས་ཆེ་བ་དེ་ཚོར་ཐུག་དེ་ཚོའི་བསམ་བློའི་ནང་་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་སླར་བོད་དུ་ཕེབས་པ་དང་།",
    "བོད་རང་བཙན་བསྒུག་ནས་བསྡད་རྒྱུ་ལས།",
    "༡༩༨༥ ལོ་ཤར་བ་དང་གོང་ས་མཆོག་ལྡི་ལི་བརྒྱུད་རྡོར་གདན་ནས་བཞུགས་སྒར་དུ་ཞབས་སོར་འཁོད།",
    "ཉིན་གསུམ་གྱི་རིང་རབ་བྱུང་དང་བསྙེན་རྫོགས་ཀྱི་བསླབ་སྡོམ་བཀའ་དྲིན་སྩལ་ཏེ་རྒྱལ་བསྟན་རྒྱས་པར་མཛད།",
    "དགུང་གསར་ཚེས་༣ ཉིན་གོང་ས་མཆོག་གཙུག་ལག་ཁང་དུ་རྣམ་གྲྭ་ཚོགས་ཡོངས་དང་ལྷན་དུ་གཟབ་གསོལ་ལ་ཆིབས་བསྒྱུར་གནང་བ་དང་།",
    "གཞུང་དམངས་སེར་སྐྱ་རྣམས་ནས་ལྷ་རྒྱལ་རིར་བསྟན་སྲུང་དམར་ནག་གཉིས་ཀྱི་རྟེན་མཁར་མདུན་བསང་གསོལ་ཟབ་རྒྱས་ཐོག་དར་ཆེན་བསླངས་ཏེ་སྐུ་ཁམས་དང་མཐུན་པའི་དར་ལྡི་བར་སྣང་གང་བ་དེ་བརྒྱངས་ཐོག་ཀི་བསྭོའི་སྒྲས་ཁེངས་པ་སོགས་བྱས་ཏེ་བདེ་སྐྱིད་ལ་རོལ།",
    "བོད་མི་བཙན་བྱོལ་ལ་གྱར་བ་ཚོས་ཧུར་ཐག་བྱས་པའི་མཐའ་བསྡོམས་ལ།",
    "བོད་པར་གོ་སྐབས་བྱུང་ན་བྱེད་ཐུབ་ཀྱི་ཡོད་པ་དང་།",
    "བོད་པར་འཇོན་ཐང་ཡོད་པ།",
    "ལོག་འཚོ་ལ་བརྟེན་ན་མི་འགྲིགས་པར་གསུངས་ཡོད།",
    "མི་བྱེ་བྲག་པ་གཅིག་ལ་བཤུ་གཞོག་གཏོང་མཁན་གྱི་བྲན་གཡོག་ལམ་ལུགས་དེ་མ་འོས་པ་ཞིག་ཡིན་པར་བརྟེན།",
    "བཀའ་བསྡུར་གནང་བའི་སྐབས་ཤིན་ཏུ་གཟབ་ནན་གནང་དགོས་ཤིང་།",
    "བག་ཕེབས་གྱུར་ན་ཕྱི་ནས་བསླུ།",
    "ཉ་རྣམས་གསོད་པར་བྱེད་ལ་ལྟོས།",
    "རྒྱ་དམར་གྱིས་བོད་འདི་རྩ་ཟོས་བྱས་ཏེ།",
    "གོང་ས་མཆོག་རྒྱ་ནག་ཏུ་ཕེབས་བཞུགས་ཆེད་དང་།",
    "འཕགས་བོད་མཛའ་མཐུན་ཁྲི་ལོར་བརྟན་པར་ཤོག་ཅེས་སོགས་འབོད་ཚིག་ཁག་མང་བསྒྲགས་པ་དང་།",
    "ཕྱི་དྲོར་བཞུགས་སྒར་ནས་ཐོན་ནས་ཕྱི་ཉིན་ལྡི་ལིར་འབྱོར།",
    "ཡང་རྒྱ་གར་གསང་ལས་སྤྱི་ཁྱབ་ཟུར་པ་དེ་སྐབས་ཕྱི་སྲིད་ཀྱི་བཀའ་སློབ་ཕུལ་མཁན་སྐུ་ཞབས་ཀོའུ་བཅས་དང་མཇལ་འཕྲད་གནང་།",
    "སྐབས་དེ་དུས་ནང་སྲིད་དྲུང་ཆེ་ཆུང་གཉིས་ཀྱང་ཕེབས་ཡོད།",
