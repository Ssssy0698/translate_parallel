    "མཐོ་དམན་བར་གསུམ་གྱི་འཚོ་བ་དང་གནས་སྟངས་ཇེ་ལེགས་སུ་གཏོང་བར་ཕྱོགས་ཀུན་ནས་འབད་བརྩོན་མཛད་པར་མ་ཟད།",
    "ཆབ་སྲིད་ཀྱི་ལས་དོན་ཆེ་ཕྲ་ཀུན་ལ་དོ་སྣང་ཆེན་པོ་གནང་མཁན་ཞིག་ཡིན་པས།",
    "བཙན་པོ་རང་ཉིད་ཀྱི་སེམས་ཤུགས་དང་སྟོབས་ཤུགས་རྐྱང་པ་ལ་བརྟེན་ནས་ཡོང་མི་ཐུབ་པར།",
    "མནོན་འདྲོན་པོ་སོགས་ལ་གསང་བའི་སྒོ་ནས་འབྲེལ་བ་བསྐྱར་འཛུགས་གནང་བར་མ་ཟད།",
    "གསང་བའི་མི་སྣའི་བར་ཕན་ཚུན་ཐུག་འཕྲད་ལན་མང་བྱས་ཏེ།",
    "འཕན་པོ་ནི་ལྷ་སའི་བྱང་ངོས་སུ་ཡོད་པའི་ཡུལ་ཞིག་ཡིན།",
    "ཐོག་མའི་གྲོས་བསྡུར་སྐབས་དབའ་དབྱི་ཚབ་སོགས་ཀྱི་བསམ་པར།",
    "ལྷག་བསམ་རྣམ་དག་ཡིད་ཆེས་བློ་འགེལ་ཆ་ཚང་བྱེད་ཀྱི་ཡོད་པར་མ་ཟད།",
    "རྣམ་དཔྱོད་དང་ཆབ་སྲིད་ཀྱི་འཇོན་ཐང་ལྡན་པ་ཞིག་ཡིན་པར་ཡིད་ཆེས་གཙང་མ་བྱུང་སྟེ།",
    "ཡིད་ཆེས་གཙང་མ།",
    "ཟིང་པོ་རྗེར་བོད་ཀྱི་དཔུང་དམག་ལ་ཕྱིར་རྒོལ་བྱེད་པའི་གྲ་སྒྲིག་གང་ཡང་མེད་པར་མ་ཟད།",
    "བོད་ཀྱི་མངའ་འོག་ཏུ་བཅུག་པར་མ་ཟད།",
    "ལས་དོན་ལས་སླ་པོ་ཞིག་མིན་པ་བཙན་པོ་རང་ཉིད་ཀྱིས་ཀྱང་གསལ་པོར་མཁྱེན་གྱི་ཡོད།",
    "དེར་བརྟེན་བཙན་པོ་གནམ་རི་སྲོང་བཙན་རང་ཉིད་ཀྱིས་དངོས་སུ་ཐུགས་འགན་བཞེས་ཏེ།",
    "བཙན་པོ་འདིས་བོད་ཀྱི་ཆབ་སྲིད་དང་མངའ་ཐང་རྒྱ་སྐྱེད་ཀྱི་དོན་དུ་འབད་བརྩོན་གནང་བ་ཙམ་མིན་པར།",
    "ཉམས་མྱོང་སྣ་ཚོགས་ཐོབ་ཀྱི་ཡོད་པར་མ་ཟད།",
    "བཙན་པོ་གནམ་རི་སྲོང་བཙན་གྱིས་ཚྭ་ནི་ཟས་ལ་རོ་བཅུད་ཁྱད་པར་བ་འབྱིན་པའི་རྫས་དམིགས་བསལ་བ་ཞིག་ཡིན་པ་མཁྱེན་རྟོགས་བྱུང་ཡོད་པར་མ་ཟད།",
    "མཚོ་འགྲམ་དེར་ཐོག་མར་རྟ་འདོ་བ་ཅང་ཤེས་རྙེད་པས་བཏུལ་ཏེ་བཙན་པོ་རང་ཉིད་ཀྱི་ཆིབས་པ་བྱས་ཤིང་།",
    "བཙན་པོ་གནམ་རི་སྲོང་བཙན་ས་ཕྱོགས་གང་དུ་ཕེབས་ཀྱང་།",
    "རྒྱུན་དུ་རྟ་འདོ་བ་ཅང་ཤེས་ལ་བཅིབས་ནས་ཕེབས་ཀྱི་ཡོད།",
    "རི་དྭགས་རྔོན་བཞིན་རི་ལུང་མང་པོ་བརྒྱུད་ནས་ཕེབས།",
    "ལམ་སང་ལྕགས་མདའ་གཞུ་ལ་བཀང་སྟེ་ཤག་སྒྲ་དང་བཅས་འཕངས་པ་ན།",
    "དེར་བརྟེན་ཕྱིས་སུ་བཙན་པོས་འབྲོང་ཤ་བཙོས་ནས་བཞེས་པའི་སྐབས།",
    "དེའི་གནས་ལུགས་དང་རྒྱུ་རྐྱེན་ལ་འཚོལ་ཞིབ་བྱེད་པར་ཤིན་ཏུ་དགའ་ཞིང་།",
    "ཤ་ཐོག་ནས་བྲོ་བ་ཁྱད་པར་ཅན་དེ་མྱོང་ཙམ་གྱིས་ཆོག་ཤེས་མ་མཛད་པར།",
    "སྔོན་མ་འབྲོང་ཤ་ལྷུང་སའི་ས་གནས་དེར་ཞིབ་འཇུག་གནང་བར་ཕེབས།",
    "སྲང་བཅས་གསར་བཟོ་གནང་ཡོད་པར་མ་ཟད།",
    "འབངས་མི་སེར་གྱི་བདེ་དོན་ཐོག་དམིགས་བསལ་ཐུགས་ཁུར་གནང་མཁན་གྱི་བཙན་པོ་བྱམས་བརྩེ་ཅན་ཞིག་ཡིན།",
    "དབའ་བུ་ཚབ་བཅས་ཀྱིས་གྲོས་བསྡུར་གནང་བཞིན་པ།",
    "སྐུ་ཚེ་ཧྲིལ་པོར་འབད་བརྩོན་ལྷོད་མེད་གནང་ཡང་།",
    "མངའ་ཐང་རྒྱ་སྐྱེད་གནང་བའི་ལས་དོན་གྱི་བརྒྱུད་རིམ་ནང་།",
    "དགྲ་འཁོན་རྩོད་རྒྱུའི་གོ་སྐབས་ལ་ངང་སྒུག་བྱེད་མཁན་མང་པོ་ཞིག་ཡོད་པར་མ་ཟད།",
    "ཐ་ན་སྐུ་སྲོག་ཚུན་ཆད་ལ་ཉེན་ཁ་ཡོད་པ་བཙན་པོ་རང་ཉིད་ཀྱིས་གསལ་པོ་མཁྱེན་གྱི་ཡོད་ཀྱང་།",
    "འདི་ནི་ཁོ་ཚོས་ལས་དོན་གལ་ཆེན་པོ་ཞིག་ལ་ཚོར་མི་སྲིད་པར་མ་ཟད།",
    "དུས་ཡུན་སྐད་ཅིག་ཙམ་ཡང་བཟོད་བསྲན་མི་ཐུབ་པར།",
    "བཙན་པོས་རང་དོན་ཁོག་ཏུ་འཇུག་མཁན་གྱི་བློན་ངན་ཚོར་མཐའ་གཅིག་ཏུ་རྒོལ་བ་བྱས་ཏེ།",
    "སྤྱི་པ་ལ་ཕན་པའི་ལས་དོན་གང་འདྲ་ཞིག་བྱས་ཡོད་ཀྱང་འདྲ།",
    "ཡབ་ཀྱི་སྐུ་ཚེའི་མཇུག་ཏུ་གཅིག་གྱུར་གྱི་རྣམ་པ་ཁ་འཐོར་དུ་ཕྱིན་པར་མ་ཟད།",
    "སྔར་ལས་ཀྱང་སྟོབས་ཤུགས་ལྡན་པར་བྱས་ཏེ།",
    "སྲོང་བཙན་སྒམ་པོས་བོད་ཀྱི་ཆབ་སྲིད་ཀྱི་ལས་དོན་རྐྱང་པ་མ་ཡིན་པར།",
    "ཆ་རྐྱེན་ཡང་འཐུས་སྒོ་ཚང་བ་བསྐྲུན་པར་གནང་།",
    "རྒྱལ་པོའི་ལུགས་ཀྱི་མཛད་བྱུས་ཀུན་ལ་བྱང་ཆ་ལྡན་པར་མཛད་ཡོད།",
    "ཡབ་གནམ་རི་སྲོང་བཙན་གྱི་བསམ་པར།",
    "ཡབ་གནམ་རི་སྲོང་བཙན་ལ་བཙན་དུག་ཕུལ་ཏེ་སྐུ་བཀྲོངས་པར་མ་ཟད།",
    "བོད་རྒྱལ་ཁབ་ཆེན་པོའི་འཕེལ་རྒྱས་ཀྱི་མདུན་ལམ་ལ་བཀག་འགོག་བྱས་པ་ནི།",
    "སྐྱོ་ཞུམ་དང་བག་འཁུམས་མེད་པར་ཡབ་ཀྱི་འདས་མཆོད་ཚུལ་བཞིན་བསྒྲུབས་པར་མ་ཟད།",
    "བོད་ཀྱི་ལུགས་གཉིས་ཀྱི་བྱ་གཞག་མཐའ་དག་ཡབ་ཀྱི་སྐུ་དུས་ལས་ཀྱང་རྒྱ་སྐྱེད་བྱས་ཏེ།",
    "སྟོབས་ཤགས་དང་མངའ་ཐང་གང་ཅིའི་ཐད་ནས་གཞན་གྱིས་འགྲན་ཟླ་མེད་པ་ཞིག་བྱ་བ་ནི།",
    "ལས་སླ་པོས་སྒྲུབ་ཐུབ་པ་ཞིག་མིན་པ་གསལ་པོ་མཁྱེན་གྱི་ཡོད་ཀྱང་།",
    "འོན་ཀྱང་བཙན་པོ་སྲོང་བཙན་གྱི་དགོངས་པར།",
    "རྒྱལ་ཁབ་ཀྱི་སྟོབས་ཤགས་མུ་མཐུད་ཉམས་རྒུད་དུ་འགྲོ་རྒྱུ་གཏན་འཁེལ་ཡིན་པར་བརྟེན།",
    "བཙན་པོ་སྲོང་བཙན་རྒྱལ་ཁྲིར་འཁོད་པའི་རྗེས་སུ་ནུས་ཤགས་གང་འཚམ་བརྟན་པོ་ཆགས་པ་ན།",
    "ཡབ་དགྲོང་མཁན་གྱི་ལག་དམར་གཏེ་པོ་རྣམས་རྩ་རྫོགས་བྱས་ཏེ།",
    "དྭགས་ཀོང་མྱང་གསུམ་གྱིས་བོད་ཀྱི་བཙན་པོ་གནམ་རི་སྲོང་བཙན་ལ་ངོ་ལོག་བྱས་ཏེ།",
    "བོད་ཀྱི་དཔུང་དམག་ཤིན་ཏུ་སྟོབས་ཤགས་ཆེན་པོ་ཡོད་པའི་མཚོན་རྟགས་ཤིག་ཡིན་ལ།",
    "རང་བཞིན་གྱིས་དངངས་སྐྲག་ཡོང་དགོས་པའི་གཞི་རྩ་ཞིག་ཏུ་གྱུར་ཡོད་པར་མ་ཟད།",
    "བལ་ཡུལ་རྒྱལ་ཁམས་བོད་ཀྱི་མངའ་ཁོངས་སུ་བསྡུས་པར་མ་ཟད།",
    "བལ་ཡུལ་ནི་བོད་ཀྱི་བཙན་པོའི་དབྱར་ཁའི་བཞུགས་གནས་བྱས་ཏེ།",
    "རྒྱ་ཡི་སློབ་དཔོན་ཆེན་པོ་ཐང་སན་ཙང་དང་མཇལ་འཕྲད་བྱས་ཤིང་།",
    "དེར་བརྟེན་བློན་པོ་ཨརྫུ་ན་ཡི་བསམ་པར།",
    "གདུག་རྩུབ་ཅན་གྱི་བྱ་བ་སྣ་ཚོགས་བྱས་ཤིང་།",
    "མཚམས་ཤིག་ལ་བློན་པོ་ཨརྫུ་ན་ཡིས་ངང་སྒུག་བྱེད་མ་ཐུབ་པར།",
    "བལ་ཡུལ་དུ་བཞུགས་པའི་བོད་ཀྱི་རྒྱལ་པོ་སྲོང་བཙན་སྒམ་པོ་ལ་སྐྱབས་བཅོལ་ཞུས།",
    "རོགས་རམ་ཅི་བྱས་རྒྱའི་གོང་མ་ཐང་ཐེ་ཙུང་ལ་ཞིབ་ཏུ་སྙན་སེང་ཞུས།",
    "བོད་ཀྱི་དྲག་པོའི་སྟོབས་ཤགས་སྔར་ལས་ཀྱང་འཕེལ་རྒྱས་སུ་འགྲོ་བར་ནུས་པ་ངེས་ཅན་ཐོན་པ་བྱུང་ཡོད་ལ།",
    "བོད་ཀྱི་དྲག་པོའི་སྟོབས་ཤགས་ནི།",
    "བོད་ཀྱི་མཐའི་ཡུལ་གྲུ་མང་པོ་ཞིག་ཀྱང་དམག་འཐབ་བྱ་མ་དགོས་པར།",
    "སྤྱིར་བཙན་པོ་སྲོང་བཙན་སྒམ་པོས་བོད་ཀྱི་དྲག་པོའི་སྟོབས་ཤགས་རྒྱ་སྐྱེད་བྱ་བར་ཐུགས་སྣང་ཆེན་པོ་མཛད་ཀྱི་ཡོད་ཀྱང་།",
    "རྒྱལ་ཁ་ལོན་ཐབས་གནང་བར་གྲུབ་འབྲས་རྒྱ་ཆེན་པོ་ཐོབ་ཡོད།",
    "ཐོག་མར་དམག་འཐབ་ཀྱི་བྱ་བ་མ་བརྩམས་པར་རྒྱལ་ཁབ་གཉིས་ཀྱི་བར་གཉེན་གྱི་འབྲེལ་བ་བཙུགས་ཏེ།",
    "ཞང་ཞུང་རྒྱལ་པོ་ལི་མིག་རྐྱ་བྱ་བའི་བསམ་པ་བཙན་པོ་རང་ཕྱོགས་སུ་འགུགས་ཐབས་བྱས་ཤིང་།",
    "ཞང་ཞུང་རྒྱལ་པོའི་བསམ་པར་བོད་ཕྱོགས་ནས་དམག་དྲངས་ཡོང་བའི་དོགས་པ་གཏན་ནས་མེད་པར།",
    "སུམ་པ་ལྟ་བུའི་རྒྱལ་ཕྲན་ཆུང་བའི་རིགས་མང་པོ་ཞིག་ལ་དམག་དངོས་སུ་འདྲེན་མ་དགོས་པར།",
    "བཙན་པོས་དངོས་སུ་དཔུང་སྣེ་དྲངས་ནས་འ་ཞ་བོད་ཀྱི་མངའ་འོག་ཏུ་བླངས་པར་མ་ཟད།",
    "བོད་ཀྱི་རྒྱལ་ས་ལྷ་སར་སྤོས། ། སྤྱིར་ཡབ་མེས་གཉའ་ཁྲི་བཙན་པོ་ནས་བཟུང་སྟེ།",
    "ཡར་ལུང་ལྷོ་ཁའི་རྒྱུད་དུ་གནས་བཅས་ནས་བཞུགས་ཡོད་ཀྱང་།",
    "དུ་བྱས་ན་གྲུ་འཛིན་ཞེས་ཟེར་བ་ཡིན།",
    "ཀོང་ཇོ་ལ་ཆེ་བ་འདོན་པའི་དོན་དུ་སྐུ་མཁར་ཞིག་བཞེངས་དགོས་གསུངས་ཏེ།",
    "བོད་ཀྱི་རྒྱལ་ས་ཡར་ཀླུངས་གཙང་པོའི་ལྷོ་རྒྱུད་ནས་བྱང་རྒྱུད་ཀྱི་དམར་པོའི་རི་ལ་སྤོས་ཏེ།",
    "ནུབ་ཕྱོགས་བཅས་ལ་རིམ་གྱིས་རྒྱ་སྐྱེད་གནང་བས།",
    "ལྷག་པར་དུ་བོད་ཀྱི་རྒྱལ་ས་ལྷ་སར་སྤོས་ན།",
    "བཟོ་བཀོད་བཅས་ཀྱི་ཐོག་ནས་བོད་ཀྱི་རྒྱལ་པོ་ཇི་ཙམ་སྟོབས་ཤགས་ཆེན་པོར་གྱུར་པའི་གནས་སྟངས་གསལ་པོ་ཤེས་ཐུབ་ཀྱི་ཡོད།",
    "སྐབས་དེ་དག་ཏུ་བོད་ཀྱི་སྟོབས་ཤགས་ནི།",
    "བོད་སྟོབས་ཤགས་ཆེན་པོ་ཆགས་དགོས་པའི་རྒྱུ་རྐྱེན་གཞན་པ་ཞིག་ནི་བོད་ཀྱི་བློན་པོ་འཛིན་འཛིན་བྱ་བའི་སྐད་ཆའི་ཐོག་ནས་གསལ་པོར་ཤེས་ཐུབ་ཀྱི་ཡོད།",
    "སྟོབས་ཤགས་དང་མཁྱེན་རྒྱ་རྗེ་སྔ་མ་ལས་ཀྱང་ལྷག་པ་ཙམ་བཞུགས།",
    "དཀའ་ངལ་ཡོངས་རྫོགས་ལ་གདོང་ལེན་གནང་སྟེ།",
    "དེར་བརྟེན་སྐབས་ཤིག་ནས་བློན་པོ་མང་ཆེ་བར་བཙན་པོའི་དགོངས་ཚུལ་གྱི་ཤགས་རྐྱེན་ཐེབས་ཏེ།",
    "རྒྱལ་པོ་སྲོང་བཙན་གྱི་དགོངས་གཞི་འགྲུབ་པར་ཕན་ནུས་ངེས་ཅན་ཐོན་རྒྱུ་ཡིན་པ་སྨོས་མ་དགོས་ལ།",
    "རྒྱུན་དུ་ཐུགས་སྣང་ཆེན་པོ་མཛད་ཀྱི་ཡོད་པར་མ་ཟད།",
    "བྱ་བ་འདི་སྟབས་བདེ་པོ་དང་ལས་སླ་པོ་ཞིག་མིན་པ་གསལ་པོ་མཁྱེན་གྱི་ཡོད་སྟབས།",
    "སྐབས་ཤིག་ལ་བཙན་པོ་སྲོང་བཙན་གྱི་དགོངས་པར།",
    "རྒྱ་གར་བའི་ལེགས་པར་སྦྱར་བའི་ཡི་གེ་ནི།",
    "ཡིག་རིགས་གཞན་ལས་ཀྱང་ཁྱད་པར་དུ་འཕགས་པ་ཞིག་ཡིན་པ་མཁྱེན་རྟོགས་བྱུང་སྟེ།",
    "རྒྱ་གར་ལ་ཡི་གེ་སློབ་ཏུ་ཆེད་གཏོང་གནང་།",
    "ཡིན་ནའང་ཐེངས་དང་པོའི་ཕམ་ཁ་དེས་བཙན་པོ་སྲོང་བཙན་གྱི་ཐུགས་མ་ཕམ་པར།",
    "ཐོན་མིའི་བསམ་པར།",
    "དཀའ་ངལ་གང་ལ་ཡང་མི་འཛེམས་པར་ཐེ་ཚོམ་མེད་པར་འགྲོ་རྒྱུ་ཡིན་པའི་བློ་ཐག་བཅད།",
    "དཀའ་ངལ་མཐའ་དག་ལ་གདོང་ལེན་བྱས་ཏེ་རྒྱ་གར་དུ་ཕྱིན་པར་མ་ཟད།",
    "ཞེས་སོགས་གསུངས་ཏེ་བསྔགས་བརྗོད་དང་སྐུལ་མ་མཛད།",
    "བཙན་པོས་ཆེད་དུ་མངགས་པའི་བསུ་མ་དང་པོ་རྣམས་ཀྱིས་ཕེབས་བསུ་ཞུས་ཤིང་།",
    "དེ་ནས་རིམ་གྱིས་ཕྱིན་ཏེ་ལྷ་སར་འབྱོར་བའི་སྐབས།",
    "བོད་ཀྱི་བློན་ཆེན་རྣམས་ཀྱིས་ཕེབས་བསུ་རྒྱ་ཆེའི་སྒོ་ནས་ཐོན་མི་སཾ་བྷོ་ཊ་ལ་ཆེ་མཐོང་ཞུས།",
    "བཙན་པོ་སྲོང་བཙན་སྒམ་པོའི་སྐུ་མདུན་དུ་མཇལ་ཁར་བཅར།",
    "དབྱངས་གསལ་སོ་བཞི་ཅན་གྱི་བོད་ཀྱི་ཡིག་སྲོལ་གསར་གཏོད་མཛད་པར་མ་ཟད།",
    "མི་ཙམ་མ་ཡིན་པར་དུད་འགྲོ་ཁྱི་ཕག་ཚུན་ཆད་ཀྱིས་སྒྲུབ་ནུས་པའི་བྱ་བ་ཞིག་ཡིན་པས།",
    "བྱ་བ་བཟང་ངན་སྣ་ཚོགས་དང་འཕྲད་ངེས་པ་ཡིན་པའི་གནས་ལུགས་དེ་བཙན་པོ་སྲོང་བཙན་གྱིས་གསལ་པོར་མཁྱེན་གྱི་ཡོད།",
    "བོད་ཁམས་འཕེལ་རྒྱས་གཏོང་བའི་ནུས་ཤགས་ཡོད་ཚད་ཀྱི་རྩ་བ་དང་།",
    "བཙན་པོ་སྲོང་བཙན་གྱི་དགོངས་པར།",
