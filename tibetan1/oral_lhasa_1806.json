    "བྱིན་གྱིས་རློབ་པར་གསོལ་བ་འདེབས་པའི་ཚིགས་བཅད་ཀྱི་དཔལ་ལྡན་སྐུའི་རྡོ་རྗེ་འཛིན་ཞེས་པའི་དོན་ནི།",
    "ལུས་ངག་ཡིད་གསུམ་གྱི་ནུས་པ་རྫོགས་པ་དང་མཐུན་པར་ལས་རྒྱལ་མཆོག་ཉེར་སྒྲུབ་ཀྱི་ཡན་ལག་བསྟན་ནས་དུས་འཁོར་གྱི་སྒྲུབ་ཐབས་པདྨ་དཀར་པོའི་ཞལ་ལུང་ལ་ལོག་རྟོག་སེལ་ཚུལ།",
    "ལུས་ཀྱི་ཁམས་དང་སྦྱར་བའི་དག་ཤེས་ལེའུ་ལས་གསུངས་པ་དང་།",
    "རྡོ་རྗེ་ལྟ་བུའི་སེང་གེ་རྣམ་པར་རོལ་པའི་ཏིང་ངེ་འཛིན་ཏེ།",
    "དེས་ན་དཀྱིལ་འཁོར་སྣ་ཚོགས་པའི་རྣམ་པར་ཤར་བ་འདི་དག་ནི།",
    "ལེའུ་འདིར་གསུངས་པའི་བརྟེན་པའི་ལྷའི་རྣམ་དག་འཆད་ལ།",
    "དངོས་སུ་མ་གསུངས་པ་དོན་གྱིས་ཐོབ་པ་དུང་།",
    "ཐུགས་ཀྱི་ཁྲོ་བོ་བཞི་སྟེ་བཅུ་དྲུག་ཐབས་ཤེས་ཀྱི་དབྱེ་བས་ཉིས་འགྱུར་དུ་བྱས་པ་སོ་གཉིས་ནི།",
    "ཉིས་འགྱུར་དུ་བྱས་པའི་མི་བདག་ཅེས་བྱ་བ་སྟེ།",
    "རྩ་བར་དངོས་སུ་མ་གསུངས་ཀྱང་།",
    "རྩ་འདབ་སུམ་ཅུ་པ་བཅུ་གཉིས་ཡོད་པའི་རྩའི་གྲངས་དགུ་བཅུ་དུས་ཀྱི་བཞིས་བསྒྱུར་བའི་སུམ་བརྒྱ་དྲུག་ཅུ་དག་པ་ནི་ཚེས་ཀྱི་ལྷ་སུམ་བརྒྱ་དྲུག་ཅུའོ།",
    "རྣམ་པར་དག་པའི་སེམས་ཡིན་ཞིང་།",
    "སྐབས་འདིར་འགྲེལ་པར།",
    "ལྷ་རྣམས་ཀྱི་རྒྱས་བཏབ་ཀྱང་ཅུང་ཟད་གསུངས་སོ།",
    "སྤྱན་མ་དྲུག་ནི་རིམ་པ་བཞིན་ཡེ་ཤེས་ནམ་མཁའ་ལ་སོགས་པའི་ཁམས་དྲུག་རྣམས་རྣམ་པར་དག་པའོ།",
    "བ་སྤུ་བྱེ་བ་ཕྲག་ཕྱེད་དང་བཅས་པའི་གསུམ་པོ་སྒྲིབ་པ་དང་བྲལ་ཞིང་རྣམ་པར་དག་པས་དུར་ཁྲོད་ཀྱི་ས་གཞི་ལ་གནས་པའི་འབྱུང་པོའི་ཚོགས་སོ།",
    "ནང་དུ་ཡིད་བློ་ང་རྒྱལ་གསུམ་ནི་དངོས་སུ་མ་གསུངས་ཀྱང་།",
    "དེ་ལྟར་སྦྱང་གཞི་མ་དག་པའི་གནས་སྐབས་བཞི་བསྐྱེད་པའི་ཐིག་ལེ་སྒྲིབ་བྲལ་དུ་བྱས་ནས།",
    "སྒྲུབ་ཐབས་ལེའུ་ལས་གསུངས་པའི་དུས་ཀྱི་འཁོར་ལོའི་སྒྲུབ་པའི་ཐབས་ཀྱི་ཤེས་རབ་ཀྱིས་སླར་ཡང་ཟླ་བ་བཟང་པོར་བདག་ནི་ཉན་པར་འཚལ་ལོ།",
    "གང་ན་རུས་པ་ལ་སོགས་པའི་ཁམས་རྣམ་པར་དག་པ་རྣམས་ཀྱིས་དུས་ཀྱི་འཁོར་ལོའི་དཀྱིལ་འཁོར་དང་།",
    "ཁམས་དྲུག་དག་པས་ཨཱ་ལི་ཀཱ་ལི་ས་བོན་དུ་བྱས་པའི་ཡུམ་ལ་རིགས་དྲུག་ཏུ་འབྱེད་ཚུལ་གསུངས་པའི་དང་པོ།",
    "ཁམས་ཀྱི་དག་པ་དཀྱིལ་འཁོར་ལ་སྦྱར་ནས་གསུངས་པའི་དོན་ནི།",
    "དེ་ནས་འགྲེལ་པའི་ཚིག་ལས་རྣམ་པར་དག་པ་འདིས་རུས་པའི་ཕྱེ་མ་ལ་སོགས་པ་རྡུལ་ཚོན་གྱི་ནང་དུ་བླུག་པར་བྱའོ་ཞེས་གསུངས་སོ།",
    "གང་དུ་རྡུལ་ཚོན་དྲུག་པ་ཡིན་པ་དེར་ནི་རྡུལ་རྣམ་པར་དག་པས་རྡུལ་ཚོན་གདབ་པར་གསུངས་པའི་དོན་ནི།",
    "ཤ་ལ་སོགས་དྲུག་རྣམ་པར་དག་པ།",
    "ལྔ་པ་ནི་ནམ་མཁའ་ལས་སྐྱེས་པའི་མཐེ་ཆུང་རྣམ་པར་དག་ལས་སོ།",
    "ཨ་ཝ་དྷཱུ་ཏཱི་རྣམ་པར་དག་པས་གཙོ་བོའི་པདྨའོ།",
    "བུག་པ་བཅུ་གཉིས་རྣམ་པར་དག་པས་རྡུལ་ཚན་གྱི་དཀྱིལ་འཁོར་ལ་མཛོད་ཅིག་ཅེས་པའོ།",
    "ཞེས་པ་དཀྱིལ་འཁོར་གྱི་ངེས་པའོ་ཞེས་གསུངས་ལ།",
    "དེ་ཡང་རྟེན་དང་བརྟེན་པའི་དཀྱིལ་འཁོར་ལ་རྡོ་རྗེ་བཞིར་བྱས་པའི་རྟེན་གཞལ་སྐུ་རྡོ་རྗེ།",
    "རིམ་གཉིས་ཀྱི་རྣལ་འབྱོར་པས་ཕྱག་རྒྱ་བསྟེན་པར་བྱེད་པ་ཡིན་ཞིང་།",
    "པསསྔོནརིམ་གྱིས་རྟགས་ཀྱི་རྩ་བར་དུ་ཕབ་པས་བདེ་བ་གོང་ནས་གོང་དུ་འཕེལ་བ་དང་མཐུན་པར་ཐིག་ལེའི་རྣལ་འབྱོར་ཡས་བབས་ཀྱི་དགའ་བ་བཞི་དང་།",
    "དང་པོ་ལ་བསྐྱེད་རྫོགས་ཀྱི་རྣལ་འབྱོར་པ་གཉིས་ཀས་བསྟན་པར་བྱ་བ།",
    "བསྟེན་པའི་ཐབས་ཁྱད་པར་ཅན་གྱིས་མ་ཟིན་ན།",
    "ཕྱག་རྒྱ་དེའི་རང་སྟོབས་ཀྱིས་འཛག་པའི་བདེ་བ་སྟེར་བར་གསུངས་ལ།",
    "དེས་གཡོ་བའི་བདེ་བ་སྟེར་བར་གསུངས།",
    "ཕྱག་རྒྱ་དེའི་རང་སྟོབས་ཀྱིས་མི་འགྱུར་བའི་བདེ་བ་སྟེར་བར་གསུངས་སོ། ༙།",
    "རིམ་པ་དང་པོའི་སྐབས་སུ་ཀ་དུས་འཁོར་གྱི་སྒྲུབ་ཐབས་པདྨ་དཀར་པོའི་ཞལ་ལུང་ལ་ལོག་རྟོག་སེལ་ཚུལ་བསྟེན་པར་བྱ་བའི་ཕྱག་རྒྱ་ནི་དང་པོ་གཉིས་ཡིན་༦༥བ་ལ།",
    "དེ་ཡང་བསྟེན་པར་བྱ་བའི་ལས་ཀྱི་ཕྱག་རྒྱ་ནི།",
    "རྒྱུད་འདི་དང་གཞན་ནས་ཀྱང་གསུངས་པའི་པདྨ་ཅན་ལ་སོགས་པའི་ལུས་རྟེན་མཚན་ཉིད་དང་ལྡན་པ།",
    "དེ་ཡང་འདིར་རྩ་རྒྱུད་དྲངས་ནས་བསྟེན་ཚུལ་གྱི་རྣམ་གཞག་གསུངས་པ་ལ།",
    "དང་པོ་བསྟེན་པར་བྱ་བའི་ཡུལ་སྟོན་པ་ནི།",
    "ཞེས་པས་ལོ་བཅུ་དྲུག་མ་དངོས་སུ་གསུངས་ཀྱང་།",
    "དེ་ནས་པདྨ་རྣམ་པར་སྦྱང་།",
    "བཅས་པ་བྱས་ནས་པདྨར་གཞུག།",
    "ཡུམ་གྱི་གསང་གནས་ཨཱ་ལས་པདྨར་བསྐྱེད་པའི་ལྟེ་བར་རྡོ་རྗེས་མཚན་པར་གསུངས་པ་ནི།",
    "རྒྱུད་འདིར་གསུངས་པ་ཡང་རྫོགས་རིམ་པའི་ཉམས་ལེན་དངོས་སུ་བསྟན་ནས།",
    "རྫོགས་རིམ་པའི་ཐིག་ལེའི་རྣལ་འབྱོར་དངོས་སུ་བསྟན་པས་མཚོན་ནས་ཤེས་པར་བྱ་བ་ནི།",
    "ཐིག་ལེའི་གཟུགས་ཀྱིས་འཛག་པར་བྱེད།",
    "མཐུན་པར་འཛིན་པའི་ལོག་པར་རྟོག་པ་བསལ་ནས།",
    "དང་པོ་ལ་ལོག་པར་རྟོག་པའི་ཚུལ་དང་དེ་དགག་པ་གཉིས།",
    "ལུགས་འདིའི་རྗེས་འཇུག་ཁ་ཅིག་ཡབ་སྲས་གསུམ་དགོངས་པ་མི་མཐུན་པར་འདོད་ཅིང་།",
