    "གཞན་གྱིས་མ་བྱས་པ་དང་།",
    "དེ་བཞིན་དུ་སྒྲ་ལསོགས་པ་དངོས་པོ་ཐམས་ཅད་ལ་ཡང་རྣམ་པ་བཞི་པོ་དག་མི་འཐདཔས་འགྲུབ་པར་བལྟ་བར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་སྐད་གསུངས།",
    "གཉིས་པམེད་ཅེས་ཚིགས་སུ་བཅད་པ་ཡང་གསུངས་སོ།",
    "ཇི་ལྟར་རབ་ཏུ་འགྲུབ་པར་འགྱུར།",
    "གལཏེ་འདུ་བྱེད་ཐམས་ཅད་བྲྫུན་པ་ཡིན་ན་འཛིན་བཞིན་དུ་ཡང་དངོསཔོ་ཐམས་ཅད་མེད་དོ་ཞེས་དེ་དག་མི་གསལ་བར་བྱས་པར་མི་འགྱུརརམ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་གསུངས་པ།",
    "དེ་ལྟ་བས་ན་བྲྫུན་པ་ཞེས་གསུངས་པས་དངོས་པོ་རྣམས་མེད་པརབསྟན་པ་མ་ཡིན་ནོ།",
    "བྲྫུན་པ་ཞེས་གསུངས་པ་ནི།",
    "དངོས་པོརྣམས་ཀྱི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་སྟོན་པ་ཡིན་པར་མགསུངས་ཀྱི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་དེ་སྐད་གསུངས་པ་ནི།",
    "བྲྫུན་པཞེསགསུངས་པ་ཉིད་གང་ཡིན་པ་དེས་ནི་དངོས་པོ་རྣམས་ལ་ངོ་བོ་ཉིདམེད་པ་ཁོ་ནར་ཡོངས་སུ་བསྟན་པ་མ་ཡིན་གྱི།",
    "རྣམ་པར་འགྱུར་བ་སྣངབའི་ཕྱིར་དང་།",
    "ངེས་པར་མི་གནས་པའི་ངོ་བོ་ཉིད་དུ་སྣང་བའིཕྱིར་ཡོངས་སུ་བསྟན་པ་ཡིནནོ།",
    "དེའི་ཕྱིར་དངོས་པོ་རྣམས་ཀྱི་ངོ་བོ་ཉིད་ངེས་པར་མི་གནསཔའི་ཕྱིར་དང་།",
    "དངོས་པོ་རྣམས་ངོ་བོ་ཉིད་མེད་པ་ཉིད་ཅེསགསུངས་པར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེ་ནི་ངེས་པ་ཁོ་ནར་དེལྟར་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "དེ་ལ་གལ་ཏེ་ངོ་བོ་ཉིད་མེད་པ་ཁོ་ན་ཡིན་ན་གཞན་དུའགྱུར་བ་ཡང་མེད་པར་འགྱུར་བར་ཐེ་ཚོམ་མེད་པ་ཞིག་ན།",
    "གཞན་ལ་མི་ལྟོས་པར་རང་ལས་རབཏུ་གྲུབ་པ་རྟག་པ་མི་འགྱུར་བ་ཡོད་པ་དེ་ལ་ཇི་ལྟར་གཞན་དུ་ཡངའགྱུར་བ་ཡོད་པར་འགྱུར་ཏེ།",
    "དངོས་པོར་ཡོངས་སུ་བརྟག་པ་གང་ཡིན་པདེ་ཉིད་ལ་ཡང་གཞན་དུ་འགྱུར་བ་ཡོད་པར་མི་འཐད་ལ།",
    "དེ་ལསགཞནཔ་ཉིད་གང་ཡིན་པ་དེ་ལ་ཡང་གཞན་དུ་འགྱུར་བ་ཡོད་པར་མི་འཐདདོ།",
    "དེ་ལྟ་ན་རྒས་པ་དངགཞོན་པགཉིས་གཅིག་ལ་ལྷན་ཅིག་གནས་པར་ཡང་འགྱུར་རོ།",
    "འདི་ལྟར་མི་མཐུན་པ་གཉིས་གཅིག་ལ་ལྷན་ཅིག་ཇི་ལྟར་གནས་པརའགྱུར།",
    "དེ་ལྟ་ན་ཡང་རྒ་བར་བརྟག་པ་དོན་མེད་པར་འགྱུར་ཏེ།",
    "དེའི་དེ་གནས་སྐབས་ཇིལྟ་བུར་འགྱུར་ཞེས་དེ་ལ་ཡང་བསམ་པ་དེ་ཉིད་དང་རྗེས་སུ་འབྲེལཔར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་བྲྫུན་པ་ཞེས་གསུངས་པ་ནི་དངོས་པོ་རྣམསཀྱི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཡོངས་སུ་སྟོན་པར་བྱེད་པ་ཡིན་གྱི།",
    "ངོ་བོ་ཉིད་ངེས་པར་མི་གནས་པ་སྟོན་པར་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "གཉེན་པོ་མེད་པསཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིནཔས་སྟོང་པ་ཉིད་ཡོད་པའི་ཕྱིར་སྟོང་པ་ཉིད་མ་ཡིན་པ་ཡང་ཡོདཔར་འགྱུར་རོ།",
    "གཉེན་པོ་ལས་དངོས་པོ་རབ་ཏུ་ཡང་འགྲུབཔར་འདོད་ན་ཡང་སྟོང་པ་ཡིན་པ་མི་འཐད་དེ།",
    "སྟོང་པའང་ཅུང་ཟད་ཡོད་པར་འགྱུར།",
    "སྟོང་པའང་ཡོད་པར་གལ་འགྱུར།",
    "གལ་ཏེ་མི་སྟོང་པ་ཅུང་ཟད་ཅིགརབ་ཏུ་འགྲུབ་པར་གྱུར་ན་ནི།",
    "དེའི་གཉེན་པོ་སྟོང་པ་ཡང་ཅུང་ཟདཡོད་པར་འགྱུར་བ་ཞིག་ན།",
    "དེ་སྟོང་པ་ཡོད་པ་མ་ཡིན་ན་དེའིགཉེན་པོ་སྟོང་པ་མ་ཡིན་པ་ཡོད་པར་ཇི་ལྟར་བརྟག།",
    "བཅོམ་ལྡན་འདསཀྱིས་དེགསུངས་པ།",
    "སྟོང་པའང་ཅུང་ཟད་ཡོད་པར་འགྱུར།",
    "ལྟ་ཀུན་ངེས་པར་འབྱིནཔར་གསུངས།",
    "དེ་དག་བསྒྲུབ་ཏུ་མེདཔར་གསུངས།",
    "སྟོང་པ་ཉིད་ཅེས་བྱ་བ་ནི་སྟོང་པ་ཉིད་ལྟ་བ་ཀུནགྱི་ཆུ་སྲིནའཛིན་ཁྲི་ཐམས་ཅད་ལས་ངེས་པར་འབྱིན་པ་ཡིན་པར་གསུངས་ཏེ།",
    "དེནི་ལྟ་བའི་ཆུ་སྲིན་འཛིན་ཁྲི་ཐམས་ཅད་བཟློག་པར་གསུངས་པས།",
    "ཡོདཔ་མ་ཡིན་པ་ལ་རྣམ་པར་རྟོག་པ་དང་བྲལ་བ་འབའ་ཞིག་ཏུ་ཟདཔ།",
    "བསྒྲུབ་ཏུ་མི་རུང་བའི་དཔྱད་པ་སྨྲན་པ་ཆེན་པོ་རྒྱལབ་རྣམས་ཀྱིས་དེ་དག་ནི་བསྒྲུབ་ཏུ་མི་རུང་བ་ཉིད་ཡིན་ནོ་ཞེསགསུངས་སོ།",
    "དངོས་པོ་རྣམསངོ་བོ་ཉིད་ཀྱིས་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་དངོས་པོ་རྣམས་ཀྱི་ངོ་བོཉིད་དུ་རབ་ཏུ་བསྟན་པ་ན་མངོནཔར་ཞེན་པ་དེ་བཟློག་པར་ནུས་ཀྱི།",
    "དཔེར་ན་ཅི་ཡང་མེད་དོཞེས་སྨྲས་པ་ན་ཅི་ཡང་མེད་པ་དེ་ཉིད་བྱིན་ཅིག་ཅེས་ཟེར་བ་གངཡིན་པ་དེ་ལམེད་པ་ཉིད་འཛིན་དུ་གཞུག་པར་ཇི་ལྟར་ནུས་པ་བཞིན་ཏེ།",
    "དེ་ལྟབས་ན་དེ་བས་ནི་རྒྱལ་བ་སྟོབས་བཅུ་དང་ལྡན་པར་གྱུར་པ།",
    "ཐུགསརྗེ་ཆེན་པོ་མངའ་བས་ཀྱང་བསྒྲུབ་ཏུ་མི་རུང་བ་ཉིད་དུ་གསུངསསོ།",
    "རྣམ་པར་ཤེས་པ་དང་རྣ་བ་ལ་སོགས་པ་དག་ཀྱང་དེ་བཞིནནོ་ཞེས་གསུངས་སོ།",
    "དངོས་པོ་རྣམས་ལ་ངོ་བོ་ཉིད་མེད་ན་ཕྲད་པར་མིའཐད་དེ།",
    "འདི་ལྟར་དངོས་པོ་ངོ་བོ་ཉིད་མེད་པ་རྣམས་ཇི་ལྟརཕྲད་པར་འགྱུར་ཏེ།",
    "དངོས་པོ་རྣམས་ངོ་བོ་ཉིད་ཡོད་པར་འགྱུར་བ་ཞིག་ན།",
    "དངོས་པོརྣམས་ཀྱི་ཕྲད་པ་ཉིད་མི་འཐད་པས་ངོ་བོ་ཉིད་ཡོད་པར་ག་ལའགྱུར།",
    "ཕྲད་པར་འགྱུར་བ་ཡོད་མ་ཡིན།",
    "ཐམས་ཅདཀྱང་ཕན་ཚུན་དུ་ཕྲད་པར་མི་འགྱུར་ཏེ།",
    "བལྟ་བར་བྱ་བ་དངལྟ་བ་ཡང་ཕྲད་པར་མི་འགྱུར་ལ།",
    "བལྟ་བར་བྱ་བ་དང་ལྟ་བ་པོཡང་ཕྲད་པར་མི་འགྱུར།",
    "ལྟ་བ་དང་ལྟ་བ་པོ་ཡང་ཕྲད་པར་མིའགྱུར།",
    "བལྟ་བར་བྱ་བ་དང་ལྟ་བ་དང་ལྟ་བ་པོ་ཡང་ཕྲད་པརམི་འགྱུར་རོ།",
    "ལྟ་བ་པོདག་གཉིས་གཉིས་དང་ཕན་ཚུན་ལྷན་ཅིག་ཏུ་ཕྲད་པར་མི་འགྱུར་བདེ་བཞིན་དུ་འདོད་ཆགས་དང་ཆགས་པ་དང་།",
    "ཆགས་པརའགྱུར་བ་དག་ཀྱང་གཉིས་གཉིས་དང་ཐམས་ཅད་ཀྱང་ཕན་ཚུནལྷན་ཅིག་ཏུ་ཕྲད་པར་མི་འགྱུར་ཏེ།",
    "འདོད་ཆགས་དང་ཆགས་པ་དངཕྲད་པར་མི་འགྱུར་ལ།",
    "འདོད་ཆགས་དང་ཆགས་པར་འགྱུར་བ་ཡངཕྲད་པར་མི་འགྱུར།",
    "ཆགས་པ་དང་ཆགས་པར་འགྱུར་བ་ཡངཕྲད་པར་མི་འགྱུར།",
    "འདོད་ཆགས་དང་ཆགས་པ་དང་ཆགས་པར་འགྱུརབ་ཡང་ཕྲད་པར་མི་འགྱུར་རོ།",
    "ཉན་པ་པོ་ལ་སོགས་པ་དག་ཀྱང་གཉིས་གཉིསདང་ཐམས་ཅད་དག་ཀྱང་ཕན་ཚུན་ལྷན་ཅིག་ཏུ་ཕྲད་པར་མིའགྱུར་རོ།",
    "ཅིའི་ཕྱིར་བལྟ་བར་བྱ་བ་ལ་སོགས་པ་དེ་དགཕན་ཚུན་ལྷན་ཅིག་ཕྲད་པར་མི་འགྱུར།",
    "དེ་ཕྱིར་ཕྲད་པར་མི་འགྱུར་རོ།",
    "འདིལ་གལ་ཏེ་ཕྲད་པ་ཞེས་བྱ་བ་འགའ་ཞིག་ཡོད་པར་གྱུར་ན་དེ་ངེསཔར་གཞན་དང་གཞན་ལྷན་ཅིག་ལས་འགྱུར་གྲང་ན།",
    "དེ་དག་ལ་ཕནཚུན་གཞན་ཉིད་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་ཕན་ཚུན་ལྷན་ཅིགཕྲད་པར་མི་འགྱུར་རོ།",
    "གཞནཉིད་མེད་པར་མ་ཟད་ཀྱི།",
    "བལྟ་བར་བྱ་བ་ལ་སོགས་པ་དེ་དག་འབའཞིག་ལ་ཕན་ཚུནགཞན་ཉིད་མི་འཐད་པར་མ་ཟད་ཀྱི།",
    "གཞན་ཉིད་མེད་ན་གང་ཡང་གང་དང་ཡང་ལྷན་ཅིག་ཕྲད་པར་མིའཐད་དོ།",
    "དེ་ལྟ་ན་ཡང་གཞན་ཉིད་མེདཔར་མི་འགྱུར་ཏེ།",
    "གཞན་ཉིད་རབ་ཏུ་འགྲུབ་པར་འགྱུར་རོ།",
    "གཞནམེད་པར་ཡང་རུང་བར་འགྱུར།",
    "གལ་ཏེ་གང་ལ་བརྟེན་ནས་གཞན་དུའགྱུར་བ་དེ་དེ་ལས་གཞན་ཡིན་པར་གྱུར་ན་ནི།",
    "དེ་མེད་པར་ཡང་དེགཞན་དུ་འགྱུར་བ་ཉིད་དེ།",
    "གཞན་མེད་པས་རང་ཉིད་ལསགཞན་དུ་མི་འགྱུར་བའི་ཕྱིར་གཞན་མེད་པ་ཁོ་ནར་ཤེས་པར་གྱིསཤིག།",
    "དེ་ལྟ་ན་བུམ་པ་དེ་ཉིད་གཞནམ་ཡིན་པར་འགྱུར་ཏེ།",
    "གཞན་མེད་པར་གཞན་མ་ཡིན་པར་ཡང་མེད་པསགཞན་ཡང་ཡོད་པར་འགྱུར་རོ།",
    "འདི་ལྟར་གཞན་ལ་ལྟོས་ནས་གཞན་མ་ཡིན་པར་འགྱུརན་གཞནཉིད་དེ་ཡང་བརྟགས་ན་མི་འཐད་དོ།",
    "གཞན་མ་ཡིནཔ་མེད་ན་དེའི་གཉེན་པོ་གཞན་མེད་དོ་ཞེས་དེ་སྐད་བསྟན་པར་མིའགྱུར་རམ།",
    "གཞན་ཉིད་ནི་གཞན་ལས་ངེས་པར་གནསཔ་ཁོ་ན་ཡིན་པས་ཞེས་གང་སྨྲས་པ།",
    "གལ་ཏེ་ཡོད་པར་གྱུར་ན་ནི་གནས་སྐབས་ཐམས་ཅད་ན་ཡོདཔར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་གཞན་ཉིད་ངེས་པར་མི་གནས་པར་བསྟེན་པ་ཡིན་ཏེ།",
    "བཙལ་བར་ཡོད་པ་ཡང་དམ་བཅས་པརཡང་འགྱུར་བས་དེ་ཡང་མི་འཐད་དེ།",
    "གཞན་ཉིད་གཞན་ལངེས་པར་གནས་སོ་ཞེས་བྱ་བ་དེ་ནི་གྱི་ནའོ།",
    "གཞནཉིད་གཞན་ལ་ངེས་པར་གནས་ཀྱང་རུང་མི་གནས་ཀྱང་རུང་སྟེ།",
    "འོ་ན་ནི་གཞན་གྱི་དངོས་པོ་མེད་པར་གཞན་དུ་མི་འགྱུརརོ།",
    "འདོད་ཆགས་ལ་སོགས་པ་དག་ཇི་ལྟར་ཕན་ཚུན་ལྷན་ཅིག་ཏུ་ཕྲད་པརགྱུར།",
    "ཅི་སྟེ་དེ་ལྟ་ན་ཡང་འགྱུར་ན་ནིཅི་ཡང་མི་ཕྲད་པར་མི་འགྱུར་བས་དེ་ཡང་མི་འདོད་དེ།",
    "དེ་ལྟ་བསན་དེ་ཉིད་དང་ཕྲད་པར་མི་འཐད་དོ།",
    "དེ་ནི་གང་ལ་འདི་ནིགཞན་ནོ་འདི་ཡང་གཞན་ནོ་ཞེས་བྱ་བསྟེ་ཡོདཔ་དེ་ལ་ཡང་ཕྲད་པར་མི་འཐད་དོ།",
    "ཅི་སྟེ་གཞན་ཉིད་ཡིན་པ་ཡངཕྲད་ན་ནི་དེ་ལྟ་ན་ཅི་ཡང་མི་ཕྲད་པར་མི་འགྱུར་བས་དེ་ཡངམི་འཐད་དེ།",
    "དེ་ལྟ་བས་ན་གཞན་ཉིད་ཡིན་ན་ཡང་ཕྲད་པར་མིའཐད་དོ།",
    "དཔེར་ན་འོ་མ་དང་ཆུ་གཉིས་ཕྲདཔ་དེ་བཞིན་དུ་གཞན་དང་གཞན་ཡང་ཕྲད་པར་མི་འགྱུར་རོ།",
    "ཐ་དད་པར་གྱུརཔ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཕྲད་བཞིན་པ་ཞེས་བྱ་བའི་དངོས་པོདག་གཅིག་ཡོད་པར་གྱུར་ན་དེ་ལ་ཡང་འདི་ནི་གཞན་ནོ།",
    "འདི་ཡངགཞན་ནོ་ཞེས་གཞན་ཡིན་པའི་ཕྱིར་ཕྲད་པར་མི་འཐད་དོ།",
    "གཅིག་པ་ཉིད་ནིཇི་ལྟར་ཕྲད་པར་འགྱུར།",
    "ཅི་སྟེ་ཕྱོགས་གཅིག་ཕྲད་ཀྱང་བདག་ཉིད་ཐ་དད་པ་ཉིད་དུའགྱུར་ན་ནི་ཐ་དད་པའི་ཕྱིར་ཕྲད་པར་ག་ལ་འགྱུར།",
    "འདི་ལ་ཕྲད་པར་བྱེད་པས་ཕྲད་པའིརྒྱུ་ལས་བྱུང་བ་ནི་ཕྲད་པ་པོ་ཡིན་ན་ཕྲད་པ་དེ་ཡང་རྣམ་པཐམས་ཅད་དུ་མི་འཐད་དོ།",
    "དེ་མེད་ན་ཕྲད་པར་བྱེད་བ་མེད་པཕྲད་པ་པོ་ཡོད་པར་ཇི་ལྟར་འགྱུར།",
    "ཇི་ལྟར་དངོས་པོབྱུང་བ་ཡངཡིན་ལ་ངོ་བོ་ཉིད་མེད་པ་ཡང་ཡིན་པར་འགྱུར།",
    "ངོ་བོ་ཉིད་ནི་བྱས་པར་འགྱུར།",
    "ངོ་བོ་ཉིད་ནི་བྱས་པ་ཁོ་ན་ཡིན་ནོ།",
    "ངོ་བོ་ཉིད་ནི་བྱས་པཞེས།",
    "ངོ་བོ་ཉིད་བྱས་པ་ཞེསབྱ་བར་ཇི་ལྟར་རུང་བར་འགྱུར་ཏེ།",
    "གལ་ཏེ་ངོ་བོ་ཉིད་ཡིན་ན་ནི་བྱསཔ་མ་ཡིན་ལ་ཅི་སྟེ་བྱས་པཡིན་ན་ནི།",
    "ངོ་བོ་ཉིད་མ་ཡིན་པ་དེའི་ཚེ་ངོ་བོ་ཉིད་ཀྱང་ཡིནལ་བྱས་པ་ཡང་ཡིན་ནོ།",
    "ཞེས་སེམས་དང་བཅས་པ་སུ་ཞིག་དེ་ལྟརའཛིན་པར་འགྱུར།",
    "གང་བྱ་བས་བསྒྲུབ་པར་མི་འགྱུར་བ་དང་།",
    "རྒྱུ་དང་རྐྱེནལ་ཡང་ལྟོས་པར་མི་འགྱུར་བ་རང་ཉིད་ཀྱི་ངོ་བོ་ཉིད་མི་འགྱུརབར་འཇུག་པ་དེ་ནི་ངོ་བོ་ཉིད་ཀྱིས་རིགས་པ་ཡིན་ནོ།",
    "ངོ་བོ་ཉིད་ཀྱང་རབ་ཏུའགྲུབ་པར་འགྱུར་རོ།",
