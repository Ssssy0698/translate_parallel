    "ཐོས་བསམགྱི་སྒྲོ་འདོགས་འཆད་དེ་ཐམས་ཅད་མཁྱེན་པའི་གནས་ལ་བདག་གིར་མཛད།",
    "ཡི་དམ་ལྷའི་ཞལ་གཟིགས་རྒྱུན་མི་འཆད།",
    "ཆུང་ངུ་ནས་སྲིད་བདེ་འཁྲུལ་པར་ངེས་པའི་སྐྱོཤས་བཅོས་མིན་དུ་ཤརབས་ལས་འབྲས་བསླུ་མེད་ཀྱི་བླང་དོར་ངང་གིས་སྤྱོད་པ་བྱུང་།",
    "དེའི་ཚེ་རྒྱལ་སྲས་ཟླ་ང་ལྷོ་མོན་དུ་ཕེབས་པའི་ཐོག་མར་མཇལ་བ་ཙམ་ནས་བཟོད་མེད་ཀྱི་མོས་གུས་སྲོལ་དེ་ནས་བཟུང་འ་བདུན་གྱི་བར་བསྟེན་ནས་རྫོགས་པ་ཆེན་པོ་གསང་བ་བླ་ན་། གྲུབ་ཆེན་ཀུན་བཟང་རྡོ་རྗེར་འདུད།",
    "མོན་མཐའ་ཡུལ་སྟན་ཆར་ཞེས་པར་མ་སངས་ཨར་བ་སྤུན་བརྒྱད་ཀྱི་། རིགས་སུ་མེ་མོ་སྦྲུལ་ལོར་འཁྲུངས་པ་དང་དུས་མཚུངས་པར་ཆུ་མིག་གསར་དུ་ཐོན།",
    "བྲག་ལེགས་ལ་སོར་མོས་མཎི་ཡིག་དྲུག་འདམ་ལ་བྲིས་པ་བཞིན་ཤར་བ་སོགས་དམ་པའི་མཚན་ཉིད་གསལ་བས།",
    "ཡུམ་ཨོ་རྒྱན་སྐྱིད་ཀྱི་སྲས་སུ་ཤིང་སྟག་གི་འཁྲུངས།",
    "དགུང་ལོ་ཞེ་གཉིས་པ་ཤིང་ལུག་གི་ལོར་དར་རྒྱས་ཚེས་སྡིངས་ཀྱི་རི་ཁྲོད་བཏབ།",
    "དེ་ལྟར་ཞིང་འདིར་ལོ་གྲངས་དོན་བདུན་དུ་བཞུགས་ནས་ལྕགས་རྟ་དབོ་ཟླའི་ཉེར་བཞི་ལ་གཡོརུ་ཁྲ་འབྲུག་གི་གཙུག་ལག་ཁང་གི་ཉེ་འགཤེགས་ཤིང་།",
    "མོན་ཡུལ་སྔན་ལུང་རྒན་ལར་ཞེས་པར་ཡབ་བཀྲ་ཤིས་དང་།",
    "ཡུམ་བསམ་གཏན་བཟང་མོའི་སྲས་སུ་མེ་སྤྲེལ་ལ་འཁྲུངས།",
    "ཕྱོགས་དེའི་སྐྱེ་ཀུན་གྱིས་མཆོད་ཅིང་མོས་པ་དང་འཚམས་པའི་ཚེས་ཀྱིས་དོན་ལྡན་དུ་མཛད།",
    "ལྷག་པའི་ལྷ་དུ་མའི་ཞལ་གཟིགས་ལུང་བསྟན་པའང་ཐོབ།",
    "ཞྭདམར་ནག་སོགས་བཤེས་གཉེན་མང་པོ་ལསགསར་རྙིང་གི་ཚེས་བཀའ་ཇི་སྙེད་པ་སྔ་ཕྱིར་གསན།",
    "རྩེད་ངག་གིས་རྒོལ་ཞིང་ལན་འདེབས་པ་སོགས་གང་ལ་ཡང་ཐོགས་པ་མེད་ས་བློ་ལྡན་ད་ཀྱིས་བསྔགས་པའི་གནས་སུ་གྱུར།",
    "སོགས་ཡི་དམ་དུ་མའི་ཞལ་གཟིགས་ཤིང་དབུགས་དབྱུང་བ་ཐོབ།",
    "ཐོག་གི་ཡོ་བྱད་དུ་མས་བསྙེན་བཀུར་བས་མཚོན་སྐུགསུང་ཐུགས་ཀྱི་ཕྲིན་ལས་འཁོར་ལོ་གསུམ་གྱི་འཇུག་པ་ཅི་རིགས་པ་ལས་ནམ་ན་རྒྱ་ཆེར་མཛད་ནས།",
    "དགོངས་པ་སྐོང་བའི་མཆོད་འབུལ་ཕྱི་ནང་གི་རྟེན་བཞེངས་ཕྲིན་ལས་མི་ཉམས་པའི་རྒྱུན་སྐྱོང་བ་རྣམས་རིགས་སྲས་གསང་བདག་ཆེན་པོས་མཛད་དོ།",
    "ཀུན་རིག་ཕག་མོ་དུས་འཁེར་སོགས་ཀྱི་སན་ཅིང་དེ་དག་གི་ག་གར་འཆམས་སོགས་ཀྱང་ཚོགས་མེད་པར་མཁྱེན།",
    "མི་རིང་བར་ཡབརྗེ་སུ་ཞི་བར་གཤེགས་པའི་སྐུ་གདུང་གི་མཆོད་འབུལ་ཕྱི་ནང་གི་རྟེན་བཞེངས་སོགས་དགོངས་པ་འབྱུང་རྫོགས་པར་མཛད།",
    "དཔའ་བོ་རྒྱལ་ཚབ་པ་ཙམ་མ་གཏོགས་རང་གི་ཡོངས་འཛིན་རྣམས་ཀྱིས་ཀྱང་ཚེས་ཀྱི་བདུད་རྩི་ངོམས་མེད་དུ་གསོལ་ཞིང་གུས་པར་བཏུད།",
    "ཁྲིད་བཀ་མྱོང་གི་སྣེ་ནས་ཁྲིད་མཁས་པས་ཟབ་ལམ་གྱི་རྟོགས་པ་འཁྲུལ་མེད་ངོ་འཕྲོད་པས་ཉམས་མྱོང་དྲོད་ཚད་ཐེབ་པ་མང་དུ་ཐོན།",
    "བུད་མེད་མཛེས་མ་གཉིས་ཨ་མས་ཤོགཐུགསལ་གསལ་བའི་དྲན་ཤེས་ཁྱད་པར་ཅན་མངའ།",
    "གཞན་ཡང་སྨིན་གྲོལ་ཟབ་མོགསན་པའི་བཤེས་གཉེན་ཆེན་པོ་བཅུ་དྲུག།",
    "བདག་ཉིད་ཆེན་པོ་དེ་སྐུ་ཟུར་ཞལ་དུ་གཟིགས་པ་རབ་བྱུང་པཎྜི་ས་ཅན་ཞལ་གཟིགས་པས།",
    "འདི་དུས་སྐུ་རབ་བྱུང་པཎྜི་ཏའི་ཆས་ཅན་ཕྱག་ན་ཤེལ་རྡོ་བསྣམས་པ་ཞལ་འཛུམ་མདངབ་སྨིན་གྲོལ་གླིང་འདུ་ཁང་གི་རྒྱ་མཐོངས་ལོགས་རིས་ན་བཞུགས་པ་དེ་ཞལ་གཟིགས་མའི་འདྲ་ཞལ་ཡིན།",
    "རྒྱལ་གསུང་དྲུག་གི་རང་བཞིན་ཕ་མཐའ་མེད།",
    "རྡོ་རྗེ་རྩེ་མོ་ཉི་མ་བརྒྱར་བརྩེགས་པའི།",
    "དྷཱི་མེད་ལུང་གི་སེང་གེའི་སྒྲ་སྒྲོགས་པ།",
    "དཔྱོད་ལྡན་སྒེག་མོའི་རྒྱན་དུ་སྤེལ་མཁས་པའི།",
    "སྣ་ཚོགས་སྐད་དང་སྟོབས་སུ་སོང་བའི་གར།",
    "ཕུན་ཚོགས་ལང་ཚོ་རྒྱས་པའི་ངོ་མཚར་མདངས།",
    "ངེས་དོན་ཟབ་མོ་ཀུན་བ་ཟང་དགོངས་པ་བཞིན།",
    "ཞི་ཁྲོ་སོགས་ལྷག་པའི་ལྷ་རབ་འབྱམས་ཀྱི་ཞལ་གཟིགས་དང་ལུང་བསྟན་བརྙེས་ཤིང་།",
    "སྐུ་འབུམ་མཐོང་གྲོལ་ཆེན་མོ་དང་།",
    "དགུང་གྲངས་རེ་དགུ་པར་ཤིང་རྟ་ཧོར་ཟླ་དང་པོའི་ནང་ཅུང་ཟད་སྐུན་ཚུལ་ཞལ་གདམས་སྩལ།",
    "ཞབས་གོམ་བདུན་སྤོསམཐར་སྐྱིལ་ཀྲུང་གིས་བཞུགས་ཏེ།",
    "དེའི་ཚོ་འོད་ཀྱི་གུར་དང་མེ་ཏོག་གི་ཆར་བབས།",
    "རྗེ་འདིའི་གསུང་གི་བདུད་རྩི་བཞེས་པའི་ཞལ་སློབ་ཀྱི་གཙོ་བོ་ནི།",
    "རྩེ་གདོང་ཞབས་དྲུངང་འོག་གི་སྐྱེས་ཆེན།",
    "སོག་དམག་གིས་བསྟན་པར་ཉེར་འཚེ་བྱུང་སྐབས།",
    "གྲུབ་པའི་མཚན་མ་བརྙེས་ཤིང་ལྷ་ར་བྱམས་ཀྱིས་ཞལ་གཟིགས།",
    "དམ་པ་འདི་ཉིད་གཏེར་ཆེན་ཉིད་ཀྱི་ཕྱི་མཐའ་གཟིགས་པས་དོན་གྱི་ཁྲི་འདོན་མཛད་ཟིན་ཏེ།",
    "དེ་དུས་རེན་རྣམ་འདི་ཁྲི་ཆེན་གྱི་གོ་སར་རྒན་པོའི་ཚབ་ཏུ་ཆེ་འདོན་བྱེད།",
    "རེ་ཞིག་སྐུ་ཉིད་བཞུགས་རིང་ལ་ཉིད་རང་ཁྲིར་བཞུགས་རྒྱུ་ལས་གཞན་པ་ཁྲི་འདོནམི་གནང་བར་ཞུ་ཞེས་ནན་གྱིས་གསོལ་བ་བཏབ་སྟེ་བཤོལ་བས་འོ་ན་སང་ཉིན་རབ་གནས་སྟོན་མོའི་ཚོགས་ནང་ལ་ངེས་པར་འོང་དགོས།",
    "ད་རེས་ངེད་ཀྱི་བྱས་པ་དེ་ལེགས་པ་འདྲ་ཡང་།",
    "དགུང་གྲངས་དྲུག་ཅུ་རྩ་ཐོ་སྟག་གི་ལོར་མཁྱེན་བཞིན་ཤར་ཕྱོགས་འོལ་ཀར་ཕེབས་ནས།",
    "དེ་ཡང་ཡུལ་གྲྭ་ནང་པའི་ཁྱིམ་ཚང་ཕྱུག་པོ་ཞིག་གི་བུ་རུ་འཁྲུངས།",
    "གྲྭ་གཞོན་མང་པོའི་གྲལ་ནས་ཡོན་ཏན་གྱི་རྩེ་མོར་སོན།",
    "ལོ་ཆེན་གཉིས་ལ་ཕྱི་མཐའ་པའི་མ་འོངས་ལུང་བསྟན་དུ་ཚོས་གྲགས་འདི་རང་རེའི་བསྟན་པ་ལ་ཕན་མཁན་ཞིག་འོང་བར་འདུག་པས།",
    "གཏེར་ཆེན་སྐུ་མཆེད་ལྷན་རྒྱས་དགྱེས་པ་རབཀྱི་རྩེ་མོར་སོན་ཏེ།",
    "སོག་དམག་གིས་ཉེར་འཚེ་སྐབས་སྨིན་གྲོལ་གླིང་ཉམས་རྒུད་མ་ཤོར་བར་གཅེས་སྐྱོང་མཛད་བསྟན་པ་ལ་བཀའ་དྲིན་ཤིན་ཏུ།",
    "དེ་ལྟར་དོན་གཉིས་ལྷུན་གྲུབ་ཀྱི་ངང་ནསགཟུགས་སྐུའི་བཀོད་པ་རེ་ཞིག་གདོད་མའི་ནང་དབྱིངས་སུ་བསྡུས་སོ།",
    "སྣེཁྱི་མོ་གཅིག་ལ་ཁྱི་ཕྲུག་དགུ།",
    "ཧཱུཾ་ཀ་རའི་ཞལ་གཟིགས་པས་དོན་བརྒྱུད་ཀྱི་རྟོགས་པ་འཕོས་ནས་རིག་སྟོང་མི་ཤིགས་པའི་དབྱིངས་སུ་འབྱམས་ཀླས།",
    "ཅེས་པའི་ལྷ་དེས་ཞལ་གཟིགས་པ་ཟབ་གཏེར་གྱི་སྔ་ལྟས་སུ་བྱུང་།",
    "ནུབ་གཅིག་རྨི་ལམ་འོད་གསལ་གྱི་སྣང་ཆར་སེང་གེ་དཀར་མོ་ཞིག་ཆིབས་ཏེ།",
    "ཁྱོད་ནི་ཁྲི་སྲོང་ལྡེའུ་བཙན།",
    "ཁྱོད་ནི་སེང་གེ་རས་པ་ཡིན།",
    "བརྡ་ཐིམ་ཞེས་གསུངས་པའི་མོད་སྣང་བ་ཟི་བུན་པ་ཞིག་བྱུང་།",
    "བས་ཕྱི་མཆོད་རྟེན་གྱི་དབྱིབས་སུ་དུ་མི་བཟོད་པའི་མཁའ་འགྲོ་གསང་བའི་བརྡ་ཡིག་གིས་ཐེ་རྩེ་ནེ་རྩེར་ཁེངས་པ་ཞིག་འདུག་ར་བརྩམས་པ་ན།",
    "མིག་འཕྲུལ་ལྟར་ལ་མཆོད་རྟེན་གྱི་རི་མོའང་ཡལ།",
    "དེ་ན་རེ།",
    "ང་ཁྱེད་ལ་འདི་འདྲ་ཡོང་བསམ་པ་སྔ་མོ་རང་ནས་ཡོད་ཟེར་ཞིང་དག་སྣང་དཔེ་མེད་བྱེད་ཀྱིན་འདུག་པ་བཀའ་སྲུང་ས་པ་རྙེད།",
    "ཁའི་མོད་ལ་སྐོར་ལམ་བྱང་གི་ཁྱམས་སུ་སླེབས།",
    "ངེད་རང་གི་མ་དེ་ལ་སྟོན་དགོས་སྙམ་ཙ་ན།",
    "དེར་དྲན་པ་འཐོར་འགྲོ་བ་ལྟ་བུའི་དད་པ་དང་མོས་གུས་བཟོད་བླག་མེད་པ་ཞིག་སྐྱེས།",
    "ཞེས་མོས་གུས་ཀྱིས་བརྒྱལ་བཙམ་དུ་གསོལ་བ་བཏབ།",
    "ཆེ་བའི་ཡོན་ཏན་སངས་རྒྱ་ཏན་བྱེད་བཞིན་པར་ལགས་མོད་ཞུས་པས།",
    "ང་ལ་སྤྱན་ཧུར་གྱིས་གཟིགས་ནས།",
    "ཁྱོད་རང་གི་མགུར་མ་ཡང་ཤིན་ཏུ་བསླབ་སྟོན་འདྲ་ཞུ་སྙམ་པ་དང་།",
    "དེ་ནས་ཉང་ཕུག་འོག་མའི་ཐ་སྙད་བདག་གིས་ལྷོ་ཕྱོགས་ཕྱིཉང་ཕུག་གི་ཁ་བྱང་བྲིས་འདུག་ཀྱང་།",
    "དེ་རྗེས་མངའ་བདག་ཉང་གི་སྒྲུབ་ཕུག་ཡིན་པའི་ཉང་ཕུག་འོག་མར་གྲགས་པ་ངེད་རང་གིས་ངེས་བཟུང་ཞིང་གསང་ཆེན་མེ་ཏོག་ཕུག་ཏུ་བཏགས་པའི་གནས་སུ་བཅད་མཚམས་ཤིན་ཏུ་དམ་ཞིང་ངེས་འབྱུང་གིས་རྒྱུད་བརླན་པ་ཞིག་གི་ཚེ་ཨ་འཐས་གཟུང་ཡུལ་ཛཱན་ཆ་ཞིག་པའི་། སྣང་ངོར།",
    "གསང་མཛོད་ཆེན་མོའི་བརྡ་འགྲོལ་སྐབས་འདིར་གསུངས་པ་ཡིན།",
    "ཡང་འདི་ཁྱོད་རང་གི་སྐྱེ་བརྒྱུད་ལུང་བྱང་ཡིན་ནོ་ཞེས་ཤོག་དྲིལ་ཞིག་གནང་བྱུང་བ་ཁ་ཕྱེས་པས།",
    "གསུང་གི་བྱིན་གྱིས་བརླབབརྩམས་པར་རྗེས་སུ་གནང་བ་སྟེ་ཞལ་མཐོང་གཉིས་པའོ།",
    "དེའི་ཚེ་སྙན་ངག་གི་ལམ་ནས་དྲངས་ཏེ་རིག་པའི་གནས་ལྔའི་མོའི་རྒྱང་གླུ་ཞེས་བྱ་བ་འདི་ཡང་བརྩམས་ཏེ།",
    "ཐལ་འགྱུར་རྩ་རྒྱུད་རྨ་བྱའི་པ་འབྱུང་འགྱུར་ལུང་གི་ལྔ་ལྡན་སྒོར་བརྡོལ་བལས།",
    "ཕྱག་གིས་བླངས་ཤིང་འཕྲལ་རྐྱེན་མི་བསྲུན་བཙེམ།",
    "མངོན་སུམ་རྗེས་དཔག་འགལ་འབྲེལ་ག་གི།",
    "ལྷ་དང་གཙུག་ལག་ཁང་ལ་སོགས་པའི་བཟོ་རིགས་ས་སྲུང་དང་གསང་སྔགས་ཟབ་དོན་ནང་གི་རིག་པའི་མིག་སྟོང་བགྲད།",
    "སྐྱེས་པ་བུད་མེད་རི་ཤིང་རྒྱ་མཚོ་གོས་ནོར་ང་ཆེན་སོགས།",
    "སྒྲ་དབྱངས་ལྷ་མོ་འཇམ་པའི་རྡོ་རྗེ་ཡི།",
    "ཨེ་དབྱིངས་ཤེས་རབ་གཎྜའི་ཚལ་དུ་ཐབས་མཚེག་བདེ་གསལ་ཝཾ་ཡིག་གསར་པའྀ་རེ་བཱ་ནས།",
    "བསྒྱུར་བཀོད་པྲི་བསྣན་རྣམ་འགྱུར་བརྒྱ་ཡིས་རི་མོའི་གར་སྟབས་རྣམ་དག་གྲུབ་པའི་བསྒྱུར་བ་ལས།",
    "གོ་ལའི་ངོས་ཀྱི་དྲང་སྲོང་རྒྱུ་སྐར་འི་ལྟད་མོར་རྩེ་བ་མཐོང་།",
    "རང་ལྟ་མཆོག་འཛིན་ཕྱོགས་རེའི་མིག་ཅན་ལྟ་གྲུབ་སྒོ་པའི་སྦུབས་ལས་གྲོལ།",
    "གླེང་རྒྱལ་ཡིད་བཞིན་འཁོར་ལོས་ཞལ་གཟིགས་ལུང་བསྟན་ཀློང་ཆེན་པ།",
    "ཕྱོགས་རེའི་གཞུང་ལུགས་ཐལ་རྒྱུགས་མ་ཡིན་ཤེས་བྱའདྲེན་བྱེད་བརྒྱད་ཀྱིས་དཔྱོད།",
    "ནོར་འཛིན་བུ་མོའི་འགྲམཔར་བྱུང་སྔོན་སྐྱེས།",
    "ལུང་རྟོགས་ཡོན་ཏན་ཐིག་ལེ་མཆོག་མའི་བཞིན་གྱི་དཀྱིལ་འཁོར་མཐོང་བའི་མོད།",
    "ཕྱི་ནང་གཞུང་ལུགས་མང་དུ་ཐོས་པ་ལུངགི་ཡོན་ཏན་ཕ་མཐའ་མི་དཔོག་འཛམ་བུ་ཆུ་བོའི་སུ་ཝ་རྞ།",
    "ཕྱོགས་རེས་ལྟ་གྲུབ་ཁྲོན་པའི་ཆུ་ཡིས་ལྟོབ་སྦོས་པའི་ཀརྐ་ཊས།",
    "བསྟན་ལ་རི་མོར་བགྱིས་པ་ཡིན་ནོ་གྲགས་པ་དོན་ཆེན་པ།",
    "གཏད་མེདརང་གྲོལ་སྤྱོད་པར་གོམས་པས་རེ་དྭོགས་ཆོམ་རྐུན་ཟིལ་གྱིས་མནན།",
    "ཁྱོད་ཀྱི་སྤངས་རྟོགས་ནམ་མཁའི་མཐས་ཀྱང་ཐུག་པ་མེད་པའི་ངོ་མཚར་གཏམ་གྱི་བེ་རོཙ།",
    "གླིང་བཞིའི་སྣང་ན་བུ་མོའི་རྒྱན་དུ་བཏགས་པ་ལས།",
    "རང་མིན་གཉིས་པ་གཞན་ཞིག་ཡོད་སྙམ་འཕྱང་མོ་ཉུག་གི་དྲྭ་བར་བཙུད་དོ་ཀློང་ཆེན་པ།",
    "གང་གིས་རྒྱན་དྲུག་མཆོག་གཉིས་ཞུམ་ནུས་པའི།",
    "གཟུགས་སྐུའི་མཆོད་སྡོང་དཔལ་གྱི་མཆིམས་ཕུར་གདུང་ཆེན་ལྔ་དང་རིང་བསྲེལ་ཕྲ་མོའི་འབྱུང་གནས་སུ།",
    "ཡི་གེའི་ཟོལ་གྱིས་ཚེས་སྐུའི་རིང་བསྲེལ་ཕུང་པོར་བཞག་པའི་བཀའ་དྲིན་བསམ་གྱིན་ཐལ་མེ་སྦྱོར།",
    "རྗེས་སུ་ཞུགས་ཤིང་གང་གི་སྤངས་རྟོགས་ལེགས་བྲིས་ལམ་ལ་གེམས་པའི་བསྒྱུར་ནུས་ནས།",
    "ཞེས་པ་དོན་ལ་གནས་མོད།",
    "རྒྱ་བོད་ངེས་པའི་མན་ངག་གི་སྙན་བརྒྱུད་བཔེ་ཆད་པའི།",
    "དེ་ལྟར་ཀུན་མཁྱེན་ཆེན་པོས་བསྐུལ་ཞིང་དབྱིངས་ཀྱི་གཙོ་མོས་བརྡ་འགྲེལ་གྱིས་སྐབས་ངས་འཁོར་ཆེན་མོའི་དུས།",
    "མོས་གུས་ཀྱིས་བརྒྱལ་བ་ཙམ་གྱིས་རིག་སྟོང་མི་ཤིགས་པའི་དབྱིངས་སུ་འབྱམས་ཀླས་པ་ན།",
    "མ་འདྲིས་བཞིན་དུ་ལྷོ་རྒྱུད་སྤྲུལ་པའི་སྐུ་རྣམ་པ་གསུམ་སོགས་ཀྱིས་ད་ལན་ཐུགས་གཏེར་ཆེན་མོ་གཏན་ལ་འབེབསན་འབྲེལ་དུས་ལ་བབས་པར་གཟིགས་ཏེ།",
    "འདི་དག་གི་སྐབས་རྡོ་རྗེའི་གསུང་ལས།",
    "ཕྱི་ནང་གི་བདག་འཛིན་སྤངསད་རྒྱབ་ཁུར་གཅིག་ལས་མེད་ཅེས་པ་ལྟར།",
    "དེ་ནས་བུང་བ་མེ་ཏོག་གིཚལ་དུ་འདུ་བ་བཞིན།",
    "དེ་དག་རེ་རེའི་སྐུ་ཆེ་བའི་ཡོན་ཏན་བརྗོད་ཀྱིས་མི་ལང་ཞིང་སྔ་འགྱུར་གྱི་བསྟན་པས་ཕྱོགས་བཅུར་ཁྱབ་པར་མཛད་དེ།",
    "གསུང་གི་བདུད་རྩིས་བསྐྱངས་པའི་སློབ་ཚོགས་ཀྱང་།",
    "དེ་དག་གི་བརྒྱུད་སྲོལ་མཐའ་ཡས་ཤིང་།",
    "དེང་སང་རྫོགས་ཆེན་བཀའ་གཏེ་ཀ་སྣང་གསུམ་གྱི་མན་ང་ཆེན་མོ་སྙན་བཅུས་སུ་བཞུགས་པ་ནི་འདིའི་བཀའ་དྲིན་དང་ཕྲིན་ལས་ལས་བྱུང་བ་ཁོ་ནའོ། ། སློབ་ཚོགས་དེ་དག་ལས་རྡོ་གྲུབ་འཇིགས་བརྒྱུད་ཚུལ་འོག་ཏུ་འབྱུང་ལ།",
    "དེ་ཡང་འཕགས་པསྤྱན་རས་གཟིགས་དངོས་སུ་བྱོན་པ་འཇིགས་མེད་རྒྱལ་བའི་མྱུ་གུ་འཁྲུངས་པའི་ཡུལ་ནི།",
    "བྱང་ཐང་མེ་ཏོག་གི་སྐྱེད་ཚལ་ཉམས་དགའ་བ་རུམི་ཁྱིམ་བརྒྱ་ཕྲག་མང་པོའི་ནང་ཕྱུག་པོ་ཞིག་གི་བུ་རུ་ངོ་མཚར་བའི་རྟགས་སྣང་བཅས་སྲས་སྐུ་མཆེད་བཞིར་འཁྲུངས་པའི་ཆུང་བ་གཉིས་གཤེགས།",
    "ཡུལ་མི་ཀུན་གྱིས་ཁྱིམ་སྲིད་བཟུང་བར་རེ་ཆེན་བྱེད་ཀྱང་།",
    "མཁའ་འགྲོའི་མཚན་དང་ལྡན་པའི་བསྐྱེད་ཡུམ་གྱིས་བུ་ཁྱོད་ཚེ་འདིར་ཇི་ལྟར་བྱེད་པར་དེད་དྲིས་པ་ལ་ཐུགས་ཀྱི་མས་ཀྱང་།",
    "གནས་བདག་ཞིང་སྐྱོང་ཡབ་ཡུམ་མེན་པ་ཕོ་མོའི་རྣམ་པ་སྤྲུལ་ཏེ་འཚོ་བ་ཕུལ།",
    "ཞབས་ཤིན་ཏུ་ཆེ་བ་ཁྲུ་གང་ཙམ་ཡོད་པ་ཙཱ་དུ་བཞུགས་སྐབས་ཁ་བའི་སྟེང་ཞབས་རྗེས་མི་ཞིག་གིས་མཐོངང་རྗེས་དང་འཁྲུལ་པ་ཡོད་གསུངས།",
    "དེ་དག་གི་སྐབས་སུ་ཉམས་དང་རྨི་ལམ་གྱི་འཆར་སྒོ་དཔག་ཏུ་མེད་པ་བྱུང་ཞིང་།",
    "ཁྱེད་རང་ཚེ་སྨད་ཕ་ཡུལ་དུ་སོང་།",
    "མར་ལམ་བྱང་གནམ་མཚོ་བརྒྱུད་ཕེབས་པས་ཞབས་འབམ་བབ་སྟེ་ཆེར་ཕེབས་མ་ནུས་པ་ལ་ལུང་པ་ཞིག་གི་ནང་བྲག་ཕ་ཝཾ་ཆེན་པོ་ཞིག་འདུག་པའི་གྲིབ་མའི་ནང་ཉི་མའི་གུང་ཞིག་ནས་བཞུགས།",
    "དགོང་མོ་ཐུགས་དམ་སྤྱི་དང་རྐང་གླིང་ཌཱ་དྲི་ད་རྒྱས་པར་བཏང་།",
    "ཁྱོད་བླམ་ཆེན་པོ་ཞིག་ཡིན་པས་སྦྱིན་བདག་གིས་གདན་དྲོངས་ཤོག་ཟེར་ནས་ཆིབས་པརབྲོག་དུད་དེར་ཕེབས།",
    "ཞལ་ཕྱིར་གཟིགས་པས་ལུང་པའི་མདའ་ནས་འཇིགས་མེད་རྒྱལ་བའི་མྱུ་གུས་ས་གཞི་ཐམས་ཅད་ནག་པོར་གྱུར་པའི་ཤིག་འདེད་ནས་འོང་གི་འདུག་པ་རྨིས་པས་ངེད་གཉིས་འགྲེ་དོན་ཁྱོད་ཆེ་བར་བདུག་ཅེས་ལུང་བསྟན་པ་བཞིན་མངོན་དུ་གྱུར།",
    "བྱང་རྫ་རྒྱུད་ཀྱི་མི་སྐྱ་ཕོ་མོ་ཡན་ཆད་རྗེ་འདི་ལས་སྔོན་འགྲོའི་ཁྲིད་ཐོབ་སྟེ་འབུམ་ལྔ་དང་འཕེ་བ་མ་སྦྱང་བ་མེད་ཅིང་།",
    "། ན་གཉིས་མཛད་པ་ཡོངསནང་དབྱིངས་ཆེན་པོ་གཞོན་ནུ་བུམ་སྐུར་རེ་ཞིག་གཟུགས་སྐུ་བསྡུས་སོ།་",
    "རྗེ་གོང་མའི་སྐུ་ཚེ་སྨད་དུ་སེ་ཤུལ་གྱི་བུད་མེད་ཅིག་བག་མར་དུ་བཤས་ལུག་། མང་པོ་བསད་པ་གསན་པས།",
    "ཡེ་ཤེས་འབྱུང་གནས་སོགས་ཀྱི་སྤྲུལ་པ་ཡིན་གཏེར་སྤྱན་རས་གཟིགས་སེམས་ཉིད་ངལ་གསོའི་པར་གྲགས།",
    "སྨུག་པ་གདོང་གི་རིབག་ཅེས་བྱའི་རུས་སུ་ས་འབྲུག་ལོར་འཁྲུངས།",
    "ཕྱིས་ལོ་གཉིས་ལ་རྗེ་འདིས་ཞག་ཞེ་ལྔ་རེར་ང་བས།",
    "བརྒྱུད་ཡིག་འགའ་རེར་དཔལ་སྤྲུལ་མཁྱེན་བརྩེ་ཡེ་ཤེསརྡོ་། འཇོག་པ་ཡང་འདི་ས་དོན་ལ་གནས།",
    "མཁྱེན་བརྩེའི་ལྕེ་བཙུན་གཟིགས་པས་རྒྱ་གར་གྱི་གྲུབ་ཆེན་ལྟ་བུའི་ཚོད་དུ་འདུག།",
    "ཁོང་ཀུན་མཁྱེན་ཀློང་ཆེནརེད་སོགས་བསྔགས་བརྗོད་སྩལ།",
    "མངོན་ཤེས་ཐོགས་མེད་དུ་གཟིགས་པ།",
    "ཁོང་གིས་ཡོན་ཏན་མཛོད་ཀྱི་ན་བཅོས་མང་དུ་བརྩམས་པས་ཕྱི་རབས་ལ་ཐེག་གཅིད་གྱུར།",
    "པའ་བོ་གཙུག་ཕྲེང་གི་འགྲེལ་པ།",
    "རེ་ཞིག་ནས་སྐུ་ཅུང་ཟད་བསྙུན་ཚུལ་བསྟན་ནས་ཤར་ཕྱོགས་མངོན་དགའི་ཞིང་གི་ཆེ་བརྗོད་ཀྱང་མཛད།",
    "ཁྱོད་ཀྱི་གདུལ་བྱ་ཤར་ཕྱོགས་སུ་ཡོད་ཅེས་རྗེས་གསུངས་པ་དང་།",
    "རེས་སྤྲུལ་པ་གཅིག་སླར་ཡང་ཞིང་འདིར་འོང་དགོས་པ་འདྲ་སོགས་སྣ་ཚོགས་ས་ས་ཕག་ས་ག་ཟླ་བའི་ཚེས་བཙེ་བརྒྱད་ལ་སྐུ་གཤེགས།",
    "གཞན་ཡང་རེབ་ཀོང་གཙོས་དཔལ་སྤྲུལ་དང་།",
    "ངས་ད་ཙམ་ན་ངན་སོང་གསུམ་གྱི་སྡུག་བསྔལ་གཏན་ནས་པསམ་མི་ཕོད་པར་འདུག།",
