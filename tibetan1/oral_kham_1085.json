    "དེ་ལ་ཡུད་ཙམ་སུམ་ཅུ་རྣམས་དང་ཉིན་ཞག་དུས་ལ་ཆུ་ཚོད་དག་ཀྱང་དྲུག་ཅུ་ཁོ་ན་སྟེ།",
    "ཡང་དག་དུས་སྦྱོར་ཐམས་ཅད་ཀྱིས་ཏེ་སླར་ཡང་གལ་ཏེ་རང་ལུས་གཡོན་གྱི་རྩ་ལས་གྱུར་པ་ན།",
    "རང་རང་ཡི་གེས་ཤེས་བྱ་རྣམ་གསུམ་ཁྱབ་བདག་བགྲོད་པ་རྣལ་འབྱོར་པ་ཡིས་སྟོང་པའི་དབྱེ་བས་སོ།་",
    "གལ་ཏེ་བྱ་བ་དང་བཅས་གྱུར་ན་གཉིད་ལོག་དུས་སུ་འདི་ནི་རྨོངས་པ་ཉིད་དུ་ཇི་ལྟར་འགྲོ།",
    "ཤེས་རབ་གཙོ་བོའི་ཐུགས་ཀའི་པདྨ་ཉི་ཟླ་སྦྱར་ལྡན་ལ་སྟེ་རང་རང་རྡོ་རྗེ་ལྕགས་ཀྱུ་ཡིས།",
    "ལག་པའི་རྒྱབ་ཀྱིས་སོད་ཅིག་ངེས་པར་རབ་ཏུ་བརྗོད་དེ་མངོན་དུ་ཕྱོགས་པས་འདུག་ཅིག་འདུག་ཅིག་གོ།",
    "ངེས་པར་འཇམ་པའི་མལ་སྟན་དག་དང་གདན་ལ་ཉེ་བར་འདུག་ནས་སྔར་བརྗོད་བསྲུང་བ་བྱས་ནས་ནི།་",
    "ཕྱི་ནས་ཤེས་རབ་ལ་སོགས་དྲུག་ནི་རབ་ཏུ་གསལ་བར་བདག་པོ་རང་རང་པདྨའི་གདན་ལའོ།",
    "གདེངས་ཅན་རིགས་དང་བཅས་པ་རང་རང་ཕྱོགས་ཀྱི་བཞོན་པར་གནས་པའི་ལྷ་རྣམས་རྡོ་རྗེ་གདན་གྱིས་གནས།",
    "ཀཾ་ད་ཁྱབ་འཇུག་དུས་ཏེ་འཕྲོག་བྱེད་ཅེས་དང་ནོར་སྦྱིན་དག་ཀྱང་སཾ་དང་འདིར་ནི་ཋྐ་ཉིད་དོ།",
    "ཧཱུཾ་ཡིག་ཡེ་ཤེས་ལས་སྐྱེས་འཇིག་དུས་སྤྲིན་དང་མཚུངས་པ་རྩེ་ལྔ་འོད་ཟེར་དང་བཅས་དགོད་པར་བྱ།",
    "སྔགས་ཀྱིས་དགུག་པར་རབ་ཏུ་འགྱུར་ཏེ་གདོན་གྱི་ཚོགས་པ་མཐའ་དག་དུས་ཀྱི་སོས་ཟིན་རྗོད་པར་བྱེད།",
    "གཡས་པ་བརྐྱང་ཞིང་རང་རང་སྣོད་རྣམས་ཀྱིས་ནི་ལྷ་མིན་ཁྲག་འཐུང་སྐྲ་གྲོལ་གོས་དང་བྲལ་བ་སྟེ།",
    "སྣ་ཚོགས་དངོས་རྣམས་ཀྱིས་ཕྱེ་རྒྱལ་བ་དང་བཅས་ལྷ་མི་རྣམས་ཀྱི་རང་རང་སེམས་ལ་རབ་ཞུགས་པ།",
    "སུམ་ཅུ་རྩ་དྲུག་དུས་ཀྱི་ཕོ་ཉ་ཉིས་འགྱུར་མི་བདག་གཞན་རྣམས་ཚེས་ནི་བརྒྱད་གཉིས་དབྱེ་བ་ལ།",
    "རང་རང་ཚད་ཀྱིས་རྒྱལ་བའི་བདག་པོའི་རྐང་པ་དབུགས་ཀྱི་དབུས་སུ་འགྲོ་དང་གནས་པ་ཤེས་པར་བྱ།་",
    "དེ་ཡི་དུས་སུ་རྒྱལ་པོའི་འགྲོ་བ་དག་ནི་རང་རང་ཚད་ཀྱིས་རྣམ་པར་ཉམས་པར་རབ་ཏུ་འགྱུར།་",
    "ཉི་ཤུ་འགའ་ཞིག་ལྷག་པའི་བརྒྱ་ཕྲག་གང་ཞིག་དུས་དང་དགུ་ཡིས་མི་རྣམས་ཀྱི་ནི་འཇིག་རྟེན་ཚད།",
    "ལེགས་སྦྱར་མཉམ་པར་བཞག་དུས་བསྐྱངས་པ་དང་།",
    "ཞེས་པས་མགུལ་ཆིངས་དའི་དེ་དག་ལ་གུ་གུལ་གྱིས་འདུག།",
    "དེ་དག་དུས་ཀྱི་ཁྱད་པར་རོ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཧཱུྃ་ཕཊ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུྃ་ཧཱུཾ་ཕཊ།",
    "རྡོ་རྗེ་སེམས་དཔའི་ཅོད་པན་ཅན་མཉམ་པའི་འདུག་སྟངས་ཀྱིས་བཞུགས་པའོ།",
    "འཇིམ་པའི་ང་པོ་སོགས་ས་བ་གས་ནས་ཡི་དམ་ཐུགས་རྗེ་ཆེན་པོའི་སྐུ་ཇི་བཞིན་བཞེང་དགོས་པར་ཤར་བ་དང་ནང་པར་རྒྱལ་པོ་ཉིད་ཀྱི་ཡིད་ལ་འདོད་པ་ཇི་ལྟ་བ་བཞིན་རྒྱགས་རྗེ་ཆེན་པོའི་སྐུ་རང་བྱོན་དུ་བྱོན་ནས་གདའོ།",
    "གལ་ཏེ་བདེན་ན་ང་ཡིས་ཁོ་ཙོ་མིར་དཀའ་བ་ཞིག་འདུག་སྙམ་སྟེ།",
    "མཐོང་བ་དང་རྔམ་ཞིང་འཇིགས་པ་ཞིག་འདུག་གོ།",
    "དེ་ངོ་མཚར་མི་ཆེ་འམ་ཞེས་བྱ་བ་འདུག་པས།",
    "དེ་ངོ་མཚར་མི་ཆེ་འམ་ཞེས་བྱ་བ་འཁོད་འདུག་པས།",
    "ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པ་ན་དེ་ངོ་མཚར་མི་ཆེ་འམ་ཞེས་འཁོད་འདུག་པས།",
    "གཞན་གྱིས་མ་བྱུང་བར་འདུག་པས་ལྷ་གཅིག་ངེད་འ་ཞུ་བྱས་པས།",
    "གཞན་གྱིས་མ་བྱུང་བར་འདུག་པས་ལྷ་གཅིག་རྒྱའོ་བྱས་པས།",
    "རྒྱལ་པོའི་ཞལ་ནས་ཁྱེད་རང་བློན་པོ་ཐམས་ཅད་ཕྱིར་ལོག་ལ།",
    "ལ་ལ་སྒོ་མ་བརྙེད་ནས་རྒྱ་སྲང་ན་ཉལ་འདུག་གོ།",
    "གཞན་གྱིས་ཁང་པ་མ་བརྙེད་པར་འདུག་པས་ལྷ་གཅིག་ཞུའོ་བྱས་པས།",
    "ལྷ་གཅིག་དེ་དང་ཁྱེད་གཉིས་ཤིན་ཏུ་མཐུན་པར་ཡོད་འདུག་པས།",
    "གལ་ཏེ་ཁོ་ཚོས་ངོ་མ་ཤེས་པར་འདུག་ནས།",
    "དེ་མི་གོང་དུ་འདུག་པ་དེ།",
    "དི་ཡི་གོང་ན་འདུག་པ་དེ།",
    "དེ་ཡི་སུང་ན་འདུག་པ་དེ།",
    "དེ་ཡི་གོང་དུ་འདུག་པ་དེ།",
    "དེ་ཡི་གོང་ན་འདུག་པ་དེ།",
    "དེ་ཡི་གོང་ན་འདུག་པ་དེ།་",
    "བོད་ཀྱི་རྒྱལ་པོ་དེ་མངོན་ཤེས་རྫུ་འཕྲུལ་མཐུ་སྟོབས་དང་ལྡན་པ་ཞིག་ཡོད་པར་འདུག་དེ་འབྲེལ་རྣམ་དཔྱོད་ལྡན་པ་དང་།",
    "ས་གཞི་བྱིན་ཆགས་ཤིང་བདེ་སྐྱིད་དང་ལྡན་པ་ཡོད་འདུག་ན།",
    "འཕགས་པ་ཐུགས་རྗེ་ཆེན་པོ་དངོས་སུ་འདུག་ཐབས་མཁས་ཐུགས་རྗེ་ལྡན་པའི་རྒྱལ་པོ་ཡིན།",
    "འོ་ན་བོད་དུ་སོ་ནམ་བྱ་གཏུབ་པ་འདུག་གསུངས་ནས་ཉུང་མའི་ས་བོན་ཡང་དར་ལེ་བརྒན་ནང་བཏུམས་ནས་སྐྲ་གསེབ་ཏུ་བཅུགདེ་ནས་ཇོ་བོ་ཤཱཀྱ་མུ་ནི་ཤིང་རྟའི་སྟེང་དུ་བཞག་དེ་རྒྱུད་ལྷ་དགའ་ཐུ་དགའ་བྱ་བ་རྒྱ་ཡུལ་གྱི་མི་སྟོབས་ཆེ་བ་གཉིས་ཀྱིས་འདྲེན།",
    "རིད་པ་འདུག་ཅིང་།",
    "ངོ་ཞན་བློན་པོའི་སྙུན་གཞི་འགྱུར་འདུག་མེ་ཡི་རང་བཞིན་དུ་འདུག།",
    "བློན་པོའི་བསམ་པར་ད་ནི་ངས་གླགས་རྙེད་པ་འདུག་རིབ་མ་ནས།",
    "ཁྱེད་རང་ཚེ་སྨད་དུ་ཡེར་པ་ཟླ་བ་ཕུག་ཏུ་སྒྲུབ་པ་ཞིག་གྱིས།",
    "ཕྲན་ནི་ནུས་པ་མེད་ཅིང་ལྟ་དགོངས་དམན་པ་དེ་རིགས་བསམ་ངན་དུ་འདུག།",
    "བླ་བྲང་སོགས་དང་རྒྱ་མིས་ཁ་འཕྲལ་བ་ལ་སེམས་ཕམ་ཅི་ཡང་མི་འདུག།",
