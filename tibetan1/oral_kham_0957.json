    "ཞེས་སོགས་གསུངས་འདུག་པ་ལྟར་རྗེ་ཉིད་ཀྱི་འཕྲིན་ཡིག་ཁག་ལ་ཞིབ་ཏུ་མཇལ་ན་སྐབས་དེའི་གནས་ཚུལ་ཟ་ཟུར་ནས་རགས་ཙམ་ངེས་ཐུབ།་",
    "མནལ་སད་ཙ་ན་དེ་བཞིན་དུ་གྱུར་འདུག་མི་དེ་ཐུགས་རྗེ་ཆེན་པོ་ཡིན་པར་འདུག་གསུངས།",
    "བོད་ཀྱི་རྒྱལ་བློན་རྣམས་བྱང་སེམས་སུ་འདུག་ཁྱད་པར་ལྷ་བཙུན་ཁུ་དབོན་བྱང་སེམས་སུ་འདུག་ངའི་ཕྱིར་བོད་ཀྱི་མི་ནོར་མང་བོ་ཡང་ཆུད་ཟོས་པས་ངོ་ཡང་གནོང་།",
    "ནནི་ན་༨པ་ཀ་བཔ་ལ་ལོ་གསུམ་ཐོགས་པར་འདུག་སྟེ་དེ་ཙམ་སྡོད་ནུས་སམ་གསུངས་པས།",
    "ཅེས་གསུངས་གདའ་བ་གསུངས་པས།",
    "འོན་ཀྱང་རང་ལ་འབུལ་རྒྱུའི་དངོས་པོ་ཡོད་བཞིན་དུ་དངོས་པོ་ལ་རག་མ་ལས་ཞེས་ས་སེར་སྣས་བཅིངས་བཞིན་དུ་མ་ཕུལ་ན་ནི།",
    "ཅུང་ཟད་གུག་ཅིང་དྲང་བོར་གཞག་སོ་དང་མཆུ་རང་བབས་སུ་གཞག་ལྕེ་རྩེ་ཡ་སོའི་དྲུང་དུ་གཞག་ལ་དྲན་པ་ནང་དུ་བཞག་སྟེ་འདུག་པར་བྱ།",
    "འདིར་ལུས་ཀྱི་འདུག་སྟངས་འདི་ལྟར་གལ་ཆེན་དུ་འཛིན་དོན་ནི།",
    "དེ་ལས་ལྡོག་སྟེ་ཆུ་རྐ་འབར་འབུར་ཅན་གྱི་ནང་དུ་ཆུ་ཤར་མར་རྒྱུག་མི་ཐུབ་པ་ལྟ་བུ་ཡིན་ཙ་ན།",
    "བོད་ཀྱི་ཉམས་ལེན་ཀུན་བསྡོམས་ཀྱང་ཁོ་མར་བ་ལོ་ཙ་བའི་འདུག་ལུགས་གཅིག་པུ་ལའང་དོ་མི་བསྡོ།",
    "བོད་ཀྱི་ཉམས་ལེན་ཐམས་ཅད་ཕྱོགས་གཅིག་ཏུ་བསྡོམས་ཀྱང་ཁོ་མར་བ་ལོ་ཙཱ་བའི་འདུག་ལུགས་གཅིག་པུའི་དོ་ཟླ་ཡང་མི་ཡོང་གསུངས་པས་ན་ལུས་ཀྱི་འདུག་སྟངས་འདི་ཤིན་ཏུ་གལ་ཆེན་པོར་འདུག་གོ།",
    "དེའི་ངང་དུ་གནས་འདུག་པ་མ་ཡིན་པར་དེ་ནས་དལ་འབྱོར་རྙེད་དཀའ།",
    "བརྩོན་པ་གཏན་ནས་མེད་པར་རང་དགར་བག་མེད་དོན་མེད་དུ་ཕྱོགས་སོ་སོར་འཁྱམས་ནས་འདུག་པའི་མི་ཞིག་དང་མཚུངས།",
    "དེས་ན་ང་རང་ལྟ་བུ་ཐ་མལ་བ་ལ་མཁོ་ཆེ་བ་ནི།",
    "དེ་བཞིན་དུ་འཆི་བ་མི་རྟག་པ་རྒྱུད་ལ་སྐྱེས་ཡོད་པ་ཞིག་ལ་ཁྱེད་རང་ས་སྐྱིད་ས་འདི་ནས་སྤྲོ་བསང་ལ་རོལ་བར་གྱིས་ཞེས་ཇི་ལྟར་ནན་བསྐུལ་བྱས་ཀྱང་སྡོད་མི་སྲིད་དེ།",
    "སྦྱང་བྱའི་བློ་དེ་རང་རྒྱུད་ཀྱི་བློ་འདི་ལ་གོ་དགོས་པ་ཡིན་ཙ་ན།",
    "འདུག་ཡུན་དུས་ཚོད་ལྔ་ནས་དྲུག་ལྟ་བུ་ཅུང་རིང་བོར་བསྡད་ན།",
    "སྒོམ་ཙ་ན་བསྒོམས་པས་དར་ཡུག་དང་ཇ་སིག་མང་བོ་ཡོང་བས་ན།",
    "སྒོམ་ཙ་ན་སྐྱེ་བའི་རྒྱ་མཚོ་མཐར་དབྱུང་།",
    "འོན་ཀྱང་རང་ལ་ད་དུང་མི་འཆི་མི་འཆི་སྙམ་པའི་རྟག་འཛིན་ཁོ་ནས་བཅིངས་པས་འདི་བསལ་ནས་ཚེ་འདིའི་འཚོ་ཐབས་བདེ་ཐབས་ཁོ་ན་སྒྲུབ་པའི་བསམ་སྦྱོར་དུས་སྐད་ཅིག་ཙམ་ཡང་མེད་པར་བྱིན་གྱིས་རློབས་ཤིག་ཅེས་གསོལ་བ་འདེབས།",
    "འོན་ཀྱང་ང་རང་ལྟ་བུ་ཡིན་ན་ཐོག་མ་མེད་པ་ནས་རང་བདེ་ཁོ་ན་པ་ཆུལ་བམམར་ན་བློ་བསམས་པས།",
    "དེས་ན་གདམས་ངག་ཅེས་པ་ནི་གང་ཟག་རང་རང་ལ་བལྟོས་ནས་འཇོག་དགོས་ཏེ།",
    "མེའི་དོང་དུ་མཆོངས་པར་མཛད་པ་སོགས་དཀའ་སྤྱད་བསམ་གྱིས་མི་ཁྱབ་པ་མཛད་དགོས་བྱུང་འདུག་ན།",
    "རྒྱུ་དེ་ཡང་རང་དང་མཐུན་པའི་རྒྱུ་ལས་བྱུང་བ་ལས།",
    "༣ སཾནྟི་ས་ཨ་ཏེ་ཟས་ངན་ཤོས་བཟའ་དགོས་པར་འདུག་ཉིན་གཅིག་ལ་ཕ་སྤད་དེ་ཕ་བུ་གསུམ་གྱིས་སྨེའུ་ཟན་ནམ་ནས་ཀྱི་རྩམ་པ་བཟའ་རྒྱུ་རྙེད་དེ་ཟོས་པས།",
    "ཁྱེད་རང་ཟན་སྐུལ་ཁྱིས་ཁྱེར་བ་ལ་དུ་བ་ཡིན་ན་ད་མ་ངུ་ཞིག་བྱས་པས།",
    "ངན་འགྲོའི་ལུས་བླངས་པ་ལ་བལྟོས་ཏེ་ལན་གཅིག་ཐོབ་པ་ལྟ་བུའི་ཚོད་དུ་འདུག་པས་ན་དེ་ལྟར་གསུངས་སོ།",
    "གཞན་གྱི་ལུས་རྟེན་བཟང་བོ་ཇི་འདྲ་མང་ཡང་རང་ལ་ཕན་པ་གཏན་ནས་མེད་དེ།",
    "ས་འ་ཀ་༤་ ཀ་འབྱོར་རྙེད་དཀའ་བ་འདི་བསམས་ཙ་ན།",
    "གཉིད་ལོག་ལོང་རང་མི་གདའ་ལགས་གསུངས།",
    "དཔེར་ན་ང་རང་ལྟ་བུར་མཚོན་ན།",
    "ཁོ་རང་གར་འགྲོ་འདིར་འགྲོ་མེད་༡ ས་ནཚ་ན་ན།",
    "མི་ནག་པོ་ཞིག་འོངས་ནས་ཁྱེད་རང་མ་ལ་མཇལ་འདོད་དམ་ཞེས་དྲིས་བྱུང་བར།",
    "རང་རང་གང་ན་གནས་པའི་ས་དེར་གོ་ནའང་ཆོག་དཔེར་ན།",
    "མི་ཤི་ན་སྐྱེ་བ་ཕྱི་མར་སླར་ཡང་མིར་སྐྱེ་བར་འགྱུར་སྙམ་དུ་བསམ་པར་འདུག་པས།",
    "སྔོན་མི་སུམ་ཅུ་རྩ་གཉིས་ཀྱིས་གླང་གཅིག་བརྐུས་ནས་བསད་པས་ཚེ་རབས་ཐམས་ཅད་དུ་མི་དེ་དག་དུས་གཅིག་ཏུ་བསད་ཅིང་།",
    "ཉེས་པ་རྣམས་ཀྱི་ནང་ནས་ཀྱང་རང་ལ་འབྱུང་ཉེ་བའམ་འབྱུང་སླ་བ་གང་ཡིན་པ་དེ་ལ་དྲན་ཤེས་བསྟེན་པ་གལ་ཆེ་བས།",
    "བ་ན་ནི་༦པ་ལ་ནས་སས་ག་འལ་ན་ཡང་ག་ཆའ་ས་ཙ་ན་བ་༣།",
    "སྔར་དེ་ཙམ་ཞིག་འཁྱམས་པ་ལ་རང་ལོག་མ་བྱུང་ཙ་ན།",
    "ད་ཡང་རང་ལོག་མི་ཡོང་བས་ལྡོག་དགོས།",
    "སྐྱེ་ནའང་རང་ཉིད་གཅིག་པུ་སྐྱེས་ལ།",
    "ཤི་ནའང་རང་ཉིད་གཅིག་པུ་ཤི་དགོས་པས།",
    "དེ་ཡང་ས་ལ་ཙོག་མ་ཐག་ནས་བདེ་བའི་རྣམ་པ་ལྟ་བུ་ཞིག་ཏུ་འདུག་ནའང་ཙོག་ཡུན་ཅུང་རིང་ན་ནི་སྔ་མའི་བདེ་བའི་ངོ་བོ་དེ་འགྱུར་ཏེ་རྐང་བའི་ཚིགས་ན་བ་སོགས་སྡུག་བསྔལ་གྱི་རང་བཞིན་དུ་འགྱུར་བ་འདི་ལས་ཤེས་ཐུབ།",
    "སྤྱིར་མན་ངག་ནི་བྱ་བ་གང་ཞིག་ཡིན་ཡང་རུང་དེ་ཡུན་རིང་བོ་དང་ཚེགས་ཆེན་པོས་སྒྲུབ་དགོས་པ་ཞིག་དུས་ཐུང་ངུ་ཙམ་དང་ཚེགས་ཆུང་ངུ་ཙམ་གྱིས་འགྲུབ་པའི་ཐབས་ཤིག་ལ་གོ་དགོས་ཏེ།",
    "དེའི་གོང་དུ་འདུག་པ་དང་།",
    "རྒྱལ་བའི་བཀའ་ས་བོན་བྱས་ནས་གསུངས་ཙ་ན།",
    "དེ་ནི་ཁྱེད་རང་ས་ཟླཀ་ཀ་ས་ཀ་༤ ཉིད་ཀྱིས་ཆེ་བརྗོད་བྱས་པ་ཙམ་ལས་དོན་ལ་གནས་པ་མ་ཡིན་ནོ་སྙམ་ན།",
    "དེས་ཚོ་བའི་ཤ་ཡང་ཞེན་པ་ལོག་པ་ཞིག་ཏུ་འདུག་སྙམ་པ་ལྟ་བུའི་བློ་ཡང་ཡང་བསྐྱེད་ན་ནམ་ཞིག་ཕག་ཤ་དེ་ལ་དགའ་བའི་བློ་ལོག་པར་འགྱུར།",
    "འདིའི་ཆ་ནས་ཀྱང་རང་ལ་དྲིན་ཆེ་བ་ཡིན་པ་སོགས་མའི་དྲིན་ཆེ་ཚུལ་རྣམས་རིམ་པ་བཞིན་དུ་སྒོ་སྣ་༥་ སབན་༨་༣ ཚོགས་ནས་བསམ་ན་དྲིན་དྲན་པའི་བློ་ཤུགས་ཇེ་དྲག་ཏུ་འགྲོ་བས་དེ་ལྟར་དྲིན་དྲན་པར་བྱ་དགོས།",
    "ད་ལྟའི་བར་དུ་སྡུག་བསྔལ་རྒྱུན་མི་ཆད་དུ་མྱོང་དུ་འཇུག་མཁན་དེ་ཡང་རང་གཅེས་འཛིན་གྱི་བློ་ངན་འདི་ཡིན་ལ།",
    "ང་རང་ལ་མཚོན་ན།",
    "ཐོབ་མི་སྲིད་པ་ལྟ་བུ་ཞིག་ཏུ་འདུག་ལ།",
    "གྲངས་བརྒྱ་ཙམ་ནི་དུང་ཕྱུང་དང་བསྡུར་ན་ཤིན་ཏུ་ཉུང་བའི་ཚོད་དུ་འདུག་པ་ལྟ་བུར་སྣང་བས།",
    "ལེ་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "རྒྱུ་དེ་ཡང་རང་དང་མཐུན་པའི་རྒྱུ་ལས་སྐྱེས་པ་མ་གཏོགས།",
    "དགེ་སྦྱོར་བྱས་ཀྱང་རང་རྒྱུད་མི་ཐུལ་ཚོས།",
    "ལས་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "འོན་ཀྱང་ད་ལྟ་ཟས་ཀྱིས་ངའི་ཁ་བཙལ་ནས་མི་རྙེད་པའི་ཚོད་དུ་སླེབས་འདུག་པས།",
    "གླང་རི་ཐང་བ་འདི་ཁོང་རང་ཉིད་ལས་འུ་ཅག་རྣམས་ལ་གཅེས་པར་བྱེད་ན་གནོད་པ་བྱེད་ག་ལ་རུང་ཟེར་ནས་གནོད་པ་མ་བྱས་པར་ཕྱིར་ལོག་པའི་གཏམ་རྒྱུད་ཡོད་དོ།",
    "ལེ་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "རང་རྒྱུད་ཀྱི་གཅེས་འཛིན་འདི་དགྲར་བཟུང་ནས་ལེ་ལན་འདིའི་སྟེང་དུ་གདའ་བ་དང་།",
    "འཇིག་རྟེན་ན་སྡུག་བསྔལ་དང་ཉེས་པའི་སྐྱོན་གང་ཇི་སྙེད་ཅིག་ཡོད་པ་དེ་དག་ཀུན་ནི་རང་གཅེས་པར་བཟུང་ནས་རང་ཉིད་འབའ་ཞིག་དུས་ཀུན་ཏུ་བདེ་བའི་ཐབས་སུ་བྱ་མིན་ལ་འཇུག་པར་འདོད་པའི་བསམ་པ་དམན་པ་ལས་བྱུང་བ་ཡིན་པས་ན།",
    "ནམ་ཙ་ནར་ས་དབུལ་ཞིང་ཕོངས་པ་ནི་གཞན་ལ་ཕན་པའི་བསམ་པ་མེད་པར་རང་གཅིག་པ་པུའི་ཆེད་དུ་ལོངས་སྤྱོད་གསོག་པར་འདོད་ནས་སེར་སྣ་བྱས་པའི་མཐུ་ཁོ་ན་ལས་འབྱུང་།",
    "ལྷག་པར་ཕ་མ་དང་འཇིག་རྟེན་གྱི་ཡ་རབས་རྣམས་དང་རང་ལས་རྒན་པ་རྣམས་དང་མཁན་སློབ་སོགས་ཡུལ་ཁྱད་པར་ཅན་རྣམས་ལ་གུས་པར་རིམ་གྲོ་བྱས་པ་ལས་འབྱུང་།",
    "གཞན་གཅེས་པར་འཛིན་པའི་བློ་ནི་ལས་དང་བོ་བའི་རྒྱུད་ལ་ཤིན་ཏུ་འབྱུང་དཀའ་བའམ་འབྱུང་མི་སྲིད་པ་ལྟ་བུ་ཞིག་ཡིན་ཙ་ན།",
    "ལམ་བསྒྲུབས་པས་དེའི་འབྲས་བུ་འབྱིན་པ་ཡིན་ཙ་ན།",
    "འཇིག་རྟེན་ན་སྡུག་བསྔལ་དང་ཉེས་པའི་སྐྱོན་གང་ཇི་སྙེད་ཅིག་ཡོད་པ་དེ་དག་ཀུན་ནི་རང་རང་གཅེས་པར་བཟུང་ནས་བདག་ཉིད་འབའ་ཞིག་དུས་ཀུན་ཏུ་བདེ་བའི་ཐབས་སུ་བྱ་བ་མིན་པ་ལ་འཇུག་པར་འདོད་པའི་བསམ་པ་དམན་པ་ལས་བྱུང་བ་ཡིན་པས་ན་རང་གཅེས་པར་འཛིན་པ་ནི་རྒུད་པ་ཀུན་གྱི་སྒོར་ཤེས་པར་བྱའོ།",
    "གཞན་གྱི་སྡུག་བསྔལ་དག་ལའང་རང་དང་མཚུངས་པར་འདོར་ལེན་ཚུལ་བཞིན་དུ་བྱེད་པ་སྟེ་བདེ་བ་སྒྲུབ་པ་དང་།",
    "གཞན་གཅེས་པར་འཛིན་པ་ནི་ཕན་བདེ་ཐམས་ཅད་ཀྱི་འབྱུང་གནས་སུ་མཐོང་ནས་སྔར་རང་ལ་གཅེས་པར་འཛིན་པ་དེའི་ཚབ་ཏུ་འགྲོ་བ་གཞན་ཐམས་ཅད་གཅེས་པར་འཛིན་ཅིང་རང་ཡལ་བར་འདོར་བའི་བློ་བསྐྱེད།",
    "བདེ་བ་ཁྱད་དུ་འཕགས་པ་རྣམས་ལྟ་ཞོག་སྡུག་བསྔལ་ཕྱིར་བཅོམ་པའི་བདེ་བ་ཙམ་ཡང་རྙེད་པར་དཀའ་འདུག་ད་དུང་ཡང་སྡུག་བསྔལ་འབའ་ཞིག་འཐོབ་པ་ལས་བདེ་བ་འཐོབ་པ་དཀའ་སྟེ།",
    "མི་དམིགས་པ་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་རྣམ་པ་ཉིད་ཡིན་པས་དངོས་པོའི་ཡུལ་ཅན་ལས་འདས་པ་མ་ཡིན་ནོ།",
    "དེ་ཡང་རང་རིག་པས་གྲུབ་པའི་ཕྱིར།",
    "དམིགས་པར་བྱ་བ་ཡང་རང་རང་ལ་ངེས་པ་ཡིན་པའི་ཕྱིར་ན།",
    "གལ་ཏེ་བྱ་བའམ་རྣམ་པར་རྟོག་པའི་ཕྱི་རོལ་རྟོགས་པར་བྱེད་པ་ཡང་རང་རྒྱུད་ཁོ་ན་ཡིན་ཏེ།",
    "འབྲེལ་པ་དང་མ་འབྲེལ་པ་བརྗོད་ན་ཉེས་པ་སོ་ན་འདུག་གོ་ཞེས་བརྗོད་པ་ནི།",
    "འོ་ན་ཕྱི་རོལ་ན་འདུག་པ་མཐོང་བ་ཡིན་ནོ་སྙམ་ན།",
    "ཅི་སྟེ་ཡང་རང་བཞིན་གང་ཞིག་རྣམ་པར་རྟོག་པ་ལ་སྣང་བའི་རང་བཞིན་དེ་ནི་ཐ་དད་པའམ་ཐ་མི་དད་པ་ཡིན་ཡང་སླ་སྟེ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཅི་ལྟར་ཐ་དད་ཅེ་ན།",
    "འོན་ཏེ་ཡང་ཤེས་པ་བཞིན་དུ་དེ་མེད་པར་ཡང་རང་ཉིད་ལས་འགྲུབ་པ་དེས་ན།",
    "ཐུག་པ་མེད་པ་མ་ཡིན་ན་དེ་ལྟ་ན་དོན་མེད་པ་ཡང་རང་ལས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ཤེས་པ་མེད་པ་ཡང་རང་ལས་འགྲུབ་པ་མ་ཡིན་པས་ན་ཐུག་པ་མེད་པ་ཁོ་ནའོ།",
    "ཅི་སྟེ་ཡང་མངོན་སུམ་གྱི་ཡུལ་དང་རང་བཞིན་ཡུལ་གཅིག་ཉིད་དུ་རྣམ་པར་རྟོག་པས་ཞེན་པར་བྱེད།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་དང་འབྲེལ་པའི་ཕྱིར་གོ་བར་བྱེད་པ་ཉིད་ཡིན་ནོ།",
    "སྐད་ཅིག་སོ་སོར་མི་འཇིག་ན་མཐའི་སྐད་ཅིག་ལ་ཡང་རང་བཞིན་དེ་ཉིད་ཡིན་ཏེ།",
    "ལྐོག་ཏུ་གྱུར་པ་ལ་འཇུག་ཀྱང་རང་བཞིན་དངོས་སུ་མེད་པ་ཁོ་ནའོ་སྙམ་ན།",
    "འོན་ཀྱང་འདུག་བཞིན་དུའོ།",
    "འདིར་ཡང་རང་བཞིན་དུ་འགྱུར་རོ་སྙམ་ན་སྣ་ཚོགས་པ་ནི་འདིར་ཞེས་བྱ་བའོ།",
    "གཞན་ཡང་རང་རིག་པ་ཡིན་ན་ནི་ཤེས་པ་གཞན་རིག་པ་ལ་དགོས་པ་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེས་ན་བདག་དེ་ཡང་རང་རིག་པའམ་གཞན་རིག་པར་འགྱུར་ཞེས་པའི་བརྒལ་ཞིང་བརྟག་པ་འདི་ཉིད་ལས་འཕར་བ་མ་ཡིན་ནོ།",
    "གཞན་ལ་ཕྱོགས་པས་ཀྱང་རང་བཞིན་གཞན་ཁོ་ན་རིག་པ་དེས་ནའོ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་རྣམས་འབྲེལ་པ་སྟེ།",
    "འདིས་ནི་ཡིད་ཀྱི་མངོན་སུམ་དང་རང་རིག་པ་ཡང་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་ཡོད་པ་དང་རང་རིག་པ་ལ་སོགས་པའོ།",
    "རང་བྱུང་རང་ཉིད་ཁོ་ན་སྤྲུལ།",
    "འདོད་ཆགས་དང་འདོད་ཆགས་མེད་པ་དག་དུས་གཅིག་ཏུ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དག་དུས་མཚུངས་པ་ཁོ་ན་ཡིན་ཏེ།",
    "བློས་ཅི་བྱ་དེས་ན་ཉེས་པ་སོ་ན་འདུག་གོ་ཞེས་དགོངས་པའོ།",
    "དེའི་ཚེ་ངེས་པ་ཡང་རང་ཉིད་ནུས་པ་མེད་པར་ཇི་ལྟར་བྱེད།",
    "གཞན་ལ་ཡང་རང་བཞིན་དུ་གྱུར་པའི་ཉམས་སུ་མྱོང་བའི་ངོ་བོ་ཡོད་ན་དེའི་གཞན་ཉིད་དུ་མི་འགྱུར་རོ།",
    "དེས་ན་རྗེས་སུ་དཔག་པ་མཐའ་ཡས་དག་འཆད་པ་ནི་སོ་ན་འདུག་གོ་ཞེ་ན།",
    "གསལ་བ་ཡང་རང་ལས་འགྱུར་བ་ཉིད་དེ་ལྟར་ན་མཐོང་བ་ནི་རང་ཉིད་ཁོ་ན་གསལ་བར་ཁས་ལེན་པ་དེ་བཞིན་དུ་གསལ་བར་བྱེད་པ་ཐ་དད་པས་ཅི་ཞིག་བྱ་ཞེས་དགོངས་པའོ།",
    "སྔོན་པོ་ལ་སོགས་པ་ཡང་རང་རིག་པར་བྱ་བའི་དོན་ཏོ།",
    "གཉིས་ཀའི་རང་བཞིན་ཞེས་བྱ་བ་ནི་རྫས་དང་རང་རིག་པའི་རང་བཞིན་ནོ།",
    "གལ་ཏེ་ཡུལ་ཐ་དད་པས་གཅིག་མ་ཡིན་ན་དེའི་ཚེ་བདག་ཀྱང་རིག་པར་བྱེད་པ་དག་ཀྱང་རང་བཞིན་ཐ་དད་པས་ན་ཇི་ལྟར་གཅིག་ཡིན།",
    "དེ་ལས་ཞེས་བྱ་བ་དང་རང་བཞིན་ལས་ཐ་དད་པར་མི་མཐོང་བའི་ཕྱིར་ཐ་དད་པར་མ་གྲུབ་པོ་ཞེ་ན།",
    "གལ་ཏེ་ཇི་ལྟར་བློ་རང་རིག་པས་གྲུབ་པར་ཁས་བླངས་ནས་དོན་ཡོངས་སུ་འདོར་བ་དེ་བཞིན་དུ་དོན་ཡང་རང་རིག་པར་ཁས་བླངས་ནས་བློ་དོར་བར་བྱའོ་སྙམ་ན།",
    "དེའི་ཞེས་བྱ་བ་རྣམ་པར་ཤེས་པའི་བདག་ཉིད་ལ་ནི་ཇི་ལྟར་ཐ་དད་པར་མཐོང་རང་བཞིན་དེ་ཉིད་ནི་གཞན་དུ་འགྱུར་བ་མ་ཡིན།",
    "དེ་ལྟ་ན་ཡང་རྗེས་དཔག་དུས་སུ་སྔར་མ་རྟོགས་པ་ན་དོན་ཐམས་ཅད་ཀྱི་རྣམ་པ་ཐམས་ཅད་དུ་རྟོགས་པར་འགྱུར་རོ།",
    "འོན་ཀྱང་གང་ལ་ཡང་རང་རིག་པ་ཡོད་པ་དེ་ལ་ནི།",
    "འོན་ཀྱང་རང་རིག་པ་ལའོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ཉིད་དེ་རིང་ན་འདུག་པའི་དངོས་པོ་ཉིད་གསལ་བའི་ཕྱིར་ཐག་རིང་པོ་མ་ཡིན་ནོ་ཞེས་རྗོད་པར་བྱེད་དེ།",
    "རྣམ་པ་དང་བཅས་པ་ན་ཡང་རང་རིག་པ་ཁོ་ནའོ།",
    "འབྲས་བུའི་གནས་སྐབས་ཀྱང་རང་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པའི་དབྱེ་བས་རྣམ་པ་གཉིས་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་རྣམས་ཀྱི་ཞེས་བྱ་བ་ནི་ཚིག་རྣམས་ཀྱིའོ་ཞེས་དེ་ལྟར་དྲན་པའི་སྐྱེས་བུ་ནི་ངེས་པར་སྦྱར་བར་བྱ་བ་ནི་མངོན་དུ་ཕྱོགས་པ་ལ་འདུག་པ་ཞེས་སྦྱར་རོ།",
    "སྔར་དམིགས་པའི་དུ་བ་དང་རང་བཞིན་མཚུངས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ལྷུན་གྲུབ་ཚོགས་ཁང་རང་བཞིན་སྤྲུལ་པའི་ཞིང་",
    "མཐའ་དམག་དུས་འཁྲུགས་བསྟན་ལ་འཚེ་བ་ཟློག",
    "བདེ་བའི་སྟན་ལ་ལེགས་འདུག་ནས",
    "དེ་བས་རང་རང་ཕྱིར་དེངས་ཤིག",
    "གྲིབ་དང་མི་གཙང་རང་སར་གྲོལ",
    "རྗེས་བཟུང་རང་བྱུང་རིག་པ་འཛིན",
    "དེ་ནས་བདེ་བའི་སྟན་ལ་མ་ འདུག",
    "རང་རང་བདེ་བའི་ཡེ་ཤེས་སྐུ",
    "ལྷ་དང་རང་རིག་དབྱེར་མེད་པའི",
    "རང་རང་ལམ་གྱིས་སྲིད་དང་ཞིའི",
    "འདི་ཕྱི་སྒྲུབ་རྡོ་རྗེ་ཐོད་ཕྲེང་རྩལ་གྱི་རྒྱུན་ཁྱེར་ཡིན་འདུག་ཀྱང་།",
    "ཞེས་པའང་རང་ཉིད་ལ་ཉེར་མཁོའི་ཆེད་མངྒ་ལས་གཏེར་གཞུང་རྩ་བ་ལས་ཁོལ་དུ་ཕྱུང་སྟེ་མཚམས་སྦྱོར་ཅུང་ཟད་ཀྱིས་བརྒྱན་པ་དགེ་ལེགས་འཕེལ།",
    "ཁྱེད་རང་རྣམས་སྔར་བྱིན་པའི་མེ་ཏོག་དེ་ཉིད།",
    "དང་པོའི་དོན་དུ་ཁྱེད་རང་རྣམས་གཙོ་བོའི་མདུན་དཀྱིལ་འཁོར་གྱི་ཐད་དྲང་པོར་སེང་གེའི་ཁྲི་ལ་གནས་པའི་སྟེང་དུ་། གདུགས་ཕུབ།",
    "ཁྱེད་རང་རྣམས་ལུས་དྲང་པོར་བསྲང་།",
    "ཁྱེད་རང་རྣམས་རྡོ་རྗེ་ཐོད་ཕྲེང་རྩལ་མཐིང་ནག་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པའི་སྐུར་གསལ་བ་ལས།",
    "ཁྱེད་རང་རྣམས་རཏྣ་ཐོད་ཕྲེང་སེར་པོ་རིན་ཆེན་དང་དྲིལ་བུ་འཛིན་པའི་སྐུརགསལ་བ་ལས།",
    "ཁྱེད་རང་རྣམས་པདྨ་ཐོད་ཕྲེང་པདྨ་དང་དྲིལ་བུ་འཛིན་པའི་སྐུར་གསལ་བ་ལས།",
    "ཁྱེད་རང་རྣམས་ཀརྨ་ཐོད་ཕྲེང་ལྗང་ནག་རྒྱ་གྲམ་དང་དྲིལ་བུ་འཛིན་པའི་སྐུར་གསལ་བ་ལས།",
    "ཁྱེད་རང་རྣམས་ལྷར་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་དང་གཏད་པའི་རིག་མ་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་ཡབ་ཡུམ་དུ་གསལ་བ་ལྷའི་འདུ་ཤེས།",
    "རང་རང་ལམ་གྱི་སྲིད་དང་ཞིའི",
    "སློབ་དཔོན་གྱི་ཐུགས་ཀ་ནས་འཕྲོས་པའི་འོད་ཟེར་གྱིས་ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་ཁམས་སྐྱེ་མཆེད་ཀྱིས་མཚོན་པའི་སྣོད་བཅུད་ཐམས་ཅད་གྱི་སྣང་ཞེན་དབྱིངས་སུ་སྦྱངས།",
    "ཁྱེད་རང་རྣམས་ལྷར་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "སློབ་དཔོན་གྱི་ཐུགས་ཀ་ནས་འཕྲོས་པའི་འོད་ཟེར་གྱིས་ཁྱེད་རང་ཕུང་ཁམས་སྐྱེ་མཆེད་ཀྱིས་མཚོན་པའི་སྣོད་བཅུད་ཐ་མལ་གྱི་སྣང་ཞེན་དབྱིངས་སུ་སྦྱངས།",
    "ཁྱེད་རང་རྣམས་ལ་སིབ་སིབ་ཐིམ་པས་རྒྱུད་བྱིན་གྱིས་བརླབ་པའི་ངེས་ཤེས་བསྐྱེད་ཅིག།",
    "ཁྱེད་རང་རྣམས་ལྷར་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "སློབ་དཔོན་གྱི་ཐུགས་ཀ་ནས་འཕྲོས་པའི་འོད་ཟེར་གྱིས་ཁྱེད་རང་ཕུང་ཁམས་སྐྱེ་མཆེད་ཀྱིས་མཚོན་པའི་སྣོད་བཅུད་ཐམས་ཅད་གྱི་སྣང་ཞེན་དབྱིངས་སུ་སྦྱངས།",
    "ཁྱེད་རང་རྣམས་ལ་སིབ་སིབ་ཐིམ་པས་རྒྱུད་བྱིན་གྱིས་བརླབ་པའི་ངེས་ཤེས་བསྐྱེད་ཅིག།",
    "ཁྱེད་རང་རྣམས་ལྷར་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "སློབ་དཔོན་གྱི་ཐུགས་ཀ་ནས་འཕྲོས་པའི་འོད་ཟེར་གྱིས་ཁྱེད་རང་ཕུང་ཁམས་སྐྱེ་མཆེད་ཀྱིས་མཚོན་པའི་སྣོད་བཅུད་ཐམས་ཅད་གྱི་སྣང་ཞེན་དབྱིངས་སུ་སྦྱངས།",
    "ཁྱེད་རང་རྣམས་ལ་སིབ་སིབ་ཐིམ་པས་རྒྱུད་བྱིན་གྱིས་བརླབ་པའི་ངེས་ཤེས་བསྐྱེད་ཅིག།",
    "ཞལ་ནས་བྱུང་ཁྱེད་རང་རྣམས་ལྷར་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "མཐའ་དམག་དུས་འཁྲུགས་། བསྟན་ལ་འཚེ་བ་ཟློག",
    "སརྦ་ཤ་ཏྲཱན་བིནྣཱན་བྷུ་ཏ་པྲི་ཏ་པི་ཤྭ་ཙ་ན་བྷིནྡྷ་བྷིནྡྷ་ཧ་ན་ཧ་ན་པ་ཙ་པ་ཙ་ད་ཧ་ད་ཧ་དཱི་ན་མེ་ཀེ་ན་མཱ་ར་ཡ་ཕཊ",
    "ཁྱེད་རྣམས་རང་རང་གནས་ལ་གཤེགས",
    "སརྦ་ཤ་ཏྲཱན་བིཥྚཱན་བྷུ་ཏ་པྲི་ཏ་པི་ཤ་ཙ་ན་བྷིནྡྷ་བྷིནྡྷ་ཧ་ན་ཧ་ན་པ་ཙ་པ་ཙ་ད་ཧ་ད་ཧ་དཱི་ན་མེ་ཀེ་ན་མཱ་ར་ཡ་ཕཊ",
    "ཁྱེད་རང་རྣམས་ལ་སིབ་སིབ་ཐིམ་པས་རྒྱུད་བྱིན་གྱིས་བརླབ་པའི་ངེས་ཤེས་བསྐྱེད་ཅིག།",
    "ཞལ་ནས་བྱུང་ཁྱེད་རང་རྣམས་ལྷར་གསལ་བའི་ཞལ་དུ་ཞུགས།",
    "སརྦ་ཤ་ཏྲཱན་བིཥྚཱན་བྷུ་ཏ་པྲི་ཏ་པི་ཤ་ཙ་ན་བྷིནྡྷ་བྷིནྡྷ་ཧ་ན་ཧ་ན་པ་ཙ་པ་ཙ་ད་ཧ་ད་ཧ་དཱི་ན་མེ་ཀེ་ན་མཱ་ར་ཡ་ཕཊ",
