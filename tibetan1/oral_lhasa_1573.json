    "ཉེ་བར་བླང་བ་དག་ཀྱང་བསལ་བར་ཤེས་པར་བྱའོ།",
    "དེ་ལ་ཕྱོགས་ཙམ་ཞིག་བསྟན་པར་བྱ་སྟེ།",
    "དོན་དམ་པར་ཉེ་བར་ལེན་པ་པོ་མ་ཡིན་པར་གྱུར་པ་ལྷས་བྱིན་ཞེས་བྱ་བ་ཉེ་བར་བླང་བ་ཡིན་པར་གྱུར་པ་དེའི་སྒྲར་བརྗོད་པ་དག་ལེན་པར་མི་བྱེད་པར་གཟུང་བར་བྱ་སྟེ།",
    "དོན་དམ་པ་ཉེ་བར་ལེན་པ་པོ་མ་ཡིན་པར་གྱུར་པ་ལྷ་སྦྱིན་ཞེས་བྱ་བ་ཉེ་བར་བླང་བ་མ་ཡིན་པར་གྱུར་པ་ཉེ་བར་ལེན་པར་མི་བྱེད་པ་དང་།",
    "ཉེ་བར་ལེན་པ་པོ་ཡིན་པ་དང་མ་ཡིན་པར་གྱུར་པ་ལྷས་བྱིན་ཞེས་བྱ་བ་ཉེ་བར་བླང་བ་ཡིན་པ་དང་།",
    "མ་ཡིན་པར་གྱུར་པ་ཉེ་བར་ལེན་པར་མི་བྱེད་དེ་ཞེས་བྱ་བ་དག་ལ་ཡང་དམ་བཅས་པ་ལ་ཁྱད་པར་ཡོད་པར་ཟད་ཀྱི།",
    "སྦྱོར་བའི་ཡན་ལག་ལྷག་མ་དག་ནི་རྒྱས་པར་སྔ་མ་བཞིན་ནོ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་ཉེ་བར་བླང་བ་ཡིན་པར་གྱུར་པ་ཡང་ཉེ་བར་ཉེ་བར་ལེན་པ་པོ་ལ་ལྟོས་པའི་ཕྱིར་དཔེར་ན་མཆོད་སྦྱིན་གྱི་རྒྱུད་ཀྱི་ཉེ་བར་བླང་བར་གྱུར་པ་བཞིན་ནོ།",
    "དོན་དམ་པར་ཉེ་བར་བླང་བ་མ་ཡིན་པར་གྱུར་པ་ཉེ་བར་ལེན་པ་པོ་མ་ཡིན་པར་གྱུར་པ་ལྷས་བྱིན་ཞེས་བྱ་བའི་ཉེ་བར་བླང་བ་མ་ཡིན་པ་དང་།",
    "མ་ཡིན་པར་གྱུར་པ་ཉེ་བར་ལེན་པ་པོ་ཡིན་པ་དང་།",
    "མ་ཡིན་པར་གྱུར་པ་ལྷས་བྱིན་ཞེས་བྱ་བའི་ཉེ་བར་བླང་བ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་དག་ལ་ཡང་དམ་བཅས་པ་ལ་ཁྱད་པར་ཡོད་པར་ཟད་ཀྱི།",
    "སྦྱོར་བའི་ཡན་ལག་ལྷག་མ་དག་ནི་རྒྱས་པར་སྔ་མ་བཞིན་ནོ།",
    "དེ་བཞིན་དུ་ཕྱོགས་མི་མཐུན་པ་དག་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "ཉེ་བར་བླང་བ་ཡིན་པར་གྱུར་པ་ལ་སོགས་པ་དག་དོན་དམ་པར་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "དངོས་པོ་ལྷག་མ་ཤེས་པར་བྱ།",
    "དངོས་པོ་ལྷག་མ་རྣམས་ཀྱང་ཤེས་པར་བྱ་སྟེ།",
    "ཅུང་ཟད་དཔྱད་པར་བྱའོ།",
    "དོན་དམ་པར་འོ་མ་ཡིན་པར་གྱུར་པ་ནི་ཞོ་ཡིན་པར་གྱུར་པ་མི་བྱེད་དེ།",
    "གལ་ཏེ་མཐོང་བ་དང་གྲགས་པའི་གནོད་། པས་གནོད་པར་འགྱུར་རོ་ཞེ་ན།",
    "དམ་བཅས་པ་ཁྱད་པར་ཅན་བྱས་པའི་ཕྱིར་སྐྱོན་མེད་དོ།",
    "ཡང་ན་དོན་དམ་པར་སྨྲ་བར་འདོད་པའི་འོ་མ་ནི།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་སྨྲ་བར་འདོད་པའི་ཞོ་ནི་འོ་མའི་རྒྱུ་ཅན་མ་ཡིན་ཏེ།",
    "ཡང་ན་དོན་དམ་པར་ཞོ་ནི་འོ་མའི་རྒྱུ་ཅན་མ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "དམ་བཅས་པ་ཁྱད་པར་ཅན་ཡིན་པའི་ཕྱིར་མ་ངེས་པ་ཉིད་ཀྱང་མ་ཡིན་ནོ།",
    "གལ་ཏེ་འབྲས་བུ་སྔ་ན་མེད་པར་གྱུར་ན།",
    "གལ་ཏེ་འབྲས་བུ་སྔ་ན་མེད་པར་གྱུར་ན།",
    "དེ་ལྟར་ནུས་པས་ནུས་པ་ཅན་བྱེད་པའི་ཕྱིར་འབྲས་བུ་སྔ་ན་ཡོད་པ་ཁོ་ན་ཡིན་པར་སེམས་སོ།",
    "གལ་ཏེ་འབྲས་བུ་སྔ་ན་མེད་པར་གྱུར་ན་དེ་ལ་ཡང་རྒྱུའི་དངོས་པོ་མེད་པར་འགྱུར་བ་ཞིག་ན་དེ་ལྟ་མ་ཡིན་པས།",
    "དོན་དམ་པར་ནི་གཏན་ཚིགས་དང་དཔེ་མེད་དོ།",
    "ལེགས་པར་ཟིན་པ་མ་ཡིན་པ་དེ་གཉི་ག་ཡང་བསལ་བར་འདོད་པའི་ཕྱིར་རོ།",
    "སྒྱུ་། མའི་སྐྱེས་བུ་བཞིན་དུ་ཡོད་པ་དང་མེད་པ་ཉིད་དུ་བརྗོད་པར་བྱ་མ་ཡིན་པའི་ཕྱིར་བྱ་བ་བྱེད་པ་ལ་སོགས་པ་དག་ཐ་སྙད་པར་ཁས་བླངས་པའི་ཕྱིར་དང་།",
    "དོན་དམ་པར་རྒྱུས་འབྲས་བུ་ཡོད་པ་དང་མེད་པ་བྱེད་པ་བསལ་བའི་ཕྱིར་སྐྱོན་མེད་དོ།",
    "ད་ལྟར་ཉིད་ཡོད་པར་རྗེས་སུ་དཔོག་པས་འབྲས་བུ་འདས་པ་དང་།",
    "གལ་ཏེ་མར་མེས་བུམ་པ་ཡོད་པར་གྱུར་པ་གསལ་བར་བྱེད་པ་བཞིན་དུའོ་ཞེ་ན།",
    "ཅི་སྟེ་འབྲས་བུ་མ་སྐྱེས་པ་དང་ཞིག་པ་དག་ཡོད་པར་ཇི་ལྟར་ཤེས་པར་བྱ་ཞེ་ན།",
    "ཞིག་ནས་མེད་པ་དག་ནི་ཡོད་པ་ཁོ་ནར་ཤེས་པར་བྱ་སྟེ།",
    "ངེས་པར་སྐྱེ་བའི་ཕྱིར་འབྲས་བུའི་བདག་ཉིད་བཞིན་ནོ།",
    "ཞིག་པ་དག་དང་སྔ་ན་མེད་པ་དག་ཡོད་པར་རྟོག་པ་ལ་ནི་དཔེ་མེད་པ་དང་ཁས་བླངས་པ་ལ་གནོད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་གཞན་ཉིད་ཀྱི་ཕྱོགས་ལ་ཡང་ཅི་རིགས་པར་བརྗོད་པར་བྱའོ།",
    "རྒྱུ་ཡིན་པར་གྱུར་པ་འབྲས་བུ་མ་ཡིན་པར་གྱུར་པ་བྱེད་དོ།",
    "མ་སྐྱེས་པ་ལ་དེ་ཡོད་པས་འབྲས་བུ་མ་ཡིན་པར་གྱུར་པ་ཉིད་དོ།",
    "འབྲས་བུ་ནི་སྐྱེ་བར་འགྱུར་བ་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "འབྲས་བུ་མ་ཡིན་པ་ནི་མི་སྐྱེ་བས་གང་སྐྱེ་བ་དེ་ནི་མེད་པ་ཉིད་དོ་ཞེས་ངེས་པར་གཟུང་བར་བྱའོ།",
    "གཏན་ཚིགས་ཀྱི་དོན་མ་ངེས་པ་ཉིད་ཀྱི་སྐྱོན་ཡོད་པས་རྗེས་སུ་དཔག་པ་དེས་འབྲས་བུ་མ་སྐྱེས་པ་ནི་མ་ཡིན་པར་གྱུར་པ་སྟེ་ཞེས་བསྟན་པར་མི་ནུས་སོ།",
    "གང་སྐྱེ་བ་དེ་ནི་མེད་པ་ཉིད་དོ་ཞེས་ངེས་པར་གཟུང་བར་བྱའོ་ཞེས་གང་སྨྲས་པ།",
    "ཡང་ན་དོན་དམ་པར་སྨྲ་བར་འདོད་པའི་ཞོ་ནི་སྨྲ་བར་འདོད་པའི་འོ་མའི་རྒྱུན་ཅན་མ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་བྱས་པ་ཉིད་དང་།",
    "རྒྱུ་དང་ལྡན་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པའི་གཏན་ཚིགས་དག་ཀྱང་རྒྱས་པར་བརྗོད་པར་བྱའོ།",
    "དེའི་ཕྱིར་དེ་ནི་བདག་ཉིད་དབུགས་འབྱིན་པར་བྱེད་པ་ཙམ་དུ་ཟད་དོ།",
    "འདི་སྐད་ཅེས་སྔ་ན་མེད་པ་ཉིད་སྐྱེ་བར་མཐོང་སྟེ་ཞེས་གང་སྨྲས་པ་དེ་ཉིད་ཀྱང་ཅི་ཡང་དག་པར་ཡོད་པའམ།",
    "དེ་བཞིན་དུ་དེ་ལས་གཞན་པ་ཕྱོགས་མི་མཐུན་པ་དག་ལ་ཡང་ཅི་རིགས་པར་བརྗོད་པར་བྱའོ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་སྨྲ་བར་འདོད་པའི་ཡོན་ཏན་ཡིན་པར་གྱུར་པ་དག་ཀྱང་བུམ་པ་ཞེས་བྱ་བ་དེའི་ཡོན་ཏན་ཅན་ཡིན་པར་གྱུར་པ་རྩོམ་པར་མི་བྱེད་དེ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་སྨྲ་བར་འདོད་པའི་ཡོན་ཏན་ཅན་ཡིན་པར་གྱུར་པ་སྣམ་བུ་ཞེས་བྱ་བའི་གཟུགས་གཞན་ཡང་།",
    "ཡོན་ཏན་ཡིན་པར་གྱུར་པ་རྒྱུ་སྤུན་གྱི་གཟུགས་ལ་སོགས་པས་བརྩམས་པ་མ་ཡིན་ཏེ།",
    "དཔེར་ན་དེ་ལས་གཞན་པ་བཞིན་ནོ་། དེ་བཞིན་དུ་སྨྲ་བར་འདོད་པའི་བུམ་པ་ཡང་གཟུགས་ལ་སོགས་པས་འདུ་བའི་རྒྱུ་ཅན་མ་ཡིན་པར་ངེས་ཏེ།",
    "བསམས་པའི་བུམ་པར་འདུ་བ་མ་ཡིན་ཏེ་ཡོན་ཏན་ཅན་ལ་ལྟོས་པའི་ཕྱིར་དཔེར་ན་དེ་ལས་གཞན་པ་བཞིན་ནོ།",
    "བརྗོད་པར་བྱ་བ་ཉིད་དང་།",
    "དམ་བཅས་པ་ལ་ཁྱད་པར་ཡོད་པར་ཟད་ཀྱི་སྦྱོར་བའི་ཡན་ལག་ལྷག་མ་དག་ནི་སྔ་མ་བཞིན་ནོ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་ལྐོག་ཤལ་ལ་སོགས་པ་མཚན་ཉིད་ཡིན་པར་གྱུར་པ་ཡང་བ་ལང་ཞེས་བྱ་བ།",
    "མཚན་ཉིད་ཀྱི་གཞི་ཡིན་པར་གྱུར་པ་ཡང་བ་ལང་ཞེས་མཚོན་པར་མི་བྱེད་པར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་ལག་པ་ལ་སོགས་པ་ཡན་ལག་ཡིན་པར་གྱུར་པ་དག་ཀྱང་ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་ཡིན་པར་གྱུར་བ་རྩོམ་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་ལྷས་བྱིན་ཞེས་བྱ་བ་ཡན་ལག་ཅན་ཡིན་པར་གྱུར་པ་ཡང་།",
    "ཡང་ན་དོན་དམ་པར་སྨྲ་བར་འདོད་པའི་ལག་པ་ལ་སོགས་པ་ཡན་ལག་དག་ནི་སོ་མ་ཤར་མ་ཞེས་བྱ་བ་ཡན་ལག་ཅན་རྩོམ་པར་བྱེད་པ་མ་ཡིན་པར་ཤེས་པར་བྱ་སྟེ།",
    "འདིར་ཡང་དམ་བཅས་པའི་དོན་ལ་སོགས་པ་རྣམ་པར་བརྟག་པ་རྒྱས་པ་ནི་སྔ་མ་བཞིན་ནོ།",
    "འདི་ལ་ཡན་ལག་ཅན་དེ་ཡན་ལག་དག་ལ་ཆ་ཤས་ཀྱིས་འཇུག་པར་འདོད་དམ།",
    "བདག་ཉིད་ཐམས་ཅད་ཀྱིས་འཇུག་པར་འདོད།",
    "དེ་བཞིན་དུ་རབ་ཀྱི་རྩལ་གྱིས་རྣམ་པར་གནོན་པ་གཟུགས་ལ་བྱེད་པ་པོའམ།",
    "རྣམ་པར་ཤེས་པ་ལ་བྱེད་པ་པོའམ།",
    "རྣམ་པར་ཤེས་པ་ལ་བྱེད་པ་པོའམ།",
    "དེ་བཞིན་དུ་རབ་ཀྱི་རྩལ་གྱིས་རྣམ་པར་གནོན་པ།",
    "དེ་ནི་སྟོང་པ་ཉིད་། ཀྱི་མི་མཐུན་པའི་ཕྱོགས་ཀྱི་ཁྱད་པར་དགག་པས།",
    "རབ་ཏུ་བྱེད་པ་འདས་མ་ཐག་པར།",
    "དེ་བཞིན་ཉེ་བར་ལེན་ཤེས་པར་བྱ།",
    "ཞེས་སྨོས་པ་དེར་ཉེ་བར་ལེན་པ་པོ་ཡིན་པར་གྱུར་པ་དང་།",
    "མ་ཡིན་པར་གྱུར་པ་དང་།",
    "མ་ཡིན་པར་གྱུར་པ་ཉེ་བར་བླང་བ་ཡིན་པར་གྱུར་པ་དང་།",
    "མ་ཡིན་པར་གྱུར་པ་དང་།",
    "ཉན་པ་བསྟན་པ་དག་གོ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "སོགས་ཞེས་བྱ་བ་ནི་རྣམ་པར་ཤེས་པ་དང་།",
    "འདི་ལྟར་ཉེ་བར་ལེན་པ་པོ་གནས་ན་ཉེ་བར་བླང་བ་དེ་དག་ཤེས་པར་བྱར་རུང་སྟེ།",
    "ཡང་ན་ལྟ་བ་དང་ཉན་པ་ལ་སོགས་པ་ཉེ་བར་བླང་བ་དག་ནི་ཉེ་བར་ལེན་པ་པོ་སྔ་ན་གནས་པ་དང་ལྡན་པར་ཤེས་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་ཉེ་བར་བླང་བ་ཉེ་བར་ལེན་པར་བྱེད་པ་ཉིད་ཀྱིས་ཉེ་བར་ལེན་པ་པོ་ཞེས་གྲགས་པར་འགྱུར་ཞིང་།",
    "ཉེ་བར་བླང་བ་ཞེས་གྲགས་པར་འགྱུར་བས་གཉི་ག་གྲུབ་བོ།",
    "གང་དག་ལ་བརྟེན་ནས་འདི་ཉེ་བར་ལེན་པ་པོ་ཞེས་ཉེ་བར་འདོགས་པར་བྱེད་པའི་ཉེ་བར་བླང་བ་གཞན་འགའ་ཡང་མེད་དོ།",
    "ཐ་སྙད་ཀྱི་དུས་སུ་ལྟ་བ་ལ་སོགས་པ་དག་ཉིད་ཀྱིས་དེ་གདགས་པར་བྱ་བ་ཡིན་ན།",
    "ཉེ་བར་བླང་བ་ལ་བརྟེན་ནས་ཉེ་བར་ལེན་པ་པོ་གདགས་པར་བྱ་བ་ཉིད་དོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "དོན་དམ་པར་སབ་མ་མཁན་དང་རྩི་རྐྱང་ལ་སོགས་པ་དག་ཀྱང་ཉེ་བར་ལེན་པ་པོ་དང་།",
    "ལྷ་ཡང་ལྷའི་ཉེ་བར་བླང་བ་དག་ཉིད་ལ་བརྟེན་ནས་ལྷ་ཉིད་དུ་གདགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་དང་།"
  ]
}