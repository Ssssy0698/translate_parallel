    "ཚེ་འཕོས་པ་འདིའི་ཆ་ལུགས་སུ་སྣང་བ་ནི་བར་སྣང་གི་ཁམས་འདི་ན་དྲི་ཟའི་འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མེད་པ་བསམ་གྱིས་མི་ཁྱབ་པ་མཐར་ཐུག་པ་མེད་པ་ཡོད་དོ།",
    "དེ་ལ་ཀུན་ཏུ་མི་འབྱུང་གི་ཡུལ་གྱི་སྤྲོས་པ་ལ་འདོད་པ་ནི་ཀུན་ཏུ་འབྱུང་ངོ།",
    "དེའི་ཚེ་ན་ཕ་མ་གཉིས་ཉལ་བོ་བྱེད་པ་ཡང་མེད་བཞིན་དུ་དེས་ཕྱིན་ཅི་ལོག་གི་བློས་དེ་ལྟར་མཐོང་སྟེ།",
    "ཟླ་བ་བརྒྱུད་ཀྱིས་ནི་རྫོགས་པ་ཡིན་མོད་ཀྱི་ཤིན་ཏུ་རྫོགས་པ་མ་ཡིན་ནོ།",
    "རེ་ཞིག་སྒོ་ང་ལས་སྐྱེ་བ་དང་།",
    "༢༤༩་ དེའི་འགལ་ཟླ་ནི་གང་ཟག་གི་བདག་ཏུ་འཛིན་པའི་འཇིག་ལྟའོ།",
    "ཡིད་དུ་འོང་བའི་ལང་ཚོ་དང་སྲོག་ཞིག་པའི་ཕྱིར་རོ།",
    "དང་བོ་བརྒྱད་པ་དགུ་ཉོན་མོངས།",
    "དང་བོ་བརྒྱད་པ་དགུ་ཉོན་མོངས།",
    "༢༥༧་དེ་ལྟར་ཡང་དཔུང་བཟང་གིས་ཞུས་པའི་རྒྱུད་ལས།",
    "ཞེས་སོགས་ནི་བཤེས་སྤྲིང་གི་ཚིག་གོ།",
    "མཆོག་ཟུང་གཅིག་གི་ཀུན་སྤྱོད་ནི་དུས་དུས་སུ་འགྲོ་བ་ལྔར་རྒྱུ་བ་ཡིན་པས།",
    "སྐུ་འབུམ་དང་རེབ་གོང་པར་དུ།",
    "བཤེས་སྤྲིང་གི་ཚིག་རྣམས་ཡོངས་གྲགས་ཡིན་པས་འདིར་ལུང་ཁུངས་མ་སྨྱོས།",
    "ཉེ་བར་ལེན་པའི་ཕུང་བོ་ལྔ་བོ་དེ་དག་ཉིད་ལས་ཉོན་མོངས་པས་འཕངས་ནས།",
    "གཅིག་ནི་བསྲུང་བས་ཉོན་མོངས་ལ།",
    "གང་གི་ཕྱིར་རབ་ཏུ་བྱུང་བ་འདོད་པ་ཆེ་བར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་ཁྱིམ་པ་ཡིན་གྱི་རབ་ཏུ་བྱུང་བ་ནི་མ་ཡིན་ནོ།",
    "ངན་ངོན་ཙམ་གང་གིས།",
    "གཅིག་གི་ཕྱེད་དང་ཡན་ལག་དང་།",
    "གཅིག་གི་ཁྱེད་དང་ཡན་ལག་དང་།",
    "ཞེས་ཡོད་མོད།",
    "ཞེས་སོགས་བཤེས་སྤྲིང་གི་ཚིག་གོ།",
    "༢༧་ དཔུང་བཟང་གིས་ཞུས་པའི་རྒྱུད་ལས་ཀྱང་།",
    "༢༧༢་ དཔུང་བཟང་གིས་ཞུས་པའི་རྒྱུད་ལས།",
    "༢༧༤་ དཔུང་བཟང་གིས་ཞུས་པ་ལས།",
    "འདི་ལ་བདག་གིས་ཞེན་བྱ་ཞིང་།",
    "ཉོན་མོངས་རྣམས་ཀྱི་གཞི་གཅིག་ནི།",
    "༢༨ཉོན་མོངས་ཕྱོགས་ཀྱི་ཁྲོད་གནས་ན།",
    "བུདྡྷེ་ཏི་ཀཱ་ཤ་ནཱ་ད་བུདྡྷ་བི་བུདྡྷ་པདྨ་བ་ཏ།",
    "ཞེས་འགའ་ཞིག་གིས་བསྒྱུར་པའང་རུང་ཙམ་སྣང་ངོ།",
    "འཇིག་རྟེན་དོན་སྒྲུབ་རྒྱལ་བའི་རྒྱལ་རིགས་ན། ཞེས་ཡོད་མོད།",
    "པཎ་སྨ་༧ པ་འབུམ་དང་རེབ་གོང་ལམ་རིམ་པར་ལས།",
    "རྟག་ཏུ་འཇིག་རྟེན་འདེགས་ལ་གང་གིས་ཁུར་དུ་མི་བརྩི་དབྱིག་ལྡན་མ།",
    "གང་གིས་འཇིག་རྟེན་ཕན་བདེའི་རོ་ནི་མཐའ་གཅིག་མྱོང་བ་དེ་དག་ཡིན།",
    "ཞེས་སོགས་ནི་རིན་ཕྲེང་གི་ལེའུ་གཉིས་པའི་ཚིག་ཡིན་ནོ།",
    "ཐེག་མཆོག་ལ་མོས་ས་བོན་ཤེས་རབ་ནི།",
    "ཁྱོད་ཉིད་གཅིག་པུ་ཐར་བའི་ལམ།",
    "ཁྱོད་ཉིད་མཐོང་ན་འཆིང་འགྱུར་ཏེ།",
    "ཁྱོད་ཉིད་མཐོང་ན་གྲོལ་འགྱུར་ཏེ།",
    "ཀླུ་སྒྲུབ་འདས་ནས་ལོ་བརྒྱ་ཙམ་ན་ལོ་ཆེན་གཞོན་ནུ་སྲོག་གིས་རྒྱ་ནག་ཡི་གེར་བསྒྱུར་པའི་ཤེར་ཕྱིན་མན་ངག་ཆེན་མོར་ཤེར་ཕྱིན་མའི་བསྟོད་པ་ཡོངས་རྫོགས་དྲངས་ཤིང་།",
    "༢༨༧གཞན་དག་རང་གི་དོན་དུ་ཡང་།",
    "འགའ་ཞིག་གིས།",
    "༣་བུ་མོ་ཟླ་བ་མཆོག་གིས་ཞུས་པ་ལས།",
    "བདག་གིས་སྔོན་ཆད་ཁྱེད་རྣམས་ཐམས་ཅད་བསད།",
    "སྔོན་ཆད་ཁོ་མོས་ཁྱེད་ཀུན་བསད་གྱུར་ཅིང་།",
    "ཁྱོད་ཀྱིས་ཁོ་མོའང་སྔོན་ཆད་བསད་གྱུར་པས།",
    "སྐུ་འབུམ་དང་རེབ་གོང་པར་ལས།",
    "གཞན་ཡང་སྔོན་ཆད་ཉོན་མོངས་པའི།",
    "ཉོན་མོངས་ཀྱིས་སྨྱོ་གཏི་མུག་ལྡོངས།",
    "གང་གི་ཚེ་ཡིད་དུ་འོང་བའི་བུ་མི་བདེ་བ་བཞིན་དུ་ཞེས་སོགས་ནི།",
    "སྲིད་པའི་རྩེ་མོའི་འདོད་ཆགས་དང་བྲལ་བས་ཐོབ་པའི་ཕྱིར་རོ།",
    "གི་ཁྱད་པར་སྤྱོད་པ་ཕྱིན་དྲུག་གི་བྱ་བས་དངོས་སུ་ཟིན་མ་ཟིན་གྱི་སྒོ་ནས་བཞག་པས།",
    "ཞེས་སོགས་བདག་གི་ལུས་ནི་གཞན་དག་ཏུ།",
    "དེ་བས་ཇི་ལྟར་གཞན་དག་གི།",
    "འདི་མན་ཡིག་ཚོགས་ལ་འཇིགས་པ་དང་སྤྱོད་འཇུག་གི་ལུང་རྣམས་འཚོལ་དཀའ་བ་མ་ཡིན་སྟབས།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ཞེས་སོགས་ནི།",
    "སྐུ་འབུམ་དང་རེབ་གོང་པར་ལ་ཆོ་ག་ཞེས་པ་མེད་དོ།",
    "ཞོལ་པར་དང་བཀྲས་ལྷུན་བཀྲིས་འཁྱིལ་སྐུ་འབུམ་པར་བཅས་ལ་སྔ་མ་གཉིས་ཀྱི་ཞེས་པ་མེད་པ་འོད་སྲུངས་ལེའུའི་འགྲེལ་བ་དང་མཐུན་མོད།",
    "ངན་སོང་དག་ཏུ་ཡང་སྐབས་འགར་སྐྱེ་བར་འགྱུར་ཏེ།",
    "རང་གི་ཉེས་པ་གཞན་གྱིས་མི་ཤེས་པར་བྱེད་འདོད་པས་རབ་ཏུ་ཕྱེ་བ་ཞེས་ཡོད།",
    "ཞེས་ཡོད་མོད།",
    "ཁྱེད་ལ་མོས་བྱ་ཁོང་དུ་ཆུད་པར་བྱ།",
    "ཁྱོད་ལ་བསྒོ་ཞིང་ཁོང་དུ་ཆུད་པར་བྱ།",
    "ཇི་ལྟར་མི་དག་མང་དུ་རྟོག་བྱེད་པ། དེ་ལ་གནས་པའི་རྟོག་པ་དེ་དག་གིས།",
    "ཐུན་ཚོད་ནི་ཉིན་མཚན་གང་རུང་གི་སུམ་ཆ་གཅིག་ཡིན་ལ།",
    "ལག་ན་རྡོ་རྗེ་གང་ཁྱོད་ང་ལ་དོན་འདི་འདྲི་བ་ནི་ཡང་ལེགས་སོ།",
    "དེ་ལྟ་བས་ན་ཅི་ཡང་མི་བསམ་མོ།",
    "ཇོ་ནང་ཏཱ་ར་ནཱ་ཐས་གཟིགས་མྱོང་ངམ།",
    "འདིའི་ལྟ་གྲུབ་ཀྱང་བདུད་ཀྱི་ལས་ཁོ་ནའོ་ཞེས་གྲགས་ཆེ་བར་སྣང་བ་འདི་ལ་འཇིགས་སོ་སྙམ་མོ།",
    "དེ་ཤེས་རབ་ཀྱིས་ཤེས་པས་ནི་ཉོན་མོངས་པ་ཐམས་ཅད་ཡོངས་སུ་འདོར་རོ།",
    "ལྷ་ས་དང་བཀྲིས་འཁྱིལ་པར་ལ་འདྲི་ཤེས་ཞེས་དང་གཞན་མང་བོར་འབྲི་ཤེས་ཞེས་ཡོད་མོད།",
    "སྐད་ཆ་འདྲི་དང་རི་མོ་འབྲི་ལ་ཡིག་ཐོབ་སོ་སོར་ཡོད་པའི་ལུགས་ལེགས།",
    "ཐང་སན་ལམ་ཡིག་ཏུ་གསལ་མོད།",
