    "ཁྱདཔར་ཆུ་འཛག་དུས་སུ་སྨིན་པ་ཡིན།",
    "དེ་ཡང་རང་ལུས་རྡོ་རྗེར་མ་གྱུར་ན།",
    "དེ་ནས་ཕྱིར་བྱུང་ཕྱུང་སྟེ་བདེ་བར་འདུག་ལ་མར་དང་ཏིལ་མར་བསྲེས་པས་ལུས་སྐུ་བསྐུ་བྱུགས་བྱས་ལ་ལག་པས་དལ་གྱིས་རྙེས་མཉེས་ཏེ།",
    "ཚད་པ་ཁ་མཐོ་ཙ་ན་རྒྱས་ཚད་ལྟར་བསིལ་ཀྱང་རྐྱང་བཏང་ལ་ཁ་ཡན་དགུག་གོ།",
    "བཟང་དྲུག་གསུམ་ཆ་གསུམ་དུ་སྦྱར་ལ་ཕྱེད་ཐོ་རང་རངས་བཏང་།",
    "དུས་ཚོད་དེ་ཙ་ན་དྲོད་བཅུད་མ་བཏང་ན་དམུ་ཆུར་འགྲོ་ཆང་དང་དྲོད་སྟོང་གཏོང་བ་ཡིན་ཏེ།",
    "དེ་ཙ་ན་ཚད་པ་བར་མ་བྱ་བ་ཡིན་ཏེ།",
    "ཐོ་རང་རངས་ཕྱི་འཕྲེད་དུས་སུ་གཏང་།",
    "རྩ་རྒྱུད་སྦོམ་འཕྲ་མགྱོགས་བུལ་ཇི་ལྟར་འདུག་གྱུར་ཀྱང་།",
    "ཆང་འཐུང་དང་འགྲོ་འདུག་རྗེས་ལ་རྐང་པ་ལྕི།",
    "ཚད་པར་པ་རྐྱང་པར་འདུག་ཀྱང་ཡུན་རིང་པོར་ལོན་ཡང་གསར་པར་བཅོས།",
    "ལྡན་པར་འདུག་ན་ཞག་མང་པོ་མ་ལོན་ཡང་རྙིང་པའི་བཅོས་བྱེད་དགོས།",
    "ཚ་བ་གྲང་པ་ལྟར་འདུག་པ་ལ་ཚད་པ་གཙོ་བོར་བསྟན་པ་གབ་ཚད་དངོས་སུ་དབྱུང་བའི་དུས།",
    "རྒྱས་པའི་ཚ་བ་ལ་བདའ་གདའ་དྲགས་པའི་ཚམས་མཚམས་སུ་འོང་།",
    "ཚད་པའི་རྗེས་སུ་བདའ་གདའ་གྲགས་དྲགས་སླར་དེད་པས།",
    "དེའི་རིགས་ལ་ཁྲག་གླང་ང་སླ་ང་གང་པསག་བུར་ཡོས་རྡོག་ཙམ་གཅིག་ཕན་པར་འདུག་གསུངས།",
    "ཁྲག་བྱེ་འཆིན་མཆིན་ཙམ་གཅིག་ཕན་པར་འདུག་གསུངས།",
    "མ་ཐུབ་དུགས་ལུམས་བདུད་རྩི་ལྔའམ་གླ་རྩི་དྲི་ཆུས་ཙ་ནས་སྦྱངས།",
    "གདའ་བག་སེར་འགྱུར་དང་རུང་།",
    "དྲན་པ་མེད་པར་དྲུང་ན་འདུག་པ་འཛིན།",
    "སྟོད་པས་སྨད་ཚད་པ་ཆེ་སྟེ་ཆུ་དམར་ལོང་ལོང་འདུག་ཅིང་སྟོབས་ཉམས་སོ།",
    "འདི་ལ་ཕ་མཚོ་འཚོ་བྱེད་གསུང་ཙ་ན།",
    "སྦས་པའི་གདམ་པ་འདི་ནི་གསུམ་དང་གཉིས་སུ་གྱེས་འདུག་ན།",
    "སྲད་དཀར་རང་རང་མ་འདྲེས་བསྲེག་གྲོགས་དང་གཙོ་བོ་བུང་བུངས་སྙམ་མཉམ་སྦྱར།",
    "ཡན་ལག་བཞི་ལ་བྱུང་ན་མི་སྐྱོན་འདུག།",
    "རྫས་དེ་ལ་ལ་ཆ་བསྲེས་ནས་བསྲེགས་ཏེ་རྫི་གོང་ནས་དུ་བས་བདུགས་ན་ལུད་པ་གཅིག་གམ་ལྷོག་པ་བྱེར་བར་འདོད་པར་གདའ།",
    "འདི་ལས་ལྷག་པ་མི་འདུག་ཉེས་བརྒྱ་ལྷག་ཙམ་བསོས་པ་ལ་ཤོར་བ་གཉིས་ལས་མ་བྱུང་ངོ།",
    "རྨ་འདུག་ན་དེ་ལ་བཏབ་ལ།",
    "ཡང་རང་ཕག་པ་ནག་པོ་ཁ་ནས་མེ་འབར་བ་གཅིག་ཏུ་སྒོམ་ལ།",
    "མི་བཞན་གཞན་ལ་འགོག་ན་ཡོན་མེད་པར་མི་བཏོང་གཏོང་བའི་བཀབ་བརྒྱ་བཀའ་རྒྱ་བྱེད་ཀྱིན་གདའ།",
    "ཡང་རང་བྲམ་ཟེ་དམར་ནག་སྐྲ་ཁམ་པ་གྱེན་དུ་རྫེས་པ།",
    "རང་རང་གཞུང་བཞིན་རྩོན་བརྩོན་པས་བཅོས།",
    "གྲང་དང་ཐོ་རང་རངས་དུས་ན་ན།",
    "འགྲོ་འདུག་བྱས་པས་མི་ལྟོ་སྟོ།",
    "ཆུ་བཀོལ་བསྐོལ་ཕུལ་ལ་ཐོ་རང་རངས་བཏང་།",
    "ཉིན་གུང་གཉིད་ལོག་འདུག་རྗེས་དྲག་ཤུལ་བྱས་།",
    "སྔོན་པོར་འདུག་དང་རབ་རིབ་མཐོང་།",
    "དཀར་ནི་ལིང་ངེ་འདུག་ན་ལེགས།",
    "ཁ་བ་བབས་ལྟར་འདུག་ན་ལེགས།",
