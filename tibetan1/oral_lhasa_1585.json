    "ཐོས་པའི་ཤེས་རབ་ཀྱིས་ཁམས་བརྟས་པར་བྱེད་ལ།",
    "བསམ་པ་ལས་བྱུང་བའི་ཤེས་རབ་ཀྱིས་རིགས་པ་ལ་བརྟེན་ནས་དོན་ལ་འཇུག་པར་བྱེད་དོ།",
    "བསྒོམས་པ་ལས་བྱུང་བའི་ཤེས་རབ་དེ་ཡིས་ནི་འདོད་པའི་དོན་རྣམས་འགྲུབ་པར་འགྱུར་ཏེ།",
    "གཞན་ལ་སྦྱིན་པར་བྱེད་པ་དང་།",
    "ཉན་ཐོས་སོགས་ལས་ཁྱད་པར་དུ་འཕགས་པའི་ཕྱིར་དང་།",
    "ཡོན་ཏན་མ་ཐོབ་པ་ལ་ཐོབ་པར་འཛིན་པའི་ཕྱིར།",
    "གནས་ངན་ལེན་གྱི་གཡེང་བ་ནི་ངར་འཛིན་པའི་སྒོ་ནས་གཞན་ལས་ཁྱད་པར་དུ་འཕགས་པར་ཡིད་ལ་བྱེད་པ་སྟེ།",
    "དོན་ཡོད་མེད་གཉིས་ཤེས་པ་ནི་ཡི་གེ་ལ་ཕྱིན་ཅི་མ་ལོག་པར་འཇུག་པའོ།",
    "གཟུང་འཛིན་གཉིས་སུ་སྣང་བར་གྱུར་པ་ནི་ཇི་ལྟར་སྣང་བ་དེ་ལྟར་དོན་ལ་ཡོད་པ་མ་ཡིན་པས་ཡོད་པས་མཐའ་རྣམ་པར་སྤངས་སོ།",
    "གཉིས་སུ་སྣང་བ་ཙམ་མེད་པ་མ་ཡིན་པས་མེད་པ་རྣམ་པར་སྤངས་སོ།",
    "ཐ་སྙད་དུ་གཉིས་སུ་སྣང་ཡང་དོན་ལ་ཡོད་པ་མིན་པར་རྟོགས་པ་དེ་ནི་མི་འཕྲོ་བ་ལ་ཕྱིན་ཅི་མ་ལོག་པ་སྟེ།",
    "མཐའ་གཅིག་ཏུ་ཡོད་པ་དང་མེད་པར་འཛིན་པའི་རྟོག་པ་མི་འཕྲོ་བའི་ཕྱིར་རོ།",
    "སྤངས་པ་ལས་ནི་རྣམ་པར་དག་པ་སྟེ།",
    "མེད་པ་སོགས་རྡོ་རྗེའི་ཚིག་བཅུ་གསུངས་པ་དབྱིག་གཉེན་གྱི་འགྲེལ་པར་ཚིགས་བཅད་དུ་བསྡུས་པ་ནི།",
    "རྟག་པར་འོད་གསལ་ཉིད་དང་ནི།",
    "ཞེས་གསུངས།",
    "གཉེན་པོ་འཕེལ་བས་ཁེངས་པ་མེད་པ་ལ་ཕྱིན་ཅི་མ་ལོག་པ་ནི་ཁྱད་པར་དུ་འཕགས་པའམ་ལྷག་པ་མེད་པའོ།",
    "རྫས་ཀྱི་རྡོ་རྗེ་དེ་མཚོན་སོགས་ཀྱིས་ཕིགས་པར་དཀའ་བ་བཞིན་དུ་འདི་དག་ནི་རྟོག་གེའི་བློས་ཤེས་པར་དཀའ་བའི་ཕྱིར་རྡོ་རྗེའི་ཚིག་ཅེས་བྱའོ།",
    "འགྲེལ་པར་ལུས་རྣམ་གཞག་གཉིས་མཛད་པའི་དང་པོ་ནི།",
    "རྣམ་པར་མི་རྟོག་པ་ཉིད་དང་།",
    "དཔེར་ན་སྒྱུ་མ་བྱས་པ་ཉིད་ནི་སྣང་བ་ལྟར་མེད་ཀྱང་དམིགས་སུ་རུང་བ་ལྟ་བུའོ།",
    "འགྲིབ་པ་མེད་པ་དང་ཁྱད་པར་དུ་འཕགས་པ་མེད་པ་ཞེས་པས་དེའི་ལན་བསྟན་ཏེ།",
    "གང་ལ་གང་ཞིག་སོགས་འཆད་བྱེད་ཡིན་པའི་ཕྱིར་སྔ་ཕྱིའི་འབྲེལ་དེ་ལྟར་བྱས་སོ།",
    "བདག་དང་ཕུང་པོ་ཐ་དད་པར་བཏགས་པ་དང་།",
    "གཟུགས་སོགས་རྟག་པར་བཏགས་པ་ནི་མུ་སྟེགས་པས་བཏགས་པའོ།",
    "ཐ་སྙད་དུ་མེད་པར་འདུ་ཤེས་པས་བཏགས་པ་ནི་ཆད་མཐའ་དང་།",
    "གཟུང་བ་དང་འཛིན་པར་བཏགས་པའི་མཐའ་གཉིས་དང་།",
    "རྣམ་པར་བྱང་བ་གསུམ་གྱི་མཐའ་སྟེ།",
    "དངོས་པོར་ཡོད་མེད་སོགས་ཕྱོགས་གཉིས་ཀྱི་རྣམ་པར་རྟོག་པ་ནི་མཐའ་སྟེ།",
    "ཡེ་ཤེས་ཀྱིས་སྤང་བྱ་སྤོང་བར་བྱེད་པ་དང་སྤོང་བར་བྱེད་པའི་ནུས་པ་ཡོད་པ་མིན་པར་རྟོག་པའི་མཐའ་དང་།",
    "ཟུང་དུ་སྦྱར་བ་བདུན་པོ་དེ་ནི་ཕྱོགས་གཉིས་ཀྱི་ཡུལ་ཅན་གྱི་རྣམ་པར་རྟོག་པའི་མཐའ་འོ།",
    "ལྔ་པ་དང་དྲུག་པ་ཁྱད་པར་ཅན་དང་ཁྱད་པར་མེད་པའི་སྒྲུབ་པ་ནི།",
    "ས་བཅུ་ལ་རྣམ་པར་དག་པར་བྱ་བ་དག་ཏུ་ཤེས་པར་བྱས་ཏེ།",
    "ཁྱད་པར་མེད་པའི་སྒྲུབ་པ་ནི།",
    "ས་བཅུ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་བཅུ་སྒྲུབ་ཙམ་དུ་ཁྱད་པར་མེད་ལ།",
    "རྣམ་པར་གཞག་པའི་དམིགས་པ་ནི།",
    "ལམ་གྱི་དམིགས་པར་གྱུར་པའི་དེ་བཞིན་ཉིད་ཡིན་པའི་ཕྱིར།",
    "བསྒྲུབ་པར་བྱ་བའི་དམིགས་པ་ནི།",
    "བསྒྲུབ་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "ངེས་པར་འཛིན་པའི་དམིགས་པ་ནི།",
    "རིགས་པ་ལ་བརྟེན་ནས་ངེས་པར་འཛིན་པ་ཡིན་པའི་ཕྱིར།",
    "འཇིག་རྟེན་ལས་འདས་པའི་ལམ་གྱིས་རབ་ཏུ་རྟོགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "རྣམ་པར་རྟོགས་པའི་དམིགས་པ་ནི་ས་བདུན་པའི་དམིགས་པ་སྟེ།",
    "ཕུལ་དུ་བྱུང་བའི་དམིགས་པར་འདོད་དེ།"
  ]
}