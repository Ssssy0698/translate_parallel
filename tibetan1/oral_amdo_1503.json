    "ཉེས་པའི་དྲི་མ་བྱུང་བ་མཐོང་རེ་སྐན།",
    "གསང་སྔགས་ཀྱི་དམ་ཚིག་ལ་ཉེས་པ་ཅར་རེ་ཉེ་རེ་བརྒྱབ་སྟེ་ཉེས་པ་དང་ཞག་ཏུ་འགྲོགས་མ་མྱོང་གསུང་།",
    "བསྒྲུབས་པའི་ཡོན་ཏན་ནི་ཡི་དམ་གྱི་ལྷ་ཞལ་གཟིགས་པ་དང་།",
    "བཞུད་དུ་མ་བཏུབ་པར་འདིས་ང་ལ་མ་གནོད་ཀྱིས་བྱས་པས་ཁྱོདམ་གནོད་ཀྱང་གཞན་ལ་གནོད་ཟེར་ནས་བཏོན་པས།",
    "ཉམས་པ་སྒོ་ལ་འགྲོར་མི་རུང་གསུངས་ནས་རྩིག་པ་ལ་ཐལ་གྱིས་བཞུད་དོ།",
    "ཕྱིར་བྱོན་ནས་བལྟས་པས་ཅི་ཡང་མ་གཟིགས།",
    "ཡང་ནང་དུ་བྱོན་ནས་ལྷ་ལ་གསོལ་བ་བཏབ་ནས་ཇོ་མོ་སྒྲོལ་མའི་ཞལ་ནས།",
    "ཉི་མ་རེ་ལ་ཚ་ཚ་བདུན་བདུན་བཏབ་ན་ཕན་གསུང་སྟེ།",
    "ཁྱོད་ཀྱིས་ཕན་སེམས་ཀྱིས་བྱས་པས་ཉེས་པ་མེད།",
    "ཁྱོད་འབྲས་ཆན་བྲེ་གང་སྦྱིན་པར་བཏང་བ་གཅིག་བོད་ན་རྒྱལ་པོ་བྱེད།",
    "དེའི་མཆོད་གནས་ལ་ཁྱོད་འགྲོ་བར་འདུག་གསུང་།",
    "མུ་ནེ་བཙན་པོ་དུག་གིས་བཀྲོངས་མུ་དུར་བཙན་པོ་སྤྱུགས་སད་ན་ལེགས་མཇིང་ཡོན།",
    "དགེ་སློང་གི་རྒྱུད་པ་རྩད་པོ་ཨ་ཙ་ར།",
    "གཅིག་གིས་སྤྱང་ཐུལ་གཅིག་ཕུལ།",
    "གཅིག་གིས་དྲེའུ་གཅིག་ཕུལ་བའི་དུས་སུ་རྒྱལ་པོའི་ཞལ་ནས།",
    "ད་ངས་མངའ་རིས་སྟོད་ཡ་གིར་རྒྱལ་སྲིད་གཅིག་ཟིན་ན་ཁྱེད་གཉིས་ཀྱི་བུ་མོ་རེ་རེ་ང་ལ་བཙུན་མོར་ཞུ་གསུངས་པས།",
    "དེ་ནས་བློན་པོ་ཡང་ཟངས་ཁ་གཅིག་གིས་བྱས་ཏེ་ཡར་བྱོན་ནས་མངའ་རིས་སྟོད་དུ་སྐུ་མཁར་རྟ་གཟུངས་བྱ་བ་བཟུང་ནས་རྒྱལ་སྲིད་རྒྱ་ཆེ་བར་ཟིན་ནས་དབུས་ཀྱི་བློན་པོ་གཉིས་ཀྱི་བུ་མོ་ལེགས་པོ་ཡོད་པས་རྒྱལ་པོ་ལ་བཙུན་མོར་ཕུལ།",
    "དེར་པ་ཚབ་བོ་དྷེ་རཱ་ཛཱའི་ཟངས་ཁང་བཟའ་ཅིག་ཀྱང་ཁབ་ཏུ་བཞེས་ནས་བཙུན་མོ་གསུམ་ལ་བཟའ་རབས་ཆད།",
    "བཀྲ་ཤིས་མགོན་ལ་སྲས་མངའ་བདག་ཁོ་རེ་དང་སྲོང་ངེ་གཉིས།",
    "ཁོ་རེ་ལ་སྲས་ན་ག་རཱ་ཛཱ་དང་།",
    "སྔགས་ཕ་རོལ་ཏུ་ཕྱིན་པ་གཉིས་ཀྱང་ཆོ་ག་འགལ་བར་གཟིགས།",
    "གང་ཟག་གི་སྦྱངས་པའི་ཁྱད་དང་།",
    "དེའི་རེས་ལ་ལོ་ཙཱ་བའི་འཁོར་ཡང་ཕལ་ཆེར་ཚད་པས་གུམ།",
    "རྒྱ་གར་མཐའ་ཁམས་ཀྱི་མུ་སྟེགས་ཀྱི་རྒྱལ་པོ་གཅིག་གིས་བཙོན་དུ་བཟུང་ནས།",
    "དེ་ལྟར་མ་ཡིན་ན་ལུད་མ་གསེར་ཁྱེད་རང་གི་ལུས་དང་མཉམ་པ་འདོད་ཟེར་བ་ལ།",
    "ད་ཞུ་ཞུ་ཁོང་རང་གི་ཐུགས་དགོངས་ཡོངས་སུ་རྫོགས་པར་བྱ་བ་དང་།",
    "བསྟན་པ་ལ་མ་ཕན་པར་སླར་གནོད་པ་བྱས་པ་བཞིན་དུ་སོང་།",
    "སྐྱི་ཤོད་ནས་ཤིང་བཟོ་མཁན་མི་བདུན་གཏོང་པས་བུད་མེད་འགྲོ་མ་ཉན་པ་ལ།",
    "རྒྱལ་པོས་དེ་ཚོའི་བུད་མེད་ལ་བྱ་དགའ་ཁས་ལེན་པ་ལ་ཁོ་རང་འདེམས་སུ་བཅུག་པས།",
    "རྒྱ་སྟོན་གསུམ་ལ་ཡང་སྲང་ཤས་རེ་བསྐུར་ནས་ཁོང་དཔོན་གཡོག་ལྔ་རྫངས་ནས་བྱོན་པ་ལ།",
    "ཨ་ཙ་རས་གསེར་ཡོད་པ་ཚོར་ནས་གསོད་པའི་གྲོས་བྱེད་པ་ལོ་ཙཱ་བས་ཚོར་ནསདེའི་ནུབ་མོ་གཉུག་མའི་ཁང་པར་ཉལ་བ་བཞིན་བྱས་པ་དང་།",
    "རྡོ་རྗེ་གདན་ནས་བྷི་ཀ་མ་ལ་ཤི་ལའི་འགན་ལྗི་ར་ཉི་ཟེར་ལ་རྩེ་རེ་མཐོང་བ་ཡིན་སྐད།",
    "དེ་ནས་བྷི་ཀ་མ་ལ་ཤི་ལའི་གཙུག་ལག་ཁང་དུ་འགྲོ་བ་ལ་བར་ན་ཆུ་བོ་གྷ་གྷ་ཡོད་རྒས་པ་གཅིག་གི་དུས་ན་ཆུ་བོ་གྷ་གྷའི་འགྲམ་གཅིག་ཏུ་བྱོན་པ་དང་།",
    "གྲུ་པས་འགྲོན་པོ་ཚན་པ་གཅིག་བཅུག་ནས་གྲུ་བསྡུས་ནས་སོང་བ་དང་།",
    "ད་རེས་མི་ཐེག་ཕྱི་རེས་བསུ་བར་བགྱི་ཟེར་རོ།",
    "ད་གྲུ་ཡེ་མི་ཡོང་སྙམ་ནས་ལོ་ཙཱ་བ་དཔོན་གཡོག་གིས་ཐུགས་ཐག་བཅད་ནས་གཟིམས་པའི་གྲབས་བྱས་ནས་ཡོད་པ་ལ་འཕྱི་རྒུ་ལ་ཆུ་ལ་སྐྱ་བ་ཅབ་ཅབ་བྱུང་།",
    "དེར་ཆུ་བོ་གྷ་གྷའི་འགྲམ་ན་བྲག་དེའུ་གཅིག་གི་ཁ་ན་བྷི་ཀ་མ་ལ་ཤི་ལ་ཡོད་པས།",
    "དེར་འཛེགས་ནས་བྱོན་པས་དེའི་ནུབ་མོ་འགྲོན་ཁང་དུ་བྱོན་ནས།",
    "རྒྱ་བརྩོན་སེང་སྒོ་ཁང་གི་སྟེང་བར་ཁང་བསིལ་སྔས་ཀྱི་ཐད་ཁ་ན་གཟིམས་མལ་བཅས་ནས་མར་མེ་ལ་ལྟ་རྟོག་བྱེད་ཀྱིན་བཞུགས་པས་གསན་ནས།",
    "དེ་ནས་རྒྱ་བརྩོན་སེང་གི་ཐུགས་དགོངས་ལ་ཁར་སང་ནི་འཕྱི་མོ་ཚུན་ཆད་ལ་བོད་ཀྱི་མི་སྒུགས་པས་མ་བྱུང་།",
    "ལོ་ཙཱ་བ་དཔོན་གཡོག་གིས་གསེར་བག་རེ་ཕྱག་རྟེན་བྱས་པ་དང་།",
    "རྒྱ་བརྩོན་སེང་གི་ཞལ་ནས།",
    "ན་ནིང་སྐད་མི་གསུང་བར་བོད་ལ་ཐུགས་རྗེས་གཟིགས་པར་ཞུ་གསུངས་པས།",
    "རྒྱལ་པོ་དེ་ལ་ང་ངོ་ཡང་གནོང་པར་ཡོད་ངའི་དྲིན་ལ་ཁོང་གི་མི་ནོར་མང་པོ་ཆུད་ཟོས་ལ་སོང་།",
    "རེ་ཞིག་ཁྱེད་རང་གི་གསེར་ཁྱེད་རང་ཚགས་གྱིས་གསུངས་ནས་ཕྱིར་གཏད།",
    "དེ་ནས་ཇོ་བོས་དེའི་ནུབ་མོ་ནས་རྗེ་བཙུན་མ་སྒྲོལ་མ་ལ་གསོལ་བ་གསུམ་བཏབ་པ་ལ།",
    "རང་གི་ལུས་སྲོག་གི་བར་ཆད་དུ་འགྱུར་རམ་མི་འགྱུར་བྱ་བ་དང་གསོལ་བ་གསུམ་བཏབ་པས།",
    "དེར་ནངས་པར་སོང་ལ་རྣལ་འབྱོར་མ་ཅིག་ཡོང་གིས་དེ་ལ་དྲིས་དང་ཞེས་ལུང་བསྟན་ནོ།",
    "དེ་ཇོ་མོ་སྒྲོལ་མའི་སྤྲུལ་པ་ཡིན་གསུང་དེ་ལ་མེ་ཏོག་རྣམས་ཕུལ་ནས།",
    "དེ་དབུས་པ་ན་རེ།",
    "རྩང་པ་ན་རེ།",
    "དོན་ལ་ལོ་ཉི་ཤུ་ཐམ་པས་ཐུང་དུ་སོང་བ་ཡིན་སྐད།",
    "བུད་མེད་མིའི་ལུས་ལས་འདས་པ་ལྷའི་ལུས་སུ་ཅུང་མ་ཆོག་ཙམ་ཅིག་དང་མཇལ།་",
    "ཁྱེད་ངེས་པར་ལུས་དང་སྲོག་ལ་མ་བལྟ་བར་སོང་ཞིག་འགྲོ་བ་མང་པོ་ལ་ཕན་ཐོགས་པར་འགྱུར་རོ་གསུང་།",
