    "ཁ་བས་འགག་སྐྱོན་མི་འདུག་ན་ལ་དེ་རང་བརྒྱབ་ནས་འགྲོ་རྒྱུའི་བསམ་བློའི་གྲ་སྒྲིག་བྱས་པ་ཡིན།",
    "རི་སྟེང་དུ་མ་གཞི་ཁ་བ་མཐུག་ཚད་ཁྲེ་ཙེ་གཅིག་ལྷག་ཙམ་འདུག་ཀྱང་འགྲུལ་བཞུད་བྱེད་མི་ཐུབ་པ་མེད་གཤིས་ལམ་བསྐོར་མི་དགོས་པར་ཚང་མས་ཐད་ཀར་ལ་དེ་རྒྱབ་པ་ཡིན།",
    "མི་དང་རྒྱ་གསར་པ་ཟེར་གྱི་འདུག་ལྷ་སར་འབྱོར་བ།",
    "བཀྲ་ཤིས་ལྷུན་པོའི་མཆོད་ཁང་ཁག་དང་གྲྭ་ཚང་བཅས་ཚང་མའི་ནང་མའོ་ཀྲུའུ་ཞིའི་སྐུ་པར་མཐོན་པོར་བཀལ་འདུག་ཅིང་།",
    "སྨད་ན་ཀྐཱཔཆམདམས་བསྒྲགས་སྟོབས་ཧ་ཅང་ཆེ་བའི་མི་ཞིག་འདུག་པ་དེ་ནི་བློ་མཐུན་མའོ་ཙེ་ཏུང་ཡིན་ཞིང་།",
    "ང་རང་ལས་མཚན་བྱང་ངོས་པ་རྡོ་རྗེ་དངོས་གྲུབ་བཅས་བསྐོ་བཞག་བྱས།",
    "ང་རང་།",
    "རྗེས་སོར་བོད་མི་མང་པོར་འདྲི་རྩད་སྐབས་ལུང་པ་གྲང་ས་ནས་ཡོང་མཁན་ཁག་གཅིག་ལ་ཚ་ཐོར་དེ་གྲས་ཐོན་གྱི་འདུག་རུང་།",
    "ཡབ་གཞིས་མག་པ་ཕུན་ཚོགས་བཀྲ་ཤིས་ཀྱང་དེ་དུས་ཀ་ཏར་སླེབས་འདུག་པ་མ་ཟད།",
    "ཀ་གཉིས་ཀྱིས་གཙོས་ངོ་ལས་བཅུ་པོ་རང་རང་གོ་རིམ་བཞིན་གྲལ་སྒྲིག་ཏུ་བཅུག་ཅིང་།",
    "ཀྲུའུ་ཞི་གདེང་ཆའི་གཡས་གཡོན་དུ་གློག་བཞུའི་ཤེལ་ཏོག་འཛུགས་ཡུལ་གྲུ་བཞི་གཉིས་འདུག་པ་དེའི་སྟེང་དུ་རྐུབ་སྟེགས་ངོ་གྲངས་དང་མཐུན་པའི་གློག་བཞུའི་ཤེལ་ཏོག་བསྒར་བ་དང་།",
    "ཨམ་ཅོག་རྒྱབ་ཀྱི་ལྷགས་པར་བཏང་སྟེ་གོ་མིན་ཏང་རང་ཉིད་ཀྱིས་སྔོན་གཏན་གང་འཁེལ་དེ་རང་ལས་འགལ་ས་མེད་གཤིས།་",
    "བཟོ་གྲྭ་ཉུང་ཤས་ལས་མེད་པ་དེ་ཚོའང་དམག་འཁྲུག་སྐབས་གཏོར་སྐྱོན་ཕོག་པ་དེ་མུར་ཉམས་གསོ་མ་ཐུབ་པར་ལུས་འདུག་པ་དཔེར་ན།",
    "དེར་ཕྱི་རྒྱལ་དང་རང་རྒྱལ་གྱིས་གཉེར་བའི་མགྲོན་ཁང་ལེགས་གྲས་མང་པོ་ཡོད་རུང་།",
    "སེང་གེ་འཁོད་པ་དེ་པང་ལེབ་ཐོག་བྲིས་པའི་གཤམ་དུ་བོད་ཅེས་པའི་ཡི་གེ་དང་བཅས་སྒྲིག་སྦྱོར་བྱས་འདུག།",
    "རྒྱ་གར་གཞུང་ནས་གསུང་དོན་ད་ལམ་འདི་སྐོར་ཀྲུང་གོའི་གཞུང་ནས་དེ་ལྟར་གསུང་དོན་མི་འདུག་གང་ཡིན་ཟེར་ན།",
    "བོད་ཀྱི་སྐུ་ཚབ་ལ་གྲལ་གནས་བཞིན་སྤྲད་འདུག་ཅིང་།",
    "ཏར་ཡིག་དེའི་མཇུག་ཏུ་པཎ་ཆེན་འོས་སྤྲུལ་གྱི་བྱད་བཞིན་གཟུགས་དབྱིབས་སྐོར་འཁོད་འདུག་ཏར་ཡིག་བལྟས་རྗེས་ཝང་ཧྲུའུ་ཅིས་ང་གཉིས་ལ་སོ་སོའི་བསམ་ཚུལ་དང་དེ་སྐོར་གང་འགབ་ཅི་ལེགས་བསམ་འཆར་ཤོད་དུ་བཅུག་ཅིང་།",
    "ལན་འདེབས་བྱེད་སྐབས་བག་ཁུམ་འཚེར་སྣང་ཆེ་བ་ཞིག་འདུག་དེའི་མཇུག་ཏུ་རོགས་ཟླ་ལྟ་བུ་མི་གཉིས་ཡོད་པ་ལས་གཅིག་ནི་ལོ་ངོ་ལྔ་བཅུ་ཡས་མས་སོན་པ་དང་།",
    "ག་དུས་ཕྱིར་ལོག་རྒྱུ་སོགས་ཚུད་ཡོད།",
    "མ་ཉི་ཤུའི་གཡས་གཡོན་ཙམ་འགོར་གྱིན་འདུག་བློ་མཐུན་ལུའུ་ཅིང་འུ་ཡིས་ཐོག་མར་མི་གསུམ་པོ་དེར་ཁྱེད་ཚོ་ཚོང་པ་ཡིན་ནམ།",
    "དེང་སང་བསམ་བློ་གཏོང་དུས་ད་ལྟའང་མིག་ལམ་ནང་ལྷང་ལྷང་དུ་འཆར་གྱིན་འདུག།",
    "ཉ་སྨོན་བུ་རྣམ་རྒྱལ་གྲགས་བཟང་རང་ལོ་བཅས་མི་གྲངས་དང་།",
    "གཟ་མཐུན་རྐྱེན་གནང་འོས་བོད་གཞུང་རང་ནས་གནང་རྩིས་ཡོད།",
    "དྲུང་དཀྱུས་བཅས་ལ་སྔར་སྲོལ་གདན་ཐོབ་སྒྲོན་རྒྱག་གནང་འདུག་པ་དང་།",
    "བྱམས་འདེགས་པ་རྒྱ་རིགས་མི་གྲངས་བཅུ་སྐོར་ཞིག་མཉམ་ཁྲིད་བྱས་འདུག་ལྷན་དུ་ཚའོ་འུ་འུན་དང་།",
    "སྔོན་ཕུལ་གསེར་གྱི་རྟགས་མ་དེ་ཡང་འདོགས་གནང་མཛད་འདུག།",
    "འུ་ཀྲུང་ཤིན་བཞུགས་གནས་སྒེར་ཟས་ཞིམ་པའི་ཁྱིམ་འཛིན་ནས་འུ་ཀྲུང་ཤིན་བརྒྱུད་ཞུས་དོན་ལྟར་ཕྱིན་ཆད་ཟས་ཞིམ་གྱི་ཁང་པར་ཚེར་འབེབས་མི་གནང་བའི་ལག་ཁྱེར་བཀའ་ཐོ་འབྱར་མ་ཞིག་ཀྱང་སྩལ་ཐོན་བྱུང་འདུག་དེ་རྗེས་ཁྲི་འབུལ་སོགས་ཀྱི་བྱེད་སྒོ་ཟིན་ཏེ་འུ་ཀྲུང་ཤིན་ཆུ་ཐོག་བརྒྱུད་ཕྱིར་ལོག་གནང་སྐབས་སྔོན་དུ་ཕེབས་བསུའི་སྐབས་ལྟར་ཕེབས་སྐྱེལ་གཟབ་རྒྱས་ཞུས་ནས་མཛད་མཇུག་བསྒྲིལ།",
    "ང་རང་ཡང་རྒྱལ་ཟུར་རྭ་སྒྲེང་ལ་འཁོན་འཛིན་ཡོད།",
    "གལ་ཏེ་ཁྱེད་རང་ཐར་བ་ཡིན་ནའང་ལྷ་སར་ཁྱེད་ཀྱི་སྐུ་མཆེད་ཛ་སག་སོགས་སྡུག་པོ་མྱང་རྒྱུ་ལས་མེད་ཟེར་བྱུང་།",
    "ཕེབས་གྲ་སྒྲིག་རྒྱུའི་ཐད་ཁྱེད་རང་དང་སྐུ་འཁོར་གཉིས་ཙམ་མཉམ་ཁྲིད་གནང་ན་འགྲིག་ཆིབས་རྟ་གསུམ་དང་ཁལ་རྟ་གཅིག་འཁྲིད་ཕེབས།",
    "དེ་འཕྲལ་ཆིབས་དཔོན་ལ་རྟ་སྒ་རྒྱོབས་ཤོག་ལབ་པ་ལྟར་ངའི་རྟ་སྒ་རྟ་གཡུ་འབྲུག་ལ་བརྒྱབ་འདུག་ངས་གྲ་ཆས་ལེགས་པ་ཆ་ཚང་གྱོན་ཐོག་ཁ་འདོན་ཡོ་ཆས་དང་།",
    "རྟ་ཞོན་ཁར་པའི་རྟ་སྒ་ཞོན་རྟ་གཡུ་འབྲུག་ཟེར་བ་དེར་བརྒྱབ་འདུག་རུང་།",
    "གསོལ་གཟིམ་གཉིས་མིག་ཆུ་གཏོང་བཞིན་འདུག་ངས་བརྒྱ་ལོར་རས་སྒྲིལ་དེ་ནས་ཕྱེད་ཀ་ཙམ་གསོལ་གཟིམ་གཉིས་ལ་སྤྲད་པ་ཡིན།",
    "གལ་ཏེ་ང་ལ་བཙོན་འཇུག་མནར་གཅོད་མུ་མཐུད་བཏང་ན་ཉ་དང་ཆུ་ཚང་མ་མི་བདེ་བ་ཡོང་རྒྱུ་ལས་མི་འདུག་དེ་ལུགས་དགོངས་འཇགས་ཞུ།",
    "རྭ་སྒྲེང་རྒྱལ་ཟུར་གྱིས་ཡི་གེ་དེ་གསུམ་ཨོ་རྒྱན་རྣམ་གྲོལ་དང་ང་རང་ལ་གསང་བའི་སྒོ་ནས་ཁུངས་སོ་སོར་འཕྲོད་ཐབས་བྱེད་རོགས་གསུངས་བྱུང་།",
    "ང་རང་ནི་དེའི་བུ་གསུམ་པ་ཡིན་པ་མ་ཟད།",
    "ལོར་ཀྲུང་ཧིན་མཐའ་མཚམས་ཀྱི་རང་སྲུང་རྒོལ་ལན་སློག་སྐབས་ཀྱང་བོད་དངུལ་འགྲོ་རྒྱུག་བྱེད་མུས་སུ་འདུག་བཞི།",
    "དེ་དུས་ང་རང་ལ་ཐའི་ཇིའི་གོ་མིང་ཡོད་པས་གནམ་གྲུ་འབབ་ཐང་ལས་གྲའི་དོ་དམ་པ་ངོ་མ་ཡིན་པ་དང་།",
    "ལས་གྲའི་གྲ་སྒྲིག་ཀྱང་གང་ལེགས་གནང་ཟིན་འདུག་ལས་མིའི་གཞི་རྩའི་གནས་ཚུལ།",
    "ང་རང་བཅས་ལ་བསྐོ་གཞག་གནང་ཞིང་།",
    "ཁྱེད་རང་ལ་གནམ་གྲུ་འབབ་ཐང་ལས་གྲའི་འགོ་འདོམས་བསྐོ་བཞག་གནང་བ་ལས་དེ་མིན་བཀོད་མངགས་མེད་རུང་།",
    "མི་དམངས་བཅིངས་འགྲོལ་དམག་འཁྲུག་དེ་རྒྱལ་ཡོངས་ལ་རྒྱལ་ཁའི་ཕྱོགས་སུ་ཁྱབ་གདལ་འགྲོ་བའི་སྐབས་ལོ་བརྒྱ་ཕྲག་ནང་རང་རྒྱལ་གྱི་བོད་ལྗོངས་སྟངས་འཛིན་བྱེད་མཁན་བཙན་རྒྱལ་རིང་ལུགས་ཀྱི་སྟོབས་ཤུགས་དང་།",
    "ཆེན་པོ་ཇི་ལྟར་ཡོད་རུང་རང་དམག་མདུན་སྐྱོད་བྱེད་པའི་གོམ་སྟབས་དེ་བཀག་འགོག་བྱེད་ཐུབ་མེད།",
    "གྲོད་པ་རྟོགས་པ་དེ་དམག་ཕམ་པ་ལས་དཀའ་ལས་ཆེ་བ་མི་འདུག་ཨཀཱཀན།",
    "མེ་ཤིང་ལའང་རིན་དངུལ་རྭ་ཡང་མང་པོ་སྤྱོད་ཀྱི་འདུག་ཟེར་བའི་གནས་ཚུལ་གོ་ཐོས་བྱུང་ཞིང་།",
    "ཙ་ན་་",
    "ལྟོགས་སྐོམ་དང་ན་ཚ་སོགས་འཇིགས་སྐྲག་ཡིད་མུག་དང་སྐྱོ་ཤས་ཀྱི་ཁེངས་ནས་བསྡད་འདུག་སྐབས་དེར་ཀུན་བཟང་རྩེ་དང་།",
    "ཏཱ་ལ་རུ་ཚོགས་མཉམ་འབྲེལ་གྱིས་ལམ་ཡིག་སྤྲོད་ཀྱི་འདུག་པས་འགན་འཁུར་ཕ་ལྷ་ཐུབ་བསྟན་འོད་ལྡན་དང་།",
    "ཁོང་དགུང་ལོ་བརྒྱད་ཙམ་ལ་སླེབས་དུས་ཡབ་གཤེགས་འདུག་ཀྱང་།",
    "འཇོན་ཐང་ཆེན་པོ་ཡོད་མཁན་ཞིག་ཡིན་འདུག་གཤིས།",
    "ཡིན་ནའང་ནང་དོན་གལ་ཆེའི་ཕྱག་བྲིས་ཞབས་ཞུ་སོགས་སྔར་བཞིན་གནང་བ་མ་ཟད་ལས་དོན་སྐོར་གྱི་བཀའ་སམ་ཡང་ཆིབས་གཡོག་གདོང་རྟག་ཏུ་ཕེབས་ཀྱི་འདུག།",
    "ང་རང་ཡང་དགའ་ཐག་ཆོད་ནས་ནང་དུ་ལོག་ཕྱིན་ཏེ་གནས་ཚུལ་རྣམས་པ་ལགས་ལ་ཞུས་པ་ཡིན།",
    "ཞེས་སོགས་འཁོད་འདུག་དེ་རྗེས་ང་རང་སླར་ཡང་ཞབས་སྡོད་ཞུ་ཐུབ་པ་མ་ཟད་བཀའ་ཤག་ནང་བཀའ་མགྲོན་ཡང་བྱེད་ཐུབ་གཤིས།",
    "དམག་དཀྱུས་བཞི་བཏང་འདུག་ཀྱང་ཀགནམ་པས་ཞལ་ངོ་དང་།",
    "ང་རང་དོ་དགོང་ལོག་མ་བྱུང་ན་རྐུན་མ་གླིང་ཁའི་ནང་རྩེ་དྲུང་།",
    "སྤོ་མི་རྣམས་ལྷོ་ཤིང་ཁྲི་ཟེར་བའི་མི་རྒྱུད་ཡིན་ཟེ་ཤོད་སྲོལ་འདུག་པ་མ་ཟད།",
    "ང་རང་སྲུང་བྱར་བསྐོ་བཞག་བྱས་པ་དང་རྭ་སྒྲེང་ལྷ་སར་ཕེབས་པའི་གནས་ཚུལ།",
    "དེ་གར་པའི་གཉེར་པ་ནས་གྱོན་པ་འབོག་སྒྲིལ་འཁྱེར་ནས་ང་སྒུག་བསྡད་འདུག་གཉེར་པས་ང་མཐོང་བ་དང་ཨ་རྩི་མགྱོགས་པོ་ན་བཟའ་བཞེས་དང་།",
    "ང་གཉིས་ལམ་སེང་ཤར་ཆེན་ལྕོག་ཏུ་མར་ཕྱིན་པར་ཞིབ་པ་ལགས་སྡོད་སའི་འོག་དེར་སྒེའུ་ཁུང་ཉིས་ཧྲལ་ཆུང་ངུ་ཡོད་པའི་ཁང་པ་ཞིག་འདུག་པ་དེར་གད་འཕྱིས་ཚར་བསྟུན་རྩེ་ཕྱག་ནས་འབོལ་གདན་གདན་ཁྲི་རང་འགྲིགས་ཆ་གཅིག་དང་།",
    "བླ་བྲང་རང་འཇགས་གནས་པ་ཡོང་བའི་རོགས་རམ་ཡོད་པ་ཞེས་གཙོ་བོའི་ཚིག་པོད་དང་པོ།",
    "ང་གཉིས་ནས་བཞུ་མར་སྤར་ཏེ་ཡར་ལངས་ནས་གང་འདུག་ཞུས་པར་སྤྲེའུ་ཐང་ཞུ་གྱོན་པ་འཇིགས་རུང་ཞིག་སྒེའུ་ཁུང་ནས་ཡར་འཛུལ་ཏེ་སླེབས་བྱུང་།",
    "གང་ཡང་མི་འདུག་ཞེད་སྣང་མ་མཛད་ཞུས་པ་ཡིན།",
    "ཁོང་ཆུང་དུས་མཚན་དེ་རང་འབོད་ཀྱི་འདུག་ཁོང་བྱིས་པའི་དུས་སུ་སྤྱང་གྲུང་འཛོམས་ཤིང་ཕ་མར་བརྩི་བཀུར་ཆེ་བ།",
    "ཁྱེད་རང་ནས་བཀའ་ཤག་ལ་བདེ་སྡུག་དང་།",
    "ང་རང་སྒེར་གྱི་འབྲུ་ཁལ་དྲུག་བརྒྱ་ཡང་སྤྲད་ཡོད།",
    "གནམ་གྲུའི་ནང་ནས་ཡོང་བའི་མི་ལྔ་ཧིན་རྡུར་བྲོས་བྱོལ་ཕྱིན་པ་ལས་དེ་བྱིངས་ཚང་མ་དམག་སར་ཤི་ཡོད་པའི་གནས་ཚུལ་འདུག་ཅིང་།",
    "བྱུང་འདུག་པས་རང་ཉིད་ལ་སྐུལ་འདེད་ཆེན་པོ་བྱུང་།",
    "ང་རང་ལོ་ན་དྲུག་ཅུ་ལྷག་ཙམ་ལ་སླེབས་པའི་རྒས་ཁོག་ཞིག་ཆབ་སྲིད་ཐོག་བློ་བདེ་བག་ཕེབས་དང་།",
    "རྒྱལ་ཡོངས་ཀྱི་ས་ཆ་ཁག་ཚང་མ་བཅིངས་འགྲོལ་བཏང་ཟིན་རྗེས་ཁྱིམ་དུ་མཉམ་འཛོམ་བྱེད་པར་ཡོང་རྒྱུ་ཡིན་ལུགས་འཁོད་འདུག་ཀྲུང་ཧྭ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་དབུ་བརྙེས་རྗེས།",
    "ང་རང་གཉིས་ཀྱང་ཚད་ཙམ་བྱེད་དོ་ཞེས་བཤད།",
    "དགྲ་བོའི་གནས་ཚུལ་ཡོད་མ་ཐག་ག་དུས་ཡིན་ནའང་དམག་འཐབ་ནང་གཞུག་ན་འགྲིག་ས་འདིར་རྐང་པ་འཛུགས་ཐུབ་པའི་ཆེད་ཁང་པ་རྒྱག་པར་ཤིང་ཆ་མེད་རུང་ས་སྡུག་བྱུས་ཏེ་གནས་སྐབས་སྡོད་ས་བཟོས་ཡོད།",
    "ཁོང་རང་ཉིད་ནས་རྐང་ཀྱོག་གནང་ཡོད།",
    "ཞོགས་པ་གློག་འཕྲིན་སྒྱུར་པ་པོས་ཁོང་ལ་དཔུང་ཆེན་གྱིས་དཔུང་སྐྱོད་བྱེད་པའི་གནས་ཚུལ་ག་དུས་སྙན་གསེང་ཞུས་ནའང་།",
    "ཀོ་བ་དང་སྡོང་རྫིང་ཕར་འགྲོ་ཚུར་འོང་བྱེད་ཀྱི་འདུག་རི་འདེབས་དང་རི་ཤུར་རྣམས་ཤིང་ནགས་སྟུག་པོས་ཁེབས་ཤིང་།",
