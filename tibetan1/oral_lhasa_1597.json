    "གང་ཞིག་ཐ་དད་པར་སྣང་བ་དེ་ནི་ཐ་དད་པ་ཁོ་ནའོ་ཞེ་ན།",
    "འོན་ཏེ་སྤྱི་ཉིད་དང་ལྡན་པའི་ཕྱིར་འབའ་ཞིག་ཀྱང་སྤྱི་ཡིན་པར་འགྱུར་རོ་ཞེ་ན།",
    "འོ་ན་གསལ་བ་ལ་འཇུག་པའམ་རྟོགས་པར་མི་འགྱུར་རོ།",
    "བློས་འཁྲུལ་པའི་རང་བཞིན་རྟོགས་པས་ནི་གསལ་བའི་རང་བཞིན་དང་དེ་ལ་འཇུག་པར་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེས་ན་འཁྲུལ་པ་གཞན་དང་གཞན་ཁས་ལེན་པ་ཐུག་པ་མེད་པར་འགྱུར་བའི་ཕྱིར་མི་རྟོགས་པ་ཉིད་པས་འདི་ནི་གྱི་ནའོ།",
    "ཚུལ་ནི་ཅི་ཞིག་ཡོད་པར་འགྱུར།",
    "གལ་ཏེ་འོས་གཞན་མེད་པས་ནི་དངོས་པོ་རྣམ་པར་འཇོག་པ་མ་ཡིན་གྱི།",
    "ཅི་ཕྱིར་ངེས་པར་འཛིན་མི་བྱེད།",
    "ཐ་སྙད་པ་དེ་དག་ལས་གཞན་རྣམ་པར་གཅད་ནས་འཇུག་པར་དམིགས་སོ།",
    "དེས་ན་རྣམ་པར་གཅོད་པར་རྟོགས་པར་ངེས་པ་ཡིན་ནོ།",
    "དེ་ནི་མངོན་སུམ་གྱིས་གཞན་དང་མ་འདྲེས་པར་རྟོགས་པ་ཡིན་ལ།",
    "རྣམ་པར་རྟོག་པས་ཀྱང་ངོ།",
    "རྣམ་པར་རྟོག་པ་རྣམས་ནི་དངོས་པོའི་ཡུལ་ཅན་མ་ཡིན་པ་ཉིད་དོ།",
    "གལ་ཏེ་དངོས་པོ་མ་རྟོགས་ན་ལྡོག་པ་དུམ་བུར་བཀོལ་ཏེ་ཇི་ལྟར་རྟོགས་པར་འགྱུར་ཞེ་ན།",
    "བདེན་དང་བདེན་པ་མིན་པར་ཁྱད་གཞན་བློ་དོན་ལྡན་པ་སུ་ཞིག་རྟོགས།",
    "དངོས་པོ་ཙམ་ཞིག་མེད་ན་རྣམ་པར་གཅོད་པ་རྟོགས་པར་མི་ནུས་པ་དེ་ཙམ་ཞིག་ཐ་སྙད་པ་རྣམས་ཀྱིས་དངོས་པོ་གྲུབ་པ་ལ་མཐུ་ཡོད་པ་ཡིན་ནོ།",
    "བདེན་པའི་དངོས་པོ་དང་འབྲེལ་པ་ཉིད་ནི་རྣམ་པར་གཅོད་པར་རྟོགས་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "བདེན་པ་དང་འབྲེལ་པ་མ་ཡིན་པས་ཀྱང་དེ་རྟོགས་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ངག་ནི་རྣམ་པར་གཅོད་པའི་ཡུལ་ཅན་ཉིད་དེ།",
    "བོང་བུའི་འོ་མ་བསྐོགས་པ་དང་མཚུངས་པར་འགྱུར་རོ།",
    "འོན་ཏེ་ཐོབ་པར་བྱ་བའི་རང་བཞིན་ཉིད་མེད་པ་དེས་ན་སླུ་བའི་ཕྱིར་མི་བདེན་པ་ཡིན་གྱི།",
    "དེ་ལྟར་ན་ནི་འོ་ན་རྣམ་པར་གཅོད་པ་ནི་བདེན་ནོ་ཞེས་བྱ་བ་དེ་ལྟར་འགྱུར་རོ།",
    "གལ་ཏེ་གང་ཞིག་ཐོབ་པར་བྱ་བ་དེ་བདེན་པ་ཡིན་ན་རྣམ་པར་གཅོད་པ་བདེན་པ་ཉིད་དུ་འགྱུར་ཏེ།",
    "གལ་ཏེ་དེས་ནི་མི་བདེན་པའི་དངོས་པོ་རྣམ་པར་བཅད་པ་རྟོགས་པ་ཡིན་ན་དེ་ནི་ཐོབ་པ་མ་ཡིན་ཏེ།",
    "བདེན་པའི་དངོས་པོའི་རྣམ་པར་བཅད་པ་རྟོགས་པའི་ཕྱིར་རོ།",
    "དེས་ན་རྣམ་པར་གཅོད་པ་བདེན་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "དོན་དམ་པར་ནི་རྣམ་དཔྱད་ན།",
    "ཡིན་ན་ཐུག་པ་མེད་པར་བརྗོད།",
    "དོན་དམ་པར་ནི་མ་ཡིན་ནོ།",
    "འོན་ཏེ་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་ཐ་མི་དད་པ་ཡིན་ན་དེ་ལྟ་ཡིན་ན་དེ་ཡང་དེའི་ཆེ་ཉིད་རྟོགས་པས་ཅིའི་དོན་དུ་འཇུག་པའམ་ཅི་ཞིག་ཐོབ་པར་བྱར་ཡོད།",
    "ཚིག་རྣམས་ཀྱིས་ནི་རྟོགས་པར་འགྱུར།",
    "པདྨ་སྔོན་པོར་འགྱུར་རོ་ཞེས་ཁྱད་པར་དང་།",
    "ཁྱད་པར་གྱི་གཞི་དང་།",
    "ཁྱད་པར་ལ་ངེས་པར་བཟུང་ན་ནི་གཞན་དང་མི་ལྡན་པ་རྣམ་པར་གཅོད་ལ་ཁྱད་པར་ཅན་ལ་ངེས་པར་བཟུང་ན་ནི་གཞན་དང་ལྡན་པ།",
    "བྱ་བ་ལ་ངེས་པར་བཟུང་ན་ནི་ཤིན་ཏུ་མི་ལྡན་པ་རྣམ་པར་གཅོད་པའི་ཕྱིར་ཐ་དད་དོ།",
    "སྦྱོར་པ་མེད་པར་ཇི་ལྟར་ངེས་པར་བཟུང་བའི་ཁྱད་པར་ངེས་ཤེ་ན།",
    "སྐབས་དང་བརྗོད་པར་འདོད་པ་དང་།",
    "ཁྱད་པར་དག་ལས་སོ།",
    "གལ་ཏེ་ཇི་ལྟར་སྲིད་སྒྲུབ་ཉིད་འཕོང་སྐྱེན་ནོ་ཞེས་ཁྱད་པར་ཅན་དང་ལྷན་ཅིག་ངེས་པར་གཟུང་བས་ཁྱད་པར་ཅན་གཞན་རྣམ་པར་གཅོད་པ་དེ་བཞིན་དུ་ཁྱད་པར་དང་ལྷན་ཅིག་པས་ཀྱང་ཁྱད་པར་གཞན་རྣམ་པར་གཅོད་པར་འགྱུར་རོ།",
    "དེས་ན་ནག་པ་འཕོང་སྐྱེན་པ་ཉིད་དོ་ཞེས་བྱ་བས་ཡོན་ཏན་ཐམས་ཅད་རྣམ་པར་གཅོད་པར་འགྱུར་ན།",
    "མི་ལྡན་པ་དང་གཞན་དང་ལྡན་པ་རྣམ་པར་གཅོད་པ་དག་བྱེ་བྲག་ཀྱང་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "འོན་ཏེ་མི་སྐྱེན་ཞེས་འཕོང་སྐྱེན་པར་ཐེ་ཚོམ་ཟ་བའི་སྐབས་སུ་ནག་པ་འཕོང་སྐྱེན་ནོ་ཞེས་སྦྱར་བ་དེའི་ཚེ་དེ་ཉིད་ཐེ་ཚོམ་གཅོད་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་འཕོང་མི་སྐྱེན་པ་ཁོ་ན་རྣམ་པར་གཅོད་དོ།",
    "དེས་ན་བཟློག་པའི་ཟླ་བོ་རྣམ་པར་གཅོད་པ་ཉིད་རྟོགས་ཀྱི།",
    "དེ་བཞིན་དུ་གཞན་དང་ལྡན་པ་རྣམ་པར་གཅོད་པའི་ངག་དེ་ལ་ཡང་གལ་ཏེ་སྲིད་སྒྲུབ་དང་རྣ་ཅན་གཉིས་འཕོང་སྐྱེན་ཞེས་སོ་སོར་ངེས་པའི་བཟློག་ཟླའི་སྐབས་ཡིན་ན་ནི་སྲིད་སྒྲུབ་ཉིད་འཕོང་སྐྱེན་ནོ་ཞེས་དེ་ལས་རྣ་ཅན་ཉིད་རྣམ་པར་གཅོད་ཀྱི།",
    "ར་མ་ལ་སོགས་པ་ནི་རྣམ་པར་གཅོད་པ་མ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་མི་ལྡན་པ་རྣམ་པར་གཅོད་པ་ལ་ཡང་གལ་ཏེ་ཅི་ཡོན་ཏན་གཞན་དག་ཀྱང་ཡོད་དམ་ཞེས་བྱ་བའི་སྐབས་སུ་ཡིན་ན་ནི་དེའི་ཚེ་ནི་ནག་པ་ནི་འཕོང་སྐྱེན་པ་ཉིད་ཀྱི་ཁམས་པ་ལ་སོགས་པ་ནི་མ་ཡིན་ནོ་ཞེས་འཁྲུལ་པ་མེད་པའི་ཡོན་ཏན་མཐའ་དག་རྣམ་པར་གཅོད་པ་ཉིད་དོ།",
    "ཐེ་ཚོམ་ཟ་བའི་སྐབས་སུ་བབ་པ་དེའི་ཚེ་ཁྱད་པར་དང་ལྡན་པ་གཞན་མཐའ་དག་རྣམ་པར་གཅོད་པ་ཉིད་དེ།",
    "དེས་ན་དེ་བསྟན་པས་གཞན་རྣམ་པར་གཅོད་པ་མ་ཡིན་པའི་ཕྱིར་རྗེས་སུ་འགྲོ་བ་མེད་པའི་སྐྱོན་མེད་དོ།",
    "དོན་འདི་རྟོགས་པར་ནུས་པའི་ཡང་ཕྱིར་ཏེ།",
    "གཞན་དང་ལྡན་པར་གྲུབ་པ་དེར་ངེས་པར་གཟུང་བ་ནི་དེ་ཉིད་ལ་འབབ་པ་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་སྒྲ་དག་ནི་བརྗོད་པར་འདོད་པའི་རྗེས་སུ་འབྲང་བ་ཡིན་པའི་ཕྱིར་དེ་ལྟ་བུ་ཉིད་དུ་རྟོགས་པར་འགྱུར་རོ།",
    "བརྗོད་པར་འདོད་པ་ནི་གཞན་ཡིན་ཏེ།",
    "སྒྲ་ནི་གཞན་དུ་བསྟན་པར་ནུས་པ་ནི་མ་ཡིན་ནོ།",
    "སྒྲ་ནི་སྒྲོན་མ་བཞིན་དུ་ངོ་བོ་ཉིད་ཀྱིས་རྟོགས་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "གལ་ཏེ་འཕོང་སྐྱེན་པ་ནི་སྲིད་སྒྲུབ་ཁོ་ནའོ་ཞེས་ཁྱད་པར་དང་ལྷན་ཅིག་ངེས་པར་གཟུང་ཡང་གཞན་དང་ལྡན་པ་ཉིད་རྣམ་པར་གཅོད་ཀྱི་མི་ལྡན་པ་ནི་མ་ཡིན་པའི་ཕྱིར་སྐབས་དང་འགལ་ལོ་ཞེ་ན།",
    "ཁྱད་པར་དུ་ནི་བསྟན་ན་ཡང་།",
    "དོན་དམ་པར་ན་སྲིད་སྒྲུབ་ཉིད་རྟེན་ཡིན་པའི་ཕྱིར་ཁྱད་པར་ཅན་ཉིད་དོ།",
    "འདིར་ནི་ངེས་པར་གཟུང་བའི་དོན་རྣམ་པར་གཅོད་པའི་རང་བཞིན་ནི་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་རྣམ་པར་ཕྱེ་ནས་རྟོགས་པའི་ཕྱིར་མི་རྟོགས་པའི་སྐྱོན་མེད་དོ།",
    "གཞན་དང་ལྡན་པ་རྣམ་པར་གཅོད་པས་ཁྱད་པར་ཡིན་ན་ནི་གཅིག་དེ་ལྟར་གྱུར་པ་ན་གཞན་དེ་ལྟར་མ་ཡིན་པར་འགྱུར་ལ་ཁྱད་པར་དང་ཁྱད་པར་ཅན་དང་ལྡན་པའི་ཚིག་ཕྲད་ཀྱང་ཁྱད་པར་མེད་པར་འགྱུར་རོ།",
    "དེ་ལ་གཞན་མཐའ་དག་མ་བྱས་པ་ཉིད་དུ་འགྱུར་བ་དང་།",
    "ས་ཕྱོགས་གཞན་དུ་བ་དང་མི་ལྡན་པར་འགྱུར་བས་དེ་དེ་ལྟར་མངོན་སུམ་དང་རྗེས་སུ་དཔག་པ་དང་འགལ་བར་འགྱུར་རོ།",
    "རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་ཀྱི་འཇིག་རྟེན་གྱི་གྲགས་པ་ལས་ཀྱང་ཁྱད་པར་ལ་སོགས་པ་དང་ལྷན་ཅིག་སྤྱོད་པའི་ངེས་པར་གཟུང་བའི་དོན་ཅན་ཚིག་ཕྲད་དང་།",
    "མ་འབྲེལ་པ་རྣམ་པར་གཅོད་པ་ལ་སོགས་པ་དེའི་དོན་དག་བརྗོད་པར་བྱ་བ་དང་རྗོད་པར་བྱེད་པའི་དངོས་པོའམ་གཞན་དག་རྟོགས་པའི་ཕྱིར་དེ་ལ་ཇི་ལྟར་གཞན་དུ་འགྱུར།",
    "ཡང་དག་པའི་གཏན་ཚིགས་རྣམས་བསྟན་པའི་ཕྱིར་དེ་ཙམ་བསྟན་པར་བྱ་བ་ཡིན་གྱི།",
    "རྩོད་ཕྱིར་ཁྱད་པར་སྤྱི་དག་སྟེ།",
    "གཞན་དག་མཐོང་བ་དང་མ་མཐོང་བ་ཙམ་གྱིས་མ་ངེས་པ་ཡང་ངེས་པར་རྟོགས་པས་དེ་རྣམ་པར་གཅད་པའི་གཞན་གཉིས་སོ།",
    "དེས་ན་རྗེས་སུ་དཔག་པས་ནི་རྣམ་པར་གཅོད་པ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་བསྟན་པ་ཡིན་ནོ།",
    "གཞལ་བྱ་བྱས་དང་མི་རྟག་དང་།",
    "བྱས་དང་མཉན་བྱ་རྩོལ་བྱུང་དང་།",
    "བསྒྲུབ་པར་བྱ་བ་ལ་ལྟོས་ནས་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་འགྱུར་བའི་ཕྱིར།",
    "བསྒྲུབ་པར་བྱ་བ་ཐ་དད་པ་འབྲེལ་པས་ན་གཅིག་དེ་ཉིད་ཡང་དག་པའི་གཏན་ཚིགས་དང་འགལ་བར་འགྱུར་བའི་ཕྱིར་མི་འཐད་པ་ཅི་ཡང་མེད་དོ།",
    "དེས་ན་གཏན་ཚིགས་གཉིས་ཏེ་བྱས་པ་ཉིད་ཀྱི་ཕྱིར་མི་རྟག་གོ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་ཡིན་ལ།",
    "བྱས་པ་ཉིད་ནི་རང་བཞིན་གྱི་གཏན་ཚིགས་ཡིན་ལ།",
    "བྱས་པ་ཉིད་ནི་ཁྱབ་མཉམ་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་དམིགས་པ་ཉིད་ཡོད་པར་བརྗོད་པ་བཞིན་ནོ།",
    "དཔེར་ན་མར་མེའི་བསྡོགས་པའི་རྩོལ་བ་ནི་བུམ་པའི་འབྲས་བུ་ཉིད་དུ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ལ།",
    "གལ་ཏེ་སྒྲ་རྟག་པར་འཐད་པར་འགྱུར་བ་ནི།",
    "བྱེད་པ་ནི་སྦྱོར་བའི་དོན་ཡིན་པའི་ཕྱིར་དཔེར་ན་ངའི་རྐང་པར་གྱིས་ཤིག།",
    "དེས་ན་རྟག་ཏུ་ཡོད་པར་འགྱུར་བས་ན།",
    "དེ་དང་དེ་མིན་དུས་ལྡན་པར།",
    "འགས་ཀྱང་ཅུང་ཟད་སྤྱོད་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར།",
    "འགྲོ་བ་སྡོད་པ་མེད་པར་འགྱུར་རོ།",
    "རྒྱུ་རྣམས་ཀྱིས་ངེས་པར་བྱེད་པ་ཡིན་ཏེ།",
    "གཞན་བཟློག་པ་ལས་མ་གཏོགས་པར།",
    "མེད་ན་བྱེད་པར་མི་ནུས་ཏེ།",
    "འོ་ན་ཅི་དུས་གཞན་དུ་དམིགས་པ་དེ་ཉིད་མར་མེས་གསལ་བར་བྱས་པ་ཡིན་པ་དེ་བཞིན་དུ་སྒྲ་ཡང་རྩོལ་བས་གསལ་བར་བྱ་བར་འགྱུར་རོ་ཞེ་ན།",
    "གཞན་ཡང་ཅི་ངོ་ཤེས་པས་ཤེས་པ་ཡོད་པར་བསྒྲུབ་པའམ།",
    "འོན་ཏེ་ཤེས་གཉིས་དབུས་ན་ཡོད་པར་གྲུབ།",
    "དེ་ནི་དེའི་ཚེ་སྔར་ཤེས་པ་དེ་ཉིད་ཀྱིས་བསྒྲུབས་ཤིང་དྲན་པས་ཐ་སྙད་དུ་བྱས་པས་དེ་ལ་ངོ་ཤེས་པས་དགོས་པ་ཅི་ཡོད།",
    "དྲན་པ་ནི་དེའི་དུས་ཉིད་ན་ཡོད་པ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དྲན་པ་མེད་པར་རྟོགས་མ་ཡིན།",
    "མངོན་སུམ་གྱིས་ནི་དེ་འགོག་པར་བྱེད་པ་མ་ཡིན་ནོ།",
    "དངོས་དོན་འགོག་པར་བྱེད་མ་ཡིན།",
    "ཤི་བའི་མཐའ་རུ་འཛིན་པར་འགྱུར།",
    "ད་ལྟར་མིན་པས་བརྫུན་པར་འགྱུར།",
    "བདག་ཉིད་ཅི་སྟེ་གནོད་པར་བྱེད།",
    "དེའི་ཕྱིར་མཐོང་བ་ཐ་དད་པར།",
    "མི་འགྱུར་ཞེས་ནི་རྣམ་པར་ངེས།",
    "ངོ་ཤེས་པའི་རྟོགས་པ་འདི་ཐ་དད་པ་ལས་ལྡོག་པས་ཐ་མི་དད་པ་ཉིད་ལ་གནས་པར་འགྱུར་རོ།",
    "དེས་ན་ཐ་དད་པ་ལས་ལྡོག་ན་ཐ་མི་དད་པ་ཉིད་སྒྲུབ་པར་བྱེད་དེ།",
    "ཐམས་ཅད་ལས་ལྡོག་པར་ནི་ནུས་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "ཐ་དད་ལ་ཡང་ཁྱབ་པར་ཡོད།",
    "དེ་ཉིད་ཀྱིས་ནི་ཁྱད་པར་སླའི།",
    "ཐ་དད་པ་དང་རིགས་མི་གཅིག་པའི་ཐ་དད་པར་མི་རྟོགས་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་ནི་ཐ་དད་པ་ལ་ཡང་ཐ་མི་དད་པར་རྟོགས་པ་ཡིན་ནོ།",
    "རིག་པ་འབྲེལ་པར་ཇི་ལྟར་འགྱུར།",
    "འབྲེལ་པ་མེད་པར་མཐོང་བ་ནི།",
