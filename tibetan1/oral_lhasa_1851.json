    "སྒྱུར་བྱེད་ལ་བྱས་ཤེས་དྲིན་བཟོའི་བློ་སྐྱེད་སྒྲ་བསྒྱུར་གྱི་རྒྱུད་ལ་བག་ཆགས་འཇོག་པ་ལ་སོགས་པ་ཡིན་ནོ་ཞེས་འཆད་དོ།",
    "འདིས་ཀུན་བཏུས་ཀྱི་དོན་གྱི་ཆ་གཙོ་བོར་བྱས་ཏེ་འཆད་པས་སོ།",
    "དཔལ་གྱི་འབྱུང་གནས་དང་ལུས་ཅན་ཀུན་གྱི་དཔལ་དུ་གྱུར་པས་བསྟེན་པར་འོས་པའི་ཕྱིར་དཔལ་དང་།",
    "ཡ་རབས་དག་ཕལ་ཆེར་བསྟན་བཅོས་རྩོམ་པའི་ཐོག་མར་འདོད་པའི་ལྷ་ལ་ཕྱག་བྱེད་པས་ན་སློབ་དཔོན་འདི་ཡང་བདག་ཉིད་དམ་པ་རྣམས་དང་རྗེས་སུ་མཐུན་པར་བསྟན་པར་བྱ་བ་དང་།",
    "རྒྱ་ཆེ་བ་ནི་བྱང་སེམས་ཀྱི་ཆེ་བའི་བདག་ཉིད་ཀྱི་སྐ་སྟེ་ཁྱད་པརགསུམ་མངའ་བའི་རྒྱལ་སྲས་ལ་ཞེས་བསྟན་ཏེ།",
    "དོན་ཆེན་པོ་ཉམས་པའི་རྒྱུའི་ཉེས་པ་འདི་རྣམས་ནི་དོར་བར་རིགས་སོ་ཞེས་པ་ཡང་ཚིག་ཟུར་གྱིས་བསྟན་པའི་ཕྱིར་སྐྱེ་བོ་ཕལ་ཆེར་ཞེས་སོགས་གསུངས་ཏེ།",
    "རྒྱུ་བཞི་པོ་དེས་ན་རྩོམ་པ་པོ་བདག་ལ་རྣམ་འགྲེལ་ཞེས་པའི་གཞུང་རྩོམ་པར་འདོད་པ་འདི་ནི་གཞན་དག་ལ་ཕན་པ་ཡིན་ཞེས་བསམ་པའང་མེད་དོ།",
    "འདིས་ནི་སློབ་དཔོན་ཚོགས་གཉིས་བསགས་པར་བསྟན་ཏེ།",
    "ཕལ་ལ་ཆགས་པ་ལ་སོགས་པའི་རྒྱུ་དེས་ན་ཀུན་ལས་བཏུས་འདི་ནི་དོན་ཆེན་པོ་ཡིན་ཡང་གཞན་མང་པོ་རྣམས་ལ་མཆོག་ཏུ་ཕན་པ་མིན་པ་སྟེ་ཕན་པ་མཆོག་དམ་པར་མི་འགྱུར་ལ།",
    "ཕན་པ་མེད་པ་དེའི་ཕྱིར་བདག་ནི་ཀུན་ལས་བཏུས་འདི་ཤིན་ཏུ་འབྲས་བུ་དང་བཅས་པར་བྱ་སྙམ་པ་ལ་སོགས་པའི་རྣམ་པ་ཅན་གྱི་སེམས་པའང་རྣམ་འགྲེལ་དུ་རྩོམ་པའི་རྒྱུ་ཡིན་ནོ།",
    "ཐོག་མར་དགོས་པ་བརྗོད་པར་བྱ།",
    "བསྙོན་ཚིག་ལྟར་བརྗོད་བྱས་སྟོང་པ་དང་།",
    "ཤཱཀྱ་བློ་ཡང་བླང་དོར་བཏང་སྙོམས་སུ་བྱ་བའི་དོན་གསུམ་ཡོད་པར་བཞེད་ལ།",
    "འོན་ཏེ་ཉིང་དགོས་དགོས་པར་མི་འཐད་དོ་ཞེ་ན།",
    "བྱ་བའི་ངོ་བོ་དེ་བརྗོད་བྱ་མེད་པར་དོགས་པ་བཟློག་པའི་དོན་དུ་བཀོད་དོ་ཞེ་ན་མ་ཡིན་ཏེ་བརྗོད་བྱ་བསྟན་པས་བཟློག་པའི་ཕྱིར་རོ།",
    "བརྗོད་བྱའི་ཁྱད་པར་བསྟན་པའི་དོན་དུ་སྨོས་པའང་མིན་ཏེ།",
    "ཁྱད་པར་བསྟན་པ་ཉིད་ཀྱིས་དེ་བསྟན་པའི་ཕྱིར་རོ།",
    "ཀ་མ་ལ་ཤཱི་ལས་ཉིང་དགོས་དགོས་པར་བསྡུས་ནས་གསུམ་དུ་ཡང་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་པས་མི་མཐུན་ཕྱོགས་ལས་ལྡོག་པར་བསྟན་ལ།",
    "དེར་བཏགས་པ་ལ་དགོས་པ་མེད་པས་གདགས་པར་མི་བྱའོ་ཞེ་ན།",
    "དེས་དེ་ལྟར་གྲུབ་བཞིན་དུ་ཡང་བསྣན་པའི་ཕྱིར་ཡང་སྨོས་པར་དོགས་པར་འགྱུར་ཏེ།",
    "ཕལ་པ་དང་གཙོ་བོ་ཉེ་ན་གཙོ་བོ་བྱས་པ་ཡིན་པར་ཤེས་པའི་ཤུགས་དང་།",
    "བ་ཡིན་ན་ཕྱོགས་ཉིད་ཀྱིས་ཁྱད་པར་དུ་བྱས་པས་དཔེ་ལ་རྗེས་འགྲོ་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "མ་ཡིན་ཏེ་མི་ལྡན་རྣམ་གཅོད་ཙམ་གྱི་ཁྱད་པར་དུ་བྱས་པའི་ཕྱིར་རོ་ཞེས་ལེའུ་བཞི་པར་སྟོན་ཏོ།",
    "དུ་བ་དེ་མེའི་བསྐྱེད་བྱ་ཡིན་པས་མེ་གོ་བྱེད་ཡིན་ན་མེའི་ཁྱད་པར་གསལ་ཞིང་འབར་བའི་ཡང་གོ་བྱེད་དུ་འགྱུར་རོ་ཞེ་ན།",
    "མེའི་ཁྱད་པར་ཉེ་བའི་ཕྱིར་ཞེས་པ་ལྟ་བུའོ།",
    "དེ་དག་ལ་ལྟོས་ནས་ཚུལ་གསུམ་ངེས་པར་འགྱུར་བའི་ཕྱིར།",
    "དེ་ལས་ཕ་རོལ་གཏན་ཚིགས་ཏེ་རྒྱའི་ཁྱད་པར་ཅན་ཆགས་ཅན་དུ་ཤེས་པར་བྱེད་མི་ནུས་ཏེ།",
    "མ་མཐོང་ཙམ་གྲུབ་ཀྱང་ཡོད་པར་མི་འགལ་བས་ལྡོག་པ་འཁྲུལ་པ་སྲིད་པ་ཅན་ཉིད་ཀྱི་ཕྱིར།",
    "དཔེར་ན་འབྲས་མང་པོ་ཞིག་ཚོས་པར་མཐོང་ནས་ཕྲུ་བའི་འབྲས་ནི་ཚོས་པ་ཡིན་ཏེ།",
    "དང་པོ་ལ་གཉིས་ཀྱི་དང་པོ་སློབ་དཔོན་རྟགས་ལ་འབྲེལ་པ་བཞེད་པར་བསྟན་པ་ནི།",
    "གཏན་ཚིགས་ཀྱི་ནི་ཚུལ་གསུམ་ལའང་ལྟར་སྣང་གསུམ་གྱི་གཉེན་པོར་ངེས་པར་དགོས་སོ་ཞེས་ངེས་པ་བརྗོད་པར་མཛད་པའི་ཕྱིར་ཏེ།",
    "འོན་ཏེ་མ་མཐོང་ཙམ་གྱིས་ལྡོག་པ་གྲུབ་པར་སློབ་དཔོན་བཞེད་དོ་ཞེ་ན།",
    "གཉིས་པ་ལྷག་ལྡན་འཁྲུལ་པ་མེད་པར་འགྱུར་བ་ནི།",
    "གཟུགས་མཚུངས་པས་རོ་ལ་སོགས་པ་གདོན་མི་ཟ་བར་མཚུངས་པར་འགྱུར་བ་ནི་མིན་ནོ་ཞེས་སོ།",
    "དེ་བཞིན་དུ་མཐུན་ཕྱོགས་ལ་ཡོད་པ་དང་མེད་པ་ལ་སོགས་པ་ལ་ཡང་ཅི་རིགས་པར་བརྗོད་པར་བྱའོ་ཞེས་རྗེས་འགྲོ་ལ་མ་གྲུབ་པ་བཞི་དང་།",
    "སྒྲ་ལ་རྟག་མི་རྟག་རྣམ་པར་གཅོད་ནུས་པའི་གཏན་ཚིགས་སུ་འགྱུར།",
    "གལ་ཏེ་མ་མཐོང་བ་ཙམ་གྱིས་མ་མཐོང་བ་དག་ལ་འགོག་པར་བྱེད་ན་དེ་ཡང་རིགས་པ་མིན་ནོ་ཞེས་སོ།",
    "རོ་ནུས་སྨིན་པ་ཁྱད་པར་ཅན་ཡིན་ཏེ།",
    "མ་དམིགས་པ་ཙམ་མེད་པར་རབ་ཏུ་སྒྲུབ་བྱེད་མིན་པའི་ཕྱིར་ཞེས་ཟེར་བཞིན་དུ་ཡང་།",
    "རྒྱང་ཕན་པས་སྨྲ་བས་ཀུན་མཁྱེན་མིན་པ་དང་།",
    "གྲངས་ཅན་པས་འདུས་བསགས་ཀྱིས་གཞན་དོན་བྱེད་པར་སྒྲུབ་པའི་རྟགས་མི་མཐུན་ཕྱོགས་ལ་མ་མཐོང་བས་མེད་པར་གྲུབ་པར་སྨྲ་བ་ཁས་བླངས་འགལ་བར་སྟོན་པ་ནི།",
    "བྱས་པ་ཡོད་ཙམ་གྱིས་དེ་ལ་འབྲེལ་བའི་ཕྱིར་ཞེས་པའི་རྟགས་ཀྱིས་བདག་གཅིག་ཏུ་དང་།",
    "དཔེ་ཚང་བང་ལ་མེ་ནི་དུ་བའི་རྒྱུ་ཡིན་ཏེ་དུ་བའི་ཕན་བྱེད་གང་དུ་བའི་རྗེས་སུ་བྱས་པར་གྲུབ་པའི་ཕྱིར་ཞེས་པས་མེ་དུ་རྒྱུ་འབྲས་ཀྱི་དངོས་པོར་སྟོན་ཏེ།",
    "དཔེས་འབྲེལ་པ་སྟོན་པ་དེ་ཉིད་ཀྱི་ཕྱིར་སྒྲུབ་རྟགས་གཉིས་ཀྱི་འབྲེལ་པ་ཤེས་ཤིང་དྲན་ན་ངག་གཉིས་ལས་གང་ཡང་རུང་བས་དཔེ་གང་རུང་ལ་རྗེས་སུ་འགྲོ་ལྡོག་གང་རུང་དངོས་སུ་སྨྲས་པས་གང་རུང་དོན་གྱིས་གོ་བས་ཅིག་ཤོས་དངོས་སུ་མ་སྨྲས་པ་ལ་དྲན་པ་ཡང་དག་པར་སྐྱེ་བར་འགྱུར་ཏེ།",
    "དེ་བྱས་པའི་རྒྱུ་འབྲས་གང་ཡིན་གྲང་།",
    "བྱས་པའི་འབྲས་བུ་ཡིན་ན་དེའི་ཕྱིར་རོ།",
    "མེ་དུ་མི་འཁྲུལ་བར་མི་རྟོགས་པར་མི་འགྱུར་ཏེ།",
    "ཡོད་མེད་ཀྱི་རྗེས་སུ་འཇུག་ལྡོག་བྱེད་པར་མངོན་སུམ་དང་མ་དམིགས་པའི་ཚདམ་ཁྱད་པར་ཅན་གྱིས་གྲུབ་པའི་ཕྱིར་རོ།",
    "དུ་བ་དེ་མེ་དེ་མེད་པར་ནི་ཡོད་པའི་ཕྱིར་ཞེ་ན།",
    "རང་རྒྱུ་དང་མི་ལྡན་པར་འགྱུར་ལ།",
    "རང་བཞིན་ལ་འབྲེལ་བ་གྲུབ་པར་བསྟན།",
    "མི་རྟག་པ་མེད་ན་མེད་པར་འགྱུར་ཏེ།"
  ]
}