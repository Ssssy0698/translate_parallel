    "དེར་བོད་ཀྱི་སྒྱུ་རྩལ་ཐོན་རྫས་རྩེ་གྲས་དག་བཞག་ཡོད་པ་རེད།",
    "སྐྱབས་བཅོལ་བ་ཚོ་ནི་དེ་ལ་འགྲོ་ཐུབ་ཅིང་སྔོན་ཆད་རང་གི་ཡིན་པའི་ཅ་ལག་དེ་ཚོ་ལ་བསྐྱར་ལྟ་བྱེད་ཐུབ་ཀྱི་ཡོད་པ་རེད།",
    "བཙན་རྒོལ་ནི་མཇུག་སྒྲིལ་བ་རེད།",
    "ཨེམ་ཆི་བློ་བཟང་བསྟན་འཛིན་ནི་༡༩༥༦ལོར་ཁམས་སུ་སྐྱེས་པ་རེད།",
    "ས་གནས་མི་མང་གིས་བློ་བཟང་ལ་གུས་ཞབས་བྱེད་པ་རྒྱ་མིས་ཤེས་རྗེས།",
    "བྱས་ཙང་ང་ཚོ་ལ་མ་འོངས་ལུང་བསྟན་ཤོད།",
    "ཅེས་སྡིགས་གཤེ་བྱས་པ་རེད།",
    "ངས་ང་རང་ནི་བྱིས་པ་སྡུག་ཅག་ཅིག་ཡིན་པའི་ཡིད་ཆེས་བྱས་ཏེ་འཚར་ལོངས་བྱུང་བ་རེད།",
    "ཁོང་ཚོས་རོགས་པ་བྱེད་ཐབས་མེད་པ་ཞིག་ཅིའི་ཕྱིར་ཡིན་པ་ངས་ཤེས་ཐུབ་མ་སོང་།",
    "ང་ལོ་རྒན་པ་ཚོ་ལ་ཡིབ་བཞིན་ངའི་བྱིས་པའི་ལོ་དུས་དེ་ཚོ་བསྐྱལ་བ་རེད།",
    "བློ་བཟང་གིས་དེ་ལ་ཡིད་ཆེས་བྱེད་དཀའ་བ་ཞིག་བྱུང་ཡོད་རང་ཤི་རྒྱག་པ་ནི་ཁམས་པའི་གྱེན་རྒོལ་གྱི་ནང་དུ་རྒྱུན་དུ་ནས་ཡོད་པ་ཞིག་ཏུ་མཐོང་བ་རེད།",
    "ཡིན་ན་ཡང་ད་དུང་ཡང་མི་མང་གི་དགྲ་བོ་ཡིན་པར་བརྩིས་པ་རེད།",
    "ཁོང་ཚོ་གྲོང་གི་དཀྱིལ་དུ་དྲུད་ནས་ཡོང་སྟེ་ཞྭ་མོ་ནག་པོ་གཡོགས་པ་རེད།",
    "བཙན་ཤེད་ཀྱིས་ཞྭ་ནག་རྩེ་རྣོན་དེ་ཚོ་རྒྱུན་དུ་གོན་བཅུག་པ་རེད།",
    "འཇིགས་སྣང་ཅན་གྱི་འཐབ་འཛིང་དེ་སྐབས་རེར་ཡོང་གི་ཡོད་པ་དེ་ད་ནི་ངར་ཤུགས་གསར་པ་ཞིག་དང་བཅས་རྒྱུན་ལྡན་གྱི་འཇིགས་དངངས་ཤིག་ཏུ་གྱུར།",
    "ངས་བྱེད་ཐུབ་པ་ཡག་ཤོས་དེ་ནི་ང་རང་དམར་སྲུང་དམག་ལས་ཐག་རིང་དུ་སྡོད་རྒྱུ་དེ་རེད།",
    "དམར་སྲུང་དམག་གིས་དོན་གསར་པ་ཞིག་ངོ་སྤྲོད་བྱས་སོང་བ་དེས་ང་ཚོ་ཚང་མ་དངོས་གནས་ཧོན་འཐོར་བཅུག་པ་རེད།",
    "ད་ནི་ང་ཚོ་བོད་མི་ཚོས་ས་གནས་ཀྱི་རྒྱ་དམར་གྱི་མགོ་གཙོ་ཚོ་ལ་སྐྱོན་བརྗོད་བྱེད་རྒྱུར་གཏིང་སྐུལ་བྱས་བྱུང་།",
    "མའོ་ཡིས་ཁོ་ལ་ཤ་ཞེན་ངོ་མ་ཡོད་པ་དང་མེད་པ་སུ་ཡིན་བལྟ་འདོད་པ་རེད།",
    "གནས་སྟངས་ཤིག་ཏུ་དམར་སྲུང་དམག་གི་ལས་འགུལ་དེ་ཚོས་རྒྱ་མི་རྣམས་ལ་སླར་ཕོག་པ་རེད།",
    "ང་ཚོས་རྒྱ་མིས་རྒྱ་མི་ལ་སྐྱོན་བརྗོད་བྱེད་པ་དེ་གོ་དུས་ང་ཚོས་ཀྱང་དམག་ཤོག་གི་མགོ་གཙོ་ཚོ་ལ་སྐྱོན་བརྗོད་བྱེད་པ་ལ་ཞུགས་རྒྱུར་བློ་སྤོབས་འཕར་བྱུང་།",
    "༡༩༦༦ ལོར་བཙན་རྒོལ་གྱི་རླབས་གསར་པ་ཞིག་འཁྱེར་ཡོང་མཁན་དེ་དམར་སྲུང་དམག་རེད།",
    "ཁམས་པ་ཚོ་ས་གནས་ཀྱི་རྒྱའི་དམག་སྒར་ནང་ལ་བླུགས་པ་རེད།",
    "རྒྱ་དམག་ཚང་མ་བསད་དེ་དེ་ཚོའི་མེ་མདའ་དང་མདེལ་རྫས་འཁྱེར་ཏེ་བྲོས་པ་རེད།",
    "འདི་ལ་སྔོན་ཆད་ཀྱི་ཆུ་བཞི་སྒང་དྲུག་གི་སྒྲིག་འཛུགས་དེ་ཡོད་མ་རེད།",
    "ཡིན་ན་ཡང་འགོག་རྒོལ་གྱི་ལས་ཀ་རྒྱ་ཆེ་བ་མཉམ་འབྲེལ་གྱིས་སྤེལ་བའི་དུས་ཚོད་དང་གནས་འཕྲིན་གྱི་འབྲེལ་ལམ་གཉིས་ཀ་ཡོད་མ་རེད།",
    "གྱེན་རྒོལ་དེ་གདུག་རྩུབ་ཆེན་པོས་བཙན་གནོན་བྱས་པ་རེད།",
    "ཁྱེད་རང་གི་སྤུན་གང་དུ་ཡོད།",
    "ཁྱེད་རང་གི་བུ་གང་དུ་ཡོད།",
    "ཁྱེད་རང་གི་ཨ་ཞང་གང་དུ་ཡོད།",
    "དེ་འདྲའི་དྲི་བ་དྲིས་པ་རེད།",
    "ཁོ་ཚོ་བཙན་རྒོལ་པ་ཚོའི་སྤུན་མཆེད་ཚོའི་ལག་པ་ལ་ལྕགས་བརྒྱབ་ནས་བརྡུངས་ཤིང་གྲོང་གི་དཀྱིལ་དུ་དྲུད་ནས་མི་གཏའ་མའི་ཚུལ་དུ་བེད་སྤྱོད་བྱས་པ་རེད།",
    "དེའི་རྗེས་དེར་བཙན་རྒོལ་པ་མང་ཆེ་བས་རང་ཉིད་རྩིས་སྤྲོད་བྱས་པ་རེད།",
    "ཡིན་ན་ཡང་རྒྱ་མི་རྣམས་ནི་ད་དུང་ཡང་ཡིད་ཚིམ་མ་སོང་།",
    "ཞྭ་མོ་ནག་པོ་ཁོང་ངའི་ཕ་དང་ལྷན་དུ་བཙོན་འཇུག་བྱས་མྱོང་ཡོད་པ་རེད།",
    "རྒྱ་མིས་ཁོང་འཛིན་འདོད་ཆེན་པོ་བྱས་པ་རེད།",
    "ཁོང་གི་ཆུང་མ་དང་བུ་བཞི་དེ་ཁོང་དང་ལྷན་དུ་ཡོད་པ་རེད།",
    "བྱས་ཙང་རྒྱ་མིས་འདི་ལྟར་བྱས་པ་རེད།",
    "ཁོང་ཚོ་མཉམ་དུ་ཧ་ལམ་ཕན་ཚུན་ལ་གདོང་བསྟན་ནས་ཐུག་གྲབས་ཡོད་པ་ཙམ་དུ་གནམ་འདོགས་བྱས་པ་རེད།",
    "ཁོང་ཚོའི་རྐང་པའི་འོག་ཏུ་མེ་བཏང་བ་རེད།",
    "གྲོགས་པོ་དེ་གཉིས་ཀྱིས་ན་ཟུག་གིས་སྐད་བརྒྱབ་ཅིང་ངུས་པ་རེད།",
    "ངས་ཁོང་ཚོའི་ཁྲག་དེ་མེའི་ནང་དུ་ཐིགས་པ་རྒྱག་གི་ཡོད་པ་མཐོང་བྱུང་།",
    "དྲི་མ་བཙོག་པ་ཞེད་པོ་ཞིག་འདུག་དུ་བ་ཡར་ཡོང་བ་དེས་ཁོང་ཚོའི་དབུགས་འགག་བཅུག་པ་རེད།",
    "ཁོང་ཚོ་ན་ཟུག་གིས་དྲན་པ་འཐོར་པ་ཡིན་ན།",
    "རྒྱ་མིས་ཁོང་གཉིས་དྲན་པ་མ་སོས་ཀྱི་བར་དུ་མར་ས་ཐོག་ལ་བཞག་པ་རེད།",
    "དེ་ནས་ཁོ་ཚོས་ཁོང་གཉིས་སླར་ཡང་ཡར་བཏགས་པ་རེད།",
    "སང་ཞོགས་དེར་རྒྱ་མིས་ཁོང་ཚོ་གཉིས་རྟ་ཐོག་ལ་བཀྱིགས་པ་རེད།",
    "བཙན་རྒོལ་པ་ཚོས་ཚུར་རང་གི་ཐུབ་ཚོད་ཀྱིས་མེ་མདའ་འཕངས་ནའང་གང་མྱུར་ཁོང་ཚོས་གླགས་མི་རྙེད་པ་ཞིག་ཆགས་པ་རེད།",
    "མཐའ་མཇུག་ཏུ་ཚེ་སྲོག་མ་ཤོར་པའི་མི་བཞི་ཡོད་པ་དེས་རང་གི་མཚོན་ཆ་རྣམས་མར་གཡུགས་ནས་ལག་པ་ཡར་བཀྱགས་ཏེ་ཚུར་ཐོན་ཡོང་བ་རེད།",
    "རྒྱ་དམག་གིས་ཁོང་ཚོ་ཐག་ཉེ་བའི་གཡང་ས་བར་དུ་འཁྲིད་ནས་གཡང་ཁ་ནས་མར་འཕངས་པ་རེད།",
    "དེ་ནི་ཧ་ཅང་ཡིད་མུག་པ་ཞིག་རེད།",
    "དེ་ནས་འདི་ཚོ་དེ་ལས་ཀྱང་ཡིད་མུག་པ་ཞིག་ཆགས་སོང་།",
    "ང་ཚོས་ཕུང་པོ་ལ་ཁོང་གིས་མི་མང་ལ་སྡུག་ཅག་བྱས་པ་དེ་ཚོ་ལ་འགྱོད་པ་སྐྱེས་སམ་ཞེས་འདྲི་དགོས་བྱུང་ཞིང་།",
    "ཕུང་པོས་ལན་མ་བརྒྱབ་པའི་དུས་དེར་ང་ཚོས།",
    "ཁྱེད་རང་གླེན་པ་ག་འདྲ་ཞིག་རེད་ཨང་།",
    "ཐ་ན་ཁྱེད་རང་གིས་རང་གི་ནག་ཉེས་ཀྱང་ངོས་ལེན་བྱེད་ཀྱི་མི་འདུག་ད་ཁྱེད་རང་སྐྱིད་པོ་འདུག་གས།",
    "དེ་ཙམ་གྱིས་ཀྱང་ཚར་མ་སོང་།",
    "ད་ནི་འགོག་མེད་ཀྱི་འཐབ་འཛིང་དེ་ཚོའི་རྗེས་ལ་དམར་གསོད་བྱེད་པ་དེ་སླེབས་ཡོང་བ་རེད།",
    "བློ་བཟང་གིས་ཚོད་རྩིས་བྱས་པ་ལྟར་ན།",
    "འདི་ནི་ཁོ་ཚོའི་བྱེད་སྟངས་དེ་རེད།",
    "རྒྱ་མི་གཉིས་ཀྱིས་བོད་མི་དེའི་ལག་པ་གཡས་གཡོན་ནས་འཛིན་གི་རེད།",
    "གསོད་མཁན་དེ་རེད།",
    "ཕོ་མོ་སུ་ཡིན་ཡང་ཧ་ལམ་དྲན་པ་འཐོར་ཡོད་པ་རེད།",
    "ཁོང་ཚོ་ལ་ལག་མདའ་ཡིས་རྡུང་རྡེག་ཚ་ནན་བཏང་ཡོད་པ་རེད།",
    "ཁོང་ཚོ་ཁ་ཕར་ལོག་བཅུག་ནས་མགོ་ལྟག་རྒྱབ་དེར་མེ་མདའ་བརྒྱབ་པ་རེད།",
    "རྒྱ་མི་ཚོས་དམར་གསོད་གཏོང་བ་དེ་ལ་རྩ་ནས་མི་ལྟ་བ་དེ་ངས་དྲན་གྱི་འདུག་ཁོ་ཚོས་ང་ཚོ་ལ་ལྟ་གི་འདུགཁོ་ཚོས་ཁྱིམ་མི་དང་སྤུན་མཆེད་ཚོའི་རྣམ་འགྱུར་ལ་བལྟས་ནས་ཚིམ་གྱི་ཡོད་པ་འདྲ།",
    "འདི་ནི་དངོས་གནས་སྡིག་སྤྱོད་ལས་དགའ་བ་ལེན་པ་ཞིག་རེད།",
    "རྒྱ་མི་ཚོ་ལ་ནི་མི་མང་གི་དགྲ་བོརྫོགས་པ་འདྲ།",
    "མཚམས་འདི་ལ་བློ་བཟང་ལྟ་བུ་མ་ཤི་གསོན་པོར་གནས་པ་ཚོས་འཛམ་གླིང་ཕྱི་ལོགས་ལ་ག་རེ་ཡོང་གི་ཡོད་པ་ཅི་ཡང་ཤེས་ཀྱི་མེད།",
    "ང་ཚོས་ཨ་མི་རི་ཀ་བ་ཚོ་ལ་རེ་བ་བརྒྱབ་པ་རེད།",
    "ཨ་མི་རི་ཀ་བ་ཚོས་ཉིན་མ་གཅིག་ང་ཚོ་སྐྱོབ་ཀྱི་རེད་བསམས་པའི་སྤྱིར་བཏང་གི་ཡིད་ཆེས་དུས་རྒྱུན་ནས་ཡོད་ཡོད་རེད།",
    "ང་ཚོས་ཁོང་ཚོ་ཡོང་མིན་གྱི་ཐད་ལ་བློ་དྭོགས་རྩ་ནས་མ་བྱས་པ་རེད།",
    "ཡིན་ན་ཡང་དཀའ་ངལ་བྱེ་བྲག་པ་གང་ཞིག་ལ་བརྟེན་ནས་ཁོང་ཚོ་ང་ཚོ་སྐྱོབ་རྒྱུ་ལས་གཡོལ་དགོས་པ་བྱུང་བ་དེ་ལ་ང་ཚོ་ཡ་མཚན་སྐྱེས་ཡོད།",
    "རེ་བ་འདི་ཅི་ཙམ་གྱིས་ཁྱབ་ཆེན་པོ་ཡོད་པ་དེ་ཁྱེད་ལ་ཞུ་རྒྱུ་ལ།",
    "ཁྱེད་རང་གི་ཨ་མི་རི་ཀ་བ་ཚོ་གང་དུ་ཡོད།",
    "ཅེས་པ་འདི་རེད།",
    "གཅིག་བྱས་ན་ང་ཚོ་ཨ་མི་རི་ཀ་བ་ཚོར་ཧ་ཅང་དགའ་བ་དེ་ནི་རྒྱ་མི་རྣམས་དེ་ཚོར་ཧ་ཅང་མི་དགའ་བའི་རྐྱེན་གྱིས་ཡིན་པ་རེད།",
    "ག་རེ་ཡིན་ན།",
    "གཅིག་བྱས་ན་ང་ཚོས་ཁོང་ཚོའི་སྐོར་མི་ཤེས་པ་ཇི་བཞིན་ཁོང་ཚོས་ང་ཚོའི་སྐོར་མ་ཤེས་པ་རེད།",
    "༡༩༧༩ ལོར་བློ་བཟང་གི་ཁྱིམ་མི་རྣམས་ལྷ་ས་ལ་སྤོར་པ་རེད།",
    "བློ་བཟང་ལོ་ཉི་ཤུ་རྩ་གསུམ་རེད།",
    "བློ་བཟང་ལ་མཚོན་ན་དུས་ཡུན་རིང་མོ་ཞིག་གི་རྗེས་སུ་ཁོང་གི་མི་ཚེའི་རིང་གི་མནར་གཅོད་ཆེ་ཤོས་ཀྱི་བྱ་བ་རྣམས་རྒྱབ་ཏུ་བཞག་ཟིན་པ་དང་།",
    "ལྷ་ས་ནས་འགོག་རྒོལ་གྱི་རླབས་གསར་པ་ཞིག་ཐོན་ཡོང་པ་རེད།",
    "གྱེན་ལོག་གི་ཚིག་འབྲུ་གཉིས་ཏེ།",
    "ཅེས་སྐད་བརྒྱབ་པ་རེད།",
    "དམིགས་བསལ་གྱིས་ངའི་ལོ་ཚོད་ཀྱི་བོད་མི་ཚོས་དེ་ལྟར་བྱས་པ་རེད།",
    "དེ་འདྲའི་བློ་སྤོབས་ཆེན་པོ་ཞིག་ང་ཚོའི་བསམ་ཡུལ་ལ་རྩ་ནས་སླེབས་མེད་པ་རེད།",
    "རྒྱ་མི་ཚོ་ཡང་ང་ཚོ་ནང་བཞིན་ཧོན་འཐོར་ཡོད་པ་རེད་བསམས་བྱུང་།",
    "རྒྱ་མི་ཁོ་ཚོ་ནི་དེ་འདྲའི་རྔམ་སྟོན་ཞིག་ལ་གྲ་སྒྲིག་གང་ཡང་མེད་པ་རེད།",
    "རྒྱ་མི་ཚོས་ང་ཚོ་ཅི་གང་ཡང་བྱས་མ་སོང་།",
    "དགོང་མོ་སླེབས་དུས་ང་ཚོ་ཚང་མ་ནང་ལ་ལོག་ཅིང་ཧ་ཅང་དགའ་ཞིང་སྤྲོ་ལ།",
    "རྒྱ་མིས་ང་ཚོ་ལ་ཅི་ཞིག་བྱེད་རྒྱུ་ཡིན་པ་ང་ཚོས་ཤེས་ཀྱི་མེད།",
    "གནས་ཚུལ་ཅི་ཞིག་བྱུང་བ་དེའི་སྐོར་ལ་བསམ་བློ་གཏོང་རྒྱུ་ལ་ཉིན་མ་ལྔ་བྱུང་ཡོད་པ་རེད།",
    "མངོན་སུམ་དུ་ཐོན་ནས་ངོ་རྒོལ་བྱེད་པ་ནི་དེ་འདྲའི་རླབས་ཆེ་བའི་བྱ་བ་གསར་པ་ཞིག་རེད།",
    "ངའི་བསམ་ཚུལ་ལ་ང་ཚོ་ཚང་མའི་སེམས་ཀྱི་ནང་ད་ནི་ང་ཚོ་རང་གི་སེམས་སུ་རྒྱ་མི་ལ་ག་རེ་བསམས་ཀྱི་ཡོད་མེད་ངོ་མ་དེ་ཤེས་འཇུག་པའི་དུས་ཚོད་རེད་ལ།",
    "ངོ་མ་གཅིག་བྱས་ན་ཁོང་ཚོ་ལོག་སྲིད་པ་རེད་བསམས་ཡོད་པ་རེད།",
