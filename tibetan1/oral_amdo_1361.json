    "དེ་ནི་བོད་གང་དུ་ཡོད་ས་དེ་རེད།",
    "གལ་སྲིད་ཁྱེད་རང་གིས་དེང་སང་གི་ཨེ་ཤ་ཡའི་ས་བཀྲ་ཞིག་ལ་བལྟས་ན།",
    "ཁྱེད་ཀྱིས་ཉ་ཡི་རི་མོ་དེ་ངོ་མ་ཡིན་པ་མཐོང་ཐུབ།",
    "འདི་ཚོ་ཚང་མ་རྒྱ་ནག་གི་སྐམ་སའི་གྲོད་པའི་ནང་ཡལ་བ་རེད།",
    "ལོ་ན་རྒས་པའི་དཔའ་བོ་མང་ཆེ་བ་ཁོང་ཚོའི་བུ་རྒྱུད་ཕར་གཡུགས་ཡོད་པ་རེད།",
    "ཡང་བསྐྱར་རྒྱ་མིའི་བགོ་བཤའ་དང་རྒྱལ་ཁ་ཡི་ངན་ཇུས་དེས་ཁོང་ཚོར་ཕན་ཡོད་པ་རེད།",
    "ས་གནས་ཀྱི་མི་འབོར་རྣམས་རང་གི་ལུང་པའི་ནང་གྲངས་ཉུང་མི་རིགས་བཟོས་པ་རེད།",
    "ཕ་མ་ཚོས་རང་གི་བྱིས་པ་ཚོར་རང་གི་ལུང་པའི་གོམས་གཤིས་རྣམས་བརྒྱུད་སྤྲོད་བྱེད་དམ།",
    "བོད་ནང་དུ་ལྟ་སྐོར་བ་འཁྱེར་ཡོང་བ་ནི་ཀྲུང་དབྱང་གཞུང་ལ་སྒོར་མོའི་ཡོང་འབབ་ཆེ་ཤོས་ཤིག་རེད།",
    "དེ་ནི་ཡོང་འབབ་བཟོ་བྱེད་ཆེན་པོ་ཞིག་རེད།",
    "རྒྱ་མིས་ཐ་ན་ཐབས་ཇུས་ལྡན་པའི་ཐོག་ནས་ཇོ་ཁང་གི་རྩེ་ཐོག་ཏུ་འཐུང་ཆུ་མངར་མོའི་འཁྱག་སྒམ་བཞག་ཡོད་པ་རེད།",
    "བྱས་ཙང་ལྟ་སྐོར་བ་ཚོས་གཟིགས་མོ་མཛད་ཞོར་དུ་ཀོ་ཁ་ཀོ་ལ་འཐུང་ཐུབ་གི་རེད།",
    "མཐོང་ཡུལ་དེ་ནི་དེང་རབས་ཅན་ཞིག་དང་སྤྱིར་བཏང་གིས་ཡིད་དུ་མི་འོང་བའི་རྒྱ་ཁང་གིས་ཁྱབ་ཡོད་པ་དེར་དུད་སྤྲིན་དང་ཆང་ཁང་།",
    "གཞང་ཁང་བཅས་ཀྱིས་ཁེངས་ཡོད་པ་རེད།",
    "དམིགས་བསལ་གྱིས་ནུབ་ཕྱོགས་པའི་བཟོ་ཚོང་གི་བདག་པོ་ཚོས་མི་འབོར་དུང་ཕྱུར་མང་པོའི་རྒྱ་མིའི་ཉོ་མཁན་གྱི་སྟོབས་ཤུགས་ལ་རྔམས་ནས་སྒོར་མོ་བཟོ་སྲིད་པ་ལྟར་དུ་རྒྱ་ནག་ཏུ་མ་རྩ་ཁྱོན་ཆེ་འཛུགས་བཞིན་ཡོད་ན་གོང་ལྟར་མི་ཡོང་བ་རེད།"
  ]
}