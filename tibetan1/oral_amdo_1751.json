    "གྲུ་མོ་ལ་གཞུ་མཆོག་གིས་ཡར་འཁྱུད་པས་ཕྱིར་དོན་ས་མེད་དོ།",
    "དེ་གཉིས་ཀ་ལ་ཕུང་བུ་དང་ལག་ངར་ནས་འཐེན་ལ་ཚིགས་ཁ་བྲལ་བ་དང་རུས་མགོ་ནས་མཐེབ་མོས་མནན་ལ་ལག་མགོ་དཔུང་བ་ལ་སྦྱར་རོ།",
    "པུས་མོ་སླ་ངས་བཀབ་པས་སྟེང་དུ་འཆོར་ས་མེད།",
    "སྒྱིད་ཁུང་ནས་རུས་མགོ་མཐེབ་མོས་མནན་ལ།",
    "ཡན་ལག་གི་སྐབས་སུ།",
    "རུས་མགོ་དང་མཐུན་པ་རེ་རེ་གཏང་།",
    "ཁྲུག་སྐྱུགས་སམ་རེ་བམ་གཏང་།",
    "བཅིང་ཐབས་ནི་འཇག་གི་སྣ་ནས་དམ་དུ་སྒྲིལ་ལ་གྲིལ་བའི་ཕྱི་ནས་རང་འགྲོས་སུ་བཅིངས་ཏེ།",
    "ཆིངས་དེབ་ནི་གཙུག་ཏུ་སྒོར་མོ་གཅིག་ཕྱོགས་བཞིར་རྨོག་གི་རྣམ་པ་འདྲ་ལ་དྲས་མིག་གསུམ་བཏོད་ལ།",
    "དེ་གསུམ་གང་བྱེད་ཀྱང་ངོས་ཅིག་ཐག་གུ་གསུམ་སྒྲིལ་ཕྲ་མོ་བྱས་ལ།",
    "འཇག་གི་སྣ་ཐག་གུ་ངོས་ནས་མགོ་ལ་ཁོར་གཅིག་བསྐོར་ལ་ལྟག་པར་བསྣོལ་ལ།",
    "སྤྱི་གཙུག་དང་ལྟག་པ་དཔྲལ་དཀྱིལ་རྣ་ལྟག་གཉིས་ལྔ་བོ་དེའི་རྒྱ་གྲམ་དེ་ལྕགས་ཀྱི་ཡང་མིག་ནས་བཏོན་ལ་གཅུས་ཕུར་གཉིས་གཉིས་བསྣོལ་ལ་བསྡམ་མོ།",
    "སྲུབས་སྟེང་གི་རྒྱ་གྲམ་གཉིས་ལ་ཡང་ཕུར་བ་བསྡམ་མོ།",
    "ད་ཅིའི་སྔར་གྱི་རྒྱ་གྲམ་ལྔ་བོ་ལ་ཤིང་བུ་མཛུབ་མོ་ཙམ་ལྔ་བཅུག་ལ།",
    "སྲད་བུ་གཅིག་གིས་དང་བོ་སྤྱི་གཙུག་ཏུ་བསྐོར།",
    "དེའི་ཁར་ཤིང་བུ་མི་འགྲོལ་བའི་སྲད་བུས་དཀྲིས་དང་རྒྱ་བསྡམ་མོ།",
    "བྱང་ཁོག་གི་བསེ་ཁྲབ་ཆིངས་བྱ་བ་ལ།",
    "དཔུང་བ་གཉིས་ལ་ཐག་གུ་རེ་བསྐོན་ལ།",
    "དེ་རྣམས་ལ་འཇག་གི་དྲ་མིག་ཏུ་བླངས་ལ་བཅིང་ངོ་ཨི།",
    "དཔུང་བ་ལ་སྟག་མོ་འཛུམ་ཆིངས་དང་སུམ་སྒྲོག་ཆིངས་གཉིས།",
    "གྲེ་མོ་ལ་ལྟས་ཆིངས་སྣོལ་ཆིངས་པ་ཏྲ་མ་གཉིས།",
    "མཁྲིག་མ་ལ་རེ་ལྡེ་ཆིངས།",
    "གྲེ་མོའི་གོང་ནས་བཅིངས་ནས་གཅིག་ངོས་ཀྱི་མཆན་འོག་ཏུ་འགྱེན་ཤིང་བཅུག་ལ།",
    "དཔུང་བའི་སྟག་མོའི་འཛུམ་ཆིངས་ནི།",
    "འཇག་གི་སྣ་ནས་ཁྲུ་གང་གི་སར་གྲེ་མོའི་ཁབ་མ་འུར་རྡོའི་མཐིལ་ལྟ་བུ་སྐྱོང་མོ་གཅིག་བྱས་ལ།",
    "དེ་གྲེ་མོ་ལ་བསྐོན་ནས་མཁྲིག་མ་ཡན་ལ་མོན་བུ་ལྷས་བུ་འཆིང་བའོ།",
    "མཁྲིག་མའི་རེ་ལྡེ་ཆིངས་ནི་མཐེ་བོང་མཐེའུ་ཆུང་གི་རྩ་ནས་མཁྲིག་མ་ཐུག་པར་འཕྲེད་ལ་བཅིངས་ནས།",
    "གུང་མོ་ལ་རེ་ལྡེ་ལྷས་སུ་བསྐོན་ནས་ཡང་མཁྲིག་མ་ལ་རེས་བསྐོར།",
    "དེ་ནས་མཛུབ་མོ་སྲིན་ལག་གཉིས་ལ་བསྐོར་གྱིན་འཆིང་བའོ།",
    "པུས་མོའི་གོང་ནས་ཕྱིར་དཀྲིས་ལ།",
    "གཞུག་ཆུང་སྟེང་ན་ཡར་འཐེན་ཏེ་རྐེད་པ་ལ་ཁོར་རེ་བསྐོར།",
    "དེ་ཀ་ལྟར་སྔ་མའི་རྩ་ནས་བཅིངས་ནས་གཞུག་ཆུང་ལ་ཐུག་གི་བཅིང་བའོ།",
    "པུས་མོ་ལ་སེང་གེའི་དྲུག་ཆིངས་བྱ་བ་ནི།",
    "ཡར་གྱི་ལྟབ་སྣ་གཉིས་ཁྲིས་གཅིག་གིས་མནན།",
    "དེ་ནས་བརླ་དང་བྱིན་པ་གཉིས་ལ་ཁྲིས་པ་རེ་དང་།",
    "དེ་རྟིང་བ་ལ་བསྐོན་ལ་སོར་མོའི་རྩ་བར་བཅིངས་ལ།",
    "གྲེ་མོའི་གྲུ་ཆོད་མ།",
    "པུས་མོའི་སྟག་མགོ་གཟེར་འགྱེད།",
    "བྲང་དང་སོག་སྟེང་གི་གཞུང་ཤིང་གཉིས་མཐོ་རེ།",
    "དཔུང་ལྷ་ཕྱི་ནང་གི་གཞུང་ཤིང་བཞི་མཐོ་རེ་ཆག་གང་བ་བྱའོ།",
    "སྨད་ཀྱི་གཉིས་མཁྱིད་རེ།",
    "གྲེ་མོའི་གྲུ་ཆོད་བཅའ་བ་ལ་ཕྱི་ནང་སྟོད་སྨད་ཀྱི་གཞུང་ཤིང་བཞི་མཐོ་གང་སོར་བཞིར་བྱ།",
    "སྨད་ཀྱི་ཆག་གང་ཁ་གནོན་བཞི་འགབ་འདེགས་བཞི་མ་དང་མཉམ་མོ།",
    "མཁྲིག་མའི་སྒྲོམ་ཐབས་བཅའ་བ་ལ་གཞུང་ཤིང་བཞི་མཐོ་རེ་མཁྱིད་གང་ལ།",
    "པུས་མོ་སྟག་མགོ་གཟེར་འགྱེད་བཅའ་བ་ལ།",
    "བརླ་ཕྱི་ནང་གི་གཞུང་ཤིང་བཞི་མཐོ་རེ་མཁྱིད་རེ།",
    "རྗེ་ངར་ཕྱི་ནང་གི་གཞུང་ཤིང་བཞི་མཐོ་གསུམ་དང་སོར་བཞི།",
    "ཕྱི་ནང་གི་གཞུང་ཤིང་བཞི་མཐོ་ངོ་དོ།",
    "གཞུང་གི་ཆ་ལག་བཅོ་བརྒྱད།",
    "ཤིང་ཐམས་ཅད་ལེབ་མོ་ལ་ཚིགས་ཀྱི་ཁུགས་རྒྱུན་གྱིས་བཙེམས་ལ།",
    "འཕོངས་ཙོག་ཙོག་པོ་ནས་བརླའི་ཕྱེད་སླེབས་པའི་འོག་ཤིང་ལེབ་མོ་གཅིག་ལ་ཕྱིའི་ཤིང་གཅིག་མཚང་རའི་ཤིང་གཅིག་བརླའི་ཕྱི་སྐྱོར་གྱི་ཤིང་བརླའི་སུམ་ཆ་སླེབས་པ་གཅིག་བརླའི་ནང་ཤིང་དང་བཞི་བོ་དེ་འབྲེང་བས་སྒྲོག་དཔྱི་དང་མཚང་རའི་ཤིང་གཉིས་རྒྱུན་གྱིས་བཙེམས།",
    "སོག་ཁབ་སོག་པ་དང་མཉམ་པ་གཅིག་གཉའ་ནོན་དང་སྒྲེག་ནོན་སོག་ཁ་རེ།",
    "དཔུང་ལྷུའི་ཕྱི་དང་ནང་གཉིས་དང་གདོང་གཉིས་སུ་ཤིང་རེ་རེ།",
    "མཚན་འོག་ངོས་གཅིག་གི་འགེན་ཤིང་དང་སྒྲོག་ཤིང་གི་བར་ཐམས་ཅད་འབྲེང་བས་བསྡམ་མོ།",
    "གྲེ་མོའི་འཕྲུལ་སྒྲོགས་བཅའ་བ་ལ།",
    "གྲེ་མོའི་ཁུང་བུ་སྐྱོང་མོ་འུར་མཐིལ་ལྟ་བུ་གཅིག་ལ།",
    "མཐེའུ་ཆུང་གི་འགབ་འདེགས་གཉིས།",
    "པུས་མོའི་འཕྲུལ་སྒྱོགས་ལ།",
    "དེ་རྣམས་སྦྲགས་ལ་འབྲེང་བས་བསྡམ་མོ།",
    "རྐང་གི་ཤིང་རྣམས་སོར་བཞི་དང་གསུམ་གྱི་ཞེང་ཚད་དུ་བྱ།",
    "སྡོམ་རྩ་ན་ཁ་གནོན་འགབ་འདེགས་གཞུག་ཤིང་གིས་སྟེང་དུ་འདོན་པའོ།",
    "སྤ་སྒྱོགས་སྒྲོམ་སྒྱོགས་གཉིས་ལ་སྔ་མའི་འབོལ་ཆུང་གི་ནང་སྡོམས་གལ་ཆེའོ།",
    "སྣ་གཉིས་རྐེད་པ་དང་གསུམ་དུ་འཁོར་ལོ་རེ་བཙེམས་ལ།",
    "དེ་ལ་མཚམས་བཞིར་བྱེའུ་གསུམ་གསུམ་གྱིས་བསྡམ་མོ།",
    "དེའི་མིག་དྲུག་ཏུ་ལྟག་མགོ་དྲུག་བཅུག་ལ་གཟེར་གྱིས་བསྡམ་མོ།",
    "སྣ་གཉིས་སུ་སྟག་མགོ་རེ་བྱས་ཀྱང་ཆོག་གོ།",
    "རྒྱབ་ཏུ་ཤིང་ལེབ་གཅིག་བཏང་བ་བྱེ་འུས་བསྡམ་མོ།",
    "ཤིང་མཁྱིད་རེ་བ་དྲུག་གམ་ལྔ་བཏང་ལ།",
    "སྣོལ་མཚམས་སུ་ཕུར་ཆུང་བསྣོལ་ལ་བསྡམ་མོ།",
    "རྒྱབ་ཏུ་ཤིང་ལེབ་ཆེ་བ་གཅིག་བཏང་ལ་སྟག་མགོས་བསྡམ་མོ།",
    "པུས་མོའི་ཚིགས་མལ་བཅའ་བའི་བྱི་ཟེ་ནི།",
    "སྡུད་པའི་བདག་པོ་དྲང་སྲོང་གིས།",
    "འཛམ་བུ་གླིང་གི་བདག་པོར་གྱུར།"
  ]
}