    "མ་མཐའ་ཀ་མད་སུམ་ཅུ་ཙམ་ལ་རྨོངས་པའི་བླུན་པོའང་ཤིན་ཏུ་མང་བོ་ཞིག་གདའ།",
    "འོན་ཀྱང་ང་རང་གཅིག་བུར་ད་དུང་ཧ་ཅང་སྤྲོ་བའི་སྣང་བ་ཞིག་འཆར་མྱོང་།",
    "ཁོ་རང་ཉིད་ཀྱི་བརྩོན་པའི་འབྲས་བུ་ཡང་མ་ཡིན་པར་མཛའ་བརྩེ་ཡི་སེམས་གཉིས་གཅིག་ཏུ་འདྲེས་ཏེ་མཉམ་དུ་བརྩོན་པའི་འབྲས་བུ་ཡིན་ལ།",
    "རླངས་འཁོར་གྱི་འདུག་སྟེགས་ལ་བསྙེས་ཏེ།",
    "བ་གམ་ཁང་བཟང་ཐོག་ལ་མི་སྐྲག་རང་རང་ས་ནས་རང་དོན་བསྒྲུབས།",
    "ཁྱེད་ཀྱི་ཚིག་ཀྱང་རང་བཞིན་མེད།",
    "ཞེས་དོགས་པ་ཁོང་སློང་བྱས་ནས་དེའི་ལན་དུ་ང་ལ་ཡོད་ན་རང་བཞིན་གྱིས་ཡོད་དགོས་པ་དང་རང་བཞིན་གྱིས་མེད་ན་མེད་དགོས་པའི་དམ་བཅའ་དེ་ཡོད་ན་ང་ལ་སྐྱོན་དེ་ཡོད་ཀྱང་།",
    "ང་རང་མེད་པའི་འཚོ་བའི་ཁྲོད།",
    "རང་རང་ས་ནས་རྫིག་རྫིག་རྔམ་རྔམ་མང་བོ་བྱེད་ཀྱིན་འདུག་དཔེར་བཞག་ན་རྔ་བ་དང་ཀན་ལྷོ།",
    "ཕ་རོལ་ཟིལ་གྱིས་གནོན་པའི་སྤོབས་པས་ཁེངས་འདུག་ཅིང་།",
    "ལོ་ཆེན་བེེ་རོ་ཙ་ན་ལ་འདིའི་ཕྱོགས་ཀྱི་ཆ་རྐྱེན་ཕུན་སུམ་ཚོགས་པ་ཞིག་འཛོམས་ཡོད་པ་ནི།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན་ལི་ཡུལ་དུ་བཙན་པོ་སུའི་སྐུ་རིང་ལ་ཕེབས་པའི་སྐོར་ནི།",
    "ལོ་ཆེན་མཁས་པ་བེ་རོ་ཙ་ན་ཉིད",
    "བེ་རོ་ཙ་ན་དང་།",
    "ཞེས་གསུངས་པ་ལས་གསལ་བོར་བསྟན་འདུག་ལ།",
    "དེ་ལྟར་ན་ལོ་ཆེན་བེ་རོ་ཙ་ན་ལི་ཡུལ་དུ་ཕེབས་པའི་ལོ་དེ་སྤྱི་ལོ་ལོའི་སྔོན་དུ་འདེད་དགོས་པ་ཤེས་ཐུབདེ་ནས་ལོ་གཉིས་ཀྱི་སྔོན་ཏེ་འུག་པ་ཁ་གཅིག་སྤྱི་ལོ་ལོར་ཏུན་ཧོང་ཆབ་འོག་ཏུ་བཅུག་པ་དེས་ལི་ཡུལ་ལྟེ་བར་གྱུར་བའི་ནུབ་ལྗོངས་ཀྱི་ཡུལ་གྲུ་ཐམས་ཅད་བོད་བཙན་པོས་ཡུན་རིང་བདག་སྐྱོང་བྱེད་པའི་རྨང་གཞི་བརྟན་པོ་ཞིག་བཏིངས་པ་མ་ཟད།",
    "དེས་ན་ཧ་ལམ་སྤྱི་ལོ་ཡས་མས་ཤིག་ལ་ལོ་ཆེན་བེ་རོ་ཙ་ན་ལི་ཡུལ་དུ་གདན་འདྲེན་ཞུས་པ་མིན་ནམ་སྙམ།",
    "ལོ་ཆེན་ལི་ཡུལ་དུ་ཕེབས་ཐེངས་གཉིས་པ་དེ་ཁྲི་ལྡེ་སྲོང་བཙན་གྱི་སྲིད་མཇུག་ཙམ་ལ་ངོས་བཟུང་ན་འགྲིག་འདུག་སྙམ།",
    "དེ་ལྟ་ན་ཁོས་བོས་སྒྲ་གཏན་ནས་མ་གོ་བར་འདུག་པས་གཞན་ལ་སློབ་པ་ནི་མི་རིགས་སོ་ཞེས་གཞན་ལ་མི་འཆད་པར་དམ་བཅས་པ་ན།",
    "ཁ་འཚང་ངོ་འཚང་བྲུས་ནས་འདུག་རྒྱུ་ལས་ད་སྔ་ཡན་ཆད་འདིར་བོད་སྐད་དག་མ་ཙམ་ཡང་རྒྱུད་འཛིན་བྱེད་ཨེ་ཐུབ་བལྟ་མ་མྱོང་བ་འདྲ།",
    "ད་ནི་ཟིན་བྲིས་ལ་མཚོན་ན་སྤུས་ཚད་ཅིག་གླེང་རན་ནས་མི་ཚད་འཕྱིས་ཀྱིན་འདུག་ན་ཡང་མགོ་མ་ཚོས་གོང་ནས་ལྕེར་བསྙབ་མཁན་གྱི་ཤེས་ལྡན་པ་ཚོས་ཅིའི་ཕྱིར་མི་སྨྲ་བའི་བརྟུལ་ཞུགས་བཟུང་སྟེ་བཞུགས་པ་ཡིན་ནམ་སྙམ།",
    "ཡིས་ཉེན་ཁར་ཕྲད་པའི་སྲོག་ཆགས་ཀྱི་གྲས་སུ་གཏན་ཁེལ་བགྱིས་འདུག་འོན་ཀྱང་བྱིའུ་འདི་སུས་ཀྱང་གསལ་བོའི་སྒོ་ནས་ཐོ་འགོད་དང་ཞིབ་འཇུག་སོགས་བྱ་ཐུབ་མེད་ལ།",
    "༢༧ལོར་འཛམ་གླིང་རང་བྱུང་ཐེབས་རྩ་ཚོགས་པས་སྲུང་ཞིབ་ལས་རིགས་ལ་རོགས་སྐྱོར་བྱས་པར་མ་ཟད།",
    "མི་རིགས་དང་ལ་རྒྱའང་ངོས་མ་ཟིན་པར་རང་ཉིད་དང་རང་ཉིད་ཀྱི་འབྱུང་ཁུངས་ཀྱང་བོར་ལ་ཉེ།",
    "དེར་རྒྱ་ཆེ་བའི་རྩྭ་ཐང་ཡོད་ལ་ལྟ་ན་སྡུག་པའི་མཚེའུ་ཡང་ཡོད་པས་ཉ་ལས་དང་ཕྱུགས་ལས་གང་བྱས་རུང་མདུན་ལམ་ཆེན་པོ་ལྡན་འདུག་ཅེས་ཤོད་པ་དང་ཡང་ལ་ལས་དེར་རྒྱ་ཆེ་བའི་ས་ཆ་ཡོད་པས་མཐོང་བ་ཙམ་གྱིས་མི་རྣམས་ལ་སྤྲོ་བ་རབ་ཏུ་བརྟས་ཤིང་།",
    "གཡས་གཡོན་གྱི་རི་འདབས་སུའང་སྡོང་ཐུང་ནགས་ཚལ་མ་གཏོགས་མི་འདུག་གོམ་བགྲོད་བྱེད་སྐབས་དཀའ་ངལ་ཅུང་ཆེ་བའི་ཚོར་སྣང་བྱུང་།",
    "མི་རྩུབ་མི་བརླང་རང་དུལ་རྣ་བར་སྙན།",
    "སྣ་ཚོགས་ཚོན་དང་ཕྲད་པའི་ཤེལ་བཞིན་གྲངས་མེད་གདུལ་བྱའི་རང་རང་སྐད་དང་མཐུན་པར་ནི།",
    "རང་རང་འཁོར་འདུལ་སྒོ་བཞི་བསྲུང་།",
    "རི་བོ་དགའ་ལྡན་གྱི་མཁན་བརྒྱུད་ཡོངས་རྫོགས་མི་འདུག་རུང་གང་གསུང་རྣམས།",
    "རང་རང་སྐུ་ཡི་དབྱིབས་དང་ཕྱག་མཚན་སོགས།",
    "རང་རང་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་ཡི།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "སྐུ་གཞོན་ནུ་འདི་འདྲ་ལ་ཡོན་ཏན་གྱི་གཏེར་ཆེན་པོ་འདུག་ན།",
    "རང་རང་བློ་དང་རྗེས་སུ་མཐུན་པའི་འགག་མེད་དབྱངས་ཀྱི་ཡན་ལག་ནི།",
    "སརྦ་ཏ་ཐཱ་ག་ཏསུ་ག་ཏ་ཝ་ར་ཝ་ཙ་ན།",
    "སྤྱན་སྔར་འདུག་སྟེ་འདི་སྐད་གསོལ།",
    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "ཕུང་པོ་ལྔ་པོ་དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པར་རྣམ་པར་ཡང་དག་པར་རྗེས་སུ་བལྟའོ།",
    "ཨོཾ་རུ་རུ་སྤུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྦ་སཱ་དྷ་ནི་སྭཱཧཱ།",
    "རང་རང་ཕྱོགས་སུ་ལེགས་པར་བཞུགས་ནས་སུ།",
    "སྐྱེས་པ་དང་ནི་འདུག་མི་བྱ།",
    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོ་བའི།",
    "ཤེས་ཤིང་རང་བཞིན་དཀར་གནག་ལས་མཐོང་བས།",
    "བདག་ནི་གང་དུ་འགྲོ་དང་འདུག་པའི་ཡུལ།",
    "དུས་དེ་རིང་རང་ཅག་སོ་སོར་གྱེས།",
    "བདེན་པ་མཐོང་ཞིང་རང་ཡིད་ཚིམ་པར་གནས།",
    "ཨ་ཙི་འདི་འདྲའི་སེམས་ཡིད་སྐྱོ་བ་ལ།",
    "ཕྱིར་ལོག་དུས་ན་ས་སྲོད་ཁ་བ་བབས།",
    "ལོ་མཇུག་དུས་ཚོད་བྲེལ་འཚབ་ཤིན་ཏུ་ཆེ།",
    "རབ་མཛེས་ཁམ་བུའི་མེ་ཏོག་དུས་རྟག་ཏུ།",
    "རང་རང་ཕ་ཡུལ་དྲན་ཞིང་ཡང་ཡང་ལྟ།",
    "དེ་ལྟ་བུའི་རང་བཞིན་སྐུ་གསུང་ཐུགས་མི་ཟད་པ་རྒྱན་གྱི་འཁོར་ལོ་ལྷུན་སྟུག་དེགསང་བསྟན་བཅོས་བཀོད་པའི་ཞིཞིང་ན་འཕོ་འགྱུར་མེད་པས་དུས་ཀུན་ཏུ་བཞུགས་ཤིང་རང་སྣང་བའི་ལོངས་སྤྱོད་ཆེན་པོ་རྫོགས་པས་བཟང་པོ།",
    "སྒྱུ་མ་ལྟ་བུ་དང་རང་བཞིན་གྱིས་སི་། དག་པའོ།",
    "རོ་སྣ་ཚོགས་དང་རང་བཞིན་ལྷུན་གྱིས་གྲུབ་པར།",
    "འདི་ལ་ཁ་ཅིག་དུས་ལ་སོགས་པའི་སྙིགས་མར་འཆད་པ་ནི་ཕྱིན་ཅི་ལོག་གོ།",
    "དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱིས།",
    "རང་རང་མགོ་ལ་ཁྲོ་སྐུར་གསལ།",
    "བེ་རོ་ཙ་ནའི་སྔ་མ་བརྒྱ་འགྱུར་དང་།",
    "བི་མ་ལ་དང་གཉགས་དང་རྨ་གསུམ་གྱི་ཕྱི་འགྱུར་ལ་འདུག་པས་རྒྱ་དཔེ་ཉིད་ལ་མང་ཉུང་ཡོད་པར་མངོན་ནོ།",
    "ལ་ལས་འདུག་སྟངས་ཉེས་པས་སྦྲིད་པ་སངས་པར་གོ།",
    "པགང་ཤར་གྱི་རྟོགས་ཚོགས་ཡེ་ཤེས་ཀྱི་ཚོགས་མཆོག་ཏུ་ཡེ་ནས་གནས་པ་ནི་དོན་གྱི་འདུག་ཚུལ་ལོ།",
    "འགྲོ་འདུག་དང་སྤྱོད་ལམ་ཐམས་ཅད་ཀུན་ཕྱག་རྒྱ་ཆེན་བཅོསགསང་པོའི་ངང་དུ་གནས་ཤིང་འདུས་པས།",
    "མཚམས་དང་དམ་བཅའ་བརྟན་པར་བྱས་ལགནས་དེ་ཉིད་དུ་ས་སི་། སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དམར་གྱི་ངོ་བོ་མཚོན་པ་སེན་ཟླུམ་ཙམ་གྱི་ཉི་ཟླའི་གདན་ལ་སྲན་མའི་གའུ་ཕྱེད་པ་ཙ་ནའི་འབྲུ་ཙམ་གྱི་པདྨའི་གདན་གྱི་སྟེང་དུ་ཤིན་ཏུ་དྭངས་མ་ཡུངས་འབྲུ་ཙམ་འགྲེལགྱི་ངོ་བོ་ཡི་གེའི་རྣམ་པ་ཧཱུྃ་དུ་གསལ་བ་ལས་རང་བཞིན་གཉིས་སུ་མེད་པའི་ཕྱག་རྒྱ་རྡོ་རྗེ་ཏིལ་འབྲུ་ཙམ་དུ་བྲིས་པ་སྟེ་གསལ་གདབ་བོ།",
    "སྤྱོད་ལམ་མཁས་ལ་འདུག་ཚུགས་ལེགས་པ།",
    "འདུག་མི་ཚུགས་ཤིང་འགྲོ་ལ་དགའ་བལག་འཚུབ་ཅིང་བྱ་བྱེད་མང་བ།",
    "འདིར་ལྷ་དེ་དག་སྐོར་ཚོམས་སུ་འདུག་པའི་ཆ་ནས་བཏགས་པ་ཡིན་ནོ།",
    "དེའང་རིམ་གཉིས་ལསགཞི་དང་རང་བཞིན་འབྲས་བུའི་ཚུལ།",
    "དེ་ལྟ་ན་ཁྱེད་རང་རྒྱུད་དུ་འདོད་པའི་སིའགྲེལ།"
  ]
}