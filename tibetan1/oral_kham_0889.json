    "འོན་ཀྱང་ང་རང་ནི་འགན་མི་འཁུར་བའི་མི་ཞིག་ཡིན་མི་སྙམ་གྱི་ཡོད།",
    "ས་ཐེས་ཡུལ་འཕྲད་ཟློས་གར་རྟོགས་བཟོ་བྱེད་སྐབས་ག་དུས་ཡིན་རུང་ཟློས་གར་ཁྲོད་ཀྱི་མི་སྣ་དེ་ཉམས་ཉེན་ཕྱོགས་བཞིར་གནས་པ་དང་།",
    "ཨང་ལིས་ངས་ཧྥུ་ལང་སུའོ་ཝ་བསད་པ་ཡིན་པས་གསོན་པོར་སྡོད་འདོད་མིན་འདུག་ཅེས་ལབ།",
    "འདིར་ས་ཐེས་རྩོམ་རིག་ལ་ཕྱོགས་ལྷུང་རང་བཞིན་དང་འཐབ་རྩོད་རང་བཞིན་ལྡན་དགོས་པ་དང་།",
    "ཕྱརངའི་བསམ་པར་ཁོ་ཚོས་ང་ལ་མགོ་སྐོར་བཏང་འདུག་སྙམ་གྱི་འདུག་ཅེས་སྐད་བརྒྱབ།",
    "ག་དུས་ཡིན་རུང་ཁོ་པ་ནི་ཁོ་པ་རང་ཡིན་ལ།",
    "ཟེར་བ་སོགས་ཤོད་ཀྱི་འདུག་འོན་ཀྱང་དོན་དམ་ནི་ཏག་ཏག་དེའི་ལྡོག་ཕྱོགས་ཤིག་ཡིན་ཏེ།",
    "གཉུག་མར་གནས་པ་སྨྲ་བའི་རྩོམ་པ་པོ་གཙོ་བོའི་གྲས་སུ་སུའོ་ལའེ་ཨེར་ཕུད་ད་དུང་རངཏི་པོ་ཏུའོ་དང་།",
    "དེའི་ཕྱི་ལོར་ཡོངས་སུ་སྲོལ་རྒྱུན་གྱི་བྱ་ཐབས་སྤྱད་དེ་བརྩམས་སྒྲུང་རིང་གྲས་ཨང་དང་པོ་ཡ་མཚན་ཅན་གྱི་ཁེར་འདུག་ཅེས་པ་གསར་རྩོམ་བྱས།",
    "མིའི་རང་ངོས་ཀྱི་བླང་དོར་དང་ལུགས་མཐུན་མ་ཡིན་པའི་ཕྱི་རོལ་དོན་དངོས་གཉིས་ག་དུས་ཡིན་རུང་མཐུན་ཐབས་མེད་པ་ཞིག་ཡིན་པའི་ངོས་འཛིན་བྱས་ཡོད།",
    "ཟློས་གར་ཁྲོད་ཀྱི་གྱང་ལྡེབས་སུ་བཀལ་བའི་ཆུ་ཚོད་འཁོར་ལོས་ག་དུས་ཡིན་རུང་དྲིལ་བརྡ་གང་བྱུང་དུ་བརྡུངས་པ་སྟེ་ཆུ་ཚོད་དང་པོ་དང་ཕྱེད་ཀྱའི་དྲིལ་བརྡ་བརྡུངས་ཚར་མ་ཐག་ཡང་དྲིལ་བརྡ་ཉི་ཤུ་རྩ་དགུ་བརྡུངས་པ་དང་།",
    "བཟའ་ཚང་བར་གྱི་འབྲེལ་བའང་ཚུལ་མིན་ལུགས་འཆལ་གྱི་ཚད་གཞི་འདི་ལྟ་བུར་སླེབས་ཙ་ན།",
    "ཁོ་ཚོ་ནི་སུན་སྣང་སྐྱེས་ནས་འཆི་གྲབས་འདུག་ཅེས་དང་།",
    "སྡོད་ཟེར་ན་མི་སྡོད་རང་སྡོད་ཀྱི་སེམས་གཏིང་ནས་ཐོན་ཅིང་རང་བཞིན་དུ་གྲུབ་པའི་དོན་རྣམས་ཡིན་པ་ལས་གཞན་ཅི།",
    "ཁོ་རང་ཡང་དུག་རྫས་ཀྱི་དབྱིངས་ཞུགས་ཚད་དེ་དུག་རྫས་ཀྱིས་ཞོར་ཟས་བྱེད་དགོས་པའི་ཚད་དུ་སླེབས་ཡོད་པ་མ་ཟད།",
    "ཁྱེད་ཀྱི་རྡུལ་ཕྲན་མཚོན་ཆས་ཁྱེད་ལ་འཇིགས་སྣང་སྐུལ་ཅིག་ང་ཡི་སྣང་བ་སྐྱིད་པོ་མི་འདུག་ང་ལ་སུན་པོ་མ་བཟོ་ཞིག།",
    "ཕལ་ཆེར་ཡིན་བཟོ་མིན་འདུགགང་ལགས་ཤེ་ན།",
    "བརྗོད་བདེ་ཤུགས་ཆེ་ཞིག་མི་འདུག་སྙམ་སྟེ།",
    "མིའི་རིན་ཐང་དང་རང་གཤིས་དང་བདག་ཉིད་བཅས་བརླགས་པ།",
    "ས་ཐེས་ཐོག་མའི་དུས་སུ་མི་རྣམས་ནི་སྣ་གཅིག་རྐྱང་པ་ཙམ་གྱི་རང་སྣང་རང་བཞིན་གྱི་ངོས་ནས་གཞིར་གྲུབ་པ་དང་།",
    "མིའི་ངོ་བོ་དང་དེ་མིན་ཡོད་ཚད་ནི་རང་སྣང་རང་བཞིན་འདིས་བསྐྲུན་པ་ཡིན་པས་དང་ཐོག་མི་གཞིར་གྲུབ།",
    "ཧྥེང་ཉི་ཀོའི་སོར་རྩེ་ལས་ཕྱུང་བའི་མི་སྣ་རྣམས་ནི་ག་དུས་ཡིན་རུང་རྒྱུན་གཏན་མ་ཡིན་པ་དང་།",
    "དོན་དངོས་ཐོག་དུས་རབས་ཉི་ཤུ་བའི་རྩོམ་པ་པོ་པ་སི་རང་ཉིད་ཀྱི་ལྟ་བ་བརྗོད་པ་ཞིག་ཡིན།",
    "སྒྱུ་མའི་ཡུལ་ལྗོངས་སྣ་ཚོགས་དང་རང་བྱུང་ལས་འདས་པའི་སྣང་ཚུལ་ཐོན་པ་བྱེད་ཀྱི་ཡོད།",
    "བཟོ་པ་དེ་གང་དུ་ཡོད་པ་དེའི་མཁའ་དབྱིངས་སུ་ག་དུས་ཡིན་རུང་ཕྱེ་ལེབ་སེར་པོ་མང་པོ་འཕུར་ལྡིང་བྱེད་ཀྱི་ཡོད་སྟབས།",
    "གད་སྙིགས་ཕུང་པོའི་སྟེང་ཆགས་པའི་ཁྱིམ་རྒྱུད་ཆེན་པོ་འདིའི་ཁོངས་མི་རྣམས་ག་དུས་ཡིན་རུང་ཕན་ཚུན་བསམ་ཤེས་དང་ཡིད་ཆེས་མེད་པ།",
    "དུས་མཚུངས་རྩོམ་པ་པོས་འདོད་རྔམ་གཡོ་འཕྲུལ་ཆེ་ཞིང་རང་ཕན་གཞན་གནོད་དང་།",
    "རྣ་བར་འགེངས་པའི་སྒྲོག་སྒྲ་བཅས་རྒྱ་མཚོའི་ཕྱི་ངོས་ཙམ་ཡིན་གྱི་འགུལ་བ་མེད་ལ་ནག་ཐིང་ངེར་གནས་པའི་རྒྱ་མཚོའི་གཏིང་རིམ་ལ་མི་ཚོས་ག་དུས་ཡིན་རུང་སྣང་ཆུང་བྱེད་ཀྱིན་ཡོད།",
    "ཡུན་རིང་རང་བཞིན་གྱི་ཉམས་པ་སོར་ཆུད་སོགས་ལྟ་བུའོ།",
    "དེང་རབས་རིང་ལུགས་ཀྱི་སྙན་ཚིག་དུས་སྐབས་ཏེ།",
    "དུས་རབས་འདིའི་འཛམ་གླིང་རང་བཞིན་གྱི་འཇིགས་སྐུལ་བརྗོད་བྱར་བྱས་པའི་བརྩམས་སྒྲུང་རིང་གྲས་ཡིད་ཆེས་དཀའ་བའི་འབར་མདེལ།",
    "ནག་པོའི་གདུང་གླུ་ཞེས་པའི་སྙན་ཚིག་ཁྲོད་དུ་རཀྱེ་མ་ཅི་པུའུ་སའེ་ཡི་མིའི་སྡུག་བསྔལ་ནི་ག་དུས་ཡིན་རུང་དེ་འདྲའི་ལྷད་མེད་ལ་གྲོགས་མེད་ཁེར་རྐྱང་ཞིག་ཡིན་པ་དང་།",
    "རི་ནག་པའི་དེ་མིན་སྙན་ངག་པ་མི་ཉུང་བ་ཞིག་ཡོད་པ་རྣམས་ཀྱིས་ཀྱང་རང་སོ་སོའི་དམིགས་བསལ་གྱི་ཉམས་འགྱུར་ལྡན་པའི་བརྩམས་འབྲས་ཀྱི་མེ་ཏོག་བཞད་པར་བྱས་སོ།",
    "ཁོ་ཚོའི་སྙན་ཚིག་ནང་རང་སྲོག་རང་ལྕེབ་ཀྱི་ངར་ཤུགས་མཚོན་རྒྱུར་དགའ་ཞིང་རང་སྲོག་རང་ལྕེབ་བྱ་རྒྱུ་ནི་སྒྱུ་རྩལ་ཞིག་ཡིན་མི་པའི་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད།",
    "དེར་བརྟེན་སུའུ་ལེན་གྱི་རྩོམ་རིག་ལས་རིགས་ཀྱིས་སྔ་བར་ཕྱི་གསུམ་དུ་གདེང་འཇོག་གང་ཡང་བྱེད་མི་ཕོད་པར་ཁ་རོག་འདུག་པའི་རྣམ་འགྱུར་བཟུང་།",
    "འོན་ཀྱང་ང་རང་ནི་ལས་ཀ་དེ་བྱེད་ཀྱི་མིན་ད་ནི་ལས་ཀ་དེ་མི་བྱེད་ཐག་ཆོད་ཡིན་༡་སྙམ།",
    "ཁོའི་བསམ་པར་མིའི་མི་ཚེར་ཁ་རྒྱུ་བྲོ་རྒྱུ་ཅི་ཡང་མེད་ལ་གསོན་པོར་སྡོད་སྐབས་མ་ཤི་བར་དུ་ངེས་པར་མི་སྣ་ཚོགས་དང་འཐབ་རྩོད་བྱེད་དགོས་པ་འདུག་སྙམ།",
