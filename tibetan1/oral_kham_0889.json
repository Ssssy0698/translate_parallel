    "བསེ་ཁྲབ་ཀྱི་སྐུ་པར་གཅིག་འདུག་ཞུས།",
    "ཕྱག་རྡོར་ཞེས་པ་རྒྱུན་དུ་ཁྱིམ་ཚང་ལ་ཡང་ཡང་བཅར་སྡོད་བྱེད་པ་དེ་ཉིད་ཡོད་འདུག་ཅིང་།",
    "ཁོང་རོང་པོའི་བེ་ཧུ་འཕྲིན་ལས་གྲོངས་རྗེས་རོང་པོའི་འགན་ཁུར་ཡང་གཅིག་ལྕོགས་སུ་བླངས་ནས་འཇོན་ཐང་ལྡན་པ་ཞིག་ཡོད་འདུག་ཅིང་།",
    "ཅེས་མཁྲེགས་བཟུང་མཐའ་ནན་བྱས་འདུག་གཤིས།",
    "གུས་ལ་ད་ཆ་བན་ཆུང་རྣམས་ཀྱིས་ཐུབ་ཚོད་བརྙས་སྨོད་རྡུང་རྡེག་གང་མིན་གཏོང་འདུག་པས་དཔོན་ཆེན་པོས་དེ་ལྟར་མི་ཆོག་པའི་བཀའ་ཡིག་ཅིག་སྩལ་བར་ཞུ་ཞེས་ཞུས།",
    "མཚམས་སྤྲུལ་ཟེར་བའང་མི་འདུག་གམ་ཞེས་ཞུས་པ་ཡིན།",
    "ཕྱག་དཔེ་ལེགས་གྲས་ཤིག་ཡོད་འདུག་ཅིང་།",
    "ན་བཟའ་གོས་ཆེན་ཚལ་ཕྱུ་མ་ཞིག་མཆོད་དེ་བཞུགས་འདུག་པས་གསེར་ཞལ་མཇལ་མ་ཐག་སྐུ་ངོ་སྤྱི་སོ་དང་།",
    "ང་རང་སྒེར་གྱི་ངོས་ནས་བྱས་ནའང་བླ་སྤྲུལ་མང་པོ་མཇལ་བའི་གོ་སྐབས་ཐོབ་པ་དང་།",
    "མཁས་པ་ཡིན་ཚུལ་སོགས་ཆེ་བསྟོད་ཞུས་ཡོད་བཟོ་འདུག་པས་དེའི་རྐྱེན་གྱིས་གུས་པར་ཐུགས་སྣང་ཞིག་བྱུང་བ་མིན་ནམ་དྲན་གྱི་འདུག་ཅེས་ཕེབས།",
    "ཡུག་ཐེབས་ཀྱི་མི་འདུག་གམ།",
    "ཚད་གང་ཡག་ཐོག་ཞལ་ཤོབ་གནང་རྒྱུར་ཤིན་ཏུ་བྱང་བ་ཞིག་ཡོད་འདུག་ཉིན་གཅིག་ཁོང་གཉིས་ཁང་ཚན་རྭ་སྐོར་དུ་སྐྱོར་སྦྱངས་གནང་བཞིན་ཡོད་སྐབས།",
    "ཁྱེའུ་བཙས་སྐབས་ལག་ཏུ་རྡོ་རྗེ་ཐོགས་འདུག་ཅེས་གླེང་བསྒྲགས་ཆེ་བས་ལྷ་ས་སོགས་ནས་གཙང་ཕྱོགས་སུ་ཁྱེའུ་དེར་མཇལ་བར་བསྐྱོད་མཁན་མང་པོ་བྱུང་།",
    "རིའི་ཟུར་བར་རང་རང་མགྱོགས་ཞན་དང་བསྟུན་ནས་ཕེབས་ཆོག་ཅིང་།",
    "ལྷམ་ཀོག་ཀྱང་ཉན་པ་མི་འདུག་ཅེས་གསུངས་ཚུལ་ཕྱིས་སུ་གྲགས།",
    "གོ་དོན་གཙོ་བོ་དགོས་ཀྱི་འདུག་གསུངས་བྱུང་།",
    "འདི་འདྲ་ཟེར་གྱི་འདུག་གོ།",
    "གོ་བོ་ཁང་ཚན་དུ་བཞུགས་ཡོད་འདུག་གཤིས།",
    "བར་ཞལ་རོག་བཞུགས་ཚུལ་ཕྱག་འཇུག་དྲག་པོ་ཕུལ་ཡོད་འདུག་གོང་དུ་འཁོད་པ་ལྟར།",
    "མགོན་པོ་ཞལ་བསྟེན་དགོས་ཚུལ་གསུང་ཡོད་འདུག་ཀྱང་།",
    "རྒན་བློ་བཟང་ཡང་ཕྱིན་མེད་པ་ཡིན་འདུག་གཤིས།",
    "མིང་དངོས་སྐལ་བཟང་རྒྱལ་མཚན་ཞུ་བ་གཟུགས་སྟོབས་དང་ཤེད་ཤུགས་ཆེན་པོ་ཞིག་ཡོད་པ་ཁོང་ཡང་ཨར་ཀ་ལེན་པར་ཡོད་འདུག་རྒན་བློ་བཟང་ལོ་ན་མཐོ་བ་དང་།",
    "ཡོད་པ་དེའང་སྐལ་བཟང་རྒྱལ་མཚན་གྱིས་རྒྱབ་ཏུ་ཁུར་རོགས་བྱས་ཡོད་འདུགདེ་ནས་བཟུང་རྒན་བློ་བཟང་དང་།",
    "ནས་གོ་བརྡ་འཕྲོད་པ་ལྟ་བུ་ཡོང་འདུག་ཀྱང་བརྗེད་འགྲོ་བ་དང་།",
    "འགའ་ཞིག་ལ་ཐེངས་གསུམ་དང་བཞི་ལྔ་སྐོར་གསུངས་དགོས་ཀྱི་འདུགརྒྱལ་རོང་འབྲོག་པ་ཟེར་བ་ཞིག་ཡོད་པས་ཁོང་ལ་ཐེངས་བདུན་བརྒྱད་གསུངས་ཀྱང་ཤེས་ཀྱི་མི་འདུག་དེ་ནས་རྒན་གྱིས་གསུངས་པ་ཡིན་ནམ་ཇི་ཡིན་གསལ་པོ་མི་ཤེས་ཀྱང་།",
    "བསྙེན་བཀུར་ཞུ་མིའི་འདོན་བསྐུལ་ལྟར་གདུགས་ཤེར་སེང་གསུམ་སོགས་གྲྭ་ཇ་དང་སྤྱི་མཚུངས་ལྟ་བུ་གནང་སྲོལ་ཡོད་འདུག་བླ་སྤྲུལ་རྣམས་དང་།",
    "འོན་ཀྱང་འབྲེལ་ཡོད་རྣམས་ཀྱིས་རང་འགུལ་གྱིས་ཞལ་འདེབས་ཤིག་འབུལ་སྲོལ་འདུག་པས།",
    "སང་ཉིན་སྐུ་པར་ནང་མེ་ཏོག་ཆ་ཚང་ཞལ་ཁ་ཕྱེས་པ་ཐེབས་ཡོད་པས་རྒན་བློ་བཟང་ངོ་མཚར་ཆེན་པོ་བྱུང་སྟེ་བར་སྐོར་དུ་སླར་ཡང་བསྐྱོད་དེ་བརྟག་དཔྱད་ཞུ་སྐབས་མེ་ཏོག་ཁོག་མ་དེ་ཁོ་པའི་སྒེའུ་ཁུང་སྟེང་བཞག་འདུག་པ་ཞལ་ཁ་ཕྱེས་མེད་པ་གསལ་པོར་མཐོང་།",
    "ཞེས་སྐྱོར་སྦྱོང་གནང་ནས་མཚན་དཀྱིལ་ཙམ་བར་བཞུགས་ནས་ཚིགས་བཅད་གཅིག་པོ་དེ་བློ་འཛིན་གནང་ཐུབ་ཙམ་བྱུང་ཡོད་འདུག་ཀྱང་།",
    "སྤྱོད་ལམ་ཤིན་ཏུ་ལེགས་པ་ཞིག་ཡོད་ཅེས་ཞུ་ཡི་འདུག་ཚུལ་ཕེབས།",
    "ཅ་དངོས་གཞན་རྣམས་བློ་གླིང་དཔེ་མཛོད་ལ་འབུལ་ལམ་ཞུས་འདུག་པ་ནས།",
    "སྐུ་དེ་གོ་བོ་བློ་བཟང་བསྟན་པར་ཞུ་མར་གྱི་རིན་འབབ་ཏུ་སྤྲད་གནང་བ་ཡིན་འདུག་ཀྱང་།",
    "སྐུ་གོང་མ་དེ་སྐུ་ཤ་འབྱོར་པོ་ཞིག་འདུག་ཅིང་།",
    "རྗེ་བདག་ཉིད་ཆེན་པོས་ལྷོ་བྲག་གྲུབ་ཆེན་ནམ་མཁའ་རྒྱལ་མཚན་ལ་ཞུས་ཏེ་གནང་བ་ཞིག་ཡིན་འདུག་ཅེས་ཕེབས།",
    "ཕར་ཕྱོགས་དེར་ཡང་ཁྱིམ་པ་ལོ་རྒན་ཙམ་ཞིག་ངལ་གསོས་ཏེ་བསྡད་ཡོད་འདུག་འདི་མུར་བཞུགས་རྒྱུན་རིང་ཕར་ཙམ་ནས་རྒྱ་གོས་སྔོན་པོ་སྒྲིག་ཆས་གྱོན་པ་ཞིག་ཡོང་བ་དང་།",
    "དད་གུས་ཞུ་བ་ཡིན་འདུགརྫུ་དང་ཟོལ་སྦྱོར་གཏམ་གྱིས་མ་བཅོས་པར།",
    "ཧ་ཅང་གྲ་རྒྱས་གནང་སྲོལ་བྱུང་ཡོད་འདུགསྔགས་པ་གྲྭ་ཚང་སྐབས་ཤིག་ཉམས་རྒུད་ཕྲན་བུ་བྱུང་སྟེ།",
    "སྐུ་ངོ་མཚར་ཅན་དེ་ཉིད་ལྡན་མ་ཁང་ཚན་ལ་བྱུང་ཡོད་འདུག་དེར་བརྟེན་སྔགས་པ་གྲྭ་ཚང་དང་ལྡན་མ་ཁང་ཚན་དབར་སེལ་ལྷད་ཕྲན་བུ་ཤོར་ཚོད།",
    "ཉམ་ཐག་པོ་ཅི་འདྲ་འདུག་འདི་དག་ལ་ཐུགས་སྨོན་སྐྱབས་འཇུག་ཡོང་བ་ཞེས་བརྗོད་ཀྱི་འདུག་ཀྱང་།",
    "དེ་ནས་ལྡན་མ་ཁང་སེར་གྱི་ཨར་ལས་གེགས་མེད་ལམ་ལྷོང་བྱུང་འདུག་གཤིས།",
    "རྒན་སྙུང་བའི་སྐབས་ལའང་རང་ངོས་ནས་གང་ཐུབ་ཞབས་ཞུ་དང་འབྲེལ།",
    "འཇམ་དཔལ་གྱི་ཞལ་སེར་པོ་དེ་འཁྲུངས་འདུག་ཅེས་ངེད་ལ་གསུངས་བྱུང་།",
    "གཞན་ཡང་ཐུགས་འབྲེལ་ཡོད་པའི་དད་ལྡན་ཁག་ནས་རང་རང་བློས་བཅད་ཀྱིས་རྒྱུ་སྦྱོར་འབུལ་བར་གནང་།",
