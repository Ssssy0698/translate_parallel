    "དེ་ལ་འདིར་གསོ་སྦྱོད་གིཚིགས་སུ་བཅད་པནི།",
    "བདག་གིས་གང་དུའང་བཏུད་མི་བྱ།",
    "དགྲ་བཅོམ་རྗེས་སུ་བདག་གིས་བསླབ།",
    "རྣམ་དག་བདག་གིས་བཟུང་བར་བགྱི།",
    "ཁྱོད་ཀྱིས་འཇིགས་པ་ཐོབ་པར་འགྱུར།",
    "གང་དང་གང་གིས་མཆན་མ་དེ་ནས་བསྟན་བར་བྱའོ།",
    "ཤེས་རབ་གཅེར་བུརཅོག་བུསགསང་གནས་མཛུབ་མོས་བསྟན་ནས།",
    "ཁྱོད་ལ་འདི་ནི་དབུལ་ལགས་ཀྱིས།",
    "གང་གིས་དམ་། ནས་ན།",
    "པུས་མོ་གཡོན་པ་སལ་བཙུགས།",
    "འཇིགས་བྱེད་འཁྱོག་པོ་གཟིགས་པ་ཅན།",
    "ཁ་དོག་ནག་མོའོ་བུད་མེད་དེས།",
    "ཁ་དོག་དཀར་མེའི་བུད་མེད་དེས།",
    "ཁ་དོག་དམར་ཚེའི་བུད་མེད་དེས།",
    "ཁ་དོག་ལྗང་ཁུའི་བུད་མེད་དེས།",
    "རེངས་དང་རྒྱས་ལ་སེར་བོ་སྟེ།",
    "རང་གི་མགྲིན་པ་ལས་བྱུང་བའི།",
    "ཤུནཱ་ས་ཧཱ་བ་བི་གོ་ཨི་ཨ་ཀ་ར་ཧི་ཏུ་མོ་ཨེ་ས།",
    "ཁྱོད་དང་རྣམ་བྲལ་བདག་འགུམ་པས།",
    "ཨ་མོ་གྷ་ཙཎ་ཌ་མ་ཧཱ་རོཥ་ཎ།",
    "ཧཱུཾ་ཏྲཱ་ཊ་མོ་ཧཱུཾ།",
    "ཨོཾ་བོ་ཧེ་རེ་ཧཱུཾ་ཕཊ།",
    "ཐ་གྷི་རི་དྷིརིབུད་དྷི་བར་དྷནཾ་སྭཱཧཱ།",
    "བུ་མོ་སྔོ་སངས་མིག་ཡངས་མ།",
    "བུ་མོ་དམར་མོ་དམར་མོ་ཡིས།",
    "བུ་མོ་ལྗང་ཁུ་ལྗང་ཁུ་ཡིས།",
    "བུ་མོ་དེ་ཡིས་དངོས་གྲུབ་སྟེར།",
    "ཁྱོད་ནི་རྟིང་པོ་མེས་པོ་དང་།",
    "བདག་ནི་ཁྱོད་ཀྱིས་རེན་གྱིས་ཉོས།",
    "ཁྱོད་ནི་བདག་གི་རྗེབོ་ཡིན།",
    "ཁྱོད་ཀྱི་བདག་ན་རྣམ་ཀུན་ཏུ།",
    "གཏུམ་མོ་དངནི་གར་མ་དང་།",
    "བུད་མེད་གཟུགས་ཀྱིས་ཡང་དག་གནས།",
    "མི་མོའི་ཡོན་ཏན་གང་བརྗོད་ན།",
    "དེ་ཡི་ལྟ་དང་རེག་པ་དང་།",
    "ཡུལ་ལྔ་རྣམས་ལ་མི་མོ་ཡི།",
    "བཅིང་བརི་མོ་ཅན་ཞེས་བྱ།",
    "བདགགི་རྣམ་པར་སྣང་མཛད་བཟའ།",
    "བུ་ཁྱོད་རབ་ཏུ་འབད་པ་ཡིས།",
    "བདག་གི་ཞབས་ལ་སྐྱབས་སུ་སོང་།",
    "བུ་ཁྱོད་བྱསགཟོར་གྱིས་ཤིག་ཀྱེ།",
    "ཆུ་སྐྱེས་འདབ་མ་གསུམ་པར་གཟིགས།",
