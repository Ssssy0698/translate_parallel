    "སྟོང་པའི་ངང་ལས་པདྨ་ར་ཱགའི་རང་བཞིན་ཟླ་གམ་གྱི་དཀྱིལ་འཁོར་འོད་ཟེར་འཁྲུག་པའི་དབུས་སུ་པདྨ་དམར་པོ་ཉི་མ་ལ་བཾ་ཕོ་མོ་བསྣོལ་བའི་ཁྲིར་ཱུྃ་གཡས་གཡོན་དུ་ཨཱི་དང་ག་དེ་ཡོངས་སུ་གྱུར་པ་ལས་ལྕགས་ཀྱུ་དམར་པོ་ས་བོན་གྱིས་མཚན་པ་གསུམ།",
    "གཉིས་པ་རལ་གྲི་གཡོན་བདུད་བཞིའི་ཁྲག་གིས་གང་བའི་ཐོད་པ།",
    "སྲུང་བྱེད་དམར་མོ་གསུང་གི་ཡུམ་ཤིན་ཏུ་གཞོན་པ་སྒེག་མོའི་ལང་ཚོ་ཅན་ལྕགས་ཀྱུ་འཕྱར་ཞིང་ཐོད་ཁྲག་སྟོབ་པ་དང་གཉིས་སུ་མེད་པར་ཙན་དན་འཁྱིལ་བའི་སྟབས་ཀྱིས་བཞུགས་པ།",
    "གཡོན་ཐོད་པ་ཁྲག་གིས་བཀང་བ་འཛིན་ཅིང་གཙོ་བོ་ལ་འདུད་པའི་གར་གྱིས་རོལ་པ་མེའི་ཀློང་ན་གནས་པ།",
    "ལྕགས་ོག་གིས་བསྡམས།",
    "འཁོར་གཉིས་ཀྱི་སྲོག་གི་ས་བོན་ལ་ཐིམ།",
    "སྙན་ཞིང་འཇེབས་པའི་རོལ་མོ་རྣམས།",
    "ཤ་པྲ་ཏཱིཙྪ་ཱུྃ་གིས་ཕུལ་རྐང་པ་བརྒྱད་པས་བསྟོད།",
    "གནོད་ིན་ཕོ་དགུ་མོ་དགུའི་རྣམ་པར་ཤེས་བཀུག་རྣམ་སྣང་གི་སྒོ་ནས་ཞུགས་ཏེ་ཨ་ཝ་ངྷཱུ་ཏིར་ཞུ་བ་ཛཾ་དགུ་དང་བཾ་དགུ་དང་བཅས་པར་གྱུར་པ་ཡུམ་གྱི་བྷ་ག་ཟླ་གམ་གྱི་དཀྱིལ་འཁོར་པདྨ་འདབ་བརྒྱད་ལྟེ་བ་དང་བཅས་པར་ལྷུང་བས།",
    "མེར་ལྷ་མོ་ལྷོར་འཕགས་མ།",
    "གསང་བ་པའི་གནས་ནས་གནོད་ིན་ཕོ་དགུ་མོ་དགུ་བཀུག་བསྒོམས་པ་དང་གཉིས་སུ་མེད་པར་བསམས་ཏེ།",
    "ཡབ་ཡུམ་ོར་བ་བྱས་པའི་རྗེས་སུ་ཆགས་པའི་མེས་གདུངས་པས་གནོད་ིན་ཕོ་མོ་རྣམས་ཆགས་པས་མྱོས་འབོག་བརྒྱལ་བྱང་སེམས་དཀར་དམར་ཟགས་པར་བསམ་ཞིང་།",
    "རང་རང་གི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ་རྣམས་འོད་དུ་ཞུ་བའི་བདུད་རྩི་ལྔའི་རྒྱུན་གནོད་ིན་ཕོ་མོ་རྣམས་ཀྱི་སྤྱི་བོར་ཕབ་ལུས་ཕྱི་ནང་ཐམས་ཅད་དུ་ཁྱབ་པས་བཀྲག་མདངས་སོགས་མཐུ་སྟོབས་དང་ལྡན་ཏེ་བདག་གི་ལས་བ་ུབ་པ་ལ་གཅིག་ཏུ་བརྩོན་ཞིང་འདུན་པར་བསམས་ཏེ་ཛཾ་བཾ་བརྒྱ་རྩ་བཟླ།",
    "མཐར་ལྷ་ཚོགས་འོད་དུ་ཞུ་བའི་འཁོར་ལོ་ཡིད་བཞིན་གྱི་ནོར་བུ་བསམ་འཕེལ་འདོད་བའི་རེ་བ་ཆར་བཞིན་དུ་འབེབས་པར་གྱུར་པ་བལྟའོ།",
    "ཨ་ཡ་མ་དུ་རུ་ཙ་ཤ་ན་ཨ་མྲྀ་ཏ་ཱུྃ་ཞེས་བཟླས་པས་བཀྲག་མདངས་གསོས།",
    "མཐུ་རྩལ་ལྡན་ཏེ་བདག་གི་ལས་བ་ུབ་པ་ལ་འདུན་ཅིང་བརྩོན་པར་གྱུར།",
    "དེ་བདག་ལ་ཤོར་བས་ཅི་བགྱི་བ་ཉན་པར་བསམ་མོ།",
    "དཀྱིལ་འཁོར་སྟེང་དུ་ཕོ་མོའི་ཐོད་པ་ཁ་ར།",
    "རྩིབས་དྲུག་ལ་རིགས་དྲུག་ཕོ་མོ།",
    "ཨ་ྀ་སུ་ཏྲི་པྲེ་དུ་ཏྲི་ཨ་མྲྀ་ཏ་ཱུྃ།",
    "ཕོ་འཁོར་གཡས་མོ་འཁོར་གཡོན་པའི་ལྷྭམ་ལ་བཅུག་གྱོན།",
    "འཁོར་ལོའི་ཛམྦྷ་ལ་ཕོ་མོའི་སྐུ་ལ།",
    "ཙན་དན་དམར་པོའམ་དུ་རུ་ཀའམ་སེང་ལྡེང་ངམ་དམར་པོའི་རིགས་ཅན་ཤིང་གང་ཡང་རུང་བའི་བུད་ཤིང་ཟླ་གམ་དུ་བརྩིག་མཆོད་རྫས་སྲེག་རྫས་རྣམས་སྟ་གོན་བྱས་ལ་བསངས་ངས་བྱིན་གྱིས་བརླབས།",
    "སླར་ཡང་ཐུགས་ཀའི་ཱུྃ་གི་འོད་ཟེར་གྱིས་མགོན་པོ་ཆགས་པའི་རྡོ་རྗེ་གཙོ་འཁོར་གསུམ་བསྐྱེད།",
    "ཆུ་གཉིས་སྔོན་དུ་འགྲོ་བའི་ཉེར་མཆོད་ལྔ་རོལ་མོ་དང་བཅས་པས་མཆོད་ཅིང་བསྟོད།",
    "རྩ་སྔགས་དང་དངོས་གྲུབ་བསྐུལ་བའི་སྔགས་སྤེལ་ཏེ་བཟླ་བཞིན་དུ་གཡས་པའི་མཐེ་བོང་དང་སྲིན་ལག་གིས་བླངས་ལ་ཕུལ།",
    "མེ་ཏོག་དང་བཅས་པའི་ཐལ་མོ་ར།",
    "ཨོཾ་ཡིག་ལས་འཕྲོས་པའི་འོད་ཟེར་དམར་པོ་ལྕགས་ཀྱུ་ལྟ་བུས་ས་འོག་གི་དངོས་གྲུབ་ཐམས་ཅད་བསྡུས་ཏེ་ཁྱེད་རང་ལ་ཕུལ་བ་འོད་ཟེར་གྱི་རྣམ་པས་ཐུགས་ཀའི་ཱུྃ་གི་ཁོག་པ་ལ་བསྡུ།",
    "ཨཱ་ཡིག་ལས་འཕྲོས་པའི་འོད་ཟེར་དམར་པོ་ལྕགས་ཀྱུ་ལྟ་བུས་ས་སྟེང་ན་སྤྱོད་པའི་དངོས་གྲུབ་ཐམས་ཅད་བསྡུས་ཏེ་ཁྱེད་རང་ལ་ཕུལ་བས་འོད་ཟེར་གྱི་རྣམ་པས་ཱུྃ་གི་ཟླ་ཚེས་ལ་བསྡུ།",
    "ཱུྃ་ཡིག་ལས་འཕྲོས་པའི་འོད་ཟེར་ལྕགས་ཀྱུ་ལྟ་བུས་ས་བླ་ན་སྤྱོད་པའི་དངོས་གྲུབ་ཐམས་ཅད་བསྡུས་ཏེ་ཁྱེད་རང་ལ་ཕུལ་བ་འོད་ཟེར་གྱི་རྣམ་པས་ཱུྃ་གི་ཐིག་ལེ་ལ་བསྡུ།",
    "སྔགས་ལས་བྱུང་བའི་འོད་ཟེར་དམར་པོ་སྲིད་པ་གསུམ་གང་བར་འཕྲོས་པ་རྣམས་ཀྱིས་སྣོད་བཅུད་ཀྱི་འབྱོར་པ་ལོངས་སྤྱོད་ཕུན་ཚོགས་མདངས་བཅུད་ཅི་ཡོད་པ་ཐམས་ཅད་ལྷག་མ་མེད་པར་བསྡུས་ཏེ་ཁྱོད་རང་ལ་དངོས་གྲུབ་ཀྱི་ཚུལ་དུ་ཕུལ་བ་འོད་ཟེར་གྱི་རྣམ་པས་ཐུགས་ཀའི་ཱུྃ་ལ་སྲོག་གཏད་བཟུང་བའི་ཚུལ་གྱིས་རོ་གཅིག་ཏུ་འདྲེས་པར་བསམས་ལ།",
    "བཅོམ་ལྡན་བདག་གིས་གཟུང་ལགས་ཀྱིས།",
    "སྒོས་སུ་རང་རྒྱལ་དུ་ཉེ་བའི་ལོ་འགའ་ནས་བོད་རིག་པའི་ཞིབ་ལ་ཇུག་གི་ལས་ཀ་དབྱར་མཚོ་བཞིན་དུ་རྒྱས་པའི་དགོས་མཁོའི་ཆེད་དང་།",
    "བོད་ཡིག་གི་གནའ་དཔེའི་དཔེ་དཀོན་དཔེ་ཚོགས་དུ་མ་པར་དུ་བསྐྲུན་དང་སྐྲུན་བཞིན་ཡོད་ལ།",
    "སྙན་ངག་གི་འགྲེལ་པ་སོགས་ནང་དོན་སྣ་མང་ཕུན་སུམ་ཚོགས་པ་ཡོད་པས།",
    "འདི་ལྟར་དཔེ་སྒྲིག་གི་ལས་གའི་བརྒྱུད་རིམ་ཆ་ཚང་བ་བྱས་ཏེ་པར་དུ་བཏོན་མོད།",
    "སྐྱེ་བོ་ཀུན་གྱིས་རང་རང་གི་རྣམ་དཔྱོད་འདྲ་མིན་གྱི་རྩལ་ལ་བརྟེན་ནས་རིག་པའི་གནས་ཅི་རིགས་གསར་གཏོད་དང་།",
    "ཡ་རབས་དང་གཤིས་བཟང་གི་མཛེས་སྡུག་རང་ཆས་སུ་ལྡན་པའི་མི་རིགས་ཁྱད་འཕགས་ཅན་ཞིག་ཏུ་ཡར་རྒྱས་བྱུང་བའི་འབྲས་བུར།",
    "དེང་གི་དུས་སུའང་འཛམ་གླིང་ཡོངས་སུ་གནས་པའི་སྲིད་འབྱོར་རིག་གསུམ་སྤྱི་དང་།",
    "དེར་བརྟེན་སེ་ར་ཐེག་ཆེན་གླིང་དང་ལྷ་ལྡན་གཙུག་ལག་ཁང་མཉམ་འབྲེལ་གྱིས་སེར་གཙུག་ནང་བསྟན་དཔེ་རྙིང་འཚོལ་བསྡུ་ཕྱོགས་སྒྲིག་ཁང་ཞེས་པའི་ཚན་པ་ཞིག་ཆེད་དུ་བཙུགས་ནས་ད་བར་བགྲང་བྱ་གསུམ་ལྷག་ཙམ་གྱི་རིང་ལ་ཕྱོགས་གཉིས་ནས་ཐུན་མོང་དུ་མ་ཐེབས་སྒོར་ས་ཡ་གསུམ་ལྷག་ཙམ་བཏང་སྟེ་དཔེ་དཀོན་མྱུར་སྐྱོབ་དང་།",
    "འདས་པའི་ལོ་ཟླའི་ནང་ང་ཚོའི་ལས་གཞི་ལ་གོང་རིམ་འབྲེལ་ཡོད་ཚན་པ་ཁག་གི་དབུ་ཁྲིད་ནས་གཟིགས་སྐྱོང་བླ་ན་མེད་པ་གནང་བ་དང་།",
    "ང་ཚོར་ཕྱར་བ་གྲུ་འདེགས་ཀྱིས་ལྷད་མེད་རྒྱབ་སྐྱོར་རོགས་རམ་གནང་བར་རྗེས་སུ་ཡི་རངས་དང་།",
    "ཡང་སྒོས་མཛད་པའི་མཆོག་གསུང་གི་མཛད་པ་སྟེ།",
    "གངས་ཅན་ཁྱད་ནོར་དཔེ་ཚོགས་ཀྱི་པོད་འཕྲེང་༡༧༡ནས་༡༩༨བར་བསྒྲིགས་ཏེ་རྒྱ་ཆེའི་གཟིགས་པ་པོའི་སྤྱན་ལམ་དུ་ཕུལ་བ་ཡིན།",
    "ལྷ་ལྡན་གཙུག་ལག་ཁང་གི་དཔེ་མཛོད་ཁང་དུ་བཞུགས་པའི་གསུང་འབུམ་འཕྲུལ་པར་མ།",
    "དེ་བཞིན་དྭགས་པོ་མངའ་རིས་གྲྭ་ཚང་གི་གསུང་འབུམ་འཕྲུལ་པར་མ་སོགས་མ་དཔེ་ཁག་བཞི་ཙམ་ལ་ཞིབ་བསྡུར་ཞུས་པ་ཡིན།",
    "དམིགས་བསལ་ཞུ་བྱ་ཞིག་ལ་ཁོང་གི་གསུང་ལས་གསང་བ་རྒྱ་ཅན་བྲིས་མ་པོད་གཉིས་བཞུགས་པ་ཏ་ཅང་བཀའ་གཉན་པ་དང་།",
    "ཞུས་ཆེན་བཅས་ཞུ་དག་གི་རིམ་པ་བཞི་ལྷག་བརྒྱུད་ཅིང་།",
    "རྒྱན་སྡུད་གསུམ་གྱི་ཕྲད་དང་ཡིག་ནོར་མངོན་གསལ་ཅན་རེ་ཟུང་དག་བཅོས་བྱས་པ་ཕུད།",
    "ངེད་རྣམས་རྩོམ་སྒྲིག་གི་བྱ་བར་ལས་དང་པོ་བ་ཡིན་པ་དང་།",
    "ལྷག་པར་ངེད་ཚོའི་ལས་དོན་ཐད་ལྷག་བསམ་རྣམ་དག་གིས་རྒྱབ་སྐྱོར་གནང་མཁན་དཔལ་བརྩེགས་བོད་ཡིག་དཔེ་རྙིང་ཞིབ་འཇུག་ཁང་དང་།",
    "སྙན་ངག་གི་མཚན་ཚངས་སྲས་བཞད་པའི་རྡོ་རྗེ།",
    "གང་གི་སྤྲུལ་གཞི་འཕགས་མཆོག་སྤྱན་རས་གཟིགས་ཀྱི་ཆེ་བའི་ཡོན་ཏན་དང་།",
    "དཔལ་ཕག་མོ་གྲུ་པའི་བློན་པོའི་གདུང་རྒྱུད་དུ་ཡབ་བདུད་འདུལ་རབ་བརྟན་དང་།",
    "བསྒྲུབ་བྱ་ཁྲི་ཕྲག་མང་པོར་དགེ་ཚུལ་སློང་གི་སྡོམ་པ་བསྩལ་བ་དང་།",
    "ལྷ་བྲག་གཏེར་བྱོན་ལས་ཁྱུང་གི་འཕྲིན་ལས་གནམ་ལྕགས་རྡོ་རྗེའི་ཐོག་མདའ།་",
    "མཁའ་འགྲོ་བསུན་བཟློག་གི་བཅས་བཤོམས་ཅི་འདོད་རྩེ་དགའ་གསར་གླུ།་",
    "བསུན་བཟློག་གི་ཆོག་སྒྲིགས་འཆི་བདག་གཡུལ་ལས་རྣམ་རྒྱལ།་",
    "བསུན་བཟློག་གི་ཟོར་བྱང་།་",
    "དྲང་སྲོང་ལོག་ཏྲི་པ་ལའི་སྲུང་བཟློག་ཐུན་མོང་བ་ཉམས་སུ་ལེན་ཚུལ་བཙན་མཁར་བསྲུང་བའི་འཛ་ལ་སྐྱོགས།་",
    "གསོལ་བ་འདེབས་སོ་ཐུགས་རྗེ་ཅན་གྱིས་གཟིགས།",
    "གསོལ་བ་འདེབས་སོ་ཐུགས་རྗེ་ཅན་གྱིས་གཟིགས།",
    "གསོལ་བ་འདེབས་སོ་ཐུགས་རྗེ་ཅན་གྱིས་གཟིགས།",
    "གང་གི་སྐྱེ་སྤྲུལ་ཟློས་གར་གྲངས་མེད་ལས།",
    "མ་རུངས་ལོག་འདྲེན་ཀུན་འདུལ་ཟབ་མོའི་གཏེར།",
    "ཚིག་གི་སྲད་བུར་ལེགས་བརྒྱུས་མར་གད་འཕྲེང་།",
    "སྙིགས་དུས་ཉེན་མོངས་དུག་ལྔ་དྲག།",
    "ཨཱོཾ་ཨཱ་་གིས་བདུད་རྩིར་བྱིན་གྱིས་བརླབས།",
    "ཟེགས་མར་འདོད་ཡོན་ལྷ་མོ་དཔག་མེད་སྤྲོས།",
    "ཆུ་སྐྱེས་སྟེང་དུ་ཉོན་མོངས་བདུད།",
    "པདྨའི་གདན་ལ་ཉོན་མོངས་བདུད།",
    "བཛེ་མཧཱ་གུ་རུ་རྨ་ས་རཀྟ་ཀེ་སྣུ་ཏི་ཨ་མྲྀ་ཏ་བ་སྨྲ་ཏ་མཧཱ་སརྦ་པཱ་ཛ་ཁཱ་ཧི།",
    "ཁྲོ་བོ་ཁྲོ་མོ་རོལ་པའི་བྲོ།",
    "ཁྲོ་མོ་རྣམསཀྱིས་རྒྱས་འདེབས་སོ།",
    "མཆོག་དང་ཐུན་མོང་དངོསགྲུབ་སྩོལ།",
    "གང་གི་རྣམ་འཕྲུལ་སྲིད་མེ་ཆུ་སྤུངས་ནས།",
    "རྒྱབ་ཏུ་གཏེར་སྲུང་གི་གཏོར་མ།",
    "སྙིགས་དུས་ཉོན་མོངས་དུག་ལྔ་དྲག།",
    "འི་ཕྱིར་དུ་ལས་བྱང་ལྟར་སྐྱབས་སེམས་སོ་སོར་ཚར་གསུམ་རེའི་རྗེས་ཟློས་བྱེད།",
    "མོས་གུས་གདུང་ཤུགས་དྲག་པོ་ཡིས།",
    "ཨ་མྲྀ་ཏའི་སྔགས་ཀྱིས་བགེགས་བསངས།",
    "ཆུ་སྐྱེས་སྟེང་དུ་ཉོན་མོངས་བདུད།",
    "སྤོས་སྦྱོར་བསྲེག་ཅིང་རོལ་མོ་དབྱངས་དང་བཅས་པས།",
    "གདུང་ཤུགས་དྲག་པོས་མོས་གུས་བྱེད་དུ་བཅུག་སྟེ།",
    "བག་ཟན་དུང་དང་ཁྲག་གིས་སྤྲུས།",
    "གཏང་རག་གི་མཎྜལ།",
    "གཏང་རག་གི་མཆོད་བསྟོད།",
    "དཔལ་རིའི་རྩེ་མོར་རང་རིག་པདྨ་འབྱུང་།",
    "དེ་ནས་བདུན་གཉིསཔ་ལ་ཐུན་རེའི་སྟོད་ཀྱི་ཆ་གོང་ལྟར་ལ་འོད་ཟེར་ལྕགས་ཀྱུ་ལྟ་བུ་འཕྲོས་པས་ཞི་ཁྲོ་རབ་འབྱམས་ཀྱི་སྐྱབས་ཡུལ་ཐམསཅད་ཀྱི་ཐུགས་རྒྱུད་བསྐུལ།",
    "རང་རྒྱུད་ཉོན་མོངས་དུག་ལྔ་འབྱུག་པའི་གཟུགས།",
    "མཐུ་སྟོབས་གནམ་ལྕགས་འབར་བའི་ཐོག་གི་མདས།",
    "དྲན་པས་ངན་སོང་གསུམ་གྱི་སྡུག་བསྔལ་སྐྱོབ།",
    "བཏབ་པའི་མོད་ལ་དགྲ་བགེགས་ཕྱེ་མ་ལེབ།",
    "མངོན་སུམ་གཟིགས་པ་ཟུར་ཆེན་ཐམས་ཅད་མཁྱེན།",
    "འབྲུ་ནག་ཕྱེ་ལ་དུག་ཁྲག་གིས།",
    "དེའི་༢བསྐོང་མལྗིའི་ཁར་ལྕགས་སྣོད་དུ་གོང་གི་རྒྱུ་ལས་གྲུབ་པའི་གཏོར་ནག་ཟུར་གསུམ་པ་མེ་རིས་དམར་སེར་ངེ་བ་སོགས་དྲག་པོའི་རྒྱན་དང་མཐར་ཟེར་ཀོང་མཐེབ་སྐྱུ་རྩང་དམར་ཉེར་གཅིག།",
    "རེ་བའི་གདན་ལ་འབྲུ་ནག་སྟེང་།",
    "ཉོན་མོངས་བདུད་བཞི་ཟིལ་གྱིས་ས་ནོན།",
    "མགོ་བོ་ལྷ་ཡི་ཡུལ་དུ་འཁྱོག།",
    "ཚོ་གོས་ཐ་མ་དང་བར་མ་སོང་ནས།",
    "གློག་དམར་ཙམ་གྱི་ལྗགས་ཁྱོངས་ཤིག།",
    "ཕོ་སྲི་མོ་སྲི་ལངས་པ་བཟློག།",
    "ཡུལ་མི་ཁྱིམ་མཚེས་དམོད་མོ་བཟློག།",
    "གཡོན་ནས་མོ་བརྒྱས་དུག་སྦྱོར་བཟློག།",
    "བྲན་ཁོལ་ངན་པའི་དམོད་ཆུ་བཟློག།",
    "མོ་ངན་ལོག་པར་སྡིགས་པ་བཟློག།",
    "ཐོ་རེངས་སྒོ་ཁྱི་ངུ་བ་བཟློག།",
    "ཕ་ཚན་ནང་གི་བརྒྱ་འདྲེ་བཟློག།",
    "དར་ཚན་ནང་གི་སྟོང་འདྲེ་བཟློག།",
    "མོ་བདུད་དལ་ཁ་གཡོན་དུ་བཟློག།",
    "མོ་བྱོལ་དེ་ནི་གཡོན་དུ་བྱོལ།",
    "འདོར་བྱེད་རིམ་པ་བདུན་ཡང་ཐལ་བྱུང་དུ།",
    "ན་མོ་བཛྲ་ཝ་ར་ཁྱི།",
    "ཡང་ན་མཚོ་གླིང་བས་མཐའ་དུར་ཁྲོད་ནགས་ཁྲོད་སོགས་ཇི་ལྟར་འོས་པའི་ས་ཕྱོགས་སུ་ཡར་ངོའི་ཚེས་བཅུའམ་དུས་གཞན་གྱི་སྲོད་ལ་བྱ་བར་མ་ཟད་ཉིན་མོ་ལྟ་བུའང་མི་རུང་བ་མིན་པས་གང་དུ་བྱ་བར་ཕྱག་བདར་དང་སྐྱང་ནུལ་ལེགས་པར་བྱས་ལ་གཙང་མའི་ས་ལ་སྟེགས་བུ་ཟླུམ་པོ་རྒྱ་དང་དབངས་ཚད་ཇི་ལྟར་རིགས་པ་བྱས་ན་གཞུང་དང་མཐུན་ཞིང་།",
    "མི་མོས་པ་ཞི་བར་དངར་གསུམ།",
    "དེ་ལྟར་ཡོ་བྱད་རྣམས་མཐོང་བ་བརྒྱུད་པའི་ཕྱག་ལེན་ལྟར་བཤམ་མོ།",
    "གཞན་དོན་བྱེད་པར་བདག་གིས་སེམས་བསྐྱེད་དོ།",
    "བདག་ཉིད་རྡོ་རྗེ་ཕག་མོར་བསྒོམ།",
    "ཁ་ཊྭཱཾ་རྩེ་གསུམ་གྲུ་མོར་བརྟེན།",
    "འགྲོ་དྲུག་སྒྲིབ་སྦྱངས་ཕག་མོར་གྱུར།",
    "ཁྱོ་ཧ་རི་ནི་ས།",
    "ནང་དུ་ལྷ་རྫས་ལས་བྱུང་བུད་ཤིང་གང་།",
    "རྡོ་རྗེ་ཕག་མོ་ཁྲོས་མ་ནག་མོའི་སྐུ།",
    "སྤྱི་གཙུག་ཕག་ཞལ་ནག་མོ་ངུར་སྒྲ་སྒྲོག།"
