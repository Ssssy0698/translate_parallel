    "དེ་ཡང་རང་སར་གཅིག་པ་དང་འབྲས་བུ་དེ་ལས་ཀུན་འགྲོ་དེ་ཉིད་དུས་ལས་བ་སྔ་བར་སྐྱེས་པའོ།",
    "མ་འོངས་པའི་གནས་སྐབས་ན་ནི་འདི་ནི་སྔ་མའོ་འདི་ནི་ཕྱི་མའོ་ཞེས་ཡོངས་སུ་མི་ཆོད་དེ་ཆོལ་བར་འདུག་པའི་ཕྱིར་རོ་ཞེས་སོ།",
    "སོགས་ཀྱི་སྒྲ་ནི་དུས་དང་རང་མཆིམས་བཞིན་དང་རྡུལ་ཕྲ་རབ་ལ་སོགས་པ་རྒྱུ་རྟག་པར་ཁས་ལེན་པ་གཞན་བསྡུ་བའི་དོན་ཏོ།",
    "གང་ཞིག་ཕྲར་གྱུར་གཅིག་པོ་སྐྱེས་ནས་འདུག།",
    "དག་དང་རང་ལས་དེ་ལས་གཉིས།",
    "སྤྲུལ་སེམས་ལས་གཞན་པའི་ལུང་མ་བསྟན་དྲུག་ལས་བཟོ་གནས་དང་སྤྱོད་ལམ་པ་འགའ་ཞིག་ལ་ཐོབ་པ་སྔར་སྐྱེ་ཡོད་ཀྱང་ཕལ་ཆེར་ལ་མེད་ཅིང་རང་ཉིད་མངོན་དུ་འགྱུར་དགོས་པདང་།",
    "གལ་ཏེ་ཕོ་ཞིག་ཡིན་མཆིམས་ན་མའི་ལྟོ་གཡས་ཕྱོགས་སུ་བསྙེས་ནས་རྒྱབ་རོལ་དུ་ཁ་བལྟས་ཏེ་ཙོག་པུར་འདུག་ལ།",
    "བར་མཚམས་ཐམས་ཅད་མུན་པར་འདུག།",
    "དེ་ལ་བརྟེན་པས་ནས་ལྡོག་དུས་ངོས་བཟུང་བའོ།",
    "མཁས་རྣམས་དྲི་ནི་རྫི་ཕྱོགས་མིན་འགྲོ་སྟེ།",
    "གཞལ་མེད་ཁང་ནི་ཆེད་དུ་བྱས་པ་དང་མ་བྱས་པ་གཉི་ག་ཆུང་སྟེ་གླིང་གསུམ་གྱི་མི་རྣམས་ཀྱི་འདུག་གནས་བཞིན་ནོ།",
    "དེ་ལྟར་འཇིག་རྟེན་ཆགས་ནས་དུས་ཇི་སྲིད་གྲགས་པས་གནས་པ་དེ་སྲིད་དུ་འཆགས་པ་དང་འཇིག་པ་དང་ཞིག་ནས་འདུག་པ་སྟེ་སྟོངས་པ་དག་མཉམ་པས་བར་བསྐལ་ཉི་ཤུ་ཉི་ཤུའོ།",
    "དེ་སད་པའི་དོན་དུ་གྲུར་ཞུགས་ནས་ཆུའི་ནང་ན་འདུག་བཞིན་དུ་ཁྱིམ་བདག་ནོར་དགོས་སོ།",
    "དེ་དང་ལྷན་ཅིག་འདུག་མི་བྱ།",
    "རིགས་པ་ཡང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བའི་མཚན་ཉིད་མེད་པའི་ཕྱིར་ཏེ།",
    "འདི་ནི་ལོག་པའི་ཐུབ་པ་མི་སྨྲ་བར་འདུག་པ་ཙམ་དང་།",
    "དེར་འདུག་པ་ལ་སོགས་པའི་སྤྱོད་ལམ་བཟང་གྲགས་གྱི་རིག་བྱེད་ཡོད་པའི་ཕྱིར་རོ།",
    "དེས་ན་རྒྱུ་འབྲས་ཡོད་པ་དུས་མཉམ་ལ་སྐྱེ་འགག་དུས་མཉམ་དུ་བྱེད་པར་མ་ངེས་པར་ཁས་ལེན་ཏོ།",
    "དེ་ཡང་རང་རྒྱུད་ཀྱི་བདེ་བ་ལ་སོགས་ལ་ཉམས་སུ་མྱོང་བའི་མཐུས་བཟང་དམིགས་པའམ་མཚུངས་པར་ལྡན་པའི་སྒོ་ནས་སོ།",
    "འོ་ན་ནམ་མཁའ་ལ་སོགས་པ་ཡང་རང་དང་གོང་སའི་གཉེན་པོ་ལ་དམིགས་ཀྱི་འོག་སའི་གཉེན་པོ་ལ་ཅིའི་ཕྱིར་མི་དམིགས།",
    "གོང་ས་མེད་ཅིང་རང་ས་སྲེད་པ་རྒྱས་པ་དང་འོག་ས་དམན་པའི་ཕྱིར་རོ།",
    "སོགས་ཁོང་ནས་རྣམ་པ་དེ་གཉི་ག་མངོན་མཛོད་མ་ཡིན་པ་ཟོ་ཞིག་འདུག་ཅིག་པའམ་བུམ་པ་སྣམ་བུ་ལ་སོགས་པའི་རྣམ་པ་དུ་མ་ཡོད་པས་བསྟན་ཏོ་ཞེས་ཊིཀ་བྱེད་དག་འཆད་དོ།",
    "ཤཱ་རིའི་བུ་འདམ་བུའི་ཤོག་གཉིས་གནམ་དུ་སྒྲེང་སྟེ་ཕན་ཚུན་རྟེན་ཅིང་འདུག་པ་དེ་བཞིན་དུ་མིང་དང་གཟུགས་ཕན་ཚུན་རྟེན་ཅིང་གནས་སོ་ཞེས་ང་དང་རྣམ་པར་ཤེས་པའི་རྐྱེན་གྱིས་མིང་དང་གཟུགས་ཞེས་ཏེ།",
    "སྤྲིཏེན་བྷཱཛན་ཡོདཝཾབྷུཀྟ་པཱུདྡྷིད་བད་བ་ཆག་དེ་ལྟ་ནའང་རང་བཞིན་ལས་དེ་ཕན་གྱི་སྒྲུབ་པ་གཙོབོ་ཡིན་ནོ།",
    "རང་རང་བསྟང་བ་ཟུར་བྱོས་ཞེས།",
    "དེ་ཡང་རང་རང་ཡིད་ཀྱི་གཞིར།",
    "གཡོ་དང་རང་བཞིན་ཉིད་ཀྱི་སྟོང་པ་ནི།",
    "འདི་ན་རང་རང་རྗེས་སུ་སྒྲོ་འདོགས་པའི།",
    "བཞིན་བཟང་ཞིང་ལྟ་ན་སྡུག་པ་ཁོ་ན་འདུག་སྟེ།",
    "ཡོད་ན་ངོ་མཚར་ཚད་ལས་འདས་པ་ཞིག་ཡོད་པར་འདུག་ཟེར།",
    "མི་ལ་རས་པ་ནི་ཚེ་གཅིག་ལུས་གཅིག་ལ་ཡོན་ཏན་གོང་མ་རྣམས་ལས་མི་ཞན་པ་ཡོད་པ་འདུག་ཟེར།",
    "གང་ལྟར་ནའང་འདི་རྣམས་ཀྱི་ཟེར་ལུགས་འདི་ང་ལ་ངར་ལྡུད་པར་འདུག་པས།",
    "ཀུན་རས་ཆུང་པ་ལ་མིག་འཛུམ་ཤིག་ཤིག་འདུག་སྐད།",
    "མཁའ་ལ་ནམ་ལངས་ཉི་མ་ཤར་འདུག་སྟེ།",
    "དེ་མཁའ་འགྲོའི་ལུང་བསྟན་ཡིན་པར་འདུག་སྟེ།",
    "དབུ་རུ་བྱང་ཕྱོགས་སུ་བྱུང་བའི་བརྡ་དེ་ཡང་འདི་ཞུ་བ་ལ་བསྐུལ་བར་འདུག་གཞན་ཡང་གདམས་ངག་ཅི་ཡོད་མི་ཤེས་པར་འདུག་པས་ཞུ་རུ་འགྲོ་གསུང་བ་ལ།",
    "དུས་ད་ལྟའི་བར་དུ་ཡང་ཕུ་ལ་ཧ་རིའི་རི་དང་ཤིང་རྣམས་བོད་ཀྱི་ཕྱོགས་ལ་མགོ་གུག་གེ་ཡོད་པར་འདུག་གསུངས་པ་ལྟ་བུའོ།",
    "ཡོད་ན་ངོ་མཚར་ཚད་ལས་འདས་པ་ཞིག་ཡོད་པར་འདུག་ཟེར།",
    "བཞིན་བཟང་ཞིང་བལྟ་ན་སྡུག་པ་ཁོ་ན་འདུག་སྟེ།",
    "དེ་ཐམས་ཅད་བདག་ལ་ཚིག་ནི་མི་སྨྲ་བར་དགའ་བའི་འཛུམ་དང་ལྡན་པས་མིག་ཕལ་ཆེར་ཚུར་ཅེར་ལྟ་ཞིང་འདུག་པ་ལས།",
    "ཡོད་ན་ངོ་མཚར་ཚད་ལས་འདས་པ་ཞིག་ཡོད་པར་འདུག་ཟེར།",
    "མི་ལ་རས་པ་ནི་ཚེ་གཅིག་ལུས་གཅིག་ལ་ཡོན་ཏན་གོང་མ་རྣམས་ལས་མི་ཞན་པ་ཡོད་པ་འདུག་ཟེར།",
    "གང་ལྟར་ནའང་འདི་རྣམས་ཀྱི་ཟེར་ལུགས་འདི་ང་ལ་ངར་ལྡུད་པར་འདུག་པས།",
    "ཀུན་རས་ཆུང་བ་ལ་མིག་འཛུམ་ཤིག་ཤིག་འདུག་སྐད།",
    "མཁའ་ལ་ནམ་ལངས་ཉི་མ་ཤར་འདུག་སྟེ།",
    "རས་ཆུང་པའི་ཐུགས་ལ་ཚེ་རིང་མཆེད་ལྔའི་བརྡ་དེ་རྣམས་ཀྱང་གོ་བར་འདུག་དགོངས་ནས།",
    "ང་རང་མི་ལ་རས་པ།",
    "ཡང་མི་ལ་མི་ལ་ད་ལན་པས་སྡུག་པ་དང་ཉེན་པ་མ་བྱུང་ཟེར་ཞིང་འདུག་པ་ལ།",
    "ད་ལན་བུར་སྐྱེས་ཡོད་འདུག་པ་དེ།",
    "མི་རྣམས་ཀྱིས་ཐོས་པ་དགའ་དེ་མིང་བཏགས་ལེགས་ཤིག་བྱུང་འདུག་ཟེར་བ་བྱུང་།",
    "དེའི་གཟུགས་ལ་སོགས་པའི་ཡོན་ཏན་ཐོས་པས་སེམས་ཕྲོགས་པ་དང་འདུག་གོ།",
    "དྲང་སྲོང་འགའ་ཞིག་སྒོ་ན་སྡོད་ཅིང་འདུག་གོ།",
