    "བཅོམ་ལྡན་འདས་དེ་ནི་མ་ལགས་སོ་ཞེས་བཀག་གོ།",
    "གལ་ཏེ་འདུས་བྱས་ཡིན་ན་ནི་ཕུང་པོ་ལྔ་ལ་སོགས་པ་འདི་དག་ལ་དམིགས་པར་འགྱུར་བ་ཞིག་ན་དམིགས་པར་མ་གྱུར་ཏོ།",
    "གལ་ཏེ་འདུས་མ་བྱས་པ་ཞིག་ཡིན་པ་ཁས་ལེན་ན་ཡང་།",
    "དེ་ལྟ་བུའི་རིགས་པ་ཡང་མེད་དོ་སྙམ་ནས་བཅོམ་ལྡན་འདས་དེ་ནི་མ་ལགས་སོ་ཞེས་དེ་ཡང་བཀག་གོ།",
    "གཟུགས་ལ་སོགས་པ་འདུས་བྱས་ཀྱི་ངོ་བོ་ཉིད་དམ།",
    "དེ་བཞིན་ཉིད་འདུས་མ་བྱས་ཀྱི་ངོ་བོ་ཉིད་དུ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདི་ལ་གཟུགས་ཀྱི་དེ་བཞིན་ཉིད་དམིགས་པར་ལྟ་ག་ལ་འགྱུར་ཞེས་བྱ་བ་ནི་གཟུགས་ཀྱི་དེ་བཞིན་ཉིད་ངོ་བོ་ཉིད་དུ་ག་ལ་འགྱུར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཀུན་རྫོབ་ཀྱི་སྒོ་ནས་ཕུང་པོ་ལ་སོགས་པར་བཏགས་པའི་ངོ་བོ་ཉིད་དུ་ཡོད་དོ་སྙམ་དུ་སེམས་ཏེ།",
    "དེའི་ཕྱིར་བཏགས་པ་དེ་ཡང་ཡོད་པ་མ་ཡིན་པར་བསྟན་ཏེ།",
    "སྨོན་པ་མེད་པའི་ཚིག་བླ་དགས་མི་དམིགས་པར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་གྱི་ཚིག་བླ་དགས་རྣམས་ཀྱིས་གདམས་སོ།",
    "ཀུན་རྫོབ་ཏུ་ཡང་མེད་པར་བསྟན་ནས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་དོན་དམ་པར་ཡོངས་སུ་མ་གྲུབ་པའི་གནས་སྐབས་ན་སུས་ཀྱང་ཅི་ཡང་མ་མཐོང་ལ་དེ་ཡང་གཞན་གྱིས་མི་མཐོང་ངོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེ་ནས་ཡང་ཐ་དད་པ་དེའི་གཏན་ཚིགས་སུ་དེ་ཅིའི་ཕྱིར་ཞེ་ན་འདུས་བྱས་མ་གཏོགས་པར་འདུས་མ་བྱས་གདགས་པར་མི་ནུས་སོ་ཞེས་གསུངས་སོ།",
    "འདུས་བྱས་རྣམས་ལ་འདུས་མ་བྱས་ཞེས་བྱ་བ་ཐ་དད་པ་ཅི་ཡང་མེད་དོ།",
    "དེ་ཡང་འདི་ལྟར་དེ་བཞིན་ཉིད་དེ་ཉིད་མ་དག་པའི་གནས་སྐབས་ན་ནི་འདུས་བྱས་ཞེས་བྱ་ལ།",
    "དེ་ཉིད་དག་པའི་གནས་སྐབས་ན་ནི་འདུས་མ་བྱས་ཞེས་བྱའོ།",
    "དཔེར་ན་ཆུ་སྔར་མ་དངས་པ་ལས་ཕྱིས་རབ་ཏུ་དངས་པར་གྱུར་པ་ལ་ཡང་ཆུ་དེ་ཉིད་ཅེས་བྱ་བ་དང་།",
    "ཇི་ལྟར་ནམ་མཁའ་སྤྲིན་ལ་སོགས་པས་དྲི་མ་ཅན་དུ་གྱུར་པ་ལ་ཕྱིས་དྲི་མ་མེད་པར་གྱུར་པ་ལ་ཡང་།",
    "འདུས་མ་བྱས་པ་རྣམས་ལ་ངོ་བོ་ཉིད་ཐ་དད་པ་མེད་དོ།",
    "ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་བས།",
    "དེའི་སེམས་ཞུམ་པར་མི་འགྱུར།",
    "ཀུན་ཏུ་ཞུམ་པར་མི་འགྱུར།",
    "ཡིད་ལ་འགྱོད་པ་སྐྱེ་བར་མི་འགྱུར་རོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དད་པ་དེ་ཡང་གནས་གསུམ་ལ་ལྷག་པར་འགྱུར་ཏེ།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་དང་།",
    "དེ་དང་མཚུངས་པར་ལྡན་པ་རྣམས་བསྟན་ཏོ།",
    "དེ་དང་མཚུངས་པར་ལྡན་པ་རྣམས་བསྟན་ཏོ།",
    "དེ་ལྟར་བརྩོན་པའི་གདམས་པ་ལྔ་པ་སྟེ་རྫོགས་པར་བྱས་ནས་དེའི་འོག་ཏུ་བརྩོན་པའི་ཡོན་ཏན་ཞེས་བྱ་བ་དྲུག་པ་བསྟན་པའི་ཕྱིར།",
    "ཡོངས་སུ་རྫོགས་པར་བྱ་བ་རྣམས་བསྒོམས་པས་ཡོངས་སུ་རྫོགས་པ་དང་།",
    "མངོན་སུམ་དུ་བྱ་བ་རྣམས་ཐོབ་པས་མངོན་སུམ་དུ་བྱས་པའོ།",
    "དེ་ལ་བཅོམ་ལྡན་འདས་གཟུགས་ཡོངས་སུ་རྟོགས་པར་འཚལ་བས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་ཡོངས་སུ་ཤེས་པའི་ཕན་ཡོན་བསྟན་ཏེ།",
    "ཆུང་ངུའི་གནས་སྐབས་ན་འདུ་ཤེས་ཀྱིས་ཀུན་ཏུ་ཤེས་པར་བྱེད་དོ།",
    "དེ་བས་ན་ནང་སྟོང་པ་ཉིད་ལ་དེ་སྟོང་པར་བྱ་བའི་ཕྱིར།",
    "སྟོང་པར་བྱ་བའི་ཕྱིར་མི་ཚོལ་ཏེ།",
    "དེ་ལྟར་སློབ་པའི་ཚེ་གཟུགས་ཤེས་པར་བྱ་སྟེ།",
    "ཡོངས་སུ་རྟོག་པ་དང་རྣམ་པར་རྟོག་པའི་མཚན་ཉིད་ཐམས་ཅད་ལས་འདས་པས་སེམས་ཀྱི་མཚན་ཉིད་མེད་པའི་ཕྱིར་སེམས་མ་ཡིན་པ་ཞེས་བྱའོ།",
    "དེ་བས་ན་སེམས་ཀྱི་རང་བཞིན་འོད་གསལ་བ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གལ་ཏེ་སྔོན་ལྡན་པར་གྱུར་ན་ནི་ཕྱིས་བྲལ་བར་ཡང་འགྱུར་བ་ཞིག་ན།",
    "འདི་ལྟར་སེམས་དེ་སེམས་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་གནས་བརྟན་རབ་འབྱོར་གྱིས་དེའི་གནས་སྐབས་ན་ཡང་སེམས་ཞེས་བྱ་བའི་སྒྲར་བརྗོད་པས་སེམས་དེ་སེམས་མ་ཡིན་པའི་མཚན་ཉིད་དུ་ཡོད་པར་གྱུར་ཏོ་སྙམ་ནས་དྲིས་པའོ།",
    "བརྗོད་དུ་མེད་པའི་བདག་ཉིད་དུ་རྣམ་པར་གནས་པ་ཤིན་ཏུ་ཡོངས་སུ་དག་པ་ལ་ཐ་དད་དུ་བརྗོད་པའི་དུས་ན་རྣམ་པ་གཞན་དུ་བརྗོད་དུ་མི་རུང་བའི་ཕྱིར།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུ་གང་སེམས་མ་ཡིན་པ་དེ་ལ་ཡོད་པའང་མེད་པས་དམིགས་པའམ་ཡོད་པར་འགྱུར་རམ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "སེམས་མ་ཡིན་པའི་གནས་སྐབས་ན་ཡོད་པའམ་མེད་པ་གཉིས་ཀར་ཡང་བརྗོད་པར་མི་བྱ་སྟེ།",
    "མཐའ་གཉིས་ལ་བརྟེན་པར་འགྱུར་བའི་ཕྱིར་རོ་སྙམ་དུ་དགོངས་པའོ།",
    "དེའི་ཕྱིར་ཚེ་དང་ལྡན་པ་རབ་འབྱོར་དེ་ནི་མ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "དེ་སྐད་གསུངས་པ་དང་གནས་བརྟན་ཤཱ་རིའི་བུས་གལ་ཏེ་ཡོད་པ་དང་མེད་པ་དག་མེད་ན།",
    "དེ་ལྟ་ན་ནི་སེམས་མ་ཡིན་པའི་མཚན་ཉིད་ཀྱང་མེད་པར་འགྱུར་ན།",
    "ཚེ་དང་ལྡན་པ་རབ་འབྱོར་སེམས་མ་ཡིན་པ་ཞེས་བྱ་བ་དེ་གང་ཡིན་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་རྟོག་པ་ཅན་ཡིན་པའི་ཕྱིར་དེ་ལ་སེམས་ཞེས་བྱ་བ་ད་ནི་དེ་ལྟ་བུ་མེད་པའི་ཕྱིར་སེམས་ཞེས་བྱ་བའི་དངོས་པོ་མེད་པ་ཙམ་ཞིག་ཁས་བླངས་ནས་སེམས་མ་ཡིན་ཞེས་བྱ་བ་བརྗོད་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར།",
