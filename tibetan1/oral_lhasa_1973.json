    "དེ་ལས་ངེས་པར་བྱར་རུང་བ་ནི་དཔེར་ན་སྨྱིག་གླང་ནི་བ་ལང་འདྲའོ་ཞེས་བྱ་བ་ལྟ་བུ་སྟེ།",
    "དེ་ལྟ་བུ་ཡང་མེད་པས་དཔེར་ཡང་ཞེས་བྱ་བ་གསུངས་སོ།",
    "རྗེས་སུ་དཔག་པ་དེ་ལྟ་བུ་ཡང་མེད་པས་རྒྱུར་ཡང་མི་ཕོད་ཅེས་བྱ་བ་གསུངས་སོ།",
    "དབེན་པ་ཞེས་བྱ་བ་ནི་རྣམ་པར་དག་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "མ་སྐྱེས་པ་ཞེས་བྱ་བ་ནི་འདུས་མ་བྱས་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་ཞེས་བྱ་བ་ནི་ངོ་བོ་ཉིད་ཐ་དད་པའོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་སྤྱོད་པས་ཞེས་བྱ་བས་ནི་སྤྱོད་པའི་ཆེ་བའི་བདག་ཉིད་བསྟན་ཏོ།",
    "འགྲེས་འདི་ལ་བདག་ཉིད་ཡོངས་སུ་སྨིན་པར་བྱ་བ་དང་།",
    "དེ་དག་ལས་འདས་ནས་ས་བརྒྱད་པ་ལ་ཕྱིར་མི་ལྡོག་པར་འགྱུར་ཏེ།",
    "དེ་ལྟར་ཇི་ལྟར་བརྩོན་པར་བྱ་བ་བསྟན་ནས།",
    "དེ་ནི་བརྩོན་པར་བྱེད་པ་རྣམས་ཀྱི་མཚན་ཉིད་གང་ཡིན་པ་ཞེས་བྱ་བ་དེ་བསྟན་པའི་ཕྱིར།",
    "བརྩོན་པར་བྱ་བ་བརྩམས་པའི་ཕྱིར་བརྩོན་པ་མ་ཡིན་ནོ་ཞེས་ཀྱང་བརྗོད་པར་མི་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིར་བརྩོན་ཞེ་འམ་མི་བརྩོན་ཞེས་མི་བརྗོད་དོ་ཞེས་གསུངས་སོ།",
    "འོ་ན་ཇི་ལྟར་ན་བརྩོན་པ་ཡིན་སྙམ་དུ་ཐེ་ཚོམ་ཟ་བ་ལ་དེ་ཅིའི་ཕྱིར་ཞེ་ན་ཞེས་བྱ་བ་གསུངས་སོ།",
    "དེ་ལྟར་རྣམ་པར་དཔྱད་ན་དོན་དམ་པར་སྐྱེ་བ་མེད་དེ།",
    "འདི་ལྟར་སྐྱེས་པ་ནི་འགག་པར་འགྱུར་གྱི་མ་སྐྱེས་པ་ནི་འགག་པར་མི་འགྱུར་རོ།",
    "དེ་ལ་ཡོད་ན་ནི་འགག་པར་མི་འཐད་དེ།",
    "མེད་པ་ཡང་འགག་པར་མི་འཐད་དེ་མེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ཐ་སྙད་ཙམ་དུ་ཟད་ཀྱི་དོན་དམ་པར་ནི་མེད་དོ།",
    "རྣམ་པར་བྱང་བར་མི་འཐད་དེ།",
    "ངོ་བོ་ཉིད་ནི་བཏང་བར་མི་ནུས་པའི་ཕྱིར་ནམ་ཡང་རྣམ་པར་བྱང་བར་མི་འགྱུར་རོ།",
    "རྣམ་པར་དག་པ་ལས་འགྱུར་གྲང་ན།",
    "རྣམ་པར་དག་པ་ལས་འགྱུར་གྲང་ན།",
    "རྣམ་པར་དག་པ་ཡང་རྣམ་པར་བྱང་བར་མི་རིགས་ཏེ།",
    "རྣམ་པར་དག་པས་དོན་མེད་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་བྱང་བ་དོན་དམ་པར་ཡོད་པ་མ་ཡིན་གྱི།",
    "ད་ནི་གཟུགས་ནི་ཚོར་བ་དང་ལྷན་ཅིག་ཡང་དག་པར་འདུ་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་ཞེས་བྱ་བ་ལ་སོགས་པས་འདུས་པ་ལ་ཕུང་པོའི་མཚན་ཉིད་མེད་པར་སྟོན་ཏེ་ཕུང་པོ་ཞེས་བྱ་བ་ནི་སྤུངས་པ་ཞེས་བྱ་བའི་དོན་ཡིན་ལ།",
    "སྤུངས་པ་ཡང་དག་པར་འདུ་བ་ཡོད་ན་སྲིད་པར་འགྱུར་ན།",
    "དེ་བཞིན་དུ་ཚོར་བ་ལ་སོགས་པ་ཡང་གཟུགས་དང་ལྷན་ཅིག་ཡང་དག་པར་འདུ་བ་མི་རིགས་སོ།",
    "རྣམ་པར་ཤེས་པ་རྣམས་ཀྱང་མཚན་ཉིད་སོ་སོ་ཐ་དད་དེ།",
    "མཚན་ཉིད་སོ་སོ་ཞིང་ཤིན་ཏུ་ཐ་དད་པ་དེ་དག་ཇི་ལྟར་ཕུང་པོའི་ངོ་བོ་ཉིད་གཅིག་ཏུ་ཡང་དག་པར་འདུ་བར་འགྱུར།",
    "སྒྱུ་མ་ལྟ་བུ་ཡིན་པར་རང་བཞིན་གྱིས་སྟོང་ངོ།",
    "དེ་ལ་ཇི་ལྟར་སྒྱུ་མའི་དངོས་པོ་རྟ་དང་གླང་པོ་ཆེ་ལ་སོགས་པ་དོན་དམ་པར་གཅིག་ཏུ་འདུ་བ་མེད་པ་དེ་བཞིན་དུ་ཀུན་བརྟགས་པའི་གཟུགས་ལ་སོགས་པ་ཡང་གཅིག་ཏུ་འདུ་བ་མེད་དོ།",
    "འདི་ནི་སྒོ་ཙམ་ཞིག་བསྟན་པར་ཟད་དེ།",
    "འདུ་བྱེད་ནི་རྣམ་པར་ཤེས་པ་དང་ལྷན་ཅིག་འདུ་བ་མེད།",
    "རྣམ་པར་ཤེས་པ་ཡང་འདུ་བྱེད་དང་ལྷན་ཅིག་འདུ་བ་མེད་དོ་ཞེས་བྱ་བར་སྦྱར་བར་བྱའོ།",
    "ཤཱ་རིའི་བུ་འདི་ལྟར་གཟུགས་ཀྱི་སྟོང་པ་ཉིད་གང་ཡིན་པ་དང་གཟུགས་སུ་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་གསུངས་ཏེ།",
    "འདི་ལྟར་སྟོང་པ་ཉིད་དེ་ལ་རྣམ་པར་ཤེས་པར་བྱེད་པ་མེད་དེ།",
    "དེའི་ཕྱིར་རྣམ་པར་ཤེས་པ་མ་ཡིན་ནོ།",
    "འོ་ན་ནི་གཟུགས་ལ་སོགས་པའི་སྒྲ་ཡུལ་མེད་པར་འགྱུར་རོ་སྙམ་དུ་ཐེ་ཚོམ་ཟོས་ནས།",
    "མི་བརྩོན་ཞེས་བྱ་བའི་རྣམ་པར་རྟོག་པ་ཡོངས་སུ་སྤང་བ་དང་།",
    "མི་བརྩོན་པའི་རྣམ་པར་རྟོག་པ་ཡོངས་སུ་སྤང་བ་དང་།",
    "མི་བརྩོན་པའི་རྣམ་པར་རྟོག་པ་ཡོངས་སུ་སྤང་བ་དང་།",
    "འདུ་བ་དང་བྲལ་བའི་རྣམ་པར་རྟོག་པ་ཡོངས་སུ་སྤང་བ་དང་།",
    "སྟོང་པ་ཉིད་ལ་སྦྱོར་བའི་རྣམ་པར་རྟོག་པ་ཡོངས་སུ་སྤང་བ་སྟེ།",
    "མི་བརྩོན་ཞེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ཞེས་བྱ་བ་ནི་བདག་ལ་བྱེད་པ་པོ་ལ་སོགས་པར་རྣམ་པར་རྟོག་པ་མེད་པ་དང་།",
    "རྣལ་འབྱོར་མ་ཡིན་པ་ཡང་མ་ཡིན་ཞེས་གསུངས་ཏེ།",
    "འདི་ལྟར་སྔོན་གྱི་མཐའ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་ཞེས་གཏན་ཚིགས་ཀྱང་ཉིད་ཀྱིས་གསུངས་སོ།",
    "སྔོན་གྱི་མཐའ་ལ་སོགས་པ་དུས་གསུམ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་སྟེ།",
    "ཡང་དག་པར་རྗེས་སུ་མ་མཐོང་ན་ཇི་ལྟར་སྦྱར་བར་བྱ།",
    "སྔོན་གྱི་མཐའི་ལས་དེའི་རྣམ་པར་སྨིན་པ་ནི་ད་ལྟར་བྱུང་བ་ན་འདི་ཡིན་ནོ་ཞེས་རྣམ་པར་རྟོག་པ་ལ་སྤྱོད་ན་སྔོན་གྱི་མཐའ་དང་ད་ལྟར་བྱུང་བར་སྦྱོར་བ་དང་།",
    "ད་ལྟར་བྱུང་བ་ན་ལས་བྱས་པས་ཕྱི་མའི་མཐར་རྣམ་པར་སྨིན་པར་འགྱུར་རོ་ཞེས་སྤྱོད་ན།",
    "དེ་བས་ན་དུས་གསུམ་མཉམ་པ་ཉིད་ཀྱི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་སོ།",
    "གཟུགས་དང་འདས་པར་མི་སྦྱོར་ཞེས་བྱ་བ་བཀའ་སྩལ་ནས་འདི་ལྟར་འདས་པ་ཉིད་ཀྱང་ཡང་དག་པར་རྗེས་སུ་མི་མཐོང་ངོ་ཞེས་བྱ་བ་ཉིད་ཀྱིས་གཏན་ཚིགས་གསུངས་ཏེ།",
    "འཇིག་པར་ལྟ་བ་དག་ནི་རྟག་པ་དང་ཆད་པར་ལྟ་བ་སྟེ་དེ་མི་སྐྱེད་དོ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཞི་ཞེས་བྱ་བར་མི་སྦྱོར་རོ་ཞེས་བྱ་བ་དེ་ལྟ་དེ་ལྟ་བུའི་རྟོག་པའི་སྐབས་མེད་པའི་ཕྱིར་རོ།",
    "སྨོན་པ་མེད་པ་རྣམས་ནི་རྣམ་པར་རྟོག་པ་རྣམས་ཀྱི་སྐབས་མེད་པ་ཉིད་དོ།",
    "སྤྱོད་ཅེས་བྱ་བ་ལ་སོགས་པའི་རྣམ་པར་རྟོག་པ་རྣམས་ལ་ཡང་དེ་བཞིན་དུ་སྦྱར་རོ།",
    "ཕྲད་པའམ་མི་ཕྲད་པར་འགྱུར་བ་ཞེས་བྱ་བས་ནི་དེ་གཉིས་ཀྱི་ལས་བསྟན་ཏོ།",
    "ལུང་བསྟན་པར་འོས་པའི་ཕྱིར་ལུང་བསྟན་པ་ཉེ་བར་གྱུར་ཏོ།",
    "དེ་གང་ནས་ཤི་འཕོས་ཏེ་འདིར་སྐྱེས་པ་ལགས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཞུས་སོ།",
    "བར་མ་ནི་དགའ་ལྡན་ནས་ལྷགས་པར་འགྱུར་རོ།",
    "ཐ་མ་ནི་མིའི་ནང་ཉིད་ནས་ལྷགས་པར་གྱུར་ཏོ་ཞེས་རྣམ་པ་གསུམ་དུ་བསྟན་ཏོ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྤྱོད་པ་ལ་བརྩོན་ཡང་ཐབས་མི་མཁས་པར་གྱུར་པའི་ཕྱིར་ལྷ་ཚེ་རིང་པོར་སྐྱེས་ཏེ།",
    "སྙོམས་པར་འཇུག་པ་རྣམས་ཐོབ་ནས།",
    "རྩོལ་བ་ཆུང་ངུས་ས་དང་པོ་ཐོབ་པར་བྱས་ནས།",
    "བཅུ་བཞི་པ་དག་ནི་རྣམ་པར་མི་རྟོག་པའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་ཏེ་ཐོད་རྒལ་དུ་སྙོམས་པར་འཇུག་པ་ལ་མཉམ་པར་བཞག་ནས་སྙོམས་པར་འཇུག་པ་དེ་རྣམས་ཀྱིས་གནས་པར་བྱེད་དོ།",
    "ཡོངས་སུ་འདྲིས་པའི་ཤེས་པས་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ལ་སོགས་པ་ཡོངས་སུ་ཤེས་པར་བྱས་ཀྱང་དེ་དག་མངོན་སུམ་དུ་མི་བྱེད་པར་གཞན་དག་ཀྱང་ལམ་དང་འབྲས་བུ་དེ་དག་ལ་སོ་སོར་འགོད་དོ།",
    "སྐྱེ་བོ་མང་པོ་དགའ་བར་བྱས་ནས།",
    "གཞན་ལ་སྨོད་པར་མི་བྱེད་པར་བཏང་སྙོམས་སུ་གནས་པས་ལྷུར་བླངས་ཏེ་གནས་སོ།",
    "ཁ་ན་མ་ཐོ་བ་དང་བཅས་པའི་ལུས་དང་ངག་དང་ཡིད་ཀྱི་ལས་རྣམས་ཀྱི་གོ་མི་དབྱེའོ་ཞེས་གསུངས་སོ།",
    "བཅོམ་ལྡན་འདས་ལུས་ཀྱི་ལས་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པ་གང་ལགས་ཞེས་བྱ་བ་ལ་སོགས་པ་ཞུས་སོ།",
