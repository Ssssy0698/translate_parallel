    "སེམས་སྡུས་ཤིག་ཅེས་བྱ་བ་སྔགས་དག་བསྡུ་བར་རིག་པར་བྱའོ།",
    "དེ་ནི་ཟུར་ཆག་པ་ཡིན་པས་དེ་ལྟར་བྱེད་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དགེ་སློང་ཞེས་བརྗོད་པར་བྱ་བ་ལ་དགེ་སློང་མ་ཉིད་དུ་བརྗོད་པ་དང་།",
    "དགེ་སློང་མ་ཞེས་བརྗོད་པར་བྱ་བ་ལ་དགེ་སློང་ཉིད་དུ་བརྗོད་པ་ལ་སོགས་པ་ནི་ལས་མི་འཆགས་པ་མ་ཡིན་པའོ།",
    "མཚན་གཞན་བརྗོད་པས་ནི་ལས་མི་འཆགས་པར་མི་འགྱུར་ཏེ།",
    "རྗོད་པ་ལ་ཉེས་བྱས་སུ་ནི་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་བསྙེན་པར་རྫོགས་པར་བྱ་བའི་ལས་ལ་དགེ་སློང་མ་རྣམས་ཀྱི་བསྙེན་པར་རྫོགས་པར་བྱ་བའི་ལས་ཀྱི་ཆོ་ག་གང་ཡིན་པ་དེ་བྱེད་ན་ཉམས་པ་ཅུང་ཟད་ཀྱང་མེད་ཀྱི།",
    "ཡོད་པར་ཟད་དེ།",
    "དེ་ལྟར་ཡང་དགེ་སློང་རྣམས་ལས་དགེ་སློང་མས་བསྙེན་པར་རྫོགས་པ་དག་དགེ་སློང་མའི་དངོས་པོ་བཙལ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "བསྙེན་པར་རྫོགས་པར་བརྗོད་པར་བགྱིའམ།",
    "བསྙེན་པར་རྫོགས་པར་བྱེད་པ་དག་ལ་ནི་འགལ་ཚབས་ཅན་དུ་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "གཞི་མ་ཞི་བར་ཤེས་ནས་གླེང་བ་པོས་སོ་སོར་ཤེས་པར་བྱས་ཤིང་མངོན་སུམ་དུ་འཇོག་པ་ལ་ནན་ཐུར་གྱི་ལས་བྱའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གླེང་བ་པོས་ཀྱང་རྒྱུ་འཐབ་ཀྲོལ་བྱེད་པ་ཉིད་ལ་སོགས་པ་དེ་ལེགས་པར་སོ་སོར་ཤེས་པར་བྱས་ཤིང་།",
    "འོན་ཏེ་གླེང་བ་པོ་བསླང་སྟེ་འཇུག་པར་བྱ་ཞེ་ན།",
    "འགྲོ་འགྱོགས་དང་ནབ་སོ་གཉིས་ཀྱི་གླེང་བ་པོ་དགེ་སློང་བསྐོ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འོག་ཏུ་བཞག་ཅིང་བཤུད་བ་ཉིད་དུ་རྣམ་པར་གཞག་པར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གླེང་བ་པོས་སོ་སོར་ཤེས་པར་བྱས་ཤིང་མངོན་སུམ་དུ་འཇོག་ན་ཞེས་སྨོས་པ་དེ་གཉིས་ཀྱི་དམིགས་ཀྱིས་བསལ་བ་ཡིན་ཏེ།",
    "འདི་ལྟར་གལ་ཏེ་མངོན་སུམ་ཉིད་མི་སྟེར་ན་དེའི་ཚེ་སོ་སོར་ཤེས་པར་བྱ་བ་ལ་སོགས་པ་བྱར་མི་ནུས་པས་དེའི་ཕྱིར་འཐབ་ཀྲོལ་བྱེད་པ་ཉིད་ལ་སོགས་པ་རྒྱུ་གྲགས་པ་ཙམ་གྱིས་མངོན་སུམ་གྱི་དངོས་པོ་མི་བསལ་བར་བསྡིགས་པ་ལ་སོགས་པའི་ལས་བྱའོ།",
    "ཡོད་པ་ཉིད་རྣམ་པར་བཤིག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི།",
    "གང་སྐབས་འབྱེད་པར་མི་བྱེད་པ་དེ་ལ་ཇི་ལྟར་བྱས་ཀྱང་སྐབས་རྙེད་ཅིང་གླང་བ་ལ་ཁས་བླང་ངོ་སྙམ་དུ་སེམས་པར་མི་འགྱུར་བས་དེའི་ཕྱིར་རྒྱུ་གཉིས་པ་དེས་ཀྱང་མི་རིགས་སོ།",
    "གླེང་བ་པོ་རང་མ་ལངས་ན་བསྐོ་བས་བསླང་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ནན་ཐུར་བྱས་པ་ཇི་ལྟར་གྱུར་པ་ལ་བཟོད་པར་བྱ་བ་དེ་བསྟན་པའི་ཕྱིར་རོ།",
    "གནས་མེད་པར་བྱ་བར་སེམས་པ་ཉིད་དང་བླའི་གྲྭ་དང་འོག་གཟུ་དང་ཉེ་དུའི་གང་ཟག་རྟེན་ཉིད་དང་།",
    "མཚུངས་པར་ཉེ་བར་སྟོན་པ་དང་།",
    "གནས་མེད་པར་བྱ་བར་སེམས་པ་ཉིད་མི་འཛིན་པ་དང་།",
    "ཆོ་ག་མ་ཡིན་པ་སྤྱོད་པར་མི་བྱེད་པ་དང་།",
    "སྟེགས་ཅན་ལ་བརྟེན་པ་དང་ཆོག་མ་ཡིན་པར་སྤྱོད་པར་མི་བྱེད་པ་ཞེས་བྱ་བ་ནི་མུ་སྟེགས་ཅན་ལ་རྟེན་པར་མི་བྱེད་པ་དང་།",
    "སྤྱོད་པ་དང་སྤྱོད་ལམ་གྱི་རྣམ་པར་གཞག་པ་ཆོ་ག་མ་ཡིན་པ་དག་སྤྱོད་པར་མི་བྱེད་པ་སྟེ།",
    "སྐྲ་འགྲེང་བར་འགྱུར་བ་ཞེས་བྱ་བ་ནི་སྐྱ་དག་གྱེན་དུ་རྣམ་པར་འགྲེང་བར་གྱུར་པ་ཉིད་དོ།",
    "སྐྲ་འཕྱར་བར་གྱུར་བ་ཞེས་བྱ་བ་ནི་སྐྲ་དག་ཐད་ཀར་རྣམ་པར་འཕྱར་བར་གྱུར་པ་ཉིད་དོ།",
    "དེ་སྒྲུབ་པར་བྱེད་པ་ནི་བསྐྱོད་པ་ཞེས་བྱ་སྟེ།",
    "མཚུངས་པར་ཉེ་བར་སྟོན་པ་ཞེས་བྱ་བ་ལ་མཚུངས་པ་ཞེས་བྱ་བ་ནི་ཡང་དག་པ་ཉིད་དུ་གྱུར་པར་འཇུག་པ་སྟེ།",
    "བདག་དགེ་སློང་དམར་སེར་ཅན་འཐབ་ཀྲོལ་བགྱིད་པ་མཚང་འདྲུ་བར་བགྱིད་པ་རྩོད་པར་བགྱིད་པ་འགྱེད་པར་བགྱིད་པ་རྩོད་པའི་གཞི་འགྱེད་པ་ལགས་ཏེ།",
    "རྩོད་པར་བགྱིད་པ་འགྱེད་པར་བགྱིད་པ་རྩོད་པའི་གཞི་བགྱིད་པ་ལགས་ཏེ།",
    "ཞར་ལ་གཞན་བརྗོད་པར་བྱ་སྟེ།",
    "ལས་སྤྱིན་པ་དང་དབྱུང་བ་དང་བསྙེན་པར་རྫོགས་པར་བྱ་བ་དང་གཞག་པ་དང་བསྲང་བ་ཡང་ངོ་ཞེས་བྱ་བ་ནི།",
    "འཐབ་ཀྲོལ་བྱེད་པ་ལ་ལས་ཀྱིས་བསྡིགས་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གང་ཟག་འཐབ་ཀྲོལ་བྱེད་པ་ལ་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་བསྡིགས་པར་བྱའོ།",
    "དགེ་སློང་དམར་སེར་ཅན་འདི་དག་ནི་འཐབ་ཀྲོལ་བགྱིད་པར་མཚང་འདྲུ་བར་བགྱིད་པ་རྩོད་པར་བགྱིད་པ་འགྱེད་པར་བགྱིད་པ་རྩོད་པའི་བཞི་བགྱིད་པ་ལགས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "ཁྱིམ་སུན་འབྱིན་པ་མ་བཏང་བ་ལ་ནི་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་བསྐྲད་པར་བྱའོ།",
    "བསྐྲད་པར་བྱ་བ་དེའི་ཕྱིར་འདུ་བ་མི་སྦྱིན་པ་དང་།",
    "གལ་ཏེ་ཁྱིམ་སུན་འབྱིན་པར་བྱེད་པ་དེ་བསྐྲད་པའི་ལས་བྱ་བའི་ཕྱིར།",
    "ཕྱིར་འགྱེད་པའི་ལས་འདི་ལ་བཟོད་པ་གསོལ་བའི་ལས་ཀྱི་གནས་སུ་ཁྱིམ་པ་དེ་ལ་བཟོད་པ་གསོལ་དུ་གཞུག་པ་ཡིན་པར་བལྟ་བར་བྱ་བའོ།",
    "འོན་ཀྱང་གསོལ་བ་བྱས་ཏེ་དེ་ཁྱིམ་པ་ལ་བཟོད་པ་གསོལ་དུ་གཞུག་པར་བྱ་སྟེ།",
    "ཁྱིམ་པས་བཟོད་པ་ཉིད་བཟོད་པ་བྱས་པར་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "མ་མཐོལ་མ་བཤགས་ན་ནི་མི་འགྱུར་རོ།",
    "ལེགས་སོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཉེ་བ་འཁོར་མི་བྱའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་བ་ཡིན་ནོ།",
    "འདིར་གཞུང་ནི་བདག་ལ་ཕམ་པར་འགྱུར་བ་བྱུང་ངོ་ཞེ་འམ།",
    "སོ་སོར་བཤགས་པར་བྱ་བའི་རིགས་བརྗོད་པ་མ་བྱས་བ་གང་ཡིན་པ་དང་།",
    "ཉེས་བྱས་ནི་གང་ཡང་རུང་བས་སོ་ཞེས་བྱ་བ་ནི།",
    "དེ་དག་གང་ལ་རིག་པར་བྱ་བ་ཉིད་ཡིན་ཞེ་ན།",
    "གལ་ཏེ་ལྟ་བ་ཐ་མི་དད་པ་ཡིན་ན་དེའི་ཚེ་དེའི་མདུན་དུ་རིག་པར་བྱ་བ་ཉིད་ཡིན་པའོ།",
    "དེའི་ཕྱིར་བསྙེན་པར་རྫོགས་པ་དང་བཅས་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེ་ལ་རིག་པར་བྱ་བ་ཉིད་ཡིན་ནོ།",
    "དགེ་སློང་མས་ཀྱང་དགེ་སློང་ལ་རིག་པར་བྱ་བ་ཉིད་ཡིན་ནམ་ཞེ་ན།",
    "བཤགས་པར་བྱ་བའམ་ཞེ་ན།",
    "དེའི་ཕྱིར་དགེ་ཚུལ་ལ་སོགས་པའི་བྱ་བ་ཐམས་ཅད་ནི་བསྙེན་པར་རྫོགས་པ་ཉིད་ལ་རག་ལས་པ་ཁོ་ན་ཡིན་པར་རྣམ་པར་གནས་སོ།",
    "དེ་ལ་རིག་པར་བྱས་ན་བཅབས་པར་མི་འགྱུར་རོ།",
    "འོ་ན་དེ་ལྟན་བསྙེན་པར་རྫོགས་པ་དང་བཅས་པ་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་ངེས་པར་ཅིའི་ཕྱིར་བྱས་ཤེ་ན།",
    "མ་བརྗོད་པ་བརྗོད་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "དེས་ན་མཚན་མི་མཐུན་པ་བསྙེན་པར་རྫོགས་པ་དག་ལ་རིག་པར་བྱེད་ན་ཡང་བཅབས་པར་ནི་མི་འགྱུར་ལ།",
    "རིག་པར་བྱེད་པ་ལས་ཉེས་བྱས་སུ་ནི་འགྱུར་རོ།",
    "བསྙེན་པར་མ་རྫོགས་པ་དག་ལ་རིག་པར་བྱེད་པ་དག་ལ་ནི་བཅབས་པར་ནི་མི་འགྱུར་ལ།",
    "གནས་ངན་ལེན་མ་ཡིན་པ་བརྗོད་པ་ལས་ནི་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "འདིར་རྣམ་པར་གཞག་པ་ནི་དེ་ཡིན་ནོ།",
    "བརྗོད་པ་ལ་ཉེས་བྱས་སུ་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་རྗོད་པར་བྱེད་ན་དེ་ལྟ་ན་ལེགས།",
