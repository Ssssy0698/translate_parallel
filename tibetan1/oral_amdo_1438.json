    "རིམ་པ་དེ་རྣམས་རགས་པ་དང་གཉུག་མའི་ལུས་གཉིས་སོ་སོར་འབྱེད་བྱེད་དུ་ངང་གིས་འགྲོ་བ་དེ་བཞིན་དུ།",
    "དེ་ཉིད་རྡོ་རྗེ་འཆང་གི་སྐུར་བསྐྱེད་པ་ནི་བྱིན་གྱིས་བརླབས་པའོ།",
    "སློབ་པའི་ཟུང་འཇུག་གི་སྒྱུ་མའི་སྐུ་ཐོབ་ཕྱིན་ཆད་ནས་དེའི་རིགས་འདྲ་མི་འཆད་པས་དངོས་པོ་ལ་གནས་པ་ཞེས་བྱ་ལ།",
    "ལུགས་མཐུན་དང་ལུགས་ལྡོག་གི་སྟོང་པ་རྣམས་ཀྱི་མཚམས་གང་དུ་སྒྱུ་མའི་སྐུ་སྒྲུབ་པ་ཡབ་སྲས་ལྔའི་གཞུང་ནས་མི་གསལ་ལོ།",
    "འོད་གསལ་གྱི་ངང་ནས་ཆུ་ལས་ཉ་བཞིན་དུ་ཅིག་ཅར་དུ་རྡོ་རྗེ་འཆང་གི་སྐུར་ལངས་པ་ནི་ཅིག་ཅར་གྱི་རིམ་པ་དང་།",
    "དེ་ལས་སྣང་བར་སོང་བའི་མཚམས་ནས་རྡོ་རྗེ་འཆང་གི་སྐུར་ལངས་པ་ནི།",
    "རང་གི་ལུགས་ནི་ཟུང་འཇུག་གི་སྐབས་སུ་འཆད་པར་འགྱུར་རོ།",
    "སྐད་ཅིག་གིས་གཡོ་བ་ནི་སྨིག་རྒྱུ་ལྟ་བུའོ།",
    "མཁའ་ལ་སྐད་ཅིག་དག་གིས་རྙེད།",
    "དཔག་ཚད་བརྒྱ་ཡི་ཁྱོན་ཙམ་དུ།",
    "རྡོ་རྗེ་འབར་བའི་འོད་དག་གིས།",
    "དཔག་ཚད་བརྒྱའི་ཁྱོན་ཙམ་དུ་རྒྱ་ཆེ་བའི་ཚད་དང་གྲངས་མེད་པའི་འཇིག་རྟེན་གྱི་ཁམས་རྡོ་རྗེ་འབར་བ་སྟེ་རང་གི་སྐུའི་འོད་ཀྱིས་སྣང་བར་བྱེད་པ་དང་།",
    "འཇམ་དཔལ་གྱི་ཕྱག་རྒྱ་ཆེན་པོ་དེ་ནི་སོ་སོ་སྐྱེ་བོ་རྣམས་ཀྱིས་མི་མཐོང་ཞིང་མི་རེག་པས་ན།",
    "ཡོན་ཏན་འདི་དག་གི་ཕྱོགས་ཙམ་ཡང་མེད་པའི་ཏིང་ངེ་འཛིན་འགའ་ཞིག་ལ།",
    "དེ་ཡང་མ་ནིང་གི་ཡི་གེ་བཞི་མི་ཤིགས་པའི་ཐིག་ལེ་ལ་ཐིམ་པས་ཐིག་ལེ་ལྷ་སྐུར་འཆར་བ་ཡིན་ཏེ།",
    "ཕན་ཚུན་ཞལ་སྦྱར་བས་སྣང་སྟོང་གི་རོ་བདེ་བར་ཤར་བའོ།",
    "སྨིག་རྒྱུ་ནས་མུན་ནག་གི་རྣམ་པ་ལྟ་བུའི་བར་རྣམས་འབྱུང་།",
    "དེ་ནས་དེ་མི་གསལ་བར་ནག་ཐིབ་སྟེ་སོང་བ་ཉེར་ཐོབ།",
    "བོད་སྔ་མ་འགའ་ཞིག་གིས་ཡུལ་གང་ལ་ཡང་བལྟས་པ་ན།",
    "དེ་ནས་དེ་ཕྲ་རུ་སོང་བ་མཆེད་པ།",
    "བསྒོམས་པའི་ཡིད་ངོར་སྣང་བའི་ཨ་ཡིག་གི་གཟུགས་དེ་ཙམ་ལ་བྱེད་དུ་མི་རུང་བས།",
    "དེ་ཡང་སྟོང་པ་རྣམས་ཤར་བའི་བདེ་སྟོང་གི་ཉམས་ལས།",
    "རང་གིས་སྔར་སྟོང་པའི་ཡེ་ཤེས་ཀྱི་བདེ་སྟོང་གི་ཉམས་ལས།",
    "རང་གི་རྩ་ཚིག་དང་ཡང་འགལ་བར་སྣང་ངོ།",
    "རྡོ་རྗེ་འཆང་གི་སྐུ་བྲིས་པའི་གཟུགས་བརྙན་ཡིན་གྱི།",
    "དེ་དག་གིས་ནི་སྐུ་བསྒོམ་མོ།",
    "སྣང་བ་དེ་དང་དེ་རྣམས་སྒྱུ་མ་བཞིན་དུ་འཆར་མོད་ཀྱང་།",
    "ཀླུ་བྱང་གིས།",
    "སྤྱོད་བསྡུས་མ་གཏོགས་པ་ཡབ་སྲས་གཞན་གང་གི་གཞུང་ནའང་མེད་དོ།",
    "སྤྲོས་པ་མེད་པའི་སྤྱོད་པ་ལ་ལྟོས་པ་མེད་པར་ཤིན་ཏུ་མྱུར་བར་འདིར་རང་གི་གཟུགས་ཡོངས་སུ་བརྗེ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "འཕགས་པ་ལྷས་ཀླུའི་མན་ངག་གིས་གསལ་བར་མཛད་པས་ཤེས་ལ།",
    "གཉིད་དང་འོད་གསལ་བསྲེ་བའི་གདམས་པའི་མཆོག་ནི་གང་ཟག་རབ་ཚེ་འདིར་འཚང་རྒྱ་བ་ལ་དགོངས་པ་ཡིན་མོད་ཀྱང་།",
    "སྤྱོད་བསྡུས་ལས་གསུངས་པའི་གཉིད་དང་སྟོང་པ་བཞི་བསྲེ་ཚུལ་དེ་བཞིན་དུ་འོག་མའི་གང་ཟག་གིས་མི་ནུས་ཀྱང་།",
    "ཡུལ་ཕྱོགས་གཞན་དག་ཏུ་སོང་ནས་འདོད་པའི་ཡོན་ཏན་ལྔ་ཉམས་སུ་མྱོང་སྟེ།",
    "ཡུལ་ཕྱོགས་གཞན་དུ་སོང་ནས་ཡང་ལུས་སྔ་མ་འདིར་འོང་བ་དེ་ཅིའི་ཕྱིར་འོང་ཞེས་སླར་དེ་ལ་འཇུག་པའི་རྒྱུ་དྲིས་སོ།",
    "སོགས་ཀྱི་སྒྲས་བསྡུས་པ་དེ་དག་གི་ལྷག་མ་རྣམས་སོ།",
    "གཉིད་ལོག་དུས་ཡུལ་གཞན་དུ་སོང་བའི་རྨི་ལམ་གྱི་ལུས་དང་།",
    "ཟུང་འཇུག་གི་སྒྱུ་མའི་སྐུ་ལ་ཡང་འོད་གསལ་གྱི་སྟོང་པ་སྔོན་དུ་འགྲོ་དགོས་པའི་ཕྱིར་དང་།",
    "ལྷག་མོས་འོད་གསལ་དུ་བསྡུས་པ་ལས་དང་པོའི་མགོན་པོ་སྐྱེད་པ་སོགས་ཐམས་ཅད་ཀྱི་གོ་རིམ་དེ་ལྟར་ཡིན་པའི་ཕྱིར་རོ།",
    "གཉིད་དུ་འགྲོ་ཁར་སད་དུས་ཀྱི་ཏིང་ངེ་འཛིན་མངོན་དུ་གྱུར་ནས་དེའི་འཕྲོ་ལ་གཉིད་དུ་སོང་བ་ན།",
    "ཟླ་འོད་སོགས་ཀྱི་སྣང་བ་གསུམ་སྔོན་དུ་མི་འཆར་བར་སྟོང་སང་ངེ་བའི་དྭངས་ཤིང་གསལ་བ་ཅིག་འཆར་མོད་ཀྱང་།",
    "དེ་ལ་གཉིད་ཀྱི་སྐབས་སུ་ཤས་ཆེར་སྣ་བུག་གི་འབྱུང་འཇུག་ཕྲ་མོ་ཞིག་མི་ལྡོག་པས།",
    "འབྱུང་འཇུག་ཕྲ་མོ་ཡང་ཆད་ནས་ངྷཱུ་ཏཱིར་ཐིམ་པའི་སྟོང་པ་ཇི་བཞིན་པ་གཉིད་ཀྱི་གཞིའི་སྟོང་པ་ལ་མེད་མོད་ཀྱང་།",
    "གཉིད་ཀྱི་སྟོང་པ་སྐྱེད་པའི་དུས་སུ་ནི་སྣ་བུག་གི་རྒྱུ་བ་ཕྲ་མོ་ཡང་ལོག་ནས་དྷཱུ་ཏཱིར་ཐིམ་པ་འོང་དགོས་སོ།",
    "དེས་ན་སྟོང་པ་གསུམ་རིམ་པ་ངེས་ཅན་དུ་ཤར་བ་སྔོན་དུ་མ་སོང་བའི་གཉིད་ཏིང་ངེ་འཛིན་གྱི་ངོ་བོར་སྐྱེས་པ་ནི་གཉིད་ཀྱི་འོད་གསལ་མིན་ཏེ།",
    "དེ་ལྟར་ན་མཚན་མོ་ཉལ་བའི་དུས་སུ་རྡོར་བཟླས་བྱས་པས་སྟོང་པ་བཞི་འདྲེན་པར་བསྟན་ལ།",
    "བསྲེ་བའི་གདམས་ངག་གིས་ལམ་དུ་སློང་ཤེས་ན་ཤིན་ཏུ་མྱུར་རོ།",
    "སྟོང་པ་ལ་ངེས་པ་དྲང་མི་ནུས་པའི་དྲན་པ་ཉམས་པ་ཡང་མིན་པ་ཅིག་གདམས་ངག་གིས་བྱ་དགོས་སོ།",
    "མྱུར་དུ་རྨི་ལམ་ཤར་བ་དེའི་བར་ཆད་དུ་སོང་ན།",
    "འདི་ལ་གཉིད་མེད་ནས་རྨི་ལམ་མི་འོང་བ་ཡང་ཞག་སྦྲེལ་བ་སྲིད་མོད་ཀྱང་།",
    "མགྲིན་པ་དང་ལྟེ་འོག་གི་གསང་གནས་ཀྱི་ཐིག་ལེས་རྨི་ལམ་དང་།",
    "སྙོམས་འཇུག་གི་དུས་སུ་སྤྱི་བོའི་ཐིག་ལེ་ལ་སེམས་གཏོད་པ་སྟེ།",
    "ཞུགས་ཀྱང་ལྡང་ལུགས་ཐུན་མོང་མ་ཡིན་པ་གཉིས་ཡོད་པ་དང་།",
    "དག་པའི་ཞིང་གི་རྟེན་དང་བརྟེན་པ་རྣམས་ཀྱི་རྣམ་པ་ཙམ་ཡིན་པ་ནི་སྔར་དང་འདྲའོ།",
    "དེས་ན་སྔ་ཕྱི་ལུང་སྟོན་པ་སོགས་ལ་ཡང་མི་སླུ་བ་འགའ་རེ་འོང་མོད་ཀྱང་།"
  ]
