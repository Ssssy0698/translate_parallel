    "འདི་ཕན་ཆད་གཞུང་ལྷག་མས་གནས་བཞི་པོ་འདི་དག་ཉིད་ཀྱིས་མཐར་གྱིས་རྣམ་པར་དབྱེ་བ་རྒྱས་པར་སྟོན་པར་རིག་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་དེ་བཞིན་ཉིད་རྣམ་པར་དབྱེར་མེད་པའི་དོན་དང་།",
    "དེ་ཁོ་ནའི་ཡི་ཤེས་དམ་པའི་ཡུལ་དེ་བཞིན་གཤེགས་པའི་ཁམས་རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "དོན་རྣམ་པར་བཅུ་གང་ཞེ་ན།",
    "ཆུ་རྣམ་པར་དག་པའི་ཡོན་ཏན་དང་།",
    "དེ་ལ་སྲིད་པ་འདོད་པ་ནི་རྣམ་པ་གཉིས་སུ་རིག་པར་བྱ་སྟེ།",
    "ཤཱ་རིའི་བུ་དེ་དག་ནི་མུན་པ་བས་ཀྱང་ཆེས་མུན་པ་ཆེན་པོར་འགྲོ་བ་མུན་པ་ཆེན་པོ་དང་ལྡན་པའོ་ཞེས་པ་སྨྲའོ་ཞེས་གསུངས་པའོ།",
    "མངོན་སུམ་དུ་བྱེད་པར་མི་འགྱུར་བའི་སྒྲིབ་པ་འདི་བཞིན་ཡང་དག་པར་གནས་སོ།",
    "གཙང་བདག་བདེ་དང་རྟག་ཉིད་ཀྱི།",
    "སྡུག་བསྔལ་ཡིད་འབྱུང་ཞི་ཐོབ་པར།",
    "དེ་ལ་གང་ཞིག་གཟུགས་ལ་སོགས་པའི་དངོས་པོ་མི་རྟག་པ་ལ་རྟག་གོ་སྙམ་པར་འདུ་ཤེས་པ་དང་།",
    "བདག་མེད་པ་ལ་བདག་གོ་སྙམ་པ་དང་མི་གཙང་བ་ལ་གཙང་ངོ་སྙམ་པར་འདུ་ཤེས་པ་འདི་ནི་ཕྱིན་ཅི་ལོག་རྣམ་པ་བཞི་ཞེས་བརྗོད་ལ།",
    "འདི་ལས་བཟློག་པ་ལ་ནི་ཕྱིན་ཅི་མ་ལོག་པ་རྣམ་པ་བཞི་ཉིད་དུ་རིག་པར་བྱའོ།",
    "མི་གཙང་བའི་འདུ་ཤེས་གང་ཡིན་པ་སྟེ།",
    "གཙང་བའི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ།",
    "དེ་དག་ནི་མི་རྟག་པ་ལ་རྟག་པར་འདུ་ཤེས་པ།",
    "མི་གཙང་བ་ལ་གཙང་བར་འདུ་ཤེས་པ་ལགས་སོ།",
    "བཅོམ་ལྡན་འདས་རྟག་པར་འདུ་ཤེས་པ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ལས་སྐྱེས་བའི་སྲས་ལགས་སོ།",
    "གཙང་བའི་ཕ་རོལ་ཏུ་ཕྱིན་པའོ།",
    "ཡང་དག་པར་མཐོང་བ་གང་ལགས་པ་དེ་དག་ཐམས་ཅད་ནི་བཅོམ་ལྡན་འདས་ཀྱི་ཐུགས་ཀྱི་སྲས་ལགས་སོ་ཞེས་རྒྱས་པར་འབྱུང་ངོ།",
    "བདག་མེད་པ་ཉིད་བདག་ཏུ་བྱས་པ་སྟེ།",
    "མི་གནས་པའི་ཚུལ་གྱིས་གནས་བ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "གཙང་བའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བྱའོ།",
    "བག་ཆགས་སྤངས་ཕྱིར་གཙང་བ་ཡིན།",
    "ཁྱད་པར་གྱི་མཚན་ཉིད་དྲི་མ་མེད་པའི་ཡོངས་སུ་དག་པས་སོ།",
    "རྒྱུ་རྣམ་པ་གཉིས་ཀྱིས་བདེ་བའི་ཕ་རོལ་ཏུ་ཕྱིན་པར་རིག་པར་བྱ་སྟེ།",
    "སྡུག་བསྔལ་འགོག་པའི་རྣམ་པ་ཐམས་ཅད་མངོན་དུ་བྱས་པས་ཡིད་ཀྱི་རང་བཞིན་གྱི་ལུས་འགགས་པ་མངོན་དུ་བྱས་པའི་ཕྱིར་རོ།",
    "རྒྱུ་རྣམ་པ་གཉིས་ཀྱིས་རྟག་བའི་ཕ་རོལ་ཏུ་ཕྱིན་པར་རིག་པར་བྱའོ།",
    "བཅོམ་ལྡན་འདས་གལ་ཏེ་འདུ་བྱེད་མི་རྟག་གོ་ཞེས་བགྱི་བར་ལྟ་ན་དེའི་ཆད་པར་ལྟ་བར་འགྱུར་ཏེ།",
    "དེ་ནི་དེའི་ཡང་དག་པ་མ་ལགས་པའི་ལྟ་བར་འགྱུར་རོ།",
    "དེ་ནི་དེའི་ཡང་དག་པ་མ་ལགས་པའི་ལྟ་བར་འགྱུར་རོ་ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "གཉིས་ཀ་ལྟར་རྣམ་པར་མི་རྟོག་པ་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པ་མངོན་དུ་བྱེད་པའི་ཕྱིར་རོ།",
    "དོན་གཉེར་སྨོན་པའང་མེད་པར་འགྱུར།",
    "སྨོན་པ་ཡང་མེད་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "སྨོན་པ་སྐྱེད་པར་བྱེད་པའོ།",
    "སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་དེ་སྲིད་དུ་ནི་འགྱུར་བ་ཡང་མ་ཡིན་ནོ།",
    "མ་འོངས་པའི་རྒྱུ་ཡང་དག་པར་བསྐྱེད་པས་ན།",
    "དུས་གཞན་ལ་དགོངས་ནས་གསུངས་པ་ཡིན་ནོ།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་རིགས་ཡོད་པའི་ཕྱིར།",
    "འགའ་ཡང་གཏན་རྣམ་པར་དག་པར་མི་འགྱུར་བ་ནི་འོས་པ་མ་ཡིན་ཏེ།",
    "ཞེས་གསུངས་སོ།",
    "རྒྱ་མཚོ་དང་ནི་མཚུངས་པར་བསྟན།",
    "དེ་ནི་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར་དང་།",
    "དེ་ནི་ཤིན་ཏུ་དྲི་མ་མེད་པའི་རྣམ་པར་དག་པ་འོད་གསལ་བའི་མཚན་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "རྣམ་པར་དག་པ་ནི་ཤེས་བྱའི་སྒྲིབ་པ་སྤངས་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཁམས་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སོགས་པར་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་སྒོ་ལ་གདམས་པ་ལས་བརྩམས་ཏེ།",
    "ཡང་དག་པར་ཕྱིན་ཅི་མ་ལོག་པ་སྤྲོས་པ་མེད་པ་སྟེ།",
    "ཡང་དག་པར་ཕྱིན་ཅི་མ་ལོག་པའི་སྤྲོས་པ་མེད་པ་ནི།",
    "དེ་ལས་གཞན་པའི་དོན་རྣམ་པ་བཞིའི་དབྱེ་བ་སྟོན་པར་རིག་པར་བྱའོ།",
    "གནས་སྐབས་གསུམ་དུ་གོ་རིམས་བཞིན་དུ་མིང་གསུམ་བསྟན་པས་བསྟན་པར་རིག་པར་བྱ་སྟེ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པའི་གནས་སྐབས་སུ་ནི་དེ་བཞིན་གཤེགས་པ་ཞེས་བྱའོ།",
    "ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "དུས་ཐམས་ཅད་དུ་ཁྱད་པར་མེད་པར་འགྱུར་བ་སྟེ། ། གོ་རིམས་ཇི་ལྟ་བཞིན་ས་དང་།",
    "འདི་ནི་དོན་གྱིས་གཉིས་སུ་མེད་དེ་ཡི་གེ་ཙམ་དང་ཐ་དད་པར་ཡིན་ནོ་ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "ཚིགས་སུ་བཅད་པ་བཅུ་བཞི་པས་ནི་ཤིན་ཏུ་རྣམ་པར་དག་པའི་གནས་སྐབས་ན་རྣམ་པར་དབྱེ་བ་མེད་ཅིང་བྲལ་མི་ཤེས་ཤིང་།",
    "དེ་བཞིན་འདུས་མ་བྱས་དབྱིངས་ལ།",
