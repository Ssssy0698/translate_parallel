    "བརྟན་པ་ཉིད་དུའང་རང་ཉིད་འགྱུར།",
    "ༀརུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིད་དྷལོ་ཙ་ནེ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་དང་།",
    "དེ་ལ་མ་རིག་པའི་བག་ཆགས་ཀྱང་རང་བཞིན་གྱིས་འོད་གསལ་བ་ལ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་དང་།",
    "གཉིས་པ་ནི་སྒོ་ལྔ་དང་མཚུངས་ཏེ་སྣང་ཡང་རང་བཞིན་གྱིས་སྟོང་པའོ།",
    "རྣལ་འབྱོར་ཅན་གྱི་ཤེས་པ་ལ་སྣང་བ་ཡང་རང་ལས་གཞན་དུ་མེད་པར་བདག་ཉིད་ཆེན་པོ་འཕགས་པ་ཀླུ་སྒྲུབ་བདག་སྨྲའོ།",
    "བྱིས་རྩམ་ཁ་ཤས་ཀྱང་དྲན་རྟེན་གྱི་ཚུལ་དུ་དེབ་ཆུང་འདིའི་ནང་མཉམ་སྒྲིག་བྱས་ཤིང་སྦྲ་ཁྱིམ་འདིའི་ནང་མཉམ་གཤོམ་བྱས་འདུག་དེས་ན་ཀློག་པ་པོ་ཚོས།",
    "དོན་ལ་ང་རང་གླེན་ལྐུགས་ཞིག།",
    "སྦྱངས་འབྲས་ཞན་པས་མྱུར་མཇལ་སྤོབས་སེམས་དེ་མི་འདུག།",
    "ད་ལྟ་ཁྱེད་ཉིད་མཇལ་བའི་རང་སྤོབས་དེ་མི་འདུག།",
    "ཁུ་བྱུག་གསུངས་སྙན་ཞིག་སྒྲོག་དུས།",
    "ངའི་སྨྱུག་རྩེ་ནས་ཐོན་པ་ཡང་ཁྱེད་ཚོ་ལོས་ཡིན།",
    "ཁྱེད་རང་དབེན་པའི་གྲང་ངར་དེ་ཇེ་ངར་ནས་ཇེ་ངར་དུ་ཕྱིན།",
    "ངས་ཁྱེད་རང་ཤིན་ཏུ་དྲན་ལ།",
    "ཁྱེད་རང་དྲན་པའི་གདུང་བས་ང་ལ་གནོད་སྐྱོན་མི་ཉུང་བ་ཞིག་སྦྱིན་མྱོང་།",
    "དེབ་འདི་དཔར་བསྐྲུན་གྱི་འགྲོ་གྲོན་གནང་མཁན་ཨ་ཞང་བཀྲ་ཤིས་དང་ཕུ་བོ་བློ་བཟང་ཡེ་ཤེས་སོགས་ལ།",
    "འཁྲིག་པ་སྤྱོད་བྱ་རོག་ལའད་འཁྲིག་དུས་མཚོན་ནོ།",
    "རྔོན་ཁྱི་རྒན་པས་དཔའ་ངར་ཆེར་སྐྱེད་ཀྱིས་ཕག་རྒོད་བཟུང་ཡང་ཁོ་རང་ལོ་ན་རྒས་པས།",
    "ཆ་ཤས་གཞན་དེ་ཆུང་འདུག་ཅེས་བཤད།",
    "འོན་ཀྱང་རང་ཉིད་མཁས་རློམ་གྱི་རྣམ་འགྱུར་བཟུང་ན་མི་བཟང་ངོ།",
    "ཟླ་བས་ནམ་ཡང་རང་ཉིད་ནི་འགྲན་ཟླ་བྲལ་བ་ཞིག་ཡིན་པར་འདོད་དེ།",
    "མིག་ཆུང་བཙུམ་ཙམ་བྱས་ཏེ་ང་རང་མི་རྣམས་དང་བར་ཐག་ཧ་ཅང་རིང་བས་ཁོ་ཚོས་གསལ་བོ་མཐོང་མི་ཐུབ་པ་དང་།",
    "ཟླ་བས་ཅི་ཡང་མི་བསམ་པར་དེ་ནི་ང་རང་ཉིད་ཀྱི་སྟེང་ནས་འོད་འཕྲོ་ཐུབ་པའི་རྐྱེན་ཡིན།",
    "ཁོ་རང་ཉིད་ཀྱི་འཇིམ་བརྙན་ཡང་ཡོད་པས།",
    "མི་སུ་ཡིན་རུང་རང་ཉིད་ཀྱི་བཟང་ཆ་ཤེས་དགོས་པ་མ་ཟད།",
    "སྐབས་དེར་བོང་བུས་ཡིད་ཧ་ཅང་ཚིམ་ནས་སྟག་ཀྱང་རང་ཉིད་ལ་སྐྲག་འདུག་པས།",
    "ང་རི་བོའི་སྐེད་པའི་ཕྱེད་ཀར་སླེབས་པ་ཧ་ཅང་བཟང་འདུག་ད་མུ་མཐུད་དུ་ཡར་འཛེག་དགོས་དོན་མེད།",
    "ངོ་མ་ཞིམ་པོ་འདུག་ཅེས་བསྟོད་པས།",
    "འོན་ཀྱང་ངས་གླལ་བ་ལན་གསུམ་རྒྱག་དུས་ང་སྤྱང་ཀི་ལྟར་གྱུར་ཏེ་མི་སོགས་ལ་སོ་འདེབས་པ་ཡིན།",
    "དེ་ནི་རྔ་མ་དང་མི་འདྲ་པར་ཡག་པོ་འདུག་ཅེས་བཤད།",
    "ཁོ་ཚོ་བསེ་རུ་དང་ཐུག་དུས།",
    "ལེ་ལོ་ཅན་གྱི་མི་ཡིས་ནམ་ཡང་རང་ལ་ཁ་གཡོར་ས་མང་པོ་བཙལ་ཏེ།",
    "ང་རང་ཕྱིར་ལོག་སྟེ་རྩུབ་ཤས་ཆེ་བའི་བཟའ་ཆས་དག་ཟ་བཞིན་བདེ་ལྷོད་ཀྱི་འཚོ་བ་སྤྱིར་བཏང་བ་ཞིག་རོལ་འདོད།",
    "བྱ་རྒོད་ཕག་རྒོད་ལ་སྐྲག་ནས་ཉིན་རྒྱུན་སྡོང་པོའི་ཡལ་ག་སྟེང་དུ་འདུག་པ་ལས།",
    "འོན་ཀྱང་ཉིན་མང་པོ་འགོར་རྗེས་ཁོ་དེ་རུ་འདུག་མ་འདོད་པ་དང་།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་ནུས་བར་གསལ་ཆ་ཡོད་དགོས་ལ།",
    "དུས་ད་བར་དུ་ཁོ་བོ་སྔར་བཞིན་སྡོང་བོའི་སྟེང་ན་འདུག་གོ།",
    "ཁོ་རང་གནས་འདི་རུ་གཏན་སྡོད་བྱས་ནས་ལུག་བལ་འབྲེག་པའི་ཚོང་འདི་གཉེར་རྒྱུའི་སེམས་ཐག་བཅད།",
    "འོན་ཀྱང་རྟ་རྒན་འདི་ད་ལྟ་རྒས་འདུག་པས།",
    "ཁྱེད་རང་ལས་གྲ་ཚེགས་པོ་འདུག་སེམས་ཁུར་བྱས་ནས་ཅི་བྱེད་ཅེས་སྨྲས་རྗེས།",
    "ཁྲོན་པ་གཏིང་ཟབ་པོ་འདུག་ད་དུང་ཁྲོན་ཆུ་ཡོངས་རྫོགས་འཐུང་ཚར་རྗེས།",
    "ང་རང་མཛེས་སམ་ཞེས་དྲིས།",
    "ང་རང་མཛེས་སམ་ཞེས་དྲིས།",
    "ང་རང་མཛེས་སམ་ཞེས་དྲིས།",
    "ཤིང་རྟ་ཁ་ལོ་བས་གང་ལྟར་བླུན་རྨོངས་ནུས་མེད་ཀྱི་རྒྱལ་པོ་འདི་བསྐྱོད་ཐབས་མི་འདུག་པ་ཤེས་ཚོར་བྱུང་སྟེ།",
    "དཀའ་ཁག་ཅི་ཞིག་ལ་འཕྲད་ཀྱང་རང་ཉིད་ཀྱི་དད་སེམས་མ་འགྱུར་ན།",
    "ཀོན་ལིན་གྱིས་ས་བསློགས་ནས་བལྟས་ཙ་ན།",
    "མི་ཚང་མ་རང་རང་སར་འགྲོ་བཞིན་ཕན་ཚུན་ལ་འཚམས་གསོལ་དང་གྱེས་བརྡ་བརྒྱབ།",
    "སེམས་ཐག་གཙང་བཅད་ཀྱིས་སྔ་སྐྱོན་སྤངས་ནའང་འཕྱི་མི་འདུག་ཀྲུག་ཁྲུའུ་ཡིས་ལུའུ་ཡོན་གྱི་སྐད་ཆ་དེར་ཉན་རྗེས།",
    "ཕག་རྒོད་འབྲོ་ཞོར་དུ་མགོ་ཕྱིར་འཁོར་ནས་བལྟས་ཙམ་བྱས་ན་སྟག་རྒོད་ད་དུང་རང་ཉིད་ཀྱི་རྗེས་བསྙེགས་ནས་ཡོང་བ་མཐོང་བས་དངངས་འཚུབ་ཆེན་པོའི་ངང་ལམ་ཁ་བསྒྱུར་ནས་རྒྱ་ལམ་དུ་བྲོས།",
    "དཀའ་ངལ་ཧ་ཅང་ཁག་དུས་ཡུན་ཙམ་ལ་བཞོན་པ་དང་།",
    "ཁྱེད་རང་སྐྲག་མི་དགོས།",
    "སྐབས་འདིར་ནི་དེ་དག་ཇི་ལྟར་བསྟེན་པ་ཡང་རང་ཉིད་ཧེ་རུ་ཀ་འཁོར་ལོ་སྡོམ་པའི་ངོ་བོ་དང་།",
    "སྲུང་བའི་ཚེ་རང་རང་ཇི་ལྟ་བཞིན་སྲུང་བ་ནི་འཆོལ་པར་སྲུང་བ་ཞེས་བྱ་སྟེ།",
    "དགའ་བ་དང་མགུ་བ་དང་རངས་པ་ཤིན་དུ་ཐོབ་པ་ཤ་ས་ག་དང་ཐབས་གཅིག་གོ།",
    "དགའ་བ་དང་རངས་པ་རྒྱ་ཆེན་པོ་སྐྱེད་པ་ཞེས་བྱའོ།",
    "ཐོབ་པ་མེད་ཅིང་རང་བཞིན་མེད་པ་སྟེ།",
    "ཇི་ལྟར་འཇིག་རྟེན་གྱི་ཁམས་འདིའི་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་དྲུང་ན་འདུག་པ་ལ་ཉེ་བར་སྒྲུབ་པ་དེ་བཞིན་ཏུ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་འཇཛམ་ཀྲས་པ་ལ་ལ་ནི་ཀུན་ནས་འཁྱིལ་བའི་དབྱིབས་སུ་འདུག་གོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་འཇམ་ཀླས་པ་ལ་ལ་ནི་འོད་འཕྲོ་བའི་རིའི་དབྱིབས་སུ་འདུག་གོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་འཇམ་ཀྲས་པ་ལ་ལ་ནི་ཤིང་སྣ་ཚོགས་ཀྱི་ལྡན་གྱི་དབྱིབས་སུ་འདུག་གོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་འཇམ་ཀྲས་པ་ལ་ལ་ནི་མེ་ཏོག་སྣ་ཚོགས་ཀྱི་དབྱིབས་སུ་འདུག་གོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་འཇམ་ཀྲས་པ་ལ་ལ་ནི་ཁྱིམ་སྣ་ཚོགས་ཀྱི་དབྱིབས་སུ་འདུག་གོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་འཇམ་ཀླས་པ་ལ་ལ་ནི་འཚན་སྣ་ཚོགས་ཀྱི་དབྱིབས་སུ་འདུག་སྟེ།",
    "མི་ཟད་ཡངས་པ་ཀུན་ནས་ཁྱེབས་པར་འདུག།",
    "དབྱིབས་གཞན་དང་གཞན་དུ་འདུག་པ།",
    "རྣམ་པ་གཞན་དང་གཞན་གྱིས་འདུག་པ།",
    "གཞན་དང་གཞན་དུ་འདུག་པ།",
    "འཇིག་རྟེན་གྱི་ཁམས་རྒྱ་མཚོ་ཐམས་ཅད་ཀྱང་དབྱིབས་གཞན་དང་གཞན་དུ་འདུག་པ་ཤ་སྟག་སྟེ།",
    "ཕྱོགས་ཐམས་ཅད་ནས་གྲ་དུ་མའི་དབྱིབས་སུ་འདུག་པ།",
    "གཅིག་ཏུ་དག་པ་ཁང་པ་རྩེགས་པའི་དབྱིབས་སུ་འདུག་པ།",
    "ཚངས་པའི་ལུས་ཀྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "ཟླ་བ་ཁམས་པའི་དབྱིབས་ལྟར་འདུག་པ།",
    "དབྱིབས་དཔལ་གྱི་བེའུ་ལྟར་འདུག་པ།",
    "དབྱིབས་ཡན་ལག་བརྒྱད་དུ་འདུག་པ།",
    "སྤོས་དང་འོད་འཕྲོ་བའི་ཁ་དོག་མཐའ་ཡས་པ་རི་རབ་ཀྱི་རྒྱ་མཚོ་ལ་རབ་ཏུ་གནས་པ་དབྱིབས་ནོར་བུའི་ཟེ་བ་འཁྱིལ་བ་ལྟར་འདུག་པ།",
    "དབྱིས་གཞན་དང་གཞན་དུ་འདུག་པ།",
    "འཇིག་རྟེན་གྱི་ཁམས་འབུམ་ཀླས་པ་དམིགས་པ་ཐམས་ཅད་ཀྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "དབྱིབས་ཀུན་ནས་དཀྱིལ་འཁོར་དུ་འདུག་པ།",
    "དགྱིབས་ནོར་བུའི་འཁོར་ལོ་ལྟར་འདུག་པ།",
    "ལྷ་མ་ཡིན་གྱི་ལས་ཀྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "གསེར་གྱི་སླེང་གེའི་ཁྲི་རྒྱ་མཚོ་ལ་རབ་ཏུ་གནས་པ་སེང་གེའི་ཁྲིའི་དབྱིབས་ལྟར་འདུག་པ།",
    "དགའ་བ་འཁྱིལ་བའི་དབྱིབས་ལྟར་འདུག་པ།",
    "མིག་འཕྲུལ་གྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "བརྒྱ་བྱིན་གྱི་ཁམས་ཀྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "ཤིང་ཐམས་ཅད་ཀྱི་རྒྱ་མཚོ་ལ་རབ་ཏུ་གནས་པ་དགྱིབས་དཔལ་གྱི་བེའུ་ལྟར་འདུག་པ།",
    "ཐུར་དུ་མའི་དབྱིབས་སུ་འདུག་པ།",
    "རི་རབ་ཀྱི་དབྱིབས་ལྟར་འདུག་པ།",
    "རྣམ་པར་རྒྱལ་བ་རབ་ཏུ་ཕྱེ་བའི་ཁད་པ་རྩེགས་པའི་དབྱིབས་ལྟར་འདུག་པ།",
    "དེ་རྗེའི་དབྱིབས་ལྟར་འདུག་པ།"
  ]
