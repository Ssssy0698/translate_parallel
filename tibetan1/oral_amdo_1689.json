    "བུ་མོ་རྣམས་ནི་ཁྱོའི་དོན་དུ་ཡིན་ལ།",
    "ཁྱོ་ལ་ཡང་ངེས་པ་མེད་པས་ཐམས་ཅད་ལ་སྲིད་པར་བྱ་དགོས་སོ།",
    "དེའི་ཕྱིར་གང་འདི་འདི་ལས་ཆགས་པར་འགྱུར་བ་དངོས་པོ་ཐུན་མོང་བ་རྙེད་པ་ལ་ངོ་མཚར་ཅི་ཡོད།",
    "དེ་ཡང་ཐམས་ཅད་ཀྱི་ཐུན་མོང་དུ་གྱུར་པ་ཞིག་ཡིན་པ་དེ་བཞིན་དུ།",
    "བུད་མེད་གཞོན་ནུ་མར་གནས་པ་ནི་ཐམས་ཅད་ཀྱིས་དོན་དུ་གཉེར་བར་བྱ་བ་ཡིན་པའི་ཕྱིར་རིལ་གྱིས་ཐུན་མོང་བར་འགྱུར་ལ།",
    "ལམ་ཆེན་ཟོང་ལྟའི་བུད་མེད་ནི།",
    "གང་གི་ཕྱིར་ཆགས་པ་སྐྱེ་བ་ནི་ཡོན་ཏན་སྔོན་དུ་འགྲོ་བ་ཅན་ཡིན་པར་འཇིག་རྟེན་ན་མཐོང་སྟེ།",
    "དེའི་ཕྱིར་བུད་མེད་ཡོན་ཏན་དང་ལྡན་པ་ལ་ཆགས་པར་མི་རིགས་སོ།",
    "གང་གི་ཚེ་དེའི་སྐྱོན་གྱིས་འཆག་ཏུ་འགྲོ་བ་སྟེ་འཆག་ཁང་དུ་འཇུག་པ་དེའི་ཚེ་མི་དགའ་བ་དང་།",
    "གང་གི་ཚེ་མཐོང་བ་དེའི་ཚེ་དེ་ཉིད་ལ་ཡོན་ཏན་མཐོང་བའི་ཕྱིར་དང་།",
    "ཡོན་ཏན་མ་ཡིན་པ་མཐོང་བའི་ཕྱིར་ཤིན་ཏུ་ཆགས་པ་དང་བྲལ་བར་འགྱུར་བ་དེ་བཞིན་དུ་བུད་མེད་ཀྱི་རང་བཞིན་མཐོང་བས་འདོད་ཆགས་དང་བྲལ་བར་འགྱུར་རོ།",
    "ཁྲེལ་དང་བྲལ་བ་དེ་དག་གི་འདོད་ཆགས་ནི་ཡོན་ཏན་དང་ལྡན་པ་རྣམས་ཁོ་ན་ལ་འགྱུར་བ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི།",
    "དེ་དག་གི་འདོད་ཆགས་ནི་ཐམས་ཅད་ལ་ཡང་སྟེ།",
    "དེའི་ཕྱིར་བུད་མེད་དག་ལ་འདོད་ཆགས་པ་ཡོན་ཏན་དང་ལྡན་པའི་རྒྱུ་ཅན་དུ་མི་རིགས་སོ།",
    "འོན་ཀྱང་གང་ཁྱེད་ཅག་གི་བདེ་བ་འདི་མི་ཚོར་བ་དེ་ལྟར་ཁོ་བོ་ངུའོ།",
    "དུ་བ་ལས་བཟློག་པ་མི་ནུས་པ་དེ་བཞིན་དུ་བླུན་པས་གང་དག་གི་འདོད་ཆགས་ཡོན་ཏན་གྱིས་མ་བྱས་པ་དེ་དག་ནི་གསོ་དཀའོ།",
    "མི་གང་བུད་མེད་ལ་རྨོངས་པ།",
    "བུད་མེད་རྣམས་ལས་བཟློག་མི་ནུས།",
    "བུད་མེད་ནི་སྐྱེས་པ་ཤི་ཡང་ཕྱི་བཞིན་ལྕེབ་ཀྱི།",
    "སྐྱེས་པ་ནི་བུད་མེད་ལ་དེ་ལྟ་མ་ཡིན་ནོ།",
    "དེ་ལྟར་ཆགས་པ་དང་རྗེས་སུ་འབྲེལ་བའི་བུད་མེད་དག་ཇི་ལྟར་མི་བསྟེན།",
    "དེ་སྲིད་དེ་ནི་ཁྱོ་ལ་འདུག།",
    "འདི་ལྟར་ཟབ་ཅིང་ངེས་པར་དཀའ་བའི་བྱུང་ཚུལ་ཟོལ་དུ་མ་དང་ལྡན་པ་ཅན་གྱི་བུད་མེད་རྣམས་ནི་རྟག་ཏུ་སྐྱེས་པ་མཐོང་བར་འདོད་དོ།",
    "དེའི་ཕྱིར་ངེས་པར་འགའ་ཡང་གང་ལ་ཡང་མི་ཆགས་པས་མཁས་པས་བུད་མེད་རྣམས་ལ་ཡིད་བརྟན་པར་མི་བྱ་སྟེ།",
    "སྔར་མི་འདོད་པའི་བྲམ་ཟེ་མོ་ལོག་པར་བསྒྲུབས་པ་བཞིན་ནོ།",
    "སྐྱེས་བུ་ཞིག་གིས་བྲམ་ཟེ་མོ་འགའ་ཞིག་དོན་དུ་གཉེར་བ་དང་།",
    "དེས་བདག་པོ་ལ་སྐྱེས་བུ་ཞིག་བདག་གི་གན་དུ་འོང་གིས།",
    "གང་གི་ཚེ་འཇུག་པར་འགྱུར་བ་དེའི་ཚེ་ཁྱོད་ལ་བརྡ་སྤྲད་ཀྱིས་ཞེས་སྨྲས་སོ།",
    "དེ་སྐད་སྨྲས་ནས་གནས་པ་ལ་གང་གི་ཚེ་ཞུགས་ཤིང་ལོག་པར་གྱུར་པ་དེའི་ཚེ་དེ་ལ་ཆགས་ཤིང་།",
    "བུད་མེད་རྣམས་ནི་རྟག་ཏུ་བསྲུང་བར་བྱ་བ་ཞིག་སྟེ།",
    "གང་ཕྱིར་བུད་མེད་བསྲུང་བྱས་ཀྱང་།",
    "རང་གི་འདོད་པས་འགྲོར་འགྱུར་བ།",
    "གཤིན་པའི་བུད་མེད་ཤིན་ཏུ་དཀོན།",
    "ལང་ཚོ་ལ་བབ་པས་ན་ཚོད་དང་པོ་ལ་འདོད་པ་ཉེ་བར་བསྟེན་པར་བསྟན་ལ།",
    "བུད་མེད་ཀྱི་སྐྱེ་བོའི་སྒོ་བ་བཞིན་བྱེད་པ་འདི་དར་མའི་གནས་སྐབས་སུ་སྤྱོད་པ་རྗེས་སུ་གདུང་བར་བྱེད་པ་གང་སྤྱད་ཅིང་།",
    "དར་མ་རང་གིས་བྱས་པ་དང་།",
    "གང་དུ་དེ་ཁོ་ན་ཉིད་མ་མཐོང་ཞིང་སྐད་ཅིག་ལ་ཉོན་མོངས་པའི་སྡུག་བསྔལ་ལོག་པའི་སྤྱོད་པ་ཡང་།",
    "ཡོངས་སུ་དགའ་བའི་རྒྱུར་མི་འགྱུར་བ་དེར་ཉོན་མོངས་པའི་འཆིང་བ་མཐའ་དག་གྲོལ་ཞིང་།",
    "རབ་ཏུ་དང་ལ་རིང་པོ་གཟིགས་པ་རྣམས་ཀྱིས་མངལ་དང་སྨད་པ་དང་དཀའ་བ་རྣམས་བརྒྱ་ཕྲག་སྟོང་ངམ་རྒྱུན་མི་འཆད་པར་ཇི་ལྟར་མི་འགྱུར།",
    "དེ་ཏེ་པོར་ངོ་ཚ་བར་གྱུར་པ་དེ་བཞིན་དུ་རེ་ཞིག་འདོད་པ་དེ་རྣམས་མི་བཟད་པ་ཉིད་དུ་མ་ཤེས་ནས་ལང་ཚོའི་ཚེ་གང་བྱས་པ་དེ་ལ་རྒན་པོ་མི་དགའ་ན།",
    "གང་དག་གིས་དངོས་པོའི་དེ་ཉིད་ཡོངས་སུ་ཤེས་པར་བྱས་པ་དེ་དག་གིས་དེ་ལ་སྤྱོད་པ་ཆེས་གདུང་བར་ཇི་ལྟར་མི་འགྱུར་ཏེ།",
    "གང་བུད་མེད་ཀྱི་བདེ་བའོ།",
    "དེའི་རྒྱུ་ནི་བུད་མེད་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་དེའི་དོན་དུ་གདོན་མི་ཟ་བར་བུད་མེད་ཡོངས་སུ་གཟུང་བར་བྱའོ།",
    "འདིར་འདོད་པའི་ཁམས་ཀྱི་བུད་མེད་ཀྱི་བདེ་བ་གང་ཡིན་པ་དེ་ནི་མ་ཆགས་པ་མེད་ལ།",
    "གང་གི་ཚེ་ཆགས་པར་གྱུར་པ་དེའི་ཚེ་ནི་ཆགས་པས་ཆགས་པར་བྱ་བའི་དོན་དངོས་པོ་ལ་དེའི་རང་བཞིན་དུ་འགྱུར་ཞིང་།",
    "གང་གཏི་མུག་གིས་ཡུལ་གྱི་རང་གི་ངོ་བོ་མི་རིག་ཅིང་།",
    "རང་གི་རྣམ་པར་རྟོག་པས་བློ་ཕྲོགས་པ།",
    "འཁྲུལ་འཁོར་གྱི་མི་ལྟར་ཀུན་ཏུ་རྨོངས་པར་བྱས་པའི་ཡུལ་གྱི་རང་གི་ངོ་བོ་ལ་སེམས་གཏད་དེ།",
    "བདེ་བ་སོ་སོར་ཡང་དག་པར་རིག་པ་མེད་ན་ཡང་ཕྱིན་ཅི་ལོག་གི་རྟོག་པ་ཙམ་ཉིད་ལས་མ་གཏོགས་པ་འདི་ལ་བདེ་བ་ཅུང་ཟད་ཀྱང་མི་འབྱུང་ངོ།",
    "དེ་ལ་བུད་མེད་ཀྱི་བདེ་བ་བསྐྱེད་པའི་ཕྱིར་གདོན་མི་ཟ་བར་བུད་མེད་ཡོངས་སུ་གཟུང་བར་བྱའོ་ཞེས་གང་ཀསྨྲས་པ་དེ་ནི་མ་ཡིན་ཏེ།",
    "བྱིས་པ་རྒྱལ་པོའི་བཙུན་མོ་འདོད་པ་དང་།",
    "ཐག་པ་བཞིན་ནོབབ་བྱིས་པ་འགའ་ཞིག་རྒྱལ་པོའི་བཙུན་མོ་མཐོང་ལ།",
    "དེའི་བྲན་མོ་ཞིག་བྱ་དགས་ཡང་དག་པར་བསྐངས་ནས་བདག་དང་ལྷ་ལྷན་ཅིག་སྤྱོད་པར་ནུས་སམ་ཞེས་སྨྲས་སོ།",
    "དེ་ནས་དེས་དོན་དེ་རྒྱལ་པོའི་བཙུན་མོ་དེ་ལ་ཞུས་པ་དང་།",
    "འོན་ཀྱང་གང་གི་ཚེ་ཡང་བཙུན་མོའི་རྒྱུ་བར་འགྱུར་བ་དེའི་ཚེ་དེའི་དོན་འདི་ནུས་པར་འགྱུར་གྱིས་ཞེས་སྨྲས་སོ།",
    "དེ་ནས་བྲན་མོ་དེས་དོན་དེ་བྱིས་པ་དེ་ལ་གླེངས་པས་དེས་བུད་མེད་ཀྱི་ཆེད་དུ་ལོ་ཁྱུད་ཀོར་གྱི་མཐར་ཐུག་པར་དྲི་དང་།",
    "བཙུན་མོ་རྒྱུ་བ་ཉེ་བར་གནས་པ་ན་བྱིས་པས་སང་རྒྱལ་པོའི་བཙུན་མོ་དང་བདག་ལྷན་ཅིག་ཕྲད་པར་འགྱུར་རོ་ཞེས་རང་གི་བར་ཁང་ལེགས་པར་འདུས་བྱས་སོ།",
    "དེ་སོང་བ་དང་རྒྱལ་པོའི་བཙུན་མོ་བྱིས་པ་དེའི་ཁང་པར་ཕྱིན་ཏེ།",
    "སླར་ལོག་སྟེ་སོང་ངོ།",
    "ཡང་ཐ་ག་བ་ཞིག་རྒྱལ་པོའི་བཙུན་མོ་དང་འཛོལ་ཏེ།",
    "ཀཱའི་ཁྱོད་ཀྱིས་ལྷ་མཐོང་ངམ།",
    "ཀཱའི་ང་འདྲིའམ་ཞེས་རེ་རེ་ལ་འདྲི་བར་གྱུར་ཏོ།",
    "ཆགས་རྨོངས་གང་ཞིག་བུད་མེད་ཀྱི།",
    "གལ་ཏེ་བུད་མེད་ཀྱི་བདེ་བ་ལ་བུད་མེད་དང་ཕྲད་པས་འབྱུང་ལ།",
    "ཁྱོད་ལ་གུས་བཞིན་རྟག་པར་ནི།",
    "མོ་དང་ལྷན་ཅིག་ཕྲད་པ་མེད།",
    "ཇི་ལྟར་ཁྱོད་ཀྱི་བུད་མེད་ལོངས་སྤྱོད་པའི་གུས་པ་ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོའི་རིམ་པར་འཕེལ་བས་ཉིན་མཚན་དུ་རྒྱུན་མི་འཆད་པར་འཕེལ་བ་དེ་ལྟར་ལོངས་སྤྱོད་ཀྱང་ཅི་སྟེ་མི་འཕེལ།",
    "དེའི་ཕྱིར་ཅིའི་དོན་དུ་ཡིད་ཙམ་ལོངས་སྤྱོད་པས་ཡོངས་སུ་དུབ་པའི་ཆགས་པ་ཅན་རྣམས་ཆགས་བྲལ་ལྟར་བུད་མེད་དག་ཡོངས་སུ་གཏོང་བར་བྱེད།",
    "དེའི་ཕྱིར་གུས་པ་ལྟར་བུད་མེད་ལོངས་སྤྱོད་པར་མི་ནུས་པ་འདི་དག་གི།",
    "ཡོངས་སུ་འཛིན་པ་འདི་ནི་བདག་གི་ཡིན་གྱི།",
    "གཏི་མུག་གི་རྣམ་པར་འགྱུར་བ་ཞིག་སྟེ།",
    "རྒྱལ་པོ་བུད་མེད་མང་པོ་ཅན་ལ་གཏམ་བྱ་བ་དང་།",
    "ནམ་ཞིག་ན་རྒྱལ་པོ་དེ་ལ་དགེ་སློང་ཞིག་གིས་ཅི་བུད་མེད་ཐམས་ཅད་ཀྱིས་བྱ་བ་བྱེད་དམ་ཞེས་དྲིས་པ་དང་།",
    "སྐྱེས་བུ་ལོང་བ་ཞིག་མིག་མེད་པའི་དེ་ལྟ་ན་ཕྱིར་གཟུགས་ཀྱི་ཆེད་དུ་བུད་མེད་དག་ལ་གུས་པ་དང་ལྡན་པར་ཡང་མི་འགྱུར་ལ།",
    "དེ་ལྟ་ན་ཡང་བུད་མེད་འདི་དག་ནི་བདག་ཁོ་ནའི་ཡིན་གྱི་གཞན་གྱི་ནི་མ་ཡིན་ནོ་ཞེས་ཡོངས་སུ་འཛིན་པར་སྐྱེ་ལན་གྱི་གཞན་གྱི་ནི་མ་ཡིན་རྣམ་འགྱུར་ལབྱེད་དོ།",
    "བུད་མེད་དག་གིས་དགོས་མེད་འགྱུར།",
    "འདིར་བུད་མེད་དག་གིས་དགོས་པ་མེད་པར་འགྱུར་ཏེདུན་བ།",
    "བདེ་བ་ཞེས་བྱ་ས་བ་ནི་སྐྱོན་མེད་པའི་ཕྱིར་ནམ་ཡང་དོར་བར་བྱ་བར་མི་འདོད་དོ་ར་འདད་གང་གི་ཕྱིར་འདོད་ཆགས་ནི་དུག་ལྟར་འགལ་ཟླའི་དུག་བུད་མེད་ཀྱིས་སླར་འཇོམས་པར་བྱེད་པ་དེའི་ཕྱིར།",
    "མཚན་མོ་ཁྱིམ་འགའ་ཞིག་ཏུ་ཞུགས་ལ།",
    "དེས་དེར་སྣོད་འགའ་ཞིག་ཏུ་ཐལ་བ་མཐོང་ཞིང་།",
    "དེས་ཕྱེར་འདུ་ཤེས་ནས་ཐལ་བ་དེ་སྦྲུས་ཏེ་ཟོས་ཤིང་།",
    "ཁྲུ་བ་ཚ་བ་དང་བྲལ་བ་དང་ཐལ་བའོ་སྙམ་དུ་ཤེས་པར་གྱུར་ཏོ།",
    "ཁྱིམ་བདག་གིས་འདི་ཅི་ཡིན་ཞེས་ཀྱང་དྲིས་ལ།",
    "ཟླ་རལ་དུག་མཚུངས་བུད་མེད་རྣམས།",
    "དེའི་རྒྱུ་ནི་བུད་མེད་ཡིན་པ་དེའི་ཕྱིར་ཡང་བདེ་བ་བུད་མེད་ལས་སྐྱེས་པ་ཡིན་ནོ།",
    "བུད་མེད་ལྷན་ཅིག་སྦྱོར་ན་ཡང་།",
    "འདི་སྐྱེས་བུ་རྣམས་བུད་མེད་དང་ལྷན་ཅིག་ཕྲད་པར་འགྱུར་མོད་ཀྱི།",
    "འདིར་ལྟར་འདོད་ཆགས་དང་བྲལ་བ་མ་ཡིན་ཡང་བསླབ་པ་ལ་གུས་པར་བྱེད་པ་ཁ་ཅིག་དག་འདོད་པ་པོ་མ་ཡིན་བཞིན་དུ་བུད་མེད་དག་གིས་བཙན་ཐབས་ཀྱིས་ཡོངས་སུ་ལོངས་སྤྱོད་ལ།",
    "དེ་དག་ལ་མཛའ་མོ་བདེ་བའི་རྒྱུར་ཡང་མི་འགྱུར་རོ།",
    "གལ་ཏེ་བུད་མེད་དང་སྦྱོར་བ་བདེ་བའི་རྒྱུར་འགྱུར་ན་དེའི་ཚེ་འདོད་པ་དང་བཅས་པ་དང་འདོད་པ་མེད་པ་ཐམས་ཅད་མེས་ཚིག་པའི་སྡུག་བསྔལ་ལྟར་ཁྱད་པར་མེད་པར་འགྱུར་བ་ཞིག་ན།",
    "སྦྱོར་བའི་བདེ་བ་ཀུན་ཏུ་རྟོག་པ་ལོག་པས་བསྐྱེད་པ་དེའི་རྒྱུ་བུད་མེད་ཁོ་ན་ཡིན་གྱི་གཞན་མ་ཡིན་ནོ་ཞེས་བླུན་པོ་མ་ཡིན་པ་སུ་ཞིག་སྟེ་མཁས་པ་སུ་ཞིག་འཛིན་པར་འགྱུར།",
    "བྱིས་པ་རང་གི་ཁྱིམ་ཐབ་ཀྱི་ལས་བྱེད་དུ་བཅུག་པས་མགུ་བ་བཞིན་ནོ།",
    "བྱིས་པ་འགའ་ཞིག་ལ་རང་གི་ཁྱིམ་ཐབས་ཀྱིས་ཁྲུས་བྱ་ཡིས་ཆུ་འོན་ཅིག་ཅེས་སྨྲས་དྷ་ལ།",
    "དེ་བཞིན་དུ་འདོད་པའི་བདག་ཉིད་ཅན་རྣམས་བདག་ཉིད་ཀྱིས་ངལ་བ་ལ་རྩིས་མེད་པར་བྱས་ནས་བདེ་བ་བུད་མེད་ལ་ཡོད་པ་ཁོ་ནར་རློམ་མོ།",
    "གང་གི་ཕྱིར་འདོད་པ་དག་བསྟེན་པའི་ཕྱིར་ན་འདི་ངེས་པར་འདོད་པ་ལས་སྐྱེས་པའི་བདེ་བས་བདེ་བ་དང་ལྡན་པར་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་འདི་དེ་ལྟར་ཡིན་པ་དེའི་ཕྱིར།",
    "གང་གི་ཕྱིར་འདོད་ཆགས་ཀྱི་གཡན་བའི་སྐྱོན་ལས་གྲོལ་བའི་འཕགས་པ་འདོད་ཆགས་དང་བྲལ་ཞིང་།",
    "ཇི་ལྟར་རྒྱན་པོ་དང་ཆང་དང་འཕྲུག་པ་རྣམས་རྫས་དང་ལུས་ཟད་པའི་རྒྱུར་ཡང་དག་པར་གནས་པ་དེ་བཞིན་དུ་བུད་མེད་དང་གཉིས་སྤྲོད་པའི་འདོད་པ་བསྟེན་པ་ཡང་མ་ཡིན་ནོ།",
    "འདོད་པ་དག་ལ་མི་གཙང་བ་ཉིད་ཡོད་མོད་ཀྱི།",
    "དེ་ནི་བུད་མེད་ཕྲད་པའི་ཚེ།",
    "ང་རྒྱལ་དང་བྲལ་བ་འདོད་པ་ཉེ་བར་ལོངས་སྤྱོད་པའི་རེ་བས་ལྡོངས་པ་རྣམས་ལ་ཡང་མཐོང་ངོ།",
    "གང་གི་ཕྱིར་འདི་དེ་ལྟ་ཡིན་པ་དེའི་ཕྱིར་བུད་མེད་དང་ཕྲད་ན་ཆགས་པ་ལ་སྤྱོད་པ་གང་དུ་འགྱུར་བ་དེ་ནི་བདེ་བ་ཡིན་ནོ་ཞེས་བྱ་བ་མི་འཐད་དེ།",
    "བཙོན་རྭར་ཆུད་པ་བ་ལང་གི་ལྕི་བའི་ཁུ་བ་དོན་དུ་གཉེར་བ་བཞིན་ནོ།",
    "བུད་མེད་ཕྲད་ཚེ་ཚུལ་གང་དང་།",
    "གང་གི་ཕྱིར་འདི་ནི་བདེ་བ་ལ་ཀུན་ཏུ་ཆགས་པས་བུད་མེད་དག་ལ་འཛིན་པ་འབྱུང་ལ།",
    "དེའི་ཆེད་དུ་གཞན་དག་ལ་ཕྲག་དོག་པ་དེའི་ཕྱིར་བུད་མེད་ཀྱི་བདེ་བ་ཡོད་དོ།",
    "བུད་མེད་ལ་ལ་ལ་ཆགས་པ།",
    "གང་གི་ཕྱིར་བུད་མེད་དག་ལ་ཀུན་ཏུ་ཆགས་པར་འགྱུར་བ་ཁོ་ན་དང་།",
    "སྐམ་པོ་རྩེ་མོའི་བྲན་མོ་ལ་ཆུ་གྲང་གི་ཕྲོག་བཞིན་ནོ།",
    "གང་གི་ཕྱིར་ན་བུད་མེད་དང་།",
    "མཚན་མོར་མི་གཙང་བ་མནན་པ་བཞིན་ནོ།",
    "འགའ་ཞིག་གིས་མཚན་མོར་རྐང་པ་གཉིས་ཀྱིས་མི་གཙང་བ་མནན་པར་གྱུར་ལ།",
    "དེ་ལ་གཞན་གྱིས་ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་མི་གཙང་བ་མནན་ཞེས་དྲིས་པ་དང་།",
    "དེ་ནས་ཁྱོད་ཅི་སྟེ་འཁྲུགས།",
    "ལུས་ནི་མི་གཙང་བ་ཡིན་མོད་ཀྱི།",
    "བུད་མེད་རྣམས་ནི་ཀུན་ལས་གཙང་།",
    "དེའི་ཕྱིར་བུད་མེད་ཀྱི་ལུས་སྨད་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བར་མི་རུང་ངོ།",
    "བུད་མེད་ཆོལ་ཟངས་ཐོགས་པ་མཐོང་བ་བཞིན་ནོ།",
    "ཕྱུག་པོ་འགའ་ཞིག་ལ་ཆོལ་ཟངས་འཛིན་པའི་བུད་མེད་མཆོག་ཏུ་མཛེས་པ་ཞིག་ཡོད་པ་ལ།",
    "དེ་བཞིན་དུ་བྱིས་པ་རྣམས་རང་གི་ལུས་ལ་གནས་པའི་མི་གཙང་བ་སྐྱོན་དུ་མི་ལྟ་ཞིང་།",
    "ལུས་ལས་ལྷུང་བ་མི་གཙང་བར་རློམ་མོ།",
    "བུད་མེད་ཀྱི་ལུས་ལ་གཙང་བ་ཉིད་ཡོད་དེ།",
    "དེའི་ཕྱིར་ཡང་བུད་མེད་འགོང་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "གང་ལ་རེག་པས་ཨ་ཀ་རུ་དང་།",
    "གང་གི་ཕྱིར་བློ་དང་ལྡན་པ་དག་དེ་ལ་སྨོད་པར་བྱེད་པ་དེའི་ཕྱིར།",
    "བུད་མེད་ཀྱི་ལུས་དེ་ལ་གཙང་བ་ཉིད་ཡོད་དོ་ཞེས་བྱ་བ་མ་ཡིན་ཏེ།",
    "ཕྱུག་ཕྲུག་གཞན་གྱི་ཆུང་མ་ལ་འཕྱན་པ་འགའ་ཞིག་གིས་གཞན་གྱི་ཁྱིམ་དུ་ཕྱིན་པ་དང་།",
    "ལམ་པོ་ཆེའི་དཀྱིལ་དུ་སོན་པ་ལ་མི་དབུལ་པོ་ཞིག་གིས་འདོད་རྒྱལ་དུ་གོས་ཡུགས་ཀྱིས་རེག་པ་དང་།",
    "ཁྱོད་ཀྱི་གོས་ཐ་མལ་པ་འདིས་བདག་མི་གཙང་བར་བྱས་སོ་ཞེས་འདི་ལ་མྱོས་པར་གྱུར་ཏོ།",
    "གང་གི་ཕྱིར་མི་གཙང་བ་ཡོངས་སུ་སྤོང་བར་ཡང་བྱེད་དེ་དེའི་ཕྱིར་ཡང་གཙང་བ་ཉིད་ཡོད་དོ།",
    "ཐབས་གང་གིས་ཀྱང་ལུས་ཀྱི་ནི།",
    "ཁྱོད་ནི་ནང་ལ་འབད་བྱེད་པ།",
    "གཞན་ཡང་གནས་གང་དག་གི་ནང་ནས་མི་གཙང་འབྱིན་པར་བྱེད་པ་དེ་དག་ཉིད་ལ་འདི་ཉེ་བར་ལོངས་སྤྱོད་པའི་རེ་བ་འཆའ་སྟེ།",
    "གྲོང་བའི་མཛའ་བཤེས་འཆག་ཁང་གི་སླར་བསྐོས་པ་མཐོང་བ་དང་།",
    "ཅེ་སྤྱང་གི་པ་ལ་ཤའི་མེ་ཏོག་བཞིན་ནོ།",
    "གྲོང་པ་འགའ་ཞིག་གི་མཛའ་བཤེས་ཞིག་རྒྱལ་པོས་འཆག་ཁང་གི་སླར་བྱས་ལ།",
    "མཛའ་བཤེས་དེས་དེ་ནམ་ཞིག་ན་སྐྱང་ནུལ་དང་བདུག་སྤོས་ལ་སོགས་པ་དག་གིས་འཆག་ཁང་ལ་གཙང་སྦྲ་བྱེད་པ་མཐོང་བས།",
    "དེ་བཞིན་དུ་མི་མཁས་པ་རྣམས་བཟའ་བ་དང་བཏུང་བ་དྲི་ཞིམ་པོ་དག་གིས་ཁོང་ནས་ལུས་ལ་གཙང་སྦྲ་བྱེད་པ་འདོད་པ་ཡང་མཁས་པ་རྣམས་ཀྱིས་བཞད་གད་དུ་བྱེད་དོ།",
    "དེ་བཞིན་དུ་མི་མཁས་པ་རྣམས་ཀྱང་གང་ལུས་ལ་བྱུང་བ་དེ་ནི་མི་གཙང་གི་གང་གནས་པ་དེ་ནི་གཙང་ངོ་སྙམ་དུ་རློམ་མོ།",
    "གང་གི་ཕྱིར་བུད་མེད་ཀྱི་ལུས་གཅིན་ཅན་ཡིན་ཡང་དྲང་སྲོང་བུད་མེད་ཀྱི་བདེ་བའི་ལོངས་སྤྱོད་འདོད་པ་དཀའ་ཐུབ་ཆེན་པོ་ཅན་རྣམས་ཀྱིས་ཀྱང་ཡོངས་སུ་མི་སྤོང་སྟེ།",
    "དེའི་ཕྱིར་བུད་མེད་དག་སྤང་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཆུ་དྲི་ང་བ་འཛག་པ་འདི་ཐུན་མོང་མ་ཡིན་པ་ཉིད་དུ་འགྱུར་ན་ནི།",
    "ཐུན་མོང་ཉིད་ཡིན་ན་གང་གིས་གང་སྤོང་བར་བྱེད།",
    "འདི་ལྟར་སྡུག་བསྔལ་ཐུན་མོང་བ་ནི་དེའི་རྒྱུས་སྨོད་པ་ན་མཛེས་པར་མི་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་ལྟར་གཅིན་ཅན་ཐུན་མོང་བ་ཉིད་ཡིན་པ་དེ་བཞིན་དུ་མཛེ་ཡང་ཡིན་པར་གྱུར་ན་ནི་དེའི་ཚེ།",
    "ཐུན་མོང་མ་ཡིན་པ་འགྱུར་བ་ཉིད་ཀྱི་ཕྱིར།",
    "མཛེ་ཅན་ནི་སྤོང་གི།",
    "ཐུན་མོང་བ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་འབྲུ་མར་གྱི་སྣོད་དུ་སྦྲང་མ་ལྟར་ལ་ལ་དག་དེར་བྱིང་གི་ལ་ལ་དག་ནི་ལྕགས་ཀྱི་ཐུ་ལུམ་འབར་བ་ལ་སྦྲང་བུ་དག་བཞིན་དུ་དེའི་སྐྱོན་མཐོང་བའི་ཕྱིར།",
    "དེའི་ཕྱིར་བུད་མེད་ཀྱི་ལུས་སྤང་བར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་དེ་མ་ཡིན་ཏེ།",
    "དེ་ནས་རྒྱལ་པོ་དེས་རང་གི་དོན་དུ་ཁྲོན་པ་གཡོགས་ལ་ཆར་དེ་ཡང་འབབ་པར་གྱུར་ཏོ།",
    "བཞད་གད་དུ་བྱེད་པའམ་བརླག་པར་བྱེད་པར་འགྱུར་དུ་འོང་གིས་སྙམ་སྟེ་ཆུ་དེ་ཉིད་སྤྱད་པར་གྱུར་ཏོ།",
    "གང་གི་ཚེ་ཐམས་ཅད་ཁོ་ན་གཅིན་ཅན་ཡིན་པ་དེའི་ཚེ་དེ་རྣམས་ལས་གང་དུ་གཙང་བར་འདུ་ཤེས་པར་འགྱུར་ལ།",
    "ཡན་ལག་མ་ཚང་བ་ཞིག་གོ་ཞེས་དེ་དག་གིས་དེ་སྤངས་སོ།",
    "གང་ཞིག་ལང་ཚོ་ལ་བབ་པར་གྱུར་ཏེ་བུད་མེད་ན་ཆུང་འཚོག་ཆས་ཐམས་ཅད་དང་ལྡན་པ་དགའ་བས་ཉེ་བར་ལོངས་མི་སྤྱོད་པ་དེ་གསོན་པའི་འཇིག་རྟེན་ན་མཆོག་ཏུ་བསླུས་པར་འགྱུར་ཏེ།",
    "དེ་ནི་བྱིས་པའི་རང་བཞིན་ཅན་ཉིད་ཀྱིས་ན་ལུས་ཀྱི་སྣ་བརྙན་གང་གིས་ངོ་ཚ་བར་བྱ་དགོས་པ་དེ་ཉིད་ཀྱིས་དགའ་བ་སྐྱེད་པར་བྱེད་པ་དེ་བཞིན་དུ།",
    "བྱིས་པ་རྣམས་ཀྱང་མེ་ཏོག་དང་དྲི་ལ་སོགས་པ་དག་གིས་བཅོ་བ་བྱས་ནས་འདོད་ཆགས་སྐྱེད་པར་བྱེད་དོ།",
    "གལ་ཏེ་ཡོད་པར་མ་གྱུར་ན་ནི་དེ་དག་གིས་སྐྱེ་བོ་འདོད་པ་དག་ལ་ཆགས་པར་མི་འགྱུར་རོ།",
    "དེ་ལ་རེ་ཞིག་མཐོང་བ་མ་ཉམས་པ་རྣམས་ནི་མི་གཙང་བ་ཟག་པས་མི་སྡུག་པར་མཐོང་བའི་ལུས་ལ་ལྟ་བ་ན་འདོད་ཆགས་དང་བྲལ་བར་འགྱུར་རོ།",
    "གཅིག་གིས་འདོད་པ་དང་མི་འདོད་པ་དང་བར་མར་མཐོང་བ་བཞིན་ནོ།",
    "ཚོང་པ་འགའ་ཞིག་བུ་མོ་སྐྱེས་པའི་ཚེ་འགྲོན་ལ་སོང་ལ།",
    "གང་གི་ཚེ་གཞན་ལས་འདི་ནི་ཁྱོད་ཀྱི་བུ་མོ་ཡིན་ནོ་ཞེས་ཐོས་པ་དེའི་ཚེ་འདོད་ཆགས་དང་བྲལ་བ་བཞིན་དུ།",
    "ཤ་ཟ་མོའི་རང་བཞིན་མཐོང་བས་འཇིགས་པ་བཞིན་ནོ།",
    "སྐྱེས་བུ་འགའ་ཞིག་ལ་ཤ་ཟ་མོ་ཞིག་ཆུང་མའི་གཟུགས་ཀྱིས་རྣམ་པར་གནས་ལ།",
    "གང་གི་ཚེ་ན་དེས་དེའི་རང་བཞིན་སྡུག་བསྔལ་བསྐྱེད་པ་དང་།",
    "གཏན་དུ་བ་མ་ཡིན་པ་ཉིད་དུ་མཐོང་བ་དེའི་ཚེ་ན་འདི་ནི་བདག་གི་ཆུང་མ་མ་ཡིན་གྱི།",
    "འདི་ནི་ཤ་ཟ་མོའོ་སྙམ་དུ་འཇིགས་པར་འགྱུར་ཞིང་།",
    "དེ་ཕྱིར་ཉོན་མོངས་ཐམས་ཅད་ནི།",
    "བདག་གམ་བདག་གི་སྙམ་དྲེགས་པ།",
    "སྲིད་པ་ནི་ལས་དང་ཉོན་མོངས་པ་ལ་རག་ལས་པ།",
    "དེའི་ཚེ་བདག་ནི་ཡུལ་ཐམས་ཅད་ཀྱི་བདག་པོ་ཡིན་ལ་ཡུལ་དེ་དག་ཐམས་ཅད་ཀྱང་བདག་གིའོ་སྙམ་དུ་མཐོང་བའི་ཕྱིར།",
    "ཁྱོད་ཀྱི་དྲེགས་པ་ཅི་ཞིག་ཡིན།",
    "ཞིང་བསྲུང་བའི་དོན་དུ་སྐྱེ་བོ་མང་པོས་སྐྱེས་བུ་སྟོབས་དང་ལྡན་པ་ཞིག་གིས་འབྲུའི་དྲུག་ཆའི་གླས་བབ་གླས་པར་འགྱུར་ཏེ།",
    "རྒྱལ་པོ་དེ་ཡང་དཔུང་གི་ཚོགས་དང་བཅས་པར་དེ་ལ་རག་ལས་པར་འགྱུར་མོད་ཀྱི།",
    "དེས་དེའི་རྒྱུས་རྒྱལ་པོ་དཔུང་གི་ཚོགས་དང་བཅས་པ་བདག་ལ་རག་ལས་སོ་ཞེས་རྒྱགས་པར་བྱ་བར་མི་བཟོད་པ་དེ་བཞིན་དུ།",
    "གང་གི་ཕྱིར་རྒྱལ་པོ་རྗེ་བོ་དང་གཏོང་བ་པོ་ཡིན་པ་དེའི་ཕྱིར་ཡང་རྒྱལ་པོ་ལ་དྲེགས་པ་རིགས་པ་ཉིད་དེ།",
    "ཁྱོད་ལ་ཕྱིན་ཅི་ལོག་ཏུ་དྲན།",
    "གཞན་གྱི་ལས་ཀྱིས་འཚོ་ཁྱོད་ཀྱི།",
    "དགའ་བ་གང་གིས་བསྐྱེད་པར་འགྱུར།",
    "དེའི་འབྲས་བུས་ཉེ་བར་འཚོ་བ་ཉིད་ཀྱིས་ཉོན་མོངས་པའི་དགའ་བ་གོ་གང་ཞིག་ཡིན་ཏེ།",
    "ཞེན་པས་གང་གིས་འཇིག་རྟེན་ན།",
    "ཅི་སྟེ་གཅིག་གི་དྲེགས་ཡོད་ཅིང་།",
    "ཁྱོ་ཤུག་ངང་ནགས་དང་སེང་གེ་བཞིན་ནོ།",
    "སྐྱེས་བུ་འགའ་ཞིག་གིས་ཆུང་མ་ལ་བདག་གིས་ནི་སྡུག་བསྔལ་ནི་བརྒྱ་ཕྲག་ཉམས་སུ་མྱོང་ལ།",
    "ཁྱོད་ནི་ཚེགས་མེད་པར་ཁྱིམ་ན་བདེ་བར་འདུག་གོ་ཞེས་སྨྲས་པར་གྱུར་ལ།",
    "དེས་ཀྱང་རེ་ཞིག་ཉིན་ཞག་གཅིག་ཁྱིམ་གྱི་ཞལ་ཏ་གྱིས་དང་དེ་ནས་ཤེས་པར་འགྱུར་གྱིས་ཞེས་སྨྲས་པ།",
    "ཇི་ལྟར་ཁྱོ་ཤུག་གཅིག་གིས་གཅིག་ལ་བསྲུང་བ་དེ་བཞིན་དུ་རྒྱལ་པོས་སྐྱེ་དགུ་རྣམས་བསྲུངས་ལ།",
    "གང་གི་ཚེ་རྒྱལ་པོ་སྐྱེ་དགུ་རྣམས་བུ་ལྟར་སོ་སོར་སྐྱོང་བར་བྱེད་པ་དེའི་ཚེ་དེ་རྣམ་པར་རྒྱལ་བ་ཡིན།",
    "གལ་ཏེ་ཁྱོད་ལ་མི་དགར་འགྱུར།",
    "དེས་ན་ཁྱོད་ལ་འགྲོ་བཟང་དཀོན།",
    "དེང་སང་ན་སྙིགས་མ་ལྔ་པོ་དག་འཇུག་པ་ཤས་ཆེ་བར་གྱུར་པས་རིགས་ལ་བརྟེན་པ་ཐམས་ཅད་རང་རང་གི་ལས་དག་ལ་དགའ་བ་རྙེད་པར་དཀའ་ཞིང་།",
    "དེ་ལྟ་ཡིན་དང་རིགས་ལ་བརྟེན་པ་ཉོན་མོངས་པས་ཟིལ་གྱིས་མནན་པས།",
    "གང་གི་ཕྱིར་འཇིག་རྟེན་ཐམས་ཅད་ཀྱི་བསྲུང་བ་རྒྱལ་པོ་ལ་རག་ལས་པ་དེའི་ཕྱིར་ཡང་ང་རྒྱལ་རིགས་སོ།",
    "ཤན་པ་འགའ་ཞིག་རུས་པ་བརྡུངས་པ་ན་མིག་གི་ནང་དུ་རུས་པའི་འཛེལ་མ་ཞིག་ཞུགས་ཏེ།",
    "བརྩེ་བ་ཅན་དག་ནི་གང་ལས་དེ་དག་གིས་དེ་རྣམས་ཡོངས་སུ་སྐྱོང་བར་འགྱུར་བ་གང་དག་ལ་བརྩེ་བ་ཡོད་པས་ཏེ།",
    "འདི་ལྟར་དེའི་བརྩེ་བ་ནི་གཞན་དག་གི་དོན་མ་ཡིན་པ་འགོག་པའི་བསམ་པ་ཡིན་ལ།",
    "ཐམས་ཅད་དོན་མ་ཡིན་པར་འགྱུར་བའི་ཕྱིར་རང་གི་ལུས་དང་ནོར་ཡང་བསྲུང་བར་བྱ་བར་མི་འགྱུར་བ་ཞིག་ན།",
    "སྲོག་ཆགས་གསོད་པ་འདི་ནི་ཁོ་བོ་ཅག་གི་རིགས་བརྒྱུད་ལས་འོངས་པ་ཞིག་སྟེ།",
    "དེ་ཡོངས་སུ་སྤང་བའི་ཕྱིར་འདི་དམ་པ་མ་ཡིན་པའི་ལྟ་བའི་དཔྱད་པ་དྲི་མ་ཅན་དག་གིས་བདག་ཉིད་དབུགས་འབྱིན་པར་བྱེད་མོད་ཀྱི།",
    "དེ་དག་གིས་ཟོ་ཤིག་ཅེས་སྨྲས་ཤིང་དེ་བཞིན་དུ་ཆུ་འཐུང་ཞིང་གཉིད་ལོག་གམ་ཞེས་བྱ་བ་ཐམས་ཅད་དྲིས་པ་དེ་དག་གིས་གནང་ལ།",
    "ཁྱོད་ཀྱིས་དེ་ལྟར་ཅིའི་ཕྱིར་བྱས་པར་གྱུར།",
    "བདག་གིས་མ་དྲིས་པར་ནི་ཅི་ཡང་མ་བྱས་སོ་ཞེའོ།",
    "ཉོན་མོངས་བཟོ་མཁན་རྣམས་ལ་ཡང་།",
    "ཡང་དཔེར་ན་གོ་མཚོན་རྡུང་བ་རྣམས་མི་བསྲུང་བར་བྱ་བའི་ཕྱིར་གོ་མཚོན་དག་རྡུང་བར་བྱེད་མོད་ཀྱི།",
    "གང་གི་ཕྱིར་འདི་ན་འཇིག་རྟེན་ཐམས་ཅད་ཀྱང་རྒྱལ་པོ་ལ་རག་ལས་ཏེ།",
    "གལ་ཏེ་ཡང་ཁྱིམ་ན་གནས་པ་དང་རབ་ཏུ་བྱུང་བ་དང་བཅས་པ་འཇིག་རྟེན་ཐམས་ཅད་བྱའོ་ཅོག་བྱ་བ་ལ་རྒྱལ་པོ་ལ་རག་ལས་མོད་ཀྱི།",
    "དམ་པ་གཟིགས་པ་ཕྱིན་ཅི་མ་ལོག་པ་མངའ་བ་ཉིད་ཀྱིས་སྨད་པ་ཉིད་དུ་འགྱུར་བ་དེ་བཞིན་དུ།",
    "གལ་ཏེ་ཡང་འཇིག་རྟེན་ཐམས་ཅད་ཀྱི་ཕར་གྱུར་པ་ཡིན་མོད་ཀྱི།",
    "འཇིག་རྟེན་ཡང་བསྲུང་བ་ལ་སོགས་པས་ཕན་འདོགས་པའི་ཕྱིར་ས་བདག་ལ་རག་ལས་མོད་ཀྱི།",
    "རང་གི་དོན་སྒྲུབ་པ་ལྷུར་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "གལ་ཏེ་འཇིག་རྟེན་ཕན་གྱུར་མོད།",
    "གང་གི་ཕྱིར་རྒྱལ་པོ་བློ་ཕུན་སུམ་ཚོགས་ཤིང་བརྩེ་བ་དང་ལྡན་པ་ནི་འཇིག་རྟེན་ཡང་དག་པར་ཡོངས་སུ་སྐྱོང་བར་བྱེད་པ་སྟེ།",
    "འདི་ལྟར་འཇིག་རྟེན་གྱི་བྱ་བ་ལ་གཡེངས་པ་ལ་ཡིད་གཏད་པ་གསལ་བ་འདིས་ལོང་བ་ལྟར་བདག་དང་ལོངས་སྤྱོད་དག་གི་མི་རྟག་པ་ཡེ་རྗེས་སུ་འབྲེལ་བཞིན་དུ་མི་མཐོང་ཞིང་།",
    "ཞག་རེ་ཞིང་རྐུན་པོ་ཉིད་ཡིན་གྱི་རྒྱལ་པོ་མ་ཡིན་ཏེ།",
    "རྒྱལ་པོ་དྲག་པོས་བྱིན་གྱི་བློན་པོ་ཞིག་གིས་ཆད་པས་ཕོག་པའི་མི་གསེར་འཇལ་བར་བྱེད་དུ་གཞུག་པར་མ་ནུས་པར་གྱུར་པས།",
    "ཁྱོད་ཇི་ལྟར་མི་ནུས་ཞེས་དེ་ལ་རྒྱལ་པོ་དེ་ཁྲོས་པར་གྱུར་པ་དང་།",
    "འཇལ་དུ་གཞུག་གིས་ཞེས་སྨྲས་སོ།",
    "མཐར་དེས་གང་གི་ཚེ་མཚོན་ཆས་གསོད་མ་ནུས་པ་དེའི་ཚེ་གནས་ཐམས་ཅད་མེས་བསྲེགས་ཤིང་དེར་སྲོག་ཆགས་འབུམ་ཕྲག་མང་པོ་གསད་པར་གྱུར་ལ།",
    "གང་གི་ཕྱིར་ན་དེ་དག་ལའང་།",
    "གང་གི་ཕྱིར་དེ་དག་ལ་ཡང་དམན་པ་དང་འབྲིང་དང་ཁྱད་པར་དུ་འཕགས་པ་ཉིད་ཡོད་པའི་ཕྱིར་རོ།",
    "འདིར་མཁས་པས་ནི་དྲང་སྲོང་རྣམས་ཀྱི་ལུས་དང་ངག་དང་ཡིད་དག་གི་གཡོ་བ་ཐམས་ཅད་ཁོ་ན་བྱ་བ་མ་ཡིན་ཏེ།",
    "ཉེས་རྨ་དག་གིས་ནན་གྱིས་དྲང་སྲོང་གི་ཡིད་བརྟན་བྲལ་ཁོན་བཅས་བྱེད་འགྱུར་ཏེ།",
    "བ་བེའུ་ཁྱེར་བས་འཇོ་བའི་དུས་ཀྱི་འབུ་སྒྲ་དོག་གིས་ཤིན་ཏུ་ཉེས་བྲལ་བའི།",
    "གཡུལ་ངོར་ཁྱོད་ཀྱིས་འགྲོས་ཚོམ་མེད་པའི་རྒྱུ།",
    "སྐྱེས་བུ་གང་གིས་དོན་བྱས་ནས།",
    "རུལ་བའི་ཤིང་གི་ས་བོན་ལས།",
    "ཙམ་པའི་ཤིང་གི་སྨྱུག་མི་འབྱུང་།",
    "རང་གི་དཔའ་བོའི་རྣམ་པར་གནོན་པས་བསགས་པའི་ནོར་ཕུན་སུམ་ཚོགས་པ་མཐོང་བ་ན་རྒྱལ་པོ་ཡོངས་སུ་དགའ་བར་འགྱུར་ལ།",
    "དེ་ལ་གཡུལ་ངོར་ཤི་བ་གདོན་མི་ཟ་བར་མཐོ་རིས་སུ་འགྲོའོ་ཞེས་ཁྱོད་འདོད་པ་གང་ཡིན་པ་དེ་ནི་མ་ཡིན་ནོ།",
    "གནག་རྫི་མོས་གྱོས་པོ་ལ་ལུས་སྟོབ་པ་བཞིན་ནོ།",
    "གནག་རྫི་མོ་འགའ་ཞིག་གིས་ཁྱོ་འགྲོན་ལ་སོང་བ་དང་།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་ཆུང་མ་ཕྱིས་ཡང་བདག་ཅག་ལ་ཁྱད་གསོད་བྱེད་ན་ནི་ཁྱོད་ཀྱི་ཁྱིམ་དུ་མི་འདུག་གོ་ཞེས་ཀྱང་སྨྲས་སོ།",
    "དེས་དེ་ལ་སྤྱོས་ནས་ཡང་ངའི་ཕ་ལ་ཡང་ཁྱད་གསོད་བྱེད་ན་ནི་ཁྱོད་བདག་གི་ཁྱིམ་དུ་བསྡད་དུ་མེད་ཀྱིས།",
    "དེ་ནས་ཡང་ཁྱོ་འགྲོན་ལ་སོང་བ་དང་།",
    "བཟའ་བ་གྱ་ནོམ་པས་ཉིན་པར་རིམ་གྲོ་བྱས་ཤིང་མཚན་མོ་ཆུ་དྲོན་པོས་དེའི་རྐང་པ་བཀྲུས་ཤིང་།",
    "ཏིལ་མར་བསྐུས་ནས་རང་གི་གོས་ཕུད་དེ་སྒྲོན་མོར་སྦྱོར་བ་ངན་པ་བྱེད་པའི་ཚུལ་གྱིས་དེའི་མལ་དུ་ཉལ་བར་བརྩམས་སོ།",
    "གནག་རྫི་མོས་སྨྲས་པ།",
    "བདག་སལ་ཁྱོས་ཁྱོད་ཀྱིས་འདི་ལ་བྱ་དཀའ་བ་ཡང་གྱིས་ལ་སྦྱིན་པར་དཀའ་བ་ཡང་བྱིན་ཅིག་ཅེས་སྨྲས་ཀྱིས།",
    "དེའི་བུ་དེ་འོངས་པ་དང་ཕ་མ་མཐོང་སྟེ་ཆུང་མ་ལ་དེ་གར་སོང་ཞེས་དྲིས་པས།",
    "སྦྱིན་པར་དཀའ་བ་ཡང་བྱིན་མོད་ཀྱི།",
    "དེ་ལྟར་བྱས་ཀྱང་བདག་ནན་གྱིས་བོར་ནས་སོང་ངོ་ཞེས་སྨྲས་སོ།",
    "ཕ་ལ་སྤྲོ་བསྲིང་བྱས་ནས་རང་གི་ཁྱིམ་དུ་བཅུག་གོ།",
    "ལྷུན་པོའི་རྩེ་མོར་ངེས་འགྲོ་ན།",
    "རྒྱལ་པོ་འཇིག་རྟེན་མགོན་ཁྱོད་ལ།",
    "འདིར་རྒྱལ་པོ་ནི་འཇིག་རྟེན་ཐམས་ཅད་ཀྱི་མགོན་ཡིན་ཏེ་འདི་ལྟར་འཇིག་རྟེན་ནི་དེའི་རྗེས་སུ་བསྟན་པས་རང་གི་སྲོག་དང་།",
    "གང་གི་ཕྱིར་ཆད་པ་ཞན་པའི་རྒྱལ་པོ་ལ་གྲགས་པར་མི་འགྱུར་ལ།",
    "ཁྱོད་ཡོན་མེད་དང་ཁྱི་འཚེད་ལ།"
  ]
