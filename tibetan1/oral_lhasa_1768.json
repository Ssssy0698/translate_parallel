    "སྟོབས་རྣམས་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་༺འབུམ་ཆ་",
    "བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཡོངས་སུ་རྫོགས་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཕྱིར་མྱི་ལྡོག་པའི་ས་ལ་གནས་པར་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཞེས་བྱ་བ་དེ་ལྟར་ཡང་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "མྱིག་ལྔ་བསྒྲུབ་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཏིང་ངེ་འཛིན་ཐམས་ཅད་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "གཟུངས་ཀྱི་སྒོ་ཐམས་ཅད་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་བཅུ་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "མྱི་འཇིགས་པ་བཞི་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞི་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "བྱམས་པ་ཆེན་པོ་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ། ༺འབུམ་ཆ་",
    "ལུས་ལ་སྐྱེས་བུ་ཆེན་པོའི་མཚན་སུམ་ཅུ་རྩ་གཉིས་ཡོངས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དད་པའི་རྗེས་སུ་འབྲང་བའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "བརྒྱད་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ། ༺འབུམ་ཆ་ པོ་ཟོས་ན་༻་ལན་བདུན་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "འོང་བའི་འབྲས་བུ་མངོན་དུ་བྱ་བའི་ཕྱིར་ཞུགས་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དགྲ་བཅོམ་པའི་འབྲས་བུ་མངོན་དུ་བྱ་བའི་ཕྱིར་ཞུགས་པའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དགྲ་བཅོམ་པ་སྟེ་ཚེ་དེ་ཉིད་ལ་ཕུང་པོ་མ་ལུས་པའི་མྱ་ངན་ལས་འདས་པའི་དབྱིངས་སུ་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་བྱའོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ལམ་གྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱི་ཡེ་ཤེས་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་ཡེ་ཤེས་ལ་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "འགྱུར་བ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་གཞག་གོ་ཞེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "པར་མ་གྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཚོར་བའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་འདུ་ཤེས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་འདུ་བྱེད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "རྣམ་པར་ཤེས་པའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ནང་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཕྱི་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཕྱི་ནང་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཆེན་པོ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་དོན་དམ་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་༺འབུམ་ཆ་",
    "པར་མ་གྱུར་ཅིག་འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་རང་བཞིན་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "སྟོབས་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་འཕགས་པའི་བདེན་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "ཅེས་བྱས་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "བསམ་གཏན་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག། ༺འབུམ་ཆ་",
    "ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "སྨོན་པ་མྱེད་པའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "ཏིང་ངེ་འཛིན་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "གཟུངས་ཀྱི་སྒོ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག།",
    "མྱི་འཇིགས་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ཀྱི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ལན་ཅིག་ཕྱིར་འོང་བའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཕྱིར་མྱི་འོང་བའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་དགྲ་བཅོམ་པའི་སྒྲ་ཡོད་པར་མ་གྱུར་ཅིག་ཅེས་བྱ་བར་དམྱིགས་པའི་ཚུལ་གྱིས་གནས་པར་མྱི་བྱའོ།",
    "དེ་ནས་ཚེ་དང་ལྡན་པ་རབ་འབྱོར་ཀྱིས་ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུའི་སེམས་ཀྱི་རྣམ་པར་རྟོག་པ་སེམས་ཀྱིས་ཡོངས་སུ་ཤེས་ནས་ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་ལ་སྨྲས་པ་ཚེ་དང་ལྡན་པ་ཤ་ར་དྭ་ཏིའི་བུ་དེ་ཇི་སྙམ་དུ་སེམས།",
    "རྣམ་པར་ཤེས་པ་ལ་མྱི་གནས་སོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ལ་མྱི་གནས།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ལ་མྱི་གནས།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ལ་མྱི་གནས།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་མྱི་གནས།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་མྱི་གནས་སོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ལ་མྱི་གནས་སོ།",
    "རྣམ་པར་ཤེས་པ་ལ་མྱི་གནས།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ལ་མྱི་གནས།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་༺འབུམ་ཆ་",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ལ་མྱི་གནས།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ལ་མྱི་གནས།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ལ་མྱི་གནས།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་ལ་མྱི་གནས།",
    "པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལ་མྱི་གནས་སོ།",
    "རྣམ་པར་ཤེས་པ་ལ་གནས་པ་ཡང་མ་ཡིན།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ལ་གནས་པ་ཡང་མ་ཡིན།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ལ་གནས་པ་ཡང་མ་ཡིན།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ལ་གནས་པ་ཡང་མ་༺འབུམ་ཆ་",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་གནས་པ་ཡང་མ་ཡིན།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་གནས་པ་ཡང་མ་ཡིན།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ལ་གནས་པ་ཡང་མ་ཡིན།",
    "རྣམ་པར་ཤེས་པ་ལ་གནས་པ་ཡང་མ་ཡིན།"
  ]
