    "ཡུམ་གྱིས་ལངས་ཏེ་དགའ་བ་དང་བཅས་པར་བཅོམ་ལྡན་མའི་བཀའ་དྲིན་གྱིས་སོ།",
    "མ་ལ་ཡ་ཅན་མས་རྗེའི་སྲས་སླར་འཚོ་བར་བྱས་པ་ནི་དགའོ།",
    "ལྟོ་འཕྱེའི་བདག་པོ་རུས་པའི་ལྷག་མར་གྱུར་པ་འདི་དག་སླར་འཚོ་བར་བྱ་བའི་ཕྱིར་འདབ་ཆགས་ཀྱི་བདག་པོ་འགྱོད་པ་ཡང་དག་པར་སྐྱེས་པས་ལྷའི་འཇིག་རྟེན་ནས་བདུད་རྩིའི་ཆར་འབེབས་པར་བྱེད་དོ།",
    "དེ་ཡིས་སྔར་ཟོས་དུག་འཛིན་བདག་པོ་གང་ཡིན་དེ་དག་རྣམས་ཀྱང་ཐམས་ཅད་སོས་པར་བྱས།",
    "ས་གཞི་རྒྱུན་དུ་རབ་འཁྲུངས་ལོ་ཐོག་ལྗང་གུའི་གོས་དང་ལྡན་པར་བྱེད་གྱུར་ཅིག།",
    "ཏིང་ཏིང་ཤག་ལྷུང་བླངས་ནས་ཁུ་བུ་ག་བཞིན་དུ་ཤིན་ཏུ་རབ་སྙན་ཆགས་ལས་སྒྲོགས་གྱུར་ཅིག་རྒུད་པ་དང་བྲལ་ཕྲག་དོག་མེད་པའི་ཡིད་ཀྱིས་ལེགས་བྱས་རབ་ཏུ་རྒྱས་བྱེད་ཅིང་།",
    "ཤཱཀྱའི་དགེ་སློང་འོངས་སོ་ཞེས་བརྗོད་པར་བྱ་ཞིང་།",
    "གལ་ཏེ་སྤྱོན་ཅིག་ཅེས་ཟེར་ན་འཇུག་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ལན་གཉིས་ཉམས་སུ་མ་མྱོང་བ་ལ་ནི་ཉེས་བྱས་ཁོ་ནར་འགྱུར་ཏེ།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གཞན་གྱི་ཚེ་བརྗོད་ན་ནི་ཉེས་བྱས་སོ།",
    "བསླབ་པའི་གཞི་འདྲལ་བ་ཐམས་ཅད་ལ་མ་གུས་པའི་སེམས་བསྐྱེད་པ་དེ་ལ་ཡང་ཉེས་བྱས་སོ།",
    "ཚིག་དངོས་སུ་སྨྲ་བསམ་གུས་པར་ཉན་པ་ཉེ་བར་བསྒྲུབ་པ་འབའ་ཞིག་ཏུ་ཡང་མ་ཟད་ཀྱི་ཚིག་བརྒྱུད་པས་མ་གུས་པར་ཉན་པ་ཉེ་བར་བསྒྲུབ་པ་ཡང་འགྱོད་དུ་གཞུག་གོ།",
    "ཚིག་བརྒྱུད་པའི་གཞུང་ནི་ཁོ་བོ་ལ་ལས་འདིས་ཅི་བྱ་ཁོ་བོ་འདོད་པའི་རྣམ་པར་རྟོག་པ་ལ་ཡང་རྣམ་པར་རྟོག་དགོས་སོ།",
    "གནོད་སེམས་ཀྱི་རྣམ་པར་རྟོག་པ་དང་རྣམ་པར་འཚེ་བའི་རྣམ་པར་རྟོག་པ་ལ་ཡང་རྣམ་པར་རྟོག་དགོས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་དེ་ཡང་འགྱོད་དུ་གཞུག་གོ།",
    "དེ་ཡང་འདིར་བཀག་བར་རིག་པར་བྱའོ།",
    "བྱས་བ་ནི་རུར་བ་མ་ཡིན་པའི་ཕྱིར་ཉེས་བྱས་བྱེད་པ་ཉིད་ཡིན་ནོ།",
    "བཅབ་པ་ཉིད་མ་དྲིས་པར་འཆགས་པ་བླང་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་མ་བཅག་ན་མ་བཤགས་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "ཤིང་བལ་གྱིས་གོས་པར་བྱས་པ་དང་།",
    "གཡན་པ་དག་བ་པ་ལས་གྱུར་པ་དག་ལ་ཡང་དེ་དག་དང་ཞེས་བྱ་བ་བཅད་པ་ཉིད་མ་དྲིས་པར་འཆགས་པ་བླང་བར་མི་བྱའོ་ཞེས་བྱ་བ་དང་།",
    "བཅད་པ་ཉིད་མ་དྲིས་པར་འཆགས་པ་བླང་བར་མི་བྱའོ།",
    "གལ་ཏེ་མ་བཅད་ན་མ་བཤགས་པ་ཉིད་ཡིན་ནོ།",
    "སྤྱིར་བཏང་བར་བྱས་ནས་དམིགས་ཀྱིས་བསལ་བ་བསྟན་པའི་ཕྱིར།",
    "བསླབ་པའི་གཞི་འདིའི་འོག་མའི་གཉིས་པ་ཤིང་བལ་གྱིས་གོས་པར་བྱས་པ་ཞེས་བྱ་བའི་བསླབ་པའི་གཞི་ལ་ནི་བསྡུས་པ་དང་ལྡན་པར་ཤེས་བར་བྱ་སྟེ་བསྡུས་པ་ཉིད་མ་དྲིས་པར་འཆགས་པ་བླང་པར་མི་བྱའོ།",
    "གལ་ཏེ་མ་བསྡུས་ན་མ་བཤགས་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "གོས་པ་མེད་པར་བརྟུལ་བ་སྟེ་བསྡུས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཇེ་འདི་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ནི་གླེང་གཞི་ལས་ཤེས་པར་བྱའོ།",
    "ཁྱིམ་པའི་གནས་མལ་གྱི་གནས་གཞན་གྱི་ཉེན་ཀོར་གྱི་ཕྱོགས་སུ་ཡང་ཉེས་བྱས་སོ།",
    "གཞན་གྱིས་ནི་མགོ་ལོགས་དང་རྐང་པ་ལོགས་མ་གཏོགས་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "མལ་སྟན་ཞེས་སྨོས་པས་འདིར་སྟན་ཡང་འཕངས་པར་རིག་པར་བྱའོ།",
    "འདིར་ལུང་ནི་ཀུན་དགའ་བོ་དེ་དག་ཐམས་ཅད་དུ་འབྱོར་པར་མི་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཕྱོགས་གཅིག་མཐོ་བ་ཉིད་ཀྱིས་ནི་མལ་སྟན་མ་ཐོན་པོ་མ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཚད་ལས་ལྷག་པར་བྱེད་དམ་བྱེད་དུ་འཇུག་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གཉིས་པ་ཞེས་བྱ་བ་ནི་བསླབ་པའི་གཞི་འདིའི་འོག་མ་གཉིས་པ་ཤིང་བལ་གྱིས་གོས་པར་བྱས་པ་དགག་པ་ཞེས་བྱ་བའི་བསླབ་པའི་གཞིའོ།",
    "འོག་མ་ལ་ཡང་ངོ་ཞེས་བྱ་བ་ནི་བསླབ་པའི་གཞི་འདིའི་འོག་མ་ཤིང་བལ་གྱིས་གོས་པར་བྱས་པ་ཞེས་བྱ་བའི་བསླབ་པའི་གཞི་ལ་ཡང་ཁྲིའམ་ཁྲིའུ་དག་ལའོ།",
    "གཞན་གྱིས་བརྩམས་ལ་གཞན་གྱིས་ཟིན་པར་བྱེད་པ་ནི་ཉེས་བྱས་སོ།",
    "རབ་ཏུ་བྱུང་བ་གཞན་ལ་ཡང་ཞེས་བྱ་བ་ཐམས་ཅད་ནི་ཁང་པ་དང་གཙུག་ལག་ཁང་དང་གདིང་བ་དག་ལས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "བདེ་བར་གཤགས་པའི་སོར་བརྒྱད་ཀྱིས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བསླབ་པའི་གཞི་འོག་མ་ཤིང་བལ་གྱིས་གོས་པར་བྱས་པ་དང་།",
    "གཡན་པ་དགབ་པ་ལས་གྱུར་པ་དང་དབྱར་གྱི་རས་ཆེན་ལས་གྱུར་པ་ཞེས་བྱ་བའི་བསླབ་པའི་གཞི་གསུམ་པོ་དག་ལ་ཡང་ཁྲུ་ཚད་ནི་བདེ་བར་གཤེགས་པའི་ཁྲུའི་སུམ་ཆར་གྱུར་པས་རྣམ་པར་གཞག་པར་རིག་པར་བྱའོ།",
    "ཤིང་བལ་གྱིས་གོས་པར་བྱས་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཅི་རང་ཉིད་ཀྱིས་གོས་པར་བྱས་པ་འམ་ཞེ་ན།",
    "འདིར་ཤིང་བལ་ཇི་ལྟ་བུ་ཞིག་ཡིན་པར་རིག་པར་བྱ་ཞེན་དེའི་ཕྱིར་ཤིང་བལ་ནི་ལྔ་སྟེ།",
    "ཚིག་དེ་དག་ནི་གོས་དང་ལུས་མ་རུངས་པར་འགྱུར་བ་དགག་པའི་ཕྱིར་རོ།",
    "ཚད་ལས་ལྷག་པར་བྱེད་དམ་བྱེད་དུ་འཇུག་ན་ཞེས་བྱ་བ་དེ་དང་སྦྱར་རོ།",
    "གདིང་བ་འདིའི་ཚད་ནི་སྲིད་དུ་ཁྲུ་གསུམ་དུ་རིག་པར་བྱའོ།",
    "གང་ལ་ཁྲུ་གསུམ་གྱིས་མི་ཆོག་པ་དེས་ཅི་ཙམ་བསྐྱེད་པས་དོན་གྲུབ་བདེ་ཙམ་བསྐྱེད་པར་བྱ་སྟེ།",
    "ཁྲུ་ཕྱེད་དང་དོ་མན་ཆད་པ་སྐྱེད་པར་བྱའོ།",
    "སྲིད་དུ་ཁྲུ་ཕྱེད་དང་དོ་བསྐྱེད་པར་བྱ་སྟེ།",
    "བསླབ་པའི་གཞི་འདིའི་འོག་མ་གཡན་པ་དགབ་པ་ལས་གྱུར་པ་དང་དབྱར་གྱི་རས་ཆེན་ལས་གྱུར་པ་ཞེས་བྱ་བ་གཉིས་ལས་ཡང་ཚད་པས་ཆུང་བ་ལ་བྱིན་གྱིས་རློབ་པ་ལ་ཉེས་བྱས་སུ་འགྱུར་བའོ།",
    "འདིར་གཞུང་ནི་དབྱར་གྱི་རས་ཆེན་ཆུང་དུལ་བྱིན་གྱིས་རློབ་ན་ཉེས་བྱས་སོ།",
    "གཡན་པ་དགབ་པ་ལ་ཡང་དེ་དང་འདྲའོ་ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "ཅི་དགེ་སློང་ཐམས་ཅད་ལ་འམ་ཞེ་ན་དེའི་ཕྱིར་དེའི་ལུས་ཙམ་མེད་པར་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "སུམ་འགྱུར་དུ་མཆོག་པ་མན་ཆད་ཉིས་འགྱུར་ཡན་ཆད་བྱེད་པ་ལ་ནི་ཉེས་བྱས་སུ་འགྱུར་བར་འདིར་དོན་ཅི་རིགས་པར་སྦྱར་རོ།",
    "འདིར་དོན་དེ་ཡིན་པར་རིག་པར་བྱའོ།",
    "བཅད་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི་ལུས་དང་འབྲེལ་པས་སམ་གཞན་ཡང་རུང་སྟེ།",
    "བྱིན་གྱིས་བརླབས་ནས་སམ་རྣམ་པར་བརྟགས་ནས་སམ་རྣམ་པར་མ་བརྟགས་པར་ཡང་བཅད་བར་མི་བྱའོ།",
    "སོ་སོར་བཤགས་པར་བྱ་བར་གསུངས།",
    "དགེ་སློང་མ་ལས་ཟས་ལེན་པའི་སོ་སོར་བཤགས་པར་བྱ་བ་ལ་བྱེད་པ་པོ་ཉིད་གང་ཡིན་ཞེ།",
    "དེ་ལས་བཟློག་པ་ལ་ནི་ཉེས་བྱས་སོ།",
    "ཡན་ལག་གཅིག་མ་ཚང་བ་ལ་ནི་ཉེས་བྱས་སོ།",
    "འཇོག་པར་བྱེད་པ་ཉེ་བར་མི་གནས་ན་གཞག་པ་ལེན་པ་ནི་དེ་ལས་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "གསུངས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཡིད་གཅུགས་པ་མེད་པས་ལེན་ན་ནི་མ་བྱིན་པར་ལེན་པར་གཏོགས་པའི་ཁ་ན་མ་ཐོ་བར་ཡང་འགྱུར་རོ།",
    "གྲལ་རིམ་དུམ་ཕེབས་པར་འདྲིམ་དུ་འཇུག་པ་མ་བཟློག་པར་ཟའི་སོ་སོར་བཤགས་པར་བྱ་བ་ལ་བྱེད་པ་པོ་གང་ཡིན་ཞེ་ན།",
    "འདི་ལ་བཅའ་བ་བྱིན་ཅིག་ཅེས་བྱ་བ་ནས་བཟའ་བ་བྱིན་ཅིག་ཅེས་བྱ་བའི་བར་དང་ཡང་ལྷག་པར་བྱིན་ཅིག་ཅེས་བྱ་བ་ལ་སོགས་པས་ནི་སྐོ་ཤམ་བྱེད་པ་བསྟན་ཏོ།",
    "དེའི་འོག་ཏུ་འདིར་བྲིམས་ཤིག་ཅེས་བྱ་བ་ལ་སོགས་པས་གྲལ་རིམ་བཞིན་དུ་མདུན་གྱི་བྱུག་རིས་སྟོན་པར་བྱེད་པའོ།",
    "ཅི་ཞིག་བྱས་ན་དེ་བྱད་པ་པོ་ཉིད་ཡིན་ཞེན་དེའི་ཕྱིར།",
    "འདིར་གཞུང་ནི་དགེ་སློང་གཞན་དག་ཟོས་ཏེ་འབྱུང་ཞིང་གཞན་དག་འཇུག་པས་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདིར་ཟན་གཅིག་པ་ཉིད་ཡན་ལག་ཏུ་བཞེད་པས་དེའི་ཕྱིར་ཟ་བར་བྱེད་པ་ཐམས་ཅད་མ་ལངས་པ་ཉིད་ན་འགའ་ཞིག་ལངས་པ་ནི་ལྷན་ཅིག་མི་ཟ་བ་ཉིད་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དགེ་སློང་གཅིག་གམ་གཉིས་མགྲོན་དུ་བོས་པ་ལ་ནི་འདིའི་རྗེས་སུ་འབྲངས་པས་ཉེས་བྱས་སུ་ཤེས་པར་བྱའོ།",
    "གལ་ཏེ་མི་རུང་ན་ཉེས་བྱས་ཀྱིའོ་ཞེས་བྱ་བ་ནི།",
    "མ་དྲིས་པར་ཟ་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "མ་བསྒོ་བར་ཟ་ན་སོ་སོར་བཤགས་པར་བྱ་བར་འགྱུར་རོ།",
    "མ་བསྒོ་བར་ཟ་ན་སོ་སོར་བཤགས་པར་བྱ་བར་འགྱུར་རོ་ཞེས་གསུངས་པ་དེ་གཉིས་ཡིན་ནོ།",
    "འདི་ལ་བསྒོ་བ་ཉིད་དུ་རྣམ་པར་གནས་པ་ནི་ཤེས་གཙོས་སོ་ཞེས་བྱ་བ་ལ།",
    "དེའི་ཕྱིར་དྲི་བ་ལ་བརྩོན་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "འདིར་གཞུང་ནི་རྣམ་པར་འབྱེད་པ་ལས་དགེ་སློང་མ་དེ་ལ་བསྒོ་འམ་ཞེས་འདྲི་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདི་ལ་རྒན་པ་མི་འཇུག་ན་གསར་བུས་འཇུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དྲི་བ་འདི་ལ་རྒན་པས་འཇུག་པར་བྱའོ།",
    "དེ་མི་འཇུག་ན་གསར་བུས་འཇུག་པར་བྱའོ།",
    "བསླབ་པ་དྲལ་ཏེ་ཁྱིམ་དུ་འཇུག་པའི་སོ་སོར་བཤགས་པར་བྱ་བ་སྨྲ་བར་འདོད་ནས།",
    "དད་པ་ཅན་ལ་གལ་ཏེ་བྱིན་ན་དེ་ཕོངས་པར་འགྱུར་བ་ལྟ་ན་ཁྱིམ་གྱི་བསླབ་པའི་སྡོམ་པ་སྦྱིན་པར་བྱའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཁྱིམ་བདག་སྟེ་དེ་ལ་ཁྱིམ་གྱི་བསླབ་པའི་སྡོམ་པ་སྦྱིན་པར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་ལྟ་ན་དེ་ལ་ཁྱིམ་གྱི་བསླབ་པའི་སྡོམ་པ་སྦྱིན་པར་བྱ་སྟེ།",
    "ཁྱིམ་ལ་བརྟེན་པའི་བསླབ་པ་དེ་ཉིད་སྡོམ་པར་གྱུར་ཅིང་ངེས་པ་ཡིན་པས་སྡོམ་པ་སྟེ་དགེ་སློང་སྡོམ་པ་དེ་ལ་གནས་པ་སྦྱིན་པར་བྱའོ།",
    "ལྷུང་བཟེད་སྟོང་པས་འཇུག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེའི་བྱིས་པ་སློང་བ་དག་ལ་བསོད་སྙོམས་ལས་སྣུམ་ཁུར་བྱིན་པར་བྱ་ཞིང་རིལ་གྱིས་ནི་མི་སྦྱིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "བསོད་སྙོམས་རིལ་གྱིས་ནི་སྦྱིན་པར་མི་བྱ་སྟེ།",
    "གལ་ཏེ་དང་པ་ཅན་དེ་བག་ཡངས་སུ་བྱ་བ་དེ་འདོད་པར་གྱུར་ན་དེའི་ཚེ་དེ་ལ་ཁྱིམ་གྱི་བསླབ་པའི་སྡོམ་པ་དེ་བག་ཡངས་སུ་བྱ་ཞིང་གཞིག་པར་བྱའོ།",
    "ནགས་བརྟགས་པ་ལས་གྱུར་པའི་སོ་སོར་བཤགས་པར་བྱ་བ་སྨྲ་བར་འདོད་ནས།",
    "གལ་ཏེ་ནགས་འཇིགས་པ་མེད་པར་གྱུར་ན་བ་དན་དཀར་པོ་དག་བསྒྲེང་བར་བྱའོ།",
    "འདོད་པ་ཉིད་ཡིན་ན་དེ་ལ་ཁེའུ་སུས་དང་གྲོགས་དག་ཀྱང་སྦྱིན་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ནགས་ཉུལ་བའི་དགེ་སློང་དེ་གལ་ཏེ་འདོད་པ་ཉིད་ཡིན་ན་དེ་ལ་ཁེའུ་སུས་ཀྱང་སྦྱིན་པར་བྱ།",
    "ནགས་བརྟགས་པ་ལས་གྱུར་པའི་སོ་སོར་བཤགས་པར་བྱ་བ་འདི་ལ་བྱེད་པ་པོ་གང་ཡིན་ཞེ་ན་དེའི་ཕྱིར།",
    "ནགས་འཇིགས་པ་མེད་པ་ཉིད་དུ་ངེས་པར་མི་ཤེས་པ་ཉིད་ལའོ།",
    "ཅི་ཞིག་བྱས་ན་འདུ་ཤེས་གཙོ་ཆེར་བྱེད་པ་པོ་ཉིད་ཡིན་ཞེ་ན་དེའི་ཕྱིར།",
    "དེ་ལྟར་ཧ་ཅང་རྩེངས་པ་མ་ཡིན་པར་ཟླུམ་པོར་བགོ་བར་བྱའོ་ཞེས་བྱ་བའི་རྗེས་བསྙགས་པའི་ཕྱིར་ཡང་ངོ་ཞེས་བྱ་བའི་སྒྲ་སྨོས་ཏེ།",
    "ཧ་ཅང་འཇོལ་བ་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ལ།",
    "དེ་ལྟ་བུམ་ཡིན་པར་ཤམ་ཐབས་ཟླུམ་པོར་བགོ་བར་བསླབ་པར་བྱའོ།",
    "གྲ་གླང་པོ་ཆེའི་སྣ་ལྟར་ནར་བ་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ལ།",
    "གྲྭ་ཞེས་བྱ་བ་ནི་ཕྱོགས་གཅིག་སྟེ་འདིར་ཁ་ཆར་དང་ཕུན་ཚར་གྱི་མཐའ་མ་བཅད་པའི་གྲ་དག་ནི་གླང་པོ་ཚེའི་སྣ་ལྟར་ནར་བདག་ཡོད་པས་དེ་ལྟ་བུ་མ་ཡིན་པར་ཤམ་ཐབས་ཟླུམ་པོར་བགོ་བར་བསླབ་པར་བྱའོ།",
    "གོང་དུ་མ་ལྟེབས་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "མདུན་གྱི་ལྟེ་བའི་འོག་ཏུ་ཤམ་ཐབས་ཀྱི་ནང་དང་འབྲེལ་བའི་རིམ་པ་སྤྲུལ་མགོའི་གདེངས་ཀ་ལྟར་ཕྱིར་བྱུང་བདེ་ལྟ་བུམ་ཡིན་པར་ཤམ་ཐབས་ཟླུམ་པོར་བགོ་བར་བསླབ་པར་བྱའོ།",
    "ཤམ་ཐབས་བྱིན་གྱིས་མ་བརླབས་པ་ལ་སོགས་པ་དག་ལ་ཡང་རྣམ་པ་འདི་དག་རིག་པར་བྱའོ།",
    "ལག་པ་དང་རྐང་པ་རྐྱོང་བ་ལ་སོགས་པ་མི་བྱ་བར་མཉམ་པར་གཞག་པའི་རྣམ་པས་ཁྱིམ་གཞན་དུ་འགྲོ་བར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ལེགས་པར་བགོས་ཤིང་ངོ།",
    "ལེགས་པར་བགོས་བ་ཞེས་བྱ་བ་ནི།",
    "མིག་གཡེང་བར་མི་བྱ་བ་ཞེས་བྱ་བ་ནི་མིག་འཁྲུལ་པ་མེད་པར་རོ།",
    "དགེ་སློང་དག་ལ་ནི་ཕྲག་པ་གཡོན་པར་གཟར་བར་གྲགས་པ་ཉིད་ཡིན་པ་ཡུལ་ཛ་རྟ་དག་ན་ནི་ངོས་གཉི་གར་རོ།",
    "ལག་པ་གཡས་པ་མདུན་དུ་བཏང་སྟེ་དཔུང་པ་འམ་ཕྲག་པ་འམ་གཉའ་བའི་ཕྱོགས་སུ་བཞག་ལ་གཡོན་པ་ཡང་གཡས་པ་བཞིན་དུ་བྱས་པ་དེ་ནི་གཉའ་གོང་དུ་བསྣོལ་བ་སྟེ་དེ་དེ་ལྟར་མི་བསྣོལ་བར་རོ།",
    "ལྟག་པར་མི་བསྣོལ་བར་རོ་ཞེས་བྱ་བ་ནི།",
    "ཏེ་པོར་བརྐྱང་སྟེ་ལྟག་པ་འམ་དཔུང་མགོར་ལག་པ་གཉིས་ཕན་ཚུན་སྤྲད་ཅིང་བསྣོལ་བ་ནི་ལྟག་པར་བསྣོལ་བ་ཞེས་བྱའོ།",
    "བྲང་བས་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "དཀུར་མི་བརྟེན་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "ལག་པ་མི་ཀྱོག་པར་རོ་ཞེས་བྱ་བ་ཡང་།",
    "ཕྲག་པ་མི་སྤྲད་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "སྟན་ལ་མ་བརྟགས་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་མི་དབབ་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "ལོང་བུའི་སྟེང་དུ་ལོང་བུ་མི་གཞག་པར་རོ་ཞེས་བྱ་བ་ཡང་།",
    "རྐང་པ་མི་འགུག་པར་རོ།",
    "རྐང་པ་མི་གདངས་པར་རོ།",
    "ཐམས་ཅད་དུ་ལེགས་པར་ཁ་ཟས་བླང་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "མུ་དང་ཁ་ད་ཆད་དུ་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ལ།",
    "ཅུང་ཞིག་མ་གང་བ་དེ་ཙམ་དུ་བྱས་ཏེ་བླང་བར་བྱ་བ་ཡིན་གྱི།",
    "ཚོད་མ་དང་མཉམ་པ་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "སྣོད་ཤེས་པར་བྱ་ཞིང་བླང་བ་དེ་གང་ལ་ལྷུང་བཟེད་ལ་ལྟ་བའི་འདུ་ཤེས་ཡོད་པའི་དགེ་སློང་དེ་ནི་ལྷུང་བཟེད་ལ་བལྟ་བའོ།",
    "དེ་ལྟ་བས་ན་ལྷུང་བཟེད་དང་འབྲེལ་པའི་ཡིད་ཀྱིས་ཟས་ལེགས་པར་བླང་བར་བྱ་བ་ཡིན་གྱི།",
    "བཅའ་བ་དང་བཟའ་བ་མ་འོངས་པར་ལྷུང་བཟེད་མི་བཟེད་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "ཇི་སྲིད་དུ་བཅའ་བ་དང་བཟའ་བ་མངོན་སུམ་དུ་མ་འོངས་པ་དེ་སྲིད་དུ་ལྷུང་བཟེད་མི་བཟེད་པར་བསླབ་པར་བྱ་བའོ།",
    "ཡང་འདོད་པའི་ཕྱིར་འབྲས་ཆན་གྱིས་ཚོད་མ་མི་དགའ་ཚོད་མས་འབྲས་ཆན་མི་དགབ་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "ཡང་ཐོབ་པར་བྱའོ་སྙམ་པའི་བསམ་པས་འབྲས་ཆན་གྱིས་ཚོད་མ་མི་དགབ་ཚོད་མས་འབྲས་ཆན་མི་དགབ་པར་བསླབ་པར་བྱའོ།",
    "ཟས་ལ་ལེགས་པར་བྱ་བ་དྲུག།",
    "ལེགས་པར་ཟས་བཟའ་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཁམ་ཧ་ཅང་ཆུང་བ་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ལ།",
    "ཁམ་ཞེས་བྱ་བ་ནི་ཁར་ཁམ་ཚད་དུ་གཞུག་ཅིང་མེད་པར་བྱ་བའི་ཕྱིར་ཁམ་ཞེས་བྱ་བ་སྟེ།",
    "དེ་ཧ་ཅང་ཆུང་དུ་མ་ཡིན་པར་བསླབ་པར་བྱ་བའོ།",
    "ཁམ་ཧ་ཅང་ཆེན་པོ་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "ཁམ་ཧ་ཅང་ཆེན་པོ་ཡང་མ་ཡིན་པར་ཟས་བཟའ་བར་བསླབ་པར་བྱ་བའོ།",
    "ཁམ་རན་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "རང་དང་མཐུན་པ་དང་འཇིག་རྟེན་དང་མཐུན་པའི་ཁམ་རན་པར་བཟའ་བར་བྱའོ།",
    "ཁམ་མ་བཟས་པར་ཁ་མི་གདངས་སོ་ཞེས་བྱ་བ་སྟེ།",
    "འོངས་པ་དེ་སྲིད་དུ་ཁའི་སྒོ་གདངས་པར་མི་བྱ་བའོ།",
    "དེ་དག་ནི་ཁའི་རྣམ་པར་འགྱུར་པའི་སྒྲའི་བྱེ་བྲག་ཡིན་ནོ།",
    "འདིར་ནི་རྣམ་པར་འགྱུར་བ་བྱེད་པའི་ཕྱིར་དགག་པ་ཡིན་གྱི་རྟག་པའི་ཕྱིར་དགག་པ་ནི་མ་ཡིན་ནོ།",
    "ལག་པ་ལ་ཟས་ཆགས་པ་སྤྲུག་པར་མི་བྱ་བའོ།",
    "ཡང་ན་ལག་པ་ལ་ཟས་ཆགས་པ་ལྕེའི་སྟེང་དུ་སྤྲུགས་པར་མི་བྱ་བའོ།",
    "ལྷུང་བཟེད་ཀྱི་ནང་དུ་ཟས་ལ་སོགས་པ་བླུགས་ཏེ་བསྐྱམ་པར་མི་བྱ་བའོ།",
    "ཁྱིམ་བདག་ལ་མ་དྲིས་པར་ཟས་དང་འབགས་པའི་ཆུ་དེ་ཁྱིམ་པའི་ཁྱིམ་དུ་མི་དབོ་བར་བསླབ་པར་བྱ་བའོ།",
    "ཤིང་ཏོག་ལ་སོགས་པ་ཕྱད་ཕྱེད་ཟོས་པ་དང་ངན་མར་གྱུར་པ་ལྷུང་བཟེད་ཀྱིས་མི་འདོར་བར་བསླབ་པར་བྱ་བའོ།",
    "ལྷུང་བ་ཟེད་ལན་གསུམ་དག་པར་བཀྲུས་ཏེ།",
    "འོག་གཞི་མེད་པའི་ས་ཕྱོགས་སུ་ལྷུང་བཟེད་མི་གཞག་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "གད་ག་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "གཡང་ས་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "པར་བསླབ་པར་བྱ་བའོ།",
    "དཀན་གཟར་པོ་མ་ཡིན་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "བང་རིམ་གཞོ་བོ་མ་ཡིན་པར་ལྷུང་བཟེད་གཞག་པར་བསླབ་པར་བྱ་བའོ།",
    "ལྷུང་བཟེད་བཀྲུ་བདེ་གད་ཀ་མ་ཡིན་པ་དང་གཡང་ས་མ་ཡིན་པ་དང་དཀན་གཟར་པོ་མ་ཡིན་པ་དེ་གསུམ་དུ་བྱ་བར་བསླབ་པར་བྱ་བའོ།",
    "ལྷུང་བཟེད་དེས་འབབ་ཆུ་དྲག་པོའི་རྒྱུན་ལས་བཟློག་སྟེ་ཆུ་མི་བཅུ་བར་བསླབ་པར་བྱ་བའོ།",
    "སྟན་དམའ་བ་དང་མཐོ་བ་དེ་ཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "དགེ་སློང་མིན་བར་ཆུའི་ནང་དུ་མཆིལ་མ་ལ་སོགས་པ་འདི་དག་མི་བྱ་ཞིང་མི་དོར་བར་བསླབ་པར་བྱ་བའོ།",
    "གནོད་པ་བྱུང་བ་མ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་གནོད་པ་བྱུང་བ་མ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་བསླབ་པར་བྱ་བའོ།",
    "རྒྱུ་བ་སྟེ་དེ་དག་ནི་ཤམ་ཐབས་ཟླུམ་པོར་བགོ་བར་བསླབ་པར་བྱ་ཞེས་བྱ་བ་ནས་གནོད་པ་བྱུང་བམ་གཏོགས་པར་ཤིང་ལ་མི་གང་ཙམ་ལས་མཐོར་མི་འཛེག་པར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་བར་དང་གོ་རིམས་བཞིན་དུ་སྦྱར་རོ།",
    "ད་ནི་དགེ་སློང་མའི་རྣམ་པར་འབྱེད་པ་བརྗོད་པར་བྱ་སྟེ།",
    "མི་མཐུན་པ་གང་ཡིན་པ་དེའི་བྱེ་བྲག་འདིར་བརྗོད་པར་བྱ་སྟེ།",
    "དཔེར་ན་ཀུན་དུ་སྤྱོད་པ་བསྔགས་པ་ལྟ་བུ་དང་ལ་ལ་ཉེས་པ་ཆུང་པ་ཉིད་དུ་རྣམ་པར་གཞག་པ་ཡང་ཡོད་དེ།",
    "ཞེས་བྱ་བའི་རིམ་གྱིས་དགེ་སློང་མ་རྣམས་ཀྱི་ཕམ་པར་འགྱུར་བ་བརྒྱད་རྣམ་པར་གཞག་པ་དག་བསྡུ་བར་བྱའོ།",
    "སྨྲ་བ་ཞེས་བྱ་བ་གང་དག་བསྟན་པ་དེ་དག་ཐམས་ཅད་ནི་དགེ་སློང་མ་རྣམས་ཀྱི་ཡང་ཡིན་པར་བལྟ་བར་བྱའོ།",
    "འགྱུར་བར་གསུངས་པ་དང་།",
    "ནོམ་པར་བྱེད་ཉུག་པར་བྱེད་ལ་ཞེས་གསུངས་པ་ནི་འདི་དཔེ་ཡིན་ཏེ།",
    "འདི་ལྟར་ནོམ་པར་བྱེད་ཉུག་པར་བྱེད་ལ་ཞེས་བྱ་བ་དེའི་རྣམ་པར་བྱེད་པ་ནི་ལུས་ལ་ལུས་ཀྱིས་ཉེ་བར་གཞོལ་བར་བྱས་ལ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཆགས་པར་གྱུར་པ་ཞེས་བྱ་བ་ནི།",
    "ཆགས་པ་དང་ཀུན་ཏུ་ཆགས་པ་དང་ཀུན་ནས་དཀྲིས་ཤིང་འདོད་པའི་འདོད་ཆགས་ཀྱིས་ཟིལ་གྱིས་གནོན་པ་གང་ཡིན་པའོ་ཞེས་རྣམ་པར་འབྱེད་པ་ལས་འབྱུང་ངོ།",
    "འདིར་སྐྱེས་པའི་འདོད་ཆགས་ལ་ནི་བརྟེན་པར་མི་བྱ་སྟེ།",
    "དེ་ལ་མ་ཡིན་ན་ཡང་མི་ཤེས་ན་ནི་དེའི་ཚེ་ན་སྨད་པ་དེ་ལས་ཀྱང་ན་སྨད་པར་བྱ་སྟེ།",
    "གང་ལ་ན་སྨད་པ་ལ་སྦོམ་པོར་འགྱུར་བ་དེ་ལ་ནི་ཉེས་བྱས་སུ་འགྱུར་ལ།",
    "ཕོའི་འོ་ཞེས་སྨྲས་ན་ཕོ་ཅི་ཙམ་གྱི་ཁ་ན་མ་ཐོ་བ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ཉིད་ཡིན་ཞེ་ན་དེའི་ཕྱིར་འདོད་པ་དང་ལྡན་པ་ལ་བརྟེན་པ་དང་ཚིག་ལ་དེ་དང་ལྡན་པའི་དོན་ཡོངས་སུ་ཤེས་པར་བྱ་བའི་མཐུ་ཡོད་པ་ཉིད་ཀྱིས་ཕོ་ནི་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་སྨྲས་སྟེ།",
    "མཐུ་མེད་པ་ཉིད་ཀྱི་ཕོ་ནི་ན་སྨད་པར་བྱེད་པ་ཉིད་ཡིན་ནོ།",
    "གང་ལ་ལུས་བཀན་པའི་ཕམ་པར་འགྱུར་ཞེ་ན་དེའི་ཕྱིར་ལུས་བཀན་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་སྟེ།",
    "སེམས་ཅི་ལྟ་བུས་ཤེན་དེའི་ཕྱིར་ཆགས་པར་གྱུར་པས་བསྟེན་པའི་ཕྱིར་ཉེ་བར་གནས་པའི་སྐྱེས་པ་ཆགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དགེ་སློང་མ་ཆགས་པར་གྱུར་པས་ལུས་བཀན་ནའོ།",
    "དགེ་སློང་མ་ཆགས་པར་གྱུར་པ་དེས་ཟླ་དེ་ལྟ་བུའི་ཕྱིར་ལུས་བཀན་ན་དེ་ཕམ་པར་འགྱུར་རོ།",
    "བསྲན་པའི་ཕྱིར་ལུས་བཀན་པ་ལ་ནི་ཉེས་བྱས་སོ།",
    "སྐྱེས་པ་དེ་ཡུན་རིང་ཞིག་སྡོད་སྡོད་པས་སེམས་ཁྲོས་པར་གྱུར་ཏམ་སེམས་གཞན་སྐྱེས་པར་གྱུར་པ་ཡང་སྲིད་པས་དེའི་ཕྱིར་ཆགས་པ་ཞེས་བྱ་བའི་ཚིག་སྨོས་སོ།",
    "བསྟེན་པའི་ཕྱིར་ཉེ་བར་གནས་པའི་སྐྱེས་པ་ཆགས་པར་གྱུར་པ་ངེས་དགེ་སློང་མ་དེ་ལ་གལ་ཏེ་སྤྲད་དུ་རུང་བ་ཉིད་ཡིན་ན་སྟེ་དེ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཆགས་པར་གྱུར་པས་ཆགས་པར་གྱུར་པ་དང་ལྟན་ཅིག་གཞོགས་སྟེགས་བྱེད་ན་སྤོམ་པོའི་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་མ་ཆགས་པར་གྱུར་པས་སྐྱེས་པ་ཆགས་པར་གྱུར་པ་དང་ལྷན་ཅིག་གཞོགས་སྟེགས་བྱེད་ན་སྦོམ་པོར་འགྱུར་བའོ།",
    "འདིར་གཞུང་ནི་ཆགས་པར་གྱུར་པས་སྐྱེས་པ་ཆགས་པར་གྱུར་པ་དང་ལྷན་ཅིག་གཞོགས་སྟེགས་བྱེད་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "དགེ་སློང་མ་ཆགས་པར་གྱུར་པས་སྐྱེས་པ་ཆགས་པར་གྱུར་པ་དང་ལྷན་ཅིག་ཕྱར་གཡེང་བྱེད་ན་སྦོམ་པོར་འགྱུར་རོ།",
    "ཤིན་ཏུ་བརྟད་པར་འཇུག་ཅིང་ཧྲལ་བག་བྱེད་པའོ།",
    "དགེ་སློང་མ་ཆགས་པར་གྱུར་པས་སྐྱེས་པ་ཆགས་པར་གྱུར་པ་དང་ལྷན་ཅིག་ཅབ་ཧྲལ་བྱེད་ན་སྦོམ་པོར་འགྱུར་བའོ།",
    "རྩ་བ་ཧྲལ་ཞེས་བྱ་བ་ནི་བཙུན་སྤུ་ཉམས་ཤིང་བསྟེན་པའི་ཕྱིར་གཞོལ་ལ་ངོ་ཚ་མེད་པར་ཞུགས་ཤིང་ཟེ་ལངས་པར་གྱུར་ནས།",
    "དེས་ན་འདིར་མ་ལ་ཤོམ་པར་བྱེད་པ་ལ་སོགས་པ་དག་ཀྱང་སྦོམ་པོར་འགྱུར་བའོ།",
    "བྱ་བས་དང་དུ་ལེན་ན་ནི་ཉེས་བྱས་སོ།",
    "གཞོགས་སྟེགས་ལ་སོགས་པའི་བྱ་བ་གཞན་ནི་ཚིག་ཏུ་མ་སྨྲས་ན་ནི་ཉེས་བྱས་སོ།",
    "གང་ལ་ཁ་ན་མ་ཐོ་བའི་འཆབ་པའི་ཕམ་པར་འགྱུར་ཞེ་ན་དེའི་ཕྱིར་དགེ་སློང་མའི་ཕམ་པར་གྱུར་པ་འཆབ་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དགེ་སློང་མ་དང་འགྲེལ་བའི་ཕམ་པར་གྱུར་བ་བརྒྱད་པོ་དག་ལས་གང་ཡང་རུང་བ་འཆབ་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "སུའི་ཕམ་པར་འགྱུར་ཞེ་ན་དེའི་ཕྱིར།",
    "འདིར་ཉིན་མཚན་གྱི་མཐར་ནི་ཁ་ན་མ་ཐོ་བ་རྫོགས་པར་འགྱུར་ལ་མདུན་རོལ་དུ་ནི་ན་སྨད་པའོ།",
    "ཅི་ཞིག་བྱས་ན་བཟློག་པའི་ཕམ་པར་འགྱུར་ཞེ་ན་དེའི་ཕྱིར་དགེ་སློང་གནས་ནས་ཕྱུང་བ་བཟོད་པར་གསོལ་བ་ངེས་པར་ཕྱག་བྱ་བའི་འོས་མ་ཡིན་པའི་སྡོམ་པ་བྱིན་པར་ཤེས་བཞིན་དུ་དེ་ལས་བཟློག་པ་ཉིད་མི་གཏོང་ནའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཟློག་པར་བྱེད་པ་དེ་ཉིད་ལན་གསུམ་གྱི་བར་དུ་མི་གཏོང་ན་དགེ་སློང་མ་དེ་ཕམ་པར་འགྱུར་བའོ།",
    "དེའི་ཕྱིར་རྣམ་པ་དེ་དག་ཐམས་ཅད་འདིར་ཅི་རིགས་པར་སྦྱར་བར་ཤེས་པར་བྱ་སྟེ།",
    "དེ་ནི་སྨྱན་བྱེད་པ་དང་རིགས་མཐུན་པ་ཉིད་ཡིན་པའི་ཕྱིར་འདི་གསུངས་སོ།",
    "དགེ་སློང་དག་ལ་ཡང་དེའི་རྗེས་སུ་འབྲང་བས་ཉེས་བ་སྦོམ་པོར་འགྱུར་བར་ཤེས་པར་བྱའོ།",
    "འཇུད་པར་བྱེད་པ་ཡིན་པས་འཇུད་པ་སྟེ་དེས་འཇུད་པ་གང་ལ་ཡོད་པ་དེ་ནི་འཇུད་མཐུན་མ་ཡིན་ཏེ་སྨད་འཚོང་མའོ།",
    "ཐམས་ཅད་ལ་བྱེ་བྲག་ནི་ཡོད་པར་རིག་པར་བྱ་སྟེ།",
    "ཅི་ལྟ་བུར་གྱུར་པས་ཤེན་དེའི་ཕྱིར་དགེ་སློང་མ་ཆགས་པར་གྱུར་པས་སོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "འདི་དང་འོག་མ་དག་ལ་ཆགས་པར་གྱུར་པས་ཞེས་སྨོས་པ་ཐམས་ཅད་འཁྲིག་པའི་འདོད་ཆགས་ཀྱིས་ཆགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེའི་ཕྱིར་སྐྱེས་པ་ཆགས་པར་གྱུར་པ་ལས་སོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཆགས་པར་མ་གྱུར་པས་ནི་སྦོམ་པོའི་ཞེས་བྱ་བ་ནི།",
    "ཆགས་པར་མ་གྱུར་པ་ལས་ནི་ཉེས་བྱས་སོ་ཞེས་བྱ་བ་ནི།",
    "ཆགས་པར་མ་གྱུར་པ་ལས་ནི་ཉེས་བྱས་སོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "ཤེས་ཀྱང་རུང་དོགས་ཀྱང་རུང་ཡོད་ཀྱང་རུང་མེད་ཀྱང་རུང་སྟེ་གལ་ཏེ་དགེ་སློང་མ་ལ་ཡོད་པ་ཉིད་ལས་བསྟེན་པར་གྱུར་ན་དེ་ལྟ་ན་ཅི་སྐད་བསྟན་པའི་ཁ་ན་མ་ཐོ་བར་འགྱུར་ཏེ།",
    "དགེ་སློང་མ་ཆགས་པར་མ་གྱུར་པས་ཞེས་བྱ་བ་ནི།",
    "འོག་མ་བཞི་པོ་དག་ལ་ནི་དགེ་སློང་མ་མེད་པར་རོ་ཞེས་བྱ་བ་ནི།",
    "སྦྱོར་བའི་གནས་སུ་ནི་ཉེས་བྱས་སུ་འགྱུར།",
    "ལྟུང་ཞེས་བྱ་བ་ནི་ཕམ་པར་འགྱུར་བའོ།",
    "འདིར་མཐའ་ཙམ་ལ་དངོས་གཞིར་གསུངས་པས་དེའི་ཕྱིར་མདུན་རོལ་གྱི་དུས་ལ་ནི་སྦྱོར་བ་ཉིད་ཡིན་པ་ཁོ་ནས་སྦྱར་རོ།",
    "དགེ་སློང་མ་མེད་པར་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དགེ་སློང་མ་མེད་པར་རོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "གཅིག་པུ་ཉེ་དུའི་ཁྱིམ་དུ་ཟན་གྱི་ཕྱིར་ལོ་ཉེས་བྱུང་བའི་ཚེ་ཉེ་དུ་རྣམས་དང་ལྷན་ཅིག་འབྲེལ་པའི་ཉེ་བར་སྤྱོད་པ་གནང་བ་ཐོབ་ན་འགྲོ་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཉེ་དུ་རྣམས་དང་ལྷན་ཅིག་འབྲེལ་པའི་ཉེ་བར་སྤྱོད་པའི་གནང་བ་ཐོབ་ནའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེ་སྦྱིན་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་མ་མེད་པར་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དགེ་སློང་མ་མེད་པར་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་ལྟ་བས་ན་འདིར་ཕ་རོལ་དུ་ཞེས་སྨོས་པ་ནི་དཔེ་ཙམ་དུ་ཟད་པར་ཤེས་པར་བྱའོ།",
    "ཡུང་ཕྲན་གྱི་ཕ་རོལ་དུ་ནི་ཉེས་བྱས་སོ་ཞེས་བྱ་བ་ནི།",
    "མཆོངས་པས་རྒལ་བར་ནུས་པ་སྟེ་དགེ་སློང་མ་གཅིག་པུ་རྒལ་བ་དེའི་ཕ་རོལ་དུ་ཕྱིན་ན་ཉེས་བྱས་སོ།",
    "རྒྱུན་ལྷག་མ་དག་ལ་ནི་སྔ་མ་བཞིན་ཅི་རིགས་པར་སྦྱར་རོ།",
    "ཁྱིམ་པའི་རྟགས་སྤོང་དུ་འཇུག་ཅིང་རབ་ཏུ་བྱུང་བའི་རྟགས་ཡང་དག་པར་ལེན་དུ་འཇུག་པའོ།",
    "གལ་ཏེ་དང་པོ་ཁོ་ནར་དགེ་ཚུལ་ལ་སོགས་པའི་དངོས་པོ་བྱེད་ན་ཡང་ཁན་མ་ཐོ་བ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
    "ཉེ་བར་སྡུད་པ་ལ་སོགས་པ་ནི་འདིར་སྦྱོར་བའི་སྦྱོར་བ་ཉིད་དེ་ཉེས་བྱས་སོ།",
    "གང་ཞིག་ཅེ་ན་དེའི་ཕྱིར་ཚོགས་པ་ཡིད་མཐུན་པ་བདག་པོས་ཡོངས་སུ་བཏང་བ་རྒྱལ་པོས་རྗེས་སུ་གནང་བའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཡན་ལག་དེ་དག་ལས་གཅིག་ཡོད་ན་ནི་སྤོམ་པོ་སྟེ་དེའི་ཕྱིར་ཚོགས་པ་ཡིད་མཐུན་པ་ཉིད་ལ་སོགས་པའི་ཡན་ལག་གསུམ་པོ་དེ་དག་ལས་ཡན་ལག་གཅིག་ཡོད་ན་ཡང་སྦོམ་པོ་ཁོ་ནར་འགྱུར་བར་རིག་པར་བྱའོ།",
    "འདིར་དེ་ལ་སྦྱོར་བའི་དགེ་སློང་མ་གཞན་ལ་ནི་ཉེས་བྱས་སོ།",
    "རྒྱལ་པོས་རྗེས་སུ་གནང་བའི་གཞི་དེ་དག་ཤེས་པ་ཉིད་ཀྱིས་ཏེ།",
    "བསྡིགས་པ་ལ་སོགས་པའི་ཆད་པའི་ལས་ལ་རྣམ་པར་གཞག་པའི་དགེ་སློང་མ་མཚམས་ཀྱི་ཕྱི་རོལ་དུ་ཁྲིད་དེ་བཟོད་པ་གསོལ་དུ་གཞུག་ཅིང་དེ་ལས་བཟོད་པ་ལེན་པར་བྱེད་པའི་དགེ་སློང་མ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "ཆད་པས་གཅོད་པར་བྱེད་པ་གང་ཟག་དག་མ་ཚོགས་པར་འོག་ཐུག་ཐུབ་ཏུ་བཟོད་པ་གསོལ་དུ་འཇུག་པ་དེ་ལ་འདི་གཙོ་ཆེ་བ་ཡིན་ནོ།",
    "འདི་དང་མཚུངས་པ་ཉིད་ཀྱི་དགེ་སྦྱོང་གཞན་དག་ཀྱང་ཡོད་ཀྱིས་དེ་དག་ལ་ཚངས་པར་སྤྱོད་པ་ཉིད་སྤྱོད་དོ་ཞེས་བྱ་བའི་ཚིག་དེ་ལ་ཞུགས་པའི་མི་གཏོང་བ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "འགྱེད་པ་ཞེས་བྱ་བ་ནི་ཤགས་འགྱེད་པའོ།",
    "གང་ཟག་གཞན་དང་ལྷན་ཅིག་འཐབ་ཀྲོལ་ལ་སོགས་པ་བྱེད་པ་ལ་ནི་ཉེས་བྱས་སོ།",
    "ཙབ་ཧྲལ་གྱི་རྒྱུར་གྱུར་པ་ནི་ཀུན་དུ་ཅ་ཅོ་འདོན་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཁ་ཅིག་ཏུ་ནི་ཉེས་བྱས་སོ།",
    "དེའི་ཕྱིར་མལ་ཤོམ་དུ་འཇུག་པ་ལ་སོགས་པ་བྱེད་པ་ནི་ཉེས་བྱས་སོ།",
    "དེ་དག་ཀྱང་གང་དག་ཡིན་པར་བལྟ་བར་བྱ་ཞེན་དེའི་ཕྱིར་བཅུ་པའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེ་དག་ཀྱང་གང་དག་ཡིན་པར་བལྟ་བར་བྱ་ཞེ་ན་དེའི་ཕྱིར།",
    "དེ་ལ་ནི་ཕོ་ཉིད་དོ་ཞེས་བསྟན་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དགེ་སློང་མ་རྣམས་ལ་འདིར་དེ་དག་རྣམ་པར་མི་གཞག་གོ།",
    "འཁྲུ་བ་དང་ནི་ཞེས་གསུངས་པ་རྣམ་པ་བདུན་པོ་སྲིན་བལ་གྱི་སྟན་དང་།",
    "སྣོད་ཟམ་ཏོག་མེ་ཏོག་ལ་སོགས་པས་བརྒྱན་ཅིང་ས་ལས་བྱས་པའི་གཟུགས་ཀྱིས་བཀང་བ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "ལྷུང་བཟེད་ལྷག་པ་ཞག་གཅིག་ལས་འདས་པར་འཆང་བ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཞག་བཅོ་ལྔ་པ་དེ་ཉིད་ནི་ཟླ་བ་ཕྱེད་པ་ཕྱི་མ་ཤོས་ཀྱི་ཉི་མ་དང་པོ་ཉིད་ཡིན་པར་རྣམ་པར་གཞག་སྟེ།",
    "དེ་ཕྱིན་ཆད་ཀྱང་ཚུལ་དེ་བཞིན་དུ་ཟླ་བ་ཕྱེད་ཕྱེད་ཅིང་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "སྲ་བརྐྱང་འབྱིན་པ་ལ་སོགས་པ་བཅུ་པོ་དག་ནི་དགེ་སློང་ལ་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དེའི་རྣམ་པར་འབྱེད་པ་ལས་མངོན་མཚན་ཅན་ཞེས་བྱ་བ་ནི།",
    "དབྱིག་གམ་གསེར་རོ་ཞེས་གསུངས་ཏེ།",
    "གཞན་གྱི་ཆེད་དུ་རྙེད་པའི་གོས་ཟས་སུ་བྱས་ཏེ་བཟའ་བའི་ཕྱིར་འཇོག་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཟས་ལས་གཞན་བ་གླེགས་བམ་བྲི་བ་ལ་སོགས་པའི་ཆེད་དུ་རྙེད་པའི་གོས་ཟས་སུ་བསྒྱུར་ཅིང་བྱས་ཏེ་བཟའ་བར་བྱའོ་ཞེས་དེའི་ཕྱིར་དེས་པར་འཇོག་པར་བྱེད་པ་ལ་སྤང་བར་འགྱུར་རོ།",
    "དེ་གསུམ་གྱི་ཆེད་དུ་ཡོ་བྱད་གང་ཡང་རུང་བ་རྙེད་པ་ཟས་སུ་བྱས་ཏེ།",
    "གོས་ཀྱི་ཆེད་དུ་ཡོ་བྱད་གང་ཡང་རུང་བ་རྙེད་པ་ཐས་སུ་བྱས་ཏེ་བཟའ་བའི་ཕྱིར་འཇོག་པ་ལ་ནི་གོས་རྒྱུ་ཟ་བ་ལས་གྱུར་བའི་སྤང་བར་འགྱུར་རོ།",
    "མལ་ཆ་དང་སྟན་གྱི་ཆེད་དུ་ཡོ་བྱད་གང་ཡང་རུང་བ་རྙེད་པ་ཟས་སུ་བྱས་ཏེ་བཟའ་བའི་ཕྱིར་འཇོག་པ་ལ་ནི་མལ་ཆ་རྒྱུ་ཟ་བ་ལས་གྱུར་བའི་སྤང་བར་འགྱུར་བའོ།",
    "ཁྱིམ་པའི་ཕྱིར་སྦྱོར་དུ་བཅུག་པ་རང་ལ་ཡོངས་སུ་བསྒྱུར་བ་ལ་ནི་ཉེས་བྱས་སོ།",
    "གང་ལ་བཅིང་བ་འགྲོལ་དུ་འཇུག་པའི་སྤང་པར་འགྱུར་ཞེ་ན་དེའི་ཕྱིར་ཚིག་ཉན་དུ་གཞུག་པའི་ཕྱིར་རྫས་བཅིངས་པ་འགྲོ་ལ་དུ་འཇུག་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "མཚན་ཐ་དད་པ་མ་ནིང་མ་ཡིན་པའི་སྐྱེས་པ་བསྟེན་པའི་མཐུ་ཡོད་པ་དེ་ལྟ་བུའི་ཟླ་པོ་ལ་བཅིངས་པ་འགྲོལ་དུ་འཇུག་ན་ཁ་ན་མ་ཐོ་བ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
    "མཚན་མཐུན་པ་ལ་སོགས་པ་ལ་ནི་ཉེས་བྱས་སོ།",
    "གཞན་གྱིས་གོན་པ་ལ་ཡང་སྤང་བར་བྱ་བའི་དངོས་པོ་མེད་དུ་ཟིན་ཀྱང་ཁ་ན་མ་ཐོ་བ་ནི་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
    "སོགས་པ་ཞེས་བྱ་བའི་སྒྲས་འདིར་ནི་གྲངས་ཉུང་དུ་བཞི་དང་གསུམ་དང་གཉིས་དག་བསྡུ་བར་རིག་པར་བྱའོ།",
    "མཐར་ཐུག་པའོ་ཞེས་སྨོས་པས་ནི་ལྗིད་སྲང་གཅིག་པ་འམ་གཞལ་དུ་མེད་པའི་གོས་ཀྱི་མཐར་ཐུག་པ་དག་བསྡུ་བར་ཤེས་པར་བྱའོ།",
    "འདིར་གཞུང་ནི་ཡང་བ་ཞེས་བྱ་བ་ནི་སྲང་ལྔ་པ་འམ་ལྔ་ལས་ཆུང་བའོ་ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "འདི་ལྟ་སྟེ་མ་བསྐོས་པར་སྟོན་པ་དང་།",
    "འདི་ལྟར་དགེ་སློང་མ་རྣམས་ཀྱིས་དགེ་སློང་དག་ལ་བསྟན་པར་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "དབྱར་གྱི་རས་ཆེན་ལས་གྱུར་པའི་ལྷུང་བྱེད་ཀྱང་དགེ་སློང་མ་རྣམས་ལ་རྣམ་པར་མི་གཞག་སྟེ།",
    "ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འགྲེད་པ་དང་།",
    "ཕྱིར་མ་བླངས་པར་སྤྱོད་པ་དང་།",
    "འདི་ལྟ་སྟེ་བསླབ་པ་ལ་མ་བསླབས་པ་བསྙེན་པར་རྫོགས་པར་བྱེད་པ་སྟེ་སྐྱེས་པ་ལ་དགེ་སློང་མའི་བསླབ་པ་རྣམ་པར་མ་བཞག་པའི་ཕྱིར་རོ།",
    "ལ་ལ་ཇི་ལྟར་ཐོབ་པ་ལས་ཉེས་བྱས་སུ་འགྱུར་བ་ཡང་ཡོད་དེ་འདི་ལྟ་སྟེ་གཉིས་སྟེན་ཅིང་མལ་སྟན་གཅིག་ན་ཉལ་བའོ།",
    "འདིར་དགེ་སློང་མའི་སྐབས་ལས་ཕྲན་ཚེགས་ལས་གསུངས་པ་ཅུང་ཞིག་བསྡུ་བར་བྱ་སྟེ།",
    "སྔོན་ཁྱིམ་པར་གནས་པའི་ཚེ་ཆུང་མ་ཉིད་དུ་གྱུར་པ་ཉིད་ལ་སྟེ།",
    "དགེ་སློང་མ་དེས་ཟང་ཟིང་ཉེ་བར་སྒྲུབ་པར་བྱེད་པའི་དགེ་སློང་དེ་ལས་ཟང་ཟིང་བླང་དུ་རུང་བ་ཁོ་ན་ཡིན་ནོ།",
    "གནང་བ་ཐོབ་བའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེ་ལ་གནང་བ་སྦྱིན་པར་རིགས་སམ་ཞེ་ན་དེའི་ཕྱིར་དེ་སྦྱིན་པར་བྱའོ་ཞེས་བྱ་བ་དེ་སྨྲས་ཏེ།",
    "མ་ལོན་པས་ཉེ་བར་འཇོག་པ་ལ་སོགས་པ་ནི་བརྟུལ་ཞུགས་ལས་གྱུར་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "འདོད་པ་བསྟེན་པ་ལ་སོགས་པ་ནི་ཚངས་པར་སྤྱད་པ་ཡོངས་སུ་བསྲུངས་པ་ལས་གྱུར་པ་ཡིན་ནོ།",
    "རབ་ཏུ་འབྱིན་པ་དང་བསྙེན་པར་རྫོགས་པར་བྱེད་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "རབ་ཏུ་འབྱིན་པ་དང་རྫོགས་པར་བསྙེན་པར་བྱེད་པའི་ཡུལ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "གལ་ཏེ་རྫོགས་པར་བསྙེན་ནས་ལོ་བཅུ་གཉིས་མ་ལོན་པ་ཉིད་ཡིན་ནའོ།",
    "ཅི་ཐམས་ཅད་ལ་སྦྱིན་པར་བྱ་བའམ་ཞེ་ན་དེའི་ཕྱིར་དེ་ཉེ་བར་འཇོག་ནུས་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "འདིར་འཁོར་ཉེ་བར་གཞག་པར་གསོལ་བ་དང་གནང་བ་ནི།",
    "བདག་དགེ་སློང་མ་མིང་འདི་ཞེས་བགྱི་བ་ལོ་བཅུ་གཉིས་ལོན་ལགས་ཏེ།",
    "འཁོར་ཉེ་བར་བཞག་པར་སྤྲོ་ན།"
  ]
}