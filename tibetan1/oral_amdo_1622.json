    "གྲུབ་འགྱུར་དེ་དག་གིས་དེའི་དོན།",
    "གང་གིས་དེའི་ཚེ་དངོས་པོ་མེད་པར་འཇུག་པ་ན་དེས་འདི་ལས་ཐ་དད་པར་འཛིན་པ་དེ་ལྟར་བཟུང་བ་ནི་དེའི་ཚེ་འགལ་ཟླར་དྲན་པ་ནི་མི་སྲིད་དོ།",
    "དངོས་པོ་མེད་པར་རྟོགས་པས་གཞན་གྱིས་ཅི་ཞིག་བྱ་དངོས་པོ་མེད་དེ་རྟོགས་ཀྱང་རང་གི་ངོ་བོ་ཁྱད་པར་རྟོགས་པ་མེད་པ་ནི་ཁྱད་པར་ཅན་གྱི་རང་བཞིན་མྱོང་བ་མ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོ་ཉིད་རྟོགས་པ་ནི་གདོན་མི་ཟ་བར་འདོད་པར་བྱ་བ་ཡིན་ནོ།",
    "དངོས་པོ་མེད་པར་གཞན་གྱི་རང་བཞིན་ནི་རང་གི་ངོ་བོར་རྟོགས་ནུས་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "གལ་ཏེ་རང་གི་ངོ་བོ་ནི།",
    "དེ་ལྟར་ཡང་མ་དམིགས་སོ་ཞེས་སྐྱེས་བུ་མཆོག་གིས་དམིགས་པ་གསལ་གྱི་དོན་མེད་དོ་ཞེས་ནི་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་ན་ཁྱད་པར་མེད་པར་འགྱུར་མོད།",
    "གང་གི་ཚེ་ཡོད་པ་དང་དམིགས་པ་དག་གཅིག་ཉིད་ཡིན་པ་དེའི་ཚེ་དངོས་པོའི་ལྡོག་པ་ཡང་མངོན་སུམ་གྱིས་གྲུབ་པ་ཉིད་ཀྱི་དུམ་བུར་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་མ་རྨོངས་པ་ལས་ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་དངོས་པོ་མེད་པའི་སྒྲུབ་བྱེད་ཡིན་ན་རྨོངས་པས་ཀྱང་དེ་ཉིད་དྲན་པས་ཡུལ་དུ་བྱེད་པར་འགྱུར་མོད།",
    "ཁས་བླངས་ནས་ཐལ་བར་བསྒྲུབ་པ་ལ་ནི་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "འདི་ན་གྲང་བའི་རེག་པ་མེད་དེ།",
    "རང་གི་སྦྱོར་བ་དག་ལ་དེའི།",
    "རང་གི་ངོ་བོ་སྦྱོར་བའམ།",
    "གང་གི་ཚེ་རབ་ཏུ་དབྱེ་བ་དུ་མ་འདི་དག་དེ་ཉིད་ཀྱི་ཡིན་པ་དེའི་ཚེ་ཉེས་པ་འདི་མེད་དེ།",
    "འདི་ལྟར་རང་གི་ངོ་བོ་དང་རྒྱུ་དང་ཁྱབ་པར་བྱེད་པ་དང་།",
    "འབྲས་བུ་མི་དམིགས་པ་ཞེས་བྱ་བར་རང་གི་ངོ་བོས་སྦྱོར་བའམ་ཡང་ན་འདི་ན་གྲང་བའི་རེག་པ་མེད་དེ།",
    "མེ་ཡོད་པའི་ཕྱིར་རོ་ཞེས་དགག་པར་བྱ་བའི་དོན་ལ་གནོད་པར་བྱེད་པའི་རང་གི་ངོ་བོས་སོ།",
    "དྲོ་བ་ཡང་མ་ཡིན་གྲང་བ་ཡང་མ་ཡིན་པའི་རེག་པའམ་དྲོ་བའི་རེག་པ་དེ་ཉིད་ཀྱང་དེས་དབེན་པ་ཡིན་པའི་ཕྱིར་གྲང་བ་མེད་པ་ཡིན་ཏེ།",
    "འདི་ལྟར་ལྟོས་པ་དང་བཅས་པ་ལས་ནི་ངེས་པར་འགྱུར་བ་མེད་པ་ཡིན་ལ་ངེས་པར་འགྱུར་བ་ཡོད་པ་དང་མེད་པ་དག་གིས་ཀྱང་དོན་དམ་ཕན་ཚུན་སྤངས་པས་འགལ་བ་ཡིན་ནོ།",
    "དེ་ལ་གཉིས་སམ་གསུམ་སྒྲ་གཅིག་གིས་བསྟན་པ་ནི་དེ་གཏན་ཚིགས་གཞན་ཉིད་དུ་འགྱུར་བ་མ་ཡིན་ནོ།",
    "འདི་ན་གྲང་བའི་རེག་པ་མེད་དེ་དུ་བ་ཡོད་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་དུ་བ་ལས་མེ་རྗེས་སུ་དཔོག་པ་ནི་འབྲས་བུའི་གཏན་ཚིགས་སོ།",
    "མེས་གྲང་བའི་རེག་པ་མེད་པར་བསྒྲུབ་པ་ནི་འགལ་བ་དམིགས་པ་ཡིན་ལ།",
    "གསུམ་པོ་རྣམས་སྒྲ་གཅིག་གིས་བསྟན་པས་གཅིག་ཉིད་དམ།",
    "རྒྱུ་གཞན་དེ་ཡང་རང་གི་རྒྱུ་ལ་ལྟོས་པའི་ཕྱིར་ངེས་པ་མ་ཡིན་ལ།",
    "གལ་ཏེ་རང་གི་རྒྱུ་དེ་ཉིད་ཀྱིས་འཇིག་པ་བསྐྱེད་ནས།",
    "གལ་ཏེ་རང་གི་ངོ་བོས་གྲུབ་པ་ཡིན་པའི་ཕྱིར་འཇིག་པའི་རྒྱུས་བདག་ལ་ཕན་འདོགས་པར་བྱེད་པ་ནི་མི་སྲིད་ན།",
    "གལ་ཏེ་གྲུབ་པ་ཉིད་ཡིན་ན་སྔ་མ་བཞིན་དུ་ཐལ་ལོ།",
    "གཞན་ཡང་དངོས་པོ་རང་གི་རྒྱུ་ལས་དུས་གཞན་ཁྱབ་པའམ།",
    "དེ་ལྟ་ཡིན་ན་རང་གི་ཡུལ་ངེས་པས་མ་རྟོགས་པར་ཅི་ལྟར་འཇིག་པའི་རྒྱུ་འཇུག་པར་འགྱུར།",
    "ངེས་པར་བརྟགས་ན་རང་གི་ངོ་བོར་གྲུབ་པ་ལ་འཇིག་པའི་རྒྱུ་ཉེ་བར་སྦྱོར་བ་ཅི་ཡོད།",
    "འགལ་བའི་རང་བཞིན་གྱོ་མོ་ལ་ཉེ་བར་སྦྱོར་རོ་ཞེ་ན།",
    "དེ་ལ་ཡང་ཐལ་བ་སྔ་མ་ཉིད་སོ་ན་འདུག་གི།",
    "འོན་ཏེ་དེ་ཉིད་འཇིག་པའི་རྒྱུས་གྱོ་མོ་ལ་སོགས་པ་གཞན་ཉིད་དུ་བྱེད་དོ་ཞེ་ན།",
    "དེས་ན་བུམ་པ་རང་གི་ངོ་བོར་མཐོང་བར་འགྱུར་བས་ན་ཅི་ལྟར་གཞན་དུ་གྱུར།",
    "འོན་ཏེ་བུམ་པ་མ་མཐོང་ན་འདི་གང་གིས་གཞན་དུ་གྱུར་པ་ཡིན།",
    "གང་གི་ཚེ་དངོས་པོ་ཡོད་པ་དེ་ཉིད་ཀྱི་ཚེ་འཇིག་པ་ཡོད་པ་དེ་ན་འཇིག་པ་དང་ལྡན་པ་ཞེས་བྱ་བར་འཐད་དོ།",
    "ཕྱི་མ་དང་ལྷན་ཅིག་འབྱོར་པར་འཛིན་ན་ནི་འཆི་བའི་མཐར་ཐུག་པ་གཟུང་བར་ཐལ་ལོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "གང་གིས་ལྟོས་ནས་འཇིག་པ་དེ་ལྟ་བུ་དེ་ནི་དེའི་རང་བཞིན་གྱི་ངོ་བོ་ཡིན་ནོ་ཞེ་ན།",
    "དང་པོ་ཁོ་ནར་མངོན་སུམ་གྱིས་ཆད་པ་ཉིད་དུ་མཐོང་བ་ན་འགའ་ཞིག་གི་ཚེ་ཡང་དེ་ལྟ་མ་ཡིན་ན་ཅི་ལྟར་འགྱུར་ཏེ་དཔེར་ན་རྟག་པར་སྨྲ་བ་དེ་ཉིད་འཇིག་པའི་གནས་སྐབས་སུ་གྱུར་པ་བཞིན་ནོ།",
    "འཇིག་པ་ཐ་དད་པ་ཡོད་ཀྱང་རང་གི་ངོ་བོ་ལས་འཕོས་པ་མེད་པས་ཇི་ལྟར་འཇིག་པ་ཡིན།",
    "ཡིན་ལ་རག་མོད་དེ་ལྟ་ན་ཡང་།",
    "དཔེར་ན་གང་གིས་བྱེད་པ་སྲིད་པ་དང་བྲལ་བའི་རྒྱུ་ཚོགས་པ་ཐ་མ་རང་གི་འབྲས་བུ་སྐྱེད་པ་ལ་འགལ་བ་ལ་ཡང་ལྟོས་པ་མེད་པས་དེ་ལ་ངེས་པ་དེ་བཞིན་དུ་དངོས་པོ་ཡང་འཇིག་པ་ལྟོས་པ་མེད་དེ།",
    "འཆི་བའི་མཐར་ཐུག་པར་རྟོགས་པར་ཐལ་ལོ་ཞེས་བསྟན་ཟིན་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་འདི་རང་གི་རྒྱུ་ལ་མ་འབྱོར་པ་ཉིད་དུ་སྐྱེས་ན།",
    "དེའི་ཕྱིར་རང་གི་ངོ་བོས་སྐད་ཅིག་མར་གྱུར་པ་ཉིད་མངོན་སུམ་གྱིས་རྟོགས་པ་ཡིན་ཏེ།",
    "རེས་འགའ་གཞན་དུའང་འགྱུར་སྲིད་དོ།",
    "དགུན་ཀ་ཕྱི་མོར་འཆར་བ་དང་།",
    "རང་གི་རང་བཞིན་བདག་ཉིད་ཅན།",
    "འོ་ན་རེག་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "གང་གིས་དེ་མེད་སྒྲུབ་བྱེད་པ།",
    "དངོས་པོ་གང་གི་རང་བཞིན་ནི།",
    "གང་གི་ཚེ་འབྲེལ་པ་དེ་ཉིད་ལྡོག་པ་གཙོར་གྱུར་པ་དེའི་ཚེ་དེའི་སྒོ་ནས་གཏན་ཚིགས་གཞན་སེལ་བའི་གོ་བར་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལྟར་འབྲེལ་པ་མ་ཡིན་པ་ནི་མ་ངེས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་དག་གི་དོན་ཏོ།",
    "འོ་ན་གང་གི་ཚེ་སྒྲ་ཉིད་རྟག་པར་ཁས་བླངས་པ་དེའི་ཚེ་འདི་གཏན་ཚིགས་ཉིད་དུ་འགྱུར་རོ་ཞེས་སྨྲས་པ་ཡིན་ཏེ།",
    "གཉི་ག་ཡང་གོ་བར་བྱེད་པ་ཉིད་དུ་བརྟེན་ན་ནི་རང་གིས་ཁས་བླངས་པ་ཉིད་ལས་ཐེ་ཚོམ་དུ་འགྱུར་རོ།",
    "འོ་ན་གང་གི་ཚེ་སྒྲ་ཉིད་རྟག་པར་ཁས་ལེན་པ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དེས་ན་མ་གྲུབ་པ་ཞེས་རང་གི་མིང་གིས་བསྟན་པར་བྱ་བ་ཡིན་ནོ།",
    "མེད་པ་རི་བོང་གི་རྭ་ལ་སོགས་པ་བྱེད་པ་མ་མཐོང་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ཡིན་ན་འདི་ཙམ་ལྡོག་པས་ནི་བཟློག་པ་གྲུབ་པ་མ་ཡིན་ནོ།",
    "འདིར་ལེགས་རབ་མང་བརྗོད་པར་ནུས་མོད་ཀྱི།",
    "ལེན་བྱེད་མཁས་པ་མེད་མོད་དེ་མེད་མིན།",
    "རྣམ་འགྲེལ་རྒྱན་ཡང་བདག་གིས་ནི།",
    "དེ་ལྟར་བདག་གིས་སྨད་མེད་འདི་སྦྱར་བས།",
    "སློབ་དཔོན་ཉིད་ནི་གཟིགས་པ་པོ་མ་ཡིན་ཏེ།",
    "རྣམ་པ་ཐམས་ཅད་གཟིགས་པ་ནི་འདིར་དོན་མ་ཉམས་པ་གསུངས་པ་ཡིན་གྱི་ཕྱོགས་གཅིག་མཐོང་བ་ལ་ནི་མ་ཡིན་ནོ།",
    "གང་ལ་ཡང་ཐུན་མོང་མ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་དེ་ལྟ་ན་དེ་ཇི་ལྟར་དོན་འདི་འཆད་པ་ཡིན་དེ་ཡང་རང་ཉིད་དོན་དེ་བརྗོད་པས་དེའི་གདམས་ངག་དེ་ཉིད་རབ་ཏུ་བསྟན་པའི་ཕྱིར་ཀུན་དུ་དྲངས་པ་ཡིན་ནོ།",
    "ལུང་རིགས་དག་གིས་རྣམ་དཔྱོད་པ།",
    "དེ་བཞིན་དུ་འབྲས་བུའི་གནས་སྐབས་ནི་རང་གི་དོན་དང་གཞན་གྱི་དོན་དག་ཕུལ་དུ་བྱུང་བའི་དབྱེ་བས་རྣམ་པ་གཉིས་སོ།",
    "དེ་ལ་རང་གི་དོན་ཕུལ་དུ་བྱུང་བ་ནི་ཐམས་ཅད་ཀྱིས་རྣམ་པ་ཐམས་ཅད་ཕྱིན་ཅི་མ་ལོག་པར་མངོན་དུ་མཛད་པའི་ཕྱིར་མངོན་སུམ་གྱི་རང་བཞིན་ནོ།",
    "དེ་ལ་རང་གི་དོན་ཕུལ་དུ་བྱུང་བ་རྩ་བ་ཡིན་པའི་ཕྱིར་ཐོག་མར་མངོན་སུམ་མོ།",
    "སྤྱིའི་མཚན་ཉིད་ཀྱི་རྣམ་པར་དབྱེ་བའི་ཚིག་དག་གི་སྔ་མ་དང་ཕྱི་མའི་ངེས་པ་ནི་མེད་དོ།",
    "བྱེ་བྲག་གི་མཚན་ཉིད་ཀྱི་ཡན་ལག་ཡིན་པའི་ཕྱིར་རྣམ་པ་གཉིས་སོ།",
    "གང་གི་ཕྱིར་རྣམ་པར་དབྱེ་བས་བཞག་པ་དག་མེད་ན་ཤིན་ཏུ་ངེས་པའི་ངོ་བོ་རྟོགས་པར་འདོད་ཅིང་རྟོགས་པར་བྱེད་པར་འདོད་པར་ཡང་མི་ནུས་སོ།",
    "གང་གི་ཕྱིར་མངོན་དུ་མཛད་པ་དེར་ངེས་པའི་གཏན་ཚིགས་ངེས་པ་དེ་རྟོག་པ་པོའམ་ཚིག་ལ་རྟོག་པ་དང་ལྡན་པ་རྣམས་ཡིད་མི་ཆེས་པར་མི་རིགས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མིག་གིས་ལན་ཅིག་གཟུགས་མངོན་དུ་བྱས་པས་མཐོང་བ་དུས་ཡང་གཞན་དུ་མི་འགྱུར་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པར་གང་གིས་བརྟགས།",
    "ངེས་པའི་མིག་གིས་རོ་ལ་སོགས།",
    "གང་གིས་གཞན་དུ་མི་འཐད་པའི་རྒྱུར་བརྟག་པར་བྱ་སྟེ།"
  ]
}