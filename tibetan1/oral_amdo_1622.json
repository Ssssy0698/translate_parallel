    "གཞན་དུ་ན་རི་བོང་གི་རྭ་ལ་སོགས་པ་ཡང་གསལ་བར་བྱེད་པར་འགྱུར་རོ།",
    "དེས་ན་དེ་ཡང་ཐ་དད་པར་སྣང་བར་ཐལ་བས་ཡང་འཁྲུལ་པ་ཉིད་ཉེ་བར་དགོད་པ་ཡིན་ལ།",
    "དེ་ནི་ཉེ་བ་དང་རིང་བའི་དབྱེ་བས་ཡིད་དུ་འོང་བ་དང་ཡིད་དུ་མི་འོང་བ་དང་ལྡན་པར་གསལ་བ་དང་མི་གསལ་བར་ཐ་དད་པར་འགྱུར་བ་ཉིད་པས་དེ་ཇི་ལྟར་ན་རང་གི་དོན་བྱ་བ་བྱེད་པ་ཐ་མི་དད་པ།",
    "རང་གི་རང་བཞིན་ཕྱིན་ཅི་མ་ལོག་པར་གསལ་བར་བྱེད་པ་མ་ཡིན་པ་ནི།",
    "རང་གི་དུས་འབྲེལ་བའི་རང་བཞིན་ཉིད་གསལ་བར་བྱེད་དོ་ཞེ་ན།",
    "འོན་ཏེ་གང་གི་ཚེ་སྒྲིབ་པ་མེད་པ་དེའི་ཚེ་དམིགས་པར་འགྱུར་ཏེ་ཡོད་ཀྱང་མི་དམིགས་པ་ནི་སྒྲིབ་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱི་ཚེ་ཡོད་པའམ་འགྱུར་བ་མེད་པ་ཡིན་མོད།",
    "གང་གི་ཚེ་ད་ལྟར་འགྱུར་བ་མེད་པ་དེའི་ཚེ་སྔ་ན་ཡོད་པ་ཡིན་ནོ་ཞེས་རྗེས་སུ་དཔག་པའི་མཚན་ཉིད་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "གཞན་གྱིས་རྟོགས་པ་དང་འདྲེས་པ་མེད་པར་རྟོགས་པ་ནི་འདི་ནི་ཁྱོད་ཀྱིས་རྟོགས་སོ་ཞེས་དེ་ལྟར་རྟོགས་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "རྗེས་སུ་དཔག་པ་ནི་རང་གི་མཚན་ཉིད་ཀྱི་ཡུལ་ཅན་མ་ཡིན་ནོ།",
    "འདིར་དཔྱོད་པ་ཞིབ་མོས་གནོད་པར་བྱེད་པ་སྒྲུབ་པ་ནི་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར།",
    "ཞིབ་མོར་རྣམ་པར་དཔྱད་ན་ནི་འགའ་ཡང་རྣམ་པར་གཞག་པར་མི་འོས་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཞིབ་མོར་དཔྱོད་པ་བཀག་པས་ནི།",
    "དེ་ལ་བགས་ཀྱིས་བཀའ་མ་རིག་པའི་ཕྱིར་གང་ལ་འཇིག་རྟེན་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པའི་མི་རྟག་པ་ཉིད་རེ་ཞིག་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གང་གི་ཚེ་མཐོང་བ་དེའི་ཚེ་དེ་སྔོན་དང་ཕྱི་མའི་དུས་རྣམ་པར་གཅད་པར་འཛིན་པའི་ཕྱིར་ཇི་ལྟར་མཐོང་བ་དེ་ལྟ་བུ་ཉིད་ཡིན་ནོ་ཞེས་དེ་རྟོགས་པ་སྟེ།",
    "གང་གི་དམིགས་བྱའི་རང་བཞིན་ཡིན།",
    "དུ་མ་ཉིད་ནི་ཡིན་ན་ཕྱིས།",
    "གང་གིས་དེ་མེད་ན་དེར་གནས་པའི་རང་བཞིན་མེད་པས་དེས་མ་དམིགས་པར་འགྱུར་བ་དུས་ཞེས་བྱ་བ་གཞན་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་གིས་ཇི་ལྟར་མཐོང་བར་ནུས།",
    "སྔ་མ་དང་ཕྱི་མའི་དངོས་པོའི་སྐད་ཅིག་གིས་གསལ་བར་བྱ་བའི་དུས་ཉིད་ཡིན་པར་མི་འཐད་དོ།",
    "གལ་ཏེ་མ་དམིགས་སུ་ཆུག་མོད་དེ་ལྟ་ཡང་རྟག་པ་ཉིད་མེད་པར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "ཤེས་པ་འདི་འདྲ་རེས་འགའ་བའི།",
    "རེས་འགའ་མ་དམིགས་པའི་འབྲས་བུ་མི་འགྱུར་རོ།",
    "དེ་ནི་རེས་འགའ་བའི་རང་བཞིན་ཅན་མ་ཡིན་ལ།",
    "རི་བོང་གི་རྭ་མི་བདེན་པར་ནི་དེའི་རྣོ་བ་བདེན་པ་ཡིན་མི་སྲིད་དོ།",
    "ཤེས་པ་འདི་འདྲ་རེས་འགའ་བའི།",
    "གལ་ཏེ་དངོས་པོའི་བདག་ཉིད་དུས་ཐམས་ཅད་དུ་གཞན་དུ་ཆད་པ་མེད་པའི་རང་བཞིན་ཉིད་ཡིན་ན་དེའི་ཚེ་འབྲས་བུ་ཤེས་པ་ཡང་དེ་ཁོ་ན་བཞིན་དུ་འགྱུར་དེ་རེས་འགའ་འབྲས་བུ་མི་བྱེད་པ་རྣམ་པར་ཆད་པའི་རང་བཞིན་གང་ཡིན་པ་དེར་མི་འགྱུར་རོ།",
    "དེ་ཡང་མ་བཟུང་བར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བུའི་རང་བཞིན་ཅན་རེས་འགའ་བའི་འབྲས་བུ་ཡིན་ནོ་ཞེས་བྱ་བར་འགྱུར་བའོ།",
    "རེས་འགའ་འབྲས་བུ་ལས་མི་རྟག་པ་ཉིད་རྟོགས་པ་ཡིན་ནོ།",
    "རེ་ཞིག་འདི་རང་བཞིན་ཡིན་ནོ་ཞེས་བྱ་བ་འདི་ལ་ནི་རྒོལ་བ་ཀུན་ཁ་མཐུན་པ་ཉིད་དོ།",
    "དེ་ནི་བདེན་མོད་ཀྱི་འོན་ཀྱང་།",
    "མཚན་ཉིད་ནི་རང་གི་དོན་རྗེས་སུ་དཔག་པར་བསྟན་པ་དེ་ཉིད་ཡིན་ནོ།",
    "འདི་ནི་རྩོད་པ་མ་ཡིན་ཏེ་གང་གི་ཕྱིར།",
    "གང་གི་ཕྱིར་རབ་ཏུ་དབྱེ་བ་བསྟན་པ་རྟོགས་པའི་དོན་དུ་ཡིན་པ་དེས་ན་སློབ་དཔོན་འབྲས་བུའི་གཏན་ཚིགས་འདི་ཉིད་ཀྱིས་ཕྱོགས་གཅིག་རྟེན་པའི་རང་བཞིན་ཡང་བསྟན་ཏོ།",
    "དེས་ན་ཁྱོད་ཀྱིས་རྩོལ་བའི་དེ་མ་ཐག་པའི་འདོད་པའི་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་སྒྲས་ཀྱང་རང་གི་རྣམ་པར་གཏོད་པའི་སྒོ་ནས་བསྐྱེད་པར་བྱ་བ་ཉིད་ཡིན་ནོ།",
    "དེའི་ཕྱིར་སྔ་མ་དང་ཕྱི་མ་གཞན་གྱི་དངོས་པོ་མཐའ་དག་གཟུང་བར་ཐལ་ཏེ་དེ་གཞན་དུ་གཟུང་བར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "རེས་འགའ་མེད་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་འོ་ན་རང་གི་དངོས་པོས་ན་དངོས་པོ་རྣམས་ད་ལྟར་བ་ལ་སོགས་པ་མ་ཡིན་གྱི།",
    "ལྷན་ཅིག་སྤྱོད་པ་མ་བཟུང་ཡང་རང་གི་ངོ་བོ་ནི་གཟུང་བ་ཉིད་དོ་ཞེས་བྱ་བ་ཡང་དག་པ་མ་ཡིན་ཏེ།",
    "ཐལ་བ་འདི་གཟུང་བ་ལ་ཡང་མཚུངས་པ་མ་ཡིན་ནམ།",
    "ལུས་ཀྱང་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "མཁའ་སོགས་ཀྱང་ནི་ཡིན་གྱུར་ཏེ།",
    "དེ་ལྟ་ཡིན་དང་ནམ་མཁའ་ལ་སོགས་པ་ཉིད་དེ་ལྟར་འགྱུར་མོད།",
    "གལ་ཏེ་རང་གི་ངོ་བོའི་དེ་མ་ཐག་པ་ཉིད་ཡིན་པ་དེ་ལྟ་ན་ཡང་།",
    "དེར་ཤིན་ཏུ་ཞིབ་མོའི་བརྟག་པ་ནི་དགོས་པ་དང་ལྡན་པ་མ་ཡིན་ནོ།",
    "ཐལ་བ་མེའི་འབྲས་བུ་ཡིན་ན་དེ་འཁྲུལ་པ་མེད་པ་མ་ཡིན་ནོ།",
    "འདས་པའི་མེ་དང་ཡུལ་གཞན་ན་གནས་པ་ལས་ཀྱང་བྱུང་བའི་འབྲས་བུ་ཐལ་བ་དེ་ལྟ་བུས་ནི་དེ་ལྟར་གྱུར་པ་གོ་བར་བྱེད་པ་ཁོ་ནའོ།",
