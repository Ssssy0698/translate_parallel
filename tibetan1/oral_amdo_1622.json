    "དེས་ན་སྒྲ་གཞན་དག་གིས་ཀྱང་།",
    "བརྒྱ་ཕྲག་གིས་ཀྱང་ནུས་མ་ཡིན།",
    "གལ་ཏེ་གང་གི་དོན་དུ་འདི་བརྩམས་པ་དེ་ལ་འཁྲུལ་ན་དེའི་ཚེ་གཞན་ལས་མ་འཁྲུལ་ཡང་ཅི་བྱ།",
    "སྤྱི་ངེས་པས་ཀྱང་སྤྱི་དེ་ཉིད་ངེས་པར་འགྱུར་མོད།",
    "ངང་པ་ལ་སོགས་པ་ལ་ཡང་ཡིན་པའི་ཕྱིར་ཧ་ཅང་ཐལ་བ་མ་ཡིན་ནོ་ཞེ་ན།",
    "འོན་ཏེ་སྒྲ་དང་རྣམ་པར་རྟོག་པ་དག་གིས་ནི་ཁྱད་པར་འབའ་ཞིག་རྟོགས་པ་ཡིན་ལ།",
    "གལ་ཏེ་ཁྱད་ཅིག་གིས་དོན་ཏེ།",
    "རང་གི་རང་བཞིན་དུ་རྟོགས་ན།",
    "དེ་ལྟ་ཡིན་ན་སླར་ཡང་ཁྱད་པར་གཅིག་གིས་རྟོགས་པས་ཁྱད་པར་གཅིག་གིས་ཐམས་ཅད་བཟུང་བར་འགྱུར་རོ།",
    "འོན་ཏེ་མངོན་སུམ་གྱིས་ཀྱང་རེས་འགའ་ཐག་རིང་པོ་ནས་དབྱིབས་ཙམ་འཛིན་ལ།",
    "ཁོ་བོ་ཅག་གི་ལྟར་ནི་གཞི་མཐུན་པ་ལ་སོགས་པའི་ཡུལ་གྱི་དངོས་པོ་ལ་གནས་པ་མ་ཡིན་གྱི་ཐ་སྙད་འདི་དོན་དམ་པ་མ་ཡིན་ནོ།",
    "རྣམ་པར་རྟོག་པ་ནི་འདས་པ་ལ་སོགས་པའི་རང་བཞིན་ལ་རེག་པ་མ་ཡིན་ཏེ།",
    "འདི་ལ་ཁྱོད་ཅི་ལྟར་བྱ་བ་མེད་པར་འཇུག་ཅེས་བརྗོད་པ་ཡིན་པས་དེའི་ཚེ་བྱ་བ་མེད་པའི་ཡུལ་བཟློག་པ་ཙམ་རྣམ་པར་རྟོག་པ་ནི་མེད་དོ།",
    "གང་གིས་དོན་གཅིག་ལ་འདུ་བར་མི་འགྱུར་བ་ལྡོག་པ་ནི་དེ་ལས་གཞན་མ་ཡིན་ནོ།",
    "བསླད་པ་དེ་དང་དེ་དག་གིས།",
    "འཇིག་རྟེན་པ་དག་གིས་བརྟགས་ཏེ་མི་འདོར།",
    "མི་སླུ་བ་ཡོད་ན་ཐ་སྙད་པ་ནང་གི་བྱེ་བྲག་ཞིབ་མོར་རྟོགས་པ་ནི་མི་རིགས་སོ།",
    "དཔྱོད་དང་ཐ་སྙད་དག་གིས་ནི།",
    "གཅིག་གི་ངོ་བོར་ངེས་པ་ཉིད་དུ་རིགས་སོ་ཞེ་ན།",
    "གང་གིས་ན་བདག་མེད་པས་གསོན་པོའི་ལུས་ལ་སྲོག་ལ་སོགས་པ་ཡང་མི་ལྡན་པར་འགྱུར་བ།",
    "གང་གིས་དེ་བཟློག་པར་འགྱུར་བ་སྲོག་ལ་སོགས་པ་ནི་བདག་མེད་པ་དང་།",
    "སྲོག་ལ་སོགས་པ་ནི་བདག་གི་འབྲས་བུ་ཉིད་དམ།",
