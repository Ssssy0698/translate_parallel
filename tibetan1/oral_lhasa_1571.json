    "ཁྱད་པར་གྱི་གཞིའི་ཁྱད་པར་ཇི་སྐད་བསྟན་པ་ལ་འགལ་བ་མེད་པའི་ཕྱིར་དང་།",
    "གལ་ཏེ་རྟེན་ཅིང་འབྲེལ་པར་འབྱུང་ན་ནི་ཇི་ལྟར་སྐྱེ་བ་མེད་པ་ཡིན།",
    "དེ་ལ་སྐུར་བ་གདབ་པ་མ་བྱས་པས་དེའི་ཕྱིར་གཏན་ཚིགས་ཀྱི་དོན་མ་གྲུབ་པ་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པ་བདག་ཏུ་ཁས་བླངས་ནས་དོན་དམ་པར་རྣམ་པར་ཤེས་པ་བདག་མ་ཡིན་ནོ་ཞེས་དམ་བཅས་པ་ལ་དམ་བཅས་པའི་སྐྱོན་དུ་མི་འགྱུར་བ་ལྟ་བུ་དང་དཔེར་ན་སྤྲུལ་པའི་སྐྱེས་བུ་སྐྱེ་བ་ལ་སྐྱེས་བུའི་ངོ་བོ་ཉིད་དུ་སྐྱེ་བ་མེད་པ་དེ་བཞིན་དུ།",
    "སྐྱེ་བ་ནི་འདུས་མ་བྱས་མིན་ཏེ།",
    "དོན་གཅིག་པ་མ་ཡིན་པ་ནི་དེ་ཉིད་དང་གཞན་དུ་བརྗོད་པར་བྱ་བ་ཉིད་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "རྟེན་ཅིང་དེ་ནི་ཁྱད་པར་ཤིན་ཏུ་ཆེ་བས་དེའི་ཕྱིར་བསྟན་བཅོས་བརྩམ་མི་དགོས་པ་མ་ཡིན་ནོ།",
    "སྐྱེ་བ་མེད་པ་བསྟན་ནས་འགག་པ་མེད་པ་ལ་སོགས་པ་ཁྱད་པར་བསྟན་སླ་བར་དགོངས་པ་ན་སྐྱེ་བ་མེད་པ་དང་པོར་བསྟན་པར་བཞེད་ནས།",
    "གཞན་གྱིས་ཡོངས་སུ་བརྟགས་པའི་སྐྱེ་བ་རྣམ་པར་རྟོག་པ་མངོན་སུམ་དུ་མཛད་དོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དཔེ་ནི་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "བདག་ལས་མ་ཡིན་ཞེས་བྱ་བའི་དགག་པ་འདི་ནི་མེད་པར་དགག་པའི་དོན་དུ་ལྟ་བར་བྱ་སྟེ་དགག་པ་གཙོ་ཆེ་བའི་ཕྱིར་དང་།",
    "འདིར་དངོས་པོ་རྣམས་བདག་ལས་སྐྱེ་བ་མེད་པ་ཁོ་ནའོ་ཞེས་ངེས་པར་གཟུང་བར་བྱའོ།",
    "གཞན་དུ་ངེས་པར་གཟུང་ན་བདག་ཁོ་ན་ལས་སྐྱེ་བ་མེད་དེ།",
    "བདག་དང་གཞན་ལས་སྐྱེའོ་ཞེས་བྱ་བར་ངེས་པར་འགྱུར་བས་དེ་ཡང་མི་བཞེད་དེ།",
    "འདིར་གྲངས་ཅན་དག་ལས་ཁ་ཅིག་ཕྱིར་ཟློག་པར་བྱེད་དེ་དམ་བཅས་པ་འདིའི་དོན་གང་ཡིན།",
    "སྐབས་ཀྱི་དོན་ལས་བཟློག་པས་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "སྐྱེ་བ་ཐུག་པ་ཡོད་པར་འགྱུར་བའི་ཕྱིར་མཛད་པའི་མཐའ་དང་འགལ་བར་འགྱུར་རོ།",
    "ཕྱོགས་རྣམས་རྣམ་པར་བརྟགས་སུ་ཟིན་ན་ཡང་མི་རིགས་པ་བརྗོད་པར་བྱ་བའི་ཕྱིར་དེ་ཡོངས་སུ་བཟུང་བས་ཉེས་པ་མེད་དོ།",
    "གཞན་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་ཀྱི་དོན་ཡོན་ཏན་ཡིན་པར་རྟོག་ན་ནི།",
    "དེ་ལས་གཞན་པའི་དོན་ཡིན་པར་རྟོག་ན་ནི་གྲགས་། པའི་གནོད་པར་འགྱུར་རོ་ཞེའོ།",
    "དེ་ཡོན་ཏན་ཉིད་དམ་གཞན་ཉིད་ཡིན་པར་སེམས་པ་ཡང་སེམས་པ་གཞན་ཡིན་པའི་ཕྱིར་རོ།",
    "གྲགས་པའི་གནོད་པར་ཡང་མི་འགྱུར་ཏེ།",
    "དམ་བཅས་པ་ཁྱད་པར་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་སའི་རྡུལ་ཕྲ་རབ་དག་ས་ཞེས་བྱ་བའི་རྫས་རྩོམ་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་མེའི་རྡུལ་ཕྲ་རབ་དག་ཀྱང་མེའི་རྫས་རྩོམ་པར་བྱེད་པ་མ་ཡིན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཡང་བརྗོད་པར་བྱའོ།",
    "དེས་ན་དེ་ལ་གླགས་ཡོད་པའི་ཚིག་ཡིན་པའི་ཕྱིར་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "གྲངས་ཅན་དག་ནི་བྱེད་རྒྱུ་རྣམ་པར་ཕྱེ་བ་དང་།",
    "རྣམ་པར་མ་ཕྱེ་བས་ས་ལ་སོགས་པ་དང་།",
    "གྲགས་པའི་གནོད་པར་འགྱུར་བའི་སྐྱོན་ཡོད་པའི་ཕྱིར་ཡང་ངོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "སྤྱི་དང་ཁྱད་པར་ཉིད་དང་ལྡན་པའི་ཕྱིར།",
    "རྗེས་སུ་དཔག་པའི་གནོད་པར་འགྱུར་བའི་ཕྱིར་ཡང་ངོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "སུས་ཀྱང་མ་བྱས་པ་ཁོ་ནའི་ཕྱིར་རྐྱེན་ངེས་པ་ལས་སྐྱེ་བ་ཡིན་ན་ནི་གྲུབ་པ་ལ་སྒྲུབ་བོ།",
    "ཇི་སྟེ་དོན་དམ་པར་ན་ནི་དཔེ་མེད་དེ།",
    "དོན་དམ་པར་པདྨ་ལ་སོགས་པ་སྐྱེ་བར་ཁས་མ་བླངས་པའི་ཕྱིར་རོ།",
    "བསྒྲུབ་པར་བྱ་བ་ནི་གཏན་ཚིགས་ཀྱིས་འགྲུབ་པར་འདོད་ན་ནི་ཕྱོགས་སྔ་མ་དང་འགལ་ལོ།",
    "ཇི་སྟེ་རྒྱུ་ཡོད་པར་སྨྲ་བ་ལ་གཏན་ཚིགས་མེད་པར་བསྟན་པར་མི་ནུས་པས་ཀླ་ཀློ་ལ་ཀླ་ཀློའི་སྐད་བཞིན་ཏེ།",
    "སྐད་གཞན་དུ་བསྒྱུར་ཀྱང་ཇི་ལྟར་རྟོགས་པའི་རྟགས་ཁོ་ནས་རྟགས་ཅན་གྱི་དོན་སྟོན་པའི་ཕྱིར་དཔེར་ན་ཀླ་གྲོལ་ཕྱོགས་འདི་ན་དུ་བ་ལས་མེ་ཡོད་དོ་ཞེས་སྟོན་པར་བྱེད་པ་དེ་ལ་རྟགས་རྟོགས་པ་སྐྱེ་བའི་ཐབས་ཐ་དད་པ་བཞིན་པས་དེ་ནི་ལན་དུ་མི་རུང་ངོ།",
    "མར་འབྲི་བ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་རོ་ཞེ་ན་ཡང་ཐ་སྙད་ཀྱི་ཕྱོགས་ལ་ནི་གྲུབ་པ་ལ་སྒྲུབ་པ་ཡིན་ནོ།",
    "དོན་དམ་པར་ནི་མ་ཡིན་ཏེ།",
    "དོན་དམ་པར་ལས་ཀྱི་སྐྱེ་བ་ཡང་ཁས་མ་བླངས་པའི་ཕྱིར་རོ།",
    "ལྷག་པར་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལ་བུམ་པ་ལ་སོགས་པའི་ནམ་མཁའ་ཐ་དད་པར་ཉེ་བར་གདགས་པ་བཞིན་དུ།",
    "གཅིག་པ་ཉིད་མ་གྲུབ་པའི་ཕྱིར་ཇི་སྐད་སྨྲས་པའི་སྐྱོན་མེད་པར་མི་འགྱུར་རོ།",
    "དཔྱད་པ་རྒྱས་པ་ནི་བདག་བརྟག་པའི་རབ་ཏུ་བྱེད་པར་མཛད་པར་འགྱུར་རོ།",
    "རང་བཞིན་རྒྱུར་འདོད་པ་དག་ནི་ཚངས་པ་ལ་སོགས་པ་མྱུ་གུའི་མཐར་ཐུག་པ་ཅན་གྱི་གསལ་བ་རྣམས་སྐྱེ་བའི་རྒྱུ་རང་བཞིན་ཡིན་པར་ཁས་བླངས་ནས།",
    "གཏི་མུག་ཡིན་པར་ངེས་ཏེ།",
    "དེ་དང་ལྡན་པའི་ཕྱིར་འདི་ལྟར་འཇིག་རྟེན་ན་ཡང་གང་ཞིག་གང་དང་ལྡན་པར་གྱུར་པ་དེ་ནི་དེའི་རྒྱུ་ཅན་ཡིན་པར་ཤེས་ཏེ།",
    "རྣམ་པར་ཤེས་པའི་མཚན་ཉིད་ཀྱི་ཕུང་པོ་རྣམས་ཀྱང་བདེ་བ་དང་།",
    "དེ་ལ་འདིར་ཙན་དན་ལ་སོགས་པ་དོན་དམ་པར་མ་གྲུབ་པས་དཔེ་མེད་དོ།",
    "སྡུག་བསྔལ་གྱི་ངོ་བོ་ཉིད་མ་ཡིན་པར་ངེས་ཏེ།",
    "ཐ་སྙད་ཀྱི་བདེན་པའི་ལུགས་རྣམ་པར་གཞག་པའི་ཕྱིར་དེ་དག་ཡོད་པར་ཁས་བླངས་ན་ཡང་སྨྲ་བར་བྱ་སྟེ།",
    "དོན་དམ་པར་ནི་སྐྱེ་བ་དགག་པ་བཞིན་དུ་གསལ་བ་དགག་པ་ཡང་མཚུངས་ཏེ།",
    "བསྒྲུབ་པར་བྱ་བ་དང་།",
    "རྣམ་པར་བྱང་བའི།",
    "སྐལ་བ་མཉམ་པ་དང་མཚུངས་པར་ལྡན་པ་དང་།",
    "རྣམ་པར་སྨིན་པ་ཞེས་བྱ་བ་ནི་རྒྱུ་ལྔ་པོ་དག་གོ།",
    "དེ་ལ་བསྟན་བཅོས་བྱེད་པས་དངོས་པོ་རྣམས་གཞན་ལས་སྐྱེ་བ་མེད་དེ་ཞེས་དམ་བཅས་པར་གྱུར་པ་གང་ཡིན་པ་དེ་ནི་ཁས་བླངས་པ་ལ་གནོད་པར་འགྱུར་རོ།",
    "རྗེས་སུ་དཔག་པའི་གནོད་པ་སྨྲས་ཟིན་པའི་ཕྱིར་དེ་ལ་གནོད་པར་མི་འགྱུར་རོ།",
    "གང་དག་སྒྲུབ་པའི་དོན་ཡང་དག་པ་མ་ཡིན་པར་ཚོད་དཔགས་སུ་བརྟགས་ནས་ཁོ་བོ་ཅག་ནི་དངོས་པོ་རྣམས་གཞན་དག་ལས་སྐྱེ་བ་ཁོ་ན་ཡིན་ནོ་ཞེས་ནི་ངེས་པར་མི་འཛིན་གྱི།",
    "བདག་ལས་མ་ཡིན་པར་ངེས་པར་འཛིན་པས་དེས་ན་རྐྱེན་མ་ཡིན་པ་དག་ལས་གཞན་ཉིད་ཡོད་དུ་ཟིན་ཀྱང་སྐྱེ་བ་མེད་དོ་ཞེས་ཟེར་ན་དེ་ལས་གལ་ཏེ་ཚིག་དེ་བདག་ལས་སྐྱེ་བ་དགག་པ་ལྷུར་ལེན་པ་ཡིན་ན་ནི་འདོད་པ་སྒྲུབ་པ་ཡིན་ནོ།",
    "དེས་ནི་བསྒྲུབ་པར་བྱ་བའི་དོན་བསྟན་ཏོ།",
    "རྐྱེན་ཕྱོགས་སུ་བྱས་པ་ལས་སྦྱོར་བའི་ཚིག་གཉིས་སུ་འགྱུར་ཏེ།",
    "དོན་དམ་པར་མིག་ལ་སོགས་པ་སྐྱེ་མཆེད་རྣམས་ཁུ་ཆུ་དང་ཁྲག་ལ་སོགས་པ་རྐྱེན་རྣམས་ལས་སྐྱེ་བ་མེད་དེ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་ཁུ་ཆུ་དང་ཁྲག་ལ་སོགས་པའི་རྐྱེན་རྣམས་མིག་ལ་སོགས་པའི་སྐྱེ་མཆེད་རྣམས་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "དེ་བས་ན་བཅོམ་ལྡན་འདས་ཀྱིས་དོན་དམ་པར་དངོས་པོ་རྣམས་རྒྱུ་ལ་སོགས་པ་རྐྱེན་བཞི་པོ་དག་ལས་སྐྱེ་བ་མེད་པར་བཀའ་སྩལ་བ་མེད་པར་ཤེས་པར་བྱའོ།",
    "བདག་པོའི་རྐྱེན་རྣམས་བཀའ་སྩལ་པར་ཤེས་པར་བྱ་སྟེ།",
    "དེའི་ཕྱིར་ཁས་བླངས་པ་ལ་གནོད་པར་མི་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་དེ་དག་དངོས་པོ་སྐྱེད་པར་བྱེད་པ་ཡིན་པར་འདོད་པ་དང་།",
    "ཞེས་ངེས་པར་བྱ་སྟེ་བརྗོད་དོ།",
    "དོན་དམ་པར་དེ་དག་གཞན་ཉིད་ཡིན་པ་ཁོ་ནར་མི་རིགས་སོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "སྐྱེ་བའི་སྔོན་རོལ་ན་ཐ་སྙད་དང་དོན་དམ་པར་རོ།",
    "ཇི་སྟེ་དངོས་པོ་སྐྱེ་བར་འདོད་པ་བློ་ལ་རྣམ་པར་བཞག་ནས་རྐྱེན་དེ་དག་གཞན་དུ་གྱུར་པ་ཡིན་ཏེ།",
    "དོན་དམ་པར་དེ་ལས་སྐྱེ་བ་མེད་པར་སྔར་བསྟན་ཟིན་ཏོ།",
    "གྲངས་ཅན་དག་ཕྱིར་ཟློག་པར་བྱེད་དེ།",
    "དེ་ཡང་ཕྱིས་གསལ་བར་བྱེད་པར་ཁས་བླངས་པས།",
    "འོན་ཏེ་སྐྱེ་བ་མེད་པ་ཁོ་ནའོ་ཞེ་ན་ནི་ཐེར་ཟུག་ཏུ་གནས་པར་སྨྲ་བར་ཁས་བླངས་པའི་ཕྱིར་ཕྱོགས་སྔ་མ་ལ་གནོད་དོ་ཞེས་ཟེར་རོ།",
    "རྐྱེན་རྣམས་ཁོ་ནས་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་མ་ཡིན་ཏེ།",
    "འདི་ལྟར་རྣམ་པར་ཤེས་པ་སྐྱེ་བའི་བྱ་བ་མིག་དང་།",
    "ཡིད་ལ་བྱེད་པའི་རྐྱེན་རྣམས་ཀྱིས་རྐྱེན་དང་ལྡན་པས་དེ་སྐྱེད་པར་འདོད་དོ།",
    "དེས་ན་རྗེས་སུ་དཔག་པ་སྔར་སྨྲས་པ་རྣམས་ལ་རྟོག་གེ་ཕྱི་མས་གནོད་པར་འགྱུར་རོ་ཞེས་ཟེར་རོ།"
  ]
}