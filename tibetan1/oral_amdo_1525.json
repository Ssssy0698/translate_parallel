    "ང་ཚོ་རི་བལྟས་སོང་དུས་ཡབ་ཨ་ཕ་ལ་ལབ་རྒྱུའི་གཏམ་ཞིག་དགོས་ཀྱི་རེད།",
    "ཡུམ་ཨ་མ་ལ་སྤྲོད་རྒྱུའི་འབབ་ཞིག་དགོས་ཀྱི་རེད།",
    "ཡུམ་ཨ་མ་ལ་སྤྲད་རྒྱུའི་འབབ་དེ་འབྲོང་བྲེ་སེར་གྱི་ལྕི་བ་སྒྲུག་ནས་ཨ་མ་སྤྲོད་དགོས་ཟེར་ནས།",
    "བུ་མོ་སྤུན་གསུམ་གྱི་སྒབ་མ་ཨ་ལོང་འཁྱིལ་ལེ།",
    "བུ་མོའི་གྱོན་ཆས་ཀྱི་གོས་མཐའ་ལ་ཟེར།",
    "དེར་བུ་མོ་རྣམས་ངོ་མཚར་ཆེ་ཟེར་ཞིང་ལྟད་མོ་ལ་གཡེང་སྐབས།",
    "ཁ་ཕུ་ཐུང་ནང་བཅུག་ཅིང་སོང་པར་གདའོ།",
    "བུ་མོ་གསུམ་པོ་ཁྲ་ཧྲུག་གེར་སྒོ་ནས་འཛུལ་ཞིང་།",
    "དེར་བུ་མོ་དུང་མཚོ་སྒོ་ནས་ཡར་འཛུལ་མ་ཐག་ཏུ་འབུ་ཆུང་དེ་ཐག་སྒྲ་དང་བཅས།",
    "ཡབ་ཨ་དྲུང་རྒྱལ་པོའི་གསོལ་ལྕོག་སྟེང་གི་བཞེས་དཀར་གྱིས་འགྲམ་དུ་བབས་པ་རེད།",
    "ཁྲ་མཛེས་པ་སོགས་འདི་ཅི་ཡིན་གང་ཡིན་ནམ་ཞེས་མི་ཚང་མས་གླེང་མོ་བྱས་ཤིང་གནས་སོ།",
    "མིའུ་ལྷའི་གནང་པའི་བུ་མོ་གསུམ་གྱི་རྙེད་པ་ཡིན་པས་ཡག་པོ་ཞིག་ཡིན་ངེས་རེད་ཟེར།",
    "དེ་ནས་ཟས་དཀར་དམར་སྐྱུར་གསུམ་དེ་སྤྲད་ནས་བཟའ་གི་ཡོད་མེད་ཅིག་བལྟ།",
    "གནམ་ཁེབས་རྒྱ་ཅན་གྱི་ས་ལ་འབུ་སྲིན་སྣ་ཚོགས་ཡོད་ངེས་རེད་ཟེར།",
    "གང་ལྟར་ཁོ་རང་ཚོ་ཁ་མ་མཐུན་པའི་ངང་དེར།",
    "འབུ་དེ་ཉིད་ཡབ་ཨ་དྲུང་རྒྱལ་པོའི་གསོལ་ལྕོག་གི་ཐོག་ཏུ་ཡར་འགྲོ་མར་འགྲོ་བྱས་ཤིང་།",
    "དེ་ནས་གསོལ་ལྕོག་གི་ཐོག་ཏུ་དཀྱིལ་ཀྲུང་ཞིག་བྱས་ནས་མི་རྣམས་ལ་ཁ་གཏད།",
    "ཨ་མཚར་རྩེད་མོ་རྩེད་ལ་འོང་ལེ།",
    "ཁྲོམ་མི་དམངས་ཡུལ་གྱི་ལྐུགས་པ་རེད།",
    "ནམོཨཱཏྟཾཏིས་ཏིས་ཏིས།",
    "ཨ་མཚར་རྩེད་མོ་རྩེད་དདགོས་མ་རེད།",
    "འབུ་ཆུང་མཐེབ་ཏོག་ཙམ་ཞིག་གདའ་མོད།",
    "གཡུ་རལ་གངས་ལ་ངོམ་གྱིན་སོང་ཡོད།",
    "བུ་མོ་སྤུན་གསུམ་ཕེབས་ནས་བྱུང་ངོ།",
    "ཨ་ཕ་སྤྲོད་རྒྱུའི་གཏམ་ཞིག་དགོས་ཟེར།",
    "ཡུམ་ཨ་མ་ལ་སྤྲད་རྒྱུ་ནི་ཟས་ཤིག་དགོས་ཟེར།",
    "མ་བསྡད་ང་ཡི་ལྟད་མོ་བལྟས་ཡིན།",
    "བུ་མོ་དུང་མཚོས་ལྕི་བ་སྒྲུག་སོང་།",
    "རྡོག་ཐོ་གསུམ་རང་དབྱུག་རེ་བྱུང་ངོ།",
    "ཅི་རེད་གང་རེད་ཟེར་ནས་བྱུང་ངོ།",
    "སྐྲག་སྐྲག་འདར་འདར་ངང་ལ་ཁྱེར་ཐལ།",
    "བུ་མོ་སྤུན་གསུམ་རུག་སེ་འཛོམས་ཐལ།",
    "བུ་མོ་སྤུན་གསུམ་ཉམས་ཤིག་བླངས་ཡོད།",
    "འཕྱོར་ཁ་དོག་ཅི་གདའ་མིག་གི་བལྟས་ཡོད།",
    "བུ་མོ་སྤུན་གསུམ་ཉམས་ཤིག་བླངས་ཡོད།",
    "བུ་མོ་གསེར་མཚོས་ཟེར་བ་ལ།",
    "ས་ཆགས་པ་ཅན་ལ་ཆགས་བསྡད་རེད།་",
    "ཁྱི་སྤྲང་པོ་སྦྱིན་པ་དཀའ་ས་རེད།",
    "ཨེ་འདྲ་མི་འདྲ་ལོས་ཡོད་རེད་ཟེར།",
    "དེ་འདྲ་ཟེར་ནས་བུ་མོ་ཕེབས་ཐལ།",
    "ཁ་ཕུ་ཐུང་བཅུག་ནས་བུ་མོ་ཕེབས་ཐལ།",
    "བུ་མོ་དུང་མཚོས་ཟེར་ལེ་ལའོ།",
    "ཨ་ཙིལྟད་མོ་འདི་འདྲ་གདའ་ཟེར།",
    "གཏམ་མེད་ཀྱང་ལྟད་མོ་སྟོན་དགོས་ཟེར།",
    "ཨ་མ་སྤྲད་རྒྱུའི་ཟས་ཤིག་དགོས་ཟེར།",
    "སྐྱོན་མི་གདའ་ལྟད་མོ་བལྟ་རྒྱུ་དགའ།",
    "སྐྲག་སྐྲག་འདར་འདར་ངང་ལ་བྱུང་ཐལ།",
    "ཁྲོམ་མི་དམངས་ཀྱིས་ཕར་ལྟ་ཚུར་ལྟ་བྱས་ཐལ།",
    "འབུ་ཁོ་ལ་སྒབ་སྐོར་རྒྱག་མཁན་བུ་མོ་གསེར་མཚོ་ནི་ཁྱི་སྤྲང་སྦྱིན་པ་མི་གདའ་ཟེར།",
    "རེའུ་ལུག་གུ་འཚར་ཐོག་མི་ཐོན་ཟེར།",
    "ཡང་ཁ་ཤས་ཀྱིས་ཅི་ཤེས་བུ་མོ་སྤུན་གསུམ་ཡིན་ནའང་།",
    "ཡག་སྡུག་ཡོད་ངེས་རེད་ཟེར་ཞིང་ཁ་མ་འཆམ་ཞིང་གནས།",
    "ད་རུང་འབུ་འདི་ཡིས་གཏམ་ཤོད་རྒྱུ་ཡོད་ངེས་རེད།",
    "ད་དུང་འདི་ཡིས་གཏམ་གཅིག་ཤོད་ངེས་ཅན་རེད་ཟེར།",
    "ཡབ་ཨ་དྲུང་གི་ཕྱོགས་སུ་ཁ་གཏད་ཅིང་གླུ་འདི་ལྟར་བླངས་སོ།",
    "ལྟོས་ཟེར་དུས་ཁྲ་ཆུང་མིག་གིས་ལྟོས་ཤོག།",
    "རྒྱ་ལྕོག་སེར་པོའི་སྟེང་ལ་འགྲིག་ཐལ།",
    "རྒྱ་ཇ་ཡུ་དམར་གསོལ་ཇ་དྲངས་ཐལ།",
    "འབྲི་མར་སེར་པོས་ཁ་རྒྱན་བརྒྱབ་ཐལ།",
    "དཔོན་མཐོན་པོ་ཞིག་ནི་སླེབས་རན་ཐལ།",
    "བུ་མོ་སྤུན་གསུམ་བྱང་ལ་འགྲོ་དགོས།",
    "ད་ལོ་གནས་སྒོ་ཕྱེ་གདའ་ཟེར་མོད།",
    "ཡབ་ཨ་དྲུང་བུ་མོ་སྤུན་གསུམ་དེ།",
    "དཔོན་མཐོན་པོ་མི་དམར་བཙན་པོས་ཕེབས་ཐལ།",
    "གཏམ་འཐེན་ན་འཐེན་སྟངས་ལོས་ཡོད་རེད།",
    "ལུག་གཡང་དཀར་སྤུ་དེ་དཀར་པོ་རེད།",
    "དེའི་ནང་ལ་དམག་གི་དཔོན་པོ་ལ།",
    "གཡུ་མདའ་རྒྱབ་ལ་ཁུར་ནས་ཡོད་མོད།",
    "སྨུག་རླངས་ན་བུན་འཐིབ་ཅིང་ཡོད་མོད།",
    "རྟ་ཆུང་ཆུང་འཚེར་སྐད་རྒྱག་གི་ཡོད།",
    "བུ་མོ་དུང་མཚོ་སྤྲད་རོགས་བྱས་དང་།",
    "མ་སྤྲད་བུ་མོ་དཔུང་གིས་འཕྲོག་འགྲོ།",
    "ཕྱི་དྲོ་ཆུ་མོའི་འགྲམ་ལ་འགྲོ་དགོས།",
    "དགོང་མོ་བདུད་ཀྱི་ཡུལ་ལ་འགྲོ་དགོས།",
    "ཁྲོམ་མི་དམངས་རྣམས་ཀྱིས་བུ་མོ་ཆེ་བ་གཉིས་ནི་སྲིན་པོ་ལ་སྤྲད་ཚར་ནའང་།",
    "བུ་མོ་ཆུང་བ་དུང་མཚོ་ནི་སྦལ་ཆུང་འདི་ལ་སྤྲོད་དགོས་མིན་ནམ་ཟེར།",
    "འོན་ཀྱང་ངའི་བུ་མོ་དུང་མཚོ་འདི་ནི་སྦལ་ཆུང་ལ་སྤྲོད་གཏན་འཁེལ་ཡིན་ཟེར་ནས་ཐུགས་ཐག་བཅད་དོ།",
    "མི་ཆུང་མཐེབ་རྡོག་ཙམ་ཞིག་སླེབས་ཐལ།",
    "ཁྱོད་མི་བརྒྱའི་དཀྱིལ་ལ་མ་འགྲོ་ཨ།",
    "མི་བརྒྱའི་དཀྱིལ་ལ་སོང་བས་ན།",
    "མི་གཅེར་བུ་ཟེར་ནས་འཕྱ་ཡི་རེད།",
    "ལས་དེ་ཚོ་ཟུར་གྱིན་ཕེབས་ཏེ་སོང་།",
