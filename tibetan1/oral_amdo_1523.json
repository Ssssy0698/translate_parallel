    "སངས་བྱེད་ངེས་ལེགས་སྐྱ་རེངས་འཆར་བར་ཤོག།",
    "མ་བཟོད་ནོར་འཛིན་བུ་མོའི་འགྲམ་པ་ལ།",
    "ངལ་དང་གཏོང་བའི་མི་དང་སེམས་སོང་ཚོགས།",
    "འགྲོ་རྒྱུད་ཉོན་མོངས་གངྒཱའི་ཀླུང་རྡུལ་གྲངས་དང་ཚད་གཟུང་མི་ནུས་པའི།",
    "འགྲོ་ཁམས་ཉོན་མོངས་རྡུལ་གྱིས་དམ་ཚིག་ཀླུང་།",
    "གླེགས་བམ་དུ་མར་གཏུགས་ཏེ་ཞིབ་མོར་དཔྱད།",
    "འོན་ཏེ་གསང་ལས་ཆེས་གསང་འབྲུག་གི་སྒྲ།",
    "ཐོས་པའི་མོད་ལ་གཏན་བདེའི་མངལ་གྱི་ཁུར།",
    "སྦྲུམ་ནུས་རིགས་འཛིན་རྨ་བྱའི་༡༡༦བ་བུ་མོ་རྣམས།",
    "རྩེ་མོར་མཛེས་པའི་ཏོག་འོད་འབར་བར་ཤོག།",
    "གཏན་བདེའི་སྲོག་གི་འཚོ་བ་དོན་ཡོད་དུ།",
    "ཨཱནྟརེརྦིགྷཱཙཀྲསྱགཱནྱཔྲབྷཱགཏྭཙིནྟདྱཐཱསེདྡྷིདཱདྷིཥྛནེ།",
    "བར་ཆད་བགེགས་ཀྱི་དཔུང་ཚོགས་རབ་བཅོམས་ནས།",
    "གསེར་ཞོ་སུམ་ཅུ་སོ་གཅིག་གི་རྒྱུ་བྱས་ཏེ་སྦྱར་སྤོས་ཙན་དན་མ།",
    "སྐུ་འདྲ་གཉིས་ལ་བར་ཆུང་རེ།",
    "རྔ་གདན་བརྒྱད་ཀྱི་ཕྱི་གཡོག་རྒྱ་གླིང་གི་ཤུབས་ཆ་གཅིག།",
    "རྗེ་བཙུན་རིགས་བྱེད་ལྷ་མོས་དགེ་ལེགས་སྩོལ།",
    "ཏྲཱིཡཏྷཱཏོརྐརེཔྲངྷྱཏཀརྨབཱལིརྡྲབྷཱཥྚེཤཱརཱལུཤྩམཱུརྡྷེནྡུཀ་ཨཱིཤཔཱརྦཏྱགཱཎསྱཔཱཏྱེནསཱདྷོབྷགིརྒོདྷརོཙྩེསཱུསོཀུཊྚཡཱ།",
    "མྱུ་གུའི་ལང་ཚོ་སྨིན་པའི་འབྲུ་ཁལ་གྲངས།",
    "ཞེས་བཀྲ་ཤིས་པའི་ཚིགས་སུ་བཅད་པ་སྔོན་དུ་འགྲོ་བས་གོང་དཀར་སྐྱི་ནག་གི་དེབ་གསར་དུ་བཀོད་པ་ལ།",
    "ནིཏྱཏནྟྲེཎསེནཱསུརེརྒརྦཌཱིམཱཏྲཧྲྀཏྵཱསབཀྟྲོཤྞཏཔཱ་ཤྲཱཀ་སུཁྱབིསྟཱརཌཱཀོཔཏཱཛྙཱཏཧཱིདེབིཀཤྴཱིཥྚརཛྙཱསདཱཔཱལཏུ།",
    "དཔལ་ལྡན་འདོད་པའི་རྒྱལ་མོས་རྟག་ཏུ་སྐྱོངས།",
    "ཁྱོད་ཞལ་དྲན་པའི་མོད་ལ་རྒུད་པའི་སྨག།",
    "༡༢ན་སྐྱིད་སྨད་ནོར་འཛིན་དཔལ་མོའི་མངལ་གྱི་ཁུར།",
    "དེབནིཏྱེསུཁཤྴརྨཀཱསཱནཡཀྵཀྱསརྦསྱཔཱཏྷཱཧནེབེཤྲཝ་ཏྲཱིཡདྷཱཏྭཱབྷིབྷབེནཏེཛཱགིཥཎཤྲེཡཏོམངྒལཾབྷདྷཪྵྱཡཾཔཱཏཏུ།",
    "༡༢བ་ཕྱག་གཡོན་སོར་མོས་ལེགས་བཙིར་ནེའུ་ལེ་ཡིས།",
    "འབྲུ་བཅུད་ལང་ཚོའི་བཞིན་རས་དངོམ་པ་ན།",
    "སྤྱན་རས་གཟིགས་སྤྲུལ་མྱུར་མཛད་ཡེ་ཤེས་མགོན།",
    "བཀའ་སྡོད་ལས་ཀྱི་གཤིན་རྗེའི་དཔུང་ཚོགས་རྣམས།",
    "རབ་དངས་མོས་པས་ཉེར་དབུལ་མཁོ་དགུའི་རྫས།",
    "ཤིང་གི་མ་མའི་དོ་ར་ཡངས་པའི་ནང་།",
    "སོར་མོའི་འཕྲུལ་གྱིས་བསྒྱུར་བའི་རྣམ་དཔྱོད་ལ།",
    "སྒེག་ལྡེམ་ལང་ཚོའི་འཁྲི་ཤིང་གཞོན་ནུ་མ།",
    "མཛེས་སྡུག་འཆི་མེད་བུ་མོའི་ཁེངས་པ་བསྙིལ།",
    "མོང་བཟའ་ཁྲི་ལྕམ་ཐུགས་དམ་གནྡྷོ་ལ།",
    "བརྩེ་ཆེན་མར་མེས་བྱང་ཕྱོགས་སྨག་གི་རུམ།",
    "ནོར་འཛིན་དཔལ་མོའི་མགུལ་པར་མཛེས་པའི་རྒྱན།",
    "ངོ་མཚར་མིག་གི་བདུད་རྩི་ཉེར་བསྐྲུན་པས།",
    "སྲིད་ཞིའི་རྒྱལ་མཚན་རྩེ་མོར་རབ་བཀོད་ནས།",
    "ཅེས་ཡེར་པ་དགའ་ལྡན་གསང་སྔགས་ཡང་རྩེའི་འདུ་ཁང་གི་ལྡེབས་རིས་བླ་གཉེར་གྲྭ་རིས་རྣམས་ཀྱིས་འབད་པས་བསྒྲུབས་པའི་ཚེ་དཀར་ཆག་དགོས་ཚུལ་ལྟར་ཟ་ཧོར་གྱི་བནྡེས་སྦྱར་བའི་ཡི་གེ་པ་ནི་དགེ་སློང་འཇམ་དབྱངས་གྲགས་པས་བགྱིས་པ་ཛ་ཡནྟུ།",
    "གངྒཱའི་ཀླུང་གི་རྡུལ་གྱིས་ཆ་ཙམ་དུ།",
    "བགྲང་བར་ནུས་མིན་ཉི་མའི་གཉེན་ཁྱོད་བསྔགས།",
    "འཁོར་ལོའི་རི་མོས་མཚན་ཞབས་མ་བཀོད་པའི།",
    "མགོན་ཁྱོད་འཕྲིན་ལས་འཇུག་པ་ཁོར་ནར་མཆིས།",
    "འདྲེན་བྱེད་གསུང་གི་མཛད་པ་ཕུལ་དུ་བྱུང་།",
    "ཆུ་ཤེལ་བུ་མོའི་རྡུལ་མངས་མཐོར་བརྩེགས་རིའི།",
    "རབ་འགྱུར་རྒྱལ་བློན་ལོ་པཎ་ཕྱག་གི་རྗེས།",
    "རི་མོ་ཁྱབ་མཇུག་ངེས་ཀྱང་དབྱེ་ནུས་མིན།",
    "རེས་འགའ་རྒྱལ་ལ་དམིགས་པའི་དད་པ་སྐྱེ།",
    "ཞེས་ཡུལ་ཆེན་པོ་དྲུག་གིས་མཚོན་པའི་རྒྱ་གར་གྱི་ཕྱོགས་ཀུན་ཏུ་འདྲི་ཀློག་འཆད་ཉན་བསྙེན་བཀུར་བ་སོགས་དར་རྒྱས་ཆེ་ལ།",
    "ཞེས་བོད་ཀྱི་རྒྱལ་ཁམས་མཚོས་གང་བ་ཀོང་ཆུ་ལག་ཏུ་སོང་སྟེ་སཱ་ལའི་ནགས་ཆགས་པ་ནས་རིང་ཞིག་ན་ཐུགས་རྗེ་ཆེན་པོ་དང་སྒྲོལ་མས་བྱིན་གྱིས་བརླབས་པའི་སྤྲེའུ་དང་བྲག་སྲིན་མོ་ལས་མིའི་འགྲོ་བ་འཕེལ་བར་མ་སངས་སྤུན་དགུ།",
    "བོད་ཁམས་མགོན་མེད་ཡུལ་དུ་ཐུགས་རྗེས་སོང་།",
    "དེ་དག་ལས་ཕྱི་མོར་བྱས་ཏེ་འབྱོར་ལྡན་རྣམས་ཀྱིས་རྒྱ་ཆེར་སྤེལ་བའི་ཕན་ཡོན་ནི།",
    "རི་མོར་བྱེད།",
    "སྟོང་གི་ཆར་ཡང་།",
    "བྱེ་བ་སྟོང་གི་ཆར་ཡང་།",
    "བྱེ་བ་བརྒྱ་སྟོང་གི་ཆར་ཡང་།",
    "བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་གི་ཆར་ཡང་ཉེ་བར་མི་འགྲོའོ།",
    "གང་གི་རྒྱལ་བའི་སྐུ་ནི་རབ་འབར་ཞིང་།",
    "ཡི་དམ་བཅས་ནས་ནགས་དང་ནགས་འདབས་སོང་།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེས་ཚེས་བརྒྱད་དང་།",
    "གང་གིས་མཆོད་རྟེན་རྡོ་ལས་བྱས་པ་དང་།",
    "གང་༡༢༨ན་གིས་ཨ་ཀ་རུ་དང་ཙན་དན་ནམ།",
    "གང་གིས་ཐང་ཤིང་མཆོད་རྟེན་བྱས་པ་དང་།",
    "བྱིས་པ་རྩེ་མོར་དེ་དང་དེ་དག་ཏུ།",
    "གང་གིས་རྒྱལ་བ་དེ་ཕྱིར་མཆོད་རྟེན་དག།",
    "ཉི་མའི་འོད་ཀྱིས་དྲོས་པའི་བ་མོ་བཞིན།",
