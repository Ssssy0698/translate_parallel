    "མེ་འབྲུག་ཁྱུ་མཆོག་ཟླ་བའི་ཉེར་བཞིའི་རྒྱལ་ཕུར་གྱི་འགྲུབ་སྦྱོར་ཐོག་ལེགས་པར་གྲུབ་པའི་པར་བྱང་གི་ཡི་གེ་པ་རིགས་འཛིན་གྱི་བཙུན་པ་འཇམ་དབྱངས་གྲགས་པས་བགྱིས་པ་འདིས་ཀྱང་སྟོད་སྨད་བར་གསུམ་གྱི་འདྲེ་ངན་སོགས་ནག་པོ་བདུད་ཀྱི་དཔུང་ཚོགས་སྨེག་མེད་དུ་འཇོམས་ཤིང་བདེ་སྐྱིད་རྫོགས་ལྡན་གྱི་དཔལ་ལ་འགྲན་པའི་དགའ་སྟོན་ལ་སྤྱོད་པའི་བསམས་དོན་མ་ལུས་པ་ལྷུན་གྱིས་གྲུབ་པར་གྱུར་ཅིག།",
    "གཱཡདུརྐཪྻམཱཧོརྨཙཱརསྱགཱིརིཪྡིགཱཉསཱརམནྠཱཏྤྲཧཱིམྦུརྡྭིཔ་ཀརྨནོཏཱུརྞཔཉྩཱལྱཛདྒེཥུཙཱརེཀདེབོཏྤཤཱཀྱསྱསཾབརྞཀ།",
    "ཁྱོད་བསྟན་བྱང་ཕྱོགས་འཕེལ་བའི་འབྱུང་འགྱུར་ལུང་།",
    "ཡང་གསར་བཟོས་ཁྲོ་ཀོང་ཟླ་དྲུག་འཁྱོངས་པ་ཉེར་གསུམ་དང་ཟླ་གསུམ་ལྡང་བ་བརྒྱད་རྣམས་ཀྱི་ནང་དུ་ཟངས་དམར་གྱི་ཀོང་གཡེལ་མོ་ལྕགས་ཀྱི་རྐང་གསུམ་དང་བཅས་པ་བཞི་བཅུ།",
    "ཞིག་གསོས་ཁོ་ནར་དབུ་རྩེའི་མདའ་ཡབ་སོགས་གཙུག་ལག་ཁང་གི་ཆེད་དུ་ཤིང་བཟོ་བ་དགུས་ཟླ་བ་ལྔ་དང་ཞག་ཉེར་གསུམ་སོང་ངོ།",
    "བཀོད་པའི་རི་མོ་འཆར་འདིས་བདག་བྱིན་རློབས།",
    "སྔོན་ཆད་དཀར་མེ་ཁང་དང་སྣོད་སོགས་པར་བཀབ་མེད་པ་གསར་དུ་སྤེལ་ཆེད་༨༨བ་འདེགས་ཁལ་ཉི་ཤུ་རྩ་གྲངས་ལས་གྲུབ་པའི་ཟངས་ཆེན་ནང་དུ་བན་ཆེན་ཚད་བཞི་བཅུ་རྩ་གཅིག་རེ་འགྲོ་བ་གསུམ།",
    "དཀར་མེ་བཞུ་ཐབ་ཀ་དྲུག་ཉིས་ཐོག་གི་རྩིས།",
    "སྤྱན་རས་གཟིགས།",
    "སླད་ནས་ཀྱང་བྱེད་དགོས་ཁྱད་པར་མར་མེའི་གནས་ཁང་གི་ཕྱི་ནང་བར་གསུམ་གྱི་ནོར་རྫས།",
    "དཀར་མོའི་འབྲུ་དྲུག་གི་ཡོང་སྒོ་ས་གཞིས་མི་གྲ་སོགས་སྦྱར་བ་འདི་དག་ཀྱང་ལེགས།",
    "དམ་ཚིག་གི་རྗེས་གཅོད་པའི་འདྲེ་ཞིག་ཡིན་པས་གཉེར་བཏད་དྲག་པོ་བཞིན་ཁས་ལེན་གྱི་གཉེར་ཁ་དྲག་པོ་བྱེད་པར་གཏོད་ལུགས་ཕྱི་ནང་གསང་གསུམ་ཡོད་པས་ཕྱིའི་གཉེར་ཁ་ཙམ་ཡིན་ནམ་ཇི་ལྟར་ཡིན་གནང་བྱུང་བར་ཕྱི་ནང་གསང་གསུམ་གའི་འབུལ་བ་ཡིན་ཞུས་ལན།",
    "སྣང་སྟོང་དབྱེར་མེད་དྲེགས་རྒྱུད་ཕོ་མོའི་ཚོགས།",
    "པུ་ཏྲ་དང་གནོད་སྦྱིན་རྒྱུད་གཅིག་པ་ཁོ་ནའི་ཤེས་བྱ་མཐའ་བཀག་དེ་འདྲ་དགོས་པར་མི་སེམས་མོད།",
    "ཕྱི་ནང་གི་མཐུན་པའི་དམ་རྫས་དངོས་དང་རི་མོར་བཀོད་པས་མཚོན་ཐམས་ཅད་ཚང་བ་༩༡བ་དངུལ་ཕོར་དུ་སྐུ་ལྔའི་རྟག་གཏོར།",
    "ཐའི་ཇིར་རང་གི་གྲི་ཤེལ་རྡོ་གསེར་ཚགས་མ་གཅིག་དང་།",
    "མེ་མདའ་བཞི་སོགས་སྤྱན་གཟིགས་སྣ་ཚོགས།",
    "རྒྱ་རག་གི་མཆོད་ཀོང་གཅིག་དང་ཟླ་དྲུག་འཁྱོངས་པའི་ཁྲོ་ཟངས་ཀྱི་ཀོང་ལྕགས་ཀྱི་རྐང་གསུམ་དང་བཅས་པ།",
    "ཉིན་མཚན་ཐུབ་པའི་སྡོང་རྐང་རེ།",
    "བར་སྐས་གྱི་སྒོ་ཕིབས་ལ་གཟིག་དྲེད་རྒྱ་གཉིས་དང་བཅས་པའི་ལྡིང་གསོབ།",
    "མདུན་དབུས་ནས་ཟ་འོག་གི་རྒྱལ་མཚན།",
    "གསོལ་ཁ་བ་མི་གཅིག་གིས་ཉིན་སྟར་ཐོར་གསོལ་གྱི་འཕྲིན་ལས་གྱེར་བར་གཏོར་ཆས་དང་ཚོགས་ཆས་སོགས་ཆ་ཚང་།",
    "སྲོད་གསོལ་གྱི་དགོས་ཆ་གོང་བཞིན་དང་ཟླ་བ་ངོ་རེ་བཞིན་གྱི་ཚེས་བརྒྱད།",
    "ཡོངས་ཤར་གནམ་སྔོན་མཚོ་ལ་ངང་མོ་བཞིན།",
    "རྒྱུ་སྦྱོར་ཟུང་འཇུག་གིས་བཅོལ་ལས་ཀུན་སྒྲུབས།",
    "ཞེས་དུས་རྟགས་དང་གཏེར་གནས་འོན་ཕུ་སྟག་ཚང་ཤིན་དུ་འགྲིག་ཅིང་གཏེར་སྟོན་གྱི་མཚན་ཡང་པཎ་ཆེན་སྐུ་མཆེད་ཐུན་མོང་གི་ཟབ་གཏེར་རིགས་འཛིན་ཡོངས་འདུས་ཀྱི་ལུང་བྱང་ལས།",
    "བདག་གིས་བྱིན་བརླབས་པདྨ་རྒྱལ།",
    "ཞེས་བྱུང་བའི་རིགས་རུས་ཡབ་ཡུམ་ཡུལ་སོགས་ནི་སྐུ་མཆེད་དུ་སོང་བའི་སོ་སོར་དབྱེ་མ་དགོས།",
    "ཐུན་མོང་ལས་ཚོགས་མྱོང་གྲོལ་ལས་ཀྱང་།",
    "འདི་ཉིད་ལྟོར་སོང་ངན་སོང་ཁེགས།",
    "དེའི་དུས་བདག་གི་ཐུགས་རྗེ་དང་།",
    "ཕྲ་མོའི་ཡོན་ཏན་བརྗོད་པ་ག་ལ་ནུས།",
    "པདྨ་བདག་གིས་སྤྱད་པས་འཆི་མེད་གྲུབ།",
    "ཐུགས་རྗེ་ཆེན་པོའི་ལྷ་ཚོགས་ཚང་བ་ཞིག་དཔལ་བསམ་ཡས་ཀྱི་གནས་སུ་བཞུགས་ན་ལེགས་སོ་ཞེས་ས་སྐྱོང་རྡོ་རྗེ་རྣམ་རྒྱལ་ལ་ཆེད་དུ་མོལ་བ་ལྟར།",
    "རག་གི་མེ་དམ་ཆ།",
    "ཁྲོ་ཀོང་གཡེལ་མོ་ཟླ་དྲུག་འཁྱོངས་པར་མར་མེའི་རྒྱུན་ཆད་མེད།",
    "ཞལ་ཟས་བཅུ་རེ་ཉིན་སྟར་འབུལ་བའི་རྒྱུ་གཏོང་དེབ་ཏུ་བཀོད།",
    "དཀར་མེ་ཁང་གི་ལྷ་ཚོགས་སྔ་ཕྱིར་བཞེངས་པ་རྣམས་ཀྱི་བཟོ་དབྱིབས་ཀྱི་ཞལ་བཀོད་མཐའ་དག་རྡོ་རྗེ་བྲག་ནས་རིགས་འཛིན་སྤྲུལ་པའི་སྐུས་མཛད་ཅིང་དེ་ཉིད་དང་གྲ་བཅས་སུམ་ཅུ་སྐོར་གྱིས་ཞག་ཉེར་ལྔར་གཟུངས་འབུལ།",
    "དེ་ཞོར་གླིང་བཞི་གླིང་ཕྲན་ཇོ་མོའི་གླིང་སོགས་ལྷ་ཁང་ཚང་མའི་རྟེན་བརྟེན་པར་གསེར་བཏུལ་མ་ཞོ་བརྒྱ་ཐམ་པའི་གསེར་ཆབ་ཀྱི་སྲི་ཞུས་བེ་ཌཱུརྱ་སེར་པོའི་རི་བོ་ཉི་མས་འཁྱུད་པ་ལྟ་བུའི་གཟི་བྱིན་སྤྲོས།",
    "ཏིང་རེའི་རྒྱུར་དངུལ་སྲང་བརྒྱ་རེ་སོང་བ་གྲོས་བཀང་བའི་བདུན་ཚར།",
    "བང་རིམ་འོག་མའི་ཏིང་བར་དུ་མར་གྱི་ཞལ་ཟས་ཁྲུ་གང་གི་ཚད་ལ་མར་ཚོན་སྣ་ལྔའི་མེ་ཏོག་གི་རྒྱན་སྤྲོད་མཚར་བ་ཆོ་འཕྲུལ་ཟླ་བའི་ཚེས་གཅིག་དང་མཚུངས་ལོ་སྟར་གྱི་མཆོད་ཁང་ཆེ་ཕྲ་ཚོར་གསར་དུ་བརྗེ་བའི་རྒྱུན་བཙུགས།",
    "གཙུག་ལག་ཁང་བྱིངས་དང་ཕྱིའི་མཆོད་རྟེན་རྣམས་ལ་ལོ་སྟར་ས་རྩི་གསོལ་སྐབས་འུ་ལག་རྐང་རེར་རྩམ་མདའ་ཟོ་རེ།",
    "ཆང་བྲེ་རེ་ཡོང་བ་རྒྱུན་འཇགས་ཀྱི་རྒྱུར་འབྲུ་ཁལ་ཉེར་གསུམ་འགྲོ་བ་གཉེར་ཚང་གི་དེབ་ལ་བཀོད།",
    "ཀུན་དགའ་བོ་ང་ཡོངས་སུ་མྱ་ངན་ལས་འདས་ནས་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་རབ་ཏུ་བྱུང་བའམ་ཁྱིམ་ན་གནས་པ་གང་དག་ཁ་ཅིག་ཐ་ན་རིང་བསྲེལ་ཡུངས་འབྲུ་ཙམ་ལ་བསྟི་སྟང་དུ་བྱིད།",
    "རོལ་མོ་སྣ་ཚོགས་པ་ཉིད་འབུལ།",
    "མི་ལྡོག་པ་ཡི་སེམས་དག་གིས།",
    "པུས་མོའི་ལྷ་ང་སར་བཙུགས་ནས།",
    "ཐལ་མོ་སྦྱར་བ་བྱས་ནས་ནི།",
    "མིག་གི་མཐོང་ཚད་ངན་སོང་སྐྱེ་སྒོ་གཅོད།",
    "ཞེས་ཕྱོགས་འདིར་སྒོ་གསུམ་གྱི་ངལ་བ་བསྟེན་པ་མཐའ་དག་གནས་སྐབས་དང་མཐར་ཐུག་གི་འབྲས་བུ་ཡིད་དུ་འོང་བའི་ཚུལ་བསམ་གྱིས་མི་ཁྱབ་ཅིང་།",
    "ཞེས་བྱུང་ཞིང་གཏེར་སྟོན་གྱི་དངོས་སློབ་དཀའ་ཆེན་པ་ཀུན་དགའ་གྲགས་ཀྱིས་བརྟུལ་ཞུགས་ཆེན་པོའི་བདེན་པའི་ཚིག་གིས་སྐོར་ལམ་བསྲང་བ་སོགས་ཞབས་ཏོག་ཆེ་བས་ད་ལྟའི་བར་དུ་དབུ་རྩེ་དཀར་པོ་བས་འཛིན་བཞིན་པ་དང་།",
    "འོན་པ་ཉིས་བརྒྱ་སྐོར་ལ་ཁལ་ལྔ་རེ།",
    "མཆོད་རྟེན་དམར་པོ་པདྨ་སྟོང་གིས་བརྒྱན།",
    "མཆོད་རྟེན་ནག་པོ་མཆོད་རྟེན་སྟོང་གིས་བརྒྱན།",
    "ལས་དཔོན་ཞང་རྒྱ་ཚ་ལྷ་སྣང་གིས་བྱས་ནས་བཞེངས།",
    "ལས་དཔོན་ངམ་སྟག་ར་ཀླུ་གོང་གིས་བྱས་ནས་༡བ་བཞེངས།",
    "མཆོད་རྟེན་སྔོན་པོ་དཔལ་ལྷ་ལས་བབས་པ་དེ་བཞིན་གཤེགས་པའི་ལུགས་ལྷ་ཁང་བཅུ་དྲུག་གིས་བརྒྱན་པ།",
    "ལས་དཔོན་མཆིམས་རྡོ་རྗེ་སྤྲེའུ་ཆུང་གིས་བྱས་ནས་བཞེངས།",
    "མཆོད་རྟེན་འདི་རྣམས་བཞེངས་དུས་འདྲེ་མོ་འོད་ཅན་མས་བར་ཆད་འཚེ་བ་མང་དུ་བྱས་པར།",
    "དྲ་ཕྱེད་དང་རྩེ་རྒྱན་ཉི་ཤུའི་སྟེང་རྫ་མ་ནག་པོ་ཏོག་བཅས་ཀྱི་སྟེགས་པད་རྐང་གི་སྟེང་ཏོག་དང་ལྡན་པ།",
    "པད་གདན་གྱི་ས་ཁྲི་དཔངས་མི་གང་ལྷག་ཙམ་གསར་དུ་བཟོས་པའི་ཐོག་གིས་ཆུ་མི་འཛིན་པའི་གཡམ་གཅལ་ལེགས་པར་བསྒྲིགས་ཤིང་མཚམས་ཚོར་བུམ་གཏེར་བཅུག།",
    "གདུགས་ཀྱི་དྲ་ཕྱེད་ཀྱི་ནང་ཁོར་མ་དང་ལྕགས་ཐག་གི་དྲིལ་བུ་ལྕེ་བསྐུལ་ཟངས་ལེབ་བཅས་གོང་འདྲ།",
    "བྱང་གི་ས་ཁྲི་ནས་སེང་ཁྲི།",
    "པད་གདན་གྱི་ཁྲི་མི་གང་གི་སར་ཐོག་བཀལ་བ་ཆུ་མི་འཛིན་ཕྱིར་གཡམ་གཅལ་བསྒྲིགས་ལེགས་ཀྱི་སྟེང་ནས་བྲེ་མན་ཐམས་ཅད་ལ་རྡོ་རྩི་དམར་པོ་ཤིན་ཏུ་འཐུག་པ་རུང་བར་གསོལ་ཞིང་བུམ་གཏེར་གོང་འདྲ་གཞུག།",
    "དྲ་ཕྱེད་ཀྱི་ནང་ཁོར་དང་ལྕགས་ཐག་གི་དྲིལ་བུ་ལྕེ་བཅས་གོང་འདྲ།",
    "སོ་ཕག་གི་བར་ཚོར་ཆུ་མི་འཇུག་པའི་ཆེད་དུ་ཞ་ཉེ་བླུག་ཅིང་ཟུར་སྣེ་རྣམས་བརྟན་ཕྱིར་ཁྲོ་ཆུའི་གཟེར་གྱིས་བསྡམས།",
    "དཔངས་མི་གང་ཙམ་པའི་ས་ཁྲིའི་ཐོག་དང་གཡམ་གཅལ་གྱི་མཐར་ཆགས་སུ་གྱོ་བའི་ཆུ་ཁུང་གྲལ་བསྒྲིགས་ཀྱི་སྟེང་ལ་རྩིག་ཐུང་བསྐུམ་ཁྲུ་གང་གི་ཕྱི་ནང་ཐམས་ཅད་ཞལ་བ།",
    "རྟེན་གཙོ་སོ་སོར་དར་སྣ་དྲུག་རེའི་སྙན་ཤལ་ཉིན་སྟར་ཤོད་ཀྱི་བཅུ་གཉིས་པོ་སྤྱིར་མར་མེ་སྡོང་རྐང་རེ་དང་སོ་སོར་ཞལ་ཟས་རེ།",
    "ཟླ་རེའི་ཚེས་བཅོ་ལྔ་བྱུང་རེས་ལ་སྟེང་གི་བཞི་དང་ཤོད་ཀྱི་བཅུ་གཅིག་པོར་དཀར་མེ་སྡོང་རྐང་རེ་དང་སྟེང་གི་བཞི་ལ་བཤོས་ལྔ་རེའི་འཕར་མའི་རྒྱུན་བཙུགས།",
    "ཁང་པ་སུམ་ཐོག་གི་མཆོད་རྟེན་བུམ་པ་མན་བསྒྲིབས་པ་འགའ་ཞིག་འདུག་པ་ཉིས་ཐོག་ཏུ་ཕབ་སྟེ་གོང་པད་ལས་སྤྲོས་མི་རྩིག་པའི་བསྡམ་ར།",
    "སྲོག་ཤིང་གི་རྩ་བ་གྲུ་བཞིར་མཚོན་བདུན།",
    "གདུགས་ཀྱི་དྲ་ཕྱེད་ཀྱི་ནང་འཁོར་དང་ལྕགས་ཐག་གི་དྲིལ་བུ་ལྕེ་བཅས་གོང་མཚུངས།",
    "རྩེ་དཀར་བརྟན་བྱེད་ཀྱི་རྩི་སྦྱོར་བཟོས་གྲུབ་ནའང་གསོལ་སྐབས་མེ་ཚན་ཆེ་བ་བཏང་ཚེ་རིང་བསེལ་ཕེབས་པ་ཉུང་དུ་སོང་ན་ཞུགས་ཀྱིས་གནོད་པ་ཡིན་ཟེར་བའི་གྲགས་པ་ངན་པ་བྱུང་དོགས་རྡོ་ཞོ་ཟེར་བའི་རྩི་དཀར་འདི་གསོལ་ཞིང་ལོ་སྟར་ཡོང་བའི་རྒྱུན་རྣམས་ལེགས་པར་བཙུགས་ཤིང་གཏོང་དེབ་ཏུ་བཀོད།",
    "འཛམ་བུ་གླིང་གི་མངའ་བདག་རྗེ།",
    "སྟོང་གི་འཇིག་རྟེན་ཁམས་ཀུན་ཟིལ་གནོན་ཏེ།",
    "དག་ཅིང་མཆོག་གི་ལུས་ནི་འཐོབ་འགྱུར་ཏེ།",
    "རྡོ་ལ་རི་མོ་བྲིས་པ་ཇི་བཞིན་དུ།",
    "ལས་དཀར་ནག་གི་འབྲས་བུ་མི་འཆོལ་བ་སྟེ།",
    "ཐང་ཡིག་ལས་གདུང་རབས་བརྒྱ་དང་བཅུ་ལྷག་སོང་ཙ་ན།",
    "ཀུན་གྱི་མཐོང་སྣང་དང་མཐུན་པའི་ཕྱར་དར་མཐའ་མི་མགོན་བརྩོན་གྱིས་རི་མོ་བྲིས།",
    "རྗེ་མངའ་བདག་གིས་ཕོ་ཉ་བཀྱེ་ནས་དམག་དཔུང་རྣམས་ཁམས་ཀྱི་གཡར་མོ་ཐང་དུ་བསྡུས།",
    "རྒྱ་ཟམ་ཆེན་པོ་ཞིག་གི་སྔས་སུ་ལྕགས་ཕག་གི་དེའུ་བརྩེགས་པའི་སྟེང་དུ་ལྷ་སྲས་བཞུགས་ནས་ཕྱར་དར་བསླང་།",
