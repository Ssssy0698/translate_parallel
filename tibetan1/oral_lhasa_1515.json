    "འདིར་གསུངས་པ།",
    "དེ་ནི་འདི་ལྟར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་ནི་ངོ་བོ་ཉིད་མེད་པ་དེ་ལྟ་བུར་གྱུར་པས་ན་གཅིག་ཉིད་དུ་བརྗོད་པར་འགྱུར་རོ།",
    "འདིའི་རིམ་པ་ནི་དེའི་དབུས་སུ་གྱུར་པར་མ་ཧེ་བསམ་པར་བྱ་སྟེ།",
    "གསང་བའི་དཀྱིལ་འཁོར་དབུས་གནས་པར།",
    "འདི་བཞིན་དུ་ཇི་ལྟ་བའི་སྦྱོར་བས་གཤིན་རྗེ་གཤེད་གཞན་རྣམས་ཀྱང་རིག་པར་བྱའོ།",
    "རྣལ་འབྱོར་པས་བརྩམ་པར་བྱ་བར་སྟོན་པ་སྟེ།",
    "དེ་ནི་འདི་ལྟར་ལྷའི་རྣལ་འབྱོར་དམིགས་པར་བྱ་བས་སོ།",
    "རལ་གྲི་གཤིན་རྗེ་གཤེད་བསྒོམས་པས་ཇི་ལྟར་གོམས་པར་འགྱུར་བའི་རྣལ་འབྱོར་པ་དེས་ཞི་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་བྱེད་ནུས་པར་འགྱུར་རོ།",
    "ད་ནི་ཨཉྫ་ནའི་སྦྱོར་བས་མི་སྣང་བར་བྱེད་པ་གསུངས་པ།",
    "དེའི་ཐོད་པ་བླངས་ནས་དེའི་སྐྲ་ལ་སྡོང་བུ་བྱས་ཏེ།",
    "འདིར་ཡང་སྔོན་དུ་བསྙེན་པ་འབུམ་ཕྲག་གཅིག་འདི་ལྟར་རྣལ་འབྱོར་པས་བྱས་ན།",
    "ཨོཾ་ཧྲཱི་ཥྚྲྀ་ལ་སོགས་པའི་གསང་སྔགས་འབུམ་བཟླས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་སྔོན་དུ་བསྙེན་པ་ཡང་འབུམ་བྱས་ཏེ།",
    "དེ་བཞིན་དུ་རི་ལུའི་དངོས་གྲུབ་གསུངས་པ།",
    "ཤ་ལྔ་ཞེས་བྱ་བ་ནི་གོ་ཀུ་ད་ཧ་ན་རྣམས་ཡི་གེ་དང་པོའོ་། འདི་ལྟར་དེ་རྣམས་ལས་རི་ལུ་བྱས་ཏེ།",
    "སྔོན་དུ་བསྙེན་པ་མཐུན་པར་བཟླས་བརྗོད་བྱས་ཏེ།",
    "ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་དེ་བཞིན་དུ་གསུངས་པ་ནི།",
    "ཡེ་ཤེས་རྒྱ་མཚོ་མཉན་པར་འཚལ་། ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ།",
    "འདི་ཅི་ཞིག་གཞན་ཡང་མཐའ་དང་དབུས་རྣམ་པར་སྤངས་པ་ནི།",
    "སྐྱོན་ཐམས་ཅད་རྣམ་པར་བསལ་བ་ནི།",
    "བར་དང་མཐའ་རྣམ་པར་བསལ་ན།",
    "ནམ་མཁའི་མེ་ཏོག་ལ་སོགས་པ་བཞིན་གདོད་མ་ནས་ལྡན་པར་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་དེ་ཁོ་ན་ཉིད་ཀྱི་ངོ་བོ་ནི་ཡོད་པ་ཉིད་དང་མེད་པ་ཉིད་ཀྱི་ངོ་བོ་ཉིད་འགྲོ་བའི་དངོས་པོ་མཐའ་དག་ཡིན་པར་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "དེས་ན་གལ་ཏེ་དེ་ཁོ་ན་ཉིད་ཐམས་ཅད་དུ་དེ་ཁོ་ན་ཉིད་རྟོགས་པས་སྲོག་ཆགས་ཐམས་ཅད་ཀྱིས་གྲོལ་བ་ཉིད་ཐོབ་པར་འགྱུར་རོ།",
    "དེ་བས་ན་དངོས་པོ་མེད་པར་ངེས་པའི་བདག་ཉིད་ལས་དངོས་པོ་གཉི་ག་ཡང་བསལ་བ་འདི་གྲུབ་པོ།",
    "ཡང་ན་ཡོད་པའི་དངོས་པོ་ལ་སོགས་པ་འདི་དག་ཐམས་ཅད་ཇི་ལྟ་བ་ཡང་དག་པར་རིག་པ་དེ་ལ་ཁོ་ན་ཉིད་ཀྱི་དངོས་པོ་ཞེས་བྱ་བ་ཉེས་པ་མེད་དེ།",
    "འདི་ལྟར་གཞན་གྱི་ཤེས་པས་ངོ་བོ་ཉིད་ཡོངས་སུ་ཤེས་པར་འགྱུར་བ་མེད་དེ།",
    "དེ་བས་ན་བག་ཆགས་ཀྱི་སྐྱོན་གྱིས་དེ་ཉིད་ཡོངས་སུ་བསྒྱུར་བར་རྣམ་པར་རྟོག་པར་བྱ་སྟེ།",
    "ཅི་གཟུང་བ་ལ་སོགས་པའི་དངོས་པོ་བརྫུན་པ་ཉིད་དུ་ཤེས་པར་བྱ་སྟེ།",
    "དེས་རྣལ་འབྱོར་པ་གྲོལ་བ་ཐོབ་པར་འགྱུར་ཏེ།",
    "འདི་ལྟར་རྣམ་པར་ཤེས་པ་དེའི་ཡང་དག་པ་ཡང་བླུན་པོ་རྣམས་ཀྱིས་བདེན་པའི་དོན་ཅི་ཡང་ཤེས་པ་མེད་དེ།",
    "འོ་ན་ཡང་རྣམ་པར་ཤེས་པའི་བདག་ཉིད་དེས།",
    "དེ་བས་ན་ཤེས་བྱ་ལ་ལྟོས་ནས་ཤེས་པ་གྲགས་པར་འགྱུར་རོ།",
    "དེས་གཟུང་བ་དང་འཛིན་པའི་བདག་ཉིད་དེ་ཁོ་ན་ཉིད་ལ་བརྗོད་པར་འགྱུར་རོ།",
    "སེམས་ཞེས་བྱ་བ་ནི་གསལ་བར་ཉམས་སུ་མྱོང་བ་ཙམ་གྱི་ངོ་བོ་ཉིད་དུ་བརྗོད་པར་གྲགས་པ་ཉིད་དོ། ། དོན་དམ་པར་ནི་སེམས་ཞེས་བྱ་བ་གཟུང་བ་ལ་སོགས་པ་འདི་ལྟ་བུའི་བྱེད་པའི་སྐྱོན་དང་ལྡན་པ་དེའི་རིག་པ་མེད་དོ།",
    "དེ་བས་ན་སེམས་ཀྱང་སེམས་ཀྱི་རྣམ་པ་དང་བྲལ་བར་རིག་པ་ནམ་མཁའ་ལྟར་བརྗོད་དུ་མེད་པར་རྟོགས་པར་བྱ་སྟེ།",
    "དེ་ནི་འདི་ལྟར་དེ་ཁོ་ན་ཉིད་ཀྱི་དངོས་པོ་ལ་གོམས་པར་གྱུར་པ་ཉིད་ཀྱིས་དེ་བཞིན་གཤེགས་པའི་གོ་འཕང་ཐོབ་པར་འགྱུར་རོ།",
    "གཞན་ཡང་འདི་ལྟར་དོན་དམ་པར་ན་བརྫུན་གྱི་དངོས་པོའི་འཆིང་བས།",
    "འབྲས་བུ་སྒྲུབ་པར་བྱེད་ན་དེ་ལ་ཇི་ལྟར་བརྫུན་ཞེས་བྱ།",
    "ཡང་ཐ་དད་པའི་མཚན་ཉིད་ཀྱི་ཁྱད་པར་གྱིས་དབྱེ་བར་འགྱུར།",
    "དོན་དེས་བརྫུན་པར་མི་འགྱུར་རོ།",
    "འདི་ལྟར་ཐམས་ཅད་བརྫུན་པ་ཉིད་ན་ཡང་བག་ཆགས་ཀྱི་རྣམ་པར་སྤྲུལ་པས་དེའི་འབྲས་བུ་ལེན་ཏེ།",
    "དེ་ལྟ་བུ་བླངས་པ་ལས་ཀྱང་འབྲས་བུ་སྒྲུབ་པར་བྱེད་དོ།",
    "དེ་ལ་འདི་བརྗོད་པར་བྱ་སྟེ།",
    "བདེན་པའི་ལམ་མཁྱེན་པ་དང་།",
    "བདེན་པར་རློམ་སེམས་པ་དེ་ལྟ་དེ་ལྟར་ལས་ཀྱི་བག་ཆགས་སྣ་ཚོགས་སོགས་པར་རིག་པར་བྱའོ།",
    "དེ་ལ་འདི་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལྟ་བུའི་རྣམ་པའི་སྔགས་དང་དངོས་གྲུབ་ལ་སོགས་པར་རབ་ཏུ་སྦྱོར་བ་མི་རིགས་ཏེ།",
    "ཞི་བ་ལ་སོགས་པར་ཡང་རབ་ཏུ་སྦྱོར་བ་འདིས་འགྱུར་རོ་ཞེས་བྱ་བའོ།",
    "རབ་ཏུ་སྦྱོར་བ་ཇི་ལྟ་བ་དེ་ཉིད་གསུངས་པ།",
    "མདུན་དུ་བསྒྲུབ་བྱ་བཟླས་པ་ལ་གནས་པར་བལྟས་ལ།",
    "དེ་ནས་འབུམ་ཕྲག་གཅིག་ཏུ་བཟླས་པ་ཨོཾ་ཧྲཱི་ཞེས་བྱ་བ་ལ་སོགས་པ་བརྗོད་པར་བྱའོ།",
    "གསང་སྔགས་ཇི་ལྟར་སྦྱར་བ་གསུངས་པ།",
    "དེ་ཉིད་གསུངས་པ།",
    "གཞན་ཡང་རྒྱས་པའི་རབ་ཏུ་སྦྱོར་བ་གསུངས་པ།",
    "དེ་བཞིན་དུ་བསྒྲུབ་བྱ་གཞུག་པར་བྱའོ།",
    "དེ་གསང་སྔགས་བོ་ཥཊ་ཀྱི་ཚིག་ཀྱང་རུང་སྟེ་མཐར་གཞུག་པར་བྱའོ།",
    "དེས་ཀྱང་རྒྱས་པར་འགྱུར་རོ།",
    "དེ་ནས་འཁོར་ལོ་ཁམ་ཕོར་ཁ་སྦྱར་དུ་གཞུག་པར་བྱའོ།",
