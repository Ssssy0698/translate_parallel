    "མ་ཡིན་ཏེ་རྒྱུ་ལ་འབྲས་བུ་ཉེ་བར་གདགས་པ་བྱས་ནས།",
    "དཔེར་ན་སྐུད་པ་ནག་པོ་ལས་བྱས་པའི་སྣམ་བུ་ནག་པོར་འགྱུར་བ་བཞིན་ནོ།",
    "གཞན་དུ་ན་རྗེས་སུ་མཐུན་པ་ཇི་ལྟ་བར་ལེན་པར་བྱེད་པར་མི་འགྱུར་རོ་ཞེ་ན།",
    "དེའི་ཕྱིར་ངོ་བོ་ཉིད་ཐ་དད་པ་ལ་ཇི་ལྟ་བར་རྗེས་སུ་མཐུན་པར་བརྟག་པ་འདིས་ཅི་ཞིག་བྱ།",
    "ལྷན་ཅིག་སྐྱེས་པའི་བདག་ཉིད་ནི་བདེ་བཞིན་པའི་ཡེ་ཤེས་ཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་ལྟ་ན་བག་ཆགས་ཀྱི་སྒྲིབ་པ་ཟད་པར་བྱས་པས་རང་ཉིད་དེ་ཁོ་ན་ཉིད་རང་རིག་པ་རྟོགས་པར་བྱེད་དེ།",
    "འདིས་ནི་སྲིད་པ་དང་མི་སྲིད་པ་ལ་སོགས་པའི་བདག་ཉིད་ཀྱི་དམིགས་པ་རྣམ་པ་གཉིས་ཀ་ཡང་བསལ་བར་རིག་པར་བྱ་སྟེ།",
    "ཐམས་ཅད་ཀྱིས་ཀྱང་དེ་ཐོབ་པར་འགྱུར་ཏེ།",
    "འདི་སྐད་བརྗོད་པར་བྱ་སྟེ།",
    "ཁོ་བོ་ནི་དེ་ཁོ་ན་ཉིད་མེད་པར་སྨྲ་བ་མ་ཡིན་ཏེ།",
    "སོ་སོར་རྟོགས་པར་བྱ་བའི་ཕྱིར་འབད་པར་བྱེད་དེ།",
    "གཞན་ཡང་རྣམ་པ་ཐམས་ཅད་ངོ་བོ་ཉིད་མེད་པ་ཉིད་རྣམ་པ་དང་བྲལ་བའི་དེ་ཁོ་ན་ཉིད་ཀྱི་ཡེ་ཤེས་སུ་དེ་བརྗོད་པར་འགྱུར་རོ།",
    "སྔོན་པོའི་ཤེས་པ་ཉིད་ཀྱིས་སྔོན་པོ་བརྫུན་པར་རྟོགས་པ་མ་ཡིན་ནོ།",
    "རིག་པ་ཉིད་ཀྱིས་བདེན་པར་མི་བྱེད་དོ།",
    "ཡང་བདེན་པ་གཞན་གྱི་རྣམ་པར་བརྫུན་པར་རྟོགས་པ་ནུས་པ་ཡང་མ་ཡིན་ཏེ།",
    "གཞན་ཡང་ཤེས་པ་གཞན་གྱིས་ཤེས་པ་གཞན་གྱི་ཁྱད་པར་བརྫུན་པར་བྱེད་པར་ནུས་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེའི་ངོ་བོ་ཉིད་ཀྱིས་ཀྱང་དངོས་པོ་ཐམས་ཅད་བརྗོད་པ་དང་བྲལ་བ་ལེན་པར་མི་འགྱུར་རོ།",
    "འདི་ཇི་ལྟ་བུ་ཞིག་རྣམ་པ་དང་བྲལ་བ་ཡོངས་སུ་བསལ་བ་ལས་དེ་ཁོ་ན་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་རྣམ་པ་ཉིད་ལེན་པར་འགྱུར་ཏེ།",
    "འདི་དག་ཐམས་ཅད་ལ་རྣམ་པར་ཤེས་པའི་ངོ་བོ་ཉིད་སྐྱེ་བས།",
    "དེ་ལ་ཡང་ལེན་པར་བྱེད་པ་མེད་པའི་ཕྱིར་ཏེ།",
    "དེའི་གནས་སྐབས་ན་རྣམ་པ་དང་བཅས་པ་ལ་སོགས་པའི་དངོས་པོའི་རྟོག་པ་མེད་པར་འགྱུར་ཏེ།",
    "རྣམ་པ་ལ་སོགས་པ་རྗེས་སུ་རྟོག་པའི་རྣམ་པར་དབྱེ་བ་འདི་ནི།",
    "དེ་ནས་པར་སྣང་ལ་ཡི་གེ་ཨ་བསྒོམས་ཏེ།",
    "དེ་ལས་འདི་ལྟར་རྡོ་རྗེ་འཕྲོས་པས་ཐད་ཀར་ནི་རྡོ་རྗེར་བ་བསམ་པར་བྱའོ།",
    "དེ་ནས་ལྷ་བཅུ་གསུམ་གྱི་གནས་རྣམས་སུ་ས་བོན་གྱི་ཡི་གེ་རྣམས་ལས་རྣམ་པར་བསྐྱེད་པའི་མཚན་མ་གསུངས་པ།",
    "དངོས་གྲུབ་སྦྱིན་པར་མཛད་པར་རྗེས་སུ་རིག་པར་བྱའོ།",
    "དེ་ནས་ཤར་ཕྱོགས་སུ་གཏི་མུག་གཤིན་རྗེ་གཤེད་འཇིགས་པར་བྱེད་པ་ལ་སོགས་པའི་གཟུགས་འཛིན་པ་འདི་ལྟ་བུར་བསམ་པར་བྱའོ།",
    "ལྷོར་སེར་སྣ་རྡོ་རྗེ་གཤིན་རྗེ་གཤེད་དང་འདི་ལྟ་བུ་ལ་སོགས་པ་གཞན་ཡང་ཇི་ལྟར་བརྗོད་པ་བཞིན་ཤེས་པར་བྱའོ།",
    "དེ་བཞིན་དུ་སྒོ་བཞིར་རྡོ་རྗེ་དཔལ་རྩེ་བཞི་དང་མཉམ་པར་ཐོ་བ་རྡོ་རྗེ་ལ་སོགས་པ་གཤིན་རྗེའི་དགྲ་བཞིའོ།",
    "དེ་ནི་འདི་ལྟར་ལྷ་བཅུ་གསུམ་གྱི་བདག་ཉིད་ཀྱི་དཀྱིལ་འཁོར་དུ་རྟོགས་པར་བྱ་སྟེ།",
    "དེ་བཞིན་དུ་གཏི་མུག་རྡོ་རྗེ་གཤིན་རྗེ་གཤེད་ཀྱི་སྔགས་གསུངས་པ།",
    "དེ་ལ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་རྣམ་པར་དག་པ་ནི་ཕྱག་དྲུག་གོ།",
    "འགྲོ་བ་མ་ལུས་པ་ཡེ་ཤེས་སྐྱེད་པར་བྱེད་པ་འཁོར་ལོའོ།",
    "དམ་པའི་དགའ་བའི་བདག་ཉིད་རྟོགས་པར་བྱེད་པ་པདྨའོ།",
    "སྟོང་པ་ཉིད་ཁོང་དུ་ཆུད་པར་བྱེད་པ་ཀ་པཱ་ལའོ།",
    "ཞེ་སྡང་ཐམས་ཅད་ཟད་པར་མཛད་པའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་རྡོ་རྗེ་འཛིན་པ་འདི་ལྟ་བུའི་ངོ་བོ་ཉིད་དུ་གྱུར་པར་མཛད་དོ།",
    "གཏི་མུག་རྡོ་རྗེ་ལ་སོགས་པའི་གཤིན་རྗེ་གཤེད་བཞི་གསུངས་པ།",
    "གཏི་མུག་ཐམས་ཅད་ཟད་པར་མཛད་པའི་ཕྱིར།",
    "འདི་ལྟར་སེར་སྣ་ལ་སོགས་པ་རྣམ་པར་དག་པར་བྱ་བའི་ཕྱིར།",
    "ཀ་པཱ་ལ་རྣམས་བསྣམས་པར་བལྟའོ། ། ཕྱག་ན་རལ་གྲི་བསམ་པར་བྱ།",
    "ཞེས་བྱ་བ་ནི་ཕྲག་དོག་རྡོ་རྗེ་གཤིན་རྗེའི་དགྲའི་ཕྱག་དང་པོ་ན་རལ་གྲི་བསྣམས་པར་བསམ་པར་བྱའོ།",
    "བྱམས་པ་ལ་སོགས་པ་ཚངས་པའི་གནས་བཞི་རྣམ་པར་དག་པའོ།",
    "ཕྱག་གཡས་དང་པོ་ན་འཁོར་ལོ་བསྣམས་པར་བལྟའོ།",
    "མཚོན་ཆ་གཞན་ནི་གཤིན་རྗེ་གཤེད་དང་མཐུན་པར་བསྣམས་པར་རིག་པར་བྱའོ།",
    "གཞན་དང་ནི་གཤིན་རྗེ་གཤེད་ཇི་ལྟ་བ་བཞིན་དུ་སྦྱར་བར་རིག་པར་བྱའོ།",
    "ཤར་དང་ལྷོ་ལ་སོགས་པའི་སྒོ་བཞི་འཇོ་མས་པར་བལྟ་བར་བྱའོ།",
    "གཞན་ཐམས་ཅད་ནི་དཀྱིལ་འཁོར་གྱི་བདག་པོ་གཤིན་རྗེ་གཤེད་བཞིན་དུ་རྟོགས་པར་བྱའོ།",
    "དེ་དག་ཀུན་དུ་བཅད་ནས་འགྲོ་བ་རྣམས་བདེ་བ་ཆེན་པོ་གནས་པར་བཞེད་ནས།",
    "ཞེ་སྡང་ལ་སོགས་པའི་གཤིན་རྗེ་གཤེད་དུ་སྤྲུལ་པར་མཛད་དོ་ཞེས་བྱ་བ་རྟོགས་པར་བྱའོ།",
    "དེ་ལྟར་སྤྲུལ་པ་དེ་ལྟ་བུའི་གཟུགས་དག་ལ་གཞན་དུ་ལྟོས་པ་མེད་པར་རིག་པར་བྱའོ་ཞེ་ན།",
    "འདི་ནི་མ་ལུས་པའི་སྡུག་བསྔལ་ཐམས་ཅད་འདོན་པར་བྱེད་པར་འགྱུར་རོ།",
