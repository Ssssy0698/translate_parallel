    "དེའི་ཚེ་ཚོམས་དམར་དུ་ཚོགས་ཡོངས་ནས་རབ་གནས་ཀྱིས་ཕྱི་བསྐོར་ལ་མེ་ཏོག་འཐོར་གནང་དང་ཆབས་གཅིག་སྐུ་གསུང་ཐུགས་རྟེན་འགའ་ཞིག་སྤྱན་འདྲེན་གྲས་ལ་འཇམ་དབྱངས་རྩོད་རྒྱལ་མའང་ཕེབས་པས།",
    "ཡི་གེ་དང་རྫས་སོགས་ཕྱུང་བ་སྐུ་ཚབ་ནས་ཀློག་རྩིས་བྱས་པས།",
    "ཡང་ལམ་ཚོམས་ཆེན་དུ་རབ་སྟོན་གྱི་བཞུགས་ཁྲི་སོགས་བཀའ་འདོམས་སྔོན་གྲུབ་ལ་ཤིས་བརྗོད་ཀྱི་མེ་ཏོག་དང་།",
    "ཞལ་ཆེན་བྱང་སོགས་ནས་མཐིལ་བསྐོར་དུ་ཕེབས་ཏེ།",
    "རྡོར་དྲིལ་རྣམ་རྒྱལ་བུམ་པ་སོགས་བསྣམས་ནས་ཚོམས་ཆེན་དུ་རབ་སྟོན་ལ་ཕེབས་ཐོག་ཞལ་ངོ་སོགས་རིམ་བཞིན་ལེགས་འབུལ་གྱི་སྐབས།",
    "བཞུགས་གནས་ནང་སོ་པུ་ཏྲ་ཁང་ཉམས་གསོ་གསར་བཞེངས་དྲག་པོའི་གཞལ་ཡས་ཁང་ཚད་དང་མཚན་ཉིན་ཅན་དུ་བསྐྲུན་པ་དང་།",
    "གུར་མགོན་གཏོར་མའི་ལས་ཚོགས་རྗེ་བཙུན་གོང་མའི་ཕྱག་བཞེས།",
    "ཚོང་འདུས་རྣམས་ཀྱང་མ་རུངས་བར་བྱས།",
    "ཟུར་གསོས་སོགས་གནང་ཆ་ཡང་དག་མཛད།",
    "གུར་ལྕམ་དྲལ་གྱི་འཆམས་སྐུ་བྱིན་ཅན་རྣམས་འཆམས་པར་མཛད་པས།",
    "རྟག་གཏོར་སོགས་འཛུགས་གནང་སྐབས།",
    "ཤོམ་དང་འདོན་འཁྲིགས་དབྱངས་རོལ་བཅས་རྗེ་ཉིད་ནས་ཞག་འགའ་གནང་བས་ངོ་མཚར་བའི་རྟགས་ཀྱང་མང་དུ་འཁྲུངས་ཤིང་།",
    "ཅེས་ཀྱང་སྨྲས་སོ། དགུང་གྲངས་ཞེ་གཉིས་སུ་ཕེབས་པ་ལྕགས་སྟག་དབོ་ཟླའི་ནང་།",
    "ནག་ཟླའི་ནང་མཛོད་འཛིན་པར་བཀའ་གསང་འདི་ལྟར་གྲོལ་ཏེ།",
    "རྒྱ་བོད་མཁས་གྲུབ་དང་གཟུར་གནས་ཀུན་གྱིས་རང་བཞིན་བརྗོད་དུ་གསུངས་པ་དེ།",
    "ཟིམ་ཆར་གྱིས་ས་གཞི་སྣུམ་པོར་བྱས།",
    "ཞེ་དྲུང་སོགས་ཁ་འཐོར་བ་རགས་བསྡུས་བཅས་གངས་ཉི་ཤར་ཙམ་ལ་གང་འཁོད་ཚང་མ་གཟབས་བཞེས་ཀྱིས་རིམ་འདུས་དང་བཅས།",
    "རྗེ་རྡོ་རྗེ་འཆང་ཉིད་ཐོག་མར་ཕེབས་པའི་སྔོན་ཙམ་ལ།",
    "ནོར་དང་བཀྲ་ཤིས་རྣམ་པར་འཕེལ།",
    "ནངས་པར་དུས་སམ་ཡང་ན་ཞི་བའི་ལས་བྱེད་དང་།",
    "ཞེས་གསུངས་པས།",
    "ལམ་འཇུག་ནི་སྐས་རིང་ལ་གྱེན་ཕེབས་དང་།",
    "ནངས་པར་ནི་ཆུ་སྟོད་ཚེས་བཞི་གངས་ཉི་ཤར་དུས་དེ་དང་།",
    "སྐྱེ་བོ་རྣམས་སོ་སོའི་འདོད་ཡོན་གྱིས་ཚིམས་པར་མཛད་མཐར་གླུ་གར་སོགས་རྒྱ་ཆེར་གནང་བ་དང་།",
    "རྩེར་ལྷ་བསངས་སྐབས་བྱ་རོག་སྣུམ་བག་ཅན་གསུམ་འོངས་ཏེ་དབུས་མའི་མཆུ་ཡས་མས་མར་གྱིས་དཀར་པོར་བྱས་ཏེ།",
    "གསུམ་ག་རྗེའི་ཞལ་དཀྱིལ་ལ་བལྟ་བཞིན་དུ་སྐད་སྙན་སྒྲོགས་པར་བྱེད་དོ།",
    "བྱིངས་རྣམས་མཁར་ཐོག་ཁུད་ཡངས་སུ་བསྡད།",
    "དེའི་སང་དགེ་ཚ་དང་དེ་མཚམས་ནས་མཛོད་འཛིན་བླ་བྲང་མཆོག་ཏུ་གཏན་ཚིགས་ཞུ་བར་ཕེབས་པས་མགོ་འདྲེན་བདག་རྐྱེན་གྱི་བརྩེ་འཛིན་ཡང་དག་གནང་།",
    "ཁྲུམས་ཟླའི་སྒྲུབ་མཆོད་ཐོག་སྟོད་སྒར་དཔོན་ཤག་བྱང་ཨེརྑེ་ཐཱ་ཇི་འབུལ་ཆེན་དང་བཅས་འབྱོར་བས་གང་ཅིའི་གསུང་གླེང་ཞིབ་ཆ་དང་།",
    "ན་བཟའ་བཅས་འབུལ་བར་གནང་།",
    "བརྡལ་ལ་སྒང་བཞུགས་ཁྲིར་ཕེབས་ཚེ་ཐུགས་སྤྲོ་ཉམས་ཀྱིས་མནལ་སད་པ་ནི།",
    "བདེ་བར་སད་པར་འགྱུར་རོ།",
    "ཞེས་གསུངས་པ་བཞིན་དང་།",
    "དེའི་ཚེ་རྗེ་རྡོ་རྗེ་འཛིན་ཆེན་པོས་འཛིན་པར་མཛད་ཅེས་གླེང་བར་གྱུར་ཏོ།",
    "དེ་སྔོན་གཞི་ཐོག་རྩེར་སྐུ་ཡོན་ཁང་གསར་བསྐྲུན་མཛད་པར་དབྱུག་ཟླའི་ཉེར་གསུམ་ནས་བདུན་ཕྲག་གཅིག་ཕུར་སྒྲུབ་རྡུལ་དཀྱིལ་སྟེང་ནས་ཉིན་གང་མ་མཛད་སྐབས།",
    "ཇིའི་སང་ལ་བྱང་ཆོག་ཀྱང་གནང་།",
    "སྐུ་ཡོན་ཁང་དུ་རྟེན་མཆོད་རྒྱུན་བཞུགས་སྟེང་དམིགས་བསལ་འཇམ་དབྱངས་རྩོད་རྒྱལ་མ།",
    "སྐུ་ཡོན་པ་བཅས་ལ་རྗེ་ཉིད་ནས་མགུལ་དར་སོགས་སྩལ་རྗེས་སྒོ་རུམ་དུ་ཕེབས་ཏེ།",
    "དེ་སྔོན་ཙམ་ནས་བླ་བྲང་རྩེ་ཤོད་དབུས་ཕེབས་སྐབས་སྐུ་ཚབ་ཅིག་ལེགས་སྐྱེས་འབུལ་བར་མངགས།",
    "སྐྱེད་ལྷས་ལྷོ་རི་དེ་ན་རྗེ་ཉིད་གཏོར་འབུལ་མཛད་ཀྱིན་ཡོད་དགོངས་པར།",
    "རྗེ་ཉིད་བལ་ཡུལ་དུ་ཕེབས་པར་སྔར་བས་བག་དྲོ་ཞིང་།",
    "ལྔ་བརྒྱ་ཐ་མའི་དུས་འདིར་བལ་བོད་མི་རྟག་སྒྱུ་མའི་སྣང་ཚུལ་སྟོན་པར་གསུངས་པའི་དུས་དེར་སླེབ་པ་ལྟ་བུའི་གངས་རིའི་ལྗོངས་འདིར་མཆོད་ཡོན་དུ་མ་ཞིག་ལ་འཕོ་འགྱུར་རིམ་ཅན་བྱུང་བ་དང་།",
    "མཐར་རྒྱ་གར་སོགས་ཡུལ་གྲུ་གཞན་ལའང་བརྡབ་གཟིངས་ལངས་པ་ལྟ་བུ་ཤར་སྐབས་བསྟན་འགྲོའི་བདེ་སྐྱིད་བརྟས་ཕྱིར་ཕུལ་བ་ཡིན་གསུངས་པའི་སྐབས་སུ།",
    "ཟླ་མཇུག་བློ་བུར་དུ་པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་པ་གཙང་ལ་ཆིབས་བསྒྱུར་གྱི་གླེང་བ་དང་།",
    "ཞག་ལྔའི་རིང་རྗེ་རྡོ་རྗེ་འཆང་ནས་བསྐུལ་མཁན་དང་རྡོ་རྗེ་སློབ་དཔོན་གཉིས་ཆར་འགན་བཞེས་ཀྱིས།"
  ]
}