    "འཆད་རྩོད་རྩོམ་སོགས་གསུངས་ཕྱིར་དྲིན་ཅན་རྗེས།",
    "གཟིམ་ཆུང་གཙོ་བོའི་ཤར་ལྷོར་རྒྱལ་མཚན་དཀར་པོ་འོད་ལྡན་ཚུགས་གསུངས་པ་ལས་སྐུ་སྲོག་ལ་སྐྱོན་འབྱུང་མིན་ངེས་སྦྱར་ཞུ་བར་མཛད་ཀྱང་ལན་མེད་དུ་ཡལ།",
    "དེ་སྐབས་གཟིམ་ཆུང་ཤར་ན་རྗེ་རྡོ་རྗེ་འཛིན་ཉིད་བཞུགས་པ་བཞིན་གཙོ་བོ་ཡིན་པས་དེའི་ཤར་ལྷོར་རྒྱལ་མཚན་དཀར་པོ་འཛུགས་དགོས་དེ་བཞིན་རིང་མིན་ནས་སྔགས་འཆང་གོས་དཀར་ལྕང་ལོས་མཛེས་པའི་སྐུར་བཞེངས་དགོས་ཀྱི་བརྡ་དང་།",
    "ས་གའི་ཚེས་འགོར་འཇམ་མགོན་གཅུང་དམ་པའི་སྐུ་མཚམས་གྲོལ་ཀྱང་སྦྱིན་སྲེག་ནི་གནང་མ་ཐུབ།",
    "དེའི་ཚེས་བཅུ་དྲུག་ཉིན་གཡའ་ལུང་འཇག་གཤོངས་ཀྱི་འཁོན་སྐུ་འབུམ་ལ་ཉམས་གསོ་གསར་བསྐྲུན་ནང་གཟུངས་བཅས་ལེགས་པར་མཛད།",
    "བསེ་མགོན་བཞུགས་ཁྱིམ་ན་མལ་ལོའི་ཐུགས་དམ་མ་ཡིན་ཟེར་བའི་རུས་ཀྲོང་གཟི་བརྗིད་ཅན་ཞིག་མཆིས་པར་བསེ་མགོན་གྱི་ཚབ་ཡིན་འདྲ་དགོངས་པ་ཞིག་དང་།",
    "ལན་ཅིག་སྐུ་མཆེད་ཕྱག་སྦྲེལ་གྱིས་ཕེབས་བཞིན་པའི་མུར་སྐུ་སྐྱེ་དེའི་རྣམ་པ་མེད་པར་བྱིས་པ་ལོ་ལྔའི་ཚོད་ཙམ་ཞིག་མཆིས་པའི་མཐར།",
    "རྗེ་དེར་བརྟག་པར་བསྐྱར་ཞུས་མཛད་པས་འཇམ་མགོན་གཅུང་དམ་པར་རིམ་གྲོ་ཕྲན་བུ་དང་།",
    "འཇམ་མགོན་དེ་ཉིད་ཀྱིས་མངོན་མཁྱེན་གསལ་པོར་སྩལ་བ་ཡིན་གྲང་།",
    "མཁའ་འགྲོ་བསུན་བཟློག་མཛད་སྐབས་བསུ་བ་རྣམས་ཕྱིར་སློག་པའི་མཚན་མ་མུས་ཆེན་ལ་འཁྲུངས་པས་ད་ཆ་ཡར་བསྐྱེད་བཞེས་པ་ཞིག་ཨེ་ཡོང་གསུངས་མུར་གདུགས་དཀར་བྱད་འགྲོལ་སོགས་མཛད།",
    "བདེ་མཆོག་ནས་ཨ་ལྕེ་དྲུང་མཆེད་བྱོན་ན་གསུང་བར་རྗེ་ཉིད་ཀྱིས་སྟོན་ཀ་ཙམ་བྱོན་པས་འཐུས་གསུངས་པ་ཡིན་ཚུལ་མཛད་པས།",
    "སྟོན་སྒུག་ལོང་མི་ཡོང་ལགས་གསུངས་པ་དང་།",
    "བསྟན་དོན་ལར་རྒྱ་ཚང་མར་ཐུགས་བསྐྱེད་ཟབ་སྒྲོན་ཞུ་དགོས་ལའང་རིམ་བཞིན་གསན་བཞེས་ཐུགས་རྗེ་ཆེ་དགོས་ཞེས་དངོས་པོའི་འབུལ་ཆ་དང་བཅས་མཛད་པས།",
    "ཁྱད་པར་ནུ་བོ་དེ་བདག་རང་ལ་འཁྲི་ཞིང་གདན་ས་འཛིན་པར་མེད་ཀ་མེད་རང་ཡིན་ཀྱང་།",
    "འཇམ་མགོན་དེས་སྤུར་དྲུང་ཐུགས་དམ་གསལ་འདེབས་སོགས་དང་དུས་མཐའི་ཞལ་བཀོད་ཚང་མ་གནང་བ་དང་ཆབས་གཅིག་རྗེ་རྡོ་རྗེ་འཆང་ནས་ཀྱང་ཐུགས་དམ་གྱི་རྩིས་གང་ཟིན་མཛད་དེ་ཚེས་ལྔ་ནས་བཟུང་ཀྱེ་རྡོར་སྒྲུབ་མཆོད་ལ་ཐུགས་གཞོལ་བའི་སྐབས་དང་།",
    "ཨེ་མ་འདུས་བྱས་ཐམས་ཅད་ནི་མི་རྟག་པ་ཞེས་གསུངས་པའི་སྣང་ཚུལ་ནི་འདི་འདྲ་དགོངས་པའི་ངང་དུ་དར་ཙམ་ཞིག་འབྱམས།",
    "དབུས་ལྷོ་བྱང་ལ་དགོངས་རྫོགས་སྒྲུབ་མི་ཆེད་མངགས་ཀྱིས་ལྷ་སར་ཇོ་ཞལ་རྣམ་གཉིས།",
    "པཎ་ཆེན་ཐམས་ཅད་མཁྱེན་དྲུང་ལྗགས་བསྔོ་རྟེན་དངུལ་སྲང་ལྔ་བཅུ།",
    "ཁྲུམས་ཟླའི་འགོར་གདུང་ཚ་རྣམས་གྲུབ་པས་རྗེ་ཉིད་ལྷ་ཁང་རྩེའི་སྨོན་གནས་ཡིད་འོང་ཚལ་དུ་བཞུགས་འཇགས་ཀྱིས་ཕྱག་ནས་གྲངས་གསོག་དང་སྦྲགས་སྐུ་གཤེགས་ཀྱི་ཞལ་ཆེམས་བཞིན་དྲི་མེད་རྣམ་གཉིས་མི་འཁྲུགས་ལྷ་དགུ་རྣམས་རྡུལ་དཀྱིལ་ཐོག་ནས་ཅི་རིགས་དང་།",
    "འདི་ལོ་མཐོང་བ་དོན་ཡོད་ཉམས་གསོ་གསར་བསྐྲུན་ལྟ་བུའི་གཙུག་ལག་ཁང་སྟེང་མ་གསར་བཞེངས་ཀྱིས་ཕེབས་འགྲུལ་སྐབས་ཕྱག་འབྱོར་གྱི་སྐུ་རྟེན་རྣམས་བཞུགས་སུ་གསོལ།",
    "སྒྲོལ་མ་ཉེར་གཅིག་སོགས་རྗེས་གནང་ཁ་ཤས།",
    "ཁ་བ་རི་པའི་ལེགས་བྱས་གསོག་པའི་རྟེན།",
    "འགྲིབ་པའི་ཚུལ་གསུངས་རྫུན་བྲལ་ཐ་ཚིག་ལ།",
    "སྲིད་གསུམ་ཆེ་དགུའི་གཏམ་གྱིས་བསུས་པར་ངེས།",
    "རྗེ་རྡོ་རྗེ་འཆང་ཉིད་ནས་སྐུ་པར་སྟོང་དུ་ཉེ་བ།",
    "དེ་དང་ཆབས་གཅིག་རྣམ་རྒྱལ་གྱི་སྐུ་གཟུངས་འབུམ་ཐེར་བཞུགས་པའི་རྣམ་རྒྱལ་མཆོད་རྟེན་བཞི་བཞེང་དགོས་ཚུལ་བཞིན་ངོ་མཚར་རྟེན་བཞིའི་གྲས་རྣམ་རྒྱལ་སྐུ་འབུམ་གྱི་བྱང་ངོས་སུ་མཆོད་རྟེན་འདི་བཞི་བཞེངས་གནང་དང་།",
    "སྒོ་རུམ་དུ་གསུང་བསྐང་དང་སྦྲགས་གསང་རྒྱའང་གྲོལ་ཞིང་ཕུན་ཚོགས་གླིང་དུ་ཕེབས།",
    "རྒྱུད་སམ་པུ་ཊི་དང་དཔའ་བོ་གྲུབ་པ་ནས་གསུངས་པའི་ས་གཡོས་ཐོག་བསྲུང་གནོད་སྦྱིན་འཁོར་ལོ་སོགས་ནན་ཏན་སྒྲུབ་གནང་རྣམས་ས་སྟེགས་ཀྱི་དབུས་དང་ཕྱོགས་མཚམས་རྣམས་སུ་བཀོད་བཞིན་བཞུགས་པ་དང་།",
    "གོས་ཡོལ་བླ་བྲེ་མཆོད་ཚོགས་བཅས་ཆོ་གའི་སྒོ་ནས་བཞུགས་མཐར།",
    "ཡང་བར་ཐོག་སྟེང་རྒྱུ་གོང་འདྲའི་འོད་ཟེར་དྲི་མེད་ཀྱི་བློས་བླང་སྤྱི་དང་ཁྱད་པར་གྱི་མཆོད་རྫས་འགད་གཙང་བཅས།",
    "ཁྱད་པར་གཙུག་ཏོར་རྣམ་རྒྱལ།",
    "མཁྱེན་བརྩེའི་སྤུར་རུས།",
    "མཁྱེན་བརྩེ།",
    "མཁྱེན་བརྩེ།",
    "གདུགས་དཀར་སྐུ་གཟུངས་འཁོར་ལོ་རྣམས་བཞུགས་པར་རྗེ་ཉིད་ནས་རྒྱལ་མཚན་འཛུགས་ཆོག་དང་རབ་གནས་བསྡུས་པ་དུུ་མ།",
    "མགོ་ཟླ་ནས་རྗེ་རྡོ་རྗེ་འཛིན་ཉིད་ཀྱིས་གཤེད་དམར་སྒྲུབ་མཆོད་བརྒྱ་ཚར་གྱི་དབུ་ཚུགས་པར་མཛད་དོ།",
    "ས་འཇིམ་གཙང་མར་རྫས་ཉེར་ལྔའི་ཐོག་དྲངས་བཟང་ཞིང་གྱ་ནོམ་པ་དུ་མ་དང་།",
    "ཞེས་གསུངས།",
    "དུས་མཆོད་དགའ་ལྡན་སྨུག་ཆུང་རྣམས་ཀྱི་ནང་དང་བསམ་བརླིང་མགོན་ཁང་སྟེང་བཅས་སུ་སོ་སོའི་ཐུག་ཆོག་གསར་བསྒྲིགས་ལྟར་འཛུགས་པར་མཛད་པ་དང་།",
    "ཡང་སྤྱན་ལྟས་ཤིག་ལ་རྟག་འཚེར་གངས་མཆོད་དགོས་ཚུལ་འཁྲུངས་པར་ཡང་དེ་བཞིན་གསར་བསྒྲིགས་ཐོག་མཛད།",
    "ཆུ་སྟོད་ཟླ་ནང་གསང་ཁོག་ནས་གདན་སར་ཕེབས་པར་བཅོམ་ལྡན་འདས་དཔལ་གསང་བ་འདུས་པ་མི་བསྐྱོད་རྡོ་རྗེའི་རྡུལ་དཀྱིལ་དུ་སྨིན་པར་མཛད་དེ་རྗེས་སུ་གནང་བ་དུ་མ་དང་།",
    "གཉན་ཕུལ་བྱུང་བ་གཙུག་ཏོར་རྒྱལ་པོས་གཞོང་པར་མཛད་པའི་ས་འཇམ་ཞལ་སྤྲོད།",
    "འགོ་བཟོ་བར་གནང་ཆ།",
    "སྐུ་གཤེགས་ཀྱི་རྒྱུན་བཞེས་འདྲེན་ཆས།",
    "བྱས་ཤེས་དྲིན་གཟོའི་ངོ་མཚར་ཕྱག་རྗེས་ནི།",
    "འཇམ་དཔལ་ཕུག་པའི་འགྲམ་པར་རྒྱུ་བ་བྱེད།",
    "དྲི་གཙང་ཁང་རྣམས་ངོགས་སུ་བྱི་དོར་མཛད།",
    "ཇེ་ལོད་ཀྱིས་མར་ལམ་སྐྱེད་ལྷས་མགོན་ཁང་ལའང་ཕེབས་མ་བདེ།",
    "དགུང་ཞག་ནམ་རྫོགས་པར་མཁའ་སྤྱོད་མའི་སིན་དཀྱིལ་སྒྲུབ་མཆོད་ཆག་མེད་ཀྱི་སྔགས་སྡོམ་ཨོཾ་གསུམ་མ་ཉི་ཁྲི་དགུ་སྟོང་བཞི་བརྒྱ་ཐམ་པ།",
    "སྲིད་པ་ཀུན་ཏུ་ལེགས་པར་སྦྱངས་པས་ན།",
    "དེ་ནས་རྡོ་བྲག་རིག་འཛིན་ཆེན་པོས་ལུང་བསྟན་གདུང་རབས་མྱུར་འབྱོན་སྐུ་རིམ་དུ་གྲ་ལྔ་དང་དམར་པོ་སྐོར་གསུམ་གྱི་སྐུ་པར་གྲངས་མང་དང་།",
    "དེ་རྗེས་རྡོ་རྗེ་ཕུར་པའི་རས་དཀྱིལ་སྒྲུབ་མཆོད་ཀྱང་མཛད་པས་བྱིན་ཆགས་ཤིང་ཐུགས་བག་ཕེགས་པ་བྱུང་གསུངས།",
    "གཞན་ཚར་འགའ་ཞིག་བཅས་དམ་ཡེ་དབྱེར་མེད་དུ་བྱིན་གྱིས་རློབ་པར་མཛད་དོ།",
    "ཡང་དག་གྲུབ་པའི་བྱིན་ཆགས་བག་ཕེབས་འཁྲུངས།",
    "འདན་ཀློང་ཐང་སྒྲོལ་མའང་སྐུ་ཆུང་ངུ་ཞིག་ལས་མེད་སྐད་བཅས་ཚང་མར་མཆོད་འབུལ་རྒྱ་ཆེ་ནས་སྣེ་འགྲེལ་པར་ཅི་སྨིན་མཛད།",
    "དམར་ཆུང་སྐོར་གསུམ་རྣམས་གནང་སྐབས་ཤིག་སྤྱན་ལྟས་སུ།",
    "ཕྱི་ལྟར་ན་སླར་འབྱུང་ས་ཁྱི་ལོ་རྗེ་ཉིད་ནས་རིགས་སྲས་དམ་པ་ཉི་ཟླ་ཟུང་ལ་རྣམ་སྲས་རིགས་ཆེན་བཅོ་ལྔའི་རྗེས་གནང་སྩལ་སྐབས་མཛོད་འཛིན་ཀུན་དགའ་ཕུན་ཚོགས་ཀྱི་ཐུགས་རྒྱུད་བསྐུལ་བ་ལྟར་དངུལ་བྲེ་ཆེན་བརྒྱ་རྩ་སོགས་རྗེ་བཙུན་ས་སྐྱ་པའི་འཐས་སུ་གན་མཛོད་འདིར་འཇོག་པར་མཛད་པ་དང་།",
    "ཞབས་འབམ་སོགས་སྒོ་དུ་མ་ནས་ཕེབས་མ་བདེ་བས་མཛོད་འཛིན་པ་ཤེས་རབ་ཕུན་ཚོགས་ལ་བཀའ་འདོམས་བཞིན་ཕེབས།",
    "ཞེས་གསུངས་པའི་དོན་ལགས།",
    "ཕར་ལེགས་སོ་གནང་རྒྱུ་ཚེས་བཅུ་བཞིར་མཛད་རྒྱུར་དེ་སྔོན་མ་བསྒྲིགས་ཀྱང་།",
    "ཁྲུམས་ཟླའི་བཅུ་བཞི་ནས་བཟུང་གཏའ་གཏོར་ཟུར་བརྒྱད་པ་འཛུགས་གནང་དང་ཆབས་གཅིག་ཕྲིན་འཆོལ་ཞག་གསུམ་མ་མཛད་དེ་རྒྱལ་ཟླའི་བཅུ་བཞིའི་བར་དུས་གཏོར་ཆག་མེད་བཟུང་ནས་གཏོར་མ་སྤོ་བར་མཛད་དེ་ཆུ་ལུག་རྟ་ཟླ་ནས་ཆུ་སྟོད་ཀྱི་བར་ལ་གཏོར་འཛུགས་མཛད་པའི་དམ་བཅའ་གནང་ཞིང་།",
    "དེ་ཁོངས་སུ་གདུང་བརྒྱུད་ངེས་པར་འབྱོན་པ་དང་།",
    "མྱུར་བཞེས་ཐབས་བརྒྱའི་འཕྲུལ་མཁན་ཁ་ལོ་པ།",
    "རྗེ་ཉིད་ཀྱི་རྒྱུན་བཞེས་ཞལ་དཀར་འབྲས་སིལ་གྱིས་གང་བ་སོགས་སྩལ་ནང་སྦྱར་བཀའ་མཆིད་ཚང་མ་སྙན་དུ་ལྷོན་ངེས་དང་།",
    "དེ་ཉིན་མང་སྦྱིན་གྲས་སུ་དམ་སེལ་ཅན་གྱི་མི་རྒན་ཞིག་རྒྱབ་ཁུར་འཁྱེར་བཞིན་དུ་མཇལ་ཕྱག་ལ་བྱུང་བས་དེས་རྐྱེན་བྱས་སམ་དགོངས་པའི་ཐུགས་དོགས་བཅས།",
    "དེ་དུས་ཡུམ་ཡང་སྙུན་གཞི་ལས་གྲོལ་བས་ཡབ་ཡུམ་ཞལ་རྒྱས་ཏེ་དམར་པོ་སྐོར་གསུམ་གྱི་སྐུ་པར་འདེབས་གནང་དང་།",
    "རྗེ་རྡོ་རྗེ་འཛིན་ཉིད་ཐུགས་ལྷག་པར་སྤྲོ་བའི་ངང་ནས་རྒྱལ་ཚིང་སོགས་དེ་སྐབས་ཀྱི་ཞབས་ཕྱི་རྣམས་ལ་སྲུང་འཁོར།",
    "སྲིད་པ་ཧོའི་ཙཀླི་བཅས་འདོགས་པར་མཛད་པ་དང་།",
    "ན་བཟའི་ཁྲོད་ནས་དབུ་ཞྭ་གང་ཐེབས་ཤིག་བསྣམས་པས་ཁ་གསར་སྤུས་ལེགས་ཤིག་ཕྱག་ཏུ་སོན་པ་དེ་བཞེས།",
    "དེ་ནུབ་རྗེ་རྡོ་རྗེ་འཛིན་ཉིད་ཧ་ཅང་ཐུགས་སྤྲོ་ཆེས་པས་འོད་གསལ་ཡེར་བ་ལྟ་བུ་ཞིག་འཁྲུངས་ཀྱང་སང་ཉིན་སྐུ་གཟུགས་རྒྱུན་ལས་ཀྱང་བདེ་ཞིང་ཐུགས་གསལ་ལ་ཞལ་བཀོད་རྣམས་འཁྲུངས་བདེ་བ་སོགས་གྲུབ་མཚན་མངོན་སུམ་དུ་སྟོན་པར་མཛད་ནས་ནམ་ལངས་མ་ཐག་གཟིམ་ཆུང་རྩེར་ལྷ་བསངས་དང་།",
    "ཡུམ་མཆོག་ལའང་བྱས་ཤེས་དྲིན་གཟོ་དམ་པའི་རང་བཞིན་ཅན་གྱི་གནང་ཆ་དང་།",
    "རྒྱུན་རིང་བར་ཉིན་ལྟར་སྐུའི་རྐྱེན་སེལ་མཐའ་ཡས་པ་ཞིག་མཛད་པར་གྲགས།",
    "སྒོས་སུ་ཆུང་ངུ་དེས་རྣམ་དཔྱོད་དོད་པོ་དེ་འདྲ་མཛད་པས་ལྷག་པར་བརྩེ་སྐྱོང་བཅས་དེ་སྐབས་ཀྱི་གྲོ་མགྲོན་མཚན་བྱང་རྣམས་རྟེན་སྒམ་དུ་གཞུག་པར་མཛད།",
    "མདུད་པ་སོགས་ཀྱིས་སྡུན་བསུས་སྒོ་རུམ་རྩེར་བཞུགས་ཁྲི་འདྲེན་ཆས།",
    "བཞུགས་ཁྲི་པདྨ་ཅན་གྱི་སྟེང་ནས་ལེགས་སྐྱེས་རྣམས་ཐུགས་སྤྲོ་བའི་ཤོགས་རགས་དང་བཅས་བཞེས་པས་སྐྱ་སེར་ཀུན་ཤེས་པ་འུར་ཞིང་སིང་ཁྲོག་ཁྲོག་འཛུམ་ཉམས་ཅན་རྐྱང་པ་རིམ་བཞིན་བྱུང་།",
    "ཞེས་གསུངས།",
    "དེ་ལོ་ཐམས་ཅད་ལ་དགའ་ཉམས་ཀྱིས་རྟ་ཞོན་ནས་བྲེལ་པོར་འགྲོ་བ་ལ་དཔེ་མེད་མཉེས་འགྲོ་བ་ཞིག་ཡོད་གསུངས།",
    "བཞུགས་རིང་བསངས།",
