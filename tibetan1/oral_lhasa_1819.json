    "ཞེས་ཐུགས་འུར་ཉམས་དང་བཅས་གསུངས།",
    "ཞལ་གྱི་མངའ་གསོལ་རྣམས་ཀྱི་ལྗགས་ལུང་འབུལ་གནང་དང་།",
    "འདི་ལ་ལྷ་མི་གཉིས་ཀས་བསྐང་བཤགས་བྱ།",
    "འཇམ་མགོན་གནས་གསར་བ་ཆེན་པོ་ནས་ལྷ་མི་ལ་བསྐང་བཤགས་ཇི་ལྟར་བྱེད་ཅེས་ཉམས་ལྡན་གྱི་གསུང་བཅས་བཞད།",
    "དེ་ནས་གཙང་ཆུང་གླིང་ཁ་དང་རྣམ་སྲས་གླིང་།",
    "འཇམ་དབྱངས་དམར་སེར་གྱི་རྗེས་གནང་དང་གོང་མ་ལྔ་བསྟོད་ཀྱི་ལྗགས་ལུང་།",
    "རྣམ་འཇོམས་རྣམས་ཀྱི་རྗེས་གནང་དང་ཀུན་རིག་བསྙེན་ཐབས་སྦྱིན་སྲེག་བཅས་ཀྱི་ལྗགས་ལུང་།",
    "ཟུར་ཁང་པར་ལྕགས་སྡོང་མ་དང་རྣམ་སྲས་སེར་ཆེན་གྱི་རྗེས་གནང་།",
    "ཚེ་དཔག་མེད་དཀར་པོ་རྣམས་ཀྱི་རྗེས་གནང་དང་།",
