    "ཁ་འུའམ་ཁའུབ་ཅེས་ཀྱང་གླེང་བའི་མེ་འབར་གྱི་བྲག་ལ་དངོས་སུ་ཐིམ་པའི་ཙ་ཏུ་རྨུ་ཁ་བསྙེན་དུས་ཀྱི་རྗེས་གནང་།",
    "ཁྱད་འཕགས་མགོན་ཁང་དུ་ལྷ་བརྒྱད་ཀྱི་རྗེས་གནང་།",
    "ཉེར་གསུམ་ཉིན་ཕུར་བསྙེན་ལ་བཞུགས་གདན་འཇགས་རྒྱུའི་སྔ་དྲོ་དཀར་བདུད་ཀྱི་རྗེས་གནང་ཞིག་སྩལ་ཏེ་ལྷ་མཆོག་རྡོ་རྗེ་གཞོན་ནུའི་བསྙེན་མཚམས་ལ་ཐུགས་གཞོལ་བའི་ཚེ་དཀར་བདུད་ཕུར་སྲུང་རྣམས་དགྱེས་པའི་རྣམ་འགྱུར་དུ་མ་དང་བཅས་ཞལ་ཡང་ཡང་བསྟན་པའི་རྐྱེན་གྱིས་བསྟོད་པ་རྒྱས་པ་འདིའང་དེ་དུས་མཛད་ཅིང་།",
    "ཟླ་མཇུག་ནས་ཆུ་སྟོད་ཚེས་འགོ་བར་ཡང་བསྐྱར་གཞིས་རྩེར་ཆིབས་ཁ་བསྒྱུར་ཐང་གཉིས་པའི་སྐབས་བཀྲ་ཤིས་བདེ་ལེགས་སུ་བཞུགས་སྒར་གྱི་ཚེའང་སྒོ་དུ་མ་ནས་འཇིགས་ཤིང་ཉམ་ང་བ་ཞིག་མཆིས་ནའང་།",
    "ཁྲོ་བཅུ་རྣམས་ཀྱི་རྗེས་གནང་དང་ལུང་འགའ་ཞིག་བཅས་ལེགས་པར་སྩལ་ནས།",
    "མངོན་གྱུར་སར་ཆགས་བི་རཱུའི་གདམས་ངག་གནང་།",
    "སྟན་གཅིག་ལྷ་སྔགས་རོལ་པའི་བདེ་སྟོང་དང་།",
    "ཞེས་ཀྱང་སྨྲས་སོ། དགུང་གྲངས་ཉེར་གསུམ་པ་ལྕགས་ལུག་སྣྲོན་ཟླའི་ནང་ཀྱེ་རྡོ་རྗེའི་ལྗགས་བསྙེན་གྲོལ་ལ་ཁད་རིགས་བདག་ཐར་རྩེ་བ་ཉིད་ཕེབས་པས།",
    "ཆུ་སྟོད་ཟླ་ནང་འཇམ་མགོན་གཅུང་དམ་པར་གསང་འདུས་མི་བསྐྱོད་པ་དང་།",
    "ཁྲོ་བཅུ་རྣམས་ཀྱི་རྗེས་གནང་ལུང་བཅས་དང་།",
    "བྲན་བདུད་རྗེས་གནང་བཅས་དང་།",
    "སྨད་ལས་དྲག་པོ་སྒྲོལ་བའི་རྗེས་སུ་གནང་བ།",
    "དཀྱིལ་ཆོག་རྟོགས་པར་སླ་བ་རྣམས་དང་།",
    "དཀར་བདུད་ལྕམ་དྲལ་གྱི་རྗེས་གནང་ལུང་བཅས།",
    "དུར་བདག་རྗེས་གནང་རྣམས་དང་།",
    "ཁྲོ་བཅུའི་རྗེས་གནང་སོགས་མང་དུ་སྩལ་བ་དང་།",
    "བྲན་འདུད་ཀྱི་རྗེས་གནང་རྣམས་དང་།",
    "རྗེས་གནང་ལྗགས་ལུང་རྣམས་ནི་བགྲང་བ་ལས་འདས་པ་ཞིག་བཀའ་དྲིན་ཆེབ་གོང་ལོ་ཁམས་སོ་སོར་འཁོད་པ་ལྟར་དང་།",
    "གདུལ་བྱ་རྣམས་ལ་དོན་འདི་དག་འདོམས་པར་མཛད་པ་སྟེ།",
    "ཚེ་འདིའི་ཕུན་ཚོགས་སྒྲུབ་ལ་མ་ཆགས་པར།",
    "ཞེས་སོགས་ཀྱི་དོན་བཞིན་ལེགས་པར་གདམས་ཏེ་བསྟན་མཁས་ཀྱི་བགྱི་བ་ལ་དུས་རྟག་ཏུ་གཞོལ་བའི་བདག་ཉིད་ཆེན་པོར་ལྷུན་གྱིས་གྲུབ་བོ།",
    "ཅེས་ཀྱང་སྨྲས་སོ། དགུང་གྲངས་ཉེར་བཞི་པ་ཆུ་སྤྲེའུ་གསར་ཕྲལ་བཞུགས་ཐབ་ལྷོར་སྦོ་གནང་དང་།",
    "ས་གར་ཐར་རྩེ་རྗེའི་སྐུ་རིམ་དུ་དྲུག་ཅུ་པ་ཞིག་གནང་སྐབས།",
    "ཞལ་བསྙེན་དུས་ཀྱི་རྗེས་གནང་རྣམས་ལེགས་པར་སྩལ།",
    "དེ་མཚམས་ནས་འཕགས་ཆེན་བློ་གྲོས་རྒྱལ་མཚན་སོགས་གོང་མ་མང་པོའི་བཞུགས་གནས་ཚོམས་དམར་སྟེང་འོག།",
    "དེ་ནས་རྡོ་རྗེ་ཕུར་པའི་སྒོ་ནས་རྒྱས་པར་སྩལ་གོང་དུ་རྗེ་བཙུན་དྲུང་སྐུ་ཁམས་ཉོག་མུ་ཡིན་གཤིས་སྐུ་མདུན་དུ་ཡང་ཡང་ཕེབས་ཏེ་གང་ཅི་ཞུ་འོས་རྣམས་དང་སླད་ཀྱི་འཆར་གཞི་ཚང་མ་ཞིབ་གླེང་མཛད།",
    "མགོན་ཁང་དེ་སྔར་ལས་རྒྱ་ཆེ་ཞིང་བླ་བྲེ་ཡོལ་བ་སོགས་བཀོད་པ་ཕུན་སུམ་ཚོགས་པས་བརྒྱན་པའི་ནང་ཁའུ་པའི་སྐུ་འདི་ན་བཟའ་དར་ཚོན་གཟབས་མ་བཅས་བཞུགས་ཁྱིམ་ནས་ཕྱིར་ཅུང་ཟད་འཐོན་པའི་ཞལ་འཛུམ་གསུང་འབྱོན་ལ་ཁད་ཡོད་པའི་དྲུང་།",
    "སྣྲོན་ཟླའི་ཚེས་ལྔ་ནས་འབུམ་ཐང་གཙུག་ལག་ཁང་རྟེན་བརྟེན་པར་བཅས་ཉམས་གསོས་འབུམ་དངུལ་གདུང་དུ་བསྐྲུན་པ་རིང་བསྲེལ་རྣམ་བཞིས་ཕྱུར་པོར་བཀང་སྟེ་ས་རྒྱན་གནམ་རྒྱན་མཆོད་སྤྱད་གདན་རབས་སོགས་ངོ་མཚར་གྱི་བཀོད་འདོམས་བླ་ན་མེད་པའི་འགོ་ཚུགས་པར་མཛད།",
    "སྟོན་འགོར་ཐར་རྩེ་རྡོ་རྗེ་འཆང་ངོར་དུ་ཕེབས་གོང་གསུང་ལས།",
    "རྗེ་རྡོ་རྗེ་འཆང་དེ་ཉིད་མཁྱེན་རབ་ལ་ས་སྐྱ་པཎ་ཆེན་དང་།",
    "དབྱུག་ཟླའི་ནང་ཐུབ་བསྟན་གྲྭ་རྒྱུན་པ་འགའ་ཞིག་ལ་འཇམ་དབྱངས་དམར་སེར་རྗེས་གནང་དང་གདུང་རབས་ཡ་རབས་ཁ་རྒྱན་གྱི་ལུང་།",
    "ཛམ་དམར་སྲོག་སྒྲུབ་སྟེ་བཅུ་གསུམ་དུ་གྲགས་པའི་རྗེས་གནང་ལུང་བཅས།",
    "དགའ་མགུའི་རྣམ་འགྱུར་བརྒྱ་ཕྲག་གཡོ་བའི་དཔལ་ལ་འགོད་པར་མཛད།",
    "བསེ་བྱ་བཞི་བསྐོར་བཅས་ཀྱི་རྗེས་གནང་དང་།",
    "སྒྲུབ་ཐབས་རྒྱ་མཚོར་གྲགས་པའི་རྗེས་གནང་ཚང་མ།",
    "རྡོ་རྗེ་རབ་བརྟན་མའི་རྗེས་གནང་རྣམས་དང་།",
    "ཀུན་མཁྱེན་གྱིས་མཛད་པའི་མངལ་སྒོང་གཉིས་ཀྱི་སྒྲུབ་ཐབས།",
    "རིན་ཆེན་བདུན་གྱིས་ཡོངས་སུ་བཀང་བྱས་ནས།",
    "སེང་གེས་ཞུས་པར།",
    "ཞེས་གསུངས་པ་སོགས་བསྟན་ལ་བྱི་དོར་གཙང་མའི་ཆོ་གས་དུས་འདའ་བ་ལས་གཞན་པའི་རང་དོན་ཉི་ཚེའི་བསམ་སྦྱོར་ནི་རྗེ་དམ་པ་དེ་ཉིད་ལ་རྨི་ལམ་ཙམ་དུའང་མི་མངའ་ཞིང་།",
    "ཁམས་པ་གྲྭ་རྒྱུན་བསྙེན་མཚམས་པ་བདུན་ཙམ་ལ་ལྷ་བརྒྱད་རྗེས་གནང་།",
    "སྐབས་འགའ་གཞི་ཐོག་ཏུ་ཕེབས་ཏེ་རྒྱལ་ཡུམ་དམ་པའི་རྐྱེན་སེལ་ལ་རྗེ་རྡོ་རྗེ་འཆང་སྐུ་མཆེད་ནས་ཐུགས་གཞོལ་བའི་སྐབས་ཤིག།",
    "དོ་ནུབ་གཞི་ཐོག་ཏུ་བཞུགས་ལ་སང་ཉིན་ཚོགས་དུང་བྱུང་བསྟུན་བྱོན་ཅིག་གསུངས་པ་བཞིན་མཛད་ནས་སང་ཉིན་ཕེབས་ཁར་ཡུམ་གྱི་སྐུ་དྲུང་དུ་བྱོན་གསུངས་པ་ལྟར་བྱོན་པས་ཡུམ་གྱི་གསུང་ལས།",
    "འོན་ཀྱང་བསྟན་འགྲོའི་མཛད་པར་ཐུགས་བརྩོན་ཆེ་གཤིས་སྐུ་འཁྲུགས་མ་བྱུང་བར་མཛོད།",
    "གཅུང་པོ་འདི་ཐུགས་སེམས་ཆུང་ལ་སྐུ་གཅོང་ཆེ་ཞིང་ཞབས་འདེབས་མ་ཐུགས་གྱོང་བ་སོགས་འོ་བརྒྱལ་རང་བྱུང་དོགས་དང་སྐུ་ཚེའང་ཧ་ཅང་རིང་བ་ཞིག་མ་བྱུང་དོགས་པས་ནམ་བཞུགས་བར་སྐུ་མཆེད་ད་ལྟ་བཞིན་ཐུགས་མཐུན་པ་དང་དབུ་འདོན་ཡང་དག་མཛོད།",
    "ད་དུང་སྐུ་རིམ་འཕྲོད་པ་ཞེས་སོགས་ཡང་དག་ཞུ་བས་ཡར་བསྐྱེད་བཞེས་ཐུབ་ཙམ་ཨེ་ཡོང་།",
    "ནག་ཟླའི་ནང་དཔོན་ལྷ་རྒྱལ་དཔོན་གཡོག་དང་འདམ་བླ་བསྟན་ཡར་སོགས་མང་པོར་སྒྲོལ་དཀར་ལུགས་གཉིས་དང་དྲག་དམར་གྱི་རྗེས་གནང་།",
    "དབོན་པོ་རྐྱང་པར་མགོན་པོ་ལྷ་བཅུ་གཉིས་མའི་རྗེས་གནང་ལུང་བཅས་རྣམས་སྩོལ་བར་མཛད།",
    "རྒྱ་གར་ཤར་ཕྱོགས་ཟ་ཧོར་གྱི་རྒྱལ་ཁམས་དེ་དཔལ་ལྡན་ས་སྐྱ་ནས་བརྩིས་པའི་ལྷོ་ནུབ་ན་ཡོད་པར་ནམ་མཁའ་འཇའ་ཚོན་གྱིས་གང་བ་དང་།",
    "ཚོགས་བདག་ཆགས་པ་རྡོ་རྗེ་སོགས་རྗེས་གནང་དང་།",
    "བཀའ་གདམས་ལྷ་བཞི་རྣམས་ཀྱི་རྗེས་གནང་ལུང་བཅས་དང་།",
    "ཚེ་རབས་དྲན་པ་ཐོབ་པར་འགྱུར།",
    "ཞེས་སོགས་མང་དུ་གསུངས་པའི་དོན་ཡང་ཐུགས་ལ་འདོགས་པར་མཛད་དོ།",
    "བྱམས་ཆེན་དུ་འབྱུང་འདུལ་གྱི་རྗེས་གནང་དང་ངུར་སྨྲིག།",
    "ཕན་ལ་རྩ་དང་ཤགས་སྨད།",
    "མདའ་དཔོན་འབུམ་ཐང་པ་སྐུ་ངོ་ལྔ་ར་ཚེ་རིང་མའི་རྗེས་གནང་།",
    "གུང་པཎྜི་ཏ་སྐུ་འཁོར་ཚང་མར་སྣ་ཚོགས་ཡུམ་གྱི་རྗེས་གནང་དང་འཆི་མེད་འདོད་འཇོ།",
    "ཀརྨ་དང་བུ་ལགས་ཀྱིས་ཐོགས་དྲངས་སྦྲ་ཞོལ་བ་ཕལ་ཆེར་ལ་གྲུབ་རྒྱལ་མ།",
    "ཁལ་ཁ་ཐོན་དར་གྱི་མི་སྣ་བཅས་ལ་ལྷ་བརྒྱད་རྗེས་གནང་།",
    "ཛ་སག་ལ་གོས་སྔོན་ཅན་རྗེས་གནང་།",
    "ཁལ་ཁ་མ་གཏོགས་གོང་གསལ་ལ་ཞལ་དང་པུ་ཏྲའི་རྗེས་གནང་།",
    "འཕན་ཡུལ་སྨྱུང་གནས་པ་རྣམས་ལ་བཅུ་གཅིག་ཞལ་གྱི་རྗེས་གནང་དང་སྨྱུང་གནས་ལུང་།",
