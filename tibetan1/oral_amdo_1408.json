    "ཛྙ་ཏི་སྤོས་དཀར་ཚ་ལ་མགྲོན་ཐལ་དང་།",
    "ཤ་རུའི་ཐལ་བ་བསྣན་པས་གྲང་སྐྲན་རིགས།",
    "གབ་པ་མངོན་ཕྱུང་ཆིག་བརྒྱུད་གསང་གཏམ་མོ།",
    "རིན་ཆེན་དཀར་དམར་ནག་གསུམ་ཐལ་བ་དང་།",
    "ཞིབ་བཏགས་བ་ཆུས་སྦྲུས་སྐམ་ནུས་བསྲེགས་ཐལ།",
    "དུང་ཤིང་པུཥྤ་སྲིན་སྒྲོ་ནུས་བསྲེགས་ཐལ།",
    "ལྕམ་མོ་ཤེལ་ཏང་ནག་པོ་གནོད་སྦྱིན་མིག།",
    "སྒ་སྐྱ་གོ་སྙོད་རེ་ལྕག་ཐལ་བ་དང་།",
    "གླང་ཆེན་གི་ཝང་བསྣན་པ་མཆོག་ཏུ་ཟབ།",
    "སྨུག་ཆུང་ཟིལ་བ་སྔོན་མོ་ཆབ་འདྲེན་དང་།",
    "སྤྱི་རྟགས་ཚ་རེག་མི་བཟོད་མེ་དྲོད་ཞན།",
    "འགྲམས་འཁྲུགས་རིམས་དང་དུག་གི་ཚ་བའོ།",
    "ཕྱི་ནང་བར་གསུམ་གནས་དང་གསར་རྙིང་གིས།་།",
    "ག་བུར་ནག་པོ་སྒོག་ཐལ་སྦྱར་པ་ཡིས།",
    "སྣོད་ལ་བབས་ན་ཏིགྷ་དུག་མོ་ཉུང་།",
    "འོམ་བུ་སྟག་ཚེར་སླེ་ཏྲེས་རེ་རལ་རྣམས།",
    "ཕྱེ་མ་གུར་ཀུམ་ཅུ་གང་གི་ཝང་དང་།",
    "གུར་ཀུམ་གི་ལྦང་བྲག་ཞུན་གུ་གུལ་ནག།",
    "གུ་གུལ་སྒོག་སྐྱའི་ཐལཀ་རི་སྦྱར་པས་སྟོངས་ཚད་འཇོམས།",
    "ཀུ་ཡ་ལིང་གིས་འདྲིལ་ཞིང་ལུས་སེམས་ལྕི།",
    "གི་ཝང་ཨུཏྤལ་སུམ་ཏིག་ཨ་ག་རུ།",
    "ཁ་འབྱར་རྐན་ཕུག་གྱོང་ལ་གྲང་མོ་འདོད།",
    "གུར་ཀུམ་ཚར་འབྲུམ་གི་ཝང་ཏིག་ཏ་དང་།",
    "གི་ཝང་ཙན་དན་གཉིས་དང་བ་ལེ་ཀ།",
    "གཉན་ཤས་ཆེ་ན་ཟླ་བའི་ཐལ་བ་བསྣན།",
    "བཙོད་དང་ཀཎྜ་ཀ་རིའི་བསྐོལ་གྲང་གི།",
    "བཙོད་ཚོས་འབྲི་མོག་གི་ཝང་སྐྱུ་རུ་ར།",
    "ཅུ་གང་ཤིང་མངར་སྟག་ཚེར་མཛོ་མོ་ཤིང་།",
    "མ་མོའི་འཁྲུགས་ལྟས་ཁྲག་གི་རིམས་ཡམས་མཆེད།",
    "རུལ་བཅུག་པུ་ཤུད་ཏེ་ལོ་སྲེ་མོང་ཤ།",
    "རེ་ལྕག་དྲི་ཆེན་ཁྱི་ཕག་སྤྱང་བྲུན་གསུམ།",
    "མ་ནུ་རྒོད་སྤོས་སྒོག་སྐྱ་ཕུར་མོང་ནག།",
    "སྟོང་བའི་ངང་ལས་རང་ཉིད་སྐད་ཅིག་གིས།",
    "ཉིན་རེར་བརྒྱ་རྩ་ཙམ་རེ་མ་ཆག་བཟླ།",
    "༡ཨོཾ་བུདྡྷ་ཁཱོ་ག་རུ་ཊ་ཙ་ལེ་ཙ་ལེ་ཧཱུཾ་ཕཊ",
    "ག་བུར་ནག་པོ་ཅུ་གུར་གི་ཝང་དང་།",
    "དན་རོག་རེ་ལྕག་གླ་རྩི་བ་ཤ་ཀ།",
    "གསེར་མེ་ཅུ་གང་གི་ཝང་ཨ་རུ་རྣམས།་།",
    "སླེ་ཏྲེས་གསུམ་པའི་ཐང་གིས་ཕུལ་བ་ཟབ།",
    "བསྡུས་ཐང་དྲོན་མོ་མང་ཕུལ་གོས་དྲོན་གྱོན།",
    "གི་ཝང་བཟང་དྲུག་ཨ་རུ་ཙན་དན་དཀར།",
    "གུ་གུལ་གླ་རྩི་སྟག་ཤ་ཕུར་མོང་ནག།",
    "བསེ་རུ་ར་ཁྲག་རེ་ལྕག་མེ་ཏོག་དང་།",
    "དངུལ་ཆུ་སྦྱར་པ་ཕག་རིལ་ཐང་གིས་ཕུལ།",
    "ཧོང་ལེན་གི་ཝང་མ་ནུ་སྤང་རྩི་དང་།",
    "ཅུ་གང་གུར་ཀུམ་གི་ཝང་ཙན་དན་དཀར།",
    "ཧོང་ལེན་སྲོ་ལོ་རེ་སྐོན་དུག་ཉུང་བཅས།",
    "སྤང་རྩི་ཨ་རུ་གུ་གུལ་གི་ཝང་དང་།",
    "བུད་མེད་བློ་རྣོ་དམག་ཇག་ཁ་ལོ་བསྒྱུར།",
    "ཟབ་མོའི་དོན་དང་སྔགས་ལ་གཤེ་བསྐུར་འདེབས།",
    "གཟའ་ཀླུ་མ་མོའི་ཁ་རླངས་སྤྲིན་དུ་འཁྲིགས།",
    "སྲོག་རྩར་བབས་ན་ཁ་ལྐུགས་དགྱེ་རེངས་ཟེར།",
    "གི་ཝང་གླ་རྩི་གུ་གུལ་ཤུ་དག་ནག།",
    "ཡང་ན་ཐར་ནུ་ཆུ་རྩ་རེ་ལྕག་དང་།",
    "ཐར་ནུ་རྒྱ་ཚྭ་རེ་ལྕག་ལྡོང་རོས་བཅས།",
    "ཆུ་བསྐོལ་གྲང་མོ་ཕྱེ་ཚོད་བསྟེན་པར་བྱ།",
    "ཐར་ནུ་དུར་བྱིད་མཆུ་སྙུང་རེ་ལྕག་དང་།",
    "སྲོག་རྩར་བབས་པའི་ཁ་ལྐུགས་དགྱེ་རེངས་ལ།",
    "འབུར་ཚུགས་ལྟ་ཞིང་ལུས་དགྱེ་ལྟག་པ་རེངས།",
    "ཕུར་ཐལ་གླ་རྩི་ཨ་གར་གཏུམ་པོ་ནག།",
    "ཕོག་པའི་མོད་ལ་སྟོབས་ཤོར་གཟི་མདངས་ཉམས།",
    "ཧོང་ལེན་བོང་དཀར་བཙོད་ཚོས་འབྲི་མོག་དང་།",
    "རུ་རྟ་ཤིང་མངར་གི་ཝང་ཙན་དན་དཀར།",
    "གུ་གུལ་གུར་ཀུམ་གི་ཝང་ཆ་བསྐྱེད་སྦྱར།",
    "ལི་ཤི་ཨ་རུ་ཚོས་བཙོད་འབྲི་མོག་བསྐྱེད།",
    "རེ་ལྕག་དུར་བྱིད་ཆུ་རྩ་ཐར་ནུ་བ།",
    "མཆུ་སྙུངས་བྲག་ཞུན་ཅུ་གང་གི་ཝང་དང་།",
    "དེ་ཕྱིར་གཉེན་པོ་མོད་ལ་བསྟུད་ནས་བསྟེན།",
    "གི་ཝང་གཡའ་ཀྱི་ཏིགྷ་ཀྱི་ལྕེ་དང་།",
    "གི་ཝང་གུར་ཀུམ་ཏིབྟ་དུག་མོ་ཉུང་།",
    "བྲག་ཞུན་གུར་ཏིག་གླང་མིག་ཕུར་མོང་ནག།",
    "ག་བུར་ནག་པོ་ཕུར་ཐལ་ཐང་ཕྲོམ་དཀར།",
    "མཆིན་བབས་གླང་རྩི་སྲོག་གི་མེ་ཏོག་བསྣན།",
    "གར་ནག་ཕུལ་ཐལ་གླ་གུལ་ཨ་རུ་ར།",
    "མིག་གི་མདངས་ཤོར་མི་གསལ་ཕུགས་སུ་བྲོས།",
    "བྲག་ཞུན་ཁྲག་རྐང་རེ་སྐོན་པརྦ་ཏས།",
    "བྲག་ཞུན་གར་ནག་གི་གུར་དུག་མོ་ཉུང་།",
    "རྒུ་དྲུས་འཛིན་པ་རེ་སྐོན་སྤང་རྩི་དང་།",
    "བྱ་རྐང་སྐྱེར་འབྲུ་ཏ་ཏྲིག་མོན་ཆ་ར།",
    "ཆུ་བསྐོལ་གྲང་མོ་འབྲས་ནས་བཙོས་ཁུ་བསྟེན།",
    "དུག་ཉུང་རེ་སྐོན་བྲག་ཞུན་དོམ་མཁྲིས་དང་།",
    "ཡུ་མོ་སྐྲངས་དང་ཟུག་རྔུ་ཆུང་བའོ།",
    "མུ་ཟི་སྟག་ཤ་ཝ་ཏ་ཕུར་མོང་ནག།",
    "སྔགས་ཀྱིས་བཅོས་པ་ཁྲོ་ལོད་རྟ་ཁྱུང་གི།",
    "སྟག་ཤ་ཐར་ནུ་རེ་ལྕག་བྲག་སྤོས་པ།",
    "ཞིབ་བཏགས་དྲི་ཆུར་སྦྱར་བྱུགས་གཉན་ལྷོག་གིས།",
    "སྐྲངས་རིགས་ཀུན་འཇོམས་རེག་པ་ཟུག་ཞིར་བརྗོད།",
    "ལུམས་ཀྱིས་འབྲས་འདུལ་མན་ངག་ཟབ་མོ་ནི།",
    "སྤྲུ་མ་སྤྱང་ཚེར་རེ་ལྕག་ཉ་ཡི་ཤ།",
    "མཚལ་ཐལ་བྱང་བ་ཚ་ལ་ཟེ་ཚྭ་སྦྱར།",
    "ཕུར་མོང་ཡོག་མོ་མཁན་པའི་ལུམས་ཀྱིས་འདུལ།",
    "འཛིན་པ་བྱི་ཏང་ཀ་དང་དུག་མོ་ཉུང་།",
    "འབམ་པོ་སྦྱར་པ་ཆུ་བསྐོལ་དྲོན་མོས་ཕུལ།",
    "ཉ་ཤ་རེ་ལྕག་འབམ་པོའི་ཀ་ཀ་རུ།",
    "བ་ཤ་རེ་སྐོན་བྲག་ཞུན་ཏ་ཏྲིག་དང་།",
    "རེ་འགའ་ལུས་འདར་སྤུ་བརྩེ་གྲང་ཤུམ་བྱེད།",
    "བཟང་དྲུག་གི་ཝང་བསྣན་པས་ཉེར་ལྔ་བཏང་།",
    "ཆུ་རྩ་རེ་ལྕག་སྤྱང་ཚེར་རི་ཤོའི་རྩ།",
    "གསོད་བྱེད་སྤྱང་ནག་གཉན་གསོད་དཔའ་བོའི་ཐལ།",
    "གི་ཝང་བཟང་དྲུག་ཨ་རུ་ཙན་དན་དཀར།",
    "ཕུར་མོང་བྲག་ཞུན་ཨ་གར་བསེ་རུའི་རྭ།",
    "དངུལ་ཟིལ་ཅན་གྱི་བཙུན་མོ་བསུ།",
    "ཕུར་མོང་མིང་ཅན་སྟབ་སེང་ལྕགས་ཏིག་ནག།",
    "ལྕགས་སྦྲུལ་མིག་དང་གི་ཝང་ག་རམ་རྩི།",
    "ཁྱི་ལ་ཝ་རི་རྒྱལ་མོ་ཀ་ར་སྦྱར།",
    "རྒུན་འབྲུམ་ནུས་བསྲེགས་ཐལ་བ་བིག་བན་དང་།",
    "འབྲུག་རུས་བ་བླ་ལྡོང་རོས་ཚོས་ཐལ་རྣམས།",
    "བཙོད་དང་འབྲི་མོག་ཤིང་མངར་ལི་ཤི་དང་།",
    "ཧོང་ལེན་སྟར་བུ་འབྲི་མོག་ཚོས་བཙོད་དང་།",
    "གི་ཝང་ས་འཛིན་ཉ་ཕྱིས་བསེ་རུའི་རྭ།",
    "ཅུ་གང་གི་ཝང་གུར་ཀུམ་བྲག་ཞུན་དང་།",
    "ཤིང་མངར་འབྲི་མོག་སྲོ་ལོ་ཨ་ཀྲོང་དཀར།",
    "རྒུན་འབྲུམ་ཛཱ་ཏི་སྒོག་ཐལ་སྤང་རྒྱན་དཀར།",
    "སྒོག་སྐྱ་ཟངས་ཐལ་བསྣན་པའི་སྦྱོར་བ་འདིས།",
    "གི་ཝང་བྲག་ཞུན་མ་ནུ་བ་ཤ་ཀ།",
    "གུར་ཀུམ་གི་ཝང་རུ་རྟ་སྐྱུ་རུ་ར།",
    "ཨ་རུ་བྲག་ཞུན་ཕག་བྲུན་ནུས་བསྲེགས་ཐལ།",
    "གསེར་མེ་གཡའ་ཀྱི་རེ་སྐོན་ཤུག་ཚེར་ཅན།",
    "ཤོ་རྩ་ལྕུམ་རྩ་ཆུ་རྩ་གསུམ་བསྲེགས་ཐལ།",
    "ཕུར་མོང་དུ་བ་མ་ཤོར་སེར་ཙམ་བསྲེག།",
    "སེ་འབྲུ་རྒྱམ་ཚྭ་བྲག་ཞུན་ཕག་བྲུན་ཐལ།",
    "སྤ་འབྲུམ་རུ་རྟ་ཕུར་མོང་ཁཎྜ་རྣམས།",
    "ཚ་གྲང་གང་གིས་དྲི་ཆུ་འགགས་པ་སེལ།",
    "འབྲས་གསུམ་སླེ་ཏྲེས་སེང་ལྡེང་ཚོས་གསུམ་དང་།",
    "འབྲུག་རུས་ཙན་དན་དམར་བོ་མཛོ་མོ་ཤིང་།",
    "གི་ཝང་གུར་ཀུམ་སྤོས་དཀར་སོ་མ་ར།",
    "རྟ་རྨིག་བཙའ་མ་རྭའི་གཞོབ་རེ་ལྕག་ཐལ།",
    "གི་ཝང་གླ་རྩི་བསེ་རུ་ཨ་ག་རུ།",
    "ཨ་གར་ཛཱ་ཏི་སླེ་ཏྲེས་སྒོག་ཐལ་སྦྱར།",
    "ཨ་རུ་གུ་གུལ་ཤུ་དག་གི་ཝང་དང་།",
    "གུར་ཀུམ་ད་ལིས་གོ་ཐལ་བུ་རམ་སྦྱར།",
    "སྤ་ཡག་འབྲས་བུ་སྒ་སྐྱ་འོལ་མོ་སེ།",
    "རྒྱ་ཚྭ་གཡེར་མ་གི་ཝང་དོམ་མཁྲིས་སྦྱར།",
    "གི་ཝང་ཙན་དན་དཀར་དམར་བ་ཤ་ཀ།",
    "ན་ག་པུཥྤ་སྤང་སྤོས་དུག་མོ་ཉུང་།",
    "མོ་ཡི་སྤྱི་སྐྲ་ཕོའི་རྨོངས་སྤུ་བསྲེགས་ཐལ།",
    "ལུག་གི་ཤ་མ་སྐམ་པོ་སྤྲེལ་རུས་བཅས།",
    "དོམ་མཁྲིས་གོང་མོའི་སྒྲོ་གཞོབ་རྩ་ཁུ་བྱུག།",
    "ཡོག་མོ་ལྕགས་ཀྱུ་རྟ་ལྤགས་འབུ་སུ་ཧང་།",
    "སྔོན་མོ་དུལ་དུལ་རྣམས་གདུས་ཁཎྜ་ལ།",
    "ཨ་རུ་བྲག་ཞུན་རེ་རལ་བྲག་སྤོས་དང་།",
    "དངོས་ཀྱི་དུག་དང་མཐོང་རེག་དུག་སོགས་འཇོམས།",
    "སྦྱོར་ངན་དུག་གི་གཉེན་པོ་འདི་ཁོ་ན།",
    "བོང་དམར་རེ་རལ་བྲག་སྐྱ་ཧ་བོ་སྦྱར།",
    "གི་ཝང་བསྣན་པས་ཚ་ཤས་ལྡན་པ་འཇོམས།",
    "བསྣན་པས་རེག་དུག་གྲང་ཤས་ཆེ་བ་འཇོམས།",
    "སྟོད་ཇ་གོ་ཡུ་བསྲེགས་ཐལ་ར་ཚིལ་སྦྱར།",
    "པདྨ་བདག་གིས་ཕྱི་རབས་དོན་དུ་བཀོད།",
    "གསོ་དཔྱད་རིན་ཆེན་དཔལ་གྱི་བུམ་བཟང་གི།",
    "ཤར་ཚད་སྙིགས་འགྲོར་ཕན་ཕྱིར་བདག་གིས་སྤེལ།",
    "མཁྱེན་གཟིགས་ནས་བརྒྱུད་ཨུ་པ་དེ་ཤའོ།",
    "ལི་ཤི་གསུམ་ཆ་གཉིས་རེ་དང་།",
    "བཙོད་ཚོས་འབྲི་མོག་སེང་ལྡེང་བ་ཤ་ཀ།",
    "རུ་རྟ་ཤིང་མངར་བཙོད་དང་དབྱི་མོང་ནག།",
    "དབུགས་རྒྱུ་ཞན་ཞིང་མིག་གི་རྒྱལ་མོ་འདལ།",
    "རྨི་ལམ་སྐབས་སུ་སྐྱབས་རྗེ་མཆོག་གིས་གནང་།",
    "སྙིགས་འགྲོའི་རྒུད་པ་སེལ་ཕྱིར་བདག་གིས་བཀོད།",
    "ཏིག་ཏགསེར་གྱི་མེ་ཏོག་དུག་མོ་ཉུང་།",
    "འདི་ཡང་རང་གི་ལག་ལེན་མྱོང་བས་གྲུབ།",
    "སུག་སྨེལ་རྒྱམ་ཚྭ་རུ་རྟ་དུག་མོ་ཉུང་།",
    "མ་ནུ་གསེར་མེ་གུར་ཀུམ་གི་ཝང་དང་།",
    "ཏིག་ཏ་བྲག་ཞུན་ཕག་བྲུན་ནུས་བསྲེགས་ཐལ།",
    "༩ གི་ཝང་གུར་ཀུམ་ཨུཏྤལ་བ་ལེ་ཀ།",
    "གསེར་གྱི་མེ་ཏོག་ཀ་ར་གི་ཝང་དགུ།",
    "གི་ཝང་དགུ་སྟེང་འུ་སུ་པྲི་ཡང་ཀུ།",
    "ཚད་སྟོབས་ཆེ་ན་གི་ཝང་ཙན་དན་བསྣན།",
    "ཅོང་ཞི་ཨུཏྤལ་འུ་སུ་རེ་སྐོན་དང་།",
    "སྒ་སྐྱ་མ་ནུ་གོ་ཐལ་པྲི་ཡང་ཀུ།",
    "རེ་རལ་གསེར་མེ་སྐྱེར་ཤུན་བ་ཤ་ཀ།",
    "སྟར་བུ་དུང་ཐལ་སྦྲུལ་ཤ་རྒྱམ་ཚྭ་རྣམས།",
    "ཆུ་ཚན་ལྕག་གིས་བསྐུལ་ནས་དག་པར་སྦྱང་།",
    "སྟར་བུ་རེ་སྐོན་ཁུར་རྩ་ལུག་རུ་སྨུག།",
    "སྒ་སྐྱ་རུ་རྟ་ཏིག་ཏ་དུག་མོ་ཉུང་།",
    "གངས་ཐིགས་གི་ཝང་དོམ་མཁྲིས་ཕག་ཁྲག་སྦྱར།",
    "ཅོང་ཞི་སོལ་མེས་བསྲེགས་པ་ཆང་གིས་ངར་བཏབ་པ་ལ་གཞི་བྱས་ཏེ།",
    "ཏིག་ཏ་དུག་ཉུང་གསེར་མེ་རེ་སྐོན་པ།",
    "ལན་རེས་མི་སེལ་ཡུན་དུ་བསྟེན་པར་བྱ།",
    "ཉིན་རེར་ཐེངས་དྲུག་ནས་བཅུ་བར་བཏུང་བ་དང་གཉེན་པོ་གང་འཕྲོད་བལྟ་ཞིང་ཡུན་བསྲིངས་ནས་འཐུང་དགོས་སོ།",
    "ཅོང་ཞི་རྒོད་བཏུལ་ཆང་གིས་ངར་བཏབ་བསུབས།",
    "གངས་ཐིག་བྲག་ཞུན་གི་ཝང་བཅས་སྦྱར་པ།",
    "ཆ་མཉམ་ཀུན་དང་བོང་མཉམ་རྡོ་ཐལ་བསྲེ།",
    "དམར་བོ་གསུམ་བཙོད་ཚོས་འབྲི་མོག་དང་བཟང་དྲུག་ཆ་རེ་རེ།",
    "ཚ་བ་གསུམ་དང་སྔོ་ཚ་གསུམ་བསྲེགས་ཐལ།",
    "འབྲི་མོག་གླ་རྩི་སྟག་ཤ་བྱི་ཏང་ཀ།",
    "ཆུ་བསྐོལ་ངད་ཡལ་ལྕག་གིས་ཡང་ཡང་བསྐུལ།",
    "དུར་བྱིད་སྟར་བུ་དུང་ཐལ་སྦྲུལ་གྱི་ཤ།",
    "ཐུན་བཟང་ཪེ་སྦྱར་ཆུ་བསྐོལ་ཚ་མོས་དབུལ།",
    "བུདྡྷ་ས་མུ་ཏྲའི་མན་ངག་ལྷན་ཐབས་སོགས་ལས།",
    "བྱང་གི་བུལ་ཏོག་རྙིང་བ་ལ།",
    "བྱ་རྒོད་ཐལ་བ་ཅོང་ཞིའི་ཕྱེད།",
    "གོ་ཐལ་ཕྱེད་ཕྱེད་ཙམ་རེ་བཏང་།",
    "ཞིབ་པར་བཏགས་ལ་ཁེམ་བུ་རེ།",
    "ཇའམ་ཆུའམ་ཆང་གིས་ཕུལ།",
    "གི་ཝང་གཙོ་ཆེར་བཏང་གྱུར་ན།",
    "སྐྲན་ལ་གོ་ཐལ་རྡོ་ཐལ་བསྣན།",
    "ཁྱད་པར་ཅོང་ཞིའི་འཕྲུལ་ཐལ་ཆུང་འབྲིང་ཆེ་གསུམ་དང་།",
    "ཅོང་ཞི་དྲག་པོར་བཏུལ་བའི་ཐལ་བ་དང་།",
    "ཨ་རུ་ཧོང་ལེན་དུང་མགྲོན་ཐལ་བ་དང་།",
    "སྟར་བུ་ཚ་ལ་ད་ལིས་ནུས་བསྲེགས་ཐལ།",
    "བར་གནས་ཚ་སྐྲན་རྒོད་བཏུལ་ཐལ་བ་དང་།",
    "སྤོས་དཀར་སེང་ལྡེང་ཚ་ལ་དུང་མགྲོན་ཐལ།",
    "ཉ་སྲམ་གཅན་གཟན་རུས་པ་ནུས་བསྲེགས་ཐལ།",
    "རྡོ་ཐལ་སྟར་བུ་ཀ་ར་སྦྱར་ལ་བཏང་།",
    "འོལ་སེའི་རྩ་བ་ལྕེ་ཚ་རེ་ལྕག་དང་།",
    "ཟན་དྲོན་དུགས་ཀྱིས་བག་རེ་བདུག་པར་བྱ།",
    "འདི་རྣམས་རང་གི་ལག་ལེན་མྱོང་བས་གྲུབ།",
    "ཐུན་རེ་སྦྱར་པས་ལྷེན་སྐྲན་བཤིགས།",
    "རྡོ་ཐལ་བཟང་བོ་ཆ་གསུམ་དང་།",
    "སྐྲན་གྱི་བྲག་རི་ཐལ་བར་བརླགས།",
    "རྡོ་ཞུན་གཙོ་བོ་དེའི་ཕྱེད་རྒོད་བཏུལ་ཐལ།",
    "གོ་ཐལ་ཚ་ལ་ལ་ཕུག་བསྲེགས་པའི་ཐལ།",
    "དབྱི་མོང་འབམ་པོའི་ཁཎྜར་བུ་རམ་སྦྱར།",
    "ཕག་བྲུན་ནུས་བསྲེགས་ཐལ་བ་ཆ་བཅུ་ལ།",
    "བྲག་ཞུན་ཏིག་ཏ་གསེར་མེ་དུག་མོ་ཉུང་།",
    "ཀྱི་ལྕེ་དོམ་མཁྲིས་དུང་མགྲོན་བསྲེགས་ཐལ་བཅས།",
    "བྲག་ཞུན་སྟར་བུ་སྒ་སྐྱའི་གདུས་ཐང་གིས།",
    "ཕུལ་ན་བུད་མེད་མངལ་སྐྲན་འདི་ཡིས་བཤིགས།",
    "སྔོན་མོ་ཆུ་འདྲེན་བྱ་བ་དེ།",
    "སྤོས་དཀར་མཚལ་དཀར་སྡིག་སྲིན་སུག་སྨེལ་རྣམས་ཐུན་རེ་ཙམ།",
    "ཆུ་མ་རྩི་ཉི་དགའི་འབྲུ་རྣམས་ཞིབ་བཏགས་ཆུ་གྲང་གིས་རྟ་བྱའོ།",
    "སྔོན་མོ་ཆབ་འདྲེན་གསུམ་བསྒྱུར་ལ།",
    "རང་གི་ཉམས་མྱོང་ལ།",
    "འུ་སྐྱུར་ལྷ་མོའི་ཐང་གིས་ཡང་ཡང་དབུལ་བས་སྐྱ་རྦབ་དང་འོར།"
  ]
