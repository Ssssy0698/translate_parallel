    "སྟོད་ཆ་དེར་ཚིག་འགའ་ཞིག་འདུག་ཀྱང་བརྗེད།",
    "གཤམ་དེར་སྙན་བརྒྱུད་འཆི་མེད་བཅུད་ལེན་ཟུར་དུ་བྲིས་པ་འདི་ཇི་ལྟ་བ་བཞིན་གདའ།",
    "འདི་ལྟར་འདུག་ཅེས་ཞུས་པས།",
    "དམ་ཚིག་གཙང་བ་ཡིན་འདུག་ཅེས་དང་།",
    "ལུང་ཡོད་ཀྱང་བརྒྱུད་པ་ངེས་འདྲོངས་མི་འདུག་གསུངས།",
    "ཁ་ཕྱེ་བས་གནམ་ལྕགས་རྡོ་རྗེ་དངོས་གཙང་ཁྱད་མཚར་ཞིག་འདུག་དེར་མི་དེས།",
    "སྐལ་བཟང་དང་དམ་ཉམས་གཉིས་ཀ་མང་དུ་བསགས་འདུག་ཕེབས།",
    "རྡོར་སེམས་སྐྲ་དངོས་ལྟ་བུ་ཞིག་ལ་སྐ་སྨད་དུ་རིང་བསྲེལ་གྲངས་མེད་པ་འབྱར་ནས་འདུག་པ་མཇལ་བར།",
    "ནང་ནུབ་ཟས་ནོར་ཏེ་འདུ་བ་རྣམ་པ་གསུམ་རྣམས་ནི་ཐམས་ཅད་ཀྱི་མཐུན་སྣང་དུ་གྲུབ་པ་དེར་གདའ།",
    "ལར་ཁྱེད་རང་རྣམས་ནས་བྱ་དགོས་ངེས་དེ་ཅིའང་མི་བྱེད།",
    "འདི་དེ་ཙམ་གྱི་རྙིང་ཉམས་བཅའ་ཁ་སོགས་མི་འདུག་པས་ནམ་ཅི་ཆེ་གསུངས་པས།",
    "རྗེ་ཉིད་ཁྱམས་ཡངས་པ་ཞིག་ན་ཁྲི་མཐོན་པོར་བཞུགས་འདུག་པ་ལ།",
    "ཤོག་སེར་ཆུང་ངུ་ཞིག་འདུག་སྟེ་ངེད་ནས་ཀློག་མི་ཤེས་གསུངས།",
    "དེར་སུ་འདུག་བལྟ་དགོས་དགོངས་ནས་ཕེབས་པས།",
    "དེར་མངའ་རིས་རིག་འཛིན་ལེགས་ལྡན་རྡོ་རྗེ་ཉིད་སྔགས་པའི་ཆ་ལུགས་ཅན་དུ་བཞུགས་འདུག་པ་ལ་གུས་འདུད་མཛད་ནས་འདིར་ཕེབས་དོན་ཅི་ཡིན་ཞུས་པར།",
    "ཁྱེད་རང་གསུམ་ཙམ་མ་གཏོགས་སྐས་ཆེན་འདི་ཚུགས་ཐུབ་པ་ནི་སུའང་མི་འདུག་ཟེར་བ་ཞིག་བྱུང་བས་འདི་ལའང་གོ་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་གསུངས།",
    "ཤིན་ཏུ་ཉམས་དགའ་ལ་ཡིད་དུ་འོང་བ་ཞིག་ཏུ་ཕེབས་འདུག་པར།",
    "མཐར་འཆི་དུས་ཀྱང་གཅིག་པུར་འཆི་བས་གལ་ཆེ་ཤོས་དེ་གཉིས་ལ་བློ་སྟོན་གྲོས་བྱེད་མཁན་སུ་མི་འདུག་པ།",
    "རྗེ་ཉིད་སྐུ་ན་གཞོན་ནུའི་དུས་སྐུ་གཟུགས་ཐང་པོ་ཞིག་ཡིན་འདུག་རུང་།",
    "ད་ནས་དུས་ཡོལ་ཟིན་པས་ཅི་བྱ་མེད་ནའང་ཁྱེད་རང་ལ་ཐེངས་པ་ཡིན།",
    "ཡང་མེ་ཡོས་ལོར་རྗེ་ཉིད་དང་མཆོག་གླིང་ལྷན་རྒྱས་ཕེབས་བཞུད་མཛད་སྐབས་ཡབ་གཞིས་རི་བོ་ཁྱུང་ལྡིང་ངམ་ཁྱུང་ཚང་བྲག་ནས་རྡོ་སྒྲོམ་རིམ་པ་གསུམ་པ་ཞིག་སྤྱན་དྲངས་པ་ལ་རྩ་གསུམ་བཀའ་འདུས་ཀྱི་ཆ་ལག་རྗེ་འབངས་ཉེར་ལྔ་སོ་སོའི་སྒྲུབ་ཐབས་དམ་རྫས་བཅས་བཞུགས་པ་ཡིན་འདུག་ལ།",
    "པདྨ་ཤེལ་རིར་གཏེར་ཁ་ཞིག་ཡོད་པ་སོགས་རྗེ་ཉིད་སྔར་ཕེབས་སྐབས་གྲ་འགྲིགས་པོ་མ་བྱུང་བ་དང་ད་ཕན་དངོས་ཀྱིས་ཕེབས་པ་མི་འོང་བར་འདུག་པས་དེ་རིགས་ལོན་རྒྱུ་བྱུང་ན་གལ་ཆེ་བ་ཡོད་ཚུལ་བཀས་གནང་བ་ལྟར།",
    "གཞན་ཐམས་ཅད་རྗེ་ཉིད་ནས་འབེབས་པར་གནང་འདུག་པ་དང་།",
    "འདི་སྐོར་དག་སྣང་མང་དུ་འདུག་ཀྱང་འདིར་མ་བཀོད།",
    "ཕྱིས་སུའང་དགོངས་པ་ཆེད་དུ་གཏད་ན་ཞིབ་ཆ་མཁྱེན་པར་འདུག་གསུངས།",
    "ནག་ཕྱོགས་དར་ན་ཕུང་ཁྲོལ་ཚབ་ཇེ་ཆེར་འགྱུར་བས་དམ་སྲི་འདི་རྣམས་བསྒྲལ་དགོས་ཞེས་ནན་གྱིས་བཏུད་ནས་ཟེར་འདུག་པ་ལ།",
    "དངོས་སུའང་ཁྲག་དྲི་སྣོམ་པ་སོགས་བྱུང་འདུག་དེ་རྗེས་ངོས་བཟུང་མེད་པའི་བསྙུན་ཁམས་ཀྱིས་གསུང་འགག་པ་སོགས་ཀྱང་བྱུང་འདུག་པས།",
    "དེ་སྐབས་བསྟན་པའི་རིམ་གྲོ་འདོན་བྱ་སོགས་སྒྲུབ་མཁན་མང་འདུག་ཀྱང་དོན་དུ་རྗེ་འདི་ཉིད་ཀྱི་ཐུགས་རྗེས་ནག་ཕྱོགས་གདུག་པའི་ཚ་ངར་ཕྱེད་ཙམ་ཞི་ནས་རྒྱལ་ཁམས་སུ་བདེ་སྐྱིད་སྤྲིན་བར་གྱི་ཉི་མ་ཙམ་བརྡོལ་བར་མངོན་ནོ།",
    "རང་རང་ཉམས་ལེན་མཐར་དབྱུང་ལ",
    "བར་སྣང་དུ་སླེབས་པ་ལྟ་བུ་མཐོ་བའི་ནང་དུ་ཁྲི་སྟན་ཞིག་འདུག་པ་ཉིད་ཀྱི་ཡིན་སྙམ་གྱིས་དེར་བཞུགས།",
    "བར་དན་དུ་ཆང་བུམ་ལྟ་བུའི་ལྗང་གུ་ཆེ་ལེགས་ཞིག་འདུག་པ་ན་ཉིད་སྔར་མལ་བཞུགས།",
    "སྐལ་བཤིན་ཏུ་བཟང་པས་ང་རང་ལའང་གནང་བར་ཞུ།",
    "ཁྱེད་རང་རྣམས་སློབ་དཔོན་པདྨ་དང་།",
    "དེ་སྔ་གཏེར་སྟོན་གྱི་མིང་ཐོགས་མི་འདུག་མིང་ཐོགས་དགོས།",
    "ཞེས་། གསུངས་པའང་ཇི་བཞིན་བྱུང་བར་འདུག་གོ།",
    "ཁྱེད་སྔ་འགྱུར་ལོ་ཙཱ་བ་ཡིན་ན་རྗེ་འབངས་ཉེར་ལྔའི་གྲལ་དུ་མི་འདུག་ན་གསུངས་པས།",
    "ད་རུང་གཏེར་རྙིང་སྐོར་ཉི་ཤུ་རྩ་ལྔ་ཁ་ལོངས་པ་ཞིག་ཕབ་རྒྱ་དང་འཇོག་རྒྱུ་ཐོན་ན་ཁྱེད་རང་གཉིས་ཀ་ད་རུང་ལོ་ཉི་ཤུ་རྩ་ལྔ་སྡོད།",
    "ནོར་བུའི་ཁང་པ་དང་རྒྱན་སོགས་ལ་ལོངས་སྤྱོད་པའི་ཡ་མཚན་ཅན་ཞིག་འདུག་སྙམ་བྱེད་པའི་ངང་དེ་ལས་སད་གསུངས།",
    "གསོལ་ཚིགས་ཞིག་ཞུ་དགོས་ཟེར་འདུག་པས་རྟ་འདི་ཆིབས་ནས་གསོལ་ཚིགས་ལ་འབྱོན་པར་ཞུ་ཟེར།",
    "ཟབ་བུ་ལུང་གཏེར་ལུང་མཇལ་དུ་འགྲོ་བ་ཡིན་ཁོ་ན་གསུངས་ཀྱིན་འདུག་ལམ་དུ་ཆར་པ་འགའ་ཞིག་བབས་པ།",
    "ཕྱི་དྲོ་ལུང་པའི་རྐེད་ཙམ་སླེབས་པ་ཆུ་ཕར་ཀ་དེར་འབྲོག་དུད་ཕྱུག་པོ་ཞིག་འདུག་པ།",
    "ཉིད་དཔོན་སློབ་ནས་ཕོ་གཏོར་སོགས་འབག་འབོག་མི་མཛད་པར་ཞུ་འདུག་དེ་ནུབ་ཐུགས་དམ་འདྲ་མཛད་ཀྱིན་བཞུགས།",
    "ཞལ་རྒྱན་ཅུང་ཟད་ཡོད་པ་ཞིག་ཆར་ཡིབས་ལྟ་བུས་བཞུགས་འདུག་པ་བཞེངས་ནས།",
    "འདི་ལ་རྫོགས་རིམ་ལས་ཚོགས་སོགས་ཟབ་རྒྱས་བཞུགས་ཡོད་འདུག་ཀྱང་རྩ་བའི་ཕྲིན་ལས།",
    "རྣམ་རྒྱལ་མའི་སྒྲུབ་ཐབས་ཙམ་འབེབས་པར་མཛད་འདུག་གོ།",
    "དེར་ཤིང་ལོ་སྔོན་པོའི་སྤྱིལ་བུ་ཞིག་འདུག་པ་སྒོར་ཕེབས་པས།",
    "ཁྱེད་རང་ཐམས་ཅད་ཀྱི་བརྒྱུད་པ་ལ་ཡོད་ཅིང་གསོལ་བ་འདེབས་ཡུལ་ས་ར་ཧ་ཞེས་པ་དེ་ཡིན་གསུངས།",
    "ཁྱེད་ནས་ད་སྔ་བསྙེན་རྫོགས་སུ་ལ་མ་བསྒྲུབས་འདུག་པས་ད་སྟེ་མི་ལྔ་བཅུ་ལ་བསྙེན་རྫོགས་བསྒྲུབ་དགོས་པས།",
    "དེར་ལས་གྲྭ་མི་སུའང་མི་འདུག་པས་ཅི་འདྲ་མཛད་རྒྱུ་ཡིན་དགོངས་པས།",
    "སྐྲ་དེ་ནི་བོད་ཡུལ་རྡོ་རྗེ་འཛིན་པ་ཐམས་ཅད་ཀྱི་རྒྱལ་པོ་རྗེ་བཙུན་གྲགས་པ་རྒྱལ་མཚན་ཡིན་འདུག་གོ་གསུངས།",
    "ནང་རང་ལུས།",
    "དོན་གྱིས་དགོངས་པ་ཁྱེད་རང་ལ་གཏད་ཡོད་ཚོད་འདུག་པ།",
    "དེ་ལས་བཅུ་ཕྲག་བཞི་ལྷག་ཙམ་ནི་ཆབས་གཅིག་ཏུ་གནང་བ་དང་དེ་མིན་དུས་སྔ་ཕྱི་སྣ་ཚོགས་སུ་གནང་བ་ཡིན་འདུག་གོ།",
    "དབུ་སྔས་སྟེང་དུ་ཐོག་ཆུ་མེ་འབར་བ་ཕོར་པ་གང་ཙམ་འཁྱིལ་ལི་ལི་འདུག་པ།",
    "ཁྱད་པར་བུ་འདི་ལ་བགེགས་ཞུགས་ནས་ལོག་པའི་སྤྱོད་པ་མཐའ་མེད་པས་རང་གཞན་ཕུང་ལ་སྦྱོར་བ་ཞིག་འོང་བར་འདུག་དེ་འགོག་པའི་ཐབས་ཤིག་མ་བྱས་ཐུས་མེད་གསུངས་ཏེ་དམིགས་ཟབ་དང་དྲག་སྔགས་ཀྱིས་གཟིར་ནས་བགེགས་བསྐྲད་པ་དང་ཕྱིར་མི་ལྡོག་པའི་སླད་དུ།",
    "བུ་ཁོ་རང་ནར་སོན་ནས་སྲིད་ཀྱི་བྱ་བ་བྱེད་སྐབས།",
    "ལྐོག་ཏུ་དགེ་སྦྱོར་ལ་བརྩོན་པ་དང་མི་བརྩོན་པའི་ཁྱད་དང་ལབ་བརྗོད་བཟང་ངན་ཅི་བྱེད་རྣམས་ཀྱང་སྒྲིབ་ཐོགས་མེད་པ་མཁྱེན་ཚུལ་གསལ་བར་གསུངས་པའང་རང་གཞན་ཀུན་ལ་མཐོང་ཐོས་སུ་གྱུར་པ་མང་ངོ།",
    "ངའི་ལུས་ལས་མེ་འབར་བྱུང་ངོ་ཟེར་ནས་འཇིགས་སྐྲག་ཆེན་པོས་འདུག་མི་བཟོད་པ་བྲོས་གྲབ་བྱེད་པར་མི་གཞོན་ལྔ་དྲུག་ཙམ་གྱིས་མནན་དཀའ་བར་གྱུར་ཚེ།",
    "གཞན་མཁྱེན་སྟོབས་ནུས་པ་མངའ་བ་དག་ལའང་རང་དོན་ལྟར་བསྐུལ་མ་འདེབས་པར་མཛད།",
    "དབུས་གཙང་ཁམས་ཕྱོགས་གང་ནའང་ཡིག་ཚོགས་ཡོངས་རྫོགས་ཆ་ཚང་བ་དཀོན་འདུག་པས་འདི་དག་ཐམས་ཅད་པར་དུ་འཁོད་པ་ཞིག་བྱས་ཚེ་འཆད་ཉན་ཆབ་གཅིག་ཏུ་འགྲོ།",
    "ཞེས་པ་ཕྱག་བྲིས་དངོས་ཤིག་གནང་འདུག་པ་འདི་འདྲ་གསུང་སྲོལ་མེད་པས་ཅི་ཞིག་ཡིན་ནམ་སྙམ་པ་བྱུང་།",
    "དེ་ཡང་འཇའ་ཚོན་ཁ་དོག་སྣ་ལྔ་ཁྲ་ཁྱུག་ཁྱུག་འདུག་ཚུལ་གསུངས་འདུག་པ་། བཞིན།",
    "ངོར་གྱི་གསེར་སྐུ་ལྷ་ཁང་དུ་སླེབས་འདུག་པ།",
    "ཐོད་པ་བཞག་འདུག་པས་གྲི་གུག་དེ་ལག་པ་གཡས་པས་བཟུང་།",
    "གཡོན་པས་ཐོད་པ་བཟུང་ནས་གར་སྟབས་མང་པོ་བྱས་པ་རྨིས་པ་ངོ་མཚར་བའི་ལྟས་སུ་འདུག་བོད་ལ་ཡར་འགྲོ་དུས་སྒར་བ་རྣམས་ཀྱིས་བཤས་མང་པོ་བཤས་པ་ལ་ངེས་འབྱུང་དང་།",
    "ལར་ངག་བརྒྱ་བསྙེན་བརྒྱ་ཞིག་ལའང་སྟན་ཐོག་གཅིག་ཏུ་འདུག་མྱོང་།",
    "གཟེར་ཟུག་རྣམས་ཞི་ནས་ཡར་འགྲོ་བ་ཞིག་འོང་བར་འདུག་སྒྲུབ་པ་ལ་ཞུགས་པ་ནས་བཟུང་སྟེ་བར་ཆད་ཀྱི་རྣམ་གྲངས་མང་པོ་བྱུང་ཞིང་།",
    "དེའི་དོན་ལ་དཔྱད་ན་མི་བརྗེད་པའི་གཟུངས་ཐོབ་དགོས་རྒྱུ་ལྟ་བུ་འདུག་པ་ལ།",
    "དེ་རྗེས་ཉིན་གསུམ་ཙམ་ནས་ང་རང་གྱི་མདུན་གྱི་ནམ་མཁར་རྗེ་རྡོ་རྗེ་འཆང་བསྒོམས་ནས་གསོལ་བ་འདེབས་ཤིང་འདུག་པ་ལ།",
    "ལུང་རྟོགས་ཀྱི་ཡོན་ཏན་གྱིས་ཤིན་ཏུ་དབུལ་བ་སོགས་གང་ནས་བསམས་ཀྱང་གཏད་སོ་གང་ཡང་མེད་པས་སྒྱུ་མ་ཉིད་འཁྲུལ་རང་དུ་འདུག་ཡང་བཅད་རྒྱ་རུ་འདུག་སྐབས།",
    "ང་རྒྱལ་བརྟན་པ་གཉིས་ལས་ཕྱི་མ་གཙོ་ཆེ་བ་འདུག་སྟེ།",
    "སྒ་ཁོག་ཆེ་སྐྱོན་མེད་པ་ཞིག་ཡོད་ཀྱིན་འདུག་གསུངས།",
    "ཕྲན་གྱིས་རྨི་ལམ་འཚུབ་ནས་འདུག་པས་དེ་བཟློག་ཐབས་ཅི་དགའ་ཞུ་ཤོག་ཕུལ་བའི་ལན་དུ་རྗེ་ཉིད་ཀྱི་ཕྱག་བྲིས་སུ།",
    "ཁོ་བོ་ནི་བསྒྲུབ་ན་འགྲུབ་པའི་གང་ཟག་ཡིན་པར་འདུག་དུས་དང་རྣམ་པ་ཐམས་ཅད་དུ་མགོན་པོ་འདིས་བར་ཆད་སྲུང་བ་དང་།",
    "མཆོག་སྤྲུལ་འདི་ཉིད་ལ་ངེད་། ཀྱིས་ལམ་འབྲས་ཕུལ་བ་འདི་ས་ཁང་ཐུགས་ཤིན་ཏུ་དགེས་པར་འདུག་ཅེས་དང་།",
    "ཐུགས་དགྱེས་པའི་སྒོ་ནས་དཀའ་བ་ཅུང་ཟད་ཅང་མི་འདུག་འདིར་སྡོད་དང་གསུངས་ནས།",
    "པུ་ཏྲ་དེ་ཁྱེད་ལ་ཅུང་ཐུགས་མི་མཉེས་པར་འདུག་གསུངས།",
    "ལན་ཅིག་ང་རང་སྐྱ་མདུན་དུ་སླེབས་ཚེ།",
    "ཁོང་ངོར་དུ་ཕེབས་འདུག་པ་ལ།",
    "ད་ང་རང་བོད་དུ་ལན་གཉིས་ལས་འོང་མི་དགོས།",
    "མ་འོངས་པ་ན་ང་རང་རྨེ་ཤོད་དང་།",
    "ད་ལན་ཁྱེད་རྣམས་འོང་བ་དང་མཉམ་དུ་ངེད་ལ་གྲིབ་ཅིག་ཀྱང་ཕོག་སྒྲ་གཅན་གྱིས་ངེད་ཀྱི་ལག་པ་ལ་དཀྲིས་འདུག་པའི་སྣང་བ་ཞིག་ཀྱང་བྱུང་།",
    "དེ་ཕྱོགས་ན་ད་ལྟ་སུ་འདུག་ཅེས་དྲིས་པས།",
    "ཁོང་འཇམ་དབྱངས་ས་པཎ་གྱི་སྤྲུལ་པ་ཡིན་ངེས་སུ་འདུག་གསུངས།",
    "ངས་མགོན་པོའི་སྒོ་ནས་རིམ་གྲོ་ཞིག་བྱས་ཚེ་ཕན་པར་འདུག་ཅེས་གསུངས་པ་ལ།",
    "འོན་ཀྱང་དེའི་ཤུལ་དུ་ཟླ་བ་གཅིག་ཤར་བྱུང་བས་གཏན་མེད་དུ་མི་འགྲོ་བར་འདུག་གསུངས།",
    "དེ་མགོན་པོ་ཡིན་པར་འདུག་པས་སྐྱོན་མེད་གསུངས།",
    "ཚར་ཆེན་ཡབ་སྲས་ཀྱི་བཀའ་འབུམ་ཀློག་མཛད་ཀྱིན་འདུག་པས།",
    "འདིར་ཤོག་དང་བལྟ་རྒྱུ་ལེགས་པོ་འདུག་ཅེས་གསུངས་པ་ལ།",
    "བལྟ་རྒྱུ་ཅི་འདུག་ང་རང་ལ་བསྟན་རོག་ཞུས་པས།",
    "དེ་འདྲ་མི་འགྲུབ་པར་འདུག་ཅེས་ཞུས་ནས་བཀའ་བཞིན་མ་བསྒྲུབ།",
    "འདི་མན་ཆད་ང་རང་ལ་ཆེར་མི་གསལ་ཡང་།",
    "ལོ་དེའི་ཟླ་བ་བཅུ་གཅིག་པའི་ནང་དགོན་ནས་རི་ཁྲོད་དུ་ཕེབས་ཁར་སྐུ་འཕྲིས་པ་འགའ་ལ་ང་རང་འཆི་ས་དགོན་ནང་དུ་དགོས་པས།",
    "རྒྱལ་བ་རྡོ་རྗེ་འཆང་ཀུན་དགའ་བཟང་པོ་གསུམ་ཀ་ལས་ལམ་འབྲས་ཐོབ་ཚར་ཞེས་ཉེ་བརྒྱུད་གསན་པའི་གསུང་སྒྲོས་ངོ་མཚར་ཅན་འདི་ཡང་གསུང་བར་གདའ།",
    "དེ་དག་ལས་། ཀྱང་ང་རང་ལོ་གྲངས་མང་།",
    "ད་ང་གཅིག་པུ་འདུག་རྒྱུ་ག་ལ་ཡོད།",
    "རྩ་མཇལ་བའི་ཚེ་བསྙུན་གཞི་ཅུང་ཟད་ཀྱང་མི་འདུག་ཅེས་ཐམས་ཅད་མཐུན་པར་སྒྲོགས།",
    "ཞབས་གཉིས་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་བཞུགས།",
    "དབུ་ཅུང་ཟད་འཕྲུག་སྐུ་གསུང་ཐུགས་ཀྱི་མཛད་སྤྱོད་ཐམས་ཅད་དུས་རྒྱུན་པ་ལྟར་མ་གཏོགས་པ་ད་མྱ་ངན་ལས་འདའ་བ་ཡིན་སྙམ་པ་གཏན་ནས་མི་འདུག་གསུངས།",
    "ཉག་མ་གསུམ་བཞི་ཞིག་གསུང་ཙ་ན།",
    "དབུ་ཐོད་སྟེང་དུ་མ་ཎི་འབྲུ་དྲུག་རང་བྱོན་དུ་འདུག་པ་དང་།",
    "ཡ་འདི་ན་ཁྱིམ་ཚང་གཉིས་ཡོད་པ་ད་མི་འདུག་གསུང་བ་དེ་འཕྲལ་ཞབས་ཕྱི་རྣམས་ནས་ཅི་ལགས་ཞུས་པས།",
    "མདང་ནུབ་ང་ལ་ཉམས་སྣང་དེ་ལྟ་བུ་བྱུང་བ་ད་ལྟའང་ཁའི་ནང་ཁྲག་དྲི་བྲོ་འདུག་ཞེས་བཀའ་སྩལ་བ་དེ་ནས་བཟུང་སྔོན་བླ་ཆེན་ནུས་པ་ཅན་དུ་མས་ཞི་དྲག་ཇི་ལྟར་མཛད་ཀྱང་།",
    "དེའི་ཕྱི་ཉིན་ཚེས་བཅུ་གཉིས་ལ་ནམ་རྒྱུན་ལྟར་སྐུ་བཞེངས་མཛད་རྗེས་ཐོག་ཁའི་རྒྱལ་མཚན་ལ་ཉི་མ་ཤར་འདུག་གམ་ཞེས་བཀའ་འདྲི་མཛད་པ་ཞབས་འབྲིང་རྣམས་ནས།",
    "རྒྱལ་མཚན་ལ་ཉི་མ་ཤར་འདུག་ཞུས་པས།",
    "འབྲི་གུང་སྐྱབས་མགོན་ཆེ་ཚང་ཞེས་བྲིས་གནང་འདུག།",
    "དེ་དག་དུས་ཚོད་མཉམ་པའི་ས་གནས་གཞན་གྱི་བྱུང་བ་དང་ཐོ་གཏུགས་རྒྱུ་དང་།",
    "བོད་ཡིག་ལ་མཚོན་ན་དཀྱོག་ཡིག་འདི་མིག་ལ་མཛེས་པོ་ཞིག་ཀྱང་མི་འདུག།",
    "དོན་ལ་མིང་གཅིག་ཡིན་པ་ལས་རུས་མིང་དང་རང་མིང་ལོགས་སུ་མེད།",
    "སྔ་ཕྱི་བརྗེས་ནས་འབྲི་དགོས་དོན་མེད་ཅེས་གསལ་བོར་བཀོད་འདུག་པ་སོགས།",
    "རྒྱུ་ཆ་དེ་ག་དུས་དྲ་ཐོག་ནས་རྙེད་ཚུལ་བཅས་གསལ་བོར་འགོད་དགོས་པ་དེ་ཡིན།",
    "སྔ་ཕྱི་འདི་གཉིས་ཀ་བདེན་པ་མིན་པར་བརྟེན་ཁྱེད་རང་ལ་རྩོམ་རྐུན་གྱི་ཉེས་པ་ཕོག་ངེས་ཡིན།",
    "དེ་ལ་བརྟེན་ནས་ཁྱེད་རང་རྩོམ་རྐུ་བྱེད་མཁན་མ་ཡིན་པར་ནམ་ཡང་འགྱུར་མི་སྲིད།",
    "གཞན་ཁྱེད་རང་ཉིད་ཀྱིས་ལྟ་ཚུལ་འདི་ཐོག་མར་ཤེས་པ་ལྟ་བུར་མཐོང་ཉེན་ཡོད་པས།",
    "ཁྱེད་རང་གཞན་གྱི་བྱས་པ་རང་ངོར་འཁྱེར་བའི་རྩོམ་རྐུན་དུ་མཐོང་ངེས་ཡིན།",
    "བོད་ཡིག་ཕུན་སུམ་ཇེ་ཚོགས་དང་འཛམ་གླིང་རང་བཞིན་ཅན་དུ་འགྱུར་བའི་གོམ་པ་དང་བོའོ།",
    "དོན་གྲུབ་ཀྱིས་ཁྱེད་རང་གང་དུ་ཕེབས།",
    "ཁོང་འདུག་གམ།",
    "འཆད་ཀྱིན་འདུག་ལྟ་བུ་བདག་གཞན་གྱིས་མ་བསྡུས་པ་ཡིན་ལ།",
    "མ་ནིང་རང་ལ་རང་མི་འཇུག།",
    "ཟླས་དབྱེ་བ་དང་རང་བཞིན་གྱིས།",
    "ཞལ་ཟས་གདའ་དང་དགོས་པའི་དོན།",
    "ཀྱེ་མ་གྲོགས་དག་དུས་འདིར་བག་ཡོད་གྱིས།",
    "ངག་དེ་ཐོས་པ་ལས་ཤིང་རང་མཚན་པ་དངོས་ལ་ཐ་སྙད་འདོར་ལེན་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལ་རྒྱུ་དང་རང་བཞིན་ནོ།",
    "རྒྱུ་དང་རང་བཞིན་གཉིས་དབྱེ་བའི།",
    "མ་ནིང་རང་ལ་རང་ཞུགས་པ་མ་ཡིན་ཏེ།"
  ]
