    "ཁྱོད་རང་གིས་འདང་རྒྱོབ་ཟེར།",
    "ར་ལོས་ཐེ་ཚོམ་གྱི་ངང་ནས་གུ་རུ་སྐྱིད་ཀྱི་གདོང་ལ་གཅིག་བལྟས་པ་ན་ཁོ་མོས་མགོ་མར་སྒུར་ཞོར་ར་ལོར་རོགས་ལྟ་ཞིག་བྱས་སོང་བས་ར་ལོས་སྣབས་ཁུང་འཇིབ་ཅིག་བྱས་ནས་བློ་ཐག་རྦད་ཆོད་ཀྱིས་ང་ལ་འདང་རྒྱག་མེད།",
    "ར་ལོ་ནམ་ལངས་མ་ཐག་ཡར་ལངས་ནས་ཁ་ངོ་གཙང་མར་བཀྲུས་རྗེས་གུ་རུ་སྐྱིད་ཀྱིས་ནངས་ཇ་ཁྱེར་ཡོང་བར་རེ་ལྟོས་བྱས།",
    "འདི་ནི་ནངས་ཇ་ཡིན་ནམ་གུང་ཇ་ཡིན་པའང་མི་ཤེས་མོད།",
    "ཉིན་གུང་ཡོལ་མ་ཐག་གུ་རུ་སྐྱིད་ཀྱིས་ཁོ་བོར་གུང་ཇ་ཁྱེར་ཡོང་སྲིད་བསམ་ནས་རེ་ལྟོས་བྱེད།",
    "རེ་ལྟོས་ཀྱི་ཁྲོད་ནས་ཉི་མ་ནུབ་རིར་ཡལ།",
    "ཁྱིམ་མཚེས་ཤིག་ཡོང་ནས་ར་ལོ་དགོང་ཟས་བཟའ་རུ་འགྲོ་ཟེར་མོད།",
    "འོན་ཀྱང་ར་ལོའི་སེམས་ལ་གུ་རུ་སྐྱིད་ཀྱིས་རང་ལ་དགོང་ཟས་བསྐྱལ་ཡོང་སྲིད་པར་མ་ཟད་དེ་མུར་ཁོའི་གམ་ནས་ཞག་སྡོད་ཀྱང་བྱེད་སྲིད་པའི་སྣང་བ་ཞིག་སྐྱེས་ནས་ཁྱིམ་མཚེས་དེ་ཚང་ལའང་མ་སོང་།",
    "དེ་བས་ཀྱང་ཁེར་རྐྱང་གི་སུན་སྣང་གིས་མནར་ཏེ་ཐེངས་དུ་མར་གུ་རུ་སྐྱིད་ཀྱི་གམ་ལ་འགྲོ་རྩིས་བྱས་ནའང་གང་ལྟར་མཇུག་མཐར་ཁོས་རང་ཉིད་ཚོད་འཛིན་བྱེད་ཐུབ་སོང་།",
    "ཕྱི་ཉིན་ར་ལོ་ཡང་བསྐྱར་སྔ་མོ་ནས་ཡར་ལངས་ཏེ་ཁ་ངོ་བཀྲུས་ཤིང་རལ་བ་ཤད་རྗེས་ཁ་སང་ལས་ཀྱང་ལྷག་པའི་རེ་ལྟོས་ཆེན་པོས་སེམས་ཁམས་ཡོངས་སུ་གང་ནས་སྡོད་སྐབས་ལྕགས་ཐར་ཚང་གི་བྱིས་པ་ཞིག་གིས་ཁོ་བོར་ནངས་ཇ་བསྐྱལ་ཡོང་།",
    "ཨོརེད་རེད་ར་ལོའི་གདོང་ལ་དུས་ཡུན་རིང་བོར་ཤར་མ་མྱོང་བའི་འཛུམ་མདངས་ཤིག་ཤར་ཏེ་བྱིས་པ་དེའི་ལག་པ་ཀློད་ནས་རེདརེདལག་པ་གཉེན་སྐོར་ལ་བལྟ་རུ་སོང་བ་རེད་ཟེར།",
    "ཧ་ཅང་ཡག་པོ་ཞིག་ཡིན་ར་ལོ་དགའ་ཐག་ཆོད་དེ་བྱིས་པ་དེའི་ཨོང་ཤའི་སྟེང་ལ་ཐལ་ལྕག་གཅིག་གཞུས་པ་ན་བྱིས་པ་དེས་ངུ་མ་དགོད་ཀྱིས་ཨོང་ཤ་ཕུར་ཞོར་ཕྱིར་རྒྱུག་སོང་།",
    "ཕྱོགས་གཅིག་ནས་འཇགས་ཐབས་བྲལ་བའི་སེམས་ཁམས་ཀྱིས་གུ་རུ་སྐྱིད་དང་ལྷན་འཛོམས་བྱེད་པར་རེ་སྒུག་བྱས་ནས་ཉིན་འགའ་འགོར་བའི་ཕྱི་དྲོ་ཞིག་ལ་གུ་རུ་སྐྱིད་གཞི་ནས་ར་ལོའི་མིག་ལམ་དུ་མངོན་བྱུང་མོད།",
    "ཀ་ཕར་སོང་།",
    "ཁོའི་སྣང་བར་ཁྱིམ་འདི་དེ་སྔ་རང་གི་ཆུང་མ་ཚེ་ལས་འདས་སྐབས་ལས་ཀྱང་སྟོང་འཇགས་སེ།",
    "ཕལ་ཆེར་ཁོ་རང་ཤི་ནས་ཡུན་རིང་འགོར་སོང་བ་འདྲ།",
    "རིམ་གྲོ་རེ་ཡོད་ཀྱང་སྲིད་པས་སྒོར་མོ་བརྒྱ་ཙམ་སྐྱེ་དགོས་ཟེར།",
    "ངས་ཁོ་བོར་ལྕགས་ཐར་སྐེ་ཕྲ་ཚང་གིས་ཁྱོད་ཀྱི་རྩྭ་ས་རིན་མེད་དུ་བེད་སྤྱོད་བྱེད་མི་འོས་པས་ཁྱོད་རང་ཁོ་སར་སོང་དང་སྒོར་བརྒྱ་ཙམ་ལོས་སྟེར།",
    "གལ་ཏེ་མི་སྟེར་ན་ཕྱིར་ཤོག་དང་ངས་ཁྱོད་ལ་སྐྱི་ཞེས་བཤད།",
    "ལྕགས་ཐར་ཚང་ནས་བཙན་གྱིས་ར་ལོའི་ཕྱུགས་ཟོག་འགའ་བོ་བླངས་ཏེ་ཨ་ལགས་འབྲོང་ལ་ཕུལ་ནས་ཕྱིར་ལོག་སྐབས་སུ་སུ་ཞིག་གིས་ཨོཾ་མ་ཎི་པདྨེ་ཧཱུྃ།",
    "སྤྲིན་དེ་སྐད་ཅིག་ལ་ཇེ་ཆེར་གྱུར་པ་དང་མཉམ་དུ་གཡུ་འབྲུག་སྔོན་མོའི་ངར་སྐད་ཀྱིས་ས་གཞི་འདར།",
    "རྒྱང་རིང་གི་སྒྲ་དེ་ཉེ་བར་སླེབས་ཤིང་ཇེ་གསལ་དུ་སོང་བས་ཚིག་འབྲུ་རེ་རེ་བཞིན་གསལ་བོར་ཐོས་ཐུབ་པ་འདི་ལྟར།",
    "ཞེས་མིག་ཟུང་བཙུམས་ནས་ཤིན་ཏུ་གསལ་བའི་ངག་གིས་བཤད།",
    "ཁོང་རུ་སྐོར་རེ་རེ་དང་།",
    "གར་སོང་ཆ་མེད་དུ་གྱུར་ནས་ལོ་དགུ་འགོར་ཞིང་མི་རྣམས་ཀྱིས་འདྲེས་ཁྲིད་སོང་ཟེར་བའི་བུ་མོ་སྒྲོལ་དཀར་གྱིས་ཀྱང་བྱིས་པ་གཉིས་ཁྲིད་ནས་ཕྱིར་སླེབས་བྱུང་།",
    "ཡིན་ནའང་མཚན་མོ་སླེབས་པར་ད་རུང་ཤིན་ཏུ་རིང་།",
    "གཡང་ཤམ་བྱས་ཀྱང་པུས་མོ་མི་ཁེབས་པའི་སློག་པའི་བུ་ག་རྣམས་ལས་བཙག་བསེར་བུའི་མདའ་མོ་རང་འབབ་དང་།",
    "ནང་བཀྲེས་སྐོམ་གྱིས་མ་རངས་པའི་དབུགས་སྒྲ་ཁྲོག་ཁྲོག་ཏུ་སྒྲོག་གིན་འདུག་པས།",
    "ཁོས་ཁ་བ་སྤར་མོ་གང་མཆིང་བུར་བཅོས་ཏེ་ཁ་ནང་དུ་བཞག་མ་ཐག་སླར་ཡང་ཡོངས་རྫོགས་ཕྱིར་གཏོར།",
    "བྱང་གི་སྐར་མ་ཨ་བརྟན་དེ་ན་ཟུག་གི་སྡུག་བསྔལ་ལས་གྲོལ་མ་ཐག་པའི་མིའི་གདོང་ལྟར་མི་སྡུག་པའི་ངང་ནས་ཤར་ནའང་ས་ད་རུང་ཡོངས་སུ་ནུབ་མི་འདུག་སྐབས་འདིར་རྟ་མགྲིན་རྡོ་རྗེས་འཇབ་རྒོལ་བྱེད་སའི་དམིགས་འབེན་འདེམ་བཞིན་འདུག་སྟེ།",
    "དེའི་གམ་གྱི་ཁྱིམ་ཚང་དེར་ལུག་ཉིས་བརྒྱ་ཙམ་ཡོད་པ་དང་ས་དབྱིབས་ཀྱང་ཅུང་བཟང་མོད་སྒོ་ཁྱི་གཉིས་ཡོད་པ་དེས་ས་རུབ་མ་ཐག་ནས་ལུག་ཁྱུར་སྐོར་བ་བྱེད་བཞིན་བར་མེད་དུ་ཟུག་གིན་འདུག་སྐབས་ཤིག་རུའི་ཕར་སྣེ་ནས་ཁྱིས་སྐད་ངན་བཏོན་ཞིང་ངུ་ཟུག་བྱས་པ་དང་།",
    "སྦྲ་འགའ་རེའི་དཀར་ཁུང་ནང་ན་ད་རུང་མཚམས་རེར་གསལ་ལ་མཚམས་རེར་མི་གསལ་བའི་མེ་འོད་རེ་མཐོང་བ་ལ་བལྟས་ན་ད་རུང་འཇབ་རྒོལ་བྱེད་པའི་དུས་ཚོད་མིན་ནའང་རྟ་མགྲིན་རྡོ་རྗེ་ནི་མི་བྲེལ་བ་ཅན་ཞིག་ཡིན་པས་ཞགས་ཐག་གི་སྣེ་མོ་གཅིག་སྒྲའི་སྟེང་ལ་དམ་པོར་མདུད་ཅིང་རྟ་ལ་ཞོན་ནས་ལག་གཡོན་པས་སྲབ་སྐྱོགས་བཟུང་བ་དང་།",
    "བསམ་བཞིན་མར་བབས་ཏེ་ལུག་ཉིས་བརྒྱ་ཙམ་ཡོད་པའི་ཁྱིམ་ཚང་དེའི་ཕྱོགས་སུ་སོང་།",
    "མ་འགྱངས་པར་ཁོ་རང་ལུག་ཁྱུའི་ཉེ་སར་སླེབས་སོང་།",
    "འགྲིག་གི་འགྲིག་གི་ངེད་ཚང་གི་གླང་རྒན་དཀར་བོ་དེའི་སྐེ་ཚ་བའི་རིན་ལའང་རྐུན་མའི་རྟ་དེ་ང་ལ་བབས་འདུག།",
    "རེ་བ་ཧ་ཧ་ཧ་ཁྱེད་ཚང་གི་གླང་རྒན་དེ་ངེད་ཚང་གི་ལུག་གི་ནང་ལ་ཡོང་མེད་ན་རྟ་འདི་ཇི་ལྟར་ཐོབ།",
    "དེས་ན་འུ་གཉིས་ཀས་བགོས་ན་འགྲིག་ག་ཀྱི་ཧ་ཧ་ཧ་ཆོག་གི་ཆོག་གི་ད་ནམ་གུང་ཡང་ཡོལ་སོང་།",
    "ཁོ་ཚོའི་སྐད་ཆ་ལས་རྟ་མགྲིན་རྡོ་རྗེས་རང་གིས་ཞགས་པ་བསྐོན་པ་དེ་མ་གཞི་སྡུག་ཤི་རྒྱག་རྒྱུའི་གླང་རྒན་ཞིག་ཡིན་པ་གཞི་ནས་ཤེས་ཏེ་སེམས་ལ་ཚར་སོང་།",
    "དོན་གྲུབ་མེད་ན་རང་གིས་དོན་དག་གཅིག་ཀྱང་མི་འགྲུབ།",
    "སྒྱུག་པོས་ཀྱང་དད་ལྡན་རྣམས་ཀྱི་ཨ་གསར་དེ་རིམ་བཞིན་ཡལ་ནས་མག་པའི་ཡོང་འབབ་ཇེ་ཉུང་དུ་འགྲོ་བཞིན་ཡོད་པས་གལ་ཏེ་མུ་མཐུད་དུ་འདི་ལྟར་སོང་ན་མག་པ་འདི་ནི་ལས་ཀར་བརྩོན་པ་ཞིག་མིན་པས་མི་འགྱངས་པར་ཁོང་ཚང་ལ་ཕན་ཐོགས་པ་ཕར་ཞོག་རང་གི་ཆུང་མ་དང་ཕྲུ་གུ་རྣམས་ཀྱི་ཁ་གསོ་ཐབས་ཀྱང་དཀའ་སྙམ་ནས་ཕན་ཚུན་བར་གྱི་བརྩེ་དུང་ཡང་ཉིན་རེ་ནས་ཉིན་རེར་ཇེ་ཆུང་ནས་ཇེ་ཆུང་དུ་སོང་།",
    "རང་གི་ཤ་ཁྲག་ལས་མཆེད་པའི་ཡིད་དུ་འོང་བའི་བུ་ཕྲུག་གཉིས་ཀ་མཐོང་ཚེ་རང་ཉིད་འདི་རུ་གཏན་དུ་དམ་པོར་བཏགས་ཡོད་པ་གཞི་ནས་ཤེས་པར་བརྟེན།",
    "ཁོ་མོས་ད་དུང་འདས་པའི་ལོ་ཟླའི་ནང་གྱོང་རེག་པ་དེ་ཁ་གསབ་བྱེད་ཆེད་མུ་མཐུད་དུ་མཚེ་མ་བཙའ་རྒྱུ་ཡིན་ཟེར།",
    "ད་ལྟ་ཨ་མཆོད་དུ་འབོད་མཁན་ཡང་ཉུང་བས་ཁོས་ཉིན་ལྟར་རང་ཁྱིམ་དུ་ཁ་ཏོན་འདོན་བཞིན་མི་སྡོད་ཀ་མེད་བྱུང་།",
    "ཁྱོད་ཀྱིས་སེམས་བདེ་མོ་བྱོས།",
    "ང་ལ་ལྟད་མོར་ལྟོས་དང་ཆོག་འོ་ཁྱོད་རང་རྐང་ཐང་ལ་འགྲོ་མི་དགོས་འུ་ཚང་ལ་འདི་འདྲའི་རྟ་མང་བོ་ཡོད་པས་ཁྱོད་རང་མི་ཞོན་པར་སུ་ཞོན་ཟེར།",
    "སྙམ་སྟེ་ཕྱི་ཉིན་སྔ་མོ་ནས་སྒྱུག་པོ་ཚང་གི་རྟ་གཅིག་ཞོན་ནས་ལམ་དུ་ཆེས།",
    "ཁྱིམ་ཚང་དེ་ནི་དངོས་གནས་ནོར་ལུག་ས་སྟེང་ལ་མི་ཤོང་བའི་ཕྱུག་པོ་ཞིག་ཡིན་ཡང་རྒན་རྒོན་རྒས་འཁོགས་གཉིས་ལས་བུ་དང་བུ་མོ་གཅིག་ཀྱང་མེད་པས་འགྲུལ་བ་ངོ་ཤེས་མི་ཤེས་སུ་ཞིག་སླེབས་ཀྱང་དགའ་ནས་ཡུན་རིང་སྡོད་པའི་ཞུ་བ་བྱེད།",
    "དགོང་ཟས་ཟོས་རྗེས་གཡོག་པོ་གཡོག་མོ་རྣམས་རང་རང་གི་ཁྱིམ་ལ་བུད་སོང་།",
    "རྒན་རྒོན་གཉིས་ཀ་ཐབ་ཀའི་གཡས་གཡོན་ནས་ཉལ་རྗེས་ཕྱི་རོལ་ན་ཕྱུགས་ཟོག་གིས་སྐྱུག་ལྡེད་བྱེད་པའི་སྒྲ་མ་གཏོགས་ཡོད་ཚད་འཇམ་ཐིང་ངེར་གྱུར།",
    "དེ་ཡང་ལོ་འགའི་སྔོན་དུ་ཁོས་འདི་ཚང་ལ་གཡང་འབོད་བཏོན་ནས་འགྲོ་ཁར་རྒད་པོ་དེས་སྒམ་གཅིག་གི་ཁ་ཕྱེ་ནས་ལག་ཉོབ་ཅིག་བྱས་པ་ཙམ་གྱིས་དངུལ་སྒོར་སྤར་མོ་གང་བླངས་ཏེ་ཁོང་ལ་ཕུལ།",
    "དེ་ནས་བཟུང་ཡུན་རིང་བར་དུ་སྒམ་དེ་གཉིས་ཁོང་གི་མིག་ལམ་ནས་ཡལ་མ་ཐུབ།",
    "ཁོམ་པ་རེ་ཡོད་ན་ངེས་པར་དུ་ངེད་གཉིས་འཆི་རེག་བར་དུ་ཐེངས་གཅིག་ཕེབས་རོགས།",
    "གལ་ཏེ་གཞན་གྱིས་སེམས་ངན་བཅངས་ན་ངེད་གཉིས་ཀྱི་ལག་ནས་ཉིན་དཀར་འཕྲོག་འདོད་ཀྱང་སླ་མོ་མིན་ནམ།",
    "རང་ཁྱོད་ཀྱིས་སེམས་ཁྲལ་བྱེད་མི་དགོས།་",
    "ཟེར་ནས་བུད་སོང་།",
    "དེ་མ་ཐོག་བུད་མེད་དེའི་གདོང་ཡོངས་འཛུམ་གྱིས་ཁེངས་ཏེ་རྟ་མགྲིན་རྡོ་རྗེ་ལ་ཡང་ཡང་ཟུར་མིག་གིས་ལྟ་བ་དང་འོ་ཇ་བར་མེད་དུ་བླུགས།",
    "ཁོ་མོར་ཁྲ་ཞིང་ཆེ་བའི་མིག་ཟུང་ལྡན་པ་དང་།",
    "ཟའ་བ་དང་བདག་བདག་ཁྱོད་ཀྱིས་ཇ་འཐུང་དང་།",
    "བུད་མེད་དེས་ཆུ་ཟོ་རྒྱབ་ལ་ཁུར་ནས་སྒོར་སོང་སྟེ་ཇ་ཡུན་ཙམ་ཡང་མ་འགྱངས་པར་ཕྱིར་འོངས་ཏེ་ཝ་ཡེ།",
    "རྐེད་པ་ན་ནས་ཤི་ཐལ་ཟེར།",
    "བུད་མེད་དེས་འཛུམ་ཆུང་ཞིག་སྟོན་བཞིན་མར་སྒུར་ནས་རང་གི་སྐེད་པའི་ཨ་ལུང་ནང་གི་ལྡེ་མིག་ཅིག་བླངས་ནས་འདི་ཟེར་བཞིན་རྟ་མགྲིན་རྡོ་རྗེའི་ཕྱོགས་སུ་གཡུགས།",
    "༡༩་ རེམ་ཡ།",
    "བུད་མེད་དེས་ཟོ་ལུང་ལག་པ་གཉིས་ཀྱིས་ཅུང་ཙམ་ཡར་དེད་མ་ཐག་རྟ་མགྲིན་རྡོ་རྗེས་ལག་གི་ཟོ་བ་བཏང་བས་བུད་མེད་དེས་ཨ་ཙི།",
    "འདི་བྲེལ་བ་ལ་ཟེར་བཞིན་ཆུ་ཟོས་དྲུད་ནས་གན་རྐྱལ་དུ་ལོག་ཁོ་མོའི་མགྲིན་པ་ཟོ་ཐག་གིས་བསྡམས་པས་སྐད་རྒྱག་པ་ཕར་ཞོག་དབུགས་ཀྱང་ལེན་དེཀའ་བར་གྱུར།",
