    "ཁོང་གིས་ཕྱག་མོ་གཟིགས་རྗེས་མཱ་རཱི་ཙེ་ཐོན་དང་བར་ཆད་ཉེན་ཁ་ཅི་ཡང་མེད་གསུངས་བྱུང་།",
    "འུ་གཉིས་ནམ་ཡང་ཁོང་གིས་ཐུགས་ལ་འཛིན་རོགས་ཞུས།",
    "ཀ་ཁོ་མོའི་ངུ་ཆད་ཅིང་ཁོ་གཉིས་སླར་ཡང་ལམ་ལ་ཆས།",
    "ཡིན་ནའང་ཁོ་གཉིས་ཀྱི་རྐང་བ་རིམ་བཞིན་ཇེ་ལྗིད་དུ་སོང་ནས་འདེགས་དཀའ་བ་དང་ལུས།",
    "ཡོངས་ཀྱི་ཤེད་ཤུགས་ཚར་ཞིང་ལྷུ་ཚིགས་ཚང་མར་ན་ཟུག་སྐྱེས་ནས་མྱུར་ཚད་ཇེ་དལ་དུ་སོང་།",
    "ཟླ་བ་ནུབ་རི་དང་ཇེ་ཉེར་སོང་ཞིང་ཁོ་མོ་ཁོའི་རྗེས་སུ་ལུས།",
    "རྒྱང་ཕྱོགས་ནས་སྤྱང་ཀི་ཞིག་གིས་རྣ་ལ་གཟན་པའི་ངུ་ཟུག་ཅིག་བྱས་པ་དང་ཁོ།",
    "མོ་ཇེ་མགྱོགས་ལ་སོང་།",
    "ཁོས་ཀྱང་ཁོ་མོར་སྒུག་བསྡད་ནས་ཁོ་མོའི་རྡོག་ཕྲེས་ཆུང་ཆུང་དེའང་བླངས་ནས་རང་གིས་ཁུར་པ་ན་ཁོ་མོའི་རྐང་པ་ཟུང་ཇེ་ཡང་ལ་སོང་བའི་སྣང་བ་ཞིག་སྐྱེས་ནས་སྔར་ལས་ཇེ་མགྱོགས་སུ་སོང་།",
    "ར་མ་ང་རང་འདི་འདྲ་མྱུར་བའི་ངང་ནས་འདི་འདྲའི་ལམ་ཐག་རིང་བོ་ཞིག་ལ་སོང་བ་ཐེངས་དང་བོ་ཡིན།",
    "སྤྱིང་ཀི་ཞིག་གིས་ངུ་ཟུག་ཅིག་བྱས་མ་ཐག་སྤྱང་ཀི་མང་བོས་ཨ་ལན་སྟེར་བ་བཞིན་ངུ་ཟུག་བྱས།",
    "རྐང་ལག་ཙམ་ཡང་འགུལ་འདོད་མེད་པའི་ཁོ་མོ་ཤེས་མེད་ཚོར་མེད་ངང་ཁོའི་གམ་ལ་བཅར།",
    "ཀྱང་རིམ་བཞིན་ནམ་ལངས་ནས་ཉི་མ་ཤར་བ་དང་ང་ཚོས་ད་གཟོད་ཁོ་གཉིས་གསལ་བོར་མཐོང་ཐུབ་སྟེ།",
    "སྐམ་ཞིང་རིད་པའི་ངོ་སྨད་ལ་ད་རུང་ཡོངས་སུ་སྦོམ་པོར་གྱུར་མེད་པའི་ཁ་སྤུ་ཐར་ཐོར་རེ་སྐྱེས་ཡོད།",
    "ཡིན་ནའང་རིང་བོ་འགྲོ་མ་དགོས་པར་ཉག་ག་ཆུང་ཆུང་ཞིག་གི་ཕ་རོལ་ལ་བུད་མ་ཐག་འཚེར་རྙིང་ཞིག་མཐོང་བ་དང་།",
    "བདེ་དང་འ་ཀྱ་ཁོས་རྡོག་ཕྲེས་ནང་གི་རང་ཉིད་ཀྱིས་སླ་ང་རུ་འབོད་པ་དང་དོན་དངོས་སུ་ཡུ་བ་མེད་པའི་ལྕགས་ཐོམ་ཞིག་ཡོད་པ་དེའི་ནང་ལ་ཆུ་གང་བླངས་ནས་ཡོང་དུས་ཁོ་མོས་ཀྱང་ཐུ་བའི་ནང་ལ་ཨོང་བ་འགའ་བཏུས་ཡོང་སྟེ་ཐབ་ཀའི་གམ་ལ་བླུགས།",
    "ཁོས་ཐོག་མར་རྭ་ཙེར་མེ་བསྒོས་ནས་འགའ་འཐེན་རྗེས་ཨོང་བ་རྡོག་གཅིག་ཚག་མགོར་གཏུག་ནས་ཤུགས་ཀྱིས་སྤུར་བ་ན་དུ་བ་སྔོ་ལྷོག་ལྷོག་འཕྱུར་བ་དེ་ཁོ་མོར་བྱིན་པ་དང་།",
    "ཁོ་མོས་སེམས་ཆུང་སྒོས་དེ་ཐབ་ཀའི་ནང་དུ་བཞག་ནས་སྟེང་ལ་ཨོང་བ་འགའ་སྒྲིག་རྗེས་ཐབ་ཀའི་བུ་ག་གཅིག་ནས་རིམ་བཞིན་ཕུ་བརྒྱབ།",
    "ཆལ་ཀོ་བ་ཀུའོ་ཁོས་རྡོག་ཕྲེས་ནང་གི་དངོས་རྫས་རྣམས་ཕྱིར་ལེན་ཞོར་གལ་ཏེ་ད་རུང་ཉིན་བཅུ་ལྷག་རིང་བྲོ་ག་སློང་ས་ཞིག་ལ་མ་འཕྲད་ནའང་འདང་རྒྱག་མེད་ཟེར།",
    "མང་བོ་ལེན་མ་ཕོད་ཁོ་མོས་ངུ་ངག་གིས་ཤུལ་ན་ཁོང་གཉིས་ལའང་མང་བོ་མེད་ཟེར་ནས་སླར་ཡང་ངུས་བྱུང་།",
    "བལ་བ་ག་པའི་ཁྱོད་ཀྱིས་ཁྱེར་ཡོང་མི་འོས།",
    "ད་ཡིག་ཀ་བ་ཁོ་མོའི་ངུ་ཆད་ཅིང་ཁ་གདང་སྟེ་ཕྱི་ཕྱོགས་སུ་བལྟས་ནས་ཡུན་རིང་བསྡད་རྗེས་ལྟོས།",
    "ཁོས་ཁོ་མོའི་མིག་གིས་ཅེར་ཕྱོགས་ཏེ་ཁོང་གཉིས་ཡོང་ལམ་ལ་བལྟས་ཚེ་ཉག་ཁ་དེ་ན་མེ་མདའ་ཁུར་བའི་རྟ་ཞོན་གསུམ་གྱིས་རྟ་ཁ་འཐེན་ནས་ཁོང་གཉིས་ཀྱི་ཕྱོགས་སུ་བལྟས་འདུག་པས་ཁོ་རང་ཡང་ཡུད་ཙམ་ལ་ཧ་ལས་པ་དང་།",
    "ངོ་གདོང་ཡོངས་ལ་ཐལ་བ་སྐུས་ཤིག་ཟེར།་",
    "ོ་སྟོང་དཔོན་རེད་ཟེར།",
    "༡ ཀར་ཀཋ་ཀ་བློ་ཁང་ང་བ་མང་བ་གས་སྟོང་དཔོན་ཁོ་གཉིས་ཀའི་གམ་ལ་སླེབས་ནས་ཁོ་མོའི་གདོང་ལ་ཡུན་རིང་ཅེར་རྗེས་ད་གཟོད་འགྲམ་ཤ་གཉིས་ཀ་འགུལ་ཙམ་འགུལ་ཙམ་བྱས་ཤིང་གཞི་ནས་ཧ་ཧ།",
    "དེ་མ་གཞི་འབྲོང་ཚང་གིས་འུ་གཉིས་ཀ་གཡོ་ཚོང་བྱས་སོང་ཁོས་སྐད་དམའ་མོས་དེ་ལྟར་བཤད།",
    "སླར་ཡང་སྨྱོན་པ་བཞིན་ཁོའི་རུམ་ཕྱི་ནང་ཞིབ་མོར་སློག་ཅིང་སྐབས་ཤིག་མིག་ཟུང་སྔར་ལས་ཇེ་ཆེར་གྱུར་ནས་འགུལ་ཙམ་ཡང་མི་བྱེད་པར་ཡུད་ཙམ་བསྡད་རྗེས་ཧ་ཅང་སེམས་ཆུང་སྒོས་ལག་པ་ཕྱིར་བླངས་ནས་སྤར་ཁ་ཕྱེས་པ་ན་དྲོད་ལམ་ལམ་བྱེད་པའི་དངུལ་སྒོར་གཅིག་ཡོད།",
    "སྟོང་དཔོན་གྱིས་ཧ་ཅང་བྱང་ཆ་ལྡན་པའི་ངང་ནས་དངུལ་སྒོར་དེ་མཐེ་བོང་དང་གོང་མཛུབ་བར་ལ་བཟུང་སྟེ་ཕུ་ཞིག་བརྒྱབ་མ་ཐག་རྣ་རྩར་ཁྱེར་ནས་ཡུད་ཙམ་ཉན་རྗེས་མིག་ཟུང་ཇེ་ཆུང་དུ་གྱུར་ཞིང་འཛུམ་མདངས་ཅུང་ཙམ་རྒྱས་བཞིན་རང་གི་རུམ་ལ་བཅུག་ནས་མུ་མཐུད་དུ་ཁོ་རང་སྔོག་བཤེར་བྱས་ཀྱང་ད་ཐེངས་ཅི་ཡང་མ་རྙེད།",
    "གལ་ཏེ་ཁྱོད་ལ་ད་རུང་དངུལ་སྒོར་གཅིག་ཡོད་ན་ངས་ཁྱོད་སྲོག་ཐར་བཏང་ཆོག་སྟོང་དཔོན་ཧ་ཅང་ཡིད་ཕམ་ཞིང་ཐབས་ཟད་ནས་དེ་ལྟར་བཤད།",
    "ཀ་ཀཱ་ཨ་ལགས་འབྲོང་གི་ལག་ན་ང་ལ་དངུལ་སྒོར་གཅིག་ཡོད་ཁོ་རང་ཁོང་ཁྲོ་ལངས་ནས་འདར་སིག་སིག་བྱེད་ཞོར་ངས་དེ་འབྲོང་གི་ལག་ནས་མི་སྐྱུར་ལ་ཁྱོད་ལའང་མི་སྟེར་ཟེར།་",
    "སྤྲང་ཕྲུག་འདི་ཕྱིར་ཁྲིད་ནས་གཡོག་པོ་བྱེད་དུ་བཅུག་ན་མི་བཟང་ངམ་སྟོང་དཔོན་གྱི་འཁོར་ཞིག་གིས་ཀྱང་དེ་ལྟར་བཤད།",
    "བ་བཞིན་རེད་ཡ།",
    "ཁོ་མོ།",
    "ཁར་དེད་ཁོ་མོའང་རྐང་ཐང་དུ་འགྲོ་རུ་ཆུག་བུད་མེད་ཀྱིས་སྡུག་མ་མཐོང་ན་སྐྱིད་མི་ཤེས།",
    "སྐད་ཆ་ཚིག་གཅིག་རེ་དང་ཧབ་ཆ་ཐག་ཐག་རེ་བྱེད་ཞོར་ཁོ་གཉིས་ཀྱི་རྗེས་ནས་དེད་ཡོང་།",
    "ཁོ་མོའི་མཛེས་པའི་མིག་ཟུང་རྐྱང་བའི་སྟེང་ལ་མཆི་མའི་རྒྱན་གྱིས་མཐོང་ལམ་བཀག་པས་སར་འགྱེལ་ཞོར་དང་ཡར་ལངས་ཞོར་བྱས་ནས་སོང་བ་དང་།",
    "ད་ག་མ་སྤྲང་ཕྲུག་རེམ་པར་སོང་སྟོང་དཔོན་གྱིས་རྟ་ལྕག་གནམ་ལ་ཕྱར་ནས་མུ་མཐུད་དུ་ཁོ་རང་ཕྱུགས་ཟོག་ལྟར་དུ་དེད།"
  ]
