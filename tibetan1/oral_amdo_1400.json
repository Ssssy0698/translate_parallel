    "ཁྱོད་ཚོ་འདིར་ཅི་བྱེད་དུ་ཡོང་བ་ཡིན་ཟེར།",
    "དོན་གྲུབ་ཀྱིས་བུད་མེད་ཚོའི་ནང་ལ་བལྟས།་",
    "སྣ་སྣེ་ན་སྣ་ཆུ་ཞིག་མགོ་འདར་བའི་འགྲོས་དང་བསྟུན་ནས་ཕར་གཡོ་ཚུར་གཡོ་བྱེད་ཀྱིན་འདུག་ལག་ཏུ་ཅ་ནེ་ཞིག་བཟུང་ཡོད་པ་ཕལ་ཆེར་གྲོ་མས་གང་ལ་ཁད་ཡོད་ན་ཡང་མིག་གིས་གསལ་བོ་ཞིག་མ་མཐོང་བས་ས་རྡོ་མང་བོ་གྲོ་མར་འཁྲུལ་ནས་བཏུས་འདུག་དོན་གྲུབ་ཀྱིས་མ་བཟོད་པར་མི་ཚོགས་ཀྱི་དཀྱིལ་དུ་བརྒྱུགས་ཤིང་རྟ་མགྲིན་རྡོ་རྗེའི་ཨ་མའི་མགྲིན་པར་འཁྱུད་དེ་ཨ་མ་ལགས་ཨ་མ།",
    "ད་ནས་བཟུང་ང་རང་ཁྱོད་ཀྱི་བུ་ཡིན།",
    "ཨ་མ་ཟེར་ཞིང་།",
    "སླར་ཡང་ལྷ་མོའི་ལག་པར་འཇུས་ཏེ་སྲིང་མོ།",
    "ད་ནས་བཟུང་ང་ཁྱོད་ཀྱི་ཕུ་བོ་ཡིན།",
    "ངའི་ཨ་མ་ཡ་ངའི་སྲིང་མོ་ཡ་འུ་ཅག་ཚར་སོང་ཞེས་སྐྱོ་གདུང་ཆེན་པོས་ངུ་བཞིན་རང་གི་བྲང་ཁར་ཁུ་ཚུར་གྱིས་བར་མེད་དུ་གཞུས།",
    "རྒན་མོའི་ལག་གི་ཅ་ནེ་ས་ལ་ལྷུང་བ་དང་།",
    "རྒྱལ་བ་དེ་དག་རྟ་མགྲིན་རྡོ་རྗེའི་སྣང་བར་རང་གི་ཞི་མོའི་མཉེན་ཞིང་ཆུང་བའི་ལག་པས་ཁོའི་གདོང་དང་མགོ་ལ་ཕུར་ཕུར་བྱེད་པ་དང་འདྲ་ལ།",
    "སྙམ་བཞིན་ཡར་དགྱེས་ཏེ་འཕག་ར་ཞིག་བྱས་པ་དང་ཤེས་ཚོར་ཡོངས་སུ་ཉམས་སོང་།",
    "དུས་ཡིན་རིང་བོ་ཞིག་འགོར་བའི་མཚམས་ལ་ཁོའི་སྣང་བར་སླར་ཡང་རང་གི་ཁྱི་དང་དཀར་དེས་ཡིད་སེམས་སྐྱོ་བའི་ངུ་ཟུག་བྱེད་པའི་སྐད་སྒྲ་དམའ་མོ་ཞིག་ཚོར།",
    "ཐོག་མར་དེ་ནི་ཧ་ཅང་རྒྱང་ཐག་རིང་བའི་ཡུལ་ཞིག་ཡིན་པ་འདྲ་ཡང་རིམ་བཞིན་ཇེ་ཉེ་དང་ཇེ་གསལ་དུ་སོང་།",
    "གལ་ཏེ་ཁྱོད་རང་སྟབས་ལེགས་ནས་ཝ་མོ་ཞིག་དང་ཕྲད་ཚེ་ཁྱི་འདིས་བ་སྤུ་སྤུར་བའི་ནུས་པ་ཙམ་ཡང་འདོན་མི་དགོས་པར་འཛིན་ཐུབ་པར་མ་ཟད།",
    "ཁྱི་འདི་ནི་ནམ་རྒྱུན་རང་གི་བདག་པོ་ལ་ལུས་དང་གྲིབ་མ་ལྟར་མི་འབྲལ་བ་ཞིག་སྟེ།",
    "རྟ་མགྲིན་རྡོ་རྗེས་དང་དཀར་གྱི་མགོ་ལ་བྱིལ་བྱིལ་འགའ་བྱས་རྗེས་ད་གཟོད་རང་གི་ལག་པ་འགུལ་རྒྱུ་ཡོད་པ་ཚོར་ནས་ལག་པ་གཉིས་ས་ལ་བརྟེན་ཏེ་ཡར་དགྱེ་རྩིས་བྱས།",
    "ང་ལ་ཅི་བྱུང་སོང་།",
    "སྐབས་དེར་ཁྱི་དང་དཀར་གྱིས་ཅ་ནེའི་ཁ་ལ་སོ་བཏབ་ནས་ཁྱེར་ཡོང་སྟེ་ཁོའི་གམ་ལ་བཞག་ཁོས་ཇ་ལྷག་དེ་ཧུབ་གང་འཐུངས་པས་དེ་མ་ཐག་རིག་པ་ཇེ་གསལ་དུ་སོང་བ་དང་སྨྲ་མི་ཤེས་པའི་སྡུག་བསྔལ་དེའང་ལྡབ་འགྱུར་གྱིས་ཇེ་ཆུང་དུ་སོང་བས་སླར་ཡང་ཡར་དགྱེ་རྩིས་བྱས་ཀྱང་སྔར་ལྟར་ཕམ་ཞིང་མགོ་བོའང་གཟེར་ནས་བཟོད་མི་ནུས་པར་གྱུར།",
    "ཁོས་རིམ་བཞིན་ལག་པ་ཡར་བཀྱགས་ནས་མགོ་ལ་རེག་དུས་ལྕི་བ་རློན་པ་ཉི་མས་བསྐམས་པ་ལྟ་བུའི་དངོས་པོ་ཞིག་གིས་མགོ་བོ་ཡོངས་རྫོགས་དཀྲིས་ཡོད་པའི་ཚོར་སྣང་སྐྱེས།",
    "གང་ལྟར་ད་ཐེངས་དོན་དག་ཡ་མཚན་ཞིག་བྱུང་སོང་།",
    "འདི་ཐམས་ཅད་ང་རང་ཉིད་ལན་པ་རེད།",
    "སྔར་ཁོ་རང་རྟ་ནོར་ལུག་གི་དོན་དུ་སྲོག་འཆོར་བར་སྐྲག་མྱོང་མོད།",
    "སྐབས་འདིར་ཁོས་རང་སྲོག་ཆུ་ཁམ་གང་གི་དོན་དུ་འབུལ་དགོས་ཀྱང་སྐྲག་སྣང་སྤུ་ཙམ་ཡང་མེད་པའི་སྣང་བ་ཞིག་སྐྱེས།",
    "ཁྱོད་མོད་པོར་ཡོད་དུས་རིན་མི་དགོས་ཤིང་དཀོན་དུས་གསེར་དང་དངུལ་ལས་ཀྱང་རྩ་ཆེ།",
    "ཁོས་དེ་ལྟར་སྙམ་བཞིན་མཆིལ་མ་ཞིག་མིད་རྩིས་བྱས་ཀྱང་ཁ་ནང་ཡོངས་རྫོགས་བསྐམས་འདུག་ཁོ་རང་ཐབས་ཟད་འུ་ཐུག་ནས་ཡང་བསྐྱར་ཅ་ནེ་ལག་ལ་བླངས་ཏེ་ཞབས་ན་ཇ་ལོ་རློན་པ་འགའ་ལུས་ཡོད་པ་ལྕེ་སྟེང་ལ་བླངས་པ་དེས་ཁོའི་སྐོམ་པ་སྔར་ལས་ཇེ་དྲག་ཏུ་བཏང་བའི་སྣང་བ་ཞིག་སྐྱེས་པས་ཅ་ནེ་སར་གཡུགས་ཏེ་སྡུག་བསྔལ་གྱི་འཁུན་སྒྲ་ནར་ནར་ཕྱུང་བ་ན་ཁྱི་དང་དཀར་གྱིས་ཀྱང་སྐད་ངན་འབྱིན་བཞིན་བྲག་ཁུང་ནང་ནས་ཡར་རྒྱུག་མར་རྒྱུག་བྱས་ཤིང་མཚམས་ཤིག་ལ་ཅ་ནེའི་ཁར་སོ་བཏབ་ནས་ཕྱི་རོལ་ཏུ་ཁྱེར་སོང་།",
    "ཁོས་རིན་ཐང་བྲལ་བའི་ཆུ་དེར་ཧུབ་གཅིག་བྱས་ནས་གྲོན་ཆུང་བྱེད་དགོས་སྙམ་མོད།",
    "མཆུ་ཆུ་དང་འཕྲད་མ་ཐག་ཚོད་མ་ཟིན་པར་དབུགས་ཐེངས་གཅིག་གིས་ཡོངས་རྫོགས་འཐུངས་ཚར།",
    "ཡང་ན་ལྕེ་ཕྱིར་བསྣར་ནས་དབུགས་ལྷེམ་ལྷེམ་དུ་གཏོང་ལེན་བྱེད་མོད།",
    "ད་ལྟ་ཁོ་རང་སྐད་ཅིག་ཙམ་ལའང་བག་ལྷོད་དུ་མི་སྡོད་པར་སྐབས་འགར་བྲག་ཁུང་གི་སྒོ་ཁར་འབུད་པ་དང་།",
    "ད་ཐེངས་དང་དཀར་གྱིས་ཅ་ནེ་ལ་སྣོམ་སྣོམ་ཞིག་བྱས་རྗེས་མགོ་འཁྱོག་ནས་ལྟ་ཙམ་བྱས་ནས་སྔར་གནས་སུ་བསྡད།",
    "བདག་པོས་མུ་མཐུད་དུ་ཅ་ནེ་ཕར་བསྲིངས་མོད་དང་དཀར་ཕྱི་ནུར་ཞིག་བྱས་ནས་བསྡད་པས་བདག་པོ་ཧ་ལས་ཏེ་འདི་ཅི་ཡིན་ནམ།",
    "ཁོང་གིས་ང་རང་ཐུགས་ནས་འདོར་མི་སྲིད་པས།",
    "རང་ཉིད་གཉེན་མིར་མཇལ་བའི་རེ་བ་ལོས་ཡོད།",
    "སླར་ཡང་མུ་མཐུད་དུ་དེ་ཡང་འཆི་བ་ཞེས་བྱ་བ་དེ་ཁྱོད་གཅིག་པུ་ལ་བྱུང་བ་མ་ཡིན།",
    "འདས་པོ་ཁྱོད་ཀྱི་མནའ་བཅད་ཡིན་ན་ངའི་བཟང་ས་ཡང་ཡིན།",
    "འདི་ལྟར་བྱས་ན་ཁྱོད་ཀྱིས་ང་གཞན་མིར་རྩིས་པ་མིན་ནམ།",
    "ཡིན་ནའང་རང་ཉིད་གཉིད་དུ་ཡུར་མ་ཐག་རྟ་མགྲིན་རྡོ་རྗེའི་མགོ་སྐྲ་གཟེངས་ཤིང་མཆེ་བ་སེར་པོ་སོར་ལྔ་ཙམ་གཙིགས་བཞིན་འོངས་ནས་ཁོ་རང་ལ་མཛུབ་མོ་བཙུགས་ཤིང་ཧབ་ཆ་བརྒྱབ།",
    "སྐབས་འགར་ཀེང་རུས་ཤིག་གིས་ཁོའི་མགོ་ལ་ལག་སྙོབ་བྱས་པས་ཁོས་སྡུག་སྐད་བརྒྱབ་ཅིང་གཉིད་ལས་སད་ནའང་འཇིགས་སུ་རུང་བའི་གཟུགས་བརྙན་དེ་དག་ཡུན་རིང་བར་དུ་མིག་ལམ་ནས་ཡལ་ཐབས་བྲལ།",
    "ལྷོད་འཇམ་གྱིས་གྲག་ན་ལྟས་བཟང་དུ་བརྩིས་ཏེ་གཡང་བྱ་ཟེར་བཞིན་མར་རྡོག་རེ་འཕེན་སྲིད།",
    "རྟ་མགྲིན་རྡོ་རྗེས་ཕོ་རོག་དེ་གཉིས་མཐོང་བས་རང་གི་ཁ་ཏོན་ཡུན་རིང་ཆད་པ་ཡིད་ལ་དྲན་ཞིང་དེ་མ་ཐག་སྐད་གསང་མཐོན་པོས་མྱུར་མཛད་མ་འདོན་རྩིས་བྱས་ཀྱང་མགོ་ནང་ལ་ཟུག་གཟེར་རྒྱུག་ནས་ངག་མ་འཁྲོལ་བས་ཁ་མུར་མུར་བྱེད་པ་ལས་ཐབས་མ་བྱུང་མོད་སེམས་ན་ཚིག་འབྲུ་རེ་རེ་གསལ་ལེར་འདུག་སྟེ།",
    "ནག་པོ་ཆེན་པོ་སྟག་གི་ཤམ་ཐབས་ཅན།",
    "འོན་ཀྱང་ད་ཐེངས་ཉིན་ཅི་ཙམ་ལ་ཆད་སོང་བ་མི་ཤེས།",
    "དེ་བས་ཁྱོད་རང་སྔ་མོ་ནས་ཕྱིར་ཡུལ་ལ་སོང་དང་ང་ཉིན་འགའི་རྗེས་ནས་སླེབས་ཡོང་།",
    "དེའི་རྗེས་སུ་ཁོ་ནི་དགོང་མོ་ཆང་འཐུངས་ནས་ར་བཟི་བར་གྱུར་བའི་མིས་སྔ་མོ་ཕྱིར་འདང་རྒྱག་པ་ལྟར་དེའི་རྗེས་ནས་ཅི་ཞིག་བྱས་པ་དང་།",
    "གང་ལྟར་ཁོ་གཉིས་ར་མདའ་འམ་ཇག་རྐུན་ཞིག་གི་ལག་ལ་ཤོར་བ་ཁོ་ཐག་རེད་བསམས།",
    "ཏ་ཀ་རྒྱུན་མནའ་མཆེད་དོན་གྲུབ་ཀྱི་རྐང་པ་བཅད་པ་ནས་བཟུང་ཁོ་རང་གི་དོན་དག་གཅིག་ཀྱང་གྲུབ་མ་མྱོང་།",
    "དོན་གྲུབ་ནི་བློ་རིག་ལྡན་ཞིང་ཐབས་བཀོད་ཆེ་བའི་མི་ཞིག་ཡིན་པས་ཁོ་གཉིས་ཉེན་ཁ་མང་བོ་བརྒྱུད་མྱོང་ནའང་དོན་དག་ཕལ་ཆེར་བདེ་བླག་ངང་གྲུབ་སོང་།",
    "ཁོའི་ཡིད་ལ་དོན་གྲུབ་དང་མཉམ་དུ་བརྒྱུད་མྱོང་བའི་ཉེན་ཁ་ཆེ་ཞིང་དགོད་བྲོ་བའི་དོན་དག་རེ་རེ་བཞིན་ཤར།",
    "ཆེས་ཉེན་ཁ་ཆེ་ཞིང་དགོད་བྲོ་བ་ཞིག་ནི་ལོ་འགའི་སྔོན་ཁོང་གཉིས་ཇག་ལ་སོང་ནས་ཉིན་འགའ་རེ་འགོར་ཡང་ལག་ཏུ་ཅི་ཡང་མ་ཐོབ་པར་མ་ཟད་བྲོ་ཁའང་ཚར་སོང་།",
    "འ་སྦྲའི་སྒོ་ཐུ་གཉིས་ཀ་གཡས་གཡོན་དུ་བརྐྱངས་འདུག་སྒོ་ཁྱི་ཞིག་གིས་ཁ་སྦུབ་ཏུ་ལག་པོ་གཉིས་མདུན་ལ་བསྲིངས་ནས་རྒྱུ་སྣེ་རེ་ཨེ་རེག་སྙམ་བཞིན་པ་མེ་འོད་འོག་ནས་གསལ་བོར་མཐོང་ཐུབ།",
    "མི་རྣམས་སྒོར་བུད་མ་ཐག་ཁྱོད་ཀྱིས་ནང་ཁྲོལ་ཀོ་ཏའི་ནང་ལ་བླུགས་ནས་བྲོས་དང་ང་སླེབས་ཡོང་།",
    "འོང་བ་ག་རེད།",
    "མི་རྣམས་ངོ་མཚར་བའི་ངང་ནས་སྒོར་བརྒྱུགས་ཤིང་ཁྱི་མང་བོའི་ཟུག་སྐད་དང་མི་མང་བོའི་ཀི་སྒྲས་འུར་འུར་ཟིང་ཟིང་བྱེད་པའི་སྐབས་དེ་དང་བསྟུན་ནས་རྟ་མགྲིན་རྡོ་རྗེ་ཁྱིམ་ལ་འཛུལ་ཏེ་ཤ་གཞོང་བ་གང་བོ་ཀོ་ཏའི་ནང་དུ་བླུགས་ཏེ་སྦྲ་འདབས་ནས་ཕྱིར་འཛུལ་སོང་།",
    "བྲག་ཁུང་གི་ངོ་ནས་ཐིགས་ཆུ་འཛག་པའི་གནས་ཇེ་མང་དུ་སོང་།",
    "མདང་དགོང་ཆར་བ་ཆེན་པོ་ཞིག་བབས་སོང་།",
    "སྔ་མོ་རྟ་མགྲིན་རྡོ་རྗེ་བྲག་ཁུང་སྒོ་ཁར་གཅིན་པ་གཏོང་དུ་སོང་དུས་གནམ་ངོ་དྭངས་ཤིང་ཉི་འོད་མཚར་སྡུག་ལྡན་ལ།",
    "སླར་ཡང་གང་ལྟར་མ་རྒན་འཆི་རེག་བར་ངོ་གཅིག་འཕྲད་དགོས་སྙམ་ནས་ཨམ་གཙིགས་བསྡམས་ཏེ་སྐ་རགས་བཅིངས།",
    "ཅ་ནེ་རུམ་ལ་བཅུག་ཅིང་བྲག་ཁུང་ནང་ཡོངས་ལ་ཞིབ་ལྟ་ཞིག་བྱས་དུས་རི་བོང་དང་འཕྱི་བའི་མགོ་སུག་སྤུ་འབྱར་བའི་པགས་པ་ག་རེ་གོ་རེ།",
    "མ་ཁོ་རང་མི་ཡུལ་དུ་སྐྱེས་པ་ནས་བཟུང་ལྟོགས་སྐོམ་དང་གཟུགས་དང་གྲིབ་མ་བཞིན་དུ་ཁ་གྱེས་མ་མྱོང་ན་ཡང་ས་ཆ་འདིའི་ལུགས་སྲོལ་ལྟར་སྔོན་ཆད་ཁོས་འཕྱི་བའི་ཤ་ཁམ་གང་ཟོས་མྱོང་བ་ཕར་ཞོག་ཁོལག་པས་ཀྱང་རེག་མ་མྱོང་།",
    "ད་ལྟ་རང་གི་ལུས་ལའང་དྲི་མ་དེ་བྲོ་བ་རང་གིས་ཀྱང་ཚོར་ཐུབ།",
    "འོན་ཀྱང་དེ་སྔ་མོ་ནས་ཕྱི་རོལ་ཏུ་སོང་ནས་ད་རུང་ཕྱིར་མ་འོངས་པས་ཁོས་སྔར་བཞིན་བསྒུགས་ནས་བསྡད།",
    "གང་ལ་འག་ལ་ཉི་མ་ནུབ་ནས་སྐར་མ་ཤར་མོད་ཁྱི་དང་དཀར་དེ་ད་དུང་ཕྱིར་མ་སླེབས།",
    "ཁོ་ལྟོགས་དྲགས་ནས་བྲག་ཁུང་སྒོར་བུད་ཅིང་སླར་ཡང་བྲག་ཁུང་ནང་ལ་འཛུལ།",
    "ཁོ་རང་གཞི་ནས་རེ་ཐག་ཆད་དེ་ཡུལ་ཕྱོགས་སུ་སོང་།",
    "ལམ་བར་དུ་ཁོས་སློང་མོ་བྱས།",
    "ཕར་སོང་ཟེར།",
    "མང་ཆེ་བས་ང་རང་ཁྱོད་ལས་ཀྱང་དབུལ་ཟེར།",
    "ཟོག་རྫི་དེ་དག་གིས་གཡག་ལ་ཡོབ་རྡུང་བྱེད་བཞིན་མྱུར་དུ་ཚུར་ཡོང་།",
    "འོན་ཀྱང་མི་ངོ་མཐོང་བའི་ས་ནས་རེ་རེས་ཐེ་ཚོམ་གྱིས་གཡག་སྣ་འཐེན་པ་དང་།",
    "ལ་ལས་ཁོ་ལ་རྐང་བ་གཅིག་ལས་མེད་ལ་དེ་ནི་ལྕགས་ཀྱིས་གྲུབ་པ་ཞིག་རེད་ཟེར་བ་དང་ཙ་ཚེ།",
    "ཁྱོད་ཁྱོད་ཚུར་མ་ཡོང་།",
    "རྟ་མགྲིན་རྡོ་རྗེས་གོམ་མཚམས་བཞག་སྟེ་ཁ་གདངས་ནས་རང་གི་མགྲིན་པ་མཛུབ་མོས་བསྟན།",
    "ཡིན་ནའང་ཁྱོད་རང་འཇིག་རྟེན་འདི་རུ་ཡོད་དུས་མི་ལས་དགུ་ལས་གང་མང་བྱས་པས་ངས་ཀྱང་ཁྱོད་འདྲེན་མ་ཐུབ་པ་འདྲ།",
    "ཁྱོད་ཀྱི་ལས་འདི་ངན་པ་ལ་དོན་གྲུབ་སྐད་གསང་མཐོན་པོས་ངུ་བཞིན་ཁྱོད་རང་དངོས་གནས་མི་ཡིན་ནམ་འདྲེ་ཡིན་ཡ་ཟེར།",
