    "འདི་ལྟར་དེས་གང་ལ་བསླབ་པར་བྱ་བའི་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་དེ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "ཅིའི་ཕྱིར་ན་རེག་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་མྱིག་གི་རྣམ་པར་ཤེས་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་མྱིག་གི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་རྣ་བའི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་སྣའི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ལྕེའི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "ཅིའི་ཕྱིར་ན་རེག་པ་ཡང་དག་པར་༺འབུམ་ཆ་",
    "ཅིའི་ཕྱིར་ན་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་།",
    "མྱིག་མྱིག་གིས་སྟོང་ངོ།",
    "རེག་རེག་གིས་སྟོང་ངོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་མྱིག་གི་རྣམ་པར་ཤེས་པས་སྟོང་ངོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་མྱིག་གི་འདུས་ཏེ་རེག་པས་སྟོང་ངོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་༺འབུམ་ཆ་",
    "རྣ་བའི་འདུས་ཏེ་རེག་པས་སྟོང་ངོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་སྣའི་འདུས་ཏེ་རེག་པས་སྟོང་ངོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལྕེའི་འདུས་ཏེ་རེག་པས་སྟོང་ངོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པས་སྟོང་ངོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པས་སྟོང་ངོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བ་མྱིག་གི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བས་སྟོང་ངོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བ་རྣ་བའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བས་སྟོང་ངོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བ་སྣའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བས་སྟོང་ངོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བ་ལྕེའི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བས་སྟོང་ངོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བ་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བས་སྟོང་ངོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བ་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་ལས་སྐྱེས་པའི་ཚོར་བས་སྟོང་ངོ།",
    "སྐྱེ་མཆེད་དྲུག་སྐྱེ་མཆེད་དྲུག་གིས་སྟོང་ངོ།",
    "རེག་པ་རེག་པས་སྟོང་ངོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱིས་སྟོང་ངོ།",
    "རེག་སྟོང་པ་ཉིད་ཀྱིས་རེག་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "མྱིག་གི་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ཀྱིས་མྱིག་གི་རྣམ་པར་ཤེས་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཀྱིས་མྱིག་གི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཀྱིས་རྣ་བའི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "སྣའི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཀྱིས་སྣའི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "ལྕེའི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཀྱིས་ལྕེའི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཀྱིས་ལུས་ཀྱི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཀྱིས་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཀྱིས་མྱིག་གི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཀྱིས་རྣ་བའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཀྱིས་སྣའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཀྱིས་ལྕེའི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཀྱིས་ལུས་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཀྱིས་ཡིད་ཀྱི་འདུས་ཏེ་རེག་པའི་རྐྱེན་ཀྱིས་ཚོར་བ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "རེག་པ་སྟོང་པ་ཉིད་ཀྱིས་རེག་པ་སྟོང་པ་ཉིད་ཡང་དག་པར་རྗེས་སུ་མྱི་མཐོང་ངོ།",
    "རང་གི་མཚན་ཉིད་སྟོང་པ་ཉིད་ཀྱིས།",
