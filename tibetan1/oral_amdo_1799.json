    "ཨ་རོ་ལིཀ་ཅེས་པའི་ཨ་ནི་མ་ལུས་པ།",
    "རྡོ་རྗེ་འཛིན་མི་བསྐྱོད་པ་ཐམས་ཅད་ཀྱི་བཙུན་མོའི་མཆོག་མཱ་མ་ཀཱི་འདི་གཙོ་བོ་ཉིད་ཀྱི་ཞེས་སོགས་སྒྲ་ཇི་བཞིན་པའོ།",
    "དྭེ་ཥ་ར་ཏི་ནི་ཞེ་སྡང་དགའ་མ་སྟེ་དེ་ལ་ཞེ་སྡང་གི་རིགས་མི་བསྐྱོད་པ་ལ་དགའ་བས་ན་ཞེ་སྡང་དགའ་མ་སྟེ་དྲང་དོན་ནོ།",
    "བུད་མེད་མཱ་མ་ཀཱིའི་གཟུགས་ཀྱི་རྣམ་པ་འཛིན་པར་གྱུར་ཏེ།",
    "མོ་ཧ་ར་ཏི་ནི་གཏི་མུག་དགའ་མ་སྟེ།",
    "དེ་ལ་གཏི་མུག་གི་རིགས་རྣམ་སྣང་ལ་དགའ་བས་ན་གཏི་མུག་དགའ་མ་སྟེ་དྲང་དོན་ནོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་འདོད་ཆགས་འཛིན་པ་འོད་དཔག་མེད་རྗེས་སུ་ཆགས་པར་བྱེད་པའི་རྡོ་རྗེ་ཞེས་བྱ་བ་ནི་གོས་དཀར་མོ་སྟེ།",
    "སྐུ་དང་གསུང་དང་ཐུགས་ཏེ་ལུས་ངག་ཡིད་གསུམ་སྐད་ཅིག་རེ་རེ་ཞིང་འཇིགས་པས་བསླུ་བ་རྡོ་རྗེ་ཞེས་པ་ཡིག་དོན་ནོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་ནི་སྒྱུ་ལུས་ཐོབ་པའི་སྒྲུབ་པ་པོའི་ཕུང་ཁམས་རྣམས་དང་ལུས་ངག་ཡིད་གསུམ་མོ།",
    "གཞིག་གི་བསམ་གཏན་གཉིས་ཀྱི་དོན་གྱི་འོད་༢༦བ་གསལ་དུ་བཅུག་ནས་འཇའ་ཡལ་བ་ལྟར་མི་སྣང་བར་གྱུར་པ་ནི་བསླུ་བ་རྡོ་རྗེ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཤེས་རབ་འཆང་བ་དོན་ཡོད་གྲུབ་པའི་བཙུན་མོའི་མཆོག་སྒྲོལ་མ་འདི་ཞེས་སོགས་སྒྲ་ཇི་བཞིན་པའོ།",
    "དེ་བཞིན་གཤེགས་པ་རིགས་ལྔ་པོ་ཐམས་ཅད་ཀྱི་བཙུན་མོ་དེ་ལ་ལྷན་ཅིག་སྤྱོད་པའི་བཙུན་མོ་དང་།",
    "རྗེས་སུ་སྤྱོད་པའི་བཙུན་མོ་གཉིས་ཡོད་པ་ལས་ལྷན་ཅིག་པའི་བཙུན་མོའི་མཆོག་ཕུན་སུམ་ཚོགས་པའོ།",
    "ཡ་མཱནྟ་ཀྲིཏ་ཞེས་པའི་ཡ་མ་ནི་གཤིན་རྗེ་མའི་ཁོག་ཏུ་ཞུགས་པའི་ཨ་ཕྱུང་ནས་ཨནྟ།",
    "དེ་ལ་གཤིན་རྗེ་སྟེ་ངན་སོང་དུ་སྐྱེ་བའི་ལས་ཀྱི་སྒྲིབ་པ་༢ ༧ན་མཐར་ཏེ་ཟད་པར་བྱེད་པས་གཤིན་རྗེ་མཐར་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
    "དེ་ལ་ཤེས་རབ་ཀྱིས་ཉོན་མོངས་པ་མཐར་ཏེ་ཟད་པར་བྱེད་པས་ཤེས་རབ་མཐར་བྱེད་དེ་དྲང་དོན་ནོ།",
    "དེ་ནས་འདི་ཞེས་སོགས་ལ་རྡོ་རྗེ་ཁྲོ་བོའི་དམ་ཚིག་གིས་བགེགས་རྣམས་བསྙེངས་པ་སྟེ་འཇིགས་པར་བྱེད་པའི་ཚུལ་དུའམ།",
    "དེས་འབྱུང་གནས་བྱས་ནས་བསྐྱེད་པའི་ཟུང་འཇུག་གི་རྟ་མགྲིན་ནི་རྡོ་རྗེ་འཆང་ཞེས་བྱ་བ་སྟེ།",
    "དེ་ལ་པདྨ་ཆུས་མ་གོས་པ་ལྟར་ཉོན་མོངས་པས་མ་གོས་ཤིང་ཉོན་མོངས་མཐར་ཏེ་ཟད་པར་བྱེད་པས་ན་པདྨ་མཐར་བྱེད་དེ་དྲང་དོན་ནོ།",
    "གང་གིས་ན་བཅོམ་ལྡན་འདས་ཀྱིས་སོ།",
    "སྡུད་པ་པོའི་ཚིག་གིས་མཚམས་སྦྱར་བ།",
    "དོན་དེ་དེ་བཞིན་གཤེགས་པ་དྲུག་གིས་གསུང་ཚུལ།",
    "ཆ་པ་པོ་ཁྱེད་ཀྱིས་རང་གི་སེམས་ལུས་ཏེ།",
    "རང་གི་ལུས་སེམས་ཏེ་ཐུགས་རྡོ་རྗེ་མི་བསྐྱོད་པ་ལྟ་བུ་སྟེ།",
    "རང་གི་ཚིག་ཏུ་བརྗོད་པ་སྟེ་གསུང་རྡོ་རྗེ་འོད་དཔག་མེད་ལྟ་བུ་སྟེ།",
    "ད་ལྟའི་རང་གི་ལུས་འདི་བེམ་པོ་ཡིན་པས་སེམས་ལས་དོན་གཞན་ཡིན་པ་ལྟར།",
    "ད་ལྟའི་རང་གི་ལུས་བེམ་པོ་ཡིན་པས་སེམས་ལས་དོན་གཞན་ཡིན་པ་ལྟར།",
    "ད་ལྟའི་རང་གི་ངག་བེམ་པོ་ཡིན་པས་སེམས་ལས་དོན་གཞན་ཡིན་པ་ལྟར།",
    "རྗེ་འཆང་གི་ལུས་ལྟ་བུ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་དབྱེར་མི་ཕྱེད་པ་མ་དག་པའི་སྒྱུ་མའི་སྐུ་དེ་ཉིད་ནམ་མཁའ་ལྟ་བུའི་དོན་གྱི་འོད་གསལ་དུ་སྦྱར་བ་སྟེ་བཅུག་ནས་ཟུང་འཇུག་རྡོ་རྗེ་འཆང་གི་སྐུར་བསྐྱེད་པར་བྱའོ།",
    "ཕྱི་ནང་གི།",
    "ཞེས་བྱ་བ་ནི་ངོ་བོ་ཉིད་དམ་རང་གི་མཚན་ཉིད་ཀྱིས་གྲུབ་པའི་སྟོང་པ་ནི་རང་བཞིན་འོད་གསལ་ཡིན་ལ།",
    "རང་བཞིན་རྣམ་དག་གི་དོན་རྟོགས་པའོ།",
    "ང་དུ་སྣང་བ་དེ་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་གྲུབ་པས་སྟོང་རྨི་ལམ་པ།",
    "ཕྱི་ནང་གི་དངོས་པོ་འདི་རྣམས་ལ་རིག་པས་དཔྱད་པ་ན།",
    "དུ་སྣང་བ་དག་ཡིན་པ་དེ་ཐམས་ཅད་ནི་རང་གི་སེམས་ཏེ།",
    "རང་གི་སེམས་ཉིད་ལས།",
    "ཞེས་རང་གི་ངོ་བོ་མེད་པའི་ལན་འདེབས་པར་འབྲེལ་ལོ།",
    "དེ་ལྟར་དཔྱད་པ་བྱེད་པའི་གཞི་སྦས་པར་སོང་བས་སྦས་དོན་ནོ།",
    "རྨི་ལམ་དེ་ནི་བདག་གིས་ཁམས་གསུམ་དུ་རྨི་ལམ་མཐོང་བར་བྱའོ་སྙམ་དུ་མི་སེམས་སོ།",
    "མི་ཡང་བདག་གིས་རྨི་ལམ་མཐོང་ངོ་སྙམ་དུ་མི་སེམས་སོ།",
    "ཡུལ་ཅན་དེ་འོད་གསལ་དེ་དང་མཉམ་པ་ཉིད་དུ་གྱུར་པ་ནི་ཟུང་འཇུག་གི་སྐུའོ།",
    "ཟུང་འཇུག་གི་སྐུ་དེ་ཡང་རང་སེམས་གདོད་ནས་མ་སྐྱེས་པའི་བདག་ཉིད་ཐམས་ཅད་སྟོང་པ་དོན་གྱི་འོད་གསལ་ཉིད་ཀྱི་རང་བཞིན་ནོ།",
    "ཕྱི་ནང་གི་དངོས་པོ་འདི་རྣམས་རང་བཞིན་གྱིས་མ་སྐྱེས་པས་ན།",
    "བདག་གི་ཁམས་གསུམ་དུ་ཞེས་པ་སྟེ།",
    "ཡང་བདག་གིས་རྨི་ལམ་མཐོང་ངོ་མཐོང་ངོ་མཐོང་བར་བྱའོ།",
    "དེ་ཉིད་རྣམ་རྟོག་གིས་མི་ཕྱེད་པས་རྡོ་རྗེ་སྟེ།",
    "དེ་ནས་ཞེས་སོགས་ཏེ་འོད་ཟེར་འབར་བ་སྒྲོན་མ་ནི་འོད་གསལ་གྱི་སྣང་བའོ་དེ་ཉིད་རྣམ་རྟོག་གིས་མི་ཕྱེད་པས་རྡོ་རྗེའོ།",
    "ཐ་སྙད་དུ་དེ་གཉིས་ངོ་བོ་གཅིག་པའི་སྐུ་དང་ཐུགས་སུ་སྦྱར་བ་ཡིས་ཟུང་འཇུག་རྡོ་རྗེ་འཆང་གི་དངོས་པོ་དག་ཏུ་རབ་ཏུ་བསྒྲགས་སོ།",
    "བདེན་གཉིས་དབྱེར་མེད་ཟུང་འཇུག་གི་སྐུའི་སྒོ་ནས་བསྟོད་པའོ།",
    "རྣམ་པར་མི་རྟོག་པ་ནི་གཉིས་སྣང་གི་རྟོག་པ་མེད་པའོ།",
    "རྡོ་རྗེ་ཆེ་ནི་བདེན་གཉིས་དབྱེར་མེད་ཟུང་འཇུག་གི་སྐུའོ།",
    "སྡུད་པ་པོའི་ཚིག་གིས་ལེའུ་ལ་འཇུག་པ།",
    "དཀྱིལ་འཁོར་གྱི་ནང་གི་ལྷ་དེ་བཞིན་གཤེགས་པ་རིགས་ལྔའོ།",
    "འོད་ཟེར་སྤྲིན་ནི་རིགས་ལྔ་པོ་རང་རང་གི་རིགས་ཅན་སྤྱན་མ་ལ་སོགས་པའི་ལྷའི་ཚོགས་སོ།",
    "བཀོད་པ་ཆེ་ནི་ལྷ་རྣམས་གཞལ་ཡས་ཁང་གི་ནང་གི་རང་རང་གི་གནས་སུ་འཁོད་པའོ།",
    "གཞལ་ཡས་ཁང་གི་སྟེང་དང་འོག་གི་ས་གཞི་ཐམས་ཅད་ཤར་དཀར་ལྷོ་སེར་ལ་སོགས་པའོ།",
    "དབུས་སུ་རེག་བྱ་རྡོ་རྗེ་མ་དང་ལྡན་པའོ།",
    "གཙོ་བོ་འཕོ་མི་འཕོའི་གནས་སྐབས་ཐམས་ཅད་དུ་ལྷག་མོས་ཀྱི་གཙོ་བོ་རྡོ་རྗེ་འཆང་གིས་མཛཔས་ཁྱབ་ལམངོན་བྱང་ལྔ་བསྐྱེད་མན་ཆད་ཀྱི་དང་པོ་སྦྱོར་བ་དང་།",
    "ཡན་ལག་གི་དོན་ནོ།",
    "གོང་གི་ཞེ་སྡང་རྡོ་རྗེའི་ཕྱག་མཚན་གྱི་ཁྱད་པར་ཇི་ལྟ་བུ་སྙམ་ན་ཞེ་སྡང་རྡོ་རྗེ་དེའི་ཕྱག་གཡས་ཀྱི་དང་པོ་ན་རྡོ་རྗེ་ཆེན་པོ་རྩེ་མོ་དགུ་པ་བསྣམས་པར་བསྒོམ་མོ།"
  ]
