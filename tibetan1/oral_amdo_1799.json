    "ཕྱག་གསུམ་འཚལ་ཏེ་གཙོ་བོའི་ཕྱག་ཏུ་མེ་ཏོག་སྤོས་རེང་དང་བཅས་པ་ཕུལ་ནས་གཞན་སོ་སོའི་ཕྱག་ཏུ་མེ་ཏོག་ཡས་རིམས་ཀྱིས་དབུལ།",
    "ཕྱག་གསུམ་འཚལ་ནས་མེ་ཏོག་དང་བཅས་པའི་ཐལ་མོ་སྦྱར་ནས།",
    "རང་གི་སྤྱི་བོར་པཾ་ལས་པདྨ་དང་ཨ་ལས་ཟླ་བའི་སྟེང་དུ།",
    "ཧཱུཾ་ལས་རྡོ་རྗེ་རྩེ་ལྔ་པ་དཀར་པོ་ལྟེ་བ་ལ་ཧཱུཾ་གིས་མཚན་པ།",
    "ཡུམ་རྡོ་རྗེ་སྙེམས་མ་དཀར་མོ་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པས་འཁྱུད་པ།",
    "རྡོ་༣བ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "སྦྱོར་མཚམས་ནས་ཐོན་པའི་བྱང་སེམས་བདག་གི་སྤྱི་བོའི་སྒོ་ནས་ཞུགས་བདག་གི་ལུས་ཐམས་ཅད་གང་།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱི་སྡིག་སྒྲིབ་དང་དམ་ཚིག་ཉམས་ཆགས་ཐམས་ཅད་དག་གོ་ཞེས་གསུངས་ནས་རང་ལ་ཐིམ་པས་རང་གི་སྒོ་གསུམ་དང་རྡོ་རྗེ་སེམས་དཔའི་སྐུ་གསུང་ཐུགས་དབྱེར་མེད་པར་གྱུར།",
    "སྣ་ཚོགས་པདྨ་དང་ཉི་མའི་གདན་རེ་རེ།",
    "རང་གི་སྤྱི་བོར་སྐུ་རྡོ་རྗེའི་ངོ་བོ་ཨོཾ་དཀར་པོ།",
    "ཁྲོ་བོ་བཅུར་གྱུར་པའི་མི་བསྐྱོད་པ་ནག་པོ་ནག་དཀར་དམར་༥ན་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་རྡོ་རྗེ་འཁོར་ལོ་པདྨ།",
    "རལ་གྲི་འཛིན་པ་རང་གི་ཐུགས་ཀར་དྲངས།",
    "ཕྱག་དྲུག་གི་གཡས་རྡོ་རྗེ་རྩེ་དགུ་པ་འཁོར་ལོ་པདྨ།",
    "སྔོ་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་ཞེས་པ་ནས།",
    "གཤིན་རྗེ་གཤེད་ནག་པོ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན།",
    "དགྲ་སྟ་འཛིན་པ་རང་གི་ཐུགས་ཀར་དྲངས།",
    "ཤར་གྱི་རྩིབས་༥བ་ཀྱི་རྩེ་མོའི་སྟེང་གི་རང་གི་གདན་ལ་གཡོན་བརྐྱངས་ཀྱིས་འཁོད།",
    "རྩེ་གསུམ་དགྲ་སྟ་འཛིན་པ་རང་གི་ཐུགས་ཀར་དྲངས།",
    "བྱང་ཤར་གྱི་རྩིབས་ཀྱི་རྩེ་མོའི་སྟེང་གི་རང་གི་གདན་ལ་གཡོན་བརྐྱངས་ཀྱིས་འཁོད།",
    "ཐུགས་ཀ་ནས་ཕྱིར་ཕྱུང་སྟེང་གི་རྩིབས་ཀྱི་ནང་གི་རང་གི་གདན་ལ་གཡོན་བརྐྱང་གིས་འཁོད།",
    "འོག་གི་རྩིབས་ཀྱི་ནང་གི་རང་གི་གདན་ལ་གཡོན་བརྐྱང་གིས་འཁོད།",
    "དེ་ནས་འོག་གི་གནོད་མཛེས་ལ་བལྟས་པས།",
    "འབྲུབ་ཁུང་གི་རྣམ་པ་ཅན་རྣམས་སུ་བཅུག་པར་གྱུར།",
    "བྱང་གི་བདུད་རྩི་འཁྱིལ་པས་སྤྲུལ་པའི་བདུད་རྩི་འཁྱིལ་པ་གཉིས་པ་དེ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "སྔོ་དཀར་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་སྣ་ཚོགས་རྡོ་རྗེ་འཁོར་ལོ་གཏུན་ཤིང་།",
    "ོཆ་བརྩམས་ཏེ་མཚམས་བཞི་དང་སྟེང་འོག་གི་ཕུར་བུ་༦ན་རྣམས་ཀྱི་སྤྱི་བོ་ནས་བརྡུངས་པས་བགེགས་རྣམས་ཀྱི་སྤྱི་བོ་ནས་རྐང་མཐིལ་གྱི་བར་དུ་ཕུར་བུས་བཏབ་པས་ལུས་ངག་ཡིད་གསུམ་གཡོ་འགུལ་མེད་པར་གྱུར།",
    "སྤྲུལ་པའི་གནོད་མཛེས་འོག་གི་གནོད་མཛེས་ལ་ཐིམསླར་ཡང་ཁྲོ་བོ་དང་ཕུར་བུ་ལས་རྡོ་རྗེའི་མེ་འོད།",
    "སྟོང་པའི་ངང་ལས་སྐད་ཅིག་གིས་རྡོ་རྗེའི་ས་གཞི།",
    "སྤྱན་སོགས་ལྷ་མོ་བཞིའི་ངོ་བོར་གྱུར།",
    "གདན་དེ་རྣམས་ཀྱི་སྟེང་དུ་སྐད་ཅིག་གི་ལྷག་པར་མོས་པ་ཙམ་གྱི་ལྷ་༦བ་སུམ་ཅུ་སོ་གཉིས་དུས་གཅིག་ཏུ་རྫོགས་པ་ནི།",
    "རེག་བྱ་རྡོ་རྗེ་མ་སྔོན་མོ་མི་བསྐྱོད་པའི་དབུ་རྒྱན་ཅན།",
    "ལང་ཚོ་དར་ལ་བབ་ཅིང་འདོད་ཡོན་ལྔའི་དགའ་བས་རོལ་བ།",
    "འོད་ཀྱི་དཀྱིལ་འཁོར་གྱིས་བསྐོར་བའི་དབུས་ན་ཡབ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "ཤར་ལྷོར་སྤྱན་མ་དཀར་མོ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན།",
    "རིམ་པ་གཉིས་པའི་ཤར་ལྷོར་གཟུགས་རྡོ་རྗེ་མ་དཀར་མོ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན།",
    "ལྷ་མོ་བརྒྱད་པོ་ཐམས་ཅད་ཀྱང་དབུ་སྐྲ་རལ་པ་ཕྱེད་བཅིངས་སུ་བྱས་༧ན་པ།",
    "འོད་ཀྱི་དཀྱིལ་འཁོར་རབ་ཏུ་འབར་བའི་དབུས་ན་རང་རང་གི་གདན་ལ་རྡོ་རྗེའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པའོ།",
    "བྱམས་པའི་ཕྱག་གཡས་ཀྱི་དང་པོས་ཀླུ་ཤིང་གི་མེ་ཏོག་སྡོང་བུ་དང་བཅས་པ་འཁོར་ལོས་མཚན་པ་འཛིན་པ།",
    "རྣམ་སྣང་ནས་ཀུན་བཟང་གི་བར་གྱི་ལྷ་ལྷག་མ་ཐམས་ཅད་ཀྱང་དབུ་སྐྲ་རལ་པའི་ཐོར་ཚུགས་ཅན།",
    "ཤར་སྒོར་གཤིན་རྗེ་གཤེད་ནག་པོ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་ལས་སླར་༧བ་ཡང་འོད་ཟེར་འཕྲོས་པས་རྣམ་སྣང་ནས་གནོད་མཛེས་ཀྱི་བར་གྱི་ལྷ་རྣམས་སྤྱན་དྲངས་ཏེ།",
    "ཨོཾ་ཨཱ་ཧཱུྃཧཱུཾ་གིས་མཚན་པ།",
    "རང་གི་ལུས་ཀྱི་མདུན་རྒྱབ་དང་།",
    "རང་གི་སྤྱི་གཙུག་ནས་སྐྲ་མཚམས་༨ན་ཀྱི་བར་དུ་གཟུགས་ཀྱི་ཕུང་པོའི་ངོ་བོ་ཨོཾ་དཀར་པོ་ཡོངས་སུ་གྱུར་པ་ལས་རྣམ་སྣང་དཀར་པོ་མི་བསྐྱོད་པའི་དབུ་རྒྱན་ཅན།",
    "ལྟེ་བར་ལུས་ཀྱི་སའི་ཁམས་ཐམས་ཅད་ཀྱི་ངོ་བོ་ལཾ་ཡོངས་སུ་གྱུར་པ་ལས་སྤྱན་མ་དཀར་མོ།",
    "མིག་གི་སྒོར་ལུས་ཀྱི་གཟུགས་ཀྱི་རང་བཞིན་ཛ་ཡོངས་སུ་གྱུར་པ་ལས།",
    "གཟུགས་རྡོ་རྗེ་མ་དཀར་མོ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན།",
    "རྡོ་རྗེའི་སྒོར་ལུས་ཀྱི་རེག་བྱའི་རང་བཞིན་ཁཾ་ཡོངས་སུ་གྱུར་པ་ལས་རེག་བྱ་རྡོ་རྗེ་མ་སྔོན་མོ་མི་བསྐྱོད་པའི་དབུ་རྒྱན་ཅན།",
    "བྱམས་པ་དཀར་པོ་རྣམ་སྣང་གི་དབུ་རྒྱན་ཅན།",
    "དཀར་ནག་དམར་བའི་ཞལ་གསུམ་ཕྱག་དྲུག་གི་གཡས་ཀླུ་ཤིང་གི་མེ་ཏོག་སྡོང་བུ་དང་བཅས་པ་འཁོར་ལོས་མཚན་པ།",
    "རང་གི་སྤྱི་བོར་ཨོཾ་ལས་བྱུང་བའི་ཟླ་བའི་དཀྱིལ་འཁོར་ཡོངས་སུ་རྫོགས་པའི་ལྟེ་བར།",
    "སྐད་ཅིག་གི་གསུང་རྡོ་རྗེ་འོད་དཔག་མེད་ཀྱི་ལྷ་ཚོགས།",
    "སྤྲོས་པའི་གོས་དཀར་མོ་དང་སྤྱན་དྲངས་པའི་འོད་དཔག་མེད་ཀྱི་ལྷའི་ཚོགས་གཉིས་པོ་ཐམས་ཅད།",
    "སྐད་ཅིག་གིས་ཐུགས་རྡོ་རྗེ་མི་བསྐྱོད་པའི་ལྷ་ཚོགས།",
    "སྟོང་པའི་ངང་ལས་ཁཾ་ལས་རྡོ་རྗེ་ཁཾ་གིས་མཚན་པ།",
    "རེག་བྱ་རྡོ་རྗེ་མ་སྔོན་མོ་མི་བསྐྱོད་པའི་དབུ་རྒྱན་ཅན།",
    "བྷ་གར་ཁཾ་ལས་རེག་བྱ་རྡོ་རྗེ་མ་ལ་སྒྲིབ་སིལ་གྱིས་འཁྱུད་པ།",
    "རྐང་མཐིལ་གཉིས་སུ་ཧཱུཾ་ལས་ས་འའཛིན་ལྷ་མོ་རྣམས་སུ་གྱུར།",
    "ཁྲོ་མོ་བཅུ་པོ་ཐམས་ཅད་ཀྱང་དབུ་སྐྲ་དམར་སེར་གྱེན་དུ་བརྫེས་པ་ལ་དཔལ་གསང་བ་འདུས་པའི་མངོན་རྟོགས་ཀྱི་ལྷན་ཐབས།",
    "སོགས་པ་ཁྲོ་མོའི་ཉམས་ཐམས་ཅད་ཡོངས་སུ་རྫོགས་པར་གྱུར།",
    "རང་གི་གསང་གནས་མི་དམིགས་པའི་ངང་ལས།",
    "ཀླུ་ཤིང་གི་མེ་ཏོག་སྡོང་བུ་དང་བཅས་པ་འཁོར་ལོས་མཚན་པ།",
    "ཡབ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ།",
    "ཤར་ལྷོར་རང་ཉིད་སྤྱན་མ་དཀར་མོ།",
    "སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པར་གྱུར།",
    "སྐྱིལ་མོ་ཀྲུང་གི་བཞུགས་པར་གྱུར།",
    "མི་བསྐྱོད་པ་རང་གི་ཐུགས་ཀར་དྲངས།",
    "འོད་དམར་པོ་འབར་ཞིང་འཁྲུག་པའི་དབུས་ན་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གི་བཞུགས་པར་གྱུར།",
    "རེག་བྱ་རྡོ་རྗེ་མ་ཨ་དཔལ་གསང་བ་འདུས་པའི་མངོན་རྟོགས་ཀྱི་ལྷན་ཐབས།",
    "རང་གི་ཐུགས་ཀར་དྲངསསྤརྴ་བཛྲ་ཐུགས་ཀ་ནས་ཕྱིར་ཕྱུང་།",
    "རྒྱལ་བ་རྣམས་རེག་བྱའི་བདེ་བས་མཆོད།",
    "རེག་བྱ་རྡོ་རྗེ་མ་ཡེ་ཤེས་པ་དང་དབྱེར་མེད་དུ་འདྲེས།",
    "༡༡ན་སླར་བྱོན་ནས་སྔར་གྱི་རེག་བྱ་རྡོ་རྗེ་མ་ལ་ཐིམ་པར་གྱུར།",
    "རྣམ་པར་སྣང་མཛད་རང་གི་ཐུགས་ཀར་དྲངས།",
    "སྤྱན་མ་རང་གི་ཐུགས་ཀར་དྲངས།",
    "མོ་ཧཱ་ར་ཏི་ཐུགས་ཀ་ནས་ཕྱིར་ཕྱུང་།",
    "ཞེས་པ་ནས་སྔར་གྱི་རེག་བྱ་རྡོ་རྗེ་མའི་སྐབས་བཞིན་སྦྱར་ནས།",
    "བྱམས་པ་རང་གི་ཐུགས་ཀར་དྲངས།",
    "གཤིན་རྗེ་གཤེད་རང་གི་ཐུགས་ཀར་དྲངས།",
    "ཤེས་རབ་མཐར་བྱེད་རང་གི་ཐུགས་ཀར་དྲངས།",
    "གཞལ་ཡས་ཁང་རང་གི་ཐུགས་ཀར་དྲངས།",
    "བཟླས་བྱའི་སྔགས་ཀྱིས་བསྐོར་བའི་ལྷ་རྣམས་ཀྱི་རང་རང་གི་ཐུགས་ཀའི་རང་རང་གི་ས་བོན་ལས་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་སྤྲོས་ཏེ།",
    "རྡོ་རྗེའི་སྐུ་ཁྱོད།",
    "ཁྱོད་ནི་རྡོ་རྗེའི་གསུང་སྟེ།",
    "ཁྱོད་ནི་རྡོ་རྗེའི་འདོད་པ།",
    "རྒྱལ་བ་རྡོ་རྗེ་འཆང་གི་ཞལ་དུ་ཨོཾ་ཨཱ་ཧཱུཾ།",
    "དེ་ནས་རང་གི་ལྕེ་རྩེ་སྨིན་མཚམས་སྤྱི་གཙུག་གསུམ་དུ་ཆང་གི་ཐིག་ལེ་བྱས་ལ།",
    "ཨོཾ་ཨཱ་ཧཱུཾཔུས་མོའི་ཐད་ནས་གཏོར།",
    "ནང་མཆོད་རང་གི་ལྕེ་ལ་བཞག་ལ།",
    "ཨོཾ་ཨ་མྲྀ་ཏ་སྭ་ད་ནཱ་བཛྲ་སྭ་བྷཱ་ཝ་ཨཱཏྨ་ཀོཧཾ།",
    "མགྲོན་རྣམས་ཡེ་ཤེས་ཀྱི་བདུད་རྩིས་མཉེས་པར་གྱུརརང་གི་གསང་གནས་མི་དམིགས་པའི་ངང་ལས་ཞེས་པ་ནས།",
    "ཐུགས་ཀའི་ཧཱུཾ་གི་འོད་ཟེར་གྱིས་རྣམ་སྣང་ནས་གནོད་མཛེས་ཀྱི་བར་གྱི་ལྷ་ཐམས་ཅད་སྤྱན་དྲངས་ཏེ་རང་གི་སྤྱི་བོ་ལ་སོགས་པའི་གནས་རྣམས་སུ་འཁོད་པ་ནི།",
    "མིག་གི་སྒོར་གཟུགས་རྡོ་རྗེ་མ།",
    "གཞལ་ཡས་ཁང་གི་ཆ་སོ་སོ་ཡང་རང་གི་ལུས་ཀྱི་ཆ་སོ་སོ་ལ་ཐིམ་པར་གྱུར།",
    "རྡོ་རྗེ་འཆང་དུ་༡༣བ་གྱུར་པ་རྣམས་རང་གི་འོད་ཟེར་གྱིས་སྤྱན་དྲངས་ནས་རང་ལ་ཐིམ་པར་གྱུར།",
    "དཀྱིལ་འཁོར་གྱི་ལྷ་དང་ཕྱོགས་སྐྱོང་གི་གཏོར་མ་གཉིས་རིམ་པ་བཞིན་ཆང་ཆུ་ནང་མཆོད་བྱིན་གྱིས་བརླབས་པས་སྦྱངས་ནས།",
    "དེའི་སྟེང་དུ་ཧཱུཾ་རཾ་ཧཱུཾ་གི་རཾ་དམར་པོ་ལས་བྱུང་བའི།",
    "དེའི་དབུས་སུ་ཧཱུཾ་ལས་བྱུང་བའི་མིའི་ཤ་ཧཱུཾ་གིས་མཚན་པ།",
    "ལྷོར་ཨཾ་ལས་བྱུང་བའི་རྟའི་ཤ་ཨཾ་གིས་མཚན་པ།",
    "ནུབ་ཏུ་ཛྫིཾ་ལས་བྱུང་བའི་བ་གླང་གི་ཤ་ཛྫིཾ་གིས་མཚན་པ།",
    "བྱང་དུ་ཁཾ་ལས་བྱུང་བའི་ཁྱིའི་ཤ་ཁཾ་གིས་མཚན་པ།",
    "སླར་ཡང་དབུས་སུ་ཧཱུཾ་ལས་བྱུང་བའི་དྲི་ཆུ་ཧཱུཾ་གིས་མཚན་པ།",
    "ལྷོར་ཨཾ་ལས་བྱུང་བའི་རཀྟ་ཨཾ་གིས་མཚན་པ།",
    "ནུབ་ཏུ་ཛྫིཾ་ལས་བྱུང་བའི་བྱང་སེམས་དཀར་པོ་ཛི་གིས་མཚན་པ།",
    "བྱང་དུ་ཁཾ་ལས་བྱུང་བའི་ཤ་ཆེན་ཁཾ་གིས་མཚན་པ།",
    "བདུད་རྩི་ལྔ་ལ་ཐུན་མོང་དུ་ཨོཾ་ཡིག་གིས་མཚན་པ།",
    "དེ་དག་གི་སྟེང་གི་བར་སྣང་ལ།",
    "ཨོཾ་ཡིག་གི་འོད་ཟེར་ལྕགས་ཀྱུ་ལྟ་བུས།",
    "རང་གི་ཐུགས་ཀའི་ཧཱུཾ་སྔོན་པོའི་འོད་ཟེར་ལྕགས་ཀྱུ་ལྟ་བུས།",
    "ནང་མཆོད་ཕུལ་ནས་བསྟོད་པ་གང་རུང་གིས་བསྟོད།",
    "སྣ་ཚོགས་པདྨ་དང་ཟླ་བའི་གདན་ལ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པར་གྱུར།",
