    "ཤར་དུ་ལུག་དང་སྲང་སོགས་ཏེ་བུ་མོའི་མཐར་ཐུག་པ་ལ་གནས་ཤིང་དེ་བཞིན་དུ་སྲང་ལ་སོགས་པ་ཉའི་མཐར་ཐུག་པ་ལ་གནས་སོ།",
    "དེས་ན་ཐ་སྐར་ཤར་གླིང་དབུས་མའི་དབུས་དང་ནག་པའི་ཕྱེད་ནུབ་གླིང་དབུས་པའི་སྟེང་དུ་ཡོད་པ་ནི་སྟོན་དཔྱིད་ཉིན་མཚན་མཉམ་པའི་གོ་ལའི་རི་མོ་སྟེ་རྒྱུ་སྐར་གཡས་ཏེ་བྱང་གླིང་གི་ཕྱོགས་དང་།",
    "དང་བཅུ་བཞི་ནི་ལུག་ནས་བུ་མོའི་བར་གྱི་ཁྱིམ་དྲུག་བྱང་ཕྱོགས་སུ་འཁོད་པ་དང་།",
    "གཞུའི་ཆང་ཟུང་གི་ཕྱོགས་ནི་བྱང་སྟེ་རི་རབ་བམ་བསིལ་བའི་རིའི་ཕྱོགས་སུ་ཤིན་ཏུ་ཉེ་བར་གནས་སོ།",
    "པད་འདབ་༡༩བ་བཟང་པོ་བཞིན་དུ་ལྷོ་བྱང་གི་གོ་ལའི་དབུས་ནས་གཞལ་ཏེ་ཤར་དུ་ལུག་གླང་འཁྲིག་ཆུ་སྲིན་བུམ་པ་ཉ་སྟེ་པད་འདབ་ལྟ་བུར་གནས་ལ།",
    "ནུབ་ཏུ་སྲང་སྡིག་གཞུ་ཀར་སེང་བུ་མོ་སྟེ་ནུབ་ཁྱིམ་དྲུག་ཡང་པད་འདབ་བཟང་པོ་ལྟ་བུའོ།",
    "ཡུལ་དྲུག་གི་དུས་སྦྱོར་གཉིས་ཀྱི་དང་པོ་ནི།",
    "དེ་ལས་སྟོང་ཕྲག་བཅུ་གཅིག་གིས།",
    "སྟེང་དང་འོག་གི་བགྲོད་པར་བཤད།",
    "དེ་ཕྱེད་གོ་ལའི་རི་མོ་ཡིན།",
    "ཉི་མ་དེ་ནི་དང་པོར་འཇིག་རྟེན་དུ་སྐྱེས་པའི་ཚེ་ཀརྐ་ཊའི་ཁྱིམ་ནབས་སོའི་བཞི་གསུམ་དུ་སྐྱེས་པས་གླིང་འདིར་བྱང་བགྲོད་མཐར་ཐུག་པ་ཞིག་ཤར་བ་ཡིན་ལ་གང་དུ་བྱང་བགྲོད་མཐར་ཐུག་པའི་དུས་སུ་ས་ལས་གྱེན་དུ་དཔག་ཚད་བརྒྱད་ཁྲི་དྲུག་སྟོང་གིས་མཐོ་བའི་ནམ་མཁར་འཁོར་ཞིང་།",
    "གང་དུ་ལྷོ་བགྲོད་མཐར་ཐུག་༡༡ན་ཡོད་པ་དེར་ནི་དེ་ལས་སྟོང་ཕྲག་བཅུ་གཅིག་གིས་དམའ་བ་དཔག་ཚད་བདུན་ཁྲི་ལྔ་སྟོང་གི་སར་འཁོར་ལ།",
    "ཉིན་མཚན་མཉམ་པ་ནས་ལྷོ་བྱང་མཐར་ཐུག་གི་བར་དུ་དཔག་ཚད་ལྔ་བརྒྱ་ལྔ་སྟོང་གི་འཕེལ་འགྲིབ་བྱེད་དོ།",
    "དེ་ལྟར་དབྱར་ཉི་ལོག་ནས་དགུན་ཉི་མ་ལོག་གི་བར་ལྷོར་བགྲོད་པའི་ཟླ་བ་དྲུག་ལ་ཕྱོགས་རེ་དེར་ཞག་རེ་བཞིན་འོག་ནས་འོག་ཏུ་ལྷོར་བགྲོད་ལ།",
    "དགུན་ཉི་ལོག་ནས་དབྱར་ཉི་མ་ལོག་གི་བར་བྱང་བགྲོད་ཀྱི་ཟླ་བ་དྲུག་ལ་ཕྱོགས་རེར་དེར་ཞག་རེ་བཞིན་བྱང་དུ་ཇེ་ཉེ་དང་ཇེ་མཐོར་འགྱུར་ཏེ།",
    "སྟེང་དུ་དྲུག་དང་ཀླུ་ཡི་གྲངས་ནི་ཉི་མའི་གདུང་བྱེད་དག་ཡང་བྱང་དུ་བགྲོད་པ་དག་གི་མཐར།",
    "སྟོང་ཕྲག་བརྒྱད་བཅུ་རྩ་གཅིག་མདའ་ནི་བརྒྱ་དང་བྲལ་བར་གྱུར་པ་དབུས་ནས་གོ་ལའི་རི་མོ་སྟེ།",
    "དེའི་ལོངས་སྤྱོད་རྟོགས་པར་བྱ་བའི་རི་མོ་ནི།",
    "ཞག་གིས་སྟོང་ཕྲག་བཅུ་གཅིག་བགོས།",
    "བདུན་ཁྲི་ལྔ་སྟོང་ཞག་གིས་བགོས།",
    "ཞག་བརྒྱ་དང་བརྒྱད་ཅུ་ཕྱེད་གསུམ་སྟེ་བགྲོད་པ་རེའི་ཞག་ལ་ཞག་རེ་བཞིན་བྱང་བགྲོད་ལ་སྟེང་དང་བྱང་དུ་འགྲོ་ཞིང་།",
    "ལྷོ་བགྲོད་ལ་ལྷོ་དང་འོག་ཏུ་༡༡བ་འགྲོ་བའི་ཕྱིར་བགྲོད་པ་གཅིག་གི་ཞག་བརྒྱ་དང་བརྒྱད་ཅུ་ཕྱེད་གསུམ་ནི་བགོད་བྱེད་དོ།",
    "ཕྱེད་མ་གཅིག་བསྲེས་པའི་སུམ་བརྒྱ་རེ་ལྔས།",
    "ལྷག་མ་ཉིས་སྟོང་གིས་བསྒྱུར་ནས་ཐོབ་པ་གཞུ་འདོམ།",
    "ཞིབ་མོར་ན་རྡུལ་ཕྲ་རབ་ཀྱི་བར་དུ་བསིལ་ལོ།",
    "སྟོང་ཕྲག་བཅུ་གཅིག་མིག་གིས་བསྒྱུར།",
    "མཁའ་མཁའ་མཁའ་མིག་གིས་བསྒྱུར་གཞུ།",
    "རྒྱལ་བས་བསྒྱུར་ཐོབ་སོར་མོ་ཡིན།",
    "སྐྲ་རྩེ་ཕྲ་མོ་ཕྲ་རབ་དྲུག།",
    "སྐྲ་རྩེ་བདུན་དང་ཕྲ་མོ་ལྔ།",
    "ཞག་རེའི་སྟེང་འོག་བགྲོད་པའི་ཚད།",
    "ཞག་རེའི་ལྷོ་བྱང་གི་བགྲོད་པ་རྟོགས་པའི་ཕྱིར་བསིལ་བའི་རི་ནས་དགུན་ཉི་ལྡོག་སའི་བར་གྱི་ནམ་མཁའ་བདུན་ཁྲི་ལྔ་སྟོང་ལས་གདུང་བྱེད་ཀྱི་ཡུལ་ཉི་ཁྲི་ལྔ་སྟོང་དོར་བའི་ཁྲི་ཚོ་ལྔ་ནི་བགོ་གཞི་ཡིན་ལ།",
    "བགྲོད་པའི་ཞག་ཕྱེད་མར་བསིལ་བ་སུམ་བརྒྱ་རེ་ལྔ་ནི་སྔར་བཞིན་བགོད་བྱེད་དེ་བགོས་ཐོབ་ནི་ཞག་རེ་བཞིན་ལྷོ་བྱང་དུ་བགྲོད་པའི་ཚད་དོ།",
    "མིག་གིས་བསྒྱུར་བས་འབུམ་ཕྲག་གཅིག།",
    "སྐྲ་རྩེ་བདུན་དང་ཕྲ་མོ་གཅིག།",
    "ཕྲ་རབ་རྡུལ་དྲུག་ཞག་རེ་བཞིན།",
    "གཉིས་པ་ཡུལ་དྲུག་གི་འཕེལ་འགྲིབ་ནི།",
    "ཞག་རེ་ཆུ་སྲང་བཞི་བཞི་ཡི།",
    "ཆུ་ཚོད་དྲུག་ཅུའི་དྲུག་ཆ་ཆུ་ཚོད་བཅུས་ཆུ་སྲིན་ནས་འཁྲིག་པའི་མཐར་ཐུག་པའི་བར་དུ་མཚན་མོ་འགྲིབ་ཅིང་ཉིན་མོ་འཕེལ་ལོ།",
    "ཀརྐ་ཊ་ནས་གཞུའི་མཐར་ཐུག་པའི་བར་དུ་ཉིན་མོ་འགྲིབ་ཅིང་མཚན་མོ་འཕེལ་ཏེ་ངེས་པར་ཉི་མ་རི་བོང་ཅན་ནི་འགྲིབ་དང་འཕེལ་ཞེས་པ་དྲུག་ཆས་སོ།",
    "གིས་ཆ་མཉམ་པར་ཕྱེ་བས་ཡུལ་དྲུག་སྟེ།",
    "རེ་རེའི་ཞེང་ཚད་ནི་དཔག་ཚད་ཉིས་སྟོང་དང་དཔག་ཚད་གཅིག་གི་བཅུ་གཉིས་ཆ་རེ་ཡོད་དོ།",
    "འཛམ་གླིང་གི་ཕྱེད་ལྷོ་མ་ལ་ཡུལ་གྱི་འཕེལ་འགྲིབ་མ་གསུངས་ལ།",
    "ཡང་ལ་ལས་འཛམ་གླིང་ཆུང་ངུའི་ས་ཁྱོན་ཉིད་ལ་དུམ་བུ་དྲུག་ཏུ་བྱེད་པ་ནི་རྡོ་རྗེའི་གདན་ཡུལ་དབུས་ཏེ་འཛམ་གླིང་གི་ལྟེ་བར་ཡོང་རྒྱུ་ལྷོའི་མཐར་ཐོན།",
    "འཛམ་གླིང་ལ་ཡུལ་དེ་དྲུག་ལས་གཞན་པ་མེད་པར་ཐལ་བའི་སྐྱོན་གནས་པས་མི་རིགས་སོ།",
    "ལྷོ་བགྲོད་ལ་མཚན་མོ་དང་།",
    "བྱང་བགྲོད་ལ་ཉིན་མོ་ཞག་རེ་བཞིན་འཕེལ་ཞིང་འགྲིབ་པ་སྟེ།",
    "ཁ་ཅིག་གིས་ནི་གངས་ལྡན་ཆེན་པོ་ནི་བསིལ་བའི་རི་ཡིན་ལ་དེའི་བྱང་གི་ཡུལ་དུ་ཉི་མའི་འཕེལ་འགྲིབ་མི་འབྱུང་སྟེ་ལོགས་བསིལ་རིས་ཡོལ་བ་ལྟར་བཅད་ཅིང་།",
    "གངས་ལྡན་ཆེན་པོའི་ལྷོའི་ཡུལ་གྱི་དུམ་བུར་ནི་རྒྱ་མཚོའི་སྲོག་སྟེ་དབུགས་བཞི་དང་ཆུ་སྲང་གསུམ་ཞག་རེ་བཞིན་འཕེལ་འགྲིབ་བྱེད་པ་བསགས་པས་ཟླ་རེ་ན་ཆུ་ཚོད་གཅིག་དང་སྲང་ལྔ་བཅུ།",
    "དེ་ཟླ་བ་དྲུག་ཏུ་བསགས་པས་བགྲོད་པ་གཅིག་ལ་ཆུ་ཚོད་བཅུ་གཅིག་གི་འཕེལ་འགྲིབ་བྱེད་པའོ།",
    "དེ་ལས་དབུགས་གཉིས་ཀྱིས་དམན་པ་ཞག་རེ་ལ་སྲང་གསུམ་དང་དབུགས་གཉིས།",
    "ཟླ་རེ་ལ་ཆུ་ཚོད་གཅིག་དང་སྲང་བཞི་བཅུ།",
    "བགྲོད་པ་རེ་ལ་ཆུ་ཚོད་བཅུའི་འཕེལ་འགྲིབ་བྱེད་པ་ནི་ཤམྦྷ་ལའི་དུམ་བུར་རོ།",
    "དེ་ལས་དབུགས་གཉིས་ཀྱིས་དམན་པ་ཞག་རེ་ལ་སྲང་གསུམ།",
    "ཟླ་རེ་ལ་ཆུ་ཚོད་གཅིག་དང་སྲང་སུམ་ཅུ་བགྲོད་པ་གཅིག་ལ་ཆུ་ཚོད་དགུའི་འཕེལ་འགྲིབ་ནི་རྒྱ་ནག་པོའི་དུམ་བུར་རོ།",
    "དེ་ལས་དབུགས་གཉིས་ཀྱིས་དམན་པ་ཞག་རེ་ལ་སྲང་༡༡༣ན་གཉིས་དང་དབུགས་བཞི་ཟླ་རེ་ལ་ཆུ་ཚོད་རེ་དང་སྲང་ཉི་ཤུ་བགྲོད་པ་རེ་ལ་ཆུ་ཚོད་བརྒྱད་ཀྱི་འཕེལ་འགྲིབ་བྱེད་པ་ནི་ལི་ཡུལ་གྱི་དུམ་བུར་རོ།",
    "གཉིས་དབུགས་གཉིས་ཟླ་རེ་ལ་ཆུ་ཚོད་གཅིག་སྲང་བཅུ་བགྲོད་པ་རེ་ལ་ཆུ་ཚོད་བདུན་ནི་བོད་ཡུལ་གྱི་དུམ་བུར་རོ།",
    "དེ་ལས་དབུགས་གཉིས་ཀྱིས་དམན་པས་ཞག་རེ་ལ་སྲང་གཉིས་ཟླ་རེ་ལ་ཆུ་ཚོད་རེ་བགྲོད་པ་རེ་ལ་ཆུ་ཚོད་དྲུག་ནི་འཕགས་ཡུལ་གྱི་དུམ་བུར་འཕེལ་འགྲིབ་བོ།",
    "དེས་ན་བགྲོད་པ་རེ་རྫོགས་པ་ན་འཕགས་ཡུལ་དུ་ཆུ་ཚོད་དྲུག་ནས་དབྱངས་འཆར་ནས་བསྟན་པའི་གངས་ལྡན་གྱི་བྱང་གི་དུམ་བུར་ཆུ་ཚོད་བཅུ་གཉིས་དབྱུང་བྱུང་བ་ན་རང་རང་གི་བགྲོད་པའི་མཐར་ཐུག་པར་ཤེས་པར་བྱའོ།",
    "མཚན་མོ་ཆུ་ཚོད་ཉི་ཤུ་རྩ་དྲུག་དང་སྲང་སུམ་ཅུར་འགྱུར་ཏེ་ཉིན་མཚན་ཆུ་ཚོད་སུམ་ཅུར་མཉམ་པའི་སྟེང་དུ་རང་གི་སའི་དུམ་བུ་དེའི་བགྲོད་པའི་འཕེལ་འགྲིབ་ཀྱི་ཆུ་ཚོད་དེའི་ཕྱེད་བསྣན་པས་བྱང་བགྲོད་མཐར་ཐུག་གི་ཉིན་མོའི་ཚད་དང་ལྷོ་བགྲོད་མཐར་ཐུག་གི་མཚན་མོའི་ཚད་འཆར།",
    "ཆུ་ཚོད་སུམ་ཅུའི་སྟེང་ནས་དེ་ཕྲི་བས་རང་གི་དུམ་བུའི་ལྷོ་བགྲོད་མཐར་ཐུག་པའི་ཉིན་མོའི་ཚད་དང་བྱང་བགྲོད་མཐར་ཐུག་པའི་མཚན་མོའི་ཚད་རྟོགས་པར་འགྱུར་རོ།",
    "དེ་ཕྱེད་ཉིན་དང་མཚན་མོའི་ཆ།",
    "ཆུ་སྲང་དབུགས་དང་སྐད་ཅིག་གི།",
    "དེས་ན་ས་ཀུན་ཏུ་བྱང་བགྲོད་ལྟ་བུ་ཞིག་གི་ཅིག་ཅར་དུ་ཡོད་པར་ཁས་ལེན་པ་དང་།",
    "བྱང་གླིང་ཤར་མ་སྒྲ་མི་སྙན་གྱི་ཟླར་སྟོན་ཐ་སྨིན་དྲུག་གི་ཟླ་བ།",
    "དེས་ན་ལུག་གི་ཁྱིམ་ཟླ་བ་དང་པོ་ལྷོ་གླིང་དབུས་མར་དཔྱིད་ཉིན་མཚན་མཉམ་ཞིང་དེའི་ཚེ་དེ་ནས་བརྩམས་པའི་བདུན་པ་བྱང་གླིང་དབུས་མར་སྟོན་ཉིན་མཚན་མཉམ་ལ།",
    "སྲང་གི་ཁྱིམ་ཟླ་ལ་དང་པོར་༡༡༤བ་སྟོན་མཉམ་དང་བདུན་པར་དཔྱིད་མཉམ་འབྱུང་སྟེ།",
    "གང་ཕྱིར་རི་ལ་སྐྱེ་བོ་རྣམས་ཀྱིས་ཉིན་མཚན་མཉམ་པར་འགྱུར་ཏེ་ལུག་ཉི་སྲང་གི་ཉི་མ་ལའོ།",
    "གླང་གི་ཁྱིམ་ཟླ་ལ་གཉིས་པ་སྟེ་ལྷོ་གླིང་ནུབ་མ་དཔྱིད་མཉམ་འབྱུང་ལ།",
    "སེང་གེ་བུམ་པར་རབ་ཞུགས་བཅུ་གཉིས་རོ་ཡི་སར་ནི་ཉ་དང་བུ་མོར་གནས་པ་དག་ལའོ།",
    "ཉ་ལ་དུམ་བུ་གསུམ་པར་མི་རྣམས་ཀྱི་ནི་བགྲོད་པ་དག་ཀྱང་ལུག་གི་ཉི་མས་བཞི་པར་རོ།",
    "གྱིས་སྒྲུབ་༡༡༥བ་པ་ནི་རིགས་པ་རྩིང་མོ་སྟེ།",
    "གླིང་རང་རང་ནས་འཇལ་ཚེ་གླིང་ཐམས་ཅད་རི་རབ་ལ་གདོང་ཕྱོགས་པར་བྱས་པའི་གཡས་ཕྱོགས་ནས་ཉི་མ་འཆར་ཞིང་གཡོན་ཕྱོགས་ནས་ནུབ་པར་འགྱུར་བའི་ཕྱིར་རང་རང་གི་གཡས་ཕྱོགས་ཤར།",
    "ཉི་མའི་ཞག་གཅིག་གི་རྒྱུ་ལམ་རྫོགས་པ་ནི་དཔག་ཚད་འབུམ་ཕྲག་དྲུག་སྟེ་ཉི་མ་ཤར་བའི་ཕྱོགས་སུ་དཔག་ཚད་འབུམ་ཕྲག་གསུམ་ཉིན་མོར་བྱེད་ཅིང་།",
    "རྒྱབ་སྟེ་ནུབ་པའི་ཕྱོགས་སུ་དཔག་ཚད་འབུམ་ཕྲག་གསུམ་མཚན་མོར་བྱེད་ལ་ཉིན་མཚན་གྱི་ས་ཡུལ་གཉིས་བསྡོམས་ན་འབུམ་ཕྲག་དྲུག་ཡོད་པའི་ཕྱིར་ཏེ།",
    "ལམ་ཕྱེད་འབུམ་ཕྲག་གསུམ་པོ་དག་ལ་ཉི་མའི་མདུན་དུ་ཉིན་མོ་དང་ནི་རྒྱབ་ཏུ་མཚན་མོའོ།",
    "ཆུ་ཚོད་རེའི་ཡུན་ནམ་དུས་ལ་དཔག་ཚད་དྲུག་སྟོང་ཉིས་བརྒྱ་ལྔ་བཅུའི་ཡུལ་སྤྱོད།",
    "ཉིན་མཚན་གང་རུང་རེ་ལ་སུམ་འབུམ་བདུན་ཁྲི་ལྔ་སྟོང་སྤྱོད་པ་བསྡོམས་པས་ཞག་རེ་ལ་བདུན་འབུམ་ལྔ་ཁྲི་སྤྱོད་པའི་ཕྱིར་ཏེ།",
    "ཆུ་ཚོད་དུས་ལ་དཔག་ཚད་སྟོང་ཕྲག་དྲུག་ནི་རྐང་པ་དང་བཅས་ཉིན་མོར་བྱེད་པའི་འགྲོ་བ་སྟེ།",
    "དྲུག་ཅུ་ལ་ནི་མེ་འབུམ་དག་དང་ལྔ་དང་རི་བོའི་སྟོང་ཕྲག་ཉིན་དང་མཚན་མོ་དག་ཏུ་འཁོར།",
    "ཉིན་དང་མཚན་མོར་གོ་ལ་ཕྱེད་ལ་མཁའ་མེ་ཆུ་ཚོད་བགྲོད་དེ་གོ་ལ་དག་ལ་གཡས་དང་ནི།",
    "དེ་ལྟར་དུས་སྦྱོར་བཞི་ལ་དུས་རེར་བྱས་པས་དུས་༡༡༦༢གསུམ་དང་།",
    "དུས་སྦྱོར་གསུམ་ལ་ཐུན་མཚམས་རེར་བྱས་པའི་ཐུན་མཚམས་བཞི་དང་།",
    "རེར་བྱས་པའི་ཐུན་ཚོད་བརྒྱད་དང་།",
    "དབྱུག་གུ་ལྔ་ལ་དུས་སྦྱོར་རེར་བྱས་པའི་དུས་སྦྱོར་བཅུ་གཉིས་དང་།",
    "ཆུ་ཚོད་གཉིས་ལ་ཡུད་ཙམ་རེར་བྱས་པའི་ཡུད་ཙམ་སུམ་ཅུ་དང་།",
    "དུས་དང་ཐུན་མཚམས་བཞི་དང་ཐུན་ཚོད་ཉིན་དང་མཚན་མོ་དུས་ཀུན་ཏུ་ནི་ཡང་དག་རྒྱུ་བ་རྣམས།",
    "ཐུགས་རྗེའི་སྤྲིན་སྔོན་བྱམས་པའི་གློག་གི་བ་གམ་ཅན།",
    "ཐུན་མོང་གི་ཞར་བྱུང་རྩིས་གཞི་སྤོ་བའོ།",
    "ཐུན་མོང་དུ་ཕྱོགས་དུས་ཁ་དོག་བསྟན་པའོ།",
    "ཉུང་གིས་སྦྱངས་ལ་ལྷག་མ་གཉིས།",
    "ལྷ་རྣམས་ལྷ་མིན་གྱི་བུ་མོ་དོན་དུ་གཉེར་ཞིང་ལྷ་མིན་རྣམས་ལྷའི་བུ་མོ་དོན་དུ་གཉེར་བའི་རྒྱུ་ལས་དང་།",
    "རེས་འགའ་རྒྱ་མཚོ་ཆེན་པོར་དཀར་ནག་གི་ཀླུ་འཐབ་ཅིང་།",
    "གལ་ཏེ་དྲན་ཉེའི་ཚུལ་དེ་སྐབས་འདིར་ཁས་བླངས་ན་ཟླ་དྲུག་དུས་༡༡༩བ་གསུམ་གྱི་ངེས་པ་དགོས་མེད་དུ་འགྱུར་ཏེ་ལྷ་དང་ལྷ་མིན་འཐབ་པ་དང་སྒྲ་གཅན་ལྟད་མོ་ལྟ་བ་སོགས་ལ་དུས་ངེས་འབྱུང་མི་རིགས་པའི་ཕྱིར་དང་།",
    "དུས་ངེས་འབྱུང་ཆུག་ན་ཡང་སྒྲ་གཅན་ནི་ལོ་ཕྱེད་ཀྱི་བར་ལ་སོགས་པར་ལྟད་མོ་ལྟ་བ་དང་།",
    "དེ་བཞིན་དུ་ཟླ་བ་ལ་ཡང་ཁམས་དྲུག་གི་དབྱེ་བས་ཡེ་ཤེས་ཀྱི་ཁམས་ཀྱི་མཐར་ཐུག་པར་ཟླ་བ་དྲུག་པའོ།",
    "དེ་ཡང་ལུག་གི་ཁྱིམ་ཟླ་ནས་བརྩམས་ཏེ་ཟླ་བ་གཉིས་གཉིས་ལ་ཡན་ལག་རེར་འཇོག་ལ།",
    "ཡན་ལག་རེའི་ཉིན་ཞག་དང་པོ་ལ་མ་རིག་པ།",
    "དྲུག་པར་རེག་པ།",
    "རེག་པའི་ཡན་ལག་དབུས་དེར་སྒྲ་གཅན་རྒྱུ་བ་དེ་ཡིས་ཟླ་བ་ཉི་མ་དག་ནི་འཛིན་པར་འགྱུར།",
    "ཞེས་པའི་རྒྱུད་ཚིག་གི་འགྲེལ་པར་གསུངས་ཀྱི།",
    "དེས་ན་དཀར་པོའི་ཉ་རྫོགས་ཤིང་ནག་ཆའི་དང་པོ་འཆར་བའི་ཚེ་གང་ཟླ་བའི་དཀར་ཆ་རྫོགས་པ་དེ་ནས་སྒྲ་གཅན་འཇུག་པས་དོན་དུ་ནག་པོའི་ཚེས་གཅིག་གི་ཐོག་མར་ཟླ་བ་འབའ་ཞིག་འཛིན་ལ།",
    "རང་གི་གྲིབ་མས་འགྲིབ་པར་སྣང་།",
    "ཉི་མ་དང་ཉེ་བའི་ཚེ་ན་རང་གི་ལྕགས་རིའི་གྲིབ་མ་འོག་བཞིར་འབབ་པས་ས་སྟེང་ནས་ལྟ་ཚེ་དཀར་ཆ་བྲི་བ་ལྟར་སྣང་ལ།",
    "ཤར་གླིང་གི་ནམ་མཁའ་དཀར་པོ་དང་།",
    "ནུབ་གླིང་གི་དམར་པོ་དང་།",
    "ཉི་ཟླ་རྒྱུ་སྐར་གང་ལ་གནས་པ་དེ་དང་ཉི་ཟླའི་བར་སྒྲ་གཅན་གྱིས་ཆོད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "༡༢༣ན་ཇི་ལྟར་གནམ་སྟོང་གི་མཐར་ཉི་མ་ལ་སྒྲ་གཅན་ཞུགས་པ་ཇི་བཞིན་ནོ།",
    "ཤེལ་ཤིན་ཏུ་དྭངས་པའི་སྟེང་དུ་རེ་བའམ་དར་ལ་སོགས་པ་བཟུང་ན་འོག་ནས་བལྟས་པའི་ཚེ་དེའི་ཁ་དོག་ཏུ་སྣང་བའི་ཕྱིར་རོ།",
    "ནག་དང་དཀར་བའི་ཚིགས་མཚམས་དག་ལ་ཉིན་དང་མཚན་མོའི་དུས་སུ་ཉི་མ་དང་ནི་ཟླ་བ་འཛིན།",
    "དཀྱིལ་འཁོར་གྱི་སྒྲས་ནི་འདིར་ཆུ་ཚོད་དྲུག་ཅུའི་བདག་ཉིད་རྒྱུ་སྐར་གཅིག་གི་ལོངས་སྤྱོད་དེ།",
    "ཞེས་རྒྱུ་སྐར་རེའི་དཀྱིལ་འཁོར་ཆུ་ཚོད་དྲུག་ཅུ་ཡིན་ལ།",
    "སྒྲ་གཅན་གྱི་གདོང་མཇུག་དང་ཟླ་བ་གང་ཉེ་བ་ཉུང་གིས་སྦྱངས་པས་གཉིས་ཀ་དཀྱིལ་འཁོར་དག་སྟེ་ལྷག་མེད་དུ་གྱུར་ན་ཟླ་བ་ལ་ཆ་བཅུ་དྲུག་གི་བར་དང་།",
    "གཟའ་འཛིན་སྔ་མ་བྱུང་ནས་ཟླ་དྲུག་གི་མཚམས་སུ་ནི་ངེས་པར་འཛིན་ཏེ།",
    "ངེས་པའི་སྒྲ་ནི་གདོན་མི་ཟ་བའི་དོན་ཡིན་པས་དུས་ཚིགས་རེ་ན་ངེས་པར་འཛིན་པའི་དོན་ནོ།",
    "ཉི་ཟླ་དང་གདོང་རྒྱུ་སྐར་གཅིག་ཏུ་ཚོགས་ན་གདོང་གིས་འཛིན་ཞིང་།",
    "དུས་མེ་དང་རྒྱུ་སྐར་གཅིག་གི་སྟེང་དུ་ཚོགས་ན་དུས་མེས་འཛིན་པའི་ཕྱིར་རོ།",
    "སླར་ཡང་མི་འཁྲུལ་པའི་གཟེར་དུ་སྦྱངས་ལྷག་དང་ཉི་བུལ་བསྲེས་པའི་ལྷག་གཉིས་ཀ་སོ་སོར་གདོང་འཛིན་གྱི་ཚེ་གདོང་ལ་ཕྲི་ཞིང་མཇུག་འཛིན་གྱི་ཚེ་དུས་མེ་ལ་བྱིན་ནས་ལྷག་མ་ལ་གནས་རང་རང་གི་འཁོར་ལོ་དོར་ཞིང་།",
    "འདིར་མཚུར་ལུགས་པ་དག་ནི་སྦྱངས་ལྷག་གིས་ཆ་ཆེ་ཆུང་དང་འཛིན་མི་འཛིན་ཤེས་ལ་དེ་ནས་སྦྱངས་ལྷག་དེ་ཉི་བུལ་བསྲེས་པ་ལ་བྱིན་ནས་ཐིག་ལེ་བཞི་ཤར་བརྟག་པར་བྱེད་དེ་ཐིག་ལེ་གཉིས་གསུམ་ཤར་ན་ཡང་འཛིན་པ་ཙམ་དུ་འགྱུར་ལ།",
    "དབྱུག་གུར་སྦྱངས་ལྷག་བདུན་གྱི་བར་བྱུང་ན་བཅུ་སྣོན་ཞིང་དེ་ལས་མང་ན་ལྔ་བསྣན་ཏེ་དེས་རྒྱུ་སྐར་རེའི་ཡུལ་གྱི་ཆུ་ཚོད་དྲུག་ཅུ་ལ་ཕྲི་ལྷག་ཉི་མའི་ཆ་བཅུ་གཉིས་ཀྱིས་བསྒྱུར་ཏེ་ཉིན་ཞག་གི་ཆུ་ཚོད་དྲུག་ཅུས་བགོས་པའི་ཐོབ་ནོར་ནི་ཉི་མའི་ཆ་རེ་དང་ཡུན་གྱི་ཆུ་ཚོད་རེ་ཡིན་ལ་ཉི་མའི་ཆ་ནི་བཅུ་གཉིས་ཏེ།",
    "གང་མང་བ་ལ་ཉུང་གིས་ཕྲི།",
    "ཟླ་བ་དང་གདོང་མཇུག་གང་ཉེ་བརྟགས་ནས་མང་ལ་ཉུང་གིས་སྦྱང་སྟེ།",
    "༡༨༥ན་སྦྱངས་ལྷག་གི་སྐར་གནས་སྟོངས་པ་གཞིར་བྱས་ནས་ཆུ་ཚོད་དུ་བཅོ་ལྔ་མན་ལ་རིལ་འཛིན་དང་།",
    "དེ་བཞིན་དུ་ལྔ་ལྔས་ལྷག་པ་སོ་ལྔ་དང་བཞི་བཅུ་དང་ཞེ་ལྔ་རྣམས་ལ་དྲུག་ཆ་རེས་དམན་པར་བྱེད་དེ།",
    "མཚུར་ལུགས་པ་ནི་ཆུ་ཚོད་ཉི་ཤུ་མན་རིལ་འཛིན་དང་ཉེར་ལྔ་ནས་ལྔ་བཅུའི་བར་ལྔ་ཕྲག་རེ་ལ་དྲུག་ཆ་རེ་ལྷག་མར་ལུས་པར་འགྱུར་ལ།",
    "བའི་ཆ་ནི་དཀར་ནག་སོ་སོ་ལ་ཆ་བཅོ་ལྔ་རེ་ཡོད་པས་བཅུ་གཉིས་ཀྱི་ཚབ་མར་བཅོ་ལྔས་བསྒྱུར་ཏེ།",
    "སྤྱིར་གདོང་འཛིན་ནི་རི་མོ་ལྟར་འཛིན་པ་མང་ཡང་།",
    "དུས་མེ་ནི་ཅུང་ཟད་སྟོབས་ཆུང་བས་རི་མོར་ཤར་བ་ལས་ཅུང་ཟད་ཙམ་དམན་པ་ཤས་ཆེ་ལ།",
    "ཀར་འཁྲིག་གཞུ་ཆུ་སྟེ་༡༢༥བ་ལྷོ་བྱང་མཐར་ཐུག་གི་ཐོག་མཐའི་ཁྱིམ་བཞིར་འཛིན་པའི་ཆ་ཤིན་ཏུ་ཆུང་ངུར་བྱེད་དེ།",
    "གསུམ་པ་ཐུན་མོང་དུ་ཕྱོགས་དུས་ཁ་དོག་བསྟན་པ་ནི།",
    "གུང་གཉིས་ལ་མཚམས་བཞི་གང་རུང་གི་དྲང་པོ་ནས་འཛིན་ལ་ནུབ་ཀར་ཤར་ནུབ་དྲང་པོ་ནས་འཛིན་ཏོ།",
    "རེས་ཀྱི་གཟའ་ཡི་ཆུ་ཚོད་དུ།",
    "སྤྱིར་ལོ་དག་མང་པོ་ནི་རི་མོའི་ངལ་བས་དུབ་པར་འགྱུར་ལ།",
    "འོག་མ་དྲུག་གིས་རྙེད་པ་ལ།",
    "རྩིས་འཕྲོ་དངོས་ལ་རིལ་པོ་བཅུ་གཉིས་དང་ཆ་ཤས་བརྒྱད་དང་བཅོ་བརྒྱད་ཡོད་པ་བསྲེ་རིགས་ཀྱང་བྱ་དཀའ་བར་གཟིགས་ནས་རྩིས་གཞིའི་ལོ་དེའི་ནག་ཟླ་ནས་སྨིན་ཟླའི་བར་བརྒྱད་ཕྲི་སྟེ་མགོ་ཟླ་དེ་རིལ་ཆའི་རྩིས་འཕྲོར་བྱས་ནས་དེའི་དྷུ་བ་རིལ་པོ་གཅིག་གོ་ཁོ་ན་ཡོད་པས་དེ་བསྲེས་པའོ།"
  ]
}