    "དྲུག་བརྒྱ་དོན་བཞི་ཉིན་ཞག་གི།",
    "དབྱུག་གུ་བཅུ་དྲུག་དང་ནི་ཆུ་སྲང་བཅུ་བཞི་དབུགས་གཅིག་ཡན་ལག་དང་བཅས་པ་ནི་ཉིན་ཞག་གི་དཀྱིལ་འཁོར་རོ།",
    "ཞག་གསུམ་པོ་ཐུན་མོང་གི་དོན་བསྡུ་ཕྱིར།",
    "དཀྱིལ་འཁོར་སོ་སོ་འདིས་ནི་རྒྱུ་སྐར་གྱི་འཁོར་ལོ་ལ་བགོས་པས་ཐོབ་ནོར་ནི་ཞག་སོ་སོའི་ཞག་རེའི་རྟག་པའི་ལོངས་སྤྱོད་དེ།",
    "ཞག་རེའི་ལོངས་སྤྱོད་རྟོགས་པའི་ཕྱིར་གང་ཞིག་ཉིན་ཞག་གཅིག་པོ་ནི་སྐར་མ་ཉེར་བདུན་གྱིས་བསྒྱུར་ཏེ།",
    "ཐོབ་པའི་དབྱུག་གུ་ཉིན་རེ་རེ།",
    "དྲུག་གིས་བསྒྱུར་༩༡ན་བས་དབུགས་སུ་འགྱུར།",
    "ཡུལ་གྱི་ཆུ་ཚོད་མཁའ་སྟོང་བུག་རོ་ལ་མཁའ་མིག་རྒྱལ་པོ་ལ་ཞག་གསུམ་པོ་སོ་སོའི་ཉི་མའི་དཀྱིལ་འཁོར་ལོངས་སྤྱོད་དང་བཅས་པ་རྣམས་ཀྱིས་བགོས་པས་ཐོབ་པའི་དབྱུག་གུ་ནི་ཞག་སོ་སོའི་ཉིན་རེ་རེ་བཞིན་ཡུལ་སྟེང་དུ་ཆུ་ཚོད་ཇི་ཙམ་ཆོད་པའི་གྲངས་ཡིན་ལ།",
    "ལྷག་མ་དྲུག་གིས་བསྒྱུར་བ་ལ་དཀྱིལ་འཁོར་གྱིས་ཐོབ་པ་དབུགས་སུ་འགྱུར་ལ།",
    "དེ་ནས་ཡུལ་གྱི་ཆུ་ཚོད་ལ་ཁྱིམ་ཞག་གི་དཀྱིལ་འཁོར་མཁའ་དུས་མེས་བགོས་པས་ཐོབ་པ།",
    "ཁྱིམ་ཞག་རེ་ཡི་རྟག་ལོངས་ཡིན།",
    "ཉིན་ཞག་གི་དཀྱིལ་འཁོར་ལ་གནས་ཉུང་ངུས་བྱ་སླ་བའི་ཕྱིར་འདོད་ཆ་མན་བོར།",
    "དབུགས་སུ་གཅིག་གིས་བརྒྱན་པ་ཡིན།",
    "བགྲོད་པའི་དང་པོ་ཉིན་རེ་བཞིན།",
    "ངེས་པ་དེ་ལས་ཉི་སྐར་ལ་སོགས་པ་རྟོགས་པར་བྱ་བའི་དོན་དུ་རང་རང་གི་རྟག་ལོངས་འདི་དག་དབྱུག་གུ་དང་ཆུ་སྲང་ལ་སོགས་པ་རྣམས་སུ་ཉིན་རེ་རེ་ཞིང་སྦྱར་ཞིང་བསྣན་ནས་ཐོབ་ནོར་ཉི་སྐར་གྱི་གནས་སུ་གཞུག་པར་བྱའོ།",
    "བགྲོད་པའི་དང་པོ་ལྷོར་བགྲོད་པ་རྐང་པ་རིམ་པར་སྤྱོད་པ་དང་པོ་ནས་༩༢ན་བརྩམས་ཏེ་ཉིན་རེ་རེ་བཞིན་ཡང་སླར་ཡང་བྱང་དུ་བགྲོད་པར་འགྱུར་བ་རིམ་མིན་གྱི་དང་པོའི་ཆར་ཐུག་གི་བར་དུ་སྔར་གསུངས་པའི་ཉི་མའི་རྐང་པའི་ལས་རྣམས་ཆོ་ག་མ་འཁྲུགས་པ་ཡིས་ཉི་མའི་རྐང་པ་བུ་ལོན་དུ་སྦྱང་བར་བྱ་ཞིང་།",
    "ཟླ་བ་དང་མཇུག་རིང་གི་ཡང་ངེས་པ་མི་གསལ་བར་འགྱུར་བ་འདི་ནི་རྩ་བ་ཉམས་པའི་ལྗོན་ཤིང་བཞིན་ནོ།",
    "ཟླ་བའི་ལོངས་སྤྱོད་ཉིན་རེ་ལའོ།",
    "ཚེས་ཟླ་གཅིག་གི་རྟག་ལོངས་ཡིན།",
    "རི་མོ་དེ་ནི་ཟླ་བའི་ལོངས་སྤྱོད་དེ་ཉིན་རེ་རེ་བཞིན་ལ་ཟླ་བས་ཡུལ་སྟེང་དུ་ཇི་ཙམ་བགྲོད་པའི་ཆའོ།",
    "གང་གིས་ཟོས་པ་ཟླ་ཉི་མའོ།",
    "རྒྱུ་སྐར་གྱི་དབྱུག་གུའི་འཁོར་ལོ་ལས་དབྱུག་གུའི་ཐ་མའི་མཐར་ཐུག་པར་ཟླ་བའི་རང་འགྲོས་གང་གིས་ཇི་ཙམ་གྱིས་ཟོས་པའི་ཉིན་ཞག་ཉེར་བདུན་ནི་ཟླ་བའི་ཉི་མའམ་ཞག་གི་དཀྱིལ་འཁོར་ཡིན་ལ།",
    "ཞག་གི་ཆུ་ཚོད་དྲུག་ཅུ་ཡང་།",
    "ཚེས་ཞག་རེ་ལ་ཆུ་ཚོད་དྲུག་ཅུར་བྱས་པའི་འདོད་ཆ་གཅིག་གི་བར་ཁྱད་དེ།",
    "༩༣༢ཟླ་བས་ཡུལ་གྱི་འདོད་ཆ་གཅིག་སྤྱོད་པའི་རིང་ལ་ཞག་གི་འདོད་ཆ་གཅིག་དང་།",
    "འདོད་ཆ་གཅིག་གི་མིག་བདུན་མཁའ་རི་ཟླ་བའི་ཆ་བཞི་བརྒྱ་དོན་བརྒྱད་སྦྱོང་པའི་དོན་ནོ།",
    "མཁའ་མཁའ་ཆུ་འདོད་མིག་གིས་བསྒྱུར།",
    "མཁའ་མཁའ་མཚོ་འདོད་མིག་གིས་བསྒྱུར།",
    "ཐོབ་ནོར་ཟླ་བའི་ཚེས་ཞག་གི།",
    "འབད་པས་གྲུབ་པའི་རི་མོ་ཡིན།",
    "ཉིན་ཞག་དང་ཚེས་ཞག་གི་བར་ཁྱད་སྦྱངས་པས་ཤེས་ཏེ།",
    "ཉིན་ཞག་དྲུག་ཅུ་རྩ་བཞི་དང་ཉིན་ཞག་གི་རི་མཁའ་རིའི་ཆ་རེ་སོང་བ་ན་ཚེས་ཞག་དྲུག་ཅུ་རྩ་ལྔར་འགྱུར་བས་བསྒྱུར་བགོད་འདི་ལྟ་སྟེ།",
    "འོག་གི་ཆ་ཤས་གནས་གཉིས་སྦྱང་།",
    "ཚེས་རེའི་རྟག་ལོངས་རྣམ་པར་དག།",
    "ལོངས་སྤྱོད་བཙལ་ཚུལ་ནི་གཟའ་རྣམས་ཐུན་མོང་དུ་བསྟན་པར་བྱའོ།",
    "ཐུན་མོང་དུ་ལོངས་སྤྱོད་བཙལ་ཚུལ་གཉིས་ཀྱི་དང་པོ་ནི།",
    "རང་གི་རྐང་པའི་དཀྱིལ་འཁོར་གྱི་འགྲོས་ཀྱིས་རྒྱུ་བས་མགྱོགས་བུལ་ཐ་དད་པར་གནས་སོ།",
    "མྱུར་རྐང་གི་དཀྱིལ་འཁོར་དང་མྱུར་རྐང་གི་རྐང་འཛིན་རྟག་ལོངས་ཙམ་རེ་འདིར་འཆད་དོ།",
    "མྱུར་རྐང་གི་རྐང་དཀྱིལ་དང་རྐང་འཛིན་མི་འཆད་དེ།",
    "ཉིན་མའི་ཉིན་ཞག་གི་དཀྱིལ་འཁོར་ཉིད་དྲག་གཟའི་མྱུར་རྐང་གི་རྐང་དཀྱིལ་ཡིན་པའི་ཕྱིར་དང་།",
    "མྱུར་རྐང་གི་རྐང་འཛིན་ཡང་ཉིན་རྩིས་ཀྱི་ཉི་བར་དལ་དག་གིས་དམན་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཏེ།",
    "དེས་ན་ཞི་གཟའི་མྱུར་རྐང་གི་དཀྱིལ་འཁོར་ནི།",
    "དྲག་གཟའ་གསུམ་གྱི་དལ་རྐང་གི་དཀྱིལ་འཁོར་ནི།",
    "འོན་ཀྱང་ཐོབ་པ་ནི་མ་ཡིན་ཏེ་གཟའ་ལྔ་སྒྲ་གཅན་དང་བཅས་པ་སུས་ཀྱང་ཞག་རེ་ལ་སྐར་ཁོངས་རེ་བགྲོད་མི་ནུས་པའི་ཕྱིར་རོ།",
    "བགོས་པའི་ལྷག་མའམ་མ་ཐོབ་ན་བགོ་བྱ་དེ་ཉིད་ཆུ་ཚོད་ཀྱི་དོན་དུ་དྲུག་ཅུས་བསྒྱུར་ནས་ཡང་དཀྱིལ་འཁོར་གྱིས་ཐོབ་པ་ནི་དབྱུག་གུའམ་ཆུ་ཚོད་དེ་གཟའ་རང་རང་གིས་ཞག་རེ་ལ་ཡུལ་སྟེང་དུ་རང་འགྲོས་ཀྱིས་ཆུ་ཚོད་ཇི་ཙམ་སྤྱད་པའི་གྲངས་ཡིན་ལ།",
    "ལྷག་སངས་ཀྱིས་ནི་མྱུར་རྐང་གིས་ཇི་ཙམ་སྤྱད་པའི་ལོངས་སྤྱོད་ཀྱི་ཆུ་ཚོད་དོ།",
    "དེ་བཞིན་དུ་སླར་ཡང་ལྷག་མ་དྲུག་གིས་བསྒྱུར་ནས་དཀྱིལ་འཁོར་ཆས་ཐོབ་པ་དབུགས་དང་།",
    "དེ་ལྟར་དཀྱིལ་འཁོར་གྱི་ཆ་ཡིས་ནི་རྣམ་པར་ཕྱེ་བས་ཐོབ་པ་དེ་རྣམས་གཟའ་གཞན་གྱི་ཞག་རེའི་རྟག་ལོངས་དང་།",
    "ལྷག་སངས་ཀྱི་ཞག་རེའི་མྱུར་རྐང་གི་ལོངས་སྤྱོད་ཀྱི་རི་མོའོ།",
    "རི་དང་རྒྱལ་བ་མིག་གིས་བགོ།",
    "དབུགས་སུ་རྩེ་མོ་འདོད་ཆ་ལྔ།",
    "གལ་ཏེ་སྒྲ་གཅན་གྱི་ཚེས་ལོངས་ལས་ཉིན་ཞག་གི་ལོངས་སྤྱོད་དུ་སྒྲུབ་པར་འདོད་ཀྱང་སྒྲ་གཅན་གྱི་ཚེས་ཞག་ལས་ཉིན་ཞག་ཏུ་བྱས་པས་ཉིན་ཞག་གི་དཀྱིལ་འཁོར་གྲུབ།",
    "དེ་ལ་ཀླུ་ལག་སྦྲུལ་མིག་གིས།",
    "ཀླུ་ལག་སྦྲུལ་མིག་གིས་བསྒྱུར་ཏེ།",
    "གཟའ་ལྔ་པོ་ལ་ཚེས་ཞག་གི་ལོངས་སྤྱོད་འཚོལ་འདོད་ཀྱང་།",
    "དཀྱིལ་འཁོར་ཉིན་ཞག་ལས་ཚེས་ཞག་ཏུ་བསྒྲུབས་ཤིང་གནས་གཅིག་ཏུ་སྡུད་པ་སོགས་རིགས་འགྲེས་པས་ཤེས་མོད་ཀྱི་དགོས་པ་ཆུང་བའི་ཕྱིར་མ་བཀོད་དོ།",
    "རི་མོར་དུ་མ་གནས་པ་ཉིད།",
    "ཉིན་རེ་རེ་ཞིང་རྟག་ལོངས་དེ་དག་ཉིད་བསྣན་པར་བྱས་ནས་ནི་གཟའ་ལྔ་པོ་སོ་སོ་ཡི་ལོངས་སྤྱོད་དལ་རྐང་ཆོ་ག་བཞིན་བསྒྲུབས་པ་ཉིད་ཀྱིས་སྦྱངས་པ་སྟེ།",
    "རྐང་པ་རྣམ་པར་དག་པར་བྱས་པས་གཟའ་རང་རང་གི་དལ་བ་དག་པར་འགྱུར་རོ།",
    "དལ་བ་དག་པར་བྱས་པའི་རྗེས་དེ་ནས་མྱུར་དག་གི་ཚུལ་ནི་དྲག་གཟའ་ལ་རིམ་རིམ་མིན་གྱི་བགྲོད་པ་གང་ལ་གནས་པའི་དལ་དག་གིས་ཉིན་ཞག་དེའི་ཉི་མ་བར་པ་ལ་སྦྱང་ཞིང་མྱུར་རྐང་གི་ལས་བྱའོ།",
    "ཞི་གཟའ་ལ་ཉི་མ་བར་པ་ཡིས་ནི་ཁྱིམ་གྱི་ཟླ་བ་དང་མཚུངས་པར་བགྲོད་པའི་དལ་རྐང་གི་ལོངས་སྤྱོད་ཀྱི་ཆ་གཅིག་གནས་པ་རྐང་འཛིན་སྦྱང་བ་སོགས་མྱུར་རྐང་གི་ལས་བྱེད་དོ།",
    "ཚེས་དག་གི་ནི་གཉིས་དབུས་སུ།",
    "ནག་པོའི་ཕྱོགས་ཀྱི་ཐ་མ་གནམ་སྟོང་གི་མཐའ་དང་།",
    "དཀར་པོའི་དང་པོ་ཚེས་གཅིག་གི་ཚེས་མཚམས་དག་གི་ནི་ཚེས་དེ་དག་གཉིས་ཀྱིས་དབུས་སུ་ཟླ་བ་དང་ཉི་མ་ཁ་སྦྱོར་ཞིང་སྟེང་ནས་ནུབ་ཕྱོགས་གཙོ་ཆེ་བ་ནས་སྒྲ་གཅན་གྱིས་འཛིན་པར་བྱེད་པའོ།",
    "སྟེང་གི་ཕུང་པོར་ནོར་དུ་བྱིན།",
    "སླར་ཡང་ལྷག་མ་དྲུག་གིས་བསྒྱུར།",
    "སྟེང་གི་ཕུང་པོར་བུ་ལོན་དབྲོག།",
    "ཐོབ་པ་ཞག་རེའི་ཆུ་ཚོད་དོ།",
    "དྲུག་གིས་བསྒྱུར་ལས་དབུགས་སུ་འགྱུར།",
    "ཆུ་སྲང་དབུགས་ནི་གང་དག་གིས།",
    "བགྲོད་པའི་རི་མོ་ལ་གནས་པ།",
    "གསང་བ་མཆོག་གི་རིགས་ཀུན་འདུས་པའི་སྣ་ཚོགས་ཡུམ་གྱིས་དགྱེས་དགུར་རོལ།",
    "དེ་འདིར་བདག་གིས་རྣམ་པར་དབྱེ།",
    "གོ་ལ་མཉམ་པའི་རི་མོ་སྟེ།",
    "སའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་རི་རབ་ལྷུན་པོ་རྡོ་རྗེ་རྩེ་ལྔ་པའི་རྣམ་པ་ཅན་དཔངས་སུ་དཔག་ཚད་འབུམ་ཕྲག་གཅིག་སྟེ་ནང་ལུས་ལ་རྐེད་པ་ནས་མགྲིན་པའི་འོག་གི་བར་ཁྲུ་གང་ངོ།",
    "གཟུགས་མེད་བཞི་སྟེ་སྲིད་རྩེའི་མཐར་ཐུག་གི་བར་ཏེ་ནང་ལེ་དང་ཡེ་ཤེས་ལེའུར་ཕྱི་ནང་དག་པ་སྦྱར་བའི་ཤུགས་ཀྱིས་ཐོབ་ཅིང་།",
    "དེ་ནི་ས་ཡི་སྟེང་གི་གནས་སུ་ལུས་ལ་རང་རང་དག་གི་ཚད་ཀྱིས་ཡང་དག་ཁྲུ་གང་ངོ།",
    "མཐོང་མཚམས་ཀྱི་རྩ་བ་ས་གཞི་དག་གི་གནས་ལ་ཐད་ཀའི་ཚད་བརྒྱར་དཔག་ཚད་སྟོང་ཕྲག་བཅུ་དྲུག།",
    "སྟེང་གི་ཐད་ཀའི་ཚད་སྟོང་ཕྲག་ལྔ་བཅུ།",
    "རྡོ་རྗེའི་སྟེང་གི་རྭའི་རྩེ་མོ་ལྔ་ལས་དབུས་མ་སྲོག་ཤིང་གི་ཚུལ་དང་།",
    "གླིང་སོ་སོའི་རྩ་བར་རྒྱ་མཚོ་རེ་ཡོད་པས་རྒྱ་མཚོ་བདུན་ཏེ།",
    "འོད་སྔོན་དང་མན་ད་ར་དང་མཚན་མོ་དང་ནོར་བུར་བྱེད་དང་བྲེ་བོ་དང་བསིལ་བའི་རི་དང་བདུན་པ་ནི་རྡོ་རྗེའི་རི་སྟེ་ཕྱི་རོལ་གྱི་མུ་ཁྱུད་ཆེན་པོའོ།",
    "དེས་ན་ལས་སའི་དཀྱིལ་འཁོར་སྟོང་ཕྲག་ཉེར་ལྔ་དང་ལན་ཚྭའི་རྒྱ་མཚོ་སྟོང་ཕྲག་ལྔ་བཅུ་བསྡོམས་པས་དཔག་ཚད་བདུན་ཁྲི་ལྔ་སྟོང་གི་དབུས་དྲང་པོ་ནི་ཉིན་མཚན་མཉམ་དུས་ཀྱི་ཉི་མ་རྒྱུ་སའི་ཚངས་ཐིག་སྟེ།",
    "དབུས་སུ་འཁོར་ལོ་ཕྱེད་ཀྱི་རི་མོའི་ཉི་མའི་བགྲོད་པ་དག་ཀྱང་ཉིན་མཚན་གཅིག་ནི་མཉམ་པ་ལའོ།",
    "ཕྲ་རབ་བརྒྱད་རྣམས་ཀྱིས་ནི་ཕྲ་མོ་འདི་གཅིག་ཕྲ་མོ་བརྒྱད་ཀྱིས་སྐྲ་ཡི་རྩེ་མོ་ཕྲ་མོ་སྟེ།",
    "འདི་རྣམས་ཀྱིས་ནི་སྐྱེ་ཚེ་ཤིག་དང་ནས་ཏེ་ལྟོས་འགྲོའི་ནས་ཀྱིས་སོར་དང་སོར་མོ་ཉི་མ་ནི།",
    "༡༨བ་ཟུང་གིས་ཁྲུའོ་ཁྲུ་བཞིས་གཞུ་སྟེ་འདིར་ནི་སྟོང་ཕྲག་གཉིས་ཀྱི་གཞུ་ཡིས་རྒྱང་གྲགས་དག་ཏུ་འགྱུར།",
    "ནུས་དང་གཙོ་བོའི་ཉིན་ཞག་གཅིག་གི་ཚད་དེ།",
    "བཞི་པ་དང་ལྔ་པར་བསྐལ་པ་མཆོག་གི་ཚེའོ།",
    "དེ་ཡང་ཆུ་ཞེང་དུ་དཔག་ཚད་རེ་ཡོད་པའི་དོང་ངམ་ཁུང་བུ་མིའི་སྐྲ་རྩེ་ཟླུམ་པོར་གཏུབས་པས་བཀང་སྟེ་ལོ་བརྒྱ་ན་སྐྲ་རྩེ་རེ་ཕྱིར་ཕྱུང་བས་སྟོང་པར་གྱུར་པ་ནི་བསྐལ་པ་ཆུང་ངུའི་ཉིན་ཞག་གཅིག་ཡིན་ལ།",
    "བསྐལ་པ་བར་མ་ལ་ཉིན་ཞག་ཏུ་བརྩིས་པའི་ལོ་བརྒྱ་ནི་མཆོག་གི་བསྐལ་པའོ།",
    "འཇིག་རྟེན་ཉེ་བར་སྡུད་པའི་ཚེ་ནི་འཇིག་རྟེན་ཆགས་པ་ནས་མ་ཞིག་གི་བར་རོ།",
    "དེས་ན་ཚངས་རིས་སུ་བར་གྱི་བསྐལ་པ་གཅིག་གི་ཚེའོ།",
