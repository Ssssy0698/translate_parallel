    "ཅུང་ཟད་ཤོར་སོང་ཕ་ལོས་གསན་དགོངས་ན།",
    "ད་ནི་ཨ་མས་བཞག་པའི་ཁ་ཆེམས་དང་།",
    "རེ་ལུགས་དོན་དུ་བདག་གིས་མ་འཁྱོལ་བས།",
    "ཀྱེ་མ་དུས་གསུམ་སྟེང་ན་གཟིགས་པའི་ལྷ།",
    "བརྩེ་བའི་སྤྱན་ཞིག་ཡོད་ན་གཟིགས་པར་མཛོད།",
    "བུང་བས་བྲོ་རྡུང་གཤོག་སྒྲོའི་གླུ་ལ་ཁྱོ་བྲལ་སེམས་པའི་མཆི་མ་གཡོ།",
    "འདབ་ཆགས་འཇོལ་མོས་གཡུ་ལོའི་ཕག་ན་ཁེར་རྐྱང་སྐྱོ་བ་ཀྱུར་ཀྱུར་སྒྲོག།",
    "རྒྱང་འབུད་གླིང་བུའི་གདངས་སྙན་ཕྲ་མོ་སྨྲེང་སེམསཾ་ན་བུན་རི་ན་འཐིབས།",
    "ནམ་མཁའི་སྐར་མ་ལྷེམ་ལྷེམ་འདར་དུས་ད་དུང་རེ་བའི་ཕེབས་སྒུག་གིས།",
    "རེ་སྦྲ་ནག་པོའི་ཁ་ཚུབ་བར་ནས་ཟླ་འོད་འཐུང་བའི་མཚན་མོ་བཏུས།",
    "དེ་ལྟའི་ང་ཡི་དྲྭན་ངོགས་རི་མོ་མིག་ཆུས་བྲིས་པའི་འཇིག་རྟེན་དེ།",
    "དུང་ཞེན་སེམས་ཀྱི་འོ་མ་དཀར་པོ་ནམ་ཡང་ཁྱོད་ཚོར་སྦྲེལ་བ་དེས།",
    "སྙཤིང་ལོ་ལྷུང་བའི་རྗེས་དྲན་སྐྱུར་མོ་ས་མཐའ་གཞན་ནས་རོལ་བའི་དུས།",
    "ཤ་ཁྲག་འདི་ཡང་ཁྱོད་ཚོར་གཏོགས་པའི་སེམས་ཚོར་དྲག་ཏུ་འབར་བའི་མེ།",
    "དེ་ལྟར་གྱེས་བྲལ་རྐང་རྗེས་ཕྲ་མོ་ཁ་བའི་ཡུལ་དུ་བཞག་ཉིན་ནས།",
    "ཕྱག་བརྒྱ་ཉིན་རེར་དགོས་ཀྱང་འཚལ་སྐད་ཟེར།",
    "ཕྲག་དོག་དུག་ལྕེ་བརྐྱངས་འདིས་ཞེ་རེ་ཕམ།",
    "གལ་ལ་ཐུག་དུས་གར་སོང་ཆ་མེད་པས།",
    "ང་ནི་འཇིག་རྟེན་ཁམས་ལ་རེ་ཐག་ཆད།",
    "རེ་བའི་ཨ་ཐང་ཆད་པའི་བདག་འདྲ་ལ།",
    "ཡིདྲན་མགུར་སྐྱུར་མོ།",
    "རེ་དྭོགས་ཚོར་འདུའི་གློག་ཞགས་སེམས་ཁོང་ནས་འཐབ་སྟེ།",
    "བྱམས་བརྩེའི་འོད་ཁ་གང་བའི་ཨ་མ་ཁྱོད་དྲན་བྱུང་།",
    "ཐུགས་རྗེའི་གྲིབ་བསིལ་སྣུམ་པོའི་ཨ་མ་ཁྱོད་དྲན་བྱུང་།",
    "བརྩེ་ཆེན་ནུ་ཞོ་བསྣུན་པའི་ཨ་མ་ཁྱོད་དྲན་བྱུང་།",
    "ཕྱི་ནང་ལང་ཚོ་དར་བས་འགྲིགས་འགྲིགས་ཤིག་བྱས་ཏེ།",
    "གཉེན་གྲོགས་ནང་གཏམ་གླེང་མཁན་མང་མང་དུ་སྣང་མོད།",
    "འཛུམ་དཀར་དུང་སོའི་ཁ་ན་སྤུ་གྲི་རེ་འདུག་པས།",
    "ཨ་མ་ཁྱོད་ལ་བདེ་བའི་གོ་སྐབས་ཤིག་ཨེ་ཡོད།",
    "འཛུམ་དང་ལྷན་ཅིག་སྩོལ་མཛད་ཨ་མ་ཁྱོད་དྲན་ན།",
    "ངུ་ངག་ཤུགས་ཀྱིས་ཨ་མ་ལཾན་མང་དུ་འབོད་འདོད།",
    "ཨ་མ་ཨ་མ་དྲིན་ཆེན་མ་མ་ཁྱེད་དྲན་ནས།",
    "ཨ་མ་ཨ་མ་མི་ཡི་སྒྲོལ་མ་ཁྱེད་མེད་པས།",
    "ཨ་མ་ཨ་མ་ལྷ་ཡི་དུང་ཟླ་ཁྱེད་མེད་པས།",
    "ཨ་མ་ཨ་མ་འདོད་འཛོའི་ནོར་བུ་ཁྱེད་མེད་པས།",
    "རྣམ་དཔྱོད་འོད་ཀྱི་ལང་ཚོ་བཀྲ་བ་ཡི།",
    "གང་གི་གཅེས་པར་བསྐྱངས་པའི་བཀའ་དྲིན་རྡུལ།",
    "བརྗེད་པའི་གོ་སྐབས་ཆུ་སྒྲོགས་མཐའ་ལ་སོང་།",
    "དེ་ལྟར་སྐྱིད་སྡུག་རེས་ཀྱི་ནགས་ཀློང་ནས།",
    "མྱུར་མགྱོགས་ཁྱོད་ཞལ་མཐོང་ལ་བྲེལ་བ་ཡིས།",
    "ཁྱོད་ཐུགས་མཉེས་ཕྱིར་གངས་རིའི་སུལ་དུ་མཆོད།",
    "ངུར་སྨྲིག་ལྭ་བའི་འོག་གི་སྤྱང་ཀི་ངའི་ལུས་ལ།",
    "གཤིན་རྗེ་བེར་ཀས་བྲབས་ན་ཐུགས་རྗེ་ཞིག་གཟིགས་རོགས།",
    "ཕྱི་མའི་ཡུལ་ནས་ཤ་ལན་ར་ལུག་གིས་བསུས་ཏེ།",
    "གཤིན་རྗེ་དམག་གིས་བསྐོར་དུས་ཐུགས་རྗེ་ཞིག་གཟིགས་རོགས།",
    "མནར་མེད་མེ་ལྕེ་མཆེད་དུས་ཐུགས་རྗེ་ཞིག་གཟིགས་རོགས།",
    "བརྩེ་ཆེན་འོད་ཀྱི་ཕྱག་གིས་ལམ་སྣ་ཞིག་འདྲེན་རོགས།",
    "རྒྱུང་རིང་གི་རེ་འབོད།",
    "འཆར་ཀའི་མདངས་འགྲན་བྱུ་རུའི་ལང་ཚོ་འགྲམ་པའི་མེ་ཏོག་སྡུག་གུར་བཞད།",
    "བསྐལ་བའི་ས་ན་ཆད་པ་མེད་ད་ར་བརྩེ་བའི་གཟིགས་པ་ཆེ་བར་མཛོད།",
    "སྒྲ་རིག་ངག་གི་གད་རྒྱངས་སྙན་སྒྲོག་རིང་ན་གདོང་ལྔའི་སྒྲ་དབྱངས་བཞིན།",
    "བསིལ་ལྗོངས་མ་མའི་དོན་ཆེན་མ་བརྗེད་རེ་བ་ཆེ་བའི་བུ་རྒོད་ཚོ།",
    "དེ་ལྟར་འདི་ན་རེ་བའི་འདབ་མ་ལྷུག་པོར་གྲོལ་བ་པདྨའི་ཁ།",
    "སྐྱོ་སྡུག་འཁྱགས་ལ་འབྱར་སོང་ཆུང་འདྲིས་རོགས།",
    "རེ་སྒུག་ཡོད་ཚད་སྦས་པའི་ནགས་ཀློང་དེར།",
    "སླར་ཡང་དགུན་ཁ་བསླེབས་སོང་ཆུང་འདྲིས་རོགས།",
    "སྐར་མ་ལྷེམ་ལྷེམ་འདར་བའི་དགུང་མོ་དེར།",
    "ཕེབས་སྒུག་ལོ་ཟླ་རིང་བའི་སྐྱོ་གདུང་གིས།",
    "ལས་ངན་བུ་མོའི་རེ་ཐག་བཅད་གྱུར་པས།",
    "བརྩེ་ཆེན་ཕ་མའི་བང་གི་གཅེསཕྲུག་མ།",
    "ནམ་ཡང་མི་བརྗེད་སེམས་སོང་ཆུང་འདྲིས་རོགས།",
    "ཐུགས་སེམས་མ་སྐྱོ་བུ་མོའི་ལས་སྐལ་ཡིན།",
    "བས་མཐའ་འདིར་གསང་སྔགས་ཟབ་མོ་ཁྲོམ་སྒྲོག་བྱེད་པའི་སྙིགས་དུས་ཕྱི་རྟོགས་ལྡན་པ་ཞིག་ལ་ཕུལ།",
    "རེ་བ་ཤ་ཟའི་རྒྱང་ན་འབོད་པ་ཅེ་སྤྱང་ངུ་ཟུག་འཕུར་བའི་སྒྲ།",
    "ཡུགས་མོ་སྟོང་གི་མགོ་སྐྱེས་དང་བཅས་ཐེའུ་རང་ལག་པས་ཁྱོད་ལ་སྲུངས།",
    "འཚོལ་སྒྲུབ་གཡུལ་ལ་གཅིག་ཏུ་དཔའ་བ་ཐར་བའི་སྲོག་འཕྲོག་ཁྱོད་ལ་ལྟ།",
    "ཁྱོད་ཀྱིས་འཇིག་རྟེན་དབྱེན་གྱི་འཕྲུལ་འཁོར་ལྷག་བསམ་ཟོལ་གྱིས་ཁ་ལོ་བསྒྱུར།",
    "ཁྱོད་ཀྱིས་རྒྱུ་འབྲས་དཀྱིལ་འཁོར་རི་མོ་གཡོ་སྒྱུའི་རླབས་ཀྱིས་སྣང་མེད་གཅོད།",
    "ཁྱོད་ཀྱིས་རང་དོན་རྟ་ཡི་གོ་བ་མི་མངོན་རྐང་པས་དམར་བོར་མཉེད།",
    "ཁ་ཅིག་ཁྱོད་ལ་སྐྱབས་སུ་འཆི་ཞིང་ལ་ལས་ཁྱོད་ཉིད་སྤྱང་ཀིར་སྨྲ།",
    "ཁ་ཅིག་ཁྱོད་ལ་དམོད་པ་བོར་ཞིང་གཞན་དག་ཁྱོད་ལ་བསྟོད་བསྔགས་བྱེད།",
    "ཁ་ཅིག་ཁྱོད་ལ་ལྐོག་ནས་སྨོད་ཅིང་མཁས་རྣམས་དེ་ལ་ཡི་ག་ལོག།",
    "སྐབས་འགར་ཁྱོད་ནི་དྲང་སྲོང་གཟུགས་ཀྱིས་རི་དྭགས་ཚལ་ན་སྐྱོ་ཤས་བསྟེན།",
    "མཚམས་རེར་ཁྱོད་ཀྱིས་འབྱོར་བ་བཏེགས་ཏེ་མཛེས་མའི་ཚོགས་ལ་རྣམ་པར་རོལ།",
    "འདི་ལྟར་ཁྱོད་ཀྱི་རྣམ་པར་ཐར་བ་བྱིས་པའི་བློ་ལ་ནམ་མཁའི་མཐའ།",
    "ཅུང་ཟད་བརྗོད་པ་དག་གི་རོལ་མོ་འཁྲུལ་བའི་ཆ་མཆིས་བླུན་པོའི་གཏམ།",
    "ངོ་མཚར་ནང་ནས་ངོ་མཚར་རྨད་བྱུང་ཁྱོད་ནི་ཕྱི་མར་སྐྲག་མི་འགྱུར།",
    "ལས་ཀྱི་གཤིན་རྗེ་ཁྱོད་ཀྱི་མཐའ་ན་རིང་དུ་བྲོས་ཤིང་མཐོང་མི་འགྱུར།",
    "མི་འགྱུར་དཔལ་འདི་སུ་ལ་མངའ་བ་དེ་ལ་བདག་གིས་ཕྱག་བགྱིའོ།",
    "བྲམ་ཟེ་གཏུམ་པོའི་རྐང་རྡུལ་གཙུག་གིས་བཀུར།",
    "རི་ལུང་ཁྲི་ཕྲག་རྐང་བས་བགྲོད་དེ་སོང་།",
    "སྲོག་གིས་ཉོས་པའི་ཕྱི་གཏེར་ནང་ལ་དྲངས།",
    "མུན་པའི་གྲོང་ཚོ་དེ་ནས་དེ་ལྟར་བཞུད།",
    "བཙན་འཛུལ་དགྲ་བོའི་རལ་གྲིའི་སོ་ཁ་ཁྲག་གི་ཡིག་འབྲི་རེ་རེས་བཅགས།",
    "འཇིགས་མེད་སྟག་གི་བློ་སྟོབས་རྒྱས་པས་ལ་རྒྱའི་དབུ་འཕང་དགོང་ལས་མཐོ།",
    "ཁྱོད་ཀྱི་འཛུམ་དཀར་འོད་ཀྱིས་བཏང་བས་རི་ལུང་རྩི་ཤིང་སྐྱོ་བས་ཁེངས།",
    "ཞལ་གསུང་མངར་མོའི་རྒྱུ་བ་ཆད་པས་མགོ་ནག་བོད་ཁམས་སྡུག་གིས་གཟེར།",
    "ཞལ་རས་དཀར་པོ་དུང་གི་ཟླ་བ་དག་པའི་ཞིང་དུ་མ་བཞུད་གོང་།",
    "དགོངས་དང་བརྩེ་ཆེན་བདུད་རྩིའི་དཀྱིལ་འཁོར་ཀུན་གཟིགས་བདེ་ལྡན་ཞིང་གི་མགོན།",
    "མྱ་ངམ་ཐང་གི་ཞབས་རྗེས་ཤིག་ལ་སྨྲེང་སེམས་མཆི་མ་ཁོང་ནས་ཤོར།",
    "བདེན་པའི་ལོ་ཟླ་རིགས་པས་བཏེགས་ཏེ་འཇིགས་མེད་སྟག་གི་ངར་སྒྲ་བསྒྲགས།",
    "ལ་ལས་ཁྱོད་ལ་ལྟོས་ངན་འབར་བའི་ལྟ་ལོག་ཚེར་མའི་རལ་གྲི་ཟེར།",
    "འགའ་ཞིག་ཁྱོད་རང་ཕྱོགས་ཞེན་རྒོད་པའི་གསར་འབྱོར་གཅན་གཟན་གཏུམ་པོར་གླེང་།",
    "རིགས་མཐུན་དཔའ་བོའི་ལ་རྒྱའི་མེ་ལྕེ་སུ་དང་གང་གིས་མ་ཁོགས་པར།",
    "ཞུམ་མེད་སྤོབས་པའི་ལག་སྙོབ་གཅིག་གིས་སྨག་གི་སེང་རས་ཧར་གྱིས་བཀོག།",
    "རང་ལུས་འོད་ཀྱི་སྐར་ཆེན་དེ་ནི་སྨག་གི་ཡོལ་བས་མཐའ་ནས་བསྐོར།",
    "ཁྱོད་ཀྱི་ཡ་ཆུང་གློ་མཆིན་བར་ན་རིགས་ཞེན་གཙང་མའི་ཆུ་རྒྱུན་ཞིག།",
    "ཁྱོད་ཀྱི་མ་ཆུང་བདེ་མོའི་ཐང་ན་ལྷག་བསམ་ཡངས་པའི་གླིང་ཀ་ཞིག།",
    "མྱུར་གསལ་ཀླད་པའི་འཁྲུག་ཤད་རེ་ལ་གནམ་ལྕགས་ཐོག་གི་མགར་ཁ་རེ།",
    "རེ་བ་ཁྲི་ཕྲག་བརྩེགས་པའི་གཞིས་ཁྱིམ་ན།",
    "འདས་སོང་ལོ་ཟླ་དྲན་ནས་སླར་ཡང་ངུས།",
    "ལོ་གྲངས་མཛུབ་མོར་བགྲང་ཞོར་འགྲམ་པར་གླན།",
    "རེ་བའི་འདོད་པ་རྫོགས་མེད་ཕ་ལོ་ལགས།",
    "རྟ་ནོར་ལུག་དང་འགྲོགས་ནས་ལང་ཚོ་ཟད།",
    "བུ་མོ་གནས་ལ་བརྫངས་ཏེ་ཡོད་ཚད་བྱིན།",
    "༢༡ ༧ ༢མཚན་མོ་རྨི་ལམ་ནང་ཕ་རྒན་དང་མཇལ་རྗེས།",
    "རྒས་གཉེར་རི་མོ་འདིར་བལྟས་ན།",
    "ཤ་རུས་བརྩེ་དུང་གིས་ལན་པས།",
    "གཙང་གིས་ཨོ་ལོ་ཡང་ཟེར་མྱོང་།",
    "གཙང་གི་ཨོ་ལོ་ཡང་རྒས་སོང་།",
    "དབུས་པའི་བུ་ཆུང་ཡང་འཁོགས་སོང་།",
    "རྒས་མེད་སྙན་ངག་གི་གླུ་འདི།",
    "ཞྭ་མོ་ཟུར་གོན་ཞིག་བྱས་ཏེ།",
    "འབྲོག་གླུ་སངས་མོ་ཞིག་ལེན་དུས།",
    "རང་བྱུང་མེ་ཏོག་གིས་མཛེས་པའི།",
    "ཏ་རེ་ན་ཆུང་གི་བསླུ་བྲིད།",
    "ན་ཆུང་བུ་མོ་ཞིག་གི་བརྩེ་གདུང་གི་བཟི་ཁས།",
    "གོམས་འདྲིས་སླ་བར་མ་གྱུར་དཀའ་སྡུག་གིས་བགྲོད་ཅིང་།",
    "གྲོགས་མེད་ཁེར་འཁྱར་ལོ་ཟླ་རིང་མོ་ཞིག་ཟད་མཐར།",
    "ན་ཆུང་བུ་མོ་ཞིག་གི་ཟུར་མིག་གི་ཞགས་སྣེ།",
    "ཏུ་རེ་ན་ཆུང་ཞིག་གི་བསླུ་ལུགས་ལ་བརྟེན་ནས།",
    "ཕོ་གསར་རྒོད་པོའི་རང་ཚུགས་སྐད་ཅིག་ལ་ཞིག་སོང་།",
    "རྒྱུས་མེད་ན་ཆུང་ཞིག་གི་ཚིག་སྣེ་ལ་ཐོགས་ནས།",
    "ཐུན་གསུམ་གཉིད་ཀྱི་རྨི་ལམ་སྔས་གཞི་ལ་བཞུར་སོང་།",
    "ཏུ་རེ་ན་ཆུང་ཞིག་གི་བསླུ་བྲིད་ཀྱིས་དྲངས་ཏེ།",
    "དྲན་གདུང་མཆི་མ་རྒྱུས་མེད་ནགས་ཀློང་ལ་འཐོར་སོང་།",
    "ན་ཆུང་བུ་མོ་ཞིག་གི་བསླུ་བྲིད་ཀྱི་རྙི་ལ།",
    "རང་ལུས་མགོ་རྔ་མེད་པར་འཛུལ་རྐྱང་རང་བྱས་སོང་།",
    "གླེན་པ་བདག་འདྲའི་ལས་ལ་ཐུགས་བློ་རེ་སྤྲོ་ན།",
    "ཅོ་ཐོགས་མོ་ལུས་བླངས་ཚུལ་འདྲ་འདྲ་རང་ཡིན་པས།",
    "ཏ་རེ་འཕགས་མ་དེ་ཡང་འདི་འདྲ་ལས་མ་འདས།",
    "ཨ་མཚར་རྩེད་མོ་གཏམ་འདིས་འདྲོགས་སྣང་ཡང་མ་སྐྱེས།",
    "མ་བཅོས་སེམས་ཀྱི་ཚོར་བ་ངག་སྒོ་ལས་ཤོར་སོང་།",
    "དེ་རིང་གྲོགས་དག་ཚོགས་པའི་དབུས་སུ་བདག་གི་སྐྱོ་བ་རེ་ཞིག་སངས།",
    "ཟང་ཟིང་གྲོང་གི་ཁྲོམ་ལམ་བར་ནས་སྡུག་སེམས་རེ་ཞིག་བག་ལ་ཞ།",
    "མཆི་མ་འདི་འདྲ་ཁྱོད་ཀྱི་སྤྱན་ལ་བདག་གདོང་ཁྲེལ་མེད་མིག་ལས་བཞུར།",
    "རང་ལུས་སྟེང་གི་འབུ་སྙུན་རྣམས་ཀྱིས་མགོ་རྔ་མེད་པར་ཅག་ཅག་ཟོས།",
    "ཕ་མ་བཀྲོངས་པའི་ཁྲག་གི་ཆུ་བོ་བདག་གི་མདུན་ན་ཐུར་དུ་རྒྱུག།",
    "ཕུ་ནུ་བསད་པའི་རོ་རུས་རྣམས་ཀྱིས་བདག་གི་མཐོང་ལམ་སྔོན་ནས་བཀག།",
    "གྲོགས་དག་བྲེལ་ངང་དགྲ་ངོ་སྲུང་ཕྱིར་བདག་གི་གནས་བབ་སུ་ལ་ཞུ།",
    "དགྲ་གཉེན་ཀུན་གྱི་རྐང་རྡུལ་ཁྲོད་ནས་བདག་གི་གནས་བབ་སུ་ལ་ཞུ།",
    "བྱ་བརྒྱ་འུར་གྱིས་འཕུར་ཐེངས་ཤིག་གིས་བདག་ལ་མལ་སའི་དྲོད་གྲང་གླེང་།",
    "མི་ཚོའི་གཅེས་ཕྲུག་ཧབ་དགོད་ཁྲོད་ནས་བདག་གིས་ཨ་མའི་པང་ཁ་དྲན།",
    "ཁེར་སྐྱེས་ལྗོན་པའི་འདབ་ལོ་ལྷུང་དུས་བདག་གིས་སྐྱོ་བས་ཤི་སྟངས་རྟོགས།",
    "ས་སྲོད་དུས་ཀྱི་བསམ་གཞིགས་འདི་འདྲས་བདག་གི་སེམས་རྩ་འཁྱགས་ལ་སྦྱར།",
    "བཞུད་ཅིག་ཁྱོད་རང་ནུབ་ཏུ་བཞུད་ལ་རང་སེམས་སྐྱིད་པའི་གནས་མལ་ཟུངས།",
    "སྐྱེ་ལུས་འཁྲི་ཤིང་གི་ལྡེམ་མྱུར།",
    "བྱུ་རུའི་ནགས་ཀློང་དུ་ཕྱོགས་སོང་།",
    "དགའ་བ་གཏན་ཞིང་གི་འཇུག་ངོགས།",
    "མིག་ཆུ་དྲོན་མོ་ཞིག་ལྷུང་སོང་།",
    "ངུར་སྨུག་སྒྲོ་ཐུལ་དེའི་འོག་གི།",
    "ཕུག་རོན་སྔོན་མོ་དེར་བཅོལ་ཡོད།",
    "འདོད་རྒུ་ཀུན་འབྱུང་གི་ཐར་བ།",
    "བདག་པོར་བརྩེ་ཞིང་དུང་བའི་ཁྱི་གུ་ཁྱོད།",
    "ང་ལ་རེ་བའི་སྲོག་ལྡན་གཅིག་པུ་ཉིད།",
    "རྐང་ཁར་ལངས་ཏེ་ལག་གཉིས་ཐལ་མོ་སྦྱོར།",
    "བརྗེད་ཐབས་མེད་དོ་སྐར་མ་དམར་ལོག་ཁྱོད།",
    "ཧ་ལམ་མི་སྐད་གོ་བའི་ཁྱི་གུ་ཁྱོད།",
    "ཁྱི་སེང་དམར་ལིར་ཁྱོད་ལ་རག་ཆོག་ཀྱང་།",
    "ཟློག་མེད་ལས་ཀྱིས་སྤྲེལ་བའི་ཁྱི་ཕྲུག་ཁྱོད།",
    "བདག་འདྲའི་མི་རྐྱང་རྩ་ལ་ངང་གིས་འཁོར།",
    "ཡོད་དུས་སྒོ་ང་འོ་མ་ཁྱོད་ལ་བྱིན།",
    "ཁྱོད་ཀྱང་ཅི་བྱིན་དེ་ཡིས་ཆོག་ཉམས་ལས།",
    "ཁྱོད་རང་བདག་གི་བུ་རུ་སྐྱེས་ནས་ཤོག།",
    "ཐམས་ཅད་ངང་གིས་སྟེར་སའི་གྲལ་བདག་ཡིན།",
    "བུ་མོར་མ་སྐྱེས་སྐར་མ་དམར་ལོག་ཁྱོད།",
    "ནུས་མེད་བུ་མོའི་ལུས་འདིས་ཅི་ཞིག་བྱེད།",
    "མ་རུང་གཟུགས་སུ་མ་སྟོན་སྐར་མ་ཁྱོད།",
    "ཁ་སང་ཁང་བདག་རྒན་མོ་བཙན་པོ་མས།",
    "ཁྱི་ཕྲུག་ཉར་ན་ཁྱོད་རང་ད་སོང་ཞེས།",
    "ཕྱི་ལ་ཕུད་དུས་ད་དུང་ཁྱི་གུ་ཁྱོད།",
    "སྒོར་མོའི་དྲིན་གྱིས་འགྲིག་པར་མཐར་ཐག་བཅད།",
    "སྐྱིད་ལ་བདེ་སར་བྱིན་ཆོག་བདག་གིས་སྨྲས།",
    "གནས་མོས་དེ་ལྟར་མ་བྱེད་བཙོང་ཆོག་ཟེར།",
    "བདག་གིས་མོ་ལ་མོས་མཐུན་ཅུང་བྱས་ཚེ།",
    "མདུན་དུ་བཞག་ནས་ཁྱི་ཁྱོད་ཁྱེར་ནས་ཐལ།",
    "དེ་མ་ཐག་ཏུ་གནས་མོ་རྒྱ་གར་མས།",
    "སྒོར་མོ་བགོ་ཞེས་འཛུམ་དགོད་སྟོན་བཞིན་བསླེབས།",
    "བསོ་རེ་ང་ལ་ཁྱི་རིན་མི་དགོས་པས།",
    "ཐམས་ཅད་ཁྱོད་ཀྱིས་ཁྱེར་ཞེས་མོ་ལ་སྤྲད།",
    "ཅུང་ཟད་མཚར་ཉམས་ངང་གིས་རྒྱ་གར་མས།",
    "ཨབ་ཀ་སི་ཀི་རེ་ཀྲི་པུས་འོ་ཞིས།",
    "མདུན་ཅོག་ཐོག་ལ་བཞག་སྟེ་བུད་ནས་ཐལ།",
    "སེམས་པ་རྩྭ་རྩེའི་ཟིལ་བའི་ཐིགས་ཕྲེང་སྙི་མོ།",
    "གནའ་བོའི་གྲོང་ཚོ་ཞིག་གི་ཆགས་དབྱིབས་བསྟན་འདུག།",
    "བུ་རམ་སྦྲང་རྩི་བྱུགས་པའི་ཞལ་གསུང་མངར་མོ།",
    "སྦྲང་ཆུང་གཤོག་པས་ཁ་ལ་ཡང་ཡང་བཅུག་མོད།",
    "ད་ནི་སེམས་པ་རལ་བོ་འདྲེ་རུ་གྱུར་སོང་།",
    "འདྲེ་དང་འགོང་བོར་འཐབ་པའི་གྲུབ་ཆེན་མིན་མོད།",
    "ཡ་མཚན་ལྟད་མོར་གཡེང་བའི་སྤྲང་རྒྱས་ཡོད་དོ།",
    "ཉི་མ་རང་གི་གྲིབ་མས་བསྒྲིབས་པ་མཐོང་བྱུང་།",
    "ཟླ་བ་ཁྲག་གིས་ཚོས་པའི་བྱུང་བ་དམར་བོ།",
    "གཉེན་གྱིས་མ་གསན་སྡུག་གི་རླབས་སྒྲེ་ཐོས་བྱུང་།",
    "སྟག་ཤར་དར་མའི་འཛུམ་ཐིག་འདམ་གྱིས་བརྫིས་སོང་།",
    "ས་ཆེན་ཁྲག་མཚོ་འཕྱུར་བས་གངས་རི་ཞི་སོང་།",
    "གནའ་འབྲེལ་རེ་བ་བསླེས་མའི་བྲག་འཕྲང་ཞིག་ནས།",
    "བྱིས་པའི་སྲོག་གིས་བཟུང་བས་རྨི་ལམ་བྱུང་འདུག།",
    "བརྗེད་དུ་ཕངས་པའི་དྲན་ཤིང་མཆི་མ་ལྷུང་སོང་།",
    "གོ་རིམ་མེད་པ་དཔྱིད་ཀའི་རྨི་ལམ་རིང་མོ།",
    "ཁྲ་ཆུང་མིག་ཟུང་བདུད་ཀྱིས་ཕྱེ་ཕྱོགས་ཤིག་གིས།",
    "མཛེས་དྲོད་ཤོར་བའི་རྙིང་ཧྲུལ་གོས་ཀྱིས་གྲང་ངར་འགོག་པར་མི་ནུས་མོད།",
    "གོམས་འདྲིས་མེད་པའི་ཡུལ་སྲོལ་ཞིག་གིས་དཀའ་ངལ་འཐོལ་པ་སྤྲད་གྱུར་ཀྱང་།",
    "ཁྱེད་ཉིད་ཡོད་པས་དམར་པོའི་སེམས་འདི་འདབ་ཆགས་ཚང་གི་སྒོ་ང་བཞིན།",
    "མཁྱེན་དང་བརྩེ་བའི་འོད་ཐིག་ཟབ་མོ་ཕྱོགས་སུ་ལྷུང་བ་མེད་པ་དེས།",
    "མཐུ་དང་ནུས་པ་ཚངས་བའི་རི་མོ་ཆེ་རྒུ་ཀུན་གྱིས་ཐོད་ལ་བཅིངས།",
    "ཅི་ཡང་མེད་པའི་དྭ་ཕྲུག་དག་ལ་བྱམས་བརྩེ་ལྡན་པའི་ཨ་མ་ཡོད།",
    "དབྱངས་ཅན་ན་ཆུང་གིས་སྦྱིན་ནམ།",
    "སྤྲིན་དཀར་མེ་ཏོག་གི་འདབ་མ།",
    "བྱང་བགྲོད་བྱ་གླག་གི་བུ་མོ།",
    "བརྩེ་འདང་ལྗོན་གསེབ་ཀྱི་འཇོལ་མོ།",
    "ལོ་མང་དཀའ་སྡུག་གི་མཆི་མ།",
    "ཞེན་ཆགས་ཕྱི་མིག་གི་གསང་བ།",
    "གཉོམ་པའི་དུང་སྣང་གི་སེམས་པ།",
    "དྲོད་མོའི་ཚང་མལ་ན་གཟིམས་པའི།",
    "བྱེའུ་ཆུང་ཅོ་ག་དེ་བདེ་མོ།",
    "སྔོན་ལས་མཇལ་འཛོམས་ཀྱི་སྣེ་མོ།",
    "སྙན་འཇེབས་ཁུ་བྱུག་གི་ངག་ལས།",
    "འདས་སོང་ལོ་ཟླ་དེ་མ་བརྗེད།",
    "མ་མཇལ་ལོ་བརྒྱ་རང་སོང་ཡང་།",
    "བདག་སེམས་རྡོ་བརྐོས་ཀྱི་རི་མོ།",
    "འདོད་ཀྱང་མི་དགོས་ཟེར་བའི་རྫུ་བག་མིན་མོད།",
    "ལས་ངན་མི་རིགས་ཤིག་གི་བྱུང་བ་བསམ་ནས།",
    "ཨུ་ཚུགས་ལྕགས་ཀྱི་གོང་བུ་ཞིག་གྲབས་བྱས་སོང་།",
    "ཁྱོད་ཀྱི་བརྩེ་བ་ཁུག་པའི་རིན་ཐང་ཅི་འདུག།",
    "འཆར་ཟིན་མེད་པར་ཁྱོད་ལ་ཐེངས་གཅིག་འཕྲད་དུས།",
    "མེད་དང་མུ་གེ་ཟློ་བའི་སློང་མོ་མ་བྱས།",
    "ཐམས་ཅད་ཁྱོད་ལ་བསྟུན་ནས་སྤྲེལ་གར་མ་འཁྲབ།",
    "དུང་བ་ཟབ་ཏུ་སོང་བའི་གོ་བ་མ་རྙེད།",
    "ལྷན་འགྲོགས་འཚོ་བའི་ཟླ་ཞག་རིང་ཞིག་སོང་སྟབས།",
    "གཏན་གྱི་འདུན་མ་དགོས་ཞེས་རེ་ནན་ཞུ་དུས།",
    "ཁྱོད་ལ་ཡུན་རིང་སྡོད་པའི་ཐོངས་མཆན་མེད་པས།",
    "སྐྱིད་ལ་རེ་བའི་འཚོ་བར་སྐྱུར་ཁ་མང་སྟབས།",
    "ཁྱོད་ཀྱིས་ཡོད་རྒུ་བཏང་བའི་སྤྲོ་འཆམ་དེ་ཡང་།",
    "མཆི་མ་བསྣོལ་མར་སྤེལ་བའི་ས་བོན་ཡིན་སོང་།",
    "ཤར་ནུབ་ཡུལ་གྱིས་ཆོད་པའི་རྒྱང་ཐག་རིང་མོད།",
    "དེ་རིང་བྲལ་དུས་བདག་གིས་གླེང་རིན་མཐོང་སོང་།",
    "མཛའ་མོ་དྲན་པའི་སེམས་གཞས་སྤྲིན་ལ་བཅོལ་མྱོང་།",
    "ཐུགས་རྗེ་གཟུགས་ཞེས་འུ་ཐུག་ངུ་ངག་ཤོར་སོང་།",
    "ཁྱོད་ཉིད་འབྲལ་ལ་ཉེ་བའི་དུས་ཚོད་དེ་ནས།",
    "ངས་ཀྱང་ཚོར་བའི་བརྩེ་བའི་མནར་གཅོད་དེ་ནི།",
    "ཁྱོད་ཀྱི་མིག་ཆུས་བདག་གི་ཕྲག་པ་བརླན་སོང་།",
    "ང་ཡི་སེམས་རྩ་འཁྱགས་ནས་འདར་སིག་ཤོར་སོང་།",
    "ཁྱོད་ནི་མཁའ་བགྲོད་ཉི་མ་སེར་བོ་ཡིན་ན།",
    "ཁྱོད་ཀྱི་མཛེས་བས་བདག་མིག་འཕྲུལ་བར་མ་བྱས།",
    "ཁྱོད་ཀྱི་འབྱོར་བས་བདག་ཡིད་རྙོག་པར་མ་བྱས།",
    "གཏན་གྱི་འདུན་མ་སློང་བའི་མིག་ཆུ་དྭངས་མོས།",
    "ཁྱོད་ཀྱིས་བཏབ་པའི་བག་ཆགས་ཅི་འདྲའི་ལྕི་ཨང་།",
    "ད་ནི་འདི་ན་སྤྲང་བོ་ཁེར་རྐྱང་ཞིག་གིས།",
    "སྐྱ་ཟས་སྐྱ་ཆུས་ཉིན་མཚན་འཁྱོལ་ཐབས་འགྲིག་ཀྱང་།",
    "ཕར་ལ་གཡུགས་ཀྱང་ཚུར་ལ་འཁོར་ནས་ཡོང་གི།",
    "ཁྱོད་ཀྱིས་བཏང་བའི་ཡིག་འཕྲིན་རེ་རེ་འབྱོར་དུས།",
    "མཆི་མའི་ཀློང་གི་ཁྱོད་ཉིད་ཤིན་ཏུ་དྲན་ཨང་།",
    "ཡུལ་བྱོལ་འཚོ་བའི་སྐྱོ་གར་རིང་མོའི་ཁ་ལ།",
    "ཁྱོད་ཀྱིས་བཞག་པའི་མྱ་ངན་ཤིང་ལོ་འཐོར་དུས།",
    "ལང་ཚོའི་དབྱར་གཞུང་རྫོགས་ལ་འགྱོད་པ་མེད་ཀྱང་།",
    "ཕོ་གསར་རྒོད་པའི་རང་ཚུགས་མི་ལྡན་མོད།",
    "མི་རིགས་གླེན་པ་ཞིག་གི་རང་གཤིས་གསལ།",
    "རང་རིག་སྐད་ལ་ཞེན་པའི་སྒྲོག་ཐག་གིས།",
    "རིན་ཆེན་ན་ཚོད་ཤོར་བའི་འགྱོད་གདུང་གིས།",
    "འདི་ན་གོག་སྟེ་བགྲོད་པ་ཉམ་རེ་ང་།",
    "རིགས་ཞེན་སེམས་པར་སྡུག་གི་རྩི་བྱུགས་ཏེ།",
    "ད་ནི་རེ་བའི་ཨ་ཐང་རྦད་དེ་ཆད།",
    "རིགས་ཞེན་ཆང་གིས་བསླུས་པའི་སེམས་ངོགས་ན།",
    "ཡུན་རིང་རེ་བའི་དམིགས་རྣམ་ཆུ་ལ་བྱིངས།",
    "ལྷ་ལ་རེ་བའི་རྨུ་ཐག་དབྱིངས་ནས་ཆད།",
    "མགོ་ནག་རྐང་ལེབ་ཅིག་གི་ཟས་རིན་ལ།",
    "ཡན་ལག་ལྔ་བོ་རང་གི་ཆེད་དུ་གཡུགས།",
    "དགྲ་ལ་སྲོག་གིས་རྒོལ་མྱོང་རྒས་པོ་ཚོ།",
    "བདག་ལ་འཁང་བའི་ཚིག་གིས་མ་སྨོད་རོགས།",
    "ཞེས་པ་འདི་ནི་བཙན་བྱོལ་ནང་གི་བོད་མི་ཕལ་མོ་ཆེའི་འགྲོ་འདུག་ཉལ་འཆགས་ཀྱི་རིམ་པ་ནས་ལྟོ་གོས་གཏམ་འཚོལ་གྱི་བང་རིམ་རེ་རེར་རྒྱུས་མངའ་ལོན་ཞིང་།",
    "རྒྱལ་ཁབ་དང་མི་རིགས་ཀྱི་ཆེད་དུ་བཅོས་མིན་བློས་ཕོད་ཆེ་བ་ཚོ་སྲིན་འབུ་མེ་འཁྱེར་ལས་ཀྱང་འོད་ཆུང་བ་ཤ་སྟག་ཏུ་བལྟ་བ་ནས་རྒྱལ་ཁབ་དང་མི་རིགས་ཀྱི་ཆེད་དུ་བརྫུས་ཏེ་མི་ཚོང་རྒྱག་མཁན་དག་ནི་ཆེས་ཡིད་དུ་འོང་བ་ཞིག་ཚོར་བཞིན་པའི་རང་རེའི་གོ་ལོག་གི་བསམ་སྤྱོད་ལ་ཞེ་སྨྲེང་ཞོར།",
    "༧ གོང་ས་སྐྱབས་ཀྱི་ཉི་མ་ཆེན་པོའི་བརྩེ་ཆེན་ཐུགས་ཁུར་འོག་ནས་ལོ་ཤས་ཕྱིན་པའང་ཆུད་ཟས་སུ་སོང་སྙམ་གྱིས་རང་ཉིད་རང་ལ་ཡིད་ཆད།",
    "རིགས་མཐུན་ཚོའི་སྤྲེལ་གར་ཁྲོད་ནས་ཕྱིར་འབུད་ཐབས་སུ་བརྩོན་དགོས་ཀྱི་སེམས་གདུང་གིས་ཆེར་བསྐུལ་ཏེ་ལེའུ་སྐྱར་མོ་ཞིག་མཇུག་བསྡུས་པའི་ཚན་པ་ཆེས་མཐའ་མའོ།",
    "བསླུ་བྲིད་འོག་གི་སེམས་པ།",
    "ང་ཡང་བཙུན་པའི་གྲལ་དུ་རེ་ཞིག་འཚང་།",
    "ཉམ་ཆུང་བདག་གི་ནུས་པས་མ་བཟོད་དོ།",
    "ཞྭ་སེར་བསྟན་སྒོར་རེ་ཞིག་འཚང་མྱོང་ཡང་།",
    "ཡ་མཚན་བདག་གི་ཆེ་བ་གཅིག་པུ་ཉིད།",
    "ས་མཐའ་གྲོང་ནས་རྒས་སོང་ཕྱི་རབས་ཚོ།",
    "ཧ་ཅང་གསོང་བོར་བརྗོད་ན་བདག་གི་ཚེ།",
    "ཨ་ཅག་བུ་མོའི་རྗེས་སུ་ཅི་ཡང་རྒྱུག།",
    "ཡིན་ཡིན་ཆོག་ཆོག་སྟོང་གིས་བསླུས་བསླུས་ནས།",
    "མིན་མིན་མི་ཆོག་སྟོང་གི་གཡང་ལ་ལྷུང་།",
    "ཝ་ལེར་རང་གི་མྱོང་བ་དག་བརྗོད་འདིས།",
    "ཛ་ཡ་རྒྱལ་བོར་རྒོལ་བ་མ་ཡིན་མོད།",
    "ཅང་མེད་བདག་གི་འབྱོར་བ་འདི་ཙམ་ཉིད།",
    "ང་ཡིས་རང་གི་བྱུང་བ་འདི་བརྗོད་པས།",
    "ག་ཡང་ང་བཞིན་མཐོང་བར་མི་འགྱུར་མོད།",
    "ཀ་ངོ་ཆོད་ན་གསོང་བོར་བརྗོད་ཡོད་དོ།",
    "དུད་སྤྲིན་རྫ་ཆབ་འཕྱོ་བ་རང་བྱང་གི་མཛེས་སྡུག།",
    "སྤང་རི་བེཌཱུར་སྔོན་མོའི་མགུལ་རྒྱན་དུ་ཆགས་པ།",
    "དོན་དམ་མདུན་ལམ་འཚོལ་བ་སློབ་ཕྲུག་གི་གསེར་མིག།",
    "དྭངས་གཙང་ལས་ལ་བྲེལ་བའི་འཁྱུག་འགྲོས་ཀྱི་རི་མོ།",
    "ཕུགས་འདུན་བུ་ལ་བཅོལ་བའི་གཤིས་བཟང་གི་རྒན་རྒོན།",
    "ཡིག་དྲུག་དབྱངས་རྟར་འཇུས་པའི་ཉི་ཐིག་གི་འོད་ལ།",
    "དུང་སྣང་ཕྱི་ཐག་རིང་བ་གཤིས་བཟང་གི་སྤུན་ཟླ།",
    "འདི་གའི་ཚ་གདུང་སེལ་བའི་བདུད་རྩི་རུ་བབས་སོང་།",
    "སྐྱོ་སྨྲེང་ངག་གི་དབྱངས་རྟ་འཁྱོར་བཞིན་བརྩེ་དུང་སྦྲུམ་པའི་གླུ་གཞས་གྱེར།",
    "ག་བུར་ཞུན་མའི་ཟླ་འོད་དེ་ཡང་མྱ་ངན་མོག་པོའི་བག་ལ་ཞ།",
    "གྲང་ཤུར་ཤུར་གྱི་སེམས་པ་དམར་པོར་དྲན་གདུང་སྟོང་གི་སེར་ཁ་གས།",
    "གཡུ་ཞུན་སྤང་གི་མཛེས་རྒྱན་མེ་ཏོག་ལྷུག་ལྷུག་དགོད་པའི་དབྱར་གཞུང་ཞིག།",
