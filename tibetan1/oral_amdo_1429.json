    "༢༣ ཐུན་མོང་མིན་པའི་དཔེ།",
    "ཞི་ཁྱོད་སྐུའི་དཔེ་ཟླར་ཁྱོད་ལས་གཞན་མི་རྙེད།",
    "ཡལ་གའི་རི་དྭགས་ཀྱིས་བཞིན་བདག་གིས་མྱོང་།",
    "ཉམས་མཚར་རྩལ་རྩེད་མཁས་རྣམས་ངང་གི་འདུ།",
    "ཡིད་བཞིན་ནོར་བུ་རྒྱལ་མཚན་རྩེ་མོར་བཀོད།",
    "མཁས་ཁྱོད་སེང་གེའི་ཁྲི་ལ་མངའ་གསོལ་ཏེ།",
    "ཐུགས་རྗེས་སྡུག་བསྔལ་སེལ་བས་སྤྱན་རས་གཟིགས།",
    "ཚངས་སྲས་ལྷ་མོའི་ཐུགས་རྗེ་ཕྲིན་ལས་ནིག།",
    "འཕགས་མཆོག་སྤྱན་རས་གཟིགས་དང་གཉིས་སུ་མེད།",
    "རབ་འབྱམས་ཞིང་གི་འཕགས་པའི་ཚོགས་དང་མཚུངས།",
    "རིན་ཐང་བྲལ་བའི་ནོར་བུ་གཅིག་གིས་མཚོན།",
    "སྙན་ངག་མཁན་གྱི་ངག་གི་སྤྱི་ནོར་ཡིན།",
    "ཁྱོད་སྐུ་ལང་ཚོའི་འཁྲི་ཤིང་ལྡེམ་པའི་རྩེར།",
    "མིག་གི་བུང་བ་གཡོ་འདིས་ཟས་བདག་ཡིད་འཕྲོག།",
    "བདག་བློ་དད་པའི་ནམ་མཁར་ཤར་བའི་མོད།",
    "སྤྱོད་པའི་སྐྱེ་རྒུ་རི་དྭགས་བག་རེ་བྲོ།",
    "བདག་གི་སློབ་དཔོན་མཆོག་དེར་མཁས་ཀུན་འདུད།",
    "པ་དཀའ་མོད་ཀྱང་།",
    "གང་གི་ཞབས་ཟུང་ཡིད་བཞིན་ནོར་བུའི་ཏོག།",
    "འཛམ་གླིང་ནོར་འཛིན་ཡངས་པའི་ཁྱོན་འདི་ནི།",
    "གང་སྐུ་ཡིད་འཕྲོག་ལང་ཚོ་རབ་རྒྱས་པར།",
    "སྔོན་སྨོན་ཐུགས་བསྐྱེད་ལང་ཚོ་དར་ལ་བབས།",
    "རིན་ཆེན་རྒྱན་གསལ་གློག་གི་འོད་ཟེར་འཕྲོ།",
    "བདག་ཅག་གི་སྟོན་པ།",
    "རིས་མེད་སྐྱེ་རྒུའི་རེ་བ་ཡིད་བཞིན་སྐོང་།",
    "བདག་གི་སློབ་དཔོན་ལྔ་རིག་མཁས་པའི་མཆོག།",
    "གང་གི་ནང་དུ་མ་ཆུད་དེ་ཅི་ཞིག།",
    "འབྱོར་ལྡན་གསོག་བསྲུང་བརླགས་པའི་སྡུག་གི་མནར།",
    "བརླན་བཤེར་ཆུ་ཡི་དངོས་པོར་གང་གི་གྲུབ།",
    "༡༨ མཉམ་འཇོག་གི་གཟུགས་ཅན་ནི།",
    "དོན་མཐུན་ཚོགས་རྣམས་རེ་བས་འཇུག་པའི་གནས།",
    "དབྱངས་ཀྱི་རྒྱ་མོའི་ངོ་མཚར་མཛེས་སྐུ་ཡང་།",
    "གང་ཞིག་ཁྱོད་ཞབས་བརྟེན་པ་ཙམ་གྱིས་ཀྱང་།",
    "བདག་གི་སྙན་ཚིག་དཔེར་བརྗོད་འདི་ཡིས་ཀྱང་།",
    "ཐུབ་པ་མཆོག་གི་ཆོ་འཕྲུལ་མཛད་བཟང་གིས།",
    "ནང་གི་རྟོགས་རིགས་བདག་གིས་མ་འཚལ་ལོ།",
    "གཟུར་གནས་དམ་པ་རྣམས་ཀྱིས་བཀས་བཀྱོན་མོད།",
    "འདོད་ཡོན་བདུད་ཀྱི་གཡབ་མོས་མདུན་བསུ་ཞིང་།",
    "༨ རྗེས་གནང་གི་འགོག་པ་ནི།",
    "མི་རིགས་རྒྱུད་འཛིན་རེ་བའི་གཞོན་ནུ་ཁྱོད།",
    "རང་འདྲའི་གྲོགས་ཀུན་དགའ་བར་ངེས་མོས་ཀྱང་།",
    "རང་གི་ངང་ཚུལ་གསོང་པོར་སྨྲ་བ་ལགས།",
    "༡༢ རྩུབ་མོས་འགོག་པ།",
    "འཕྲད་དགའ་མཐོང་འཛུམ་གྲོགས་ལ་ཁྱོད་འདོད་ན།",
    "བརྩོན་འགྲུས་སྐྱེད་ཅེས་ཐལ་འདིར་ཅི་བྱར་ཡོད།",
    "ཉིན་མོར་བྱེད་ཁྱོད་གླིང་གཞན་ལ་༧༧ ༧༧ལའགྲོ་ན།",
    "པདྨའི་མཛེས་པ་ཟུམ་ཡང་རེ་ཞིག་བཟོད།",
    "ཁམས་དྲུག་ལང་ཚོ་དར་བའི་གཞོན་ནུའི་དུས།",
    "རང་གིས་གསར་བཏོད་བྱ་དངོས་གཅིག་ཀྱང་མེད།",
    "སྒྲ་དབྱངས་ལྷ་མོའི་མཛེས་སྐུ་སྟོན་ནམ་ཅི།",
    "རིན་ཆེན་གླིང་གི་ནོར་བུ་དེས་ཅི་བྱ།",
    "ལང་ཚོས་སངསདྲེགས་ལྡན་སྒེག་མོའི་སྙན་གང་སྤུད།",
    "མྱོང་བའི་མོད་ནས་ཟུག་རྔུ་ཞི་བྱེད་པ།",
    "ཐོས་བསམ་བྲལ་བས་རིས་མེད་གང་གིས་སྒྲུབ།",
    "༡ གཅིག་གི་ལྡོག་པ་ཅན་ནི།",
    "རིགས་སྨྲའི་ཁྱུ་མཆོག་ཁྱོད་དང་རྒྱུ་སྐར་བདག།",
    "ཁྱོད་ཀྱིས་གདུལ་བྱའི་ནང་གི་མུན་སྟུག་དང་།",
    "འོད་དཀར་ཅན་གྱིས་མཚན་མོའི་སྨག་རུམ་སེལ།",
    "ཚངས་སྲས་དབྱངས་ཀྱི་རྒྱལ་མོ་ཁྱེད་ཞལ་ནི།",
    "གཙུག་ལག་ཀུན་གཟིགས་བློ་གསལ་འདུས་པའི་རྒྱན།",
    "སྐྱེད་མོས་ཚལ་དུ་རྐང་དྲུག་མགྲིན་དབྱངས་སྒྲོགས།",
    "ཐུན་གསུམ་མུན་པའི་སྨག་གིས་མི་བསྒྲིབ་པའི།",
    "མ་བྲིས་གསེར་འབར་གློག་གི་འཁྱུག་རིས་གསལ།",
    "༢ ནང་ལང་ཚོ་ལ་སྦྱར་བ་ནི།",
    "གྲང་རེག་གདུང་བས་མ་གཙེས་མགོ་ལུས་འདར།",
    "མ་བརྡར་རྩེ་མོ་རྣོ་བའི་ཚིག་མཚོན་ཅན།",
    "མེ་ཁྱེར་འོད་ལ་རེ་རྣམས་བླུན་པོའི་རྟགས།",
    "བདག་གིར་སྤྱོད་པའི་སྐལ་པས་མ་ཚིམས་པར།",
    "མངར་འབྲས་བུ་འཚོལ་འདོད་གད་མོའི་གནས།",
    "སྐོམ་སེལ་བཏུང་བའི་དངོས་པོ་རེ་རྣམས་འཁྲུལ།",
    "སྣང་བྱེད་དངོས་གཞན་མོག་པོར་སྒྱུར་བྱེད་ཅིང་།",
    "ཉིན་མོར་བྱེད་འདི་བདག་གི་དཔལ་དུ་ཤར།",
    "བཅུ་གཅིག་པ་ཕུལ་བྱུང་གི་རྒྱན་ལ་བཞི་ཡོད་པ་ལས།",
    "རྒྱུ་བའི་གོ་སྐབས་ཡོད་མེད་འཕྱང་མོ་ཉུག།",
    "གཞན་གྱིས་རྟོགས་དཀའ་གཞུང་ལུགས་ཟབ་མོའི་དོན།",
    "གང་གི་མཁྱེན་རབ་ཡངས་པའི་གྲྭ་གཅིག་ན།",
    "ད་དུང་ཤེས་ལྡན་ཀུན་གྱིས་སྤེལ་མོད་ཀྱང་།",
    "དོག་མེད་ཤོང་བའི་འཇིག་རྟེན་འདི་རེ་ཡངས།",
    "བ་རབ་རྟོག་གི་རྒྱན་ལ་གསུམ་ཡོད་པ་ལས།",
    "དམར་སེར་འོད་ཟེར་སྟོང་གི་བརྒྱན་པ་འདིས།",
    "ཉིན་མོར་བྱེད་པ་སྐྱེངས་ན་མི་རུང་ཞེས།",
    "ཁྱོད་ལ་བརྙས་པའི་སྤོབས་པ་ཡོངས་མི་སྲིད།",
    "རྒྱ་བོད་ཧོར་གསུམ་ཁྱོན་དུ་གནས་པ་ཡི།",
    "དངོས་གྲུབ་འོད་སྣང་སྟོང་གི་ཉེར་འཁྱུད་པའི།",
    "ཟླ་ཤེལ་གསར་པ་མཐོང་བའི་མོད་ཉིད་ལ།",
    "ངག་གི་གེ་སར་བཅུད་དུ་ཉེར་བསྟེན་པས།",
    "བཅུ་བཞི་པ་ཕྲ་མོའི་རྒྱན་ལ་གཉིས་ཡོད་པ་ལས།",
    "༡ ཟུར་གྱི་ཕྲ་མོ་ནི།",
    "༢ རྣམ་པའི་ཕྲ་མོ་ནི་དམ་པའི་སྤྱན་སྔར་གཞུང་ལུགས་སྦྱངས་པ་ཡི།",
    "རྒྱལ་པོའི་བུ་མོ་མཚར་སྡུག་རྫོགས་པའི་བཞིན།",
    "རང་གི་ཐོས་བསམ་ཉམས་བཞེས་ཀུན་བཞག་ནས།",
    "གྲོགས་ཁྱེད་བདག་གི་སྡུམ་པར་ཡང་ཡང་ཕེབས།",
    "ཁྲོས་པའི་སྡིག་མོས་རི་ཀླུང་གཡོ་བཞིན་དུ།",
    "ཡ་མཆུ་ཤོ་རེ་ཆགས་པའི་གཞོན་ནུ་མས།",
    "ཆང་གི་བཟི་ནས་དྲན་པས་མ་ཟིན་ཚེ།",
    "༧ ངོ་མཚར་འཕེལ་བ་རྨད་བྱུང་གི་ཉམས་ནི།",
    "ཉེས་མེད་སྡུག་གིས་མནར་བའི་མི་རིགས་འགའ།",
    "རབག་ཚ་བ་འཕེལ་བ་འཇིགས་རུང་གི་ཉམས་ནི།",
    "བདག་གི་མདུན་སར་བློ་གསལ་ཁྱེད་རྣམས་ཀྱིས།",
    "ཀུན་མཁྱེན་ཐུགས་རྗེའི་མཐུ་ལས་བདག་གིས་རྙེད།",
    "རྒྱ་ཁྱོན་རབ་ཡངས་བཟོ་རྩལ་ཕུལ་དུ་བྱུང་།",
    "སྐད་ཅིག་རེ་ལའང་གྲངས་མེད་འཇོམས་པའི་ཕྱིར།",
    "བདུད་ཅེས་གྲགས་མོད་འདོད་ལྷའི་དཔུང་ཚོགས་ནི།",
    "ཐུབ་པ་མཆོག་གི་གྲངས་མེད་བསྐལ་པའི་རིང་།",
    "མ་ལུས་སྲིད་གསུམ་ཁྱོན་ན་ཁྱབ་འཇུག་པའི།",
    "སྒྲ་དབྱངས་ལྷ་མོས་ཀུན་ཡིད་འཕྲོག་པར་བྱེད།",
    "ཡོ་འཁྱོག་སྲོང་བྱེད་དྲང་པོའི་གཞུང་ཤིང་ནི།",
    "དྲི་ཟའི་སྒེག་མོ་ཡིན་ཀྱང་ཆགས་སོགས་བྲལ།",
    "དྲི་ཟའི་བུ་མོ།",
    "མེ་ཡི་རེག་བྱ་འཛིན་པ་མ་ཡིན་མོད།",
    "གཏུམ་དྲག་བདུད་དཔུང་མིང་གི་ལྷག་མར་མཛད།",
    "གཟུགས་དང་ལང་ཚོ་འབྱོར་པའི་ཚོགས་མེད་ཀྱང་།",
    "མཚར་སྡུག་ལང་ཚོའི་གཟུགས་བྱད་མི་ལྡན་ཞིང་།",
    "ཞིམ་མངར་ཟས་དང་སྦྱར་བའི་དུག་གི་དངོས།",
    "གང་གིས་བསྟེན་དེ་རིང་པོ་མ་ཐོགས་འཕུང་།",
    "བདུད་ཧོར་མོན་འཇང་རྩ་ལག་བཅས་པ་ཡི།",
    "རྒྱུན་དུ་གནས་པའི་དད་སྤྲོ་ངང་གིས་འཕེལ།",
    "༥ གཞི་གཅིག་གི་བྱ་བ་འགལ་བ་ནི།",
    "སྨྲ་མཁས་རྩོད་པའི་ཁྱུ་མཆོག་ཁྱོད་ཉིད་ཀྱིས།",
    "ཡིད་འོང་མཚོར་སྤྱོད་ངང་པའི་བུ་མོ་ཡི།",
    "དཔལ་ལྡན་རལ་པ་འཛིན་ཁྱོད་ཀྱིས།",
    "མཚན་མཆོག་གསུམ་ལྡན་གདུང་གི་སྔགས་འཆང་ཁྱེད།",
    "ཁྱོད་ཀྱི་གདུལ་བར་བྱ་བའི་ཡུལ།",
    "༡ མཆོག་གི་ངེས་བསྟན་ནི།",
    "ལྡེ་མིག་གཅིག་གིས་ཚེགས་མེད་འབྱེད་པ་འདིས།",
    "རིགས་འཕྲུལ་གཅིག་གིས་འགྲོལ་བར་ནུས་པ་སྟོན།",
    "ཐབས་ཚུལ་གཙུག་ལག་མཆོག་གི་སྣང་བ་འདིས།",
    "འགའ་ཞིག་སྡང་ཞུགས་མིག་གི་སྨིན་མ་གཟེངས།",
    "ནང་གི་དེ་ཉིད་ལྷན་ཅིག་རྟོགས་དེ་རྨད།",
    "གཞན་གསོས་བུ་དེ་མོན་དུ་ཆས་པ་དང་།",
    "རྣམ་འདྲེན་མཆོག་གི་ཞབས་པད་བརྟན་པ་དང་།",
    "དེ་རྣམས་ཀུན་མཁྱེན་མཆོག་གི་ས་ཐོབ་ནས།",
    "བདག་གི་རེ་འབྲས་རྫོགས་པའི་དངོས་གྲུབ་ཤོག།",
    "དགེ་མཚན་གང་གིས་རྣམ་ཀུན་ཤིས་པར་མཛོད། ། འཕགས་མ་འཆི་མེད་རྒྱལ་མོ་ལ་བསྟོད་པ་འཆི་མེད་གྲོང་གི་ཏཾ་བུ་རའི་སྙན་གླུ་ཞེས་བྱ་ཨབ་མཁན་འཆི་མེད་རབ་བརྟན།",
    "ད་ལྟའི་བསྐལ་མང་ལོ་ཀི་ཤྭ་རིའི་ཞལ་གྱི་ཆུ་སྐྱེས་འཛུམ་པ་ལས་བྱུང་སྲིད་ཞིའི་ལང་ཚོས་མཛེས་པར་སྒེག།",
    "ཟ་བྱེད་གཏུམ་རྔམ་མེ་ཏོག་བཞུ་ཅན་དཔུང་དང་བཅས་པས་རྣམ་པར་འཕྲུལ་པའི་ཧ་ཧའི་གད་མོ་སྟོང་གསུམ་ཁྱོན།",
    "འ་འུར་གཡོ་ཞིང་འཇིགས་པར་ནུས་པའི་ཡིད་སྲུབ་དཔུང་ཀྱང་བྱམས་པའི་ཆབ་ཀྱིས་བཀྲུས་པས་གདོང་གི་འཛུམ་དཀར་ཟླ་བའི་འོད།",
    "ལ་ལར་གསང་གསུམ་མིག་གི་བདུད་རྩིར་ཅིར་ཡང་འཇོ་བའི་དགེ་ལེགས་གྲོགས་པའི་སྤྲིན་དཀར་གསར་པའི་བླ་རེ་བྲེས།",
    "ཟུང་འཇུག་རྡོ་རྗེ་བཙུན་མོའི་དགྱེས་ཆགས་ཀྱི་བྱིན་འོད།",
    "འཆི་མེད་རྟག་པའི་རྒྱལ་མོའི་བདེ་ཀློང་དུ་ནུབ་པའི།",
    "ཏུཏྟཱ་རེ་ཞེས་མཚན་རྟོག་གདུང་བ་ལས་སྐྱོབས་ཏེ།",
    "འཆི་མེད་རྡོ་རྗེ་སེམས་དཔའི་ལང་ཚོ་དེ་སྩོལ་ཤོག།",
    "ཏཱ་རེ་སྲིད་ཞིའི་མཐའ་གཉིས་རྣམ་གྲོལ་དུ་སྒྲོལ་མས།",
    "ཏུཏྟཱ་རེ་ཞེས་གཟུང་འཛིན་གདུང་བ་ལས་སྐྱོབས་མས།",
    "འགྱུ་རྟོག་ཆུ་ཡི་རི་མོ་རང་ཡལ་དུ་སོང་སྟེ།",
    "རྫོགས་ལྡན་དང་པོའི་ལང་ཚོ་ནུབ་མེད་དུ་ཤོག་ཅིག།",
    "གསང་མཆོག་རྡོ་རྗེ་བཙུན་མོའི་ལང་ཚོ་ཞིག་ཞུའོ།",
    "མོས་ལྡན་ཡིད་ཀྱི་མཁའ་ལ་ལང་ལོང་དུ་འཁྲིགས་ནས།",
    "དམ་བཅའི་རི་མོ་ནམ་ཡངའགྱུར་བ་ནི་མེད་ན།",
    "མཱནྟབཀ་། སྤྱན་བདུན་ལྷ་མོར་བསྟོད་བསྔགས་དང་འབྲེལ་བའི་སྨོན་ཚིག་དཔྱིད་ཀྱི་དབྱངས་སྙན་ན་བཞུགས།",
    "༥༤༧ ༤། ན་མོ་གུ་རུ་ཛྙཱ་ན་སཏྭ་ཨརྱ་ཏཱ་ར་ཡེ།",
    "འཕོ་མེད་བདེ་ཆེན་རྟག་པའི་སྦྲང་ཆང་གིས།",
    "རྡོ་རྗེ་བཙུན་མོའི་ཟོལ་གྱིས་རྒྱུ་བ་ན།",
    "ལས་འཁྲུངས་པའི་སྲས་མོའི་ཚུལ།",
    "གཟིགས་པ་དྲི་མ་མེད་པའི་ཡུལ་ལས་འདས།",
    "ཆ་མེད་ཀུན་འགྲོ་ལྷན་སྐྱེས་ལང་ཚོའི་ཞལ།",
    "མཐིང་འོད་རང་གི་ལུས་ལ་ཉེར་བྱུགས་པའི།",
    "རྡུལ་སྙེད་ཞིང་དུ་ཁྱབ་པར་སོང་བའི་མཐའ།",
    "ཉིན་རེ་བཞིན་ཡང་ལུས་ཅན་གྲངས་མེད་པ།",
    "ཐར་དང་མཆོག་གི་གོ་སར་བཀྲི་བཞིན་དུ།",
    "དྲོ་སྐད་རེ་ལ་ཡིད་སྲུབ་བདག་པོའི་དཔུང་།",
    "བདེ་སྡུག་རི་མོའི་འདུ་འགོད་མི་འཛིན་ཀྱང་།",
    "བདེ་མཆོག་ཨུཏྤལ་བཞད་པའི་ཟུར་མིག་གིས།",
    "ཤེས་རབ་མིག་གིས་གདོད་ནས་གཟིགས་གྱུར་ཀྱང་།",
    "ངག་གི་ཡུལ་མིན་བསམ་མི་ཁྱབ་པའི་གནས།",
    "གྲགས་པའི་རོལ་མོ་རྒྱལ་རྣམས་དགྱེས་པར་འཁྲོལ།",
    "ཀུན་ཏུ་འོད་ཀྱི་ས་ལ་རང་གི་དོན།",
    "ཁྱོད་ལ་དུས་ཀུན་བསྔགས་པའི་མེ་ཏོག་འཐོར།",
    "སེམས་ཀྱི་སྐད་ཅིག་ཕྲ་མོའི་གོ་ས་རུ།",
    "ཀུན་བདག་ཀུན་ཏུ་བཟང་མོའི་ལོ་གྲགས་པ་འབར།",
    "རྒྱལ་ཐབས་བུམ་ཆུ་ཁྱོད་ཀྱི་སྤྱི་བོར་བླུགས།",
    "ཉམས་མྱོང་དྲོད་ཀྱི་རེག་པས་མ་བསྐྱེད་པའི།",
    "མཆིས་སོ་ཅོག་ཀུན་ཁྱོད་ཀྱི་ཕྲིན་ལས་གར།",
    "འཆི་མེད་ལང་ཚོས་སྒོ་གསུམ་སིམ་པ་སྟེར།",
    "སྒེག་པའི་འཛུམ་ཞལ་མིག་གི་དཔལ་དུ་སྟོན།",
    "རེས་འགའ་པདྨའི་སེམས་དཔའ་པདྨའི་སྤྱན།",
    "ཨུཏྤལ་ལྕག་མ་རང་གི་ཁ་དོགས་ལ།",
    "སྨིན་འཁྱོག་བུངབ་ལྡིང་བའི་འཛུམ་ཟེར་དེས།",
    "རྗེས་ཆགས་བདེ་བས་མྱོས་པའི་འཕྲུལ་མོ་ཆེ།",
    "རེག་འཇམ་པདྨ་གཞོན་ནུའི་མལ་སྟན་སྟེང་།",
    "ཡིད་ཀྱི་མཚོ་རུ་ངང་པའི་བུ་མོ་ཞེས།",
    "ཕྱོགས་ཀྱི་སྒེག་མོའི་འགྲམ་པར་ལེགས་བྱས་ཀྱི།",
    "འབུམ་ཕྲག་མཁའ་འགྲོའི་ཕྱག་གིས་བཏུད་པའི་རྗེས།",
    "བདེ་སྟོང་ཨུཏྤལ་ཀཾ་མཐིངགི་ཟུར་མིག་གིས།",
    "འཛུམ་པའི་བཞིན་རས་པདྨའི་མིག་གིས་བལྟ།",
    "ཁ་བའི་རེག་བྱས་དཀར་བའི་ཞིང་ཁམས་ན།",
    "དྭངས་བའི་ཤེལ་ལ་ཚོན་གྱི་རི་མོ་བཞིན།",
    "བདེན་གསུང་དཔལ་གྱི་མགུལ་ནས་ལུང་གི་ཕྲེང་།",
    "ཁྱོད་མཚན་ཡིད་ཀྱི་པདྨོར་ངལ་གསོས་པས།",
    "གུས་པའི་མིག་གིས་བལྟ་ཞིང་བཞོན་པར་འགྲོ།",
    "ཞེ་སྡང་མེ་ལྕེ་གནམ་སའི་ཁྱོན་ལ་འཁྲུགས།",
    "ལྷ་གཅིག་དྲན་པའི་མོད་ལ་བསིལ་བའི་ཆར།",
    "དཔའ་མོའི་གཟུགས་ཀྱིས་ཕས་རྒོལ་མིང་ཙམ་བྱས།",
    "བག་ཆགས་སྒྲོག་གིས་ཐར་མེད་བཅིངས་བཞིན་དུ།",
    "ཁྱོད་ལ་དད་པས་མི་དགེའི་བློ་ཅན་དེ།",
    "གང་ཞིག་ཁྱོད་ཞབས་པདྨའི་གེ་སར་ལ།",
    "འཕུར་ལྡིང་གཅིག་གི་སྟབས་ཀྱིས་སོང་།",
    "དེ་ཕྱིར་ཕན་བདེའི་དངོས་པོ་ཇི་སྙེད་པ་ ཁྱོད་ལས་གཞན་དུ་དམིགས་པའི་ཡུལ་མེད་པས།",
    "བདག་ཀྱང་མོས་པའི་འདབ་བརྒྱ་བྱེ་བའི་ཁ།",
    "ཁྱོད་མཚན་ཉིན་མོར་བྱེད་པའི་རྗེས་སུ་སྙིགས།",
    "བརྗོད་པར་ནུས་མིན་རང་གི་དད་གསུམ་གྱི།",
    "རྣམ་དཔྱོད་རིག་པའི་བ་དན་ཁྱོད་ཀྱིས་ཕྱིར།",
    "འདོད་ཡོན་སྲིན་མོའི་འཛུམ་ལ་མི་ཆགས་པར།",
    "མདའ་ལྔའི་གཡོ་ཐབས་བྱུང་ན་ཁྱོད་ཀྱིས་བསྙིལ།",
    "དེར་ནི་འདི་ཕྱིའི་རེ་ལྟོས་ཆིག་དྲིལ་དུ།",
    "རེ་དོགས་རྟག་ཆད་གཡངས་སུ་མི་ལྷུངབར།",
    "མཚོན་པ་དབྱིབས་ཀྱི་ལྷ་མོའི་སྐུར་སྨིན་ཏེ།",
    "ལས་བཞི་གྲུབ་བརྒྱད་མཆོག་གི་དགའ་སྟོན་ཅན།",
    "གནས་པ་གཞི་ཡི་ལྷ་མོ་ཙཎྜ་ལི།",
    "དེ་ཚེ་ལྷན་སྐྱེས་དོན་གྱི་ལྷ་མོའི་ཞལ།",
    "འཆི་མེད་རྟག་པའི་རྒྱལ་མོའི་དོན་མཐོང་ཤོག།",
    "བདེ་ཆེན་ཤེར་ཕྱིན་མཛེས་ཟམའི་རེག་བྱ་ཡིས།",
    "གང་ཞིག་མཐོང་ཐོས་རེག་དང་དྲན་པས་ཀྱང་།",
    "ཐུན་ཟོར་དམོད་པའི་དུག་སྤྲིན་གཡོ་བ་ཡང་།",
    "ཟུར་མིག་གློག་གི་རེག་པས་ཟུར་ཙམ་ཞིག།",
    "མཐོང་བས་ཡོན་ཏན་ལང་ཚོ་རྒྱས་པའི་དཔལ།",
    "བྱངཆུབ་སྤྱོད་པའི་ལང་ཚོ་རྫོགས་པའི་ཕྱིར།",
    "བདག་གི་མ་མ་མཛོད་ཅིག་རྒྱལ་བའི་ཡུམ།",
    "ཟབ་རྒྱས་གྲུ་ཆར་ཆིལ་ཆིལ་འབབས་ལས་བདེ་སྐྱིད་དབྱར་གྱི་དཔལ་མོ་བཞད།",
    "སྙན་འགྱུར་ཚིག་གི་ཕྲེང་ཆུང་ཅུང་ཟད་བསྟར་བ་པོ་ནི།",
    "ཨདགྱེས་པའི་ལང་ཚོར་འབོད་པས་རང་ལོ་༢༧པར་སླེབ་པ་ན།",
    "བྱ་དང་རི་དྭགས་ཀྱི་ཚོགས་རྣམས་བག་ཡངས་སུ་རྒྱུ་བས་ལྷན་སྐྱེས་མགྲིན་པའི་རོལ་མོ་ཡང་འགྲམ།",
    "མཁན་འཆི་མེད་རབ་བརྟན། ། ན་མོ་གུ་རུ་ཛྙཱ་ན་ས་ཏཱ་ཡེ།",
    "མཁའ་ཁྱབ་ཞིང་གི་བཀོད་པ་སྟུག་པོ་བཀོད།",
    "ཐམས་ཅད་གཟིགས་པས་གསང་རྒྱུད་རྒྱ་མཚོ་ཀུན།",
    "ཐལ་འགྱུར་རིག་པའི་སེང་གེའི་ང་རོ་ཡིས།",
    "ཐེག་མཆོག་འོད་ཟེར་རྡོ་རྗེ་རྩེ་མོའི་ས།",
    "ཕྱག་གི་མཚོ་ལས་སྐྱེས་པའི་ངོ་མཚར་འཛིན།",
    "སྣང་བཞིའི་ཡེ་ཤེས་ལྟད་མོ་ཕ་མཐའ་བྲལ།",
    "གསང་མཆོག་རྡོ་རྗེ་བཙུན་མོའི་བྷ་ག་ན།",
    "སྣ་ཚོགས་སྣང་བ་གཏད་མེད་ཟང་མ་ཐལ།",
    "འགྱུར་མེད་རྡོ་རྗེ་ཁྱོད་ཉིད་ཁོ་ནར་ངེས།",
    "ཐུབ་བསྟན་སོས་ཀའི་ཁྲི་ཤིང་རྩེ་མོ་ནས།",
    "མཁའ་འགྲོ་རྣམས་དང་ཚོགས་ཀྱི་འདུ་བར་རོལ།",
    "ཀ་དག་ཉིད་ཀྱང་ཧར་སངས་རྗེན་ལ་བུད།",
    "ས་དང་ལམ་སོགས་བགྲོད་བྱའི་རེ་དོགས་སངས།",
    "ཁམས་གསུམ་ཡུལ་སྣང་ཆུ་ཟླ་ལྟ་བུར་གཟིགས།",
    "ཐུགས་རྗེས་གཟིགས་ཤིག་འཇམ་མགོན་རྡོ་རྗེ་འཆང་།",
    "རེ་ཞིང་ལྟོས་པ་ཁྱོད་ལས་གཞན་མེད་པས།",
    "ཚིག་གི་ཞིབ་ཆ་གང་གཱའི་རྒྱུན་ལྟར་ཞིབ།",
    "ཐུབ་བསྟན་ཕྱོགས་ཀྱི་བུ་མོའི་རྣ་རྒྱན་དུ།",
    "གྲགས་པའི་གུར་གུམ་བཞད་པའི་ལང་ཚོ་སྩོལ།",
    "ཉམས་ཐག་གྱུར་ལ་ངེས་པར་བལྟས་པའི་མོད།",
    "དྲུག་ཚན་དྲུག་གིས་བསྡུས་པའི་ཕ་རོལ་ཕྱིན།",
    "རང་གི་ལུས་འདི་དུམ་བུར་བཏུབ་ཀྱང་རུང་།",
    "ཆུ་སྐྱེས་མཆོག་གི་ཟེའུ་འབྲུའི་ཉི་མའི་རྡུལ།",
    "ཁ་སྦྱོར་བཞི་ཡིས་ནང་གི་ས་ལམ་བགྲོད།",
    "པ་དེར་འཛིན་རྟོག་པའི་རི་མོ་སྟོང་པར་ཡལ།",
    "ཡིད་བྱེད་སྤྲོས་པ་བྲལ་བའི་རྗེན་ལ་བུད།",
    "ཁྱད་པར་འོད་གསལ་རྡོ་རྗེ་རྩེ་མོའི་ལམ།",
    "གང་གི་མི་བརྫི་ཕྱོགས་ལས་རྣམ་རྒྱལ་དཔལ།",
    "མ་འབད་ངང་གིས་རྫོགས་པར་བྱིན་གྱིས་རློབས།",
    "མ་འབད་བཞིན་དུ་ངང་གིས་གྲོལ་བར་ཤོག་༩༤།",
    "མིང་གི་ལྷག་མར་བྱེད་པའི་མཐུ་ཐོབ་ཤོག་༡༢།",
    "སྟོན་མཆོག་ཐུབ་པའི་སྣང་བརྙན་གསེར་ཟངས་ལས་གྲུབ་པའི་རྟེན་བཅས་བཀའ་ལུང་སྤྱི་བོར་ཕེབས་པ་གུས་པས་གཙུག་ཏུ་མཆོད་མོད།",
