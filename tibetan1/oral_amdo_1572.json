    "ཉིན་གུང་བདུན་དང་༡དགོང་མོ་དགུ།",
    "གསར་དུ་བསྣན་པ་ཙོང་ཞི་དྲུག་པ་ཆུ་སྐོལ་ཚན་མོས་དབུལ།",
    "ཙོང་ཞི་འཕྲུལ་ཐལ་ཀ་ར་སྦྱར་བ་འདིས།",
    "འཆི་མེད་བདུད་རྩིའི་བུམ་བཟང་གི་ཤོག་གྲངས་ནང་གསལ།",
    "འཆི་མེད་བདུད་རྩིའི་བུམ་བཟང་གི་ཤོག་གྲངས་ནང་གསལ།",
    "སྐབས་མཚམས་ཐང་གིས་ཁ་བསྒྱུར་བྱུ།",
    "འདི་ལས་གཞན་དུ་གབ་སྦས་ཡོད་རེ་ཀན་ག་ཅེས་བསྡུས་༢ ཆི་མེད་ནོར་ཕྲེང་གི་ཤོག་གྲངས་ནང་གསལ།",
    "བདུད་རྩི་ལྔ་ཡི་སྦྱོར་བ་བསྐོལ་གྲང་གིས།",
    "བ་མོར་ཉི་ཤར་བཞིན་དུ་འཛོམས་པར་བྱེད།",
    "ཕྱེ་མ་འུ་སྒྱུར་ལྷ་མོ་ཡིས།",
    "ཐང་གིས་ཕུལ་བདེ་བྱེད་ཆུ་བསྒྱུར་ཆུང་འབྲིང་ཆེབཏང་ཚ་གྲང་མཉམ།",
    "ཨ་མ་དཀར་ནག་ཁྲ་གསུམ་ལ།",
    "འདི་ལས་ལྷག་པ་ཡོད་རེ་ཀན།",
    "ནག་མཚུར་སེང་ཕྲོམ་ཨ་རུའི་གྲུང་ཐང་ནུག་ཚུར་གསུམ་ཐང་གིས།",
    "འཆི་མེད་བདུད་རྩིའི་བུམ་བཟང་གི་ཤོག་གྲངས་ནང་གསལ།",
    "མཚན་གཉིད་མི་ཁུག་ཉིན་མོ་གཉིད་ཆེ་ལ།",
    "ཞ་རེངས་འཁུམ།",
    "ཕག་མོ་གྲུ་པའི་སྦྱོར་བ་འདིས།",
    "མ་ལུས་བ་མོར་ཉི་ཕོག་བཞིན།",
    "གཅེས་བསྡུས་འཆི་མེད་ནོར་ཕྲེང་གི་ཤོག་གྲངས་ནང་གསལ།",
    "ངག་གི་གྲེ་འཛིར་ལ་སོགས་སེལ་བ་དང་།",
    "འཆི་མེད་བདུད་རྩིའི་བུམ་བཟང་གི་ཤོག་གྲངས་༧༢ ནང་གསལ།",
    "མན་ངག་རྒྱུད་ཀྱི་ཕྱི་སྔོན་གྱི་ཤོག་གྲངས་ནང་གསལ་འབྱར་ཆེན་རེག་པ་བདེ་སྐྱེད་སྐྲངས་པོར་བྱུགསདེ་སྟེང་སྤུ་ནན་ཆིངས་སོགས་ཚུལ་བཞིན་དུ།",
    "འབྲས་བུ་ཚ་གྲང་གང་གིས་སྐྲངས་པ་འཇོམས།",
    "སྦྱོར་ཚད་ཆེན་མོ་ཡི་ཤོག་གྲངས་ནང་གསལ།",
    "ག་ཅེས་བསྡུས་འཆི་མེད་ནོར་ཕྲེང་གི་ཤོག་གྲངས་༣ ནང་གསལ།",
    "ག་ཅེས་བསྡུས་འཆི་མེད་ནོར་ཕྲེང་གི་ཤོག་གྲངས་ནང་གསལ།",
    "བྲག་ཞུན་ཐང་གིས་འཕུལ་ལ་བཏང་།",
    "འཆི་མེད་བདུད་རྩིའི་བུམ་བཟང་གི་ཤོག་གྲངས་ནང་གསལ།",
    "ཞི་བྱེད་དྲུག་གི་སྦྱོར་བ་འདིས།",
    "ཟངས་ཐལ་ཉེར་དྲུག་ཅེས་པའི་ཕན་ཡོན་ནི།",
    "ས་སྟེང་འདི་ན་ཉིན་མོའི་སྐར་མ་ཙམ།",
    "ཟངས་ཐལ་ཉེར་ལྔའི་སྦྱོར་བ་འདིས།",
    "ཟངས་ཐལ་ཞེ་གསུམ་ཞེས་གྲགས་བྱུང་པའི་ལུགས།",
    "བུད་མེད་བུ་མེད་ལ་ཡང་བུ་རྙེད་འགྱུར།",
    "འཆི་མེད་བདུད་རྩིའི་བུམ་བཟང་གི་ཤོག་གྲངས་ནང་གསལ།",
    "ཟུར་ལུགས་ཟླ་ཤེལ་ཆེན་མོའི་སྦྱོར་བ་འདི།",
    "པར་དངུལ་ཆུ་བཙོ་བཀྲུ་ཆེན་མོ་སོགས།",
    "རིན་ཆེན་མང་སྦྱོར་ཆེན་མོ་ཁྱད་འཕགས་འདི།",
    "སྦྱར་དུག་གྱུར་དུག་རང་བཞིན་དངོས་ཀྱི་དུག་མཐོང་བའི་དུག་དང་རེག་པ་ཉི་ཟེར་དུག་ཁ་རླངས་དུག་སོགས་དུག་རིགས་མཐའ་དག་འཇོམས།",
    "རིན་ཆེན་བཙོ་བཀྲུ་ཟླ་ཤེལ་ཆེན་མོ་འདིས།",
    "རེངས་འཁུམས་འདར་དང་ཞ་རེངས་བྱ་བ་ཉམས།",
    "རིན་ཆེན་ཚ་སྦྱོར་ཆེན་མོ་ཚད་ལྡན་སྦྱར།",
    "ཆམ་པའི་གཞུག་གི་གློ་རྒྱལ་ལ།",
    "ཤ་རུས་རྩ་ལྤགས་རེངས་འཁུམས་འབྲས།",
    "སྦྱར་ཐབས་ཉེར་མཁོ་འགའ་ཞིག་གི་ཤོག་གྲངས་ནང་གསལ།",
    "༢ ཆི་མེད་བདུད་རྩིའི་བུམ་བཟང་གི་ཤོག་གྲངས་ནང་གསལ།",
    "འཕྲུལ་བྱེད་ཆུ་སྐོལ་ཚན་མོ་སྐབས་འཆར་ཆུང་།",
    "གུང་གཉིས་བ་འོ་དྲོན་མོས་ཕུལ་ལ་བཏང་།",
    "སེང་ཁྱོམ་གཉིས་སྦྱོར་མངལ་ཁྲག་འཛག་པ་གཅོད།",
    "ལུས་སྟོབས་སྦྱར་ལ་དགོང་དང་ཐོ་རེངས་དུས།",
    "དུས་མཐའི་མེ་དང་ཉེ་བའི་བ་མོ་བཞིན།",
    "ཐོ་རེངས་བསྟེན་པས་ཡོན་ཏན་འདི་ལྟར་འབྱུང་།",
    "སྦྱོར་ཚད་ཆེན་མོ་ཡི་ཤོག་གྲངས་ནང་གསལ།",
    "དྲེག་གྲུམ་མཛེ་དང་རེངས་འཁུམས་མཁལ་རྩ་བསྣད།",
    "དྲེག་གྲུམ་མཛེ་དང་རེངས་འཁུམས་མཁལ་རྩ་བསྣད།",
    "བསམ་འཕེལ་ནོར་བུའི་སྟེང་ཁྱུང་ལྔ་བསྙན་པ་གསལ་བྱེད་ཨ་ཝ་བཅོ་ལྔ་ཐོ་རེངས་དུས།",
    "ཡུན་དུ་བསྟེན་པས་མིག་གི་བདུད་རྩིར་གྱུར།"
  ]
