    "གཉིས་སུ་ན་བདེན་རྫུན་གྱི་ཤན་འབྱེད་ནུས་པར་གདའ་བས།",
    "འཇིག་རྟེན་པའི་ལྷ་འདྲེ་སྣ་ཚོགས་པའི་སྐུ་གཟུགས་རྣམས་ཐབ་གསུམ་པར་བརྩིགས་སོ་། ལྷོ་ཕྱོགས་སུ་གདན་ཁྲི་ཆེན་པོ་བཤམས་ནས་རྒྱལ་པོ་བློན་པོའི་འཁོར་དང་བཅས་པ་འདུག་གོ།",
    "ཀུ་མ་ར་ཤྲཱི་ཞེས་པའི་པཎྜི་ཏ་མཁས་པ་ཅིག་ཡོད་འདུག་ཀྱང་།",
    "དེར་རྒྱལ་ཁམས་ཆུང་བས་འགྲོ་དོན་མི་འཕེལ་བར་འདུག།",
    "ཡུད་ཙམ་ཞིག་ན་ལམ་གྱི་ལོགས་ན་རྟེའུ་ཞིག་རྩྭ་ཟ་ཞིང་འདུག།",
    "མ་བྲོས་ཀྱང་བསྲུང་མི་ཐུབ་པར་འདུག་དེ་ལས་ཇག་དཔོན་ལ་མགོ་བཏགས་ན་ལེགས་སམ་སྙམ་སྟེ་རྟེན་གྱི་དྲུང་དུ་བརྟག་པ་ཕུལ་བས།",
    "སྲས་ཆེ་བ་དཔོན་བཙད་པོ་ཞེས་གྲགས་པ་ཡང་རང་བཞིན་བཟང་ཞིང་བློ་གྲོས་ཆེ་བ།",
    "ཁོ་རང་གང་འདོད་ལྟར་བྱེད་བཅུག་ན་ཞེས་ཞུས་པས།",
    "མཁྱེན་པ་ཡངས་ཤིང་རང་བཞིན་བཟང་བ།",
    "འདི་ལ་དཔག་ན་ཚེ་ཐུང་བར་འདུག་པས་དགེ་སྦྱོར་ལ་འབུངས་དགོས་གསུངས་ནས་ཐུགས་དམ་ལ་གཞོལ་བར་མཛད།",
    "གཅེན་གྱིས་སྙུང་གཞི་གང་འདྲ་འདུག་ཅེས་དྲི་བ་གནང་བས།",
    "དུས་ཕྱིས་གཟུགས་ཕུང་མི་བདེ་བར་འདུག་ཀྱང་སེམས་ལ་དགའ་སྤྲོ་མ་གཏོགས་འགྱོད་པ་མི་སྣང་ཞེས་གསུངས།",
    "འདི་རྒྱ་གར་མ་མིན་པར་འདུག་སྟེ་སྔར་གྱི་རྣམས་ཀྱིས་ཀྱང་དྲིས་ཟིན་འདུག་པས་འདིར་བཞུགས་སུ་བཅུག་པ་ཡིན་ནོ། ཅ་པ་ལ།",
    "བཅོམ་ལྡན་འདས་དགྱེས་པའི་རྡོ་རྗེའི་ཐཐཐཐསྒྲུབ་པའི་ཐབས་དེ་ཁོ་ན་ཉིད་བཞིའི་རིམ་པ་ཞེས་བྱ་བ་སློབ་དཔོན་ཀམྤ་ལས་མཛད་པ་པཎྜི་ཏ་བི་རོ་ཙ་ན་རཀྵི་ཏ་དང་།",
    "སྔར་གྱི་རྣམས་ཀྱིས་ཀྱང་བྲིས་འདུག་པས་སོ།",
    "འདི་ལ་དཔེ་ལ་ལར་ཀུ་ཀུ་རི་པས་མཛད་ཟེར་བ་འང་འདུག།",
    "བོད་སྐད་དུ་བསྒྱུར་བ་ཡིན་པས་སྔར་གྱི་རྣམས་ཀྱིས་བྲིས་འདུག་པས་བྲིས་ཞེས་གསུང་ངོ།",
    "འགྲེལ་པ་འདི་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་མཛད་མ་མཛད་རྩོད་པ་ཅན་དུ་འདུག་ནའང་།",
    "བོད་མ་མ་ཡིན་པར་འདུག་ཅིང་མཚན་བཟང་པོར་གཡར་འདུག་པའི་དོན་ལ་དབུ་རུ་བཞུགས་སུ་བཅུག་པ་ཡིན་ཞེས་གསུངས་སོ། ཧ་པ་ལ།",
    "འདི་ཡེ་ཤེས་ཞབས་ཀྱི་རྗེས་འབྲང་བྱ་བའི་དམིགས་བསལ་མི་འདུག་ནའང་།",
    "སྔར་གྱི་རྣམས་ཀྱིས་ཡེ་ཤེས་ཞབས་ལུགས་ཀྱི་སྐོར་དུ་བྲིས་འདུག་པས་བྲིས་སོ།",
    "སྔར་གྱི་རྣམས་ཀྱིས་བྲིས་འདུག་ཅིང་དོན་བཟང་བས་བྲིས་སོ།",
    "ལྷ་བསྐྱེད་ཆོག་ལ་སོགས་ཀྱང་འཕགས་སྐོར་དང་ཆ་མཐུན་པར་འདུག་ཅིང་ཡེ་ཤེས་ཞབས་ལུགས་དང་མི་མཐུན་པས་ལུགས་གུད་དུ་བྱས་སོ།",
    "དེ་ཉིད་ཀྱིས་བསྒྱུར་བ་འདི་གཤེད་དམར་གྱི་སྐོར་ཡིན་ཏེ་འབྲེལ་འདུག་པས་དེར་བཞག་གོ།",
    "དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་སྒྲུབ་པའི་ཐབས་རྡོ་རྗེའི་འོད་ཅེས་བྱ་བ་དང་དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག་གསལ་བ་ཞེས་བྱ་བ་རྒྱ་གར་གྱི་པཎྜི་ཏ་བི་རོ་ཙ་ན་རཀྵི་ཏས་མཛད་པ།",
    "པཎྜི་ཏ་བི་རོ་ཙ་ན་དེ་ཉིད་དང་།",
    "སྔ་འགྱུར་ལ་འདི་ལས་ཚན་ཆེ་ཙམ་གདའོ་ཞེས་བུ་སྟོན་གྱིས་གསུངས་སོ།",
    "འདི་དག་ལ་ཐེ་ཚོམ་ཟ་བ་སྣང་ཡང་རྒྱ་གར་མར་བྱེད་ཀྱིན་འདུག་པས་བྲིས་སོ་ཞེས་གསུངས།",
    "ཕྱག་ན་རྡོ་རྗེ་རྣལ་འབྱོར་ཆེན་པོར་བཀྲལ་བའི་སྐོར་འདི་ལ་ཐེ་ཚོམ་ཟ་བའི་གཞི་མང་དུ་སྣང་ཡང་བོར་ན་གྲགས་པ་ཅན་དུ་འདུག་པས་བྲིས་སོ་ཞེས་བུ་སྟོན་གྱིས་གསུངས་སོ།",
    "རྒྱ་གར་ལྷོ་ཕྱོགས་ཀྱི་ཡུལ་ཀོ་ས་ལར་སྐུ་འཁྲུངས་པའི་རྣལ་འབྱོར་པ་ཆེན་པོ་ཤྲཱི་བི་རོ་ཙ་ན་བཛྲའི་རང་འགྱུར།",
    "ཤྲཱི་བི་རོ་ཙ་ན་རཀྵི་ཏའི་རང་འགྱུར།",
    "ཤྲཱི་བི་རོ་ཙ་ན་བཛྲའི་རང་འགྱུར།",
    "སྔར་གྱི་རྣམས་ལའང་བྲིས་འདུག་པས་བཞུགས་སུ་བཅུག་པ་ཡིན་ནོ།",
    "དཔེ་དངོས་ལ་མཛད་འགྱུར་ཅི་ཡང་མི་འདུག།",
    "སྔར་གྱི་རྣམས་ཀྱིས་བྲིས་འདུག་པས་བཞུགས་སུ་བཅུག་པ་རྣམས་སོ།",
    "འདི་རྩ་འགྲེལ་གཉིས་ཀ་རྫུན་མ་ཡང་དག་པ་ཅིག་འདུག་སྟེ།",
    "སྔར་གྱི་རྣམས་ཀྱིས་བྲིས་འདུག་པས་འདིར་ཡང་བཞུགས་སུ་བཅུག་པ་ཡིན་ནོ།",
    "འདི་སྐྱོད་པའི་རྒྱུད་དང་བསྐྱེད་ཆོག་རྣམས་མཐུན་པར་བཀོད་འདུག་ནའང་།",
    "རྒྱུད་འགྲེལ་དག་ལས་དམ་ཚིག་གསུམ་བཀོད་བྱ་རྒྱུད་དུ་གསུངས་འདུག་པས་འདིར་བྲིས་སོ།",
    "ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་ཀྱི་ཆོ་ག་སློབ་དཔོན་ཤདྡྷཱ་ཀ་ར་ཝརྨས་མཛད་པ།",
    "ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་དངོས་གྲུབ་བརྙེས་པའི་སློབ་དཔོན་མི་ཕམ་བཤེས་གཉེན་གྱིས་མཛད་པ།",
    "སྤྲོས་པ་མེད་པའི་སྒྲུབ་ཐབས་ཞེས་བྱ་བ་ཚིག་ལྷུག་པའི་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས།",
    "ཚིག་ལྷུག་པའི་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་སློབ་དཔོན་པདྨ་འབྱུང་གནས་ཀྱིས་མཛད་པ།",
    "ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་སློབ་དཔོན་ཆེན་པོ་མི་ཕམ་བཤེས་གཉེན་ཟླ་གྱིས་མཛད་པ།",
    "འཕྲལ་དུ་ཉམས་སུ་མྱོང་བའི་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས།",
    "ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་སློབ་དཔོན་མི་ཕམ་པ་ཤེས་གཉེན་གྱིས་མཛད་པ།",
    "ཚིག་ལྷུག་པའི་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས།",
    "འཕྲལ་དུ་ཉམས་སུ་མྱོང་བའི་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས།",
    "ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས།",
    "པཎྜི་ཏ་བི་རོ་ཙ་ན་དང་།",
    "ལོ་ཙཱ་བ་ཨཱ་ཙཱརྱ་བི་རོ་ཙ་ན་རཀྴི་ཏའི་འགྱུར།",
    "བོད་ན་འདི་དག་སེམས་ཙམ་ལུགས་སུ་གྲགས་འདུག་པ་དང་།",
    "ཞུ་ཆེན་གྱི་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན་རཀྵི་ཏས་བསྒྱུར་བ་ལ།",
    "འདི་འགྲེལ་པ་བཟང་པོ་ཅིག་སྣང་སྟེ་མཛད་བྱང་འགྱུར་བྱང་ལ་སོགས་མི་འདུག་པས་འདིར་བཞུགས་སུ་བཅུག།",
    "དུས་ཀྱི་འཁོར་ལོའི་རྩིས་ཀྱི་མན་ངག་དུས་ཞབས་པ་ཆུང་བ་བོ་དྷི་བྷ་དྲས་མཛད་པ།",
    "སྔོན་གྱི་རྣམས་ཀྱིས་ཀྱང་བཀྲ་ཤིས་པའི་ཡན་ལག་ཏུ་བསྟན་བཅོས་ཀྱི་མཇུག་ཏུ་བཀོད་འདུག་པས་འདིར་ཡང་དེ་བཞིན་དུ་བཀོད་པ་ཡིན་ནོ།",
    "ཞེ་སྡང་རང་སྣང་ཞུགས་ཀྱི་ཕུང་པོ་བསྐལ་པའི་མེ་དཔུང་བཞིན་འབར་བ་། ག་བུར་ཟེགས་མ་འཐོར་བ་དང་ལྡན་བདུད་རྩིའི་མཆོད་ཡོན་ཉིད་འགྱུར་ཞིང་། ཕན་ཚུན་གསོད་སླད་མཚོན་ཆའི་འཁོར་ལོ་གནམ་ལྕགས་ཐོག་ལྟར་འཚུབ་པ་ཡང་།",
    "འཐབ་དང་རྩོད་པའི་སྡུག་བསྔལ་བརྒྱས་གཟིར་ལྷ་མིན་འགྲོ་བ་དེ་དག་ཀྱང་།",
    "སྣ་ཚོགས་ལོ་ཏོག་དུས་སུ་སྨིན་པས་ནོར་འཛིན་བཞིན་རས་དུད་གྱུར་ཅིག།",
    "གཟུགས་རྣམས་རྒྱན་དང་རང་བཞིན་ལེགས་ལྡན་མེ།",
    "མ་བྱུང་བ་དང་མ་སྐྱེས་པདང་རང་བཞིན་གྱིས་སྟོང་པ་དང་དངོས་པོ་མེད་པ་ཞེས་བྱ་བ་ལསོགས་པ་རྣམ་གྲངས་དུ་མས་བསྟནཏོ།",
    "ཡོངས་སུ་གྲུབ་པའི་རང་བཞིན་ནི་བདེན་པ་ཡང་དག་པ་ཕྱིན་ཅིམ་ལོག་པ་ཡིན་པས་ཀུན་བརྟགས་དང་རང་བཞིན་གཅིག་པ་མ་ཡིན་ནོ།",
    "མཐོ་བ་ནི་རྩེགམ་དང་རིམ་པ་དུ་མ་འདུག་པའོ།",
    "རྒྱུ་དང་རང་བཞིན་དང་།",
    "དེ་ཡང་བཟོད་པ་ཡོངས་སུ་སྨིན་པའི་རྒྱུདང་རང་བཞིན་དང་།",
    "ངན་པ་ཡང་མཐོང་བ་དེབཞིན་དུ་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱང་ཉན་ཐོས་དང་རང་སངསརྒྱས་རྣམས་ཀྱི་གནས་གཞན་དུ་གྱུར་པ་ལས་འཕགས་པ་དེ་བཞིནགཤེགསཔའི་གནས་གཞན་དུ་གྱུར་པ་མཐོན་པོ་དེ་བརྙེས་ནས།",
    "འཇིག་རྟེན་གྱི་བྱེད་པ་ནི་འགྲོ་བ་དང་འདུག་པ་དངཉལ་བ་ལ་སོགས་པའོ།",
    "སྟོང་པ་ཉིདནི་སོ་སོའི་སྐྱེ་བོའིདུས་ན་ཡང་སྟོང་པ་ཉིད་དང་རང་བཞིན་གྱིས་འོད་གསལ་བའི་རངབཞིན་ཡིན།",
    "འབྱོར་པ་ཟབ་པས་ཉན་ཐོས་དང་རང་སངསརྒྱས་ཀྱི་སེམས་ཀྱི་ཡུལ་ལས་འདས་པས་ན་བསམ་གྱིས་མི་ཁྱབ་པའོ།",
    "རུས་སྦལ་དེ་ནི་ཆུ་ཡི་ནང་ན་བསྐུམ་ཞིངའདུག།",
    "སྔོན་ཞུམ་རྒོད་དང་བཅས་པའི་གནས་དངབྲལ་ནས་ཞུམ་རྒོད་མི་འབྱུང་ཞིང་སེམས་རྣལ་དུ་འདུག་པའི་གནསཐོབ་པའི་ཕྱིར་གནས་པརགྱུར་པ་ཞེས་བྱ་སྟེ།",
    "དེ་ལྟར་སྣང་བ་ཙམ་དུ་ནི་ཡོདཔ་དང་རང་བཞིན་ནི་མེད་པས་ན་གཟུགས་ལ་སོགས་པའི་དངོས་པོ་དངདངོས་པོ་མེད་པ་གཉིས་བྱེ་བྲག་མེད་ཅིང་དོན་གཅིག་པར་བྲྗོད་དེ།",
    "སྣང་བ་ཙམ་དུ་ཡོད་ཀྱང་རང་བཞིན་མེད་པའི་ཕྱིར་ཡོདཔ་ཡང་མ་ཡིན་ནོ།",
    "ཞི་དང་རང་བཞིན་མྱ་ངན་འདས།",
    "དེལྟར་ལྷ་ཚེ་རིང་པོའི་ནང་དུ་འདུག་འདུག་པ་ལས།",
    "ཡིན་ལ་མིང་རང་བཞིན་ཡོད་པ་བཞིན་དུ་དེས་མཚོན་པརབྱ་བའི་བུམ་པ་དང་།",
    "དེ་ལྟར་མིང་ལ་རང་བཞིན་ཡོད་པར་མ་མཐོང་བས་ན་དོན་ལཡང་རང་བཞིན་ཡོད་པར་མི་ཆགས་མི་འདོད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གང་ཉནཐོས་དང་རང་སངསརྒྱས་ཀྱི་ཡིད་ལ་བྱེད་པ་བདག་ལ་ཕན་པ་དང་བདེ་བར་བྱེད་པདང་།",
    "ངོབོ་མེད་དང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་ལ་སྐྲག་པ་སྤངབའི་ཚིགས་སུ་བཅད་པ་བཞི་སྟེ་ཞེས་བྱ་བ་ལ།",
    "ནམ་སྒོང་ངབྱུང་བའི་དུས་ན་བརྩམས་ནས་སྒོ་གཤོག་མ་རྫོགས་ཀྱི་བར་དུབྲང་དང་ལུས་དང་གཤོག་པས་གཡོགས་ནས་འདུག་སྟེ།",
    "ཡོངས་སུ་གྲུབ་པའི་མཚན་ཉིད་ནི་ཐོགམ་ནས་ཀྱང་གཟུང་འཛིན་གྱི་དྲི་མ་དང་བྲལ་ཞིང་རང་བཞིནགྱིས་སྟོང་པ་ཡིན་ཏེ།",
    "དེ་ཡང་རང་བཞིན་ཉིད་ཀྱི་མཚན་ཉིད་དོ།",
    "སྔོན་ལོ་ཆེན་བེ་རོ་ཙ་ན་དང་།",
    "བཙ་ན་བད་སྤྱད་ཡང་དག་མིན།",
    "སྒྱིད་ལུག་པ་དང་རང་མཐོང་ཆེ།",
    "བེ་རོ་ཙ་ན་དང་སྐ་ཅོག་ཞང་བ་སུམ་ལ་སེ་ས་པའི་སྔ་འགྱུར་སྤྱི་ལེ་པཱ་ན་ཨཱན།་",
    "ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས་ཤིགསེས་ཤུན་བྱེད་པ་ལ།",
    "དེ་ལྟར་དཔྱད་ན་ཀུན་རྫོབ་ཙམ་དུ་ཡང་རིག་པའི་དོན་བདེན་པའི་དོན་དུ་གྲུབ་པ་གང་ཡང་མི་འདུག་ཨང་སྙམ་དུ་བསམ།",
    "དཔྱད་ན་ངོས་བཟུང་ཐམས་ཅད་དང་བྲལ་བ་ཡེ་ནས་མ་སྐྱེས་པར་འདུག་ཨང་སྙམ་དུ་བསམ།",
    "གཉེན་པོ་ཉིད་ཀྱང་རང་སར་གྲོལ།",
    "སེམས་སྤྱི་དུས་ན་རང་བཞིན་མེད་པར་གྲུབ་པ་གོང་དུ་དཔྱད་པས་ཡེ་ནས་བདེན་པར་མ་གྲུབ་པར་འདུག་ཨང་སྙམ་དུ་བསམ་ལ།",
    "ཕན་པ་དང་བདེ་བ་ཐམས་ཅད་ཀྱིས་ཕན་འདོགས་པའི་དྲིན་ཅན་དུ་འདུག་པ་ཨང་སྙམ་དུ་བསམ་ལ།",
    "ཕུང་བྱེད་འུག་མགོ་ཅན་དེ་ནི་ང་དང་བདག་ཏུ་འཛིན་པར་བྱ་བ་རང་དོན་འབའ་ཞིག་བསྒྲུབ་པའི་བློ་ཅན་འདིར་འདུག་པ་སྙམ་དུ་བསམས་ལ་དགྲ་ལ་དགྲར་ངོ་ཤེས་པར་བྱའོ།",
    "དེ་ཡང་བསྡུས་ན་བདག་ཏུ་འཛིན་པ་གཅིག་པུར་འདུག་པས།",
    "ཕན་པ་དང་བདེ་བ་ཐམས་ཅད་ཀྱིས་ཕན་འདོགས་པའི་དྲིན་ཅན་འབའ་ཞིག་ཏུ་འདུག་ཨང་སྙམ་དུ་ཤེས་པ་ཉེ་དུངས་པ་བསྐྱེད་ལ།",
    "འོ་ན་ཐོག་མ་མེད་པ་ནས་འདིས་ང་ལ་ཕན་པ་འབའ་ཞིག་བསྒྲུབ་ནས་འདུག་པ་ལ་ངས་གནོད་པ་འབའ་ཞིག་བསྐྱལ་ནས་འདུག་ཨང་སྙམ་དུ་བསམས་ལ།",
    "མི་མ་ཡིན་པ་འདུག་པ་མདུན་དུ་སྤྱན་དྲངས་ལ།",
    "དེ་འཕྲོག་ལ་ཨ་པ་རང་སེམས་སུ་འདུག་པ་སྙམ་ན།",
    "བདེ་བ་ཐམས་ཅད་བསྒྲུབ་པར་འདུག་པས།",
    "དེས་ན་འདིས་བདག་ལ་ཕན་འདོགས་པར་འདུག་པ་ཨང་སྙམ་དུ་བསམ།",
    "འདི་ཐམས་ཅད་ལུས་བཟུང་བས་ལན་ནས་འདུག་པས།",
    "སྨ་འབེབས་སུ་འདུག་རྟོག་དཔྱོད་གྱིས་དང་།",
    "ཚེ་འདིའི་ཆེ་ཐབས་དང་འདོད་པ་བསྒྲུབ་པར་འདུག་ན།",
    "ཞེས་བྱ་བའི་རྣམ་གྲངས་ལ་རིམ་པས་བརྟག་ནས་འགལ་བར་སྤྱད་ནས་འདུག་ན།",
    "ཀོ་ལོང་གཙང་བཙན་པས་དམ་པར་འདུག་སྟེ།",
    "སུ་འདུག་པ་ལ་ཕུལ་ཅིག་ཟེར་བའི་སྒྲ་ཞིག་བྱུང་བ་ན་འོད་སྲུངས་སོགས་ལ་ཕུལ་བས་ཀྱང་སུ་ཡང་མ་མཐོང་ཞིང་།",
    "སུ་འདུག་པ་ལ་ཕུལ་ཅིག་ཟེར་བའི་སྒྲ་ཞིག་བྱུང་བ་ན་འོད་སྲུངས་སོགས་ལ་ཕུལ་བས་ཀྱང་སུ་ཡང་མ་མཐོང་ཞིང་།",
    "འོན་ཀྱང་ཡི་དམ་གྱིས་གསུངས་པའི་གདམས་པ་ཁ་ཤས་ཀྱི་མིང་འདུག་པ་ནི་དཔེར་ན།",
    "ང་རང་བསྟན་པ་དང་འགྲོ་བའི་དོན་དུ་ཅིས་ཀྱང་འགྲོ་དགོསཔས།",
    "ད་ནི་ང་རང་གནས་གང་དུ་བསྡད་ཀྱང་འཆི་བ་ལས་འོས་མེད་སྙམ་ནས་བྱ་རྒོད་ཀྱི་སྟེང་དུ་མཆོངས་པ་ན།"
  ]
}