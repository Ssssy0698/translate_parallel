    "དེས་ན་དེ་འདྲ་དེ་ཡིས་རྟོག་ཡིན་པས་མངོན་སུམ་མ་ཡིན་ཀྱང་རང་ཡུལ་གསལ་བར་སྣང་ངོ།",
    "སྣང་བ་དེ་གཉིས་ལས་གང་རང་རིག་པ་དེ་ནི་འབྲས་བུར་འགྱུར་རོ།",
    "རྣམ་བདེན་པ་ལ་སྲིད་པ་དེའི་ཚེ་ན་འཛིན་རྣམ་དང་རང་རིག་ཁོ་ནང་ཁོ་ནར་ཕྱོགས་པ་ཡིན་མིན་གྱི་ཁྱད་པར་ཅུང་ཟད་འབྱེད་དགོས་པར་གསལ་ལོ།",
    "དོན་རིག་ལ་སྒྲུབ་བྱེད་མེད་ཅིང་རང་རིག་ལ་སྒྲུབ་བྱེད་ཡོད་པ་དེས་ན།",
    "གཟུང་རྣམ་དེའི་བསྒྲུབ་པར་བྱ་བ་ཡང་རང་རིག་པ་དེ་ཉིད་ཡིན་ཏེ།",
    "གཟུང་རྣམ་གཞལ་བྱ་དང་འཛིན་རྣམ་འཇལ་བྱེད་དང་རང་རིག་འབྲས་བུར་གནས་པ་འདི་གསུམ་པོ་བློ་འཁྲུལ་བ་ལ་ཐ་དད་དུ་ཇི་ལྟར་རྗེས་སུ་སྣང་བ་བཞིན་དུ་བྱས་པའི་ཕྱིར་རོ།",
    "གཟུང་དོན་དང་ལྡན་པའི་རྟོག་མེད་ཀྱི་སེམས་ལ་ནི་གཟུང་དོན་གྱི་རྣམ་པ་ཤར་བ་མེད་པར་དོགས་ན་ཡང་འདས་པའི་དོན་ནི་འཛིན་པའི་དྲན་པ་ལ་རྣམ་པ་སྣང་བའི་རྟགས་ཀྱིས་ཚུལ་གཉིས་པ་དང་རང་རིག་པར་ཡང་གྲུབ་པ་ཡིན་ནོ།",
    "གཞན་ཡང་རང་ངོར་རང་བློ་ནི་རྟགས་ལས་རྟོགས་པར་འགྱུར་ཏེ།",
    "དོན་ལས་ཇི་ལྟར་ཡང་རང་བློ་དེ་སྒྲུབ་ནུས་པ་མ་ཡིན་ཏེ།",
    "ཚུལ་གཉིས་པ་དང་རང་རིག་པར།",
    "ཐོག་མའི་གནས་སྐབས་སུ་ད་ང་ཧ་ཅང་སྐྱིད་པོ་འདུག་ད་ལྟ་ང་ལ་མིང་ཡག་པོ་ཞིག་དང་།",
    "དེ་ནས་དངོས་གཞི་སྦྱོར་བ་རྩོམ་པའི་སྐབས་སུའང་རང་ཉིད་ཀྱི་ནུས་ཤུགས་དང་འབད་རྩོལ་གང་ཡོད་བཏོན་ནས་འགྲུབ་དགོས།",
    "ད་དུང་རང་བཞིན་གྱིས་སམ་བདེན་པར་གྲུབ་པར་ཡོད་སྙམ་སྲིད།",
    "ང་རང་ལ་ཉམས་མྱོང་ཅུང་ཟད་ཡོད་པ་དེའི་ཐོག་ནས་ཞུས་ན།",
    "ཞེད་སྣང་ཇེ་ཉུང་དང་རང་ཉིད་ཀྱི་ཆོད་སེམས་བརྟན་དུ་གཏོང་།",
    "གཞན་ཕྱོགས་ནས་ད་དུང་མི་མཛའ་བའི་རྣམ་འགྱུར་སྟོན་གྱི་འདུག་ན།",
    "མི་གསར་པ་ཞིག་ག་དུས་ཐུག་ཀྱང་དེ་ལ་ངོ་སྤྲོད་དམིགས་བསལ་བྱེད་མི་དགོས་པར།",
    "གློ་རྒྱག་པ་གོ་བའི་ཚེ་དགའ་སྣང་བྱེད་ཀྱི་འདུག་ཞབས་ཕྱི་དེའི་ངོས་ནས་ནེ་ཙོ་ཆུང་ཆུང་དེ་ལ་མཛའསེམས་དམིགས་བསལ་ཞིག་དང་།",
    "ཐབས་ཤེས་འདི་ཚོ་དང་ལྟ་ཚུལ་རྒྱ་ཆེ་རུ་གཏོང་བ་འདིས་དཀའ་ངལ་ལ་གདོང་ལེན་བྱེད་པའི་སྐབས་ག་དུས་ཀྱང་འགལ་རྐྱེན་ཇེ་ཉུང་དུ་གཏོང་ཐུབ།",
    "དེ་ནི་ལུས་ཀྱི་འདུག་སྟངས་ཡིན།",
    "རྒྱུ་ཡང་རྣམ་རྟོག་ཁོ་རང་ཡིན།",
    "ལམ་དང་འབྲས་བུ་ཁོ་རང་སྟེ།",
    "རྣམ་རྟོག་ཁོ་རང་ཡིན་པའི་ཕྱིར།",
    "ཉིན་མཚན་ཐུན་མཚམས་འགྲོ་འདུག་སོགས།",
    "རྗེས་སུ་མ་དཔེ་འདི་ལག་སོན་དུ་བྱུང་སྐབས་ཀམ་པུ་ཊར་ནང་བཙུད་ཟིན་པའི་གཞུང་འདིའི་བཀོད་སྒྲིག་ཅུང་རིམ་ཆགས་སུ་མི་གནས་པར་འདུག་པས།",
    "སད་ཙ་ན་ནག་ཐིབ་ཀྱིས་འགྲོ་བ་དང་།",
    "ཡང་ཟླ་བ་གཅིག་ཤར་འདུག་སྙམ་པ་དཀར་ལམ་མེ་བ་དང་།",
    "ཡང་ཟླ་བ་ཤར་འདུག་པ་ལ་དཀར་ཞིང་དྭངས་པ་དང་།",
    "ཡང་མེ་ལྕེ་ལྷབ་ལྷབ་འབར་གྱིན་འདུག་སྙམ་པ་ལྟ་བུ་དང་།",
    "ཤེལ་གྱི་རི་རྩར་འདུག་སྙམ་པ་དང་།",
    "ད་ནི་སེམས་འདི་ཡང་ནམ་མཁའ་ལྟར་མཐའ་ཡས་འགྲོ་བར་འདུག་སྙམ་ནས་སྔངས་སྐྲག་ཆེན་པོ་འབྱུང་ངོ།",
    "འོད་གསལ་ཕྱག་རྒྱ་ཆེན་པོ་ནི་གསལ་ལ་འཛིན་པ་མེད་པ་འདི་འདི་ཁོ་ནར་འདུག་སྙམ་པ་དང་།",
    "དེ་བཞིན་བདེ་ལ་ཞེན་པ་མེད་པ་འདི་ཁོ་ནར་འདུག་སྙམ་པ་དང་།",
    "མི་རྟོག་པ་གསལ་བར་འཆགས་འདུག་སྙམ་པ་འབྱུང་ངོ།",
    "སེམས་ཀྱི་རྗེས་འཇུག་དུས་དང་ནི།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་བྱུང་གཉིས།",
    "དམའ་བར་འདུག་སྨྲས་བཟླས་པ་ཡིས།",
    "བགྲོད་མིན་འགྲོ་བ་འདོད་པ་ཡིས།",
    "བསམ་གཏན་སྤེལ་ན་འོག་མིན་འགྲོ།",
    "དག་དང་རང་ལས་དེ་ལས་གཉིས།",
    "དཔང་གྱུར་སྐྱེ་བོ་ཕལ་ཆེར་དེ་ཉིད་མ་མཐོང་རང་དགར་གྱུར་པ་ཡི།",
    "རང་བྱུང་རང་བྱུང་བསྟན་པ་གཅེས་འཛིན་རྣམསབསྟན་པ་འདི་དཀྲུགས་སོ།",
    "བོར་ནས་དེ་ཚེ་འདུག་པ་ནི།",
    "མངལ་དང་སྒོ་ང་ན་འདུག་པ་རྣམས་ནི་གཞན་གྱིས་གསོད་པ་ཁོ་ནར་འགྱུར་བ་ཡིན་ནོ།",
    "ཡང་རྒྱུ་འདི་དག་ལས་རྒྱུ་གང་ཞིག་དུས་གང་དུ་འབྲས་བུ་འཛིན་ཏམ་འབྱིན་ཅེ་ན།",
    "བྱས་མ་ཐག་ཏུ་ཡིན་གྱི་དུས་གཞན་གྱི་བར་དུ་གསོན་པོར་འདུག་ནས་ཀྱང་མ་ཡིན་ནོ།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་བྱུང་གཉིས།",
    "༡༥༥བུའི་ཚལ་ན་འདུག་པའི་སོ་སོའི་སྐྱེ་བོ་གཅིག་ལ་བྱིན་ན་སྦྱིན་པ་དེ་བས་སྦྱིན་པ་འདི་འབྲས་བུ་ཆེས་ཆེའོ་ཞེས་གསུངས་པ།",
    "འཛམ་བུའི་ཚལ་ན་འདུག་པའི་སོ་སོའི་སྐྱེ་བོ་ཞེས་བྱ་བ་ནི་གང་ཞེ་ན།",
    "མཁས་རྣམས་དྲི་ནི་རྫི་ཕྱོགས་མིན་འགྲོ་སྟེ།",
    "གང་ཡང་ཆགས་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འདུག་པ་དང་།",
    "དེའི་ཚེ་འཇིག་རྟེན་འདི་ཞིག་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འདུག་པ་གང་ཡིན་པ་དེ་ལས་ནི་ངེས་པར་བྱུང་བ་ཞེས་བརྗོད་པར་བྱ་ལ།",
    "ཆགས་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འདུག་པར་འགྱུར་བ་གང་ཡིན་པ་དེ་ནི་ཉེ་བར་འོངས་པ་ཡིན་ནོ།",
    "ཉི་ཤུར་ཞིག་ནས་འདུག་གོ།",
    "མུ་གེ་དག་དུས་ཇི་སྲིད་དུ་འདུ་ཞེ་ན།",
    "ནམ་ཞིག་དུས་ཇི་སྲིད་ཅིག་ཏུ་འགྱུར་ཞེ་ན།",
