    "ཉེ་བར་བླངས་པ་སྟོང་པ་སྟེ་རང་བཞིན་མེད་ཅིང་ཉེ་བར་ལེན་པ་པོ་སྟོང་ཞིང་རང་བཞིན་དང་བྲལ་བ་ཡིན་ནོ།",
    "སྣོད་ཀྱི་འཇིག་རྟེན་ཡང་རང་བཞིན་མེད་པ་ཡིན་ནོ་ཞེས་བགྲེ་བའི་ཕྱིར།",
    "དེ་དག་ཀྱང་རང་བཞིན་ལས་ནི་ཡོད་མིན་ན་སྟེ།",
    "མི་གཙང་རང་བཞིན་ཤེས་བཞིན་དུ།",
    "ཇི་ལྟར་རང་བཞིན་དང་བྲལ་ཞིང་རང་བཞིན་གྱིས་མ་སྐྱེས་པའི་སྟོང་པ་ལ་མི་རྟག་པ་ཉིད་མེད་པ་དེ་བཞིན་དུ་སྡུག་བསྔལ་བ་ཡང་མེད་ཅིང་མི་གཙང་བ་ཡང་མེད་ལ་བདག་མེད་པ་ཡང་ཡོད་པ་མ་ཡིན་ནོ།",
    "ལག་འཐིལ་ཛེེསྤུ་ཉག་གཅིག་འདུག་པ།",
    "གང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་དེ་ནི་སྟོང་པ་ཉིད་ཡིན་ཏེ།",
    "གང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་དེ་ནི་སྟོང་པ་ཉིད་ཡིན་ཞིང་།",
    "མི་རྟག་པ་དེ་ཡང་རང་བཞིན་ཉིད་ལ་སྟེ།",
    "དེའི་ཚེ་ལམ་ཡང་རང་བཞིན་དང་བཅས་པ་ཉིད་ཡིན་པའི་ཕྱིར་མ་བསྒོམས་པ་ཉིད་དུ་དེ་ཡོད་པས།",
    "གཞན་ཡང་རང་བཞིན་དུ་སྨྲ་བ་ཁས་ལེན་ན།",
    "ལྟོས་ཤིག་འདུག་ཤིག།",
    "གལ་ཏེ་དངོས་པོ་རྣམས་སྟོང་པ་ཉིད་མ་ཡིན་ཞིང་རང་བཞིན་དང་བཅས་པ་ཉིད་དུ་གྱུར་ན།",
    "འགའ་ཡང་ལུང་སྟོན་མི་གསུང་འགྱུར་མེད་པར་། རང་རང་དངོས་ལ་ཐེར་ཟུག་གནས་དེ་ལ།",
    "ལྷག་པར་ཞེན་ནས་འདུག་པ་ལས་བདག་སྡུག་པའི་ངོ་བོ་དང་།",
    "༤༡༣པེ་སྣར་ཞིག་པེ་སྣར་ཚོལ་ཅིག་ལྷོག་ཅིག་འདུག་ཅིག་པེ་སྣར་པར།",
    "༤༥༤པེ་སྣར་འདུག་པེ་སྣར་ལྷག་པར་ཞེན་པ་དང་།",
    "ཞེས་ཀྱང་གསུངས་འདུག་གོ།",
    "དོན་མ་གོ་བ་འདུག་པའི་སྐྱོན་ཡིན་པས་སོ།",
    "འ་ཡིག་དུས་གསུམ་ལས་ད་ལྟ་དང་མ་འོངས་པར་འཇུག་ཀྱང་།",
    "བདག་ལ་མི་འདུག།",
    "འདི་ཧ་ཅང་མཛེས་པོ་འདུག་ལྟ་བུའོ།",
    "ལྐོག་གྱུར་དང་རིང་བ་ལ་མི་འཇུག་དུས་བརྗོད།",
    "ལྔ་གཅིག་དུས་ཆེན་ཞེས་པ་ལྟ་བུའོ།",
    "རང་རང་བཞེད་དོན་ཟས་ལ་སྤྱོད་པ་ཡི།",
    "དེ་ཅིའི་ཕྱིར་ཞེ་ན་བྱང་སེམས་དང་དེའི་མིང་རང་བཞིན་གྱིས་སྟོང་པའི་ཕྱིར་རོ།",
    "རྐྱེན་གྱིས་ཡང་དག་པར་བླངས་པ་དང་རང་བཞིན་དུ་གནས་པའོ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་དུ་རིགས་ངེས་པ་ཡང་མེད་དེ།",
    "གནས་སྐབས་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་རིགས་ཡིན་པས།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་རིགས་ཡིན་པའི་གོ་ཆོད་ཀྱང་གནས་སྐབས་ཉན་ཐོས་དང་རང་རྒྱལ་དུ་རིགས་ངེས་པས་དེ་དང་དེར་རིགས་ངེས་པར་ནི་འཇོག་མི་ནུས་ཏེ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་རིགས་ཡིན་པ་ཙམ་ནི་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་སྒྲུབ་པའི་རྟེན་གཞི་བྱེད་པའི་ཆ་ནས་འཇོག་པ་ཡིན་ཅིང་།",
    "སྤྱིར་བསྟེན་ཞེས་གསུངས་ཏེ་དབྱིངས་ཀྱི་དོན་དུ་འདུག་གོ།",
    "ཁྱེད་རང་ལ་ཡང་མཚུངས་སོ་སྙམ་ན་མི་མཚུངས་ཏེ།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "དེའི་ལན་དུ་མཚན་བཏགས་ཀྱི་ཁྱད་པར་ཡོད་པ་བཀོད་པ་སོགས་འཕགས་པའི་ཡུལ་ན་ཡང་བར་སྐབས་སུ་བྱུང་འདུག་པ་ནི་དོན་མེད་དེ།",
    "ཉན་ཐོས་དང་རང་རྒྱལ་གྱིས་དེ་ལྟར་ཞེན་པ་མེད།",
    "ནམ་མཁར་གནས་པའི་ཟླ་བ་དམར་པོ་ཟླུམ་པོ་ལྟར་ཉེ་བར་གནས་པ་དང་འདུག་པ་ལྟར་མི་གཡོ་བ་དང་།",
    "བསྟན་བཅོས་འདིར་དངོས་སུ་ཉན་རང་རང་རྒྱུད་པའི་ལམ་ཁོ་ན་བསྟན་གྱི་ལམ་ཤེས་མ་བསྟན་ཞེ་ན།",
    "ཞེས་དག་ལྡན་དང་རང་ཀིར་ཏེ་སློབ་དཔོན་སོགས་ཡང་ངོ།",
    "དེར་ཡང་རང་དོན་འགྲུབ་ཀྱི་དེ་མི་འགོག་སྟེ་གཞན་དོན་དང་མི་འགལ་བས་དེ་རྫོགས་པ་ཡིན་ནོ།",
    "འོན་ཀྱང་ཤློ་ཀ་འདིས་རང་ཀིར་ཡང་རང་བཞིན་རྣམ་དག་དང་།",
    "རྟོག་ངག་ལས་མཐའ་འཚོ་བ་རྣམས་འཕགས་ལམ་མཉམ་བཞག་དུས་ན་དངོས་སུ་མེད་ཀྱང་།",
    "རྒྱལ་པོ་བཏང་སྙོམས་འདུག་ཅིང་བློན་པོ་ཀུན་བྱེད་ལྟར་སྡུད་པར་ཞེས་སོགས་བློན་པོའི་དཔེས།",
    "ཤེར་པ་འདི་ནི་བྲི་བའམ་འཕེལ་བར་ཡང་མི་གདའ་འོ།",
    "ཨཱརྻ་ཤཱནྟིས་དྲངས་ད་ལྟའི་རྒྱས་འབྲིང་ན་ཆད་གདའ།",
    "ཞེས་གནོད་འཇོམས་གཉིས་དང་རང་ཀིར་ཞི་འབྱུང་དགོངས་པའོ།",
    "མཚོན་དང་དབྱིག་པ་སོགས་ཀྱི་རྐྱེན་གྱིས་ཤི་བ་ནི་ཉེ་བར་བཅོམ་པས་འཆི་བས་སོ་བློ་གྲོས་མི་ཟད་པའི་འགྲེལ་པར་དབྱིག་དུས་དུས་མིན་འཆི་གཉིས་སོ་རྒ་ཤི་གཉིས་ཡན་ལག་གཅིག་ཏུ་བྱས་པ་ནི་རྒ་བ་མེད་པར་འཆི་བ་སྲིད་པས་སོ།",
    "སྤྱིའི་འཇུག་ལུགས་དང་བསྟུན་ན་བློ་ངོར་མི་འཚམ་ཞིང་འཇུག་དཀའ་བ་ཞིག་སྟེ་མི་ཐོད་རྒལ་བ་གཅིག་འདུག་ཟེར་བ་བཞིན་ནོ།",
    "ཀུན་མཁྱེན་གསུམ་གྱི་བདག་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་རང་རང་དང་ཡུལ་ཡུལ་ཅན་དུ་འབྲེལ་བའི་སྒྲིབ་པ་སྟེ་ཀུན་རྨོངས་རྣམ་པ་གསུམ་སྟེ།",
    "དོན་དམ་པར་དངོས་མེད་ཀྱི་ཁོ་རང་མི་རྟོགས་དངོས་པོས་ཁོ་མི་ཨཱརྻ་རྟོགས།",
    "དོན་དམ་པར་དངོས་པོས་ཁོ་རང་མི་རྟོགས་དངོས་མེད་ཀྱིས་ཀྱང་ཁོ་མི་རྟོགས་པས་ཐུབ་པའི་རྟོགས་པ་མེད་པར་མི་འགྱུར་ཏེ།",
    "ཡང་འོ་མ་བསྐོལ་བ་ཕོག་པའི་རླངས་པ་འཐུལ་བ་ལྟ་བུ་དང་འདུག་པ་བཞིན་མི་གཡོ་བའོ།",
    "ཉན་རང་རང་དོན་དུ་བསྒོམ་ཞིང་རང་ལ་གྲུབ་བོ།་",
    "བདག་རྐྱེན་བསམ་གཏན་བཞི་པའི་དངོས་གཞི་ལ་བརྟེན་ནས་ནང་རང་ལ་གཟུགས་ཅན་དུ་འདུ་ཤེས་པས་ཕྱི་རོལ་གྱི་གཟུགས་ཆུང་ངུ་ཁ་དོག་བཟང་ངན་རྣམས་ལ་བལྟ་ཞིང་གཟུགས་དེ་དག་ཟིལ་གྱིས་མནན་ནས་ཤེས་ཟིལ་གྱིས་མནན་ནས་མཐོང་བའི་ཟིལ་གནོན་ནི་ཟིལ་གནོན་དང་པོའོ།",
    "འདུག་གནས་སོགས་ལྷག་པར་སོགས།",
    "མང་ཆེ་བ་ཞིག་ཁོང་ཉིད་ནས་འགྲོ་དོན་ཆུང་བར་དགོངས་ཏེ་སྲེག་ཟའི་ཞལ་དུ་ཕུལ་འདུག་ད་ལྟ་འཚོལ་བསྡུ་ཐུབ་པ་རྣམས་ཕྱོགས་གཅིག་ཏུ་བསྡུས་ཏེ་པར་བསྐྲུན་ཞུས་ཡོད།",
    "ཀུན་གྱིས་ང་ལ་ཞེ་ཁྲེལ་འཇོག་འདུག་དགོངས།",
    "མི་འདུག་སེར་པོ་ཧོར་ལ་འགྲོ།",
    "དགྲ་ལྷ་མི་འདུག་སྐུ་རྗེས་འགྲོ།",
    "སེང་ཆེན་མི་འདུག་འགྲོ་ངེས་ཡིན།",
    "ཁོ་རང་གཉིས་དེར་བབས་ཏེ་གཟིམ་གུར་ཕུབ་ཐབ་བསྒྲིག་འབྲོང་ལྕི་སོགས་བཏུས་ཏེ་མེ་བུས་ཆུ་བླངས་ཇ་བསྐོལ་བཞུགས་གདན་བཏིང་།",
    "རྒྱལ་པོའི་ཞལ་ནས་དོ་ནུབ་འགྲོ་འདུག་མ་མང་ཉོལ་གསུངས།",
    "གལ་ལ་ཐུག་དུས་གཟིམ་ཁུགས་སམ།",
    "གླིང་རུ་འདུག་སོས་མི་བསོད་དུ།",
    "འདི་ནས་ཕར་ཙམ་བྱོན་པས་ན།",
    "དམག་གྲངས་ག་འབུམ་ཚོ་བཅུ་གཉིས་གདའ།",
    "དཔའ་ངར་གྲུས་མའི་སྟག་འདྲ་གདའ།",
    "ཧར་རྒོད་དམ་སྨྱོན་འདྲ་ལེ་གདའ།",
    "ཁྱེད་དཔའ་ཐུལ་དེ་ཙམ་ཤོར་ནས་འདུག།",
    "མ་འདུག་བདེ་ཆེན་ཞིང་ལ་བྱོན།",
    "དེ་ནས་ཕར་བྱོན་པས་ཧོར་གྱི་ས་སྲུང་ཐོག་བཙན་དེས་གླ་རྙི་ཞིག་བཟོ་ཞིང་འདུག་པས།",
    "ཟེར་ནས་དོན་དུ་མི་འདི་གཟུགས་མཛེས་ལ་བྱིན་ཆགས་པ་ཞིག་གདའ་བས་ཤུ་ལྷ་ཐེའུ་རིང་ལས་ལྷག་པ་མེད་སྟབས་ངེད་གསུམ་རྒྱལ་འོང་།",
    "ང་རང་བློན་པོ་བྱིང་སྔོན་གྱིས།",
    "ཧོར་རྗེའི་གོ་ན་འདུག་མི་བདེ།",
    "ད་ནང་ཆུ་ལ་ཕུད་རོགས་ཟེར་འདུག་པས།",
    "དེ་བས་ཁོ་རང་ཕྱིར་མངག་ཟེར་བ་དང་།",
    "འདུག་བཟོད་ཡོད་ན་སྡོད།",
    "ཞེ་སྡང་རང་གཟུགས་ཧོར་བློན་ལ།",
