    "དམིགས་བསལ་ལམ་སྟོན་གསར་པ་བྱེད་དགོས་དོན་གང་ཡང་མི་འདུག་བྱས་དང་མ་བྱས་ཀྱི་གནས་ཚུལ་ཐ་དད་ཡིན་པ་ལས།",
    "དེ་གལ་ཆེན་པོ་འདུག་ཆ་",
    "དེ་རིང་འདིར་ཁ་ཆེའི་ཕྲུ་གུ་ཁྱེད་རང་གཉིས་ལ་དགའ་བསུ་ཡོད།",
    "ཁྲ་ཁྲ་ཟིང་ཟིང་བཟོ་རྒྱུ་འདིར་དགོས་པ་ཆེ་བ་མི་འདུག་དེ་ལས་ལྟོ་ཞིམ་ཙམ་ཟས།",
    "གངས་ཅན་སྐྱིད་གཤོངས་ལའང་རྒྱས་སྤྲོས་ཆེ་དྲགས་འདུག་ཟེར་མཁན་ཁ་ཤས་བྱུང་།",
    "སྤྱི་པའི་དོན་དག་ལ་ཚང་མས་གང་དྲག་ཅི་དྲག་སྙམ་པའི་སེམས་ཁུར་གང་ཡང་མེད་པ་ལྟ་བུ་འདུག་ཅེས་བརྗོད་མཁན་གཅིག་གཉིས་བྱུང་།",
    "ངས་དེ་ལ་དོ་སྣང་བྱེད་དགོས་ཀྱི་འདུག་བསམ་བྱུང་།",
    "གནས་ཚུལ་གསལ་པོ་རྟོགས་པ་བྱེད་རྒྱུ་གལ་ཆེན་པོ་འདུག་ངས་ཕྱིའི་སྒྲོམ་ལྟ་བུའི་འགོ་ཁྲིད་བྱེད་རྒྱུ་ལས།",
    "༤ ཙམ་བསྡད་ནས་ཁྱེད་ཚོས་གོ་བསྡུར་བྱེད་སྟངས་མཐོང་ན་ཡག་པོ་འདུག་པས་ངས་འཁྱུག་ཙམ་བསྡད་ན་བསམ་པ་བྱུང་།",
    "སྤྱི་འཐུས་ཀྱི་དམ་འབུལ་བྱེད་སྐབས་ག་དུས་ཡིན་ན་ཡང་།",
    "བཀའ་ཤག་དང་སྤྱི་འཐུས་ཚང་མས་དུས་ཐོག་དུས་ཐོག་སྐུལ་ལྕག་བྱ་རྒྱུ་དང་།",
    "ཡང་ན་དེ་མིན་ཐབས་ཤེས་གསར་པ་གང་ཞིག་བྱེད་རྒྱུ་འདུག་གམ།",
    "གོ་བསྡུར་བྱེད་དགོས་ཀྱི་འདུག་ང་",
    "དེ་སྐོར་ཐབས་ཤེས་བྱ་རྒྱུ་གང་འདུག་གམ།",
    "ང་རང་ཡང་བློ་དོགས་སྐྱེ་དགོས་པ་བྱུང་།",
    "རིམ་པས་གོ་བསྡུར་བྱས་ནས་བསྒྱུར་བཅོས་གཏོང་དགོས་གང་འདུག་དེ་ཚོའི་སྐོར་ལ་དགོངས་པ་བཞེས་ན་བསམ་གྱི་འདུག་སྤྱི་ཡོངས་ཀྱི་སྐོར་གནས་སྟངས་ཞུ་རྒྱུ་གཅིག་དེ་ཡིན།",
    "ད་ཆ་དུས་ཚོད་ལམ་སེང་ཐག་བཅད་ནས་བརྗོད་ཐུབ་པ་མི་འདུག་ཀྱང་།",
    "སེམས་ཁུར་གྱི་ཐོག་ནས་བྱེད་ཕྱོགས་གང་འདྲ་འདུག་གམ།",
    "ཧ་ལམ་བརྒྱ་ཆ་དགུ་བཅུ་གོ་དགུའི་བསམ་ཚུལ་གཅིག་གྱུར་ཡོད་པ་གསལ་པོ་འདུག་པ་ཧ་ཅང་དགའ་པོ་བྱུང་།",
    "དེས་ནུས་པ་ཐོན་པ་ཞིག་བྱེད་རྒྱུ་གལ་ཆེན་པོ་འདུག་ཐུགས་རྗེ་ཆེ།",
    "དེ་རིང་དམིགས་བསལ་ཞུ་རྒྱུ་རྒྱ་ཆེན་པོ་གང་ཡང་མི་འདུག་རྒྱ་ནག་དང་འབྲེལ་བ་བྱེད་ཕྱོགས་སྐོར་ནི།",
    "ད་དུང་ཐབས་ཤེས་གསར་པ་བྱེད་དགོས་པ་གང་ཞིག་འདུག་གམ།",
    "ངའི་མི་ཚེ་དོན་དང་ལྡན་པ་ཞིག་ཆགས་ཀྱི་འདུག་བསམ་གྱི་ཡོད།",
    "དུད་འགྲོ་ཡིན་ནའང་ཡིད་ཆེས་བྱེད་ཀྱི་མི་འདུག་ན།",
    "ང་རང་བཅོམ་ལྡན་འདས་ཀྱི་རྗེས་སུ་འབྲངས་ནས་ཇི་ཙམ་ཐབས་སྡུག་ཀྱང་སྟོན་པ་བཀའ་དྲིན་ཅན་དེའི་ཞབས་མ་འདྲེན་མཁན་ཞིག་བྱེད་བསམ་པ་རྨི་ལམ་ཚུན་ཆད་ལའང་དྲན་གྱི་ཡོད།",
    "མི་ཚོས་ཀྱང་དོ་སྣང་ཆེན་པོ་བྱེད་ཀྱི་འདུག་པར་བརྟེན།",
    "གྲུབ་འབྲས་ཐོན་པ་ཞིག་བྱ་རྒྱུ་འདི་རྩ་བ་བཙན་བྱོལ་བ་སྤྱིའི་གོང་བུའི་ནུས་པའི་ཐོག་ནས་བྱེད་དགོས་ཀྱི་འདུག་དེ་རིང་འདིར་མི་མང་ཚང་མ་འཛོམས་མེད་ཀྱང་།",
    "ད་དུང་མུ་མཐུད་ཚང་མས་ནུས་པ་བཏོན་ནས་ཤུགས་རྒྱག་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་འདུག་ཅ་",
    "དངོས་གནས་ནོར་ཡོད་ན་ནོར་འདུག་ཅེས་བརྗོད་རྒྱུ་ལས།",
    "ད་ལྟ་ཨུ་རུ་སུའི་ནང་གནས་ཚུལ་ཅི་འདྲ་ཆགས་འདུག་གམ།",
    "རྒྱ་ནག་ལ་ཆ་བཞག་ནའང་གནས་ཚུལ་གང་འདྲ་ཆགས་ཀྱི་འདུག་གམ།",
    "ད་དུང་ཚང་མས་ཤུགས་རྒྱག་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་འདུག་ག་",
    "དེ་ཚོར་དགོས་པ་མི་འདུག་སྤྱི་པའི་སྒྲིག་འཛུགས་སྲ་བརྟན་ཡོང་རྒྱུའི་འགན་ཚང་མར་འཁྲི་ཡོད།",
    "གདོན་གཅིག་ཟིན་གྱི་ན་ཚ་ཟེར་བ་ལྟར་ཚང་མས་ཁུར་མཉམ་ལེན་བྱེད་རྒྱུ་གལ་ཆེན་པོ་འདུག་ཕར་ཁག་ཚུར་དཀྲི་དང་།",
    "ང་རང་སྒེར་ངོས་ནས་ཆ་བཞག་ན།",
    "དེ་ཡང་རང་རྒྱལ་གཞན་ཕམ་གྱི་བསམ་བློའི་ཐོག་ནས་མ་ཡིན་པར་བོད་པ་བདེ་བ་ཞིག་དང་།",
    "སྤྱིར་བཏང་རྒྱ་མི་བློ་གཟུ་བོར་གནས་པ་ཞིག་ཡིན་ནའང་རང་བཞིན་གྱིས་རིགས་ཞེན་དང་།",
    "སོ་སོ་རྒྱུན་གྱི་འཚོ་བ་སྐྱེལ་བའི་ནང་ལ་ཡང་བྱམས་བརྩེའི་ཚོར་བ་ཡོད་པ་ཞིག་དགོས་རྒྱུ་གལ་ཆེན་པོ་འདུག་བྱམས་བརྩེའི་ཚོར་བ་ཡོད་ན་གཞན་ལ་བརྩི་བཀུར་ཡོད་པ་དང་།",
    "མི་གཞན་གྱིས་ཀྱང་མི་འདིས་སྐད་ཆ་སྙན་པོ་ཤོད་ཤེས་ཀྱི་མི་འདུག་ཀྱང་།",
    "དེ་དག་རྒྱ་མིའི་འོག་བསྡད་ན་ཡོང་ཐུབ་ཀྱི་ཡོད་ན་ཁྱད་པར་གང་ཡང་མི་འདུག་ཀྱང་།",
    "དེ་ལུགས་ཚང་མའི་དགོངས་པར་བཅངས་རྒྱུ་གལ་ཆེན་པོ་འདུག་ང་",
    "ཐོག་མར་ཁྱེད་རང་ལེགས་སྐྱེས་ཀྱི་བྱ་དགའ་འཐོབ་མཁན་ཚང་མར་བཀྲ་ཤིས་བདེ་ལེགས་ཞུ་རྒྱུ་ཡིན།",
    "ནུས་པ་ཐོན་པ་ཞིག་ཡོང་བར་ཚང་མས་འབད་བརྩོན་བྱ་རྒྱུ་གལ་ཆེན་པོ་འདུག་དཔེར་ན།",
    "ལས་ཀའི་ཐོག་ཧུར་བརྩོན་མེད་པའི་བཟོ་ལྟ་མཐོང་བཞིན་དུ་བཟང་པོ་བྱས་ནའང་ཡག་པོ་འདུག་ངན་པ་བྱས་ནའང་ཡག་པོ་འདུག་ཅེས་འདྲ་ཆགས་པོ་དང་།",
    "དེ་ལྟར་གཞིས་བྱེས་མཉམ་འཛོམས་ཀྱི་དུས་ཚོད་མ་བྱུང་བར་དུ་གནས་སྐབས་སོ་སོའི་ལས་ཀྱིས་བསྐོས་པ་ལྟར་ངོས་ནས་འགར་ཁུར་མི་བྱ་ཐབས་མེད་ཡིན་སྟབས་ངོས་རང་ལམ་སང་དགོངས་པ་ཞུ་ཆོག་ཆོག་མི་འདུག་ཁྱེད་ཚོ་ཕྲན་བུ་མ་འགྲིགས་པ་བྱུང་ན་ལམ་སང་དགོངས་པ་ཞུས་ནས་སྐྱིད་པོ་ཡིན་བསམ་པ་དེ་འདྲའི་ཐོག་ནས་གང་བཟོ་བཟོ་དང་།",
    "ཁྱེད་རང་དོ་བདག་སོ་སོའི་ངོས་ནས་ཀྱང་ངལ་བར་མ་འཛེམས་པར་ཆེད་མངགས་ཡོང་བའི་དོན་གོ་ཆོད་པ་ཞིག་བྱ་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་ཡིན།",
    "ཁ་གསལ་ཟོལ་མེད་ཧ་ཅང་ཡག་པོ་འཁོད་འདུག་བསམ་ཏེ་ང་རང་དགའ་པོ་བྱུང་།",
    "དེ་སྐོར་ཞིབ་ཕྲ་ཞུ་དགོས་པ་མི་འདུག་ལོ་དེའི་སྟོན་མཚམས་སུ་ངས་བོད་ཀྱི་ཆབ་སྲིད་ཀྱི་འགན་ཁུར་བླངས་པ་ཡིན།",
    "རྒན་པ་བྱས་ཚར་ཡོད་དྲན་གྱི་མི་འདུག་ཀྱང་།",
    "ད་ཆ་བསམ་བློ་ཏན་ཏན་གཏོང་དགོས་པ་འདུག་སྙམ་པ་དྲན་བྱུང་།",
    "མི་དེས་བརྗོད་པར་ཁོ་རང་བོད་ལ་ཐེངས་གཉིས་བསྐྱོད་པ་ཡིན།",
    "ཐེངས་དང་པོའི་སྐབས་སུ་བོད་ལ་རྒྱ་མིས་ཡག་པོ་བྱས་འདུག་སྙམ་པ་དྲན་བྱུང་།",
    "འགྲིགས་མི་འདུག་ཅེས་ཤོད་མཁན་བྱུང་ཡོད།",
    "གནས་ཚུལ་ཁ་ཤས་ཐོས་སྐབས་ང་རང་ཡང་དེ་གར་སླེབས་ཐུབ་ན་སྙམ་པ་དྲན་བྱུང་།",
    "ག་དུས་ཡིན་ནའང་དེའི་ཕྱོགས་ནས་རྙོག་དྲ་ཡོང་བའི་གནས་ཚུལ་ཞིག་ཆགས་པ་དེ་དག་སེལ་ཐབས་བྱེད་དགོས་པ་ཞིག་ཡིན།",
    "གཉིས་ནས་དགེ་སློང་མའི་སྡོམ་རྒྱུད་སྐོར་ང་རང་སྒེར་གྱི་ངོས་ནས་དམིགས་བསལ་དོ་སྣང་ཡོད་ཅེས་བརྗོད་ཡོད།",
    "གཅིག་བྱས་ན་ཐའེ་ཝན་ལ་འགྲོ་ཐུབ་པའི་གནས་ཚུལ་ཞིག་མི་ཡོང་ངམ་བསམ་གྱི་འདུག་བོད་སོག་ལུས་ཁུངས་དང་རྩ་བ་ནས་འབྲེལ་བ་མེད་པར་ཐའེ་ཝན་ལ་འགྲོ་ཐུབ་པ་བྱུང་ན།",
    "ང་རང་ཡང་བློ་བདེ་པོ་བྱུང་།",
    "ང་རང་སྒེར་གྱི་སྔོན་བསགས་ཀྱི་ལས་ཡིན་ནའང་འདྲ།",
    "ཁ་ཤས་ཀྱིས་རང་བཙན་ཡོད་པའི་ལུང་པ་འགའ་ཞིག་ལས་བོད་པ་བཙན་བྱོལ་བའི་ལས་ཀ་ཚགས་ཚུད་པ་འདུག་ཅེས་ཤོད་མཁན་ཡོད།",
    "ང་རང་ཡང་སེམས་པ་སྐྱོ་པོ་བྱུང་།",
    "མ་མཐར་ཡང་དེབ་སྐྱེལ་བྱས་པའི་ཚོགས་པ་བརྟན་པོ་ཞིག་བཟོ་རྒྱུ་གལ་ཆེན་པོ་འདུག་ཅེས།",
    "སེམས་ཕྲན་བུ་སྐྱིད་པོ་ཡོང་བའི་ཐད་ངས་ཞབས་འདེགས་ཞུ་ཐུབ་རྒྱུར་ང་རང་ཡིད་ཆེས་ཡོད་ལ།",
    "དེ་རིང་འདིར་དམིགས་བསལ་གསར་པ་ཞུ་རྒྱུ་གང་ཡང་མི་འདུག་ད་ལམ་གྲོས་ཚོགས་ནང་སྤྱི་འཐུས་གཅིག་ཙམ་མ་གཏོགས་ཚང་འཛོམས་བྱུང་འདུག་པར་ཧ་ཅང་དགའ་པོ་བྱུང་།",
    "དེ་རིང་བསྐྱར་ཟློས་བྱས་ནས་ཞུ་དགོས་པ་མི་འདུག་ཀྱང་།",
    "གཞན་ང་ལ་དམིགས་བསལ་ཞུ་རྒྱུ་གང་ཡང་མི་འདུག་ཚང་མས་ཧུར་ཐག་གནང་རོགས་གནང་།",
    "དེ་བཞིན་ང་རང་དངོས་སུ་ངོ་ཐུག་བྱུང་བ་བོད་ནས་ཚུར་ཡོང་མཁན།",
    "ང་རང་སྒེར་གྱི་ངོས་ནས་བཞག་ན།",
    "གཉིས་ཀར་ཁེ་ཕན་འདུག་བསམ་པ་དྲན་གྱི་འདུག་དཔེར་ན།",
    "རྒྱབ་མདུན་ངོ་ལྐོག་བྱས་འདུག་ཅེས་པའི་ལབ་གླེང་མེད་པ་ལྟར།",
    "ཁ་སང་ཨོ་རི་སར་སླེབས་པའི་སྐབས་སུའང་དེ་དག་རྒྱུས་ཡོད་ཡག་པོ་བྱུང་འདུག་པར་དགའ་པོ་བྱུང་།",
    "ད་ལྟའི་ཡུལ་དུས་དང་མཐུན་པའི་བྱེད་སྒོར་བློ་རིག་གོ་བསྡུར་བྱེད་རྒྱུ་ཕྲན་བུ་མ་འདང་བ་མིན་ནམ་དྲན་གྱི་འདུག་དཔེར་ན།",
    "འཇིགས་སྣང་བག་ཟོན་བྱེད་དགོས་པ་རྩ་བ་ཉིད་ནས་མི་འདུག་དེ་ཚོའི་ཐོག་ལ་འགན་མང་ཙམ་བཞེས།",
    "གོ་བསྡུར་མང་ཙམ་བྱས་ཏེ་མ་འོངས་པའི་ཡོང་སྟངས་ཀྱི་ཐོག་ཀླད་པ་མང་ཙམ་དཀྲུག་དགོས་ཀྱི་འདུག་དེ་འདྲའི་ཐོག་མ་འདང་བའི་སྐྱོན་ཞིག་མེད་དམ་སྙམ་པ་མཐོང་བྱུང་།",
    "བློ་རོགས་གྲོས་རོགས་ལྟ་བུ་བྱས་ནས་གང་དགའ་ཅི་ལེགས་གོ་བསྡུར་བྱེད་དགོས་ཀྱི་འདུག་ཆ་",
    "སྤྱི་ཡོངས་ཀྱི་མིའི་སྤུས་ཀ་གང་འདྲ་ཞིག་ཆགས་ཀྱི་འདུག་གམ།",
    "རྗེས་སུ་དཀའ་ངལ་འཕྲད་མི་ཡོང་ངམ་དྲན་གྱི་འདུག་ཅི་སྟེ་དཀའ་ངལ་འཕྲད་ཚེ།",
    "འཐུས་ཤོར་ཡོང་མིན་ཐོག་ཉམས་ཞིབ་གནང་དགོས་ཀྱི་འདུག་གནས་ཚུལ་དེའི་ཐོག་ལ་གྲོས་ཚོགས་འཚོགས་པའི་སྐབས་ཙམ་མིན་པར་དུས་རྒྱུན་གཏན་ནས་བསམ་བློ་གཏོང་དགོས།",
    "དེའི་རྗེས་མ་རྣམས་དེ་བས་ཀྱང་སྐྱོ་བ་ཆགས་རྒྱུའི་ཉེན་ཁ་ཏན་ཏན་འདུག་དེར་བརྟེན་ཚང་མས་ཧུར་ཐག་གནང་རོགས་གནང་ཞེས་ནན་ཏན་གྱིས་ཞུ་རྒྱུ་ཡིན།",
    "བུམ་སྤྱི་མ་ཡིན་པ་ཁོ་རང་བུམ་སྤྱི་མ་ཡིན་པ་ཡིན་ནམ་མིན།",
    "དེ་ཡང་བདག་མེད་ལས་ཆེ་སྙམ་པ་སོགས་བློ་ཇེ་གསལ་ལོག་ཤེས་ཇེ་ཆུང་ཇེ་མེད་དང་འགལ་བ་དེ་དག་རང་རང་ངོས་སྐལ་གྱི་འགལ་ཟླ་བརྒྱད་རིག་འགོག་ནུས་ཀྱི་ངང་ལས་ཆེ་བ་མིན་ནོ།",
    "རིགས་དྲུག་རིགས་དྲུག་རང་རང་ཡིན་པར་སྲིད།",
    "རྡོ་རིལ་མིན་པ་བུམ་སྤྱི་ཡིན་པ་འདུག་ན།",
    "སྒྲ་དོན་ཐམས་ཅད་རང་རང་མིན་པ་དེས་མི་གོ།",
    "ཐད་ཀའི་བྱེ་བྲག་རྣམས་ནི་ད་ལྟ་བ་ཡིན་པས་རྫས་ཐ་དད་དང་གོང་མའི་བྱེ་བྲག་དུས་ལ་ལྟོས་པས་ན་འདས་མ་འོངས་རྫ་ས་སུ་མེད་ལ་ད་ལྟ་དངོས་པོ་ཡོད་པས་གཅིག་པ༵་བཀག་ཚད་པའི་ཐ་དད་ཡིན་ནོ།",
    "དེ་ལ་དོན་རིག་དང་རང་རིག་གཉིས་ཡོད་དོ།",
    "དེ་ལ་དོན་གྱི་སྟེང་ན་གཅིག་དང་ཐ་དད་ཕན་ཚུན་འདྲེ་བ་མེད་ཀྱང་རང་མཚན་གཅིག་ཡིན་པ་དང་ཐ་དད་ཡིན་པ་ལ།",
    "གཉིས་པ་དེ་ལ་དབྱེ་ན་དགག་བྱ་ཤེས་བྱ་ལ་ཡོད་པ་གཅོད་པ་བུམ་མེད་སོགས་དྭང་རང་མཚན་ཤེས་བྱ་ལ་མེད་པ་ནི་རི་རྭ་རྟག་དངོས་སོགས་གཅོད་པ་ཡི་སྒོ་ནས་མེད་པའི་སེལ་བ་རྣམ་པ་གཉིས་ཡོད་དོ།",
    "དེ་ལ་ཤིང་དེ་བརྡ་བྱེད་ཅིང་དེ་བཞིན་དུ་ཡལ་ལོ་མི་ལྡན་པ་ཛི་ཏ་ཤྭཏྟཾགཞན་ལ་རིགས་ཐ་དད་པ་ཤིང་མིན་དུ་བརྡའ་བྱེད་པས་ན་དེ་ལྟ་བུའི་བརྡ་དེ་རྟོག་བཅས་ཀྱི་བློས་རིགས་མཐུན་རྣམས་ལ་གཅིག་ཏུ་ཞེན་ནས་སྦྱོར་བར་བྱེད་དེ་བརྡའ་དུས་སུ་ཡལ་ལོ་ཡོད་མེད་ཕྱེ་ནས་འཇུག་དུས་སུ་རྣམ་གཅོད་ལ་དངོས་སུ་མ་བརྟག་པར་དོན་ལ་འཇུག་པ་ཡིན་ནོ།",
    "འཛིན་ན་བུམ་སོགས་ཀྱི་བརྡའ་སྦྱར་བ་མེད་ཀྱང་རང་མཚན་མཐོང་ཙམ་གྱིས་འདི་ནི་བུམ་པའོ་ཨ་ཞེས་སོགས་རང་ཉིད་ཀྱིས་རྟོགས་པར་ཅིས་མི་འགྱུར།",
    "རང་མཚན་ལ་མ་སྦྱར་ན་སྤྱི་ལ་སྦྱར་ཡང་རང་མཚན་གོ་མི་ནུས་པས་ལམ་གང་ཡིན་སྡོང་དུམ་ལ་འདྲི་བ་ལྟར།",
    "གཉིས་ཀའང་རང་མཚན་ལས་ཐ་དད་པའི་ཕྱོགས་གཅིག་ཏུ་དགག་པ་ནི།",
    "གལ་ཏེ་ཁྱེད་ཀྱིས་སེལ་བའི་བདག་ཉིད་ཅན་གྱི་སྤྱི་ལ་བརྡའ་སྦྱོར་ན་སེལ་བ་དང་རང་མཚན་ཐ་དད་ཡིན་པས་ལྡན་པ་མིན་པ་ལ་བརྡའ་སྦྱར་བ་དང་མཚུངས་ཤེ་ན།",
    "ལེགས་པར་དཔྱད་ན་སྒྲ་ཡི་དངོས་ཀྱི་བརྗོད་བྱ་མེད་ལ་ཞེན་པའི་བརྗོད་བྱ་ནི་དོན་རང་ང་མཚན་ཡིན་ཅིང་སྒྲ་དོན་གྱི་འབྲེལ་བ་འཁྲུལ་པས་བྱས་ན་ཡང་མ་སྐོར་སོ་འཁྲུལ་ནས་འཇུག་པའི་སྐྱེས་བུ་བསླུ་བ་མེད་དེ་འཁྲུལ་བའི་ངོར་སྣང་བའང་རང་མཚན་གྱི་རྣམ་པ་དེ་ལས་འཆོལ་བར་མི་སྣང་བས་རྒྱང་རིང་པོའི་གཟུགས་མཐོང་བའི་ཤེལ་གྱི་ཁང་བུ་ནས་བལྟས་པ་བཞིན་ནོ།",
    "ཐོ་བ་སོགས་ཀྱིས་བུམ་པ་འཇིག་པར་བྱིད་ན་ཡང་འཇིག་པ་དེ་དངོས་མེད་ནི་ཅི་ཡང་མེད་ཙམ་ཡིན་པས་རྒྱུ་ལ་མི་ལྟོས་ལ་ལྟོས་ན་དངོས་པོར་འགྱུར་ཞིང་དངོས་པོ་ཡིན་ནའང་རང་གཞན་གཉིས་ལས་བུམ་པ་རང་ཡིན་ན་དེ་རྫ་མཁན་གྱིས་བྱས་ནས་རང་ཉིད་གྲུབ་ཟིན་པས་རྒྱུ་ཅི་དགོས།",
    "འགལ་བ་མཚན་ཉིད་པ་མིན་པར་བཏགས་པ་བ་ཡིན་ཏེ་དཀར་པོ་དང་འབྲེལ་བའི་སེར་པོའམ་རྟ་དང་འབྲེལ་བའི་བལང་ཞེས་ལྷན་ཅིག་འདུག་པ་ལ་འབྲེལ་པ༵་ཞེས་འདོགས་པ་བཞིན་ནོ།",
    "དེ་གསུམ་པོའང་རང་མཚན་གྱི་ཆ་ནས་མིན་ཏེ་གཞན་སེལ་བས་ཕྱེ་པའོ།",
    "རྣལ་འབྱོར་དང་རང་རིག་གཉིས་ལ་འཇུག་པ་འབའ་ཞིག།",
    "དབྱེ་ཚུལ་ཡང་ཡུལ་གཞན་མཐོང་དོན་རིག་གཉིས་རང་མཐོང་རང་རིག་གཉིས་ཀ་མཐོང་བ་རྣལ་མངོན་ཡིན་པ་དང་།",
    "ཁ་ཅིག་རྩོད་གཞིས་ཁྱད་པར་དུ་བྱས་པ་ལ་ཡི་དུ་བ་དང་སྒྲའི་བྱས་པ་ལྟ་བུ་དེ་དེ་ཁོ་རང་རྟགས་ཀྱི་མཚན་གཞིར་འདོད་དོ།",
    "ཞེ་འདོད་དང་ནི་སྨྲས་པ་གཉིས་པོ་གང་ཡིན་ཀྱང་རང་འདོད་པ་དེ་བསྒྲུབ་བྱ་ཡིན་པ་ཉིད་དུ་མཚུངས་པའི་ཕྱིར་གྲངས་ཅན་གྱིས་མིག་སོགས་གཞན་དོན་སྒྲུབ་པའི་ངག་བཀོད་པའི་འགལ་བ་སོགས་འགལ་བ་གསུམ་པ་འདིར་འགལ་རྟགས་ལོགས་སུ་མི་བཞེད་དོ།",
    "དེ་ལ་དབྱེ་ན་རིགས་སྒོར་ཁས་བླངས་དང་རང་ཚིག་གཉིས་སུ་འདུ་གསུངས་པ་དེ་གཉིས་ཀྱི་ཁྱད་པར་ལ་སྔ་རབས་པ་གཞན་དག་ཡིད་ཆེས་ཀྱི་ལུང་དང་འགལ་བ་དང་།",
    "རྒོལ་བའི་ཁ་ནས་སྨྲས་ཚད་ཀྱི་ངག་ཀུན་དང་པོར་བརྗོད་དགོས་ངེས་མེད་པས་དེ་མ་བརྗོད་པ་སྐྱོན་མིན་ལ་དགོས་ངེས་པ་སུན་འབྱིན་མ་བརྗོད་ན་ཕྱིར་རྒོལ་ཁོ་རང་སྤོབས་པ་མེད་པའི་ནང་དུ་འདུས་སོ།",
    "ལས་མཚམས་གྲོལ་ནས་ཕྱིར་ལོག་དུས།",
    "གལ་སྲིད་ང་རང་ཆུ་དྭངས་ནོར་བུ་ཞིག་ཡིན་རྒྱུ་ན་ལྗན་ལྗིན་དྲི་མ་ཐམས་ཅད་བགྲུང་བར་ནུས་ཀྱང་།",
    "ང་རང་ཀེ་ཏ་ཀ་ནི་མིན།",
    "དེ་དུས་ང་རང་བློ་ཅུང་ཟད་བདེ་བ་ཞིག་བྱུང་ན་ཡང་།",
    "ཕྱི་ཉིན་ང་རང་ཀུང་ཧྲེའི་ནང་དུ་འགྲོ་སྐབས།",
    "ཡིད་སྐྱོ་བའི་གནས་ཚུལ་དེ་བྱུང་ཚར་འདུག་ཨ་ཁ།",
    "ངོ་མ་ཕོ་གསར་ཁ་ཤས་ལ་ལ་རྒྱ་ཟེར་བ་དེ་གཏན་ནས་མི་འདུག་ལ་ལས་སྒོ་ཁྱིས་བདག་པོ་མཐོང་བ་ན་མགོ་སྒུར་ཞིང་རྔ་མ་གཡུག་པའི་ཚུལ་ལྟར་ཞུ་བ་བྱེད་པ་དང་།",
    "ཉུང་ཐར་ཡང་ཟླ་བ་གཅིག་ཙམ་ལ་ཚེ་རིང་དང་འཕྲད་པའི་གོ་སྐབས་མི་འདུག་ད་ཅི་བྱ་སྙམ་ཞིང་ཡོད་ཙ་ན།",
    "ཁོ་རང་དགའ་སྤྲོའི་ངང་ནས་ལོས་བྱེད་ལོས་བྱེད།",
    "ཞིང་ཚིགས་སུ་སྐྱེས་པའི་ཡུལ་སིལ་ཁམ་བུ་སྡོང་བོའི་མགོ་ལ་སིལ་ཏོག་སྐྱ་རྡོ་མ་སྨིན་པའི་སིལ་ཏོག་རྣམས་མདུད་ལོག་བརྒྱབ་ནས་ཐོགས་འདུག་མི་འགྱངས་པར་སྔོ་ཞིང་ལྗང་བའི་ལོ་ཏོག་རྣམས་ཀྱིས་གསེར་ལྟར་སེར་བའི་ཕྱི་གོས་གྱོན་ངེས་ཡིན་ལ།",
    "ང་རང་དོགས་མི་བདེ་བའི་སྣང་བ་ཅི་ཡང་མེད་པ་རིག་ནས།",
    "གཞན་དུ་ན་ཁོ་ལ་འཕྲུལ་སྣང་དེ་འདྲ་ཞིག་སྟེར་མཁན་ནི་ང་རང་ཉིད་ཀྱིས་ལན་པ་ཡིན་པས།",
