    "ཕྱི་རོལ་གྱི་དོན་ཡོད་ཀྱང་རང་རིག་པ་ཇི་ལྟ་བ་བཞིན་དོན་འགྲུབ་པའི་ཕྱིར་དེ་ཉིད་འབྲས་བུར་རིགས་སོ།",
    "དེའི་བདགཉིད་ཡིན་པའི་ཕྱིར་དེ་ལྟར་སྣང་བ་ན་ཡང་རང་དང་གཞན་གསལ་བར་བྱེད་པར་འགྱུར་ཏེ།",
    "དོན་གཞན་དང་རང་བཞིན་དག་རབ་ཏུ་སྐྱེ་བ་དང་དེ་ཙམ་དང་རྗེས་སུ་འབྲེལ་བ་གྲུབ་ན་བལྟར་རུང་བའི་ཡུལ་ཅན་རྒྱུ་དང་ཁྱབ་པར་བྱེད་པའི་ངོ་བོ་མི་དམིགས་པས་འགྲུབ་པར་འགྱུར་གྱི།",
    "མི་དམིགས་པ་དང་རང་བཞིན་དང་འབྲས་བུའོ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "འབྲས་བུ་ཡང་རང་བཞིན་འབྲེལ་པ་ཡིན་ཏེ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱིས་བསྐལ་པས་ན་བསྐལ་པ་ནི་རྣམ་པ་གསུམ་སྟེ།",
    "ཕྱོགས་འདིས་གཞན་དུ་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱི་དབྱེ་བ་བལྟ་བར་བྱའོ།",
    "འོན་ཀྱང་རང་བཞིན་གཞན་ཡང་ཡིན་ཏེ།",
    "འོན་ཀྱང་རང་ཉིད་མ་དམིགས་པས་ཡིན་ནོ་ཞེ་ན།",
    "དེས་ན་རྒྱུ་དང་འབྲས་བུའི་དངོས་པོ་ཡང་རང་བཞིན་ངེས་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཉི་གར་ཡང་རང་བཞིན་འབྲེལ་བ་ཁོ་ནས་ལྡོག་གོ།",
    "དེའི་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དང་།",
    "མངོན་སུམ་དང་འགལ་བ་ཡང་རང་བཞིན་སྣ་ཚོགས་ཅན་གྱིས་རང་བཞིན་གང་ཞིག་འདྲེས་པར་སྣང་བའི་བློ་མཐོང་བ་མེད་པའི་ཕྱིར་འབྲེལ་པ་ཅན་གཞན་མེད་པས་ཉན་པ་ལ་གཉིས་མེད་པར་སྣང་བ་དེ་ཉིད་སྤོང་ན་འགལ་བ་ཡིན་ཏེ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་གཏན་ཚིགས་ཀྱི་ཁོངས་སུ་འདུས་པའི་ཕྱིར་དཔེར་བརྗོད་པ་ཁོ་ན་སྟེ།",
    "དེ་ཡང་རང་རིགཔའི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ནོ།",
    "མཐོང་བའི་དེ་མ་ཐག་པ་ཡང་རང་རྒྱུད་པར་མི་འགྱུར་རོ།",
    "ཕྱིས་ཀྱང་རང་ཉིད་ཁོ་ནས་དེ་ལྟར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དངོས་པོ་ཇི་ལྟར་གནས་པ་བཞིན་དུ་འདུག་པ་བདག་དང་འབྲས་བུ་དང་མི་དམིགས་པ་རྣམས་ལ་མི་སྲིད་དོ།",
    "དེ་བས་ན་མི་དམིགས་པ་འདི་དང་རང་བཞིན་ནི་ཕན་ཚུན་འགལ་བའི་དོན་བསྒྲུབས་པས་གཅིག་ལ་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་དོ།",
    "དམིགས་པའི་རིག་བྱར་གྱུར་པ་ནི་དམིགས་པའི་རྐྱེན་གཞན་ཚང་བ་ཉིད་དང་རང་བཞིན་ཁྱད་པར་ཅན་ཏེ།",
    "མེད་པའི་ཐ་སྙད་སྒྲུབ་པའི་མི་དམིགས་པ་དེ་དགཐམས་ཅད་ལ་ཡང་རང་བཞིན་འགལ་བ་ལ་སོགས་པ་དམིགས་པ་དང་།",
    "དངོས་པོ་ཅི་ལྟ་བ་བཞིན་དུ་གནས་པར་འདུག་པ་བདག་དང་འབྲས་བུ་དང་མི་དམིགས་པ་དག་ལ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "དེ་དང་འབྲེལ་བ་ཅན་གྱི་རང་བཞིན་ཙམ་གྱི་རྗེས་སུ་འཇུག་པའི་རང་བཞིན་ཅན་དེའི་ཡུལ་ན་འདུག་པའི་རང་བཞིན་ཉིད་ཡིན་ནོ།",
    "མི་དམིགས་པ་འདི་དང་རང་བཞིན་དེ་ནི་ཕན་ཚུན་འགལ་བའི་དོན་དུ་བསྒྲུབས་པ་ཡིན་པས་གཅིགལ་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་དོ།",
    "ངོ་བོ་ཉིད་གཞན་ཞིག་བྱེད་ན་ཡང་དངོས་པོ་དེའི་སོ་ན་འདུག་པ་ལ་ཅུང་ཟད་ཀྱང་མི་བྱེད་པས།",
    "དེའི་སོ་ན་འདུག་ན་དེ་ལ་སྒྲིབ་པར་ཡང་མི་རུང་བའི་ཕྱིར་རོ།",
    "འདི་ལ་ཡང་སྤྱི་བསྒྲུབ་པར་བྱ་བ་ཉིད་མ་ཡིན་བདེའི་སོ་ན་འདུགགོ།",
    "འདུག་པར་ཡང་མི་བྱ།",
    "གཏན་ཚིགས་ནུས་པ་མེད་པ་དེའི་སོན་འདུག་པས་སྦྱོར་བ་མ་ཡིན་ནོ།",
    "གཞན་དུ་འདི་ནི་འདུག་པ་ན།",
    "འབྲས་བུ་གནས་པ་ན་རྒྱུ་ལ་ལྟོས་པ་མེད་པས་གཉིས་ལ་རིམ་གྱིས་འདུགན་ནི་འབྲེལ་བར་མི་རུང་སྟེ།",
    "ཉེས་པ་འདིར་མི་འགྱུར་བར་བྱ་བའི་ཕྱིར་གཞན་དུ་རྒྱུའམ་འབྲས་བུ་ལ་རིམ་གྱིས་འབྲེལ་པ་འདི་འདུག་པ་ན།",
    "མ་འགགས་ན་ཡང་ལྷན་ཅིག་ཏུ་འདུག་པ་གཉིས་ཕན་པར་བྱེད་པ་དང་།",
    "འབྲས་བུ་ཡང་རང་བཞིན་དང་འབྲེལ་པ་ཡིན་ཏེ།",
    "མང་པོ་ཞིག་ཚོས་པ་མཐོང་དུ་ཟིན་ཀྱང་ཕྲུ་བའི་ནང་དུ་འདུག་པ་ཙམ་གྱིས་ཚོས་པར་མི་འགྲུབ་སྟེ།",
    "དེའི་ཕྱིར་རྒྱུ་དང་རང་བཞིན་དག།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས།",
    "བསལ་བ་རྣམས་བསལ་ན་རིགས་འབའ་ཞིག་འདུག་པའི་ཕྱིར་རོ།",
    "མདུན་ན་འདུག་པའི་དངོས་པོ་གཅིག་ཅིག་ཡང་དག་པར་བསྟན་ནས་འདི་ནི་ཤིང་ཡིན་ནོ་ཞེས་བརྡར་བྱེད་ལ།",
    "འདི་ཁོ་ན་ཡིན་ནོ་ཞེས་བྱ་བའི་ཚུལ་གཉིས་ལས་ནི་མི་གདའ་ལ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "དེ་ནི་དེའི་དང་པོར་ཡོད་པ་མ་ཡིན་ལ་དེ་ཉིད་ཀྱང་རང་བཞིན་དུ་གནས་པ་འདིའི་ཕྱིར།",
    "འབྲས་བུའི་རྟགས་ཅན་དང་རང་བཞིན་གྱི་རྟགས་ཅན་ནོ།",
    "ཡོད་པ་ཉིད་ཡིན་ན་ཡང་རང་བཞིན་ལ་སོགས་པས་བསྐལ་པས་འགའ་ཞིག་ཏུ་མི་དམིགས་པའི་ཕྱིར་དང་།",
    "དེས་རྟག་ཏུ་ཟིན་ཀྱང་རང་བཞིན་གཞན་དུ་བསྒྱུར་བ་མེད་པར་འགའ་ཞིག་ལས་རང་ཉིད་ཀྱིས་དཔྱད་ནས་སྦྱོར་བར་བྱེད་པའི་ཕྱིར།",
    "དེ་ལས་བྱུང་བ་ཅན་དང་དེ་ལས་བྱུང་བ་ཅན་མ་ཡིན་པའི་དོན་རྣམས་ཀྱི་ཡང་རང་བཞིན་གྱི་ཁྱད་པར་བསྟན་པར་བྱའོ།",
    "ཐ་དད་པ་རྣམ་པར་གཞག་པ་ཡང་རང་བཞིན་ཐ་དད་པ་ལ་བརྟེན་པ་ཅན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་འདིས་སྨྲ་བ་པོ་གཞན་དགའདུག་པར་གྱུར་པ་ན།",
    "རྟོགས་པའི་སྣང་བ་དང་རང་བཞིན་ཐ་དད་པ་ཡང་མི་མཚུངས་པའི་ཕྱིར་ཡུལ་གཅིག་པ་མ་ཡིན་ཏེ།",
    "དེ་ཡང་རང་བཞིན་ཉིད་ཡིན་ཏེ།",
