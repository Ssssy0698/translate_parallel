    "དེ་བཙན་གྱི་ཆོ་འཕྲུལ་རང་ཡིན་པར་འདུག་གསུང་བྱུང་སྟེ་དོན་དུ་གངས་རིའི་ལྷ་བཙན་ཡིན་པར་སྣང་གསུངས་སོ།",
    "དེ་ལྟར་གངས་རི་ཕྱོགས་སུ་ལོ་ལྔའི་བར་དུ་བཞུགས་ནས་སླར་ཡང་རང་གནས་མང་ཡུལ་གྱི་ལྗོངས་སུ་འབྱོན་པར་བཞེད་དེ་དཔོན་སློབ་གཉིས།",
    "ཆིབས་གཡག་གཅིག་ཡོད་པ་ལོ་ཤས་དབྱར་སྤང་རྣམས་སུ་ཅི་དགར་འཚོ་བ་ལས་མཐར་ཤི་བའི་ཚེ་རྭ་གཉིས་ཀྱི་ནང་ནས་རིང་བསྲེལ་གྱི་རྣམ་པ་ཤིན་ཏུ་མཚར་བའི་གོང་བུ་འགའ་ཞིག་བྱུང་འདུག་ཀྱང་ཅི་བདེར་བོར་ནས་བཞག་པ་ཡིན་གསུངས།",
    "ནུབ་གཅིག་རྨི་ལམ་དུ་རྗེ་རིག་འཛིན་ཆེན་པོ་དང་འབའ་ར་བ་གཉིས་བྱོན་གྱི་ཡོད་དོ་ཞེས་མི་མང་པོ་ཟང་ཟིང་དུ་འདུག།",
    "ཧེ་ཧེ་དེ་ནི་རོ་གཅིག་ཡིན་པ་འདུག་ཟེར་བ་ཞིག་བྱུང་ཞེས་ཁོ་བོས་ལན་དུ་མར་ཞལ་ལས་ཐོས་སོ།",
    "རིག་འཛིན་ཆེན་པོ་ནི་མི་འདུག།",
    "རིག་འཛིན་ཆེན་པོ་ནི་མིན་པ་འདུག།",
    "སྐུ་ཞབས་ཡིན་པ་འདུག།",
    "དོན་དུ་ང་རང་འཁྲུལ་པ་ཡིན།",
    "ལོགས་ཞིག་ཏུ་དཀྱིལ་འཁོར་ཤིན་ཏུ་ཆེ་བ་སྒོ་རྫོགས་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པ་ཞིག་འདུག།",
    "དེའི་འགྲམ་དུ་ཨ་ཝ་དྷུ་ཏི་པ་ནམ་མཁའི་མཚན་ཅན་ཀྱང་བཞུགས་འདུག་པར།",
    "འདྲ་ཞུས་ཡོད་འདུག་པར་བརྟེན་རྗེ་ཉིད་ནས་བདག་ལ་སྐུ་མདུན་དུ་ཤོག་གསུངས་ཕྱིན་པར།",
    "ཉིད་རང་དཔོན་སློབ་གསུམ་པ་ཞིག་བཞུགས་འདུག་པ་ལ།",
    "ཞེས་ཞུས་འདུག་པ་བཞིན་བསྟན་འཛིན་རྣམས་ལས་སྲུང་མ་རྣམས་བསྟན་ལ་སེམས་ཁུར་ཆེ་ཞིང་བྱེད་གཏད་ལ་གྱ་བར་ཡོད་ཚོད་དུ་མཆིས།",
    "གཏེར་སྟོན་ནམ་དཔའ་བོའམ་ལས་སད་པའི་སྐལ་ལྡན་ཞིག་མིན་པའི་ངེས་པ་མི་འདུག་གསུངས།",
    "གཙུག་ཕུད་ཅན་གྱི་རྣ་བར་དབྱར་སྐྱེས་ཀྱི་རྔ་སྒྲ་ལྟར་གྱུར་པས་བཞུགས་སྤྲོ་ཞིང་ཕེབས་ཆོག་མ་ཡོད་ཚུལ་གྱི་ཞུ་ཡིག་ཚིགས་སུ་བཅད་པའི་དབྱངས་ཀྱིས་བསྐུལ་བ་བཞིན་དེ་འཕྲལ་དུ་ཕེབས་པར་གཟིམ་ཆུང་རང་དུ་བཞུགས།",
    "འཁོར་འདས་བཟང་ངན་དང་བྲལ་འདུག།",
    "རང་རིག་རང་གསལ་དུ་འདུག་པ།",
    "ཟབ་གསལ་བདེ་ཆེན་དུ་འདུག་པ།",
    "སྐུར་ཞུས་སོགས་བྱེད་པ་ཞིག་བྱུང་འདུག་པ་ནི།",
    "བྱམས་སྤྲིན་ནས་འཚོ་མཛད་རྡོ་རྗེ་ལགས་ཀྱི་སྦྱིན་བདག་གནང་སྐུ་མཆོད་ཀྱི་ཚོགས་འཁོར་རྒྱས་པར་འདུག།",
    "ད་ལམ་སོ་སོ་ནས་མ་སྒྲིག་དུས་སྐབས་རྩེ་མཐུན་ལྷན་ཅིག་ཏུ་བྱོན་པ་འདི་འདྲ་ཐུགས་ནང་དག་པའི",
    "ད་རྒྱུན་རིང་ཞིག་མི་སྡོད་པ་འདྲ་སོགས་བསྩལ་འདུག།",
    "སྤྲུལ་པའི་སྐུ་ཚོར་ཞུ་དགོས་འདུག་པར་ད་ཆ་ཡར་སྐད་མར་སྐད་བྱས་ཆོག་པ་ཡོང་བ་འདུག་ཅེས་ཕེབས་སྣང་།",
    "ངེད་རང་རིག་པ་ཉོག་གེ་བ་ལ་སྐབས་སུ་ཐིམ་རིམ་གྱི་རྣམ་པ་འཆར་བ་ལྟ་བུ་ཞིག་འདུག།",
    "དེ་མ་ཐག་ཐོས་མཆོད་གདུང་འབུལ་གྱི་མཆོད་སྤྲིན་བཅས་ཕོ་ཉ་བ་ཕྱིར་མངགས་སྐུ་གདུང་གཞུ་སྦྱང་གྲུབ་ཙམ་ལ་འབྱོར་འདུག་ཅིང་།",
    "རྩ་བ་བཞི་དང་རགས་པ་བཅུ་སོགས་གང་ལའང་བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བས་མ་གོས་ཤིང་།",
    "དགུང་ལོ་ལྔ་བཅུ་ང་བརྒྱད་ཡན་ལ་ཐུགས་དམ་གྱི་རིམ་པ་མང་བར་གནང་འདུག་ཀྱང་ཚུལ་འདི་ནི་ཞལ་ལུང་ལས་ཇི་ལྟར་བྱུང་བ་བཞིན་དང་སྐུའི་གམ་དུ་རང་ཉིད་གཉུག་མར་བསྟི་བའི་སྐབས་སུ་མཐོང་ཐོས་དཔྱད་པ་ཇི་བཞིན་པར་བཀོད་པའི་ལུགས་ཡིན་ནོ།",
    "རང་རང་གཞུང་བཞིན་མི་ཤེས་པར།",
    "དར་ཅོག་འཛུགས་པ་སོགས་བྱུང་འདུག།",
    "ཀ་དག་རང་བྱུང་རང་ཤར་གྱི་ཁྲིད།",
    "ཡག་པོ་ཡིན་འདུག།",
    "ཞེས་གསུངས་པ་དེ་སྐབས་གཞན་རྣམས་ཕལ་ཆེར་གྱི་གོ་ཐོས་སུ་བླ་ཆེན་དུ་འཕར་བ་ལ་དཀའ་ཚེགས་མི་འབྱུང་ཞེས་པར་གོ་འདུག་ཀྱང་མ་བརྟགས་པའི་གོ་ཕྱོགས་བླན་མཚང་སྟེ།",
    "དམ་པ་འདིའི་བཀའ་ཆེམས་ཀྱི་རིམ་པ་ཇི་ལྟར་བསྩལ་བ་རྣམས་སྒྲ་ཇི་བཞིན་པ་ཟིན་རིས་སུ་བཀོད་པར་མཛད་འདུག་ཅིང་།",
    "ཕྱག་མཛད་བྱུང་བར་འདི་འདྲ་མི་མཛད་པར་ཞུ་ཞུས་པར་རྫོགས་ཆེན་རྒྱུད་བཅུ་བདུན་གྱི་ལྗགས་ལུང་འདི་ཞུ་དགོས་འདུག་པར་ཐུགས་ཡ་ང་མཛད་མི་དགོས་གསུང་མཎྜལ་འབུལ་བ་གནང་བ་བཞིན་གླེགས་བམ་དུ་གང་བཞུགས་དང་།",
    "བཀའ་ལས་ད་ལམ་སོ་སོ་ནས་མ་བསྒྲིགས་དུས་གཅིག་ཏུ་ཕེབས་པ་འདི་འདྲ་ཐུགས་ནང་དག་པའི་རྟགས་རང་ཡིན་འདུག་གསུངས།",
    "ངེད་ཀྱི་རྗེས་ཀྱི་བྱ་བ་བྱེད་དགོས་ཐམས་ཅད་གཙོ་བོར་མེས་མེས་རང་ལ་ཞུ་དགོས་འདུག་པར་དེས་ན་ཡར་སྐད་མར་སྐད་བྱས་ཆོག་ཚུལ་ཕེབས།",
    "གསུང་འབྱོན་མི་ཐུབ་པ་ཡོད་འདུག་ཀྱང་དགྱེས་ཚུལ་དང་།",
    "ལོ་མཇུག་དུས་རིམ་གྱི་རྡོ་རྗེ་སློབ་དཔོན་སྔར་རྒྱུན་བཞིན་མཛད་དེ་མགོན་གནང་དུ་ཕེབས་སོ།",
    "དེ་སྐབས་མཚན་ལྟས་ངན་པ་འགའ་ཞིག་བྱུང་འདུག་པ་འབྱུང་འགྱུར་གྱི་ལྟས་མི་རིང་བར་མངོན་དུ་གྱུར།",
    "ངེད་རང་མགོན་གནང་དུ་བསྡད་འདུག་པར་ཕྱི་རོལ་ནས་གཏམ་ཞིག་ལ།",
    "གནས་ཚུལ་ཁ་ཤས་ཀྱིས་སམ་ཊ་ཞིག་ཕུལ་བར་དབུ་ཐོག་ཏུ་བཞག་ནས་ཐུགས་སྨོན་ཡུན་རིང་དུ་མཛོད་དེ་འཇོག་པ་གནང་འདུག།",
    "ལན་འབུལ་དགོས་སམ་ཞུས་འདུག་པར་མི་དགོས་གསུང་།",
    "དུས་ཚོད་དེ་ཀར་སྙན་ཟུག་སོགས་མེད་པར་ཞི་བའི་དབྱིངས་སུ་ཐིམ་པར་འདུག་གོ།",
    "ལས་སྒྲིབ་ཀྱིས་སྒྲིབ་པ་མ་གཏོགས་ཟླ་དཀྱིལ་དེའི་ནང་ནས་མཐོང་རྒྱུ་ཞིག་ཡོད་འདུག་པ་ལ་བསམ་པ་ཤར།",
    "གདུང་ལོགས་སིལ་སྒྲ་འབྱིན་པ་མང་དུ་སྣང་ཞིང་དཀྱིལ་འཁོར་རས་བྲིས་ཀྱི་ཆ་ཤས་མེས་མ་གནོད་པ་སྤར་མཐིལ་ཙམ་ཞིག་ཀྱང་འདུག་གོ།",
    "རྒྱལ་མཚན། ། དཔལ་བེའུ་ལ་སོགས་པའི་གཟུགས་བརྙན་མཚར་བའང་འདུག་ཚུལ་ཕྱོགས་མཐའ་དག་ནས་མི་མང་པོས་མཐོང་ངེས་བྱུང་འདུག།",
    "རང་ལས་རྒན་པ་ན་མཉམ་སོགས་དེ་ཀ་ཙམ་ཤི་འདུག།",
    "ཁ་སང་ཁར་ཉིན་མདང་ད་ནང་རང་ལ་མི་ག་ཙམ་ཤི་འདུག་པ་མ་ཐོས་སམ།",
    "དགྲ་འདུལ་གཉེན་སྐྱོང་རང་རྒྱལ་གཞན་ཕམ་གྱི་སྡིག་བསོག་ཁོ་ན་ལ་འབུང་གསུམ་འདོན།",
    "དེང་སང་སྒྲུབ་པ་ལས་ལྷག་པའི་གྲོལ་སྟོན་ཡིན་ཟེར་མི་འབྱོར་བཞིན་རྒྱས་བཤོམས་ཀྱི་སྟོང་མཁན་འདུག་ཀྱང་ཡིན་བསམ་པ་མ་ཤར།",
    "ཕལ་ཆེར་རང་རང་ཕྱོགས་སུ་ཞེན་པ་མང་།",
    "འདི་ལྟར་དམིགས་ཀྱང་རང་ཉིད་ལས",
    "སློབ་དཔོན་རང་ཉིད་དཀྱིལ་འཁོར་ལ་ཕྱོགས་པས་སྟན་ལ་འདུག་སྟེ་ངོ་མཚར་བརྒྱུད་གསོལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་ཁམས་སྐྱེ་མཆེད་རྟོག་སྒྲིབ་དང་བཅས་པ་གཞོབ་ཐུལ་གྱིས་བསྲེགས།",
    "ཅེས་གསུངས་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "ཅེས་གསུངས་པ་ལྟར་ཁྱེད་རང་རྣམས་སྔགས་ཀྱི་ཆོ་གའི་སྒོ་ནས་བུར་བྱས་ཟིན་པས།",
    "ཉི་ཟླའི་སྟེང་འདུག་ཕྱག་མཚན་ཐོགས",
    "སློབ་དཔོན་ས་ཐོབ་ཁྲི་ལ་འདུག",
    "ཞེས་གསུངས་པས་རྨི་ལམ་དངོས་སུ་དྲི་བར་མི་མཛད་ཀྱང་རང་རང་ལ་རྨི་ལམ་བཟང་ངན་དེ་དག་གང་རྨིས་ཀྱང་འཛིན་ཞེན་མི་བྱ་བར།",
    "སྟོང་ཞིང་རང་སེམས་བརྟན་པར་བཟུང་",
    "ཅེས་གསུངས་པས་ཁྱེད་རང་རྣམས་ལས་ཀྱི་རྡོ་རྗེ་སློབ་དཔོན་གྱིས་སྣ་དྲངས་ཏེ་དཀྱིལ་འཁོར་ལ་འདོད་སྣམ་གྱི་སྟེང་ནས་བསྐོར་བ་ལན་གསུམ་བྱས།",
    "རང་བྱུང་རང་ཤར་རྒྱུད་ཆེན་ལྟར་ཕྱོགས་བཞིའི་སྒོ་བཞིའི་བརྡ་སྒོ་དབྱེ",
    "རང་བྱུང་རང་ཤར་དོན་མཐོང་ཕྱིར",
    "དེ་ལྟར་ཁྱེད་རང་རྣམས་དེ་ལྟ་བུའི་བསྐྱེད་རིམ་དང་ལྡན་པའི་ངང་ནས།",
    "རང་རང་རིགས་དང་རིགས་ཆུང་དང་",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཐུགས་ཀར་རྡོ་རྗེ་སེམས་དཔའ་དཀར་པོ་ཞིག་གསལ་བཏབ་སྟེ།",
    "དང་པོ་སློབ་དཔོན་རང་ཉིད་དཀྱིལ་འཁོར་ལ་ཕྱོགས་པས་སྟན་ལ་འདུག་སྟེ།",
    "རང་བྱུང་རང་གནས་བདག་ཉིད་ཆེ",
    "དེ་སྟེང་རང་ཉིད་འོད་དཔག་མེད",
    "ཁྱེད་རང་རྣམས་ཐུགས་འདུན་། དམིགས་པ་འདི་བཞིན་དུ་མཛོད།",
    "ནང་རང་ལུས་ཕུང་ཁམས།",
    "འདི་རྨི་ལམ་རྨི་བ་ཡིན་འདུག་སྙམ་དུ་བསམ།",
    "བཅས་དང་རང་བཞིན་ཉེས་པའི་དྲི་མ་འཁྲུད།",
    "ལྟ་བར་མ་ཞུགས་པ་ན་རུང་བའི་ཡུལ་ན་འདུག་ཀྱང་བལྟ་བར་བྱ་མི་ནུས་པ་ནི་རྐྱེན་གཞན་དང་འབྲལ་བ་ཅན་ཡིན་ལ།",
    "ཡུལ་དང་དུས་རིང་པོ་དང་འདུག་པ་ནི་གཉི་ག་དང་བྲལ་བ་ཡིན་ནོ།",
    "རྩོལ་བ་ལས་བྱུང་བ་ཉིད་ཀྱང་རང་བཞིན་དུ་ངེས་པ་ཡིན་ཏེ།",
    "དེ་ལས་བྱུང་བའི་རྟགས་ཀྱང་བསྒྲུབ་པར་བྱ་བའི་དོན་དང་རང་བཞིན་འབྲེལ་པ་ཡིན་ནོ།",
    "སྐྱེད་པར་བྱེད་པ་མ་ཡིན་པ་དང་ཡང་འབྲེལ་པའི་རང་བཞིན་འགའ་ཞིག་ཡོད་ན་ནི་རྒྱུ་། མཚན་གཞན་ལས་ཀྱང་རང་བཞིན་འབྲེལ་པར་འགྱུར་བ་ཞིག་ན།",
    "འབྲས་བུ་དང་རང་བཞིན་གཉིས་ཁོ་ན་ཇི་ལྟར་གོ་བར་བྱེད་པ་ཡིན་ཞེ་ན།",
    "འདིར་རྐྱེན་གཞན་ཚོགས་པ་དང་རང་བཞིན་ཁྱད་པར་ཅན་ཡིན་པའི་ཕྱིར་དམིགས་པའི་རིག་གྱུར་པའི་དོན་བསྟན་ལ།"
  ]
}