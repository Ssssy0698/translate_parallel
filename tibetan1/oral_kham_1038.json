    "ཁོ་ངལ་བས་བཟི་འདུག་ངལ་གསོ་ཡག་པོ་ཞིག་རྒྱག་ཏུ་འཇུག་རོགས།",
    "ཟླ་བ་ཤར་ཨེ་འདུག་བལྟ་མི་ཐུབ།",
    "རིང་ནས་མགྲོན་པོ་ཞིག་འོང་སྐབས་སུ་ཡང་རྩམ་པ་དང་ཇ་སྲུབ་མས་སྣེ་ལེན་བྱེད་པའི་སྲོལ་ཞིག་འདུགཁོ་གཉིས་ལ་ཤིན་ཏུ་དམའ་བའི་ཁང་ལེབ་ལྔ་དྲུག་ཙམ་ཞིག་འདུག་པ་ཡང་སྒོ་ཞེང་ཆུང་ལ་དམའ་བས་སྐེད་པ་སྒུར་ནས་མ་གཏོགས་ནང་དུ་འགྲོ་མི་ཐུབ་ཅིང་སྒོའི་ལོགས་ཤིག་ན་ལོ་ཐོ་རྙིང་ཧྲུལ་ཞིག་བཀལ་ན་ཡང་དེ་དོན་ཅི་ཡིན་ཆ་མི་འཚལ།",
    "གྱོན་པ་དེས་ང་རང་བྱེད་སྟངས་མི་ཤེས་པ་ཞིག་བཟོས་བྱུང་།",
    "དཔེ་མི་སྲིད།",
    "ཐ་ན་འདས་ཟིན་པའི་དོན་བྱ་ཕྲན་བུའང་དྲན་ཁོམ་མི་འདུག་སྐད་ཅིག་མའི་ཡུན་ལ།",
    "ང་རང་སེམས་གཏིང་ནས་ཡིད་ཆེས་པར་གྱུར།",
    "གནས་དེའི་མིས་གནའ་ནས་བཟུང་ཆར་ཆུ་གསོག་འཇོག་བྱེད་ཀྱི་འདུག་སྟེ།",
    "སན་ཡ་ཡི་རྒྱ་མཚོའི་འགྲམ་ངོགས་སོགས་ང་རང་ཕྱིན་གཟི་མིག་དཔེ་ཚོགས།",
    "མཐོང་སྣེ་འདྲ་མིན་སྣ་ཚོགས་མཆིས་ཤིང་ལྟ་ཚུལ་འདྲ་མིན་སྣ་ཚོགས་གདའ།",
    "ཡང་ན་མཛེས་པ་སྲིད་ན་དཀོན་པའི་འཛམ་གླིང་རང་བྱུང་ཤུལ་དངོས་རྩ་ཆེན་ཞིག་ཡིན་ནམ།",
    "ང་རང་འུ་ཐུག་ཐབས་ཟད་ཀྱི་ངང་ལ།་",
    "མིའི་རིགས་བར་སྣང་ཁམས་ལ་འཕུར་ཞིང་ཕ་གཞིས་ལ་ཕྱི་མིག་སློག་དུས།",
    "ཁ་དོག་སྣ་ཚོགས་བཀྲག་མདངས་ཀྱིས་འཚེར་གྱིན་གདའ།",
    "རྩ་བའི་ཞེང་ཚད་ལ་སྨི་གཉིས་དང་ཡལ་གར་སྨི་བཞི་བཅུ་ལྔ་བཅུ་འདུག་ཁ་ཤས་ཀྱིས་ད་དུང་ལྗོན་ཤིང་ཆུང་ངུ་དག་དུམ་བུར་བཅག་འདུག་པའམ་ཡང་ན་ལྗོན་ཤིང་གཞན་ལ་བསྙེས་ཏེ་འདུག་ཤི་ཡང་མི་འགྱེལ་བའི་ངང་ཚུལ་ནི་ཇི་འདྲའི་རྔམ་བརྗིད་ལྡན་ཨང་།",
    "ཡུན་ནན་གྱི་རི་ཆུ་ནགས་གསུམ་དེ་འཛམ་གླིང་ན་གྲགས་པ་ཆེ་བའི་ཡ་ལི་སང་ན་གྲོག་རོང་ཆེན་པོ་ལས་ཆེས་ཆེར་བརྒལ་འདུག་པར་འདོད།",
    "ཡུན་ནན་གྱི་ཡུལ་སྐོར་ལས་རིགས་ལ་མདུན་ལམ་ཡག་པོ་འདུག་དེ་ལྟ་ནའང་།",
    "ནམ་ཞར་འགྲོ་ཐབས་འདུག་ཐབས་ཀྱིས་འཚོ་བར་མི་རུང་ནའང་།",
    "སྐབས་འདིའི་སེམས་ཁམས་ནི་ཚིག་རྐང་གཉིས་ཀྱི་བར་མཚམས་ཀྱི་ཚིག་ཕྲད་ཅིག་དང་མཚུངས་པར་སྙོབ་པའི་གོ་སྐབས་མི་འདུགལོ་ཟླའི་ཡལ་ག་རུ།",
    "ད་ནི་ཁྱིམ་དུ་ལོག་ནས་སྒོ་ཁའི་དེའུ་འབུར་དེའི་སྟེང་སྡོད་པའི་གོ་སྐབས་ཀྱང་ཉུང་དུ་གདའ་སྟེ།",
    "ང་རང་ཉི་འོད་ཀྱི་རྒྱབ་ལོགས་སུ་སྐུང་ནས།",
    "ང་རང་ནི་ལྕགས་རི་རིང་བོ་ཞབས་ཀྱིས་བཅགས་མྱོང་བའི་དབྱིས་མི་ཞིག་ཡིན་པའི་ཆ་ནས།",
    "༧སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ཕུ་ནུ་གཉིས་རང་གནས་སུ་ལོག་དུས་སི་ཏཱ་བསྡད་མེད་པས་རྒྱལ་པོ་གདུང་བས་དྲན་པ་ཐོར་བའི་སྐོར།",
    "མཇུག་བསྡུ་བཅས་ལ་དབྱེ་གནང་མཛད་འདུག་ཅིང་།",
    "ད་དུང་རུ་དཔོན་གཡུ་རྒྱལ་ཞེས་པ་ཞིག་ཀྱང་ཁ་སྣོན་མཛད་འདུག་གཉིས།",
    "མཛའ་ཞིང་བརྩེ་བའི་ཕ་མ་དང་བློན་པོ་སོགས་དྲན་ཚུལ་གསོན་ཉམས་དོད་པོས་བཀོད་འདུག་ཅིང་།",
    "འཁྲབ་ཚན་འདི་མ་རྩོམ་དང་བསྡུར་ན་ཉུང་འཕྲི་མང་ཙམ་བྱས་འདུག་པ་དེ་ཡང་གར་སྟེགས་ཀྱི་གནས་ཚུལ་དང་བསྟུན་པ་ཡིན་ཤས་ཆེ།",
    "གཉེན་སྒྲིག་དུར་འཇུག་དུས་ཆེན།",
    "ཐུང་ཡང་རང་འདོད་ལྟར་འབྲི་ཆོག་པ་དང་།",
    "རྨི་ལམ་མིན་པ་ཤོག་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིག་ཅིག་ཅེས་ཁྲག་དྲོན་ཚ་པོ་རླངས་པ་འཕྱུར་བའི་རང་སེམས་དགའ་བས་མྱོས་པའི་སྐད་ཆ་མཐའ་དག་གཞས་ཚིག་དུམ་བུ་དེའི་ནང་ནས་མཚོན་པ་ནི་ཇི་འདྲའི་གསོན་ཉམས་ལྡན་པ་ཞིག་མི་འདུག་གམ།",
    "ཕེབས་མཁན་གཏན་ནས་མི་འདུག།",
    "འཚེམ་བུ་རྒྱུག་ཐབས་མི་འདུག་ཅེས་པ་དང་།",
    "ཐབས་ཤེས་ང་ལ་མི་འདུག།",
    "སྐོར་བ་བསགས་འདོད་འདུག་ཀྱང་།",
    "ཀྱེ་ཕ་མ་མཆོག་ང་རང་བྱམས་པའི་ཆེད་དུ་སྡུག་པོ་ཕྱི་སྡུག་མྱོང་དགོས་པ་དེ་སྔོན་གྱི་ལས་ཡིན་ཡང་དེའི་སྟེང་དུ་སྡུག་པོ་ནང་སྡུག་མ་གཏོང་བར་མཛོད།",
    "ད་དུང་དམངས་ཁྲོད་དུའང་རང་སོའི་མིང་དངོས་ཀྱི་སྔོན་དུ་ཁྱིམ་མིང་སྦྱར་ནས་འབོད་སྲོལ་ཡོད་པ་ནི།",
    "དཔེར་བརྗོད་མཛད་ཡོད་ཀྱང་དཔེར་བརྗོད་དེ་དག་ལ་ཞིབ་པར་བརྟག་ཚེ་སྙན་གཞུང་ལེའུ་གསུམ་པ་སྒྲ་རྒྱན་གྱི་ཁོངས་སུ་འགྲོ་བའི་ཉམས་ཤིག་ཀྱང་ཐོན་གྱིན་འདུག་གཞན་ཡང་ཡི་གེ་སྲོག་ཆེན་སྲོག་ཆུང་ཞེས་པའང་རྒྱ་གར་གྱི་ཡི་གེ་དང་བོད་ཀྱི་ཡི་གེ་མི་མཐུན་པ་ནི།",
    "དེ་ལྟར་རྩོམ་པ་པོ་ཁོང་རང་ཉིད་ཀྱི་འཚོ་བའི་ནང་ཀྱག་ཀྱོག་མང་ཞིང་།",
    "སྔོ་མེར་འཁྱིལ་བའི་མཚོ་དང་མཚེའུ་སོགས་གང་ཐུག་ཀྱང་དེ་ཚིམས་པར་འཐུང་ནས་སྐོམ་པ་སེལ་བར་གྱིས་ལ་དེ་ནས་སྔར་བཞིན་བྱང་ཕྱོགས་སུ་བསྐྱོད་ཅིང་ཅེས་རབ་བཏགས་ཀྱི་རྒྱུན་ཇི་འདྲའི་སྙན་པོ་སྦྱར་མི་འདུག་གམ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་ལྟ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་ལས་ས་ན་ང་འི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་ལྟ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྔར་གྱི་སྙན་སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕྲ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "སྙན་གཞུང་ལེའུ་གསུམ་པའི་རྩ་བ་གསར་པ་ཆུ་བརྒྱུ་ཟམ་འདུས་དང་རང་འགྲེལ་ཕུ་མཐོང་ཆེ་ཤེལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ལ་ལའི་ཐོག་མཚར་གཏམ་ཞེས་བཀོད་གནང་མཛད་འདུག་པས་གོང་གསལ་ཐ་སྙད་དེ་གཉིས་ཕན་ཚུན་ཡིན་ཁྱབ་མཉམ་འདྲ་ཤས་ཆེ།",
    "གོན་ནས་རྐང་པའི་རླངས་པ་མི་ཤོར་བ་བྱེད་ཀྱི་འདུག་པས་ངས་ཀྱང་འགྱིག་ཤོག་གོན་ནས་རྐང་པའི་རླངས་པ་མི་ཤོར་བ་བྱེད་ཀྱི་ཡོད་ཅེས་ལན་བཏབ་ཅེས་པ་ལྟ་བུ་དང་།",
    "ལྷ་བུས་ཀྱང་དབུ་ཆེན་ལ་བཟོ་བསླབ་འདུག་ཅེས་དང་།",
    "ཁོ་བོའི་བསམ་པར་སྒྲུང་ཐུང་འགྱུར་ཁུག་མང་བའི་མཛའ་གླུ་ཞེས་པའི་རྩོམ་འགོ་འཛུགས་སྟངས་དང་རྩོམ་མཇུག་བསྡུ་སྟངས་ཧ་ཅང་ཡག་པོ་བྱུང་འདུག་སྙམ།",
    "ཞེས་ལྷ་བུ་དམག་དུས་འཐིམ་སྟེ་དམག་ཁོངས་ནས་ཕྱིར་ལོག་བྱས་པ་དེ་ནས་རྩོམ་འགོ་བཙུགས་ཡོད་པ་དང་།",
    "ལྷ་བུས་ཀྱང་དབུ་ཆེན་ལ་བཟོ་བསླབ་འདུག་ཅེས་འཕྱ་སྨོད་ཟུར་ཟ་བྱས་པ་དང་།",
    "རིམ་པ་གསུམ་པའི་བྱས་རྗེས་འཇོག་ཐུབ་ནའང་དམག་དུས་ཐིམ་རྗེས་ལམ་སེང་རྒྱལ་ཁབ་ཀྱི་ལས་བཟོ་གང་རུང་ཞིག་ལ་ལས་བགོས་བྱེད་དང་བྱེད་མུས་ཡིན།",
    "སྔོན་ཆད་ལུང་པ་འདི་ནས་ཉིན་བཅུ་ལས་རིང་བ་ཁ་གྱེས་མ་མྱོང་བས་ང་ཕ་ཡུལ་དྲན་པ་འདུག་ཟེར།",
    "ཡང་ཉིན་དགུང་ང་གཉིས་རྩྭ་ཐང་དུ་ཚ་འབོག་རྒྱག་དུས་ཁོས་གྲོགས་པོ་བསྟན་པ་ཡར་རྒྱས།",
    "སྒྲུང་ཐུང་དེའི་བརྗོད་དོན་གཙོ་བོ་ནི་བྱང་པ་ཚོས་དཀའ་སྤྱད་འབད་བརྩོན་གྱིས་ཚྭ་ལེན་པར་ཕྱིན་པའི་སྐོར་གློག་བརྙན་ནང་ནས་བསྟན་པ་བཞིན་ཤིན་ཏུ་གསལ་བར་བཀོད་འདུག་ལ་རྗོད་བྱེད་ཚིག་ཀྱང་གོ་བདེ་ཞིང་།",
    "ལེགས་ཉེས་སོགས་ཀྱི་སློབ་ཚན་ཞིབ་ཕྲ་ཞིག་འཁྲིད་གནང་མཛད་འདུག་གོ།",
    "དེ་ཡང་རང་ཅག་གངས་ཅན་ལྗོངས་ཀྱི་སྟོད་མངའ་རིས་བསྐོར་གསུམ་དང་།",
    "རྣ་བར་གསེར་གྱི་རྣ་ལོང་བོད་གཡུ་གྲུ་དམར་འབུར་དུ་ཐོན་པ་ཞིག་སྤྲད་པ་བཅས་བཏགས་འདུག་ལྟ་བུའི་མི་སྣའི་འཁྲབ་ཆས་ཞིབ་འབྲི་གནང་བ་མི་ཉུང་བ་ཞིག་ཡོད་པ་དེས་བརྩམས་སྒྲུང་ཧྲིལ་པོ་ལེགས་གྲུབ་ཡོང་རྒྱུར་གལ་ཆེའི་ནུས་པ་ཐོན་འདུག་ལྔ།",
    "དཔེ་སྒམ་གཅིག་ཅོག་ཙེ་གཅིག་དེ་མིན་ཐབས་ཆས་སྟབས་བདེ་ཞིག་ལས་གཞན་གང་ཡང་མི་འདུག་ཁང་པའི་ནང་གད་བདར་གཙང་དཔྱད་བརྗོད་བུང་བ་མྱོས་གླུ།",
    "སྒྱུ་རྩལ་ལ་དཔྱད་པ་ཞིབ་ཕྲ་གནང་འདུག་པ་དེ་ནི་ཕལ་ཆེར་བོད་ཡིག་ཐོག་ནས་གཞོན་ནུ་ཟླ་མེད་ཀྱི་གཏམ་རྒྱུད་ལ་བྲིས་པའི་དཔྱད་རྩོམ་དང་པོ་དེ་ཡིན་པ་འདྲ།",
    "འཛིན་པ་རྣམས་ལ་གྲགས་ཅན་གྱི་གནའ་རྩོམ་ཁག་ལ་དཔྱད་པ་བྱེད་པའི་མིག་དཔེ་བཟང་པོ་ཞིག་བསྟན་གནང་མཛད་འདུག་སྙམ།",
    "༥སྐལ་བཟང་ཡེ་ཤེས་ལགས་ཀྱིས་གཞོན་ནུ་ཟླ་མེད་ཀྱི་གཏམ་རྒྱུད་ཀྱི་རྩོམ་རིག་སྒྱུ་རྩལ་ཐད་ཀྱི་ཁྱད་འཕགས་རང་བཞིན་ལའང་ཞིབ་འཇུག་ནན་པོ་གནང་ནས་བསྔགས་བརྗོད་ཆེ་ཆེར་གནང་འདུག་པ་ནི།",
    "དོན་གང་ཞིག་བསྡུས་པ་འབྲི་དགོས་པས་བསྡུས་བྲིས་བྱས་ཡོད་མིན་ཡང་གསལ་པོར་གསུངས་འདུག་པ་ནི་ཧ་ཅང་དོན་ལ་གནས་པའི་དཔྱད་པ་ཞིག་ཡིན་དཔྱད་རྩོམ་བུང་བའི་མགྲིན་གླུ།",
    "ཅེས་དེ་དག་ནི་བརྗོད་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིག་དོན་མཚོན་སྟངས་ཀྱི་རྣམ་པའི་ཐད་འོ་ཆུ་འདྲེས་པ་ལྟར་འབྲེལ་བ་དམ་ཟབ་ཡོད་པའི་ངོས་འཛིན་གནང་འདུག་༣དཔྱད་རྩོམ་ནང་སྤྱིར་སྟོན་པ་ཤཱཀྱ་ཐུབ་པ་དང་།",
    "ལྟ་བ་ཡང་དག་ཡིན་པའི་གྲུབ་བྱེད་མང་པོ་ཞིག་གསུངས་འདུག་པ་ནས་འདིར་འགའ་ཞིག་དཔེ་མཚོན་དུ་དྲངས་ན་འདི་ལྟ་སྟེ།",
    "དེ་བཞིན་མཁས་གྲུབ་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་བདམས་སྒྲིག་དུས་སྟོན་ཁག་ལ་ཕུལ་བའི་ཤིས་ཚིག་དང་།",
    "དེ་ལ་ཡིག་ལ་བསྐོར་བའི་རྗེས་ཁྲིད་ཡིན་མིན་ཞིབ་ཏུ་བརྟག་དགོས་པ་འདུག་སྙམ།",
    "སྙན་ངག་ཤོ་ལོ་ཀ་དེ་གཉིས་སྙན་ངག་རྩོམ་ཧྲིལ་པོ་ཁྲི་འཕང་མཐོན་པོར་འཛེགས་པར་སྐས་ཀྱི་གདང་བུ་འཕར་མ་ཞིག་བསྣན་པ་ལྟ་བུའི་ནུས་པ་ཐོན་འདུག་གོ།",
