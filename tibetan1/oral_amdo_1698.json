    "བྱོལ་སོང་གི་སྐྱེ་གནས་སུ་མ་ཡིན།",
    "དེ་ལྟར་ཁོ་མོས་རྟག་པར་ལྷའི་ནང་དུ་ལྷའི་བདག་ཉིད་ཆེ་བ་ཉིད་ཐོབ།",
    "རིགས་ཀྱི་བུ་འཇིག་རྟེན་གྱི་ཁམས་གཟི་བརྗིད་རྡུལ་གྱི་དྲི་མ་མེད་པའི་དཔལ་དེནི་ཀུན་ནས་ཉོན་མོངས་ལ་རྣམ་པར་དག་པར་གྱུར་ཏེ།",
    "དེའི་ཚེ་ཁོ་མོ་ཡང་ཚོང་དཔོན་སྙན་པ་རྣམ་པར་གྲགས་པའི་བུ་མོ་ཤེས་རབ་སྣང་བའི་དཔལ་ཞེས་བྱ་བ།",
    "མཚན་མོའི་ལྷ་མོ་ཟླ་བ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་འོད་ཅེས་བྱ་བ་དེ་ཡང་།",
    "དེས་ཁོ་མོ་མཚན་མོ་མི་ཉལ་ཙམ་༺ཕལ་པོ་ཆེ་ཅ་",
    "ཁྱིམ་དེ་ཡང་ཡོངས་སུ་བསྐྱོད་དེ་འོད་ཆེན་པོས་སྣང་བར་བྱས་ནས་རང་གིགཟུགས་བསྟན་ཏེ།",
    "མཚན་མོའི་ལྷ་མོ་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ཟླ་བའི་འོད་སྔོན་དུ་བདར་ནས།",
    "དེ་ཐོབ་པས་ཀྱང་ཁོ་མོས་བསྐལ་པ་རི་རབ་ཀྱི་རྡུལ་ཤིན་ཏུ་ཕྲ་བ་སྙེད་པོ་དེ་དག་ཀྱང་རྗེས་སུ་དྲན་པར་གྱུར་ཏོ།",
    "འཇིག་རྟེན་གྱི་ཁམས་དེ་དག་དེ་བཞིན་གཤེགས་པ་ཇི་སྙེད་ཅིག་བཞུགས་པ་དེ་དག་ཐམས་ཅད་ཀྱང་ཁོ་མོའི་མིག་ལམ་དུ་སྣང་ཞིང་།",
    "དེ་དག་གི་ལྟ་སྒྲ་སྐད་རྣམ་པ་ཐ་དད་པའི་བརྡ་ཡང་རབ་ཏུ་ཤེས་སོ།",
    "བདག་ཉིད་ཀྱང་དེ་དག་གི་ཞབས་ཀྱི་དྲུང་ན་འདུག་པར་ཤེས་སོ།",
    "དེ་བཞིན་གཤེགས་པ་དེ་དག་གི་སྔོན་གྱི་ས་ས་ོ་ས་ཚུལ་རྒྱ་མཚོ་དང་།",
    "ཁོ་མོའི་མིག་ལམ་དུ་སྣང་སྟེ།",
