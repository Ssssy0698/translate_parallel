    "འགྲེལ་པར་ཡང་དེ་ལྟ་བུའི་དོན་གོ་བར་བྱའོ།",
    "ཁྱད་པར་ཡིན་ནོ་ཅོག་ཅེས་བྱ་བའོ།",
    "འོན་ཀྱང་ཞེས་བྱ་བས་ཁྱད་པར་བསྟན་པ་ནི།",
    "མཆོངས་པའི་ཡུལ་སྔ་མ་ཉིད་ལ་སླར་ཡང་འབད་རྩོལ་ལ་ལྟོས་པ་ཡང་ཆུ་བསྐོལ་བ་འཕེལ་བ་ཡང་མི་བརྟན་པ་ཉིད་ཀྱིས་ཕུལ་དུ་བྱུང་བར་འཕེལ་བ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་མེད་པའི་ཕྱིར་ནི་ཁྱབ་པར་བྱེད་པ་མེད་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་འགལ་བ་ཡིན་ནོ།",
    "འདིས་ནི་གང་ཚེ་བྱས་གྱུར་པ།",
    "ཁྱད་པར་བྱེད་པ་དང་བཅས་པ་ཞེས་བྱ་བ་ནི་ཁྱབ་པར་བྱེད་པ་མེད་པའམ་ཁྱབ་པར་བྱེད་པ་དང་འགལ་བའོ།",
    "གང་ཚེ་བྱས་གྱུར་པ་ཞེས་བྱ་བ་དེ་འཆད་པ་ཡིན།",
    "དེ་རྣམ་པར་འགྲེལ་པ་ནི།",
    "བྱས་པའི་ཁྱད་པར་ནི་ཕུལ་དུ་བྱུང་བ་གང་དག་ཡིན་པ་དེ་དག་ཡིན་ནོ།",
    "དེ་རྗེས་སུ་འཇུག་པའི་ཁྱད་པར་ཡིན་ཡང་།",
    "མཆོངས་པ་ལ་སོགས་པ་རྣམ་པར་ལྡོག་པ་ཁོ་ན་ཡིན་ནམ་དེ་ལས་བསྟན་པ་ནི།",
    "ཁྱད་པར་ཙམ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྱད་པར་འདི་ལ་ལྟོས་པ་ཡིན་ན་འདིར་འགྱུར་རོ་ཞེས་བསྟན་པ་ནི།",
    "གལ་ཏེ་ཁྱད་པར་འདི་ཉིད་གོམས་པའི་བསྐྱེད་བྱ་ལ་ཁྱད་པར་མེད་ན།",
    "རྒྱུ་ལ་ཁྱད་པར་མེད་ན་འབྲས་བུ་ལ་ཁྱད་པར་མེད་དོ་སྙམ་དུ་སེམས་པ་ནི།",
    "གོམས་པའི་བསྐྱེད་བྱའི་ཁྱད་པར་ཡིན་ཡང་།",
    "ཡང་འབད་རྩོལ་ལ་ལྟོས་པའི་ཁྱད་པར་ནི་འཕེལ་བ་ཡིན་ཡང་ཆུ་བསྐོལ་བ་བཞིན་དུ་ཤིན་ཏུ་འཕེལ་བ་མ་ཡིན་ཏེ།",
    "རྟེན་བརྟན་པའི་ཕྱིར་འཕེལ་བའི་ཁྱད་པར་ནི་རྟེན་དང་འགལ་བའི་འབྲས་བུ་མ་ཡིན་ནོ།",
    "ཁྱད་པར་གྱི་རྒྱུ་དང་རྟེན་མ་འགལ་བའི་ཕྱིར་དང་།",
    "ཁྱད་པར་ལ་ཡང་འབད་རྩོལ་ལ་ལྟོས་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་དམིགས་པ་ཉིད་ནི་ད་དུང་ཡང་སྣང་བ་ཉིད་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི།",
    "མི་མཐུན་པའི་ཕྱོགས་ཀྱིས་ཀྱང་བཟློག་བྱ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེའི་ཞིང་དུ་བྱས་པ་དག་ཅེས་བྱ་བའོ།",
    "མི་མཐུན་པའི་ཕྱོགས་ཀྱིས་མི་གསལ་བར་བྱས་པའི་ཕྱིར་དང་།",
    "གོམས་པ་ནི་སྟོབས་ཀྱི་རང་བཞིན་ཁོ་ན་ལ་བརྟེན་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "རྒྱུའི་ཚོགས་པ་མེད་པར་གོ་བར་བྱེད་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ནི།",
    "སྡུག་བསྔལ་གཞོམ་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་རང་དང་གཞན་གྱི་སྡུག་བསྔལ་གཞོམ་པར་བྱ་བའི་དོན་དུའོ།",
    "མཐོ་རིས་ཀྱི་ལམ་མངོན་དུ་མ་བྱས་པ་ནི།",
    "ཆད་པར་ནུས་པ་མ་ཡིན་ཏེ།",
    "རྗེས་སུ་དཔག་པས་ཡོངས་སུ་ངེས་པའི་དེ་ཁོ་ན་ཉིད་ཡོད་པ་ལ་སོགས་པས་སྐད་ཅིག་མ་ཉིད་ལ་སོགས་པར་ངེས་པ་ཡིན་ན།",
    "ངེས་པར་འབྱེད་པའི་ཆ་ལས་བརྩམས་ནས་ཁྱད་པར་ཐམས་ཅད་མངོན་སུམ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྗེས་སུ་དཔག་པས་ཁྱད་པར་ཐམས་ཅད་ངེས་པ་ཡང་མ་ཡིན་ཏེ།",
    "འདི་བྱས་ནས་འདི་བྱས་པ་ཡིན་ཞེས་བྱ་བའོ།",
    "རིགས་པ་ལས་གཞན་པ་ནི་ལུང་ཡིན་ཏེ་དེ་འཛིན་པར་བསྟན་པས་སྒྲ་རྣམས་ནི་དོན་ལ་མི་རིགས་པ་ཉིད་དུ་ཡང་འདིས་བསྟན་པ་ཡིན་ནོ།",
    "དེས་དེ་ལྟར་སྤྱི་ཉིད་ལ་འཛིན་པ་རྣམ་པར་དཔྱད་པ་བསྟན་ནས་སྔ་མ་གང་ཡིན་པ་དང་།",
    "ཕྱི་མ་གང་ཡིན་པ་ཞེས་བྱ་བའི་ཁྱད་པར་གྱིས་བསྟན་པ་ནི།",
    "དེ་མ་ཐག་པ་ཤིན་ཏུ་སྦྱོར་བར་བྱེད་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "འགྲེལ་པར་ནི་རིགས་པའི་ཡུལ་མ་ཡིན་པ་བསྡུ་བའི་དོན་དུ་ལུང་འཛིན་པ་ཡིན།",
    "ལུང་འཛིན་པ་ནི་རིགས་པ་ལས་འཇུག་པའི་དོན་དུའམ་ཞེས་བྱ་བ་ལ་སོགས་པར་རྗོད་པར་བྱེད་པར་གསལ་བ་ཡིན་ནོ།",
    "རྣམ་པར་དཔྱོད་པ་ལ་མངོན་དུ་ཕྱོགས་པ་མ་ཡིན་པ་ནི་རིགས་པ་མཐོང་ཡང་ཤིན་ཏུ་སྦྱོར་བར་བྱེད་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཁྱད་པར་དུ་ཡོངས་སུ་རྟོག་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "རྒྱུ་དང་བྲལ་བ་མེད་པར་ནི་ཞེས་བྱ་བའོ།",
    "སྐྱེས་པར་བྱ་བའི་ཕྱིར་རོ་སྙམ་དུ་སེམས་པ་ལ།",
    "རྒྱུ་ཡིས་བྱས་པའི་ཞེས་བྱ་བ་སྟེ།",
    "གལ་ཏེ་མེད་པ་ཁོ་ནས་དེ་མེད་པར་འགྱུར་ཞེས་ཅི་ལས་ཡིན།",
    "དེ་ལྟའི་རིགས་པ་དང་ལྡན་པར་འགྱུར་བའོ།",
    "རྒྱུ་འཇིག་པ་ནི་འགལ་བ་ཅན་མེད་ན་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "ད་ལྟར་བའི་ལས་ཀྱང་འབྲས་བུ་བྱུང་ན་ཟད་པ་ཡིན་པའི་ཕྱིར་ལས་ཟད་པས་ནི་སྡུག་བསྔལ་ཐམས་ཅད་ལས་རྣམ་པར་གྲོལ་བར་བརྗོད་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ནི།",
    "དེའི་ཚེ་ལས་གཞན་དང་གཞན་ཡིན་གྱི་སྡུག་བསྔལ་གྲོལ་བ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་ལྟར་རྒྱུའི་ངོ་བོ་ལ་ལོག་པར་རྟོགས་པ་ཡིན་ན།",
    "དེའི་གཉེན་པོ་ཡང་ངེས་པར་གནས་པ་མ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ནི།",
    "མཐོང་བ་ཡང་སྣ་ཚོགས་པར་མཐོང་བ་ཉིད་ཀྱང་སྡུག་བསྔལ་གྱི་རྒྱུ་སྣ་ཚོགས་པ་ལས་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "སྡུག་པ་དང་བྲལ་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་སྟེ་བཟློག་པར་བྱ་བ་ནི་རྒྱུ་ཞེས་བྱ་བ་དང་སྦྱར་རོ།",
    "དེ་ཁོ་ན་ཡང་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་གཞོམ་པ་དང་ཉེ་བར་ལྡོག་པར་བྱེད་པ་ཡིན་ལ།",
    "དེའི་བདག་ཉིད་ཀྱི་སྡུག་བསྔལ་བཟློག་པ་དང་སྡུག་བསྔལ་གཞོམ་པ་ཡིན་པར་བརྗོད་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་བདག་དང་བདག་མ་ཡིན་པའི་རྣམ་པར་དབྱེ་བ་མ་མཐོང་བ་ནི།",
    "འདུས་བྱས་སྤྱོད་ཡུལ་ཅན་ཞེས་བྱ་བ་སྟེ།",
    "ཉེ་བར་ལེན་པར་མི་བྱེད་ཅིང་ཡོངས་སུ་འདོར་བར་བྱེད་དོ།",
    "དེ་ལྟར་རྒྱུའི་ངོ་བོ་ངེས་པར་བརྟགས་པས་དེ་ལས་བཟློག་པས་བདག་མེད་པར་འཛིན་པ་ལ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ཤེས་པར་བྱ་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "འདི་མཐོང་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེའི་རྗེས་སུ་སྤྱོད་པའི་སེམས་ཀྱི་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་ལ་སོགས་པར་གནས་པའི་རྣམ་པར་དབྱེ་བ་ཡིན་ལ།",
    "རྣམ་པར་དབྱེ་བ་བསྡུས་པ་ཡིན་ཏེ།",
    "འགྲེལ་པར་ནི་བདག་མེད་པ་མཐོང་བ་ཞེས་བྱ་བ་ནི་སྤངས་པའི་ཁྱད་པར་ཡོད་ནའོ།",
    "ཡིད་ཀྱི་ཉེས་པར་སྤྱོད་པ་ལ་སོགས་པའོ།",
    "ཡིད་མ་དག་པ་རྟག་ཏུ་མཉམ་པར་གཞག་པ་མེད་པས་ལུང་དུ་མ་བསྟན་པ་སེམས་མངོན་དུ་རྒྱུ་བ་ཡིན་ཏེ།",
    "རྒོལ་བ་འདི་ལ་ཡང་དང་ཡང་དུ་ལན་བཏབ་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཆུ་ཚོད་དང་ཐུན་ཕྱེད་དང་ཐུན་ལ་སོགས་པར་ཉམས་སུ་མྱོང་བ་དྲན་པ་ཡིན་ན།",
    "ཡིད་ཀྱི་དྲན་པའི་ནུས་པ་དང་ལྡན་པ་ཡིན་ན་སྐྱེ་བ་གཞན་ལ་ཉམས་སུ་མྱོང་བ་ཡང་དྲན་པ་ལ་ཡིན་པར་སྲིད་པ་ཡིན་ཏེ།",
    "དེ་ལས་ཀྱང་དེ་ལས་གཞན་པ་ཡིན་པའི་ཕྱིར་སྐྱེ་བ་ཐོག་མ་མེད་པ་ནས་བརྒྱུད་པ་དྲན་པ་ཡིན་ན་དེའི་རྒྱུ་དང་དེའི་འབྲས་བུ་དང་དེའི་ཁྱད་པར་ཡང་དེའི་ཁྱད་པར་སྐྱེད་པར་བྱེད་པ་ཉིད་ལ་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ཉམས་སུ་མྱོང་བ་ལ་རྟོགས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེའི་ཁྱད་པར་ཡང་གཞན་ལ་རྟོགས་པ་ཡིན་ན།",
    "སོ་སོར་ངེས་པ་ནི་ཁྱད་པར་ཅན་གྱི་ཡུལ་ལ་སོགས་པའོ།",
    "དེ་ལྟར་འབྲེལ་པ་རིགས་པ་ཡིན་ན་གཞན་ལ་ཡང་རྗེས་སུ་འཇུག་པ་ཡིན་པར་བསྟན་པས་རིགས་པ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་གཏན་ཚིགས་ཡིན་ལ།",
    "དེ་དགག་པར་བསྟན་པ་ནི།",
    "ཙམ་གྱིས་ནི་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་མཁྱེན་པ་ཉིད་མེད་ཀྱང་ངོ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཡང་ཐབས་ཡོད་པར་བསྟན་པ་ནི།",
    "ཁྱད་པར་གྱི་རྣམ་པ་དང་འབྲེལ་བ་ཡིན་ཡང་རྣམ་པར་རྟོག་པ་ཡིན་པའི་ཕྱིར།",
    "འཇུག་པའི་ཡུལ་ལ་ལྟོས་ནས་ཀྱང་ཁྱད་པར་གྱི་ཡུལ་མངོན་དུ་བྱེད་པ་ཡིན་གྱི་རྗེས་སུ་དཔག་པ་ནི་མ་ཡིན་ཏེ།",
    "འདི་སྤྱིའི་ཡུལ་ཅན་ཡིན་པ་ནི་ཁྱད་པར་མ་མཐོང་བས་བྱས་པ་ཡིན་ཏེ།",
    "རྟགས་ནི་སྤྱིའི་ཡུལ་ཅན་དུ་བརྗོད་པ་ཁྱད་པར་མི་གནས་ཞེས་གསུངས་པས་སོ།",
    "རྣམ་འགྲེལ་མཛད་པ་པོའི་དེ་ལྟ་བུའི་སྒྲོགས་པ་རྣམས་ནི་དོན་དམ་པའི་ལུས་ལ་ཡིན་གྱི་ཐ་སྙད་དུ་གདོན་པར་འོས་པ་ནི་མ་ཡིན་ནོ།",
    "དེ་ལ་ནི་མཐོང་བའམ་ངེས་པ་ཅན་མཐོང་བ་ནི་འཇུག་པའི་ཡུལ་དུ་རྣམ་པར་འཇོག་པར་བྱེད་པ་འདི་ཉིད་རིགས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "སྦྱོར་བར་བྱེད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཁྱད་པར་དང་བཅས་པ་འཁྲུལ་པ་ཅན་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "གཞན་དུ་ན་ཁྱད་པར་དོན་མེད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "མཉམ་པར་གཞག་པ་དང་འགྲེལ་པ་ལས་ནི་རྣམ་པར་འཁྲུགས་པ་ཉིད་དང་བྲལ་བ་ལས་ཏེ།",
    "ལྐོག་གྱུར་མ་ཡིན་མེད་པར་འགྱུར།",
    "ཞེས་བྱ་བ་ནི་ད་ལྟར་བ་ལ་ཡང་ལྐོག་ཏུ་གྱུར་པ་མ་ཡིན་པ་མེད་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟ་བུ་ཉིད་དུ་རྗེས་སུ་དཔག་པར་བྱ་བ་ཉིད་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི།",
    "གལ་ཏེ་མེ་ལ་སོགས་པ་མངོན་དུ་མ་བྱས་པ་ཞེས་བྱ་བའོ།",
    "རྗེས་སུ་དཔག་པ་ལ་ཡང་སྣང་བ་ཁོ་ནར་བརྟག་པར་བྱ་བ་ཡིན་ཏེ།",
    "སྣང་བ་དང་རྣམ་པར་བརྟགས་པ་དག་གཅིག་པ་ཉིད་དུ་ཞེན་པ་ཁོ་ན་རྗེས་སུ་དཔག་པ་ཡིན་པར་བསྟན་ཏོ།",
    "མཐོང་བའི་ཡུལ་མ་ཡིན་པར་ཅིའི་ཕྱིར་མི་འགྱུར་ཞེ་ན།",
    "མི་འགྱུར་བ་ཡིན་པར་བསྟན་པ་ནི་མཐོང་བའི་རྗེས་སུ་འབྲང་བ་ན་ཞེས་བྱ་བའོ།",
    "སྣང་བ་ཉིད་ཁྱབ་བྱེད་དུ་གཟུང་བ་ནི་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་ལ།",
    "མི་སྣང་བ་ཉིད་ཡིན་ན་མིག་ལ་སོགས་པ་གཞན་གྱི་དོན་བྱེད་པ་ཡིན་ཞེས་བྱ་བས་མི་སྣང་བའི་འདུས་པ་ཅན་མ་ཡིན་པ་གཞན་གྱི་དོན་ཉིད་དུ་འགྲུབ་པར་འགྱུར་རོ།",
    "མཐོང་བར་མི་འགྱུར་བ་རྗེས་སུ་དཔག་པར་བྱ་བ་མ་ཡིན་ནམ།",
    "དེ་ལ་ཡང་འབྲེལ་པ་ཅན་ཁོ་ན་མཐོང་བ་ནི་གཞན་དུ་མི་འཐད་པས་མཐོང་བར་འགྱུར་བ་ཁོ་ན་རྗེས་སུ་དཔག་པར་བྱ་བ་ཡིན་ཏེ།",
    "སྣང་བ་ཉིད་ཡོད་པ་ཉིད་ཡིན་ན་འུ་བུ་ཅག་ལ་སོགས་པས་མཐོང་བ་དང་མཐོང་བར་གྱུར་པ་ལ་སོགས་པའི་རྣམ་པར་དབྱེ་བ་ལས་འདས་པ་དང་མ་འོངས་པའི་དབྱེ་བ་མ་ཡིན་ནམ།",
    "མདུན་ན་གནས་པ་མ་ཡིན་པའི་རྣམ་པ་འཛིན་པ་དང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཅིག་ཅར་མ་ཡིན་པར་བྱས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལ་རྫས་དང་བྱ་བ་ལས་ཐ་དད་པས་དེའི་ཁྱད་པར་ཅིག་ཅར་བ་ལ་སོགས་པའི་ཤེས་པས་རྟོགས་པར་བྱ་བ་མ་ཡིན་ནམ།",
    "དེ་ལྟ་ཡིན་ན་དེ་ལྟ་བུའི་དབྱེ་བས་གཅིག་ཏུ་ཡང་ཇི་ལྟར་རྟོགས་པར་འགྱུར།",
    "དེ་ལྟར་བརྡར་བྱས་པའི་ཕྱིར།",
    "བུམ་པ་ལ་སོགས་པའི་ཤེས་གཟུགས་ལ་སོགས་པའི་དབྱིབས་ཀྱི་ཁྱད་པར་ལྟ་བུའོ་ཞེས་བྱ་བའི་དོན་འདི་བསྟན་པ་ནི།",
    "དངོས་པོའི་ཁྱད་པར་ཁོ་ན་དེ་ལྟ་བུའི་བརྡ་ལས་དེ་ལྟར་ཤེས་པའི་ཡུལ་ཡིན་ལ།",
    "མ་ཡིན་ཏེ་རིམ་པ་ནི་ལྷན་ཅིག་པ་དང་ལྷན་ཅིག་པ་མ་ཡིན་པ་ཞེས་བྱ་བ་ལ་ལྷན་ཅིག་པ་དམིགས་པ་མ་ཡིན་པ་ལས་ལྷན་ཅིག་པར་དམིགས་པ་གཞན་ཁོ་ན་ཡིན་ཏེ།",
    "ད་ནི་དུས་གསུམ་དུ་རྣམ་པར་གཞག་པ་ཇི་ལྟར་ཡིན་སྙམ་དུ་སེམས་པ་ལ།",
    "རྣལ་འབྱོར་པ་ལ་ནི་ཐམས་ཅད་སྣང་བཞིན་པ་ཁོ་ན་ཡིན་པའི་ཕྱིར་འདས་པ་ལ་སོགས་པའི་རྣམ་པར་དབྱེ་བ་མེད་པས་དེ་ཇི་ལྟར་རིག་པ་ཡིན་ཞེས་པ་ལས་གཞན་གྱིས་ཞེས་བྱ་བ་སྟེ།",
    "ད་ལྟར་བ་ཉིད་ལ་སོགས་པ་ནི་དུས་ཀྱི་ཁྱད་པར་ཡིན་ལ།",
    "ཤེས་པ་དང་དེའི་ངེས་པར་བྱ་བ་ནི་རྣལ་འབྱོར་པ་རང་ཉིད་ལ་ཡང་འགྱུར་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེའི་ཕྱིར་དེའི་རྣམ་པར་གཞག་པ་བསྟན་པ་ནི།",
    "ད་ནི་མཐོང་བ་པོ་དང་སྣང་བ་དག་ད་ལྟར་བ་ཉིད་མཉམ་པར་གཞག་པའི་གནས་སྐབས་ལ་ཡིན་ལ།",
    "གཞན་ཉིད་དུ་ཞེས་བྱ་བ་ནི་ཕྱོགས་པར་མ་རྒྱས་པར་བྱ་བའི་ཕྱིར་དྲན་པར་བྱེད་པ་ཡིན་ལ།",
    "དེ་ཉིད་རྒྱས་པར་བསྟན་པ་ནི།",
    "དེའི་ཕྱིར་བུ་དང་ལྡན་པའི་མི་རུང་བ་མ་དམིགས་པ་མེད་པ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ལ།",
    "རྣལ་འབྱོར་པས་ནི་རྟགས་ཀྱི་ཁྱད་པར་མ་ལུས་པ་ལ་ངེས་པ་ཅན་ནི་མངོན་སུམ་དང་ལྡན་པ་ཡིན་ལ།",
    "གནོད་པ་ཉིད་མེད་པའི་མཚན་ཉིད་མེད་པར་ངེས་པ་བསྐལ་པ་རྣམས་ཀྱི་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཡང་རིང་པོ་མ་ཡིན་པ་ན་གནས་པས་ཆེས་ཤིན་ཏུ་ཆུང་བ་ལ་སོགས་པའི་ཁྱད་པར་ལ་ཡོད་པའི་དངོས་པོ་རྟོགས་པ་ཡིན་ནོ།",
    "རུང་བའི་ཡུལ་ན་གནས་པ་ཡང་ཐམས་ཅད་ཀྱིས་ནི་མཚུངས་པར་རྟོགས་པ་ནི་མ་ཡིན་ཏེ།",
    "རྗེས་སུ་དཔག་པར་བྱ་བ་ཉིད་ཀྱིས་ཀྱང་ཉེ་བའི་ཕྱིར་མཐོང་བ་ཁོ་ན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཞན་གྱིས་ནི་སྣང་བཞིན་པ་མ་ཡིན་པའི་ཕྱིར་འདས་པ་དང་མ་འོངས་པ་ཡང་བརྗོད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་ཕྱོགས་མི་འདོད་པར་བསྟན་པ་ནི།",
    "འདས་པ་དང་མ་འོངས་པར་ཡང་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཉིད་ནི་ད་ལྟར་བའི་མཚན་ཉིད་ཡིན་པར་བསྟན་པ་ནི།",
    "དཔྱིད་ཀྱི་དུས་ལ་སོགས་པ་རྣམས་ལ་ཡ་དངོས་པོའི་ཁྱད་པར་ཐ་དད་པ་མེད་པའི་ཕྱིར་དུས་འགའ་ཡང་མེད་པར་བསྟན་པ་ནི།",
    "དངོས་པོ་ལས་ནི་ཐ་དད་པར།",
    "དེ་བཞིན་དུ་རབ་ཏུ་སྙི་བའི་ཡན་ལག་མེའི་རྫས་ཀྱི་དཔྱིད་ཀྱི་དུས་ལ་སོགས་པར་བལྟ་བར་བྱའོ།",
    "མ་འོངས་པ་མཐོང་བར་འགྱུར་བ་ཉིད་ཅེས་བྱ་བར་དུས་རྣམ་པར་གནས་པ་ཡིན་ཞེས་བྱ་བའི་རྣམ་པར་དབྱེ་བ་ཡིན་པ་མ་ཡིན་ནམ་སྙམ་དུ་སེམས་པ་ལ།",
    "འདས་པའི་རྒྱུས་སྐྱེད་པའི་འབྲས་བུ་གང་ལས་འདས་པར་འགྱུར་ཞེས་ཟེར་བ་ལ།",
    "རྗེས་སུ་དཔག་པས་བསྐྱེད་པའི་མངོན་སུམ་ནི་རྗེས་སུ་དཔག་པའི་རྟགས་དང་རྟགས་ཅན་འཛིན་པའི་རིམ་པས་རིམ་གྱིས་འཇུག་པར་འགྱུར་ལ།",
    "འཇུག་པར་བྱེད་པར་རྗོད་པར་བྱེད་པ་ཉིད་ཀྱིས་དེ་འཛིན་པར་བྱེད་པ་ཇི་ལྟར་ཡིན་ཏེ།",
    "དེ་ལྟར་བ་བཞིན་དུ་དུས་གཞན་ལ་ཡང་འཇུག་པར་བྱེད་པར་རྗོད་པར་བྱེད་པ་ཉིད་དུ་མ་ཡིན་ན་རིག་བྱེད་ཇི་སྲིད་ཡོད་ཀྱི་བར་དུ་དོན་དང་འབྲེལ་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "སྤྱི་ནི་ཕན་ཚུན་ཐ་དད་པས་མ་རྟོགས་བཞིན་པ་ནི་ཁྱད་པར་རྣམས་ཁོ་ན་ཡིན་ནོ།",
    "རབ་རིབ་ཅན་བཞིན་དུ་སྐྱོན་གཞན་ཡིན་ཞེས་བྱ་བས་བསྟན་པ་ཡིན་པར་བརྗོད་པ་ནི།",
    "བཀྲེས་པ་ལ་སོགས་པས་ཏིང་ངེ་འཛིན་ལ་གནོད་པར་བྱེད་པ་ཅིས་མི་སྲིད་པ་ཡིན་སྙམ་དུ་སེམས་པ་ནི།",
    "གཞན་ལ་ཡང་ཞེས་བྱ་བ་ནི་སྐྱེས་བུས་བྱས་པ་ལ་ཡང་ངོ།",
    "འདི་ལ་ནི་ཞེས་བྱ་བ་ནི་ཐམས་ཅད་མཁྱེན་པ་རྗེས་སུ་དཔག་པ་ལ་རྩ་བ་ཡིན་པའི་ཕྱིར།",
    "འདིས་ནི་འདི་རང་ཉིད་དོན་དང་འབྲེལ་པ་ལ་བག་ཆགས་ནི་གནོད་བྱེད་མ་ཡིན་པར་བསྟན་ལ།",
    "གཞན་དོན་ལ་འཇུག་པ་ཅན་གང་ཡིན་པ་དེའི་གཞན་གྱི་དོན་ལ་གནོད་པར་བྱེད་པའི་ཕྱིར་འདི་ནི་ངེས་པར་སྤང་བར་བྱ་བ་ཁོ་ན་ཡིན་ནོ།",
    "བཀྲེས་པ་ལ་སོགས་པ་རྣམས་ཤིན་ཏུ་མི་སྲིད་པར་བསྟན་པ་ནི།",
    "ལྷ་སོགས་ངོ་བོ་ཡིས་ཞེས་བྱ་བ་ནི་གཟུགས་ན་སྤྱོད་པའི་ལྷ་ཉིད་ཐོབ་པས་སོ།",
    "གཏན་མེད་པར་འགྱུར་ཞེས་བྱ་བ་ནི་གནས་སྐབས་ཀྱི་བཅོམ་ལྡན་འདས་སོ།",
    "འདོད་པ་ལས་བྱུང་བའི་གོམས་པ་ལས་བྱུང་བ་ཉིད་ཡིན་པར་བསྟན་པ་ནི།",
    "བཀྲེས་པ་ལ་སོགས་པའི་སྐྱོན་ལས་ལྡོག་པ་ཁོ་ན་གོམས་པར་རྟོགས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "ཐབས་གོམས་པ་འདི་ཉིད་སྔོན་གྱི་སློབ་དཔོན་རྣམས་ཀྱིས་ཉེ་བར་བཏགས་པས་བསྟན་པར་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་ཉིད་ཐབས་གོམས་པ་ཡིན་པར་ཅི་ལས་ཤེས་ཤེ་ན།",
    "དེ་ཉིད་གྲུབ་པའི་ངོ་བོ་བསྟན་པའི་སྒྲར་གདགས་པར་རུང་བ་ཡིན་གྱི་གཞན་ནི་མ་ཡིན་ནོ།",
    "འགྲེལ་པར་ནི་གསལ་བ་ཁོ་ན་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཙོ་བོ་མ་ཡིན་པར་ཤེས་པ་ཡིན་ནོ།",
    "གྲུབ་པའི་ངོ་བོ་ནི་བདེ་བར་གཤེགས་པ་ཉིད་ཡིན་པ་དེ་ཇི་ལྟ་བུ་ཡིན་པར་བསྟན་པ་ནི།",
    "གཉིས་སུ་མེད་པར་ནི་ཐ་དད་པ་མ་ཡིན་ཏེ།",
    "ཡང་ན་གཅིག་ཅེས་བྱ་བ་རྒྱ་ཆེ་བ་ལ་དམིགས་པས་ཕན་ཚུན་མི་རིགས་པའི་ཕྱིར་དབྱེ་བ་མ་རྟོགས་པར་དགོངས་པས་སོ།",
    "དེ་དེ་ལྟར་ཡིན་ན་གཞན་དམིགས་པར་རིགས་པ་ནི་མི་དམིགས་པ་ཡིན་ནོ།",
    "ཕན་ཚུན་མ་འདྲེས་པར་ཇི་ལྟར་འགྱུར།",
    "མ་ལུས་པ་མ་རྟོགས་པར་གྱུར་པ་ཡིན་གྲང་ན་དེ་དེ་ལྟ་ནི་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཉིས་སུ་མེད་པ་ཉིད་ཕན་ཚུན་རྗེས་སུ་འཇུག་པར་རིག་པ་ཡིན་ནོ།",
    "ཡང་ན་བདག་མེད་པ་མཐོང་ན་ཞེས་བྱ་བ་ནི་བདག་མེད་པ་གཉིས་མངོན་དུ་བྱེད་པ་ནི་འཕགས་པ་ཉན་ཐོས་ལ་སོགས་པར་བརྗོད་པ་ཡིན་ལ།",
    "བདེ་བ་ཐོབ་ན་བྱ་བ་བྱས་པར་འགྱུར་བ་ཡིན་པར་ལྟ་ན་བདེ་བའི་འདུ་ཤེས་ལ་ཉེ་བར་གནས་པ་ནི་ཆགས་པར་བྱ་བའམ།",
    "བདག་ཏུ་ཡང་ཡོད་པའི་ཕྱིར་སུ་ཞིག་བདག་མེད་པ་མཐོང་བའི་རྣམ་པར་གྲོལ་བར་འགྱུར་ཏེ།",
    "སྡུག་བསྔལ་གྱི་འདུ་ཤེས་ཉིད་འདོར་བའི་ཡན་ལག་ལ་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "དེ་ལས་བཟློག་པ་ལ་ཆགས་པ་ཡིན་པའི་ཕྱིར་དེ་ལས་བྱུང་བའི་ལས་ནི་སྐྱེ་བའི་རྒྱུ་ཡིན་པའི་ཕྱིར་སྐྱེ་བ་ཡིན་པར་བརྗོད་དོ།",
    "ཕན་བྱེད་པ་ལ་ལྟོས་ནས་ཆགས་པར་བྱ་བའི་ཀུན་དུ་རྟོག་པ་ཡིན་ལ།",
    "གནོད་པར་བྱེད་པ་ལ་ལྟོས་ནས་ནི་སྡང་བར་བྱ་བ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཆགས་པར་བྱ་བའི་ཀུན་དུ་རྟོག་པ་རྣམས་དང་།",
    "སྡང་བར་བྱ་བ་རྣམས་ཀྱང་བརྫུན་པར་རྟོགས་པའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་བདག་ཏུ་ལྟ་བ་ནི་གཏི་མུག་ཡིན་ནོ།",
    "སོ་སོའི་སྐྱེ་བོ་རྣམས་ལ་ནི་དེ་གཉི་ག་མེད་པའི་ཕྱིར་ཉེས་པ་དང་སྐྱེ་བ་ཡོད་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "བདག་ལ་སོགས་པར་ལྟ་བ་ཁོ་ན་ཆགས་པའི་ངོ་བོ་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "བདག་ཏུ་ལྟ་བའི་ངོ་བོའི་ཆགས་པ་དང་ཕན་འདོགས་པ་དྲན་པ་ཡིན་ན་ཆགས་པར་བྱ་བའི་རྟོག་པས་འདོད་ཆགས་ཡིན།",
    "གཅིག་ལྟོས་པའི་ངོ་བོ་ཡོད་ན་དེ་ལ་ལྟོས་པ་ཉིད་ཁོ་ན་གཞོམ་པར་མི་ནུས་སོ།",
    "དེ་དེ་ལས་ཐ་དད་པར་འགྱུར་ཡང་བྱང་གྲོལ་འདོད་པའི་དོན་གང་ཡིན་པ་རྒྱས་པར་བྱེད་པ་ཡིན།",
    "དེ་ནི་བདག་གོ་ཞེས་བྱས་ནས་ཚོལ་བའི་སྡུག་བསྔལ་ཡིན་ལ།",
    "བདག་མེད་པ་དང་བདག་ཏུ་ལྟ་བ་དག་མཚུངས་པ་ཉིད་སྟོབས་མཚུངས་པ་འགལ་བར་རྣམ་པར་རྟོག་པ་ཡིན་ནོ་སྙམ་དུ་སེམས་པ་ནི།",
    "བདེན་པ་དང་བདེན་པ་མ་ཡིན་པའི་ཡུལ་ཉིད་ཀྱིས་སྟོབས་མཚུངས་པ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེ་ལས་བཟློག་པ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་བདེན་པར་ཡོད་པ་དང་འགལ་བ་ཅན་ཉིད་མེད་པའི་ཕྱིར་རོ།",
    "བསྡུ་བ་བྱས་པ་ཡིན་པའི་ཕྱིར་ཐ་དད་པའི་སྒྲ་དང་ལྷན་ཅིག་པར་རྗེས་སུ་བརྗོད་པ་ཡིན་ནོ།",
    "རང་བཞིན་རྗོད་པར་བྱེད་པ་འདི་ནི་གཏན་ཚིགས་ཀྱི་ཚིག་ཀྱང་ཡིན་ནོ།",
    "བདག་མེད་པར་ལྟ་བ་ནི་བདེན་པ་དང་འགལ་བ་ཅན་ཡིན་ཏེ།",
    "གཙང་སྦྲ་ཅན་ཐོད་པ་ཅན་དུ་གྱུར་པའི་རང་བཞིན་དུ་འབད་པས་ལྡོག་བྱ་ཉིད་ཡིན་ཞེས་ཟེར་བ་ནི།",
    "ཡང་ན་སྨྲ་བ་ནི་འབྲས་བུ་དང་རྒྱུའི་རྣམ་པར་རྟོག་པའི་གོ་བྱེད་ཡིན་ཞེས་ཟེར་བ་ནི།",
    "དེ་ལ་ཡོད་པའི་ཁྱད་པར་གྱི་རྣམ་པ་མཐོང་བ་ཁོ་ན་ལས་འདི་ནི་ལམ་གཞན་ལ་སྦྱོར་བར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི་འདི་ལས་ལྷག་མར་ཡོད་པ་མ་ཡིན་པས་མ་ལུས་པའོ།",
    "གོམས་ཕྱིར་ནི་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གྱི་རྣམ་པའི་ཡུལ་ལས་སོ།",
    "རང་རིག་པར་བྱ་བ་ཉིད་ཀྱིས་རྣམ་པར་རྟོག་པ་གཞན་མེད་པའི་ཕྱིར་རོ།",
    "སྐྱོན་མེད་པར་བསྟན་པའི་ཕྱིར་སྐྱོན་མེད་པར་བསྟན་པ་ནི་འདིར་ནི་ཤེས་པ་མི་གསལ་བར་ཞེས་བྱ་བའོ།",
    "དེ་ལྟར་རྗེས་སུ་དཔག་པ་བཞིན་དུ་མངོན་སུམ་གྱིས་ཀྱང་གཞན་གྱི་དོན་ཐོབ་པར་བསྟན་པ་ནི།",
    "རྟགས་བཞིན་དུ་གཞན་གྱི་རྗེས་སུ་དཔག་པར་བྱ་བའི་ཤེས་པ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "གཞན་དུ་རྗེས་སུ་དཔག་པར་བྱ་བའི་ཚིག་རྗེས་སུ་དཔག་པར་འགྱུར་རོ།",
    "གལ་ཏེ་མངོན་སུམ་གྱི་ཡུལ་གྱི་ཤེས་པ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར།",
    "གཞན་དུ་ནི་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་འདོད་ནས་དེ་ལྟར་ཐ་སྙད་འདོགས་པ་ཡིན་ཏེ།",
    "ནུས་པ་མཚོན་པར་བྱེད་པའི་རྒྱུ་ཚིག་ནི་ཞེས་གསུངས་པའི་ཕྱིར།",
    "དེ་ལྟར་རྣམ་པར་རྟོག་པ་མེད་པའི་ཚིག་ཡོད་པ་མིན་ན་རྣམ་པར་ངེས་པ་མེད་པའི་ཕྱིར་སྨྲ་བ་པོ་ཉིད་མ་ངེས་པ་ཡིན་ནོ།",
    "འདོད་ཆགས་ལ་སོགས་པ་དང་ལྡན་པ་ཉིད་དུ་ནི་འགལ་བ་མེད་པར་སྒྲུབ་པའི་ཕྱིར།",
    "ལྡོག་པ་ལ་ཐེ་ཚོམ་ཟ་བ་ཡིན་པར་ཉེ་བར་བསྡུ་བ་ནི།",
    "འོན་ཀྱང་གཙོ་བོ་དང་ཅིག་ཤོས་ནི་སྒྲུབ་པར་བྱེད་པ་ཉིད་དུ་འཛིན་པ་ཡིན་ནོ།",
    "དྲན་པ་ཡང་བདག་ལ་སོགས་པར་ལྟ་བ་སྤངས་པ་ཡིན་ཡང་།",
    "བདེ་བ་ལ་སོགས་པ་སྒྲུབ་པར་བྱེད་པ་ཉིད་འཛིན་པ་དང་།",
    "དེ་མ་དམིགས་པ་ནི་འདོད་ཆགས་མེད་པ་ལས་མ་དམིགས་པ་བཞིན་དུ་རུང་བ་མ་ཡིན་པའི་ཡུལ་ཅན་ལ་ནི་མེད་པ་སྒྲུབ་པར་བྱེད་པ་མ་ཡིན་ནོ་ཞེས་ཟེར་བ་ནི།",
    "དེ་ཡང་འཇིགས་པ་མེད་ན་རྟག་པ་ཉིད་ཡིན་ན་མི་རྟག་པ་ལ་ཡང་རྒྱུན་དང་ལྡན་པ་སེམས་བཞིན་དུ་རྒྱུད་གཅོད་པར་བྱེད་པའི་ཐབས་མེད་པ་ཡིན་ལ།",
    "འདོད་ཆགས་ལ་སོགས་པ་སྐྱེ་བ་དང་ལྡན་པ་ལ་སོགས་པའི་གཏན་ཚིགས་ཀྱིས་རྣམ་པར་བཅད་པའི་ཕྱིར།",
    "ཡོད་ཀྱང་གྲང་བ་བཞིན་དུ་རྒྱུ་ལ་མི་མཐུན་པའི་ཕྱོགས་ཡོད་ན་རྩ་བ་དང་བཅས་པ་ཆད་པར་འགྱུར་བར་བསྟན་པ་ནི།",
    "གཉེན་པོ་ཡང་རྒྱུའི་ངོ་བོ་ཤེས་ན་དེ་དང་འགལ་བ་ཅན་དུ་མཁས་པས་ཤེས་པ་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི།",
    "འགྲེལ་པར་ནི་རྒྱུ་ཡོད་པ་ནི་རྒྱུ་དང་ལྡན་པ་ཉིད་དུ་བཞེད་དེ།",
    "བདག་མེད་པར་ལྟ་བ་ནི་ཞེས་བྱ་བ་ནི་ཡུལ་ལྷན་ཅིག་བྱེད་པ་ཅན་ཉིད་ཀྱི་ཕྱིར་འཇོམས་པ་མ་ཡིན།",
    "ལོག་པར་རྟོག་པ་མེད་པ་ཉིད་ནི་བདག་མེད་པའི་ཡུལ་ལ་སོགས་པ་དང་།",
    "ཉེ་བར་སྟོན་པར་མི་བྱེད་པའི་ཕྱིར་རོ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་སྨྲ་བ་ཡིན་ན་དེ་ལྟ་ཡིན་གྱི་བཅོམ་ལྡན་འདས་ནི་མ་ཡིན་ཏེ།",
    "ཐོག་མ་དང་ཐ་མ་མེད་པར་རྟོགས་ན་ཕྱིན་ཅི་ལོག་ལ་དགའ་བ་བྱེད་པ་མ་ཡིན་ནོ།",
    "ཕྱིན་ཅི་ལོག་ལ་གནོད་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་རྣམ་པར་འཆད་པ་ནི།",
    "ཐོབ་པར་བྱ་བ་མ་ལུས་པ་བརྙེས་པ་ནི་གཞན་དུ་གསུངས་པ་ལ་དགོས་པ་མེད་དོ།",
    "ཐོབ་པར་བྱ་བ་མ་ཐོབ་པའི་ཆེད་དུ་བདག་ཏུ་ལྟ་བ་ཅན་ནི་གཞན་དུ་ཡང་སྨྲ་བ་ཡིན་ཏེ།",
    "ཐོབ་པར་བྱ་བ་ཐོབ་ཀྱང་འཕགས་པ་ཉན་ཐོས་བཞིན་དུ་དགོས་པ་མེད་པའི་ཕྱིར།",
    "ཐུགས་རྗེ་དང་ལྡན་པ་ནི་གཞན་གྱི་དོན་འབའ་ཞིག་ལ་འཇུག་པར་སྟོན་པར་མཛད་པ་ནི་ཐུགས་བརྩེར་ལྡན་ཕྱིར་ཞེས་བྱ་བ་སྟེ།",
    "ཐམས་ཅད་མཁྱེན་པའི་དོན་དུ་རྩོམ་པ་ནི་རྩོམ་ཀུན་ནོ།",
    "འཕེལ་བའི་ཤུགས་ལས་ཞེས་བྱ་བ་ནི་གོམས་པ་ཕུལ་དུ་བྱུང་བས་རྣམ་པར་རྟོག་པ་མི་མངའ་བས་སྟོན་པ་ཡིན་པར་བརྗོད་དོ།",
    "དེ་འཕེན་པ་ལས་ཡོད་པའི་འབྲས་བུ་མེད་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པའི་ཁྱད་པར་རྣམ་པ་གསུམ་གྱིས་རྣམ་པར་དཔྱད་པར་བྱ་བ་མུ་སྟེགས་དང་།",
    "དེའི་ཕྱིར་དེའི་རྣམ་པ་ཅན་གྱི་ཤེས་པ་དགག་པའི་རྒྱུ་དང་ལྡན་པར་བསྟན་པ་ནི།",
    "འདི་ཡོངས་སུ་གཅོད་པར་བྱེད་པ་ཡང་ཡོངས་སུ་ཤེས་པ་ཁོ་ན་ཡིན་ལ།",
    "དེ་ཡོངས་སུ་མ་ཤེས་ན་དེ་ཉིད་ཤེས་པར་མི་ནུས་སོ་ཞེས་བསྟན་པ་ནི།",
    "སྐྱོབ་པའམ་ཞེས་བྱ་བའི་རྣམ་གྲངས་གཞན་གྱིས་མི་སླུ་བ་ཅན་ཉིད་ཁོ་ནར་བརྟག་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "དེའི་ཕྱིར་ཕྱིན་ཅི་ལོག་དགག་པར་བྱ་བ་ལ་ལྟོས་བྱ་ཉུང་བ་ཡིན་པའི་ཕྱིར་རྟོགས་པ་ཡང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཁྱད་པར་རོ།",
    "དེ་ལས་བཟློག་པར་མཐོང་བ་ནི་བྱང་གྲོལ་གྱི་ཡན་ལག་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པས་བསྟན་པ་ཁོ་ན་མ་ཡིན་ནམ།",
    "སྟོན་པར་བྱེད་པ་ནི་གསལ་བར་བྱེད་པའོ།",
    "བདག་ཏུ་སྨྲ་བ་རྣམས་ཀྱང་ལུས་ལ་སོགས་པ་ལ་བདག་མེད་པར་ལྟ་བ་ཁོ་ན་ཡིན་གྱི་བདག་ཏུ་ལྟ་བ་ནི་མ་ཡིན་ཏེ་འགལ་བ་མེད་པའི་ཕྱིར་རོ་ཞེས་བསྟན་པ་ནི།",
    "བདག་མེད་པ་ལས་ཞེས་བྱ་བ་རྣམ་པ་བཞི་ལ་ཡང་སྡུག་བསྔལ་གྱི་རྣམ་པར་ཐ་སྙད་འདོགས་པ་ནི་གཞན་གྱི་རྣམ་པ་སྡུད་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར།",
    "ངེས་པར་འབྱིན་པའི་རྣམ་པ་རྣམས་སྡུད་པ་ཡིན་ནོ།",
    "དེ་ལས་གསལ་བ་ཁྱབ་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "གཞན་ལས་བྱུང་བ་ནི་དེ་ལས་ཁྱད་པར་དུ་ངེས་པས་མ་ཡིན་ལ།",
    "རྟག་ཏུ་མེད་པར་འགྱུར་རོ།",
    "སྐྱེ་བར་འགལ་བའི་ཕྱིར་ནི་མེད་པའི་ཕྱིར་རྟག་ཏུ་ཡོད་པར་འགྱུར་རོ།",
    "ངོ་བོ་ཉིད་དུ་ཞེས་བྱ་བ་ནི་ས་བོན་ལ་སོགས་པ་ལ་ཡང་མྱུ་གུ་ལ་སོགས་པ་བཞིན་དུ་གོམས་པ་ལ་མི་ལྟོས་པར་སྐྱེ་བ་མ་ཡིན་པ་མ་ཡིན་ནམ།",
    "དེའི་ཕྱིར་གོམས་པ་ལས་བྱུང་བ་ཡིན་གྱི་དངོས་སུ་མ་ཡིན་པར་བསྟན་པ་ནི།",
    "གནོད་པ་ཅན་མེད་པར་རྟག་ཏུ་ཡོད་པའི་ཕྱིར་ཡིན་གྱི།",
    "རྒྱུ་དེ་ཉིད་ཀྱིས་དེ་ཁོ་ན་ཉིད་ནི་འདོད་པ་ལ་གནོད་པ་བྱེད་པར་བསྟན་པ་ནི།",
    "འདུས་བྱས་པའི་སྡུག་བསྔལ་ཉིད་ཀྱང་འདོད་ཆགས་ལ་སོགས་པ་ཡིན་པར་བསྟན་པ་ནི།",
    "བཟློག་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་སྡུག་བསྔལ་འབད་པས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ལ།",
    "དེ་གོམས་པ་མེད་ན་སྡུག་བསྔལ་གྱི་རྒྱུ་བུ་དེ་ཉིད་ལ་བདེ་བ་ཡིན་པར་བསྟན་པ་ནི།",
    "སྡུག་བསྔལ་གཞོམ་པར་འདོད་པས་བདེ་བ་ཉིད་གཞོམ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟ་ཡིན་ན་མ་སྤངས་པའི་བདེ་བ་དང་དེའི་རྒྱུ་ལ་གོམས་པར་བྱ་བ་ཡིན་གྱི་སྡུག་བསྔལ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "རྟོག་པ་དང་ལྡན་པ་ནི་བསྐྱེད་པར་བྱ་བའི་བདེ་བས་སྐྱེས་པའི་སྡུག་བསྔལ་བཟློག་པའི་དོན་དུ་མ་ཡིན་ནོ་ཞེས་འདི་ལ་འཇིག་རྟེན་པའི་དཔེ་བསྟེན་པ་ནི་འདམ་རྫབ་ཅེས་བྱ་བའོ།",
    "འོན་ཏེ་མི་སྣང་བ་ཡང་ཕན་ཚུན་ཉེ་བས་ཕུལ་དུ་བྱུང་བ་སྐྱེད་པར་བྱེད་པས་དེ་ལྟར་སྣང་བ་ཡིན་ནོ་ཞེ་ན།",
    "གནས་སྐབས་ཐམས་ཅད་པ་མ་ཡིན་པའི་ཕྱིར་རྣམ་པར་འབྱེད་པ་ཉམས་པའི་ཕྱིར་མི་འཐད་པ་ཡིན་ནོ།",
    "འཇིག་པའི་རྒྱུ་ཡུལ་སུན་མ་ཕྱུང་ན་ཐེ་ཚོམ་མེད་པར་སྡུག་བསྔལ་གྱི་འདུ་ཤེས་གོམས་པའམ་འཛིན་པ་ཡང་ཡིད་ནི་དཀའ་བ་བྱེད་པ་ཡིན་ནོ།",
    "དེ་ལ་ཉེ་བར་སྟོན་པར་བྱེད་ན་དེས་བསམས་པའི་བདེ་བ་ལ་སྡུག་བསྔལ་དུ་སྟོན་པར་བྱེད་པ་ཡིན་ཏེ།",
    "དེ་ལྟ་ཡིན་ན་ནི་དེ་མ་ཡིན་པ་ལ་དེ་འདི་ཞེས་ཉེ་བར་བསྟན་པ་ཡང་བརྫུན་པར་འགྱུར་རོ།",
    "གཞན་དུ་ཡང་རྗེས་སུ་གནང་བར་བྱ་བ་ཡིན་གྱི་གཞན་ནི་དེས་བྱེད་པ་ཙམ་གྱིས་གསལ་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "ཁྱད་པར་དང་།",
    "འདུ་བ་ལ་སོགས་པ་དགོས་པ་མེད་པ་ཅན་དམ་པ་མ་ཡིན་པའི་རྟོགས་པས་སྦྱར་བའི་འཁྲུགས་པ་ནི་ཅི་ནས་ཀྱང་རྗེས་སུ་གནང་བ་ཐོབ་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཉིད་དང་སད་པའི་དུས་ཀྱི་རྗེས་སུ་འཇུག་པ་ཡིན་པར་རྟོགས་པ་ཡིན་ནོ།",
    "དེ་ཡང་སྒྲུབ་བྱེད་ཀྱི་ཤེས་པས་རྟོགས་པར་བྱེད་པ་མ་ཡིན་ནམ།",
    "གཞན་གྱི་དོན་བྱེད་པ་ཡིན་ན་འདུས་པ་ཅན་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "འདུས་པ་ཅན་ཉིད་ཡིན་ན་དེ་ཡང་གཞན་གྱི་དོན་བྱེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་ཐུག་པ་མེད་པ་ཡིན་ཞིང་སྒྲུབ་བྱེད་མ་ཡིན་པར་འགྱུར་བའི་ཕྱིར་འདུས་པ་ཅན་མ་ཡིན་པ་ནི་བདག་ཡིན་ཏེ་རྣམ་པར་དབྱེ་བ་མེད་པའི་ཕྱིར།",
    "འདུས་པ་ཅན་རྣམ་པར་གཞག་པ་མ་ཡིན་ན་ཇི་ལྟར་འདུས་པ་ཅན་ཡིན་ཞེས་དེ་ཡང་རྟག་པ་ཙམ་ཡིན་ཏེ།",
    "འདུས་པ་མ་ཡིན་པ་གཞན་དམིགས་པ་ལ་སོགས་པའི་ཡོན་ཏན་དང་ལྡན་པ་མ་ལུས་པ་ལ་ཁྱབ་པར་བྱེད་པ་ལ་དོན་དམ་པའི་བདག་ལ་སོགས་པ་དམིགས་པ་མེད་བཞིན་པ་ནི་དེའི་རྟོགས་པས་བདག་ཉིད་ཇི་ལྟར་འཁྲུགས་པར་བྱེད་པར་འགྱུར།",
    "ཇི་ལྟར་འབྲས་བུ་ལས་ཞེས་བྱ་བ་ནི་དེ་བཞིན་དུ་བརྟགས་པའི་རྒྱུ་ཚོགས་པ་ཉིད་ནི་འབྲས་བུ་མ་རྟོགས་པར་བསྟན་པ་ནི།",
    "ཐམས་ཅད་འདོད་ཆགས་མཚུངས་པར་ནི།",
    "རྒྱུ་ནི་འབྲས་བུ་སྐྱེད་པར་བྱེད་པ་དེ་ཉིད་ཀྱིས་གཞན་ཡང་བྱེད་པའི་ཕྱིར་འབྲས་བུ་རྣམས་ལྷན་ཅིག་པར་འགྱུར་བའམ།",
    "འདོད་ཆགས་ཤས་ཆེ་བ་ལ་སོགས་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་ངེས་པར་འགྱུར་རོ་སྙམ་དུ་སེམས་པ་ནི།",
    "ཞེས་བྱ་བ་ནི་འགྲིབ་པ་དང་ཕུལ་དུ་བྱུང་བ་དག་ཀྱང་ཁྱད་པར་དུ་བྱེད་པ་མ་ཡིན་ཏེ།",
    "ཐམས་ཅད་འདོད་ཆགས་ལ་སོགས་པ་ཤིན་ཏུ་ཤས་ཆེ་བ་དང་ལྡན་པར་འགྱུར་བ་ཞིག་ན་འགྱུར་བ་ནི་མ་ཡིན་ནོ།",
    "ཇི་ལྟར་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་སྐྱེད་པར་བྱེད་པའམ།",
    "གཞན་ཡང་རུང་བའི་ཁྱད་པར་རོ།",
    "དེ་ལ་ཡང་ཞེས་བྱ་བ་ནི་ཁྱད་པར་འཁྲུལ་པ་ཉིད་ཡིན་ཏེ།",
    "ཡང་དག་པར་ནི་བསྟན་པ་ཡིན།",
    "ཐམས་ཅད་ཀྱི་རང་བཞིན་ཡིན་ན་དེ་ལ་ཡོད་པའི་ཁྱད་པར་ཡང་ཐམས་ཅད་ཀྱི་རང་བཞིན་ཁོ་ནར་འགྱུར་ཏེ།",
    "འཁྲུལ་པར་མཚུངས་པའི་ཕྱིར་རོ།",
    "ཐམས་ཅད་དུ་ངེས་པ་མཐོང་བ་པས་རྗེས་སུ་དཔག་པའི་ངེས་པའི་ཁྱད་པར་ལྷན་ཅིག་བྱེད་པའི་ཕྱིར་རོ་སྙམ་དུ་སེམས་པ་ནི།",
    "འོན་ཏེ་འབྲས་བུའི་ཁྱད་པར་གྱིས།",
    "དེ་ལྟ་ཡིན་ན་ལྷན་ཅིག་བྱེད་པའི་ཁྱད་པར་དེ་ངེས་པའི་རྒྱུ་གོམས་པ་ཡིན་ཏེ།",
    "རྟོག་པ་གཞན་ཡིན་ན་དུ་བ་ཡང་མེའི་རྒྱུ་ཅན་དུ་མི་འགྲུབ་པར་བསྟན་པ་ནི།",
    "རྒྱུའི་ཁྱད་པར་གྱིས་ཁྱད་པར་དུ་བྱེད་པ་ཉིད་ཀྱིས་འབྲས་བུ་ཉིད་ལ་ཁྱབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "ཁྱད་པར་དང་བྲལ་བས་ཞེས་བྱ་བའོ།",
    "ཁྱབ་པར་བྱེད་པ་མེད་པར་མ་གྲུབ་པ་ཡིན་ཞེས་ཟེར་བ་ནི།",
    "འགྱུར་བ་ཡིས་ཞེས་བྱ་བ་ནི་ཁྱད་པར་གྱིས་སོ།",
    "གལ་ཏེ་ཡང་རྒྱུ་ལ་ཁྱད་པར་ཡོད་ཀྱང་འབྲས་བུ་ཁྱད་པར་ཅན་དུ་མི་འགྱུར་ཏེ།",
    "འདི་མེད་པར་མི་འཐད་པ་ཁོ་ན་ཡིན་པར་བསྟན་པ་ནི།",
    "མ་མཐོང་བའི་ཁྱད་པར་ནི་རྒྱུ་ལ་ཡོད་པའོ།",
    "ཁྱད་པར་གཞན་ནི་དེར་ཞེས་བྱ་བ་སྟེ།",
    "ཁྱད་པར་གཞན་དུ་རྟོགས་པ་དེ་བཞིན་དུ་འདོད་ཆགས་ཀྱི་ཁྱད་པར་ཡང་དེ་ལས་གཞན་པའི་ཁྱད་པར་གྱི་རྒྱུ་ཅན་ཡིན་སྙམ་དུ་སེམས་པ་ནི།",
    "ཁྱད་པར་དེ་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་ཀྱི་རང་བཞིན་ལ་ཡོད་པའོ།",
    "སྣང་བ་ཞེས་བྱ་བ་ནི་སྣང་བའི་ཁྱད་པར་གྱི་བསྐྱེད་བྱའོ།",
    "འདོད་ཆགས་ཀྱི་རང་བཞིན་གྱི་ཁྱད་པར་ཡིན་ན་འདོད་ཆགས་ཀྱི་ཁྱད་པར་ལ་ཁྱད་པར་གཞན་མེད་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཁྱད་པར་ཞེས་བྱ་བའོ།",
    "རྣམ་པར་འགྲེལ་པ་ཉིད་ཀྱང་མ་ཡིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཁྱབ་པར་བྱེད་པ་མེད་པའི་ཕྱིར་མི་རིགས་ཏེ།",
    "གཞན་གྱིས་གེགས་བྱས་ནས་ཞེས་བྱ་བ་ནི།",
    "འོན་ཀྱང་ཁུ་བ་འཕེལ་བའི་རིམ་གྱིས་ཡིན་པར་བསྟན་པ་ནི།"
  ]
}