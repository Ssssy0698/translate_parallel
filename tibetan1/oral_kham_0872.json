    "བཟོ་ལས་ཁང་དེ་ཡག་ཤོས་ཤིག་འདུག་པ་དང་།",
    "ལས་མི་ཡང་མི་གྲངས་༢༨ སྐོར་འདུག་ཅིང་།",
    "ངས་ཀྱང་ཁོང་རང་ལ་སྦས་གསང་ལྟ་བུ་ཅི་ཡང་མ་བྱས།",
    "མེད་རྒྱ་མིང་ཧོ་མ་ཡ་ཟེར་བ་ཞིག་འདུག་པ་དེས་ཕ་ཡུལ་གཅིག་པའི་ཞེན་ཆེན་བོ་བྱེད།",
    "དེ་འཕྲལ་བཀྲ་ཤིས་སྟོབས་རྒྱལ་གྱིས་ཁྱེད་རང་བསམ་འཆར་མེད་ནའང་།",
    "ཕོ་སྐྱེས་གཉིས་བཅས་ཤེས་རྟོགས་བྱུང་བ་མི་གྲངས་༥ འདུག་གང་འཚམས་ནས་ཁོང་རྣམས་མངོན་གསལ་དོད་པོ་བྱས་ཏེ་ཡོང་བར།",
    "དེར་ཡང་སོ་པ་རྣམས་འཚང་འཛུལ་བྱེད་འདུག་པར།",
    "ལྕགས་དམག་པད་མ་བདུད་འདུལ་ཅན་མི་གྲངས་༥ ནས་སྒུག་སྟེ་འདུག་བོད་ལྗོངས་ནས་བཏང་བའི་སྣེ་ལེན་པ་དང་།",
    "ཁྱེད་རང་སྐྲག་མི་དགོས།",
    "ཕྲན་གྱིས་ཟི་ལིང་ནས་ཁྱེད་རང་གོ་འཛོར་འགྲོ་རྒྱུ་ཡིན་ན།",
    "ལུང་པ་ཁུག་དཀྱོག་ལ་སླེབས་ན་ཡག་པོ་འདུག་ལ་དེབ་དགུ་པ།་",
    "བཀའ་བློན་ཡུན་བཀྲས་ནས་འགྲོ་རྒྱུ་བྱས་ན་ཡག་པོ་འདུག་གསུངས་པར།",
    "མཛོད་ཁང་ཞིག་ཡོད་པའི་ནང་རྟེན་གང་ཡང་བཞུགས་མི་འདུག་ཅིང་།",
    "ཁྱིམ་ཚང་དེའི་རྒྱུ་ནོར་དངོས་ཟོག་བསྡུ་ཐེངས་གསུམ་བྱས་འདུག་རྟ་ལུག་ནོར་ཕྱུགས་ཀྱང་དེ་མཚུངས་བསྡུས།",
    "ཚེས་༧ ཉིན་དཔའ་འོག་སྟོད་ཀྱི་ཡུལ་མི་ཕལ་ཆེ་བ་ཐག་རིང་ནས་ཡོང་སྟེ་འདུག་གྲལ་རིམ་ཟེར་བའི་རྣམ་དབྱེ་མི་བྱེད་པ་དང་།",
    "ཕུ་མའི་ཁང་པ་དེ་མུར་སྟོང་པར་འདུག་གསོ་ཚེ་ཚང་དང་།",
    "ཤུལ་ཙམ་མེད་པ་བཟོས་འདུག་པར།",
    "ཁང་ཤུལ་གྱི་གྱང་རོ་ལ་གློ་སྦྱར་གྱིས་སྒོ་དང་སྒེའུ་ཁུང་གཅིག་རང་ཡིན་པའི་ཁང་མིག་ཆུང་ངུ་གཉིས་ཡོད་པ་ཞིག་ཏུ་བསྡད་འདུག་དེ་སྔ་རོང་ཆུ་ཤར་ནུབ་གཉིས་ལ་གཞིས་ཁང་གསུམ་ཡོད་པ་ནས་གཞིས་ཁང་གསར་པའི་འོག་ཁང་ནང་ཡུལ་མིའི་ང་ལུག་འཇུག་ཁང་བྱས་འདུག་པ་ལས།",
    "རྟ་ནོར་སོགས་ནས་ཐ་ན་སྣོད་ཆས་སྟོང་པ་ལྟ་བུ་ཡང་གཞག་མི་འདུག་ཅིང་།",
    "གཞན་རྣམས་ཀྱི་མི་སེར་ཡིན་པ་ཚོས་ཕྲན་བུའི་ཁྱད་པར་གྱི་རྣམ་པ་ཐོན་གྱི་འདུག་ཅིང་།",
    "དེའང་རྒྱ་མིའི་ལས་བྱེད་ཚོས་མཐོང་ན་སྒེར་ཟས་སྒེར་བེད་བྱེད་པའི་གོམས་གཤིས་ངན་པ་ཡལ་མི་འདུག་ཟེར་ནས་ཉེས་པ་གཏོང་བ་དང་།",
    "རྒྱ་མིའི་ལས་བྱེད་ཚོས་མཛེས་མདའ་ཨ་ཚོགས་ཁྲིད་ནས་བྲག་ཕུག་སྒོ་རྩར་སླེབས་ཚར་འདུག་པ་དང་།",
    "འཇིགས་མེད་འཕྲིན་ལས་བཅས་ཤི་བའི་ཤུལ་དུ་ད་ལྟ་མིང་སྲིང་ཆུང་ངུ་བཞི་འདུག་འདི་རྣམས་ཚང་མ་ངའི་ཐབ་ཁུ་སྤུན་མཆེད་ཞེ་གཅིག་ཡིན།",
    "སྟོང་པར་གྱུར་འདུག་འདི་རྣམས་ཕྲན་གྱི་འབྲེལ་ཡོད་ངོ་ཤེས་དམིགས་བསལ་ཅན་ཡིན་པ་ལས།",
    "དགའ་པོའི་ལྟ་ཚུལ་ལ་འགྱུར་བ་ཅི་ཡང་མི་འདུག་ཡུལ་དེར་སྡུག་ཤོས་བྱས་པའི་ལས་བྱེད་གསུམ་ངའི་རྩར་སླེབས་མ་བྱུང་།",
    "རྒྱ་འོག་ཏུ་སྡོད་མི་དགོས་པ་ཞིག་བྱུང་ན་བསམ་པ་དང་ཡོང་ཤག་བྱེད་པ་གཅིག་གྱུར་དུ་འདུག་ཅིང་།",
    "དེར་ཡང་མི་མང་པོ་འདུས་ཏེ་འདུག་དཔལ་སྤུངས་དགོན་གྱི་གྲྭ་ཤག་ཕལ་ཆེ་བ་ལས་བྱེད་དང་།",
    "མི་མང་སྡོད་ཤག་བྱས་ཏེ་འདུག་ཅིང་།",
    "ཁྱེད་རང་གང་ཡིན།",
    "སྐབས་ཕྱག་རོགས་སྐུ་ངོ་རྣམ་པ་མཇལ་བ་དང་འབྲེལ་ཡོད་བོད་རིགས་མི་སྣ་མང་པོ་ཞིག་འདུག་ཅིང་།",
    "འོན་ཀྱང་རང་ཡུལ་གྱི་མི་མང་རྣམས་ཀྱི་དཀའ་སྡུག་ལ་སེམས་ངལ་ཆེན་པོ་ཡོད།",
    "དངུལ་དུང་ཆུང་བ་ཆ་གཅིག་བཅས་ཟློས་གར་བས་བེད་སྤྱོད་བྱེད་ཀྱི་འདུག།",
    "དུས་ཚོད་གཏན་ནས་མི་ཐོབ་པར་དགོངས་འགལ་མེད་པ་ཞེས་བརྗོད་འདུག།",
    "དེ་དགོང་གསོལ་ཚིགས་རྒྱས་འབུལ་སྐབས་མི་གྲངས་༡ སྐོར་ཞིག་འདུག་ཕྲན་གྱིས་བར་མཚམས་ཤིག་ལ།",
    "ཚ་རུ་བཅས་ཉོ་གང་ཐུབ་འདུག་ཅིང་།",
    "གང་འདྲ་འདུག་ཐོག་མར་ཐུབ་བསྟན་ནས་གསུང་ན་འགྲིགས།",
    "དེ་འདྲའི་འགན་ཁུར་མི་དགོས་པར་མི་མང་རང་ཉིད་ནས་འཚོ་བའི་ཐབས་ལམ་རང་འགུལ་གྱི་བྱ་ལམ་ཡོད་པ་ཞིག་དགོངས་པ་བཞེས་རྒྱུ་གལ་ཆེ་བ་མཐོང་།",
    "འོན་ཀྱང་ལྟོགས་ཤི་ལས་ཐར་བ་ཡིན་འདུག་ཅེས་དང་།",
    "བཟོ་གྲྭ་སོགས་གསར་བསྐྲུན་ལ་རྒྱལ་ཁབ་ནས་འགྲོ་གྲོན་ཆེན་པོ་བཏང་ཡོད་བཟོ་འདུག་ཀྱང་ཕུགས་ཕན་ཡོད་པ་ནི།",
    "གྱིས་འཐག་ལས་ཡག་པོ་ཕན་ཐོགས་ཡོད་ངེས་འདུག་ཀྱང་།",
    "ལས་ཀ་བྱེད་མཁན་ལས་མི་མི་འདུག་ལྷོ་ཁ་ནས་གཙང་པོའི་རྒྱུད་ཆུ་ཡུར་ཧ་ཅང་ཆེན་པོ་ཞིག་ལོ་མང་རིང་བཟོས་འདུག་ཀྱང་།",
    "སྤོ་ཐོ་བརྩིགས་ནས་རྩྭ་སྐྱེ་མིན་བརྟག་དཔྱད་མ་བྱས་པར་ལོ་མང་རིང་བཟོས་འདུག་ཀྱང་།",
    "ཤི་ལ་ཉེ་བའི་དཀའ་སྡུག་མྱང་དགོས་བྱུང་བ་སོགས་བརྗོད་པར་དཀའ་བ་བྱུང་འདུག་པ་དང་།",
    "ཚུར་རྒྱ་སྐད་རྒྱག་མཁན་འདུག།",
    "དེང་སང་གསར་བཟོ་བྱེད་མུས་སུ་འདུག་ཀྱང་ཚད་ལྡན་ཡོང་ཐབས་ག་ལ་ཡོད།",
    "རྒྱལ་རྩེ་དཔལ་འཁོར་མཆོད་རྟེན་གོག་པོར་བཞུགས་པའི་ནང་རྟེན་སྐུ་བརྙན་བཅག་དཀྲུམ་བྱས་པ་ཤ་སྟག་འདུག་ཅིང་།",
    "དེ་ནི་རྒྱལ་ཁབ་ཀྱི་གཏན་འཁེལ་བའི་སྲིད་བྱུས་ཤིག་ངོས་འཛིན་བྱེད་མཁན་འདུག་ལས་བྱེད་རྣམས་ནི་སྦྱིན་བདག་ལྟ་བུ་དང་།",
    "འདུག་གནས་ཚུལ་དེ་རིགས་ནི།",
    "རྒྱ་ནག་ནས་རྒྱ་མི་དེ་རིང་འབྱོར་ན་སང་ཉིན་ཟ་འབྲུའི་ཐེམ་ཐོ་ཐོབ་ཀྱི་ཡོད་འདུག་བོད་མི་རིགས་བོད་ནང་དུ་བསྡད་རྒྱུར་ཐེམ་ཐོ་མི་ཐོབ་པ་དང་།",
    "ཤན་ཟེར་ནས་བོད་མིང་མེད་པ་བཟོས་འདུག་དཔེར་ན།",
    "ཁོ་རང་མི་ངར་ཤུགས་ཅན་ཞིག་འདུག་པས་དགོངས་ཚོམ་ཕྲན་བུ་བྱེད་འདུག་གཞན་རྣམས་ཀྱིས་ཉན་པ་ཙམ་ལས་རྣམ་འགྱུར་གང་ཡང་མི་བསྟན།",
    "བཞུགས་ཁྲི་གཟིམ་བསྐྱིལ་ངོ་མ་རང་འཇགས་ཡིན་ལུགས་བརྗོད་འདུག་སྣེ་ལེན་ཚོས་ཞོར་འཕྲོས་ལྟ་བུར།",
    "ང་ཕོད་ཀྱིས་རྒྱ་མིས་ལྟ་སྟངས་ལ་འཛེམ་བག་བྱས་པ་ལོས་ཡིན།",
    "རྡོ་ལེབ་ཆེན་པོས་བཟོས་པ་ཤ་སྟག་འདུག་རྡོ་ལེབ་ཆེན་པོ་དེ་དག་གང་ནས་བྱུང་ཚུལ་དྲིས་པར།",
    "རང་བཞིན་དུ་དད་སྤྲོ་འཕེལ་བ་ཞིག་འདུག་ཀྱང་ཕྱི་དར་དང་།",
    "དེ་ནས་ཚོགས་ཁང་ངོ་མའི་ཕྱི་སྒོ་དེར་ཀྲུའུ་ཞི་ལི་ཤན་ཉན་ཕེབས་འདུག་པར་འཚམས་ཞུས་གྲུབ་རྗེས།",
    "གྲལ་ལ་འཁོད་མ་ཐག་ཕུ་ཀྲུའུ་ཞི་ལི་ཤན་ཉན་ནས་ཧོབ་སྟེ་གང་འདྲ་འདུག་གམ་གསུངས་པར།",
    "ཕྱི་ཚེས་༡༢ ཚེས་༥ ཉིན་པེ་ཅིང་དུ་བོད་ཀྱི་གནས་སྟངས་འགྲེམས་སྟོན་ཁང་ཞིག་འདུག་པ་དེར་ཕྱིན།",
    "ཁྱེད་རང་ལ་ཁག་མེད།",
    "གསུང་བསྒྱུར་དོན་གྲུབ་རྡོ་རྗེ་ལས་སུ་མི་འདུག།",
    "ཁྱེད་རང་ཕྱི་རྒྱལ་དུ་ཕེབས་ལམ་ཡག་པོ་ཡོང་བ་དང་།",
    "ངེད་ནས་ད་ལྟའང་ཉར་ནས་འདུག་ཅེས་ཞུ་རོགས།",
    "བློ་དར་ལགས་ཁོང་གཉིས་སྔོན་དུ་འབྱོར་ནས་ཧོ་ཀྲེལ་ཟ་ཁང་ཆེན་པོ་ཞིག་ཏུ་འདུག་པ་དེར་ཕྱིན།",
    "དེ་དག་ཀྱང་ཞིང་བྲན་མི་མང་ཟེར་བའི་ལག་ཏུ་སྣེ་གཅིག་ཐོབ་པ་མི་འདུག་འཚོ་གོས་ཡག་པོ་དང་།",
    "འབུལ་ཞུ་རྒྱུ་ལོས་ཡིན།",
    "གཅིག་ལ་བདུན་བཅས་བསྡད་འདུག་ཀྱེ་མ་ཀྱེ་ཧུད།",
    "གུང་ཁྲན་གྱི་བཀའ་དྲིན་ཡར་ལང་མི་དམངས་ལ་ཐོབ་འདུག་བསམ་པ་ཡེ་ནས་མ་བྱུང་།",
    "རྒྱལ་བ་ཚེ་དཔག་མེད་ཀྱི་སྐུ་བརྙན་གསར་བཞེངས་ཞུས་འདུག་པར་རྗེས་སུ་ཡི་རང་ཞུ།",
    "ཤ་ནི་ཧོང་ཀོང་ལ་ཡང་འབྱོར་འདུག་ཅིང་།"
  ]
