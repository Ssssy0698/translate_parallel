    "ཕྱི་མའི་བདག་ཕུང་རང་བཞིན་རྟག་ཅིང་།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "བྱམས་པ་འདི་མངོན་སུམ་དུ་འདུག་ན།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་འགོག་བྱེད་ཀྱི་རིགས་པ་དེས།",
    "གདུལ་བྱའི་བློ་ངོར་ཁ་དོག་དང་དབྱིབས་སྣ་ཚོགས་སུ་སྣང་ཡང་རང་བཞིན་དུ་མ་གྲུབ་པ་སྟེ།",
    "༡༣༤སློབ་དཔོན་ཨ་ཙིནྟས་མཛད།",
    "སྣང་ཡང་རང་བཞིན་མེད་པ་ཆུ་ཟླ་བཞིན།",
    "མ་སྐྱེས་པ་ལ་དགའ་བ་འགའ་ཞིག་འདུག།",
    "ནམ་མཁའ་བཞོས་ཤིང་བཞོས་ཤིང་འཐུང་ཞིང་འདུག།",
    "ནམ་མཁའ་བཞོས་ཤིང་བཞོས་ཤིང་འཐུང་ཞིང་འདུག།",
    "ནམ་མཁའ་བཞོས་ཤིང་བཞོས་ཤིང་འཐུང་ཞིང་འདུག།",
    "ནམ་མཁའ་བཞོས་ཤིང་བཞོས་ཤིང་འཐུང་ཞིང་འདུག།",
    "ཚོའི་ཡ་༡༡ པང་ལ་། བདག་ནི་འདུག་སྟེ་ཤི་དང་མ་ཤི་མེད།",
    "ཌོམྦི་གཞུ་བཀང་གཟུང་ནས་རྣམ་པར་འདུག།",
    "རང་བྱུང་རང་བཞིན་གཡོ་བ་མེད།",
    "མཎྜ་༡༢༨༣ས་པའི་འགལ་འདུག་པ།",
    "གང་ཞིག་སྤྲིན་ལྟར་རྟོག་པ་སེལ་ཅིང་རང་བཞིན་དྲི་མ་མེད།",
    "བདེ་བར་སྟན་ལ་འདུག་བྱས་ལ།",
