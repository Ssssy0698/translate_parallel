    "སྒེར་གྱི་གྲྭ་ཤག་སོགས་སྔར་རྒྱུན་ལྟར་མ་ཐོན་དེ་ཐོན་བྱས་སོང་།",
    "ཕྱི་རྒྱལ་གྱི་མི་དང་བོད་ཀྱི་མི་རབས་རྗེས་མར་རྒྱ་མིས་བོད་ལ་སྡུག་པོ་བཟོས་ཚུལ་གྱི་གནའ་གཏམ་ཞིག་ལས་མེད་པ་དེའང་རིང་པོར་མ་ཐོགས་པར་ཡལ་འགྲོ་རྒྱུ་ལས་གཞན་གང་ཡང་ཡོང་གི་མ་རེད་བསམ་སྟེ།",
    "མ་ཚད་བྲག་གཡབ་སྐྱབས་མགོན་བློ་ལྡན་ཤེས་རབ་མཆོག་གིས་ཉེ་ཆར་འཇར་མི་ནི་ནས་ཕྱག་བྲིས་གནང་འབྱོར་ནང་།",
    "བྱམས་མདུན་བྱམས་པ་རང་འཁྲུངས་ཀྱི་འགྲོ་དོན་རྫོགས་ཚར་བ་རེད།",
    "བྱམས་པ་གཏོར་བའི་རྡོ་ཆག་ལྷུ་སྒྲིག་ནས་ཕན་ཐོགས་ཡོད་མ་རེད།",
    "གསར་དུ་གསེར་ཟངས་དང་ཡང་ན་འཇིམ་སྐུ་སོགས་ག་ཚོད་བཞེངས་ཐུབ་ཐུབ་བྱས་ན་ཡག་གི་རེད་གསུང་འདུག་ཀྱང་།",
    "ལས་སྔར་མེད་གསར་བསྐྲུན་བྱེད་ཆོག་གི་མ་རེད་ལབ་ཀྱི་འདུག་གསུང་བྱུང་།",
    "ད་ལྟའི་དགོན་རོ་འདིར་མ་བཞེངས་ན་འགྲིག་གི་མ་རེད།",
    "གང་ཡིན་ཟེར་ན་སྔོན་གྱི་བླ་རབས་མང་པོས་བྱིན་གྱི་རླབས་ཡོད་རེད་སོགས་གསུང་བྱུང་།",
    "རྒྱ་མིར་རོགས་རམ་ཆེན་པོ་བྱས་སོང་བསམ།",
    "ག་ཚོད་བཞེངས་ཐུབ་ན་ས་ཆ་གཞན་ལ་བཞེངས་ནས་དགོན་ཤུལ་ལམ་དགོན་རོ་རང་འཇགས་བཞག་དགོས་རེད་ཟེར་བ་དེ་ཡིན།",
    "རྡོའི་ལྷ་སྐུ་ཆག་རོ་༢ ལྷག་ཙམ་འདུག་པ་དེ་དབྱིན་ཇིས་རྒྱ་གར་བཙན་བཟུང་བྱས་པའི་སྐབས་གཏོར་བ་རེད་ཟེར།",
    "དེ་རྗེས་ཕྲན་གནས་མཆོག་རྡོ་རྗེ་གདན་སོགས་རྒྱ་གར་གྱི་གནས་ཆེན་ཁག་མཇལ་བར་འགྲོ་དུས་ཝ་རྭ་ན་སིར་གནའ་རྫས་འགྲེམས་སྟོན་ཁང་ཞིག་གི་ནང་ལ་རྡོ་ཡིས་བཞེངས་པའི་ལྷ་སྐུ་ཆེ་བར་མི་གཟུགས་ལས་ཆེ་བ་དང་ཆུང་བ་ཁྲུ་གང་ཙམ་རེ་ཡོད་པའི་ཆག་རོ་༢༥༩ འདུག་པ་དེ་དག་སྔ་རབས་ཁ་ཆེའི་རྒྱལ་པོ་ཞིག་གིས་གཏོར་བའི་གནས་ཚུལ་ཤོད་རྒྱུ་འདུགརང་ཉིད་ཀྱི་བསམ་པར་རྒྱ་མིས་བོད་ནང་འདི་ལས་སྡུག་པ་བྱས་ང་ཚོའི་མི་རབས་འདི་རྫོགས་ན་ཡོད་ཀྱང་ད་ལྟ་བསྟན་རྒྱུ་ནི་མེད།",
    "རྒྱ་མིའི་ནག་ཉེས་མེད་པ་ཆགས་ཚར་བ་རེད་བསམ་ནས་འགྱོད་པ་བྱུང་།",
    "ཁྲག་གི་མིག་ཆུ།",
    "སྐབས་དེར་མི་སྟོང་ཕྲག་མང་པོ་ཤི་ཡོད་ཀྱི་རེད།",
    "ལོ་མང་རིང་ང་ཚོའི་རི་ལ་ཡོད་པའི་རི་དྭགས་སྣ་ཚོགས་དང་།",
    "ད་སྐབས་རེ་ཟུང་ཡོད་འདུག་པ་དེ་དག་གསོད་མཁན་ཡིན་པར་ཆ་བཞག་ནས་རྟ་བཞོན་ཏེ་མི་བཅུ་ལྷག་ཙམ་དེར་སོང་བས།",
    "ཁྲག་རྭ་ཆ་རེར་རྒྱ་སྒོར་གསུམ་སྟོང་ནས་དགུ་སྟོང་ཙམ་དང་།",
    "ཐེངས་གཅིག་བྱམས་མདུན་གྲོང་གྱི་དཔོན་པོ་བཀྲིས་ཧྲུའུ་ཅི་དང་ཁྲག་གི་མིག་ཆུ།",
    "ལྷུན་གྲུབ་རྒྱལ་མཚན་ཟེར་བ་དེས་མདེའུ་རེ་ལ་རྒྱ་སྒོར་གཉིས་རེ་བྱས་ནས་བཙོང་སོང་བ་དེ་ནས་ཉོས་སྟེ་ལས་བྱེད་ཚང་མས་གཉིས་གསུམ་མ་བརྒྱབ་པ་བྱུང་མ་སོང་།",
    "ཧྲུའུ་ཅི་ཁོ་རང་གིས་བཞི་རྒྱབ་སོང་།",
    "ངས་གཅིག་བརྒྱབ་པས་འབེན་དེ་དུམ་བུ་ཁ་ཤས་ལ་འཐོར་སོང་།",
    "མི་སེར་ཚང་མ་དགའ་པོ་བྱས་སོང་།",
    "ཞིབ་པར་མ་བལྟས་རྐྱེན་དྲེད་མོང་དང་ནོར་ཏེ་མེ་མདའ་བརྒྱབ་ནས་རྒད་པོ་བསད་པ་རེད།",
    "ཤ་སྟག་རེད།",
    "འདེམ་ཤོག་འཕངས་ཚར་བ་དང་འདེམས་ཤོག་འཕེན་པའི་སྒམ་དེ་རྒྱ་མིའི་ལས་བྱེད་ཚོས་ཁང་པའི་ནང་དུ་ཁྱེར་སོང་།",
    "མི་མང་ཆེ་བའི་བློ་མོས་མེད་བཙོན་གྲོལ་ཐོབ་རྗེས།",
    "བསངས་གསོལ་བྱེད་སྐབས་སེམས་ནང་གང་དྲན་དེ་བརྗོད་ཆོག་གི་མེད་ལ།",
    "མི་མང་པོའི་དཀྱིལ་ནས་རྡོ་རྒྱག་པའི་ཉེན་ཁ་ཡོད་པ་རེད།",
    "རྡོ་རེ་ཟུང་རྒྱག་རེས་བྱེད་པའི་འགོ་ཚུགས་སོང་།",
    "ངའི་བསམ་པར་དེ་རིང་མི་མང་པོ་གསོད་རེས་བྱེད་པ་ཐག་གིས་ཆོད་པས།",
    "འདི་ལ་བར་མི་བྱེད་པའི་སྤོབས་པ་ནི་སུ་ལ་ཡང་མི་འདུག་ལྟད་མོ་བལྟས་ན་འགྲིག་གི་མི་འདུག་བསམ་སྟེ།",
    "མི་ངན་རེ་ཟུང་གི་ཁ་ལ་ཉན་ཁྲག་གི་མིག་ཆུ།",
    "ཚང་མས་ལག་ཏུ་བཟུང་བའི་རྡོ་ཚང་མ་ས་ལ་དབྱུག་ནས་སོ་སོར་བྱེར་སོང་།",
    "ཐེངས་དང་པོའི་གཟིགས་སྐོར་དེ་བྲག་གཡབ་ནང་༡༩༨༢ ལོར་ཕེབས།",
    "༡བོད་བཙན་བྱོལ་གཞུང་གི་ཆབ་སྲིད་མང་གཙོ་ཅན་ལ་བསྒྱུར་བ་དེར་རྗེས་སུ་ཡི་རངས་ཡོད་ཚུལ།",
    "༢ཕྱི་རྒྱལ་དུ་བཞུགས་པའི་བོད་མི་སེར་སྐྱ་ཡོངས་རྫོགས་མཐུན་ལམ་དང་གོང་ས་ཆེན་པོའི་བཀའ་བཞིན་བསྒྲུབས་པའི་རེ་བ།",
    "སེམས་སྐྱོན་ཡོད་པ་དེ་སྡུག་རུ་ཕྱིན་ཏེ་གྲོངས་ནས་བུ་མོ་ཚེ་རིང་གཡང་ཆེན་དྭ་ཕྲུག་ཏུ་ལུས་ཡོད།",
    "བུ་མོ་བསྟན་སྒྲོན།",
    "༡༩༨༢ ལོར་སྨར་ཁམས་གྲོང་ཆུང་ཨ་དཔལ་དང་སྐད་ཆ་བྱུང་བས་ཁོང་གི་དེའི་སྐོར་ལ་དོ་སྣང་ཆེན་པོ་བྱེད་བཞིན་འདུག་པ་མ་ཟད།",
    "༡༩༩༤ སྐབས་ཁོང་གྲོངས་འདུག་དེ་ནས་མཚོ་རྔ་དཔོན་ནོར་བུ་དོན་གྲུབ་དང་ཐུག་པས་ཁོང་བཙོན་གྲོལ་ཐོབ་རྗེས་ཆང་རག་ཚོད་མེད་འཐུང་ནས་ར་བཟི་བྱེད་ཀྱི་ཡོད་སྟབས་ཡུལ་མི་དང་མཐུན་པོ་དེ་ཙམ་ཡོད་ས་མ་རེད།",
    "གོ་འཇོ་བཅས་སུ་སྔ་རྗེས་ཐེངས་རེ་གཉིས་སོང་ཡང་ངའི་རེ་བ་ཡོད་པ་ནང་བཞིན་གྲུབ་ཐུབ་མ་སོང་།",
    "ཨ་ནི་དཔལ་ཆེན་ནི་བོད་རང་བཙན་སླར་གསོའི་དོན་དུ་སེམས་ཤུགས་དང་ལྷག་བསམ་ཡོད་མཁན་ཞིག་རེད།",
    "ཁོང་ཡང་བསྐྱར་རྒྱ་གར་ལ་ཕྱིན་ནས་ཕྱི་ལོ་༢༢ ལོའི་ཟླ་༢ པའི་ནང་བཞུགས་སྒར་རྡ་རམ་ས་ལར་གྲོངས་བ་རེད།",
    "མངའ་བདག་ཆེ་གསུམ་གྱི་རྒྱུ་ནོར་རྩིས་ལེན་བྱེད་པ་ཟེར་བའི་ཁོངས་སུ་དུད་ཚང་ག་ཚོད་སོང་ཡོད།",
    "སྔོན་བྱུང་གི་གནས་ཚུལ་གསལ་པོ་མི་ཤེས་པ་སོགས་དང་།",
    "ཉུང་ཤོས་ལ་རེ་རེ་གཉིས་རེ་ཙམ་ཁ་གྲམ་ནས་ཆགས་ཡོད་སྟབས་ཕན་ཚུན་འགྲོ་འོང་དང་འབྲེལ་འདྲིས་ཉུང་བར་བརྟེན།",
    "ཐ་ན་ས་རྡོ་ཡང་ལུས་ཡོད་པ་མ་རེད།",
    "སྐབས་དེར་འཚོ་བ་ཞན་པས་མི་དམངས་རྣམས་བཀྲེས་ལྟོག་གི་མནར་བ་དང་འཐབ་འཛིང་བཏང་བ་སོགས་སྡུག་བསྔལ་ཚོད་མེད་མྱངས་བ་དང་།",
    "གྱང་བཤིགས་དུས་གྱང་བརྡིབས་པའི་འོག་ཤི་བ་དང་ཁ་ཤས་ལ་རྨས་སྐྱོན་བྱུང་བ་ལྟ་བུ་བྱུང་ཡོད་པ་རེད།",
    "ང་རྡ་རམ་ས་ལར་འབྱོར་རྗེས་འདི་ཕྱོགས་ཡོད་པའི་བྲག་གཡབ་བ་འགའ་ཞིག་གིས་སྔོན་མ་དམག་ས་དང་འཐབ་འཛིང་སོགས་ནས་བསད་པའི་མིང་ཐོ་འགའ་རེ་འབྱོར་བར་བརྟེན་འདིར་གྲངས་ཁ་བཀོད་ན་མང་ཉུང་ཧེ་བག་འགྲོ་གཞི་འདུག་པས་བཀོད་མེད།",
    "རྒྱ་དམར་གྱི་བཙན་འོག་ཏུ་གནས་པའི་བོད་མི་ཚོས་བོད་རང་བཙན་སླར་གསོ་ཡོང་ཐབས་གང་འདྲ་ཞིག་བྱས་ན་དྲག་བསམ་གྱི་ཡོད་པ་རེད།",
    "གང་འདྲ་ཞིག་བྱས་ན་དྲག་བསམ་ནས་བསྡད་ཡོད་པ་རེད།",
    "ཕ་ཡུལ་གྱི་གཞོན་སྐྱེས་མང་པོས་ང་ཚོར་མཚོན་ཆ་རོགས་རམ་བྱེད་མཁན་བྱུང་ན་རྒྱ་མི་ལ་འཛིང་གི་ཡིན་ཟེར་མཁན་འདུག་༡༩༦ ལོ་དམག་ས་ནས་གྲོངས་པའི་ནོར་བུ་ཚེ་རིང་ཞེས་པ་ཁྱིམ་བཙོན་གྲོལ་ཐོབ་རྗེས།",
    "རྗེས་སུ་རྒྱ་མི་ལ་དམག་འཛིང་ན་ངའི་བུ་གཉིས་པ་ཉི་མ་རྒྱལ་མཚན་ལ་དཔའ་བློ་ཁོག་ཡོད་པས་ཁྱེད་ཀྱི་དཔའ་རོགས་ཡོང་ས་ཡོད་ཟེར་ཡང་ཕ་ཡུལ་གྱི་མི་ཁག་གཅིག་གིས་ཞིང་ལས་འབྲོག་ལས་ཡར་རྒྱས་བཏང་བ་དང་ཚོང་ལས་གཉེར་བ།",
    "ཕྱོགས་གཅིག་ནས་ས་ཞིང་གི་ལས་ཀ་དཀའ་ངལ་ཆེན་པོ་ཡོད་ཀྱང་ངས་སྤྱི་དོན་བྱེད་པའི་རྐྱེན་གྱིས་མི་འདོད་པའི་རྣམ་འགྱུར་སྣེ་གཅིག་བསྟན་མ་མྱོང་།",
    "དེ་རྗེས་༡༩༨༨ ལོར་མོ་ཀྲ་བཏང་ནས་ཕ་ཡུལ་བར་བསུ་བར་བྱུང་ཞིང་།",
    "གལ་ཏེ་ད་རེས་འགྲོ་དགོས་ཚེ་ཟླ་བ་རེ་ཟུང་ནས་མར་གཏོང་རྒྱུའི་ཞལ་བཞེས་གནང་རོགས་བཙོན་གྲོལ་ཐོབ་རྗེས།",
    "དམའ་བ་དེར་གཞན་ཞིག་གིས་ཀ་སོགས་སུམ་ཅུ་ནས་ཀློག་བསླབས།",
    "དུས་ཚོད་ནི་བདུན་རེའི་གཟའ་ཕུར་བུའི་དགོང་དྲོ་ཆུ་ཚོད་གཉིས་རེ་བསླབས་ཀྱང་།",
    "ཚོ་ལ་བོད་ཡིག་སྦྱོར་ཀློག་བདུན་ཕྲག་རེའི་ནང་ཆུ་ཚོད་གཉིས་རེ་བསླབས་སོང་ཡང་ཕན་ཐོགས་ཡོད་པ་གང་ཡང་ཤེས་མ་སོང་།",
    "དཔེར་ན་དེ་རིང་ཡིག་འབྲུ་བཞི་ལྔ་ཙམ་བསླབས་ནས་གཟའ་འཁོར་རྗེས་མའི་ཉིན་དེར་རྒྱུགས་ལེན་སྐབས་མང་ཆེ་བས་རྒྱུགས་འཕྲོད་ཀྱི་མེད་པ་རེད།",
    "སྔོན་དུ་བསླབས་པའི་ཡིག་འབྲུ་མ་ན་རོ་མོ་ཞེས་པ་དེ་ལ་རྒན་རྡོ་རྗེ་ཟེར་བ་ཞིག་ཡོད་པ་དེས།",
    "ཕྲུ་གུ་ཚོར་བོད་ཡིག་བསླབས་པ་དེ་དུས་ཚོད་ཕྲོ་བརླགས་བཏང་བ་རེད་ཟེར་བ་སོགས་ཐབས་བརྒྱ་ཇུས་སྟོང་གིས་བོད་ཡིག་ཉམས་ཞན་དུ་གཏོང་གང་ཐུབ་བྱེད་ཀྱི་ཡོད།",
    "བོད་ཡིག་སྦྱོང་རྒྱུའི་སེམས་ཤུགས་ཆུང་རུ་བཏང་ཐབས་བྱས་པ་རེད།",
    "རིག་གཞུང་མེད་པར་བཏང་གི་ཡོད་རེད་ཟེར་བའི་སྐད་ཆ་དང་གཅིག་འབོད་གཅིག་ལེན་བྱས་པ་རང་རེད་ཟེར་ཞིང་།",
    "དགོངས་པ་ཞུ་གི་ཡིན་པས།",
    "སློབ་ཕྲུག་ཕལ་མོ་ཆེ་རང་ལོ་༡༤།",
    "མ་རབས་ཀྱི་གཤིས་ཀ་ཆགས་འགྲོ་གི་ཡོད་པ་རེད།",
    "བོད་ཡིག་ནི་སྡུག་ཏུ་ཕྱིན་སོང་།",
    "རྒྱ་སྐད་བརྒྱབ་སྟེ་དེ་ལ་བོད་སྐད་བསྒྱུར་ཤེས་ཀྱི་མི་འདུག་སོགས་ལབ་ཀྱི་ཡོད་པ་རེད།",
    "གོམས་གཤིས་བཅས་ནུབ་པའི་འོག་མི་རིགས་དེ་གཞན་ཞིག་ཏུ་འགྱུར་ཚར་བ་རེད།",
    "ཁང་གི་འགྲོ་ལམ་གྱང་ངོས་སུ་བོད་རང་བཙན་ཡིན་ཟེར་བ་སོགས་ཀྱི་ཡི་གེ་ནི་ཐེངས་མང་བྲིས་པ་རེད།",
    "སློབ་ཕྲུག་གི་བསྲུང་བྱ་སློབ་ཁང་རེའི་ནང་གྱང་ངོས་ལ་སྦྱར་ཡོད་པའི་ནང་།",
    "ཁྲག་གི་མིག་ཆུ།",
    "བོད་ཆས་གྱོན་པ་ལ་ངོ་སྤྲོད་ཡི་གེ་མེད་ན་གཏོང་གི་མེད་པ་རེད།",
    "དུས་རྒྱུན་བོད་ཆས་གྱོན་མཁན་ངའི་གྲོགས་པོ་བྱམས་པ་ཟེར་བ་དེ་སྒོ་སྲུང་བས་ཐེངས་ཁ་ཤས་ནང་དུ་མ་བཏང་སྟབས་དེ་རྗེས་བོད་ཆས་དོར་ནས་རྒྱ་ཆས་སྤྲས་དགོས་པ་བྱུང་སོང་།",
    "ཚོང་ཁང་ནང་འགྲོ་དུས་རང་གིས་རྒྱ་སྐད་མ་ཤེས་ན་རྒྱ་སྐད་ཤེས་མཁན་རོགས་པར་ཁྲིད་དགོས།",
    "རྒྱ་སྐད་མ་ཤེས་ན་དུད་འགྲོ་དང་ཆ་རེད་ཅེས་རྒྱ་སྐད་ཀྱི་ཐོག་ནས་ཁ་རྡུང་གཏོང་ཀྱང་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "༣ བསྡད་པའི་རྒྱ་མི་ཡིན་ནའང་བོད་སྐད་ཚིག་གཅིག་རྒྱག་གི་མེད་སྟབས།",
    "ཟ་སྐད་འཐུང་སྐད་ཙམ་ཡང་ཤེས་ཀྱི་མེད་པ་རེད།",
    "བོད་པ་རྣམས་ལ་ལས་ཀ་མ་རག་བའི་དཀའ་ངལ་ཆེན་པོ་ཡོད་པ་རེད་ལ་བཙོན་གྲོལ་ཐོབ་རྗེས།",
    "དཔེར་ན་༡༩༩༧ ལོ་བྲག་གཡབ་མོ་སྡོམ་གྲོང་གི་བུ་མོ་ཚེ་རིང་གཡུ་སྒྲོན་རང་ལོ་༢༣ ཡིན་པ་དེ་ན་ནས།",
    "ལམ་སེང་ཉལ་ཁྲིའི་ཐོག་བཞག་ནས་བརྟག་དཔྱད་བྱེད་པ་ལས་ངོ་ཤེས་ལྟག་སྒོ་མེད་ན་ཉལ་ཁྲི་སྟོང་པ་མི་འདུག་བརྗོད་དེ་བར་ཁྱམས་ནང་ཨར་གའི་ཐོག་ཉིན་རེ་ཟུང་ཉལ་དགོས་ཀྱི་ཡོད་སྟབས།",
    "དེ་རང་དུ་ཤི་བའང་ཡོང་གི་ཡོད་པ་རེད།",
    "མི་སེར་ཚོས་དཔོན་པོ་ཚོ་ལ་ཟ་འདྲེ་ཞེས་འབོད་ཀྱི་ཡོད་པ་རེད།",
    "ཕལ་ཆེར་གསུམ་ཡོད་པ་རེད།",
    "དགོང་མོ་བུད་མེད་ལ་བསྐོར་བ་བཅས་གསུམ་དང་།",
    "ཕལ་ཆེར་རང་གི་བུད་མེད་ལ་མི་སྤྱོད་པ་བཅས་གསུམ་པོ་ནི་ཟ་འདྲེ་ཚོའི་ལས་ཀ་རེད་ཅེས་མི་མང་ཚང་མས་བརྗོད་ཀྱི་ཡོད་པ་རེད།",
    "སྔ་དྲོ་རླངས་འཁོར་ལ་སྐོར་ཞེས་པ་དེ་ནི་ལས་ཁྲག་གི་མིག་ཆུ།",
    "སྐབས་འགར་ཟ་ཐེངས་རེར་རྒྱ་སྒོར་ཁྲི་རེ་དང་ཡང་ན་དེ་ལས་མང་བ་བཟའ་བ་དེར་ཟེར།",
    "དགོང་མོ་བུད་མེད་མང་པོ་དང་མཉམ་དུ་རོལ་རྩེད་ཁང་དུ་འགྲོ་བ་དང་།",
    "ཕྱི་ལོ་༡༩༦༡ ལོ་ནས་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་བོད་རྒྱལ་ཁབ་ཆེན་པོའི་ཆབ་སྲིད་མང་གཙོའི་ལམ་ལུགས་སུ་སྒྱུར་གནང་མཛད་ཅིང་།",
    "བཙན་བྱོལ་བོད་གཞུང་དམངས་གཉིས་ཀྱིས་བསྒྱུཌཁ་ཡོད་ལག་ཡོད་ཀྱི་ཕྱག་ལེན་གནང་བར་མ་ཟད་བོད་རང་བཙན་བསྐྱར་གསོ་ཡོང་དུས་བོད་ཆོལ་ཁ་གསུམ་གྱི་མི་འབོར་ས་ཡ་དྲུག་གིས་མང་གཙོའི་འདེམས་བསྐོ་བྱེད་ཕྱོགས་སྐོར་དང་།",
    "སྦྱར་ཡིག་སྦྱར་བ་ནི་བརྒྱ་ཕྲག་མང་པོ་བྱུང་བ་རེད།",
    "སྦྱར་ཡིག་སྦྱོར་མཁན་ལ་བསྙད་དེ་མང་དག་ཅིག་བཙོན་འཇུག་བྱས་སོང་།",
    "གོ་བོ་གཉེར་པ་བློ་བཟང་དཔལ་ལྡན་གཉིས་ཁྲག་གི་མིག་ཆུ།",
    "རོ་ཐག་རིང་ལ་ཁུར་ནས་ས་སྦས་བཏང་བཅུག་པ་རེད།",
    "བོད་དོན་ལ་རྒྱབ་འགལ་བྱེད་པའི་མགྲིན་ཚབ་པ་ཞིག་ཏུ་གྱུར་ཡོད་པ་རེད།",
    "སྤོམ་མདའ་གནམ་ཐང་བརྒྱུད་ནས་བྲག་གཡབ་ནང་རྒྱུག་ཆོག་ཆོག་གི་གྲ་སྒྲིག་ཀྱང་བྱས་ཡོད་པ་རེད།",
    "མཚན་མི་ཉེན་རྟོག་དམག་མི་གཅིག་གི་འཇིང་པར་རྡོ་གཞུས་པ་དང་།",
    "དམག་མིའི་རླངས་འཁོར་སྣ་གདོང་གི་དར་ཆ་མཐུར་དུ་བཀུག་པ།",
    "བྱམས་ཁང་གི་སྐོར་ལམ་གྱང་ལ་སྦྱར་ཚིག་བཞི་ལྔ་ཙམ་སྦྱར་བ་སོགས་བྱས་པས།",
    "ལམ་ནས་མི་མང་གིས་འཕྲོག་རྒྱུའི་སེམས་ཐག་བཅད་པ་དེ།",
    "རང་སྲོག་བློས་བཏང་བ་རེད།",
    "མཁན་མི་ཉུང་བ་ཞིག་ཐོན་པ་རེད།",
    "ཕྲུ་གུ་གསུམ་པོའི་ཁང་པ་ཆུང་ཆུང་ཞིག་གླས་ནས་བསྡད་པས་དགོང་མོ་ཞིག་བཟའ་ཟླ་དང་ཕྲུ་གུ་གཉིས་ཉལ་ཚར་ཙམ་ཡིན།",
    "གནམ་གཤིས་གྲང་མོ་འདུག་པས་ཉལ་ཁྲིའི་ཐོག་ཁོག་སྨད་ཉལ་གཟན་ནང་འཛུལ་བ་དང་།",
    "ནང་སྒོ་ལ་འདན་བུ་དང་ལྕགས་ལུང་སོགས་གང་ཡང་མི་འདུག་ཡིད་ལ་མེད་པ་མགོ་ལ་ལྕགས་ཞྭ་གྱོན་ཞིང་ལག་ཏུ་མེ་མདའ་བཟུང་ནས་སྐམ་པ་མཛུབ་མོས་མནན་ཆོག་ཆོག་བྱེད་མཁན་རྒྱ་དམག་གསུམ་དང་།",
    "རང་གི་བསམ་པར་ཡི་གེ་འདིར་བལྟས་པ་ཡིན་ན།",
    "ཡི་གེ་ཚུར་རུག་ན་ཁོ་ཚོས་དོགས་པ་ཟ་གི་རེད་བསམ་བཙོན་གྲོལ་ཐོབ་རྗེས།",
    "འདིར་བསླེབས་ནས་ག་ཚོད་ཕྱིན་སོང་།",
    "འདིར་ཁ་ཉིན་མོ་བསླེབས་སོང་།",
    "སང་ཉིན་ནས་འགྲུལ་ཐོ་རྒྱོབ་མ་གཏོགས་ཐེངས་རེ་རེ་མེད་ན་སྒོར་ལྔ་བཅུ་རེ་ཆད་པ་ཡོད་རེད་ཟེར།",
    "ལེགས་སོ་སོགས་གུས་གུས་ཞུམ་ཞུམ་བྱས་པས་ཕྱིར་ལོག་སོང་།",
    "སྐབས་དེར་མི་ཕལ་ཆེར་ཁྲག་གི་མིག་ཆུ།",
    "ད་བྱས་མ་སོང་།",
    "རྒྱ་མི་ལ་ཕན་ཐོགས་བསྒྲུབ་མཁན་ཞིག་ཆགས་སོང་།",
    "ད་དུང་མི་ཚེ་ཡུན་རིང་དུ་སྡོད་པའི་ཆེད་དུ་ངའི་སྲོག་ལ་སྒོར་སྟོང་ཕྲག་གཅིག་རེ་གི་མ་རེད་དམ་ལབ་པ་རེད་ཟེར་རྒྱུ་འདུག་ཡང་ཀོ་ཁྲིང་མེའི་སྐེ་ལ་གསུང་མདུད་བཏགས་ཡོད་རེད་ཟེར་མཁན་འདུག་ཀྱང་སྟོད་ཐུང་གི་ནང་ལ་མ་གཏོགས་མཐོང་སར་བཏགས་ཆོག་གི་མེད་སྟབས་བཙོན་གྲོལ་ཐོབ་རྗེས།",
    "ངས་སྐུ་ཐང་འདི་དཔལ་ལྡན་ལྷ་མོ་རེད་ལབ་པ་དང་སྐད་སྒྱུར་བརྒྱུད་ནས་ངའི་ཁྱོ་གས་ཁྲེན་ཏུར་སྒེར་གྱི་ཚོང་ཁང་བཙུགས་ཡོད་རེད།",
    "གུང་ཁྲན་ཏང་མི་རེད།",
    "དེ་འདྲ་ཡིན་དུས་ཐང་ཁ་འདིའི་མདུན་ལ་ཡོལ་བ་ཞིག་རྒྱབ་ནས་གཞན་གྱིས་མི་མཐོང་བ་བྱས་ན་ཡག་གི་རེད་ལབ་པ་དང་།",
    "ཝུན་ཀུང་མེ་ནི་༡༩༩༥ ལོ་དང་༡༩༩༦ ལོ་ཁྲག་གི་མིག་ཆུ།",
    "རང་ཉིད་བཙོན་འཇུག་བྱེད་ངེས་རེད་བསམ་པའི་སྐབས་དེར་ངས་བསམ་བློ་གཉིས་བཏང་བ་ཡིན།",
    "གཙུག་ལག་ཁང་ལ་བསྐོར་བར་འགྲོ་མཁན་ཕྱོགས་གང་ས་ནས་ཡོང་བའི་བོད་མི་དང་ལྷ་སར་རྒྱུན་སྡོད་བཅས་ཀྱི་བོད་མི་མང་ཙམ་འདུག་པ་ལས་དེ་མིན་ལྷ་ས་ཕྱོགས་ཡོངས་སུ་རྒྱ་མི་མང་ཞིང་བོད་པ་ཐ་རེ་ཐོ་རེ་ཙམ་ལས་མི་འདུག་ཉིན་ཞིག་བསངས་ཁང་ནང་བསངས་བཏང་ཁྲག་གི་མིག་ཆུ།",
    "དེ་ནི་ཤེལ་སྒོའི་ནང་གི་མོག་མོག་ལྟ་བུ་རེད།",
    "དེ་ནས་ང་ཤི་ཡང་འགྱོད་པ་སྤུ་ཙམ་མེད་ཟེར་གྱི་ཡོད་པ་རེད།",
    "ཕྱི་ཟླ་༣ ཚེས་༡༨ མཚན་མོ་ང་རང་བཟའ་མི་གཉིས་ནས་བོད་དོན་ཟས་བཅད་ངོ་རྒོལ་བྱེད་མཁན་ལ་གཞིས་ལུས་བོད་མི་ཡོངས་ཀྱིས་རྒྱབ་སྐྱོར་དང་གདུང་སེམས་ཉམས་སྐྱེ་ཡོད་བཅས་བྲིས་པའི་སྦྱར་ཡིག་བར་སྐོར་བྱང་རྒྱུད་གློག་གི་ཀ་བ་ཞིག་ལ་སྦྱར་བ་ཡིན།",
    "༡༩༩༨ ཟླ་༣ པར་ཞིབ་རྩིས་བྱས་པར་གཞིགས་ན་བོད་ཀྱི་ཁྲག་གི་མིག་ཆུ།",
    "ཁང་པ་ཁ་ཤས་ནང་མང་ཤོས་ལྔ་རེ།",
    "ལོ་རེ་ལས་ལོ་རེ་རྒྱ་མི་བོད་དུ་གནས་སྤོ་བྱེད་མཁན་མང་དུ་འགྲོ་བ་དང་དུས་མཚུངས་རྒྱ་མོ་སྨད་ཚོང་མ་ཡང་མང་དུ་འགྲོ་གི་ཡོད་པ་རེད།",
    "ཁོ་ཚོར་བཀག་འགོག་བྱེད་མཁན་མེད་སྟབས་དངོས་དངོས་རྗེན་རྗེན་གྱིས་ཚོང་པ་ཚོང་ཁང་ནང་བསྡད་པ་ལྟར་ལས་ངོ་ཚ་གང་ཡང་འཛེམས་ཀྱི་མེད་པ་རེད།",
    "བལ་ཡུལ་ལ་འགྲོ་དོན་ནི་ཚོང་རོགས་གཅིག་གིས་རྒྱ་སྒོར་ཁྲི་བཅོ་ལྔ་དངུལ་ཁང་ནས་གཡར་བ་དེའི་ཁག་ཐེག་བསྡད་པས།",
    "དངུལ་སྐྱིན་དུས་ཐོག་མ་སྤྲད་པར་བལ་ཡུལ་ལ་སོང་འདུག་པ་དེ་རྩད་གཅོད་བྱེད་དུ་ཡིན་པ་དང་།",
    "བཟའ་ཟླ་ངེད་གཉིས་ཀྱིས་རྒྱ་མིའི་སྒོར་མོ་༡༡ སྤྲད་དགོས་བྱུང་།",
    "ཧོང་ཀོང་གི་རྒྱ་མི་དྲུག་ལྷར་སྡོད་རྒྱའི་ཚོང་པ་གཅིག་ང་ཚོའི་འགོ་ཁྲིད་གཞུང་གི་ལས་བྱེད་གཅིག་བཅས་མི་༡༣ རླངས་འཁོར་ཞིག་གི་ནང་གཏོང་རྒྱུའི་གཏན་འཁེལ་སོང་།",
    "༧གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཇལ་བའི་དུས་སྐབས་ཆུ་ཚོད་སྐར་ཆ་རེ་རེ་བྱས་ནས་མྱུར་བ་ཡོད་པ་རེད་བསམ་པའི་དགའ་བ་དང་།",
    "པོ་ཏ་ལའི་མདུན་ཐང་ཐོག་ནས་ཡོང་དུས་ཐང་འདིའི་ཐོག་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་དུས་ཁྲག་གི་མིག་ཆུ།",
    "དེ་ནུབ་དིང་རིར་མགྲོན་ཁང་ཞིག་གི་ནང་བསྡད།",
    "གཉིད་ཀྱང་སྐྱིད་པོ་ཞིག་ཁུག་མ་སོང་།",
    "སྲིན་བལ་གྱི་ཉལ་གཟན་རེ།",
    "ཀམ་པ་ལི་རེ་རེ་ལས་མེད་ཀྱང་མི་ཁུར་གླས་ཏེ་རྒྱ་སྒོར་༢ སྤྲོད་དགོས་བྱུང་།",
    "རི་དྭགས་གཅན་གཟན་སོགས་བསད་ནས་སྟོངས་ལ་ཉེ་བ་བཟོས་སོང་།",
    "ཕྱི་དྲོ་བལ་ཡུལ་གྱི་རྒྱལ་ས་ཀ་ཐ་མན་ཌཱར་སླེབས་ནས་མགྲོན་ཁང་ཞིག་གི་ནང་བསྡད།",
    "བལ་ཡུལ་དུ་གནས་སྡོད་བྲག་གཡབ་པ་བློ་དར་དང་འཕྲད་དེ་ཁོ་རང་གི་སྡོད་ཁང་དུ་ཁྲིད་ནས་བལ་ཡུལ་དུ་ཉིན་བཅུ་ལྷག་ཙམ་སྡོད་རིང་འཚོ་བ་དང་།",
    "བལ་ཡུལ་བོད་ཀྱི་དོན་གཅོད་བཀྲ་ཤིས་རྣམ་རྒྱལ་མདུན་བབཅར་ཁྲག་གི་མིག་ཆུ།",
    "ཁོང་གིས་རོགས་ཕན་གང་ལེགས་གནང་བ་དང་།",
    "བདེ་སྲུང་དྲུང་ཆེ་མཆོག་གིས་ཁྱེད་ཕ་མ་གཉིས་བདེ་འབྱོར་ཐུབ་པར་དགའ་བསུ་དང་།",
    "མགྱོགས་མྱུར་སླེབས་ཀྱི་རེད་བསམ་ནས་ཡི་གེ་ཁོང་ལ་སྤྲད་དེ་ང་རང་ལྡི་ལིར་འབྱོར་སྐབས་ཟས་བཅད་ངོ་རྒོལ་བྱེད་མཁན་མི་དྲུག་དེ་དང་ངོ་འཕྲད་བྱས་ཆོག་པ་འདུག་བསམ།",
    "ཨ་མི་རི་ཁ་ནས་ཡིན་པའི་མི་སྒེར་པ་ཞིག་གིས།",
    "ཕར་ཕྱོགས་ཁང་པའི་ནང་སོང་ནས་སྐུ་ངོ་ལ་ཞུས་ཟེར་བས།",
    "རྒྱལ་ས་ལྡི་ལིར་བོད་མི་དྲུག་གིས་མ་ཤི་བར་ཟས་བཅད་ངོ་རྒོལ་བྱེད་མཁན་རྣམས་དང་ཐུག་པར་འགྲོ་དགོས་པས།",
    "སྐུ་ངོ་དེས་ཁྱོད་ཟས་བཅད་ངོ་རྒོལ་བྱེད་སར་ཕྱིན་ནས་ག་རེ་བྱེད་ཀ།",
    "རོགས་རམ་གནང་སྐྱོང་ཐུགས་རྗེ་ཆེ་ཞུས་མ་ཐག་ཁྱོད་དེར་འགྲོ་བར་ལག་འཁྱེར་ཡོད་དམ་ཟེར།",
    "འདིར་འགྲོ་ཆོག་པའི་རྒྱ་ནག་གཞུང་གི་ལག་འཁྱེར་ཡོད་དམ་ཟེར།",
    "ངས་ཁོང་ཚོས་རྒྱ་ནག་གཞུང་ལ་ངོ་རྒོལ་བྱེད་པ་ཡིན་པས།",
    "རྒྱ་ནག་གིས་དེར་འགྲོ་ཆོག་པའི་ལག་འཁྱེར་སྤྲོད་སྲིད་དམ།",
    "ཁོང་གིས།",
    "ཁྱོད་རང་བོད་ནས་རྒྱ་གར་ལ་གཉེན་འཕྲད་སོགས་ལ་འགྲོ་ཆོག་པའི་ལག་འཁྱེར་ཡོད་དམ་ཟེར་བ་ཡིན།",
    "རྒྱ་གར་གྱི་ཉེན་རྟོག་དམག་མང་པོ་ཡོད་རེད།",
    "ཟས་བཅད་ངོ་རྒོལ་བྱེད་མཁན་དང་ངོ་འཕྲད་ཁྱུག་ཙམ་ཡོང་རེ་ཡོད་པས་གང་དྲག་ཞུས་ཀྱང་།",
    "སྣེ་ལེན་ཁང་གི་མི་རེད་ཟེར་ནས་ང་ཚོ་ལ་རྙོག་དྲ་ལུང་པ་གང་བཟོ་གི་རེད་སོགས་གསུངས་བྱུང་།",
    "སྐབས་དེར་ངའི་བཟའ་ཟླ་སྣེ་ལེན་ཁང་གི་ཐོག་ཁར་ལས་བྱེད་ཅིག་གི་མདུན་དུ་འབྱོར་ཐོ་བཀོད་སར་སོང་ནས་མར་སླེབས་བྱུང་།",
    "བོད་ནང་ལས་ཀ་གང་བྱས་སོགས་འདྲི་གི་འདུག་པས།",
    "གླ་ཕོགས་ག་ཚོད་ཡོད་རེད་ཅེས་དྲིས་བྱུང་།",
    "རྒྱ་མིའི་སྒོར་༨ ལྷག་ཙམ་ཡོད་རེད་ཅེས་ཞུ་སྐབས།",
    "བོད་ནང་མ་བསྡད་པར་རྒྱ་གར་ལ་ཡོང་སྟེ་ག་རེ་བྱེད་དགོས་རེད།",
    "སྣེ་ལེན་ཁང་གི་ལས་བྱེད་ཅིག་གི་ངོས་ནས་བོད་པ་རྒྱ་གར་དུ་བཙན་བྱོལ་ལ་མང་པོ་འདི་འདྲ་ཡོང་གི་ཡོད་ནའང་།",
    "དེ་ཚོ་ཡོང་དགོས་དོན་ག་རེ་ཡིན་མིན་ཤེས་ཀྱི་མེད་པ་འདྲ།",
    "ཡིན་ནའང་གཞིས་ལུས་བོད་མི་ཚོས་སྲོག་ཉེན་ལ་མ་འཛེམས་པར་རང་གི་རྒྱལ་ཁབ་སླར་གསོ་ཡོང་ཆེད་བྱ་སྤྱོད་སྤེལ་བཞིན་པ་དང་།",
    "དམིགས་ཡུལ་དེ་གྲུབ་པའི་རེ་བ་གཙོ་བོ་དེ་བཙན་བྱོལ་བོད་གཞུང་དམངས་གཉིས་ལ་བཅོལ་ཏེ་བྱ་ཁུ་བྱུག་གིས་གནམ་ཆུ་སྒུག་པའི་དཔེ་ལྟར་བྱེད་བཞིན་ཡོད་ཁྲག་གི་མིག་ཆུ།",
    "དེ་ཉིན་གཟའ་ཉི་མ་སོང་སྟབས།",
    "ང་ཚོ་གསར་དུ་འབྱོར་བ་རྣམས་ལ་འབྱོར་ཐོ་བཀོད་སོང་།",
    "ཁྱེད་ཀྱི་མཚན་ལ་ག་རེ་ཞུ་གི་ཡོད་ཅེས་གསུངས་བྱུང་བས།",
    "དེ་འཕྲལ་ཁ་པར་བརྒྱུད་སྙན་སེང་ཞུས་སོང་།",
    "དེ་ནས་བདེ་སྲུང་གི་ཟུང་འབྲེལ་དྲུང་ཆེ་ཨ་ཕོ་དགའ་བཙན་བྱོལ།",
    "དགའ་བདེ་སྲུང་གི་མཚན་ཐོག་ནས་འཚམས་འདྲི་དང་དངོས་པོའི་གནང་སྦྱིན་ཆེད་ཕེབས་པར།",
    "འཕྲད་མ་ཐག་རྒྱུན་རིང་ཁ་བྲལ་སོང་བའི་ཕ་མ་གཅིག་པའི་སྤུན་འཕྲད་པའམ།",
    "ཚེས་༢༢ ཉིན་སྐུ་སྒེར་ཡིག་ཚང་ནས་སང་ཉིན་ཞོགས་པ་ཆུ་ཚོད་༩ ཐོག་གོང་ས་སྐྱབས་མགོན་ཆེན་པོའི་གཟིམ་ཆུང་མཇལ་ཁ་ཞུ་རྒྱུ་ཐུགས་གཏན་འཁེལ་སོང་ཞེས་བཀའ་བརྡ་གནང་བྱུང་བར་བརྗོད་དུ་མི་ལངས་པའི་དགའ་བ་བྱུང་།",
    "དེ་ཉིན་བོད་ཀྱི་གཞོན་ནུ་ཚོགས་པའི་དྲུང་གཞོན་དབྱངས་ཅན་སྒྲོལ་དཀར་ལགས་དང་གླེང་མོལ་བྱུང་ཞིང་།",
    "ཡི་གེ་ལག་སོན་བྱུང་མི་འདུག་ཁོང་གིས་ཁྱེད་ལྡི་ལིར་ཟས་བཅད་ངོ་རྒོལ་བྱེད་མཁན་དང་ངོ་འཕྲད་དུ་བསྐྱོད་ཚེ།",
    "སང་ཉིན་ང་ཚོས་མོ་ཊ་དང་རོགས་ཁྲག་གི་མིག་ཆུ།",
    "པ་གཏོང་གི་ཡིན་ཞེས་གསུངས་བྱུང་ཡང་།",
    "ལྡི་ལིར་འགྲོ་ཁོམ་བྱུང་མ་སོང་ཞེས་ཞུས་པ་ཡིན།",
    "གོང་ས་ཆེན་པོ་མཆོག་ཞལ་འཛུམ་པའི་ངང་ནས་བཀའ་འདྲི་གནང་བ་སོགས་རྒྱུན་རིང་ཙམ་སོང་མཚམས།",
    "དེ་བཞིན་གོང་ས་མཆོག་གི་ན་བཟའ་དང་།",
    "དེ་སྔོན་ཁྱེད་རང་གིས་དཀའ་ངལ་ཞེ་དྲག་བརྒྱབ་ཡོད་པ་དང་།",
    "སྡུག་བསྔལ་ཞེ་དྲག་མྱངས་ཡོད་པ་རེད།",
    "ད་ནི་ད་ལྟ་རང་ཤི་ཡང་འགྱོད་པ་མེད་བསམ་པ་བྱུང་སོང་།",
    "དེ་ནས་སྔོན་མནར་གཅོད་མྱངས་པའི་བཙོན་རོགས་རྒྱ་གར་དུ་རང་གི་སྔོན་དུ་སླེབས་པ་བརྒྱད་དགུ་ཙམ་འདུག་པ་དེ་ཚོ་དང་ཐུག་དུས།",
    "ཁོང་ཚོས་རང་ལ་རོགས་ཕན་གང་ལེགས་གནང་བྱུང་བ་དང་།",
    "གཞུང་འབྲེལ་མ་ཡིན་པའི་ཕྱི་རྒྱལ་མི་སྣ་འགའ་ཞིག་ལ་གླེང་མོལ་བྱུང་བ་བཅས་སོ།",
    "པའི་སྔགས་རིམ་ཆེན་མོའི་བཀའ་ཁྲིད།",
    "དཔལ་མགོན་འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱིས་མཛད་པའི་བཤེས་པའི་སྤྲིངས་ཡིག་གི་བཀའ་ཁྲིད།",
    "ལྷ་མོ་དང་།",
    "བོད་སྐྱོང་ལྷ་སྲུང་གི་འཕྲིན་སྐུལ་བཅས་ཀྱི་ལྗགས་ལུང་།",
    "རང་ལོ་ཉི་ཤུ་རྩ་གཅིག་ནས་ད་ལྟ་རང་ལོ་དྲུག་ཅུ་རེ་གསུམ་གྱི་བར་དུ་དཀའ་ཉེན་ཆེ་བའི་དམག་འཁྲུག་གི་དུས་རིམ།",
    "མགོན་པོ་གང་ཉིད་ཀྱིས་འགྲོ་བ་ཡོངས་ལ་བྱམས་བརྩེའི་གཟིགས་པ་ནམ་ཡང་མི་འདོར་བའི་ཐུགས་རྗེའི་སྐྱབས་འོག་ཏུ་ཚུད་དེ།",
    "གཞན་ཡང་དུས་ཆེན་དང་མཛད་སྒོ་ཁག་གི་སྐབས་སུ་གོང་ས་མཆོག་གིས་ཟབ་རྒྱས་ཀྱི་བཀའ་སློབ་བཀའ་དྲིན་གནང་བར་ཉན་རྒྱུའི་གོ་སྐབས་ཐེངས་མང་བྱུང་བ་ནི།",
    "ང་ཚོ་འགྱེལ་ས་ནས་ལངས་ཐུབ་པའི་ཆེད་ཡིན།",
    "ཁྱོད་ཚོས་ལུས་སྲོག་ལོངས་སྤྱོད་དང་བཅས་པ་བློས་བཏང་ནས་རྒྱ་མི་དང་འཐབ་འཛིངས་བྱས་པ་དེ་ཡང་བསྟན་སྲིད་ཀྱི་ཆེད་དུ་རེད།",
    "ང་ཚོའི་དམིགས་ཡུལ་གཅིག་པ་རེད་བཅས་དང་།",
    "ཡང་བོད་ཕྱི་ནང་དུ་༡༩༥༩ གོང་གི་ཆབ་སྲིད་བཙོན་པ་དང་།",
    "དེ་བཞིན་བོད་མི་ཕོ་མོ་མང་པོ་ཞིག་གིས་རང་སྲོག་བློས་གཏོང་གིས་རྒྱ་དམག་ལ་འཐབ་འཛིང་བྱས་ཡོད་པ་རེད།",
    "དེ་ནི་བསྟན་སྲིད་ཀྱི་ཆེད་དུ་འཐབ་རྩོད་བྱས་པ་ཞིག་རེད།",
    "བའི་ཀུན་སློང་དང་བསམ་བློ་གཏོང་དགོས་པ་རེད།",
    "དེ་སྔོན་གྱི་སེམས་ཤུགས་དེ་མུ་མཐུད་ནས་བྱ་བ་མཐའ་སྐྱེལ་བྱེད་དགོས་པ་རེད།",
    "མི་མང་པོ་ཞིག་ནི་གྲོངས་ཚར་བ་རེད།",
    "ད་ལྟ་ཉུང་ཤས་ཤིག་ཡོད་པ་དེའང་ནམ་ཞིག་ཤི་རྒྱུ་རེད།",
    "བོད་གཞུང་གིས་དབུ་ཁྲིད་ཚགས་ཚུད་པོ་ཡོད་པ་འདི་ལས་བྱུང་བ་མ་གཏོགས།",
    "ངས་ཁྱེད་རང་དམག་ནང་ཞུགས་ནས་ཕན་ཐོགས་ག་རེ་ཡོད་རེད་ལབ་པས།",
    "རྒྱ་མིས་ང་ཚོའི་ཕ་ཡུལ་བཙན་བཟུང་བྱས་ནས་བོད་མི་མང་པོ་བསད་ཡོད་པ་དེར་དགྲ་ཤ་ལེན་གྱི་ཡིན་ཟེར།",
    "ང་རང་གིས་བསམ་པར།",
    "རྒྱལ་དར་ཞེས་པ་དེ་ནི་མི་རིགས་གཅིག་དང་རྒྱལ་ཁབ་གཅིག་གི་ངོ་བོ་མཚོན་བྱེད་ཅིག་ཡིན་སྟབས།",
    "མི་རེ་གཉིས་ཀྱིས་བཟོ་བཅོས་བརྒྱབ་ཆོག་པ་ཞིག་ག་ལ་ཡིན།",
    "ཡང་ཉུང་ཤས་ཀྱིས་ཆོལ་ཁའི་བར་ལ་འཐེན་འཁྱེར་བྱེད་པའི་བསམ་སྤྱོད་དོར་མི་འདུག་དེ་ནི་རང་རེ་མི་རབས་རྒན་པ་ཚོས་མ་བྱུང་བ་རེད་སྙམ།",
    "རྒྱ་གར་ལ་བཙན་བྱོལ་ལ་སླེབས་ནས་ད་བར་མི་ལོ་༤ ལྷག་ཙམ་ཕྱིན་ཚར་བ་རེད།",
    "དེའི་ཐད་གཞོན་སྐྱེས་ཚོའི་ནང་འཐེན་འཁྱེར་གྱི་བསམ་བློ་ཡོད་པ་ཆེས་ཉུང་ཉུང་རེད།",
    "བྱེད་ཆེད་འཐབ་རྩོད་རྒྱུན་འཁྱོངས་གནང་བ་དང་།",
    "ང་ཚོ་སྤྱི་སྒེར་ཚོགས་པ་གང་འདྲ་ཞིག་ཡིན་རུང་ལངས་ཕྱོགས་དང་།",
    "ཡང་རྒྱ་བལ་འབྲུག་གསུམ་ནང་ཡོད་པའི་བཙན་བྱོལ་བོད་མི་མང་དག་ཅིག་གིས་ཨ་མེ་རི་ཀ་སོགས་ཕྱི་ཡི་རྒྱལ་ཁབ་ཁག་ནང་གནས་སྡོད་བྱེད་པར་འགྲོ་རྒྱུའི་ཆེད་དུ་ཐབས་ཤེས་གང་ཡོད་བཏོན་པ་དང་།",
    "འགྲོ་སོང་གང་དགོས་བཏང་ནས་མ་ཐར་དེ་ཐར་བྱེད་བྱེད་པ་ཕྱི་རྒྱལ་དུ་འགྲོ་རྒྱུ་བྱུང་ན་མི་ཚེ་གཅིག་གི་མདུན་ལམ་ཆེ་ཤོས་ཡིན་པ་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "ཕྱི་རྒྱལ་དུ་འགྲོ་ཆོག་པའི་ལག་འཁྱེར་ཐོབ་མ་ཐག་རི་དྭགས་རྙི་ནས་ཐར་བ་ནང་བཞིན་དགའ་སྤྲོའི་ངང་བསྐྱོད་བཞིནཡོད་པ་བཅས་ལ་ལྟ་དུས་བོད་རང་བཙན་སླར་གསོ་ཡོང་བའི་རེ་ཐག་ཟད་ནས་རང་དང་རང་གི་བུ་རྒྱུད་ཀྱི་ཕུགས་རེ་དེགཞན་ཡུལ་ལ་བཅོལ་བ་ལྟ་བུ་ཞིག་མཐོང་གི་འདུག་འོན་ཀྱང་ཕྱི་རྒྱལ་ལ་འགྲོ་ཚད་ཚང་མ་དེ་ལྟར་རེད་ལབ་པ་ནི་ག་ལ་ཡིན།",
    "ཕྱི་རྒྱལ་ཡུལ་གྲུ་ཁག་ནང་ཡོད་པའི་བོད་མི་ཚོས་དེ་སྔོན་དང་ད་ལྟའི་བར་བོད་བསྟན་སྲིད་ཀྱི་ཆེད་དུ་ནུས་པ་ཆེན་པོ་འདོན་བཞིན་ཡོད་པ་རེད།",
    "བོད་མིའི་ནང་ནས་བོད་ཡིག་སྦྱངས་ནས་ག་རེ་བྱེད་དགོས་རེད།",
    "ཕན་ཐོགས་གང་ཡང་ཡོད་པ་མ་རེད།",
    "ད་དུང་མ་འོངས་པར་བོད་ཡིག་མི་དགོས་པ་ཆགས་འགྲོ་གི་རེད་ཟེར་མཁན་འདུག་ཡང་བོད་མི་རྒན་པ་ཞིག་ལ་ཁྱེད་བོད་ནས་ཚུར་ག་དུས་ཕེབས་པ་ཡིན་ནམ་ཞེས་འདྲི་དུས།",
    "ཁོང་གིས་༡༩༥༩ ལོར་ང་ལོ་བརྒྱད་ལ་སོན་དུས་ཕ་མ་དང་མཉམ་དུ་རྒྱ་གར་ལ་སྐྱབས་བཅོལ་དུ་ཡོང་བ་ཡིན་ཟེར།",
    "ཡང་ཁྱེད་ཀྱི་འཁྲུངས་ཡུལ་ག་ནས་རེད་ཅེས་འདྲི་དུས།",
    "བཙན་བྱོལ་བོད་གཞུང་གིས་ལོ་༤ ལྷག་རིང་གི་ཕྱག་ལས་གནང་འི་གྲུབ་འབྲས་ནི་ཧ་ལས་དགོས་པ་བྱུང་འདུག་སྙམ།",
    "དེ་ལ་ཡིད་སྨོན་དང་གུས་བཀུར་ཞུ་གི་ཡོད།",
    "༡༩༩༩ ལོའི་དགུན་ཁར་རང་གཞུང་གིས་རྒྱལ་རྩེ་ནས་ཡིན་པ་རིག་འཛིན་ལགས་དང་།",
    "ཉུས་ཤོས་ལ་༢ ཙམ་འདུག་ད་དུང་རྒྱ་གར་དང་བལ་ཡུལ་བཅས་ཁྲག་གི་མིག་ཆུ།",
    "ས་གནས་བུད་མེད་ཚོགས་པ།",
    "༢༨༢ ཕེབས་ཡོད་པ་རེད།",
    "མཇུག་བསྡོམས་མཛད་སྒོའི་སྐུ་མགྲོན་གཙོ་བོར་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ཆིབས་བསྒྱུར་གྱིས་བཀའ་སློབ་ཟབ་རྒྱས་སྩལ་སོང་།",
    "༣གོང་ས་སྐྱབས་མགོན་ཆེན་པོས་རྒྱ་ཆེ་གུ་ཡངས་དགོངས་བཞེས་ཀྱིས་བོད་རྒྱ་གཉིས་ཀྱི་དཀའ་རྙོག་ཞི་བའི་གྲོས་མོལ་གྱི་ལམ་ནས་སེལ་རྒྱུའི་འབད་བརྩོན་གནང་རྒྱུའི་དགོངས་བཞེས་གནང་སྟེ།",
    "ངས་བོད་ནང་གི་རྒྱ་ཆེའི་བོད་མི་ཚོའི་ཚབ་ཞུས་ཏེ་རེ་འདུན་ཞུ་རྒྱུར།",
    "ཁ་བཏགས་སྩལ་བའི་ཐོག་ཕྲན་ལ་ཕྱག་ཟུང་ནས་འཁྱུད་པ་མཛད་སྐབས་ཚོགས་རྭ་ཡོངས་ནས་ཐལ་མོའི་བརྡེབས་སྒྲ་གྲགས་སོང་།",
    "འདི་ནི་མི་ཚེ་གཅིག་གི་རིང་བརྗེད་པར་དཀའ་བ་ཞིག་རེད་བསམ་པ་བྱུང་།",
    "སྔར་ལས་ལྷག་པའི་ལས་འགུལ་སྤེལ་རྒྱུའི་དམ་བཅའ་བཞག་ཡོད་པ་རེད།",
    "སྐད་འབོད་བྱེད་མཁན་མང་ཚོགས་ཀྱི་ཐོག་ལ་ཕྲན་ནས་༡༩༤༩ ལོ་ནས་ད་བར་བོད་རྒྱལ་ཁབ་དང་རང་བཙན་གྱི་དོན་དུ་དཔའ་བོ་ཕོ་མོ་ཁྲི་སྟོང་མང་པོས་ལུས་སྲོག་བློས་གཏོང་བྱས་ཡོད་པ་དང་།",
    "རྒྱ་མིའི་ཆབ་སྲིད་བཙོན་ཟུར་གྲགས་ཅན་ཝས་ཅི་ཧྲིང་སོགས་དང་ཆབ་སྲིད་སྐོར་གྱི་གླེང་མོལ་བྱེད་པའི་དུས་སྐབས་བྱུང་།",
    "ད་དུང་ཡང་ལས་གནས་འདི་ཁྲག་གི་མིག་ཆུ།",
    "ངས་མོ་བཏབ་ཆོག་ཅེས་བཀའ་གནང་བ་ལྟར།",
    "ཕྱག་མོར་གཟིགས་ནས་གཤགས་བཅོས་བྱས་ན་ཧ་ཅང་གི་བཟང་པོ་འདུག་ཅེས་བཀའ་བཟང་ཕེབས་པར་བརྟེན།",
    "གོང་གསལ་བདེ་སྲུང་ལས་བྱེད་དང་བཅས་ལྡི་ལི་བོད་གཞུང་སྐུ་ཚབ་དོན་གཅོད་ཁང་དུ་ཕྱིན་པས་དོན་གཅོད་ཁང་གིས་རོགས་རམ་གནང་བ་བརྒྱུད།",
    "ཉེ་འགྲམ་དུ་ཡང་ཐོག་བརྩེགས་ཅན་གྱི་ཁང་པ་ཞིག་འདུག་པ་དེའི་ནང་གཤགས་བཅོས་བྱེད་པར་འགྲོ་དགོས་ཀྱི་འདུག་ཁྲག་གི་མིག་ཆུ།",
    "ལག་གཉིས་ཐལ་མོ་སྦྱར་ཏེ།",
    "གཉིད་ཆག་པ་བཅས་ཀྱི་དཀའ་ངལ་ཆེན་པོ་འཕྲད་སོང་།",
    "རྗེས་སུ་ཟླ་བ་གསུམ་གྱི་མཚམས་སླར་ཡང་བརྟག་ཞིབ་ཏུ་སྐྱོད་སྐབས་ལྡི་ལི་སྐུ་ཚབ་དོན་གཅོད་ཁང་གི་རོགས་རམ་འོག་ལས་བྱེད་ཨུ་རྒྱན་ལགས་བཏང་བ་དང་།",
    "དཀྱིལ་དུ་ནོར་བུ་དགའ་འཁྱིལ་མེ་རིས་བསྐོར་བ་ལེན་འབར་གྱི་ཚུལ་དུ་བཀོད་པ་དེ་ནི་བྲག་གཡབ་ཆེ་ཚང་དང་ཆུང་ཚང་རྣམ་པ་གཉིས་དང་ཐུན་མོང་མ་ཡིན་པའི་སྲུང་མ་བསེ་ཡེ་ཁྲབ་ཅན་མཚོནཏེ་དགའ་འཁྱིལ་དཀར་པོ་དེ་སྤྱན་རས་གཟིགས་ཀྱི་སྤྲུལ་པ་བློ་ལྡན་ཤེས་རབ་དང་དགའ་འཁྱིལ་དམར་སེར་དེ་འཇམ་དཔལ་དབྱངས་ཀྱི་སྤྲུལ་པ་ལེགས་པའི་ཤེས་རབ་མཚོན་པ་ཡིན།",
    "དེའི་ནང་ནས་ས་ཁྱོན་ཆེ་ལ་མི་འབོར་མང་བ་དེ་ཞིང་པའམ་ཡུལ་པ་ཡིན་སྟབས།",
    "རྗེས་སུ་བྲག་མི་ཡོན་ཏན་ཅན་གྱིས་དགོངས་ཚུལ་དང་མང་ཚོགས་ཀྱི་བློ་མོས་ཡོད་པ་སྙིགས་དོར་བཅུད་ལེན་གྱིས་དར་ཆ་བཟོ་སྲིད་པས་དེ་ལ་ཕྲན་ནས་བརྩི་བཀུར་ཞུ་རྒྱུ་ཡིན།",
    "དེ་སྔོན་༧རྒྱལ་མཆོག་སྐུ་ཕྲེང་གསུམ་ཙམ་བྲག་གཡབ་ནང་ཞབས་སོར་འཁོད་ཡོད་པ་རེད།",
    "ཁྱོད་ཚོས་ཁྲི་འདི་བཞིན་རྒྱག་དགོས་དོན་གང་ཡིན་ནམ་གསུང་པ་ལ།",
    "རྡོ་ཡང་རྩེགས་ཀྱི་ཁྲི་དེ་༡༩༥༩ ལོའི་བར་མཇལ་རྒྱུ་ཡོད་པ་རེད།",
    "ཡོང་ན་བསམ་པའི་རྒྱུན་དུ་རེ་བ་ཡོད་པ་ལྟར།",
    "དེ་ཡིན་དུས་མི་མང་པོ་ལ་ཕན་ཐོགས་ཀྱི་རེད།",
    "ཁྲག་གི་མིག་ཆུ།",
    "རྒྱ་དམར་གྱིས་རང་རེ་བོད་ཀྱི་རྒྱལ་ཁབ་བཙན་བཟུང་བྱས་ནས་ད་བར་༡༩༩༩ལོ་ལྔ་བཅུ་ཕྱིན་པ་རེད།",
    "དེ་ནི་མི་ཞིག་ལ་ཆ་མཚོན་ན་ཧ་ལས་དགོས་པའི་རྒྱུན་རིང་པོ་རེད།",
    "རྒྱལ་ཁབ་དང་མི་རིགས་ཀྱི་འཐབ་རྩོད་ལ་ཆ་མཚོན་ན་རྒྱུན་རིང་པོ་གང་ཡང་མ་རེད།",
    "༡༩༤༩ སྐབས་ཀྱི་རྒྱལ་སྲུང་དམག་འཁྲུག་རྒྱག་མཁན་མི་རབས་དང་པོ་དེ་རྫོགས་ཟིན་པ་རེད།",
    "༡༩༥༩ སྐབས་ཀྱི་བཙན་རྒོལ་རྒྱལ་སྐྱོབ་དམག་འཁྲུག་རྒྱག་མཁན་མི་རབས་གཉིས་པ་དེ་རྫོགས་གྲབས་ཡོད་པ་རེད།",
    "བོད་མི་རིགས་ཀྱི་ངོ་བོ་བཅས་འཛམ་གླིང་ཐོག་མེད་པ་བཟོ་རྒྱུའི་ཐབས་ངན་བརྩམས་བཞིན་ཡོད་པ་རེད།",
    "དེར་བརྟེན་ང་ཚོས་ཛ་དྲག་གི་ལས་འགུལ་སྤེལ་བའི་དུས་ལ་བབས་པར་མ་ཟད་ཕྱི་ཉེན་ཡོད་པ་རེད།",
    "ཁྲག་གི་མིག་ཆུ།",
    "འཛམ་གླིང་ཐོག་གི་མང་གཙོའི་རྒྱལ་ཁབ་ཁོངས་སུ།",
    "མང་གཙོའི་དོན་དུ་མི་བརྒྱ་སྟོང་མང་པོའི་ཟུངས་ཁྲག་བཏོན་ནས་རྒྱུན་རིང་འཐབ་རྩོད་མ་བྱས་པ་གཅིག་ཀྱང་མེད་པ་རེད།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོས་དབུས་བཙན་བྱོལ་བོད་གཞུང་གིས་ལམ་སྟོན་འོག་བོད་མི་ཚང་མ་རྡོག་རྩ་གཅིག་སྒྲིལ་གྱིས་མདུན་བསྐྱོད་བྱེད་དགོས།",
    "རང་གིས་འབད་བརྩོན་བྱས་ན་རང་བཙན་ལེན་ཐུབ།",
    "དེ་མ་ཟ་བར་རྗེས་སུ་ཁ་ལག་གང་འདོད་ཟ་རྒྱུ་ཡོང་བར་ཤོག་ཟེར་བ་དང་གཅིག་མཚུངས་རེད།",
    "ངའི་སྐད་ཆ་དེ་རྣམས་ད་ལྟ་རེ་འདུན་ཡིན།",
    "ང་རང་ལོ་༦༤ ལ་སོན་སོང་།"
  ]
