    "དེ་ནས་ད་ལྟ་བར་ལོ་༢ ཏག་ཏག་ཕྱིན་པ་རེད།",
    "ཆབ་སྲིད་ཀྱི་བཙོན་པ་མིན་པ་རྣམས་གློད་མ་སོང་།",
    "ཞེས་གསུངས་པ་ལྟར་ང་ཚོ་བཙོན་པ་རྣམས་རྒྱ་དམར་གྱི་མནར་གཅོད་འོག་ལོ་མང་རིང་ལུས་སེམས་གཉིས་ཀར་སྡུག་བསྔལ་བརྗོད་དུ་མི་ལང་པ་མྱངས་ཀྱང་།",
    "ལོ་འདིའི་ནང་གཞིས་བྱེས་མཉམ་འཛོམས་ཡོང་རྒྱུ་རེད།",
    "ད་རེས་བཙོན་གྲོལ་ཐོབ་པ་འདི་ཡང་གོང་ས་སྐྱབས་མགོན་ཆེན་པོའི་བཀའ་དྲིན་ཡིན་པར་ཚང་མས་ཡིད་ཆེས་བྱེད་ཀྱི་ཡོད་ལ།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོའི་ཐབས་ཁྲག་གི་མིག་ཆུ།",
    "ལས་མིའི་ནང་ཡོད་པ་རྣམས་ལ་བཙོན་དཀར་ཞེས་བརྗོད་ཀྱི་ཡོད་པ་ལྟར་བཙོན་པར་བརྩིས་ནའང་མ་འགྲིག་པ་གང་ཡང་ཡོད་པ་མ་རེད།",
    "འཇིབ་ལྷམ་སེར་པོ་རེ་སྤྲད་བྱུང་བས་དེ་ནས་བཟུང་བཙོན་གོས་ནག་པོ་དེ་གྱོན་མི་དགོས་པ་བྱུང་སོང་།",
    "ཁྲག་གི་མིག་ཆུ།",
    "དགོང་མོ་ཞིང་བྲན་ལམ་ལུགས་ཞེས་པའི་གློག་བརྙན་བྱམས་པ་ཞེས་པ་བོད་ཀྱི་མངའ་བདག་ཆེས་གསུམ་གྱིས་མི་དམངས་ལ་སྡུག་པོ་སྤྲད་པའི་སྐོར་བསྟན་སོང་།",
    "ཟླ་རེའི་གླ་ཕོགས་མཐོ་ཤོས་ལ་སྒོར་༤༥དང་དམའ་ཤོས་ལ་སྒོར་༢༤ ཙམ་རེ་སྤྲད།",
    "མི་ལྔ་ཕྱི་ཟླ་༡ ཚེས་༡ ཉན་ལྷ་སར་སླེབས་ཡོད་པ་རེད།",
    "ཕྱི་རྒྱལ་གྱི་རོགས་རམ་འོག་གཞིས་བྱེས་མཉམ་འབྲེལ་གྱིས་རྒྱ་དམར་ལ་ཞི་དྲག་གཉིས་ཐད་ནས་འཐབ་འཛིང་བྱེད་དགོས་པའི་རེ་བསྐུལ་ཡི་གེ་གསུམ་བྲིས་ནས་མི་གཅིག་ཕྱི་སྒོའི་འགྲམ་ལ་བསྡད་ནས་ལྟ་སྐོར་བ་དང་ལས་བྱེད་ཚོའི་བར་ལ་འཛུལ་ནས་སྤྲད་ཐབས་དང་།",
    "ཁོང་ཚོས་ཀྱང་བོད་མི་དང་ཐུག་དུས་སྐད་ཆ་དང་པོ་དེ།",
    "ཉིན་བཅུ་ཙམ་ནས་ང་སྤྲ་མོར་འགྲོ་རྒྱུའི་ཆོག་མཆན་སྤྲད་བྱུང་།",
    "སྤྲ་མོ་ནས་གནས་ཚུལ་ཤེས་རྟོགས་བྱུང་བ་ལྟར་ན།",
    "དེར་ལྟ་སྐོར་བ་ཞིག་གིས་བོད་རྙིང་པའི་བཀས་བཀོད་རྒྱུན་འཛིན་གྱི་ལམ་ལུགས་དེ་མཇུག་བསྒྲིལ་ཚར་བ་རེད།",
    "སྐུའི་གཅེན་པོ་བློ་བཟང་བསམ་གཏན་ལགས་ནས་དུས་ཚོད་དེ་འདྲ་ཞིག་ལ་རང་བཙན་ཐོབ་ཀྱི་རེད་ཟེར་བ་མི་སུས་ཀྱང་ཁ་ཚོན་གཅོད་ཐུབ་ཀྱི་མ་རེད།",
    "རང་རེ་ཚང་མ་དམིགས་ཡུལ་གཅིག་པ་རེད།",
    "ང་ཚོ་༡༩༥༩ ལོར་རྒྱ་གར་ལ་བྲོས་པ་དང་།",
    "ཁྱེད་ཚོས་དཔའ་ངར་མཐར་མང་སྣེ་ཉུང་གི་ཞུམ་མེད་ཀྱིས་རྒྱ་དམག་ལ་འཐབ་པ་དང་།",
    "ཡིན་ནའང་ང་ཚོས་འཛམ་གླིང་འགྱུར་འགྲོས་དང་།",
    "བོད་ལ་རྒྱབ་སྐྱོར་བྱེད་མཁན་རྒྱལ་ཁབ་ག་ཚོད་ཡོད་རེད་དྲིས་པས།",
    "ཁོང་གིས་བོད་ལ་རྒྱབ་སྐྱོར་བྱེད་མཁན་རྒྱལ་ཁབ་མང་པོ་ཡོད་རེད།",
    "རྒྱལ་ཁབ་མང་པོ་ཞིག་གིས་བོད་ཀྱི་གནས་སྟངས་ངོ་མ་ཇི་ཡིན་མ་ཤེས་པ།",
    "དེ་རྗེས་གོ་ཐོས་ལྟར་ན་ལྟ་སྐོར་བ་མི་གྲངས་ལྔ་པོ་སྤྲ་མོ་ནས་དཔག་ཤོད་བརྒྱུད་བྲག་གཡབ་དཀྱིལ་དམ་ལ་ཕེབས་འབྱོར་སྐབས་དཀྱིལ་དམ་ཆུས་ཀྱི་གཙོ་བོའི་དཔོན་པོ་ཧྲུའུ་ཅི་དབྱང་ཞོ་མིན་གཙོས་པས་རྒྱ་བོད་ལས་བྱེད་ཁ་ཤས་ཀྱིས་སྣེ་ཁྲིད་ནས་མི་སེར་ནང་ལྟ་སྐོར་བྱས་པའི་སྐབས་བཙོན་གྲོལ་ཐོབ་རྗེས།",
    "དེར་ལོ་༤ ཞེ་གྲངས་ཙམ་ཡིན་པའི་བྱམས་ལྷ་མ་ཞེས་པའི་བུད་མེད་དེས་གུང་ཁྲན་ཏང་དང་མའོ་ཀྲུའུ་ཞིའི་བཀའ་དྲིན་གྱིས་ང་ཚོ་སྐྱིད་པོ་ཡོད།",
    "ཁྱེད་རང་ཚོ་ཕྱི་རྒྱལ་ལ་འཁྱམས་ནས་མ་སྡོད།",
    "སྐྱིད་པོ་བྱུང་ཡོད་ས་རེད།",
    "ཡར་རྒྱས་བྱུང་འདུག་བརྗོད་པ་རེད།",
    "མཐའ་མ་ཕུད་པ་རེད།",
    "ཆུས་བཅས་ལ་དགོངས་པ་ཞུས་ནས་བཙོན་ཟུར་ལས་མི་རྣམས་ཀྱི་བུ་དང་བུ་མོ་ཁ་ཤས་ཕ་ཐུག་པར་བྱུང་ཡང་ཐོག་མ་འཕྲད་དུས་ཕན་ཚུན་ངོ་མི་ཤེས་པ་དང་།",
    "ཉུང་ཤས་ཡོད་ནའང་ལོ་ཆེ་བའི་ཡོང་མ་ཐུབ་པའང་ཡོད་འདུག་ཡིན་ནའང་བཟའ་ཟླ་དང་སྤུན་མཆེད་ཉུང་ངུ་ཞིག་ཡོད་མཁན་འདུག་ནང་མི་ཁ་ཁྲག་གི་མིག་ཆུ།",
    "རོགས་པ་ཞིག་འཚོལ་ཆོག་པ་ཞུས་སྐབས་ཚོགས་གཙོས་འགྲིག་གི་མ་རེད།",
    "མོ་སྡོམ་གྲོང་ནས་མི་ཞིག་རྐང་ཐང་སོང་ན་ཟླ་ཆུ་གཙང་འགྲམ་ལ་ཆུ་ཚོད་༣ ཙམ་འགོར་གྱི་ཡོད་པ་རེད།",
    "སྐབས་དེར་བུ་ཆུང་བ་དེ་རང་ལོ་༡༡ དང་བུ་མོ་རང་ལོ་༡༤ ལས་སོན་མེད།",
    "སྤྱིར་བཏང་བྱས་ན་ཕུང་པོ་རྟ་ཁལ་ལ་འགེལ་བ་དང་མིའི་རྒྱབ་ལ་ཁུར་དགོས་བྱུང་ཚེ་པུས་མོ་དང་མགོ་ཐུག་པ་བསྐུག་དགོས་ཀྱི་ཡོད་འདུག་ཀྱང་།",
    "སྐབས་དེར་ནང་ལ་རྩམ་པ་ཕྲན་བུ་ལས་མེད་ཀྱང་ཡུངས་མ་ཡོད་ནའང་དེ་ཉིན་འཁྱེར་རྒྱུའི་བསམ་བློ་མ་འཁོར་སྟབས་ཟས་གང་ཡང་མེད་པ་མུན་རུབ་རྗེས་ནང་ལ་འབྱོར་ཐུབ་ཙམ་བྱུང་བ་རེད།",
    "༡༩༧༩ ལོར་བཙོན་གྲོལ་ཐོབ་དུས་རང་ལོ་༤༢ ལ་སླེབས་སོང་།",
    "ད་ནི་རྒས་པའི་དུས་ཚིགས་རེད།",
