    "ད་ལན་འདི་ལ་སོས་པའི་དུས་རང་ཅང་འོང་ངམ་སྙམ་ནས་ཡོད་ཙ་ན།",
    "འདི་དག་དུས་སུ་བརྟགས་པ་ཡིས།",
    "སྤྱན་ཕར་གཅེར་ཚུར་གཅེར་ཞིག་མཛད་ནས་རྩ་ན་ལྷམ་ཞིག་འདུག་པ་དེ་ཙེན་གྱིས་བླངས་ནས།",
    "ཇོ་བོ་ནཱ་རོ་པའི་མནལ་འདྲོགས་པར་འདུག།",
    "ཁ་ཆེའི་ཡུལ་དུ་བཞུགས་ནས་ཡོད་ཙ་ན།",
    "ནུབ་ཀྱི་སྒོ་བསྲུང་བ་ཤེས་རབ་འབྱུང་གནས་སྦས་པའི་བློ་གྲོས་བཞུགས་པར་འདུག་པ་ལ།",
    "བྱང་ཕྱོགས་ཀྱི་སྒོ་བསྲུང་བ་མེད་པས་ཇོ་བོ་ནཱ་རོ་པ་གདན་འདྲེན་དུ་བྱུང་བར་འདུག་པ་ལ།",
    "ནཱ་རོ་པའི་ཐུགས་དགོངས་ལ་འདི་རང་ལ་ཅི་བྲོའམ་སྙམ་ནས་མྱང་ཙ་ན་ཤིན་ཏུ་ཡང་ཞིམ་པར་རོ་མཆོག་བཅུད་དང་ལྡན་པ་ཞིག་འདུག་སྐད།",
    "ཇོ་བོ་ནཱ་རོ་པའི་གསུང་ནས་ཁྱེད་རང་རྣམས་གྲོང་ནས་ཕ་ཚད་ཐག་རིང་བའི་བར་གླང་པོ་ཆེ་ཤོང་བའི་ཁུང་བུ་ཞིག་བྲུས་ཤིག་གསུངས།",
    "ཇོ་བོ་ནཱ་རོ་པའི་སྐུ་ལུས་ལ་དབུགས་ནར་གྱིས་བྱུང་བྱ་བར་འདུག་པས།",
    "མི་དང་འཐབ་པ་གདུག་རྩུབ་ཤིན་ཏུ་ཆེ་བ་ཞིག་ཡོད་པར་འདུག་པས།",
    "ང་རང་ཡང་ལྷོ་བལ་གྱི་ཕྱོགས་སུ་འགྲོ་བ་དྲག་སྙམ་དུ་ཐུགས་ཀྱིས་དགོངས་ནས་ཕྱག་རྫས་ཀྱི་དངོས་པོ་ལ་རྟ་ནག་པོ་སེང་གེ་སྲབ་མེད་བྱ་བ་ཞིག།",
    "རྗེ་བཙུན་གྱི་ཐུགས་དགོངས་ལ་ང་རང་ཡང་རྒྱ་གར་དུ་འགྲོ་བ་དྲག་པར་འདུག་སྙམ་དུ་དགོངས་ནས།",
    "ཁྱད་པར་དུ་དེ་ན་གནས་བརྟན་ཆེན་པོ་བྱ་བ་ཞིག་འདུག་པས་དེ་ལ་བབས་ནས་དྲིས་པས།",
    "གསེར་ལ་སོགས་པའི་ཞབས་ཏོག་ཀྱང་མང་དུ་བྱས་པར་འདུག།",
    "དེ་རྣམས་ལྷོ་བྲག་ཏུ་ཁྱེར་ནས་ལྷོ་པ་དེ་མཁར་ལ་དགའ་བར་འདུག་པས།",
    "དེ་རང་དུ་ལས་འཕྲོ་སད་པ་ཞིག་ཡིན་ནམ་ཟེར་བར་འདུག།",
    "གཙང་རོང་ནས་མེས་ཚོན་པོ་བྱ་བས་བཙུན་པ་གཉིས་བང་ཆེན་ལ་བཏང་བྱུང་ནས་རྗེ་བཙུན་གཙང་དུ་གདན་འདྲེན་པར་འདུག།",
    "དེ་བས་ང་རང་རྗེ་བཙུན་གཞུང་དུ་གདན་འདྲེན་པ་དྲག་སྙམ་དུ་དགོངས་ནས།",
    "དེ་ནས་ལོ་གཅིག་གཉིས་ན་ལུག་བརྒྱས་སྣ་དྲངས་པའི་ཕྱག་རྫས་ཀྱི་དངོས་པོ་ཅི་ཡོད་པ་ཞིག་ལྷོར་ཁྱེར་ནས་ཕུལ་བར་འདུག།",
    "ཕྱག་རྫས་ཀྱི་དངོས་པོ་ཅི་ཡོད་པ་རྣམས་ལྷོར་ཁྱེར་ནས་ཕུལ་བྱ་བར་འདུག།",
    "གཞི་དང་རང་བཞིན་འབྲས་བུ་གསུམ།",
    "འགྲམ་ངན་པ་ཞིག་ལས་མ་བཞག་ན་མཐོན་པོར་བརྩིགས་པར་འདོད་ཀྱང་དུས་ཚོད་ཅི་ཞིག་ཙ་ན་ཧྲུལ་གྱིས་འགྱེལ་ནས་འགྲོ།",
    "དེ་གཉིས་གང་སྒོམ་ནས་འདུག་ཀྱང་།",
    "རྒྱུད་ཀྱི་པོ་ཏི་ཞིག་ཞལ་ཕྱེ་ནས་བལྟས་ཙ་ན།",
    "རང་བཞིན་གྱི་རྒྱུད་བསྐྱེད་པའི་རིམ་པ་དང་རྫོགས་པའི་རིམ་པ་འདི་དང་འདིར་འདུག།",
    "འབྲས་བུའི་རྒྱུད་ལས་དང་དངོས་གྲུབ་འདི་དང་འདིར་འདུག།",
    "ནང་སྟོང་པར་འདུག་པས་ཤེས་རབ་པ་མཚོན།",
    "སྟོན་པའི་ལུས་ལ་གནས་པའི་འཁོར་ཟེར་ཙ་ན།",
    "དུས་དེ་ཙ་ན་ཡི་དམ་གྱི་ལྷའམ་མཁའ་འགྲོ་མའི་ལུང་བསྟན་འབྱུང་།",
    "དུས་ཚོད་ཅི་ཞིག་ཙ་ན་མཉམ་བཞག་རྗེས་ཐོབ་འདྲེས་ཙ་ན།",
    "དུས་དེ་ཙ་ན་ཡི་དམ་གྱི་ལྷའམ་མཁའ་འགྲོ་མའི་ལུང་བསྟན་འབྱུང་།",
    "དེ་ལས་གྱེས་པ་གྲངས་མེད་ཐུག་པ་མེད་པར་གྱེས་ནས་འདུག་ཀྱང་།",
    "སྙོམས་འཇུག་དུས་སུ་བདེ་ཆེན་ནོ།",
    "ཉམས་སུ་མྱོང་བ་དེ་སྡུག་བསྔལ་བ་ལས་ལོག་ནས་བདེ་བར་འདུག་པས་ན་ལོངས་སྤྱོད་རྫོགས་པ་དང་བདེ་བ་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ཡིན།",
    "སྤྲུལ་པ་ནི་ཉམས་སུ་མྱོང་ན་དེ་མི་གསལ་བ་ལས་ལོག་ནས་མས་གསལ་འདུག་པས་ན།",
    "ཨེ་ཝཾ་མ་ཡའི་ཡི་གེ་འབྲུ་བཞི་རང་ལ་ཚང་ཙ་ན།",
    "སྙོམས་འཇུག་དུས་སུ་བདེ་ཆེན་ནོ།",
    "དེ་ལ་བརྟེན་ནས་ཚོང་ཁེ་སྤོགས་བཟང་པོ་ཞིག་བྱུང་ན་བདེ་བ་རུ་འདུག།",
    "དགའ་བ་བཞི་ལས་དགའ་བྲལ་གྱི་དགའ་བ་རྒྱུད་ལ་སྐྱེས་ཙ་ན།",
    "དེ་ལྟ་བུ་བཅུ་དྲུག་ཐེམ་ཙ་ན།",
    "དེ་ལྟ་བུ་དྲུག་ཅུ་རྩ་བཞི་ཐེམ་ཙ་ན།",
    "དེ་ལྟ་བུ་སུམ་ཅུ་རྩ་གཉིས་ཐེམ་ཙ་ན།",
    "འོ་ན་ཉམས་སུ་བླང་བའི་ཐབས་བསྟན་ནས་འདུག་པ་སྙམ་ན།",
    "དུས་ཚོད་ཅི་ཞིག་ཙ་ན་མཉམ་བཞག་དང་རྗེས་ཐོབ་ཏུ་འདྲེས་ནས།",
    "དུས་དེ་ཙ་ན།",
    "གྲོང་པ་རྣམས་ཀྱིས་སློབ་དཔོན་བིརླ་པ་བྱོན་བྱས་ནས་ཞབས་ཏོག་དང་བསྙེན་བཀུར་འབད་པར་འདུག།",
    "ཉིན་མེད་མཚན་མེད་ཉལ་ནས་སྡོད་པ་ཞིག་འདུག་པས།",
    "ཉི་མ་ནུབ་པ་མིན་པ་ནི་མི་ཚོར་བར་འདུག་པས།",
    "ལེའུ་ལེའུའི་འབྲེལ་ཟེར་ཙ་ན།",
    "དང་པོར་གཞི་རང་བཞིན་འབྲས་བུ་གསུམ་ཆར་དུ་གཏོགས་པའི་སྔགས་ཚན་བཅུ་གཅིག་ཟེར་ཙ་ན།",
    "འབྲས་བུ་ལས་ཀྱི་ཚོགས་སུ་གཏོགས་པའི་སྔགས་ཚན་ཉི་ཤུ་རྩ་གཉིས་ཟེར་ཙ་ན།",
    "འདི་རྣམས་ལ་རྒྱ་གར་གྱི་པཎྜི་ཏ་རྣམས་བསྒྲུབ་ལུགས་མི་མཐུན་པ་མང་དུ་ཡོད་པར་འདུག།",
    "ཀླུ་མཐའ་ཡས་ཀྱི་གཟུགས་བརྙན་རོ་སྟོད་མི་རུ་འདུག་པ།",
    "དཀྱིལ་འཁོར་གྱི་ཤར་གྱི་ཕྱོགས་སུ་གདན་ནང་ཚང་ཅན་བཏིང་བའི་སྟེང་དུ་འདུག་ནས།",
    "ནང་པདྨ་འདབ་བརྒྱད་དུ་འདུག་པ།",
    "དུར་ཁྲོད་ཀྱི་རོའམ་རས་ལ་ལུས་ཉེ་བར་འདུག་ནས་སེམས་ཀྱིས་སྤྲིན་གཞིག་པའི་བསམ་པ་དང་ལྡན་པས།",
    "སློབ་དཔོན་ཆེན་པོ་བིརླ་པ་དང་པོ་མུ་སྟེགས་ཀྱི་རྒྱལ་རིགས་ཤིག་ཡིན་པར་འདུག།",
    "བི་ཀྲ་མ་ལ་ཤཱི་ལའི་གཙུག་ལག་ཁང་ན་བསྒོམ་བསྒྲུབ་མཛད་ཅིང་བཞུགས་ཙ་ན།",
