    "བདེ་བ་ཐམས་ཅདབསྒྲུབ་པར་འདུག་པས།",
    "དེས་ན་འདིས་བདག་ལ་ཕན་འདོགས་པར་འདུག་པ་ཨང་སྙམ་དུ་བསམ།",
    "འདི་ཇི་ལྟར་བྱས་ལ་བརླག་ཏུ་གཞུག་འདི་ཐམས་ཅད་ལུས་བཟུང་བས་ལན་ནས་འདུག་པས།",
    "སྨ་འབེབས་སུ་འདུག་རྟོགས་དཔྱོད་གྱིས་དང་།",
    "ཚེ་འདིའི་ཆེ་ཐབས་དང་འདོད་པ་བསྒྲུབ་པར་འདུག་ན།",
    "གྲོགས་སུ་འགྲོ་ཡིན་འདུག་ན་བློ་འབྱོངས་པའི་ཚད་ཡིན་ནོ།",
    "ང་ལ་སྒོམ་ལོག་སྐྱེས་ནས་འདུག་སྙམ་དུ་བསམས་ཏེ།",
    "ཞེས་བྱ་བའི་རྣམ་གྲངས་ལ་རིམ་པས་བརྟག་ནས་འགལ་བར་སྤྱད་ནས་འདུག་ན།",
    "རང་ལ་ལྡན་ནས་འདུག་ན་དགའ་བ་བསྒོམས་ལ་ཁྱད་པར་དུ་འབད་པར་བྱ།",
    "ཀོ་ལོང་གཙང་བཙན་པས་དམ་པར་འདུག་སྟེ།",
    "དགེ་སྦྱོར་བྱས་ཀྱང་རང་རྒྱུད་མ་ཐུལ་ཚེ།",
    "ནི་ལེ་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "གང་ཡང་རང་སེམས་སྣ་ཚོགས་སྤྲུལ་པ་ལས།",
    "ཁྲི་ཁྲག་དགུའི་གཙོ་བོར་འདུག་གྱུར་ཀྱང་།",
    "དབེན་པའི་གནས་སུ་འདུག་ལ་དགར་མ་ཚོར།",
    "ཆགས་སྡང་རང་སར་བརླག་པར་ས།",
    "རང་རང་ལས་ཀྱིས་བརླག་པར་འགྱུར།",
    "ཅིའི་ངོ་བོར་ཡང་མ་གྲུབ་པས་ནམ་མཁའ་ལྟ་བུར་འདུག་པ།",
    "མིང་ཙམ་ཡང་དོན་དུ་གྲུབ་པ་ཅི་ཡང་མི་འདུག་སྙམ་དུ་བསམ་པ་དེའི་ངང་དུ་གནས་ཚད་བཞག་པར་བྱའོ།",
    "དེ་ནས་འཇོག་ཙ་ན་སངས་ཀྱིས་དག་པར་བསམས་ལ།",
    "འཇོག་ཙ་ན་རྡོ་རྗེ་སེམས་དཔའ་སྤྱི་བོ་ན་མར་ཐིམ་པས།",
    "ལྷའི་ལུས་སུ་ཅུང་མ་སླེབ་པ་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་པ་གཉིས་འདུག་པ་ལ།",
    "ལར་འཆི་བ་འདི་ཀ་ལ་འཚེར་ཟེར་ནས་དྲིབ་རྣམ་པ་བཞི་བྱེད་ཀྱིན་གདའ་སྐད།",
    "གཅིག་བསྒོམ་ཙ་ན་གཉིས་རང་ཆས་སུ་འོང་བས་ཟུང་འཇུག་ཏུབསྒོམ།",
