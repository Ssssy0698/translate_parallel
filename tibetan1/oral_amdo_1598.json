    "ཁམས་གསུམ་སྟེ་དེ་རྣམ་པར་དག་པའི་ལམ་ནི་རྦ་རླབས་གསུམ་མོ།",
    "དེའི་གད་མོའི་སྒྲས་ས་རྣམ་པ་དྲུག་ཏུགཡོ་བའང་ལྡེག་ལྡེགརབ་ཏུ་ལྡེག།",
    "དེ་ཙམ་ན་ནང་གི་མཁའ་འགྲོ་རིང་ནས་འདུ་བ་སྟེ།",
    "ས་ཕྱེད་དང་བཅུ་གསུམ་མོ།",
    "འོག་གི་མ་ལུས་པ་ནི་ཕྱེད་པོ་འདིར་སྦྱར་བར་ཤེས་པར་བྱའོ།",
    "ཡན་ལག་གི་དོན་ནི་སྔ་མ་བཞིན་ནོ།",
    "དེ་དག་གིས་ནི་ཉེ་བའི་རྒྱུ་བསྟན་ཏོ།",
    "རེ་ཞིག་དེ་དག་གིས་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་ལམ་གཉིས་ལ་ལུང་སྒོ་བསྟུན་ཏེ།",
    "དཔག་བསམ་གྱི་ཤིང་ལ་སྩོགས་པ་སྣོད་མཐའ་དག་གི་རྣམ་པར་སྣང་བས་གདུལ་བྱ་མཐའ་དག་གི་དོན་དུ་འགྱུར་བའོ།",
    "དབྱིབས་ཐིམ་པས་ཨ་ཧཾ་མི་ཏིའི་ཟུང་འཇུག་མི་ཤིགས་པའི་ཡི་གེ་སྟེ་སྟོབས་ཐིམ་པས་བདུད་བཞི་ཟིལ་གྱིས་གནོན་པ་ཧཱུཾ་གི་སྟོབས་ལྟ་བུར་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་ལེགས་པར་སྦྱར་བའི་སྐད་ནས་བཟུང་འགྲོ་བ་མཐའ་དག་གི་སྐད་དང་།",
    "གྲུབ་པ་དང་བདེ་བ་གཅིག་པའི་ཚུལ་གྱིས་གདུལ་བྱ་མཐའ་དག་གི་དོན་དུ་འགྱུར་པའོ།",
    "དེ་དག་གིས་ནི་རྟེན་གནས་གྱུར་གྱི་སྐུ་བཞི་བསྟན་ཏོ།",
    "རང་གི་ངོ་བོ་སྐུ་གཅིག་ཡིན་པར་ཡང་དེ་ཉིད་ལས།",
    "དོན་བསྟན་པས་ཚིག་དེ་ཉིད་ཀྱིས་གོ་བར་ནུས་པའི་ཕྱིར་ཚིག་གི་དོན་གྱི་རྣམ་པར་མ་ཕྱེ་བའོ།",
    "ད་ནི་དེ་དག་གི་གཞུང་ཉེ་བར་བསྡུ་བ་བསྟན་པ་ལས།",
    "དེ་དག་གིས་ལམ་འབྲས་བུ་དང་བཅས་པའི་མན་ངག་དབྲི་བསྣན་མེད་པར་བསྟན་ཏོ།",
    "ད་ནི་དེ་དག་གི་ས་གཞུང་རྫོགས་པར་བསྟན་པའི་ཕྱིར་ལམ་འབྲས་བུ་དང་བཅས་པའི་གདམས་ངག་དང་།",
    "རྣལ་འབྱོར་ཆེན་པོ་མཆོག་གི་ལམ།",
    "གྲགས་པ་རྒྱལ་མཚན་བདག་གིས་གུས་པས་བླངས།",
    "ཡིད་ཆེས་ཤིང་ཁུངས་བཙུན་པའིཕྱིར་གདམས་ངག་གི་བྱུང་ཚུལ།",
    "དཔེར་ན་དབྱར་གྱིམཚན་མོཆར་མུན་ཆེར་འཁྲིགས་པའི་མུན་ནག་གི་ཁྲོད་དུ་གློག་ཕྲེང་ཙམ་འཆར་བ་དང་ཚུལ་མཚུངས་པར།",
    "མཐར་ཤིང་སཱ་ལ་ཟུང་ཞིག་གི་ཚལ་དུ་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པའི་ཚུལ་སྟོན་པར་མཛད་དོ།",
    "འདི་ལ་ལམ་འབྲས་པ་རང་གི་སྒྲོས་ཐུན་མོང་མ་ཡིན་པ་ལྟར་ན།",
    "རྗེ་རྡོ་རྗེ་འཆང་གིས་ལེགས་པར་བརྟགས་པའི་གསུང་སྒྲོས་གང་ཟག་དགུས་མཛད་པར་བཞེད་པ་ཉིད་ལེགས་པ་ཡིན་གསུངས།",
    "དེ་དག་རེ་རེ་ལའང་སློབ་དཔོན་གང་གིས་མཛད་པ།",
    "ནགས་ཀྱི་ལྷ་མོས་བདུད་རྩི་ཕུལ།",
    "མཚོ་སྐྱེས་རྡོ་རྗེ་ཞེས་པ་དེས་རྒྱུད་རྩ་རྒྱུད་བརྟག་གཉིས་ལ་བརྟེན་ནས་བསྟན་བཅོས་སྒྲུབ་ཐབས་མཚོ་སྐྱེས་དང་མར་མེའི་རྩེ་མོ་ལྟ་བུམཛད།",
    "ཉམས་ལེན་ནི་གཏུམ་མོའི་ལམ་རྫོགས་པའི་ཁྲིད་དོ།",
    "ཕྱོགས་དེའི་བྱ་བ་རྣམས་རེ་ཞིག་དེ་ཙམ་ལ་བསྡུས་ནས།",
    "བདག་གིས་འབད་རྩོལ་དྲག་པོས་ལམ་འདི་ལྟ་བུ་བསྒོམས་ན།",
    "གྲུབ་པའི་མཚན་མ་བཟང་པོ་འབྱུང་ངམ་སྙམ་རེ་བ་མཛད་ཀྱང་།",
    "རང་གི་གྲོགས་དམ་ཚིག་གཅིག་པ་ལ་སོགས་པ་རྣམས།",
    "དེ་དག་གི་ཤུལ་ནས་ཁྲག་ཞམ་མེ་འབབ་པར་སྣང་པ་ལ་སོགས་པ་མི་འཚམས་པའི་སྣང་བ་དུ་མ་ཤར་པས་ཐུགས་མུག་སྟེ།",
    "བདག་གིས་ཉམས་ལེན་དེ་ཙམ་དུ་བྱས་ཀྱང་ཐ་ན་རྨི་ལམ་བཟང་བ་ཙམ་ཡང་མི་འབྱུང་ཞིང་།",
    "གང་ལྟར་ཡང་ཉལ་བའི་ཐོ་རངས་མནལ་ལམ་དུ་རྗེ་བཙུན་རྡོ་རྗེ་བདག་མེད་མ་ཐ་མལ་པའི་བུད་མེད་སྔོན་མོ་མཛེས་ཤིང་ཡིད་དུ་འོང་བ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་དངོས་གྲུབ་ཐོབ་ཁར་དེ་ལྟ་བུའི་བྱ་བ་ངན་པ་བྱས་པ་མ་ལེགས།",
    "བྱེ་བྲག་ཏུ་ཁྱོད་ཀྱིས་ལས་བསགས་པའི་ལྷ་དེ་ང་ཡིན་པས་ངས་བྱིན་གྱིས་རླབས་ཀྱི།",
    "ཉེར་གསུམ་གྱི་སྲོད་ལ་རྗེ་བཙུན་རྡོ་རྗེ་བདག་མེད་མ་ལྷ་མོ་བཅོ་ལྔའི་དཀྱིལ་འཁོར་མངོན་སུམ་དུ་བྱོན་ནས།",
    "ཁམས་འདུས་པ་བར་པ་ཐིག་ལེ་བདེ་སྟོང་གི་ལམ་ཁྲིད་པའི་སྐབས་སུ་མས་ཡར་གཏུམ་མོ་འབར་བ་དང་།",
    "ཡེ་ཤེས་དེའི་རྒྱུན་བསྐྱངས་པས་ཞག་རེ་ལ་ས་རེའི་རྟོགས་པ་ན་འཕར་ཏེ།",
    "རང་གི་རྟོགས་པ་བོགས་དབྱུང་བའི་སླད་དུ།",
    "ཤ་ཆང་ལ་སོགས་པའི་དམ་རྫ་ས་རྣམས་གསང་བའི་ཚུལ་གྱིས་བླངས་ཤིང་ཚོགས་ཀྱི་འཁོར་ལོ་མཛད་པ་ན།",
    "སློབ་དཔོན་རྗེ་བཙུན་ཡབ་ཀྱི་ཏིང་ངེ་འཛིན་མཛད་པའི་ཚེ་མཐོང་བ་ན་བུད་མེད་བརྒྱད་ཀྱི་དབུས་ན་བཞུགས་པ་དང་།",
    "རྗེ་བཙུན་ཡུམ་གྱི་ཏིང་ངེ་འཛིན་ལ་བཞུགས་པ་ན་བུད་མེད་བཅུ་བཞིའི་དབུས་ན་འདུག་པ་དང་།",
    "གཅེར་བུར་ཨེ་བིརླ་ཞེས་པ་ང་ཡིན་པ་ཞེས་གསུངས་ཤིང་དཔེ་ལ་ལར་ཧ་དེ་བྱོན་ཞེས་བྲིས་སྣང་མོད།",
    "ངས་རེག་ན་ཁྱེད་འབགས་པར་འགྱུར་བས་ཁྱོད་ཀྱིས་ང་ལ་ལམ་བྱིན་ཅིག་གསུངས་པས།",
    "གངྒཱ་གྱེན་དུ་ལོག་སྟེ་ལམ་ཐལ་གྱིས་བྱུང་བ་ལ་སློབ་དཔོན་བྱོན་པས།",
    "ནགས་གསེབ་ནས་སློབ་དཔོན་སྤྱན་དྲངས་པའི་བར་ལམ་དུ་སློབ་དཔོན་གྱིས་འབུ་དང་ཕྱེ་མ་ལེབ་ལ་སོགས་པའི་སྲོག་ཆགས་ཕྲ་མོ་དུ་མ་ཞལ་དུ་བཏབ་པས་ངན་པ་འདི་ཞེས་ཟེར།",
