    "བཅོམ་ལྡན་འདས་ལ་ལན་གསུམ་བསྐོར་བ་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "སྣ་དང་ལྕེ་ཡང་རང་བཞིན་གྱིས།",
    "ལྷག་པར་ཞེན་ནས་འདུག་པ་དེ་ནི་ཚོར་བའི་རྐྱེན་གྱིས་སྲེད་པ་ཞེས་བྱའོ།",
    "ལྷག་པར་ཞེན་ནས་འདུག་པ་ལས་བདག་སྡུག་པའི་ངོ་བོ་དང་།",
    "གང་ཚེ་ཐ་མལ་འདུག་པ་ཡང་།",
    "ཚགས་གསབ་ས་རྒྱ་། རང་རང་འཚང་རྒྱ་བའི་ཞིང་ལོ་བདུན་དུ་གདམ་བཅུག་པ་ལས།",
    "འགྲེང་འདུག་ཉལ་དང་འཆག་པར་མི་བྱའོ།",
    "དེ་ལ་ཀུན་དགའ་བོ་འདུག་སྟེ།",
    "ཞེས་སྨྲས་ནས་སྟན་ལས་བབས་ཏེ་འདུག་གོ།",
    "དེ་སྙེད་ལགས་ཏེ་འདི་ལས་ལྷག་པ་མེད་དོ་ཞེས་སྨྲས་ཁྲི་ལས་བབས་ཏེ་ས་ལ་འདུག་གོ།",
    "སློབ་དཔོན་བྲེད་ནས་ས་མཱ་དྷཱི་ལ་སྙོམས་པར་ཞུགས་པས་ཞག་གསུམ་ལོན་ཙ་ན་ཅིའང་མ་བྱུང་།",
    "དེ་ནས་ཞག་བདུན་ལོན་པའི་ཉིན་པདྨ་ཁ་ཕྱེ་སྟེ་ནང་ན་ཁྱེའུ་ཤིན་ཏུ་མཛེས་པ་ལོ་བརྒྱད་པའི་ཚོད་ཅིག་ཟིལ་བ་ཁྲོམ་མེ་འདུག་སྟེ།",
    "དེ་ནས་ང་རང་ཡང་འདིའི་ལུས་ལ་ཞུགས་ནས་འདི་རྒྱལ་བར་བྱའོ་ཞེས་ཞལ་གྱིས་བཞེས་སོ།",
    "མཐར་བིརླ་མང་པོ་ཞུགས་ཤིང་འདུག་པ་ལ་སུས་ཀྱང་ཁོང་དང་རྩོད་མ་ནུས།",
    "གལ་ཏེ་ཁོ་བོས་ཐུབ་པར་འདུག་ན་ང་འགྲོ།",
    "དེར་མུ་མྫོ་སྟེགས་ཀྱི་སྟོན་པ་དེས་ནང་པ་ཕྱིར་མི་གཏོང་ཕྱི་པ་ནང་དུ་མི་གཏོང་བར་འདུག་པ་ལ།",
    "ཟེར་བས་ངས་ཡུན་ཐུང་འདུག་བསམ་སྟེ་སླར་ལོ་གསུམ་བསྒྲུབས་སོ།",
    "རང་མལ་ཁྲིའི་འོག་ཏུ་འདུག་ནས་གང་དཀའ་བ་དེ་ལ་ཐག་པ་འཐེན་ནས་ལེགས་པར་ཤེས་པ་དང་།",
    "ང་བདུན་འབྱུང་གྱིས་མ་ནོར་བ་མི་ཤེས་པ་འདུག་དགོངས་ཏེ་རྣམ་འགྲེལ་གྱི་མཇུག་ཏུ་བློ་གྲོས་ཤིན་ཏུ་ལྷག་པར་སོགས་ཀྱི་ཚིགས་བཅད་བཅུག་པར་གྲགས་སོ།",
    "དེ་ནས་ཕྱི་ཞིག་ན་མཚོ་དེ་བསྐམས་ཏེ་དཔལ་ཧེ་རུ་ཀའི་ལྷ་ཁང་རང་བྱུང་ཕུན་སུམ་ཚོགས་པ་བཞིག་ཀྱང་བྱུང་ནས།",
    "དྲང་སྲོང་དེ་མཐོང་སྟེ་འཇིགས་ནས་འདི་ན་གནོད་སྦྱིན་འདུག་གོ་ཞེས་སྨྲས་ཏེ་བྲོས་པ་ན།",
    "སྦྲུལ་ག་ཤར་བཅང་བ་ད་ལྟའི་བར་དུའང་འདུག་ཅེས་ཨུ་རྒྱན་པ་རིན་ཆེན་དཔལ་གསུངས་ལ།",
    "ཉ་པ་མང་པོས་ཉ་བསད་ནས་ལྟོའི་ཕུང་པོ་ཆེན་པོ་སྤུངས་ནས་དེ་ལ་བྱ་དང་ཁྱི་ཟ་ཞིང་འདུག་པས།",
    "ནུབ་ཅིག་ཉལ་པོ་ལ་འོངས་པའི་སྐྱེས་པ་ཞིག་ཕྱི་རོལ་དུ་ཕྱིན་ཙ་ན།",
    "ཕྲད་པས་དེས་ཆང་ས་འོག་ཏུ་བཅུག་འདུག་པ་བླངས་པས་མ་སྟེར་ཏེ།",
    "མ་ཚད་ཀྱི་རྡོ་བ་ཞིག་ལ་ཆུ་བག་ཙམ་འདུག་པ་ནས་འཐུང་ཟེར།",
    "ཕྱི་རོལ་ན་འདུག་གསུངས།",
    "མཛུབ་བུ་སུག་བྱས་པའི་ཤུལ་ན་ཚུར་དབུགས་ངན་སོ་སོ་དྲི་བུ་ཆེན་འབུར་འབུར་བྱུང་བས་རུལ་ནས་འདུག་ཟེར་ལོག་པ་དང་།",
    "དེར་བོས་ཏེ་རྒྱལ་པོའི་ཡང་ཐོག་ན་འདུག་བཞིན་དུ་བུམ་པ་ཆུས་བཀང་སྟེ་རྒྱལ་པོ་ལ་ཕུལ་བས།",
    "དེའི་ནུབ་འདུག་སྟེ་རྣལ་འབྱོར་མ་ལ་ཆགས་པ་སྤྱད།",
    "ལམ་ན་བྱིས་པ་ཚན་གཅིག་ཕྱུགས་སྐྱོང་ཞིང་རྩེ་ཡི་འདུག་པ་ལ།",
    "ཁྱེའུ་དེ་ཟླ་བོའི་གསེབ་ཏུ་འདུག་གོ།",
    "ཉི་ཤུ་ཙམ་དམངས་ཀྱི་ཚུལ་དུ་བསྡད་འདུག་པ་ལ།",
    "དེར་བྱོན་པའི་ལམ་ནགས་ཀྱི་མཐོངས་ཤིག་ན་སྤྱིལ་པོ་གདུགས་ལྟ་བུར་ཁྱིལ་ལེ་འདུག་པ་མཐོང་སྟེ་དེར་བྱོན་པས་དེའི་ནང་ན་རྣལ་འབྱོར་པ་ཞིག་གང་ལའང་མ་བརྟེན་པར་བཞུགས་འདུག་པས།",
    "དེ་དཔོན་དུ་བཀོད་དེ་གྲལ་རིམ་གྱིས་འདུག་པའི་སྐབས།",
    "གཉིས་པོ་སྟན་གཅིག་ལ་འདུག་ནས།",
    "ལོག་པ་དང་བུ་མི་འདུག་སྣོད་ཕྱེས་ནས་ཤ་ཚོས་སམ་བལྟས་པས་བུའི་རོར་མཐོང་ནས་ངུས།",
    "གཉིས་པོ་ལ་ཁྱེད་རང་གཉིས་ངའི་གོས་ཀྱི་གྲྭ་ལ་ཟུང་ཞིག་གསུངས།",
    "ང་རང་བྲམ་ཟེ་གསལ་འོད་ཡིན།",
    "དྷརྨ་གཉྫ་འདུག་པའི་འགྲམ་དུ་སླེབས།",
    "དེར་བཅོམ་ལྡན་འདས་མ་ལ་གུས་བཏུད་མ་བྱས་པར་འདུག་པ་ལ།",
    "རང་ཉིད་རང་བྱུང་རང་གསལ་གྱི།",
    "པཎྜི་ཏ་དེ་ལྟར་འདུག་པ་མི་རིགས།",
    "འོན་ཀྱང་འདི་ན་ཁ་ཆེ་བའི་ཚོང་པ་འདུག་པས།",
    "དེར་རྒྱལ་པོས་སྤྱན་དྲངས་ནས་དེ་དག་རྟོག་ཏུ་བཅུག་པས་ཡིན་པར་འདུག་ཅེས་ཐམས་ཅད་ཀྱིས་དད་པར་བྱས་ཏེ་པཎྜི་ཏ་རྣམས་འ་ཀྱི་དཔོན་དུ་བསྐོ་ཟེར།",
    "རྒྱལ་པོས་ལྐོག་ཏུ་བརྟག་པ་བྱས་པས་བདེན་པར་འདུག་སྙམ་དེར་འོངས་ཏེ་གྲགས་པ་ངན་པ་འདི་ལྟ་བུ་མཆིས་པས་མ་སངས་ཀྱི་བར་གཞན་དུ་ཎྞཾབཞུད་ཅིག་ཟེར་བས།",
    "ཐུགས་ཁྲོས་ནས་མཐུ་བྱ་བར་དགོངས་ཏེ་ནགས་ཀྱི་ལྗོངས་རི་དེའུ་མི་ཆུང་བ་ཞིག་འདུག་པའི་རྩེར་རྩྭའི་སྤྱིལ་པོ་བྱས།",
    "ཕྱོགས་རྣམས་སྟོང་ཞིང་རང་ཡང་རྣམ་པར་བྲལ།",
    "རྒྱལ་པོའི་སྒོར་སྤུངས་ནས་འདུག་སྟེ།",
    "དེ་བཞིན་བྱས་ནས་སང་དེ་གཉིས་གར་ཡོད་བལྟས་པས་བོ་ནགས་གསེབ་ཀྱི་སྤྱིལ་པོ་ཞིག་ལ་དེ་གཉིས་འཁོར་ཞིང་འདུག་གོ།",
    "རྗེ་བཙུན་རྡོ་རྗེ་རྣལ་འབྱོར་མས་ལུང་བསྟན་པར་འདུག་སྐལ་བ་བཟང་པོ་ཡིན།",
    "སྒོ་གསུམ་རིམ་བཅད་པའང་དེ་ཁོ་ན་བཞིན་འདུགཔ་ངས་དངོས་གྲུབ་ལན་གསུམ་དུ་སྐྱེལ་དུ་འོངས་པ་ཡིན་ཏེ།",
    "ཡི་དམ་གྱིས་དངོས་གྲུབ་སྐྱེལ་དུ་བྱོན་པར་འདུག་སྟེ་མ་ཤེས་པར་སྣང་བུ།",
    "པ་གོར་བི་རོ་ཙ་ན་རཀྱི་ཏ།",
