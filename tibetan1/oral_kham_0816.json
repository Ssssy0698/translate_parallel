    "བདེ་བའི་སྟན་ལ་འདུག་ནས་ཀྱང་།",
    "ངེད་ཅག་འདིར་འདུག་བསྟན་པ་བསྲུང་བར་ཁས་བླངས་བའོ།",
    "དེ་ནས་རྣལ་འབྱོར་པ་བདག་ཉིད་སྟན་བདེ་བ་ལ་འདུག་ལ།",
    "བློ་གསལ་འགྲོ་འདུག་ལག་པའི་འདུ་བྱེད་མང་།",
    "ཟླ་བ་གཟས་ཟིན་དུས་སུའང་རང་བཞིན་གྱིས་ཟིན་པ་ཡིན་ནོ།",
    "གཟུང་འཛིན་དུ་སྣང་བའི་ཆའི་གཤིས་ལ་ཉན་ཐོས་དགྲ་བཅོམ་པ་དང་རང་རྒྱལ་ཡིད་སྦྱིན་བདེ་བའི་ས།",
    "མུ་བཞིའི་ཕྱོགས་སུ་རིག་ཀྱང་རང་བཞིན་ཇི་ལྟ་བར་མ་རིག་པས་གསང་།",
    "གཉེན་པོས་ཉན་ཐོས་ལྟར་མི་སྤང་རང་རྒྱལ་ལྟར་མི་དགག་བྱང་སེམས་ལྟར་མི་སྦྱང་སྟེ།",
    "ཐམས་ཅད་ཕྱོགས་ལྷུང་རང་གྲོལ་སར་གནས་ཤོག།",
    "རྗེས་རྟོགས་བརྟགས་སྣང་རང་གར་སྤྱོད་པས་འཁོར།",
    "ཀྱེ་དགེ་སློང་རང་གསལ་དབྱེར་མེད་ཡོན་ཏན་བསམ་ལས་འདས།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་སློབ་དཔོན་ཆེན་པོ་བེ་རོ་ཙ་ནས་ཡུལ་དྷ་ཧེ་ནའི་འདུ་ཁང་དུ་ཞུས་ཤིང་བསྒྱུར་ཏེ་གཏན་ལ་བབས་པའོ།",
    "མངོན་ཤེས་ཐོབ་རྣམས་ཀྱིས་ཞེས་པ་ལྷའི་མིག་དང་ལྷའི་རྣ་བ་དང་ཕ་རོལ་གྱི་སེམས་ཤེས་པ་དང་རང་དང་གཞན་གྱི་སྔོན་གྱི་གནས་རྗེས་སུ་དྲན་པ་དང་།",
    "༡༥བཞག་ཅིང་གཡོན་པ་གཡས་པའི་བརླ་སྟེང་དུ་བཞག་པ་རྡོ་རྗེའི་འདུག་སྟངས་སོ།",
    "ལྷ་མ་ཡིན་གྱི་འདུག་སྟངས་ནི་ལུས་བསྐུམ་སྟེ་རུས་སྦལ་ལྟར་གནས་པའོ།",
    "ཏིལ་དང་བཅས་པའི་ཟན་དང་། སྲན་མ་ཙ་ན་ཀ་དང་ཤ་དང་བཅས་པའི་ཟན་རྣམས་སོ།",
    "༩༥ ༡༥གསུངས་པའི་གདན་ལ་ཇི་ལྟར་གསུངས་པའི་འདུག་སྟངས་ཀྱིས་གནས་ནས་ལས་ཐམས་ཅད་ལ་ལྗང་གུའོ།",
