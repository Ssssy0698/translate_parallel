    "དེ་སྔ་ནས་མན་ཇུའི་དམག་གིས་དཔའ་རིགས་དགོན་ལུང་དང་།",
    "རིང་མོ།",
    "གཞུང་པ་སོགས་ཡུལ་གྲུ་ཆེན་པོ་དེ་ཚོའི་མི་རེ་རེ་ཙམ་ཡང་སླེབས་ཐུབ་མེད།",
    "དེ་རྗེས་རྩ་ལོག་བྱས་སོང་བའི་རྗེས་སུ་ཕལ་ཆེར་གསར་འབྱོར་བ་མེད་པ་ལྟ་བུ་ཡིན།",
    "རྒྱ་ཡིག་གི་སློབ་ཚན་བཟོ་ཐབས་གནང་ཡང་།",
    "བོད་མི་མང་སྤྱི་འཐུས་རྣམ་པ་ཚོགས་ཕེབས་གནང་ཡོད་པ་རེད།",
    "དེ་སྔ་བུད་མེད་ཚོགས་པ་ཞིག་ཡོད་ཀྱང་བར་ལམ་འཇའ་ཡལ་བའི་བཟོ་འདྲ་པོ་ཆགས་པ་རེད།",
    "དེ་ཡང་དངོས་གནས་བྱས་ན་དགོས་མཁན་ཞིག་རེད།",
    "བུད་མེད་ཚོགས་པ་སྲ་ཐག་ཐག་ཅིག་དགོས་ངེས་རེད་ཅེས་བཀའ་ཕེབས་པ་ལྟར།",
    "བཞུགས་སྒར་དུ་ཡོད་པའི་བུད་མེད་རྣམས་ནས།",
    "༡༩༨༤ ཟླ་༩ ཚེས་༡ ཉིན་བུད་མེད་ལྷན་ཚོགས་ཀྱི་སྒྲིག་འཛུགས་སླར་གསོ་མཚོན་པ་བྱས་ཏེ།",
    "ལྷན་ཚོགས་འདི་བཞིན་འཛམ་གླིང་སྤྱི་སྲོལ་དང་མཐུན་པའི་རྒྱ་ཆེའི་བུད་མེད་ཀྱི་སྒྲིག་འཛུགས་ཡིན་ལ།",
    "སྐབས་དེ་དུས་བུད་མེད་ཀྱི་ཚོགས་འཐུས་གྲངས་༡༨ ཡོད་པ་ནས་རྒྱུན་ལས་པ་བུད་མེད་གྲངས་༧ གཏན་འཁེལ་གནང་བ་ནི།",
    "ལས་རོགས་དགའ་གདོང་གསལ་སྒྲོན་བཅས་ནས་ཟླ་༦ རིང་འགན་འཁུར་བླངས་པ་རེད།",
    "ཁོང་རྣམ་པས་རྩ་བའི་ཆབ་སྲིད་དང་འབྲེལ་བའི་གང་ཅིའི་སྐོར་བཀའ་ཤག་ལ་དགོངས་བསྐོར་འབྲེལ་མོལ་ཞུ་ཡི་ཡོད་ཅིང་།",
    "བུད་མེད་ཚོགས་པའི་མིང་འདོགས་ཕྱོགས་ལ་བཀའ་མོལ་མང་པོ་བྱུང་།",
    "སྒོ་བྱང་ལ་བོད་རིགས་བུད་མེད་ཚོགས་པ་ཞེས་བཀོད་འདུག་ལ།",
    "སྐབས་དེ་དུས་གཞོན་ནུའི་ལྷན་ཚོགས་ནས་ཀྱང་བོད་རིགས་གཞོན་ནུ་ལྷན་ཚོགས་ཞེས་འབོད་ཀྱི་ཡོད་དེ་སྔ་ལྷ་ས་རང་དུ་༡༩༥༩ ལོའི་གོང་དུ་བོད་རིགས་བུད་མེད་ཚོགས་པ་ཟེར་བ་ཞིག་བཙུགས་ཡོད་འདུག་པའི་དེའི་ཚོགས་མིའི་ཁོངས་སུ་ཕྲེང་རིང་རིན་ཆེན་སྒྲོལ་མ་དང་།",
    "རྒྱས་སྟོང་ཚེ་རིང་སྒྲོལ་མ་ཅན་ཡོད་འདུག་རྒྱས་སྟོང་ཚེ་རིང་སྒྲོལ་མས་དེར་རྩ་འཛིན་གྱིས་བོད་རིགས་བུད་མེད་ཚོགས་པའི་རྒྱུན་མཐུད་དགོས་ལུགས་དང་།",
    "བཀའ་ཤག་གིས་བོད་རིགས་བུད་མེད་ཚོགས་པ་ཟེར་བ་དེར།",
    "བུད་མེད་རྣམས་ཀྱིས་གང་ཡང་བྱེད་ཐུབ་པའི་འཇོན་ཐང་གི་འབོད་སྒྲ་སྒྲོག་བཞིན་པའི་སྐབས་ཡིན་པ་སོགས་ལ་གཟིགས་ཏེ་གོང་ས་མཆོག་ནས་བོད་ཀྱི་བུད་མེད་རྣམས་ལ་ནང་ཁྱིམ་འཚོ་གཡོག་གི་འཆིང་རྒྱ་ལས་འགྲོལ་བར་མཛད་དེ།",
    "རྟ་ཤོད་དཔོན་མོ་པད་མ་མཚོ་ཟེར་བ་དང་།",
    "ཚྭ་ཁའི་དཔོན་མོ་རའི་ལྷེབ་ཅན་ཟེར་བ་ཡོངས་སུ་གྲགས་པ་དང་།",
    "མི་ལོ་༣ལྷག་ཙམ་གྱི་ཚུན་ཆད་ལའང་བླ་བྲང་བཀྲ་ཤིས་སྒོ་མང་གི་ཡུལ་ཁམས་སུ་དཔོན་མོ་རྣམ་རྒྱལ་སྒྲོལ་མ་ཟེར་བ་དང་།",
    "དུས་དེ་མཚུངས་སུ་ཏྲེ་ཧོར་ཁང་སར་དཔོན་མོ་དབྱངས་ཅན།",
    "ཐུན་མོང་མ་ཡིན་པའི་རིག་གཞུང་སོགས་མི་ཉམས་རྒྱུན་འཛིན།",
    "ཇོ་མོ་འཆིམས་བཟའ་ལྷ་མོ་བཙན་དང་།",
    "སྲུས་བཙན་མོ་རྒྱལ་ལ་སོགས་པ་བརྒྱ་རབ་ཏུ་བྱུང་ཞེས་གསལ་བ་ལ་བལྟས་ན།",
    "རྒྱ་གར་འཕགས་པའི་ཡུལ་ན་དགེ་སློང་མ་དཔལ་མོའི་སྡོམ་རྒྱུན་དགེ་སློང་ཕ་དང་མའི་ལམ་རྒྱུན་སོ་སོར་ཡིན་པ་ལ་བརྟེན་རྩ་བདག་བཟོ་མཁན་གྱི་ཁྱད་པར་ཡིན་པ་ནི་ཟུར་དུ་མཐོང་ཐུབ།",
    "དགེ་མ་བརྩོན་འགྲུས་བཟང་མོ།",
    "གོང་གསལ་ཨ་རྟ་ལྷ་མོ་ཞུ་བ་ཁོང་ཉིད་ཕྱི་ལོ་༡༩༨༡ ལོར་སྐུ་འཇའ་ལུས་སུ་གྲུབ་པ་དེའི་བུ་མོ་ཟེར་བ་སྐུ་ཆུང་དུས་ནས་སྒྲུབ་པ་ལ་བརྩོན་ནས་ཚེ་མཚམས་མ་བྱ་བཞིན་ཡོད་པར་གང་ལ་དཔྱད་ཀྱང་གྲུབ་པ་བརྙེས་པའི་རྣལ་འབྱོར་མ་ཆེན་མོ་འཇའ་ལུས་འོད་གསལ་ཆེན་པོར་ཕེབས་རྒྱུར་གདོན་མི་ཟ་བ་ཡིན།",
    "སྐུ་ཚེ་ནས་ཡིན་པ་རྣམས་འདས་ལོག་སུ་ཕེབས་པར་ཉིན་བདུན་ཕྲག་རེ་ཙམ་ལ་འདས་ཤིང་།",
    "སྤྱིར་འཛམ་གླིངའདིར་ཕོ་མོ་འདྲ་མཉམ་དུ་ཡོད་ཆོག་པ་དང་།",
    "བོད་གངས་ཅན་གྱི་ལྗོངས་སུ་ཕོ་མོ་འདྲ་མཉམ་ཡིན་པའི་མངོན་རྟགས་འདི་ལྟ་བུ་ཡོད་པ་རེད།",
    "མགོ་སེར་བ་སོགས་མི་རིགས་མང་པོ་ཞིག་ནས་བོད་མི་རིགས་ལ་མཐོང་ཚུལ་ཡག་པོ་ཡོད་པ་སོགས་ལས་བོད་མི་རིགས་འཁྱོར་བའི་དུས་རབས་ཤིག་ཆགས་འགོ་ཚུགས་ཀྱི་ཡོད་པར་བརྟེན་རིགས་གཙང་མར་གནས་པའི་འགན་འཁུར་གཙོ་བོ་དེ་བོད་ཀྱི་བུད་མེད་རྣམས་ཀྱི་ཐོག་ཏུ་བབས་ཡོད།",
    "དེས་ན་བུད་མེད་སྒེར་སོ་སོ་འམ།",
    "བུད་མེད་ཚོགས་པའི་ངོ་བོ་གང་ས་ནས་མི་རིགས་སྲུང་སྐྱོབ་བྱ་ཐབས་དགོས་ངེས་ཀྱི་དུས་ལ་བབས་ཡོད།",
    "མི་རིགས་ཁེར་གཙང་གི་བོད་མིའི་གཞིས་ཆགས་ཁག་ཏུ་ཡང་གནས་མི་ཐུབ་པར།",
    "སྔོན་མ་བུད་མེད་ཚོགས་པ་ཞིག་ཡོད་ཙང་།",
    "འཆར་ཅན་ང་རང་ཚོའི་ལས་ཀ་གང་ཡིན་རུང་ཐོག་མར་རྫིག་པོ་དང་།",
    "རྗེས་སུ་སླ་རུ་འགྲོ་བ་ཞིག་ཡོངགི་ཡོད།",
    "གསལ་པོ་བྱེད་དགོས་པ་རེད་ཅེས་དང་།",
    "བུད་མེད་སྒྲིག་འཛུགས་ཀྱི་ཐོག་ལའང་དེ་འདྲ་ཞིག་ལ་སླེབས་ཡོད་པས།",
    "ཁྱེད་རང་ཚོར་དམིགས་བསལ་གྱི་ལས་འགན་སླེབས་ཀྱི་ཡོད།",
    "ང་ཚོའི་དམིགས་ཡུལ་ནི།",
    "རིག་གཞུང་ལ་སེམས་ཁུར་ལེན་དགོས་པ་དེ་ཚོ་ཤེས་གསལ་རེད།",
    "བུད་མེད་སྤིའི་གནས་སྟངས་དོན་དག་ཡིན་ནའང་རང་ཉིད་ཐེ་བས་བུད་མེད་ཡོངས་རྫོགས་ལ་འགན་འཁྲི་བ་ཞིག་རེད་ཅེས་དང་།",
    "ནུས་པའང་དེས་ཐོན་གྱི་རེད།",
    "ཁྱེད་རང་ཚོས་བརྟན་བཞུགས་ཤིག་འབུལ་གྱི་ལབ་པ་རེད།",
    "དེ་རིང་ཁ་སའི་དངོས་ཡོད་གནས་ཚུལ་དབར་འབྲེལ་བ་ཆེན་པོ་ཆགས་ཡོད་པ་རེད།",
    "ཁྱེད་རང་ཚོ་བློ་གཡེང་བྱེད་མ་དགོས།",
    "ད་བར་གྱི་རིང་ལ་བོད་སྤྱི་པའི་དོན་དག་གང་ཡོང་ཅི་ཡོང་བྱས་པ་རེད།",
    "མི་ཚེ་མཐའ་འཁྱོངས་པ་ཞིག་ཡོང་བའི་ཆེད་དུ་ངས་སྨོན་བརྒྱབ་དང་བརྒྱབ།",
    "གཡེང་བ་ཁྱོན་ནས་བྱེད་མ་དགོས་ཞེས་བཀའ་སྩལ།",
    "གོང་ས་མཆོག་གིས་སྲིད་བློན་གང་ཉིད་ལ་བཀྲ་ཤིས་བདེ་ལེགས་ཀྱི་འཚམས་འདྲི་དང་འབྲེལ་གང་གི་བཞེད་དོན་གེགས་མེད་ལམ་ལྷོང་ཡོང་བདང་།",
    "འཛམ་གླིང་ནང་གི་སྲིད་འཛིན་དང་།",
    "སྲིད་བློན་གྱི་མཚན་གནས་བཞེས་མཁན་ལོ་ན་ཆུང་ཤོས་དེ་ཡིན་པ་རེད།",
    "ཏང་གི་དྲུང་ཆེ་ཀའོན་སི་ཀྲན་ཀྲིན་ཅར་ནན་ཀོ་མཆོག་༡༩༨༥ ཟླ་༣ ཚེས་༡ ཉིན་མཚན་མོར་འདས་པ་དང་།",
    "ཚེས་༡༡ ཉིན་སྲིད་འཛིན་གསར་པ་སྐུ་ཞབས་གྷོར་འབོ་ཅོབ་ལ་ཏང་གི་དྲུང་ཆེ་མང་མོས་བསྐོ་གཞག་ཟིན་པ་ཁོང་ནི།",
    "འགའ་ཤས་ཤིག་ནས་གུང་ཁྲན་གྱི་ལམ་ལུགས་བརྟན་གནས་ཡིད་གཏད་མི་འཕེར་བ་ཆགས་ཀྱི་ཡོད་པའི་ངོས་འཛིན་གྱི་གླེང་མོལ་ཡང་བྱུང་ཡོད་པ་རེད།",
    "མང་ཚོགས་མཐུན་ལམ་གྱི་གཞི་འཛིན་དགོས་པ།",
    "དེའང་ལྟོས་ས་ལྟོས་འཇོག་འདི་དང་འདི་བྱ་བ་དགོས་དོན་མིག་མཐོང་ལག་ཟིན་ཡོད་པ་དགོས་རྒྱའི་རྒྱ་མཚན་བཅས་ཞིབ་ཕྲའི་གནས་ལུགས་ཉིན་དང་པོའི་ཚོགས་ཐེངས་གཅིག་གི་རིང་དུ་སྙན་སེང་ཞུས་པར།",
    "ཧ་ཅང་རྒྱུན་རིང་ཆགས་ནའང་རི་དྭགས་སྒྲ་ལ་ཆགས་པ་ལྟར་འཇམ་ཐིང་ངེའི་ངང་ད་དུང་ཡང་ཉན་འདོད་ཀྱི་ངང་དུ་བར་སེང་གནང་སོང་ཞིང་།",
    "འགྱུར་སོང་ཟེར་བའི་དགའ་ཚོར་ཆེན་པོ་བྱས་པ་དང་།",
    "གོང་ས་མཆོག་གི་དགོངས་གཞི་དང་བོད་མི་ས་ཡ་དྲུག་གི་དགོས་འདུན།",
    "དངོས་ཡོད་གནས་སྟངས་སོགས་ལས་ཡོངས་སུ་ཐ་དད་ཕྱོགས་འགལ་དུ་འགྱུར་པའི་གནས་ཚུལ་ལ་བརྟེན་ང་ཚོས་ངོས་ལེན་ལྟ་ཅི།",
    "༡༩༨༥ ཟླ་༤ ཚེས་༡༦ ཉིན་དོན་གཅོད་ཁག་རེ་རེ་བཞིན་ངོ་བཅར་གྲུབ་རྗེས།",
    "གཟིགས་སྐོཪ་སྐུ་ཚབ་ཐེངས་༤ པ་ཕེབས་རྒྱུའི་གོ་སྒྲིག་དང་།",
    "སྔོན་ཚུད་ནས་བོད་དུ་གཟིགས་སྐོར་སྐུ་ཚབ་ཐེངས་༤ ཕ་གྲ་སྒྲིག་རྒྱས་ཙམ་ཞིག་ཕེབས་ཐུབ་རེ་གནང་སྟེ་བཀའ་ཤག་ནས་མི་གྲངས་༥ ནས་༦ བར་ཡོད་པའི་ཚོ་ཁག་བཞི་བཀོད་སྒྲིག་གིས་རྒྱ་གར་ནས་བལ་ཡུལ་བརྒྱུད་ཚང་མ་དང་པོར་ལྷ་སར་འབྱོར་རྒྱུ་བྱས།",
    "ནག་ཆུ་སོགས་སུ་སྐོར་བསྐྱོད་བྱ་རྒྱུ་བཅས་གཏན་འཁེལ་གྱིས་ཁག་རེ་རེར་འགྲོ་མཁན་གྱི་མི་སྣ་འོག་གྲབས་གནང་སྟེ།",
    "ལྡི་ལི་དོན་གཅོད་བརྒྱུད་རྒྱ་དམར་གཞུང་ཚབ་ཁང་ལ་འཆར་བཀོད་ལྟར་བཀའ་མོལ་ཐེངས་ཁ་ཤས་གནང་ཡང་ང་ཚོའི་འཆར་གཞི་ལྟར་ཁས་ལེན་ཡེ་ནས་བྱ་རོགས་མ་བྱས།",
    "གལ་ཏེ་གཏོང་ཐུབ་ཀྱི་ཡོད་ན་མི་འགྲོ་སུ་དང་སུར་གཏན་འཁེལ་བྱུང་མིན་བཀའ་འདྲི་གནང་གི་འདུག་པ་ལྟར།",
    "ཕྱི་ཚེས་༡༩ དགོང་མོར་རྒྱ་རི་པད་མ་རྒྱལ་པོ་ཕྲན་གྱི་ནང་དུ་སླེབས་བྱུང་།",
    "དགོང་མོའི་ཞལ་ལག་སྐབས་རང་བཞིན་ལྟ་བུར།",
    "དེ་ནས་མཚན་མོ་བཀའ་ཟུར་སྟག་ལྷའི་ནང་དུ་ཕྱིན་སོང་བ་དང་།",
    "གང་ལྟར་ཕྱི་ཉིན་དེར་པད་མ་རྒྱལ་པོས་ཁོང་པ་ཉི་ཧོང་དོན་གཅོད་དགོངས་ཤོག་གོང་ས་མཆོག་ལ་ཐད་ཀར་ཕུལ་འདུག་པའི་ནང་ཕ་རྒྱ་རི་ཉི་མ་གཟིགས་སྐོར་སྐུ་ཚབ་ཀྱི་ཁོངས་སུ་མ་བཏང་བ་དེ།",
    "ཁོ་ཚོ་རྒྱ་རི་ཚང་གི་བུ་སྤུན་ཚང་མས་བོད་གཞུང་གི་ལས་ཀ་བྱས་པར་ཞབས་ཞུ་སྒྲུབ་མཁན་མང་དྲགས་པས་ཡིན་པ་ངོས་འཛིན་གྱིས་བློ་ཕམ་གྱི་ཐོག་ནས་ཕྲན་རང་ལས་ཞབས་ནས་དགོངས་པ་ཞུ་ཡི་ཡོད་ལུགས་བཀོད་འདུག་པ་མ་ཟད།",
    "ཁྱེད་རང་ནས་རྒྱ་རི་ཉི་མ་གཟིགས་སྐོར་སྐུ་ཚབ་ཐེངས་༤ པའི་ཁོངས་སུ་མ་བཏང་བར་བློ་ཕམ་ཡོད་གནས་དང་།",
    "པད་མ་རྒྱལ་པོ་ནས་ཁྱེད་རང་གིས་གསུང་པ་དེ་ལྟར་ཞུས་པ་ཡིན།",
    "ཁྱེད་རང་གིས་ངའི་ཕ་རྒྱ་རི་ཉི་མ་གཟིགས་སྐོར་སྐུ་ཚབ་ཏུ་གཏོང་དགོས་ཀྱི་རེད་ཅེས་རྒྱབ་སྐྱོར་བྱ་རྒྱུའི་ཚབ་ཏུ་བཀག་འགོག་བྱས་པ་དེ་འོས་བབས་མེད་པ་ཞིག་ཡིན་ལ།",
    "ང་ཚོ་རྒྱ་རི་ཚང་གི་མི་ངོ་མང་པོས་བོད་གཞུང་གི་ཞབས་ཕྱི་ཞུ་མཁན་མང་དྲགས་པས་ཡིན་པ་ངོས་འཛིན་གིས་ངས་དགོངས་པ་ཞུས་ན་ཕ་རྒན་མི་གྲལ་དུ་ཚུད་དགོས་ཀྱི་རེད།",
    "ཕྲན་ནས་ཁྱེད་ཀྱི་ཕ་རྒྱ་རི་ཉི་མ་གཟིགས་སྐོར་སྐུ་ཚབ་ཏུ་གཏོང་དགོས་ཀྱི་རེད་ཅེས་ངོས་ནས་ཞུ་དགོས་པ་དང་།",
    "པད་མ་རྒྱལ་པོ་ནས་ཁྱེད་རང་གཟིགས་སྐོར་སྐུ་ཚབ་དང་པོར་ཕྱིན་པའི་ཆ་ནས་ཁྱེད་རང་སྐད་གྲགས་ཆེན་པོ་ཡོད་པ་དེ།",
    "ངའི་ཕ་རྒྱ་རི་ཉི་མ་གཟིགས་སྐོར་སྐུ་ཚབ་ཏུ་བཏང་ན།",
    "ཁྱོད་རང་གི་སྐད་གྲགས་དེ་ཉམས་འགྲོ་ཡི་རེད་བསམ་གྱི་ཡོད་པ་རེད།",
    "གཞི་ནས་ངའི་ཕ་བོད་དུ་གཟིགས་སྐོར་དུ་མ་བཏང་ན་བོད་མི་མང་བློ་ཕམ་ཡོང་གི་མ་རེད་དམ་ཞེས་དང་།",
    "ངའི་ཕ་རྒན་ལྡི་ལིར་རྒྱ་གར་གྱི་ཨ་ཤོ་ཀ་མགྲོན་ཁང་དུ་གོང་ས་མཆོག་མཇལ་ཞུས་སྐབས་རྒྱ་རི་ཉི་མ་ཁྱེད་རང་ཡིན་གཅིག་མིན་གཉིས་བོད་དུ་གཟིགས་སྐོར་སྐུ་ཚབ་ཏུ་འགྲོ་དགོས་གསུངས་ཡོད་པ་དང་།",
    "གྲའུ་དཔོན་ལས་བོད་ནང་དུ་ངའི་ཕ་རྒྱ་རི་ཉི་མ་སྐད་གྲགས་ཆེ་བ་ཡོད་པ་བཅས་ལ་བརྟེན་ཁྱེད་རང་ནས་མོས་མཐུན་རྒྱབ་སྐྱོར་བྱ་འོས་ལས་བཀག་འགོག་བྱ་འོས་པ་མ་རེད།",
    "དེ་ལ་ཧ་ཅང་གི་བློ་ཕམ་ཡོད་ཅེས་ཟེར་ནས་ངན་བྱས་ངོ་སོར་འཁྱེར་ཟེར་བ་ལྟར་ཁྱེད་རང་དང་ཁྱོད་རང་ཟེར་ཏེ་གདོང་དམར་པོ་བྱེད།",
    "ཁར་སེང་བཀའ་ཟུར་སྟག་ལྷ་ཕུན་ཚོགས་བཀྲ་ཤིས་ཁོང་ཉིད་བཀའ་ཤག་ཏུ་བཅར་དུས་རྒྱ་རི་ཉི་མ་གཟིགས་སྐོར་སྐུ་ཚབ་ཏུ་གཏོང་དགོས་མིན་གང་ཡང་གསུང་པ་མེད།",
    "པད་མ་རྒྱལ་པོ་ཁྱེད་རང་གི་སྐད་ཆ་ཁྱད་མཚར་པོ་འདི་འདྲ་གང་འདྲ་ཞིག་ཡིན་ནམ་ཞེས་བརྗོད་པ་དང་།",
    "པ་དེ་འདོར་དུ་མེད་པའི་ལྟ་སྤྱོད་མ་རུངས་པ་རྒྱུན་འཛིན་དོན་གཉེར་བྱེད་ཀྱི་ཡོད་པ་རང་རྟགས་གསལ་རྗེན་དུ་སྟོན་པ་ཞིག་རེད།",
    "ངོས་རང་གི་བསམ་ཚུལ་ནི།",
    "གནས་དུས་འདི་འདྲ་ཞིག་གི་སྐབས་སུ་གོང་ས་སྐྱབས་མགོན་ཆེན་པོའི་བཀའ་དྲིན་གྱིས་འཚོ་བའི་འོག་ནས་བོད་མི་རིགས་ཀྱི་འདོད་དོན་འགྲུབ་ཐབས་གང་ཞིག་དྲག་ན་བསམ་པ་རྒྱུན་དུ་འཛིན་པ་ལས།",
    "ཉག་རོང་རྒྱ་རི་ཚང་གཉིས་སྐད་གྲགས་ཆེ་ཆུང་གི་འགྲན་བསྡུར་བྱེད་དགོས་དོན་མེད་ལ།",
    "མ་འོངས་པར་ཡང་ཕན་ཚུན་རེ་དོགས་བྱ་རེས་ཀྱི་དུས་སྐབས་དང་།",
    "ཁྱོད་རང་གི་བསམ་ཚུལ་དེ་ལྐུག་པ་སྤྱོད་ངན་རྒྱུན་བཅངས་ཅན་གྱི་རང་རྟགས་རེད་མ་གཏོགས་རྒྱ་རི་ཚང་ཟེར་བ་དེ་ཆེན་པོ་དང་ཡག་པོའི་སྐད་གྲགས་ཡོད་པ་དེ་འདྲ་གང་ཡང་ཤེས་རྟོགས་མེད།",
    "ངོས་རང་འཇུ་ཆེན་ཚང་ལྟ་བུ་ཉག་རོང་དུ་སོང་བ་ཡིན་ན།",
    "རྒྱ་རི་ཉི་མ་གཉིས་ཀྱང་དེ་བས་ལྷག་པའི་སྐད་གྲགས་ཆེ་ཆུང་བསྡུར་ཚད་བྱུང་མ་མྱོང་བ་དེ་འདྲ་མ་རེད།",
    "སྔར་ཡིན་ན་ཁྱེད་རྒྱ་རི་ཚང་གིས་གྲའུ་ཚང་ལ་འགྲན་བསྡུར་བྱ་ཐུབ་པ་ཞིག་ཡོད་སྐད་གོ་མ་མྱོང་།",
    "དངོས་ཡོད་གནས་ཚུལ་ཤེས་པ་བྱས་ན་ཡག་གི་རེད།",
    "ད་དུང་ཁྱེད་རང་གིས་ངའི་ཕ་རྒྱ་རི་ཉི་མ་གཟིགས་སྐོར་འགྲོ་མ་ཐུབ་ན་བོད་མི་མང་བློ་ཕམ་ཡོང་གི་མ་རེད་དམ་ཟེར་གྱི་ཡོད་པ་རེད།",
    "དེ་ནི་ཧ་ལས་པའི་ལྐུག་རྟགས་ཀྱི་སྐད་ཆ་རེད།",
    "རྒྱ་རི་ཉི་མ་གཟིགས་སྐོར་འགྲོ་མ་ཐུབ་ན།",
    "བོད་མི་མང་བློ་ཕམ་དུས་ནམ་ཡང་ཡོང་གི་མ་རེད།",
    "ཅིའི་ཕྱིར་དུ་བློ་ཕམ་བྱེད་ཀྱི་རེད།",
    "ཁྱེད་རང་གི་བསམ་ཚུལ་ཁྱད་མཚར་པོ་འདི་འདྲ་ག་རེ་ཡིན་ནམ།",
    "རྒྱ་རི་ཉི་མ་ཟེར་བ་ཁོ་རང་སུས་ཧ་གོ་ཡོད་པ་རེད།",
    "ཉག་རོང་ལུང་པའི་ནང་ལའང་ཁྱེད་རང་ཚོའི་སྤན་ཉེ་འདྲ་ཡོད་ཚེ།",
    "ད་དུང་རྒྱ་རི་ཉི་མ་ཧ་གོ་མཁན་ཡོད་ན་དེ་ཚོས་གཟིགས་སྐོར་སྐུ་ཚབ་ནང་མ་ཡོང་ན་དགའ་མཁན་མང་བ་ཡོད་འགྲོ།",
    "ད་བར་གཟིགས་སྐོར་སྐུ་ཚབ་སྔ་རྗེས་བཏང་གནང་མཛད་པ་རྣམས་བོད་མི་མང་ནས་དགའ་མོས་ཆེན་པོ་བྱས་ཡོད་པ་འདི་དག་མི་ངོ་སྒེར་ལ་དགའ་མོས་བྱས་པ་ཞིག་ངོས་འཛིན་བྱ་རྒྱུ་ཡོད་པ་ཞིག་མ་རེད།",
    "གནས་དུས་འདི་འདྲ་ཞིག་ལ་བོད་ནང་གི་བོད་མིར་བལྟ་རྟོག་གི་ཆེད་དུ་སྐུ་ཚབ་བཏང་གནང་མཛད་མཁན་གོང་ས་སྐྱབས་མགོན་ཆེན་པོའི་ཐུགས་རྗེ་དང་བཀའ་དྲིན་ལ་བསམ་ནས་དགའ་མོས་བྱེད་ཀྱི་ཡོད་པ་དོན་དངོས་ངོ་ཤེས་དགོས་རྒྱ་དེ་གལ་ཆེན་པོ་རེད།",
    "དངོས་ཡོད་ཀྱི་གནས་ཚུལ་རྣམས་ངོ་སྤྲོད་བྱེད་ཀྱི་ཡོད་པས་ཁྱེད་རང་ནས་གོ་བ་ལོག་སྒྲབ་མ་བྱས་ན་ཡག་གི་རེད།",
    "ཡིན་ན་ཡང་ཁྱོད་རང་གི་ཕ་རྒྱ་རི་ཉི་མ་བཀག་འགོག་བྱེད་མཁན་འཇུ་ཆེན་ཐུབ་བསྟན་རེད་ཅེས་བརྗོད་ཀྱི་ཡོད་པ་རེད།",
    "འཇུ་ཆེན་ཐུབ་བསྟན་ནི་བོདགཞུང་གི་བཀའ་བློན་ཁྲི་པའི་འགན་ཁུར་བྱེད་བཞིན་དུ་ཡོད།",
    "གཟིགས་སྐོར་སྐུ་ཚབ་ཐེངས་བཞི་པའི་མི་འགྲོ་གོ་སྒྲིག་བཀའ་ཤག་ལྷན་རྒྱས་ནས་གནང་བ་རེད།",
    "ཁྱོད་རང་གིས་ངའི་ཐོག་ཏུ་གྱོད་འཛུགས་བྱེད་པ་འདི་གོང་འོག་བར་གསུམ་དང་འབྲེལ་བ་ཡོད་པའི་ཐོག་ནས་ཆེད་དུ་འཆར་གཞི་དང་ལྡན་པའི་གྱོད་འཛུགས་ཤིག་བྱེད་ཀྱི་ཡོད་སྟབས།",
    "གཟིགས་སྐོར་སྐུ་ཚབ་ཐེངས་བཞི་པ་གཏོང་ཕྱོགས་བཀའ་ཤག་གིས་འཆར་གཞི་གཏན་འབེབ་གནང་བ་ནི།",
    "མངའ་རིས་བཅས་ཚོ་ཁག་བཞི་རེ་རེ་ལ་མི་གྲངས་༥ རེ་ཡོད་པའི་སྐྲ་ཚབ་ཚོགས་པ་རེ་བཀོད་སྒྲིག་བྱས།",
    "གོ་སྒྲིག་གནང་ནས་དུས་ཡུན་རིང་པོ་སོང་སྟབས་ཕྱི་ནས་བསམ་འཆར་འདོན་མཁན་འགའ་རེ་བྱུང་ཡོད་ལ།",
    "བདེ་སྲུང་དྲུང་ཆེ་བྱམས་པ་སྐལ་ལྡན་ནས་གསང་སྙན་ཆུང་ཆུང་ཞིག་གི་ནང་དུ་ད་དུང་རྒྱ་རི་ཚང་ལ་ཨ་མ་གཉིས་ཡོད་པ་རེད་ཟེར་མཁན་འདུག་ཅེས་འཁོད་འདུག་བར་ལམ་ཞིག་ལ་བཀའ་ཟུར་སྟག་ལྷ་ཕུན་ཚོགས་བཀྲ་ཤིས་ཁོང་ནས་བུད་མེད་ཀྱི་ལྟ་སྐོར་ཚོགས་པ་ཞིག་གཏོང་གནང་ན་ཞེས་ཐེངས་༢ ཙམ་གསུངས་སོང་ཡང་།",
    "འཆར་སྒྲིག་གནང་རིགས་བྱུང་མེད་ཀྱང་ཕྱི་ནས་མི་འགའ་རེས་རིན་ཆེན་མཁའ་འགྲོ་དང་།",
    "བདེན་པ་གང་ཡང་མ་རེད།",
    "བདེན་མིན་ལ་མ་ལྟོས་པའི་གཏམ་རང་བཞིན་དུ་བརྗོད་མི་ཆོག་ཟེར་ས་ཡོད་པ་མ་རེད།",
    "རྣམ་འགྱུར་བསྟན་པ་ཙམ་ལས་གྱོད་གདོང་གཏུགས་བྱེད་ཀྱི་མི་འདུག་མཐའ་མ་དེར་བཀའ་ཤག་གི་འཆར་བཀོད་ལྟར་ལྡི་ལིར་རྒྱ་དམར་གཞུང་ཚབ་ཁང་ནས་ཁས་ལེན་བྱེད་ཐབས་མ་ཐུབ་སྟེ།",
    "བསྟན་འཛིན་ཕུན་ཚོགས་ནི་བཀའ་ཟུར་ཁོང་ཉིད་ཀྱི་ཞབས་ཞུ་བ་དམིགས་བསལ་གྱིས་གཞུང་ཚབ་ཁང་ལ་བཀའ་མོལ་ཞུས་པ་ཞིག་ཡིན།",
    "འོན་ཀྱང་པད་མ་རྒྱལ་པོ་ཁྱེད་རང་གིས་མི་ངོ་གདོང་གཏུགས་ཀྱིས་བཀའ་ཤག་ལྷན་རྒྱས་ཐོག་སྤོབས་པ་དང་ལྡན་པའི་སྒོ་ནས་བརྗོད་ཡོད་པ་དེར་ཁུངས་སྐྱེལ་ཡོད་དགོས་ཀྱི་རེད།",
    "ཁོ་པའི་རྣ་ལམ་དུ་ད་ལྟ་ངོ་ཐོག་དེར་བཀའ་བློན་རྣམ་པས་གསུངས་དགོས་ཀྱི་རེད།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ནས་རྒྱ་རི་ཉི་མ་གཟིགས་སྐོར་དུ་འགྲོ་དགོས་གསུང་ལུགས་དང་།",
    "རྗེ་བློན་ལས་ཟུར་དང་བཅས་པའི་བཀའ་དགོངས་ལ་ངོས་རང་འཇུ་ཆེན་ཐུབ་བསྟན་ནས་བརྩི་མེད་ཞུ་ཕོད་ཐབས་ཡེ་ནས་མེད་སྟབས་རྒྱ་རི་ཉི་མ་གཟིགས་སྐོར་སྐུ་ཚབ་ཁོངས་སུ་གཏོང་རོགས་གནང་ཞུ་རྒྱུ་གཅིག་དང་།",
    "བཀའ་ཤག་ནང་དུ་ཡང་བཀའ་མོལ་བྱུང་མེད་ངེས་ཡིན་ཡང་།",
    "སུ་གཅིག་གིས་ཚིག་གཅིག་བརྗོད་ཀྱི་མི་འདུག་ཅིང་།",
    "ཡང་ན་ཁྱོད་རང་ལ་ཁུངས་སྐྱེལ་བྱ་རྒྱུ་ག་རེ་ཡོད་དམ་ཟེར་བ་ལྟ་བུ།",
    "ཡང་ན་ད་ཆ་ཁྱོད་རང་གི་བསམ་ཚུལ་དུ་གང་ཞིག་དྲན་གྱི་ཡོད་དམ་ཟེར་བ་ལྟ་བུ་གསུང་དགོས་ཀྱང་གང་ཡང་གསུང་མཁན་མི་འདུག་པས་བཀའ་བསྡུར་གྲོལ་བ་ཡིན།",
    "ད་ཆ་གཟིགས་སྐོར་སྐུ་ཚབ་ཚོགས་པའི་ཁོངས་སུ་རྒྱ་རི་ཉི་མ་གཏོང་རོགས་གནང་ཞུ་རྒྱུ་ཡིན།",
    "ཁྱེད་རང་གིས་རྒྱ་རི་ཉི་མ་རྗེ་བློན་ལས་ཟུར་དང་བཅས་པས་གཟིགས་སྐོར་སྐུ་ཚབ་ཏུ་གཏོང་རྒྱུ་ཡིན་པའི་བཀའ་གནང་ལུགས་བཀའ་ཤག་ཏུ་ཞུས་པ་ཡིན་སྟབས།",
    "གཟིགས་སྐོར་འགྲོ་ཉེར་སོང་གྲ་འགྲིག་པ་གྱིས་ཞེས་བཀའ་ཕེབས་པ་ལས།",
    "གུས་པས་དགོངས་ཞུ་ཞུས་པར་བཀའ་འཁྲོལ་ཡོང་དང་ཡོང་མིན་གང་ཡང་ཕེབས་མ་སོང་།",
    "གོང་ས་མཆོག་གིས་བཀའ་ཇི་ཕེབས་ལྟར་གཟིགས་སྐོར་སྐུ་ཚབ་ཕེབས་རྒྱུར་གྲ་འགྲིགས་པ་དགོས་སྟབས།",
    "ཁོང་རྣམ་པས་འགྱུར་བ་གཏོང་དགོས་དོན་ཡོད་མ་རེད་ཅེས་ཞུས་སོང་བར།",
    "རྒྱ་མིས་ཀྱང་ཁས་ལེན་མིན་མི་ཤེས་རྙོག་གྲ་ཚ་པོ་རེད་ཅེས་ཕེབས།",
    "རྗེ་བློན་ཚང་མས་དེ་ཡང་འགྲིགས་ཀྱི་མ་རེད།",
    "གཟིགས་སྐོར་འགྲོ་ཡུལ་དང་རྒྱ་རི་ཉི་མ་འབྲེལ་བ་ཡོད་པ་མ་རེད་ཅེས་གསུངས་པ་དང་།",
    "ཐུབ་བསྟན་རང་ནས་དྲིས་ན་ཞེས་ཕེབས་ཐོག་ཐའེ་ཝན་དུ་ཕྱིན་མེད་ཟེར་གྱི་འདུག་ན་འགྱུར་བ་གཏོང་དགོས་པ་གང་ཡང་མེད་ཅེས་ཐག་གཅོད་གནང་སོང་།",
    "གྲའུ་དཔོན་གྱིས་དེའི་ལན་དུ་རྩ་བ་ནས་བདེན་པ་མ་རེད་ཅེས་བརྗོད་ཀྱི་འདུག་པ་ལྟར།",
    "འོན་ཀྱང་གྲའུ་དཔོན་རིན་ཆེན་ཚེ་རིང་བོད་དུ་གཟིགས་སྐོར་སྐུ་ཚབ་ཀྱི་གྲས་སུ་ཕྱིན་ནས་ཚུར་འཁོར་ཚར་བའི་རྗེས་སུ་ཤེས་རྟོགས་གསལ་པོ་བྱུང་བ་ནི།",
    "དེ་སྔོན་ནས་ཐའེ་ཝན་དུ་ཕྱིན་ཚར་བ་རེད་འདུག་དེ་རྗེས་ཤིག་ལ་གོང་ས་མཆོག་གིས་གྲའུ་དཔོན་གྱིས་ཁྱེད་རང་མགོ་བསྐོར་བཏང་འདུག་གམ།",
    "གུས་ནས་མགོ་བསྐོར་ཆ་ཚང་བཏང་འདུག་ཧ་ཅང་གི་ཐབས་སྡུག་པོ་དང་།",
    "ཉེན་འགན་ཡང་ཆེན་པོ་རེད་འདུག་དེ་འདྲ་རང་བྱེད་ཀྱི་མ་རེད་བསམ་གྱི་ཡོད་ཅེས་ཞུས་པ་ཡིན།",
    "དེ་རྗེས་ཤིག་ལ་གྲའུ་དཔོན་ངའི་ནང་དུ་ཡོང་དུས་ཤིག་ལ་ངོས་ནས་ཁོང་རང་ལ་ཁྱེད་རང་གིས་ང་ལ་རྩ་བ་ནས་བདེན་པ་མ་རེད་ཅེས་ལབ་བྱུང་བ་ལྟར།",
    "ཐུགས་ཡིད་ཆེས་ཆ་ཚང་གནང་ཡོད་པ་རེད།",
    "དེ་དུས་ནས་ཁྱེད་རང་ཐའེ་ཝན་ལ་ཕྱིན་ཚར་བ་རེད་འདུག་བ།",
    "དཔོན་གྱིས་ད་དེ་དུས་ངས་དེ་འདྲ་ཞུ་རྒྱུ་རེད་སོང་།",
    "ད་ཅི་དྲག་གི་རེད་ཅེས་ཟེར།",
    "ཕྱིས་འབྱུང་ཡ་ཡུག་ཆེན་པོ་དེ་འདྲ་མི་ཡོང་བ་བཟོ་རྒྱུ་དེ་གལ་ཆེན་པོ་རེད་མ་གཏོགས་ཁྱེད་རང་གིས་ང་མགོ་བསྐོར་བཏང་།",
    "གོང་ས་མཆོག་དང་བཅས་པ་དབུ་བསྐོར་ཞུས་པ་ཞིག་ཆགས་ཀྱི་ཡོད་རེད།",
    "གོང་ས་མཆོག་ནས་དོན་མེད་ཀྱི་རྙོག་གྲ་མི་དགོས་པའི་ཐག་གཅོད་གནང་དོན་བཞིན་གཟིགས་སྐོར་སྐུ་ཚབ་ཐེངས་༤ པ་སྔོན་གཏན་འཁེལ་བ་ལྟར་ཤར་ཕེབས་ཐུབ་པ་དགོས་དོན་ལ་བཀོད་མངགས་གནང་བའི་སྐོར།",
    "བཀའ་བློན་ཁྲི་ཟུར་ཀུན་གླིང་འོད་ཟེར་རྒྱལ་མཚན་གྱིས་དབུས་བོད་དུ་གཟིགས་སྐོར་སྐུ་ཚབ་ཐེངས་༤ པ་གཏོང་གཏན་འཁེལ་བ་ལྟར།",
    "ཟླ་༥ ཚེས་༢ ཉིན་བོད་ཕེབས་གཟིགས་སྐོར་སྐ་ཚབ་ཚོགས་པའི་ཚོགས་གཙོ་བཀའ་བློན་ཁྲི་ཟུར་ཀུན་གླིང་འོད་ཟེར་རྒྱལ་མཚན་དང་།",
    "ཚེས་༢༡ ཉིན་བཀའ་ཤག་དང་བཅས་པ་ལྷན་གཅིག་ཏུ་གོང་ས་མཆོག་གི་མདུན་དུ་མཇལ་བཅར་ཞུས།",
    "ང་ཚོས་འཆར་གཞི་རྒྱས་པ་ཞིག་བཀོད་པ་རེད་དེ།",
    "རྒྱ་གཞུང་ནས་ཁས་ལེན་མ་བྱས་པ་རེད།",
    "འགྲོ་གང་ཐུབ་ཐུབ་འགྲོ་རྒྱུ་རེད།",
    "འགྲོ་ཡུལ་དང་འགྲོ་ཕྱོགས་བཀའ་ཤག་དང་ཁྱེད་རང་ཚོ་ཞིབ་བསྡུར་ཡོང་གི་རེད།",
    "ཡོང་གི་རེད་བསམ་གྱི་འདུག་མུ་མཐུད་ཕན་ཚུན་འབྲེལ་ལམ་བྱ་རྒྱུ་གལ་ཆེན་པོ་རེད་སོགས་ནང་མའི་བཀའ་སློབ་ཞིབ་པར་སྩལ།",
    "ཕེབས་ཕྱོགས་སྐོར་བཅས་༤བཀའ་མོལ་གནང་དོན།",
    "ད་ལན་གཟིགས་སྐོར་སྐུ་ཚབ་ཐེངས་༤ པ་ཕེབས་ཡུལ་ནི།",
    "དེ་ནས་ཕྱོགས་སོ་སོར་ཕེབས་ཕྱོགས་གོ་སྒྲིག་བཟོ་ཡི་རེད་སྙམ།",
    "གྲོ་ཚང་རྡོ་རྗེ་འཆང་གི་དགོན་གནས་དང་།",
    "ལ་མོ་བདེ་ཆེན་དགོན་དང་།",
    "རྨ་ལྷོ་རེབ་ཀོང་།",
    "གཟིགས་སྐོར་འཚམས་འདྲི་ཕེབས་པ་འདི་བཞིན་རྒྱ་བོད་མི་རིགས་སམ།",
    "ཆེ་ཆུང་སུ་ལའང་བཀའ་མོལ་གནང་ཕྱོགས་ལ་ཐུགས་སྣང་ཆེན་པོ་གནང་དགོས།",
    "རྗེས་ལོར་བོད་ཀྱི་ས་གནས་གཞན་དག་ལ་གཟིགས་སྐོར་སྐུ་ཚབ་གཏོང་ཐུབ་རྒྱུའི་རེ་བའི་བཀའ་མོལ་ཡོད་བཞིན་པ་ཡིན་སྟབས་མུ་མཐུད་འབྲེལ་ལམ་དེད་ཐུབ་ཐབས་ཐུགས་སྣང་གནང་དགོས་པ་དང་།",
    "བོད་མིས་བོད་མིར་ཡིད་ཆེས་དང་འབྲེལ་ལམ་ངོ་ཤེས་ཡག་པོ་ཡོང་དགོས་པ་ཕུགས་རིང་གི་བསམ་བློ་གཏོང་རྒྱུ་གལ་ཆེ།",
    "རྒྱ་གར་ནས་ལག་འཁྱེར་སེར་པོ་བླངས་པའི་ཐོག་ཧོང་ཀོང་བར་དབྱིན་ཇི་གཞུང་གི་ཐོངས་མཆན་ལེན་དགོས་པ་དང་།",
    "ཧོང་ཀོང་ནས་རྒྱ་ནག་གཞུང་གིས་ལག་འཁྱེར་སེར་པོ་ལ་ངོས་ལེན་མི་བྱེད་ཀྱང་།",
    "རྒྱ་ནག་གིས་དམིགས་བསལ་མི་སྣ་གལ་ཆེར་ངོས་འཛིན་གིས་ཤོག་བུ་གསར་པ་རེ་སྤྲད་དེ་སྣེ་ལེན་པས་འགན་ཁུར་སྣེ་ཁྲིད་ཞུ་ཡི་རེད་ཅེས་པའི་ངོ་སྤྲོད་བཀོད་མངགས་ཐོ་ཡིག་དང་སྦྲགས་ཞིབ་མོལ་བགྱིས་ཏེ་ཕེབས་ལམ་བདེ་བགྲོད་ཡོང་བའི་ལེགས་དར་ཕུལ་བཞེས་ཀྱིས་ཕྱི་ཉིན་བཞུགས་སྒར་ནས་ལྡི་ལིར་ཕེབས་ཐོན་གནང་བ་རེད།",
    "ཕྱི་ལོར་གཟིགས་སྐོར་ཕེབས་ཐུབ་པའི་འབད་བརྩོན་གནང་རྒྱུ་ཡང་གལ་ཆེར་བརྩིས།",
    "མཛད་རྗེས་ཤིན་ཏུ་ཆེ་བའི་མགྲོན་གཉེར་ཆེན་མོ་ཕ་ལྷ་བ་ཐུབ་བསྟན་འོད་ལྡན་སྐུ་གཤེགས་པར་བློ་ཕམ་ཆེ་གནས།",
    "རྩེ་ཡིག་ཚང་གི་ལས་བྱ་དང་།",
    "རྒྱ་གར་དུ་ཕེབས་འཁོད་རྗེས་བཙན་བྱོལ་བོད་གཞུང་གི་སྒྲིག་འཛུགས་གསར་གཏོད་གནང་རྗེས་ནང་སྲིད་བཀའ་བློན་གྱི་མཛད་འགན་བཞེས་པ་དང་།",
    "ཁོང་གིས་དེ་སྔ་ནོར་འཁྲུལ་གྱི་ལས་ཀ་གཅིག་གནང་ཡོད་པ་ནི།",
    "ཧོར་སྤྱི་ཁྱབ་གནང་བའི་སྐབས་སུ་ཧོར་ཚོ་པ་སུམ་ཅུ་སོ་དགུ་ཟེར་བའི་ཁོངས་སུ་ག་རྒྱ་འགྲམ་ནག་ཟེར་བའི་མི་སྣ་དཔའ་བོ་ཆེན་པོ་ཡོད་པ་དེས་ཡུལ་མི་སྤྱིའི་སྒྲིག་ལམ་མི་ཁུར་ནས་ཁོང་རང་གི་ངོ་གཡོག་མང་པོ་འཁྲིད་ཉར་གྱིས་ཕོ་ཤེད་ཀྱི་བྱ་གཞག་ཁོ་ནར་བྱས་ཏེ་འགྲོ་སྡོད་བྱེད་མཁན་ཞིག་རེད།",
    "སྡུག་ས་ལ་སྡུག་པོ་བྱེད་མཁན་དེ་འདྲ་རེད།",
    "ཁོང་རང་གི་རྒྱུན་གྱི་ངོ་གཡོག་སོགས་འབྲེལ་འདྲིས་ཡོད་པ་རྣམས་ཧ་ཅང་གི་ཡག་པོ་བྱེད་མཁན་ཡག་སྡུག་གཉིས་ལ་རྩ་འཛིན་འཁྱེར་མཁན་ཞིག་ཡིན་པ་མ་གཏོགས་ཡག་སྡུག་ངོ་མི་ཤེས་མཁན་ལྟ་བུ་དེ་འདྲ་མིན་པ་རེད།",
    "བྱང་སྤྱིསོགས་ལ་མགོ་མི་སྒུར་བ་ལྟ་བུ་སྤྱི་མཚུངས་ཀྱི་སྒྲིག་ལམ་མི་ཁུར་བར་རང་སྣང་གང་དྲན་གྱིས་ཕོ་ཤེད་ཀྱི་ལམ་བཟུང་མཁན་དེ་འདྲ་ཞིག་ཡིན་པ་རེད།",
    "མ་ཇང་རྒྱག་རྩེད་བྱེད་བཞིན་པའི་སྐབས་དམག་མི་བཞི་ནས་ལག་གཡས་གཡོན་ཏུ་འཇུས་ཏེ་མཐར་དམར་བསད་བཏང་བ་རེད།",
    "སྐབས་དེ་དུས་ག་རྒྱ་འགྲམ་ནག་གི་གཡོག་པོ་མང་པོ་ཡོད་འདུག་ཀྱང་།",
    "ག་རྒྱ་འགྲམ་ནག་གིས་ཕོ་ཤེད་ཁུར་ས་མི་དྲག་དང་།",
    "ཁ་གཏད་བཅོག་ནས་ཉམ་ཆུང་མང་ཚོགས་ལ་ཕན་གྲོགས་བྱེད་མཁན་དེ་འདྲ་ཡིན་ལུགས་བརྗོད་ཀྱི་འདུག་༡༩༥༧ དང་༥༨ ལོར་ངོས་རང་འགྲོ་སྐབས་ག་རྒྱ་འགྲམ་ནག་གི་བུ་ག་རྒྱ་བླ་ནག་ཟེར་བ་ཞིག་འདུག་ཅིང་།",
    "ཡུལ་དེར་གཉེན་སྤུན་མང་པོ་ཡོད་པ་རེད།",
    "ཡིན་ནའང་ཁོང་གི་གནས་སྟངས་ངོས་རང་གིས་དངོས་བྱུང་དངོས་མཐོང་གིགནས་ཚུལ་གོང་དུ་ཡང་ཕྲན་བུར་བཀོད་ཡོད་ལ།",
    "༡༩༥༩ ལོར་ཛ་དྲག་ཉེན་འགན་ཆེན་པོའི་སྐབས་རང་དོན་བློས་ལིང་གིས་བཏང་སྟེ།",
    "ཕྱི་ལོ་༡༩༨༥ ཟླ་༦ ཚེས་༡ རེས་གཟའ་ཟླ་བ།",
    "འཕྲོད་ཆེན་ལང་ཚོ་སོགས་དང་།",
    "བཀའ་ཤག་གི་སྐུ་ཚབ་ཏུ་ངོས་རང་ནས་མཎྜལ་སྐུ་གསུང་ཐུགས་རྟེན་འདེགས་འབུལ་ཞུས་པར།",
    "ཚོགས་སྐྱིད་ཁག་གི་འགོ་འཐུས།",
    "མང་ཚོགས་བཅས་པས་མཇལ་དཪ་རྟེན་དོད་འབུལ་བཞེས།",
    "ཤིས་བརྗོད་དང་བཅས་དེ་ཉིན་གྱི་མཛད་སྒོ་ཤིན་ཏུ་བཀྲ་ཤིས་ལོ་ལེགས་སུ་གྱུར་པ་རེད།",
    "གཉིས་ནས་གཞིས་ལུས་བོད་མི་རྣམས་ལུས་སེམས་དཀའ་སྡུག་གི་འོག་བྱེས་འབྱོར་གཞུང་མང་ལ་རེ་བ་ཆེན་པོ་བྱས་ནས་ཡོང་དང་ཡོང་བཞིན་པར།",
    "དེ་མཚུངས་བོད་ནས་གསར་དུ་ཡོང་དང་ཡོང་མུས་ཀྱི་ཁོངས་ནས་དེ་སྔ་གཞུང་གི་ཞབས་ཁོངས་སུ་ཡིན་པ་འབྱོར་ཐུབ་ཚད་ལ་བཙན་བྱོལ་གཞུང་གི་ཁོངས་སུ་ལས་གནས་གོ་རིམ་གནང་གི་ཡོད།",
    "གླིང་བླ་བྲང་གི་དེ་སྔོན་ཞབས་ཞུ་བ་འཕྲིན་ལས་ཕུན་ཚོགས།",
    "ད་ཆ་རྒྱ་དམར་གྱིས་གསོད་དོགས་མེད་པའི་གནས་སྐབས་ལ་སོང་།",
    "གཞིས་ལུས་བོད་མི་མང་གི་མདུན་ལམ་ཁེ་ཕན་བཟང་པོ་ཞིག་ཡོང་ཆེད་དུ་ཡིན་པ་དང་།",
    "ལོ་ཤས་སྔོན་ནས་གོང་ས་མཆོག་གི་བཀའ་དྲིན་གྱི་འོག་ནས་གཞིས་བྱེས་བོད་མི་རྣམས་གཉན་འཕྲད་འགྲོ་འོང་ཀྱི་གོ་སྐབས་ཐོབ་པ་དང་།",
    "དེ་ཙམ་དུ་མ་ཟད་བཙན་བྱོལ་བོད་གཞུང་གི་ལམ་ལུགས་ལ་འགྱུར་འགྲོས་ཞིག་ཕྱིན་པ་ཙམ་ལས།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ནས་ཐད་ཀར་སྔར་ལམ་བཞིན་བཀའ་བློན་བསྐོ་གཞག་མཛད་པའི་བཀའ་ཤག་འདི་སྔར་ལུགས་ཀྱི་བོད་གཞུང་བཀའ་ཤག་གི་རྒྱུད་རིམ་ངོ་མ་དེ་ཡིན།",
    "ད་ལྟ་ཁྱེད་རང་རྣམ་པའི་ཁོངས་སུ་༡༩༥༩ སྔོན་གྱི་གཞུང་ཞབས་འགའ་ཞིག་ཡོད་པ་རྣམས་བོད་གཞུང་གི་གཞུང་ཞབས་རང་གནས་སུ་ཡོད་པ་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད།",
    "གང་ཡོད་པ་ཐམས་ཅད་གཞིས་ལུས་བོད་མི་ས་ཡ་དྲུག་ལ་ཡོད་པ་ཞིག་ངོས་འཛིན་བྱེད་རྒྱུ་རེད།",
    "གཞི་རྩ་དེ་འདྲ་ཞིག་ཏུ་གནས་ཡོད་པར་བརྟེན་ཁྱེད་རྣམ་པས་ཐུགས་གཡེང་གནང་དགོས་རྩ་བ་ནས་མེད་པ་རེད།",
    "གསར་འགོད་བྱེད་མཁན་སུ་ཡིན་མཁྱེན་རྟོགས་ཡོང་བའི་བཀའ་རྩད་མཐིལ་ཕྱིན་ཞིག་ངེས་པར་དུ་གནང་ན་དགེ་མཚན་ཡོད་ངེས་མཐོང་གི་འདུག་དེབ་བཅུ་གཅིག་པ།",
    "ལགས་པས་དེ་དོན་ཐུགས་འགན་བཞེས་གལ་ཞེས་ཞུས་སོང་བར།",
    "བསྟན་པ་ཚེ་རིང་གཉིས་ལ་བཀའ་རྩད་གནང་དགོས་ལུགས་ཞུས་སོང་བ་དང་།",
    "དྲིལ་བསྒྲགས་དྲུང་གཞོན་བསྟན་པ་ཚེ་རིང་གཉིས་སོ་སོར་བཀའ་རྩད་གནང་ཆེད་བཀའ་ཤག་ཏུ་འབོད་འགུག་གིས་གཞོན་ནུའི་གསར་ཤོག་ཐོག་གཞི་བྱེས་བོད་མིའི་དབར་དང་།",
    "བསམ་ཚུལ་དངོས་སུ་ཡོད་བསྡད་པ་ནི་བོད་ནས་གསར་འབྱོར་ཆབ་སྲིད་ལ་འཁུར་ལེན་ཆེན་པོ་ཡོད་མཁན་བདེ་ཆེན་རྒྱ་མཚོ་ཡིན་དགོས་ཀྱི་རེད།",
    "ཁོང་རང་ལོ་གཞོན་སྐྱེས་ཡིན་པ་མ་གཏོགས་སྐུ་དྲག་གི་མི་བརྒྱུད་དེ་འདྲ་ཡིན་པ་རེད།",
    "བྱེས་འབྱོར་གཞུང་མང་ཕན་ཚུན་ཁྱད་པར་ཕྱེ་བ་ལྟ་བུ་ཆགས་མི་ཉན་པ་རེད།",
    "མི་ཆེན་བླ་ཆེན་རྣམས་ཡིན་སྟབས་ང་ཚོ་བྱེས་སུ་འབྱོར་བ་ཚོས་དེ་འདྲའི་རྣམ་པ་ཆགས་ན་ཡེ་ནས་འགྲིགས་ཐབས་མེད་པ་རེད།",
    "རྒྱ་དམར་གྱི་བཙན་གནོན་འོག་སྐུ་དྲག་ཉུང་ཤས་ཤིག་ལྷག་ཡོད་པ་དེ་དག་ལ་ང་ཚོས་རྡུང་རྡེག་ལྟ་བུ་ཆགས་པ་ཡིན་ན།",
    "ང་ཚོ་ཡང་རྒྱ་མིའི་ཕྱོགས་སུ་ཕྱིན་པ་ལྟ་བུ་དང་།",
    "དེང་སང་གཞིས་བྱེས་གཉིས་སུ་འཚར་ལོང་ཡོང་གི་ཡོད་པའི་གཞོན་སྐྱེས་ཚོར་བོད་དོན་དང་ཆབ་སྲིད་ཐོག་ལྷག་བསམ་འཁུར་ལེན་བྱེད་ཀྱི་ཡོད་པ་འདི་ཡག་པོ་ཡིན་ཡང་།",
    "བོད་ནས་གསར་དུ་འབྱོར་བའི་མི་སྣ་ཆེ་ཕྲ་མཐའ་དག་བལ་ཡུལ་བརྒྱུད་རྒྱ་གར་དུ་ཡོང་ཚད་ཐམས་ཅད་ཐོག་མར་ལྡི་ལི་བརྒྱུད་བཞུགས་སྒར་རྡ་རམ་ས་ལར་འབྱོར་བ་རྣམས་ཀྱི་རེ་དོན་དང་པོ་ནི་གོང་ས་མཆོག་མཇལ་ཞུ་ཕྱག་འབུལ་ཞུ་ཐབས་དེ་རང་ཡིན།",
    "དེ་མཚམས་བཞུགས་སྒར་དུ་ཡོད་པའི་སྔོན་འབྱོར་བ་རྣམས་ལ་སྤྱི་དང་བྱེ་བྲག་གིས་ཕན་ཚུན་གཏམ་གླེང་སྤེལ་རྒྱུ་དེ་ཡིན།",
    "བོད་གཞུང་གཉིས་གཅིག་གྱུར་ཡིན་ཤག་བྱེད་ཀྱི་རེད་ལ།",
    "ཚོ་ཁག་༡༣ ནས་གཞུང་གི་སྒྲིག་བཙུགས་ཁོངས་སུ་ཞུགས་མིན་ལྟ་བུ་གནས་ཚུལ་ཡོད་པ་དེ་སྐོར་བོད་ནས་གསར་དུ་འབྱོར་བའི་མི་གྲངས་༡༤ ཙམ་གོ་བསྡུར་བྱུང་དོན་ལ།",
    "རེད།",
    "གང་འདྲ་ཞིག་རེད་ཅེས་ཞུས་ན།",
    "ཁྱིམ་ཚང་གི་མིང་མཉམ་སྦྱར་མི་ཆོག་པ།",
    "མི་ཆེན་རྣམས་མགོ་གནོན་ནུས་མེད་བྱེད་པའི་ལས་འགུལ་རྒྱ་དམར་དང་གཉིས་སུ་མེད་པའི་བྱ་སྤྱོད་ཤུགས་ཆེ་སྤེལ་བ་རེད།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ནས་རང་རེ་བོད་མི་བཙན་བྱོལ་བ་རྣམས་མ་འདོད་བཞིན་དུ་མི་ཡུལ་ཆེན་པོ་ཞིག་ཏུ་གྱར་ནས་ཡོད་ནའང་།",
    "རེ་གཉིས་ཙམ་བསམ་པ་ལྟར་གཞིས་ཆགས་མ་ཐུབ་པ་མ་གཏོགས།",
    "རང་གཞུང་གི་མཛད་འགན་གཞི་རྩའི་ཆར་འཕྱར་གྲུ་མཉམ་འདེགས་ཀྱིས་རྩ་འཛུགས་ཐུབ་སྟེ།",
    "བྱས་རྗེས་རང་བཞིན་ལྡན་པ་བྱུང་བསྡད་ཡོད་པ་ཞིག་རེད།",
    "དགོན་ཡུལ་གཉིས་འདུས་སུ་ཡོད་པ་དེ་རེད།",
    "འབྲུག་པ་དཀར་བརྒྱུད་ཀྱིས་དགོན་གནས་བཅས་རྩ་འཛུགས་གྲུབ་ནས་ཡོད་པ་རེད་ལ།",
    "ངོར་མ་དགོན་གྱི་གདན་ས་དེ་ཆགས་ཡུལ་བདེ་སྐྱིད་གླིང་གཞིས་ཆགས་ཀྱི་ཁོངས་སུ་ས་ཆ་སྦི་གར་ཟེར་བ་བཞི་ཙམ་གནང་རོགས་ཞེས་རང་གཞུང་བཀའ་ཤག་ལ་ཞུས་སོང་བར།",
    "ཐོག་མའི་ཆར་ཞལ་བཞེས་གནང་སོང་ཡང་།",
    "རྗེས་སུ་འགྱུར་བ་ཕྱིན་སྟེ་གནང་ཐུབ་མ་སོང་།",
    "དེ་རྗེས་གླིང་ཚང་གཞིས་ཆགས་ནས་ས་ཆ་ཕུལ་བ་རེད།",
    "སྒ་པ་འདན་མ་སོགས་ཁམས་ཤར་ནུབ་ཀྱི་ས་དགོན་ཡོངས་སུ་རྫོགས་པས་བསྙེན་རྫོགས་ཀྱི་སྡོམ་པ་ཞུ་ཡུལ་དེ་ཁོ་ན་ཡིན་པས་ཁམས་རིགས་མང་པོས་རྩ་ཆེར་བརྩི་བ་ཞིག་རེད།",
    "ད་ཆ་གཞུང་ནས་གཞིས་འགོ་བསྐོ་འཛུགས་གནང་ཡོད་པ་རེད།",
    "སྡོད་སྒར་བཞི་པའི་མི་མང་གིས་མཚོན་ཕ་ཡུལ་གཅིག་པ་དང་།",
    "གཅིག་སྒྲིལ་ཚོགས་པའི་ལྟ་སྤྱོད་ཀྱི་ཆ་ནས་གདོན་གཅིག་གི་ན་ཚ་ཟེར་བ་ལྟར་གྱིས་ཚོ་ཁག་༡༣གྱི་བླ་དཔོན་མི་སྣ་རྣམས་དང་རང་ཤུགས་ཀྱིས་འབྲེལ་བ་ཆགས་ཏེ་ལྟ་ཕྱོགས་གཅིག་གྱུར་དུ་ཡོད་པ་རེད།",
    "གཅིག་སྒྲིལ་ཚོགས་པའི་ལྟ་སྤྱོད་ལ་མོས་མཐུན་མི་གནང་བ་དང་།",
    "དངོས་ཡོད་ཀྱི་གནས་སྟངས་དེ་འདྲ་ཞིག་ཏུ་ཆགས་ཡོད་པར་བརྟེན་ཕན་ཚུན་གྲོས་མོལ་ལྟ་བུ་གནང་སྟེ་ཐག་གཅོད་འདི་ཡིན་ཟེར་བ་ལྟ་བུ་བྱ་ཐབས་མེད་པ་ཞིག་མཐོང་གི་ཡོད།",
    "དགའ་མིན་ཕྲག་དོག་གི་གཏམ་གླེང་།",
    "གོང་ས་མཆོག་གིས་དབུ་ཁྲིད་པའི་རང་གཞུང་གི་གཞི་རྩའི་སྲིད་བྱུས་ནི།",
    "ཐོག་མའི་ཆར་ངོས་ལེན་བྱེད་མིན་གྱི་གནས་ཚུལ་ཇི་ལྟར་ཇི་སྙེད་ཡོང་གི་ཡོད་ཅིང་།",
    "ཚོ་ཁག་༡༣ གྱི་ཁོངས་མི་འགའ་ཞིག་གིས་ངོས་ལེན་བྱེད་མིན་གྱི་གནས་ཚུལ་བྱུང་ཡོད་པ་རེད།",
    "ཕོགས་ཐོབ་བརྒྱ་ཆའི་འབབ་བཅས་ལོ་རེའི་འབོར་བསྡོམས་གྲངས་ཚད་རེ་འབུལ་རྒྱུའི་འགོ་འཛུགས་ཐུབ་ཙམ་བྱུང་།",
    "གོང་ས་མཆོག་གི་དགོངས་བཞེད་ཟབ་མོར་ཡོད་པའི་ཆོལ་གསུམ་བོད་མི་ཡོངས་རྫོགས་གཅིག་གྱུར་ཡོང་བའི་མཛད་ཕྱོགས་ཡོད་པ་འདིར།",
    "ཡང་ན་སྐབས་འཚོལ་རེ་བྱེད་ཀྱི་ཡོད་པ་ཡིན་ནའང་འདྲ།",
    "ད་དུང་ཁོང་གི་གཟིགས་ཚུལ་རང་བཞིན་ཅན་དུ་ཡོད་པ་ཞིག་སྟེ།",
    "གོང་ས་མཆོག་གི་དབུས་བྱེས་ཀྱི་གཞུང་དམངས་ཡོངས་ལ་རང་གི་རྒྱལ་ཁབ་དང་བྲལ་ཏེ་གཞན་ཡུལ་དུ་རང་འཚོ་འཛིན་ཐབས་མཛད་རྒྱུ་སོགས་གང་ཅིར་སྐུ་ངལ་ཆེན་པོ་བྱུང་ཡོད་པ་ནི་གཞིར་གྲུབ་པ་ཞིག་དང་།",
    "ས་སྟེང་འདིར་མི་དར་བ་ཞིག་བོད་སྤྱི་དང་བོད་མི་སྒེར་རེ་རེར་བྱུང་ཡོད་པ་དག་རང་བཞིན་བརྗོད་ཀྱིས་མི་ལང་པ་ཞིག་ཡོད་པ་ཡིན་ཅིང་།",
    "གོང་ས་མཆོག་གི་བཀའ་དྲིན་ལས་བོད་མི་རྣམས་ཀྱིས་རེ་ས་སྐྱབས་གནས་གཅིག་ཉིད་ཀྱི་དབུ་ཁྲིད་པའི་འོག་མི་རབས་ཀྱི་ལྷག་མ་རྣམས་ནས་དངོས་དོན་ལ་འཇུག་ཐུབ་པ་ཞིག་ཡོང་དགོས་ན་ཡང་།",
    "གོང་ས་མཆོག་གི་དབུ་འོག་ཏུ་བྱེས་འབྱོར་བོད་གཞུང་གི་རྟེན་གཞི་འཛིན་ཐུབ་སྟེ།",
    "བོད་མི་ཚང་མས་དོན་མེད་ནང་རྩོད་བྱེད་པའི་སྣང་ཚུལ་ལ་འགྱུར་བ་འགྲོ་ཐབས་སུ་མི་ལོ་༢ རིང་གི་བོད་མིར་སྔག་སྦྱོང་ཇི་ཕོག་དང་།",
    "སྤྱིའི་གནས་སྟངས་ངོ་མ་གང་འདྲ་ཞིག་ཏུ་སླེབས་ཡོད་པའི་སྐོར་བྱེས་འབྱོར་མང་ཚོགས་ལ་ངོ་སྤྲོད་འདྲ་ཐུབ་རེ་མེད་དམ་ཞེས་དགོངས་ཚུལ་མང་དག་ཡང་ཡང་གསུང་གི་འདུགཁོང་ཉིད་ཀྱི་དགོངས་ཚུལ་རྣམས་བཀའ་ཤག་ལྷན་རྒྱས་ལ་ཞུས་ཐོག་དེ་རྗེས་བཀའ་ཤག་ལས་དོན་ཆེད་གོང་ས་མཆོག་གི་མདུན་ལམ་དུ་ཞབས་བཅར་ཞུ་བའི་སྐབས་ཤིག་ཏུ་སྙན་གསོལ་ཡང་ཞུས་པ་ཡིན།",
    "གནས་སྐབས་འདི་རེས་སུ་བོད་དང་བོད་མིའི་གནས་སྟངས་ནི།",
    "སྲིད་པ་ཆགས་ནས་བཟུང་གི་དུས་རིམ་ནང་བྱུང་མ་མྱོང་པ་དང་།",
    "དངོས་དོན་ངོ་མར་བསམ་ཤེས་མེད་པའི་བོད་མི་འགའ་རེ་ཡོད་པར་རྒྱ་མི་དམར་པོའི་གཞུང་གི་སྲིད་བྱུས་དང་།",
    "རྒྱ་མི་ནག་པོའི་གཞུང་གི་སྲིད་བྱུས་གཉིས་ཀ་ནས་བོད་དེ་རྒྱ་ཡི་ཁོངས་སུ་འཇུག་རྒྱུར་གཅིག་གྱུར་དུ་ཡོད་པ་ངེས་གཏན་ཡིན་པར།",
    "ནག་པོ་ནི་གོ་མིན་ཏང་ལ་ཟེར་རྒྱ་ནག་དམར་པོའི་གཞུང་གིས་བོད་ཡོངས་རྫོགས་བཙན་བཟུང་གིས་མུ་མཐུད་བོད་ཡུལ་རྒྱ་ཡུལ་ལྟ་བུར་བསྒྱུར་ཐབས་ཀྱི་སྲིད་བྱུས་སྤེལ་བཞིན་པ་ལ་དམིགས་བསལ་འགྲེལ་བརྗོད་མ་དགོས་པ་ལྟ་བུ་ཡིན།",
    "གོ་མིན་ཏང་གི་སྲིད་བྱུས་ལས་བོད་རྒྱ་ཁོངས་སུ་འཇུག་ཐབས་བྱེད་པ་དེ་ནི།",
    "ཡོང་རེ་རྩ་བ་ནས་མེད་ནའང་ཅང་ཅེ་ཧྲི་ཁོང་རང་གི་དམིགས་ཡུལ་འགྱུར་མེད་ཀྱི་སྲིད་བྱུས་ཡིན་པ་༡༩༧ ལོར་རྒྱལ་ཚོགས་ནང་རྒྱ་ནག་སྟོབས་ཆེན་རྒྱལ་ཁབ་ཀྱི་ཞབས་སྟེགས་གུང་ཁྲན་ལ་ཤོར་བའི་ལོ་དེར།",
    "ཨ་མི་རི་ཀ་དང་།",
    "ཐོག་མའི་ཆར་གོ་མིན་ཏང་གི་སོ་པ་འམ།",
    "དྲུང་ཡིག་ལྷ་མོ་ཚེ་རིང་ཅན་དང་འབྲེལ་བ་བྱས་པ་མ་ཟད།",
    "རྒྱ་གར་གསང་ལས་པ་བཅས་ཁོང་ཚོ་དང་འབྲེལ་བ་བྱས།",
    "དཀར་མཛེས་ཞི་པ་ཚང་གི་ཚ་བོ།",
    "དེ་ནས་ཁོང་ཚོས་གོང་རིམ་དེ་དག་དང་བརྒྱུད་འབྲེལ་མ་མ་བྱས་པར་ཐད་ཀའི་ཐད་ཀར་བོད་མི་རྣམས་ལ་དངུལ་སྤྲད།",
    "ཕྱི་ནང་གསང་གསུམ་དུ་གོ་མིན་ཏང་གི་མི་དེ་ཚོས་ལས་ཀ་མང་པོ་བྱས།",
    "རྡོར་གླིང་བཅས་སུ་ཡོད་པའི་རྒྱ་མི་སྔོན་མ་ནས་ཡོད་པ་ཁག་ཅིག་ཀ་ལི་ཀར་རྒྱ་གར་གཞུང་གིས་གནས་སྤོས་བྱེད་དུ་བཅུག་པ་དེ་དག་ལ་སྲིད་དོན་དོགས་གཞི་ཆགས་རེད་ཟེར་ཡང་།",
    "གོ་ཏང་གི་མི་ཁག་ཅིག་དང་རྒྱ་གར་གསང་ལས་དབར་འབྲེལ་བ་ཡོད།",
    "སྐབས་དེ་དུས་བོད་མི་རྣམས་གྲོན་དངུལ་མེད་པའི་དཀའ་ངལ་ཆེ་སྒང་ལ་བརྟེན་དངུལ་ལ་བལྟས་ནས་མི་འགའ་རེས་ཁོང་ཚོར་འབྲེལ་བ་བྱས།",
    "ཐའེ་ཝན་མི་མང་དང་བོད་མིའི་དབར་འགལ་རྙོག་གི་གཞི་རྩ་ཆེན་པོ་མུ་མཐུད་དེ་ཆགས་པ་རེད།",
    "དྲུང་ཡིག་ལྷ་མོ་ཚེ་རིང་ཅན་དང་ཐོག་མའི་བརྒྱད་འབྲེལ་དུ་མ་གནས་པར།",
    "ཆབས་ཅིག་བོད་མི་སུ་ཞིག་ནས་ཁོང་ཚོའི་དངུལ་ལེན་མི་རུང་བ་དང་།",
    "ཁོང་ཚོའི་ལས་དོན་བྱེད་མི་རུང་བ།",
    "ཁོང་ཚོའི་སོ་ལས་པ་དང་འབྲེལ་བ་བྱེད་མི་རུང་བའི་ངོ་སྤྲོད་ཁྱབ་སྤེལ་བྱས་པ་དང་།",
    "ཁོང་ཚོར་ཁས་མི་ལེན་མཁན་གྱི་བོད་མི་རྣམས་ཟུར་འདོན་བྱེད་ཐུབ་ན་བསམ་པའི་ལས་འགུལ་གྱིས་ས་དཀྲུག་ཡོ་དཀྲུག་ལུང་པ་གང་བ་བཟོས།",
    "ཁོང་ཚོས་ནག་སྐྱོན་འཛུགས་ཡུལ་ནི།",
    "ཨ་དོ་བ་ཡིན་པའི་མི་ཤ་སྟག་ལ་སྐྱོན་འཛུགས་བྱེད་ཀྱི་ཡོད་པ་རེད།"
  ]
}