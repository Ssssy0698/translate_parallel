    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
    "སྦུ་གྲིའི་ཐང་ལ་རྐང་པ་བཞག་དུས་གཤོག་ཅིང་།",
    "གཞན་དེ་འདྲའི་མང་པོ་ཞིག་ཕ་མ་བྱེད་མ་མྱངས་ཡང་བློས་གཏང་ཕོད་པར་མི་འདུགདེ་ཐམས་ཅད་སྡུག་མྱོང་དུ་ཆུག་ང་ཁེ་རུ་མ་བདེ་དགོས་ཟེར་ན།",
    "མཁྱེན་ཆ་ལྷུན་གྱིས་གྲུབ་པ་དང་རང་བཞིན་འདུས་མ་བྱས་པས་སོ།",
    "དབྱིངས་ལ་སྣང་སྟོང་རང་བཞིན་གཉིས་མེད་པས།",
    "ངོ་བོ་སྟོང་ཞིང་རང་བཞིན་གསལ་བ།་",
    "ལམ་གྱིས་སའི་དྲི་མ་དག་དུས་འཇིག་རྟེན་དུ་སྒྲོན་མེ་བཀོད་པས་འགྲོ་བའི་མུན་པ་སེལ་ཏེ།",
    "སྐུ་འདྲ་མགར་བླུག་གང་ཡིན་ན་ཡང་གནའ་བས་ཡག་དང་ད་བས་མཛེས་ཤིག་བྱེད་ཆོག་འདུག་ལ།",
    "ལྷ་ཁང་ཡང་གནའ་བས་ཆེ་དང་མཛེས་བཟོ་ཆོག་འདུག་དེས་ན་མི་ཐོག་སྔོན་མའི་ཉམས་མྱོང་བླངས་ནས།",
    "ནང་ཆེན་སོགས་སྲེད་རྨོངས་སྒེར་སྤྱོད་ཀྱི་རིགས་དེ་ཚོ་བསྐྱར་གསོ་མ་ཐུབ་ཀྱང་སྐྱོན་ས་མི་འདུག་བསམ་ཁི།",
    "ད་རུང་དེ་ཚོ་མེད་ན་དུས་རབས་དང་མཐུན་འདུག་བསམ་ཁི།",
    "དེ་ནི་ཐུབ་ས་མི་འདུག་ཀྱང་བསམ་དགོས་པ་མ་ཡིན་ཏེ།",
    "ཁང་བུ་བརྩེགས་པ་སྟོང་ཕྲག་ལ་ཡང་འདུག་ཆོག་པར་གསུངསཡོད།",
    "ཕ་རོལ་པོའི་སེམས་རྒྱུད་མ་དཔོག་དུས།",
    "རང་ལུགས་ཀུན་མཁྱེན་ཆེན་པོས་བཞེད་པ་ལྟར་ན་བློ་རྫས་གཅིག་དུས་གཅིག་ལ་བྱེད་པ་གཅིག་པའི་བདག་ཉིད་དུ་འདོད་ཅིང་།",
    "བསྐྱེད་རྫོགས་ལ་བརྟན་པ་ཐོབ་ནས་རིམ་གཉིས་དབྱེར་མེད་དུ་ཟུང་དུ་འཇུག་དུས་ཀྱང་བསྐྱེད་རྫོགས་སོ་སོའི་ལྡོག་པ་དེ་བཞིན་དུ་གནས་སོ།",
    "གནས་དབེན་ཞིང་ཡིད་དུ་འོང་བར་སྟན་བདེ་བ་ལ་འདུག་ནས།",
    "ཡེ་ཤེས་དེ་སྐྱེ་བའང་རང་ལ་ཡོད་པ་ཙམ་གྱིས་མི་འཆར་བས་ཐོག་མར་ཐབས་དུ་མ་ལ་བརྟེན་དགོས་སོ།",
    "རང་རང་རྒྱུད་ལས་ཇི་སྐད་གསུངས་བཞིན་བསྒོམ།",
    "ཉན་ཐོས་དག་དང་རང་རྒྱལ་གྱི།",
    "ད་སྔོན་བྱས་པས་ལེན་པ་ཡིན་པས་ད་ནི་མ་བྱས་སོར་བཞག་གྱིས་དང་དེའི་ཐོག་ཏུ་འདུག་ཐུབ་ན་རབ་ཡིན་པར་སྨྲ་བ་དང་།",
    "གནས་པས་མ་ཚད་ཐིམ་པའི་འགྲོས་དང་སྦྱར་རྒྱུའི་གོ་བ་ཡང་རང་ཤུགས་ཀྱིས་ཡོད་པ་ཡིན།",
    "ཁ་གསག་ཐོབ་འཇལ་ལ་སོགས་པ་མང་པོ་ཞིག་འཛོམ་འདུག་དགོས་པས།",
    "བཟང་ངན་དང་ལེགས་ཉེས་དེའང་རང་བཞིན་དུ་ནོར་མ་ནོར་དཔྱད་ནས་འདོར་ལེན་བྱེད་པ་ཙམ་ལས།",
    "དེ་ཡང་རངཆས་སུ་དབྱིངས་ལ་ཡེ་ནས་ཡོད་པ་ཞིག་ཡིན་ཅིང་།",
    "དབེན་ཞིང་ཡིད་འོང་བྲག་རིའི་དྲུང་འདུག་སྟེ།",
    "གནས་འདི་རུ་ཡང་བསྐྱར་ལོག་དུས།",
    "མེ་ཏོག་སེར་ཆེན་ནི་མེ་ཏོག་གངས་ལྷ་སོགས་དང་མཉམ་འདུག་མཉམ་འགྲོགས་བྱས་ཆོག་པ་མ་ཟད།",
    "བརྩེ་དུང་ཁྱེར་ནས་མེ་ཏོག་སེར་ཆེན་གྱི་བཅུད་དག་རྫོགས་པའི་གེ་སེར་རྣམས་ལ་ཅི་དགར་ལོངས་སུ་སྤྱོད་བཞིན་འདུག་ཕྱོགས་དང་ཕྱོགས་སུ་རྒོད་པའི་མེ་ཏོག་སེར་ཆེན་ནི་ཡིད་དུ་འོང་བའི་སྤང་ལྗོངས་ཀྱི་ཐང་ག་གསོན་པོ་ཞིག་ཏུ་གྲུབ་སྟེ།",
    "ཐབས་མི་འདུག་ལ།",
    "མི་ཡུལ་འདིའི་མཛེས་སྡུག་ལྡན་པ་ཡོད་ཚད་ཀྱང་དེ་དག་དང་ཐ་དད་དུ་དབྱེ་ཐབས་མི་འདུག་པས།",
    "ང་རང་ཉིད་ཆུང་དུས་སུ་ལུག་ཁྱུ་དང་མཉམ་དུ་ཐེངས་མང་པོར་གྱེན་ལ་འགོས་མྱོང་བ་དང་ནོར་ཁྱུ་དང་ལྷན་དུ་ལན་མང་པོར་ཐུར་ལའང་འབབ་མྱོང་བའི་རི་བོ་ཞིག་ཏུ་ཁམས་བསངས་ལ་ཕྱིན།",
    "དྲང་པོའི་རང་གཤིས་དེ་དག་རྟག་ཏུ་ངོམ་བཞིན་འདུག་པས།",
    "ཚེ་སྲོག་དང་ཚེ་སྲོག་རྒྱུན་མཐུད་བྱས་པའི་བར་གསེང་དེ་ནས་ང་ཡིས་ཀྱང་རང་ཉིད་ཀྱི་ཡིན་ཆོག་པའི་ཆེས་གསལ་བའི་འོད་མདངས་ཤིག་མཐོང་བ་མ་ཟད།",
    "ཤིན་ཏུ་འཇགས་པའི་མཚན་ལྗོངས་ཀྱི་འཇིག་རྟེན་དེ་ན་ནམ་རྒྱུན་ངའི་མཐའ་འཁོར་དུ་ཁ་ཁ་སོ་སོར་སྣང་ཞིང་ཟང་ཟིང་སྒྲོག་པར་དགའ་བའི་མི་ཚོགས་དེས་རྨི་ལམ་ཅི་དང་ཅི་ཞིག་རྨི་བཞིན་འདུག་པ་ཧ་ཅང་རྟོགས་དཀའ།",
    "ང་ནི་མི་དར་མ་ཞིག་ཏུ་གྱུར་འདུག་པ་ཡིན།",
    "ངག་སྒྲོས་ཁ་ཤས་ནི་ད་ལྟའི་བར་དུ་འདི་ལྟར་གྲགས་ཀྱིན་འདུག་སྔོན་ཆད་ཅིག་ལ་ཧ་ཅང་ཐག་རིང་བའི་ས་ཆ་ཞིག་ནས་དབུལ་པོ་ཞིག་དང་།",
    "ཡང་ན་གཏམ་རྒྱུད་དེ་མུ་མཐུད་ནས་བྱུང་མུས་སུ་འདུག་ཀྱང་སྲིད།",
    "གནས་འདི་རུ་ཡང་བསྐྱར་ལོག་དུས།",
    "སྐབས་དེར་ང་རྒུ་རུའི་རྩྭ་ཐང་དུ་ཟླ་ཤས་རིང་ལ་མ་གཏོགས་འདུག་ཁོམ་མ་བྱུང་ཡང་།",
    "ཐག་ཉེ་ཐག་ཉེ་ཞིག་ལ་ལྟ་བཞིན་དུ་འཚང་ཁ་ཤིག་ཤིག་བྱེད་ཀྱིན་འདུག་དེ་ཡང་ཡིན་ཏེ།",
    "ཆུ་ཕྲན་དེ་སྔར་བཞིན་ཤག་ཤག་བཞུར་གྱིན་འདུག་ལ།",
    "རྡོ་རྩིག་དེ་ཕལ་ཆེར་ཞིག་རལ་དུ་གྱུར་ནས་ཡི་གེ་ཅན་གྱི་རྡོ་ལེབ་རྣམས་ཡར་མར་ཀུན་ལ་ལྷུང་འདུག་པ་དང་།",
    "ཁ་བ་ཞུ་ནས་ཀྱང་ཚར་འདུག་ཞོགས་དུས་ཀྱི་ཉི་འོད་འོག་ཡོང་སྐྱེན་པའི་ཁ་བ་དེས་ངའི་ཕ་ཡུལ་གྱི་རི་ཀླུང་ཀུན་ལ་གསོན་ཤུགས་དང་དཔྱིད་དཔལ་གསར་བ་ཞིག་སྦྱིན་ཚར་བས།",
    "ཞོགས་དུས་དེར་ང་འཆམ་འཆམ་ལ་འགྲོ་བཞིན་གདའ།",
    "ག་དུས་ཡིན་ཡང་གནས་འདི་རུ་གཏན་སྡོད་བྱས་ཆོག་པའི་སྐུ་མགྲོན་ཡིན་ལ།",
    "ག་དུས་ཡིན་ཡང་གནས་འདི་རུ་སླེབས་ཤིང་།",
    "ནམ་མཁའ་རུ་ལྷན་ནེར་འཛུམ་ཞིང་ཉ་གང་བའི་དཀར་གསལ་གྱི་ཟླ་བ་དེས་གཏམ་རྒྱུད་མང་པོ་ཞིག་གླེང་བཞིན་འདུག་ལ།",
    "སྐབས་དེར་རི་འགོ་ན་ར་ལུག་འཚོ་བཞིན་མཆིས་པའི་རྒད་པོ་དེར་སྔར་བཞིན་སེམས་ཁྲལ་དང་གྲག་འགུལ་ཅི་ཡང་མེད་པར་འགྲོ་བཞིན་འདུགངོ་མ།",
    "འཚོ་བའི་བག་ཆགས་ཀྱི་རྐྱེན་གྱིས་ངས་ཀྱང་རང་ཤུགས་ཀྱིས་རྡོ་རིལ་འགའ་བཏུས་ཏེ་ལབ་ཙེ་ལྟ་བུར་སྣང་བའི་རྡོ་སྤུངས་དེའི་སྟེང་དུ་བཞག་པ་དང་སྐོར་བ་གསུམ་བྱས་རྗེས་དགོན་ཤུལ་དེར་རྒྱང་ལྟ་བྱས།",
    "ནམ་ཡང་ཡིད་ཆེས་བྱེད་མི་ཐུབ་པའང་རང་ཉིད་དང་རང་ཉིད་ཀྱི་བརྩེ་དུང་ཡིན།",
    "ངེད་གཉིས་ལམ་ལ་ཆས་སྐབས་ཐུབ་བསྟན་རྒྱ་མཚོས་གཏེར་བུམ་ཞིག་ཀྱང་ཁྲིགས་ཁྲིགས་བྱས་འདུག་ལ།",
    "ད་དུང་ངེད་གཉིས་ཀྱིས་བརྒྱུད་དེ་འོངས་པའི་ལམ་ཕྲན་དེའི་ཕྱེད་ཀ་ཞིག་ཀྱང་ཆུ་མཚོའི་ནང་དུ་གསལ་བོར་ཤར་འདུག་དེ་དག་ལས་ང་ཡིས་ངོ་མཚར་བའི་གཟུགས་བརྙན་གཞན་པ་ཅི་ཡང་མ་མཐོང་བའི་རྐྱེན་གྱིས་ཐུབ་བསྟན་རྒྱ་མཚོར་བལྟས་པ་ན།",
