    "ནུས་པ་སྐྱེད་པར་བྱེད་པ་ཡིན་གྱི་མི་ནུས་པ་ནི་མ་ཡིན་ནོ།",
    "བློ་སྔོན་མེད་པར་བློ་མ་ཡིན།",
    "གལ་ཏེ་བློ་སྔ་མ་རྒྱུ་ཉིད་མ་ཡིན་ནོ་དོན་གཞན་ལ་ཆགས་པས་ནུས་པ་ཉམས་ཀྱང་བློ་གནས་སྐྱེས་པར་འགྱུར་ཏེ།",
    "ནུས་པ་ཉམས་པར་བྱས་པའི་ཕྱིར།",
    "འོ་ན་དེ་ཉིད་ལས་མཐུན་པ་དང་མི་མཐུན་པའི་རྣམ་པར་ཤེས་པ་མི་སྐྱེ་བ་སྐྱེ་བ་ཡིན་པའི་ཕྱིར་ཀུན་གཞིའི་རྣམ་པར་ཤེས་པས་ཅི་ཞིག་བྱ་ཞེ་ན།",
    "ཀུན་གཞི་རྣམ་པར་ཤེས་པ་བསམ་པ་འདི་ཞོག་ཅིག།",
    "གལ་ཏེ་རྣམ་པར་ཤེས་པ་སྔ་མ་རྒྱུར་མི་འདོད་ན་ནི་དེའི་ཚེ།",
    "གལ་ཏེ་རྒྱུ་ཡིན་ན་སྔ་མའི་ཡིད་འཇུག་པར་མཚུངས་པ་ལ་ནི་ཡིད་ཕྱི་མ་ལྟོས་པར་འགྱུར་ཏེ།",
    "རྣམ་པར་ཤེས་པ་སྔ་མའི་ནུས་པ་མེད་ན་འགའ་ཡང་མེད་པར་འགྱུར།",
    "འདི་ལྟར་ཡིད་དེ་ཡང་རྣམ་པར་ཤེས་པ་སྔ་མ་ཉིད་ཡིན་ཏེ།",
    "དེའི་རྣམ་པར་ཤེས་པ་ཅིག་ཅར་མི་སྐྱེ་བས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ལ།",
    "དེ་ཡང་རྣམ་པར་ཤེས་པ་སྔ་མས་གཞན་ལ་ཆགས་པས་མི་མཐུན་པར་འགྱུར་བ་ཉིད་ལས་ཡིན་ནོ།",
    "གང་ཞིག་ཡིད་གཅིག་པས་བྱས་པས།",
    "རྣམ་པར་ཤེས་པ་གཞན་མི་སྐྱེ་བ་དེའི་ལྟར་ན་མཚུངས་པར་འཇུག་པ་དང་གཞན་དུ་རུང་སྟེ།",
    "ངེད་ཀྱི་ལྟར་ན་ནི་མཉམ་པར་འཇུག་པ་ལ་ནི་སྐྱེ་ལ།",
    "འོན་ཏེ་ཡིད་གཅིག་ཉིད་ཡིན་པའི་ཕྱིར་ན་བློའི་བྱ་བ་གཅིག་བྱེད་པར་འགྱུར་ན།",
    "བག་ཆགས་ལས་ངེས་པའི་ཕྱིར་རྣམ་པར་ཤེས་པ་དེ་ལྟ་བུར་གྱུར་པ་ཡིན་ནོ།",
    "རྟག་པ་ནི་འགགས་ཀྱང་ཁྱད་པར་དུ་འགྱུར་བ་མ་ཡིན་ཏེ།",
    "ཁྱད་པར་དེ་ཉིད་དང་གཞན་མི་རུང་བའི་ཕྱིར་རོ།",
    "དེ་བདག་ཁྱད་པར་འགྱུར་བ་ཡིན།",
    "འོན་ཏེ་དེ་ཁྱད་པར་ཡོད་པ་ཡིན་ན།",
    "དེའི་ཚེ་ནུས་པ་ཁྱད་པར་ཅན་དང་ལྡན་པའི་རྣམ་པར་ཤེས་པ་དེ་ཉིད་དེའི་རིམ་པའི་ཕྱིར་ལུས་དང་སྐྱེས་བུ་དག་རྒྱུ་དག་ཉིད་དུ་ཁས་ལེན་པ་ནི་མེད་དོ།",
    "དེས་ན་བློ་སྔ་མ་སྐྱེད་པར་བྱེད་པ་ཡིན་ཡང་གཟུང་བ་མ་ཡིན་ཏེ།",
    "གཟུང་བར་བྱ་བའི་དངོས་པོ་ལ་ནི་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་ཉིད་གཟུང་བའི་མཚན་ཉིད་ཡིན་ནོ།",
    "སྣང་བ་ནི་ནམ་ཡང་གཟུང་བ་མ་ཡིན་པར་རྣམ་པར་ཤེས་པ་སྐྱེད་པར་བྱེད་པ་མི་སྲིད་དོ།",
    "ཆ་མེད་པའི་རྣམ་པར་ཤེས་པ་ནི་མ་ཡིན་ཏེ།",
    "གཟུགས་སོགས་དེ་ལྟར་མིན་པར་ནི།",
    "གཟུང་བ་ནི་བརྒྱུད་པས་ནི་གཟུང་བ་མ་ཡིན་པར་བློ་ལ་འདོགས་པར་འགྱུར་གྱི།",
    "དངོས་སུ་ནི་མ་ཡིན་པར་ཕན་འདོགས་པ་མི་སྲིད་པས་སྐྱེད་པར་བྱེད་པའི་བློ་ནི་གཟུང་བ་ཉིད་དོ།",
    "སེམས་ཀྱི་གཟུང་བ་ཉིད་ནི་འཛིན་པའི་རྣམ་པར་ཤེས་པའི་ཉེ་བར་ལེན་པའི་དངོས་པོ་དང་།",
    "ཐ་དད་པ་ཡི་རྟོགས་པར་འགྱུར།",
    "བློ་རྣམས་ཐམས་ཅད་རྟོགས་པར་འགྱུར།",
    "ཉིད་ཕྱིར་བདག་ཉིད་རིག་པར་གནས།",
    "གལ་ཏེ་དོན་ཉིད་ལས་རང་རིག་པ་རྟོགས་པ་ཡིན་ན་རིག་ཙམ་རྟོགས་པར་འགྱུར་གྱི།",
    "གཞན་གྱི་སེམས་རིག་པ་ཇི་ལྟར་ཞེས་བྱ་བ་འདི་ནི་ད་ལྟར་བསམ་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་འདི་ནི་གཞག་པར་བྱ་བ་ཡིན་ནོ།",
    "འདི་ཇི་ལྟར་ཞེས་བརྒལ་ཞིང་བརྟག་པར་འོས་པ་ནི་མ་ཡིན་ནོ།",
    "གཞན་གསལ་བས་རྣམ་པར་གཞག་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "གཅིག་ཚོགས་པ་གཉིས་ཀྱི་ནང་དུ་ཆུད་པས་འབྲས་བུ་དུ་མ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་ན་དེ་སྐད་བརྗོད་དེ།",
    "ཇི་ལྟར་ཡང་གཅིག་ཉིད་ནུས་པ་དུ་མ་དང་ལྡན་པ་དེ་བཞིན་དུ་འབྲས་བུ་དུ་མ་དང་ལྡན་པར་ཡང་འགྱུར་རོ།",
    "ཁྱད་པར་མེད་པའི་ཕྱིར་ཐམས་ཅད་ཀྱི་ཚེ་གཉི་ག་སྐྱེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་སྔར་གྱི་བློ་དང་གཟུགས་ལ་སོགས་པའི་དོན་འཛིན་པའི་བློ་གཉིས་སྐྱེ་བ་ཡིན་ན་དེའི་ཚེ་བློ་སྔ་མའི་དོན་དང་ཕྱི་མའི་དོན་སྣང་བའི་ཕྱིར་རིམ་གྱིས་དམིགས་པའི་གཉིས་གང་ཡིན་པ་དེ་རིམ་པ་མ་ཡིན་པར་སྣང་བར་འགྱུར་རོ།",
    "དོན་འཛིན་པར་སྣང་ན་ཡང་དོན་དེ་དེ་ཉིད་སྣང་བ་ཡིན་པའི་ཕྱིར་སྔ་མ་དང་ཕྱི་མའི་བརྗོད་པ་གཉིས་སྣང་བར་འགྱུར་རོ།",
    "རྒྱུན་མི་འཆད་པར་དོན་དུ་རིམ་གྱིས་འཛིན་པའི་དབུས་ནི་དོན་གྱིས་གོ་བ་འགའ་ཡང་མེད་དོ།",
    "དྲན་པར་གྱུར་པ་ལས་དོན་གཞན་དུ་ཡང་དོན་གྱིས་གོ་བ་ཡིན་ནོ་ཞེ་ན།",
    "དྲན་པ་ཉིད་དོན་གྱིས་གོ་བས་རྟོགས་པར་འགྱུར་གྱི།",
    "དེའི་ཚེ་གཞན་གྱིས་མྱོང་བ་མ་ཡིན་པར་འགྱུར་རོ།",
    "གཞན་གྱིས་ཡིན་ནོ་ཞེས་ཀྱང་རྣམ་པར་གཞག་པར་ནུས་པ་མ་ཡིན་པ་དེ་བཞིན་དུ།",
    "གཞན་མ་རྟོགས་པས་གཞན་མ་རྟོགས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་མིག་ལ་སོགས་པ་མྱོང་བ་མེད་ཀྱང་མིག་ལ་སོགས་པ་མེད་པར་གྱུར་ཏོ་ཞེས་བྱ་བའི་ཐ་སྙད་དུ་འགྱུར་བ་དེ་བཞིན་དུ།",
    "འགའ་ཡང་བདག་དང་འབྲེལ་པར་རྟོགས་པར་མི་འགྱུར་བས་ན།",
    "ཡིན་ན་རང་ཉིད་རིག་པར་བརྗོད།",
    "ལོག་པར་རྟོགས་པ་གསལ་བ་ནི་ཤུགས་ཉིད་ལས་འགྲུབ་ཅིང་།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ཁྱད་པར་དུ་འཕགས་པའི་བརྗོད་པ་རབ་ཀྱི་ཚིག་སྨོས་སོ།",
    "རྩོད་པའི་གཞིར་གྱུར་པའི་རྗེས་སུ་དཔག་པར་བྱ་བ་རྟོགས་པའི་ཕྱིར་ཚིག་དོན་མེད་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་རྗེས་སུ་དཔག་པ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར་ཚིག་རྗེས་སུ་དཔག་པ་ཡིན་ན།",
    "འབྲེལ་པ་དྲན་པར་གྱུར་པ་ན།",
    "ངེས་པར་རྗེས་དཔག་སྐྱེ་བར་འགྱུར།",
    "དོན་གྱིས་བསྟན་པར་འགྱུར་བ་ཡིན།",
    "འདི་ནི་རི་དགས་ལྟ་བ་ལ་མངོན་དུ་ཕྱོགས་པར་གྱིས་ཤིག་ཅེས་ངེས་པར་སྦྱོར་བ་ཡིན་ཏེ།",
    "དེས་ན་དེ་ལྟར་མངོན་དུ་ཕྱོགས་པར་འགྱུར་ན།",
    "དེས་ན་རྗེས་སུ་དཔག་པས་མངོན་སུམ་སྲིད་པར་བལྟས་ཏེ།",
    "བསྟན་པར་འགྱུར་གྱི་དུ་བ་ནི།",
    "གཏན་ཚིགས་འབའ་ཞིག་བརྗོད་པར་ཟད།",
    "ཡང་ན་དེར་ཡང་འཁྲུལ་པ་བསལ་བའི་ཕྱིར་འདི་ནི་དུ་བའོ་ཞེས་བྱ་བའི་ཚིག་ལ་ལྟོས་པར་བྱ་བ་ཉིད་དོ།",
    "དེ་ལྟར་གཞན་གྱིས་རྟོགས་པར་བྱེད།",
    "དེ་ནི་མཚན་ཉིད་ཅན་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདི་དོན་གྱིས་བརྗོད་པར་འགྱུར་བ་ཡིན་ནོ།",
    "དེས་ན་རྗེས་སུ་དཔག་པའི་ཚུལ་ཉིད་སྒྲས་སྟོན་པར་བྱེད་ཀྱི།",
    "མེད་པར་འཁྲུལ་པ་དང་མི་འབྲལ།",
    "འབྲས་བུའི་གཏན་ཚིགས་ཡོད་པ་ཉིད་དོ་ཞེས་དེ་ཙམ་ཞིག་བརྗོད་པར་འདོད་པ་ལ་བར་ཆོད་བསྟན་པ་གང་དུ་ཉེ་བར་མཁོ།",
    "གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པར་ནི་འབྲས་བུའི་གཏན་ཚིགས་མི་སྲིད་པ་ཉིད་དོ།",
    "གཞན་གྱི་དོན་གྱི་རྗེས་སུ་དཔག་པར་ཡང་ཚུལ་དེ་ཉིད་ཡིན་པས་སྒྲ་ལས་དངོས་ཁོ་ནར་རྗེས་སུ་དཔག་པ་སྐྱེས་པ་ཡིན་ནོ།",
    "རྗེས་སུ་དཔག་པ་མེད་པར་ནི།",
    "ཚིག་མེད་པར་ནི་འཇིག་རྟེན་གྱི།",
    "ཐ་སྙད་མེད་པར་འགྱུར་རམ་ཅི།",
    "འདིར་ནི་འདི་ཙམ་ཞིག་བརྗོད་པར་འདོད་པ་ཡིན་གྱི།",
    "ཐམས་ཅད་རྗེས་སུ་དཔག་པར་བསྟན་པ་ནི་ཉེ་བར་མཁོ་བ་མེད་དོ།",
    "འདི་ལྟར་སྐྱེས་བུས་མ་བྱས་པ་ཉིད་ཀྱང་མི་བདེན་པ་ཉིད་ཀྱིས་ལྡོག་པ་ཡིན་གྱི།",
    "སྐྱེས་བུས་བྱས་པ་ཉིད་དུ་རྟོགས།",
    "འགའ་ཞིག་ཏུ་ཡན་ལག་གཞན་བྱས་པར་ཐོས་པ་ཡིན་ནོ།",
    "ཚུལ་གསུམ་པའི་རྟགས་སྟོན་པ་གཞན་གྱི་དོན་རྗེས་སུ་དཔག་པར་བྱའོ་ཞེས་བརྗོད་པར་བྱའི།",
    "གཞན་ལ་བསྟན་པར་བྱ་ཉིད་ཕྱིར།",
    "གཞན་ཉིད་རྟོགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "གལ་ཏེ་རྟགས་ཏེ་གཞན་གྱིས་རྟོགས་ན་གཞན་གྱིས་རྟོགས་པར་འགྱུར་བ་ཉིད་དོ།",
    "རྒོལ་བས་མ་རྟོགས་པ་ཇི་ལྟར་གཞན་རྟོགས་ཞེས་ནི་བརྗོད་པར་མི་བྱ་སྟེ།",
    "རང་རྟོགས་མེད་པར་རྟོགས་མ་ཡིན།",
    "གལ་ཏེ་དེ་ལྟ་ན་རང་ཁོ་ནས་མཐོང་བ་ཡིན་པར་འགྱུར་བས་གཞན་གྱིས་མཐོང་བ་རྣམ་པར་དཔྱད་པའི་ཕྱིར།",
    "དེས་ནི་ལོག་པར་རྟོགས་པ་ཡང་བསལ་བ་ཡིན་ནོ།",
    "དེས་ན་རང་ཉིད་མ་རྟོགས་པར་དེར་ཇི་ལྟར་འགྱུར།",
    "སྒྲུབ་པར་བྱེད་པ་ཉིད་དོ་ཞེ་ན་འདིར་བརྗོད་པ།",
    "གཞན་ལ་རབ་ཏུ་གྲུབ་པར་འདོད་པ་ཡིན་གྱི།"
  ]
}