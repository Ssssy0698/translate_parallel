    "མྱ་ངན་མི་འདའ་རྟག་པར་བཞུགས་སུ་གསོལ།",
    "ལོང་བྱུང་ཚེ་བཤགས་པའི་མཚམས་སུ་སྡོམ་པ་གསུམ་སོ་སོའི་བཤགས་པ་དང་།",
    "སྟོན་པར་འོས་པའི་ཡོན་ཏན་བཅུ་ལྡན་པ།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་རོལ་བ་ལས་བྱུང་པའི།",
    "ཞེས་ཕྱི་ནང་གསང་བ་དེ་ཁོ་ན་ཉིད་ཀྱི་ཡོན་ཏན་བརྗོད་པའི་སྒོ་ནས་རྩེ་གཅིག་ཏུ་གསོལ་བ་འདེབས་ཤིང་ཁྱད་པར་དུ།",
    "དགྱེས་བཞིན་ཐིམ་པས་བྱིན་གྱིས་བརླབས་པར་གྱུར།",
    "པར་བསམ།",
    "དགྱེས་བཞིན་རྗེས་སུ་འཛིན་པར་བྱིན་གྱིས་རློབས།",
    "བརྩོན་པ་ལྷུར་ལེན་བྱེད་པར་བྱིན་གྱིས་རློབས།",
    "བདག་དང་གཞན་ལ་ཁྱད་པར་ཡོད་མིན་ཞེས།",
    "གཞན་བདེ་དགའ་བ་བསྐྱེད་པར་བྱིན་གྱིས་རློབས།",
    "ལེ་ལན་བདས་ལ་འཁོན་དུ་བཟུང་བྱས་ཏེ།",
    "བདག་འཛིན་གདོན་ཆེན་འཇོམས་པར་བྱིན་གྱིས་རློབས།",
    "སྲོག་ལས་གཅེས་པར་འཛིན་པར་བྱིན་གྱིས་རློབས།",
    "བདག་གཞན་མཉམ་བརྗེ་ནུས་པར་བྱིན་གྱིས་རློབས།",
    "འགྲོ་ཀུན་བདེ་དང་ལྡན་པར་བྱིན་གྱིས་རློབས།",
    "རྐྱེན་ངན་ལམ་དུ་ལོངས་པར་བྱིན་གྱིས་རློབས།",
    "དལ་འབྱོར་དོན་ཆེན་བྱེད་པར་བྱིན་གྱིས་རློབས།",
    "བརྩོན་པ་ལྷུར་ལེན་བྱེད་པར་བྱིན་གྱིས་རློབས།",
    "བྱིང་རྒོད་རྣམ་པར་གཡེང་བའི་སྐྱོན་སྤངས་ནས།",
    "རྩེ་གཅིག་མཉམ་པར་འཇོག་པའི་ཏིང་འཛིན་གྱིས།",
    "སྣང་ཡང་བདེན་པར་མེད་པའི་ཚུལ་རྟོགས་ནས།",
    "སྒྱུ་མའི་ཏིང་འཛིན་རྫོགས་པར་བྱིན་གྱིས་རློབས།",
    "ཀླུ་སྒྲུབ་དགོངས་དོན་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "སྲོག་ལས་གཅེས་པར་འཛིན་པར་བྱིན་གྱིས་རློབས།",
    "གང་སྣང་ལྷ་སྐུར་འཆར་བར་བྱིན་གྱིས་རློབས།",
    "དག་པའི་ཞིང་དུ་བགྲོད་པར་བྱིན་གྱིས་རློབས།",
    "ཞབས་སེན་འོད་ཆགས་བརྟན་པར་བཞུགས་སུ་གསོལ།",
    "འདི་ཕྱིའི་ལེགས་ཚོགས་ཐམས་ཅད་ཀྱི་རྩ་བ་བརྟན་པར་འགྱུར་བ་ཡིན་ནོ།",
    "བརྗོད་བྱའི་དོན་རྣམས་ཁོང་དུ་ཆུད་པར་བྱས་ཏེ་ལེགས་པའི་ཆ་ཐམས་ཅད་ལེགས་པར་བསྡུས་ནས།",
    "རྒྱལ་བའི་མཁྱེན་རབ་ཀུན་འདུས་འཇམ་པའི་དབྱངས།",
    "བློ་བཟང་རྒྱལ་མཚན་ཤེས་བྱ་ཀུན་མཁྱེན་པ།",
    "རྣམ་པར་རྒྱལ་བའི་འཕྲིན་ལས་ས་གསུམ་ལ།",
    "སྐྱེས་བུ་གསུམ་དུ་ཤེས་པར་བྱ།",
    "ཡང་དག་ཟད་པར་ཀུན་ནས་འདོད།",
    "འདོད་པར་གྱུར་བ་དེ་དག་ལ།",
    "ཀུན་བཟང་སྤྱོད་ལས་གསུངས་པ་ཡི།",
    "ལྡོག་པ་མེད་པར་དམ་འཆའ་བའི།",
    "དེ་ལྟར་ཡང་དང་ཡང་དུ་སེམས་ནི་བསྐྱེད་པར་བྱ།",
    "དེ་ནི་དེ་བས་ལྷག་པར་འགྱུར།",
    "འཇུག་སེམས་བདག་ཉིད་སྡོམ་པ་མ་གཏོགས་པར།",
    "དེ་ཕྱིར་འབད་པས་འདི་ནི་ངེས་པར་བླང་།",
    "ཚངས་པར་སྤྱོད་པ་སྤྱད་བྱ་ཞིང་།",
    "ཕྱི་མའི་མུ་མཐར་གནས་པར་བགྱི།",
    "ཞིང་དག་རྣམ་པར་སྦྱང་བར་བྱ།",
    "མིང་ནས་གཟུང་བ་བྱས་པ་དངཕྱོགས་བཅུ་དག་ཏུ་རྣམ་པར་གནས།",
    "ཐམས་ཅད་དུ་ནི་དག་པར་བྱས།"
