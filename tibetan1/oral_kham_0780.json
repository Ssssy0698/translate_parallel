    "ཚིག་རྩུབ་བྱུང་རྒྱལ་དུ་སྨྲ་བར་གོམས་པ་ན་སི་ཏཱའི་ངག་ནི་ཉེས་པས་གོས་འདུག་རུང་།",
    "འདས་པའི་དུས་སུ་རྒྱལ་པོ་རཱ་མ་ཎ་དང་ལྷན་དུ་འདོད་པའི་བདེ་བ་མྱངས་པའི་རྣམ་པ་དེ་དྲངས་འདུག་ལ།",
    "ནམ་མཁའི་དབྱིངས་སུ་ཡུན་རིང་འདུག་མ་བཟོད་དེ་རྒྱ་མཚོ་འཐུངས་ཏེ་སྐོམ་པའི་གདུང་བ་སེལ་ཕྱིར་ནུབ་ཀྱི་ཕྱོགས་ལ་མགྱོགས་པོར་ཤུགས་ཀྱིས་རྒྱུག་དགོས་བྱུང་།",
    "སྐབས་དེའི་རོལ་རྙེད་མའི་སྡུག་བསྔལ་ནི་མིའི་བཟོད་བསྲན་གྱི་ཚད་ལས་བརྒལ་འདུག་པ་སྟོན་ཐུབ་པར་གྱུར།",
    "བརྗོད་སྟངས་འདི་ནི་འཚོ་བའི་བདེན་པ་ལས་རིང་དུ་བརྒལ་འདུག་ཀྱང་།",
    "ཁོ་རང་ཆུ་རྒྱུན་དེའི་མགོ་ཁུངས་ལ་བསླེབས་པ་ན།",
    "རྐང་རྗེས་གཅིག་ཀྱང་བཟུང་ནས་འདུག་པར་མ་ནུས།",
    "རྐང་རྗེས་གཅིག་ཀྱང་བཟུང་ནས་འདུག་པར་མ་ནུས་པ་ཡིན་དེ་ཚེ་གདོང་ལ་གདོང་ཕྱོགས་ཉལ།",
    "བྱུང་རིམ་གྱི་རྒྱུན་མཐུད་རང་བཞིན་ལ་གཏོར་བརླག་བྱས་འདུག་པས།",
    "གསེར་གྱི་བྱང་བུ་སྲ་ཞིང་མཁྲེགས་པ་མང་པོ་སྲེད་བུའམ་སྐུད་པས་བརྒྱུས་ཏེ་གཡོགས་འདུག་པ་ན་མཚོན་གྱིས་བཏབ་ཀྱང་མཚོན་མི་ཟུག་པ་དང་།",
    "འོན་ཏེ་སེམས་མེད་མ་དེ་སྐྱེས་མ་མཆོག་ཏུ་གྱུར་པ་ཞིག་ཡིན་ཞེས་ཀུན་གྱིས་ཐོས་ནས་སྒྲོག་བཞིན་གདའ།",
    "རཱ་མ་ཎའི་དམ་བཅའ་སུམ་ལྡན་གྱི་མདའ་ལས་འགོང་བ་སྟེ་མདའ་ལས་ཐར་བ་ན་རི་དྭགས་དེ་ཡ་མཚན་ཞིག་ཡིན་དགོས་འདུག་པ་དང་།",
    "འོན་ཏེ་སེམས་མེད་མ་དེ་སྐྱེས་མ་མཆོག་ཏུ་གྱུར་པ་ཞིག་ཡིན་ཞེས་ཀུན་གྱིས་ཐོས་ནས་སྒྲོག་བཞིན་གདའ།",
    "འདིར་དབྱིབས་སྒོར་སྒོར་ཡིན་པ་ལ་གོ་དགོས་འདུག་ཨ་ལོང་མུ་ཁྱུད་ཟླུམ་པོའི་མིང་།",
    "ཞིབ་ཏུ་བསམས་ན་རྒྱལ་པོ་རཱ་མ་ཎ་ལ་ཁག་པོ་མི་འདུག་སྟེ།",
    "ཁོ་རང་ཐོག་མར་ལམ་ལ་ཆས་སྐབས།",
    "འོན་ཏེ་གནས་དེར་བསླེབས་ཀྱང་སྐྱོན་མི་འདུག་སྟེ།",
    "ཁོ་རང་སླར་ལོག་སྐབས་སྲིན་པོའི་ཡུལ་ལ་དམིགས་པ་གཏད་དེ།",
    "མཛེས་མ་སི་ཏཱ་རང་གཤིས་གྱོང་ཞིང་རང་རློམ་ཆེན་པོ་ཅན་ཞིག་ཡིན་པ་ན།",
    "གཡུལ་ནས་འབྲོས་པའི་སྡར་མ་ནང་བཞིན་ཕོ་ཉ་ཞིག་མངགས་ཏེ་ང་རང་ལྐོག་ཏུ་ཁྲིད་ན་དཔའ་བོའི་བརྟུལ་ཞུགས་ལ་རོལ་བ་མ་ཡིན་ནོ།",
    "ཧ་ནུ་མན་ཐའི་དཔའ་དང་དཔུང་ཤུགས་དེ་སྲིན་པོ་རྣམས་ལས་རིང་དུ་བརྒལ་འདུག་པ་སྟོན་ཐུབ་པར་གྱུར།",
    "སྐབས་ཤིག་ལ་སྲིན་པོ་རྣམས་ཀྱིས་བཟུང་འདུག་པའི་ལྕགས་ཐག་དེ་མགུལ་རྒྱན་ནང་བཞིན་མགྲིན་པར་ཐེབས་པ་ན།",
    "འོན་ཏེ་ཧ་ནུ་མན་ཐའི་རྩལ་ཀུན་ཡོངས་སུ་རྫོགས་འདུག་པ་དང་།",
    "སྙན་ངག་པས་སྤྲེའུ་ཧ་ནུ་མན་ཐའི་རྩལ་ཀུན་ཡོངས་སུ་རྫོགས་འདུག་པ་དང་།",
    "ད་དུང་རང་ཉིད་ཀྱི་གསོད་ལུགས་ཀྱང་བདེན་པར་སྨྲ་བའི་ཡོན་ཏན་དང་ལྡན་པ་ཞིག་ཡིན་ན།",
    "སྤྲེའུ་ཧ་ནུ་མན་ཐའི་རྒྱུག་པ་དང་མཆོང་བའི་རྩལ་ཀུན་ཡོངས་སུ་རྫོགས་འདུག་པས།",
    "མཐོང་མ་ཐག་ཏུ་དུག་སྦྲུལ་སེར་པོ་ཞིག་དེ་ལ་འཁྱུད་འདུག་པ་དང་མཚུངས་ཤིང་།",
    "མཚུན་གྱི་ལྷ་ནི་གཤིན་རྗེ་ལ་གོ་དགོས་འདུག་ཞབས་རྐང་བའི་ཞེ་ས།",
    "ཟླ་བ་མདུན་ལ་འགྲོ་སྐབས་དེ་ཉིད་ངོས་ཀྱི་རི་བོང་གཞོན་ནུའི་གདོང་ནི་རྒྱབ་ཕྱོགས་ལ་གཏད་འདུག་པ་དེ་དཔེར་བཀོད་པ་ན།",
    "ཕྱོགས་ལ་ཡང་ཡང་ལྟ་བཞིན་འབྲོས་ཤིང་རྒྱུག་བཞིན་གདའ།",
    "ད་སྐབས་རྔ་ཡབ་གླིང་ནི་སྲིན་པོའི་བེམ་པོས་ཁེབས་པའི་དུར་ཁྲོད་ཆེན་པོ་ཞིག་ཏུ་གྱུར་འདུག་གོ།",
    "དལ་བར་འདུག་པ་མི་རིགས་སོ།",
    "དེ་ལྟར་ཡིད་དགའ་ཞིང་རངས་པར་བྱེད་པའི་གཏམ་དང་།",
    "སྐབས་མང་པོ་ལ་ཡིད་དགའ་ཞིང་རངས་པར་བྱེད་པའི་གཏམ་དང་།",
    "རྒྱན་གྱི་ངོས་འཛིན་ལ་དཀའ་ཁག་ཆེན་པོ་བཟོས་འདུག་པ་དང་།",
    "དེ་ཡང་གཅིག་ཏུ་མ་ངེས་པར་འདུག་ཅིང་།",
    "སེམས་གནས་ཙ་ན་མཐོང་བྱ་མཐོང་བྱེད་ཐ་དད་པར་སྣང་བ་མངོན་གྱུར་འགགས་པ་ནི་ཤེས་རབ་ཀྱི་ཡན་ལག་རྒྱུད་ལ་སྐྱེས་པའི་ཚད་ཡིན།",
    "ཤེས་པ་ཡིན་པར་སྒྲུབ་པ་ལས་ཤེས་པའི་ནང་ནས་གཞན་སེམས་མ་ཡིན་ཞིང་རང་སེམས་ཀྱི་སྣང་བ་ཡིན་པའི་སྒྲུབ་བྱེད་དུ་དེ་ལྟར་གསུངས་པ་ཡིན་གྱི།",
    "འོད་དང་བཅས་ཏེ་མི་གཡོ་བར་འདུག་ན་མར་མེའི་རྟགས་ཡིན།",
    "ཕན་ཚུན་མི་སྒྲིབ་པར་དྭངས་གསལ་དུ་འདུག་ན་ནམ་མཁའི་རྟགས་སུ་བསྡུ།",
    "བུམ་པ་ཅན་ཆེད་ཀྱིས་མ་བསྒོམས་ཀྱང་རང་ཤུགས་ཀྱིས་བུམ་པ་ཅན་གྲུབ་པའང་ཡོད།",
    "འཇིག་རྟེན་ན་ལྷ་སྦྱིན་བདེ་བར་ཉལ་ལོ་འདུག་གོ་འགྲོའོ་ཞེས་པའི་ཐ་སྙད་ཡོད་པ་དེའི་ཕྱིར་བདེ་བ་ལ་ཡང་ཡོད་པ་ཡིན་ནོ།",
    "སྡུག་བསྔལ་ཆུང་དུ་རྩོམ་པའང་བདེ་བ་ཅི་ཞིག་ཡོད་ལ་སྡུག་བསྔལ་འགག་ནའང་བདེ་བ་ཅི་ཡོད་དེ་སྡུག་བསྔལ་ཙམ་ཞིག་ཁོ་ན་སྐྱེ་ཞིང་འགག་པའི་ཕྱིར་གནས་སྐབས་གཉི་གར་ཡང་རང་བཞིན་གྱིས་བདེ་བ་ཡོད་པར་ཡིན་ནོ།",
    "གཞན་ཡང་རང་རང་འཚོ་བའི་དེབ་དགུ་པ།",
    "རང་དང་མཉམ་པ་དང་རང་ལས་ཁྱད་པར་དུ་འཕགས་པ་ཡི།",
    "དོན་འགའ་ལའང་རང་བཞིན་མ་གྲུབ་པས་དོན་གང་དང་ལྷན་ཅིག་ཏུ་བཅིངས་པ་ཞེས་བྱ་བ་ཡོད་པ་མིན་ཏེ་གལ་ཏེ་ཡོད་ན་གཞན་དང་ལྷན་ཅིག་ཏུ་བཅིངས་པ་ལ་བྲལ་བར་འགྱུར་བ་ཉིད་ཀྱང་རིགས་པ་མ་ཡིན་ནོ།",
    "བྱེ་བྲག་ཏུ་སྨྲ་བ་གང་ཞིག་དུས་ཐམས་ཅད་ཡོད་པ་ཉིད་དུ་སྨྲ་བའི་ཕྱིར་དེ་ལ་སླར་ཡང་བརྒལ་ཞིང་བརྟག་པ།",
    "དངོས་པོ་འགའ་ཡང་རང་བཞིན་བརྟག་པར་མི་ནུས་ཏེ་རྣམ་པ་དེ་ལྟ་བུའི་དངོས་པོ་རྣམ་པ་ཐམས་ཅད་དུ་མི་དམིགས་པའི་ཕྱིར་རོ་། འདི་ལྟར་གལ་ཏེ།",
    "རང་རང་སློབ་དཔོན་རྣམས་ཀྱི་བསྔགས་པ་ཡི།",
    "དེ་དག་དུས་གསུམ་དུ་དྲང་སྲོང་སེར་སྐྱའི་བསྟི་གནས་སུ་འགྲོའོ།",
    "གངས་རིའི་བྱ་ཁུ་བྱུག་སོགས་ཁྱིམ་དེའི་སྟེགས་བུ་སོགས་སུ་འདུག་ནས་སྐད་སྙན་པ་སྒྲོག་པ་དང་།",
    "དེའི་ཉེ་ལོགས་ན་དངུལ་གྱི་རི་ཡོད་ལ་དེའི་ནང་ན་གསེར་གྱི་གཞལ་ཡས་ཁང་འདུག་གོ།",
    "ཡུམ་གྱི་ལྷུམས་ན་བཞུགས་པའི་སྐུ་མེའི་ཕུང་བོ་ལྟ་བུ་འདུག་པའི་སྣང་བས་དཔག་ཚད་ལྔའི་བར་ཁྱབ་བོ།",
    "དེ་རྣམས་ཀྱང་སྟན་ལ་འཁོད་ནས་འདུག་པ་ལ།",
    "ལུམྦི་ནཱིའི་ཚལ་དབེན་པར་འགྲོ་བ་དང་འདུག་པའི་བློ་སྐྱེས་ཏེ།",
    "ཁྱེད་ཅག་རྒྱན་གྱིས་བརྒྱན་ལ་སིལ་སྙན་ཐོགས་ཏེ་ཤིང་རྟའི་མཆོག་འདིར་སྒྱུ་འཕྲུལ་བསེ་རུ་ལྟ་བུར་འདུག་ཏུ་ཆུག་ལ་ན་ཆུང་རྣམས་ཀྱིས་དྲོངས་ཤིག་ཅེས་སྨྲས་པ་དང་།",
    "ཚངས་པ་ཡང་དེ་ན་འདུག་གོ།",
    "ཞེས་ཕོ་ཉ་དང་དཀོར་སྒྲོམ་དག་དུས་དུས་སུ་རྒྱལ་བོ་ཟས་གཙང་ལ་བསྐུར་བར་བྱེད་དོ།",
    "ཡོན་ཆུས་རྐང་བ་ལ་གཏོར་ཅིང་སེང་གེའི་ཁྲི་ལ་འདུག་ཏུ་བཅུག་ནས་ཞེ་ས་དང་གུས་པ་དང་བཅས་པས་སྨྲས་པ།",
    "དྲུག་པ་ལ་གཙུག་ཕུད་བཞག་ནས་མ་མའི་པང་བར་འདུག་སྟེ་གསེར་གྱི་གཞོང་བར་འབྲས་དང་ཤར་བསྲེས་པའི་ཆན་གསོལ་བ་ན་མ་མས་བཀག་ཀྱང་མ་ཐུབ་པར་རྒྱལ་བོ་ལ་སྦྲན་ཏེ་སྐྱེ་བོའི་ཚོགས་མང་བོས་དབྲོག་པར་བརྩམས་ཀྱང་འཕྲོག་མ་ནུས་ནས།",
    "ཁྱུ་མཆོག་ལྟ་བུར་འདུག་གོ།",
    "དེའི་ཚེ་ངང་བ་དང་རྨ་བྱ་ལ་སོགས་ཁང་བཟངས་སུ་འདུག་ནས་སྒྲ་མི་འབྱིན།",
    "ཞེ་སའི་ཚུལ་གྱིས་འདུག་ནས།",
    "བུ་འདིར་འདུག་ན་བདག་ཅག་ལ་ཕན་ཐོགས་པར་འགྱུར་ན་དམ་པ་སློངས་ཤིག་གསོལ་བ།",
    "དེ་ལྟར་བརྡ་སྤྲད་པ་དང་ས་འཚོ་མ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ལྷའི་བུ་རྣམས་ཀྱང་ད་ཇི་ལྟ་ཞིག་སྙམ་དུ་འདུག་པ་དང་།",
    "ལྷའི་བུ་ཉི་མ་དང་ཟླ་བ་གཉིས་པོ་ཡང་གློ་གཡས་གཡོན་ན་འདུག་པ་དང་།",
    "ཕར་འབྲོས་ཚུར་བྲོས་ཤིང་འདུག་ཏུ་མི་སྡུབ་བོ།",
    "ཞེས་གསུངས་པས་བསྔགས་ལྡན་མི་གཡོ་བར་འདུག་གོ།",
    "དེའི་ཚེ་འཇིག་རྟེན་སྐྱོང་བ་བཞི་ཡང་ཕྱོགས་བཞིར་འདུག་གོ།",
    "དེ་ནས་ཤཱཀྱ་མིང་ཆེན་ཕུ་ནུ་དང་བྲལ་བའི་སྡུག་བསྔལ་གྱིས་གདུངས་ལ་རང་ཉིད་ཀྱིས་བཟུང་བར་མ་ནུས་ཤིང་གཞན་གཉིད་སྟུག་པོས་ནོན་པས་ཅི་བྱའི་གཏོལ་མེད་དེ་འདུག་གོ།",
    "མིང་གཞན་རྣམ་པར་བམ་པ་དང་མི་གཡོ་བ་ཞེས་བྱ་བ་ལ་སྙོམས་པར་ཞུགས་ཏེ་འདུག་པ་དང་།",
    "ས་སྟེང་འདུག་ཅིང་འགྲོ་བ་འདི་སུ་ཞིག།",
    "རྐང་གཅིག་བཙུགས་དང་ཙོག་པུར་འདུག།",
    "ཁ་བུབ་དང་གན་རྐྱལ་དུ་ཡང་མི་གནས་པར་འདུག་གོ།",
    "ཡེ་ཤེས་ཀྱི་ལུས་འོག་མིན་ལྷའི་རྒྱལ་བོའི་གནས་ན་འདུག་པ་ལ།",
    "དེའི་ཚེ་བརྒྱ་བྱིན་དང་ཚངས་པ་དང་གནས་གཙང་མའི་ལྷ་རྣམས་ཀྱིས་བྲམ་ཟེར་སྤྲུལ་ཏེ་འདུག་པ་ལ།",
    "དེས་རྨོངས་ནས་ཕྱོགས་གང་དུ་ཕྱིན་ཀྱང་དགེ་སྦྱོང་མཛེས་པ་ཁོ་ན་གདའ་ཡི།",
    "མགོ་རྐང་བ་ལ་འདུག་ཅིང་རྐང་བ་མགོ་ལ་སྐྱེས་པ་དེ་བཞིན་དུ་ལག་པ་དང་རྐང་བ་དང་མགོ་དང་མིག་ལོག་པར་འདུག་པ།",
    "སྤྱི་ཚུགས་སུ་འདུག་ལ་ཁབ་ཀྱི་སྤུ་ཅན་དག་དང་།",
    "བདུད་ཀྱི་བུ་གཞན་ཞིག་ཁྲོས་ཏེ་དེ་གཅིག་པོར་འདུག་ན་ཇི་ག་ཞེས་སྨྱོས་སོ།",
    "ཚུལ་དེས་བདུད་སྡིག་ཅན་ཞུམ་ཞིང་ཅང་མི་སྨྲ་ལ་སྤྱི་བོ་སྨད་ནས་སེམས་ཁོང་དུ་ཆུད་ནས་འདུག་གོ།",
    "དེ་གཉིས་དེ་ལྟར་འདུག་པ་དང་།",
    "སུ་ཡང་མི་འདུག་པས་འཇིགས་པ་མེད་དོ་ཞེས་སྨྲས་སོ།",
    "རོལ་བའི་རྫིང་འགྲམ་ན་འདུག་ནས།",
    "ཞེས་བརྗོད་མ་ཐག་དེ་བཅོམ་ལྡན་འདས་ཀྱི་དྲུང་ན་འདུག་པ་མཐོང་སྟེ།",
    "གཡས་ན་སྟོབས་པོ་ཆེ་ལག་པ་བཞི་བ་ཡང་འདུག་སྟེ།",
    "དེ་ཡང་རངས་བྱེད་ཀྱི་བུ་ལྷག་སྤྱོད་དེ་ངའི་སློབ་དཔོན་ཡིན་བཞིན་དུ་རྟོགས་པ་དམ་པ་དག་ལ་ཡང་ཡི་རང་ཞིང་དང་བར་གྱུར་པ་ཡིན་དགོངས་སོ།",
    "དགེ་སློང་ལྔ་བོས་ཀྱང་དེ་བཞིན་གཤེགས་པ་ལ་ཕྱག་བཙལ་ནས་དུལ་བའི་ཚུལ་གྱིས་འདུག་གོ།",
    "ལྷམ་དེ་མཐོང་ནས་འབབ་ཆུ་བརྒལ་བ་ན་བཅོམ་ལྡན་འདས་ཀྱིས་གྲགས་པ་སྟན་དེ་ཉིད་ལ་འདུག་བཞིན་དུ་མི་མཐོང་བར་བྱིན་གྱིས་བརླབས་སོ།",
    "ཁྱིམ་བདག་དེའི་ཕྱིར་འདུག་ཤིག་དང་སྟན་དེ་ཁོ་ན་ལ་གཞོན་ནུ་འདུག་པ་མཐོང་བར་འགྱུར་རོ།",
    "ཅེས་པ་ལ་སོགས་པ་ཟློ་ཀ་གཉིས་བྲིས་ཏེ་འདུག་པ་བཅོམ་ལྡན་འདས་མ་གཏོགས་དེའི་དོན་སུས་ཀྱང་སྨྲ་བར་མི་ནུས་པ་ཞིག་ཡོད་པ་དེ།",
    "གནོད་སྦྱིན་གསེར་འོད་ཀྱིས་ལྕང་ལོ་ཅན་ན་དྲི་བ་དེ་འདུག་པ་མཐོང་ནས་བླངས་ཏེ་དཔྱད་ཀྱང་ཁོང་དུ་མ་ཆུད་ནས།",
    "དེ་ནས་འོད་སྲུངས་རང་ཉིད་སྦྱིན་སྲེག་བྱེད་དེ་ཡམ་སྲེག་ཤིང་བཙེར་ཧོམ་གཟར་ཐོགས་ཏེ་འདུག་པ་དང་།",
    "ཨངྒའི་རྒྱལ་བོ་དང་གཡུལ་བཀྱེས་པས་རྒྱལ་བོ་དེ་བསད་ནས་ཡུལ་ཨངྒར་འདུག་པ་དང་།",
    "རྟ་ཐུལ་གྱི་ཆ་བྱད་དུ་སྤྲུལ་ནས་དེ་གཉིས་འགྲོ་བའི་ལམ་གར་འདུག་ནས་སྨྲས་པ།",
    "དེའི་ཚེ་བདུད་སྡིག་ཅན་མྱ་ངན་གྱི་ཁང་བུ་ན་འདུག་ཅིང་སྟོང་ཆེན་གྱི་བདུད་ཐམས་ཅད་ཀྱང་དོགས་སྐྱེས་ནས་སེམས་ཤིང་འདུག་གོ།",
    "ཤཱ་རིའི་བུ་བསྙེན་པར་རྫོགས་ནས་ཟླ་བ་ཕྱེད་ལོན་པ་དེ་བཅོམ་ལྡན་འདས་ཀྱི་སྣམ་ལོགས་ན་བསིལ་ཡབ་གཡོབ་ཅིང་འདུག་པ་མཐོང་ནས་བཅོམ་ལྡན་འདས་ཀྱི་དྲུང་དུ་ཕྱིན་ཏེ།",
    "སྡུག་ཅེས་པ་དེ་ཕ་མ་དང་འགྲོགས་ནས་འོད་མའི་ཚལ་དུ་ཕྱིན་པ་ན་བཅོམ་ལྡན་འདས་ལ་ཕའི་འདུ་ཤེས་སྐྱེས་ཏེ་ཕ་ཕ་ཞེས་ཟེར་ཞིང་ཞབས་དྲུང་ཉིད་དུ་འདུག་པ་དང་།",
    "ཕས་དེ་ཉིད་དུ་འདུག་ནས་མ་གདུགས་ཚོད་ཤོམ་དུ་བཏང་སྟེ་ཞག་བདུན་དུ་གདུགས་ཚོད་གསོལ་ཞིང་།",
    "མ་མའི་པང་དུ་འདུག་པ་ལས་སློང་བ་དག་ལ་ཐགས་ཐོགས་མེད་པར་རྒྱུན་བྱིན་པས།",
    "འཇིག་རྟེན་སྐྱོང་བ་བཞིས་ཞལ་ཆེ་སྤྱོད་པའི་ལུས་སུ་སྤྲུལ་ནས་འདུག་པ་ལ།",
    "ཕྱོགས་འགའ་ཞིག་མ་གཡོགས་པར་འདུག་པ་ལས།",
    "འོད་སྲུངས་ཀྱིས་དེ་ལྟར་འདུག་པ་མཐོང་ནས།",
    "རྒྱལ་བོ་ཟས་གཙང་རང་ཉིད་ཀྱིས་སྤྲིང་ཡིག་བྲིས་པ།",
    "རྒྱལ་བོས་ཡན་ལག་ཐམས་ཅད་ཀྱིས་འཁྱུད་ནས་སྟན་བཤམས་པ་ཉིད་ལ་འདུག་ཏུ་བཅུག་སྟེ།",
    "བདེ་བར་གཤེགས་པ་ལ་ཀུན་ནས་རྟོག་ཅིང་འདུག་གོ།",
    "སྒོ་བཞི་ན་ནི་རྒྱལ་བོ་ཆེན་པོ་བཞི་འདུག་གོ།",
    "མིའམ་ཅི་རྣམས་ཀྱིས་བསྐོར་ཞིང་ཉན་ཐོས་ཆེན་པོ་རྣམས་ཀྱང་འདུག་གོ།",
    "རྒྱལ་བོ་ཡུལ་འཁོར་སྲུང་སྒོ་ན་འདུག་ནས་དེས་ནང་དུ་མ་འགྲོ་སྡོད་ཅིག་ཅེས་བཟློག་གོ།",
    "མགུ་བ་སྐྱེས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "དེ་ནས་ཤཱཀྱ་དེ་རྣམས་གསོལ་བཞིའི་ལས་ཀྱིས་རབ་ཏུ་བྱུང་སྟེ་འདུག་པ་དང་།",
    "ལན་གསུམ་དུ་མ་གནང་བས་ཡུམ་ཕྱི་རོལ་གྱི་སྒོ་ཁང་དུ་འདུག་ནས་མཆི་མ་འབྱིན་ཏོ།",
    "ཡི་དྭགས་ལྔ་བརྒྱ་འདུག་པ་དང་དེ་སྔོན་གྱི་ལས་ཀྱི་འབྲེལ་བས་ཕན་ཚུན་མཐོང་སྟེ་གྲོགས་པོར་གྱུར་ཏོ།",
    "དེས་རྫུ་འཕྲུལ་དེ་བསྡུས་ནས་བཅོམ་ལྡན་འདས་དེའི་དྲུང་ན་འདུག་གོ།",
    "སྒམ་པོ་དེ་ལུས་ཆེ་ལ་དམུས་ལོང་དུ་འདུག་པ་ལུས་རིལ་གྱིས་རྨས་གང་ཞིང་སྤྱི་བོ་ནས་རྐང་མཐིལ་གྱི་བར་སྲིན་ཞུགས་པས་མི་བཟོད་དེ་བརྒྱུགས་པ་ལས།",
    "དེ་ནི་མཁས་པ་གཡེར་བག་ཅན་ཁྱིམ་ན་འདུག་པ་ལས།",
    "འབྱོར་ལེན་སེམས་ལས་ཆུང་ངུར་འདུག་སྟེ་ནུ་བོའི་ངག་མ་ཉན་པས་ཉེས་ཏེ་ཅི་ཡང་བྱར་མེད་དོ།",
    "འཕགས་པ་གང་བོ་སྤྱན་འདུག་གོ།",
    "དེ་ནི་མགོ་རི་ཆེན་པོ་བཞིན་དུ་འདུག་པ་མགྲིན་པ་སྐུད་པ་ལྟར་ཕྲ་བ་གོམ་པ་འབོར་མི་ནུས་པ་ལུས་ལ་ལྕགས་གཟེར་སུམ་བརྒྱ་དྲུག་ཅུས་བཏབ་པ་དེ་མཐོང་ནས།",
    "རྒྱལ་བོ་གསལ་རྒྱལ་གྱིས་ཁྲིའུ་ཞིག་བྱིན་པ་དང་དེ་དེ་ལ་འདུག་གོ།",
    "དེ་མགོ་སྨད་དེ་འདུག་གོ།",
    "མེ་ཏོག་དེ་བཅོམ་ལྡན་འདས་ཀྱི་དབུའི་སྟེང་ན་འདུག་པ་མཐོང་བས་ངོ་མཚར་དུ་གྱུར་ཏེ།",
    "ཕྱི་ལིནྡའི་བུ་ལ་ལྷས་སྦྲན་པས་དེས་གྲུའི་དངོར་འདུག་ནས་ཚ་བོ་དག་ཐར་བར་བྱས་པ་དང་གཞོན་ནུ་མ་སྐྱེས་དགྲ་པི་ལིནྡའི་བུ་ལ་བསྟོད་པར་བྱེད་དོ།",
    "རྒྱལ་བོ་ཁྲོས་ནས་བློན་པོ་རྣམས་ལ་ཁྱིམ་བདག་འདི་གཉིས་ཕྱིར་འོང་བ་དེའི་ཚེ་མགོ་བོ་ཆོད་ཅིག་ཀླུ་གཉིས་པོའི་ཞོ་ཤས་འཚོ་བ་དག་དེའི་ལམ་ན་འདུག་པས་དེ་ཐོས་ནས་འཁྲུགས་ཏེ།",
    "དེ་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་མཐའ་འཁོབ་ཀྱི་གནས་མལ་རྟེན་ཅིག་དེ་སུམ་ཅུ་རྩ་གསུམ་དུ་ཤིང་ཤི་རཱི་ཥའི་གཞལ་མེད་ཁང་སྟོང་བར་འདུག་སྟེ།",
    "རྒྱལ་བོ་ཁྲོས་ནས་བློན་པོ་ལ་བསྒོས་ཏེ་དེ་གཉིས་ལ་ངའི་ཡུལ་དུ་མ་འདུག་ཅིག་ཅེས་བརྗོད་པས་དེ་གཉིས་དགའ་སྟེ་འོད་པའི་ཆུ་བྱུང་བ་རྒྱ་མཚོ་ཆེན་པོར་སླེབས་མ་ཐག་དེ་བ།",
    "རྒྱལ་བོས་ལན་གསུམ་གྱི་བར་དུ་སྨྲས་ཀྱང་ཅང་མི་ཟེར་བར་གཅིག་ལ་གཅིག་གྲུ་ཕུགས་བྱེད་ཅིང་ཡུལ་ཡུལ་བོ་དང་ཞུམ་ཞུམ་པོར་གྱུར་ནས་མགོ་སྨད་ཅིང་སྤོབས་པ་མེད་དེ་སེམས་ཁོང་དུ་ཆུད་ནས་འདར་ཞིང་འདུག་གོ།",
    "དེའི་ཚེ་ཀླུ་སོག་མ་མེད་དུ་སྐྱེ་བར་འགྱུར་བའི་བྲམ་ཟེ་མེས་སྦྱིན་ཡང་ལྷོ་ཕྱོགས་ནས་འོངས་ཏེ་རྒྱལ་བོའི་ཁབ་ན་འདུག་གོ།",
    "གྲོགས་སུ་ཡང་མི་འདུག་ནས།",
    "དེ་ན་དྲང་སྲོང་ཞིག་གནས་པ་ལས་རབ་ཏུ་བྱུང་ནས་མངོན་ཤེས་ལྔ་བསྐྱེད་དེ་འདུག་གོ།",
    "སྡིག་ཅན་གྱི་སྲིན་བུ་པ་དྲའི་ནགས་ཁྲོད་དུ་འདུག་ནས།",
    "བསོད་སྙོམས་ལ་ཞུགས་པ་ན་བ་ཆུང་མ་དབྱངས་ཅན་མས་བྲིད་ནས་བསླབ་པ་ཕུལ་ཏེ་སྔོན་གྱི་གནས་སུ་འདུག་པ་དང་།",
    "དགེ་སློང་སྟོང་ཉིས་བརྒྱ་ལྔ་བཅུ་དང་ཐབས་གཅིག་པ་ན་སྒྲ་གཅན་འཛིན་བསིལ་བའི་ཚལ་དུ་འདུག་པ་ལ་གནོད་སྦྱིན་རྣམས་ཀྱིས་གཙེས་པས།",
    "སྡིག་ཅན་གྱིས་དེ་མཐོང་སྟེ་ཆེར་འཁྲུགས་ནས་སྒོ་བཅད་དེ་འདུག་གོ།",
    "དེའི་ཚེ་ཐུབ་པའི་གནས་ཀུན་རྟེན་ན་འདུག་པའི་ཀླུ་ལྷག་མ་རྣམས་འདེང་ཕར་མ་ནུས་ནས་སྟོན་པ་ལ་བསྐྱབ་པར་གསོལ་ཞིང་།",
    "མ་འགགས་པ་རྣམས་ལ་རབ་ཏུ་དབྱུང་བར་ཞུས་པ་མ་གནང་བས་ཐེམ་པ་ལ་འདུག་ནས་སྐད་ཆེན་པོས་ངུས་སོ།",
    "དུས་སྔ་བ་ཞིག་ན་མཉན་ཡོད་ཀྱི་ཚོང་དཔོན་ཆུ་སྟོད་རབ་ཏུ་བྱུང་སྟེ་ཤིང་རླག་ཤའི་ཚལ་དུ་འདུག་ནས།",
    "འོག་ཕྱོགས་ནས་འཇམ་དཔལ་འཁོར་དྲུག་ཁྲིས་བསྐོར་བ་འོངས་ནས་པདྨ་དེ་ལ་འདུག་སྟེ་སྟོན་པ་ལ་འབེལ་མཆིན་ཞུས་ཤིང་།",
    "ཤཱ་རིའི་བུས་དེ་གན་རྐྱལ་དུ་སྡུར་བའི་སྒྲ་འབྱིན་ཅིང་འདུག་པར་བྱས་ནས་དགེ་སློང་དག་ཁྱེད་ཀྱིས་སྟོན་པ་གཉིད་ལོག་པའི་གནས་སྐབས་ལ་ལྟོས།",
    "ན་ནི་མ་༤རྒྱུ་ཡང་དེའི་ཚེ་འཁོར་རྣམས་ནམ་མཁའ་ལ་འཕགས་པ་སྙམ་བྱེད་ཅིང་བཀོད་པ་བརྩེགས་པའི་ཁང་བ་ན་འདུག་པ་ལ།",
    "བཅོམ་ལྡན་འདས་ཉིད་ཀྱི་སེང་གེའི་ཁྲི་འཕགས་པའི་དེ་ལ་ཕྱག་བྱས་ཏེ་འདུག་གོ།",
    "དེ་ནས་ཁྲས་ཕུག་རོན་ཞིག་བདས་པ་ཤཱ་རིའི་བུའི་གྲིབ་མ་ལ་འདུག་ཀྱང་འདར་བ་ལས་སྟོན་པའི་སྐུའི་གྲིབ་མ་ཕོག་མ་ཐག་འདར་བ་ཞི་ནས་སྡོད་དོ།",
    "ཉན་ཐོས་རྣམས་ཀྱིས་ཁྲི་དེ་ལ་འདུག་ཏུ་མ་ནུས་ནས།",
    "དྲི་མེད་ཀྱི་ངག་བཞིན་ཤཱ་རིའི་བུས་རྒྱལ་བ་ལྷུན་སྒྲོན་རྒྱལ་བོ་ལ་ཕྱག་བྱས་མ་ཐག་ཁྲི་ལ་འདུག་ནུས་པར་གྱུར་ཏེ་མང་དུ་བགྲོས་སོ།",
    "དམག་དཔོན་སེང་གེའི་བུ་རིན་ཆེན་བྱིན་སྐྱེས་ནས་ལོ་གསུམ་ལོན་པ་མ་མའི་པང་ན་འདུག་པ་དེས།",
    "ཅི་ཡང་མ་ཐོབ་པས་སྐྱོ་སྟེ་བདག་ལོངས་སྤྱོད་ཆེན་པོ་དང་ལྡན་པས་ཁྱིམ་ན་འདུག་གོ་སྙམ་པ་ན།",
    "གསེར་གྱིས་གཏོར་ནས་ཕྱོགས་བཞིར་འདུག་གོ།",
    "ལྷ་སྦྱིན་གཞན་མི་ལྔ་བརྒྱ་བོ་ཁྲིད་དེ་སྒྲོགས་འཕེན་པ་ལ་བལྟས་པས་མི་དེ་དག་དེ་ལྟར་འདུག་པ་མཐོང་ནས་ལྷག་པར་ཁྲོས་ཏེ་རང་ཉིད་འཁོས་ལྔ་བརྒྱས་བསྐོར་ཏེ་སྒྱོགས་འཕང་བར་བརྩམས་པ་དང་།",
    "སྟོན་པ་མགོན་མེད་ཟས་སྦྱིན་གྱི་གདུགས་ཚོད་གསོལ་བའི་ཚེ་གསལ་རྒྱལ་ཡང་འབོད་དུ་བཏང་ནས་དེ་གཉིས་གྲལ་གྱི་མཐའ་ལོགས་སུ་འདུག་སྟེ།",
    "ལེགས་ཀྱིས་སྟན་ལ་འདུག་ཅིག་རྒྱལ་བོས་ཀྱང་ཡིད་ཀྱིས་དྲི་བ་ཞུས་པ་དང་།",
    "ཀུན་དགའ་བོ་ཚལ་སྔོ་ཞིང་སྔོ་བ་སྦྲེངས་པ་རྒྱུང་རིང་བོ་ན་འདུག་པ་ཕ་བི་རི་བོ་རྩེ་མཐོན་ཡིན་ཏེ།་",
    "འཇམ་དཔལ་གྱི་མདུན་དུ་འདུག་ནས་འགྱོད་པ་བསལ་དུ་གསོལ།",
    "མི་མཇེད་ཁེབས་པའི་གདུགས་སྟོན་པ་ལ་ཕུལ་ཏེ་འདུག་གོ།",
    "དེ་ལས་ཚིགས་བཅད་དང་གཟུངས་སྔགས་ཀྱི་སྒྲ་བྱུང་བས་མིག་ཅན་མ་དགའ་བས་པདྨ་དེ་དབྱུང་བར་བརྩམས་ཀྱང་མ་ནུས་པར་རང་ཉིད་བཅིངས་པ་ལྔས་བཅིངས་ཏེ་འདུག་གོ།",
    "དེའི་ནང་ན་སྟོང་གསུམ་འདུག་ཅིང་དེ་དག་ན་བྱམས་པ་རྒྱལ་བོ་བྱེད་པ་དང་།",
    "སྟོན་པའི་སྤྲུལ་བ་ཇི་སྙེད་པའི་རྒྱབ་ན་ལག་ན་རྡོ་རྗེ་འདུག་པར་མཐོང་ངོ།",
    "སྟོན་པའི་བཞུགས་ཁང་ན་སྣང་བ་ཆེན་པོ་འདུག་པ་མཐོང་ནས།",
    "དེ་ནས་ཤཱཀྱ་རྣམས་སྒོ་བཅད་དེ་ལག་པ་བསྲུངས་ནས་འདུག་པ་དང་།",
    "མིང་ཆེན་ཤི་བ་ཤེས་ནས་འཐགས་སྐྱེས་པོ་ཁྲོས་ནས་སྟན་ལ་འདུག་སྟེ།་",
    "དེས་ཆུའི་ནང་དུ་ཁང་བཟངས་བརྩིགས་ཏེ་འདུག་པ་དང་།",
    "ཤཱ་རིའི་བུས་སྟོན་པ་ལ་ཕྱག་བཙལ་ནས་པདྨའི་འདབ་མ་ལ་འཁོད་ནས་འདུག་གོ།",
    "བྱ་ས་པར་པ་གང་རྫུ་འཕྲུལ་གྱི་རྐང་བ་བཞི་ཐོབ་པ་དེ་བསྐལ་པར་ཡང་འདུག་པ་དེ་བཞིན་གཤེགས་ཡང་བཞེད་ན་བསྐལ་པའི་བར་བཞུགས་སོ་ཞེས་ལན་གསུམ་གྱིས་ཆུང་ས་ར།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་གོའི་ལ་བཀའ་སྩལ་པ་ཀུན་དགའ་བོ་གང་ན་འདུག་དེས་གསོལ་བ།",
    "སང་ནང་བར་བཅོམ་ལྡན་འདས་ཤཱཀྱ་ཐུབ་པ་སེང་གེའི་སྒྲ་སྒྲོག་པ་དེ་མི་མཐོང་ངོ་ཞེས་ངུ་ཞིང་འདུག་གོ།",
    "ལྷོ་ནས་མངོན་ཤེས་གསེར་ལས་བྱས་པའི་ཁང་བརྩེགས་བདུན་གྱི་དབུས་མ་ལ་འདུག་ནས་འོད་བཀྱེ་ཞིང་འོངས་སོ།",
    "ཀུན་དགའ་བོ་སྟོན་པའི་སྣམ་ལོགས་སུ་སྨྲེ་སྔགས་འདོན་ཞིང་འདུག་གོ།",
    "གཞན་དག་ནི་ལུས་ལ་ཁྲག་ཟག་ཅིང་༡༧ཟླནུ་བ་ད་ན་༧༣ལརྒྱུ་ན་ན་ད་ཙ་འདུགྲོ་གོ།",
    "ོབཅོམ་ལྡན་འདས་འོད་སྲུངས་ལ་དགོངས་ཀྱིས་ཁྱེད་རྣམས་ཞུགས་མ་སྦར་ཞིག་འོད་སྲུངས་ཆེན་པོ་ནི་རྒྱལ་བོའི་ཁབ་ཀྱི་སྒོད་ཀྱི་ཕུང་བའི་རི་དང་འོད་མའི་ཚལ་དང་ཉེ་བཝིཔཱལའི་ལུག་ན་འཁར་ལྔ་བརྒྱ་དང་ལྷན་ཅིག་འདུག་སྟེ།",
    "ཨུ་དུམྦུ་རའི་ཤིང་བཞི་སྐྱེས་ཏེ་མེ་ཡང་རང་ཤིའོ།",
    "ཤིང་བལ་རྣམས་མ་ཚིག་པར་འདུག་པ།",
    "གྱད་གོ་ཆ་དང་མཚོན་ཆ་ཐོགས་པ་རྣམས་ངོས་བཞིར་འདུག་སྔགས་མཁན་ལྔ་བརྒྱ་སྒོ་བཞིར་འཁོད་ནས་བགེགས་བསྲུངས།",
