    "དེ་ཡང་རང་དོན་སྤངས་རྟོགས་ཀྱི་ཡོན་ཏན་མ་རྫོགས་ཤིང་མཁྱེན་པ་མེད་ན་ལོང་བས་ལོང་བ་འཁྲིད་མི་ཤེས་པ་ལྟར་སྐྱོབ་མི་ཤེས་པ་ལ།",
    "བྱབ་ཏ་ཡང་ཤིན་ཏུ་དཀའ་བར་གདའ་བས།",
    "གསེར་ཡིག་པ་དང་སྣ་མི་འབྱེ་བ་དེ་ལྟ་བུ་ཞིག་བྱུང་ན་ཤིན་ཏུ་དགའ་བར་འདུག།",
    "བདག་ཉིད་ཆེན་པོ་ཁྱེད་རང་ཉིད་སྐུའི་རིམ་འགྲོ་ལ།",
    "སྤྱན་སྔ་དེ་ནས་ཀྱང་གདན་འདྲེན་པའི་ཞུ་བ་བྱུང་ན་གདའ།",
    "དལ་འབྱོར་མི་ལུས་སྟོང་ལོག་བྱེད་ཉེན་གདའོ།",
    "འཇིགས་རུང་ངན་འགྲོའི་གཡང་སར་འཆོར་ཉེན་གདའོ།",
    "ཁས་བླངས་ཐོག་ཏུ་ཁེལ་བ་མི་གདའོ།",
    "ཁས་ལེན་ཆེ་ལ་ཉམས་ལེན་ཞན་པར་གདའོ།",
    "རང་གཞན་གཉིས་ཕུང་ལས་ལ་འཇུག་ཉེན་གདའོ།",
    "ཚིག་དང་ཉམས་ལེན་འགལ་ནས་མི་གདའོ།",
    "ཉམས་ལེན་ཕྱོགས་ཙམ་གྲུབ་པར་མི་གདའོ།",
    "བདག་ལ་སྐྱོབ་པའི་ནུས་པ་མི་གདའ་བས།",
    "སེམས་མཆོག་བསྐྱེད་ཅིང་རང་འདོད་ཕུག་ཏུ་བཅུག།",
    "འཇིག་རྟེན་མིག་གྱུར་བི་རོ་ཙ་ནའི་མཚན།",
    "སྐྱེ་དགུ་རྣམས་ཀྱང་རང་བཞིན་གྱིས་ཤེས་རབ་ཆེ་ཞིང་འབྱོར་པའི་མཚན་མ་དུ་མས་ཉེ་བར་བརྒྱན་པ།",
    "རིག་པའི་གནས་ལྔ་དང་རང་གཞན་གྱིས་གྲུབ་པའི་མཐའ་རྒྱ་མཚོའི་ཕ་རོལ་ཏུ་སོན་པ།",
    "ཡི་གེ་དང་སྐད་ལ་སོགས་པ་འདི་དག་འདི་ཙམ་ན་ཤེས་ཀྱིན་འདུག།",
    "འདི་ཙམ་ན་མི་ཤེས་འདུག་བྱ་བ་ནི་ཁོ་བོས་ཀྱང་མི་ཤེས་ཏེ།",
    "གདུང་རྣམས་ནི་རིང་བསྲེལ་གྱི་ཕུང་པོ་ཆེན་པོར་གྱུར་ཏེ་འདུག་གོ།",
    "ཨ་ར་པ་ཙ་ན་འདི་སྒྲུབས་གསུངས་ནས།",
    "དེ་ཙ་ན་ས་སྐྱ་ན་ཨ་པོ་ཕག་སྟོན་བྱ་བ་མིག་མཐོང་ཡོད་པ་ཞིག་སྔ་དྲོ་ཉི་མ་ལ་འཐོན་ནས་བསྡད་ཙ་ན།",
    "ཁོང་རང་ཡང་གསོལ།",
    "བྱ་འཕྲང་པ་མཇལ་དུ་འོང་ཙ་ན།",
    "གཞན་གྱིས་གསེར་སྲང་གང་ཕུལ་འདུག་པ།",
    "གསེར་རམ་བྱ་བ་ནོར་ཆེན་པོ་ལགས་སོ་ཟེར་ནས་གང་དགར་བཞག་འདུག་ཟེར།",
    "ཁོང་གྲོངས་ཙ་ན་ཐམས་ཅད་ཀྱིས་མཐོང་བར་ཚེས་བཅོ་ལྔའི་ཟླ་འོད་ལྟ་བུར་འདུག་སྟེ།",
    "བསྒྲལ་རྒྱུའི་མི་མང་པོ་འདུག་པས།",
    "སྐུ་ནི་གཤེགས་ཡོད་པར་འདུག།",
    "ཁྲེས་པོ་ཚུན་ཆོད་སྦྲགས་ཡོད་ཙ་ན།",
    "འོན་ཀྱང་སང་ཕོད་འགྲོ་སྙམ་ཙ་ན་སེས་གསུངས་པ་བདེན་ཏེ་སྐུ་འདས།",
    "ལན་ཅིག་དཔོན་སློབ་ཚོས་རྟོགས་བདུན་གྱི་སྔགས་ཤིག་འཐུ་ཡིན་འདུག་པ་དང་།",
    "མ་ཤེས་ན་དགའ་བ་ཚོས་ཤེས་འདུག་གསུངས་ནས་གཤེགས་སོ།",
    "ལྷགས་པས་ཤོག་གུ་ཞིག་ཁྱེར་བ་བླ་ཆེན་གྱི་གམ་དུ་བྱུང་བས་དེ་ཁྱེར་ཏེ་འདི་ན་གདའ་ཞུས་པས།",
    "ས་སྐྱ་ནས་འོང་བ་ཞིག་མཇལ་བར་ཞུ་ཡིན་གདའ་འོ་བྱས་ཏེ་ཞུས་པས།",
    "དེ་ལྟར་བྱས་པས་ཁོང་དམ་ཚིག་པ་བསམ་གྱིས་མི་ཁྱབ་པར་འདུག་པ་ལ་ངས་དེ་ལྟར་ཅུང་མ་གོ།",
    "སག་ཐང་དུ་ཕེབ་པ་དང་ཐག་མཁན་ཚོ་ཞིག་འདུག་པ་ལ།",
    "ཤིན་ཏུ་གོ་བཅད་ནས་འདུག་གསུངས་ནས་མཉེས་སྐད།",
    "དགོས་པ་འདུག་ན་འཚག་གྱིས་གསུངས་ནས་ཤོག་དྲིལ་རྐྱལ་པ་གང་བྱིན་པས།",
    "རང་ལ་མ་བྱུང་བའི་གདམས་ངག་འདུག་ནའང་མི་དགའ་སྙམ་ནས་ཚག་མ་བྱས།",
    "གཡག་ཁྱུ་དེ་ཀ་ན་ཡར་འགྲོ་ཡིན་འདུག།",
    "མགོན་མེད་ལ་སྟེར་བས་བདེ་བ་ཅན་དུ་གཤེགས་ཙ་ན་གདན་དང་ན་བཟའ་ཕྲུགས་གཅིག་མ་ཡིན་པ་གསེར་ཏིལ་འབྲུ་ཙམ་མམ།",
    "དེ་རྩ་བ་མཚལ་གྱིས་བྲིས་པ་ཡི་གེ་བཤར་མར་འདུག་པ་དྲན།",
    "གཉིད་སད་པ་དང་སྟོན་པ་སྦལ་སྟོན་གམ་ན་འདུག་པས་གསུང་རྣམས་ཐོས།",
    "འགའ་ཞིག་ལངས་ནས་དེ་ཉིད་ན་འདུག།",
    "འོག་ན་གཡང་ས་ཆེར་ཡོད་པའི་ལམ་ཡངས་པ་གཅིག་འདུག་པ་ལ།",
    "མང་པོ་ཞིག་ངེད་ཀྱིས་མི་ཐར་ཟེར་དེ་ན་བསྡད་འདུག།",
    "ད་ཁྱེད་རང་རྣམས་ཤོག་གསུངས་ནས་བཞི་པའི་ལམ་བསྟན་ཏེ་དེར་དཔོན་གཡོག་ཐོན་པ་རྣམས་ཡར་བྱོན་པའི་བྱང་ངོས་ན་རི་ཟུར་གཟར་པོ་ཞིག་འདུག།",
    "ཁྱེད་རང་འགྲོ་བ་རྣམས་ཀྱང་ཤོག་བྱས་ཏེ་སྐས་དེ་ལ་འཛེགས་པ་དང་སུམ་ཅུ་རྩ་དྲུག་ཙམ་ཕྱི་ལ་བྱུང་བ་ལས།",
    "ཕྱི་ལ་ངོ་ཤེས་པ་སྒ་སྟོན་དང་གཞན་ལྔ་དྲུག་ཙམ་སླེབས་འདུག།",
    "ཞུ་བྱས་ལྟ་བུའི་བཟོད་པ་ཐོབ་པ་ལྔ་དྲུག་ཙམ་འོང་བར་འདུག་གསུང་།",
    "མདུན་ན་རྡོ་དཀར་འཇམ་ཞིང་འདུག་པའི་དྲུང་ན་འཁོད་ནས་འདིའི་སྟེང་དུ་ཞབས་བཞག་ན་མཁའ་སྤྱོད་དུ་འགྲོ་ཟེར་ཡང་།",
    "བདག་རང་ལ་ཕན་པར་གདའ་བྱས་ཏེ་བོད་དཔེ་ལ་རྒྱ་སྐད་དུ་བསྒྱུར་ཏེ་བཀླགས་པས་ཤིན་ཏུ་མཉེས་སྐད།",
    "དེ་ནས་རྐྱང་འདུལ་དུ་འབུལ་བ་བསྐྱལ་ནས་ཡར་བྱོན་ཙ་ན་པཎ་ཆེན་དབུས་སུ་གཤེགས་ཏེ།",
    "ཞུ་ཧུལ་ལའང་རིགས་ཚོགས་དང་རང་རྒྱུད་ཅི་རིགས་པར་གསན།",
    "ལྕགས་ཕོ་ཁྱིའི་སྟོན་ཟླ་ཐ་ཆུང་ཤར་བ་ན་དྲུང་ན་འདུག་པ་འགའ་ཞིག་ལ་ལྕགས་ཕག་ལ་ཞིང་གཞན་དུ་གཤེགས་གསུང་བ་ཐོག་ཏུ་ཕེབ་པས་སོ།",
    "དེ་དེ་བཞིན་དུ་འདུག་གསུངས་པས།",
    "འོ་ན་རྒ་བ་ལ་སོགས་པ་ལའང་དེ་བཞིན་སྦྱར་བས་མཆི་བར་མི་གདའ་ཡེ་ཟེར།",
    "འོ་ན་གོ་འདུག་བསམ་སྟེ།",
    "དེ་བཞིན་དུ་ཡོང་བར་འདུག་གསུངས་པས།",
    "མནལ་སད་དེ་བསམས་པས་དེ་བཞིན་འོང་བར་འདུག་གསུང་སྐད་དོ།",
