    "སྐྱུ་རུ་ར་ལ་སོགས་པ་ཇི་སྐད་སྨོས་པ་བཞིན་བསྟེན་ན་ཡང་ན་ཚོད་མཛེས་པ་ལ་སོགས་པར་འགྱུར་རོ།",
    "ལྕགས་ནག་པོའི་ཕྱེ་མ་ལ་སོགས་པ་ཇི་སྐད་སྨོས་པ་བཞིན་དུ་བསྟེན་ན་ཡང་ཚེ་རིང་ཞིང་སྐྲ་གནག་པར་འགྱུར་རོ།",
    "མི་གང་བྱི་དང་ག་ལ་སོགས་པའི་ལྡེ་གུ་ཟོས་པ་དེ་ནི་ན་ཚོད་དར་ལ་བབ་པ་དང་ལྡན་པར་འགྱུར་ཞིང་།",
    "རྒས་པའི་ཆུ་བོའི་རྦ་རླབས་ལས་ངེས་པར་རྒལ་བར་འགྱུར་རོ།",
    "སེང་ལྡེང་ལ་སོགས་པའི་ལྡེ་གུ་བསྟེན་ན་ཡང་ངེས་པར་ཚེ་རིང་བར་འགྱུར་བ་ཡིན་ནོ།",
    "སྐྱེས་བུ་དམ་པས་བསྟེན་པར་གྱུར་ན་ནི།",
    "ཛི་བ་ཀ་ཞེས་བྱ་བ་ཨ་ས་ནའི་ཁུ་བ་ལ་སོགས་པའི་ལྡེ་གུ་བསྟེན་ན་ཡང་རྒས་པ་ལ་སོགས་པའི་འཚེ་བ་མེད་པར་འགྱུར་རོ།",
    "རྒས་ཤིང་རྙིང་པའང་སླར་ནི་གཞོན་པར་འགྱུར།",
    "འཆི་བའི་བར་དུ་སོ་ནི་བརྟན་པར་འགྱུར།",
    "ཡིད་དུ་འོང་བའི་བདེ་བ་འཐོབ་ིཔར་འགྱུར།",
    "སྐྱེས་བུ་གང་ཏིལ་དང་ལྷན་ཅིག་ཏུ་སྐྱུ་རུ་ར་ལ་སོགས་པ་བརྡུངས་པ་བཅས་ཏེ་ཟོས་ན་ཡང་མི་དེ་ཇི་སྐད་སྨོས་པའི་མདངས་དང་ལྡན་པར་འགྱུར་ལ།",
    "དེ་བཞིན་དུ་བྲག་ཞུན་ལ་སོགས་པ་ཟོས་ན་ཡང་ལུས་ཟུངས་ཟླ་བ་ཡར་གྱི་ངོ་ལྟར་རྒྱས་པར་འགྱུར་རོ།",
    "ལོ་བརྒྱར་འཚོ་བ་དག་ཀྱང་ཐོབ་པར་འགྱུར།",
    "མན་དུ་ཀ་པ་ཎྚི་ནི་མར་དང་བརྔོས་། ཟླ་གཅིག་བར་དུ་ཟས་མ་ཟོས་པར་བསྟེན།",
    "གཞོན་ཞིང་མདངས་ལྡན་ཡོན་ཏན་ལྡན་པར་འགྱུར།",
    "ལྕགས་ཕྱེ་སྲང་ནི་ལྔ་བཅུ་ལས་བྱས་ཤིང་།",
    "གྲིབ་མར་བསྐམས་ཏེ་རིམ་གྱིས་མ་ལུས་པར།",
    "ལྕགས་ཀྱི་ཕྱེ་མ་ཞིབ་པར་བྱས་ཏེ་བསྐོལ།",
    "དེ་བཞིན་མར་དང་བསྲེས་པར་གྱུར་པ་དང་།",
    "སེང་ལྡེང་ལ་སོགས་པ་ཆ་མཉམ་པར་བྱས་ཏེ་བཏགས་ལ།",
    "དེ་བཙགས་ནས་ཆ་གཅིག་ཏུ་བྱས་པ་འོ་མའི་ཆ་ཡང་དེ་དང་མཉམ་པ་དང་།",
    "ཟླ་གཅིག་བར་དུ་ཾབསྟེན་པར་གྱུར་ན་ནི།",
    "ཏིལ་མར་བསྟེན་པར་བྱེད་པ་དག།",
    "འོན་ཀྱང་ཁྱད་པར་ནི་ཏིལ་མར་གྱི་སྦྱོར་བས་ལུས་ནག་པོ་ཉིད་དུ་འགྱུར་རོ།",
    "བཅུད་ཀྱིས་ལེན་གྱི་ཆོ་ག་བསྟན་པ་ལས་ལེགས་པར་མ་སྤྱད་པ་ཉམས་པར་གྱུར་ཏེ།",
    "བདེན་པར་སྨྲ་ཞིང་ཁྲོ་བ་མེད།",
    "མི་རྟག་པར་བདེན་པར་སྨྲ་བ་དང་།",
    "དམ་པའི་སྤྱོད་ལམ་ལ་དགའ་བ་རྣམས་ནི་རྟག་ཏུ་བཅུད་ཀྱིས་ལེན་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "བདེན་པར་སྨྲ་བ་ལ་སོགས་པའི་ཡོན་ཏན་འདི་དག་དང་ལྡན་པས།",
    "མི་གང་ཞིག་བཅུད་ཀྱིས་ལེན་བསྟེན་ཞིང་སྤྱོད་པར་བྱེད་པ་དེ་དག་ནི་བདེ་ཞིང་དགའ་བ་དང་ཚེ་རིང་བ་དང་།",
    "འཇིག་རྟེན་འདི་དང་འཇིག་རྟེན་གཞན་དག་ཏུ་བདེ་བ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "གང་ན་ཉེ་འཁོར་དུ་གནས་པའི་གྲོགས་ཀྱི་སེམས་དང་རྗེས་སུ་མཐུན་པར་འཇུག་པ་དང་།",
    "ཕྱི་མའི་གནས་ཀྱི་ལེའུ་སུམ་ཅུ་རྩ་དགུ་པའི་རྣམ་པར་འགྲེལ་པའོ།",
    "བཅུད་ཀྱིས་ལེན་གང་བུ་ཚའི་རྒྱུད་ནི་སྐྱེད་ེཅིང་མི་རབས་གནས་པར་བྱེད་པ་དང་།",
    "དེ་ནི་ལུས་ཀྱི་སྟོབས་དང་གཟི་བརྗིད་སྐྱེད་པར་བྱེད་པའི་མཆོག་ཡིན་ནོ།",
    "ཚངས་པར་སྤྱོད་ལ་བདག་ཡི་རང་།",
    "༢༡༧བཅུད་ཀྱིས་ལེན་དུ་གྱུར་པའི་ཚངས་པར་སྤྱོད་པ་ལ་གནས་པ་ལ་བདག་ཤིན་ཏུ་ཡི་རང་ངོ།",
    "དེ་ནས་སྣུམ་འགྱུར་སྦྱང་བྱས་པ།",
    "འབྲས་བུ་མེད་པར་གྱུར་པའི་ཤིང་།",
    "ལུས་སྦྱང་བྱས་ཏེ་ཅི་ནུས་པར།",
    "རོ་ཙའི་སྦྱོར་བ་བརྩམ་པར་བྱ།",
