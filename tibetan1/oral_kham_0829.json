    "དྲུང་ན་འདུག་པའི་མཚོན་པ་ཙམ་སྟེ་གཞན་ན་འདུག་པའང་དེ་བཞིན་ལྷ་ནོ།",
    "ཁྱིམ་པ་བདག་པོ་འདུག་པ་ལ་མ་དྲིས་པར་ལྷུང་བཟེད་ཀྱི་ཆུ་ཟས་དང་འབགས་པའི་ཆུ་དེ་ཁྱིམ་པའི་ཁྱིམ་དུ་མི་དབོའོ།",
    "ཉལ་བོ་བྱེད་པར་ཤམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "ཁྲི་ཚད་ཆུང་དུ་ནི་ཁྲིའུ་ཞེས་བྱ་སྟེ་དེ་ལ་བདག་ཉིད་འདུག་ཏུ་འཇུག་པའི་བསྙེན་བཀུར་ཁྲིའུ་ཡང་དང་ཡང་དུ་ཤོམ་དུ་འཇུག་པ་ཉམས་སུ་མྱོང་བ་བྱེད་པའི་དགེ་སློང་མ་ལའོ།",
    "དགེ་སློང་མས་ཁྱིམ་གཞན་དུ་བདག་པོས་མ་བསྒོ་བར་དེར་སྟན་ལ་འདུག་པ་ལའོ།",
    "འདུག་པའི་ཆེད་དུ་ས་ལས་བྱས་པའི་སྟེགས་བུ་གྲུ་བཞི་དག་དང་ཤིང་ལས་བྱས་པའི་ཁྲིའུ་ཡང་ངོ།",
    "བསླབ་པ་བྱིན་པ་དེ་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་ནང་དུ་འདུན་པ་ལེན་དུ་འོང་ན་ཡང་དེ་ལ་འདུན་པ་འབུལ་དུ་མི་རུང་ལ།",
    "ནམ་མཁའ་ལ་འདུག་པར་འདུག་པ་དང་འགྲོ་བར་མི་བྱའོ།",
    "མཚམས་ཀྱི་ནང་ན་འདུག་ན་ཞེས་སོ།",
    "གནས་དེ་ན་དགེ་སློང་རང་ཉིད་གཅིག་པུ་འབའ་ཞིག་ཡོད་ན་སྤྱོད་ལམ་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་པའོ།",
    "དགེ་སློང་རང་ཉིད་མ་གཏོགས་པ་ལྷག་མ་ཟླ་བོ་དགེ་སློང་གཞན་གཅིག་དང་བཅས་པ་སྟེ་དགེ་སློང་གཉིས་འདུག་པ་ཉིད་ཡིན་ན་མདུན་དུ་ཙོག་ཙོག་པུར་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "ཉེ་བར་ཙོག་ཙོག་པུར་ཕས་འདུག་ཚུས་འདུག་སྟེ་གཅིག་ལ་གཅིག་བྱིན་གྱིས་བརླབ་བོ།",
    "གནས་དེ་ན་དགེ་སློང་གསུམ་ཡོད་ན་ནི་གསུམ་ཆར་འཁོད་དེ་འདུག་ལ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "གནས་དེ་རྣམས་མཛེ་ཅན་གྱིས་འདུག་ན་གཞན་ལ་གནོད་པའི་ཕྱིར་རོ།",
    "ཁ་ཏོན་དང་འདུག་པ་དང་།",
    "གནས་ཁང་ལ་ལར་སྔ་དྲོ་དང་དགུང་ཚིགས་དང་ཕྱི་དྲོ་འདུག་པས་གནས་ཁང་ཐམས་ཅད་ལོངས་སྤྱད་པ་དེ་ལ་སྦྱར་བར་བྱའོ།",
    "ལུང་དང་རང་འགྲེལ་དང་ཊཱི་ཀ་ལས་བདག་གནས་པར་ཁས་བླངས་སམ་མ་བླངས་སྙམ་དུ་ཐེ་ཚོམ་ཟ་བ་ཉིད་ལ་ནི་དབྱར་གནས་པར་ཁས་བླངས་པ་མི་འཇིག་གོ།",
    "དེང་སང་ནི་དགེ་སློང་གསུམ་གསུམ་གྱི་མདུན་དུ་འདུག་པར་བྱེད་དེ་ཚེགས་ཆུང་བར་བྱ་བའི་ཕྱིར་རོ།",
    "གསུམ་པ་གཞི་དང་གང་ཟག་གཉིས་ཀ་འཇོག་པ་དེ་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ་ཚེ་དང་ལྡན་པའི་ཁོ་བོ་ཅག་ནི་ཚེ་དང་ལྡན་པ་ཅི་ནས་ཀྱང་གཞི་ཡང་འཇོག་པར་བྱེད་ཅིང་གང་ཟག་ཀྱང་འཇོག་པར་བྱེད་པ་དེའི་དོན་དུ་འདུས་ཤིང་འདུག་པ་མ་ཡིན་གྱིས་འདི་ལྟར་བཅོམ་ལྡན་འདས་ཀྱིས་ཞེས་པ་ལ་སོགས་པ་སྔ་མ་བཞིན་དུ་བརྗོད་པའིའོ།",
    "མི་ཕན་ཏེ་དགེ་སློང་དེའི་སྲ་བརྐྱང་རང་འཇུག་བྲལ་གྱི་གནས་སྐབས་ཉིད་ལ་གནས་སོ།",
    "གདིང་བ་དེ་ནི་སྡུག་ན་སྟེ་འཐུག་ན་ཆིག་རྐྱང་རང་ངོ།",
    "ཏེ་གང་ན་ནོར་རྫས་དེ་འདུག་པའི་མཚམས་དེར་གཏོགས་པ་རྣམས་ཀྱིས་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "གཙུག་ལག་ཁང་བཞིའམ་གསུམ་གྱི་མཚམས་ཀྱི་བར་ན་འདུག་པའམ་གཙུག་ལག་ཁང་གཉིས་ཀྱི་མཚམས་ཀྱི་བར་ན་ཤི་བའི་ཡོ་བྱད་བྱིན་གྱིས་བརླབ་པར་བྱ་བའི་རྫས་ནན་ཡཔས་བྱས་པས་ཙ་ཚད་པ་ག་རྒྱུས་༣ས་མ་བསམ་ལསན་༥ཙ་མ་མཆན་འགྲེལ།",
    "རྒྱ་ལྕང་ངམ་ནི་སྐུད་པ་མང་པོ་ལས་གཏགས་པ་ཉིད་དུ་དབུས་ཁོང་སྟོང་དུ་འདུག་པའོ་ཞེས་ཊཱི་ཀའོ།",
    "སྣམ་སྦྱར་དེ་ལ་དེའི་སྟེང་དུ་འདུག་པའམ་ཉལ་བར་མི་བྱའོ།",
    "འདུག་པར་མི་བྱའོ།",
    "མ་དྲིས་པའི་སྣམ་སྦྱར་ཡོད་པས་ཀྱང་དེར་འཇུག་པ་དང་འདུག་པར་མི་བྱ་ན་སྣམ་སྦྱར་གཏན་ནས་མེད་པས་ལྟ་ཅི་སྨོས་སོ།",
    "རྐྱེན་དེ་ལྟ་བུ་དག་མེད་པར་སྣམ་སྦྱར་མེད་པའམ་སྣམ་སྦྱར་མ་དྲས་པ་དེས་མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་སུ་ཡང་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ་ཞེས་སྔ་མ་དེ་བཞིན་ནོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དེ་ན་མུ་སྟེགས་ཅན་དག་འཁོད་ཅིང་མུ་སྟེགས་ཅན་ཉེ་བར་གནས་ན་ནི་རྐྱེན་དེ་ལྟ་བུ་དག་ཡོད་ཀྱང་འདུག་གནས་དེར་སྣམ་སྦྱར་མེད་པར་འཇུག་པ་དང་འདུག་པར་མི་བྱའོ།",
    "དགེ་ཚུལ་ཕ་ཞིག་འོང་ན་ཡང་དེ་དེར་འདུག་ལ་ཟོ་ཞིག་ཅེས་ལུང་སིལ་བུ་ལས་སོ།",
    "དགེ་སློང་ཀོ་ལྤགས་ལ་འདུག་པར་བྱའོ།",
    "དུ་དོམ་ལྤགས་དེ་རྐང་པའི་གནས་སུ་གདིང་བ་དང་མཆིལ་ལྷམ་དག་ཏུ་བགོ་བ་དང་འདུག་པ་དང་ཉལ་བར་ཡང་བྱའོ།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་དང་།",
    "དགེ་སློང་དག་ཕྱིན་པའོ་ཞེས་སྨོས་ན་དེའི་དུས་ཀྱི་ཚིགས་ཅིས་བཟུང་ཞེ་ན་གནས་དེར་ཕྱིན་ནས་བྱ་བ་གཞན་ཆུ་བཙགས་པ་དང་གནས་ཁང་བསྐོ་བ་སོགས་བརྩམས་པ་དང་ངལ་བསོ་བ་ནི་སྟན་ལ་སོགས་པ་འདུག་པ་སྟེ་བྱ་བ་དེ་གཉིས་དངོས་ནི་ད་དུང་མ་བྱས་མ་དེ་གཉིས་བྱ་བའི་མཚམས་ལ་ཐུག་པ་ཚུན་ཆད་ཀྱི་དུས་དེ་ནི་དགེ་སློང་དག་ཕྱིན་པ་ཉིད་ཀྱི་དུས་དེ་ཉིད་དོ།",
    "སྟན་གཞན་མེད་ན་རྩ་བམ་ལ་འདུག་པར་བྱའོ།་།",
    "དུས་སྟོན་ཆེན་པོ་བྱུང་སྟེ་འདུས་པ་ཆེན་པོའི་ཚེ་དགེ་སློང་མ་རྣམས་རྒན་རིམ་བཞིན་དུ་འདུག་པ་ན་ཅ་ཅོ་འདོན་པར་གྱུར་ནས་འདི་གསུངས་སོ།",
    "སྒོའི་ལོག་གཅིག་ནང་དུ་སྣོལ་ལ་སྒོའི་ལོག་གཅིག་ཕྱིར་སྣོལ་ཞིང་སྒོ་དྲང་ཐད་དུ་མི་འདུག་པས་ནང་དུ་ཞུགས་པའི་མི་དེ་ཕྱི་རོལ་ནས་མི་སྣང་བ་དེ་ལྟར་སྒོ་གདོད་པར་བྱའོ།",
    "ལུང་ལས་འདུག་པ་ན་རྐུབ་རུས་ན་ན་ཐགས་མའི་སྦུ་གུའི་ཐན་ཀོར་འབོལ་བའི་ཕྱིར་དུ་ལོ་མའི་ཆངས་བུ་དག་གཞུག་གོ།",
    "གང་ཟག་ཇི་ལྟ་བུས་ཕྱིར་བཟློག་འཆགས་ཞེ་ན་འདུག་པའི་སྤྱོད་ལམ་ལས་མ་ཉམས་པ་དང་།",
    "རབ་ཏུ་དབྱུང་བར་འདོད་པ་སྟེ་ཙོག་པུར་འདུག་སྟེའོ།",
    "མནན་ཏེ་འདུག་པར་བྱའོ།",
    "ཅི་བདེར་འདུག་ཏུ་གཞུག་པ་ཡིན་ཀྱི་ཙོག་པུར་འདུག་ཏུ་མི་གཞུག་གོ།",
    "ཙོག་པུར་འདུག་སྟེ་བརྗོད་པར་བྱའོ།",
    "གསོལ་བ་ལ་སོགས་པའི་ལས་ཐམས་ཅད་ནི་འདུག་པ་ཉིད་ཀྱིས་སོ།",
    "ཤིང་དྲུང་ལ་སོགས་འདུག་པའི་གནས་ཐམས་ཅད་ལ་བསླབ་པ་རྒན་རིམ་དུ་བསྐོ་བར་བྱའོ།",
    "གང་ཟག་དེ་ཚུལ་ཇི་ལྟར་འདུག་པ་ལ་བྱ་ཞེ་ན་རྩི་བཅད་དེ་ས་ལ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པའི་དྲུང་དུ་སྟན་ཆེས་དམའ་བ་ཉིད་ལ་འདུག་པར་བྱའི་དེ་ལས་གཞན་སྟན་མཉམ་པའམ་མཐོ་བས་འདུག་པར་ཡང་ངོ།",
    "སྟན་མཉམ་པའམ་མཐོ་བས་འདུག་པར་མི་བྱ་ན་སྟན་གཅིག་ལ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་ཏུ་ངོས་དང་སྟེང་གཡོགས་མ་གཅིག་ཏུ་ཉལ་བར་མི་བྱ་བས་དེར་མལ་བཤམ་པར་མི་བྱའོ།",
    "དེ་གཉིས་ཀྱིས་དགེ་སློང་རང་བཞིན་གནས་པ་དེ་དང་བརྟེན་པར་ཏེ་འཇིང་པ་བསྒྲིལ་བར་མི་བྱའོ།",
    "གསོ་སྦྱོང་དང་དགག་དབྱེ་གཞག་པ་ཞེས་བྱ་བ་ནི་གང་དག་འདི་འདུག་པ་དང་ལྷན་ཅིག་དགེ་སློང་རྣམས་ཀྱིས་གསོ་སྦྱོང་དང་དགག་དབྱེ་མི་བྱའོ་ཞེས་བྱ་བ་ཡིན་ཊཱི་ནོ།",
    "གནས་གང་དུ་དུས་འདའ་བར་བྱ་བ་ངལ་བསོ་བའི་གནས་བསྟི་གནས་ལྟ་བུ་གནས་དབེན་པ་གང་ན་མི་མཐུན་པ་དང་པོ་ཡོད་པ་དེ་དང་ལྷན་ཅིག་ཏུ་འཁོད་པ་འདུག་པ་དང་འགྲེང་བར་མི་བྱའོ།",
    "གནས་བརྟན་དེས་རྒོལ་ཕྱིར་རྒོལ་དེ་གཉིས་དང་ལྷན་ཅིག་འགྲེང་བ་དང་ལྷན་ཅིག་འདུག་པ་དང་ལྷན་ཅིག་འཆག་སར་འཆག་པ་དང་གཏམ་འདྲེ་བ་དང་བག་ཕེབས་པར་སྨྲ་བ་ཡང་ངོ།",
    "རྒྱབ་གྱིས་ཕྱོགས་པ་མདུན་ཕར་ལ་ལྟ་བ་དང་ཁྱིམ་གཞན་ཁྱིམ་པའི་ཊཱི་ཁྱིམ་ན་འདུག་པ་དང་།",
    "ས་གཞན་ན་གནས་པ་དང་ཉམས་པ་ལ་སོགས་པ་བཅུ་གསུམ་སྔར་བསྟན་མ་ཐག་པ་དེ་རྣམས་ལས་ཁྱིམ་གཞན་ན་འདུག་པ་མ་གཏོགས་པ་གཞན་ཐམས་ཅད་ལ་ནི་ཁྱིམ་པས་ཀྱང་ཕྱག་མི་བྱའོ་རབ་ཏུ་བྱུང་བ་ཁྱིམ་གཞན་ན་འདུག་པ་དག་ལ་ཡང་ཁྱིམ་པས་ཕྱག་བྱའོ་ཞེས་ཊཱི་ཀ་ལས་སོ།",
    "ལྷོད་ཕབ་ཏུ་འདུག་པར་བྱའི་མ་བསྒོ་ན་ཙོག་པུས་སོ།",
    "འདུག་པར་བྱའོ།",
    "ཉིད་ཡིན་ན་གསར་བུ་དེས་ལྷོད་ཕབ་ཏུ་འདུག་པའི་ཕྱིར་ལུང་འབོག་པ་པོ་ལ་ཞུ་བར་བྱའོ།",
    "དེས་མཁར་ལན་གྱི་ལས་གྲོགས་བྱ་བས་བསྟང་བ་སྟེ་ལས་གྱི་གྲོགས་བྱ་ལྷ་བའི་དུས་ནི་ཉི་མ་ལུང་རངས་པོ་ཁོ་ནར་ལས་མི་བྱ་བར་གལ་ཏེ་དགུན་ཡིན་ན་ཟས་ཀྱི་འོག་རོལ་ཏུའོ།",
    "སེང་གེའི་ཁྲི་ལ་འདུག་པའི་མདུན་དུ་མེ་ཏོག་དང་བདུག་སྤོས་དགྲོ་མ་ཞེས་འབྲེལ་ཆུང་ལས་སོ།",
    "བཀའ་སྩལ་པ་སྐར་ཁུང་དེ་དག་མ་མཐའ་དང་དགེ་སློང་འདུག་པའི་ཁྲི་ལ་སོགས་པའི་སྟན་གྱི་ཚད་དག་ཡ་མཐའ་ཐད་ཀར་བབ་པ་བྱའོ།",
    "ཁྲིའུ་ཁྲི་ཆུང་དུ་གྲུ་བཞི་ལ་གང་ཟག་གཅིག་ཁོ་ན་འདུག་པར་བྱའི་གཅིག་གཉིས་ཡན་ཆད་མ་ཡིན་པས་འདུག་པར་མི་བྱའོ།",
    "འདུག་པར་མི་བྱའོ།",
    "གང་དུ་ཡང་སྟན་གཅིག་ལ་འདུག་པར་མི་བྱའོ།",
    "བསླབ་པ་བྱིན་པ་གཉིས་སྟན་གཅིག་ལ་འདུག་ཏུ་མི་རུང་ངོ་ཞེས་ལུང་ལས་སོ།",
    "ས་སྟེགས་སམ་ཤིང་ལེབ་བམ་རྡོའི་སྟེང་ན་ནི་ཁྱིམ་པ་དང་ཡང་ལྷན་ཅིག་ཏུ་འདུག་ཏུ་རུང་ངོ་ཞེས་ཊཱི་ཀ་ཆུང་ལས་སོ།",
    "སྤུ་གྲི་དང་རང་ཐག་ལ་སོགས་པ་ལ་ཇི་ལྟར་སུ་སྔར་འོངས་པས་ལོངས་སྤྱད་པར་བྱ་བ་ཡིན་གྱི་བསླབ་པ་རྒན་རིམ་གྱིས་སྤྱད་པར་བྱ་བ་ནི་མ་ཡིན་ཏེ་དང་པོར་སུ་འོངས་པ་དེ་ལ་གཡར་པོར་སྦྱིན་ནོ།",
    "ཆར་པ་ཆད་ན་དྲུང་ན་འདུག་པའི་ཁྱིམ་དག་ཏུ་གདུགས་དེ་བཞག་གོ།",
    "དགེ་སློང་མ་དེས་དབྱར་ཁང་དེའི་ཕྱི་སྒོར་འདུག་པར་མི་བྱའོ།",
    "ལོགས་ཀྱི་སྐར་ཁུང་ཆེན་པོ་ན་འདུག་པར་བྱེད་ནས་དགེ་སློང་མས་སྐར་ཁུང་དུ་འདུག་པར་མི་བྱའོ་ཞེས་ལུང་ལས་གསུངས་ཀྱང་ཊཱི་ཀ་ལས་སྐར་ཁུང་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་ཕྱི་རོལ་སྣང་ཡེལ་ཅན་ཐམས་ཅད་དུ་དགེ་སློང་མས་འདུག་པར་མི་བྱའོ།",
    "གོས་ཐམས་ཅད་ཕུད་དེ་གཅེར་བུར་མི་འདུག་བི་གོ།",
    "དགེ་སློང་མ་གོས་མེད་པ་ཅན་གྱིས་འདུག་པར་མི་བྱ་བ་དེ་ལ་རྡུལ་གཟན་ནི་གཅེར་བ་བསྐྱབ་པའི་གོས་ཉིད་ཡིན་པས་དེས་རྔུལ་གཟན་གྱོན་ན་གཅེར་ཐེར་འདུག་པའི་ཉེས་པ་མེད་པ་ཡིན་ནོ།",
    "སེང་གེའི་ཁྲི་ལ་། བཞུགས་པ་གདའ།",
    "སྐྲ་དཀར་སྙེར་མ་སྦག་དུས་སུའང་།",
    "གཉན་ལུང་ཞེས་བྲིས་པ་ཡང་འདུག་ཕྱི་མ་ནི་ཡོངས་གྲགས་ལྟར་མིན་པར་ཨིན་ཌོ་ཨི་ར་ནིཀའི་རུས་ཤིག་ཡིན་པ་དང་།",
    "དུས་རབས་བརྒྱད་པའི་ནང་ཙམ་ན་བེ་རོ་ཙ་ནས་བླ་ཆེན་དྲན་པ་ནམ་མཁའ་ལ་ཞུས་པ།",
    "ཞེས་གསལ་བའི་ནང་དབུས་བྱང་ངེས་པ་ཐང་དང་བྱང་གོ་ལ་གོང་ཞེས་གཉིས་ཀྱི་ནང་ནས་དབོ་བྱང་ངམ་དབུས་བྱང་ཞེས་པའི་རུ་ཐོག་ནང་དུ་ཡོད་པའི་ས་དེ་ཡིན་དགོས་པར་འདུག་ན་ཡང་དཔྱད་དགོས།",
    "ཞེས་ཐེ་ཚོམ་གྱི་ཚུལ་དུ་གསུངས་འདུགདེས་ན།",
    "རྟ་རྗེས་འདུག་པ་མཐར་དེད་པས།",
    "སྒར་ཆེན་གཅིག་འདུག་པར་སླེབས།",
    "དེའི་ཁྲོད་ན་ཆིབས་པ་ཡང་འདུག་ནས།",
    "རྟ་སྒ་བླ་ཆེན་པ་ལ་རྟ་བཅུ་བདུན་གྱིས་མགོ་བྱས་ཕུལ་འདུག་པ་ལ།",
    "ཕྱོགས་གཞན་ནས་ལྟས་ན་གྲ་བོ་ཞེས་པ་དེ་དཔོན་གྱི་མིང་མ་ཡིན་པར་རྟའི་མིང་ཡིན་པར་གོ་བ་ལེན་ཕྱོགས་གཅིག་ཀྱང་འདུག་ན་དཔྱད་པར་བྱ།",
    "བྱང་པ་དང་བོད་ཀྱིས་གདོང་ལེན་བྱས་གཞུག་འདུག་སྟེ།",
    "མངའ་རིས་ནང་དཔལ་འཁོར་ལོ་བདེ་མཆོག་གནས་ཀྱི་གཙོ་བོ་གངས་དཀར་གྱི་རྒྱལ་པོ་ཏི་སེ་དང་མཚོ་མ་ཕམ་གཉིས་སུ་གནས་བསྐོར་ལ་ཕེབས་མཁན་ཕྱི་མི་ཡང་མང་དག་ཅིག་དུས་རབས་རིམ་པའི་ནང་བྱུང་ཡོད།",
    "ཤོག་གྲངས་༥རུ་ཐོགནས་དེ་རིགས་མི་བྱེད་བཅས་བཀའ་སྩལ་འདུག་པ་ལྟར་ན།",
    "ཇི་ལྟར་འདུག་གསུངས་པ་ལ།",
    "རི་བརྒྱུད་ནས་གསེར་མང་པོ་འཐོན་པས་དེ་ལྟར་ཟེར་ཞེས་གསེར་གྱི་རིགས་ཀྱི་ངོས་འཛིན་གསལ་པོ་གནང་འདུག་ན་ཡང་ད་དུང་དཔྱད་པར་བྱ་དགོས་སོ།",
    "ང་རང་དུང་ཤ་ཤེལ་རུ་ཡིན།",
    "ཞེས་ཤེལ་རྒྱུང་དང་སྟོང་རྒྱུང་ཞང་བོད་ཀྱི་རྒྱུང་སྟེ་ལྷའི་ཚོགས་སུ་བགྲངས་འདུག།",
    "དཔེ་འགར་ཨ་ན་ཞེས་ཀྱང་བཀོད་ཡོད་འདུག་ཅེས་གསལ།"
  ]
