    "དེ་ལྟར་འཆི་བདག་རྣམས་ཀྱིས་ཀུན་ཏུ་ཁྲིད་པར་གྱུར་པའི་སྤྲུལ་པའི་ཀླུ་དེ་དག་རྣམས་ཀྱང་རང་བཞིན་གྱི་ལྷ་དེ་དག་རྣམས་ཀྱིས་མཐོང་བར་གྱུར་ཏོ།",
    "དེ་བཞིན་དུ་ཁ་ཟས་ཧ་ཅང་བསྟེན་པས་ཀྱང་སྡུག་བསྔལ་བར་འགྱུར་རོ་ དུས་ཡུན་རིང་དུ་འདུག་པ་སྟེན་པས་ཀྱང་སྡུག་བསྔལ་ལོ།",
    "འདུག་པ་དང་ཟས་ངན་པ་དྲི་མ་ཅན་རྣམས་ཀྱིས་ཟིལ་གྱིས་མནན་པའི་ཕྱིར་དང་།",
    "དེ་ཡི་མདུན་དུ་དེ་བཞིན་འདུག།",
    "སྨོན་རྒྱལ་ནམ་མཁའི་མིང་ཅན་འདི་ཡིན་པ་ཐག་ཆོད་འདུག་པས།",
    "རང་རང་སྡུག་བསྔལ་སྦྱོང་ལ་རབ་འཇིགས་ནས།",
    "ལོངས་སྤྱོད་གང་ཡང་རང་བཞིན་ལྷུན་གྱིས་གྲུབ།",
    "སྡུག་བསྔལ་མིན་པ་གཅིག་ཀྱང་མི་འདུག་པ་ཤེས་དགོས་སོ།",
    "ཆེད་དུ་མ་བསྒོམས་ཀྱང་རང་བཞིན་ཤུགས་ཀྱིས་འཁོར་ཡོང་བ་རང་བཞིན་གྱི་ཞི་གནས།",
    "དངོས་ཅན་དབྱིབས་དང་ཁ་དོག་ཅན་ཞིག་འདུག་གམ།",
    "དངོས་མེད་སྨྲ་བསམ་བརྗོད་པ་བྲལ་བ་ཞིག་འདུག་ལེགས་པར་རྩད་གཅོད་བཅུག་པས།",
    "ཡང་སེམས་དེ་དག་བཙལ་རྒྱུ་དང་འཚོལ་མཁན་གཉིས་གཅིག་གམ་ཐ་དད་དུ་འདུག་ལེགས་པར་རྩད་གཅོད་བཅུག་པས།",
    "འདི་དང་པོ་ནས་རང་ཆས་སུ་འདུག་པ་འདི་བས་སྔ་ནས་ཤེས་ཤིང་རིག་ན་ཐང་།",
    "དུ་འདུག་རྣམས་དང་བསྲེ།",
    "མཉམ་རྗེས་དབྱེར་མེད་དུ་འདྲེས་འདུག་སྙམ་པ་དང་།",
    "སེམས་སྣང་བ་རུ་འདུག་གམ་སྣང་བ་སེམས་སུ་འདུག་པ་ཉམས་སུ་བླངས་པས།",
    "གཅིག་པུར་འདུག་ན་མི་སྐྱོ་བ།",
    "ངང་དང་རང་བཞིན་བདག་ཉིད་ཆེན་པོ་ཉམས་སུ་བླངས་པ་ལ།",
    "གཞན་ཡང་ཉན་ཐོས་དང་རང་རྒྱལ་སེམས་དཔའ་སེམས་མའི་སྐུ་མང་ཉུང་གྲངས་ལས་འདས་པ་འཆར་རོ།",
    "ལུས་ཅོག་པུ་ལ་འཁྱུད་ཀྱི་འདུག་ལྕེ་ཡར་རྐན་ལ་སྦྱར།",
    "ཞེས་པ་ལྟར་རྟགས་རྣམས་འབྱུང་ཞིང་རང་རིག་ཡེ་ཤེས་མངོན་སུམ་དུ་རྟོགས་པར་འགྱུར་རོ།",
    "སྣང་ཡང་བདེན་པར་གྲུབ་པ་མེད་བཞིན་དུ་དེ་ལ་ཆགས་སྡང་བྱེད་དོན་མི་འདུག་སྙམ་པར་བྱའོ།",
    "ནས་ཀུན་སློང་དེ་ལྟ་བུར་གྱུར་འདུག་ན།",
    "ལྷ་མིའི་བདེ་བའི་དོན་དང་རང་ཉིད་ཀྱི།",
    "འགྱོད་པ་ཡེ་མ་བྱས་པས་སྡིག་སྒྲིབ་མི་འབྱོང་འདུག་ཞེས་གསུངས།",
    "གདམས་ངག་ཅན་མང་བ་གདའ་སྟེ།",
    "གཞོན་པའི་དུས་ན་དགེ་སྦྱོར་མི་དྲན་པར་འདུག་སྟེ།",
    "སྣང་བའི་ཕྱི་ན་འབྲང་བར་གདའ།",
    "རྒས་ནས་དྲན་པར་གདའ་སྟེ་མི་ནུས་པར་གདའ།",
    "འཆི་ཁར་དགེ་སྦྱོར་མ་བྱས་པ་ལ་འགྱོད་ཀྱིན་གདའ་སྟེ་འཕྱིས་ནས་གདའ།",
    "འཆི་མནོ་བ་རང་ཀུན་ལ་གདའ་སྟེ།",
    "གནས་ན་འདུག་པ།",
    "རང་རང་སྡུག་བསྔལ་སྦྱོང་ལ་རབ་འཇིགས་ནས།",
    "རྟག་ཏུ་རང་རྒྱུད་འདུལ་ཅིང་རང་སེམས་བོན་དང་འདྲེས་པར་བྱེད་པ་གལ་ཆེ།",
    "ལོངས་སྤྱོད་གང་ཡང་རང་བཞིན་ལྷུན་གྱིས་གྲུབ།",
    "འདོད་པའི་ལྷ་དེ་ལ་དྲུག་ཡོད་པ་ལས་རྒྱལ་ཆེན་རིགས་བཞིའི་ལྷ་ནི་རི་རབ་ལ་གནས་ཤིང་དེ་ཡང་མངལ་ནས་སྐྱེ་བ་དང་འདོད་ཡོན་གྱི་ཚོགས་ལོངས་སྤྱོད་གང་ཡང་རང་བཞིན་གྱིས་ལྷུན་གྱིས་གྲུབ་པ་སྟེ།",
    "དེ་ཡང་རང་འདོད་རྩ་བ་ནས་མ་ཟད་ན།",
    "དགེ་སྒྲུབ་སྡིག་སྤང་ལ་མི་བརྩོན་པ་ཡང་ཡོད་འདུག་ཀྱང་།",
    "ལོག་པར་མ་བསྔོས་ཀྱང་རང་དོན་གཅིག་པུར་བསྔོས་ན་རྒྱ་ཆུང་བ་དང་།",
    "གདམས་པ་མང་ཡང་རང་རྒྱུད་ཐུལ་བ་ཞིག་དགོས།",
    "ཡིད་ཀྱིས་ཀྱང་རང་ལུས་ལྷ་ཡི་བུ་བྱེ་བ་ས་ཡ་རུ་སྤྲོས་ཤིང་སྟོང་གསུམ་འཇིག་རྟེན་ཀུན་ཁྱབ་སྟེ།",
    "ཙ་ཙ་བན་ས་ཁྲ་བོར་འདུག་ཀྱང་རུང་སོ་སོའི་ཁ་དོག་ཀྱང་རུང་དེ་བཞིན་དུ་གྱོལ་པོ་ནི་རྐང་ཡོན་ནོ།",
    "དགེ་སློང་རང་ལ་གཙུག་ཕུད་འཇོག་པ་འདྲེག་མཁན་ལ་སོགས་པ་བྱེད་དུ་མི་གཞུག་གོ།",
    "ལུས་ཕྱིས་མེད་ན་ཡུད་ཙམ་ཞིག་ནི་ཁྲུས་བྱས་པས་ལུས་གཤེར་བ་མ་བསྐམས་ཀྱི་བར་དུ་ཙོག་པུར་འདུག་པ་ནི་ལུས་ལ་ཆུའི་ཐིག་པ་མྱུར་དུ་འབྲུལ་བའི་ཕྱིར་ཊཱི་ལ་ཁྲུས་རས་ཀྱིས་ལུས་ཕྱི་བར་བྱའོ།",
    "འདུག་སྟེ་བྱའི་འགྲེང་བཞིན་དུ་ལྷུང་བཟེད་སྣོད་ནས་དབྱུང་བ་དང་གཞུག་པ་དང་སྐམ་པར་མི་བྱའོ།",
    "ཡུན་ཇི་སྲིད་དུ་མི་གནས་པར་འདུག་པ་ལ་ཉེས་པ་མེད་ཅེ་ན་ཞག་ལྔའི་མཐར་ཐུག་པའི་བར་དུའོ།",
    "གནས་དང་གནས་པ་གཉིས་གཙུག་ལག་ཁང་གཅིག་པི་པ་དེ་ན་འདུག་ན་གནས་པས་གནས་དེའི་དྲུང་དུ་ཉིན་པར་ལན་གསུམ་དུ་འགྲོ་ཞིང་བྱ་བ་ཞུ་བར་བྱའོ།",
    "གནས་དེ་ལ་གནས་པས་བཞར་བར་བྱ་སྟེ་ཐག་མི་རིང་བར་འདུག་པར་ཊཱི་བྱའོ།",
    "གོང་དུ་འདུག་པ་དང་འགྲེང་བར་ཎྜི་མི་བྱའོ།",
    "གལ་ཏེ་དགེ་སློང་རང་དང་ཡུལ་མི་གཞན་ལ་དངོས་སུ་གནོད་པར་མི་འགྱུར་བ་ནི་མི་དགག་པར་ཅི་བདེར་བཏང་སྙོམས་སུ་བཞག་གོ།",
    "གཡོག་འཁོར་གྱི་བྱ་བ་མི་མཐུན་པ་དེ་དག་རྒྱུན་བཅད་པར་མི་ནུས་པ་ཉིད་ཡིན་ན་དགེ་སློང་རང་ཉིད་གནས་གཞན་དུ་འགྲོ་བར་བྱའོ།",
    "མགུལ་པ་ཁྲམ་གཉེར་དུ་འདུག་པ་ཤིང་ཏ་ལའི་གཉེར་མ་ལྟ་བུ་དང་།",
    "ཚིག་ཏུ་སྨྲས་པ་དེ་ཁོ་ན་ལས་བསླབ་པ་དབུལ་བར་འགྱུར་བར་མ་ཟད་ཀྱི་ཚིག་ཏུ་མ་སྨྲས་པར་གཏོང་བའི་མཚན་མ་ལས་ཀྱང་ཕུལ་བར་འགྱུར་ཏེ་དེས་ན་ལུས་ཀྱི་རྣམ་པར་རིག་བྱེད་ལས་ཕུལ་བར་འགྱུར་ཞེས་ཊཱི་ཀ་དང་རང་འགྲེལ་ལས་ཀྱང་ངོ།",
    "སྒོ་གཏན་ཞེས་བྱ་བ་ནི་སྒོ་ལྕགས་ལ་སོགས་པའི་ཞེས་སོ་འགྲེལ་ཆུང་ལས་ཁང་པ་ལྟ་བུས་མཐའ་བསྐོར་ཅིང་འདུག་པ་ལ་སྒོ་གཏན་པ་བཅུག་སྟེ་ཉལ་ན་ཉེས་མེད་དོ་ཞེས་སོ།",
    "མུ་ཏིག་ཆུན་པོ་ལ་སོགས་རྩྭ་བཏིང་བའི་སྟེང་ན་འདུག་པ་ལ་རྩ་ཁ་དོག་གཅིག་པ་ཡིན་ན་ཕྱོགས་གཅིག་པར་བརྗོད་པར་བྱའོ།",
    "ཐོག་མ་འདུག་པའི་གནས་མི་སྣང་བར་གྱུར་ན་ཕམ།",
    "ཕ་རོལ་གྱི་འགྲམ་དུ་མ་ཕྱིན་ཀྱང་ཐོག་མ་འདུག་པའི་ས་མི་སྣང་ན་བི་ཕམ།",
    "གང་ན་གྲུ་ཕུར་པ་ལ་བརྟོད་ཅིང་འདུག་པའི་གནས་དེ་ནས་ཁྲིད་དེ་ཕ་རོལ་ཏུ་བསྒྲལ་བའི་ཕྱིར་ཚུ་རོལ་ཏུ་བཏང་བའི་གནས་སུ་གྱེན་ལ་འཁྲིད་པར་བྱེད་པའི་ཕྱོགས་དེ་ནི་གྲུ་ཚུགས་ཞེས་བྱའོ།",
    "ནོར་མང་པོ་ཞིག་འདུག་པ་ལ་གདམ་སྟེར་གང་བཟང་པོ་དེ་རྐུ་བར་འདོད་པས་ཊཱི་གདམ་པ་ལ་ཡང་དངོས་གཞི་རྣམ་པའི་སྦོམ་པོའོ།",
    "རྩིས་བྱེད་པ་ལྟ་བུ་ལ་བཅུ་ཁྲམ་དང་བརྒྱ་ཁྲམ་དང་ཡིག་འབྲུ་ལ་སོགས་པ་གླེགས་བུ་ལ་བྲིས་ཏེ་བཞག་པ་ན་བདག་རྒྱལ་བར་བྱ་བའི་ཕྱིར་བཅུ་ཁྲམ་དང་བརྒྱ་ཁྲམ་ལ་སོགས་པའི་མཚན་མ་ཕྱིས་པ་མེད་པར་བྱས་པ་དང་མཚན་མ་བསྣན་པ་ལྷག་པར་བསྣན་པ་གཉིས་དང་མཚན་མ་གནས་གཞན་དུ་ལྟག་འོག་སྣོར་ཅིང་བཞག་པ་ཡང་རང་འགྲེལ་དང་ཊཱི་ཀ་ལས་དེ་ཉིད་ཡིན་ཏེ་སྦྱོར་བ་དེའི་སྦྱོར་བ་སྟེ་ཉེས་བྱས་ཉིད་དོ།",
    "མི་གཞན་ལ་འདི་ལྟར་བྱས་ན་ཕམ་པར་འགྱུར་བས་དགེ་སློང་རང་ཉིད་གཡང་ས་ནས་མཆོང་བ་དང་།",
    "རྣམ་འབྱེད་འགྲེལ་ལས་རྡུལ་ཁྲོད་ཀྱི་ཤ་ཟ་ནི་ཕྱག་དར་ཁྲོད་ཀྱི་འདྲེའམ་ཚུབས་མའི་ནང་ན་འདུག་པའི་འདྲེའོ་ཞེས་སོ།",
    "ཁྱིམ་དུ་ཞུགས་ཤིག་སྟན་ལ་འདུག་ཅིག་ལག་ཆུ་བཟེད་ཅིག་བཟའ་བ་དང་།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གནས་ལ་བརྟེན་པ་སྟེ་དེ་དག་དང་ཉེ་བར་གྱུར་པ་ཉིད་དང་།",
    "ལོ་དྲུག་སྟན་གྱི་གནང་བ་གསོལ་བ་ན་སྟན་སྔ་མ་རྙིང་ཞིང་བཅོས་དཀའ་བ་ཉིད་ཡིན་ནམ་མ་ཡིན་བརྟག་པ་ལ་ཡང་ཡང་རང་དག་རྟོག་ཏུ་འདོང་བར་བྱའོ་ཡང་ན་དགེ་སློང་བསྐོས་པ་དག་གོ་ཞེས་དེ་བཞིན་ནོ།",
    "བརྙར་མ་རྙེད་ན་བླ་གོས་སྣམ་ཕྲན་བདུན་པ་བཞི་ལྟབ་ཏུ་བྱས་པའི་སྟེང་དུ་མཚན་ཐོག་ཐག་ཏུའམ་ཞེ་ན་ཡུན་རིང་དུ་མི་ཉལ་ཡུན་ཐུང་ངུ་ནི་ཉལ་ཌི་བར་བྱ་ནམ་གྱི་སུམ་ཆ་དགུང་ཐུན་ལ་ཉལ་བར་བྱའོ་སྲོད་དང་ཐོ་རངས་ནམ་གྱི་སུམ་གཉིས་ཀྱི་བར་དུ་བཅག་པའམ་ཙོག་པུར་འདུག་ལ་ཁ་ཏོན་བྱའོ།",
    "ཡང་ན་བྱ་གག་ཁྱིམ་བྱ་དེ་ཕོ་སྤར་འཕུར་དུ་བཅུག་ནས་ས་ལ་བབས་ཏེ་འདུག་པའི་ལམ་གྱིས་ཇི་ཙམ་དུ་ཁྱབ་པ་ཉེ་འཁོར་ཡིན་ནོ་དེ་ལ་འདོམ་དགུའོ།",
    "འདུག་པ་ཕྱིར་འོང་བ་ན་ཁལ་འབོག་པ་ལྟ་བུ་དང་།",
    "གནས་ཀྱི་བདག་པོ་ཐ་དད་པའི་མཚམས་གཞན་ནམ་མཁའ་འམ་ཆུས་བར་དུ་ཆོད་པའི་མཚམས་གཞན་ནི་དྲུང་ན་འདུག་ཀྱང་ཉེ་འཁོར་མ་ཡིན་ནོ།",
    "དབེན་པ་དེར་དགེ་སློང་མ་མི་འདུག་ན་དགེ་སློང་མ་གཞན་རྣམས་ཀྱིས་ཡལ་བར་མི་དོར་རོ།",
    "ལ་༦ནས་སྐྱེས་པ་ནི་ཁ་དོག་དཀར་པོར་འདུག་ན་སྔ་མ་བལ་དཀར་བོའོ།",
    "གནོད་པ་མི་བྱ་བར་མི་བཏུབ་ན་ཁ་བཙུམ་སྟེ་འདུག་གོ།",
    "འདུག་པའི་ཁྲིའུ་དང་།",
    "དགེ་སློང་གནས་ནས་འཕགས་པར་འགྱུར་བ་ན་གནས་མལ་སྡུད་ཅིང་བསྡད་ན་མགྲོན་པོའི་རྗེས་མ་སླེབས་ནས་ཆོམ་རྐུན་པས་བཅོམ་པ་ལ་སོགས་པའི་རྐྱེན་ཉམ་ང་བ་དང་ཕྲད་པར་མི་འགྱུར་བ་ལྟ་ན་གནས་མལ་སྐྱབས་ཡོད་པའམ་གབ་མེད་པ་ན་འདུག་ཀྱང་རུང་སྟེ།",
    "འདུག་སྟེའོ།",
    "དེའི་ཚད་ཅི་ཙམ་ཞེ་ན་འདུག་པ་དེ་ནི་རྐུབ་ཚོས་ཙམ་ས་ལ་བཞག་པའོ།",
    "འདུག་པ་ལའོ་ཞེས་སྔར་སྨོས་པ་ལས་འདིར་ཁྱད་པར་ནི་དགེ་སློང་དང་དགེ་སློང་མ་གཉིས་ཀ་འགྲེང་བ་ལའོ།",
    "དགེ་སློང་དེའི་ཉེ་དུས་བརྩིག་ཏུ་བཅུག་པའི་འདུག་གནས་ཉེ་དུ་བདག་པོ་ཡིན་པ་དེར་ཞག་གཅིག་ལས་ལྷག་པར་གནས་ཤིང་བསོད་སྙོམས་གཅིག་ལས་ལྷག་པར་ཟོས་ན་ཡང་ཉེས་བྱས་སོ།",
    "སྟན་གང་ལ་འདུག་པ་དེ་ལས་ལངས་པའོ།",
    "སྟན་གང་ལ་འདུག་པ་དེ་ལས་ཡངས་པའོ།",
    "འཚེད་པར་བྱེད་པའི་གང་ཟག་དང་བཙོ་བར་བྱ་བའི་རྫས་གཉིས་ཀ་མཚམས་ནང་ན་འདུག་པ་ཁོ་ནར་མ་ཟད་དོ།",
    "བཙོ་བར་བྱ་བའི་རྫས་དེ་མཚམས་ཀྱི་ཕྱི་རོལ་ཏུ་འདུག་པ་བཙོས་ན་འཚེད་པར་བྱེད་པའི་མི་དེ་མཚམས་ཀྱི་ནང་དེ་ན་འདུག་པ་ཉིད་ཀྱིས་ནི་རྫས་དེ་མཚམས་༤སྨ་ན་ཆ་རྒྱུད་པ་རྩ་ན་ན་ནཔ་མལ་བྷཱཙ་ཨ་ཏི་ས་ཁམས་བས་རྒྱུ་པནམབས་།",
