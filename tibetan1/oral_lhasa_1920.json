    "དེ་ལྟ་བུ་ནི་དངོས་པོར་སྒྲོ་འདོགས་པར་ལྟ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་བུ་ནི་དངོས་པོ་མེད་པར་ལྟ་བའོ།",
    "དེ་ཤེས་ནས་ཡོངས་སུ་གྲུབ་པའི་ངོ་བོ་ཉིད་ལ་དངོས་པོ་དང་དངོས་པོ་མེད་པར་ལྟ་བ་མི་འབྱུང་ངོ་ཞེའོ།",
    "དངོས་པོའི་ངོ་བོར་སྒྲོ་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "དེ་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ལས་རྣམ་པར་གྲོལ་བ་གཉིས་སུ་མེད་པའི་རང་བཞིན་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་དུ་ཡང་མེད་དོ་ཞེ་ན།",
    "དངོས་པོ་མེད་པར་སྐུར་པ་འདེབས་པའི་མཐར་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "གལ་ཏེ་དེ་ལ་དངོས་པོ་ཉིད་དུ་འཛིན་ན་དེ་ལྟ་ན་ནི་དངོས་པོར་སྒྲོ་འདོགས་པར་འགྱུར་རོ།",
    "ཇི་སྟེ་དངོས་པོ་མེད་པ་ཉིད་དུ་འཛིན་ན་དེ་ལྟ་ན་ནི་སྐུར་པ་འདེབས་པར་འགྱུར་རོ།",
    "གལ་ཏེ་དེ་ལ་ཆད་པ་ཉིད་དུ་ན་དེ་ལྟ་ན་ནི་དངོས་པོ་མེད་པའང་ཤིན་ཏུ་མེད་པ་ཉིད་པས་སྒྲོ་འདོགས་པར་འགྱུར་རོ།",
    "ཇི་སྟེ་གཉིས་པོ་ཉིད་དུ་འཛིན་ན་དེ་ལྟ་ན་ནི་སྐུར་པར་འགྱུར་ཏེ།",
    "ཡང་ན་གལ་ཏེ་དངོས་པོའི་ངོ་བོར་འཛིན་ན་དེ་ལྟ་ན་ནི་སྒྲོ་བཏགས་པར་འགྱུར་རོ།",
    "རྣམ་པར་བྱང་བ་ལ་ཡང་སྐུར་པར་འགྱུར་ཏེ།",
    "མི་རྟག་པ་དང་སྡུག་བསྔལ་བ་དང་སྟོང་པ་དང་བདག་མེད་པ་ནི་རྟག་པ་དང་བདེ་བ་དང་གཙང་བ་དང་བདག་ཏུ་ཕྱིན་ཅི་ལོག་པའི་གཉེན་པོ་ཡིན་པས་ཕྱིན་ཅི་མ་ལོག་པའི་དེ་ཁོ་ན་ཞེས་བྱའོ།",
    "རྩ་བའི་དེ་ཁོ་ནའི་ནང་དུ་ཕྱིན་ཅི་མ་ལོག་པའི་དེ་ཁོ་ན་འདུས་པར་བསྟན་པའི་ཕྱིར།",
    "ཞེས་རྒྱ་ཆེར་གསུངས་སོ།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "རང་བཞིན་གྱིས་ནི་སྟོང་པར་འདོད།",
    "ཇི་ལྟར་དག་པ་འཇིག་རྟེན་པའི་ཡེ་ཤེས་ཀྱིས་རྟོག་པར་འགྱུར་བ་ལྟ་བུ་ཡང་ཡེ་མེད་པ་ནི་མ་ཡིན་ཏེ།",
    "རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ནི་ཡོངས་སུ་གྲུབ་༦༣ ༥དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "རྣམ་པ་གཞན་གྱིས་ནི་མ་ཡིན་པར་སྟོན་ཏོ།",
    "དེ་ལྟར་ན་ཀུན་བརྟགས་པའི་བདག་ཉིད་ཀྱིས་དེའི་བདག་མེད་པར་བསྟན་པ་ཡིན་ནོ།",
    "སྟོང་པ་ཉིད་དང་བདག་མེད་པ་འདི་གཉིས་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "ཌའདི་གཉིས་ཀྱི་ཁྱད་པར་ནི་འདི་ཡིན་ནོ་ཞེའོ་ལ།",
    "རྣམ་པར་བྱང་བའི་ཕྱོགས་ལ་ཡང་འགོག་པའི་བདེན་པ་ནི་འབྲས་བུའི་དེ་ཁོ་ནའོ།",
    "ཇི་ལྟར་རྩ་བའི་དེ་ཁོ་ན་རྣམ་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "དེའི་ཕྱིར་སྡུག་བསྔལ་བདེན་པར་འདོད་ཅེས་བྱ་བ་སྨོས་ཏེ།",
    "དེ་བཞིན་ཉིད་དུ་༧སྤྱོད་ཡུལ་པ་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཀྱིས་ཀུན་བརྟགས་པའི་དྲི་མ་མི་སྐྱེ་བའི་བདག་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "འགོག་པ་རྣམ་པ་འདི་གསུམ་ནི་བརྟགས་པ་ལ་སོགས་པ་རྩ་བའི་དེ་ཁོ་ནར་གོ་རིམས་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཡོངས་སུ་ཤེས་པར་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཀུན་བརྟགས་པ་ནི་ཡོངས་སུ་ཤེས་པར་བྱ་བའོ་ཞེས་བྱ་བ་ལ།་",
    "ཀུན་བརྟགས་པ་ནི་གཏན་མེད་པ་ཉིད་པས་དེ་ནི་ཡོངས་སུ་ཤེས་པར་བྱ་བར་ཟད་ཀྱི་སྤང་དུ་མེད་དེ་མེད་པ་ནི་སྤང་བར་མི་རུང་ངོ།",
    "བརྟགས་པ་བཞིན་དུ་ཐམས་ཅད་ཀྱི་བདག་ཉིད་ཀྱིས་མེད་པར་ནི་མ་ཡིན་ནོ།",
    "ཡོངས་སུ་གྲུབ་པ་ནི་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་ཐོབ་པར་མངོན་སུམ་དུ་བྱ་བའོ་ཞེས་བྱ་བ་ལ།",
    "ཡོངས་སུ་གྲུབ་པ་ནི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་ལས་རྣམ་པར་གྲོལ་བའི་མཚན་ཉིད་དང་གནས་གྱུར་པ་ཉིད་དུ་ཡོངས་སུ་ཤེས་པར་བྱ་ཞིང་།",
    "འགོག་པ་ནི་ཐོབ་པར་མངོན་སུམ་དུ་བྱས་པས་མངོན་སུམ་དུ་བྱ་བའོ།",
    "དེ་ལ་དངོས་པོ་དང་གསུམ་པ་ནི་ཤེས་པའི་ཡོངས་སུ་ཤེས་པས་ཡོངས་སུ་ཤེས་པར་བྱ་བའོ།",
    "གཉིས་པ་ནི་གཉིས་ཀས་ཡོངས་སུ་ཤེས་པར་བྱའོ།་།",
    "ཤེས་པར་མངོན་སུམ་དུ་བྱ་བ་དང་།",
    "ཐོབ་པར་མངོན་སུམ་དུ་བྱའོ།",
    "དེ་ལ་ཤེས་པར་མངོན་སུམ་དུ་བྱ་བས་ནི་གསུམ་ཆར་ཡང་མངོན་སུམ་དུ་བྱའོ།",
    "ཐོབ་པར་མངོན་སུམ་དུ་བྱ་བས་ནི་གསུམ་པ་ཉིད་དོ་ཞེའོ།",
    "དེ་ལྟར་རྩ་བའི་དེ་ཁོ་ན་འདིར་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "མངོན་སུམ་དུ་བྱ་བ་རྣམས་ཀྱིས་ལམ་གྱི་བདེན་པ་རྣམ་པར་གཞག་པར་རིག་པར་བྱའི།",
    "དེའི་ཁོངས་སུ་གཏོགས་པར་བསྡུ་བ་ནི་མ་ཡིན་ནོ།",
    "ཁོ་འདི་ལྟར་དང་པོར་རགས་པས་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ཡོངས་སུ་སྨིན་པར་གྱུར་ནས་ཕྲ་བས་རྣམ་པར་གྲོལ་བར་བྱེད་དེ།",
    "ཚིག་ལེའུར་བྱས་པ་དང་མཐུན་པར་བྱ་བའི་ཕྱིར་བཟློག་སྟེ་གསུངས་སོ།",
    "དེ་ལ་མཉམ་པར་མ་བཞག་པའི་ཤེས་པའི་ཡུལ་ཡིན་པས་ཀུན་རྫོབ་ཀྱི་བདེན་པ་ནི་རགས་པའི་དེ་ཁོ་ནའོ།",
    "མཉམ་པར་བཞག་པའི་ཤེས་པའི་ཡུལ་ཡིན་པས་དོན་དམ་པའི་བདེན་པ་ནི་ཕྲ་བའི་དེ་ཁོ་ནའོ།",
    "ཡང་ན་རྣམ་པར་ཤེས་པའི་ཡུལ་ཡིན་པས་ན་རགས་པའོ།",
    "དེའི་ཕྱིར་དེ་རྩ་བའི་དེ་ཁོ་ནར་ཇི་ལྟར་རིག་པར་བྱ་ཞེ་ན་ཞེས་དྲིས་ཏེ་དེའི་ཕྱིར།་",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
    "བརྟགས་པ་དང་ཤེས་པ་དང་བརྗོད་པ་རྣམས་ནི་རགས་པའི་དེ་ཁོ་ནར་རིག་པར་བྱའོ།",
    "དེ་ཉིད་བསྟན་པར་བྱ་བའི་ཕྱིར་ཀུན་རྫོབ་ནི་རྣམ་པ་གསུམ་སྟེ་ཞེས་རྒྱ་ཆེར་སྨོས་སོ།",
    "དོན་མེད་པ་ལ་གཟུགས་དང་བུམ་པ་དང་སྣམ་བུ་ཞེས་བྱ་བར་རྣམ་པར་གཞག་པ་ནི་བརྟགས་པའི་ཀུན་རྫོབ་བོ།",
    "ཡོངས་སུ་གྲུབ་པ་ནི་རྣམ་པར་རྟོག་པ་དང་བརྗོད་པ་ལས་འདས་ཀྱང་སྟོང་པ་ཉིད་དང་།",
    "རྩ་བའི་དེ་ཁོ་ནར་གོ་རིམས་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དོན་མེད་པར་བརྗོད་པ་ཙམ་གྱིས་ཐ་སྙད་དུ་བྱ་བ་ནི་བཏགས་༧པའི་ཀུན་རྫོབ་བོ།་།",
    "དེ་ལ་བརྟགས་པ་དང་བརྗོད་པའི་ཀུན་རྫོབ་གཉིས་ནི་སྐབས་སུ་བསྡུས་ནས་རྣམ་པར་གཞག་པར་རིག་པར་བྱའི།",
    "ད་ནི་དོན་དམ་པའི་བདེན་པ་བརྗོད་པར་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
    "གཉིས་ནི་དོན་དམ་པར་མི་སྲིད་པའི་ཕྱིར་དོན་དམ་པའི་བདེན་པ་ནི་ཡོངས་སུ་གྲུབ་པའི་ངོ་བོ་ཉིད་གཅིག་པུར་རིག་པར་བྱའོ།",
    "ཅེས་བྱ་བ་གསུངས་སོ།",
    "ཐོབ་པར་བྱ་བ་དོན་དམ་པ་དང་།",
    "ཡེ་ཤེས་དང་ཐ་མི་དད་པའི་ཕྱིར་དེའི་ཚེ་དམིགས་པར་འགྱུར་བ་ནི་མ་ཡིན་གྱི།",
    "རྣམ་པར་རིག་པ་ཙམ་སྣང་བ་བཞིན་ཏེ།",
    "དཔེར་ན་གང་དག་རྣམ་པར་རིག་པ་ཙམ་དུ་བཟོད་པ་དེ་དག་ཅིགཟུགས་ལ་སོགས་པ་རྣམ་པར་རིག་པ་ཙམ་མ་གཏོགས་པར་གཟུགས་ལ་སོགས་པར་སྣང་བ་ནི་མེད་པ་ལྟ་བུའོ།",
    "ཐོབ་པར་བྱ་བ་དོན་དམ་པ་ནི་མྱ་ངན་ལས་འདས་པ་སྟེ།",
    "དེ་འདུས་བྱས་དང་འདུས་མ་བྱས་དོན་ཏོ།",
    "འདི་ལྟར་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་བྱ་བ་ནི་ལམ་གྱི་དགོས་པ་སྟེ།",
    "ཇི་ལྟར་ན་གཅིག་ལ་གཅིག་བརྟེན་པར་མི་འགྱུར།",
    "གཅིག་ལ་གཅིག་བརྟེན་པར་གྱུར་ན་ཅི་ཉེས་ཤེ་ན།་",
    "གཏན་ལ་བབ་པ་མེད་པར་འགྱུར་རོ།",
    "ཎལམ་ལ་ནི་སྔ་མ་དང་ཕྱི་མའི་ཆ་མེད་པ་མ་ཡིན་པས་ཡོངས་སུ་གྲུབ་པར་མི་རུང་སྟེ།་",
    "ཡོངས་སུ་མ་གྲུབ་པས་ཀྱང་དོན་དམ་པ་པའི་བདེན་པར་བསྡུར་མི་རུང་ན་འདུས་མ་བྱས་དང་འདུས་བྱས་ཡོངས་སུ་གྲུབ་པའི་ངོ་བོ་ཉིད་དུ་ཇི་སྐད་བརྗོད་ཅེ་ན།",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
    "ལམ་ཞེས་བྱ་བ་འདུས་བྱས་གཉིས་ཡོངས་སུ་གྲུབ་པའི་ངོ་བོ་ཉིད་དོ་ཞེས་ཇི་སྐད་དུ་བྱ་ཞེ་ན།",
    "ོགཉིས་པོ་མེད་པ་ཉིད་ཡོངས་སུ་གྲུབ་པ་ཞེས་དེ་ལས་གཞན་དགག་པར་མི་བྱེད་དེ།",
    "སྐྱེ་ཕྱིན་ཅི་མ་ལོག་པར་ཡོངས་སུ་གྲུབ་པ་གཉིས་ཀྱང་ཡོངས་སུ་གྲུབ་པ་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "འདུས་མ་བྱས་ནི་མྱ་ངན་ལས་འདས་པ་དང་དེ་བཞིན་ཉིད་དེ།",
    "འདུས་མ་བྱས་ནི་གཞན་དུ་འགྱུར་བ་མེད་པའི་ཕྱིར་འགྱུར་བ་མེད་པར་ཡོངས་སུ་འགྲུབ་པས་ཡོངས་སུ་གྲུབ་པའོ།",
    "འདུས་བྱས་ནི་ལམ་གྱིས་བསྡུས་པ་ལ་བྱའི་གཞན་ལ་མ་ཡིན་ཏེ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་ཡོངས་སུ་གྲུབ་པས་ཡོངས་སུ་གྲུབ་པ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་བས་ན་བསམ་པ་ཐ་དད་པའི་ཕྱིར་འདུས་བྱས་དང་འདུས་མ་བྱས་གཉི་ག་ཡང་ཡོངས་སུ་གྲུབ་པ་ཡིན་པས་འགལ་བ་མེད་དོ།",
    "བརྡ་ནི་མིང་དང་མིང་ཅན་འབྲེལ་པར་ཤེས་པའོ།",
    "དེ་མི་ཤེས་པ་ཐམས་ཅད་ཀྱིས་ཐ་སྙད་དུ་བཏགས་པའི་དངོས་པོ་གང་ལ་ལ་འདི་ནི་ས་ཡིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པར་ལྟ་བ་མཐུན་པ་ཡིན་ནོ་ཞེས་བསྟན་པར་འགྱུར་རོ།་",
    "ཝིཏི་༡༣༩ཞེས་བྱ་བས་ན་དེའི་ཕྱིར་ངོ་བོ་ཉིད་གསུམ་གྱིས་རིགས་པའི་གྲགས་པའི་དེ་ཁོ་ནར་རྣམ་པར་གཞག་གོ།",
    "དཔྱོད་པ་ཅན་དག་ནི་བདག་དང་གཞན་གྱི་བསྟན་བཅོས་ལ་མཁས་པར་གྱུར་པ་དང་།",
    "བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་པ་མྱོང་བའི་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ཚུལ་གསུམ་པའི་རྟགས་ཀྱི་རྗེས་སུ་དཔག་པར་བྱ་བའི་དོན་ལ་ཤེས་པ་ནི་རྗེས་སུ་དཔག་པའོ།",
    "འཐད་པ་ནི་བསྒྲུབ་པར་བྱ་བ་རྟོགས་པར་བྱེད་པའི་ཐབས་ཡིན་པས་ཚུལ་གསུམ་པའི་རྟགས་སོ།",
    "དེས་རྟོགས་པར་བྱ་བའི་ཕྱིར་ཚུལ་གསུམ་པའི་རྟགས་བརྗོད་པའོ།",
    "འཐད་པ་སྒྲུབ་པའི་རིགས་པའོ་ཞེས་ཚིག་རྣམ་པར་སྦྱར་བའོ།",
    "ཡང་ན་འཐད་པ་ཉིད་སྒྲུབ་པའི་རིགས་པ་ཡིན་པར་ཚིག་རྣམ་པར་སྦྱར་བར་བྱའོ།",
    "རྣམ་པར་དག་པའི་སྤྱོད་ཡུལ་གྱི་དེ་ཁོ་ན་རྣམ་པ་གཉིས་ཏེ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེ་བཞིན་དུ་ཤེས་བྱའི་སྒྲིབ་པ་རྣམ་པར་དག་པའི་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "ཤེས་པར་བྱ་བ་ནི་ཤེས་བྱ་སྟེ།",
    "དེ་༦༤༩དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།"
