    "མཐར་འཛིན་པར་ལྟ་བ་ིགཉིས་ཀྱིས་དེ་ལ་སྐྲག་པ་དང་།",
    "ལོག་པར་ལྟ་བས་དེ་ལ་སྐུར་པ་འདེབས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "ལོག་པར་ལྟ་བས་ཀྱང་འགོག་པ་མེད་དོ་ཞེས་སྐུར་པ་འདེབས་སོ།",
    "ལོག་པར་ལྟ་བས་འགོག་པར་ཡོངས་སུ་མི་ཤེས་ཏེ་དེ་ལྟར་ལྟ་བའི་ཀུན་དུ་སྦྱོར་བ་ནི་འགོག་པ་ཡོངས་སུ་ཤེས་པ་ལ་སྒྲིབ་པོ།",
    "ལྟ་བ་དང་ལྟ་བའི་གནས་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་རྣམས་ལ་མཆོག་ལ་སོགས་པར་ལྟ་བ་གང་ཡིན་པའོ།",
    "ལམ་ཡོངས་སུ་ཤེས་པ་ཡང་ངེས་པར་འབྱིན་པ་ལ་སོགས་པའི་རྣམ་པ་རྣམས་སུ་ཤེས་པའོ།",
    "དེའི་ཕྱིར་རྣམ་པ་གཞན་གྱིས་དག་པར་མཆོག་ཏུ་འཛིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "གྲངས་ཅན་ལ་སོགས་པའི་ཤེས་པས་དག་པར་མཆོག་ཏུ་འཛིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་མཆོག་ཏུ་འཛིན་པའི་ཀུན་དུ་སྦྱོར་བས་ལམ་བོར་ཏེ་རྣམ་པ་གཞན་གྱིས་དག་པར་མཆོག་ཏུ་འཛིན་ཏོ།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "དེ་ཁོང་དུ་ཆུད་པར་བྱེད་པར་ཡོངས་སུ་ཤེས་པའོ།",
    "བླ་ན་མེད་པའི་སྦྱིན་གནས་ཀྱི་ཞིང་ཡིན་པར་ཡོངས་སུ་ཤེས་པའོ།",
    "གནོད་པ་སྣ་ཚོགས་ཀྱི་ིརྩ་བར་གྱུར་པར་མི་ཤེས་པས།",
    "ཇི་ལྟ་ཞེ་ན་དེའི་ཕྱིར་ཡོ་བྱད་ལ་ལྷག་པར་ཞེན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "སེར་སྣ་ནི་ཡོ་བྱད་རྣམས་ལ་ལྷག་པར་ཆགས་པ་སྟེ།",
    "ཡོ་བྱད་བསྙུངས་པ་ནི་ཡོ་བྱད་རྣམས་ལས་ལྷག་པར་དབེན་པའོ།",
    "སེར་སྣ་ནི་༤ཡོ་བྱད་རྣམས་ལ་ལྷག་པར་ཆགས་པས།",
    "དེ་ལ་རྗེས་སུ་ཆགས་པ་དང་ཁོང་ཁྲོ་བའི་ཀུན་དུ་སྦྱོར་ཡིབ་ནི་དེ་ཁོ་ན་རྟོགས་པར་བྱེད་པར་སྦྱོར་བ་ན་སྒྲིབ་ཀྱི་། ལྷག་མ་རྣམས་ནི་མ་ཡིན་ནོ།",
    "ལྷག་མ་རྣམས་ནི་དེ་ཁོ་ན་རྟོགས་པར་བྱེད་པར་ཞུགས་པར་བྱེད་པ་ལ་སྒྲིབ་བོ།",
    "དེ་ནས་ཐམས་ཅད་ལ་བཏང་སྙོམས་སུ་བྱའོ་། དེ་ནས་གནོད་པ་ཐམས་ཅད་ཀྱི་རྩ་བ་ཡིན་པས་འཇིག་ཚོགས་ལ་ལྟ་བ་ཡོངས་སུ་ཤེས་པར་བྱའོ།",
    "དེ་ནས་དེ་འགོག་པ་ཤེས་པར་བྱའོ།",
    "དེའི་འོག་ཏུ་ཐོབ་པའི་ལམ་ཤེས་པར་བྱའོ།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "འདིར་གཞི་སོ་སོར་ངེས་པར་བྱ་བ་ནི་མ་ཡིན་གྱི།",
    "སོ་སོར་ཉེ་བར་གནས་པའི་ཕྱིར་གཙོ་བོར་བྱས་ཏེ་འདི་བསྟན་ཏོ།",
    "ཞེས་གསུངས་པ་ལ་སོགས་པ་ནི་སྒྲིབ་པའོ།",
    "རང་བཞིན་མི་ཤེས་ནས་དེའི་ཕྱིར་དེ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར་རྩོམ་སྟེ།",
    "ཝིཏི་༡༣༩་ལ་སྒྲིབ་པ་དང་རྟེན་ལ་སོགས་པ་ལ་སྒྲིབ་པ་ནི་ཡང་དག་པར་འཛིན་པ་ལ་སོགས་པ་རྣམས་ཀྱི་སྒྲིབ་པ་སྟེ་ཐ་དད་དོ།",
    "ཐོབ་པར་བྱ་བ་ཡིན་པས་དེའི་ཕྱིར།",
    "ཐོབ་པར་བྱ་བ་ལ་སྒྲིབ་པ་རྣམ་པར་གཞག་སྟེ།",
    "ཆུབ་ཐོབ་པར་བྱའོ།",
    "དེ་ནས་སེམས་བསྐྱེད་པ་དང་མཐུན་པར་སྦྱིན་པ་ལ་སོགས་པ་བསྒྲུབ་པར་བྱ་སྟེ།",
    "དེ་ནས་བསྐལ་པ་གྲངས་མེད་པར་གོམས་པར་བྱས་ཏེ།",
    "སངས་༥ ར་༥དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ཞེས་བྱ་བ་གསུངས་སོ།",
    "རྒྱུན་དུ་མ་ཆུད་པའམ་གུས་པར་མི་སྦྱོར་བ་སྟེ།",
    "དེ་ལ་སྒྲིབ་པར་མི་འཐད་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་བདག་དང་གཞན་ལ་ཕན་པར་བྱེད་པའི་བསམ་པ་སྟེ།",
    "རྣམ་པར་གྲོལ་བའི་ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་ཤེས་རབ་ཡོངས་སུ་མ་སྨིན་པའོ་ཞེས་བྱ་བ་ནི།",
    "རྣམ་པར་གྲོལ་བ་ཐོབ་པར་བྱེད་པའི་ཤེས་རབ་ལས་སུ་མི་རུང་བའོ།",
    "འདིར་རྣམ་པར་གྲོལ་བ་ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་ཤེས་རབ་པོ།",
    "ཝིཏི་༡༣༩ནི་ཡུལ་ལ་རྣམ་པར་ཆགས་པ་དང་།",
    "དེ་དག་ལ་རྣམ་པར་ཆགས་པ་ནི་ཆགས་པའོ།",
    "བདག་ལྟ་བུས་ག་ལ་ཞིག་ཅེས་བདག་ལ་མི་སྲིད་པར་སེམས་སོ།",
    "གཟོད་མ་ནས་ཞི་བ་ལ་སོགས་པའི་དོན་ལ་སྒྲ་ཇི་བཞིན་ཁོ་ནར་རྟོག་པར་བྱེད་ཅིང་དགོངས་པའི་དོན་གྱི་དེ་ཁོ་ན་ཁོང་དུ་མི་ཆུད་པ་སྟེ།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ཐོས་པས་ཕོངས་པར་མ་གྱུར་ན་ཡང་ཐོས་པ་ཉུང་སྟེ།",
    "མང་དུ་ཐོས་པར་གྱུར་ཀྱང་ཏིང་ངེ་འཛིན་ཡོངས་སུ་སྦྱོང་ཅིབ་མ་བྱས་པ་ཉིད་ཀྱང་སྒྲིབ་པོ་ཞེས་སྦྱར་རོ།",
    "སྦྱོར་བ་ལ་སོགས་པ་ནས་ཏིང་ངེ་འཛིན་ཡོངས་སུ་སྦྱང་བ་བྱས་པ་ལ་ཐུག་པ་རྣམས་ནི་བྱེད་རྒྱུ་བཅུར་འགྱུར་རོ།",
    "འདིར་ནི་སོ་སོ་ཐ་དད་ཀྱང་སྐྱེ་བ་ལ་སོགས་པའི་རྒྱུ་ཉིད་དུ་ཁྱད་པར་མེད་པའི་ཕྱིར་བྱེ་བྲག་མེད་པར་ིབསྟན་ཏོ།",
    "དེའི་ཕྱིར་དེ་བསྐྱེད་པར་བྱ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "གཞན་དུ་མི་འགྱུར་བ་དང་རྣམ་པར་མི་ལྡོག་པའོ།",
    "གནས་པ་ནི་སྐྱེ་བ་མེད་པར་མི་འགྱུར་བས་འདིར་ཡང་སྐྱེ་བ་ཡོད་པར་འགྱུར་རོ།",
    "དེ་མ་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "དེ་བཞིན་ཉིད་ངོ་བོ་ཉིད་ཀྱིས་རྣམ་པར་དག་པས་སྐྱེ་བ་མེད་དེ།",
    "སྔར་སྐྱེས་པ་རྣམས་ིགནས་པར་བྱེད་པ་ཉིད་དོ།",
    "རབ་ཏུ་བསྟན་པར་བྱ་བའི་ཕྱིར་རོ།",
    "ཝའི་༡༣༩སྐྱེ་བོ་གནོད་པར་མི་སེམས་པ་དང་འགྲོགས་པའོ།",
    "དེ་བསྟན་པར་བྱ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "འབྲས་ལ་སོགས་པར་འགྱུར་རོ་ཞེས་བྱ་བ་དེའི་བྱེད་རྒྱུ་ནི་མེ་ལ་སོགས་པའོ།",
    "དེ་ཡང་འབྲལ་བའི་བྱེད་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "དེའི་ཕྱིར་བསྒྱུར་བ་ནི་བྱེད་རྒྱུའི་གེགས་ནི་བསྔོ་བའི་སྒྲིབ་པར་བལྟ་བར་བྱའོ།",
    "ཡིད་ཆེས་པར་བྱེད་པའི་བྱེད་རྒྱུ་ནི།",
    "ཡིད་ཆེས་པར་བྱེད་པའི་རྒྱུ་དང་འགལ་བས་ཡིད་ཆེས་པར་བྱེད་པ་ལ་སྒྲིབ་པ་ནི།",
    "སེར་སྣ་མེད་པ་ལ་སྒྲིབ་པར་རྣམ་པར་གཞག་སྟེ།",
    "ཡིད་ཆེས་པར་བྱེད་པ་ལ་སྒྲིབ་པས་ནི་སེར་སྣ་མེད་པ་ལ་སྒྲིབ་པའོ།",
    "དེ་ལྟར་རབ་ཏུ་སྦྱོར་བ་ན་ཕྱིན་ཅི་ལོག་སྤོང་ཞིང་ཕྱིན་ཅི་ལོག་མེད་པའི་ཡེ་ཤེས་ཀྱང་སྐྱེད་པར་བྱེད་དེ།",
    "མི་སྐྲག་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "རྣམ་པར་ཤེས་པ་ནི་ཡུལ་ལས་སོ་སོར་རྣམ་པར་རིག་པའོ།",
    "ཡང་ན་ལུས་ལ་སོགས་པ་ལ་མི་གཙང་བ་དང་།",
    "བདག་མེད་པའི་རྣམ་པར་མ་རྟོགས་པའམ།",
    "གཙང་བ་དང་བདེ་བ་དང་རྟག་པ་དང་།",
    "ལེ་ལོ་ནི་ཡང་དག་པར་སྤོང་བ་རྣམས་ལ་སྒྲིབ་བོ།",
    "སྐྱེད་པའི་ཕྱིར་འཇུག་པ་ནི་ཡང་དག་པར་སྤོང་བ་ཞེས་བྱ་བའི་མིང་འཐོབ་བོ།",
    "སེམས་དང་དཔྱོད་པའི་ཏིང་ངེ་འཛིན་རྣམས་ཀྱང་བརྗོད་པར་བྱའོ།",
    "དེ་དག་ནི་དད་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་རྣམ་པ་གཉིས་པོ་འདི་ནི་མི་མཐུན་པའི་ཕྱོགས་མ་དད་པ་ལ་སོགས་པས་ཟིལ་གྱིས་ནོན་པའི་ཕྱིར་ཉམ་ཆུང་བ་སྟེ།",
    "མཐོང་བའི་ལམ་དུ་རྣམ་པར་གཞག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལ་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "སྒྲིབ་པ་ཡིན་དུ་ཟིན་ཀྱང་འདིར་གཙོ་བོར་བརྗོད་པར་བཞེད་པས་ལྟ་བའི་སྐྱོན་སྨོས་པའི་ཕྱིར་དེ་དག་མ་སྨོས་ཀྱང་འགལ་བ་མེད་དོ།",
    "ལྟ་བ་ལ་སོགས་པ་དེ་རྣམས་ཀྱི་ས་བོན་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་གནས་པ་ཉིད་མཐོང་བའི་ལམ་གྱིས་སྤོང་བའི་ཕྱིར་དེའི་སྒྲིབ་པ་ཞེས་བྱའོ།",
    "གནས་ངན་ལེན་གྱི་ཉེས་པ་ནི་ལམ་གྱི་ཡན་ལག་ཡང་དག་པར་ལྟ་བ་དང་།",
    "དེའི་ནུས་པ་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལ་གནས་པ་ནི་གནས་ངན་ལེན་ཏོ།",
    "འདི་ལ་སེར་སྣ་ལ་སོགས་པ་སྦྱིན་པ་ལ་སོགས་པ་ལ་དངོས་སུ་གེགས་བྱེད་པ་བཞིན་དུ་ཅིའི་ཕྱིར་དེའི་འབྲས་བུ་ལ་སྒྲུབ་པར་བརྗོད་ལ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་ལ་སྒྲིབ་པར་ནི་མ་ཡིན་ནོ།",
    "སྟོབས་ཀྱི་ཕ་རོལ་ཏུ་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "མཛེས་པར་འགྲོ་བ་ནི་བདེ་འགྲོ་སྟེ་མི་དང་ལྷའོ།",
    "རྫུ་འཕྲུལ་གྱིས་བསྒྲིབ་མི་དགོས་པར་བསྟན་པ་རྟོགས་པར་བྱེད་དོ།",
    "དེའི་ཕྱིར་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་འབྲས་བུ་ནི་རྣམ་པར་གྲོལ་བར་བྱེད་པའོ།",
    "སྦྱིན་པ་ལ་སོགས་པ་དེ་ཡང་ཇི་ལྟར་མི་ཟད་པར་འགྱུར་ཞེ་ན།",
    "སོ་སོར་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "དེ་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་འཇིག་རྟེན་ལས་འདས་པ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཏེ།",
    "ཡེ་ཤེས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མཆོག་ཡིན་ན་ཇི་ལྟར་རྣམ་པར་མི་རྟོག་པ་མ་ཡིན་ཞེ་ན།",
    "གཞན་དག་ཀྱང་ཡོངས་སུ་སྨིན་པར་བྱད་པ་ཡིན་ཏེ།",
    "འདི་གཉི་ག་ཡང་རྣམ་པར་མི་རྟོག་པ་ལ་མེད་པས་དེའི་ཕྱིར་ཡེ་ཤེས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནི་རྣམ་པར་མི་རྟོག་པ་མ་ཡིན་ནོ།་།",
    "འོད་བྱེད་པ་ལ་ནི་ཚེ་རབས་གཞན་དུ་ཡང་༦༡༡དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ས་ལྷག་མ་རྣམས་ལ་ནི་བསླབ་པ་དེ་དག་ཉིད་ཀྱི་འབྲས་བུ་རྣམ་པ་བཞིར་རིག་པར་བྱའོ།",
    "མི་གཡོ་བ་ལ་ནི་ལྷུན་གྱིས་གྲུབ་པར་མཚན་མ་མེད་པའི་ཡེ་ཤེས་ལ་གནས་པ་ཞིང་རྣམ་པར་དག་པ་དང་ལྷན་ཅིག་སྒྲུབ་བོ།",
    "གཟུངས་ཀྱི་ཡོན་ཏན་གྱི་ཁྱད་པར་སྒྲུབ་པོ།་།",
    "ཤེས་རབ་ལ་སོགས་པའི་གནས་སྐབས་ཀྱི་ཁྱད་པར་གྱི་བདག་ཉིད་དེ།",
    "འདི་ལྟར་ཀུན་དུ་འགྲོ་བའི་དོན་ཁོང་དུ་ཆུད་པར་བྱེད་པ་མཐོང་བའི་ལམ་གྱི་བདེན་པ་རྣམས་ལ་ལོག་པར་རྟོག་པའི་བག་ལ་ཉལ་བ་ཐམས་ཅད་སྤོང་བའི་ཕྱིར་རོ།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "འདི་ལྟར་ཉན་ཐོས་དག་ལ་ས་རྣམས་ལ་མི་ཤེས་པ་ཡོད་བཞིན་དུ་རྣམ་པར་འགྲོལ་ལོ།",
    "དེའི་ཕྱིར་དེ་ལ་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྷག་པར་ཆེ་བ་ཡིན་ཏེ།",
    "དེ་གསུམ་ནི་ས་གཞན་དག་ཏུ་ཡང་ཤེས་པར་བྱའོ།",
    "ཁྱད་པར་དུ་འཕགས་པའི་དོན་ལ་སྨོན་པས་བདག་ཤིན་ཏུ་རྣམ་པར་དག་པའི་སྣོད་དུ་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་ས་དེ་ལ་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྷག་པར་ཆེ་བ་ཡིན་ཏེ།",
    "དེ་བས་ན་ས་དེ་ལ་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྷག་པར་ཆེ་བ་ཡིན་ཏེ།་",
    "ལྟ་བ་དང་ཐེ་ཚོམ་དང་ཡིད་གཉིས་དང་འགྱོད་པ་སེལ་བས་རྣམ་པར་དག་པ་ལ་བསམ་པ་མཉམ་པ་ཉིད་དང་།",
    "ལམ་དང་ལམ་མ་ཡིན་པ་ཤེས་པ་རྣམ་པར་དག་པ་ལ་བསམ་པ་མཉམ་པ་ཉིད་དང་།",
    "ལམ་ཤེས་པ་རྣམ་པར་དག་པ་ལ་བསམ་པ་མཉམ་པ་ཉིད་དང་།",
