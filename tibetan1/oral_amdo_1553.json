    "རྒྱང་རིང་གི་རྩྭ་ཐང་ནས་ཀ་མད་སུམ་ཅུའི་དབྱངས་རྟ་བར་མེད་གྲགས་འོང་།",
    "ཁྱོད་ཀྱིས་ཕ་མའི་བཙན་ཚུགས་ཀྱི་གཤིས་ཀ་ལ་མ་བཟོད་པར།",
    "བློ་སྤོབས་ཆེན་པོས་རང་ཉིད་ཀྱི་ཕུགས་འདུན་དང་རྨི་ལམ་མངོན་འགྱུར་ཐུབ་ཆེད་དཔའ་མི་ཞུམ་པར་རང་ཚུགས་བརྟན་པོས་མདུན་དུ་སྐྱོད་པ་དེ་ནི་ངོ་མ་ཡང་དག་པའི་མི་ཚེའི་གདམ་ཁ་ཞིག་རེད་ཅེས་བརྗོད་དེ་ཁོ་ལ་བསྟོད་པའི་མེ་ཏོག་ཡང་ཡང་གཏོར་ཞིང་།",
    "རེ་སྒུག་ཁྲོད་ཀྱི་ལོ་ཟླ།",
    "ཁང་མིག་གཅིག་ལས་མེད་པའི་མལ་ཤག་ཁང་དེའི་ནང་ཁོ་མོའི་ངོས་ནས་བརྗོད་ན་ཆེས་རྩ་ཆེ་བ་ནི་རིན་ཐང་བྲལ་བའི་གསེར་དངུལ་གྱི་རྒྱུ་ནོར་དག་མ་ཡིན་པར།",
    "རྙིང་ཞིང་གོག་པའི་གྱང་ངོས་ཀྱི་འདྲ་པར་དེ་རེད།",
    "འདྲ་པར་དེ་ནི་ཁོ་མོ་ད་བར་དུ་འཚོ་གནས་བྱེད་པའི་སྒུལ་ཤུགས་གཅིག་པུ་དང་།",
    "ཁོ་མོ་མུ་མཐུད་འཚོ་གནས་བྱེད་པའི་དམིགས་འབེན་གཅིག་པུ་དེའང་རེད།",
    "འདྲ་པར་དེ་ཁོ་མོའི་མིག་མཐར་འཆར་ཐེངས་རེར།",
    "ཁོ་མོའི་སེམས་པ་གཤོག་ཐོགས་ཀྱི་རྟ་ཕོ་དང་འགྲོགས་ནས་ཧ་ཅང་རྒྱང་རིང་གི་ཕ་མཐར་ཆས་འགྲོ།",
    "མོས་མྱུར་དུ་གྱང་ངོས་སུ་བཀལ་ཡོད་པའི་འདྲ་པར་གྱི་ཕྱོགས་སུ་མིག་འབུར་ཚུགས་སུ་ཅེར་ནས་བསྡད་དེ་དུས་ཡུན་ཇི་ཙམ་ཕར་ལ་འདས་པ་མོ་རང་ཉིད་ལའང་གསལ་ཆ་མེད།",
    "ཉིན་ལྟར་དུས་ཚོད་སྟོང་བ་འདྲ་ཡོད་ཚེ་འདྲ་པར་ལ་ཅེར་ནས་མནོ་བསམ་གཏང་རྒྱུ་ནི་ཁོ་མོའི་མི་ཚེའི་ཁྲོད་ཀྱི་གྲུབ་ཆ་གལ་ཆེན་ཞིག་ཏུ་གྱུར་ཟིན།",
    "བཞིན་མདངས་སྐྱ་བོར་གནས་པའི་མི་བུ་ཞིག་གི་འདྲ་པར་རེད།",
    "ཁོ་མོའི་ངོས་ནས་བརྗོད་ན།",
    "ཁོ་མོའི་ཀླད་པའི་སྦུབས་སུ་བདེ་སྐྱིད་ཅེས་པའི་ཐ་སྙད་དེ་ལ་རོ་བཅུད་གཏན་ནས་མེད།",
    "ཁོ་མོས་སྐྱེས་པ་དེ་སྒུག་སྒུག་ནས་ད་བར་དུ་ལོ་ངོ་ཇི་ཙམ་འདས་ཟིན་པ་མོ་རང་ཉིད་ལའང་གསལ་ཆ་མིན་འདུག་འོན་ཀྱང་།",
    "མོས་སྐྱེས་པ་དེའི་འདྲ་པར་མིག་ལམ་དུ་འཆར་ཐེངས་རེར།",
    "འདས་པའི་དུས་ཀྱི་གནས་ཚུལ་རྣམས་མོའི་ཡིད་ཀྱི་དར་དཀར་ངོས་སུ་གློག་བརྙན་ཇི་བཞིན་གསལ་གྱིལ་ལེར་འཆར་ངེས་ཤིང་།",
    "གཏམ་རྒྱུད་དག་དྲན་ཐེངས་རེར།",
    "གལ་ཏེ་འཇིག་རྟེན་འདིར་སྡུག་བསྔལ་གྱི་མིག་ཆུ་ཟེར་བ་དེ་བཏང་ནས་རྫོགས་རྒྱུ་ཡོད་པ་ཞིག་ཡིན་ན་མོའི་མིག་ཆུ་སྔ་མོ་ནས་སྐམ་ཟིན།",
    "རང་ཉིད་ཀྱི་ཤ་ལས་མཆེད་པའི་བུ་མོས་ཨ་མ།",
    "ངའི་ཨ་ཕ་སུ་ཡིན།",
    "ངའི་ཨ་ཕ་གང་དུ་ཡོད་ཅེས་རང་གི་ཨ་ཕའི་སྐོར་དྲི་སྐབས།",
    "མོའི་སེམས་པར་སྨྲ་དཀའ་བའི་ཚོར་བ་སྐྱུར་མོ་ཞིག་གིས་ཡོངས་སུ་འཁྲིལ་ཡོང་མོད།",
    "མོས་སྔར་རྒྱུན་བཞིན་ནུས་ཤུགས་ཡོད་རྒུས་གདོང་ནས་འཛུམ་མདངས་ཤིག་ཕྱིར་ཕྱུངས་ཐབས་བྱས་ཏེ།",
    "ཨ་ཕས་ཁྱོད་ལ་རྔན་པ་དང་རྩེད་ཆས་མང་དག་ཅིག་བསྣམས་ནས་ཕྱིར་ལོག་ཡོང་ངེས་ཅེས་བརྗོད་པར་བྱེད་པས།",
    "བུ་མོའི་ངོ་གདོང་ནས་ཀྱང་ཡིད་ཚིམས་པའི་དགའ་སྤྲོའི་འཛུམ་ཞིག་ཕྱིར་མངོན་འོང་།",
    "མོས་རང་གི་ཁྱོ་ག་ད་ཆ་ས་ཆ་གང་འདྲ་ཞིག་ཏུ་འཚོ་གནས་བྱེད་མིན་དང་།",
    "གཟུགས་ཁམས་བདེ་མོ་ཡིན་མིན་སོགས་གཏན་ནས་མི་ཤེས།",
    "ཁྱོ་ག་བུད་ནས་ད་བར་དུ་ལོ་ངོ་བཅུ་ལྷག་འདས་ཟིན་མོད།",
    "ལོ་ངོ་བཅུའི་ནང་ཁྱོ་གས་རང་ཉིད་ལ་ཡི་གེ་ཐེངས་གཅིག་ལས་བསྐུར་མ་མྱོང་།",
    "ངའི་དྲན་གདུང་གི་ཕྱི་མིག་འཕེན་ཡུལ་ཡིན།",
    "ད་དུང་ངེད་གཉིས་པོའི་བུ་མོ་ལོ་ན་ཆུང་བས།",
    "ཁྱེད་ཀྱིས་སེམས་འཁུར་མང་ཙམ་གནོངས་མོས་དུས་ད་ལྟའང་ཁྱོ་གས་བསྐུར་བའི་འཕྲིན་ཡིག་ནང་གི་ཡིག་འབྲུ་རེ་རེ་སེམས་ལ་རྡོ་བརྐོས་རི་མོ་ཇི་བཞིན་གསལ་པོར་ངེས་འདུག་དུས་ཡུན་ཇི་ཙམ་སྒུག་དགོས་བྱུང་ཡང་།",
    "མོས་རང་ཉིད་ཀྱི་ཁྱོ་ག་ཕྱིར་ལོག་ཡོང་རྒྱུར་རེ་སྒུག་བྱེད་པའི་བློ་སེམས་ལ་འགྱུར་བ་ག་ལ་འབྱུང་སྲིད།",
    "གཅིག་བྱས་ན་རང་ཉིད་ཀྱི་ཁྱོ་ག་ཡིན་སྲིད།"
  ]
}