    "གད་ལོ་ནི་ཆར་ཞོད་འབེལ་བའི་དབྱར་ཁའི་ནམ་ཟླ་ཞིག་རེད།",
    "མི་བུ་ཞིག་གི་མིག་མཐའ་ནས་བཞུར་བའི་མིག་ཆུ་ལྟ་བུའི་ཆར་བ་དེས་ཁ་དོག་སྐྱ་བོའི་རོང་གྲོང་གི་རི་ཀླུང་ཐམས་ཅད་བརླན་པར་བྱས་ཀྱང་།",
    "རྟག་ཏུ་གནམ་རྒན་མར་རེ་འབོད་དང་སྐྱབས་ཞུ་བྱེད་པའི་ཁོ་ཚོའི་སྒྱིད་ལུག་གི་གཤིས་སྤྱོད་དེ་འགྱུར་བ་གཏོང་བའི་ནུས་པ་ཡང་དེ་ཁོ་ལ་མིན་འདུག་ཆར་བ་དེ་བར་མཚམས་མེད་པར་བབས་ཀྱིན་འདུག་ཆར་བ་བབས་ཚད་ཆེ་བས་ཡིན་ནམ།",
    "རྒད་པོ་བཀྲ་བྷོའི་ཁྱིམ་ཚང་ཤྭ་འོད་ཀྱིས་བསྣུབས་སོང་།",
    "རྒད་པོ་བཀྲ་བྷོ་ཚང་སྟོང་བར་བྱས་སོང་།",
    "རྒད་པོ་བཀྲ་བྷོ་ཚང་གི་སྔོན་ཆད་ཀྱི་ཁྱིམ་ཚང་དེ་ཕྱུག་པོ་ཞིག་ཡིན་ཚོད་འདུག་སྟེ།",
    "ནོར་ལུག་གིས་ཕྱུགས་ར་ཁེངས་ཤིང་།",
    "གསེར་དངུལ་རྒྱན་ཆས་རང་ལུས་བཀླུབས་པ་ཞིག་རེད་ཟེར།",
    "ལོ་གཅིག་རྗེས་ཀྱི་དབྱར་ཁའི་དུས་ཚིགས་དེར་ཆར་ཆུ་ཧ་ཅང་དཀོན་པས་རི་གྲོང་དེའི་ཞིང་ས་དང་རི་ཀླུང་ཡོད་དོ་ཅོག་སྔར་བས་སྐྱ་ཆིལ་ཆིལ་དུ་གྱུར་འདུག་ད་རེག་བར་དུ་འགྱུར་ལྡོག་ཅུང་ཟད་ཡོད་པ་ནི་རྒད་པོ་བཀྲ་བྷོའི་དཔྲལ་སྟེང་གི་གཉེར་མའི་བང་རིམ་དེ་ཆུ་ཡིས་དབེན་པའི་གྲོག་ཤུར་ཞིག་ཏུ་སྣང་ཞིང་།",
    "རྒད་པོ་བཀྲ་བྷོའི་མགོ་སྐྱེས་ཀྱི་སྐྲ་ལོ་དེ་ཡང་ལོ་དེའི་དགུན་ཁར་བབས་པའི་ཁ་བ་ཇི་བཞིན་སྐྱ་ཆིལ་ལེར་ཆགས་འདུག་པ་དེ་རེད།",
    "ད་ལོ་དབྱར་ཁའི་ཆར་བ་ཐོག་མ་དེར་ཞེ་མེར་བའི་དྲི་ངད་ཅིག་གིས་སྦགས་འདུག་ཅིང་།",
    "ལོ་དེའི་དགུན་ཁར་བབས་པའི་ཚེས་རྗེས་མའི་ཁ་བ་དེས་མི་རྣམས་ཀྱི་ཡིད་ཀྱི་ལྷ་ལམ་ངོས་སུ་སྐྱོ་ལྷང་ལྷང་གི་ཚོར་མ་སྐྱུར་མོ་ཞིག་བསྣན་པར་བྱས་སོང་།",
    "དབྱར་དུས་ཀྱི་ཆར་བ་ནི་ངོ་མ་ངར་ཤུགས་ལྡན་པ་ཞིག་རེད།",
    "ནམ་མཁར་སྤྲིན་ནག་འཁྲིགས་མ་ཐག་དེ་མ་ཉིད་དུ་འབྲུག་སྒྲ་འུར་འུར་དུ་གྲགས་ནས་ཆར་བ་བབས་ཏེ་ནོར་འཛིན་སྒེག་མོའི་བཞིན་རས་སྐད་ཅིག་ཉིད་དུ་བརླན་པར་གཏང་འགྲོ།",
    "གནས་དེ་རྒྱང་རིང་གི་རི་འདབས་ཤིག་ཏུ་ཆགས་ཡོད་པའི་རྐྱེན་གྱིས།",
    "སོ་ནམ་པ་ཚོས་ནམ་རྒྱུན་ནམ་མཁའི་ཆར་ཆུ་ལ་བརྟེན་ནས་མྱུ་གུ་ལ་འབྲས་བུ་སྨིན་པར་རེ་བཞིན་ཡོད་པས།",
    "ཆར་ཆུ་དུས་སུ་དབབ་ན་སྟོན་མཇུག་གི་སྐབས་སུ་སོ་ནམ་པ་ཚོའི་གདོང་ལ་འཛུམ་མདངས་ཤིག་ཕྱུངས་ཏེ་ལོ་ལེགས་ཀྱི་འབྲས་བུས་འབྲུ་མཛོད་བྱུར་བུར་གཏམས་ཐུབ་ཅིང་།",
    "ཞིང་ནང་གི་མྱུ་གུ་ཚ་བས་གདུང་སྟེ་མགོ་བོ་ས་ལ་དུད་ནས་སུ་ཞིག་ལ་མྱ་ངན་ཞུ་བ་དང་དབྱེར་མ་མཆིས།",
    "གཞོན་ནུ་མ་ཞིག་གི་སྐྲ་ལོ་ཐུར་དུ་འཕྱངས་པ་དང་ཡང་མཚུངས།",
    "ཁོ་ཚོས་ནམ་མཁའི་ཆར་ཆུ་ཁོ་ནར་སྐྱབས་སུ་བརྩིས་ཏེ་ལོ་ལེགས་ཀྱི་འབྲས་བུ་རེ་བཞིན་སྒུག་པ་ལས།",
    "ཟླ་འོད་མེད་ཅིང་སྐར་ཚོམ་ཡང་མེད་པའི་ཉིན་ཞིག་གི་མཚན་མོར།",
    "མང་ཚོགས་ཀྱི་བསམ་བློའི་གོ་རྟོགས་དམའ་བོ་ཡིན་པའི་རྒྱུ་རྐྱེན་ལ་གཞིགས་ནས།",
    "ཡུལ་གྲུ་འདིར་ཆེས་ཐོག་མར་ཁོ་ལས་བྱེད་དུ་མངགས་པ་ཞིག་རེད།",
    "སྐྲ་ལོ་རིང་ཞིང་ཐལ་རྡུལ་གྱིས་བཀང་བ།",
    "ཁོ་ནི་གནས་མཇལ་བ་ཞིག་རེད་ཁོ་ནི་ཡུལ་གྱར་བ་ཞིག་རེད་ཁོ་སློང་མོ་བ་ཞིག་ཡིན་ཀྱང་སྲིད་ཁོ་སུ་ཡིན་མིན་སྐོར་ལ་ཡུལ་མི་ཚོས་ལབ་གླེང་མང་དག་ཅིག་བྱས།",
    "འཚང་ཁ་ཤིག་ཤིག་གིས་ཁོ་ལ་ཅེར་འདུག་ཁོས་རང་གི་སྐྲ་ལོར་བྱི་དོར་ལན་འགའ་བྱས་ཤིང་།",
    "ཧ་ཅང་གུས་ཞབས་ལྡན་པའི་སྒོ་ནས་བྱམས་བརྩེའི་མིག་ཟུང་མང་ཚོགས་ཚོར་གཟིགས།",
    "མཚན་མོ་དེར།",
    "ཞོགས་པའི་ཉི་གཞོན་རྩྭ་ཐང་ཡངས་མོར་དལ་གྱིས་འཕྲོས་བྱུང་།",
    "ཁོ་སྔ་མོ་ནས་མལ་ལས་ལངས་ཟིན།",
    "རྩྭ་ཐང་གི་ཞོགས་པའི་དུད་སྤྲིན་དང་།",
    "ད་རུང་ལུག་གི་འབའ་སྒྲ་དང་།",
    "འབྲི་མོའི་ངུར་སྒྲ།",
    "དེ་ནི་སྡུག་བསྔལ་དང་མནར་གཅོད་ཅིག་ཡིན་པ་བརྗོད་མེད་རེད།",
    "དུ་ས་རྒྱུན་ཡིན་ན་ནམ་མཁའི་ཆར་ཆུ་དེ་ཙམ་གྱིས་འབབ་ཚད་ཆུང་ཡང་སྟོན་ཁ་མང་ཉུང་ལ་མ་བལྟོས་པར་འབྲུ་རིགས་སྣ་ལྔའི་འབྲས་བུས་འཚོ་བ་འཁྱོལ་ཙམ་ཡོང་གི་ཡོད་མོད།",
    "ཡུལ་མི་ཚོ་དེ་ལྟར་རེ་ཐག་ཆད་དེ་ཅི་བྱ་གཏོལ་མེད་དུ་གྱུར་བའི་སྐབས་སུ།",
    "ཁོས་ཅིས་ཀྱང་གྲོང་ཚོའི་མི་རྣམས་ཀྱི་དཀའ་ཁག་སེལ་རོགས་མཛད་དགོས།",
    "ལྟ་རྒྱ་མཐོང་རྒྱ་ཆུང་བའི་ཡུལ་གྲུ་དེ་འདྲར་ཁོའི་འཆར་གཞི་ལག་ལེན་དུ་བསྟར་རྒྱུ་ནི་ངོ་མ་དཀའ་ཚེགས་ཆེ་བ་ཞིག་རེད།",
    "ཆུ་ཀླུང་གི་ཆུ་ཞིང་ནང་དུ་དྲངས་རྒྱུའི་ཁོའི་འཆར་གཞིར་མོས་མཐུན་གཏན་ནས་མ་བྱུང་།",
    "ཆར་བ་དབབ་རྒྱུར་རེ་བཞིན་འདུགཡུལ་གྲུ་དེ་ནི་རོང་མ་འབྲོག་གི་ས་ཆ་ཞིག་ཡིན་པས།",
    "ཞིང་ཁ་དང་ཕྱུགས་རིགས་སུ་ལ་མཚོན་ནའང་ཆུ་ཡི་དགོས་མཁོ་ཤིན་ཏུ་ཆེ་བ་སྨོས་མེད་རེད།",
    "ཞིང་ནང་གི་ལོ་ཏོག་ཀྱང་ཉི་མའི་ཚ་བས་གདུང་སྟེ་སྐྱེ་འཕེལ་གྱི་གསོན་ཤུགས་རིམ་གྱིས་ཉམས་འགོ་ཚུགས།",
