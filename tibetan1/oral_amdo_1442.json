    "མ་ཎྱི་བཀའ་འབུམ་སོང་བཙན་སམ་པོས་གསུངས་ཤྱིང་།",
    "མཛད་པ་ཐུན་མོང་དང་ཐུན་མོང་མ་ཡྱིན་པའྱི་རྱིགས་སེལ་མར་འགོད་པ་དང་།",
    "ཡུལ་ག་཈འ་ནང་གྲོད་པ་ཕུག་པར་ལྷ་མྱིའྱི་རྣལ་འབྱོར་ཕོ་མོའྱི་ཚོགས་དང་བཅས་པའྱི་དབུས་ན་བཞུགས་སོ།",
    "ཡང་དེར་རས་ཆུང་པས་རེ་བཙུན་ལ་ཕག་བཙལ།",
    "རེ་བཙུན་གྱི་དྲུང་དུ་པུས་མོ་བཙུགས་ཐལ་མོ་སར་ཏེ་འདྱི་སྐད་ཅེས་གསོལ་བ་བཏབ་བོ།",
    "མ་འོངས་པའྱི་སྐལ་ལྡན་གདུལ་བྱར་གྱུར་པ་རྣམས་རེས་སུ་བཟུང་ཞྱིང་།",
    "གཞན་ཡང་སེ་འགྲོ་མཐའ་དག་སྨྱིན་གྲོལ་ལ་འགོད་པར་བྱ་བའྱི་ཕྱིར་ཐུགས་བརེ་བ་ཆེན་པོས།",
    "རེ་བཙུན་རྱིན་པོ་ཆེ་ཁྱེད་རང་གྱི་གདུང་དང་རྱིགས་ཀྱི་འབྱུང་ཁུངས་དང་བཅས་ཏེ།",
    "དེར་རེ་བཙུན་ཆེན་པོ་ཞལ་འཛུམ་པ་དང་བཅས་ཏེ།",
    "རས་ཆུང་པ་ཁོ་བོའྱི་ཆ་རྒྱུས་ཁྱོད་ཆེ་ནའང་།",
    "ངས་དེའྱི་ནུབ་མོ་རྨྱི་ལམ་བཟུང་ནས་ཨུ་རྒྱན་ལྡ་རུ་ཕྱིན་པས།",
    "དེ་ཡང་གཙོ་བོ་རེ་ཙོང་ཁ་པའྱི་རང་རྣམ་རོགས་བརོད་འདུན་ལེགས་མ།",
    "ཚར་ཆེན་བོ་གསལ་རྒྱ་མཚོའྱི་རང་རྣམ་རོགས་པ་བརོད་པ་ལམ་གླུ་དཔྱྱིད་ཀྱི་རྒྱལ་མོའྱི་གླུ་དབྱངས།",
    "རེ་བཙུན་ཀུན་དགའ་གྲོལ་མཆོག་གྱི་ཞེན་པ་རང་གྲོལ་གྱི་ལྷུག་པར་བརོད་པའྱི་གཏམ་སྐལ་བཟང་དད་པའྱི་ཤྱིང་ར་འདྲེན་བྱེད་",
    "རེའྱི་རོགས་བརོད་འདུན་ལེགས་མར།",
    "ཞེས་རང་གྱི་མྱི་ཚེའྱི་བགྲོད་ལམ་རྱིང་མོར་སྱི་སོམ་མཛད་པ་དང་།",
    "ཁོ་བོ་རབ་བྱུང་ཅེས་པ་མེ་མོ་ཡོས་ཀྱི་ལོ།",
    "ཤ་དུས་རབས་བཅུ་བདུན་པའྱི་རེས་ནས།",
    "རང་རྣམ་ཚིགས་བཅད་མ་མང་པོ་ཆར་རེས་ཀྱི་ཤ་མོ་བརྡོལ་བ་བཞྱིན་བྱུང་།",
    "དེ་ནས་དགུང་ཚིགས་ས་ཕྱི་ལྟར་མཛད་པ་རེ་རེ་བཞྱིན་ཞྱིབ་རྒྱས་སུ་འགོད།",
    "རང་རྣམ་ཀུན་གྱི་ཡང་རེའམ་མཆོག་ཏུ་ཀུན་མཁྱེན་འཇམ་དབྱངས་བཞད་པའྱི་རྡོ་རེའྱི་གསུང་འབུམ།",
    "སྐབས་དེར་བོད་ཀྱི་རང་རྣམ་དར་བའྱི་རེར་སླེབས་ཡོད་ཅེས་བརོད་ཆོག་ག་཈ྱིས།",
    "སྱིར་རང་རྣམ་འགོད་པའྱི་སོལ་འདྱི་བོད་གཅྱིག་པུ་མ་ཡྱིན་པར་མྱི་རྱིགས་གཞན་ལའང་ཡོད་མོད།",
    "བོད་ཀྱི་རང་རྣམ་རོམ་པའྱི་ཀུན་སློང་ནྱི་ཐུན་མོང་མ་ཡྱིན་པ་ཞྱིག་སྟེ།",
    "འཇྱིག་རེན་གྱི་ཁེ་གྲགས་གཏམ་གསུམ་དོན་དུ་ག་཈ེར་བ་དང་གཏན་མྱི་འདྲ།",
    "དང་པོ་཈ྱིད་ནས་རོམ་མཁན་རང་ལ་དམྱིགས་པ་མྱིན་པ་རེས་སུ་དཔག་ནུས་ལ།",
    "རེ་ཙོང་ཁ་པ་ཆེན་པོས།",
    "དགེ་ལ་རེས་སུ་ཡྱི་རང་མཆོག་ཏུ་གསུང་།",
    "རེ་བཙུན་ཀུན་དགའ་གྲོལ་མཆོག་གྱི་རང་རྣམ་དུ།",
    "རང་གྱི་བུ་རབས་ཚ་རྒྱུད་དག་གྱིས་རང་རེའྱི་ཕ་མེས་གོང་མ་རྣམས་ཀྱི་ལེགས་མཛད་ལ་སན་བལྟོས་མཛད་རེ་དང་།",
    "རྒྱ་ལམ་ཙམ་ན་དལ་འབྱོར་རེན་བཟང་པོ།",
    "འདྱི་སྣང་སྒྱུ་མའྱི་རོལ་རེད་ལ་ཆགས་པས།",
    "དེ་ཕྱིར་རང་གྱི་ངང་ཚུལ་གསོང་པོའྱི་གཏམ།",
    "རྱི་མོའྱི་ལམ་དུ་སེལ་བ་མཁས་པའྱི་ཚོགས།",
    "ཞེས་སོགས་ལྡོག་ཕོགས་ནས་རེས་འཇུག་རྣམས་རང་གྱིས་འགྲོ་཈ེས་བྱས་པའྱི་ལམ་དེར་མྱི་ཞུགས་པ་དང་།",
    "དེ་ཡང་བདག་གྱི་རེས་སུ་འཇུག་ཅྱིང་མོས་པ་ཅན་གྱི་གང་ཟག་རྣམས་ཀྱི་ངོར།",
    "གང་ལྟར་འཇྱིག་རེན་གྱི་ཁེ་ཕན་དམྱིགས་ཡུལ་དུ་བཟུང་བ་ཞྱིག་མ་ཡྱིན་ནོ།",
    "རང་གྱི་བ་མ་ལ་ཁྱབ་བདག་རྡོ་རེ་འཆང་།",
    "གཞན་ལ་བརྱི་བཀུར་བྱེད་པའྱི་ངག་འཇམ་འབའ་ཞྱིག་གྱིས་རང་གྱི་ངང་ཚུལ་སོང་བོར་བརོད་པ་ཞྱིག་ཡྱིན།",
    "དཀར་ནག་འདྲེས་མའྱི་རྡོ་ཐལ་གྱིས་བྱུགས་ངོས།",
    "ཀུན་རོག་རྱི་མོར་འདྲྱི་འབྱི་",
    "དེ་རེས་སྐུ་གོང་མའྱི་གདན་སར་མགྲྱིན་བཟང་གཟྱིག་ཤུན་གོན་པའམ་སྤུ་མེད་ཀོ་གདན་གྱི་ཚུལ་དུ་ངེད་རང་བསད།",
    "ད་ལྟའྱི་རང་གྱི་ཐུན་མོང་ངང་ཚུལ་ལ།",
    "མའྱི་མྱིང་དཔོན་མོ་མགོན་མོ་སྱིད།",
    "དེའྱི་བུ་རྒན་པ་ཆུང་ཆུང་ནས་བྱ་བལ་གྱི་ལད་མོ་རྐྱང་བྱེད་པའྱི་པྲ་ཆལ་ཅྱིག་ཡོད་ཅེས་གྲག་གོ།",
    "དད་པ་མ་ལོག་པའྱི་ཁར་ཆེར་སོང་།",
    "མདའ་རེད་བྱས།",
    "ཤ་འགའ་རེ་བྱས།",
    "དེ་ལྟར་སེས་ནས་ལོ་གཅྱིག་ལྷག་ཙམ་སོང་བའྱི་ཚེ།",
    "གཞན་རྣམ་ཡང་དོན་དངོས་གཞྱིར་བཟུང་ནས་མཛད་པ་ཡྱིན་མོད།",
    "དྲང་མོའྱི་཈ག་ཕན་རྒྱུད་ལས་འཕོས་པ་ཡྱི།",
    "ཀུན་གྱི་གཟྱིགས་མོར་མཚར་བའྱི་གནས།",
    "རེ་འཇྱིགས་མེད་རྱིགས་པའྱི་བོ་གྲོས་ཀྱིས།",
    "བར་དུ་རེན་དེ་ལ་ཡོན་ཏན་བརྙེས་ཚུལ།",
    "མགུར་གླུ་ངག་ནས་ཐལ་ཚད།",
    "དེ་མྱིན་དབུས་གཙང་དང་ལྷོ་མོན།",
    "སྐུ་བལྟམས་ཤྱིང་སྣ་དཀར་རེར་བཞུགས་ཚུལ།",
    "དེ་ལས་གཞན། རེའྱི་རང་རྣམ་རོགས་བརོད་འདུན་ལེགས་མའྱི་",
    "ཤ་རེ་བཙུན་འཇྱིགས་མེད་རྱིགས་པའྱི་བོ་གྲོས་ཀྱི་གསུང་འབུམ།",
    "ཡྱིན་ཡང་སོལ་དེ་ནྱི་ཕལ་ཆེར་དུས་རབས་བཅུ་བདུན་པའྱི་རེས་ནས་བྱུང་བར་མངོན་ཏེ།",
    "རེས་སུ་རྱིམ་བཞྱིན་རང་རྣམ་རྒྱུག་ཇེ་ཆེ་དང་།",
    "དེའྱི་རང་རྣམ་ཁ་སྐོང་སྐུ་ཕེང་རེས་མ་པཎ་ཆེན་བོ་བཟང་དཔལ་ལྡན་གྱིས་མཛད་པ།",
