    "ངུས་པ་ལ་རང་བཞིན་ཙམ་མི་གདའ་སྟེ།",
    "ད་ནི་བསྡད་པས་མི་ཆོག་པར་འདུག།",
    "འཆི་ཟེར་བའི་འཇིགས་པ་ཅིག་འོང་བར་འདུག་པས།",
    "ད་ནི་ཅི་ནས་ཀྱང་དགེ་སྦྱོར་ཅིག་བྱེད་དགོས་པར་འདུག་བསམ་པའི་འདུན་པ་དྲག་པོ་དུང་དུང་པ་དང་།",
    "མཚངས་ཐོག་ལ་ལྷན་ལྷན་ཕོག་འདུག་པ་ལ།",
    "དེ་རྣམས་ཀྱིས་ཞང་ལ་འཕྱས་པར་འདུག་པས།",
    "ཡང་ཇ་ཁང་ན་བཙུན་ཆུང་གཉིས་སྒྲོ་གླེང་བྱེད་འདུག་པ་ལ།",
    "ཡང་ཡང་སྨྲས་པས་ནི་ཁ་གཤིས་ངན་པར་འགྲོ་བར་འདུག་གསུངས་ནས་བཞུགས་སུ་མ་བཞེད་པར།",
    "ལས་བཟང་ངན་སོགས་ལྐོག་ཏུ་གྱུར་པ་ཐམས་ཅད་མི་མཁྱེན་པ་གཅིག་ཀྱང་མེད་པ་ལྟ་བུར་འདུག་ཀྱང་།",
    "སྔར་མཁྱེན་པ་དཀོན་འདུག་ཕྱིར་ཧ་ཅང་རྫུན་དུ་འགྲོ་ཉན་ཆེ་བས་ཤིན་ཏུ་དགག་དགོས་ཏེ།",
    "བཤོས་ཀྱང་དྲངས་དུས་སུ་མི་གསོལ་བར་འདུག།",
    "གནོད་བྱེད་ཀྱི་འདྲེ་དེ་ཡང་རང་སེམས་ལས་གཞན་པ་རྡུལ་ཙམ་ཡང་མེད་དེ།",
