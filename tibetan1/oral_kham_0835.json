    "དེ་བཞིན་དུ་གསེར་དངུལ་གྱི་ཕུང་པོའི་སྟེང་དུ་འདུག་ལ།",
    "སྐྱེད་ཚལ་དེར་འདུག་ནས་མི་རྣམས་ཀྱི་ཉམས་སུ་དབེན་པ་གང་ཡིན་ཞེས་གཏམ་འདི་ལྟ་བུ་གླེང་ཞིང་ངེས་པར་བྱེད་དོ།",
    "བདག་ཉིད་མི་གཙང་བའི་ཕུང་པོའི་སྟེང་ན་འདུག་པ་དང་བདག་མི་གཙང་བས་ཡོག་པ་དང་།",
    "པདྨའི་སྟེང་ན་འདུག་པ་དང་།",
    "མི་གཙང་བའི་སྟེང་ན་འདུག་པ་བདག་རྒྱལ་སྲིད་ཆེན་པོའི་བདག་པོ་ལ་གནས་པའི་སྔ་ལྟས་དང་།",
    "ནམ་མཁའ་ལྕེས་བལྡག་པ་དང་པདྨའི་སྟེང་ན་འདུག་པ་ནི།",
    "བ་ལང་དང་མ་ཧེ་དང་ལྡན་པར་འདུག་སྟེ།",
    "འདུག་ནས་ཕུ་བོ་དེ་དག་ལ་སྔོན་བྱུང་བའི་གཏམ་གྱིས་ཡང་དག་པར་གློད་པ་ངེས་པར་བྱེད་པའི་ཕྱིར་མགུ་བར་བྱས་ཏེ།",
    "ཞེས་སྨྲས་ཏེ་ཤུགས་རིང་འབྱིན་ཅིང་ཅང་མི་ཟེར་བར་འདུག་གོ།",
    "དེར་བལྟས་པ་ན་བུམ་པ་དེའི་འོག་ན་ཟངས་ཟུང་ལྔ་གསེར་དངུལ་གྱིས་ཡོངས་སུ་གང་བ་ཐོགས་ཤིང་འདུག་པ་མཐོང་སྟེ།",
    "ང་ཁྲར་སྤྲུལ་ཏེ་དེད་ནས་རྒྱལ་པོ་དེའི་གམ་དུ་སྐྱབས་བཙལ་ནས་འདུག་སྟེ།",
    "རྒྱལ་བུ་མི་གདའོ་ཞེས་སྨྲས་པས།",
    "རྒྱལ་པོ་འཛའ་བོ་འཁོར་གྱི་ནང་དུ་འདུག་སྟེ།",
    "བཙོང་རྒྱུ་དེ་ནི་བུམ་པ་འདི་ན་འདུག།",
    "དེ་གཞལ་མེད་ཁང་ཞིག་ན་འདུག་པའི་མདུན་དུ་ཚངས་པའི་འཇིག་རྟེན་ནས་བབ་སྟེ།",
    "མངལ་ན་འདུག་པའི་སྔ་རོལ་གྱི་བློ་དེ་ནི་དེ་མ་ཐག་ཚེ་སྔོན་མའི་བློའོ།",
    "མེ་ཆེན་པོ་དེའི་སྟེང་དུ་འདུག་སྟེ་འདབ་མ་སྤྲུགས་བཞིན།",
    "རྒྱལ་པོ་གཅིག་པུ་ནགས་ཚལ་འཐུག་པོར་ཕྱིན་ནས་རྟ་ལས་བབ་སྟེ་འདུག་པ་དང་།",
    "རྒྱལ་བུའི་གཟུགས་བཟང་པོ་ལ་ལྟ་ཞིང་སེམས་ཆགས་བཞིན་འདུག་གོ།",
    "རྒྱལ་བུ་ཟླ་བ་དེའི་གཟུགས་བཟང་པོ་ཕུན་སུམ་ཚོགས་པ་ལ་མིག་བགྲད་དེ་ལྟ་ཞིང་འདུག་གོ།",
    "བདག་འཕྲལ་གྱི་བདེ་བ་ལ་མ་ཆགས་ཤིང་རང་ཉིད་སྲུང་བའི་ལམ་འབའ་ཞིག་ལ་ལྟ་བའི་གཞུང་ལུགས་ངན་པའི་ཚུལ་སྤངས་ནས་བདེན་པ་སྲུང་བའི་ཕྱིར་འདིར་འོང་བ་དེ་ཉིད་གཞུང་ལུགས་ཀྱི་ཚུལ་ལ་མཁས་པ་སྟེ།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "བདག་ཇི་སྲིད་འདིར་འདུག་པ་ལས་འདི་དོར་བ་ལེགས་སྙམ་དུ་དོམ་དེ་ཤིང་ཁ་ནས་བོར་བ་དང་།",
    "འདུག་མིན་འཆག་པ་ལ་ཡང་མིན།",
    "མི་དེ་ནོངས་བཞིན་སྐྲག་ནས་འདུག་པ་ལས་གཞན་མ་མཐོང་བས།",
    "དེ་དེ་དང་ཤིན་ཏུ་གཅུགས་པས་གཏམ་སྣ་ཚོགས་སྨྲ་ཞིང་འདུག་གོ།",
    "རིའི་བྱ་སྐྱིབས་ན་རྡོ་དྲེག་ཞིག་འདུག་པ་མཐོང་ནས་སྨྲས་པ།",
    "ས་ག་དེ་ཕྱོགས་ཤིག་ན་འདུག་པ་དེར་རྒྱན་གྱིས་བརྒྱན་པ་བཞིན་དུ་མཐོང་ནས།",
    "དེས་གུས་པ་དང་བཅས་པས་མགོ་ལ་བཏགས་ཏེ་འདུག་གོ།",
    "དེ་ཐོང་ཞིག་ཅིང་རྡུལ་གྱིས་ཡོག་ལ་འགྲེ་ཞིང་འདུག་པ་མཐོང་ནས་མིག་མཆི་མས་གང་ཞིང་རྒྱལ་པོ་ཆེན་པོ་སྣད་བར་མ་གྱུར་ཏམ།",
    "འགྲོ་བ་དང་འདུག་པ་ཉལ་བ་སོགས་སྤྱོད་ལམ་ཐམས་ཅད་ཀྱི་ཚེ་ན་མི་སྙན་པ་ཟེར་ཏེ།",
    "ཁྱིམ་གྱི་སྒོ་དྲུང་ན་འདུག་པ་དང་།",
    "དེས་ཇི་ལྟར་གྱུར་པ་བརྗོད་པས་དེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "དེའི་ཚེ་རྒན་ཞུགས་ཤིག་དེ་ན་འདུག་པས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ།",
    "ཆུ་འདིའི་ཕུ་ཧ་ཅང་མི་རིང་བ་ཞིག་ན་ཤིང་བཟང་པོ་ཡོད་པར་འདུག་སྟེ།",
    "སྦ་ཐག་དང་ནྱ་གྲོ་དྷའི་ཡལ་ག་དུས་གཅིག་མདའ་གཉིས་ཀྱིས་ཆོད་ཅེས་བསྒོས་པ་དེ་བཞིན་དུ་བྱས་ཏེ་རྒྱལ་པོས་བརྒྱང་བ་བཟེད་པ་ལ་ཕབ་ནས།",
    "མྱོས་པར་བྱེད་པའི་ཤིང་ཐོག་སུས་ཟོས་པ་ཞག་བདུན་དུ་བརྒྱལ་ཏེ་འདུག་པ་ཡོད་པས་དེ་རྣམས་ལ་བག་བྱོས་ཤིག།",
    "དེར་དབྱིག་དགས་བདག་གསོན་པོར་འདུག་བཞིན་འདི་རྣམས་རྒྱ་མཚོ་ལས་བསྒྲལ་མི་ནུས་ཀྱི།",
    "གང་དག་ང་ཡི་རྐང་པའི་དྲུང་འདུག་དང་།",
    "གང་དག་ཡུལ་འདི་ཡི་ནི་མཐར་འདུག་པ།",
    "གཡོན་ལོགས་ན་འདུག་པའི་ཆུང་མ་ལ་བལྟས་པ་དང་།",
    "རྒྱལ་པོ་དེའི་མདུན་དུ་འདུག་སྟེ་སྨྲས་པ།",
    "ཞེས་སྨྲས་ནས་འདུག་པ་དང་།",
    "གཟུགས་ཅན་དེ་དག་སྐྲ་བཤིགས་ཏེ་འཇིགས་འཇིགས་ལྟར་འདུག་པ་མཐོང་ནས་སྐྲག་སྟེ་ཕྱིར་ལོག་གོ།",
    "དེ་ནས་དུས་ཤིག་ན་རྒྱལ་པོ་དེས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་ལ།",
    "གཅན་གཟན་གདུག་པ་རྣམས་དང་ལྷན་ཅིག་འདུག་པ་བླའི།",
    "དེ་འདུ་འཛི་ལ་མི་དགའ་བས་ཀུ་རུ་ཞེས་པའི་གླིང་ལྷོ་ཕྱོགས་ཀྱི་རྒྱ་མཚོའི་ནང་ན་འདུག་པའི་དབེན་པ་ལ་གནས་ནས་དཀའ་ཐུབ་དང་བརྟུལ་ཞུགས་ལ་གནས་སོ།",
    "ཡིད་ལ་བྱ་བའི་མན་ངག་བསྟན་པ་བཞིན་དུ་བསམ་གཏན་བྱེད་ཅིང་འདུག་གོ།",
    "འདི་འདིའི་ཆུང་མ་ཡིན་འདུག་ཀྱང་འཕྲོག་པར་བརྩམ་སྟེ།",
    "ཚེམ་བུ་དྲུབ་ཅིང་འདུག་གོ།",
    "ང་འཕྲོག་པའི་ཚེ་མཐུ་མེད་པར་ཞུམ་ཞིང་འདུག་པས་ཅི་བྱ།",
    "ཆབ་སྒོ་དེར་མཚོན་ཆ་ཐོགས་པའི་སྐྱེ་བོའི་ཚོགས་སྡོད་ལ་དེ་ནས་ནང་དུ་ནང་མི་དང་བྲམ་ཟེ་དང་བློན་པོ་རྣམས་གོ་རིམ་བཞིན་སྡོད་ཅིང་རྒྱལ་པོ་ནི་ནང་དུ་སེང་གེའི་ཁྲི་ལ་འདུག་གོ།",
    "རྒྱལ་པོ་དུལ་ཞིང་དེས་པའི་ཚུལ་བཟུང་སྟེ་ཅང་མ་སྨྲས་པར་ངོ་ཚ་བས་མགོ་སྨད་དེ་འདུག་གོ།",
    "དཀའ་ཐུབ་ཀྱི་ནགས་ན་འདུག་བཞིན།",
    "མཁས་པ་རྣམས་ཀྱང་རང་གར་ཅི་བདེ་བར་སྤྱོད་རིགས་ལ།",
    "ལ་འདུག་ན་གཟི་བརྗིད་དང་མཐུ་ཆེ་བ་དང་།",
    "གནས་འདི་ཞེས་བགྱི་བ་ན་ཤིང་ཤ་ཀོ་ཏ་ཀ་དེ་ལ་བྱ་རོག་ཅིག་འདུག་པ་དེས་བདག་ཤིང་གཞན་གྱི་སྟེང་དུ་འདུག་ཚེ་སྐད་མི་སྙན་ལ།",
    "གྱོས་ཕོའི་ཁྱིམ་ན་འདུག་པའི་ཚེ་དེ་ལ་ཆགས་ནས་ཕ་མའི་ཁྱིམ་དུ་འགྲོ་འདོད་ལ།",
    "ཡང་དུས་གཞན་ན་གངྒཱར་བུམ་པ་ཞིག་ཁྱེར་བའི་སྟེང་ན་ཆུ་སྲེག་ཅིག་འདུག་པ་མཐོང་ནས་གཞོན་ནུས་དེ་ལ་ཡང་ཚིགས་བཅད་སྨྲས་སོ།",
    "དེས་ཀྱང་ཁ་ཅིག་བློན་པོར་བཅུག་ནས་དེ་རྣམས་ལྷན་ཅིག་རྩེ་ཞིང་འདུག་པ་ལས།",
    "བདག་སྐྱེས་ནས་མཐོང་ཐོས་མ་མྱོང་བའི་ཀླན་ཀ་ཞིག་འཚོལ་ལོ་སྙམ་དུ་འདུག་པ་དང་།",
    "མི་གཅིག་སྟེང་དུ་ཞོན་ཏེ་འདུག་གོ།",
    "མི་འདི་སྒོར་འདུག་ཆུག་ཅིག།",
    "ཅུང་འདུག་ནས་སྨྲས་པ།",
    "དེས་བདག་སྐྱེད་ཚལ་འདིར་འདུག་སྟེ།",
    "ཤིང་ཨུ་དུམ་བཱ་ར་སྨིན་པ་ཞིག་མཐོང་ནས་གཟུགས་ངན་དེ་ལ་འཛེགས་ཏེ་ཟ་ཞིང་འདུག་པ་དང་།",
    "དེ་བྲུ་བས་གཟིར་ནས་ནན་གྱིས་ཤིང་དེ་ལ་འཛེགས་ནས་ཟ་ཞིང་འདུག་པ་དང་།",
    "བཀའ་དང་པོའི་དགོངས་འགྲེལ་སྐོརཨུད་ཤུད་བརྒྱ་ཞིང་འདུག་པར་མཐོང་ནས་ཆུང་མ་འདི་དང་ལྷན་ཅིག་གཏམ་གྱི་ཐབས་ཅི་ལྟ་བུ་ཞིག་བྱ་སྙམ་དུ་བསམས་ནས།",
    "ཉི་མ་ལ་བལྟར་མི་བཟོད་པ་ལྟར་བྲམ་ཟེ་འདུག་འདུག་ཅིང་བསམ་བཞིན་དུ།",
    "གལ་ཏེ་ས་ཆེན་པོ་ནང་ཡངས་ལ་ཕྱི་ཤིག་རྟའི་དབྱིབས་ལྟར་འདུག་པ་འདི་ཆ་བདུན་དུ་འགེད་པ་སུ་ཞིག་ཡོད་ཟེར་ན།",
    "རྒྱལ་བུས་འོ་ན་ས་ཆེན་པོ་ནང་ཡངས་ལ་ཕྱི་ཤིང་རྟའི་དབྱིབས་སུ་འདུག་པ་ཆ་བདུན་དུ་འགེད་པས་སུ་ཡོད།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་མདུན་ན་འདོན་ཞིག་འདུག་པའི་གན་དུ་དོང་བ་ལ།",
    "ཁ་རོག་འདུག་ཅིག་ཆོལ་ཟངས་པ།",
    "ལྷ་འདི་ནི་མ་བཟུང་ཡང་རང་ཉིད་འོངས་པ་ལགས་སོ།",
    "དེ་ནས་རྒྱལ་པོའི་འབྱོར་པ་ཆེན་པོས་རི་དྭགས་ཀྱི་དཔོན་པོ་གཟུགས་ཤིན་ཏུ་ལྡུག་པ་དེ་སེང་གེའི་ཁྲི་ལ་འདུག་ཏུ་བཅུག་ནས།",
    "རྒས་པ་ཡང་འགུམ་བར་གདའ་ལགས་ཏེ།",
    "གནས་ཤེས་པ་སོགས་དང་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱི་བར་ལ་སེམས་ཤིང་འདུག་པ་ལ།",
    "རྒྱལ་པོ་དགུ་བཅུ་རྩ་དགུ་པོས་དེའི་རྐང་པ་ལ་ཕྱག་བྱས་ནས་འཁོར་དུ་འདུག་གོ།",
    "བཅོམ་ལྡན་འདས་འདི་ཚོང་དཔོན་གྱི་བུ་དྲི་མ་མེད་པའི་དཔུང་པ་ཞེས་བྱ་བར་གྱུར་པ་ན་ཁྱེའུ་དེ་མའི་པང་ན་འདུག་པས་དགེ་སློང་དེ་མཐོང་ནས།",
    "མྱོས་པ་དང་བྲལ་ནས་དཔྱད་དྲན་ནས་རང་ཉིད་གནས་སུ་འོངས་ཏེ་འདུག་གོ།",
    "དེ་ཡང་རང་སྟོབས་རྙེད་ནས་ཇེ་བརྟན་དུ་འགྲོ་ཞིང་ས་ཐོབ་ཕན་ཆད་སེམས་བསྐྱེད་པ་དེ་ཚེ་རབས་ཐམས་ཅད་དུ་ཉམས་པ་མེད་པར་མངོན་དུ་འགྱུར་རོ།",
    "དེ་ནམ་མཁའ་ལ་འདུག་པ།",
    "འདི་ན་ང་འདུག་པ་ཡང་མི་མཐོང་ངོ།",
    "དེ་བཞིན་ང་ཡང་རང་བྱུང་འཇིག་རྟེན་ཕ།",
    "དེ་དག་འགྲེང་ངམ་འདུག་གམ་འཆག་པ་དེར་དེ་བཞིན་གཤེགས་པའི་ཕྱིར་མཆོད་རྟེན་བརྩིག་གོ།",
    "མིང་དེ་ཡང་ཐོས་ཏེ་དམིགས་ནས་དེ་བཞིན་གཤེགས་པ་དེ་ཕྱོགས་ག་ལ་བར་བཞུགས་པའི་ཕྱོགས་དེར་མངོན་དུ་བལྟས་ཏེ་འདུག་པར་བྱའོ།",
    "དེ་དག་ལ་འདི་སྐད་ཅེས་ཡོན་ཏན་བསམ་གྱིས་མི་ཁྱབ་པ་ཡོངས་སུ་བསྒྲགས་པ་འདི་ཡང་དག་པར་ཟུངས་ལ་འདུག་ཅིག་དང་།",
    "དེ་ནས་ཁྱེའུ་དེས་ཕྱོགས་བྱི་དོར་མ་བྱས་པ་ཞིག་ཏུ་འདུག་ནས་ཅང་མི་སྨྲ་བར་གྱུར་ཅིང་ཉིན་གཅིག་ཟན་ཡང་མ་ཟོས་སོ།",
    "ཁྱིམ་འདིར་འདུག་ལ་སྦྱིན་པ་དག་ཀྱང་བྱིན་ཅིག།",
    "འགྲོ་བ་འདི་ཡང་རང་བཞིན་མེད།",
    "རང་གཡོན་ཅན་གྱི་ནང་ན་གནས་པ་དང་རང་ལུས་དྲི་མ་ཅན་དང་གོས་དྲི་མ་ཅན་དུ་མཐོང་བ་བཞིའོ།",
    "ཁྱེད་རང་ནས་སྨྲ་སེང་དང་དབྱངས་ཅན་མའི་ཐང་སྐུ་ཞིག་བཞེངས་དགོས་པ་ཡིན་ཞེས་བཀའ་ཕེབས།",
    "འདི་མི་ཤེས་པར་འདུག་ཟེར།",
    "དོན་འགྲུབ་ཅེས་པ་ས་ལུག་ལོ་ནས་བཟུང་རང་དགོན་དུ།",
    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོའི་ནོངས་པར་སྤྱད་པ་གང་མཆིས་པ།",
    "གསོ་སྦྱོང་ལེན་ཚུལ་དང་ཆོ་ག་དུས་གསུམ་དུ་འདོན་ཚུལ་སོགས་སྦྱོར་བའི་ཉིན་དང་འདྲ་ལ།",
    "འདི་སོགས་བླང་དོར་གང་ལའང་རང་ལ་གང་བདེ་གཙོ་བོར་བྱས་ནས་སྦགས་པའི་སྨྱུང་གནས་དེ་རང་ངལ་གྱི་རྒྱུ་ལས་མེད་པ་ཤེས་དགོས།",
    "དངོས་གཞིའི་ཉིན་སྨྱུང་གནས་ཞེས་པའི་ཐ་སྙད་སོ་སོར་སྦྱར་འདུག་བཞིན་འདིར་ཡང་བཀོད་པ་ལགས་ཀྱང་།",
    "འདི་སོགས་བླང་དོར་གང་ལའང་རང་ལ་གང་བདེ་གཙོ་བོར་བྱས་ནས་སྦགས་པའི་སྨྱུང་གནས་དེ་རང་ངལ་གྱི་རྒྱུ་ལས་མེད་པ་ཤེས་དགོས།",
    "བྱུང་ཡང་ཤིན་ཏུ་འཚེངས་འོས་ཚོད་དུ་གདའ།",
    "གལ་ཏེ་མི་འགྲོ་འཐས་པར་འདུག་སྲིད་ན།",
    "སོ་ཤིང་རང་རྟགས་བརྒྱན་པ་འདི།",
    "དུག་ལྔའི་འཁྲུལ་སྣང་རང་སར་དག་ནས་ཀྱང་།",
    "ཚོགས་བརྒྱད་འཁྲུལ་སྣང་རང་སར་དག་ནས་ཀྱང་།",
    "རང་རང་ལས་སྤྲུལ་ལྷ་ཚོགས་འཁོར་དང་བཅས།",
    "རང་རང་སྤྲུལ་བའི་འཁོར་ཚོགས་གྲངས་འདས་བཅས།",
    "རང་རང་ཆས་དང་ཕྱག་མཚན་ཡོངས་སུ་རྫོགས།",
    "ད་ལྟ་དེའི་ལན་ཆགས་བསྙག་ཏུ་འོང་བ་ཡིན་ཟེར་འདུག་སྟེ།",
    "དེ་ཡང་རང་རིག་དཀྱིལ་འཁོར་ལྷ་ལ་བཤགས།",
    "ཉེར་ཕུང་རང་དག་སྐྱེ་འཆིའི་ཁུངས་ཟད་ཅིང་།",
    "ཞེས་པ་འདི་ཡང་རང་སློབ་གཡུང་དྲུང་བསམ་གཏན་ནས་བསྐུལ་ངོར།",
    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོ་བའི།",
    "བཅས་དང་རང་བཞིན་ཁ་ན་མ་ཐོ་བའི།",
    "རྒྱལ་ཚབ་ལོ་ཆེན་བེ་རོ་ཙ་ན་ཡི།",
    "རྒྱལ་ཚབ་ལོ་ཙཱ་བེ་རོ་ཙ་ན་ཡི།",
    "འཆམ་སྟབས་ཀྱང་རང་རང་སོ་སོས་འཆམ་དཔོན་གྱི་ངག་ལྟར་ཉན་ཞིང་ཉམས་འོག་ཏུ་ཚུད་པར་བྱེད་པ་ལས།",
    "སྨྱུང་གནས་ངག་བཅད་སྔོན་དང་གདན་གཅིག་རྗེས་སུ་བྱེད་པ་ཡང་ཡོད་པར་སྣང་བ་སོགས་རྨོངས་པའི་རང་བཟོའི་བསླད་ཅི་རིགས་ཞུགས་འདུག་པ་དང་།",
    "བསྲུང་སྤེལ་བྱུང་ན་ཅི་མ་རུང་སྙམ་པའི་བློ་ཞིག་འདུག།",
    "དེའི་སྟེང་རང་ཉིད་དང་མ་བྱན་བཅས་བདུན་ཡོད།",
    "བ་སྤུའི་བུག་ཐམས་ཅད་ནས་འོད་ཟེར་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་དྲུག་ཅུ་དྲུག་ཅུ་དང་རང་བཞིན་གྱི་འོད་སྤྲོ་བ་དང་།",
    "བྱེད་དང་བྱེད་མིན་འོག་མིན་འགྲོ།",
    "འདི་ནི་སྐྱེ་བ་མེད་པ་ལ་སོགས་པ་དང་རང་བཞིན་གཅིག་ཉིད་ཡིན་ནོ།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའི་ཚེ།",
    "ཐ་དད་ཡིན་ཡང་རང་བཞིན་གྱིས།",
    "འདུག་ཀྱང་རུང་སྟེ་ཞེས་བྱ་བ་ནི་གཡུལ་དུ་འདུག་སྟེ།",
    "མི་མཐུན་པའི་ཕྱོགས་ཆུང་ངུའི་ཆུང་ངུ་ལ་གཉེན་པོའི་ཕྱོགས་ཆེན་པོའི་ཆེན་པོ་དང་ཡང་དག་པར་ལྡན་པས་གཡུལ་དུ་ལེགས་པར་འདུག་པའོ།",
    "དེར་འདུག་པ་ནི་དེའི་མཐའ་ལ་བརྟེན་པའོ།",
    "ག་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་ཡུལ་མ་ག་དྷཱ་ལ་སོགས་པ་གང་ན་གནས་པའོ།",
    "ལོ་ཆེན་བི་རོ་ཙ་ན་འཁྲུངས་པ་འི་ལོ།",
    "ལྕགས་ལུག་དུས་གསུམ་མཁྱེན་པ་པད་དཀར་འཆང་།",
    "ལྷག་དེ་རང་རང་གནས་སུ་བཞག།",
    "ལུགས་འདིར་ཁྱབ་བདག་དུས་འཁོར་ལོ།",
    "རང་རང་འཁོར་ལོ་གང་ལོངས་པ།",
    "ཡང་ལྷག་དུས་བསྒྱུར་བགོད་བྱེད་ཀྱིས།",
    "སྔ་དྷཱར་རང་རང་སྒྱུར་བྱེད་བྱིན།",
    "རང་རང་འཁོར་ལོས་དབྱུག་ལ་བསྒྲིལ།",
    "རང་རང་ཆུ་ཚོད་མན་ཆད་དུ།",
    "ལྔ་བསྡུས་སྣ་ཚོགསརང་རང་རྟག་ལོངས་བསྒྱུར་བྱས་ནས།",
    "རང་རང་ཚེས་ཞག་བར་པ་ལ།",
    "རང་རང་སྟེང་མར་སྟེར་བ་དང་།",
    "སྔ་རྒྱུར་རང་རང་སྒྱུར་བྱེད་བྱིན།",
    "རང་རང་འཁོར་གྲངས་ཀྱིས་བསྒྱུར་ལ།",
    "རང་རང་འཁོར་ལོས་བསྒྲིལ་བ་ཡིས།",
    "བསྒྱུར་ལ་རང་རང་རྩིས་འཕྲོ་བསྲེས།",
    "༡ ར་༥༤ ར་༧༧༥ ༡༤༤༢སྔ་རྒྱུར་རང་རང་སྒྱུར་བྱེད་བྱིན།",
    "འོག་ལྷག་དུས་གཟེར་བརྟག་གཞིར་བཟུང་།",
    "སྔ་སྒྱུར་རང་རང་སྒྱུར་བྱེད་བྱིན།",
    "སྔ་བྷུར་རང་རང་སྒྱུར་བྱེད་བྱིན།",
    "རང་རང་འཁོར་ལོས་དབྱུག་ལ་བསྒྲིལ།",
    "རང་རང་དཀྱིལ་འཁོར་ལོངས་ན་དོར།"
