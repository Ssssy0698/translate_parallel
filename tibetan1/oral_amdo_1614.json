    "རང་གི་ལུས་དང་སྡོམ་པའི་ཕྱིར།",
    "གཞན་དེ་དག་སྦྱིན་སོགས་ཀྱི་ཡོན་ཏན་དང་ལྡན་པ་ཞིག་ལན་དུ་རེ་བ་ནི།",
    "རེ་བ་མེད་པའི་སྦྱིན་པ་དང་།",
    "སྡོམ་ཚིག་གི་འབྲི་བ་ཞེས་པ་ནི།",
    "གང་ཟག་དུས་ཀྱི་བྱེ་བྲག་གིས།",
    "མོས་སྤྱོད་ཀྱི་སྒོམ་བྱུང་གི་ཤེས་རབ་ནི་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་རྗེས་སུ་མཐུན་པ་ཙམ་ཡོད་པས་ན་སྐུ་དང་བཅས་པའོ།",
    "གཉིས་པ་གང་གི་ཕྱིར་བཙལ་བའི་དགོས་པ་ནི།",
    "རྣམ་རྟོག་གཉེན་པོ་གང་གིས་སྤང་ཞེ་ན།",
    "གཟུགས་སོགས་རང་གི་ངོ་བོ་ཉིད་དུ་རྟོག་པའི་གཉེན་པོར།",
    "ཀུན་ནས་ཉོན་མོངས་པ་ཡང་མེད།",
    "གང་གི་ཕྱིར་བཙལ་བའི་དགོས་པ་དེ་ཉིད་ཀྱི་ཕྱིར་གཞན་དག་ལ་སྟོན་ནོ།",
    "ཕྲག་དོག་གིས་བདག་སྟོད་ཅིང་གཞན་ལ་སྨོད་པར་མི་བྱེད་པ་དང་།",
    "གཉིས་པ་གཞུང་གི་དོན་ལ་གཉིས་ཏེ།",
    "དེ་གཉིད་དུ་སོང་བའི་ཁ་ཆུ་ལ་བ་གླང་ལ་སོགས་པ་མང་པོས་ཆུ་ཡིན་སྙམ་ནས་རྒྱུགས་པས་ཁ་ཆུ་དེས་ཟིན་ཏེ་སད་པ་ན།",
