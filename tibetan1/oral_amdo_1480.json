    "དབུས་གཏེར་ལས་དབལ་གསས་དྲག་ཟློག་གི་རྒྱུད་སྟོང་རི་ཐོ་ཆེན་རྒྱས་འབྲིང་བསྡུས་གསུམ་དང་།",
    "ཀུན་སྐྱོབས་བྱམས་མ་ཆེན་མོའི་རྒྱུད་ལེའུ་བཅུ་གསུམ་པ་དང་།",
    "ཟང་ཟང་གི་གཏེར་བྱོན་མ་རྒྱུད་ཐུགས་རྗེ་ཉི་མའི་རྒྱུད་ལེའུ་པ་བཞུགས་སོ།",
    "ཉོན་མོངས་རང་གྲོལ་ཁྲ་གསས་ཀྱི་རྒྱུད་ལེའུ་པ་དང་།",
    "རྒྱ་མདུད་འཁྱིལ་བ་མཁའ་འགྱིང་གི་རྒྱུད་ལེའུ་པ་དང་།",
    "ཆུ་སྲིན་རྔམ་པ་བདུད་ནག་གི་རྒྱུད་ལེའུ་པ་དང་།",
    "དེ་ནས་གཏེར་དུ་མ་སོང་བའི་བོན་གཙང་མ་ཞང་ཞུང་གི་བོན་སྐོར་མེ་རི་བཀའ་མའི་སྐོར།",
    "མེ་རི་འཁྱིལ་པ་མན་ངག་གི་རྒྱུད་དང་།",
    "དབྱིལ་སྟོན་གྱི་གཏེར་ལུགས་མ་མོ་གསང་བ་ཡང་ཐིས་ཀྱི་རྒྱུད་ལེའུ་ཉེར་གཅིག་པ་དང་།",
    "མ་མོ་སྟག་རི་རོང་གི་རྒྱུད་རྣམས་བཅས་བཞུགས།",
    "མ་རྒྱུད་ཀྱི་ཚིག་གི་རྒྱུད་དང་དོན་རྒྱུད་དང་།",
    "དེ་ནས་ཤེས་རབ་སྐྱེ་བ་ཚིག་གི་བརྒྱུད་པ་ལ།",
    "ཉམས་སུ་མྱོང་བ་མན་ངག་གི་རྒྱུད་པ་ལ་མི་ཚིག་གི་ལྷད་མ་ཞུགས་པ་དང་།",
    "ལེགས་པར་གཟིགས་ཏེ་ཕྱི་རབས་པ་རྣམས་དཔྱད་པར་དགོས་སོ།",
    "གསང་བ་རིག་པ་གཅེར་མཐོང་གི་བཀའ་ལ།",
    "དེའི་རྒྱ་ཆེའི་འགྲེལ་ལྡེ་བོན་གྱིམ་ཚ་རྨ་ཆུང་གིས་མཛད་པ་གཏེར་ཁ་འདྲ་མིན་གཉིས་བཅས་རྩ་འགྲེལ་འདི་གཉིས་དབུར་གཞུག་ན།",
    "ལྷ་རབས་འོད་དཀར་གྱི་སྲས་པོ་ལྷ་གཤེན་ཡོངས་དག་གིས་མཛད་པའི།",
    "བྱང་གཏེར་ལས་ཐོན་པ་བླ་ཆེན་དྲན་པ་ནམ་མཁས་མཛད་པའི་མཛོད་སྒྲ་འགྲེལ་ཆེན་མོ་དང་།",
    "དེའི་ཐལ་འཕྲེང་རྒྱལ་ཚབ་རིན་ཆེན་རྒྱལ་མཚན་གྱིས་མཛད་པ་རྣམས་སོ།",
    "སྨོན་འཇུག་ཆེན་མོ་བྱ་བ་ཡོད་པར་གསུངས་ཀྱང་།",
    "འབུམ་ཏིག་གི་དགོངས་དོན་མཁས་གྲུབ་ཡེ་ཤེས་རྒྱལ་མཚན་གྱིས་མཛད་པ་ས་ལམ་རྣམ་འབྱེད་ཉི་འོད་ཅེས་པ་དང་།",
    "ལམ་རིམ་ཆེན་མོ་སུམ་བརྒྱ་པ་དང་།",
    "ལྡེ་བོན་གྱིམ་ཚ་རྨ་ཆུང་གིས་མཛད་པའི་རྣམ་རྒྱལ་རྩ་སྒྲུབ་དང་སྟོང་མཆོད།",
    "ཡང་རྨ་གཏེར་གྱི་བོན་སྤྱི་ཁོག་ཆེན་མོ་རྒྱས་པ་ཀུན་སྣང་ཁྱབ་པའི་གཞུང་བླ་ཆེན་དྲན་པས་བསྒྲིགས་པ་དང་།",
    "སྟོང་རྒྱུང་གིས་མཛད་པའི་ས་ཚྭ་རབ་གནས་དང་།",
    "ས་བདག་བཅོས་པའི་བོན་སྐོར་རྒྱས་པ་གཏེར་དུ་མ་སོང་བ་སྟོང་གསུམ་འཁྲུགས་པ་ཡོ་བཅོས་བྱ་བའི་སྐོར་དང་།",
    "དེ་དག་གི་ཆ་ལག་གདོན་བཀྲོལ་ཞགས་བཀྲོལ་གཡང་སྐྱབས་སྲིད་སྤེལ།",
    "ཀླུ་གཉན་ས་བདག་གི་སྤང་སྐོང་རྣམས་དང་།",
    "ཆུང་གིས་རྙེད་པའི་ཆར་འབེབས་ཡོངས་དག་མའི་སྐོར་རྣམས་བཞུགས་སོ།",
    "སྟོང་རྒྱུང་གིས་སྟོང་ཐུས་གསང་བ་དོན་འགྲེལ་ས་བཅད་བཅས་པ་དང་།",
    "སྤྱི་སྤུངས་རྩ་བ་ཡན་ལག་གི་བཀའ་ལས།",
    "ལྷ་ཀླུ་མིའི་གཤེན་གསུམ་གྱིས་བསྒྲིགས་པའི་ཁྲོ་གཞུང་ཆེན་མོ་ངོ་མཚར་རྒྱས་པ་དང་།",
    "དེ་དག་གི་མངོན་རྟོགས་བདག་ཉིད་དོན་གྲུབ།",
    "རྨ་དབྱིལ་གཉིས་ཀྱི་གཏེར་ལུང་དབལ་མོ་ལས་ཐིག་ཆེན་མོའི་སྐོར་ལ་ལེའུ་སོ་གཅིག་པ་དང་།",
    "སྤ་གྲོའི་གཏེར་ལུགས་ངོ་མཚར་རྒྱས་ཟློག་གི་སྐོར་རྣམས་དང་།",
    "སྙན་བརྒྱུད་ལྡེ་མིག་གི་སྐོར་ནི།",
    "དབལ་གསས་དྲག་བཟློག་གི་སྒྲུབ་གཞུང་རྣམས་དང་།",
    "དེ་དག་གི་ཆ་ལག་ནི།",
    "སེང་གེ་དགྲ་བཟློག་གི་སྐོར།",
    "དབལ་གསས་རྔམ་ཟློག་གི་སྐོར་དང་།",
    "དྲག་ཟློག་ཆེ་ཆུང་གི་སྐོར་དང་།",
    "དམ་པ་རང་གྲོལ་གྱི་སྙན་བརྒྱུད་དབལ་གསས་འབན་བཟློག་གི་སྐོར་དང་།",
    "ཀླུ་གྲུབ་ཀྱིས་མཛད་པ་དབལ་གསས་ཁྱུང་ནག་གི་སྐོར་དང་།",
    "ཡང་བློ་ལྡན་གྱི་སྙན་བརྒྱུད་དབལ་གསས་རྩོད་ཟློག་གི་ལེའུ་དྲུག་ཅུ་རེ་བཞི་ཡོད་པའི་སྐོར་དང་།",
    "དབལ་ཕུར་ནག་པོ་སྲོག་ལེན་དང་གསུམ་མོ།",
    "མེ་ལྕེ་འབར་བ་སྦྱིན་སྲེག་གི་ལས་སྦྱོར་དང་།",
    "འཁོར་ལོ་བཞི་སྦྲག་མནན་པའི་ལས་སྦྱོར་དང་གསུམ་མོ།",
    "ནམ་མཁའི་ཁྲ་ཁྱུང་ཕོ་ཉ་སྤྱིའི་སྒྲུབ་ཐབས་དང་གཅིག་ཁྲ་བདུད་ཆེན་མོ་ཆོ་འཕྲུལ་གྱི་ལྷ་ལྔའི་སྒོས་སྒྲུབ་ཏུ་སྒྲུབ་པ་དང་གཉིས།",
    "བདུད་མོ་དཔོན་གཡོག་བླ་རྐུན་ཡིད་འཕྲོག་མའི་སྒྲུབ་པ་དང་དྲུག་ཉུང་དཀར་རྒྱལ་པོ་ཕོ་ཉའི་སྒྲུབ་པ་དང་བདུན་ནོ།",
    "རི་རབ་རྩེ་མོའི་ཁ་བདུད་ལྕམ་དྲལ་གྱི་སྒྲུབ་པ་དང་ལྔ།",
    "ཐིག་ལེ་ནག་པོ་ལྕམ་དྲལ་གྱི་སྒྲུབ་ཐབས་དང་གཅིག་ཐིག་ལེ་གཙོ་མོ་ཕུང་བྱེད་མ་བདུན་གྱི་སྒྲུབ་ཐབས་དང་གཉིས།",
    "མ་བདུད་ནག་མོ་མིང་སྲིང་གི་སྒྲུབ་ཐབས་དང་བཞི།",
    "མི་བཟད་དྲེགས་པའི་བུ་བདུན་འཇིག་རྟེན་ཕུང་བྱེད་ཀྱི་སྒྲུབ་པ་དང་དྲུག་དྲེགས་པ་ཉི་ཤུ་རྩ་གཅིག་གི་སྒྲུབ་པ་དང་བདུན་ནོ།",
    "འགྱེད་པ་ཕོ་ཉའི་སྒྲུབ་ཐབས་བདུན་གྱི་ནང་ནས་བདུད་མོ་བླ་རྐུན་ཡིད་འཕྲོག་མ་དཔོན་གཡོག་གི་སྒྲུབ་ཐབས་རྣོ་རུ་ཕྱུངས་པའོ།",
    "ནམ་མཁའི་ཁྲ་ཁྱུང་གི་འཁོར་ལོ་སྤྱི་བདུད་སྲོག་གཅོད།",
    "མན་ངག་ཐུགས་ཀྱི་བརྣག་པ་ཡང་གསང་གི་དོན་སྐོར་ལ།",
    "སྟོང་ཁྱབ་ནག་མོ་སྐྱེ་འགྲོ་ཟ་བྱེད་ཀྱི་སྒྲུབ་ཐབས་དང་།",
    "དེ་ནས་གཏེར་དུ་མ་སོང་བ་མེ་རི་བཀའ་མའི་སྐོར་དུ་གྲགས་པ་ལ།",
