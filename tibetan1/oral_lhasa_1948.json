    "རྣམ་པར་ཤེས་པ་རྟག་ཅེས་བྱ་བ་འམ་མྱི་རྟག་ཅེས་བྱ་བ་མྱི་དམྱིགས་སོ།",
    "དེ་ལ་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་མྱེད་ན་རྟག་པ་འམ་མྱི་རྟག་པ་ལྟ་ག་ལ་ཡོད་ཅེས་སྟོན་ཏེ།",
    "མྱིང་དང་གཟུགས་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "སྐྱེ་མཆེད་དྲུག་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ཚོར་བ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "སྲེད་པ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ལེན་པ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "སྲིད་པ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "སྐྱེ་བ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "རྒ་ཤི་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ནང་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ཕྱི་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་མི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ནི་རང་བཞིན་གྱིས་སྟོང་སྟེ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་གང་ཡིན་པ་དེ་ནི་དངོས་པོ་མྱེད་པའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་གང་ཡིན་པ་དེ་ལ་ནི་འདུས་བྱས་སྟོང་པ་ཉིད་རྟག་ཅེས་བྱ་བ་འམ་མྱི་རྟག་ཅེས་བྱ་བ་མྱི་དམྱིགས་སོ།",
    "དེ་ལ་འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་མྱེད་ན་རྟག་པ་འམ་མྱི་རྟག་པ་ལྟ་ག་ལ་ཡོད་ཅེས་སྟོན་ཏེ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ནི་རང་བཞིན་གྱིས་སྟོང་སྟེ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་གང་ཡིན་པ་དེ་ནི་དངོས་པོ་མྱེད་པའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་གང་ཡིན་པ་དེ་ལ་ནི་འདུས་མ་བྱས་སྟོང་པ་ཉིད་རྟག་ཅེས་བྱ་བ་འམ་མྱི་རྟག་ཅེས་བྱ་བ་མྱི་དམྱིགས་སོ།",
    "དེ་ལ་འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱང་མྱེད་ན་རྟག་པ་འམ་མྱི་རྟག་པ་ལྟ་ག་ལ་ཡོད་ཅེས་སྟོན་ཏེ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "ཡང་དག་པར་སྤོང་བ་རྣམས་ནི་རང་བཞིན་གྱིས་སྟོང་སྟེ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་གང་ཡིན་པ་དེ་ལ་ནི་ཡང་དག་པར་སྤོང་བ་རྣམས་རྟག་ཅེས་བྱ་བ་འམ་མྱི་རྟག་ཅེས་བྱ་བ་མྱི་དམྱིགས་སོ།",
    "དེ་ལ་ཡང་དག་པར་སྤོང་བ་ཉིད་ཀྱང་མྱེད་ན་རྟག་པ་འམ་མྱི་རྟག་པ་ལྟ་ག་ལ་ཡོད་ཅེས་སྟོན་ཏེ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་རྣམས་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "སྟོབས་རྣམས་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "འཕགས་པའི་བདེན་པ་རྣམས་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "བསམ་གཏན་རྣམས་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་མྱི་རྟག་ཅེས་བྱ་བར་ཡང་དག་པར་རྗེས་སུ་མ་ལྟ་ཤིག།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ནི་རང་བཞིན་གྱིས་སྟོང་སྟེ།",
