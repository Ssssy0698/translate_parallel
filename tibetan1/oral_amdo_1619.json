    "གང་གི་ཕྱིར་གནོད་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་མེད་པ་ཉིད་དོ།",
    "གལ་ཏེ་དེ་མི་སྐྱེས་ན་དངོས་པོ་མེད་པ་ཡིན་པས་གང་གིས་དེ་མེད་པར་བྱེད་དེ།",
    "འདི་ལྟར་གང་གི་ཚེ་དུས་གཞན་དུ་གནས་པར་བརྟགས་པའི་དངོས་པོའི་དེའི་ཚེ་དུས་ཀྱི་བར་ཉིད་དུ་གཞན་གྱི་རང་བཞིན་ངེས་པར་བརྟགས་པ་ལྷུར་ལེན་པའི་ཤེས་པ་བྱུང་བ་དེའི་ཚེ་སྔར་གྱི་རྟོགས་པའི་ཡུལ་དེས་རྣམ་པར་བཅད་པ་ནི་གནོད་པར་ཞེན་པའི་ཡུལ་ཡིན་ནོ།",
    "རེ་ཞིག་ལྐོག་ཏུ་གྱུར་པ་ཡོད་དོ་ཞེས་ལུང་འགའ་ཞིག་གམ་རྗེས་སུ་དཔག་པ་ལས་ངེས་པ་ཡིན་ནོ།",
    "མ་ཡིན་མངོན་སུམ་རྗེས་དཔག་གིས།",
    "རེ་ཞིག་མངོན་སུམ་གྱིས་ནི་ལྐོག་ཏུ་གྱུར་པ་ཡོད་པར་རྟོགས་པ་མ་ཡིན་ནོ།",
    "ང་འམ་ཁྱོད་ཀྱིས་སྔར་རྟོགས་པ།",
    "མེད་ན་མེད་ཉིད་གང་གིས་ན།",
    "རང་ཉིད་རྟོགས་ན་གང་གིས་ན།",
    "གང་གི་ཚེ་འཁྲུལ་པ་སྲིད་པ་ན་རང་ཉིད་རྣམ་པར་རྟོག་པ་དང་ལྡན་པས་འདི་ནི་དངུལ་མ་ཡིན་ཞེས་དེ་སླར་ལོག་པ་དེའི་ཚེ།",
    "གང་གིས་ངའི་ཕྱོགས་སྐྱོན་མེད་པར་འགྱུར་བ་ཇི་ལྟར་ན་དངུལ་མ་རྟོགས་པར་དེའི་ཁྱད་པར་ཅན་དངོས་པོ་མེད་པ་རྟོགས་པར་འགྱུར་བའི་ཁྱད་པར་རབ་ཏུ་མ་གྲུབ་ན་ཡང་དེའི་ཁྱད་པར་ཅན་ལྐོག་ཏུ་གྱུར་པ་ཇི་ལྟར་ཤེས་པ་ཡིན།",
    "དེ་ལྟ་མ་ཡིན་ན་ཁྱེད་ཅག་གི་ཐམས་ཅད་འཁྲུལ་པར་འགྱུར་རོ།",
    "ཡོད་མོད་ཇི་ལྟར་རྟོགས་བྱ་སྟེ།",
    "རང་བཞིན་གང་གིས་དེ་འཁྲུལ་པ་ཡིན་པའི་རང་བཞིན་དེ་ཤེས་པ་ཉིད་ཀྱིས་རྣམ་པར་གཞག་པ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོས་དངོས་པོར་འགྱུར་བ་ཡིན་གྱི།",
    "རང་གི་ངོ་བོ་དེ་ག་ལས་ཡིན་ཞེ་ན།",
    "འཁྲུལ་པའི་རང་གི་ངོ་བོ་རྟོགས་པ་དེ་ཡང་འཁྲུལ་པ་མ་ཡིན་པར་ག་ལས་ཡིན་ཞེ་ན།",
    "གལ་ཏེ་འདི་རྟོགས་པ་དེ་ལྟར་དེ་ཡང་ཡིན་ན་ཡིན་མོད་ཅི་ཞིག་སྐྱོན།",
    "ངོ་བོ་གང་གིས་རྟོགས་པར་བྱེད།",
    "རྣམ་པར་ཤེས་པ་དམིགས་པ་མེད་པ་ཡིན་ནོ་ཞེས་གང་གིས་དམིགས་པ་མེད་པ་ཉིད་བསྒྲུབ་པར་བྱ་བར་ཞུགས་པ་དེ་ལ་ཇི་ལྟར་དེ་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཡིན་ནོ་ཞེས་ཉེ་བར་དགོད་པར་བྱ་བ་ཡིན།",
    "གང་ཞིག་གིས་གང་བསྒྲུབ་པར་འདོད་པ་དེ་ཉིད་ཕྱོགས་ཡིན་ནོ།",
    "གླང་པོ་ཆེའི་ལྟ་སྟངས་ཀྱིས་རེ་ཞིག་ཐ་སྙད་འདི་འཇུག་པ་ཡིན་ལ།",
    "རེ་ཞིག་སྣང་བའི་རང་བཞིན་མེད་དོ་ཞེས་བྱ་བར་ནི་མི་རིགས་སོ།",
    "དེས་ན་རེ་ཞིག་འདི་གཞག་སྟེ།",
    "རང་གི་ཆ་ལ་གནས་པ་ཉིད།",
    "འགྱུར་བ་གང་གིས་ཟློག་པར་བྱེད།",
    "ཁྱོད་ཀྱིས་སྒྲུབ་བྱེད་སྦྱོར་བ་ནི།",
    "གལ་ཏེ་རྣམ་པ་འགའ་ཞིག་གིས་ཐ་དད་ན་ཡང་གཏན་ཐ་དད་པ་ཉིད་དེ།",
    "དེས་དམིགས་པ་མེད་ན་རང་གི་ཆ་ལ་དམིགས་པ་འབའ་ཞིག་ཏུ་ཟད་པ་དེས་ན་ཇི་ལྟར་གྲུབ་པ་སྒྲུབ་པ་ཉིད་ཡིན།",
    "ཤེས་པའི་རྣམ་པ་ཉིད་ཀྱིས་གཟུང་བ་ཐ་དད་པ་མེད་ན་ནང་གི་བྱེ་བྲག་ཏུ་འགྱུར་མོད།",
    "དེའི་ཕྱིར་འཛིན་པ་ལ་སོགས་པའི་ཐ་སྙད་ནི་མ་རུངས་པའི་བདག་ཉིད་རང་འདོད་ཀྱིས་བསླུས་པ་དག་གིས་ཉེ་བར་བཀོད་པ་ཡིན་ནོ།",
    "གང་གིས་སྒྲུབ་པར་བྱེད་པ་དོན་མེད་པར་འགྱུར་བ།",
    "ཉེས་ལྡན་དེ་ཉིད་མི་ཤེས་ཉོན་མོང་གིས།",
    "འཐབ་བྲལ་བུད་མེད་དམངས་རིགས་མཚར་སྐྱེད་པ།",
    "ངས་རང་གི་སྣང་བ་ཉིད་འབའ་ཞིག་རྟོགས་སོ་སྙམ་པའི་རྟོགས་པ་ལ་གཞན་གྱི་རྟོགས་པས་གནོད་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "རྟོགས་པར་བྱེད་པ་རྣམས་ལ་ཡང་རང་གི་ཆ་ཙམ་ལས་གཞན་མེད་དོ་སྙམ་པའི་རྟོགས་པ་དམིགས་པ་མེད་པར་བརྗོད་པའི་ཚིག་ལས་རྟོགས་པ་ཡོད་པ་ཡིན་ནོ།",
    "གཅིག་ལ་རེ་རེར་རྟོགས་པའི་ཕྱིར།",
    "གང་གི་ཕྱིར་ནི་དེ་གཉིས་ཀྱང་།",
    "རང་གི་བློས་ངེས་པར་རྟོགས་པར་བྱེད་པ་དེ་དག་གི་དེ་ཡོངས་སུ་དག་པར་འགྱུར་བས་དེར་གཏན་ཚིགས་ཁས་མ་བླངས་པ་ཇི་ལྟར་ཡིན།",
    "ཕྱོགས་ལ་གནོད་པར་ཐལ་བ་ཡིན།",
    "འབྲས་བུ་མེད་པར་ཐལ་བར་འགྱུར།",
    "བྱིས་པའི་རྩེད་མོ་བཞིན་དུ་འདོད།",
    "གང་གི་ཚེ་གྲོལ་བ་དེའི་ཚེ་ནི་དེ་ལ་འགས་ཀྱང་དོགས་པ་མེད་དོ།"
  ]
}