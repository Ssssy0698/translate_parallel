    "མ་བདུད་མོ་ཁྲག་རལ་གཤོས་པའི་བུ།",
    "དུར་ཁྲོད་ཆེན་པོ་གཏུམ་དྲག་གི་ཚལ།",
    "རྒྱུད་དེ་དག་གི་ནང་ནས།",
    "གསང་བ་དྲག་སྔགས་གནམ་ཐོག་ཆེན་པོ་འདི་དང་གསུམ་དམོད་པའི་ལས་གསུམ་དུ་གྲགས་ཤིང་།",
    "མཐུ་སྟོབས་མེ་དཔུང་གི་ཚམ་རྔམ་མང་དུ་ངོམ།",
    "གང་གི་ཞལ་སྔ་ནས་བཀའ་དྲིན་ཆེན་པོས་བདག་ལ་སྩལ་བ་སྟེ།",
    "ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏས་བསངས།",
    "མཆེ་བ་བཞི་བཞི་གཙིགས་ཤིང་ལྗགས་ལ་ཁྲག་གི་རྒྱ་མཚོ་རྦ་ཀློང་འཁྲུགས་པ།",
    "ཕྱག་དྲུག་གིས་གཡས་པ་གསུམ་ན་འཁོར་ལོ།",
    "དཔྲལ་བར་ཐལ་ཆེན་གྱི་ཚོམ་བུ།",
    "བྲང་གི་འཛོམས་སུ་ཞག་གི་སོར་རིས་རྩེ་གསུམ་གྱི་དབྱིབས་སུ་བྲིས་ཤིང་།",
    "མགྲིན་པར་པདྨ་དམར་པོ་འདབ་བརྒྱད་དབུས་སུ་གསུང་གི་ཁྲོ་བོར་རྟ་མཆོག་རོལ་པ་དམར་ནག་འཁོར་ལོ་དང་རྡོ་རྗེའི་ཞགས་པ་ཅན།",
    "དེ་དག་ལ་དམིགས་ནས་འཁོར་འདས་ཀུན་བཟང་གི་མཆོད་སྤྲིན་ཏུ་བསམ་ནས་ཕུལ་བར་གྱུར།",
    "ཕྱག་རྒྱ་ཟིལ་གནོན་མཆོག་གི་ལམ།",
    "ཐུགས་ཀྱི་ནུས་པ་སྟེར་བ་ཕྱག་མཚན་དྲུག་གཏད་པའི་ཚེ་མོས་པ་འདི་བཞིན་མཛོད།",
    "ཉོན་མོངས་གཅོད་བྱེད་རལ་གྲི་དང་།",
    "དེ་དག་ཐམས་ཅད་བདག་གིས་བགྱི།",
    "སྐུ་དྲིན་གཏང་རག་གི་སླད་དུ་དངོས་དང་ཡིད་ལས་བྱུང་བའི་སྣོད་བཅུད་ཞིང་གི་བཀོད་པའི་མཎྜལ་འབུལ་བར་ཞུ།",
    "ཡ་ཧི་གཙྪས་རང་གནས་སུ་གཤེགས་པར་བསམ་མོ།",
    "ཕྱི་མཆོད་ནང་གི་བདུད་རྩི་རཀྟའི་བཅུད།",
    "མ་ཧཱ་པཉྩ་ཨ་མྲྀ་ཏ་རཀྟ་བ་ལིངྟ་ཁཱ་ཧཱི།",
    "ཨོཾ་ཡ་མནྟ་ཀ་ས་མ་ཡ་སཏྭ་ཨ་མདུན་བསྐྱེད་ཀྱི་ལྷ་རྣམས།",
    "ཐལ་བར་བརླག་མཛད་འཇམ་དཔལ་ཁྲོ་བོའི་རྒྱལ།",
    "ནམ་མཁའི་དབྱིངས་སུ་མཐིང་གི་བྱ་ར་དགྲམ་པ།",
    "བར་སྣང་གི་ཁམས་སུ་སྦྱོར་བའི་སྟོབས་བཤིག་པ།",
    "རང་གི་མདུན་དུ་གཤིན་རྗེ་གཤེད་ཀྱི་བྲིས་སྐུ་རབ་གནས་ཅན་བཀྲམ་པའི་མདུན་དུ་སྟེགས་བུར་དར་རམ་རས་བཟང་པོས་བཀབ་པའི་ཁར།",
    "ཐོད་པ་མེ་ཏོག་གི་སྣོད་དང་བཅས་པ་བཞག་གཞན་ཡང་གཞི་བགེགས་ཀྱི་གཏོར་མ།"
  ]
