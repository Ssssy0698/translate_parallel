    "དངོས་གྲུབ་ཀྱི་ཚུལ་དེ་འོ་ཟངས་ཀྱི་འོ་མ་ལུད་པ་བཞིན་བུན་ཆིལ་ཆིལ་བྱུང་བ་དེ་ཉིད་བོ་ཟག་ཅུང་ཟད་ཀྱང་མེད་པར་ཁྱེད་རང་རྣམས་ཀྱི་དབུ་གཙུག་ཚངས་པའི་སྒོ་ནས་ཞུགས།",
    "གཞི་གནས་ཀྱི་བདུད་རྩི་དང་འདྲེས་དངོས་གྲུབ་ཀྱི་ཚུལ་དུ་འོ་ཟངས་ཀྱི་འོ་མ་ལུད་པ་བཞིན་བུན་ཆིལ་ཆིལ་བྱུང་བ་དེ་ཉིད་བོ་ཟག་ཅུང་ཟད་ཀྱང་མེད་པར་ཁྱེད་རང་རྣམས་ཀྱི་དབུ་གཙུག་ཚངས་པའི་སྒོ་ནས་ཞུགས།",
    "དངོས་གྲུབ་ཀྱི་ཚུལ་དུ་འོ་ཟངས་གྱི་འོ་མ་ལུད་པ་བཞིན་བུན་ཆིལ་ཆིལ་བྱུང་བ་དེ་ཉིད་བོ་ཟག་ཅུང་ཟད་ཀྱང་མེད་པར་ཁྱེད་རང་རྣམས་ཀྱི་དབུ་གཙུག་ཚངས་པའི་སྒོ་ནས་ཞུགས།",
    "དངོས་གྲུབ་ཀྱི་ཚུལ་དུ་འོ་ཟངས་ཀྱི་འོ་མ་ལུད་པ་བཞིན་བུན་ཆིལ་ཆིལ་བྱུང་བ་དེ་ཉིད་བོ་ཟག་ཅུང་ཟད་ཀྱང་མེད་པར་ཁྱེད་རང་རྣམས་ཀྱི་དབུ་གཙུག་ཚངས་པའི་སྒོ་ནས་། ཞུགས།",
    "དངོས་གྲུབ་ཀྱི་ཚུལ་དུ་འོ་ཟངས་ཀྱི་འོ་མ་ལུད་པ་བཞིན་བུན་ཆིལ་ཆིལ་བྱུང་བ་དེ་ཉིད་བོ་ཟག་ཅུང་ཟད་ཀྱང་མེད་པར་ཁྱེད་རང་རྣམས་ཀྱི་དབུ་གཙུག་ཚངས་པའི་སྒོ་ནས་ཞུགས།",
    "གཞི་གནས་ཀྱི་བདུད་རྩི་དང་འདྲེས་དངོས་གྲུབ་ཀྱི་ཚུལ་དུ་འོ་ཟངས་ཀྱི་འོ་མ་ལུད་པ་བཞིན་བུན་ཆིལ་ཆིལ་བྱུང་བ་དེ་ཉིད་བོ་ཟག་ཅུང་ཟད་ཀྱང་མེད་པར་ཁྱེད་རང་རྣམས་ཀྱི་དབུ་གཙུག་ཚངས་པའི་སྒོ་ནས་ཞུགས།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དབུ་གཙུག་ཚངས་པའི་སྒོ་ནས་ཞུགས།",
    "བླ་ན་མེད་པ་གོང་ན་མ་མཆིས་པའི་ཚེ་ཡི་གྲུབ་པ་འདུག་ས་འདི་ཉིད་དུ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ངོ་སྐལ་དུ་གྱུར་པ་ལ།",
    "ཁྱེད་རང་རྣམས་ཀྱང་སྐད་ཅིག་དྲན་རྫོགས་ལ།",
    "ཁྱེད་རང་རྣམས་ཀྱི། མགྲིན་པར་ཐིམ་པར་སྒོམས་ཤིག་གཏོར་མ་ཐོགས་ལ་དབྱངས་དང་བཅས།",
    "འོད་ཟེར་དཀར་དམར་མཐིང་སེར་ལྗང་གུ་ལྔ་འཕྲོས་ནས་ཁྱེད་རང་རྣམས་ཀྱི་གནས་ལྔར་ཐིམ་པར་སྒོམས་ཤིག་གཏོར་མ་བཟུང་དབྱངས་དང་བཅས།",
    "རང་ཉིད་འདུག་པའི་ས་ཕྱོགས་གནས་ཁང་དག་པའི་གཞལ་མེད་ཁང་འཇའ་ཟེར་འོད་ཕུང་འཁྲིགས་པའི་ཀློང་དུ།",
    "ཞེས་སོགས་ཀྱིས་ཕུལ་མཐར་ཚོགས་ཞིང་རང་ལ་བསྟིམ།",
    "མཐར་སྐྱབས་ཞིང་རང་ལ་བསྟིམ།",
    "དེ་ནས་འདུག་རྒྱུ་ཡོང་མི་ཡོང་བརྟགས་ནས།",
    "འདུགལུགས་དང་སྒྲུབ་པ་ཁ་བསྒྱུར་ཨེ་དགོས་གཞི་ནས་ལྟ་བའི་འཕྲོས་ད་ལམ་བསྙེན་སྒྲུབ་འདིར་རྗེས་འཕྲིན་ལས་བཞི་སྒྲུབ་སོགས་བྱ་བར་གསུངས་ཀྱང་།",
    "བློ་དམན་ཉམ་ཆུང་རང་འདྲའི་གསལ་འདེབས་བཀོད།",
    "འཇམ་པའི་སྟན་ལ་པདྨའི་འདུག་སྟངས་ཀྱིས་ཁ་ཤར་དུ་ཕྱོགས་པས་ཞི་བའི་སེམས་ཀྱིས་མེ་ཐབ་དང་ཞལ་སྤྲོད་དུ་འཁོད་དོ།",
    "མི་འགྲོ་གནས་འདིར་འདུག་ན་རྡུལ་དུ་བརླག།",
    "སྐབས་འདིར་དྲག་སེང་གཉིས་ལ་སྦྱིན་སྲེག་སོ་སོར་འབུལ་བའི་ཕྱག་སྲོལ་ཡང་འདུག་པ་སྤྱིར་དེ་གཉིས་གུ་རུ་ཞི་བའི་རྣམ་འགྱུར་ཡིན་པས་དེ་ལ་མ་འདུས་པ་མེད་ཅིང་།",
    "སློབ་དཔོན་ཆས་རྒྱན་སེར་པོ་བརྗིད་པའི་གདན་ལ་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་ཁ་བྱང་དུ་ཕྱོགས་ནས་ཚིམ་པའི་བསམ་པས་འཁོད།",
    "རོ་གཅིག་འདུག་གོ་ཟེར་ནས་གཞན་གླེང་བར་འགྱུར་ཏེ",
    "རབ་ཏུ་དོགས་པ་མུན་ནག་འཐིབ་པོར་འདུག་པ་ཡི",
    "ཡོ་ག་གསུམ་གྱི་དགོངས་བཅུད་ཕྱུང་བ་ཡང་གསང་རྫོགས་པ་ཆེན་པོའི་མན་ ། ངག་དུས་གསུམ་རྒྱལ་བ་ཐམས་ཅད་ཀྱི་བགྲོད་པ་གཅིག་པའི་ལམ།",
    "ཕྱི་སྒྲུབ་མིང་དུ་བཏགས་པ་ཙམ་དོན་ལ་བྱིན་འབེབས་ཡིན་འདུག་གོ།",
    "ཚུལ་འདི་གནས་སྐབས་འདིར་རྒྱས་པར་སྨོས་མ་དགོས་ཀྱང་རྒྱུད་ཀྱི་ཡང་འགྲེལ་དུ་བསྐྱེད་རིམ་གྱི་ཟབ་ཁྲིད་འཕྲོས་སུ་གནང་འདུག་པ་བཞིན་སྐབས་འདིར་ཡང་ས་བཅད་ཚུལ་དུ་བཟློག་དམིགས་ཀྱི་ཞར་བྱུང་དུ་དེསྨོས་པ་སྟེ་དམིགས་ཐུན་གསུམ་པའོ།",
    "ཞབས་རྒྱལ་པོ་རོལ་པའི་འདུག་སྟངས་ཀྱིས།",
    "པདྨ་འབྱུང་གནས་ཀྱང་རང་སེམས་ཀྱི་མདངས་ཆ་ཡིན་ཏེ",
    "ནང་རང་ལུས་ཀྱི་སྟོད་སྨད་བར་གསུམ་གང་ལས་བྱུང་སྟོང་པ་ལས་བྱུང་སྙམ་ན་བྱུང་ལུགས་ལ་དཔྱད།",
    "སྟོང་པའོ་སྙམ་དུའང་མི་འཛིན་པར་རང་བྱུང་རང་གསལ་གྱི་རིག་པ་གསལ་སྟོང་རྗེན་པ་ཉིད་བཟོ་མེད་རང་བབ་ཏུ་བསྐྱང་།",
    "དེའང་གཞིའི་ངོ་བོ་ཀ་ནས་དག་ཅིང་རང་བཞིན་ལྷུན་གྱིས་གྲུབ་པ་སྐུ་དང་ཡེ་ཤེས་འདུ་འབྲལ་མེད་པའི་དགོངས་པར་གནས་པ་སྟེ།",
    "སྟན་ཐོག་ཏུ་ཙོག་པུར་འདུག་པའི་རྐང་པའི་ལོང་བུ་གཉིས་གཤིབས།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "ད་ལྟའི་སྐབས་ཀྱང་མི་རྣམས་རྒན་གཞོན་བར་མའི་གོ་རིམ་མ་ངེས་པར་འཕྲལ་འཕྲལ་དུ་ཤི་ཡི་འདུག་པ་བཞིན་རང་ལ་ཡང་མི་ཡོང་བའི་ངེས་པ་མེད་དེ།",
    "དེ་ཡང་རང་གཅིག་པུ་ཐར་བས་མི་ཕན།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལོངས་སྤྱོད་དུས་གསུམ་གྱི་དགེ་ཚོགས་དང་བཅས་པ་ཐམས་ཅད་ཀུན་ཏུ་བཟང་པོའི་མཆོད་སྤྲིན་ལྟར་དམིགས་ཏེ་འབུལ་སྙམ་པས་མཎྜལ་འབུལ་བར་མཛོད།",
    "མདུན་དུ་དལ་བར་འདུག་པ་དང་།",
    "སྔགས་ཀྱིས་བཏབ་པའི་ཡུངས་ཀར་དང་གུ་གུལ་གྱི་དུད་པས་བདུག་སློབ་དཔོན་གྱིས་འདི་ལྟར་རྡོ་རྗེ་རྩེ་ལྔ་པའི་ཕྱག་རྒྱ་བཅིངས་པ་ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོར་བཞག་ཅིང་གཟུངས་ལན་གསུམ་བཟླས་པ་འདིས།",
    "ཁྱེད་རང་རྣམས་ཨོཾ་བཛྲ་ཡཀྵ་ཧཱུྃ་ཞེས་ལས་ཐམས་ཅད་བཟླས་ཤིང་བཏབ་པའི་ཀུ་ཤའི་སྟན་མ་འཁྲུགས་པ་ལ་འདུག་པ་དེ་ཉིད།",
    "ད་ལམ་བཅོམ་ལྡན་འདས་རྡོ་རྗེ་མི་འཁྲུགས་པའི་འཕྲིན་ལས་ཀྱི་ལྷ་རྡོ་རྗེ་གནོད་སྦྱིན་ནག་པོའི་སྐུ་ལས་བབས་པའི་ཡེ་ཤེས་ཀྱི་བདུད་རྩིས་ཁྱེད་རང་རྣམས་ལ་བསང་གཏོར་བྱས་མ་ཐག་ཏུ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་ཕུང་པོ་ཁམས་དང་སྐྱེ་མཆེད་རྣམས་མི་དམིགས་ཏེ་སྟོང་པ་ཉིད་དུ་གྱུར།",
    "འདི་ལྟར་སྔར་ནམ་མཁར་བཞུགས་པའི་དཀྱིལ་འཁོར་གྱི་ལྷ་ཚོགས་རྣམས་ཀྱིས་ཁྱེད་རང་རྣམས་ལ་དགྱེས་ཤིང་བརྩེ་བའི་སྒོ་ནས།",
    "ཁྱེད་རང་རྣམས་དམིགས་པ་འདི་བཞིན་གནང་འཚལ།",
    "འགྲོ་དྲུག་དུས་གནས་མ་ལུས་སྣང་།",
    "དེའི་སུམ་སྟོང་ལྔ་བརྒྱ་དང་སུམ་ཅུ་རྩ་གཉིས་འགྲོ་རྒྱུར་གདའ།",
    "ཡིད་རྟོག་བཅས་ལ་སྔ་ཕྱི་དང་ཡུལ་དང་རང་བཞིན་འདྲེས་པའི་དོན་སྤྱི་མི་གསལ་བར་སྣང་བ་ན།་",
    "བློ་རྫས་གཅིག་དུས་གཅིག་ལ་རིག་བྱ་དང་རིག་བྱེད་གཉིས་རྫས་འགལ་བའི་ཕྱིར།",
    "འདས་པ་ད་ལྟར་བས་རིག་དུས་འདས་པ་ཡུལ་དུ་ཡོད་དམ་མེད།",
    "སེམས་དང་སེམས་བྱུང་རང་རིག་པ་མེད་པར་སྨྲ་བ་ལ་སོགས་པ་ཁ་ཅིག་མི་མཚུངས་ཀྱང་།",
    "བདེན་པ་གཉིས་ཆར་དུ་ཡང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "དེའང་རང་རྒྱུད་པ་ལྟར་ཀུན་རྫོབ་བདེན་པ་བཀག་ནས་རྫུན་པར་བསྒྲུབ་པའམ།",
    "དེ་བས་ན་ཉན་རང་དགྲ་བཅོམ་ཐེག་ཆེན་ལམ་དུ་འཇུག་དུས་ཐེག་ཆེན་གྱི་ཚོགས་ལམ་ཆུང་ངུ་ནས་འཇུག་དགོས་ཏེ།",
    "དེའང་རང་བཞིན་དུ་གནས་པའི་རིགས་དང་།",
    "མགོན་མེད་འདུག་གནས་སུ་ནི་འདུག་གྱུར་ལ།",
    "རྒྱུ་རྐྱེན་ཚོགས་ཀྱང་རང་བཞིན་མེད་པ་སྒྱུ་མ་ལྟ་བུ་ལ་སོགས་པ་གསུངས་ལ།",
    "རྟེན་དང་རང་བཞིན་ནོ།",
    "གཉིད་སད་ཙ་ན་མ་རིག་པ་ལས་སད་པར།",
    "སྟན་ལ་འདུག་པ་ན་རྡོ་རྗེའི་སྟན་ཐོབ་པར་གྱུར་ཅིག་སྙམ་དུ་སེམས་བསྐྱེད་དོ་ཞེས་པ་ལ་སོགས་པ་གསུང་བ་བཞིན་ཉམས་སུ་བླང་ངོ།",
    "འདི་ལྟར་དང་པོར་དམིགས་རྟེན་གཅིག་ལ་ཡིད་བསྡུས་ནས་ལྷན་ནེ་བཞག་དུས།",
    "བེ་རོ་ཙ་ན་ལ་སོགས་པ་རྒྱལ་བློན་སྔ་དར་གྱི་དུས་སུ་བསྒྱུར་བ་ནས་བཟུང་སྟེ་པཎྜི་ཏ་སྨྲི་ཏིའི་བར་དུ་བསྒྱུར་བའི་རྒྱུད་ལ་རྙིང་མ་ཞེས་འདོད་ལ།",
    "དབྱིངས་འཇལ་བ་རླབས་ཆེ་ཆུང་ལྟར་འདུག་པ་ནི།",
    "འདུག་སྟངས་ཀྱི་ཁྱད་པར་སྐྱིལ་ཀྲུང་དང་།",
    "ཀུ་ཤའི་ཁྲི་ལ་འདུག་ནས་བཟླས་བརྗོད་བརྩམ།",
    "འབྲིང་རང་རྒྱལ།",
    "བེ་རོ་ཙ་ན་དང་།",
    "སྣང་ངོ་ཐ་དད་ལ་སྣང་ཡང་རང་བཞིན་རྣམ་དག་འཁོར་འདས་དོང་སྤྲུགས།",
    "དངོས་སྣང་རང་ཤར་བས་བློ་རྟོག་རང་གྲོལ་ཏེ།",
    "འགྱུ་བ་སྟོང་ཡལ་གྱི་གཏན་ཚིགས་ཀྱིས་མེད་སྣང་རང་དག་ཏུ་བསྒྲུབ་པའོ།",
    "མ་བསྒྲུབས་ཡེ་གྲུབ་ཏུ་འདུག་པས།",
    "ཁར་ཕོག་དུས་མེད་པའི་ཁ་གཏམ་ནི་དབྱིངས་རྒྱ་ཆེ་བའི་ངོས་ནས་གང་ཡང་མ་ཤོང་བ་མེད་པས་འཁོར་འདས་ཀྱི་ཁྱབ་བརྩི་བ་དང་།",
    "དབྱེ་ན་དངོས་པོ་འདུག་ཚུལ་གྱི་གེགས་བསལ་བ་དང་།",
    "དེ་དག་བེ་རོ་ཙ་ནས་བསྒྱུར་བའོ།",
    "འབྱུང་དང་འཇུག་དང་རང་ཤར་དང་།",
    "དེའང་རང་བྱུང་ཡེ་ཤེས་སྒྲིབ་པ་དང་བྲལ་བའི་མཐར་ཐུག་པའི་ཚེ་ཐོག་མའི་གྲོལ་ས་ཞེས་བརྗོད་པར་ཟད་ཀྱིས་ཐོག་མའི་གྲོལ་ས་སྒྲིབ་པ་དང་བཅས་པ་ཁམས་ཞེས་བྱ་བ་དྲི་མ་དང་བཅས་པས་དེ་བཞིན་ཉིད་ཡིན་ལ།",
    "དེའང་རང་རིག་འོད་གསལ་ཀུན་ཁྱབ་ཆེན་པོ་ནི་མཚོན་བྱའི་རྒྱུད་དེ།",
    "ཐབས་དང་རང་བཞིན་རྒྱུད་ཅེས་ནི།",
    "གཞན་ལས་མ་བྱུང་རང་ཤར་ཉིད།",
    "དགོས་པ་ནི་ཁམས་དང་རང་བཞིན་གྱི་བྱ་བ་ཡང་སྟོན་པ་ནི་གཞུང་འདིའི་དགོས་པ་ཡིན་ལ།",
    "ཙོག་ཙོག་པོར་ཕྱོཡང་འདུག་མི་བྱ།",
    "དེ་བཞིན་དུ་ཙོག་ཙོག་པོར་གནས་ཏེ་འདུག་པར་མི་བྱ་སྟེ།",
    "ཙོག་ཙོག་པོར་སྤྲུགནས་པས་ཡུན་རིང་པོར་འདུག་ན།",
    "མལ་སྟན་བདེ་བ་བཏིང་ནས་ཁང་བཟངས་ཀྱི་་སྟེང་དུ་འདུག་པ་ནི།",
    "རང་རང་དུས་སུ་ལྷག་པར་བསྟེན།",
    "གང་ཞིག་དུས་གསུམ་དྲི་མེད་པར།",
    "ཙོག་པུར་འདུག་སྟེ་གང་ཡུར་ཞིང་ཅུང་ཟད་གཉིད་ལོག་པ་དེ་ནི་རྩུབ་པ་དང་།",
    "ལྕི་ཞིང་རང་བཞིན་གཡུང་བའི་རྫས་འོ་མ་དང་བུ་རམ་ཤིང་།",
    "དེ་བཞིན་དུ་ཟས་མ་ཞུ་ཞིང་འདུག་པ་དེ་ཉིད་དུ་ཞུགས་ནས།",
    "ཙོ་ཙ་ནི་རྒྱ་སྟར་གྱི་འབྲས་བུའོ།",
    "དེ་དང་རང་བཞིན་མི་མཐུན་པར་གྱུར་པ་དེ་ནི།",
    "སྟོབས་རྣམས་ནི་ཅི་ལྟར་ལྷན་ཅིག་སྦྱར་ཞིང་༥ནུས་པ་མཉམ་པ་ཡིན་དུ་ཟིན་ཀྱང་རང་བཞིན་གྱིས་འཇུ་བས་ནི་རོ་ཟིལ་གྱིས་མནན་ཏེ་དེའི་ནུས་པ་མེད་པར་བྱས་ནས།",
    "ཙོ་ཙ་ནི་རྒྱ་སྐྱེགས་ཀྱི་འབྲས་བུའོ།",
    "ལུས་ཀྱི་མེ་དྲོད་རང་གནས་འདུག།",
    "རང་གནས་སུ་འདུག་ཅེས་བྱ་བ།",
    "ཅི་བཞིན་སྟོབས་དང་རང་ཇི་བཞིན།",
    "རྐེད་པའི་འོག་ན་འདུག་པ་དང་།",
