    "སྦྱོར་བའི་སྒོ་ནས་དགེ་སྡིག་རྒྱུན་ཆགས་སུ་བྱས་པ་དང་།",
    "ས་དེར་རྣམ་པར་སྨིན་པ་མྱོང་ངེས་ཀྱི་ལས་གང་ཡིན་པ་དེ་ཚེ་དེ་ལ་མྱོང་སྟེ།",
    "འདོད་པའི་ཕྱིར་མི་འོང་ལ་འདོད་པར་མྱོང་ངེས་ཀྱི་ལས་ཡོད་པ་ཚེ་དེ་ལ་མྱོང་བ་ལྟ་བུའོ།",
    "མཐོང་སྤང་དང་སྒོམ་སྤང་ཀུན་སྤངས་པའི་གནས་གྱུར་གསར་པ་དང་ལྡན་པ་མཐོང་ལམ་དང་དགྲ་བཅོམ་འབྲས་བུ་ལས་ལངས་མ་ཐག་པ་སྟེ་དེ་ལྔ་ལ་ཕན་གནོད་བྱས་པའི་འབྲས་བུ་ནི།",
    "ལུས་ཚོར་ནི་རྟོག་དཔྱོད་དང་བཅས་པར་ངེས་པས་སོ།",
    "སེམས་གཡེངས་པ་དེ་ནི་སྔོན་གཞན་སྨྱོས་པར་བྱས་པའི་ལས་ཀྱི་རྣམ་སྨིན་ལས་སྐྱེས་པ་དང་།",
    "སྙིགས་མ་ཞེས་པ་གསུམ་གསུམ་གསུངས་པ་ནི།",
    "དེའི་རྣམ་སྨིན་ཡང་སྡུག་བསྔལ་དང་འདྲེས་པར་འཇུག་པས་ན་རིམ་པ་བཞིན་དུ།",
    "ལས་དེ་གསུམ་ཟད་པར་བྱེད་པ་ཟག་མེད་ཀྱི་ལས་ནི་མི་གནག་མི་དཀར་ཞིང་རྣམ་སྨིན་མེད་ལ་ལས་ཟད་པར་འགྱུར་བའི་ལས་ཏེ།",
    "སེམས་པ་བཅུ་གཉིས་པོ་དེ་ནི་ནག་པོ་ཟད་པར་བྱེད་པའི་ལས་ཡིན་ལ།",
    "སྒོམ་ལམ་གྱི་སྤོང་ལམ་གྱིས་བདེ་འགྲོའི་རྒྱུའི་ལས་ཟད་པར་བྱེད་དེ།",
    "ཐུབ་པའི་ལུས་ངག་ཡིད་ཅེས་གསུངས་པ་གང་ཞེ་ན།",
    "གཙང་བྱེད་རྣམ་པ་གསུམ་གསུངས་པ་གང་ཞེ་ན།",
    "སྒོ་གསུམ་གྱི་ཟག་མེད་ཀྱི་ལེགས་སྤྱད་གསུམ་པོ་ཐམས་ཅད་ནི་གཙང་བྱེད་རྣམ་པ་གསུམ་ཡིན་ནོ།",
    "ཉེས་སྤྱད་རྣམ་པ་གསུམ་གསུངས་པ་ནི།",
    "ལེགས་པར་སྤྱད་པ་གསུམ་གསུངས་པ་ནི།",
    "དགེ་མི་དགེ་ལས་ལམ་བདུན་ནི་ཉེར་བསྡོགས་ཏེ་སྦྱོར་བ་རྣམས་ནི་བྱ་བ་བྱེད་པ་ལ་ལྟོས་པས་རྣམ་པར་རིག་བྱེད་དུ་ངེས་ལ།",
    "དེ་རྣམས་ཀུན་སློང་དྲག་པོས་བྱེད་ན་རྣམ་པར་རིག་བྱེད་མིན་པ་ཡང་ཡོད་པར་འགྱུར་བའམ།",
    "ཤ་ལ་སོགས་པར་ཆགས་པ་དང་།",
    "མ་བྱིན་ལེན་གསུམ་པོ་ཆགས་པ་ཡིས་རྫོགས་པར་བྱེད་ལ།",
    "ལྷག་མ་རྫུན་ཕྲ་མ་ངག་འཁྱལ་གསུམ་ཆགས་སོགས་གསུམ་ཆར་གྱིས་རྫོགས་པར་འདོད་དོ།",
    "བསད་བྱ་ལས་སྔ་བ་དང་དུས་མཉམ་དུ་གསོད་བྱེད་ཤི་བ་ལ་ནི་སྦྱོར་བ་བྱས་ཤིང་འབྲས་བུ་རྫོགས་ཀྱང་གསོད་པའི་ལས་ལམ་དངོས་གཞི་མེད་དེ།",
    "དེ་ཡང་སྦྱོར་བ་བྱས་པའི་ལུས་ཉིད་ལ་དངོས་གཞི་གྲུབ་དགོས་སོ།",
    "དེ་གཅོད་པར་བྱེད་པ་ནི་སྲོག་གཅོད་པའོ།",
    "དེ་ཡང་གསོད་སྙམ་དུ་བསམ་བཞིན་དུ་བྱས་པ་དང་བསད་བྱ་མ་ནོར་བ་དགོས་ཏེ།",
    "མྱ་ངན་ལས་འདས་པ་ལ་ཕུལ་བ་བརྐུས་པ་ཡང་སྦོམ་པོར་གསུངས་ཏེ།",
    "ལོག་པར་གཡེམ་པ་ནི་བགྲོད་པར་བྱ་བ་མིན་པ་བགྲོད་པར་འདོད་པ་ཡིས་འགྱུར་ཏེ་རྣམ་པ་བཞིའོ།",
    "རྟོགས་པ་བཞི་ལ་བདེན་པ་དང་རྫུན་པ་སྨྲ་བའི་ཐ་སྙད་བཅུ་དྲུག་གསུངས་པ་ལས།",
    "རྣམ་པར་ཤེས་པ་དང་།",
    "ལོག་པར་ལྟ་བ་ནི་ལས་དགེ་མི་དགེ་མེད་པར་ལྟ་བ་སོགས་ལས་འབྲས་དང་འཕགས་པ་ལ་སྐུར་བ་འདེབས་པའོ།",
    "ཁམས་གོང་མའི་དགེ་རྩ་དང་འདོད་པའི་སྦྱོར་བྱུང་ནི་སྔར་ནས་ཉམས་ཟིན་པས་དངོས་སུ་གཅོད་པར་བྱར་མེད་དོ།",
    "ཆད་པ་སླར་མཚམས་སྦྱོར་བ་ནི་རྒྱུ་འབྲས་ལ་ཐེ་ཚོམ་སྐྱེས་པའམ་རྒྱུ་འབྲས་ཡོད་པར་ལྟ་བས་སོ།",
    "རྣམ་པར་འཚེ་བས་གནོད་པ་མང་།",
    "གནོད་སེམས་འཇིགས་པ་སྦྱིན་པར་བཤད།",
    "ལོག་པར་ལྟ་བས་ལྟ་ངན་ཉིད།",
    "ལོག་པའི་ངག་དང་ལས་ཀྱི་མཐའ་དང་འཚོ་བ་གསུམ་གསུངས་པའི་ལོག་འཚོ་གང་ཞེ་ན།",
    "དེ་སྦྱང་དཀའ་བས་སྒྲིམ་པར་བྱ་བའི་ཕྱིར་དུ་གཉིས་ལས་ལོགས་ཤིག་ཏུ་བསྟན་ཏོ།",
    "འཕེན་རྫོགས་གཉིས་ཀྱི་ཁྱད་པར་རོ།",
    "རྣམ་སྨིན་གྱི་སྒྲིབ་པ་གསུམ་གསུངས་པ་དེ་གང་ཞེ་ན།",
    "དེ་དང་འབྱེད་པོ་ལྷས་སྦྱིན་སོགས་ལ་ཡང་དག་པར་ལྡན་ནོ།",
    "དེའི་འབྲས་བུ་ནི་བར་གྱི་བསྐལ་པར་མནར་མེད་པར་སྨིན་པར་འགྱུར་ལ།",
    "མཚམས་མེད་གཉིས་ལ་སོགས་པ་ལྷག་པ་བྱས་པས་ནི་རྣམ་སྨིན་གྱི་གནོད་པ་ཉིས་འགྱུར་སོགས་ལྷག་པར་འགྱུར་བའི་ལུས་ཆེན་པོ་དང་།",
    "དབྱེ་ན་དེ་ནི་ནམ་མ་ལངས་པར་འདུམ་པས་ཞག་གཅིག་ལས་ལྷག་པར་མི་གནས་སོ།",
    "ཕན་འདོགས་པའི་ཞིང་ཕ་མ་དང་ཡོན་ཏན་གྱི་ཞིང་དགྲ་བཅོམ་སོགས་བསམ་པས་སྤངས་ཤིང་སྦྱོར་བས་མེད་པར་བྱས་པའི་ཕྱིར་རོ།",
    "ཕ་མ་ལ་སྦྱོར་བ་བྱས་ནས་གཞན་བསད་ནའང་མི་འགྱུར་ལ།",
    "ཕ་མ་མིན་པ་ལ་སྦྱོར་བ་བྱས་ནས་ཕ་མ་ངག་བསད་ནའང་མི་འགྱུར་ཏེ།",
    "དགྲ་བཅོམ་པ་ལ་སྦྱོར་བ་མ་བྱས་པས་སོ།",
    "དགྲ་བཅོམ་མིན་པའི་འདུ་ཤེས་ཀྱིས་དེ་བསད་ནའང་འདི་བསད་ན་སྙམ་དུ་རྟེན་ངེས་པར་བཟུང་བའི་ཕྱིར་འགྱུར་ཏེ།",
    "མཚམས་མེད་ཀྱི་སྦྱོར་བ་བྱས་ཤིང་དེ་མ་བཟློག་པ་ལ་བསམ་པ་ཤིན་ཏུ་འགལ་བས་འདོད་ཆགས་དང་བྲལ་བའི་འབྲས་བུ་ཐོབ་པ་མི་སྲིད་དོ།",
    "ཆགས་བྲལ་དང་ཐོས་བསམ་སྒོམ་གསུམ་གྱི་གེགས་བྱེད་ཅིང་སྐྱེ་རྒུའང་ཡིད་མི་བདེ་ཞིང་དྲན་པ་ཉམས་པར་འགྱུར་བས་སོ།",
