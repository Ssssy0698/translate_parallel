    "དུས་གསུམ་པའི་ཡུལ་ཀུན་དང་ལྡན་པར་བྱེད་དེ།",
    "གལ་ཏེ་འདས་མ་འོངས་རྫས་སུ་ཡོད་ན་འདུས་བྱས་རྟག་པར་འགྱུར་ལ་མེད་ན་ཇི་ལྟར་དེ་དང་ལྡན་པ་ཡིན་ཞེ་ན།",
    "དུས་རྣམས་ཀུན་ཏུ་རྫས་སུ་ཡོད་ལ་འདུས་བྱས་ཀྱི་མཚན་ཉིད་དང་ལྡན་པས་སྐྱོན་གཉིས་ཀ་མེད་དོ།",
    "རྣམ་པར་ཤེས་པ་ནི་གཉིས་ལ་བརྟེན་ནས་སྐྱེའོ་ཞེས་གསུངས་ཏེ།",
    "དེ་ལྟར་དུས་གསུམ་པོ་དེ་རྫས་སུ་ཡོད་པར་སྨྲ་བའི་ཕྱིར་གཞི་ཐམས་ཅད་ཡོད་པར་སྨྲ་བར་འདོད་ཀྱི།",
    "མ་འོངས་པ་དང་འབྲས་བུ་སྐྱེད་ཟིན་པའི་འདས་པ་མེད་ཅེས་ཕྱེ་སྟེ་སྨྲ་བ་ནི་རྣམ་པར་ཕྱེ་སྟེ་སྨྲ་བའོ།",
    "འདིས་དངོས་པོ་དང་རྫས་མི་གཅིག་པར་འདོད་དོ།",
    "བྱ་བ་བྱས་ནས་འགགས་པ་འདས་པ་སྟེ་བྱ་བ་ཡིས་དུས་རྣམས་རྣམ་པར་བཞག་པས་སོ།",
    "འོ་ན་འདས་མ་འོངས་གཉིས་ཀྱང་བྱ་བ་བྱེད་པར་འགྱུར་ཏེ་དུས་རྟག་ཏུ་རྫས་སུ་ཡོད་པས་རྟག་ཏུ་བྱ་བ་བྱེད་པ་ལ་གེགས་བྱེད་པ་སུ་ཡང་མེད་པས་སོ།",
    "འདུས་བྱས་ཀྱི་མཚན་ཉིད་དང་མི་ལྡན་པས་མི་རྟག་ཅེས་པ་ཚིག་ཙམ་སྟེ་དུས་ཐམས་ཅད་དུ་ཡོད་པ་སྐྱེ་འཇིག་མི་རུང་བས་སོ།",
    "རྫས་སུ་ཡོད་པར་སྟོན་པ་ནི་མིན་ནོ།",
    "འབྲས་ཕྱིར་ཞེས་པ་ནི་ལས་འདས་པས་འབྲས་བུ་བསྐྱེད་པ་མ་ཡིན་གྱི་ལས་དེ་མངོན་དུ་འགྱུར་བའི་སེམས་རྒྱུད་འགྱུར་པའི་ཁྱད་པར་ལས་སྐྱེ་བའོ།",
    "རྐྱེན་ཡོད་ན་འབྱུང་དུ་རུང་བ་ནི་མ་འོངས་པར་རིགས་སོ།",
    "སྤངས་ཀྱང་མ་བྲལ་བ་ཡོད་པར་སྟོན་པ་སྟེ།",
    "མཚུངས་ལྡན་དང་དམིགས་པའི་སྒོ་ནས་རྒྱས་པར་འགྱུར་བ་དང་།",
    "དེ་དང་མཚུངས་ལྡན་གང་ཞིག་སྤངས་པ་རྒྱས་པར་མི་འགྱུར་ཡང་ལྷན་ཅིག་པ་ཙམ་གྱིས་བཅས་པར་འཇོག་གོ།",
    "གང་དང་མཚུངས་པར་ལྡན་པ་དང་།",
    "ཕྲ་རྒྱས་ཉིད་ཟག་པ་གསུམ་དུ་གསུངས་པ་ལ།",
    "ཟག་པ་ཐམས་ཅད་ཀྱི་རྩ་བ་མ་རིག་པ་ཡིན་པས་ན་ལོགས་ཤིག་ཏུ་ཟག་པར་བསྟན་ཏོ།",
    "ཁྱད་པར་ན་ཁམས་གསུམ་གྱི་ལྟ་བ་རྣམས་ཤེས་རབ་ཡིན་པས་གསལ་བའི་ཕྱིར།",
    "ལྟ་བ་ཐ་མ་འདི་ལོགས་སུ་བྱས་པ་ནི་ལམ་གྱི་དགྲར་གྱུར་པས་ཁྱིམ་པ་དང་རབ་ཏུ་བྱུང་བ་གཉིས་ཀ་བསླབས་སོ།",
    "མ་རིག་པ་ནི་མི་གསལ་བ་སྟེ་རྐྱང་པ་འཛིན་པར་བྱེད་པ་མ་ཡིན་པ་གཞན་དང་འདྲེས་པ་ན་འཛིན་པའི་ཕྱིར་བསྲེས་སོ།",
    "དམིགས་པ་དང་མཚུངས་ལྡན་གཉིས་ཀས་རྒྱས་པར་འགྱུར་བ་དང་།",
    "ཐ་མའི་ཆ་འདོད་ཁམས་དང་མཐུན་པའི་ཀུན་སྦྱོར་རྣམ་པ་ལྔ་གསུངས་ཏེ།",
    "སྔ་མ་གསུམ་པོ་ཡིས་ནི་འདས་ཀྱང་ཕྱིར་བཟློག་པར་བྱེད་པའོ།",
    "རྒྱུན་ཞུགས་ཀྱིས་མཐར་ལྟ་སོགས་ཀྱང་སྤངས་ན་ཀུན་སྦྱོར་སྔ་མ་གསུམ་ཁོ་ན་སྤང་བས་རྒྱུན་ཞུགས་སུ་གསུངས་པ་ཅི་ཞེ་ན།",
    "གསུམ་པོ་སྤངས་ན་མཐར་ལྟ་སོགས་གསུམ་ཡང་སྤངས་པར་གོ་བའི་ཕྱིར་ཏེ།",
    "ཞེས་གསུངས་སོ།",
    "ཡང་ཐུབ་པས་གོང་མའི་ཆ་དང་མཐུན་པའི་ཀུན་སྦྱོར་ལྔ་ཉིད་གསུངས་ཏེ།",
    "དེ་རྣམས་མ་སྤངས་པར་ཁམས་གོང་མ་ལས་མི་འདའ་བས་སོ།",
    "སེམས་རྣམ་པར་མ་ཞི་བ་རྒོད་པ་དང་འགྱོད་པ་དང་རྨུགས་པ་དང་།",
    "རྣམ་པར་མཐོ་འཚམས་པ་རྣམ་འཚེའོ།",
    "ཁམས་དང་སའི་ཁྱད་པར་རོ།",
    "གཉིས་པ་དེ་རྣམས་གང་དང་མཚུངས་པར་ལྡན་པ་ལ་གཉིས་ཏེ།",
    "རྩ་ཉོན་ཚོར་བ་གང་དང་མཚུངས་པར་ལྡན་ཞེ་ན།",
    "འདོད་ཆགས་ནི་ཚོར་བ་བདེ་བ་དང་ཡིད་བདེ་དག་དང་མཚུངས་པར་ལྡན་ཞིང་།",
    "ཚོར་བ་ལྔ་པོ་ཐམས་ཅད་དང་མཚུངས་པར་ལྡན་ནོ།",
    "བཏང་སྙོམས་ནི་ཕྲ་རྒྱས་ཀུན་དང་མཚུངས་པར་ལྡན་ཏེ།",
    "ཉེ་ཉོན་རྣམས་ཚོར་བ་གང་དང་མཚུངས་པར་ལྡན་ཞེ་ན།",
    "ཆགས་པས་བསླངས་པའི་དགའ་བའི་རྣམ་པར་འཇུག་པས་སོ།",
    "གཞན་ངོ་ཚ་མེད་པ་དང་ཁྲེལ་མེད་པ་དང་རྨུགས་རྒོད་གཉིས་ཏེ་བཞི་པོ་ནི་ཚོར་བ་ལྔ་ཆར་རྣམས་དང་མཚུངས་པར་ལྡན་ནོ།",
    "འདོད་པ་ལ་འདུན་པ་སོགས་སྒྲིབ་པ་ལྔ་གསུངས་པ་ལ།",
    "བྱ་བ་སེམས་ཞུམ་པར་བྱེད་པ་གཅིག་པའི་ཕྱིར་རོ།",
    "རྒོད་འགྱོད་གཉིས་གཅིག་ཏུ་བྱས་ཏེ།",
    "རྒོད་འགྱོད་གཉིས་ཀྱིས་ཏིང་ངེ་འཛིན་གྱི་ཕུང་པོ་ལ་གནོད་པར་བྱེད་པ་དང་།",
    "རྒོད་འགྱོད་ཀྱིས་ཤེས་རབ་ལ་གནོད་པར་བཞེད་པས་སྔོན་གྱི་སློབ་དཔོན་དག་རིམ་པས་ཏིང་ངེ་འཛིན་གྱི་སྦྱོར་བ་དང་།",
    "ཡང་དག་པར་ཟད་པས་སྤོང་བ་དང་།",
    "རྣམ་པར་སུན་འབྱིན་པའི་གཉེན་པོ་ཁམས་དེ་ལ་སྐྱོན་དུ་མཐོང་ནས་སུན་འབྱིན་པའོ།",
    "ཁྱད་པར་གྱི་ལམ་དུ་བཞེད་ལ།",
    "ལམ་ཇི་ལྟར་གོང་མ་གོང་དུ་ཁྱད་པར་དུ་འགྱུར་བ་ལྟར་སྤངས་པ་ཡང་ཁྱད་པར་དུ་འགྱུར་རམ་ཞེ་ན་ཡང་མ་ཡིན་ཏེ།",
    "དེ་རྣམས་ཀྱི་བྲལ་བའི་ཐོབ་པ་ནི་ཡང་དང་ཡང་དུ་ཁྱད་པར་དུ་འགྱུར་རོ།",
    "གནས་སྐབས་དུ་ཞིག་ཁྱད་པར་དུ་འགྱུར་ཞེ་ན།",
    "སྲིད་རྩེའི་ཕྱོགས་གཅིག་ཉམས་པར་བྱས་པ་དང་།",
