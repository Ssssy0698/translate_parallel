    "བློ་གྲོས་ཉི་མའི་འོད་ཀྱིས་རབ་གསལ་བྱས།",
    "འདི་དག་ལ་ཁྱིམ་ནམ་མཁའ་ལ་ཡོད་པས་ལྷ་སྟེ།",
    "རྒྱལ་ཆེན་བཞིའི་རིགས་སུ་གཏོགས་པས་རྒྱལ་ཆེན་བཞི་པ་དང་ལེགས་བྱས་ལྷན་ཅིག་བྱས་པ་རྣམས་དེར་སྐྱེ་བས་སམ།",
    "སོ་སྐྱེ་དང་མ་འདྲེས་པའི་གནས་གཙང་མ་གོང་མ་རྣམས་ལས་ལུས་ཚད་སོགས་མི་ཆེ་བས་མི་ཆེ་བ་དང་།",
    "མཐོང་བའི་ལྟ་བ་ཤིན་ཏུ་རྣམ་པར་དག་པས་ཤིན་ཏུ་མཐོང་བ་དང་།",
    "ཅི་ཡང་མེད་དོ་སྙམ་པའི་རྣམ་པར་ཡིད་ལ་བྱེད་པ་དང་།",
    "སྟེང་འོག་ཏུ་མ་གསུངས་པས་སོ་ཞེའོ།",
    "རྒྱུད་བླའི་འགྲེལ་པར།",
    "དེས་སྐྱོ་ནས་བདེ་བ་མངོན་དུ་བྱེད་པས་ཐ་དད་པ་བསམ་གཏན་གཉིས་པའི་ལྷ་སྟེ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་བར་སྲིད་ཡོད་དོ།",
    "ཞེས་ལྔར་གསུངས་པ་ལས་གྲུབ་སྟེ།",
    "ཀྱང་ནི་རིགས་པར་མ་ཟད་པའོ།",
    "གཟུགས་མེད་ནས་སྐྱེས་པ་ལ་དབྱིབས་མེད་པར་འགྱུར་རོ།",
    "ལྷའི་སྣམ་བུ་དཀར་པོ་ལྟ་བུར་གསུངས།",
    "ཉེ་བར་ལེན་པ་ནི་ཡུལ་གྱི་ལོངས་སྤྱོད་རྣམས་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཐམས་ཅད་དུ་ཡོངས་སུ་རྒྱུག་པའི་གནས་སྐབས་སོ།",
    "གདུལ་བྱ་སྐྱོ་བའི་ཆེད་དུ་དེ་བཞི་རྒ་ཤིའི་སྒྲས་གསུངས་སོ།",
