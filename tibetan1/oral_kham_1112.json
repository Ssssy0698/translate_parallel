    "འདོམས་མི་སྣང་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོང་བར་བསླབ་པར་བྱ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "དེ་བཞིན་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པས་མཚམས་ཀྱི་ནང་ན་འདུག་པ་ལ་བཟློག་པའང་མི་བརྩན་ནོ།",
    "དེ་གནས་དེ་ནམ་འདུག་ཤིག་ཅེས་བསྒོ་བའོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས།",
    "འདུག་པ་གཅིག་པར་འགྱུར་བ་དེ་ནི་བཟོད་པ་གསོལ་བའི་ལས་ཞེས་བྱའོ།",
    "དགེ་སློང་གང་གནས་ན་གཅིག་པུ་འདུག་ན་དེས་བཅོ་ལྔའི་གསོ་སྦྱིན་དེ་ཉིད་དུ་སྔར་ལངས་ཏེ་མཆོད་རྟེན་དང་ཁང་བར་ཕྱག་དར་བྱ།",
    "དེ་སྟེ་སུའང་མི་འོང་ན་དེས་དེ་ནས་བབས་ཏེ་དུས་ཀྱི་མཐར་གྱུར་གྱི་བར་དུ་སྡོད་ལ་འདུག་སྟེ།",
    "བསྟོད་པ་དང་བཅས་པ་ད་ལྟ་ཕྱག་ལེན་ལ་མཛད་ཅིང་གདའ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "དེས་ནངས་པར་སྦྱོར་བ་ཉིད་ཀྱིས་འདུག་པར་མི་ནུསཔ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ཡང་རང་རིག་པའི་མངོན་སུམ་གྱིས་གྲུབ་པ་ཡིན་ནོ།",
    "འདོད་ཆགས་ལ་སོགས་པ་ཐམས་ཅད་ལས་ངེས་པར་གྲོལཔ་བྱ་བ་མེན་པར་འདུག་པ་ཉིད་རིགས་སོ།",
    "ཐབས་དེ་ཡང་རང་ཉིད་ཚད་ཚདའགྲེལ་ཏེ་ང་ལྔ་། མར་སྒྲུབ་པ་ཡིན་ནོ།",
    "དཔེར་ན་མང་མེ་ཞིག་ནམར་མེའི་འོད་ཡུལ་གཞནན་འདུག་པ་འང་འཇིག་པ་དེ་བཞིན་དུ་ལུས་ཞིག་ན་ལུས་ལ་བརྟན་པའི་རྣམ་པར་ཤེས་པ་ཡུལ་གཞཞལ་གནས་པ་ཡང་འཇིག་པར་འགྱུར་རོ།",
    "བློའི་ཁྱད་པར་ཤེས་རབ་ལ་སོགས་པ་དང་ཐམས་ཅན་ལ་ཁྱད་པར་བདག་ཏུ་འཛིན་པ་ལ་སོགས་པ་རྣམས་ནི་གོམས་པའི་དེ་མ་ཐག་པ་དང་སྔོན་ཡང་རང་བཞིན་མཚུངས་པཏན་ཡིན་པ་དེའི་ཕྱིར་དུ་བ་དབེ་མ་ཡིན་ནོ།",
    "ཁྱད་པར་འཕེལ་ཡང་རང་བཞིན་ཉིད།",
    "འོན་ཀྱང་རང་བཞིན་དང་སྐྱེས་བུའི་བྱེ་བྲག་ཡོངས་སུ་ཤེས་བ་ལས་གྲོལ་བ་ཡིན་ནོ།",
    "སྒྲའི་ཤེས་པ་དེ་ཉིད་ཀྱ་ང་རང་ལ་སྣང་བའི་ཡུལ་ཉིད་རྟོགས་པར་བྱེད་པ་ཡིན་ནོ།",
    "དམིགས་པ་ལས་ཐ་དད་པའི་དོན་ཡང་མེད་པའི་ཕྱིར་རང་རིག་པ་ཉིད་ཡིན་པས་འཛན་པའི་རྣམ་པ་ལྟར་བཟུང་བའི་རྣམ་པ་ཡང་རང་རིག་པཙམ་ཉིདདོ།",
    "གང་ཡང་རྒྱུ་དང་འབྲས་བུ་དག་དུས་མཚུངས་པ་ཡིན་ཞེས་བྱ་བ་དེ་ལ།",
    "རུང་བའི་ཡུལ་ན་འདུག་པ་གཞན་གྱིས་མི་ཤེས་པའི་ཕྱིར་འཛིན་པའི་རྣམ་པབཞིན་ནོ།",
    "འཇིག་རྟེན་པམ་ཡིན་པ་དང་རང་རིག་པ་ནི་ཁྱད་པར་ཡོད་པ་མ་ཡིན་ནོ།",
    "འདིང་རང་བཞིན་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "དེའི་འདུགཉིད་དང་དེ་ལས་བྱུང་བའི་མཚན་ཉིད་ཀྱི་འབྲེལ་པ་དང་ལྡན་པའི་རྟགས་ནི་གོ་བར་བྱེད་པ་ཡིན་ཏེ།",
    "ཡོད་པ་ཉིད་དང་རང་རྒྱུད་དང་།",
    "དེའི་ཕྱིར་གཞན་ཁོ་དོན་ན་ཡིནལ་མདུན་ན་འདུག་པའི་ཀ་བ་གསལ་བར་སྣར་བའི་ཤེས་པ་ནི་མངོན་སུམ་ཡིན་ནོ།",
    "ཡུལ་དང་ངུས་མཚུངས་པ་དག་ཀྱང་རང་བཞིན་ཐ་དད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དུས་དང་རུས་ཐ་དད་པ་དག་ཀྱང་རང་བཞིན་ཐ་དད་པ་ཁོ་ནའི་ཕྱིར་དེ་ལྟར་སྣང་བ་ཡི་ན་གྱི་ཡུལ་དང་དུས་ཐ་དང་པས་ནི་མ་ཡིན་ནོ།",
    "དབྱུག་བཙ་ན་ནོ་ཞེས་བྱ་བར་ཤེས་པ་ལ་ཡང་དབྱུག་པ་ཐ་དད་པར་སྣང་བ་བ་ནི་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དཔེར་ན་ཐེབས་སྐྱོར་དང་སྐྲ་དང་འཕྲིང་བ་འཛིན་པ་ལ་སོགས་པའི་མིང་དང་རང་བཞིན་ལ་སོགས་པར་བརྡར་བརྟགས་པ་བཞིན་ནོ།",
    "འོན་ཀྱང་རང་བཞིན་དེ་ལས་མ་འདས་པའི་ཁྱད་པར་གཞན་གནས་པར་བྱེད་པ་ཡིན་ནོ།",
    "པརང་ཆུང་དུས་ནས་འཁྱམས་ནས་ཡུན་རིང་ལོན་པས་ཕ་མ་ས་ཆ་སོགས་བརྗེད་འདུག་གསུངས་པ་དང་།",
    "རྨད་གོསནསལ་ཞེས་བཏགས་འདུག་ཅེས་སོགས་གསུངས་པ་ལྟར།",
    "གལ་ཏེ་དེ་འདྲམ་བྱུང་ན་ཞེས་སོགས་ཀྱི་གསུད་བབ་ལྕི་སེ་བ་གནང་འདུག་ཅིང་།",
    "སོག་སྐདཀྱི་སེང་གེའི་མིང་ཡིན་འདུག།",
    "ལྟུདན་འདོན་ཐུབ་པར་མི་འདུག་དེ་ནས་རིམ་གྱིས་བབས་པས་གསདང་ནགས་ཀྱི་མཚམས་སུ་སླེབས་ན།",
    "བོད་པ་དྲུང་འཁོར་ངོ་ཤེས་པ་གཉིས་འདུག་པའི་བོད་པདེསདད་ཞེན་བྱེད་ཅིད།",
    "སོག་པོ་དེཅུང་སྡང་སེ་བ་འདུག།",
    "དགུན་ཡང་འབྲུགསྒྲ་སྒྲོགསཤིང་ཆར་འབབས་པ་སོགསཡམཚན་པར་འདུག་དེ་ལ་འདི་སྐད་ཅེས་བྱ་སྟེ།",
    "ཁྱེད་རང་ལས་དང་སྐལ་བ་བཟད་ཙམ་ཞིག་ཏུ་འདུག།",
    "དང་འགྲོགསནས་དེར་སླེབས་འདུག་པ་དང་འཕྲད་ནས་ལྷན་དུ་བལ་པོར་སླེབས།",
    "སེམས་འདི་ལ་འཚོར་བ་རྣམ་གསུམ་གདའ།",
    "དེའི་མཛད་པ་ཡོན་ཏན་དྲན་ཙ་ན།",
    "ཡང་སྒོས་སུ་སྲས་འདི་ལ་སྐྱབས་འཇུག་ལོས་བྱེདཅེས་གསུདའདུག་དེསྐབས་དཔོན་པོའི་གཟིམ་གུར་ཆེ་ལོགས་ཞིག་གཟིམཆ་བཞུགས་གདན་དང་བཅས་བ་དབུས་གཙང་གྲ་འགྲིགས་བྱས་ཡོདབ་དེ་གར་བཞུགས་གདན་འཇགས་པར་མཛད།",
    "དཚོའི་དཔལ་དུ་ཤར་བ་ཡིན་ནོ་ཞེས་གླེདའདུག།",
    "དེའི་ཕྱག་ན་ག་འདྲ་ཞིག་འདུག་གསུང་བར།",
    "དེ་ལ་བེ་ཅོན་མི་འདུག།",
    "དེ་དུས་གསོལ་བ་ཐོབ་གསུངས་པར་ཁོས་ལགསསོཙམ་ཞུས་འདུག།",
