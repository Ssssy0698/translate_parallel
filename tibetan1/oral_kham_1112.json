    "དེ་ཡི་ནང་དུ་ཕྱི་ནང་གསང་བའི་བོན་འགའ་འདུག་ཀྱང་བདག་རྩོལ་བ་ཞན་པའི་པས་",
    "སྔ་སོར་གྱི་སྙན་འགྲེལ་དེ་ཧ་ཅང་བསྡུས་དྲག་ནས་བློ་ཆེན་གྱི་སྐྱེས་བུ་དམ་པ་འདྲ་ཡིན་ན་མ་གཏོགས་གོ་དཀའ་བར་འདུག་པས།",
    "དཀའ་བར་གདའ་བའི་ཉི་ཤུ་རྩ་ལྔ་པའི་མགུར་རི་ཁྲོད་ཡོད་བཅུ་དགོན།",
    "དྲེ་སྟོད་སྣ་ལྔའི་ལུང་རིང་གོ་ལམ་གདའ་ཟེར་བ་བཅུ་ཡི་མགུར་བཞུགས་སོ།",
    "མི་ཕན་འདུག་པ་བཅོ་ལྔའི་མགུར་བཞུགས་སོ།",
    "བློ་སྣ་མ་བསྡུངས་ན་རྗེས་སུ་འགྱོད་རན་ཕྱི་འདུག་སྙམ་ཧོ་པའི་སྟེང་ཆེན་དགོན།",
    "རང་ཡུལ་དུ་ལོག་དུས་བོན་རིར།",
    "ཉན་ཐོས་རིགས་དང་རང་རྒྱལ་རིགས།",
    "སློབ་དཔོན་གསང་ཞིང་གཅིག་པུར་འདུག་ལ་དགའ།",
    "དགེ་སློང་རང་ད་ཕྱིར་ངེས།",
    "དེ་ཡང་རང་རྒྱུད་ལ་བརྟག་པ་དང་།",
    "དེ་བཞིན་ཁ་ཅིག་གོག་ཙ་ན།",
    "དོན་ཤི་བའི་རོ་གཅིག་འདུག་ལོ་ཟེར་བ་ཐོས་ཅན།",
    "སྐྱེས་ཙ་ན་ལྷ་མིའི་ལོངས་སྐྱོད་ཕུན་སུམཆོགས་པ་ཐོབ་སྟེ་འོང་།",
    "སྩ་ཉགམ་གཅིག་ལག་མཐིལ་ན་འདུག་ན་མི་བདེ་བ་དང་།",
    "བདུནབ་ཏུ་དོག་པ་མུན་ནག་འཐིབས་པོར་འདུག་ངཔ་ཡ།",
    "རྒྱགས་ཕྱེ་ཁུར་ནས་འོངས་པར་མི་གདའ།",
    "དེ་ཡང་རང་ལ་མི་མཁེ་བ་བུ་ལ་བྱིན་པ་ལྟ་བུ་མ་ཡིན་ཏེ།",
    "དེ་ནས་ལྷུང་བ་དང་སྡུག་བསྔལ་ཆེན་པོ་མྱོང་ཞིང་ཡར་འཐོན་དུས་མེད་པའི་གཡང་སར་ལྷུང་ལ་ཁད་འདུག་ན།",
    "སྐྱབས་ཐུབ་པ་ནི་ཁོ་རང་འཇིགས་པ་ལས་ཐར་བ་སྡུག་བསྔལ་མེད་པ་ཅིག་དགོས་ཏེ།",
    "དེ་ལྟར་ཡང་རང་ལ་འབྱོར་པ་ཆེ་བར་ཡོད་ན་དངོས་སུ་ཆུང་བས་མི་འོང་སྟོ།",
    "ཅིགསྨོན་པ་སོར་ཆུད་པས་འཇུག་པ་ཡང་རང་བཞིན་གྱིས་སོར་ཆུད་དོ།",
    "ལེནཔ་པོ་ཁོ་རང་ལ་གནོད་པར་བྱབ་འམ།",
    "རྐང་སྟན་བཅས་པའི་ཁྲི་ལ་རབ་འདུག་ཅིང་།",
    "མི་འདོད་ཀྱང་རང་ལ་ལོངས་སྤྱོད་ཕུན་སུམ་། ཚོགས་པར་འགྱུར།",
    "དཔའ་གཞན་དད་ཅིང་རང་མི་ཉམས་པར་བྱ་བའི་ཆེད་དུ།",
    "རྐང་པ་བརྐྱང་ཏེ་མི་འདུག་ཅིང་།",
    "མ་བྱིན་པར་ལེན་པ་ལ་སོགས་པ་བྱེད་ཅིང་འདུག་ན།",
    "ལམ་རིམ་དུ་གསུང་ཙ་ན།",
    "གཟུགས་སམ་ཁ་དོག་ཅི་ལྟར་འདུག་པ་ལེགས་པར་བརྟགས་ལ།",
    "རྣམ་རྟོག་དང་འབད་རྩོལ་མི་མངའ་བར་འདུག་པས།",
    "ལྷ་སྒྲུང་རང་བྱུང་མཚན་ཉིད་རིག་པ་བ།",
    "དེ་ཡང་རྩོམ་པ་པོ་ཁོ་རང་དང་།",
    "ཞེས་བྲིས་འདུག་པ་ལས་གཞན་ཅི་ཡང་མི་འདུག་འཕྲིན་ཡིག་སྤྲིངས་མཁན་གྱི་མཚན་བཀོད་མེད་ལ་སྦྲག་རྟགས་ཀྱང་སྦྱར་མི་འདུགསོ་ཧྥེ་ནང་ལ་འགྲོ་ཞོར་དུ་སྒོ་འཐེན་པ་དང་།",
    "ཞེས་བྲིས་འདུག་ལ།",
    "འོན་ཀྱང་ཡ་མཚན་པ་ཞིག་ལ་འཕྲིན་ཡིག་གཞན་ཞིག་འདུག་ད་དུང་དེ་སྔོན་མ་དང་གཅིག་མཚུངས་སུ་སྣང་།",
    "སྟེང་དུ་ནོ་ཝེའི་སྦྲགས་རྟགས་སྦྱར་འདུག་པ་མ་ཟད།",
    "ང་བྱ་སྒྲོ་སྤོ་ལོ་ལ་ཡང་དེ་འདྲ་སྤྲོ་བ་མི་འདུག་ཅེས་བཤད།",
    "ཞེས་བྲིས་འདུག་མཚན་ཉིད་རིག་པའི་ཀློག་དེབ་གྲགས་ཅན།",
    "དྲིས་ལན་ནི་མི་གཞན་གྱིས་འགྲོ་རོགས་དང་འདུག་རོགས་བྱེད་པ་དེ་ཡིན།",
    "དེ་ནི་ཁྱེད་རང་ནགས་ཚལ་དུ་འཆམ་འཆམ་ལ་འགྲོ་བའི་སྐབས་ཡིན།",
    "གལ་སྲིད་ཁྱེད་རང་འཐད་པ་ཡིན་ན།",
    "སུའེ་ཏེན་གྱི་ཡི་གེ་ཁྲོད་ཀྱི་ཐོག་ཅེས་པའང་དེ་ལྟར་བྲིས་འདུག་ལ།",
    "ཁྱེད་ལ་འཕྲིན་ཡིག་ཞིག་འདུག་ཅེས་བོས་པ་ན།",
    "ད་རུང་མཚན་ཉིད་རིག་པ་བ་ཞིག་ཡོད་པ་དེས་ཀྱང་རང་བྱུང་ཁམས་ཀྱི་སོ་ཧྥེ་ཡི་འཇིག་རྟེན།",
    "དེ་ཡང་རང་བྱུང་ཁམས་ཀྱི་ཆེས་ཆུང་བའི་རིལ་རྡུལ་དུ་འགྱུར་སྲིད་དོ།",
    "སྒོ་མདུན་གྱི་ཐེམ་སྐས་སྟེང་དུ་ཡིག་ཤུབས་ཆུང་ཆུང་ཞིག་བཞག་འདུག་པ་མཐོང་ལ།",
    "ཡིག་ཤུབས་ཀྱི་མཐའ་འཁོར་དེ་ཅུང་ཟད་རློན་པར་བྱས་འདུག་པ་མ་ཟད།",
    "ཁོ་རང་ལ་ཡིད་ཆེས་ཡོད་པ་ནི་རྡུལ་ཕྲན་དང་བར་སྟོང་ལས་མ་འདས་སོ།",
    "ད་ནི་འགྲིག་འདུག་སོ་ཧྥེ་ཡི་སེམས་ལ།",
    "སྐབས་ལ་ལར་ཁོང་ནི་ཆུ་ཚོད་ཁ་ཤས་ལ་ཀྲོང་ངེར་ལངས་ནས་བསམ་གཞིགས་དང་ཡང་ན་ཧོན་ཐོར་ནས་འདུགཡིན་ཡང་སྐབས་དེར།",
    "རྗེས་སུ་ཁོ་རང་ཡང་གནའ་ནས་ད་བར་གྱི་ཆེས་རླབས་ཆེ་བའི་མཚན་ཉིད་རིག་པ་བའི་གྲས་ཀྱི་གཅིག་ཡིན།",
    "ཁྱེད་རང་ཨ་ཐེན་མཁར་གྲོང་དུ་ཕེབས་པར་དགའ་བསུ་ཞུ།",
    "ཡིན་ཡང་གོན་པ་བརྗེས་འདུག་སོ་ཧྥེ་ཡི་འཇིག་རྟེན།",
    "འདི་གཏན་ནས་དཔེ་མི་སྲིད།",
    "ངས་བསམ་ན་ཁྱེད་ཀྱིས་ད་དུང་རྟོགས་མི་འདུགའཛམ་གླིང་ཡོངས་ཀྱི་རྟ་ཚང་མ་གཅིག་འདྲ་ཡིན་དོན་ཅིའི་ཕྱིར་ཡིན་ནམ།",
    "དེ་ནི་དཔེ་མི་སྲིད་པ་ཞིག་གོ།",
    "དེ་བཞིན་དུ་ཕི་ལ་ཐོ་ཡིས་ཀྱང་རང་བྱུང་ཁམས་ཀྱི་སྣང་ཚུལ་འདི་དག་ཐམས་ཅད་ནི་བདེན་གྲུབ་ཀྱི་རྣམ་པའམ་རྟོག་བཅས་ཀྱི་གྲིབ་མ་ཡིན་པར་འདོད།",
    "ཕི་ལ་ཐོ་ཡིས་དཔེ་དེབ་འདིའི་ནང་དུ་ཕུགས་བསམ་གྱི་རྒྱལ་ཁབ་ཀྱི་ངོ་བོ་ཡང་ཞིབ་འབྲི་བྱས་འདུག་ཕུགས་བསམ་རྒྱལ་ཁབ་ཟེར་བ་ནི་རྟོག་བཟོ་བྱས་པའི་ཕུགས་བསམ་གྱི་རྒྱལ་ཁབ་ཅིག་སྟེ།",
    "ད་དུང་མི་སྒེར་གྱི་རྒྱུ་ནོར་ཡོད་མི་ཆོག་དུས་མཚུངས་སུ་བྱིས་པ་གཉོར་སྐྱོང་བྱེད་པའི་འགན་ཅུང་ལྕི་བས།",
    "སོ་ཧྥེ་སྡོང་རྩ་རུ་བསྡད་ནས་ཕི་ལ་ཐོ་ཡི་གཞུང་ལུགས་ཀློག་བཞིན་ཅི་ཡིན་འདི་ཡིན་མ་ཤེས་པར་ཉི་མ་ཤར་ཕྱོགས་ཀྱི་ནགས་ཚལ་སྟེང་དུ་ཤར་འདུག་ལ།",
    "ཉི་མ་གནམ་སའི་འདྲེས་མཚམས་ཀྱི་མཐའ་མཇུག་དེ་ན་ས་ཆེན་གྱི་ཕྱོགས་སུ་རྒྱང་ལྟ་བྱེད་ཀྱིན་འདུགསོ་ཧྥེ་ལ་རང་ཉིད་ད་སོ་མ་ཕལ་ཆེར་ས་འོག་བྲག་ཕུག་ལས་ཡོང་བའི་སྣང་བ་སྐྱེས།",
    "འགྲམ་གཉིས་སུ་གསོམ་སྡོང་ཆེན་པོ་སྐྱེས་འདུག་པས།",
    "མཚོ་འགོག་དང་ཐག་མི་རིང་བའི་ས་ན་སྡོང་ལྕམ་དཀར་པོ་ཅན་གྱི་ཁང་པ་ཞིག་འདུག་གྲུ་མཛོད་དང་ཁང་པ་དཀར་པོ་གཉིས་ཀྱི་བར་ན་མེ་ཏོག་ལྡུམ་ར་མི་སྙོམས་པ་ཞིག་ཡོད་པའི་ནང་དུ་ཀུ་ཤུའི་སྡོང་བོ་ཞིག་དང་།",
    "གཞོགས་ནས་བརླག་འདུག་པས།",
    "གལ་སྲིད་ཁྱེད་རང་རླངས་འཁོར་ལ་མི་དགའ་ན་རླངས་འཁོར་ཁ་ལོ་བ་བྱེད་པར་མི་དགའ་བ་དང་།",
    "མས་ལས་པའི་སྐམ་ཤ་སྲེག་མ་དང་ཞོག་ཁོག་བཙོས་མ་དེ་ངོ་མ་ཞིམ་པོར་འདུག་ཅོག་ཙེའི་སྟེང་དུ་སྒྲོན་མེ་ཞིག་སྦར་ཡོད་ལ་ཟ་མ་ཟས་རྗེས་ཧ་ཅང་ཞིམ་པའི་འབྲུ་ཏ་ས་འཛིན་གྱི་དྲི་ཞིམ་ཞིག་ཀྱང་ཐུལ་ཡོང་།",
    "ཕི་ལ་ཐོ་ཡི་རྟོག་བཅས་སྨྲ་བའི་གཞུང་ལུགས་ཀྱིས་ཁྱེད་རང་ཧ་ལས་སུ་བཅུག་ཡོད་ཀྱང་སྲིད།",
    "ཡིད་སྐྱོ་བ་ཞིག་ལ་ངའི་ཀ་ར་ཞིག་དང་ལྷན་དུ་འགྲོགས་པའི་ཡིག་ཤུབས་དམར་པོ་དེའི་ནང་ཁྱེད་ཀྱིས་དྲིས་ལན་བསྐུར་བར་སྒུག་པའི་ཁོམ་ལོང་མི་འདུག་ལ།",
    "དེ་ནི་སྐར་མའི་གོ་ལ་ཡོད་དོ་ཅོག་དང་རང་བྱུང་ཁམས་ཀྱི་འགུལ་སྐྱོད་སྣ་ཚོགས་ཁྲོད་ཀྱི་དམིགས་རྐྱེན་ཡིན་ནོ།",
    "ཞོ་ཨེར་གྱིས་ད་སྐབས་སྒོའི་ཕྱི་རོལ་ན་ཙི་གུ་འཛིན་བཞིན་འདུག་དེ་ནི་ཞི་ལའི་ལྷན་སྐྱེས་ཀྱི་རང་གཤིས་ཡིན་ཕྱིར།",
    "ཚོང་ཟོག་འདིའི་ཁྲོད་ཀྱི་མང་ཆེ་ཤོས་ང་ལ་དགོས་མཁོ་མི་འདུག་གོ།",
    "འཇིག་པའི་དངོས་པོ་ཁོ་ན་ལ་བརྟེན་ནས་མི་འདུག་དེ་དང་མཉམ་དུ།",
    "གྷི་རི་སིའི་མིས་རང་ཉིད་ཚད་ལྡན་དང་རང་ལ་ཚོད་འཛིན།",
    "གྲུ་ཆུང་དེ་སྔར་མུས་སུ་བསྡད་འདུགཁྱེད་འདིར་ཤོག་ཅེས་ལག་བརྡ་བཏང་།",
    "ཆོ་ཨན་གྱིས་ཧ་ཅང་ཡག་པོ་འདུག་ཅེས་ལན་བཏབ།",
    "བྱ་བའང་རང་ཤུགས་ཀྱིས་སྟབས་བདེ་རུ་འགྱུར་འགྲོ་བར་འདོད།",
    "འདི་འདྲ་ཞིག་དཔེ་མི་སྲིད་ཅེས་བཤད།",
    "གནས་ཚུལ་ཅུང་ཙམ་རྙོག་འཛིང་ཆེ་བར་གྱུར་འདུག་སྟེ།",
    "དག་པའི་ཞིང་དང་རིང་པོ་མི་འདུག་ཅེས་གསུང་།",
    "འདི་དག་ཧ་ཅང་གལ་ཆེན་པོ་འདུག་འོན་ཀྱང་ཁྱེད་ཀྱིས་ཡིད་གཟབ་བྱེད་དགོས་སྟེ།",
    "ཤོག་བྱང་ཞིག་སྒེའུ་ཁུང་སྟེང་སྦྱར་འདུག་པ་མཐོང་།",
    "དོན་དག་ངོ་མ་རྙོག་འཛིང་ཆེན་པོ་འདུག་སོ་ཧྥེ་ཕྱིར་ལོག་ནས་མུ་མཐུད་དུ་དགོང་ཇ་བསྐོལ་རྒྱུར་སེམས་ཐག་བཅད།",
    "ཨོ་གྷི་སི་ཐིན་གྱིས་ལྷའི་རིག་པ་ནི་གྷི་རི་སིའི་ཨ་ཐེན་སིའི་མི་ཚུལ་རིང་ལུགས་དང་བྲལ་འདུག་འོན་ཀྱང་།",
    "དུས་ཚོད་བརྒྱད་པ་ལོན་འདུག་ང་རང་འགྲོ་དགོས་བྱུང་ཞེས་བཤད།",
    "ང་རང་མདང་དགོང་མཚན་ཧྲིལ་པོར་མ་གཉིད་པས།",
    "དུས་ཚོད་བདུན་དང་སྐར་མ་ཞེ་གསུམ་ལོན་འདུག་ངས་དུས་རབས་བར་མ་གླེང་མ་ཚར་གོང་དུ་ཕལ་ཆེར་ལོག་དགོས་སྙམ།",
    "ཁྱེད་རང་ཁྱིམ་དུ་ལོག་དགོས།",
    "ང་རང་ཅི་བྱ་གཏོལ་མེད་དུ་གྱུར་པས།",
    "འོན་ཀྱང་དྲི་བ་འདི་དག་ལ་ལན་འདེབས་མཁན་གཅིག་ཀྱང་མི་འདུག་ཅེས་ཟེར།",
    "སོ་ཧྥེ་ཡིས་མྱུར་བ་མྱུར་བར་ཁ་གཡར་ས་བཙལ་བཞིན་འདུགངས་དེ་ཡུལ་ལ་ཁྲིད་འགྲོ་ཞེས་ཟེར།",
    "སོ་ཧྥེ་ཡིས་ཕྲག་པ་འགུལ་ཙམ་བྱས་ནས་འདུགསྐེ་ན་ཕལ་ཆེར་སྡོད་གནས་ཡོད་པ་འདྲ་ཞེས་ལན་བཏབ།",
    "བྱ་བ་གང་ཡིན་རུང་གཟབ་ནན་དང་སྐྱོ་བ་ཕྱིར་མངོན་འདུག་ཟེར།",
    "ཁྱེད་རང་མགྱོགས་དྲགས་འདུག་ཡིན་ཡང་རིག་རྩལ་བསྐྱར་དར་སྐབས་སོ་ཧྥེ་ཡི་འཇིག་རྟེན།",
    "མི་གསོན་པ་ནི་ཤི་རྗེས་ཀྱི་འཇིག་རྟེན་ལ་གྲ་སྒྲིག་བྱེད་པ་དེ་རྟོགས་ཀྱིན་མི་འདུག་དེའི་སྟབས་ཀྱིས་ཁོ་ཚོས་ཕྱི་དངོས་པོའི་འཇིག་རྟེན་ལ་བཟུང་བའི་ལྟ་ཚུལ་ཡང་མི་འདྲ།",
    "བསམ་བློ་གཏོང་ཕྱོགས་གསར་པ་ཞིག་ལ་འགྲོ་བའི་དུས་ཤིག་ལ་གནས་འདུག་རིག་རྩལ་བསྐྱར་དར་གྱི་དུས་ལ་ཐོན་ཚེ།",
    "གསར་གཏོད་གསར་པ་རང་ཤུགས་སུ་ཡོད་འདུགཚན་རིག་གསར་པའི་བྱ་ཐབས་ལ་བརྟེན་ནས་ལག་རྩལ་གསར་བརྗེ་བྱུང་བ་དེ་ནི་དུས་རིམ་དང་པོ་ཡིན།",
    "དུས་རབས་བར་མའི་སྐབས་སུ་མིའི་རིགས་ཟླ་བའི་གོ་ལའི་སྟེང་འགྲོ་བཞིན་འདུག་དུས་སྐབས་དེར་མིའི་རིགས་ཟླ་བའི་གོ་ལར་འགྲོ་ཐུབ་པ་དེ་སུ་ཡིས་ཡིད་ཚེས་བྱེད་སྲིད།",
    "དངོས་བཤེར་གྱིས་བདེན་དཔང་མ་བྱས་ན་ཨ་རི་སི་ཏོ་ཏལ་གྱི་ནོར་འཁྲུལ་གྱི་ལྟ་བ་ཤེས་མཁན་མི་འདུག་སོ་ཧྥེ་ཡི་འཇིག་རྟེན།",
    "སོ་ཧྥེ་ཡིས་གནམ་རྒན་མ་ཆུ་ཚོད་བཞི་ལྷག་ལ་ཐོན་འདུག་ཅེས་འུར་བརྒྱབ།",
    "ཧན་མེ་ཧྲི་ལྭ་བ་འགལ་སའི་འོག་ཏུ་ཉལ་འདུག་ལྭ་བ་འགལ་སའི་སྟེང་ལ་སོ་ཧྥེ་ཡི་འཇིག་རྟེན།",
    "འོན་ཀྱང་ང་ངལ་དུབ་ཀྱིས་མནར་འདུག་པས་ཉལ་རྒྱུ་ཡིན།",
    "ད་དུང་ཟླ་མཚན་ཡང་འོང་བཞིན་འདུག་མཚན་ཉིད་རིག་པའི་ཀློག་དེབ་གྲགས་ཅན།",
    "སོ་ཧྥེ་གཉིད་འདུག་སོ་ཧྥེ་ཡི་འཇིག་རྟེན།",
    "སྐབས་དེར་ཚན་རིག་ལག་རྩལ་ཕྱོགས་ཀྱི་ཡར་རྒྱས་དང་རང་བྱུང་ཁམས་ཀྱི་འདུ་ཤེས་གསར་པ།",
    "གལ་སྲིད་ཁྱེད་རང་འཐད་པ་ཡིན་ན།",
    "ཁོ་ཚོ་སྔོན་མའི་འདུག་གནས་དེ་ནས་བསྡད་ཡོད།",
    "འགྲིག་འདུག་སོ་ཁི་ར་ཐེ་དང་ཕི་ལ་ཐོ།",
    "གློག་ཀླད་ཀྱི་ངོས་སུ་དྲིས་ལན་འདི་ལྟར་འཆར་འདུགསྲང་ལམ་གསུམ་པ།",
    "དེ་མ་ཟད་ངས་ཁྱེད་རང་དམ་པོར་འཐམས་ན་འདོད།",
    "འདིར་གོང་མ་ཡུང་ལོ་ཞེས་བཀོད་འདུག་ཀྱང་།",
    "པ་མཚོན་འདུག་ཅེས་པའི་དགོངས་བཞེད་བཞིན།",
    "འཁོར་ཁང་དང་བཅས་པ་བཞེངས་འདུག་པ་ཀུན་གྱིས་མཐོང་གསལ་ལྟར་ཡིན།",
    "མཐོ་ཚད་ལ་སྨི་གཅིག་དང་ཕྱེད་ཀ་ཙམ་འདུགགཡས་ཕྱོགས་སུ་གསེཪ་ཁྲི་སྐུ་ཕྲེང་གཉིས་པ་བློ་བཟང་བསྟན་པའི་ཉི་མའི་དཀར་གདུང་བཞུགས་ཤིང་།",
    "མཐོ་ཚད་ལ་ཁྲུ་གང་ཙམ་འདུག་དེའི་གཡས་སུ་བྱམས་སྐུའི་ཀུན་དགའ་ར་བ་བཞུགས་ཤིང་།",
    "མཐོ་ཚད་ལ་སྨི་གཅིག་དང་ཕྱེད་ཀ་ཙམ་འདུགབཞུགས་ཁྲིའི་རྒྱབ་ཏུ་རྗེ་ཡབ་སྲས་གསུམ་ལ་རྒྱན་དྲུག་མཆོག་གཉིས་ཀྱིས་བསྐོར་བའི་གྱན་ཐང་བཞུགས།",
    "འདིར་གོང་མ་ཡུང་ཏྲི་ཞེས་འཁོད་འདུག་ཀྱང་།",
    "སྤྱི་ལོ་ལོ་དགུང་ལོ་དོན་བཞི་བར་གསེར་ཁྲི་རིན་པོ་ཚེ་འདི་བ་ཚང་རང་དགོན་ནས་སྐུ་གཤེགས་སོ།",
    "བྱེ་བྲག་ཏུ་གོང་ས་ཁོང་རང་ཉིད་ནས་ལྷ་སར་ཕེབས་པའི་ཞབས་གྲས་ལེའུ་གཉིས་པ།",
    "གྲགས་རྒན་བླ་བྲང་གསུམ་བཞུགས་པ་ལས་གཞན་རྣམས་མཁར་ཤུལ་ཙམ་མ་གཏོགས་ལུས་མི་འདུགགཉིས།",
    "དགེ་རྩ་དེ་ཉིད་ཁོ་རང་ལ་ཕན་པའི་ཐབས་སུ་འགྱུར་ངེས་བྱའོ།",
    "གཞུང་གཉེར་དང་དཀོན་གཉེར་ལས་འཛིན་པ་རྣམས་ནས་རང་རང་ལ་གཉེར་དུ་གཏད་པའི་མཆོད་རྫས་དང་སྤྱི་རྫས་དངོས་པོ་ཆེ་ཕྲ་གང་ཡོད་འཁྱར་གོད་དང་ཆུད་ཟོས་སུ་ཅི་ཡང་མི་གཏོང་བར་ལས་འཛིན་རྗེས་མ་རྣམས་ལ་རྩིས་སྤྲོད་བཟང་བོ་བྱེད་དགོས།",
    "ག་དུས་རབས་བཅོ་བརྒྱད་པའི་དུས་འགོར།",
    "མི་དང་རང་བྱུང་ཁམས་བར་གྱི་འབྲེལ་བ་ཐག་གཅོད་བྱེད་པའི་ཕྱོགས་སུ་བབ་སྤྱོད་ཀྱི་བསམ་གཞིགས་ཁ་ཤས་ལས་རིང་དུ་བརྒལ་ཏེ།",
    "དེ་མིན་མི་དང་རང་བྱུང་གཉིས་རོ་གཅིག་ཏུ་གྱུར་བ་ཞིག་དང་།",
    "བྱ་བ་གང་ལའང་རང་འདོད་ཆུང་བར་མཛོད།",
    "ཞེས་བཀོད་འདུག་པ་ལྟར་ན།",
    "དེ་ནས་སྒྲུབ་རྟགས་གཉིས་ཀྱི་ཁྱབ་འབྲེལ་དེ་ཡང་རང་བཞིན་ངེས་བྱེད་དང་།",
    "རྒྱུ་འབྲས་ངེས་བྱེད་དང་རང་བཞིན་ངེས་བྱེད་གཉིས་ཀྱིས་ངེས་དགོས་སོ་ཞེས་པ་ནི།",
    "བཞི་པ་ནི་འབྲས་བུ་དང་རང་བཞིན་ཅན།",
    "རྒྱུ་དང་རང་བཞིན་ལ་མི་འཁྲུལ་བ་དེའི་ཕྱིར།",
    "འབྲས་རྟགས་ལ་དེ་བྱུང་འབྲེལ་པ་གྲུབ་ཀྱང་རང་བཞིན་རྟགས་ལ་ཅི་ལྟ་བུའི་མེད་ན་མི་འབྱུང་ཡོད་པ་ཡིན་ཞེ་ན།",
    "མི་རྟག་པ་དང་རང་བཞིན་ཐ་དད་མེད་པར་གཅིག་ཡིན་པའི་ཕྱིར་རོ།",
    "སྤྱི་ཡི་དོན་ཅན་གྱི་རྣམ་པར་རྟོག་པ་ཡིན་པ་གང་ཞིག་དེ་སེལ་འཇུག་ཏུ་ཁྱེད་རང་འདོད་པའི་ཕྱིར་ཞེ་ན།",
    "གཞན་དག་རིགས་མི་མཐུན་ལས་ལོག་པའི་ཆ་རང་རང་ལ་ཡོད་པ་དེ་ཉིད་ལ་སྤྱིར་འདོགས་པའི་ལན་ཡང་གསུངས་ལ་ཞེས་འཆད་པ་གཉིས་ཀ་ཡང་མི་འཐད་དེ།",
    "འཁྲུལ་པ་ཡིན་ཡང་རང་མཚན་ཐོབ་པའི་རྒྱུ།",
    "དེས་ན་དུ་མའང་རང་བཞིན་གཅིག་པར་འབྲས་བུ་གཅིག་བྱེད་དོ་ཞེ་ན།",
    "གནས་སྐབས་མི་རྟག་ཀྱང་རང་བཞིན་རྟག་པའི་ཕྱིར་ཞེ་ན།",
    "བ་ལང་རང་མཚན་པ་ལ་འཇུག་པའི་ཚེ་ན་ཡང་གཞན་སེལ་གྱི་སྒོ་ནས་འཇུག་རིགས་ཀྱི་སྤྱི་དངོས་པོ་བའི་སྒོ་ནས་འཇུག་མི་རིགས་ཏེ།",
    "སྣང་རུང་རང་བཞིན་བཀག་པས་འགྲུབ་པའོ།",
    "རང་མཚན་ལ་མཐའ་གཅིག་ཏུ་འཇུག་པ་ཅན་ཉིད་ཡིན་པས་སྒྲ་དོན་དང་རང་མཚན་གཅིག་པའི་ཕྱིར་ཞེ་ན།",
    "རིག་བྱེད་དེ་དོན་དང་རང་བཞིན་གྱིས་འབྲེལ་ན་དོན་གཅིག་ཁོ་ནའམ་དུ་མ་དང་རང་བཞིན་གྱིས་འབྲེལ།",
    "དངོས་པོར་ཡོད་པ་ཙམ་དང་རང་ཆས་སུ་འབྲེལ་བ་ཅན་ཉིད་ཡིན་ཏེ།",
    "གལ་ཏེ་ཤིང་དེ་དངོས་པོ་མེད་པའི་ཞིག་པ་དེ་རང་རྒྱུ་ལས་རྒྱུ་གཞན་ལ་ལྟོས་པ་མེད་པར་ཤིང་རང་ཉིད་གྲུབ་ཙམ་ལས་ཡོད་ན་ཡང་འཇིག་པ་དེ་ཤིང་དང་གཅིག་གམ་ཐ་དད་ཅེས་པའི་རྣམ་རྟོག་འདི་ནི་མཚུངས་ཏེ།",
    "རང་རང་སྐྱེ་སའི་གཅེས་པའི་ཕ་ཡུལ་ལགས།",
    "སྲོག་ལྡན་གྱི་ཡོ་ལང་འཁྲུག་དུས།",
    "ད་ནས་བཟུངཕྱག་དང་བསྟོད་པའི་ཡུལ་དུ་ཁྱེད་རང་བཀུར།",
    "བྲོ་བ་མི་འདུགཡང་ན་ཐམས་ཅད་ས་ཟ་རྡོ་འཆའ་བ་བཞིན་དུ་དྲོ་བས་དབེན།",
    "ཏིང་ལིང་ལིངཕ་ཡུལ་ནས་ཚྭ་ཁུག་མ་གང་བསྐུར་འདུགཡ་ཡ་ཡ་ཡ་ཡ་ཡམེས་པོའི་ཨ་ལན་ལ་སྐྱར་ཟློས་གལ།",
    "ག་དུས་ཡིན་ནའང་།",
    "སླར་ཡང་རི་འདིའི་པང་དུ་ལོག་དུས།",
    "ནམ་མཁའ་ནི་ཆང་འཐུང་ཞག་འདུག་ཞིག་གོ་ཁའི་རུལ་མ་ཞིགགནག་ཅིང་གཉེར་བའི་ངོ་ཡིས་འཁང་ར་བྱེད།",
