    "བསྒྲུབས་པ་མཐའ་དག་ཀྱང་དེ་སྔར་ངའི་ཀོ་ལྷམ་ཕྱིས་པ་ཇི་བཞིན་ཧ་ཅང་གྲ་དག་ཅིང་བློར་འབབ་པར་འདུག་ལ།",
    "གང་ལྟར་ཧཱ་པ་ངའི་རྗེས་སུ་འབྲངས་པ་ནས་བཟུང་མི་གཞན་གྱི་སྟེང་ལ་ཁ་ཕོ་ཇེ་ཆེར་འགྲོ་བ་དང་རང་ཉིད་ཀྱི་སྣང་བ་ཡང་དེ་དང་ལྷན་དུ་ཇེ་མཐོ་རུ་འགྲོ་བཞིན་འདུག་པས།",
    "ཅུང་ཙམ་ལ་འདང་ཞིག་བརྒྱབ་ཀྱང་དེ་ནི་དཔེ་མི་སྲིད་པ་ཞིག་ཡིན་པས་འདང་རྒྱབ་རྒྱུ་ཅི་ཡོད།",
    "ཁོའི་དམིགས་ཡུལ་ནི་ང་ཧཱ་པར་བསྒྱུར་རྒྱུ་དེ་ཡིན་འདུག་ང་གཏན་ནས་མི་འཐད།",
    "ཉིན་གུང་རང་ཁྱིམ་དུ་འཁོར་ནས་ཀྱང་མུ་མཐུད་དུ་ཧ་པའི་དོན་དག་དེའི་ཕྱོགས་ལ་བསམ་བློ་བཏང་བ་ཡིན།",
    "ཧཱ་པས་ཉམས་འགྱུར་ལྡན་ཞིང་སྐད་གསང་མཐོན་པོས་སྐྱོན་བརྗོད་ཡི་གེ་འདོན་གྱིན་འདུག་ཀྱང་།",
    "ངས་ད་བར་དུ་མི་ནི་ནམ་ཡང་སྐད་ཆའི་ཟིལ་ཤུགས་ཁོ་ནའི་འོག་ནས་གཉོམ་ཆུང་ནུས་མེད་ངང་འཚོ་བཞིན་པའི་སྲོག་ཆགས་ཤིག་ཡིན་པར་དོ་སྣང་ཅི་ཡང་བྱས་མི་འདུག་ལ།",
    "ཁོའི་གདོང་ལ་རྒྱལ་ཁའི་གཟི་མདངས་ཤིག་ཤར་ནས་འདུག་ཀྱང་ང་མཐོང་འཕྲལ་དེ་མ་ཐག་ཧ་ཅང་གུས་པའི་ཚུལ་གྱིས་སྣ་རྗེ་རྗེ་བྱས་བྱུང་བས།",
    "ཁོས་ལས་གྲོགས་ཚང་མ་བསླུ་བྲིད་བྱས་ཏེ་ཁོའི་ཕྱོགས་སུ་བསྐོར་འདུག་པར་མ་ཟད།",
    "དེ་སྔོན་ཁོ་ལ་ཤ་ཚ་མཁན་ངེད་གཉིས་ལས་མེད་ནའང་ད་ལྟ་དེ་ལས་ལྡོག་སྟེ་ངེད་གཉིས་ཀར་ངན་གཏམ་གྱིན་འདུག་པས།",
    "ཁྱིམ་དུ་མགྲོན་པོ་གཅིག་ཀྱང་མི་འདུག་ལ།",
    "འདིར་ཤོག་ཅི་འདྲའི་འདྲིས་སླ་བ་ལ་ཨང་ཟེར་བཞིན་སླར་ཡང་ཧཱ་པ་པང་དུ་བླངས་ན་ས་ཁ་རྩེས་ནས་སྡོད་པ་ལས་ང་ལ་ཁ་བརྡ་གཞན་མི་བྱེད་པར་འདུག་པས།",
    "ཐ་ན་ངའི་བྱ་བའི་སྒྲུབ་སྟངས་ཐད་ནོར་འཁྲུལ་ཡོད་ཚུལ་གྱི་སྐད་ཆའང་མངོན་སུམ་དུ་འཆད་ཀྱིན་འདུག་སྐབས་དེར་ཁོའི་སྤྱོད་སྟངས་དེའི་རིགས་ལ་ཞེ་གཏིང་ནས་དགོད་རྒྱུ་ཡོང་ནུའང་རྣམ་འགྱུར་ཅི་ཡང་མངོན་དུ་བཅུག་མ་མྱོང་ཐེངས་ཤིག་ལ།",
    "གང་ལྟར་ཁྱི་ཤ་ཟ་བ་ཕར་ཞོག་ཁྱི་ཤ་ཟ་བའི་གམ་དུའང་འདུག་མི་འདོད།",
    "ཡིན་ནའང་དོ་དགོང་ཕལ་ཆེར་མི་འདུག་ག་མེད་ཡིན་པ་འདྲ།",
    "ངའི་སེམས་ལ་ཧྭ་པ་ནི་ཁྱི་རིགས་ཡིན་པས་ཁྱི་ཤ་ཟ་མི་སྲིད་སྙམ་སྟེ་ཡོད་ཙ་ན།",
    "ཧཱ་པ་འདི་ང་ལ་ཧ་ཅང་དུང་བར་འདུག་པ་དང་ད་ལྟ་ང་ལའང་ཧཱ་པ་ཞིག་མཁོ་བས།",
    "ངས་སླར་ཡང་རང་ཉིད་ཀྱི་ཀོ་ལྷམ་ལ་བལྟས་པ་ན།",
    "མཉམ་ཞིག་བཞག་དུས་ལས་གྲོལ་གྱི་དུས་ཚོད་འདས་ནས་རབ་ཅིག་ཟིན་པར་མ་ཟད་སའང་སོས་ནས་ཡུན་རིང་འགོར་འདུག་ངས་དངན་པ་ཞིག་དང་ལྷན་དུ་ཐ་མག་ཆུང་ཞིག་བླངས་ནས་མེ་བསྒྲོན་ཏེ་རྡུབ་འཐེན་འགའ་བྱས་པ་ན།",
    "ཡིན་ནའང་ལམ་སྒྲོན་གྱི་འོད་ཀྱིས་མ་ཁྱབ་པའི་མཁར་གྲོང་འདིའི་ཕྱོགས་བཞིའི་མུན་ཀློང་དུ་ཧ་པ་མང་བོའི་ཟུག་སྐད་འུར་ཆིལ་ལེར་འདུག་པས།",
    "གལ་སྲིད་ཨ་ཐང་ཆད་འདུག་སྐབས་དཔའ་རྩལ་དང་དཔུང་པ་འགྲན་དགོས་ན།",
    "རྟ་ལ་འདི་ལྟར་ཞོན་དགོས་ཟེར་ནས་སྲབ་དཀྱོག་དང་སྲབ་མདའ་བཟུང་འདུག་པའི་གཡོན་ལག་སྔ་རུའི་སྒ་ཁུང་ལ་འཇུས།",
    "དངན་པའི་རྗེས་ལ་ཇག་གླུ་དེ་མཐུད་ནས་མི་འདུག་ཀ་མེད་བྱུང་།",
    "རྟ་ཁྱུ་དྲན་ནས་འདུག་མ་བཟོད་ན།",
    "འབྲེལ་ཡོད་མཁས་པས་འཛམ་གླིང་ཡོངས་ན་ཇག་གླུ་ཟེར་བ་ལ་ཇག་གླུ་ཆུ་བོ་དལ་འབབ་གཅིག་པུ་ལས་མི་འདུག་ཅེས་བརྗོད་དེ།",
    "ལས་གྲོགས་སྔར་ལྟར་ཅི་མི་སྙམ་པར་འདུག་དོ་ནུབ་འུ་གཉིས་ཀ་འཁྱགས་ཤི་ཐེབས་ངེས།",
    "སྦྲ་ངོར་དཔྱངས་པའི་ཉི་འོད་ནུས་པའི་གློག་སྒྲོན་ལས་མིག་ལ་མི་གཙེ་བའི་འོད་སྣང་དཀར་པོ་ཞིག་སྦྲ་ནག་ཧྲིལ་བོར་འཕྲོས་ནས་འདུག་སྐབས་དེར།",
    "ཁྱི་རྒྱུ་བོ་ཡ་མེད་ཅིག་མི་འདུག་གམ།",
    "སྦྲ་ནང་དུ་གྲག་འགུལ་ཅི་ཡང་མི་གདའ།",
    "ཡིན་ནའང་ད་ཆ་སྤྱང་ཀི་ཤོག་སྦག་ལ་དྲེད་འདུག་འེ།",
    "ཁྲིད་ནས་འགྲོ་བཞིན་འདུག་ཟེར་ངོ་མ་དགོད་བྲོ་ཡོང་།",
    "ལག་སྒྲོན་གྱི་འོད་སྣང་ཁྲོད་ཁ་བ་སྔར་བཞིན་འབབ་ཀྱིན་འདུག་ལ།",
    "ལུག་ཁྱུ་ན་མིག་ཟུང་མང་བོ་ལྗང་ཀྲིག་ཀྲིག་འཚེར་གྱིན་གདའ།",
    "ང་ཁོའི་གམ་དུ་འདུག་པའི་ཚུགས་ཀ་ཙམ་ཡང་མ་བསྟེན་པར་མ་ཟད།",
    "ཁོ་དངོས་གནས་སྐོམ་གྱིན་འདུག་དེ་ནི་ཁོས་མདང་ནུབ་ཨ་རག་མང་བོ་འཐུངས་པའི་རྐྱེན་གྱིས་ཡིན།",
    "མཐུད་ནས་ཁོས་ཁང་པའི་ནང་ཧྲིལ་བོར་ཞིབ་ལྟ་བྱས་པ་ན་མདང་ནུབ་ཉལ་ཁར་ད་དུང་ཟེད་ཟེད་ལང་ལོང་དུ་འདུག་པའི་ཁང་བའི་ནང་ཧྲིལ་བོར་ས་རྡུལ་ཙམ་ཡང་མེད་པར་གཙང་ཞིང་གྲུ་དག་པར་འདུག་པས།",
    "ཁོ་ལ་དུས་རྒྱུན་ལས་ཀྱང་གཙང་ཞིང་གྲ་དག་པར་འདུག་པའི་སྣང་བ་ཞིག་བྱིན།",
    "ང་དང་ཐོག་ཁྱེད་ལ་དགའ་བའི་རྒྱུ་རྐྱེན་ཡང་དེར་ཐུག་འདུག་སྙམ།",
    "ཁྱེད་རང་འཕུར་ཤོག་ཁྱེད་ཀྱིས་དྲོ་འཇམ་གྱི་ནམ་ཟླ་དྲན་ན།",
    "ས་ཡང་རུབ་འདུག་པས།",
    "དཀའ་ཁག་ཅི་འདྲར་ཕྲད་ཀྱང་རང་ཚུགས་འབོར་མི་ཉན།",
    "ཁོ་འཆུགས་འདུག་དེ་ནི་དེ་ཚོས་ཁོ་དང་ནམ་ཡང་བར་ཐག་ཅིག་ཡོད་དུ་བཅུག་ཡོད་པ་མ་ཡིན་ནམ།",
    "དགའ་དགའ་ཡི་ལུས་ཀྱི་ཤ་དྲོད་སྔར་ནས་ཉམས་འདུག་ཁོས་དགའ་དགའ་ཡི་དབུགས་ཀྱི་རྒྱུ་བ་འགགས་འདུག་པ་ཤེས།",
    "མགོར་གོན་ན་ཤིན་ཏུ་མཛའ་བས་བལྟས་པ་ཙམ་གྱིས་མཛེས་ཉམས་ཐོན་འདུག་ཅེས་བསྔགས་མྱོང་།",
