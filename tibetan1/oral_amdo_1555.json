    "བུ་མོ་ང་ལ་མཁོ་བ་ཁྱེད་གཅིག་པུ་ལས་མེད།",
    "རེ་བར་ཁྱེད་ཀྱིས་ངའི་བྱས་ཉེས་ལ་གུ་ཡངས་གནང་སྟེ།",
    "མཚར་སྡུག་གི་པད་མའི་འཛུམ་མདངས་བསྣམས་ནས་བུ་མོ་ངའི་འགྲམ་ལ་གང་མགྱོགས་ཕྱིར་ལོག་གནོངས་དང་།",
    "༩༢ལོའི་ཟླ་༨པའི་ཚེས་༡༢ཉིན་ཁྱེད་ལ་དགའ་ཞིང་དུང་བའི་ཆུང་མ་འཛོམས་པ་སྐྱིད་ནསམོས་འཕྲིན་ཡིག་དེ་བྲིས་ཟིན་རྗེས།",
    "མིག་ཟུང་གི་ཁྱོན་ལ་མཆི་ཞག་འཁོར་འདུག་ཁྱོ་ག་ལྷ་སར་སླེབས་པའི་གནས་ཚུལ་ཤེས་རྗེས་མོའི་སེམས་པ་རེ་ཞིག་ལྷོད་ལ་བབས་བྱུང་།",
    "ཆུང་མ་དང་ཁ་བྲལ་བའི་ཉིན་དེ་དག་གི་རིང་ཨ་ཇོ་རྣམ་རྒྱལ་ཡང་སེམས་པ་སྐྱིད་པོ་གཏན་ནས་མ་བྱུང་།",
    "མིག་ཟུང་གི་འོད་མདངས་ཀྱང་ཉམས་ཏེ་རབ་རིབ་ཏུ་གྱུར་འདུག་ཁོས་ཆུང་མར་བཙན་གཡེམ་བྱེད་མཁན་གྱི་སྐྱེས་པ་དེ་ལ་སེམས་གཏིང་ནས་ཁོང་ཁྲོ་ལངས་ཤིང་ཞེ་སྡང་དྲག་པོ་སྐྱེས་འོང་།",
    "ཁོས་སྔ་ཕྱིར་ཆུང་མར་བཙན་གཡེམ་བྱས་ཏེ་རང་ཉིད་ཀྱི་ཁྱིམ་ཚང་དྲོན་མོ་དེ་གཏོར་བཤིག་ཏུ་གཏོང་མཁན་གྱི་མི་ངུ་ཐ་ཤལ་བ་དེ་བཙལ་ནས་དགྲ་ཤ་ལེན་རྩིས་ཐེངས་མང་བྱས་མྱོང་།",
    "ལྷག་པར་དུ་མཚན་མོ་མང་པོའི་རྨི་ལམ་གྱི་ཞིང་ཁམས་སུ་ཁོས་མི་དེ་བཙལ་ནས་ཁོ་དང་ཁྱོད་ཤི་ང་གསོན་གྱི་འཐབ་འཛིང་དྲག་པོ་བྱེད་བཞིན་པ་རྨིས་མྱོང་།",
    "མི་དེ་བཙལ་ནས་ཁྱོད་ཤི་ང་གསོན་གྱི་འཐབ་འཛིང་བྱས་ཀྱང་།",
    "གནས་ཚུལ་དེ་དྲན་ཐེངས་རེར།",
    "དེ་ནི་ཁོའི་མི་ཚེའི་བགོ་སྐལ་རེད།",
    "སྐྱོ་གདུང་གིས་མནར་བའི་ཚུགས་ཀ་དེ་མཐོང་སྐབས་སེམས་ཀྱིས་མ་བཟོད་པར།",
    "ད་སེམས་སྡུག་མ་བྱེད་ཅིག་རང་ཉིད་སྡུག་ལ་གཏད་མཁན་གྱི་བུ་མོ་དེ་འདྲའི་ལུས་ཐོག་ཏུ་སེམས་པ་གཏད་དགོས་དོན་མེད།",
    "ངོ་ཚ་སྤངས་པའི་འཕྱོར་མོ་དེ་ཡིན་ན།",
    "ཁོས་ཀྱང་བུ་མོ་དེ་དང་གཉེན་ཐོར་ཏེ་འཚོ་བ་གསར་བ་ཞིག་སྐྱེལ་བའི་བསམ་བློ་འཁོར་མྱོང་།",
    "བུ་མོ་གསར་བ་ཞིག་དང་ལྷན་དུ་སླར་ཡང་འཚོ་བ་གསར་བ་ཞིག་གི་འགོ་བརྩམ་དགོས་ན།",
    "ལོ་ངོ་ཇི་ཙམ་འདས་པ་མོའི་ཡིད་ངོར་གསལ་ཆ་མིན་འདུག་མོས་སྔར་རྒྱུན་བཞིན་གཙང་ངོགས་དེར་འགྲེངས་ནས་རྒྱང་རིང་གི་ལྷ་སའི་ཕྱོགས་སུ་མིག་ཟུང་ཅེར་བཞིན་འདང་རྒྱག་གི་ཀློང་དུ་ཚུད་འདུག་ད་རེག་བར་དུ་ཁྱོ་གའི་འཕྲིན་ཡིག་གཅིག་ཀྱང་མོའི་ལག་ཏུ་མ་འབྱོར།",
    "ལོ་ངོ་དེ་དག་གི་རིང་།",
    "མིག་ཟུང་གཉིས་པོར་འོད་ཀྲིག་ཀྲིག་གི་གྲུང་ཤ་ཅི་ཡང་མེད་པར་ཉོབ་མདངས་ཤིག་དང་རེ་ཆད་ཀྱི་སྣང་བ་ཞིག་ཕྱིར་ཕྱུངས་འོང་།",
    "ཁྱོ་ག་སྔ་མཇུག་གི་ཁྱད་པར་ཙམ་ལས་མཐའ་མཇུག་རང་གི་གམ་དུ་ཕྱིར་ལོག་བྱ་ངེས་ཡིན་མོས་ཉིན་ལྟར་དེ་སྐད་སྨྲ་ཞོར་རང་སེམས་ལ་སེམས་གསོ་དང་གུ་ཡངས་ཐོབ་པར་རེ་བཞིན་འདུག་མོས་ཀྱང་རང་གི་ཁྱོ་ག་ལ་རྒྱུས་མངའ་ཆེན་པོ་ཡོད།",
    "ཁྱོ་ག་ཁོང་ཁྲོ་ལངས་སྐྱེན་པས་མ་གཏོགས་སེམས་པ་བཟང་བས།",
    "ནམ་ཞིག་ཁོ་རང་གི་ཁོང་ཁྲོ་དེ་ཞི་གྱུར་ན།",
    "ཕྱིར་ཁྱིམ་ལ་ལོག་ཡོང་རྒྱུར་མོར་ཡིད་ཆེས་བརྟན་པོ་ཡོད།",
    "ཁྱོ་གས་རང་ཉིད་དང་བཙས་མ་ཐག་པའི་བྱིས་པ་དེ་ཤུལ་དུ་བསྐྱུར་ནས་མི་ཚེ་གང་བོར་ཁ་ཡ་མི་བྱེད་པ་གཏན་ནས་བྱ་མི་སྲིད།",
    "མོས་དེ་ལྟར་རང་ཉིད་ལ་སེམས་ཤུགས་དང་བློ་སྟོབས་བཙལ་ནས་རེ་བ་རྟ་རྔ་ཙམ་ཞིག་ལས་མེད་ཀྱང་ཁྱོ་ག་ཕྱིར་ལོག་ཡོང་རྒྱུའི་འདུན་པ་དྲག་པོ་རྦ་བཞིན་མཁའ་ལ་འཕྱུར་ཏེ་གཏན་ནས་མཚམས་འཇོག་བྱས་མ་མྱོང་།",
    "སླར་ཡང་གཉིད་མི་འོང་བའི་མཚན་མོ་ཞིག་རེད།",
    "ཨར་ཁང་གི་སྒོ་ནང་དུ་འཛུལ་རྗེས།",
    "གྲོགས་པོ་བསྟན་འཛིན་སྔ་མོ་ནས་སླེབས་འདུག་ཁོས་ཨ་ཇོ་རྣམ་རྒྱལ་མཐོང་མ་ཐག་ལག་པ་གཡུག་གཡུག་གིས་ལག་བརྡ་ཞིག་བྱས་ཏེ་ཨ་ཇོ་རྣམ་རྒྱལ་ཚུར་རང་གི་གམ་དུ་ཡོང་དགོས་པའི་བརྡ་བྱས།",
    "དོ་ནུབ་ཁྱོད་ལ་ཅི་ཞིག་བྱས་སོང་།",
    "ཁོའི་ངོ་གདོང་གི་ཁྱོན་ལ་ཞིབ་ལྟ་ཞིག་བྱས།",
    "སྔོན་ཆད་ཀྱི་འཛུམ་མདངས་ད་ལྟ་མིག་ཟུང་གི་མཐོང་ཡུལ་དུ་མེད་ཅིང་།",
    "དུས་རྒྱུན་སྣུམ་ཞག་ལྡན་ལ་སྤྲོ་སྣང་གིས་ཕྱུག་པའི་བཞིན་རས་ད་ཆ་སྐྱ་བོར་གྱུར་བ་མ་ཟད།",
    "ཁྱོད་ངོ་མ་རྒས་འདུག་སེམས་ལ་མི་སྐྱིད་པའི་དོན་དག་ཅི་ཞིག་ཡོད་རུང་ང་ལ་དྲང་པོར་ལབ་དང་།",
    "གཅིག་བྱས་ན་ངས་ཁྱོད་ཀྱི་དཀའ་སྡུག་སེལ་བར་ཕན་ཐོགས་ཡོང་ཞེས་བཤད།",
    "ཨ་ཇོ་རྣམ་རྒྱལ་གྱིས་སྒྲོག་རྩེའི་ཐོག་གི་ཆང་ཕོར་ཚུར་བླངས་ནས་དབུགས་ཐེངས་གཅིག་ལ་གཙང་མར་བཏུང་རྗེས།",
    "ར་མ་བཟི་བར་དུ་སུ་ཡང་ཁྱིམ་ལ་སྔོན་དུ་ལོག་མི་ཆོག་ཅེས་སྨྲ་བཞིན་སླར་ཡང་སྒྲོག་རྩེའི་ཐོག་གི་ཆང་ཕོར་ཚུར་བླངས་ནས་དབུགས་ཐེངས་གཅིག་ལ་གཙང་མར་བཏུང་།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་ང་བློས་ཐུབ་ཀྱི་གྲོགས་པོར་བརྩི་བཞིན་ཡོད་ན།",
    "དོ་ནུབ་ཁྱོད་ཀྱི་སེམས་གཏམ་ཡོད་ཚད་ང་ལ་དྲང་པོར་བརྗོད་དགོས་ཞེས་གྲོགས་པོ་བསྟན་འཛིན་གྱིས་ཨུ་ཚུགས་བྱས་པས།",
    "ཁྱོད་ཀྱི་ཆུང་མར་བཙན་གཡེམ་བྱེད་མཁན་དེ་སུ་རེད།",
    "བྱོལ་སོང་དེ་ཡིན་ན།",
    "མ་གཞི་བྱས་ན་མི་བྱེད་དགུ་བྱེད་བྱེད་མཁན་མོ་རང་གི་གྲོགས་མོ་བསམ་སྐྱིད་དང་མི་ངན་དེ་རེད།",
    "ཁོ་ཚོས་ཁྱོད་ཀྱི་ཆུང་མ་ར་བཟི་བའི་གོ་སྐབས་དང་བསྟུན་ནས།",
    "ད་གཟོད་ཐུབ་ཚོད་དང་བརྙས་བཅོས་བྱས་པ་མ་རེད་དམ་གྲོགས་པོ།",
    "ཁྱོད་ཀྱིས་རང་ཉིད་ཀྱི་ཆུང་མར་ཡིད་ཆེས་བྱ་དགོས།",
    "ཁོ་མོའང་གཞན་གྱི་བསླུ་བྲིད་ཀྱི་འོག་ཏུ་ཚུད་ནས་ད་གཟོད་སྡུག་ལ་གཏད་པ་མ་རེད་དམ་ཁྱོད་ཀྱིས་ཆུང་མས་རང་ཉིད་ལ་བཅངས་པའི་ལྷད་མེད་ཀྱི་བརྩེ་དུང་དེ་ལ་ཡིད་ཆེས་བྱ་དགོས།",
    "མོས་ད་རེག་བར་དུ་ལང་ཚོ་སྟོང་བཞིན་ཁྱོད་ཕྱིར་ལོག་བྱ་རྒྱུར་རེ་སྒུག་བྱས་ནས་སྡོད་སྲིད་དམ་གལ་ཏེ་ཁྱོད་ཀྱིས་མོ་ལ་དངོས་གནས་དགའ་ན།",
    "ཁོ་མོར་བདེ་སྐྱིད་སྦྱིན་གང་ཐུབ་བྱ་དགོས་པ་ལས།",
    "རྒྱུན་པར་མོའི་ནོར་འཁྲུལ་ཁོ་ན་བཙལ་ཏེ་ཁོ་མོ་སྡུག་བསྔལ་གྱི་རྒྱ་མཚོའི་ནང་འཚོ་བ་རོལ་དུ་བཅུག་ན།",
    "དེ་ལྟར་བྱས་ཚེ་ད་གཟོད་ཁྱོད་ལ་བདེ་སྐྱིད་ཐོབ་ངེས་ཡིན་ཁྱོད་ཀྱིས་རང་གི་ཆུང་མའི་བྱས་ཉེས་ལ་གུ་ཡངས་གཏང་དགོས་ལ།",
    "ཁོས་རང་གི་ཆུང་མར་གུ་ཡངས་གཏང་སྟེ།",
    "སྐད་ཅིག་ཉིད་ཀྱི་ང་རྒྱལ་གྱིས་རང་ཡུལ་དང་ཆུང་མ་ཤུལ་དུ་བསྐྱུར་ནས་གནས་མཆོག་ལྷ་སར་ཡོང་བའི་བྱ་སྤྱོད་དག་ལ་སེམས་གཏིང་ནས་ཚིག་པ་ཟ་བཞིན་འགྱོད་གདུང་གི་མཆི་མ་བར་མེད་བཞུར།",
    "རང་ཉིད་ཁོ་ན་རེ་སྒུག་བྱེད་བཞིན་པའི་ངང་ཚུལ་དག་ཡིད་ལ་ལྷང་ལྷང་དུ་དྲན་འོང་།",
    "ཨར་ཁང་གི་སྒྲ་དབྱངས་ཀྱང་རིམ་གྱིས་ཇེ་ཆུང་ནས་ཇེ་ཆུང་དུ་གྱུར་ཞིང་།",
    "བུད་མེད་ཅིག་གིས་ལུས་ངག་ཡིད་གསུམ་གྱིས་རང་ཉིད་ཕྱིར་ལོག་ཡོང་རྒྱུར་རེ་སྒུག་བྱེད་པ་དེ་ནི་ཅི་འདྲའི་བདེ་སྐྱིད་ལྡན་པ་ཞིག་ཡིན་པ་གཞི་ནས་ཤེས་སོང་།",
    "དད་ལྡན་མང་ཚོགས་ཚོའི་གཡའ་མེད་དྲི་བྲལ་གྱི་དད་སེམས་དང་།",
    "ད་ལྟ་ཁོས་རང་གི་ཆུང་མ་ལྷག་ཏུ་དྲན།",
    "སྐྱ་རེངས་ཤར་སོང་།",
    "ཨ་ཇོ་རྣམ་རྒྱལ་གྱིས་འགྱོད་བཤགས་ཀྱི་བསམ་པ་རུམ་གང་འཁྱེར་ནས་རང་གི་ཆུང་མ་ཡོད་སའི་ཡར་ལུང་གྲོང་ཚོའི་ཕྱོགས་སུ་ཁ་ལོ་བསྒྱུར་སོང་།",
    "ད་ནི་ཡུན་རིང་ཁོའི་སེམས་སུ་ཉར་བའི་རྡོག་ཁྲེས་ལྕི་མོ་དེའང་གར་སོང་ཆ་མེད་དུ་གྱུར་ཏེ་ཆུང་མའི་ཐོག་ཏུ་ཁོང་ཁྲོ་བྱ་རྒྱུ་ལྟ་ཅི།",
    "དེ་ནི་བཟོད་སྒོམ་དང་གུ་ཡངས་ཀྱི་དགེ་མཚན་རེད།",
    "བཟོད་སྒོམ་དང་གུ་ཡངས་བྱས་པ་དེས་ད་ལྟ་རང་སེམས་ལ་ན་ཟུག་མེད་པར་སེམས་པ་ཧྲིལ་བོ་ལྷོད་ལ་བབས་འདུག་ད་ནི་ཁོས་ཆུང་མར་གུ་ཡངས་བཏང་ཟིན་ལ་རང་ཉིད་ལའང་གུ་ཡངས་ཤིག་བཏང་སོང་།",
    "སེམས་བཟང་བསྐྱེད་ནས་གླུ་ཆུང་ལེན་པ་དགའ་ཞེས་པའི་གླུ་ཚིག་དེའི་ནང་དོན་ཁོང་དུ་ཆུད་སོང་།",
    "ཁོ་རང་ཡར་ཀླུང་གྲོང་ཚོར་སླེབས་དུས་ཉི་མ་ཆུ་ལྷའི་ཕང་བར་བཞུད་ལ་ཉེ།",
    "ཁོའི་སེམས་པ་བློང་བློང་པོར་གྱུར་སོང་།",
    "ཁོ་མོས་དུས་ནམ་ཡང་ང་ཕྱིར་ལོག་རྒྱུར་རེ་སྒུག་བྱས་ནས་འདུག་ངེས་ཞེས་ལབ་པ་མ་ཡིན་ནམ།",
    "ཁོས་དེ་འཕྲལ་ཁྱིམ་མཚེས་ཀྱི་གམ་དུ་སོང་ནས་ཆུང་མ་གང་ལ་སོང་བའི་སྐོར་སྐད་ཆ་དྲི་བར་ཕྱིན།",
    "བུད་མེད་དེས་ད་རེག་བར་དུ་རྒྱང་རིང་གི་ཉི་མ་ལྷ་སའི་ཕྱོགས་སུ་མིག་ཟུང་ཅེར་བཞིན་ཁྱོད་ཕྱིར་ལོག་ཡོང་རྒྱུར་སྐོམ་པ་ཆུ་འདོད་ལྟར་གྱི་རེ་སྒུག་བྱེད་བཞིན་མཆིས།",
    "ཁོ་མོས་བཞུད་ཟིན་པའི་ལོ་ཟླ་དེ་དག་གི་ནང་མི་ཁ་མང་དག་ཅིག་རྒྱབ་ཏུ་འཁུར་ནས་སྐྱོ་གདུང་གི་ཁྲོད་དུ་ཁྱོད་ཁོ་ན་དྲན་བཞིན་འདུག་ཟེར།",
    "ཟླ་བ་གཅིག་གི་ཡར་སྔོན་དུ་ད་གཟོད་མོ་གནས་དེར་འདུག་ཐབས་མེད་པར་ལྷ་སར་ཁྱོད་འཚོལ་དུ་བུད་སོང་ཟེར།",
    "ཕྱི་ཉིན་ཞོགས་པར་ཨ་ཇོ་རྣམ་རྒྱལ་གྱིས་བུ་མོ་ཆུང་ཆུང་ཞིག་པང་དུ་འཁུར་བཞིན་ལྷ་སའི་གཙུག་ལག་ཁང་དུ་མཆོད་མཇལ་ལ་འགྲོ་བཞིན་འདུག་ད་ལྟ་ཨ་ཇོ་རྣམ་རྒྱལ་གྱི་ངོ་གདོང་གི་ཁྱོན་ལ་འཛུམ་མདངས་ཀྱིས་ཕྱུག་ཅིང་།",
    "ད་དུང་རང་ཉིད་ལ་ཨ་ཕར་འབོད་པའི་བྱིས་པ་ཡི་གར་འོང་བ་ཞིག་ཀྱང་མི་ཚེའི་འདུག་རོགས་སུ་རྙེད་བྱུང་།",
    "ཁོ་མོའི་དགོད་སྒྲ་དེ་དྲིལ་ཆུང་གི་སྒྲ་སྙན་མོ་ཞིག་དང་ཧ་ཅང་མཚུངས།",
    "དགོད་སྒྲ་དེས་ཞོགས་པའི་ཁུ་སིམ་གྱི་ལྷིང་འཇགས་དཀྲོགས་སོང་།",
    "གཡོ་ཟོལ་བྲལ་བའི་དགོད་སྒྲ་སྙན་མོ་དེས་ཁོ་ཚོའི་འཚོ་བ་ལ་མཚར་སྡུག་གི་ཁ་དོག་གསར་བ་ཞིག་བསྣན་བྱུང་།",
    "གནའ་གྲོང་གི་གཏམ་རྒྱུད།",
    "རྒྱང་རིང་གི་རི་གྲོང་སྨག་རུམ་གྱི་ལྭ་བས་བཏུམས།",
    "ཁྱེད་ལ་མཚར་སྡུག་ལྡན་པའི་འདས་སོང་གི་གཏམ་རྒྱུད་ཡོད་ལ།",
    "འཇའ་བཞིན་བཀྲ་བའི་རྒྱང་རིང་གི་རྨི་ལམ་ཡང་ཡོད།",
    "ཡོད་ཚད་ཀྱི་ཡོད་ཚད་སྐམ་སར་ལུས་པའི་ཉ་མོ་ཇི་བཞིན་ཚེ་སྲོག་གི་རང་མདངས་དལ་གྱིས་ཤོར་ཟིན།",
    "ད་ལྟ་ཁྱེད་ནི་བགྲེས་སོང་ཚོའི་ངག་སྒྲོས་ཁྲོད་ཀྱི་གནའ་གཏམ་ཙམ་དང་།",
    "༡གནའ་གྲོང་ཞེས་པའི་ཡུལ་མིང་དེ་མི་རྣམས་ཀྱི་ཉན་བྱེད་རྣ་བའི་བུ་གར་ཐོས་ཐེངས་རེར།",
    "སྐྱེ་བོ་དུ་མ་གཅིག་གིས་ལག་ཟུང་གི་མཐེ་བོང་མཁའ་ལ་བསྒྲེངས་ཏེ་གནའ་གྲོང་ལ་ཆ་རྒྱུས་མེད་མཁན་སུ་ཞིག་ཡོད།",
    "ཆུ་མོ་དྭངས་ཤིང་གཙང་བ།",
    "རྒད་པོ་ཚེ་རིང་ཐར་ཡང་བགྲེས་སོང་དེ་དག་ཁྲོད་ཀྱི་གཅིག་ཡིན།",
    "ཁོ་ནི་ས་སྐྱེས་རྡོ་སྐྱེས་ཀྱི་གནའ་གྲོང་གི་མི་རབས་གསུམ་པ་དེ་ཡིན་པས།",
    "ཚང་མའི་མིག་ཟུང་གཡོ་འགུལ་མེད་པར་ཅེ་རེར་རྒད་པོའི་ངོ་གདོང་གི་ཁྱོན་ལ་ལྟ་བཞིན།",
    "རྒད་པོས་རང་གི་སྨ་ར་དཀར་པོར་བྱིལ་བྱིལ་ལན་འགའ་བྱེད་ཞོར་མིག་ཟུང་ལས་གྲུང་ཤ་དོད་པའི་འོད་མདངས་ཅི་ཡང་མེད་པར་བློ་ཕམ་ཡིད་ཆད་ཀྱི་རྣམ་འགྱུར་ཞིག་བསྟན་ཞོར་བྱིས་པ་སྣ་ལུད་ཅན་ཚོ།",
    "སྣ་ཐ་སེན་མོ་གང་ཤུགས་ཀྱིས་འཐེན་སོང་བས།",
    "གནའ་སྔ་མོའི་དུས་ཤིག་ལ།",
    "མང་ཚོགས་ཀྱི་སྡོད་ཁང་།",
    "གནས་དེར་ཡོང་མཁན་གྱི་ཡུལ་སྐོར་བའི་ཚོགས་ནི་མཚན་གུང་གི་སྐར་ཚོགས་ཇི་བཞིན་བགྲང་ལས་འདས།",
    "འོན་ཀྱང་ད་ཆ་ཧུ་ཞེས་རྒད་པོ་ཚེ་རིང་ཐར་གྱིས་དེ་ལྟར་དངན་པ་ཞིག་འཐེན་ཞོར་གས་ཆག་ཤོར་བའི་མིག་མདུན་གྱི་གྱང་རོ་དག་ལ་མིག་ཟུང་ཅེར་བཞིན་འདུག་ངོ་མ་རེད།",
    "འདས་སོང་གི་མཚར་སྡུག་ལྡན་པའི་ཡུལ་ལུང་གི་བཀོད་པ་དང་།",
    "མང་ཚོགས་ཀྱི་ཉམས་དགའ་བའི་འཛུམ་མདངས་དག་ཡིད་ངོར་དྲན་ཐེངས་རེར།",
    "རེད་ཨང་།",
    "སྔོན་ཆད་གྲོང་ཚོའི་ཉེ་འདབས་སུ་ལྷུང་ལྷུང་བཞུར་བའི་ཆུ་མོའི་སྐད་སྒྲ་དང་།",
    "ལྗོན་ཤིང་གསེབ་ནས་བྱ་ཁུ་བྱུག་སྔོན་མོས་སྒྲོག་པའི་ཀྱུར་ཀྱུར་གྱི་སྐད་སྙན།",
    "གནའ་གྲོང་གི་བྱིས་པ་ཚོ་གཙང་སྦྲ་དོད་ཅིང་གོན་པ་ལེགས་ལ་ངོ་པ།",
    "གནའ་གྲོང་གི་འཕེལ་གྲིབ་དེ་བྱིས་པ་དེ་དག་གི་ལུས་ཐོག་ནས་ཀྱང་གསལ་པོར་རྟོགས་འོང་།",
    "རྒད་པོས་བྱིས་པ་དེ་དག་གི་ཉམ་ཐག་པའི་རྣམ་པ་དེ་མཐོང་བས།",
    "སྔོན་ཆད་ཡིན་ན་བགྲེས་སོང་ཚོས་རི་འདབས་སུ་སྐྱེས་པའི་ཚར་དུ་དངར་བའི་ལྗོན་ཤིང་གི་འོག་ཏུ་མ་ཎི་བགྲང་ཞོར་ཁ་བརྡར་རོལ་ཆོག་པ་དང་།",
    "བུད་མེད་ཚོས་གླུ་ཆུང་ལེན་ཞོར་ཉེ་འགྲམ་གྱི་རྒྱ་ལྕང་དང་ཤོལ་བོ།",
    "ཁམ་སྡོང་ལ་སོགས་པའི་རྐང་འཐུང་གི་བསིལ་གྲིབ་འོག་ཏུ་བལ་བསེད་པ་དང་།",
    "ད་ལྟ་ནགས་ཚལ་དང་ལྗོན་ཤིང་དག་མིག་ཟུང་གི་མཐོང་ཡུལ་དུ་མེད་པས།",
    "རྒད་པོ་ཚེ་རིང་ཐར་གྱིས་ཐལ་རྡུལ་གྱིས་འཚུབ་པའི་གནའ་གྲོང་གི་རྣམ་པ་དེ་མིག་ལམ་དུ་མཐོང་དུས།",
    "གནས་དེའི་མང་ཚོགས་ཕོ་མོ་རྒན་གཞོན་ཚང་མས་ལག་ཏུ་བཀྲ་ཤིས་པའི་མཇལ་དར་ཐོགས་ཤིང་།",
    "ཁྱོད་ཀྱིས་ང་བྱ་རེད་ཅེས་འཕྱ་སྨོད་བྱེད་པ་མ་ཡིན་ནམ་ཞེས་དྲིས་བྱུང་བས།",
    "གནའ་གྲོང་གི་རི་འདབས་སུ་སྐྱེས་པའི་ནགས་ཚལ་དག་རྩ་འགོག་བྱས་ཏེ་རི་འདབས་སུ་རླངས་འཁོར་འགྲོ་སའི་གཞུང་ལམ་བཟོ་རྒྱུ་དེ་ཡིན་པ་རེད།",
    "མང་ཚོགས་ཚོའི་སེམས་པ་ད་གཟོད་ལྷོད་ལ་བབས་བྱུང་།",
    "མང་ཚོགས་ཚོས་དངུལ་སྒོར་མང་པོ་དེ་འདྲ་མཐོང་བ་ཐེངས་དང་པོ་ཡིན་པས།",
    "སྐབས་དེ་དུས་དྲོད་འཇམ་གྱི་ཉི་མ་དེའང་དལ་བ་དལ་བུར་ནུབ་ཕྱོགས་ཀྱི་ཕང་བར་ཐིམས་ཤིང་མུན་ནག་གི་ཡོལ་བ་ཆེན་པོ་ཞིག་གནའ་གྲོང་གི་ས་གཞིའི་ཁྱོན་ལ་བཀབ་པ་ལྟར།",
    "གནའ་གྲོང་གི་ཡོད་ཚད་ནག་རོག་རོག་ཏུ་གྱུར་སོང་།",
    "གནས་དེའི་མང་ཚོགས་ཚོར་སེམས་ཚེགས་བྱ་ཡུལ་ཅི་ཡང་མེད།",
    "ཁོ་ཚོས་སྣུམ་ནག་གི་གཞུང་ལམ་དེ་གང་མགྱོགས་བཟོ་ཐུབ་ན་ཅི་མ་རུང་ཨང་སྙམ།",
    "མང་ཚོགས་ཚོའི་སེམས་ལ་རེ་བས་ཕྱུག་འདུག་གཞུང་ལམ་མགྱོགས་མྱུར་བཟོས་ན་གནས་དེར་ཡུལ་སྐོར་བ་མང་དག་ཅིག་ཡོང་ངེས་པས།",
    "མང་ཚོགས་ཚོས་དེ་ལྟར་བསམ་ཞོར་གཞུང་ལམ་བཟོ་ཡུལ་གྱི་ལས་གྲྭའི་ཕྱོགས་སུ་མིག་ཟུང་ཅེར་བཞིན་བསྡད།",
    "གནའ་གྲོང་དུ་གཞུང་ལམ་བཟོ་བའི་ལས་གྲྭ་མཇུག་བསྒྲིལ་སོང་ལ།",
    "གནའ་གྲོང་གི་མང་ཚོགས་རྣམས་ནི་འབྲུག་སྒྲ་ཐོས་པའི་རྨ་བྱ་དང་ཚ་བས་གདུང་བའི་གླང་པོ་ཆེ་མཚོ་ལ་རོལ་བ་ཇི་བཞིན་བདེ་སྣང་གི་ཚོར་བས་ཡོངས་སུ་ཕྱུགདེ་ནས་ཉིན་ཤས་འདས་རྗེས།",
    "གནས་དེའི་མང་ཚོགས་ཚོའི་ཡུལ་སྐོར་གྱི་ཡོང་འབབ་ཧ་ཅང་ཞན།",
    "ཁོ་ཚོའི་རེ་བ་དང་ཕུགས་འདུན་མཐའ་དག་སྐད་ཅིག་ཉིད་དུ་སྟོང་བར་གྱུར་སོང་།",
    "སྔོན་ཆད་ཀྱི་གྲོང་ཚོའི་རི་འདབས་ངོས་སུ་སྐྱེས་པའི་ནག་ཅིང་སྟུག་པའི་ནགས་ཚལ་དང་རྩི་ཤིང་ད་ལྟ་མིག་ཟུང་གི་མཐོང་ཡུལ་དུ་མེད་པས།",
    "ང་ཚོ་འཚོ་བ་མུ་མཐུད་བསྐྱལ་དགོས་ན་ཡུལ་སྐོར་ལ་བརྟེན་དགོས་པ་ཨ་ཅང་བརྗོད་མེད་རེད།",
    "བྱས་ཙང་ཚང་མས་སྒོར་མོ་ཁྲི་གཉིས་རེ་གྲབ་གསོག་བྱས་ཏེ་དེ་བས་ཕུན་སུམ་ཚོགས་པའི་ཡུལ་སྐོར་གྱི་དྲན་རྟེན་དང་།",
    "ཚང་མས་རང་གི་ལག་ཏུ་ཡོད་པའི་སྒོར་མོ་བཀོལ་ནས་ཡུལ་སྐོར་དང་འབྲེལ་བའི་ཅ་དངོས་མང་དག་ཅིག་ཉོས་ཏེ་ཡུལ་སྐོར་བ་ཕེབས་རྒྱུར་སྒུག་ནས་བསྡད།",
    "ཚང་མའི་སེམས་ལ་ད་ནི་ཡུལ་སྐོར་བ་མང་དག་ཅིག་གནས་དེར་ཡོང་ནས་ཁོ་ཚོའི་ལག་ཏུ་སྒོར་མོ་ལྗིད་ཏིག་ཏིག་ཐོབ་རྒྱུར་གདེང་ཚོད་ཀྱིས་གང་འདུག་འོན་ཀྱང་།",
    "གནས་དེའི་མང་ཚོགས་ཚོས་འཚང་ཁ་ཤིག་ཤིག་ངང་རླངས་འཁོར་དེའི་ཕྱོགས་སུ་རྒྱུགས་ངེས་ཡིན།",
    "ཟླ་བ་གཅིག་ཙམ་སོང་རུང་གནས་དེར་ཡུལ་སྐོར་བའི་རླངས་འཁོར་གཅིག་ཀྱང་ཐོན་མེད་པས།",
    "ཁོ་ཚོའི་སེམས་ལ་སྤྲོ་བ་རབ་ཏུ་འཕེལ་ཏེ་རླངས་འཁོར་གྱི་ཕྱོགས་སུ་བརྒྱུགས་སོང་།",
    "ཡུལ་སྐོར་བ་ཚོས་ཐལ་རྡུལ་གྱིས་ཕྱུག་པའི་གནའ་གྲོང་གི་རྣམ་པ་དེ་མཐོང་བས།",
    "ཡིད་ཐང་ཆད་པའི་ཉམས་ཤིག་བསྟན་ཏེ་ཕྱིར་རང་རང་གི་ཕ་ཡུལ་དུ་འགྲོ་རྩིས་བྱས་པ་ན།",
    "གཟུགས་པོ་རིང་ལ་སྣ་ཆེ་བའི་ཡུལ་སྐོར་བ་ཞིག་གིས་ང་ཚོ་སྔོན་ཆད་གནའ་གྲོང་དུ་ཡོང་དོན་ནི་ས་ཆ་གཞན་པར་མཐོང་དཀོན་པའི་གནའ་གྲོང་གི་མཛེས་པ་སྟེ།",
    "གནའ་ཉམས་ཀྱིས་ཕྱུག་པའི་གནའ་གྲོང་གི་ཁང་བ་དང་།",
    "ནགས་ཅིང་སྟུག་པའི་གནའ་གྲོང་གི་གདོད་མའི་ནགས་ཚལ།",
    "རེད་ཨང་།",
    "སྔོན་ཆད་ཡིན་ན་གནའ་གྲོང་གི་ཞིང་ཐང་གི་ཁྱོན་དུ་ལྗང་ལྡེམ་ལྡེམ་གྱི་སྙེ་མའི་རྦ་རླབས་འཕྱོ་ཞིང་།",
    "འགྲུལ་བཞུད་བྱེད་མཁན་དཀོན་པའི་སྣུམ་ནག་གི་གཞུང་ལམ་དེ་དག་ལས་གཞན་ཅི་ཡོད།",
    "མང་ཚོགས་ཚོས་གནའ་གྲོང་གི་ད་ལྟའི་གནས་བབ་དེ་མཐོང་དུས།",
    "རྒད་པོ་ཚེ་རིང་ཐར་གྱིས་བྱིས་པ་ཚོ་གཉིད་ལས་སད་དེ་མགོ་ལ་སྦར་མོ་བཀབ་ནས་བྲེལ་བྲེལ་འཚུབ་འཚུབ་ངང་རང་ཁྱིམ་གྱི་ཕྱོགས་སུ་བརྒྱུགས་སོང་།",
    "གང་ལྟར་མཆི་ཞག་དེས་རྒད་པོའི་མིག་མདུན་གྱི་ཡོད་ཚད་རབ་རིབ་ཏུ་བཏང་སོང་།",
    "རབ་རིབ་ཏུ་བཏང་སོང་།",
    "སྐབས་རེ་ཚོར་བ་ཅི་ཡང་མེད་པར་ཅི་ཡང་འབྲི་མི་ཐུབ་ཅིང་།",
    "སྐབས་རེ་རང་ཉིད་ཀྱི་ཐ་སྙད་ལ་ཚད་བཀག་ཐེབས་ནས་བདེ་སྡུག་བཏང་སྙོམས་ཀྱི་སེམས་ཀྱི་ཚོར་འདུ་རྣལ་མ་དེ་ཤོག་དཀར་གྱི་ངོས་སུ་དབབ་དཀའ།",
    "ངས་ངུ་བཞིན་དགོད་པ་བགྲང་གིས་མི་ལང་ལ།",
    "དེབ་འདིའི་ཐོག་མཐའ་བར་གསུམ་དུ་མ་རྟོགས་ལོག་རྟོག་གིས་དྲངས་པའི་སྐྱོན་དང་ནོར་འཁྲུལ་ཇི་སྙེད་ཅིག་མངའ་སྲིད་པས།",
    "ཐོག་མཐའ་བར་གསུམ་དུ་རྒྱབ་སྐྱོར་གནང་མཁན་བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་གི་རྒན་རྡོ་སྦིས་ཚེ་རིང་རྡོ་རྗེ་ལགས་དང་།",
    "མཐར་བོད་ཀྱི་རྩོམ་རིག་གི་བྱ་གཞག་ཁག་ཡར་ངོའི་ཟླ་ལ་འགྲན་ནས་གོང་དུ་འཕེལ་བའི་སྨོན་འདུན་ཞུ་རྒྱུ་དང་།",
