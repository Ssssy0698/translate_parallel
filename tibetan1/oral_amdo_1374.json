    "ཇི་སྐད་དུ་ཁྱོད་ཀློག་པ་དེ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་མ་ཡིན་ནོ།",
    "ཞེས་དབྱེན་བྱེད་ཅིང་ཟློག་ལ་མོས་པ་མེད་པར་བྱེད་དོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་མི་འདྲི་བར་འགྱུར།",
    "རབ་འབྱོར་དེ་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "རབ་འབྱོར་གཞན་ཡང་བདུད་སྡིག་ཏོ་ཅན་དག་དགེ་སློང་གི་ཆ་བྱད་དུ་བྱས་ནས།",
    "རབ་འབྱོར་དེ་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "རབ་འབྱོར་གཞན་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་སྟོན་པའི་ཚེ།",
    "སྦྱིན་པའི་ཕ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྨོན་པ་མེད་པ་གང་གིས་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་འཐོབ་པར་འགྱུར་བ་དང་།",
    "བདུད་སྡིག་ཏོ་ཅན་དག་དགེ་སློང་གི་ཆ་བྱད་དུ་བྱས་ཤིང་།",
    "རབ་འབྱོར་དེ་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "དེས་མོས་པ་བསྐྱེད་ནས་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ལས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རབ་འབྱོར་དེ་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "ཇི་ལྟར་དེ་བཞིན་གཤེགས་པ་འདིས་ཚོགས་ཡོངས་སུ་བསྡུས་པ་དེ་བཞིན་དུ་བདག་གིས་ཀྱང་།",
    "རབ་འབྱོར་དེ་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "རབ་འབྱོར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་ལ་གཟུགས་མེད་དོ།",
    "རབ་འབྱོར་གང་ལ་གཟུགས་མེད་པ་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "རབ་འབྱོར་དེ་བཞིན་དུ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བཅོམ་ལྡན་འདས་དེ་བཞིན་དུ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "བཅོམ་ལྡན་འདས་སྐྱེས་བུ་གླེན་པ་གང་རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བགྱིད་པ་དག་གིས་བར་ཆད་བགྱིད་པ་ནི་བདུད་ཀྱིས་བྱིན་གྱིས་བརླབས་པ་སྟེ།",
    "བཅོམ་ལྡན་འདས་སྐྱེས་བུ་གླེན་པ་གང་རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བགྱིད་པ་དེ་དག་གི་བར་ཆད་བགྱིད་པ་དེ་དག་ནི།",
    "དེ་དག་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་མི་འདྲི།",
    "སྟོན་པ་དང་ཚུལ་བཞིན་དུ་ཡིད་ལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་མི་འདྲི།",
    "སྟོན་པ་དང་ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་དེ་དག་གི་བར་ཆད་བྱེད་པ་དེ་དག་ནི་བདུད་ཀྱིས་བྱིན་གྱིས་བརླབས་པ།",
    "རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་དེ་དག་ནི་བློ་ཆུང་ཞིང་བློ་ཞན་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་གང་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་འདི་མི་འདྲི་མི་ཀློག།",
    "སྟོན་པ་དང་ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་དེ་དག་གི་བར་ཆད་བྱེད་པ་དེ་དག་ནི་བློ་རྒྱ་ཤིན་དུ་ཆུང་བར་འགྱུར་ཏེ།",
    "རབ་འབྱོར་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་བ་དང་།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་དག་ལ་བདུད་ཀྱི་ལས་འདི་དག་འབྱུང་མོད་ཀྱི།",
    "འོན་ཀྱང་རབ་འབྱོར་རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་དག་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲི་ཞིང་ཀློག་པ་དང་།",
    "སྦྱིན་པའི་ཕ་རོལ་དུ་ཕྱིན་པ་ཡོངས་སུ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེས་རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་དེ་དག་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟབ་མོ་འདི་འདྲིའོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཟབ་མོ་འདི་ཉིད་ཡོངས་སུ་རྫོགས་པར་བྱེད་དོ།",
    "དེ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་དེ་དག་གིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་འདི་འདྲི་བ་དང་།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་བྱེད་པ་དེ་དག་གི་དོན་དུ་བརྩོན་པར་བྱེད་ཅིང་།",
    "བུད་མེད་ལ་ལ་ཞིག་ལ།",
    "བདག་ཅག་གི་མ་འདི་ལ་ཇི་ལྟར་ན་བར་ཆད་དུ་མི་འགྱུར།",
    "བདག་ཅག་གི་མ་འདི་ཇི་ལྟར་ན་ཡུན་རིང་དུ་འཚོ་བར་འགྱུར།",
    "བདག་ཅག་གི་མ་འདི་རིང་དུ་འཚོ་བར་བྱེད་ན་ཇི་ལྟར་བྱ།",
    "བདག་ཅག་གི་མ་འདི་ལུས་ལ་མི་བདེ་བའི་ཉམས་མེད་པར་བྱ་ན་ཇི་ལྟར་བྱ།",
    "སྲོག་གི་སྦྱིན་བདག་གོ།",
    "དེ་དག་ནི་འདིའི་སྲོག་གི་བར་ཆད་དུ་འགྱུར་དུ་འོང་ངོ།",
    "སྦྲུལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཞེས་རྒྱུན་ཏུ་གཟིགས་ཤིང་དགོངས་སོ།",
    "ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་གང་འི་ཀླུང་གི་བྱེ་མ་སྙེད་དག་ན།",
