    "གནས་ཏེ་ཕྱི་ནང་གི་འགྱུ་བ་རང་དག་པའོ།",
    "དེ་དག་གིས་ལུས་དོན་བཅུ་བདུན་པ།",
    "ལྷག་མ་སོའི་མན་ངག་གི་སྐབས་སུ་ཤེས་པར་བྱའོ།",
    "སེམས་ཉོན་མོངས་པའི་བསྔོས་པ་ལས་གྲོལ་བར་མཐོང་སྟེ།",
    "སང་ས་རྒྱུས་རྣམས་ཀྱི་མཁྱེན་པ་མ་ལུས་པ་ཡོངས་རྫོགས་ང་མོ།",
    "ཡུམ་དེ་རེ་སྟེ་ཐུང་དུ་འཁྲིལ་བའོ།",
    "དེ་ལས་ཀྱང་ཚོ་མ་བུ་འབུམ་ཕྲག་གཅིག་ཏུ་སྣང་ངོ།",
    "ཁམས་གསུམ་དུ་སླར་ལོགས་ང་མེད་ངས་ཅདབྱུང་དེ་དག་གིས་ནི་ལུས་དོན་ཉི་ཤུ་པ་བར་མ་དོའི་མཚན་ཉིད་བསྟན་པ་ལ་གཉིས་སུ་བྱས་ནས་བསྟན་ནོ།་།",
    "ཞེསམ་ས་པའི་མིང་གི་བྱེ་བྲག་བསྟན་ནས།",
    "སྲོག་གིས་བཞག་པས་འཁྲུལ་ཡེ་ཤེས་སུ་འཆར་བའིགནས་སྣང་བ་སྣང་གྲོལ་དུ་གྲོལ་བའོ།",
    "ད་ནི་ལུས་དོན་ཉེར་ལྕང་ཚོས་ཉིད་བསྟན་པ་ལ་གཉིས་ཀྱིས་བསྟན་པའི་དང་པོ།",
    "རང་བཞིན་འོད་ཁ་དོག་ལྔར་གསལ་ཞིང་གང་གིས་ཀྱང་མ་བསྒྲིབ་པའོ།",
    "ཞེས་ལུ་གུ་རྒྱུད་སྦྲང་གི་ངོ་བོ་བསྟན་ནས།",
    "ལས་དེ་ཡང་རེག་པ་རྡོ་རྗེ་ལུ་གུ་རྒྱུད་ཀྱི་རང་བཞིན་ནི།",
    "ལྡང་ཚོད་ནི་བསྐྱོད་པའི་རིམ་ང་གཙོ་ཆེ་ཡབ་ལཕུན་སུམ་ཚོགས་པ་ལྔས་སྒྲ་སྐད་ལ་གཞིར་བཞག་ནས།",
    "མན་ངག་གི་བསྐྱེད་རྫོགས་ཀྱིས་འབྲས་བུངས་པར་འབྱིན་པར་བྱེད་པའོ།",
    "དེའི་ཕྱིར་ན་སྔོན་འབྱུང་གི་དུསན།",
    "རང་གིས་རང་གྲོལ་པ་ཡིན་ངས་དེ་ལས་གཉེན་པོ་གཞན་མེད་དོ།",
    "འབྲིང་པོ་རིག་གིས་འཇིག་རྟེན་གྱི་བྱ་བས་གཡེངས་ནས།",
    "བག་རེ་ཉམས་སུ་བླངས་པ་ལ་བརྟེན་ནས།",
    "དབྱེན་དང་ངཔ་ཐ་མལ་རྐྱེན་སྐྱེས་ཀྱིདད་པ་བར་སྣང་གི་གློག་ལྟ་བུ་དང་།",
    "དད་ང་འབྲིང་པོ་ལ་མོས་ཤིང་གུས་ངའི་དད་པ་དང་།",
    "ལུསངག་གི་བརྟུལ་ཤུགས་ཅན་དང་།",
    "ལུསངག་གི་སྤྱོད་པ་ཐམས་ཅད་ཤུགས་དལ་ཆགས་ང་དང་གཉིས།",
    "རྒྱུ་འབྲས་གཉིས་མེད་དུ་ལྷུན་གྱིས་གྲུབ་པས་སྤངས་ཐོབ་དང་རེ་དོག་མེད་པའོ།",
    "གྲང་ཐལ་ཐིག་ལེའི་ངོ་བོ་ཅིག་ལས་སྣ་ཚོགས་པའི་འཁྲུལ་འཁོར་དུ་བྱུང་བའོ།",
    "དངོས་རིག་གི་དངོས་གཞི་ཡིན་པ་ལ།",
    "ཀ་བ་ཁྱོད་གླང་ཡིན་ཏེ།",
    "དེ་ལ་རེ་ཞིག་ལྟ་བ་ཞེས་བསྟན་པ་ལ།",
    "ཀྲི་ཡ་ཡོ་ག་ཨུ་པ་ཡ་གསུམ་མོ།",
    "དེ་ལྟར་གནས་ལུགས་ལ་དེ་གཉིས་དང་བྲལ་བས་རྣམ་རྟོག་གི་ཕྱོགས་མེད་དོ།",
    "བློ་དང་བྲལ་བས་འགྱུ་བྱེད་དུ་མའི་རྟོག་པ་ཁྱོད་ངའོད་ལྡང་ཚད་ནི།",
    "སྦྲང་རྟགས་རང་གི་མཚན་ཉིད་ཀྱི་འདྲ་སྒྲུང་སྣ་ཚོགས་སུ་བྱུང་ཡང་།",
    "ཞེས་ཚིག་གི་ལྟ་བ་བསྟན་ནས།",
    "ཐེག་ང་ཐུན་མོང་བས་རྣམས་ཀྱིས་ཡིད་དཔྱོད་ཀྱི་ལྟ་བ་བསྒོམས་ལས་འདས་པའོ།",
    "ཉམས་སུ་བླངས་བས་མངལ་གྱི་སྒོ་མི་འགི་མ་ངའི་ཕྱིར་རོ།",
    "དེའི་ས་མཚམས་ཁྱད་པར་དུ་ཚིག་གི་སམཚམས་ནི།",
    "རང་ལ་གནས་པའི་དོན་དེ་རང་གི་ལྟ་བས་ན་ལྟབ་ཞེས་བྱའོ།",
    "དེ་དག་གི་དོན་གྱིས་ཡོད་དཔྱོད་འཛིན་པའི་ལྟ་བ་ཉིད་དུ་འདོད་དེ།",
    "ཡིདདཔྱོད་ཚིག་གི་སྒྲོ་འདོགས་ཆོད་པའོ།",
    "དག་གིས་ཡི་གེའི་འབྲེལ་འདེད་པ་དང་།",
    "རེག་ཉིད་མཉམ་ཉིད་བེ་ཐེལ།་",
    "བྱི་ངས་ན་གཞས་ངའིབྱོལ་སོང་གི་རིགས་སུ་སྐྱེའོ།",
    "འཛིན་པ་ངང་གིས་སྟོངས་པའོ།",
    "རྐྱེན་ལས་དང་ཉོན་མོངས་པ་དག་པའི་རང་བཞིན་དུ་གནས་པ་ལས།",
    "བདག་དང་བདག་གིར་བཅས་པའི་བརྟག་པ་ཐ་དད་པར་ཤར་ནས་ཕརོལ་ལ་གཞན་དུ་འདུ་ཤེས་ཏེ།",
    "ནང་ང་འི་མི་ཚིག་གིས་བར་མ་ཆད་པ་དང་།",
    "རངགི་གནས་གཟུགས་ཀྱི་ལྷ་མོ་དཀར་མོ།",
    "དེ་ལྟར་ཕ་སྲོལ་ཏུ་ཕྱིན་པ་དྲུག་གིས་ལས་ཀྱི་མཐའ་དེ་དག་ཀྱང་ཤེས་བྱ་ལ་མེད་དོ།",
    "གཞན་གྱི་བཙུན་མོ་མི་ཚངས་སྤྱད།་།",
    "ལྟ་བའི་དོན་ལ་གནས་ངས་ཚིག་གི་མཐའ་འགགས་པར་འགྱུར་རོ།",
    "ཞེས་ལུས་དོན་བཅུ་གསུམ་པ་ལྟ་བ་རང་འབྱུང་གི་འཁོར་ལོ།",
    "འབྲས་བུ་ཉིད་རང་གིས་རང་སར་གྲོལ་བའོ།",
    "ཕྱི་རོལ་གྱིས་ལས་དང་ལུས་ངག་གི་བྱ་བ་དང་།",
    "ཉོན་མོངས་པ་འདོད་ཆགས་ཞེ་སྡང་གཏི་མུག་།",
    "ཡི་དྭགས་བྱོལ་སོང་གསུམ་གྱིས་གཟུགས་ཤེས་བྱ་ལས་མ་གྲུབ་པས།་",
    "དཔེར་ན་མཚན་མོ་མར་མེའི་སྣང་བ་སྟོན་ང་འདུས་ན།",
    "ངན་སོང་གསུམ་དུ་ཁྲིད་ང་འགྱུར་བས།",
    "ཞེ་ལུས་དོན་བཅུ་དྲུག་པ་བརྗོད་བྱ་ཚིག་གི་ལྟ་བ་བསྟན་པ་ལ་ལྗགཉིས་སུ་བྱས་ནས་བསྟན་ནོ།",
    "དེ་ལ་རྒྱུད་ཀྱི་སྟོན་པ་རྡོ་རྗེ་འཆང་གིས་གཞན་ཡང་བརྡའདོན་འབྲེལ་བའི་ལྟ་བ་ཤད་པར་བྱའོ།",
    "མེ་དཔུང་གིས་ལུས་ཉོན་མོངས་པའི་སྣ་རོགས་ལོ་པའི་ཀློང་དཀྱིལ་ན་ནི་རང་ལས་བྱུང་བའི་རྟོག་པ་ཐ་དདང་།་",
    "གོས་གོན་པ་ནི་ལུས་དང་འབྲེལ་བའི་ཁྱོད་ང་སྣ་ཚོགས་སུ་བྱའོ།",
    "དེ་ནས་འགྲོ་བ་མི་ལ་སོགས་པ་རྣམས་ལ་ཚོགས་ཀྱི་སྟོན་མོ་འམ།",
    "དེ་ཡང་སྔགས་པས་སྲོད་ལ་དཀྱིལ་འཁོར་གྱི་འཁོར་ལོ་བསྒོམ་མོ།",
    "ད་ནི་ཞུས་པ་ལས་གཞན་དུ་འགྱུར་བ་ལུས་དོན་ཉེར་གཉིས་བ་ལུས་ངག་བསླབ་པའི་རིམ་པ་བསྟན་ང་མགཉིས་ཀྱིས་བསྟན་པའི་དང་པོ་། ལུས་ངག་གིབསླབ་པ་དང་དངོས་བསྟན་པ་ནི།",
    "ལྔ་ནང་རེ་བཞི་ན་བཟའ་བར་བྱའོ།",
    "གི་བསློབ་ང་ནི་རིམ་པ་ལ་གཉིས་སུ་བྱས་ནས་བསྟན་ཏོ།",
    "ལུས་ངག་གི་བྱ་བ་མ་ལོག་པས་བསྟེན་པདང་།",
    "མཉན་པའི་ཚིག་གིས་བརྗོད་པ་དང་།",
    "རྒྱལ་སྲིད་དང་ནི་རང་གི་ལུས།",
    "ཆར་པ་དག་ནི་ལུས་ལ་འབབ་རེས་ང་ས་སོ།",
