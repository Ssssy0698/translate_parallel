    "རིས་མི་མཐུན་གྱི་སྐད་ཅིག་དུས་ཐ་དད་པ་སྔ་མའི་དུས་སུའང་མཚམས་སྦྱོར་བྱེད་དུ་གྲུབ་བོ།",
    "བདེ་བ་དང་ཡིད་བདེ་དང་བཏང་སྙོམས་དང་སྲོག་དང་ཡིད་དང་དད་སོགས་ལྔ་དང་རང་རང་བསྣན་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "སྔར་གྱི་བརྒྱད་དང་རང་ཉིད་དང་དགུ་ལྡན་པའི་ཕྱིར།",
    "མངལ་ན་དང་སྒོ་ང་ན་འདུག་པ་རྣམས་ནི་གཞན་གྱིས་གསོད་པས་མུ་གཉིས་པའོ།",
    "འཆི་བ་ཙམ་ཡོད་ཀྱང་རང་འཆི་དང་གཞན་གསོད་གཉིས་ཀ་མིན་ནོ།",
    "དེ་གཉིས་ཀྱི་བར་ན་མིན་ཕྱོགས་ཀྱི་ཕུང་གསུམ་འདུག་པའི་ཕྱིར།",
    "མ་འོངས་པ་ལ་སྔ་ཕྱི་ཞེས་ཡོངས་སུ་མི་ཆོད་དེ་འཆོལ་བར་འདུག་པའི་ཕྱིར་དང་།",
    "དེ་ཡང་རང་ལས་དམན་པ་ལ་ནི་མ་ཡིན་གྱི།",
    "བདག་འབྲས་ཡིན་ལ་སྐྱེས་འབྲས་མིན་པ་ནི་རྒྱུ་ཡལ་བར་འདུག་པའི་འབྲས་བུ་དང་འབྲས་བུའི་བར་དུ་ཆོད་པའོ།",
    "དག་དང་རང་ལས་དེ་ལས་གཉིས།",
    "དག་དང་རང་ལས་དེ་ལས་གཉིས།",
    "འགྲོ་འཆག་འདུག་འགྲེང་སོགས་སྤྱོད་ལམ་པ་དང་།",
    "ཅེས་པ་འདི་རྩ་བར་ཆད་འདུག་ཀྱང་རྒྱ་དཔེ་ལ་འདུག་པས་རང་འགྲེལ་ལྟར་བྲིས་པའོ།",
    "གང་ཟག་རྒྱུད་ཆད་དོགས་པ་དེ་འཇིག་ལྟ་ལ་སླར་མཐར་ལྟ་བ་དེ་ཉིད་དུ་བྱས་པ་ལ་ངོས་བཟུང་འདུག་པའི་ཕྱིར།",
    "སེམས་ཀྱི་ངོ་བོ་ཁོ་རང་ལ་ནི་དེར་ངོ་ཤེས་ཀྱི་དེར་འཛིན་དང་མ་བྲལ་བ་དེ་མཚན་མེད་ཕྱག་རྫོགས་ཀྱི་གནས་ལུགས་ཡང་དག་པར་ཡིན་པས་དེར་བལྟའོ་ཞེས་པ་དང་སྐྱེ་མཆེད་བཞི་པ་འདི་ལ་ཁྱད་སྟོན་ཅིག།",
    "བྱས་མ་ཐག་ཏུ་ཡིན་གྱི་དུས་གཞན་གྱི་བར་དུ་གསོན་པོར་འདུག་ཀྱང་མ་ཡིན་པར་འགྱུར་རོ།",
    "ཡང་རང་རྒྱལ་འཇུག་གནས་གཉིས་ཀ་ཤེས་པ་དང་རྟག་ཏུ་རྨོངས་པ་གཉིས་འགལ་བའི་ཕྱིར།",
    "རྒ་ཤི་ལ་འབྲས་བུ་མེད་ན་གཉེན་པོ་མ་བསྟེན་ཀྱང་རང་འགགས་སུ་འགྱུར་རམ་སྙམ་ན།",
    "ལྷན་ཅིག་དུས་མཉམ་པའི་ཁུངས་སུ་མི་རུང་སྟེ།",
    "འཛམ་བུའི་ཚལ་ན་འདུག་པའི་སོ་སྐྱེ་གཅིག་ལ་བྱིན་ན་སྦྱིན་པ་དེ་བས་སྦྱིན་པ་འདི་འབྲས་བུ་ཆེའོ་ཞེས་གསུངས་པས།",
    "འཇིག་རྟེན་གྱི་ཁམས་ཁ་ཅིག་ཟླ་བ་བཀས་པ་ལྟ་བུར་འདུག་གོ།",
    "ཁ་ཅིག་ནི་པདྨ་སྣ་ཚོགས་ཀྱི་དབྱིབས་སུ་འདུག་གོ།",
    "ཁ་ཅིག་ནི་ཤིང་རྟའི་དབྱིབས་སུ་འདུག་གོ།",
    "གཙོ་བོ་དང་རང་བཞིན་གཅིག་པ་མེད་དེ།",
    "རྗེ་དྭགས་པོ་བཀའ་བརྒྱུད་པ་ཏི་སེ་དང་མ་ཕམ་གངས་ཅན་དང་མ་དྲོས་པ་ཡིན་པར་འདོད་པ་ལ་རིགས་པ་དང་འགལ་བ་ཡིན་ཟེར་བ་ཞིག་བྲིས་འདུག་པའི་རིགས་པ་ནི་འདི་ཡིན་པར་སྣང་སྟེ།",
    "དབྱར་ཐ་ཆུང་དང་དགུན་ཐ་ཆུང་ནས་ཉི་མ་ཟློག་ཟེར་བ་སོགས་སྣ་ཚོགས་ཤིག་བྱུང་འདུག།",
    "འཇིག་རྟེན་པའི་ཐ་སྙད་ནི་ངེས་པ་མེད་དོ་ཞེས་བྲིས་གདའ་ལ།",
    "དེང་སང་དབྱར་དགུན་གྱི་ཉི་ཟློག་དབྱར་དགུན་གྱི་འབྲིང་པོ་ཧོར་ཟླ་ལྔ་པ་དང་བཅུ་གཅིག་པ་ལ་ཟློག་འདུག་པས་གནོད་དེ།",
    "ལོངས་སྤྱོད་ནི་ལྷའི་ཡུལ་ན་མི་ལས་ལྷག་པ་མི་འདུག།",
    "སླར་ལ་སྟོན་པ་མི་འཁྲུགས་པ་མི་ལས་ལྷག་ཏུ་འདུག་སྙམ་ནས་མི་ཡུལ་དུ་འོངས་ཞེས་དང་།",
    "ཆགས་ནས་བར་བསྐལ་ཉི་ཤུར་འདུག་པ་དང་།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "མ་ཟད་ན་ནི་སྟོང་གསུམ་གཅིག་དུས་མཉམ་དུ་འཇིག་པས་གཞན་དུ་འཕངས་ཏེ་ཟད་པ་དང་།",
    "དེའི་ཚེ་འཇིག་རྟེན་འདི་ཞིག་ནས་བར་གྱི་བསྐལ་པ་ཉི་ཤུར་འདུག་པ་གང་ཡིན་པ་དེ་ལས་ནི་ངེས་པར་འབྱུང་ཞིང་ཡོངས་སུ་རྫོགས་པའོ།",
    "འདི་ཆགས་ནས་བར་བསྐལ་ཉི་ཤུར་འདུག་པ་ནི་ངེས་པར་བྱུང་བ་སྟེ་དེར་ཚར་འབྱིན་པར་བྱེད་པའོ།",
    "ཆགས་ནས་བར་བསྐལ་ཉི་ཤུར་འདུག་པ་དེ་ནི་ཉེ་བར་འོངས་པ་སྟེ།",
    "འཁོར་ལོས་སྒྱུར་བ་བཞི་པོ་ཕྱོགས་ལས་རྒྱལ་བར་བྱེད་ཚུལ་རིམ་པ་བཞིན་ཕྱིར་རྒོལ་ཕ་རོལ་པས་བསུ་བ་དང་རང་འགྲོ་བ་དང་།",
    "ཁྱེད་རང་བྱེ་བྲག་པས་ཀྱང་།",
    "མིག་དང་གཟུགས་འཕྲད་ཙ་ན་གཟུགས་སྣང་བ་བཞིན་གཟུགས་ཀྱི་རྟེན་རྫས་ཀྱང་སྣང་བར་དམ་བཅས་པས་གཟུགས་ལས་ལོགས་སུ་དེའི་རྫས་ཀྱང་མ་དམིགས་པའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་ཆུས་འཇིག་དང་མེས་འཇིག་དུས་རིང་པོས་ཆོད་ཅིང་འབྱུང་ཞེ་ན།",
    "འོ་སྐོལ་གསང་སྔགས་པའི་ལུགས་ཀྱི་གནས་གང་དུ་འདུག་ཀྱང་གཞལ་ཡས་ཁང་བྱ་བ་ཡིན་ཏེ།",
    "ཡང་བཤིག་མང་པོ་བྱེད་པར་འདུག།",
    "གསུམ་པ་ཕན་ཆོད་སྒྲ་གྲག་སྟོང་རང་བཞིན་མེད་པར་བསམ་སྟེ་བཟླའོ།",
    "བརྟན་པར་ཆེར་ཐོབ་པས་མཉམ་གཞག་ཁོ་ནར་མ་ཟད་འགྲོ་འཆག་ཉལ་འདུག་ལ་སོགས་པའི་སྤྱོད་ལམ་ཐམས་ཅད་དུ་མ་བྲལ་བར་ཉམས་སུ་ལེན་ཏེ།",
    "ལུས་ཆ་སྙོམས་པས་ལུས་བདེ་སྟེ་འདུག་ཚུགས་པ་དང་།",
    "སྣང་བ་སྟོང་སྣང་དུ་འདུག།",
    "འགྱུ་བ་རང་སང་གཅིག་ཏུ་འདུག།",
    "ཀུན་རྫོབ་འཁྲུལ་པའི་བློ་ཡུལ་དང་བཅས་པ་ཐམས་ཅད་བདེན་པའི་དངོས་པོར་མ་གྲུབ་ཅིང་རང་རང་ངོ་བོས་སྟོང་པར་ཐག་བཅད་ལ།",
    "ཨ་ཙི་ཙི།",
    "ང་རང་ཕ་མེས་ཁྲི་སྲོང་ལྡེའུ་བཙན་གྱི།",
    "ནས་ཆང་སྤུན་ཟླའི་དབར་འཁོན་འཁྲུག་བྱེད་དོན་ཅི་འདུག་ག་མ།",
    "འབྲི་ཕག་ས་ཕག་སོགས་མ་འཆམ་པར་དམག་འཁྲུག་རྒྱག་དུས་བོད་ཀྱི་བཟོ་བཀོད་ལེགས་པའི་ལྷ་ཁང་།",
    "འདུགཁ་བ་ཟམ་མི་འཆད་པར་འབབ་ཅིང་།",
    "གོས་བགོ་ཁང་པ་ཆག་ཆག་བཏབ་པར་འདུག་ཅེས་པ་ལྟར་གྱི་ཟས་སྤྱོད་སྤང་བླང་ཤེས་དགོས་པ་ལ་གལ་ཆེ་ཞིང་སྐབས་འདིར་རྒྱུན་ཟས་ཀྱི་རིགས་ལས་འབྲས་ཆན་དང་།",
    "འོན་ཀྱང་ཁོའི་ཤེས་རབ་དེར་ངས་ཡ་མཚན་སྐྱེས་ཀྱིན་འདུག་ཁོ་ལྟ་བུའི་བརྩོན་འགྲུས་ཅན་ཞིག་ངས་གཏན་ནས་མཐོང་མ་མྱོང་ཞིང་།",
    "མལ་ཁང་ནང་དུ་སློབ་གྲོགས་མི་ཉུང་བ་ཞིག་བསྡད་འདུག་ང་ཐོན་པ་མཐོང་ནས་སློབ་གྲོགས་རིན་ཆེན་གྱིས་ཡ་འདིར་བཞུགས་དང་།",
    "ཚང་ཚིང་ཁྲོད་འདུག་ཆགས་ལྡན་གཞོན་ནུའི་ལུས།",
    "བསྲུང་སྤེལ་བྱུང་ན་ཅི་མ་རུང་སྙམ་པའི་བློ་ཞིག་འདུག།",
    "དེའི་སྟེང་རང་ཉིད་དང་མ་བྱན་བཅས་བདུན་ཡོད།",
    "མཁས་མཆོག་འདུག་པར་གྱུར་པའི་ཚེ།",
    "བསྟན་བཅོས་འདིར་ཉན་རང་རང་རྒྱུད་པའི་ལམ་བསྟན་ནོ།",
