    "གཏམ་གླེང་བྱས་ཏེ་ཅུང་ཙམ་བསྡད་རྗེས་དེ་གར་རྩམ་པ་ཟ་དགོས་ཞེས་ཨུ་ཚུགས་བྱེད་ཀྱིན་འདུག་པས་ངས་ཀྱང་འཛེམ་ཟོལ་མེད་པར་རྩམ་པ་བརྫིས་ནས་ཟོས།",
    "ཉི་མ་ནུབ་ཅིང་ས་རུབ་ལ་ཉེ་བས་ང་རང་འགྲོ་རྩིས་བྱེད་སྐབས་ཕྱེ་གཉེར་རྒན་པོས་ད་རུང་བྲེལ་དགོས་དོན་མེད།",
    "རྒན་པོ་དེ་དགོད་བཞིན་རྒན་ལགས་ཁྱེད་ཀྱིས་ཁོང་བློས་མི་ཐོངས་ན་དོ་ནུབ་ཁོང་ལ་ཕྱག་རོགས་གནང་སྟེ་བཞུགས་ཆོག་ཟེར་བས་ང་རང་ངོ་གནོང་སྟེ་གདོང་ཚ་ལམ་ལམ་དུ་གྱུར།",
    "ང་ཞེ་པོ་ཞེད་ཀྱིན་འདུག་རང་ཞེད་ཀྱིན་ཨེ་འདུག་ཅེས་རང་ལ་ཚོད་དཔག་མེད་པས་དེ་ལྟར་བཤད།",
    "སྐར་གྲངས་བྲིས་པའི་བརྡ་ཐོ་ཞིག་གྱང་ལྡེབས་སུ་སྦྱར་རྩིས་བྱེད་ཀྱི་འདུག་པས་དེ་མུར་སྒུག་ཡུན་མ་བཟོད་པའི་མི་རྣམས་དེའི་ཕྱོགས་སུ་འུར།",
    "ཉིན་ཞིག་ཨ་ཅག་དབྱངས་སྐྱིད་ཀྱི་ཁྱིམ་གྱི་སྒོ་འཛུལ་སྐབས་ཨ་ཞང་དང་།",
    "དབྱངས་སྐྱིད་ཀྱི་བསམ་པར་ད་ནི་སྐད་ཆ་ཤོད་པའི་དུས་ལ་བབ་འདུག་བསམ་ནས་འཁྲིས་སུ་ཕྲུ་གུ་མེད་པར་མི་རྒན་པ་ཁོ་ན་མཉམ་དུ་བསྡད་དེ་ཡུལ་པོ་ལོས་ཡོང་།",
    "མགོ་སྐྲ་བཟོ་ཞོར་དུ་དེང་སང་ཁྲོམ་རར་བྲིན་ཁ་རྒྱུགས་པའི་ཐ་མག་དང་བྱི་རིལ་ཁག་གཅིག་ཐབས་ཤེས་བྱས་པ་དེ་དག་བྲིན་པོ་ཞེ་དྲག་འདུག་དེར་བརྟེན་ལམ་འགྲོ་རྒྱུགས་ཐོག་ལ་བཙོང་ཟིན་ན་ཚོང་ཟོག་གཞན་འདྲེན་དགོས་པས་ང་བསྡད་ན་མི་འགྲིག་ཁྱེད་རང་ཡང་རྒྱུན་དུ་དཀའ་ལས་ཆེན་པོ་ཡིན་པས་དགུང་ཟས་ཡག་པ་ཞིག་ཉོས་ནས་མཆོདདེ་ང་ལ་བསྐྱེལ་མི་དགོས་པར་ངལ་གསོ་སྐྱོན།",
    "ཁྱེད་རང་གཉིས་ལྷོད་ལྷོད་བྱས་ཏེ་མཆོད་ཅིག་༧ཅེས་ཐོན།",
    "ཁོ་གཉིས་འཚོ་བ་མཉམ་དུ་བསྐྱལ་བ་ནས་ད་བར་ཕན་ཚུན་ཁྱེད་རང་མཆོད་དང་།",
    "བརྩེ་དུང་ཞེས་པ་ནི་བགོ་ཐབས་མེད་པ་དང་རང་ཤེད་ཅན་ཞིག་ཡིན་པས་ཁྱེད་གཉིས་ཁ་སྤྲོད་དུ་བསྡད་པ་ངས་མཐོང་བ་དང་།",
    "ཨ་ཇོ་ལྷག་པ་དང་།",
    "ཨ་ཙི།",
    "མ་གཞི་བྱས་ན་ང་རང་ཉལ་རོགས་ལ་འགྲོ་དགོས་ཀྱང་ཁྱིམ་དུ་འོ་མ་འཐུང་མཁན་ཕྲུ་གུ་ཡོད་པས་མི་ཞེས་སྟབས་མི་བདེ་བའི་རྣམ་འགྱུར་བསྟན།",
    "ད་ནས་བ་ཕྱུགས་ཞིང་ཁར་ཤོར་འདུག་ན་ངའི་ཁྱིམ་གྱིས་སྐར་ཆ་ཚང་མ་བཅོག་རོགས།",
    "སྐད་ཆ་དེ་དག་ཐོས་པས་ཕྲུ་གུ་གཞན་ཚོ་ནི་ཞེད་དེ་ངུ་ཀྱིན་འདུག་ལ།",
    "ཉེས་སྡིག་ངས་འཁྱེར་དགོས་འདི་འདྲ་ཡོང་བ་མི་འདུག་ངས་སྔོན་ལ་རང་ངའི་ཁ་ལ་ཉོན་དང་།",
    "མ་གཞི་ནས་ཁྱིམ་ལ་ཕྲུ་གུ་བདུན་ཡོད་པའི་ཁྲོད་ནས་བུ་ཁོ་རང་གཅིག་པུ་ལས་མེད་པས་པ་ཕས་ཀྱང་ཉེས་རྡུང་གཏོང་མི་སྲིད་སྙམ་ནས་དེ་ལྟར་བྱ་རྒྱུར་ཁས་བླངས་པ་མ་ཟད།",
    "སྐབས་དེ་དུས་ཁོ་ཚོའི་ཨ་ཞང་དམག་དཔོན་ཞིག་ཡོད་པ་དེ་ལྷ་ས་ནས་གཞིས་འཁོར་ལ་སླེབས་པ་དང་གཞིས་འཁོར་གཙང་ནས་ལྷ་སར་ལོག་སྐབས་རྒྱལ་མཚན་ལྷ་སར་ཁྲིད་ཕྱིན།",
    "ཧ་ཅང་སྙན་པོ་འདུག་ངའི་མིང་ལ་པ་སངས་བུ་ཁྲིད་ཟེར་གྱི་ཡོད།",
    "ང་རང་ངོ་སྤྲོད་བྱེད་ཀྱི་ཡིན།",
    "ལ་ཇི་ཞེས་འདོན་པ་ནི་ཆེས་རྒྱུན་གཏན་ཡིན་པས་ང་རང་རྗེས་སུ་ནང་སར་སླེབས་རྗེས་ཀྱང་ངའི་ཕ་ཡུལ་གྱི་ཡུལ་སྐད་འདྲེས་པའི་རྒྱ་སྐད་དེ་ཡུན་རིང་ང་དང་འགྲོགས་ནས་ལས་སླ་པོར་སྒྱུར་བཅོས་མ་ཐུབ།",
    "ང་རང་ཕྲས་པ་གློད་དེ་ཞོལ་ནས་མེ་ཤིང་བཙོངས་ཏེ་ཡོང་མཁན་ལ་ཨ་ཇོ།",
    "ཁོང་ཕེབས་གྲབས་འདུག་གམ་ཞེས་འདྲི་བ་དང་མི་དེས་ཀྱང་ཨོ་ལོ་གསལ་སྒྲོན།",
    "ང་རང་ད་དུང་བསམ་བློ་འདྲ་མིན་སྣ་ཚོགས་འཁོར་ནས་ཡོད་སྐབས་གསལ་སྒྲོན།",
    "ཡར་ལོངས་ཤོག་ད་འགྲོ་རན་འདུག་ཟེར་བ་རྣ་བར་ཐོས་སྐབས་ང་རང་གཉིད་ལས་སད་པ་ལྟར་བྱུང་སྟེ་ཧར་གྱིས་ཡར་ལངས།",
    "ཁྱེད་རང་སྙུན་གྱི་མི་འདུག་གམ།",
    "ཁྱེད་རང་ཐུགས་སྤྲོ་པོ་མེད་པ་ངས་ཤེས་ཀྱི་ཡོད།",
    "འདི་ལོ་དགུན་ཁ་ཁྱེད་རང་ཕ་མ་གཉིས་དང་སྤུན་མཆེད་འཕྲད་པར་ཕེབས་རྐྱང་གནང་ཞིག་སྐབས་དེ་དུས་ངས་ཡུལ་མི་ཚོའི་ཚབ་ཞུས་ཏེ་ཁྱེད་ལ་ལུག་ཤ་ཁོག་གཅིག་དང་འབྲུ་དོ་པོ་གཅིག་སྐྱེས་སུ་འབུལ་གྱི་ཡིན།",
    "དང་ཐོག་བྱས་ན་ང་རང་ཡང་ཡིད་ཆེས་མ་བྱུང་།",
    "ངའི་བག་ཆགས་ནང་རང་གཤིས་ཀ་གྱོང་ལ།",
    "ནམ་ལངས་འདུག་པས་མགྱོགས་པོ་ལོངས་ཤོག་ཅེས་བོས།",
    "ད་ཡིན་ན་ངས་ཁྱེད་རང་ལ་བཀྲ་ཤིས་བདེ་ལེགས་ཞུ་རྒྱུ་ཡིན།",
    "ངས་ཁྱེད་ཚོ་བརྗེད་པ་མི་འདུག་ཅེས་ཤོད་བཞིན་མིག་གཉིས་མཆི་མས་བཀང་།",
    "ང་རང་ཡིད་ཐང་རྦད་དེ་ཆད་ནས་ལུས་པའི་སྐབས་ངའི་རྒན་ལགས་ཀྱི་མཐོང་སྣང་དོད་པའི་གཟུགས་བརྙན་དང་།",
    "འགྱིག་ལྷམ་གྱིས་གཅུར་གྱིན་འདུག་གམམི་ཞེས་དྲིས།",
    "ལྷག་པར་དུ་ས་ཆ་བདེ་པོ་དང་འཇམ་པོ་འདི་འདྲར་རྐང་རྗེན་མར་རྒྱུགས་ན་དེ་བས་སྐྱིད་པ་འདུགམི་ཅེས་བཤད།",
    "ཁ་ཉིན་ཁོའི་པར་ཞིག་འབྱོར་འདུག་ཁོས་དམག་དཔོན་གྱི་ཆས་སྤྲས་པ་དང་ཉམས་ཧ་ཅང་དོད་པོ་འདུག་ཨ་ཙི།",
    "གང་འདྲ་འདུག་གམ་ཞེས་དྲིས་པ་ན།",
    "འོན་ཏེ་ད་ལྟ་དང་དུ་ལེན་མིན་ནི་དབྱངས་སྒྲོལ་རང་ལ་རག་ལས་འདུག་ཟེར་བ་སོགས།",
    "ད་དུང་མུ་མཐུད་དུས་ཚོད་ནར་འགྱངས་བྱས་ན་ཉེན་ཁ་ཆེན་པོ་ཡོད་བཟོ་འདུག་པས།",
    "བྱས་ན་ཁྱེད་རང་གཞུང་དོན་ཁང་ལ་མཚན་བཀོད་པར་ཕེབས་རོགས་གནང་ཟེར་བ་དང་།",
    "ངའི་ཆེད་དུ་མི་གཞན་སུས་ཀྱང་མི་ཕོད་པའི་མིང་བཀོད་པ་དེ་དག་ངས་ནམ་ཡང་བརྗེད་པ་མི་འདུགམི་ཅེས་ཤོད་ཀྱིན་མིག་ཆུ་ཁྲུམ་ཁྲུམ་དུ་བཏང་།",
    "ང་སྣང་དོགས་མི་འདུག་པད་མ་ད་ལྟ་ཡོང་གྲབས་ཡོད།",
    "ད་ང་སྐྱོན་མི་འདུག་པས་མིག་ཆུ་མ་གཏོང་ཟེར་བ་དང་།",
    "མ་གཞི་ནས་བལྟས་ཚོད་ལཁོང་ཡག་པོ་ཞིག་འདུག་ཀྱང་ང་ཁོང་དང་དགའ་རོགས་སྒྲིག་དགོས་མིན་ད་དུང་བསམ་བློ་བཏང་མེད།",
    "སྟབས་བདེའི་ཅོག་ཙེ་དེའི་ཐོག་ཚལ་སྣེ་ཁ་ཁ་ཤས་དང་སྦི་རག་ཤེལ་དམ་ཁ་ཤས་བསྒྲིག་ཡོད་པ་མཐོང་བས་ཁོས་ཨ་ཙི།",
    "པད་དབྱངས་ཀྱིས་ཁོ་སྡོད་དུ་བཅུག་ནས་ཁྱེད་རང་ལ་བསམ་རྒྱུ་དྲན་རྒྱུ་དེ་རང་ལས་མེད་པ་འདྲ།",
    "ཁ་ལག་ཟ་གྱིན་ངས་ཁྱེད་རང་ལ་དོན་དག་ཅིག་གྲོས་བསྡུར་བྱེད་དགོས་ཡོད་ཅེས་གྷི་ལ་སིའི་ནང་སྦི་རག་བླུགས་ཏེ་སྔོན་ལ་སྦི་རག་འདི་མཉེས་དག་གནོངས་དང་ཞེས་བསྟན་འཛིན་གྱི་ལག་ཏུ་སྤྲད།",
    "དེ་རྗེས་ཕུ་ཤོར་ཤོར་ངང་ཡར་ལངས་ཏེ་ཕར་རིའི་ལྕང་མ་གུག་གུག་ཚུར་རིའི་གླང་མ་གུག་གུག་གུག་ན་ཕར་གུག་ཚུར་གུག་མ་གུག་རང་རང་སོ་སོ།",
    "ད་ངས་ཁྱེད་རང་ལ་ཨུ་ཚུགས་ཞུས་མི་ཡོང་།",
    "ང་ད་ལྟ་ཉལ་འདོད་མི་འདུག་དེ་ལས་གྱོན་པ་བཀྲུ་རྒྱུ་འདྲ་མེད་དམ་ཞེས་དྲིས།",
    "པད་དབྱངས་ཀྱིས་ཁྱེད་རང་བླངས་ཆོག་ཆོག་དང་སློག་ཆོག་ཆོགབསམ་བློ་སྔོན་ནས་མ་བཏང་བར་ཅི་བྱེད།",
    "ཁྱེད་རང་རང་ཤེད་ཆེ་ཐག་ཆོད་ནས་ང་ལ་བསམ་བློ་གཏོང་བའི་དུས་ཚོད་ཀྱང་སྤྲོད་ཀྱིན་མི་འདུག་ཅེས་ཁོའི་སྒལ་པར་ཁུ་མཚུར་ཡང་པོར་གཞུ་བཞིན་གཅེས་སུ་འོས་པའི་སྤོར་གཅུས་ཀྱི་རྣམ་འགྱུར་ཞིག་བསྟན།",
    "ངའི་སེམས་ལ་ག་དུས་ཡིན་ནའང་ང་བསྟན་འཛིན་གྱིསཁྱེད་རང་སྡུག་ཏུ་མི་འཇུག་པ་ཞིག་བྱས་ཨང་སྙམ་གྱི་ཡོད།",
    "ད་ནས་ངའི་བྱེད་སྟངས་ལ་སྒྱུར་བཅོས་བཏང་ཆོག་ཁྱེད་རང་ལ་ཉེས་པ་གང་ཡང་མེད་པས་བློ་བདེ་པོ་གྱིས་དང་ཞེས་ཁོ་ལ་སེམས་གསོ་ཀྱིན་དམ་དུ་འཁྱུད།",
    "ད་གཟོད་ཁོ་རང་བློ་བདེ་པོ་བྱུང་ཏེ་མིག་གཉིས་བཙུམ་ནས་གཉིད་དུ་ཡུར།",
    "དེ་ནི་ངས་ཁྱེད་རང་ཚེ་གཅིག་སྡུག་ཏུ་མི་འཇུག་རྒྱུའི་དམ་བཅའ་བཞག་པ་དེ་ཡིན།",
    "ད་དུང་གཞན་ཞིག་དྲན་གྱིན་ཨེ་འདུག་ཞེས་དྲིས་པ་དང་ཁོས་མགོ་བོ་ཕྲེད་དུ་གཡུག་ཙམ་བྱས།",
    "དེ་ནི་དོན་དུ་ངས་ཁྱེད་རང་ལ་མནར་གཅོད་ལོ་གསུམ་བྱས་པ་དང་ཁྱད་ཅི་ཡོད་ཅེས་བཤད།",
    "བསྟན་འཛིན་གྱིས་དགོད་བཞིན་ད་ཁྱེད་རང་ལ་དེབ་བྱུང་ན་གཞན་གང་ཡང་དགོས་ཀྱི་མེད་པ་འདྲ།",
    "དེང་སང་འཁྱམས་རྒྱུ་ཡང་ཉུང་དུ་ཞེ་དྲག་ཕྱིན་འདུག་ཅེས་ཟླ་སྒྲོན་གྱི་ཆེད་དུ་དག་སེལ་བྱས།",
    "ཨ་ཙི་སྐུ་རྩེད་ཞུས།",
    "ངའི་ཁ་པར་ཁ་སྔོན་རྒྱ་ནག་ཏུ་འགྲོ་སྐབས་རྐུན་ལ་ཤོར་འདུག་དེང་སང་ཨང་གྲངས་གསར་པ་ཞིག་བེད་སྤྱོད་བྱེད་ཀྱིན་ཡོད་བྱས་ན་ལམ་སེང་འདིའི་སྟེང་བྲིས་དང་།",
    "སྟེར་བཟོ་གང་འདྲ་མི་འདུག་གམ།",
    "ཁྱེད་རང་ཡུན་རིང་པོ་སྒུག་དགོས་མ་བྱུང་ངམ་ཞེས་བརྩེ་བ་ཆེན་པོས་དྲིས།",
    "མ་གཞི་ནས་མི་ཚོསྐྱིད་སྐྱིད་ལ་ཕྱིན་པ་ཡིན་འགྲོ།",
    "ཟླ་སྒྲོན་གྱིས་ཁྱེད་རང་དེ་འདྲ་གསུངས་རྒྱུ་ཨ་ཡོད།",
    "ཟླ་སྒྲོན་གྱིས་ཨ་ཅག་རང་ནི་མི་སྙོམས་ཆུང་ཞེ་པོ་ཅིག་འདུག་རང་དེ་ལྟར་བྱས་ན་གྱོང་འཁེལ་ཡོང་།",
    "ཁྱེད་རང་དེ་རིང་སེམས་ཁྲལ་ཆེན་པོ་བྱུང་བ་ངས་ལོས་ཀྱང་ཤེས།",
    "ད་དོ་དགོང་ཁྱེད་རང་ཁ་ཁུ་སིམ་མེར་གཟིམས་བཞུགས་དང་ཞེས་སུན་སྣང་བསྟན།",
    "ཁྱེད་རང་གསོལ་ཇ་ཡིན་ནམ་བཞེས་ཐུག་ཡིན་ཞེས་སྐད་ཆ་དྲིས།",
    "སྔ་ཤོས་ལ་ཆུ་ཚོད་བཅུ་གཅིག་ལ་ལོག་མཁན་འདུག་ལ།",
    "ཁྱེད་རང་ད་དུང་གཟིམ་མེད་དམ་ཞེས་བསྟན་འཛིན་གྱིས་ལྕེ་བསྣར་ཙམ་བྱས་ཤིང་།",
    "ངས་མིག་བལྟས་ཏེ་གཡང་ལ་མཆོངས་འདུག་ཅེས་སྡུག་ཡུས་ཆེན་པོས་ངུས།",
    "ཁྱིམ་དུ་སླེབས་རྗེས་བསྟན་འཛིན་གྱིས་པད་དབྱངས་ཀྱི་ལྷམ་ཕུད་དེ་ཧྲ་ཧྥ་སྟེང་དུ་བཞག་པདང་རང་ངོ་མས་ཇ་ཕོར་སྤྲོད་བཞིནསློཔད་དབྱངས་ལགས།",
    "འགྲོ་རན་འདུག་གོ་ཞེས་དྲན་སྐུལ་བྱས།",
    "ད་དུང་མ་ཕྱིན་ན་རྗེས་ལུས་ཐེབས་པ་འདུག་གོ་ཞེས་སྔོན་ལ་སྦག་སྦག་བཞོན་ནས་ཐོན་ཆོག་ཨང་གསར་བྱས།",
    "ང་དང་བུས་ཁྱེད་རང་སྒུག་ནས་བསྡད་ཡོད།",
    "ད་ངས་ཁྱེད་རང་ལ་ཇི་ལྟར་ཞུ་དགོས་སམ།",
    "ཁོ་ཅི་བྱ་གཏོལ་བྲལ་དུ་གྱུར་པའི་སྐབས་སྐེད་པར་བཏགས་པའི་འབོད་བརྡ་གྲགས་ནས་ངས་ཁྱེད་རང་སྒུག་ནས་ཡོད་པས་མགྱོགས་པོ་ལོག་ཤོག་ཅེས་འཁོད་ཡོད་པས།",
    "ཁྱེད་རང་དེང་སང་རྒན་བཟོ་དོད་དུ་ཞེ་དྲག་ཕྱིན་བཞག་དངོས་གནས་དགོངས་པ་མ་ཚོམ།",
    "འོན་ཏེ་ཏག་ཏག་ཁྱེད་རང་ཡིན་པས་ངས་འདྲ་ཆགས་པོ་ཞིག་བྱེད་ཐུབ་པ་མི་འདུག་ངས་བརྩོན་ལེན་མ་བྱས་པ་མིན།",
    "འོན་ཀྱང་ཁྱེད་རང་མིཞེས་པད་དབྱངས་ལ་ཇ་ཚ་པོ་གང་བཤུག་རྩིས་བྱས།",
