    "དེ་མ་བཅོམ་ལྡན་འདས་ཀྱི་ས་ཚེ་དང་ལྡནབ་མོང་གལ་གྱི་བུ་ཆེན་བོ་ལ་འདི་སྐད་ཅེས་བཀའསྐུལ།",
    "ཁྱུ་མཆོག་པ་ལང་གི་ཚོགས་ཀྱིས་བཤེར་བ་ལྟ་བུ།",
    "འཁོར་ལོས་སྒྱུར་བའི་རྒྱལཔོ་བུ་སྟེང་གིས་བསྐོར་བ་ལྟ་བུ།",
    "ཉི་མ་འོད་ཟེར་སྟོང་གིས་བསྐོར་བ་ལྟ་བུ།",
    "འོན་འདོམ་གང་གིས་བརྒྱན་པའི་སྐུ་ཉི་མའིའོད་ཟེར་གོནསྟོདོབས་ལྷག་པའི་འོད་ཅན།",
    "རྒྱལ་བོ་ཟས་གཙན་གིས་གཞོན་རུ་དོན་ཐམས་ཅད་གྲུབ་པ་འབབ་ཆུ་རོ་ཧི་ཏ་ཀར་བྱོན་ཏོ་ཞེས་ཐོས་མོ།",
    "འོན་ཏེ་སྲས་ཡབ་ཀྱི་ཞབས་ལ་ཕྱག་ཀྱོད་པ་བལྟའོ་སྙམ་མོ།",
    "མོའི་ཏིང་དེ་འཛིན་ལ་སྙོམས་བར་ཞུགས་ཕན།",
    "སྐུའི་སྐདནས་ཆུ་གྲང་མོའ་རྒྱུན་འབེབས་བར་མཛད་པ་།",
    "བློ་གྲོས་ཡངས་པ་ཁྱོད་ལ་འདི་དང་ནི།",
    "གཞལ་མེད་ཁང་གི་གནས་རྣམས་ལས།",
    "ཇི་ལྟར་ཁྱོད་ཀྱིས་སྐུ་ཡིས་བཟོད།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་གསོལ་པའདི་ལྟར་ཁྱོད་སྟོན་གསེར་གྱི་གཞོང་པ་ནས།",
    "འདི་ལྟར་ཁྱོད་སྟོན་བསིལ་ཁང་གཞལ་མེད་ཁང་།་",
    "རྒྱལ་བོ་ཟས་གཙང་གིས་གསོལ་པ།",
    "རྒྱལ་བོ་ཟས་གཙང་གིས་གསོལ་པ།",
    "རྒྱལ་བོ་ཟས་གཙང་གིས་གསོལཔ།",
    "ཤཱཀྱ་བདུན་ཁྲི་བདུན་སྟེང་གིས་རྒྱུན་ཏུ་ཞུགས་བའི་འབྲས་བུ།",
    "དེ་ལ་ཤཱཀྱ་རྣམསཀྱིས་གཤེ་ལའི་ཚིག་གིས་སྨྲས་པ།",
    "དེ་ཐོསོ་པས་རྒྱལཔོ་ཟས་གཙང་མགཏོགསཔར་བདུད་༣རྩི་ཟས་ལསོགས་པ་ཤཱཀྱ་བདུན་ཁྲི་ལྔ་སྟེངགིས་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་མངོན་སུམ་དུ་བྱས་པ་ན་ཡང་ལྷ་སྦྱིན་དེ་ཁོ་ན་བཞིན་དུ་ཟེར་རོ།",
    "ཁ་ཅིག་གིསནི་རྒྱན་དུ་ཞུགས་པའི་འབྲས་བུ་མངོན་དུ་བྱས།",
    "ཁ་ཅིག་གིས་ནི་ཕྱིར་མི་འོདོབའི་འབྲས་བུ།",
    "ཁ་ཅིག་གིས་ནི་རབ་ཏུ་བྱུད་ནས་ཉོན་མོངས་པ་ཐམས་ཅད་སྦངས་ཏེ།",
    "དལྟར་ནི་མིས་མཆོད་ཀྱིས་ལྷསནི་མ་ཡིན་ནོ་སྙམམོ།",
    "དེ་ནསཤཱཀྱ་གཞོན་ནུཞིག་གི་སཚིགས་སུ་བཅད་དེ་གསོལ་པ།",
    "རྒྱལ་པོ་ཟས་གཙང་ནི་འདི་སྙམ་དུབདག་གི་བུ་འབའ་ཤིག།",
    "དནས་བཅོམ་ལྡན་འདས་ཀྱིས་ཚདང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ལ་བཀའསྩལ་པ།",
    "མཐོང་ནས་ཀྱང་ཚ་དང་ལྡནཔ་མོད་གལ་གྱི་བུ་ཆེན་པོ་ལ་འདི་སྐད་ཅེས་སྒྲམ་སོ།",
    "བཙུན་པ་མོདགལ་གྱི་བུ་ཆེན་བོ་ཚུར་སྦྱོན།",
    "འོག་བཙུན་པ་མོདགལ་གྱི་བུ་ཆེན་པོ་གདན་བཤམས་པ་ཉིད་ལ་བཞུགས་ཤག།",
    "ཚདང་ལྡན་པ་མོད་གལ་གྱི་བུཆེན་པོས་གདན་བཤམས་པ་ཉིད་ལ་འདུག་ག།",
    "དེནས་ཚེ་དང་ལྡན་པ་མོད་གལ་གྱི་བུ་ཆེནཔོས་སེམས་ཇི་ལྟར་མཉམཔར་གཞགན་རང་གིསྟན་ལསམི་སྣང་བར་གྱུར་ཏེ།",
    "ཤར་ཕྱོགས་ཀྱི་སྟེང་གི་བར་སྣང་ལ།",
    "ལུས་ཀྱི་སྨད་ནས་མེ་འབར་བར་བྱེདལ་ལུས་ཀྱི་སྟོད་ནས་ཆུ་གྲང་མོའི་རྒྱུནའ་བབས་པར་བྱེད་དོ།",
    "དེ་ནས་རྒྱལ་པོ་ཟས་གཙང་གིས་ཚད་དལྡན་པ་མོད་གལ་གྱི་བུཆེ་ན་པོ་ལ་འདི་སྐདཅེས་སྨྲས་སོ།",
    "བཙུན་པ་མོད་གལ་གྱི་བུ་ཆ་ན་བོ་བཅོམ་ལྡན་འདས་ཀྱི་ཉན་ཐོས་འདི་ལྟར་རྫུ་འཕྲུལ་ཆ་བའ་དྲི་ལྟར་མཐུ་ཆེ་བ་གཞན་ཡང་མཆིས་ལགས་སམ།",
    "བཅོ་མལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ།",
    "དེ་ནས་ཚདང་ལྡ་ནཔ་མོདག་ལ་གྱི་བུ་ཆེན་པོ་རྒྱལ་པོ་ཟས་གཙང་ཁྲིད་ད་བཙོ་མ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་ཚེ་དང་ལྡན་པོམ་བརྒྱམོད་གལ་གྱི་བུ་ཆེན་པོ་ནང་དུ་ཞུགས་པ་དང་།",
    "དེ་ནས་རྒྱལ་པོ་ཟས་གཙང་ལྷོ་སྒོར་སོང་བ་དང་།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་མཐོང་ནས་སྣུས་པ།",
    "རྒྱལ་བོ་ཟས་གཙང་གིས་མཐོང་ནས་སྨྲས་པ།",
    "གཞིན་བཟངས་ཁྱོད་སུ་ཞིག་མིག་མི་བཟང་གིས་སྨྲས་པ།",
    "དེ་ནས་རྒྱལ་བོ་ཟས་གཙང་བྱང་སྒོ་དསོང་བ་དང་།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་སྒྲས་པ།",
    "བརྒྱ་དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་དགོངས་པ་རྒྱལ་བོ་ཟས་གཙང་གིས་གལ་ཏ།",
    "ད་མ་མཐོད་ན་ཁྲག་དྲོན་པོ་སྐྱུགས་ནས་འཆི་བར་འགྱུར་བའི་གནས་སྐབས་གང་ཡིན་པ་དེ་ཡོད་ཀྱིས་དེ་ལ་ཐབས་ཤགི་བཤ་མ་པར་བྱའོ་སྙན།",
    "ཁད་པ་བརྩེ་གས་པ་གང་ཡིན་པ་དེ་ཤེལ་ལ་ས་བྱས་པར་སྤྲུལ་པ་དད་དེ་ནས་རྒྱལ་བོ་ཟས་གཙང་གིས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་རྒྱལ་པོ་ཟས་གཙང་གི་བས་མ།",
    "ཁྱོད་ཀྱིས་བདག་ལ་མཛད་ལགས་ཏེ།",
    "༣བཅོ་མ་ལྡན་འདས་གང་ན་བ་དེར་ལེགས་སུ་ཐལ་མོ་སྦྱར་བ་བཏུད་དེ་བཙེམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "རྒྱལ་པོ་ཟས་གཙང་གིས་རལ་པ་ཅནལས་རབ་ཏུ་བྱུང་བའིདགེ་སློད་རྣམས་སྤྱོད་ལམ་ཞི་ཞིང་སེམས་དདཔ་ཡིན་ན་དཀའ་ཐུབ་དྲག་པའི་བརྟུལ་ཤུགས་ཀྱི་ཁྱད་པར་དག་གིས་ལུས་གདུངས་པསབཙ།",
    "རེརརབ་ཏུ་བྱུང་ཤིགཅེས་དེ་སྐདབཀའ་སྩལ་ཏོ།",
    "བདག་ནི་རབ་ཏུ་མ་འབྱུང་གིས།",
    "ཡུམ་གདུགས་རེ་རེ་ཞིངཟས་ཅི་ཡངམ་ཡིན་ཞེས་བགྱི་བ་འདི་ལྟ་བུ་བསྐུར་བའི་རིགས་སོ།",
    "ལྷ་རྒྱལ་བོ་ཟས་གཙང་གིས་དྲིལ་སྒྲོགས་སུ་བཅུག་པ།",
    "དེའི་འོག་ན་མེ་ཏོག་གི་རྩ་བ་ཡོད་པའིརིག་པ་དེའི་ཉམས་སུ་མྱོང་ནས་སྨྲས་པ།",
