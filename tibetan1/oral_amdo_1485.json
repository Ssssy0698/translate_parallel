    "ཁྱོད་ཀྱིསབདག་གིར་མཛོད་ཅིག་དེ་ནས་བྱར་ཆུབསེམས་དཔའ་འདི་སྙམ་དུ་དགོངས་ཏེ།",
    "གལ་ཏེ་བདག་གིས་མིའི་ཁ་ཟས་མི་བཟའ་བར་དམབཅས་ལ་བདག་གི་བ་སྐུའི་ཁུང་བུ་ཐམས་ཅད་དུ་ལྷ་རྣམས་ཀྱིས་ལྷའི་མདངས་བསྒྲུབས་ནས་དེ་བདག་གིར་བྱེདཔ་ནི་བདག་གི་བརྫུ་འོ་ཡིན་ལ།",
    "ཡང་ནཧ་རེ་ནུཀའི་འབྲས་བུའི་ཁུ་བ་བཏུད་དོ་སྙམ་མོ།",
    "ཡང་ནམོན་སྲན་སྔེའུ་ཡིཁུ་བ་འམ།",
    "ཡང་ནཧ་རེ་ནུ་ཀའི་འབྲས་བུའི་ཁུ་བ་གསོལ་ལོ།",
    "རྔ་མོའོ་རྐེད་པ་ལྟ་བུར་གྱུར་ཏོ།",
    "མལ་བདག་གིས་ཏིལ་འབྲུ་གཅིགི་གས་ཟ་ས་བཟའ་བར་བྱའོ་ཞེས་ཏེ་དེས་ཏིལ་འབྲུ་གཅིག་གི་ཟས་གསོལ་ཏོ།",
    "མོན་སྲན་གྲེའུ་འབྲུ་གཅིག་དང་།",
    "བླ་ན་མེད་པ་ཡངདག་པར་རྫོགས་པར་བང་ཆུབ་པར་ནུས་པ་མ་ཡན་ནོ་སྙམ་མོ།",
    "དེ་ནས་ལྷ་གཅིག་གིས་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "དེ་རྣམས་བདག་ཉིད་ལགནོད་པའི་སྡུག་བསྔལ་མི་བཟད་པ་རྩུབ་བ་ཚབ་ཡིད་དུ་མིའང་བའི་ཆང་བ་དེ་ལྟ་བཉམསསུ་མང་མོད་ཀྱི་འོན་ཀྱང་དེ་རྣམས་ཀྱིས་ཤེས་པར་ནུས།",
    "འོ་མའི་ཐུག་པ་འདི་སུས་འཐུདམ་པ་དེས་ན་བླ་ནམད་པའི་ཡེ་ཤེས་འཐོབ་པར་འགྱུར་གྱིས་མ་ལ་བདག་གིས་བསླང་ངོ་སྙམ་མོ།",
    "བླངས་ནས་ཀྱང་དགའ་མོ་དང་།",
    "འབྲས་བུ་སྣ་ཚོགས་དང་ལྡན་པ་ཞིག་གཟིགས་ནས་དེ་དེ་ལ་འཛེགས་ཏེ་ཕྱོགས་སུ་དབ་ནཞིང་གསལ་བའི་ཕྱོགས་སུ་ལམོ་ཀྲུང་བཅས་ཏེ་བཞུགས་སོ།",
    "ནས་ཐལ་མོ་སྦྱར་ཏེ་སྐད་ཕྱུང་བ།",
    "མཚོན་ཆ་རྣམ་པ་སྣཚོགས་མང་པོ་དང་ཆས་པ་དེ་རྣམས་གཟིགས་ནས་དགོངས་པ་ར་ཤག་སྐྱས་པ་ཕལ་བ་ཞིག་དང་ལྷན་ཅིག་འཐབ་པར་རྩོམ་ན་ཡད།",
    "དཔེར་ན་ས་ལ་བྱ་བ་བཞིན་ནོ་ནམ་མཁའ་ལ་སྐྱིལ་མོ་དཀྲུང་གིས་གཤེགས་པར་མཛདང་།",
    "མ་ལ་བདག་གིས་རྒྱང་རིད་པོ་ཁོ་ནོར་འདུག་ལསྒྲ་འབྱུངབར་བྱའོ་སྙམ་ནས་དེས་འབྲུ་དཔོ་བྱེབ་ཕྲག་སུམ་བཅུ་རྩ་དྲུག་དང་འཇིགས་པཆན་པོ་འཇིགས་སུ་རུང་བའི་སྒྲ་ཕྱུང་ངོ།",
    "དགྲར་གྱུར་པ་དེ་དག་ཇི་ལྟར་ཤེས་པར་བྱ་སྙམ་མོ།",
    "རྣམ་པར་གྲོལ་ནབདག་གི་སྐྱེ་བ་ནི་ཟད་དོ།",
    "ལན་གཉིས་ལནགསུམ་དུ་ཡང་བཅོམ་ལྡན་འདསལ་བདུད་ཀྱི་བུམོགསུམ་ས་འདྲ་སྐདཅེས་གསོལ་ཏོ།",
    "ལན་གཉིས་ལན་གསུམ་དུ་བཅོམ་ལྡན་འདས་ལ་བཅུད་ཀྱི་བུམོ་གསུམ་གྱིས་དེ་སྐད་ཅེས་གསོལ་ཀྱང་།",
    "དེནས་བདུད་ཀྱི་བུ་མོ་གསུམ་བཅོམ་ལྡན་འདས་ག་ལ་བ་དར་ལེགས་སུ་སོང་སྟེཕྲིན་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་ལ་མགོ་བོས་ཕྱག་བཅས་སོགས་གཅིག་ཏུ་འདུག་ནས་བདུད་ཀྱི་བུ་མོ་གསུམ་གྱིས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐ་དནསགསོལ་ཏོ།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་བདག་ཅག་གིས་བྱིས་པ་ཇིལྟ་བ་དང་།",
    "དེ་ནས་བདུདཀྱི་བུ་མོ་གསུམ་པོ་ངད་གི་གཟུགས་ཉི་ང་སྐད་ནས་བཅོམ་ལྡན་འདས་ཀྱྀ་ཞབས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་བཅོམ་ལྡན་འདས་ལ་དད་པར་གྱུར་པ་དང་དེ་ཉིད་ངུ་མི་སྐད་བར་གྱུར་ཏོ།",
    "གྱོ་མོ་རྣམས་བསལ་ནས་ཙན་དནགྱི་ཆུ་སཆག་ཆག་བཏབ།",
    "སློངས་མོ་བ་རྣམས་།",
    "གད་གི་ཚ་འདི་བཙས་པ་ན་གྲོང་ཁར་ཐམས་ཅད་དགའ་བར་གྱུར་པས་དེའི་ཕྱིར་ཁེའུ་ཡི་མདི་ཀུན་དགའ་བོར་གདགས་སོ་ཞེས་བཏགས་སོ།",
    "ང་སངས་རྒྱ་ས་བཅོམ་ལྡན་འདས་མའ་ཁམས་ལ་སྙོམས་པར་ཞུགས་ནས་སྐྱིལ་མ་དཀྲུད་གཅིག་གིས་ཞགབདུན་འདའ་བར་མཛད་དོ།",
    "བརྐྱད་སྟེ་བསྐུམས་པ་ཙམ་གྱིས་ཚངས་རིས་ཀྱི་ལྷ་གཉིས་ཀྱིས་ཚངས་རིསཀྱ་འཇགི་རྟ་ནནས་མི་སྣང་བར་གྱུར་ཏེ།",
    "བཟང་བེ་རྡོ་གཉིསས་ཀྱི་ཡུན་རིང་བོའི་དོན་དང་ཕན་པ་དང་བད་བར་འགྱུར་གྱིས་མ་ལ་བ་ངག་རང་གིས་འདི་ལྟ་སྟེབཅོམ་ལྡན་འདས་ལ་བསོད་སྙོམས་འབུལ་དུ་བཞག་པའི་ཕྱིར་བརྩོན་པར་བྱའོ་སྙམ་ནས་དེ་ན་ལྟ་དེས་ཤིང་རྟ་དང་།",
    "ག་ང་གི་ཕྱིར་འདི་ལྟར་ལྟས་ཀྱང་འདི་ལྟ་སྟེ་བཅོམ་ལྡན་འདས་དེ་ལ་བསོད་སྙོམས་དབུལ་བའི་ཕྱིར་བརྩོན་པར་བྱེད་དོ།",
    "སྙམ་ནས་ནང་བར་སྔར་ལངས་ཏེ་སྦྲང་རྩི་དང་འདའ་གུ་མང་དུ་ཁྱེར་ནསབཅོམ་ལྡན་འདས་གདན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལམགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "བཙུན་པ་བཅོམ་ལྡན་འདས་ཀྱི་ཆེད་དུ་འདིར་བདག་ཅག་གིས་སྦྲང་རྩི་དང་འདའ་གུ་མང་དུ་འཚལ་ཏེ་མཆིས་ཀྱིས་བཅོ་མ་ལྡན་འདས་ཐུགས་བརྩེ་བ་ཉེ་བར་བཟུང་སྟ་འདི་བཞེས་སུ་། གསོལ་དེ་ནས་བཅོམ་ལྡན་འདས་འདི་སྙམ་བུ་དགོངས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་ཀྱང་དགོངས་ཤིང་ཡེ་ཤེས་གཟིགས་པ་བསྐྱེད་ན།",
    "བཅོམ་ལྡན་འངས་གང་ན་བ་དེར་སོང་སྟེ་ཕྱིན་པ་དང་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱསནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "གང་གི་དོན་དུ་སྐྱིནཔ་བཏང་།",
    "ལྷ་དང་བདུད་ཀྱི་རིས་དག་གིས།",
    "དེ་ནས་བདག་གིས་ཁ་དོག་དང་དྲིད་དརོ་དད་ལྡན་པའི་ཨ་རུར་འདིར་འཚལ་ཏམཆིས་ཀྱིས་དེ་བཅོམ་ལྡན་འདས་གསོལ་ཅིག།",
    "དེའི་ཚེ་ཀླུའི་རྒྱལ་པོ་བཏང་བཟུང་གི་ག་ནས་སུ་ཞག་བདུན་དུདུས་མ་ཡིན་པའི་སྤྲིན་ཆགས་པར་གྱུར་ཏོ།",
