    "དག་འབར་བྱེད་དགའ་མགུར་སྤྱོད་པ་དབྱེདཔ་ན་དེ་རྣམས་ལས་བུད་མདཅིག་དམ་བཅས་པ་དྲལ་ཏེ་བྲོས་སོ།",
    "བཅོམ་ལྡན་འདས་ཇི་ག་བུ་དམེད་གཅིག་གཟིགས་སམ།",
    "བུད་མེད་གཅིག་དམ་བཅས་པ་དྲལ་ཏེ་བྲོས་ནས་བདག་ཅག་ཚོལ་ལགསསོ།",
    "བཙུན་པ་བདག་ཅག་ལ་བུད་མེད་ཀྱིས་ཅི་བགྱྀས།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་གྲོང་བའི་བུ་མོ་དག་འམོ་དང་།",
    "དགའ་སྟོབསམས་བཅོམ་ལྡནའདས་ཀྱི་ཞབས་གཉིས་ལམགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ་ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོ་མ་ལྡན་འདས་ཀྱིས་གྲོང་བའི་བུ་མོ་དག་འ་མོདང་།",
    "དེ་ནས་ཀྲོང་བའི་བུ་མོ་དགའ་མོ་དང་དགའ་སྟོབསམསབཅོམ་ལྡན་འདས་ལ་འདི་སྐདཅས་གསོལ་ཏོ།",
    "འོན་ཀྱང་དེ་ན་ཀླགདུག་པ་ཞིག་གནས་ཏེ་དེས་ཁྱོད་བྲོ་བཙམས་པར་གྱུར་དུ་མཆིའོ།",
    "འདོ་སྲུང་ཁྱོད་ཀྱིས་རེ་ཤིག་གནང་བར་གྱིས་ཤིག་དང་མཐོབཙམས་པརམ་འགྱུར་རོ།",
    "ལྟེ་རྒྱས་འོད་སྲུང་རལ་པཅན་མཚན་མོ་རྒྱུ་སྐར་ལ་ལྟ་བན་མེ་ཁད་ཐམས་ཅད་འབར་རབ་ཏུ་འབར་ཀུན་དུ་རབ་ཏུ་འབར་ཏེ།",
    "འདི་ལྟར་དགེསྦྱོད་ཆེ་ན་པོརྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཅགཀྱངདགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "དགེ་སྐྱེད་ཆེན་པོ་བདག་ག་༡༢ཁོར་ན་གནས་ན་དེའི་མཐུ་ཞིག་མ་བྱུང་གྲང་སྙམ་མོ།",
    "དགེ་སློང་ཆེན་པོ་བོ་དག་ག་ཉི་འཁོར་ན་གནས་ན་དེའི་མཐུ་ཞིག་མ་བྱུང་གྲང་སྙམ་མོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོད་སྲུང་རལཔཅན་བཅོམ་ལྡན་འདས་ཀཱ་རྩ་༧རྒྱ་མི་དྭགས་གང་ནབ་དེར་སོང་སྟེ་ཕྱིན་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེམ་གསོལ་ཏོ།",
    "འདི་ལྟར་དགེ་སྦྱོད་ཆེ་ནཔོ་རྫུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཨམཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "ཀུན་དུ་རབ་ཏུ་འབར་ཏམལྕེ་གཅིག་ཏུ་གྱུར་ནས་སྲོག་པར་བྱེད་པ་ཡོད་དོ་སྙམ་མོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོང་སྲུང་རལ་པ་ཅན་ནང་བར་རྩྭར་ལངས་ཏེ་བཅོམ་ལྡནའདས་གང་ན་བ་དེར་སོང་སྟེ།",
    "མེལྕེ་ཅིག་དོན་དུ་གྱུར་ནས་སྲེག་པར་བགྱིང་པ་བཞི་མཆིས་སོ་སྙམ་མོ།",
    "མཁས་པ་ཀུན་ནས་ཉོན་མོངས་ལས།",
    "མོལྕེ་གཅིག་ཏུ་གྱུར་ནས་སྲེགཔར་བྱེད་པ་བཞི་པེ་ལྟ་བུའི་ལུས་ཀྱིས་ཕྱོགས་གཅིག་ཏུ་འདུག་པ་ཡིན་ནོ།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ་ཤེས་བྱ་བའི་བར་དུ་གོང་མ་བཞིན་ནོ།",
    "ལྟང་རྒྱས་འོད་སྲུད་རལ་པ་ཅན་དེ་ཉིད་ཀྱི་མཚན་མོ་ཟླ་སྐར་རྣམས་ལལྟ་བན་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔ་ན་མེའི་ཕུང་པོ་ཆེན་བོ་འབར་ཞེས་བྱ་བ་ནས།",
    "ཡ་མཚན་ཆེ་མོད་གྱི་བདག་ཀྱད་དགྲབཅོམ་པ་ཡིན་ནོ་སྙམ་མོཞེས་བྱབའི་བར་དུ་གོང་མ་བཞིན་ནོ།",
    "དེའི་ཚེ་ཞག་བདུན་དུ་ལྟད་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་ལ་རེད་པདང་།",
    "དགེ་སྦྱོང་ཆེན་པེ་ཁྱོད་ཅིའི་སླད་ངུ་ཞག་བདུན་འདི་ནས་བཞུད་ལགས།",
    "འོད་སྲུང་ཁྱོད་ཀྱི་འདུག་གནས་ན་མཆོད་སྦྱིན་ཞག་བདུན་དུ་བྱེད་པ་ལ་འབནས་འདི་སཱམ་དུ་གལ་ཏམ་ག་དྷུའི་མི་རྣམས་ཀྱིས་དགེ་སྦྱོང་ཆེན་པོ་ནི་འདི་ལྟར་རྫུ་འཕྲུལ་ཆེ་ཞིང་འདི་ལྟར་ཆམཐུ་ཆ་བ་ཡན་ནོ་བརཤེས་ན་དེ་ཁེ་ན་ལབྱབ་བྱེད་པར་སེམས་ཀྱི་བདག་ལ་ནི་དེ་ལྟདམ་ཡིན་པའི་གནས་འདི་ཡོད་པར་འགྱུར་གྱིས་ཀྱེ་མ་དགེ་སྦྱོད་ཆེན་པོ་ཞག་བདུན་ཞིག་འདིནས་གཞན་དུ་སོང་ཡད་ཅི་མ་རུང་སྙམ་སེམས་པམ་ཡིན་ནམ།",
    "དེ་ནས་སྟེང་རྒྱས་འོད་སྲུང་རལ་བ་ཅན་གྱི་མ་བཅོམ་ལྡན་འདས་ཀྱི་ཆེད་དུངང་ཁེ་ནས་ག་ཡོས་བྱས་ནས་བཅོམ་ལྡན་འདས་གང་ན་བ་དེར་སོང་སྟེ།",
    "འོད་སྲུང་དེའི་ཕྱིར་སོང་ཤིག་ང་ཡང་འོང་ངོ།",
    "ཇིལྟར་ཐུགས་མཉམ་པར་པ་ཞག་ན་ཤིང་འཛམ་བུ་ཞེས་བྱ་བ་ག་ད་གིས་འཛམ་བུ་གླིང་དུ་གདགས་པ་དེ་ལས་ཁ་དོག་དང་དྲི་དང་རོ་དང་ལྡན་པའི་འཛམ་བུའི་སྙམ་རྣམས་ཀྱིས་ལྷུང་བཟེ་དབཀ་ངནས་འདིར་ཕྱིན་པ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཀྱིས་གལ་ཏེ་འདོདོན་ལོངས་སྐྱོད་ཅིག།",
    "འདིར་ངས་འོད་སྲུང་ཁྱོད་སོར་ནས་རང་པོ་མ་ལོན་པར་མཁྱེནནས་ཇིལྟ་འཟུགས་ཉམ་བཞགན་ཟུང་གི་སྒྲམི་སྙན་གྱི་གླིང་རུ་གཤེ་གས་ནས་མ་རྨོས་མ་བཏབ་པའི་འབྲས་སཱ་ལུའི་འབྲས་ལྷུང་བཟེད་བཀང་ནས་འདིར་ཕྱིན་པ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ཀྱིས་གལ་ཏ་འདོད་ན་ལོངས་སྦྱོད་ཅིག།",
    "འདི་ལྟར་དག་སྦྱོང་ཆེན་པོ་སྒྱུ་འཕྲུལ་ཆེ་ཞིང་མཐུ་ཆེ་བ་ཡིན་ཏེ་ཡ་མཚན་ཆེ་མེད་ཀྱི་བདག་ཀྱད་ངགྲ་བཅོམ་པ་ཡིན་ནོ་སྙམ་མོ།",
    "དེ་ནས་ལྷའི་དབད་བོ་བརྒྱ་བྱིན་གྱིས་བཅོམ་ལྡན་འདས་ལ་ཆུས་ཆུའི་དགོས་པ་བྱུང་བར་ཤེས་ནས་བཅོམ་ལྡན་འདས་གདན་བ་དང་སོང་སྟེ་ཕྱིན་ནས།",
    "མཐོང་ནས་འདི་སྙམ་དུ་སེམས་ཏེ་ཆུ་འདི་སྔོན་ནི་མེད་ན་ཆུ་འདི་ད་ལྟ་རགང་ནས་བྱུང་སྙམ་མོ།",
    "འོང་སྲུད་འདིར་ཁྱོད་ལས་བསོད་སྙོམས་བཞེས་ནས་ཕྱོགས་འདིའི་བཞུགས་ཏེ་ཞལ་ཟས་ཀྱི་བྱ་བ་མཛད་བ་ན་དལ་རྒྱུས་ཆུའི་དགོས་པ་ཞིག་བྱུང་ངོ།",
    "ཡ་མཚན་ཆེ་མོད་ཀྱི་བདག་ཀྱང་དགྲ་བཅོམ་པ་ཡན་ནོ་སྙམ་མོ།",
