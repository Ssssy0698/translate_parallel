    "རང་སེམས་སྐྱོ་ནས་ཉིན་མཚན་མ་འཁྱོལ་བས།",
    "བདག་ཅག་ལྕམ་སྲིང་གསུམ་ལ་ཐུགས་རྗེས་གཟིགས།",
    "གནས་ཆེན་འདི་རུ་ལོ་ནི་བཅུ་གཉིས་སོང་།",
    "ཕར་ལམ་ཟླ་དྲུག་ཚུར་ལམ་ཟླ་བ་དྲུག་ལོ་ནི་བཅུ་གསུམ་ཡབ་ཀྱི་བཀའ་ལས་ལྷག་ད་ནི་རང་གི་ཡུལ་དུ་འབྱོན་པ་ཞུ།",
    "བཟང་མོ་ཁྱོད་ནི་མཆི་མ་མ་གཏོང་ཞིག་ད་རང་རེ་གཉིས་འགྲོ་བར་བྱའོ་གསུངས་ནས་རྒྱལ་བུ་གདན་ལས་བཞེངས་ཏེ་འབྱོན་པར་ཆས་པ་དང་།",
    "རང་གིས་གཞན་ལ་གནོད་པ་མ་བྱེད་ཅིག་བདེ་བར་སྡོད་ཅིག་རིགས་མཐུན་གྲོགས་པོའི་ཚོགས།",
    "རྒྱལ་བུའི་ཞལ་ནས་ཁྱོད་བྱོན་པ་དགའ་སྟེ།",
    "རྒྱལ་བུ་དགྱེས་ཏེ་ས་དེ་གར་སྐྱིལ་མོ་དཀྲུང་མཛད་དོ།",
    "ལུས་ཅི་ཙམ་ཞིག་བླངས་ཀྱང་དོན་མེད་དུ་སོང་སྟེ།",
    "དེར་མནྡེ་བཟང་མོ་མྱ་ངན་གྱི་སྐུད་ཆེན་པོ་ཤོར་ཏེ་སེམས་ཀྱིས་མ་བཟོད་པར་ཕྱག་ལ་འཆང་ནས་ངུས་པས།",
    "བཟང་མོ་དེ་ལྟར་མ་བྱེད།",
    "བདག་གི་སྦྱིན་པའི་བགེགས་མ་བྱེད་པར་སྡོད་ཅིག་གསུངས་ནས་སྤྱན་ལ་གྲི་བསྐྱར་ནས་གཙུགས་ཏེ་བཏོན་ནོ།",
    "དེ་ནས་མནྡེ་བཟང་མོ་བལྟ་བས་མ་བཟོད་པར་ཁ་ས་ལ་བུག་སྟེ་བརྒྱལ་ལོ།",
    "ལེགས་པར་ཉོན་ཅིག་ལེགས་ལྡན་བྲམ་ཟེ་ཁྱོད།",
    "གཏོང་བར་དཀའ་བའི་མིག་གཉིས་ཁྱོད་ལ་བྱིན།",
    "བྲམ་ཟེ་ན་རེ།",
    "བདག་གི་མིག་འདི་རྒྱལ་བུ་དྲི་མེད་ཀུན་ལྡན་གྱི་ཡིན།",
    "དེ་ནས་ཡུན་རིང་པོ་ཞིག་ནས་མནྡེ་བཟང་མོ་དྲན་པ་རྙེད་དེ་ཡར་ལངས་ནས་རྒྱལ་བུ་ལ་བལྟས་པས་ཞལ་རས་དང་སྐུ་མདུན་ཐམས་ཅད་ཁྲག་གིས་གང་ནས་ཀྲོང་ངེར་བཞུགས་པ་དང་།",
    "མནྡེ་བཟང་མོས་མཆི་མ་འདོན་ཞིང་སྨྲས་པ།",
    "ཨེ་མ་འཇིགས་པའི་རི་ལ་ལོ་ནི་བཅུ་གཉིས་སོང་།",
    "ད་ནི་རང་གི་ཡུལ་དུ་ལོག་ནས་ནི།",
    "འབད་པ་དོན་མེད་སོང་ངོ་ཨ་ཙ་མ།",
    "སྔར་བྱས་ཐམས་ཅད་དོན་མེད་ལས་སུ་སོང་།",
    "བཟང་མོ་ཁྱོད་རང་མྱ་ངན་མ་བྱེད་པར།",
    "ད་ཡང་འགྲོ་བས་ཁྱོད་ཀྱིས་ལམ་སྣ་དྲོངས།",
