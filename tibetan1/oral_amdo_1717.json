    "སྙིགས་མའི་གྲང་རེག་དགྲ་ཡིས་གཙེས་པ་འདི།",
    "གང་གི་བཀའ་བཏགས་རི་མོས་གཙུག་མཛེས་པའི།",
    "སྣོད་མིན་ལ་གསང་སྣ་ཚོགས་རྡོ་རྗེའི་རྒྱ། ། ན་མོ་གུ་རུ་ཝ་ཀི་ཤྭ་ར་བཛྲ་དེ་ཝ་ཌཱ་ཀི་ནི།",
    "ཉོན་མོངས་ལྔ་སྦྱངས་དག་པ་ལྔ་དང་ལྡན།",
    "འཕགས་མཆོག་སྦྱན་རས་གཟིགས་ལ་གསོལ་བ་འདེབས།",
    "གདུལ་དཀའི་དྲང་སྲོང་བྱོལ་སོང་བཅས་པ་དང་།",
    "ཉམས་དང་རྨི་ལམ་དངོས་སུ་ཕྱི་ནང་གི།",
    "བགེགས་ཚོགས་དཔུང་གིས་འཚེ་བར་རྩོམ་པའི་ཚེ།",
    "དཔའ་བོ་བྲམ་ཟེའི་གཟུགས་ཅན་སྔོ་བསང་གིས།",
    "རི་བོ་ཏཱ་ལར་འཕགས་པ་སྤྱན་རས་གཟིགས།",
    "ཕྱག་སྤྱན་སྟོང་གི་སྣང་བརྙན་འབར་བ་ཡིས།",
    "གླུ་གར་རྡོ་རྗེའི་ལྟད་མོ་འགྱེད་པ་ཡང་།",
    "སླར་ཡང་སྲིད་གསུམ་བདག་མོའི་ཆོ་འཕྲུལ་གྱི།",
    "འཁོར་ཚོགས་བརྒྱ་ཕྲག་གིས་བསྐོར་མདུན་བྱོན་པར།",
    "པཎ་གྲུབ་དུ་མའི་སྣང་བརྙན་གསལ་གཟིགས་པ།",
    "མཐོང་ཐོས་དྲན་རེག་འགྲོ་བ་མ་ལུས་པ།",
    "ཉོན་མོངས་ལམ་གྱི་མ་དག་རྒྱུད་སྦྱངས་ཏེ།",
    "རང་ཉིད་ཀྱི་འཁྲུལ་སྣང་ཟ་ཟི་རྣམས་ཞལ་གཟིགས་ཀྱི་ཚུལ་དུ་སྒྲོགས་པ་འདི་ནི།",
    "རེ་ཞིག་གསུམ་ལས་ལྷག་པར་མི་སྤེལ་ཞིང་།",
    "༡མཆོད་བརྗོད་དང་གླེང་བསླངས་པའི་ཡལ་འདབ། ། ན་མོ་གུ་རུ།",
    "མཉེན་ལྕུག་ཕྱག་གིས་ཉེར་བསྐུལ་འགྱུར་ཁུག་བྱེ་བའི་རྒྱུད་མང་སྒྲས།",
    "ལྷན་ཅིག་རྒྱལ་བསྟན་པད་ཚལ་རབ་བཞད་ལོག་སྨྲའི་ས་མོས་ཟུམ་བྱེད་ལ།",
    "བསྒྱུར་མཁས་ཀུན་གཟིགས་ཁྱབ་བདག་རྡོ་རྗེ་ཐོགས་མེད་རྩལ་དེར་འདུད།",
    "གང་གི་རྣམ་དཀར་ཐུགས་བསྐྱེད་གསེར་གྱི་གཞིར།",
    "རབ་བསྒྱུར་དམ་པར་རློམ་རྣམས་གད་མོའི་གནས།",
    "སྣ་ཚོགས་མཛད་པའི་རི་མོ་མ་ལུས་ཀུན།",
    "ཤེས་ལྡན་གཞོན་ནུ་ཡོངས་ཀྱི་གཟིགས་མོར་སྤེལ།",
    "ཞེས་ཚིགས་སུ་བཅད་པའི་རྒྱུད་ནས་དྲངས་པའི་སྐྱེས་རབས་ལྗོན་པའི་རི་མོས་དཔའ་བོའི་རྒྱུད་མང་རྣམ་པར་སྒྲོགས་པ་ལ།",
    "མོས་པ་དང་།",
    "རྒྱལ་པོ་པཎ་གྲུབ་ཁྱེའུ་བུ་མོ་སོགས་ནས་བཟུང་།",
    "ཀྱེ་གངས་རིའི་མགོན་པོ་སྤྱན་རས་གཟིགས།",
    "གནས་དེ་ན་ཁྱོད་ཀྱི་ཞིང་ཁམས་ཡོད།",
    "ཞིང་དེ་ན་ཁྱོད་ཀྱི་གདུལ་བྱ་ཡོད།",
    "པཎ་གྲུབ་གཏེར་སྟོན་སོགས་ཀྱི་བཀོད་པས་འཛམ་གླིང་ཤར་ནུབ་ཐམས་ཅད་དུ་གནས་ལྔའི་རྩིབས་སྟོང་རྣམ་པར་བཀྲ་བའི་འཁོར་ལོས་ལུས་ཅན་བརྟན་གཡོའི་ཡོན་ཏན་ཐམས་ཅད་བདག་གིར་བྱས་ཏེ།",
    "མེ་ཏོག་མདའ་ཅན་གྱི་ཀུན་རྟོག་བདག་གིར་བྱས་པ་འགས་སྣ་ཚོགས་ཀྱི་བརྗོད་བྱ་འགོད་པ་ནི།",
    "བདག་གིས་ངེས་པར་སྤྲུལ་ཞིང་བྱིན་བརླབས་པའི།",
    "རང་གི་ཚོགས་ལྡན་ཉན་པོའང་ང་།",
    "ལོག་ལྟ་ཅན་འགའི་སྡིག་རྐྱེན་དུ་འགྱུར་སྲིད་པས་རེ་ཞིག་བཏང་སྙོམས་སུ་བཞག་ཀྱང་།",
    "རྣལ་འབྱོར་ཆེན་པོ་མདའ་ཆར་གྱི་སྤྲུལ་པར་ལུང་གིས་ཟིན་པའི་སློབ་བུ་སྐྱིད་ཐང་ནས་བློ་བཟང་རྣམ་རྒྱལ་དང་།",
    "དཔག་མེད་ཁྲོད་ན་བསྐལ་བཟང་འདབ་བརྒྱའི་གཉེན་གཅིག་ཕྲག་སྟོང་རྣམ་པར་ཤར་མོད་ཀྱང་།",
    "འོག་མིན་གནས་ཀྱང་ཅ་ཅོར་གྱུར་མོད་འོན་ཀྱང་བསིལ་ལྗོངས་མུན་བཅས་ཆེར་མ་གསལ།",
    "དཔག་ཡས་འོད་ལྡན་ཕྱག་ན་པདྨོ་ཁྱོད།",
    "བོད་ཡུལ་ཉིན་མོར་གསལ་བ་དང་།",
    "མཁས་གྲུབ་རི་དྭགས་མིག་ཅན་རི་མོའི་གར།",
    "དེའི་ཚེ་སེར་སྐྱའི་གྲོང་ནས་རྒྱལ་པོ་ཟས་གཙང་གིས་བཅོམ་ལྡན་འདས་ཀྱི་དྲུང་དུ་འཆར་ཀ་ཕོ་ཉར་བཏང་སྟེ།",
    "མདའ་རུམ་བཞུགས་པ་ཚུན་ཆད་ནས་བདག་གིས་ལེགས་པར་ཁྱོད་བསྲུང་སྟེ་ཞེས་སོགས་ཀྱི་འཕྲིན་ཡིག་བྲིས་ཏེ་བསྐུར་བས།",
    "ན་ཡ་གྲོ་དྷཱའི་ཀུན་དགའ་ར་བ་དང་ཚངས་པའི་གནས་ཀྱི་སྐྱེད་མོས་ཚལ་རྣམ་པ་གསུམ་དུ་གཙུག་ལག་ཁང་བརྩིགས་པས།"
  ]
}