    "འོ་ན་ཇི་ལྟར་ངེས་པར་བྱ་ཞེ་ན།",
    "དེས་ན་སྦྱོར་ལམ་རང་ཡུལ་ལ་ཞེན་པའི་ཞེན་བློ་ཡིན་ཡང་མངོན་ཞེན་བཀག་པའི་རྣམ་པ་ཅན་དུ་གསུངས་པ་མི་འགལ་ཏེ།",
    "སྐབས་ཀྱི་དཔྱད་གཞི་སྦྱོར་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་རྣམ་རྫོགས་སྦྱོར་བའི་བཞེད་ལུགས་བཞུགས། ༥ལམ་མཉམ་གཞག་དེའང་སྒྲ་དོན་འཛིན་པའི་རྟོག་པ་ཡིན་ཡང་སྒྲིབ་པ་གཉིས་པོ་གང་ཡང་མིན་ཞེས་པ་འདི་འབྱུང་ཞིང་དེ་ཉིད་ངེས་པར་ཁས་ལེན་དགོས་ཀྱིས།",
    "འོན་ཀྱང་དེ་སྤང་བྱའི་རྟོག་པ་མིན་ཞེས་ནི་སྨྲ་བར་མི་བྱ་སྟེ་དེ་ལྟར་ན་སྒྲིབ་གཉིས་གང་རུང་ལ་སྤང་བྱས་མ་ཁྱབ་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "ཁྱད་གཞི་འདུས་བྱས་ཀྱི་དངོས་པོར་གྲུབ་དགོས་པར་བསམས་ནས་ཅུང་ཟད་གཅིག་དཔྱོད་པར་འདོད་པས།",
    "སྤྱིར་འཕགས་རྒྱུད་ཀྱི་མཁྱེན་པ་དང་རྟག་པའི་གཞི་མཐུན་ཡོད་པར་སྨྲ་བའི་གཏམ་འདི་བོད་ཕྱི་རབས་པའི་མཁས་པ་ཚོས་གསན་ན་མཆོག་ཏུ་བཞད་གད་མཛད་པར་ངེས་ཤིང་།",
    "དགོངས་པ་འཚོལ་བ་ལགས་པས།",
    "དེ་དང་མཚུངས་ལྡན་གྱི་གཙོ་བོའི་རྣམ་རིག་གཉིས་ཀ་ལ་བྱས་ནས་དེ་ཐེག་ཆེན་སེམས་བསྐྱེད་སྤྱི་ཡི་མཚན་ཉིད་དུ་བཞེད་པ་གང་ཞིག།",
    "སློབ་པའི་མཉམ་གཞག་ཀྱང་རྟག་པ་རུ་དོན་གྱིས་གསུངས་ཏེ།",
    "འོག་ཏུ་རིགས་ཚུལ་དང་སྦྱར་ཏེ་དངོས་ཤུགས་ཅི་རིགས་པས་རིམ་བཞིན་འཆད་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་གསུབ་བྱེད་སྨྱུག་གྲི་ཙམ་གྱིས་མི་ཆོག་པས་རལ་གྲི་རྣོན་པོ་ཞིག་འཛིན་པར་རིགས་སོ་ཞེས་འབྲུག་པདྨ་དཀར་པོས་དགེ་ལྡན་པ་ལ་གདམས་པའི་གདམས་པ་དེ་སྐུ་ཞབས་ཉིད་ལའང་མཛའ་བར་འགྱུར་རོ།",
    "ཡེ་ཤེས་རྟག་པར་སྨྲ་བའི་གཏམ་ལ་ཐན་དུ་བརྩི་བ་པོའི་མཁས་པ་དག་ལའང་ཐུགས་བསམ་བསྐྱར་མ་ཞིག་བཞེས་རྒྱུའི་སྐལ་པ་ཕུལ་ཡོད་སྙམ།",
    "དེ་དག་གཞན་རྒྱུད་ཀྱི་ཤེས་པའི་རྣམ་པ་ཅན་དུ་སྐྱེས་པ་ལ་བསླུ་བ་མེད་པའི་ཆ་ནས་གཞན་སེམས་ཤེས་པ་ཞེས་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་རྣམ་རྫོགས་སྦྱོར་བའི་བཞེད་ལུགས་བཞུགས། ༥བཞག་པ་ཡིན་གྱིས།",
    "ཅེས་པ་ལྟར་འགྱུར་བས་མངོན་རྟོགས་ཀྱི་རིམ་པ་འཆད་མི་ནུས་པར་དགོངས་ནས།",
    "འོ་ན་དེ་འདྲའི་མངོན་སུམ་དེ་ཡུལ་ལྐོག་གྱུར་དེ་ལ་ལྟོས་ན་འཁྲུལ་ཤེས་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་རྣམ་རྫོགས་སྦྱོར་བའི་བཞེད་ལུགས་བཞུགས། ༥སུ་འགྱུར་ཏེ་ཡུལ་དེ་ལ་ལྟོས་ན་རྗེས་དཔག་ཡིན་པའི་ཕྱིར་ཞེ་ན།",
    "ཏིང་ངེ་འཛིན་གྱིས་བྱེད་པར་གསུངས།",
    "ཞེས་གསུངས་པའི་ཕྱིར་ཞེས་པའི་ལན་གཅིག་ཡོད།",
    "དེ་ལྟར་ལན་གཉིས་ལས་ཕྱི་མ་འདི་ཉིད་དོན་ལ་གནས་ཚབས་ཆེའམ་སྙམ་པས་རྣམ་དཔྱོད་ཅན་ཚོས་ཞིབ་ཏུ་དཔྱད་པར་འཚལ།",
    "གནས་སྐབས་དང་གནས་སྐབས་ཅན་གཉིས་གཅིག་དང་ཐ་དད་བརྟག་ནས་ལྡན་པ་མིན་པའི་འདུ་བྱེད་རྫས་གྲུབ་བཀག་པ་ཙམ་གྱིས་ཆོག་ཤེས་པར་མཛད་པ་དང་།",
    "བྱང་འཕགས་ཀྱི་མཉམ་གཞག་ལ་འདུས་བྱས་ཀྱིས་ཁྱབ་པ་དང་ཡོངས་གྲུབ་དང་དོན་དམ་བདེན་པ་ལ་འདུས་མ་བྱས་ཀྱིས་ཁྱབ་ཅིང་དེ་གཉིས་གཞི་མཐུན་མི་སྲིད་པས།",
    "དེ་མངོན་སུམ་དུ་རྟོགས་པའི་མཉམ་གཞག་ཡེ་ཤེས་དེ་འདུས་བྱས་ཡིན་པ་དང་།",
    "དེ་གཉིས་ཀའང་དོན་དམ་བདེན་པ་ཡིན་པས་དོན་དམ་བདེན་པ་ལ་འདུས་བྱས་དང་འདུས་མ་བྱས་གཉིས་ཡོད་ཅིང་དེ་ལྟར་ན་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་རྣམ་རྫོགས་སྦྱོར་བའི་བཞེད་ལུགས་བཞུགས། ༥བདེན་གཉིས་ཀྱི་མཚན་ཉིད་ཀྱང་།",
    "གང་ལ་དངོས་སུ་དམིགས་ན་ཞེས་སོགས་འཇོག་པ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "ཞིག་བྱ་བ་ལགས་པས་དོན་གཉེར་ཅན་ཚོས་རྣམ་དཔྱོད་ཀྱི་སྤྱན་བཙུམས་ནས་མ་བཞུགས་པར་ཐུགས་རིག་སྒྲིམ་སྟེ་གསན་འཚལ།",
    "བྱང་ས་ལས་ཀྱང་དེ་ལྟར་གསུངས་པ་སོགས་རབ་ཏུ་མང་ངོ།",
    "མཚན་གཞི་ནི་ཕྱིན་ཅི་མ་ལོག་པའི་ཡུལ་དང་ཡུལ་ཅན་གཉིས་ཀ་དོན་དམ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་རྣམ་རྫོགས་སྦྱོར་བའི་བཞེད་ལུགས་བཞུགས།",
    "རིགས་པས་སྤྱད་བཟོད་དུ་གྲུབ་ཀྱང་གནས་ལུགས་མཐར་ཐུག་དཔྱོད་པའི་ངོར་མ་གྲུབ་ཅེས་པའི་ཁྱད་པར་ཕྱེ་བ་ནི་ཟེར་རྒྱུས་ཕོངས་པའི་ནང་རྟགས་ཙམ་ལས་དེ་འདྲའི་ཁྱད་པར་དེ་སུས་ཤེས་སྙམ་ན་ནི།",
    "དེས་ན་རྫས་སུ་གྲུབ་ན་གནས་ལུགས་མཐར་ཐུག་དཔྱོད་པའི་ངོར་གྲུབ་པས་མ་ཁྱབ་པ་འདི་རྗེ་དེ་ཉིད་ཀྱི་བཞེད་པ་ཡིན་པར་གདོན་མི་ཟ་ལ།",
    "ཞེས་གསུངས་པ་འདི་རྣམས་ཡིན་ནོ།",
    "སྤྱིར་རྣམ་རྫོགས་སྦྱོར་བས་མཁྱེན་གསུམ་གྱི་རྣམ་པ་བརྒྱ་བདུན་ཅུ་རྩ་གསུམ་སྒོམ་ཞེས་པའི་དོན།",
    "རྣམ་པ་ཐམས་ཅད་དུ་མཁྱེན་གསུམ་བསྒོམ་བྱའི་ཡུལ་དང་།",
    "སྦྱོར་བ་སྒོམ་བྱེད་ཀྱི་ཡུལ་ཅན་དུ་བྱས་ནས་བསྒོམ་བྱ་སྒོམ་བྱེད་ཀྱི་ཡུལ་ཡུལ་ཅན་མཚན་ཉིད་པའི་སྒོ་ནས་སྒོམ་དགོས་པའི་དོན་མ་ཡིན་ཏེ།",
    "ཐེག་དམན་གྱི་རྟོགས་རིགས་དེའང་མི་དམིགས་པའི་རྣམ་པས་ཟིན་པའི་སྒོ་ནས་སྒོམ་དགོས་པའི་ཕྱིར་རོ་ཞེས་པ་འདི་ཉིད་ཀྱིས་གྲུབ་པར་སེམས་སོ།",
