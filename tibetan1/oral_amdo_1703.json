    "སྐྱོན་དུ་མར་ཐལ་བར་འགྱུར་བའིཕྱིར་རོ།",
    "དེ་དག་ལ་སྔ་ཕྱི་དང་ལྷན་ཅིག་གི་རིམཔ་དག་ཡོད་ཀྱང་རུང་མེད་ཀྱང་རུང་སྟེ།",
    "ཡོད་ན་སྐྱེ་བ་དང་རྒཤི་དག་ནི་རེ་ཞིག་ཡོད་དོ།",
    "གང་ལ་སྔ་ཕྱི་ལྷནཅིག་གི།",
    "དེ་ལྟར་རིགསཔ་སྔོན་དུ་བཏང་སྟེ་བརྟགས་ན་སྐྱེ་བ་གང་དང་རྒ་ཤི་གང་ལསྔ་ཕྱི་དང་ལྷན་ཅིག་གི་རིམ་པ་དག་མི་སྲིད་ཅིང་མེད་པ་དེ་ལཁྱོད་སྐྱེ་བ་ནི་དེ་ཡིན་ན་ཤི་ནི་དེ་ཡིན་ཞེས་ཅིའི་ཕྱིར་སྤྲོསཔར་བྱེད་ཅིང་རྗོད་པར་བྱེད།",
    "སྐྱེ་བ་དང་རྒ་ཤི་ཡོད་དོ་ཞེས་བྱ་བ་དེ་དག་ལ་སྔཕྱི་དང་ལྷན་ཅིག་གི་རིམ་པ་དག་མེད་པ་རང་བཞིན་དུ་གནས་པ་སུཞིག་དེ་སྐད་རྗོད་པར་བྱེད།",
    "ཚོརདང་ཚོར་པོ་ཉིད་དང་ནི།",
    "རྒ་ཤི་དག་གི་སྔ་ཕྱིདང་ལྷན་ཅིག་གི་རིམ་པ་དག་མི་འཐད་པ་དེ་བཞིན་དུ་རྒྱུ་དངའབྲས་བུ་དང་མཚན་ཉིད་དང་།",
    "གཞལ་བྱ་ལ་སོགས་པ་ཡོད་པར་བརྟགས་པ་དེ་དག་ཐམས་ཅད་ལ་ཡངསྔ་ཕྱི་དང་ལྷན་ཅིག་གི་རིམ་པ་དག་མི་འཐད་དོ།",
    "རེ་ཞིག་གལ་ཏེ་འབྲས་བུ་སྔ་བར་གྱུར་ལ།",
    "འབྲས་བུ་ཡོདན་ཡང་རྒྱུས་ཅི་བྱ་སྟེ་རྒྱུརབརྟགས་པ་དོན་མེད་པ་ཉིད་དུ་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "མ་སྐྱེས་ན་དེ་གང་གི་མཚན་ཉིད་དུ་འགྱུར།",
    "ཅི་སྟེ་ཡང་མཚནཉིད་ཀྱི་གཞི་སྔ་བར་གྱུར་ལམཚན་ཉིད་འཕྱི་བར་གྱུར་ན་དེ་ལྟ་ན་ཡང་མཚན་ཉིད་ཀྱི་གཞིམཚན་ཉིད་མེད་པ་ཅན་དུ་ཐལ་བར་འགྱུར་བས་དེ་ཡང་མི་འཐད་དེ།",
    "ཅིསྟེ་འགྱུར་ན་ནི་རི་བོང་གི་ལ་སོགས་པ་ཡང་ཡོད་པར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ཡང་ཚོརབ་མེད་ཅིང་མ་སྐྱེས་ན་དེ་གང་གིཚོར་བ་པོར་འགྱུར།",
    "ཅི་སྟེ་ཡང་ཚོར་བ་སྔ་བར་གྱུར་ལ་ཚོར་བ་པོའཕྱི་བར་གྱུར་ན་དེ་ལྟ་ན་ཡང་ཚོར་བར་མི་བྱེད་བཞིན་དུ་ཚོརབར་འགྱུར་བས་དེ་ཡང་མི་འཐད་དེ།",
    "ཅི་སྟེ་འགྱུར་ན་ནི་གང་ཡང་གང་གི་ཚེགང་དུ་ཡང་ཚོར་བ་དང་བྲལ་བར་མི་འགྱུར་བས་དེཡང་མི་འདོད་དོ།",
    "ཅི་སྟེ་ཡང་ཚོར་བ་དང་ཚོར་བ་པོ་དག་ལྷནཅིག་ཉིད་དུ་རྟོག་ན།",
    "ཚོར་བ་ཡང་ཚོར་བ་པོ་ལ་མི་ལྟོས་པ་ཁོ་ན་སུས་ཀྱང་ཚོར་བར་མི་བྱེད་བཞིན་དུ་རང་ལས་རབ་ཏུ་གྲུབ་པར་འགྱུརབས་དེ་ཡང་མི་འཐད་དོ།",
    "དེ་བཞིན་དུ་གལ་ཏེ་རྣམ་པར་གྲོལ་བས་དེཡང་མི་འཐད་མྱ་ངན་ལས་འདས་པ་སྔ་བར་གྱུར་ན་ཀུན་ནས་ཉོནམོངས་པ་དང་བཅས་པ་ཡང་མྱ་ངན་ལས་འདས་པར་འགྱུར་ཏེ།",
    "རྣམ་པར་གྲོལ་ནས་ཕྱིས་མྱ་ངན་ལས་འདའ་བ་དོནམོད་པ་ཉིད་དུ་ཡང་འགྱུར་རོ།",
    "གཞི་མེད་པར་སྡུགབསྔལ་ཡོད་པར་མི་རིགསཔས་སྡུག་བསྔལ་དེ་དག་གི་ཡིན་པ་དེ་འགའ་ཞིག་ཀྱང་ཡོད་དེ།",
    "སྡུགབསྔལ་དེ་དག་གི་ཡིན་པ་དེ་ནི་བདག་ཡིན་པས་དེའི་ཕྱིར་བདག་ནི་ཡོདཔ་ཁོ་ན་ཡིན་ནོ།",
    "ཁ་ཅིག་སྡུག་བསྔལ་བདག་གིས་བྱས།",
    "འདི་ལ་སྡུག་བསྔལ་དུ་སྨྲ་བ་རྣམསལ་ཁ་ཅིག་ནི་སྡུག་བསྔལ་བདག་གིས་བྱས་པར་འདོད།",
    "གཉི་གསབྱས་པའི་ཕྱིར་བདག་དང་གཞན་དང་གཉི་གའི་བྱ་བ་ཡིན་པརཐལ་བར་འགྱུར་ཏེ།",
    "སྡུག་བསྔལ་དེ་ནིདེ་དག་གི་བྱ་བ་ཡིན་པར་མི་རིགས་སོ།",
    "དེ་ལ་རེ་ཞིགགལ་ཏེ་སྡུག་བསྔལ་ཡོད་པ་བདག་ཉིད་ཀྱིས་བྱེད་དོ་ཞེས་རྟོག་ན།",
    "དེ་ལྟ་ན་ཐུག་པ་མེད་པར་ཐལ་བར་འགྱུར་བས་དེ་ནི་མི་འདོདདོ།",
    "ཅི་སྟེ་བྱེད་ན་ནི་རི་བོང་གི་ཀྱང་བདག་ཉིད་བྱེད་པརའགྱུར་རོ།",
    "དེ་ལྟར་རེ་ཞིག་སྡུག་བསྔལ་བདག་གིས་བྱས་པར་མི་རིགས་སོ།",
    "གལ་ཏེ་བདག་གིསབྱས་གྱུར་ན།",
    "གལ་ཏེསྡུག་བསྔལ་བདག་གིས་བྱས་པར་གྱུར་ན་དེ་ལྟ་ན་བརྟེན་ནས་འབྱུངབར་མི་འགྱུར་བཞིག་ན།",
    "དེ་དེ་བཞིན་ཏེསྡུག་བསྔལ་བདག་གིས་མ་བྱས་ཏེ།",
    "གང་གི་ཕྱིར་ཕུང་པོ་གཞན་དུ་གྱུར་བའདི་དག་ལ་བརྟེན་ནས་ཕུང་པོ་དེ་དག་འབྱུངབའི་ཕྱིར་རོ།",
    "གཞན་དེ་དག་གིས་འདི་བྱས་པས།",
    "གལ་ཏེ་མ་འོངས་པའིཕུང་པོ་དེ་དག་ལས་དལྟར་གྱི་ཕུང་པོ་གང་དག་ཡིན་པ་འདི་དག་གཞན་ཡིན་པར་གྱུར་ཅིངད་ལྟར་གྱི་ཕུང་པོ་འདི་ལས་ཀྱང་མ་འོངས་པའི་ཕུང་པོ་གངདག་ཡིན་པ་དེ་དག་གཞན་ཡིན་པར་གྱུར་ན་ནི་དེ་ལྟ་ན་ད་ལྟར་གྱིཕུང་པོ་གཞན་དེ་དག་གིས་མ་འོངས་པའི་ཕུང་པོ་གཞན་འདི་དགབྱས་པས་སྡུག་བསྔལ་གཞན་གྱིས་བྱསཔར་ཡང་འགྱུར་བ་ཞིག་ན།",
    "སྡུག་བསྔལ་ཉིད་ཀྱིས་སྡུག་བསྔལ་བྱས་པསདེའི་ཕྱིར་སྡུག་བསྔལ་བདག་གིས་བྱས་སོ་ཞེས་ཀྱང་མི་སྨྲའི།",
    "སྡུག་བསྔལ་གང་ཟག་བདག་གིས་བྱས་པསདེའི་ཕྱིར་རེ་ཞིག་སྡུག་བསྔལ་བདག་གིས་བྱས་སོ་ཞེས་ཀྱང་སྨྲལ།",
    "སྡུག་བསྔལ་གང་ཟག་བདག་གིས་བྱས་པས་དེའི་ཕྱིར།",
    "རེ་ཞིགསྡུག་བསྔལ་བདག་གིས་བྱས་སོ་ཞེསཀྱང་སྨྲ་ལ།",
    "གལ་ཏེ་གང་ཟག་བདག་གིས་ནི།",
    "སྡུག་བསྔལ་བྱས་ན་གང་བདགགིས།",
    "གལཏེ་གང་ཟག་བདག་གིས་ཕུང་པོ་སྡུག་བསྔལ་བྱས་སོ་ཞེས་ཟེར་ན།",
    "ཁྱོད་ཀྱི་གང་ཕུང་པོ་སྡུག་བསྔལ་མེད་པ་གསལ་བར་བྱེད་པ་མེདཔས་བདག་གིས་ཕུང་པོ་སྡུག་བསྔལ་དེ་བྱས་པའི་གང་ཟག་སྡུགབསྔལ་མེད་པ་དེ་གང་ཡིན་པ་དེ་ཇི་སྨྲོས་ཤིག།",
    "དེའིཕྱིར་གང་ཟག་བདག་གིས་སྡུག་བསྔལ་བྱས་ཞེས་བྱ་བ་ཡང་མི་རིགསསོ།",
    "སྡུག་བསྔལབྱུང་ན་གཞན་ཞིག་གིས།",
    "བདགགིས་བྱས་པར་མ་གྲུབ་པས།",
    "འདི་ལ་གལ་ཏེ་སྡུག་བསྔལ་བདག་གིས་བྱསསོ་ཞེས་བྱ་བ་དེ་རབ་ཏུ་གྲུབ་པར་གྱུར་ན་ནི་དེས་ན་སྡུག་བསྔལགཞན་གྱིས་བྱས་སོ་ཞེས་བྱ་བ་དེ་ཡང་འཐད་པར་འགྱུར་བ་ཞིགན།",
    "སྡུག་བསྔལ་བདག་གིས་བྱས་སོ་ཞེས་བྱ་བ་དེ་ནི་རབ་ཏུ་མ་གྲུབསྟེ།",
    "དེ་སྡུག་བསྔལ་བདག་གིས་བྱསཔས་རབ་ཏུ་མ་གྲུབ་པས་སྡུག་བསྔལ་གཞན་གྱིས་བྱས་པར་ག་ལའགྱུར།",
    "གལ་ཏེ་གཞན་གྱིས་སྡུག་བསྔལ་གངབྱེད་པ་དེ་གཞན་དེའི་བདག་གིས་བྱས་པ་ཉིད་དུ་གྱུར་ན་གཞན་གྱིསབྱས་པ་མ་ཡིན་ནོ།",
    "ཅི་སྟེ་དེ་དེས་བདག་གིས་བྱས་པ་མ་ཡིན་ན་ཇི་ལྟར།",
    "དེའི་ཕྱིར་བདག་གིས་བྱས་པ་དེ་གཞནགྱི་ཐལ་བར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་སྡུག་བསྔལ་བདག་གིས་བྱས་པརརབ་ཏུ་མ་གྲུབཔས་སྡུག་བསྔལ་བདག་གིས་བྱས་པ་མེད་ན་སྡུག་བསྔལ་གཞན་གྱིསབྱས་པར་ག་ལ་འགྱུར་བས་སྡུག་བསྔལ་གང་གཞན་གྱིས་བྱས་པརའགྱུར་བ་གང་ཡིན།",
    "ཅི་ཁྱོད་སྨྲ་བཔོའི་བསམ་པ་མརྟོགས་པར་རང་གི་བློ་གྲོས་ཀྱི་རྟོགས་པས་སྦྱར་བའི་དོན་ལ་ཚིགགིས་སྐྱོན་འདོགས་པར་བྱེད་དམ།",
    "འདི་ལྟར་ཁོ་བོ་ནི་སྡུག་བསྔལ་བདགགིས་བྱས་སོ་ཞེ་འམ།",
    "འདི་ལྟརགང་གི་ཕྱིར་རེ་ཞིག་གང་ཟག་བདག་གིས་དེ་བྱས་པས་དེའི་ཕྱིརགང་ཟག་བདགགིས་བྱས་སོ་ཞེས་སྨྲ་སྟེ།",
    "སྡུག་བསྔལ་དེ་ལས་གང་ཟག་དང་གཞནམ་ཡིན་པས་སྡུག་བསྔལ་གྱིས་སྡུག་བསྔལ་དེ་བྱས་པའི་ཕྱིར་རྣམགྲངས་ལས་སྡུག་བསྔལ་བདག་གིས་བྱས་སོ་ཞེས་ཀྱང་སྨྲ་ཞིང་།",
    "ཅི་ཁྱོད་ཤིངལྗོན་པ་རྩ་བ་རུལ་པ་ལ་ཆུ་ལྡུགས་པར་བྱེད་དམ།",
    "ཁྱོད་གང་ཟགཉེ་བར་ལེན་པ་མེད་པ་འབའ་ཞིག་པ་རྣམ་པ་ཐམས་ཅད་དུ་མི་འཐདཔ་ལ་སྡུག་བསྔལ་གང་ཟག་བདག་གིས་བྱས་སོ་སྨྲའམ།",
    "དེས་ན་སྡུག་བསྔལ་གང་ཟག་བདག་གིས་བྱས་སོ་ཞེས་དེ་སྐད་སྨྲབར་ཡང་རིགས་པར་འགྱུར་བ་ཞིག་ན།",
    "རེ་ཞིགསྡུག་བསྔལབདག་བྱས་མིན།",
    "གང་ཟག་ཉེ་བར་ལེན་པ་མེད་པ་འབའ་ཞིག་པ་དེམེད་ན་སྡུག་བསྔལ་བདག་གིས་བྱས་པ་མ་ཡིན་པས་རེ་ཞིག་སྡུགབསྔལ་གང་ཟག་བདག་གིས་མ་བྱས་སོ།",
    "གང་གི་ཕྱིར་བྱས་པ་ལས་དེ་གཞན་མ་ཡིན་ནོ་ཞེས་བྱབ་དེའི་ཕྱིར་གང་ཟག་ཉེ་བར་ལེན་པ་མེད་པ་འབའ་ཞིག་པ་དེས་ནིམ་བྱས་པས་དེའི་ཕྱིར་སྡུག་བསྔལདེ་ཉིད་ཀྱིས་སྡུག་བསྔལ་དེ་བྱས་སོ་ཞེས་གང་སྨྲས་པ་དེ་རིགས་པམ་ཡིན་ནོ།",
    "སྡུག་བསྔལ་མེད་པ་འབའ་ཞིགཔ་ཡོད་པ་ཉིད་མ་ཡིན་ན་རང་གི་བདག་ཉིད་རབ་ཏུ་མ་གྲུབ་པགཞན་དུ་གྱུར་པ་དེ་མེད་པས་སྡུག་བསྔལ་དེ་གཞན་གྱིས་བྱས་པར་གལ་འགྱུར།",
    "དེ་ལྟ་བས་ན་དེ་དག་ཐམས་ཅད་སྔར་ལན་བཏབ་ཟིནཔ་ལ་ཁྱོད་ཚིག་གཞན་གྱིས་དོན་གཞན་དུ་བསམས་ཤིང་དེ་དག་ཉིདཡང་སྨྲས་པར་གྱུར་ཏོ།",
    "གལ་ཏེ་རེ་རེས་བྱས་གྱུར་ན།",
    "གལ་ཏེ་རེ་རེས་བྱས་པ་ཡོད་པར་གྱུར་ནནི་སྡུག་བསྔལ་གཉི་གས་བྱས་པ་དེ་ཉིད་ཀྱང་ཡོད་པར་འགྱུར་བཞིག་ན།",
    "སྡུགབསྔལ་རེ་རེས་བྱས་པར་མི་རིགས་པ་དེ་ནི་བསྟན་ཟིན་ཏེ།",
    "སྡུག་བསྔལརེ་རེས་བྱས་པ་མེད་ན་སྡུག་བསྔལ་གཉི་གས་བྱས་པས་འཐད་པར་ཇིལྟར་འགྱུར།",
    "གང་གི་ཚེ་བདག་དང་གཞན་གཉི་ག་སྡུག་བསྔལ་མེདཔ་འབའ་ཞིག་པར་མི་སྲིད་པ་དེའི་ཚེ་ཇི་ལྟར་དེ་ཉིད་ཀྱིས་སྡུགབསྔལ་བྱེད་པར་འགྱུར་ཏེ།",
    "གལ་ཏེ་སྡུག་བསྔལ་རེ་རེས་ཀྱངམ་བྱས་ལ་གཉི་གས་བྱས་པར་ཡང་མི་རིགས་ན།",
    "བདག་གིས་བྱས་པ་ནི་བདག་གིས་དེ་བྱས་པསྟེ་བདག་གིས་དེབྱེད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བདག་གིས་མ་བྱས་པ་ནི་བདག་གིསམི་བྱེད་པའོ།",
    "གཞན་གྱིས་མ་བྱས་པ་དང་བདག་གིས་མ་བྱས་པ་ནིགཞན་གྱིས་མི་བྱེད་པ་དང་བདག་གིས་མི་བྱེད་པའོ།",
    "ཕུང་པོ་སྡུག་བསྔལ་འབའཞིག་ལ་བདག་གིས་བྱས་པ་དང་།",
    "རེ་ཞིག་གཟུགས་ཉིད་ཀྱིས་གཟུགས་བདག་ཉིད་མ་བྱསསོ།",
    "གཟུགས་བདག་གིསབྱས་པ་ཡིན་ན།",
