    "དྲེའི་ཕྱིར་འདི་ཐམས་ཅད་ལ་སྐུར་བ་འདྲེབས་པར་བྱྲེད་པ་ནི།",
    "དྲེས་ན་ཇི་ལྟར་འཇིག་རྲེན་ཕ་རོལ་ཡང་དག་རོགས་པར་འགྱུར།",
    "འཇིག་རྲེན་ཕ་རོལ་འགོག་པར་བྱྲེད་པའི་དུས་སུ་བདག་཈ིད་ནི།",
    "རྲེན་དུ་མཚུངས་པ་཈ིད་ལུས་ཡིན་པས་ན་དྲེའི་ལྟ་བའི་རྣམ་པའི་རྲེན་དུ་མཚུངས་པའི་ལུས་ཞྲེས་ཚིག་རྣམ་པར་སྦྱར་རོ།",
    "དྲེ་ལ་གཅིག་ནི་ཕྱོགས་སུ་བྱས་པ་཈ིད་ཀྱིས་ན་གཞན་དཔྲེ་཈ིད་དུ་བསྟན་པའི་ཕྱིར།",
    "ཡོད་པ་དང་མྲེད་པ་཈ིད་དུ་ལྟ་བ་ཐམས་ཅད་དགག་པར་འདོད་པའི་ཕྱིར་རོ།",
    "ཁོ་བོ་ཅག་ཕྱིན་ཅི་ལོག་པར་སྒྲུབ་པ་ལ་དཔྲེ་མྲེད་པའི་ཕྱིར་རོ།",
    "ཞྲེས་བྱ་བར་བརོད་པར་ནུས་པ་ཡང་ཡིན་ནོ།",
    "ཅྲེས་གང་དམ་བཅས་པར་གྱུར་པ་དྲེ་རབ་ཏུ་བསྒྲུབས་པ་ཡིན་ནོ།",
    "དྲེའི་ཕྱིར་སྐྱྲེད་པར་བྱྲེད་པའི་རྒྱུའི་རྣམ་པར་རོག་པ་གཞན་ལྔ་པ་ཡོད་པ་མ་ཡིན་ནོ།",
    "དྲེའི་ཕྱིར་གཞན་མྲེད་པའི་ཕྱིར་ལ་རྣམ་པར་རོག་པ་བཞིས་སྐྱྲེ་བ་བཀག་པའི་ཕྱིར་དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་སྐྱྲེ་བ་མྲེད་དོ་ཞྲེས་བསྟན་པའི་ཕྱིར།",
    "འདུས་བྱས་ལྟ་ཞིག་སྣ་ཚོགས་བོ་གོས་ཀྱིས་ནི་རོགས་པར་འགྱུར།",
    "དྲེ་བཞིན་དུ་མ་རིག་པ་འགག་པས་འདུ་བྱྲེད་འགག་ཅྲེས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པ་ཡིན་ནོ།",
    "གལ་ཏྲེ་གཏི་མུག་བརྲེན་ནས་ལས་འབྱུང་གཏི་མུག་མྲེད་པར་དྲེ།",
    "མི་འབྱུང་ཞྲེས་བྱར་མི་མཁས་ཁོ་ནས་རོག་པར་གོར་མ་ཆག།",
    "བོ་བཟང་཈ི་མས་མུན་པ་སྟུག་པོ་རྣམ་པར་བསལ་བ་བཞིན།",
    "སོགས་པ་རྣམས་ལ་དོན་དམ་པར་རང་བཞིན་འགའ་ཡང་མྲེད་ན།",
    "འདི་ལ་བརོད་པར་བྱ་སྟྲེ།",
    "ཡྲེ་ཤྲེས་རང་བཞིན་སྟོང་པར་རིག་འགྱུར་ཏྲེ།",
    "ཤྲེས་བྱའི་རང་བཞིན་སྟོང་པར་རིག་གྱུར་ནས།",
    "ཞྲེས་གསུངས་པ་ལྟ་བུའོ།",
    "དོན་དམ་པར་ཡང་མ་ཡིན་ནོ།",
    "དྲེ་ནས་ཕྱིས་ང་ལ་བརྒལ་ཞིག་བརག་པར་འགྱུར་རོ།",
    "ཞྲེས་བརོད་པར་ནུས་པ་ཡང་ཡིན་ནོ།",
    "སྡུག་པ་མིན་པར་སྡུག་པར་རོག།",
    "ཡོངས་སུ་མྱ་ངན་འདས་པ་གསུངས་གྱུར་པ།",
    "འདིས་ནི་དུས་ཐམས་ཅད་དུ་མ་སྐྱྲེས་པར་སྟོན་པ་ཡིན་ཏྲེ།",
    "འཇིག་རྲེན་རབ་ཏུ་གགས་པར་ཡོད་ཇི་བཞིན།",
    "གཟུགས་དང་དྲི་དང་རོ་དང་རྲེག་བྱ་ལ་སོགས་པ་རྣམས་ཡོད་པ་དྲེའི་ཕྱིར་བུམ་པར་བཏགས་པ་ནི་རྒྱུ་དང་བཅས་པ་ཞྲེས་བྱ་བར་རིགས་ན།",
    "བཏགས་པའི་རྲེན་རས་སྒྲུབ་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "གཟུགས་ལ་སོགས་པ་མ་གཏོགས་པར།",
    "གང་གསུམ་མྲེད་པར་རྲེ་རྲེ་མྲེད།",
    "གཅིག་མྲེད་པར་ཡང་གསུམ་མྲེད་དོ།",
    "གཅིག་མྲེད་པར་ཡང་གསུམ་མྲེད་ན།",
    "ཞྲེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "མི་རག་པར་ནི་ཇི་ལྟར་འགྱུར།",
    "ཞྲེས་གསུངས་སོ།",
    "དྲེའི་ཕྱིར་དྲེ་ལྟར་དཔྲེར་ན་བརགས་པར་ཡོད་པ་བཞིན་ལ་སོགས་པའི་ཚོགས་པ་ལ་བརྲེན་ནས་མྲེ་ལོང་ལ་གཟུགས་བརན་བརགས་པ་ཙམ་དམིགས་པ་དང་།",
    "བརགས་པར་ཡོད་པ་ཀ་བ་ལ་སོགས་པ་ལ་བརྲེན་ནས་ཁྱིམ་དུ་བཏགས་པ་དང་།",
    "དངོས་པོ་བརགས་པར་ཡོད་པ་ཐམས་ཅད་ཀྱི་བརགས་པ་ཡང་དངོས་པོ་བརགས་པར་ཡོད་པའི་རྲེན་ཅན་དུ་རིགས་ཏྲེ།",
    "ཞྲེས་བྱ་བའི་བར་དུ་གསུངས་སོ།",
    "མ་རིག་པ་དང་འདུ་བྱྲེད་དང་ས་བོན་ལ་སོགས་པ་དག་ལས་རྣམ་པར་ཤྲེས་པ་དང་མྱུ་གུ་ལ་སོགས་པ་ཀུན་རོབ་ཏུ་སྐྱྲེ་བ་ཅི་ལྟར་ངྲེས་པར་བྱ།"
  ]
}