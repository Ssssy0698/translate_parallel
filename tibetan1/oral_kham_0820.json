    "ཤ་ནའི་གོས་རྗེ་ཙོང་ཁ་པའི་གསན་ཡིག་ཏུ་མི་འདུག་ཀྱང་།",
    "ཁ་ཆེ་འདུས་འདི་གཉིས་གངྒཱའི་ཆུ་རྒྱུན་སོགས་གཞན་དུ་མི་འདུག་ཀྱང་།",
    "ཛི་ན་མི་ཏྲ་གསན་ཡིག་ལ་ལར་འདི་གཉིས་གོ་ལྡོག་ཏུ་འདུག་པ་རྗེ་བཙུན་ཙོང་ཁ་པའི་གསན་ཡིག་ན་དཱ་ན་ཤཱི་ལ་དང་ཛི་ན་མི་ཏྲ་གཉིས་ལ་ཞེས་དང་།",
    "འཇམ་དབྱངས་བདེ་བའི་རྡོ་རྗེའི་གསན་ཡིག་ཏུ་འདུག།",
    "འཇམ་དབྱངས་བདེ་བའི་རྡོ་རྗེའི་གསན་ཡིག་ཏུ་འདུག།",
    "འཇམ་དབྱངས་བདེ་བའི་རྡོ་རྗེའི་གསན་ཡིག་ཏུ་འདུག།",
    "འཇམ་དབྱངས་བདེ་བའི་རྡོ་རྗེའི་གསན་ཡིག་ཏུ་འདུག།",
    "ངོར་ཆེན་གྱི་གསན་ཡིག་ན་འདི་གཉིས་ཀ་མི་འདུག་པ་དཔྱད་ཅེས་གསན་ཡིག་གངྒཱའི་ཆུ་རྒྱུན་དུ་གསུང་།",
    "རིགས་ཚོགས་ལ་འདིའི་བར་གྱི་བརྒྱུད་པ་རྣམས་གསལ་བ་མི་འདུག་གཤིས།",
    "ཛ་ཡ་པཎྜི་ཏའི་གསན་ཡིག་ཏུ་གོ་ལྡོག་ཏུ་འདུག་ཀྱང་།",
    "གངྒཱའི་ཆུ་རྒྱུན་ལས་ཐར་རྩེ་བའི་གསན་ཐོར་འདི་གཉིས་གོ་ལྡོག་ཏུ་འདུག་པ་བརྟག་ཅེས་ཕེབས།",
    "ཡང་ལོ་ཙཱ་བའི་འགྱུར་ལུང་ཙམ་ལ་ངོས་བཟུང་བ་ཡིན་ན་ནི་བརྒྱུད་པ་གོང་མ་རྣམས་འདྲེན་དོན་མི་འདུག་པས་རྣམ་དཔྱོད་ཀྱི་ཁུར་དང་ལྡན་པ་རྣམས་ཀྱིས་ལྗགས་རིང་དུ་རྐྱོང་བར་རིགས་སོ་ཞེས་གསན་ཡིག་གངྒཱའི་ཆུ་རྒྱུན་ལས་གསུངས་པ་ལྟར་བཀོད།",
    "༧༧ སློབ་དཔོན་ནག་པོའི་ཞབས་ཀྱིས་མཛད་པའི་ལུས་ཡོངས་སུ་སྤྱད་གསན་ཡིག་རྣམས་སུ་ས་མགོ་ཅན་བྲིས་འདུག་ཀྱང་བརྗོད་དོན་ལུས་ཀྱི་ཕྱི་ནང་རྣམས་ལ་དཔྱད་བྱེད་པ་སྣང་ཞེས་གངྒཱར་གསུངས།",
    "ཐར་རྩེ་སྒྲུབ་ཁང་ཤར་པ་གསུམ་གྱི་གསན་ཡིག་ན་འདི་མི་འདུག་ཀྱང་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་བརྒྱུད་ལུགས་གཉིས་ཀར་འདུག་པས་ཆད་པ་འདྲ་གསུངས།",
    "ཆོག་སྒྲིགས་གཉིས་ཀ་ན་འདུག་ཅིང་ཕྱག་ལེན་ལའང་མཛད་ཅེས་གངྒཱར་གསུངས།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་གཉིས་ཀྱི་བར་དུ་བདེ་བྱེད་ཀྱི་ཆོ་ག་སྣ་ཚོགས་པའི་མཛོད་དང་དཔའ་བོ་རྡོ་རྗེས་མཛད་པའི་ལུས་ངན་པོའི་སྒྲུབ་ཐབས་ཐར་ལོའི་འགྱུར་གཉིས་འདུག་པ་དཔེ་མ་འབྱོར་བས་མ་ཐོབ་ཅེས་གངྒཱར་གསུངས།",
    "འདི་གཉིས་ཀྱི་བར་ན་རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་གནོད་སྦྱིན་བྲེལ་ཕོངས་ཀྱི་མནན་ཐབས་བུར་ག་དེ་ཝས་མཛད་པ་འདུག་ཀྱང་དཔེ་མ་འབྱོར་བས་མ་ཐོབ་ཅེས་གངྒཱར་གསུངས།",
    "མཁྱེན་བརྩེའི་གསན་ཡིག་ན་ཚར་གཉིས་མ་བྱུང་ཡང་ཕྱི་མ་འདི་གསལ་བྱེད་དུ་འདུག་པས་ཁ་ཕྲལ་ནས་བྲིས་པ་ཡིན་ཞེས་གངྒཱར་གསུངས།",
    "ཅེས་ཡོད་པ་མཁྱེན་བརྩེའི་གསན་ཡིག་ཏུ་འདི་གཉིས་ཀྱི་བར་ན་ཕྱག་རྡོར་གསང་བའི་མཚན་བརྒྱད་ཀྱི་བསྟོད་པ་ཞེས་པ་འདུག་པ་དཔེ་མ་འབྱོར་བས་མ་ཐོབ་ཅེས་གངྒཱར་གསུངས།",
    "རྫའི་གའུ་ལ་བརྟེན་ནས་རྒྱལ་པོ་ཆེན་འབྲོམ་པོ་རྣམ་སྲས་གསེར་ཆེན་གནོད་སྦྱིན་བརྒྱད་ཀྱིས་བསྐོར་བའི་སྒྲུབ་ཐབས་གཡོན་ནེའུ་ལེའི་རྐྱལ་པ་དང་མཆན་ཁུང་ན་བེ་ཅོན་བསྣམས་པ་ཞིག་འདུག།",
    "མགོན་པོ་གར་མཁན་མཆོག་དམར་སྨུག་ཞལ་གསུམ་ཕྱག་བཅོ་བརྒྱད་པའི་སྒྲུབ་ཁ་ཐབས་སློབ་དཔོན་ཆེན་པོ་ཁ་ཆེ་རིན་ཆེན་རྡོ་རྗེས་མཛད་པ་ཟངས་དཀར་གྱི་འགྱུར་རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་བར་འདིར་འགྲེལ་པ་འདུག་པ་དཔེ་མ་བྱུང་བས་ལུང་མ་ཐོབ་ཅེས་གངྒཱར་གསུངས།",
    "འདིའི་མཇུག་ན་རྣམ་སྲས་སྤྲིན་གསེབ་མ་གཏེར་མ་རྫོགས་སོ་ཟེར་བ་འདུག་ཀྱང་དེང་སང་འདི་རྙིང་མ་བཀའ་མར་ངོས་འཛིན་མཛད་པ་ཡིན།",
    "ལི་ཡུལ་དུ་སློབ་དཔོན་བི་མཱ་ལ་མི་ཏྲ་དང་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནས་བསྒྱུར་བ་དང་།",
    "འགོར་རྣམ་ཐོས་སྲས་དམར་པོའི་སྲོག་སྒྲུབ་ཅེས་ཡོད་པའི་རྟེན་བཞི་གཏོར་རི་རབ་མ་བཅའ་བའི་ཞལ་གདམས་དངོས་གྲུབ་བླང་བ་དང་བཅས་པ་བར་འདིར་གསན་ཡིག་ན་ཟས་ནོར་སྒྲུབ་པ་ཞིག་འདུག་པ་དཔེ་མ་རྙེད་པས་ལུང་མ་བྱུང་ཞེས་གངྒཱར་གསུངས།",
    "སྒབ་འདྲེ་ཤེས་པ་དཀར་པོ་བསེ་བྱང་བཞི་ལ་བརྟེན་ནས་གནོན་ཐབས་གསན་ཡིག་ན་སྟག་མདའི་སྒྲུབ་ཐབས་དང་ནོར་རྟེན་འཛུགས་པ་འདུག་པ་དཔེ་མ་འབྱོར་བས་མ་ཐོབ་ཅེས་གངྒཱར་གསུངས།",
    "མཁས་པ་བེ་རོ་ཙ་ན།",
    "རྡོ་རྗེ་འཆང་ཆེན་རྗེ་བཙུན་ཙོང་ཁ་པ་ཆེན་པོའི་གསན་ཡིག་ན་གྲུབ་ཐོབ་དང་པཎྜི་ཏ་གཉིས་ཀའི་བརྒྱུད་པ་མ་ཕྱེ་བའི་མར་ལུགས་སྤྱི་ཙམ་པ་ཞིག་ཏུ་མཛད་འདུག་པ་དཔྱད་ཅེས་གངྒཱའི་ཆུ་རྒྱུན་ལས་གསུངས།",
    "མགོན་པོ་ཀླུ་སྒྲུབ་ཡན་འགོས་ལུགས་ལྟར་རྗེ་བཙུན་ཙོང་ཁ་པ་ཆེན་པོའི་གསན་ཡིག་ན་མི་འདྲེན་པ་འདྲ་ཞིག་འདུག་ཀྱང་ཆུ་བོ་གཉིས་འདྲེས་ཡིན་པ་བསྐྱོན་དུ་མི་འབྱུང་ཞེས་གངྒཱའི་ཆུ་རྒྱུན་ལས་གསུངས།",
    "ཟླ་བ་གྲགས་པ་རྡོ་རྗེ་འཆང་སྔགས་རམ་པའི་གནས་ཡིག་ན་བར་འདིར་རིག་པའི་ཁུ་བྱུག་འདུག་པ་ཆད་དམ་དཔྱད་ཅེས་གངྒཱར་གསུངས།",
    "སྔགས་རམས་པའི་གསན་ཡིག་ན་ངའི་གཉིས་པ་ཟེར་བ་འདུག།",
    "ཆེར་གསུངས་འདུག།",
    "གཞོན་བློའི་གསལ་ཁ་མི་འདུག་པས།",
    "ཁོང་ལ་མངའ་བའི་བཀའ་ལུང་བུམ་པ་གང་བྱོའི་ཚུལ་དུ་གསན་ཞེས་པའང་འདུག།",
    "བརྒྱུད་ཚུལ་མང་པོ་ཞིག་བཞུགས་འདུག།",
    "འདུས་ཀྱི་རྫོགས་རིམ་གྱི་དམིགས་རིམ་དང་དཔལ་ལྡན་སྨད་རྒྱུད་པའི་རྡོ་ལག་བརྒྱུད་ཀྱི་དམིགས་རིམ་གཉིས་ཞུས་དག་འཕེར་བ་འདུག་པས་ཤེས།",
    "གྲུབ་ཆེན་ན་ཁ་པ་སོགས་མང་དུ་བྱུང་འདུག།",
    "རྡོ་རྗེ་འཆང་སྔགས་རམས་པའི་གསན་ཡིག་ཏུ་ཤ་བ་རི་པ་ཞེས་འདུག།",
    "གཤེན་ཟེར་བ་འདུག།",
    "སྒང་སྟོན་ཤེས་རབ་ཀུན་མཁྱེན་ལྔ་པའི་གསན་ཡིག་ཏུ་འདིའི་བར་བུ་སྟོན་ཤེས་རབ་འབུམ་ཞེས་པ་འདུག།",
    "གཉིས་ཀས་གསན་འདུག་ཅིང་།",
    "ཕ་བོང་ཁ་པ་འཇམ་དབྱངས་གྲགས་པ་ལ་གནང་འདུག་ཅིང་།",
    "རྗེ་ཤེས་རབ་སེང་གེ་ཞེས་པ་འདུག་པས།",
    "ཌྷེཾ་ཀི་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ཏུ་ལཱུ་ཧི་པ་དང་འདི་གཉིས་གཅིག་པར་མཛད་འདུག་ཅེས་གངྒཱར་གསུངས།",
    "མ་ན་ཀ་ཤ་ཱི་ཛྙཱ་བུའི་གསན་ཡིག་ན་མ་ན་ཀ་དང་ཤ་ཱི་ཛྙཱ་ན་ཞེས་འདུག་པ་ཡིག་སྐྱོན་བྱུང་ངམ་སྙམ་ཞེས་གངྒཱར་གསུངས།",
    "རཏྣ་ཨཱ་ཀ་ར་ཐར་རྩེ་བའི་གསན་ཡིག་ན་འདི་ཇོ་བོའི་རྗེས་སུ་འདུག་པ་ཡིག་ནོར་བྱུང་འདྲ་ཞེས་གངྒཱར་གསུངས།",
    "རི་ཁྲོད་འདི་གོང་དཀར་བའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་དཔྱད་ཅེས་གངྒཱར་གསུངས།",
    "བཀའ་བབས་དྲུག་པ་མར་ལུགས་ཀྱི་བརྒྱུད་པ་གསན་ཡིག་ཚོར་འདི་བཞིན་འདུག་ཀྱང་མར་ལོ་སོགས་མ་བྱུང་བས་དམར་ལུགས་ཟེར་རྒྱུ་ཡིན་ནམ་དཔྱད་ཅེས་གངྒཱར་གསུངས།",
    "བཀའ་བབས་བརྒྱད་པ་སྦལ་སྤང་སྣ་ལུགས་ཀྱི་བརྒྱུད་པ་གོང་དཀར་བའི་གསན་ཡིག་ན་འདི་ཇོ་ལུགས་བརྒྱུད་པའི་རྣམ་གྲངས་སུ་མཛད་འདུག་ཅིང་ཐར་རྩེ་ཤར་པའི་གསན་ཡིག་ན་དཀྱུས་བཞིན་དུ་སོ་སོར་སྣང་ཞེས་གངྒཱར་གསུངས།",
    "ཡེ་ཤེས་ཀྱི་མཁའ་༩༩བ་འགྲོ་རྗེ་བཙུན་ཙོང་ཁ་པ་ཆེན་པོའི་གསན་ཡིག་ཏུ་འདིའི་རྗེས་སུ་ནག་པོ་པ་འདུག།",
    "བལ་པོ་བྷ་གོང་དཀར་བའི་གསན་ཡིག་ནའང་མཚན་གསལ་མི་འདུག།",
    "པི་ཏོ་གོང་དཀར་བ་དང་ཐར་རྩེའི་གསན་ཡིག་ན་པཎྜི་ཏ་ཨཱ་ཙརྱ་ཟེར་བ་འདུག་ཅེས་གངྒཱར་གསུངས།",
    "འབྲོ་ལོ་ཙཱ་བ་ཤེས་རབ་རྗེ་བཙུན་ཙོང་ཁ་པ་ཆེན་པོའི་གསན་ཡིག་ན་མི་འདུག་པ་ཡིག་སྐྱོན་བྱུང་བ་འདྲ་ཞེས་གངྒཱའི་ཆུ་རྒྱུན་དུ་གསུངས།",
    "ཕམ་ཐིང་པ་སྐུ་མཁྱེན་བརྩེ་ཐར་རྩེ་སྒྲུབ་ཁང་གསུམ་གྱི་གསན་ཡིག་ན་མི་གསལ་ཡང་རྫོགས་ལུགས་ཀྱི་གསན་ཡིག་ན་འདིའི་རྗེས་སུ་ཀློག་སྐྱ་ཤེས་རབ་བརྩེགས་འདུག་པ་ཆད་དམ་སྙམ་ཞེས་གངྒཱར་གསུངས།",
    "ཡོ་ག་གསུམ་ཞེས་འདུག་པས་བྱ་རྒྱུད་དུ་བཞེད་པ་འདྲའོ་ཞེས་གངྒཱའི་ཆུ་རྒྱུན་ལས་གསུངས།",
    "འཇིགས་མེད་འབྱུང་གནས་ནས་ཐར་རྩེ་པའི་གསན་ཡིག་ན་དཀྱིལ་འཁོར་ང་ལྔར་ཕྱེ་བའི་བརྒྱུད་པར་མཛད་འདུག་ཀྱང་མཁྱེན་བརྩེ་དང་སྔགས་རམ་པའི་༡༡༩བ་གསན་ཡིག་སོར་བཞག་བྲིས་པ་ཡིན་ཞེས་གངྒཱར་གསུངས།",
    "ཏི་ཤ་ཱི་ཧཱ་ཐར་རྩེ་པའི་གསན་ཡིག་ན་དཔལ་ཡིད་ཀྱི་འགྲམ་པ་དང་སྔགས་རམ་པའི་ངོར་དཔལ་གཞན་ལ་ཕན་ཞེས་པར་བསྒྱུར་འདུག་པ་དཔྱད།",
    "པཎྜི་ཏ་ཨ་ཝ་དྷཱུ་ཏི་དཔལ་ལྡན་གཉིས་མེད་རྡོ་རྗེའི་ཞབས་ཀྱིས་མཛད་གསན་ཡིག་ཕལ་ཆེར་ན་འཇིགས་མེད་རྡོ་རྗེ་ཞེས་འདུག་ཀྱང་རྒྱ་གཞུང་བཀླགས་པས་དོན་གྲུབ།",
    "ཏེ་ཁ་ཕྲལ་ནས་སོ་སོར་རྗེས་གནང་འདུག།",
    "ཨ་ར་པ་ཙ་ན་དཀར་པོ་ཕྱག་གཉིས་པ་ལྷ་ལྔའི་སྒྲུབ་ཐབས་སློབ་དཔོན་མི་ཕམ་བཤེས་གཉེན་གྱིས་མཛད་པ།",
    "འཕྲལ་དུ་ཉམས་སུ་མྱོང་བའི་ཨ་ར་པ་ཙ་ན་དཀར་པོ་ཕྱག་གཉིས་པ་གཙོ་འཁོར་ལྔའི་སྒྲུབ་རྗེས་གནང་ཡོད།",
    "ཨ་ར་པ་ཙ་ན་དཀར་པོ་ཕྱག་གཉིས་པའི་སྒྲུབ་རིན་ཆེན་སྒྲོན་མེར་འདི་གཉིས་ལ་རྗེས་གནང་གཅིག་མཛད་འདུག་པ་མངོན་རྟོགས་མི་འདྲ་ཞིང་།",
    "འདི་གཉིས་ལ་རྗེས་གནང་གཅིག་མཛད་ཅིང་སྒྲུབ་ཐབས་གསུམ་ཞེས་པ་སྣང་ཡང་རྒྱ་གཞུང་དང་གསན་ཡིག་ཚོར་གཉིས་ལས་མི་འདུག་པས་ཡིག་སྐྱོན་བྱུང་འདྲ་ཞེས་གངྒཱར་གསུངས།",
    "མཚན་ཡང་དག་པར་བརྗོད་པའི་མན་ངག་ཤེས་རབ་འཁོར་ལོའི་དངོས་གྲུབ་མཆོག་ཐོབ་པ་དཀར་པོ་ཕྱག་གཉིས་པའི་སྒྲུབ་ཐབས་རིན་ཆེན་སྒྲོན་མེར་མཚན་བསྟོད་ཅེས་པའི་མིང་འདོགས་མཛད་འདུག་རྗེས་གནང་ཡོད།",
    "ཐར་རྩེ་དང་ཤར་པའི་གསན་ཡིག་ན་གསུམ་ལས་མི་འདུག་པ་ཆད་འདྲ་ཅེས་གངྒཱར་གསུངས།",
    "རིན་ཆེན་སྒྲོན་མེར་ནི་རྗེས་གནང་ཟུར་དུ་མཛད་འདུག་གོ།",
    "རིན་ཆེན་སྒྲོན་མེར་གསུམ་པོ་དྲིལ་བར་རྗེས་གནང་གཅིག་འདུག།",
    "འདི་གཉིས་དང་རང་བྱིན་གྱིས་བརླབ་པའི་འོད་ཟེར་ཅན་ཐེ་བའི་གསུམ་ལ་རྗེས་གནང་གཅིག་མཛད།",
    "མཁྱེན་བརྩེ་ཐར་རྩེ་ཤར་པ་རྣམས་ཀྱི་གསན་ཡིག་ན་འདི་གཉིས་མི་འདུག་པ་ཆད་འདྲ།",
    "དེ་མན་སྒྲུབ་ཐབས་སུ་དབྱེ་བ་ཡིན་འདུག།",
    "གོང་དཀར་བ་སོགས་གསན་ཡིག་ཕལ་ཆེར་སོ་སོར་མ་དབྱེ་བར་གཅིག་ཏུ་བྲིས་འདུག་གོ་ཞེས་གངྒཱར་གསུངས།",
    "གཙུག་ཏོར་རྣམ་རྒྱལ་གྲ་ལྔའི་ཁྲོད་དུ་བསྲེས་པ་མི་འོས་ཀྱང་རྒྱ་གཞུང་ན་འདི་བཞིན་འདུག།",
    "ཡང་གོང་གསལ་འགའ་ཞིག་ལ་སྒོས་བརྒྱུད་འདུག་པ།",
    "མཁན་ཆེན་དེ་ཉིད་ཀྱིས་རྡོ་རྗེ་འཆང་དངོས་དཔལ་ལྡན་གྲགས་པ་ལ་གསན་འདུག་ཀྱང་།",
    "འདི་ཡན་སླར་ཚོལ་ཞེས་འདུག་ཅིང་།",
