    "འདི་ལྟརཁྱོད་ཀྱིས་གཟུགས་ལ་ལྟ་བར་བྱེད་པས་ལྟ་བའོ་ཞེས་སྨྲས་པ་ནིབྱེད་པ་པོ་ལ་བྱ་བའི་རྐྱེན་བྲྗོད་ནས་ལྟ་བར་བྱེད་པས་ལྟ་བཡིན་ནོ།",
    "དེའི་ཕྱིར་གང་གི་ཆེན་ལྟ་བ་ཉིད་ན་ལྟ་བ་ཡིན་གྱི་མི་ལྟ་བ་ན་མ་ཡིན་པ་དེའི་ཚེལྟ་བར་བྱེད་པས་ལྟ་བའོ་ཞེས་བྱ་བ་དེ་སྨྲ་བ་ཇི་ལྟར་རིགས་པརའགྱུར་ཏེ།",
    "འདི་ལ་གང་གིས་ལྟ་བར་བྱེད་དོ།",
    "དེ་ལྟ་བས་ན་ཡང་ལྟ་བ་གཉིས་སུ་ཐལབ་དང་།",
    "ལྟ་བ་པོ་ཡང་གཉིས་སུ་ཐལ་བར་འགྱུར་བས་དེ་ནི་མི་འདོདདོ།",
    "ཅི་སྟེ་ཐལ་བའི་བྱ་བ་གཉིས་སུ་ཐལ་བརའགྱུར་བའིསྐྱོན་དེར་གྱུར་ན་མི་རུང་ངོ།",
    "ཅི་སྟེ་ལྟ་ན་ནིསོར་མོའི་རྩེ་མོ་ཡང་ལྟ་བར་འགྱུར་བ་ཞིག་ན་མི་ལྟ་སྟེ།",
    "ལྟ་བ་རང་གི་བདག་ཉིད་ནི།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་དག་གིས་ལྟ་བས་ལྟ་བར་བྱེདདོ་ཞེས་བྱ་བ་དེ་བསལ་ཟིན་ཏེ།",
    "ལྟ་བ་པོས་ལྟ་བས་ལྟ་བར་བྱེད་ན་ལྟ་བགསུམ་དུ་ཐལ་བར་འགྱུར་རོ།",
    "ཡོང་ནི་བལྟ་བར་བྱ་བ་བུམ་པ་དང་སྣམ་བུ་ལ་སོགས་པ་དག་ཡོད་པལ་གང་གིས་ལྟ་བརབྱེད་པའི་ལྟ་བ་དེ་ནི་ཡོད་དོ།",
    "ཁྱོད་ལྟ་བ་པོ་མེད་པར་བལྟ་བརབྱ་བ་དང་ལྟ་བ་ཡོད་པར་འདོད་ཀོ།",
    "དེ་ལྟར་རེ་ཞིག་ལྟ་བ་མསྤངས་ན་ལྟ་བ་པོ་མ་ཡིན་པས་ལྟ་བ་པོ་མེད་དོ།",
    "དེ་ལ་ལྟ་བ་སྤངས་ཀྱང་རུང་མསྤངས་ཀྱང་རུང་སྟེ་ལྟ་བ་པོ་མེད་ན་ཁྱོད་ཀྱི་བལྟབར་བྱ་བ་དང་ལྟ་བ་ཡོད་པར་ག་ལ་འགྱུར།",
    "འདི་ལྟར་གང་གིས་ལྟབར་བྱེད་པས་བལྟ་བར་བྱ་བ་ཡིན་ན་གང་གིས་ལྟ་བར་བྱེད་པས་དེནི་མེད་དོ།",
    "དེ་མེད་ན་གང་གིས་ལྟ་བར་འགྱུར།",
    "འགའ་ཞིག་གིས་གང་གིས་ལྟ་བར་བྱེད་པ་དེནི་དེའི་ལྟ་བ་ཡིནན་གང་གིས་ལྟ་བར་བྱེད་པ་དེ་ནི་མེད་དོ།",
    "དེ་མེད་ན་གང་གིས་ལྟབར་འགྱུར་ཏེ།",
    "གང་གི་ཚེ་ལྟ་བ་པོ་མེད་ན་བལྟབར་བྱ་བ་དང་ལྟ་བ་མི་འཐད་དོ།",
    "རྣམ་པར་ཤེས་པ་མེད་ན་རེག་པ་ག་ལ་ཡོད།",
    "རེགཔ་མེད་ན་ཚོར་བ་ག་ལ་ཡོད།",
    "དེ་ལའཕགས་པཉན་ཐོས་ནི་མིག་གི་རྣམ་པར་ཤེས་པར་བྱ་བའི་གཟུགས་གང་དགའདས་པ་དང་།",
    "ཁྱོད་ཀྱིས་རེ་ཞིག་ལྟ་བ་ནི་བཀག་ནཉན་པ་ལ་སོགས་པ་ནི་མ་བཀག་པས་དེས་ན་ཉན་པ་ལ་སོགས་པ་ཡོདཔའི་ཕྱིརདངོས་པོ་རྣམས་ཡོད་དོ།",
    "མྱོང་བར་བྱེད་དང་རེག་བྱེད་ཡིད།",
    "གཟུགས་ནི་དེ་དག་གི་འབྲས་བུར་བསྟན་ན།",
    "འདིལ་ཁྱོད་རྒྱུ་ལ་བརྟེན་ནས་འབྲས་བུ་སེལ་བར་བྱེད་ཅིང་།",
    "འབྲས་བུལབརྟེན་ནས་རྒྱུ་སེལ་བར་བྱེད་པས་དེ་ལ་གང་ལ་བརྟེན་ནས་གཞནཞིག་སེལ་བར་བྱེད་པ་དེ་ནི་རེ་ཞིག་ཡོད་དོ།",
    "ཐལ་བར་འགྱུརཏེ་དོན་གང་ཡང་།",
    "གལ་ཏེ་འབྲས་བུ་བསལ་ཀྱང་རྒྱུ་ཡོད་ན་ནི་རྒྱུདེ་འབྲས་བུ་མེད་པ་ཅན་དུ་ཐལ་བར་འགྱུར་རོ།",
    "ཐམས་ཅད་ཀྱི་རྒྱུ་ཐམས་ཅད་ཡིན་པརཐལ་བར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "དེ་ལ་རེ་ཞིག་ཡོད་པ་ནི་མིའཐད་དེ།",
    "འདིལྟར་གཟུགས་མེད་ན་དེ་གང་གི་རྒྱུར་འགྱུར།",
    "ཞེས་རབ་ཏུ་བསྟནཟིན་མོད་ཀྱི།",
    "བདེ་བམྱོང་བར་འགྱུར་བའི་རེག་པ་ལ་བརྟེན་ནས་བདེ་བའི་ཚོར་བ་སྐྱེའོཞེས་གསུངས་སོ།",
    "ཞེས་དམ་བཅས་ན་དཔེ་བསྟནཔའི་ཕྱིར་སྣམ་བུ་ངོ་བོ་ཉིད་སྟོང་པར་སྒྲུབ་པར་བྱེད་པའི་ཚེགང་ཞིག་རེ་ཞིག་རེ་ཞིག་རྒྱུ་སྤུན་དག་ནི་ཡོད་དོ་ཞེས་ཟེར་བའིདེ་ནི་བསྒྲུབ་པར་བྱ་བ་དང་མཚུངས་པ་ཡིནཏེ།",
    "དེ་ནི་དོན་གཅིག་པ་ཁོ་ན་ཡིན་མོད་ཀྱི།",
    "གནསསྐབས་གཞནགྱི་བྱེ་བྲག་གིས་ཡང་བསྟན་ཏོ།",
    "དེ་དག་གི་སོ་སོའི་མཚནཉིད་ཀྱང་བསྟན་ཏོ།",
    "ཇི་ལྟར་ནམ་མཁའ་ཡོད་པ་དེ་བཞིན་དུ་ཁམས་ལྷག་མརྣམས་ཀྱང་རང་གི་མཚན་ཉིད་ཡོད་པའི་ཕྱིར་ཡོད་དོ།",
    "མཚན་ཉིད་མེད་པར་ཐལ་བར་འགྱུར།",
    "མི་འཇུག་དེ་ལྟར་གང་གི་ཕྱིརམཚན་ཉིད་མེད་པའི་དངོས་པོ་འགའ་ཡང་ཡོད་པ་མཡིན་པ་དེའི་ཕྱིར་མཚན་ཉིད་མེད་པའི་དངོས་པོ་མེད་ན་དེ་གཞི་མེདཔ་ལ་མཚན་ཉིད་འཇུག་པར་མི་འཐད་དོ།",
    "དངོས་པོ་རང་གི་མཚན་ཉིད་དང་བཅས་པར་རབ་ཏུ་གྲུབཔ་ལ་ཡང་མཚན་ཉིད་ཀྱིས་ཅི་ཞིག་བྱ།",
    "དེ་ལྟ་ན་ཐུག་པ་མེད་པརཐལ་བར་འགྱུར་ཏེ།",
    "རྟག་ཏུ་མཚན་ཉིད་འཇུག་པར་ཐལ་བར་འགྱུརརོ།",
    "འདི་ལྟར་ཁྱོད་ཀྱིསམཚན་ཉིད་དང་ལྡན་པ་ལས་ཁམས་རབ་ཏུ་འགྲུབཔར་བསྟན་ན་མཚན་ཉིད་དང་ལྡན་པ་དེ་ཡང་མཚན་ཉིད་མི་འཇུགཔའི་ཕྱིར་མི་འཐད་དོ།",
    "དེ་མེད་ན་ཁྱོད་ཀྱི་མཚན་ཉིད་ཀྱི་གཞིགང་གིས་འགྲུབ་པར་འཐད།",
    "དེ་རེ་ཞིག་མཚན་ཉིད་ནི་ཡོདདེ།",
    "དེ་ལྟར་གང་གི་ཕྱིར་རྣམ་པ་ཐམས་ཅད་དུ་བརྟགས་ན་མཚན་ཉིདའཇུག་པར་མི་འཐད་པ་དེའི་ཕྱིར་མཚན་ཉིད་ཀྱི་གཞི་ཡོད་པ་མ་ཡིནནོ།",
    "གང་གི་ཕྱིར་མཚན་ཉིད་ཀྱི་གཞི་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིརགང་ཞིག་མེད་པའི་མཚན་ཉིད་ཀྱང་ཡོད་པ་ཉིད་མ་ཡིན་ནོ།",
    "ཞེསབྱ་བ་དེ་བྲྗོད་པར་མི་ནུས་མོད་ཀྱི།",
    "འོན་ཀྱང་རེ་ཞིག་དངོས་པོ་ནིཡོད་དོ།",
    "འདི་ལ་ཁྱོད་ན་རེ་མཚན་ཉིད་ཀྱིགཞི་དང་མཚན་ཉིད་དག་མེད་དོ་ཞེས་ཟེར་བ་དེ་ནི་དངོས་པོ་ལལྟོས་པ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་གང་གི་དངོས་པོ་མེད་དོ་ཞེས་བྲྗོདཔའི་དངོས་པོ་དེ་ནི་འགའ་ཞིག་ཡོད་པས་དེ་ལྟ་བས་ན་དངོས་པོ་མེདཔ་ཡོད་པའི་ཕྱིར་དངོས་པོ་ཡོད་པ་ཉིད་དོ།",
    "དངོས་མེད་གང་གི་ཡིནཔར་འགྱུར།",
    "ཞེས་བསྟན་པས་དངོསཔོ་དེ་ཡོད་པ་མ་ཡིན་ན་ཁྱོད་ཀྱི་དངོས་པོ་མེད་པ་དེ་གང་གི་ཡིནཔར་བརྟག།",
    "དངོས་པོ་དེ་ཡང་ཡོད་པ་མ་ཡིན་ན་དངོས་པོ་མེད་པ་དེ་གང་གི་ཡིནཔར་འགྱུར།",
    "གང་གི་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དེདག་ཤེས་པར་བྱེད་ཅིང་དངོས་པོ་དང་དངོས་པོ་མེད་པ་དག་རྟོག་པརབྱེད་པ་དེ་ནི་རེ་ཞིག་ཡོད་དོ།",
    "གང་གིས་དངོས་དང་དངོས་མེད་ཤེས།",
    "དེ་ལྟར་གང་གི་ཕྱིར་བརྟགས་ནམཚན་ཉིད་ཀྱི་གཞི་དང་མཚན་ཉིད་དག་མེད་ཅིང་།",
    "མེད་པ་ཉིད་དུ་རྗེས་སུ་ལྟ་བཆད་པ་དང་རྟག་པར་ལྟ་བས་བློ་གྲོས་ཀྱི་མིག་བསྒྲིབས་པ་དེ་དགགིས་ནི་མྱ་ངན་ལས་འདས་པ་ལྟ་བར་བྱ་བ་ཉེ་བར་ཞི་ཞིང་ཞིབ་མི་མཐོང་ངོ།",
    "འཇིགརྟེན་ནི་ཕལ་ཆེར་ནམ་མཁའ་ལ་ཅི་ཡང་མ་ཡིན་པརམོས་ཏེ།",
    "འདི་ལྟར་སྨྲ་བ་པོ་དག་ན་རེ་སྤྲོས་པ་དེ་དག་ཐམས་ཅདནི་ནམ་མཁའོ།",
    "ཞེས་བྱ་བར་བསམ་མོ།",
    "ཁྱོད་ཀྱིས་ཕུང་པོ་དང་ཁམས་དང་སྐྱེམཆེད་དག་གི་སྟོང་པ་ཉིད་རྗེས་སུ་རབ་ཏུ་བསྟན་པས་ཁོ་བོ་སྟོངཔ་ཉིད་ཉནའདོད་པར་གྱུར་གྱིས།",
    "ཁྱོད་ཀྱི་ཆགས་པ་ཡོད་པར་གྱུར་ན་ཡང་།",
    "རེ་ཞིག་ཆགསཔ་ནི་ཡོད་དེ།",
    "འདོད་ཆགས་མེད་ན་གང་གིས་དེ་ཆགསཔར་འགྱུར།",
    "ཁྱོད་ཀྱི་འདོདཆགས་ཡོད་པར་གྱུར་ན་ཡང་ཆགས་པ་མེད་པ་ཉིད་དུ་ག་ལ་འགྱུརཏེ།",
    "ཁྱོད་ན་རེ་གང་དག་ལྷནཅིག་ཉིད་དོཞེས་ཟེར་བའི་འདོད་ཆགས་དང་།",
    "རེ་ཞིག་གཅིག་པ་ཉིད་ཡིན་ན་ལྷན་ཅིག་ཉིད་མི་འཐད་དོ།",
    "གལ་ཏེ་རེ་ཞིག་འདོད་ཆགས་དང་ཆགས་པདག་གཅིག་པ་ཉིད་ཡིན་ཡང་ལྷན་ཅིག་ཉིད་དུ་འགྱུར་ན་ནི་དེལྟ་ན་གྲོགས་མེད་པར་ཡང་ལྷན་ཅིག་ཉིད་དུ་འགྱུར་རོ།",
    "རྟ་གཅིགཔུ་ཉིད་ལ་གྲོགས་མེད་པར་ཡང་ལྷན་ཅིག་ཉིད་ཡོད་པར་ཐལ་བརའགྱུར་ཏེ།",
    "རྟ་ཐ་དད་པ་ཉིད་ལ་གྲོགསམེད་པར་ཡང་ལྷན་ཅིག་ཉིད་ཡོད་པར་ཐལ་བར་འགྱུར་ཏེ།",
    "དངོས་པོ་ཕན་ཚུན་མི་ལྟོས་པར་རེ་རེ་ལ་ཡང་ཡོདཔར་འགྱུར་བས་དོན་མི་འདོད་དེ།",
    "གང་གི་ཚེ་དེ་ལྟརཡང་རྟོག་ན་དེ་གཉིས་ཐ་དད་པ་ཉིད་དུ་གྲུབ་པ་ཁོ་ནར་འགྱུརརོ།",
    "དེ་གཉིས་ལ་ལྷན་ཅིག་གི་དངོས་པོ་ཐ་དདཔའི་དངོས་པོ་དང་མི་མཐུན་པ་དེ་ནི་མེད་པར་ཅིའི་ཕྱིར་ཡོངས་སུརྟོག་པར་བྱེད་གང་གི་ཚེ་ཐ་དད་པའི་དངོས་པོར་གྲུབ་ན་ལྷན་ཅིགགི་དངོས་པོར་བརྟགས་སུ་ཟིན་ཀྱང་།",
    "དེ་ལྟ་བསན་ལྷན་ཅིག་གི་དངོས་པོར་བརྟགས་སུ་ཟིན་ཀྱང་ཐ་དད་པ་ཉིད་ཀྱིསྐྱོན་ཆགས་པ་ཁོ་ནའི་ཕྱིར་ལྷན་ཅིག་གི་དངོས་པོར་བརྟག་པ་དོནམེདཔར་འགྱུར་ཏེ།",
    "ཐ་དད་པའི་དངོས་པོར་རབ་ཏུ་གྲུབ་པ་མེད་ན་ལྷནཅིག་གི་དངོས་པོ་འགྲུབ་པར་མི་འགྱུར་རོ།",
    "འདི་ལྟར་ཁྱོད་ནི་ཐ་དདཔའི་དངོས་པོ་ཡོད་ན་དེ་གཉིས་ཀྱི་ལྷན་ཅིག་གི་དངོས་པོ་ཡོད་པརའདོད་ན།",
    "ཐ་དད་པའི་དངོས་པོ་མེད་ན་ཁྱོད་ཀྱི་ལྷན་ཅིག་གིདངོས་པོ་ཡོདཔར་ག་ལ་འགྱུར།",
    "འོ་ན་ཐ་དད་པའི་དངོས་པོ་གང་ཞིག་ཡོད་ནའདོད་ཆགས་དང་ཆགས་པ་དག་ལྷན་ཅིག་གི་དངོས་པོར་འདོད་པ་ཅི་རེརེ་ལ་ཡོད་དམ།",
    "འོན་ཏེ་གཉི་ག་ལྷན་ཅིག་བྱུང་བ་ལ་ཡོད་དམ་འོན་ཏེཁྱོད་ཀྱིས་རང་དགར་ཐ་དད་པའི་དངོས་པོ་གཞན་ཞིག་བརྟགསཀྱང་རུང་སྟེ།",
    "ཐ་དད་པ་གང་ཡོད་ན་འདོད་ཆགས་དང་ཆགས་པ་དག་ལྷན་ཅིག་གིདངོས་པོར་འདོད་པ་དེ་སྨྲོས་ཤིག།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གང་དག་སྔར་འདས་པའི་རྣམས་པ་དེ་དགགིས་དེ་ལྟར་འདོད་ཆགས་རྣམས་ཆགས་པདང་ལྷན་ཅིག་གམ་ཆགས་པ་མེད་པར་ཡང་འགྲུབ་པ་མེད་དོ།",
    "ཁྱོད་ཀྱིས་འདོད་ཆགས་དང་ཆགསཔ་བརྟག་པ་དབྱས་པས་ཁོ་བོའི་ཡིད་སྟོང་པ་ཉིད་ཉན་པ་ལ་སྤྲོབར་བྱས་ཀྱི།",
    "དེ་ལ་རེ་ཞིག་འདུས་བྱས་སུ་ཡོངས་སུ་རྟོག་ན།",
    "དེ་དག་གིས་བུམ་པ་ཉིད་སྐྱེ་བ་དང་གནས་པ་དང་།",
    "ཅི་སྟེ་བྱེད་ན་ནི་མྱ་ངནལས་འདས་པ་འདུས་མ་བྱས་ཀྱང་འདུས་བྱས་ཀྱི་མཚན་ཉིད་ཡིན་པརཐལ་བར་འགྱུར་བས་དེ་ནི་མི་འདོད་དེ།",
    "འཇིག་པ་དག་རེ་རེ་ལ་ཡངའདུས་བྱས་ཀྱི་མཚན་ཉིད་བྱ་བར་མི་ནུས་ཏེ།",
    "སྐྱེ་བ་དང་གནས་པ་དང་འཇིག་པ་དག་གང་གི་མཚན་ཉིད་དུའགྱུར།",
    "དེ་མེད་ན་སྐྱེ་བ་དང་གནསཔ་དང་འཇིག་པ་དག་གང་གི་མཚན་ཉིད་དུ་འགྱུར་ཏེ།",
    "དེ་ལྟར་རེཞིག་སྐྱེ་བ་དང་གནས་པ་དངའཇིག་པ་དག་སོ་སོའམ།",
    "རེ་ཞིག་གནས་པནི་ཡོད་དོ།",
    "དེ་མེད་ན་སྐྱེ་བ་དང་གནས་པ་དང་འཇིགཔ་དག་གང་གིམཚན་ཉིད་དུ་འགྱུར་ཞེས་བསྟན་ཟིན་པས་དེའི་ཕྱིར་འཇིག་པ་ཡངའདུས་བྱས་ཀྱི་མཚན་ཉིད་དུ་མི་འཐད་དོ།",
    "འདི་ལྟར་གང་གི་ཚེ་ན་སྐྱེ་བ་དེའི་ཚེ་ནགནས་པ་དང་འཇིག་པ་མེད་ལ།",
    "གང་གི་ཚེ་གནས་པ་དེའི་ཚེ་ན་སྐྱེབ་དང་འཇིག།",
    "གང་གི་ཚེ་འཇིག་པ་དེའི་ཚེ་ན་ཡང་སྐྱེབ་དང་གནས་པ་མེད་པ་དེའི་ཕྱིར་སྐྱེ་བ་དང་གནས་པ་དང་འཇིགཔ་སོ་སོ་བ་དང་འདུས་པ་དག་ཀྱང་འདུས་བྱས་ཀྱི་མཚན་ཉིད་དུ་མིའཐད་དོ།",
    "སྨྲསཔ་ལྟག་ཆོད་དེ་ལྟ་བུ་འབའ་ཞིག་གིས་ཅི་བྱ།",
    "ཡོད་ནི་གང་གི་སྐྱེབ་དང་།",
    "ཁོ་བོ་ལྟག་ཆོད་ཀྱི་ཕྱིར་མི་རྩོམ་གྱིས་ཁོ་བོ་ནི་དེ་ཁོ་ན་ཤེསཔར་བྱ་བའི་ཕྱིར་རྩོམ་མོ།",
    "རེ་ཞིག་གནས་སྐབས་གང་ལབུམ་པ་ཞེས་བྱ་བར་འགྱུར་བ་ལེགས་པར་སོམས་ལ་སྨྲོས་ཤིག།",
    "དེ་ལགང་གི་ཚེ་མ་སྐྱེས་པ་ལ་ནི་བུམ་པ་ཞེས་བྱར་ཡང་མི་རུང་སྟེ།",
    "བུམ་པ་མ་ཡིན་པ་སྐྱེ་ཞིང་ཞེས་བྱ་བ་དེ་རེ་སྣམ་བུའམ།",
    "དེ་ལ་རེ་ཞིག་གལ་ཏེ་རེ་ལྡེའམ།",
    "ཅི་སྟེབུམ་པ་མ་ཡིན་པཞེས་བྱ་བ་ཅིའང་མེད་པ་ཞིག་ཡིན་ན་ནི་ཅི་ཡང་མེད་པ་གང་ཡིནཔ་དེ་ཇི་ལྟར་སྐྱེ་ཅི་སྟེ་སྐྱེ་ན་ནི་རི་བོང་གི་ཡང་ཅིའིཕྱིར་མི་སྐྱེ།",
    "དེ་ལ་རེ་ཞིག་གལཏེ་དེ་དག་ལས་འདུས་བྱས་ཀྱི་མཚན་ཉིད་གཞན་ཞིག་ཡོད་ན་ནི་དེལྟ་ན་ཐུག་པ་མེདཔར་ཐལ་བར་འགྱུར་ཏེ།",
    "ཐུག་པ་མེད་པར་ཡང་ཐལ་བར་མི་འགྱུར་ཏེ།",
    "དེ་དག་ནིརེ་ཞིག་འཁོར་ཅེས་བྱའོ།",
    "དེ་ལྟར་གཅིག་གིས་གཅིག་སྐྱེད་པརབྱེད་པས་ཐུག་པ་མེད་པར་མི་འགྱུར་རོ།",
    "འཇིག་པའི་འཇིག་པས་ཀྱང་རྩ་བའི་འཇིག་པ་འཇིགཔར་བྱེད་པས་དེ་ལྟར་ན་འདི་ལ་ཡང་ཐུག་པ་མེད་པར་ཐལ་པར་མིའགྱུར་རོ།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་སྐྱེ་བའི་སྐྱེས།",
    "ཁྱོད་ཀྱི་བུ་བས་མ་སྐྱེད་དེས།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་སྐྱེ་བའི་སྐྱེ་བས་རྩ་བའི་སྐྱེ་བསྐྱེད་པར་བྱེད་ན་ཁྱོད་ཀྱི་རྩ་བའི་སྐྱེད་པས་མ་སྐྱེས་པའིསྐྱེ་བ་དེས་རྩ་བའི་སྐྱེ་བ་དེ་ཇི་ལྟར་སྐྱེད་པར་བྱེད་དེ།",
    "གལ་ཏེ་ཁྱོད་ཀྱི་རྩ་བ་ཡིས།",
    "གལ་ཏེཁྱོད་ཀྱི་རྩ་བའི་སྐྱེ་བས་བསྐྱེད་པའི་སྐྱེ་བའི་སྐྱེ་བ་དེསརྩ་བའི་སྐྱེ་བ་དེ་སྐྱེད་བར་བྱེད་ན་སྐྱེ་བའི་སྐྱེ་བ་དེས་མསྐྱེད་པའི་རྩ་བའི་སྐྱེ་བ་དེས་སྐྱེ་བའི་སྐྱེ་བ་དེ་ཇི་ལྟརསྐྱེད་པར་བྱེད།",
    "ཁྱོད་ཀྱི་དེ་ནི་སྐྱེབཞིན་པ།",
    "ཁྱོད་ཀྱི་རྩ་བའི་སྐྱེ་བ་དེསྐྱེ་བཞིན་པ་རང་ཉིད་མ་སྐྱེས་པ་དེས་གལ་ཏེ་སྐྱེ་བའི་སྐྱེ་བ་གཞན་དེ་སྐྱེད་པར་བྱེད་ནུས་ན་ནི་སྐྱེ་བའིསྐྱེ་བ་དེ་སྐྱེད་པར་འདོད་ལ་རག་གོ།",
    "ཡང་ན་ཁྱོད་ཀྱི་སྐྱེ་བའིསྐྱེ་བ་དེ་སྐྱེ་བཞིན་པ་རང་ཉིད་མ་སྐྱེས་པ་དེས་གལ་ཏེ་རྩབའི་སྐྱེ་བ་གཞན་དེ་སྐྱེད་པར་བྱེད་ནུས་ན་ནི་རྩ་བའི་སྐྱེ་བདེ་སྐྱེད་པར་བྱད་ལ་རག་ན་མི་ནུས་ཏེ།",
    "ཇི་ལྟར་མར་མེས་རང་གིབདག་ཉིད་ཀྱང་སྣང་བར་བྱེད་ལ་བུམ་པ་དང་།",
    "སྣམ་བུ་ལ་སོགས་པདངོས་པོ་གཞན་དག་ཀྱང་སྣང་བར་བྱེད་པ་དེ་བཞིན་དུ་སྐྱེ་བསཀྱང་རང་གི་བདག་ཉིད་ཀྱང་སྐྱེད་པར་བྱེད་ལ་བུམ་པ་དང་སྣམབུ་ལ་སོགས་པ་དངོས་པོ་གཞན་དག་ཀྱངསྐྱེད་པར་བྱེད་དོ།",
    "མུན་པས་ཀྱང་རང་དང་གཞན་གྱི་དངོས་པོ་དག་སྒྲིབ་པར་ཐལབར་འགྱུར་པ་འདི་ལ་ཐེ་ཚོམ་མེད་པ་ཞིག་ན་མུན་པས་ནི་རང་དངགཞན་གྱི་དངོས་པོ་དག་སྒྲིབ་པར་མི་བྱེད་དོ།",
    "གལ་ཏེ་སྐྱེ་བསརང་གི་བདག་ཉིད་སྐྱེད་པར་བྱེད་ན་སྐྱེས་པས་སམ།",
    "མ་སྐྱེས་པཞིག་གིས་སྐྱེད་པར་སྐྱེད་གྲང་ན།",
    "རང་གི་བདག་ཉིད་ཇི་ལྟར་སྐྱེད།",
    "སྐྱེ་བ་འདི་མསྐྱེས་ཤིང་མེད་པས་རང་གི་བདག་ཉིད་ཇི་ལྟར་སྐྱེད་པར་བྱེད།",
    "ཡང་ན་འདི་མ་སྐྱེས་ཤིང་མེད་པའི་བདག་ཉིད་སུ་ཞིག་གིས་སྐྱེདཔར་བྱེད།",
    "ཅི་སྟེ་མེད་པས་ཀྱང་བདག་ཉིད་མེད་པསྐྱེས་ན་ནི་རི་བོང་གི་ཀྱང་བདག་ཉིད་སྐྱེད་པར་བྱེད་པཞིག་ན་སྐྱེད་པར་མི་བྱེད་དོ།",
    "དེལྟར་ན་རེ་ཞིག་སྐྱེས་པས་བདག་ཉིད་སྐྱེད་པར་མི་བྱེད་དོ།",
    "སོང་དང་མསོང་བགོམ་པ་ཡིས།",
    "ཇི་ལྟར་སོང་བལ་འགྲོ་བ་མེད་དེ།",
    "ཅི་སྟེ་མེད་ཀྱང་སྐྱེད་པར་འགྱུར་ན་ནི་རི་བོང་གི་ཡང་སྐྱེད་པར་འགྱུར་བ་ཞིག་ན་སྐྱེད་པར་མི་འགྱུར་ཏེ།",
    "སྐྱེ་བ་གཉིས་སུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་ཏེ།",
    "འདི་ལསྐྱེ་བཞིན་པ་ཞེས་བྱ་བནི་གང་གི་ཅུང་ཟད་ནི་སྐྱེས་ཅུང་ཟད་ནི་མ་སྐྱེས་པའམ།",
    "དེ་ལགལ་ཏེ་སྐྱེས་པ་དང་མ་སྐྱེས་པ་དེ་སྐྱེ་བས་སྐྱེད་པར་བྱེད་ན་རེཞིག་དེའི་གང་ཅུང་ཟད་སྐྱེད་པ་དེ་ནི་སྐྱེ་བ་དེས་བསྐྱེད་པ་མཡིན་ལ།",
    "གང་གི་ཚེ་སྐྱེ་བ་འདི་ཡོད་པས་སྐྱེ་བཞིན་པ་འདི་འབྱུང་ངོཞེས་བྱ་བ་དེ་མེད་ཅིང་མི་སྲིད་པ་དེའི་ཚེ་ཇི་ལྟར་སྐྱེ་བ་ལབརྟེན་ནས་སྐྱེ་བཞིན་པ་སྐྱེད་དོ།",
    "རེ་ཞིགསྣམ་བུ་སྐྱེ་བ་ལ་བརྟེན་ནས་ཅི་ཞིག་སྐྱེ་བཞིན་པ་ཡིན།",
    "རེ་ཞིག་སྐྱེས་པ་ནི་སྣམ་བུ་ཡིན་ཏེ།",
    "ཅི་སྟེ་འགྱུར་ན་ནི་རེ་ལྡེ་བྱེད་བཞིན་པ་ན་སྣམ་བུརའགྱུར་བ་ཞིག་ན་མི་འགྱུར་བས་དེའིཕྱིར་སྐྱེས་པ་ཡང་སྣམ་བུ་མ་ཡིན་ནོ།",
    "སྣམ་བུ་དེ་མེད་ན་གང་གིསྐྱེ་བ་ལ་བརྟེན་ནས་ཅི་ཞིག་སྐྱེ་བཞིན་པར་འགྱུར།",
    "ཅིཁྱོད་མཚོན་ཐབས་ལ་མཁས་ཞེས་ཏེ་མ་ཉིད་ལ་འདེབས་པར་བྱེད་དམ།",
