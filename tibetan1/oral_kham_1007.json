    "ཇི་ལྟར་བདག་ཡིད་བདེ་བར་འདུག།",
    "གཙོ་བོའི་ཞིང་ཕ་མ་དང་རིགས་ཀྱི་རྒན་པ་དང་རང་ལ་དྲིན་ཆེ་བ་རྣམས་ལ་སྟོབས་ཆེ་ལ།",
    "སྟན་ལ་འདུག་པའི་ཚེ་རྡོ་རྗེའི་གདན་ཐོབ་པར་གྱུར་ཅིག།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "མཛའ་བཤེས་དང་འཁོར་གཡོག་ལ་སོགས་པ་གང་ཡང་རྗེས་སུ་མི་འབྲང་བར་འདུག་ཅིང་།",
    "བདག་པོའི་འབྲས་བུ་ནི་ས་ཕྱོགས་ཡིད་དུ་མི་འོང་ཞིང་སྐྱོན་དང་བཅས་པ་དེ་ལྟ་བུར་སྐྱེ་དགོས་པར་འདུག།",
    "ཕྱི་མ་མཐོ་རིས་ཀྱི་ལུས་རྟེན་ཙམ་ཡང་ཐོབ་པའི་ངེས་པ་མི་འདུག་ཅིང་།",
    "ཚེ་འདིར་ཡང་ལྷ་དང་བཅས་པའི་འཇིག་རྟེན་ཐམས་ཅད་ཀྱིས་ཁྲེལ་བའི་གནས་སུ་འགྲོ་བ་འདུག་སྙམ་དུ་བསམ་ཞིང་བློ་ལ་སྐྱེད་ཅི་ཐོན་བྱ།",
    "ཕན་ལན་དུ་ཕན་མ་བཏགས་ན་བདག་ལས་ཁྲེལ་བོར་བ་སུ་ཡང་མི་འོང་བ་འདུག་པས་མ་འདི་ལ་དྲིན་ལན་དུ་དྲིན་དང་ཕན་ལན་དུ་ཕན་འཇལ་ཅི་ཐུབ་ཅིག་བྱ།",
    "བདེ་བ་དང་བདེ་བའི་རྒྱུ་དང་ལྡན་ན་ཕན་པ་འདུག་པ་ལ།",
    "ད་ལྟ་ནི་དེ་དང་བྲལ་ནས་འདུག།",
    "ད་ལྟ་ཡང་རང་ང་རྒྱལ་དང་རློམ་སེམས་ཀྱིས་རྒྱུད་ཁེངས་ནས་དམུ་རྒོད་དང་ཐོ་ཆོའི་སྤྱོད་པ་སྣ་ཚོགས་བྱེད་པའི་སྐབས་འདིར།",
    "འདི་སྡུག་བསྔལ་དང་སྡུག་བསྔལ་གྱི་རྒྱུ་དང་བྲལ་བ་ལ་འགོད་དགོས་པ་འདུག་ནའང་།",
    "ས་མཐོ་བར་འདུག།",
    "དབེན་པའི་གནས་སུ་བདེ་བའི་སྟན་ལ་རྗེ་བཙུན་རྣམ་པར་སྣང་མཛད་ཀྱི་སྤྱོད་ལམ་ལྟ་བུས་འདུག་སྟེ་སྐྱབས་གསོལ་སེམས་བསྐྱེད་གསུམ་སྔོན་དུ་འགྲོ་བས།",
    "གལ་ཏེ་འདུག་ན་གང་འདུག་པ་དེ་ཉིད་ལ་གཉེན་པོ་བཏང་སྟེ།",
    "གཙང་པོ་རྣམས་སུ་ཆུ་འཐུང་དུ་ཕྱིན་པས་ཆུ་མི་འདུག་ནས།",
    "སང་ཉིན་སྐོམ་ཉམས་སངས་པའི་རྗེས་སུ་བལྟས་པ་ན་ཆུ་རྣམས་སོ་སོའི་གནས་ན་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་པས།",
    "བློ་འདས་གཞི་མེད་རྩ་བྲལ་ནམ་མཁའ་ལྟ་བུར་འདུག་པ་ལ་དེ་ལྟར་མ་ཤེས་པར་ང་བདག་དང་གཟུང་འཛིན་གྱི་འཆིང་བ་དམ་པོས་བཅིངས་ཏེ།",
    "ཁྲི་སྟན་ལ་འདུག་པ་དང་།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "ཁ་ནང་བལྟས་ཀྱི་སེམས་རང་རིག་ཅིང་རང་གསལ་ཙམ་མ་འགགས་པར་མྱོང་བ་དེ་ཉིད་ལ་གསལ་བ་སེམས་ཀྱི་མཚན་ཉིད་ཅེས་བྱ་ལ།",
    "དེ་བཞིན་དུ་སེམས་ཉིད་གསལ་སྟོང་ཟུང་འཇུག་མངོན་དུ་བྱེད་པའི་ཐབས་བསྐྱེད་རྫོགས་ཡེ་ཤེས་གསུམ་ཀྱང་རང་སེམས་ཀྱི་ཆོ་འཕྲུལ་ལས་མ་འདས་ཏེ།",
    "དེ་བཞིན་དུ་རང་སེམས་གསལ་སྟོང་ཟུང་འཇུག་མངོན་དུ་གྱུར་པའི་འབྲས་བུ་སྐུ་གསུམ་ཀྱང་རང་སེམས་དག་པའི་རྣམ་རོལ་ལས་མ་འདས་ཏེ།",
    "དེ་ལྟར་ན་རྨི་ལམ་གྱི་སྣང་བ་དང་ད་ལྟར་གྱི་སྣང་བ་ལ་བདེན་རྫུན་གྱི་ཁྱད་པར་འགའ་ཙམ་ཡང་མི་འདུག་པ་ལ།",
    "རང་རིག་ཅིང་རང་གསལ་ཙམ་དེའི་རང་གདངས་ལ་རྗེན་གྱིས་བལྟ།",
    "དེ་ལྟར་ན་དོན་ལ་སྐྱེ་འགག་ནི་མི་འདུག།",
    "མི་འདུག་བཞིན་དུ་དེ་ལྟ་བུའི་སྣང་བ་ནི་ཤར།",
    "གཅིག་དང་དུ་མ་ལ་སོགས་པ་གང་དུ་ཡང་གྲུབ་པ་ནི་མི་འདུག།",
    "མི་འདུག་བཞིན་དུ་ཕན་ཚུན་ལྟོས་གྲུབ་ཀྱི་སྣང་བ་འདི་ལྟ་བུ་ནི་ཤར།",
    "མི་འདུག་བཞིན་དུ་ལྟོས་གྲུབ་ཀྱི་སྣང་བ་འདི་ལྟ་བུ་ནི་ཤར།",
    "མི་འདུག་བཞིན་དུ་འདི་ལྟ་བུའི་སྣང་བ་ནི་ཤར་ཞེས་སོགས་སྔར་ལྟར་བསམ་ལ་ངེས་ཤེས་བསྐྱེད་དོ།",
    "ཇི་ལྟར་མི་དག་ནགས་རིའི་ཁྲོད་འདུག་ནས།",
    "འཚོལ་མཁན་གྱི་སེམས་རང་རིག་ཅིང་རང་གསལ་ཙམ་ཞིག་ནམ་ཡང་མ་འགགས་པའི་ཕྱིར་མེད་པ་མ་ཡིན།",
    "མ་གྲོལ་ན་འཚང་མི་རྒྱ་བར་འདུག་པས།",
    "ཉི་མ་ལ་ཅུང་ཟད་འདུག།",
    "ཕྱི་བདུད་བཞི་རབ་ཏུ་འཇོམས་པའི་འདུག་སྟངས།",
    "ནང་བར་ཆད་མེད་པའི་འདུག་སྟངས།",
    "དེ་ཁོ་ན་ཉིད་གཟུང་འཛིན་གཉིས་མེད་ཀྱི་འདུག་སྟངས།",
    "མཐར་ཐུག་འཚང་རྒྱ་བའི་འདུག་སྟངས་སོ།",
    "གལ་ཏེ་ཙོག་པུར་འདུག་པར་འདོད་ན།",
    "འགྲོ་འདུག་དྲག་ལ་མང་བར་བྱས་པས་སེལ་ལོ།",
    "ཁ་ཟས་བཅུད་ཅན་གྱིས་ཁམས་གསོས་ཏེ་གནས་ཁང་དཔངས་མཐོ་བར་ཙོག་པུར་འདུག་ལ།",
    "དེ་ནི་མི་འདུག་ཉལ་བའང་མ་ཡིན་ཏེ།",
    "ཁྱེད་ཀྱིས་གཞོན་ནུ་འདི་དུས་དུས་སུ་སྐུ་མཉེ་བྱོས་ཤིག་དུས་དུས་སུ་ཁྲུས་བྱོས་ཤིག་དུས་དུས་སུ་ཟས་བྱིན་ཅིག་དུས་དུས་སུ་ཡང་དག་པའི་བདེ་བས་བསྙེན་བཀུར་བྱོས་ཤིག་མ་མ།",
    "དེ་ནས་དུས་གཞན་ཞིག་ན་རྒྱལ་པོ་། ཟས་གཙང་མས་གཞོན་ནུ་མ་མའི་པང་ན་འདུག་པ་ལ་ཡང་དང་།",
    "སྐྱེས་བུ་གང་ཞིག་དུས་ལས་འདས་པ་དེ་རྣམས་ཀྱི་ལགས་སོ།",
    "ཤར་སྒོའི་ཕྱི་རོལ་ན་འདུག་གོ།",
    "འགྲེང་པ་ཞེས་བྱ་བའི་རྩའི་རིགས་ལྟེ་བ་ནས་བྱུང་ནས་ནམ་མཁའི་བར་དུ་འཕགས་ཏེ་འདུག་པ་དང་།",
    "བྱ་སྣ་ཚོགས་ཕྱོགས་བཞི་ནས་འོངས་ནས་མདུན་དུ་ཁ་དོག་གཅིག་ཏུ་འདུག་པ་དང་།",
    "ཅིའི་ཕྱིར་ལག་པ་འགྲམ་པ་ལ་གཏད་ནས་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་། དེས་གསོལ་པ།",
    "བཟོ་སྦྱངས་མ་ག་དྷ་ཡི་བ་དག་ཁང་བཟང་འདི་ན་འདུག་པས་མཐོང་།",
    "རྒྱལ་པོ་འདུག་ནས་དགྱེས་པ་དང་།",
    "གལ་ཏེ་དེ་རྣམས་གདུང་བ་ལྔའི་སྦྱོར་བས་ཉིན་ཐུན་གཅིག་འདུག་པ་དེའི་ཚེ།",
    "ཀྱེ་མའོ་ ས་ཕྱོགས་འདི་ནི་དགའ་དགའ་ལྟར་འདུག་པ་ནགས་ཚང་ཚིང་མཛེས་པ།",
    "ཤིང་སྣ་ཚོགས་ཀྱིས་བརྒྱན་པ་དགའ་དགའ་ལྟར་འདུག་པ་ཞིག་སྟེ།",
    "ལན་འགའ་འདུག་པར་འདོད་ན་གན་རྐྱལ་དུ་འགྱེལ་ལོ།",
    "སྤྱི་བོ་སྨད་ནས་སྤོབས་པ་མེད་ལ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པར་གྱུར་ཏོ།",
    "ཡུན་ནི་འདི་སྲིད་ཅིག་འདུག་འདུག།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེ་ནས་ཚངས་རྲིས་ཀྱི་ལྷ་གཉིས་ཤིག་ཚངས་པའི་འཇིག་རྟེན་ན་འདུག་པ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "འདི་ལྟ་སྟེ་སྐྱེས་བུ་སྟོབས་དང་ལྡན་པའི་དཔུང་པ་བསྐུམ་སྟེ་བརྐྱང་བའམ་བརྐྱངས་སྟེ་བསྐུམ་པ་ཙམ་གྱིས་ཚངས་རིས་ཀྱི་ལྷ་གཉིས་ཀྱིས་ཚངས་རིས་ཀྱི་འཇིག་རྟེན་ནས་མི་སྣང་བར་གྱུར་ཏེ་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་ཕྱིན་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་སྟེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ་ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་ཚོང་པ་ག་གོན་དང་།",
    "འཇིག་རྟེན་ཀུན་ཏུ་སྣང་བར་འདུག་པ་ཇི་ལྟར་བར་སྣང་ཉི་མ་ཤར་བ་བཞིན།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་གོ།",
    "གཞན་དུ་ན་སྟན་ནར་མ་ཁོ་ནར་བཏིང་བ་ལ་ཚིག་འདི་སྐད་ཅེས་ཚེ་དང་ལྡན་པ་གོ་ཏ་མ་སྟན་ཡོད་ཀྱི་ཇི་སྟེ་འདོད་ན་འདུག་ཅིང་ཅེས་བརྗོད་པར་བྱའོ་ཞེས་བཅས་སོ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ་དེ་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་རིགས་ཀྱི་གཙོ་བོའི་བུ་གྲགས་པ་ཁྲིད་དེ་ཉིད་ཀྱི་གཙུག་ལག་ཁང་གང་ན་བ་དེར་གཤེགས་ནས་བྱོན་པ་དང་།",
    "ཁྱིམ་བདག་དེའི་ཕྱིར་འདུག་ཅིག་དང་།",
    "སྟན་འདི་ཁོ་ན་ལ་གཞོན་ནུ་གྲགས་པ་འདུག་པ་མཐོང་བར་འགྱུར་བའི་གནས་གང་ཡིན་པ་དེ་ཡོད་དོ་ཞེས་བཀའ་སྩལ་ཏོ་སྙམ་དུ་རིག་ནས་དགའ་བ་དང་།",
    "ཡིད་བདེ་བ་སྐྱེས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ་ཕྱོགས་གཅིག་ཏུ་འདུག་པ་དང་།",
    "ཁྱིམ་བདག་རིགས་ཀྱི་གཙོ་བོས་གཞོན་ནུ་གྲགས་པ་བསྟན་དེ་ཉིད་ལ་འདུག་པ་མཐོང་ངོ།",
    "མགུ་བར་འགྱུར་བའི་གཏམ་རྣམ་པ་སྣ་ཚོགས་མཛད་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ་ཕྱོགས་གཅིག་ཏུ་འདུག་པ་དང་།",
    "མེ་ལྕེ་གཅིག་ཏུ་གྱུར་ནས་སྲེག་པར་བྱེད་པ་བཞི་པོ་ལྟ་བུའི་ལུས་ཀྱིས་ཕྱོགས་གཅིག་ཏུ་འདུག་པ་ཡིན་ནོ།",
    "དེའི་ཚེ་ལྟེང་རྒྱས་། འོད་སྲུང་རལ་པ་ཅན་གྱི་འདུག་གནས་ན་མཆོད་སྦྱིན་ཞག་བདུན་པ་བྱེད་པ་ལ་བབ་པོ།",
    "དེ་ནས་ལྟེང་རྒྱས་འོད་སྲུང་རལ་པ་ཅན་གྱི་འདུག་གནས་ན་མཆོད་སྦྱིན་ཞག་བདུན་དུ་བྱས་ཟིན་པ་དང་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བཙལ་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་ནས།",
    "དེའི་ཚེ་ཚེ་དང་ལྡན་པ་ལྟེང་རྒྱས་འོད་སྲུང་འཁོར་དང་བཅས་ཏེ་དེ་ཉིད་དུ་འདུས་ཤིང་འདུག་པར་གྱུར་ཏོ།",
    "དེ་ནས་རྒྱལ་པོ་ཟས་གཙང་རང་ཉིད་ཀྱིས་སྤྲིང་ཡིག་བྲིས་པ་ལྷུམས་སུ་ཞུགས་པ་བཟུང་ནས་སུ།",
    "རྒྱལ་པོས་ཡན་ལག་ཐམས་ཅད་ཀྱི་འཁྱུད་ནས་སྟན་བཤམས་པ་ཉིད་ལ་འདུག་ཏུ་བཅུག་སྟེ།",
    "བདེ་བར་གཤེགས་ལ་ཀུན་ནས་རྟོག་ཅིང་འདུག་དེ་ནས་རྒྱལ་པོ་ཟས་གཙང་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "འདུག་པ་དང་།",
    "མགུ་བ་སྐྱེས་ནས་བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བཙལ་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "འོན་ཏེ་ཁྱིམ་པར་འདུག་དེས་སྨྲས་པ་ཡུམ།",
    "ཁྱིམ་པར་འདུག་སྟེ་ལེགས་པར་བསྐྱངས་ན་ལྷ་དང་།",
    "རྒྱལ་པོས་འཁྱུད་ནས་འདུག་ཏུ་བཅུག་སྟེ་སྨྲས་པ།",
    "སྟེགས་བུ་དག་ལ་འདུག་གོ་ཤཱཀྱ་རྣམས་ཀྱི་འབྱོར་པ་ལ་ལྟ་བར་འདོད་པའི་སྐྱེས་པའི་ཚོགས་ཡུལ་སྣ་ཚོགས་ནས་ལྷགས་པ་དག་ཀྱང་ལམ་པོ་ཆེ་དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱི་ཞབས་གཉིས་ལ་མགོ་བོས་ཕྱག་བྱས་ཏེ་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ་ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་སེར་སྐྱའི་གཞིའི་ཤཱཀྱ་རྣམས་ཀྱིས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "སྒོ་ང་རྡོལ་བའི་ཁོག་པ་གཉིས་ཤིག་འདུག་ནས།",
    "ཁུག་ཅིག་དེ་ནས་དེ་རྣམས་རྒྱལ་པོའི་སྤྱན་སྔར་དོང་ནས་རྐང་པ་གཉིས་ལ་གཏུགས་ཏེ་ཐོག་མར་གཏམ་བྱས་ནས་འདུག་གོ་གཏམ་གྱི་སྐབས་རྙེད་ཅིང་རྒྱལ་པོའི་ཞལ་མཐོང་ནས་སྨྲས་པ།",
    "ནོངས་པ་བགྱིས་པ་ནི་བཞག་གོ་རྒྱལ་པོས་བཏང་སྙོམས་སུ་བཞག་ནས་ཅང་མི་སྨྲ་བར་འདུག་གོ་བློན་པོ་རྣམས་ཚོགས་ནས་ཕན་ཚུན་དུ་གྲོས་བྱ་བར་བརྩམས་པ།",
    "ཀྱེ་གཞོན་ནུ་དེ་རྣམས་ད་ལྟར་གང་ན་འདུག་དེ་རྣམས་ཀྱིས་སྨྲས་པ།",
    "སྟན་གཅིག་པ་ཉིད་ནི་ལན་གཉིས་སུ་འདུག་པ་སྤོང་བ་ཡིན་ནོ།",
    "བདག་པོ་མེད་པ་དང་རང་བཞིན་གྱིས་མི་རྣམས་ཀྱིས་སྨད་པར་གྲགས་པའོ།",
    "འདུག་ན་ཉམ་ང་བའི་ཉེས་དམིགས་ཀྱང་མཐོང་།",
    "ལན་གཉིས་སུ་འདུག་སྟེ་ཟ་ན་ཡང་དང་།",
    "ཡང་དུ་འདུག་ནས་བྱིན་ལེན་བྱ་བ་དང་།",
    "དེང་སླན་ཆད་དུ་ལན་གཉིས་སུ་འདུག་སྟེ་ཟ་བ་སྤོང་སྟེ།",
    "ཆུའི་མཐའ་པ་ཞེས་བྱ་བ་ནི་ཟོས་ནས་སྟན་ལ་འདུག་ཀྱང་ལྷུང་བཟེད་དུ་ཆུ་བླངས་ནས་ཡང་མི་ཟ་བ་ཡིན་ནོ།",
    "སྟན་གཅིག་པ་ལ་ནི་ལན་གཉིས་སུ་འདུག་སྟེ་ཟ་བ་སྤོང་བ་ཡིན་ནོ།",
    "ལན་གཉིས་སུ་འདུག་སྟེ་ཟ་བས་ནི་སྟན་གཅིག་པ་ཉིད་འཇིག་གོ་ཟས་ཆོག་པ་པ་ཇི་ལྟར་ཡང་དག་པར་ལེན་ཅེ་ན།",
    "བརྐམ་ཆགས་ཀྱི་གནས་མལ་སྤོང་བ་ཞེས་བྱ་བ་ནི་སྔ་ན་འདུག་པ་བསླང་ནས་གནས་མལ་ལེན་པར་མི་བྱེད་དོ།",
    "གནས་གང་ན་འདུག་པ་དང་།",
    "ཡུལ་གཞན་ཞིག་ཏུ་ཚེ་སྨད་ལ་འདུག་པ་ན་སྔོན་གྱི་གྲོང་དེའང་ཞིག་སྟེ།",
    "དེའི་ཚེ་ལྷས་བྱིན་དེ་ན་འདུག་པས་བཅོམ་ལྡན་འདས་ཀྱིས་དེ་སྐད་ཅེས་གསུངས་པ་དེ་ལ་ཡིད་མ་ཆེས་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "དེའི་ཚེ་ཤཱཀྱ་མིང་ཆེན་དེ་ན་འདུག་པས་ཚེ་འཕོས་པ་ཅིར་འགྱུར་བ་བཀའ་སྩལ་པ་ལ་ཡི་དམ་ཆེས་ནས་བཅོམ་ལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཅེས་བསྟོད་ནས་སྤོབས་པ་མེད་དེ་མི་སྨྲ་བར་འདུག་གོ་དེ་ནས་ཡབ་རྒྱལ་པོ་ཆེན་པོས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
