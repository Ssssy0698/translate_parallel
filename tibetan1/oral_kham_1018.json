    "དེ་ལ་མགོ་འཁོར་ནས་འདུག་ཁོམ་མེད།",
    "ཅེས་གསུངས་པ་ལྟར་ངེས་པར་ང་ལ་སེམས་ཞིག་མེད་འདུག་བསམ་དགོས།",
    "ཐུགས་དགོངས་ཞིག་ཡོད་པ་ལ་ལོས་ཡིན།",
    "མྱུ་གུ་འདི་མི་སྐྱེ་བར་འདུག་ཅེས་ལག་པས་ཐེན་ན་ཆད་འགྲོ་བ་ལྟ་བུ་ཡིན།",
    "ཞི་ལྷག་གཉིས་ཉི་མ་གཅིག་བྱས་ནས་གནང་བ་ཕྱག་ལེན་ཡིན་འདུག་པས།",
    "ལུས་སེམས་ཀྱི་འབད་རྩོལ་མེད་པར་ཉལ་བ་དང་འགྲོ་འདུག་ལ་སོགས་པའི་སྤྱོད་པ་ཞེས་བྱ་བ་འགའ་ཡངས་སྟེངས་ན་ཡོད་པ་མིན་ན་ངལ་དུབ་ཀྱི་ལས་བྱེད་བཞིན་པ་བདེ་བ་ཡིན་ནོ་ཞེས་རྣམ་པ་ཀུན་ཏུའང་མི་རིགས་སོ།",
    "དཔེར་ན་ཉི་མས་གསུངས་ནས་གྲིབ་མ་ལ་འདུག་པའི་ཚེ་ཆིག་པའི་སྡུག་བསྡལ་ཅུང་ཟད་ཤུགས་ཆུང་བའི་སྐབས་ཀྱི་ཚོར་བ་སིམ་པ་ལ་སྡུག་བསྡལ་ཕྱིར་བཅོས་ཀྱི་བདེ་བ་ཞེས་བྱ་ལ།",
    "འཇིག་པ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དོ།",
    "དཔེར་ན་ཙ་ན་ཀས་གསེར་བསྒྱུར་གྱི་རྩིས་གསེར་ཅུང་ཟད་གྲུབ་པ་ན།",
    "རྐང་པ་དེར་ཞུགས་པ་མིན་པ་སོགས་དེ་བཞིན་དུ་རྟེན་འབྱུང་རང་བཞིན་མེད་པ་ལ་བྱ་བྱེད་ཐམས་ཅད་འཐད་པ་ཡིན་ནོ།",
    "རྟེན་འབྱུང་རང་བཞིན་མེད་ལ་མཁས་པར་བྱ།",
    "གཟུགས་དྲི་སོགས་ཕན་ཚུན་འདུས་ཀྱང་རང་བཞིན་གཅིག་ཏུ་མི་འགྱུར་བ་དེས་ན་མཚན་ཉིད་རྣམས་དང་སོ་སོ་ནི་མིན་ཕྱིར་བུམ་པ་ལ་གཅིག་མིན་ཞེས་བུམ་གཅིག་ཏུ་བདེན་པ་དགག་པ་བཞིན་དུ་ཚོགས་པ་གཅིག་ཉིད་དུ་ནི་བདེན་པར་གྲུབ་པ་མི་རིགས་སོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་བར་རྟོགས་པ་ལ་རག་ལས་ཏེ།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པ་སྒྱུ་མའི་ཚུལ་དུ་རྒྱས་པར་བསྒྲུབ་པ་དང་།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱི་སྟོང་པ་ཁོང་དུ་མ་ཆུད་པའི་སོ་སོ་སྐྱེ་བོ་རྣམས་དང་འཕགས་པ་རྣམས་ཀྱི་རྗེས་ཐོབ་ཀྱི་ཡེ་ཤེས་དང་།",
    "ཚ་བའི་མེ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མིན་ཞེས་གོང་ཉིད་དུ་ནི།",
    "རིམ་པ་དེས་ཆུ་དང་ས་དང་མེའི་དཀྱིལ་འཁོར་གྲུབ་པར་གྱུར་ཅིང་དེའི་དབུས་སུ་ཚངས་པའི་སྒོ་ང་ཆེན་པོ་འོད་འབར་ཞིང་གསལ་བ་ནས་དྷ་ཞིག་གནས་པ་དེ་སྨིན་ཅིང་བརྡོལ་བ་ལས་འཇིག་རྟེན་གྱི་མེས་པོ་ཚངས་པ་ཆེན་པོ་པདྨའི་མངལ་ནས་བྱུང་བ་པདྨ་ལ་འདུག་པ་གདོང་བཞི་པ་ཞིག་བྱུང་སྟེ་དེས་འཇིག་རྟེན་ཐམས་ཅད་སྤྲུལ་པས་དེ་ལ་འཇིག་རྟེན་མེས་པོ་ཞེས་ཟེར་ཏེ།",
    "ལྷ་ཆེན་གྱིས་ཨུ་མའི་སྲུང་མ་ལ་དྲང་སྲོང་དེ་བཞག་པའི་ཚེ་དེ་ལ་ཨུ་མ་ཆགས་ནས་མདུན་དུ་འདུག་སྟེ།",
    "བེ་རོ་ཙ་ན་ལ་སོགས་པ་ས་སད་མི་མི་བདུན་རབ་ཏུ་བྱུང་སསན་བྱ།",
    "པ་གོར་བི་རོ་ཙ་ན།",
    "བེ་རོ་ཙ་ན་ཡེ་ཤེས་སྤྱན་དང་ལྡན།",
    "དེ་ཤིན་ཏུ་ཡིན་པ་འདུག་ཅེས་གསུངས།",
    "སྐལ་བར་ལྡན་རྣམས་རང་རང་བསམ་པ་དང་།",
    "མུ་གུ་ལུང་ན་འབྲོག་མི་ལོ་ཙཱ་བ་ཤཱཀྱ་ཡེ་ཤེས་བྱ་བ་ཤིན་ཏུ་མཁས་པ་ཞིག་ཡོད་འདུག་པས།",
    "མྱང་པས་སྡུག་བསྔལ་གྱི་གཏིང་དང་མཐར་ཐོན་པ་ཞིག་ཡོད་མི་སྲིད་པར་འདུག།",
    "བདེ་བ་སྒྲུབ་པའི་ཐབས་དེ་ལྟར་བདག་ལ་མི་འདུག་སྟེ།",
    "རང་ལ་གཅེས་པར་འཛིན་པ་དང་གཞན་ཡལ་བར་འདོར་བའི་བློ་གཉིས་གོ་ས་བརྗེས་ཏེ་གཞན་ལ་རང་ལྟར་གཅེས་པར་འཛིན་ཅིང་རང་ལ་གཞན་ལྟར་ཡལ་བར་འདོར་བའི་བློ་བསྐྱེད་པའོ།",
    "སློབ་དཔོན་གྱི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ།",
    "དེ་ཡང་རང་གྲུབ་པའི་དུས་ལས་བས་༧༤ སྐད་ཅིག་གཉིས་པར་མི་གནས་པར་འགག་ཅིང་།",
    "བསྐལ་པར་གནས་པའི་དངོས་པོ་རྣམས་ཀྱང་ལོ་ཟླ་ཞག་དུས་ནས་སྐད་ཅིག་མའི་བར་གྱི་སྐྱེ་འགག་སྲང་མདའི་མཐོ་དམན་བཞིན་དུ་བར་ཆད་མེད་པར་འཇུག་པ་ཙམ་གྱི་མི་རྟག་པར་ཤེས་ན།",
    "འོན་ཀྱང་རང་རྒྱུད་པ་མན་ཆད་ཀྱིས་ཕྱི་རོལ་པའི་འདོད་པ་ལྟར་གྱི་ཕུང་པོ་ལས་དོན་གཞན་དུ་གྲུབ་པའི་བདག་མི་འདོད་ཀྱང་།",
    "རང་སྤྱི་གཉིས་ཀ་ཡང་རང་ངོས་ནས་མ་གྲུབ་ན་མེད་དགོས་པར་འདོད་དོ།",
    "གཞན་དུ་ན་ཁྱེད་རང་རྣམས་ཀྱིས་བུམ་པའི་སྒྲ་དོན་འདྲེས་རུང་དུ་འཛིན་པའི་ཞེན་རིག་བུམ་འཛིན་རྟོག་པའི་མཚན་ཉིད་དུ་སྨྲས་པའང་མི་འཐད་པར་འགྱུར་ཏེ།",
    "ཡིན་སྙམ་དུ་བསམ་པར་འདུག་ཅིང་།",
    "རྨི་ལམ་དུ་བྱས་པ་དང་མ་ཤེས་པར་བྱས་པ་དང་བསམས་བཞིན་མིན་པར་བྱས་པ་དང་དྲག་པོ་མིན་ལ་རྒྱུན་ཆགས་མིན་པར་བྱས་པ་དང་ནོར་བར་བྱས་པ་དང་བརྗེད་པས་བྱས་པ་དང་མི་འདོད་བཞིན་དུ་བྱས་པ་དང་རང་བཞིན་གྱིས་ལུང་དུ་མ་བསྟན་པ་དང་འགྱོད་པས་བསལ་བ་དང་གཉེན་པོས་བསལ་བ་སྟེ།",
    "གང་ཟག་འདི་མི་འདུག་སྙམ་དུ་ངེས་པ་ལ་མེད་རྒྱུའི་གང་ཟག་དེ་ཤེས་བདག་མེད་པ་དང་རང་བཞིན་མེད་པ་ཞེས་པའི་དོན་ངེས་པ་ལའང་དགོས་པ་ལྟར།",
    "མེད་རྒྱུའི་བདག་དང་རང་བཞིན་དེ་ལེགས་པར་ངོས་ཟིན་དགོས་ཏེ།",
    "གཞན་ཡང་རང་འགྲེལ་ལས།",
    "ཚོར་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པའི་ཕྱིར།",
    "སྒྲུབ་བྱེད་ཚོར་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་དང་།",
    "བསྒྲུབ་བྱ་གཟུགས་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་གཉིས་སྒྲུབ་དཀའ་སླ་མཚུངས་པའི་ཕྱིར།",
    "འདི་ཡང་རང་མཚན་ཁས་བླངས་པ་ལ་ཐུག་གོ།",
    "འདི་ཡང་རང་མཚན་མི་བཞེད་པ་ལ་ཐུག་གོ།",
    "བཞེད་ཚུལ་མང་དུ་འདུག་ན་ཡང་།",
    "སེམས་ཀྱི་འཇོག་ས་དེ་ན་གདའ།",
    "སེམས་རྣལ་དུ་འདུག་པ་དང་།",
    "སྒོ་བྱེད་དང་བསྒོ་གཞི་སྐྱེ་འགག་༢ ༥ དག་དུས་གཅིག་ཏུ་བྱེད་པའི་འབྲེལ་བ་དང་ལྡན་པ།",
    "ཁོ་ཁོ་རང་མ་ཡིན་ནོ།",
    "འདི་ནི་ལུགས་འདིའི་རིགས་པ་ཕྲ་ལ་དོན་ཆེ་བ་ཞིག་ཏུ་འདུག་གོ།",
    "ཡོན་ཏན་དེ་ཡང་རང་བཞིན་མེད་བཞིན་དུ་མི་རྟག་བཞིན་དུའམ།",
    "དུད་འགྲོའི་སྐྱེ་གནས་རྣམས་ནའང་གདའ།",
    "མངོན་སུམ་ཡང་རང་བཞིན་ཡོད་པའི་ཡུལ་ཅན་ཡིན་ནོ།",
    "འཛིན་པར་བྱེད་པ་ཡོད་མེད་དངོས་པོ་ཡང་ཡོད་པ་ན་ཡོད་པའི་དོན་མི་འཛིན་པ་ནི་ཀླུ་ལས་ངེས་པའི་ཕྱིར་དཔེང་ར་གསལ་པའི་བདག་ཉིད་དུ་ཡོད་པའི་སྒྲོན་མ་ནི་རྒྱུའི་སྟོབས་ཀྱིས་ཉེ་བར་འདུག་པ་ཉིད་བྲསལ་བྱར་བྱེད་པ་བཞིན་ནོ།",
    "དེ་ཉིད་དང་གཞན་རིག་དང་རང་བཞིན་དང་བྲལ་བ་ཉིད་དུ་ངེས།",
    "རང་རང་ལ་ངོ་བོ་ལ་གནས་པའི་ཕྱིར།",
    "དེའི་བད་ཉིད་ཀྱིས་འབྲེལ་པ་རང་བཞིན་འདི་ཡང་རང་བཞིན་གྱི་གཏན་ཚིགས་སུ་བརྗོད་པ་ཡིན་ནོ།",
    "འདི་ལྟར་གལ་ཏེ་ལུང་འདུག་པ་དོན་ལ་བལྟོས་ན་ནི་ལྡོག་པ་ནས་ཡང་ལྡོག་པར་འགྱུར་བ་ཡིན་ན།",
    "དེའི་ཕྱིར་དེ་ལྟར་འབྲས་བུ་དང་རང་བཞི་རི་ཀ་བདད།",
    "ཨོ་བེ་རོ་ཙ་ནཱ་ཡ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "རང་གཞན་སུས་ཀྱང་མཇལ་མྱོང་བ་ཕྱོགས་འདིར་མི་འདུག་གཤིས།",
    "ཁྱེད་རང་འདི་ནས་དགའལྡན་དུ་བྱམས་པ་མགོན་པོའི་དྲུང་དུ་འབྱོན་ཞིང་དེར་བཞུགས་པར་འགྱུར་བས།",
    "དཀྱིལ་འཁོར་སྒྲུབ་མཆོད་སོགས་ཚོགས་ཁང་དུ་བྱས་ན་དབངམ་ཐོབ་པ་རྣམསཀྱིས་དཀྱིལ་འཁོར་སོགས་མཐོང་བའི་དགག་བྱ་ཆེ་བར་འདུག་པས།",
    "གསང་སྔགས་ཀྱི་སྒྲུབ་མཆོད་ཁང་ལོགསསུ་བྱ་དགོས་པར་འདུག་གསུངས་བཞིན།",
    "བྱེད་པ་མ་གཏོགས་མེ་བསྲེག་མ་བྱེད་ཅེས་གསུང་འདུག་པ་དང་།",
    "སྐུ་ཁམས་མི་བདེ་པར་བསྙུན་གཞི་ཇི་འདྲ་འདུག་ཞུས་ཚེ།",
    "ན་ཚ་འདིར་ཡོད་རང་མི་འདུག་ཅེས་།",
    "དེ་མིན་གཞན་ཅི་ཡང་མི་འདུག་ཞུས་པར།",
    "དེས་འཁོར་དུ་གནས་པ་རྣམས་ལ་འདི་འདྲ་འདུག་གསུངས་པར་ཞབས་ཕྱི་ཚོས་མཁན་།",
    "ཡི་གེ་མི་འདུག་ཞུས་པར་བརྒྱ་དམ་གནང་མུས་ལ་ཕྱག་ཕྲེང་དེ་ཕྱག་གཉིས་ཀྱིས་བཟུང་ནས་ཡི་གེ་འདི་ལྕོགས་དང་གསུངསད་དུང་ཡག་པོ་ལྟོས།",
    "ད་སྣང་མཆེད་ཐོབ་གསུམ་ཡང་ངེས་ངེས་འདུག་པས་ཐ་མལ་དུ་འཚོར་བ་མི་འདུག་གསུངས།",
    "དགའ་ལྡན་ཞོལ་ཧ་ཅང་སྟབས་འགྲིག་པ་ཞིག་མི་འདུག་པ་གསུས།",
    "ཁོང་དེ་སྔོན་རྗེ་གོང་ཞབས་འབམ་བསྣུན་སྐབས་ལབ་ཁུས་ཞབས་བསིལ་ཞུ་མཁན་ཡིན་སྟབས་ཡིད་ཆེས་དགའདད་འཕེལ་བ་བྱུང་། འདུག་པ་དང་།་",
    "བློམན་པོ་ཆེའི་སྐུའི་རྣམ་འགྱུརཚུན་གྱི་དོན་སྤྱི་ཡིད་ལ་ལམ་མེར་འཆར་གྱི་འདུག།",
    "ཁ་བའི་ཟོལ་གྱིས་མགོ་ལ་བབས་འདུག་གོ་ག་ལེར་འདིསང་སྐྲུན་པ་མི་སྦྱར་བར།",
    "ད་ཕན་པ་གང་ཡང་མི་འདུག་ཟེར་བར།",
    "སྔོན་རྒྱལ་བ་བཀའ་བརྒྱུད་པའི་དགོནཔ་ཡིན་འདུག་པའི་སྟབས་ཀྱིས་ཆོ་ག་འདི་འདྲའི་རིགས་འགའ་ཞིག་དུས་ཕྱིསཀྱང་གཏོང་སྲོལ་ཡོད་པར་འདུག།",
    "གསུང་རྩོམ་ཡང་གསུང་འབུམ་ཕྱོགས་གཅིག་ཏུ་བསྒྲིགས་པ་མ་བྱུང་བ་འདུག་ཀྱང་།",
    "ལམ་རིམ་ཆུང་ངུའི་དབུ་ཤོག་གཅིག་བཅས་བབས་འདུག་པ།",
    "དེ་ནས་ད་དུང་གང་ཡོད་ལྟོསཤིག་གསུངས་པར་གང་ཡང་མི་འདུག་ཞུས།",
    "སྲོག་ཆགས་དེ་ཐབ་དུ་སྲེག་སྦྱོར་མཛད་པར་འདུག།",
    "སྐབས་དེར་ལག་གཡོག་ཕྱུ་པ་དམར་པོ་གྱོན་པ་ལོ་གཞོན་ཞིག་འདུག་པ་དང་།",
    "འདི་དག་རང་རང་རྟགས་སུ་བཟུང་།",
    "རང་རང་རྟགས་དང་མི་མཐུན་ན།",
    "འདུག་སྟངས་ཞེས་བྱ་བ་སྟེ།",
    "བདག་རང་ཁྲུས་བྱས་ལ་སྟན་བདེ་བ་ལ་ཇི་ལྟར་འདུག་པས་འདུག་ལ།",
    "རྣལ་འབྱོར་བླ་ན་མེད་པའི་ལུགས་ཀྱིས་རྔམ་པར་རྟོག་པ་སྤོང་བས་ཤ་ལྔ་བདུད་རྩི་ལྔ་ལ་སོགས་པ་བསྟེན་པའི་ཕྱིར་མི་གཙང་བར་རྐྱང་འདུག་པས་ན་འགལ་བ་ལྟར་སྣང་ཡང་འགལ་བ་མེད་པར་ཤེས་པར་བྱའོ།",
    "འོན་ཀྱང་རང་སྔགས་པ་ཡིན་པར་བསྒོམ།",
    "དཔེར་ན་གྲུབ་པ་དེའང་རང་བཞིན་ཞ།",
    "དེའི་དུས་སུ་སློབ་དཔོན་གྱིས་ལུས་ཀྱི་འདུག་སྟངས་རྐང་པ་གཡོན་པ་བརྐྱང་ལ་བསྐྱིངས་པས་གནས་ལ།",
    "དེ་ལྟར་ང་ལ་ཡོད་པ་བཞིན་ཁྱེད་རང་ལ་ཡང་ཡོད་པས་དེ་ལྟར་ཤེས་པར་གྱིས་ཤིག་ཅེས་བསྒོ་སྟེརང་བཞིན་གྱིས་གྲུབ་པའི་དཀྱིལ་འཁོར་གྱི་ངེས་ཚིག་དང་བཅས་པ་བཤད།",
    "ཐམ་ས་ཅད་ཀྱང་རང་དང་མཚུངས་པའི།་",
    "ཐམས་ཅད་ཀྱང་རང་དང་མཆུངས་པའི་ཐབས་དང་གཉིས་སུ་མེད་པ།",
    "ལྷོ་ཕྱོགས་ཁ་བལྟས་འདུག་པ་ཡིས།",
    "འཇིམ་པའི་གོང་བུ་ལ་བེེ་རོ་ཙ་ནའི་སྔགས་ཉི་ཤུ་རྩ་གཅིག་བཟླས་ལ་བྱིན་གྱིས་བརླབ་བོ།",
    "དེ་ནས་རང་ཁྲུས་དང་གཙང་སྦྲ་དང་གསོ་སྦྱོང་ལ་གནས་པས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "རང་ཁྲུས་དང་གཙང་སྦྲ་ལ་གནས་པས་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "གོས་གཙང་མ་གྱོན་ཏེ་ཁྲུས་བྱས་ལ་སྟན་བདེ་བ་ལ་འདུག་གོ།",
    "ཡང་རང་དམ་ཚིག་པ་ལ་གནས་གསུམ་བསྲུང་བ་བྱ།",
    "ཁྲུས་བྱས་ཏེ་སྟན་བདེ་བ་ལ་འདུག་ནས།",
    "དེ་ནས་ཁྲུས་བྱས་ཏེ་སྟན་ལ་འདུག་ལ་ལྷའི་རྣལ་འབྱོར་རྫོགས་པར་བསྐྱེད་དེ།",
    "པ་ཙ་པ་ཙ་ན་མེ་ཀེ་ན་མཱ་ར་ཡ་ཧཱུྃ་ཕཊ།",
    "ལྟས་པས་སྒྲོལ་མ་ལ་གསོལ་བ་ཐོབ་ཅིག་བྱ་བ་འདུག་སྟེ།",
