    "དེ་རྒྱལ་པོ་ཀྲི་ཀི་ག་ལ་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་རྒྱལ་པོ་ཀྲི་ཀི་ལ་རྒྱལ་བ་དང་།",
    "རྒྱལ་པོས་འོངས་པ་ལེགས་སོ་ཞེས་བྱ་བའི་ཚིག་གིས་ཀུན་ཏུ་སྤྱད་དེ་སྨྲས་པ།",
    "བདག་གིས་རྔོ་ཅི་ཐོག་པས་རྒྱལ་པོ་དགྱེས་པར་བགྱིའོ།",
    "ལྷ་རི་བྲགས་ཆེ་གེ་མོ་ཞིག་ཏུའོ།",
    "ཁྱོད་སོང་ལ་རི་བྲགས་དེ་ཁྱོད་ཀྱི་རྒོལ་བའི་ལོངས་སྤྱོད་གྱིས་ཤིག།",
    "མཆོག་ཏུ་དགའ་བར་གྱུར་ནས་སྐྱེ་བོ་མཁས་པ་དག་གིས་ཡོངས་སུ་བསྐོར་ཏེ་རི་བྲགས་དེར་སོང་ངོ།",
    "གཞན་ཡང་ཡོ་བྱད་ཀྱི་བྱེ་བྲག་གཙོ་བོ་གཙོ་བོ་དག་གིས་སྲིང་བར་བྱེད།",
    "དེ་གང་གི་ཚེ་ཆེན་པོར་གྱུར་པ་དེའི་ཚེ་ན་ཡི་གེ་དང་།",
    "ཐལ་བ་བླང་བ་དང་།",
    "སྙན་ཚིག་གི་རིག་བྱེད་དང་།",
    "སྲིད་སྲུང་གི་རིག་བྱེད་དང་།",
    "ལེན་པ་ལ་མཁས་པའི་བྲམ་ཟེའི་རིག་བྱེད་དང་རིག་བྱེད་ཀྱི་ཡན་ལག་གི་ཕ་རོལ་ཏུ་སོན་པ།",
    "མེ་ལྟ་བུའི་ཤེས་པས་རང་གི་སྨྲ་བ་གསལ་བར་བྱེད་པ།",
    "ཡབ་བདག་གིས་རི་ཙ་ཞེས་བགྱི་བ་འདིའི་དོན་དེ་འཚལ་ཏོ།",
    "འདི་ལྟར་ཕས་བུ་ལ་བདག་དང་མཉམ་པ་འམ་ཁྱད་པར་དུ་འཕགས་པ་དེ་ནི་འདོད་པར་བྱ་བ་ཡིན་པས་དེའི་ཕྱིར་འདི་བདག་པས་ཆེས་ཁྱད་པར་དུ་འཕགས་པ་ཡིན་གྱིས་བདག་གིས་འདི་ལ་བྲམ་ཟེའི་ཁྱེའུ་ལྔ་བརྒྱ་པོ་འདི་དག་གཏད་པར་བྱའོ་སྙམ་དུ་རིག་ནས་བྲམ་ཟེའི་ཁྱེའུ་སེར་སྐྱ་ལ་སྨྲས་པ།",
    "བུ་འདི་ལྟར་ཕས་བུ་ལ་བདག་དང་མཉམ་པ་འམ་ཁྱད་པར་དུ་འཕགས་པ་དེ་ནི་འདོད་པར་བྱ་བ་ཡིན་པས་དེའི་ཕྱིར་ཁྱོད་ཁོ་བོ་བས་ཆེས་ཁྱད་པར་དུ་འཕགས་པ་ཡིན་གྱིས།",
    "ཁྱོད་ཀྱིས་བྲམ་ཟེའི་ཁྱེའུ་ལྔ་བརྒྱ་པོ་འདི་དག་བྲམ་ཟེའི་གསང་ཚིག་དག་འདོན་དུ་ཆུག་ཤིག།",
    "དེ་དུས་གཞན་ཞིག་ན་དྲང་སྲོང་སྨྲ་བར་སོང་སྟེ་དེར་དགེ་སློང་ཞིག་གི་གན་དུ་སོང་ནས་སྨྲས་པ།",
    "བདག་གིས་འདི་དག་ལ་དྲི་བ་ཡང་འདྲི་བར་མི་ནུས་ན་བདག་གིས་འདི་དག་དང་ལྷན་ཅིག་ཅི་ལྟར་སྨྲ་བ་བྱ་བར་འགྱུར་སྙམ་ནས།",
    "དེའི་ཕྱིར་ཁྱོད་ཀྱིས་ཁོ་བོ་འདས་ནས་སྨྲ་བ་ཐམས་ཅད་དང་ལྷན་ཅིག་འཇིགས་པ་མེད་པ་དང་།",
    "འོད་སྲུང་གི་དགེ་སྦྱོང་རྣམས་ནི་མ་གཏོགས་ཏེ།",
    "རྒྱུད་ཟབ་མོ་དང་ལྡན་པ།",
    "དམར་པོ་དག་གིས་ཁྱོགས་སྤྱིལ་བརྒྱན་ཏེ་དུར་ཁྲོད་དུ་བསྐྱལ་ནས་བསྲེགས་ཏེ་དེའི་འོག་ཏུ་མྱ་ངན་གསང་བ་བྱས་ནས་འཁོད་དོ།",
    "ལྷོ་ཕྱོགས་ནས་ལྷགས་པའི་སྨྲ་བ་དེ་དག་གིས་བྲམ་ཟེ་སེར་སྐྱ་ཞི་བ་དུས་ལ་བབ་ཅེས་ཐོས་སོ།",
    "དེ་དག་གིས་དེ་བོས་ནས་དེས་རྒྱལ་པོ་ལ་རྒྱལ་བ་དང་ཚེ་སྤེལ་བ་བྱས་ཏེ་མཐའ་གཅིག་ཏུ་འདུག་པ་དང་།",
    "རྒྱལ་པོས་དེ་ལ་འོངས་པ་ལེགས་སོ་ཞེས་བྱ་བའི་ཚིག་གིས་ཀུན་ཏུ་སྤྱད་ནས་སྨྲས་པ།",
    "ཁྱོད་འདི་དག་དང་ལྷན་ཅིག་སྨྲ་བར་བྱེད་པར་ནུས་སམ།",
    "རྔོ་ཅི་ཐོག་གིས་ལྷ་དགྱེས་པར་བགྱིའོ།",
    "སྐྱེ་བོ་མཁས་པས་ཡོངས་སུ་བསྐོར་ནས་རང་གི་སྡུམ་པར་འོངས་སོ།",
    "བུ་ཁྱོད་ཀྱིས་སྨྲ་བ་ཐམས་ཅད་ཚར་བཅད་དམ།"
  ]
}