    "གླུད་འགོང་རྒྱལ་པོ་རེ་ཞིག་བསམ་ཡས་སུ་བསྡད་དེ།",
    "ཟླ་བ་གཉིས་པའི་ཚེས་ཉེར་ལྔ་ཉིན་མཆོད་རྫས་དོ་དམ་ངོ་ལས་རྣམས་རྩེ་ནས་ཐོན་བངས་ཕྱག་ཞུས་ཏེ་ལྷ་ས་བཀའ་ཤག་ཏུ་འབྱོར་ཕྱག་ཞུས་ཏེ་རྩེའི་སྐུ་ཚབ་གདན་ཞུས་འབྲེལ་མཆོད་རྫས་ཁང་གཟིམ་སྒོ་དབྱེ་སྟེ་གདན་ས་སོ་སོའི་གྲྭ་ཚང་ཁག་ནས་མཆོད་རྫས་སྔ་ལོ་ལྟེབས་རྒྱག་རྩིས་འབུལ་ཞུས་པ་བཞིན་རེ་རེ་བཞིན་ངོ་ནོར་མེད་པར་རྩིས་སྤྲོད་དང་།",
    "སྔ་དགོང་བར་བར་ལ་དེ་སྔའི་ལམ་ངན་སྒྲིགས་འཛིན་གྱི་སྦག་ཁང་ཚུགས་ཏེ་གཞུང་དོན་འཁུར་མེད་ཟ་སྐྱིད་འཐུང་སྐྱིད་བག་མེད་ཅན་རྣམས་ཚོགས་འཛོམས་ཀྱིས་ཉིན་མཚན་དུས་དྲུག་ཏུ་རྩེད་འཇོར་རོལ་བའི་གྲ་སྒྲིགས་མཆོད་རྫས་དོ་དམ་ནས་གཉེར་པ་ཆེད་འཛུགས་ཀྱིས་བྱེད་མུས་ལ་མཆོད་རྫས་རྩིས་སྤྲོད་ལེན་དུས་ཡུན་རིང་བའི་ཟ་འཐུང་གི་མཐུན་རྐྱེན་ལྟ་བུར་སྦག་ཁང་ཟིན་ནས་ལྟག་ཐུར་ཞེས་དངུལ་གསོག་འཇོག་དེ་དག་ཡིན་ལུགས་ཟེར་ཨང་།",
    "ཟླ་བ་གཉིས་པའི་ཚེས་ཉེར་དགུ་དགོང་མོ་མཆོད་རྫས་ལས་བྱེད་རྣམས་དང་།",
    "མཐའ་ཤོག་ཕན་ཚུན་མཚལ་ཐིག་ཉིས་གཤིབས་ཐོག་དྲ་ཕྱེད་ཀྱི་རི་མོས་མཛེས་པར་བྱས་ཤིང་།",
    "ཞོལ་འབྲས་བུ་སྟེང་དུ་བཀའ་ཤག་གིས་མཚོན་ཤོད་སྐོར་རྣམས་ཕེབས་དགོས་ལ་བཀའ་བློན་རྣམ་པ་ན་བཟའ་རྒྱན་བཞི་སེར་པོ།",
    "བཀའ་ཤག་གིས་མཚོན་དྲུང་བྱིངས་མཇལ་ཁ་ཞུས།",
    "འོ་ཕུད་ཕུལ་བར་སྐུ་སྒེར་སོ་སོ་ནས་འདོད་འཇོའི་བར་མཇལ་དར་རེ་སྩལ།",
    "དེ་ནམ་དགོང་ཇར་གསེར་ཊམ་ཞེས་སྐུ་འགྱེད་ཊམ་དཀར་རེ་དང་།",
    "བཀྲ་ཤིས་ཁ་བཏགས་བཅས་ཕུལ་ཏེ་ཚོགས་མཆོད་ཆེན་མོའི་མཛད་སྒོ་ལེགས་པར་གྲུབ་བོ།",
    "བཞེས་སྤྲོ་ལྔ་བརྩེགས་རེ།",
    "བྷ་ཏྲ་པུ་ཏྲ་མོ་སོར་སྙན་དར་རེ་ཕུལ་ནས་མཛད་སྒོ་གྲོལ།",
    "ཟླ་བ་གསུམ་པའི་ཚེས་བཅུ་བཞི་ཉིན་རྩེའི་ཚོམས་ཆེན་སྲིད་ཞིའི་ཕུན་ཚོགས་ཀྱི་གསེར་ཁྲི་ཆེན་མོར་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་ཞབས་སོར་འཁོད་པ་དང་།",
    "སྲིད་བློན་དང་བཀའ་ཤག་རྩེ་སྐོར་ཛ་ཏཱ་ཨན་ནས་གོང་ས་སྐྱབ་མགོན་ཆེན་པོར་གོ་བབས་མཇལ་དར་རེ་ཕུལ།",
    "གར་འཆམས་པ་རྣམས་ལ་མཇལ་ཁ་ཞལ་ཡར་གཟིགས་ཀྱིས་གྲལ་འཁོད།",
    "ཚེས་བཅོ་ལྔ་སྔ་དྲོ་ཐོ་རེངས་ཙམ་ནས་དཔལ་དུས་ཀྱི་འཁོར་ལོའི་སྒྲུབ་མཆོད་ཚོགས་མགོན་དུ་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་ཆིབས་བསྒྱུར་བཀའ་དྲིན་ཆེ་ཐོག་གསུང་ཆོག་རྒྱས་པས་དགོང་དྲོ་ཆུ་ཚོད་དགུ་པ་ཙམ་ཡུན་འགོར་ལ་ཆིབས་ཞབས་རྩེ་སྐོར་ཡོངས་རྫོགས་ཕེབས་དགོས།",
    "གཞན་ཨང་འབྱོར་ལྡན་མི་དྲག་ཁག་གི་སྒེར་ཤག་བཅས་པར་སྨྱུང་གནས་དཀར་པོ་ཆ་བརྒྱད་གནང་མཁན་ཀྱང་མང་པོ་ཡོང་།",
    "བྱ་གཡབ་སོགས་ཕུབས་ཏེ་བཟའ་བཏུང་ཕུན་སུམ་ཚོགས་པར་ལོངས་སྤྱད་དེ་ཕོ་མོ་རྣམས་རྐང་བྲོ་གླུ་གཞས་ཀྱིས་མཚོན་ཉིན་མང་དགའ་དགའ་སྐྱིད་སྐྱིད་ཀྱི་ངང་དུས་འདའ་བ་སོགས་ལོ་བསྟར་ཉམས་པ་མེད་པ་བྱེད་མུས་ཡིན།",
    "ཟླ་བ་དྲུག་པའི་ཚེས་བཞི་ཉིན་དུས་ལ་བབས་པར་གཟིགས་ནས།",
    "སང་གནངས་རིམ་བཞིན་བཀའ་ཤག་གི་༧ཞབས་པད་ངོ་མ་མོ་མོའི་སྐ་སྒེར་གཟིམ་ཤག་དང་།",
    "ལྷ་ས་ཞོ་སྟོན་ཞེས་སྔར་གྱི་ཟློས་གར་ལྷ་མོ་བ་འཁྲི་ཁུངས་འཕྱོངས་རྒྱས་སྤྱན་བདུན་པ་དང་།",
    "སྙེ་མོ་ཐོན་པ་དང་།",
    "སྐྱོར་མོ་ལུང་པ།",
    "ལྷ་མོ་བ་རྣམས་ནས་རིམ་པས་གཟིགས་ཕུད་ཕུལ།",
    "སླར་ཡང་འབྲས་སྤུངས་མུ་སྔ་དྲོ་བཀྲ་ཤིས་ཁང་གསར་དུ་གཟིགས་ཕུད་ཟིན་རིམ་བཞིན་ཁང་ཚན་ཐོབ་ཁུངས་ཡོད་རིགས་ཀྱི་ལྷ་མོ་བ་རྣམས་ནས་རང་རང་རྒྱལ་རབས་འཁྲབ་སྟོན་ཉིན་སྒང་ཐོག་སོ་སོའི་ཐོབ་ཁུངས་སྦྱིན་བདག་རྣམས་མགྲོན་འབོད་ཀྱིས་འབྲས་སྤུངས་ཞོ་སྟོན་ཞེས་སེར་སྐྱ་ཚང་མ་བྲེལ་འཚུབ་ལིང་ལིང་བྱེད།",
    "སྔར་སྲོལ་རྩེ་གསོལ་ཐབ་ནས་གསོལ་ཇ་དངུལ་ལྟིར་རེ་དང་།",
    "གསོལ་ཞིབ་ཐ་སྤག་རེ་བཅས་སྩལ་ལམ་དང་།",
    "ཚེས་བཅོ་ལྔ་ནམ་ལངས་སྔ་ཆར་བར་ཁང་དཔལ་ལྷ་དྲག་མོའི་ཞལ་འབག་སྐུ་གསོབ་གདན་ཞུ་དང་འབྲེལ་རྨེ་རུ་བ་ཚོགས་ཡོངས་ན་བཟའ་གཟབ་མཆོར་དང་བཅས་རིམ་བཞིན་བར་བསྐོར་ཕྱོགས་བཞིར་གཏོར་ཟོར་དང་།",
    "ལྷག་པར་ཀླུ་སྦུག་ཏུ་གཏོར་ཟོར་གནང་སྐབས་དཔལ་ལྷའི་བསྐུལ་ནང་རི་རབ་ལྷུན་པོའི་གདན་སྟེང་ན་ཞེས་པའི་ཚིག་ནས་དཔལ་ལྷའི་རི་རབ་ཅེས་དུས་ཆེན་གྱི་མིང་ཆགས་པ་དུས་ཕྱིས་དཔལ་ལྷའི་རི་ཁྲོད་ཟེར་མིང་གི་ཟུར་ཉམས་པ་རེད་ཅེས་གསུང་རྒྱུན་འདུག་པ་ཇི་ཡིན་དཔྱད་གཞི་ཙམ་དང་།",
    "དེ་ནས་མཇལ་ཁར་གོ་བབས་ཀྱི་མཇལ་དར་རེ་ཕུལ་ནས་གྲལ་ལ་འཁོད།",
    "དེ་ནས་རྒྱལ་མཆོག་བསྐལ་བཟང་རྒྱ་མཚོའི་གསེར་གདུང་གི་སྐུ་མདུན་དུ་ཁྲུས་གསོལ་རབ་གནས་དང་ཉམས་མགུར།",
    "རྒྱལ་མཆོག་ལྔ་པ་ཆེན་པོའི་གསེར་གདུང་ཆེན་མོའི་ཞལ་རས་ལྷ་ཁང་དུ་རབ་གནས།",
    "དེ་ནས་ས་གསུམ་དུ་མཆོད་གཟིགས་དང་མཆོད་འབུལ་དང་སྦྲགས་ཞབས་སོར་འཁོད།",
    "སེར་མོ་བར་མར་ཁུ་སྐྱོར་ལྡན་སོགས་འདོད་ཡོན་ཚོགས་ཀྱི་འཁོར་ལོར་ལོངས་སུ་སྤྱོད་པའི་སྐལ་བཟང་ཅན་རྣམས་ཀྱིས་ཚོགས་གཉིས་རླབས་པོ་ཆེར་འབད་དོ།",
    "དེ་ནས་ཚེས་ཆ་བཀའ་དྲུང་ནས་འཆར་ཕུལ་བཞིན་ལྷ་སའི་གཙུག་ལག་ཁང་ཆེན་མོའི་དཀོན་གཉེར་དཔོན་དང་།",
