    "མཐར་གིས་གནས་པའི་སོམས་པར་འཇུག་པ་དག་ནི་དགུ་སྟྲེ།",
    "འདུ་ཤྲེས་དང་ཚོར་བ་འགོག་པའོ།",
    "཈ོན་མོངས་པའི་རྒྱུ་ནི་མ་རིག་པ་དང་།",
    "རྣམ་པར་བྱང་བའི་རྒྱུ་ནི་གཞན་ལས་རྲེས་སུ་མཐུན་པའི་ས་དང་སོ་སོ་རང་གི་ཚུལ་བཞིན་ཡིད་ལ་བྱྲེད་པ་སྟྲེ།",
    "ཀུན་ནས་཈ོན་མོངས་པ་དང་།",
    "ཀུན་ནས་཈ོན་མོངས་པ་དང་།",
    "སྲེམས་ཅན་རྣམས་ཀྱི་ཀུན་ནས་཈ོན་མོངས་པ་སྐྱྲེ་བའི་རྒྱུ་གང་ཡིན་པ་དང་།",
    "སྲེམས་ཅན་རྣམས་ཀྱི་ཀུན་ནས་཈ོན་མོངས་པའི་རྒྱུ་ནི་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱྲེད་པའོ།",
    "སྲེམས་ཅན་རྣམས་ཀྱི་ཀུན་ནས་཈ོན་མོངས་པའི་རྲེན་ནི་མ་རིག་པའོ།",
    "཈ོན་མོངས་པ་རྣམས་ནི་རྒྱུའོ།",
    "སོ་སོ་རང་གི་ཚུལ་བཞིན་ཡིད་ལ་བྱྲེད་པའོ།",
    "དྲེ་བཞིན་གཤྲེགས་པའི་ཏིང་ངྲེ་འཛིན་ནི་ཟིལ་གིས་མི་ནོན་པ་སྟྲེ།",
    "འདི་ལ་དྲེ་བཞིན་གཤྲེགས་པའི་ཡྲེ་ཤྲེས་ནི་ཟིལ་གིས་མི་གནོན་པར་འཇུག་པའོ།",
    "གདམས་པ་དང་རྲེས་སུ་བསྟན་པ་གང་དང་གང་གིས་཈ན་ཐོས་རྣམས་ཏིང་ངྲེ་འཛིན་བསྐྱྲེད་པ་དྲེ་ཡང་དྲེ་བཞིན་གཤྲེགས་པས་རབ་ཏུ་ཤྲེས་སོ།",
    "སྲེམས་ཅན་གི་ཁམས་མུ་མཐའ་མྲེད་པ་བསྡུ་བར་བརོད་དོ།",
    "ཆྲེ་གྲེ་མོ་ཞིག་ན་བདག་གནས་ནས་དྲེ་ནས་ཤི་འཕོས་ནས་ག་གྲེ་མོ་ཞིག་ཏུ་སྐྱྲེས།",
    "དྲེ་ལྟར་སྔོན་གི་སྲིད་པ་གཞི་དང་བཅས་པ་དང་།",
    "དྲེ་སྲེམས་ཅན་དྲེའི་སྔོན་གི་གནས་རྲེས་སུ་དྲན་ནོ།",
    "སྔོན་གི་རྒྱུ་ཇི་ལྟ་བུ་དང་།",
    "སྲེམས་གང་གི་དམིགས་པ་ཅན་གི་འོག་ཏུ་སྲེམས་གང་གི་དམིགས་པ་ཅན་སྐྱྲེ་བ་དང་།",
    "དམིགས་པ་གང་གིས་སྐྱྲེ་བ་དང་།",
    "དྲེ་ལྟར་ཇི་ཙམ་དུ་སྲེམས་ཅན་གཅིག་གི་སྲེམས་གཅིག་ནས་གཅིག་ཏུ་བརྒྱུད་དྲེ་འཇུག་པ་དྲེ་ལྟ་བུ་ཞིག་གི་འོག་ཏུ་སྲེམས་འདི་ལྟ་བུ་ཞིག་བྱུང་ལ།",
    "དྲེའི་འོག་ཏུ་ཡང་འདི་ལྟ་བུ་ཞིག་བྱུང་བ་དྲེ་བསྐལ་པ་གང་གཱའི་ཀླུང་གི་བྱྲེ་མ་སྲེད་དུ་ཡང་ཚིག་ཏུ་བསྟན་པས་བསྟན་པར་དཀའོ།",
    "དྲེ་བཞིན་གཤྲེགས་པའི་སྔོན་གི་གནས་རྲེས་སུ་དྲན་པ་ཤྲེས་པ་འདི་ནི་བསམ་གིས་མི་ཁྱབ་ཅིང་མཚུངས་པ་མྲེད་ལ།",
    "ལས་ཤིན་ཏུ་སྣ་ཚོགས་པའི་བཟོས་སྦྱར་བ་གང་དག་ཡིན་པ་དྲེ་དག་བཅོམ་ལྡན་འདས་ཀྱིས་སྐད་ཅིག་གཅིག་ཁོ་ན་ལ་ལྷུན་གིས་གྲུབ་པར་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་ནུ་མཁྱྲེན་ལ།",
    "འོན་ཀྱང་ལྷའི་སན་གིས་འཆགས་པ་དང་འཇིག་པ་ལ་སོགས་པ་སྣ་ཚོགས་པ་མང་པོ་ཐམས་ཅད་ཀྱང་མ་ཚང་བ་མྲེད་པར་རབ་ཏུ་མཁྱྲེན་ཏོ་ཞྲེས་བྱ་བར་རྣམ་པར་གཞག་སྟྲེ།",
    "ཡང་ཤིང་རའི་འཕང་ལོ་ཙམ་གི་ས་ཕྱོགས་ན་སྣང་བར་མ་གྱུར་པའི་སྲེམས་ཅན་གང་དག་དྲེ་བཞིན་གཤྲེགས་པ་ལ་སྣང་བར་གྱུར་པ་དྲེ་དག་ནི་ཆྲེས་མང་གི་སྟོང་གསུམ་གི་སྟོང་ཆྲེན་པོའི་འཇིག་རྲེན་གི་ཁམས་ཀྱི་ལྷ་དང་མི་རྣམས་ནི་དྲེ་ལྟ་མ་ཡིན་ནོ།",
    "཈ོན་མོངས་དང་ནི་བག་ཆགས་དང་བཅས་འཇིག་འགྱུར་དང་།",
    "དྲེ་ལ་཈ོན་མོངས་པ་དག་ནི་མ་རིག་པ་དང་འདོད་ཆགས་ལ་སོགས་པ་དག་སྟྲེ།",
    "འཇིག་རྲེན་ཁམས་གསུམ་པོ་཈ོན་མོངས་པར་བྱྲེད་པའི་ཕྱིར་རོ།",
    "གང་གིས་སྲེམས་ཀྱི་རྒྱུད་འབག་པར་བྱྲེད་ཅིང་བསོ་བར་བྱྲེད་ལ་རྲེས་སུ་བགོད་པར་བྱྲེད་པ་དྲེ་ནི་བག་ཆགས་ཏྲེ།",
    "཈ོན་མོངས་པའི་མུར་ཐུག་པ་དང་གོམས་པ་དང་ར་བ་དང་བག་ཆགས་ཞྲེས་བྱ་བ་ནི་རྣམ་གངས་དག་གོ།",
    "མར་དང་མྲེ་ཏོག་ལ་སོགས་པ་བསལ་དུ་ཟིན་ཀྱང་བུམ་པ་དང་སྣམ་བུ་ལ་སོགས་པ་རྣམས་དྲེ་དག་དང་ཕད་པས་ཡོན་ཏན་ཕ་མོ་དམིགས་པ་བཞིན་ནོ།",
    "འདི་ལྟར་཈ོན་མོངས་པ་སངས་ཀྱང་བག་ཆགས་ཡོད་པས་དག་བཅོམ་པ་སྔོན་སྲེའུར་གྱུར་པ་མཆོང་ཞིང་མཆོང་ཞིང་འགོ་བ་དང་།",
    "སྔོན་བམ་ཟྲེར་གྱུར་པའི་དམངས་མོར་བརོད་པའི་ཀུན་ཏུ་སོད་པ་བཅོམ་ལྡན་འདས་ཀྱིས་བཟློག་ཏུ་ཟིན་ཀྱང་མ་ལོག་པ་དམིགས་པ་ཡིན་ནོ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་བག་ཆགས་ཡོད་པ་ནི་ལུས་དང་ངག་གི་འཇུག་པ་རྣམ་པ་དྲེ་ལྟ་བུའི་རྒྱུ་ཡང་ཡིན་ཏྲེ།",
    "དྲེའི་ཕྱིར་཈ོན་མོངས་པ་བག་ཆགས་ལྷག་མ་མ་ལུས་པར་སངས་པ་དང་།",
    "རིགས་ཀྱི་བུ་གཞན་ཡང་དྲེ་བཞིན་གཤྲེགས་པས་ཟག་པ་ཐམས་ཅད་ཟད་པས་བདག་གི་སྐྱྲེ་བ་ནི་ཟད།",
    "འཇིག་རྲེན་ཐམས་ཅད་ཀྱིས་ཟིལ་གིས་མི་གནོན་པ་སྟྲེ་སྲེམས་ཀྱི་སྐད་ཅིག་གཅིག་དང་ལྡན་པའོ།",
    "཈ོན་མོངས་པའི་བག་ཆགས་མྲེད།",
    "དཔྲེར་ན་ནམ་མཁའ་རང་བཞིན་གིས་ཡོངས་སུ་དག་པས་རྡུལ་དང་དུ་བ་དང་ལྷན་ཅིག་མི་ཟླ་གགས།",
    "དྲེ་བཞིན་གཤྲེགས་པའི་ཟག་པ་ཟད་པ་ཤྲེས་པ་ཡང་ལས་དང་཈ོན་མོངས་པའི་བག་ཆགས་ཐམས་ཅད་དང་ལྷན་ཅིག་མི་གནས་པའོ།",
    "དྲེ་ལྟར་གང་དག་རྣམ་པ་ཐམས་ཅད་དུ་ཡོངས་སུ་རོགས་པ་཈ིད་ལས་དྲེ་བཞིན་གཤྲེགས་པའི་ཡྲེ་ཤྲེས་ཀྱི་ཡུལ་བསམ་གིས་མི་ཁྱབ་པ་མངའ་བ།",
    "མཁའ་མྲེད་པས་འདབ་ཆགས་ལྡོག་པར་མི་འགྱུར་གི།",
    "རང་གི་བོའི་སྟོབས་ཡོངས་སུ་཈མས་པས་ལྡོག་པར་གནས་ན།",
    "དྲེའི་ཕྱིར་བདག་འདྲས་ཁྱོད་ཡོན་འདི་དག་ཅི།",
    "དྲེ་ལྟར་བདག་ལ་དྲེ་བཞིན་གཤྲེགས་པའི་ཡོན་ཏན་ཤས་ཙམ་ཞིག་ཡོངས་སུ་ཤྲེས་པ་ཡང་མྲེད་མོད་ཀྱི།",
    "དྲེ་ལྟ་ན་ཡང་བདག་གིས་ཚམ་ཚོམ་མྲེད་པར་ཡོན་ཏན་ཕྱོགས་གཅིག་གི་ཆ་ཙམ་ཞིག་གྲེངས་པ་ནི་གཞན་ལ་བརྲེན་ནས་ཡིན་ནོ།",
    "ཟབ་མོ་སྟོང་པ་཈ིད་ཡིན་ཏྲེ།",
    "སླར་ཡང་མི་གཡོའི་སྐུ་མངའ་ཁྱོད་ཀྱིས་སྲིད་གསུམ་བྱོན་ནས་སྤྲུལ་རྣམས་ཀྱིས།",
    "དྲེ་ལྟར་ཁྱོད་ཀྱིས་འཇིག་རྲེན་གཡོ་བག་སོད་ཅན་རྲེ་རྲེའི་ཞགས་པ་ནི།",
    "དྲེ་ཡི་ཕྱིར་ན་ཁྱོད་ཀྱིས་འགོ་ལ་ཐྲེག་པ་མི་མ་཈མ་དབྱྲེར་མྲེད་བསྟན།",
    "གང་ཞིག་དྲེ་ཁོ་ན་཈ིད་མི་ཤྲེས་པ་དྲེས་ནི་཈ོན་མོངས་པ་རྣམས་མ་ལུས་པར་སང་བར་མི་ནུས་ལ་དངོས་པོ་མ་ལུས་པ་ལ་ཡོད་པའི་དྲེ་ཁོ་ན་཈ིད་སྐྱྲེ་བ་མྲེད་པའི་རང་བཞིན་ཅན་ཡང་ཐ་དད་པ་མྲེད་པར་སྔར་བསྟན་ཟིན་ཏོ།",
    "གང་གི་ཕྱིར་དབྱྲེ་བ་དང་རྣམ་པར་འགྱུར་བ་཈ིད་མྲེད་པ་དྲེའི་ཕྱིར་དྲེ་ཁོ་ན་཈ིད་ཀྱི་ཡུལ་ཅན་ཡྲེ་ཤྲེས་ཀྱང་རང་བཞིན་གཅིག་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དྲེ་ལྟར་དྲེ་ཁོ་ན་཈ིད་གཅིག་཈ིད་ཡིན་པས།",
    "བདྲེ་གཤྲེགས་གང་ཕྱིར་ཁྱོད་ལ་མཁྱྲེན་རབ་ཐུགས་རྲེའི་ཐབས་དང་ལྷན་ཅིག་པ།",
    "མངའ་དང་གང་ཕྱིར་བདག་གིས་སྲེམས་ཅན་དགོལ་ཞྲེས་ཁྱོད་ཀྱིས་ཞལ་བཞྲེས་ཏྲེ།",
    "཈ོན་མོངས་པ་དང་།",
    "གང་གི་ཕྱིར་཈ོན་མོངས་པ་རྣམས་འཇུག་པ་ཤས་ཆྲེ་བའི་རྒྱུར་གྱུར་པ་དྲེ་དག་ནི་ལྷག་པར་མོས་པ་ཁྱད་པར་དུ་འཕགས་པ་འཇོམས་པར་བྱྲེད་པ་ཡིན་པའི་ཕྱིར།",
    "བཅོམ་ལྡན་འདས་ཀྱང་འགོ་བ་རྣམས་སྣོད་མ་ཡིན་པ་འདི་ཙམ་གིས་དྲེ་དག་རྣམ་པར་དགོལ་བར་བྱ་བ་ལ་གཡྲེལ་བ་བསྟྲེན་པར་མི་མཛད་དྲེ།",
    "གང་གི་ཕྱིར་བཅོམ་ལྡན་འདས་ལ་མཁྱྲེན་རབ་ཐུགས་རྲེའི་ཐབས་དང་ལྷན་ཅིག་ཏུ་གྱུར་པ་མངའ་བ་དང་།",
    "གང་གི་ཕྱིར་བདག་གིས་སྲེམས་ཅན་རྣམས་དགོལ་བར་བྱའོ་ཞྲེས་བཅོམ་ལྡན་འདས་ཀྱི་སྔར་སོན་ལམ་སྩལ་བ་དྲེའི་ཕྱིར་དྲེ་དག་རྣམ་པར་དགོལ་བ་ལ་སོམས་ལས་ལ་བརྲེན་པར་མི་མཛད་ཅིང་དྲེའི་རྣམ་པར་དགོལ་བའི་ཐབས་ཚོལ་བར་མཛད་དྲེ་ཞལ་གིས་འཆྲེས་པ་རྣམ་པ་གཞན་གི་སོ་ནས་གདོན་མི་ཟ་བར་བསྒྲུབ་པར་བྱ་དགོས་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་འགོ་བ་རྣམས་ཐྲེག་པ་ཆྲེན་པོ་ལ་འཇུག་པ་ལ་གྲེགས་བྱྲེད་པའི་རྲེན་མང་པོ་འདི་དག་ཡོད་ཅིང་འཇིག་རྲེན་རྣམས་ཀྱང་གདོན་མི་ཟ་བར་མྱ་ངན་ལས་འདས་པ་ལ་དགོད་པར་བྱ་དགོས་པ།",
    "དྲེ་ཕྱིར་མཁས་པས་རིན་པོ་ཆྲེའི་གིང་དུ་ཆས་པའི་སྐྱྲེ་ཚོགས་ཀྱི།",
    "ཕ་རབ་རྡུལ་གིས་རྡུལ་རྣམས་བདོག་པར་གྱུར་པ་ཇི་སྲེད་པ།",
    "འོན་ཀྱང་ཁྱོད་ཀྱི་གསང་བ་འདི་ནི་བསད་བགི་མ་ལགས་སོ།",
    "འདི་ནི་སྔོན་དགྲེ་བའི་ར་བ་མ་བསགས་པ་རྣམས་ཀྱིས་ལྷག་པར་མོས་པར་བྱ་བར་དཀའ་བའི་ཕྱིར་ན་བསད་པར་བྱ་བ་མ་ཡིན་ཏྲེ།",
    "གཏི་མུག་སྐྱོན་གིས་འཇིག་རྲེན་ཁ་ཟས་དུག་བཅས་ཟ་བ་ཡི།",
    "སྐྱྲེ་བོ་཈ིད་ཀྱི་ནང་མི་དྲེ་ལ་ཁྱོད་བརྲེ་ཇི་ལྟ་བ།",
    "གང་གི་ཕྱིར་ན་མི་མཁས་དངོས་དང་དངོས་པོ་མྲེད་པར་ཞྲེན་པའི་བོ་ཅན་གིས།",
    "བཅོམ་ལྡན་ཐུགས་རྲེས་ཁྱོད་ཐུགས་ཞི་ལས་བཟློག་པས་ཁྱོད་ལ་མྱ་ངན་འདའ་མི་མངའ།",
    "ལུགས་འདི་ནི་ཐུན་མོང་མ་ཡིན་ནོ་ཞྲེས་མཁས་པ་རྣམས་ཀྱིས་ངྲེས་པར་བྱའོ།",
    "ཀླུ་སྒྲུབ་བོ་མཚོ་ཤིན་ཏུ་རྒྱ་ཆྲེའི་ཁ་དོག་གིས་འཇིགས་པས།",
    "མཛད་པ་པོ་བྱོན་ཟིན་པར་གྱུར་པ་དྲེ་དག་གིས་ཀྱང་ཡི་གྲེ་ཙམ་ཐོས་པས་འཇིགས་ཏྲེ།",
    "ངྲེས་པར་རོགས་འགྱུར་འདི་ནི་གསན་རྒྱ་ཆྲེ་ཡང་གཞན་གི་ཐུགས་སུ་ཆུད་མི་འགྱུར།",
    "ཇི་ལྟར་མུ་སྟྲེགས་ཅན་སྔོན་སྲེམས་ཀྱི་རྒྱུད་ལ་སྟོང་པ་཈ིད་ལ་ལྷག་པར་མོས་པའི་བག་ཆགས་མ་གཞག་པ་རྣམས་ཀྱི་ཁམས་གསུམ་པོ་འདོད་པ་དང་།",
    "དྲེ་དག་གིས་ཀྱང་མང་དུ་གསན་པ་རྣམ་པ་དྲེ་ལྟ་བུ་མངའ་ཟིན་ཀྱང་སྟོང་པ་཈ིད་ལ་ལྷག་པར་མོས་པའི་ས་བོན་དང་བལ་བས་སྟོང་པ་཈ིད་ཐུགས་སུ་ཆུད་པར་མི་སོད་དོ་ཞྲེས་བྱ་བར་ཤྲེས་པར་བྱའོ།",
    "འདི་ལྟར་དྲེང་སང་཈ིད་ནའང་ཚེ་རབས་གཞན་དུ་སྟོང་པ་཈ིད་ལ་ལྷག་པར་མོས་པའི་བག་ཆགས་གཞག་པ་ཁ་ཅིག་གིས་རྒྱུའི་སྟོབས་ཁོ་ན་ལས་སྟོང་པ་཈ིད་ཀྱི་གཏིང་རོགས་པར་སྣང་ལ་རྒྱུའི་སྟོབས་ཁོ་ན་ལས་མུ་སྟྲེགས་ཀྱི་གཞུང་ལུགས་རྣམས་ལ་འདི་བདྲེན་པར་མཐོང་བ་རྣམ་པར་཈མས་པ་རྣམས་ཀྱིས་ཀྱང་སྟོང་པ་཈ིད་ཀྱི་གཏིང་དཔོགས་པར་མཐོང་ངོ།",
    "ལུགས་གཞན་པོ་རང་གི་བོས་སྦྱར་བ་ལ་ཡ་མཚན་པར་རོགས་པར་མི་བྱའི།",
    "རང་གི་སྟོང་པ་཈ིད་ཀྱི་ལྟ་བ་ལ་ལྷག་པར་མོས་པ་ཁོ་ན་ལ་ཡ་མཚན་རོགས་པར་བྱའོ།",
    "ཁྱབ་ཅིང་ཡིད་མཁའ་཈ོན་མོངས་ཀྱིས་སྔོན་སྟོན་ཀའི་རྒྱུ་སྐར་ལྟར་དཀར་བའམ།",
    "རི་མོར་བིས་པའི་བ་དྲུས་མ་ལས་འོ་མ་བཞོས་པས་བདྲེན་པར་ཞྲེན་པ་བཟློག་པར་མཛད་པས་སྦྱར་བ་རོགས་སོ།",
    "གཟུ་བོར་བྱོས་ལ་དཔྱད་པར་གིས།",
    "ཁ་ཆྲེའི་ཡུལ་གི་གོང་ཁྱྲེར་དཔྲེ་མྲེད་ཀྱི་དབུས་རིན་ཆྲེན་སྦས་པའི་གཙུག་ལག་ཁང་དུ།",
    "༦དེ་དག་གི་དོན་བསྡུ་བ།",
    "སྐྱེས་བུ་ཆུང་ངུ་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པ་ལ་བློ་སྦྱང་པ།",
    "ཇི་ཙམ་གྱིས་སྐྱབས་སུ་སོང་བའི་ཚུལ།",
    "༤སྐྱབས་སུ་སོང་ནས་བསླབ་པར་བྱ་བའི་རིམ་པ།",
    "སྐྱེས་བུ་འབྲིང་དང་ཐུན་མོང་བའི་ལམ་གྱི་རིམ་པ་ལ་བློ་སྦྱང་བ།",
    "འབྲིང་གི་བསམ་པ་སྦྱང་བ་དངོས།",
    "༡ སྡུག་བསྔལ་དང་ཀུན་འབྱུང་གི་སྒོ་ནས་བསམ་པ།",
    "གི་",
    "༤ དེ་དག་གི་དོན་བསྡུ་བ།",
    "༣ དེ་དག་གི་དོན་བསྡུ་བ།",
    "༤ དེ་དག་གི་དོན་བསྡུ་བ།",
    "ཞི་གནས་དང་ལྷག་མཐོང་གི་ངོ་བོ།",
    "༡ ལྷག་མཐོང་གི་ཚོགས་བསྟེན་པ།",
    "དགག་བྱ་འགོག་པ་དེ་ཐལ་རང་གང་གིས་བྱེད་པ།",
    "༡ ཐལ་རང་གི་དོན་ངོས་གཟུང་བ།",
    "༡གང་ཟག་གི་བདག་མེད་གཏན་ལ་དབབ་པ།",
    "༢ ལྷག་མཐོང་གི་རབ་ཏུ་དབྱེ་བ།",
    "༢རང་གི་ལུགས་བཞག་པ།",
    "ལུས་སེམས་གང་རུང་གི་བདེ་བ་མ་ཐོབ་པ་འཐོབ་པར་བརྩོན་པ་དང་།",
    "བསམ་གཞིག་གི་དཔྱོད་ཤེས་བཙོ་སྦྱངས་བརྡར་གསུམ་གྱི་ཚད་རིམ་མི་འདྲ་ཕྱིར།",
    "རང་གིས་རེ་ཞིང་སྒུག་པའི་བདེ་བ་དེ་རེག་པར་ཚེགས་དཀའ་སླའི་བརྒྱུད་རིམ་མི་གཅིག་པར་མ་ཟད།",
    "འཕྲལ་སྣང་གི་བདེ་བ་དང་བརྟག་ཐུབ་ཡུན་བརྟན་གྱི་བདེ་བ་སོ་སོར་མ་ཕྱེད་པར་བརྟེན།",
    "སྦྱོར་བ་དང་མཇུག་གི་ཉིན་ཞག་སྟོང་ཕྲག་མང་བོའི་སྡུག་བསྔལ་གྱིས་ཉིན་གཅིག་གི་བདེ་བ་ཉོ་མཁན་ཡང་རང་དང་གཞན་གྱི་ཁྲོད་དུ་ཉུང་བ་མ་ཡིན་པ་འདི་ལགས་པས།",
    "ཚེགས་ཆེ་དོན་ཆུང་གི་བདེ་བ་ཙམ་ཡང་ཐོབ་མིན་སོམ་ཉི་ལས་མ་འདས་ལ།",
    "བྱ་སླ་དོན་ཆེ་བརྟག་ཐུབ་ཡུན་བརྟན་གྱི་བདེ་བ་ཆུང་རིམ་ནས་མས་འཛེག་གི་ཚུལ་དུ་ཐོབ་པར་མྱོང་བས་གྲུབ་ལ།",
    "གཞུང་འདིའི་ཐུན་མོང་མ་ཡིན་པའི་མེ་ཡི་ཚ་བ་ལྟ་བུའི་རང་མཚན་ནི།",
    "སྤྱི་ལོ་༡༤༣ལོར་ལམ་རིམ་ཆེན་མོ་བྱུང་བ་ནས་ད་ལྟའི་བར་ཡུལ་ཕྱོགས་སོ་སོར་ལམ་རིམ་གྱི་པར་གཞི་མང་བོ་བྱུང་ཞིང་།",
    "ལར་མི་དཀྱུས་མ་ཞིག་གི་རྣམ་དཔྱོད་དང་མཐོང་ཐོས་ལ་ཚད་བཀག་ཡོད་པར་མ་ཟད།",
    "མོས་གུས་དྲག་པོས་གསོལ་བ་བཏབ་པའི་མཐུས།",
    "འབྲས་སྤུངས་རྒྱལ་བ་གྲྭ་ཚང་གི་མཁན་རབས་གཉིས་པ་ཡིན།",
    "གཙང་གི་བྱང་དུ་ཀྲེའི་རིགས་སུ་འཁྲུངས།",
    "འདི་དུས་སྤྱི་ཁང་ཞིག་གི་འོག་ཁང་དུ་གནས་སྐོར་བའི་ཉལ་ས་ཞིག་ཏུ་བཞུགས་དགོས་བྱུང་བས།",
    "དགུང་ལོ་ཞེ་གཅིག་སྟེང་ཉི་མ་ཐང་གི་སློབ་དཔོན་དུ་བཞུགས་ནས་འཆད་ཉན་མཛད།",
    "ཉི་མ་ཐང་གི་མཁན་རབས་ཉེར་གསུམ་པ་དང་།",
    "ལྷ་སའི་རྨེ་རུ་གྲྭ་ཚང་གི་བླ་རབས་བཅུ་གཅིག་པར་བཞུགས་ཤིང་།",
    "ལྷ་སའི་གཙུག་ལག་ཁང་དུ་སྒྲོལ་མའི་འདྲ་སྐུ་བཞེངས་པས་དུས་ཕྱིས་བར་སྒྲོལ་མ་ལྷ་ཁང་གི་དཀོན་གཉེར་འབྲས་སྤུངས་ཉག་རི་ཁམས་ཚན་གྱིས་བྱེད་དགོས་ཟེར།",
    "ཉི་མ་ཐང་གི་མཁན་རབས་ཉེར་དྲུག་པ་དང་འཕྱོངས་རྒྱས་བཀྲ་ཤིས་བདེ་ཆེན་གྱི་མཁན་རབས་བཅུ་བདུན་པ་དང་གསང་ཕུ་གླིང་སྟོད་ཀྱི་མཁན་རབས་སོ་དགུ་བ།",
    "འབའ་ལི་ཐང་གི་གདན་རབས་བཅུ་གཉིས་པ་བཅས་ལ་བཞུགས།",
    "འདི་ཉིད་རྒྱལ་བོ་ལྷ་བཟང་དང་མཇལ་འཕྲད་གནང་སྐབས་སུ་ལྷ་བཟང་གིས་རིམ་ལྔའི་རིམ་པ་བཞི་བའི་དོན་གྱི་འོད་གསལ་གྱི་སྐབས་སུ་སྒྱུ་ལུས་ཡོད་དམ་ཞེས་དྲིས་པར་རྗེ་འདི་བས་སྒྱུ་ལུས་ཀྱི་སྣང་བ་མེད་ཀྱང་སྒྱུ་ལུས་ཡོད་ཅེས་ལན་བཏབ་པར་ལྷ་བཟང་གིས་ལག་བརྡབ་ནས་ཁྲེལ་དགོད་བྱས་པ་བདེན་པར་འདུ་ག་སྟེ།",
    "གདན་ས་ལེ་ལག་གི་ཁྲི་མང་བོ་བསྐྱངས།",
    "ཕྱིས་སུ་སློབ་བུ་དག་གིས་བསྙེན་མཚམས་འདྲ་གནང་བ་ཡིན་ནམ་ཞུས་པར།",
    "ཨ་མཆོག་མཚན་ཉིད་དགོན་དུ་ཞུགས་ནས་གསན་སྦྱངས་གནང་ཞིང་།",
    "ཨ་མཆོག་མཚན་ཉིད་དང་ཁྲོ་ཁོ་ཞལ་ཞུལ་དགོན་སོགས་སུའང་འཆད་ཉན་རྒྱ་ཆེར་གནང་།",
    "དགེ་ཚུལ་སློང་གི་སྡོམ་པ་འབོགས་པ་སོགས་བསྟན་འགྲོའི་དོན་རྒྱུ་ཆེར་མཛད།",
    "དུང་དཀར་བས་དགུང་ལོ་རེ་དགུ་བ་སྤྱི་ལོ་༡༦༦ལོར་འདས་པར་བཞེད་པ་དང་།",
    "སུམ་པས་སྤྱི་ལོ་༡༦༣དང་སྤྱི་ལོ་༡༦༤གཉིས་ཀའི་རེའུ་མིག་ཏུ་འདས་པར་བཀོད་པ་གཅིག་ཡིག་ནོར་ཡིན་ངེས་དང་།",
    "གསན་ཡིག་དང་འཇམ་དཔལ་ཞལ་ལུང་གི་མཇུག་བྱང་དུ་ཚར་གཉིས་གསན་གསུངས།",
    "བྲག་ཡེར་བ་ནས་འཇམ་དབྱངས་དཀར་བོ་བསྒྲུབས་པས་རྟགས་མཚན་ལེགས་པ་བྱུང་སྟེ་ཕྱིར་ལམ་དུ་ཕ་བོང་ཞིག་གི་རྩར་ངལ་གསོས་པས་ཅུང་ཟད་གཟིམས།",
    "འགའ་ཞིག་གིས་རི་ཁྲོད་དུ་སོང་ནས་རྟགས་གསལ་སྒྲིག་མ་བཟོས་པ་འདྲ་ཞེས་གླེང་ཚུལ་རྗེ་ཤེས་རབ་རྒྱ་མཚོའི་གསུང་འབུམ་ག་བའི་འཇམ་དཀར་ལས་ཚོགས་ཀྱི་ཟིན་བྲིས་སུ་གསལ།",
    "རྗེ་ཉིད་ཀྱི་གསུང་གི་འཕྲིན་ལན་ཞིག་ཏུ་བྲ་ཏི་ཁང་སེར་མ་ནས་ཕུལ་ཞེས་གསལ་བས།",
    "རྟག་ཏུ་འགྲོ་མེད་སྒྲོག་གི་རྒྱུར་ཆུད་བཞིན།",
    "འདི་བའི་མཛད་རྣམ་མ་ངེས་མོད།",
    "དཀྱིལ་འཁོར་གྱི་བྱ་བ་ལ་འཇུག་པ་ལ་མེད་དུ་མི་རུང་གི་བསྙེན་པ་ཁ་སྐོང་དང་བཅས་པ་ཚད་དུ་འཁྱོལ་ཞིང་།",
    "སྤྱི་ལོ་༢༡༣ལོར་བཀྲ་ཤིས་འཁྱིལ་གྱི་གུང་ཐང་བླ་བྲང་དུ་འདུས་ཚོགས་བརྒྱ་ཕྲག་ཁ་ཤས་ལ་ལམ་རིམ་མཆན་བཞི་ལུང་རིགས་ཉམས་མྱོང་གིས་བརྒྱན་ཏེ་ཐུགས་བརྩེ་བས་སྩལ་པ་གུས་པས་ཞུས་སོ།",
    "ཁ་རག་གམ་ཁ་རོག་ནི་གཞིས་རྩེ་རིན་སྤུངས་ཀྱི་ས་མིང་ཞིག་ཡིན་སྣང་ལ་དབལ་མང་གིས་དབུས་ཀྱི་གསང་སྔགས་མཁར་ས་དང་ཉེ་བའི་ཁ་རབ་ཤན་ཁ་བ་ཡིན་གསུངས།",
    "གི་བརྒྱུད་རིམ་པ་གཉིས་ལ།",
    "ཀློང་རྡོལ་གསན་ཡིག་ཏུ་འཁོན་སྟོན་ཡང་མཆན་སྦྲག་གི་བརྒྱུད་རིམ་དུ་ཡོད་ལ།",
    "ཇོ་རྣམ་རྒྱས་པ་ཡོངས་གྲགས་མ་སྟེ་མཆིམས་ཀྱིས་བསྒྲིགས་པ་དེའི་ལུང་གི་བརྒྱུད་རིམ་དུའང་མཆིམས་མེད་པ་བཞིན་ནོ།",
    "ཡང་མཚན་ཉིད་ལམ་རིམ་ཆེན་མོར།",
    "ཉེས་པ་ལྔ་སྤོང་གི་སྐབས་སུ།",
    "གཞུང་འདི་དང་འབྲེལ་ཞིང་གྲགས་མི་ཆེ་བའི་རང་གི་མཐོང་ཐོས་དག་གིས་ཟུར་བརྒྱན་ཅིང་ལུང་ཁུངས་དག་བཙལ་ཅིང་པར་གཞི་དག་བསྡུར་ནས་བྲིས་ན་བསྐྱར་བཟླས་ཀྱི་ཉེས་པ་ཆུང་ལ།",
    "མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གི་ལམ་རིམ་ཆེན་མོ་ལྕགས་པོར་གཞིར་བཞག་སྟེ་ཨང་གྲངས་དགོད་པར་བགྱིའོ།",
    "རྒྱུ་དང་ཁོ་རེ་ཡ་གང་གི་བཙུན་པ་ཡིན་མིན་དང་།",
    "བདག་ཅག་གི་སྟོན་པའི་འཁོར་དུ་བྱོན་པའི་རྗེ་བཙུན་བྱམས་པ་ནི།",
    "ཉོན་མོངས་པ་མ་སྤངས་ན།",
    "ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞག་པ་བཞིན་དུ་ལུས་གསེར་གྱི་ཁ་དོག་དང་འོད་ཟེར་དམར་བོ་ཉི་མ་བརྒྱ་སྟོང་བས་ལྷག་སྟེང་གི་དགའ་ལྡན་གྱི་གནམ་དུ་ཞེས་སོ།",
    "འཇམ་དཔལ་གྱིས་འོད་སྲུངས་ཆེན་པོར་ཁྱོད་བགྲེས་པས་སྔོན་དུ་བྱོན་གསུངས་པར།",
    "སློབ་དཔོན་འཇིག་རྟེན་འདི་ནས་གཤེགས་ཏེ་ད་ལྟའི་བར་དུ་མི་ལོ་བརྒྱ་ཙམ་སོང་།",
    "འཇམ་དཔལ་རྩ་རྒྱུད་དང་གནས་བརྟན་པའི་སྟོན་པའི་འདས་ལོ་ལྟར་ན་ལོ་ཉིས་བརྒྱ་ལྷག་འགྲོ་དགོས་པར་སྣང་མོད།",
    "གཙང་གི་དགེ་ཕུར་འཁྲུངས་པའི་ཤཱཀྱ་བློ་གྲོས་ཀྱིས་བསྒྱུར་པ་མཇུག་བྱང་དུ་གསལ་མོད།",
    "དེ་ལྟར་ན་འཇམ་དཔལ་རྩ་རྒྱུད་ཀྱང་ཁྲི་སྲོང་གི་དུས་སུ་བསྒྱུར་པས་རྙིང་རྒྱུད་དུ་ཁས་ལེན་དགོས་པར་འགྱུར་ཡང་།",
    "ཕྱི་མོར་དེའི་དོད་དུ་གང་མཆིས་འཚོལ།",
    "ཉི་ཧོང་གི་མཁས་པ་ཁ་ཅི་ཡ་མ་ཡུའུ་ཨི་ཆིས་མཛད་པའི་རྒྱ་གར་གྱི་གཏན་ཚིགས་རིག་པའི་ངོ་བོ་ཞེས་བྱ་བ་ལས།",
    "དགའ་ལྡན་པར་རྙིང་དང་འབྲས་ཧོར་པར་མའི་ལམ་རིམ་ཆེན་མོ།",
    "སྐུ་འབུམ་དང་བཀྲས་ལྷུན་པར་རྙིང་གི་ལམ་རིམ་ཆུང་བ་བཅས་སུ་འབྲེལ་སྒྱུར་ཡོད་པ་ལེགས་ཤིང་།",
    "དེ་ལས་གཞན་པའི་ལམ་རིམ་ཆེན་མོའི་པར་མང་བོར་བྱེད་སྒྲར་ཡོད་པ་ནི།",
    "དེ་ཡང་བླང་ཞེས་པ་བྱ་ཚིག་ཡིན་པ་ལ་བསམ་མོད།",
    "སྤྱིར་ལམ་རིམ་ཆུང་བ་ལས་ལམ་རིམ་ཆེན་མོ་འཕྲིན་ལས་རྒྱུགས་ཆེ་ཞིང་གསུང་འབུམ་ལས་ལོགས་སུ་རང་རྒྱུ་བའི་པར་མང་དུ་ཐོན་པར་བརྟེན།",
    "བྲམ་ཟེ་མ་ཐ་རའི་བུ་མོ་ཤཱ་རི་ཞེས་བྱ་བ་ཐོབ་ནས་ཞེས་ཤཱ་རིའི་བུའི་ཐད་དུ་འབྱུང་ལ།",
    "སྤྱི་ལོ་༦༣ལོ་ཙམ་དུ་རྒྱ་གར་དུ་སླེབས་པའི་ཐང་སན་ཙང་གི་ལམ་ཡིག་ལས།",
    "གཙུག་ལག་ཁང་ཆེན་མོ་དེར་དངོས་སུ་སློབ་སྦྱོང་གནང་ཞིང་།",
    "བྲི་ཀ་མ་ལ་ཤཱི་ལ་གོ་པཱ་ལ་ཟེར་བ་ཞིག་གིས་བཞེངས་པ་བོད་ལ་གྲགས་ཚུལ་དང་།",
    "སྤྱི་ལོ་༡༢༣༦ལོ་ཙམ་ལ་ཆག་ལོ་བོད་དུ་ཕེབས་སྐབས་ཨོ་ཏནྟ་དང་འདི་གཉིས་ཁ་ཆེའི་དམག་གིས་གཏོར་ཚར་བས།",
    "ཞེས་ཡོད་མོད།",
    "རྗེ་བཙུན་བྱམས་པས་མཛད་པར་ཉི་སྣང་དང་རྣམ་འགྲེལ་ན་མི་གསལ་ཡང་སེང་བཟང་གི་གཞུང་དུ་ཐོག་མར་འབྱུང་ཞིང་།",
    "མཆོག་གི་འདོད་པའི་ལྷའོ།",
    "གསང་སྔགས་བཟླས་བརྗོད་ཀྱི་མན་ངག་ནམ་མཁའ་ལྡིང་གི་རྒྱལ་བོ་རྡོ་རྗེ་སྒྲུབ་ཐབས།",
    "ཕྱག་རྡོར་ལ་མཚན་ཉིད་བསྡུས་པའི་སྒོ་ནས་བསྟོད་པ་སོགས་མཛད་དེ་རྒྱ་བརྩོན་སེང་གིས་བསྒྱུར་ཡོད།",
    "ཞེས་པའི་འཕྲོར་ཕྱི་མོར།",
    "ཀྱེ་མ་བརྒྱ་བྱིན་ཁྱོད་ནི་བསྟན་པ་ལས་ཕྱི་རོལ་ཏུ་གྱུར་པའོ།",
    "གང་གི་ཚེ་དེ་ཉིད་ཚེས་གསལ་བར་གྱུར་ཏེ་ཕྱི་རོལ་ཀྱི་དོན་མི་སྣང་བའི་ཤེས་པའི་སྣང་བ་བྱུང་བ་དེའི་ཚེ་རྣམ་པར་ཤེས་པ་ཙམ་ལ་གནས་པའི་ཕྱིར་ངེས་པར་འབྱེད་པའི་ཆ་དང་མཐུན་པ་བཟོད་པ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "ཨོ་ཏནྟ་པུ་རིའི་གཙུག་ལག་ཁང་གི་ཤུལ་ད་ལྟ་རྙེད་མེད་ལ།",
    "སོ་མ་པུ་རིའི་གཙུག་ལག་ཁང་གི་ཤུལ་ནི་སྤྱི་ལོ་༡༩༢༧ལོར་ཤར་བྷང་ག་ལའི་པུ་ཧཱར་པུར་རྡོ་སྐོས་ཡི་གེ་རྙེད་པ་ལས་གནས་དེ་ཡིན་པར་ངེས་པ་རྙེད་ཡོད།",
    "༥ དེ་ནས་ལོ་སུམ་ཅུ་རྩ་གཅིག་གི་བར་དུ་ཞེས་པས།",
    "ཞེས་པ་ཉན་ཐོས་དང་ཐུན་མོང་བའི་སོ་ཐར་སྡོམ་པའི་སྒོར་ཞུགས་པའི་དོན་ཏེ།",
    "ཐུན་མོང་སོ་སོར་ཐར་བའི་སྒོར་ཞུགས་ནས།",
    "༦ རྔ་མ་རེ་རེ་ཞེས་པར།",
    "འབྲས་ཧོར་པར་མ་བཅས་སུ་རྔ་མ་ཉག་མ་རེ་རེ་ཞེས་ཡོད་ལ།",
    "བཀྲས་ལྷུན་པར་རྙིང་དང་སྐུ་འབུམ་རེབ་གོང་ལྕགས་པར་བཅས་སུ་ཉག་མ་ཞེས་པ་མེད།",
    "གང་ཞིག་གཡག་རྔའི་རྩེ་མོ་ལྟར།",
    "རང་གི་སེམས་ནི་རྗེས་སྲུང་ཞིང་།",
    "སྔོན་དུས་ཀྱི་རྒྱ་གར་ཡུལ་ག་གེ་མོ་ཞིག་ན་གཡག་ཡོད་པར་མ་ཟད།",
    "ཆུ་ལ་བགྲོད་དུས་གཡག་གི་རྔ་མར་འཇུས་ཏེ་འགྲོ་བར་གསལ་བའི་ཕྱིར།",
    "སྔགས་ལུགས་ཀྱི་ཀུན་སྤངས་པའི་མིང་ཡིན་མོད།",
    "ཁྱོད་ནི་གསང་སྔགས་རྣལ་འབྱོར་བ།",
    "མུ་སྟེགས་ཅན་དག་གི་ཀུན་ཏུ་སྤྱོད་པ་ནི་ནངས་པར་སྔར་ལངས་ཏེ།",
    "ཆུ་ངོགས་སུ་རེག་པའི་ཕྱིར་འགྲོ་བ་ཡིན་པས་ཞེས་དང་།",
    "འདིའི་དགེ་སློང་ཞེས་པ་དགེ་ཚུལ་སློང་གི་ཚིག་སྡུད་དུ་བྱེད་དགོས་ལ།",
    "ལྷ་མོ་སྒྲོལ་མ་ཉི་ཤུ་རྩ་གཅིག་ལ་བསྟོད་པ་རྣམ་དག་གཙུག་གི་ནོར་བུ་ཞེས་བྱ་བ།",
    "སློབ་དཔོན་ཆེན་པོ་སཱུརྱ་བུདྡྷའི་ཞབས་ཀྱིས་མཛད་པ་རྫོགས་སོ།",
    "ཇོ་བོ་རྗེ་བོད་དུ་བྱོན་ནས་རྒྱ་བརྩོན་སེང་གི་འཁྲུངས་ཡུལ་མྱང་རོ་སྟག་ཚལ་དུ་ཕེབས་སྐབས།",
    "མངའ་བདག་ཁྲི་བཀྲ་ཤིས་མགོན་གྱི་སྲས་འཁོར་རེ་དང་།",
    "མང་ཐོས་པ་སོགས་ཀྱིས་འཁོར་རེ་དང་སྲོང་ངེ་གོ་ལྡོག་པའང་ཡོད་ལ།",
    "སྐུ་ཚེ་སྟོད་དུ་སྲིད་བསྐྱངས་ཤིང་བཙུན་མོ་ཆེན་ཆུན་གཉིས་ལ་སྲས་པ་གཉིས་དང་སྲས་མོ་གཅིག་འཁྲུངས།",
    "དེབ་སྔོན་པས་རབ་ཏུ་བྱུང་ཡུལ་མ་རྙེད་པས་རང་རྟགས་རང་གིས་བླངས་གསུངས།",
    "དེ་ནས་ས་མོ་ལུག་གི་ལོ་ལ་མཐོ་གླིང་གཟིམ་ཁང་དུ་ཞི་བར་གཤེགས་པའི་ཚུལ་བསྟན་མོད།",
    "མ་ཚུགས་ཏེ་རེ་ཞིག་དེ་ཉིད་དུ་བཞུགས་སོ།",
