    "ཏིང་ངེ་འཛིན་དང་རང་གསལ་གྱི་གཟུངས་དང་།",
    "ཉི་མ་དགུ་ཤར་འབུམ་གཉིས་གཏེར་ཁུངས་གཅིག་མིན་ཙམ་ལས་ཤིན་ཏུ་གཅིག་པ་འདུག་གཤིས་དེ་ལུགས་ཞིབ་དཔྱད་གནང་མཁན་རྣམས་ཀྱིས་རྗེས་སུ་ངེས་གལ་ཆེ་ཞེས་ཞུ།",
    "ལར་ནས་མ་དཔེ་དེའི་ནང་དུ་ནོར་འཁྲུལ་ཆད་ལྷག་ཇི་སྙེད་ཅིག་འདུག་པས་མངོན་གསལ་དོད་པོའི་རིགས་རྣམས་བཅོས་པ་མ་གཏོགས་གཞན་བཅོས་མ་བདེ་བའི་དོགས་གཞིའི་རིགས་རྣམས་འོལ་ཚོད་ཀྱིས་བཅོས་ན་དཔེ་དེབ་པར་སྐྲུན་བྱེད་པའི་དགེ་ལས་སྐྱོན་ཚབས་ཆེ་བར་བསམས་ནས་རང་གསོར་བཞག་པ་ཡིན།",
    "བཀའ་དྲིན་ཆེན་པོའི་སྒོ་ནས་རྗེས་བཟུང་སྟེ་ མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "གལ་ཏེ་མི་འགྲོ་འདུག་གྱུར་ན།",
    "རང་རང་སྐལ་བར་འཚམས་པའི་འདོད་འཇོ་མཁན།",
    "སླར་ཡང་རང་བདེ་དག་པའི་ཞིང་།",
    "རང་རང་གཟུགས་ལ་བརྟན་པར་མཛོད།",
    "རང་རང་དུག་ལ་ངོས་ལེན་མཛོད།",
    "སྔགས་འདིས་སྨྱུག་མར་ཕུ་རྒྱག་པ་སོགས་ནི་མི་བྱེད་འདུག་དེ་རྗེས་ཀྱི་སྔགས་བི་འོང་ཟེར་བ་འབི་འོང་ལྟ་བུ་ཟེར་བ་འདྲ།",
    "འཛབ་ལྟ་བུ་དབྱེ་བ་མི་ཕྱེད་གཅིག་འདོན་འདུག།",
    "སྔགས་འདི་འདྲའི་རིགས་ཀྱི་ག་དང་ད་ཕལ་ལ་འགའ་དང་མདའ་དང་ཟེར་བ་འདུག།",
    "འདར་བ་འདུག་སུམ་རྐྱང་བའི་འཆི་རྩ་ཡིན།",
    "དུས་ནི་ཉི་མདངས་ཐོག་མར་འཕོག་དུས་དང་།",
    "ཀུ་ཡ་སྤྲིས་མ་ལྡོག་དུས་ལྡོག་ཚུལ་དང་།",
    "ལྡོག་དུས་གྲང་ཆུ་རླངས་ཡལ་རྗེས་ལ་ལྡོག།",
    "ལྡོག་དུས་སྣོད་གཏིང་འབུར་གཤོང་བྱ་བ་ཡིན།",
    "སྣག་ཚ་ཆད་འདྲ་འདུག་སྟེ་སོ་སོ་དབྱེ།",
    "གོས་ཀྱི་བཏུམ་སྟེ་ཙོག་པུར་འདུག་པར་བྱ།",
    "ཙོག་པུར་འདུག་ལ་སྣོད་དུ་བཏང་བར་བྱ།",
    "སྐར་མ་བཀྲག་དུས་བླངས་པའི་ཆུས།",
    "ཞེས་བྲིས་པའང་འདུག་པས་གང་དག་དཔྱད།",
    "ཐ་མ་རྒྱ་ཤལ་སྐྱུག་དུས་གུར་གུམ་དང་།",
    "གུ་གུལ་དངུལ་ཆུ་གཡེར་ཤིང་རང་ཤི་རུས།",
    "མི་བྱེར་བསྡུ་ཞིང་རང་གནས་སྨིན་པར་བྱེད།",
    "རང་རང་ལེའུ་བཞིན་དུ་བཅོས་པས་འཚོ།",
    "འཚོ་བྱེད་རྣམས་ཀྱང་རང་ལ་འགོ་དོགས་ནས་ བཅོས་མི་ཕོད་ཀྱང་ཕུག་ལྟར་སྡོད་པར་འགྱུར།",
    "ལྷ་དོང་གྲ་ཟེར་བའང་འདུག་སྐྱ་རྒྱ་ཚ་གོ་ཡུ་བདུན་སྦྱོར་ཏེ།",
    "སྤྱོད་ལམ་དལ་བ་འདུག་དང་ཉིན་གཉིད་ལོག།",
    "ཇི་ལྟར་བྱུང་ཡང་རང་གནས་སྨིན་པ་ཡིན།",
    "འཐུང་ནས་འགྲོ་འདུག་ནུས་ཚད་བྱ།",
    "དང་པོ་མཚོན་ཕོག་དུས་ནས་༧ སྐྱབས་མགོན་དགྱེས་རབ་རྡོ་རྗེའི་གསུང་འབུམ་པོད་ལྔ་པ།",
    "ཞལ་གདམས་ཚུལ་བཞིན་ཤེས་མཁན་ཆེར་མི་འདུག།",
    "ཞག་གཅིག་བཞག་ལ་དྭངས་སྙིགས་བྱེ་འདུག་ན།",
    "དེ་ནས་རྩ་ལྷག་འདུག་ན་གདོན་རྩ་སྟེ།",
    "རྩ་ལྔ་འདུག་ན་དང་པོ་གདོང་རྩི་དང་།",
    "དེ་སྟེང་རང་ཐག་ཡ་ལོ་དར་བུས་གཞག།",
    "ཞག་གསུམ་སྔོན་ནས་བཏང་ཞིག་དལ་བར་འདུག།",
    "བཞུགས་པ་ནི་འདུག་པའོ།",
    "སྒོར་འདུག་པ་བདེན་ནམ་ཁྱེཞེས་བྱ་བའི་བར་ནི་བཅོམ་ལྡན་འདས་ཀྱིས་འཇམ་དཔལ་དབྱངས་ལ་འདྲི་བའོ།",
    "མུན་རུམ་གྱི་ནང་ན་བུམ་པ་ལ་སོགས་པ་འདུག་པ་བཞིན་ནམ།",
    "གནས་པ་ཞེས་བྱ་བ་ནི་འདུག་པ་སྟེ།",
    "དེ་ལ་དམིགས་ཤིང་འདུག་ཅེས་བྱ་བའི་བར་དུ་ཡིན་ནོ།",
    "སྤྱིའམ་བློ་ལ་གཟུགས་བརྙན་དུ་འདུག་པ་ཞིག་ཡིན་གྲང་།",
    "དུས་ཐམས་ཅད་དུ་ཆ་ཤས་དང་བཅས་པར་འདུག་པ་ཡིན་ནོ།",
    "ཡོན་ཏན་གང་དག་ཡིན་པ་གཉེན་པོ་གོམས་པ་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པར་འགྱུར་བ་སྟེ།",
    "སྒྲའི་དོན་མེད་དུ་ཟིན་ཀྱང་རང་བཞིན་ལ་གོ་འགལ་བ་ཅི་ཡོད་ཅེ་ན།",
    "ཞི་བ་འདི་གཉིས་ཀྱི་ནང་ན་ཤིན་ཏུ་ཞི་བར་འདུག་པ་ཡིན་ནོ་ཞེས་བྱ་བས་ནི་འདི་ཞི་བ་ཉིད་དུ་ངེས་པ་དང་།",
    "འདུག་གོ་ཞེས་བདག་རྣམ་པར་རྟོག་པར་གྱུར་ན།",
    "ཕྱི་མའི་མཐར་འདུག་པ་མ་ཡིན་ན་སྔོན་གྱི་མཐའ་ནས་མ་ཡིན་ཞེས་བྱ་བ་དེ་རིགས་པ་མ་ཡིན་ནམ།",
    "མ་བགྱིས་པ་ནས་མ་འགགས་པའི་བར་ནི་མཉམ་པ་ཉིད་དུ་འདུག་པ་ཡིན་ཏེ།",
    "བར་དུ་ཞེས་སྨོས་པས་ཐོག་མ་ནས་ཞི་བ་དང་རང་བཞིན་བྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ཉིད་ལ་སོགས་པའི་རྣམ་པ་རྣམས་གཟུང་ངོ།",
    "རྟག་པར་དུས་ཐམས་ཅད་དུ་འདུག་པའི་ངོ་བོ་ལ་བྱེད་པ་མེད་དོ་ཞེས་སྦྱར་རོ།",
    "གཞན་ཡང་རུང་བ་དེ་བཞིན་གཤེགས་པ་དེ་བཞུགས་པ་དེར་དགའ་བ་དང་གུས་པ་བསྐྱེད་ནས་ཕྱོགས་དེར་མངོན་དུ་བལྟས་ཏེ་འདུག་པར་བྱའོ།",
    "འོན་ཀྱང་དེ་དག་ལ་འདི་སྐད་ཅེས་ཡོན་ཏན་བསམ་གྱིས་མི་ཁྱབ་པ་ཡོངས་སུ་བསྒྲགས་པ་འདི་ཡང་དག་པར་ཟུང་ལ་འདུག་ཅིག་དང་ཞེས་བྱ་སྟེ།",
    "ཡང་ན་ཡིད་མ་གཏོད་ཅིག་ཅེས་བྱ་བ་ནི་མཉན་ཏོ་སྙམ་དུ་དེ་ལྟར་མ་འདུག་ཅིག་ཅེས་བྱ་བ་ཡིན་ནོ།",
    "གཞུང་ལུགས་དེ་དག་དུས་ཕྱིས་གདམས་ནས།",
    "སེམས་ཀྱི་ལམ་ཁྱེར་བསྟན་པ་ཞེས་ཚིག་རྐང་བཞི་ཡོད་པས་ཡི་གེ་བཞི་ཡོད་པས་ཡི་གེ་བཞི་པར་བསྙད་པར་འདུག།",
    "དེ་ཀུན་ཀྱང་ཡིན་ཏེ་རྟོགས་པ་གཤའ་མ་ཞིག་ད་ནས་ལོ་ལྔ་ལ་འཆར་བ་འདུག་གསུང་།",
    "རིམ་གྱིས་པ་སྐྱེས་བུ་གསུམ་གྱི་ལམ་རིམ་གྱིས་འཁྲིད་པ་ལ་བལྟ་བར་འདུག་ཅེས་གསུངས་པས་ཆུ་བོ་གཉིས་ནི་དེ་ཡིན་ལ།",
    "ཡང་ཕག་གྲུས་ལམ་འབྲས་ཏེ་གཞན་གྱི་གདམས་ངག་སྒོམ་བཞིན་པར་འདུག་པའི་ཕྱིར་རོ་ཞེས་པའོ།",
