    "བདག་གི་ཕུང་པོ་ལྔ་པོ་འདི་དངོས་མེད་སྟོང་པར་མཛད་དུ་གསོལ་ཞེས་སྦྱང་ངོ།",
    "དེ་༧མོ་བདུན་། ལྟར་མཛད་པའི་སྒོ་ནས་ད་རེས་ཀྱི་ཚེ་ཐུང་འདི་ལ་བདག་འཛིན་གྱི་འགོང་པོ་འདི་ཅི་ཐུལ་ཞིག་མཛད་འཚལ་གསུངས།",
    "བདག་གི་ཕྱོགས་ན་དམག་དཔུང་ཆེ་བ་གཅིག་ཡིན་པས།",
    "ཚུལ་དེ་ལྟར་ད་རེས་རང་གཞན་གཉིས་ལ་དགྲ་ཟིན་གཉིས་སུ་ཕྱེ་ལ་སྦྱང་ངོ།",
    "རེས་རང་ལ་དགྲ་ཟིན་གཉིས་སུ་ཕྱེ་ལ་སྦྱངས་ཏེ།",
    "རང་དོན་བསྒྲུབ་པའི་བསམ་སྦྱོར་ལ་སྐྱ་མིང་དག་གིས་བཏགས།",
    "ཁྱོད་ཆ་ཡོད་ཀྱི་བྱས་ལ་ཕག་སྣ་རེ་ལ་གཏུན་པོ་རེ་རྒྱབ་ལ་བཏང་གསུངས།",
    "བྱམས་པའི་མིག་གིས་བལྟ་བལྟ་བ།",
    "དེ་ལྟར་བསྒོམས་པས་མི་མ་ཡིན་ལ་ལས་ཀྱི་བྱས་པའི་མངོན་ཤེས་ཕྲ་མོ་ཡོད་པས།",
    "འོ་ཅག་གིས་མར་ཤེས་པ་ཙམ་གྱིས་ཁོང་གིས་བུར་ཤེས་ནས་འོང་།",
    "རང་གི་ཡང་ཚེ་མཇུག་དང་སྐྱེ་བ་ཕྱི་མ་ལ་སྨིན་རྒྱུའི་ལས་ངན་ཐམས་ཅད་ད་ལྟའི་ན་ཚ་འདི་ཉིད་ཀྱི་སྟེང་དུ་བླངས་ལ་དགའ་བ་བསྒོམ་མོ།",
    "ཁྱོད་ཀྱིས་ངའི་མ་བྱས་པ་གྲངས་ཀྱི་ནི་མི་ཆོད།",
    "ངས་ཁྱོད་ཀྱི་ཤ་ཟོས་པ་དང་།",
    "འཕྲོག་པ་ཡང་གྲངས་ཀྱིས་མི་ཆོད་པ་བྱས་པས་དེའི་ལན་ཆགས་ད་རེས་སྙེག་ཏུ་བྱུང་བ་ཡིན་པས།",
    "དེ་ཐམས་ཅད་ཀྱི་དྲིན་དང་ལན་ཆགས་ད་རེས་ཁྱེར་བར་བྱ།",
    "དེ་ནས་མི་མ་ཡིན་པ་དེ་ཀོག་གིས་ལངས་ནས་བྱུང་ནས་བདག་གི་སྤྱི་བོ་ནས་རྐང་མཐིལ་ཡན་ཆད་ཁ་དམར་འདག་འདག་ཟོས་པས་གནས་སྐབས་སུ་ལུས་འགྲངས་ཏེ།",
    "ཡང་སྐད་ཅིག་གིས་ནང་དུ་ལུས་གྲུབ་ཅིང་ཡང་ཟོས་པར་བསམ།",
    "ཁྱད་པར་དུ་མི་མ་ཡིན་ཡོད་སར་ལུས་འདི་སེམས་ཀྱིས་བོར་ལ་དེར་དམར་ཉོག་རྩེར་གཏུབ་ལ་ད་ཟོ་ཞིག་ཅེས་བསམ་མོ།",
    "གླང་རི་ཐང་བའི་ཞལ་ནས་ཀྱང་ཇི་ལྟ་བུའི་པོ་ཏི་ཟབ་མོ་ཞིག་ཞལ་ཕྱེ་ཡང་།",
    "སྐྱོན་ཐམས་ཅད་རང་གི་ཡིན།",
    "གྱོང་དང་བུབ་ཁ་རང་གིས་བླང་སྙམ་དུ་སེམས་པ་དེ་མིན་པ་གོ་བརྒྱ་གཞན་མ་རྙེད་གསུངས།",
    "ད་ལྟ་འཁོར་འདས་གནོད་བྱ་གནོད་བྱེད་ལ་སོགས་པ་ཕྱི་ནང་སྣོད་བཅུད་དུ་སྣང་བ་འདི་ཐམས་ཅད་ནི་རང་གི་སེམས་ཉིད་འཁྲུལ་པའི་སྣང་བ་འབའ་ཞིག་ཡིན་པར་ཐག་ཆད་ཀྱིས་བཅད།",
    "དགག་སྒྲུབ་བྱ་ལོང་མེད་པར་སྐད་ཅིག་གིས་འགགས་པས་ཀུན་རྫོབ་ཙམ་དུ་ཡང་གནོད་བྱ་གནོད་བྱེད་དུ་གྲུབ་པ་མེད་དོ།",
    "རང་གི་སེམས་ཉིད་བདུད་ཅེས་བྱ།",
    "རང་གི་སེམས་ཉིད་གེགས་ཞེས་བྱ།",
    "དེ་ལྟར་རང་གི་རྟོག་པ་ཡོད་པར་བཟུང་།",
    "དེས་ན་ཐམས་ཅད་རང་གི་རྟོག་པ་ལས་ཕྱི་རོལ་ན་བགེགས་སུ་གྱུར་པ་མེད་པས་སྤང་།",
    "བྱ་རང་གི་རྟོག་པ་ཙམ་པོ་དེ་ཉིད་ཡིན་ནོ།",
    "དེ་ལྟར་དཔྱད་ན་རང་གི་སེམས་སུ་འདུས་པས།",
    "རུས་སྦལ་སྤུའི་ཞགས་པ་དམ་པོས་བཅིངས་པ་བཞིན་དུ་སོང་ནས་འདུག་སྟེ།",
    "ང་རང་གི་རྟོག་པས་བཅིངས་ནས་སྡུག་བསྔལ་ལ་འཁྲུལ་ནས་འདུག་པ་སྙམ་དུ་བསམས་ལ།",
    "ན་ཚ་དྲག་ཏུ་རེ་བ་ལ་སོགས་པའི་རེ་དོགས་དང་།",
    "རང་གི་སེམས་སུ་འདུག་པས།",
    "འཆར་ལུགས་ཡིན་སྙམ་དུ་རང་གི་སེམས་སུ་ཐོག་བཅད་ལ་བཞག་གོ།",
    "ཤུགས་ལ་རེ་དོགས་གཅོད་པའི་ལྟ་བ་འདི་ལྟར་བསམ་མོ།",
    "གཞན་ཡང་གནོད་བྱེད་འདིས་བདག་ལ་སྐྱེ་བ་སྔ་མའི་ལས་ངན་གྱིས་ཕྱི་མ་ལ་ངེས་པར་ངན་སོང་དུ་སྐྱེ་བ་གཅིག་གི་སྡུག་བསྔལ་འདིར་དྲངས་པས་ངན་སོང་གི་གདང་ཁ་བཟུང་ནས་འདུག་པས་འདི་དྲིན་རེ་ཆེ་སྙམ་དུ་བསམ།",
    "ན་ཚ་སྡུག་བསྔལ་ལ་ཡོན་ཏན་དེ་ཙམ་ཡོད་པར་བལྟ་ལ་དེ་ལྟར་བསམ་མོ།",
    "གཞན་ཡང་ན་ཚ་སྡུག་བསྔལ་འདིས་བདག་ལ་ངེས་འབྱུང་གི་བློ་བསྐྱེད་པར་འདུག་སྟེ།",
    "འོ་ན་སྡུག་བསྔལ་འདིས་བདག་གི་སྡུག་བསྔལ་ཐམས་ཅད་སེལ།",
    "ཁྱོད་སྡུག་བསྔལ་དང་བྲལ་བའི་བདེ་བ་འདོད་ན་བདེ་བ།",
    "སྐྱེ་བོའི་སྦྱིན་གཏོང་རྒྱ་ཆེ་བར་བྱས་ལ་རེ་དོགས་འགོག་པའི་གསོལ་བ་བཏབ་སྟེ།",
    "བདག་གིས་ནི་མི་ཤེས་པས་ཁྱོད་ཀྱི་ཇི་ལྟར་ལེགས་པར་མཛོད་ཅིག་ཅེས་དགའ་དུང་པའི་གསོལ་བ་བཏབ་སྟེ།",
    "བདག་གི་བདེ་བ་བསྒྲུབ་པ་དང་སྡུག་བསྔལ་སེལ་བའི་གྲོགས་བྱས་པས་བཀའ་དྲིན་ཆེ་སྟེ།",
    "ཁྱོད་གཞན་དུ་མི་གཤེགས་པར་བདག་གི་ལུས་འདི་ལ་ཞུགས་ལ།",
    "ལུས་སེམས་བདེ་འབོལ་བཏང་ལ་རེ་དོགས་དང་བདེ་འདོད་ཀྱི་རྟོགས་པ་ཆད་ཀྱིས་བཅད་ལ་བཞག་གོ།",
    "དེ་ཐམས་ཅད་བློས་འུབ་ཀྱིས་རང་གི་སྡུག་བསྔལ་དེའི་སྟེང་དུ་བླངས་པས།",
    "སྡུག་བསྔལ་དེ་དག་གཞན་ལ་འདུག་པ་མཐོང་བའི་འཕྲོ་ལ་ཡང་རང་གི་འཕྲལ་ལ་བླང་བར་བྱའོ།",
    "ཡང་ཆགས་སྡང་གིས་ཉོན་མོངས་པ་དྲག་པོ་སྲན་མི་བཟོད་པ་སྐྱེས་པ་ན་ཡང་སྔ་མ་བཞིན་བསམ་ལ་གཞན་གྱིས་བླང་ངོ།",
    "དེ་འཕྲོ་གཞན་དེ་དག་སྡུག་བསྔལ་རྒྱུ་འབྲས་གཉིས་དང་བྲལ་ནས་བདེ་བ་དང་ལྡན་པར་བསམ་མོ།",
    "བཞི་པ་ཚེ་གཅིག་གི་ཉམས་ལེན་དྲིལ་ནས་བསྟན་པ་ནི།",
    "དགོས་ངན་སོང་གསུམ་དུ་ཇི་ལྟ་བུ་འཁྱམས་ཏེ།",
    "བདག་གི་བདེ་བའི་ལམ་སྣ་དྲང་དུ་གསོལ།",
    "ད་ནི་ཁྱེད་རང་ལ་རེ་བ་ཡིན་ནོ།",
    "དེ་ནས་འཆི་ཁར་སོང་བ་ན་ངོས་གཡས་པ་ཕབ།",
