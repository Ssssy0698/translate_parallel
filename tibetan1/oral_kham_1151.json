    "མི་དེ་ཡིན་ན་དབྱི་རིལ་མས་ཟིན་པ་འདྲ་པོ་འདུག།",
    "ང་རང་འཁྲིས་ལ་ཡོད་ན་ཁྱེད་ཀྱི་གདོང་ལ་ལྟ་ཡག་བྱེད་ངེས།",
    "ང་རང་ནི་གཅིག་ནས་བློ་ཁོག་མེད་པ་དང་།",
    "གཉིས་ནས་བོད་ཀྱི་སྤྱི་མཚུངས་ཀྱི་འཐབ་རྩོད་དང་ལས་འགུལ་དེ་འདྲ་མང་པོའི་ནང་མཉམ་ཞུགས་ཐུབ་ཀྱི་མི་འདུག་སྟབས།",
    "འགའ་ཞིག་བོད་རྒྱལ་ཡོངས་མང་གཙོ་ཚོགས་པ་ནས་གོ་སྒྲིག་བྱས་པ་ཞིག་ཡིན་འདུག།",
    "ཟས་བཅད་ངོ་རྒོལ་མང་ཤོས་བྱེད་ཡུལ་ནི་ཨིན་ཇི་གཞུང་ཡིན་འདུག་པ་དང་།",
    "ཟས་བཅད་ནས་དུས་ཡུན་ཀྱང་རིང་པོ་སྡོད་མི་བཅུག་པ་ཡིན་འདུག།",
    "དེའི་ཤུགས་རྐྱེན་ཇེ་ཆེར་འགྲོ་ངེས་ཡིན་པར་བསམ་བཞིན་ཡོད་འདུག།",
    "གོ་འཇོ་ཀརྨ་བསམ་གྲུབ་ཀྱིས་ལོ་མང་རིང་གཙོད་ལ་སོགས་པའི་རི་དྭགས་རྔོན་མཁན་ལ་ཁ་གཏད་དྲག་པོ་གཅོག་འདུག་པས།",
    "དེའི་ནང་༢༧ ལོར་རྒྱ་ནག་ཉེན་རྟོག་པས་ནང་པ་ལར་བོད་པ་བྲོས་བྱོལ་བར་མེ་མདའ་བརྒྱབ་ནས་བསད་པའི་སྐོར་གྱི་གནས་ཚུལ་ཞིག་འདུག།",
    "ཁྱེད་ཀྱི་ཟིན་བྲིས་ནང་ཀརྨའི་སྐོར་མང་པོ་བྲིས་འདུག་པ་ངས་སྔར་ནས་བལྟས་པ་ཡིན།",
    "སྤྱིར་ཀརྨའི་སྐོར་རྒྱ་ཡིག་ནང་མང་པོ་ཡོད་འདུག་པ་དང་།",
    "རིག་རལ་ལ་ཞུ་རྒྱུ་གཅིག་བརྗེད་འདུག།",
    "དེང་སང་དབུས་གཙང་ནས་ཀྱང་གཏེར་ཁ་སྔོག་མཁན་ལ་ངོ་རྒོལ་བྱེད་ཀྱིན་འདུག།",
    "མི་མང་པོ་རྨས་མཐར་དམག་མི་བབཏང་ནས་དྲག་གནོན་བྱས་འདུག་པ་དང་།",
    "ཀརྨ་བསམ་གྲུབ་སྐད་ནས་ངོ་ཤེས་པ་མ་གཏོགས་ལུས་དང་གདོང་ནས་ངོ་ཤེས་ཐབས་བྲལ་འདུག།",
    "ཁོ་རང་ལ་འགྱུར་ལྡོག་གང་ཡང་མི་འདུག།",
    "ཞེས་འགྲེལ་བརྗོད་བྱས་འདུག།",
    "གཟི་བརྗིད་འདྲ་ཞིག་འདུག་ཟེར། རིག་རལ་ལགས།",
    "དེ་གཉིས་ཇི་ལྟར་བྱས་ཏེ་འཆམ་མཐུན་ངང་གནས་ཐུབ་པའི་གནས་ལུགས་ཤིག་འཚོལ་གྱིན་ཡོད་འདུག།",
    "རྒྱ་ནག་ནས་བོད་ལ་ཡར་དབོར་འདུག་དང་བོད་ནས་རྒྱ་ནག་ལ་མར་དབོར་འདྲེན་བྱས་འདུག།",
    "ངས་བྱེད་ཐུབ་པ་གང་ཡང་མི་འདུག།",
    "ར་ཤི་ཡ་སོགས་ནས་ཀྱང་རོགས་པ་ཤུགས་ཆེར་བྱེད་བཞིན་འདུག།",
    "ཕལ་ཆེར་ཁང་པ་གཅིག་ཀྱང་ལྷག་ཡ་ཁག་པོ་ཡིན་འདུག་ཀྱང་།",
    "ཁོང་ལ་བཙན་ཤེད་ཀྱིས་ནག་ཉེན་ངོས་ལེན་བྱེད་བཅུག་འདུག་པ་དང་།",
    "དོན་གྱི་ཆ་ནས་ཧང་སང་བའི་བྲོ་བ་ཞིག་འདུག།",
    "ཞེས་པའི་དཔེ་ཞིག་ཀྱང་ཡོད་འདུག།",
    "ད་ནི་དགྲ་བོ་དགའ་ཞིང་རང་ཉིད་བརླག་པའི་ལས་ཀ་རྣམས་མཚམས་བཞག་སྟེ།",
    "རྩོམ་པ་པོ་འོད་ཟེར་ད་ལྟ་ཉེན་ཁ་ནང་ལྷུང་འདུག་ཟེར།",
    "དེ་རིང་བོད་ནས་རྒྱ་ནག་བར་ཁྱབ་འདུག།",
    "འདུག་ཐབས་ཡོད་ཀྱང་རྒྱ་མིས་བོད་པ་ཞིག་ལ་གོ་སྐབས་དེ་སྤྲོད་ག་ལ་སྲིད།",
    "གཙོ་བོ་ནི་སྲིད་བློན་ཝུན་ཅ་པའོ་ཡིན་འདུག་པ་དང་།",
    "ཐུ་བྷོད་ལ་དྲུ་གུས་རྒྱབ་སྐྱོར་བྱས་འདུག་ཟེར།",
    "ཁ་སང་ང་རང་ཨ་རིའི་ནང་འཚར་ལོངས་བྱུང་བའི་ཡུ་གུར་བ་ཞིག་དང་ཐུག་པའི་སྐབས།",
    "ངོ་རྒོལ་གྱི་ལས་འགུལ་འདི་ཡུ་གུར་བ་ཚོས་མ་ཤེས་པའི་ཆེད་དྲུ་གུའི་ནང་ལ་བཀག་འགོག་བྱས་འདུག།",
    "དེང་སང་ཡུལ་དེར་གནམ་ཐོག་ནས་རྒོལ་རྡུང་གཏོང་བཞིན་པའི་བྱང་ཨ་ཊ་ལན་ཊིཀ་དམག་དོན་སྤྱི་ཁྱབ་ཁང་ནས་ཀྱང་དགའ་བསུ་ཞུས་འདུག།",
    "གལ་སྲིད་ང་རང་རྒྱ་ནག་གཞུང་ཡིན་ན།",
    "གལ་སྲིད་ང་རང་རྒྱ་ནག་གཞུང་ཡིན་ན།",
    "གལ་སྲིད་ང་རང་རྒྱ་ནག་གཞུང་ཡིན་ན།",
    "གལ་སྲིད་ང་རང་རྒྱ་ནག་གཞུང་ཡིན་ན།",
    "གལ་སྲིད་ང་རང་རྒྱ་ནག་གཞུང་ཡིན་ན།",
    "གལ་སྲིད་ང་རང་རྒྱ་ནག་གཞུང་ཡིན་ན།",
    "གལ་སྲིད་ང་རང་རྒྱ་ནག་གཞུང་ཡིན་ན།",
    "གལ་སྲིད་ང་རང་རྒྱ་ནག་གཞུང་ཡིན་ན།",
    "དེང་སང་ནོར་བ་རྐྱང་རྐྱང་ལས་ཀྱི་འདུག།",
    "ཏང་ཡོན་རྒན་རབས་རྣམས་ལ་ཡང་བརྩི་བཀུར་དང་ཉན་འཇོག་བྱེད་ཀྱི་མི་འདུག།",
    "གལ་སྲིད་ང་རང་རྒྱ་ནག་གཞུང་ཡིན་ན།",
    "ད་དུང་བྱེད་དགོས་པ་མང་པོ་འདུག་པས་རིམ་པས་འབྲི་བསམས་བསྡད་ཡོད།",
    "དེང་མཛེས་མ་དེ་ཚོས་སྡིངས་ཆའི་ཐོག་གོམ་པ་རྒྱག་སྟངས་ནི་ཕྱི་རྒྱལ་གྱི་ལུགས་སྲོལ་ཞིག་ཨི་འཇོན་མི་འཇོན་བྱེད་ཀྱི་འདུག།",
    "ཚགས་ཤོག་ཁག་ནང་མི་མང་པོས་བསམ་ཚུལ་མང་པོ་སྤེལ་འདུག།",
    "བུ་སྐྱེ་ལོ་ལེ་ཞིག་གདའ།",
    "དོན་ལ་བུ་དེ་ནི་སྐྱེ་རིན་ཆོག་པ་ཞིག་འདུག་ཅེས་བརྗོད་པ་སྟེ།",
    "བོད་ཕྱི་ནང་གཉིས་སུ་འཁྲབ་པའི་མི་ལ་རས་པ་སོགས་མང་པོ་ཞིག་བཟོས་ཡོད་པ་སྔ་མ་སྔ་མ་ལས་ཕྱི་མ་ཕྱི་མ་ཇེ་ཡག་ཏུ་ཕྱིན་པ་མི་མང་པོས་གླེང་བཞིན་འདུག།",
    "འཁྲབ་ནས་པར་བླངས་རྗེས་མཐུད་སྒྲིག་བྱེད་སྟངས་བཅས་གསུམ་ནང་འདུས་འདུག་སྙམ།",
    "ང་རང་སྒེར་གྱི་ལྟ་སྣང་མཐོང་ཕྱོགས་ལ་མ་མཛེས་པ་འགའ་ཞིག་ནི།",
    "རྟོག་བཟོ་བྱས་པའི་སྒྲུང་ཞིག་འཁྲབ་སྐབས་ཚོར་སྣང་དེ་དག་དངོས་སུ་མི་འབྱུང་སྟབས་རྣམ་འགྱུར་འདྲ་མིན་ཡང་རང་ཆས་སུ་འབྱུང་དཀའ་ལ།",
    "ང་རང་ནར་སོན་ནས་མི་མང་པོ་ཡོད་སར་ཐེངས་གཅིག་མི་ཆུ་ཤོར་བྱུང་བ་ནི།",
    "གཡས་གཡོན་དུ་ངུ་མཁན་མང་པོ་འདུག་པས་ཡིན་ནམ།",
    "སྡུག་དུས་མགོ་འཕང་ཡར་ལ་། པར་ཐེ།",
    "སྤྱིར་ཕ་མ་གྲོངས་དུས་ལྟ་བུ་མིག་ཆུ་གཏོང་ན་ལོས་ཡིན་ཀྱང་།",
    "ཨ་རིའི་གློག་བརྙན་ནང་སྐྱེས་པ་ངུ་མཁན་དེ་ཙམ་མང་པོ་མི་འདུག།",
    "གཞས་ཀྱི་སྐོར་ཞིག་འབྲི་འདོད་འདུག།",
