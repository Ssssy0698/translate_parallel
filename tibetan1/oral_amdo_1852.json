    "དེ་དག་གིས་འཇིག་རྟེན་དྲུག་གི་ཕྱོགས་བཅུ་ཀུན་ཏུ་འོད་ཟེར་འགྱེད་ཅིང་འགྲོ་བ་དཔག་ཏུ་མེད་པ་རང་བཞིན་གྱིས་འབད་པ་པའི་རྒྱལ་པོལ་ནམོ། ། སྟོན་པ་གསེར་འོད་དམ་པ་ལ་ན་མོ་མེད་པར་གྲོལསྤེན་ལས་མཛད་དེ།",
    "རང་བྱུང་གི་སྤྲུལ་པ་ཆེན་པོ་ཞེས་བྱའོ།",
    "གནས་འཚོ་བྱེདསྟོན་པ་དྲུག་པ་རྡོ་རྗེ་འཆང་གིས།",
    "དུས་ཚེ་ལོ་བདུན་ཁྲིའི་དུས་ཐགས་རྐྱལ་པ་ལ་ན་མ། ། སྟོན་པ་ཤཱཀྱ་ཐུབ་པ་ལ་ན་མོ།",
    "གཅིག་གི་ངོ་བའི་ཕྱིར་དགོངས་པ་ཆིག་ཆོད་ལས་མི་གཡོ་ཡང་།",
    "ཤེལ་གྱི་སྐྱེས་བུ་གཅིག་གིས་ཤེལ་བུམ་དཔའ་བོ་འབྲུ་ལྔས་མཚན་རྨིས།",
    "ཕ་མེད་ཀྱི་བུར་གྱུར་པས་གནོང་སྟེ་ཐལ་ཁུང་དུ་བོར་བས།",
    "སྒྲ་དང་འོད་དང་མེ་ཏོག་གི་ཆར་བྱུང་།",
    "ཚིག་གི་རྒྱུད་ཡི་གེར་འགོད་པའི་གནང་བ་དང་ཡོན་པའི་མཁའ་འགྲེ་མ་ལ་སོགས་པས་གླེགས་བམ་དུ་བཀོད།",
    "ཀྱེ་རིགས་ཀྱི་བུ་ཚེ་གཅིག་གིས་སངས་རྒྱ་པར་འདོད་ན།",
    "དུར་ཁྲོད་བསིལ་བ་ཚལ་ཅེས་ཐོསམ་ཐག་ཏུ་སོང་ནས།",
    "སྟོན་པ་སྒྲོན་མའི་འོད་ནུངག་རྟེན་མུན་པ་གང་གིས་སེལ།",
    "ཀྱེ་མ་སྐལ་ལྡན་ཚེ་གཅིག་གིས་འབྲས་བུ་ངེས་པར་འདོད་ན།",
    "ལོ་བདུན་དུ་སྔགས་ཕྱི་ནང་གི་དོན་ལ་ཐོས་པར་བྱའོ་སྙམ་ནས་རི་བེ་རྩེ་ལྔའི་ཤར་། ཡེ་ཤེས་ལུས་ཅན་ཤྲཱི་སེངྒྷ་ཕྱོགས་ན་པན་ངག་རྫོགས་པར་བསླབས་ཏེ།",
    "རེ་ཞིག་སྔ་དྲོའི་ཚེ་ཁྲུསརྫིང་བུར་ཞུགས་པ་ན།",
    "རྐང་མགྱོགས་སྒྲུབ་ལ་འགྲོ་སྙམནས་ལོ་གསུམབས་པས་གྲུབ་པའི་འོག་ཏུ་རྐང་མགྱོགས་ཀྱི་ཁྲུ་གང་གིས་མ་རེག་པར་བྱོན་ཏེ་ཉིན་མཚན་དགུ་ན་དུར་ཁྲོད་ཆེན་པོ་སོ་ས་གླིང་དུ་ཕྱིན་པས།",
    "གསང་བ་བླ་ན་མེད་ར་ཕྱེ་ནས་སྐོར་དང་པོ་གསུམའྀ་ལྷ་ཁང་གི་ཀ་བའི་སམ་ལེར་སྦས།",
    "འདམ་བུའི་ཏོག་གིས་བརྒྱན་པའི་སར་སྐྱོ་བསངས་ལ་བྱོན་དུས་སྟེང་གི་ནམ་མཁའ་ལས་རྡོ་རྗེ་བསྟན་པ།",
    "དེ་ཡང་ནུབ་ཕྱོགས་ཨོ་རྒྱན་གྱི་ཡུལ་ལ་ཤར་དང་ལྷོ་དང་བྱུང་ཚོ་ཆེན་པོ་རེ་ཡོད་བྷོ་དང་ནུབ་ཏུ་ཉེ་བ་སྲིན་ཡུལ་དང་ཐག་ཉེ་བའི་རྒྱ་མཚོའི་གླིང་དུ།",
    "དེའི་ཚེ་རྒྱལ་སྲིད་བཟུང་བས་གཞན་དོན་རླབས་ཆེན་མི་འགྲུབ་པར་དགོང་ལ་ཞུས་ཀྱང་མ་གནང་ར་མཛད་པས་རྩེ་བར་བའི་བརྫུ་བགགིས་བདུད་བློན་གྱི་བུ་དབྱིངས་སུ་སྤར།",
    "རྒྱན་སྣང་གི་གཟའ་སྐར་ད་དམ་ལ་བཏགས།",
    "མ་བསྒྲུབ་པར་ཡང་ལྷ་རྣམས་ཞལ་གཟིགས།",
    "དེ་ནས་༥ ཟ་ཧེར་གྱི་རྒྱལ་པོ་གཙུག་ལག་འཛིན་གྱི་སྲས་མོ་མནྡ་ར་བ་ཞེསན་དང་ལྡན་པ་བ་རྟེན་གྱི་ཕྱག་རྒྱ་མོར་ཁྲིད་ནས་བྲག་ཕུག་མཱ་ར་ཏི་ཀར་ཚེའི་སྒྲུབ་པ་བ་གསུམ་མཛད་པས་མགོན་པོ་ཚེ་དཔག་མེད་དངོས་སུ་བསྐུར།",
    "རྒྱལ་པོ་གཅིག་གིས། ། དུག་དྲངས་པས་མརྒྱུ་ལ་བསྐྱུར་བས་ཆུ་གྱེན་དུ་བསྐྱིལ་ཞིང་།",
    "ཕྱི་ནང་གི་དྲེ་ཐམསཅམཛད་པའི་ཚེ་མཚན་ཉི་མ་འོད་ཟེར་གྲགས།",
    "དེ་ནས་རྒྱ་བལ་མཚམསཤོད་ཀྱི་བྲག་ཏུ་བལ་པེའི་རྒྱལ་པོ་དགེ་འཛིན་གྱི་སྲས་མེ་བལ་མོ་ཤཱཀྱ་དེ་བ་ལ་སྒྲུབ་རྟེན་ནས་མཆོག་སྒྲུབ་པའི་ཚེ་འདྲེ་སྲིན་མཐུ་བོ་ཆེ་གསུམ་གྱིས་བར་ཆད་བྱས་ཏེ།",
    "ཡུན་རིང་པོར་སོང་བ་ན་སླརམཛད་ནས་དུས་རིང་པོར་བཞུགས་པ་དང་།",
    "འཇིག་པའི་བསྐལ་པ་ཆགས་པའི་བསྐལ་པར་མོས་ན་ཡང་འཇིག་པའི་བསྐལ་པ་ཆགས་པའི་བསྐལ་པར་འགྱུར་ཏེ།",
    "ཆགས་པའི་བསྐལ་པ་འཇིག་པའི་བསྐལ་པར་མོས་ན་ཡང་ཆགས་པའི་བསྐལ་པ་འཇིག་པའི་བསྐལ་པར་འགྱུར་ཏེ།",
    "འཇིག་པ་དང་ཆགས་པ་གྱུར་པ་མ་ཡིན་ཏེ་མོས་པས་དེ་ལྟར་དུ་འགྱུར་རོ།",
    "སྔ་དྲོགཅིག་བསྐལ་པ་ཙམ་དུ་མོས་ན་ཡང་དེ་བཞིན་དུ་འགྱུར་ཏེ་པ་ལས་བ་ཞེས་བྱའོ།",
    "རྡོ་རྗེ་ཕག་མོས་ལུང་བསྟན་པ།",
    "ཞེས་གསུངས་པ་དང་སྐད་ཅིག་གིས་རྩུ་བ་འགྱུར་ཚལ་གྱི་དུར་ཁྲོད་ཆེན་པོའི་རྫུ་འཕྲུལ་གྱིས་བྱོན་ཏེ་སློབ་དཔོན་ཤྲཱི་སེངྷ་ལ་ཕྱག་དང་བསྐོར་བ་མཛད་ནས་རྗེས་སུ་བཟུང་བར་ཞུས་པས་གནང་སྟེ།",
    "རྫོགས་པ་ཆེན་པོ་ནམ་མཁའ་དང་མཉམ་པའི་རྒྱུད་ལ་སོགས་པ་སེམས་ཀློང་མན་ངག་གི་སྐོར་མཐའ་དག་སུངས་ཤིང་།",
    "དེའི་ཉམས་ལེན་མན་ངག་གི་ཡི་གེ་རབ་ཏུ་མང་པོ་དང་།",
    "དེའི་རྒྱབ་བརྟེན་དུ་སྒྲ་ཐལ་འགྱུར་རྩ་བའི་རྒྱུད།",
    "ཀུན་ཏུ་བཟང་མོ་ཀློང་ངོ་བརྒྱད་ཡོངས་སུ་རྫོགས་པར་གསུངས་ཤིང་བསྟན་པ་གཏད་དེ།",
    "མཚན་མོ་དུར་ཁྲོད་ཆེན་པོ་བསིལ་བའི་ཚལ་དང་།",
    "བརྡ་རྒྱུད་ཅེས་གསང་ཆེན་སྔ་འགྱུར་བའི་བརྡ་ཆད་ཐུན་མོང་མ་ཡིན་པ་ཡིན་ནོ།",
    "གསུམ་པ་གང་ཟག་སྙན་ཁུང་གི་བརྒྱུད་པ་ལ།",
    "བཱི་མ་ནས་བརྒྱུད་པ་རིང་ངཐེག་ཆེན་མོའི་བརྒྱུད་པའོ།",
    "ཡུལ་སྙེ་མོ་བྱེམཁར་དུ་བེེ་རོ་ཙ་ན་བཙན་པོ་ཁྲི་སྲོང་ལྡེའུ་གས་པ་ཚོན་པོ་བརྒྱད་སོགས་བཟོད་དུ་མེད་པའི་དཀའ་བ་ལྔ་པྲག་བཅུལ་བདུན་གྱིས་ལྷག་པ་གྱི་ཡུལ་དུ་བརྟོལ།",
    "འོན་ཀྱང་ཤིན་ཏུ་མ་གསང་ན་རྒྱལ་པོའི་ཆད་པས་སྲོག་གི་ཉེན་དུ་འགྱུརབས།",
    "བཙན་པོ་ལ་ཉིན་མོ་རྒྱུ་འབྲས་ཐུན་མོང་པ་དང་།",
    "ཕྱི་མ་འདིས་བེ་རེ་ལི་ཡུལ་དུའང་སྤྱན་དྲངས།",
    "མཐར་བལ་བོ་བྷ་སིང་གི་གནས་སུ་ཟུང་འཇུག་གི་སྐུར་གྱུར་ཏེ་འཇབ་ལུས་སུ་གཤེགས་སོ།",
    "ཟེར་མོ་དགེ་སློང་།",
    "དེནི་ཡུལ་དངན་ལམ་རལ་གསུམ་པ་དགེ་སློང་ལོ་དྲུག་ཅུ་རྩ་བདུན་ལེན་པ་ཞིག་གིས་རྒྱལ་མོ་སྟག་རྩེ་མཁར་དུ་བྱོན།",
    "སྲས་མོ་ཝ་ར་ཧི།",
    "བུདྡྷསམནྟ།",
    "བེ་རོའི་སེམས་ལུང་ཆེན་མོ།",
    "མན་ངག་གི་དོན་འགྲེལ།",
    "ཐུན་མོད་མ་ཡིན་པརྗེ་འབངས་ཉེར་དག་པའི་ངོར་འདུས་པ་ཆེན་པོ་ལན་གསུམ་ཚོགས་ནས།",
    "དེ་དག་གི་སྐབས་སུ་ཚེས་རྒྱལ་ཁྲི་སྲོང་ལྡེའུ་བཙན།",
    "ཆེ་མཆོག་ཞྭ་པའི་ཞལ་གཟིགས་ཏེ་རྟོགས་པ་མངོན་དུ་གྱུར།",
    "གཞུང་ལུགས་རྣམས་དང་དེ་ཡི་གདམས་ངག་གིས།",
    "རྣ་བར་ཐོས་པ་ཁྱོད་ཀྱི་དྲིན་ཡིན་ན།",
    "བློ་ལྡན་སུ་ཞིག་ཁྱོད་ལ་ཅིས་མི་གུས།",
    "དེ་ཕྱིར་བདག་ནི་དད་མོས་རྩེ་གཅིག་གཔས།",
    "སྤྱན་རས་གཟིགས་ཀྱི་ཐུགས་བསྐྱེད་མཐུ་བཙན་པས།",
    "རྒྱལ་སྲས་དཔའ་བོ་རྣམས་ཀྱི་གཙུག་གི་རྒྱན།",
    "ཡེར་པ་དང་ཆུ་བོ་རིའི་འོད་ལུས་གྲུ་བརྒྱརྩ་བརྒྱད་རེ།",
    "ཤེལ་བྲག་གི་སྔགས་པ་སུམ་ཅུ།",
    "མཚན་ལྡན་ཇོ་མོ་རྣམ་གསུམ།",
    "འོད་སྐུར་གཤེགས་པའི་མཁའ་འགྲོ་ཉེར་ལྔ་སོགས་གྲུབ་ཐོབ་པོ་མོ་གྲངས་ལས་འདས་པ་བྱོན།",
    "དེ་རེ་རེ་ལའང་རྩ་བ་དང་ཡན་ལག་གི་ཚུལ་དུ།",
    "གནམ་མཚོ་ཕྱུག་མོ་སོགས་གྲགས་ལ་ཕྱག་རྗེས།",
    "སྤ་གྲོའི་བྲག་དཀར་པོ་སོགས་ལ་ཞབས་རྗེས་རྡོ་རྗེ་བྲག་གི་ངོས་ལ་མར་དཀར་ལ་པར་གྱིས་བཏབ་པ་བཞིན།",
    "ཅིག་བཙས་ཏེ་མཚོ་རྒྱལ་དུ་བཏགས་ནས་ཆེར་སྐྱེས་པ་ལས་རྒྱལ་པོའི་བཙུན་མོར་བླངས་པན།",
    "ཞབས་ཏོག་མཛཐོབ་པ་སྟེ་མཆོག་དང་ཐུན་མོང་གི་དངོས་གྲུབ་བརྙེས་སོ།",
    "ན་མོ་གུ་རུ་ཛྙཱ་ན་ཌཱ་ཀུན་ཏུ་བཟང་མེ་ཤེས་རབ་ཕ་རོལ་ཕྱིན།",
    "དབྱངས་ཅན་ལྷ་མོ་ཡེ་ཤེས་མཚོ་རྒྱལ་ཞབས།",
    "ཐུབ་པའི་སྤྱན་སྔར་གངྒཱའི་ལྷ་མོར་སྤྲུལ།",
    "མེ་ཏོག་ཆར་བབས་བླ་ཡི་མཚོ་མོ་རྒྱས།",
    "མཁའ་ལས་ལྷ་མོ་མང་པོས་ཤིས་པ་བརྗོད།",
    "དབྱངས་ཅན་ཞལ་གཟིགས་མི་བརྗེད་གཟུངས་མཆོག་ཐོབ།",
    "ལས་འབྲས་རང་མཚང་གཟིགས་ལ་གསོལ་བ་འདེབས།",
    "ཚོགས་ཁང་ཆེན་མོར་བདེ་ཆེན་མཎྜལ་ཕུལ།",
    "དཔུང་ཚོགས་བཏུལ་ནས་དད་པའི་གཞིལ་བཀོད།",
    "བཅུ་དྲུག་ལང་ཚོས་དངས་འབར།",
    "དཔའམོཧེ་རུ་ཀ་ལ་གསོལ་བ་འདེབས།",
    "དཀྱིལ་འཁོར་ཀུན་གྱི་གཙོ་མོར་གྱུར།",
    "མོན་མོ་བཀྲ་ཤིས་ཁྱེའུ་འདྲེན་རྗེས་སུ་བཟུང་།",
    "རྒྱལ་བསྟན་ཉིན་མོར་མཛད་ལ་བ་འདེབས།",
    "ཨ་ཅིག་དྲིན་མོ་ཆེ་ལ་གསོལ་བ་འདེབས།",
    "མྱུར་བའི་ཡུམ་ཆེན་མོལ་གསོལ་བ།",
    "དྲི་མེད་ཡེ་ཤེས་སྤྱན་གྱིས་རབ་གཟིགས་ལ།",
    "མཆོག་དང་ཐུན་མོ་ཐུབ་མ་ལུས་སྩོལ།",
    "གདོས་བཅས་ཤ་ཁྲག་གི་ཕུང་པོ་ས་པའི་སྐུར་གྲོལ་བ།",
    "ཕྱིས་ལུང་བསྟན་དུ་མ་སྐྱེ་མཐའ་པདྨ་ལས་འབྲེལ་རྩལ་གྱིས་དང་ལུང་ཁྲ་མོ་བྲག་ནས་གཏེར་དུབཏོན་པའོ།",
    "དེ་ཡང་བདག་ཉིད་ཆེན་པོ་འདི་ཡུལ་གཉལ་དང་ལེ་རེའི་མདའ་འབྲིན་ཐང་དབས་ཞོལ་རི་ཞིང་ཞེས་པར།",
    "ཁྱོད་ཀྱི་རྩར་ཡོང་བ་ཡིན་བྱས་མ་ཐག་ཨམ་ཕྲག་ཤོག་དྲིལ་གཅིག་བཏོན་ནས་། པདྨ་ལས་འབྲེལ་རྩལ་ལ་འདུད།",
    "ཚིག་གི་དོན་མ་ནོར་བར་གྱིས་ལ་ལོངས་ཤིག།",
    "ཁྱེད་ཀྱི་ནོར་སྐལ་ལེན་པའི་དུས་ལ་སླེབས་པས་སྟོན་ཟླ་ར་བའི་ཚེས་བཅུལ་སོང་ལ།",
    "ཁྲ་མོ་བྲག་གི་ཕུག་པར་སྡད་ནས་ཟབ་གཏེར་རྣམས་གདན་དྲངས་སོ།",
    "ཤྭཚིར་མལུང་དུ་སོང་ནས་སྔགས་པ་གཅིག་གི་ཁྱིམ་དུ་བསྡད་པས།",
    "དེའི་ནུབ་མེ་གླེང་མོལ་མང་པོ་བྱས་པས།",
    "སྔགས་པ་ན་རེ།",
    "ཁྱོད་ཁར་སང་གང་ནས་ཡོང་།",
