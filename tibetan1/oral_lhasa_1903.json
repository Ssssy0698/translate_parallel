    "རིམ་པར་དངོས་དང་ཡོད་པར་དོན་གཅིག་འདིར།",
    "མངོན་སུམ་རྣམ་མཁྱེན་དངོས་ཤུགས་གཞལ་བྱ་འགལ།",
    "རྣམ་མཁྱེན་གྱི་དངོས་ཡུལ་མ་ཡིན་པའི་ཕྱིར།",
    "རྣམ་མཁྱེན་གྱི་དངོས་གཞལ་མ་ཡིན་པའི་ཕྱིར།",
    "རྣམ་མཁྱེན་གྱི་དངོས་གཞལ་དང་དངོས་པོ་གཉིས་དོན་གཅིག་ཡིན་པའི་ཕྱིར།",
    "སྒྲ་རྟག་པར་འཛིན་པའི་རྟོག་པ་དང་།",
    "སྒྲ་མི་རྟག་པར་རྟོགས་པའི་རྗེས་དཔག་གཉིས་དམིགས་པ་གཅིག་ལ་དམིགས་ནས་འཛིན་སྟངས་དངོས་འགལ་དུ་ཞུགས་པའི་བློ་ཡིན་པའི་ཕྱིར།",
    "སེམས་དང་ཡིད་དང་རྣམ་པར་ཤེས་པ་རྣམས་དོན་གཅིག་ཡིན་པའི་ཕྱིར།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་འཁོར་དུ་གྱུར་པའི་སེམས་བྱུང་ཡིན་པའི་ཕྱིར།",
    "གསར་དུ་མི་བསླུ་བའི་རིག་པ་ཡིན་པར་ཕྱིར།",
    "རྣམ་པར་ཤེས་པའི་ཕུང་པོ་དང་ལྔ་ཡོད་པའི་ཕྱིར།",
    "རྒྱས་པར་དབྱེ་ན།",
    "རྣམ་པར་ཤེས་པའི་ཕུང་པོའི་མཚན་ཉིད་ཡོད་དེ།",
    "རྣམ་པར་ཤེས་པའི་ཕུང་པོ་དང་།",
    "ཡིད་རྣམས་དོན་གཅིག་རྣམ་པར་ཤེས་པའི་ཕུང་པོ་ལ་དབྱེ་ན་དྲུག་ཡོད་དེ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་བར་དྲུག་ཡོད་པའི་ཕྱིར།",
    "རྣམ་པར་འཚེ་བ་དང་བཅུ་པོ་དེ་འདྲེན་པའི་ཕྱིར།",
    "རྣམ་པར་མི་འཚེ་བ་དང་བཅུ་གཅིག་པོ་དེ་འདྲེན་པའི་ཕྱིར།",
    "སྒྲ་མི་རྟག་པར་རྟོཊ་པའི་རྗེས་དཔག་དེ་ཡིན་པའི་ཕྱིར།",
    "རྟོག་པར་གྱུར་པའི་ལོག་ཤེས་དང་རྟོག་མིན་ལོག་ཤེས་གཉིས་ཡོད་པའི་ཕྱིར།",
    "རྟོག་པར་གྱུར་པའི་ལོག་ཤེས་གཞག་ཏུ་ཡོད་དེ།",
    "རྣམ་མཁྱེན་གྱིས་དངོས་སུ་རྟོགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "རྣམ་མཁྱེན་གྱིས་རྟོགས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ཟེར་ན།",
    "རྣམ་མཁྱེན་གྱི་གཞལ་བྱ་ཡིན་པའི་ཕྱིར།",
    "རྗེས་དཔག་རྣམ་མཁྱེན་གྱི་གཞལ་བྱ་ཡིན་པའི་ཕྱིར།",
    "བྱེ་བྲག་ཕྱིར་ན་ཤེས་བྱ་ཡོད་པརི་ཡང་།",
    "སྒྲ་དང་དོན་དུ་སྣང་ཞིང་དངོས་མིན་གསུངས།",
    "བྱས་པ་དེ་ཡང་དེ་ཡིན།",
    "ཡོད་པར་འགལ་དང་མི་འགལ་འབྲེལ་མ་འབྲེལ།",
    "ཡོད་མེད་འགལ་ལོ་འོན་ཏེ་ཡོད་པར་བལ།",
    "གཞི་མཐུན་སྲིད་ན་ཐ་དད་ཡིན་པར་ངེས།",
    "རྣམ་མཁྱེན་ཚང་མ་ལས་ནི་གཞན་དུ་འམ།",
    "རྣམ་པར་གཞག་འཇོག་རྒྱུ་འབྲས་མཚན་མཚོན་ཉིད།",
    "བུམ་པར་མཚོན་ཏེ་ལྟོ་ལྡིར་བ་ཉིད་ཅེས།",
    "དོན་བྱེད་ནུས་པ་མ་ཡིན་པར་གྱུར་པའི་གཞན་གྱི་མཚོན་བྱ་མ་ཡིན་པ་དང་གསུམ་པོ་དེ་འདྲེན་པ་ཡིན་ཟེར་ན།",
    "དོན་བྱེད་ནུས་པ་མ་ཡིན་པར་གྱུར་པའི་གཞན་གྱི་མཚོན་བྱ་མ་ཡིན་པའི་ཕྱིར།",
    "ཤེས་བྱ་མ་ཡིན་པར་གྱུར་པའི་གཞན་གྱི་མཚན་ཉིད་མ་ཡིན་པ་དང་གསུམ་པོ་དེ་འདྲེན་པ་ཡིན་ཐེར་ན།",
    "ཤེས་བྱ་མ་ཡིན་པར་གྱུར་པའི་གཞན་གྱི་མཚན་ཉིད་མ་ཡིན་པའི་ཕྱིར།",
    "ཕྱི་མ་མི་རིགས་རྫས་མཐུན་གཉིས་པར་བཞག།"
  ]
