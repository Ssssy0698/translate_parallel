    "ང་རང་ཚེ་རིང་པོ་དེ་འདྲར་བསྡད་འདུག་ཅེས་གསུངས།",
    "གུས་པར་གནང་བའི་གོས་འབོག་དེ་དགོས་པའི་ཆེད་དུ་གནང་བ་ཡིན་འདུག་སྙམ་སྟེ།",
    "ང་རང་ལྟ་བུ་ཞིག་ཡིན་ན་ནི།",
    "འོན་ཀྱང་ཁོང་ལ་བློ་ཤོད་ཆེན་པོ་བྱེད་པའི་སྤོབས་པ་ཡང་འདུག་ངོས་རང་བཀའ་བློན་ཞིག་ཡིན་པས་ཕན་པ་གང་ཡང་མ་བྱུང་།",
    "ད་ཆ་ར་ཝང་ལ་ཀུན་ཕན་གླིང་གཞིས་ཁོངས་སུ་ས་ཆ་ཡང་ཡོད་འདུག་པ་དང་།",
    "ཡུལ་གྱི་ས་ཆ་ཞིག་གནང་ཐབས་ཡོད་མེད་ཞུ་རོགས་ཟེར་འདུག་པར།",
    "ཁོང་ནས་ཁྱེད་རང་དེབ་བརྒྱད་པ།་",
    "འོན་ཀྱང་གནས་ཚུལ་དེས་ཁོང་རང་ལ་སྐྱོན་བྱུང་བས་ཉམ་དམའ་རུ་ཕྲན་བུ་ཕྱིན་ཡང་།",
    "དེ་རྗེས་སློབ་ཕྲུག་དེ་ཀླད་སྐྱོན་རང་བྱུང་ཡོད་མི་འདུག་སོ་ན་རྡའི་གཞིས་འགོ་བསྐོ་གཞག་གནང་བ་བྱུང་མི་འདུག་ཀྱང་།",
    "སྐབས་དེར་རྒྱལ་མཁར་ནང་པ་ཞེས་པའི་སྔར་གྱི་སྐུ་དྲག་ཡིན་པའི་མི་ངོ་ཞིག་འདུག་པ།",
    "དོན་དུ་འདོད་པ་ཡེ་ནས་ཁེངས་མེད་པ་ཡིན་འདུག་ཅིང་།",
    "ཐག་གཅོད་ལྟར་ཕྱུགས་གསོའི་བ་ཕྱུགས་རྣམས་ཇི་བཞིན་རྩིས་སྤྲོད་བྱས་མི་འདུག་པ་མ་གཏོགས།",
    "དེ་ལྟར་བྱུང་ན་བདག་རང་བློ་བདེ་པོ་ཡོང་བ་འདུག་ཅེས་བརྗོད་ཅིང་།",
    "སྐབས་དེ་དུས་བདེ་སྲུང་བཀའ་བློན་སྟག་ལྷ་ཕུན་ཚོགས་བཀྲ་ཤིས་ཁོང་ནས་ཁྱེད་རང་འདིར་ཤོག་དང་གསུང་སྟེ།",
    "རྨ་བྱ་བ་ཁོང་རང་ལ་དེའི་དྲི་ཟུར་ཙམ་དངོས་ཤུགས་བརྒྱུད་གསུམ་ནས་བྱས་པ་མེད།",
    "འགན་འཛིན་རྨ་བྱ་བ་སྒེར་གྱིས་ཉར་འདུག་སྐབས་དེར་བྱམས་པ་སྐལ་ལྡན་དང་།",
    "ཡང་ན་ཁང་གླ་སྤར་ཆ་ཡོང་ཐབས་བརྗོད་འདུག་སྐབས་ཁང་གླ་སྤར་ཆེ་བྱ་རྒྱུའི་ཁས་ལེན་བྱས་པ་ཡིན།",
    "སྐབས་དེར་རྒྱལ་བློན་ལྷན་རྒྱས་ནས་ཐུགས་དགྱེས་པོ་མཛད་འདུག་རང་ཉིད་ཀྱང་སེམས་སྐྱིད་པོ་བྱུང་།་",
    "མཆོད་དཔོན་མཆོག་ལྡན་ནས་གུ་རུ་པདྨ་སམ་བྷ་བའི་སྐུ་ཞིག་བཞེངས་འདུག་ཞུས།",
    "འཚོལ་ཐབས་བྱས་ནས་ཀྱང་རྙེད་སོན་བྱུང་མི་འདུག་ངོ་བཤུས་བཀའ་དྲུང་ཡིག་ཚང་དུ་ཡོད་པ་དེ་ཡང་འཚོལ་ཐབས་མ་ཐུབ།",
    "དོགས་གཞི་ཆགས་དགོས་པ་ལྟ་བུ་འདུག་ཀྱང་།",
    "ཕན་ཚུན་དགེ་སྐྱོན་གསལ་པོ་བྱུང་ན་སླད་ཕྱིན་སྤྱི་མཚུངས་ཁྱད་མེད་གནང་དགོས་པ་ལོས་ཡིན།",
    "རྐྱེན་བསད་གཏོང་མཁན་གྱི་ལག་དམར་ཕུགས་འདུག་བྱ་མི་བཅས་སུ་འདྲ་ཞིག་ཡིན་མིན་རྩད་གཅོད་ཐུབ་ཐབས་ལ་གཞུང་དམངས་མཉམ་རུབ་ཀྱི་འཁུར་ལེན་ངེས་པར་བྱ་གལ་ཆེ།",
    "ཤོད་མཁན་གྱི་མིའི་ངོ་བོ་ལ་ལྟ་དུས་ཁོ་རང་སེམས་སྡུག་པའི་རྐྱེན་དང་།",
    "མུན་པ་རུབ་ན་འདུག་ཐག་ཆོད་པ་དགོས།",
    "མུ་མཐུད་དེ་མི་གྲངས་༨ ཀྱིས་ཡར་ལངས་ཏེ་ཕལ་ཆེར་ཉེས་རྡུང་གཏོང་ལ་ཉེ་བའི་རྣམ་འགྱུར་ཤུགས་ཆེའི་ཐོག་ཁ་ནས་ཐོན་ཚད་བརྗོད་འདུག་འོན་ཀྱང་ཉེས་རྡུང་རང་དངོས་སུ་གཏོང་ཨེ་ཡོང་བསམ་པ་དང་།",
    "ཁྱེད་རང་དེབ་བརྒྱད་པ།",
    "རྒྱ་ལོ་ལགས་ཁོང་རང་དང་བཅས་པར་གསལ་པོར་ཞུ་ཐུབ་ངེས་བྱ་ཡི་ཡིན།",
    "དེ་ཚོ་གཅིག་བྱས་ན་ལས་ཀ་མེད་པ་ཡིན་འགྲོ།",
    "དངོས་འབྲེལ་བྱས་ན་དེ་དགོང་ཕྱིར་ལོག་བྱ་རྒྱུ་ལས་འོས་མི་འདུག་ཀྱང་ཕྱི་པོར་ཆགས་པ་དང་།",
    "ང་རང་ནས་རྡུང་རྡེག་གང་འཚམས་ཤིག་གཏོང་མ་བྱུང་བར་ལང་རྩིས་མེད།",
    "ངའི་རོགས་པ་བཀྲ་ཤིས་སྟོབས་རྒྱལ་ནས་ཁྱེད་རང་ག་དུས་ལང་ཡོང་བསམས་ནས་ཡོད་ཀྱང་།",
    "བཀའ་ཤག་ལྷན་བཅར་མ་བྱུང་བ་དེ་འགྲིགས་མི་འདུག་སྙམ་པ་བྱུང་།",
    "ཁྲི་སྐོར་བཅུ་གསུམ་ཟེར་བ་སོགས་ཀྱི་ཁོངས་སུ་ཀོང་པོ་རྩ་བ་ནས་ཚུད་ཀྱི་མེད་པ་གསལ་པོ་ཡིན་འདུག་དཔེར་ན།",
    "རྒན་རབས་ཀྱི་ངག་རྒྱུན་བཅས་ཁག་མང་པོ་ནས་ཁུངས་སྐྱེལ་གསལ་པོ་ཐེ་ཚོམ་མེད་པ་མང་པོ་ཞིག་ཡོད་འདུག་པ་དེ་དག་ལ་རྩིས་མེད་བྱ་འདོད་བྱེད་ཀྱི་ཡོད་པར་བརྟེན།",
    "རྨར་ཀན་གྱི་བཟོ་གྲྭ་ཁོ་རང་ལ་རྩིས་སྤྲོད་བྱ་དགོས་ཞེས་བརྗོད་ཀྱི་ཡོད།",
    "༧གོང་ས་ཆེན་པོའི་མདུན་དུ་བཅར་ནས་ན་བཟའི་མནབ་ཤམ་ལ་འཇུས་ནས་ངས་མ་འགྲིགས་པའི་ལས་ཀ་རྩ་བ་ནས་བྱེད་མི་ཡོང་ཞེས་ཞུས་པ་ཡིན་ཞེས་ཁྱེད་རང་ནས་ང་ལ་བརྗོད་མྱོང་བ་དེ་དྲན་པ་བྱས་ཏེ་རྙོག་གྲ་མེད་པ་བཟོས་ན་ཡག་པོ་འདུག་ཅེས་བརྗོད་པ་ཡིན་སྟེ།",
    "ཁྱེད་རང་གཉིས་ཀའི་འགན་ཁུར་ང་རང་ལ་གང་ཡང་མེད་ཅེས་སྐད་ཆ་མཚམས་བཅད་པ་ཡིན།",
    "བཀོད་ལེགས་ཡིད་དུ་འོང་བ་ཞིག་གསར་རྒྱག་ཞུས་འདུག་གཟིམ་ཤག་དེའི་བཀོད་པ་དང་།",
    "ཡག་དུས་ཡག་ཚོད་མེད་པར་གཞུང་སྒེར་རྫས་ཁེ་འབབ་མཉམ་འཛིན་བྱེད་པ།",
    "མཐར་ཐུག་ཁ་མཆུའི་རྒྱལ་ཁ་ཁོ་རང་ལ་ཐོབ་རྒྱུ་ཡིན་ལུགས།",
    "ཁོ་རང་མེད་ན།",
    "ང་རང་ད་ལྟ་ནས་ནོར་བ་ངོས་ལེན་གྱིས་གྲྭ་སར་ལམ་སེང་ཕྱིར་ལོག་བྱ་རྒྱུ་ཡིན་གསུངས་ཏེ་ཐུགས་ཐག་བཅད།",
    "གཞི་ནས་ངས་ཁོ་རང་ལ་མི་མང་པོའི་དཀྱིལ་ནས་གསལ་པོར་བརྗོད་ཡོད་པ་ནི།",
    "བསྐྱེད་ལ་བསྐྱེད་འཇར་ཇི་ཡོད་ཆག་ཡང་མི་ཞུ་ཀ་མེད་དུ་གྱུར་འདུག་ཅེས་ཞུས།",
    "འགྲུབ་ནས་ཡོང་ཐུབ་པ་དེ་རྒྱལ་བ་དགྱེས་པའི་མཆོད་སྤྲིན་དུ་གྱུར་པས་ཕྱི་མའི་འགྲོ་དོན་ཁུར་རྒྱུ་ཡོད་པ་ཞིག་བྱུང་འདུག་སྙམ་སྟེ་རང་ཉིད་བློ་བདེ་པོ་དང་།",
    "ཁོང་རང་སྤྱི་འཐུས་སུ་གཏོང་ན་ཡག་པོ་འདུག་སྙམ།",
    "ང་རང་སྒེར་ལའང་ནང་དོན་རྒྱ་རི་བློ་གྲོས་སྤྱི་འཐུས་སུ་བཏང་ན་སྐྱོན་ཡོད་པའི་སློབ་སྟོན་བྱེད་མཁན་མང་པོ་བྱུང་།",
    "ཡུན་ནན་བཅས་ཀྱི་ས་སྣེ་རྣམས་ཚུད་འདུག་པ་དང་།",
    "ཁུན་ལུང་རི་བོའི་རྒྱབ་ཀྱི་ཤིང་ཅང་ས་ཆའི་སྣེ་ཡང་ཚུད་འདུག་ཧི་མ་ལ་ཡའི་རི་རྒྱུད་ཀྱི་རྒྱབ་ཕྱོགས་རྒྱ་གར་གྱིས་བཟུང་བའི་ས་ཆ་རྣམས་ཀྱང་ཚུད་པ་མ་ཟད།",
    "དེ་སྐབས་ཀྱང་རང་ཉིད་ཀྱིས་བསམ་བློར་བསྡུར་ཞིབ་ཡང་ཡང་བྱས།",
    "རྒྱལ་རོང་ཕྱོགས་སུ་མེའོ་ཆང་རིགས་ཟེར་བ་ཞིག་ཟུར་དུ་ཕྱེས་ཡོད་འདུག་པ་མ་གཏོགས།",
    "གཞན་ཡང་རང་འཚོར་བསྐྱོད་མི་རྣམས་ཀྱི་སྐོར་བཅས་ཞིབ་ཕྲའི་ཐག་གཅོད་གནང་རྒྱུར་སླར་ཡང་བཀའ་ཤིག་ལ་འགན་དཀྲི་གནང་བ་དང་།",
    "འོན་ཀྱང་རང་བཞིན་གྱི་ངོས་འཛིན་དང་།",
    "རྒྱ་མིས་ཀྱང་དེ་དོན་ལ་དགའ་བསུ་ཞུས་འདུག་སྐབས་དེར་༧གོང་ས་མཆོག་༡༩༧༩ ཟླ་༡ ཚེས་༢ ཉིན་བཞུགས་སྒར་ནས་ཆིབས་བསྒྱུར་གྱིས་ལྡི་ལི་དང་།",
    "འགྲོ་འདུག་སྤྱོད་གསུམ།",
    "རྩ་བའི་ག་དུས་ཡིན་ཀྱང་རྒྱ་གར་གཞུང་མང་ལ་བཀའ་དྲིན་ཆེན་པོའི་ལེགས་གསོལ་ཞུས་དང་ཞུ་བཞིན་ལ་ཡང་།",
    "རང་རང་བོད་རྒྱ་ཕན་ཚུན་འབྲེལ་བ་གནང་རྒྱུའི་དགོངས་བཞེད་ལ་འགྱུར་བ་གང་ཡང་མེད་ཅེས་གསལ་པོ་ཞུ་དགོས་བཀའ་མངགས་བྱུང་བས།",
    "པེ་ཅིང་དུ་དེ་དོན་སྙན་སེང་གནང་དགོས་བརྗོད་འདུག་པར།",
    "རིང་མིན་བཀའ་བློན་གཉིས་གསུམ་ཞིག་བོད་དུ་ལྟ་སྐོར་ཆེད་གཏོང་རྩིས་ཡོད་ཁོངས་སུ་སྐུ་གཅེན་བློ་བཟང་བསམ་གཏན་ཁོང་ཡོད་ལུགས་སོགས་འབྲེལ་བརྗོད་གནང་འདུག་ཀྱང་།",
    "བརྗོད་འདུག་ཚེས་༨ ཉིན་རྡ་རམ་ས་ལ་ནས་རུ་སུར་ཕེབས་བཤོལ་ཐུབ་ཐབས་མེད་ལུགས་ཏར་འཕྲིན་ཕུལ་འབྱོར་ལྟར།",
    "ནང་སྲིད་དྲུང་ཆེ་བཀྲ་ཤིས་སྟོབས་རྒྱལ་གཉིས་ལ་ཕྱག་རྟགས་ཕེབས་འདུག་སྐབས་དེར་བཀའ་བསྡུར་ཞིབ་ཕྲ་བྱུང་ཞིང་།",
    "ཕྱུ་བ་རྣམས་འཚེམ་སྟངས་ཡག་པོ་བྱུང་མི་འདུག་པས།",
    "སྣེ་ཤན་ཚོར་ངོས་སྦྱོར་ཤོག་ལྷེ་ཞིག་ཡོད་འདུག་དེར་ཡང་སྣེ་ལེན་བྱ་མཁན་སུ་ཞིག་འབྱོར་མི་འདུག་པས།",
    "གང་ཞིག་ཆགས་ཀྱི་ཡོད་དམ་སྙམ་པས་བློ་མི་བདེ་བ་ཆེན་པོ་ཆགས་ཀྱི་འདུག་རྒྱུན་རིང་ཙམ་བསྒྲུགས་དགོས་བྱུང་།",
    "ཁོང་ཉིད་ཀྱིས་ཡོད་ཚད་བཞེས་ཀྱི་འདུག་པར།",
    "སྐུ་གཅེན་བློ་བཟང་བསམ་གཏན་རྣམ་གཉིས་དེ་སྔ་ནས་ངོ་ཤེས་ཀྱི་ཡོད་འདུག་སྟབས་གནམ་གྲུའི་སྐས་མགོ་ནས་ཐོན་མ་ཐག་གཤམ་འོག་ནས་ལག་པ་གཡུག་སྟེ།",
    "ཅིང་ཤི་པིང་ཀོན་ཞེས་པའི་ནང་གོ་སྒྲིག་ཞུས་འདུག་སང་ཚེས་༦ ཉིན་ཕྱི་དྲོ་འཐབ་ཕྱོགས་གཅིག་གྱུར་དང་།",
    "མཆོད་རྟེན་སོགས་ཡོད་འདུག་པ་དང་།",
    "གོས་ཐུང་རང་སྔོ་ནག་ཞེ་གཅིག་རྫིག་ཉམས་དང་།",
    "དེ་རྗེས་ཀྱང་མགྲོན་ཁང་དེའི་སྒོ་འོག་མ་ཞིག་འདུག་པ་དེ་ནས་ཡར་མར་འགྲོ་བསྐྱོད་སྐབས།",
    "བྱམས་པའི་བཞེངས་སྐུ་ཆེན་པོ་ཞིག་འདུག་པ་དེ།",
    "འཇིགས་བྱེད་ཉེ་སྲས་བརྒྱད་བཅས་ཉམས་ཉེས་མ་ཤོར་བའི་སྐུ་བརྙན་དང་ལྷ་ཁང་འགའ་ཤས་འདུག་ཅིང་།",
    "རྒྱ་གར་ནས་ངོ་རྒོལ་སྐད་འབོད་བྱ་རྒྱུ་ནུས་ཤུགས་ཆུང་དུ་བཏང་ན་ཡག་པོ་འདུག་༥",
    "ང་རང་ཡིན་ཡང་རུ་སུས་བྱེད་སྟངས་ལ་དགའ་པོ་མེད།",
    "རྒྱ་མིས་འཚིག་ཟ་ཆེན་པོ་བྱེད་ཀྱི་འདུག།",
    "ང་རང་སྐབས་དེར་དགའ་པོ་རང་མེད།",
    "རང་བཙན་མ་བྱུང་ན་འགྲིགས་ཐབས་མི་འདུག་བསམ་པ་བྱུང་།",
    "རོ་ཁང་ལ་ལྟ་སྐོར་གོ་སྒྲིག་འདུག་པར།",
    "གསེར་ཐམ་ཁག་གསེར་བུམ་ཞེས་པ་དེ་བཅས་འདུག་ཉིན་གུང་རྗེས་སྣེ་ལེན་གྲ་སྒྲིག་འགན་འཛིན་ཅང་ཧྲང་ཅན་མི་སྣ་ཁག་ཅིག་ཡོང་ནས།",
    "མཚོ་ནུབ་བཅས་ནས་འདུག་ཚང་མས་ལག་བཏང་དམ་པོར་འཇུས་ཏེ་གྲོལ།",
    "ནང་དུ་སླེབས་མ་ཐག་བཅིངས་འགྲོལ་དམག་མི་ལོ་གཞོན་གཉིས་འདུག་པ།",
    "ཨོ་སུག་བཙོང་མཁན་མི་གཉིས་འདུག་པར།",
    "ཁང་པ་གཞན་ཞིག་ཏུ་མཇལ་དུས་བཟོས་འདུག་ཅིང་།",
    "ཐུགས་དགྱེས་པའི་ཐོག་ད་ལན་འཚམས་འདྲི་ཡོད་ཅེས་བཀའ་ཕེབས་འདུག་ཅེས་བརྗོད་པར།",
    "འཚེར་སྣང་ཆེན་པོ་བྱེད་འདུག།",
    "གྲང་ཤུགས་ཆེ་སར་འཁྱགས་རོམ་ཆགས་འདུག་ཅིང་།",
    "ཉི་ཧོང་དུ་བསྒྲོན་པ་ཞིག་བདེ་བཀས་བསྣམ་འདུག་པ་དེ་དེབ་བརྒྱད་པ།",
    "ད་ཆ་ཁྱེད་རང་བོད་དུ་འགྲོ་དགོས་མེད་བརྗོད་དེ་མི་ལོ་ཧྲིལ་པོ་༡༨ རིང་བཙོན་འཇུག་བྱས་བྱུང་།",
    "བོད་སྐད་གཉིས་ཀ་ཐད་ཀར་ཤོད་བདེ་མེད་པ་ཆགས་འདུག་བཟའ་ཟླ་དཀའ་སྡུག་མ་བཟོད་པས་རང་ཤི་རྒྱག་དགོས་ཐུག་ནས་གཏན་བྲལ་དུ་གྱུར་པ་དང་།",
    "ཚོགས་ཁང་ནང་མའི་སྒོ་ནང་དུ་ལི་ཕུ་ཀྲུའུ་ཞི་ཁོ་རང་མར་ཡོང་སྟེ།",
    "ཁྱེད་རང་རྣམ་པས་ཡིད་ཆེས་བྱེད་ཆོག་དེང་བོད་ནང་གཏོར་སྐྱོན་བྱས་པ་རྣམས་བསྐྱར་གསོ་ཤུགས་ཆེན་བྱེད་ཀྱི་ཡོད།",
    "ཁྱེད་རང་རྣམ་པས་གནས་ཚུལ་ཡག་སྡུག་དང་།",
    "ཡང་རང་ཉིད་ནས་དེའི་ལན་དུ།",
    "ཉོ་ཆ་མི་ཐོབ་པའི་དཀའ་ངལ་འདུག་དེབ་བརྒྱད་པ།",
    "དེ་སྔོན་བོད་ཀྱི་སྐུ་ཚབ་ཚོགས་པ་ག་དུས་ཡོང་ན།",
    "དོས་སྐྱེལ་འགོ་པ་གཅིག་འདྲ་པར་མཁན་གཅིག་བཅས་མི་གྲངས་༡ ཆེད་གཏོང་བྱེད་ཀྱི་འདུག་དེབ་བརྒྱད་པ།",
    "སྣེ་ལེན་པ་རྣམས་ཀྱང་ངོ་གདོང་རང་བཞིན་དུ་འགྱུར་ནས་ཉམས་དམའ་དམའ་ལྟ་བུ་བྱེད།",
    "ཁོང་རྣམ་གསུམ་དགུང་ལོའི་བབས་ནས་ངོ་ཐག་ཆོད་འདུག་ཅིང་།",
    "ང་རང་དེའི་རྒྱབ་གནོན་པ་དང་།",
    "བོད་སྐད་ཡག་པོ་ཞིག་རྒྱག་མི་ཐུབ་པར་བློ་ཕམ་འདུག་ཅེས་དང་།",
    "ཨ་འོ་ད་འགྲིགས་ཡོད་འདུག་བསམ་པ་ཞིག་བྱུང་།",
    "༧སྐྱབས་མགོན་ཆེན་པོ་ཡང་ཡང་མཇལ་ཏེ་སྐྱབས་ཞུ་ས་ཡོད་པ་ཞིག་དགོས་ཀྱི་འདུག་ཁྱེད་རྣམ་པས་གསུང་པ་ལྟར་དེབ་བརྒྱད་པ།",
    "ཡིན་ནའང་ང་རང་མ་ཤི་བར་དུ་ནུས་པ་གང་ཡོད་ཀྱིས་སྐྱབས་མགོན་ཆེན་པོ་དང་།",
