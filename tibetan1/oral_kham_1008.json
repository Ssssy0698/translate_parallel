    "སྔགས་དགོན་ཁག་འགའ་ཤས་ཀྱི་ཤུལ་འདུག་ཅིང་།",
    "དེ་འོག་སྤྱི་ཁང་ཡིན་འདུག་ཅིང་།",
    "ཁོ་རང་ལའང་གང་ཡང་མེད་སྟབས་འགྲོ་གྲོན་དང་།",
    "ཀོང་ཇོས་ཀྱང་མིག་ནས་མཆི་མ་ཕྱུང་བཞིན་མགར་གྱིས་བརྗོད་པ་ལྟར་ཡིན་འདུག་སྙམ་སྟེ།",
    "རྒྱ་ཡུལ་ཚ་བ་ཆེན་པོ་ནས་བོད་ཡུལ་གྲང་ངར་ཆེ་སར་སླེབས་དུས་དཀའ་ངལ་ཆེན་པོ་འདུག་མིན་དྲིས་པར།",
    "ད་ཆ་གོམས་ནས་རང་ཡུལ་ལྟར་ཆགས་འདུག་ཟེར།",
    "དོ་ཐང་བར་མའི་གོང་དེར་རྙིང་དགོན་གཏོར་ཤུལ་ཞིག་འདུག་དོ་ཁ་ཚོ་དཔོན་འཆི་མེད་རྣམ་རྒྱལ་ཟེར་བ་དེ།",
    "སང་ཞོགས་སྔ་པོར་སྒོ་འགྲམ་གཡས་གཡོན་དུ་མི་མང་པོ་འདུག་ཀྱང་འགྲོ་ཞོར་ཙམ་དུ་གྱུར།",
    "བོད་དགེ་ཚང་མ་ལོ་གཞོན་ཞེ་གཅིག་འདུག་ཅིང་།",
    "ཧྲུའུ་ཅི་དང་པོ་མགོ་ལོག་ཨ་སྐྱོང་ནས་ཡིན་པའི་ལོ་རྒས་ཤིག་འདུག་པ་དེས།",
    "ཕྱི་རྒྱལ་དུ་ག་ཚོད་ཡག་པོ་ཡོད་ཟེར་ནའང་རང་ཡུལ་དུ་ལོག་ན་ལེགས།",
    "རྒྱ་ལས་རྣམས་ལ་ཤིན་ཏུ་སྐྲག་སྣང་ཆེན་པོ་བྱེད་འདུག་རུ་ཁག་དང་།",
    "ཉམ་དམའ་བའི་རྣམ་འགྱུར་ཐོག་བསྡད་འདུག་དེར་ཡོད་མི་མང་ལ་འཚམས་འདྲི་སྤྱི་མཚུངས་ལྟར་བྱས།",
    "བྱ་བྱེའུ་འདྲ་མིན་འདུག་ཅེས་བརྗོད།",
    "ང་རང་ཁ་ན་བ་ཡིན་ཡང་དཔོན་རུ་སྨད་མའི་ནང་བཞག་བྱུང་།",
    "དེའི་རྩར་ཕྱིན་ཏེ་ཁྱེད་རང་ལ་སྐད་ཆ་འདྲི་འམ།",
    "དེ་མཚམས་ཀའོ་ཀྲུའུ་རིན་ནས་ཁྱེད་རྣམ་པས་འགྲོ་ཕྱོགས་ཕར་གཡུག་ཚུར་གཡུག་བྱེད་འདུག་ཅེས།",
    "དེང་སང་འགྲོ་འགྲེམས་མེད་པས་སྒོ་བརྒྱབ་འདུག་དེ་དགོང་ཟློས་གར་བས་བོད་ལུགས་ཤས་ཆེ་བ་ཞིག་འཁྲབ་ཅིང་།",
    "དེ་སྐབས་མི་མང་ཐར་ཐོར་འདུག་ཀྱང་ཞེད་སྣང་བྱེད་འདུག།",
    "རྙོག་ཟིང་བཟོ་མཁན་དུ་ཡོང་བ་ལྟ་བུ་གང་ས་ནས་དོགས་པ་ཧ་ཅང་ཆེན་པོ་བྱེད་དགོས་པར་ངོས་འཛིན་བྱེད་འདུག་པ་དང་།",
    "མི་མང་ནས་རུབ་བརྒྱབ་སྟེ་སྐད་ཆ་མང་པོ་བྲིས་འདུག་ཀྱང་།",
    "ཁང་སྦུག་དེར་མ་རྒན་ཞིག་ཉལ་སར་ཉར་བཞིན་བྱིས་པ་ཆུང་ངུ་ཞིག་ཉར་ཏེ་འདུག་པ་དེར།",
    "གང་འཚམས་ནས་ང་རང་འཇིགས་མེད་འཕྲིན་ལས་ཀྱི་སྐྱེས་དམན་ཡིན།",
    "མ་ཤི་བ་ཁྱེད་རང་དང་ཐུག་པ་དེ་ཤི་ཚར་བ་རྣམས་དང་ཐུག་པར་ཁྱད་མེད།",
    "ཤ་ཉེའི་ལྟོས་བཅས་ཤི་བརླགས་ཚར་བའི་གནས་ཚུལ་ཤེས་པས་བྱེད་རྒྱུ་བསྡད་པ་གང་ཡང་མི་འདུག་ཅིང་།",
    "ཇ་དམ་ལྟ་བུ་ལས་སྔར་གྱི་ཁྱིམ་ཚང་ལྟར་གྱི་དངོས་ནོར་འདི་འདུག་བསམ་པ་མཐོང་ཡུལ་ན་མ་མཆིས་ཤིང་།",
    "བོད་འདི་རང་ཚུགས་ཟིན་པ་ཞིག་མ་བྱུང་ན་ཁས་ལེན་ནམ་ཡང་མ་བྱེད་ཅེས་སོགས་འཁོད་འདུག་གཞན་ཡང་ཕོ་སར་མང་པོས་ལག་པར་བཟུང་སྟེ་མགོ་མ་འཁོར་ཟེར་བ་སོགས་བྱེད།",
    "བཀའ་བློན་ཕུན་ཚོགས་བཀྲ་ཤིས་ནས་ཕར་ཙམ་དུ་ཆབ་གསང་གནང་བར།",
    "མཚོ་འགྲམ་དུ་ཉ་བཟུང་མཁན་གྱི་སྡོད་གནས་རྒྱ་ཆེ་འདུག་ཉིན་ལྟར་ཉ་ཀྲོན་མང་པོ་རྒྱ་ནག་ཏུ་དབོར་བཞིན་པ་དང་།",
    "སྤྲོད་རྒྱན་ཆས་ཆ་ཚང་བཟོས་རུ་སྒྲིག་བྱས་འདུག་སྦྲ་གུར་ཟུར་དུ་ཕུབ་ནས་གསོལ་ཚིགས་གྲ་རྒྱས་བྱས་འདུག་སྦྲ་གུར་ནང་འཚང་ཁ་བྱས་ཏེ།",
    "དགུང་ལོ་ཆུང་ཆུང་ཡིན་འདུག་སྐུ་གཟུགས་ཐང་པོ་ཡོད་སྟབས་མ་འོངས་པར་བོད་ཀྱི་ས་ཆ་གང་སར་ཕེབས་བཞུགས་མཛད་ཐུབ་ངེས་ཡོད་འདྲ།",
    "ཡག་ཤོས་གྲས་ཡིན་འདུག་པ་དང་།",
    "སྡུག་ཐོག་སྡུག་རྩེགས་ཀྱི་འོག་ཏུ་བོད་མི་ཚུད་ནས་འདུག་མི་མང་དེ་ཚོ་བརྙན་པར་བླངས་ཡོད།",
    "ལྷ་སར་ལྟ་སྐོར་བྱ་རྒྱུར་ས་གནས་ནས་དགའ་བསུ་ཞུ་ཡི་འདུག་ཟེར།",
    "དེས་རྒྱལ་ཁབ་ལ་གནོད་ཀྱི་འདུག་མི་ལོ་༢ རིང་འབྲེལ་བ་ཆད་པ་དེ་ད་ཆ་འབྲེལ་དེབ་བརྒྱད་པ།",
    "བཀྲ་ཤིས་སྟོབས་རྒྱལ་ཅན་གྱིས་ཇོ་བོར་མཇལ་དར་ཕུལ་ཟིན་ནས་ཕྱིར་ཐོན་ཟིན་འདུག་རང་ཉིད་ནས་གོང་ས་ཆེན་པོའི་མཇལ་དར་དེ་སྔོན་དུ་ཕུལ།",
    "བོང་བཞག་རྗེས་ཙམ་གྱི་ཨི་ཁུང་ཞིག་འདུག་དེ་སྔ་ཡོད་མེད་ནི་ཅི་ཡང་མི་ཤེས།",
    "དེ་སྔ་ལྟར་སྐྱོན་ཆ་མ་བྱུང་བར་འདུག་སྣེ་ཤན་པ་རྣམས་ཀྱིས་མར་ཁུ་གོ་སྒྲིག་འདུག་པས་གསེར་ཀོང་རྣམས་མར་ཁུས་བཀངས།་",
    "མི་དེའི་བསམ་ཚུལ་སྡུག་པོ་ཞིག་འདུག་བསམ་པ་བྱུང་།",
    "ལན་དུ་སྒྲུབ་ཞག་དགོས་པ་མི་འདུག་ཟེར།",
    "སྟེང་དུ་འཚང་ཁས་ཁེངས་ནས་འདུག་དེ་རྣམས་ལ་འཚམས་འདྲི་ཞུ་བ་དང་།",
    "ཨ་གཅེས་ཀྱང་ཤི་མི་འདུག་པར།",
    "དེ་ནས་བོན་ཤོད་ལྷ་ལྕམ་ཡོད་མེད་ལྟ་བར་ཕྱིན་པས་རྒྱབ་ཕྱོགས་ཀྱི་ཁང་ཆུང་ཞིག་ཏུ་འདུག་ངོས་རང་ངོ་སྤྲོད་བྱས་པར་སྐྲག་ཐག་ཆོད་ནས་ཁ་གྲགས་མི་ཕོད་པ་བྱེད།",
    "གང་འཚམས་ནས་མིག་ཆུ་བཏང་སྟེ་ངུ་ནས་འདུག་པར།",
    "ཁང་ཁུང་དེའི་བར་འགག་དེར་ན་གཞོན་མི་བཞི་རྐང་སྒ་རིལ་ཟིན་ནས་འགྲོ་ཆོག་ཏུ་འདུག་པ་རྣམས་ཀྱང་ནང་དུ་འཛུལ་བྱུང་།",
    "སྤྲོ་སེང་ཁག་ལྟ་བུ་ཆུང་ཆུང་ཞིག་འདུག་བཀའི་བློན་ཕུན་ཚོགས་བཀྲ་ཤིས་ནས།",
    "བོད་ཀྱི་ལྷ་སྐུ་གཏོར་བའི་སྐུ་རྒྱུ་རྣམས་ཕུང་བརྩེགས་ཀྱིས་ཁེངས་འདུག་འདི་དག་གང་ཡིན་དྲིས་པར།",
    "ཁོང་ནི་གཞན་ལས་རྒྱས་སྤྲོས་ཆེ་ཙམ་འདུག་ཅིང་།",
    "དུས་ཚོད་སྤྲོད་དགོས་བརྗོད་འདུག་པར།",
    "ཁྱེད་རང་རྒྱ་མི་རིགས་ཀྱི་གདོང་གཤིས་དང་།",
    "ཡང་རང་ཉིད་ཀྱིས་ཁྱེད་རང་དེ་འདྲའི་ཁྲེལ་ཁྲེལ་བྱེད་དགོས་ཀྱི་ཡོད་ན།",
    "ཁྱེད་རང་ནས་ལོས་ཤེས།",
    "ནང་དུ་ཕྱིན་པར་གང་ཡང་མི་འདུག་ཁོང་གཉིས་བཀའ་བློན་དང་ཐུག་དུས་ངུས་ནས་བསྡད་པ་ལས་གང་ཡང་ཤོད་མི་ཐུབ།",
    "སློབ་ཕྲུག་ཚོར་གྲལ་རིམ་འཐབ་རྩོད་ཀྱི་སློབ་སྦྱོང་རང་བཞིན་ཅན་འདི་ལྟ་བུ་ཡིན་དུས།",
    "ད་ལྟ་བརྗེ་བསྒྱུར་མ་ཐུབ་པར་ལྷག་འདུག་ཟེར།",
    "མི་དེས་ཐོག་མར་སྣེ་ལེན་སྐབས་ཁྱེད་རང་བདེ་འམ་ཞེས་བརྗོད་པར།",
    "ཆབ་གྲོས་ཀྱི་རྒྱུན་ལས་ཨུ་ཡོན་ཁ་ཤས་བཅས་འཛོམས་ཏེ་སྒུག་ནས་འདུག་ཟེར།",
    "ཟངས་ལྕགས་སོགས་ཀྱི་ལས་མི་ཁག་ཅིག་ཀྱང་འདུག་སྤྱི་ཁང་དེའི་ཀྲུའུ་རིན་དང་རྒྱལ་ཡོངས་ཆབ་གྲོས་ཀྱི་ཨུ་ཡོན་གཅིག་ལྕོགས་ཡིན་ཟེར་བའི་ཞིང་པ་རྒན་པོ་ཞིག་ནས།",
    "ཁོང་རང་ནས་ཆང་དཀར་ཡོལ་གསུམ་བཏུད་མར་བཏུང་།",
    "གྱོན་རྒྱུ་ཞིག་ཡོང་བཟོ་འདུག་མིན་ལྟ་རུ་ཡོང་བ་དེ་འདྲ་མིན།",
    "དེ་སྐབས་བསམ་བློ་གསར་པ་ཞིག་འཁོར་རྒྱུ་འདུག་ད་དུང་མུ་མཐུད་འབྲེལ་བ་དང་།",
    "སོགས་ཡག་པོ་འདུག་རུང་།",
    "སྲོག་མགོ་མི་ཐོན་པ་བྱེད་འདུག་གང་ལྟར་ཕན་ཐོགས་ཡོད་པ་བྱེད་ཐུབ་མ་བྱུང་།",
    "གང་ལྟར་འཆར་དངུལ་བེད་སྤྱོ་ཐུབ་ཀྱི་མི་འདུག་གུས་རང་རིག་རྩལ་བདག་ཐོབ་དང་།",
    "གཡའ་ལུང་ནས་ཡིན་པའི་རྒས་པོ་ཞིག་འདུག་པ་དེར།",
    "སྒོ་ལྕགས་ཀྱང་བརྒྱབ་པ་མི་འདུག་ཁྱིམ་ཞིག་ཏུ་རྒས་པོ་ཁེར་བུ་ཞིག་ཡོད་པ་ལ།",
    "ཁྱེད་རང་ནས་མཐོང་བྱུང་ངམ་དྲིས་ལན་དུ།",
    "ཁྱེད་ཀྱི་བུ་ལྔ་པོ་དེ་བསྟན་སྲིད་ཀྱི་དགྲ་བོ་ལྔ་ལོས་ཡིན་བརྗོད་བཞིན་ཁང་པར་འདྲ་པར་ཞིག་བརྒྱབ།",
    "ཆང་ཁང་སྦྲེལ་མའི་ཚོང་ཁང་ཞིག་འདུག་པའི་ནང་མི་འདུས་ཆེན་པོར་བྱེད་པར།",
    "སྐད་ཆ་ཤོད་ཕོད་མཁན་མི་འདུག་སྟེ།",
    "ད་ཆ་མིའི་དགོས་མཁོ་འཛོམས་པའི་ཆ་རྐྱེན་བཟང་པོ་ཡོད་ཚུལ་ཡང་བརྗོད་འདུག་ད་དུང་གློག་ཁང་འདིར་ཤུགས་ཚད།",
    "དམའ་ཤོས་ལ་ཤོག་སྒོར་༤ ནས་༤༥ བར་ཡོད་འདུག་གློག་ཁང་འགོ་བྱེད་རྒྱ་སྐད་དུ་ཁྲང་འགྲམ་ཞེས་དང་།",
    "མཚན་ཉིད་ཚང་བ་གང་ཡང་མི་འདུག་དཔེར་ན།",
    "ཁོ་རང་བཟོ་ལས་པ་རིམ་པ་གསུམ་པ་ཡིན།",
    "ད་ཡིན་ན་བསམ་བློ་གསར་པ་ཞིག་འཁོར་གྱི་འདུག་ཀྱང་།",
    "བོད་མི་མང་སྡུག་བསྔལ་གྱི་འོག་ནས་ཤི་བ་རྣམས་གྲངས་ཀ་ཐེབས་ས་མེད་ཅེས་བརྗོད་འདུག་དེབ་བརྒྱད་པ།་",
    "འགྱོད་ཀྱང་ཕན་པ་ནི་མི་འདུག་དེ་དགོང་རྩེད་ཐང་དུ་འབྱོར།",
    "ཞིང་ས་དང་ཆུ་གཉིས་མཐོ་དམའ་ཆེན་པོ་ཡོད་པས་ཞིང་ཆུ་འདྲེན་ཁག་པོ་འདུག་ད་བར་ཆུ་ཡུར་ཁག་༤༥༡ བཟོས་ཡོད།",
    "ཁོ་རང་ལ་སྐར་ཆ་མཐོ་ཤོས་༡༡ ཐོབ་མཁན་ཡིན།",
    "ཁོ་རང་ནི་གནས་སྟངས་དྲག་ཤོས་གྲས་ཡིན་འདུག་ཆབ་གྲོས་པ་མི་གྲངས་༢ སྐོར་ཡོད་ཁོངས་སྔར་གྱི་མི་དྲག་དང་།",
    "སྒྲུབ་གནས་སོགས་ཕྱི་ནང་རྟེན་བཅས་གང་ན་ཅི་ཡོད་ཤུལ་མེད་རྩ་གཏོར་བཏང་ཟིན་ནས་ལུང་པ་ནག་པོ་ཀླ་ཀློའི་ཡུལ་ཇི་ལྟ་བ་བཟོས་འདུག་པ་དང་།",
    "མིའི་བྱ་སྤྱོད་ལས་ཡོངས་སུ་འདས་པ་འདི་ལྟ་བུའི་བྱ་བ་ངན་པ་བཟོས་འདུག་ཡུལ་ཡར་ལུང་ཞེས་པ་འདི་ནི།",
    "དེར་མི་མང་སྡོད་ཁང་སྔར་གྱི་བོད་ལུང་ལྟར་རྒྱས་སྤྲོས་ཅན་ཆེན་པོ་ཞིག་གསར་རྒྱག་བྱས་འདུག་མི་མང་སྡོད་གནས་གསར་རྒྱག་བྱས་པ་མཐོང་བ་དང་པོ་ཡིན།",
    "ད་དམིགས་བསལ་ཞུ་རྒྱུ་ཅི་ཡང་མི་འདུག་ཁྱེད་ཀྱིས་མ་མཁྱེན་པ་གང་ཡང་མེད་ཟེར།",
    "བང་སོའི་ཉེ་འཁྲིས་དེར་རྡོ་རིང་ཞིག་འདུག་པ་དེའི་ཐོག་ཡི་གེ་ཡོད་པའི་བརྗོད་དོན་དུ།",
    "ཁྲི་སྲོང་ལྡེའུ་བཙན་ལ་བསྟོད་བསྔགས་ཕུལ་འདུག་པ་དེ་ལ་བརྟག་ན།",
    "ཅ་དངོས་བཟོ་བསྐྲུན་བྱས་པ་ཕྱིར་ཚོང་བྱ་ཐུབ་པ་མེད་སྐྱོན་ཡིན་འགྲོ།",
    "ལས་སྣེ་བ་ཚང་མ་བོད་མི་ཁེ་གཙང་ཡིན་འདུག་པ་དང་།",
    "ངོས་ནས་ཁྱེད་རང་བོད་ནང་ཇི་ཙམ་བཞུགས་སམ་དྲིས།",
    "སྐུ་སྐེད་ནས་ཐུགས་ཀ་བར་སྟོང་པར་བྲུས་ཏེ་སྲོག་ཤིང་མཇལ་བ་བྱས་འདུག་བྱེད་སྟངས་འདི་འདྲ་ནི།",
    "དེའི་སྐོར་གཡས་གཡོན་དུ་རྐང་འོག་འབོལ་པོ་བྱེད་འདུག་པར།",
    "ད་ལྟའང་གསལ་པོར་བསྡད་འདུག་དེ་ལས་ཡར་ཙམ་ནས་ཟམ་པ་གསར་རྒྱག་བྱས་པ་ནི་སྤུས་དག་ཕན་ཐོགས་ཡོད་ངེས་ཤིག་འདུག་ཡར་ལུང་གཙང་ཆུའི་ཟམ་པ་བརྒལ་ཏེ་ཆུ་ཤུར་གྲོང་དུ་འབྱོར་བ་དང་།",
    "ཁར་སེང་ཁྱེད་རྣམ་པ་ལྷ་སར་ཕེབས་སྐབས་ང་རང་ཡང་ལྷ་སར་ཡོད།",
    "ཤིན་ཏུ་ཐབས་སྐྱོ་པོ་ཆགས་ཀྱི་འདུག་དེ་ནས་མཉེས་ཐང་སྒྲོལ་མ་ལྷ་ཁང་དུ་འབྱོར།",
    "སྐུ་བརྙན་མང་ཙམ་བཞུགས་འདུག་པ་དང་།",
    "སྒོ་ཤུལ་ཟུར་ཆུང་ཞིག་ཡོད་པ་དེའི་ནང་བླ་བྲེ་རྩ་ཆེ་ཞིག་སྣང་མེད་དུ་ནམ་མཁར་རྒྱངས་ནས་འདུག་པར།",
    "ལྷ་ཁང་དེ་གཏོར་སྐྱོན་ཆུང་ཡག་བདག་མེད་བཞག་པའི་སྐྱོན་ཆེན་པོ་བྱུང་འདུག་སྔོན་དུ་ལྷ་ས་ནས་གཞོན་ནུ་འགའ་ཞིག་ནས་ཡང་ཡང་བརྗོད་དོན་དུ།",
    "འཚོ་གོས་སུས་སྤྱད་པ་དེར་བཀའ་དྲིན་ཆེ་བ་ངོ་ཤེས་དགོས་ཞེས་སོགས་བརྗོད་དེ་ལས་འགུལ་བྱས་འདུག་པ་དང་།",
    "དེ་མིན་ཕན་ཚུན་གཉིས་ངལ་སྡུག་ཏུ་འགྲོ་གཞི་ཆགས་དགོས་དོན་མི་འདུག་སྙམ་པ་ཞེས་བརྗོད།",
    "འབང་ང་ཐང་ཞེས་པར་གནས་འདུག་རྫ་ཡུལ་ཤན་གྱི་ཧྲུའུ་ཅི་གཏིང་པ་རིགས་ཡིན།",
    "སྔ་ལོར་བྱུང་སྒོར་དུང་ཕྱུར་༣ ལྷག་ཙམ་འདུག་དཔེར་ན།",
    "བོད་རིགས་ལས་བྱེད་བརྒྱ་ཆ་༣ ཙམ་ཡིན་འདུག་པར།",
    "དེ་འདྲའི་དགོས་མཁོའི་མཐུན་རྐྱེན་འཛོམས་ཀྱི་མི་འདུག་དཔེར་ན།",
    "ད་ཆ་ཡག་པོ་འདུག་སྟེ།",
    "དེ་རྗེས་བོད་གྲུམ་རང་དུ་བཟོ་རྒྱུའི་གཏན་འབེབ་ཀྱིས་ཡར་རྒྱས་འགྲོ་མུས་ཡིན་ཚུལ་ལྟར་འདུག་དེར་ཡོད་འགོ་ལས་རྣམས་ནས་དགའ་གུས་ཚད་ལས་འདས་པ་བྱེད།",
    "གྲྭ་ཆས་ཅན་༢ སྐོར་འདུག་ཅིང་།",
    "བཀའ་བློན་ཐུབ་བསྙན་ཉིན་བྱེད་ཀྱི་སྐུ་ཉེ་ཕྲན་བུ་འགྲོ་མཁན་ཡིན་འདུག་པ་དང་།",
    "ལོ་རྗེས་མར་དགོངས་པ་ཞི་དབྱིངས་སུ་གཤེགས་འདུག་པ་ནི་དེ་བས་བློ་ཕམ་ཆེ་བ་བྱུང་།",
    "མིན་གྱི་ཚོར་བ་ཡོད་འདུག་པ་ནི་ཧ་ལས་པ་ཞིང་སྣང་།",
    "ད་ཆ་འགྱུར་ལྡོག་ཆེན་པོ་བྱུང་འདུག་གམ་ཞེས་གསུངས།"
  ]
