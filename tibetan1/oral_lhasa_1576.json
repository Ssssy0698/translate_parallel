    "སྟོང་པ་ཉིད་དུ་རྣམ་པར་རྟོག་པ་ཡང་སྤོང་པར་འདོད་པའི་ཕྱིར་རོ།",
    "མི་སྟོང་ཞེས་བྱ་བར་མི་མཐོང་ངོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ལྟ་བུའོ།",
    "ཤེས་རབ་དང་བློ་སྐྱེས་སོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་དངོས་པོ་སྒྱུ་མ་ལྟ་བུའི་ངོ་བོ་ཉིད་དག་སྐྱེ་བ་མེད་པ་ལ་སོགས་པར་མཐོང་བ་ནི་འཕགས་པའི་བདེན་པ་མཐོང་བ་ཡིན་ཏེ།",
    "སྟོང་པ་ཉིད་མ་ཡིན་པར་སྨྲ་བ།",
    "གང་སྟོང་པ་ཉིད་མ་ཡིན་པར་སྨྲ་བ་ལ་ཇི་སྐད་བསྟན་པ་ཐམས་ཅད་མི་རུང་བར་འགྱུར་རོ།",
    "རྟ་ཉིད་བརྗེད་པར་གྱུར་པ་བཞིན།",
    "ཡོད་པར་རྗེས་སུ་ལྟ་བྱེད་ན།",
    "རྒྱུ་དང་རྐྱེན་ལ་མ་ལྟོས་པར་འབྲས་བུ་ལ་སོགས་པར་མི་འགྲུབ་པའི་ཕྱིར་རོ།",
    "གང་ཞིག་རྐྱེན་ལ་ལྟོས་པ་དེ་སྟོང་གསུངས།",
    "ཞེས་གསུངས་པ་དང་།",
    "རྣམ་པར་རིག་པ་མ་ཡིན་པ།",
    "གནས་མེད་པའོ་ཞེས་གསུངས་པ་དེ་དག་གྲུབ་པོ།",
    "དེ་ལ་འདིར་སྟོང་པ་ཉིད་འགྲུབ་པར་མི་འགྱུར་ཏེ།",
    "ཚིགས་སུ་བཅད་པ་འདི་ནི་རྣམ་པར་རྟོག་པའི་དྲི་མ་འཁྲུ་བར་བྱེད་པ་ཡིན་ན།",
    "འོན་ཀྱང་འདོགས་པར་བྱེད་ན་དེ།",
    "གནས་མ་ཡིན་པར་འདོགས་པར་བྱེད་དོ་ཞེས་མཁས་པ་རྣམས་ཀྱིས་ཁྲེལ་བར་འགྱུར་བ་དེ་བཞིན་དུ།",
    "གལ་ཏེ་སྡུག་བསྔལ་མི་སྟོང་པར་གྱུར་ན།",
    "གང་དེ་ལྟ་བུར་གྱུར་བ་དེ་ནི་ཐ་སྙད་དུ་ཡང་ཡོད་པར་ཤེས་པར་མི་ནུས་ན།",
    "དོན་དམ་པར་ལྟ་སྨོས་ཀྱང་ཅི་དགོས།",
    "སྡུག་བསྔལ་ཡོད་པར་ག་ལ་འགྱུར།",
    "མི་རྟག་སྡུག་བསྔལ་གསུངས་པ་དེ།",
    "ངོ་བོ་ཉིད་ཀྱིས་བྱས་པ་མ་ཡིན་པར་གནས་པ་ལ་འགོག་པ་མི་འཐད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་དགོངས་། སོ།",
    "གང་ཞིག་འཐོབ་པར་འགྱུར་བར་འདོད།",
    "གལ་ཏེ་སྡུག་བསྔལ་ངོ་བོ་ཉིད་ཀྱིས་ཡོངས་སུ་ཤེས་པ་མ་ཡིན་ན་ཇི་ལྟར་ཡོངས་སུ་ཤེས་པར་འགྱུར་ཏེ།",
    "ཁྱེད་ཀྱི་གཞུང་ལས་ངོ་བོ་ཉིད་ནི་མི་འགྱུར་བར་གནས་པ་ཡིན་པར་འདོད་པའི་ཕྱིར་རོ།",
    "ངོ་བོ་ཉིད་ཀྱི་འབྲས་བུ་མངོན་སུམ་དུ་མ་བྱས་པ་ལས་ལན་ཅིག་ཕྱིར་འོང་བ་དང་།",
    "ཅི་སྟེ་འབྲས་བུ་ཐོབ་པར་འདོད་ལ།",
    "ངོ་བོ་ཉིད་ཡོད་པར་སྨྲ་བ་ཡང་མི་བཏང་ན།",
    "དེ་ལ་བརྒལ་ཞིང་བརྟག་པར་བྱ་སྟེ།",
    "ཇི་ལྟར་ཐོབ་པར་ནུས་པར་འགྱུར།",
    "ངོ་བོ་ཉིད་ཡོངས་སུ་འཛིན་པས་འབྲས་བུ་ངོ་བོ་ཉིད་ཀྱིས་མ་ཐོབ་པ་གང་ཡིན་པ་དེ་ཐོབ་པར་མི་ནུས་སོ།",
    "ངོ་བོ་ཉིད་ནི་བྱས་པ་མ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "ནམ་ཡང་བྱེད་པར་མི་འགྱུར་ཏེ།",
    "ངོ་བོ་ཉིད་ལས་ཡོད་པ་མ་བྱས་པ་ལ་བྱེད་པ་མི་འཐད་པའི་ཕྱིར་རོ།",
    "གང་ཡང་འདི་སྐད་ཅེས་ཁྱེད་ཅག་གང་ངོ་བོ་ཉིད་ལས་ཡོད་པའི་སྐྱེ་བ་ལ་སོགས་པ་དགག་པ་སྨྲ་ཞིང་ངོ་བོ་ཉིད་མེད་པ་ཉིད་སྒྲོགས་པར་བྱེད་ན།",
    "མ་བྱས་པ་ལ་ངོ་བོ་ཉིད་ཡོད་པ་དེའི་དཔེ་ཇི་ལྟ་བུ་ཡིན་པ་བརྗོད་པར་བྱ་དགོས་སོ་ཞེས་ཟེར་ན་དེ་ནི་རིགས་པ་མ་ཡིན་ཏེ།",
    "ཁོ་བོས་མི་མཐུན་པའི་ཕྱོགས་ཡོངས་སུ་བརྟགས་ན་ནི་གཏན་ཚིགས་བཟློག་པ་ཡང་བརྗོད་པར་བྱ་དགོས་ན།",
    "འདི་ལ་གང་དང་གང་བྱས་པ་དེ་དང་དེ་ངོ་བོ་ཉིད་མེད་པར་མཐོང་སྟེ།",
    "གལ་ཏེ་འགའ་ཞིག་ངོ་བོ་ཉིད་ཡོད་པར་གྱུར་ན་དེ་ནི་དེ་ལས་བཟློག་པའི་ཕྱིར་མ་བྱས་པའི་ངོ་བོ་ཉིད་ཡིན་པས་ངོ་བོ་ཉིད་ཡོད་པར་སྨྲ་བས་ནི་འབད་པ་ཆེན་པོ་མ་བྱས་པ་ལ་ངོ་བོ་ཉིད་ཡོད་དེ།",
    "དཔེར་ན་འདི་འདྲའོ་ཞེས་བརྗོད་པར་བྱ་དགོས་པས་དེའི་ཕྱིར་དེ་ནི་གྱི་ནའོ།",
    "སྒྱུ་མ་བྱས་པའི་གླང་པོ་ཆེ་བཞིན་ནོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "སྟོང་པ་ཉིད་ལའང་གནོད་པར་བྱེད།",
    "བྱ་བ་རྩོམ་པའང་མེད་པར་འགྱུར།",
    "མི་བྱེད་པ་ཡང་བྱེད་པར་འགྱུར།",
    "ཐེར་ཟུག་ཏུ་ཡང་གནས་པར་འགྱུར།",
    "བྱས་པ་མ་ཡིན་པ་ལ་འཇིག་པ་མེད་པའི་ཕྱིར་རོ།",
    "མ་ཐོབ་ཐོབ་པར་བྱ་བ་དང་།",
    "འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པའི་ཐོབ་པར་བྱ་བའི་ཁྱད་པར་དང་།",
    "སྡུག་བསྔལ་མཐར་འབྱིན་པར་བྱེད་པའི་ལས་དང་།",
    "དེའི་ཕྱིར་དེ་ལྟར་དངོས་པོ་དང་དངོས་པོ་མེད་པར་ལྟ་བ་ལ་སོགས་པའི་སྐྱོན་གྱི་རབ་རིབ་དང་བྲལ་བའི་བློ་གྲོས་ཀྱི་མིག་ཅན།",
    "གལ་ཏེ་སྡུག་བསྔལ་བ་ལ་སོགས་པའི་རྣམ་པ་དག་མ་གཏོགས་པར།",
    "འདི་ན་སྡུག་བསྔལ་ལ་སོགས་པ་ཇི་ལྟར་མཐོང་ན་བདེན་པ་མཐོང་བ་ཡིན་ཞེས་དཔྱད་པར་བྱ་བ་ཡིན་གྱི།",
    "སྨྲས་པ་དག་ཕྱིར་བཟློག་པའི་སྒོ་ནས་རབ་ཏུ་བྱེད་པའི་དང་པོར་སྨྲས་པའི་གཏན་ཚིགས་མི་མཐུན་པའི་ཕྱོགས་འབའ་ཞིག་ལ་ཡོད་པར་བསྟན་པས་འཕགས་པའི་བདེན་པ་རྣམས་ངོ་བོ་ཉིད་མེད་པ་ཉིད་དུ་བསྟན་པ་ཡིན་ནོ།",
    "བྲལ་བ་གང་ཡིན་པ་དེ་ནི་མྱ་ངན་ལས་འདས་པའོ་ཞེས་ཀྱང་གསུངས་ལ།",
    "དེ་ཡི་སེམས་ནི་རྣམ་པར་གྲོལ།",
    "ཞེས་ཀྱང་གསུངས་སོ།",
    "མྱ་ངན་ལས་འདས་པ་ཐོབ་པ་དེ་ཡང་ངོ་བོ་ཉིད་ཡོད་པ་འདི་མ་གཏོགས་པར་གཞན་གྱིས་མི་འཐོབ་པས་དེའི་ཕྱིར་དངོས་པོ་རྣམས་ངོ་བོ་ཉིད་ཡོད་པ་ཉིད་དུ་འདོད་པར་བྱའོ།",
    "ཇི་ལྟར་སྒྱུ་མའི་མར་མེ་ངོ་བོ་ཉིད་དང་བྲལ་བ་འཆི་བ་ཐ་སྙད་དུ་གཏོགས་པའི་བློའི་སྤྱོད་ཡུལ་དུ་ཡོད་པར་མི་འགལ་བ་དེ་བཞིན་དུ་འདུ་བྱེད་རྣམས་ངོ་བོ་ཉིད་མེད་པ་ཡིན་ཡང་ཐོག་མ་མེད་པའི་རྐྱེན་བརྒྱུད་པ་ལས་སྐྱེས་པ་སྒྱུ་མ་དང་།",
    "དེའི་འཐོབ་པ་ཡང་འགྲུབ་པའི་ཕྱིར་ངོ་བོ་ཉིད་ཡོད་པ་ཉིད་རིགས་པ་དང་ནི་ལྡན་པར་ཤེས་པར་བྱའོ།",
    "དེའི་ཕྱིར་ངོ་བོ་ཉིད་ཡོད་པར་སྨྲ་བ་དག་ཉིད་ལ་མྱ་ངན་ལས་འདས་པའི་ཐོབ་པ་ཡོད་པ་བསྟན་དཀའོ།",
    "ངོ་བོ་ཉིད་མེད་པ་ཉིད་ལ་ནི་སྒྱུ་མའི་མར་མེ་འཆི་བ་བཞིན་དུ་མྱ་ངན་ལས་འདས་པ་ཐོབ་པ་ཡོད་པར་རུང་ངོ།",
    "འདུ་བྱེད་དེ་དག་དོན་དམ་པར་ངོ་བོ་ཉིད་ཡོད་པ་ཁོ་ནར་ཤེས་པར་བྱ་སྟེ།",
    "ངོ་བོ་ཉིད་ཡོད་པས་ངེས་པར་གནས་པ་ངོ་བོ་ཉིད་མི་འགྱུར་བ་ལ་དེ་དག་མི་འཐད་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་དོན་དམ་པར་འཐོབ་པའི་ཕྱིར་དེ་ལ་གལ་ཏེ་ཐ་སྙད་དུ་ནི་གྲུབ་པ་ལ་སྒྲུབ་པ་ཡིན་ནོ།",
    "དོན་དམ་པར་ནི་ཁོ་བོ་ཅག་སྤངས་པ་མེད་ལ་ཐོབ་མེད་པ།",
    "དེ་ནི་མྱ་ངན་ལས་འདས་པར་འདོད།",
    "མྱ་ངན་ལས་འདས་པ་རྫས་སུ་ཡོད་པར་སྨྲ།"
  ]
}