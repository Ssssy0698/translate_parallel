    "ལྕགས་བསྲེགས་ལྟ་བུའི་རྡོ་རྗེ་གཞོན་ནུ་རི་བོ་ཆད་པ་ཙམ་པ་རྭ་ལོའི་ཐོག་ཏུ་རྔམས་རྔམས་འཆའ་འཆའ་ལྟར་འདུག་པས་སྐྲག་པར་གྱུར་ཏེ།",
    "དཀྱིལ་འཁོར་དུ་བཀོད་པའི་ལྷ་ཕུར་ཚོ་བྲོ་པ་དོ་རར་ཞུགས་པ་བཞིན་དུ་ཅོད་པ་ན་ཟིང་ཟིང་འཁྲབ་ཅིང་མེ་སྟག་ཕྲོམ་ཕྲོམ་འདུག་གཅེན་ལ་འདི་ལྟར་གདའ་བྱས་པས།",
    "པོ་ཏི་བསེ་གླེགས་ཅན་ཡང་མི་འདུག་དེ་སུ་ལ་འདུ་ག་ལ་དེ་ལ་མགོ་སྐྱེལ་བ་ལ་ཟེར།",
    "པོ་ཏི་བསེ་གླེགས་ཅན་སུ་ལ་འདུག་པ་ལ་མགོ་སྐྱེལ་བ་ཡིན་ཟེར་བས་ཡང་དུའང་མ་དགའ།",
    "གནུབས་སྟག་རམ་གྱིས་ཁྱེད་རང་ལང་ལབ་བྱུང་ཆུབ་རྡོ་རྗེའི་ཕུར་ཐུང་དེས་རྒོད་པ་འདུག་སྟེ།",
    "གཉིད་སད་ཙ་ན།",
    "ད་རྒས་ནས་བརྗེད་དེ་མི་གདའ།",
    "མི་ཡུལ་དུ་ལོ་ཉིས་བརྒྱ་ལྷག་ཙམ་བཞུགས་ངེས་སུ་འདུག་གོ།",
    "འདི་ལ་འབྲེ་ཨ་ཙཱ་རྱ་ས་ལེ་བྱས་ཙ་ན་ལང་ལབ་ཀྱི་བར་དང་དེ་གཉིས་ཕྱི་ཐག་རིང་པས་བརྒྱུད་པ་ལྟག་མི་འཕྲོ།",
    "འབྲེ་ཨ་ཙཱ་རྱ་ནུ་རུ་ཞེས་བྱ་བས་ཚེའི་གྲུབ་བ་ཐོབ་པ་ཡིན་ཞེས་ཟེར་བའང་འདུག་སྟེ།",
    "སྤྲང་པོ་ལ་འདུག་ཀྱང་ཞུའོ་ཞེས་བཙལ་བས།",
    "རུས་མུར་ཟེར་བ་སོགས་མི་བརྒྱུད་སོ་སོ་ལ་ཡོད་པ་འདུག་ཅིང་གཙོ་ཕུར་ནི་ཀ་པ་རིའི་འབྲང་བུ་ལ་ཡོད་པརགྲགས་སོ།",
    "འདི་ལྟར་འདུག་ཅེས་མི་རྣམས་ལ་སྨྲས་པ་ཐོས་ཏེ།",
    "དགེ་སློང་ལྔ་མ་ཚང་བས་མི་འོང་གསུངས་པ་ལ་སྔར་ལྷ་ལུང་དཔལ་རྡོར་ཅན་གསུམ་གློང་ཐང་ན་འདུག་པ་མཐོང་ནས་འཚོལ་དུ་ཕྱིན་པས་རྙེད་དེ།",
    "ལྷོ་བྲག་རྔ་མང་ཆུ་ཤུལ་དུ་འཁྲུངས་ཟེར་བ་ཨོ་རྒྱན་གླིང་པའི་གཏེར་འབྱུང་ན་འདུག་ཅེས་དང་།",
    "གཞན་ཅི་འདུག་གཡེངས་པས།",
    "འོན་ཀྱང་མང་ཡུལ་བྱམས་སྤྲིན་ནས་ག་ཏེར་སྟོན་སྐུརྨ་སེདྷ་ཟེར་བབ་གཏེར་བཏོན་སྐད་མི་འདུག་ཀྱང་།",
    "ཐང་ཡིག་ཚིག་བཅད་ལྷུག་ཕལ་ཆེར་ལ་འདུག་ཀྱང་།",
    "ཡིག་རྙིང་འགའ་ཞིག་ཏུ་རྫིར་བཞེས་ཡོད་འདུག་པ་ཧོར་གྱི་མིང་ཡིན་ཟེར་ཏེ།",
    "ཛམ་དམར་དང་གནོད་སྦྱིན་རྡོ་རྗེ་བདུད་འདུལ་གྱི་སྒྲུབ་ཐབས་སུ་འདུག་ལས་འབྲེལ་ཡོད་པར་དགོངས་ནས་སྔགས་བཟླས།",
    "དེ་ལྟར་ཕའུ་པ་དང་ར་ཤག་དུས་མཚུངས་གྲུབ་པས།",
    "བལྟས་ཙ་ན་རྣལ་འབྱོར་པ་རུས་པའི་རྒྱུན་ཅན་ཞིག་འདུག།",
    "ཏེར་ནས་བཏོན་གཏེར་བདག་ཁྱེད་རང་ཡིན་ཟེར་ཕུལ།་",
    "དུས་སྔ་ཕྱི་མི་འགྲིགས་པར་འདུག་ཀྱང་བབས་ལ་བརྟགས་ན་འབྲེལ་ཆགས་ཙམ་ཞིག་སྣང་བས།",
    "བོད་ལ་བསྟན་པ་ཕྱི་དར་གྱི་སྐབས་ཤིག་ཙ་ན་རྒྱུ་གར་ལ་བློ་གྲོས་ཅུང་ཟད་རྣོ་ལ་གསེར་ཟོང་རྙེད་པའི་རྐང་པ་ཡང་བ་ཐམས་ཅད་ཀྱིས་དེང་སང་ཁམས་པ་པ།",
    "དེ་ནས་མཁའ་འགྲོ་མ་གདོང་པ་བཞི་པ་ཞིག་འདུག་པའི་མདུན་ཞལ་དཀར་པོ་ནས།",
    "སངས་རྒྱུས་དངོས་སུ་གདའ་ལགས་ཞུས་པས།",
    "གཏེར་རྫས་མང་པོ་དེང་སང་ཡང་མཇལ་རྒྱུ་འདུག་གོའདིའི་དུས་རྟགས།",
    "འདི་བེ་རོ་ཙ་ནའི་གཏེར་ཁ་ཡིན་ཏེ་ཚོས་བོན་གཉིས་ཀའི་གཏེར་ཐོན་པར་གྲགས་ཤིང་།",
    "མི་ཐུབ་ལྔ་འབྱུང་རང་ལ་ཡིད་མི་ཆེས",
    "གཏེར་འདི་རྣམས་འདོན་པའི་ལུང་བསྟན་པ་ནི་ཁྱེད་དུ་འདུག་པས།",
    "ཁྱེད་གཏེར་ལུང་དང་མཐུན་པའི་མི་དེ་ཡིན་འདུག་པས་འབུལ་ཟེར་ནས།",
    "བྲག་ཆོལ་གྲུ་གསུམ་པ་ཞིག་འདུག་པ་བྲུས་པའི་ནང་ནསབསེ་སྒྲོམས་སྨུག་པོ་གདན་དྲངས།",
    "ཏཱ་ར་ནཱ་ཐའི་སྒྲུབ་ཐབས་རིན་འབྱུང་དུའང་བཀོད་འདུག་གོ།",
    "དེ་སྐབས་ཀྱི་ལས་ཅན་རྣམས་ཀྱི་ལག་ཏུ་ཡང་སྟོབས་ཆེན་བྱུང་འདུག་གོ།",
    "ཏེར་གྱི་བཀའ་བབ་ཡོད་ཚུལ་སོགས་ཞུས་འདུག་ཅིང་།",
    "གླིང་བརྒྱད་ཀྱི་སྐྱེ་བ་ང་རང་ཡིན།",
    "འདུག་དུག་དོ་ནུབ་ཀྱང་བུ་འདི་སྨྱོ་འདུག་པས།",
    "མ་ཚོར་སྐོར་མཁན་མང་པོ་འགྲོ་འདུག་པ་དང་བསྟངས་ནས་ཕྱིན།",
    "བྲག་ཕུག་ཆེན་པོ་ཞིག་འདུག་པ་དེའི་ནང་།",
    "རྡོ་རྗེ་གླིང་པས་སྦས་པའི་ཡང་གཏེར་འགའ་ཞིག་འདུག་པ་ཡང་བཏོན་པར་མཛད།",
    "དད་པ་འུར་ནས་གདའ་སྐད་དོ།",
    "ནོར་འདྲ་ཡོང་བ་འདུག་ན་འགྲོ།",
    "ནུ་བོ་གཉིས་ཀྱང་དེ་ཁ་བཞི་ཟེར་བས་ཐུགས་དགོངས་ལ་སྡུག་པ་འདི་ཚོ་ནོར་མེད་པའི་ཁྱེར་འདུག་དགོངས་ནས།",
    "འོ་ན་ལྷ་ཕུ་ན་དཔའ་བོ་གཏེར་སྟོ་གཅིག་འདུག་ཟེར་བ་དེ་མིན་ནམ་གསུངས།",
    "ངེད་ཀྱི་སྐུ་སྐྱེ་འདི་གཟོད་ཙ་ན།",
    "རི་བོ་རྩེ་ལྔ་ནས་བེ་རོ་ཙ་ནའི་ཐུགས་ཀྱི་འོད་ཟེར་འཕྲོས་པ་ལས་བྱུང་བ་ཡིན་ནོ་གསུངས་སོ།",
    "ཁྱེད་རང་ལ་བཀའ་བབས་པའི་རང་གཏེར་གྱི་སྐལ་བ་ཡོད་པས།",
    "དེས་འདོན་པར་འདུག་གསུངས།",
    "གཉིད་སད་ནས་ཤོག་སེར་རྣམས་ལ་བལྟས་པས་ཤེས་ཏེ་གཏེར་གྱི་ཁ་བྱང་མང་པོ་འདུག་ཐོག་མར་ཟབ་བུ་ལུང་ལ་བྱོན།",
    "དགྲ་རྟ་བོང་ཡིན་ན་ཐུལ་འདུག་གྱིས།",
    "ནོར་མི་རུས་ཡིན་ན་སོགས་འདུག་གྱིས།",
    "དེ་རྗེས་ཀྱང་གཏེར་ཁ་འགའ་ཞིག་བཞེས་པ་ཡིན་འདུག་གཏེར་བཞེས་པ་ཡང་ཁྲོམ་གཏེར་མང་པོ་མཛད་ཅིང་ཐང་མཚོའི་གཏེར་བཞེས་དུས་མཚོ་གཉིས་བར་ནས་འདོམ་བདུན་ཅུ་ཙམ་གྱི་དབུས་སུ་བྲག་འདོམ་ངོ་ཙམ་གྱི་ལོགས་ནས་གཏེར་བཞེས་པ་དང་།",
