    "རྒྱལ་བོས་ལན་གསུམ་གྱི་བར་དུ་སྨྲས་ཀྱང་ཅང་མི་ཟེར་བར་གཅིག་ལ་གཅིག་གྲུ་ཕུག་བྱེད་ཅིང་ཡུལ་ཡུལ་པོ་དང་ཞུམ་ཞུམ་པོར་གྱུར་ནས་མགོ་སྨད་ཅིང་སྤོབས་པ་མེད་དེ་སེམས་ཁོང་དུ་ཆུད་ནས་འདར་ཞིང་འདུག་གོ།",
    "ཞེས་ཀྱང་རང་མཉམ་ལ་གྲོས་སུ་འདེབས་པའོ།",
    "ཞེས་འདིའི་མན་མ་རྙེད་འདུག་དེ་ལྟར་རྗེ་འདི་བས་ཞལ་གྱིས་བཞེས་ནས་འབྲི་ཁུང་མཐིལ་པའི་འབུལ་དཔོན་ལྡན་མ་རིན་ཆེན་དཔལ་གྱིས་གདན་དྲངས་ནས་འཕྲིན་ལས་པ་དང་འགྲོགས་ཏེ་དབུས་གཙང་དུ་བྱོན་ནོ།",
    "ཁྱེད་ལ་མཛུབ་ཁྲིད་བྱེད་པ་ལ་ཁོ་བོས་ལེགས་པར་སྒྲིམ་དགོས་པར་འདུག་ཅེས་ཀྱང་གསུངས་སོ།",
    "ཞིག་འདུག་པ་དེ་ཉིད་ཚར་གཅིག་གསན།",
    "རྡོ་གྲུ་བཞི་ཆེ་ཙམ་རྩ་བ་བརྟན་པ་ཞིག་ལ་མཎྜལ་དབུལ་བ་མཛད་པས་ཕྱག་ངར་ལ་ཤ་རྨེན་ཆགས་ཤིང་རྡོ་ཤིན་ཏུ་འཇམ་པོར་གྱུར་པ་རྣམས་ཕྱིས་ཙ་ན་མཇལ་དུ་ཡོད་པ་སོགས་བྱ་དཀའ་བའི་བརྩོན་པ་ཤུགས་དྲག་པོ་བསྟེན་ཅིང་།",
    "མར་ན་སྤྲང་བོ་རྡོག་ཁྲེས་ཁུར་མཁན་ཞིག་མ་གཏོགས་ཅི་ཡང་མི་འདུག་ཅེས་ཞུས་པའི་ཚེ།",
    "དེ་ནས་གཟིམ་ཁང་ལ་ཕེབས་པའི་ཚེ་ཁྲོམ་ཆེན་པོ་ཚོགས་ཡོད་པའི་གསེབ་ནས་ཆིབས་པ་འདྲོགས་ནས་མི་མང་པོས་ཆིབས་ཁ་མ་ཐུབ་པ་ལ་ཁོང་རང་ཉིད་ཀྱིས།",
    "འདི་ན་སུ་མི་འདུག་གམ་གསུང་བ་ལ།",
    "བདག་འདྲའི་བློ་གྲོས་དམན་པ་དག་མགོ་འཐོམ་པར་འདུག་པས།",
    "འཇུག་བགྲོད་པའི་ཐེམ་སྐས་ཞེས་བྱ་བ་འདི་ནི་ད་ལྟའང་དཔེ་རྒྱུན་བཞུགས་པ་ལྟ་བུ་ལགས་ཏེ་གཞུང་རང་ལས།",
    "མཚན་འཛིན་གྱི་སྒྲིབ་པ་མ་དག་འདུག།",
    "ལུས་ངལ་བ་ཙམ་དུ་མི་གདའ་འམ།",
    "བློ་ཙབ་ཙུབ་འགྲོ་འདུག་རྣམ་གཡེང་སོགས།",
    "ཁེ་ཉེན་གཉིས་ལས་མི་གདའ་བས།",
    "རང་རང་བྱེད་སྤྱོད་ཅི་འདྲ་ནའང་།",
    "བདག་ཡུན་རིང་འདུག་པའི་སྨོན་པ་བགྱིས།",
    "དུས་གཏན་གྱི་མདུན་མ་འགྲུབ་ཚོད་གདའ།",
    "ལྷན་སྐྱེས་ཡེ་ཤེས་རྟོགས་ཙ་ན།",
    "གནས་གང་དུ་འདུག་ཀྱང་དམན་ཆ་ཟུངས།",
    "ཐམས་ཅད་རང་རང་གདགས་གཞི་ལ།",
    "མྱོང་དགོས་བྱུང་ན་བཟོད་ཐབས་མི་འདུག་པས།",
    "རྐྱེན་དགྲ་འདྲེས་འཚེ་ཞིང་ནམ་ཞིག་དུས།",
    "ནི་ཁོང་རང་ཉིད་ཀྱི་གཤེགས་ཡུལ་གྱི་དད་ལྡན་སྐྱེ་འགྲོ་ཀུན་ལ་ཐུགས་ཆགས་པ་ནི་ཇི་སྐད་དུ།",
    "འོན་ཀྱང་རྒྱལ་བོའི་བཀའ་བཅག་པར་མི་རིགས་པས་མཆོད་སྟོན་ཆེན་པོ་བཤམས་ནས་མི་འབོད་པར་གང་རང་འོངས་པ་བརྒྱད་པ།",
    "སྟོན་པ་དྲུག་གྲལ་གྱི་ལྟག་ན་འདུག་ན་འདུག་པ་ཡང་གྲལ་གྱི་འོག་ན་འདུག་པར་གྱུར་ནས་མཐུ་མེད་པར་སྐྱེངས་ཤིང་དེ་བཞིན་ལན་གསུམ་གྱི་བར་གྲལ་གྱི་འོག་ཁོ་ནར་བྱུང་ངོ།",
    "མདུན་དུ་གསེར་གྱི་པད་མ་དྲི་བསུང་མངར་པོས་རྐང་དྲུག་རྣམས་འདུ་བའི་པད་སྡོང་ཆེན་པོ་འཁྲུངས་པའི་རྩེར་སྐུ་འགྲོ་འཆག་ཉལ་འདུག་ལ་སོགས་པའི་སྤྱོད་ལམ་སྣ་ཚོགས་སྟོན་པ་དང་།",
    "འཁོན་སེམས་དོར་ལ་ཞི་བདེར་འདུག་འཆི་བའི་དུག་ལ་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་འཐུང་།",
    "ཅང་ཤེས་རྟས་མཐོང་ཐུབ་པས་དེར་འདྲོགས་པ་ཡིན་ལ་སྐྱོན་མི་འདུག་ཅེས་གསུངས།",
    "དེ་ནི་དག་པོ་མི་འདུག་ཅེས་གསུངས་སོ།",
    "ཐུགས་ལ་འཇིག་རྟེན་གྱི་བྱ་བ་འབྱོར་རྒུད་མཐོ་དམའ་སྐྱིད་སྡུག་སོགས་ལ་ཡིད་བརྟན་མི་འདུག་སྙམ་པའི་སྐྱོ་ཤས་དཔག་མེད་འཁྲུངས།",
    "དེ་ནས་གཟིམ་ཁང་ལ་ཕེབས་པའི་ཚེ་ཁྲོམ་ཆེན་པོ་ཚོགས་ཡོད་པའི་གསེབ་ནས་ཆིབས་པ་འདྲོགས་ནས་མི་མང་པོས་ཆིབས་ཁ་མ་ཐུབ་པ་ལ་ཁོང་རང་ཉིད་ཀྱིས།",
    "འདི་ན་སུ་མི་འདུག་གམ་གསུང་བ་ལ།",
    "བརྗིད་ཆགས་པོར་འདུག་པ་དེ་ལ་ནང་དུ་མགོན་ཁང་།",
    "གཡས་རྒྱལ་མཚན་གསེར་ཏོག་དང་གཡོན་ཐིག་ནག་ཁ་ཏྲམ་གྱིས་བརྒྱན་པ་ཞིག་འདུག་ལ།",
    "གྲུབ་རྫུའི་སྨྱོ་སྤྱོད་ཀྱིས་བླུན་པོ་མགོ་བསྐོར་ཏེ་བསྟན་པའི་ཞབས་འདྲེན་དང་རང་གཞན་ཕུང་ལ་སྦྱོར་མཁན་ཆེས་མང་སྟབས།",
    "ཡང་རྒྱུ་འདི་དག་ལས་གང་ཞིག་དུས་གང་དུ་འབྲས་བུ་འཛིན་ཏམ་འབྱིན་ཅེ་ན།",
    "འཁོར་ལོས་སྒྱུར་དང་རང་བྱུང་གཉིས།",
    "ཉི་ཤུར་ཞིག་ནས་འདུག་གོ།",
    "དམའ་བར་འདུག་སྨྲས་བཟླས་པ་ཡིས།",
    "དམའ་བར་འདུག་སྨྲས་བཟླས་པ་ནི།",
    "ས་ཇི་བཞིན་དུ་རང་རང་དང་།",
    "བསམ་གཏན་སྤེལ་ནས་འོག་མིན་འགྲོ།",
    "བསམ་གཏན་སྤེལ་ནས་འོག་མིན་འགྲོ།",
    "ངག་དང་རང་ས་ལས།",
    "དེ་ཉིད་མ་མཐོང་རང་དགར་གྱུར་པ་ཡིས།",
    "རང་བྱུང་རང་བྱུང་བསྟན་པ་གཅེས་འཛིན་རྣམས།",
    "ཡང་གཡུ་ཐོག་ཡར་རྒྱ་གར་ལ་ཕེབས་པའི་ལམ་བར་དུ་ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ན་དང་མཇལ་དུས་སུ།",
    "གནས་ཀྱང་བསྲོ་ཁང་དྲོན་པོར་མེ་དང་སྟན་སྟུག་ལྡན་པར་འདུག།",
    "སྟན་དེ་ལ་འདུག་བཞིན་དུ་དགྲ་བཅོམ་པའི་གོ་འཕང་ཐོབ་སྟེ།",
    "དངོས་སུ་དགག་སྒྲུབ་གནང་གསུམ་གྱི་བཅས་པ་གང་ཡང་མ་མཛད་ཀྱང་དགེ་སློང་རང་ཉིད་ཀྱིས་བྱ་བ་གང་ཞིག་ལ་འཇུག་པའི་ཚེ།",
