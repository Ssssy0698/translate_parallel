    "རང་རང་གྲལ་བཞུགས་བསྐྱེད་རྫོགས་ཏིང་འཛིན་གྱིས",
    "རང་སྣང་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་ཅི་ལྟར་ཤར་ཡང་རང་རིག་ལས་གུད་དུ་མེད་པའི་གནས་ལུགས་ཆུ་ལ་ཆུ་བཞག་པ་ལྟ་བུར་རྟོགས་པས།",
    "མཆེད་གསར་པ་རྣམས་རང་རང་གྲལ་དུ་འཁོད་ནས།",
    "དེ་ཡང་ཉིན་དང་པོར་གཟུང་ཐག་གཉིས་ཀ་སློབ་དཔོན་ལ་ཕུལ་ནས་མཐར་བསྡུ་བའི་སྐབས་ལས་རྡོར་གྱི་ལས་ཀྱི་གཟུང་ཐག་བསྙེན་རྒྱུན་པར་གནང་སྲོལ་འདུག།",
    "ཁག་གཅིག་དངོས་གྲུབ་རྗེས་ལས་བཞི་མཆོག་དང་བཅས་པའི་སྦྱིན་སྲེག་ལྔ་དུས་གཅིག་ཏུ་གནང་སྲོལ་ཡང་འདུག།",
    "ཨོྃ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྠ་སཱ་དྷ་ནི་སྭཱ་ཧཱ",
    "ལིས་ཏ་ཀྲོ་སུའུ་ལེན་དུ་ཟླ་བཞི་ལྔ་རིང་བསྡད་རྗེས་མེས་རྒྱལ་དུ་ལོག་མེས་རྒྱལ་དུ་ལོག་དུས།",
    "ད་ལྟ་ང་རང་མེས་རྒྱལ་དུ་ལོག་པ་ཡིན།",
    "བདག་པོས་ཁོར་སུའུ་ལེན་ག་འདྲ་འདུག་ཅེས་དྲིས་པ་དང་།",
    "ང་རང་མི་འགྲོ་ཁོ་ཐག་ཡིན་ཞེས་བཤད།",
    "རང་སྲོག་བློས་གཏོང་དུས་ཁོ་རང་ལོ་སོ་བརྒྱད་ཡིན།",
    "ཧྲི་བིན་པིན་གྱིས་ཤོག་བུ་ལངས་ནས་ཡར་ལངས་ཏེ་ལག་པ་གཡུག་ཙམ་བྱས་ནས་ཚང་མ་ཁུ་སིམ་པོར་འདུག་ཏུ་བཅུག་པ་ན།",
    "དེར་མཐུད་ནས་ཁོས་ཡང་སྐྱོ་གདུང་ཆེན་པོས་ལོས་ཡིན།",
    "ཁོ་རང་བཟོ་པའི་ཁྲོད་དུ་ཧ་ཅང་གོ་གནས་དང་མཚན་སྙན་ཡོད་ཅིང་།",
    "ང་རང་ལོ་བདུན་བརྒྱད་ཀྱི་དུས་ནས་བཟུང་།",
    "ཁོ་རང་བརྟན་པོར་ཡར་ལངས་ཏེ་མ་འགྱེལ་བ་ཡིན་ཡང་སྲིད།",
    "ཁོ་རང་བསླབ་པར་སུན་སྣང་མེད་པར་འབད་བརྩོན་ལྷོད་མེད་བྱས་ཏེ་མི་ཚེ་ཧྲིལ་བོར་གཞུང་དྲང་གནོང་མེད་དང་རང་ཉིད་ལ་ངོས་སྐྱོན་ཞུ་བར་སྤོབས་ཤིང་།",
    "ད་མང་པོ་འདྲི་བའི་དགོས་པ་མི་འདུག་ང་ནི་ཆུས་ཆིའུ་པེ་ཡིན་ཞེས་བཤད།",
    "ཆུས་ཆིའུ་པེ་ནི་བག་ཕེབས་བརྟན་རླིང་དང་རང་སྲོག་གཏོང་བར་ངང་པ་པད་མཚོར་འཇུག་པ་ལྟར་སྣང་།",
    "ང་རང་ཤམ་བྷ་ལའི་ཞིང་ཁམས་ན་ཡོད།",
    "དེའི་སྐབས་ཁོ་རང་ལོ་སོ་དྲུག་ཡིན།",
    "ལོ་ཉེར་དྲུག་དུས་སུ།",
    "འགྲོ་འདུག་སེམས་པ་གཉིས་ཀ་ཤིན་ཏུ་ལྕི།",
    "ཁོ་རང་བྲེལ་འཚུབ་ཆེ་སྟེ་ཟ་མ་ཟ་བའི་དུས་ཚོད་ཀྱང་མེད་པར།",
    "ཤིའང་རང་ཉིད་ཀྱི་འཐབ་གྲོགས་དང་ཁ་བྲལ་མི་ཕོད་པ་དང་།",
    "སྐབས་དེར་ཁོ་རང་ལོ་ཉེར་བདུན་ཡིན།",
    "དེ་ནས་ཁ་ལོ་པས་ཁོ་རང་འཐེན་ནས་རྒྱུག་བཞིན་མེ་འཁོར་ས་ཚིགས་དང་ཁ་བྲལ།",
    "ལས་བརྩོན་གྱི་སོ་ལྟ་མཁན་རྣམས་གྲིབ་བསིལ་འོག་ཏུ་ཡིབ་ནས་གཉིད་ལྕོག་རྒྱག་བཞིན་འདུག་འཐབ་གྲོགས་ཚོས་དོན་དག་ཅི་ཡང་མེད་པའི་རྣམ་པར་བརྫུས།",
    "ཁོས་རྒྱལ་ཁབ་ཀྱི་ཉེན་ཁ་དང་མི་དམངས་ཀྱི་དཀའ་སྡུག་དུས་ནམ་ཡིན་ཡང་སེམས་སུ་བཟུང་།",
    "ཁོ་རང་བསྡད་པའི་འཁོར་གྲུ་མཐའ་ཡས་པའི་སྤྲིན་སྨུག་འཐིབས་པའི་ཏུང་ཐིན་མཚེའུར་བསྐྱོད་དུས།",
    "དང་ཐོག་དུས་ཚོད་མང་པོ་སྤྱད་ནས་ཚིག་མཛོད་བསློགས་དགོས་པ་དང་།",
    "ཁོ་རང་གནས་སྐབས་སུ་མི་འགྲོ་རྒྱུའི་ཁ་ཏ་བྱས།",
    "འོན་ཀྱང་ཁོ་རང་མགྱོགས་པོར་ཀོང་ཀྲིག་ཏུ་ཁྲིད་སྐྱེལ་བྱས།",
    "ཁོ་རང་ཝུའུ་ཧན་དང་ཁ་བྲལ་ནས་ལྷོའི་ཀོང་ཏུང་དུ་ཐོན་ཏེ་ཀྲུང་གུང་ཀོང་ཏུང་ཞིང་ཨུའི་ཧྲུའུ་ཅིའི་འགན་བཞེས།",
    "ང་རང་མེ་མདས་སྲོག་ཆད་ཐོངས་དང་ཞེས་བཤད།",
    "ཕིན་ཕེ་ཧྲང་ཧེ་ལུང་ཧྭར་དཔའ་ངར་ཆེན་པོའི་ངང་རང་སྲོག་བློས་བཏང་ཞིང་།",
    "འོན་ཀྱང་པར་མ་སྔ་ཕྱི་གཉིས་དང་བྲིས་མ་གཅིག་བཅས་དཔེ་གསུམ་པོ་རྩ་བའི་ཆ་ནས་གཅིག་མཚུངས་སུ་བཞུགས་པ་ལས་ཁྱད་པར་ཆེན་པོ་མི་འདུག།",
    "རིག་པའི་གནས་ཐམས་ཅད་ལ་ཤིན་ཏུ་མཁས་པར་འདུག་པས་དོགས་གཅོད་མང་དུ་བགྱིས་ཤིང་བསྟན་བཅོས་ཀྱང་ཐན་ཐུན་བསྐྱུར།",
    "ཁྱེད་རང་རྣམས་ཀྱི་སྤྱི་བོ་ནས་ཞུགས་ཏེ་ཐིམ་པས།",
    "མཧཱ་གོ་རོ་ཙ་ན་ཇི་ཧཱ།",
    "སྤྲོས་པ་ལ་དགའ་བས་ཚེ་རིལ་ཚེ་ཆང་སྟེར་བའི་ལུགས་ཀྱང་གདའ།",
    "ལས་ཀྱི་རྡོ་རྗེས་མེ་ཏོག་བཀྱེ་བསྡུ་བྱས་ནས་འདུག་པ་ལ།",
    "མདུན་དུ་དུལ་བར་འདུག་པ་དང་།",
    "ཁྱེད་རང་དམིགས་པ་འདི་བཞིན་དུ་མཛོད།",
    "ཁྱེད་རང་འཇམ་པའི་དབྱངས་སུ་གསལ་བའི་ཞལ་དུ་ཞུགསནས།",
    "འདི་ལ་ཁྱེད་རང་རྣམས་ཐོས་བསམ་གྱིས་ལ་ཉམས་སུ་ལོང་།",
    "ཨོཾ་ཨཱ་ར་པ་ཙ་ན་དྷཱིཞེས་ཅི་ནུས་སུ་བཟླས་ཤིང་།",
    "སྟོང་པའི་ངང་ལས་པད་ཟླ་ལ་འཁོར་ལོ་དམར་སེར་རྩིབསལྔ་པ་ལྟེ་བ་ལ་དྷཱིརྩིབས་རྣམས་ལ་ཨ་ར་པ་ཙ་ན་དང་བཅས་པ་ལས་འོད་འཕྲོས།",
    "ཨ་ར་པ་ཙ་ན་དྷཱི",
    "ཨོཾ་རུ་རུ་སྦུ་སཛྭ་ལ་ཏིཥྛ་སིརྙི་ལོ་ཙ་ནེ།",
    "ཁྱེད་རང་རྣམས་ཀྱི་དཔྲལ་བར་ཐིམ།",
    "ནག་པོ་ཏི་པ་ཙ་ནཱ་ག་རཀ་ཨོཾ་ཕེ་ལ་ཧུ།",
    "མཎྜལ་ཕུལ་ནས་འདུག་པ་ལ།",
    "རང་རང་གོ་རིགས་ཀྱི་བདག་པོས་དབུ་བརྒྱན་པ་ལ་མཆོད་ཅིང་བསྟོད་དེ།",
    "འདིལ་རིག་གཏད་བྱེད་པའི་ལག་ལེན་ཡོད་པར་གདའ་ནའང་།",
    "འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱིས་བསྟན་པ་བསྲུང་བའི་མཚོན་ཆ་འདི་རྡོ་རྗེ་གདན་གྱི་ཀ་བར་སྦས་ཏེ་གཞག་དུས་ཕྱིས་པད་མ་བཛྲོ་ཞེས་ཨུ་རྒྱན་དུ་འཁྲུངས་པ་དེས་བོད་དུ་འབྱོན་པའི་དུས་རྡོ་རྗེ་གདན་ནས་བཏོན་ནས་བསྣམས་ནས་བྱོན།",
    "འགའ་ཡང་འདུག་པ་མཐོང་བར་གྱུར་པའི་ཚེ།",
    "རང་རང་ས་བོན་ཡོངས་གྱུར་པའི།",
    "སུ་ཡང་མ་འདུག་སོ་སོར་དེངས།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན།",
    "གངས་ཅན་མིག་གཅིག་བེ་རོ་ཙ་ནར་འདུད།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན་བསམ་ཡས་དབུ་རྩེར་གདན་དྲངས་ཏེ་སློབ་དཔོན་པདྨས་སྔགས་ཀྱི་རྒྱུད་དང་།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན་རྐང་མགྱོགས་ཀྱི་རྫུ་འཕྲུལ་ལ་དང་།",
    "བྲག་ཕུག་འདིར་སློབ་དཔོན་བེ་དང་བྲག་རི་རྩི་ཤིང་ནགས་ཚལ་གྱིས་བརྒྱན་པའི་རི་བོ་མཐོ་ལ་བརྗིད་རོ་ཙ་ནས་བཞུགས་གནས་མཛད་རྗེས་ཡང་།",
    "ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནའི་སྐུ།",
