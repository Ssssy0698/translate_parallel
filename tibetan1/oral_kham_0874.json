    "མདང་ནུབ་ཉལ་ཁར་ད་དུང་ཟེད་ཟེད་ལང་ལོང་དུ་འདུག་པའི་ཁང་པའི་ནང་ཧྲིལ་བོར་ས་རྡུལ་ཙམ་ཡང་མེད་པར་གཙང་ཞིང་གྲ་དག་པར་འདུག་པས།",
    "ཁོ་ལ་དུས་རྒྱུན་ལས་ཀྱང་གཙང་ཞིང་གྲ་དག་པར་འདུག་པའི་སྣང་བ་ཞིག་བྱིན།",
    "ང་དང་ཐོག་ཁྱེད་ལ་དགའ་བའི་རྒྱུ་རྐྱེན་ཡང་དེར་ཐུག་འདུག་སྙམ།",
    "ཁྱེད་རང་འཕུར་ཤོགཁྱེད་ཀྱིས་དྲོ་འཇམ་གྱི་ནམ་ཟླ་དྲན་ན།",
    "དེ་ལས་མང་ཤོས་ལ་རྩོམ་འབྲི་དུས་ཐ་མག་འཐེན་པའི་སྲོལ་འདུག་པ་ཤེས།",
    "ས་ཡང་རུབ་འདུག་པས།",
    "དཀའ་ཁག་ཅི་འདྲར་འཕྲད་ཀྱང་རང་ཚུགས་འབོར་མི་ཉན།",
    "ཁོ་འཆུགས་འདུག་དེ་ནི་དེ་ཚོས་ཁོ་དང་ནམ་ཡང་བར་ཐག་ཅིག་ཡོད་དུ་བཅུག་ཡོད་པ་མ་ཡིན་ནམ།",
    "དགའ་དགའ་ཡི་ལུས་ཀྱི་ཤ་དྲོད་སྔར་ནས་ཉམས་འདུག་ཁོས་དགའ་དགའ་ཡི་དབུགས་ཀྱི་རྒྱུ་བ་འགགས་འདུག་པ་ཤེས།",
    "མགོར་གོན་ན་ཤིན་ཏུ་མཛའ་བས་བལྟས་པ་ཙམ་གྱིས་མཛེས་ཉམས་ཐོན་འདུག་ཅེས་བསྔགས་མྱོང་།",
    "ཁྱེད་རང་འགྱུར་བ་མ་གནང་ཨང་ཞེས་ནན་བཅག་ཅིག་བྱས་པ་ལ།",
    "ཕུན་རྣམ་ཟམ་པའི་འགྲམ་སྐྱོར་ལ་ཁེན་ནས་ཚུར་བལྟས་འདུག་པ་མཐོང་།",
    "ལྷ་མཛེས་ཀྱི་ཡིད་དུ་ཕུན་རྣམ་རང་ལ་དགའ་བོ་འདུག་པར་ཡིད་ཆེས་བྱུང་ཡོད།",
    "ང་ལ་དགའ་བའི་མི་དེ་མི་འདུག་ཅེས་སྐད་མཐོན་པོས་ལེན་དུས།",
    "ལྷ་ཀླུ་ཟམ་ཁར་ལས་སྒུག་བྱེད་མཁན་གྱི་མི་རྣམས་ཕལ་ཆེ་བ་ཕྱིན་ཚར་འདུག་དེ་བས་ཟམ་པའི་གཞོགས་གཉིས་འཁོབས་ཡངས་སུ་ཕྱིན་འདུག་ལ།",
    "ཕུན་རྣམ་ཕར་འགྲོ་དུས་ལྷ་མཛེས་ལ་ལག་བརྡ་ཞིག་བཏང་སྟེ་ཨ་ཙི།",
    "འཇིགས་མེད་ཀྱིས་ག་འདྲ་འདུག་ཞིམ་པོ་འདུག་གམ་ཟེར་བ་དང་།",
    "སྣང་བ་ཞིག་ལ་ཕུན་རྣམ་འཁྲིས་སུ་ཉེ་བར་བསྡད་ཀྱང་ཤིན་ཏུ་རྒྱང་རིང་བོར་གནས་འདུག་པའི་ཚོར་སྣང་བྱུང་།",
    "བོད་གངས་ཅན་གྱི་མི་རབས་གསར་པའི་ཕུགས་བསམ་མངོན་འདུགརྙིང་ཞེན།",
    "ང་རང་ཕ་ཡུལ་གྱི་རྩྭ་ཐང་དུ་ལངས་ནས།",
    "ཁོ་རང་མཚོ་སྔོན་པོའི་མཚོ་འགྲམ་དུ་འགྲེངས་ནས།",
    "འཇིག་རྟེན་འདིའི་མགོ་མཇུག་ལྡོག་འདུག་ཅེས།",
    "ཡིད་ཀྱི་སྟ་གོན་སྔར་ནས་བྱས་འདུག་ཤིན་ཏུ་ཐོབ་དཀའ་བ་དེ།",
    "ཡིད་ཀྱི་སྟ་གོན་སྔར་ནས་བྱས་འདུག་ཤིན་ཏུ་ཐོབ་དཀའ་བ་དེ།",
    "ཁྱེད་རང་མ་གཞི་ནས་འཆར་ཡན་གྱི་སྙན་ཚིག་ཅིག་ལགས་ཏེ།",
    "ཁྱེད་རང་སླར་དུ་གསན་མཐོང་བྱེད་ཆེད་བདག་ཏར་ཝུན་གྱི་གྲོགས་སུ་བསྡོངས་ནས།",
    "ཁྱེད་རང་ན་ཚོད་ཅི་ཙམ་དུ་སོན།",
    "ན་རག་དམྱལ་ཁམས་བཅོ་བརྒྱད་ལྷན་དུ་འགྲིམས་སྲིད་པའི་བདེན་པ་ཡོད་འདུག་པས།",
    "ང་མེ་ལ་སྒྲོན་མཁན་དེ་ང་རང་ཉིད་ཡིན།",
    "ང་མེ་ལ་སྒྲོན་མཁན་དེ་ང་རང་ཉིད་ཡིན།",
    "ང་འཇིག་རྟེན་དུ་གནས་འདུག་ང་མི་ཡུལ་དུ་འཚོ་འདུག་ཨང་།",
    "ང་རང་སྦས་སྐུངས་དང་སྡར་ཚུགས་ཀྱིས་འབྲོ་ལ་དགའ།",
    "ང་རང་སྐྲག་དངངས་དང་བཅོས་ཟོལ་ངང་ཡུན་རིང་གནས་དོན་ནི།",
    "ད་དུང་རང་ཉིད་ཀྱི་ཕྱི་རོལ་དུ་བརྐྱངས་པའི་རྣ་གཤོག་ཡོངས་སུ་བསྐུམས་ནས།",
    "མཐར་གཏུགས་ཚེ་ཆུ་བོ་ནི་ཆུ་བོ་ལ་འཐིམ་གྱིན་འདུག་ན།",
    "ལུས་འདུག་པར་འགྱོད་མྱོང་བ་ལན་གཅིག་མིན།",
    "ཉིན་དེར་ཆར་བས་བྲན་པར་བརྟེན་སྣུམ་ཤིག་གེསྨུག་སེང་ངེར་འདུག་ལམ་དཀྱིལ་གྱི་རྡེའུ་ཟེགས་རྣམས་བརླན་ཞིང་འཇམ་ལ།",
    "ང་རང་ཕ་ཡུལ་ལ་དགའ་བའི་འདུན་མ་ཞིག་བཅོས་མིན་དུ་སྐྱེས་འོངས་པ་དང་།",
    "འགལ་བ་དེ་ནི་ལོ་མུས་སུ་ཇེ་ཆེར་འགྲོ་ཞིང་གདའ།",
    "སྐབས་དེ་དུས་ཙ་ན།",
    "ཉི་མ་ནི་སྨྲ་བཅད་དེ་འཛུམ་འབོལ་ལེར་འདུག་པ་དང་།",
    "ས་གཞི་ཡང་དགའ་ལྷང་ངེར་དལ་བཅགས་སེ་གདའ།",
    "སྲིབ་ཀའི་རི་རྩ་དག་ཏུ་ད་དུང་མ་ཞུ་བའི་གངས་དང་འཁྱག་རོམ་གྱིས་ཁེངས་འདུག་མ་གཞིར།",
    "ངས་སླར་ཡང་རང་ཉིད་ལ་དྲི་བ་དྲངས།",
    "གློག་སྒྲོན་མེད་པའི་མཁར་གྲོང་དེ་རུ་ཡོད་ཚད་རབ་རིབ་ཏུ་གྱུར་འདུག་པ་དང་།",
    "དུས་རྒྱུན་དང་མི་མཚུངས་པའི་ཁྱད་པར་ཞིག་ཡོད་པ་ནི་ཡུལ་ཁམས་དེའི་མཁའ་དབུགས་རྨང་ནས་འགྱུར་འདུག་པ་དང་།",
    "ང་ཡང་འདུག་སའི་ས་མེད་པར་རྫོབ་ཆུའི་བཞུར་ལམ་ཞིག་ཏུ་དེད་བྱུང་།",
    "ཚང་མས་རང་ཉིད་ཀྱི་འཚོ་གནས་ཆེད་དུ་འགྲན་རྩོད་ཛ་དྲག་བྱེད་ཀྱིན་འདུག་ངོ་མ།",
    "ཡར་བེའུ་ནར་སོན་རྗེས་འོ་མའི་ནུ་མཚམས་གཅོད་དུས་སུའང་དེའི་མཆུ་དང་སྣ་ན་ལྕི་དྲི་ཐུལ་ལེར་འགོས་འདུག་ཀོ་མཉེད་རྒད་པོས་ཀོ་གྱོང་ཨུ་ཚུགས་ཅན་ལ་ནེམ་ཤུགས་སྩོལ་དུས་ཀྱང་ལྕི་རློན་གྱི་བྱ་གཞག་ཅི་ནས་ཀྱང་མེད་དུ་མི་རུང་སྟེ།",
    "དེ་ལ་མཁོ་བའི་རྒྱུ་ཆ་མང་ཙམ་འདུག་དེ་འབྲོག་པའི་འཚོ་བའི་ཁྲོད་བཀོལ་རིན་ཡང་ལྕི་སྒམ་ལས་མང་།",
    "འགྲོ་བཞིན་འདུག་ཆུང་བ་དག་ཀུམ་མེ་ཀུམ་མེར་འགྲོ་བཞིན་འདུག་གཅིག་རྗེས་གཉིས་མཐུད་དུ་ཡལ་བཞིན་འདུག་འོན་ཀྱང་ཀྱེ་ཀྱེ་སྦྲ་ནག་ལགས།",
    "དེ་མིན་ན་འགྲུལ་པ་གཞན་དག་སྔ་ས་ནས་རང་རང་གནས་མལ་དུ་འབྱོར་ཟིན་པ་དང་སྐབས་འདིར་རླངས་འཁོར་འགྲུལ་བཞུད་ཧ་ལམ་ཆད་ནས་གཞུང་ལམ་ཧྲིལ་པོ་གཙང་འགྲམ་བཞིན་འཇམ་ཐིང་ཐིང་དུ་གནས།",
