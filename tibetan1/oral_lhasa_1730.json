    "གཙུག་ལག་ཁང་དུ་གནས་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ནོད་པར་བསྟན་པ་ཡང་སྲིད་པས་འདི་ནི་བདག་ཉིད་གཙུག་ལག་ཁང་དུ་གནས་པར་རྗེས་སུ་གནང་བ་བསྟན་ཏོ།",
    "གལ་ཏེ་སྦྱིན་བདག་ཡོད་ན་དེས་རྗེས་སུ་གནང་ནའོ་ཞེས་བྱ་བ་ནི།",
    "འདིར་གཞུང་ནི་གལ་ཏེ་བཅོམ་ལྡན་འདས་ཀྱིས་རྗེས་སུ་གནང་ན།",
    "བཟུང་བར་བྱ་ཞིང་ཆུའི་རྒྱུན་མི་ཆད་པར་བླུགས་པས་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དབྱར་གྱི་རྙེད་པ་དེའི་དུས་ཉིད་ཀྱི་ཚེ་དབྱར་གྱི་ནང་དུ་འོངས་ཤིང་ཞག་བཞི་བཅུ་རྩ་དྲུག་ལས་ལྷག་པར་མཚམས་དེའི་ནང་དུ་གནས་ན།",
    "དབྱར་གནས་པར་ཁས་མ་བླངས་ཀྱང་རུང་དབྱར་རལ་ཡང་རུང་སྟེ།",
    "གནས་པར་ཁས་བླངས་པ་ནི་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་ལས་སུ་བསྐོས་པ་བྱེད་ན་ནི་རྙེད་པ་ཡང་སྦྱིན་པར་བྱའོ།",
    "ཇི་སྟེ་མི་བྱེད་ན་ནི་ཟན་ལ་ལྟོས་པ་ཙམ་གྱིས་གནས་པར་བྱ་སྟེ་ལས་དང་རྙེད་པ་ཡང་ངོ་ཞེས་གསུངས་པ་དང་།",
    "དེ་དག་ལ་ཟས་ཀྱི་རྙེད་པ་སྦྱིན་པར་བྱའོ་ཞེས་གསུངས་པ་དེ་དག་འདིར་བསྡུས་པ་ཡིན་ནོ།",
    "རྙེད་པ་མི་འཐོབ་པ་ལ་ཟན་སྦྱིན་པར་བྱ་བ་ཉིད་དོ་ཞེས་བྱ་བ་ནི།",
    "ལས་མི་བྱེད་པས་རྙེད་པ་མི་འཐོབ་པ་ལ་ཟས་ནི་སྦྱིན་པར་བྱ་བ་ཉིད་ཡིན་པའོ།",
    "དད་པའི་རྒྱུ་ལས་བྱུང་བའི་རྙེད་པ་གང་ཡིན་པ་སྦྱིན་བདག་དད་པས་དུས་ངེས་པ་མེད་པར་གང་ཟག་འགའ་ཞིག་ལ་འབུལ་བར་བྱེད་པ་དེ་ནི་གཙུག་ལག་ཁང་ཉིད་ཀྱི་རྙེད་པ་མ་ཡིན་ནོ།",
    "འདིར་ངེས་པར་ཤེས་པར་བྱ་བའི་ཐབས་གང་ཡིན་ཞེ་ན་དེའི་ཕྱིར།",
    "དེ་ནས་ནང་པར་སྔར་ལངས་མ་ཐག་ཁོ་ནར་གཙུག་ལག་ཁང་དང་མཆོད་རྟེན་གྱི་འཁོར་ས་བལྟ་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ཁྱི་འཆང་བའི་གང་ཟག་དེས་ནང་པར་སྔར་ལངས་མ་ཐག་ཁོ་ནར་ཞེས་བྱ་བ་ནི།",
    "བྱ་བ་གཞན་དག་མ་བྱས་པའི་མདུན་རོལ་དུ་གཙུག་ལག་ཁང་དང་མཆོད་རྟེན་གྱི་འཁོར་ས་དག་ཁྱིས་སྨེ་བ་ལ་སོགས་པར་མ་བྱས་སམ་ཞེས་བལྟ་བར་བྱའོ།",
    "གསར་བུས་མནོད་པའི་ཕྱིར་ནི་ཁམས་སྙོམས་པ་ཉིད་དྲིས་ཏེ་ཕྱག་བྱ་བ་སྔར་བཏང་བའི་སྤྱོད་ལམ་བསྟེན་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "སྔར་ཕྱག་བྱས་ཏེ་བསྙུན་གསོལ་ནས་བྱ་བའི་སྤྱོད་ལམ་བསྟེན་པར་བྱའོ།",
    "སེམས་འདུད་པར་བྱ་སྟེ།",
    "གྱ་གྱུ་མེད་པ་དང་སྒྱུ་དང་གཡོ་མེད་པར་བྱའོ།",
    "ལུང་འབོགས་པར་བྱེད་པ་གནས་སྐབས་ཇི་ལྟ་བུ་ལ་སྤྱོད་ལམ་ཇི་ལྟ་བུ་བསྟེན་པར་བྱ་ཞེ་ན།",
    "ལུང་འབོགས་པར་བྱེད་སས་འཆག་པ་ན་ལུང་ནོད་པར་བྱེད་པས།",
    "གོམ་པ་ཕྱིར་བསྲིབས་བཅག་པའི་སྤྱོད་ལམ་བསྟེན་པར་བྱའོ།",
    "པས་ཀྱང་འགྲེང་བའི་སྤྱོད་ལམ་བསྟེན་པར་བྱའོ།",
    "མནོད་པར་བྱ་བ་མང་བ་ཉིད་ན་ཞུ་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ལུང་མནོད་པར་བྱ་བའི་གཞུང་མང་བ་ཉིད་ཡིན་ན།",
    "ལུང་འབོགས་པ་དང་མནོད་པ་ནི་ཤིན་ཏུ་ལེགས་པར་བཀླགས་པ་དང་ཤིན་ཏུ་ཡོངས་སུ་བྱ་བ་དང་ཐེ་ཚོམ་མེད་པར་བྱས་ཏེའོ་ཞེས་བྱ་བ་ལ།",
    "ཀློག་ཏུ་གཞུག་པ་ཞེས་བྱ་བ་ལ་སོགས་པའི་དོན་དུ་ལུང་འབོགས་པར་བྱེད་པས་ལུང་མནོད་པར་བྱེད་པ་ལ་ལུང་འབོགས་པའོ།",
    "དེའི་དོན་དུ་ལུང་འབོགས་པར་བྱེད་པ་ལས་ལུང་ནོད་པར་བྱེད་པས་ལུང་ནོད་པའོ།",
    "ཤིན་ཏུ་ལེགས་པར་བཀླག་པ་ཞེས་བྱ་བ་ནི་ཤིན་ཏུ་ལེགས་པར་མནོད་པར་བྱས་པའོ།",
    "ཤིན་ཏུ་མཚན་མར་འདྲིས་པར་བྱས་པའོ།",
    "ཐེ་ཚོམ་མེད་པར་བྱས་ཏེ་ཞེས་བྱ་བ་ནི།",
    "ཤིང་ཏོག་འདྲིམ་པ་དག་སྤྲོ་པར་བྱས་ཏེ།",
    "འདི་ནི་གསོལ་བའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "འདི་ནི་གསོལ་བའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "བར་བུར་འདྲིམ་པར་ཡང་ངོ་ཞེས་བྱ་བ་ཡང་སྤྲོ་བར་བྱ་སྟེ།",
    "ཇི་སྐད་སྨོས་པ་དེ་ཉིད་ཀྱིས་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "བར་བུར་ཞེས་བྱ་བ་དེ་ཅི་ཡིན་ཞེ་ན་དེའི་ཕྱིར་ལྷག་རོལ་ཕྱི་དེ་ཉིན་པར་བྲིམ་པར་བྱ་བ་ནི་དེ་ཞེས་བྱའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "བར་བུར་འདྲིམ་བར་བསྐོ་བར་བྱ་ཞིང་དེས་དེ་དག་ཕྱི་དེ་ཉིན་པར་བྲིམ་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདི་ནི་གསོལ་བའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "འགེད་པར་བསྐོ་བར་བགྱི་སྟེ།",
    "འདི་ནི་གསོལ་བའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "སྲ་བརྐྱང་སྦེད་པ་སྤྲོ་བར་བྱས་ཏེ་གསོལ་བ་དང་གཉིས་ཀྱི་ལས་ཀྱིས་བསྐོའོ།",
    "འདི་ནི་གསོལ་བའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "གོས་སྤེད་པ་སྤྲོ་བར་བྱས་ཏེ།",
    "གོས་ཀྱི་རྙེད་པ་འདྲུབ་པ་བསྐོ་བའི་སྔགས་ཇི་སྐད་སྨོས་པ་དེ་ཉིད་ཀྱིས་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "དེ་གཉིས་སྤྲོ་བར་བྱས་ཏེ་གསོལ་བ་དང་གཉིས་ཀྱི་ལས་ཀྱིས་བསྐོ་བའོ།",
    "འདི་གཉིས་བསྐོ་བའི་སྔགས་ཀྱང་སྣོད་སྤྱད་འདྲུབ་པ་བསྐོ་བའི་སྔགས་ཇི་སྐད་སྨོས་པ་དེ་གཉིས་ཀྱིས་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "མངག་གཞུག་པ་བསྐོ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདི་ནི་གསོལ་བའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "ཟན་གྱུ་ནས་བྲུབ་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་བསྐོ་བའི་སྔགས་ཀྱང་ཟས་ལ་བསྒོ་བ་བསྐོ་བའི་སྔགས་ཇི་སྐད་སྨོས་པ་དེ་ཉིད་ཀྱིས་ཅི་རིགས་པར་སྤྲོ་བར་བྱའོ།",
    "དེ་བསྐོ་བའི་སྔགས་ཀྱང་དག་སྐོས་བསྐོ་བའི་སྔགས་ཀྱིས་ཅི་རིགས་པར་བསྐོ་བར་བྱའོ།",
    "དེས་བལྟས་ཏེ་རབ་ཏུ་བྱུང་བ་རྣམས་མི་མཛེས་པ་བསྟན་ནས་སེ་གོལ་གྱི་སྒྲ་སྔོན་དུ་བཏང་སྟེ་མཛེས་པ་ལ་ངེས་པར་སྦྱར་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "མཛེས་པ་ལ་ངེས་པར་སྦྱར་བའི་ངོ་བོ་ཉིད་བསྟན་པའི་ཕྱིར།",
    "སྤྲོ་བར་བྱས་ཏེ་གསོལ་བ་དང་གཉིས་ཀྱི་ལས་ཀྱིས་བསྐོ་བའོ།",
    "འདི་བསྐོ་བའི་སྔགས་ཀྱང་གནས་ཁང་བསྒོ་བ་བསྐོ་བའི་སྔགས་ཇི་སྐད་སྨོས་པ་དེ་ཉིད་ཀྱིས་ཅི་རིགས་པར་སྦྱར་བར་བྱའོ།",
    "ཟན་ཟ་བ་དག་ལ་ཁྭ་དང་བྱེའུ་དང་ཕུག་རོན་ལ་སོགས་པ་དག་བཟློག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་བང་རིམ་གྱི་ཞལ་ཏ་པ་དེས་སོ།",
    "ཁྭ་ལ་སོགས་པ་དེ་དག་ནི་བང་རིམ་དག་ཏུ་གནས་འཆའ་བས་དེའི་ཕྱིར་དེས་ཤས་ཆེར་དེ་དག་ཟློག་པར་བྱེད་པས་བང་རིམ་གྱི་ཞལ་ཏ་པ་ཞེས་བྱའོ།",
    "དེ་གཉིས་དབོག་བར་སྤྲོ་བར་བྱས་ཏེ།",
    "འདི་ནི་གསོལ་བའོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེར་མི་གཞན་དག་འོང་བ་དགག་པའི་ཕྱིར་སྒེའུ་ཆུང་སྲུང་བ་སྤྲོ་བར་བྱས་ཏེ།"
  ]
}