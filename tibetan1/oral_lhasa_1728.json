    "ལས་གཞན་ནི་དེས་ཐོས་པར་མི་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ནང་དུ་དྲི་བའི་ཕྱིར་གསོལ་བ་ལ་སོགས་པ་བསྙེན་པར་རྫོགས་པར་བྱ་བ་ཡང་ངོ་ཞེས་བྱ་བ་ཡང་མ་གཏོགས་སོ་ཞིས་བྱ་བའི་རྗེས་བསྙེག་པའི་ཕྱིར་ཡང་ངོ་ཞེས་བྱ་བའི་སྒྲ་སྨོས་སོ།",
    "སོགས་པ་ཞེས་བྱ་བའི་སྒྲས་ནི་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་བསྙེན་པར་རྫོགས་པར་བྱ་བ་དག་བསྡུས་ཏེ།",
    "གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་བསྙེན་པར་རྫོགས་པར་བྱ་བའི་ལས་དེ་དག་ནི་བསྙེན་པར་རྫོགས་པར་བྱ་བའི་གང་ཟག་དེས་ཐོས་པ་དང་བཅས་པར་བྱའོ།",
    "དེ་ལས་གཞེན་པ་ནི་ཐོས་པར་མི་བྱའོ།",
    "ཐོས་པར་བྱ་བ་མ་ཡིན་པ་བསྙེན་པར་མ་རྫོགས་པ་ལ་སོགས་པའི་གང་ཟག་ལ་བསྙེན་པར་རྫོགས་པར་བྱ་བ་ལ་སོགས་པ་མངོན་སུམ་དུ་བྱ་བ་གང་ཡིན་པ་དང་།",
    "སོགས་པ་རྗེས་སུ་བསྒྲག་པར་བྱ་བ་གང་ཡིན་པ་ལས་རྣམ་པ་གཉིས་བྱ་བ་དེ་ལ་མངོན་སུམ་དུ་བྱ་བ་དང་།",
    "རྗེས་སུ་བསྒྲག་པར་བྱ་བ་ལའོ།",
    "ཐོས་པར་བྱ་བ་མ་ཡིན་པའི་གང་ཟག་ལ་མངོན་སུམ་དུ་ལས་གང་བྱ་བ་དེ་ལ་ནི་བལྟ་བར་བྱ་བའི་ཉེ་ན་ཀོར་དུ་གཞག་པ་ཉིད་ཀྱིས་བསྒྲུབ་པར་བྱའོ།",
    "དེ་བཞིན་དུ་ཐོས་པར་བྱ་བ་མ་ཡིན་པའི་གང་ཟག་ལ་རྗེས་སུ་བསྒྲག་པས་ལས་གང་བྱ་བ་དེ་ལ་ནི་གོ་བར་བྱ་བ་ཉིད་ཀྱིས་བསྒྲུབ་པར་བྱ་སྟེ།",
    "གསོལ་བ་ནི་བྱས་ཟིན་ཏོ་ཞེས་བྱ་བ་ལ་སོགས་པས་གོ་བར་བྱ་བས་སོ།",
    "སྨྱོས་པའི་གནང་བ་དང་ཕྱག་མི་བྱ་བ་དང་མི་སྨྲ་བར་དང་ལོངས་མ་སྤྱད་པ་དང་།",
    "སྨྱོས་པའི་གནང་བ་དང་།",
    "དེ་དག་ནི་བསྙེན་པར་མ་རྫོགས་པའི་ཡུལ་ཡིན་པས་དེ་དག་ལས་མངོན་སུམ་དུ་འགྱུར་བའི་དོགས་པ་མེད་པའི་ཕྱིར་རོ།",
    "གོ་བར་བྱ་བས་རྗེས་སུ་བསྒྲགས་པས་ནི་བསྒྲུབ་པར་བྱ་བ་ཁོ་ན་ཡིན་ནོ།",
    "ལྷུང་བཟེད་ཁས་ཕུབ་པ་བག་ཡོངས་སུ་བྱ་བའི་གནང་བ་ནི་ཉ་དེ་ཉིད་ལ་ལྷུང་བཟེད་ཕྱིར་བཟློག་པ་མཛད་པ་ལྟ་བུའོ།",
    "སློབ་པའི་སྡོམ་པ་བག་ཡངས་སུ་བྱ་བ་ནི་དེ་ཉིད་ལ་སྡོམ་པ་གཞིག་པར་མཛད་པ་ལྟ་བུའོ།",
    "གཞན་ལ་སྤྱོ་བར་བྱ་བ་མ་ཡིན་པས་མངོན་སུམ་དུ་མ་གྱུར་པར་བྱ་བ་དག་ཡིན་ནོ།",
    "སྨྱོས་པའི་གནང་བ་ནི་དགེ་སློང་བྱེ་མ་སྐྱེས་ལས་བཅས་པ་ལྟ་བུའོ།",
    "བསྙེན་པར་རྫོགས་པ་རྣམས་ལ་ལས་དེ་དག་མངོན་སུམ་དུ་མ་གྱུར་བར་བྱའོ།",
    "གསོལ་བ་མ་བྱས་པར་དེའི་དོན་དུ་བརྗོད་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "འདུས་པར་རྗེས་སུ་མ་ཞུགས་པ་ཉིད་དང་།",
    "ཕྱིར་ཟློག་པར་བྱེད་པའོ།",
    "དེ་ལ་འདུས་པར་རྗེས་སུ་མ་ཞུགས་པ་ཉིད་ཅེས་བྱ་བ་དེ་ཇི་བསྟན་པའི་ཕྱིར།",
    "དགེ་སློང་ཁྱད་པར་ཇི་ལྟ་བུ་ཅན་ཞིག་ཅེ་ན་དེའི་ཕྱིར་ཁ་སྐོང་བར་འོས་པ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "མི་འོས་པ་བསྙེན་པར་མ་རྫོགས་པ་དང་།",
    "ལུས་ཀྱིས་འདུས་པར་རྗེས་སུ་མ་ཞུགས་པའམ་ལས་དེ་ལ་འདུན་པས་རྗེས་སུ་མ་ཞུགས་པ་སྟེ།",
    "དེ་ནི་འདུས་པར་རྗེས་སུ་མ་ཞུགས་པ་ཉིད་ཀྱིས་མི་མཐུན་པ་ཉིད་ཅེས་བྱ་སྟེ།",
    "ཕྱིར་ཟློག་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི།",
    "ཕྱིར་ཟློག་པར་བྱེད་པ་ཡང་ངོ་ཞེས་བྱ་བ་སྟོན་ཏོ།",
    "འཁར་བའི་གནང་བ་ལ་སོགས་པ་སྦྱིན་པ་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "ཕྱིར་ཟློག་པ་མི་འཆགས་སོ་ཞེས་གང་གསུངས་པ་དེ་ལ།",
    "མི་འཆགས་སོ་ཞེས་བྱ་བ་དེ་ནི་ངས་ཆད་པའི་ལས་ལ་དགོངས་ཏེ་གསུངས་སོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདིས་ནི་བྱིས་པ་དང་རྨོངས་པ་དང་མི་མཁས་པ་ཞེས་གང་གསུངས་པ་དེ་བསྡུས་སོ།",
    "གང་ཟག་ཕྱིར་ཟློག་པར་བྱེད་པ་དེ་དང་།",
    "ངག་ཡང་དག་པར་བསྡམས་པས་སོ་ཞེས་གསུངས་པ་ལ།",
    "ནང་དང་བཅས་པ་གཉིས་བསལ་བར་རིག་པར་བྱའོ།",
    "སིལ་བུ་དག་ལས་བཙུན་པ་ཇི་ཙམ་གྱིས་ན་ངག་ཡང་དག་པར་བསྡམས་པ་ལགས།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་དག་བསྡུ་པའི་ཕྱིར་བརྫུན་དུ་སྨྲ་བའི་རྗེས་སུ་མཐུན་པ་ཉིད་ནི་ངག་ཡང་དག་པར་མ་བསྡམས་པའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེ་ནི་ངག་ཡང་དག་པར་མ་བསྡམས་པ་ཡིན་གྱི།",
    "རྗེས་སུ་མཐུན་པ་ཉིད་ནི་ངག་ཡང་དག་པར་མ་བསྡམས་པའོ་ཞེས་བྱ་བའི་རྗེས་བསྙག་པའི་ཕྱིར།",
    "དེས་ན་ངག་ཡང་དག་པར་མ་བསྡམས་པ་དེ་ནི་རང་བཞིན་དུ་གནས་པ་མ་ཡིན་པ་ཞེས་ཀྱང་བྱའོ།",
    "དེས་ན་གང་ཟག་གཅིག་པུ་ལ་ལྟ་བ་བརྗོད་པར་ག་ལ་བྱ་སྟེ།",
    "བསྙེན་པར་མ་རྫོགས་པ་ལ་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་ཚུལ་གྱི་ཆོ་གས་ལ་ཡང་ལྟ་བ་བརྗོད་པར་མི་བྱ་བའོ།",
    "ཁ་སྐོང་པར་འོས་པ་མ་ཡིན་པ་ལ་ཡང་ངོ་ཞེས་བྱ་བ་ནི།",
    "གནས་པར་མི་བྱ་བ་ལ་ལྟ་བ་བརྗོད་པ་དང་།",
    "བསྙེན་པར་མ་རྫོགས་པ་ལ་ལྟ་བ་བརྗོད་པ་དང་།",
    "དགེ་ཚུལ་ལ་ལྟ་བ་བརྗོད་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་གནས་ནས་ཕྱུང་བ་ལ་ལྟ་བ་བརྗོད་ན་ཡང་ཉེས་བྱས་སུ་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་བས་ན་ཐམས་ཅད་དུ་ཡང་ཁ་སྐོང་བར་འོས་པ་མ་ཡིན་པ་བཀག་པར་ཤེས་པར་བྱའོ།",
    "སྔར་བསྐོས་པའི་གང་ཟག་བརྗེས་ནས་བྱ་བ་དེ་ལ་ཆེས་ལེགས་པར་བྱེད་པ་དང་ཆེས་མང་དུ་བྱེད་པའི་གང་ཟག་གཞན་ཡིན་པ་དེ་བསྐོ་བར་བྱ་བའོ།",
    "དུས་ངེས་པར་བྱས་ཏེ་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གང་ལ་དུས་ངེས་པར་བྱ་སྟེ་བསྐོ་བར་མི་བྱ་ཞེ་ན།",
    "ཡང་དང་ཡང་དུ་འམ་གཞན་ལ་ཞེས་སྨོས་པ་ལས་གཞན་པ་ལས་གཅིག་ལ་དུས་ངེས་པ་མེད་པར་བསྐོས་པ་དེ་ལས་ཡང་ཅི་རན་ཙམ་ན་བརྗེ་བར་བྱ་བ་སྟེ།",
    "ཉེ་བ་འཁོར་མི་འགྱུར་རོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "གང་ལ་ལས་བརྗོད་པ་དག་ལྷག་པར་བྱེད་པ་དེ་ལ་ནི་ལས་མི་འཆགས་པ་ཉིད་མ་ཡིན་ཏེ།",
    "ཉམས་ན་མ་བྱས་པ་ཉིད་དོ་ཞེས་བྱ་བ་ནི།",
    "གང་ལ་ལས་བརྗོད་པ་ཇི་སྙེད་གསུངས་པ་དེ་ལས་ཉམས་ན་ནི་ལས་དེ་མ་བྱས་པ་ཉིད་དོ།",
    "ཉམས་པ་དང་མ་བྱས་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "རྫོགས་པར་བྱས་པ་གང་ཡིན་པ་ད་ནི་བྱས་པ་ཉིད་ཁོ་ན་ཡིན་ནོ།",
    "འདིར་མ་ལངས་པ་ཞེས་བྱ་བ་ནི་སྟན་ལས་མ་འཕགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "ལས་ཀྱི་ཚིག་སྔར་རྫོགས་པ་ཡང་རྣམ་པར་འཁྲུགས་པ་ཉིད་དོ།",
    "ཡང་གསོལ་བ་བགྱིའོ་ཞེས་བྱ་བ་ནི་གསོལ་བའི་བདག་ཉིད་ཀྱིས་ཚིག་རྫོགས་ཟིན་པ་དེ་ཡང་གཞི་ནས་བཟླས་པར་འདོད་ན་དེ་སྐད་བྱའོ།",
    "ལས་བརྗོད་པ་འབའ་ཞིག་ཡང་གཞི་ནས་བཟླས་པར་འདོད་ན་དེ་སྐད་ཅེས་བྱའོ།"
  ]
}