    "སོར་ཉི་ཤུ་རྩ་དྲུག་གི་རྒྱར་བརྐྱང་བའི་སོར་མོ་ལོགས་སུ་བསྟན་ཅིང་།",
    "པུས་མོ་གཉིས་དྲང་པོར་བྱས་པ་ནི་ས་གའོ།",
    "རྐང་པ་གཉིས་ཀྱི་སོར་མོ་ཕན་ཚུན་སྦྱར་བ་ནི་མཉམ་པའི་རྐང་སྟབས་སོ།",
    "ལྔ་པོ་འདི་རྣམས་བྱེད་པ་ན་རེ་རེ་བྱེད་ཅིང་བསྐོར་བ་ལན་རེ་རྫོགས་པར་བྱའོ་ཞེས་པ་ནི་ཁ་ཅིག་གོ།",
    "རེ་རེ་བྱེད་ཅིང་བསྐོར་བ་ལན་གསུམ་མོ་ཞེས་པ་ནི་གཞན་དག་གོ།",
    "རྟིང་པ་གཉིས་ཀྱི་བར་དུ་སོར་མོ་བཞི་བྱས་ཤིང་རྐང་པ་གཡོན་པ་དྲང་པོར་བྱས་ཏེ་འགྱིང་བ་དང་བཅས་པས་གཡས་པ་མཐོ་གང་གི་བར་དུ་ལོགས་སུ་བསྟན་ཅིང་ཡངས་པ་ཅན་གྱི་སྒྲོལ་མའི་ཞབས་ལྟར་བྱས་པ་ནི་སྐྱེས་པའི་རྐང་སྟབས་སོ།",
    "དེ་ནས་གཡས་བརྐྱང་གི་གར་བྱས་ལ་ཁ་ལྷོར་ཕྱོགས་ཏེ།",
    "དེ་ནས་པུས་མོ་གཡས་པ་བསྐུམ་ལ་དབྱུག་པའི་ཕྱག་རྒྱ་སྟེང་དུ་བརྐྱང་སྟེ།",
    "གཡོན་པ་རྡོ་རྗེའི་རྐང་སྟབས་བྱས་ཏེ་པུས་མོ་གཡས་པ་བསྐུམ་ལ་རྐང་བ་བཏེག་སྟེ་ཁྲོ་བ་དང་བཅས་པས།",
    "བུས་མོ་གཡོན་པ་བསྐུམ་སྟེ་གཡས་པ་རྡོ་རྗེའི་རྐང་སྟབས་སུ་བྱས་ནས་གཡོན་པ་བཏེག་པ་དང་དུས་གཅིག་ཏུ་གཡས་ཕྱོགས་སུ་བསྐོར་ཏེ་དེ་ནས་གཞག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་བསླངས་ནས་རྐང་པ་གཉིས་མཐོ་གད་ཙམ་གྱི་བར་དུ་བྱས་ཏེ་གྲུ་གསུམ་བྱ་ཞིང་བུས་མོ་གཡས་བཅུད་ཟད་བསྐུམ་ལ་བུས་མོ་གཡོན་པ་དང་གསུས་པ་དང་།",
    "དེ་ཉིད་ནི་ཀཱི་ལི་ཀཱི་ལི་ཆེན་པོ་ཡིན་ཏེ་གང་གི་ཚེ་དབྱུག་པ་ལ་བལྟ་བར་གནས་པ་གཡས་པའི་དཔུང་བའི་ཕྱོགས་ནས་རང་གི་རྒྱབ་ཏུ་ཁྱེར་ཞིང་མིག་གཡོན་པ་བཙུམས་ཏེ་ཁྲོས་ཤིང་རྐང་པ་རྣམ་པར་རྐྱོང་བར་བྱེད་པའི་ཚེའོ།",
    "སོར་མོ་བཞི་རྩེ་མོ་བསྐུམ་པས་མཐེ་བོད་མནན་པ་ནི་རྡོ་རྗེའི་ཁུ་ཚུར་རོ།",
    "རྡོ་རྗེའི་གར་སྔོན་དུ་འགྲོ་བས་དཀུ་གཉིས་སུ་བཙུགས་ཏེ་མགོ་གཡོན་པར་སྨད་པ་ནི་བུད་བྱེད་སྒྱུ་མ་བྱེད་པའོ།",
    "དཀུ་གཉིས་སུ་བཙུགས་པ་ནི་རྡོ་རྗེ་སྒེག་མོའི་ཕྱག་རྒྱའོ།",
    "རྡོ་རྗེ་བསྡམས་པས་བཟུང་བའི་གཏུན་ཤིང་གིས་བགེགས་བརྡུང་བ་ནི་གཏུན་ཤིང་གི་ཚུལ་ལོ།",
    "ཐལ་མོ་སྦྱར་ནས་སོར་མོའི་རྩེ་མོ་ཕན་ཚུན་བསྣོལ་བ་ནི་རྡོ་རྗེ་ཐལ་མོའོ།",
    "གཡས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་མཛུབ་མོ་གཉིས་གུང་མོ་དག་འགྱིང་བ་དང་བཅས་པས་བརྐྱང་ནས་སྟེང་དུ་བཞག་པ་ནི་བ་དན་གྱི་ཚུལ་ལོ།",
    "ཐལ་མོ་སྙིམ་པ་ཁ་སྦྱར་ཏེ་པདྨ་བཞིན་ཁ་ཕྱེ་བ་ནི་པདྨའི་ཚུལ་ལོ།",
    "ཁུ་ཚུར་གཡས་པའི་ནང་དུ་མཐེ་བོང་བཅུག་སྟེ་མཛུབ་མོ་བརྐྱང་ལ་ལག་པ་སྟེང་དུ་བསྒྲེང་པ་ནི་དབྱུག་པའི་ཚུལ་ལོ།",
    "གཡས་པའི་མཛུབ་མོ་ལྕགས་ཀྱུའི་ཚུལ་དུ་བཟུང་བ་ནི་ལྕགས་ཀྱུའི་ཚུལ་ལོ།",
    "ལག་པ་གཡས་པའི་སོར་མོ་རྣམས་བརྐྱང་ལ་བཀུག་པ་ནི་གདེངས་ཀའི་ཚུལ་ལོ།",
    "གཡས་པའི་མཛུབ་མོ་དང་གུང་མོ་དག་གིས་གཡས་ཕྱོགས་ནས་མདའ་དྲང་བར་བྱ་བ་ནི་མདའ་དྲང་བའི་ཚུལ་ལོ།",
    "དེ་ལ་རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་གིས་ས་གནོན་གྱི་ཕྱག་རྒྱ་བཅིང་བ་ནི་རྡོ་རྗེའི་གདན་གྱི་ཚུལ་ལོ།",
    "བྱིན་པ་གཡས་པ་བྱིན་པ་གཡོན་པར་བཞག་སྟེ་བུས་མོ་གཉིས་སྨད་པ་ནི་པདྨའི་གདན་ནོ།",
    "རྐང་པ་གཡོན་པས་སྐྱིལ་ཀྲུང་ཕྱེད་པ་བྱས་ཏེ་དེ་དང་ཉེ་བར་བུས་མོ་གཡས་བ་སྟེང་དུ་དྲང་བར་བྱ་བ་ནི་དཔའ་བོའི་འདུག་སྟངས་སོ།",
    "གཡོན་པ་སྐྱིལ་ཀྲུང་ཕྱེད་པ་བྱས་ཏེ་དེའི་སྟེང་དུ་པུས་མོ་གཡས་པ་བསྙལ་ལ།",
    "རྐང་པ་གཉིས་མཐོ་གང་གི་བར་དུ་སྟན་ལ་བཀོད་ལ་ཙོག་པུར་གནས་པ་ནི་ཙོག་བུའི་དུག་སྟངས་སོ།",
    "ཞི་བའི་ཉམས་མན་ངག་གི་སྙེ་མར་རྣམ་པར་ཕྱེ་བར་རྣམས་བསྒྲུབ་པར་བྱའོ།",
    "གར་དང་གླུ་ལ་སོགས་པས་ཡང་དག་པར་མཆོད་ནས་ལག་པས་རེག་ཅིང་དཀྱིལ་འཁོར་གྱི་བདག་པོའི་སྔགས་བརྒྱ་རྩ་བརྒྱད་དང་།",
    "དེ་ནས་སྔ་བར་ལངས་ནས་འགྲོ་བ་རྡོ་རྗེ་འཆང་གི་གོ་འཕང་ལ་དགོད་པར་བྱ་བའི་ཆེད་དུ་བགེགས་མེད་པར་བྱའོ་ཞེས་བསམས་ནས།",
    "འོག་ཏུ་ས་གཞི་འབར་ཞིང་འོད་ཟེར་བཟོད་པར་དཀའ་བའི་སྣ་ཚོགས་རྡོ་རྗེའི་རང་བཞིན་དུ་བསྒོམ་མོ།",
    "དེའི་དབུས་སུ་སྐད་ཅིག་གིས་བདག་ཉིད་རྡོ་རྗེ་སེམས་དཔའི་ངོ་བོ་ཡོངས་སུ་གྱུར་ནས།",
    "ཞལ་རེ་རེ་ཞིང་སྨིན་མ་འཁྱུག་པ་ཁྲོ་གཉེར་དང་བཅས་པ།",
    "སྟག་གི་བགས་པའི་ན་བཟའ་འབྱང་བ།",
    "མཐེའུ་ཆུང་གཉིས་སྤྲེལ་ཞིང་མཛུབ་མོ་གཉིས་བརྐྱང་བར་བྱས་པའི་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱས་རང་འོད་ཀྱི་ཤེས་རབ་དང་སྙོམས་པར་འཇུག་པ་ཕྱག་གཡས་པ་དག་གིས་ལྕགས་ཀྱུ་དང་ཞགས་པ་དང་།",
    "གཡོན་པ་དག་གིས་ཐོད་པ་དང་ཁ་ཊྭཱཾ་ག་འཛིན་པ།",
    "དེ་ལྟར་ཕུར་བུ་བཏབ་པ་དང་བརྡུང་བ་དག་གིས་བགེགས་ཀྱི་ཚོགས་བ་དེ་བ་ཆེན་པོས་དེ་བཞིན་ཉིད་དུ་རོ་གཅིག་པ་དང་།",
    "བགེགས་ལྷག་མ་རྣམས་ཀྱང་རིང་དུ་བྲོས་པར་བསམ་མོ།",
    "བརྡུང་བ་བྱས་ལ་ལག་པ་གན་རྐྱལ་དུ་གནས་པ་བསྒྱུར་ནས་ཨོཾ་ཨཱ་བཛྲ་ཧཱུཾ་ཞེས་བརྗོད་ཅིང་ས་ལ་བསྣུན་ཅིང་དེ་ལྟར་མོས་པར་བྱའོ།",
    "སོར་མོའི་རྩེ་མོས་ལ་ལན་གསུམ་བསྣུན་པ་དང་།",
    "དེའི་སྒྲ་དང་ཧཱུཾ་གི་འོད་ཟེར་རྣམས་ཀྱིས་བསྐུལ་བས་སའི་ལྷ་མོ་ཡེ་ཤེས་སེམས་དཔའི་ངོ་བོ་འཐོན་པ་དང་ལྷན་ཅིག་འདྲེས་པར་གྱུར་པ་དགའ་བ་དང་ལྡན་པའི་ཐུགས་ཅན་སེར་མོ་ཞི་བ་ན་བཟའ་དཀར་པོ་བསྣམས་པ་རྒྱན་སྣ་ཚོགས་ཅན།",
    "ལྷ་མོ་ཆེན་མོ་འཇིག་རྟེན་ཡུམ།",
    "ལྷ་མོ་ཁྱོད་ནི་དཔང་དུ་གྱུར།",
    "དེ་ལྟར་བདག་གིས་བདུད་ཀྱི་སྟོབས།",
    "ཨོཾ་བཛྲ་ཨུ་ཥྞཱི་ཥ་ཧཱུཾ་ཕཊ་ཅེས་པ་དག་གིས་གོ་རིམས་བཞིན་དུ་ལན་བདུན་དུ་བསྔགས་པའི་གོས་དམར་པོ་དང་ཅོད་པན་གྱིས་བརྒྱན་པ་དཀྱིལ་འཁོར་གྱི་གཞིའི་དབུས་སུ་ཤར་དུ་ཕྱོགས་པར་འདུག་པའམ།",
    "གུར་གུམ་ལ་སོགས་པས་མཎྜལ་རྣམས་བྱས་ལ་རང་གི་དམ་ཚིག་གི་འཁོར་ལོ་ཇི་ལྟ་བར་བསྒོམས་ནས་དེ་ལ་ནམ་མཁའ་ལ་གནས་པའི་ཡེ་ཤེས་ཀྱི་འཁོར་ལོ་སྤྱན་དྲངས་ནས་བཅུག་སྟེ།",
    "རྒྱས་པ་དག་གི་བུམ་བའི་ལྟོ་བ་ནི་ཟླུམ་པོ་སོར་བཅུ་དྲུག་གོ།",
    "ཆ་གཅིག་གིས་ནི་བཅུ་གཉིས་ཀྱི་ཞེང་ངོ།",
    "དབྱེ་བ་དང་བསྐྲད་པ་དག་གི་ལྟོ་བ་ནི་ཟླུམ་པོར་སོར་བཅུ་གཉིས་སོ།",
    "མཆུ་གཉིས་ནི་སོར་རེ་རེའོ།",
    "རེངས་པ་ལ་ནི་ཐུང་ཞིང་ཟླུམ་པ་དང་།",
    "མོན་སྲན་དང་།",
    "ཁ་ཅིག་ཏུ་ནི་གྲོའི་གནས་སུ་མོན་སྲན་གྲེའུའོ།",
    "ཨ་མྲ་དང་།",
    "བུམ་པ་གཞན་རྣམས་ལ་ནི་པདྨ་ལ་གནས་པའི་ཟླ་བའམ་ཉི་མར་ཇི་ལྟར་རིགས་པར་ལྷ་རྣམས་ཀྱི་རང་རང་གི་མཚན་མའམ་ས་བོན་ནོ།",
    "གཟུགས་རྡོ་རྗེ་ལ་སོགས་པ་དྲུག་གི་གཅིག་དང་།",
    "ཁ་ཅིག་གིས་ནི་འདི་མི་འདོད་དོ།",
    "འགའ་ཞིག་གིས་བརྗོད་པའི་ཕྱོགས་རྣམས་ལས་ཕྱོགས་གཞན་དུ་བརྗོད་པ་ནི་མི་རིགས་སོ།",
    "རང་ཕྱོགས་སྲས་གཉིས་བདག་གི་གཅིག།",
    "ཁྲོ་དྲུག་བཙུན་མོ་རྣམས་ཀྱི་ཡང་།",
    "བགེགས་དགྲའི་རེ་རེ་ཉི་ཤུའོ།",
    "ཕྱོགས་ཀྱི་ལྷ་མོ་རྣམས་ཀྱི་གཅིག་གོ།",
    "མཚམས་ཀྱི་ལྷ་མོ་བརྒྱད་རྣམས་ཀྱི་གཅིག་གོ།",
    "རིམ་པ་གཉིས་པར་གནས་པའི་ཕྱོགས་ཀྱི་ལྷ་མོ་རྣམས་ཀྱི་གཅིག་གོ།",
    "མཚམས་ཀྱི་ལྷ་མོ་རྣམས་ཀྱི་གཅིག་གོ།",
    "བདེ་མཆོག་གི་དཀྱིལ་འཁོར་ལ་ནི་འཁོར་ལོ་ལྔ་ལ་སོ་སོར་རེ་རེ་སྟེ་ལྔའོ།",
    "དེ་བཞིན་དུ་གསུང་གི་འཁོར་ལོ་དང་སྐུའི་འཁོར་ལོར་ཡང་དེ་བཅུ་དགུའོ།",
    "དྲི་བཟང་གི་ཆུ་ཨོཾ་བཛྲ་ཨ་མྲྀ་ཏོ་ད་ཀ་ཋ་ཧཱུཾ་ཞེས་བྱ་བ་དང་།",
    "མཚན་མ་ལ་ཡང་དམ་ཚིག་གི་ལྷ་དང་ཡེ་ཤེས་ཀྱི་ལྷ་གཅིག་ཏུ་གྱུར་པར་བསམ་མོ།",
    "བུམ་པ་གཞན་ལྷ་གང་དང་གང་ཡིན་པ་དེ་དང་དེའི་སྔགས་ཀྱིས་བརྒྱ་རྩ་བརྒྱད་དམ་ཉི་ཤུ་རྩ་གཅིག་གམ་བདུན་དུ་བཟླས་ཏེ་སྟེང་གི་རྡོ་རྗེ་མེ་ཏོག་གི་ཕྲེང་པའི་མཐར་དེ་ལྟར་བཟུང་ནས་སོ།",
    "འདིར་ཇི་སྲིད་དུ་དཀྱིལ་འཁོར་གྱི་བྱ་བ་རྣམས་རྫོགས་པ་དེ་སྲིད་དུ་བགེགས་རྣམས་བཟློག་བར་མཛོད་ཅིག་ཅེས་བརྗོད་ཅིང་གཏོར་མ་བྱིན་ནས་ཉེ་བར་རེག་སྟེ།",
    "སྤྱན་མའི་ཨོཾ་ཨཱ་མོ་ཧ་ར་ཏཱི་ཧཱུཾ།",
    "གོས་དཀར་མོའི་ཨོཾ་ཨཱ་རཱ་ག་ར་ཏཱི་ཧཱུཾ།",
    "རེག་བྱ་རྡོ་རྗེ་མའི་ཨོཾ་ཨཱ་སྤ་ཪྵེ་བཛྲེ་ཁཾ་ཧཱུཾ།",
    "གང་གི་ཚེ་འཇམ་པའི་རྡོ་རྗེ་དང་དབྱེར་མེད་པའི་མི་བསྐྱོད་པས་འཁོར་ལོའི་གཙོ་བོ་བྱེད་པ་དེའི་ཚེ་ཨོཾ་ཨཱ་བཛྲ་དྷྲྀཀ་ཧཱུཾ་ངོ།",
    "གང་གི་ཚེ་མི་བསྐྱོད་པ་དང་དབྱེར་མེད་པའི་རྡོ་རྗེ་སེམས་དཔའ་འཁོར་ལོའི་གཙོ་བོ་བྱེད་པ་དེའི་ཚེ་འདིར་ཨོཾ་ཨཱ་ཧཱུཾ་ཧཱུཾ་ཞེས་པ་སྔགས་སོ།",
    "ཨོཾ་ཨཱ་བཛྲ་ཨ་མྲྀ་ཏ་མ་ཧཱ་སུ་ཁ་ཧཱཾ་སྭཱ་ཧཱ།",
    "ཨོཾ་ཨཱ་ཨཱ་ཨཾ་ཨ་ཞེས་པ་བརྗོད་ཅིང་ཚོན་དང་ཐིག་ལ་བསང་གཏོར་བྱའོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱིས་གཞི་དྲི་བཟང་པོ་ལ་སོགས་པས་བྱུག་ཅིང་མེ་ཏོག་གི་གཅལ་བཀྲམ་སྟེ།",
    "པུས་མོ་གཡས་པ་ས་ལ་བཙུགས་ཤིང་ལྕེ་ཧཱུཾ་ལས་སྐྱེས་པའི་རྡོ་རྗེ་རྩེ་གཅིག་པ་བྱས་པར་ཧཱུཾ་བཀོད་དེ།",
    "རིག་པའི་རྒྱལ་པོ་ཁྱོད་ལ་འདུད།",
    "ཐ་ན་གཅིག་གིས་ཀྱང་བྱ་བར་འདོད་དོ།",
    "ཡེ་ཤེས་ཀྱི་ཐིག་ལ་སོགས་པའི་དོན་དུ་དཀྱིལ་འཁོར་གྱིས་གཞིའི་སྟེང་དུ་ནམ་མཁའ་ལ་བློས་བཀོད་ནས་ཤར་དུ་ཕྱོགས་ཏེ་རྡོ་རྗེ་འཆང་གི་རྣལ་འབྱོར་རམ་དཀྱིལ་འཁོར་གྱི་གཙོ་བོའི་རྣལ་འབྱོར་དང་ལྡན་ཞིང་མཚན་མ་ཐོབ་པས།",
    "གཡོན་པའི་ལག་མཐིལ་དུ་སོར་མོའི་རྩེ་མོ་ནས་བརྩམས་ཏེ་མཐེ་བོའི་རྩ་བའི་བར་དུ་བཀོད་ལ།",
    "བྷྲཱུཾ་ཨོཾ་ཧྲཱི་ཁཾ་ཧཱུཾ་གི་ཡི་གེ་རྣམས་སམ།",
    "བྷྲཱུཾ་ཨཱཾ་ཛྲཱིཾ་ཁཾ་ཧཱུཾ་གི་ཡི་གེ་རྣམས་སམ།",
    "རྒྱུད་ཇི་ལྟ་བར་བསྐྱེད་པའི་དེ་བཞིན་གཤེགས་པ་ལྔའི་ངོ་པོར་གྱུར་པར་བསྒོམས་ནས་ནམ་མཁའ་ལ་བཞུགས་སུ་གསོལ་བའི་རང་རང་གི་ཕྱོགས་ཀྱི་དེ་བཞིན་གཤེགས་པ་བསྡུས་པར་གྱུར་པའི་དེ་བཞིན་གཤེགས་པ་ལྔའི་ཐུགས་ཀར་བྷྲཱུཾ་ལ་སོགས་པ་ལས་གྲུབ་པའི་ཡེ་ཤེས་ཀྱི་སྐུད་པ་འོད་ཟེར་གྱི་རང་བཞིན་བལྟས་ལ།",
    "མིག་རབ་ཏུ་མྱུར་དུ་བསྒྲིལ་ཞིང་མིག་གི་རྫི་མ་འདེགས་ཤིང་བརྡེབ་པ།",
    "འབར་བའི་ལྟ་སྟངས་ལྕགས་ཀྱུ་ལྟ་བུས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་བསྐུལ་བས་དེ་རྣམས་བཀུག་ལ་རང་རང་གི་ཁ་དོག་ཅན་གྱི་ཐིག་སྐུད་ལག་པ་ན་གནས་པ་རྣམས་ལ་བསྟིམ་མོ།",
    "ཡེ་ཤེས་རེ་རེ་ཞིང་ལྷ་ཉི་ཤུའི་དཀྱིལ་འཁོར་གྱི་བདག་ཉིད་ཡིན་པས་རྣམ་པ་བརྒྱར་ཕྱེ་བ་ཡིན་ནོ་ཞེས་ཁ་ཅིག་ཏུ་གསུངས་སོ།",
    "ཨོཾ་ཨཱ་ཧཱུཾ་ཞེས་བརྗོད་ཅིང་དང་པོར་སྐུད་བ་ལྔ་ལྔས་ཐིག་སྐུད་རེ་རེ་བྱའོ།",
    "དེ་དག་རྡོ་རྗེ་ཁུ་ཚུར་དུ་བྱས་པ་ཉིད་དག་གིས་མཛུབ་མོའི་རྒྱབ་ཀྱིས་ལ་སྦྱར་ཏེ་མནན་པའི་བར་གྱི་ལྷག་པ་མ་གཏོགས་པ་ཇི་སྲིད་དུ་དཀྱིལ་འཁོར་གྱི་ཉིས་འགྱུར་དུ་རིང་བ་དང་།",
    "ལག་པས་རེག་ཅིང་འཁྱིལ་པ་བཟླས་པས་བསྲུང་བར་བྱའོ།",
    "རྡོ་རྗེ་དང་བཅས་པའི་ལག་བ་གཡས་པས་རེག་ལ།",
    "རྡོ་རྗེ་དང་བཅས་པའི་ལག་པ་གཡས་པའི་མཐེ་བོ་དང་མཛུབ་མོ་དག་གིས་ཐིག་སྐུད་བཟུང་བས་འདེབས་ཤིང་སེ་གོལ་གྱི་སྒྲ་བྱའོ།",
    "ཐིག་གི་སྒྲ་དེས་ཀྱང་ནམ་མཁའ་ཀུན་ཁྱབ་པའི་དེ་བཞིན་གཤེགས་པ་རྣམས་བསྐུལ་བར་བྱའོ།",
    "དེ་རྣམས་ཀྱང་བྱོན་ནས་ཐིག་སྐུད་རྣམས་ལ་ཐིམ་པར་བསྒོམ་མོ།",
    "ཐམས་ཅད་དུ་ཡང་སློབ་དཔོན་དང་སྒྲུབ་པའི་གྲོགས་པོ་གཡས་སྐོར་དུ་འགྲོ་ཞིང་ཕྱོགས་ཐམས་ཅད་མཉམ་པ་ཉིད་དུ་མོས་པར་བྱའོ།",
    "འོན་ཀྱང་དང་པོར་ཁྲུའི་ཚད་ཀྱི་མཎྜལ་གྱི་དབུས་སུ་མཐོ་གང་གི་ཚད་ཀྱི་ཤིང་བུ་བཀོད་པའི་གྲིབ་མ་འཇུག་པ་དང་།",
    "དེ་ནས་ཕྱོགས་རྣམས་སུ་ཉའི་མགོ་མཇུག་དག་གི་དབུས་སུ་ཐིག་སྐུད་བཟུང་ནས།",
    "འདི་གཉིས་རེ་རེ་ཞིང་སྒོའི་ཚད་བཅུ་བདུན་ནོ།",
    "ཇི་སྲིད་ཁྲུ་ནི་སྟོང་གི་བར།",
    "འདབ་མ་དང་རྡོ་རྗེ་ཕྲེང་པ་དག་ཆ་ཆུང་རེ་རེ་དག་ཀྱང་མི་རིགས་སོ།",
    "ཐིག་དེའི་གཅིག་གི་བརྒྱད་ཆ་ནི་སྒོ་ཡིན་ལ་སྒོའི་བཞི་ཆ་ནི་ཆ་ཆུང་གཅིག་གོ།",
    "དེ་ནས་ཚངས་པའི་ཐིག་གི་ངོས་སུ་གཡས་དང་གཡོན་དག་གི་ཆ་ཆུང་གཉིས་གཉིས་རྩ་བའི་ཐིག་གིས་དང་བཅས་པ་དེ་ཆ་ཆུང་བཞི་པ་སྟེ།",
    "དེར་གནས་པའི་ཚངས་ཐིག་གི་ངོས་གཉིས་ཀྱི་རྩ་བའི་ཐིག་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྐུ་གཡོན་པ་དང་ཅིག་ཤོས་ཀྱི་མིག་དག་གི་ཡི་གེ་ཧཱུཾ་གིས་ཟླ་བ་དང་ཉི་མར་བསྐྱེད་ནས་ཁྲོ་བོའི་ལྟ་བས་ཐམས་ཅད་དུ་བལྟ་ཞིང་།",
    "ཞེས་ལྷག་པར་མོས་པས་དབྱི་བར་བྱའོ།",
    "སྟེགས་བུའི་ས་དག་གི་ཡིན་ཏེ།",
    "ལོགས་སུ་ཐིག་གསུམ་གྱི་རྩེ་མོ་ལ་རེག་པའོ།",
    "དེའི་གློར་ཆ་ཆུང་རེ་རེ་དོར་བར་ཐིག་གསུམ་སྟེ།",
    "རྟ་བབས་ཀྱི་ཀ་བ་དང་བར་དང་ཚོན་གྱི་སའོ།",
    "དེ་ནས་ཚངས་པའི་ཐིག་གི་ལོགས་སུ་ཆ་ཆུང་གཉིས་སྤངས་པར་རྩ་ཐིག་ནས་སྒོ་ཁྱུད་ཆ་ཆུང་བཞི་པ་དྲང་པོར་འཐོན་ཏེ།",
    "ལོགས་སུ་འགྲམ་པ་ཆ་ཆུང་གཉིས་སོང་ནས།",
    "དེའི་རྩེ་མོ་ནས་ལོགས་སུ་ཚངས་ཐིག་གི་ལོགས་གཉིས་པར་གནས་པ་དེ་ལྟ་བུ་ཀྱོག་པོའི་རྩེ་མོའི་བར་དུ་སོང་བས་ཆ་ཆུང་བརྒྱད་པ་གདུང་མཚོན་པར་བྱེད་པའི་ཐིག་གོ།",
    "དེ་བཞིན་དུ་དེའི་གློའི་ཐིག་གི་རྩེ་མོ་ནས་གཞན་དེའི་གློའི་ཐིག་གི་རྩེ་མོའི་བར་དུ་ཆ་ཆུང་བཅུ་པའི་ཐིག་གཅིག་སྟེ་ཡ་ཕུབས་ཀྱི་སའམ།",
    "གདུང་དང་བཅས་པའི་བྲེ་ཕུལ་གྱི་སའམ་གདུང་གི་སྟེང་གི་ཚོན་སྣ་ལྔའི་སའོ།",
    "རྩ་བའི་ཐིག་གིས་ལས་ཕྱིར།",
    "ལྷའི་སྣམ་བུ་ནི་རྩ་བའི་ཐིག་གི་ནང་དུའོ།",
    "འདིར་ངོས་སུ་སོང་བ་ནི་ལོགས་ཡིན་ཞིང་།",
    "སྟེང་དུ་སོང་བ་ནི་འགྲམ་པའོ་ཞེས་བརྗོད་པ་ནི།",
    "གང་ཡང་ཕྱོགས་འདི་ལ་བྲེ་ཕུལ་གྱི་དོན་དང་མདའ་ཡབ་ཀྱི་དོན་དུ་ལོགས་ཀྱི་ཐིག་གཉིས་ལ་གནས་པའི་ཐིག་གི་ཕྱི་རོལ་དུ་ཆ་ཆུང་གཅིག་གི་བར་སྤངས་ནས་ཐིག་གཅིག་ཅེས་སྨྲ་བ་དེ་ལ་ནི་འདིར་རྗོད་པར་བྱེད་པའི་གཞུང་མེད་ཅིང་རང་གིས་བརྟགས་པ་ཡིན་ན་ཡང་།",
    "འདིར་བྲི་བྱའི་དཀྱིལ་འཁོར་ལ་མདའ་ཡབ་ནི་དར་དཔྱངས་ཀྱི་ཐིག་གི་བར་དུའོ།",
    "བསྒོམ་བྱའི་དཀྱིལ་འཁོར་ལ་ནི་ལོགས་ཀྱི་སྟེང་གི་བར་དུ་སྟེ།",
    "གདུང་གི་འོག་ཏུ་ཀ་བ་གཉིས་མ་བྲིས་ཀྱང་བསྒོམ་བྱའི་དཀྱིལ་འཁོར་ལ་རིག་པར་བྱ་སྟེ།",
    "ཞེས་པའི་ལུང་གིས་སོ།",
    "འདིས་དཀྱིལ་འཁོར་གྱི་ནང་གི་ཀ་བ་བརྒྱད་ནི་མ་གསུངས་ཏེ།",
    "གང་ཞིག་དེ་ལྟར་ཐིག་ཐུང་མི་འདོད་པ་དེས་ནི་ལོགས་སུ་ཟུར་ཐིག་གི་བར་དུ་རྩ་བའི་ཐིག་ལས་ཕྱིར་རིམ་པ་བཞིན་དུ་ཆ་ཆུང་གཅིག་དང་།",
    "རྩ་བའི་ཐིག་ལས་འཐོན་པའི་ཐིག་བདུན་ཡང་ཚངས་ཐིག་གི་གཡས་སུ་ཐིག་དྲུག་པའི་བར་དུའོ།",
    "གཞན་རྣམས་ནི་ཆ་ཆུང་རེ་རེ་སྤངས་པར་རོ།",
    "དེ་ལ་ཀ་བའི་རྩེ་མོ་ནས་ཕྱིར་ཐིག་བཅུ་གཅིག་གོ།",
    "སྣམ་བུ་དགུ་ནི་སོ་སོར་ཆ་ཆུང་རེ་རེའོ།",
    "དེ་ལ་ཚངས་པའི་ཐིག་གི་གཡས་དང་གཡོན་དུ་ཆ་ཆུང་ཕྱེད་དང་དྲུག་དོར་བར་སྣམ་བུ་དང་པོ་སྟེ་ཆ་ཆུང་ཕྱེད་དང་གསུམ་པའོ།",
    "འདི་ལ་སྣམ་བུ་ལྔ་པའི་ལོགས་སུ་ཆ་ཆུང་ཕྱེད་དང་བཞི་ནི་སྟེང་གི་ཆ་ལའོ།",
    "སྣམ་བུ་རྣམས་རེ་རེ་ཞིང་ཕྱིར་ངོས་ཀྱི་མཐར་ཐིག་གཅིག་ཇི་ལྟར་རིགས་པར་རོ།",
    "ནང་གི་མཐར་ཡང་ཐིག་དང་པོའི་ཆ་ཆུང་ཕྱེད་དོར་ནས་ཇི་ལྟར་རིགས་པར་གྱེན་དུ་འགྲེང་བའི་ཐིག་གཅིག་གོ།",
    "སྟེང་དུ་ཆུ་སྲིན་གྱི་ཁ་ནས་འཐོན་པའི་མུ་ཏིག་གི་ཆུན་འཕྱང་ལ་སོགས་པ་ནི་ཇི་ལྟར་མཛེས་པར་རོ།",
    "རི་དགས་མོ་ནི་འཁོར་ལོ་ལ་ཁ་བལྟས་ཤིང་འཁོར་ལོ་ལས་ཆ་ཆུང་ཕྱེད་ཙམ་དུ་རིང་བར་གནས་པ་སྟེ།",
    "ཆ་ཆུང་གཅིག་ཏུ་མགྲིན་པ་དང་བཅས་པའི་གདོང་པ་འགྲེང་ཞིང་མིག་འཁོར་ལོའི་རྩེ་མོ་ལ་བལྟ་བ་བྲི་བར་བྱའོ།",
    "རི་དགས་དང་རི་དགས་མོའོ།",
    "རི་དགས་མོ་དག་ཁོ་ན་གནས་སོ་ཞེས་ཟེར་རོ།",
    "འདིས་ནི་གདན་གྱི་གཞོགས་ན་གནས་པའི་རི་དགས་དང་རི་དགས་མོའི་མཇུག་མའི་ཕྱི་རོལ་གྱི་ཕྱོགས་དག་ཏུ་མདའ་ཡང་གཉིས་གཉིས་གསུངས་སོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་བཞེད་པ་འདི་ལ་ནི་རི་དགས་དང་རི་དགས་མོ་དག་མདའ་ཡབ་ལ་གནས་པ་མ་ཡིན་ནོ།",
    "འཁོར་ལོའི་ཕྱི་རོལ་གྱི་ཆ་ཆུང་གཉིས་ལ་སྣ་ཚོགས་རྡོ་རྗེའི་རའི་རྩེ་མོ་སྟེ།",
    "དཀྱིལ་འཁོར་གྱི་ལྟེ་བར་སེང་ལྡེང་གི་ཕུར་པ་འོག་རྩེ་གཅིག་པ་སྟེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་དེར་ཚོན་གྱི་རེ་ཁཱ་མི་བྱའོ།",
    "གཞལ་ཡས་ཁང་ལས་ཆུང་ཟད་རིང་བར་རྟ་བབས་ཀྱི་ཀ་བ་རྣམས་རེ་རེ་ཞིང་སྟེགས་བུ་གྲུ་བཞི་པ་ལ་གནས་པའི་ཕྱིར་རོ།",
    "ཚངས་ཐིག་གི་ནི་ལོགས་རེ་རེ་ར།",
    "རེ་རེ་ཞིང་ཡང་ཆ་ཆུང་བཞིར།",
    "དེ་ནས་ཚངས་ཐིག་ལོགས་རེ་རེ་ར།",
    "ཚངས་པའི་ཐིག་གི་རྩེ་མོའི་ཕ་རོལ་དུ་པདྨའི་གེ་སར་དང་།",
    "རྟ་བབས་རྡོ་རྗེའི་རྩེ་མོ་ཅན།",
    "ཁ་ཅིག་ན་རེ་དེ་བས་ཚིག་འདི་ཉིད་ཀྱིས་གེ་སར་ལ་སོགས་པ་མེད་དོ་ཞེས་པ་ནི་མི་རིགས་ཏེ།",
    "དེ་ལ་རྩ་བའི་ཐིག་གི་ནང་དུ་སྒོའི་ཚད་བརྒྱད་དོ།",
    "ཀ་བའི་སྟེང་གི་རྟ་བབས་དེའི་དཔངས་སུ་སྒོ་གཅིག་གི་ཚད་ལ་སྣམ་བུ་བཅུ་གཅིག་གོ།",
    "ཚངས་ཐིག་གི་གཡས་དང་གཡོན་དུ་ཆ་ཆུང་ཕྱེད་དང་ལྔ་དོར་བར་སྣམ་བུ་དང་པོ་ནི་ཆ་ཆུང་ཕྱེད་དང་གསུམ་པའོ།",
    "དེའི་སྟེང་གི་ཐིག་དང་པོ་ནི་ཆ་ཆུང་ཕྱེད་དང་བཞི་པའོ།",
    "ཆ་ཆུང་བཞི་དོར་བར་བཞི་པ་ཆ་ཆུང་གསུམ་མོ།",
    "ནང་གི་མཐར་ཡང་སྟེ་ཐིག་དང་པོ་ནི་ཆ་ཆུང་ཕྱེད་དོར་ནས་གྱེན་དུ་འགྲེང་བའོ།",
    "རང་གི་མཚན་མས་བརྒྱན་པ་སྟེ།",
    "རྟ་བབས་ཀྱི་སྟེང་དུ་སྒོ་ཆེད་གཅིག་གི་ཚངས་ཐིག་ལ་ཆུ་ཆུང་གཉིས་པའི་འཁོར་ལོའོ།",
    "དེའི་གློ་དག་ཏུ་སྔོན་བཞིན་རི་དགས་དང་རི་དགས་མོའོ།",
    "དེ་དག་གི་མཇུག་མའི་ཕ་རོལ་ཏུ་མདའ་ཡབ་ལ་གནས་ཤིང་།",
    "ཁ་ཅིག་ཏུ་ནི་བདེ་མཆོག་གི་དཀྱིལ་འཁོར་ལ།",
    "སྟེགས་བུའི་ཕྱི་དང་ནང་གི་ཟུར་རྣམས་སུ།",
    "དེ་རྣམས་ཀྱི་རྩ་བ་དང་རྩེ་མོ་ལ་ནོར་བུས་སྤྲས་པའོ།",
    "དྲིལ་ཆུང་གི་སྒྲ་སྒྲོགས་པས་སིལ་སིལ་ཟེར་བ་རྔ་ཡབ་དང་བཅས་པའོ།",
    "རྟ་བབས་ལ་རྣམ་པར་བཀྲ་བའི་བླ་རེ་དང་དོ་ཤལ་དང་དོ་ཤལ་ཕྱེད་པའོ།",
    "མིའམ་ཅི་མོ་རྣམས་ཀྱང་ངོ།",
    "དེ་ལྟ་བུ་འདི་ནི་རྩ་བའི་དཀྱིལ་འཁོར་ལས་ཕྱི་རོལ་དུ་ཐིག་གདབ་ཅིང་བྲི་བའི་རིམ་པ་སྟེ་དཀྱིལ་འཁོར་ཐམས་ཅད་ཀྱི་ཐུན་མོང་ངོ།",
    "རྩ་བའི་ཐིག་གི་ནང་དུ་སྒོའི་ཚད་དུ་ལྷ་སྣམ་དོར་ནས་ངོས་ཐིག་གཅིག་ཟུར་ཐིག་གཉིས་ཀྱི་བར་དུའོ།",
    "དེ་ནས་ཕྱོགས་གཞན་གྱི་ཟླུམ་པོའི་ཐིག་གི་བར་དུ་ཚངས་ཐིག་གི་གཡས་ཕྱོགས་སུ་ཐིག་གཉིས་ཏེ།",
    "དེ་ནས་ཚངས་ཐིག་དང་ཟུར་ཐིག་ཕྱི་བས་རེ་མིག་དགུར་འགྱུར་རོ།",
    "གཞན་ཡང་ཚངས་ཐིག་དང་གཙོ་བོའི་གནས་ཀྱི་སྣམ་བུའི་ནང་གི་ཐིག་རྣམས་ནི་དབྱི་བར་བྱའོ།",
    "ལྷའི་གནས་དང་ཚོན་ཁྱད་པར་དུ་བྱ་བའི་དོན་དུ་ཟུར་ཐིག་དང་ལྷ་སྣམ་གྱི་ཐིག་རྣམས་ནི་གཞག་ཅིང་རྡུལ་ཚོན་གདབ་པ་ཉིད་ཀྱིས་གཡོགས་པར་བྱའོ།",
    "འདིར་གལ་ཏེ་དེ་ལྟར་གདབ་པ་ལས་གཞན་དུ་གདབ་པར་འདོད་ན་དེའི་ཚེ་ཚངས་ཐིག་གི་ཕྱི་རོལ་དུ་ཆ་ཆུང་གཉིས་སྤངས་པར་ཐིག་གཅིག་གོ།",
    "དེའི་ཕྱི་རོལ་དུ་ཆ་ཆུང་དེ་རེ་དོར་བར་ཐིག་དྲུག་སྟེ།",
    "ཐིག་བདུན་ཀ་ཡང་གཞལ་ཡས་ཁང་གི་མདའ་ཡབ་ཀྱི་ཐིག་གི་བར་དུའོ།",
    "རྩ་བའི་ཐིག་གི་ཕྱེད་ཀྱིས་སོ།",
    "ནང་གི་འཁོར་ལོའི་ཕྱི་རོལ་དུ།",
    "དེ་ཉིད་དུ་ནི་རེ་མིག་དགུ།",
    "འདིར་ནང་གི་ཐིག་ཟླུམ་པོ་ནས་ཕྱོགས་གཞན་གྱི་ཟླུམ་པོའི་ཐིག་གི་པར་དུ་ཚངས་པའི་གཡས་ལོགས་སུ་ཐིག་གཉིས་ཏེ།",
    "རྩ་བའི་ཐིག་གི་ནང་དུ་ཆ་ཆུང་བཞི་དོར་བར་ཐིག་ཟླུམ་པོའོ།",
    "དེ་ནས་ལྷ་མོའི་ཆ་ཆུང་དྲུག་དོར་བར་ངོས་ཀྱི་ཐིག་གཅིག་སྟེ་ཟླུམ་པོ་ལ་རེག་པའོ།",
    "རྩ་བའི་ཐིག་གི་ནང་དུ་ཚངས་པ་དང་ཟུར་ཐིག་རྣམས་ཉིད་དེ་ཐིག་གཞན་བཏབ་པ་ནི་མེད་དོ།",
    "དེ་ལ་དང་པོ་ནི་ལྟེ་བ་ཡིན་ཏེ་ཆ་ཆུང་གཅིག་གི་བརྒྱད་ཆས་ལྷག་པའི་ཆ་ཆུང་ཕྱེད་དང་གསུམ་དོར་ནས་སོ།",
    "དེའི་ཕྱི་ངོས་སུ་ཆ་ཆུང་གཅིག་གི་བརྒྱད་ཆ་དོར་ནས་ཀྱང་།",
    "ལྔའི་བདག་གཉིས་བཅོམ་ལྡན་འདས་སྒྱུ་མ་ཆེན་མོའི་དཀྱིལ་འཁོར་ཡད་དེ་ལྟ་བུ་ཉིད་དོ།",
    "བཅོམ་ལྡན་འདས་བདེ་མཆོག་དང་རྡོ་རྗེ་ཕག་མོའི་དཀྱིལ་འཁོར་ལ་རྩ་བའི་ཐིག་གི་ནང་དུ་ཚངས་ཐིག་དང་ཟུར་ཐིག་གཉིས་གནས་པ་ལ།",
    "ཟུར་ཐིག་གི་གཡས་དང་གཡོན་དུ་ཆ་ཆུང་གཉིས་དོར་བར་ཐིག་རེ་རེ་སྟེ།",
    "དེ་ནས་ཚངས་ཐིག་དང་ཟུར་ཐིག་གི་ཕྱིའི་ཐིག་ལས་ཕྱི་རོལ་དུ་ཆ་ཆུང་གཉིས་དོར་བར་ཐིག་དང་པོ་སྟེ།",
    "ཚངས་ཐིག་དང་ཟུར་ཐིག་དང་དེ་དག་གི་གློའི་ཐིག་གི་སྟེང་དག་ཏུ་སྒོའི་ཚད་དེ།",
    "དེ་བཞིན་དུ་ཟུར་དང་དེ་དག་གི་འགྲམ་གྱི་ཐིག་གི་སྟེང་ཏུ་ཐིག་དྲུག་པ་ཡང་ངོ།",
    "དེ་ནས་ཚངས་ཐིག་གི་གཡས་སུ་དང་པོའི་ཆ་ཆུང་གཅིག་གི་མཐའ་ནས་ཕྱུང་སྟེ།",
    "གཉིས་པའི་རྩེ་མོར་སོང་ནས་གསུམ་པའི་ཆ་ཆུང་གཅིག་གི་མཐར་ཞུགས་ཏེ་བཞི་བའི་རྩེ་མོར་སོགས་ནས་ལྔ་བའི་ཆ་ཆུང་གཅིག་གི་མཐར་ཞུགས་ཏེ།",
    "དྲུག་བའི་རྩེ་མོར་སོད་ནས་བདུན་པའི་ཆ་ཆུང་གཅིག་གི་མཐར་ཞུགས་པའི་ཐིག་ཀྱོག་པོ་གཅིག་གོ།",
    "དེ་ལྟ་བུའི་ཐིག་ཀྱོག་པོ་གཉིས་ཆངས་ཐིག་གི་གཡོན་དུ་ཡང་ངོ།",
    "དེ་ནས་ལྟེ་བར་ཐིག་སྐུད་བཟུང་ནས་རྩ་བའི་ཐིག་ནས་བརྩམས་ནས་ནང་དུ་སྒོ་རེ་རེ་སྤངས་པར་ཚངས་ཐིག་ལ་ཐིག་སྐུད་བཟུང་བས་ཐིག་ཟླུམ་པོ་བཞིའོ།",
    "ད་ལ་དང་པོ་གསུམ་རེ་རེའི་ནང་དུ་ཆ་ཆུང་ཕྱེད་དོར་བར་ཟླུམ་པོའི་ཐིག་གཅིག་གོ།",
    "འདིར་ཕྱི་རོལ་གྱི་ཐིག་ཟླུམ་པོ་དང་ནང་གི་ཐིག་ཟླུམ་པོ་དང་།",
    "རྩ་བའི་ཐིག་གི་ནང་དུ་གཞལ་ཡས་ཁང་གཉིས་པ་སྟེ།",
    "རྡོ་རྗེ་སྒྲོལ་བའི་དཀྱིལ་འཁོར་ལ་ཚངས་ཐིག་དང་ཟུར་ཐིག་རྣམས་གནས་པ་ཉིས་ལ་ཚངས་ཐིག་གི་ཕྱི་རོལ་དུ་ལྟེ་བའི་ཆ་ཆུང་གསུམ་དོར་བར་ཐིག་ཟླུམ་པོ་གཅིག་གོ།",
    "དེ་ལ་ཚངས་པའི་ཐིག་གི་ཕྱི་རོལ་ཀུན་ཏུ་ཆ་བཞི་དོར་བར་དབུས་ཀྱི་པདྨའོ།",
    "ལྔ་བཅུ་ང་གསུམ་གྱི་བདག་ཉིད་ཅན་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ལ་རྩ་བའི་ཐིག་གི་ནང་ན་རང་གི་སྒོ་གཉིས་ཀྱི་ཚང་སྤངས་པར་ཟུར་ཐིག་གཉིས་ཀྱི་བར་དུ་ངོས་སུ་ཐིག་གཅིག་གོ།",
    "དེ་ཉིད་ནི་གཉིས་པ་ནང་གི་དཀྱིལ་འཁོར་གྱི་རྩ་བའི་ཐིག་ཡིན་ཏེ།",
    "སྒོ་དང་སྒོ་ཁྱུད་ལ་སོགས་པ་མདའ་ཡབ་ཀྱི་ཐིག་གི་བར་དང་ལྡན་ཞིང་རྟ་བབས་ལ་སོགས་པ་མེད་པའོ།",
    "དེ་ལས་ཕྱོགས་གཞན་གྱི་ཐིག་ཟླུམ་པོའི་བར་དུ་ཚངས་ཐིག་གི་གཡས་ཀྱི་ཆར་ཐིག་གཉིས་ཏེ་དང་པོ་ཆ་ཆུང་གཉིས་སྤངས་པར་རོ།",
    "དེ་ནས་ཚངས་ཐིག་དང་ཟུར་ཐིག་ཕྱི་བས་རེའུ་མིག་དགུར་འགྱུར་རོ།",
    "གཞན་ཚངས་ཐིག་དང་གཙོ་བོའི་གནས་ཀྱི་སྣམ་བུའི་ནང་གི་ཐིག་རྣམས་ནི་དབྱིའོ།",
    "ཞེས་གསུངས་པ་ནི་དེ་བཞིན་གཤེགས་པ་ལྔའི་གནས་རྣམས་སུ་རྡོ་རྗེའི་རི་མོ་ཟླུམ་པོ་བྲི་བར་བྱ་སྟེ།",
    "རྡོ་རྗེའི་རི་མོ་ཟླུམ་པོའི་རྗོད་བྱེད་རྒྱུད་ཚིག་འདི་ལ་མེད་པའི་ཕྱིར་རོ།",
    "བཞི་བཅུ་རྩ་གསུམ་གྱི་བདག་ཉིད་ཅན་འཇམ་པའི་རྡོ་རྗེའི་དཀྱིལ་འཁོར་ལ་རྩ་བའི་ཐིག་གི་ནང་དུ་སྒོ་གཉིས་སྤངས་པར་ཟུར་ཐིག་གཉིས་ལ་རེག་པའི་ལོགས་ཐིག་གཅིག་གོ།",
    "དེ་ཉིད་ནི་གཉིས་པ་ནང་གི་དཀྱིལ་འཁོར་གྱི་རྩ་བའི་ཐིག་ཡིན་ཏེ།",
    "སྒོ་དང་སྒོ་ཁྱུད་ལ་སོགས་པ་མདའ་ཡབ་ཀྱི་ཐིག་གི་བར་དུ་ལྡན་ཞིང་རྟ་བབས་ལ་སོགས་པ་མེད་པའོ།",
    "འདིའི་ནང་དུ་རང་གི་སྒོ་གཉིས་སྤངས་པར་ཟུར་ཐིག་ལ་རེག་པའི་ལོགས་ཐིག་གཅིག་གོ།",
    "དེ་ཉིད་གསུམ་པ་ནང་གི་དཀྱིལ་འཁོར་གྱི་རྩ་བའི་ཐིག་ཡིན་ཏེ།",
    "སྒོ་ཁྱུད་དང་འགྲེལ་པའི་རྩ་བའི་ཐིག་འདིའི་ནང་དུ་སྒོ་གཉིས་ཀྱི་བར་སྤངས་ནས་ཟུར་ཐིག་གཉིས་པོ་ལ་རེག་པའི་ངོས་ཐིག་གཅིག་གོ།",
    "དེ་ཉིད་ནི་གཉིས་པ་ནང་གི་དཀྱིལ་འཁོར་གྱི་རྩ་བའི་ཐིག་ཡིན་ཏེ།",
    "དེ་རེ་རེའི་བརྒྱད་ཆ་ནི་སྒོའོ།",
    "དེ་ལྟ་མོད་ཀྱི་གཞལ་ཡས་ཁང་འདི་དང་བཞི་པོ་རྣམས་ཀྱི་བར་ན་དཀྱིལ་འཁོར་ཆེན་པོའི་ཆ་ཆུང་གཅིག་གོ།",
    "འདིར་ཀྱེའི་རྡོ་རྗེའི་གཞལ་ཡས་ཁང་ལ་རྩ་བའི་ཐིག་གི་ནང་དུ་ཆ་ཆུང་གཅིག་ལ་གནས་ཤིང་།",
    "གཞལ་ཡས་ཁང་ཐམས་ཅད་དུ་ཡང་རང་རང་ལ་ལྟོས་ནས་རྩ་བའི་ཐིག་དང་སྒོ་དང་ཆ་ཆུང་གི་ཚད་རྣམས་རིག་པར་བྱའོ།",
    "འཁོར་ལོས་སྒྱུར་བ་དྲུག་གི་དཀྱིལ་འཁོར་རོ།",
    "གཞལ་ཡས་ཁང་ཆེན་པོའི་ཆ་ཆུང་གི་ཚད་ཀྱིས་ཚངས་ཐིག་ནས་གང་ཆ་ཆུང་བཞི་པའི་བར་གཞན་ཆ་ཆུང་བཞི་པའི་བར་དང་བཅས་པ་དེ་ཆ་ཆུང་བཅུ་གཉིས་སུ་བྱས་ལ།",
    "དེ་དང་བསྟུན་པའི་སྒོའི་ཆ་ཆུང་གིས་སྒོ་ཁྱུད་ལ་སོགས་བའི་ཐིག་དང་མདའ་ཡབ་ཀྱི་ཐིག་གི་བར་དུ་གདབ་པོ།",
    "འདིའི་ཆ་མཉམ་པ་ལྔ་བྱས་ནས་ཆ་རེ་རེའི་དབུས་ལས་བྱུང་བའི་ཚངས་ཐིག་ནི་དཀྱིལ་འཁོར་ཆེན་པོའི་ཆ་ཆུང་གི་ཚད་ཀྱི་ཆ་ཆུང་བརྒྱད་པའོ།",
    "གཉིས་བ་འདི་རེ་རེ་ཞིང་ཆ་ཆུང་གཉིས་སུ་བྱས་ལ་ཞེས་པ་ལ་སོགས་པ་ནས་རབ་ཏུ་གདབ་བོ་ཞེས་པའི་མཐར་ཐུག་པ་དེ་མ་ཐག་པར་བརྗོད་པ་དག་བྱའོ།",
    "དེ་ལ་ཚངས་ཐིག་གི་ལྟེ་བར་གཙོ་བོའི་པདྨའི་ལྟེ་བའི་དོན་དུ་ཚངས་ཐིག་ལས་ཕྱི་ངོས་སུ་ཆ་ཆུང་གཉིས་དོར་ནས་ཚངས་ཐིག་གཞན་གྱི་སྟེང་དུ་བཟུང་སྟེ་ཐིག་ཟླུམ་པོ་གཅིག་གདབ་པོ།",
    "དེའི་འགྲམ་གཉིས་སུ་ཀ་བ་གཉིས་ཏེ་རྒྱར་ཆ་ཆུང་རེ་རེ་སྲིད་དུ་ཆ་ཆུང་བཞིའོ།",
    "དེ་དག་གི་འགྲམ་དུ་དེ་བཞིན་དུ་ཀ་བ་གཉིས་སོ།",
    "དེ་ནས་ཟུར་ཐིག་གི་མཐར་ཐུག་པའི་ཐིག་མཐའ་མ་ལས་ཕྱི་ངོས་སུ་ཆ་ཆུང་བདུན་གྱི་བར་སྤངས་ནས་ཐིག་གཅིག་གོ།",
