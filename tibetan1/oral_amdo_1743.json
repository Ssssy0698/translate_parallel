    "ཡིད་སྨོན་རེ་དོགས་རྩོལ་བ་མེད་།",
    "སྡུག་གིན་སྡུག་གིན་རང་སར་གྲོལ་།",
    "རེ་དོགས་འབྲས་བུའི་སེམས་དང་བྲལ་།",
    "རེ་དོགས་འབྲས་བུ་ཡོངས་ཀྱིས་མེད་།",
    "ཉན་ཐོས་ལྟ་བ་ངང་གིས་རྫོགས་།",
    "ཀྲི་ཡའི་ལྟ་བ་ངང་གིས་རྫོགས་།",
    "གདོད་ནས་གསལ་བས་འདྲིར་མི་རེ་།",
    "སྒྲ་གྲག་གསུང་གི་དཀྱིལ་འཁོར་ཡིན་།",
    "ཉོན་མོངས་རྣམ་རྟོག་ནུབ་པའི་ནུབ་ཕྱོགས་ན་།",
    "དངོས་མེད་ཟང་ཐལ་དོན་རྟོགས་ན་།",
    "རང་བཞིན་ལྷུན་གྲུབ་བུདྡྷའི་ལྷ་ཚོགས་སོ་།",
    "མ་རིག་ལས་དང་ཉོན་མོངས་ཡེ་ནས་བརླག།",
    "དཔེར་ན་མཚན་མོའི་མུན་ནག་ལ་།",
    "ཚིག་གིས་ཤེས་རྟོགས་གང་ཡང་ཡོད་མ་ཡིན།",
    "མཐོ་རིས་ངན་སོང་ཅི་ལ་ཟེར་།",
    "མཐོ་རིས་ངན་སོང་རེ་དོགས་གཡང་ས་མེད་།",
    "ཡང་དག་དོན་ལ་མཐོ་རིས་ངན་སོང་མེད་།",
    "མཐོ་རིས་ངན་སོང་རྒྱུ་ཡང་མེད་།",
    "མཐོ་རིས་ངན་སོང་སྐྱེ་ལྟུང་མེད་།",
    "བྱ་རྩོལ་ཞེ་འདོད་རེ་དོགས་མེད་།",
    "རེ་དོགས་། གཉིས་མེད་མཐའ་ཆོད་ཅིག།",
    "བྱོལ་སོང་སྐྱེ་བའི་གཡང་ས་བཅད་།",
    "རེ་ཞིག་འབྲས་བུའི་མིང་བཏགས་གོང་ལྟར་རོ་།",
    "གོས་སུ་རེ་ཐུལ་ཁྱི་ཐུལ་དར་ལ་ལག་ཆ་དབྱུག་པ་མི་མགོ་དར་།",
    "རི་ཁྲོད་འགྲིམས་པའི་ལད་མོ་གྲོང་རྒྱུའི་རྣལ་འབྱོར་བྱེད་།",
    "མངའ་བདག་ཉང་རལ་པ་ཅན་དང་སྙེ་མོ་ཞུ་ཡས་གནོད་སྦྱིན་འབར་གྱིས་བཏོན།",
