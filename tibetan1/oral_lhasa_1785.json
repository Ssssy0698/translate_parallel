    "རྡོ་རྗེ་ཆེན་པོ་མཱ་མ་ཀཱིས་ནི་སྐུ་ལུས་རྣམ་པར་བརྒྱན།",
    "བརྐྱང་བསྐུམ་ཚུལ་གྱིས་བཞུགས་ཤིང་པི་པི་ཤ་ནས་སྐུ་ལུས་བརྒྱན།",
    "འཛིན་ཐུགས་ནི་རྣམ་པར་སྨིན།",
    "བཅོམ་ལྡན་མཁའ་འགྲོ་དམ་ཚིག་མ་ལུས་སྟོན་པར་མཛད་པ་ཡི།",
    "མཚམས་གཡས་སྐོར་གྱིས་ཕྱག་རྒྱ་དེ་བཞིན་བྱས་པས་དཀྱིལ་འཁོར་གྱི་ལྷ་ཐམས་ཅད་མཉེས་པར་བྱའོ།",
    "ཅེས་གནང་བ་བྱིན་པར་བསམ།",
    "བུམ་པ་སྟ་གོན་གྱི་རྗེས་གང་རུང་དུ་བྱ་བར་གསུངས་ཀྱང་།",
    "གཉིས་སུ་མེད་པར་ཐིམ།",
    "ཞེས་པས་བརྟན་པར་བྱ།",
    "ཞེས་ལན་ལྔ་བརྗོད་པས་འཁོར་ལོ་དགུ་ཚན་ལྔ་རིམ་པ་བཞིན་ཚིམ་པར་བསམས་ཏེ།",
    "རྣམ་མང་སྐུ་དང་ཆ་༧ ལུགས་རྗེས་ཆགས་སེམས་དཔར་ལྡན།",
    "ནང་ཆུ་དང་བཅུད་སྣ་ཚོགས་ཀྱིས་ཡོངས་སུ་གང་བའི་རྣམ་རྒྱལ་བུམ་པར་ལྷ་དྲུག་ཅུ་རྩ་གཉིས་ཀྱི་གདན་འཁོར་ལོ་རིམ་པ་ལྔ་དང་།",
    "ལས་ཐམས་ཅད་ཀྱི་བུམ་པར་པདྨ་དང་ཉི་མའི་གདན།",
    "ཡབ་ཡུམ་གཉིས་ཀའང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པའོ།",
    "ཞབས་གཡས་བརྐྱང་པའི་སྟབས་ཀྱིས་རོའི་གདན་ལ་བཞུགས་པའོ།",
    "མཚམས་བཞིར་བུམ་པ་ལ་གནས་པའི་ཐོད་པ་བདུད་ནག་པོ་པརྩིས་གང་བ་བཞི།",
    "ལྷོ་རྩིབས་ཨཆུ་དར་མཆེ་བ་རྣམ་པར་གཙིགས་པ་དང་སྣ་ཆེན་མ།",
    "བྱང་ཤར་མཱ་ལ་ཝར་རྡོ་རྗེའི་སྐུ་དང་ཤིང་གྲིབ་མ་སྟེ་ཐུགས་ཀྱི་འཁོར་ལོའི་ལྷ་རྣམས་ཁ་དོག་སྔོན་པོ་ནམ་མཁའ་ལ་སྤྱོད་པའི་ཚུལ་གྱིས་བཞུགས་པའོ།",
    "སྐུའི་འཁོར་ལོའི་ལྷ་རྣམས་ཁ་དོག་དཀར་པོ་ས་འོག་ན་སྤྱོད་པའི་ཚུལ་གྱིས་བཞུགས་པའོ།",
    "ཐམས་ཅད་ཀྱང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པའོ།",
    "ཁ་། ཞབས་གཡས་བརྐྱངས་པས་རོའི་གདན་ལ་བཞུགས་པའོ།",
    "གཡས་བརྐྱངས་པའི་སྟབས་ཀྱིས་རོའི་གདན་ལ་བཞུགས་པའོ།",
    "ཡབ་ཀྱི་གནས་སུ་ཡུམ་དང་ཡུམ་གྱི་གནས་སུ་ཡབ་རྣམས་གཉིས་སུ་མེད་པར་གྱུར།",
    "ཨོཾ་སརྦ་ཏ་ཐཱ་ག་ཏ་ཤྲཱི་ཙཀྲ་སཾ་བ་ར་མཎཱ་ལ་ས་པ་རི་ཝཱ་ནག་པོ་པར་ཨནྡྷཾ་པྲ་ཏཱིཙྪ་སྭཱ་ཧཱ།",
    "། རྒྱས་པར་གྱུར་ཅིག།",
    "སྐུའི་བ་སྤུའི་བུ་ག་ཐམས་ཅད་ནས་བདུད་རྩིའི་རྒྱུན་ཁྲ་ལ་ལ་བྱུང་བས་བུམ་པ་མེར་མེར་ཁེངས་པར་གྱུར་ཞེས་བརྗོད།",
    "མ་འབྱོར་པ་དང་ཉམས་པ་སོགས་ཀྱིས་བཟོད་པར་གསོལ་ལ།",
    "ངའཇིག་རྟེན་པའི་མགྲོན་རྣམས་རྟེན་ཡོད་ན་བརྟན་བཞུགས་བྱེད།",
    "དམ་ཚིག་པ་རང་ལ་གཉིས་སུ་མེད་པར་ཐིམ།",
    "ཕྱག་རྒྱ་དང་བཅས་ཨོ་སུམྦྷ་ནི་སོགས་ཞལ་བཞི་པའི་སྔགས་ལན་གཉིས་བརྗོད་པས་ཚམ་ནག་པོ་པརྔམས་སྔགས་ཀྱིས་བསྲུངས་ནས།",
    "ཐམས་ཅད་དེའི་ས་ལ་འགོད་པར་ཤོག།",
    "མཁའ་ལ་སྤྱོད་པའི་གནས་སུ་འཁྲིད་པར་ཤོག།",
    "རྡོ་རྗེ་འཛིན་པའི་ས་ལ་འགོད་པར་ཤོག།",
    "དོན་དྲུག་རྣམ་པར་དག་ཅིང་རྒྱུ་གཅིག་པ།",
    "ཐོས་ནས་གཞན་ལ་སྟོན་པར་ཤོག།",
    "བསྟན་ལ་བྱ་བ་བྱེད་པར་ཤོག།",
    "སང་ནང་པར་ལྡང་བའི་རྣལ་འབྱོར་གྱིས་ལངས་ཏེ།",
    "རྡུལ་ཚོན་གྱི་ཕྱོགས་ལ་དཀྱིལ་འཁོར་གྱི་སྤྱོད་པ་གསུམ་པ་དང་བཞི་པ་གཉིས་ཀྱི་དོན་རྒྱས་པར་རྗེ་བཙུན་གྱིས་མཛད་པའི་དཀྱིལ་ཆོག་ཏུ་བལྟ་བར་བྱ་ཞིང་།",
    "མགོ་བོར་ཨོཾ་ན་མ་ཧི་སེར་པོ་རྣམ་པར་སྣང་མཛད།",
    "ཡུམ་གྱི་གནས་སུ་ཡབ་གཉིས་སུ་མེད་པར་གྱུར།",
    "ཐུགས་ཀའི་ས་བོན་གྱི་འོད་ཀྱིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རིགས་ལྔའི་རྣམ་པར་ཨོཾ་བཛྲ་ས་མཱ་ཛ་ཞེས་པས་སྤྱན་དྲངས།",
    "གདུལ་བྱ་ཀུན་མཁྱེན་ས་ལ་འགོད་མཛད་པའི།",
    "མཐུན་པར་ཡེ་ཐིག་འཁྲུལ་མེད་གདབ།",
    "ཅེས་པ་ལྟར་ཤེས་པར་བྱས་ལ།",
    "ཕྱི་རོལ་གྱི་རྡོ་རྗེའི་ར་ཤར་སྔོ་སོགས་ལྷ་སྣམ་ལྟར།",
    "མེ་རི་གཞི་སེར་པོ་ལ་དམར་པོས་བྲི་བར་གསུངས་ཀྱང་།",
    "ནམ་མཁར་བཏེག་པའི་ཡེ་ཤེས་ཀྱི་ཐིག་རྡུལ་ཚོན་གྱི་དཀྱིལ་འཁོར་ལ་ཐིམ་པར་བསམས་ལ།",
    "དཀྱིལ་འཁོར་ལ་གཡོན་ཕྱོགས་ནས་བསྐོར་བ་ལན་གསུམ་བྱས་ཏེ་ཡིག་བརྒྱ་བརྗོད།",
    "མཐར་དཀྱིལ་འཁོར་གྱི་ཤར་སྒོ་ནས་རྣམ་རྒྱལ་བུམ་པ་ལྷ་རྣམས་ལ་ཕུལ་བའི་ཚུལ་བྱས་ལ།",
    "སྣམ་སྦྱར་སོགས་དགོས་ཆ་རྣམས་མ་ཚང་བ་མེད་པར་བཤམ།",
    "ཏིང་ཤག་བརྡུང་ཚུལ་བྱ།",
    "ཕྱོགས་བཅུ་དུས་གསུམ་གྱི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་གསུང་ཐུགས་ཡོན་ཏན་ཕྲིན་ལས་ཐམས་ཅད་ཀྱི་ངོ་བོ་མཁྱེན་པའི་ཡེ་ཤེས་བརྩེ་བའི་ཐུགས་རྗེ་མཛད་པའི་ཕྲིན་ལས་བསམ་གྱིས་མི་ཁྱབ་པ་མངའ་བ།",
    "སེམས་ཀྱི་རྫུ་འཕྲུལ་གྱི་རྐང་པ་ནི་མཆེ་བ་རྣམ་པར་གཙིགས་པ་དང་སྣ་ཆེན་མའོ།",
    "ཡང་དག་པའི་རྟོག་པ་ནི་རྣམ་པར་སྣང་མཛད་དང་ནག་པོ་པའཁོར་ལོས་སྒྱུར་མའོ།",
    "གཉིས་པ་མཉམ་པར་མ་བཞག་པའི་རྣལ་འབྱོར་ལ་གསུམ་སྟེ།",
    "ཡབ་ཀྱི་རྡོ་རྗེའི་ལམ་ནས་ཞུགས་ནས་སྐུའི་དབྱིབས་བརྒྱུད་ཧཱུྃ་ལ་ཐིམ་པའི་ཚུལ་གྱིས་ཕར་འཁོར་དུ་བཟླས་པར་བྱའོ།",
    "ཞེས་འདོད་དོན་གསོལ་གདབ་དང་ཡི་གེ་བརྒྱ་པས་བརྟན་པར་བྱས་ཏེ།",
    "མཚམས་གཡས་སྐོར་གྱིས་སྣ་བུག་གཡས་སུ་ཐིམ་པར་བསམས་ལ།",
    "གང་དག་མི་འགྲོ་བ་དེ་དག་ལ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཐུགས་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ལས་བྱུང་བའི་ཁྲོ་བོའི་རྡོ་རྗེ་འབར་ཞིང་རབ་ཏུ་འབར་བ་འདིས་ཁྱེད་རྣམས་ཀྱི་མགོ་བོ་ཚལ་པ་བརྒྱར་འགས་པར་འགྱུར་རོ།",
    "མདུན་ངོས་སུ་ཏིལ་འདུ་བྱས་ལ།",
    "གཙང་ཞེས་བརྗོད་དེ་སྐུ་ཕྱི་བའི་ཚུལ་བྱའོ།",
    "ཡེ་ཤེས་ཀྱི་མེ་རི་རབ་ཏུ་འབར་བ་དང་བཅས་པར་གོ་བཞི་༧ གྱུར་ཨོ་མེ་དཱི་ནཱི་བཛྲ་བྷ་ཝ་བན་ཧཱུྃ་ཧཱུྃ་ཕཊ་༣།",
    "ཡུལ་ཉི་ཤུ་རྩ་བཞི་དུར་ཁྲོད་བརྒྱད་དང་བཅས་པ་རང་བཞིན་གྱི་ལྷུན་གྱིས་གྲུབ་པར་གྱུར།",
    "ཡབ་ཡུམ་གཉིས་ཀའང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པའོ། པདྨའི་འདབ་མ་བཞི་ལ་ཤར་དུ་མཁའ་པོ་སྐུ།",
    "ཞབས་གཡས་བརྐྱང་བའི་སྟབས་ཀྱིས་རོའི་གདན་ལ་བཞུགས་པའོ།",
    "ལྷོ་རྩིབས་ཨ་ནུ་དར་མཆེ་བ་རྣམ་པར་གཙིགས་པ་དང་སྣ་ཆེན་མ།",
    "བྱང་ཤར་མཱ་ལ་ཝར་རྡོ་རྗེའི་སྐུ་དང་ཤིང་གྲིབ་མ་སྟེ་ཐུགས་ཀྱི་འཁོར་ལོའི་ལྷ་རྣམས་ཁ་དོག་སྔོན་པོ་ནམ་མཁའ་ལ་སྤྱོད་པའི་ཚུལ་གྱིས་བཞུགས་པའོ།",
    "ནུབ་བྱང་མ་རུར་རྣམ་པར་སྣང་མཛད་དང་འཁོར་ལོས་གོ་དགུ་འིསྒྱུར་མ།",
    "སྐུའི་འཁོར་ལོའི་ལྷ་རྣམས་ཁ་དོག་དཀར་པོ་ས་འོག་ན་སྤྱོད་པའི་ཚུལ་གྱིས་བཞུགས་པའོ།",
    "རལ་པའི་ཐོར་ཅོག་དང་མི་མགོ་སྐམ་པོ་ལྔས་དབུ་ནག་པོ་པརྒྱན་པ།",
    "ཞབས་གཡས་བརྐྱངས་པས་རོའི་གདན་ལ་བཞུགས་པའོ།",
    "ཡབ་ཀྱི་གནས་སུ་ཡུམ་དང་ཡུམ་གྱི་གནས་སུ་ཡབ་རྣམས་གཉིས་སུ་མེད་པར་གྱུར།",
    "ཞེས་པས་དམ་ཚིག་པ་ལ་གཉིས་སུ་མེད་པར་བསྟིམས་ཏེ།",
    "ཡིད་མཆོད་བྱས་ངལ་ཛཧཱུྃ་བཾ་ཧོས་མདུན་བསྐྱེད་ཀྱི་དཀྱིལ་འཁོར་ལ་བསྟིམ།",
    "རྟེན་དང་བརྟེན་པར་བཅས་པའི་དཀྱིལ་འཁོར་པ་ཐམས་ཅད་བརྟན་པར་བཞུགས་ནས་བདག་དང་།",
    "རྗེ་བཙུན་གྱིས་མཛད་པའི་དཀྱིལ་ཆོག་ཏུ་འདིར་གཏོར་མ་འབུལ་བར་གསུངས་ཀྱང་།",
    "དངོས་སུ་ཐམས་ཅད་རང་ཉིད་ཀྱིས་བྱས་ལ།",
    "དེ་བཞིན་དེ་ཉིད་ངེས་པར་འབྱུང་།",
    "ཞེས་གཙོ་བོ་ཞལ་བཞི་ཕྱག་བཅུ་གཉིས་པའི་དྲུང་དུ་བཞག་པར་བསམས་ལ།",
    "མགོ་བོར་ༀན་མ་ཧི་སེར་པོ་རྣམ་པར་སྣང་མཛད།",
    "ཡབ་ཀྱི་གནས་སུ་ཡུམ་དང་ཡུམ་གྱི་གནས་སུ་ཡབ་རྣམས་གཉིས་སུ་མེད་པར་གྱུར་ཞེས་པས་གོ་ཆ་བགོས་ལ།",
    "རང་ལ་གཉིས་སུ་མེད་པར་ཐིམ་པར་བསམས་ལ།",
    "རྣལ་འབྱོར་དོན་དམ་རྒྱལ་པོ་དེ་ཉིད་བདག་ལ་གྲུབ་པར་མཛོད།",
    "ཡབ་ཡུམ་གཉིས་ཀའང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་བཞུགས་པའོ།",
    "ཡབ་ཡུམ་གཉིས་ཀའང་ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་ཡིག་དབུས་ན་བཞུགས་པའོ།",
    "ཞབས་གཡས་བརྐྱང་པའི་སྟབས་ཀྱིས་རོའི་གདན་ལ་བཞུགས་པའོ།",
    "ཞབས་གཡས་བརྐྱང་བས་རོའི་གདན་ལ་བཞུགས་པའོ།",
    "མགོ་བོར་ༀན་མ་ཧི་སེར་པོ་རྣམ་པར་སྣང་མཛད།",
    "ཡབ་ཀྱི་གནས་སུ་ཡུམ་དང་ཡུམ་གྱི་གནས་སུ་ཡབ་རྣམས་གཉིས་སུ་མེད་པར་གྱུར།",
    "རྒྱས་པར་བྱེད་ན་བརྒྱ་བཅུ་གཅིག་ཤར་སྒོ་ནས་རང་མཁའ་འགྲོ་མར་དམིགས་ཏེ།",
    "སྡོམ་པ་ཐམས་ཅད་ལྡན་བརྒྱ་བཅུ་གཉིས་པར་ནི།",
    "ཁྱད་པར་དུ་ཡང་སློབ་དཔོན་ལ།",
    "རྟག་པར་བདག་ནི་སྐྱབས་སུ་མཆི།",
    "ཇི་སྲིད་གཉིས་མེད་ལ་གནས་པར།",
    "དེ་ཡི་ཚངས་སྤྱོད་གཉིས་མེད་པར།",
    "ཉི་ཤུ་རྩ་གཉིས་ལེགས་པར་སྲུང་།",
    "དཔའ་བོ་དང་རྣལ་འབྱོར་མ་ཐམས་ཅད་ཀྱི་དངོས་གྲུབ་ཀྱང་ཐོབ་པར་འགྱུར་ན།",
    "དམ་ཚིག་འདས་ན་བསྲེགས་པར་བྱེད།",
    "དཔལ་ཧེ་རུ་ཀ་བདག་ལ་དབབ་པར་མཛོད་ཅིག།",
    "མགྲིན་པར་ཝཾ་ལས་ཆུའི་དཀྱིལ་འཁོར་དཀར་པོ་ཟླུམ་པོ་ལ་བུམ་པ་ཨས་མཚན་པ།",
    "དེ་མ་ཡིན་པའི་དཔའ་བོ་དང་རྣལ་འབྱོར་མ་དཔག་ཏུ་མེད་པ་ཡང་བ་སྤུའི་བུ་ག་ནས་འཇུག་པར་གྱུར།",
    "མིག་འབྱེད་པར་ནི་བརྩོན་པར་མཛད།",
    "སྔགས་རྣམས་ལ་ཡང་བརྩོན་པར་གྱིས།",
    "སྣ་ཚོགས་པདྨའི་ལྟེ་བར་བཞུགས།",
    "ཀུན་མཁྱེན་ཀུན་མཛད་གཙོ་བོ་སྟེ།",
    "རྟེན་དང་བརྟེན་པར་བཅས་པའི་དཀྱིལ་འཁོར་ཐམས་ཅད་མངོན་སུམ་ལྟ་བུར་མཐོང་བར་གྱུར།",
    "བརྒྱ་བཅུ་དྲུག་བཀཾའདོད་པའི་ཡོན་ཏན་ལྔས་ནི་རབ་ཏུ་བརྒྱན་པར་གྱུར་པ་ཡི།",
    "བདག་ཅག་འཁོར་དང་བཅས་པ་ཐམས་ཅད་སྤང་དྷཱི་། བྱ་མི་མཐུན་པའི་ཕྱོགས་ཐམས་ཅད་ལས་རྒྱལ་ཞིང་བཀྲ་ཤིས་པར་གྱུར་ཅིག།",
    "བཅོམ་ལྡན་འདས་བདག་ལ་སྩལ་ལགས་ཀྱི།",
    "བཅོམ་ལྡན་འདི་ལ་སྩལ་ལགས་ཀྱི།",
    "རྣམ་པར་ཤེས་པའི་ཕུང་པོ་གནས་གྱུར།",
    "བསྐྱོད་པ་དང་སྐལ་བ་མཉམ་པར་བྱས་པ་ཡིན་ནོ།",
    "མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་མངོན་དུ་བྱས།",
    "རིན་ཆེན་འབྱུང་ལྡན་ནག་པོ་པདང་སྐལ་བ་མཉམ་པར་བྱས་པ་ཡིན་ནོ།",
    "ཞལ་གཅིག་ཕྱག་གཉིས་གཡས་པདྨ་གཡོན་དེས་ཡུ་བ་བྱས་པའི་དྲིལ་བུ་འཛིན་པ།",
    "ཞེས་པས་ལག་པ་གཡས་སུ་རྡོ་རྗེ་བྱིན་པར་བསམས་ལ།",
    "སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་མངོན་དུ་བྱས།",
    "འོད་དཔག་མེད་དང་སྐལ་བ་མཉམ་པར་བྱས་པ་ཡིན་ནོ།་",
    "གཡོན་དེས་ཡུ་བ་བྱས་པའི་དྲིལ་བུ་འཛིན་པ།",
    "ཅེས་དྲིལ་བུ་ལག་པ་གཡོན་དུ་བྱིན་པར་བསམ།",
    "བྱ་བ་གྲུབ་པའི་ཡེ་ཤེས་མངོན་དུ་བྱས།",
    "དོན་ཡོད་གྲུབ་པ་དང་སྐལ་བ་མཉམ་ང་བརྒྱ་ཉེར་གཅིག་པར་བྱས་པ་ཡིན་ནོ།",
    "གཡོན་དེས་ཡུ་བ་བྱས་པའི་དྲིལ་བུ་འཛིན་པ།",
    "ལུས་ཐམས་ཅད་རྣམ་པར་སྣང་མཛད་ཀྱི་རྡུལ་ཕྲ་རབ་ཀྱིས་གང་བར་གྱུར་ཞེས་དང་།",
    "རྣམ་པར་སྣང་མཛད་དང་སྐལ་བ་མཉམ་པར་གྱུར།",
    "བདག་ཉིད་མི་དམིགས་ཏེ་སྟོང་པར་གྱུར།",
    "གཡས་རྡོ་རྗེ་དང་གཡོན་དེས་ཡུ་བ་བྱས་པའི་དྲིལ་བུ་འཛིན་པ།",
    "དེ་ཉིད་དཀུ་གཡོན་པར་ཁ་གྱེན་དུ་ཕྱོགས་པས་བཟུང་ལ།",
    "ངོ་བོ་ཉིད་ཀྱིས་སྲིད་བྲལ་བྱས།",
    "སྲིད་པ་དམ་པ་བྱེད་པར་འགྱུར།",
    "ཡུམ་རྡོ་རྗེ་སྙེམས་མ་གྲི་གུག་དང་ཐོད་པ་འཛིན་པས་ཡབ་ལ་འཁྱུད་པའི་ཚུལ་དུ་བཞུགས་པ།",
    "སྔགས་དང་རྒྱུད་རྣམས་འཛིན་གྱུར་པར།",
    "དེ་ནས་རྗེས་སུ་གནང་བ་ལ་བཞི་སྟེ།",
    "ཁུ་ཚུར་གཉིས་ཁ་ནས་ཚིག་འབྱིན་པ་ལྟར་བྱས་ཏེ།",
    "བདེ་གཤེགས་སྐུ་ནི་ཐོབ་པར་འགྱུར།",
    "ཡི་ཤེས་ཀྱིས་ནི་ཚིམ་པར་གྱིས།",
    "ལག་ངར་གྱི་སྟེང་དུ་པུ་སྟི་རྣམས་བྱིན་པར་བསམས་ལ།",
    "ཕྲིན་ལས་རྗེས་སུ་སྒྲུབ་པའི་རྗེས་སུ་གནང་བ་ནི།",
    "ལས་དེ་རྣམས་ནི་བསྒྲུབ་པར་གྱིས།",
    "དེ་ནི་ཅི་དགར་སྒྲུབ་པར་གྱིས།",
    "ནངས་པར་སྔར་ལངས་སེམས་དག་ཉིད།",
    "མ་ལུས་ལས་ནི་བྱས་ནས་ཀྱང་།",
    "ལུས་དང་སྲོག་ལ་ལྟོས་མེད་པར།",
    "མཚན་མ་འགོམ་པར་མི་བྱའོ།",
    "སྤྱི་བོས་ཕྱག་ནི་བྱས་ནས་ཀྱང་།",
    "ཚངས་པར་སྤྱོད་པ་ཤིན་ཏུ་བསྲུང་།",
    "ཚངས་པར་སྤྱོད་པ་རྟག་མནོས་ལ།",
    "དྷཱིབ་། འདོད་པ་ལྔ་ལ་སྤྱད་པར་གྱིས།",
    "ཁྲོ་བ་མེད་པར་རྒྱུན་སྤྱད་པས།",
    "འདོད་ཅིང་ཆགས་པར་བྱ་བའི་ཡུལ་ནི་རྣམ་པ་བཞི་སྟེ།",
    "རྒྱལ་བ་རྣམས་ཀྱིས་ལུང་སྟོན་པར་མཛད་དོ།",
    "འབྲས་བུ་སྤྲུལ་པའི་སྐུ་འགྲུབ་པའི་སྐལ་བ་ཅན་དུ་བྱས་སོ།",
    "ཡུམ་གྱི་ངམགྲིན་པར་ཨོཾ་ཤྲཱི་བཛྲ་ཧེ་ཧེ་རུ་རུ་ཀཾ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "སྔགས་རྣམས་ཟླ་བའི་སྟེང་དུ་སྦྲུལ་འཁྱིལ་པ་ལྟར་གཡོན་སྐོར་དུ་འཁོད་པར་བསམ།",
    "མགྲིན་པར་ཨཱཋདམར་པོ།",
    "རང་ཉིད་འོད་དཔག་མེད་ཏུ་གསལ་བའི་ལྕེ་ཐོག་ཏུ་བཞག་པར་༡༣བསམས་ལ།",
    "གསལ་སྟོང་བདེ་བས་བརྒྱན་པའི་ཏིང་ངེ་འཛིན་རྒྱུད་ལ་སྐྱེས་པར་བསམས་ལ།",
    "འབྲས་བུ་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་འགྲུབ་པའི་སྐལ་བ་ཅན་དུ་བྱས་སོ།",
    "ཚིགས་སུ་བཅད་པ་འདི་དག་བརྗོད་པར་བསམས་ལ།",
    "ཞེས་གནང་བ་བྱིན་པས།",
    "ཕྱག་རྒྱ་དེས་གོས་དང་བྲལ་བར་བྱས།",
    "ཞེས་དྲི་བ་བྱས་པར་བསམས་ལ།",
    "ཅི་གསུང་དམ་ཚིག་བསྟེན་པར་ནི།",
    "ཡུམ་གྱི་མགྲིན་པར་ཨོཾ་ཤྲཱི་བཛྲ་ཧེ་ཧེ་རུ་རུ་ཀཾ་ཧུཾ་ཧཱུྃ་པཕཊ་ཌཱ་ཀི་ནཱི་ཛཱ་ལ་སཾ་བ་རཾ་སྭཱ་ཧཱ།",
    "སྔགས་རྣམས་ཟླ་བའི་སྟེང་དུ་སྦྲུལ་འཁྱིལ་བ་ལྟར་གཡོན་སྐོར་དུ་འཁོད་པར་བསམ།",
    "མགྲིན་པར་ཨཱཋདམར་པོ་ཐུགས་ཀར་ཧཱུཾ་སྔོན་པོ།",
    "བསྲུབ་ཅིང་བསྲུབ་པའི་སྦྱོར་བ་བྱས་པས་ལྷན་སྐྱེས་མངོན་དུ་༡༣བྱས་པར་བསམ།",
    "ཡབ་ཡུམ་སོ་སོའི་སྤྱི་བོ་ནས་མགྲིན་པར་བྱོན་པས་དགའ་བ།",
    "ཞལ་སྦྱར་བས་ལྷན་སྐྱེས་ཀྱི་ཡེ་ཤེས་སྐྱེས་པར་བསམ།",
    "མགྲིན་པར་དགའ་བྲལ།",
    "སྤྱི་བོར་ལྷན་སྐྱེས་རྣམས་སྐྱེས་པར་བསམས་ལ།",
    "མཉམ་པར་སྦྱོར་བས་ལྷན་སྐྱེས་ཀྱི་ཡེ་ཤེས་རྒྱུད་ལ་སྐྱེས་པས།",
    "མཉམ་པར་སྦྱར་བའི་མཐུས་བདེ་བ་ཆེན་པོའི་ངོ་བོར་ཤར་བ་ཡིན་ལ།",
    "དོན་དམ་པར་རང་བཞིན་མེད་ཅིང་སྤྲོས་པ་དང་བྲལ་བ་ཡིན་ནོ།",
    "རང་ལུས་ལྷ་སྐུ་ཞལ་སྦྱོར་གྱི་རྣམ་པ་སྒྱུ་མའི་སྐུ་དང་།",
    "འབྲས་བུ་ངོ་བོ་ཉིད་ཀྱི་སྐུ་འགྲུབ་པའི་སྐལ་བ་ཅན་དུ་བྱས་སོ་། ཞེས་རྟོགས་པ་བསྐྱེད་ལ་གནས་སྐབས་དེ་དག་ཏུ་ཐོབ་པའི་དམ་ཚིག་ལ་བསྲུངས་སྡོམ་བགྱིད་སྙམ་པས།",
    "དེ་ནས་སྐབས་འདིར་འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་གཏོར་མ་རྣམས་སྟ་གོན་བཞིན་འབུལ་བར་གསུངས་པས་དེའི་ཚུལ་ནི།",
    "བཅས་པ་ཡང་ལྷུང་བས་གཉིས་སུ་མེད་པར་གྱུར་ཏེ།",
    "གཉིས་སུ་མེད་པར་ཐིམ།",
    "ཞེས་པས་བརྟན་པར་བྱ།"
