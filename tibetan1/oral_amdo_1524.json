    "རྣམ་མཁྱེན་མཆོག་གི་གྲོང་དུ་འཇུག་པར་ཤོག།",
    "༢༡༢བ་བྷཱབཤནྟཤུབྷྱགརྦྷཡུརྒཏཀྱདྷརྨདྷཱནཀཱམམོཙསེནཡཛྱཙོཌིཡཱནཧཱིརུཔདྷྱཤཱཏནནྡཡཱཤིཡཙྪ།",
    "ཆུ་སྐྱེས་འདབ་མའི་རེག་བྱསབསྐྲུན་མིན་པ།",
    "མཆོག་གསུམ་གཏན་གྱི་སྐྱབས་སོང་ཕྱག་བྱའི་གནས།",
    "རྡོར་སེམས་ཆུ་ལྷའི་བུ་ཡི་འོད་སྣང་གིས།",
    "དངས་མཚོར་ཐེག་མཆོག་གཟའ་སྐར་རི་མོ་བཀྲ།",
    "འཛམ་གླིང་མཛེས་བྱེད་རྒྱན་གྱི་རྩེ་མོར་སོན།",
    "བུ་གཅིག་བཞིན་དུ་གཟིགས་པ་ལགས།",
    "གསང་ཆེན་རྙིང་མར་གྲགས་པའི་ལུགས་ལ་མཁའ་འགྲོའི་གཙོ་མོ་ཡེ་ཤེས་འཚོ་རྒྱལ་གྱིས།",
    "བྲག་གི་ཁྱིམ་ལ་བརྟེན་ཏེ་གནས།",
    "རང་བྱུང་གི་ནི་སྐྱེ་གནས་ཅན།",
    "དགྲ་ངན་དཔུང་ཚོགས་ཡན་ལག་བཅུ་གཉིས་འཐབས་པའི་ཚེ།",
    "སྟོང་སྟེ་ནང་མིའུ་རིགས་བཞི་དང་བཅུ་གཉིས་པོ་རིགས་ཀྱི་ཕྱི་མོར་གྲགས།",
    "ཕལ་ཆེར་ནི་མགོན་པོ་སྤྱན་རས་གཟིགས་ཀྱི་སྤྲུལ་པ་རྒྱལ་བའི་འབྱུང་གནས་ཉིད་ཡིན་ལ།",
    "བོད་ཀྱི་ལྷ་བཙན་པོ་རིམ་བྱོན་རྣམས་འཕགས་པ་ཕྱག་ན་པདྨོའི་སྤྲུལ་པ་ཁོ་ནར་གསུངས་མོད།",
    "ལྷ་འདྲེའི་སྤྲུལ་པ་ལྟ་བུར་དོགས་ནས་སྤྱུགས་པ་ལྷ་རི་གྱང་ཐོའི་རྩེར་བྱོན་ནས་གཟིགས་པ་ན་ཡར་ཀླུངས་ཡུལ་གྱི་དགེ་མཚན་ཕུན་སུམ་ཚོགས་པ་དང་།",
    "ལྷ་རི་རོལ་པོའི་སྟེང་ནས་ལྷ་སྐས་བརྒྱུད་བཙན་ཐང་སྒོ་བཞིར་བྱོན་པས་ཕྱུགས་སྐྱོང་བ་སོགས་འགའ་ཞིག་གིས་མཐོང་སྟེ་དྲིས་པ་ན་གནམ་ལ་མཛུབ་མོ་ཀེར་བས་ལྷར་ངོས་བཟུང་ནས་གཉའ་བར་ཁྲི་བྱས་གདན་དྲངས་པས་གཉའ་ཁྲི་༢༡༦བ་བཙན་པོར་གྲགས།",
    "བྱང་གི་ཕྱོགས་ལ་བརྟེན་ནས་ནི།",
    "ལྷ་མོ་གོས་དཀར་༢༡༧ན་མོ་དང་ནི།",
    "དཀར་མོ་ཆེན་མོ་གཞན་ཕན་བརྩོན།",
    "མི་ཁོ་ལ་ཉོན་མོངས་མི་མངའ་ཡང་།",
    "མི་ཁོ་བོའི་བཙུན་མོ་བྱེད་དོ་སྐད།",
    "སྒྲོལ་མའི་རྣམ་སྤྲུལ་རྒྱ་མོ་བཟའ་ཨོང་ཇོ་ཞེས་མཚོ་ནང་གི་པདྨར་གྲགས་པ་གཉིས་ཁབ་ཏུ་བསུས།",
    "ལུང་བསྟན་ལྟར་བོད་སྲིན་མོ་གན་རྐྱལ་ཏུ་བསྒྱེལ་བའི་མེ་ཙ་རྣམས་སུ་མཐའ་འདུལ་ཡང་འདུལ།",
    "འཕྲུལ་སྣང་ར་མོ་ཆེའི་རྟེན་བརྟེན་པར་བཅས་པ་རྣམས་བཞེངས།",
    "བློན་པོ་རྣམས་ཀྱིས་སློབ་དཔོན་སྔགས་མཁན་གྱིས་ནུས་སམ་ཞེས་གསོལ་བ་ལྟར་ཞལ་གྱིས་བཞེས་ནས་དར་དཀར་གྱིས་ཁ་བཅད་པའི་གསེར་གྱི་བུམ་པ་མཁའ་ལ་བསྐྱུར་བས་ཇེ་མཐོར་སོང་ནས་མི་སྣང་བ་ལས།",
    "ལན་ཅིག་སློབ་དཔོན་གྱིས་ཁྱོད་འདི་ལྟར་བསམས་གསུངས་པར་ཁ་སྐྱེངས་ཏེ་སྔགས་མཁན་འདིས་ཅི་ཡང་ཤེས་པར་འདུག་ཟེར།",
    "ཁྱོད་ཀྱིས་ཡུལ་འདི་བཟང་པོར་བྱ་དགོས་པས་ངམ་ཤོད་ཀྱི་བྱེ་མ་ཚལ་དང་ནེའུ་སིང་དུ་བསྒྱུར།",
    "རྣམ་ཐོས་སྲས་ལ་ནོར་བླངས་ནས་འཛམ་བུ་གླིང་གི་དཀོར་ནོར་ཡོད་དོ་ཅོག་གི་འབྱུང་ཁུངས་བོད་དུ་ཡོད་པར་བྱ།",
    "བྲག་དམར་འཚོ་མོ་མགུལ་སྔར་བྱེ་མར་ཡོད་པ་ལ་ནེའུ་གསིང་དུ་སྔོ་ཕྱམས་ཀྱི་སོང་།",
    "སྟག་ལ་ཤར་གྱི་ཡུལ་རྐེད་དུ་ཆུ་བྱུང་ནས་མཛེ་ཕོ་ཞིག་གིས་བརྒལ་བས་མཛེ་ཕོ་རབ་ཏུ་གྲགས།",
    "དོན་དུ་སྡིག་བློན་རྣམས་སྤྱོད་པ་ངན་པའི་༢༡༩བ་གནོང་གིས་སློབ་དཔོན་ཆེན་པོའི་རྫུ་འཕྲུལ་དང་མངོན་ཤེས་མ་བཟོད་པས།",
    "ང་ནི་བསྐལ་པ་བྱེ་བ་ཕྲག་གྲངས་མེད་པ་ནས་བྱ་བ་བྱས་ཟིན་མོད་ཀྱི་དེར་ཡང་གོ་འཕང་ཐམས་ཅད་ཀྱི་དོན་ཐོབ་པའི་མཐར་ཐུག་པར་བསྟན་ཏེ་འདི་ནི་འཇིག་རྟེན་དང་མཐུན་པར་བྱ་བ་ཙམ་དུ་ཟད་དོ།",
    "ལུས་ལ་གང་གིས་མི་ཚུགས་འཆི་མེད་ཐོབ",
    "ལྷ་འདྲེ་ཡུལ་བུད་སོང་ཡང་རག་མ་ལུས",
    "ཅེས་སོགས་གསུངས་ཤིང་ནམ་མཁའ་ལ་རྡོ་རྗེའི་འགྲོས་མཛད་པའི་གྲིབ་མ་ལ་༢༢༡ན་ཟན་གཡང་མི་འགྱུར་ལྷུན་གྱིས་གྲུབ་པའི་གཙུག་ལག་ཁང་གི་རྨང་ཁྲིད།",
    "ཨོ་ཏནྟ་པུ་རིའི་བཙུག་ལག་ཁང་ལ་དཔེ་བྱས་ཉིན་མོ་མི་དང་མཚན་མོ་མི་མ་ཡིན་གྱིས་བརྩིགས་ནས་བཞེངས་པའི་བསམ་ཡས་ཀྱི་ལྷ་ཁང་ཇོ་མོའི་གླིང་གསུམ་དང་བཅས་པ་རིང་པོར་མི་འཐོགས་པར་འབྱོངས་པས།",
    "དང་པོ་སྤྱན་འདྲེན་ཡོན་བདག་གི་ཆེ་བ་ནི།",
    "འཕང་ཐང་མར་གཟིགས་པས་ཀྱང་ཡིད་ཆེས་སྐྱེ་བར་འགྱུར་རོ།",
    "ད་ལྟ་མཆན་ཁུང་ནས་གསེར་ཞོ་རེ་རེ་གཉིས་གཉིས་ཉུག་ཉུག་བྱས་ནས་ཞུས་པ་དང་མི་འདྲའོ།",
    "རྫོགས་ཆེན་ཨ་རོ།",
    "མཆོག་དང་ཐུན་མོང་བཞི་དངོས་གྲུབ་ཐམས་ཅད་བདེ་བླག་འབྱུང་ངེས་པ།",
    "སྔོན་གྱི་མཁས་པ་ལོ་ཆེན་རིན་བཟང་གིས་རྒྱུད་དོན་སྒྲ་ཇི་བཞིན་དུ་བཟུང་བའི་ནོར་པ་གསལ་བ།",
    "དེ་ཡི་ཤ་དང་ཁྲག་གིས་བརྒྱན།",
    "ཐོག་མར་རྗེ་འབྲོག་ལ་ཐུགས་པས་འགོས་དང་ས་ཆེན་གྱི་བར་དུ་མི་རབས་ཀྱིས་ཆོད་པའི་རྒྱུན་ཧ་ཅང་རིང་བ་ནི་མ་སོང་།",
    "ཆག་ལོའི་སྤྲིངས་ཡིག་རྔོག་གི་གཟེ་མ་སོགས་སུ་སྔགས་གསར་རྙིང་མང་པོར་དྲི་བཅས་དང་།",
    "རྙིང་མ་གཙོ་བོར་བཀག་པར་བརྟེན་འབྱམས་ཡིག་ཟངས་མར་བྲིས་མོད།",
    "རྒྱུད་དང་བསྟན་བཅོས་ཀྱི་མིང་གི་ཁྱད་པར་མ་གཏོགས་དོན་གྱི་ཆ་ལ་དྲི་བཅས་སུ་ག་ལ་འགྱུར།",
    "དཀར་ཆག་གི་མཚན་ལ་དྲི་མ་མེད་པ་ཞེས་འདོགས་པར་མཛད།",
    "ཁྲག་གི་དངས་མ་ཨ་ཐུང་།",
    "ཇོ་བོ་ཆེན་པོ་ཨ་ཏི་ཤས་བསམ་ཡས་སུ་རྒྱ་དཔེའི་དཀོར་མཛོད་ཅིག་ཁ་ཕྱེ་ནས་གཟིགས་པས།",
    "སྔར་གསན་གཟིགས་མེད་པའི་རྒྱུད་ཤིན་ཏུ་མང་བར་གཟིགས་ཏེ།",
    "སྙེ་ཐང་དུ་ཇོ་བོ་ལ་བོད་སྟོན་རྣམས་ཀྱིས་དང་པོ་བོད་དུ་བརྩམས་པའི་བསྟན་བཅོས་འགའ་ཞིག་གཟིགས་ཕུལ་བས།",
    "ཨ་རོ་ཡེ་ཤེས་འབྱུང་གནས་ཀྱིས་མཛད་པའི་ཐེག་ཆེན་རྣལ་འབྱོར་བྱ་བའི་བསྟན་བཅོས་ལ་ཤིན་ཏུ་མཉེས་ནས།",
    "རྒྱལ་ཁམས་ལ་བྱོན་པས་རོང་གི་ཁུ་ལུང་མདའི་ཆུ་ཁ་ན་གནུབས་པའི་གྲ་པ་བན་ཆུང་ཁ་ཅིག།",
    "གསང་སྔགས་རྙིང་མ་ཞེས་གྲགས་པའི་ཕྱོགས་ལ་ལྷག་པར་མོས་པ་ཐོབ་ཅིང་།",
    "དེ་དང་མཚུངས་པ་གཏེར་སྟོན་གཞན་དག་གིས་ཀྱངམཛད།",
    "མཛེ་དང་སྨྱོ་འབོག་རེ་གཉིས་ལ་མཐའ་ཅི་བཀག།",
    "གཏེར་སྟོན་གཏེར་སློབ་ཕལ་མོ་ཆེ་ལ་མ་བྱུང་།",
    "ཕྱག་ན་རྡོ་རྗེ་ཁྱོད་ཉིད་ཀྱིས།",
    "སྣོད་ལྡན་ཁྱོད་ལ་བསྟན་པ་ཡིན།",
    "མངའ་བདག་ཁྲི་སྲོང་གི་གདུང་བརྒྱུད་དྲུག་བདུན་ཙམ་ན་ཡར་སོང་དུས།",
    "ཐམས་ཅད་རང་རང་གི་ཆེ་བ་ནི་འདོད།",
    "དབུས་འགྱུར་རྡོ་རྗེའི་གདན་མཐིལ་དུ་ནི་ཡུག་རེ་ལས་ཚ་བས་མི་ཚུགས།",
    "སྔར་འགྱུར་ཟིན་པ་རྣམས་ལ་རྒྱུད་ཁུངས་དང་བཅོས་ཆུང་རེ་བྱས་ནས་ངའི་འགྱུར་བཟང་ཟེར།",
    "རང་རང་གི་འདོད་ཕྱོགས་ནས་སྤུ་གཟིངས་པས།",
    "གདམས་པ་སྣ་རེས་གང་ཟག་གྲོལ་བར་ངེས",
    "ད་ལྟའི་མགོ་ནག་སྤྱི་ཡི་རྒྱལ་པོ་ཁྱོད",
    "ཇོ་མོ་གླིང་གསུམ་སྦས་པའི་གཏེར་ཁ་འདི",
    "གོང་འོག་སོགས་གཏེར་ཁ་དུ་མའི་ཁ་བྱང་བཏོན་ཞིང་གྲ་ཐང་གིས་གཙོས་གནས་གཞི་བརྒྱ་དང་རྩ་བརྒྱད་བཞེང་བས་མཚོན་བཤེས་གཉེན་ཞིག་ལ་འཕྲིན་ལས་ཆེ།",
    "བེ་རོ་ཁྱོད་ཀྱི་སྤྲུལ་པ་ནི",
    "མོན་བལ་རྩེ་ལྔ་ཕྱོགས་སུ་འདའ",
    "དམ་པ་དེ་དག་གི་སྐུའི་སྐྱེ་བ་རིམ་པར་བརྒྱུད་དེ།",
    "བེ་རོ་ཁྱོད་ནི་སྐྱེ་མཐའི་བྱང་སེམས་ཏེ",
    "ཁྱོད་ཀྱི་འདི་གོང་སྐྱེ་བ་འདས་པ་ནི",
    "སྐྱེ་བ་དེ་ཙམ་སྣང་གི་མ་དག་པའི",
    "དེ་ལྟར་དག་པའི་སྐྱེ་བ་དེ་དག་གི",
    "བེ་རོ་ཁྱོད་དུ་སྐྱེ་བ་བླངས་པ་ཡིན",
    "པདྨ་བདག་གི་ཟབ་གཏེར་བདག་པོ་དང་",
    "བུདྡྷ་ཛྙཱ་ནའི་སྤྲུལ་པ་ཚེ་མིང་ཕ",
    "པདྨ་ང་ལ་མོས་པ་ལྷག་པར་བྱེད",
    "དམ་པ་དེ་དག་ངོ་བོ་གཅིག་ལ་ལྡོག་པ་ཐ་དད་པས་ཟླ་བ་གཅིག་༢༣༣བ་ལ་རྫིང་བུ་མང་པོར་གཟུགས་བརྙན་འཆར་བ་བཞིན་ཡབ་རིགས་འཛིན་ཆེན་པོ་འཕྲིན་ལས་ལྷུན་གྲུབ་དང་ཡུམ་ཤེལ་དཀར་བཟའ་འཚོ་སྒྲོན་གྱི་སྤྲུལ་པ་ལྷ་འཛིན་དབྱངས་ཅན་སྒྲོལ་མའི་སྲས་སུ་རིགས་འཛིན་ཆེན་པོ་འདི་མེ་ཕོ་ཁྱིའི་ལོ་ལ་སྐུ་བལྟམས་པའི་ངོ་མཚར་གྱི་མཛད་པ་གསང་བ་བསམ་གྱིས་མི་ཁྱབ་པ་དག་གླེང་བར་བྱ་བ་དུས་སུ་མ་བབས་པས་རེ་ཤིག་བཏང་སྙོམས་སུ་བཞག།",
    "གདུལ་བྱ་ཐུན་མོང་བ་དང་གོ་མཚུངས་པའི་རོལ་རྩེད་དང་།",
    "གངས་ཅན་གྱི་ལྷ་གཅིག་དཔལ་ཕག་མོ་གྲུ་པ་ཡབ་སྲས།",
    "སྐབས་དོན་གྱི་གཙོ་བོ་དགུང་ལོ་བཅོ་བརྒྱད་དུ་སླེབས་པ་ཆུ་མོ་ཡོས་ཀྱི་ལོ་ལ་བྲག་དམར་གཡའ་མ་ལུང་ནས་རིགས་འཛིན་ཐུགས་ཐིག་གི་སྐོར།",
    "ཉེར་གཉིས་པ་མེ་མོ་ལུག་གི་ལོར་ཡར་ཀླུངས་ཤེལ་བྲག་ནས་འཇམ་དཔལ་གཤིན་རྗེ་དྲེགས་པ་འཇོམས་བྱེད།",
    "རིགས་འཛིན་ཆེན་པོ་ཉིད་མཐོང་ཐོས་དྲན་རེག་གི་སྐྱེ་རྒུ་མཐའ་དག་རྣམ་བྱང་གི་གོ་འཕང་ལ་འགོད་པའི་དགོས་པ་དུ་མའི་ཆེད་དུ་འཛུགས་པར་བཞེད་པའི་གནས་མལ་གྱི་གཞི་དང་།",
    "ས་སྐྱར་གྲགས་པའི་རི་མོ་ཕྱོགས་སུ་རིང་།",
    "ཚེ་རིང་གནམ་གྱི་ཤེ་མོང་གི་སྟོབས་ཀྱི་འཁོར་ལོས་སྒྱུར་བ་ཇིང་གིར་ཧོར་གྱི་ལུང་གིས་དཔལ་ས་སྐྱ་པར་ཆོལ་ཀ་གསུམ་གནང་བའི་དབུས་གཙང་ཁྲི་སྐོར་བཅུ་གསུམ་དུ་ཕྱེ་བ་ལས་ཚལ་པ་ཁྲི་སྐོར་དུ་གཏོགས་པ།",
    "སྐར་མ་མོན་གྲུ་འཕྲོད་པའི་ཉིན་རིགས་འཛིན་ཆེན་པོ་ཉིད་འཁོར་ལོའི་མགོན་པོར་བཞེངས་ཏེ་དཔལ་ཆེན་རྡོ་རྗེ་ཕུར་བུ་འཕྲིན་ལས་དྲག་པོའི་དཀྱིལ་འཁོར་ཆེན་པོའི་ལས་རིམ་དང་འབྲེལ་བར་སའི་ཆོ་གས་བཀྲ་ཤིས་པར་མཛད་དེ་ཟླ་བ་གཉིས་པའི་ཚེས་གསུམ་དམག་དཔོན་ཐ་སྐར་གྱི་འགྲུབ་སྦྱོར་ཐོག་མཁར་ལས་ཀྱི་འགོ་བཙུགས་ནས་རྟེན་གཞལ་ཡས་ཁང་ལོ་དེ་ནང་དུ་གྲུབ་པའི།",
    "རི་མོར་གཡས་ངོས་ལ་སྒོ་འབྱེད་ཕྱག་རྡོར་ནས་བཟུང་།",
    "འདུ་ཁང་གི་གཡོན་ངོས་མགོན་ཁང་དཔལ་ཆེན་ལྷ་ཁང་གི་གཙོ་བོར་དཔལ་ཆེན་ཆེ་མཆོག་དབུ་དགུ་ཕྱག་བཅོ་བརྒྱད་པ།",
    "དུར་ཁྲོད་མ་མོ།",
    "བསྟན་སྲིད་དང་འདི་གའི་རིམ་གྲོ་ཁོ་ནར་དགོངས་པ་བསྟད་དེ་ལྷ་ཁང་པདྨོ་བཀོད་ན་ངེད་རང་གི་གཟུགས་བརྙན་༢༣༧ན་ཚེ་དཔག་མེད་ཀྱི་ཕྱག་རྒྱ་ཅན་དངས་མ་བཅུད་འདྲེན་དང་།",
    "འདུ་ཁང་གི་སེང་གདོང་གཡས་ཀྱི་གཙོ་བོ་སྔགས་ཀྱི་སྟོན་པ་དཔལ་ཀུན་ཏུ་བཟང་པོ།",
    "འདུ་ཁང་གི་གྱང་དང་ཤར་གྱི་སྐྱ་ལ་སྟག་མོ་ལུས་སྦྱིན་ནས་བཟུང་བྱ་ཤིང་རྟ་མོའི་བར་འཁྲུངས་རབས་སོ་བཞི་པ།",
    "ལྷ་བཟོ་བ་སོགས་ལ་རྒྱུན་གྱི་བཟའ་བཏུང་ཐོག་མཐའ་བར་གྱི་སྟོན་མོ་དང་མཚར་ཁ་ཡོན་གྱི་དངོས་པོ་བཅས་པས་མཉེས་པར་མཛད་༢༣༧བ་ཅིང་།",
    "ཐམས་ཅད་མཁྱེན་པ་ཁྱོད་ཀྱིས་ནི།",
    "གཡོས་མལ་བྱེད་པའི་ཁང་ཕྲན་ཙམ་བཞེང་བའི་ཆེད་དུ་གོམ་པ་བདུན་བརྒྱབ་ན་ཡང་ངན་སོང་དུ་མི་འགྲོ་ཞིང་ལྷ་ལུས་ཐོབ་བོ།",
    "ལས་མིའི་རྐང་འོག་སོགས་སུ་སྲོག་ཆགས་ཤི་བ་རྣམས་ཀྱང་ངན་སོང་གསུམ་གྱི་གནས་སུ་མི་ལྟུང་།",
    "དེར་སྐྱེས་ན་ལྷའི་རྒྱལ་པོ་ཁྱད་པར་ཅན་ལྷ་དང་ལྷའི་བུ་དང་ལྷའི་བུ་མོ་རྣམས་གྱི་རྟེན་དུ་འགྱུར་ལ།",
    "ཁྱོད་ནི་མི་བདེན་པ་ཡི་ཚིག་མི་གསུང་།",
    "རྟེན་དང་བརྟེན་པའི་དབྱར་རྔ་ཆེར་སྒྲོགས་མོད།",
    "རྡོ་རྗེའི་ཚིག་གི་མདུད་རྒྱ་གང་གིས་འགྲོལ།",
    "སྣ་བདུན་རིན་ཆེན་བཙུན་མོའི་རྗེས་འགྲོ་མ།",
    "ཌཱ་ཀཱི་དྷུ་ཏཱིའི་རྒྱ་གྲོལ་པད་འབྱུང་གིས།",
    "གནམ་གྱི་ཤེ་མོང་དཔུང་པས་རྒྱ་ཧོར་བོད།",
    "བསྟན་སྲུང་ཚོགས་རྣམས་དཔལ་མགོན་༢༤བ་མ་ནིང་ནག།",
    "དབྱར་གྱི་མཛེས་མ་བཞིན་རས་ཉེར་ངོམ་ལང་ཚོར་སྤྱོད་ཚེ་མཆོག་གསུམ་དང་།",
    "མུན་པའི་མུན་པ་འཇུག་པའི་ཆུང་ངུའི་རྒན་མོ།",
    "ཨུབྷྱསཏྱཀེསརེཥུདྷརྨགཉྫགོཏྱརམྱདྷཱཏུགུཔྟཤེཏཀཱཛྙབྷཱནུབནྟུཏོགུཎོཀྟཊཀྱགམྱདྷིཥྛཎནྟུ།",
    "སྔོན་གོམས་ཉོན་མོངས་སྟུག་པོའི་ཁུང་བུ་རུ།",
    "འོད་དཔག་མེད་སྤྱན་མཁའ་མཉམ་འགྲོར་གཟིགས་ཤིག།",
    "རྡོ་བའི་རི་མོ་མ་ཕམ་མགོན་ཞལ་གྱིས།",
    "གནས་ངན་གདུང་མེའི་ཚ་རེག་འབར་བའི་དཔལ།",
    "ཞེས་པ་ལྟར་ལེགས་བྱས་ཀྱི་ཕུང་པོ་བླ་ནས་བླར་སྤེལ་བའི་ཆེད་དུ་སྙན་ཚིག་གི་ལམ་ནས་དྲངས་པའི་བསྟོད་བསྔགས་སྔོན་དུ་འགྲོ་བས་སྐབས་སུ་གླེང་བར་བྱ་བ་ནི།",
    "འོ་སྐོལ་གྱི་སྟོན་པ་ཐུགས་རྗེ་ཆེན་པོའི་བདག་ཉིད་ཅན་ཉོན་མོངས་དང་ཤེས་བྱའི་སྒྲིབ་པ་མཐའ་དག་སྤངས་པ།",
    "འཇིག་རྟེན་ཀུན་ལ་གཟིགས་ནས་ནི།",
    "བཙུན་མོའི་འཁོར་གྱིས་རོལ་པ་དང་།",
    "བྱང་གི་སྒྲ་མི་སྙན་དུ་མི་སྐྱེ།",
    "ཞེས་པའི་འཛམ་བུའི་གླིང་གི་ནང་ཚན།",
    "ཆོ་འབྲང་བུད་མེད་ཀྱི་སྐྱོན་དང་བྲལ་བ་སྒྱུ་མ་ལྷ་མཛེས།",
    "སེང་གེ་གཅིག་གིས་གཅན་༢༤༣བ་གཟན་ཚོགས་རྣམས་དུ་མ་རྣམ་པར་སྐྲག།",
    "རྡོ་རྗེ་གཅིག་གིས་བྲག་གི་རྩེ་མོ་དུ་མ་རྣམ་པར་འཇིག།",
    "བརྒྱ་བྱིན་གཅིག་གིས་ལྷ་མིན་ཚོགས་རྣམས་དུ་མ་རྣམ་པར་འཇོམས།",
    "ཉི་མ་གཅིག་གིས་མུན་པའི་ཚོགས་རྣམས་དུ་མ་རྣམ་པར་སེལ།",
    "ཞེས་པ་ལྟར་གླང་པོ་ཆེ་ཐལ་ཀར་མཆེ་བ་དྲུག་ལྡན་གྱི་རྣམ་པར་ས་མོ་ལུག་གི་ལོ་དབྱར་འབྲིང་ཆུ་སྟོད་ཟླ་བའི་ཚེས་བཅོ་ལྔའི་མཚན་གྱི་ཆར་ཡུམ་གསོ་སྦྱོང་ལ་གནས་པའི་དུས་གློ་གཡས་པ་ནས་ལྷུམས་སུ་ཞུགས་ཙན་དན་གྱི་ཁང་བུ་བརྩེགས་པར་བྱིས་པ་ཟླ་དྲུག་ལོན་པའི་ཚད་ཙམ་པ་མཚན་དང་དཔེ་བྱད་ཀྱིས་བརྒྱན་ཅིང་ན་བཟའ་དང་བཅས་པ་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་ཏེ་ཚངས་པས་ཕུལ་བའི་ཟིལ་དངར་བཞེས་པས་སྐུ་ལུས་བརྟས་པར་མཛད་དེ་ཟླ་བ་བཅུ་རྫོགས་པ་ལྕགས་ཕོ་སྤྲེའུའི་ལོ་ས་ག་ཟླ་བའི་ཚེས་བདུན་རེས་བཟའ་སྤེན་པ་ཟླ་སྐར་རྒྱལ་ལ་བབས་པའི་ཚེ་ཡུམ་གྱི་གློ་གཡས་པ་ནས་བལྟམས་པ་ན།",
    "དགུང་ལོ་དྲུག་པ་ལ་གསེར་གཞོང་དུ་འབྲས་ཆེན་བཞེས་པ་མ་མས་བཀག་ཀྱང་མ་ཐུབ་པས་སྣོད་དེ་གླང་པོ་ཆེ་ལྔ་བརྒྱར་བཏགས་ཏེ་འཕྲོག་པར་བརྩམས་པ་མཛུབ་མོས་དེ་དག་ཚུར་དྲངས་པས་འདིའི་མཛུབ་མོས་གླང་པོ་སྟོང་ཐུབ་༢༤༤བ་ཅེས་གླང་ཆེན་སྟོང་ཐུབ་ཏུ་གྲགས།",
    "ཁྱོད་ཀྱི་སྔོན་སྨྲས་ཚིག་མཆོག་དྲན་བྱས་ཏེ།",
    "ཡིད་དུ་འོང་བའི་དགེ་སློང་རྣམས་རིམ་པར་གཟིགས་པས་རྐྱེན་དང་།",
    "ད་ནི་ཞག་བདུན་ནས་རབ་ཏུ་མ་བྱུང་ན་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོར་འགྱུར་བ་མཚན་མཁན་རྣམས་ཀྱིས་ལུང་བསྟན་པ་ཐོས་པས་ཡབ་ལ་རབ་ཏུ་བྱུང་བར་གསོལ་ཡང་མ་གནང་བར་ཤཱཀྱ་རྣམས་ཀྱིས་མེལ་ཚེ་བྱས་པ་ན་ཉའི་ནུབ་མོ་གྲགས་འཛིན་མའི་མངལ་དུ་སྲས་སྒྲ་གཅན་འཛིན་བསྐྲུན།",
    "བརྒྱ་བྱིན་གྱིས་གོས་ངུར་སྨྲིག་ཕུལ་བ་བཞེས་ནས་རང་བྱུང་གི་སྒོ་ནས་བསྙེན་པར་རྫོགས།",
    "རྒྱ་ཤུག་འབྲས་རྣམས་འབྲུ་རེ་གསོལ།",
    "དེ་ཕྱིར་འདི་ལ་མྱ་ངན་ཁྱོད་མ་བྱེད།",
    "ཁྱོད་ཀྱིས་འོད་གསལ་དམིགས་བྱ་སྟེ།",
    "ཞེས་དབྱངས་གཅིག་གིས་གསུངས་པས།",
    "རི་རབ་ཀྱི་རྩེ་མོར་རྣལ་འབྱོར་གྱི་རྒྱུད་གསུངས་པར་བཞེད།",
    "དེའི་ཕྱོགས་མི་འགྱུར་བའི་གཟེར་ཆེན་ཤར་ཕྱོགས་རྒྱ་ནག་གི་རྒྱལ་ཁམས་ན་འཕགས་པ་འཇམ་དཔལ་དབྱངས་ཀྱིས་རྩིས་ཀྱི་སྒོ་མོ་བརྒྱད་ཁྲི་བཞི་སྟོང་གསུངས་པའི་གནས་རི་བོ་རྩེ་ལྔ།",
    "དེ་བཞིན་དུ་ལྷོར་བྲག་ཁྱུ་མཆོག་གི་ཁ་ནས་སིནྡྷུས་བེ་ཌཱུཪྻའི་བྱེ་མ།",
    "ཡན་ལག་བརྒྱད་དང་ལྡན་པའི་ཆུས་གང་བའི་ནང་ན་པདྨའི་འདབ་མ་བ་ལང་གི་ཀོ་བ།",
