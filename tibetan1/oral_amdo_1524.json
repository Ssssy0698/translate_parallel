    "ཞེས་གཞན་ལ་ཕན་གདགས་པའི་ཡོན་ཏན་གྱིས་འགྲོ་བ་རྣམས་ཕར་བཅིངས་པ་ལྟར་ཉོན་མོངས་པས་ཐོག་མ་མེད་པ་ནས་གཟིར་བའི་ལུས་ཅན་རྣམས་ཀྱི་སྡུག་ཀུན་ཉེ་བར་གཞིལ་བའི་ཐུགས་རྗེ་ཆེན་པོའི་ཁུར་གྱིས་བཅིངས་པ་ཡོངས་རྗེས་ཀྱི་བརྒྱན་ཏེ་རྒྱལ་བ་བཙོང་ཁ་པ་ཆེན་པོས།",
    "ཁྱོད་ནི་འགྲོ་བའི་དོན་གྱི་སླད།",
    "འགྲོ་བ་རྣམས་ཀྱང་ཁྱོད་ཀྱི་ནི།",
    "ཁྱོད་ཀྱིས་ཉོན་མོངས་གཞོམ་པར་བཤད།",
    "ཕན་དགོངས་ཐུགས་རྗེ་ཅན་གྱིས་གཟིགས།",
    "༢༧༡ན་འགྲོ་བའི་སྡུག་བསྔལ་ཕྱག་གིས་མི་སེལ་ལ།",
    "ཤར་གྱི་ཡུལ་ན་གནས་ལྷ་མོ།",
    "བྱང་གི་སྒྲ་མི་སྙན་དུ་མི་སྐྱེ།",
    "ཞེས་པས་མཚོན་ཏེ་རྒྱ་གར་ཤར་ནུབ་ལྷོ་བྱང་གི་ཡུལ་རྣམས་དང་།",
    "དེ་དག་གི་ཕྱི་རོལ་ཏུ་ཤར་ནས་འཇམ་དབྱངས་ཀྱི་གནས་རི་བོ་རྩེ་ལྔ།",
    "ལྷོར་སྤྱན་རས་གཟིགས་དང་སྒྲོལ་མིའི་གནས་རི་བོ་པོ་ཏ་ལ།",
    "སྤྲེའུ་དང་བྲག་སྲིན་མོ་ལས་མཆེད་པ་མ་སངས་སྤུན་དགུ།",
    "ཁྱོད་ཀྱི་གདུལ་བྱ་མང་པོ་ཡང་དེ་ན་ཡོད་པས་བྱང་ཕྱོགས་བོད་དུ་སོང་ཞིག།",
    "བལ་བོའི་རྒྱལ་པོ་དེ་བ་ལྷས་སྲས་མོ་ཁྲི་བཙུན་ལ་གསུངས་པ།",
    "སློབ་དཔོན་མཚོ་སྐྱེས་རྡོ་རྗེས་རྗེ་འབངས་དགུ་དང་ཉེར་ལྔ་ལ་སྒྲུབ་པ་ཆེན་པོ་བཀའ་བརྒྱད་སྤྱི་བྱེ་བྲག་གི་སྨིན་གྲོལ་གྱི་གདམས་པ་སྩལ།",
    "སློབ་དཔོན་ཆེན་པོས་རི་བྲག་མཚོ་གསུམ་ཕལ་མོ་ཆེ་བྱིན་གྱིས་བརླབས།",
    "གར་ལོག་གི་ཕོ་ཉས་ཕྱག་བཙལ།",
    "སྔ་རྟ་དང་བ་མར་ཕལ་མོ་ཆེ་ཕྱག་ཏུ་ཕུལ།",
    "ཤེས་བྱ་ཐམས་ཅད་གཟིགས་པ་ཀུན་མཁྱེན་བུ་སྟོན་ཡབ་སྲས་ཀྱིས་གཏན་ལ་ཕབ་ནས་རྒྱ་ཆེར་སྤེལ།",
    "འདི་དག་ནི་ཐུན་མོང་དུ་སྣང་བའི་ཆེ་བ་ཙམ་ཞིག་བརྗོད་པ་སྟེ།",
    "གཙང་ཁང་སྟེང་དུ་སྤྱན་རས་གཟིགས།",
    "གྲུབ་ཆེན་ནག་པོ་སྤྱོད་པ་དང་མ་གཅིག་གྲུབ་པའི་རྒྱལ་མོ།",
    "མར་མི་ཐུན་མོང་གི་གསོལ་ཞལ།",
    "ལོ་ཆེན་རིན་བཟང་གི་ཕྱག་སེན།",
    "གསོལ་ལྷུང་གི་ཤུབས་འཁར་སིལ།",
    "ངོར་པ་རྡོ་རྗེ་འཆང་གི་དབུ་སྐྲ།",
    "རྩེས་དང་བསམ་གཏན་གླིང་གི་དམ་རྫས།",
    "བསམ་ཡས་བར་ཁང་གི་རྒྱ་དཔེ།",
    "རྗེ་ཀུན་དགའ་ཚེ་མཆོག་གི་དབུ་ཞྭ།",
    "དཔལ་ཕག་མོ་གྲུ་པའི་དབུ་སྐྲ་དང་།",
    "མཁས་གྲུབ་ཐམས་ཅད་མཁྱེན་པ་གསུམ་གྱི་སྣང་བརྙན་རེ།",
    "བདེ་མཆོག་ལཱུ་ཧི་པ་དང་ཀུན་རིག་གི་དཀྱིལ་ཐང་རེ།",
    "གསུང་རྟེན་གཤིན་རྗེ་དགྲ་ནག་གི་རྒྱུད་ཚར་བཞི།",
    "འདུ་ཁང་གི་བྱང་སྐྱ་གཙང་ཁང་གི་སྒོའི་གཡས་སུ་ངོས་ཀྱི་འདྲ་འབག་དང་ཟབ་མོ་ལྟ་བརྒྱུད།",
    "ཤར་རྒྱུད་ལ་འདུས་པ་ལྷ་སོ་གཉིས་༢༨༣ན་བདེ་མཆོག་ལྷ་རེ་གཉིས།",
    "སྤྱན་རས་གཟིགས་རྟ་མགྲིན་ཞབས་བརྒྱད་པ།",
    "ཁྱོད་ནི་མི་བདེན་པ་ཡི་ཚིག་མི་གསུང་།",
    "འཕྱར་ལ་འབྲས་འདོད་བྱིས་པའི་སོར་མོ་ཡིས།",
    "དཀོན་ཆོག་གསུམ་ལ་རི་མོར་བྱ་བའི་བློས།",
    "སྔོན་མེད་ཛ་ཧུའི་བུ་མོ་དེང་འགྲུབ་ཤོག།",
    "དྷ་རྨ་དྷཱ་ཏོ་རྨཱ་ཧཱ་ཤྲཱི་སུ་རེ་རྒ་ཎྱ་ཀཱ་བྷི་པྲ་ཡཾ་ཙོ་ད་ཏེ་ཛེ་མ་དྷོ་ཪྵ་བཱ་ཀ།",
    "ཐུགས་དམ་བསྐུལ་བའི་བརྗིད་ལྡན་རོལ་མོའི་སྒྲ།",
    "གསེར་སྦྱངས་རི་མོའི་འོད་བཀྲག་རབ་རྒྱས་མཐར།",
    "ཉེ་རིང་མེད་པར་གསལ་བའི་རི་མོ་མིག་གསུམ་པས་ཀྱང་དབྱེ་ནུས་སྐབས།",
    "རྣམ་དཔྱོད་སོར་མོས་འགྲོལ་ལ་སྐལ་བཟང་འདིའི།",
    "འདྲེན་པ་སྟོང་གི་ལུང་རྟོགས་གཅིག་བསྡུས་པ།",
    "བདག་བློའི་རྨོངས་མུན་སེལ་ཅིག་ངག་གི་ལྷ།",
    "སྐེམ་བྱེད་དྲི་ཟའི་བུ་མོས་སོར་གདུབ་སྒྲ།",
    "ངོ་མཚར་ཞིང་གི་བཀོད་པ་རྨད་བྱུང་བ།",
    "རྣམ་དཔྱོད་སོར་མོའི་༢༨༧ན་རོལ་རྩེད་འཕྲུལ་པོ་ཆེ།",
    "སྟོན་མཚན་ཟླ་བ་སྟོང་གིས་འཁྱུད་པས་ཀྱང་།",
    "གཡུ་ཕྲ་རྙིང་པ་མི་ལེགས་པ་རྣམས་བཞག་པའི་བཞི་བརྒྱ་དོན་བདུན་གྱི་སྟེང་དུ་གསར་སྣོན་ཆིག་བརྒྱ་རེ་གཅིག།",
    "གནམ་གྱི་ཤེ་མོང་དཔུང་པའི་རྒྱལ་ཁབ་ཀྱི།",
    "རྐང་འཐུང་ཕུར་མའི་རེ་བཅུད་པད་རཱཀ་མདངས།",
    "ངེས་གསང་འདུས་པའི་གླིང་གི་སྤྱི་རྫས་སུ།",
    "ཨོཾཌྜཱི་ཡ་ནའི་སློབ་དཔོན་ཁྱོད་ཉིད་བསྔགས།",
    "གང་དྲན་རྣམ་འགྱུར་ཡ་མ་ཟུང་གི་ཆས།",
    "ཐུགས་རྗེའི་གཟིགས་པས་བོད་ཡུལ་མི་གཏོང་བར།",
    "མ་ག་བྱིན་ཚེ་ཐམ་ཕུད་འབུལ་ཚིག་གི་བསྐུལ་མ་བྱུང་བ་ལྟར་བཀོད་པའི་འཕྲིན་ལས་རབ་ཡངས།",
    "ཐུན་མཚམས་རི་མོ་རབ་འབར་ཐམ་གའི་ཕུད།",
    "ཆིང་གིས་གནམ་གྱི་བརྒྱུད་འཛིན་རྒྱལ་རིགས་ཀྱི།",
    "འཕྱན་པར་བརྩེ་ལྡན་ཐུགས་བསྐྱེད་སྐྱ་རེངས་དད་པའི་རྟ་ལྗང་གིས་འདྲེན་ན།",
    "འཁོར་ལོའི་རི་མོ་རབ་འབར་ཞབས་ཀྱི་རྡུལ།",
    "གཙུག་ཏུ་ལྷུངས་པའི་མོད་ལ་ཐོག་མཐའ་བར།",
    "དགེ་མཚན་བྱེ་བས་ནོར་འཛིན་དཔལ་མོའི་མངལ།",
    "བདེ་སྐྱིད་སྲོག་གི་ཟུངས་སོང་ལེགས་བྱས་འབྲས།",
    "མཐོང་ཐོས་དྲན་རེག་དོན་ལྡན་ཐུབ་གསུང་ལ།",
    "བཅུད་ལེན་ཕྱོགས་འདིར་འགྱུར་རོ་ཅོག་གི་བཀའ།",
    "སྲས་རྒྱལ་བུ་སྟོང་གིས་ཟླ་བ་གསུམ་གསུམ་བསྙེན་བཀུར་བྱས་ཏེ་ལོ་ཉིས་བརྒྱ་ལྔ་བཅུ་དང་ཟླ་བ་གསུམ་འདས་པ་ན།",
    "བྲམ་ཟེ་བྱེ་བ་ཕྲག་གསུམ་ལུང་བསྟན་པས་རྣམ་པར་གཟིགས།"
  ]
}