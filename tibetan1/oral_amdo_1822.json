    "དེས་ཕན་ཚུན་ལ་གནོད་ཀྱི་ཨེ་རེད།",
    "ང་འདི་ལ་དོགས་སྣང་སྐྱེ་གི་འདིའི་ཕྱོགས་ལ་ཁྱེད་ཚོས་བསམ་བློ་ཞིག་བཏང་ན་ལམ་ཞིག་ཨེ་ཡོད་བསམ་གི་ཕན་ཐོགས་ཡོད་གྱི་རེད་སྙམ་གི་ཉན་པོའི་ཐལ་མོ་རྡེབ་སྒྲ་སློབ་གྲོགས་ཁ་པ།",
    "མཐུན་པ་ཡོད་པ་ནི་མིའི་རང་གཤིས་རེད།",
    "གལ་ཏེ་མི་ཀླད་པ་ཅན་ཞིག་ཡིན་ཚེ་དེ་ལ་ལྟ་ཚུལ་མི་མཐུན་པ་ཞིག་ཡོད་ནི་རེད།",
    "བདག་ཅག་གི་སྟོན་པའི་རྗེས་འཇུག་པ་ཐམས་ཅད་ཀྱང་དེ་འདྲ་རེད།",
    "ཐུན་མོང་མ་ཡིན་པ་ཞིག་ཡོད་དགོས།",
    "ཉན་པོའི་ཐལ་མོ་རྡེབ་སྒྲ་མེ་ལྕེ།",
    "ཡ་ད་དུས་ཚོད་ཀྱང་མང་པོ་འགོར་ཐལ།",
    "དོ་དགོང་གི་བགྲོ་གླེང་མཚམས་འདི་ནས་འཇོག་ཁྱེད་རྣམ་པ་བཀའ་དྲིན་ཆེ།",
    "ཉན་པོའི་ཐལ་མོ་རྡེབ་སྒྲ་མགོ་འཛིན་པ་ཀིརྟི་སྐྱབས།",
    "སླད་མར་ཡང་ངེད་ཚོ་ལ་ཐུགས་ཁུར་དང་རྒྱབ་སྐྱོར་ཡང་ཡང་གནང་བའི་རེ་བ་ཞུས་པ་ཡིན།",
    "ཉན་པོའི་ཐལ་མོ་རྡེབ་སྒྲ་ལོའི་ཟླ་པའི་ཚེས་ཉིན་བཤུས་ཚར།",
    "དོ་དགོང་ང་ཚོས་ཁུ་སིམ་ཁད་ཀྱིས་དཀྲོག་གི་རྩོམ་པ་པོ་སྐུ་ཞབས་མེ་ལྕེ་ལགས་འདིར་གདན་འདྲེན་བྱས་ཏེ།",
    "ངེད་ཅག་གི་ལམ་གྱི་གླེང་གཞི་ཚོགས་ཐེངས་བཅུ་གཅིག་པ་རུ་ཆེད་དུ་བཀོད་སྒྲིག་བྱས་ནས་འཆད་ཁྲིད་ཞུ་རུ་འཇུག་རྒྱུ་ཡིན།",
    "ཉན་པོའི་ཐལ་མོ་རྡེབ་སྒྲ་ཡ་ད་འུ་ཅག་གིས་ཁ་བརྡའི་འགོ་རྩོམ་རྒྱུ་བྱེད།",
    "གཟའ་འཁོར་གཉིས་ལྷག་གི་ཡར་སྔོན་ལ་ང་རང་སྒེར་དོན་ཞིག་གི་ཆེད་དུ་ཟི་ལིང་དུ་ཐེངས་གཅིག་སོང་བ་ཡིན།",
    "ཟི་ལིང་ནས་གྲོགས་པོ་ཞིག་གིས་ད་སོ་མ་དཔར་མ་ཐག་པའི་ད་ལོའི་སྦྲང་ཆར་དེབ་གསུམ་པ་ཞིག་ལེགས་སྐྱེས་ཀྱི་ཚུལ་དུ་གནངས་བྱུང་།",
    "བསམ་གཞིག་གི་སྒོ་གླེགས་མང་པོ་འབྱེད་པར་སྨྱུག་ཁ་སྒྱུར་བཞིན་ཡོད།",
    "གོ་དཀའ་བའི་ནང་དོན་སོགས་ལ་དཔྱད་པ་གཏོང་བའི་ཆིག་རྐྱང་རང་བཞིན་གྱི་དཔྱད་བརྗོད་སྤེལ་སྟངས་དེང་སང་གི་རྩོམ་རིག་གི་དཔྱད་བརྗོད་ཕལ་ཆེ་བ་འདིའི་རིགས་སུ་གཏོགས་དེ་ལས།",
    "ཉན་པོའི་ཐལ་མོ་རྡེབ་སྒྲ་གཉིས་པ།",
    "ཤེས་རྨོངས་ཀྱི་གནའ་གྲོང་རིག་ལྡན་རྒྱ་མཚོ་ལགས་ཀྱི་གནའ་གྲོང་དེ་སྒྲུང་འབྲིང་ཞིག་རེད།",
    "གཞུང་ལམ་མེད་པ་ལྟ་བུ་རེད།",
    "གནའ་གྲོང་གི་མཁར་གྱང་རྣམས་མཐོན་པོ་གནམ་ལ་ཟུག་པ་ལྟ་བུ་ཡིན་ཡང་མཁར་གྱང་རྙིང་པ་ནི་མི་འགྱང་བར་རྡེབ་པའི་ཉེན་ཁ་གནས་པ་དངོས་སུ་མཐོང་ཐུབ་པ་ལྟ་བུའོ།",
    "སྒྱུར་སོགས་ཀྱི་མཚོན་བྱེད་ཅིག་རེད།",
    "ཟུང་ཟླ་བས་གནའ་གྲོང་གི་སྐྱོ་ལ་སྡུག་པའི་གནས་བབ་དེ་མཐོང་བས་སེམས་ནས་མ་བཟོད་པ་དང་།",
    "བཟོད་པ་ངོ་ལུག་ཚང་གི་ཤིང་བཟོའི་ཡོ་བྱད་དག་སླར་ཡང་བཀོལ་སྤྱོད་བྱེད་དུ་བཅུག་པ་དང་།",
    "གསར་གཏོད་ཀྱིས་ད་གཟོད་རང་ཉིད་བྱོལ་སོང་མ་ཡིན་པའི་སྒྲུབ་བྱེད་ཧ་ཅང་མང་པོ་སྔོག་འདོན་བྱེད་སྲིད་ཅིང་།",
    "གསུམ་ནས་གནའ་གྲོང་གི་མི་ནི་མི་རྒྱུས་མེད་དང་མི་ཆ་མེད་ལ་ཤིན་ཏུ་སྡང་བ་ཞིག་རེད།",
    "གནའ་གྲོང་གི་མི་ཕལ་མོ་ཆེ་ནི་མི་རྒྱུས་མེད་ལ་མི་རློམ་ཞིང་།",
    "ཐ་ན་ཨ་ཁུ་བསམ་གཏན་གྱི་བུ་མོས་ཟུང་ཟླ་བའི་གམ་ནས་མོའི་ཨ་ཕ་ལ་ཨ་ཕ།",
    "ཁྱོད་ཀྱིས་ཁོ་ཐུ་ཟུང་ཟེར་བ་དེ་མིན་ནམ།",
    "ཁྱོད་ཀྱིས་ཡིད་ཆེས་སམ།",
    "གནའ་གྲོང་ནི་ཤེས་རྨོངས་ཀྱི་གནའ་གྲོང་ཞིག་ཨེ་རེད།",
    "འདི་ལྟ་བུའི་ཤེས་རྨོངས་ཀྱི་གནའ་གྲོང་ཞིག་ནས་ཟུང་ཟླ་བ་ཕམ་པར་བརྒྱབ་སོང་བ་རེད།",
    "དེང་སང་ང་ཚོས་འུ་ཅག་རྗེས་ལུས་རེད།",
    "ང་ཚོས་ཇི་ལྟར་བློ་འབྱེད་བྱེད།",
    "ལྷ་སའི་སྐུ་དྲག་གཙོ་བྱས་པའི་ཡོན་ཏན་པ་མང་པོ་ཞིག་གིས་སྐབས་ཐོག་དེར་བློ་འབྱེད་ཀྱི་དེས་མི་ཚད་རང་རང་གི་ངོས་ཐད་ལས་འགན་དེ་ཕྲག་ཏུ་བླངས་ཟིག་ཡིན་ནའང་མཐའ་མཇུག་ཚང་མས་ཕམ་ནས་འབད་པ་ཡང་བྱས་ཟིག་དེའི་རྐྱེན་གྱིས་ད་ལྟ་ང་ཚོས་ཇི་ལྟར་བློ་འབྱེད་ཁ་མྱངས་སོང་བ་རེད།",
    "བྱེད་པའི་ཐད་ལ་བསམ་གཞིག་ཡང་ཡང་གཏོང་དགོས་གི་སྟེ།",
    "གཟུང་ཟླ་བ་ནི་མི་ཅི་འདྲ་ཞིག་རེད་ཅེ་ན།",
    "གཅིག་ནས་ཁོ་ནི་སྒེར་ཚུགས་ཀྱི་མི་གཞི་ལྡན་ཞིང་སྒེར་གཤིས་མངའ་བ་དང་སྒེར་ཚུགས་ཀྱི་བསམ་གཞིག་གཏོང་མཁན་ཞིག་རེད།",
    "སྤྱིར་ཁོ་རང་གནའ་གྲོང་དུ་གནའ་གྲོང་གི་ལྕགས་རི་རྙིང་པ་དེ་འཚོལ་དུ་ཡོང་ནའང་།",
    "གནའ་གྲོང་གི་སྐྱ་ཟད་སྔོ་སྡུག་གི་འཚོ་བ་དེ་མཐོང་བས་གདུང་སེམས་ཆེན་པོ་སྐྱེས་པ།",
    "སྒྲུབ་ཕོད་པ་ཅན་ཞིག་ཀྱང་རེད།",
    "དེ་ནི་ཅི་འདྲའི་ཡིད་ཕངས་པ་ཞིག་རེད་ཨང་།",
    "དཀའ་བ་རེད།",
    "མང་ཚོགས་ཀྱི་བདེ་སྡུག་ཀྱང་ཐག་གཅོད་བྱེད་ཐུབ་ཀྱི་མེད་པ་དེ་མཚོན་འདུག་སྙམ།",
    "ང་ལ་མཚོན་ན་འདི་ན་དྲི་རྟགས་ཤིག་ཡོད་གི།",
    "བརྩམས་སྒྲུང་འདི་བཀླགས་པ་བརྒྱུད་ང་ཚོས་ཤེས་རྟོགས་ཐུབ་པ་ནི།",
    "མི་བུ་ལག་ལེན་པ་ནི་གནས་ཐབས་ཡེ་ནས་ཡོད་པ་མ་རེད།",
    "ནི་མགོ་བོར་རྡོ་ལོག་གིས་ཤུགས་ཀྱིས་བརྡབ་རྒྱུ་དེ་རེད།",
    "ཡང་ན་བློ་ཕམ་དང་བཅས་ས་སྲོད་ཀྱི་དུས་སུ་བཙན་གྱིས་འགྲོ་དགོས་པ་དེ་རེད།",
    "མི་བུ་རྒྱུ་འབྲས་ཅན་དག་འབུར་འཇོམས་དང་དམར་གསོད་གཏོང་བྱེད་ཅིག་རེད།",
    "གཉིས་ནས་འུ་ཅག་གི་ཡོན་ཏན་པ་རྣམས་ཀྱིས་ནམ་ཡང་གནའ་གྲོང་གི་ལྕགས་རི་རྙིང་པ་ལྟ་བུ་འཚོལ་བ་དང་།",
    "ཡང་ན་བརྡ་ཆད་སྐམ་པོ་སྤུངས་པའི་དཔྱད་རྩོམ་རེ་བྲིས་ཏེ་ལས་ཐོབ་ཨེ་འཕར་ལ་བལྟ་བ་སོགས་བྱེད་པ་ལས་མི་སེར་དཀྱུས་མའི་བདེ་སྡུག་ནི་ཐེད་ལ་བོར་འདུག་ཁོ་ཚོ་ལ་གདུང་སེམས་ཆེན་པོ་མི་འདུགའགན་འཁྲིའི་འདུ་ཤེས་མི་འདུག་རྒྱུ་འབྲས་བློ་མིག་མི་འདུག་དེར་ཡ་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "ཉན་པོའི་ཐལ་མོ་རྡེབ་སྒྲ་གསུམ་པ།",
    "ངས་བལྟས་ན་ཐོག་མར་བརྩམས་སྒྲུང་འདིའི་བརྗོད་གཞི་འདེམ་པ་ཧ་ཅང་ལེགས་པོ་རེད།",
    "ལྷག་པར་དུ་རྩོམ་མཁན་ཞིག་ལ་མཚོན་ན་སེར་མོ་པའི་འཇིག་རྟེན་འདི་ལ་རྒྱུས་ལོན་དང་ལྟ་ཞིབ་བྱས་ཏེ་སྨྱུག་ཁ་འདིའི་ཕྱོགས་ལ་བསྒྱུར་ན་འགྲིག་གི་འདོད།",
    "དེང་སང་གྲྭ་བཙུན་རྩོམ་མཁན་གྱི་ཁྲོད་ནའང་རྩོམ་རིག་གསར་པ་ལ་འཇུག་མཁན་སྐོར་ཞིག་ཡོད་གི་ལ་ཤས་ཀྱིས་རང་ཉིད་ལ་ཉམས་མྱོང་དང་གསལ་ཆ་མེད་པ་སྟེ།",
    "དཔེར་ན་ཕོ་མོའི་བར་གྱི་བརྩེ་དུང་གི་སྐོར་སོགས་ཀྱང་རང་མོས་སྙན་ངག་ཏུ་བྲིས་ཡོད་པ་མཐོང་རྒྱུ་ཡོད་གི་དེ་ནི་ཤིན་ཏུ་ནས་དགོད་བྲོ་བ་ཞིག་རེད།",
    "ཁྱོད་ཀྱིས་རང་ལ་རྒྱུས་མེད་པ་ཞིག་ལབ་བརྡོལ་འབྱིན་པ་ལས་རང་ལ་རྒྱུས་ཡོད་པའི་སེར་མོ་པའི་འཇིག་རྟེན་དེ་བྲིས་ན་མི་ལེགས་སམ།",
    "བསྡུས་གཟུགས་དེ་ལས་གྲྭ་བཙུན་ཞིག་གི་གཟུགས་བརྙན་མཐོང་ཡོང་།",
    "གྲྭ་བཙུན་དེ་ནི་ཅི་འདྲ་ཞིག་རེད་ཅེ་ན།",
    "ཅི་ཡང་མི་ཤེས་པ་ཞིག་རེད།",
    "ལུས་ཀྱི་སྟོད་སྨད་ཐམས་ཅད་གཟུགས་མེད་ཀྱི་དངོས་པོ་ཞིག་གིས་ཡོངས་སུ་མནན་ཏེ་དབུགས་ཀྱང་འབྱིན་དཀའ་བའི་ཚོར་སྣང་བྱུང་བས།",
    "འདི་ནི་མོ་ཡང་ནས་ཡང་དུ་བཏབ་པ་དང་།",
    "མེད་ནི་དད་པ་ཅན་ཞིག་ཨེ་རེད།",
    "ཁོའི་དད་པ་དེ་བརྟན་པོ་ཞིག་ཨེ་རེད།",
    "ཉན་པོས་མ་རེད།",
    "མ་རེད་ཟེར་དད་པ་ཞེས་པའི་ཐ་སྙད་འདི་བོད་མི་ཀུན་གྱི་ཁ་ན་རླངས་པ་བཞིན་ཐུལ་ལེ་ལེ་བྱེད་ཀྱི་ཡོད་པ་ཞིག་རེད།",
    "ཁྱོད་ལ་དད་པ་ཡོད་དམ་ཞེས་པའི་འདྲི་ཚིག་འདི་ནི་འུ་ཅག་བོད་མི་རྣམས་ལ་མཚོན་ན་བརྙས་ཚིག་ཅིག་རེད།",
    "ཚང་མས་ང་ལ་དད་པ་ཡོད་ཅེས་བརྗོད་སྲིད་པ་རེད།",
    "འུ་ཅག་གི་དངོས་ཡོད་འཚོ་བའི་ཁྲོད་དུ་བསྟན་འཛིན་འཇིགས་མེད་གང་མང་མང་ཡོད་པ་རེད།",
    "བསམ་གཞིག་གི་སྒོ་གླེགས་འབྱེད་ས་ནི་ཆེན་པོ་ཞིག་མི་འདུག་སྙམ།",
    "ཉན་པོའི་ཐལ་མོ་རྡེབ་སྒྲ་བཞི་པ།",
    "གནའ་གྲོང་གི་རྩོམ་པ་པོ་རིག་ལྡན་རྒྱ་མཚོ་ལགས་ནི་དུས་རབས་ཉེར་གཅིག་པའི་ནང་དུ་རང་རེའི་རྩོམ་སྟེགས་སྟེང་བྱུང་བའི་གསར་སྐྱེས་ཀྱི་རྩོམ་པ་པོ་ཞིག་རེད།",
    "ལོ་ངོ་འདི་འགའི་རིང་ལ་སྦྲང་ཆར་སྟེང་དུ་སྔ་ཕྱིར་མིག་གསུམ་པ་དང་ཨ་ཁུ་དཔོན་སོགས་སྤེལ་མྱོང་།",
    "ཁོ་ནི་དུས་རབས་སྔོན་མའི་ལོ་རབས་དགུ་བཅུ་པ་ནས་བཟུང་འུ་ཅག་གི་རྩོམ་སྟེགས་སྟེང་སྙན་གྲགས་ཅུང་ཆེ་བའི་རྩོམ་པ་པོ་ཞིག་རེད།",
    "སྤྲོ་བའི་སྒྲུང་ཐུང་དེབ་ཅིག་ཀྱང་ཡིན་པ་རེད།",
    "གཅིག་ནི་ལོ་ཚོད་སུམ་ཅུའི་ནང་དུ་ཡོད་པའི་ན་གཞོན་ཞིག་རེད་ལ།",
    "ཅིག་ཤོས་ནི་ལོ་ཚོད་བཞི་བཅུ་ཡོལ་བའི་དར་མ་ཞིག་རེད།",
    "དེ་ནི་ངོ་མ་བདེན་པ་རང་རེད།",
    "ཞན་ཆ་འདི་དག་བཀྲ་བྷ་ཁོ་ན་མ་ཡིན་པར་དར་མའི་རྩོམ་པ་པོ་གཞན་དག་གི་སྟེང་ནའང་འདུག་སྟེ།",
    "རེབ་གོང་རྡོ་རྗེ་མཁར་དང་སྟག་འབུམ་རྒྱལ།",
    "རང་སྒྲ་སོགས་ལྟ་བུ་རེད།",
    "དེ་བས་ནང་པའི་བསྟན་པ་འདི་ལ་མཚོན་ན་གྲྭ་བཙུན་བསྟན་འཛིན་འཇིགས་མེད་ནི་དངོས་གནས་དགོས་མེད་ཀྱི་ལྷག་མ་ཞིག་རེད་སྙམ།",
    "པའི་བརྗོད་བྱ་ལ་བཟོ་བཅོས་ཅུང་ཟད་བྱས་ཏེ་རྩོམ་དགོས་པ་དེ་འདྲ་ཞིག་གཏན་ནས་མ་རེད་འདོད།",
    "བསམ་བློའི་ཆ་ནས་ཀྱང་དེ་འདྲའི་ཟབ་ཚད་ཡོད་པ་ཞིག་མ་རེད།",
    "བཀྲ་བྷ་དང་ཡང་ན་ཁོ་ཚོའི་རབས་གཅིག་པའི་རྩོམ་མཁན་རྣམས་ཀྱི་གསར་གཏོད་ཀྱི་ནུས་པ་དང་བསམ་པའི་བཀོད་པ་དེ་ཉམས་དམས་སུ་འགྲོ་བཞིན་པ་དེ་རེད།",
    "བཀྲ་བྷ་སོགས་ཀྱིས་མཚོན་པའི་དར་མའི་རྩོམ་མཁན་རྣམས་ཀྱི་བར་ན་དེ་འདྲའི་བར་ཁྱད་ཅིག་ཡོད་གིའོ་ན།",
    "དེ་འདྲའི་བར་ཁྱད་ཅིག་ཇི་ལྟར་ཤོར་བ་རེད་ཅེ་ན།",
    "ངས་བལྟས་ན་གཤམ་གྱི་རྐྱེན་འདི་འདྲ་ཞིག་ལ་ཐུག་ཡོད་གི་སྙམ།",
    "ཉན་པོའི་ཐལ་མོ་རྡེབ་སྒྲ་ལྔ་པ།",
    "ཉིན་ཞིག་ཚོམས་ཁང་ཆེན་མོ་ཞིག་ཏུ་ཨ་རིའི་གླུ་ལེན་མཁན་ཞིག་གིས་གླུ་གཞས་ཀྱི་དབྱངས་རྟ་དང་པོ་དེ་བླངས་པར་ཉན་པོ་རྣམས་ཀྱིས་དགའ་འབོད་བྱས་ཤིང་ཐལ་མོ་ཡང་ཡང་བརྡབས།",
    "ཉན་པོ་ཚོས་སླར་ཡང་ཐེངས་གཅིག་ལེན་དགོས་པའི་རེ་བ་ཞུས་པ་ན།",
    "ཡིན་ནའང་ཉན་པོ་ཚོས་ད་དུང་ཐེངས་གཅིག་ལེན་པའི་རེ་བ་ཞུས།",
    "ཡང་ཉན་པོ་ཚོའི་རེ་བ་ལྟར་ཁོས་ཐེངས་གསུམ་པ་དང་བཞི་པ།",
    "ཉན་པོ་ཚོ་ན་རེ།",
    "རྣ་བར་སྙན་ཞིང་ཡིད་ལ་འཇེབས་པ་དང་ཚད་ལྡན་ཡིན་རག་བར་དུ་ལེན་རོགས་མཛོད་ཅེས་ཐལ་ལོ།",
    "ཉན་པོའི་དགོད་སྒྲ་འུ་ཅག་གི་རྩོམ་མཁན་རྣམས་ཀྱི་གནས་ཚུལ་ཡང་ཨ་རིའི་གླུ་པ་འདི་དང་ཨ་ན་མ་ན་རེད།",
