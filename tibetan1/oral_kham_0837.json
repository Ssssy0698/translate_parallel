    "ལ་བཙས་ཅིག་ཤིག་འདུག་པ་དེ་བཤིག་པའི་ནང་དུ།",
    "མཛུབ་སོར་གྱིས་སྨར་ཡིག་མང་པོ་བྲིས་ནས་འདུག་ཅེས་དང་།",
    "ཅེས་ལ་བཙས་སུ་བྲིས་གནང་འདུག།",
    "ཞེས་པ་ཡང་བྲིས་པ་འདུག་ལྟར་རོ།",
    "ཞེས་པའི་སྐབས་སུ་ཏི་ཙེ་ཞེས་གསལ་འདུག་པ་ལྟར་རོ།",
    "པའི་སྐབས་སུ་ཏི་ཙེ་ཞེས་བྲིས་འདུག་པས་སོ།",
    "ཞེས་བྲིས་འདུག་པས་གསལ་ལོ།",
    "བོན་འདི་མུ་སྟེགས་ཡིན་འདུག་སུས་ས་མ་བྱེད།",
    "མཁའ་ལ་རྒྱས་པའི་རྔ་འདུག་པ་ལས།",
    "གཞུང་འདི་ཉིད་ཁོད་སྤུངས་དྲན་པས་མཛད་མེད་པ་གསལ་པོར་གྱུར་འདུག་སྙམ།",
    "ཡ་མཚན་ཆེ་བའི་མཁར་ཞིག་གདའ།",
    "འབྱེད་པའི་སྒྱུར་ཐབས་དུ་ཞིག་གདའ།",
    "ཞེས་ལུང་དྲངས་འདུག་པས།",
    "བེ་རོ་ཙ་ན་དང་།",
    "གཡའ་གྲུམ་སི་ལི་མ་བཅས་ཡིན་ཚུལ་གསུངས་༥༡འདུག་ས་སྐྱའི་གདུང་རབས་རིན་ཆེན་བང་མཛོད་ལས།",
    "བོད་ཁམས་གཡང་དྲུག་༥༦སོགས་སྐབས་དེ་དག་ཏུ་དག་ཆ་གཅིག་གྱུར་མེད་སྟབས་སྒྲ་གདངས་ཉེ་བའི་ཡི་གེ་འདྲ་མིན་བྲིས་འདུག་ནའང་།",
    "བོད་ཅེས་པ་འདི་གཅིག་མཐུན་དུ་བྱུང་འདུག་པས་སོ།",
    "པོ་གོ་རྒྱུ་དང་མཐོང་རྒྱུ་འདུག་པ་དཔེར་ན།",
    "རྒྱལ་པོའི་བཀའ་ཐང་༦༥དང་གླེང་གཞི་བསྟན་པའི་འབྱུང་ཁུངས་༦༦ལས་འགོང་པོ་སྤུན་དགུ་དང་མ་སངས་སྤུན་དགུ་གཅིག་པ་ལྟ་བུར་བྱས་ནས་འཆད་འདུག་ལ།",
    "ད་དུང་བོད་ཀ་གཡག་དྲུག་ཅེས་པའི་མིང་ཡང་འགོང་པོ་སྤུན་དགུའི་སྐབས་བྱུང་ཚུལ་འཆད་འདུག་པ་ལའང་དཔྱད་པར་བྱ་དགོས་སོ།",
    "ཞོར་ལ་འདི་འདྲའི་དྲི་བ་ཆེན་པོ་ཞིག་ཀྱང་རང་བཞིན་གྱིས་འཁོར་ཡོང་བ་ཡང་ཡིན་ཏེ།",
    "སྐབས་དེར་ཐ་སྙད་མང་པོ་ཞིག་རྒྱ་སྐད་ཀྱི་སྒྲ་དོན་སླེབས་པར་བཅོས་འདུག་པས།",
    "དུས་དེང་སང་གནངས་ཀ་བལྟས་ཙ་ན།",
    "དུས་དེང་སང་གནངས་ཀ་བལྟས་ཙ་ན།",
    "དུས་དེང་སང་གནངས་ཀ་བལྟས་ཙ་ན།",
    "ཞེས་པ་ཡན་གྱི་ནང་དོན་རྣམས་ཕལ་ཆེར་འགྲིག་འདུག་ཀྱང་།",
    "ཕྱོགས་མཚུངས་ཤེས་པར་བྱ་བའི་གནས་སམ་རིག་པར་བྱ་བའི་གནས་ལ་ངོས་འཛིན་དགོས་པའི་སྐབས་ཀྱང་འདུག་པས།",
    "གུ་གེ་ནི་ཞང་སྐད་སྟེ་ཡི་གེ་ཞེས་པའི་དོན་ཡིན་པ་ལས་བོད་སྐད་ནི་མིན་ཚོད་དུ་འདུག་ཅིང་།",
    "༢ ཞེས་གུག་གུག་ལས་གུ་གེ་བྱུང་པར་འདོད་འདུག་ཀྱང་།",
    "ཨ་རབ་དང་དྲུ་གུའི་སྐད་རྙིང་རང་ན་ཡུལ་དེ་ལ་ཀར་ལུག་ཅེས་སུ་འབོད་ཀྱིན་འདུག་པས།",
    "༢༡ ཞེས་གསུངས་འདུག་པས།",
    "ལྟ་ད་༢༨་ ཝཝེར་སྐར་མ་རི་ལྔ་པར་༡༤༦༦ཉི་བརྩེ་བའིསཧཨཀརརཀྱང་སར་༨༣ ར་བ་ཧོར་༡༥༡༢ ༢ ཝཱར་བ་ཏེཏེ་༡༢ ༢ ༣ ༤ ༥༤༣ ༨༨༥ ཀ་༣ ར་༣ ཀྱི་༩༨༢༨་ ༣༡ ༨པིའི་༣་ ཏོཙ་ཚབྱར་ ༦༨ འ་༤ རཏི་༨རོངའ་༨༢ ༤་ ར་འི་༡ ཤར་བའིར་༢༣ སྤྱིཀ་ནཔ་༢༡ ཚེ་ཧིཨང་༥ ༤ ཛཱ་ཊར་ང་བསཔདེདུ་ཕྱིཏན་༤ བསེབན་༡༥ དུ་ཙ་༢ ཚེས་༢ འ་༨༨་པུར་༡༨༩༨ ༨༤༨ཟླར་གྱེར་༡༩༢་༤ ཕ་༨ དང་དཀར་ཝུའུ་༤ ཆང་རང་ཤེད་ཀྱི་བུ་",
    "བརྩེ་དགའི་སྦྲང་ཆར་བསྙིལ་ལ་སེར་སྣ་མི་འདུག།",
    "ཨ་ཇོར་ཞེ་འདང་ཆེ་བའི་གོམས་སྲོལ་འདི་དག།",
    "གལ་ལ་ཐུག་དུས་ཤིན་ཏུ་འཇིགས་སྣང་བྱེད།",
    "འཆི་བདག་དགྲ་ལ་ཐུག་དུས་བཀོལ་རྒྱུ་ལགས།",
    "ཁྱེད་རང་འདས་པའི་ཤུལ་དུ་མཆོད་མེ་ཞིག།",
    "ཨ་ཙི་ཨ་ཙི་ད་དུང་གཞན་ཡང་བཟོ་བཅོས་འདི་ཡི་འཇིགས་སྣང་ལ།",
    "གོ་ལ་ཧྲིལ་པོའི་བོན་པོ་ཡོངས་ཀྱིས་མགོ་བོ་བསྒུར་ནས་འདུག་ཐབས་བྲལ།",
    "དངུལ་གཉེར་པ་སེར་བརྒྱའི་སྐལ་བཟང་བཅས་བསྐོས་བཞག་མཛད་འདུག།",
    "གལ་སྲིད་སྐུ་མི་བཞུགས་པ་ཡིན་ན་རྗེས་སུ་ཇི་ལྟར་བགྱིད་ཀྱི་ཞལ་ཆེམས་སྩལ་བར་གསོལ་བ་འདེབས་པ་བཅས་གང་ཡང་བྱུང་མི་འདུག་སྟབས་རྗེས་ནས་བློ་འགྱོད་ཤིན་ཏུ་ཆེ་ཞེས་རྡོ་རྗེའི་མཆེད་ལྕམ་འགའི་ངག་ལས་ཐོས།",
    "ཁྱད་པར་རྫ་སྟོད་ཀྱི་ཨ་དོའི་གནས་རིར་བྱོན་ནས་དམ་པའི་བསྒྲུབ་ཕུག་དང་རང་བྱོན་རྣམས་མཇལ་ཞིང་ཟབ་གཏེར་ཆ་ཤས་སྤྱན་དྲངས།",
    "གདུལ་བྱ་རང་རང་དང་འཚམ་པའི་འགྲོ་དོན་མཐའ་རྒྱས་སུ་འབྱུང་།",
    "མཁའ་སྤྱོད་དག་པའི་ཞིང་སྣང་ལ་དཔའ་བོ་མཁའ་འགྲོ་དུ་མས་ཚོགས་ཀྱི་འཁོར་ལོ་རྒྱ་ཆེར་བསྐོར་བའི་ཚོགས་ཀྱི་དགའ་སྟོན་གྱི་སྐབས་སུ་ཁེལ་འདུག།",
    "ང་འདི་ནས་ལུས་བརྗེས་མ་ཐག་གཡུ་ལོ་བཀོད་པའི་ཞིང་དུ་འགྲོ་ས་འདུག།",
    "རྫུན་གཏམ་གྱིས་རོ་དེ་ཤེལ་དམ་ནང་འཛུད་རྒྱུ་ཙམ་ལས་མི་འདུག་ཅེས་འུད་སྒྲོགས་བྱེད་ཉ་རོ་ཞིག་ཤེལ་དམ་ནང་བཅུག་དཀའ་བས་དེ་འདྲ་རྫུན་གཏམ་ལ་མགོ་འཁོར།",
    "དེ་ནས་ང་རང་ཡང་ཁྲོ་སྐྱབས་དུ་སླེབས།",
    "ཉམས་ལེན་རྒྱུད་ལ་འབྱོར་ཚོད་གདའ།",
    "མ་ཟད་ལྷུམས་སུ་གནས་པའི་སྐབས་སུ་ངོ་མཚར་བའི་རྟགས་མཚན་བསམ་གྱིས་མི་ཁྱབ་པ་མང་དུ་བྱུང་འདུག་སྟེ།",
    "གཉིས་ལས་འོང་བར་མི་གདའ་སྟེ།",
    "ཁྱད་པར་སྐབས་སྐབས་སུ་མའི་ཉེ་ཕྱོགས་ཀུན་ཏུ་འོད་དམར་མེ་སྟག་ཕྲོམ་ཕྲོམ་བྱེད་པ་ཤ་སྟག་འོང་འདུག་པ།",
    "དེའི་ཉིན་ང་རང་དར་གཅིག་ཉལ་བའི་ཉམས་རྨི་ལམ་མ་ངེས་པར།",
