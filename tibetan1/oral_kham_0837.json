    "ཀླུ་ཐམས་ཅད་ཀྱང་རྡོ་རྗེ་གདན་གྱི་འདུག་སྟངས་ཀྱིས་གནས་པ་ཕྱག་བཞི་དང་ལྡན་པས་གཡས་པ་གཉིས་ན་བདུད་རྩིའི་བུམ་པ་དང་རྡོ་རྗེ།",
    "འདི་ལྟར་ཟླ་བ་ལ་སོགས་པའི་ལྷ་རྣམས་རྡོ་རྗེའི་གདན་གྱི་འདུག་སྟངས་ཀྱིས་གནས་པའོ།",
    "ལས་དང་རྗེས་སུ་མཐུན་པར་འདོད་པའི་ལྷའི་རྣལ་འབྱོར་གྱིས་སྲུང་བའི་ཆོ་ག་དང་བཟླས་པ་བྱ་ཞིང་མི་སྨྲ་བར་འཇམ་ཞིང་ཤིན་ཏུ་བདེ་བའི་སྟན་ལ་པདྨའི་འདུག་སྟངས་ཀྱིས་འདུག་ལ་སྲོད་ལ་ཁ་ཤར་དུ་བལྟས་ལ་བློས་བསྒྲུབ་བྱ་ལ་དམིགས་ནས་དཀར་པོའི་ཚེས་གཅིག་ནས་བརྩམས་ཏེ་ཞི་བའི་ཡིད་ཀྱིས་ཞི་བའི་ལས་བྱའོ།",
    "བཟང་པོའི་འདུག་སྟངས་ཀྱིས་འདུག་ལ་དགའ་བའི་ཡིད་ཀྱིས་ཁ་བྱང་དུ་བལྟས་ཏེ་ཉ་ནས་བརྩམས་ནས་སྔ་དྲོ་རྒྱས་པ་བྱའོ།",
    "མཐོ་ཞིང་བདེ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "སྟན་སྲབ་པ་ལ་ལྷོ་ཕྱོགས་སུ་བལྟས་ཏེ་འདུག་པའམ།",
    "ཕྱོགས་ཏེ་རྐང་པ་བཟློག་པས་འདུག།",
    "ཤིན་ཏུ་དགྱེས་ཤིང་རངས་པ་སྟེ།",
    "ཞེས་པས་ལྷ་དང་འཇིག་རྟེན་སྐྱོང་བ་དང་རང་ཡང་ཚིམ་པར་བྱའོ།",
    "འདི་དག་གཉིས་གང་ཡང་རུང་བ་བཅིངས་ལ་སྔགས་ལན་ཅིག་བརྗོད་ལ་འགྲོ་བའམ་འདུག་པས་ཀྱང་བཟླས་པར་བྱ་སྟེ།",
    "ཨོཾ་ཨ་ར་པ་ཙ་ན་མུ་ཞེས་བྱ་བ་ནི་བཟླས་པའི་སྔགས་སོ།",
    "ཨ་ར་པ་ཙ་ན་སཱ་དྷ་ནཾ།",
    "ཁ་བློ་བརྟན་ཞིང་གདམས་པས་དམ་པ་ཨ་ར་པ་ཙ་ན་ཡི་སྔགས།",
    "ཚིག་ལྷུག་པའི་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཐབས་སོ།",
    "ས་དྱོ་ཨ་ནུ་བྷ་བ་ཨ་ར་པ་ཙ་ན་སཱ་དྷ་ནཾ།",
    "དེ་དག་ཐམས་ཅད་ཡོངས་སུ་གྱུར་པ་ལས་རལ་གྲི་དང་པོ་ཏི་བསྣམས་པ་ཟུར་ཕུད་ལྔ་ལེགས་པར་འགྲིལ་བ་ན་བཟའ་དམར་པོ་ཟུང་ཅིག་བསྣམས་ཤིང་སྒེག་པའི་ཆ་བྱད་དང་ལྡན་པ་ཞལ་འཛུམ་པས་རྣམ་པར་རྒྱས་པ་ཟླ་བའི་འཚེར་བག་དང་མཚུངས་པར་མཛེས་པས་འདབ་མ་སྣ་ཚོགས་པའི་པདྨ་ལ་སྐྱིལ་ཀྲུང་ཕྱེད་པས་བཞུགས་པའི་འཕྲལ་དུ་ཉམས་སུ་མྱོང་བའི་ཨ་ར་པ་ཙ་ནའི་གཟུགས་སུ་བདག་ཉིད་ལེགས་པར་བལྟ་བར་བྱ་བའོ།",
    "ཨ་ར་པ་ཙ་ན་དྷཱི་ཞེས་བྱ་བའོ།",
    "དེ་ནས་དེ་ཁོ་ན་བཞིན་དུ་དབུགས་དེས་བསྐྱོད་པའི་ལྕགས་ཀྱུ་དང་བུང་བ་དེ་དག་ཀྱང་རང་ཉིད་ཀྱི་དབུགས་ཀྱིས་དེའི་སྣ་བུག་གཡས་པའི་བུ་གའི་ལམ་དུ་ཞུགས་པར་བལྟས་ལ།",
    "ཛྙཱ་ན་ཀཱ་ཡ་བཱ་གཱི་ཤྭ་ར་ཨ་ར་པ་ཙ་ན་མ་གྲངས་བརྒྱ་རྩ་བརྒྱད་དུ་མཚན་བརྗོད་པས་ཀྱང་མཚན་ཡང་དག་པར་བརྗོད་པ་དུས་ཇི་ལྟ་བར་བཀླག་པར་བྱ་བ་ཡིན་ནོ།",
    "སྤྲོ་བར་བྱ་བ་ལ་སོགས་པ་སྔོན་དུ་བཏང་ཞིང་དེ་ཡོངས་སུ་གྱུར་པ་ལས་ཡི་གེ་དྷཱི་དཀར་པོས་བསྐྱེད་པའི་འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན་དཀར་པོ་གཅིག་པུ་ཉིད་འབའ་ཞིག་གོ།",
    "དེའི་སྟེང་དུ་ཡི་གེ་ཨ་ར་པ་ཙ་ནའོ།",
    "ཁྱེད་རང་ལྟར་ན།",
    "ཉན་ཐོས་ཀྱི་ལམ་ཤེས་པའི་ལམ་ཤེས་དང་རང་རྒྱལ་གྱི་ལམ་ཤེས་པའི་ལམ་ཤེས་མི་འགལ་བྱས་པ་ལ་ཁ་ཅིག།",
    "གཞན་ཡང་རང་རྒྱལ་ཡིན་ན་འདོད་པའི་རྟེན་ཅན་ཡིན་པས་ཁྱབ་ཟེར་ན།",
    "ཐེག་ཆེན་གྱི་མཐོང་ལམ་ཤེས་བཟོད་སྐད་ཅིག་མ་བཅུ་དྲུག་དུས་མཐའི་སྐད་ཅིག་མ་ཡིན་ཟེར་ན།",
    "དེས་ཁོ་རང་རྟོགས་པའི་ཕྱིར།",
    "གཞན་ཡང་རང་རྒྱལ་སློབ་པ་འཕགས་པ་དེས།",
    "ལུང་མ་བསྟན་གྱི་ལྟ་བའི་དམ་བཅའ་ཚུལ་ལ་ཞིབ་ཏུ་བརྟགས་ན་མཐའ་གཅིག་ཏུ་འགྲོ་བ་དཀའ་བར་འདུག་པས་དཔྱད་པར་བྱའོ།",
    "ཡང་རང་དོན་དང་གཞན་དོན་གཉིས་སུ་ཡང་འགྱུར་ཏེ།",
    "ལུང་ཚིག་ཇི་བཞིན་མི་འདུག་ཀྱང་དོན་ཇི་ལྟར་བཞིན་སྣང་ངོ།",
    "རྡོ་རྗེའི་གདན་ལ་འདུག་ནས་ནི།",
    "རིག་ཅིང་རང་ཉིད་གྲོལ་བའི་བླམ་ཡིས།",
    "ཅིའི་བྱིང་ན་རང་མ་སྨིན་པས་གཞན་སྨིན་པར་མི་ནུས་ཤིང་རང་མ་གྲོལ་བས་གཞན་གྲོལ་བར་མི་འུས་པས་སོ།",
    "དེ་བཞིན་དུ་ཤར་ལ་སོགས་པའི་ཕྱོགས་རྣམས་ཀྱང་བློས་བཏགས་པཙམ་ལས་ངོ་བོ་ཉིད་ཀྱིས་གྲུབ་པམེདཔའི་དོན་རྟོགསན་ཕྱོགས་འཆོལ་ངའི་ཉེས་པའང་རང་བཞིན་གྱིས་ཁེགས་པ་ཉིད་དོ།",
    "རང་རང་རིགས་ཀྱི་མཚནམ་གདབ།",
    "༢ ལས་ཐམས་ཅད་པ་བཟླས་པའི་ཆུ་དང་སྔགས་ཀྱིས་དཀྱིལ་འཁོར་ལ་བསངས་ཤིང་བསྲུངས་ནས་རྡོ་རྗེ་དང་དྲིལ་བུ་འཛིན་པས་དཀྱིལ་འཁོར་གྱི་ཤར་སྒོ་ལ་ཕྱོགས་པས་འདུག།",
    "སྐུ་ལས་ཧ་ཅང་རང་ན་བསྒྲུབ་ཐག་རིང་།",
    "ལུས་ཀྱིའདུག་སྟངས་ངེས་པར་བརྩམས།",
    "ངོ་བོ་གཅིག་པའི་ཆ་ནས་སྡོམ་པར་ཡང་བཞག་ཏུ་རུང་བ་རྣམས་ཐོབ་བའི་མཆོམས་སྐབས་འདི་ཡིན་པས་ན་རང་རང་ལ་ལྟོས་པའི་ཡོན་ཏན་དང་།",
    "འཇུག་དུས་གཡོན་བསྐོར་དུ་གསལ་གདབ་པ་ཡིན་ཏེ།",
    "བཟའ་བཏུང་ལ་སོགས་པ་བསྟབས་ན་དགའ་བ་འདུག་གམ་བལྟ།",
    "སྣང་བ་དང་ཤེས་པ་འདི་དག་རྨི་ལམ་དུ་འདུག་སྙམ་པའི་འདུན་པ་དྲག་པོ་བར་མཆད་པ་བྱ།",
    "དེའང་རང་བཞིན་བརྒྱད་ཅུའི་རྟོག་མངེས་པ་སྟེ།",
    "སྐྱིལ་ཀྲུང་འདུག་དང་རྒྱབ་མི་བསྟན།",
    "སོ་སོ་རང་རང་རིགས་ཀྱིས་བསྐང་།",
    "འཕགས་པའི་ཡེ་ཤེས་ཀྱི་ཡུལ་ཏེ་ཡེནས་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་པའོ།",
    "ཟ་སྣོམ་འཁྱམ་དང་འེ་དང་འདུག་པ་དང་།",
    "སྣང་བ་སྣ་ཚོགས་རང་སྟོང་རང་ཡལ་དུཆ་ལལ།",
    "དེ་མིན་འགྲོ་བར་ནུས་མིན་ཏེ།",
    "དངོས་པོ་གཤིས་ཀྱི་འདུགཚུལ་ལ་ལྟོས་དང་།",
    "མ་ངས་རྒྱས་ཐམསཅད་གཡང་སར་འདུག་པ་ངོ་མཚར།",
    "ལས་སུ་བྱ་བྱེད་ང་བྲལ་བར་འདུག་པ་གཉིས་ལ།",
    "དགོངས་པའི་འདུག་ཚུལ་དེ་བཞིན་ནོ།",
    "དེའང་རང་བཞིན་མི་འགྱུར་བས་སྟོབས་སོགས་ཀྱི་ཡོན་ཏན་ཡེ་ལྡན།",
    "དེར་འདུག་གོ་སྙམདུ་ཡུལ་རྟོག་པའི་ཡུན་ལ་རྣམ་གྲོལ་གྱི་སྐད་ཅིག་མ་ཞེས་བྱའོ།",
    "སློབ་པ་ལམ་གྱི་གནས་སྐབསནའང་རང་གཞན་དོན་ལ་གཡེལ་དེ་སྦྲིད།",
    "༤༩༥། བསྐུར་བས་གཙོ་བོར་ལུས་ཀྱི་སྒྲིབ་བ་འདུག།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "ལུས་བྲེབས་འདར་ཤིང་བསྒྱུར་ནས་གུམ་གུམ་པོར་འདུག་པ།",
    "ང་རང་ཆ་ལུགས་འདི་ལ་གནས་ཏེ་གསང་སྔགས་ཀྱི་ཀུན་སྤྱོད་བྱ་སྙམ་དུ་དགོངས་པ་ལ།",
    "ཅེས་གསུངས་གདའ་བ་གསུངས་པས།",
    "གཉིས་སུ་ང་དང་མི་ཕལ་ཆེར་སྤྱོད་པ་ཡེ་རང་མི་མཐུན་པར་འདུག་པ་དེས་ལན་པ་ཡིན་ནམ་གསུངས།",
    "སློབ་དཔོན་འདི་འོ་སྐོལ་དཔོན་སློབ་ལ་སྡང་བ་རང་ཞིག་འདུག་བྱས་པས།",
    "ཐུགས་ལ་མི་འདོགས་དུས་ཙ་ན།",
