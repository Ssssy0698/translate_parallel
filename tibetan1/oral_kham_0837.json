    "མི་ཀུན་ཕྱག་བྱེད་ཀྱིན་འདུག་པ་ལ་ཡང་རྟོག་པ་མ་ཞུགས།",
    "ཁོང་རང་ཡང་ཕྲུ་བྱེད་ཀྱིན་ཆང་གསོལ་གྱིན་འདུག་མི་ལ་ལ་ཡང་བྱིན།",
    "ད་ཅིའི་མི་རྒན་ཕྲུ་བྱེད་པ་དེ་གདན་ཁ་གཅིག་ན་འདུག་པ་ཙུག་བྱའམ་སྙམ་པས་སྐྱེངས་པ་གཅིག་བྱུང་བ་དང་ཚམ་མེ་ལུས་པ་དང་།",
    "རྒྱགས་ཕྱེ་བསྐུར་ནས་ཕྱིན་ཙ་ན།",
    "ཡང་མ་བསྡད་པར་འོངས་ནས་གཞུང་དུ་བརྡོལ་ཙ་ན།",
    "དེར་སེར་བ་གཅིག་ཕབ་ཙ་ན་ལོ་འདར་འདུར་དུ་ཁྱེར།",
    "ང་རང་ཕྱི་གཟུང་བའི་ཐག་པ་རྩད་ནས་ཆོད།",
    "ཆང་ས་གཅིག་ན་བྲག་དཀར་སྤོ་མཐོན་ལ་མི་ལ་རས་པ་ཟེར་བ་གཅིག་བསྒོམ་གྱིན་འདུག་སྟེ།",
    "འོ་ན་ངའི་མིང་པོ་འདྲ་། བ་ཡིན་ནམ་སྙམ་ནས་བལྟར་འགྲོ་བ་དང་འགོ་བན་གཅིག་ཀྱང་འགྲོ་བ་དང་འཛོམས་ནས་ཕྱིན་ཙ་ན་མི་རིད་གཅིག་ངོ་མ་ཤེས།་",
    "ཡོན་བདག་བཟའ་མི་གཉིས་སྡུག་བསྔལ་གྱིས་ཟིན་ནས་འདུག་ཙ་ན།",
    "བྲག་གསེབ་ན་བཞུགས་པ་འདི་ལམ་ཡང་མི་བདེ་བར་འདུག་པས་ས་བདེ་བ་གཅིག་ཏུ་བཞུགས་པར་ཞུ་བྱས་པས།",
    "འདིར་མཐུན་རྐྱེན་མ་འཛོམས་ལ་ཉམས་མི་དགའ་བ་གཅིག་འདུག་པ་ལ།",
    "འབྲས་བུ་འཁྲུལ་ནས་འདུག་སྟེ་འཇིག་རྟེན་གྱི་ཆེན་པོ་གཅིག་ལས་མི་ཐོབ་པར་འདུག་པས་ད་ངས་ཅི་ཐོབ་ཀྱི་ཕྱུགས་ཀྱི་སྐལ་བ་རྣམས་རྗེ་བཙུན་མི་ལ་ལ་ཕུལ་བདུན་ཚིགས་ཞུས།",
    "པེ་ཏ་མ་ངོ་ནག་ཏིང་ངེ་འདུག་ནས།",
    "རང་སྣང་ཤེས་པ་དགའ་ཡིན་གདའ།",
    "དེར་ལོ་རས་སྤྱན་འདྲེན་དུ་ཕྱིན་ཙ་ན།",
    "བལ་བོད་ཀྱི་མི་འདུག་ཚད་ཞལ་བལྟ་བས་བསྐོར་ནས་ཡོད་ཟེར་བ་ལ།",
    "མི་ལའི་འཁོར་རྣམས་ཀྱིས་ཡོ་འགྲོ་ཡིན་འདུག་པའི་འོ་སྐོལ་ཡང་གཤེགས་སམ་བྱས་པས།",
    "ནངས་པར་ཙ་ན་ཤུལ་ཀྱང་མེད་པར་བདེ་ནས་འདུག་དེ་ལ་ཅི་མཛད་པས་བདེ་ཞུས་པས།",
    "ཡང་ཉིན་གཅིག་བྲག་རྩ་ན་ཐུགས་དམ་མཛད་ཀྱིན་བཞུགས་ཙ་ན།",
    "བཟའ་གཞན་མི་དགོས་པར་འདུག་གསུང་།",
    "ཡི་དམ་ལྷའི་ཞལ་མཐོང་བས་གྲུབ་ཐོབ་ཡིན་ཟེར་བྱས་པས་འོ་ན་གྲུབ་ཐོབ་མི་འདུག་གསུང་།",
    "དེར་གཟིམས་སྐྱོར་གློར་བལྟས་ཙ་ན།",
    "མེ་ཆ་གཅིག་དང་གྲི་གཅིག་འདུག་གོ།",
    "གདོན་གྱི་ཆོ་འཕྲུལ་ཡིན་ནམ་གསུངས་ནས་འདུག་ཙ་ན།",
    "དེར་ཇ་ཞོ་གཉིས་ཕྱག་རྟེན་རྒྱུ་ཁྱེར་ནས་ཉིན་ལམ་བཞི་བཅུ་ཕྱིན་ཙ་ན་བྲིན་སྙེ་ནམ་མཚམས་སུ་སླེབས།",
    "ཁྱེད་དུ་གདའ་ཟེར་བས།",
    "དགའ་རབ་འདུག་སྟེ་ལེགས་པར་བསྐྱང་ཡང་འབྲས་བུ་གཟུགས་མེད་ལྷ་གསུངས།",
    "ད་ལྟར་དྲོས་ཀྱིན་གདའ་སྟེ་དགུན་རྐྱང་དྲོས་སམ་ཞུས་པས།",
    "གླེང་སློང་བྱེད་ཀྱང་ཉམ་མི་ང་བར་འདུག་གོ།",
    "དེ་ནས་བདུད་བཞིའི་བར་ཆད་ཀྱིས་མི་ཚུགས་པར་འདུག་སྙམ་པར་བྱུང་གསུང་།",
    "གཉིས་ཀ་ན་འབྱོན་པ་ཞལ་གྱིས་བཞེས་ཀྱིན་འདུག་པས་གཉིས་ཀའི་རྟོག་པ་ལ་ཙུག་ཡིན་ནམ་སྙམ་ནས་ཡོད་ཙ་ན།",
    "ཁྲིད་མཛད་ཀྱིན་གདའ་སྐད།",
    "ངས་ནི་མི་ལ་བཟླས་ཀྱང་མི་ཡལ་བར་འདུག་རྟོགས་པའི་གནས་ལུགས་ལབ་ནས་སླར་ལ་ཕན་ཐོགས་ཆེ་བར་འདུག་སྟེ།",
    "ད་ལྟ་དོན་དམ་སྐྱེ་སླ་བར་འདུག་གསུང་།",
    "ཁོ་བོ་སྐྱེས་ཙ་ན་ཟོ་ཞབས་གཅིག་འདོན་པ་སྙམ་བྱེད་ཙ་ན།",
    "དེ་ནས་ཡུམ་གྱིས་ཆབ་འཆག་པ་ལ་མ་འདི་ང་ལ་ངོ་ཚ་མི་སྟེར་བར་འདུག་སྙམ་པ་བྱུང་བས་སྐྱེ་བ་སྔ་ཕྱི་དྲན་པ་ལ་སོགས་ཐམས་ཅད་བརྗོད་གསུང་།",
    "མདང་ངའི་རྨི་ལམ་དུ་མི་བུར་གྱི་ལུང་པ་ཁེབས་པའི་མི་ཆེན་པོ་གཅིག་ཞྭ་གནམ་ཙམ་གཅིག་གོན་ནས་བྱུང་བ་རྨིས་ཙ་ན།",
    "དེ་ང་རང་སྔར་ཤེས་པའི་གདམ་ངག་གསུང་དགོངས་ནས་བྲང་ཁང་དུ་བྱོན་ནས་ནང་དུ་གཟིམས།",
    "ལྟ་བ་ལྟ་རྒྱུ་ཐམས་ཅད་དང་བྲལ་བ་སྤྲོས་མེད་དུ་འདོད་པར་གདའ།",
    "དེ་ཙུག་བསླབས་པས་ཀྱང་བག་མི་འོང་པ་གཅིག་གདའ་བྱས་པས།",
    "དེ་ནས་གཙང་དུ་འཇིམ་གྱི་སྤྱན་སྔར་ཕྱིན་ཙ་ན།",
    "དེར་སྟོན་འཇམ་གྱིས་ཐོས་ནས་བྱུང་བས་ཁྱེད་ལ་ལས་སྒོམ་མ་སྐྱེས་པར་འདུག་ཟེར་གསུང་པ་ལ།",
    "ཁོ་བོ་སྒོམ་མ་སྐྱེས་པའི་རྟགས་ཅི་ཙུག་འདུག་ཟེར་བྱས་པ་ལ།",
    "རིགས་དྲུག་ལ་ཡང་སོ་སོར་རང་སྣང་དེར་འཆར་བ་གང་ན་ཡང་གསུངས་ནས་འདུག་ཞུས་པས།",
    "ཁོ་བོ་ལ་དེ་བརྒལ་ན་མཆི་བར་འདུག་སྟེ།",
    "ཕྱིར་ལ་འགྲོ་ཙ་ན་ཡང་རྒྱབ་གཏད་ནས་འགྲོ་མ་མྱོང་གསུང་།",
    "ཉང་རོ་རྩིས་ཀྱི་ལྷ་ཁང་དུ་ཞག་འགའ་བཞུགས་ཙ་ན།",
    "འགྲོ་མ་གཅིག་ཡིན་པར་འདུག་གསུང་།",
    "སྤྲང་པོ་གཞན་ལས་སྡུག་སྡུག་ལྟར་འདུག་པའི་ཕ་སྤད་གསུམ་བྱུང་བ་ལ།",
    "དེ་ནས་ངམ་ཤོད་པས་མི་གཉིས་གདན་འདྲེན་དུ་བཏང་ནས་འདུག་པ་ལ་བྱོན་དུ་མ་བཞེད།",
    "ཁོ་བོའི་ཕྱི་ན་སུ་ཡང་མ་འོང་པར་ཁྱེད་རང་རྣམས་དབྱར་འདིར་བཞུགས་ལ།",
    "སྲོག་ཆགས་དཔག་ཏུ་མེད་པ་གདའ་ཞུས་པས།",
    "ཡུམ་དགུང་ལོ་བཅུ་དགུ་ལོན་ཙ་ན།",
    "དེ་ནས་དགུང་ལོ་བཅོ་བརྒྱད་ལོན་པའི་དུས་སུ་ཐང་སྐྱའི་ལྷ་ཁང་དུ་རབ་ཏུ་བྱུང་དུ་བྲོས་ནས་བྱོན་ཙ་ན།",
    "ཞི་བྱེད་སྒྲོལ་མ་རྣམ་གསུམ་ཞལ་སྤྲོད་དུ་ཞུས་ཙ་ན།",
    "རྟ་སྒོར་བཏགས་ནས་བྲང་ཁང་གཅིག་དུ་བཞུགས་ཙ་ན།",
    "རྟ་འདི་སུའི་ཡིན་ཟེར་འདྲི་ཡིན་འདུག་པ།",
    "ལ་ཤས་ཀྱིས་སྤྱོད་ཚ་མགོ་བཙུན་གྱི་བུ་ཡིན་ཟེར་ནས་འདུག་པས།",
