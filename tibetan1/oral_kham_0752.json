    "མཐོང་ན་འཇིགས་པའི་སྒེར་གཅོད་མཁན་གྱི་ལྟེ་བ་ཞིག་ཏུ་འགྱུར་གྱི་མི་འདུག་གམ།",
    "ངོ་མཚར་ཞིག་བསྐྲུན་འདུག་ཟེར་དོན་དེ་ཡིན།",
    "རྩོམ་དེ་ཡག་པོ་ཞིག་བྲིས་འདུག་ཚོགས་ནང་བསམ་བློའི་སྟོབས་ཤུགས་དེ་གཉིས་ཀ་ནི།",
    "ཏརྐཛཱལ་རྟོག་གོ་ཡི་མི་འདུག་རྟོག་གེ་འབར་མཇུག་ཐོགས་སུ།་",
    "རྩ་མི་ལོ་ཙཱ་པ་ཞེས་པའི་རྩ་མི་ནི་ས་མིང་ཞིག་ཡིན་སྐད་འདུག་པས་དེ་ནས་འཁྲུངས་པར་གྲགས་ལ།",
    "མི་གཞན་གྱིས་ཤེས་ཀྱི་མི་འདུག་པས།",
    "བསྟན་བཅོས་བོད་ཡིག་ཏུ་བསྒྱུར་པའི་པ་འཕྲིན་ལས་བསྐྱངས་འདུག་ཇོ་བོ་རྩ་མིར་ཆཕྱག་ལས་ནི་གཅིག་མཚུངས་སུ་གནང་ཡོད།",
    "ཡས་དེང་སང་སོགས་ཀྱི་ཐོག་ཏུ་ཞོན་ཙང་སྐོར་ལ་འཆད་ཁྲིད་བརྙན་ཞིག་ཀྱང་བཟོས་འདུག་དེར་མ་ཟད།",
    "རྒྱ་གར་གྱི་ནཱལེནྡྲའི་དགོན་ཞོན་ཙང་རྒྱ་གར་དུ་ཕེབས་པའི་དངོས་བཤུས་གློག་ཤུལ་དུ་ཞོན་ཙང་རྗེས་དྲན་ཁང་ཞིག་ཀྱང་བཞེངས་ཡོད་སྐད་འདུག་པས།",
    "དེ་མེད་པ་ནི་མུན་པ་སོགས་འདུག་པས།",
    "བོད་འགྲེལ་རང་དུ་སྣང་ལ་བར་བར་དུ་ཚིག་གསལ་རྒྱ་སྐད་དུ་བྲིས་འདུག་གོ་ཞེས་བྱུང་།",
    "བོད་ཀྱི་ལོ་ཙཱ་པ་ཚོས་བསྒྱུར་པ་ལ་ཞུ་དག་བྱས་པའི་གསུང་ཚིག་དེ་འདྲ་ཡང་ནང་དུ་ཡོད་པར་འདུག་དོཧྭཀོཥ་ཊཱིཀ་མ་ཚང་བ།",
    "བོད་ཡིག་ཏུ་བསྒྱུར་ཚེ་ཡིག་ཚོགས་ཇེ་མང་དུ་ལྡབ་ཀྱིས་འགྲོ་ཡི་ཡོད་འདུག་སྤྱིར་བསྒྱུར་དེ་བསྒྱུར་བྱ་ལས་མང་རྗེས་འགྲེལ་རྣམས་ཡི་གེ་འོག་མའི་མགོར་བརྩེགས་ཤིང་།",
    "ཀློག་ཚེ་འབྲུ་གཅིག་ལས་མེད་ཀྱང་འབྲི་དུས་སྔོན་འཇུག་རྗེས་འཇུག་མང་པོ་ཞིག་སྤུངས་ན་ཡི་གེ་གསུམ་བཞི་ཙམ་གྱི་རིང་ཐུང་ཆགས་འགྲོ་བ་ལྟ་བུས་ཀྱང་ཇེ་རིང་དུ་འགྲོ་ཡི་འདུགཤོར་བ་ནི་མིན་པ་འདྲ་སྟེ།",
    "ཀློག་དུས་ལེགས་སྦྱར་གྱི་སྐད་ཡིན་ལ།",
    "ཡིག་མཁན་གྱིས་ནོར་བ་ཡིན་མིན་སོགས་ལ་བརྟག་དགོས་པར་འདུག་གཅིག་བྱས་ན་གཉིས་ཀས་ནོར་མེད་སློབ་དཔོན་ཐོགས་མེད་ཀྱིས་མཛད་པའི་སུམ་ཅུ་པ་ཞེས་པའི་གཞུང་བོད་དུ་མ་འགྱུར་བ་ཞིག་ཡོད་ཀྱང་སྲིད།",
    "སྔར་མ་བསྒྱུར་པའི་ག་གཞན་དག་ཀྱང་བསྒྱུར་ནས་ཁ་གསབ་གནང་སྐད་འདུག་བྱུང་མེད་པ་འདྲ་སྟེ།",
    "བོད་ཀྱི་མཁས་པས་བརྩམས་པ་ལ་དེ་མ་དོན་ཡིན་འདུག་ཅེས།",
    "སོགས་ཡིན་ཡང་ཆ་ཚང་དྲན་གྱི་མི་འདུག་གང་ལྟར་བོད་ཀྱིས་འབྲི་བཞིན་པའི་སུམ་རྐང་དང་།",
    "ཞ་ལུ་ནས་ཉེ་ལམ་བརྒྱུད་ན་ཉིན་ཕྱེད་ཙམ་གྱི་སར་འདུག་ཅེས་ཏེ།",
    "དེ་ནས་རིམ་གྱིས་གདན་ས་ངོར་དུ་བྱོན་འདུག་མཁས་གྲུབ་ཆེན་པོ་ཀུན་བཟང་བ་བ་ཞེས་པ་ནི་ངོར་ཆེན་ཀུན་དགའ་བཟང་པོ་ཡིན་ཞིང་།",
    "པོ་བཞུགས་ཡོད་འདུག་གདན་ས་ངོར་དུ་སླེབས་པ།",
    "ས་འདིར་ཕེབས་དུས་ནི་ཁོང་ན་ཚོད་སྨིན་པའི་རྗེས་སུ་ཡིན་པར་འདུག་དགུང་ལོ་ཉེར་དྲུག་ཐོག་ཨེ་ཝཾ་དགོན་འདིར་བྱོན་པ་ཡིན་ལ།",
    "ནོར་འདུག་ཟེར་བ་དང་།",
    "ཁ་དན་ཚིག་ལ་གནས་ཀྱི་མི་འདུག་ཟེར་བ་ལྟ་བུ།",
    "རྣམས་འདུག་པར་མཇལ།",
    "བོད་དཔེ་རྣམས་ཅི་བས་ཀྱང་སྤུས་ལེགས་ལ་གྲས་མཚུངས་པ་རྐྱང་འདུག་འདིར་རྒྱ་དཔེ་པོད་ཆེ་ཆུང་བཞི་བཅུ་ལྷག་བཞུགས་པར།",
    "མཐོང་ཐུབ་ཀྱི་འདུག་ཟེར་བ་ཡིན།",
    "དོན་དངོས་སྟེང་གནས་ལུགས་ཆེན་པོ་འགའ་ཞིག་ཧ་གོ་མི་འདུག་སྟེ།",
    "ལ་ལར་བློན་པོའི་ཚུལ་འཛིན་པ་སོགས་མའདུག་འགྲོ་མགོན་འཕགས་པས།",
    "བྱ་བ་བོད་ཡིག་དབུ་ཅན་ཤིན་ཏུ་ཡིད་འཕྲོག་པའི་གཟུགས་སུ་བྲིས་ནས་འདུག་ས་བཟང་པཎ་ཆེན་གྱི་ཕྱག་བྲིས་ཡིན་མཆིས།",
    "གཞུང་འདི་ནི་ཤིན་ཏུ་གལ་འགངས་ཆེ་བ་ཞིག་དེ་ལྟར་ངོར་དུ་དྷརྨཔད་ཡི་རྒྱ་དཔེ་ཐོར་བུ་ཞིག་རྙེད་འདུག་ལ།",
    "འགྱུར་ཧ་ཅང་ལེགས་ཤིང་ཚིག་དོན་གཉིས་ཆ་ནས་ཡིད་འཕྲོག་པ་ཞིག་འདུག་པས།",
    "རྗེ་ཙོང་ཁ་པ་ཆེན་པོ་ལ་ལམ་དམན་པར་ཞུགས་པ་ཟེར་ནས་མི་འོས་པའི་ངན་སྨྲས་བྱེད་ཀྱི་འདུག་གསུངས།",
    "ལྟ་བ་བོར་ཞིང་སྤྱོད་པ་འཆལ་བའི་རིགས་ལ་དག་ཐེར་ཞིག་མ་བྱས་ཐུ་མེད་འདུག་ན།",
    "ཡག་པོ་འདུག་ཁྱེད་པཎྜི་ཏ་གདན་ལོ་ཙྭ་པ་དེ་ཉིད་རྒྱ་གར་དུ་ཕྱིན་ནས་པཎྜི་ཏ་སྨྲི་ཏི་ཛྙཱན་ཀིརྟི་དང་།",
    "འོན་ཀྱང་ད་ནི་བརྗེད་ཟིན་པས་སྤུས་དག་ཅིག་དྲན་གྱི་མི་འདུག་གང་ལྟར་སྨྲིཏི་ཛྙཱན་ཀིརྟི་བོད་ལ་དེ་ལྟར་དེ་ལྟ་ན།",
    "ལོ་ཆེན་རིན་ཆེན་བཟང་པོ་དགུང་ལོ་བརྒྱད་ཅུ་གྱ་ལྔར་ཕེབས་འདུག་པས།",
    "བྱིས་པ་དེ་དག་ནི་བྱིས་པ་འདུགས་པ་གཞན་མང་པོའི་གྲས་ནས་བློ་རྣོ་མི་རྣོ་བསྡུར་ཏེ་བདམས་པ་ཡིན་པར་མ་ཟད།",
    "དེ་དུས་རྒྱ་གར་ན་ཧ་ཅང་སྐད་གྲགས་ཆེ་བར་འདུག་ཤར་སྒོ་ན་ཤནྟི་དབུས་ཀྱི་ཀ་བ་གཉིས་དང་ཕྱོགས་བཞིའི་སྒོ་སྲུང་བཞི་བཅས་དྲུག་པོ་བ་སྟེ།",
    "མཁས་པ་འདི་འདྲར་ཆགས་འདུག་ནའང་།",
    "འབྲོག་མི་པོ་རྒྱ་སྐད་ཀྱིས་འདོན་ཐུབ་ཙམ་མ་གཏོགས་ཅི་ཡང་མི་ཤེས་པར་འདུག་པས།",
    "གོ་ལྡོག་ལྟ་བུ་ཞིག་བྱེད་ཀྱི་འདུག་སྙམ།",
    "པཎྜི་ཏ་རྣལ་འབྱོར་ཟླ་བའི་ཕྱག་བྲིས་རྣམ་འགྲེལ་རྒྱན་གྱི་རྒྱ་དཔེ་ཤོག་བུ་ལ་བྲིས་པ་ཆ་ཚང་ཞིག་འདུག་ཅེས་ཏེ།",
    "དེར་པཎྜི་ཏས་རྒྱ་དཔེ་མང་དུ་རྙེད་འོང་བར་བསམ་ནས་གྲོགས་བཅོལ་ཏེ་ཉིན་གཉིས་གསུམ་བཙལ་ཡང་དཔེ་ཁང་དེའི་ནང་ན་པོད་དེ་གཅིག་པུ་ལས་མི་འདུག་ཅེས་ཏེ།",
    "སྣང་བྱུང་བ་སོགས་ཐུགས་སྐྱོ་བའི་ཚིགས་བཅད་གཉིས་བྲིས་འདུག་གསུངས།",
    "ཁ་ཆེ་པཎ་ཆེན་འཁོར་རུ་འཁོར་རྣམས་ལ་ཞབས་ཏོག་ཡག་པོ་མ་ཞུས་པས་དེ་དག་སེམས་མ་སྐྱིད་པ་ཡིན་འདུག་པ་དང་།",
    "འདུག་པས་གནས་ཚུལ་དེ་བདེན་པར་ངེས།",
    "དེ་ལ་ངོ་མཚར་རྒྱུ་ཅང་མི་འདུག་གསུངས་པ་ན།",
    "མི་དེ་ནི་མ་ཧཱ་བཛྲ་དངོས་སུ་འདུག་པས་ཕྱག་ཅིག་འཚལ་བ་ཡིན་གསུངས།",
    "དཔེ་དེ་གཉིས་ལེགས་སྦྱར་གྱི་ཡི་གེ་ནི་མིན་པར་འདུག་གཅིག་ན།",
    "རྣམ་འགྲེལ་རྩ་བ་མ་ཚང་བ་ཞིག་རྙེད་པས་དེ་དཔེ་བཤུས་བརྒྱབ་པ་ཞིག་རྒྱ་གར་དུ་འབྱོར་འདུག་གསུངས་པས།",
    "གླིང་རྩོད་རིགས་ཀྱི་འགྲེལ་པ་མཁན་ཆེན་ཞི་བ་ཐུང་ཞིག་འདུག་པར་པཎྜི་ཏས་ངོ་བཤུས་བྱས།",
    "མཛད་པའི་རྒྱ་དཔེ་སྣ་ཐུང་ཞིག་འདུག་པས།",
    "དེ་ཡང་པཎྜི་ཏ་ར་ཧུ་ལས་དེར་བརྒྱད་སྟོང་མཚན་བརྗོད་སོགས་ཀྱང་འདུག་བོད་དཔེ་དཀོན་ངོ་བཤུས་བྱས་འདུག་གསུངས།",
    "དེ་དུས་སྦ་བཞེད་ཞབས་བཏགས་མ་ནི་དཀོན་པོ་ཡིན་པར་འདུག་ནའང་།",
    "བཙན་པོ་དར་མའི་རྗེས་ནང་དོན་ནི་རྒྱས་བསྡུས་ཙམ་ལས་གཅིག་པ་ཡིན་པར་འདུགསུ།",
    "ཅེས་གསུངས་འདུག་པས།",
    "དེར་ངོ་མཚར་ཆེ་བ་རྡོ་རྗེ་གདན་གྱི་མཆོད་རྟེན་སོགས་དགོན་གནས་ཡོངས་རྫོགས་གྱི་བཀོད་པ་རྡོ་ནག་དང་ཙནྡན་དཀར་པོ་ལས་བྱས་པ་ཁ་ཐོར་ཆ་གཉིས་འདུག་ཅེས་ཏེ།",
    "སྣར་ཐང་དུ་ཁོང་ལ་དོ་སྣང་འདྲེན་པའི་གནས་བཟོས་པ་ཁ་ཐོར་ཆ་གཉིས་ཡོད་པ་དེ་ཡིན་འདུགཚུལ་གཞན་ཞིག་བྱུང་བ་ནི།",
    "ཆེ་ཙམ་ཡིན་ན་ག་ཡའི་བརྒྱུད་ཀྱི་རྡོ་ནག་གྲགས་ཅན་དེ་ག་རང་དུ་འདུག་ཅེས་པའོ།",
    "སྔར་མཆིམས་ནམ་མཁའ་གྲགས་སམ་མཆིམས་འཇམ་དུ་བཟོས་པ་མིན་འདུག་བཟོས་པ་དང་།",
    "ཡང་ན་ཅི་ཞིག་ཡིན་དཔྱད་དགོས་པར་འདུགསྦྱར་གྱི་དཔེ་རྙིང་བཞུགས་ས་ཨང་དང་པོ་གང་ཡིན།",
    "ཀཎགོམིས་མཛད་པའི་འདུག་ཅིང་།",
    "ངུ་ངག་ཅིག་འདོན་རྒྱུ་ལས་ཐབས་མི་འདུག་ཟེར།",
    "ཡུལ་དེའི་ཆུ་འགྲམ་བྱང་ངོས་ན་གྲུབ་ཐོབ་གཅེར་བུ་རྣམས་ཀྱི་རྒྱལ་ས་ཆེན་པོ་ལ་སྟོད་རྒྱལ་གྱི་ཧྲཱི་བྱ་བའི་གྲགས་ཆེན་དེ་འདུག་ཅེས་བྱུང་།",
    "མཐོང་ནས་དྲུང་དུ་སླེབས་ཙ་ན།",
    "རང་རང་ས་ནས་མཁྲེགས་འཛིན་བྱས་ཏེ།",
    "གདན་ས་ཡིན་གསུངས་འདུག་གཏམ་རྒྱུད་གསེར་ཐང་ནང་ལ་འདིའི་ད་ནི་དཀྱུས་ལ་འཇུག་ན།",
    "པའི་ལམ་སོགས་རིགས་མང་པོ་ཞིག་གསུངས་འདུག་དེའི་ཕྱིར་ན།",
    "རྒྱ་གར་དུ་ཚ་བ་ཆེ་དྲགས་པས་མི་རྣམས་ཚ་བའི་ཁྲོད་འདུག་མ་བཟོད་པར་ནགས་སུ་བྲོས་རྗེས།",
    "ནགས་བསམ་སྣ་ཚོགས་རྙེད་འདུག་ཅེས་ཀྱང་སྨྲ་ཡི་ཡོད་ཚོད་དེ།",
    "ཡོན་ཏན་ཆེན་པོ་མི་འདུག་ཟེར་སྐྱེ་བོ་ཕལ་པ་རྣམས་ལ་ཆེ་གསུང་སྟངས་དེ་ནི་འགྲིག་པར་སྙམ་སྟེ།",
    "འདིར་ས་ཞིག་ཆད་འདུག་པས་རིམ་གྱིས་བལ་ཡུལ་དུ་སླེབས་ཟེར་དགོས།",
    "རྒྱ་གར་ནས་ཚུར་བལ་ཡུལ་ལ་མཇལ་དུ་ང་མཁན་མང་པོ་འདུག་ཀྱང་།",
    "ལག་པ་ལ་ལག་སོགས་བོད་སྐད་གསར་པ་ཞིག་དང་མཚུངས་པ་ལྟ་བུ་ཞིག་ཏུ་གསུངས་འདུགརིགས་རྒྱུད་ཀྱིས་བལ་ཡུལ་མ་བཟུང་ཡར་སྔོན་གྱི་གནའ་བོའི་བལ་སྐད་ནི།",
    "སྲོང་བཙན་སྒམ་པོའི་སྐུ་ཚེའི་སྨད་ཙམ་ནས་བཟུང་བལ་ཡུལ་བོད་ཀྱི་མངའ་ཁོངས་ཡིན་པར་འདུག་ཐེངས་ཤིག་ལ།",
    "ཡང་མཚར་འདོད་ཀྱི་ཚིགས་བཅད་དུ་བྲིས་པ་རགས་ཙམ་ཞིག་ཡོད་ཅེས་གསུངས་འདུག་ཀྱང་།",
    "བོད་སྐད་དུ་གསེར་རྒྱལ་བྱ་བ་དེ་དང་མཇལ་ཕྲད་བྱུང་འདུག་ཅིང་།",
    "དེའི་ཐད་དུ་བོད་ཀྱི་ལོ་ཙཱ་པ་རྣམས་ཀྱིས་ཁྱི་ཤ་ཟོ་ཞེས་བསྒྱུར་འདུག་པ་ལ།",
    "མུ་འ་མི་བཟའ་བར་འདུག་པས།",
    "འོན་ཀྱང་ཞོ་ལྟ་བུའི་ཀླད་པ་ཁོ་རང་བེམ་པོ་ཡིན་པས་ཤེས་པར་ག་ལ་མུ་སྟེགས་ཀྱི་པཎྜི་ཏ་དེ་ཉིད།",
    "གཙོ་བོ་ཀླད་པའི་ནང་དུ་གནས་པ་ཚན་རིག་པས་ཤེས་ཀྱི་འདུག་ལ།",
    "ལེགས་སྦྱར་གྱི་ཚིགས་བཅད་རྣམས་དབྱངས་འདར་སྐྱོར་ཚེ་ཡིད་གཡོ་ནུས་པ་ཞིག་འདུག་ཅེས་ཏེ།",
    "ཀྱང་རྣམ་འགྲེལ་ཤེས་ཀྱི་འདུག་སྙམ་དུ་ཧ་ལས་ཡོད་ནའང་བོད་ལ་ནི་དེ་ཧེམ་རཱ་ཛས་ཁོང་གཡོག་པོ་ཕལ་པ་ཞིག་ཏུ་བརྩིས་ཡོད་པས།",
    "བལ་ཡུལ་དུ་སྔོན་ཆད་ནང་པའི་བསྟན་པ་ཧ་ཅང་དར་མྱོང་འདུགཡུལ་ཡང་བོད་བཙན་པོའི་མངའ་ཁོངས་སུ་ཡུན་རིང་སྡོད་དགོས་བྱུང་ཞིང་།",
    "གཟུགས་ཅན་དུ་གྲུབ་པའི་ཀླད་པ་ཁོ་རང་ཤེས་པ་པོ་ཇི་ལྟར་ཞེ་ན།",
    "ཡུལ་དཔོག་པའི་ནུས་པའི་ལྟེ་བ་ཀླད་པར་གནས་པ་ཡང་ཁས་བླངས་འདུག་ཀྱང་།",
    "གཟུགས་ཅན་རགས་པ་སྟེ་ཞོ་ལྟ་བུའི་ཀླད་པ་ཁོ་རང་ནི་ཤེས་པ་ཡིན་མི་སྲིད་ཟེར་བས།",
    "འོན་གནའ་རབས་ཤར་ཕྱོགས་ཀྱི་མཚན་ཉིད་རིག་པའི་ལྟ་གྲུབ་ཀྱི་སྲོག་ནི་བརྟན་པོར་འཛིན་ཐབས་ལ་བརྩོན་གྱི་འདུག་ཁོང་རྣམ་གཉིས་ཀྱི་ཁ་བརྡ་ཐུང་ངུ་དེའི་ནང་།",
    "ཤེས་པ་གཟུགས་སུ་གྲུབ་མ་གྲུབ་ཀྱི་དོགས་པ་བསླངས་འདུག་པ་དེ་ནི།",
    "ས་སྐྱ་རུ་རྣམ་འགྲེལ་ལེའུ་དང་པོའི་རང་འགྲེལ་ཁ་མ་ཚང་བ་ཞིག་རྙེད་ཀྱང་རྩ་བ་རྙེད་མི་འདུག་འོན་ཀྱང་ར་ཧུ་ལས་བོད་ནས་གདན་དྲངས་པའི་རྣམ་འགྲེལ་རྩ་བ་ཞིག་ཕྱི་རྒྱལ་དུ་དཔར་བསྐྲུན་བྱས་ཚུལ་གསུངས་པར་དཔྱད་ན།",
    "ལི་ཡུལ་ནི་བོད་ཀྱི་བྱང་ཕྱོགས་སུ་ཡོད་ཀྱང་རང་སྐད་ལ་ཀུསྟན།",
    "ད་ལྟ་ནི་ཏུར་ཀིསྤྲིན་ཞེས་འབྲི་ཡི་འདུག་ཅིང་།",
    "རྒྱ་ནག་གཉིས་བར་ལ་འབྲེལ་བ་བྱུང་དུས་ནི་ཧན་རྒྱལ་རབས་ཀྱི་སྐབས་སུ་ཡིན་འདུག་ཧན་རྒྱལ་རབས་ལ་ཧན་ནུབ་མ་དང་ཤར་མ་གཉིས་ཡོད་པ་ལས།",
    "ཚོང་ལམ་མམ་རྒྱ་སྐད་དུ་ཞེས་པའི་ལམ་ཐག་ག་རིང་པོ་ཞིག་ཁོ་ཚོས་འདེད་ཀྱི་འདུག་སྔར་གྱི་དར་གོས་ཀྱི་ཚོང་ལམ་དེ་རུ།",
    "ད་ལྟ་ཡང་ཞི་ཅིན་ཕེན་གྱིས་བསྐྱར་དུ་ཚོང་ལམ་ཆེན་པོ་ཞིག་འབྱེད་དགོས་ཟེར་གྱི་འདུག་སྤྱིར་དར་ཟབ་ཀྱི་ཚོང་ལམ་ལ།",
    "ཚོད་འདུགགང་ལྟར་རྗེས་སུ་དུས་རབས་བཞི་པའི་ནང་ཙམ་ལ།",
    "མན་ཇུའི་གོང་མ་ཆན་ལུང་སྐབས་བཏགས་པ་ཡིན་འདུག་ལ།",
    "འབྲས་སྤུངས་སུ་ཕེབས་པ་ཡིན་འདུག་པས།",
    "ལི་ཡུལ་ནི་སོག་པོའི་ཡུལ་ཡུལ་དེའི་མི་རྣམས་ཀྱང་སོག་པོ་ཡིན་པར་སྨྲས་འདུག་ནའང་།",
    "གཙང་སྤུས་ལེགས་ཤིག་བཤུས་འདུག་པས།",
    "འབྲས་བུའི་གནས་སྐབས་ཀྱང་རང་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པའི་དབྱེ་བས་རྣམ་པ་གཉིས་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱུ་རྣམས་ཀྱི་ཞེས་བྱ་བ་ནི་ཚིག་རྣམས་ཀྱིའོ་ཞེས་དེ་ལྟར་དྲན་པའི་སྐྱེས་བུ་ནི་ངེས་པར་སྦྱར་བར་བྱ་བ་ནི་མངོན་དུ་ཕྱོགས་པ་ལ་འདུག་པ་ཞེས་སྦྱར་རོ།",
    "སྔར་དམིགས་པའི་དུ་བ་དང་རང་བཞིན་མཚུངས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "ངེས་པར་བརྗོད་པར་འདོད་པ་གང་ཡང་རང་ཁོ་ནས་ཞེས་ངེས་པར་བཟུང་བ་མ་ཡིན་གྱིས་འོན་ཀྱང་མཐོང་བ་ཁོ་ནའོ་ཞེས་སོ།",
    "གཞན་གང་རང་བཞིན་གཞན་གྱིས་སྟོང་པའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་མ་ངེས་པ་ཉིད་དུ་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "ཐ་དད་པ་ཞེས་བྱ་བ་ནི་མདུན་ན་འདུག་པའི་རྣམ་པ་ཅན་ལས་རྣམ་པ་ཅན་གཞན་པའོ།",
    "གལ་ཏེ་མདུན་ན་འདུག་པ་རྣམ་པ་དང་ལྡན་པ་རྣམ་པ་བཟུང་བ་ན་རྣམ་པ་དང་ལྡན་པ་གཞན་གྱིས་འཛིན་ན་དེའི་ཚེ་རྣམ་པ་དང་ལྡན་པ་གཞན་ལ་གནས་པའི་རྣམ་པ་ཡང་མ་བཟུང་བར་འགྱུར་རོ།",
    "གང་ལ་ལྟོས་ཏེ་སྣང་བཞིན་པ་མདུན་ན་འདུག་པའི་རྣམ་པ་ཐ་དད་པར་འགྱུར་སྙམ་ན་རྣམ་པ་དང་ལྡན་པ་གཞན་དང་།",
    "གཞན་གྱི་རྟོགས་པ་ཡང་རང་ལ་གྲུབ་པའི་རྟགས་ཀྱིས་རྗེས་སུ་འབྲང་བ་ཁོ་ནའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཞན་གྱི་ཐག་རིང་ན་འདུག་པ་ཞེས་སྨྲས་སོ།",
    "གལ་ཏེ་བསྟན་བཅོས་བྱེད་པའི་འདོད་པ་ཡང་རང་ཉིད་སྨོས་པས་སྟོན་པ་ཡིན་ན།",
    "དེས་ན་རྟོག་པ་སྔོན་དུ་བྱེད་པ་མ་ཡིན་པར་འཇུག་པའི་དོན་དུ་ཡང་རང་ཉིད་སྨོས་པ་དོན་མེད་དོ།",
    "དེའི་ཕྱིར་རྟོག་པ་གཉི་ག་ལ་ལྟོས་ནས་ཀྱང་རང་ཉིད་སྨོས་པ་དོན་མེད་པ་ཁོ་ནའོ།",
    "འོན་ཀྱང་རང་བཞིན་དང་འབྲས་བུ་དང་དེ་དག་བརྙན་མའི་དབྱེ་བས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་དུ་འདི་ཡང་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འདོད་པའི་སྒྲས་བརྗོད་པར་བྱ་བ་འདི་ཡང་རང་རིག་པ་ཁོ་ན་ཡིན་ནོ།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་པར་བྱ་བའི་རུང་བ་ཉིད་དེ་ལས་ཐ་སྙད་དུ་བྱ་བ་མ་ཡིན་པ་དེ་བས་ན།",
    "གལ་ཏེ་ཐམས་ཅད་ཀྱི་ཚེ་སྤྱི་ཁྱད་པར་ཉིད་ཡིན་ན་དེའི་ཚེ་གོང་བུ་རྒྱང་རིང་པོ་ན་འདུག་ཀྱང་།",
    "དེ་ལྟ་ཡིན་དང་སྲང་དམའ་བའི་ཁྱད་པར་དུ་འགྱུར་རོ་ཞེས་བྱ་བའི་ཉེས་པ་སོ་ན་འདུག་གོ།",
    "འདིས་ནི་འདུག་པར་ཡང་མི་བྱ་འགྲོ་བར་ཡང་མི་བྱ་ཞེས་བྱ་བའི་ཚུལ་བསྟན་པ་ཡིན་ནོ།",
    "བླ་འོག་ཏུ་ཞེས་བྱ་བ་སྟེ་དངོས་པོ་མེད་པ་འོག་ཏུ་གནས་པའི་སྟེང་ན་དངོས་པོ་འདུག་པར་རྟོགས་པ་ནི་མེད་དོ།",
    "གསལ་བའི་རང་བཞིན་ལས་ཐ་དད་པ་དང་ཐ་མི་དད་པ་དག་ཏུ་སྣང་བའི་ཕྱིར་སྤྱི་དང་རང་བཞིན་གཉི་ག་ཡིན་ནོ་ཞེས་དོགས་པ་ནི།",
    "དེའི་འོག་ཏུ་ཡང་རང་བཞིན་གཉིས་པའི་སྤྱི་གཞན་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་འོ་ན་སྤྱི་དེ་ཡང་རང་བཞིན་གཉིས་པ་ཡིན་པའི་ཕྱིར་དེ་ལ་ཡང་སྤྱི་གཞན་འཕྱོ་བར་འགྱུར་རོ།",
    "འོན་ཀྱང་རང་བཞིན་ཁོ་ནས་ཁྱབ་པ་ཡིན་ནོ།",
    "དེ་ཡང་རང་བཞིན་གཞན་ཡིན་པ་ནི་སྒྲའི་རང་བཞིན་གཞན་ཡིན་པའོ།",
    "འབྱུང་ཁུངས་མ་ཡིན་ནོ་ཞེས་ཟུར་ན་འདུག་པའི་རྩོད་པ་བརྗོད་པ་ནི་གལ་ཏེ་ཞེས་བྱ་བའོ།",
    "གལ་ཏེ་སྒྲོ་བཏགས་པ་མི་བདེན་ཡང་རང་བཞིན་མེད་པར་སྒྲའི་དོན་ཅི་ལྟར་ཡིན་ཏེ།",
    "མེ་ལ་སོགས་པའི་ཚོགས་པ་དུ་བ་སྐྱེད་པར་བྱེད་པ་གང་ཡིན་པ་དེའི་དུ་བ་སྐྱེད་པའི་རང་བཞིན་དེ་ཉིད་གལ་ཏེ་འཁྲུལ་པའི་ཡུལ་དུ་འདོད་པ་གཞན་གྱིས་ཡང་རང་བཞིན་ཡིན་ན།",
    "རྟགས་དུ་བ་ལས་རྟོགས་པ་ཡང་རང་བཞིན་དེ་ཉིད་ཀྱིས་ཡིན་ཏེ།",
    "གྲུབ་པའི་མི་དམིགས་པ་དེས་ཀྱང་རང་ཉིད་ཙམ་གྱི་འཇུག་པ་གང་ལ་ཡོད་པ་སྟེ་དེ་དག་དགག་པར་བྱ་བ་མེད་པའི་རྣམ་པར་གཞག་པ་དེའི་གོ་བྱེད་དེ་འཇུག་པ་ཡིན་ནོ།",
    "ཤེས་པ་ནི་རང་ཉིད་ཀྱིས་འགྲུབ་པས་ན་དེ་མེད་པ་ཡང་རང་ལས་འགྲུབ་པའི་ཕྱིར་ཐུག་པ་མེད་པ་མ་ཡིན་ནོ།",
    "དངོས་པོ་མེད་པ་ནི་ནམ་ཡང་རང་ལས་འགྲུབ་པ་མི་སྲིད་པས་ན་ཐུག་པ་མེད་པ་ཁོ་ནའོ་ཞེས་ལན་བརྗོད་པ་ནི་དེ་ནི་ཞེས་བྱ་བའོ།",
    "རིག་པ་མི་དམིགས་པ་ནི་གསལ་བར་ཡང་རང་བཞིན་མི་དམིགས་པར་འཆད་དེ་དང་ངོ།",
    "འབྲས་བུ་དང་རང་བཞིན་འབའ་ཞིག་ཏུ་ནི་མ་ཟད་ཀྱི་རྒྱུ་དང་ཁྱབ་བྱེད་མི་དམིགས་པར་ཡང་ངོ།",
    "གལ་ཏེ་དེ་ལྟ་ན་ཡང་རང་བཞིན་མི་དམིགས་པ་ལས་རང་བཞིན་འགལ་བ་དམིགས་པ་ཅི་ལྟར་གཞན་མ་ཡིན་ཞེ་ན།",
    "འགལ་བའི་འབྲས་བུ་དམིགས་པ་ཡང་རང་བཞིན་མི་དམིགས་པ་ལས་གཞན་མ་ཡིན་ནོ་ཞེས་བསྟན་པ་ནི་འགལ་བའི་ཞེས་བྱ་བའོ།",
    "ཁྱབ་བྱ་གང་ཡིན་པ་དེ་སྦྱར་བ་གང་ཡིན་པ་དེར་ནི་སྟེ་འགལ་བའི་འབྲས་བུ་དང་ཁྱབ་བྱ་དམིགས་པར་ནི་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་དག་ཀྱང་འདུ་བའི་ཕྱིར་རོ།",
    "དེ་ནི་ཞེས་བྱ་བ་ནི་འབྲས་བུ་དང་རང་བཞིན་དག་མི་དམིགས་པར་འདུ་བ་ནིའོ།",
    "གལ་ཏེ་འབྲས་བུ་དང་རང་བཞིན་དག་གཞན་གྱིས་མི་དམིགས་པའི་ནང་དུ་འདུ་བར་བརྗོད་པ་མ་ཡིན་ནམ།",
    "འགལ་བའི་འབྲས་བུ་དམིགས་པ་ཞེས་བརྗོད་པ་ཙམ་གྱིས་ནི་འབྲས་བུ་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་མི་དམིགས་པའི་མཚན་ཉིད་དུ་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མཆོག་དམན་བར་མའི་སྐྱེ་བོ་སུས་བལྟས་ཀྱང་རང་སྐལ་དང་འཚམ་པའི་ངེས་ཤེས་སྟེར་བ་བཅས་ཀྱི་ཡོན་ཏན་དུ་མ་དང་ལྡན།",
    "གོས་ཆས་གང་དགོས་གཡོགས་པའི་སྲོལ་ཞིག་བྱུང་འདུག་གནའ་ལུགས་དེ་ནི་གནའ་བོའི་དུས་སུ་བེད་སྤྱོད་བྱས་པ་ཙམ་དུ་མ་ཟད་དུས་ཕྱིས་ཁོ་བོ་སྐྱེས་དུས་ཀྱང་དར་སྲོལ་ཡོད་པ་དང་།",
    "ཨོ་ལི་བའི་འབྲས་བུ་འདི་ནི་སྐྱུ་རུ་རའི་རིགས་ཤིག་ཡིན་འདུག་པར་བརྟེན།",
    "སུ་ཞིག་ཉལ་པོ་བྱེད་འདོད་པ་དེ་རྣམས་ཀྱིས་ཀྱང་རང་རང་དང་སྐྱེ་གནས་སོགས་མི་མཐུན་པའམ།",
    "སུ་ཞིག་དུས་རྟག་ཏུ་ལུས་ལ་སྣུམ་བསྐུ་ཞིང་བྱུགས་པ་དང་མཉེ་བའི་སྤྱོད་པར་བྱེད་པ་དེ་ནི་རྒས་པ་ལས་བསྲིང་བ་དང་།",
    "དེ་ལྟར་ནའང་རང་ཅག་མིའི་འགྲོ་བ་ནི་སྐྱེས་བུའི་སྒོ་གསུམ་ཡོངས་སུ་རྫོགས་པ་ཞིག་ལ་ངོས་འཛིན་དགོས་པ་ལས།",
    "དེའང་རང་ཚུལ་རྣལ་མའི་གཤིས་ཇི་ལྟར་ཡིན་པར་ཡོངས་སུ་རྨོངས་ཤིང་དེའི་ངང་ཉིད་དུ་ནམ་ཡང་གནས་ཀྱི་མེད་པ་དང་།",
    "ཆོག་ཤེས་ཀྱི་རྣམ་པ་ལའང་རང་ལས་མཐོ་བ་ལ་དམིགས་ཏེ་ཕྲག་དོག་ཅིང་ཆོག་ཤེས་མེད་པར་འགྱུར་བ་ཞིག་དང་།",
    "རང་ཅག་རྣམས་སྐྱེས་ཙམ་ནས་འཆི་བའང་རང་ཆས་སུ་ཡོད་པ་ཞིག་ཡིན་པས་དེ་ལ་འཇིགས་ཤིང་སྐྲག་དགོས་པ་ཅི་ཞིག་ཀྱང་མེད་ལ།",
    "དེ་ནི་ཁྱེད་རང་གཅིག་པུ་ལ་བྱུང་བ་ཞིག་མ་ཡིན་ལ།",
    "སྒྲ་འོད་ཟེར་གསུམ་གང་བྱུང་ཡང་ཁྱེད་རང་ལ་གནོད་པ་འབྱུང་དུ་མེད་པས།",
    "སྐད་ཅིག་མ་དེ་ཉིད་ནས་བཟུང་རང་ཅག་རྣམས་གཉིས་འཛིན་གྱི་རྒྱ་ལས་ཡོངས་སུ་གྲོལ་བར་འགྱུར་བ་དེ་ལ་ནི་རང་སྣང་རང་ཞལ་མཇལ་བ་ཞེས་བྱ་སྟེ།",
    "དེ་ཉིད་ཡུལ་དུ་མི་ཞེན་ཞིང་རང་རྩལ་དུ་ཤེས་ཤིང་དེའི་ངང་དུ་གནས་པ་ཡིན་ན།",
    "སྐད་ཅིག་མ་དེ་ཉིད་ནས་བཟུང་རང་ཅག་རྣམས་གཉིས་འཛིན་གྱི་རྒྱ་ལས་ཡོངས་སུ་གྲོལ་བའི་ཆ་རྐྱེན་དུ་འགྱུར་བ་ཡིན།",
    "དེ་ཡང་རང་ཅག་རྣམས་མལ་དུ་མནལ་ནས་དུས་ཚོད་གང་མཚམས་ཤིག་འདས་པ་ན།",
    "བི་ཙི་ཙ་ན་བ་ཤི་ལ་ཧ་སྤྱན་དྲངས་ཤིང་།",
    "དེ་ཡང་སློབ་དཔོན་ཆེན་པོ་བེ་རོ་ཙ་ནས་བོད་སྐད་དུ་བསྒྱུར་ཅིང་།",
    "ཡིག་རྙིང་མང་པོ་ལས་མེ་གཙའ་ཞེས་ག་ཡིག་སྔོན་འཇུག་ཅན་གྱི་གཙའ་གནང་སྲོལ་བྱུང་འདུག་པ་དང་།",
    "སྨེ་བ་ལུགས་ལྡོག་ཏུ་བརྩི་བ་འདི་ནི་ཞང་བོད་གནའ་བོའི་ལུགས་སུ་ཡོངས་གྲགས་ཤིག་ཏུ་གྱུར་ཡོད་འདུག་པར་བརྟེན།",
    "༤བ་༢དེ་རྣམས་ནི་རྒྱབ་ཟུར་དུ་ཕན་ནུས་ཆེ་བའི་མེ་གསང་གཙོ་བོ་བདུན་ཅུ་དོན་བཞི་ཡོད་འདུག་པ་རྣམས་ཡིན་ནོ།",
    "དེ་རྣམས་ནི་མདུན་ཟུར་དུ་ཕན་ནུས་ཤིན་ཏུ་ཆེ་བའི་མེ་གསང་སུམ་ཅུ་ཡོད་འདུག་པ་རྣམས་སོ།",
    "ཡན་ལག་རྣམས་ཀྱི་གཙོ་བོ་མགོ་བོ་ལ་ཕན་ནུས་ཤིན་ཏུ་ཆེ་བའི་མེ་གསང་བརྒྱད་ཅུ་གྱ་གཅིག་ཡོད་འདུག་པ་དེ་རྣམས་རིམ་བཞིན་དུ་དྲངས་ཏེ་བསྟན་པ་ནི་འདི་ལྟ་སྟེ།",
    "གྱི་དེ་རྣམས་ནི་མགོ་བོའི་མེ་གསང་ཕན་ནུས་ཆེས་ཆེ་བ་བརྒྱད་ཅུ་གྱ་གཅིག་ཡོད་འདུག་པ་དེ་རྣམས་སུ་ངེས་པ་ཡིན་ནོ།",
    "འགྲོ་འདུག་དང་།",
    "འདུག་མི་ཚུགས་པ་དང་།",
    "༤༧༥༤༧༦ འདུག་མི་ཚུགས་པ།",
    "འདུག་མི་ཚུགས་པར།",
    "རླན་བསིལ་ཡིད་བདེར་གྱུར་པས་རོ་ཙ་ནུས།",
