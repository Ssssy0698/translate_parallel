    "དམག་ཟོར་ལྷ་མོ་བསྟོད་པའི་རབ་བྱེད་འདི།",
    "མཉམ་སྦྱོར་དཀྱིལ་འཁོར་གཙོ་མོར་མངའ་གསོལ་ལོ།",
    "གྲངས་མེད་རྣམ་བཞིའི་དཔའ་མོར་ཡོངས་ཤར་བའི།",
    "༢ན་པོ་དུལ་བྱའི་སྣང་ངོར་ཚངས་པའི་སྲས་མོའི་ཚུལ།",
    "དབྱངས་ཅན་ངག་གི་ལྷ་མོར་མངའ་གསོལ་ལོ།",
    "བསྟན་སྲུང་ཡོངས་ཀྱི་རྗེ་མོར་མངའ་གསོལ་ལོ།",
    "དགོན་གནས་ཀུན་གྱི་བདག་མོར་མངའ་གསོལ་ལོ།",
    "གཙུག་རུམ་ཉི་ཟླའི་དཀྱིལ་འཁོར་འོད་སྣང་གིས།",
    "དགྲ་བགེགས་ཐལ་བར་བརླག་པར་མངའ་གསོལ་འོ།",
    "ལོག་འདྲེན་ཐལ་བར་རློག་པར་མངའ་གསོལ་ལོ།",
    "དུས་གསུམ་སྒྲིབ་མེད་གཟིགས་པར་མངའ་གསོལ་ལོ།",
    "དར་ནག་གསེར་གྱི་ཐིག་ལེའི་གོས་བཟང་གིས།",
    "འོག་གི་ཀླུ་རྣམས་བོལ་བར་མངའ་གསོལ་ལོ།",
    "ཕུན་ཚོགས་བཀྲ་ཤིས་རྟགས་བརྒྱད་སྤྱན་གཟིགས་ཀྱིས།",
    "མཆོག་གི་དངོས་གྲུབ་སྩོལ་བར་མངའ་གསོལ་ལོ།",
    "འཕྲིན་ལས་ཐོགས་མེད་དམག་ཟོར་རྒྱལ་མོ་ཡིས།",
    "བདག་སོགས་འདོད་པའི་རེ་བ་སྐོང་གྱུར་ཅིག།",
    "པི་ཝང་གླིང་བུ་སིལ་སྙན་རོལ་མོའི་སྒྲ།",
    "ཐོད་རྔ་རྐང་གླིང་ཚོགས་པའི་སྒྲ་དབྱངས་དང་།",
    "རྟ་མཆོག་འབྲོང་གཡག་ཞོལ་མོ་འདོད་འཇོའི་བ།",
    "རིན་ཆེན་ཁང་བཟང་རྒྱ་ཕིབས་ལྕོག་གིས་མཛེས།",
    "བཙོད་ཞུན་སྣམ་རས་ལས་སྒོ་སྣ་ཚོ་གིས་ཟོང་།",
    "སྔོན་པོ་གླང་་རྟ་མཆོག་དམག་གི་དཔོན།",
    "གདུང་སེལ་གོས་དང་ཉོན་མོངས་བྲལ་བའི་མལ།",
    "སྒོ་དབྱེར་ཟོར་སྲིན་མོའི་ཟ་ལམ་མ་རྣམས།",
    "སྒོ་དབྱེར་ཟོར་སྲིན་མོའི་ཟ་ལམ་མ་རྣམས་བཞུགས་སོ།་",
    "བྱང་གི་སྒོ་མ་སྤྱང་གདོང་སྔོ",
    "སྲིན་མོ་ཟ་ལམ་གོམ་པ་བདུན་ཅུ་འདས་པའི་ཕ་རོལ་ན",
    "རྡོ་རྗེ་སྟེར་མོས་ལྟས་ངན་བྷྱོ་བཟློག་ཅིག་སོ་སོའི་རིགས་དང་མིང་སྲིང་༢ན་སྐོམ་དྲལ་ཚུལ",
    "དཀར་མོ་སྤྱན་གཅིག་རྡོ་རྗེ་རིགས་ཀྱི་ལྕམ་ཉིད་ཀྱི་མིང་པོ་རྒྱལ་པོའི་བཀའ་བསྒྱུར་ལ",
    "སྲིན་མོ་ཤུགས་ཡོང་རིན་ཅེན་རིགས་ཀྱི་ལྕམ་ཉིད་ཀྱི་མིང་པོ་གཤིན་རྗེའི་བཀའ་བསྒྱུར་ལ་རྣལ་འབྱོར་བདག་གི་འཁོར་དུ་གཏོགོས་པ་ལ་འཆི་བདག་གཤིན་རྗེའི་ཁྲམ་ལ་བཏབ་པ་རེ",
    "ས་བདག་ཀླུ་ཡི་བྱད་དུ་ཚུད་པ་རེ་བཟློག་གོ་དམར་རྤཱ་གཏོར་མ་འདི་ཡིས་བཟློག་བསྒྱུར་རོ་ཀླུ་ཡི་ཆོ་འཕྲུལ་དགྲ་ལ་སྒྱུར་བྷྱོ།",
    "རྣལ་འབྱོར་བདག་གི་འཁོར་དུ་གཏོགས་པ་ལ་གནོད་སྦྱིན་གདུག་པའི་གདོན་གྱིས་ཟིན་ཏ་རེ",
    "སྔགས་སྲུང་ཨེ་ཀ་ཛ་ཏི་རལ་གཅིག་མ་བདུད་པོ་སྐོས་རྗེ་བྲང་དཀར་བཀའ་བསྒྱུར་ལ་རྣལ་འབྱོར་བདག་གི་འཁོར་དུ་རྟམ་གགས་པ་ལ་བདུད་ཀྱི་རྒྱལ་པོའི་ཁྲམ་ནང་བརྐྱང་བ་རེ་བཟློག་གོ་དམར་ཆེན་གཏོར་མ་འདི་ཡིས་བཟློག",
    "ཨེ་ཀ་ཛ་ཏི་ནག་མོ་གློག་མ་སྤྲིན་བདུད་པོ་རེ་ཏི་འགོང་ཡག་བཀའ་བསྒྱུར་ལ",
    "རྣལ་འབྱོར་བདག་གི་འཁོར་དུ་གཏོགས་པ་ལ་ནག་པོ་བདུད་ཀྱི་བྱན་པོས་༣ན་ཐ་རྐུས་ཏ་རེ་བཟློག་གོ་དམར་ཆེན་གཏོར་མ་འདི་ཡིས་བཟློག་བསྒྱུར་རོ་བདུད་ཀྱི་ཆོ་འཕྲུལ་དགྲ་ལ་སྒྱུར་བྷྱོ།",
    "དཀར་མོ་ཆེན་མོ་ཉི་མའི་ཐོད་འཕྲེང་ཅན་ཉིད་ཀྱི་མིང་པོ་གནམ་ལྷའི་བཀའ་བསྒྱུར་ལ་རྣལ་འབྱོར་བདག་གི་འཁོར་དུ་གཏོགས་པ་ལ་རྒྱལ་པོ་དཀར་པོས་དམངས་སུ་འབེབས་ཏ་རེ་བཟློག་གོ་དམར་ཆེན་གཏོར་མ་འདི་ཡིས་བཟློག་བསྒྱུར་རོ་རྒྱལ་པོའི་ཆོ་འཕྲུལ་དགྲ་ལ་སྒྱུར་བྷྱོ།",
    "རྣལ་འབྱོར་བདག་གི་འཁོར་དུ་གཏོགོས་པ་ལ་འབྱུང་པོ་ཐེ་བྲང་ཡུལ་དུ་ཕེབས་ཏ་རེ་བཟློག་གོ་དམར་ཆེན་གཏོར་མ་འདི་ཡིསབཟློག་བསྒྱུར་རོ་འབྱུང་པོའི་ཆོ་འཕྲུལ་དགྲ་ལ་སྒྱུར་བྷྱོ།",
    "ས་བདག་ཆེན་མོ་ནག་མོ་རལ་གཅིག་མ་ས་ཡི་ཐེ་བྲང་ནག་པོའི་བཀའ་བསྒྱུར་ལ་རྣལ་འབྱོར་བདག་གི་འཁོར་དུ་གཏོགོས་པ་ལ་ཐེ་བྲང་རྣམས་ཀྱི་ཆོ་འཕྲུལ་ཤོར་ར་རེ་བཟློག་གོ་དམར་ཆེན་གཏོར་མ་འདི་ཡིས་བཟློག་བསྒྱུར་རོ་ཐེ་བྲང་ཆོ་འཕྲུལ་དགྲ་ལ་སྒྱུར་བྷྱོ།",
    "སྒོ་དབྱེར་ཟོར་སྲིན་མོའི་ཟ་ལམ་མ་རྣམས།",
    "རྣལ་འབྱོར་བདག་གི་འཁོར་དུ་གཏོགས་པ་ལ",
    "བཙན་གྱི་རྒྱལ་པོའི་རྟ་བབས་ཤོར་ར་རེ་བཟློག་གོ་དམར་ཝོ་གཏོར་མ་འདི་ཡིས་བཟློག་བསྒྱུར་རོ་བཙན་གྱི་ཆོ་འཕྲུལ་དགྲ་ལ་སྒྱུར",
    "ཉུལ་ལེ་འཇིགས་པ་ཁྲག་གི་རལ་གཅིག་མ་ཀླུ་སྲིན་ཕོ་མོ་ཡོངས་ཀྱི་བཀའ་བསྒྱུར་ལ",
    "ཀླུ་སྲིན་རྣམས་ཀྱི་ཆོ་འཕྲུལ་ཤོར་ར་རེ",
    "སྣང་སྲིད་མ་མོའི་ཁྲམ་ནག་བརྐྱང་བ་རེ",
    "བསྒྱུར་རོ་མ་མོའི་ཁྲམ་ཁ་དགྲ་ལ་སྒྱུར",
    "ང་ནི་མ་མོ་ཀུན་གྱི་ཡབ་ང་ནི་མཁའ་འགྲོ་ཀུན་གྱི་རྗེ",
    "ང་ནི་གིང་ཆེན་ཀུན་གྱི་རྒྱལ",
    "དཔའ་མོ་དུལ་བརྡབ་ཆེམས་རྩེ་ཆེམ",
    "ཡུངས་ཀར་རྦབ་འདྲིལ་ཤར་ར་ར་མཚོ་ཡི་མདེའུ་ཐུང་ཐལ་ལ་ལ",
    "བཛྲགི་ལི་ཀི་ལཱ་ཡ་སརྦ་བིགྷ་ན་པཾ།",
    "ཅེས་པ་ཡང་དག་ནས་དམོད་པ་དྲག་སྔགས་བར་ལ་སྦྱར་ཞིང་དྲག་སྔགས་སོ་ལྔ་པའི་མཐར།",
    "མཆེད་དང་ལྕམ་དྲལ་སྤྱི་ཡི་དགྲ་རྣལ་འབྱོར་བདག་གི་སྒོས་དགྲ་དང་",
    "གིང་ཆེན་རོལ་པའི་རྔམ་ཟས་མཛོད་སེམས་ནི་རྒྱལ་བའི་གནས་སུ་སྦོར་ཧཱུཾ།",
    "རྒྱལ་པོ་རྣམས་ཀྱི་གནོད་པ་བཟློག་ཡུགས་སའི་འཕང་གི་རྩང་རྣོན་འདིས་མ་བདུད་རྣམས་ཀྱི་གནོད་པ་བཟློག",
    "རབས་ཆད་ཁང་པའི་དུད་པ་འདིས་གནོད་སྦྱིན་ཕོ་མོའི་གནོད་པ་བཟློག",
    "ཐེ་བྲང་རྣམས་ཀྱི་གནོད་པ་བཟློག་མར་མེ་གསལ་བྱེད་སྡོང་བུ་འདིས་མཁའ་འགྲོ་རྣམས་ཀྱི་གནོད་པ་བཟློག་གདུག་པ་ཤིང་གི་ཚེར་མ་འདིས",
    "གཟའ་སྐར་རྣམས་ཀྱི་གནོད་པ་༤བ་བཟློག་ལྷ་བསྒོམས་ཁྲག་གིས་བྱུགས་པ་འདིས་ས་བདག་རྣམས་ཀྱི་གནོད་པ་བཟློག་མེ་ཏོག་བཅུད་ཅན་ཕབ་རྩི་འདིས",
    "སྐྱེས་པ་ཕོ་ཡི་མདའ་ཁྲ་འདིས་དགྲ་བགེགས་མཚོ་ནི་ཆ་ཐམས་ཅད་བཟློག་ཟ་མ་མོ་ཡི་འཕང་ཁྲ་འདིས་ལྟསང་ན་མཚན་མ་ངན་པ་བཟློག་ལུང་དགུ་འདུས་པའི་ཆུ་སྣ་འདིས",
    "ཀླུ་སྲིན་ཕོ་མོའི་གནོད་པ་བཟློག",
    "ཕུང་བཤུལ་དགུ་ཡི་ཚོས་སྣ་སྒོ་དབྱེར་ཟོར་སྲིན་མོའི་ཟ་ལམ་མ་རྣམས།",
    "ཟ་མ་མོ་ཡི་གནོད་པ་བཟློག",
    "རྟགས་དང་མཚན་མ་ངན་པ་བཟློག་མི་མང་ཐལ་མོ་བརྡེབ་པ་འདིས",
    "དྲང་སྲོང་བཀའ་ཡི་དམོད་པ་བཟློག",
    "མ་མོའི་ཐུན་སྔགས་བྱུང་བ་བཟློག",
    "ཕ་ཚན་ནང་གི་རྒྱ་འདྲེ་བཟློག",
    "དར་ཚན་ནང་གི་སྟོང་འདྲེ་བཟློག",
    "ཕོ་སྲི་མོ་སྲི་ཆུང་སྲི་བཟློག",
    "ཡུལ་མི་ཁྱིམ་མཚེས་དམོད་མོ་བཟློག",
    "ཁྲོ་བཅུ་ཕྲ་ཕྱག་སྒོ་མ་ཕུར་སྲུང་བཀའ་ཉན་ལས་བྱེད་ཚོ་གིས་རྣམས་ཀྱིས།",
    "བསྲུང་བར་ཞལ་བཞེས་བསྟན་སྲུང་གཙོ་མོ་དཔལ་ལྡན་དམག་དང་ཟོར་གྱི་ལྷ།",
    "མཐུ་སྟོབས་རྡོ་རྗེ་ཐོག་གི་རྗེས་འགྲོ་ལ།",
    "མྱུར་མགྱོགས་གློག་གིས་འགྲན་པར་བཟོད་མིན་པའི།",
    "ཇི་ལྟར་བསམས་༢ན་པའི་ཡིད་ཀྱི་རེ་བ་ཀུན།",
    "མི་མཐུན་ཕྱོགསརྣམས་ཐལ་བར་རློག་པ་ཡི།",
    "དཀར་བདུད་ཕུར་སྲུང་གི་གསོལ་མཆོད།",
    "གཞི་བདག་གི་གཏོར་མ་རྣམས་ཕུལ་གྲུབ་རྗེས།",
    "བསྟོད་པ་ཅི་རིགས་དང་ཚོགས་ཐོག་མཐའ་བར་གསུམ་སོང་མཚམས།",
    "རི་རབ་ཀྱི་སྟེང་གི་གཞལ་ཡསཁང་གི་ནང་དུ་ཁྲག་ཞག་འཁྲུག་པའི་རྒྱ་མཚོ་ཆེན་པོའི་དབུས་སུ་ཞེས་པ་ནས།",
    "མི་ལྤགས་དང་དར་ནག་གི་གོས་གྱོན་ཞིང་བོང་བུ་གུ་པ་ལ་བཅིབས་པ།",
    "དར་ནག་དང་རེ་བའི་གོས་གྱོན་ཞིང་དྲེའུ་ལ་བཅིབས་པ།",
    "གཞལ་ཡས་ཁང་གི་མདུན་གྱི་གཡས་ཟུར་གྱི་མཁར་དུ་དཔྱིད་ཀྱི་རྒྱལ་མོ་མཐིང་ནག་གཡས་སྤུ་གྲི་དང་གཡོན་ཐོད་ཁྲག་འཛིན་ཅིང་མི་ལྔགས་གྱོན་པ་དྲེའུ་ལ་བཅིབས་པ།",
    "རྒྱབ་ཀྱི་གཡས་ཟུར་གྱི་མཁར་དུ་དབྱར་གྱི་རྒྱལ་མོ་དམར་ནག་གཡས་ལྕགས་ཀྱུ་དང་གཡོན་ཐོད་ཁྲག་འཛིན་པ་ཆུ་དར་གྱོན་ཞིང་ཆུ་གླང་ལ་བཅིབས་པ།",
    "རྒྱབ་ཀྱི་གཡོན་ཟུར་གྱི་མཁར་དུ་སྟོན་གྱི་རྒྱལ་མོ་སེར་མོ་གཡས་ཟོར་བ་དང་གཡོན་ཐོད་ཁྲག་འཛིན་པ་རྨ་བྱའི་སྒྲོ་ཐུལ་གྱོན་ཞིང་ཤ་བ་ལ་བཅིབས་པ།",
    "མདུན་གྱི་གཡོན་ཟུར་གྱི་མཁར་དུ་དགུན་གྱི་རྒྱལ་མོ་མཐིང་ནག་གཡས་ཁྲམ་ཤིང་དང་གཡོན་ཐོད་ཁྲག་འཛིན་པ་རྔ་མོ་གུ་པ་ལ་བཅིབས་པ།",
    "བང་རིམ་གཉིས་པའི་མདུན་ངོསཀྱི་མཁར་དུ་བཀྲ་ཤིས་ཚེ་རིང་མ་དཀར་མོ་རྡོ་རྗེ་དང་བུམ་པ་འཛིན་པ་སེང་གེ་ལ་བཅིབས་པ།",
    "མི་གཡོ་བློ་བཟང་མ་སེར་མོ་ཀྱི་ཟས་བ།",
    "ཅོད་པན་མགྲིན་བཟང་མ་དམར་མོ་ནོར་བུ་དང་གཏེར་གྱི་སྒྲོམ་བུ་འཛིན་པ་ཤ་བ་ལ་བཅིབས་པ།",
    "གཡས་ཀྱི་མཁར་དུ་རྡོ་རྗེ་ཀུན་གྲགས་མ་སྔོན་མོ་སྦྲུལ་ནག་སྟོང་གི་ཐུལ་བ་དང་གཡག་ལྔ་གས་རློནེ་པའི་ཤམ་ཐབས་ཅན།",
    "རྡོ་རྗེ་གཡའ་མ་སྐྱོང་སྔོན་མོ་གཡག་ལྤགས་རློན་པའི་ན་བཟའ་དང་།",
    "ཁྱུང་གཤོག་སྟོང་གི་ཤམ་ཐབས་ཅན།",
    "རྡོ་རྗེ་ཀུན་བཟང་མ་དཀར་མོ་སེང་གེའི་གཡང་གཞི་གསོལ་ཞིང་རྡོ་རྗེ་རྩེ་ལྔ་བསྣམས་པ་སེང་གེ་ལ་བཅིབས་པ།",
    "རྡོ་རྗེ་བགེགས་༣བ་ཀྱི་གཙོ་སྔོན་མོ་གླང་ནག་སྟོང་གི་ན་བཟའ་དང་།",
    "རྒྱབ་ཀྱི་མཁར་དུ་རྡོ་རྗེ་སྤྱན་གཅིག་མ་དཀར་མོ་དུང་གི་ཁུ་འཕང་གི་ན་བཟའ་ལ་གཡུའི་སྐ་རགས་བཅིངས་པ།",
    "ཁྲག་གི་རྐྱལ་པ་འཛིན་ཞིང་དུང་ཤ་དཀར་པོ་ལ་བཅིབས་པ།",
    "རྡོ་རྗེ་དཔལ་གྱི་ཡུམ་སེར་མོ་མི་ལྤགས་ཀྱི་ན་བཟའ་དང་།",
    "རྡོ་རྗེ་ཀླུ་མོ་དཀར་མོ་མི་མགོ་བརྩེགས་པའི་ཐུལ་པ་གྱོན་ཞིང་ཞིང་དབྱུག་འཛིན་པ།",
    "རྡོ་རྗེ་དྲག་མོ་རྒྱལ་ལྗང་གུ་གཡག་ལྤགས་སྟོང་གི་སློག་པ་དང་།",
    "ཁྱུང་གཤོག་སྟོང་གི་ཤམ་ཐབས་ཅན།",
    "གཡོན་གྱི་མཁར་དུ་རྡོ་རྗེ་དཔལ་མོ་ཆེ་ནག་མོ་སེང་ལྤགས་སྟོང་གི་སློག་པ་དང་།",
    "ཁྲག་གི་བུམ་པ་འཛིན་ཅིང་ཀོང་རྟ་དཀར་པོ་ལ་བཅིབས་པ།",
    "སྟག་ལྤགས་སྟོང་གི་ཤམ་ཐབས་ཅན།",
    "རྡོ་རྗེ་གཡའ་མོ་སིལ་དམར་ནག་སྦྲུལ་ནག་གཏམས་པའི་གཡང་གཞི་གསོལ་ཞིད་སེང་ལྡེང་གི་ཕུར་བ་འཛིན་པ།",
    "གནའ་བ་ཡུ་མོ་ལ་བཅིབས་པ།",
    "རྡོ་རྗེ་དྲིལ་བུ་གཟུགས་ལེགས་མ་སྔོན་མོ་སྤྱང་ཀིའི་སློག་པ་དང་།",
    "ཧཱུཾ་གིས་བླ་ན་མེད་པའི་བདུད་རྩིའི་རང་བཞིན་ཟད་མི་ཤེས་པར་སྤེལ།",
