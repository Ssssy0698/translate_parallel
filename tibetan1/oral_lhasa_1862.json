    "དེ་ནི་རྣམ་པ་བཅུར་རིག་པར་བྱ་སྟེ།",
    "པའི་དག་པས་རྣམ་པར་དག་བ་རོ་མྱང་བ་མེད་པའི་བསམ་གཏན་དང་།",
    "དངོས་གཞི་ལས་ཁྱད་པར་གོང་མ་རྣམ་པར་དག་པས་རྣམ་པར་དག་པའི་བསམ་གཏན་དང་།",
    "ལྟ་བར་གྱུར་པ་ཐམས་ཅད་དང་བྲལ་བ་རྣམ་པར་དག་པས་རྣམ་པར་དག་པའི་བསམ་གཏན་དང་།",
    "སྡོམ་ནི་སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཤེས་བྱ་ལ་དེ་ཁོ་ན་ཁོང་དུ་ཆུད་ཅིང་རྟོགས་པར་བྱ་བ་དང་།",
    "ཚོགས་གསུམ་ལ་མཁས་པར་བྱ་བ་དང་།",
    "བདེན་པ་རྟོགས་པར་བྱ་བའམ།",
    "རྣམ་པར་མི་རྟོག་པ་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བ།",
    "སྐུར་པ་འདེབས་པའི་མཐའ་གཉིས་རྣམ་པར་སྤངས་པའི་ཕྱིར།",
    "རིག་པའི་གནས་ལྔ་ལ་མཁས་པ་ནི་རྒྱས་པར་སྔ་མ་བཞིན་དུ་འདི་ལྟ་སྟེ།",
    "ཤིན་ཏུ་རྣམ་པར་དག་པ་གཏན་ལ་དབབ་པའི་ཤེས་རབ་དང་།",
    "ཡེ་ཤེས་ཀྱི་ཚོགས་སྔར་ཡང་དག་པར་ཐོབ་པའི་ཕྱིར་ལྷན་ཅིག་སྐྱེས་པ་དང་།",
    "བསམ་པ་དག་པའི་ས་ཡན་ཆད་མཐར་ཐུག་པར་འགྲོ་བའི་ས་མན་ཆད་ཡོངས་སུ་བཟུང་བའི་ཕྱིར་རྟོགས་པ་དང་ལྡན་པའོ།",
    "གཅིག་ཏུ་བསྡུས་ན་རྣམ་པ་བཅུ་གསུམ་ཡོད་པར་རིག་པར་བྱ་སྟེ།",
    "དོན་སོ་སོ་ཡང་དག་པར་རིག་པ་དང་།",
    "ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པ་དང་།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པ་དང་།",
    "ཁྱིམ་བརྒྱུད་ལེགས་པར་བསྐྱང་བ་དང་།",
    "དེ་ནི་རྣམ་པ་དགུར་རིག་པར་བྱ་སྟེ།",
    "ལས་ཀྱི་གནས་ཀྱི་རིག་པ་ལ་ནི་ཤིན་ཏུ་རྣམ་པར་བྱང་ལ།",
    "རིག་པ་རྣམ་པ་ལྔ་པོ་ཤིན་ཏུ་རྣམ་པར་བྱང་བ་དེ་དག་ཉིད་ལ་བརྟེན་ནས།",
    "ཡར་དག་པར་ཞུགས་པ་གཞན་དག་ལ་གོ་རིམས་བཞིན་དུ་ཡང་དག་པར་བསྟན་པ་དང་།",
    "ཡང་དག་པར་འཛིན་དུ་གཞུག་པ་དང་།",
    "ཡང་དག་པར་གཟེངས་བསྟོད་པ་དང་།",
    "རྒྱུ་དང་འབྲས་བུ་ལེགས་པར་འཛིན་པའི་ཕྱིར།",
    "རྣམ་པར་བྱང་བ་ལ་རྣམ་པར་བྱང་བ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཡོངས་སུ་ཤེས་པའི་ཕྱིར་མཐར་ཐུག་པའི་དོན་ཀྱང་རྣམ་པ་གཉིས་ཏེ།",
    "རྣམ་པར་དག་པའི་སྦྱིན་པའི་བར་དུ་སྦྱར་བར་བྱ་སྟེ།",
    "དེའི་བསྡུ་བ་ཡང་ཅི་རིགས་པར་བྱའོ།",
    "ཤེས་རབ་དང་ལྡན་པ་ཐམས་ཅད་ཀྱང་ཤེས་རབ་ལས་བརྩམས་པར་རིག་པར་བྱའོ།",
    "ཁ་ཅིག་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་པོ་ཐམས་ཅད་ལས་བརྩམས་པར་རིག་པར་བྱའོ།",
    "སྡོམ་ནི་སྔ་མ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "ཚུར་ཤོག་ལེགས་པར་འོངས་སོ་ཞེས་སྨྲ་བའམ།",
    "དེ་ལ་ཡང་དག་པར་དགའ་བར་བྱེད་པའི་ངག་གང་ཡིན་པ་དང་།",
    "ཀུན་ཏུ་དགའ་བར་བྱེད་པ་གང་ཡིན་པ་དེ་ནི་འཇིག་རྟེན་གྱི་ཚུལ་དང་ལྡན་པར་རིག་པར་བྱའོ།",
    "ལོག་པར་ཞུགས་པ་རྣམས་ལ་ཀུན་ནས་མནར་སེམས་ཀྱི་སེམས་མེད་པ་དང་།",
    "ཁོང་ཁྲོ་བའི་སེམས་མེད་པར་ཡང་དག་པར་དགའ་བར་བྱེད་པ་དང་།",
    "བག་ཡོད་པའི་སྤྱོད་པ་ལ་དགོད་པའི་ཕྱིར་ཡང་དག་པར་བསྐུལ་བ་དང་།",
    "འབྲེལ་བའི་གཏམ་རྣམ་པར་ངེས་པར་བྱ་བའོ།",
    "དེ་བཞིན་གཤེགས་པར་གྱུར་པ་རྣམས་གླེང་གཞི་དང་བཅས་པ་དང་།",
    "ཡང་དག་པར་བླངས་པའི་བསླབ་པ་རྣམས་ལས་ཉེས་པ་བྱུང་བ་དག་ཉེས་པ་ལས་དབྱུང་བ་འཆའ་བར་བྱེད་དེ།",
    "སྡུག་བསྔལ་ཐམས་ཅད་ལས་ངེས་པར་འབྱིན་པའི་ཕྱིར་ཕྱིར་མི་ལྡོག་པའི་ལམ་ཡང་དག་པར་སྟོན་ཏེ།",
    "ཡང་དག་པར་དགའ་བར་བྱེད་པའི་སྙན་པར་སྨྲ་བ་དང་།",
    "ཀུན་ཏུ་དགའ་བར་བྱེད་པའི་སྙན་པར་སྨྲ་བ་དང་།",
    "འཇིགས་པ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་སྐྲག་པ་རྣམས་དབུགས་དབྱུང་བའི་སྙན་པར་སྨྲ་བ་དང་།",
    "རིགས་པ་བསྟན་པས་བསྡུས་པའི་སྙན་པར་སྨྲ་བ་དང་།",
    "དོགས་པ་ལ་གླེང་ཞིང་སྨྲ་དབབ་པའི་སྙན་པར་སྨྲ་བ་དང་།",
    "གཞན་ནུས་པ་ལ་བཅོལ་ཏེ་སྒྲུབ་པའི་སྙན་པར་སྨྲ་བ་སྟེ།",
    "དེ་ལ་ངག་རྣམ་པར་དག་པ་རྣམ་པ་བཞི་ནི་འདི་དག་ཡིན་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ལ་རྣམ་པར་ཤེས་སོ་ཞེས་སྨྲ་བ་དང་།",
    "རྣམ་པར་མ་ཤེས་པ་ལ་རྣམ་པར་མ་ཤེས་ཞེས་སྨྲ་བའོ།",
    "ཉེ་དུ་ལས་གྱུར་པའི་སྡུག་བསྔལ་གྱི་མྱ་ངན་བསང་བའི་ཕྱིར་སྙན་པར་སྨྲ་བ་དང་།",
    "ལྟ་བས་ཕོངས་པ་སྤང་བའི་ཕྱིར་སྙན་པར་སྨྲ་བ་དང་།",
    "འཚོ་བ་ཕུན་སུམ་ཚོགས་པ་ལ་སྙན་པར་སྨྲ་བ་གང་ཡིན་པ་སྟེ།",
    "སྟོབས་ཀྱི་རིགས་ཀྱི་ལེའུ་ལས་སྔར་བསྟན་པ་བཞིན་དུ་རིག་པར་བྱའོ།",
    "དེ་ལ་དོན་སྤྱོད་པ་ནི་སྙན་པར་སྨྲ་བ་ཇི་ལྟ་བ་དེ་བཞིན་དུ་ཡང་རྒྱས་པར་རིག་པར་བྱའོ།",
    "དེ་ལས་བྱེ་བྲག་དུ་གྱུར་པའི་དོན་སྤྱོད་པ་གཞན་ཡང་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ཡང་སྒོ་གསུམ་དུ་རིག་པར་བྱ་སྟེ།",
    "ཚེ་འདིའི་དོན་ཡང་དག་པར་འཛིན་དུ་གཞུག་པ་དང་།",
    "ཚེ་ཕྱི་མའི་དོན་ཡང་དག་པར་འཛིན་དུ་གཞུག་པ་དང་།",
    "ཚེ་འདི་དང་ཚེ་ཕྱི་མའི་དོན་ཡང་དག་པར་འཛིན་དུ་གཞུག་པའོ།",
    "སྤེལ་བ་ཡང་དག་པར་འཛིན་དུ་གཞུག་པས།",
    "ཚེ་འདིའི་དོན་ཡང་དག་པར་འཛིན་དུ་འཇུག་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "ཚེ་འདི་ལ་ཡང་ཡོ་བྱད་ཀྱི་བདེ་བས་ཕན་བཏགས་པས་བདེ་བར་གནས་པར་འགྱུར་རོ།",
    "རིམ་གྱིས་འདོད་ཆགས་དང་བྲལ་བར་འགྱུར་བ་ཡང་དག་པར་འཛིན་དུ་འཇུག་པ་གང་ཡིན་པ་འདི་ནི་ཚེ་འདི་དང་ཚེ་ཕྱི་མའི་དོན་ཡང་དག་པར་འཛིན་དུ་འཇུག་པ་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
