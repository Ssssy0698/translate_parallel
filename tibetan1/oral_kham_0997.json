    "མ་ཎིའི་བཟླས་པ་བསྙེན་སྒྲུབ་ཀྱང་བྱས་འདུག།",
    "གཞན་ཡང་ལུས་ཀྱི་སྒྲིབ་པ་དག་ཕྱིར་དུ་ཕྱག་དང་བསྐོར་བ་ཡང་བྱས་འདུག།",
    "ཐུགས་རྗེ་ཕྲིན་ལས་འདུག་གོ་གྱིས།",
    "ལྷ་དང་འདྲེ་གཉིས་ཀྱི་གཏམ་དེ་ཡང་ཕྱེད་བདེན་ཕྱེད་མི་བདེན་པར་འདུག།",
    "ཡི་དྭགས་ངུ་འབོད་ཀྱིས་གནས་སུ་གཏོང་དགོས་པ་འདུག་གོ།",
    "དེ་ནས་ཡི་དྭགས་ངུ་འབོད་ཀྱི་གནས་སུ་ཞག་གསུམ་བསྡད་ནས་དེའི་རྟིང་དུ་མི་ལུས་དབུལ་པོ་གཅིག་ཐོབ་པ་འདུག་གོ།",
    "ཞེས་ཟེར་ཞིང་མཆི་མ་མང་དུ་འདོན་གྱི་འདུག་གོ།",
    "རྡེའུ་དཀར་ནག་གཉིས་ལས་ནག་པོ་མང་ཞིང་ལྕི་བར་འདུག།",
    "རྣམ་སྨིན་ཁུར་པོ་མང་པོ་འཁུར་དགོས་འདུག།",
    "ཐར་བ་འདུག་གོ་ཟེར་བའི་འཕྲིན་མཛོད་ཅིག།",
    "ལྷ་དང་འདྲེ་གཉིས་ཀྱི་རྡེའུ་དཀར་ནག་བཤེར་མི་དགོས་པ་འདུག་གོ།",
    "ལྕེ་ཨོག་མའི་འོག་ནས་འཐེན་ཏེ་ཐོང་གཤོལ་མེ་འབར་བས་རྨོད་ཀྱིན་འདུག།",
    "དཀར་པོ་མང་ཞིང་ལྕི་བར་འདུག་པས།",
    "ཕྱག་དང་བསྐོར་བ་ཡང་མང་དུ་བྱས་འདུག།",
    "སེམས་ལ་བརྟན་པ་ཐོབ་པའི་སྒོམ་ཞིག་བྱས་ན་རིག་འཛིན་གྱི་ས་ཐོབ་པ་འདུག་སྟེ།",
    "ཐུགས་རྗེའི་ལམ་སྣ་འདྲེན་བགྱིས་འདུག་གོ་གྱིས།",
    "དགེ་སློག་དགྲ་བཅོམ་ཐོབ་པ་འདུག་གོ་གྱིས།",
    "རྡེའུ་དཀར་ནག་གཉིས་ལ་ཡང་ལྗིད་མི་འདུག་པས།",
    "དེ་ལས་ཐར་ནས་རི་མཐོ་ས་གཙང་མའི་གནས་གཅིག་ཏུ་འདབ་ཆགས་བྱའི་སྐྱེ་བ་ལེན་པ་འདུག་གོ།",
    "ང་རང་གཅིག་པོ་ཐར་བ་མ་ལགས་ཏེ།",
    "རྒྱུ་འབྲས་བག་ཕྱེ་བས་ཞིབ་པ་འདུག་ཟེར་བ་ཐོས་པས།",
    "ཡིད་ཀྱི་སྒོ་ནས་བརྣབ་སེམས་དང་གནོད་སེམས་མ་བྱས་པ་འདུག།",
    "དེའི་ནང་ནས་ཁྲོ་བོའི་ཆ་ལུགས་ཅན་རྣམས་ཀྱི་གར་སྟབས་དང་བཅས་པའི་གླུ་དབྱངས་འདི་ལྟར་འབུལ་གྱིན་འདུག་གོ།",
    "རང་རང་ལས་ཀྱི་རྣམ་སྨིན་འཁུར་བ་རྣམས།",
    "སྡིག་སྒྲིབ་ཡོད་པ་རྣམས་དག་འདུག་གོ།",
    "གཡས་གཡོན་ནས་གཤིན་རྗེའི་ལས་མཁན་རྣམས་ཀྱིས་མཚོན་ཆ་ཁྱེར་ནས་རྒྱོབ་རྒྱོབ་སོད་སོད་ཀྱི་སྒྲ་སྒྲོག་པ་འདུག།",
    "ངའི་ཕ་འདིའི་སྡུག་བསྔལ་ལས་ཐར་དུས་མི་འདུག་ཟེར་བས།",
    "དཔའ་བོ་མཁའ་འགྲོའི་བསུ་མ་འདུག་གོ་གྱིས།",
    "དངངས་སྐྲག་མི་དགོས་ང་རང་བསུ་རུ་འོངས།",
    "ཁྱེད་རང་གསུམ་མིང་རུས་མ་ནོར་བ་ལོག་པ་ཡིན་ནོ།",
    "ཚེ་སྔ་མ་རྒྱ་གར་དུ་གླང་པོ་ཆེ་མངོན་ཤེས་ཅན་གཅིག་ཏུ་སྐྱེ་བ་བླངས་འདུག།",
    "དེ་ཡང་འགྲོ་དོན་གྱི་ཐོག་མ་གཙང་རྒྱ་རྩེའི་ཕྱོགས་ན་ཡོད་པ་འདུག་པས།",
    "ཤན་འབྱེད་ལུགས་ཞིབ་པར་འདུག་གོ་གྱིས།",
    "གཞན་ཡང་གཤིན་རྗེའི་ཕོ་ཉའི་ངད་པ་མེ་བས་ཚ་བ་འདུག་གོ་གྱིས།",
    "སྒྱུ་མ་ལུས་ཀྱི་ཁང་སྟོང་འཇིག་གྲབས་འདུག།",
    "བཀའ་འཕྲིན་མི་བརྗེད་ང་རང་བྱིན་གྱིས་རློབས།",
    "ཞེ་དགུའི་སྟེང་ནས་འདི་རུ་ཡོང་བ་འདུག།",
    "ཕྱིར་འཐེན་མི་ལོ་གསུམ་དུ་བཤོལ་བ་འདུག།",
    "མི་དེ་རྣམས་ཀྱིས་ང་ལ་འདི་ལྟར་ཟེར་གྱིན་འདུག་གོ།",
    "ཡི་གེ་དྲུག་པ་འདི་ལས་ཕན་ཡོན་ཆེ་བ་མི་འདུག་པས།",
    "ཁྲ་ཕུ་ན་བསླེབས་འདུག།",
    "མིག་ཀོ་དོང་དུ་འདྲུས་པ་ཁ་སྦུབ་ཆིལ་ལེ་བ་གཅིག་འདུག་པས།",
    "ཡོང་བར་འདུག་པས།",
    "ད་འདི་རུ་སྡོད་ནས་ཕངས་པར་འདུག་པས།",
    "བུ་སློབ་ཀྱང་ང་བས་མང་བ་ཡོང་ངོ་འདུག་གསུངས་ཀྱང་།",
    "འཆག་དང་འདུག་དང་འགྲེང་དང་ཉལ་བ་ན།",
    "ལྕི་ལྕི་ལྟར་འདུག་ཁྱབ་འཇུག་བྱིན་ཡང་སྟོབས་ཆེན་སྡུག་བསྔལ་གནས་སྐབས་གྱུར།",
    "རང་རང་འཁོར་འདུལ་སྒོ་བཞི་སྐྱོང་།",
    "བདེ་བའི་སྟན་ལ་འདུག་ནས།",
    "བོན་ཐམས་ཅད་དངོས་པོ་མ་མཆིས་པར་རྟོགས་ཤིང་རང་ལེའུ་ཞེ་བདུན་པ།",
    "འཇིག་རྟེན་ལས་འདས་པའི་བོན་ཡོད་ཅིང་རྟག་པ་གཉིས་ཀྱང་རང་རིག་པའི་ཡེ་ཤེས་ལ་འདུས་པའོ།",
    "རྡེའུ་ཤིང་རང་འགྱུར་གྱི་བོན་ལས་སྤྲུལ་པའི་རྣམ་གྲངས་དང་།",
    "རྡེའུ་ཤིང་རང་འགྱུར་གྱི་བོན་ལ་སོ་སོར་གཅོད་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལས་སྤྲུལ་པའི་རྣམ་གྲངས་དང་།",
    "དམའ་ཡང་མཐོ་སར་འདུག་ལ།",
    "མཚོའུ་ལྡིང་ལྡིང་ནི་མཐོ་ཡང་དམའ་ས་ན་འདུག་པ་དང་འདྲ་སྟེ།",
    "མི་དང་ལྷ་ཡི་གནས་ན་འདུག་པ་ནི།",
    "ཕྱི་དུས་སུ་ཐོན་པའི་གཏེར་ཁུངས་དང་གཏེར་སྟོན་གཅིག་མིན་ཙམ་ལས་དཔེ་གཞི་གཅིག་ཏུ་ཆོག་པར་འདུག་ནའང་།",
    "དེ་ཐམས་ཅད་ཀྱང་རང་འོད་ཀྱི་ཡུམ་དང་མཉམ་པར་སྦྱོར་བ།",
    "འབྲས་བུ་ཐམས་ཅད་ད་བྱིངས་ཡེ་ཤེས་རངལས་ཤར་ཞིང་རང་སར་ཐིམ",
    "བསྒྲིགལྟར་ན་གནངབ་སྦྱིན་པ་འདི་ལ་གསན་པས་ཁྱབ་པར་གདའ།",
    "གཉིས་པཁྱེད་རང་རྣམས་ཀྱིས་རིག་པའི་རང་ངོལ་ཡེནས་བཙོས་སླད་མེད་པ་མཚོན་བྱེད་མན་ཤེལ་ཁྱེད་རང་རྣམས་ཀྱི་མིག་ལམ་དུ་བསྟན་ཅིང་ངོ་སྤྲད་པ་ནི",
    "ཁྱེད་རང་རྣམས་ཀྱི་ལུས་ལ་གདགས་པའི་མེས་པ་མཛོད།",
    "རྣམ་གཡེང་ཐམས་ཅད་སྤང་ལ་གཅིག་པུར་འདུའདུག།",
    "སྒོ་ཡུལ་འདུག་སྟངས་སོགས་ཀྱི་རྐྱེན་དང་།",
    "ཕྱིམའི་མཐའ་གར་ཟད་ཅིང་འདུག་སྙམ་སྟེ།",
    "ཕལ་ཆེར་ཁྲིད་ལུགས་འདིར་བཀོད་པ་རྣམས་ཀྱིས་གནས་པ་སྐྱེ་བ་འོང་བར་འདུག།",
    "མཉམ་བཞག་དུས་སྐད་ཅིགན་འཕྲ་མཐའ་སེམས་སུ་ཆོད་པ་དང་གཉིས་འདྲ་ནོར།",
    "གདན་གྱི་སྟེང་དུ་སེང་གེ་འགྱིངས་ཚུགས་སུ་འདུག་ལ་ལགསོར་གཉིས་ནང་ངུ་ཐེ་བོངབཅང་སྟེ།",
    "བདུན་པ་ཆུ་སྲིན་གྱི་འདུག་སྟངསན།",
    "སྔ་དྲོ་གླང་ཆེན་གྱི་འདུག་སྟངས།",
    "ཐོརངས་སེང་གེའི་འདུག་སྟངས་ཀྱིས་ཉམས་སུ་བྲད་དོ།",
    "དེར་མ་ཟད་གཞནགྱི་འབྱོད་པ་ལ་ཡང་ཚང་འདུག་སྟེ།",
    "གཞན་ཡང་རང་ལ་བས་གོས་མཐུན་རྐྱེན་སྦྱོར་བ་པོ་རྣམས་ཀྱང་ཡོད་སྙམཇུབསམ་པའོ།",
    "དེས་ན་ཚ་དམྱལ་གྱི་གནས་སུ་སྐྱེསན་སྡུག་བསྔལ་དེ་ལྟ་བུ་མྱང་དགོས་འདུག་ཨང་སྙམ་དུ་བསམ།",
    "ཐུམྱང་དགོས་པ་འདུག་ཨང་སྙམ་དུ་བསམ།",
    "དེ་སན་འཇིག་རྟེན་མི་ཡུལ་དུ་སྐྱེས་ཀྱང་སྡུག་བསྔལ་དེ་ལྟ་བུ་ཞིག་མྱང་དགོས་པར་འདུག་སྙམ་དུ་བསམ།",
    "དེའི་ཕྱིརན་ལྷ་མིན་གྱི་གནས་ཨུ་སྐྱེས་ཀྱང་སྡུག་བསྔལ་དེ་ལྟ་བུ་ཞིག་མར་དགོས་པར་འདུག་ཨང་སྙམ་དུ་བསམ",
    "མ་རྨོས་པའི་ལོ་ཏོག་ཀྱང་རང་བཞིན་གྱིས་ཡལ།",
    "དེའང་རང་ལྟ་སྐུ་ཡབ་ཡུམ་གསལ་བ་ལ་ཐིམ།",
    "ཁཝོ་སོགས་གང་འདྲ་ཞིག་འདུག་བརྟགས་ཤིང་དཔྱད།",
    "གམ་ཅི་འདྲ་ཞིག་འདུག་བརྟབ།་",
    "གསང་བརྣམ་གཡེང་བསྒུལ་བསྐྱོད་སྤངས་ཏེ་གཅིག་བུར་འདུག་པའོ།",
    "ཙོག་པུར་འདུག་ལ་ལག་གཉིས་སར་འཛིང་ཀྱིས་བུ་ཨོཾལ་བསྐོར་རམ།",
    "མལ་ན་འདུག་ཀྱང་རུང་ལུས་ཀྱི་འགྲོ་བའི་བྱ་བས་མ་ཟིན་པའི་ཡུལ་དེར་འགྲོ་བར་བྱའོ་སྙམ་པའི་ཡུལ་དེར་འགྲོ་བར་འདོད་པའི་བློ་དང་།",
    "བ་དག་འདུག་པ་དང་།",
    "ནང་ན་འདབ་བདག་ནི་མལ་ན་འདུག་བཞིན་དུ།",
    "དམན་ལ་བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "ངན་ཇི་ལྟར་བདག་ཡིད་བདེ་བར་འདུག།",
    "ཚག་བད་ང་རང་བཞིན་ཁ་ན་མ་ཐོ་འམ།",
    "ག་ཡས་ག་པ་ཡག་པོ་གདའདེ་བཞིན་ཕྱར་ཀ་གཏོང་ཡང་རུང་།",
    "ནག་པ་འདུག་འདས།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "ཕྱོགས་ཏེ་ག་དུས་ག་སྨྲ་བ་ཇི་ལྟར་སྨྱོན་པ་མིན།་།",
    "ཀ་ཁ་འགས་རབད་ག་དུས་ཐུབ་པས་རྟག་ཏུ་དེ་བཞིན་སྤྱད།",
    "རྐང་པ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "བ་ཅན་ལ་ཁྲི་ལ་སོགས་པ་ལ་འདུག་པ་ན་རྐང་པ་གཉིས་ས་ལ་བརྐྱང་སྟེ་མི་འདུག་ཅིང་།",
    "སྔར་ལུས་ཇི་ཙམ་ཆུད་ཟོས་ཀྱང་རང་དོན་དང་གཞན་དོན་གང་ཡང་མ་གྲུབ་པས་འགྱོད་པ་དང་།",
    "དང་པོ་སྔར་ལུས་ཇི་ཙམ་ཆུད་ཟོས་ཀྱང་རང་དོན་དང་གཞན་དོན་གང་ཡང་མ་གྲུབ་པས་འགྱོད་པ་ནི།",
    "བྱོརདེ་ན་བདག་ཉིད་ཀྱང་ནི་ཇི་ལྟར་འདུག།",
    "གཞན་ཡང་བྱིས་པ་ནི་རང་ལས་མཐོ་བ་ལ་ཕྲག་དོག་དང་མཉམ་པ་ལ་འགྲན་ཅིང་རང་ལས་དམའ་བ་ལ་དམིགས་ནས་ང་རྒྱལ་དང་བསྟོད་ན་དྲེགས་པ་སྐྱེ་ལ་མི་སྙན་པ་བརྗོད་ན་ཁོང་ཁྲོ་སྐྱེ་བས་དུས་ནམ་ཞིག་བྱིས་པ་དང་འགྲོགས་པ་ལས་ཕན་པ་ཐོབ་མི་ཐོབ་པར་མ་ཟད་གཞན་ཡང་བྱིས་པ་དང་འགྲོགས་ན་གྲོགས་བྱིས་པ་གཞན་ལ་བདག་བསྟོད་ཅིང་གཞན་ལ་སྨོད་པ་དང་།",
    "ན་ཅུང་ཟད་ལྷན་ཅིག་གནས་ཀྱང་དེ་ལ་ཞེན་པ་དགོས་པ་མེད་དེ་སྐྱེ་ནའང་རང་ཉིད་གཅིག་པུ་སྐྱེ་འགྱུར་ཞིང་འཆི་ནའང་དེ་ཉིད་གཅིག་པུ་འཆི་སྟེ།",
    "ཀཚུ་གྲོ་མི་གཙང་རང་བཞིན་གཞན་གྱིས་ལུས།",
    "དེ་ཁོ་ན་ཉིད་རྟོགས་དགོས་ཀྱང་རང་རྒྱུད་ཀྱི་སྡུག་བསྔལ་ཞི་བ་ལ་དེ་ཁོ་ན་ཉིད་རྟོགས་ཅི་དགོས་སྙམ་ན།",
    "ཤུགས་རྟོགས་ཀྱི་ཐ་སྙད་འདོགས་སམ་མི་འདོགས་ཀྱང་རུང་རང་ཉིད་ལ་རང་ཉིད་མི་སྣང་ཡང་རྟོགས་པའོ།",
    "ཤེས་པས་ཀྱང་རང་གཞན་གཉིས་ཀ་རིག་པར་བྱེད་པ་ཡིན་ནོ་ཞེ་ན།",
    "ངས་མཐོང་ངོ་ཞེས་ཡུལ་ཅན་དྲན་པའི་རྟགས་ལས་ཡུལ་ཅན་མྱོང་བ་ཡོད་པར་གྲུབ་ལ་ཡུལ་ཅན་མྱོང་བ་དེ་ནི་རང་རིག་ཡིན་ལ་སྔོ་འཛིན་མྱོང་བྱེད་གང་ཡིན་མཐའ་གཞན་འགོག་པའི་རིགས་པས་ཀྱང་རང་རིག་གྲུབ་བོ་ཞེ་ན།",
    "ལུང་གཞན་ལ་ཡང་རང་གཞན་དག།",
    "ཁ་དཀར་དང་གལ་ཏེ་བདག་འགའ་རང་བཞིན་གྱིས་གྲུབ་པ་ཡོད་པ་ནི་དེར་ཞེན་པ་ལས་ཡུལ་ཅི་ཡང་རུང་བ་ལ་འཇིགས་པ་སྐྱེ་རིགས་པར་འགྱུར་ན་བདག་ཉིད་འགའ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་ཅུང་ཟད་ཀྱང་ཡོད་པ་མིན་པས་འཇིགས་པར་འགྱུར་བ་པོ་དེ་སུ་ཞིག་ཡིན་ཏེ།",
    "སྐྱེས་བུ་གཅིག་ལྟོས་ས་ཐ་དད་ལ་ལྟོས་ནས་ཕ་དང་བུར་འཇོག་པ་བཞིན་དུ་རྣམ་འགྱུར་དང་རང་བཞིན་ལ་ལྟོས་ནས་གཟུགས་འཛིན་པའི་ཚེ་སྒྲའི་རྣམ་པར་འགྱུར་བ་མེད་ཀྱང་སྒྲའི་རང་བཞིན་ཡོད་དེ་གཟུགས་སྒྲ་གཉིས་རང་བཞིན་གཅིག་པའི་ཕྱིར།",
    "གལ་ཏེ་སྒྲ་འཛིན་ལས་ཚུལ་གཞིན་གཟུགས་འཛིན་དེ་ཉིད་སྒྲ་འཛིན་དང་རང་བཞིན་གཅིག་ཡིན་པས་སྐྱོན་མེད་དོ་ཞེ་ན་དེའི་རང་བཞིན་གཅིག་ཉིད་དེ་ནི་སྔོན་མེད་ཞིག་སྟེ་སོ་སོ་ཐ་དད་པའི་ཁོ་ནར་གནས་པའི་ཕྱིར་རོ།",
    "དེས་གང་ཟག་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པའོ།",
    "འདུག་ད་དུང་ལྟོ་དང་རྒྱབ་ཀྱང་ལུས་མིན་ཏེ།",
    "ཕྱོགས་ཀྱི་ཆར་དབྱེ་བ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དེ་རང་བཞིན་གྱིས་གྲུབ་པའི་ཆ་ཤས་དང་བྲལ་བའི་ཕྱིར་དཔེར་ན་ནམ་མཁའ་བཞིན་ནོ།",
    "བཞི་པ་དེས་གང་ཟག་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པ་ནི།",
    "ལུས་བཞིན་དུ་ཚོར་བ་ཡང་རང་བཞིན་མེད་པར་བསྟན་པ་ནི།",
    "དེ་ན་གཉིས་མི་འདུག་པའི་ཕྱིར།",
    "སེམས་དེ་ལུས་དང་འདྲེས་པ་མིན་ཞིང་ལུས་ལས་ལོགས་སུའང་ཡན་དགར་བ་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་པ་དེ་ནི་ཅུང་ཟད་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པ་ཡོད་མིན་པ་དེའི་སེམས་རང་བཞིན་གྱིས་སྟོང་པ་དེ་ཉིད་རང་བཞིན་མྱ་ངན་ལས་འདས་པའོ།",
    "གཞུང་རྐང་པ་བཞི་པོ་འདིས་མུ་གསུམ་ལས་སྐྱེ་བ་བཀག་པའི་མཇུག་སྡུད་ལ་སྦྱར་ཡང་རུང་ཞིང་རང་གཞན་གཉིས་ཀ་ལས་སྐྱེ་བ་འགོག་པའི་རིགས་པ་ལ་ཡང་སྦྱར་རོ།",
    "ཁཆང་ཆ་ཀ་ག་ནས་པ་མ་ཡིན་འགྲོ་མ་ཡིན།་",
    "ཁ་ན་མྱུ་གུ་ལ་སོགས་པའི་འབྲས་བུ་རྣམ་ཆུ་ལུད་དྲོད་གཤེར་ལ་སོགས་པ་སོ་སོ་བ་རྣམས་ལ་གནས་པའམ་ཐམས་ཅད་འདུས་པའི་རྐྱེན་རྣམས་ལ་ཡང་རང་བཞིན་གྱིས་འཁར་གཞོང་ལ་རྒྱ་ཤུག་བརྟེན་པའི་ཚུལ་དུ་གནས་པ་མ་ཡིན་ཏེ་དེ་ཡོད་ན་དམིགས་སུ་རུང་བ་ལས་མ་དམིགས་པའི་ཕྱིར་དང་།",
    "འགྲོ་བ་འདི་དག་ཐམས་ཅད་ནི་རྟག་ཏུ་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་དང་མ་འགགས་པ་ཉིད་དང་བཟོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་འདས་པ་ཉིད་དོ།",
    "དེ་ཐམས་ཅད་གོ་ཡུལ་དུ་ལུས་ཤིང་ཚིག་ཏུ་ཤོར་ནས་འདུག་པ་སྙམ་དུ་ཐག་བཅད།",
    "ལྷ་འདྲེ་ཕ་མ་རུ་ཤེས་པས་དྲིན་ལན་ལ་ཇི་ལྟར་བྱ་སྙམ་པ་བྱུང་ཙ་ན་ཆོད་པ་ཡིན་ནོ།",
    "བསྐྱེད་རིམ་བསྒོམ་ཡང་མ་འབྱོངས་པར་འདུག་པ།",
    "ཆེ་ཆུང་ཇི་འདྲ་འདུག་བལྟས་པས་མ་རྙེད་པ་ན་སེམས་མ་གྲུབ་པས་འཇིགས་མཁན་སྟོང་པར་ཤེས་པར་བྱའོ།",
    "ཆེ་ཆུང་ཇི་འདྲ་འདུག་བལྟས་པས།",
    "གང་དུ་ཡང་གྲུབ་པ་མི་འདུག་པ་དེ་ཀའི་ངང་དུ་བཞག་པར་བྱའོ།",
    "མེད་ན་གྲོགས་དང་ཆགས་སེམས་སྐྱེ་བའི་གཏམ་བརྗོད་པས་སྐྱེས་ཙ་ན་ངོ་བོ་ལ་ལྟ་བ་ལ་སོགས་གོང་བཞིན་བཅད་དོ།",
    "རིག་པ་ངར་བསྐྱེད་ལ་གནས་ལུགས་ཀྱི་རང་ཞལ་ལྟ་ཞིང་རང་སར་བཞག་གོ།",
    "དེ་ཙ་ན་འཆི་ནུས་དགོས་པར་འདུག་པས།",
    "འོ་ན་རྟོག་པ་ཐམས་ཅད་སྣང་ཡུལ་མེད་པ་ཉིད་དུ་འགྲུབ་སྟེ་ཞེས་གསུངས་པའི་གཞུང་ཁྱེད་རང་ལྟར་ན་ཇི་ལྟར་དུ་འཆད་ཅེ་ན།",
    "འཇུག་དུས་ཀྱི་རང་མཚན་གཉིས་ལས།",
    "ཡང་རང་མཚན་དེ་ཉིད་དངོས་སུ་འཇལ་ན་གཟུང་ཡུལ་ཡིན་ཏེ།",
    "ཡང་རང་མཚན་དེ་ཉིད་ལྐོག་གྱུར་དུ་འཇལ་ན་ཞེན་ཡུལ་ཡིན་ཞིང་།",
    "ད་ལྟའི་མི་འགའ་ཞིག་ཀྱང་འདིའི་ཕྱོགས་སུ་འདུག་པར་བྱེད་དོ།",
    "ཡོད་པ་ལ་ཡོད་པར་ཤེས་པ་གཉིས་ཀ་ཡང་རང་མཚན་ལ་མི་བསླུ་བ་ཡིན་ཏེ།",
    "འདི་ལྟར་དེ་ལ་གཅིག་དམིགས་པ་ངེས་པ་ཡོད་པ་ཐམས་ཅད་ཀྱིས་རང་རང་སོ་སོའི་རིག་པའི་ཕྱིར་རོ།",
    "གང་ཟག་རང་རང་ལ་སེམས་དང་སེམས་བྱུང་དུ་སྣང་བ་ཡང་རྫས་ཐ་དད་པ་མི་བཞེད་ལ།",
    "སྐད་ཅིག་དུས་ཆ་གསུམ་དུ་འགྱུར་། གཉིས་པ་དག་ནི་དུས་མཚུངས་ན།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "འོ་ན་ཁྱེད་རང་ཡིད་དཔྱོད་ཁས་ལེན་ནམ་མི་ལེན་ཞེས་རྣམ་པར་རྟོག་ན།",
    "ཁྱེད་རང་ལ་ཡང་མཚུངས་སོ་ཞེ་ན།",
    "དངོས་པོ་དང་རང་མཚན་ལ་ཁྱད་པར་འབྱེད་ཅིང་།",
    "རྫས་སུ་ཡོད་ཅེས་བྱ་བ་དང་རང་བཞིན་ཡོད་ཅེས་བྱ་བ་དང་དོན་དམ་པར་ཡོད་ཅེས་བྱ་བ་དག་དང་དོན་གཅིག་སྟེ།",
    "རྫས་དང་རང་བཞིན་དུ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "རང་རང་ངོ་བོ་ལ་གནས་ཕྱིར།",
    "སྤྱི་དངོས་པོ་བ་གཅིག་དུས་མཉམ་ཐམས་ཅད་དུ་གནས་པར་འདོད་པའི་ཕྱིར་རོ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "དེ་དང་རང་མཚན་ལ་བློས་འབྲེལ་པ་ཙམ་ཡང་མེད་པའི་ཕྱིར།",
    "འཇུག་དུས་སུ་རྣམ་གཅད་ལ་དངོས་སུ་མ་བརྟེན་པར་ཡང་དོན་ལ་འཇུག་གོ་ཞེས་འཆད་པ་ཡིན་ནོ།",
    "བརྡ་དུས་སུ་རང་མཚན་མཐོང་ཡང་འཇུག་དུས་སུ་སྤྱི་ལ་བརྡ་སྦྱོར་བའི་ཚུལ་དང་།",
    "དེ་དང་རང་མཚན་ལ་འབྲེལ་པ་མེད་པས་སོ།",
    "འཇུག་དུས་ཀྱི་བླང་དོར་ཐམས་ཅད་གཞན་སེལ་གྱིས་བྱེད་པས་སེལ་བའི་རྒྱུ་འབྲས་ཇི་ལྟར་འགལ།",
    "འོན་ཀྱང་རང་མཚན་རྟོག་པ་ནི།",
    "དོན་སྤྱི་དང་རང་མཚན་གཉིས་གཅིག་ཏུ་བསྲེས་ནས་བརྡ་ཆད་ཀྱི་སྔགས་ཀྱིས་འཁྲུལ་དུ་འཇུག་ལ།",
    "དེས་ན་གཞུང་ཁ་ཅིག་ལས་དགག་བྱའི་རྒྱུ་དང་རང་བཞིན་ཁེགས་ན།",
    "མུན་པ་ནུས་མེད་འགག་པ་ཉིད་སྣང་བ་སྐྱེས་པ་ཡིན་པས་སྐྱེ་འགག་དུས་མཉམ་སྟེ།",
    "དོན་ནི་སྐད་ཅིག་དུས་ལ་ལྟོས་པས་ཆ་མེད་ཡིན་ཞིང་།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "དེའང་རང་རིག་པའོ་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "དེ་ཡང་རང་དོན་ལ་ནི་རྒོལ་བ་དང་།",
    "ཁྱུང་དང་ལོ་ཙཱ་བས་སྒྲ་དོན་དང་རང་མཚན་སོ་སོར་ཕྱེ་ནས་ལན་འདེབས་པ་ནི་གཞན་སེལ་མ་མཁྱེན་པར་ཟད་དོ།",
    "དངོས་པོ་ཇི་ལྟར་གནས་པ་བཞིན་འདུག་པ་བདག་དང་འབྲས་བུ་དང་མི་དམིགས་པ་རྣམས་ལ་ནི་མི་སྲིད་དེ་ཞེས་དང་།",
    "སྤྱི་ཡང་ཐམས་ཅད་ན་གནས་པ་དང་རང་དང་འབྲེལ་པ་ཅན་དང་གཅིག་ཆར་དུ་འབྲེལ་ལོ་ཞེས་སྨྲ་ལ།",
    "དོན་ནི་དགག་སྒྲུབ་ཐམས་ཅད་གཞན་སེལ་གྱིས་བྱེད་པས་སྒྲ་དོན་དང་རང་མཚན་རྐྱང་པ་ནི་བསྒྲུབ་བྱ་མ་ཡིན་ལ།",
    "མཁས་པ་རྣམས་ཀྱིས་ཁྲེལ་ཞིང་རང་ཉིད་ངོ་ཚ་བའི་གནས་ཡིན་ནོ།",
    "རང་རིགས་འཕེན་པ་རྣམས་གསུམ་བྲི་། ལྷག་མ་དྲུག་དང་རང་བཞིན་དང་།",
