    "ཟས་ཟོས་༧ཀྱི་འོག་ཏུ་ཁྱིམ་པ་འདུག་པ་ལ་མ་བསྒོ་བར་ཁྱིམ་རྣམས་སུ་རྒྱུ་བར་བྱེད་པ་ད་ང་།",
    "རྟོགས་པའི་སྒོ་ནས་ནི་མངོན་སུམ་དུ་བྱ་བྱ་བའོ་། དུས་སུ་གཏམ་༡ཞེས་བྱ་བ་ནི་ཕ་རོལ་པོ་སྟན་དམའ་བ་ལ་འདུག་པ་ལ་སོགས་པའི་སྒོ་ནས་ཉན་པ་དང་འདོད་པ་དང་ཉན་པར་འོས་པར་ཤེས་ཤིང་འདི་ནི་སྔར་གཏམ་བྱ་བའི་དུས་ཡིན་ནོ།",
    "རངས་པར་བྱེད་པ་ནི་ཡང་དག་པར་བླངས་ཏེ་འདུག་པ་རྣམས་ལའོ།",
    "གུས་པར་བྱ་བ་ནི་སེམས་དམའ་བས་སྟན་༧དམའ་བ་ལ་འདུག་སྟེ་་སྤྱོད་ལམ་ཕུན་སུམ་ཚོགས་པར་༐",
    "ཞིག་པ་ནི་གང་ཞིག་༥ན་ལུས་རོར་འདུག་པའོ།",
    "རྒྱགས་པར་འགྱུར་བ་ནི་རྒྱགས་པའི་རྒྱུ་ཀུན་ཏུ་བསླངས་ནས་འདུག་པའོ།",
    "ནང་སྟེ་འདུག་པ་ནི་འཁྲུགས་པའི་མཇུག་ཏུ་༐",
    "ཇི་ལྟར་འདུག།",
    "སླ་བ་ཡིན་ཏེ་འགྲོ་ཡང་རུང་སྡོད་ཀྱང་རུང་འདུག་ཀྱང་རུང་ཉལ་ཡང་རུང་སྟེ་སླ་བའི་ཕྱིར་དང་།",
    "ས་བོན་དེ་ཡང་དེ་ཉིད་ཀྱི་ས་བོན་འདུག་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འབྲས་བུ་འབྱིན་པར་ནུས་པ་ནའོ།",
    "སྒལ་ཚིགས་ཕྱོགས་སུ་མདུན་གྱིས་ཕྱོགས་ཤིང་༢ཞེས་བྱ་བ་ནི་མ་ད་ང་བསྟེན་པར་འདོད་པས་ཞུགས་པའི་ཕྱིར་སེམས་དེ་དང་རྗེས་༤མཐུན་པར་འདུག་པ་ལ་བྱའོ།",
    "ཕྱི་མ་ལ་མཐོ་རིས་སུ་འགྱུར་བའི་སྦྱིན་པ་ད་ག་དུས་དུས་སུ་སྦྱིན་པར་མི་བྱེད་པ་ཡིན་ཏེ།",
    "བསྡུས་པ་༥བྱས་ཏེ་འགགས་པ་༦ན་ཤུགས་གནས་པ་དེ་ལྟ་བུའི་གནས་སྐབས་སུ་འདུག་གོ་ཞེས་ཟེར་རོ།",
    "འཇིག་རྟེན་ན་ཡང་འགྲོ་འོང་སྒྱེལ་འདུག་པ།",
    "གལ་ཏེ་འགའ་ཞིག་ཁ་ན་མ་ཐོ་བ་དང་བ་ཅས་པ་ལ་དགའ་བ་དང་ལྡན་པ་མ་ཡིན་དུ་ཟིན་ཀྱང་རང་བཞིན་གྱིས་ཆུང་བ་དང་།",
    "དོན་གང་རང་ལ་ངེས་ན་གཞན་ལ་ཡང་གོ་བར་བྱེད་པའི་ཕྱིར་ར་རོ།",
    "མངོན་སུམ་ནི་ནོར་བ་ཉིད་ཡིན་ཡང་རང་རིག་པ་ཡིན་པའི་ཕྱིར་ར་རོ།",
    "བསམ་པ་དང་རང་བཞིན་ཤེས་ནས་ལྷན་ཅིག་འགྲོགས་པར་བྱ་ཞིང་།",
    "རང་བཞིན་གྱིས་༦རྨོངས་པར་འདུག་པ་ཉིད་ནི་ཞུམ་པ་ཞེས་བྱ་བས་བསྟན་ཏོ།",
    "བཀུར་སྟིར་བྱ་བར་འོས་པ་རྣམས་ལ་ཡང་ལང་ས་ནས་མདུན་དུ་བསུ་བས་སྟན་སྟོབས་༡པར་བྱེད་ཅེས་བྱ་བ་ནི་སྟན་ལ་འདུག་ཅིག་པར་གོ་བར་བྱེད་པའོ།",
    "སོ་སོར་བརྟགས་པ་ནས་སེམས་གཟུའོ་ཙམ་དུ་རྣམ་པར་གཞག་པར་བྱའོ་ཞེས་བསྟན་པའི་ཕྱིཕྱིར།",
    "དེ་ལྟ་བུར་ཡོངས་སུ་གཟུང་བའི་ཚོགས་དེ་དག་ལ་ཡང་རང་ལ་ཕན་པ་ནི་མེད་པ་ཉིད་དོ།",
    "དེས་ན་སྨྲས་པ་གང་དག་ཐག་རིང་པོ་ན་འདུག་པ་ཡང་རུང་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རྣམ་པ་འདི་དག་དུས་གཅིག་ཏུ་མཁྱེན་པའི་ཕྱིར་སྨྲས་པ།",
    "སྟན་ཆེས་མཐོན་པོ་ལ་འདུག་པ་ལ་མ་ཡིན།",
    "ཡུལ་དེ་ན་ཉེ་བར་གནས་པའི་འཁོར་དང་༡གཉེན་རྣམས་ཀྱི་ད་པོན་ཡིན་ན་ཡང་སོ་སོ་རང་རང་བདག་པོར་གྱུར་པ་ཡིན་པའི་ཕྱིར་བྲན་ནི་མ་ཡིན་པས་དེའི་ཕྱིར་སྟོབས་ཀྱིས་ཕྲོགས་ནས་སྦྱིན་པར་མི་བྱའོ།",
    "སྐྱིད་དེ་བར་འདུག་པ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཚོགས་ཀྱི་ནང་ན་འདུག་ཀྱང་སེམས་དབེན་པར་གྱུར་ཏེ།",
    "གནས་ཤིང་ཞེས་བྱ་བ་བསྟན་པ་ནི་འདུག་པས་ཞེས་བྱ་བྱ་བའོ།",
    "བཟོད་པ་གོམས་པར་བྱས་པས་མངོན་དུ་ཕྱོགས་པར་གྱུར་པས་འདུག་པ་ནི་གནས་པའོ།",
    "ཞེས་བྱ་བ་ལ་རྒྱུན་དུ་གནས་ཤིང་གཅིག་ཏུ་རྒྱུད་ལ་ཞེན་པར་འདུག་པ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "གཅིག་ཏུ་རྒྱུད་ལ་ཞེན་པར་འདུག་པ་ཞེས་བྱ་བ་ནི་ཚོར་བ་དེ་ཉིད་རྒྱུད་ལ་ཞེན་༐",
    "མུ་སྟེགས་ཀྱི་གནས་ཐམས་ཅད་ན་ཡང་འདུག་པར་སྣང་ལ།",
    "ཉན་ཐོས་དང་རང་སང་ས་རྒྱས་རྣམས་ནི་མ་ཡིན་ན་ནོ།",
    "༡༦༡༩ ༡པེ་སྣར་བཞག་ཚོས་ཚན་འདིའི་ནང་དུ་གཞག་ཅེས་པ་རྣམས་པེ་སྣར་ལ་བཞག་ཅེས་འཁོད་འདུག་ཀྱང་བསྡུར་མཆན་དུ་འཁོད་མེད།"
  ]
}