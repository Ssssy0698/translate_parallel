    "སྟོང་པ་ཉིད་ནི་རྣམ་པར་དག་པ་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "སྟོང་པ་དག་པར་དེ་ཐོབ་ན་བདག་མེད་པའི་མཆོག་ཐོབ་པ་ཞེས་བྱའོ།",
    "ཟག་པ་མེད་པའི་དབྱིངས་ན་སྟོང་པ་ཉིད་རྣམ་པར་དག་པ་ཐོབ་ནས།",
    "དེའང་ནམ་གཟུང་འཛིན་གྱི་དྲི་མ་ལས་དག་པར་གྱུར་ན་བདག་མེད་པའི་མཆོག་ཏུ་གཞག་གོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རབ་རིབ་ཞི་བ་དང་པ་མེད་པ་དང་འགག་པར་གྱུར་པ་དེ་རབ་རིབ་ཀྱི་དངོས་པོར་གྱུར་པ་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "གལ་ཏེ་དེའི་ཚེ་ཐམས་ཅད་དུ་མེད་པར་གྱུར་ན་ནི་ལྕགས་ཀྱང་མེད་པར་གྱུར་པས་ལྕགས་ཀྱི་བྱ་བ་བྱེད་པ་ཡང་མེད་པར་མི་འགྱུར་ཏེ།",
    "ནམ་སེམས་རྣམ་པར་གྲོལ་བ་དང་།",
    "ཤེས་རབ་རྣམ་པར་གྲོལ་བའི་དུས་ན་འདོད་ཆགས་ཀྱི་ཚ་བ་དང་།",
    "སེམས་རྣམ་པར་གྲོལ་བ་དང་།",
    "ཤེས་རབ་རྣམ་པར་གྲོལ་བ་ཕྱི་ན་ཡོད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་འདོད་ཆགས་དང་བྲལ་ན་ནི་སེམས་རྣམ་པར་གྲོལ་བར་འགྱུར་ཏེ།",
    "མ་རིག་པ་དང་བྲལ་ན་ནི་ཤེས་རབ་རྣམ་པར་གྲོལ་བར་འགྱུར་ཏེ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཐོབ་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "འདོད་ཆགས་མེད་པ་ལས་བྱུང་བ་ནི་སེམས་རྣམ་པར་གྲོལ་བ།",
    "མ་རིག་པ་མེད་པ་ལས་བྱུང་བ་ནི་ཤེས་རབ་རྣམ་པར་གྲོལ་བ་སྟེ།",
    "དེ་ལ་རྣམ་པར་གྲོལ་བའི་མཚན་ཉིད་ནི་འདི་ལྟ་སྟེ།",
    "རྣམ་པར་གྲོལ་བ་ལ་རྣམ་པར་གྲོལ་བ་ཉིད་དུ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པ་ནི་ཤེས་རབ་རྣམ་པར་གྲོལ་བའོ།",
    "དེ་ལ་དེ་བཞིན་གཤེགས་པ་རྣམས་ཟག་པ་མེད་པའི་དབྱིངས་ལ་བཞུགས་པའི་ཚེ།",
    "བདག་ཏུ་འཛིན་པ་མེད་པ་དེ་དག་ལ་ནི་ལུས་ཐ་དད་པ་གཞག་པར་མི་ནུས་ཀྱི།",
    "བདག་ཏུ་འཛིན་པ་ཡོད་པ་དེ་ལ་ནི་ལྷ་སྦྱིན་གྱི་ལུས་འདི་ནི་མཆོད་སྦྱིན་གྱི་ལུས་ཐ་དད་པར་གཞག་པར་ནུས་སོ།",
    "སེམས་ཙམ། མིའི་༡༤གཅིག་པར་གནས་པའི་ཕྱིར་རོ།",
    "མཐར་ཐུག་པར་འགྲོ་བའི་ལས་དང་།",
    "༢ རྣམ་པར་མི་རྟོག་པའི་ལས་དང་།",
    "ཟླ་བ་ཉ་བའི་དུས་ན་ཟླ་བ་ཆ་༧ ཤས་རྫོགས་པས་ད་རྫོགས་པར་བྱ་བ་ཅུང་ཟད་ཀྱང་མེད་དེ།",
    "འོན་ཀྱང་སྒྲོ་བཏགས་ནས་ཐམས་ཅད་དུ་བྱས་ཏེ།",
    "འདྲེས་པའི་ལས་བྱས་པའི་དོན་ནི་དེའོ།",
    "བྱ་བ་གཅིག་ཏུ་འཇུག་པར་བསྟན་ཏེ།",
    "ཡེ་ཤེས་སྣང་བ་བྱེད་པར་འདོད།",
    "དེ་བཞིན་གཤེགས་པ་གཞན་གྱིས་༧ཀྱང་ཡེ་ཤེས་ཤེས་བྱ་ཀུན་ལ་སྣང་ཞིང་ཁྱབ་པར་བྱེད་ལ།",
    "ཁ་ཅིག་ནི་སྔར་མཁྱེན་ཁ་ཅིག་ནི་ཕྱིས་མཁྱེན་ཞེས་ཅི་བྱ་བ་མེད་པར་དུས་གཅིག་ཏུ་ཕུང་པོ་དང་ཁམས་ལ་སོགས་པའི་ཤེས་བྱ་རྣམ་པ་སྣ་ཚོགས་མ་ལུས་པ་མཁྱེན་ཏོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འདིས་ནི་རྣམ་པར་མི་རྟོག་པའི་ལས་བསྟན་ཏོ།",
    "ཉི་མའི་འོད་ཟེར་སྟོང་དང་ལྡན་པར་འདོད་དེ།",
    "ཐོགས་པ་མེད་པར་དུས་གཅིག་ཏུ་ཐམས་ཅད་ཐུགས་སུ་ཆུད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "སྤྲིན་ལ་སོགས་པས་བསྒྲིབ་པར་འདོད།",
    "སྤྲིན་དང་ཁང་ཁྱིམ་དང་སྐྱབས་ལ་སོགས་པས་བསྒྲིབས་ན་འོད་ཟེར་མི་སྣང་སྟེ་། ཉི་མའི་འོད་ཟེར་གྱིས་བསྒྲིབས་ཏེ་མི་སྣང་བར་བྱས་པ་ནི་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྤྲུལ་པ་རྣམ་པ་སྣ་ཚོགས་འགྱེད་པར་མི་ནུས་པས་སྐྱིན་རྣམ་པར་གྲོལ་བ་བཀྲ་བ་ིམ་ཡིན་ནོ།",
    "ང་ཐམས་ཅད་བྱེ་བྲག་མེད་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་ཚིགས་སུ་བཅད་པ་གཅིག་སྨོས་སོ།",
    "དག་པར་གྱུར་པ་དེ་ནི་དེ་བཞིན་གཤེགས་པ་ཞེས་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཏའབྱོར་པ་རྣམ་པར་དབྱེ་བ་ིཚིགས་སུ་བཅད་པ་བཅུ་གཅིག་གོ་ཞེས་བྱ་བ་ལ།",
    "སྐྱིད་པ་དང་ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པ་ལྔ་པ་དང་ལྡན་པར་སྟོན་ཏོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དཔེ་ལ་སོགས་པར་ཡང་མི་རུང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཚིགས་སུ་བཅད་པ་གསུམ་པའི་བསྡུས་པའི་དོན་ནི་རྣམ་པར་རབ་ཏུ་དབྱེ་བའི་ཁྱད་པར་དང་།",
    "བསམ་གྱིས་མི་ཁྱབ་པར་སྟོན་ཏེ།",
    "བསམ་ཡས་དཔག་ཏུ་མེད་པར་འདོད།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་འབྱོར་པ་དང་ལོངས་སྤྱོད་ནི་བསམ་གྱིས་མི་ཁྱབ་པར་འདོད་པ་དང་།",
    "དཔག་ཏུ་མེད་པར་འདོད་དེ་ཞེས་བྱ་བའི་དོན་ཏོ་། ཇི་ལྟར་ཞེ་ན།",
    "འཇིག་རྟེན་གྱི་ཁམས་དཔག་ཏུ་མེད་པར་ཞུགས་པའི་ཕྱིར་རོ།",
    "བདེ་བ་མང་པོ་བྱས་པ་ཕན་མང་པོ་བཏགས་པ་ཡང་གྲངས་མེད་ལི།",
    "བསྐལ་པ་གྲངས་མེད་པའི་བར་འཇུག་ཅིང་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "ཚིགས་སུ་བཅད་པ་ལྷག་མ་རྣམས་ཀྱིས་ནི་གཞན་དུ་འགྱུར་བའི་ཁྱད་པར་གྱིས་འབྱོར་པའི་ཁྱབ་པར་བསྟན་ཏོ།",
    "འབྱོར་པའི་མཆོག་ཀྱང་ཐོབ་པར་འགྱུར།",
    "མིའི་༡༤ཀུན་ཀྱང་བྱེད་པར་ནུས་ཏེ།",
    "ཞེས་རྣམ་པར་ཤེས་པ་ཙམ་དུ་སྟོན་པའི་བསྟན་བཅོས་ལས་འབྱུང་སྟེ།",
    "དེའི་དོན་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ལས་གཟུང་བ་དང་འཛིན་པའི་བག་ཆགས་དང་།",
    "དེ་ལས་འབྱོར་པ་མཆོག་རྣམ་པ་གཉིས་ཐོབ་པར་གྱུར་པས་ན་ཡུལ་མེད་པར་ཡང་གནས་གཞན་དུ་གྱུར་པར་༧རུང་སྟེ།",
    "འབྱོར་པ་དམ་པ་ཐོབ་པར་འགྱུར།",
    "དེ་ལ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཡང་ཡང་དག་པར་ལྡན་ཞིང་བྱུང་སྟེ།",
    "མཉམ་པ་ཉིད་ཀྱི་ཡེ་ཤེས་སུ་གྱུར་ན་འབྱོར་པ་དམ་པ་མཆོག་ཐོབ་པར་གྱུར་ཏོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
