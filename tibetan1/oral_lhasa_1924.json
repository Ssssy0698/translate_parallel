    "ལུད་པར་གྱུར་པ་མེད་པས་ན་འཕེལ་བར་འགྱུར་བ་སྟེ།",
    "འདུས་མ་བྱས་སོ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་དེ་ཡང་དེའི་རྒྱབ་ནས་ཐོབ་པ་དང་།",
    "དག་པ་འཇིག་རྟེན་པའི་ཡེ་ཤེས་ཀྱིས་ཕྱིན་ཅི་མ་ལོག་པར་ཤེས་པར་བྱེད་ཀྱི་ཡེ་ཤེས་གཞན་གྱིས་ནི་མ་ཡིན་ཏེ།",
    "དེ་བས་ན་དེའི་རྒྱབ་ནས་ཐོབ་པ་དག་པ་འཇིག་རྟེན་པའི་ཡེ་ཤེས་ལ་དངོས་པོར་ཤེས་པ་ཞེས་བྱ་སྟེ་འདིར་འདིས་ནི་གནས་ངན་ལེན་གྱི་རྟེན་ཀུན་གཞི་གནས་གཞན་དུ་གྱུར་པར་བསྟན་ཏོ།",
    "དག་པ་འཇིག་རྟེན་པའི་ཡེ་ཤེས་ཀྱིས་རྣམ་པར་མི་རྟོག་པའི་རང་བཞིན་ཕྱིན་ཅི་མ་ལོག་པར་རྟོགས་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱང་ས་དང་པོའི་དུས་སུ་༧ ཐོབ་བོ།",
    "མི་༡༤རྣམ་པར་དག་པ་བཤད།",
    "རྫོགས་ལོངས་སྤྱོད་ཅེས་བྱ་བས་རྫོགས་པར་ལོངས་སྤྱོད་པའི་སྐུ་བསྟན་ཏེ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་གནས་གཞན་དུ་གྱུར་ནས་སོ་སོར་ཀུན་དུ་རྟོག་པའི་ཡེ་ཤེས་སུ་གྱུར་ཏེ།",
    "ཡང་ན་རྣམ་པར་མི་རྟོགས་པའི་ཡེ་ཤེས་ཀྱི་རྗེས་ལས་ཐོབ་པ་དག་ལ་ིའཇིག་རྟེན་པའི་ཡེ་ཤེས་ལ་རྫོགས་ལོངས་སྤྱོད་པའི་སྐུ་ཞེས་བྱ་སྟེ།",
    "གསེར་ལ་སོགས་པ་བསྟན་པར་བྱ་བའི་ཕྱིར་དང་།",
    "སྤྲུལ་པའི་སྐུ་ནི་དཔག་ཏུ་མེད་པར་རིག་པར་བྱ་སྟེ།",
    "རྣམ་པར་གྲོལ་བའི་ཐབས་ཆེན་པོ།",
    "སྐུ་གསུམ་དུ་ཡང་ཤེས་པར་བྱ།",
    "རྫོགས་པར་ལོངས་སྤྱོད་པའི་སྐུ་དཔག་ཏུ་མེད་པ་རྣམས་དང་།",
    "སྤྲུལ་པའི་སྐུ་དཔག་ཏུ་མེད་པ་རྣམས་ཀྱང་སྐུ་གསུམ་དུ་འདུས་པར་རིག་པར་བྱ་སྟེ།",
    "རྫོགས་པར་ལོངས་སྤྱོད་པའི་སྐུ་དཔག་ཏུ་མེད་པ་ཅིཡང་རྫོགས་ལོངས་སྤྱོད་པའི་སྐུར་བསྡུ།",
    "སྤྲུལ་པའི་སྐུ་དཔག་ཏུ་མེད་པ་རྣམས་ལ་སྤྲུལ་པའི་སྐུར་བསྡུ་བར་རིག་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་མཉམ་པའོ་ཞེས་གསུངས་པ་དང་།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་སྐུ་རྟག་པའོ་ཞེས་གསུངས་པའི་དོན་བསྟན་པའི་ཕྱིར།",
    "མིའི་༡༤མཚུངས་པར་འདོད།",
    "རྒྱུན་མི་འཆད་པར་རྟག་པ་དང་།",
    "རྒྱུན་མི་འཆད་པར་རྟག་པ་ནི་རྫོགས་ལོངས་སྤྱོད་པའི་སྐུ་སྟེ།",
    "འཇིག་རྟེན་གྱི་ཁམས་ལ་ལར་མྱ་ངན་ལས་འདས་པ་བསྟན་ནས་མི་སྣང་བར་བྱས་ཀྱང་འཇིག་རྟེན་གྱི་ཁམས་གཞན་དག་ཏུ་སྐྱེ་བ་དང་།",
    "ཀུན་ནས་ལྷམ་མེ་ལྷག་གེ་ལྷང་ངེར་སྣང་ངོ་ཞེས་གསུངས་སོ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱིས་ནི་རྟག་མངོན་མེད་ཅེས་ཅིབྱ་བ་དང་པོ།",
    "དམིགས་པར་བྱེད་པ་མཉམ་པར་དམིགས་ཏེ།",
    "མི་ལྡན་པ་ཡང་མ་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "འཇིག་རྟེན་དང་ཞི་བར་བྱ་བ་རོ་གཅིག་པ་བྱ་བ་མཉམ་པ་ཉིད་ཡོངས་སུ་རྫོགས་པ་དང་ཞེས་གསུངས་སོ།་།",
    "ཐམས་ཅད་དུས་སུ་ལྡན་པར་རིག།",
    "བསམ་པ་བཞིན་དུ་སྐུ་སྟོན་པར་བྱེད་དོ།",
    "སོ་སོའི་སྐྱེ་བོའི་དུས་ན་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སེར་པོ་དང་།",
    "འཇིག་རྟེན་གྱི་ཁམས་ནི་ལན་ཅིག་ཏུ་རྣམ་པ་སྣ་ཚོགས་ཤེས་པར་འགྱུར་བ་དེ་བཞིན་དུ་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱི་སོ་སོར་རྟོག་པའི་ཡེ་ཤེས་ཀྱང་ཤེས་པར་བྱ་བ་ཐམས་ཅད་ལ་མི་ཆགས་པའི་ཡེ་ཤེས་རྣམ་པ་སྣ་ཚོགས་ཤེས་པར་བྱེད་པའི་རྒྱུར་འགྱུར་རོ་ཞེས་གསུངས་སོ།",
    "ཤེས་བྱ་ཐམས་ཅད་ལ་ཡེ་ཤེས་ཀྱིས་སྣང་བར་བྱེད་པའི་ཕྱིར་རོ་ཞེས་གསུངས་སོ།",
    "ཡང་ཤིན་ཏུ་ཡང་དག་པར་རྟོག་པའི་ཡེ་ཤེས་ནི་དེ་འདི་ལྟ་སྟེ།",
    "སོ་སོ་ཀྱི་ཡང་དག་པར་རིག་པ་དང་།",
    "ལྡ་ལྡི་རྣམ་པ་སྣ་ཚོགས་སྟོན་པར་བྱེད་དེ།",
    "དེ་ཡང་གྲངས་ཀྱིས་གཅིག་གཉིས་སམ་བརྒྱ་སྟོང་ཞེས་གྲངས་བཅད་པར་༤མི་ནུས་པ་ཞིག་སྤྲུལ་པར་མཛད་པས་ན།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔ་དག་པར་བྱེད་པ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡིན་པས།",
    "ད་དུང་དང་པོའི་དུས་ན་ཀུན་བརྟགས་ཀྱི་རང་བཞིན་མེད་པར་ཁོང་དུ་ཆུད་དོ།",
    "གཟུང་བ་དང་འཛིན་པའི་རང་བཞིན་ཀུན་བརྟགས་པ་དང་པོར་མེད་པར་གྱུར་པ་དེ་ཉིད་ཡོད་པའི་མཆོག་ཅེས་གདགས་ཏེ།",
    "དེ་ལྟར་དམིགས་སུ་མེད་པའི་མཚན་ཉིད་དུ་བསྒོམས་པ་ིན་འཚང་རྒྱ་བའི་ཐབས་སུ་འགྱུར་བར་བསྟན་ནས་དམིགས་པ་དང་བཅས་པ་རྣམས་ལ་འཚང་རྒྱ་བ་མེད་པར་བསྟན་པའི་ཕྱིར།",
    "ཐ་དད་བྱ་བ་བྱེད་ཅེས་སྨོས་ཏེ་། ལས་ཐ་དད་པར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "མི་༡༤པར་ིདཀའ་བས་ན་ཆུ་ཞེང་ཆེ་ལ་གཅིག་པ་ཞེས་བྱའོ།"
  ]
}