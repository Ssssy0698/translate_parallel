    "བག་ཆགས་དེ་ཡང་ཤེས་པར་བྱ་བ་དཀའ་ཞིང་སྤང་བར་བྱ་བ་དཀའ་སྟེ།",
    "རྟག་པར་ཞེས་བྱ་བ་ནི་ས་གཉིས་པ་ནས་ས་བཅུ་མན་ཆད་རྒྱུན་དུ་སྒྲིབ་པ་སྤོང་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དོན་དམ་པའི་ཡེ་ཤེས་ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཏེ།",
    "ལེགས་པར་གཞག་པ་ཞེས་བྱ་སྟེ།",
    "རྣམ་པར་དཔྱོད་པའི་སེམས་དང་།",
    "སེམས་ཙམ། མིའི་༡༤ཡོངས་སུ་སྨིན་པར་བྱ་བ་སྐྱོ་བར་མི་འགྱུར་བར་ཐབས་བསྟན་པའི་ཕྱིར།",
    "གང་ན་དུད་པ་ཡོད་པ་དེ་ན་མེ་ཡོད་པར་གདོན་མི་ཟ་བ་ིབཞིན་དུ་སྐྱེ་བ་ཡོད་ན་འཆི་བ་གདོན་མི་ཟ་བར་འབྱུང་ལ།",
    "མཐུའི་མཚན་ཉིད་རྣམ་པར་དབྱེ་བའི་རང་བཞིན་གྱི་དོན་གསུངས་སོ་ཞེས་བྱ་བ་ལ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ལ་གནས་པ་དང་།",
    "ཇི་ལྟར་རྣམ་པར་གཞག་པ་ཡིད་ལ་བྱེད་པའོ།",
    "གཟུང་འཛིན་ལ་མི་རྟོག་པའི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་དང་འབྲེལ་དེས་ཀྱང་ཡོངས་སུ་ཟིན་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "རྣམ་པར་གཞག་བཞིན་ཡིད་ལ་བྱེད་པ་ལས་། ཞེས་བྱ་བ་ནི་དེའི་ཚེ་ཅི་ཞིག་ཡིད་ལ་བྱེད་ཅེ་ན།",
    "དེ་གསུངས་པ་དང་།",
    "མཐུ་གྲུབ་པ་ཡི་དམ་པ་ཐོབ་པར་འགྱུར་བ་དང་།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་དང་མི་ལྡན།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་བཞི་ལ་གནས་པའོ།",
    "ཡང་དག་མཆོད་ཅིང་རྣམ་དག་འགུགས་པར་བྱེད།",
    "མེད་ཀྱང་སྐྱེ་བར་སྣང་འཇིག་པར་ཡང་སྣང་བས་སྒྱུ་མ་དང་འདྲའོ་ཞེས་མཐོང་ངོ།",
    "ཇི་བཞིན་འདོད་པར་དེ་དག་ཡང་དག་སྟོན།",
    "བདུད་ཀྱི་གནས་དང་བདུད་རྣམས་བསྐྱོད་ཅིང་སྐྲག་པར་བྱེད་པའི་ཕྱིར་འོད་ཟེར་གཏོང་ངོ།",
    "བདུད་བཅས་རབ་ཏུ་བསྐྱོད་ཅིང་སྐྲག་པར་བྱེད།",
    "བདུད་ཀྱི་གནས་གཡོས་པས་བདུད་རྣམས་ཀྱང་ིསྐྲག་པར་བྱེད་དེ།",
    "རྣམ་པར་རོལ་པའི་ལས་དང་སྤྲུལ་པའི་ལས་ལས་བརྩམས་ཏེ་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "༡༡༡༡འཁོར་གྱི་ིདབུས་སུ་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་པ་དང་།",
    "འདི་ནི་རྣམ་པར་རོལ་པའི་ལས་དེ་ལས་རྣམ་པ་ལྔའོ།",
    "པི་ཝང་མཁན་ལ་སོགས་པའི་བཟོའི་གནས་རྣམ་པ་སྣ་ཚོགས་བྱེད་པར་སྤྲུལ་པ་ནི་ལས་སྤྲུལ་པ་ཞེས་བྱ་སྟེ།",
    "ཁྲོ་ཞིང་ཡོངས་སུ་དག་པར་བྱེད་པ་ལས་བརྩམས་ཏེ་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལས།",
    "ཅེས་བྱ་བ་འདི་སྣོད་ཀྱི་འཇིག་རྟེན་དག་པར་བྱེད་པ་སྟོན་ཏེ།",
    "གང་དག་པར་བྱེད་པ་སྟེ་རྣམ་པ་གཉིས་སོ།",
    "སྐྱེ་དགུ་རྣམས་ལ་ཚིག་གཟུང་འོས་པར་འགྱུར།",
    "འགོག་པའི་སྙོམས་པར་འཇུག་པ་དང་།",
    "གྱ་ནོམ་པར་མཐོང་སྟེ།",
    "དེ་ལ་ཚོགས་པ་སྐྱེས་ནས་ཐོབ་པར་བྱ་བའི་ཕྱིར་འབད་པར་བྱེད་དེ།",
    "དེ་ལྟ་བུའི་མཐུ་ཡོད་ན་ཡོངས་སུ་སྨིན་པའི་མཚན་ཉིད་དུ་གྱུར་པར་རིག་པར་བྱའོ།",
    "དེའི་འོག་ཏུ་ཚིག་རྣམས་ནི་མི་བརྗེད་པར་ཚིག་འཛིན་ནུས།",
    "སེམས་ཙམ། མིའི་༡༤ཡང་ཡོངས་སུ་སྨིན་པར་འགྱུར་བའི་མཚན་ཉིད་དོ།",
    "ནམ་ཡོངས་སུ་སྨིན་པར་གྱུར་པ་དེ་ནི་སྤོང་བའི་ཡན་ལག་ལྔ་དང་ལྡན་ཏེ།",
    "དགའ་བ་ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་རྒྱུ་དང་།",
    "རྒྱུན་མི་འཆད་པར་འཇུག་པས་ན་བརྩོན་འགྲུས་ཆེ་བ་ཞེས་བྱའོ།",
    "སེམས་ཙམ། མི་༡༤པར་བྱེད་པའོ།",
    "ཏིང་ངེ་འཛིན་ཐོབ་པ་དང་འབྲས་བུ་མྱོང་བ་གཉིས་ནི་ལས་ཡིན་པར་རིག་པར་བྱའོ།",
    "ཡོད་པར་རྟོག་པ་དང་།",
    "མེད་པར་རྟོག་པ་དང་།",
    "༢ རྟག་པར་རྟོག་པ་དང་།",
    "མི་རྟག་པར་རྟོག་པ་ལ་སོགས་པ་སྟེ།",
    "ཁྱད་པར་འགྲོ་དང་ཞེས་བྱ་བ་ལ།",
    "ལས་གསུམ་དང་ལྡན་ན་ཡོངས་སུ་སྨིན་པ་ཡིན་པར་བསྟན་ཏོ།",
    "གནོད་པ་བྱས་པ་དག་ལ་བཟོད་ཅིང་ཉམས་སུ་ལེན་ཏོ།",
    "ཁྱད་པར་འགྲོ་དང་ཞེས་བྱ་བ་ལ།",
    "འདིས་ནི་ཡིད་རྣོ་བ་རྣམ་པར་སྨིན་པའི་རྒྱུ་བསྟན་ཏོ།",
    "ཤེས་རབ་དང་ལྡན་པས་ན་བདག་དང་གཞན་གྱིས་ལེགས་པར་སྨྲས་པ་དང་།",
    "ཉེས་པར་སྨྲས་པ་ངོས་ཟིན་ཅིང་རྟོགས་ཏེ།",
    "འདིས་ཚིག་འདི་སྨྲས་པ་ནི་མ་ནོར་ཏེ་ལེགས་པར་སྨྲས་པ་ཡིན་ནོ་ཞེས་རྟོགས།",
    "འདིས་ནི་ཚིག་འདི་སྨྲས་པ་ནི་ནོར་ཏེ་ཉེས་པར་སྨྲས་པ་ཡིན་ནོ་ཞེས་རྟོགས་ཏེ།",
    "ལེགས་པར་སྨྲས་པ་དང་ཉེས་པར་སྨྲས་པ་ཁོང་དུ་ཆུད་པ་ནི་ཡིད་རྣ་བའི་རང་བཞིན་ནོ།",
    "དྲན་པ་ཡིན་ཏེ་ཞེས་བྱ་བ་ནི་མཉན་པ་ལ་སོགས་པ་མི་བརྗེད་པར་ནི་དྲན་པར་བྱེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཇི་ལྟར་བྱས་པ་མི་བརྗེད་པ་དང་།",
    "སྟོབས་དང་ལྡན་པ་བསྐྱེད་པ་ཡོངས་སུ་སྨིན་པ་ལས་པརྩམས་ཏེ་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ་སྟོབས་ཞེས་བྱ་བ་དང་།",
    "ཡེ་ཤེས་ཀྱི་ཚོགས་ཀྱིས་ཀྱང་ཡེ་ཤེས་ཀྱི་ས་བོན་རྟས་པར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟ་བུ་ནུས་པའི་ལུས་ཐོབ་པར་གྱུར་ན།",
    "ལས་གསུམ་དང་ལྡན་ན་མི་འཕྲོགས་པ་ཡོངས་སུ་སྨིན་པ་ཡིན་པར་བསྟན་ཏོ།",
    "ཁྱད་པར་རྙེད་དང་ཞེས་བྱ་བ་ལ།་",
    "རིགས་པས་རྣམ་པར་དཔྱོད་པའི་སེམས་དེས་རིམ་པར་གནས་པ་ལ་ཡང་ཞིང་སྐྱེ་ཤས་ཇེ་ཆེ་ཇེ་ཆེར་གྱུར་པ་ནི་ཁྱད་པར་རྙེད་པ་ཞེས་བྱའོ།",
    "དེ་ཡང་དཔེར་ན་ས་དང་པོའི་རིགས་པས་རྣམ་པར་དཔྱོད་ཅིཔའི་སེམས་པས།",
    "ས་གཉིས་པའི་རིགས་པས་རྣམ་པར་དཔྱོད་པའི་སེམས་ཤས་ཆེ་བས་ན་ཁྱད་ཞུགས་པ་ཡིན་ཏེ།",
    "འདི་ནི་མི་འཕྲོགས་པ་རྣམ་པར་སྨིན་པའི་ལས་རྣམ་པ་གཅིག་གོ།",
    "རིགས་༧པས་རྣམ་པར་དཔྱོད་པའི་སེམས་དང་ལྡན་པས་མུ་སྟེགས་པ་ལ་སོགས་པའི་ཕྱོགས་ནི་སུན་འབྱིན་པར་ནུས།",
    "མི་འཕྲོགས་པ་ཡོངས་སུ་སྨིན་པར་བྱེད་པའི་མཚན་ཉིད་དོ་ཞེས་བྱ་བ་ལ།",
    "ལ་ལས་གསུམ་དང་ལྡན་ན་མི་འཕྲོགས་པ་ཡོངས་སུ་སྨིན་པར་འགྱུར་བ་ཡིན་ནོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གནས་ཀྱང་བརྩོན་པར་རུང་ཞེས་བྱ་བ་དང་།",
    "མི་བདེ་བ་མེད་ཅིང་བརྩོན་འགྲུས་རྒྱུན་དུ་རྩོམ་པར་གནས་པའི་ལུས་ལ་ནི་གནས་ཀྱང་བརྩོན་པར་རུང་བ་ཞེས་བྱ་སྟེ།",
    "འདུ་འཛི་ཐམས་ཅད་སྤངས་ནས་ཤིང་དྲུང་བྲག་ཕུག་ལ་སོགས་པའི་གནས་དབེན་པ་དག་ན་གནས་པར་དགའ་བ་ནི་དབེན་པ་མཆོག་ལ་དགའ་བ་ཞེས་བྱ་སྟེ།",
    "ཞེས་བྱ་བས་གཞན་ཡོངས་སུ་སྨིན་པར་བྱ་བའི་རྟེན་དུ་གྱུར་པར་བསྟན་ཏེ།",
    "ཚེ་རབས་གཞན་དུ་མཐོ་རིས་དང་མྱ་ངན་ལས་འདས་པར་འཇོག་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་སྤྱད་ཅིང་སྨིན་པར་བརྗོད་ཅིང་བྱ་བ་ིསྨོས་ཏེ།",
    "ཡོངས་སུ་སྨིན་བྱེད་ཅེས་གསུངས་ཞེས་བྱ་བ་ལ།",
    "ལེགས་པར་སྨིན་བྱེད་ཅེས་བྱ་བ་ལ།",
    "བདག་མེད་པའི་རང་བཞིན་དུ་རྟག་པར་ཡང་དེ་ལྟར་ཕྱིན་ཅི་མ་ལོག་པར་འཆད་ཀྱི།",
    "དོན་དུ་ན་ཉན་ཐོས་རྒྱུན་དུ་ཞུགས་པ་དག་སྨིན་པར་བྱས་ན་ནི་དགྲ་བཅོམ་པའི་འབྲས་བུ་ཐོབ་པར་འགྱུར།་",
    "ཇི་ལྟར་རྒྱལ་སྲས་ཕན་པར་བསམ་པ་ཡིས།",
    "འགྲོ་བ་ཐམས་ཅད་རྣམ་པར་སྨིན་བྱེད་གནས།",
    "ཚེ་རབས་གཞན་དུ་མཐོ་རིས་དང་མྱ་ངན་ལས་འདས་པ་ལ་འཇོག་པར་མི་ནུས་པའི་ཕྱིར་ཏེ།",
    "འདིས་ནི་ཕ་མ་དང་གཉེན་བཤེས་ཀྱི་བསམ་པ་ལས་བྱེ་བྲག་ཏུ་འཕགས་པར་བསྟན་ཏོ།",
    "ཀརང་༡༡༤༡བདག་ལ་ཕན་པར་བྱ་ན་ཇི་ལྟར་བྱས་ན་ཕན་པར་འགྱུར་ཞེས་རྣམ་པ་དུ་མར་བསམས་ཀྱང་ཕན་པའི་བསམ་པ་དེ་ལྟ་བུ་མི་འབྱུང་སྟེ།",
    "བདག་ལ་ཕན་པར་བྱ་བར་བསམས་སུ་ཟིན་ཀྱང་ཕན་པ་མ་ཡིན་པ་དང་བདེ་བ་མ་ཡིན་པ་ལ་འགོད་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "བདག་ལ་བདེ་བར་བྱའོ་ཞེས་མ་བྱིན་པར་ལེན་པ་ལ་སོགས་པ་དང་།་",
    "བྱས་པ་དང་དེའི་རྐྱེན་གྱིས་ཚེ་འདིར་བཅིང་བ་དང་བསད་པ་ལ་སོགས་པ་ིམྱོང་བར་འགྱུར་བས་ཕན་པ་མ་ཡིན་པ་ལ་བཀོད་དོ།",
    "འདིས་ནི་འཇིག་རྟེན་པ་བདག་ལ་བྱམས་པའི་བསམ་པ་བས་ལྷག་པར་སྟོན་ཏོ།",
    "སེམས་ཙམ། ཀི་༡༤པར་བྱེད་པ་བསྟན་པ་ལས་འདི་ཡན་ཆད་ཚིགས་སུ་བཅད་པ་བཞི་ནི་བསྟན་ཟིན་ཏོ།",
    "མཚུངས་པར་སྦྱིན་པ་ཞེས་བྱ་བས་མི་མཚུངས་པ་མེད་པའི་སྦྱིན་པ་བསྟན་ཏེ།",
    "ལོའམ་བསྐལ་པ་འདི་སྙེད་ཅིག་ཏུ་བྱས་པས་མཆོག།",
    "ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ནི།",
    "དེ་ལ་ཚེ་འདིར་ཕན་བཏགས་༧པ་ནི་ཟང་ཟིང་རྣམ་པ་སྣ་ཚོགས་བྱིནཤས་ཡོ་བྱད་ཀྱིས་ཕོངས་པའི་གནོད་པ་མེད་པར་བྱ་སྟེ།",
    "ལོངས་སྤྱོད་དང་ལྡན་པོར་བྱས་པའོ།",
    "ཆབ་༡༡༤༥རྣམས་མི་བྱེད་པར་འཛེམ་པ་ཡོད་པ་དང་།",
    "ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་པ་ཡང་དེ་ལྟར་ཡང་ཅུང་ིཟད་ཀྱི་གཞན་ཡང་ཡོད་པར་བསྟན་པའི་ཕྱིར།་",
    "ཚེ་གཅིག་ནས་གཅིག་ཏུ་རྣམ་པར་སྨིན་པ་རྒྱུན་མ་ཆད་པར་བྱས་པ་དང་།",
    "འཚེ་བ་མེད་པའི་རྫོགས་པ་ནི་ལྷག་པར་མི་འཚེ་བའོ་ཞེས་བྱ་བ་ལ།",
    "ལྷག་པར་མི་འཚེ་བའི་དོན་འཆད་དེ།་",
    "སེམས་ཀྱི་སྒོ་ནས་བསམ་པར་བྱ་བ་མ་ཡིན་པ་དག་མི་བསམ་པ་ནི་བག་ཡོད་པ་ཞེས་བྱའོ།",
    "ཕ་རོལ་གནོད་པར་བྱེད་པ་ཕན་བྱེད་བློ།",
    "ཉེས་པ་བྱས་པ་དྲག་པོ་རབ་ཏུ་བཟོད།",
    "བ་༡༡༤༩བཟོད་པར་བྱས་ན་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་གྱུར་ན།",
    "ཕ་རོལ་གནོད་པར་བྱེད་པ་༧ ཕན་བྱེད་བློ།",
    "སྲོག་དང་སྲིད་ལ་འབབ་པའི་ཉེས་པ་བྱས་ན་ཡང་ཞེ་སྡང་མི་ལྡང་ཞིང་ཉམས་སུ་མི་ལེན་ནི།་",
    "སླར་གནོད་པའི་ལེན་མི་ལྗོན་པ་ནི་ཉེས་པར་བྱེད་པ་དྲག་པོ་བཟོད་པ་ཞེས་བྱའོ།",
    "ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "ཐབས་ཤེས་གནོད་པར་བྱེད་པའི་བཟོད་པ་ཡིས།",
    "གནོད་པར་བྱེད་པ་དག་ནི་དགེ་ལ་བཀོད།",
    "གནོད་པར་བྱེད་པ་རྣམས་ལ།",
    "ཚེ་འདིར་ཕན་འདོགས་པ་ནི་ཉེས་པ་དྲག་པོ་བྱས་པ་རྣམས་ལ་ཨིཡང་གནོད་པ་དྲག་པོ་དག་བཟོད་དོ།",
    "མིའི་༡༤བརྩོན་འགྲུས་ཇི་ལྟ་བུས་ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་པ་དེ་ལས་བརྩམས་ཏེ་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "ད་ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་པ་བསྟན་པའི་ཕྱིར་རོ།",
    "དེའི་རྒྱུས་ཚེ་རབས་གཞན་དུ་མཐོ་རིས་དང་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་བྱས་པ་ནི་ཚེ་རབས་གཞན་དུ་ཕན་བཏགས་པའོ།",
    "བསམ་གཏན་ཇི་ལྟ་བུས་ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་པ་ལས་བརྩམས་ཏེ་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "ཨ་སེམས་ཀྱང་རྣམ་པར་ཤེས་པ་ཀུན་ལ་མི་བྱའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་བྱའོ།",
    "ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "དད་པ་སྐྱེད་པར་བྱེད་ཅེས་བྱ་བའི་དོན་ཏོ།",
    "དེར་ཡང་མ་ཟད་ཀྱི་གཞན་ཡང་བྱེད་པར་བསྟན་པའི་ཕྱིར།",
    "ཤེས་རབ་ཇི་ལྟ་བུས་ཇི་ལྟར་ཡོངས་སུ་སྨིན་པར་བྱེད་པ་དེ་ལས་བརྩམས་ཏེ་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "ཚིག་འདིས་བདག་ཉིད་ཀྱི་ཡེ་ཤེས་ཀྱི་ཚོགས་ཀྱི་ཡོན་ཏན་ལ་གནས་པར་བསྟན་ཏོ།",
    "དགོངས་པའི་ཚུལ་ལ་ཐེ་ཚོམ་དུ་གྱུར་པ་རྣམས་ཀྱི་ཐེ་ཚོམ་བསལ་ནས་ཐེ་ཚོམ་མེད་པ་ལ་དགོད་པར་བྱེད་ཀྱི།",
    "སུ་དག་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "སུས་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "རྣམ་པ་དུ་དང་ཇི་ལྟ་བུས་ཡོངས་སུ་སྨིན་པར་བྱེད་ཅེ་ན།",
    "རྣམ་པར་མི་རྟོག་པ་ལྷུན་གྱིས་གྲུབ་པ་ཐོབ་པར་བྱས་པ་དང་།",
    "འཇིག་རྟེན་ཡོད་དང་མཉམ་པར་འཇུག་པས་འདུལ།",
    "འཇིག་རྟེན་ཡོད་དང་མཉམ་པར་འཇུག་པས་འདུལ།",
    "བདག་དང་གཞན་གྱི་དོན་ཡོངས་སུ་རྫོགས་པར་དགོས་ཏེ།",
    "ཡང་དག་པར་འཐོབ་པ་དང་།",
    "ཡང་དག་པར་ཐོབ་པ་ལ་རྣམ་པ་བཞི་སྟེ།",
    "འདི་ཡན་ཆད་ཡང་དག་པར་ཐོབ་པ་བསྟན་ཏོ།",
