    "གནོད་གནས་ཀྱི་རྟོག་པ་འདི་གསུངས་པ།",
    "སྔར་བརྗོད་པའི་ཆོ་གས་སྔོན་དུ་བསྙེན་ནཔ་བྱས་ལ།",
    "རྒྱ་མཚོའི་ཆུར་ཞུགས་རིལ་སྟོང་ཕྲག་བཅུ་བཟླས་པ་བྱས་ན་སྔོན་དུ་བསྙེན་པར་འགྱུར་རོ།",
    "ཆུ་བོ་དེ་ཉིད་ལ་རྐེད་པ་ནུབ་ཙམ་དུ་༡༢ཆུར་ཞུགས་ནས་པདྨ་ལ་ཞོ་དང་མར་དང་སྦྲང་རྩི་༡་སྦགས་ནས་སྟོང་ཕྲག་བཅུ་སྦྱིན་སྲེག་བྱས་ན་གཏེར་༧གྱི་བུམ་པ་རྙེད་པར་འགྱུར་རོ།",
    "དུས་གསུམ་དུ་སྟོང་ཕྲག་བརྒྱད་དུ་སྦྱིན་སྲེག་༢༧བྱས་ན་གང་༢་དོན་དུ་གཉེར་བ་དེ་ཐོབ་༢༨པར་འགྱུར་རོ།",
    "མྱ་ངན་མེད་ཀྱི་ཅམེ་ཏོག་ལ་ཞོ་དང་མར་དང་སྦྲང་རྩིས་བྱུགས་ཏེ་དུས་གསུམ་དུ་སྟོང་ཕྲག་བརྒྱད་དུ་སྦྱིན་སྲེག་༥བྱས་ན་གང་གསོལ་བ་བཏབ་པ་དེ་འཐོབ་༦པར་འགྱུར་རོ།་།",
    "མིང་བཟུང་ནནས་སྦྱིན་སྲེག་དེ་ཉིད་སྟོང་ཕྲག་བརྒྱད་སྦྱིན་སྲེག་བྱས་ན་རྒྱལ་པོའི་བུ་དེ་ཉིད་ཐོབ་པར་འགྱུར་རོ།",
    "མེ་ཏོག་དམར་པོ་མ་ཉམས་པ་ཡོངས་སུ་བཟུང་ནས་རྒྱ་མཚོར་འབབ་པའི་ཆུ་བོར་ཕྱིན་ལ་རྐེད་པ་ནུབ་ཙམ་དུ་ཆུར་ཞུགས་ནས་སྟོང་ཕྲག་བཅུར་༩སྦྱིན་སྲེག་བྱས་ན་གང་མེ་ཏོག་དེའི་དྲི་ཚོར་བ་དང་།",
    "འབུམ་ཕྲག་བཟླས་པས་རྒྱལ་པོ་འགུགས་རྣ་པར་འགྱུར་རོ།་",
    "སྔགས་བརྒྱ་རྩ་བརྒྱད་བཟླས་ན་གཏེར་ཐམས་ཅད་འགུགས་པར་འགྱུར་རོ།",
    "ཉིན་མཚན་བར་༡༡ཆོད་ཀྱི་ཟས་ཟ་བས་ཉི་ཤུ་རྩ་གཅིག་ཏུ་སྦྱིན་སྲེག་བྱས་ན་དགོས་པ་ཐམས་ཅད་སྒྲུབ་པར་ནུས་སོ།",
    "རྒྱ་སྐྱེགས་༡་ཀྱི་ཁུ་བ་དང་ཞོ་བསྲེས་ནས་སྲེག་བླུགས་༡་སྟོང་བྱས་ན་གསེར་སྲང་སྟོང་སྟེར་བར་འགྱུར་རོ།",
    "སྔགས་འདིས་སྦྱིན་སྲེག་སྟོང་བྱས་ན་དོང་ཙེ་བརྒྱ་༥རྙེད་པར་འགྱུར་རོ།",
    "ལེགས་པར་ཡན་ལག་སྟེར་བ་དང་།",
    "བསྐུལ་བའི་ཡི་གེ་དང་ཡང་དག་པར་ལྡན་པ་འདི།",
    "གཞན་མ་༢༩རྣམས་ལ་ནོར་བུ་བཟང་པོའི་གཟུགས་བྱས་ཏེ།",
    "དེ་ཉིད་དུ་ཟད་པར་བྱའོ།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་རྩ་བའི་སྔགས་ཀྱི་རྟོག་པ་གསུངས་པ།",
    "བསོད་སྙོམས་ཀྱིས་འཚོ་ཞིང་འབུམ་ཕྲག་གསུམ་བཟླས་པར་བྱའོ།",
    "ཟླ་བ་དྲུག་ཏུ་ཆུ་ནང་དུ་༡ཆུའི་སྦྱིན་སྲེག་བྱས་ན་སྟོང་ཕྲག་བརྒྱ་རྙེད་པར་འགྱུར་རོ།",
    "ཨ་ཤྭཏྠའི་ཡམ་ཤིང་ཞོ་དང་མར་དང་སྦྲང་རྩིས་སྦགས་ཅནས་སྟོང་ཕྲག་བརྒྱད་དུ་སྦྱིན་སྲེག་༥བྱས་ན་བར་སྣང་ལས་སྒྲ་ཐོས་པའམ་རི།",
    "སེམས་ཀྱིས་བྱས་པས་ཚོགས་པར་འགྱུར་རོ།",
    "བག་མེད་པས་སལས་མ་གྲུབ་ན་སྟོང་ཕྲག་བཅུའི་ནང་ནས་གྲོང་གཅིག་རྙེད་པར་འགྱུར་རོ།",
    "བསོད་སྙོམས་ཟ་ཞིང་རིགས་གཙང་མ་ལ་དུས་གསུམ་དུ་ཁྲུས་བྱེད་ཅིང་འབུམ་ཕྲག་གཅིག་ཏུ་བཟླས་ནས།",
    "ན་༢་ག་པུས་༢༡པ་ཞོ་དང་མར་དང་སྦྲང་རྩིས་སྦགས་ནས་སྟོང་ཕྲག་བརྒྱད་དུ་སྦྱིན་སྲེག་༢་བྱས་པ་དང་།་",
    "མངར་༡གསུམ་གྱི་བཤོས་གཙང་མ་དང་གཏོར་མ་བྱིན་ནས་སྦྱིན་སྲེག་༢ཡོངས་སུ་རྫོགས་པ་དང་།",
    "ཇི་སྲིད་དུ་སྟོང་ཕྲག་བརྒྱ་རྫོགས་པར་པདྨའི་༡༡སྦྱིན་སྲེག་བྱས་ན།",
    "དེ་ནས་གང་དུ་འགྲོ་བ་དེར་ཁྱེར་ནས་བྱིན་༡༩པ་དེ་ཟད་པ་མེད་པར་འགྱུར་རོ།",
    "བསོད་སྙོམས་ཟ་ཞིང་དུས་གསུམ་དུ་ཁྲུས་བྱས་ནས་འབུམ་ཕྲག་གསུམ་དུ་༢༧བཟླས་ལ་།",
    "དེ་ནས་སྒྲུབ་པ་པོས་གསོལ་བ་བཏབ་༧པར་བྱའོ།",
    "གཞན་ཡང་དེ་བཞིན་གཤེགས་པས་༡་ལས་ཀྱི་ཚོགས་བྱ་བ་གསུངས་པ།",
    "གཏོར་མའི་ཆོ་ག་རྒྱ་ཆེ་བ་བྱས་ནས་ཀུ་ཤའི་ཆུན་པོ་༡༥དག་བྱེད་ལོནས།",
    "ཨརྒ་སྦྱིན་པར་བྱའོ།",
    "བསོད་སྙོམས་ཟ་ཞིང་འབུམ་ཕྲག་གསུམ་བཟླས་ནས་དཀར་པོ་༤༥ཕྱོགས་ཀྱི་ཚེས་ལྔ་ལ་ཐུག་པར་ནུབ་གསུམ་དུ་སྨྱུང་བར་གནས་པས་རྒྱ་མཚོ་ཆེན་པོ་དང་ཉེ་བར་ཕྱིན་ནས།",
    "ཇི་༥སྲིད་རྒྱ་མཚོ་ཆེན་པོ་རང་འོང་བ་དེ་སྲིད་ཀྱི་བར་དུ་བཟླས་པར་༦བྱའོ།",
    "མར་གྱིས་བྱུགས་ནས་སྟོང་ཕྲག་བརྒྱད་དུ་༢་སྦྱིན་སྲེག་བྱས་ན་དོང་ཙེ་༢༥བརྒྱ་རྙེད་པར་འགྱུར་རོ།",
    "མ་གྲུབ་ན་ཡང་ཀཱར་ཥཱ་པ་ཎ་སྟོང་ཕྲག་གཅིག་༥རྙེད་པར་འགྱུར་རོ།",
    "༨དེ་ནས་ཡང་ནོར་བུ་བཟང་པོ་བསྒྲུབ་པར་འདོད་ན་མཆོད་སྦྱིན་གྱི་ཤིང་དཀར་པོ་ལ་ནོར་བུ་བཟང་པོའི་གཟུགས་བརྙན་བྱས་ལ།",
    "དེའི་མདུན་དུ་ཡང་༡༢ཨ་པ་མརྒའི་ཡམ་ཤིང་ལ་མར་དང་སྦྲང་རྩིས་བྱུགས་ལ་འབུམ་ཕྲག་ཏུ་སྦྱིན་སྲེག་༡་བྱས་ན་འདོད་པའི་འབྲས་བུ་རྙེད་པར་འགྱུར་རོ།",
    "བེ་ཏ་ལའི་མེ་ཏོག་རྣམས་ཀྱིས་འབུམ་ཕྲག་ཏུ་༡་སྦྱིན་སྲེག་དབྱས་ན།",
    "གསེར་སྲང་སྟོང་རྙེད་པར་འགྱུར་རོ།",
    "ཏིལ་དང་འབྲས་ཐུག་པོ་ཆེའི་སྦྱིན་སྲེག་འབུམ་བྱས་ན་གསེར་སྲང་སྟོང་རྙེད་པར་འགྱུར་རོ།",
    "ཆུ་བོའི་རྒྱུན་ལ་ལྟེ་བ་ནུབ་ཙམ་དུ་ཆུའི་ནང་དུ་ཞུགས་ནས་ཁ་ཤར་དུ་བལྟས་ཏེ་སྦྱིན་སྲེག་ད་བརྒྱ་བྱས་ན་སུམ་འགྱུར་གྱི་དོང་ཙེ་༢་རྙེད་པར་འགྱུར་རོ།",
    "རས་བལ་གྱི་ས་བོན་ལ་མར་དང་སྦྲང་རྩིས་བྱུགས་ནས་སྟོང་ཕྲག་གཅིག་༢༥སྦྱིན་སྲེག་༢༧བྱས་ན་ཉི་མ་བདུན་གྱི་བར་ལ་རས་གཅིག་རྙེད་པར་འགྱུར་རོ།",
    "རྟག་ཏུ་བཟླས་ན་གོས་དང་བཟའ་བ་རྙེད་པར་འགྱུར་རོ།",
    "འབུམ་དུ་༢་བཟླས་ན་དོང་ཙེ་༢་ལྔ་སྟོང་རྙེད་པར་འགྱུར་རོ།",
    "འབུམ་ཚོ་གཉིས་བཟླས་ན་གྲོང་རྙེད་པར་འགྱུར་རོ།",
    "འབུམ་ཚོ་གསུམ་བཟླས་ན་ལོངས་སྤྱོད་ཆེན་པོ་རྙེད་པར་འགྱུར་ཞིང་གྲོང་བརྒྱད་ཀྱི་བདག་པོར་འགྱུར་རོ།་",
    "བེའུའི་ལྕི་༡བ་ལ་སྦྱིན་སྲེག་༢སྟོང་བྱས་ན་བ་ལང་༣སྟོང་རྙེད་པར་འགྱུར་རོ།",
    "རིག་སྔགས་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "ཇི་ལྟར་འདོད་པ་རྙེད་པར་འགྱུར་རོ།",
    "ཤྲི་རི་པ་༡་ལའི་ཡམ་ཤིང་ལ་སྦྱིན་སྲེག་འབུམ་བྱས་ན་གང་འདོད་པའི་དོན་༡༡གསོལ་བ་བཏབ་པ་དེ་རྙེད་༡༢པར་འགྱུར་རོ།",
    "དུ་བ་དང་འབར་བས་འདི་ལྟར་ས་བླ་ས་འོག་ས་སྟེངས་༡་གསུམ་འགྲུབ་པར་འགྱུར་རོ།",
    "པདྨ་མར་དང་སྦྲང་རྩིས་བྱུགས་ནས་འབུམ་དུ་སྦྱིན་སྲེག་༥བྱས་ན།",
    "ཏིལ་ནག་པོ་ལ་མར་དང་སྦྲང་རྩིས་སསྦགས་ལ་འབུམ་དུ་སྦྱིན་སྲེག་འབྱས་ན་ནོར་ཉེ་བར་འཕེལ་བར་འགྱུར་རོ།",
    "ཨརྒའི་༡༥ཤིང་ལ་མེ་བཏང་ལ་སྟོང་ཕྲག་བརྒྱད་དུ་སྦྱིན་སྲེག་བྱས་ན།",
    "སྟོང་ཕྲག་བརྒྱད་དུ་སྦྱིན་སྲེག་བྱས་ན།"
  ]
}