    "ཁོས་ངས་སེམས་པ་གཞི་ནས་བཟི་སོང་།",
    "ཁོས་རང་གི་ཨ་ཕས་གློག་གཟིམས་ནས་ཕྱིར་ཉལ་ཁང་ནང་དུ་འགྲོ་བཞིན་པའི་སྒྲ་དེ་ཐོས་བྱུང་།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "མེ་འཁོར་ནི་རྡོ་དམར་གྱིས་གྲུབ་པའི་ཁང་བ་རིང་བོ་ཞིག་གི་མདུན་ནས་བསྐྱོད་ཅིང་།",
    "རྒྱ་མཚོ་འཁྱིལ་ནི་མཚམས་རེར་ཅུང་ཙམ་མཐོང་ཐུབ་ལ།",
    "ང་ཚོའི་མེ་འཁོར་ཆུ་འགྲམ་ནས་དུས་ཚོད་གཅིག་ཙམ་ལ་འདུག་ཆོག་པ་རེད།",
    "དེ་ནས་དེའི་བར་གྱི་འགྲོ་ལམ་ཕྲ་མོ་དེ་ཡིན།",
    "དེ་ནས་ཕར་སོང་ན་སྒེའུ་ཁུང་ཆེན་པོ་ཞིག་ཕྱེས་ཡོད་པའི་གནས་དེར་ཐོན་སྲིད།",
    "རྒྱབ་ཕྱོགས་ནི་བྲག་རི་ཆུང་ཆུང་ཞིག་གིས་བཟུང་ཡོད།",
    "མེ་འཁོར་གྱི་ལྕགས་ལམ་མང་པོ་སྦྲེལ་བའི་ས་གནས་ཤིག་ལས་བརྒལ་རྗེས་དལ་མོས་ངང་མེ་འཁོར་འབབ་ཚིགས་སུ་འབྱོར་བྱུང་།",
    "ལག་ཏུ་གཏེར་ཆུ་ཕྱེད་ཙམ་ལས་མེད་པའི་བཏུང་བ་ཞིག་བཟུང་ནས་འདུག་མོ་འབབ་ཚིགས་དེའི་འགྲམ་གྱི་ལམ་ཕྲན་བརྒྱུད་དེ་ཡུན་རིང་ཞིག་ལ་སོང་ཞིང་།",
    "ཨ་རིའི་ལྕམ་མོ་དེས་རྣ་བས་ཡང་དག་ཅིག་མི་གོ་བའི་རྐྱེན་གྱིས།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "མེ་འཁོར་མདུན་དུ་བསྐྱོད་དེ་རྟ་རྒྱུགས་འགྲན་རའི་ས་ཚིགས་དང་ཁ་བྲལ་སོང་།",
    "ཆུ་བོའི་སྟེང་གི་ཉི་འོད་སོགས་རེ་རེ་བཞིན་ཤུལ་དུ་བསྐྱུར་ནས་མེ་འཁོར་མདུན་བསྐྱོད་བྱས།",
    "མི་མང་པོ་ཞིག་གིས་ཁང་བ་མེར་འབར་གྱིན་པའི་རྣམ་པར་བལྟས་ནས་བསྡད།",
    "མི་དམངས་རྣམས་ས་ཚིགས་དེ་ནས་མེ་འཁོར་ལས་མར་འབབ་ཀྱིན་ཡོད་ལ་སླར་ཡང་མེ་འཁོར་དུ་འབུད་ཀྱིན་ཡོད།",
    "ཁོ་ཚོའི་དཀྱིལ་དུ་མི་དཀར་གྱི་དམག་དཔོན་འབྲིང་བ་ཞིག་ལངས་ནས་འདུགམེ་འཁོར་ནང་གི་ཉལ་སའི་ཁང་མིག་ཅིག་ཏུ།",
    "ཞབས་ཕྱི་བ་ཞིག་གིས་ལེའུ་དགུ་བ།",
    "འགྲོན་པོ་དག་ཉལ་དུ་འཇུག་པར་གྲལ་སྒྲིག་བྱེད་ཀྱིན་འདུག་མཚན་མོ་དེར།",
    "ཨ་རིའི་ལྕམ་མོ་དེ་གནས་དེར་ཉལ་ནས་ཡོད་མོད།",
    "ཨ་རིའི་ལྕམ་མོ་དེས་ཉལ་ཁྲི་སྒེའུ་ཁུང་གི་འགྲམ་ན་ཡོད་ཅིང་།",
    "མཚན་མོའི་དུས་སུ་མེ་འཁོར་ཚང་མ་མདུན་བསྐྱོད་བྱས་པའི་མྱུར་ཚད་ཧ་ཅང་མགྱོགས་པ་རེད།",
    "ཨ་རིའི་ལྕམ་མོ་དེ་ཐོག་མཐའ་བར་གསུམ་དུ་གནས་དེར་ཉལ་ནས་འདུག་ལ།",
    "ཨ་རིའི་ལྕམ་མོ་དེ་གཙང་སྤྱོད་ཁང་དུ་འགྲོ་བཞིན་འདུག་མོ་མཚན་གང་བོར་ཅུང་ཙམ་ཡང་གཉིད་མེད་མོད།",
    "ཕལ་བལྟས་ཚོད་ཀྱིས་བུད་མེད་དར་མ་ཞིག་ཡིན་པ་འདྲ་ཞིང་།",
    "ཨ་རིའི་བུད་མེད་ཅིག་གི་ཉམས་ཧ་ཅང་ལྡན།",
    "དེ་ནས་མེ་འཁོར་ཐོག་གི་ཟས་ཁང་གི་ནང་དུ་སོང་ནས་སྔ་མོ་ནས་ཞོགས་ཟས་ཟོས་པ་དང་།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "མོའི་འདུག་གནས་ཀྱི་འགྲམ་གྱི་སྒེའུ་ཁུང་གི་ཡོལ་བ་ཕྱེས་ཚེ་ཕྱི་རོལ་ལས་ཉི་འོད་རིམ་གྱིས་ནང་དུ་འཆར་ཡོང་ཞིང་།",
    "གསེར་བྱེའུ་གྱི་གཤོག་སྒྲོ་གཡུག་གིན་འདུག་སྐབས་དེར་མེ་འཁོར་པ་ལི་དང་བར་ཐག་རིང་བོ་མེད་པའི་གནས་སུ་ཐོན་གྱིན་འདུགཨ་རིའི་ལྕམ་མོ་དེས་གསེར་བྱེའུ་འདི་ཉི་འོད་ལ་ཧ་ཅང་དགའ་པོ་ཡོད།",
    "གསེར་བྱེའུ་དེས་རང་གི་མཆུ་སྒྲོས་ཀྱིས་རང་གི་གཤོག་པར་ལྡབས་ཀྱིན་འདུག་ཨ་རི་བུད་མེད་དེས་ང་རང་གསེར་བྱེའུ་འདི་ལ་ཧ་ཅང་དགའ་བོ་ཡོད།",
    "ངས་གསེར་བྱེའུ་འདི་རང་གི་བུ་མོ་ལ་ལེགས་སྐྱེས་སུ་སྟེར་དགོས།",
    "མེ་འཁོར་ང་ཚོས་གུང་ཟས་མ་ཟོས་པའི་སྔོན་དུ་ཕར་ཆེར་གནས་འདི་བརྒྱུད་ནས་སླེབས་སོང་།",
    "ཡུན་རིང་ཞིག་ལ་ཨ་རིའི་ལྕམ་མོ་དེས་ངའི་ཆུང་མར་ཁ་བརྡ་བྱེད་ཀྱིན་པ་མ་གོ།",
    "ཨ་རིའི་ལྕམ་མོ་དེས་ཁྱོད་ཀྱི་ཁྱོ་ག་ཡང་ཨ་རི་བ་རེད་དམ་ཞེས་དྲིས་བྱུང་།",
    "ངེད་གཉིས་པོ་ཨ་རི་ནས་རེད་ཅེས་བཤད།",
    "ངའི་སེམས་སུ་ཁྱོད་ཚོ་དབྱིན་ཇི་ནས་ཡིན་པར་འདོད་ཡོད།",
    "འོ་འོ་ངེད་གཉིས་དབྱིན་ཇི་ནས་མ་རེད།",
    "ངས་ཁྱོད་ཀྱི་དེ་ལྟར་འདོད་དོན་ངསཁུར་ཐག་ཅེས་པའི་ཐ་སྙད་དེ་བེད་སྤྱོད་བྱས་པས་ཡིན་ནམ་ཞེས་བཤད།",
    "ངས་དབྱིན་ཇི་ཡི་སྒྲ་གདངས་རྒྱུན་འཁྱོང་བྱེད་པའི་ཆེད་དུ་སླར་ཡང་ཁུར་ཐག་ཅེས་བཤད།",
    "མོའི་རྣ་བའི་སྒྲ་འཛིན་གྱི་ནུས་པ་དངོས་གནས་ཞན་པོར་ཆགས་འདུག་མོས་མི་གཞན་གྱི་མཆུ་དབྱིབས་ལ་བལྟས་ནས་སྐད་ཆའི་གོ་བ་ལེན་གྱིན་འདུག་ངས་མོས་ངོ་གདོང་དུ་མ་བལྟས་པར་ཕྱིར་རོལ་དུ་བལྟས་ནས་བསྡད་པ་ཡིན།",
    "མོ་དང་ངའི་ཆུང་མ་གཉིས་ཀྱིས་མུ་མཐུད་དུ་ཁ་བརྡ་བྱེད་ཀྱིན་འདུགཨ་རིའི་ལྕམ་མོ་དེས་ཁྱེད་ཚོ་ཨ་རི་ནས་ཡིན་པ་གསལ་དུ་ཤེས་པ་ཡིན།",
    "ཨ་རིའི་སྐྱེས་པ་ཚང་མ་ལྷན་སྐྱེས་ཀྱི་ཁྱོ་ག་ཡག་པོ་རེ་ཡིན་སྲིད་ཅེས་བཤད།",
    "ཁྱོད་ཀྱིས་ཤེས་སམ།",
    "ངས་མོ་ཁྲིད་ནས་སོང་བ་ཡིན་ཞེས་བཤད།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ངས་ཆུང་མས་མོའི་སྐྱེས་པ་དེ་སེམས་ནས་བརྗེད་སོང་བ་ཡིན་ནམ་ཞེས་དྲིས།",
    "ཨ་རིའི་ལྕམ་མོ་དེས་ངས་བསམ་ན་ཕལ་ཆེར་སེམས་ནས་བརྗེད་ཡོད་ས་མ་རེད།",
    "མོས་རྒྱུན་དུ་ཟ་མ་མི་ཟ་ཞིང་མཚན་མོ་གཉིད་ཀྱང་ཁུག་གིན་མི་འདུགངས་ཐབས་ཤེས་ཡོད་ཚད་བཏོན་པ་ཡིན།",
    "ཡིན་ནའང་མོ་ད་སྐབས་བྱ་དངོས་ཅི་ལའང་སྤྲོ་བ་མེད་པ་ལྟ་བུ་ཞིག་ཏུ་ཆགས་འདུག་དོན་དག་ཅི་ཞིག་ཡིན་རུང་མོས་དེ་ལ་དོ་སྣང་ཅི་ཡང་མི་བྱེད།",
    "གང་ལྟར་ཡང་ངས་རང་གི་བུ་མོ་ཕྱི་རྒྱལ་གྱི་མི་ཞིག་ལ་ཆུང་མར་སྟེར་ན་མི་འགྲིག་ཅེས་བཤད།",
    "ངས་བལྟས་ནའང་ཉན་ས་མ་རེད་ཅེས་བཤད།",
    "ཨ་རིའི་ལྕམ་མོ་དང་ངའི་ཆུང་མ་གཉིས་ཀྱི་འདོད་ཕྱོགས་གཅིག་ཏུ་བབས།",
    "ཚོང་ཁང་དེའི་ནང་དུ་ད་དུང་མོ་ངོ་ཤེས་པའི་མི་ཞིག་ཡོད།",
    "མོས་ཚོང་ཁང་དེའི་ནང་གི་ལྭ་བར་ཆེད་དུ་མོ་ལ་རྒྱུས་ལོན་བྱེད་དུ་བཅུག་ཅིང་།",
    "ལོ་ངོ་ཉི་ཤུ་ལྷག་གི་རིང་ལ་ཚོང་གཡོག་པ་འདི་གཉིས་ལས་གླ་མ་མྱོང་ཞིང་།",
    "རླངས་འཁོར་དེ་དག་དུས་མཚུངས་སུ་དབྱི་ཐ་ལིར་བསྐྱོད་དགོས་པ་རེད།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ངའི་ཆུང་མས་ཁྱོད་རང་ཨོ་ཝེ་དང་ཁ་བྲལ་ནས་ག་ཙམ་འགོར་སོང་ཞེས་མོ་ལ་དྲིས།",
    "ཁོ་མོས་ད་ལོའི་སྟོན་ཁར་ཐོན་དུས་ལོ་གཉིས་ཙམ་འགོར་སོང་།",
    "ངས་གསེར་བྱེའུ་འདི་རང་གི་བུ་མོར་ལེགས་སྐྱེས་སུ་ཁྱེར་ཡོང་བ་ཡིན་ཞེས་བཤད།",
    "ཨ་རིའི་ལྕམ་མོ་དེས་འོ་ལེ།",
    "ཁོ་དང་ཨོ་ཝེ་གཉིས་རྒྱུན་དུ་ངོ་ཐུག་ཅིང་མཉམ་དུ་འཆམ་འཆམ་དུ་ཡུན་རིང་རེ་ལ་འགྲོ་སྲིད་ཅེས་བཤད།",
    "ང་ཚོ་གནས་དེ་ནས་ཡུན་རིང་ལ་མཉམ་དུ་འགྲོགས་མྱོང་ཞེས་བཤད།",
    "ང་ལ་བསམ་ཚུལ་གཞན་པ་མེད་ཅིང་ངས་མོ་ལ་བཀག་འགོག་མི་བྱེད་ཅེས་བཤད།",
    "ངའི་ཆུང་མས་གནས་དེའི་མཛེས་ལྗོངས་ཧ་ཅང་ཡིད་དུ་འོང་བ་ཞིག་ཡིན་ཞེས་མོ་ལ་བཤད།",
    "ཨ་རིའི་ལྕམ་མོ་དེས་བདེན་པ་ཡིན་ནམ།",
    "ཁྱེད་ཚོ་གནས་གང་ཞིག་ནས་བསྡད་པ་ཡིན་ཞེས་མོ་ལ་དྲིས།",
    "ཨ་རིའི་ལྕམ་མོ་དེས་དེ་ནི་ཁྱིམ་ཆས་ཀྱི་རྣམ་པ་ཧ་ཅང་བརྗིད་ཉམས་ལྡན་པའི་ཟ་ཁང་རྙིང་བ་ཞིག་ཡིན་ཞེས་བཤད།",
    "ང་ཚོའི་སྤུས་ཀ་བཟང་བའི་ཁང་བ་ཞིག་གླས་པ་ཡིན།",
    "ང་ཚོའི་མེ་འཁོར་གྱི་འཁོར་སྒམ་གསུམ་ལ་དོན་རྐྱེན་བྱུང་འདུག་འཁོར་སྒམ་དེའི་སྒོ་དང་སྒེའུ་ཁུང་ཡོད་ཚད་ཕྱེས་ནས་ཡོད་ལ།",
    "ཨ་རིའི་ལྕམ་མོ་དེས་དོན་རྐྱེན་བྱུང་ཡོད་པའི་གནས་དེར་བལྟས་ནས་འདུགམོས་ཆེས་མཇུག་མཐའི་འཁོར་སྒམ་དེ་མཐོང་བའི་སྐབས་སུ།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ངས་རང་གི་ཁུག་མ་སྒེའུ་ཁུང་གི་འགྲམ་ནས་མར་དྲུད་དེ་སོང་བ་ཡིན།",
    "ང་ཚོ་མེ་འཁོར་ལས་བབས་སྟེ་མུན་ནག་གིས་བཏུམ་པའི་སྟེགས་བུ་དེས་ཐོག་ཏུ་སོང་བ་ན།",
    "ཨ་རིའི་ལྕམ་མོ་དེས་ཁེ་ཁི་ཡུལ་སྐོར་ལས་དོན་ཁང་གི་མི་གསུམ་གྱི་ཁྲོད་ནས་གཅིག་བཙལ་ནས་རྙེད་ཅིང་།",
    "ངས་ཁྱོད་ཀྱི་མིང་ཡིག་དེ་བཙལ་དགོས་ཞེས་མོ་ལ་བཤད།",
    "སྣེ་ལེན་པ་ཞིག་གིས་ངའི་སྒམ་དྲུད་ནས་མདུན་དུ་སོང་སྟེ་རླངས་འཁོར་ཞིག་གི་སྟེང་དུ་བཞག་ངའི་ཆུང་མ་དང་ཨ་རིའི་ལྕམ་མོ་དེས་ཕན་ཚུན་ལ་བདེ་མོ་བཞག་ཅིང་།",
    "ངས་ཀྱང་མོ་ལ་གནས་སྐབས་སུ་བདེ་མོ་བྱོས་ཞེས་བཤད།",
    "དེ་ནས་སླར་ཡང་ཤོག་ལྷེ་དེ་རང་གི་ཁུག་མའི་ནང་དུ་བཅུགངེད་གཉིས་ཀྱིས་སྒམ་དྲུད་ཡོད་པའི་སྣེ་ལེན་པ་དེའི་རྗེས་དེད་དེ་མེ་འཁོར་གྱི་འགྲམ་ནས་ཕར་བསྐྱོད་དེ་ཧ་ཅང་རིང་བོ་ཡིན་པའི་ཨར་འདམ་གྱི་སྟེགས་བུ་ཞིག་གི་ཐོག་ཏུ་སོང་བ་ཡིན།",
    "མི་ཞིག་གིས་མེ་འཁོར་གྱི་པ་སེ་ཚང་མ་ཕྱིར་བླངས་སོང་།",
    "ཞོགས་པ་སྔ་མོ་ནས་རི་འདབས་སུ་སོང་ཚེ།",
    "གསོམ་ཤིང་གི་ལོ་མའང་སྐམ་པོར་གྱུར་འདུག་རི་ལུང་ཀུན་དུ་དཔྱིད་ཀ་ཚེས་འདུག་ཅིང་ཉི་འོད་འཕྲོས་པ་ཧ་ཅང་དྲོ།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ངས་ཡོ་ཧན་ལ་ཁྱོད་ཀྱིས་བསམ་བློ་ཞིག་ཐོངས་དང་།",
    "མ་བསམ་ས་ནས་དེ་རིང་གི་ཉི་མ་འདི་ལྟ་བུ་ཞིག་ལ་མི་ཞིག་དུར་འཇུག་བྱེད་ཀྱིན་འདུག་ཅེས་བཤད།",
    "ང་ཚོ་ད་དུང་འདི་ལྟར་དུར་འཇུག་བྱེད་མི་རུང་ཞེས་ཁོ་ལ་བཤད།",
    "ང་ཚོ་མུ་མཐུད་དུ་ལམ་ཆེན་བརྒྱུད་ནས་མདུན་དུ་སོང་བ་ན།",
    "གྲོང་རྡལ་ཆུང་ཆུང་ཞིག་ལ་ཐོན་ཞིང་གནས་དེའི་འགྲུལ་ཁང་གི་གམ་དུ་འབྱོར།",
    "ང་ཚོ་ཞི་འེར་ཧྥོའུ་ལེ་ཐུ་ནས་ཟླ་བ་གཅིག་ཙམ་ལ་བསྡད་པ་ཡིན།",
    "ད་སྐབས་རི་ཞོལ་དུ་ཐོན་དུས་རི་ཁུག་གི་ཚོར་བ་ཧ་ཅང་སྐྱིད་པོར་སྣང་།",
    "ཞི་འེར་ཧྥུ་ལེ་ཐུ་ཡི་གངས་ཤུད་བྱེད་ས་དེ་ཧ་ཅང་སྐྱིད་པོ་ཞིག་རེད།",
    "ཤུད་བྱེད་ཆོག་གིན་འདུག་ཞོགས་པ་དང་ས་སྲོད་ཀྱི་དུས་སུ་ད་གཟོད་གངས་ཤུད་བྱས་ན་སྐྱིད་པར་སྣང་།",
    "ང་ཚོ་ཚང་མ་ཉི་འོད་ཀྱི་སྟེང་དུ་ཆགས་སྡང་ལངས་སྲིད།",
    "ཡིན་ནའང་ཁྱོད་རང་ཉི་འོད་ལ་རྒྱུན་དུ་གཡོལ་མི་ཐུབ།",
    "ཁང་ཆུང་གིས་འགེབ་སྲུང་དང་བྲག་རྡོ་རེ་འགའི་འོག་ཏུ་གྲིབ་མ་ཆུང་ངུ་རེ་ཡོད་སྲིད།",
    "འཁྱག་ཀླུང་གི་འགྲམ་གྱི་གྲིབ་ནག་གི་ནང་དུ་བསྡད་པ་ཡིན་ཚེ།",
    "ཉི་འོད་ཀྱིས་ངོ་གདོང་ནག་པོར་བསྒྱུར་བ་ནི་སྤྱིར་བཏང་དུ་དགའ་འོས་པའི་དོན་དག་ཅིག་རེད།",
    "རི་མགོ་ནས་རི་ཞོལ་དུ་བབ་སྟེ་ཁ་བ་དང་ཁ་བྲལ་ཐུབ་པ་ནི་ང་ལ་མཚོན་ན་སྤྲོ་སྣང་ཆེན་པོ་ལྡན་པའི་དོན་དག་ཅིག་རེད།",
    "དཔྱིད་ཀའི་དུས་སུ་རི་བོ་ཞི་འེར་ཧྥོ་ལི་ཐུའི་མགོ་རུ་འཛེགས་པ་ནི་ཧ་ཅང་འཕྱི་བའི་དོན་དག་ཅིག་རེད་ལ།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "མགྲོན་ཁང་གི་སྦྱིན་བདག་སྒོ་འགྲམ་དུ་བསྡད་ཡོད་ལ།",
    "འགྲུལ་ཁང་གི་སྦྱིན་བདག་གིས་སྐུ་ཁམས་བཟང་།",
    "འགྲུལ་ཁང་གི་སྦྱིན་བདག་གིས་རི་མགོ་ནས་སྐྱིད་དམ་ཞེས་དྲིས།",
    "ཇ་མ་འདུག་སྟེགས་སྟེང་ནས་མི་འགུལ་བར་རང་སར་བསྡད་འདུགའགྲུལ་ཁང་གི་སྦྱིན་བདག་གིས་ང་ཚོ་ནང་དུ་འགྲོ་བཞིན་པའི་རྣམ་པར་བལྟས་ནས་འདུག་གཞུང་ལས་ཁང་གི་སྒོ་ཕྱེས་རྗེས་ང་ཚོས་སྦྲགས་སྲིད་མར་བླངས་བྱུང་།",
    "སྦྱིན་བདག་གིས་སྦུ་རག་དམ་བེ་དོ་ཁྱེར་ནས་སླེབས་བྱུང་།",
    "ཐེངས་འདིར་བུད་མེད་ཅིག་གིས་ཆང་ཁྱེར་ནས་ཡོང་ཞིང་།",
    "མོས་འཛུམ་མདངས་དང་བཅས་ཏེ་ཆང་དམ་གྱི་ཁ་ཕྱེས།",
    "བུ་མོས་དེས་འཕྲིན་ཡིག་མང་པོ་ཞིག་ཐོན་འདུག་ཅེས་བཤད།",
    "ཡོ་ཧན་གྱིས་ངས་ད་དུང་སྦི་རག་གི་བྲོ་བ་དེ་བརྗེད་འདུག་ང་རི་མགོའི་ཁང་ཆུང་གི་ནང་དུ་ཡོད་པའི་དུས་ནས་ཆང་འཐུང་ན་འདོད་ཀྱིན་ཡོད།",
    "ད་སྐབས་ང་ཚོས་གཞི་ནས་འཐུང་ཐུབ་སོང་བ་རེད་ཅེས་བཤད།",
    "དོན་ངག་ཅི་ཞིག་བསྒྲུབ་ཀྱང་དེ་ཡུན་རིང་དུ་བསྲིངས་མི་ཆོག་དེ་འདྲ་ཞིག་རེད།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ལམ་འགྲམ་གྱི་སྡོང་བོ་ཡོད་ཚད་ཐལ་རྡུལ་གིས་བཟུང་ཡོད།",
    "ཐག་རིང་གི་ཡུལ་ཤིག་ན་སྔོ་ལྟེམ་ལྟེམ་གྱི་ས་ཞིང་དང་ཆུ་ཕྲན་ཞིག་ཡོད་པ་དང་།",
    "ཕྱེ་འཐག་ཁང་གི་བར་སྟོང་བརྒྱུད་དེ་མར་བལྟས་ན་ཤིན་ཏུ་རིང་བའི་སྡོང་བོ་ཞིག་ཡོད་ཅིང་།",
    "ཕར་བལྟས་ཚོད་ཀྱིས་སྡོང་བོ་དེ་སོག་ལེ་ཞིག་གིས་ཡར་མར་ཀུན་ནས་ཐེངས་མང་པོ་ཞིག་གཏུབ་ཡོད་པ་འདྲ་མོད།",
    "གནས་དེ་རུ་མི་ཞིག་གིས་ངལ་རྩོལ་བྱེད་ཀྱིན་པ་ཅེས་ཀྱང་མཐོང་མི་ཐུབ།",
    "ཁོ་སྒོ་རའི་མདུན་ནས་ཐད་གར་རྒྱབ་ཕྱོགས་ཀྱི་ཐབ་ཚང་ནས་དུ་སོང་།",
    "ཁང་བའི་ནང་དུ་ཉི་འོད་འཕྲོས་ཏེ་ཅོག་ཙེའི་སྟེང་གི་ཤེལ་དམ་གྱི་ངོས་སུ་འོད་ལམ་ལམ་འཚེར་ཞིང་།",
    "མི་གཉིས་སྒོ་འགྲམ་གྱི་སྐས་ཐེམ་གྱི་སྟེང་དུ་འགོས་སྟེ་ཆང་ཁང་གི་ནང་དུ་སོང་བ་མཐོང་།",
    "བུད་མེད་ཅིག་ནང་དུ་ཡོང་ནས་ཁོ་གཉིས་ཀྱི་ཅོག་ཙེའི་འགྲམ་ནས་ལངས་སྟེ་བསྡད།",
    "ཞིང་བ་དེས་བུད་མེད་དེ་མཐོང་མེད་པ་འདྲ་ཞིང་ཁོས་ལག་པ་གཉིས་ཅོག་ཙེའི་སྟེང་དུ་བཞག་ནས་བསྡད་ཡོད།",
    "ཁྱོད་ཀྱིས་ཅི་ཞིག་འཐུང་ན་འདོད་དམ།",
    "བུད་མེད་དེས་ཆང་ཁོ་གཉིས་ཀྱི་གམ་དུ་ཁྱེར་ནས་ཐོན་བྱུང་།",
    "ཞིང་བ་དེས་ཆང་ཕོར་ནང་གི་ཆང་འཐུང་རྗེས་སྒེའུ་ཁུང་ལས་ཕྱི་རོལ་དུ་བལྟས་ནས་འདུག་ལ།",
    "ཞིང་བ་དེས་སྔར་བཞིན་སྒེའུ་ཁུང་ལས་ཕྱི་རོལ་དུ་བལྟས་ནས་འདུག་འགྲུལ་ཁང་གི་སྦྱིན་བདག་ཕྱི་རུ་བུད་སོང་།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "བུད་མེད་དེ་ནང་དུ་འཛུལ་བྱུང་།",
    "ཁོས་མཉམ་དུ་རྩིས་རྒྱག་རྒྱུ་ཡིན་ཞེས་མོ་ལ་བཤད།",
    "ཞིང་བ་དེས་བུད་མེད་དེ་ལ་སླར་ཡང་མཉམ་དུ་རྩིས་རྒྱོབ་ཅེས་བཤད།",
    "མོའི་པང་ཁེབ་གྱི་ཁུག་མ་ལས་དངུལ་སྒོར་མང་པོ་ཞིག་ཕྱི་རུ་བླངས་ཤིང་།",
    "ཞིང་བ་དེ་བུད་སོང་།",
    "ཁོ་སེང་གེའི་ཇ་ཁང་དུ་བུད་སོང་བ་ཡིན་ནམ།",
    "ཁོ་སེང་གེའི་ཇ་ཁང་གི་ནང་དུ་བུད་སོང་།",
    "རིམ་གྱིས་འགྲུལ་ཁང་གི་སྦྱིན་བདག་ངེད་གཉིས་ཀྱི་ཅོག་ཙེའི་འགྲམ་དུ་སླེབས་བྱུང་།",
    "ངེད་གཉིས་ཞོགས་པ་སྔ་མོ་ནས་ཡར་ལངས་པ་ཡིན།",
    "བུད་མེད་དེས་ཁྱེད་གཉིས་ལ་ཚལ་ཐོ་ཁྱེར་ཡོང་ངེས།",
    "བུ་མོ་དེས་ཚལ་ཐོ་ཁྱེར་ནས་ངེད་གཉིས་ཀྱི་འགྲམ་དུ་སླེབས་བྱུང་།",
    "ཚོད་མ་དག་གི་མིང་ལྕག་སྨྱུག་གིས་ཤོག་བྱང་ངོས་སུ་འབྲི་དགོས་ལ།",
    "བྲིས་རྗེས་ཤོག་བྱང་དེ་རང་གི་མདུན་འཇོག་གི་སྟེང་དུ་འཇོག་དགོས།",
    "ངས་འགྲུལ་ཁང་གི་སྦྱིན་བདག་ལ་ཁྱོད་ཀྱིས་ང་ཚོ་དང་མཉམ་དུ་ཆང་ཞིག་འཐུང་ན་འདོད་དམ་ཞེས་ཁོ་ལ་དྲིས།",
    "ཁོ་སར་བསྡད་ནས་ཞིང་པ་དེ་དག་ཚང་མ་དུད་འགྲོ་དང་གཅིག་པ་རེད་ཞེས་བཤད།",
    "དེ་སྔོན་ང་ཚོ་གྲོང་རྡལ་དུ་ཐོན་པའི་སྐབས་སུ་ཞིང་བ་དེ་དག་གིས་དུར་ཁང་ན་འདས་མཆོད་སྒྲུབ་ཀྱིན་འདུག་ཁོས་རང་གི་ཆུང་མ་ལ་འདས་མཆོད་སྒྲུབ་པ་རེད།",
    "འཛམ་གླིང་གི་བརྩམས་སྒྲུང་གྲགས་ཅན་བོད་འགྱུར་དཔེ་ཚོགས།",
    "ཁོ་ནི་དུད་འགྲོ་ཞིག་དང་གཅིག་པ་རེད།",
    "ཁྱོད་ཀྱི་སྐད་ཆ་དེའི་ནང་དོན་ཅི་ཡིན་ནམ།",
    "མི་དེས་དོན་དག་ཞིག་བསྒྲུབས་ཐུབ་པའི་ཚེ་ཁྱོད་རང་ཀྱང་ཡིད་ཆེས་དཀའ་བའི་གནས་སུ་ལྷུང་སྲིད།",
    "ཁྱོད་རང་ང་ལ་ཡིད་ཆེས་མི་སྲིད་ཞེས་བཤད།",
    "ཁྱོད་རང་འདི་སར་ཤོག་ཅེས་བཤད།",
