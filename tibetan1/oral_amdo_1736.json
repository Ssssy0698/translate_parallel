    "སོ་གནྡྷི་ལ་སོགས་པ་ཁ་དོག་ཡིད་དུ་འོང་བ་དང་རེག་བྱ་འཇམ་པ་དང་།",
    "དྲི་ཞིམ་པོས་ཁ་ཅིག་གི་ཡིད་འཕྲོག་ནུས་པ།",
    "དེ་བཞིན་དུ་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་དགོངས་པ་ཡང་ཕྱི་དང་ནང་གི་ཡུལ་ལ་དྲན་པ་སྐྱེས་ཀྱང་།",
    "ཨུཏྤལ་འདབ་མ་ཆུ་ཡིས་མི་རེག་བཞིན།",
    "འདུ་དུ་རའི་ཞེས་བྱ་བ་མེ་ཏོག་གི་སྦྲང་རྩི་ལ་ཚོན་རྩི་གང་ཡང་རུང་བས་བཅོས་པས་འབྲུ་སྨིན་ནས་ས་བོན་དེ་བཏབ་པས་མེ་ཏོག་དེའི་ཁ་དོག་ཏུ་འགྱུར་རོ།",
    "མ་དུ་ལུང་ག་ཞེས་བྱ་བ་ནི་མེ་ཏོག་གི་ཤིང་གི་རྩ་བ་ལ་ཐབས་མཁས་པས་ཚོན་གང་ཡང་རུང་བ་ཅིག་གིས་བསྐུས་ན།",
    "དཔེར་ན་དུག་སྔགས་གདེང་དུ་གྱུར་པ་ཅིག་གིས་དུག་ཟོས་པས་གནོད་པར་མི་འགྱུར་བ་དེ་བཞིན་དུ།",
    "ཡུལ་གྱི་དུག་གིས་མི་ཚུགས་པས།",
    "དུག་གི་སྔགས་ཅན་དུག་གིས་ག་ལ་ཚུགས།",
    "དེ་ཡང་རྒན་མོ་བུ་གཅིག་པ་ཤི་བས་གདུངས་པ་བཞིན་དུ།",
    "གཞན་ན་རེ་བར་མ་དོའི་དུས་སུ་བཞེད་དེ།",
    "ལ་ལ་ན་རེ་བདག་གི་ལུས་གཞན་ཡི་དམ་ལྷ་མཚན་དང་དཔེ་བྱད་དང་ལྡན་པ་ཅིག་མངའ་བ་བསྒོམས་ལ།",
    "བདག་རང་གི་སྐྱེ་བ་དང་ན་བ་དང་འཆི་བ་འདི་ལྟ་བུ་ཡིད་གཟུགས་བརྙན་དུ་སེམས་ལ་ཤར་བ་ཡིན་པར་ཤེས་པས།",
    "སྙན་ནས་སྙན་དུ་ཞལ་ནས་ཞལ་དུ་བརྒྱུད་པའི་མན་ངག་གིས་ཤེས་པར་བྱས་ལ།",
    "མུན་ནག་གི་ནང་ན་མི་མཐོང་།",
    "དེ་ལ་ཡང་རེ་དོགས་མེད་ལ།",
    "ཐོག་མ་མེད་པ་ཡོད་མེད་ལ་སོགས་པའི་ཚིག་གི་བླ་དགས་དང་བྲལ་བས།",
    "ལས་དང་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་རྣམས་ཀྱིས་མ་གནོད་པས་ན།",
    "ད་ནི་རྫིངས་ལས་འཕུར་བའི་བྱ་རོག་གི་དཔེས་བསྟན་པར་བྱའོ།",
    "ནང་གི་ཡུལ་རྐྱེན་ལ་རག་ལས་པ་ན།",
    "ནང་གི་ཡུལ་ལ་ཡང་ཡུལ་ཉིད་རྣམ་པར་དག་སྟེ་བསྟན་བྱ་མིན།",
    "སྟོང་པ་འབའ་ཞིག་གིས་ནི་སྤྱད་པར་བྱ།",
    "དྲན་པའི་བྱ་རོག་གིས་བྱར་བ་བྱས་ལ།",
    "ཇི་ལྟར་བྱ་རོག་གིས་ཡུལ་མ་མཐོང་བས་རྫིང་ལ་བབ་པ་བཞིན་དུ།",
    "ནང་གི་དྲན་རིག་ཉམས་སུ་མྱོང་བ་ལ་ཞེན་པ་ནི།",
    "དེ་ལ་ཡང་རང་གི་ཤེས་བྱས་རང་སྔགས་པ་ནི།",
    "དཔེར་ན་རི་མོ་མཁན་མཁས་པ་བཟོབ་པ་ཅིག་གིས་ཁྲོ་བའི་གཟུགས་ཤིན་ཏུ་འཇིགས་སུ་རུང་བ་ཅིག་བྲིས་པ་ལ།",
    "ནམ་ཞིག་ཁོ་རང་གིས་མཐོང་བས་སྔངས་པ་བཞིན་དུ།",
    "དཔེར་ན་རི་མོ་མཁན་དེ་རང་གི་བུད་མེད་མཚན་དང་ལྡན་པ་ཡིད་དུ་འོང་བ་ཅིག་བྲིས་པ་ལ་ནམ་ཞིག་བལྟས་པས།",
    "ཁོ་རང་གི་རི་མོ་ལ་ཁོ་རང་ཆགས་པ་སྐྱེས་པ་བཞིན་དུ།",
    "རྣལ་འབྱོར་པ་ཁ་ཅིག་གིས་ཕྱི་རོལ་གྱི་ཡུལ་ལ་བརྟེན་ནས་སྣང་སྟོང་དབྱེར་མེད་འདོད་པ་དང་།",
    "ནང་གི་ཡུལ་ལ་བརྟེན་ནས་རིག་སྟོང་དབྱེར་མེད་འདོད་པས།",
    "ལ་ལ་ན་རེ་ཕྱི་རོལ་གྱི་ཡུལ་ལས་བྱུང་བའི་བདེ་བ་ལས་ཞེན་པར་བྱ་ཞེ་ན།",
    "དེ་ལ་ཡིད་མ་ཆེས་ན་དཔེ་ལྔ་ནི་ཐུན་མོང་ནི་གོ་སླའོ།",
    "ཐུན་མོང་མ་ཡིན་པའི་ཡུལ་ནི་བདེ་བའི་རོ་ལ་ཆགས་པ་ཉ་ལྟ་བུ་དང་།",
    "ལྷ་དང་ལྷ་མོའི་དཀྱིལ་འཁོར་ལ་ཆགས་པ་ཕྱེ་མ་ལེབ་ལྟ་བུ་དང་།",
    "སེམས་ལས་བྱུང་བའི་རྣམ་པར་རྟོག་པ་ཕྱོགས་རེ་བ་ཤེས་པ་ལ་སེམས་ཉིད་ཤེས་པ་མི་ཟེར་རོ།",
    "ཡོན་ཏན་བསྒྲུབ་པར་བྱ་བའི་གང་ཟག་གིས།",
    "ལྷ་དང་ལྷ་མོའི་དཀྱིལ་འཁོར་ཡིད་ལ་བྱེད་ན་གཟུགས་ཀྱི་ཁམས།",
    "འཕགས་པ་རྣམས་ཀྱིས་སྲིད་པའི་རྩེ་མོ་ནས་སྡུག་བསྔལ་དུ་ཤེས་ལ།",
    "སྣང་བ་ལ་ཞེན་པའི་གང་ཟག་གི་དོན་དུ་ཡིན་གྱི།",
    "ངག་གི་སྒོ་ནས་བསྟན་པས་གདམས་ངག་ཅེས་བྱ་སྟེ།",
    "ངག་གི་བརྡ་དང་།",
    "ངག་གིས་ནི་དྲན་པ་མྱོང་བ་དང་།",
    "རྣལ་འབྱོར་པ་རྣམས་ཀྱི་ཐུགས་དམ་མོ།",
    "དེ་ལྟ་བུ་དེ་ཀླུ་དཥ་ཀའི་གཙུག་གི་ནོར་བུ་རྒྱན་གྱི་མན་ངག་བཞིན་ནོ།",
    "དེ་གང་ལ་གང་གིས་བསྟན་པར་བྱ་ཞེ་ན།",
    "རང་ལ་གནས་པ་རང་ལ་རང་གིས་ཤེས་པར་བྱ་སྟེ།",
    "རང་ལ་རང་གི་བདེ་བ་ཆེན་པོའི་བག་ཆགས་གཟུགས་དེ་ལྟར་རྟོགས་པའི་ཚེ།",
    "རང་གིས་ཉམས་སུ་མྱོང་བ་དྲན་དུ་མ་བཏུབ་པའི་དཔེ་སྦྲུལ་གྱི་སྒོང་ཟོས་པའི་སྒྲུང་བརྒྱུད་དང་།",
    "བློའི་སྤྱོད་ཡུལ་མ་ཡིན་པས་ཚིག་གིས་བརྗོད་དུ་མེད་པ་ནི།",
    "ཕྱིའི་ཡུལ་དང་ནང་གི་ཡུལ།",
    "འགྲོ་བ་འདི་དག་ནི་རང་རང་གི་དྲན་པའི་རྣམ་པར་རྟོག་པའི་ཁུར་བུས་རང་གི་སེམས་ལ་ཁལ་བཀལ་ནས།",
    "འགྲོ་བ་རིགས་དྲུག་གི་གྲོང་དུ་མི་གཏོང་ན།",
    "རྟོགས་པ་ཙམ་ཁུར་ལྕི་བས་མནན་པའི་གང་ཟག་གང་ཡང་རུང་བ་ཅིག་གིས་ཁུར་བོར་བ་བཞིན་དུ།",
    "བསྒོམ་དང་མི་བསྒོམ་དབྱེར་མེད་བདག་གིས་མཐོང་།",
    "ཕྱི་རོལ་གྱི་ཡུལ་ལ་བརྟེན་ནས་ནང་གི་ཡུལ་དྲན་པས་མྱོང་ལ།",
    "གདམས་ངག་གིས་བསྟན་པས་དེ་ཉིད་ངོ་ཤེས།",
    "དེ་ལྟར་རྟོགས་པར་བྱེད་ལ་ལ་ན་རེ་བདེན་པ་གཉིས་སུ་འདོད།",
    "རྟག་ཆད་ལ་སོགས་པའི་ལྟ་བ་དང་རང་གི་འདོད་གཞུང་ཐེན་པས་ལྷ་ཉིད་མ་རྟོགས་སོ།",
    "སྐྱུར་པོ་སྔར་ཟོས་པ་ཅིག་གིས་ཕྱིས་མཐོང་བ་ཙམ་གྱིས་རོ་བྲོ་བ་བཟའ་མི་དགོས་པ་དེ་བཞིན་དུ།",
    "གཅིག་གི་རང་བཞིན་ཤེས་པས་ཀུན་གྱི་རང་བཞིན་ཤེས་སོ།",
    "ཕྱི་རོལ་སོང་ནས་ཁྱིམ་བདག་ཚོལ།",
    "ཤེས་བྱའི་རླབས་དག་གིས་མི་ཚུགས།",
    "གང་ཡང་སྔ་ན་མེད་པའི་སྒེག་མོ་དང་ཕྲད་ནས།",
    "ཡིད་འཕྲོག་མ་སྒེག་མོ་དེ་དང་ཉལ་ན།",
    "བར་སྣང་གི་བྱ་ས་ཀུ་ནེ་བཞིན་དུས་ལ་མི་འབབ།",
    "རང་གི་གཟུགས་དང་ཐ་དད་མ་ལྟ་ཞིག།",
    "ཁྱིམ་བདག་ཟོས་ནས་ཁྱིམ་བདག་མོ་ལོངས་སྤྱོད།",
    "ང་ཡིས་རྩེད་མོ་བྱས་པ་ལ།",
    "རང་རང་གི་ལས་ཀྱི་རྣམ་པར་སྨིན་པའི་ཁུར་བུ་ཁུར་ནས།",
    "ཨ་མ་གཞན་ནས་བུ་དེ་སྐྱེ་མི་འགྱུར།",
    "དེ་ཡང་བུད་མེད་ཀྱི་གླིང་གི་སྒྲུང་བརྒྱུད་ཁྱོ་གཞན་ནས་ཚོལ་བ་བཞིན་དུ།",
    "གྲོགས་མོ་འདི་ནི་སེམས་ལ་གང་སྣང་བ།",
    "གང་གིས་ཀྱང་མཚོན་དུ་མེད་པས།",
    "ཕྱི་རོལ་སེམས་ཀྱིས་མཚོན་དུ་མེད་པ་བདག་གིས་མཐོང་།",
    "དེ་ཡང་བཟང་དང་ངན་ལ་སོགས་པའི་རྣམ་རྟོག་ཡིན་པས་དྲན་པ་ཙམ་མོ།",
    "ཚིག་གིས་བརྗོད་དུ་མ་བཏུབ་པ་གང་ཡིན་པ་དེ་ནི་ཡི་གེ་མེད་པའོ།",
    "གང་གིས་དེ་ཤེས་དེ་ཡིས་གྲོལ་བར་འགྱུར།",
    "ཡི་གེ་མེད་ལས་ཡི་གེའི་ཐ་སྙད་ཡིན་པས་བསྒྲུབ་ཡིག་བཞི་ལ་དང་པོ་བདག་གིས་བཏོན།",
    "དྲན་པ་དེ་ཡང་བག་ཆགས་སམ་རྐྱེན་ལ་རག་ལུས་པས་ཀུན་རྫོབ་སྒྱུ་མ་ཙམ་མོ།",
    "གང་གིས་ཡི་གེ་གཅིག་ཤེས་ལ།",
    "དེ་ལྟ་བུའི་ཐ་སྙད་ལས་འདས་ནས་སེམས་ཀྱི་ཡུལ་དང་ཡུལ་ཅན་དང་བྲལ་བ་དེ་གང་གིས་གང་ལའང་མིང་མེད་པས།",
    "ལྷ་དེ་ཉིད་ནི་བློས་རེག་ཏུ་མི་བཏུབ་ལ།",
    "བསྒོམས་པ་ནི་བློས་བཞག་ནས་དྲན་པའི་བར་དུ་ཡེངས་པ་ནི་ཡིན་གྱི།",
    "དཔེར་ན་རེག་ཏུ་མི་བཏུབ་པ་གདོལ་པ་བྲམ་ཟེ་བཅོས་ནས་རིག་བྱེད་བཏོན་ཡང་།",
    "དང་པོ་རེག་ཏུ་མི་བཏུབ་པས།",
    "ཡང་དག་པའི་ཅིག་ཤོས་ནི་བློས་རེག་ཏུ་མི་བཏུབ་ལ།",
    "བར་དུ་བློས་རེག་ཏུ་བཏུབ་བཏུབ་འདྲ་སྟེ་ཐ་མ་རེག་ཏུ་མི་བཏུབ་པས།",
    "ཁྱབ་པ་དེ་ཉིད་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ཡིན་པར་མ་ཤེས་པས་མ་ལུས་རང་བཞིན་གང་གིས་མི་ཤེས་པ།",
    "དེ་ཡང་ཐིག་ལེ་གཅིག་རྡོ་རྗེ་རྩེ་མོར་གནས།",
    "བདེ་བ་གང་གི་རྣམ་པར་རོལ་པ་ནི།",
    "ཁམས་གསུམ་གྱི་རེ་བ་སྐོང་བར་འགྱུར་གྱི་གཉིས་ཤོར་གཉིས་མཉམ་གྱི་བདེ་བ་ནི།",
    "ས་གསུམ་རེ་བ་གང་གིས་རྫོགས་པར་འགྱུར།",
    "གྲོགས་དག་ཟབ་མོ་དང་ནི་རྒྱ་ཆེ་བ།",
    "དེ་གང་གི་དུས་སུ་ཞེ་ན།",
    "དེ་ལས་མ་གཡོས་པ་བཞི་པའི་མན་ངག་གིས་ཤེས་པས་ནི།",
    "དེས་ཅི་འདྲ་ཞེ་ན་ཉོན་མོངས་པ་དང་ཤེས་བྱའི་སྒྲིབ་པ་ནི།",
    "ཉོན་མོངས་པ་དང་ཤེས་བྱ་སྤང་མི་དགོས་པས།",
    "མིག་གིས་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་ནང་དུ་ཅེ་རེ་ལྟ་བ་མི་བཟོད་པ་བཞིན་དུ།",
    "ནམ་ཞིག་ནུས་པར་འགྱུར་སྙམ་མོ།",
    "མན་ངག་གིས་བསྟན་མ་ཐག་ཏུ་ཤར་བས།",
    "ཀྱེ་ཧོ་རྨོངས་པའི་སེམས་ཀྱིས་སེམས་ལ་རྟོགས་ནས་ནི་རྟག་ཆད་ལ་སོགས་པའི་ལྟ་བ་ངན་པས་གྲོལ་བ་དང་ལྟ་ཞོག་གི།",
    "རྣལ་འབྱོར་པས་གང་གིས་ཀྱང་རྟོགས་པར་བྱ་བ་མ་ཡིན་པ་རྟོགས་པས་ན།",
    "རྣལ་འབྱོར་པ་རྣམས་ནི་ཤེས་དང་ཤེས་བྱ་གང་གིས་ཀྱང་མ་བཅིངས་ལ།",
    "ཐུན་མོང་གི་དངོས་གྲུབ་ནི་སེམས་ཀྱི་དྲན་སྒོམ་དང་སྔགས་དང་ཕྱག་རྒྱ་ལ་སོགས་པ་ལ་བྱུང་བ་ཡིན་གྱི།",
    "ཐུན་མོང་མ་ཡིན་པ་ཕྱག་རྒྱ་ཆེན་པོའི་དངོས་གྲུབ་ནི།",
    "ལྕགས་ཀྱུས་གོམས་པ་རྩལ་པོ་ཆེ་ཅིག་གིས་བཏབ་པས་ཡིན་ཡང་མི་སྟེར་བ་བཞིན་དུ།",
    "སེམས་ཀྱི་རང་བཞིན་ནི་སྤྲོས་པ་ཐམས་ཅད་བྲལ་བའི་ཕྱིར་གཅིག་ཅེས་རྟོགས་མོད་ཀྱི་དེ་ལྟ་བུར་བརྗོད་དུ་བཏུབ་པ་མ་ཡིན་པས།",
    "རང་བཞིན་གཅིག་གིས་དབྱེ་བ་རྣམ་པར་སྤངས།",
    "དེ་ལྟར་རྟོགས་ན་དོགས་པ་དང་རེ་བ་མི་བྱ།",
    "འོ་ན་རྟོགས་པའི་རྣལ་འབྱོར་པ་ལ་ཡང་ཉོན་མོངས་པའི་དྲན་པ་སྐྱེ་ཡིན་གདའ་ཟེར་ན།",
    "རང་གིས་རང་ལ་གནོད་པ་བྱས་སོ།",
    "རང་གིས་རང་ལ་ངལ་བར་བྱེད་དོ།",
    "དེ་ཉིད་དྲི་མེད་མཆོག་གི་གོ་འཕང་ངོ།",
    "ཁམས་གསུམ་མ་ལུས་ཀུན་དུ་ཁྱབ་པར་སོང་།",
    "དཔེར་ན་སྣོད་མང་གི་ནང་དུ་ཆུས་གང་བ་ལ་ཟླ་བའི་གཟུགས་བརྙན་ཤར་བ་བཞིན་དུ།",
    "དེ་ཡང་འགྲོ་བའི་རང་གི་རྣམ་རྟོག་གིས་རང་ལ་བྱས་པས་མཐོང་བ་སྣ་ཚོགས་དང་ལྡན་པས།",
    "མྱ་ངན་ལས་འདས་པ་དེ་ཡང་དངོས་པོར་མ་གྲུབ་པ་རེ་བ་མི་བྱེད་པ་ནི་རྣལ་འབྱོར་པ་རྣམས་ཀྱི་དེ་བཞིན་ཉིད་དེ།",
    "གང་གི་ཚེ་གང་དང་ཡང་མ་ཕྲད་པ་དེའི་ཆེ་ཡང་དག་པའི་དོན་དམ་པ་དང་ཕྲད་པའོ།",
    "དེ་ནི་རེ་བ་མེད་ནས་གལ་ཏེ་འགྲོ་ན་ནི།",
    "རེ་བ་མེད་པ་དེ་ནི་འཇིག་རྟེན་པས་བོར་བའོ།",
    "བྱས་པ་ལྟར་སྣང་བ་རང་རང་གི་རྣམ་རྟོག་ཡིན་པས།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ཁོང་དུ་ཆུད་པས་ཆེན་མོ།",
    "དེ་ལྟར་རྟོགས་པའི་མདའ་མཁན་མོ་བླངས་པས་ས་ར་ཧ།",
    "འདི་ལ་མོས་པ་རྣམས་ཀྱི་དོན་དུ་བདག་གིས་འདི་བསྒྱུར་བས།",
    "མོས་པའི་ཤེས་པས་རྟོགས་པ་ཐ་དད་ཀྱང་།",
    "དྲན་མེད་འདི་ལ་བརྫུན་པ་ཡོད་རེ་སྐན།",
    "དྲན་པ་འདི་ལ་བདེན་པ་ཡོད་རེ་སྐན།",
    "སྐྱེ་མེད་འདི་ལ་གཉིས་སུ་ཡོད་རེ་སྐན།",
    "བློ་འདས་འདི་ལ་བཙལ་དུ་ཡོད་རེ་སྐན།",
    "རང་ལ་གཞན་ནས་ཚོལ་བ་ཨ་རེ་འཁྲུལ།",
    "གཞན་ཡོད་ལོང་མཐོང་སྟོབས་ཀྱིས་བསླད་མོད་ཀྱང་།",
    "རང་གི་རྒྱུད་ལ་སྦྱར་ཏེ་ཤེས་པར་བྱ།",
    "དྲན་པས་ཟིན་པས་ཁྱོད་ཉིད་ཆགས་པ་སྟེ།",
    "རྩ་ལ་རེག་པར་མ་སྤྱད་གཉུག་མར་གནས།",
    "དྲན་པས་རེག་ཀྱང་རེག་གི་བསམ་བྲལ་བས།",
    "ལྷན་ཅིག་སྐྱེས་དང་ཡུལ་ལ་གཏུམ་མོ་སྦར་ལ་སོགས།",
    "དམ་ཚིག་བདག་གི་ཁོ་ན་ཉིད་དང་རྣལ་འབྱོར་བསྒོམ།",
    "ཐུན་མོང་མཐུ་སྐྱེས་ཕྱག་རྒྱ་ཆེ་ལ་རེག་མི་ནུས།",
    "རེ་དོགས་མཐར་ལྷུང་འདུ་འཛི་བྱ་བའི་སྐྱོན་དུ་འགྱུར།",
    "འགོག་པ་མེད་བཞིན་དྲན་རིག་རང་གིས་སྟོང་།",
    "བཞི་རུ་སྣང་ཡང་གཅིག་གི་ཡོན་ཏན་ནི།",
    "གོང་གི་ཁྱད་པར་དག་གི་བཞི་རུ་བྱུང་།",
    "རང་གི་སེམས་ཉིད་དག་དང་ལྷན་ཅིག་སྐྱེས།",
    "དཔེར་ན་མིག་གི་ཡུལ་དུ་སྒྲ་མི་སྣང་།",
    "དེ་ཕྱིར་ཕྱག་རྒྱ་ཆེན་པོ་སྔོན་སོང་ལ།",
    "ཆུ་ལ་ཞུགས་དང་ཚོགས་དང་ཟ་འགྱེད་བྱེད།",
    "བསྒོམ་བྱ་རང་ལ་སྒོམ་བྱེད་རང་གི་སེམས།",
    "བསྒོམ་བསྒྲུབ་སྔགས་བཟླས་རང་གི་སེམས་ཡིན་ཏེ།",
    "ཡི་དམ་ལྷ་དང་རང་གི་སེམས་ཡིན་པས།",
    "དེ་ཕྱིར་མཁའ་འགྲོ་ལུང་སྟོན་ལ་སོགས་རང་གི་སེམས།",
    "སྐྱེ་མེད་བློ་འདས་དག་གིས་ངོ་མཚར་མཚུངས།",
    "རང་གི་དེ་ཉིད་རྟོགས་ན་གཞན་ལས་མིན།",
    "བཅིང་བཀྲོལ་དག་གིས་མ་བཟུང་དྲན་པའི་རྗེས་མ་འབྲང་།",
    "རང་གི་ངོ་བོ་གསལ་བས་མར་མེ་དྲན།",
    "ཀྱེ་ཧོ་དེ་ལྟར་མཁས་པ་ཐབས་ཟིན་དག་གིས་ནི།",
    "དྲན་མེད་གནས་པ་དག་གིས་རྒྱས་གདབ་ན།",
    "སྟོང་པར་མ་སོང་ཆད་པའི་མཐར་མ་ལྷུང་།",
    "དངོས་པོར་མ་སོང་རྟག་པའི་མཐར་མ་ལྷུང་།",
    "གསུང་གི་མཛོད་འཇམ་དབྱངས་རྡོ་རྗེའི་གླུ།",
    "བདག་གཞན་དོན་འདོད་དངོས་འཛིན་རང་གིས་རང་ལ་འཛིན།",
    "ལུང་དང་རིགས་པས་རང་གི་མཚན་ཉིད་རྟོགས་འདོད་པ།",
    "ཕྱག་རྒྱ་མཆོད་དང་བསྟོད་པ་དག་གིས་གསོལ་བ་གདབ།",
    "སྙན་པའི་ཚིག་གིས་གསོལ་གདབ་རིག་པ་རྩལ་དཔང་དང་།",
    "གང་གི་རོ་སྙོམས་སྤྱོད་པ་དག་ལ་བརྟེན་ནས་འབྲས་བུ་ཐོབ།",
    "བཞིར་ལྡན་ཕྱག་རྒྱ་གཅིག་གི་ཆོ་འཕྲུལ་གཅིག་གི་ངང་།",
    "རྟོག་པའི་ངོ་བོས་བ་མོ་རྟ་ལྟར་སྣང་འདོད་ན།",
    "མཚོན་བྱ་མཚོན་བྱེད་ཚིག་གི་ཐ་སྙད་ལམ།",
    "ཐུན་མོང་མ་ཡིན་གསང་སྔགས་ཁྱད་པར་ཅན།",
    "ཕྱི་ནང་ཟབ་མོ་བསྐྱེད་པའི་རིམ་པ་ཀུན།",
    "འཇིག་རྟེན་ཅ་ཅོ་ཡིན་མོད་ཁྱད་མེད་མཚུངས།",
    "གསུང་གི་མཛོད་འཇམ་དབྱངས་རྡོ་རྗེའི་གླུ་ས་ར་ཧས་གསུངས་པ་རྫོགས་སོ། ། རྒྱ་གར་སྐད་དུ།",
    "རང་གི་ཉམས་སུ་མྱོང་བ་དེ་ཁོ་ན།",
    "མར་མེ་མུན་གསལ་རང་གི་རང་གསལ་རང་ལ་སད།",
    "མཐའ་གསུམ་རྟག་འདོད་དག་གིས་རྙེད་པར་དཀའ།",
    "དོན་ལྡན་མཚན་ཉིད་ཉོན་མོངས་གཡུལ་ལས་རྒྱལ།",
    "ཀཱ་ཡ་བཱ་ཀ་ཙིཏྟ་ཨ་མ་ན་སི་ཀ་ར་ནཱ་མ།",
    "རྣལ་འབྱོར་རྣམ་པར་གྲོལ་བས་མཛད་པ་གང་གིས་ནི།",
    "འགྲོ་ལ་བྱམས་པའི་ཆ་ལུགས་མཆོག་གི་དོན་སྟོན་པ།",
    "གང་གི་སེམས་ལ་འདི་ཀུན་བསམ་དུ་མེད་དོ་ཀྱེ།",
    "ཁྱོད་ནི་ཕྲིན་ལས་ཡན་ལག་མང་པོ་སྟོན་མཛད་ཅིང་།",
    "གང་ཡང་གཙོ་མཆོག་ལྡན་པའི་སྦྱོར་བ་དག་གིས་རབ་ཏུ་མི་དབྱེ་བར།",
    "གང་གིས་དེ་ནི་མི་ཤེས་པའི།",
    "གང་གིས་དེ་ཀུན་འཆང་བར་བྱེད་པ་དེ་ཡིས་ནི།",
    "ཡན་ལག་ལོག་ན་གཅིག་གི་ངོ་བོ་ཉིད།",
    "ཤེས་པར་བྱ་དང་བྱའོ་ཅོག་གི་ཐ་སྙད་ཀུན།",
    "གི་ཝང་གུར་གུམ་ཙནྡན་ཐིག་ལེ་བྲིས་པ་བཞིན།",
    "གང་གིས་ནམ་མཁའ་དག་ལ་ལོངས་སྤྱོད་པའི།",
    "འདི་ནས་སོང་བ་གང་ཡང་མེད་པར་ཤེས་པ་དེ།",
    "གང་གིས་མ་མཐོང་བ་ལས་དེ་ནི་རྒྱལ་བར་འགྱུར།",
    "འདི་ལ་ཤེས་དང་ཉོན་མོངས་ལ་སོགས་པའི།",
    "གསུང་གི་བདག་ཉིད་བརྗོད་པར་བྱ་བ་མིན།",
    "གང་གིས་གང་སྤྱོད་དེ་ཡིས་རབ་ཏུ་བརྒྱན།",
    "ཕྱི་ནང་བསམ་གཏན་རྩེ་མོས་བརྟགས་པས་སྟོང་།",
    "རང་གིས་མ་མཐོང་མཚན་ཉིད་ཀུན་ལྡན་པ།",
    "དྲན་མེད་མཉམ་པའི་དབྱིངས་ལ་སྐུར་གསལ་མོས་པ་མེད་པར་སྤྱོད།",
    "ཐུགས་རྗེས་མི་གཟིགས་སྐུ་གསུང་ཐུགས་ཀྱིས་མ་གོས་པ།",
    "དག་པའི་རིགས་རྣམས་ཀུན་ལ་ཁྱོད་ཀྱིས་སྤྱོད།",
    "གཅིག་གི་དབྱིངས་ན་མི་མངོན་ཕྲ་བའི་ཚུལ་དུ་གནས།",
    "ཕྲག་དོག་སྲིད་པའི་ཉོན་མོངས་ལ་སོགས་པའི།",
    "དངོས་མེད་བདེན་པ་གཉིས་བྲལ་གཅིག་གི་དངོས་པོ་སྟོང་།",
    "ཉོན་མོངས་པ་རྣམས་ཉི་མས་རབ་ཏུ་སྐམས་པའི་འོད་ཟེར་འདི།",
    "ཉོན་མོངས་ལ་སོགས་བསགས་པའི་ས་བོན་ནི།",
    "གལ་ཏེ་སྟག་དང་ཝ་མོ་ལྟ་བུའི་སྟོབས་ནི་གོ་བཟློག་ན།",
    "ཁྱོད་ཀྱིས་རྩྭ་མཆོག་ཙམ་དུ་གཉིས་ཀ་མེད་པར་བྱོས།",
    "ཁྱོད་ཀྱིས་ཡང་ནས་ཡང་དུ་བསམས་པས་མཐོང་བ་གང་ཡང་མེད་མོད་ཀྱེ།",
    "སྣ་ཚོགས་བར་སྣང་རང་གི་ངོ་བོ་མ་སྐྱེས་ཕྱིར།",
    "གཉིས་དང་གཅིག་གི་དྲན་པས་དུ་མ་དག་དང་འབྲལ་བར་འགྱུར།",
    "གང་ཡང་བརྗོད་པར་བྱ་བའི་དངོས་པོ་གང་ཞིག་རང་གིས་སྟོང་པ་སྟེ།",
    "བྲལ་བས་འདི་ལས་གཞན་དུ་སོང་བས་མ་མཐོང་ངོ།",
    "བསྐལ་པ་བརྒྱར་ཡང་མཆོག་གི་དོན་མི་མཐོང་།",
    "ཤེས་རབ་མིག་གིས་ལོག་པར་ཚར་བཅད་ན།",
    "གཞན་གྱི་ལོག་པར་ལྟ་བ་རང་གི་དེ་རུ་གྲོལ།",
    "རྣལ་འབྱོར་འདི་ལ་བདག་གི་གནས་སུ་འདུག་པ་མ་མཐོང་ངོ།",
    "སྲིད་དང་མྱ་ངན་འདས་གྲོལ་ཉོན་མོངས་རྒྱ་མཚོ་སྐེམས་པར་འགྱུར།",
    "དེ་ལས་གཞན་དུ་རྟོགས་པའི་བློ་ཅན་འདིས་ནི་རྒྱ་མཚོ་ནང་གི་ནོར་བུ་རྙེད་མི་འགྱུར།",
    "མཚོན་ཆ་བྲལ་བའི་ཆོམ་རྐུན་དག་གིས་གསད་བཅད་མ་ཡིན་ནོ།",
    "གང་གིས་སྲིད་པའི་ཆུ་བོ་འདི་བརྫུན་པར།",
    "ཡུལ་ཅན་གང་གི་ཕྱོགས་དག་ཏུ།",
    "མཚན་མའི་རྟོག་པ་དག་གིས་གསུམ་དུ་ཟག་པར་འགྱུར།",
    "འདི་ལ་ཉོན་མོངས་ཤེས་བྱའི་སྒྲིབ་པ་ལས་བསགས་ཀུན།",
    "ཉོན་མོངས་ལྔ་ཡི་གནས་སུ་ཐམས་ཅད་ཟགས་པར་འགྱུར་བ་ཡིན།",
    "གང་གིས་ཁེངས་པར་མྱུར་དུ་ཐོབ་པར་འགྱུར།",
    "ཁྱོད་ཀྱིས་རྫོགས་པར་འགྱུར་བས་ཐོབ་པ་མ་ཡིན་ནོ།",
    "ཚང་ཚིང་འདི་ལ་ཟ་བར་ནུས་པ་གང་གིས་ནི།",
    "འདི་ཀུན་གང་གིས་ཡིད་ལ་མ་བྱས་པར།",
    "གང་གིས་གདོད་ནས་སེམས་མེད་རྟོགས་པ་ཡིས།",
    "རི་དྭགས་ཕྲ་མོ་ཐམས་ཅད་སྐྲག་གྱུར་ཀྱང་།"
  ]
