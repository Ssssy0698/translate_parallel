    "དེ་ལྟ་ན་ཡུལ་ཡུལ་ཅན་གྱི་རང་བཞིན་ནམ་གནས་ཚུལ་འདི་ལྟ་བུ་ཡིན་ཀྱང་རང་བཞིན་འདི་ལས་སེམས་དེ་རྟག་བདག་སོགས་སུ་སྒྲོ་འདོགས་པའི་རྐྱེན་གཞན་གྱིས་ནི་ཕྱིན་ཅི་ལོག་ཏུ་གོལ་བར་འགྱུར་ཞིང་།",
    "དེས་ཐབས་མཁས་སྦྱོར་བས་མྱུར་དུ་འཚང་རྒྱ་བ་སྔགས་ཀྱི་ཐབས་རྣམས་ཀྱང་རང་སྟོབས་ཀྱིས་མངོན་དུ་བྱེད་ནུས་པ་ལྟ་བུའོ།",
    "དེ་འདྲའི་གོང་བུ་དེ་གྲང་བའི་རྐྱེན་དང་ལྡན་ན་དུས་ཤིན་ཏུ་ཡུན་རིང་པོར་འདུག་ཀྱང་མར་གསར་གྱི་གོང་བུ་ལྟར་འདུག་གོ།",
    "སྒྲུབ་བྱེད་དེ་ཉིད་སྔ་མ་བསྒྲུབ་བྱ་དང་མཚུངས་ཏེ་ཁོ་རང་ཡང་རང་བཞིན་མ་གྲུབ་པར་སྒྲུབ་ནུས་པས་ན།",
    "ཆུ་དྲག་པོ་ལམ་སྲོལ་དུ་འཛུད་པ་ལྟར་དྲན་པས་སླར་ཡང་རང་ཤུལ་དུ་བླན་ཏེ་བཞག་པ་ནི་གསུམ་པའོ།",
    "སྐྱོན་མེད་པ་ན་བཏང་སྙོམས་སུ་འདུག་པ་སྟེ་སྤྲོ་རྩོལ་དྲན་དང་ཤེས་བཞིན་བཏང་སྙོམས་ལྔས་ཡང་ནས་ཡང་དུ་བསྒྲུབས་པས།",
    "དྲུག་པ་བཀྲི་བ་དང་ངེས་པའི་དོན་དུ་གསུངས་པའི་སྡོམ་པ་ཇི་སྙེད་པ་ཐམས་ཅད་ཀྱང་རང་བཞིན་ལྷུན་གྱིས་གྲུབ་པའི་ཚུལ་དུ་འདུས་ཤིང་རྣམ་པར་དག་པ་ནི་གོང་དུ་བསྟན་པ་བཞིན་ནོ།",
    "ལུས་ཀྱི་ནི་ཕྱག་རྒྱ་དང་བྲོ་དང་གར་དང་ལྟ་སྟངས་དང་འདུག་ཚུལ་ལ་སོགས་པ་དང་།",
    "འགྲོ་དྲུག་དུས་གནས་མ་ལུས་སྣང་།",
    "ཤིང་རྟ་ལ་སོགས་རྟ་ལ་འདུག་སྤྱོད་པ།",
    "དེ་ཡང་སློབ་དཔོན་གྱི་གཡོན་ཕྱོགས་སུ་གནས་པ་གཟུངས་མ་མཚན་ཉིད་དང་ལྡན་པ་ལ་འདུག་སྟངས་སོགས་ཚུལ་བཞིན་དུ་བྱས་ལ།",
    "དེ་ནས་ཐ་མལ་གྱི་འདོད་ཆགས་མ་སྤང་རང་སར་དག་ནས་ལྷན་སྐྱེས་བདེ་བའི་ཡེ་ཤེས་ཆེན་པོར་གསལ་བའི་ཕྱིར།",
    "དེ་ཡང་རང་བཞིན་གྱི་མཚམས་ནི་རྣམ་པར་རྟོག་པ་བགེགས་ཡིན་ལ།",
    "ལས་ཅི་ཡང་སྣང་བའི་ཕྱིར་དག་པའི་གཞལ་ཡས་ཉིད་དུར་ཁྲོད་ཀྱི་གཞལ་ཡས་ཁང་དུ་གྱུར་པའི་ནང་དུ་སྔགས་བརྗོད་པས་ལྷ་ཞེ་གཉིས་འོད་དུ་ལྟེམ་གྱིས་ཞུ་ནས་འདུག་པ་ལ།",
    "ཧཱུྃ་ཧ་ཧེ་ཕཊ་བྷོ་རོ་ཞེས་བརྗོད་པ་ཙམ་གྱིས་སོ་སོའི་ཡིག་འབྲུར་གྱུར་ནས་སོ་སོའི་གནས་ན་བསྐལ་མེ་ལྟར་འབར་ཞིང་འདུག་པ་ལ།",
    "ཕྱག་རྒྱ་བཞིས་བཅིངས་ལ་ཁོ་རང་དངོས་སུ་བསམ་པའམ་མཚན་མའི་རྫས་ལ་དགྲ་བགེགས་དགུག་པ་སྲོག་མེད་ཀྱི་སྒྲུབ་རྫས་སམ།",
    "ཐོག་མར་སློབ་དཔོན་བདག་ཉིད་དཀྱིལ་འཁོར་གྱི་ནུབ་ཕྱོགས་སུ་འདུག་སྟེ་རྡོ་རྗེ་ཤུགས་ཀྱི་ཕྱག་རྒྱས་བཏེགས་པས་དཀྱིལ་འཁོར་གྱི་ལྷ་རྣམས་མདུན་གྱི་མཁའ་ལ་སྨིན་མཚམས་ཡན་ཆད་འོད་ཕུང་འདབ་འདྲེས་སུ་བཞུགས་པར་བསམས་ལ།",
    "གཞན་ཡངམཁས་པ་༤ ལམ་ཡིན་གྱི་བུས་པའི་འགྲོ་བརྣམས་ལ་འདྲིད་པ་དེ་བཞིན་དུ་རྣམ་པར་ཤེས་པ་ཡང་རྣམ་པ་གཞན་དུ་འདུག་ལ།",
    "མུར་འདུག་གཞནལ་གྲགས་པ་ཡི།",
    "མུར་འདུག་འཇུས་པའི་དྲེགས་པ་སེལ།",
    "ཉན་ཐོས་རྣམས་དང་རང་རྒྱལ་དང་།",
    "ཉནཐོས་རྣམས་དང་མུར་འདུག་གཞན།",
    "ལུསན་ཀུན་ཏུ་རྒྱས་པར་འདུག།",
    "འགྲོ་འདུག་རྣམ་པར་རྒྱུག་པ་ཡི།",
    "མུརའདུག་ཉན་ཐོས་རྣམས་སྤངས་པ།",
    "གཅིག་ཏུ་འདུག་གོ།",
    "དེའི་ཚེ་ཚོདང་ལྡན་པ་ཀུན་དགའབོ་བཅོམ་ལྡན་འདས་ཀྱི་ཕངསན་གཟིམས་ཁྲིལ་ཆིམ་བྱུང་སྨྲེ་སྔགས་འདོན་ཅིང་འདུག་གོ།",
    "ན་འགྱོ་ཡང་སྐམ་ལ་འདུག་པ་ཉིད་དུ་ཤེས་པར་བྱའོ།",
    "སྲདབུ་ཡངམཆིལ་པ་དང་འབྲེལ་བར་གྱུར་ན་ཆུའི་ནངན་འདུག་པ་ཡང་ཡིན་ལ།",
    "ས་བོན་དེ་དག་དུས་དང་ཚིགས་སུ་ཞིང་ལ་བཏབ་སྟེ་དུས་དུས་སུཆས་བཅུས།",
    "འོན་ཏེ་བྱེས་དེ་ཉིདན་འདུག་གམ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྟེང་དུ་རིན་པོ་ནབ་འཛིན་ཅིང་འདུག་སྟེ།",
    "རིགས་ཀྱི་བུ་ངེནས་རྒྱལ་པོ་རྩིབས་ཀྱི་མུ་ཁྱུད་བཅོམ་ལྡན་འདས་ཀྱིསྤྱན་སྔརའདུག་ནས།",
    "དེ་མལ་ནས་ལངས་ཏེ་རྨི་ལམ་དྲན་ཞིང་འདུག་བན་དེ་འདི་སྙམ་དུ་སེམས་ཏེ།",
    "དག་ཐོས་ནས་ཡང་ཨེ་རན་པའི་ཤིང་ངན་པའི་དྲུང་ན་འདུག་པ་དང་།",
    "བྲམ་ཟེ་རྒྱ་མཚོའི་རྡུལ་གྱི་མདུན་དུ་འདུག་ནས་འདི་སྐདཅེས་སྨྲས་སོ།",
    "ཡིད་བདེ་བ་སྐྱེས་ནས་ཕྱིར་ནུར་པའི་ཕྱིར་ཧཅང་ཡང་མི་རིང་བར་ཕྱོགས་གཅིག་ཏུ་འདུག་པོ།",
    "དེ་ནས་རྒྱལ་བུ་གཞོན་ནུ་ཨུ་ཁྱུད་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་ནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཏུ་འདུག་གོ།",
    "དེ་བཞིན་གཤེགས་པ་རིན་པོཆེའི་སྙིདཔོའི་སྤྱན་སྔར་འདུག་སྟེ།",
    "རིགས་ཀྱི་བུ་ད་ནས་བྲམ་ཟེའི་ཁྱེའུ་སྟོབས་ཆེན་ཤུགས་འཆང་དེ་ཡང་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུག་སྟེ་གསོལ་བ།",
    "དེན་འཚོབ་པ་མིའགྱུར་འཇིགས་བྱེད་ཅེས་བྱ་བ་གཅིག་ཅིག་འདུག་པ་དེས་སྨྲས་པ།",
    "རྡོ་རྗེའི་གདན་ལ་འདུག་པར་བྱ་བ་དང་།",
    "གནཾསི་ཞེས་བྱ་བ་ནི་འདུག་པར་གྱུར་པའོ།",
    "དབ་ལྡན་པ་ཀུན་དགའ་བོ་ལ་བཀའ་སྩལ་པ་ཞེས་བྱ་བ་ནི་དེ་སྤྱན་སྔར་འདུག་པའི་ཕྱིར་དང་བསྙེན་བཀུར་བ་ཡིན་པའི་ཕྱིར་དེ་ལ་བཀའ་སྩལ་སྤྱི་གཞན་ལམ་སྩའ།",
    "བརྟོག་ཀྱང་ལྷན་ཅིག་གནས་པར་བྱེད་ཅེས་བྱ་བའི་ལྷནཅིན་འདུག་པའོ།",
    "གདའ་ཆོ་ལོས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "འདུག་པ་ཞེས་བྱ་བ་ནི་རྐུབ་བཙེས་འཇོག་པར་བྱེདཔའོ།",
    "འདུག་སྟེགས་ཞེས་བྱ་བའི་སྟེགས་བུ་གང་ལཚོང་པ་འདུག་སྟེ་ཚོང་བྱེད་པའོ།",
    "ཁ་ལོ་བའི་གནས་ཞེས་བྱ་བ་ནི་ཁ་ལོ་བ་གད་དུ་འདུག་པས་བྱུང་ལགས་པས།",
    "ཁྱིམ་གནས་ཞེས་བྱ་བར་འདུག་པའི་གནས་སོ།",
    "གནསཞེས་བྱ་བའི་ཁྱིལ་སྟེ་འདུག་པའི་གནས་ཡིན་པའི་ཕྱིར་རོ།",
    "གཞིས་བྱ་བ་ཡང་འདུག་པའི་གནས་ཡིན་པའི་ཕྱིར་རོ།",
    "དབུསན་རྒྱལ་པོ་འདུག་པ་སྐྱོ་འབྲུའི་འབྲས་བུའི་རྣམ་པ་ལྟར་དམག་བཤམས་པའོ།",
    "དབུས་ན་རྒྱལ་པོ་འདུག་པ་སྟེ།",
    "འདུག་པ་ཞེས་བྱ་བ་རྐུབ་བཙོས་འཇོག་པ་འོ།",
    "ཉན་རྣ་ཞེས་བྱ་བའི་འཇབཅིང་དྲུང་དུ་འདུག་སྟེ་ཉན་པའོ།",
    "གང་འདུག་པ་ལ་ཁོ་བོ་སྤྲོད་དུ་འགྲོ་བའོ་ཞེས་སྨྲ་བར་བྱའོ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་བསྒོ་བར་བྱའོ་ཏིས་བྱ་བར་པོ་དེ་ལཡསྡོད་པར་བྲིས་ཤིག་ཅེས་བསྒོ་བར་བྱ་ད་བྱ་སྟེ།",
    "དེའིཚིག་རྗེས་སུ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བལ་སོགས་པ་ལུས་ཀྱི་རྣམ་པར་རིག་བྱེད་དང་རྣམ་པར་རིག་བྱེད་མ་ཡིན་པ་ཀུན་ནས་སློང་ནུསབ་ཁ་ཕྱིར་བལྟས་ཏེ་འདུག་པ་དང་།",
    "འདི་ནི་རང་རང་རྟགས་ཁབ་། སུ་བཟང་།",
    "རང་རང་རྟགས་དང་མི་མཐུན་པའི།",
    "ལུས་སྣང་སྟོང་ཤེས་ཙ་ན་རང་ལུས་ཡེ་ཤེས་ཀྱི་ལུས་སུ་གྱུར་ནས་དངོས་པོ་གང་ལ་ཡང་ཐོགས་པ་མེད་པར་ལུས་སྣང་སྟོང་གཉིས་མེད་ཀྱི་ཡེ་ཤེས་སོ།",
    "སྟོང་བཞིན་དུ་ངག་ཏུ་གྲགས་ངག་གྲགས་སྟོང་གཉིས་མེད་དུ་ཤེས་ཙ་ན།",
    "གསལ་སྟོང་གཉིས་མེད་དུ་ཤེས་ཙ་ན་སེམས་ཉིད་འགྲོ་འོང་གནས་གསུམ་དང་བྲལ་བའི་རང་བཞིན་རྟོགས་པས་སེམས་གསལ་སྟོང་གཉིས་མེད་ཀྱི་ཡེ་ཤེས་ངོས་བཟུང་བའོ།",
    "ཉམས་མྱོང་ལ་ཞེན་པ་བྲལ་ཙ་ན།",
    "ཕྱག་རྒྱ་ཆེན་པོ་དང་རང་སེམས་དབྱེར་མེད་པའོ།",
    "ལམ་དང་རང་བཞིན་གཉིས་མེད་དུ་བསྲེས་ལ་རོ་སྙོམས་པ་དང་།",
    "མ་རྟོགས་ཙ་ན་ཉམས་ཟག་བཅས་དང་།",
    "རྟོག་ན་བདེ་སྡུག་གཉིས་ཀ་ལ་རང་བཞིན་དུ་གྲུབ་པ་མི་འདུག་པས།",
    "གཉིས་པ་ཤུགས་འབྱུང་ཞེན་པ་དང་རང་གྲོལ་གྱི་སྤྱོད་ལམ་ལ་རོ་སྙོམས་པ་ནི་བཅུ་སྟེ།",
    "འདིར་གདའ།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིསོརློབས།",
    "བཀའ་དྲིན་ཆེན་པོའི་སྒོ་ནས་རྗེས་བཟུང་སྦྱོར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབསལ་དགྱེས་བཞིན་དུ་ཐིམ་པས་རང་ཉིད་སེངྒེ་ཆེན་པོ་བརྒྱད་ཀྱིས་བཏེགཔའི་རིན་པོའི་ཁྲིམཐོ་ཞིང་ཡངས་པའི།",
    "སེམས་ཁྱདཔར་ཅན་དང་ལྡན་པས་འདུག་ལ་སྐྱབས་ཡུལ་རྣམས་གསལ་བཏབ་སྟེ་རྒྱ།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱེན་གྱིས་རློབས།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་ཞིགྱིས་རློབས།",
    "མྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས།",
    "སམྱུར་དུ་ཁྱེད་རང་ལྟ་བུར་བྱན་གྱིས་རྨོངས།",
    "རང་རང་སོ་སོའི་གནས་སུ་སེང་ཤིག།",
    "སེམས་ཁོ་རང་གང་ལསབྱུང་།",
    "ཨ་ར་པ་ཙ་ན་ཡ་དེ་ནཱ་མ",
    "འོན་ཀྱང་རང་ངོ་ཤེས་པའི་གྲོལ་རྐྱེན་བྱེད་པའི་ཆ་ནས་གྲོལ་གཞི་ཞེས་བཏགས་ལ།",
    "ཚིག་དོན་མཛོད་ཀྱི་ལུང་དང་པོའི་དོན་གཞི་ནས་འཕགས་པའི་རིག་པ་ཙམ་འཁྲུལ་གྲོལ་གང་དུ་འགྱུར་ཆོག་པ་ཙམ་ཡིན་གྱི་ཁོ་རང་རང་ངོ་ཤེས་མ་ཤེས་གང་རུང་ལས་མ་འདས་ཏེ།",
    "སྔོ་འཛིན་ཤེས་པ་ལས་སྔོ་འཛིན་དང་དཀར་འཛིན་གཉིས་བསྐྱེད་ཀྱང་ཁོ་རང་དེ་གཉིས་ཀམིན་མི་དགོས་པ་བཞིན་ནོ།",
    "གཞི་སྣང་ཡིན་པ་དང་རང་སྣང་འཁོར་འདས་གང་དུ་འགྱུར་མ་ངེས་པའི་སྣང་བ་ཡིན་པའི་ཕྱིར།",
    "རིག་པ་གཞི་ནས་འཕགས་ཀྱང་རང་ངོ་ཤེས་མ་ཤེས་གང་ཡང་མིན་པའི་རིག་ཙམ་ཡོད་པ་དེ་འཁོར་འདས་གང་ཡང་མིན་ནོ་སྙམ་ན།",
    "མ་བརྟགས་ཡེ་ནས་ཆོད་ནས་འདུག།",
    "ངན་རྟོག་ཏུ་ཤར་ཡང་རང་སངས་སུ་རྗེན་ནེ།",
    "དགོངས་པའི་འདུག་ཚུལ་དེ་བཞིན་ནོ།",
    "ངོ་བོ་སྟོང་བ་དང་རང་བཞིན་གསལ་བ་གཉིས་དབྱེར་མི་ཕྱེད་པའི་རང་གདངས་འགགས་པ་མེད་པ་ཅི་ཡང་མིན་ལ་ཅིར་ཡང་འཆར་དུ་རུང་བ་འཁོར་འདས་ཐམས་ཅད་ལ་ཁྱབ་བྱེད་དུ་བཞུགས་པ་འདི་ནི་ཐུགས་རྗེ་ཀུན་ཁྱབ་འགགས་པ་མེད་པ་སྤྲུལ་པའི་སྐུ་སྟེ་རྒྱུད་ལས།",
    "རང་ངོ་ཤེས་པའི་ཆ་ནས་རང་བཞིན་གྱི་ཉམས་ལེན་དང་རང་གྲོལ་དུ་གྱུར་བས་ཐུགས་རྗེའི་ཉམས་ལེན་དུ་བཞག་པ་ཡིན་ནོ།",
    "ཡུལ་སྣང་གཞན་དུ་བཟུང་ན་ཉན་ཐོས་དང་རང་རྒྱལ་དུ་གོལ་སྣང་བ་སེམས་སུ་བཟུང་ན་སེམས་ཙམ་པར་གོལ།",
    "ལྔ་པ་ཉལ་བ་སོགས་འདུག་སྟངས་ཀྱི་རྐྱེན་གྱིས་བྱིང་ན་ལུས་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་བྱ།",
    "དེ་བཞིན་དུ་ནི་ཉན་ཐོས་དང་ དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "ངོ་བོ་ལྔ་དང་རང་བཞིན་ལྔ་ ཐུགས་རྗེ་ལྔ་ཡིས་ཀུན་ལ་ཁྱབ།",
    "རང་སེམས་ཅིར་ཡང་མི་བསམ་པར་བཞག་དུས་ལྷག་མཐོང་མ་སྐྱེས་པའི་ཧད་དེ་ཐོམ་མེ་བ་ནི་ཀུན་གཞི་ཡིན་ལ་གཉིད་མཐུག་དང་བརྒྱལ་བ་སོགས་ནི་འདིའི་བྱེ་བྲག་ཡིན།",
    "རྟོག་ཚོགས་བརྒྱད་ཁྲི་བཞི་སྟོང་རང་གྲོལ་དག་མཉམ་ཆེན་པོར་བཙན་ས་ཟིན་པ་ནི།",
