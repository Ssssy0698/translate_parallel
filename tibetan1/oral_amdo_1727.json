    "དབེན་པ་ཞེས་བྱ་བ་ནི་རྒྱུན་ལུགས་མེད་ཅིང་གཞན་དང་ཐུན་མོང་མ་ཡིན་པའོ།",
    "དབེན་པའི་མཐའ་ནི་བཙུན་མོའི་འཁོར་གྱི་སྒོ་གཏན་ལ་བྱའོ།",
    "འདིར་ལུང་ནི་རྒྱལ་པོས་བོས་པ་དང་བཙུན་མོ་དང་གཞོན་དུ་དང་ཞང་བློན་དག་བར་ཆད་བརྒྱད་པོ་དག་ལས་གང་ཡང་རུང་བ་ཉེ་བར་གནས་པར་གྱུར་ན་ཉེས་པ་མེད་དོ་ཞེས་གསུངས་པ་དང་།",
    "འདིར་གཞུང་ནི་གལ་ཏེ་དགེ་སློང་རྣམས་ཀྱིས་ཀྱང་ཚེ་དང་ལྡན་པ་འདི་སྔོན་གསོ་སྦྱོང་གི་ལས་གཉིས་སམ་གསུམ་གྱི་ཚེ་འདུག་པར་ཤེས་ན་ལན་མང་དུ་ལྟ་ཅི་སྨོས་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "མཚན་གཞན་གྱི་འདོན་པའི་ཚེ་ཐུན་མོང་བ་ལ་ནི་ཉེས་བྱས་སོ་ཞེས་བྱ་བ་ལ།",
    "ཐུན་མོང་བ་ལ་ནི་ཉེས་བྱས་སོ་ཞེས་བྱ་བ་ནི་དགེ་སློང་མའི་བསླབ་པའི་གཞི་དགེ་སློང་དང་ཐུན་མོང་གང་ཡིན་པ་ལ་འདི་སྐད་ཅེས་བདག་གིས་ད་གཟོད་ཤེས་སོ་ཞེས་བྱ་བ་ལ་སོགས་པ་ཟེར་ན་ཉེས་བྱས་སོ།",
    "གང་ཚེ་བསླབ་པ་ཐུན་མོང་བ་ལས་བསམ་ཏེ་སྨྲ་ན་ཉེས་བྱས་སོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདིར་འགྱོད་དུ་གཞུག་པ་ནི་ཚེ་དང་ལྡན་པ་ཁྱོད་མ་རྙེད་པའོ།",
    "ལེགས་པ་མ་རེང་པའོ་ཞེས་འགྱོད་དུ་གཞུག་གོ་ཞེས་བྱ་བ་གསུངས་པ་ཡིན་ནོ།",
    "འདིར་གཞུང་ནི་རྣམ་པར་འབྱེད་པ་ལས་གང་གིས་མདུན་དུ་འཆགས་པར་བྱེད་པ་དེས་ཁྱོད་ཀྱིས་དངོས་པོ་དེ་བཅད་དམ་ཞེས་དྲི་བར་བྱའོ།",
    "གང་དག་ལ་ལྷམ་མི་བདོག་པ་དེ་དག་གིས་མགོ་ལོགས་སམ་རྐང་པ་ལོགས་སུ་བཀྲུ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དགེ་སློང་དག་གིས་སྨྲས་པ་བཅོམ་ལྡན་འདས་ཀྱིས་རྗེས་སུ་མ་གནང་ངོ་ཞེས་བྱ་བ་ནས།",
    "དགེ་སློང་དག་ཁྲིའི་སྟེང་དུ་ཁྲི་བཞག་པ་ལ་འཁོད་ན་ཉེས་དམིགས་འགའ་ཡོད་དོ་སྙམ་ནས་དེ་ལྟ་བས་ན་དགེ་སློང་གིས་ཁྲིའི་སྟེང་དུ་ཁྲི་བཞག་པ་ལ་འདུག་པར་མི་བྱའོ།",
    "གང་གི་ཚད་ལས་ལྷག་པར་བྱེད་དམ་བྱེད་དུ་འཇུག་པ་ལ་ཞེ་ན།",
    "རྐང་པ་དག་གིའོ་ཞེས་འོག་ནས་འབྱུང་ངོ།",
    "གང་གི་རྐང་པ་དག་ཅེ་ན་དེའི་ཕྱིར་ཁྲིའམ་ཁྲིའུ་དག་གིའོ་ཞེས་བྱ་བ་སྨྲས་སོ།",
    "པ་ནི་དཔེར་ན་ཤིང་གི་ཁྲིའུ་ཁ་ཅིག་ལྟ་བུ་སྟེ་དེ་རྙེད་ཅེས་བྱ་བ་ནི་ཤུགས་ཀྱིས་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "རྐང་པ་དེ་དག་གི་ཚད་གང་ཡིན་ཞེ་ན་དེའི་ཕྱིར།",
    "དེ་དག་གི་ཚད་ནི་བུ་གར་གཞུག་པའི་ཕྱོགས་མ་གཏོགས་པར་ཁྲུ་གང་ངོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "རྐང་པ་དེ་དག་གི་ཚད་ནི་བུ་གར་གཞུག་པ་ཞེས་བྱ་བའི་ཕྱོགས་དག་མ་གཏོགས་པར་རྐང་པ་ཉིད་ཀྱི་ཕྱོགས་ཀྱི་སྲིད་ཁྲུ་གང་ངོ།",
    "བདེ་བར་གཤེག་པའི་ཁྲུའི་སུམ་ཆས་གཞལ་བས་ནི་མི་འབྲིང་གི་ཁྲུ་ཚད་རྣམ་པར་འཇོག་པར་བྱེད་དོ།",
    "དེའི་ཚད་གང་ཞེ་ན་དེའི་ཕྱིར་འདིའི་ཚད་ནི་སྲིད་དུ་ཁྲུ་གསུམ་མོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གདིང་བའི་ཞིང་གི་ཚད་ཅེས་བྱ་བར་སྦྱར་རོ།",
    "དེ་ཆུང་དུ་ལ་བྱིན་གྱིས་རློབ་ན་ཉེས་བྱས་སོ་ཞེས་བྱ་བ་ནི་གདིང་བ་དེའི་ཆུ་ཞེང་གི་ཚད་ཇི་སྐད་བསྟན་པ་དེ་ལས་ཆུང་བ་ལ་བྱིན་གྱིས་རློབ་ན་ཉེས་བྱས་སུ་འགྱུར་བའོ།",
    "དང་གསུམ་མོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཞེང་དུ་ནི་ཁྲུ་གསུམ་མོ།",
    "ཞེང་དུ་ནི་ཁྲུ་གསུམ་མོ།",
    "དགེ་སློང་གིས་ཀྱང་འདི་བདག་གི་ཉེ་དུ་མ་ཡིན་པ་ཉིད་དོ་སྙམ་དུ་ཤེས་ན་ཉེ་དུ་མ་ཡིན་པ་ཉིད་དེ་ལ་འདུ་ཤེས་གཙོ་ཆེར་བྱེད་པ་པོ་ཉིད་ཡིན་ནོ།",
    "རང་གིས་མི་འགྲིམ་པར་བསྒྲུབས་པའི་བཅའ་བ་དང་བཟའ་བ་བདག་ཉིད་གྲོང་ན་འདུག་པས་བླངས་ཏེ་ཟོས་ནའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཁ་ཅིག་ནི་འདི་སྐད་ཅེས་སྦྱིན་པ་མོ་དང་ལེན་པར་བྱེད་པ་གཉི་ག་ལམ་པོ་ཆེན་འདུག་པ་དག་ལ་ནི་ཁ་ན་མ་ཐོ་བ་རྫོགས་པར་འགྱུར་རོ།",
    "དགེ་སློང་གི་གནས་ཀྱང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ཡང་གྲོང་ཉིད་མ་ཡིན་པའོ།",
    "གྲོང་གི་སྟེང་གི་ནམ་མཁའ་ལ་འདུག་པས་བླངས་ཏེ་ཟ་ན་ཉེས་བྱས་སུ་འགྱུར་བའོ།",
    "འཇོག་པར་བྱེད་པའི་དགེ་སློང་མས་ཟས་གང་གྲོང་དུ་འཇོག་པར་བྱེད་པའི་དགེ་སློང་མ་དེས་ཟས་དེ་གྲོང་དུ་བཞག་ནས་གུད་དུ་སོང་སྟེ་དེ་ནས་ཉེ་བར་མི་གནས་ན་དགེ་སློང་དེས་ཟས་དེ་གྲོང་དེ་ནས་ལེན་པར་བྱེད་ཀྱང་དེས་ཟས་དེ་འཇོག་པར་བྱེད་བ་དེ་ལས་བླངས་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གལ་ཏེ་དེའི་ཚིག་གིས་སམ་དེའི་ཉེ་དུས་མགྲོན་དུ་བོས་པ་མ་ཡིན་ནའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གལ་ཏེ་དགེ་སློང་མ་རྣམས་མགྲོན་དུ་བོས་བ་དགེ་སློང་མ་དེའི་ཚིག་གིས་མ་ཡིན་པ་དང་།",
    "ཡོན་བདག་གང་གིས་དགེ་སློང་རྣམས་མགྲོན་དུ་བོས་པ་དེ་སྐོ་ཤམ་བྱེད་པ་ལ་ཞུགས་པའི་དགེ་སློང་མ་དེའི་ཉེ་དུ་མ་ཡིན་ན་དེའི་བྱེད་པ་པོའི་ཉིད་ཡིན་པའོ།",
    "གང་གི་ཚེ་བྱུག་རིས་སྔ་མ་ལས་ཐོད་རྒལ་དུ་འདས་ཏེ་བྱུག་རིས་འོག་མར་བྱིན་པར་གྱུར་པ་དེའི་ཚེ་ན་བྱུག་རིས་གོང་མ་བཀོལ་བ་ཤོས་དེར་སྦྱིན་དུ་འཇུག་པའོ།",
    "དེ་ལ་དགེ་སློང་གང་ཡང་རུང་བ་ལྷན་ཅིག་མི་ཟ་བས་ཀྱང་རུང་བས་སྲིང་མོ་ཁྱོད་དགེ་སློང་རྣམས་ཟས་ཟོས་ཀྱི་བར་དུ་རེ་ཞིག་སྡོད་ཅིག་ཅེས་མ་བསྒོ་བར་དགེ་སློང་གསུམ་ལ་སོགས་པར་མགྲོན་དུ་བོས་པས་ཟོས་ནའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེའི་ཕྱིར་དགེ་སློང་གིས་ཞེས་བྱ་བ་སྨྲས་སོ།",
    "དགེ་སློང་སྟོན་མོ་དེའི་ནང་དུ་ཟན་ཟོས་ཟིན་ནས་སྔར་ལངས་བ་དེས་བསྒོ་བ་བྱས་ནས་ཡང་བསྒོ་བ་ཉིད་ཡིན་པས་དེའི་ཕྱིར་ལྷན་ཅིག་མི་ཟ་བས་ཀྱང་རུང་བས་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གང་གི་ཚེ་དགེ་སློང་དེ་དག་ཐམས་ཅད་ལངས་པར་གྱུར་ཟིན་ཅིང་དགེ་སློང་གཞན་དག་ཅིག་འཁོད་པར་གྱུར་ན་དེ་ལ་ནི་ལྷན་ཅིག་མི་ཟ་བར་ཞེས་བྱ་བར་མི་བཟུང་སྟེ།",
    "དགེ་སློང་དེ་དག་གིས་ཇི་སྐད་བསྒོ་བར་བྱ་ཞེ་ན།",
    "དེའི་ཕྱིར་སྲིང་མོ་ཁྱོད་དགེ་སློང་རྣམས་ཟན་ཟོས་ཀྱི་བར་དུ་རེ་ཞིག་སྡོད་ཅིག་ཅེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེ་ཡང་བཟློག་པར་བྱ་བའི་ཚིག་གི་དཔེ་ཙམ་དུ་ཟད་དོ།",
    "དགེ་སློང་མ་དེ་ལ་ཇི་སྐད་སྨོས་པའི་རྣམ་པ་དེ་དག་གིས་གལ་ཏེ་མ་བསྒོ་ཞིང་བརྡ་མ་སྤྲད་པར་རོ།",
    "གལ་ཏེ་བྲམ་ཟེ་དང་ཁྱིམ་བདག་གི་རིགས་ཀྱིས་མགྲོན་དུ་བོས་པ་དེས་སོ།",
    "འདིར་ཉེས་བྱས་ཀྱི་གཞུང་ནི་གང་དག་སྒོ་ཁང་ན་ཟ་བ་དེ་དག་གིས་དགེ་སློང་མ་དེ་ལ་བསྒོ་འམ་ཞེས་དྲི་བར་བྱ་སྟེ།",
    "གང་དག་སྒོ་ཁང་ན་ཟ་བར་དེ་དག་གིས་དགེ་སློང་མ་དེ་ལ་བསྒོ་འམ་ཞེས་དྲི་བར་བྱ་སྟེ་མ་དྲིས་བར་ཟན་ཉེས་བྱས་སུ་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཁ་ཅིག་ནི་བར་ཁང་ན་ཟ་བར་བྱེད་ལ་དེ་ན་གལ་ཏེ་དགེ་སློང་མ་སྐོ་ཤམ་བྱེད་ཅིང་འདུག་པར་གྱུར་ན་དགེ་སློང་མ་དེ་དག་གིས་དགེ་སློང་མ་དེ་ལ་བསྐོ་བར་བྱའོ།",
    "དགེ་སློང་དག་ཁ་ཅིག་ནི་འོག་ཁང་ན་ཟ་བར་བྱེད་ཁ་ཅིག་ནི་སྒོ་ཁང་ན་ཟ་བར་བྱེད་ལ་དེ་ན་གལ་ཏེ་དགེ་སློང་མ་སྐོ་ཤམ་བྱེད་ཅིང་འདུག་པར་གྱུར་ན་དགེ་སློང་དེ་དག་གིས་དགེ་སློང་མ་དེ་ལ་བསྒོ་བར་བྱའོ།",
    "གང་གི་ཕྱིར་འདུ་ཤེས་གཙོ་ཆེར་བྱེད་པ་པོ་ཉིད་ཡིན་པ་དེའི་ཕྱིར་དགེ་སློང་མ་དེ་ལ་བསྒོའམ་ཞེས་འདྲི་བ་ལ་བརྩོན་པར་བྱའོ།",
    "གང་གིས་ཤེ་ན་དེའི་ཕྱིར་གསོལ་བས་སོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་སོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སྡོམ་པ་དེ་བག་ཡངས་སུ་བྱ་ཞིང་གཞིག་པ་ཡང་གསོལ་བ་འབའ་ཞིག་གི་ལས་ཀྱིས་བྱ་བའོ།",
    "དགེ་སློང་གང་གི་ལྷུང་བཟེད་སྟོང་པ་དེ་ནི་ལྷུང་བཟེད་སྟོང་པ་སྟེ་ལྷུང་བཟེད་སྟོང་པ་དང་ལྡན་པའི་དགེ་སློང་དེས་བསླབ་པའི་སྡོམ་པ་བྱིན་པའི་ཁྱིམ་དུ་འཇུག་པར་མི་བྱའོ།",
    "དགེ་སློང་བསོད་སྙོམས་བླངས་ཏེ་བསླབ་པའི་སྡོམ་པ་བྱིན་པའི་ཁྱིམ་དུ་སོན་པ་ན་བསླབ་པའི་སྡོམ་པ་བྱིན་པ་དེའི་བྱིས་པ་ཁ་ཟས་སློང་བ་དག་ལ་དགེ་སློང་དེས་རང་གི་བསོད་སྙོམས་དེ་ལས་སྣུམ་ཁུར་སྦྱིན་པར་དེ་ཡང་མཚོན་པ་ཙམ་དུ་ཟད་དེ་བཅའ་བར་བྱ་བ་གཞན་དག་ཀྱང་སྦྱིན་པར་བྱའོ།",
    "ཁྱིམ་དེ་ནས་དགེ་སློང་རང་གི་ལག་གིས་བཅའ་བ་དང་བཟའ་བ་དག་བླངས་ཤིང་ཟོས་པ་དེ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "རེ་ཞིག་བདག་གི་དོན་ནི་གྲུབ་ཟིན་གྱི།",
    "དགེ་སློང་མ་ལས་ཟས་ལེན་པའི་སོ་སོར་བཤགས་པར་བྱ་བ་དང་པོ་ལ་ནི་རང་གིས་ཞེས་སྨོས་པས་གཞན་ནི་ན་སྨད་པ་ཉིད་ཡིན་ནོ།",
    "གཉིས་པ་ལ་སོགས་པ་སོ་སོར་བཤགས་པར་བྱ་བ་གསུམ་པོ་དག་ལ་ནི་རང་གིས་ཞེས་མ་སྨོས་པས་སྤྲིང་ཡིག་ལ་སོགས་པ་དང་མངགས་པས་བླངས་པ་ལ་ཡང་ཁ་ན་མ་ཐོ་བ་འདྲའོ།",
    "ཧ་ཅང་རྩེངས་པ་མ་ཡིན་པར་ཡང་ངོ་ཞེས་བྱ་བ་ལ་འདིར་ཧ་ཅང་རྩེངས་པ་ཞེས་བྱ་བ་ནི་པུས་མོ་གཉིས་ལས་གང་དུ་ཐལ་བ་ཉིད་དོ།",
    "ཧ་ཅང་འཇོལ་བ་ཞེས་བྱ་བ་ནི་ལོང་བུའི་ཚིགས་ལ་རེག་པ་ཉིད་དེ།",
    "གོང་དུ་མ་ལྟེབས་པར་རོ་ཞེས་བྱ་བ་དང་འདི་གཉིས་ནི་སྟེང་གི་ཁང་ལོགས་ན་གནས་པའི་རྣམ་པ་ཡིན་ནོ།",
    "ཤམ་ཐབས་དང་སྟོད་གཡོགས་དག་གིས་གཡོགས་པར་བྱ་བའི་ལུས་མཉམ་པར་གཡོགས་ཤིང་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གིས་ནི་འགྲོ་བར་བྱའོ།",
    "འདི་སྐད་བསྟན་ཏེ་ལྟག་པའི་ཕྱོགས་སུ་ལག་པ་ཕན་ཚུན་ནས་སྤྲད་ཏེ་སོར་མོ་བསྣོལ་བ་ཞེས་བྱ་སྟེ་དེ་ལྟར་མི་བསྣོལ་བར་རོ།",
    "རྐང་པའི་རྟིང་པ་བཏེག་སྟེ་སོང་མོའི་བྲང་བས་སལ་ཕབ་སྟེ་འགྲོ་བར་མི་བྱའོ།",
    "ལག་པ་གཉིས་རྐེད་པའི་ཕྱོགས་སུ་བརྟེན་ཏེ་གྲུ་མོའི་ཕྱོགས་སྨྱང་སྨྱང་པོར་བྱས་ཏེ་འགྲོ་བར་མི་བྱའོ།",
    "ཁྱིམ་གཞན་དེར་ཁྱིམ་བདག་གིས་མ་བསྒོ་བར་དགེ་སློང་སྟན་ལ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "ཁའི་མུ་ནས་མཐེ་བོའི་ལྟོ་གང་གིས་མ་གང་བར་བྱས་ཤིང་བླང་བ་ནི་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་བཟའ་བར་བྱ་བའི་ཟས་གཡོས་སུ་བྱས་ཟིན་པ་ཐམས་ཅད་བསོད་སྙོམས་ཉིད་དུ་བསྟན་པ་ཡིན་པ་དེའི་ཕྱིར་རང་ལ་དགོས་པའི་ཚད་ལས་ལྷག་པའི་ཚོད་མ་ལེན་པ་དེ་བཀག་པ་ཡིན་ནོ།",
    "དེ་ལྟར་ཡང་འདིར་གཞུང་ནི་མ་མོ་ལས་ཇི་ཙམ་གྱིས་དེ་འཚོ་བར་འགྱུར་བ་དེ་ལས་ལྷག་པར་ལེན་ཏམ་ཟ་ན་ཐ་ན་ཁམ་གཅིག་ཙམ་ཡིན་དུ་ཟིན་ཀྱང་དད་པས་སྦྱིན་པར་བྱ་བ་ཆུད་གཟན་པར་བརྗོད་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འབྲས་ཆན་ལ་སོགས་པའི་འབྲུ་སྟེ་ཟན་གང་ལ་འབྲུ་སྟེ་དེ་ལྟ་བུ་ཡོད་པ་དེར་ག་རེ་རེ་ནས་བཏུ་ཞིང་བཟའ་བར་མི་བྱའོ།",
    "ལྷུང་བཟེད་མི་བསྐྱམ་མོ་ཞེས་བྱ་བ་ལ།",
    "སོར་མོས་མི་བྱོག་པའོ།",
    "ལྷུང་བཟེད་མི་བསྐྱམ་མོ་ཞེས་བྱ་བ་ནི།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་གི་ལྷུང་བཟེད་ལ་འཕྱས་གདགས་པའི་ཕྱིར་མི་བལྟའོ་ཞེས་བྱ་བ་ནི།",
    "དེས་དྲུང་ན་འདུག་པའི་དགེ་སློང་གི་ལྷུང་བཟེད་ལ་འཕྱས་གདགས་པའི་ཕྱིར་མི་བལྟ་བའོ།",
    "ལྷུང་བཟེད་ལན་གསུམ་བཀྲུས་ཏེ་གཙུག་ལག་གི་ཚིགས་སུ་བཅད་པ་དག་གིས་བཟླས་བརྗོད་བྱས་པའི་ལྷུང་བཟེད་ཀྱི་ཆུ་སྦྱིན་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དྲང་སྲོང་གིས་གསུངས་པའི་གཙུག་ལག་གི་ཚིགས་སུ་བཅད་པ་དག་གིས་བཟླས་བརྗོད་བྱས་པ་བྲམ་ཟེ་ལ་སོགས་པ་སློང་བ་དག་ལ་སྦྱིན་པར་བྱའོ།",
    "ལོ་མ་ལ་སོགས་པ་དག་གིས་མ་གཡོགས་པ་འོག་གཞི་མེད་པའི་ས་ཕྱོགས་སུ་ལྷུང་བཟད་མི་གཞག་པར་བསླབ་པར་བྱ་བའོ།",
    "ངོས་ཆད་པའི་ངམ་གྲོག་གི་ཁ་མ་ཡིན་པར་ལྷུང་བཟེད་གཞག་པར་བསླབ་པར་བྱ་བའོ།",
    "དགེ་སློང་གིས་འགྲེང་སྟེ་ལྷུང་བཟེད་མི་བཀྲུ་བར་བསླབ་པར་བྱ་བའོ།",
    "ཉན་པ་པོ་མིན་བར་གླང་པོ་ཆེ་ལ་ཞོན་པ་དང་རྟ་ཞོན་པ་དང་ཁྱོགས་ན་འདུག་པ་དང་།",
    "དགེ་སློང་གི་རྣམ་པར་འབྱེད་པ་སྨྲས་ནས།",
    "གང་གི་ཕྱིར་ལུས་ཀྱི་བྱེ་བྲག་གིས་བསམ་པས་བྱེ་བྲག་ཏུ་འགྱུར་ལ།",
    "དེ་དག་གི་བྱེ་བྲག་བརྗོད་པར་བྱའོ།",
    "རེག་པ་དང་ནི་ལུས་བཀན་དང་།",
    "དགེ་སློང་གི་རྣམ་པར་འབྱེད་པར་ཕམ་པར་འགྱུར་བ་བཞི་པོ་མི་ཚངས་པར་སྤྱོད་པ་དང་མ་བྱིན་པར་ལེན་པ་དང་།",
    "ད་ནི་ཕམ་པར་འགྱུར་བ་དག་གི་བྱེ་བྲག་བརྗོད་པར་བྱ་སྟེ།",
    "དེ་ལ་གང་ལ་རེག་པའི་ཕམ་པར་འགྱུར་ཞེ་ན་དེའི་ཕྱིར་བདག་གིར་བྱེད་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཡན་ལག་གང་གིས་ཤེ་ན་དེའི་ཕྱིར།",
    "མིག་ནས་པུས་མོའི་བར་གྱིས་སོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "མིག་གི་གནས་མན་ཆད་ནས་པུས་མོའི་ལྷ་ང་ཡན་ཆད་ཀྱི་བར་དེས་སོ།",
    "དེས་ཅི་ཞིག་བདག་གིར་བྱེད་པ་ལ་ཞེ་ན་དེའི་ཕྱིར་རེག་པའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གང་གི་རེག་པ་ཞེ་ན་དེའི་ཕྱིར་ཕོའིའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གལ་ཏེ་དགེ་སློང་མས་འཁྲིག་པའི་འདོད་ཆགས་ཀྱི་བསམ་པས་ཕོའི་རེག་པ་བདག་གིར་བྱེད་ནའོ།",
    "སྐྱེས་པ་ཆགས་པར་གྱུར་པ་ཞེས་གསུངས་མོད་ཀྱི།",
    "འདི་ལྟར་དེ་དག་ཉིད་ཀྱིས་རྣམ་པར་འབྱེད་པ་ལས་ཆགས་པར་གྱུར་པས་སྐྱེས་པ་མ་ཆགས་པས་པུས་མོ་ཡན་ཆད་མིག་མན་ཆད་དུ་ནོམ་པར་བྱེད་ཉུག་པར་བྱེད་པ་བདག་གིར་བྱེད་ན་ཕམ་པར་འགྱུར་རོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "མིག་ནས་པུས་མོའི་བར་ལས་གཞན་པའི་ཡན་ལག་གི་ཕོའི་རེག་པ་འཁྲིག་པའི་འདོད་ཆགས་ཀྱིས་བདག་གིར་བྱེད་པ་ལ་ནི་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "སྐྲ་དག་དང་དེ་དང་འབྲེལ་པའི་གོས་ལ་རེག་པ་ལ་ཅི་ཞིག་ཏུ་རྣམ་པར་གཞག་ཅེ་ན།",
    "འཁྲིག་པའི་འདོད་ཆགས་ཀྱི་སེམས་མ་ཡིན་པས་བདག་གིར་བྱེད་པ་ལ་ནི་གང་ལ་ཕམ་པར་འགྱུར་བར་གསུངས་པ་དེ་ལ་ནི་སྦོམ་པོར་ན་སྨད་ལ་གང་ལ་སྦོམ་པོར་གསུངས་པ་དེ་ལ་ནི་ཉེས་བྱས་སུ་ན་སྨད་དོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གང་ལ་ཉེས་བྱས་སུ་འགྱུར་བ་དེ་ལ་ནི་ཉེས་བྱས་ཐ་མོར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བུ་ལ་རེག་པ་ལ་ནི་སྐྱོན་ཆགས་པ་མེད་དོ་ཞེས་བྱ་བ་ནི།",
    "རྣམ་པར་འགྱུར་བ་མེད་པའི་སེམས་ཀྱིས་བུ་ལ་རེག་པ་ལ་ནི་སྐྱོན་ཆགས་པ་མེད་དོ།",
    "གཞན་ཡིན་ན་བྱིས་པ་ལ་ཡང་རེག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དེ་ལྟ་བས་ན་རེག་པར་བྱ་བ་དང་བསྣུན་པར་བྱ་བ་དང་བསྐྱེད་པར་བྱ་བར་རྗེས་སུ་གནང་ངོ་ཞེས་གསུངས་པའི་བར་དང་།",
    "བུད་མེད་ནི་སྲེད་པ་ཅན་ཡིན་པས་དགེ་སློང་མ་རྣམས་ཀྱིས་དེ་ཕྲག་པ་ནས་ཕྲག་པར་བརྒྱུད་པར་བྱེད་དེ་དེ་ཕྲག་པ་ནས་ཕྲག་པར་བརྒྱུད་པ་ན་རྐ་བར་གྱུར་ནས་བཅོམ་ལྡན་འདས་ཀྱིས་བཀའ་སྩལ་པ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་མས་གཞན་གྱི་བུ་ལ་རེག་པར་མི་བྱའོ།",
    "རེག་ན་འགལ་ཚབས་ཅན་དུ་ཡང་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདོད་པ་དང་ལྡན་པའི་བསླབ་པའི་གཞི་རེག་པ་དང་མི་ཚངས་པར་སྤྱོད་པ་ལ་སོགས་པ་ལ་ནི་བསྟེན་པའི་མཐུ་ཡོད་པ་ཉིད་ཀྱི་ཕོ་ནི་ཁ་ན་མ་ཐོ་བ་ཡོངས་སུ་རྫོགས་པར་བྱེད་པ་ཉིད་ཡིན་ནོ།",
    "དེ་ལྟར་ཡང་འདིར་གཞུང་ནི་གང་དུ་སྐྱེས་པས་བུད་མེད་བགྲོད་དུ་རུང་བདེ་ལྟ་བུའི་ཕྱོགས་སུ་ལུས་བཀན་ན་ཞེས་གསུངས་པ་དང་།",
    "དེ་ལྟར་གང་དུ་སྐྱེས་པས་བུད་མེད་བགྲོད་དུ་རུང་བ་དེ་ལྟ་བུའི་ཕྱོགས་སུ་ལུས་བཀན་ན་ཕམ་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཧ་ཅང་བརྟད་པར་མི་འཇུག་ཅིང་བཙུན་སྦུ་མ་ཉམས་པར་འཇོ་སྒེག་དང་ཀུན་དུ་རྩེ་བ་ལ་སོགས་པའི་ལུས་དང་ངག་གི་ལས་སོ།",
    "སྐྱེས་པ་འོང་བ་དང་འགྲོ་བ་བདག་གིར་བྱེད་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་དུ་གསུངས་པ་ཡིན་ནོ།",
    "ཚིགས་འཁྲུལ་པ་ཉིད་ལ་སོགས་པ་ལུས་དང་དག་གི་ལས་སོ།",
    "དགེ་སློང་མ་ཆགས་པར་གྱུར་པ་དེས་སྐྱེས་པ་ཆགས་པར་གྱུར་པ་དེ་ལ་སྐྱེད་མོས་ཚལ་ཆེ་གེ་མོ་ཞིག་ཏུ་ཤོག་ཤིག་ཅེ་འམ་ཁྱོད་ཀྱི་ཁྱིམ་ཆེ་གེ་མོ་ཞིག་ཏུ་ཁོ་མོ་འང་ངོ་ཞེས་དུས་མལ་ཚིག་གིས་ནོད་པ་དང་།",
    "སྐྱེས་པ་ཆགས་པར་གྱུར་པས་ཁོ་བོ་སྐྱེད་མོས་ཚལ་ཆེ་གེ་མོ་ཞིག་ཏུ་འོང་གིས་ཁྱོད་ཀྱང་གནས་དེར་ཤོག་ཤིག་ཅེས་དུས་མལ་བཏབ་པ་ཚིག་གིས་ནོད་ན་སྦོམ་པོའོ།",
    "འདིར་གཞུང་ནི་སྤྱིར་བསྟན་པ་ལས་ཚིག་གིས་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཁོ་བོ་སྔ་དྲོ་སྟ་གོན་བྱེད་དོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་དུས་ཚོད་ཀྱི་བརྡས་དུས་འདེབས་པར་བྱེད་པ་ལ་ཁོ་མོ་ཡང་སྟ་གོན་བྱེད་དོ་ཞེས་དུས་ཚོད་ཀྱི་བརྡ་ཚིག་གིས་ནོད་ན་སྦོམ་པོའོ།",
    "ཁོ་བོ་གོས་འདི་ལྟ་བུ་གྱོན་པ་ཁྱོད་ཀྱིས་མཐོང་ན་སྟ་གོན་གྱིས་ཤིག་ཅེས་བྱ་བ་ལ་སོགས་པའི་མཚན་མ་བྱེད་པ་ནོད་ན་སྦོམ་པོའོ།",
    "དེའི་འོང་བ་དང་འགྲོ་བའི་འཇུག་པ་བདག་གིར་བྱེད་ནའོ་ཞེས་བྱ་བ་ནི།",
    "སྐྱེས་པ་ཆགས་པར་གྱུར་པ་དེའི་འོད་པ་དང་འགྲོ་བའི་འཇུག་པ་བདག་གིར་བྱེད་ན་སྤོམ་པའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "བུད་མེད་དམ་སྐྱེས་པ་གང་ཡང་རུང་བའི་ཕྱིར་བཤམས་ན་ཡང་ངོ།",
    "འདིར་གཞུང་ནི་གཏམ་གྱི་གཞིལ་ལས་དགེ་སློང་མས་དགེ་སློང་མ་མི་ཚངས་པར་སྤྱོད་པ་བྱེད་པ་མཐོང་ལ་དེ་བཅབས་ཤིང་འདུ་ཤེས་སྦས་ནས་སྐྱ་རེངས་ཤར་ན་ཕམ་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "མཚན་མོ་ཉིན་མོ་ལམ་འགྲོ་དང་།",
    "སྐྱེས་པས་བསྙེན་པ་བཀུར་བསྔགས་པ་ནི་རིགས་ཀྱི་བུད་མེད་ཀྱིས་ནི་མི་རིགས་པས་དེའི་ཕྱིར་དེ་ནི་དགེ་སློང་མ་རྣམས་ལ་མེད་དོ།",
    "དེ་དག་གི་ངོ་བོ་ཉིད་སྔར་དགེ་སློང་གི་ཁ་ན་མ་ཐོབ་རྣམས་ཀྱི་སྐབས་སུ་བསྟན་ཟིན་པའི་ཕྱིར་རོ།",
    "དགེ་སློང་དང་ཐུན་མོང་མ་ཡིན་པ་ཅི་ཡང་རུང་བ་ལེན་པ་དང་།",
    "མཚན་མོ་འབྲལ་བ་དང་།",
    "ཉིན་མོ་འབྲལ་བ་དང་།",
    "བུད་མེད་དང་བསྟེན་པ་དང་།",
    "དེ་ལ་ཐུན་མོང་བ་མིང་ཙམ་རྣམས་པར་གཞག་པ་དག་ཇེ་བསྟན་པའི་ཕྱིར་སྨྱན་བྱེད་པའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "འདིར་དགེ་སློང་མ་ལ་བརྟེན་ཏེ་ཕྲན་ཚེགས་ལ་སོགས་པ་དག་ལས་ཅུང་ཟད་ལྷག་པར་གསུངས་པ་དག་བསྟེན་པའི་ཕྱིར་དགེ་སློང་མ་ལ་ཁྱིམ་པ་མོ་ཉིད་ཀྱི་བསྔགས་པ་བརྗོད་ན་སྦོམ་པོའི་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དགེ་སློང་མས་དགེ་སློང་མ་ལ་ཁྱིམ་པ་མོ་ཉིད་ཀྱི་བསྔགས་པ་བརྗོད་ཅིང་ཡང་དག་པར་འཛིན་དུ་འཇུག་ན་སྦོམ་པོའོ།",
    "ཉོན་མོངས་པ་དག་གིས་གནོད་པར་གྱུར་པ་རྣམས་ཀྱིས་གོ་བར་བྱས་པ་ན་སྦོམ་དགའ་མོས་ཚིག་དེ་སྐད་བརྗོད་པ་ལས་འདི་བཅས་ཏེ།",
    "དགེ་སློང་མས་བུད་མེད་གཞན་སྨད་འཚོད་མ་ཉིད་བྱེད་དུ་འཇུག་ན་སྦོམ་པོར་འགྱུར་རོ།",
    "བྲན་མོ་ཟོང་ཉིད་དུ་གཏོང་བ་ནི་དེ་ལས་ཕྱི་རོལ་དུ་གྱུར་པ་ཉིད་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "འདི་ལྟར་ཟོང་དགྲམ་པའི་ཚུལ་གྱིས་འཇོག་པ་གང་ཡིན་པ་དེ་ནི་བྲན་མོ་ཟོང་ཉིད་དུ་གཏོང་བ་ཞེས་བྱའོ།",
    "སྨད་འཚོང་མ་ཉིད་དུ་བྱེད་དུ་འཇུག་པ་ཞེས་བྱ་བ་ནི་རང་གི་ཁྱིམ་དག་ན་གནས་པ་དག་གིས་བྱེད་དོ།",
    "ཕོ་ཉིད་ལ་ནི་མོ་ཉིད་དོ།",
    "ཕོ་ཉིད་ལ་ནི་མོ་ཉིད་ཅེས་བྱ་བར་ཤེས་པར་བྱ་ལ་མོ་ཉིད་ལ་ནི་ཕོ་ཉིད་ཅེས་བྱ་བར་ཤེས་པར་བྱ་སྟེ།",
    "ཕོའི་རྟགས་ཀྱི་གནས་སུ་ནི་མོའི་རྟགས་བལྟ་བར་བྱ་བ་ལ་མོའི་རྟགས་ཀྱི་གནས་སུ་ནི་ཕོའི་རྟགས་སུ་བལྟ་བར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདིར་བདག་གིར་བྱེད་ན་ཞེས་བྱ་བ་ནི་ལེན་པ་ལ་བྱ་སྟེ།",
    "དེ་ལྟར་ཡང་རྣམ་པར་འབྱེད་པ་ལས་བདག་གིར་བྱེད་པ་ལ་ནི་ལེན་པར་བྱེད་པའོ་ཞེས་གསུངས་སོ།",
    "གང་ལས་བདག་གི་ཕྱེད་ཅེ་ན།",
    "སྐྱེས་པ་ཆགས་པར་གྱུར་པ་ལས་ཅི་ཡང་རུང་བ་བདག་གིར་བྱེད་ནའོ།",
    "དགེ་སློང་མ་ཆགས་པར་མ་གྱུར་པས་སྐྱེས་པ་ཆགས་པར་གྱུར་པ་ལས་ཅི་ཡང་རུང་བ་བདག་གིར་བྱེད་པ་ལ་ནི་སྦོམ་པོའོ།"
