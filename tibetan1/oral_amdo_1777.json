    "དེ་ནས་ཀརྨ་པ་མཚན་མོ་བཞེངས་ནས་བྱོན་ཏེ།",
    "ཡེ་གྲུབ་ཐོབ་ཨུ་རྒྱན་པ་ཁྱོད་ངའི་རྩར་མི་འབྱོན་པར་སིལ་མ་ལ་ལ་འགྲོ་འདོད་པར་སྣང་སྟེ།",
    "ཀ་ཏོ་ར་ནས་ཀྱི་བཀང་བ་སྦ་ལྕག་གིས་བསྐྲུགས་པ་དབུ་ཐོག་ཏུ་བཞག།",
    "ང་ཡི་མགོ་འདོན་ཡང་ཁྱོད་ཀྱིས་བྱེད་དགོས།",
    "ཁྱོད་ཀྱི་གདུལ་བྱ་ཉི་མ་ལྷོ་རྒྱུད་ན་ཡོད།",
    "ཤེ་མོང་དང་ཕོ་ངར་ཆེ་ཤོས་ཡིན།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་ཀུན་ནས་ཉོན་མོངས་པ་མ་སྤངས།",
    "དེ་ཡན་ཆད་སྔར་བས་ཁྲིགས་ཆུང་དུ་སོང་ནས།",
    "ཚིག་གི་གོ་རིམ་དང་བྲལ་བས་སྨྱོན་པ་ལྟ་བུ།",
    "ཚིག་ལ་ངོས་བཟུང་མེད་པས་སྟོན་ཆུང་གི་བཞད་གད་ལྟ་བུ།",
    "གོང་འོག་གི་འགལ་འབྲེལ་མི་རྩི།",
    "རེས་འགའ་ཡུལ་རྐྱེན་གྱི་སྟབས་ལ་བརྟེན་ནས།",
