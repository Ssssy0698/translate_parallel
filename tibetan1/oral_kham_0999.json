    "གཟུགས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྒྲ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དྲི་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རོ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྣའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལྕེའི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལུས་ཀྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཆུའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མྱེའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ནམ་མཁའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པའི་ཁམས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མ་རིག་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འདུ་བྱེད་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མྱིང་དང་གཟུགས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྐྱེ་མཆེད་དྲུག་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཚོར་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྲེད་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལེན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྲིད་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྐྱེ་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ནང་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཕྱི་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྟོང་པ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཆེན་པོ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དོན་དམ་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་༺འབུམ་ཨ་",
    "དངོས་པོ་མྱེད་པའི་ངོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དྲན་པ་ཉེ་བར་གཞག་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཡང་དག་པར་སྤོང་བ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྫུ་འཕྲུལ་གྱི་རྐང་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྟོབས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འཕགས་པའི་ལམ་ཡན་ལག་བརྒྱད་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "འཕགས་པའི་བདེན་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བསམ་གཏན་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "གཟུགས་མྱེད་པའི་སྙོམས་པར་འཇུག་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མཐར་ཀྱིས་གནས་པའི་སྙོམས་པར་འཇུག་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སྨོན་པ་མྱེད་པའི་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཏིང་ངེ་འཛིན་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "གཟུངས་ཀྱི་སྒོ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྟོབས་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "མྱི་འཇིགས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "བྱམས་པ་ཆེན་པོ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "རྒྱུན་ཏུ་ཞུགས་པའི་འབྲས་བུ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལན་ཅིག་ཕྱིར་འོང་བའི་འབྲས་བུ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ཕྱིར་མྱི་འོང་བའི་འབྲས་བུ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "དགྲ་བཅོམ་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།",
    "ལམ་གྱི་རྣམ་པ་ཤེས་པ་ཉིད་ཀྱང་རང་བཞིན་སྟོང་པ་ཉིད་དོ།"
  ]
}