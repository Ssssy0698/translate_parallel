    "དེས་དེ་ཡི་ཆད་པར་མི་འགྱུར་ཞིང་།",
    "རྙེད་པའི་ལོངས་སྤྱོད་དེས་འགྱོད་པར་ཡང་མིབྱེད།",
    "ཡོ་བྱད་ཅི་དགོས་པ་རྙེད་པརའགྱུར་རོ་སྙམ་ནས་མགོ་འཕང་བསྟོད་དེ།",
    "རྟག་ཏུ་རྒྱུན་མི་འཆད་པར་འཆི་བའིའདུ་ཤེས་ཀྱིས་ཉེ་བར་གནས་ཤིང་།",
    "འདིར་ཡངལྷ་དང་མིར་སྐྱེ་བའི་རྒྱུཡོད་པར་མ་མཐོང་ལ།",
    "འདོད་པརྣམས་ལ་ལོག་པར་བསྒྲུབ་པ་དང་།",
    "ལོག་པར་བསྒྲུབས་པའི་འབྲས་བུབསྟན་ཏོ།",
    "ཚངས་པར་སྤྱད།",
    "འདོད་པ་རྣམས་ཉིད་དུས་གཞན་གྱིཡིན་པར་བསྟན་ཏོ།",
    "འདོད་པ་རྣམས་ཀྱིབྲྗོད་པར་བྱ་བའི་མཚན་ཉིད་ཀྱི་སྒོ་ནས་བསྟན་པ་ཡིན་ཏེ།",
    "ཚངས་པར་སྤྱད་པས་ནི་ལོགཔར་བསྒྲུབསཔའི་འབྲས་བུ་བསྟན་ཏོ།",
    "ལོག་པརསྨོན་པ་རྣམ་པར་སྤངས་པ་དང་།",
    "ཚངས་པར་སྤྱོད་པ་ལ་གནས་པདང་།",
    "ལྟ་བ་རྣམ་པར་སྤངས་པ་དང་།",
    "ལྟ་བའི་རྩ་བ་ལས་བྱུངབའི་ང་རྒྱལ་རྣམ་པར་སྤངས་པ་དང་།",
    "རྙེད་པ་དང་བཀུར་སྟི་ལཞེན་པ་རྣམཔར་སྤངས་པ་ནི།",
    "འདོད་པ་ཡོངས་སུ་སྤངས་པའི་རིགས་པའི་ངོ་བོཡིན་པར་བསྟན་ཏེ།",
    "ཚེ་འདི་ཉིད་ལ་འདོད་པ་འགྲུབ་པརམི་འགྱུར་ཏེ།",
    "དེའི་གཞི་ལས་ཕྱི་མ་ལ་འགྲུབ་པར་འགྱུར་རོ།",
    "རྣམགྲངས་དེས་ན་འདོད་པ་རྣམས་དུས་གཞན་ན་འགྲུབ་པར་བསྟན་པ་ཡིནནོ།",
    "ཚིགས་སུ་བཅད་པ་བཞིཔས་ནི་བསྟན་པའི་དོན་རྒྱས་པར་བསྟན་ཏོ།"
  ]
}