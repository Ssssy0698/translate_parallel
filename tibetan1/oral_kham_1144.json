    "མཉམ་དུ་འདུག་པར་ཡང་འགྱུར་རོ།",
    "ལེན་པགཉིས་ནི་མ་རིག་པ་དང་ལྷན་ཅིག་འདུག་པའི་ཕྱིར་རོ།",
    "སྲིད་པའོ་དེ་ལ་སྲེད་པ་དད་ལེན་པའི་ཡན་ལག་ནི་སྲེད་པར་བྱེད་པའི་ལས་ཅན་ཡིན་ནོ་ཞེས་བྱབ་ནི་སྲེད་པའི་རྐྱེན་གྱིས་བྱུང་བའི་ལེན་པསརྣམ་པར་ཤེས་པའི་རྒྱུན་ལ་བག་ཆགས་སུ་འདུག་པའི་ལས་རྣམས་སྲིད་པར་གྱུར་པར་བྱེད་དོ།",
    "དཔེར་ན་ཚོར་བ་ལ་སོགས་པའི་རྫས་བཞིན་ནོ་ཞེས་བྱ་བ་ཞི་ལྷན་ཅིག་ཏུ་དུ་མ་མི་འདུག་པ་བཞིན་ནོ།",
    "མདུན་དུ་དུལ་བར་འདུག་པ་དང་།",
    "རང་ཉིད་ཉལ་བ་དང་འདུག་པ་དང་།",
    "སྟན་ལ་འདུག་པའི་ཚེ་རྐང་པ་བརྐྱང་བ་དང་།",
    "དེ་དང་རང་ཉིད་བཤེས་པར་མི་བྱ་ཞིང་།",
    "སློབ་དཔོན་གྱི་ཐུགས་ལ་འདི་ཡིས་ཐེ་ཚོམ་ཆོད་པར་འདུག་དགོངས་ནས་ཕྱག་བཙལ་ཏེ་གསོལ་བ་བཏབ་པ་དང་།",
    "དེ་གང་ན་འདུག་ཀྱང་ཐེ་ལེ་ལེ།",
    "ཚེ་ཚད་ནི་དེ་ལྟ་བུར་འདུག་སྙམ་དུ་ཆུ་བུར་ཅན་ནས་པདྨ་ལྟར་ཆེར་གས་པའི་བར་རིམ་བཞིན་བསམ།",
    "སྐྱེས་ན་དེ་འདྲའི་སྡུག་བསྔལ་ལ་བཟོད་ཐབས་དང་ཐར་དུས་མི་འདུག་པས་ཅི་ནས་ཀྱང་དེར་མི་སྐྱེ་བ་ཞིག་བྱེད་དགོས།",
    "ཚེ་ཚད་ནི་དེ་ལྟ་བུར་འདུག་སྙམ་སྟེ།",
    "ཁྲག་ཆུ་འབབས་པར་བྱེད་པའི་སྡུག་བསྔལ་མྱོང་བཞིན་རི་རྩེར་སླེབས་པ་ན་ཆགས་ཡུལ་དུ་གྱུར་པ་དེ་དག་ནི་ཡོད་པ་ལྟ་ཅི་བྱུང་བའི་ཤུལ་ཙམ་ཡང་མི་འདུག་པས་ཡི་མུག་ཅིང་ག་ཆད་ལ་ཅི་བྱ་ཟད་པ་ན་ཡང་བྱ་འདམ་ཟན་ཞེས་བྱ་བ་གཤོག་པ་དཔག་ཚད་བཅུ་དྲུག་ཙམ་ཡོད་པ།",
    "རྩ་བར་སླེབས་ཙ་ན་ཆགས་ཡུལ་གྲོགས་སོགས་ནི་རྗེས་ཙམ་ཡང་མེད།",
    "དེ་ནས་སྡུག་བསྔལ་དེ་དག་སེམས་ཐོག་ཏུ་བླངས་པ་ཙམ་ལ་སྡུག་བསྔལ་དང་འཇིགས་སྒྲིག་དེ་ཙམ་འདུག་ན།",
    "ལུས་ཀྱི་ཕྱི་ནང་ཐམས་ཅད་མེ་འབར་བའི་སྡུག་བསྔལ་མྱོང་བ་ཞིག་འདུག།",
    "དེ་ནས་ཚུར་ཙམ་གྱི་བར་སྣང་ལ་མིའི་རྣམ་པ་ལུས་བོངས་ཆེ་བ་ཞིག་ལ་འབྲས་བུ་རིའི་གཏོས་ཙམ་ཐུར་དུ་འཕྱང་བ་ལུས་དང་འབྲས་བུའི་བར་ཤའི་ཐག་པ་རྟ་རྔ་ཙམ་གྱིས་སྦྲེལ་ནས་སྡུག་བསྔལ་བསམ་གྱིས་མི་ཁྱབ་པ་མྱོང་བ་ཞིག་འདུག་པ་ནི་རྟ་བོང་སོགས་ཕྱུགས་བྱ་གཅོད་པའི་རྣམ་པར་སྨིན་པ་དེ་ལྟར་མྱོང་བ་སྟེ་གསུམ།",
    "གླ་རྣམས་དུས་ལ་མ་བླངས་པར་ལན་ཅིག་རྩིས་བྱས་པས་མང་པོ་བྱུང་འདུག་པ་ཐམས་ཅད་ཁོང་ལ་ཕུལ།",
    "ཚང་བྲང་དང་རྩིབ་ཤ་འདར་ཅུམ་མེ་བའི་སྟེང་དུ་བཞག་ནས་དྲངས་ཙ་ན།",
    "བཞེས་ཟིན་ཙ་ན་ཞལ་སྣུམ་ཆིལ་ལེ།",
    "སྔར་གྱི་དེ་མ་ཡིན་པའི་རྒྱ་དམར་ཙིག་གེ་བ་ཞིག་བྱས་ཏེ་དབུ་བཏེག་འོང་བར་འདུག་སྟེ།",
    "ཚེ་འདིར་གསོལ་གསོལ་བའི་བུ་ལོན་ཕྱི་མ་སྐུ་ལུས་ཀྱི་སྟེང་ནས་འཇལ་དགོས་བྱུང་ཙ་ན།",
    "ཉི་ཚེ་བའི་དམྱལ་གནས་སུ་འོ་བརྒྱལ་ཆེན་པོ་ཡོད་པར་འདུག།",
    "སྟོང་དུམ་གཤགས་པའི་ནང་ན་སྤྲུལ་པ་ཆེན་པོ་ཞིག་ལ་སྲོག་ཆགས་མང་པོས་ཟ་གྱིན་འདུག་པ་དེ་ལ་ཁྲུས་དང་བྱང་ཆོག་ཅིག་མཛད།",
    "སའམ་དཀར་གོང་ལྟ་བུའི་ཕུང་པོར་གྱུར་ནས་ཟན་ལ་སོགས་པ་བྱུང་བའི་ཤུལ་ཙམ་ཡང་མི་འདུག་པས།",
    "ཡི་དྭགས་མང་པོ་རུབ་རྒྱབ་པའི་ཁྲོད་དུ་ཁོ་རང་འདུག།",
    "ཁོ་རང་སྣབས་ལུད་ལ་རྩོད་པ་ནས་ཡི་དྭགས་གཞན་གྱིས་ལུས་ལ་རྨ་མང་པོ་བཏོད་འདུག་གསུངས།",
    "ཡང་བ་རི་ལོ་ཙཱ་བ་རྒྱ་གར་ནས་བོད་ལ་འབྱོན་ཁར་བས་མཐའ་ཞིག་ཏུ་སྐྱོ་བསངས་ལ་བྱོན་པས་ཡི་དྭགས་མང་པོ་ངུ་ཡི་འདུག་པས།",
    "ཁྱེད་བཞུགས་ན་ངེད་རྣམས་ལ་གཏོར་མ་མང་པོ་སྦྱིན་པས་མི་བཀྲེས་པར་འདུག་པ་ལ།",
    "འདི་མ་བྱས་ཀྱི་ས་མཚམས་མེད་པ་བྱས་ཡོད་པས་ངེས་པར་སྐྱེ་བར་འདུག།",
    "འགྲོ་མ་ནུས་ཙ་ན།",
    "ཚེ་ཚད་ནི་དེ་ལྟ་བུར་འདུག།",
    "ལུས་ལ་ན་ཚ་བྱུང་བ་སོགས་ལ་སྡུག་བསྔལ་ཅི་འདྲ་འདུག།",
    "འགྱུར་བའི་སྡུག་བསྔལ་བསམ་ཙ་ན།",
    "གྲྭ་བུ་སློབ་གཡོག་འཁོར་འབངས་སོགས་མི་མང་པོ་ཡོད་པ་རྣམས་ཀྱང་རང་གཅིག་པུར་འགྲོ་བ་དང་།",
    "མི་ཕྱུག་པོ་སྤྲང་པོར་འགྲོ་ཡིན་འདུག།",
    "ཁ་དྲག་པོ་ཞན་པོར་འགྲོ་ཡིན་འདུག།",
    "མི་མང་པོ་གཅིག་ཏུ་འགྲོ་ཡིན་འདུག།",
    "རབ་ཏུ་དོག་པ་མུན་ནག་འཐིབ་པོར་འདུག་པ་ཡི།",
    "སྤྱི་བོར་མར་བྱུག་དུས་བཀྱིགས་ནས་དོང་དུ་འཕང་བ་ལྟ་བུ་ལ་སོགས་པའི་སྡུག་བསྔལ་དེ་ནས་ཙོག་པུར་བསྙལ་ཏེ་འཇོག་པའི་དུས་སུ།",
    "མི་སྡིག་ཅན་འཆི་བ་མཐོང་ཙ་ན།"
  ]
}