    "ལོ་ཆེན་བེ་རོ་ཙ་ན་སོགས་མཁས་གྲུབ་ལོ་པཎ་རྣམས་ཀྱིས་མཁྱེན་བརྩེ་ནུས་གསུམ་གྱི་སྒོ་ནས་བོད་ཡུལ་དཀར་པོར་མཛད་པས་བཀའ་དྲིན་ཆེ།",
    "ཀུན་རྫོབ་ཐ་སྙད་དུ་དེས་ན་མཆོག་སྣང་བའི་ཚུལ་ལ་ངེས་པ་རྙེད་པའི་སྒོ་ནས་བསྔོ་དགོས་པར་གདའ་བས།",
    "རང་རང་སེམས་ཀྱི་དོ་རར་མངོན་འདོད་ཀྱི།",
    "ཀུན་བཟོད་མངལ་དུ་གབ་ཀྱང་རང་བཞིན་ཉིད།",
    "ལུས་མེད་ལུས་ནི་རྩྭ་བཞིན་བསྲེགས་ཀྱང་རང་བཞིན་འགྱུར་མེད་བསིལ་བའི་ཟེར།",
    "གནས་དེར་ཞིང་བཏབ་མི་ཆོག་དེའི་མི་རྣམས་འབངས་སུ་བྱས་མི་ཆོག་ཟེར་གྱིན་འདུག་ནའང་།",
    "དཀྱིལ་ཁང་དུ་བདེན་པ་ལྷག་པར་རྟོགས་པའི་ལྷ་ཁང་བཞེངས་འདུག་ངེད་ཀྱིས་༧འཕགས་མའི་དོན་དུ་བཀྲ་ཤིས་པར་གསོལ་བ་བཏབ་པའི་ཆེད་དུ།",
    "མཆོད་རྟེན་ནི་ཐུགས་ཀྱི་རྟེན་ཞེས་མངོན་སུམ་གྱི་ཡུལ་ལ་བརྟེན་པའི་ཐ་སྙད་དུ་རྟོག་གེས་བཏགས་པར་འདུག་རིགས་ལ་གཞོལ་བའི་སྐྱེ་བོ་ཐམས་ཅད་སེམས་སུ་འདུས་པར་འདུག་འཇིག་རྟེན་གྱི་ངག་སྒྲོས་ལ།",
    "སྡོང་པོ་འདི་ཡི་ཚིགས་བཅད་གཏན་ནས་མ་བརྩམས་པར་གདའ།",
    "དེའི་རྟགས་ལ་དཔག་བསམ་ལྗོན་ཤིང་རང་བྱོན་ཡོད།",
    "ཀུན་ལ་རང་རང་འཚམས་པའི་སྐུ་བསྟན་ཏེ།",
    "རང་རང་སྐད་ཀྱིས་ཚིམ་པར་མཛད་པ་འདིས།",
    "མཆེ་གཙིགས་ལྗགས་འདྲིལ་རུས་བརྒྱན་མགོ་འཕྲེང་འཕྱང་ལ་ལིངྒ་གྱེན་བགྲེང་ཕྱག་གཡས་ཐོད་དབྱུག་དུས་ཀྱི་ཞགས་པ་གཡོན།",
    "བསྒྱུར་མཁས་སྔོན་མེད་མགྲིན་མཛེས་གཅིག་ཀྱང་འདུག།",
    "རྫོགས་པར་འགྲེལ་ཞིང་རང་བློའི་ཀུན་གསལ་མར།",
    "མཁས་པར་གྲགས་ཀྱང་རང་བཞིན་སྨྲ་བ་དང་།",
    "ཡིན་ཕྱིར་འཁྲུལ་དང་རང་བཟོས་མ་བསླད་པས།",
    "འཆར་བ་ཤུགས་དྲག་ཆུ་ཀླུང་རང་བཞིན་འགྱུར།",
    "སྐབས་འགར་ཕྱུགས་དང་མི་ཡི་འགྲོ་འདུག་ལ།",
    "གཉིད་དང་མ་གཉིད་ཟ་འདུག་འགྲོ་དུས་ཚུན།",
    "འགྲོ་འདུག་མང་ན་སེམས་ལ་གཟན་པ་ཡིས།",
    "འདི་མེད་གཞན་དོན་བྱས་ཀྱང་རང་དོན་དུ།",
    "ཞེས་ཟེར་ཞིང་ལུས་སྤྲུག་ཅིང་ཕན་ཚུན་དུ་བལྟ་བ་སོགས་འཕུར་འདོད་པའི་རྣམ་འགྱུར་དུ་འདུག་པ་ལ།",
    "བྱིའུ་བག་ཡོད་གཙང་སྦྲ་དང་ལྡན་པ་ཞིག་འདུག་པས།",
    "ཤིང་ཐོག་དང་འབྲུ་སོགས་སྦྱིན་རྒྱུ་ནི་མི་འདུག་པས།",
    "འདི་ཟས་སྐོམ་སོགས་འདོད་པ་མི་འདུག་པས།",
    "ཁོ་རང་ལ་ཅུང་ཟད་བསྟོད་དེ་སྨྲས་ན་དྲག་གམ་སྙམ་སྟེ་སྨྲས་པ།",
    "མ་ཐོབ་ཐོབ་ལ་ཁྱད་པར་ཅི་འདུག་སོམས།",
    "རི་ཁྲོད་འདིར་བྱིའུ་འདིའི་ཡིད་དང་མཐུན་པའི་ཟས་སྦྱིན་རྒྱུ་ཡང་དཀའ་བ་འདུག་པས།",
    "ཕལ་ཆེར་དྲིས་ལན་གྱི་ཚིག་འདི་རྣམས་ཀྱིས་སྟོན་པར་འདུག་པ་དང་།",
    "མཁས་རྣམས་རང་རང་ལས་ཀྱི་གྲ་བཙུགས་པར།",
    "རང་རང་དད་བཞིན་གསར་བཞད་རིག་ཀུན་གྱི།",
    "རང་རང་ལས་ཀྱི་ཁུར་གྱི་ལྕི་བ་ཉིད།",
    "བསྐོར་ཏེ་རང་རང་མཛེས་པ་ངོམས་པ་འདྲ།",
    "བྱེ་བྲག་དུས་ཀྱི་འཁོར་ལོའི་བློས་བསླངས་དང་།",
    "རང་རང་ཕྱོགས་གནས་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ།",
    "རང་རང་དད་པས་བསྡུས་པའི་གཟུགས་སྐུ་ནི།",
    "ཞོ་བཞི་བཅུ་ཆ་བདུན་དང་རང་བཞིན་གྱི།",
    "གང་དང་རྗེས་འབྲེལ་རིན་ཐང་འདུག་པ་ཡི།",
    "རང་རང་དད་པས་བསྡུས་པའི་གཟུགས་སྐུ་ནི།",
    "ཞོ་བཞི་བཅུ་ཆ་བདུན་དང་རང་བཞིན་གྱི།",
    "གང་དང་རྗེས་འབྲེལ་རིན་ཐང་འདུག་པ་ཡི།",
    "ཟུང་ལས་ལོ་ཆེན་བེ་རོ་ཙ་ན་ཡི།",
    "སྨིན་དྲུག་དུས་ཀྱིས་བདེ་སྟེར་ཟླ་བ་ལ།",
    "དཔལ་ལྡན་དྲག་པོ་རང་བྱུང་རང་ཤར་སྟེང་།",
    "དལ་འགྲོའི་རྒྱུན་ཡང་རང་ལུས་བསྒྲིབས་པ་བཞིན།",
    "གཙུག་ལག་ཁང་གྲུབ་རང་རང་མཚན་ཉིད་བཞིན།",
    "རང་རང་སྐལ་པའི་འབྲས་ཐོབ་གྲུབ་པའི་མཐའ།",
    "དེས་ན་རང་བློའི་ཡུལ་སྣང་རང་ཉིད་ལ།",
    "རང་རང་ཉམས་འདོད་ངན་པའི་སྤྱོད་པ་ཡང་།",
    "མཆོག་དཀར་བྲེ་ཆེན་བཅུ་ཕྲག་དུས།",
    "མ་ཡིན་རང་རང་རྫས་དང་མངའ་རིས་ཀྱིས།",
    "དེ་ནས་རྒྱལ་པོ་དེ་བློན་པོའི་ཚོགས་ཀྱིས་བསྐོར་ཏེ་འཁོར་གྱི་ནང་ན་འདུག་ཅིང་།",
    "སྐྱེས་པ་དམ་པ་རྣམས་ནི་བདག་རླག་པར་འགྱུར་བ་ལ་ཡང་མི་འཛེམ་པར་སྦྱིན་པ་བྱེད་ན་བདེ་བར་འདུག་པ་ལྟ་སུ་ཞིག་སྦྱིན་པ་མི་བྱེད།",
    "འོངས་ནསཀྱང་སྒོ་ཁང་ན་སྡོད་ཅིང་འདུག་གོ།",
    "ཐག་པ་བསྔོགས་པ་གཅིག་དང་ཐོང་བ་གཅིག་ཅིག་དེན་འདུག་པ་མཐོང་ནས་དེས་བསམས་པ།",
    "ལྕགས་གླུ་ནི་ལེན་ཅིང་འདུག་པ་མཐོང་ནས་དེའི་དྲུང་དུ་ལྕགས་ཏེ་སླུས་པ།",
    "གྲོགས་ཀྱིས་བསྐོར་བའི་ནང་ན་འདུག་གྱུར་ཅིང་།",
    "གཅིག་པུའང་གྲོགས་ཀྱི་ནང་འདུག་འདྲ།",
    "བདག་ནི་འཇིགས་པ་མེད་པར་འདུག།",
    "རིགས་དང་རང་བཞིན་དེ་ལྟར་ལགས།",
    "མི་གཡོ་བར་དེ་བཞིན་དུ་འདུག་པ་མཐོང་ནས་རབ་ཏུ་དང་ཞིང་ངོ་མཚར་ཆེར་གྱུར་ཏོ།",
    "དུགལངས་པས་བརྒྱལ་བ་བཞིན་དུ་སེམས་བློང་བློང་པོར་གྱུར་ནས་དེ་ཉིད་དུ་འདུག་གོ།",
    "དེ་ལ་མི་ཚུགས་ལྟ་ཞིང་བྲིས་བཞིན་འདུག།",
    "བགོ་སྐལ་གྱི་རིམ་པས་ཐོབ་པའི་ས་སྐྱོང་ཞིང་འདུག་གོ་ཞེས་གྲག་གོ།",
    "ལྷའི་གོས་དཀར་པོ་ཅན་གྱི་སྟེང་དུ་འདུག་ནས།",
    "ང་ནི་འདི་ན་འདུག་བཞིན་དུ།",
    "ཆུ་ཀུན་ཐ་མལ་འདུག་ལས་རབ་ཏུ་གཡོས།",
    "རྒྱར་ཚོའི་ནང་དུ་འདུག་པའི་གྲུ་མཛེས་པ།",
    "བཅོད་རྒྱུ་འདི་ནི་བུམ་པ་འདི་ན་འདུག།",
    "མེ་ཏོག་སྣ་ཚོགས་ཀྱི་ཕྱེམས་རབས་ཁེབས་པའི་ས་གཞི་གཙང་མ་ཞིག་ཏུབསམ་གཏན་གྱི་ཆོ་ག་བྱས་ནས་ཕྱི་དྲོའི་དུས་སུ་ཏིང་ངེ་འཛིན་ལས་ལངས་ཏེ་ཕྱག་དར་ཁྲོད་ཀྱི་ཚེམ་བུ་འདྲུབ་ཅིང་འདུག་གོ།",
    "བྱང་ཆུ་བསེམས་དཔའ་ལ་དགའ་བའི་གཏམ་བྱས་ནས་དེ་དང་དེ་ཉི་བའི་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "དེ་བཞིན་དུ་སེམས་འཁྲུག་པ་མེད་ཅིང་རབ་ཏུ་ཞི་བར་ཕྱག་དར་ཁྲོད་ཀྱི་ཚམ་བུ་འདྲུབ་ཅིང་འདུག་གོ།",
    "མཐུ་མེད་ཞུམ་ནས་རབ་ཏུ་ཞི་བར་འདུག།",
    "མིའི་བདག་པོ་ནི་སེང་གེའི་ཁྲལ་འདུག་པར་འོངས་སོ།",
    "དེ་ངོ་ཚ་བར་གྱུརནས་ཅུང་ཞིག་མགོ་སྐདགེ་འདུག་གོ།",
    "མཁས་པ་དག་ཀྱང་རང་དགར་ཅི་བདེར་སྤྱོད་པའི་རིགས།",
    "འདི་ལྟ་བུའི་འབྲོག་དགོན་གཅན་གཟན་ཁྲོ་བོ་རྣམས་རྒྱུབ་རྟ་བཞག་སྟེ་ངལ་བསོ་ཞིང་འདུག་པའི་གནས་ཀྱང་མེད།",
    "ནགས་ཚལ་སྟུག་པོ་སྐྱ་བོ་མེད་བསན་ཉམས་དགའ་བར་འདུག་གོ།",
    "རི་དགས་མང་པོ་རྗེས་སུ་འབྲང་བ་རྣམས་ལ་ཡང་སློབ་དཔོན་དང་བ་བཞིན་དུ་སླེབ་པ་རི་དགས་རྣམས་ཀྱི་བདག་པོ་བྱེད་ཅིང་འདུག་གོ།",
    "སེང་གེའི་ཁྲིའི་ཁ་ན་འདུག་ཅིར་རྒྱལ་པོ་དང་བཅས་པའི་འཁོར་གྱིས་ཡོངས་སུ་བསྐོར་ཏེ།",
    "དེ་ནས་མི་དེས་རི་དྭགས་རུ་རུ་དེ་བག་ཕབ་ཅིང་འདུག་པམཐོང་ནས་རྒྱལ་པོལ་བསྟན་པ།",
    "མངལ་ན་འདུག་པའི་སྔོན་རོལ་བློ་དེ་ནི།",
    "དེདེན་འདུག་པའི་དྲུང་དུ་བྲམ་ཟེ་ལེགས་བར་སྒྲུབ་ལ་མཁས་པ་ཞིག་འོངས་ཏེ་ཞེ་ས་དང་ཕྱག་བྱས་ནས།",
    "དེའི་བྱད་གཟུགས་བཟང་པོ་ཕུན་སུམཚོགས་བལ་ཆགས་ནས་མིག་དགྲད་དེ་ཞིང་ངལ་བསོ་ཞིང་འདུག་གོ།",
    "སེམས་དཔའི་མདུན་དུའདུག་སྟེ།",
    "རྒྱན་བཟང་པོ་དགའ་དགའ་ལྟར་འདུག་པ་ལ་ལྟར་འགྲོ་བསཕས་ཀྱང་གནང་སྟེ།",
    "ནགས་དང་ཁྱིམ་ན་འདུག་ཀྱང་འཆི་བདག་འོང་འགྱུར་ལ།",
    "བར་ལ་ནི་དེ་བཀྲེས་ཏེ་ཟར་འགྲོ་བའི་ལམ་བཀག་སྟེ་འདུག་གོ།",
    "མཆེ་བའི་བརན་འདུག་པའི་ཤ་ཡང་འཕྲོག་ནུསན།",
    "གཞན་གྱི་སྨག་བསྔལ་ཡལ་བར་འདོར་བ་ནི་ཐམལ་བར་ནི་འདུག་པ་ཉིད་དོ།",
    "གལ་ཏེ་ཐམལ་པར་བདག་འདུག་ནའོ།",
    "དོགས་མེད་མི་གཡོཞེས་བྱ་བ་འདིའི་བསྡུས་པའི་དོན་ནི་གང་འདུག་པ་དང་།",
    "ཇི་ལྟར་འདུག་པ་དང་།",
    "ཅིའི་ཕྱིར་འདུག་པ་སྟེ།",
    "ཇི་ལྟར་གླགསམི་ལྟ་བར་འདུག་ཅེ་ན།",
    "མགྲོནལ་བསྙིན་བཀུར་བྱེད་པ་ཅིའི་ཕྱིར་ནུས་པམད་ཙ་ན།",
    "མི་གཡོ་བར་དེ་བཞིན་འདུག་པ་ཞེས་བྱབ་ནི་ལུས་ཀྱི་ཚོ་ར་བལ་སོགས་པས་སོ།",
    "རྨད་དུ་བྱད་བཞི་མི་གཡོ་བར་དེ་བཞིན་འདུག་པ་སྟེ།",
    "ཡང་ན་འདུག་པ་ཡིན་པས་གནས་པ་སྟེ།",
    "ལོ་མ་རྣམས་ཀྱིས་བརྒྱན་པའི་ཤིང་ལོན་པ་སྣམ་སཱམ་ལྟར་འདུག་པ་རྣམ་པ་དུ་མའོ།",
    "དེ་ལམིག་ཚུགས་ལྟ་ཞིང་བྲིས་པ་བཞིན་འདུག་ཅེས་བྱ་བ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "ཇི་ལྟར་གྱུར་པ་ཞེས་བྱ་བནི་དང་པོའི་གནས་ནཔདྨའི་རྩ་བ་ནི་མེད་པདྨའི་ལོ་མ་ནི་རྒྱན་འཁྲུགས་ཤིང་འདུག་པར་མཐོང་ཞེས་བྱ་བ་དེ་དག་བསྟན་པར་གྱུར་པའོ།",
    "བཟོད་པར་གསོལ་བ་ནི་མི་སྩ་བར་འདུག་བ་དེ་ལའོ།",
    "གནས་པའིསྐྱོན་ཞེས་བྱ་བཞི་ལྷན་ཅིག་ཏུ་འདུག་པ་ལ་སོགས་པའི་སྐྱོན་ཡིན་ཏེ།",
    "འདུག་པ་ཞེས་བྱ་བ་ནི་དེ་ལྟར་གྱུར་པས་འགྲོ་བའི་སྐབས་མེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "འབབ་ཆུའི་འགྲམ་ན་འདུག་བར་ངེས་པའི་ཕྱིར།",
    "མཚོན་ཆ་ཐོགས་ཏེ་ཞེས་བྱ་བ་ནི་ག་ང་སྔར་བསྟན་པའི་གསོལ་ཀ་བའི་ལག་ན་རལ་གྲི་འདུག་པ་བླངས་ཏེ་ཞེས་བྱ་བ་དེ་ཉིད་སྟོན་ཏོ།",
    "དེས་བརྟན་པ་འདུག་པའི་ཚུལ་ནི་བཟོད་པ་སྣབ་ཡིན་ནོ།",
    "གཞལ་མེད་ཁང་ཞེས་སོས་པས་ནི་བདག་ཉིད་ཕྱོགས་དེ་ན་འདུག་པའོ།",
    "མ་འཇུངས་ཤིང་རང་བཞིན་བཟང་བའི་ཕྱིར་ཞེས་བྱ་བ་འདིས་ནི་རྒྱུ་ཕུན་སུམ་ཚོགས་པ་བསྟན་ཏོ།",
    "ལྷ་དེ་ལས་ཅི་ལེགས་པར་མཛད་ཅིང་བཀའ་གྲོས་མཛད་པའི་དུས་ལ་བབ་པོ་ཞེས་༧ གསོལ་ཏོ་ཞེས་བྱ་བ་ད་གཞི་ག་དུས་ལ་བབ་པ་ཉིད་དུ་བསྟན་པ།",
    "ཇིལྟར་འདོད་པར་ཕྲད་ཀྱང་རང་ཞེས་བྱ་བ་ནི་དམ་པ་དག་དང་འགྲོགས་པལ་དགོངས་པ་ཡིན་ཏེ།",
    "རྩ་བ་ནས་མི་མཐོང་བ་ཁ་ཤས་འདུག་པ་དག།",
    "ཚིག་འབྲུ་མི་གསལ་བ་མི་ཉུང་བ་ཙམ་ཞིག་ཀྱང་རང་འགྲེལ་སོགས་རིགས་གཏེར་གྱི་འགྲེལ་པ་མང་པོ་ཞིག་ལ་གཏུགས་ནས་ཞུས་ཡོད།",
    "ལྡོག་པ་ཐ་དད་ལ་ལྟོས་ནས་རྗེས་དཔག་དང་རང་རིག་མངོན་སུམ་ངོ་བོ་གཅིག་པར་ཡང་འདོད་དོ།",
    "དེས་ན་སྐུ་སོགས་གཅིག་ཉིད་ཀྱང་རང་གཉིས་པ་ནི་དངོས་མེད་ཤེས་བྱར་འཛིན་པས་སྤྱི་ཡིན་ན་ཟླ་གཉིས་ལ་མཚན་དང་སྤྱི་མཚན་གཉིས་སུ་མི་འགལ་བ་ཡིན་ཏེ་མི་རྟག་པ་དངརང་མཚན་ནི་སོགས་པའང་སྤྱིར་འགྱུར་རོ་ཞེ་ན།",
    "འདུ་བྱེད་ཀྱི་བུམ་པ་དང་རང་མཚན་གྱི་ཞེ་ན།",
    "རྨི་ལམ་གྱི་སྔོ་སོགས་ཀྱང་རང་ཁོ་ནས་ཤེས་པ་ཡིན་ནོ།",
    "དོན་རང་མཚན་དང་འབྲེལ་བའི་མིང་སོགས་བརྗོད་བྱ་ཡིན་པས་མིང་ཀྱང་རང་ཉིད་ཁོ་ནས་ཤེས་པའི་ཕྱིར་རོ།",
    "ཞེས་པ་སྟེ་བར་ན་འདུག་པས་གཞན་དུ་བརྗོད་པར་བྱ་མིན་ཞེས་པའི་དོན་ནི་བུམ་གསུམ་པ་ལ་གཉིས་ལས།",
    "མ་མཐོང་བའི་ཚེ་སྤྱི་གཅིག་ཏུ་འཛིན་པའི་བློ་མི་སྐྱེ་ལ་དཀར་ཟལ་དང་ནག་རྒུར་ངེས་པ་མིན་ཏེ་འཇིག་པ་ནི་དངོས་པོ་ཡོད་ཙམ་དང་རང་ཆས་སུ་འབྲེལ་བ་ཡིན་གཉིས་མཐོང་པའི་ཚེ་བརྡ་དྲན་པ་ལ་ལྟོས་པ་མེད་པར་ཡང་ཐ་དད་མེད་རྗེས་སུ་པའི་ཕྱིར་མེའི་ཚ་བ་བཞིན་ནོ།",
    "དོར་བྱ་བའི་དོན་དུ་དཔྱོད་པ་ཡིན་ལ་ཕན་གནོད་ཀྱི་དོན་ཡང་རང་མཚན་དེ་ཁོ་ན་དེ་དངོས་མེད་དུ་ངེས་ན་རྟོག་ལྡན་སུ་ཞིག་དཔྱོད་དེ་འདོད་ལྡན་མ་ནིང་ལ་མེས་པོའི་ཤུལ་བཞག་ལས།",
    "གསུམ་པ་ནི་རྒྱུ་དང་ཁྱབ་པར་བྱེད་པ་དང་རང་བཞིན་མ་དམིགས་པ་སྟེ་བཞི་པ་ལྡོག་པ་དངོས་པོ་ལ་གནས་པར་བསྟན་པ་ལ་གསུམ་སྟེ།",
    "རྟོག་པ་འང་རང་རིག་ཉིད་དུ་འདོད།",
    "དམིགས་པ་ཐམས་ཅད་འཁྲུལ་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "གཟུང་འཛིན་ཕན་ཚུན་ལྟོས་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པ་དང་།",
    "ཡིན་ནོ་ཞེས་བྱ་བ་དེ་རྒྱུ་གང་ལས་ཡིན་ཏེ་གསལ་བ་དང་མི་གསལ་བར་སྣང་བ་དེ་གཉིས་པ་ཕྱིའི་དོན་ཁས་བླངས་ཀྱང་རང་བཞིན་མེད་པར་གྲུབ་པ་ནི།",
    "བདེ་སོགས་དང་རང་རིག་གཉིས་སྐད་ཅིག་གཉིས་པར་མི་སྡོད་པའི་ཕྱིར་དང་།",
    "རང་རིག་རྟོག་བདེ་སོགས་དང་རང་རིག་ལ་ཐ་དད་དུ་སྣང་བ་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "ཀུན་ལས་བཏུས་ལས་རྟོག་པའང་རང་རིག་ཉིད་མེས་པོའི་ཤུལ་བཞག་ལས།",
    "དེས་རིགས་སོགས་པའི་རང་བཞིན་ནི་བདེ་སོགས་དང་རང་བཞིན་གཅིག་ཡིན་ཏེ་སྔོན་པོ་ལ་ཅན་གཞན་པ་ཁེགས་པར་བསྟན་པའོ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་དོན་དེའོ།",
    "ལ་མི་ལྟོས་ན་རྣམ་རིག་ཙམ་ལ་ཡུལ་དང་དུས་དང་རང་བཞིན་ངེས་པ་མི་འཐད་དོ་འོ་ན་རྩོད་པའི་ལན་གྱི་ཐ་མ་དོན་རྟོགས་ཐ་དད་དུ་བྱེད་པའི་བློའི་རྣམ་པ་གང་ཡིན་ཞེ་ན།",
    "འདི་ལྟར་ཁྱེད་རང་རྡུལ་ཕྲན་དུ་མ་ལ་ཡན་ལག་ཅན་གཅིག་མེད་པར་འདོད་པའི་ཕྱིར་དང་སྙད་འཇུག་པ་ཡིན་གྱི་དངོས་པོ་ལ་མ་ཡིན་ཏེ་རྒྱུ་འབྲས་གཉིས་དུས་མི་མཉམ་པས་ཡོད་པར་འདོད་ཀྱང་རིགས་པས་མི་འཐད་པའི་ཕྱིར་རོ།",
    "རིགས་པའི་སྒོ་ནས་ནི་བློ་གཅིག་ཡིན་ལ་བརྟགས་པའི་སྒོ་ནས་བླངས་ཀྱང་རང་རིག་འབྲས་བུར་འདོད་དགོས་པ་ནི།",
    "མ་ཡིན་ཏེ་ཕྱི་རོལ་བར་འགྱུར་བ་ཡིན་ཞེས་པ་ལས་ཀྱིས་བསྒྲིབས་པའི་བློ་དེས་དོན་གྱི་བདག་ཉིད་མ་ཞེས་པ་དོན་ཡོད་ཀྱང་རང་རིག་འབྲས་བུར་རིགས་ཏེ་ཇི་ལྟར་ཉམས་སུ་མྱོང་བ་བློ་རྟོགས་པར་འགྱུར་ཞེས་པའོ།",
    "འདི་ལྟར་དོན་གྱི་བདག་ཉིད་ནི་བློ་ལ་དངོས་སུ་སྣང་བ་མི་བའི་ལུགས་ལའང་རང་ཉིད་མྱོང་བ་འབྲས་བུ་ཡིན་གྱི་དོན་ཡོད་དོ་ཞེས་ངེས་པར་སྲིད་བའི་ཕྱིར་དང་རྣམ་པ་ནི་ཤེས་པ་ཡིན་པའི་ཕྱིར་དང་།",
    "མ་ཡིན་ལ་ཤེས་པའི་བདག་ཉིད་གཞལ་བྱ་ཡིན་ཅིང་རང་རིག་ཅེས་པ་འབྲས་བུ་མེས་པོའི་ཤུལ་བཞག་ལས།",
    "རང་རིག་ལ་མི་མཐུན་པ་ལྷན་ཅིག་བྱེད་པས་ཕན་འདོགས་པ་ལ་ལྟོས་པའི་ཕྱིར་རྟག་པའི་དེའི་འབྲས་བུ་བློ་ཡོད་དེ་འགའ་ཞིག་མྱོང་བ་ཙམ་ཡོད་ཀྱང་རང་རིག་མེད་པར་འདོད་པའི་ཕྱིར་རོ།",
    "གཞན་གྱིས་རྟོགས་མིན་བཞི་པ་ནི་ཤེས་པ་ལ་ཡུལ་གྱི་རྣམ་པའི་སྒོ་ནས་ཐ་དད་དུ་དབྱེར་མེད་ཀྱང་རང་བཞིན་ནི།",
    "བློ་སྔ་མ་ཕྱི་མས་མྱོང་བ་ལ་སོགས་པས་ཀྱང་རང་རིག་པ་གྲུབ་པ་ཡིན་ནོ།",
    "འོ་ན་གང་ཟག་གཞན་གྱིས་མཐོང་བར་འགྱུར་པའི་དོན་གལ་ཏེ་དོན་སྐྱེ་འཇིག་མེད་པའི་རྟགས་མ་གྲུབ་སྟེ་སྔར་དོན་དེ་མི་གསལ་བའི་རང་བུམ་པ་ལ་སོགས་པས་ཀྱང་རང་གཞན་གྱི་བློ་རྗེས་སུ་དཔག་ནུས་པར་འགྱུར་ཏེ་བཞིན་དུ་ཡོད་པ་དེ་ལོག་ནས་ཕྱིས་གསལ་བའི་རང་བཞིན་དུ་སྐྱེ་བ་དེ་འདོད་ཅེ་ན།",
    "དེས་ན་གཞན་གྱིས་མཐོང་བའི་དོན་ལས་ཀྱང་རང་དང་ཕྱིར་བློ་དེས་དོན་གསལ་བ་དེ་ཤེས་སོ་ཞེས་བྱ་བ་དེ་གང་ལས་ཏེ་མ་གྲུབ་པར་གཞན་གྱི་བློ་རྟོགས་པར་གྱུར་ཏེ།",
    "ལས་ཀྱང་རང་རིག་འགྲུབ་པ་ཡིན་ཏེ་རང་རིག་པ་དེ་དྲན་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་རོ།",
    "བློ་སྔ་མ་ལ་ཡང་བློ་ཕྱི་མ་ན་རྣལ་འབྱོར་བའི་བློ་ནི་བསྐལ་བ་གསུམ་གྱི་དོན་ལའང་འཇུག་པའི་ཕྱིར་གཟུང་རང་ལ་སྣང་བའི་ཚུལ་གྱིས་དངོས་སུ་ཕན་འདོགས་པ་དེ་ཡོད་པའི་ཕྱིར་བློ་སྔ་མ་དེ་འཛིན་གྱི་རྣམ་པར་བཞག་པ་བསམ་བར་བྱ་བ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་ཤེས་པ་རང་ཉིད་གསལ་བར་མ་སྔ་མ་ཐམས་ཅད་ཀྱང་ཉམས་སུ་མྱོང་བ་མེད་པར་འགྱུར་ཏེ་ཤེས་པ་ཐ་མ་དེ་མྱོང་བ་གྲུབ་ཀྱང་རང་ཡོད་པ་ཙམ་གྱིས་དོན་གསལ་བར་འགྱུར་ན་འགྲོ་བ་དྲུག་པོ་འདི་མེད་བའི་ཕྱིར་རོ།",
    "རྒྱས་པའི་སྒྲ་མི་རྟག་པ་ཉིད་ལ་སོགས་པའི་དམ་བཅའ་ཡང་རང་ལ་རྣལ་འབྱོར་དེ་ལས་གཞན་གཅིག་ཡོད་ན་འདིར་བརྗོད་པར་རིགས་ཏེ་དོན་མེད་པའི་བློ་གྲོས་མངོན་སུམ་གྱིས་གྲུབ་ནས་གཞན་ལ་སྒྲ་ལ་སོགས་པའི་སྒོ་ནས་སྟོན་པ་ཡིན་ནོ་ངལ་བ་ནི་རྟོགས་ལྡན་གྱི་བྱ་བ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "འོ་ན་ཐག་རིང་ན་འདུག་པས་ཀྱང་ཐོས་པ་དང་འགལ་ཞེ་ན།",
    "གཟུགས་ཀྱང་ནམ་མཁའི་ཡོན་ཏན་དུ་འགྱུར་ཏེ་ཐག་རིང་ན་འདུག་པས་ཀྱང་བསྟན་བཅོས་མང་པོ་ཡོད་པ་ལ་རྒོལ་བས་སྔར་འདོད་པ་ཙམ་གྱིས་མཐོང་བའི་ཕྱིར་རོ།",
    "དེ་ལའང་རང་ཉིད་ཀྱི་སྒྲ་དོན་མེད་པ་ཡིན་ནོ།",
    "ཀུན་ལས་བཏུས་པར་ཁས་བླངས་དང་རང་ཚིགས་གཉིས་གཅིག་ཚིགས་ནི་ཐེ་ཚོམ་ལ་བརྗོད་ཕྱིར་ཞེས་སྒྲུབ་བྱེད་དང་གནོད་བྱེད་མེད་པའི་དོན་ལ་ཏུ་བསྡུས་པའི་དོན་ངེས་པར་བྱ་བ་དང་།",
    "ཡང་ན་བུམ་དངོས་པོ་སྟོབས་ཞུགས་ཡིན་པ་དགག་པ་དང་རང་ལ་མཚུངས་པ་སྤང་བའོ།",
    "ལྟར་རང་བཞིན་གྱིས་མཐུན་ཕྱོགས་ཐམས་ཅད་ལ་ཁྱབ་པ་ཡིན་ཏེ་རང་བཞིན་དང་རང་བཞིན་ཅན་ཁྱབ་མཉམ་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་རྩོལ་བྱུང་རང་བཞིན་གྱི་རྟགས་རྐྱེན་སྒྲུབ་པར་བྱེད་པའི་ཕྱིར་རོ་ཞེ་ན་མ་ཡིན་ཏེ་འགལ་རྐྱེན་དེ་སྒྲིབ་བྱེད་ལ་རྩལ་ཡིན་པར་ནི་རྒོལ་བ་ཀུན་ལ་མཐུན་ལ་འབྲས་བུའི་རྟགས་ཡིན་པར་ནི་ད་ལྟ་ཉིད་དུ་བ་དེ།",
    "སོགས་མཐུན་ཕྱོགས་ལ་ཡོད་མེད་དཔྱོད་པའི་སྐབས་འདིར་ནི་བདག་ཉིད་མི་སྨྲ་འདོད་པར་མི་ནུས་ཏེ་དགག་གཞི་མཐུན་ཕྱོགས་གཏན་མེད་པའི་དངོས་མེད་ལ་བར་ཁ་རོག་འདུག་པ་ཉིད་འཐོབ་སྟེ་སྲོག་སོགས་བདག་དང་བཅས་པ་ལ་ཡོད་དགག་བྱ་རྟགས་ལྡོག་པ་མེད་དོ་ཞེས་འགོག་པ་མཐོང་བའི་ཕྱིར་རོ།",
    "བདག་དུ་ཡུལ་དུས་དང་རང་བཞིན་ངེས་པ་མི་འཐད་པའི་ཕྱིར་རོ།",
    "ཀྱང་རང་བཞིན་ཐ་དད་དུ་གྲུབ་པ་ཙམ་གྱིས་འགལ་བ་ཡིན་ནོ་ཞེས་པ་ནི།",
    "དྲི་མེད་མཚོ་གླིང་པདྨའི་སྦུབས་ལྷུང་རང་བྱུང་མཚན་དཔེས་སྤྲས།",
    "དེ་འོག་ནས་བདག་ཅག་སྐྱེས་འདུག་ལགས་ཤིང་།",
    "སྐྱེས་ནས་མིང་རྡོ་རྗེ་ཕུན་ཚོགས་ཟེར་བ་བཏགས་ཡོད་འདུག་ཅིང་།",
    "དེང་སང་རྒན་པོ་རྣམས་ཀྱིས་ཀྱང་འདི་ཁོ་ཆུང་དུས་ཀྱི་ཁྲི་ཡིན་ཟེར་སྐད་འདུག།",
    "ངན་སྤྱོད་སྣ་ཚོགས་པའི་སྤྱོད་པའང་མང་པོ་བྱེད་པ་ཞིག་ཡོད་འདུག་ལགས་ཤིང་།",
    "འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན་ལྷ་ལྔ།",
    "དཀར་ཤཱཀྱ་གྲགས་སོགས་ཀྱིས་བསྒྲིགས་པ་ཅུང་ཟད་མི་འདྲ་ཙམ་དུ་མ་འདུག་ཀྱང་།",
    "ས་དེ་མ་ཡིན་པའི་དགོན་གཤམ་ཀྱི་གཡུལ་ཁ་ན་སྒར་དེ་འདུག།",
    "སྐུ་སིལ་བུ་ལྟག་པར་ལྕང་ལོ་བྱས་ཤིང་མུ་ཏིག་མང་པོས་མགོ་ལུས་ཐམས་ཅད་བརྒྱན་པ་ཞིག་འདུག།",
    "མདའ་དར་ཆེ་བ་ཞིག་ཀྱང་འདུག།",
    "སླར་ཡང་རང་ལོ་བཅུ་དགུའི་དུས་སུ་ལེགས་སྦྱར་སཾ་སྐྲ་ཏའི་སྐད་དུ་བི་ཀཱ་རི།",
    "སྟོད་སྨད་ཀུན་གྱི་སྦྱིན་བདག་རྣམས་ནས་བྱུང་བའི་དཀོར་ཆེན་འདི་བཟའ་སྐལ་གྱིས་ཐོས་བསམ་ལ་སྦྱངས་སྟོབས་ཀྱི་སྤྲོས་པ་དང་བྲལ་བ་འདི་ཡོང་རྒྱུ་ཡིན་ཚོད་འདུག།",
    "ད་དུང་དེ་ལྷག་ཅིག་འདུག་བསམས་ཀྱང་བཟླས་པའི་སྐབས་སུ་གཞན་རྟགས་ནི་བཟང་ངན་གང་ཡང་མ་བྱུང་རུང་།",
    "མཆུ་ཤིན་ཏུ་ཆེ་བས་སྔགས་འདྲེན་མི་ཐུབ་པ་ཞིག་འདུག་པས།",
    "ཉེ་རིགས་རྣམས་ཀྱིས་ཀྱང་རང་རང་སེམས་ཐོན་གྱི་གྲོ་གསོས་བསྐུར་བྱུང་བར་རིམ་གྱིས་དེ་ཉིན་གཞིས་རྩེ་དགྲ་འདུལ་སྒང་དུ་ཁམས་པ་བསྟན་པ་དར་རྒྱས་དང་ཀླུ་འཕེལ་གྱི་ཁྱིམ་དུ་བསྡད།",
    "བྱམས་པའི་ལྷ་ཁང་ཞིག་འདུག་པ་མཇལ།",
    "མི་ཉག་ནས་བོན་པོ་རབ་འབྱམས་བཟང་བ་ཞིག་འདུག་པར་གནས་གཡར་བྱས།",
    "དགོན་དེ་ན་ཚོགས་པ་ཐམས་ཅད་ཆུ་ལེན་ཕེབས་པར་དབུ་ཞྭ་ཕྲག་པར་བཀལ་ནས་ཕེབས་འགྲོ་འདུག་པས་ཅི་ལགས་ཞུས་པས།",
    "བླ་བྲང་དེས་ཞབས་ཏོག་གཟབས་ཤིང་ཐམས་ཅད་ཀྱིས་ཡར་ལམ་ཤོག་ཅེས་ནན་གྱིས་གསུང་འདུག།",
    "མང་ཇ་ཞིག་བསྐོལ་ཏེ་གནས་མཇལ་ཞིབ་པར་བྱས་པས་རྡོ་ལ་རང་བྱོན་མང་པོ་འདུག།",
    "ཕྱིའི་ཁྱམས་ཀྱི་པེ་ཧར་དང་ཙིའུ་དམར་གྱི་རྟེན་གཞན་ཡང་འཇིག་རྟེན་དྲེགས་པ་ཁ་ཤས་ཀྱིས་བསྐོར་བ་འདུག་པར་ཕྲིན་ལས་དྲག་ཏུ་བཅོལ།",
    "དེར་འདུག་པའི་ཚེ་རྩུབ་འགྱུར་ནི་ཅི་ཡང་མ་བྱུང་།",
    "དེ་སྐབས་ཇོང་གར་གྱིས་ཉམས་ཆག་བྱུང་བར་གྲྭ་ཚང་རྣམས་ཀྱིས་གཙུག་ལག་ཁང་སོགས་ཉམས་གསོའི་འགོ་ཚུགས་སྐབས་སུ་འདུག་ཅིང་།",
    "དེའི་ཕུ་ན་མཆོད་རྟེན་བཀྲ་ཤིས་འོད་འབར་བྱ་བ་ཞིག་འདུག་པ་ནི་མཇལ་མ་ཐུབ།",
    "དེ་ནུབ་དེར་བསྡད་པས་དེ་མཚམས་ནས་རྩམ་པའང་ཟད་ཡོད་པར་ཡུལ་དེར་ཡང་ཡང་དྲིས་རུང་བལ་ཊཾ་གཅིག་ལའང་འཚོང་མཁན་མི་འདུག།",
    "ངེད་རང་རང་དོན་དུ་འོང་བར་དཀའ་རུང་འོས་ཅི་ཡོད།",
    "དེང་སང་གནམ་རྒྱན་མ་གཏོགས་མི་འདུག།",
    "ངེད་རང་རྣམས་ཀྱི་རྒྱབ་ནས་གཞན་ནི་སུ་ཡང་འོང་མི་འདུག་པས་ངེད་རང་གསུམ་ཡང་དགོད་ཤོར་བ་ཞིག་བྱུང་བས།",
    "གཙུག་ལག་ཁང་དེའི་བཀོད་པ་དང་སྒོ་བཏོད་ལུགས་ཇི་ལྟ་བ་བཞིན་དུ་ལྷ་ས་ཡང་དེ་ལས་དཔེ་བླངས་འདུག།",
    "དེའི་ཕྱི་ནས་ཀྱང་ས་འབུམ་ཆེ་བ་ཞིག་འདུག་པ་དང་།",
    "སློབ་དཔོན་གྱི་སྒྲུབ་ཕུང་ཞིག་འདུག་པ་ལ་སྟག་ཆེན་འབུམ་པ་ཟེར་འདུག།",
    "དེ་ནའང་ཁྱི་རྒོད་པོ་མང་པོ་འདུག་པ་ལེགས་པར་བཀག།",
    "དེར་འདུག་པའི་སྐབས་དེར་རྡོ་རྗེ་བྲག་པའི་འབུམ་ཞིག་འཁྱར་བ་ཕྱག་ཏུ་འབྱོར་འདུག་པ་ཚར་གཅིག་སྒྲོག་དགོས་ཀྱི་བཀའ་ཕེབས་པར་ཚར་གཅིག་བསྒྲགས།",
    "དེ་ཕྱིན་ངོར་གསར་ཞུ་སྲོལ་འདུག།",
    "དེ་སྐབས་སྦྱིན་བདག་རྣམས་ལ་མགྲོན་ཆང་ཞིག་མཛད་སྲོལ་འདུག་པར་ངེད་དཔོན་གཡོག་རྣམས་ལའང་ཞབས་ཏོག་དང་ནང་མཆོད་ཀ་པཱ་ལའི་ནང་དུ་རྒྱས་པར་བསྩལ་ཞིང་།",
    "སྤེ་རོང་དུ་མ་རྒན་གྱིས་བོས་ཏེ་དགའ་སྟོན་བཟང་ཞིང་སྐྱིད་པར་གདའ།",
    "ཨ་ཇོ་རྡོ་རྗེ་སྲི་ཐར།",
    "གལ་ཏེ་ང་ངེས་མེད་མ་འཚམས་པར་གྱུར་ཚེ་སྐུ་འདའ་ཁར་ཁྱེད་རྣམས་ཀྱིས་ཚབ་ཚུབ་མ་བྱེད་པར་རང་བབས་སུ་ཇི་ལྟར་འདུག་ཀྱང་ཞོག།",
    "ཉེ་ན་ཞག་ལྔ་རིང་ན་ཞག་བདུན་དུ་ཐུགས་དམ་འདུག་པའང་སྲིད།",
    "ཅུང་ཟད་གཡས་ཕྱོགས་སུ་འགྱིངས་ནས་སྤྱན་གཉིས་ཟིམ་བུར་མཛད་ཅིང་སྐུའི་མདངས་ནི་དུས་རྒྱུན་ལས་མི་ཞན་པར་འདུག་པ།",
    "ནམ་མཁའ་བྱང་ཆགས་པ་སོགས་འདུག་པ་ནི་ཀུན་གྱིས་མཐོང་བ་བྱུང་ངོ།",
    "སྒར་ཆེན་པོ་ཞིག་ན་ངེད་རང་ཁྲི་ཐོག་ཞིག་ལ་སླེབས་འདུག།",
    "དབུས་ན་གཙུག་ལག་ཁང་དམར་པོ་སྒོ་ལྷོ་ལ་བསྟན་ཅིང་སྣུམ་བག་ཅན་ཞིག་དང་བཅས་པའི་དགོན་ཆེ་བ་གཅིག་འདུག།"
  ]
}