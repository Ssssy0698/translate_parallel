    "གང་དུ་རང་གི་སྤྱི་དམིགས་པ་གསལ་བར་འགྱུར་བ་དང་།",
    "ངན་སོང་གི་སྐྱེ་བ་དང་བྲལ་བ་དང་།",
    "དགེ་སློང་གི་བར་གྱི་ཡོན་ཏན་དང་ལྡན་པ་དང་།",
    "དེ་ལས་ལངས་ནས་བསམ་གཏན་དང་པོའི་ཏིང་ངེ་འཛིན་སྒོམ་མོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "གང་གིས་ཅི་ལྟར་ཡོངས་སུ་རྟོག་ཅེ་ན།",
    "འདི་ལྟར་དེའི་རྟགས་ནི་གང་གིས་ཀུན་ཏུ་ཁྲོ་བ་མེད་པ་དང་།",
    "ངག་གིས་སྨྲ་བ་དྲག་པོ་མི་བྱེད་པ་དང་།",
    "ཁེ་དང་རེ་བ་མེད་པ་དང་།",
    "མི་ཕམ་མགོན་པོས་མ་ནོར་བ་ལ་ལེགས་བཀོད་རང་གི་བློས།",
    "ལྗགས་ཀྱི་རྩེར་སྟོན་ཡེ་ཤེས་སྤྱན་གྱིས་གཟིགས་ཏེ་འགྲོ་ལ་ཕན་དོན་དུ།",
    "དྲི་མ་མེད་པའི་འོད་ཟེར་སྟོང་གིས་ནི།",
    "རང་གི་སྣང་བ་ཙམ་གྱི་ངོ་བོ་རུ།",
    "གང་གིས་ཀྱང་ནི་དེ་མཐོང་གྱུར་པ་དག།",
    "དེ་ལ་ཡང་དག་རེག་པར་སྦྱོར་བ་ལས།",
    "ཉོན་མོངས་བདུད་ལ་སོགས་པས་གཡོ་མི་འགྱུར།",
    "བདག་གི་རྣལ་འབྱོར་པ་ནི་འཇུག་པ་ཙམ།",
    "དེའི་དྲིན་གྱིས་ཐོབ་པའི་ལུང་གིས་བླ་ན་མེད་པའི་ཡེ་ཤེས་ཀྱི་ཐབས་ཀྱིས་མན་ངག་གི་རྣལ་འབྱོར་བསྒོམ་བརྩམ་པར་བྱའོ།",
    "དེ་ལ་དང་པོར་རེ་ཞིག།",
    "དྲི་མ་མེད་པའི་འོད་ཟེར་སྟོང་གིས་ནི།",
    "རང་གི་རྣམ་པ་ཙམ་གྱི་ངོ་བོ་རུ།",
    "ཇི་ལྟ་བ་བཞིན་དུ་གྱུར་པ་ལ་རྟོག་པ་དང་བཅས་པའི་གཟུགས་བརྙན་དུ་གྱུར་པ་ནི་ལྷག་མཐོང་གི་དམིགས་པའོ།",
    "གང་གི་ཚེ་སྐྱེས་པ་དེའི་ཚེ་ཞི་གནས་ཡིན་ནོ།",
    "ཇི་ལྟར་བསམས་པ་དེ་ཉིད་ཀྱི་དོན་ནང་གི་ཏིང་ངེ་འཛིན་དང་གཟུགས་བརྙན་གྱི་སྤྱོད་ཡུལ་ལ་ལྷག་པར་མོས་པས་སོ་སོར་བརྟགས་པར་བྱ་སྟེ།",
    "གང་གི་ཚེ་སྐྱེས་པ་དེའི་ཚེ་ལྷག་མཐོང་ཡིན་ནོ།",
    "སེམས་དེ་ཉིད་ལ་གང་གི་ཚེ་རྒྱུན་མི་སུམ་ཅུ་པའི་འགྲེལ་བཤད། ། འཆད་པ་དང་།",
    "གང་གི་ཚེ་རྨུགས་པ་དང་གཉིད་ཡང་དག་པར་བསལ་བར་འགྱུར་བ་དེའི་ཚེ་ཞི་གནས་ཡོངས་སུ་དག་པར་གྱུར་པ་ཡིན་ལ།",
    "གང་གི་ཚེ་རྒོད་པ་དང་འགྱོད་པ་ཤིན་ཏུ་བསལ་བར་གྱུར་པ་དེའི་ཚེ་ལྷག་མཐོང་ཡོངས་སུ་དག་པར་གྱུར་པ་ཡིན་ནོ།",
    "དེ་ནས་དམིགས་པ་གཅིག་ལ་རང་གི་དང་གིས་འཇུག་སུམ་ཅུ་པའི་འགྲེལ་བཤད།",
    "འདིར་ཚིག་འདི་དག་གི་དོན་ནི་གནས་ངན་ལེན་ནི་ཕྱིན་ཅི་ལོག་གི་བག་ཆགས་ཏེ།",
    "གང་གི་ཕྱིར་དེ་ནི་ཇི་ལྟར་བཞིན་དུ་རྣམ་པར་ཕྱེ་བས་ཕྱིན་ཅི་ལོག་གི་དོགས་པ་གཅིག་ཏུ་བསལ་ནས།",
    "ཕྱིན་ཅི་ལོག་གི་མཚན་མ་ཕྱིན་ཅི་ལོག་གི་དོན་གྱི་རྣམ་པ་འགག་པའི་མཚན་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཞི་གནས་དང་ལྷག་མཐོང་ཟུང་དུ་འབྲེལ་པ་ནི་རྣལ་འབྱོར་གྱི་ཐུན་མོང་གི་དབྱེ་བའོ།",
    "གཞན་གཙོ་བོར་མཛད་པ་མ་ཡིན་པ་དེ་ཡང་གང་ཟག་གིས་གསལ་བར་མཛད་པས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "ཐུན་མོང་གི་རྣལ་འབྱོར་གྱི་རབ་ཏུ་དབྱེ་བའོ།",
    "དེ་ལ་དང་པོ་རེ་ཞིག་བརྗོད་པར་བྱ་སྟེ།",
    "སྐྱིལ་མོ་ཀྲུང་དུ་བཅས་ཤིང་ལུས་དྲང་པོར་བྱས་ནས།",
    "རེག་བྱ་འདི་ནི་གྲང་བ་དང་དྲོ་བ་ལ་སོགས་པའོ།",
    "ནང་གི་གསལ་བའི་ངོ་བོ་རྣམ་པར་ཤེས་པའི་ཁམས་དྲུག་པོ་འདི་ལྟ་སྟེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་དང་།",
    "དེ་ལ་དམིགས་པ་དེ་ཉིད་ཀྱི་སེམས་གཉི་ག་མཉམ་པར་བར་ཆད་མེད་པར་ཡིད་ལ་བྱེད་པའི་རྒྱུན་ཞི་གནས་དང་ལྷག་མཐོང་དེ་དག་ཉིད་ཟུང་དུ་འབྲེལ་པར་འཇུག་པའི་ལམ་མོ།",
