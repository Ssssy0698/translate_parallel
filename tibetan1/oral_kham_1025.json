    "དེ་ལ་ཁྱེད་རང་རྣམས་ལ་འབུལ་བ་མེ་ཏོག་ལྟ་བུ་བྱུང་ཡང་།",
    "ཕ་དེའི་བུར་འདུག་སྙམ་པ་བྱུང་གསུངས།",
    "འོ་ན་སྣང་བ་སྣ་ཚོགས་དཀར་དམར་དུ་སྣང་བ་མངོན་སུམ་དུ་འདུག་སྙམ་ན།",
    "ཁྱེད་རང་སོ་སོའི་ལུས་ཇོ་བོ་ཐུགས་རྗེ་ཆེན་པོར་སྒོམས་དང་།",
    "འདིས་ང་ལ་གནོད་པར་འདུག་སྙམ་ནས་ནན་ཏན་ཆེ་བར་བསྒོམས་པས།",
    "ངོ་ལྤགས་ཡ་བ་གཅིག་བཤུས་ནས་ཡར་ལ་བལྟ་ཡང་མི་ཕོད་པར་འདུག་ཟེར་སྐད་དེ།",
    "མ་སྨད་ཆུས་ཁྱེར་བ་ལ་མ་བུ་ལ་བྱམས་པ་སྐྱེས་པས་མཚམས་སྦྱར་ནས་ཤི་བས་ཚངས་པའི་འཇིག་རྟེན་དུ་སྐྱེས་པ་ལགས་པར་གདའ།",
    "དེས་ན་ཁྱེད་རང་རྣམས་ཀྱང་སློབ་དཔོན་དུ་ནི་ཁས་ལེན།",
    "རྩེ་གཅིག་དུས་སུ་དང་པོར་རྟོགས།",
    "རོ་གཅིག་དུས་སུ་གསུམ་པ་ཤེས།",
    "དེ་ཡང་གོམས་སུ་བཅུག་པས་རོ་གཅིག་དུས་སུ་གསུམ་པ་ཤེས་གསུངས་པས།",
    "དེའི་དུས་སུ་མ་ཡེངས་པར་འདུག་དགོས་པ་ལགས།",
    "སྤྱན་སྔ་ནས་གཞན་སུ་ཡང་མི་གདའ།",
    "ལྟས་བཟང་བ་ཀུན་འགྲོར་འཇུག་པ་ཡིན་པར་གདའ།",
    "ང་འབུ་ན་སོ་ཆུང་བས་བརྙས་པར་འདུག་སྙམ་པ་ལ།",
    "འདོད་ཕྱོགས་སུ་རྒྱུ་བར་འདུག་པས།",
    "འགྲོ་འདུག་མང་པོའི་ཁ་ན་མེད།",
    "ཉམས་སུ་བླངས་ལོ་བྱེད་པ་རྣམས་ཀྱིས་ཀྱང་གལ་ཆེ་ཤོས་མ་སྐྱེལ་བ་ཉུང་བར་གདའ་བས།",
    "ཅང་མ་མཉེས་པར་འདུག་སྙམ་པ་སྲིད་དེ།",
    "ཡུལ་དེ་ན་ཡོད་པའི་བན་དེ་ཚོའི་སྡོམ་པ་ཤོར་ནས་འགྲོ་བ་ཡིན་པར་གདའ།",
    "ཁྱེད་རང་རྣམས་ལ་ཡང་ཤི་ཟེར་བ་ཡོང་།",
    "འགྲོ་འདུག་ལ་སོགས་པ་ནམ་དགོས་མི་ཤེས་པ་ཡིན་ནོ།",
    "གར་བསམ་བསམ་དུ་ཕྱིན་པ་ཡིན་པར་གདའ།",
    "འཁྲུལ་པ་ལ་ཉིང་འཁྲུལ་མནོན་ཉེན་གདའ།",
    "ནམ་མཁའ་ནས་གསེར་གྱི་འཁོར་ལོ་རྩིབས་སྟོང་དང་ལྡན་པ་བྱུང་བ་ལགས་པར་གདའ་བས།",
    "ང་རང་མིན་པ་མི་མེད།",
    "མི་མཐུན་པའི་རྐྱེན་དང་བསྲེ་བ་ལ་འཆིམ་ཕུར་འགྲོ་བ་ཡིན་པར་འདུག་པས།",
    "མཚར་བར་འདུག་པས་ད་རུང་གཅིག་རྒྱུགས་དང་གསུངས་པས།",
    "ཐམས་ཅད་ཀྱི་སྐྱོན་དང་ཉེས་པ་མི་བསྒོ་བས་བསྒོ་བསྒྲགས་མི་བྱ་ཞིང་རང་ཐོག་ཏུ་བླངས་ནས།",
    "དྲན་པར་བྱས་ཀྱང་རང་ལ་ཡིད་མི་གཏད།",
    "སྔ་མ་ཐོས་པ་བས་དྲིས་པ་རླབས་ཆེ་བར་གདའ།",
    "ཀུན་ཀྱང་མཚོན་པར་འདུག་པས་དེ་འབྲི་གུང་༧སྐྱོབ་པའི་བཀའ་འབུམ།",
    "འདིས་ཀྱང་བདེ་བ་སྐྱེད་པར་འདུག་སྟེ།",
    "བག་ཁམས་ལྡོག་དོགས་ཤིག་འདུག་པས་སྔ་མ་གཉིས་པོ་རང་གཙོ་ཆེར་བྱའོ།",
    "སྐལ་བ་དང་ལྡན་པའི་སྣོད་འགེངས་པར་མཛད་པ་གདའ་ལ།",
    "བཏེགས་མི་བཏུབ་པར་འདུག་སྟེ།",
    "འདིས་ཀྱང་བདེ་བ་བསྐྱེད་པ་འདུག་སྟེ།",
    "བག་ཁམས་ལྡོག་དོགས་པ་འདུག་པས།",
    "དེ་རང་ནས་མཐེབ་ཆེན་གཉིས་སྲིན་ལག་གནོན་པར་གདའ།",
    "ལས་རྒྱ་ཅན་འདི་གསང་བར་གདའ།",
    "བྱམས་པ་གནོད་པ་མེད་པར་ཁོ་རང་ཅི་དགའ་བྱེད་དུ་བཅུག་པའི་སྒོ་ནས་གདུགས་གཅོག་པ་དེ་ལས་ལྡོག་པ་ཡིན་གསུངས།",
    "དེ་ལ་ཅུང་ཟད་ཅིག་བསམ་པས་མད་པར་འདུག་དཔེར་ན་ཕྱིའི་རྒྱ་མཚོ་ཆེན་པོ་ལ་རྟེན་བཅས་ནས་སྲོག་ཆགས་ཀྱི་རིགས་ཆུ་སྲིན་ལ་སོགས་དཔག་ཏུ་མེད་པ་གནས་པ་དང་བརྟེན་པར་བྱེད།",
    "ཁོ་རང་རྣམས་ཀྱིས་ནི།",
    "རྒྱུ་འབྲས་སྐད་ཅིག་མ་ཁོ་རང་ལ་ཕར་ལ་ཞེ་སྡང་བསྐྱེད་པ་ལྟ་བུ་དེས་བག་ཆགས་དེ་མངོན་དུ་གྱུར།",
    "འདྲེས་གནོད་པ་སྐྱེལ་བ་ཞིག་དུས་ཐམས་ཅད་དུ་ཡོད་ཚུལ་དུ་བགདའ་སྟེ།",
    "རྨི་ལམ་གྱི་གནས་སྐབས་སུ་ཡི་དམ་གྱི་ལྷ་ལ་སོགས་པ་ཉིན་པར་བསྒོམས་པ་བས་གསལ་བར་འོང་བ་འདུག་པས།",
    "བྱིང་རྒོད་རྣམ་པ་གཉིས་པོ་འདི་བསམ་གཏན་གྱི་སྒྲིབ་པར་གསུངས་ནས་ཀྱང་འདུག་དེ་ལྟར་འོང་ཡང་འོང་བ་ལ།",
    "བྱིང་རྒོད་དེ་རང་ལ་བལྟས་པས་དེའི་འདུག་ལུགས་གོ་བ་དང་།",
    "ཕན་བཏགས་པའི་ལན་དུ་གནོད་པ་སྐྱེལ་བའི་སྐབས་ཀྱང་འོང་བར་འདུག་པས་འདི་ཇི་ལྟར་མཆི་ཞུས་པས།",
    "ཡོན་ཏན་གོང་མ་རྒྱུད་ལ་སྐྱེ་ངེས་པར་བཞེད་པ་གདའ་གསུངས།",
    "མཁན་བུ་དེ་ལ་མ་བྱིན་ཏེ་དགྲ་བཅོམ་པ་ལ་བསྔོས་པ་དེ་མི་ཞུ་དོགས་པར་འདུག་པ་ལ།",
    "ཡུད་ཙམ་ཞིག་ཕུལ་བས་ཀྱང་ཉམས་རྒྱུ་ཆེན་པོ་ཞིག་འོང་བའི་རིགས་སུ་གདའ་བའི་བཀའ་སྩལ་གསུངས།",
    "རྒྱ་ལ་བྱུང་ན་དེ་གཅིག་ཤོས་ཡིན་སྙམ་འདུག་པ་ཇི་ལྟ་བ་བཞིན་དུ་འོང་བ་ཡིན།",
    "མེ་དེའི་འདུག་ལུགས་གཞན་ལ་བརྗོད་ནུས་པའི་སྤོབས་པ་ཡོད་པ་དང་།"
  ]
}