    "ཝ་ར་ན་སེར་ཡན་ལག་ཙ་ན་ཀ་ཡི་བཀའ་སོགས།",
    "འགྲོ་ཞིང་འདུག་པའི་སྤྱོད་ལམ་མང་པོ་བྱེད་པ་སྤངས་ཏེ་བརྟགས་པར་བྱ།",
    "དུས་ནམ་ཡིན་ཀྱང་མ་རྩ་དང་རང་རྩ་ནི་དར་ན་རབ་ཏུ་བཟང་སྟེ་དེ་དག་རང་ས་ཡིན་པར་བརྩི་དགོས་སོ།",
    "དེ་ལྟར་བྱིང་བ་མིན་ནའང་རང་བཞིན་གྱི་མི་གསལ་བ་ནི་སྨུགས་ཤིང་འཐིབ་པ་ཞེས་བྱ་སྟེ་དེ་ལྟ་བུ་བྱུང་ན་མྱ་ངན་འོང་བའི་རྩ་ཡིན་ནོ།",
    "དུས་དེའི་མ་དང་རང་རྩ་དར་ན་གཞི་ལ་གནས་པ་དང་།",
    "རང་ལ་དགྲ་ཅུ་བྱུང་བ་དེ་དང་འདྲ་ན་ཚུལ་རྒོལ་བའི་ཚེ་རང་ལ་དགྲ་ཡིས་ཚུགས་ལ་དུས་ཀྱི་མ་རྩ་དང་རང་རྩ་དར་ནཱ་ཚུལ་རྒོལ་བྱུང་ཡང་རང་ལ་དགྲས་ཚུགས་པར་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ན་བླ་རྩ་འདི་སྐྱོན་མེད་པར་གནས་ན་རྟེན་བླ་དང་དེ་ལ་བརྟེན་པའི་ཚེ་ཡང་རང་མལ་དུ་གནས་ལ།",
    "གཉིད་ཆག་པ་དང་འགྲོ་འདུག་མང་དུ་བྱས་པ་དང་།",
    "ཆུ་དེ་གྲང་ལ་ཁད་པའི་དུས་ནས་ལྡོག་དུས་སྔ་ཕྱི་དང་ལྡོག་ཚུལ་དང་གྲང་ཚར་ནས་ལོག་རྗེས་གསུམ་བརྟག་གོ།",
    "ལྷུ་བ་ཆེ་ཆུང་འབྲིང་རྣམས་ལ་ལྕེ་ཆུང་དུ་མས་བསྐོར་ཞིང་ཧ་ཅང་མི་མང་མི་ཉུང་ཡུན་ཧ་ཅང་རིང་པོར་མི་འདུག།",
    "རྩ་མ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "ཆུ་མ་ངེས་ཇི་ལྟར་འདུག་ཀྱང་རུང་།",
    "ལྡོག་དུས་ཀྱི་ཚུལ་ལ་བརྟག་ན།",
    "དབུས་གསུམ་ནི་མགོ་ནས་མར་ཕ་མེས་དང་རང་དང་བུ་ཚའི་ས་ཡིན་ནོ།",
    "ཡང་ན་རིགས་ཀླུ་ཡིན་ཀྱང་རང་བཞིན་གྱི་གདུག་པ་ཆེ་ཞིང་འཚེ་བའི་རིགས་ལ་ཟེར།",
    "ཕྱི་ཚིལ་སྦྱར་ལ་སྣ་ནས་འདུག།",
    "སྔགས་བཏབ་འདུག་པས་འབྱུང་པོ་བྱེར། ། རྒྱ་སྤོས་རུ་རྟ་སྟག་ཚེར་དང་།",
    "དེ་རྣམས་རང་རང་ལེའུ་བསྟུན། ། ཚ་བར་བསིལ་བའི་སྔོ་ཡི་ཆུ།",
    "སྒྲིབ་བྱང་རང་ཉིད་ཤེལ་བུམ་ཞོ་ཡིས་བཀང་འདྲར་ཨ་ཛི་ཏ་ཤཱ།",
    "བསྲུང་སྤེལ་བྱུང་ན་ཅི་མ་རུང་སྙམ་པའི་བློ་ཞིག་འདུག།",
    "དེའི་སྟེང་རང་ཉིད་དང་མ་བྱན་བཅས་བདུན་ཡོད།",
    "དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "གཉིས་པ་ནི་བྱང་སེམས་ཀྱིས་དམན་པའི་ལམ་གཉིས་ཀྱང་རང་རྒྱུད་ལ་བསྐྱེད་ནས་ཤེས་དགོས་ཏེ།",
    "ཡང་རང་རྒྱལ་གྱི་རིགས་ཅན་ཁ་ཅིག་སྔ་མ་ལྟར་བྱས་ནས།",
    "ཁྱེད་ལ་ཉེས་པ་སོ་ན་འདུག་ཅིང་།",
    "ཀུན་བཏགས་མཚན་ཉིད་པར་འཆད་པ་ཡང་རང་ཚིག་འགལ་བས་མི་འཐད་པ་ཁོ་ནའོ།",
    "ཞི་ཚེ་རྣལ་དུ་འདུག་པའོ།",
    "འདི་དག་ལ་ཡང་འོག་ས་དང་རང་སའི་རྟེན་ཅན་གཉིས་ཡིན་ཏེ།",
    "དེ་ཡང་རང་སར་གཏོགས་པ་ཅིག་དགོས་ཏེ།",
    "ཡང་རྒྱུའི་ཀུན་སློང་རང་སའི་སྲེད་པས་མ་བསླངས་ཤིང་།",
    "དེ་ཡང་རང་སའི་སྲེད་པ་སྤངས་པ་ནི་མ་ཡིན་ཏེ།",
    "འདིའི་ལུང་རང་ལུགས་ཀྱི་ཤེས་བྱེད་དུ་དྲངས་པས་ཚད་ལྡན་གྱི་བསྟན་བཅོས་སོ།",
    "ལམ་གསུམ་རང་རང་སོ་སོའི་དོན་ལྡོག་རྟོགས་པའི་ཆེད་ཡིན་པའི་ཕྱིར།",
    "སྣོད་མིན་འགྲོ་ལ་མི་གསུང་བ།",
    "དཔེར་ན་གཟུང་བ་བདེན་མེད་དུ་རྟོགས་ནས་འཛིན་པ་བདེན་མེད་དུ་མ་རྟོགས་པའི་སེམས་ཙམ་པ་དང་རང་རྒྱལ་ཡོད་པ་དང་།",
