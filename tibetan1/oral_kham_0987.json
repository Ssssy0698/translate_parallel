    "ལྷག་པར་ཁོང་རང་ལ་ཆེད་དུ་སྐྱེས་བུ་གསུམ་གྱི་ལམ་གྱི་རིམ་པའི་ཁྲིད་གང་གསུངས་ཐམས་ཅད་ཞུས།",
    "ཁོང་རང་པས་ལམ་རྒྱུད་ལ་སྐྱེ་བའི་རྒྱུ་ཚོགས་ཐམས་ཅད་ཚང་སྟེ།",
    "ཕར་ཙམ་ཚུར་ཙམ་འདུག་ཙ་ན།",
    "ཉེ་གནས་ཀྱིས་སྐྱེལ་དུ་ཕྱིན་ཙ་ན།",
    "པས་དགེ་སྦྱོར་ཤིན་ཏུ་འཕེལ་བར་བྱུང་རོག་ཐོམ་དུ་ལྷ་བཟོ་བའི་ལུགས་བྱེད་ལྟེབ་ལྟེབ་དེ་ན་དགེ་སྦྱོར་ཤིན་ཏུ་འཕེལ་བར་འདུག་ཨང་གསུང་།",
    "ཅི་ལགས་ཞུས་པ་ལ་ར་སྒྲེང་དུ་སྒོམ་ཆེན་རྣམས་ལ་གཏོར་མ་ཞུས་པསཡང་སྣེའུ་ཟུར་པས་བསྒོམས་ནས་དྲིས་པས་དེ་ཙ་ན་བརྡོལ་འདུག་སྐདཔས།",
    "སྟོང་པ་བཞག་ཏུ་མི་བཏུབ་པར་གདའ་ཞུས་པས།",
    "ལན་ཅིག་སྤྱན་སྔ་ན་མི་ཁ་ཅིག་འདུག་པ་ལ།",
    "ངས་ཏིང་ངེ་འཛིན་གཅིག་ལ་མཉམ་པར་གཞག་ན་ཉིན་ཞག་བཅུ་བཞི་ཙམ་གནས་ཐུབ་པར་འདུག་གསུང་།",
    "མངོན་ཤེས་མངའ་འམ་མི་མངའ་སྙམ་པ་ཅིག་བྱུང་ཙ་ན།",
    "ཨ་ན་ཅི་གདའ་ལེ་གསུངས།",
    "ཕྱུག་གཏོད་མཛད་པའི་ཙ་ན་སྟོན་པ་ཤཱཀ་ཚུལ་གྱིས་ཕྱག་བྱསན་བཟའ་ཁུར་ནས་འབུམ་ཆུང་ཟུར་དུ་འོངས་ཙ་ན་ཇི་ཐང་ལ་བཞག་ནས་སྟོན་པ་ཤཱཀ་ཚུལ་ལ་ཕྱག་བྱས།",
    "དེའི་དུས་ཁོ་ནར་ཚེའི་དུས་བྱས་པ་ཇི་ལྟ་བ་བཞིན་མཁྱེན་པར་གས་ནས་ངའི་དྲུང་དུ་བྱུང་གསུངས་ཏེཐོཡང་བྱ་ཡུལ་བ་ཆེན་པོས་སྤྱན་སྔ་གཤེགས་པའི་སྐུ་སྐལ་ཞིག་དང་ན་བཟའ་ཞིག་སྐྱེལ་དུ་བྱོནགདའ།",
    "བྱ་དེ་ཤི་ན་དེ་བསལ་མཁན་མེད་པས་ཆུ་འཁྱིལ་འོང་ཟེར་བ་གསན་པས་བྱ་དེ་ཤིན་ཏུ་གཅེས་པར་འདུག་གོ་གསུངས་ནས་བྱ་དེ་ཤི་དོགས་ནས་ཐུགས་ལས་མཛད།",
    "དེ་ཙ་ན་སྒོམ་ཆེན་ཞིག་ཤི་བའི་སྤུར་སྦྱངས་པས་འཇའ་དང་འོད་ལ་སོགས་པ་བྱུང་།",
    "ཡབ་ཀྱིས་ཁམས་ངན་པར་འདུག་པས་དེ་རིང་མ་སྲུངས།",
    "བའོ་ཐང་འདིར་ཇི་ལྟ་བུའི་མི་ཆེན་པོ་ཞིག་འབྱོན་པར་འདུག་གསུངས།",
    "རྩེ་ལྔའི་རི་ལས་འདིར་ལྷགས་གདའ།",
    "དེ་རྣམས་གླུ་ལེན་གྱི་འདུག་པའི་ནང་ན་མར།",
    "ཡོན་ཏན་ལ་ངོམས་པ་བག་ཙམ་ཞིག་མཆིས་པ་འདི་དེའི་འོད་ལ་བརྟེན་པ་ཞིག་ལགས་པར་གདའ་གསུངས།",
    "དཀར་ནག་ལས་དང་ལས་ཀྱི་རྣམ་སྨིན་སྒྱུ་མ་ནམ་མཁའི་ངོ་བོར་ཤེས་གྱུར་ཀྱང་རང་བཞིན་མེད།",
    "འགྱོད་བ་མེད་པར་འགྲོ་གསུངས་ནས་གཟིམ་ཇོ་རིན་ང་ཡང་འགྲོ་བར་འདུག་སྟེ་མ་སྡུས་རན་པ་ཡིནཁང་དུ་གཤེགས་སོ།",
    "ཧ་ཅང་གས་ཡུན་ང་བས་རིང་ན་དཔེ་ལ་ཁྱེད་རང་མཁས་པ་མིན་ནམ་གསུང་པ་ལཏོ་བའི་དྲུང་དུ་བཞུ།",
    "མི་འདི་སྦྱང་སླ་ངང་འདུག་གསུང་།",
    "ཐུགས་མ་མཉེས་ཙ་ན་ཁྱེད་ལེགས་པར་བྱེད་ན་གྱིས།",
    "ཐུགས་ཀྱིས་མཁྱེན་ནས་ཁྱེད་རང་གྲབས་ཀྱིས།",
    "བསྔོ་བ་བྱེད་ཙ་ན་ཁ་བ་ཐུལ་གྱིས་བྱུང་བས།",
    "ཐར་དུས་མེད་པའི་བཙོན་དུ་འདུག་གོ་གསུང་།",
    "དག་པའི་སྣང་བ་འབའ་ཞིག་འཆར་ཡིན་འདུག་གསུང་ནས་ཐུགས་ཁྲལ་མཛད་པར་གསུངས།",
    "དབྱར་དེ་ཉན་ཐོས་ཀྱིས་གསུང་ཞིང་འདུག་པ་ཉན་པས།",
    "ཟེར་བ་ཅིག་གདའ་བ་འདི་ཟབ་མི་ཟབ་ཇི་ལྟར་ལགས།",
    "གཞན་གོ་བ་ཙམ་ཡང་མི་འདུག་གསུང་།",
    "བྲག་ཕུག་ཏུ་ཚེམ་བེར་གྱོན་ནས་འདུག།",
    "གཅུང་པོས་སྐུ་ཁམས་ཞན་པར་གདའ།",
    "ད་ཚོགས་སུ་འདི་ལས་འཆད་པ་མི་འོང་བས་ཁྱེད་རང་ཐམས་ཅད་ནན་ཆགས་གྱིས་ཤིག་གསུང་།",
    "སྤྱིལ་དུ་མཆོད་ཁང་རང་ཡང་མེད་པར་འདི་ཁོ་ན་སྦྱང་སྙམ་པ་ཡིན་པ་ལ་གསུང་།",
    "དེ་ཡིན་པར་འདུག་དེའི་རིགས་སུའང་གདའ།",
    "ད་ཁྱེད་རང་ཀླུངས་ཤོད་ཀྱི་ནང་ན་སྤྱིལ་བུ་བྱ་བའི་ལུང་པ་ཡོད།",
    "ཕུང་པོ་འདི་ལྔར་འབྱེད་ཚོད་ཀྱིས་མཐར་སྟོང་པ་ཉིད་དུ་འདུག་སྙམ་སྟེ་བདག་མེད་པའི་ལྟ་བ་རང་འཁྲུངས་སུ་བྱུང་།",
    "དེ་ནས་གར་བཞུད་ཆ་མེད་པར་ང་རང་དད་གུས་ཆུང་བས་ལན་སྙམ་ནས་གསོལ་བ་ཤུགས་དྲག་བཏབ་པས་དངོས་སུ་བྱོན་ནས་བཞུད།",
    "དེའི་ཚེ་སྤྱན་སྔའི་ཐུགས་ནམ་མཁའ་ལ་བྱོན་ཏེ་བྱ་ཡུལ་བ་ཆེན་པོ་སྨྱུག་རུམ་གྱི་གདོང་དེ་ནི་གསོལ་བ་འདེབས་ཀྱིན་བཞུགས་པའི་པང་དུ་བྱུང་བས་ཐུགས་ཀྱི་གཏོད་ས་ང་རང་ཡིན་སྙམ་དུ་དགོངས་པ་བྱུང་གསུངས།",
    "ཁོང་བཙུན་ཆུང་བྱུང་ཙ་ན།",
    "ལན་ཅིག་སྟོད་ལུང་པས་སྤྱན་སྔ་མཇལ་དུ་བྱོན་ཙ་ན།",
    "ཚོགས་སྡུད་པ་ཅིག་འོང་བར་འདུག་གསུང་།",
    "དེ་ཐུགས་མད་པར་གདའ།",
    "དེས་ན་ང་རང་ལ་གོ་བ་ཅིག་ཡོད་ཨང་གསུང་།",
    "ཁྱེད་ཀྱིས་ནི་ཁོ་བོ་ཐུགས་ལས་ཆུང་ངུར་གཞོལ་བས་ཆོག་པ་ཅིག་འོང་བར་འདུག་གོ་གསུང་།",
    "དེ་ནས་ཚུར་བྱོན་ནས་བརྒྱགས་ཀྱི་རྩོལ་བསྒྲུབ་བྱས་ཏེ་སྤྱན་སྔར་བྱོན་ཙ་ན།",
    "དེ་ནས་གདམས་ངག་བཏབ་སྟེ་གཞན་རྣམས་ཀྱིས་ང་མ་རྙེད་པར་འདུག་སྟེ།",
    "བྱ་ཡུལ་བའི་ཞལ་ནས་ངོ་མཚར་ཆེ་ཐ་མལ་པར་མི་གདའ་གསུང་སྣང་བ་ཅིག་གདའ་ཞུས་པས།",
    "དགེ་སྦྱོར་བྱེད་འདོད་མ་བྱུང་བའི་དུས་སུ་སྤྱན་སྔར་ཕྱིན་ཙ་ནཞལ་རས་ནག་ཐིང་མཛད་ནས་དགོས་པ་མེད་གསུང་།",
    "ནངས་ཅིག་དགེ་སྦྱོར་བྱེད་འདོད་ལྷན་གྱིས་བྱུང་བས་སྤྱན་སྔར་ཕྱིན་ཙ་ན།",
    "འདི་ཙུག་གདའ་ཞུས་པས་དེ་ངས་བྱིན་གྱིས་བརླབས་པ་ཡིན།",
    "དེར་ཐེམ་པ་ལ་སྙེས་ནས་བཞུགས་ཙ་ན།",
    "དེ་མིན་ན་དེའི་ཚེ་གསུང་ཁ་ཡར་འོང་བ་འདུག་པ་ལ་བོན་སྟོན་སྐུ་ན་གཞོན་པས་མཆི་མ་མ་ཐུབ།",
    "ལན་ཅིག་ཙ་ན་འུ་ཅག་ལ་ཚེ་རིང་པོ་འོང་ངེས་མེད།",
    "འདི་ལ་གཞན་མི་འཚལ་བར་གདའི།",
    "གསོལ་བ་བཏབ་ཙ་ན་མི་མཇལ་བ་བྱེད་མ་མྱོང་གསུང་།",
    "རིན་ཆེན་སྒང་ན་བཞུགས་ཙ་ན་རྨི་ལམ་དུ་ནགས་གསེབ་ཅིག་ན་བྲག་ཕུག་ལེགས་པ་ཅིག་འདུག་དེའི་ནང་དུ་བྱོན་ཙ་ན།",
    "ཇོ་བོ་ནཱ་རོ་པ་བདུད་རྩི་ཀ་པཱ་ལ་གང་ཐོགས་ནས་འདུག་ཁྱེད་འདི་འདོད་དམ་གསུང་།",
    "མ་ཕྲད་ཞུས་པས་འོ་ན་དེ་ཐ་མལ་པར་མི་འདུག་གསུང་།",
    "ར་སྒྲེང་དུ་བྱོན་པའི་ཚེ་ཇོ་བོའི་ཕྱག་དཔེ་འདི་རྣམས་གཟི་གས་དགོངས་ཙ་ན་ཨ་ཏི་ཤ་རྨི་ལམ་དུ་བྱོན་ནས་འདི་འདི་སྐད་བྱ་བ་ཡིན་གསུངས་ནས་ཕྱག་དཔེ་རྣམས་ཅག་གེ་བསྟན།",
    "རྒྱལ་པོ་ཨིནྡྲ་བྷུ་བྷིའི་ཞབས་ལ་རྩྭ་ཨ་བ་གཉིས་སྐྱེས་ནས་འདུག་པ་ལ།",
    "འཁོར་རྣམས་ཀྱིས་མར་སྔོན་ལ་འོངས་པས་ལམ་ཁར་ཆར་པ་བཏང་ཙ་ན་དྲིལ་བུ་སིལ་གྱིས་བྱུང་བས་དབོན་སྟོན་གཟིམ་ཆུང་ན་བཞུགས་འདུག་ལན་ཅིག་ཀ་གཉིས་མའི་སྐས་དེ་མེད་པ་ཅིག་ལ་རྒྱ་མཐོངས་ཀྱི་ནམ་མཁའ་ལ་སྐས་ལ་གཤེགས་པ་བཞིན་དུ་ཕེབས་པ་རྒྱལ་ཡེས་མཐོང་།",
    "པའི་གྲགས་པ་གདའ་བ་ལགས་སམ་ཞུས་པས།",
    "འབུམ་པ་འདི་འདི་བཞེངས་ཙ་ན་ང་ལ་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོར་སྐྱེ་བའི་སྣང་བ་མང་པོ་བྱུང་དེར་འཁོར་ལོ་དེ་གང་དུ་གདའ་ཞུས་པས་གསེར་གྱི་འཁོར་ལོར་སྣང་དེའི་རྒྱུའི་གཙོ་བོ་ཡིན་གསུང་།",
    "སློབ་དཔོན་པའི་ཕྱག་ཞབས་ལ་འཁོར་ལོ་རྩིབས་བརྒྱད་གདའ་བ་ལ་མུ་ཁྱུད་ཕྱི་མ་འདི་མ་འབྱར་ཙམ་དུ་གདའ་བ་ཇི་ལྟར་ལགས་ཞུས་པས།",
    "མི་ནག་པོ་དེ་མགོན་པོ་གྲི་གུག་ཡིན་པར་འདུག་གསུང་།",
    "དེའི་འཁོར་རྣམས་དང་བསུ་མི་རྣམས་ཀྱང་རང་ལ་ཐིམ་པར་མཐོང་བས་རང་ལ་གྱུར་ནས་རང་ལ་ཐིམ།",
    "ལ་མཉམ་པར་བཞག་པས་ཁྱེད་ཀྱི་བུར་འདུག་པ་ཐིགས་པ་ཡིན་གསུང་བ་ལ་སོགས་པའི་གསང་བའི་གནས་དུ་མ་གསུངས་ནས།",
    "ཤེས་རབ་བསྐྱེད་པའི་ལྷ་འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན་དང་།",
    "བོད་ཀྱི་གྲུབ་ཐོབ་ཏུ་བྱེད་པའི་རྟོགས་པ་བཟང་ཤོས་མཐར་ཐུགས་པ་འཁྲུངས་འདུག་ནའང་།",
    "རྗེ་བཙུན་པ་ཁོང་རང་ལམ་འབྲས་སོགས་གསན་པའི་ངང་ནས།",
    "སྐོར་ཡང་མཛད་པས་ཆོག་པ་ཡོད་ཀྱང་དེ་ནས་དེ་འཕྲལ་དབུས་ལ་བྱོན་ནས་སོས་ཚལ་པའི་ལུགས་མ་དར་འདུག་པས་མ་བྱས་གསུང་ངོ་གུང་ཐང་ནས་བརྩམས་ཏེ་རིམ་པ་བཞིན་དུ་གསང་ཕུ་དང་རྩེས་དང་ལ་སོགས་པའི་གྲྭ་ས་ཆེན་པོ་རྣམས་སུ་།",
    "ཡུ་བ་དང་བཅས་པ་ཞིག་འདུགདེ་ཕྱག་ཏུ་བླངས།",
    "འདི་རྗེ་བཙུན་སྒྲོལ་མའི་ཕྱག་མཚན་དུ་འདུག་པས་དེས་རྗེས་སུ་འཛིན་པའི་ལྟས་ཡིན་ནམ་དགོངས་པ་ན།",
    "དེ་དུས་ཀྱང་འགྲེལ་ཆེན་གསུང་བའི་ལེའུ་དང་པོ་རྫོགས་པའི་མཚམས་ལ་འདུག་པས།",
    "ཕྱིས་མཇལ་བ་ན་སྐུའི་རྣམ་པ་མནལ་ལམ་དུ་བྱུང་བ་དེ་ཉིད་རང་དུ་འདུག་གསུང་ངོ།",
    "ཕྱག་དཔལ་བ་གདན་དྲངས་ནས་བཞུགས་འདུག་པའི་སྤྱན་སྔར་བྱོནནཱ་རོ་འགྲེལ་ཆེན་ལ་སོགས་པ་དུས་འཁོར་གྱི་ཆ་ལག་མང་པོ་ཞིག་གསན་ཞིང་དཔལ་རྡོར་བསྟོད་འགྲེལ།",
    "མི་གོ་བར་འདུག་ལགས་ཞུས་པས།",
    "ཞིག་མྱུར་དུ་འོང་བ་འདུག་ཅེས་གསུང་ངོ།",
    "རྗེ་བཙུན་འཇམ་པའི་དབྱངས་ཀྱིས་སྔར་བཞིན་ཉམས་སྣང་རང་དགའ་བ་མིན་པས་གསོལ་བ་དྲག་ཏུ་ཐོབ།",
    "ཇོ་བོའི་སྐུ་དེ་ཡང་ཕུལ་དུ་བྱུང་བ་ཞིག་འདུག་ནའང་།",
    "གང་དུ་བཞུད་ཅེས་གསོལ་བས་རྫིང་ཕྱིའི་རབ་གནས་ལ་སྤྱན་འདྲེན་གྱིན་འདུག་ཅེས་གསུང་བའི་ཚེས་གྲངས་དང་རབ་གནས་མཛད་པའི་ཚེས་གྲངས་གཉིས་ཕྱིས་བརྩིས་པས་མཐུན་པར་བྱུང་ངོ།",
    "སྟོང་པ་ཉིད་ཀྱི་རྒྱས་མ་ཐེབས་པའི་སྣང་བ་རང་དགའ་བ་ཆེར་མི་འཆར་བར་འདུག་ཅེས་གསུང་ངོ།",
    "དེ་མི་སྣ་ལྡོག་དུས་རྒྱལ་པོ་ལ་ལེགས་གསོལ་ཞུ་འབུལ་བྱསཇ་སོགས་གནང་།",
    "ད་ནི་ང་རང་དབེན་གནས་ཤིག་བཙལ་ནས་སྒྲུབ་པ་བྱ་དགོངས་ཏེ་མལ་གྲོ་རྒྱལ་སྟང་དུ་ཐོགས་གཅིག་བཞུགས།",
    "ཁྱེད་རང་གཉིས་ཀྱང་བེམ་རིག་མ་བྲལ་རིང་ལ་ནང་འདིར་མ་བྲལ་བ་བྱེད་དགོས་པ་ཡིན།",
    "བཤེས་གཉེན་གཞན་སུ་ལའང་མི་བསྔགས་པ་ཅུང་ཟད་ཀྱང་མི་སྨྲ་ཞིང་ཡོན་ཏན་བརྗོད་པ་ལྷུར་ལེན་པ་དང་གང་ཟག་མཆོག་དམན་སུ་ལ་ཡང་ཕུན་སུམ་ཚོགས་པའི་རྣམ་པ་ཆེ་ཆུང་ཅི་འདུག་པ་དང་།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "ཤིན་ཏུ་དང་བ་འདྲེན་པ་ཅིག་འདུག་པས།",
    "འོན་ཀྱང་དགོས་པ་ལྷག་པོ་མི་འདུག་པས་བཞག་གསུང་།",
    "ད་སྣང་བ་མི་དང་མི་བསྟུན་པའི་སྒྲུབ་པ་ཞིག་བྱེད་པས་རྣམ་གྲངས་མང་པོས་དགོས་པ་མི་འདུག་སྙམ་དུ་མ་ཞུས་པ་དེས་ཅུང་ཟད་ཐོབ་རྒྱ་ཆུང་བ་བྱུང་འདུག་གསུངས།",
    "གཏོར་བརྡེག་མཛད་པའི་སླ་ང་ལ་ཞབས་རྗེས་བྱོན་པའང་མང་དུ་བྱུང་འདུག་ཅིང་།",
    "ཡི་དམ་དང་བསྐང་གསོ་རྣམས་ཀྱི་ཞོར་འདེགས་ཀྱང་ལེགས་པར་ཡོང་འདུག་གསུངས་པས།",
