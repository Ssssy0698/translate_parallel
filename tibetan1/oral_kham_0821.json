    "ཕྱག་རྒྱ་བཞི་ཟེར་བ་ཞིག་ཡོད་ཚོད་གདའ་བས།",
    "ཆ་སྟེགས་ཐོག་ན་མཆོད་མེ་འགའ་འོད་ལམ་ལམ་དུ་གོ་དགོད་ཀྱིན་འདུག་ཐབ་ཏུ་མེ་ལྕེ་དམར་པོ་འུ་རུ་རུ་འབར་བ་དང་།",
    "གོ་འདབས་ཀྱི་ཟངས་དེམ་ནང་ན་འོ་ཇ་ཞིམ་པོ་ལྷོག་ལྷོག་ལྷོག་འཁོལ་གྱིན་གདའ།",
    "ད་ང་རང་གཉིད་ལོག་ཏུ་འགྲོ་བ་ཡིན་ཟེར་བ་ལ།",
    "དེ་ལ་ན་ཡོད་པའི་མི་རྣམས་དབེན་ཐིང་ངེར་འདུག་པ་དང་།",
    "ཡང་རྒོལ་བ་འདི་དག་ཡིད་མངོན་དང་རང་རིག་གཉིས་ཁས་མི་ལེན་པས།",
    "གལ་ཏེ་སྤྱི་མཚན་གྱིས་ཀྱང་རང་འཛིན་ཤེས་པ་སྐྱེ་བའི་དམིགས་པ་བྱེད་པས་རང་སྤྱི་ཀུན་ལ་དོན་བྱེད་ནུས་པ་དེ་ཡོད་དོ་ཞེ་ན།",
    "ཁྱེད་རང་སྤྱི་འཛིན་ཤེས་པ་གཟུང་དོན་དུ་བྱས་པ་ལས་སྐྱེ་བར་འདོད་པ་དང་ཡང་འགལ་ཏེ།",
    "འཕྲོད་འདུ་དེས་སྦྲེལ་བའི་ཡོད་པ་དང་རང་རྒྱུའི་འབྲེལ་བ་དེ་གཉིས་ཀྱིས་ཆོད་ཅིང་ཁྱད་པར་དུ་བྱས་པའི་ཡོད་པ་དང་འདུ་བའི་འབྲེལ་བ་དེ་དུ་བ་ལ་མི་རྟག་པ་ཞེས་པའི་སྒྲ་འཇུག་པའི་རྒྱུར་གྱུར་པའི་མི་རྟག་པ་ཡིན་ནོ།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "ཁྱེད་རང་རིགས་པ་ཅན་པའི་ལུགས་ལ་བློ་དུ་མ་ཅིག་ཅར་མི་སྐྱེ་བས་རིམ་གྱིས་འབྱུང་ཡང་འཇུག་པ་མྱུར་བས་གཅིག་ཏུ་ཞེན་པར་འདོད་པ་དེ་བཞིན་དུ།",
    "དེ་བཞིན་དུ་བུམ་འཛིན་རྟོག་པ་ལ་ཡང་རང་ལ་སྣང་བ་ཕྱི་རོལ་གྱི་བུམ་པར་སྣང་བ་ཡོད་པས་སྣང་ཡུལ་ལ་འཁྲུལ་བ་ཡིན་ཀྱང་།",
    "སྔོན་པོ་སོགས་ཀྱང་རང་འཛིན་མིག་ཤེས་སོགས་ཀྱི་བདག་ཉིད་དུ་ཁས་ལེན་པའི་ཕྱིར་རོ།",
    "བ་ལང་རང་ཉིད་ཀྱིས་བ་ལང་དང་བ་ལང་མ་ཡིན་པ་ལས་ལོག་པ་གང་དུ་ཡང་གོ་བར་བྱེད་མི་ནུས་ཀྱིས།",
    "རང་རང་རིག་བྱ་ཐ་སྙད་ཀྱིས།",
    "གཟུང་དོན་ཡང་རང་འཛིན་ཤེས་པའི་རྒྱུ་ཡིན་པ་དེའི་ཕྱིར།",
    "དེས་ན་འདིར་རང་རང་རིག་རྟོག་བྲལ་དུ་སྒྲུབ་པའི་རིགས་པ་ནི།",
    "དེ་མྱོང་རང་རིག་ཡོད་པར་སྒྲུབ།",
    "གཉིས་པ་དེ་མྱོང་རང་རིག་ཡོད་པར་སྒྲུབ་པ་ལ།",
    "དེ་ཡང་རང་ལས་རྫས་གཞན་པའི་མྱོང་བྱེད་ཡོད་པ་མི་འཐད་དེ།",
    "དེར་མ་ཟད་གཟུགས་སོགས་དང་བདེ་སོགས་གཉིས་ཀྱིས་སོ་སོ་སོ་སོར་ཡང་རང་འཛིན་མིག་ཤེས་སོགས་སྐྱེད་ནུས་པ་མིན་ནོ་ཞེ་ན།",
    "མྱོང་བྱེད་ཡོད་ཅིང་རང་ལས་རྫས་གཞན་གྱི་ཤེས་པས་མྱོང་བ་མི་འཐད་པའི་ཕྱིར།",
    "གཉིས་པ་བདེ་སོགས་ཕྱིའི་བེམ་པོ་ཡིན་པས་དེ་མྱོང་རང་རིག་མེད་པར་འདོད་པ་དགག་པ་ལ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "རྟོག་མྱོང་རང་རིག་མངོན་སུམ་རྟོག་བྲལ་མ་ཡིན་པར་འགྱུར་ལདེ་ལྟ་ན་མངོན་སུམ་གྱི་མཚན་ཉིད་རྟོག་བྲལ་ཉམས་སོ།",
    "གོ་ཆོད་ན་རྟོག་པའང་རང་རིག་མངོན་སུམ་དུ་འགྱུར་བས་རང་རིག་མངོན་སུམ་ལ་རྟོག་བྲལ་གྱིས་ཁྱབ་པ་ཉམས་སོ།",
    "འོ་ན་ཁྱེད་རང་མཚུངས་སམ་ཞེ་ན།",
    "གང་རང་རིག་པ་དེ་ནི་འབྲས་བུར་འགྱུར་རོ།",
    "གཞན་རིག་མངོན་སུམ་གྱི་ཚད་འབྲས་ཀྱི་འབྲས་བུ་ཡང་རང་ལས་རྫས་གཞན་དུ་གྲུབ་པའི་ཕྱི་རོལ་གྱི་དོན་རིག་པ་ཡིན་པ་ཡང་བཀག་པ་ཡིན་ནོ།",
    "བློ་ཚུལ་གཉིས་དང་རང་རིག་སྒྲུབ་པའི་རིགས་པ་རྒྱས་པར་འཆད་པ་སྟེ།",
    "རྣམ་གཞག་བྱེད་པའི་རྟོག་པ་ཁོ་རང་ལ་དེ་གཉིས་ཐ་དད་དུ་སྣང་བ་དང་མཐུན་པར་བྱས་པ་ཡིན་ཞིང་།",
    "ལྡོག་པ་ཐ་དད་དུ་འཇོག་པའང་རང་འཛིན་རྟོག་པ་ལ་ཐ་དད་དུ་སྣང་བ་ལ་བརྟེན་ནས་བཞག་དགོས་པས་ཚད་འབྲས་ཀྱི་རྣམ་གཞག་བློ་གང་ལ་བརྟེན་ནས་བཞག་པའི་རྟེན་ངོས་འཛིན་པའི་གཞུང་ཡིན་གྱི།",
    "ཞེས་པ་མན་ཆད་དྲན་པ་རྣམ་ལྡན་ཡིན་པའི་རྟགས་ཀྱིས་དྲན་ཤེས་དེས་དྲན་པའི་གཟུང་དོན་རང་མཚན་དང་ལྡན་པའི་ཤེས་པ་རྣམ་ལྡན་དུ་སྒྲུབ་པའི་རིགས་པ་ལ་ཁྱེད་རང་ཊཱིཀ་བྱེད་ཐམས་ཅད་ཀྱིས་ཀྱང་སྦྱར་བ་དང་དངོས་སུ་འགལ་ལོ།",
    "གལ་ཏེ་ནུས་ནའང་རང་བཞིན་གྱི་རྟགས་སུ་འདོད་དགོས་པའི་ཕྱིར་རོ།",
    "ཚུལ་གཉིས་སྒྲུབ་པར་བྱེད་པའི་རིགས་པ་རྣམས་ཀྱིས་ཀྱང་རང་རིག་སྒྲུབ་པའི་རྟགས་དེ་ཉིད་ཀྱི་ཚུལ་ཕལ་ཆེར་གྲུབ་པ་ཡིན་ཏེ།",
    "ཤེས་པ་ཡུལ་གྱི་རྣམ་ལྡན་དུ་སྐྱེས་པར་ཁས་བླངས་ཀྱང་རང་རིག་ཁས་མ་བླངས་ན།",
    "བདེ་སོགས་ཤེས་པ་མངོན་སུམ་གྱིས་གྲུབ་ཅིང་རང་རིག་ཡོད་པར་བསྟན།",
    "འོ་ན་ཁྱེད་རང་ལ་ཡང་།",
    "གང་ཟག་སུའི་རྒྱུད་ལ་ཡང་རང་རྒྱུད་ཀྱི་བློ་རྟོགས་པའི་མངོན་སུམ་མེད་པས།",
    "དེ་སྒྲུབ་ཀྱི་མཐུན་དཔེ་མི་སྲིད་པར་བསྟན་པ་གཉིས།",
    "གཉིས་པ་དེ་སྒྲུབ་ཀྱི་མཐུན་དཔེ་མི་སྲིད་པར་བསྟན་པ་ནི།",
    "གཅིག་མེད་ཀྱང་རང་འབྲས་བསྐྱེད་པའི་ངོ་བོར་སྐྱེས་པ་ཉིད་ཀྱིས་འབྲས་བུ་གཅིག་དང་དུ་མ་བྱེད་ཅེས་བརྗོད་པ་འཐད་པའི་ཕྱིར།",
    "ཕྱི་རྒོལ་གྱིས་མ་གྲུབ་པའི་རང་རང་བཞིན་ཡིན་པར་རིགས་གཅིག་པར་འགྱུར་ལ།",
    "དེ་བཞིན་དུ་གྲགས་པའི་རྟགས་ཡང་དག་ཀྱང་རང་བཞིན་གྱི་རྟགས་ཡང་དག་ཡིན་པར་སློབ་དཔོན་མི་བཞེད་དེ།",
    "འདི་ཉིད་སློབ་དཔོན་ཡབ་སྲས་ཀྱི་ཡང་རང་ལུགས་ཀྱི་བཞེད་པ་ཡིན་ལ།",
    "རིགས་པ་དང་བྲལ་བའི་དམ་བཅས་ཀྱང་རང་དང་ནུས་པ་མཚུངས་པའི་དམ་བཅའི་དོན་ལ་གནོད་དགོས་པའམ།",
    "འོན་ཀྱང་རང་རྟེན་ལ་ཞེས་སྨོས་པ་ལ་ནི།",
    "ཞེས་ཤེས་པར་བྱ་བའི་ཕྱིར་དུ་ཡང་རང་རྟེན་ལ་ཞེས་སྨོས་པ་ཡིན་པའི་འགྱུར་བ་མ་ཕྱིར་རོ།",
    "དེ་ཡང་རང་ལུགས་ལ་ཡན་ལག་ཅན་བུམ་པ་དང་།",
    "དུ་ལྡན་ལ་ལ་དུ་བའི་རྟགས་ཀྱིས་མེ་གོ་བར་བྱེད་པ་ཡིན་ན་མེ་ལོག་པ་དེ་ཉིད་ཀྱིས་དུ་བ་ལྡོག་པར་བྱེད་ཅིང་མེ་དེ་ནུས་པ་མཐུ་ཅན་དུ་འཇུག་པ་ན་ཡང་དུ་བ་འདུག་ཅིང་སྐྱེ་བར་བྱེད་པ་ཡིན་དགོས་ཤིང་།",
    "ཆུ་དང་འོ་མ་རང་རང་ངོ་བོ་ལ་སོ་སོར་གནས་པའི་ཕྱིར།",
    "དེ་ཡང་རང་བཞིན་མ་དམིགས་པ་ལ་མཚོན་ན།",
    "དངོས་པོ་དེ་ཉིད་འཇིག་ཀ་མཪ་འའཇིག་པར་འགྱུར་བ་དུས་གཉིས་པར་སྡོད་པ་ལ་བརྟེན་པར་ཁྱེད་རང་ཡང་མི་འདོད་པ་བཞིན་ནོ།",
    "སྣང་བ་གཉིས་ལས་གང་རང་རིག་པ་དེ་ནི་འབྲས་བུར་འགྱུར་རོ།",
    "གང་རང་རིག་པ་དེ་འབྲས་བུར་འགྱུར་རོ།",
    "དེ་ཙམ་ལ་ཡང་རང་རིག་ཅེས་པའི་ཐ་སྙད་བཏགས་ཏེ།",
    "གཞན་ཡང་ཕྱི་རོལ་གྱི་དོན་དུ་སྨྲབས་ཀྱང་རང་རིག་པ་ཉིད་འབྲས་བུར་ཁས་བླང་བར་བྱ་སྟེ།",
    "དོན་ཡོད་ཀྱང་རང་རིག་པའི་ཀླགས་སྐབས་མེད་དོ་ཞེ་ན།",
    "གཞན་དུ་ན་ཕྱི་རོལ་ཏུ་སྨྲ་བས་ཀྱང་རང་རིག་འབྲས་བུར་ཁས་བླང་བར་བྱ་བའི་སྒྲུབ་བྱེད་དུ་གཞུང་དེ་སྦྱོར་བའི་གོ་སྐབས་ག་ལ་ཡོད།",
    "ཚུར་མཐོང་རང་རིག་མངོན་སུམ་དང་གཞན་རིག་མངོན་སུམ་ཡང་མི་འགལ་བ་དགག་ཏུ་མེད་དོ་ཞེས་བསྐལ་པའི་བར་དུ་སྒྲེ་བར་བྱའོ།",
    "དེ་ཉིད་ལ་འཛིན་པའི་རྣམ་པར་བཞག་པ་ཡང་རང་རིག་མངོན་སུམ་གྱི་འཛིན་རྣམ་དེ་མ་ཡིན་པར་ཤེས་པར་བྱ་བའི་ཆེད་དུ་མྱོང་བར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་ཡོངས་སུ་གཅོད་པའི་འཛིན་རྣམ་ཡང་རང་རིག་ཡིན་ནོ་ཞེས་གོ་བར་བྱེད་པའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་ཕྱི་རོལ་དོན་གྱི་ཡོད་པར་སྨྲ་བ་ལ་ཡང་རང་རིག་པ་འབྲས་བུ་ཡིན་པར་རིགས་སོ་ཞེས་འབྲས་བུའི་རྣམ་པར་རྟོག་པ་གསུམ་པ་སྟོན་པར་བྱེད་པ་ཡིན་ནོ།",
    "དེའི་ལུགས་ལ་ཕྱི་དོན་དང་ཤེས་པ་ཡང་བདེན་པར་གྲུབ་པར་ཁྱད་པར་མེད་ཅིང་དོན་རིག་དང་རང་རིག་གཉི་ག་ཡང་བདེན་པར་གྲུབ་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཕྱི་རོལ་གྱི་གཞལ་བྱ་ལ་ཡང་རང་ཉིད་ཉམས་སུ་མྱོང་བ་སྟེ་རང་རིག་པ་ཉིད་འབྲས་བུར་རིགས་ཏེ།",
    "གསུམ་པ་འདིར་ཡང་ཕྱི་དོན་རིག་པ་འབྲས་བུ་ཡིན་པ་བཀག་ནས་སྔོ་སོགས་གཞལ་བྱར་བྱས་པའི་ཚེ་ཡང་རང་རིག་འབྲས་བུ་ཡིན་པར་གཞུང་བཙུགས་ནས་བསྒྲུབས་པ་དང་ཁྱད་པར་ཅི་ཞིག་ཡོད།",
    "རང་རང་རྣམ་པཪ་དཔྱོད་པའི་དཔུང་བསྐྱེད་ནས།",
    "དེ་ཡང་ང་སྙམ་པའི་བློ་ལ་སྣང་ཚུལ་ཇི་ལྟར་འདུག་པ་བརྟགས་པའི་ཚེ།",
    "དེས་ན་ངའི་སྙམ་པའི་བློ་ལྷན་སྐྱེས་ལ་ངའི་སྣང་ཚུལ་ཇི་ལྟར་འདུག་ལེགས་པར་རྟོགས་ན་དགག་བྱ་ངེས་པ་ཡིན་པས།",
    "ང་དང་ཕུང་པོ་གཉིས་འབྲེལ་མེད་སོ་སོ་བཪ་འདུག་པའི་ཕྱིར།",
    "ངའོ་སྙམ་པའི་བློ་ལ་ང་རང་བཞིན་གྱིས་གྲུབ་པར་སྣང་ཡང་ང་སྣང་ཙམ་ནས་རང་བཞིན་ཅུང་ཟད་ཀྱང་མེད་པའི་ངེས་པ་དྲངས་ཏེ་བསྒོམས་པར་བྱའོ།",
    "དེ་ཡང་བློ་དེ་ལ་ང་རང་བཞིན་གྱིས་གྲུབ་པ་དང་།",
    "ང་རང་བཞིན་མེད་པ་གཉིས་ཅིག་ཅར་དུ་སྣང་བ་ཡང་མི་སྲིད་ལ།",
    "ཕྱི་མ་ནི་ཁྱེད་རང་ཡང་མི་འདོད་དོ།",
    "རྒྱན་དང་ཉི་མ་སྦས་པ་སོགས་ལྟར་ན་དོན་བྱེད་ནུས་མི་ནུས་གཉིས་སུ་ངེས་པའང་རང་སྤྱི་གཉིས་སུ་ངེས་ཕྱིར་སྒྲུབ་པ་ལ་འཆད་ལ།",
    "དེ་དག་ལས་བཟློག་པ་བཞི་དང་རང་མཚན་ལའང་དེ་ལྟར་ཕན་ཚུན་ཁྱབ་དགོས་ཀྱི་གཞན་དུ་ན་གྲངས་ངེས་འདི་ལྟར་བསྒྲུབ་པའི་རྟགས་སུ་འབྲེལ་མེད་དོ།",
    "རྟགས་གསུམ་པ་ལ་ཡུལ་ལས་གཞན་པའི་བརྡ་ལ་སོགས་པ་ཡོད་ན་སུ་ལ་མེད་ཀྱང་རང་འཛིན་གྱི་བློ་སྐྱེ་བ་དང་།",
    "དེ་ལ་སྐབས་འདིར་དོན་དམ་ཞེས་པའི་སྐད་དོད་རྒྱ་དཔེ་ལ་མི་འདུག་གོ་ཞེས་དཔང་ལོ་གསུང་ལ།",
    "གལ་ཏེ་ཞེས་སོགས་ཀྱང་རང་གཞུང་དུ་བྱས་ནས་ཕྱོགས་སྔ་མར་མི་བྱེད་པའོ།",
    "རིམ་པ་བཞིན་སྤྱི་མཚན་དང་རང་མཚན་དང་།",
    "ས་མྱུག་དུས་མཉམ་དུ་འགྱུར་བའོ།",
    "དེ་ལ་དཔྱོད་པ་ལ་འཇུག་པའང་རང་མཚན་ཁོ་ནའི་རྟེན་ཅན་ཡིན་ཏེ།",
    "སྒོ་གསེབ་ཏུ་འོད་མཐོང་བ་ན་དེར་ནོར་བུ་འདུག་གོ་སྙམ་དུ་བསམས་ཀྱང་ར་བའི་ཕུགས་སུ་ཐོབ་པའི་ཕྱིར་རོ།",
    "སླར་ཡང་རང་རྒྱུ་ལས་སྐྱེ་བ་མ་ཡིན་པས་ཁྱབ་པ་ཡིན་ཏེ།",
    "རྟགས་དེ་དང་རང་གྲུབ་ཙམ་ནས་ཚོན་ཅན་དུ་ངེས་པ་ཕན་ཚུན་སྤངས་འགལ་མ་ཡིན་པའི་ཕྱིར།",
    "འདས་ལམ་གྱི་སྤང་བྱའི་ས་བོན་སྤོང་བ་དང་སྣང་མུན་གྱི་གནོད་བྱ་ལྡོག་དུས་རིགས་མི་མཚུངས་པར་འདོད་པ་ནི།",
