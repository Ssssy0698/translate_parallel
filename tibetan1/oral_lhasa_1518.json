    "ཕྱོགས་ཡོངས་ནས་འཆར་གཞི་བཏང་སྟེ་ཕྱོགས་བསྡུས་བཅོས་སྐྱོང་བྱས་ཤིང་ས་ཆུ་ཤོར་བར་ཕྱོགས་བསྡུས་སྔོན་འགོག་བྱེད་པའི་མ་ལག་ཆ་ཚང་འཛུགས་དགོས་ཤིང་།",
    "ཞིབ་བཤེར་བྱས་པ་ལྟར་ན།",
    "དེ་ནས་ཁོང་གཉིས་ཀྱིས་ལམ་རིང་བོར་ཁ་བརྡ་གང་མང་བྱས་མཐར་བཀྲ་ཤིས་ཀྱིས་ཤིང་མངར་རྒྱ་མ་སྟོང་ལྔ་བརྐོས་ནས་ཁོང་གཉིས་ཀྱིས་ཚོང་རྒྱག་པར་གྲོས་འཆམ་བྱུང་།",
    "རང་བྱུང་སྲོག་ཆགས་དང་རྩི་ཤིང་སོགས་ཀྱི་ཐོན་ཁུངས་ལ་གཏོར་བརླག་བྱས་ན།",
    "སྔོན་ཆད་བརྐོས་པའི་ས་དོང་སྔར་བཞིན་སོར་བཞག་བྱས་པས་ཆར་བ་ཆེན་པོ་བབས་ཚེ་ས་དོང་ནང་ཆུས་བཀང་བ་དང་།",
    "གཙང་བོ་དང་མཚེའུ།",
    "ལྕགས་ལམ་དང་གཞུང་ལམ་འགྲམ་གཉིས་ཀྱི་ནང་ཕྱོགས་ཀྱི་རི་ངོས་དེར་ངེས་པར་དུ་རགས་རྒྱག་དགོས་པ་དང་ས་ངོས་བཟོ་བཅོས་ཀྱི་བྱེད་ཐབས་སྤྱོད་དགོས།",
    "དེར་མ་ཟད་ཉིན་དེའི་དུས་ཚོད་བརྒྱད་སྟེང་དངོས་པོ་བསྡུ་འཇུག་བྱས་ཚར་རྗེས་ཐེན་ཅིན་ནས་ཕྱིར་ལོག་གྲབས་བྱས།",
    "ཉེན་ཁ་ཆེ་བའི་དུག་རྫས་སོགས་པེ་ཅིན་ནས་ཐེན་ཅིན་བརྒྱུད་པའི་ལམ་བར་དུ་སྐྱེལ་འདྲེན་བྱས་མི་ཆོག་པའི་བརྡ་སྦྱོར་བཏང་ཡོད།",
    "ནགས་ཚལ་ཐོན་ཁུངས་ལ་རྩད་ཞིབ་གསལ་བོ་བྱེད་པར་འགན་ཁུར་རྒྱུ་དང་།",
    "རྒྱལ་ཁབ་ཀྱིས་རིན་ཐང་ཅན་གྱི་ཤིང་སྡོང་དང་དེའི་ཐོན་རྫས་སོགས་ཕྱིར་གཏོང་བྱེད་པར་གཏན་འགོག་བྱ་ངེས་ལ།",
    "རྒྱལ་སྲིད་སྤྱི་ཁྱབ་ཁང་ལ་ཡར་ཞུ་བྱས་ནས་ཆོག་མཆན་ཐོབ་དགོས་པ་སོགས་གཏན་ཁེལ་བྱས་ཡོད།",
    "ལྷག་པར་དུ་གནམ་གཤིས་ཚ་གྲང་ཆ་སྙོམས་ཡོང་རྒྱུར་ཐད་ཀར་འབྲེལ་བ་ཡོད་པས།",
    "སྡོང་བོ་བཅད་ཆོག་པའི་འཛིན་ཡིག་ནང་གཏན་ཁེལ་བྱས་པ་ལས་ས་གནས་གཞན་དུ་རྒྱལ་ཁབ་དང་མི་གཞན་གྱི་སྡོང་བོ་བཅད་པ།",
    "ལྷག་པར་དུ་སྡོང་དམར་གྱི་ལས་སྣོན་བྱས་པའི་ཁྱིམ་ཆས་དེར་མི་ཀུན་གྱིས་དགའ་བསུ་ཆེན་པོ་བྱེད་བཞིན་ཡོད།",
    "མཚོ་ཆུ་དང་མཁའ་དབུགས་དྭངས་གཙང་དུ་འགྱུར་བ་སོགས་ཀྱི་བྱེད་ནུས་མང་པོ་ལྡན།",
    "འགད་རྫས་བཀད་ཏེ་རྡོ་ཟགས་ལུང་བའི་ནང་ཉིལ་ཏེ་ཆུ་རྡོ་གསེང་དུ་འཐིམ་ནས་སྔར་ལས་ཇེ་ཆུང་དུ་གྱུར་པར་བརྟེན།",
    "ས་ཆུའི་འབྱུང་ཁུངས་སྔོག་འདོན་དང་བཀོལ་སྤྱོད་སྲུང་སྐྱོང་བྱེད་པའི་ཐད་ལ་ངེས་པར་དུ་ཐེ་གཏོགས་བྱེད་དགོས་པ་ཡིན།",
    "དེ་བས་བསམ་བཞིན་ས་ཆུ་ཤོར་བར་སྔོན་འགོག་བྱེད་པར་ཤུགས་བསྣན་ཏེ།",
    "ས་ཆུ་ཤོར་བར་སྔོན་འགོག་བྱེད་པར་ཕྱོགས་གཅིག་ནས་སྡོང་འཛུགས་ནགས་སྐྲུན་བྱེད་པ་དང་རྩྭ་འབྲུ་འདེབས་པར་སྐུལ་ལྕག་གཏོང་བ།",
    "བེད་སྤྱོད་ཐད་ཀྱི་ཚན་རིག་ཞིབ་འཇུག་བྱེད་པར་གཟེངས་བསྟོད་དང་རྒྱབ་སྐྱོར་བྱ་རྒྱུ་དང་།",
    "དམིགས་བསལ་སྔོན་ཐོན་ཅན་ལ་བྱ་དགའ་སྤྲོད་རྒྱུ་བྱས་ཡོད་ལ།",
    "བེད་སྤྱོད་བཅས་བྱེད་ཚུལ་ལ་ལྟ་སྐུལ་དང་ཞིབ་བཤེར་བྱེད་ཤུགས་ཆེ་རུ་བཏང་སྟེ་དགོས་མཁོར་གཞིགས་ནས་ཆེད་གཉེར་མི་སྣའམ་གཅིག་ལྕོགས་མི་སྣ་བསྐོ་བཞག་བྱས་ནས་ལྟ་སྐུལ་དང་ཞིབ་བཤེར་ལས་ཀ་དངོས་བྱེད་འགན་འཁུར་དུ་བཅུག་ཆོག་པ་སོགས་གཏན་ཁེལ་བྱས་ཡོད།",
    "རྩྭ་ཐང་བདག་གཉེར་འགན་གཙང་ལེན་བྱེད་པའི་དུས་དུ་བདག་གཉེར་འགན་གཙང་ལེན་མཁན་གྱིས་བེད་སྤྱོད་བྱེད་པའི་རྩྭ་ཐང་ལེགས་སྒྲིག་བྱས་མི་ཆོག་པ་དང་།",
    "ཞིང་པ་དང་འབྲོག་པར་རྩྭ་ཐང་ར་སྐོར་དང་།",
    "ཁྱབ་གདལ་བཅས་བྱེད་པར་བསྟོད་སྐུལ་བྱ་དགོས།",
    "རྩྭ་སོན་ཐོན་སྐྱེད་བཅས་བྱེད་པར་གཏོང་དགོས་ཤིང་།",
    "ཁོང་གཉིས་ཀྱིས་རྩྭ་ས་དེ་བསྟུད་མུར་ལོ་གསུམ་ལ་འགན་གཙང་ལེན་བྱས་ནས་དབྱར་རྩྭ་བརྐོས།",
    "གལ་ཏེ་རྩྭ་ཐང་ནས་དབྱར་རྩྭ་དགུན་འབུ་ཚད་ལས་བརྒལ་པར་བརྐོས་ནས་སྤང་ཤུན་བཀོག་ཅིང་སྔོ་ཁེབས་ལ་གཏོར་བརླག་ཐེབས་ན་ཕྱུགས་ལས་ཐོན་སྐྱེད་ཀྱི་རྨང་གཞི་ལ་གནོད་སྐྱོན་ཆེན་པོ་བཟོས་པ་ཡིན།",
    "གཏེར་ཁའི་ཐོན་ཁུངས་སྔོག་འདོན་བྱས་པ་དེས་མི་གཞན་པའི་ཐོན་སྐྱེད་དང་འཚོ་བར་གྱོང་གུད་བཟོས་པའི་རིགས་ལ་སྐྱིན་ཚབ་འཇལ་དགོས་པའི་འགན་འཁུར་དགོས་པ་མ་ཟད།",
    "ཁོས་བསྟུད་མུར་ལོ་གསུམ་ལ་སྐེ་ཚེ་བཏབ་ཀྱང་ཡོང་སྒོ་ཅི་ཡང་མེད་པར་གྱུར།",
    "རྩྭ་ཐང་རྐོ་སློག་བྱས་ནས་ཞིང་ས་རུ་བསྒྱུར་རྗེས།",
    "གཏེར་ཁའི་ཐོན་ཁུངས་ལུགས་མཐུན་གྱིས་བསྔོགས་འདོན་དང་བེད་སྤྱོད་བྱེད་པར་རྒྱལ་ཁབ་གཞུང་ནས་འགན་ལེན་བྱ་རྒྱུ།",
    "ཐོན་ཁོངས་རྩད་ཞིབ་དང་བསྔོགས་འདོན་བྱ་རྒྱུའི་ཐད་ཀྱི་ཚན་རིག་ལག་རྩལ་ལ་ཞིབ་འཇུག་བྱེད་པར་བསྔགས་བསྐུལ་དང་སྔོན་ཐོན་ལག་རྩལ་ཁྱབ་སྤེལ་བྱས་ཤིང་གཏེར་ཁའི་ཐོན་ཁུངས་རྩད་ཞིབ་དང་བསྔོགས་འདོན་གྱི་ཚན་རིག་ལག་རྩལ་མཐོ་རུ་གཏོང་རྒྱུ།",
    "ཉེན་མེད་ངང་ཐོན་སྐྱེད་ནུས་ཤུགས་སོགས་ཆེ་རུ་གཏོང་བ་བཅས་ལ་མཛུབ་སྟོན་དང་རོགས་རམ་བྱ་དགོས་པ་ཡང་གཏན་ཁེལ་བྱས་ཡོད།",
    "ཉམས་མྱོང་ལ་བརྟེན་ནས་སྔོག་འདོན་བྱས་པ་དང་།",
    "རྡོ་སོལ་ཡོད་པ་མཐོང་མ་ཐག་ས་དོང་བརྐོ་རྒྱུར་རྔམ་པ་ལས་དོང་ལམ་གྱི་སྤྱི་ཁོག་ལ་ཚོད་འཛིན་བྱེད་མ་ཐུབ་པར།",
    "རྡོ་སོལ་གཏེར་ཁུངས་ཀྱིས་དོང་བརྐོ་བའི་ཇུས་འགོད་ཐབས་ལམ་མེད་པར་ཉམས་མྱོང་ལ་བརྟེན་ནས་གཏེར་ཁ་སྔོག་འདོན་བྱས་ན།",
    "གཏེར་རྫས་ཐོན་ཁུངས་སྔོག་འདོན་བྱས་མི་ཆོག་ཅེས་པའི་ཆོད་དོན་གྱི་ཁོངས་སུ་གཏོགས་པས།",
    "འབྲུག་རྒྱལ་སོགས་ཀྱིས་དཔང་ཡིག་མེད་པར་གང་འདོད་དུ་སྔོག་པ་དང་གང་འདོད་དུ་བརྐོས་པ་དེས་ཆུ་རགས་ལ་གཏོར་བརླག་ཚབས་ཆེན་ཐེབས།",
    "ཡིན་ནའང་འབྲུག་རྒྱལ་སོགས་ཀྱིས་བཀའ་བརྡ་འདིར་ཁ་ཡ་སྤུ་ཙམ་ཡང་མི་བྱེད་པར་མུ་མཐུད་དུ་སྔོག་འདོན་བྱས།",
    "འབྲུག་རྒྱལ་གྱིས་སྔོག་འདོན་དཔང་ཡིག་མ་བླངས་པའི་གནས་ཚུལ་འོག་མུ་མཐུད་དུ་སྔོག་འདོན་བྱས་པར་མ་ཟད།",
    "རང་ཉིད་ཀྱིས་འགན་གཙང་ལེན་བྱས་པའི་རྩྭ་སའི་སྟེང་རྡོ་སོལ་གཏེར་ཁུངས་ཤིག་ཡོད་པར་མ་ཟད།",
    "ལག་ཆ་སོགས་བཟུང་ནས་འགན་གཙང་ལེན་བྱས་པའི་རྩྭ་སའི་སྟེང་དུ་ས་བརྐོ་རྡོ་སློག་བྱེད་འགོ་བརྩམས།",
    "རྒྱལ་ཁབ་ཀྱིས་གཏེར་རྫས་ཐོན་ཁུངས་ལུགས་མཐུན་ངང་སྔོག་འདོན་དང་བཀོལ་སྤྱོད་བྱེད་པར་ཁག་ཐེག་བྱེད་པ་ན་ཚོགས་པ་གང་ཞིག་དང་མི་སྒེར་སུ་ཡིན་ཡང་བྱེད་ཐབས་སྣ་ཚོགས་སྤྱད་ནས་གཏེར་རྫས་ཐོན་ཁུངས་ཀྱི་སྲུང་སྐྱོང་བྱ་བར་ཤུགས་སྣོན་རྒྱག་དགོས་པ་ཡིན།",
    "གཏེར་འདོན་བྱེད་པར་ཆོག་མཆན་མ་ཐོབ་པར་གང་འདོད་ཀྱིས་གཏེར་རིགས་སྔོག་འདོན་བྱས་པ་དང་།",
    "རྒྱལ་ཁབ་ཀྱིས་གཏན་ལ་ཕབ་པའི་སྲུང་སྐྱོབ་རང་བཞིན་གྱིས་དམིགས་བཙུགས་གཏེར་རིགས་ལ་ཚད་ལས་བརྒལ་པར་སྔོག་འདོན་བྱས་པ་བཅས་སྔོག་འདོན་བྱེད་མཚམས་འཇོག་ཏུ་བཅུག་ཀྱང་།",
    "སྔོག་འདོན་བྱེད་མཚམས་གཏན་ནས་མ་བཞག་པར་གཏེར་རྫས་ཐོན་ཁུངས་ལ་གཏོར་བརླག་བཟོས་པའི་བྱ་སྤྱོད་ཅིག་ཡིན།",
    "གཏེར་འདོན་བྱེད་པར་ཆོག་མཆན་མ་ཐོབ་པར་གང་འདོད་ཀྱིས་གཏེར་འདོན་བྱས་པ་དང་།",
    "ཚད་ལས་བརྒལ་པར་སྔོག་འདོན་བྱས་པའི་གཏེར་རིགས།",
    "རྒྱལ་ཁབ་ཀྱིས་གཏེར་ཁའི་ཐོན་ཁུངས་ལ་ཚད་བཀག་བྱས་ཡོད་པ།",
    "སྔོག་འདོན་བྱེད་མཚམས་མ་བཞག་པར་གཏེར་རྫས་ཐོན་ཁུངས་ལ་གཏོར་བརླག་བཟོས་པའི་བྱ་སྤྱོད་ཅིག་ཡིན།",
    "ད་གཞི་བརྟག་དཔྱད་དང་ཞིབ་བཤེར་བྱས་པར།",
    "རྡོ་སོལ་གཏེར་ཁའི་འགད་རྫས་བརྒྱབ་པའི་ས་འདར་དང་འུར་སྒྲ་ལ་ལྟ་ཞིབ་རྩིས་ལེན་བྱས།",
    "ཁྱིམ་བྱ་གསོ་སྤེལ་ར་བ་སྔོན་ནས་བཙུགས་ཡོད་པར་མ་ཟད་ཐོན་སྐྱེད་བྱེད་བཞིན་ཡོད་པ་དང་།",
    "གཏེར་རྫས་ཐོན་ཁུངས་སྔོག་འདོན་བྱས་ནས་གཞན་གྱི་ཐོན་སྐྱེད་དང་འཚོ་བར་གྱོང་གུད་བཟོས་ན།",
    "གཏེར་ཁ་སྔོག་འདོན་བྱས་ནས་གཞན་གྱི་ཐོན་སྐྱེད་དང་འཚོ་བར་གྱོང་གུད་བཟོས་ན་སྐྱིན་ཚབ་འཇལ་དགོས།",
    "བསླབ་དེབ་འདི་པར་བསྐྲུན་སྐབས་སུ།",
    "སྤྱི་གནོད་གཞན་དག་འགོག་སེལ་བྱས་ཏེ་མི་ཡི་ལུས་ཁམས་བདེ་ཐང་ཡོང་བར་འགན་ལེན་ཡོང་ཆེད་དང་།",
    "བེད་མེད་དངོས་རྫས་ཕྱོགས་བསྡུས་བེད་སྤྱོད་བྱེད་ཐུབ་པའི་ལག་རྩལ་དང་སྦགས་བཙོག་དངོས་རིགས་གཙང་སེལ་ཐུབ་པའི་ལག་རྩལ་འགྲོ་གྲོན་ཆུང་ཞིང་ལུགས་དང་མཐུན་པ་རྣམས་བེད་སྤྱད་བྱ་དགོས།",
    "ཆད་པ་བཅད་དོན་ལག་ལེན་ཡང་མ་བྱས་ན།",
    "ཉེ་ཕྱོགས་གཡོ་ཟོལ་བཅས་བྱས་ན།",
    "རི་སྐྱེས་སྲོག་ཆགས་ལ་སྲུང་སྐྱོང་དང་རྩ་ཆེའི་རིགས་མྱུར་སྐྱོབ་བྱས་ཏེ་རི་སྐྱེས་སྲོག་ཆགས་ཀྱི་ཐོན་ཁུངས་སྲུང་སྐྱོབ་དང་འཕེལ་རྒྱས།",
    "རྒྱལ་ཁབ་ཀྱིས་རི་སྐྱེས་སྲོག་ཆགས་ཀྱི་ཐོན་ཁུངས་སྲུང་སྐྱོང་བྱེད་པར་ཤུགས་སྣོན་དང་བཏུལ་ནས་རྒྱུད་སྤེལ་བ་ལ་གཙིགས་སུ་འཛིན་པ།",
    "ཀྱི་ཐོན་ཁུངས་ལ་བདག་གཉེར་བྱེད་པར་ཤུགས་སྣོན་དང་ཅི་ལྟར་རི་སྐྱེས་སྲོག་ཆགས་སྲུང་སྐྱོང་དང་འཕེལ་རྒྱས།",
    "རྒྱལ་ཁབ་ཀྱི་རྩ་ཆེ་བའི་རི་སྐྱེས་སྲོག་ཆགས་མ་ཡིན་པ་བརྔོན་ན་ངེས་པར་ཏུ་བརྔོན་ཆོག་པའི་འཛིན་ཡིག་ལེན་དགོས་པ་དང་།",
    "གཏན་ཁེལ་བྱས་པའི་གྲངས་ཀའི་ཚད་ལས་རྒལ་མི་རུང་།",
    "རི་སྐྱེས་སྲོག་ཆགས་བདག་གཉེར་དང་བཀོལ་སྤྱོད་བྱེད་མཁན་གྱིས་ངེས་པར་དེའི་ངོས་ཐད་ཀྱི་ཁྲལ་དངུལ་སྤྲོད་དགོས་ལ།",
    "མ་ཟད་རྔོན་ཆོག་པའི་དཔང་ཡིག་ཀྱང་གཞུང་བཞེས་བྱེད་དགོས།",
    "དུས་ལས་ཡོལ་ཡང་འགྲོ་ལུགས་རྗེས་འགྲིམ་མི་བྱེད་པར་སྒོར་ཁྲི་ལྔ་ཡན་ནས་སྒོར་ཁྲི་ལྔ་བཅུ་མན་ཆད་བར་གྱི་དངུལ་ཆད་གཅོད་རྒྱུ།",
    "དུས་བཀག་གཙང་སེལ་བྱེད་འཇུག་རྒྱུ།",
    "བཏུང་བྱའི་རིགས་དང་བྲོ་རྫས་ཀྱི་རིགས་བཟོ་ལས་རྒྱུ་ཆ་སོགས་མཁོ་འདོན་བྱེད་པ་དམིགས་ཡུལ་གཙོ་བོར་བྱས་པའི་ནགས།",
    "ཤིང་ནགས་གཅོད་གཏུབ་ལ་ཚོད་འཛིན་དང་སྡོང་འཛུགས་ནགས་སྐྲུན་ལ་སྐུལ་འདེད་བྱས་ནས་ནགས་ཚལ་གྱི་ཁྱབ་རྒྱ་ཇེ་ཆེར་གཏོང་བ།",
    "ཤིང་ཆའི་སྣ་འཛོམས་བཀོལ་སྤྱོད་དང་གྲོན་ཆུང་བྱེད་པར་ཤུགས་སྣོན།",
    "སོལ་བསྲེག་དང་ཤོག་བཟོ་ཀུང་སི་སོགས་ཀྱིས་ཐོན་སྐྱེད་བྱས་པའི་གྲངས་ཀ་ལྟར་མ་དངུལ་ངེས་ཅན་བསྡུས་ནས་སྡོང་འཛུགས་ནགས་སྐྲུན་ལ་རྒྱབ་སྐྱོར་བྱེད་དགོས།",
    "སྡོང་འཛུགས་ནགས་སྐྲུན་དང་ནགས་ཚལ་སྲུང་སྐྱོང་ནི་སྤྱི་དམངས་ཀྱིས་ངེས་པར་འཁུར་དགོས་པའི་འགན་ཁུར་ཡིན་ལ།",
    "གཞུང་ལམ་དང་ལྕགས་ལམ་འགྲམ་རྒྱུད་དང་གཙང་བོའི་འགྲམ་ངོགས།",
    "ཤིང་ནགས་དང་ལྗོན་ཤིང་གཅོད་པ་ལ་ངེས་པར་གཤམ་གྱི་གཏན་ཁེལ་ལྟར་བསྒྲུབ་དགོས།",
    "དུས་ཡུན་སོགས་དང་མ་འགལ་བར་གསར་སྒྱུར་གྱི་བྱ་བཞག་འགྲུབ་པར་བྱ་དགོས་ལ།",
    "རྒྱལ་སྲིད་སྤྱི་ཁྱབ་ཁང་ལ་ཡར་ཞུ་བྱས་ནས་ཆོག་མཆན་ཐོབ་དགོས།",
