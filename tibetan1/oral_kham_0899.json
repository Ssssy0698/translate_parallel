    "དེའི་ནང་རང་ཅག་བོད་རིགས་ལ་གྲགས་ཆེ་ཤོས་ནི་སློབ་དཔོན་དཔའ་བོས་མཛད་པའི་སྐྱེས་རབས་སོ་བཞི་པ་སྟེ་སྐྱེས་པ་རབས་ཀྱི་རྒྱུད་ཅེས་པ་དང་།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "གཤིན་རྗེའི་ཕོ་ཉ་ཤིན་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་པའི་༡༡༥ ཤ་ཚུགས་ཅན་གྱིས་བཟུང་བར་གྱུར་ཅིང་།",
    "དེ་རིང་ཁོ་ན་མི་འཆི་ཞེས་ཡིད་བདེ་བར་འདུག་པ་རིགས་པ་མ་ཡིན་གྱི།",
    "དེ་བས་ན་གདོན་མི་ཟ་བར་མེད་འགྱུར་ན་ཇི་ལྟར་བདག་ཡིད་བདེ་བར་འདུག་པ་མི་རིགས་སོ།",
    "སྤྱད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "རྐང་པ་རབ་ཏུ་བརྐྱངས་ཏེ་མི་འདུག་ཅིང་ལག་པ་གཉིས་ཀ་དུས་མཉམ་དུ་མི་མཉའོ།",
    "དེ་དག་ལ་བསྙེན་བཀུར་ངན་ངོན་ཙམ་འདུག་པ་མཐོང་ནས་དེ་ལ་ཅིའི་ཕྱིར་གདུང་བར་བྱེད་དེ།",
    "དེ་ལྟར་ན་ཡང་ལས་དམན་པའི་གྲོགས་མི་བྱའོ་སྙམ་ནས་༧གཞན་དག་ཁུར་འཁུར་བ་ལ་སོགས་པ་དམན་པའི་ལས་བྱེད་ན་བདག་ཉིད་ཀྱང་ནི་ཇི་ལྟར་དེའི་གྲོགས་མི་བྱེད་པར་འདུག་པར་མི་རིགས་སོ།",
    "སྐྱེ་ནའང་རང་ཉིད་གཅིག་པུར་སྐྱེ་འགྱུར་ཞིང་།",
    "མི་གཙང་རང་བཞིན་གཞན་གྱི་ལུས་དེ་མི་གཙང་བར་མི་རྟོགས་པ་ཙམ་ཡང་ངོ་མཚར་མི་ཚེ་ཡི།",
    "དེ་འདུག་པ་ན་མུན་པ་མེད།",
    "༡༡ གལ་ཏེ་ཚུལ་གཞན་དུ་འགྱུར་ཡང་རང་བཞིན་སྔར་གྱི་དེ་ཉིད་རྟག་གོ་ཞེ་ན།",
    "དེའང་མི་འཐད་དེ་བདག་དང་གཞན་ཞེས་པ་ཕ་རོལ་ཚུ་རོལ་བཞིན་དུ་ལྟོས་པ་ལས་གྲུབ་པ་ཡིན་པས་གཞན་ལའང་རང་ཉིད་བཞིན་དུ་བློ་བསྐྱེད་པར་བྱའོ།",
    "མདུན་དུ་འདུག་སྟེ་བཤག་བསླབ་བཏུས་ཟིན་བྲིས།",
    "མདུན་དུ་འདུག་སྟེ་བཤག་པར་བྱ།",
    "རྟེན་འབྱུང་རང་བཞིན་གྱིས་སྟོང་པ་རྟོགས་དགོས་པ་དང་།",
    "དངོས་པོ་མེད་པའང་རང་བཞིན་གྱིས་གྲུབ་པ་ཡོད་པ་མིན་པའི་ཕྱིར།",
    "མྱ་ངན་འདས་པ་ཡང་རང་བཞིན་གྱིས་མེད་ན།",
    "འགྲོ་འོང་རང་བཞིན་གྱིས་གྲུབ་པ་དགག་པ་དང་།",
    "རང་གཞན་གང་ལས་ཀྱང་རང་བཞིན་གྱིས་གནས་པར་སྐྱེ་བ་མ་ཡིན་ཏེ།",
    "གཟུགས་ཅན་བདེན་སྟོང་རང་བཞིན་གྱིས་ཡོད་དོ་ཞེ་ན།",
    "གཟུགས་ཅན་རང་བཞིན་གྱིས་ཡོད་པ་མེད་པར་གཟུགས་ཅན་རང་བཞིན་གྱིས་མེད་པའང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དེ།",
    "གཟུགས་ཕུང་རང་བཞིན་གྱིས་གྲུབ་པ་དགག་པ་དང་།",
    "མིང་ཙམ་ཉིད་ཀྱང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དེ།",
    "འགྲོ་འོང་རང་བཞིན་གྱིས་མ་གྲུབ་པའི་དཔེ་དང་།",
    "༡༡ འདུག་པ་ཡིན་གྱིས་མི་གཙང་བའི་རང་བཞིན་དུ་གནས་པའི་ཕྱིར་རོ།",
    "གཞན་དག་ཀྱང་འདི་བཟང་པོའོ་ཞེས་དགེ་ལེགས་ཉམས་པར་བྱེད་པའི་སྐྱོན་དང་བཅས་པའི་གང་ཟག་ལ་ཆགས་པར་གྱུར་བ་གདའ་བའི་ཕྱིར་རོ།",
    "སོ་དྲུག་པ་མི་བཟོད་པ་ནི་གཞན་གྱིས་གནོད་པ་བྱེད་པ་དང་རང་ལ་སྡུག་བསྔལ་བྱུང་བ་དག་ཀྱང་མི་བཟོད་པའོ།",
    "དེས་ཏིང་ངེ་འཛིན་དེ་ཐོབ་མ་ཐག་ཏུ་པདྨ་དེ་ལ་འདུག་པར་ཀུན་ཏུ་སྣང་ངོ།",
    "དེ་དེ་ལ་འདུག་པ་དང་།",
    "སེམས་བསྐྱེད་ནས་གྱི་ནར་འདུག་པ་མི་རུང་བས་རང་གཞན་གྱི་དོན་གཉིས་བསྒྲུབ་པའི་སྒྲུབ་པ་ཉམས་སུ་ལེན།",
    "མ་ངེས་པར་འདུག་སྙམ་ན།",
    "ས་ལམ་མཐོན་པོའི་རྟོགས་པ་རྣམས་ཉམས་སུ་བླང་བ་དང་རང་རྒྱུད་ལ་སྐྱེས་པ་དུས་མཉམ་པ་མི་རུང་བས།",
    "ཁྱད་པར་གཅིག་ཀྱང་མི་འདུག་ན།",
    "༡འདི་ལ་ཐེ་ཚོམ་མི་འདུག་ན།",
    "སྡིག་ལྟུང་རང་བཞིན་མེད་ཤེས་འགྱོད་ཚངས་མཆོག།",
    "༤༩གཉིས་པ་དེ་ཡི་ཡན་ལག་དུས་ཀུན་ཏུ།",
    "༥༢༤ ༦ ཚེསློབ་དཔོན་བེརོ་ཙ་ན་རཀྴི་ཏ།",
    "དམ་པ་སྐྱེ་བ་བདུན་གྱི་དང་པོ་བོད་དུ་བྱོན་ཙ་ན།",
    "བོད་ཡུལ་ཐམས་ཅད་ཤ་རྐྱང་སྤྲསྤྲེའུ་སོགས་རི་དྭགས་སྣ་ཚོགས་ཀྱིས་བཟུངས་ནས་མིའི་འགྲོ་བ་ནི་མི་འདུག་སྐད།",
    "མཛད་པ་འཕྲིན་ལས་ཀྱི་ཆེ་བ་དང་བདུན་དུ་བྱས་ཏེ་འདུག་པ་ལས།",
    "ཡུམ་དང་དྲུང་ན་འདུག་པ་ཀུན་གྱིས་ཐོས་པས་ཐམས་ཅད་ངོ་མཚར་ཆེན་པོ་སྐྱེས་ཤིང་།",
    "དེའི་ཚེ་དེད་དཔོན་ཀེ་ཏ་གྲགས་པ་ལ་སྲས་ཁྱད་པར་དུ་འཕགས་པ་ཞིག་འཁྲུངས་འདུག།",
    "ན་བཟའི་ཐུ་བར་རྡེའུ་དཀར་ནག་མང་པོ་བཀྲམས་ཙ་ན།",
    "ཐུ་ཁུད་དུ་རྡེའུ་རྣམས་བསྡུས་ཙ་ན།",
    "ཕྱུགས་རྣམས་ལྷན་ཅིག་འདུ་བར་འདུག་སྐད།",
    "ཨ་ཙ་ར་མིག་འཕྲུལ་མཁན་ཞིག་འདུག་། ཟེར་ཡང་སྔགས་པ་མང་པོ་ཆང་འཐུང་བའི་སར་བྱོན་པས།",
    "སྐས་ཐེམ་ལ་བྱིའུ་འདུག་པ་རྣམས་ལ་ལྟ་སྟངས་མཛད་པས་ཐམས་ཅད་ས་ལ་ལྷུངས་ནས་ཤི་བ་དང་།",
    "རིག་པ་ལ་འགྲོ་འོང་མེད་པས་ངས་རྟོགས་པའི་གླེང་བླངས་མི་ཤེས་པ་འདུག་གསུངས་སྐད།",
    "སྤང་ལོ་ཙ་བ་དང་མཇལ་བས་རྒྱ་འུ་གཅིག་འདུག་གམ་བསྙམས་ནས།",
    "ལོ་ཙ་བའི་རྟོག་པ་ལ་རྒྱ་འུ་བྲོས་པ་ཞིག་མི་འདུག་བསམས་ནས།",
    "ཁྱེད་ཀྱང་ནག་ཆུང་ཞིག་འདུག་བྱས་པས།",
    "དེ་ན་རྒྱ་གར་གྱི་ཚོང་པ་མང་པོ་འདུག་པའི་ནང་ནས།",
    "ད་ལྟ་ཞེན་མེད་དུ་འགྲོ་ཞིང་བསོད་སྙོམས་ཀྱིས་འཚོ་བའི་རྒྱའི་བྱ་བྲལ་འགའ་ཞིག་འདུག་པ་ཡང་།",
    "འབྲོག་ཡུལ་སྦྲ་ཁྱིམ་ཅལ་ལེ་བ་ཞིག་འདུག་པས།",
    "དེར་ཞག་ཁ་ཡར་བཞུགས་པས་མཐའ་མི་དབུས་སུ་འདུག་པ་ཟེར་ནས་ཡུལ་པས་སྡོད་དུ་མ་སྟེར།",
    "འོན་ཀྱང་རྩ་མྱ་ངན་མེད་པའི་དཔལ་བྱ་བ་སྟེང་དུ་བསྡད་པས་སྡོམ་པ་དམ་ཚིག་སྐྱེ་བ་ཞིག་ཡོད་པ་དེ་ན་སྐྱེས་ནས་གདའ་སྐད།",
    "འོན་ཀྱང་སྔོ་འོད་ལྡན་བྱ་བ་མུན་པ་སེལ་བ་བཀྲ་ཤིས། ། པའི་རྫས་དེ་ཡང་དེ་ན་འདུག་སྐད།",
    "ཡང་མེ་ཏོག་ཀུན་བདེ་བསྐྱེད་བྱ་བ་ཟོས་ན་བསམ་གཏན་གྱི་རིག་པ་དྭངས་པ་ཞིག་ཡོད་པ་དེ་ཡང་རི་ལོགས་དེ་ན་སྐྱེས་ནས་གདའ་སྐད།",
