    "ཕྲ་ཕྱག་བསྟོད་པ་བཞིན་ཞོན་པ་དང་བཅས་བྲི་བར་འདུག་པ་ཇི་ལྟར་ལགས་ཟེར་བ།",
    "ཞིང་ཁམས་མ་རང་ལ་འགལ་བ་ཆེར་མི་འདུག་གཞན་དཀྱིལ་ཐང་སོགས་བྲི་ཆ་ལ་ཞོན་པ་མེད་པ་ཐོབ་རྒྱུ་ཡིན།",
    "ལ་ལ་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་བཅས་ནས་འདས་པ་སོགས་འདུག་རུང་།",
    "སྔར་གྱི་རྩིས་པ་དེས་ཁོ་བོའི་མགོ་ལ་ལག་པས་བྱིལ་བྱིལ་བྱེད་ཀྱིན་འདི་ནི་ཤེས་རབ་ཀྱང་ཕུན་སུམ་ཚོགས་པ་ཞིག་འདུག་པ།",
    "བུ་ཚ་ཆུང་བ་འདི་ནི་གང་བྱེད་ཀྱང་རང་མགོ་ཐོན་པ་ཡོད།",
    "ཡུམ་དང་ཉེ་བ་རྣམས་ངུ་ཡིན་འདུག་པ་ལ།",
    "རིག་པ་འབྲིང་ཙམ་འདུག་མི་ཟད་མྱོང་ཙམ་ཡོང་ཤེས་ཆེ་གསུངས།",
    "འདི་རིག་པ་ཕུལ་དུ་ཕྱིན་པ་ཞིག་འདུག་ཟེར་བས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་ལྷ་ལྔའི་རྗེས་གནང་།",
    "དེའི་གཏོར་བཟློག་གནམ་ལྕགས་ཐོག་མདའི་ལས་འགྲིགས་རྗེས་གནང་རང་ཉིད་ཀྱིས་མཛད་པ།",
    "ས་ཆེན་འཛུམ་མུལ་ལེ་བཞུགས་འདུག་པ་ཞིག་རྨིས་པས་དེ་ཕྱིན་ཆད་བིར་བསྟོད་ས་པཎ་གྱིས་མཛད་པ་དང་།",
    "དབུས་གཙང་བསྐོར་བ་ལ་ཟླ་བོ་བློ་ཁེལ་དང་རང་ཐང་ཐུབ་ཅིག་དགོས།",
    "དུང་དཀར་པོ་བཅུ་གསུམ་གྲལ་གཅིག་ཏུ་སྒྲིགས་འདུག་པས།",
    "སླར་ཡང་རང་ལོ་ཉེར་བདུན་པ་ལ་ཨེ་ཝཾ་དུ་ཡོང་བའི་ལམ་བར་ནག་ཆུ་ཁར་སོག་པོའི་ཡུལ་དུ་ནམས་ལ་ཐོག་གཅིག་བསྡད།",
    "དེའི་འཁྲིས་སུ་འབོལ་ཆུང་ངུ་ཞིག་བཤམས་འདུག་པ་ལ།",
    "བླ་བྲང་རྩིས་སྤྲོད་ཀྱི་སྐབས་ན་འདུག་པས་ངས་ཀྱང་བླ་བྲང་འདིར་ཟླ་བ་གཅིག་ཙམ་བསྡད།",
    "དགོངས་རྫོགས་སུ་ཡང་ཁང་པ་དམར་ཁྲར་རྒྱ་སྦུག་སྤུས་ལེགས་གཅིག་དུས་ཇ་ལྔ་དང་བཅས་པ།",
    "བེེ་རོ་ཙ་ན་དང་།",
    "བར་དུ་རིག་འཛིན་བེ་རོ་ཙ་ན་དེ།",
    "བེ་རོ་ཙ་ནས་བླ་ཆེན་ཡབ་སྲས་གསུམ།",
    "བེ་རོ་ཙ་ནའི་ལྷ་འདྲེ་ཟིལ་གནོན་ནས།",
    "ལོ་ཙཱ་ཆེན་པོ་བེ་རོ་ཙ་ན་དེ།",
    "བེ་རོ་ཙ་ནའི་གྲུབ་ཆུ་འཐུང་ཆོག་ལ།",
    "བེ་རོ་ཙ་ན་གནས་འདིར་བྱོན་པའི་དུས།",
    "བཀྲ་ཤིས་རྫོགས་རིམ་ཙམ་བྱས་ཤེས་མ་ཤེས་ཙམ་ནས་རྨི་ལམ་སད་ནས་འདུག་སྟེ་ཉམས་དགའ་འོ།",
    "གདན་ཁྲི་ཆེན་པོ་དེའི་སྟེང་འདུག་ནས་སུ།",
    "ཤེལ་གྱི་བྲག་དཀར་གཡུང་དྲུང་རང་འཁྱིལ་གྱི།",
    "མཐའ་གཅིག་ཏུ་འདུག་ནས་ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་སྐབས་དེ་བཅོམ་ལྡན་འདས་ལ་རྒྱས་པར་གསོལ་པ་དང་།",
    "གསུམ་གྱི་ཚེ་འདུག་པར་ཤེས་ཤིང་ལན་མང་དུ་ལྟ་ཅི་སྨོས་ན།",
    "ལན་མང་དུ་ལྟ་ཅི་སྨོས་ན་ཞེས་བྱ་བ་ནི་ལན་མང་དུ་འདུག་པར་ཤེས་པ་ལྟ་ཅི་སྨོས་ནའོ།",
    "རྭ་ལས་བྱས་པའི་ཁབ་རལ་བྱེད་དུ་འདུག་པ་བདེན་ནམ།",
    "དེས་གདེངས་ཀ་བྱས་ཏེ་འདུག་གོ།",
    "ཇི་ཙམ་ན་ཁྲི་འོག་ན་སྦྲུལ་དུག་མྱུར་དུ་ཁྱབ་པར་བྱེད་པ་འདུག་པ་མཐོང་ནས་དེ་སྔངས་ཏེ།",
    "དེ་ནས་དགེ་སློང་ཞིག་འདུག་པ་དེས་སྨྲས་པ།",
    "ཡུད་ཙམ་ཞིག་གཏམ་འདྲེ་བས་འདུག་ནས་སྨྲས་པ།",
    "རྣམ་ཐོས་ཀྱི་བུ་ལ་ནོར་གྱིས་འགྲན་པ་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས།",
    "རྡོ་འཇོག་ན་ཁྱིམ་བདག་གཞན་ཞིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "ཡུད་ཙམ་གྱི་སྦྱོར་བས་བག་མར་བཏང་ནས་ཁྱེའུ་དེས་ཀྱང་ཁྱིམ་དེར་འདུག་པར་བརྩམས་སོ།",
    "དེ་དུས་ཅུང་བ་ཟད་ཅིག་འདུག་ནས་སྨྲས་པ།",
    "དེས་སྡོད་ཅིག་ཅེས་བྱས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་གོ།",
    "ཁམས་དང་རང་བཞིན་ཁོང་དུ་ཆུད་ནས།",
    "དགེ་སློང་དག་སྔོན་བྱུང་བ་རི་བྲགས་ཤིག་ན་ཁྱིམ་བདག་ཅིག་འདུག་པ་དེས་རིགས་མཉམ་པ་ལས་ཆུང་མ་བླངས་ནས་དེ་དེ་དང་ལྷན་ཅིག་རྩེ་བར་བྱེད།",
    "སྐྱབས་ལོ་ལ་ཧ་ཅང་གནག་ཅིང་སྡུག་ལ་འཇིལ་ལིར་འཁྱིལ་བའི་རལ་བ་ཞིག་ཡོད་པ་དང་ནམ་རྒྱུན་ལམ་དུ་རྒྱུག་དུས་ལྷེམ་ལྷེམ་དུ་མཁའ་རུ་འཕྱོ་བཞིན་འདུག་པས་སྐབས་འདིའི་གཡུ་དྲུག་དཀར་དཔེ་ཚོགས།",
    "སྐྱབས་ལོའི་མེས་པོ་ཡང་རལ་བས་རོ་སྟོད་ཁེབས་པའི་དཔའ་རྒོད་ཅིག་ཡིན་རབས་འདུག་སྟེ།",
    "དུས་རྒྱུན་ལྷད་མེད་བྱིས་བློའི་ངོས་སུ་མེས་པོའི་སྣང་བརྙན་རབ་རིབ་ཅིག་རྟོག་བཟོ་བྱས་འདུག་སྟེ།",
    "མིག་ཟུང་ཧྲིག་གེར་ཁོ་འཐད་མིན་གྱི་ལན་ལ་སྒུག་འདུགསྐྱབས་ལོས་སླར་ཡང་འདང་ཞིག་བརྒྱབ་རྗེས།",
    "སྐྱབས་ལོ་ཁོ་རང་ཡང་གློག་བརྙན་འཁྲབ་ཏུ་འགྲོ་རྒྱུར་ཧ་ཅང་དགའ་བོ་བྱེད་བཞིན་འདུག་པསམཇུག་མཐར་ཕན་ཚུན་གྱི་གདོང་ལ་བལྟ་ཙམ་བྱས་རྗེས་ཁས་ལེན་བྱ་དགོས་བྱུང་།",
    "སྲང་ལམ་གཞན་དུ་ཕྱིན་ཚེ་དེ་གར་ཡང་སྔར་བཞིན་མི་ཚོགས་ཀྱི་འདུ་འགོད་གཅིག་མཚུངས་སུ་འདུག་པས།",
    "དེ་གར་གློག་བརྙན་པར་ལེན་བྱེད་མཁན་གྱི་ལས་བྱེད་མི་སྣ་དག་དང་འཁྲབ་སྟོན་པ་ཚང་མ་ཡང་བསྡད་འདུག་པས།",
    "འཁྲབ་ཁྲིད་པ་རྒན་པས་སྐྱབས་ལོས་ཟ་མ་འགྲངས་པོ་ཟ་གྱིན་མི་འདུག་པ་ཚོར་བས།",
    "སྐྱབས་ལོས་ཁོ་ཚོའི་གན་ནས་རྒྱ་སྐད་དང་རྒྱ་ཡིག་འདི་འདྲ་ཞིག་སྦྱངས་འདུག་པར་ཡ་མཚན་ཏེ།",
    "ཁོ་རང་ནི་གློག་བརྙན་ཁྲོད་ཀྱི་མི་སྣ་གཙོ་བོ་སྲོང་བཙན་སྒམ་པོ་འཁྲབ་སྟོན་པ་ཡིན་ལ།",
    "ལུས་ལ་ཕྱི་གླིང་བའི་ལྭ་བ་གྱོན་ནས་མགུལ་ཆིངས་དཀྲིས་འདུག་པས།",
    "ཁ་དཔེར་ཡང་རང་ཡུལ་གད་པ་ཡིན་རུང་སྐྱིད་ཟེར་བ་མ་ཡིན་ནམ།",
    "དེ་འདྲའི་མངོན་སུམ་དང་དེ་འདྲའི་ཡིད་འགུལ་ཐེབས་པ་ཞིག་འདུག་པས།",
    "ཁོ་རང་གཅིག་པུ་དེ་གའི་སྔོ་རྩྭ་གཡོ་བའི་ཐང་གཅལ་དུ་གན་རྐྱལ་དུ་ཉལ་ཙམ་བྱས་ནའང་།",
    "འདི་གའི་ཡོད་ཚད་ཀྱང་འཇིག་རྟེན་གྱི་ཕྱི་རོལ་ཏུ་དོར་བ་ཇི་བཞིན་སྟོང་ལྷང་ངེར་གྲག་འགུལ་ཅི་ཡང་མི་འདུག་པས།",
    "ངོ་མ་ཡིད་སུན་ཏེ་སྡོད་མི་བཟོད་པ་ཞིག་ཏུ་གྱུར་འདུག།",
    "ཁོ་ཚོས་ཁོ་ལ་མིང་དེ་ལྟར་འབོད་པ་ནི་ཁོ་ལ་ཡིད་སྨོན་དང་བསྟོད་པ་བྱེད་པའི་ནང་དོན་འདུག་པ་ཡིན་ཡང་།",
    "ཁྱིམ་ཚང་ལ་ལས་ཁོ་རང་ལ་ཇི་ལྟར་སྣེ་ལེན་བྱེད་དགོས་པའང་མི་ཤེས་པར་འུ་ཐུག་འགྲོ།",
    "ཁོ་རང་ཧ་ཅང་དགའ་བྱུང་བ་སྟག་འབུམ་རྒྱལ་གྱི་སྒྲུང་འབྲིང་ཕྱོགས་བསྒྲིགས།",
    "ཡིད་སྨོན་དང་བཅས་བསྟོད་ར་སྣ་ཚོགས་བྱེད་བཞིན་འདུག་ཅིང་།",
    "རྒྱ་སྲང་དུ་འགྲོ་བའི་ཚེ་ན་ཡང་མི་མང་པོས་ལྐོག་ནས་ཁོ་རང་སྟོན་བཞིན་ཅི་ཞིག་ལབ་ནས་དགོད་ཀྱིན་འདུག་པས།",
    "ཁོ་ཧ་ཅང་འདུག་བཟོད་མི་ནུས་པ་ཞིག་ཏུ་བཏང་འགྲོ།",
    "ཁོ་གང་ནས་མཐོང་ནའང་གུས་གུས་ཞུམ་ཞུམ་དང་ཁ་ཡག་ངོ་དགའ་བྱེད་ཀྱིན་འདུག་པས།",
    "འདི་ཉིད་སྐྱབས་ལོ་ལ་མཚོན་ན་ཁོ་རང་ཉིད་ཀྱི་མི་ཚེ་དང་ཁ་འབྲལ་དགོས་ཟེར་བའི་བཙན་གཏམ་ཡ་མེད་ཅིག་དང་གཅིག་མཚུངས་མ་ཡིན་ནམ།",
    "ཆུང་མ་དེ་མ་ཐག་ཏུ་གནམ་ལ་ལྡིང་བྱུང་ཅུས་ཀྲང་ལ་འདུག་པ་དེ་རལ་བ་དང་འབྲེལ་བ་ཅི་ཞིག་ཡོད་དམ།",
    "དེ་ནས་ཁོ་རང་ཁྲིད་ཡོང་སྟེ་སྐྲ་བཞར་འདུག་སྟེགས་སྟེང་དུ་སྡོད་དུ་བཅུག་རྗེས།",
    "སྒྲོལ་འཚོའི་གདོང་ལ་ཅི་མི་སྙམ་པའི་མདངས་ཤིག་ཤར་ནས་ཟུར་ཞིག་ཏུ་བལྟས་ཏེ་འདུག་ཅིང་།",
    "ཁོ་ནི་ཧ་ཅང་འདུག་ཅིག་བྱས་ཏེ་ཧ་ཅང་གཟབ་ནན་ངང་ཤོག་དུད་རྡུབ་བཞིན་མཆིསཡ་མཚན་གྱི་མི་ཞིག་ཡིན་ཏེ།",
    "འོ་ན་བཟང་འདུག་མདང་དགོང་ངས་ལུག་གཅིག་ཉོས་ཡོད་པས།",
    "ཁོས་སྔ་གཞུག་ཀུན་ཏུ་སློབ་གཙོ་རྣམ་རྒྱལ་ཁོ་ནར་ཁ་བརྡ་བྱེད་ཀྱིན་འདུག་ལ།",
    "ང་ཡང་ཅུང་སྐོམ་གྱིན་འདུག་པས་འཛེམ་དོགས་མེད་པར་ཤེལ་ཕོར་ཚུར་བླངས་ཏེ་དེ་མུར་ཞབས་ཏག་བརྒྱབ་པ་དང་།",
    "སླར་ཡང་རང་ཉིད་ཀྱིས་དམ་བེ་བླངས་ཡོང་ནས་གང་བླུགས་པ་ཡིན།",
    "མཇུག་མཐར་ཕམ་ཁ་མྱོང་མཁན་དེ་ང་རང་ཉིད་ཡིན་ངེས།",
    "སློབ་གཙོ་རྣམ་རྒྱལ་གྱིས་ང་རང་གཅིག་པུ་ཁོའི་གཞུང་ལས་ཁང་དུ་བོས་ནས་ཁོས་ང་ལ་དགའ་རོགས་ཤིག་ངོ་སྤྲོད་བྱེད་ཟེར།",
    "དེ་བས་གདམ་ག་འདི་ནི་ང་རང་ཉིད་ཀྱིས་བྱས་པ་ཡིན།",
    "ཉིན་དེར་རྒྱ་ལམ་དུ་མི་ཡི་འགྲོ་འོང་ཅི་ཡང་མི་འདུག་པས་སྟོང་ལྷང་ངེར་འདུག་ལ།",
    "དེ་ལོས་ཡིན།",
    "སློབ་གཙོ་རྣམ་རྒྱལ་གྱིས་རང་ཉིད་ཀྱི་ཚོད་དཔག་ནོར་འདུག་པ་རྟོགས་འཕྲལ་ཅུང་མི་དགའ་བར་གྱུར་པས་ང་ཡང་ཅུང་འགྱོད་པར་གྱུར།",
    "སྒྲོལ་འཚོས་ནི་ལྷ་མགོན་གྱིས་རང་ཉིད་ལ་སྙད་རྐོ་བཞིན་འདུག་སྙམ་པ་ལྟར་ངོ་མདངས་ཤོར་ཏེ་ཡུན་རིང་བོར་ལྷ་མགོན་གྱི་རྣམ་འགྱུར་ལ་ཅེར་ནས་བསྡད་བྱུང་།",
    "སྒྲོལ་འཚོས་ད་དུང་ཡང་ལྷ་མགོན་གྱི་རྣམ་འགྱུར་ལ་ཅེར་ནས་འདུགསྟག་འབུམ་རྒྱལ་གྱི་སྒྲུང་འབྲིང་ཕྱོགས་བསྒྲིགསབྲིསྒྲི།",
    "ཅོག་ཙེ་དང་འདུག་སྟེགས་ཚང་མ་སློབ་ཁང་ལས་ཕྱུང་སྟེ་མདུན་ཕྱོགས་ཀྱི་རྩལ་སྦྱོང་ཐང་དུ་བསྐྱལ་ནས་ཤར་མར་བསྒྲིག་དགོས་པས།",
    "མ་གཞིར་མདང་དགོང་ཁོས་ཕྱི་རོལ་ཏུ་ཆང་འཐུངས་ཏེ་ར་རོ་བར་གྱུར་རྗེས་ནམ་གུང་ཙམ་ལ་ཕྱིར་ལོག་པ་ཡིན་འདུག་ཅིང་།",
    "ཇ་ཤེལ་ཕོར་གང་བླུགས་ནས་མདུན་དུ་འཇོག་དུས།",
    "དཔོན་པོ་འདི་དག་ལ་ཆང་འབུལ་མཁན་མང་བས་ངས་ཀྱང་མི་དགོས་ཟེར་དོན་མི་འདུག་ངོ་ལྤགས་མཐུག་པས་ཁྱེར་ཡོང་བ་ཡིན་ཟེར།",
    "སྐབས་དེའི་ངའི་སེམས་ཀྱི་འགལ་འདུ་དང་ཞེ་སྡང་ནི་ང་རང་ཉིད་ཀྱིས་མ་གཏོགས་ཤེས་མི་སྲིད།",
    "དེ་ལྟར་འདང་བརྒྱབ་ཚེ་ཚང་མ་མིང་ཙམ་གྱི་ཆེད་ཡིན་འདུག་ཟེར།",
    "ཀྱིན་མི་འདུག་ཟེར།",
    "སློབ་གཙོ་རྣམ་རྒྱལ་གཅིག་པུ་གཞུང་ལས་ཁང་དུ་འདུག་པ་མ་གཏོགས་བྱ་བ་གཞན་ཡོད་པའི་ཉམས་ཅི་ཡང་མི་འདུག་ཁོས་ང་བསླེབས་པ་མཐོང་འཕྲལ་ངོ་གདོང་སྔར་བཞིན་གནག་ནས་དེ་གར་སྡོད་ཟེར་བས་ང་ཡང་མར་གཤམ་གྱི་འབོལ་ཁྲི་དེའི་སྟེང་བསྡད་པ་དང་།",
    "ཡིན་ནའང་ཁོར་ཇ་ལྡུག་གྲབས་ཀྱི་རྣམ་འགྱུར་ཅི་ཡང་མི་འདུག་མི་འཐུང་།",
    "ཁོའི་ངོ་གདོང་ནས་དཔོན་པོ་དག་ཁོ་ནར་ཡོད་པའི་བཙན་ཤུགས་དང་རང་རློམ་གྱི་མདངས་ཤིག་མངོན་ཏེ་ཨེ།",
    "ཡིན་ནའང་ངེད་གཉིས་ཀྱིས་དེ་རྩོད་དོན་མི་འདུག་ཟེར་བ་དང་།",
    "དྲོས་ཇ་ལ་ཉེ་དུས་ཁོ་ཕྱི་རོལ་གྱི་ཚོང་ཁང་ནང་དུ་འགྲོ་དགོས་པས་ངེད་གཉིས་རང་རང་སར་གྱེས་པ་ཡིན།",
    "ད་དུང་སྡུག་དེ་ལས་ལྷག་པ་མྱོང་དགོས་པར་འདུག་ཟེར།",
    "གང་བྱུང་དུ་མི་སེམས་ལ་སྡུག་འཇོག་དོན་མི་འདུག་པས་ཟེར།",
    "ཁོའི་གདོང་ལ་དཔོག་པར་དཀའ་བའི་འཛུམ་མདངས་ཤིག་ཤར་འདུག་པ་དེ་ནི།",
    "འདུག་ཀྱང་།",
    "གཡས་གཡོན་གྱི་མི་ཚང་མས་ངེད་གཉིས་ལ་བལྟས་འདུག་པར་སྙམ་ནས་ང་ནི་ཅུང་མི་བདེ་བར་གྱུར།",
