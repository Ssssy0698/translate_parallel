    "ལོ་དེ་ངས་ད་དུང་ཡང་བརྗེད་ཀྱིན་མི་འདུག་ཟེར།",
    "ཁོ་མཚེར་ཤུལ་དུ་ཡོང་ནས་ཉལ་འདུག་ལ།",
    "ཕྱི་ཉིན་ནམ་ལངས་དུས་སུ་ཁྱིམ་ཚང་གཞན་འགའ་ཡི་ལུག་ཁྱུ་སྤྱང་ཀིས་དེད་དེ་ལམ་བར་ཀུན་ཏུ་བསད་རྨས་བྱས་པའི་ཐེད་ཀྱིས་གང་འདུག་ཟེར་དུས་ཀྱང་།",
    "དེ་འདྲའི་མྱ་ངན་ཆེན་པོ་བྱེད་དགོས་དོན་མི་འདུག་ཨང་།",
    "ཁོ་གཉིས་ཀྱི་ཤུལ་འཛིན་མཁན་ང་རང་ཡིན་དགོས་པར་གཏུགས་ཡོད།",
    "དེ་བཟང་བར་འདུག་ཟེར།",
    "དེ་ལོས་ཡིན་ཨང་།",
    "ཉལ་བའི་དུས་ནས་ཡང་བསྐྱར་ཁ་བརྡ་མི་བྱེད་པར་རང་རང་སར་ཁུ་སིམ་མེར་འདུག་ངའི་བསམ་བློ་གཏོང་བ་ནི་མིག་སྔར་ཁོ་ཁེར་རྐྱང་ངང་འདི་ལྟར་རྒས་པའི་ངང་ཚུལ་ཡིན་ཏེ།",
    "ཡིན་ན་ཡང་ཁོས་སྔ་གཞུག་ཀུན་ཏུ་ཁ་མི་གྲག་པར་ཁུ་སིམ་མེར་འདུག་ན་ཡང་།",
    "ཁོས་སླར་ཡང་ཁྱི་གུ་ཆུང་ཆུང་ཞིག་གསོས་འདུག་ཁྱི་གུ་དེ་ནི་ལུས་སྨད་ནག་ཅིང་ལག་པ་དང་དཔུང་སྟོད་དུ་དཀར་ཐིག་མང་པོ་ཡོད་པ་ཞིག་ཡིན་པས།",
    "སྟག་འབུམ་རྒྱལ་གྱི་སྒྲུང་འབྲིང་ཕྱོགས་བསྒྲིགས་ངའི་མིག་ལམ་དུ་ཁྱི་གུ་ཡོངས་རྫོགས་ཀྱི་སྤུ་གྲའི་ཁ་དོག་མི་གཅིག་པ་མ་གཏོགས་ཚང་མ་གཅིག་མཚུངས་ཡིན་པར་འདུག་འོན་ཀྱང་ཁོའི་ཡིད་ཀྱི་མགུ་ཁེངས་ཏེ་ཡོད་པའི་སྐབས་འདིར།",
    "ཁོ་རང་ཐེངས་སྔོན་མར་ང་ཡོང་དུས་དང་བསྡུར་ན་ལུས་ཤུགས་རྒྱས་ཏེ་ལོ་འགས་ཇེ་ཆུང་དུ་གྱུར་བ་དང་མཚུངས་ཏེ།",
    "ཁོས་དེ་མུར་ཁྲེལ་དགོད་ཅིག་བྱས་ཏེ་དེར་མི་ཤེས་རྒྱུ་འདུག་གམ།",
    "དེ་ལས་མ་ཉན་པར་བསྡད་ན་ད་དུང་དེ་བཟང་བར་འདུག་ཟེར།",
    "ཅུང་དོགས་མི་བདེ་བར་གྱུར་ཏེ་དེ་དག་དང་བསྡུར་ན་ཁ་ཤགས་ལ་ངོ་མ་ཉན་རྒྱུ་འདུག་ཕུར་བ་དང་རིན་ཆེན།",
    "ཆེས་གལ་ཆེ་བ་ནི་ཕ་རོལ་བོས་རང་སེམས་ཀྱི་མྱ་ངན་ལ་རྒྱུས་ལོན་བྱེད་རྒྱུ་དེ་ཡིན་པར་འདུག་ཁྱི་གུ་ནི་གང་ལྟར་ཡང་སེམས་ལྡན་ཞིག་ཡིན་པའི་ཆ་ནས།",
    "ཁོས་མེས་པོའི་རྣམ་འགྱུར་ལས་ཁོའི་སེམས་ཀྱི་གཏིང་རིམ་ན་བསྐྱངས་པའི་སྐྱོ་གདུང་མང་བོ་ཞིག་རྒྱུས་ལོན་བྱེད་ཀྱིན་ཡོད་ཚོད་འདུག་ཅིང་།",
    "ཕྱི་རྒྱལ་ཡིན་ནའང་དེ་འདྲ་ལོས་ཡིན།",
    "རྗེས་ཕྱོགས་སུ་བློ་ངོར་འཚམ་པའི་བྱ་བ་ཞིག་ལག་སོན་བྱུང་ཚེ་གཉེན་སྒྲིག་བྱས་ནའང་འཕྱི་མི་འདུག་ཅེས་གཡུ་དྲུག་དཀར་དཔེ་ཚོགས།",
    "དེའི་རྐྱེན་གྱིས་ངས་སླར་ཡང་རང་ཉིད་ཀྱི་ད་ལྟ་དང་མ་འོངས་པའི་གནས་བབ་ལ་བསམ་བློ་བཏང་བ་ཡིན།",
    "ཁོས་བསམ་གཞིགས་གཏོང་དུས་དཔྲལ་བའི་གཉེར་རིས་དེ་སྟུག་པོར་བསྡུས་འདུག་པས།",
    "ཡིན་ནའང་ད་ཐེངས་ཀྱི་དོན་འདིར་ཁོ་ལ་གནས་ལུགས་ངེས་ཅན་ཞིག་འདུག་པར་མ་ཟད།",
    "ཁོའི་ངོ་གདོང་གནག་སྟེ་ངའི་རྣམ་འགྱུར་ལ་རྟོག་བཞིན་ཁྱི་གུ་ཞིག་གསོ་ཁོམ་ཡང་མི་འདུག་གམ་ཞེས་བསྐྱར་འདྲི་བྱས་བྱུང་།",
    "ངེས་པར་དུ་ཕྱིར་ཁྱིམ་དུ་ཡོང་སྟེ་ཁྱི་ལ་ལྟོ་ལྡུད་དགོས་ཀྱིན་འདུག་པས།",
    "ཁོ་བརྒྱུགས་ནས་མི་དེའི་གྱོན་གོས་ལ་རྨུགས་ཏེ་ཧྲལ་བར་བྱས་འདུག་ཟེར།",
    "ང་དང་ཆུང་མ་གཉིས་ཀྱིས་ཀྱང་དེ་ཆུང་མ་ཆུང་སྐྲག་པ་ལྟར་གྱུར་ཏེ་ཨ་ཙི་ཙི།",
    "ལ་མི་མཐུན་པའི་སྐད་ཆ་སྨྲ་དགོས་མི་འདུག་འགྲུལ་བ་རྨས་མ་བྱུང་ངམ་ཟེར།",
    "ཁྱི་གུ་ཁྲ་བོ་འཚར་སྐྱེད་བྱུང་བ་དེས་ཁོ་ལ་གཞན་གྱིས་ཚབ་བྱེད་མི་ཐུབ་པའི་སྤྲོ་སྣང་བསྐྱེད་འདུག་པས།",
    "ད་ནི་སྔོན་ཆད་ལྟར་རང་ཉིད་གཅིག་པུ་འགྲོ་ཐབས་འདུག་ཐབས་བྱེད་མི་ཆོག་པས་ཧུར་བརྩོན་བྱེད་དགོས་ཟེར།",
    "ཨ་བྲ་སོགས་སྲོག་ཆགས་ཆེ་ཆུང་དུ་མའི་བེམ་པོ་ཐང་མར་བརྡལ་བ་ལྟར་རྩྭ་རའི་ནང་ཀུན་ཏུ་མཐོང་རྒྱུ་འདུགསྐབས་འདིར་དོམ་བུ་ནི་ཁྱི་རྒན་ལོ་ལོན་ཞིག་ཏུ་གྱུར་ཡོད་ཀྱང་།",
    "ཁོའི་སྤྱོད་སྟངས་དེ་ལ་སྤོ་བོས་ནི་ཧ་ཅང་རྒྱུས་ལོན་བྱེད་ཀྱིན་འདུག་ཅིང་།",
    "མཐོང་བའི་དུས་སུ་དོམ་བུ་ཡང་ཉེ་སར་བཅར་འདུག་པར་བརྟེན་ཕར་ལ་བྲོས་ཙམ་བྱས་ཀྱང་།",
    "རྨ་ཤུལ་ཅི་ཡང་བཏོད་མི་འདུག་ཀྱང་ལུས་ཀྱི་ལྭ་བ་ཡོངས་རྫོགས་ཧྲལ་ཧྲུལ་དུ་ཚལ་བར་གཤགས་ཡོད་པས།",
    "ངོ་མ་ཁྱི་ཚོགས་ཀྱི་ནང་དུ་ལྷུང་བ་ཞེས་པའི་སྣང་བརྙན་དེ་མིག་ལམ་དུ་མངོན་འདུག་རྒྱ་མི་དེ་དང་ཐོག་སྐྲག་ཐག་ཆོད་དེ་ཤི་བ་ལྟར་ཉལ་ནས་མ་འགུལ་བར་འདུག་ན་ཡང་།",
    "རྒྱུན་ལྡན་མིན་པ་ཞིག་ཏུ་གྱུར་འདུག་པས་གསབ་དངུལ་མང་པོ་སྟེར་དགོས་ཟེར་ཞིང་།",
    "ཉིན་གཉིས་ཙམ་འགོར་ཏེ་ཚང་མས་མཉམ་འཇོག་དུས་སུ།",
    "ཁོའི་ལྟོ་བའི་ཐོག་ཏུ་མེ་མདའ་གཉིས་ཕོག་འདུག་པ་ཚོར་ཞིང་།",
    "བྲོ་སྐྱེལ་བ་དེ་ཁོ་ཚོའི་འགན་ཁུར་ཞིག་ཏུ་བསམ་འདུག་པས།",
    "འོན་ཀྱང་ཁོང་ཚང་ལ་ཕུ་བོ་གཉིས་ཀར་མནའ་མ་བླངས་འདུག་པས་ཁོ་ཚོར་འགན་ཁུར་ཅི་ཡང་མེད་དམ།",
    "བསམ་ཚུལ་དེར་མེས་པོ་གཏན་ནས་ཡིད་འཐད་ཀྱིན་མི་འདུག་ཁོའི་ལྟ་ཚུལ་ལྟར་ན།",
    "དེ་ནི་ཁྱིམ་རྒྱུད་འདི་ལ་འགན་མ་ཁུར་བའི་ཉེས་སྐྱོན་ཞིག་ཏུ་བགྲང་བཞིན་འདུགབྱིས་པ་ཆེ་བ་བཙས་ནས་ཟླ་གཅིག་ལོངས་སྐབས།",
    "དེ་གར་ཞག་སྡོད་བྱས་ན་བུ་ཆུང་ལ་ཆམ་པ་ཕོག་ཉེན་འདུག་པས།",
    "ད་དུང་ཡང་གཅིག་བཙའ་རྒྱུ་ལོས་ཡིན་ཞེས་དྲིས་བྱུང་།",
    "འོན་ཀྱང་མཇུག་མཐར་བཙའ་བའི་ཚེ་ན་སྔར་བཞིན་བུ་ཞིག་ཡིན་འདུག་པས།",
    "སྟག་མཆོངས་པ་ལྟར་ནར་སོན་གྱིན་འདུག་པར་ལྟོས་དང་།",
    "ལུས་སྟོད་ལྟག་རྒྱབ་ཏུ་བསྙེས་ཏེ་སྐྱུར་ཞོག་སེམས་ནས་ཟ་ན་འདོད་ཀྱང་ལྟོ་བས་མི་འཇུ་བར་འདུག་ཟེར།",
    "ང་རང་ཉིད་ཀྱིས་ཀྱང་ལན་གདབ་དཀའ་བའམ་ལན་གདབ་རྒྱུར་ཡིད་སུན་པར་གྱུར་བས།",
    "མི་ཚང་མའི་ངོ་གདོང་གཟབ་ནན་དུ་གྱུར་འདུག་པ་མཐོང་འཕྲལ།",
    "སྐབས་འདིར་ཐོན་དུས་ཁོ་རང་ཉིད་ཀྱང་འཇིག་རྟེན་འདི་རུ་ཡུན་རིང་བོ་སྡོད་ཁོམ་མེད་པར།",
    "ད་ནི་མེས་པོ་དངོས་གནས་རྒས་ཟིན་པར་འདུག་ཁོང་ནི་མུ་མཐུད་དུ་འཇིག་རྟེན་འདིར་དུས་ག་ཙམ་ལ་འདུག་ཁོམ་ཡོད་པའང་མི་རྟོགས་པས།",
    "འགྱུར་གྱིན་འདུག།",
    "དེ་ནས་སླར་ཡང་དངན་པ་ཞིག་འཐེན་རྗེས་གླེང་གཞི་གཞན་ཞིག་ཏུ་བསྒྱུར་བ་ལྟར་ད་ནི་མི་ཡིས་ཅི་ཞིག་ནུས་ཀྱིན་འདུག་ཨང་།",
    "ཐ་ན་སྒོ་ཁའི་ཕྱུགས་ཟོག་སྲུང་མཁན་གྱི་ཁྱི་ལ་ཡང་བདག་ཐུབ་ཀྱིན་མི་འདུག་ཟེར།",
    "ཨ་ལགས་ཀྱིས་ད་ལོ་ནི་ཁོའི་རང་ལོ་ཡིན་པས་ཧ་ཅང་སེམས་ཆུང་བྱེད་དགོས་འདུག་གསུངས་བྱུང་།",
    "གོ་སྐབས་འདིར་བསྟུན་ནས་ས་ལྟ་ཡུལ་ལྟ་ཡིད་ཚིམས་པ་ཞིག་བྱས་ཆོག་འདུག་པས།",
    "སེམས་གཏིང་མེས་པོ་ནི་མི་ཚེ་གང་བོར་རང་ས་ལག་མཐིལ་དུ་སྤྲོ་སྣང་ཞིག་ཀྱང་སྐྱེས་ཀྱིན་འདུག་ཙམ་པོ་འདིའི་ཕན་ལ་གོམ་པ་གང་ཡང་སྤོས་མ་མྱོང་ཡང་།",
    "ང་ཡུལ་དུ་ཐོན་དུས་མེས་པོ་མལ་གྱི་མཐའ་མར་ལྷུང་འདུག་ལ།",
    "ཁོ་ཚོའི་སྟེང་དུ་ཡང་ཕལ་ཆེར་མེས་པོའི་ཆ་ཤས་ཤིག་མངོན་འདུག་པ་ལྟར་སྣང་བས།",
    "བག་ལེབ་རྡོག་པོ་དེར་སྣོམ་ཙམ་ཡང་མི་བྱེད་པར་སླར་ཡང་ཕར་ཙམ་དུ་ཕྱིན་ཏེ།",
    "འདི་ནི་ནམ་ཡང་མིའི་བློ་ངོར་མི་ཤོང་བའི་གསང་བ་ཞིག་ཡིན་འདུག་པས།",
    "མ་བུ་གསུམ་གས་ཁྱི་གུ་ཆུང་ངུ་བསྐོར་ནས་དགོད་ཀྱིན་འདུག་པས།",
    "ལ་སེམས་ཁུར་ཅི་ཡང་མེད་པའི་ངང་རང་སར་བཀྲམ་སྟེ་རྩྭ་ལ་རོལ་གྱིན་འདུག་ཁོ་སླར་ཡང་སྔར་མལ་དུ་སར་ཙོག་ནས་མགོ་བོ་གོང་བའི་ནང་དུ་འཛུལ་ཙམ་བྱས་ཏེ།",
    "ཁོས་ཐེངས་ག་ཙམ་ལ་གླུ་འདི་བསྐྱར་བཟླས་ཀྱིས་བླངས་མྱོང་བ་ཁོ་རང་ཉིད་ཀྱིས་ཀྱང་མི་རྟོགས་ཏེ།",
    "ས་ངོས་ཧྲིལ་བོ་ཁྲག་དམར་གྱིས་བརྫིས་ཏེ་གཤིན་རྗེའི་ཡུལ་དུ་ཐོན་པ་ལྟར་དམར་ཉོག་གེར་འདུག་པ་དང་།",
    "དེ་མ་ཐག་ཏུ་ཤན་གྲི་ཕྱུངས་ནས་གསོད་པའི་ལས་ལ་བྲེལ་གྱིན་འདུག་ད་སོ་མར་གསོད་དུ་འཁྲིད་པའི་ནོར་ལུག་དག་འདར་སིག་སིག་ཏུ་མིག་ནང་དུ་མཆི་ཞགས་འཁྱིལ་ཏེ་སྲོག་བསྡོས་སྒོས་ཕྱིར་འཐེན་པར་བྱེད་ཀྱིན་ཡོད་ཀྱང་།",
    "མིག་མདུན་ན་ཁོ་ཚོའི་རིགས་དུ་མ་གསོད་གཏུབ་བྱེད་ཀྱིན་པའི་རྣམ་པ་སྐྱི་གཡའ་བ་དེ་ལ་ལྟ་བཞིན་དུ་འདར་སིག་སིག་བྱེད་ཀྱིན་འདུག་པས།",
    "ཁོའི་སློག་པའི་ཐུ་བར་མགོ་བོ་གཏོད་ནས་འགུལ་མི་ཕོད་པར་འདར་སིག་སིག་བྱེད་ཀྱིན་འདུག་ལ།",
    "ཁོས་དེ་འཕྲལ་ཚོར་རྟོགས་བྱུང་བ་ལོས་ཡིན་སྙམ་པའི་སྣང་བ་ཞིག་བྱིན་ཡོང་།",
    "སྐད་ཅིག་ལ་ཁོམ་པ་མེད་པར་ཕར་ལྟ་ཚུར་ལྟ་བྱེད་བཞིན་རང་རང་དམིགས་བྱ་གང་ཡིན་པ་དེ་འཚོལ་བར་བྲེལ་གྱིན་འདུག་ཡིན་ན་ཡང་ཁོ་ལ་མཚོན་ན་གཡས་གཡོན་གྱི་ཚོང་རྫས་དག་ནི་རང་ཉིད་དང་འབྲེལ་བ་ཅི་ཡང་མེད་པར་མཁོ་མེད་ཀྱི་ལྷག་མ་ཤ་སྟག་ཏུ་གྱུར་ཡོད་པས།",
    "ཁོའི་སེམས་ལ་ད་ནི་ལུག་གཉིས་ཀ་བཙོང་བ་ལས་ཐབས་མི་འདུག་སྙམ་པ་ན།",
    "ཨ་ཙི།",
    "མགོ་སྐྲ་སིལ་བུར་འཁྱིལ་བར་བྱས་ཏེ་ལྟག་རྒྱབ་ཏུ་འཕྱང་འདུག་པས།",
    "ཚེ་རིང་སྒྲོལ་མས་སྒེར་ཚོང་ཁྲོམ་རའི་རྒྱབ་ཕྱོགས་ཀྱི་ཉིན་ཁར་སྐྲ་བཞར་ཁང་ཞིག་ཉར་འདུག་ཅིང་སྒོ་བྱང་དུ་སྒྲོལ་མའི་སྐྲ་བཞར་ཁང་ཟེར།",
    "སྒྲོལ་མའི་སྐྱེད་ཚལ་སོགས་ཧ་ཅང་མང་བོ་ཐོས་རྒྱུ་འདུག་པ་མ་ཡིན་ནམ།",
    "དེ་བས་སྒྲོལ་མའི་སྐྲ་བཞར་ཁང་ཡང་དེའི་ཁྲོད་ཀྱི་གྲུབ་ཆ་ཞིག་གྱུར་ཟིན་འདུག་པ་སྟེ།",
    "ངོ་མ་མི་ཕོད་པར་འདུག་ཟེར་བཞིན་མགོ་བོ་དུད་པར་གྱུར།",
    "མཉེད་མཉེད་བྱེད་ཀྱིན་འདུག་ཅིང་།",
    "གྱེས་ཁར་ཁོའི་གདོང་ལ་ལྟ་མི་ཕོད་པར་མགོ་བོ་དུད་ཅིང་ངོ་གདོང་དམར་བོར་འགྱུར་ཙམ་ངང་ང་གཅིག་པུ་འདི་གར་སུན་གྱིན་འདུག་པས།",
    "དོན་དག་མང་པོ་ཞིག་དངོས་གནས་དེ་འདྲ་ཞིག་ཡིན་པར་འདུག་སྟེ།",
    "ཧ་ཅང་ཉམ་ཞན་ངང་མགོ་བོ་དུད་ནས་འདར་ཤིག་ཤིག་བྱེད་ཀྱིན་འདུག་པས།",
    "སྒེར་ཚོང་ཁྲོམ་རའི་ཕྱི་ནང་དུ་ཁེ་སྔོན་བཞིན་མེ་ཡི་འདུ་འགོད་ལོང་ལོང་བྱེད་ཀྱིན་འདུག་ཅིང་།",
    "ཚེ་རིང་སྒྲོལ་མས་ཁོ་སྔར་བཞིན་རྒྱབ་ཕྱོགས་ཀྱི་འདུག་སྟེགས་རིང་བོ་དེའི་སྟེང་དུ་སྡོད་དུ་བཅུག་ཅིང་།",
    "དེ་མ་གཏོགས་འགྲུལ་བ་ཞིག་ཡོང་ནའང་འོས་མི་འདུག་པ་འདྲ།",
    "ཁོས་ཀྱང་ལས་རྒྱུ་གཞན་མི་འདུག་པས་མདུན་གྱི་ཇ་ཕོར་བླངས་ནས་ཁམ་འགའ་འཐུང་ཙམ་བྱེད་དགོས་བྱུང་།",
    "ཐད་ཀར་ཁོའི་གདོང་ལ་བལྟས་ཏེ་ཨུ་ཚུགས་ཀྱི་འཛུམ་ཞིག་མངོན་འདུག།",
    "རྒད་པོས་རྣར་མི་འགྲོ་བའི་ཚུལ་གྱིས་སྒོར་བརྒྱད་ནི་ཧ་ཅང་མཐོ་འདུག་ཟེར།",
    "རང་ཉིད་ཀྱང་ཚུར་ཡོང་སྟེ་ཁོའི་གན་དུ་གཏད་ནས་འདུག་སྟེགས་སྟེང་བསྡད་བྱུང་།",
    "དེ་ནས་ཕྱིར་ཁྲིད་ཡོང་སྟེ་སྐྲ་བཞར་སའི་འདུག་སྟེགས་སྟེང་དུ་སྡོད་དུ་བཅུག་ཅིང་།",
    "རྒད་པོ་དེ་ཡང་ཧ་ཅང་སྤྲོ་སྣང་ཅན་ཞིག་ཡིན་འདུག་ཁོས་ཚེ་རིང་སྒྲོལ་མས་བྱང་ཆ་ལྡན་པའི་སྒོ་ནས་སྐྲ་བཞར་བའི་ངང་ཚུལ་ལ་ལྟ་བཞིན་དུ།",
    "ལས་ཀ་འདི་གཉེར་བའི་ལྟག་རྒྱབ་ཏུ་མི་ལ་སྨྲ་མི་ཕོད་པའི་གཏམ་རྒྱུད་བཙོག་པོ་ཞིག་ཅིས་ཀྱང་ཡོད་ངེས་སུ་འདུག་སྙམ་ནས།",
    "མི་མཁོ་དུས་གདོན་རྫས་བྱེད་དུ་གཞུག་དོན་མི་འདུག་སྙམ།",
    "རྒྱང་ནས་བལྟས་ཀྱང་རྒྱ་སྲང་དུ་མི་ཡི་འགྲོ་འོང་དེ་སྔར་བཞིན་མང་པོ་འདུག་པ་མིག་ལམ་དུ་མཐོང་ཐུབ་པས།",
    "ཁོའི་སེམས་ལ་སྔོན་ཆད་བྱུང་མ་མྱོང་བའི་སྟོབས་ཤུགས་ཀྱི་ཚ་རླབས་ཤིག་མཆེད་ཀྱིན་འདུག་ལ།",
    "ཁོས་སེམས་ལ་ངོ་མ་དེ་ལྟར་ཡིན་ཚེ་ཁོ་ཚོར་ཡང་ཁག་མི་འདུག་སྙམ་ཞིང་།",
    "མི་དེ་དག་ཀྱང་རང་ཉིད་དང་གཅིག་འདྲ་ཡིན་པའམ་ཡང་ན་རང་ཉིད་ལས་ཀྱང་ཉམ་ཆུང་ཡིན་པ་ལྟར་སྣང་།",
    "གཡས་གཡོན་གྱི་ཚོང་ཁང་ནི་སྔར་བཞིན་འདུག་པས་ཁང་བ་ནོར་བའང་མ་ཡིན་པས།",
    "དེ་བས་ཁོ་རང་ནམ་རྒྱུན་ལུག་རྫིར་གཅིག་པུར་སྡོད་པའི་སྐབས་སུ་སྣ་གླུ་འདི་བླངས་ནས།",
    "ཚོགས་རར་ཞུགས་པའི་མི་གྲངས་སྟོང་ཕྲག་ལྔ་ལས་བརྒལ་ཡོད་པས་ཞེས་པའི་བར་ནས་བཤགས་འདུག་ཅིང་།",
    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག།",
    "གནས་པ་དང་ཉལ་བ་དང་འདུག་པ་དང་།",
    "ཁྱིམ་གཅིག་ལ་ནི་ཉམ་གནས་པས་མཐའ་དག་དུས་ཀྱི་ཚོགས་དང་ཟླ་བ་དང་ན་ཕྱོགས་རྣམས་བྱེད།"
  ]
}