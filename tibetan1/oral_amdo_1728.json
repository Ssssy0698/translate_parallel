    "འདི་ལྟར་དངོས་གཞིའི་གནས་སུ་ནི་ཉེས་བྱས་སུ་འགྱུར་ལ་ཉེས་པ་སྦོམ་པོའི་གནས་སུ་ནི་ཉེས་བྱས་ཕྲ་མོར་འགྱུར་རོ།",
    "དགེ་སློང་མ་དགེ་ཚུལ་མ་དང་ལྷན་ཅིག་མཚན་མོ་འབྲལ་བ་དང་།",
    "ཉིན་མོ་འབྲལ་བ་དང་།",
    "དེ་བས་ན་དགེ་སློང་མ་དགེ་ཚུལ་མ་དང་ལྷན་ཅིག་མཚན་མོ་འབྲལ་བ་ལ་སོགས་པ་ལ་ནི་འདིར་དངོས་གཞིའི་གནས་སུ་ནི་ཉེས་པ་སྦོམ་པོར་འགྱུར་ལ།",
    "སྦྱོར་བའི་སྦྱོར་བའི་གནས་སུ་ནི་ཉེས་བྱས་ཕྲ་མོར་འགྱུར་རོ།",
    "ཉིན་མོ་འབྲལ་བ་དང་།",
    "ཉིན་མོ་འབྲལ་བ་དང་།",
    "མཚན་མོ་དང་ཉིན་མོའི་དུས་ལ་བརྟེན་པའི་བྱ་བའི་ཁྱད་པར་མཚན་མོ་འབྲལ་བ་དང་།",
    "ཉིན་མོ་འབྲལ་བ་གཉིས་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "མཚན་མོ་དང་ཉིན་མོའི་དུས་ཀྱི་མཐའ་སྐད་ཅིག་མ་ཉིད་དེ་མཐའ་ཉིད་ལ་བྲལ་བ་ལ་སོགས་པའི་བྱ་བ་གང་བྱུང་བ་དེ་ལ་ནི་དངོས་གཞི་ཉིད་དུ་འགྱུར་རོ།",
    "དེ་གང་ལ་ཤེས་ཤེན་དེའི་ཕྱིར་དབྱར་ཁང་དང་བྲལ་བར་གྱུར་ཅིང་གཞན་དུ་མཚན་མོ་སྐྱ་རེངས་འཆར་བར་བྱེད་ནའོ་ཞེས་གསུངས་པ་ལས་ཏེ།",
    "མཚན་མོ་འབྲལ་བ་གཉིས་བསྟན་ཏོ།",
    "ཉི་མ་ནུབ་པའི་མཐའ་ནི་ཉིན་མོའི་མཐའ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "ཉི་མ་ནུབ་ཁར་འཇུག་པའི་མཐའ་ནི་ཉིན་མོའི་མཐའོ།",
    "དེ་ཕན་ཆད་ནི་མཚན་མོར་གཏོགས་པའི་ཁ་ན་མ་ཐོ་བར་འགྱུར་རོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ད་ནི་བཞི་པོ་དག་གི་སོ་སོའི་མཚན་ཉིད་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་བསྐོར་བ་མེད་ན་ནི་དབྱར་ཁང་གི་ཕྱི་རོལ་གྱི་ངོས་དེ་ནས་མཚམས་ཡིན་ནོ།",
    "ཉིན་མོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེའི་ཕྱིར་གྲོང་གི་ཉེན་ཀོར་ལས་འདས་ན་ལམ་དུ་ཞུག་པ་ཡིན་ཏེ།",
    "སྐྱེད་མོས་ཚལ་དང་།",
    "སྐྱེད་མོས་ཚལ་ལ་སོགས་པ་ནི་གྲོང་གི་ཉེན་ཀོར་དང་འབྲེལ་དུ་ཟིན་ཀྱང་དེ་དག་གྲོང་གི་ཉེན་ཀོར་ཉིད་མ་ཡིན་ནོ།",
    "ལག་རྐྱང་དག་གིས་ཕ་རོལ་དུ་ཕྱིན་ནའོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་མ་གཅིག་པུ་ལག་རྐྱལ་དག་གིས་ཆུ་ཀླུང་གི་ཕ་རོལ་དུ་འགྲོ་ན་ཕ་རོལ་དུ་ཕྱིན་པའི་མདུན་རོལ་དུ་ནི་སྤོམ་པོའོ།",
    "རྗེས་སུ་གནང་བའི་བུད་མེད་དེ་ལྟ་བུ་རབ་ཏུ་འབྱིན་ནའོ།",
    "སྦྱོར་བ་གང་གིས་རབ་ཏུ་འབྱིན་ཞེ་ན་དེའི་ཕྱིར།",
    "མཁན་མོ་ཉིད་ཀྱིས་སོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེའི་མཁན་མོ་ཉིད་བྱེད་ན་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "མཁན་མོ་ཁྱད་པར་ཅི་ལྟ་བུ་ཅན་ཞིག་གིས་ཤེ་ན་དེའི་ཕྱིར།",
    "བུད་མེད་འདི་གསད་པའི་ཕྱིར་ཚོགས་པ་ཡིད་མཐུན་པ་དང་པ་དག་པོས་ཡོངས་སུ་བཏང་བ་དང་།",
    "གང་གི་ཚེ་རིགས་བརྒྱུད་ཡོད་པ་ལ་ནི་སྦོམ་པོའོ།",
    "བུད་མེད་རྣམས་ཀྱི་སྒྲུབ་པ་འདི་ལ་ནི་མཐུན་པ་འབྱེད་པར་གྱུར་པ་དང་ལོག་པར་བསྒྲུབ་པ་ཤིན་ཏུ་སྟོབས་ཆེ་བ་དང་ཤིན་ཏུ་སྤྱི་བརྟོལ་ཆེ་བ་ཡིན་པས་དེའི་ཕྱིར་ཆད་པས་གཅོད་པར་བྱེད་པའི་དགེ་འདུ་རྣམ་ཚོགས་པའམ།",
    "དེ་དག་ལ་ཚངས་པར་སྤྱོད་པ་ཉིད་སྤྱོད་དོ་ཞེས་བྱ་བ་ནི་དགེ་སྦྱོང་དང་བྲམ་ཟེ་གཞན་དེ་དག་ལ་ཚངས་པར་སྤྱད་པའི་དངོས་པོ་ཉིད་ནི་ཚངས་པར་སྤྱད་པ་ཉིད་སྤྱད་པ་སྟེ་དེ་དག་གི་དྲུང་དུ་ཚངས་པར་སྤྱད་པ་ཉིད་སྤྱོད་དོ་ཞེས་ཟེར་བར་སྦྱར་རོ།",
    "རྩུབ་མོ་སྨྲ་བ་དང་ཕྱིར་སྨྲ་བའོ།",
    "ཞེ་སྡང་གིས་འགྲོ།",
    "གཏི་མུག་གིས་འགྲོ།",
    "གཞོགས་སྟེགས་དང་ཕྱར་གཡེང་དང་ཙབ་ཧྲལ་གྱི་རྒྱུར་གྱུར་པ་དག་གིས་སོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཕྱར་གཡེང་གི་རྒྱུར་གྱུར་པ་ནི་ཀུན་དུ་རྩེ་བའོ།",
    "དགེ་སློང་མ་དང་ལྷན་ཅིག་ལུས་ཀྱི་རེག་པ་ནི་ཁ་ཅིག་ཏུ་ནི་སྦོམ་པོའོ།",
    "ཞེ་སྡང་གིས་འགྲོ།",
    "གཏི་མུག་གིས་འགྲོ།",
    "དེ་ལ་དང་པོ་བཅུ་ནི་དགེ་སློང་དང་ཐུན་མོང་མ་ཡིན་པས་དགེ་སློང་གི་སོ་སོར་ཐར་བའི་སྡོམ་གྱི་ཚིགས་སུ་བཅད་པ་དང་པོ་ལས།",
    "ཞེས་གསུངས་པའི་རིམ་པ་དགེ་སློང་གི་རྣམ་པར་འབྱེད་པའི་སྐབས་སུ་མཚན་ཉིད་སྔར་ཇི་སྐད་བསྟན་པ་བཞིན་དུ་བལྟ་བར་བྱའོ།",
    "གསེར་དངུལ་ལ་རེག་པ་དང་།",
    "གྱུར་བ་ཞེས་བྱ་བའི་སྒྲ་འདིར་རེ་རེ་དང་སོ་སོར་སྦྱར་ཏེ།",
    "གསེར་དང་དངུལ་ལ་རེག་པ་ལས་གྱུར་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་ལྟ་བུར་སྦྱར་རོ།",
    "ཕོ་ཉིད་ལ་ནི་མོ་ཉིད་དོ།",
    "འཁྲུ་བ་ལ་སོགས་པ་ནི་དགེ་སློང་གིའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "བལ་ནག་པོ་འབའ་ཞིག་གི་སྟན་དང་།",
    "སྤོམ་དགའ་མོ་མཉན་ཡོད་དུ་བསོད་སྙོམས་ལ་ཞུགས་པ་ན་དེས་ལྷ་བོན་མོ་ལྷ་རྟེན་ཐོགས་ཤིང་རྒྱུ་བ་ཞིག་མཐོང་ནས་སྦོམ་དགའ་མོས་བསམས་པ།",
    "དེ་ཉིན་པར་ལྷ་རྟེན་ཐོགས་ཏེ་མཉན་ཡོད་དུ་ཞུགས་ནས་དེ་ཁྱེའུ་དང་བུ་མོ་དག་ལ་སྲུང་སྐྱོབ་བྱེད་ཅིང་དེས་གང་དང་གང་ལ་བསྲུང་བསྐྱབ་བྱས་པ་དེ་དང་དེ་དག་བདེ་བར་གནས་པར་གྱུར་ནས།",
    "དེའི་ཚེ་གང་དང་གང་དག་ལ་བསྲུང་བསྐྱབ་བྱ་དགོས་པར་འགྱུར་བ་དེ་དག་ཐམས་ཅད་ཀྱིས་སྤོམ་དགའ་མོ་སྲུང་སྐྱོབ་བྱེད་དུ་འཇུག་པར་བྱེད་ནས་ལྷ་བོན་མོ་འཕྱ་བར་གྱུར་པ་ནས།",
    "བུད་མེད་རྣམས་ནི་ཡོ་བྱད་ལ་ལྷག་པར་ཆགས་པ་ཤིན་ཏུ་དམ་པས་ན་དེའི་ཕྱིར་ཞག་གཅིག་ལས་འདས་པར་འཆང་བ་ལ་ཁ་ན་མ་ཐོ་བ་འདི་རྣམ་པར་གཞག་གོ།",
    "ཉི་མ་དང་པོ་དེ་ཉིད་ལ་བྱིན་གྱིས་མ་བརླབས་ན་ཞག་གཅིག་གི་སྐྱ་རེངས་དང་པོ་ཤར་ན་སྤང་བར་འགྱུར་རོ།",
    "ཟླ་བ་ཕྱེད་ཕྱེད་ཅིང་བྱིན་གྱིས་མ་བརླབས་ན་ཞག་བཅུ་དྲུག་གི་སྐྱ་རེངས་དང་པོ་ཤར་ན་སྤང་བར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་འདིར་ཚིག་གི་དོན་འདི་འབྱུང་སྟེ།",
    "བྱན་གྱིས་མ་བརླབས་ན་ཞག་གཅིག་གི་སྐྱ་རེངས་དང་པོ་ཤར་ན་སྤང་བར་འགྱུར་རོ།",
    "དེར་བྱིན་གྱིས་མ་བརླབས་ན་ཞག་བཅུ་དྲུག་པའི་སྐྱ་རེངས་དང་པོ་ཤར་ན་སྤང་བར་འགྱུར་རོ།",
    "མདུན་རོལ་དུ་བྱིན་གྱིས་བརླབས་པ་ལ་ནི་ཉེས་པ་མེད་པས་ཟླ་བ་ཕྱེད་ཕྱེད་ཀྱི་གསོ་སྦྱོང་གི་དུས་སུ་བྱིན་གྱིས་བརླབས་ན་ཕྱིན་ཆད་འཁྲུལ་པ་མེད་པར་འོང་ངོ།",
    "གང་ལ་སྲ་བརྐྱང་འབྱིན་པའི་སྤང་བར་འགྱུར་ཞེ་ན་དེའི་ཕྱིར་ད་ཕྱིད་ཟླ་ར་བ་ཉའི་ཉིན་མོའི་མདུན་རོལ་དུ་སྲ་བརྐྱང་འབྱིན་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "སྲ་བརྐྱང་གི་རྙེད་པ་དེ་ཡང་མ་བགོས་པའི་གནས་སྐབས་ཁོ་ན་སྤང་བར་བྱ་བ་ཉིད་ཡིན་གྱི་བགོས་བ་ལ་ནི་སྤང་བར་བྱ་བ་ཉིད་མེད་དེ།",
    "འདི་ལྟར་རྙེད་པའི་དངོས་པོ་གང་ཟག་གིར་གྱུར་བའི་ཕྱིར་ཏེ་དེའི་ཚེ་ནི།",
    "དུས་ཀྱི་བྱེ་བྲག་གིས་དེ་གཉིས་ཀྱི་ཡུལ་ལ་བྱེ་བྲག་ཡོད་དེ།",
    "གསེར་དངུལ་ལ་རེག་པ་དང་མངོན་མཚན་ཅན་གྱི་སྤྱོད་པ་དང་ཉོ་ཚོང་བྱེད་པའི་སྤང་བ་གསུམ་ལ་ནི་སློང་བ་སྔོན་དུ་བཏང་བ་མེད་པས་དེའི་ཕྱིར་ཐ་དད་པར་རྣམ་པར་གཞག་གོ།",
    "དབྱར་ཁང་རྒྱུ་ཟ་བ་ལས་གྱུར་པའི་སྤང་བར་འགྱུར་ཞེ་ན་དེའི་ཕྱིར་གོ་རིམས་བཞིན་དུ་གོས་དང་མལ་ཆ་དང་དབྱར་ཁང་གི་ཆེད་དུ་ཡང་ངོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དབྱར་ཁང་གི་ཆེད་དུ་ཡོ་བྱད་གང་ཡང་རུང་བ་རྙེད་པ་ཟས་སུ་བྱས་ཏེ་བཟའ་བའི་ཕྱིར་འཇོག་པ་ནི་དབྱར་ཁང་རྒྱུ་ཟ་བ་ལས་གྱུར་བའི་སྤང་བར་འགྱུར་རོ།",
    "དགེ་སློང་གི་ཕྱིར་དང་རབ་ཏུ་བྱུང་བ་འདི་པ་བསྙེན་པར་མ་རྫོགས་པའི་ཕྱིར་དང་།",
    "དགེ་སློང་གི་ཕྱིར་བསྔོས་པ་ལ་སོགས་པ་ལ་ནི་འདིར་ཡང་སྔ་མ་བཞིན་དུ་ཉེས་བྱས་སུ་རིག་པར་བྱའོ།",
    "སྔར་སྐྱེ་བོ་མང་པོ་ཞེས་སྨོས་པ་ནི་བཞི་ཡན་ཆད་གྲངས་ཆད་པ་ཁ་ཅིག་གི་ཕྱིར་སྦྱོར་དུ་བཅུག་པ་ཡིན་ནོ།",
    "འདིར་གཞུང་ནི་གཙུག་དགའ་མོས་སྤོས་འཚོང་གི་ཁྱེའུ་ལ་ཆགས་ནས་དེས་དེ་ཚིག་ཉན་དུ་གཞུག་པའི་ཕྱིར་དེ་ལས་རྫས་ཉོ་ཞིང་ཐུམ་བུ་བཅིངས་ཤིང་བཅིངས་ཤིང་ཡང་དང་ཡང་འགྲོལ་དུ་བཅུག་གོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདིར་ཐུམ་བུ་ཞེས་སྨོས་པས་ནི་ནང་གི་སྙིམ་པ་ལ་སོགས་པ་དང་།",
    "ཕྱི་རོལ་གྱི་སྤྲོག་མ་ལ་སོགས་པ་དག་གི་དཔེ་ཡིན་ནོ།",
    "སྲང་བརྒྱ་པ་ལ་སོགས་པ་དང་ཀཱཪྵཱ་པ་ཎ་ཉི་ཤུ་ལ་སོགས་པ་རི་བའི་གོས་བདག་གིར་བྱེད་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ལྗིད་ཀྱིས་ལྕི་བ་དང་རིན་ཐང་གིས་ལྕི་བ་སྟེ།",
    "རིན་ཐང་གིས་ལྕི་བ་ནི་ཀཱཪྵཱ་པ་ཎ་ཉི་ཤུ་ལ་སོགས་པ་རི་བ་སྟེ།",
    "འཆང་བར་བྱེད་ན་ཞེས་བྱ་བའི་རྣམ་པར་འབྱེད་པ་ནི་བདག་གིར་བྱེད་ན་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་བདག་གིར་བྱེད་པ་ལས་ཀྱང་དངོས་གཞིར་འགྱུར་ན་གྱོན་པ་ལྟ་ལ་སྨོས་ཀྱང་ཅི་དགོས་ཏེ་གྱོན་པའི་རྩ་བ་བཅས་པའི་ཕྱིར་བདག་གིར་བྱེད་པ་ཡང་དགག་པ་མཛད་དོ།",
    "བཙོང་བ་ལ་སོགས་པའི་ཕྱིར་བདག་གིར་བྱེད་པ་ནི་ཐམས་ཅད་དུ་སྤང་བར་འགྱུར་རོ།",
    "རིན་ཐང་གི་སོགས་པའི་སྒྲས་ནི་སྔ་མ་བཞིན་དུ་མང་པོ་དག་བསྡུའོ།",
    "འདིར་རིན་ཐང་གིས་ཡང་བར་ནི་མི་སྦྱར་ཏེ།",
    "འདི་ལྟ་སྟེ་བུད་མེད་ནི་གོས་བཟང་པོ་གྱོན་ན་གསོ་རོ་སྐྱེ་བས་དེའི་ཕྱིར་གོས་འདི་གཉིས་བཀག་པ་ཡིན་ནོ།",
    "དེ་དག་གི་མཚན་ཉིད་ནི་སྔར་བསྟན་ཟིན་ཏོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དགེ་སློང་གི་གོས་དགེ་སློང་མས་བྱེད་པ་ལ་ཚུལ་དང་མི་མཐུན་པ་མཚར་པོ་ཆེ་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་དགེ་སློང་མ་བུད་མེད་དང་ལྷན་ཅིག་འདུག་པ་དང་དགེ་སློང་མ་དང་ལྷན་ཅིག་འགྲེང་བ་ལ་ཉེས་པ་ཅི་ཡང་མེད་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་སྐྱེས་པས་སྦྱོར་དུ་བཅུག་པ་བུད་མེད་ཟ་བ་ལ་སྨད་པ་མེད་པའི་ཕྱིར་རོ།",
    "ཐལ་མོས་བརྡེག་པ་དང་།",
    "དགེ་སློང་གིས་རབ་ཏུ་བྱུང་བ་མོའི་ཕྱིར་ཟང་ཟིང་ཉེ་བར་བསྒྲུབ་ཏུ་རུང་སྟེ་ཆུང་མར་གྱུར་པ་ཉིད་ལ་ཡང་ངོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་གི་རབ་ཏུ་བྱུང་བ་དགེ་སློང་མ་ལ་ཟང་ཟིང་ཉེ་བར་བསྒྲུབ་ཏུ་རུང་ངོ།",
    "དེ་ལ་ཡང་དགེ་སློང་གིས་ཟང་ཟིང་ཉེ་བར་བསྒྲུབ་ཏུ་རུང་ངོ།",
    "ཡང་ངོ་ཞེས་བྱ་བའི་སྒྲས་ནི་མ་དང་སྲིང་མོ་ལ་སོགས་པ་དག་ལྟ་ལ་སྨོས་ཀྱང་ཅི་དགོས་ཞེས་བྱ་བར་སྟོན་ཏོ།",
    "དགེ་སློང་གིས་སྔོན་ཆུང་མར་སྤྱད་པ་ཉིད་དགེ་སློང་མར་གྱུར་པ་ཡིན་ན་རབ་ཏུ་བྱུང་བ་དེ་ལ་ཡང་ཟང་ཟིང་ཉེ་བར་བསྒྲུབ་ཏུ་རུང་བ་ཁོ་ན་ཡིན་ཏེ།",
    "དགེ་སློང་གིས་དེ་ལ་ཉེ་བར་བསྒྲུབ་ཏུ་རུང་ངོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ།",
    "དགེ་སློང་མས་རང་གི་བུ་དེ་དང་མཚན་མོ་ལྷན་ཅིག་ཉལ་བར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དགེ་སློང་མ་གང་གིས་བུ་ཆུང་དུ་དང་ལྷན་ཅིག་ཉལ་བའི་གནང་བ་ཐོབ་པར་གྱུར་བ་དེ་ལ་མ་གཏོགས་པ་ཉིད་མ་ཡིན་ནོ།",
    "དེ་ལ་དང་པོ་རེ་ཞིག་དེ་དག་ཐམས་ཅད་ཡུལ་གྱི་དབྱེ་བར་རྣམ་པར་གཞག་པར་བསྟན་པར་བྱ་སྟེ།",
    "བྲོ་བརྡུང་བ་ལ་སོགས་པ་ནི་རྩེད་མོ་ལས་གྱུར་པ་ཡིན་ནོ།",
    "གང་གིས་ཤེ་ན་དེའི་ཕྱིར་བདག་ཉིད་རྫོགས་པར་བསྙེན་པས་སོ་ཞེས་བྱ་བ་སྨྲས་སོ།",
    "དེ་ལྟར་ན་འདིར་ཚིག་གི་དོན་འདི་འབྱུང་སྟེ།",
    "དགེ་སློང་མ་གང་གིས་འཁོར་དང་འཁོར་མང་པོ་ཉེ་བར་འཇོག་པར་ཡང་ནུས་ལ་རྫོགས་པར་བསྙེན་ནས་ལོ་བཅུ་གཉིས་ལོན་པ་ཉིད་ཀྱང་ཡིན་ན་དེ་ལ་གནང་བ་སྦྱིན་པར་བྱའོ།",
    "དགེ་སློང་མ་གང་གིས་སྔར་འཁོར་ཉེ་བར་གཞག་པའི་གནང་བ་མ་ཐོབ་པ་དེ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་འདིར་ཚིག་གི་དོན་འདི་འབྱུང་སྟེ།",
    "བསླབ་པ་མ་བྱིན་པ་གཉིས་མཁན་མོ་ཉིད་ཀྱིས་སོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "མཁན་མོ་ཉིད་ཀྱིས་རྫོགས་པར་བསྙེན་པར་བྱེད་པ་ལའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "གལ་ཏེ་ཁོ་མོ་ལ་གོས་སྦྱིན་པ་ལྟ་ན་དེའི་ཕྱིར་ཁྱོད་རྫོགས་པར་བསྙེན་པར་བྱའོ་ཞེས་རྫོགས་པར་བསྙེན་པར་འདོད་པ་ལ་ཟེར་བ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "སྡོམ་པ་གཞན་བླངས་པའི་ཕྱིར་སྒྲུབ་པར་བྱེད་པ་ལ་གལ་ཏེ་ཁོ་མོ་ལ་གོས་ལ་སོགས་པ་སྦྱིན་པ་ལྟ་ན་དེའི་ཕྱིར་ཁྱོད་རབ་ཏུ་དབྱུང་བར་བྱའོ་ཞེ་འམ།",
    "བསླབ་པའི་གཞི་འདི་ནི་གོ་ཏ་མ་སྐེམ་མོས་ཕྱུག་པོའི་ཡུགས་ས་མོ་མྱ་ངན་གྱི་ཟུག་རྡུས་གཟིར་བ་ཞིག་ལ་ཁྱོད་ཅིའི་ཕྱིར་རབ་ཏུ་མི་འབྱུང་ཞེས་སྨྲས་པ་དང་།",
    "དེའི་ཕྱིར་འཁྲུལ་པ་མོའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "མཁན་མོ་ཉིད་ཀྱིས་རབ་ཏུ་འབྱིན་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "མཁན་མོ་ཉིད་ཀྱིས་རབ་ཏུ་འབྱིན་ཕ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "མཁན་མོ་ཉིད་ཀྱིས་རབ་ཏུ་འབྱིན་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "མཁན་མོ་ཉིད་ཀྱིས་རབ་ཏུ་འབྱིན་པ་ལ་ཁ་ན་མཐོ་བ་འདིར་འགྱུར་རོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "བསྟན་པ་ལ་བུད་མེད་ཙ་བཀྲོལ་ཅན་གཞུག་པ་ནི་ཤིན་ཏུ་ཚུལ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "མཁན་མོ་ཉིད་ཀྱིས་རབ་ཏུ་ཕྱུང་བ་དང་།",
    "རྫོགས་པར་བསྙེན་པར་བྱས་པ་དག་ལ་བདག་པོ་ལ་སོགས་པ་དག་གི་བར་ཆད་དུ་འགྱུར་བ་མཐོང་ན་བར་ཆད་ཀྱི་གནས་དེ་ལས་བར་ཆད་མེད་པའི་གནས་སུ་མི་འདྲེན་ཏམ།",
    "མཁན་མོ་ཉིད་ཀྱིས་རབ་ཏུ་ཕྱུང་བ་དང་རྫོགས་པར་བསྙེན་པར་བྱས་པ་དག་ལ་དགེ་སློང་མའི་བསླབ་པ་མི་སློབ་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "མཁན་མོ་ཉིད་ཀྱིས་རབ་ཏུ་བྱུང་བ་དང་།",
    "རང་གིས་བསྟེན་པར་བྱ་བའི་ནང་དུ་རྒྱ་སྐྱེགས་ཀྱི་ཆང་བུ་འཇུག་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "རང་གིས་ཞེས་བྱ་བ་ནི་རང་གིས་འཇུད་པ་ལ་བྱའི།",
    "དེ་རང་གིས་རང་གི་མོ་མཚན་གྱི་ནང་དུ་འཇུག་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "འདིར་རྒྱ་སྐྱེགས་ཀྱི་ཆང་བུ་ཞེས་སྨོས་པ་ནི་རྫས་འཇམ་པོ་ཧ་ཅང་མི་ཕྲ་བ་གཞན་དག་གི་དཔེ་ཡིན་ནོ།",
    "མི་འཇམ་པ་དང་ཧ་ཅང་ཕྲ་མོ་ཉིད་ལ་ནི་དངོས་གཞིའི་མཐའི་ཉེས་བྱས་སོ།",
    "འདི་དག་ཀྱང་འདི་ལྟ་བུ་དང་མཐུན་པ་གཞན་དག་གི་དཔེ་ཡིན་ནོ།",
    "རེག་པ་བདག་གིར་བྱེད་དོ་ཞེས་ཟེར་བ་ལས་བསྡུས་པ་ཡིན་ནོ།",
    "དེ་དག་དང་གཞན་ཡང་སྐེ་རགས་དང་ལོག་ཏོ་ལ་སོགས་པའི་རྫས་གང་གིས་འཆིར་ན་ཡང་ཁ་ན་མ་ཐོ་བ་འདྲའོ།",
    "སོར་མོའི་ཚིགས་གཉིས་ལས་ལྷག་པས་མོ་མཚན་གྱི་ནང་འཁྲུ་བ་ལོའི་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "སོར་མོ་རྣམས་ཀྱི་ཚོགས་གཉིས་ཀྱི་ཚད་གང་ཡིན་པ་དེ་ལས་ལྷག་པས་མོ་མཚན་གྱི་ནང་འཁྲུ་བར་བྱེད་ན་དེ་ལ་འདོད་པ་བསྟེན་པ་ལྟར་བཅོས་པའི་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "འདིར་ཡང་རང་གིས་ཞེས་བྱ་བར་སྦྱར་ཏེ་གཞན་བྱེད་དུ་བཅུག་པ་ལ་ནི་མི་ཚངས་པར་སྤྱོད་པར་གཏོགས་པའི་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "དེ་ལ་ལག་མཐིལ་གྱི་ཐལ་ལྕག་གིས་བསྣུན་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "མོ་མཚན་དེ་ལ་ལག་མཐིལ་གྱི་ཐལ་ལྕག་གིས་བསྣུན་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་ཏེ།",
    "མོ་མཚན་དེ་ལ་རྨོངས་ཀྱི་སྤུ་འཐོག་ཅིང་བྲེག་བ་རང་གིས་བྱེད་དམ་གཞན་བྱེད་དུ་འཇུག་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "འདིར་རེག་པའི་ཁ་ན་མ་ཐོ་བ་ནི་རྣམ་པར་མི་གཞག་སྟེ།",
    "དེ་ལ་སྐྱེས་པས་རེག་ན་ནི་ཕམ་པར་འགྱུར་ལ།",
    "གལ་ཏེ་བུད་མེད་ཀྱིས་རིག་ན་ནི་སྦོམ་པོའོ་ཞེས་ཉེས་པ་སྔར་བསྟན་ཟིན་པའི་ཕྱིར་རོ།",
    "ཐལ་ལྕག་གིས་བསྣུན་པ་དགེ་སློང་ལ་གལ་ཏེ་འདོད་ཆགས་ཀྱིས་བྱེད་ན་ནི་སྦོམ་པོའོ།",
    "དགེ་སློང་མས་སྐྱེས་པ་ལ་རེག་པར་བྱ་བ་མ་ཡིན་པ་དེ་དང་།",
    "ལྷན་ཅིག་རེག་པའི་ཚུལ་གྱིས་བསྟེན་པ་གང་ཡིན་པ་དེ་ལས་གྱུར་པའི་ཁ་ན་མ་ཐོ་བ་དེ་དག་ནི།",
    "འདོམ་གང་གི་ནང་ཚུན་ཆད་ན་འདུག་གམ་འགྲེང་ཡང་རུང་སྟེ།",
    "རྩིག་པ་དང་སབ་མ་དང་ཡོལ་བ་དང་ཐིབས་པོ་དང་མུན་པ་དག་གིས་ནི་དེ་ཉིད་འགྲུབ་བོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ལྔ་པོ་དེ་དག་གིས་ནི་དབེན་པ་སྐྱབས་ཡོད་པ་འགྲུབ་བོ།",
    "དགེ་སློང་མས་ཁྱིམ་པའི་རྣ་དྲུང་དུ་མ་རེག་པ་ཙམ་དུ་བསྙེན་ཏེ།",
    "དགེ་སློང་གིའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "འདི་ནི་སྦོམ་དགའ་མོ་ཆགས་པར་གྱུར་པས་སྐྱེས་པ་ལས་རིག་པ་བླངས་ནས་དེའི་ཚིག་ཉན་དུ་གཞུག་པའི་ཕྱིར་ཡང་དང་ཡང་དུ་བཟླས་པ་འཆོལ་བར་བྱེད་པ་དེ་ལས་བཅས་པ་ཡིན་ནོ།",
    "ཉོན་མོངས་པ་ཅན་གྱི་སྒྱུ་ཐབས་ཀྱི་སེམས་ཀྱིས་རང་གི་ལུས་ཀྱི་རྨ་བཅིངས་ཤིང་བཅིངས་ཤིང་སྐྱེས་པ་ལ་འགྲོལ་དུ་འཇུག་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "སྒྱུ་ཐབས་ཀྱིས་བུད་མེད་འགྲོལ་དུ་འཇུག་པ་ལ་ནི་ཉེས་བྱས་སོ།",
    "དེ་ཧ་ཅང་ལྷོད་དོ་ཧ་ཅང་དམ་མོ་ཞེས་ཟེར་ཞིང་ཡང་དང་ཡང་འགྲོལ་དུ་བཅུག་པ་དེ་ལས་བཅས་པ་ཡིན་ནོ།",
    "འདིར་ཁྱེའུ་ཞེས་སྨོས་པ་ནི་བུ་ཚོ་དང་མ་ནིང་དག་གི་དཔེ་ཡིན་ཏེ་ཚུལ་འདྲའོ།",
    "རང་གི་བུ་དེ་ལ་རེག་པ་རྗེས་སུ་གནང་བའི་ཕྱིར་རང་གི་བུ་འཚོ་བ་ལ་ནི་ཉེས་པ་མེད་དོ།",
    "ཁྱིམ་བདག་ལ་མ་དྲིས་པར་ཁྱིམ་གཞན་དུ་མཚན་མོ་འདའ་བར་བྱེད་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "ཕྱུགས་ལྷས་སམ་འདྲོན་ཁང་ལ་སོགས་པ་ལ་ཁྱིམ་གཞན་དུ་མཚན་མོ་ཉལ་ཞིང་འདའ་བར་བྱེད་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "མཚན་མོ་མ་བརྟགས་པར་སྐྱབས་ཡོད་པར་འདའ་བར་བྱེད་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གནས་ཁང་དུ་དགེ་སློང་མ་གཞན་མེད་པར་མཚན་མོ་འདའ་བར་བྱེད་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "མཚན་མོ་གནས་ཁང་དུ་དགེ་སློང་མ་གཞན་མེད་པར་གཅིག་པུ་ཉལ་ཞིང་འདའ་བར་བྱེད་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "འདིར་གཙུག་ལག་གི་རྗེས་སུ་འབྲང་བས་གནས་ཁང་ཞེས་སྨོས་པར་ཟད་ཀྱི་གཡོགས་པའི་ཕྱོགས་གཞན་ལ་ཡང་ཁ་ན་མ་ཐོ་བ་འདྲའོ།",
    "དགེ་སློང་མ་དང་ཁྲི་གཅིག་ལ་ལྷན་ཅིག་རེག་པ་དང་བཅས་ཤིང་མཚན་མོ་ཉལ་བ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དགེ་སློང་མ་དང་ལྷན་ཅིག་ཁྲི་གཅིག་གི་སྟེང་དུ་ཤ་མཐང་རེག་པ་དང་།",
    "བཅས་ཤིང་མཚན་མོ་ཉལ་བར་བྱེད་པ་ལ་ནི་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "རེག་པ་དང་བཅས་ཤིང་ཞེས་བྱ་བ་ནི་རེག་པ་དང་བཅས་བཞིན་དུ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེའི་ཕྱིར་རེག་པ་དང་བཅས་པ་ལ་ཁ་ན་མ་ཐོ་བ་རྫོགས་པར་འགྱུར་ཏེ།",
    "ཇི་ནས་ཀྱང་ལུས་ཀྱི་རེག་པའི་རོ་མྱང་བ་མེད་པར་བྱ་བའི་ཕྱིར་དྲན་པ་ཉེ་བར་གཞག་པ་ལའོ།",
    "ལུས་ཀྱི་རེག་པའི་རོ་མྱོང་བ་མེད་པར་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་གཏུར་བུ་ལ་སོགས་པས་བར་དུ་བཅད་ཟིན་ཀྱང་བརྒྱ་ལ་ལུས་རེག་པར་གྱུར་ན་རེག་པ་དེའི་རོ་མྱང་བ་མེད་པར་བྱེད་པ་སྟེ།",
    "རང་གི་ལུས་ཀྱི་དྲིལ་ཕྱིས་དགེ་སློང་མ་བྱེད་དུ་འཇུག་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "རང་གི་ལུས་ལ་འདག་རྫས་ཀྱིས་དྲི་ལ་ཞིང་ཕྱི་བའི་དྲིལ་ཕྱི་དགེ་སློང་མ་གཞན་བྱེད་དུ་འཇུག་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "རང་གི་ལུས་ཀྱི་དྲིལ་ཕྱི་དགེ་སློང་མ་བྱེད་དུ་འཇུག་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "རང་གི་ལུས་ཀྱི་དྲིལ་ཕྱི་དགེ་ཚུལ་མ་བྱེད་དུ་འཇུག་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "ཁྱིམ་པ་མོའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "རང་གི་ལུས་ཀྱི་དྲིལ་ཕྱི་ཁྱིམ་པ་མོ་བྱེད་དུ་འཇུག་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "རང་གི་ལུས་ཀྱི་དྲིལ་ཕྱི་མུ་སྟེགས་ཅན་མོ་བྱེད་དུ་འཇུག་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "དགེ་སློང་མས་རང་གི་ལུས་ལ་ཆུ་འབའ་ཞིག་གིས་དྲི་མ་བཀྲུ་བཤལ་བྱ་བ་བུད་མེད་གཞན་བྱེད་དུ་འཇུག་པ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "སྔ་མ་ལྔ་ནི་བདག་རྫས་གང་ཡང་རུང་བ་གཞན་དག་གིས་དྲིལ་ཕྱི་བྱེད་དུ་འཇུག་པ་ལས་བཅས་པ་ཡིན་ནོ།",
    "འདི་ནི་ཆུ་འབའ་ཞིག་གིས་བཀྲུ་བཤལ་བྱེད་དུ་འཇུག་པ་ལས་བཅས་པ་ཡིན་ཏེ་བྱེ་བྲག་ནི་དེ་ཡིན་ནོ།",
    "རྫས་དྲི་ཞིམ་པོ་དག་གིས་ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "དགེ་སློང་མས་རང་གི་ལུས་རྫས་དྲི་ཞིམ་པོ་དག་གིས་སྐུད་པ་དེ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "རང་གི་ལུས་སྐུད་པ་ལའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "རང་གིས་བྱེད་པའམ་གཞན་བྱེད་དུ་འཇུག་ན་ཡང་བུད་མེད་སྐུད་དུ་འཇུག་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་གྱི།",
    "དགེ་སློང་ལ་ནི་རྫས་དྲི་ཞིམ་པོས་རང་གི་ལུས་སྐུད་པ་འདི་ཉེས་བྱས་སོ།",
    "བུད་མེད་དང་ལྷན་ཅིག་གོ།",
    "སོ་མངས་དང་སྨྱིག་ཤད་དང་གསུམ་ཞེས་བྱ་བ་དང་སྐྲ་བརྙན་དེ་དག་ཉིད་དེ་དག་གིས་བཅོས་པའི་ཕྱིར་སྐྲ་འཆད་ཅིང་ཐོགས་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "རོལ་མོ་བྱེད་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "པི་ཝང་ལ་སོགས་པའི་རོལ་མོ་རང་གིས་བྱེད་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "བདག་གིར་བྱེད་པ་ཙམ་ལ་ནི་ཉེས་བྱས་སོ།",
    "འདི་ནི་སྦོམ་དགའ་མོ་དགེ་སློང་མ་རྣམས་ལ་སྟོན་པར་བྱེད་ཅིང་དེས་དགེ་སློང་མ་འོངས་ཤིང་ལྷགས་པ་རྣམས་ལ་ཁོ་མོའི་ཕྱིར་ཕྱོགས་ག་གེ་མོ་ཞིག་ཏུ་ཁྲིའུ་ཤོམས་ལ་འདུག་ཏུ་ཆུ་གཤིག་ཅེས་བསྒོ་ཞིང་ཡང་ཕྱོགས་ག་གེ་མོ་ཞིག་དང་གནས་ཁང་གི་ཉེན་ཀོར་དང་ཁྱམས་དང་སྒོ་ཁང་དང་ཡང་ཐོག་དང་ཁང་སྟེང་ངམ་ཆེ་གེ་མོ་ཞིག་ཏུ་ཁྲིའུ་ཁྱེར་ལ་ཁོ་མོ་འདུག་ཏུ་ཆུག་ཤིག་ཅེས་ཟེར་བ་ལས་བཅས་པ་ཡིན་ཏེ།",
    "རྩྭའི་ཆུན་བོ་དང་ཤིང་གི་དུམ་བུ་དང་།",
    "འདི་ནི་སྦོམ་དགའ་མོ་ཁྱིམ་བདག་གི་ཁྱིམ་དག་ཏུ་སོང་སྟེ་ཁྱིམ་བདག་གི་ཆུང་མ་དག་གིས་སྟན་དག་བཤམས་པ་ན་དེ་དེ་ལ་འདུག་སྟེ།",
    "དེས་ཀྱང་སྟན་དག་མ་སྦྲན་པར་གཅིག་བུ་ལངས་ཏེ་སོང་བ་དང་སྟན་དེ་དག་རྐུན་པོ་དག་གིས་ཁྱེར་ནས་ཁྱིམ་མི་དག་གིས་སྟན་བཙལ་ན་མ་རྙེད་དེ་སྦོམ་དགའ་མོ་ལ་འཕགས་མ་སྟན་དག་ཅིར་བགྱིས་ཞེས་དྲིས་བ་དང་།",
    "དེས་སྨྲས་པ་ཇི་ལྟར་ཁྱེད་ཅག་གིས་ཁོ་མོ་ལ་མ་སྦྲན་པར་དོར་བ་བཞིན་དུ་ཁོ་མོ་ཡང་དེ་བཞིན་ནོ་ཞེས་ཟེར་བའི་གཞི་དེ་ལས་བཅས་པ་ཡིན་ནོ།",
    "གང་གི་ཚེ་དངོས་གཞིར་འགྱུར་བའི་སོང་བའི་མཐར་ཐུག་པ་ཡིན་ཞེ་ན་དེའི་ཕྱིར།",
    "ཇི་ལྟར་དགེ་སློང་མའི་ཚོགས་ཀྱི་གོས་བདག་གིར་བྱེད་པས་ནོར་རྣམ་པར་བསྒྲུབས་པར་འགྱུར་བ་དེ་བཞིན་དུ་ཟས་འཚོང་བས་ཀྱང་ནོར་རྣམ་པར་བསྒྲུབས་པའི་ཕྱིར་རོ།",
    "དགེ་སློང་མའི་ཆོགས་ཀྱི་གོས་བདག་གིར་བྱེད་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དགེ་སློང་མ་རྣམས་ཀྱི་གོས་བདག་གིར་བྱེད་པ་ལ་ཁན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "འདི་ནི་དགེ་སློང་མ་སྦོམ་དགའ་མོས་བཙུན་མོ་ཕྲེང་ལྡན་མ་ལ་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་ཅག་ལ་སྨེ་གབ་འཆང་བར་རྗེས་སུ་གནང་ན་བདག་ཅག་ལ་མི་བདོག་གིས་དེ་ཁྱོད་ཀྱིས་སྩལ་བར་རིགས་སོ་ཞེས་སྨྲས་པ་དང་།",
    "དེས་གོས་ཀྱི་སྦྲོག་མ་ཐམས་ཅད་དགེ་སློང་མ་རྣམས་ལ་བྱིན་པ་དེ་སྦོམ་དགའ་མོས་བདག་གིར་བྱས་སོ།",
    "དེ་ནས་དགེ་སློང་མ་རབ་ཏུ་མང་པོ་དག་གིས་སྦོམ་དགའ་མོ་ལ་བསླངས་པ་དང་།",
    "བདག་གིས་བསླངས་ཤིང་བདག་གིས་ཐོབ་པ་ཉིད་བདག་གིར་བྱེད་པ་བྱུང་བའི་ཕྱིར་རོ།",
    "ཆང་གི་ལས་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "མནན་བ་ལ་སོགས་པ་ཆང་གི་ཡོ་བྱད་ཀྱི་ལས་ནི་ཆང་གི་ལས་ཏེ།",
    "ཆང་ཁང་ཞེས་བྱ་བ་སྟོན་པ་གཞན་བྱེད་དུ་ཡང་མི་གཞུག་པ་སྟེ་རང་གིས་བྱེད་པ་ལ་ནི་ཁ་ན་མ་ཐོ་བ་ཆེས་ཤིན་ཏུ་ལྕི་བའི་ཕྱིར་དེ་ཡང་བཀག་པར་རིག་པར་བྱའོ།",
    "རྗེན་པ་ཞེས་བྱ་བ་ནི་སྔར་དགེ་སློང་གིས་བཙོས་པའི་སྐབས་སུ་མི་སྙི་བ་རྣམས་ཀྱི་ནི་སུམ་ཆབ་ངས་པ་ཉིད་ཀྱི་མདུན་རོལ་དུ་དེ་ཉིད་ཡིན་ནོ།",
    "འདི་ནི་སྦོམ་དགའ་མོས་ནང་པར་སྔར་ལངས་ཏེ་བསོད་སྙོམས་བླངས་ནས་རང་གི་ཉེན་ཀོར་དུ་གཞག་སྟེ།",
    "སྨེ་གབ་བཅང་བ་འདི་ནི་ཤམ་ཐབས་ལ་སོགས་པའི་གོས་གྱོན་ཞིང་སྣང་བ་ཁྲག་གིས་མ་རུང་བར་འགྱུར་བ་སྤང་བའི་ཕྱིར་རོ།",
    "བསུ་བེལ་བ་ཞེས་བྱ་བ་ནི་གོས་མ་རུང་བར་གྱུར་པ་དེ་ཁྱིམ་པའམ་རབ་ཏུ་བྱུང་བ་གཞན་དག་གིས་ཚོར་བ་ལ་བྱའོ།",
    "འདི་ནི་དགེ་སློང་མ་རབ་ཏུ་མང་པོ་དག་བུད་མེད་ཁྱིམ་པ་མོ་དག་དང་ལྷན་ཅིག་ཆུ་ཀླུང་གནས་ཅན་གྱི་ནང་དུ་ཁྲུས་བྱེད་ཅིང་དེ་དག་ཁྲུས་བྱེད་པ་ན་བུད་མེད་དག་མཛུབ་མོས་གཏོད་ཅིང་རབ་ཏུ་བྱུང་བ་མེ་ཆེ་གེ་མོ་དག་གི་ནུ་མ་གཉིས་ནི་འདི་འདྲའོ།",
    "ཆེ་གེ་མོ་ཞིག་གི་ལྟོ་བ་ནི་སྦྱར་ཀིའི་འདྲའོ།",
    "ཆེ་གེ་མོ་ཞིག་གི་རྐེད་པ་ནི་སྦོམ་མོ།",
    "ཆེ་གེ་མོ་ཞིག་གི་བརླ་ནི་གླང་པོ་ཆེའི་སྣ་འདྲའོ་ཞེས་ལུས་ཀྱི་ཡན་ལག་དང་གསང་བའི་ཕྱོགས་དག་གི་བརྗོད་པ་རྣམ་པ་མང་པོ་སྙད་འདོགས་པའི་གླེང་གཞི་ལས་བཅས་པ་ཡིན་ནོ།",
    "བཀྲུ་བཤལ་བ་དག་གིས་བླངས་ཏེ།",
    "ཁྱིམ་པའི་གོས་དག་དང་ལྷན་ཅིག་བཀྲུས་པ་ན་དེ་དག་གི་འཕགས་པས་ཁྱིམ་པའི་གོས་དཀར་པོ་དག་མི་གཙང་བས་མ་རུངས་པར་གྱུར་པ་དང་ཁྱིམ་པ་དགའ་བྱ་ཞིང་རབ་ཏུ་བྱུང་བ་དག་ནི་ཉེ་བར་མ་ཞིའོ་ཞེས་ཟེར་བའི་བར་ལས་བཅས་པ་ཡིན་ནོ།",
    "དགེ་སྦྱོང་གི་གོས་ཁྱིམ་པ་ལ་བགོ་བའི་ཕྱིར་སྦྱིན་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དགེ་སྦྱོང་གི་གོས་སྣམ་སྦྱར་དང་བླ་གོས་ལ་སོགས་པ་ཁྱིམ་པ་ལ་བགོ་ཞིང་བསྐོན་པའི་ཕྱིར་སྦྱིན་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "དགེ་སློང་མ་གཞན་དག་གི་བསྔགས་པ་བརྗོད་པ་ན་ལུས་དང་ངག་གི་རྣམ་པར་འགྱུར་བ་མི་མཐུན་པར་གྱུར་པས་སེར་སྣ་བྱེད་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "འདིར་ཁྱིམ་ལ་སོགས་པ་རེ་རེ་ལ་སེར་སྣ་བྱེད་པ་ལའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "འདིར་གླེང་གཞི་ནི་སྦོམ་དགའ་མོས།",
    "དགེ་སློང་མ་གཞན་དག་གི་ཡོན་ཏན་ཡང་དག་པར་བརྗོད་པ་ཐོས་པ་དང་སྨོད་པར་བྱེད་ནས་དེ་ལ་དགེ་སློང་མ་དག་གིས་འཕགས་མ་ཅིའི་ཕྱིར་སྨོད་པར་བྱེད་ཅེས་སྨྲས་པ་དང་།",
    "སྦོམ་དགའ་མོས་སྨྲས་པ།",
    "སྦོམ་དགའ་མོས་དགེ་སློང་མ་གཞན་དག་ལ་ཁྱེད་ཅག་གིས་གང་ནས་བསོད་སྙོམས་བསོད་པ་རྙེད་ཅེས་དྲིས་པ་དང་།",
    "དགེ་སློང་མ་རྣམས་ཀྱིས་ཐམས་ཅད་སྨྲས་པ་ན་སྦོམ་དགའ་མོ་སྨོད་ཅིང་དེ་དག་ཟློག་པར་བྱེད་དེ།",
    "ཁྱིམ་ག་གེ་མོ་ཞིག་ཏུ་ཁྱེད་ཅག་མ་འདོད་ཅིག་ཅེས་བྱ་བའི་བར་དང་སྦོམ་དགའ་མོས་དགེ་སློང་མའི་དབྱར་ཁང་བྱེད་དུ་བཅུག་ན་དེ་ནས་དགེ་སློང་མ་དག་གནས་ཤིང་བག་ཡངས་སུ་རྐང་བ་དག་གིས་འཆག་ཅིང་སྤྱོད་ལ།",
    "གིས་དྲེགས་ཤིང་འཆག་པ་དེ་དག་སུ་ཡིན་ཞེས་ཟེར་ནས་དགེ་སློང་མ་རྣམས་ཀྱིས་ཅི་འཕགས་མ་ཁྱོད་གནས་ལ་སེར་སྣ་བྱེད་དམ་ཞེས་སྨྲས་པ་དང་།",
    "དེས་ཁོ་མོ་རོ་རྒྱབ་ནས་དུགས་གྱིས་ཤིག་ཅེས་ལས་བྱེད་དུ་བཅུག་པ་དང་།",
    "དེ་དག་གིས་དྲིས་པ་དང་དེས་སྨྲས་པ་དང་།",
    "ཁོ་མོ་ཅིའི་ཕྱིར་མི་བྱེད་ཅེས་བྱ་བའི་བར་དུ་གསུངས་པ་ཡིན་ནོ།",
    "འདི་ནི་སྦོམ་དགའ་མོས་དགེ་སློང་མ་སྔ་ན་འཁོད་པ་དག་རྐང་པ་དང་ལག་པ་དག་གིས་མནན་པ་དང་དེ་དག་གིས་སྨྲས་པ་འཕགས་མ་ཅིའི་ཕྱིར་གནོད་པར་བྱེད།",
    "འདིར་གླེང་གཞི་ནི་དེ་དག་གིས་ལེགས་པར་མ་མཐོང་བ་དང་ལེགས་པར་མ་ཐོས་པ་དང་ལེགས་པར་མི་དོགས་པས་དགེ་སློང་མ་ལ་དགེ་སློང་མ་ཆེ་གེ་མོ་ཞིག་འདི་འདྲའོ་ཞེས་གླེང་བར་བྱེད་ཅིང་དེའི་གསོ་སྦྱོང་དང་དགག་དབྱེ་འཇོག་པར་བྱེད་པ་དང་དེ་བཞིན་དུ་བརྫུན་གྱིས་དགེ་སློང་མ་རྣམས་ལ་གླེང་ཞིང་མི་མཐུན་པར་གནས་པར་བྱེད་དོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "ཁོ་མོ་ཐམས་ཅད་ལ་བདེན་པས་འཇུག་པ་མ་ཡིན་གྱི།",
    "དགེ་སློང་གི་མདུན་དུ་སྤྱོད་ཡུལ་དུ་རྒྱུ་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "དགེ་སློང་མས་དགེ་སློང་གི་མདུན་དུ་གྲོང་དུ་བསོད་སྙོམས་ལ་འདུག་པར་མི་བྱ་བའོ།",
    "འདིར་གཞུང་ནི་དེ་ལྟ་བས་ན་དགེ་སློང་མས་དགེ་སློང་གི་སྤྱོད་ཡུལ་དུ་ཞུགས་པའི་མདུན་དུ་འགྲོ་བར་མི་བྱ་བར་དགེ་སློང་གི་སྤྱོད་ཡུལ་གང་སྤངས་པ་དེར་དགེ་སློང་གིས་འཇུག་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དགེ་སློང་གིས་དགེ་སློང་མ་ལ་སྟན་ལ་འདུག་ཏུ་གཞུག་པ་མི་བྱེད་ན།",
    "ཞག་ལོན་པའི་འདུན་པ་སྦྱིན་པ་ཞེས་བྱ་བ་ནི་ཉི་མ་སྔ་མ་གཞན་ལ་འདུན་པ་ཕུལ་བ་དེ་ཉིད་ད་དུད་ཡང་ཡོད་པས་འདུན་པ་སྔ་མ་དེ་ཁོ་མོས་ད་དུང་ཕྱིར་མ་བླངས་པས་དེ་རིང་ཡང་བཟོད་འདུན་པ་འབུལ་ཅི་དགོས་ཞེས་ཟེར་ཞིང་འདུན་པ་ཕྱི་མ་མི་སྟེར་བ་ཡིན་ནོ།",
    "དེས་སྨྲས་པ་ཁོ་མོའི་འདུན་པ་ཕུལ་ཟིན་ནོ།",
    "གསོ་སྦྱོང་གི་ཉིན་མོའི་ཟླ་བ་བྱེད་ཕྱེད་ཅིང་དགེ་སློང་རྣམས་ལ་འདི་ནི་བྱ་བའོ་འདི་ནི་བྱ་བ་མ་ཡིན་པའོ་ཞེས་བྱ་བའི་རང་བཞིན་གྱི་གདམས་ངག་དང་རྗེས་སུ་བསྟན་པ་ཉམས་སུ་མྱོང་བར་མི་བྱེད་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "རྐྱེན་མ་བྱུང་བར་གསོ་སྦྱོང་གི་ཉིན་མོ་ལས་འདས་ནས་སྐྱ་རེངས་འཆར་བའི་དུས་ན་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "རྐྱེན་བྱུང་བ་ལ་སོགས་པ་དགག་དབྱེའི་ཉིན་མོ་ལས་འདས་པ་ལས་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་བ་ནི་གསོ་སྦྱོང་དང་འདྲའོ།",
    "གང་ཟག་དབུལ་པོ་དུ་མ་སྦྱོར་དུ་བཅུག་པ་ལ་ནི་གང་ཟག་རེ་རེ་ལས་ཁ་ན་མ་ཐོ་བ་རེ་རེར་འགྱུར་རོ།",
    "ཅི་ཙམ་དུ་སོང་ཞེ་ན།",
    "འདིར་ཉེན་ཀོར་ཞེས་བྱ་བ་ནི་དབྱར་ཁང་གི་འཕྲལ་གྱི་བྱ་བ་ཡོད་པའི་ཕྱོགས་ཏེ་དེ་བཏང་ནའོ།",
    "གང་ཟག་གི་དབྱར་ཁང་གཞན་ལ་གླར་མི་གཏང་ངོ།",
    "ཁང་ཁྱིམ་གྱི་གཞི་དང་ཚོང་ཁང་གི་གཞི་ཡང་ངོ་ཞེས་བྱ་བ་ལ།",
    "འདི་ཡང་གང་ཟག་གིའོ།",
    "བུད་མེད་རྣམས་ནི་གནས་པ་ལྷག་པར་ཆགས་པ་ཤས་ཆེ་བས་བསླབ་པའི་གཞི་འདི་བཅས་སོ།",
    "ཚེས་བཅུ་དྲུག་གི་འོག་རོལ་ཏུ་ལམ་གྲོགས་ལ་སྡོད་པ་ལ་ནི་ཉེས་པ་མེད་དོ།",
    "ལྷའི་གནས་ལ་སོགས་པ་དང་མུ་སྟེགས་ཅན་གྱི་གནས་སུ་སོང་སྟེ་རྩོད་པར་བྱེད་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "གཞན་གྱི་གནས་སུ་སོང་སྟེ་གཞན་ཟིལ་གྱིས་གནོན་པ་འདི་ནི་ཧ་ཅང་སྤྱི་བརྟོལ་ཆེ་བ་ཡིན་པའི་ཕྱིར་དེ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "དགེ་སློང་ལ་སོགས་པས་ཚིག་གི་སྐབས་མ་ཕྱེ་བར་དྲི་བ་འདྲི་བ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "དབྱར་ཁང་གི་ཉེ་འཁོར་འདོམ་གང་ལས་ལོགས་ཤིག་ན་ཆབ་ཀུང་ས་དཀན་བག་ཏུ་འདུག་པ་དེར་གཅིག་པུ་འགྲོ་བ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "འདིར་རྩིག་པ་ཞེས་བྱ་བ་ནི་དབྱར་ཁང་གི་ར་བ་ལ་བྱའོ།",
    "དབྱར་ཁང་གི་སྟེང་གི་རྩིག་པའི་བུ་ཤུ་བཏབ་པ་ཡིན་ན་གལ་ཏེ་པུ་ཤུ་མཐོ་ཆེས་པས་བལྟར་མི་སླེབ་པར་འགྱུར་ན།",
    "མི་གཙང་བའི་ཐལ་བའི་སྟེང་དུ་བོང་བ་ལ་སོགས་པ་འཕང་ཞིང་ཟེར་མ་འཐོར་བར་མི་བྱའོ།",
    "འདིར་གཞུང་ནི་ཕྲན་ཚེགས་དག་ལས་ཚེ་དང་ལྡན་པ་འོད་སྲུངས་ཆེན་པོ་ལྗན་ལྗིན་གྱི་དྲུང་དུ་འགྲོ་བ་དེ་སྦོམ་དགའ་མོས་མཐོང་ནས།",
    "དེའི་ཕྱིར་གཞན་གྱི་ཁྱིམ་ནས་བདག་གི་དོན་དུ་འོ་མ་བསླངས་ཏེ་འཐུངས་པ་ལའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེ་ནས་བདག་གི་དོན་དུ་འོ་མ་བསླངས་ཏེ་འཐུངས་པ་ལ་ཁ་ན་མ་ཐོ་བ་འདིར་འགྱུར་རོ།",
    "གཞན་གྱི་ཁྱིམ་ནས་བདག་གི་དོན་དུ་བླངས་ཏེ་འཐུངས་སམ་ཟོས་པ་ལའོ་ཞེས་བྱ་བའི་རྗེས་བསྙག་པའི་ཕྱིར་ཀྱང་ངོ་ཞེས་བྱ་བའི་སྒྲ་སྨོས་སོ།",
    "ཞོ་ལ་སོགས་པ་རེ་རེ་ཡང་གཞན་གྱི་ཁྱིམ་ནས་བདག་གི་དོན་དུ་བླངས་ཏེ་ཟོས་སམ་འཐུངས་པ་ལ་ཁ་ན་མ་ཐོ་བ་དེ་དག་ཏུ་འགྱུར་རོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "དམག་དཔོན་སེང་གེ་ལ་བརྟེན་ནས་བསླབ་པའི་སྡོམ་པ་བྱིན་པ་དང་སྔར་མགྲོན་དུ་མ་བོས་པར་ཁྱིམ་ནས་བཅའ་བ་དང་བཟའ་བ་བླངས་ཤིང་ཟ་བ་ལ་སྟེ་ག་གོན་དང་ལ་ཕུག་དང་ལྡམ་ལྡུམ་མོད་པ་དག་ནི་མ་གཏོགས་སོ་ཞེས་སྔར་དགེ་སློང་རྣམས་ཀྱི་སོ་སོར་བཤགས་པར་བྱ་བའི་ཉེས་པ་བསྟན་པ་གང་ཡིན་པ་དེ་ཉིད་དགེ་སློང་མ་རྣམས་ཀྱི་ཡང་ཡིན་པར་ཤེས་པར་བྱའོ།",
    "དེ་དག་ནི་ཕལ་ཆེར་ཐུན་མོང་མ་ཡིན་པས་གཞན་ཐམས་ཅད་ནི་སྔར་དགེ་སློང་གི་རྣམ་པར་འབྱེད་པའི་སྐབས་སུ་བསྟན་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཐུན་མོང་མ་ཡིན་པ་ལས་ཉུང་ཤས་ཤིག་དང་དགེ་སློང་གི་ཡིན་ལ་དགེ་སློང་མའི་མ་ཡིན་པ་ཉུང་ཤས་ཤིག་ཡོད་པ་དེ་འདིར་བརྗོད་པར་བྱའོ།",
    "ཞེས་སྨོས་པ་དགེ་སློང་མ་ལ་བརྒྱད་ཡོད་དེ་འདིར་ཐུན་མོང་མ་ཡིན་པ་གཅིག་བསྟན་པའི་ཕྱིར།",
    "གྲོང་དུ་འགྲོ་བའི་སྐབས་ཀྱི་ཐུན་མོང་མ་ཡིན་པ་བསྟན་པའི་ཕྱིར།",
    "གང་གི་ཚེ་དང་དུ་ལེན་པར་བྱེད་པ་དེའི་ཚེ་ནི་ཉེས་པ་ཁོ་ནར་འགྱུར་རོ།",
    "འདིར་འགྲོ་བར་མི་བྱའོ་ཞེས་སྨོས་པ་ནི་དཔེ་ཙམ་དུ་ཟད་དེ་སོང་ཟིན་པའི་གནས་སྐབས་ལ་ཡང་ཁ་ན་མ་ཐོ་བ་ཁོ་ནར་འགྱུར་རོ།",
    "བསླབ་པ་གཞན་ནི་དགེ་སློང་དག་གི་གླེང་གཞི་ལས་གྱུར་པ་དགེ་སློང་གི་རྣམ་པར་འབྱེད་པའི་སྐབས་སུ་བསྟན་པ་བཞིན་དུ་དགེ་སློང་མ་དག་གི་གླེང་གཞི་ལས་གྱུར་པ་ཡང་དེ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དགེ་སློང་གི་དངོས་པོ་ཡོངས་སུ་དག་པ་ལས་ཕྱིར་བཅོས་སུ་མི་རུང་བ་ཉིད་ཀྱིས་ཉམས་པ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཉོན་མོངས་པ་རྣམས་ཀྱིས་ཕམ་པར་བྱས་པ་ནི་ཚེ་དེ་ལ་ཉོན་མོངས་པ་རྣམས་སྤོང་བ་མི་སྲིད་པས་དེས་ན་ཕམ་པར་འགྱུར་བ་ཞེས་བྱའོ།",
    "དགེ་སློང་ཕམ་པར་གྱུར་པ་ལ་ནི་སྡོམ་པ་ཡོད་དུ་ཟིན་ཀྱང་དེ་ལྟ་མོད་ཀྱི་དགོས་པ་མེད་པ་ཉིད་དུ་གྱུར་ཏེ་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་རྣམས་དང་ལྷན་ཅིག་གནས་པ་དང་ལོངས་སྤྱོད་པ་དག་མེད་པའི་ཕྱིར་རོ།",
    "རྐྱེན་འགའ་ཞིག་མ་ཚད་བས་དང་པོ་ཉིད་ནས་དགེ་སློང་ནས་དགེ་ཚུལ་དང་དགེ་སློང་དག་གི་སྡོམ་པ་གཉིས་མ་སྐྱེས་པ་ཡིན་ནོ།",
    "བདེན་མོད་ཀྱི་འོན་ཀྱང་རབ་ཏུ་བྱུང་བ་དང་བསྙེན་བར་རྫོགས་པའི་ཐ་སྙད་ལ་སྡོམ་པ་མ་སྐྱེས་པ་འདིས་རབ་ཏུ་བྱུང་བ་ཉིད་དང་དགེ་སློང་དེ་དང་སྡོམ་པ་ཆགས་པ་འདི་ཁས་བླངས་པར་གྱུར་པས་དེའི་ཕྱིར་ཐ་སྙད་དེ་ལ་བདག་ཉིད་སྟོན་པའི་གང་ཟག་མ་སྐྱེས་པ་ལ་ནི་སྡོམ་པ་ཡང་མ་ཡིན་སྡོམ་པ་མ་ཡིན་པ་ཡང་མ་ཡིན་པའི་ངོ་བོ་ཉིད་ཀྱི་རབ་ཏུ་བྱུང་བ་ཡོད་པས་དེ་ལ་ཉེས་བྱས་སུ་གཞག་པ་མཛད་དོ།",
    "དེ་དག་གིས་བླངས་པ་ཞེས་བྱ་བ་ནི།",
    "འབྲལ་དང་མེ་ལ་རེག་པ་དང་།",
    "དགེ་ཚུལ་གཉིས་ཀྱིས་རིན་ཆེན་རེག།",
    "མེ་ལ་རེག་པ་དང་།",
    "མེ་ལ་རེག་པ་ཞེས་བྱ་བ་ནི་མེ་འབུད་པ་ལ་སོགས་པའོ།",
    "ཕྱར་གཡེང་གི་གཞི་ལས་བྱུང་བ་དང་།",
    "དེ་ལ་རྟགས་ཀྱི་གཞི་ལས་བྱུང་བ་གང་གི་ཕྱོགས་དང་མཐུན་པ་དེ་ཉིད་ཡིན་ཞེ་ན།",
    "འདི་ལྟར་རབ་ཏུ་བྱུང་བའི་རྟགས་ཡང་དག་པར་ལེན་ཏོ་ཞེས་གསུངས་བའི་ཚིག་གང་ཡིན་པ་དེ་ནི་རེ་ཞིག་བླངས་པ་ཡིན་པས།",
    "སེན་མོའི་བཅོས་པ་རྗེས་སུ་མ་གནང་བ་དག་དང་།",
    "སློང་བའི་གཞི་ལས་བྱུང་བ་གང་གི་ཕྱོགས་དང་མཐུན་པ་ཡིན་ཞེ་ན།",
    "སྣོད་ཀྱི་གཞི་ལས་བྱུང་བ་གང་གི་ཕྱོགས་དང་མཐུན་པ་ཉིད་ཡིན་ཞེ་ན།",
    "ལོངས་སྤྱོད་ཀྱི་གཞི་ལས་བྱུང་བ་གང་གི་ཕྱོགས་དང་མཐུན་པ་ཉིད་ཡིན་ཞེ་ན།",
    "ཕྱར་གཡེང་གི་གཞི་ལས་བྱུང་བ་གང་གི་ཕྱོགས་དང་མཐུན་པ་ཉིད་ཡིན་ཞེ་ན།",
    "གླུ་གར་དང་རོལ་མོའི་སྒྲ་དང་།",
    "འདོད་པའི་གཞི་ལས་བྱུང་བ་གང་གི་ཕྱོགས་དང་མཐུན་པ་ཉིད་ཡིན་ཞེ་ན།",
    "གནོད་པའི་གཞི་ལས་བྱུང་བ་གང་གི་ཕྱོགས་དང་མཐུན་པ་ཉིད་ཡིན་ཞེ་ན།",
    "གཞི་དེ་ལས་སྐུར་བ་འདེབས་པ་དང་ཚིག་རྩུབ་མོ་སྨྲ་བ་ལ་སོགས་པ་ཡང་གནོད་པའི་གཞི་ལས་བྱུང་བ་ཡིན་པས་དེ་ནི་དེའི་ཕྱོགས་དང་མཐུན་པ་ཡིན་པས།",
    "གནས་པའི་གཞི་ལས་བྱུང་བ་གང་གི་ཕྱོགས་དང་མཐུན་པ་ཉིད་ཡིན་ཞེ་ན།",
    "མ་གུས་པའི་གཞི་ལས་བྱུང་བ་གང་གི་ཕྱོགས་དང་མཐུན་པ་ཉིད་ཡིན་ཞེ་ན།",
    "འདིར་དེ་དག་གི་སྔགས་ཀྱང་ཆེ་གེ་མོ་ཞིག་དགོངས་སུ་གསོལ།",
    "མ་གུས་པའི་གཞི་ལས་བྱུང་བ་གང་གི་ཕྱོགས་དང་མཐུན་པ་ཉིད་ཡིན་ཞེ་ན།",
    "ཇི་ལྟར་དགེ་སློང་གིས་དགེ་སློང་ལ་རྡེག་པ་དང་གཟས་པ་དང་འགྱོད་པ་སྐྱེད་པ་དང་།",
    "རང་གི་ཡུལ་ལ་ནི་བསྙེན་པར་རྫོགས་པ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེས་ན་བསླབ་པ་བྱིན་པ་དེ་དགེ་སློང་གི་ཡུལ་ལ་དེས་བྱིན་ལེན་བསྟབས་ན་ཡང་བྱིན་ལེན་དུ་རུང་ལ་དེས་རེག་ན་ཡང་བྱིན་ལེན་འཇིག་པ་དང་།",
    "དེ་བཞིན་དུ་འདིར་བསླབ་པ་བྱིན་པའི་རང་གི་ཡུལ་ལ་གསོ་ག་འཇོག་བྱས་པ་དང་ལག་ཉར་བླངས་པ་ལ་སོགས་པའི་ཉེས་པར་གྱུར་པ་དེ་རང་བཞིན་དུ་གནས་པའི་དགེ་སློང་དག་ལ་ཉེས་པར་མི་འགྱུར་ཏེ།",
    "བསླབ་པ་བྱིན་པ་རང་གི་ཡུལ་ལ་ནི་བསྙེན་པར་རྫོགས་པའི་སྡོམ་པ་ཡོད་དེ།",
    "འདིར་གཞུང་ནི་བཙུན་པ་རེ་ཞིག་དགེ་སློང་ལ་རྒྱུ་དུས་གསོག་འཇོག་བགྱིས་པར་འགྱུར།",
    "དགེ་སློང་གིས་གསོག་འཇོག་བྱས་པ་དང་།",
    "བཙུན་པ་རེ་ཞིག་དགེ་སློང་མ་ལ་རྒྱུ་དུས་གསོག་འཇོག་བགྱིས་པར་འགྱུར།",
    "བཙུན་པ་རེ་ཞིག་བསླབ་བ་བྱིན་པ་ལ་རྒྱུ་དུས་གསོག་འཇོག་བགྱིས་པར་འགྱུར།",
    "བསླབ་པ་བྱིན་པས་གསོག་འཇོག་བྱས་པ་དང་དགེ་སློང་གིས་གསོག་འཇོག་བྱས་པ་དང་།",
    "བཙུན་པ་རེ་ཞིག་བསླབ་པ་བྱིན་པ་མོ་ལ་རྒྱུ་དུས་གསོག་འཇོག་བགྱིས་པར་འགྱུར།",
    "པ་བྱིན་པ་མོས་གསོག་འཇོག་བྱས་པ་དང་།",
    "དགེ་སློང་གིས་གསོག་འཇོག་བྱས་པ་དང་།",
    "འགྲོ་བ་གཞན་གྱི་རྣམ་པ་བསྟེན་པ་ནི་དགེ་སློང་གི་འདུ་ཤེས་ཡོད་པ་ལའོ་ཞེས་བྱ་བ་ནི།",
    "གང་གི་ཚེ་བསྙེན་པར་རྫོགས་པའི་དུས་ན་དྲན་པར་གྱུར་པའི་ཚེ་བརྒྱལ་འགྱོད་པ་སྐྱེས་པར་གྱུར་ན་ཡང་དེའི་ཚེ་སྦྱོར་པ་སྔ་མ་དེན་སྨད་པ་ཉིད་ཡིན་པས་དེས་ན་ཉེས་པ་སྦོམ་པོར་རྣམ་པར་གཞག་པར་མཛད་དོ།",
    "གང་གི་ཚེ་བསྙེན་པར་རྫོགས་པའི་དུས་ན་དྲན་པར་གྱུར་པའི་ཚེ་བརྒྱལ་འགྱོད་པ་སྐྱེས་པར་གྱུར་ན་ཡང་དེའི་ཚེ་སྦྱོར་པ་སྔ་མ་དེན་སྨད་པ་ཉིད་ཡིན་པས་དེས་ན་ཉེས་པ་སྦོམ་པོར་རྣམ་པར་གཞག་པར་མཛད་དོ།",
    "དགེ་སློང་གསོད་པའི་སྦྱོར་པ་ལ་ཞུགས་པའི་ཚེ་སྦྱོར་བ་དེ་མཐར་ཐུག་པ་དང་མགོ་མཉམ་དུ་དགེ་སློང་མར་གྱུར་ན་དགེ་སློང་མའི་མཚན་དེ་གསོད་པའི་སྦྱོར་བ་དེའི་དངོས་གཞིའི་ཞིང་ཉིད་ཡིན་པ་དང་དེ་བཞིན་དུ་དགེ་སློང་མ་གསོད་པའི་སྦྱོར་བ་ལ་ཞུགས་པའི་ཚེ་སྦྱོར་བ་དེ་མཐར་ཐུག་པ་དང་མགོ་མཉམ་དུ་དེ་དགེ་སློང་དུ་གྱུར་ན་དགེ་སློང་གི་མཚན་དེ་གསོད་པའི་སྦྱོར་བ་དེའི་དངོས་གཞིའི་ཞིང་ཉིད་ཡིན་པ་ལྟ་བུའོ།",
    "ན་སྨད་པའི་དོན་གྱི་སྦྱོར་བ་གང་ཡིན་པ་ཉིད་བྱེད་བཞིན་པ་ལས་མཚན་གྱུར་པ་དེ་ལ་ནི་ན་སྨད་པ་གང་གི་སྦྱོར་བ་བྱས་པ་དེ་ཉིད་ཀྱི་དངོས་གཞི་འབྱུང་གི།",
    "འདི་ལྟར་དགེ་སློང་སྐྱེས་པ་དང་ལྷན་ཅིག་ལུས་ཀྱིས་རེག་པའི་རོ་ཉམས་སུ་མྱོང་བར་བྱེད་པ་ཡང་ལུས་ཀྱིས་རེག་པའི་ལྷག་མའི་སྦོམ་པོར་གསུངས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་དགེ་སློང་གིས་སྐྱེས་པའི་ཕྱིར་ལུས་བཀན་བ་མི་ཚངས་པར་སྤྱོད་པའི་ཕམ་པར་གཏོགས་པའི་སྤོམ་པོར་གསུངས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་དགེ་སློང་སྐྱེས་པ་དང་ལྷན་ཅིག་ལུས་ཀྱིས་རེག་པའི་རོ་ཉམས་སུ་མྱོང་བར་བྱེད་པ་ཡང་ལུས་ཀྱིས་རེག་པའི་ལྷག་མའི་སྦོམ་པོར་གསུངས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་དགེ་སློང་གིས་སྐྱེས་པའི་ཕྱིར་ལུས་བཀན་བ་མི་ཚངས་པར་སྤྱོད་པའི་ཕམ་པར་གཏོགས་པའི་སྤོམ་པོར་གསུངས་པའི་ཕྱིར་རོ།",
    "དགེ་སློང་གིས་ལྷུང་བཟེད་ལྷག་པ་ཞག་བཅུ་ལས་འདས་པར་བཅངས་ན་སྤང་བར་འགྱུར་ལ་དགེ་སློང་མས་ནི་ཞག་གཅིག་ལས་འདས་པར་བཅངས་ན་སྤང་བར་འགྱུར་བ་དེ་ལ་གལ་ཏེ་དགེ་སློང་གིས་ལྷུང་བཟེད་ལྷག་པ་ཞག་བཅུ་མ་ལོན་པར་ཞག་དགུ་ཚུན་ཆད་དུ་བཅངས་པ་ལས་གནས་སྐབས་དེར་མཚན་གྱུར་ཏེ།",
    "དགེ་སློང་མར་གྱུར་ན་ཞག་དགུ་པོ་དེ་དག་ནི་དགེ་སློང་མའི་ལྷུང་བཟེད་ཐོབ་མ་རྙེད་པའི་ཉི་མ་དང་པོ་དེ་ཉིད་ཀྱི་ཆ་ཡིན་ཞིང་དེའི་ཁོངས་སུ་གཏོགས་པ་ཉིད་ཡིན་པས་ཞག་དགུ་ཐལ་བ་དེ་དག་གིས་སྤང་བར་མི་འགྱུར་རོ།",
    "དགེ་སློང་གི་འཆང་བའི་དུས་ཞག་གཅིག་ནས་དགུའི་བར་དག་འདས་པ་ན་དེ་དགེ་སློང་མ་ཉིད་དུ་གྱུར་ན་ཞག་དགུ་པོ་དེ་དག་ཞག་གཅིག་པོའི་ཁོངས་སུ་གཏོགས་པས་དེ་ལ་ཉེས་པ་མེད་དོ།",
    "འདིར་གཞུང་ནི་བཙུན་པ་རེ་ཞིག་དགེ་སློང་གིས་ལྷུང་བཟེད་རྙེད་པ་ན་མཆན་གྱུར་ཏེ་དགེ་སློང་མར་གྱུར་ནས།",
    "དགེ་སློང་གིས་ལྷུང་བཟེད་རྙེད་པ་ན་མཚན་གྱུར་ཏེ།",
    "འདིར་གཞུང་ནི་སྤོ་བའི་གཞིའི་ཞུ་བ་ལས་བཙུན་པ་རེ་ཞིག་དགེ་སློང་སྤོ་བ་ལ་ཐུག་པ་མཚན་གྱུར་ཏེ་དགེ་སློང་མར་གྱུར་ན།",
    "མཚན་གྱུར་པ་འདི་ལ་གང་གི་ཕྱིར་ཆོག་སྤྱད་པ་རྣམས་གྱུར་པ་དེའི་ཕྱིར་དེ་དག་རྣམ་པར་གཞག་པ་མཛད་དོ།",
    "དེ་བཞིན་དུ་དགེ་སློང་གིས་སྐྱེས་པའི་ལུས་ལ་རེག་པའི་སྦྱོར་བ་བརྩམས་པ་ན་སྐྱེས་པ་དེ་མཚན་གྱུར་ཏེ།",
    "དེ་བཞིན་དུ་དགེ་སློང་གིས་བུད་མེད་ཀྱི་ལུས་ལ་རེག་པའི་སྦྱོར་བ་བརྩམས་པ་ན་བུད་མེད་དེ་མཚན་གྱུར་ཏེ།",
    "དེ་བཞིན་དུ་དགེ་སློང་དུ་གྱུར་པས་བུད་མེད་ཀྱི་ལུས་ལ་རེག་པའི་ཕྱིར་སྦྱོར་བ་བརྩམས་ནས་དགེ་སློང་དེ་མཚན་གྱུར་ཏེ།",
    "དེ་བཞིན་དུ་དགེ་སློང་མར་གྱུར་པས་སྐྱེས་པའི་ལུས་ལ་རེག་པའི་ཕྱིར།",
    "གཞན་ལས་སྐྱེས་པ་ནི་རང་གི་འགྲོ་བ་ཉིད་མ་ཡིན་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "དུད་འགྲོ་མིའི་འགྲོ་བའམ་མི་མ་ཡིན་པའི་འགྲོ་བ་གཞན་ལས་སྐྱེས་པ་ནི་རང་ཉིད་འགྲོ་བ་གར་གཏོགས་པའི་རང་གི་འགྲོ་བ་ཉིད་མ་ཡིན་པ་མ་ཡིན་ཏེ།",
    "རང་གི་འགྲོ་བ་ཉིད་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་མི་མ་ཡིན་པ་མོའི་མངལ་ནས་སྐྱེས་པའི་མངལ་ན་གནས་པ་མིའི་ངོ་བོ་ཉིད་བསད་ན་མི་ཉིད་བསད་པ་ཡིན་པས་ཕམ་པ་ཁོ་ནར་འགྱུར་བ་ལྟ་བུ་དང་།",
    "དེ་བཞིན་དུ་མིའི་བུད་མེད་ཀྱི་མངལ་ནས་སྐྱེས་པའི་མངལ་ན་གནས་པ་མི་མ་ཡིན་པའི་ངོ་བོ་ཉིད་བསད་ན་མི་མ་ཡིན་པ་ཉིད་བསད་པ་ཡིན་པས་སྦོམ་པོར་འགྱུར་བ་ལྟ་བུ་དང་།",
    "འདི་ལྟར་མི་ལ་སོགས་པ་དེ་དུད་འགྲོ་ལ་སོགས་པ་ལས་སྐྱེས་པ་ཡིན་མོད་ཀྱི་འོན་ཀྱང་དེ་བདག་ཉིད་འགྲོ་བ་གར་སྐྱེས་པའི་འགྲོ་བདེ་ཉིད་དུ་གཏོགས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་གི་འགྲོ་བ་ཉིད་མ་ཡིན་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བའི་རྗེས་བསྙགས་པའི་ཕྱིར་ཡང་ངོ་ཞེས་བྱ་བའི་སྒྲ་སྨོས་སོ།",
    "དེ་ལྟ་བས་ན་དགེ་སློང་གིས་མིའི་འགྲོ་བར་གཏོགས་པ་མི་མ་ཡིན་པ་དང་དུད་འགྲོའི་འགྲོ་བ་གཞན་གྱི་ལུས་ཀྱི་རྣམ་པ་བསྟེན་པ་ཞིག་གསོད་ན་དེར་འདུ་ཤེས་པས་ཀྱང་རུང་གཞན་དུ་འདུ་ཤེས་པས་ཀྱང་རུང་སྟེ་གསད་པའི་དུས་ན་དངོས་གཞིའི་ཕམ་པ་ཁོ་ནར་འགྱུར་རོ།",
    "འདིར་ལྷ་སྦྱིན་དུ་འདུ་ཤེས་པས་མཆོད་སྦྱིན་བསད་པ་ལ་ཕམ་པར་མི་འགྱུར་བ་ལྟ་བུར་ཐལ་བར་ཡང་མི་འགྱུར་སྟེ།",
    "འདི་ལྟར་གཙུག་ཕུད་ཅན་གྱིས་ཕས་དགྲ་བཅོམ་བ་ཉིད་ཐོབ་པར་མ་ཤེས་སུ་ཟིན་ཀྱང་པས་བུ་ལ་ཁྱོད་ཀྱིས་མཚམས་མེད་པ་གཉིས་བྱས་ཏེ་ཕ་གསད་པའི་ཕྱིར་དང་དགྲ་བཅོམ་པ་གསད་པའི་ཕྱིར་རེ་ཞེས་སྤྲིངས་བ་ལ་སོགས་པ་ལྟ་བུའོ།",
    "མ་བྱིན་པར་ལེན་པ་དང་ལུས་ཀྱིས་རེག་པ་དང་གོས་སློབ་བ་དང་གོས་སྦྱིན་པ་དང་བསོད་པ་སློང་བ་དང་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འགྲེང་བ་དང་འདུག་པ་ལ་སོགས་པ་གཞན་ལ་ནི་འདི་གཞན་དུ་རྣམ་པར་གཞག་སྟེ།",
    "ལུས་ཀྱིས་རེག་པ་ལ་སོགས་པ་དག་ལ་ནི་ཐ་སྙད་ཀྱི་ཕྱིར་རྣམ་པར་གཞག་གོ།",
    "དགྲ་བཅོམ་བ་ཉིད་མ་ཡིན་པ་ལ་སོགས་པའི་ལུས་གཅིག་གིས་དགྲ་བཅོམ་པ་ཉིད་ལ་སོགས་པའི་གནས་སྐབས་གཞན་ཐོབ་ན་དེའི་རྒྱུད་ནི་གཞན་ཉིད་མ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་གང་གིས་དགྲ་བཅོམ་པ་མ་ཡིན་པའི་གནས་སྐབས་སུ་བསད་པའི་ཕྱིར།",
    "དགེ་སློང་གིས་སྟན་གཅིག་ལོ་དྲུག་མ་ལོན་པར།",
    "དགེ་སློང་མ་རྒྱལ་རིགས་ཀྱི་རིགས་ཅན་མོ་ལ་ཡང་དེ་བཞིན་ནོ་ཞེས་གསུངས་པ་དང་།",
    "ཡོད་དེ་ཞག་གཉིས་དགེ་ཚུལ་དང་ལྷན་ཅིག་ཉལ་བ་ལ་ཞག་གསུམ་པ་ལ་ཁྱིམ་པ་མོ་དང་ལྷན་ཅིག་ཉལ་བ་ལའོ་ཞེས་བྱ་བ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ལ་རེ་ཞིག་མི་ཚངས་པར་སྤྱོད་པའི་ཆ་གང་ཞེ་ན།",
    "ཁུ་བ་འབྱིན་པ་དང་ལུས་ཀྱིས་རེག་པ་དང་འཁྲིག་པ་དང་ལྡན་པར་སྨྲ་བ་དང་བསྙེན་བཀུར་བསྔགས་པ་དང་།",
    "བུད་མེད་དང་ལྷན་ཅིག་ཉལ་བ་དང་སྐྱེས་པ་མེད་པར་བུད་མེད་དང་ལྷན་ཅིག་ལམ་དུ་འགྲོ་བ་དང་དུས་མ་ཡིན་པར་གྲོང་དུ་འགྲོ་བ་དང་།",
    "དམག་གི་ནང་ན་གནས་པ་དང་།",
    "དགེ་སློང་གིས་བཙོས་པ་ཟ་བའོ།",
    "བདག་ཉིད་ཀྱི་དོན་དུ་བུད་མེད་ལ་གཞོལ་བ་གང་ཡིན་པ་དེ་ནི་ཕམ་པར་འགྱུར་བར་གཏོགས་པའི་སྦོམ་པོའོ།",
    "ལུས་ཀྱིས་རེག་པའི་བདག་ཉིད་གཞན་ཡིན་ནོ།",
    "མཚན་གྱི་ནང་དུ་རེག་ལ་གལ་ཏེ་རྨ་ཉམས་པ་མ་ཡིན་པ་གང་ཡིན་པ་དེ་ནི་ཕམ་པར་འགྱུར་བའོ།",
    "མོང་འདིར་མ་བརྗོད་པ་ནི་ཅུང་ཟད་ཀྱང་མི་བརྗོད་ཀྱི།",
    "དེས་ན་ཁུ་བ་འབྱིན་པ་ལ་སོགས་པ་ནི་མི་ཚངས་པར་སྤྱོད་པ་ལ་སོགས་པའི་ཆ་དག་ཡིན་གྱི་ཆ་དེ་དག་གི་ཆ་གཞན་དུ་ནི་མི་རིགས་ཏེ་ཐུག་པ་མེད་པའི་སྐྱོན་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདིར་གཞུང་ནི་བུད་མེད་ཇི་ལྟ་བུ་དང་མི་ཚངས་པར་སྤྱོད་པར་བགྱིད་ན་མཐར་འགྱུར་བ་ལགས།",
    "གང་གི་ཕྱིར་དེའི་རྨའི་སྒོའི་ཐན་ཀོར་ཉམས་པར་གྱུར་ན་སྟེ་དེ་ལ་ཉམས་པར་བྱེད་ན་ཉེས་པ་སྦོམ་པོར་འགྱུར་རོ།",
    "དེ་དག་གི་འབྲས་བུ་ནི་ཐ་དད་པ་ཉིད་ཡིན་ནོ།",
    "ཞག་བརྒྱུད་མ་མ་ཡིན་པར་སྐབས་སྐབས་སུ་གཞན་དུ་སོང་བའི་ཞག་སྤྱིར་བསྡོམས་པས་ཞག་དྲུག་ལས་ལྷག་ཏུ་ཟིན་ཀྱང་དེས་ཞག་དྲུག་གི་འབྲལ་བའི་སྤང་བར་མི་འགྱུར་བ་ལྟ་བུ་དང་།",
    "དགེ་སློང་མ་ཤ་ཀ་ལྔ་བརྐུས་ན་མཐར་འགྱུར་རོ་ཞེས་གང་གསུངས་པ་དེ་ལ་བཙུན་པ་དགེ་སློང་གིས་རྐུ་སེམས་ཀྱིས་མ་ཤ་ཀ་བརྒྱའམ་སྟོང་སྙེད་བརྐུས་ཀྱང་མཐར་མི་འགྱུར་བ་མཆིས་སམ།",
    "སྦྱོར་བའི་སྦྱོར་བ་ལ་ནི་ཉེས་པ་སྦོམ་པོ་རེ་རེར་འགྱུར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ལུག་གི་བལ་ནག་པོ་རྙིང་པ་ལས་སྟན་བྱས་ན་ཉེས་བྱས་སུ་འགྱུར་བ་ལྟ་བུ་དང་།",
    "ལུག་གི་བལ་ཆུང་ཟད་བཀྲུས་པ་དང་བཙོས་པ་དང་རྨེལ་བ་ཞིག་དགེ་སློང་མ་ཉེ་དུ་མ་ཡིན་པ་ལ་འཁྲུར་བཅོལ་ཏམ་འཚེད་དུ་བཅོལ་ཏམ་རྨེལ་དུ་བཅོལ་ན་ཉེས་བྱས་སུ་འགྱུར་བ་ལྟ་བུའོ།",
    "ཁ་ན་མ་ཐོ་བ་ན་སྨད་པ་དག་གི་ཆ་ཉིད་ནི་ན་སྨད་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "ཕམ་པར་འགྱུར་བ་ལ་སོགས་པ་དངོས་གཞིའི་ཁ་ན་མ་ཐོ་བ་དག་ལས་ན་སྨད་པ་སྦོམ་པོའི་ཁ་ན་མ་ཐོ་བ་ལ་སོགས་པ་དག་གི་ཆ་ཉིད་ནི་ན་སྨད་པ་ཉིད་ཡིན་ཏེ།",
    "ཉེས་བྱས་དག་གིས་སྐུར་པ་བཏབ་པ་ལ་ཉེས་བྱས་སུ་འགྱུར་བ་ལྟ་བུའོ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་ངན་སེམས་ཀྱིས་ཁྲག་ཕྱུང་བ་དག་གིས་སྐུར་པ་འདེབས་པ་དེ་ལ་ནི་ཉེས་བྱས་སུ་འགྱུར་ཏེ་དེ་གཉིས་སྦོམ་པོ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཉེས་བྱས་དག་གིས་སྐུར་པ་འདེབས་པ་ལ་ནི་ཆ་ཉིད་ན་སྨད་པ་ཡིན་པའི་ཕྱིར་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "གཞི་ཐམས་ཅད་ལ་ཐེ་ཚོམ་ཟ་བ་བཞིན་དུ་འཇུག་པའི་གང་ཟག་གི་འདི་མ་ཡིན་ནམ་འོན་ཏེ་མི་མ་ཡིན་འདི་བདག་གི་མ་ཡིན་ནམ་འོན་ཏེ་བདག་གི་མ་མ་ཡིན།",
    "འདི་བདག་གི་ཕ་ཡིན་ནམ་འོན་ཏེ་བདག་གི་ཕ་མ་ཡིན།",
    "འདི་བདག་གི་མ་ཡིན་ནམ་འོན་ཏེ་བདག་གི་མ་མ་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པར་ཐེ་ཚོམ་ཟ་བཞིན་དུ་བསད་པ་ལ་ནི་གསད་པར་བྱ་བའི་གཞི་དེ་བདག་གི་མའམ་ཕའམ་དགྲ་བཅོམ་པ་ཡིན་ན་ནི་ཕམ་པ་དང་མཚམས་མེད་པར་ཡང་འགྱུར་རོ།",
    "འདི་བུད་མེད་ཡིན་ནམ་འོན་ཏེ་མ་ཡིན་སྙམ་དུ་ཐེ་ཚོམ་ཟ་བཞིན་དུ་ལུས་ཀྱིས་རག་པའམ་མི་ཚངས་པར་སྦྱང་ན་གཞི་ཇི་ལྟ་བ་ལས་ཁ་ན་མ་ཐོ་བར་འགྱུར་རོ།",
    "ལུས་ཀྱིས་རེག་པ་ལ་སོགས་པ་དག་ལ་ཡང་དེ་བཞིན་དུ་ཅི་རིགས་པར་སྦྱར་རོ།",
    "བུད་མེད་ལ་སོགས་པ་གང་ཡང་བསམ་པའི་དོན་དེ་ཉིད་ཡན་ལག་ཡིན་པར་མ་ཟད་ཀྱི་བསམས་པའི་དོན་གཞན་ཡང་ཡན་ལག་ཡིན་ཏེ།",
    "འདི་གཉིས་ལ་ནི་ཡུལ་གང་རུང་གི་རེག་པ་བདག་གིར་བྱེད་པ་གཙོ་བོ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེས་ན་གང་བསམས་པའི་བུད་མེད་དེ་ཉིད་དང་མི་ཚངས་པར་སྦྱང་ན་ཡང་ཕམ་པར་འགྱུར་ལ།",
    "ལུས་ཀྱིས་རེག་པ་དང་གག་ཚིལ་བྱེད་པའི་ཁ་ན་མ་ཐོ་བ་གཉིས་ལ་རེག་པར་བྱ་བ་དང་རེག་པར་བྱེད་པའི་ལུས་གཉི་ག་ཡན་ལག་ཡིན་པས་གཉི་གའི་ལུས་མ་ཉམས་པ་ཡིན་ན་ནི་དངོས་གཞིར་འགྱུར་བས་དེ་ལ་ན་སྨད་པ་མེད་དོ།",
    "དེ་ལ་གལ་ཏེ་གང་ཡང་རུང་བ་ཅིག་གི་ལུས་རྨ་ལ་སོགས་པས་ཉམས་པ་ཡིན་ན་དེ་ནི་ཡན་ལག་མ་ཚང་བ་ཡིན་པས་གཞན་ཞེས་བྱ་སྟེ།",
    "གཞན་དེ་ལ་ནི་ལུས་ཀྱིས་རེག་པ་ལ་ནི་སྦོམ་པོར་ན་སྨད་པ་ཉིད་ཡིན་ལ།",
    "དུ་མ་མ་ཚང་བ་དེ་ལ་ནི་ལུས་ཀྱིས་རེག་པ་ལ་ནི་སྔར་སྦོམ་པོར་ན་སྨད་པ་དེ་བས་ཀྱང་ན་སྨད་པ་དེ་ཉེས་བྱས་སུ་འགྱུར་བ་ཡིན་ལ།",
    "ག་ག་ཚིལ་བྱེད་པ་ལ་ནི་སྔར་ཉེས་བྱས་སུ་ན་སྨད་པ་དེ་བས་ཀྱང་ན་སྨད་དེ་ཉེས་བྱས་ཕྲ་མོ་ཉིད་ཡིན་ནོ་ཞེས་བྱ་བ་ལྟ་བུར་སྦྱར་རོ།",
    "དཔེར་ན་དུད་འགྲོ་དང་ལྷན་ཅིག་ལུས་ཀྱིས་རེག་པ་དང་།",
    "ཇི་ལྟར་མི་མ་ཡིན་པ་མཐུ་མེད་པ་དང་ལྷན་ཅིག་ལུས་ཀྱིས་རེག་པ་ལ་སོགས་པ་བྱེད་པ་ལ་ན་སྨད་དེ་སྦོམ་པོར་འགྱུར་བ་ལྟ་བུ་མ་ཡིན་ཏེ།",
    "དེ་ནི་རེག་པ་མ་ཡིན་པའི་ཡན་ལག་ཡིན་ཏེ།",
    "རེག་པ་མ་ཡིན་པ་ཞེས་བྱ་བ་ནི་མི་ཚངས་པར་སྤྱོད་པ་དང་ལུས་ཀྱིས་རེག་པའི་བདག་ཉིད་ཀྱི་རེག་པ་མ་ཡིན་པ་དེ་ལས་གཞན་པ་སྟེ།",
    "དེ་ལ་དགེ་སློང་གིས་འཁྲིག་པ་དང་ལྡན་པ་དང་བསྙེན་བཀུར་བསྔགས་པ་སྨྲས་ན།",
    "རེག་པར་བྱ་བ་ཉིད་ནི་མ་ཉམས་པའོ་ཞེས་བྱ་བ་ནི་བསྟེན་པར་བྱ་བའི་ལུས་ཞེས་བྱ་བར་སྦྱར་ཏེ།",
    "གང་ལ་བསྟེན་པར་བྱ་བའི་ལུས་ཀྱི་རེག་པ་ཉིད་ཡན་ལག་ཏུ་རྣམ་པར་གཞག་པ་དེ་ལ་མ་ཉམས་ཤིང་ཉམས་པར་མ་གྱུར་པའི་རེག་པ་དང་བྱ་བ་ཉིད་དང་ཡན་ལག་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "འདིར་ལུས་ཀྱིས་རེག་པའི་བདེ་བ་ཉམས་སུ་མྱོང་བ་གཙོ་བོ་ཡིན་པའི་ཕྱིར་རོ།",
    "ཤུ་བ་ཅན་དང་གཡན་པ་ཅན་དང་ཁྱི་རྡོ་ཅན་གྱིས་རེག་ན་ཡང་དེ་བཞིན་དུ་སྦོམ་པོའོ།",
    "གང་གི་ཆོ་རེག་པར་བྱེད་པ་བདག་ཉིད་ཀྱི་ལུས་ཏེ་དེ་ལྟར་གྱུར་ན་དེའི་ཆོ་ཡང་སྦོམ་པོ་ཁོ་ནའོ།",
    "རྣམ་པར་བསྔོས་པ་མོ་དང་རྣམ་པར་རངས་པ་མོ་དང་།",
    "རྣམ་པར་འབུས་གཞིགས་པ་མོ་དང་།",
    "རྣམ་པར་བམ་པ་མོ་དང་།",
    "རྣམ་པར་ཟོས་པ་མོ་དང་།",
    "རྣམ་པར་དམར་བ་མོ་དང་།",
    "རྣམ་པར་འཐོར་བ་མོ་དག་ལ་འཁྱུད་པ་ལ་ནི་སྦོམ་པོའོ།",
    "འདིར་རྣམ་པར་འཐོར་བ་མོ་ཞེས་བྱ་བ་ནི།",
    "སོར་མོས་ག་ག་ཚིལ་བྱེད་པ་ལ་ཡང་རེག་པར་བྱ་བ་ཉིད་ནི་མ་ཉམས་པའོ་ཞེས་བྱ་བའི་རྗེས་བསྙག་པའི་ཕྱིར་ཡང་ངོ་ཞེས་བྱ་བའི་སྒྲ་སྨོས་སོ།",
    "གཅིག་གི་ལུས་ཉམས་པའི་རྣམ་པ་ཇི་སྐད་བསྟན་པ་དེ་ལྟ་བུ་ལ་གག་ཚིལ་བྱེད་པ་ལ་ནི་ན་སྨད་དོ།",
    "སེན་མོ་དང་སོ་དང་ཤ་མེད་པའི་རུས་པ་དང་སྤུ་དག་ནི་གཞན་དང་ལྡན་པ་ཉིད་དོ་ཞེས་བྱ་བ་ནི།",
    "དེ་ལྟ་བས་ན་སེན་མོ་ལ་སོགས་པ་མ་ཉམས་པ་དག་ཀྱང་གཞན་དང་ལྡན་པ་ཉིད་ཡིན་ཏེ་སྔར་མ་ཉམས་པའོ་ཞེས་སྨོས་པ་དེ་ལས་གཞན་པ་ཉམས་པ་དང་ལྡན་པ་ཉིད་ཡིན་པས་རིག་པ་དང་།",
    "དེས་ན་དེ་དག་ལ་ཡན་ལག་གཞན་གྱིས་སམ་དེ་དག་གི་ཡན་ལག་གཞན་ལ་རེག་པ་དང་གག་ཚིལ་བྱེད་པ་དག་ལ་ནི་གོ་རིམས་བཞིན་དུ་སྦོམ་པོ་དང་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "སེན་མོ་ལ་སོགས་པ་དག་གིས་སེན་མོ་ལ་སོགས་པ་དག་ལ་རེག་པ་དང་གག་ཚིལ་བྱེད་པ་དག་ལ་ནི་གོ་རིམས་བཞིན་དུ་ཉེས་བྱས་དང་ཉེས་བྱས་ཕྲ་མོར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་མི་མ་ཡིན་པ་མཐུ་དང་མི་ལྡན་པ་ལ་ནི་ལུས་ཀྱིས་རེག་པ་དང་འཁྲིག་པ་དང་ལྡན་པ་སྨྲ་བ་དང་།",
    "མོ་མི་མ་ཡིན་པའམ་ཕོ་མི་མ་ཡིན་པའམ།",
    "ཕོ་མོ་གཉི་ག་མི་མ་ཡིན་པར་གྱུར་ན་ཡང་དེའི་ཕྱིར་སྦོམ་པོའོ།",
    "དེ་དག་མོ་དང་ལྷན་ཅིག་དབེན་པ་ན་འདུག་པ་དང་།",
    "དེ་དག་གི་ཁྱིམ་དུ་དུས་མ་ཡིན་པར་འགྲོ་ཞིང་སྒོའི་གཏན་པ་ལས་འདས་པ་ལ་ནི་ཉེས་བྱས་སོ།",
    "དེ་དག་གི་སྐྱོན་ནས་སྨྲས་པ་དང་།",
    "དེ་དག་གི་རྩོད་པ་ལ་སྐྱོ་སྔོགས་བྱེད་པ་དང་།",
    "དེ་ལྟ་བུའི་བུད་མེད་དང་དགེ་སློང་མ་དང་དབེན་པ་ན་འདུག་པ་དང་།",
    "དེ་ལྟ་བུ་དག་གི་དམག་ལ་ལྟ་བ་དང་།",
