    "དཔའ་བོ་རྣམས་ཀྱིས་ཀྱང་དཔའ་བའི་ལན་གྲངས་མང་པོ་དྲག་པོས་བྱས་ན་མགུ་བར་འགྱུར་བ་དང་།",
    "མཛངས་པའི་ལས་ཀྱིས་ཀྱང་མཛངས་པའི་ལས་རླབས་ཆེར་བྱས་ན་མགུ་བར་འགྱུར་བ་དང་།",
    "མཁས་པ་རྣམས་ཀྱིས་ཀྱང་མཁས་པ་རྒྱ་ཆེར་བྱས་ན་མགུ་བར་འགྱུར་བ་དང་།",
    "རྒྱལ་པོ་རྣམས་ནི་ཤིན་ཏུ་ཡང་མཉེས་པར་བྱ་དཀའ་བ་ལས།་",
    "བསྟོད་པ་ཅེལེགས་པས་མཉེས་པར་གྱུར་ན་གཏེར་དང་འབྲུ་དང་ཕྱུགས་ལ་སོགས་པ་ཅི་བསམ་པ་ཕུན་སུམ་ཚོགས་པར་བྱེད་དོ།",
    "འཕགས་པ་འཆར་ཀས་རྒྱལ་པོ་རྣམས་ནི་བརྟེན་པར་དཀའ་བ་ཡིན་ཏེ་རབ་ཏུ་སྡུག་བསྔལ་བས་མཉེས་པར་འགྱུར་རོ།",
    "སྟོང་པ་དང་བདག་མེད་པར་སྟོན་པས་ན་དཀའ་ཞིང་ཟབ་པ་ཞེས་བྱ་སྟེ།",
    "དོན་རྣམས་ཀྱང་རྟོགས་པར་དཀའ་བས་ན་ཅི་ཟབ་པའོ།",
    "དེ་ནི་མི་རིགས་པར་བསྟན་པའི་ཕྱིར་སྤྱོད་ཡུལ་མ་ཡིན་ཞེས་སྨོས་ཏེ།",
    "ཇི་ལྟར་བྱིས་པ་རྣམས་ཀྱིས་གཟུང་བ་དང་འཛིན་པར་ཀུན་ཏུ་བརྟགས་པའི་རང་བཞིན་མེད་པ་ལ་དགོངས་ནས་མེད་དོ་ཞེས་གསུངས་པ་སྟེ།",
    "ལུང་མ་ིབསྟན་པར་བཏང་སྙོམས་སུ་གཞག་ཏུ་མི་རུང་བ་ལས་བརྩམས་ཏེ་ཚིགས་སུ་བཅད་པ་སྨྲས་པ།",
    "སེམས་ཙམ། མིའི་༡༤ཆེར་འཛིན་པས་ན་བཏང་སྙོམས་སུ་གཞག་པར་མི་རིགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་བཞིན་གཤེགས་པའི་ཡེ་ཤེས་ནི་འདས་པ་དང་ད་ལྟར་གྱི་དུས་འབའ་ཞིག་མཁྱེན་པ་མ་ཡིན་ཏེ།",
    "འདི་ལྟར་བྱས་ན་བདག་ཉིད་རྣམ་པར་གྲོལ་བར་འགྱུར་རོ་ཞེས་བསྟན་ན།",
    "སེམས་ཙམ། མི་༡༤རྒྱས་ཀྱིས་ཐབས་མ་ཡིན་པར་བསྟན་པའི་ཕྱིར་ཐབས་མིན་ཞེས་བྱ་བ་སྨོས་ཏེ།",
    "བདག་མེད་པར་མཐོང་བས་ཡིད་བྱུང་བར་འགྱུར་བའོ།",
    "རྣམ་པར་གྲོལ་བ་ཞེས་བྱ་བ་ནི་ལམ་གྱི་བདེན་པ་བསྒོམས་ནས་འགོག་པ་མངོན་སུམ་དུ་བྱ་བ་ནི་རྣམ་པར་གྲོལ་བའོ།",
    "གང་འདི་ལ་སྐྲག་པར་འགྱུར་བ་དེའི་ཕྱིར་གནས་མ་ཡིན་པ་ལ་སྐྲག་པར་འགྱུར་བའི་ཉེས་པ་དང་།",
    "འཇིགས་པར་བྱ་བའི་གནས་མ་ཡིན་པ་ལ་འཇིགས་ནས་སྐུར་པ་བཏབ་ན་གནས་མ་ཡིན་པ་ལ་སྐྲག་པ་ཞེས་བྱ་སྟེ།",
    "ཟབ་ཅིང་ཞེས་བྱ་བ་ལ་་མཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཐོབ་པར་བྱེད་པའི་ལམ་ས་དང་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་།",
    "འཕགས་པ་རྣམས་ཀྱིས་ཐུགས་སུ་ཆུད་པར་ཟད་དེ།",
    "སྟོང་པ་ཁོང་དུ་ཆུད་པར་བྱ་བའི་ཕྱིར།",
    "རྟག་ཏུ་ཞེས་བྱ་བ་ནི་ལན་ཅིག་བསྟན་པར་མ་ཟད་ཀྱི་རྒྱུན་མ་ཆད་པར་བསྟན་ཏེ།",
    "གཟུང་འཛིན་དུ་བྱིས་པ་རྣམས་ཀྱིས་ཀུན་ཏུ་བརྟགས་པའི་ཀུན་བརྟགས་མེད་པ་ལ་དགོངས་ནས་མེད་ཅེས་གསུངས་ཀྱི།",
    "བཅོམ་ལྡན་འདས་ཀྱི་བཀའ་ཐམས་ཅད་ནི་ཟབ་ཅིང་ཕྲ་བ་སྟེ་ཅི་ལ་དགོངས་པ་ཤིན་ཏུ་ཤེས་པར་དཀའ་ཞིང་རྟོགས་པར་ིདཀའ་བའོ།",
    "ཞེ་བསམས་ན་ཡང་སྐྲག་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "གཞན་དུ་ན་ནི་ལན་ཅིག་ཙམ་ཞིག་དགག་པ་མཛད་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ལ།",
    "ཐོགས་པ་དང་ཆགས་པ་མེད་པར་མངོན་དུ་གྱུར་པའི་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་བྱའོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ཐོབ་པར་བྱེད་པའི་ཐབས་ནི།",
    "དེ་ནས་མཉན་པ་དེ་ལ་བརྟེན་ནས་དེའི་འོག་ཏུ་མི་རྟག་པ་དང་སྡུག་བསྔལ་བ་དང་སྟོང་པ་དང་བདག་མེད་པར་བསམས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་དེ་ལྟར་རྣམ་པར་གྲོལ་ིབ་ཐོབ་ན།",
    "དེའི་འོག་ཏུ་རྣམ་པར་གྲོལ་བ་ལ་རྣམ་པར་གྲོལ་བ་ཉིད་དུ་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པའི་ཡེ་ཤེས་སྐྱེ་བར་འགྱུར་ཏེ་ཡེ་ཤེས་དེའི་མཚན་ཉིད་ཇི་ལྟ་བུ་ཞེ་ན།",
    "ཚངས་པར་སྤྱོད་པ་ནི་སྤྱད།",
    "གང་ིཚེ་རང་རིག་དེ་མེད་པར་ནི་ཇི་ལྟར་རྟོགས་པར་འགྱུར།",
    "ག་ཊ་སྐྲག་པའི་གནས་མ་ཡིན་པར་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "ཐབས་ཀྱི་ཆོ་ག་མཁས་ལ་གལ་ཏེ་བློ་སྦྱངས་མ་བྱས་དང་།",
    "ཐབས་ལ་མཁས་པའི་སྐྱེ་བོ་རྣམས་ཀྱི་རྗེས་སུ་འཇུག་པར་གྱིས།",
    "གལ་ཏེ་དེ་ཡང་མི་འདོད་ཁྱད་པར་ཉམས་ན་དགའ་བར་གྱིས།",
    "༩༦༥དང་བཅས་པར་བཏགས་པ་ཡིན་ཏེ།",
    "ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "སྲིད་པ་མི་གཙང་འབུ་ལྟ་བུའོ།",
    "ཟབ་ཅིང་རྒྱ་ཆེར་ལེགས་པར་གསུངས་པ་ཡི།",
    "དཔེར་ན་ཝ་རྣམས་ཀྱང་ཝ་ིདང་འགྲོགས་པར་དགའི།",
    "གཏི་མུག་པས་ནི་ཅིའི་ཕྱིར་ངེས་པར་བྱ།",
    "དེ་ཐོས་པ་ལ་སྟོབས་གཞན་མེད་པས་ཞེས་བྱ་བས་བཟང་བ་དང་ངན་པར་བྱེ་བྲག་དབྱེ་བ་དང་།་",
    "ཡིན་པ་དང་མ་ཡིན་པ་ཞེས་བྱེ་བྲག་དབྱེ་བ་འདི་ཡང་ཐོས་པའི་སྟོབས་ལས་མ་གཏོགས་པར་མ་ཐོས་པ་རྣམས་ཀྱིས་བྱེ་བྲག་ཕྱེད་པར་མི་ནུས་ཏེ།",
    "ཚུལ་བཞིན་མ་ཡིན་པར་ནི་མ་ཡིན་ནོ་ཞེས་ཚུལ་བཞིན་མ་ཡིན་པར་ཡིད་ལ་བྱེད་པ་ཉེས་པ་ཡིན་པར་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "༩༦༩པར་ཡིད་ལ་བྱས་ནས།",
    "དེ་ལྟར་ཚུལ་བཞིན་མ་ཡིན་པ་ཡིད་ལ་བྱས་ཏེ།",
    "སྐུར་པ་བཏབ་ན་ཉེས་པ་དང་སྐྱོན་ཡོད་པར་བསྟན་པ་ལས་བརྩམས་ནས་ཚིགས་སུ་བཅད་པ་བསྟན་པ།",
    "ལེགས་པར་གསུངས་ལ་རབ་སྨད་པས།",
    "ཐམས་ཅད་ནས་ཐམས་ཅད་དུ་མེད་པར་བཟུང་ནས།",
    "སྒྲ་ཇི་བཞིན་མ་ཡིན་པའི་དོན་དུ་མི་ཤེས་པར་ཁོང་ཁྲོ་བར་མི་རིགས་ན་ཞེས་བྱ་བ་ནི།",
    "དེ་ལྟར་ཞེ་སྡང་འདི་རང་བཞིན་གྱིས་གདུག་པ་ཡིན་པས་ན་གང་མི་ཕན་པར་སེམས་པའི་དགྲ་ལ་སོགས་པ་མི་རིགས་༧ པའི་གཟུགས་ལ་ཡང་ཞེ་སྡང་བསྐྱེད་པར་མི་རིགས་ན་གཞན་ལྟ་ལ་ཅི་སྨོས་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ལྟར་ན་སེམས་ཀྱི་ཞེ་སྡང་དེ་སེམས་གདུག་པ་ཅན་དུ་བྱེད་པས་ན་དགྲ་ལ་སོགས་པ་མི་རིགས་པར་བྱེད་པའི་གཟུགས་ལ་ཡང་ཞེ་སྡང་བསྐྱེད་པར་མི་རིགས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སེམས་དང་བཅས་པའི་ལུས་ལ་ལྟ་ཅི་སྨོས་ཞེས་བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་སོ།",
    "གལ་ཏེ་རྟོགས་༧པ་དེ་ཡང་ཁས་ལེན་པར་མི་བྱེད་ན་ནི།",
    "ཐེ་ཚོམ་དུ་གྱུར་པའི་གནས་ལ་ཞེ་སྡང་བསྐྱེད་པར་མི་རིགས་པ་ལྟ་སྨོས་ཀྱང་ཅི་དགོས་ཏེ།",
    "རང་བཞིན་གྱིས་ཁ་ན་མ་ཐོ་བ་དེས་མི་གོས་པར་འདོད་པ་རྣམས་ཀྱིས་ཞེ་སྡང་མི་སྡང་མི་སྐྱེད་པར་བཏང་སྙོམས་སུ་བཞག་པ་ཉིད་ལེགས་ཏེ།",
    "ཁ་ནས་དབྱེ་སྐྱབས་སུ་འགྲོ་བའི་ཁྱད་པར་བསྡུས་པ་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "དབྱེ་བའི་རང་བཞིན་རྣམ་བཞིའི་དོན་གྱི་ཁྱད་པར་སྟོན།",
    "ཁས་བླངས་པའི་ཁྱད་པར་དང་།",
    "རྟོགས་པའི་ཁྱད་པར་དང་།",
    "ཟིལ་གྱིས་གནོན་པའི་ཁྱད་པར་རོ།",
    "ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ལ་གཞག་པར་བྱ་བའི་ཐབས་ལ་མཁས་པ་ཡིན་ཏེ།",
    "བསྒྲུབ་པའི་ཁྱད་པར་དང་།",
    "འབྲས་བུ་ཐོབ་པའི་ཁྱད་པར་རོ།",
    "ཅེས་བྱ་བས་འབྲས་བུ་ཐོབ་པའི་ཁྱད་པར་བསྟན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་ཀུན་ཏུ་འགྲོ་བ་རྣམ་པ་བཞི་དང་ལྡན་པས་ཀུན་ཏུ་འགྲོ་བ་ཁྱད་ཞུགས་པར་རིག་པར་བྱ་སྟེ།",
    "ཉན་ཐོས་དག་ནི་གང་ཟག་ལ་བདག་མེད་པ་ཙམ་རྟོགས་པར་བྱ་བའི་ཕྱིར་སེམས་བསྐྱེད་ལ།",
    "འདིས་ནི་ཡེ་ཤེས་ཀུན་ཏུ་འགྲོ་བ་དང་ལྡན་པར་བསྟན་ཏོ།",
    "ཉན་ཐོས་དག་ནི་ཞི་བ་ཕྱོགས་གཅིག་པའི་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་བྱ་བའི་ཕྱིར་སེམས་བསྐྱེད་ལ།",
    "དེའི་ཡོན་ཏན་དང་ཉེས་པ་ལ་རྣམ་པར་མི་རྟོག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ལ།",
    "ཁས་བླངས་པའི་དོན་དེ་ཡང་ཁྱད་པར་རྣམ་པ་གསུམ་གྱིས་རིག་པར་བྱ་སྟེ།",
    "བསྒྲུབ་པའི་ཁྱད་པར་དང་།",
    "ཐོབ་པའི་ཁྱད་པར་རོ།",
    "གང་རྣམས་སྐྱོ་བ་མེད་པར་དཀའ་བ་སྤྱོད།",
    "འདིས་བསྒྲུབ་པའི་ཁྱད་པར་བསྟན་ཏོ།",
    "ཚོགས་མཉམ་པ་ཐོབ་པར་འགྱུར་ཏེ།",
    "འདིས་ནི་འབྲས་བུའི་ཁྱད་པར་བསྟན་ཏོ།",
    "གོང་དུ་ཡོན་ཏན་རྣམ་པ་གསུམ་གྱིས་ཁྱད་པར་ཁས་བླངས་པ་ཁྱད་ཞུགས་པར་བསྟན་ནས།",
    "ད་ཡང་ཚིགས་སུ་བཅད་པ་གཞན་གྱིས་ཁས་བླངས་པ་དེ་ཁྱད་ཞུགས་པར་སྟོན་ཏེ།",
    "དེ་ནི་ཁས་བླངས་མཆོག་ཏུ་བློ་ལྡན་ཤེས་པར་བྱ།",
    "༩ ༨ ༡རིགས་མི་གཅོད་པར་གནས་པ་ཡིན་ཏེ།",
    "མ་ཕུན་སུམ་ཚོགས་པར་འགྱུར་ལ།",
    "རིམ་གྱིས་ིསྐྱེས་ནས་འཁོར་ལོས་སྒྱུར་བའི་རིགས་མི་གཅོད་པར་གནས་པར་འགྱུར་རོ།",
    "དེ་ཉན་ཐོས་ལ་སོགས་པའི་ཁས་བླངས་པ་པས་ཁས་བླངས་པའི་མཆོག་ཏུ་རིག་པར་བྱ་སྟེ།",
    "ཡེ་ཤེས་ཀྱི་ཚོགས་ཀྱང་དེའི་མི་མཐུན་པའི་ཕྱོགས་སུ་གྱུར་པ་སེར་སྣ་ལ་སོགས་པས་དྲི་མ་ཅན་དུ་མ་བྱས་ན་གདོད་འཚང་རྒྱ་བའི་རྟེན་དུ་འགྱུར་གྱི།",
    "དེ་ལྟར་ཡོན་ཏན་རྣམ་པ་བཞི་དང་ལྡན་པར་སྐྱེས་པ་དང་།",
    "ཡོན་ཏན་རྣམ་པ་བཞི་དང་ལྡན་པར་སྐྱེས་པ་ནི།",
    "སློབ་ད་ཡོ་ལེགས་པར་སྐྱེས་པ་དེ་ཉིད།",
    "ལུས་ཀྱི་ཁྱད་པར་གྱིས་ཁྱད་པར་ཅན་དུ་བྱས་པས་ཁས་ལེན་པ་དེ་ཉིད་ཀྱི་ཁྱད་པར་ཚིགས་སུ་བཅད་པ་གཞན་གྱིས་བསྟན་ཏོ་ཞེས་བྱ་བ་ལ།",
    "ཡོན་ཏན་རྣམ་པ་བཞི་དང་ལྡན་པར་སྐྱེས་པ་དེ་ཉིད་ལེགས་པར་སྐྱེས་པ་ཞེས་བྱ་སྟེ།",
    "ཞེས་བྱ་བ་ལ་དཔེར་ན་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོའི་སྲས་སུ་སྐྱེས་ན་ཡོན་ཏན་རྣམ་པ་ཡིབཞི་དང་ལྡན་པའི་ལུས་ཀྱི་ཁྱད་པར་འཐོབ་སྟེ།",
    "དཔེ་བྱད་བཟང་པོ་བརྒྱད་ཅུས་བརྒྱན་པའི་ལུས་ཐོབ་པས་ན་གཟུགས་བཟང་པོའི་ཁྱད་པར་དང་ལྡན་ཏེ།",
    "དེ་བས་འཕགས་པར་བསྟན་པའི་ཕྱིར་སྣ་ཚོགས་སྨོས་ཏེ།",
    "དཔེར་ན་འཁོར་ལོས་ིསྒྱུར་བའི་རྒྱལ་པོའི་སྲས་དེ་དགྲའི་ཚོགས་རྣམས་གཞོམ་པར་ནུས་པའི་ལུས་ཀྱི་རྩལ་དང་ལྡན་པ་བཞིན་དུ།",
    "དེ་བས་ན་བདེ་བའི་ཁྱད་པར་དང་ཡང་ལྡན་ནོ།་།",
    "དེ་བས་ན་ཡེ་ཤེས་ཀྱི་ཁྱད་པར་དང་།",
    "ལྷག་པར་བྱ་བ་བརྟགས་པ་ལ་མཁས་པ་དང་།",
    "ཕན་འདོགས་པར་བྱེད་པའོ།",
    "འཁོར་དེ་དག་གདུལ་བར་བྱ་བའི་ཐབས་ཀྱང་ཤེས་པར་འགྱུར་ཏེ།",
    "མིའི་༡༤པ་ལ་མཁས་པར་བསྟན་ཏོ།",
    "འདིས་ནི་ཚར་གཅོད་ཅིང་ཕན་འདོགས་པར་བྱེད་པ་བསྟན་ཏོ།་",
    "ཡང་ཁྱད་པར་དེ་བློན་པོ་ཆེན་པོ་ལྟ་བུའི་ིཚིགས་སུ་བཅད་པ་གཞན་གྱིས་བསྟན་ཏེ་ཞེས་བྱ་བ་ལ།",
    "བཞིན་གཤེགས་པས་ཐུགས་བརྟན་པའི་གནས་ཡིན་པས་ཕ་རོལ་ཏུ་ཕྱིན་པ་བཅུ་ལ་སོགས་པའི་ནང་དུ་འཇུག་ཅིང་སྤྱོད་པར་བྱེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མི་བརླག་པར་བྱ་བའི་ཕྱིར་རྟག་ཏུ་སྦྱིན་ིབྱེད་ཅིང་ཉུལ་བར་བྱེད་པ་དེ་བཞིན་དུ།",
    "མི་བརྗེད་པར་སེམས་ལ་འཛིན་པར་བྱེད་དོ།",
    "གསང་བའི་གནས་ཀྱང་རྣམ་གསུམ་རྟག་པར་ཤིན་ཏུ་འཛིན་པའི་ཕྱིར།",
    "དཔེར་ན་རྒྱལ་པོའི་བློན་པོ་ཆེན་པོ་རྒྱལ་པོའི་བྱ་བ་ཐམས་ཅད་ཀྱང་བྱེད་ཅིང་འབངས་ཆབ་འོག་ཏུ་གཏོགས་པ་རྣམས་སྐྱོང་ཞིང་ཚིམ་པར་བྱེད་པ་དེ་བཞིན་དུ།",
    "མིའི་༡༤དེ་ལ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ལ་ལྷུན་གྱིས་གྲུབ་པར་གནས་པའི་དཔེ་ཡང་རྒྱ་མཚོའི་གྲུ་བོ་ཆེས་བསྟན་པ་ལྟ་བུའོ།",
    "བག་ཆགས་ལས་ཀྱང་བཟློག་ཅིང་སྲིད་ཞི་རྣམ་པར་གྲོལ་བ་ཐོབི།",
    "འདི་ནི་ཡོན་ཏན་བདུན་པའོ་། སྲིད་ཞི་རྣམ་པར་གྲོལ་བ་ཡང་འཐོབ་སྟེ།",
    "ཞི་བ་ནི་མྱ་ངན་ལས་འདས་པ་སྟེ་མྱ་ངན་ལས་འདས་པ་ལས་རྣམ་པར་གྲོལ་ཞིང་མྱ་ངན་ལས་འདས་པ་ལ་ཡང་མི་གནས་སོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕུང་པོའི་ལྷག་མ་མ་ལུས་པར་སྤངས་པའི་མྱ་ངན་ལས་འདས་པར་ཞུགས་ཀྱང་ཟད་ཅིང་མཐར་ཐུག་པར་མི་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་ཐམས་ཅད་མཁྱེན་པ་ཞེས་བྱ་བ་ལི།",
    "གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་འགྲུབ་པར་འགྱུར་བས་དོན་ཆེ་བ་ཞེས་བྱའོ།",
    "མི་༡༤འཆད་པར་བྱེད་དེ།",
    "དཔག་ཏུ་མེད་པ་དང་རྟོག་གེ་དང་གྲངས་དང་དུས་དཔག་ཏུ་མེད་པར་རིག་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ།",
    "གྲངས་ཀྱི་སྒོ་ནས་ཀྱང་གྲངས་འབུམ་ཞེའམ་བྱེ་བ་ཡོད་ཅེས་དཔྱད་པར་མི་ནུས་པ་དང་།",
    "དེ་ལྟར་བདག་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་འགྲུབ་པར་བྱེད་པ་དེ་ཡང་ངེས་པ་མེད་དེ།",
    "དཔེར་ན་གང་ན་དུ་བ་སྣང་བ་དེ་ན་མཚན་མ་དེས་མེ་ཡོད་པར་བརྟག་པ་དང་།",
    "གང་ན་ཆུ་བྱ་སྣང་བ་དེ་ན་ཆུ་ཡོད་པར་བརྟག་པ་བཞིན་དུ།",
    "ཡོན་ཏན་འདི་དང་འདི་དག་ཐོབ་པར་འགྱུར་རོ་ཞེས་རིགས་ཀྱི་ཡོན་ཏན་ཡང་སྟོན་ཏོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཡོད་པར་རྣམ་པར་དབྱེ་ིབའི་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "འདི་ལྟར་འབྲས་བུ་བཟང་ངན་རྣམ་པ་གསུམ་ཡང་ཡོད་པར་དམིགས་ཏེ།",
    "འབྲས་བུ་བཟང་ངན་གསུམ་དམིགས་པས་དེ་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་ཡང་རྣམ་པ་གསུམ་མེད་དུ་མི་རུང་ངོ།",
    "མཆོག་ཏུ་རྣམ་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "ཁྱད་པར་འཕགས་དང་ཐམས་ཅད་དང་།",
    "ཁྱད་པར་དུ་འཕགས་པའི་རྒྱུ་བྱེད་པ་དང་།",
    "ཁྱད་པར་དུ་འཕགས་ཞེས་བྱ་བ་ནི་གསལ་བ་དང་དག་པ་ལ་བྱའོ།",
    "དེ་བས་ན་ཉན་ཐོས་ཀྱི་རིགས་པས་ཁྱད་པར་འཕགས་པར་རིག་པར་བྱའོ།",
    "མཚན་ཉིད་རྣམ་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "ཡང་དག་པར་བསྒྲུབས་པ་དང་།",
    "དེ་ལ་རྒྱས་པ་ཞེས་བྱ་བ་ནི་ཡང་དག་པར་བསྒྲུབས་པའི་རིགས་ལ་བྱ་བར་རིག་པར་བྱའོ།",
    "ཡོད་དང་མེད་པར་ཤེས་པར་བྱ།་།",
    "ཞེས་བྱ་བ་ལ་རང་བཞིན་ལ་གནས་པའི་རིགས་ནི་རྒྱུ་ཡིན་ལ་ཡང་དག་པར་བསྒྲུབས་པའི་རིགས་ནི་རྒྱུ་དེའི་འབྲས་བུ་ཡིན་པས་རང་བཞིན་ལ་གནས་པའི་དུས་ན་ནི་རྒྱུའི་མཚན་ཉིད་དུ་ཡོད་ལ་འབྲས་བུའི་མཚན་ཉིད་དུ་མེད་པ་ཞེས་བྱ་སྟེ།",
    "ཡང་དག་པར་བསྒྲུབས་པའི་རིགས་ནི་རྒྱུའི་མཚན་ཉིད་དུའང་ཡོད།",
    "ལས་འག་ནམཚན་མ་རྣམ་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "མཚན་མའི་དོན་རྒྱས་པར་འཆད་དེ།",
    "དཔེར་ན་དུད་པ་སྣང་བའི་མཚན་མས་མེ་ཡོད་པར་བརྟགས་པ་དང་།",
    "ཆུ་བྱ་སྣང་བའི་མཚན་མས་ཆུ་ཡོད་པར་བརྟགས་པ་བཞིན་དུ་མཚན་མའམ་རྟགས་རྣམ་པ་བཞི་སྣང་བ་དེ་ལ།",
    "རང་བཞིན་གྱིས་བཟོད་པ་ལ་གནས་པར་དགའ་བ་དང་།",
    "རང་བཞིན་གྱིས་བརྩོན་འགྲུས་རྩོམ་པར་དགའ་བ་དང་།",
    "རང་བཞིན་གྱིས་བསམ་གཏན་ལ་གནས་པར་དགའ་བ་དང་།",
    "རྐྱེན་གྱིས་མི་འཕྲོགས་པའོ་། དེ་ལ་རིགས་ངེས་པ་ནི་གང་ཉན་ཐོས་སུ་རིགས་ངེས་པར་གནས་པ་དང་།",
    "ངེས་པར་གནས་པ་སྟེ།",
    "དངུལ་དང་ཟངས་ལ་སོགས་པར་མི་འགྱུར་བ་ཡང་ཡོད།",
    "གསེར་དང་ཟངས་ལ་སོགས་པར་མི་འགྱུར་བ་ཡང་ཡོད།",
    "གསེར་དང་དངུལ་ལ་སོགས་པར་མི་འགྱུར་བ་ཡོད་པ་ལ་རིའི་ཕྱོགས་ལ་ལ་ནི་ས་དང་རྡོ་ལ་སོགས་པ་ཡོད་པ་བཞུ་ཞིང་སྦྱངས་པ་དང་།",
    "ཉེས་པ་རྣམ་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "ལེགས་པ་རྣམ་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ།",
    "གསེར་གྱི་རིགས་བཞིན་ཤེས་པར་བྱ།",
    "པ་༢༡ ༡༣རིགས་ཀྱང་ཡོན་ཏན་རྣམ་པ་བཞིའི་གནས་བྱེད་པས་ན་གསེར་ཆེན་པོའི་རིགས་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "མིའི་༡༤དེ་ལས་བྱུང་བའི་གསེར་གྱིས་མགོ་རྒྱན་དང་དཔུང་རྒྱན་ལ་སོགས་པར་བྱས་ན་ཡང་འགས་པ་ཁྲོ་མེད་པར་གསེར་ལས་སུ་རུང་བའི་གནས་སུ་གྱུར་པ་དེ་བཞིན་དུ།",
    "ར་རིགས་མེད་པ་ལ་རྣམ་པར་དབྱེ་བའི་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ལ།",
    "དེའི་དུས་ན་རིགས་ཡོད་ཀྱང་མ་གསོད་པའི་ལས་ངན་པ་བྱས་པས་རིགས་དེས་མྱ་ངན་ལས་འདས་པ་ཐོབ་པར་མི་འགྱུར་ཏེ།",
    "བུ་ངན་པ་ལ་བུ་མེད་ཅེས་བྱ་བ་བཞིན་དུ་རིགས་དེ་ཡང་དེའི་དུས་ན་ངན་ཅིང་ཞེན་པར་གྱུར་པས་རིགས་མེད་པ་ཞེས་བཏགས་སོ།"
  ]
}