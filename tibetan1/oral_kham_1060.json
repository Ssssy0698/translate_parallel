    "བཀག་པས་ཁེགས་པར་མི་འདུག་དིང་རི་བ་། དང་།",
    "རྣམ་རྟོག་ཁོ་རང་གང་བྱེད་དུ་བཞག་ཅེས་སོགས་ཁྲིད་ཡིག་ཏུ་གསུངས་པའི་ཕྱིར་འདི་ནི་ཞི་གནས་རང་ལ་དཔགས་པའི་ཁ་ཡན་དུ་སྐྱོང་བ་སྟེ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "ལུས་སེམས་ཡོད་དུ་མི་ཚོར་བ་བར་སྣང་སྟོང་པ་ལ་འདུག་པ་ལྟ་བུ་ལ་སོགས་པའི་ཉམས་ཀྱི་སྣང་བ་འཆར་བའོ།",
    "དེ་དུས་ཀྱི་གནས་པ་དང་འགྱུ་བ་ངོ་ཤེས་མཁན་དེ་ལ་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པའམ་སོ་སོར་རྟོག་པའི་ཤེས་རབ་དང་རང་རིག་པ་ཞེས་ཀྱང་བྱ།",
    "དེས་གནས་འགྱུ་རང་བཞིན་མེད་པར་སྦྱངས་མཐར་ཤེས་རབ་ཁོ་རང་ཡང་དམིགས་སུ་མེད་དེ་དཔེར་བཀོད་པའི་གཙུབ་ཤིང་དང་གཙུབ་གཏན་བསྲུབས་པ་ལས་སྐྱེས་པའི་མེས་ཤིང་གཉིས་བསྲེག་མཐར།",
    "ཕྱོགས་སྔ་མ་ལ་སུན་འབྱིན་ཅིང་ཡོད་པ་ཁྱེད་རང་ལ་བཟློག་པའི་ཕྱིར་དང་།",
    "གསལ་བའི་ངོས་བཟུང་དང་དེའི་རྣམ་པ་ཅན་དུ་འདུག་བརྟག་སྟོང་པར་འདུག་ན་ཅང་མེད་ཀྱི་སྟོང་པ་དང་བར་སྣང་ལྟ་བུའི་སྟོང་པ་ཇི་ལྟར་འདུག་བརྟག་གསལ་ན་ཉི་ཟླ་ལྟ་བུའམ་མར་མེ་ལས་འོད་འཕྲོ་བ་ལྟ་བུར་གསལ་བ་དང་འོད་དང་ཁ་དོག་མེད་པའི་རང་གསལ་དུ་འདུག་ལ་སོགས་པ་སྒོ་དུ་མ་ནས་བརྟག་ཅིང་དཔྱད།",
    "གསུམ་པ་རྗེས་ལ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲོད་པ།",
    "དང་པོ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲོད་པ་ནི།",
    "ཚོགས་ཞིང་རང་ཐིམ་སྤྲོས་མེད་ངང་དུ་བཞག།",
    "འཁྲུལ་པ་བདོ་ཙ་ན་དེའི་རང་བཞིན་ཤེས་པས་འཁྲུལ་མེད་དུ་གཏན་ལ་ཕེབས་པས་ཡེ་ཤེས་སུ་ཤར་བ་སྟེ།",
    "རབ་ཏུ་དམའ་བའི་ས་ལ་འདུག།",
    "གཞན་འབྱོར་ལྔ་སྟེ་བཅུའོ་། དེ་ཡང་རང་འབྱོར་ལྔ་ནི།",
    "རབ་ཏུ་དོག་པ་མུན་ནག་འཐིབས་པོར་འདུག་པ་ཡི།",
    "ལྷ་མིན་དག་ནའང་རང་བཞིན་གྱི་ལྷ་ཡི།",
    "རང་ཉིད་སེང་གེའི་ཁྲིར་འདུག་པ་དང་།",
    "དེ་ལྟར་མི་འདུག་ན་ཕུགས་སུ་བསྟོངས་ལ།",
    "བདག་ཚེ་འདིའི་ཆེ་ཐབས་དང་ཕུན་སུམ་ཚོགས་པ་ཞིག་ཡིད་ཁོངས་སུ་བཅུག་ནས་དེ་ལ་སྨོན་ཅིང་འདུག་སྟེ།",
    "གང་ཅི་མང་ཡང་སྡུག་བསྔལ་གྱི་སྣོན་པ་མིན་པ་བདེ་བའི་གོ་སྐབས་སྐད་ཅིག་ཀྱང་མི་འདུག་ན།",
    "འབྲས་བུ་ལ་ལོངས་སྤྱོད་ཀྱིན་འདུག་ན།",
    "ཐ་ན་འཇག་མའི་སྲིན་བུ་ཡན་ཆད་ཀུན་ལ་ཡོངས་བར་འདུག།",
    "ཚེ་ཕ་རོལ་བསམ་ན་རན་ནས་གདའ་ལུས་སྐྱེས་སུ་གསོས་པ་བཏབས་ཏེ་བཞག།",
    "འགྱུ་བ་ཁོ་རང་བལྟས་པས་མཐོང་རྒྱུ་ཅི་ཡང་མེད་པར་ཅུང་ཟད་དེ་ཁའི་ངང་ལ་གནས་པའི་ཚེ་རྣམ་རྟོག་ཐོལ་ཐོལ་འཕྲོ་བ།",
    "ད་ནས་རྣམ་རྟོག་ཁོ་རང་ལ་བསྒོམ་གྱི་ངོ་ཏི་གྱིས།",
    "ངོས་བཟུང་མཁན་ཁོ་རང་ལ་གཅེར་གྱིས་བལྟས་པས།",
    "དང་འགྱུ་བ་གཉིས་སུ་མེད་པར་གཅིག་པུའི་ངང་དུ་འདྲེས་ནས་བསམ་བརྗོད་བྲལ་བར་གསལ་སེང་ངེ་བ་ཅིག་འདུག་ལགས།",
    "ལར་བསྒོམས་པའི་ཡོན་ཏན་ཉམས་ཀྱི་དྲོད་རྟགས་བསམ་གྱིས་མི་ཁྱབ་པ་ཡོང་བར་འདུག་པས་ཁྱེད་ལ་མ་༡ལེགས་པ་གཅིག་འོང་བའི་སྔ་ལྟས་ཡིན།",
    "བརྗོད་དུ་མ་གཏུབ་པ་ཅིག་འདུག་ལགས།",
    "དྲན་རིག་དུ་ལམ་གྱི་འགྲོ་བ་དཔེར་ན་མཚོ་ལ་ཁ་བ་བབས་པ་ལྟ་བུ་རང་གྲོལ་དུ་འགྲོ་བ་ཅིག་འདུག་ལགས།",
    "ད་ཁྱེད་ཀྱི་གནས་ལུགས་ཇི་ལྟར་འདུག།",
    "སྤྲིན་ཐག་ཆད་པའི་ནམ་མཁའ་ལྟ་བུ་མཐའ་བྲལ་གྱི་ངང་དུ་ལྗོན་ལྷང་ངེར་གནས་པ་ཞིག་འདུག་ལགས།",
    "སྟོང་ཉམས་ཤིན་ཏུ་ཆེ་བས་རང་ལུས་ཀྱང་སྟོང་སྙམས་ནས་རང་བཞིན་བྲལ་བ་སེམས་དང་ལུས་སོགས་གཉིས་འཛིན་དང་སྟོང་འཛིན་ཞེན་འཛིན་མེད་པ་ཅིག་འདུག་ལགས།",
    "རྗེས་ཤེས་ཨ་འཐས་རྩེ་གཅིག་དུས།",
    "མི་རྟོགས་ཡེ་ཤེས་ཤར་ཙ་ན།",
    "མཁའ་ལ་ཉི་མ་ཤར་ཙ་ན།",
    "ཡང་ལྟ་བ་བདེ་ཆེན་ཟིན་ཙ་ན།",
    "ཤེས་བྱ་གཤིས་ལ་ཕེབས་ཙ་ན།",
    "ང་རྣལ་འབྱོར་བྱ་བ་ཚར་ནས་གདའ་ཞེས་གསུངས་པ་ལྟར་དུ་ཡིན།",
    "དགུང་ལོ་བརྒྱད་ཅུ་གྱ་བརྒྱད་བཞུགས་ཟེར་བ་རྨིས་ཅི་ཡིན་སྙམ་ཙ་ན།",
    "ད་ལྟ་གྲགས་པ་ཆེན་པོ་མི་ཡོང་ངན་སྐུར་འདེབས་མཁན་མང་པོ་ཡོང་སྟེ་ཁོ་རང་བྱད་མ་རང་གཤེད་དུ་འགྲོ།",
    "ད་ནི་ང་ནི་རྣལ་འབྱོར་བཞི་པོ་མཉམ་བཞག་གཅིག་པུའི་ཀློང་དུ་རྫོགས་ནས་གདའ་གསུངས།",
    "ཞལ་གདམས་ཉི་ཤུ་གསུམ་པའོ་། ད་ནི་ང་ལ་བདེ་བ་ཅན་གྱི་ཞིང་ཁམས་མངོན་སུམ་དུ་མཐོང་བར་ཡོད་དེ་ཡང་རང་སྣང་ལས་གཞན་མ་ཡིན་ནོ།",
    "འཁྲུལ་སྣང་རང་གྲོལ་ནུས་པ་ངོ་བོ་སྐྱོང་བ།",
    "ད་ཁྱེད་དང་ང་རང་གཉིས་འདི་ཕྱི་ཀུན་ཏུ་འབྲལ་མེད་དེ།",
    "ད་ཁྱེད་རང་སང་སྟོན་ཟླ་འབྲིང་པོའི་ཚེས་ལ་འདི་གར་སླེབ་པར་གྱིས་ཤིག།",
    "བཞུགས་གང་རང་འདྲའི་བློ་རྟུལ་རྣམས་ཀྱི་ངོར།",
    "ད་ལྟར་གྱི་ཤེས་པ་ཡང་དག་རྣལ་མར་ཙན་གྱིས་ཞོག་དེ་ལ་འདས་པའི་རྗེས་མི་དཔྱོད་ཟེར་ཙ་ན།",
    "མ་འོངས་པའི་སྔོན་མི་བསུ་ཀྟྲིཟེར་ཙ་ན།",
    "ད་ལྟར་གྱི་ཤེས་པ་རྣལ་མར་ཙན་གྱིས་ཞོག་ཟེར་ཙ་ན།",
    "དེ་དུས་ལུསཀྐེ་། ཅོག་གེར་འདུག་ཀྱང་དོན་མེད་སྟོང་འདུག་ཡིན།",
    "ནོར་ཕྱུགས་རྣམས་རྩྭ་ཆུ་ཡོད་པའི་ཕྱོགས་སུ་བཞག་ནས་འགྲོ་འདུག་གང་བྱེད་ཀྱང་བྱེད་དུ་བཅུག་ཅིང་།",
    "སྔར་གྱི་གཉེན་པོ་ཐམས་ཅད་རྣམ་རྟོག་སྐྱེས་འདུག་པས་མ་ཡེངས་པར་བྱེད་དགོས་སྙམ་པ་སོགས་བྱ་རྩོལ་སྤོང་ལེན་གྱི་ཉེར་དགུ་སྤྲོས་པས་བསླད་པའི་བཟུང་དྲན་ཁོ་ན་སྟེ།",
    "ལུས་སེམས་ཡོད་དུ་མི་ཚོར་བར་བར་སྣང་སྟོང་པ་ལ་འདུག་པ་ལྟ་བུ་དང་།",
    "རྣམ་པར་རྟོག་པ་ཕྲ་རགས་གང་ཡང་རུང་བ་སྐྱེས་པ་དང་དེ་ངོ་ཤེས་པའི་དྲན་རིག་དུས་མཉམ་དུ་ལངས་ནས།",
    "གནས་ན་གནས་པའི་ངོ་བོ་ཇི་ལྟ་བུ་ཞིག་འདུག་ཚུལ་ཇི་ལྟར་གནས།",
    "འགྱུ་བའི་ཚེ་གནས་པ་ཨེ་འདུག་འགྱུ་བ་དེ་གནས་པ་ལས་གཞན་པ་ཞིག་ཡིན་ནམ་མིན།",
    "འགྱུ་བ་དེ་ཀའི་ངོ་བོ་ངོས་བཟུང་ཇི་ལྟ་བུ་ཞིག་འདུག་མཐར་འགྱུ་ཆ་འགག་པའི་ཚུལ་ཇི་འདྲ་ཞེས་དཔྱད།",
    "གནས་དུས་འགྱུ་མཁན་སོགས་འདུག་སྙམ་ན།",
    "འགྲོ་དུས་གཅིག་འགྲོ་གཅིག་འདུག་གམ།",
    "མཉམ་འགྲོ་མཉམ་འདུག་ཇི་ལྟར་བྱེད་བལྟ།",
    "ཡང་གནས་དུས་འགྱུ་བ་མིན་འདུག་ཅིང་།",
    "འགྱུ་དུས་ཀྱང་གནས་པ་མིན་འདུག་པས་དེ་གཉིས་གཅིག་གོ་སྙམ་ན།",
    "འགྱུཆའི་རྣམ་རྟོག་མེད་དུས་གཅིག་པར་འདུག་གམ།",
    "ཡོད་དུས་གཅིག་པར་འདུག་མེད་དུས་གཅིག་པར་འདུག་སྙམ་ན།",
    "ཁོང་གཉིས་འདྲེས་པའི་ཚུལ་དུ་གཅིག་པར་འདུག་གམ་སོགས་དཔྱད་རྣམ་རྟོག་ཡོད་དུས་གཅིག་པར་འདུག་སྙམ་ན།",
    "དེའི་ཚེ་བལྟ་བྱ་དང་ལྟ་བྱེད་དབྱེར་མེད་པའི་ཤེས་པ་གསལ་སྟོང་རང་རིག་རང་གསལ་ཙམ་ཞིག་ཉམས་སུ་མྱོང་བ་འབྱུང་།",
    "ཤེས་རབ་ཁོ་རང་ཡང་དམིགས་པ་མེད་པའི་ངང་དུ་ཞི་ཚུལ།",
    "དེའི་ཚེ་རང་གཤིས་སུ་གནས་པའི་ཆ་དེ་ཞི་གནས་ལུགས་དང་རང་ངོ་ཤེས་པའི་ཆ་དེ་ལྷག་མཐོང་སྟེ་ཞི་ལྷག་ཟུང་འཇུག་གོ།",
    "སྔ་མ་དེ་ལ་གནས་འགྱུ་ངོ་ཤེས་པའི་གསལ་ཆ་ཡོད་ཀྱང་རང་ངོ་ཤེས་པའི་རིག་ཆ",
    "དེ་སྐབས་སྣང་བ་ཐམས་ཅད་སྣང་ཙམ་གྱི་དུས་ཉིད་དུ་སེམས་ཉིད་དུ་རྟོགས་པ་ནི་སྣང་ཐོག་ཏུ་སེམས་ཀྱི་འདུག་ཚུལ་རིག་པ་ཞེས་བྱ་ལ།",
    "ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲོད་པ་དང་གེགས་དང་གོལ་ཤོར་གཅོད་པ་དང་།",
    "དང་པོ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲད་པ་ནི།",
    "རང་སར་རང་ངོ་ཤེས་ཤིང་རང་གྲོལ་བ་ལ་ཕྱག་རྒྱ་ཆེན་པོ་ཟེར་བ་ཡིན་ནོ་། འོད་གསལ་ནི་སྣང་མེད་སྤྲོས་བྲལ་ཡིན་ལ།",
    "མ་བཟུང་མ་བཏང་རང་ག་ཉིད་དུ་ཞོག།",
    "རོ་གཅིག་དུས་སུ་མཉམ་རྗེས་འདྲེས།",
    "རྩེ་གཅིག་དུས་སུ་གཟུགས་ཀྱི་ཕུང་པོ་དང་བྲལ།",
    "གོམས་གཤིས་དེ་ཡང་རང་ཉིད་ཀྱི་ལག་ཏུ་ཡོད་པས།",
    "འཇིག་རྟེན་གྱི་ཆུ་སྣ་ཐམས་ཅད་ཁོ་རང་ལ་དགའ་བར་བྱེད།",
    "ཁོ་རང་ནི་ཇི་འདྲའི་རླབས་ཆེན་ཞིག་མ་ཡིན་ནམ།",
    "འཆི་བའི་རིན་ཐང་རང་ཉིད་ཀྱི་ལག་ཏུ་ཡོད་པས་ཅིས་ཀྱང་རིན་ཐང་དུ་བརྩོན་པར་བྱེད་དགོས།",
    "བསྟོད་པ་དེ་སེམས་ཤུགས་ཀྱི་སྒུལ་ཤུགས་སུ་འགྲོ་དགོས་པ་ལས་ནམ་ཡང་རང་རློམ་གྱི་ལྟ་བ་འཛིན་མི་རུང་།",
    "ལམ་གྱི་ཡོན་ཏན་དག་ལོངས་སྤྱོད་ཀྱི་སྐལ་བ་ལྡན་མིན་ནི་མི་རང་རང་སོ་སོའི་ནུས་པ་དང་བསམ་བློའི་སྟོབས་ཤུགས་ལ་རག་ལས་པས།",
    "ཁྱེད་རང་བཙོན་དུ་འཇུག་དོན་ཅི་ཡིན་ནམ་ཞེས་དྲིས་པར།",
    "ཁོ་རང་སྐྱོན་མེད་དུ་ལུས་པ་ཞིག་ཡོང་ངེས་ཞེས་ངས་ཁས་ལེན་བྱེད།",
    "བདུན་པ་བཅས་ཀྱི་ནང་ང་རང་ལྗོངས་སྲིད་གྲོས་ཀྱི་རྒྱུན་ལས་ཨུ་ཡོན་ལ་འདེམས་བསྐོ་གནང་རྗེས་སེམས་འགུལ་དང་སྐུལ་ལྕག་ཆེས་ཆེར་ཐེབས་ཏེ་སྲིད་གྲོས་ཏང་ཙུའུ་ཡི་ཐད་ཀའི་འགོ་ཁྲིད་འོག་རྒྱལ་གཅེས་དང་།",
    "སུམེས་བསྲེགས་འདུག་པས་ནི།",
    "ཞེས་པས་སྣུམ་དག་འདི་སཾ་ཡིག་ཏུ་རིགས་ཤིང་བི་བྷཱུཏིའི་ཕྱག་དཔེར་ཡང་རྨིག་འདུག་གོ་ཞེས་ཟེར་རོ།",
    "ཞེས་འགྱུར་མངས་འདུག་ཅིང་དགོས་པར་སྣང་སྟེ་འདིའི་རྒྱུ་དཔེ་སྨད་ཅེས་གསུང་ངོ།",
    "རང་འོད་ཀྱི་ཤེས་རབ་ནི་སྐྱེ་བ་པོའི་ཁོངས་སུ་གཏོགས་ལས་གསུངས་ཤིང་རང་འོད་བཀག་པ་ནི་ཤེས་རབ་གྱིས་ཤེས་རབ་ལ་སྦྱོར་བ་དང་ཤུབས་ཀྱིས་ཟབ་ལ་སྦྱོར་བབལག་པང་པའོ།",
    "གསུམུགནས་ཁྱབ་འཇུག་སྤྲོས་སོ་ཞེས་དཀྱུས་གཅིག་ལ་བསྟན་པར་འཐུས་འགྱིག་དཀའ་བར་འདུག་ལ།",
    "གུར་ལྷ་། འོག་ར་བའི་སྟེང་དུ་རྡོ་རྗེའི་བླའེ་རྣམས་བར་མཚམས་མེད་པར་དུམ་བུ་གཅིག་ཏུ་གྱུར་པའི་ཕྱི་རོལ་ཏུ་རྡོ་རྗེའི་མེ་འཇིག་དུས་ཀྱི་མེ་ལྟ་བུས་བསྐོར་བར།",
    "འཇིག་དུས་ཀྱི་མེ་ལྟར་འབར་བ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡ་ཧུ་ཧཱུཾ་ཕཊཾ་སྭཱཧཱ།",
    "སྲ་དྷ་ཧ་བེ་ཤ་ཏ་ས་ཧ་སྲ་ན་ནེེ་ཛྭ་ལྀ་ཏ་ཏེ་ཛསེ་ཛྭ་ལ་མུ་ཁེ་སཾ་ག་ལ་ལོ་ཙ་ནེ།",
    "ཨོཾ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧཱུ་ཕཊ་རི་ཧ་ས་ནི།",
    "རྡོ་རྗེའི་སྐྱིལ་ཀྲུང་འདུག་བྱས་ནས།",
    "རང་རང་གོ་ཆའི་ལྷར་བཅས་པ།",
    "བསྲུང་སྤེལ་བྱུང་ན་ཅི་མ་རུང་སྙམ་པའི་བློ་ཞིག་འདུག།",
    "དེའི་སྟེང་རང་ཉིད་དང་མ་བྱན་བཅས་བདུན་ཡོད།",
    "སྟོང་པ་ཉིད་དང་རྣམ་པ་ཉི་ཤུ་ཡིན་པའི་རྒྱུ་ནི་རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར།",
