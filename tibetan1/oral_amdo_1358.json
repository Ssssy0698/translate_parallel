    "མི་མང་གིས།",
    "བཀའ་ཤག་གི་བཀའ་བློན་རྣམས་གདན་འདྲེན་ཞུ་རྒྱུའི་རླངས་འཁོར་དེ་སྒོའི་ཕྱི་ལོགས་སུ་སྟོང་པར་ཐོན་ཆུགས།",
    "ང་ཚོ་ཕ་ལྷ་དང་བཀའ་ཤག་སྒོ་ཆེན་ནས་ཕྱིར་ཐོན་དུས་གྲི་རིང་པོ་སྐེད་པར་བཅིངས་པའི་བུད་མེད་ཁ་ཤས་མདུན་དུ་ཡོང་སོང་།",
    "ཏ་ཡང་བོད་ཀྱི་སྒོར་མོ་གི་བསླུ་བྲིད་འོག་མ་འགྲོ་ཞེས་ཉེན་བརྡ་བཏང་བྱུང་།",
    "འདི་ནི་ཏན་ཏན་ཕ་ལྷ་དང་བཀའ་ཤག་ལ་གཟི་བརྗིད་དང་བཅས་ངོ་ཚ་ཕོག་པའི་དུས་ཚོད་ཅིག་ཆགས་ཡོད་པ་རེད།",
    "མཚོན་ཆ་ཐོགས་པའི་བུད་མེད་ཚོས་ཁོང་ཚོ་ལ་བཀའ་བཏང་བ་ཙམ་མིན་པར།",
    "བཀའ་བློན་རྣམས་ནི་བང་ཆེན་པ་དཀྱུས་མ་ཞིག་ལས་གང་ཡང་མིན་པའི་ཚུལ་དུ་ད་དུང་ཁོང་ཚོས་བཀའ་བློན་རྣམས་ཀྱིས་བསླུ་བྲིད་དང་ལྐོག་རྔན་ཟ་སྲིད་པའི་དོགས་པ་བྱེད་ཀྱི་ཡོད་པ་གསལ་པོ་བཟོས་པ་རེད།",
    "འདར་སིག་སིག་གི་ཕ་ལྷ་དང་བཀའ་ཤག་འཇིབ་འཁོར་དུ་འཛེགས་ནས་གཡུ་ཐོག་ཏུ་ཕྱིན་པ་རེད།",
    "གསར་དུ་བརྒྱབ་པའི་སོ་ལྟ་ཁང་དང་མེ་མདའ་ཐོགས་པའི་སྐོར་སྲུང་བ་བཅས་ཡོད་པ་ཞིག་རེད།",
    "གནས་ཚུལ་སྡུག་ཤོས་ཤིག་ལ་གྲ་སྒྲིག་བྱེད་བཞིན་པའི་ཕ་ལྷ་དང་བཀའ་ཤག་ནི་ཉེ་འཁྲིས་ཀྱི་དམག་མིའི་མགྲོན་བསུ་ཁང་ཞིག་ལ་འཁྲིད་པ་རེད།",
    "དེའི་ཁྲོད་དུ་དམག་སྤྱི་ཐན་མེད་པ་རེད།",
    "དེ་ནི་གཤིས་ངན་ང་ཕོད་ལས་གཞན་སུ་ཡང་མ་རེད།",
    "འདི་ནི་ཧ་ཅང་ཡ་མཚན་པ་ཞིག་རེད།",
    "ཡིན་ན་ཡང་ད་ནི་ང་ཕོད་ཀྱིས་བོད་མི་ཚོའི་ཕྱོགས་སུ་ཡོང་ཐབས་མ་བྱས་པ་རེད།་",
    "སྐར་མ་བཅུ་ཙམ་གྱི་རིང་ལ་བོད་ཀྱི་བཀའ་བློན་རྣམས་ཡར་ལངས་བཅུག་ནས་བཞག་པ་རེད།",
    "བཀའ་བློན་ཡོད་པ་ཤེས་ཡོད་ཅེས་སྟོན་ཆེད་ཚུར་བལྟ་བ་ཡང་ཐེངས་གཅིག་ཀྱང་མ་བྱས་པ་རེད།",
    "གལ་སྲིད་བོད་མི་ཚོ་ལ་ཞི་བའི་གྲོས་མོལ་ཅིག་ཡོང་སྲིད་སྙམ་པའི་རེ་བ་ཞིག་ཡོད་པ་ཡིན་ན།",
    "རེ་བ་དེ་ཚོ་ལ་དམག་སྤྱི་ཐན་གྱི་གདོང་གི་རྣམ་འགྱུར་དེས་གཞུས་ཡོད་པ་རེད།",
    "དཀའ་རྙོག་ཏུ་ཚུད་པའི་བཀའ་ཤག་གིས་དགོངས་སེལ་ཞུ་བ་དང་བཅས་མགོ་བཙུགས།",
    "ཁོང་ཚོས་དམག་སྤྱི་ཐན་ལ།",
    "དམག་སྤྱི་ཁོང་ཁྲོ་ཇེ་ཆེར་སོང་བ་དང་མཉམ་དུ་ཁོས་ཁོང་ཚོས་གསང་བའི་ཐོག་ནས་ཆུ་བཞི་སྒང་དྲུག་ལ་རྒྱབ་སྐྱོར་བྱས་རབས་དང་།",
    "ལྷ་སའི་ནང་གི་ཞི་འཇགས་ལ་བར་ཆད་བྱེད་ཆེད་ཤར་ཕྱོགས་ཀྱི་བོད་ས་ནས་ཡོང་བའི་བོད་མི་ཚོ་སེམས་ཤུགས་སྤར་རབས་སོགས་བཀའ་བརྩི་དྭང་ལེན་མི་བྱེད་པའི་བྱ་སྤྱོད་ཀྱི་ཐོ་གྲངས་ཇེ་མང་དང་ཇེ་མང་དུ་སོང་།",
    "ད་ནི་དམག་སྤྱིས་བཀའ་བློན་ཚོས་དེའི་སྐྱིན་ཚབ་སྤྲོད་དགོས་པའི་ཉེན་བརྡ་གཏོང་བཞིན་འདུགདམག་སྤྱི་ཅི་ཙམ་གྱིས་བཟོད་བསྲན་དཀའ་བ་ཞིག་ཡིན་པ་དེའི་ཚོད་ཀྱིས་ཕ་ལྷ་ཡིས་དེ་ལས་ཀྱང་མང་བ་ཞིག་གི་ཐོག་ནས་གཤེ་གཤེ་ཡི་དུས་ཚོད་འདི་རྫོགས་མཚམས་དེ་ལ་འཚབ་སྣང་བྱུང་།",
    "ང་ནི་བདེ་སྲུང་གི་དོ་དམ་པ་ཡིན་པའི་སྟབས་ཀྱིས།",
    "ལ་རྡོ་གཞུས་ནས་བསད་པ་དེའི་ཉེས་འགན་ང་ལ་ཡོད་པ་རེད་ཟེར།",
    "ངས་མི་ཅིག་དམིགས་བཀར་བྱེད་རྒྱུ་ནི་ཡོང་མི་སྲིད་པ་ཞིག་རེད་ཅེས་བཤད།",
    "རྒྱ་མི་རྣམས་རེ་རེ་བཞིན་ཡར་ལངས་ནས་ང་ཚོའི་ཐོག་ཏུ་སྡིགས་དམོད་ཀྱི་ཆར་པ་ཕབ་སོང་།",
    "དེའི་སྐབས་སུ་ང་ཕོད་ཀྱིས་ཐེངས་གཅིག་ལ་ཡང་ཁ་འགུལ་མ་སོང་།",
    "དེ་ནས་དམག་སྤྱིའི་ཁ་རུབ་ཀྱི་འཁྲབ་སྟོན་འདི་ཇི་ལྟར་མགྱོགས་པོ་ཞིག་གི་ཐོག་ནས་མགོ་ཚུགས་པ་དེ་བཞིན་དུ་མཇུག་སྒྲིལ་སོང་།",
    "ཕ་ལྷ་ནི་ཧོན་འཐོར་པ་རེད།",
    "ལྕང་མའི་སྡོང་པོ་དག་ལ་ཁ་བལྟས་པའི་ཁང་པ་དེ་ནི་ཉི་འོད་ཆེ་ཞིང་ཁྱོན་ཡངས་པ།",
    "འདིའི་རྗེས་ཀྱི་ཉིན་མ་བདུན་གྱི་རིང་ལ་ང་ཚོའི་སུ་གཅིག་ཀྱང་སོ་སོའི་ཁྱིམ་ལ་ལོག་མེད།",
    "ང་ཚོ་གཉིད་ཉལ་བ་ཡང་མེད།",
    "ང་ཚོས་ཟས་ཀྱི་བྲོ་བ་མ་མྱངས་པར་ཐོས་པ་རེད།",
    "ཁོང་ཚོས་ང་ཕོད་ནི་བོད་མི་རྒྱལ་ཚོང་པའི་གཏེ་བོ་དེ་ཡིན་པར་བསྒྲགས།",
    "དེ་ནས་ལྷན་ཚོགས་དེ་ཇོ་ཁང་གི་ཁྱམས་རྭ་བར་དུ་གོམ་བགྲོད་བྱས།",
    "ཐ་ན་རྒྱ་མི་ཚོ་ཡང་ཡིབ་ཀྱི་འདུག་ཁོང་ཚོས་སྐད་བརྒྱབ།",
    "གུང་ཁྲན་དང་འབྲེལ་བ་མཚམས་འཇོག་བྱས་པ་ཡང་རེད།",
    "ད་ནི་ཁོང་ཚོས་རང་གི་སྐད་འབོད་རྙེད་པ་རེད་ལ་ཁོང་ཚོ་ཁུ་སིམ་མེར་འདུག་རྩིས་མེད་པ་རེད།",
    "མི་ཚོགས་ཀྱིས་སྐུ་སྲུང་བ་ཚོས་བྱེད་རྒྱུ་འཐུས་ཤོར་སོང་བ་གང་ཡིན་པ་སྟེ།",
    "སྐུ་སྲུང་བ་ཚོས་རྒྱ་མིས་བཀའ་བཏང་ནས་གོན་དུ་བཅུག་པའི་རྒྱ་མིའི་སྒྲིག་ཆས་དེ་བོར་ནས་བོད་ཆས་གྱོན་ནས་གྱེན་ལོག་པ་དང་ལྷན་དུ་འཛོམས་པ་རེད།",
    "ཁོང་ཚོས་ཐོག་མར་བྱས་པ་ནི་ནོར་གླིང་ཕྱི་རོལ་གྱི་རྭ་སྐོར་དུ་སྐོར་སྲུང་བ་བཞག་པ་རེད།",
    "ད་ནི་ཁོང་གིས་རང་གི་མི་མང་གིས་བཀའ་ཤག་ལ་ཡིད་ཆེས་མེད་པ་དེ་ཇི་ཙམ་གྱི་བར་ཡིན་པ་མཁྱེན་ཡོད་པ་རེད།",
    "དེ་ཚོས་ཚུལ་མཐུན་གྱི་ངང་ནས་རང་གི་གོ་མཛོད་ཁང་དག་གི་སྒོ་ཕྱེས་ནས་དགའ་སྐྱིད་ཅན་གྱི་མི་ཚོགས་ལ་མཚོན་ཆ་བཀྲམས་པ་རེད།",
    "དམག་མི་ཡང་ད་ནི་གྱེན་ལོག་པའི་དཔུང་ཤུགས་སུ་ཞུགས་པ་རེད།",
    "ཁམས་པ་དང་ལྷ་ས་བའི་སྐོར་ཁག་ཅིག་ལྕགས་པོ་རིའི་སྟེང་དུ་འཛེགས་པ་རེད།",
    "སྐོར་ཁག་གཞན་ཞིག་བྱང་དུ་སོང་ནས་རྒྱ་མིའི་གནམ་ཐང་ལ་འགྲོ་སའི་ལམ་ཁ་ལྟེ་བ་དེ་བཀག་ཅིང་།",
