    "རྒྱ་མི་ཚོ་ནི་ཁོ་ཚོའི་ཚུར་རྒོལ་བྱེད་པའི་འཆར་གཞི་རྣམས་སྟོན་རྐྱང་བྱེད་རྒྱུ་ལ་ཧ་ཅང་གྲུང་པོ་ཡིན་འདུག་ཡིན་ན་ཡང་ད་དུང་འགོག་རྒོལ་པ་ཚོས་རང་གི་གནས་སྟངས་ཇེ་བཙན་དུ་བཏང་བའི་ཞོར་ལ།",
    "རྒྱ་དམག་གི་ངོམ་སྟོན་དེ་ཚོ་ནི་བསླུ་བྲིད་རེད་ཅེས་དང་ཡང་ངོ་མ་དེ་རེད་ཅེས་ཁ་རྩོད་བརྒྱབ་པ་རེད།",
    "དོན་གཅིག་ལ་བོད་མི་ཚང་མས་མོས་མཐུན་བྱེད་ཐུབ་པ་ཞིག་ཡོད་པ་དེ་ནི་ཁོང་ཚོས་ཡོད་ཚད་བློས་བཏང་གིས་ཡིན་གཅིག་མིན་གཅིག་ཁོང་ཚོའི་ཧ་ཅང་རྩ་ཆེ་ཞིང་ཚབ་འཇལ་དུ་མེད་པའི་རྒྱུ་ནོར་སྟེ།",
    "ཁྱད་མཚར་བ་ཞིག་ལ་ཁོང་ནི་བོད་ནང་དུ་ཁོང་གི་སྐུ་སྒེར་གྱི་གནས་སྟངས་དེ་འབྲེལ་བ་མེད་པ་ཞིག་གི་ཚུལ་དུ་འཛིན་མཁན་གྱི་མི་གཅིག་པུ་དེ་རེད།",
    "ཁོང་གིས་མཁྱེན་གསལ་ལ་གལ་སྲིད་རྩ་ཆེན་འདི་ཡོད་མེད་ལ་མ་ལྟོས་པར་དོན་དག་ཅིག་མ་སྒྲུབ་ཕྱིན་རྒྱ་མིས་ལས་སླ་བོར་མེ་སྒྱོགས་ཀྱི་ཁ་གློད་ནས་ལྷ་ས་རྩ་གཏོར་གཏོང་རྒྱུ་ཡིན་པ་རེད།",
    "ངོས་རང་ནི་གཡུ་ཐོག་ཏུ་སོང་ནས་རང་ཉིད་རྒྱ་མིའི་ལག་པ་ལ་འཇོག་རྒྱུར་དངོས་གནས་གྲ་སྒྲིག་ཡིན།",
    "ཡིན་ན་ཡང་མི་མང་གིས་ངོས་རང་ལ་དེ་ལྟར་རྩ་བ་ཉིད་ནས་བྱེད་འཇུག་གི་མེད།",
    "ཁོང་གི་སློབ་སྟོན་པ་དང་ཁྱིམ་མི་མང་པོ་ཞིག་གིས་སྐུལ་མ་བྱས་པའི་ལྷ་ས་ནས་གསང་བྲོས་བྱེད་རྒྱུར་མཚོན་ན།",
    "ཕ་ལྷ་ཡིས་དེར་མོས་མཐུན་མ་བྱས།",
    "ཡིན་ན་ཡང་གལ་སྲིད་ལྷ་ས་ལ་བརྒྱ་ཆའི་བརྒྱ་དམག་འཁྲུག་ལངས་པ་ཡིན་ན་ག་རེ་བྱེད་ཀྱི་རེད།",
    "ནང་ཚགས་ཀྱི་ཐོག་ནས་ངས་བཀའ་ཤག་ལ་ང་ཚོས་ངེས་པར་དུ་ཁོང་བྲོས་བྱོལ་ལ་ཕེབས་པའི་གྲ་སྒྲིག་བྱེད་དགོས་བརྗོད་པ་ཡིན་ལ།",
    "ང་ཚོ་ཚང་མས་ཧ་ཅང་གསང་བ་དམ་འཛིན་བྱེད་དགོས་པ་དེ་ལ་མོས་མཐུན་བྱས་པ་ཡིན།",
    "ནོར་གླིང་ལྷོ་ངོས་ཀྱི་རྒྱལ་སྒོ་ལ་རྒྱ་མི་མེད་གཤིས་དེ་ནི་ང་ཚོའི་བྲོས་བྱོལ་མགོ་འཛུགས་བྱེད་ས་དེ་ཡིན་པའི་ཐག་གཅོད་བྱས་པ་ཡིན།",
    "ཁོང་གིས་དེ་མིན་གྱི་སྔོན་ཚུད་གཟབ་ནན་ཡང་བྱས་ཡོད་པ་རེད།",
    "༡༩༥༩ ལོའི་ཟླ་བ་གསུམ་པའི་ཚེས་༡༥ཞོགས་པ་དེའི་སྐབས་གཅིག་གི་རིང་ལ་དམག་འཁྲུག་རྒྱག་རྒྱུ་ནི་སྐར་མ་ཁ་ཤས་ཀྱི་ནང་ཚུད་དུ་ཡིན་པ་ལྟ་བུ་ཞིག་མཐོང་།",
    "ནོར་གླིང་གི་ལྷོ་ངོས་ཀྱི་རྩིག་པ་ནས་ཕི་ཊི་བརྒྱ་དང་ལྔ་བཅུ་ཡོད་ས་ཞག་མ་གཉིས་ཀྱི་རྗེས་སུ་ཕྱོགས་འདི་ནས་ཕ་ལྷ་ཡིས་བྲོས་བྱོལ་མགོ་འཛུགས་བྱེད་རྩིས་ཡོད་པ་རེད།",
    "ཁོང་ནི་ཨ་མའི་བཀའ་ལ་མ་ཉན་པར་ཕར་རྒོལ་བྱེད་མཁན་རྣམས་ལ་རོགས་པ་བྱེད་ཀྱིན་ཡོད།",
    "བོད་དམག་རྣམས་ཀྱིས་མེ་མདའ་རྒྱག་ཆོག་ཆོག་གི་གྲ་སྒྲིག་བྱས་ཤིང་དབུགས་སྒོམ།",
    "མེ་མདའ་འཕེན་རེས་ནི་མགོ་འཛུགས་གྲབས་ཡོད་བསམས་པ་ཞིག་བྱས།",
    "ཡིན་ན་ཡང་རྒྱ་དམག་རྣམས་ཀྱིས་རང་གི་མགོ་གཙོའི་བཀའ་ལ་ཉན་ནས་བང་སྒྲིག་སྟེ་གོམ་པ་བརྒྱབ་ནས་སོང་།",
    "རྒྱ་མི་ཚོ་མཐོང་ས་ནས་ཡལ་བར་མ་གྱུར་གྱི་བར་དུ་བོད་མི་ཚོས་རྒྱ་མི་རྣམས་ནི་བོད་མིའི་ཁ་གྲངས་ལེན་པའི་སོ་ལྟའི་ལས་དོན་ལ་ཡོང་བ་ཞིག་ཡིན་པ་མ་ཤེས་པ་རེད།",
    "བོད་མི་ཚོས་དེ་མ་ཤེས་པའི་ཐོག་ནས་བཀོད་སྒྲིག་བྱས་ཡོད་པ་རེད།",
    "ཁོང་ཚོས་ཁང་པ་དེ་ལ་ཏན་ཏན་གཏོར་སྐྱོན་མི་གཏོང་བའི་བསམ་བློ་གཏོང་གི་འདུགརྒྱ་དམག་གིས་ནོར་གླིང་གཏོར་རྒྱུའི་གྲ་སྒྲིག་བྱེད་ཀྱིན་ཡོད།",
    "བོད་མི་ཁྲི་ཕྲག་མང་པོ་ནོར་གླིང་གི་རྩིག་པའི་ཕྱི་རོལ་དུ་ཡོད་པ་རྣམས་ལ་མཚོན་ན།",
    "ཁོང་ཚོ་ནི་གལ་ཆེན་པོ་མ་རེད།",
    "གང་ལྟར་ཡང་ཁོང་གིས་དམག་སྤྱི་ཐན་ལ་ཡི་གེ་ཞིག་བཏང་ནས་ཅི་བྱ་གཏོལ་བྲལ་གྱི་གནས་སྟངས་རྩལ་དུ་བཏོན་ཡོད།",
    "ཁོང་གིས་ཟིང་ཆ་ཏོག་ཙམ་ཞི་འཇམ་དུ་སོང་མ་ཐག་ཏུ་གཡུ་ཐོག་ལ་ཡོང་ནས་དམག་སྤྱི་ལ་ཐུག་རྒྱུའི་ཞལ་བཞེས་གནང་།",
    "དེ་ནས་ཧ་ཅང་མཁས་པོའི་ཐོག་ནས་མཇུག་སྡོམ་གྱི་མཚམས་སུ་ཁོང་གིས་དམག་སྤྱིས་ཡང་ཡང་ཡིག་འབྲེལ་ཡོང་བའི་ཐུགས་རེ་ཡོད་ཅེས་བྲིས་པ་རེད།",
    "ད་ནི་ཁོང་གིས་ཟིང་ཆ་སྟངས་འཛིན་བྱེད་རྒྱུ་ལ་ནུས་པ་མེད་པའི་གནས་སྟངས་ཏག་ཏག་མཁྱེན་ཡོད་པ་རེད།",
    "ཁོང་གིས་རྩེ་ཕུད་དུ་གནང་ཐུབ་པ་ནི་དམག་སྤྱི་ལ་བཅོས་མའི་ཞི་མཐུན་གྱི་ཡི་གེ་བྲིས་ནས་དུས་ཚོད་འགོར་འགྱངས་བྱེད་རྒྱུ་དེ་རེད།",
    "དོན་དངོས་སུ་བོད་མི་ངོ་ལོག་པ་ཚོས་བཙན་འཁྲིད་བྱས་པ་ཡིན་པའི་ཁུངས་སྐྱེལ་དུ་སྤྱད་པ་རེད།",
    "ཡིན་ན་ཡང་ཡིག་འབྲེལ་འདི་ཚོའི་ཐོག་ནས་ཕྱོགས་གཅིག་ནས་དམག་སྤྱི་གྲ་སྒྲིག་མེད་པར་འཇོག་རྒྱུའི་ཐད་ལམ་ལྷོང་བྱུང་ཡོད་པ་རེད།",
    "ངས་ཁོང་ཚོར།",
    "ད་དུང་གནས་སྟངས་གང་འདྲ་ཞིག་གི་འོག་ཏུ་ཡང་ལག་གློག་བེད་སྤྱོད་བྱས་མི་ཆོག་ལ།",
    "གསང་བྲོས་ཀྱི་འཆར་གཞི་རྣམས་ཏག་ཏག་ཡོང་རྒྱུ་དེ་རེད།",
    "དེ་ནི་ཐག་གཅོད་བཟང་པོ་ཞིག་རེད།",
    "ཚོམས་ཆེན་དེར་མཆོད་གཤོམ་སྟབས་བདེ་ཞིག་དང་རིན་ཐང་ཆེ་བའི་ཐང་ག་དག་གིས་རྩིག་པ་ལ་བརྒྱན་ཡོད་པ་རེད།",
    "ཁོང་གི་བཀའ་བློན་རྣམས་ནི་ནུབ་ཕྱོགས་པའི་སྲོལ་གྱི་རྐུབ་སྟེགས་སྟེང་བསྡད།",
    "གསོལ་ཇ་དྲངས་ཚར་ཙམ་ལ་ཁོང་ཚོས་དམག་སྤྱི་ཐན་གྱི་བརྡ་ལན་ཐོས་པ་རེད།",
    "སྒྱོགས་མདེལ་གཅིག་ཚོམས་ཆེན་ཕྱི་ལོགས་ཀྱི་རྫིང་བུ་ཞིག་གི་ནང་དུ་གད་པ་རེད།",
    "དེ་ནས་ཅང་མ་སོང་བར་འབོམ་གཉིས་པ་དེ་ནོར་གླིང་བྱང་ངོས་ཀྱི་རྩིག་པའི་ཕྱི་རོལ་གྱི་བརླན་ས་ཞིག་གི་ཕྱོགས་ནས་ཁོང་ཚོའི་རྣ་བར་དཀྲོལ་པ་རེད།",
    "དེ་ནས་ཁུ་སིམ་མེར་སོང་།",
    "སྒྱོགས་མདེལ་འཕར་མ་གང་ཡསླེབས་པ་རེད།",
    "ཉེན་བརྡའི་མེ་མདའ་རེད།་",
    "དེ་ནས་ཁོང་གིས་མུ་མཐུད་ནས།",
    "ང་ཚོ་ངེས་པར་དུ་བྲོས་བྱོལ་ལ་ཕེབས་དགོས།",
    "ཐག་གཅོད་དེ་ནི་དོན་ཆུང་ཆུང་ཞིག་མ་རེད།",
    "གལ་སྲིད་ངོས་རང་ལྷ་ས་ནས་བྲོས་བྱོལ་བྱས་པ་ཡིན་ན་ངོས་རང་གང་དུ་འགྲོ་དགོས་པ་རེད།",
    "མི་མང་གིས་ང་ཐོན་པ་གོ་བ་ཡིན་ན་ཁོང་ཚོ་ནོར་གླིང་ནས་ཁ་བཀྲམས་ཏེ་འགྲོ་རྒྱུ་ཡིན་ནམ།",
    "ཡིན་ན་གཅིག་བྱས་ན་མིའི་ཚེ་སྲོག་ཁ་ཤས་སྐྱོབ་ཀྱི་རེད།",
    "ཡིན་ན་ཡང་འབོམ་གྱི་སྐད་སྒྲ་ནི་ད་དུང་ཁོང་གི་སྙན་དུ་སླེབས་ཤིང་།",
    "ཁོང་གིས་མཚན་དེའི་ཆུ་ཚོད་བཅུ་པའི་ཐོག་བྲོས་བྱོལ་ལ་འགྲོ་རྒྱུའི་ཐད་མོས་མཐུན་གནང་བ་རེད།",
    "ཕ་ལྷ་ཡིས་ཁང་མིག་དེར་ཡོད་པའི་མི་ཚང་མ་ལ་རང་རང་གི་ཆུ་ཚོད་འཁོར་ལོ་རྣམས་ཁོང་གི་ཆུ་ཚོད་འཁོར་ལོ་ལ་བསྟུན་དགོས་པའི་བཀའ་བཏང་།",
    "མི་ཚང་མ་ཕྱོགས་སོ་སོར་སོང་ནས་རང་གི་སྒེར་དོན་རྣམས་བསྡུ་གསོག་བྱས།",
    "ར་མ་སྒང་གྲུ་ཁར་ཁོང་དང་ཁོང་གི་ལས་བྱ་བཅས་སྒུག་སྡོད་བྱེད་དགོས་པ་དང་།",
    "དེར་ང་ཚོ་ཕྱིས་སུ་མཉམ་འཛོམས་ཡོང་གི་རེད་ཅེས་མངགས་པ་ཡིན།",
    "ཁོས་སྐྱབས་བཅོལ་གྱི་བརྗོད་གཞི་གླེང་བའི་ཡི་གེ་ཞིག་རྒྱ་གར་གྱི་གཞུང་ཚབ་པ་ལ་བྲིས་པ་རེད།",
    "གལ་ཆེའི་སྐུ་མགྲོན་ཞིག་ཕེབས་ཀྱི་ཡོད་ཅེས་བརྡ་ལན་བསྐྱལ་བ་རེད།",
    "བོད་ཀྱི་དཀའ་རྙོག་ནི་མཚོན་ཆ་བརྡབས་པ་ཞིག་མིན་པར་སེམས་བརྡབས་པ་ཞིག་རེད།",
    "ཅེས་བརྗོད་པ་རེད།",
    "དེ་ནི་ནེ་ཧ་རུ་ཡི་ཕྱོགས་ནས་བོད་ཀྱི་དཀའ་རྙོག་ཐད་དུ་དྲང་པོ་མ་བྱས་པའི་ལས་ཀ་མཐའ་མ་དེ་ཆགས་རྒྱུ་རེད།",
    "ཉིན་གཉིས་རྗེས་སྟེ་ཟླ་བ་གསུམ་པའི་ཚེས་༢ ཉིན་བཅིངས་འགྲོལ་དམག་གིས་ཁོ་ཚོའི་མེ་སྒྱོགས་ཀྱི་ཁ་བསྒྱུར་ནས་ལྷ་སའི་དཀྱིལ་དུ་ཡོད་པའི་རྒྱ་གར་གཞུང་ཚབ་ལ་མདེལ་འཕེན་གྱི་རེད།",
    "ཟླ་བ་གསུམ་པའི་ཚེས་༡༧ གྱི་མཚན་མོ་དེར་བྲོས་བྱོལ་བྱེད་མཁན་སྐོར་ཁག་ཁ་ཤས་ཡོད་པ་རེད།",
    "ཁོང་གཉིས་ཀས་རྐང་ཐུང་གོན་ནས་གཡོག་པོའི་ཆས་སུ་རྫུས་ཡོད་པ་རེད།",
    "ཁོང་གིས་ནུབ་དེའི་ཆུ་ཚོད་བརྒྱད་དང་ཕྱེད་ཀ་ཙམ་ལ་ཅི་ཞིག་བྱུང་བ་དེ་ཕྱིར་དྲན་བྱས་དོན།",
    "དམག་མི་ཚོ་ཁང་པའི་ནང་ནས་ཕྱི་ལོགས་ལ་རྒྱུགས་ཤིང་ང་ཚོ་ཚང་མས་ཁུམས་རྭའི་ཐོག་ནས་བལྟས་མོད་གཅིག་ཀྱང་མཐོང་མ་སོང་།",
    "ཕྱིས་སུ་ང་ཚོས་གོ་ཐོས་ལ་ར་མ་སྒང་གྲུ་ཁ་སྲུང་བཞིན་པའི་ང་ཚོའི་དམག་མི་བརྒྱ་སྐོར་ཡོད་པ་རྣམས་རྒྱ་མིའི་སྐོར་སྲུང་བ་དང་གདོང་ཐུག་བརྒྱབ་པ་རེད།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་ང་ཚོའི་མེ་མདའ་འཕངས་པ་དེས་ཁོང་ཚོ་སྐྲག་ནས་ཕར་སོང་ཞིང་གཙང་པོའི་ལམ་ཁ་ལ་དགྲ་མེད་པར་བཟུང་འདུགསྐོར་ཁག་དང་པོ་དེ་ཆུ་ཚོད་དགུ་བ་ཙམ་ལ་ནོར་གླིང་གི་ལྷོ་སྒོ་ནས་ཐོན།",
    "སྐོར་ཁག་རྗེས་མ་དེའི་ནང་ལས་བྱེད་སྣ་ཚོགས་ཤིག་ཡོད་པ་དེ་རས་ཁེབས་ཀྱིས་གཡོགས་པའི་ཊག་འཁོར་ཞིག་གི་ནང་ཡིབ་ཏེ་ནོར་གླིང་ནས་ཐོན།",
    "ཁོང་གིས་ཕ་ལྷའི་འཚེམ་བུ་བས་ཁོང་ལ་ཕུལ་བའི་གྱོན་ཆས་དེར་བརྗེ་བོ་བརྒྱབ།",
    "དེ་ནས་ཁོང་གི་སྐུ་སྒེར་གྱི་མཆོད་ཤོམ་དུ་ཕེབས་ཐེངས་མཐའ་མ་དེ་གནང་།",
    "ཁོང་རང་ཉིད་ཀྱིས་དེ་ཚོ་འཁྱེར་དགོས་ཡོད་པ་རེད།",
    "ཁོང་གིས་རས་ཀྱི་ཐག་པ་ཅན་གྱི་སྦུ་གུ་ཞིག་ཡར་བླངས་ནས་རང་གི་ཕྲག་སྟེང་དུ་འཁུར་བ་རེད།",
    "སྒྲིལ་ཐང་དེ་ནི་དཔལ་ལྡན་ལྷ་མོ་རེད།",
    "དེ་ཙམ་ནས་དཔལ་ལྡན་ལྷ་མོ་གཉིད་སྟུག་པོ་ཞིག་ནས་རོགས་མགོན་དུ་ཡོང་བ་ཇི་བཞིན་བྲོས་བྱོལ་ལ་རོགས་གནང་ཡོད་དེ།",
    "དཔལ་ལྡན་ལྷ་མོ་ལས་གཞན་སུ་ཞིག་གིས་དེ་འདྲའི་རྫུ་འཕྲུལ་སྟོན་ཐུབ་ཀྱི་རེད།",
    "ཕ་ལྷ་ནི་ཁོང་གི་གཞོགས་དེར་བསྡད་ཡོད་ཅིང་ཁོང་གི་ལོ་གཞོན་གྱི་དབུ་འཁྲིད་འདིས་གཅེས་པའི་ནོར་གླིང་ལ་མཐའ་མའི་གྱེས་གཟིགས་ཤིག་གནང་བ་དེར་བལྟས།",
    "ངའི་མི་ཚེའི་ནང་ཡོང་མྱོང་མེད་པའི་ཡིད་མུག་ཤོས་ཀྱི་སྐབས་དེ་རེད།",
    "སྟབས་མི་བདེ་བ་ཞིག་གི་ངང་ནས་ཁོང་གིས་དེ་རང་གི་ཕྲག་པའི་སྟེང་དུ་འཁུར།",
    "ཕ་ལྷ་ཁོང་ཚོའི་ཁྲོད་ནས་ཕེབས་སྐབས་མི་ཚོགས་དཀྱིལ་ནས་མི་གཅིག་གིས་སྐད་བརྒྱབ་སྟེ།",
    "མི་འདི་ཚོ་སུ་རེད།",
    "ཁྱེད་རང་གིས་གློག་ཞུན་མ་སྤར་ན་ཡག་གི་རེད།",
    "ཕ་ལྷས་སྔོན་ནས་བཀའ་རྒྱ་བཏང་བ་དེས་ནོན་འདུག་མི་སུ་གཅིག་གིས་ཀྱང་ཁོང་ཚོའི་གདོང་ལ་གློག་ཞུན་མ་སྤར་བར་མི་ཚོགས་དཀྱིལ་ནས་ཕར་གཏོང་གི་འདུགཁོང་ཚོ་རྒྱབ་ཀྱི་མུན་ནག་རྒྱ་སྨུག་དེའི་ནང་ཡལ་བར་གྱུར།",
    "སྔོན་ལ་གཙང་པོའི་འགྲམ་དུ་སོ་ལྟ་བྱས་པའི་འཇབ་དམག་གི་སྐོར་སྲུང་ཕོན་ཆེ་དེ་སླར་ལོག་ཅིང་ཕ་ལྷའི་སྐོར་ཁག་གི་མདུན་བསུས།",
    "ཁོང་ཚོས་ཕ་ལྷ་ལ་རྒྱ་དམག་མཐོང་ས་ལ་མི་འདུག་ཅེས་སྙན་གསན་ཞུས།",
    "ཕ་ལྷ་ཡིས་ཀྱང་དེ་མཚུངས་ཀྱི་ཨུ་ཚུགས་བརྒྱབ་ནས་ཁོང་ཚོས་དེ་ལྟར་མི་བྱེད་རྒྱུ་དང་བྱེད་མི་རུང་བ་བཤད།",
    "ངས་ཁོང་ཚོར་བརྗོད་དོན།",
    "གལ་སྲིད་ང་ཚོ་ཚང་མ་མཉམ་རུབ་ཏུ་བསྡད་པ་ཡིན་ན་ང་ཚོ་ནི་ཧ་ཅང་མཐོང་སླ་བ་ཞིག་ཆགས་ཀྱི་རེད།",
    "ང་ཚོ་འདི་ལ་ཡོད།",
    "ཤོག་ང་ཚོ་བཟུང་ཟེར་བ་དང་གཅིག་པ་རེད།",
    "དེ་ལས་ཚོ་ཁག་ཆུང་ཆུང་ལ་བགོས་ནས་གཙང་པོའི་ཕ་རོལ་གྱི་གྲམ་པ་རུ་ང་ཚོ་དང་འཛོམས་ཤིག་ཅེས་བརྗོད་པ་ཡིན།",
    "རྒྱལ་ལྗོངས་ལེབ་མོ་ཞིག་གི་ནང་ནས་ལྷ་སའི་གློག་འོད་རྣམས་འོད་འཚེར་འཚེར་གྱིས་མངོན་བྱུང་།",
    "ཁོང་གི་ནང་མི་དང་ཁོང་གི་བཀའ་བློན་རྣམས།",
    "ཁོང་གི་ཞབས་ཞུ་བ་རྣམས་དང་ཁོང་གི་ཡོངས་འཛིན་བཅས་ག་ལེར་རིམ་གྱིས་གཟིགས་སྣང་དུ་ཤར་ཞིང་།",
    "ཁམས་པ་དཔའ་བོ་སུམ་ཅུ་རྟ་ལ་ཞོན་ནས་ཡོམ་ཡོམ་བྱེད་པ་དེ་རེད།",
    "ཁོང་ཚོའི་བཞོན་རྟ་རྣམས་ཀྱིས་སོ་བརྡར་བཞིན་འདུག་ལོ་གཞོན་ཚོའི་སྐྲ་རིང་པོ་དེ་དར་ལྕོག་བཞིན་གཡོ་བར་བྱེད།",
    "ཁོང་ཚོའི་གཟིག་ལྤགས་ཀྱིས་བརྒྱན་པའི་ཕྱུ་པ་དང་ཝ་ཞྭ་དག་གིས་ཧ་ལས་པའི་མཐོང་སྣང་འདི་ལ་སྣོན་པ་བརྒྱབ་འདུག་ནམ་མཁའ་དྭངས་པོའི་ངོས་སུ་ནག་ཕུང་ཕུང་དུ་སྡོད་པའི་དཔའ་བོ་ཚོ་ནི་མཚོན་ཆ་འཛོམས་ནས་ཡོད་ཅིང་གེ་སར་རྒྱལ་པོའི་རྒྱུད་པ་སྤོབས་པ་དང་ལྡན་པ་རྣམས་རེད།",
    "ཁོང་ཚོའི་ལག་མཐིལ་དུ་ལྷུག་ལྷུག་ཏུ་ཡོད་པ་ནི་ཁ་བཏགས་དཀར་པོ་རེད།",
    "ཁོང་ཚོའི་མང་ཆེ་བ་ཞིག་ནི་ཁོང་གི་ལོ་ཚོད་ཡིན་ན་ཡང་།",
    "ཇི་འདྲའི་ཧ་ཅང་མི་མཚུངས་པའི་མི་ཚེ་ཞིག་གི་ནང་མི་འདི་ཚོ་གསོན་ཡོད་པ་རེད་ཨང་།",
    "གུས་ཞབས་ཁྲོད་དུ་མིག་འབྲས་མིག་ཆུས་བརླན་ལ་བསྟན་པ་སྲུང་སྐྱོབ་བྱེད་མཁན་འདི་ཚོ་ནི་གསོད་མཁན་རེད།",
    "ཡིན་ན་ཡང་ཇི་ལྟར་ཁོང་གིས་དེ་ཚོ་འགོག་ཐུབ་ཀྱི་རེད།",
    "ཁོང་ཚོའི་ནག་ཉེས་ཇི་འདྲ་ཞིག་ཡིན་ཡང་།",
    "དེ་ལ་བརྟེན་ནས་ཁོང་ཚོས་ལས་ཇི་འདྲ་ཞིག་བསགས་ཡོད་ན་ཡང་།",
    "ངོས་རང་གི་ཡིད་ཆེས་གང་ཡིན་ལ་མ་ལྟོས་པར།",
    "དེ་ནས་ད་དུང་ངོས་རང་སྒེར་གྱི་ཆ་ནས་ཁོང་ཚོས་ང་ལ་སྤྲད་པའི་སྲུང་སྐྱོབ་དེའི་ཆེད་དུ་ཐུགས་རྗེ་ཆེ་ཞུས་པ་ཡིན།",
    "དེ་ནས་ངས་ཁོང་ཚོ་ལ་དྲང་པོ་དྲང་བཞག་གི་ཐོག་ནས་དྲག་པོ་མ་བྱེད་ཅེས་སློབ་སྟོན་བྱེད་མ་ནུས།",
    "དམག་འཁྲུག་རྒྱག་རྒྱུའི་ཆེད་དུ་ཁོང་ཚོས་རང་གི་ཁྱིམ་དང་བདེ་སྐྱིད་ཀྱི་འཚོ་བ།",
    "ཞི་འཇམ་གྱི་མི་ཚེའི་ཁེ་ཕན་རྣམས་བློས་བཏང་བ་རེད།",
    "ད་ནི་ཁོང་ཚོས་མུ་མཐུད་ནས་དམག་འཁྲུག་རྒྱག་རྒྱུ་ལས་གཞན་པའི་འདམ་ཁ་མ་མཐོང་ལ།",
    "དེ་ནི་རྟ་ལ་བཞོན་པའི་དུས་ཚོད་རེད།",
    "འཇབ་དམག་གིས་བཟུང་བའི་ལྷོ་ཁ་ནི་ཁོང་ཚོ་འགྲོ་ས་དེ་རེད།",
    "གཙང་པོའི་ལྷོ་ཕྱོགས་ན་ཆུ་བཞི་སྒང་དྲུག་གི་དམག་མི་སྟོབས་ཆེན་སྟོང་ཕྲག་བརྒྱད་ཅུས་གཟབ་ནན་གྱིས་ཁོང་ཚོའི་དབུ་ཁྲིད་ལ་ཕེབས་སྒུག་ཞུས་ཡོད།",
    "འོས་ཤིང་འཚམས་པའི་བསྟོད་བསྔགས་རྣམས་འཕྲོ་བརླག་ཏུ་གཏོང་བའི་རྐྱེན་གྱིས་རེད།",
    "བསྟོད་བསྔགས་བྱེད་ས་ནི་ངེས་པར་དུ་ཁམས་པ་འགོག་རྒོལ་པ་ཚོ་དང་དེ་བཞིན་ཕ་ལྷ་དང་ཕ་ལྷས་ཡིད་ཆེས་བྱས་པའི་ལས་བྱེད་ཁ་ཤས་བཅས་ལ་བྱེད་དགོས་པ་རེད།"
  ]
}