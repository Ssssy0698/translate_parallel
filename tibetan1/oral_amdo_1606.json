    "བུད་ཤིང་འདིའི་སྲེག་པ་ནི་འདིའོ་ཞེས་ཕན་ཚུན་ལྟོས་པ་ཉིད་ཡོད་པས་དེའི་ཕྱིར་མེ་དང་བུད་ཤིང་དག་ནི་ཡོད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "ཅི་བུད་ཤིང་གང་ལ་ལྟོས་ནས་མེ་འགྲུབ་པ་འམ།",
    "འོན་ཏེ་མེ་གང་ལ་ལྟོས་ནས་བུད་ཤིང་འགྲུབ་པའི་མེ་དང་བུད་ཤིང་དག་ལས་དང་པོར་གྲུབ་པ་གང་ཞིག་ཡིན་ཏེ།",
    "མི་གྲུབ་པ་ལ་བརྗོད་པ་ཁྱད་པར་ཅན་བསྙད་པ་ཉིད་ཀྱི་ཕྱིར་བུད་ཤིང་ལ་ལྟོས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "བུད་པར་བྱ་བའི་ཤིང་ལ་ཡང་།",
    "བུད་ཤིང་དེ་སྔར་མེ་ལ་མ་ལྟོས་པར་ཡང་བུད་ཤིང་ཉིད་དུ་གྲུབ་པའི་ཕྱིར་རོ་ཞེས་བྱ་བར་དགོངས་སོ།",
    "དོན་དམ་པར་བུད་ཤིང་ནི་མེའི་སྔ་རོལ་ན་གྲུབ་པ་མེད་དེ།",
    "ལྟོས་པ་དང་བཅས་པའི་ཕྱིར་དཔེར་ན་མེའི་རང་གི་བདག་ཉིད་བཞིན་ཏེ།",
    "དེ་དག་ལས་གང་ཡང་རུང་བ་དང་པོར་གྲུབ་པ་མ་ཡིན་མོད་ཀྱི།",
    "འོན་ཀྱང་མེ་དང་བུད་ཤིང་དག་ནི་དུས་མཉམ་དུ་འགྲུབ་པར་འགྱུར་ཏེ།",
    "ལྟོས་པ་ཅན་ཡིན་པའི་ཕྱིར་དཔེར་ན་བ་ལང་གི་རྭ་དུས་གཅིག་ཏུ་སྐྱེས་པ་དག་ལ་གཡས་པ་དང་།",
    "དང་པོ་ཞེས་བྱ་བའི་ཚིག་གི་ལྷག་མའོ།",
    "གལ་ཏེ་ཁྱོད་འདོད་པ་ལྟར་མེའི་མཚན་ཉིད་ཀྱི་དངོས་པོ་གང་ཡིན་པ་ནི་བུད་ཤིང་ལ་ལྟོས་ནས་འགྲུབ་ཅིང་མེ་དེ་ཉིད་ལ་ཡང་ལྟོས་ནས་མེ་འགྲུབ་པར་བྱ་བའི་ཕྱིར་ལྟོས་པར་བྱ་བ་བུད་ཤིང་གི་མཚན་ཉིད་ཀྱི་དངོས་པོ་གང་ཡིན་པ་དེ་འགྲུབ་ན་གང་ལ་ལྟོས་ནས་གང་ཞིག་འགྲུབ་པར་འགྱུར་ཏེ།",
    "གང་ཡང་རུང་བ་མེ་ཉིད་དམ་བུད་ཤིང་ཉིད་དུ་མི་འགྲུབ་སྟེ།",
    "རང་གི་རྒྱུ་ལས་སྐྱེ་བ་ནི་ཕན་ཚུན་ལྟོས་པ་མི་འགྲུབ་པའི་ཕྱིར་རོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཏོ།",
    "དེས་ན་བ་ལང་གི་རྭའི་དཔེ་ཉིད་ལ་ཡང་གཏམ་དེ་ཉིད་དུ་འགྱུར་ཏེ།",
    "མ་གྲུབ་པ་ནི་ལྟོས་པར་མི་བྱེད་པ་ཉིད་དོ་ཞེས་བྱ་བའི་ཚིག་གི་དོན་ཏེ།",
    "འདིར་རྗེས་སུ་དཔག་པ་ནི་དོན་དམ་པར་མེ་མ་གྲུབ་པ་ནི་བུད་ཤིང་ལ་ལྟོས་པར་མི་བྱེད་དེ་མེ་ཉིད་དུ་མ་གྲུབ་པའི་ཕྱིར་དཔེར་ན་དེ་ལས་གཞན་བཞིན་ནོ།",
    "ཕ་རོལ་པོ་དག་རང་གི་ཚུལ་ལ་གནོད་པ་བཅབ་པའི་ཕྱིར།",
    "བུད་ཤིང་། དེ་ནི་མེ་ལ་ལྟོས་པར་མི་རིགས་ཏེ་དེ་བཞིན་དུ་མེད་པའི་ཕྱིར་དཔེར་ན་དེ་ལས་གཞན་བཞིན་ནོ།",
    "སྔར་བསྟན་པའི་ཚུལ་གྱིས་བུད་ཤིང་མེ་ལ་མི་ལྟོས་པར་བུད་ཤིང་ཉིད་དུ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "བུད་ཤིང་དང་བཅས་པར་རམ་བུད་ཤིང་མེད་པར་འོང་བར་བརྟག་ན།",
    "ལྟོས་པ་མེད་ན་བུད་ཤིང་མེད་པས་གཞི་མེད་པའི་ཕྱིར་རོ།",
    "གཞན་མ་ཡིན་པ་ན་རེ།",
    "མེ་དང་བུད་ཤིང་དག་ཇི་སྐད་བསྟན་པའི་དགག་པ་དག་འབའ་ཞིག་གིས་དགག་པར་བྱ་བ་ཡིན་པར་མ་བསམས་ཀྱི།",
    "སོང་དང་མ་སོང་བགོམ་པ་ཡིས།",
    "ཇི་ལྟར་རྗེས་སུ་དཔག་པ་ལས་སོང་བ་དང་མ་སོང་བ་དང་།",
    "དེའི་ཕྱིར་དེ་ལྟར་མེ་དང་བུད་ཤིང་དག་མ་གྲུབ་པས་དཔེ་མེད་པའི་ཕྱིར།",
    "ཕན་ཚུན་ལྟོས་པའི་ཕྱིར་དཔེར་ན་མེ་དང་བུད་ཤིང་བཞིན་ནོ་ཞེས་གང་སྨྲས་པ་དེའི་དཔེ་མ་ཚང་བ་ཉིད་ཀྱི་ལན་གདབ་པར་དཀའོ།",
    "ཇི་ལྟར་མེ་དང་བུད་ཤིང་དག་གི་དེ་ཉིད་དང་གཞན་ཉིད་བཀག་པ་དེ་བཞིན་དུ།",
    "མེ་དང་ཤིང་གིས་བདག་དང་ནི།",
    "དངོས་པོ་ཡིན་པའི་ཕྱིར་དཔེར་ན་ཉེ་བར་བླང་བའི་རང་གི་བདག་ཉིད་བཞིན་ནོ།",
    "དངོས་པོ་ཡིན་པའི་ཕྱིར་དཔེར་ན་བདག་གི་རང་གི་བདག་ཉིད་བཞིན་ནོ།",
    "དོན་དམ་པར་ལྷས་བྱིན་གྱི་ཉེ་བར་བླང་བ་ནི་ལྷས་བྱིན་གྱི་བདག་གི་ཉེ་བར་བླང་བ་མ་ཡིན་ཏེ།",
    "འདིར་ཁ་ཅིག་གིས་སྨྲས་པ།",
    "མཆོད་སྦྱིན་གྱི་བདག་ནི་རང་གི་ཉེ་བར་བླང་བ་ཉེ་བར་ལེན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "དེ་ལ་རེ་ཞིག་དོན་དམ་པར་བུམ་པ་ནི་འཇིམ་པ་དང་གཅིག་པ་ཉིད་མ་ཡིན་ཏེ།",
    "འབྲས་བུ་ལ་སོགས་པ་ཡིན་པའི་གཏན་ཚིགས་དག་གི་ཕྱིར།",
    "དཔེར་ན་འཇིམ་པའི་རང་གི་བདག་ཉིད་བཞིན་ནོ།",
    "དཔེར་ན་འཇིམ་པའི་རང་གི་བདག་ཉིད་བཞིན་ནོ་ཞེས་ཟེར་རོ།",
    "དེ་དག་གི་འཇིམ་པའི་བདག་ཉིད་དང་།",
    "ཞིག་པ་དག་གིས་མ་ངེས་པ་ཉིད་དང་།",
    "རང་བཞིན་ནི་ཤེས་པ་ཡོད་པ་ཉིད་ནང་གི་བྱེད་པར་སྣང་བའི་རྒྱུ་ཡིན་པས་ཕན་འདོགས་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྐྱེས་བུ་དག་སྤྱི་དང་ཁྱད་པར་དང་ལྡན་པ་ཉིད་ཡིན་པའི་ཕྱིར་དེ་དག་གི་མ་ངེས་པ་ཉིད་དེ།",
    "ཅི་རང་གི་རྒྱུ་ལས་སམ།",
    "གལ་ཏེ་རང་གི་རྒྱུ་ལས་ན་ནི་དཔེ་མེད་དོ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་ཡན་ལག་ཅན་སེང་ལྡེང་ནི་ཡན་ལག་སེང་ལྡེང་གི་རྩ་བ་དང་།",
    "དེ་དག་གི་ཕྱོགས་གཅིག་ཆད་ཀྱང་དེ་མི་འཆད་པའི་ཕྱིར་དཔེར་ན་རྒྱ་ཤུག་བཞིན་ནོ།",
    "དོན་དམ་པར་ཡན་ལག་ཅན་སེང་ལྡེང་ནི་ཡན་ལག་སེང་ལྡེང་གི་རྩ་བ་དང་།",
    "ལྟོས་པ་དང་བཅས་པའི་ཕྱིར་དཔེར་ན་སེང་ལྡེང་གི་ཡན་ལག་དག་གི་རང་གི་བདག་ཉིད་བཞིན་ནོ།",
    "དེ་བཞིན་དུ་དོན་དམ་པར་སེང་ལྡེང་གི་ཡན་ལག་དག་ནི་ཡན་ལག་ཅན་དང་།",
    "དེའི་ཕྱོགས་གཅིག་ཆད་ཀྱང་དེ་དག་མི་འཆད་པའི་ཕྱིར་དཔེར་ན་རྒྱ་ཤུག་གི་ཡན་ལག་དག་བཞིན་ནོ།",
    "དོན་དམ་པར་སེང་ལྡེང་གི་ཡན་ལག་དག་ནི་ཡན་ལག་ཅན་ལས་གཞན་ཉིད་མ་ཡིན་ཏེ།",
