    "ཤེས་པར་གྱུར་པ་ཡོད་ཡལྟའི་བུས་སྨྲས་པ།",
    "དེནས་ལྷའི་བུ་དེ་དག་འདི་སྙམ་དུམས་པར་གྱུར་ཏེ།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པར་བཏགས་པ་མད་དོ།",
    "བསམ་གཏན་རྣམས་དང་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་དང་སྟོང་པ་ཉིད་ཐ་ནི་ཐམས་ཅད་དུཡོད་དོ།",
    "ལྷའི་བུ་ག་དེ་ལྟ་བས་ན་གད་རྒྱུན་ཞུགས་པའི་འབྲས་བུ་གནས་པར་འདོད་ཅིང་།",
    "བཙུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་དང་།",
    "བླ་ན་མེད་པ་ཡང་དག་པར་རྫོགསབའི་བྱུང་ཆུང་ཀྱང་རྨི་འཚོ་ལྟ་བུ་སྒྱུམ་ལྟ་བུའོ།",
    "གལ་ཏེམྱ་ངན་ལས་འདས་པ་ལས་ཁྱད་པར་དུ་འཕགའཕགས་པའི་ཚོས་གཞན་ཞིག་ཡོད་ན་ཡང་དེ་ཡང་བདགའི་རྨི་ལམ་ལྟ་བུ་སྒྱུམ་ལྟ་བུར་འོ།",
    "འདི་ལྟར་མཁས་ཤིང་མཛེས་པས་རིག་པར་བྱ་བ་འདི་ལེན་པར་བྱེད་པསུ་ང་འབྱང་བར་འགྱུར།",
    "འདི་ལྟར་བརྟག་པར་བྱ་བམ་ཡིན་པ།",
    "འདི་ལྟར་རྗེས་རྫོགས་པར་དཀའ་བ།",
    "རྣམཔར་ཤེས་པ་སྟེང་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པ་མི་འགྱུར།",
    "རྣམ་པར་ཤེས་པ་འགག་པཚདཙེས་བྱ་བ་རྣམ་པར་རྟོག་པར་མི་འགྱུར།",
    "དེ་བཞིན་དུ་དྲན་པ་ཉེ་པར་གཞག་པ་དང་།",
    "མི་དབེན་ཞིག་བྱ་པ་རྣམ་པརརྟོག་པར་མི་འགྱུར་རོ།",
    "སྨོན་པ་མེད་པ་འདུས་བྱས་ཀྱི་ཁམས་ཞེས་བྱ་པར་རྣམ་པར་རྟོག་པར་འགྱུར་རོ།",
    "འངུས་མ་བྱས་ཀྱི་ཁམས་འགག་པ་མེད་ཅེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མ་འགྱུཡའགག་པ་མེད་པ་འདུས་མ་བྱས་ཀྱི་ཁམས་ཞེས་བྱ་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "འདུས་མ་བྱསཀྱི་ཁམས་ཞི་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པའམ་འགྱུར་ཞི་བ་འདུས་མ་བྱས་ཀྱི་ཁམས་ཞེས་བྱ་བ་རྣམ་པར་ག་པར་མི་འགྱུར་རོ།",
    "དབེན་པ་འདུས་མ་བྱས་ཀྱི་ཁམས་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པར་མི་འགྱུར་རོ།",
    "དེ་ལྟར་མཁས་ཤིང་མཛེས་པས་རིག་པར་བྱ་པའི་བར་འདི་ཡིན་པར་བྱེད་པ་སུ་ཡང་མེད་དོ།",
    "རྣམ་པར་ཤེས་པ་མི་དམིགས་པའི་ཚུལ་དང་།",
    "འདུ་བྱེད་རྣམས་དང་རྣམ་པར་ཤེས་པ་ཡང་མ་བྱུང་བ་ཡིན་རཔོའ་ཕྱིས་སྨྲས་པ།",
    "བསམ་གཏན་དང་གསུམེད་པའིསྙོམས་པར་འཇུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ཇི་ལྟུང་གནས་བརྟན་རབ་འབྱོར་འདི་ནི་བརྟགས་པ་དང་ཡང་འགལ་ལཚེསདེ་ཀྱང་སྟོན་པ་ལགས།",
    "ཡང་དག་པར་སྦྱོངས་བ་རྣམས་དང་།",
    "རྫུ་འཕྲུལ་གྱི་དང་པརྣམས་དང་།",
    "གཟུགསམེད་པའི་སྙོམས་པར་འཇུག་པ་ཡས་དང་།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ཡང་ངག་པརརྗེསུམ་མཐོང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམས་དང་།",
    "རྣམ་པ་ཐམས་ཅདམཁྱེན་པ་ཉིད་ཀྱི་བར་དངོཔ་ཉིད་ལ་བསླབ་བོ།",
    "རྣམ་པ་ཐམསཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་སྟོང་པ་ཉིད་ལ་གཉིས་སུ་བྱར་མེད་པས།",
    "ཞི་གཉིས་སུ་པར་མེད་པས་དྲན་པ་ཉེ་བར་བཞག་པ་རྣམས་དང་།",
    "གཟུགསམེད་པའི་སྙོམས་པར་འཇུག་པརྣགས་དང་།",
    "འགྲིབ་པར་སླ་བའི་ཕྱིརམི་སློབ་པོ།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའཕེལ་བར་བྱ་བ་དང་འགྲིབ་པར་བྱ་བའི་ཕྱིའི་མི་སློབ་པ།",
    "སྤྲུལ་པ་ཐམསཅད་སྙཁྱེན་པ་ཉིད་ཀྱི་བར་འཕེལ་བར་བྱ་བ་རངའགྲིབ་པར་བྱ་བའི་ཕྱིར་མི་སློབ་བོ།",
    "རྣམ་པ་ཐམསཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་འཕེལ་བར་བྱ་བདང་།",
    "མེད་པར་བྱ་བའི་ཕྱིར་མིསློབ་བོ།",
    "རྣམ་པར་ཤེས་པ་རྣམ་པར་ཤེས་པས་ཡོངསུ་གཟུང་དུ་མེད་པས།",
    "རྣམ་པར་བྱད་བ་དང་།",
    "གཟུགསམེད་པའི་སྙོམས་པར་འཇུག་བ་རྣམས་དང་བདེནཔ་རྣམས་དང་།",
    "རྣམ་པར་བྱང་བ་མེད་པ་དང་།",
    "རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ལ་ཡང་དེ་བཞིནགཤེགས་པ་མི་དམིགས།",
    "དེ་བཞིན་བཤེགས་པ་ལ་ཡང་རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་མི་དམིགས་སེ།",
    "དེ་བཞིན་གཤེགས་པ་ལ་ཡང་རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་དེ་བཞིན་ཉིདམི་ངོམིགས་སོ།",
    "འདུ་བྱེད་རྣམས་དང་རྣམ་པར་ཤེས་པའི་དེ་བཞི་ཉིང་མ་ཡིན་པ་གཞན་དང་ལྡན་པ་མ་ཡི།",
    "རྣམ་པར་ཤེས་པ་ལས་བཙལ་བར་བྱ་རྣམ་པར་ཤེས་པ་ལས་གཞན་ང་ཡང་བཙལ་བར་མི་བྱའོ།",
    "རྣམ་པར་ཤེས་པ་གང་ཡིན་པ་དང་།",
    "གཟུགས་མེད་པའི་སྙོམ་པར་འཇུག་པ་མས་དད་བདེན་པ་མས་དང་།",
    "རྣམ་པ་ཐམས་ཅདམདུན་པར་ཀྱི་བར་ལས་ཀྱང་བཙལ་བར་མི་བྱ།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་གང་ཡནི་པ་དང་།",
    "འདུ་བྱེདཙཱཛཱསཾ་༤་༥ ཡ་པར་ཤེས་པ་ཤིས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡིན།",
    "གཟུགས་མེད་པའིསྙོམས་པར་འཇུག་པ་རྣམས་དང་།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བ་ཡང་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མ་ཡིན།",
    "རྣམ་པ་ཐམས་ཅདམཁྱེན་པ་ཉིད་ལས་གཞན་ཤེས་རབཀྱི་བརོལ་ཏུ་ཕྱིན་པ་མ་ཡིན།",
    "རྣམ་པར་ཤེས་པའི་དེ་བཞིན་ཉིད་ལས་གཞན་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་ཡིན།",
    "༩༢ ང་དཔརོལ་དུ་ཕྱིན་པཧན་པ་ཐམས་༦དཨཁྱེན་པ་ཉིད་ཀྱི་བར་གྱི་དེ་བཞིན་ཉིད་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མ་ཡིན།",
    "རྣམ་པར་ཤེས་པ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མ་ཡིན།",
