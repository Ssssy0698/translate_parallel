    "རྣམ་པར་འཕེལ་བར་བྱེད་པ་མ་ཡིནནོཞེས་བྱ་བ་ནི་ལ་ལ་ཆོག་ཤེས་པའི་བཟོད་པ་ཡིནནོ།",
    "ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ན་སངསརྒྱས་བཅོམ་ལྡན་འདས་གང་བཞུགས་ཤིང་འཚོ་སྐྱོང་བ་དེ་དག་ཀྱང་རིགས་ཀྱི་བུ་འམ།",
    "ཚུལ་བཞིན་དུ་རྟག་ཏུ་རྒྱུནམིའཆད་པར་བསྲུང་བ་དང་།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པས་མ་པར་འཁྱིལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པརམ་འགྱུར་རོ།",
    "ཡོངས་སུ་འགྲིབ་པར་འགྱུརཡོ།",
    "རྣམས་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ།",
    "གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱིས་རྣམ་པར་འཕེལ་བར་འགྱུར་གྱི་ཡོངས་སུ་འགྲིབ་པར་མི་འགྱུར་རོ།",
    "སོ་སོ་ཡང་དག་བར་རིག་པརྣམས་དང་།",
    "ཡོངས་སུ་འགྲིབ་པརམ་འགྱུར་རོ།",
    "གཟུགས་ཀྱི་སྒོ་ཐམས་ཅད་ཀྱིས་རྣམ་པར་འཕེལ་བར་གྱུར་གྱི།",
    "རྣམ་པ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་ཀྱི་བར་གྱིས་རྣམ་པརའཕེལ་བར་འགྱུར་གྱི།",
    "ཡོངསུ་འགྲིབ་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ནི་ལས་ལས་ཤེས་པ་ཡིན།",
    "དེ་ཚིག་བླང་བར་འོས་པ་དང་ལྡན་པར་འགྱུར་རོ།",
    "ཁྲོ་བས་ཟིལ་གྱིས་ནོན་པར་མི་འགྱུར་རོ།",
    "གཞན་སྲོག་གཅོད་པ་སྤོང་བ་དེ་རྣམས་ཀྱི་ལེགས་པ་བརྗོད་པར་འགྱུར།",
    "སྤོང་བ་ལ་ཡང་དག་མ་རྣམས་ཡང་ལེགས་པ་བརྗེད་པར་འགྱུར་ཞིང་མཉན་པས་དགའ་བར་བྱེད་དོ།",
    "གཞན་བརྫུན་དུ་སྨྲ་བ་སྤྱོད་བར་འགྱུར་བ་དེ་རྣམས་ཀྱི་ལེགས་པ་བརྗོད་པར་འགྱུར་ཞིང་མཐུན་པས་དགའ་བར་བྱེད་པོ།",
    "ཚོགོ་བཀྱལཔ་སྤོང་བའི་ལེགས་པ་བརྗོད་པར་འགྱུར།",
    "བརྣབསེམས་ལས་ལྷག་པའི་བསྔགས་པ་བརྗོད་པར་འགྱུར།",
    "གཞན་གནོད་སེམས་རབ་ཏུ་ལྡོག་པར་འགྱུརབ་གང་ཡིན་པ་དེ་རྣམས་ཀྱི་ལེགས་པ་བརྗོད་པར་འགྱུར་ཞིང་མཐུན་པས་དང་།",
    "པདག་ཀྱང་སྤྱནེ་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་པར་འགྱུར།",
    "སྤྱན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ལེགས་པ་བརྗོད་པར་འགྱུར།",
    "གཞན་སྤྱནེཔའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་འཇུག་པར་འགྱུར་བ་གང་ཡིན་པདེ་རྣམས་ཀྱི་ལེགས་པ་བརྗོད་པར་འགྱུར་ཞིང་མཐུན་པསདགའ་བར་བྱེད་དོ།",
    "པ་པད་པར་འགྱུར།",
    "བདག་ཀྱད་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་པར་འགྱུར།",
    "ཞིནུ་ཡང་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་རབ་ཏུ་འགོད་པར་འགྱུར།",
    "གཞན་བཟོད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་པ་གང་ཡིན་པ་དེ་རྣམས་ཡད་ལེགས་པ་རྗོད་པར་འགྱུར་ཞིང་མཐུན་པས་དགའཔར་བྱེད་དོ།",
    "པདག་ཀྱང་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་པརའགྱུ།",
    "གཞན་ཡང་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་རབ་ཏུ་འགོད་པར་འགྱུར།",
    "བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་རིགས་པ་བད་པར་འགྱུར་གཞན་བརྩོན་འགྲུས་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་སྤྱོད་པར་འགྱུར་བ་གང་ཡིན་པ་དེརྣམས་ཀྱི་ལེགས་པ་བརྗོད་པར་འགྱུར་ཞིང་མཐུན་པས་དགའ་བར་བྱེདདོ།",
    "བདག་ཀྱང་བསམགཏནགྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་གནས་པར་འགྱུར།",
    "གཞན་བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་སྤྱནི་པ་རབཅུ་འདོད་པར་འགྱུར།",
    "བསམ་གཏན་གྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ལེགས་པ་བརྗོད་པར་འགྱུར།",
    "བན་བསམ་གཏན་སྤྱི་པཱརཱལ་ཏུ་ཕྱིནྡྲིཔ་ལ་སྤྱོད་པ་གང་ཡིན་པ་དེ་རྣམས་ཀྱི་ལེགས་པ་བརྗོད་པར་འགྱུར་ཞིང་མཐུན་པས་དགའ་བར་བྱེད་དོ།",
    "གཞན་ཡང་ནང་སྟོང་པ་ཉིད་ལ་རབཏུ་འགོང་པར་གྱུར།",
    "བདག་ཀྱང་ཕྱི་སྟོང་པ་ཉིད་ལ་རབ་ཏུ་གནས་པར་འགྱུར།",
    "བདག་ཀྱང་ཕྱི་ནང་སྟོང་པ་ཉིད་ལ་གནས་པར་འགྱུར།",
    "ཕྱི་ནང་སྟོང་པ་ཉིད་ཀྱི་ལེགས་པ་བརྗོད་པར་འགྱུར།",
    "གཞན་ཡང་དངོས་པོ་མེད་པའི་དོ་བོ་ཉིད་སྟོང་པ་ཉིད་ཀྱི་བར་ལ་རབ་ཏུ་འགོད་པར་འགྱུར་རོ།",
    "བདག་ཀྱང་ཏིང་ངེ་འཛིན་ཐམས་ཅད་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "གཞན་ཡང་ཏིང་དྲི་འཛིན་ཐམསཅད་ལསེམས་པར་འཇུག་པ་ལ་རབ་ཏུ་འགེང་པར་འགྱུར།",
    "ཏིང་ངེའཛིན་ཐམས་ཅང་ལ་སྙོམས་པར་འཇུག་པའི་ལེགས་པ་དོད་པར་འགྱུར།",
    "གཞན་ཏིང་ངེ་འཛིན་ཐམས་ཙད་ལ་སྙོམས་པར་འཇུག་པ་དད་ཡིན་པ་དེ་རྣམས་ཀྱི་ལེགས་པ་བརྗོདཔང་འགྱུརཞིངམཐུནཔས་དགའ་བར་བྱེད་པོ།",
    "གཞན་ཡང་གཟུངས་རྣམས་ཐོབ་པར་བྱེདཔ་ལ་རབ་ཏུ་འདོད་པར་འགྱུར",
    "གཞན་བསམ་གཏན་དང་པོ་ལ་སྙོམས་པར་འཇུག་པ་གང་ཡིན་པ་དེ་རྣམས་ཀྱི་ལེགས་པ་རང་པང་འགྱུར་ཞིང་མཐུན་པས་དགའ་བར་བྱེད་དོ།",
    "བསམ་གཏན་གསུམ་པར་སྙོམས་པར་འཇུད་པར་འགྱུར།",
    "བདག་ཀྱང་བསམ་གཏན་བཞི་བ་ལ་སྙོམས་པར་འཇུག་པར་འགྱུར།",
    "བསམ་གཏན་བཞི་པར་ལེགས་པ་དྷཱཛོད་བར་འགྱུར།",
    "གཞན་བསམ་ཏན་བཞི་པ་ལསྙོམས་པ་འཇུག་པ་གང་ཡིན་པ་དེ་རྣམས་ཀྱི་ཡང་ལེགས་པ་ངརྗོད་པར་འགྱུར་ཞིང་མཁྱེན་པས་དགར་བར་བྱེད་དོ།",
    "ད་ངག་ཀྱང་བྱམས་པ་ལ་སྙོམས་པར་འཇུག་པར་གྱུར།",
    "གཞན་ཡང་ངུམསཔ་ལ་སྙོམས་པར་འཇུག་པ་ལ་རང་དུ་འགོད་པར་འགྱུར",
    "བྱམས་པ་ལ་སྙོམས་པར་འཇུག་པའི་ལེགས་པ་བརྗོད་པར་འགྱུར།",
