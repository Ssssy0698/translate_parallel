    "བྱེད་དོ་བྱེད་པརའགྱུར་རོ་ཞེས་བྱ་བ་དེ་དག་ལ་སོགས་པའི་བྲྗོད་པ་དག་མི་འཐད་པཁོ་ནར་འགྱུར་བཞིག་ན་འཐད་པ་ཡང་ཡོད་པས་དེའི་ཕྱིར་དུས་ནིཡོད་པ་ཁོ་ན་ཡིན་ནོ།",
    "བྲྗོད་པར་བྱ་བ་ལྡོག་པས་ཏེ།",
    "དེ་ལྟ་བས་ན་དུས་ཞེས་བྱབ་དངོས་པོ་འགའ་ཡང་མེད་པར་ཤེས་པར་བྱ་སྟེ།",
    "བརྟེན་ནས་བརྟགསཔར་ནི་འགྲུབ་པོ།",
    "གལ་ཏེ་འབྲས་བུ་སྐྱེ་བ་ཉིདའཐད་པར་འགྱུར་ན་ནི་འབྲས་བུ་སྐྱེ་བས་དུས་ཀྱང་ཡོད་པར་འགྱུརགྲང་ན།",
    "ཉིད་མི་འཐད་པས་འབྲས་བུའི་རྒྱུ་ཅན་གྱི་དུས་ཡོད་པརག་ལ་འགྱུར།",
    "སྐྱེ་བ་ན་མེད་པསྐྱེས་ན་ཇི་ལྟར་ཡོད་པར་འགྱུར།",
    "གལ་ཏེརྒྱུ་དང་རྐྱེན་རྣམས་ཀྱི་ཚོགས་པ་ཉིད་ལ་འབྲས་བུ་དེ་ཡོད་པཉིད་ཡིན་པར་གྱུར་ན་ཚོགས་པ་ཉིད་དེ་ལས་ངེས་པར་གནས་པ་དེཤིང་ལ་བྱ་བཞིན་དུ་གཟུང་དུ་ཡོད་པའི་རིགས་ན་དེ་ལ་དེ་ཡང་ཡོདཀྱང་གཟུང་དུ་མེད་དེ།",
    "གཟུང་དུ་མེད་པ་དེ་ཇི་ལྟར་ཡོད་ཅེས་བྱ་དེ་ལྟ་བས་ན་ཚོགས་པ་ཉིད་ལ་འབྲས་བུ་ཡོད་པར་མིའཐད་དོ།",
    "རྒྱུ་རྐྱེན་མཡིན་མཚུངས་པར་འགྱུར།",
    "གལ་ཏེ་རྒྱུ་དང་རྐྱེན་རྣམས་ཀྱི་ཚོགས་པཉིད་ལ་འབྲས་བུ་དེ་མེད་པ་ཉིདཡིན་པར་གྱུར་ན།",
    "རྒྱུ་རྣམས་དང་རྐྱེན་དག་ཀྱང་རྒྱུ་དང་རྐྱེནམ་ཡིན་པ་རྣམས་དང་མཚུངས་པར་འགྱུར།",
    "གལ་ཏེ་ཐམས་ཅད་ཐམས་ཅད་ཀྱི་རྒྱུ་དངརྐྱེན་དག་ཡིན་པར་གྱུར་ན་ནི།",
    "གལ་ཏེ་མེད་ན་ནི་དེ་ངེས་པར་གནས་པའི་གཏནཚིགས་མེད་པ་ཇི་ལྟར་རུང་བར་འགྱུར།",
    "རྒྱུ་དང་རྐྱེན་རྣམས་ལ་འབྲས་བུཡོད་ན་ནི་འབྲས་བུ་ཡོད་པས་ངེས་པར་གྱུར་བར་ཡང་འཐད་ན་དེཡང་མེད་དེ།",
    "གང་ངེས་པར་སྣང་བ་དེ་ཡང་རྒྱུ་དང་རྐྱེན་རྣམས་ལའབྲས་བུ་ཡོད་ན་འཐད་ཀྱི་མེད་ན་མི་འཐད་པས།",
    "དེ་ལྟ་བས་ན་མེད་པ་སྐྱེ་བའི་གཏན་ཚིགསགཞན་འགའ་ཞིགབསྟན་པར་བྱ་དགོས་ཏེ།",
    "དེའི་ཕྱིར་ངེས་པར་མཐོང་བ་ནིཚོགས་པ་ཉིད་ལའབྲས་བུ་ཡོད་པ་སྟོན་པ་ཡིན་ནོ།",
    "འདི་ལ་རྒྱུས་འབྲས་བུལ་རྒྱུ་བྱིན་ནས་འགགས་པས་དེའི་ཕྱིར་རྒྱུས་འབྲས་བུ་འགྲུབ་པརའགྱུར་ཞིང་རྐྱེན་རྣམས་ནི་དེ་ལ་ཕན་འདོགས་པར་བྱེད་པ་ཡིན་པས།",
    "གལ་ཏེ་རྒྱུས་འབྲས་བུ་ལ་རྒྱུ་བྱིན་ནས་འགག་པར་འགྱུར་ན།",
    "འབྲས་བུ་ཡོད་པ་དང་མེད་པ་ལ་རྒྱུ་སྦྱིན་པར་མི་འཐད་པའི་ཕྱིརརོ།",
    "མེད་པ་ལ་ནི་སུ་ལ་སྦྱིན་པར་བྱསྨྲས་པ།",
    "འདི་ནི་འདིའི་འབྲས་བུའོ་ཞེས་རྣམ་པརགཞག་པ་འདི་ཇི་ལྟར་ཡོད་པར་འགྱུར།",
    "འབྲས་བུ་སྐྱེས་པར་གྱུར་ན་ནི།",
    "འདི་ལྟར་འབྲས་བུའི་དོན་དུ་རྒྱུདང་རྐྱེན་ཚོགས་པར་འདོད་ན།",
    "འདིལ་གལ་ཏེ་རྒྱུས་འབྲས་བུ་སྐྱེད་པར་གྱུར་ན་འགགས་པས་སམ་གནས་པསསྐྱེད་པར་བྱེདགྲང་འབྲས་བུ་ཡང་སྐྱེད་པ་ཉིད་དམ་མ་སྐྱེས་པ་སྐྱེད་པར་བྱེདགྲང་ན།",
    "འགགས་པ་ནུབ་པར་གྱུར་པ་ཡིས།",
    "འདི་ལྟརརྒྱུ་འགགས་པ་ནུབ་པར་གྱུར་པས་འབྲས་བུ་སྐྱེས་པ་ཡོད་པ་ཉིད་ཇིལྟར་སྐྱེད་པར་བྱེད།",
    "སྐྱེས་པ་ཉིད་ཡང་ཅི་ཞིག་བསྐྱེད་པར་བྱ་དགོས།",
    "ཅི་སྟེ་ཡངའདི་སྙམ་དུ་འབྲས་བུ་དང་འབྲེལ་པའི་རྒྱུ་འབྲས་བུ་དང་ལྡན་པགནས་པ་ཉིད་ཀྱིས་འབྲས་བུ་སྐྱེད་པར་བྱེད་པར་སེམས་ན།",
    "འདི་ལྟར་རྒྱུ་གནས་པས་འབྲས་བུ་ཡོད་པ་ཉིད་ཇི་ལྟརསྐྱེད་པར་བྱེད།",
    "འབྲས་བུ་གང་ཞིག་སྐྱེད་པར་བྱེད།",
    "འབྲས་བུ་སྐྱེད་པར་མི་བྱེད་དོ།",
    "འདི་ལ་གལ་ཏེ་རྒྱུས་འབྲས་བུབསྐྱེད་པར་གྱུར་ན་མཐོང་ནས་སམམ་མཐོང་བར་སྐྱེད་པར་འགྱུར་གྲང་ན།",
    "དེ་ལྟར་ན་སྐྱེས་པ་སྐྱེད་པར་བྱེད་པར་འགྱུར་ཏེ།",
    "སྐྱེས་པ་ལ་ནི་ཡངབསྐྱེད་པར་བྱ་མི་དགོས་སོ།",
    "ཅི་སྟེ་ཡང་རྒྱུས་མ་མཐོང་བར་འབྲས་བུ་སྐྱེད་པར་བྱེད་པར་རྟོགན།",
    "དེ་ལྟ་ན་ཡང་རྒྱུས་གང་དང་གང་མ་མཐོང་བ་དེ་དང་དེསྐྱེད་པར་འགྱུར་བ་ཞིག་ན་སྐྱེད་པར་ཡང་མི་བྱེད་དེ།",
    "དེ་ལྟ་བསན་རྒྱུས་མ་མཐོང་བར་ཡང་འབྲས་བུ་སྐྱེད་པར་མི་བྱེད་དོ།",
    "འདི་ལ་གལ་ཏེ་རྒྱུས་འབྲས་བུབསྐྱེད་པར་གྱུར་ན།",
    "ཕྲང་ནས་སྐྱེད་པར་འགྱུར་གྲང་ན།",
    "ལྷན་ཅིག་ཕྲད་པར་འགྱུར་བ་ནི།",
    "འདས་པ་དང་མ་སྐྱེས་པ་དང་ལྷན་ཅིག་ཕྲད་པར་འགྱུརབ་ནམ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "འབྲས་བུ་འདས་པ་དངརྒྱུ་སྐྱེས་པ་ཡང་ལྷན་ཅིག་ཕྲད་པར་འགྱུར་བ་ནམ་ཡང་ཡོད་པ་མཡིན་ཏེ།",
    "ལྷན་ཅིག་ཕྲད་པར་འགྱུར་བ་ནི།",
    "འབྲསབུ་མ་སྐྱེས་པ་དང་རྒྱུ་སྐྱེས་པ་ཡང་ལྷན་ཅིག་ཕྲད་པར་འགྱུརབ་ནམ་ཡང་ཡོད་པ་མ་ཡིན་ཏེ།",
    "ལྷན་ཅིག་ཕྲད་པར་འགྱུརབ་ནི།",
    "འབྲས་བུ་སྐྱེས་པ་ནི་རྒྱུསྐྱེས་པ་དང་ལྷན་ཅིག་ཕྲད་པར་འགྱུར་བ་ནམ་ཡང་ཡོད་པ་མ་ཡིནཏེ།",
    "དེའི་ཕྱིར་དེ་ལྟརའབྲས་བུ་འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་དང་རྒྱུ་འདས་པདང་མ་འོངས་པ་དང་ད་ལྟར་དུ་ལྷན་ཅིག་ཕྲད་པར་འགྱུར་བ་རྣམཔ་ཐམས་ཅད་དུ་ཡང་མི་འཐད་ན།",
    "རྒྱུས་འབྲས་བུ་སྐྱེད་པར་བྱེདདོ་ཞེས་བྱ་བ་ཇི་ལྟར་འཐད་པར་འགྱུར་ན།",
    "ཅི་སྟེ་མི་འཐད་བཞིན་དུ་ཡང་རྒྱུ་དང་འབྲས་བུ་ཕྲདཔར་རྟོག་ན།",
    "དེ་ལྟ་ན་ཡང་རྒྱུ་ཡོད་པ་ཉིད་ཀྱིས་འབྲས་བུ་དེ་ཇིལྟར་སྐྱེད་པར་འགྱུར།",
