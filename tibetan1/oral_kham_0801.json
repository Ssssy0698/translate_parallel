    "ཚིག་རྩུབ་མི་སྨྲ་ཁ་རོག་འདུག་པར་བྱ།",
    "ཐང་གཅིག་འདུག་པའི་བློ་ཅན་ཏེ།",
    "ང་རང་ཁང་ཁྱིམ་གསར་པ་རྩིག།",
    "ང་ཡང་མི་སྤང་བར་སྐྱིད་པོ་ཡོང་བ་འདུག་བྱས་པས།",
    "དགྲ་ཡོད་པ་ཡིན་འདུག་གོ་སྙམ་ནས་འགྲོ་མ་ནུས་པར་ཕྱིར་ལོག་པས་དོན་མ་འགྲུབ་བོ།",
    "དེ་ནས་ལྷ་རྣམས་གྲལ་ལ་འཁོད་པར་བྱས་ཏེ་བདུད་རྩི་བགོ་བར་བརྩམས་པ་ན་ལྷ་མ་ཡིན་དེའང་གྲལ་མཇུག་ཏུ་བསྡད་པ་ལྷའི་བུ་ཟླ་བས་མཐོང་ནས་འདི་ན་སྒྲ་གཅན་དུ་འདུག་གོ་ཞེས་སྨྲས་པས།",
    "ལྷ་མ་ཡིན་དེས་བདུད་རྩི་མི་ཐོབ་པ་ཡིན་འདུག་སྙམ་ནས་ཐེ་ཚོམ་མེད་པར་མཆོངས་ཏེ་བདུད་རྩིའི་སྐལ་བ་ཞིག་རང་འཚམ་གྱིས་བླངས་པས་དེ་མ་ཐག་ཏུ་བདུད་རྩི་མྱངས་སོ།",
    "ད་ནི་ཁྱེད་རང་འདོང་དང་ཞེས་བརྗོད་ཅིང་ཁོ་ཁྲིད་དེ་ཕྱིན།",
    "ཞེས་འབོད་ཀྱིན་འདུག་པ་ལ་སྲེག་པས་སྨྲས་པ།",
    "ལས་ཀྱི་རྣམ་སྨིན་བྱུང་ནས་གདའོ།",
    "ག་རིན་ངན་ཀྱང་བུ་ཤ་ལོན་པར་གདའ།",
    "ཞེས་ཟེར་གྱིན་ཡོད་ཙ་ན།",
    "ཁང་པ་ལྕགས་ཀྱི་སྒོ་ཡོད་པ་ཞིག་འདུག།",
    "ཁྱེད་རྣམས་སླེབས་པ་དང་བདག་ཅག་རྣམས་འདིར་བཅུག་སྟེ་ཟ་བར་འདུག་གོ།",
    "དེ་ལྟ་བུ་འདུག་ན་ང་ལ་སྟོན་ཅིག་ཅེས་སྨྲས་སོ།",
    "དེ་ནས་ཡུན་རིང་པོ་ཞིག་ན་གླང་པོ་ཆེ་དེ་རྒས་ནས་ལུས་རྒུད་པ་དང་ས་ཁུང་དོག་པ་ཞིག་ན་འགྱེལ་ནས་ལངས་མ་ཐུབ་པར་སྨྲེ་སྔགས་འདོན་ཞིང་འདུག་པ་བྱི་བ་དེས་མཐོང་ངོ།",
    "གྲོགས་པོ་མི་དྲིན་ཅན་དེ་ནི་ཉམ་ཐག་ནས་འདུག་གོ།",
    "༡༨ཁྭ་བཞིན་མུ་ཅོར་མི་སྨྲ་ཁ་རོག་འདུག།",
    "ཁྱེད་རྣམས་ཀྱིས་རྒྱལ་པོ་དབྱིག་ཟེར་བ་འདི་ཡང་ཝ་ཡིན་འདུག་ན།",
    "ཀུན་ཏུ་དགེ་ཡིས་རྟོལ་བར་མི་གདའ་བས།",
    "གང་ནས་འོངས་པ་ང་རང་ལ་ཡང་ཆ་མེད་དོ།",
    "ཡུལ་ཕྱོགས་འདི་ན་མི་གཞན་སུ་ཡང་མི་འདུག་པས་འོ་སྐོལ་གཉིས་ལྷན་ཅིག་ཏུ་འདུག་གོ།",
    "ལུས་ངལ་ཞིང་ཐང་ཆད་པར་གྱུར་པ་དང་ལམ་བར་ན་ཤིང་སྡོང་པོ་ཞིག་ཡོད་པའི་དྲུང་དུ་ཉལ་ནས་བསྡད་པས་ནམ་ཕྱེད་ཙ་ན་བུ་གཅིག་སྐྱེས་སོ།",
    "ཁོ་བོ་ཀརྨ་དང་རི་བོ་ཆེའི་བར་དེར་སྐྱེས་གསུངས་ཟེར་བའི་ངག་རྒྱུན་དང་བཀའ་འབུམ་ལ་འདུག་པ་དང་མཐུན་ནོ།",
    "རྒྱས་འབྲིང་རྣམ་གསུམ་དངུལ་གྱི་བྲིས་པ་འདུག།",
    "ཤ་བའི་ཁོག་པ་ཁོ་རང་གཅིག་པུས་རྟ་ལ་བཀལ་ནས་འོང་བ་དང་།",
    "བུ་ཆུང་ཡི་གེ་ཤེས་ཙམ་ནས་རྔ་རྡང་བྱེད་ཅིང་ལྷ་རྒྱུད་ཡིན་ཕན་ཐོགས་ཆེ་ཟེར་སྲོལ་གདའ་བས།",
    "ང་ལ་ཚ་བོ་གཅིག་ནི་ཡོད་པ་དེ་། གོག་མི་དགོས་པར་ལངས་ནི་འགྲོ་འདུག་པ།",
    "མཚམས་ཁང་ནང་དུ་མཚམས་ལ་འདུག་པ་དང་།",
    "རྨི་ལམ་དུ་ཡང་ཁྱེད་རང་དཔལ་རི་ཡི།",
    "རང་གར་བཞག་པས་འོང་ལེ་མི་གདའ་ཞིང་།",
    "དེ་ཉིད་ཡོ་ནས་འགྱེལ་ལ་ཁད་དུ་གདའ།",
    "མཁར་རྩག་སོ་མ་འདི་ནི་ཡོ་འདུག་པ།",
    "ཆེ་ཆུང་གཡག་ཙམ་གདའ་བ་མཆོངས་བྱུང་བས།",
    "ཁྱེད་འདི་ན་འགྲོ་དོན་ཆེ་བར་མི་འདུག་པས།",
    "ཁྱེད་འདི་ནས་འགྲོ་དོན་ཆེ་རུ་མི་འདུག་པས།",
    "མདུན་དུ་མ་ཎི་རྒྱ་མཁར་ཆེན་པོའི་རྩེར་། བཅོ་ལྔའི་ཟླ་བ་བབ་ནི་འདུག་པ་ལ།",
    "ཕྱིར་ནངས་སྐར་མ་རྒྱལ་ལ་བབ་འདུག་པས་། རྫོགས་ཆེན་ལུགས་ཀྱི་སྐྱབས་སེམས་རྣལ་འབྱོར་པའི།",
    "ཚེ་དཔག་ལྷ་དགུའི་ཆོ་ག་བཏང་བ་ལ་། ངེད་གསུམ་འདོན་པ་ངེས་པོ་མི་གདའ་བས།",
    "བརྩེ་བའི་རྣམ་འགྱུར་བྱེད་ཅིང་འདུག་པ་རྨིས།",
    "འདུག་སྣང་བྱུང་བས་དེ་བལྟས་སྐྲག་སྔངས་ཞི།",
    "རྨི་ལམ་ཡུལ་དུ་གནོད་བྱེད་འགའ་འདུག་པས།",
    "ནམ་མཁར་འདུག་ལ་ཀུན་གྱིས་ངོ་མཚར་བྱེད།",
    "ཨོ་རྒྱན་རྡོ་སྐུ་ལེགས་པ་ཞིག་འདུག་པ།",
    "མི་བཞི་ཤི་འདུག་སྔོན་ཚེ་དེ་ཚོ་ཡི།",
    "འདི་རུ་སླེབ་པ་ཡིན་པར་འདུག་པ་ལ།",
    "ང་ཡིས་གཏོཪ་སྐམ་མུར་སྟོང་བྱེད་ཅིང་གདའ།",
    "ཟངས་ཀྱི་ནང་དུ་བཙོ་ཞིང་འདུག་པ་དྲངས།",
    "འདི་ཡིས་ཀུན་ལ་གནོད་པ་བྱེད་པར་འདུག།",
    "ངེད་རང་ཚང་ལའང་གནོད་དོགས་འདུག་གསུངས་ནས།",
    "ཁྱེད་རང་ཡིན་པ་མི་དྲན་ལགས་སམ་ཞུས།",
    "དེ་རྣམས་རྒྱུན་དུ་དྲན་པར་འདུག་གོ་གསུངས།",
    "ཁྱེད་རང་ཆབ་བསིལ་ཐོང་ཆོག་ཨི་ཁོ་གསུངས།",
    "མི་ཕོད་ང་རང་ཆབ་རྫིས་ཡོད་ལགས་ཞུས།",
    "དགེ་སློང་དེ་ཡིས་ཁུར་རྒྱུ་རྙེད་འདུག་པ།",
    "གཟིམ་པ་བྱས་ཤིང་ང་རང་རྩ་བར་ཉལ།",
    "ཆུ་ནང་འཇའ་སྤྲིན་སྣ་ཚོགས་དོད་ནས་འདུག།",
    "ད་ནི་རྒྱབ་འདིར་ཕྱག་རྡོར་མི་གདའ་སྟེ་། ད་ལྟ་ངས་ནི་མང་པོ་དྲན་བྱུང་གསུངས།",
    "ཤཱཀྱ་ཐུབ་པ་ལ་ཐོར་གཙུག་བྲིས་གདའ་བ་འདི་ཐོར་ཅོག་མིན།",
    "དེ་དུས་མན་ད་ར་བ་དང་མཚོ་རྒྱལ་མི་གདའ།",
    "རྗེས་ཤིག་མཚོ་རྒྱལ་ཡང་ཕྱིན་གདའ།",
    "མཆན་ཁུང་ན་ཁཊཱཾ་དེ་ནི་རྒྱུན་དུ་གདའ།",
    "དེ་དང་མཐུན་པར་འདུག་སྙམ་ཐེ་ཚོམ་ཆོད།",
    "བྱ་རོག་གསོབ་ལ་མི་ནག་གཅིག་ཞོན་གདའ།",
    "གསུང་འདུག་པ་ཡང་དེ་ག་དངོས་སུ་གྱུར།",
    "གཏན་ནས་མེད་སྙམ་མེད་ཞུས་གདའ་ད་གསུངས།",
    "ཇ་ཆུ་མེད་པཪ་གསོལ་ཇ་ཞན་འདུག་པས།",
    "སྣ་ཚོགས་རྡོ་རྗེའི་རྭ་ལ་ཡི་གེ་འདུག།",
    "ཨོ་རྒྱན་ཞལ་ནས་ཁྱེད་རང་སོ་སོ་ཡི།",
    "འདི་ཚོའི་བདག་པོ་རང་དེ་ང་རང་ཡིན།",
    "དེ་ནུབ་མྱུ་གུ་ཅུང་ཟད་སྐྱེ་གདའ་བ།",
    "ཁ་རྒྱས་གཡུལ་འཁྲུག་དབུས་སུ་འདུག་པ་བཞིན།",
    "ཞབས་གཉིས་ཞ་ནས་བཞེངས་འདུག་ཅུང་ཟད་མེད།",
    "ལྟས་དང་མཐུན་པར་ཐུགས་སློང་ཞད་འདུག་པ།",
    "མང་པོ་གདའ་བ་གནོད་པ་བྱེད་འདུག་པས།",
    "ང་རང་ཕྱག་རྡོར་དངོས་ཀྱི་སྐུར་གྱུར་ནས།",
    "ང་རང་དམིགས་པ་རྣོ་བར་ཡོད་འདུག་སྙམ།",
    "ཐམས་ཅད་རྟ་ལས་བབ་ནས་བསྡད་གདའ་བ།",
    "མདུན་ན་གང་འདུག་ཐམས་ཅད་འཕེན་པར་མཛད།",
    "འོད་དཔག་མེད་དང་གསུམ་པོ་བཞུགས་འདུག་ཛ།",
    "བརྒྱལ་ནས་འགྲོ་གྲབས་མཛད་ཅིང་འདུག་པ་ལ།",
    "རང་ཉིད་མི་ཡི་ལུས་སུ་གྱུར་འདུག་གསུངས།",
    "སྟ་གོན་གཅིག་ནི་མཛད་ཅིང་འདུག་གོ་གསུངས།",
    "ཁོ་རང་གནོད་པ་སྲུང་ཐབས་གདམས་པ་ཕུལ།",
    "བཞེངས་འདུག་ཆབ་བསིལ་དུས་ཀྱང་མཉམ་དུ་འབྱོན།",
    "ཁྱེད་རང་མཉམ་དུ་ཞུའམ་ཞུས་པ་ཡིས།",
    "ཁྱེད་རང་ཞུས་དང་ཁྱེད་ལ་ཞུ་བས་ཆོག།",
    "ཀུན་ཀྱང་བཞད་གད་དིར་དིར་བྱེད་འདུག་པས།",
    "གསར་དུ་འདུག་པ་ཕལ་ཆེར་ཡི་གེར་བཀོད།",
    "སྲོག་སྔགས་ཐུགས་ལ་འདུག་སྟེ་བྲི་མ་ཐུབ།",
    "མིག་འབྲས་བཞིན་དུ་ཧྲིལ་ལེ་འདུག་པ་བྱུང་།",
    "དེ་ཕྱིར་འདི་ནི་བརྩམ་དང་རང་བཟོ་སོགས།",
    "དག་པས་ང་རང་དངོས་སུ་མཐོང་ཡང་སྲིད།",
    "རང་རང་དམ་སྐལ་ལུང་དང་རིགས་པས་རྟོགས།",
    "བར་ཆད་མི་འོང་ལུང་བསྟན་གནང་འདུག་ཅིང་།",
    "ཉེ་བརྒྱུད་གསར་པ་མང་པོ་འོང་སྲོལ་གདའ་། མི་ཏྲ་ཁྲིད་དྲུག་མི་ཏྲ་གསང་སྒྲུབ་དང་།",
    "མཚམས་བརྒྱག་ཕུལ་ཞིང་སྐབས་སུ་ང་རང་ཡང་།",
    "སྔར་མུས་མཉམ་དུ་མཚམས་ལ་འདུག་པ་ཞིག།",
    "རང་རང་གནས་རྣམས་རྟ་ཕག་གཉིས་ལ་ཕུལ།",
    "མི་འགྲོ་ན་ཡང་ང་རང་འགྲོ་བས་ཆོག།",
    "བྲག་ཕུག་སྒོ་དེར་གྱང་ར་གཅིག་འདུག་པས།",
    "དཔལ་ལྡན་མགོན་པོའི་རྒྱུད་ལས་གསུངས་པ་ལྟར་། གནས་དང་རང་བྱོན་རྣམས་ནི་རྒྱལ་ཆེན་བཞིས།",
    "ཚ་ཚ་བརྒྱད་དང་ཉི་ཟླ་ཞབས་རྗེས་སོགས་། གསལ་ཞིང་ངེས་ཤེས་འདྲོང་བ་འགའ་འདུག་གོ།",
    "རྡོ་ནི་ཁུ་ཚུར་ཙམ་ཞིག་གཤིར་སྒྲར་བཅས།",
    "གཡག་དེའི་རྐང་པ་དྲུད་ཅིང་འགྲོ་འདུག་པས།",
    "ནམ་མཁའ་མཛོད་ཀྱི་བྲག་ཕུག་དེ་ཡིན་ཞིང་། དེ་རུ་གནས་སྒོ་གཏེར་སྒོ་འདུག་པ་ནི།",
    "བྲག་རྩར་བྱོན་པས་ཁོ་རང་ཁྱི་དམར་སྤྲུལ།",
    "དོམ་གཅིག་སྒོ་ཁྱི་བཞིན་དུ་འཐེན་ཅིང་འདུག།",
    "ཕེབས་ལམ་བན་དེ་ཞྭ་སེར་ཅན་ཞིག་འདུག།",
    "ཤིན་ཏུ་ཐར་བར་དཀའ་བའི་ས་འདུག་ཅིང་།",
    "མིག་གཡེལ་ཕུག་ཏུའང་རང་བྱོན་འགའ་ངོ་སྤྲད།",
    "སོག་པོའི་དཔོན་གཅིག་འདུག་པས་ལོ་ཙཱ་བཙུགས།",
    "སེར་བ་རྒོད་སོགས་ཆོ་འཕྲུལ་བྱུང་འདུག་ཅིང་།",
    "བསྲུང་རིམ་གར་བྱས་ན་ཚ་རྒོད་པར་གདའ།",
    "བཤིག་ནས་དུམ་བུ་མང་པོ་བྱས་གདའ་བ།",
    "རང་བྱོན་ངོ་མཚར་མང་པོ་བཏོན་རྒྱུ་གདའ།",
    "མཚོ་འགྲམ་ཞིག་ཏུ་ཐབ་གསུར་ཤོར་བ་དང་། ཕྱེ་རྒྱུའི་གནས་དེ་གཉན་པོར་འདུག་པའི་སློང་།",
    "སྐུ་འདྲའི་དབུ་ཞྭ་ཕུད་ནི་འདུག་པ་ལ།",
    "ཆས་ཀ་ཅི་འདུག་ཅི་ནི་མི་འདུག་པ།",
    "རྟགས་མཚན་འོང་བ་ཤིན་ཏུ་མྱུར་བར་འདུག།",
    "དེ་བཞིན་གནས་དང་རང་བྱོན་རྟེན་རྣམས་ཀྱང་།",
    "དེ་བཞིན་གནས་ནང་རང་བྱུང་རྟེན་རྣམས་ལ།",
    "དེ་ནི་ཤི་ནས་མཐོ་རིས་ངེས་འགྲོ་ཞིང་། ལྷ་ཡི་རྟེན་ལ་དེ་ལུས་འདུག་པར་ཤེས།",
    "ཚེ་དང་ལོངས་སྤྱོད་འཕེལ་འགྱུར་༡་༡ལ་རོ་། ཞེས་ཟེར་མཉམ་དུ་འདུག་པའི་སྣང་བ་བྱུང་།",
    "རང་རང་ང་རྒྱལ་ཆེ་སྣང་ཡོད་ཀུན་ཀྱང་།",
    "རང་རང་སོ་སོའི་བར་ཆད་རྐྱེན་ཞི་ནས།",
    "ཉམ་ང་ཁུ་འཕྲིག་དུས་མིན་ཚེ་ཡི་འཕྲང་།",
    "བར་དུ་གཅོད་བྱེད་བདུད་གཅིག་ཡོད་འདུག་པས།",
    "རང་རང་སྐྱེས་རབས་དགོངས་གཏེར་ཕྱུང་ནས་གནང་།",
    "དགོངས་གཏེར་ཕབ་ནས་ཁོ་རང་ཚང་ལ་གནང་།",
    "མི་འགྲིགས་པ་ནི་ཅི་ཡང་བྱུང་འདུག་ཅིང་།",
    "རང་རང་བར་ཆད་སེལ་ཞིང་འགྲོ་དོན་འཕེལ།",
    "རང་རང་སྐལ་པར་འཚམས་པ་དུ་མ་སྣང་།",
    "ཁོ་རང་བཅད་པ་ཡིན་ནི་ཟེར་བ་དང་།",
    "བློ་ལ་འདུག་པ་ལུང་བསྟན་བྱུང་བས་ཟེར།",
    "བྲག་ལ་ཕྱག་ཞབས་རྗེས་ཀྱང་བཞག་འདུག་པ།",
    "ཇི་སྲིད་རྟ་རྒྱུག་ཁྱི་རྗེས་འདུག་པ་ན།",
    "རང་རང་གཏེར་ཕྲན་ཅུང་ཟད་ཐོན་པ་འོང་།",
    "ཐུགས་ནི་ཤིན་ཏུ་གཏུམ་པ་ཡིན་འདུག་ཀྱང་།",
    "མང་པོ་ཤི་ནི་འདུག་པ་ཡི།",
    "གསེར་གྱིས་གར་བླུགས་མི་ཚད་འདུག།",
    "ང་འདུག་བཅུག་ལེ་མེད་དོ་ཞེས།",
    "ཆགས་ཕྱིར་འདུག་སྟབས་མ་བདེ་སྟེ།",
    "ཐུགས་ཀྱི་དད་གུས་རྩིས་ཆེན་མཛད་འདུག་པས།",
    "ད་ནི་ཅི་མཛད་ཡབ་གཅིག་ཁྱེད་རང་ཤེས།",
    "ཁྱེད་ནི་མཚམས་སྒྲུབ་མང་པོ་ཐོན་པ་ཡི་། རིག་འཛིན་རྒས་པོ་ཡིན་པར་འདུག་པའི་ཕྱིར།",
    "ཁྱེད་རང་དགོངས་པས་རྟོག་ལ་ཐག་ཆོད་ཞུས།",
    "ནམ་ཞིག་ཁྱེད་རང་དབུས་སུ་ཕེབས་དགོས་པས།",
    "ཆར་ཆེན་པོ་མི་གདའ།",
    "སྐུ་རྒྱལ་གྱི་ཞོལ་དུ་འདུག་དུས་རྡོ་གཅིག་ལ་རང་བྱོན་མང་པོ་འདུག།",
    "རྡོ་ཞིག་ལ་མཚན་མེ་འབར་ཞིང་འདུག།",
    "ཆུ་འགྲམ་དུ་ཀླུ་ནག་ཕྱོགས་ཤིག་འདུག་པས་བར་ཆད་བརྩམས།",
    "གསུངས་པཔའི་བཀའ་ལ་ཉན་མཁན་མི་གདའ་བས་ངེད་ཀྱི་ཡུལ་དུ་བྱོན་དང་ཞབས་ཏོག་རང་ཡུལ་དུ་ཆེ་ཟེར་ནས།",
    "ཆར་པ་དཀོན་པོ་ལས་མི་འདུག།",
    "བར་ཆད་ཕྱེད་པར་ཤོམ་པར་འདུག་སྟེ་བདག་ལ་མ་ཚུགས་སོ།",
    "རང་རང་རིགས་རུས་ཆོ་འབྲང་དང་།",
    "ཡར་ཉུག་མར་ཉུག་བྱེད་ཅིང་གདའ།",
    "སང་བོད་ཚུན་ཆད་དུས་མ་བདེ་ན་ཁྱད་པར་དུ་ཡང་རང་ཡུལ་དུ་འོང་ནས་དགོས་པ་གཅིག་ཀྱང་མེད།",
    "གལ་ཏེ་རང་ཡུལ་དུ་སྡོད་པ་བྱུང་ན་ནི་རང་གཞན་གཉིས་དོན་གཡེལ་ནས་མི་ཚེ་སྟོང་ཟད་དུ་འགྲོ་འདུག་པས་མགོ་ནག་མི་དང་ངོ་མི་ཐུག་པའི་མཚམས་ཤིག་བྱེད་ནས་སྡོད་ན་མ་གཏོགས་རང་ཡིད་རང་ལ་ཆད་པ་ཞིག་བྱུང་ལགས།",
