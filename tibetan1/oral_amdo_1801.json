    "ཞེས་པ་རང་བྱུང་གི་དབྱངས་དང་།",
    "རང་བྱུང་གི་ཡི་གེ་ཐུང་ངུ་དྲུག་སྲོག་ཏུ་ཞུགས་པའི་གསལ་བྱེད་ཀྱི་ཡི་གེ་གཞན་ཐམས་ཅད་ལའང་རིགས་འགྲེའོ།",
    "དེས་ན་གསལ་བྱེད་ཡི་གེ་རིང་བ་སུམ་ཅུ་དང་ཐུང་ངུ་སུམ་ཅུ་པོ་དེ་དག་རང་བྱུང་གི་ཡི་གེ་ཐིག་ལེ་ཅན་དང་ཚེག་དྲག་ཅན་དང་བཅས་པའི་རིང་པོ་དྲུག་དང་ཐུང་ངུ་དྲུག་གིས་ཕྱེ་བའི་སུམ་བརྒྱ་དྲུག་ཅུར་འགྱུར་རོ།",
    "རྩ་རེ་རེ་ལའང་།",
    "རང་བྱུང་གི་ཡི་གེ་སྲོག་ཏུ་ཞུགས་པས་ཕྱེ་བ་དང་།",
    "རང་གི་ཨ་ཐུང་ངུས་ཕྱེ་བའི་ང་དང་།",
    "གསལ་བྱེད་ཀྱི་ཡི་གེ་ལུགས་ལྡོག་དང་སྲོག་གི་ཡི་གེ་ལུགས་འབྱུང་དུ་སྦྱར་བར་བྱ་སྟེ།",
    "རེ་རེ་ནས་སྦྱོར་བ་འགྲེལ་པར་རྒྱས་པར་གསུངས་ཤིང་ཤེས་སླའོ།",
    "སྟེང་གི་གཡས་གཡོན་གཉིས་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
