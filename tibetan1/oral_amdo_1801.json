    "དེ་དག་གི་ཡབ་ཡུམ་སོ་སོར་བརྩིས་པས་ལྷ་ཉིས་བརྒྱ་དོན་བཞིའོ།",
    "ཉིས་བརྒྱ་དོན་བཞི་བཅད་པའི་ལྷ་ཉིས་བརྒྱ་དྲུག་ཅུ་རྩ་དྲུག་གི་གཉིས་ཀྱི་དམན་པའི་གྲངས་དང་།",
    "འདུས་པའི་དཀྱིལ་འཁོར་དྲུག་གི་ལྷ་གྲངས་སྦྱོར་བ་ལ།",
    "འདུས་པ་རྣམ་པ་དྲུག་གི་ལྷ་དགུ་མ་པཎྜི་ཏ་ཐ་ག་ན།",
    "སྐྱིལ་ཀྲུང་གིས་བཞུགས་པ།",
    "འདུས་པའི་དཀྱིལ་འཁོར་འདི་དག་གི་ཐ་ན་ལྷའི་ཞལ་ཕྱག་གི་ཁ་དོག་དང་།",
    "ཕྱག་མཚན་ཙམ་ཡང་རང་བཟོ་འབའ་ཞིག་གིས་བྱེད་པ་མ་གཏོགས།",
    "དཔྱོད་པ་དང་ལྡན་པ་དག་གིས་རྒྱང་རིང་དུ་དོར་བར་བྱའོ།",
    "དེ་ནི་ཕྱི་དང་ནང་གི་ཕྱག་རྒྱ་གསུངས་ཏེ།",
    "སྟོང་པ་ཉིད་ཀྱི་ཕྱག་རྒྱ་ཆེན་མོས་འབྲས་བུ་བདེ་བ་འདྲེན་པ་ལས་མི་འདའ་ལ།",
    "རྒྱུ་ཕྱག་རྒྱ་ཆེན་མོ་སྐྱེ་བ་ལས་མི་འདའ་བར་རྒྱས་འདེབས་པའི་དོན་ནོ།",
    "ཞེས་པས་སྟོང་གཟུགས་ཀྱི་ཕྱག་རྒྱ་ཆེན་མོ་དང་།",
    "དེ་ཕྱིར་བདག་གིས་བདག་ཉིད་ལ།",
    "སྟོང་གཟུགས་ཕྱག་རྒྱ་ཆེན་མོ་དུས་མཉམ་པ་ནི་བདག་ཉིད་གཅིག་ཡིན་པས་རྒྱུ་འབྲས་ཀྱི་རྒྱས་གདབ་མི་རུང་བར་བསྟན་པ་ཡིན་ནོ།",
    "དུས་ཀྱི་འཁོར་ལོའི་ཕྱིའི་ཕྱག་རྒྱ་དྲུག་གི་གྲངས་ཏེ།",
    "ནང་གི་ཕྱག་རྒྱའི་གྲངས་ཏེ།",
    "སྐུ་གསུང་ཐུགས་རྡོ་རྗེ་གསུམ་མོ།",
    "འཁོར་ལོ་སོ་དྲུག་གིས་ནི།",
    "མི་བསྐྱོད་པ་སོགས་རིགས་བདག་གིས་རྒྱས་འདེབས་པའི་ལྷ་རིགས་དྲུག་མཚོན་ནོ།",
    "ཁྱི་གདོང་མ་ལ་སོགས་པའི་གཏུམ་མོ་བརྒྱད་དེ།",
    "འདིར་ལྷའི་གྲངས་སུ་བགྲང་བ་ལ་ནི་ལྷའི་ངོ་བོ་ཡིན་པ་ཙམ་གྱིས་མི་ཆོག་གི།",
    "དཔག་བསམ་གྱི་ཤིང་གི་མཚན་མ་བཞི་དང་།",
    "རང་རང་གི་པདྨའི་ལྟེ་བ་ལ་གནས་པའི་ལྷ་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
    "ཁྲོ་བོ་གཙུག་ཏོར་ཡབ་ཡུམ་ཐུགས་ཀྱི་ནང་དུ་སྟེང་གི་ཆ་ལ་འགོད་པར་དངོས་སུ་སུ་གསུངས་ཤིང་།",
    "དེ་ཡང་ཞག་གཅིག་གི་ཉི་མའི་ཡེ་ཤེས་ཆ་འབྲིང་དུ་བརྩིས་པ་སུམ་ལ་ཅུ་སོ་གཉིས་ཀྱི་ཆས་དབུགས་ཀྱི་འཁོར་ལོ་ཉིས་ཁྲི་ཆིག་སྟོང་དྲུག་བརྒྱ་བགོས་པས།",
    "གསུང་གི་འཁོར་ལོའི་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
    "ཡང་ཉི་མའི་ཡེ་ཤེས་ཆ་ལོ་གསུམ་གྱི་ནང་ནས་ལོ་གཅིག་གི་ཞག་སུམ་བརྒྱ་དྲུག་ཅུ་ནི།",
    "དེ་ཡང་རྒྱུ་སྐར་གྱི་འཁོར་ལོ་ལས་ཉིན་མཚན་མཉམ་པའི་དུས་ཕྱེད་དང་བཅུ་གསུམ་གྱི་ཉིན་མོ་དང་།",
    "ཕྱེད་དང་བཅུ་གསུམ་གྱི་མཚན་མོ་བགྲོད་ཅིང་དེ་འདྲའི་རྒྱུ་སྐར་གྱི་འཁོར་ལོ་ཕྱེད་ཕྱེད་ཀྱང་།",
    "གང་གིས་རང་གི་ལུས་ལ་ཤེས་པར་འགྱུར་བ་སྟེ།",
    "དེ་ནི་རྩ་རྒྱུད་ཀྱི་ལྷ་གྲངས་ལས་བཏུས་པའི་བསྡུས་རྒྱུད་ཀྱི་ལྷ་གཙོ་ཆེ་བར་གྱུར་པ་དག་གི་གྲངས་ཡིན་ཏེ།",
    "༢༨ན་ད་ནི་ལྔ་པ་དེ་ལྟར་ཞག་དང་སྦྱར་བའི་ལྷ་དེ་དག་ནང་གི་རྩ་དང་སྦྱར་བ་སྟོན་པ་ནི།",
    "ད་ནི་འཁོར་ལོ་དག་གི་རྩ་རྣམས།",
    "སྟེང་འོག་གི་རྩ་ཆེན་དྲུག་རིགས་དྲུག་དང་།",
    "འཁོར་ལོ་དྲུག་གི་ནང་ནས་ལྟེ་བའི་ནང་སྐོར་གྱི་རྩ་དྲུག།",
    "ལྷ་དེ་སྙེད་ཀྱི་ངོ་བོར་མོས་པར་བྱ་སྟེ་བསྒོམས་པས་སྨིན་པར་བྱས་ནས།",
    "ལྷ་གྲངས་དང་ནང་གི་རྩ་སྦྱར་ནས་བསྟན་པ་དག་གི་དགོས་པ་ཡང་།",
    "རྩ་བའི་རྒྱུད་ལས་གསུངས་པའི་ལྷ་སྟོང་དྲུག་བརྒྱ་ཉི་ཤུའི་ནང་ནས་བསྡུས་པའི་བསྡུས་རྒྱུད་ཀྱི་ལྷ་སྐུ་གསུང་ཐུགས་ཀྱི་དཀྱིལ་འཁོར་གྱི་ལྷ་གྲངས་འདི་སྙེད་ཅིག་གི་ནང་ནས་པདྨའི་གདན་ཅན་གྱི་ལྷ་བརྒྱ་དང་ང་དྲུག།",
    "རིགས་དྲུག་གི་རྒྱས་འདེབས་ཀྱི་ལྷ་དྲུག་དང་བཅས་པ་བཏུས་ནས།",
    "དེ་དག་དང་ནང་གི་རྩ་བརྒྱ་དང་དྲུག་ཅུ་རྩ་གཉིས་སྦྱར་ནས་བསྟན་ལ།",
    "དེ་ཡང་དུས་ཀྱི་འཁོར་ལོའི་རྩ་ལྷ་དང་ལྷ་མོའི་རང་བཞིན་གྱིས་གནས་པ།",
    "སེམས་འཛིན་གྱི་སྟོབས་ལས་བྱུང་བའི་ཉམས་བན་བུན་རེ་ཙམ་མ་གཏོགས།",
    "དེའི་ཕྱིར་འདིར་ཡང་དུས་ཀྱི་འཁོར་ལོའི་རྩ་ལྷ་དང་ལྷ་མོའི་རང་བཞིན་ཅན་དུ་གནས་པ།",
    "༣བ་ནང་གི་ལུས་ཀྱི་རྩ་ཐམས་ཅད་ཀྱི་གཙོ་བོ་བརྒྱ་དྲུག་ཅུ་རྩ་གཉིས་སུ་བསྡུས་ནས།",
    "ནང་གི་རྩ་དེ་དག་ཕྱིའི་ལྷ་དཀྱིལ་འཁོར་ལ་བཀོད་པ་དེ་དག་གི་ངོ་བོར་མོས་ནས་བསྒོམས་པ་ཙམ་ངེས་པར་དགོས་སོ།",
    "བརྟེན་པ་ལྷ་ལྷག་མ་རྣམས་མི་འགོད་པར་བརྒྱ་ང་དྲུག་པོ་ཙམ་ཞིག་བཀོད་ནས་ཕྱག་རྒྱ་དང་བཅས་པ་ནང་གི་རྩའི་གཙོ་བོ་བརྒྱ་ལྔ་བཅུ་རྩ་དྲུག་གི་རང་བཞིན་དུ་མོས་ནས།",
    "གཞུང་འདི་དག་གིས་བསྟན་པ་ཡིན་ནོ།",
    "སྦྱོར་བ་ཡན་ལག་དྲུག་བསྒོམས་པས་རིགས་དྲུག་གི་རྩ་བསྲུང་བ་ཞེས་པ།",
    "རྫོགས་རིམ་གྱི་ཐུན་མོང་མ་ཡིན་པའི་སྨིན་བྱེད་དུ་འགྲོ་མི་འགྲོའི་སྒོ་ནས་དྲང་ངེས་སུ་གསུངས་པའོ།",
    "དེ་ཡང་མཉམ་པ་དྲུག་གི་དབུགས་ལྟེ་བའི་རྩ་འདབ་གཡས་མ་དྲུག་ལས་འོངས་པ་ནི་སྟེང་དུའང་སྣ་སྒོ་གཡས་ནས་རྒྱུ་ལ།",
    "བར་དུ་མཉམ་པ་རེ་གཡས་ལ་རྒྱུ་བས་བར་ཆོད་པ་དང་།",
    "དེ་བཞིན་དུ་མཉམ་པ་དྲུག་ཀྱང་མི་མཉམ་པ་རེ་རེ་གཡོན་ནས་རྒྱུ་བའི་བར་ཆོད་པའི་སྒོ་ནས་གཡས་ལ་རྒྱུའོ།",
    "སྐྱེ་བའི་ཚེ་ནའང་མ་དང་བུ་གང་གིའང་ནང་གི་དུས་སྦྱོར་གང་ལ་འདུག་བློ་ཁ་ཕྱོགས་པ་དང་།",
    "ལུག་གི་དུས་སྦྱོར་ལ་སྐྱེས་པ་ཞེས་གསུངས་པ་ནི།",
    "དེ་ནས་ཟླ་བ་གཉིས་པ་ཞག་སུམ་ཅུར་གཅིག་གིས་མ་ཚང་བའི་ཉེར་དགུ་ལ་ནི།",
    "དེ་ལྟར་འཆི་ལྟས་ཞག་རེ་ཐོག་མར་རྒྱུ་བ་དང་བཅས་པས་ཞག་སུམ་ཅུར་ལོངས་པའི་ཟླ་བ་གསུམ་དང་།",
    "ཞག་ཉེར་དགུ་རེ་ལས་མིད་པ་འཆི་ལྟས་མི་རྒྱུ་བའི་ཟླ་བ་གསུམ་སྟེ།",
    "དྲུག་གིས་རྩ་འདབ་དང་པོ་གཅོད་ཅིང་།",
    "དང་པོར་འཆི་ལྟས་ཞག་རེ།",
    "དེ་ནས་རང་བཞིན་པ་ཉེར་དགུར་རྒྱུ་བར་མཚུངས་པའི་ཟླ་བ་གསུམ་གསུམ་གྱིས་རྩ་འདབ་རེ་རེ་གཅོད་པར་ཁྱད་པར་མེད་ལ།",
    "རྩ་འདབ་བཅུ་གཅིག་པ་ཡན་ཆད་གཅོད་པ་ལ་རྩ་འདབ་རེ་ལ་འཆི་ལྟས་ཀྱི་ཞག་གསུམ་གསུམ་འཕེལ་བ་དེ་དག།",
    "འདབ་འདོར་བའི་ཞག་གི་རྒྱུ་ཚུལ།",
    "འཆི་ཞག་གི་ཞག་རྣམས་སྔ་མའི་སྟེང་དུ་ཕྱི་མ་བསྣོན་པ་ཡིན་མིན་དཔྱད་པ་དྲུག་གོ།",
    "གཉིས་པ་རྩ་འདབ་འདོར་བའི་ཞག་གི་རྒྱུ་ཚུལ་ནི།",
    "བདུན་པ་མན་ཆད་ལ་ནི་རྩ་འདབ་རེ་རེ་འདོར་བའི་ཞག་གྲངས་ལ།",
    "རྩ་འདབ་གསུམ་པའི་འཆི་ཞག་ཚེ་ལྷག་ལ་མི་གཏོགས་པར་ཐལ་བ་དང་།",
