    "ཞེས་པ་འདི་རྐང་པ་བཞི་པར་སླར་ཡང་འདི་ཁོ་ན་བཀོད་པས་ཡི་གེ་དུ་མ་ཚོགས་པའི་རྐང་པ་དེ་དག་རྐང་པ་གཞན་གྱིས་བར་ཆོད་པར་བྱུང་བས་ཟུང་ལྡན་གྱི་བྱེ་བྲག་ཏུ་ཡང་གྱུར་པའོ།",
    "སྤྲིན་གྱི་བགྲོད་པ་དང་ལྡན་པ་དབྱར་གྱི་དུས་སྐྱེས་པའམ་བྱུང་བའི་ཚེ་ན་རྨ་བྱའི་ཚོགས་རྣམས་ནི་དགའ་བའི་སྒྲ་ཡིས་མཛེས་པ་ཐོབ་པར་འགྱུར་ལ།",
    "གཞན་གཉིས་ཅི་བདེར་བྱས་པ་དང་པོ་གཉིས་པར་བཟླས་པའི་ཟུང་ལྡན་ཡིན་ལ།",
    "དེ་ནི་བོད་སྐད་ལ་ཚིག་རྐང་དང་པོ་དེ་ཉིད་གཉིས་པར་སླར་བཀོད་ཀྱང་དོན་ཐ་དད་པར་གྱུར་པ་ཞིག་བརྩམ་ན་དེས་འཐུས་པས་སྐབས་འདིར་རྒྱ་སྐད་མ་བཀོད་ལ།",
    "རྒྱ་སྐད་དུ་རྐང་པ་དང་པོ་གཉིས་པར་བཟླས་པའི་ཚིགས་བཅད་ཀྱི་དོན་བོད་སྐད་དུ་བསྒྱུར་བའི་དོན་ནི།",
    "ཚིག་རྐང་དང་པོ་སཱ་བྷ་སུ་རཱ་ཎ་སོགས་ཡི་གེ་བཅུ་གཉིས་པོ་སླར་ཡང་རྐང་པ་གསུམ་པར་བཟླས་པའི་ཚིགས་བཅད་ཀྱི་དོན་ནི།",
    "རྐང་པ་དང་པོ་བཞི་པར་བཟླས་པའི་རྒྱ་སྐད་ཚིགས་བཅད་ཀྱི་དོན།",
    "སྙན་པར་སྨྲ་དང་ལུས་སྐེད་དུད་པ་ལྟར་བདོ་པ་དང་།",
    "རྐང་པ་གཉིས་པ་གསུམ་པར་བཟླས་པའི་ཚིགས་བཅད་དེ་བོད་སྐད་དུ།",
    "དགྲ་རིགས་ལུས་བྲལ་གཟི་མེད་རྒྱགས་པ་ཉམས་པར་བྱེད།",
    "གཉིས་པ་བཞི་པར་བཟླས་པའི་ཟུང་ལྡན་གྱི་ཚིགས་བཅད་བོད་སྐད་དུ།",
    "བདག་ཉིད་ལ་ཕན་པའི་ཚིག་གཅིག་གསན་པར་མཛོད་ཅེས་སམ།",
    "རང་ལག་རིག་ནས་རྒྱགས་པ་རྒྱས་པར་ཡོངས་མ་མཛད།",
    "རྐང་པ་གསུམ་པ་བཞི་པར་བཟླས་པ་ཡི་རྒྱ་སྐད་ཚིགས་བཅད་བོད་སྐད་དུ།",
    "རྐང་པ་དང་པོ་དེ་ཉིད་གཉིས་པ་དང་གསུམ་པར་བཟླས་པས།",
    "ངེས་པ་ཉིད་དུ་ཆད་པར་མ་གྱུར་ཏོ།",
    "དེ་བཞིན་རྐང་པ་དང་པོ་གསུམ་པ་བཞི་པ་རྣམས་ཁྱད་མེད་པར་ཚིག་རྐང་གཅིག་ཡང་ཡང་བཟླས་ནས་གཉིས་པར་ཚིག་གཞན་བཀོད་པ་དེ་འདྲའི་ཟུང་ལྡན་དེ་བོད་སྐད་དུ།",
    "ལོག་པར་གྱུར་པ་སྒྲུབ་བྱེད་མི་མཉམ་པ།",
    "མི་བདེན་པ་བསླུ་བ་དག་སྒྲུབ་པར་བྱེད་པས་ཁ་ཞེ་མི་མཉམ་པ་གཡོ་སྒྱུ་ཅན།",
    "ཚིགས་བཅད་དེ་ཡི་རྐང་པ་བཞི་ཀ་ཚིག་འདྲ་ཡང་དོན་སོ་སོར་གྱུར་པ་བོད་སྐད་དུ་བྱས་ན།",
    "མེད་མིན་རྗེ་དང་བཅས་པར་གོ་བགོས་པ།",
    "ཡང་གཉིས་པར་བཟླས་པའི་དོན་སྔ་མ་ལས།",
    "རྐང་པ་བཞི་ཀ་རྣམ་པར་གཅིག་པ་གང་ཡིན་པ་ཟུང་ལྡན་ཆེན་པོར་བརྗོད་པ་ཡིན་ཏེ་སྔར་བསྟན་པ་བཞིན་ནོ།",
    "ཁེངས་པ་དེ་དོར་བའི་ཚད་དེས་ལེགས་པར་འགྲོགས་སུ་ཆུག་ཅིག་ཅེས་ཆགས་བཞིན་དུ་ཁེངས་པ་མི་རིགས་པས་ཚུལ་མིན་ཡིན་ནོ་ཞེས་བརྗོད་པ་སྐད་དུའོ།",
    "འཛིན་མ་ས་གཞི་ལ་སྤྱོད་པ་ས་སྐྱོང་རྣམས་ཀྱི་ལག་པ་ཕ་རོལ་རྣམ་པར་གནོན་པ་མི་དམན་ཞིང་།",
    "གཟུགས་མཚུངས་པའི་ཡི་གེ་དུ་མ་ཡོད་པས་ཟུང་ལྡན་ཡིན་པ་གང་ཞིག་ཟུང་ལྡན་ལུགས་ལས་བཟློག་པ་ཞེས་པར་བཤད།",
    "རྐང་པ་དང་པོ་གཉིས་པར་བཟློག་ཅིང་།",
    "གསུམ་པ་དང་བཞི་པར་བཟློག་པ་དང་།",
    "དང་པོ་བཞི་པར་དང་གཉིས་པ་གསུམ་པར་བཟློག་པའི་དཔེ་བརྗོད་གཉིས་ལས།",
    "ཡང་ན་དེ་ལ་བདེན་པ་མེད་པ་ཞེས་པའི་མིང་འཇུག་པར་རྒྱ་འགྲེལ་ལས་བཤད།",
    "གཉིས་པ་ན་མེ་ཀ་སོགས་ལུགས་ལས་བཟློག་པས་གསུམ་པ་བྱས་པ།",
    "དེའི་འབྲས་བུ་གདུང་བ་མེད་པར་བསྟན་པའོ།",
    "དཔེའུ་རིས་འདིས་ཤེས་པར་བྱའོ།",
    "འདི་ཡང་དཔེའུ་རིས་ལས་རྟོགས་པར་བྱ་སྟེ།",
    "ཟུར་གྱི་གྲར་འགྲིག་ཅིག་འོང་ཡང་ཞར་བྱུང་དུ་ཐོན་པ་ལས་ཆེད་བྱས་མིན་ལ།",
    "དེར་ཡང་ཉམས་པ་མེད་པར་གོང་ནས་གོང་དུ་འཕེལ་བའི་ཚུལ་དུ་གསལ་བ་རབ་ལ་སོན་པ་ཉིད་དུ་རྒྱས་པར་འགྱུར་རོ།",
    "དེ་ཡང་བཞི་དང་གསུམ་ལ་སོགས་པར་ངེས་པར་རབ་ཏུ་བསྟན་པ་འདི་ཉིད་བྱ་དཀར་བརྗོད་ཀྱི།",
    "བཞི་པ་ཨེ་ཁོ་ནར་བྱས་པ་ཡོད་པ།",
    "བཞི་པ་དེ་གསུམ་འདྲེས་པར་བྱས་པའི་ཚིགས་བཅད་དེའི་དོན།",
    "ས་ལས་རྣམ་པར་རྒྱལ་བའི་བརྟན་པ་སྒྲུབ་པར་བྱེད་པའི་བརྟུལ་ཞུགས་ལ་དགའ་ཞིང་།",
    "ལྕི་བར་ཞེས་ཤུགས་ཆེ་བར་འདར་བར་བྱས་སོ་ཞེས།",
    "ཀུ་ཞེས་པ་ཀ་ཁ་ག་གྷ་ང་མཚོན་པ་ལྟར་གཞན་མ་བཞི་ལའང་ཤེས་པར་བྱའོ།",
    "གཞན་བཞི་པོ་ཅི་རིགས་སུ་འདྲེས་པར་བྱས་པ་དེ་བོད་སྐད་དུ་བསྒྱུར་བ།",
    "དེ་རྣམས་བཅོམ་པ་ན་དེའི་གྲགས་པའི་སྒྲ་ཡིས་མཐོ་རིས་འཁྲུགས་པར་གྱུར།",
    "ཅེས་པ་ལྷ་གནས་སོ་སོར་གསང་མཐོར་སྨྲ་བས་སྒྲ་གསང་འཐབ་སྟེ་འཁྲུགས་པར་གྱུར་ཅེས་སོ།",
    "ཞེས་པ་སྒྱུ་རྩལ་སོགས་ཀྱི་རིག་པར་མཁས་པ།",
    "ལྷ་དང་ལྷ་མིན་ལ་ཁྱབ་པར་འགྲོ་བའི་སྟོབས་དང་ལྡན་པའི་བྱིན་པ་མཛེས་ཤིང་ལེགས་པ་ཅན།",
    "བཞིན་གྱིས་ངེས་པར་མ་བཅོམ་མིན།",
    "འདི་ཡིས་བཞིན་གྱིས་ངེས་པར་ནི་མ་བཅོམ་མིན་ཏེ་བཅོམ་པས་འདིའི་བཞིན་ལ་བལྟ་དཀའ་ཞིང་།",
    "དེ་བཞིན་རོ་སྔ་ཕྱིའི་སྒྲ་ལའང་ཤེས་པར་བྱ་ཞིང་།",
    "ར་རོ་བ་རྒྱུ་དེས་མྱོས་པའམ་རྨོངས་པར་བྱས་པའི་དོན་དང་།",
    "ར་རི་ནི་ནག་པོ་ར་རི་ཟེར་བ་ལྟར་དྲི་མའམ་སྐྱོན་དུ་དོན་གྱིས་གོ་བར་བྱས་ནས་འདི་སྐད་དུ།",
