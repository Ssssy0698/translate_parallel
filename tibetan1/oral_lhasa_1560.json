    "དེ་ནས་ཕྱིར་མཆོངས་གཅིག་བྱས་པས་ལངྐ་པཱུ་རིར་སོན་ཏེ་བལྟས་པས།",
    "དེ་ཉིད་ཀྱང་མིད་པར་བྱེད་ནུས་པ་དང་།",
    "དེ་ནས་རྒྱ་མཚོ་ལ་སྤྲེལ་དམག་སྦྲེལ་ནས་ཟམ་བྱས་པར་བརྟེན་ནས་དགའ་བྱེད་སྲིན་ཡུལ་དུ་བརྟོལ།",
    "དེ་ནས་རཱ་མ་ཎས་སྲིན་རྒྱལ་གསོད་པར་བརྩམ་པ་ན།",
    "སྲིན་པོ་རཱ་མ་ཎའི་བུ་བི་བྷིཥ་ཞེས་པ་དེའི་ཚུལ་དུ་ད་ལྟ་སློབ་དཔོན་ཆེན་པོ་པདྨ་འབྱུང་གནས་སྲིན་པོའི་རྒྱལ་པོར་མཛད་དེ་སྲིན་པོའི་ཁ་གནོན་དུ་བཞུགས་པར་གྲགས།",
    "ཕའི་ལུགས་སུ་གསོད་པར་གྲོས་མཐུན་པར་གྱུར།",
    "གཞུང་དུ་དཔེ་ཞེས་དངོས་སུ་གསུངས་ཀྱང་དཔེ་རང་ལ་འཛིན་ན་བསྙོན་དོར་གྱི་གཟུགས་ཅན་ཡང་སྔར་བསྟན་པར་གསུངས་རིགས་ཀྱང་མ་གསུངས་པ་དང་།",
    "དེ་བཞིན་དུ་སྔ་ཕྱིའི་སྦྱོར་ཚུལ་ཤེས་པར་བྱས་ལ།",
    "མྲྀ་དུ་ཀ་རས་འཇིག་རྟེན་གྱི་ཡིད་ནི་རབ་ཏུ་འཕྲོག་པར་བྱེད།",
    "ན་ཀྵ་ཏྲ་པ་ཐ་པརྟྟི་ནཱ།",
    "དགའ་བ་མེད་པར་ཅིས་མ་མནར།",
    "ཆུ་ཤེལ་གནས་བཟང་རྣམ་པར་བཀྲ་བ་ན།",
    "དགའ་བའི་སིམ་པ་ལའང་སྒྲ་ཕྱོགས་མཚུངས་པར་འཇུག་སྟེ་སེམས་ཚིམ་པའི་ལུས་ཉམས་ཀྱི་བྱེ་བྲག་ཡིན་པས་སོ།",
    "གར་ཆང་མཁུར་བཀང་བྱས་འདྲར་བདེ་བཞིན་ཟིམ།",
    "ཆུ་ཤེལ་གནས་བཟང་བཀྲ་བ་ནི་ཟླ་བའི་གདན་ལ་བཞུགས་པ།",
    "ཀླུ་ནོར་རྒྱས་ཀྱིས་བསྲུབ་ཐག་བྱས།",
    "འོག་ནས་རུ་སྦལ་གྱི་རྒྱབ་ཀྱིས་བརྟེན་ཏེ་བདུད་རྩིའི་དོན་དུ་འོ་མ་ཅན་གྱི་རྒྱ་མཚོ་བསྲུབས་པར་བྱས་སོ།",
    "ཤིང་ཡོངས་འདུ་སོགས་ལྷ་རྫས་དུ་མ་བྱུང་བ་བརྒྱ་བྱིན་སོགས་ལྷ་རྣམས་ཀྱིས་ཅི་རིགས་པར་ཁྱེར།",
    "ཨ་སུ་ར་ལྷ་མིན་ཞེས་པའི་མིང་དུ་གྲགས་པར་གྱུར་ཏོ།",
    "དེ་ནས་བདུད་རྩི་བྱུང་བ་དེ་ཉིད་བླངས་པས་སྣོད་ཆེན་པོ་བརྒྱད་གང་བ་ལྷ་མིན་རྣམས་ཀྱིས་ཁྱེར་བས་ལྷ་རྣམས་ཡི་མུག་པར་གྱུར་ཚེ།",
    "བརྒྱ་བྱིན་ཡང་མི་སྣང་བའི་གཟུགས་ཀྱིས་ནམ་མཁའ་ལ་འཇུག་པར་བྱས་སོ།",
    "ཁྲུས་མ་བྱས་པར་ཟས་མི་བཟའ།",
    "དེ་རྣམས་ཁྲུས་བྱས་ནས་སླར་བདུད་རྩི་ལོངས་སྤྱད་དུ་འོངས་པ་ན་བདུད་རྩི་མ་མཐོང་བ་ཚོལ་བར་བརྩོན་པ་དང་།",
    "ལྷ་མ་ཡིན་རྣམས་མ་ཡིན་པས་བདེན་ནོ་སྙམ་ནས་བསྡད་དོ།",
    "བདུད་རྩིས་མགྲིན་པ་ཡན་ཆད་ཁྱབ་པས་མགོ་བོ་དེང་སང་ཡང་མ་ཤི་བར་ཉི་ཟླ་ལ་སྒྲིབ་པར་བྱེད་ཅེས་རིག་བྱེད་ཀྱི་གཏམ་ལས་གྲགས་སོ།",
    "ལྷ་རྣམས་འདུ་བའི་གནས་བཟང་པོ་ཤིང་ཡོངས་འདུ་ལ་སོགས་པ་རྒྱ་མཚོ་བསྲུབས་པ་ལས་འཇིག་རྟེན་འདིར་རྣམ་པར་བཀྲ་བ་སྟེ་སྣང་བར་གྱུར་པ་ནའོ།",
    "སུས་འཐུང་ན་ཆུའི་བཅུད་ཆང་ཞེས་པ་དེ་ལྷ་རྣམས་ཀྱིས་འཐུང་བས་མྱོས་བཞིན་དུ་བདེ་བར་ཚིམ་སྟེ་མིག་ཟིམ་བུར་བྱས་ནས་དགའོ་ཞེས་སོ།",
    "འདྲེས་པའི་ཚལ་སོགས་བཀོད་པ་རྣམ་པར་བཀྲ་བ་ན།",
    "ཚལ་དང་རི་ཏི་སེ་ལ་སོགས་པ་བཀོད་པ་རྣམ་པར་བཀྲ་བ་གང་ན།",
    "དེ་ཡི་རྗེས་སུ་མཐུན་པར་བྱེད་པ་ནི་རྡུལ་འཛག་པ་ཕན་ཆད་ནས་སྐྱེ་གནས་ལ་བདེ་བ་བསྐྱེད་པ་དོན་དུ་གཉེར་བས་སོ།",
    "དེ་ལུས་ལ་ཁུ་བའི་ཁམས་ཏེ་སྐྱེས་བུ་ལོ་བཅུ་དྲུག་ལོན་ནས་ཁུ་བ་འཛག་པའི་བདེ་བ་མྱོང་བས་ན་ཟླ་བ་ཆ་རྫོགས་པའམ་རྣམ་པར་བཀྲ་བ་ན།",
    "དཔེར་བྱས་ན་རྒྱ་མཚོ་ལྟར་མི་གཡོ་བ་དང་།",
    "དུས་མཚོན་པར་བྱས་ན་ཟླ་བ་རྣམ་པར་བཀྲ་བའམ་གསལ་བ་དུས་བཞིའི་ནང་ནས་སྟོན་ཀ་དང་།",
    "སྐབས་འདིར་གོང་བསྟན་རྣམས་ལས་གཞན་པ་འགའ་ཞིག་བསྟན་པར་བྱའོ།",
    "དཀར་མིན་གནག་པའི་མིག་ཅན་མཛེས་མ་དག་ལ་འཁྱུད་པར་བྱེད་དོ།",
    "འདོད་པ་ལས་ཆགས་པའི་མདངས་གདོང་དམར་པོར་གྱུར་པ་སྟོན་པར་བྱེད་ཅིང་།",
    "ཚ་ཟེར་ཅན་ནི་རི་ལས་ནུབ་པར་གྱུར་ཏེ།",
    "ལུས་སྐྱེས་འདོད་པ་དག་ནི་རྣམ་པར་རྒྱས་སོ་ཞེས་རྒྱས་པ་དང་།",
    "འདིར་རྒྱལ་པོ་དང་རལ་གྲི་གཉིས་ལས་རལ་གྲི་ཉིད་ལ་ནིསྟྲིཾ་ཤ་ཡི་སྒྲ་དོན་ཡོད་པར་ངེས་ཀྱི།",
    "མདའ་རྣམས་ཉིད་ལ་ངེས་པར་གནས་པ་ཡིན།",
    "རྒྱལ་པོ་དང་རལ་གྲི་སོགས་མ་སྦྱར་ན་སྒྲ་དེ་རྣམས་ཅིག་ཤོས་དེ་ལ་ངེས་པར་བཟུང་བའང་མེད་དེ་སྐྱེ་བོ་གཏུམ་པ་དང་རལ་གྲི་གཉིས་ལ་ནིསྟྲིཾ་ཤའི་སྒྲ་སོ་སོར་འཇུག་པ་ལ་སོགས་པ་བཞིན་ནོ།",
    "ཞེས་ངེས་བཟུང་བྱས་ནས་འོན་ཀྱང་དེ་ཁོ་ནར་ཡང་མ་ངེས་ཏེ།",
    "ཆགས་ཅན་གང་ཞིག་འཁྲིག་པ་ལ་ཞུགས་ནས་ཕན་ཚུན་འཁྱུད་པར་གྱུར་པ་རྣམས་ཀྱི་ལུས་ལའང་མཐོང་ངོ་ཞེས་བ་སྤུ་ལངས་པ་ལ་བསམ་པའོ།",
    "ཕྱི་མས་སླར་ཡང་ས་གཞི་ལ་ཚེར་མ་མེད་པར་བསྒྲུབ་པའོ།",
    "སྐྱེ་བོ་ངན་པ་མེད་པར་བྱས་པ་ལ་ཚེར་མ་དཀྲུགས་པ་ཞེས་བརྗོད་པ་བཞིན་ནོ།",
    "དེས་ན་རྒྱལ་པོའི་ཡུལ་གྱི་ས་གཞིར་ཚེར་མ་དངོས་དང་སྐྱེ་བོ་ངན་པ་གཉིས་ཀ་མ་དམིགས་པས་ཀཎྚའི་སྒྲ་པདྨའི་ཡུ་བ་ངེས་པར་བྱས་ནས།",
    "ཉི་མ་ངེས་པར་འཆར་བ་དང་།",
    "རྒྱལ་པོ་མངའ་ཐང་ངེས་པར་དར་བའོ།",
    "ཡང་ན་ཉི་མ་ནི་གཟི་བརྗིད་ངེས་པར་དར་བའམ་བདོ་བ་དང་།",
    "མྱུར་བར་བསྒྱུར་ན་ཕྱོགས་སུ་ལྷུང་ནས་སྒྲ་སྦྱར་ཞིག་པར་འགྱུར་ལ།",
    "རྒྱལ་པོ་བློ་མྱུར་བའམ་བྱ་བ་སྐྱེན་པར་བསྒྲུབ་པའི་མྱུར་བར་བྱས་ན་བོད་སྐད་དུའང་སྦྱར་བའི་ཚུལ་མི་འཇིག་གོ།",
    "ནུས་པ་འབའ་ཞིག་ལ་བསྒྱུར་ན་སྒྲ་སྦྱར་བ་ཞིག་པར་འགྱུར་ལ།",
    "ནུས་པར་བསྒྱུར་ན།",
    "ཁྱབ་འཇུག་གླང་གཅོད་མིན་པར་འགལ་ཏེ།",
    "ལྷ་ཡང་རྣམ་སད་མིན་པར་ཤེས།",
    "མི་འགལ་བའི་སྦྱར་བར་གྱུར་ན་འདི་ནི་འགལ་བའི་སྦྱར་བ་ཞེས་གསུངས་པའི་ཕྱིར་གང་རུང་དང་འགལ་བས་ཆོག་པ་འདྲ་སྙམ་པའོ།",
    "ཉེར་ལྔ་པ་ཁྱད་པར་བརྗོད་པའི་རྒྱན་ལ།",
    "དང་པོ་ཡོན་ཏན་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པའི་རྒྱན་ནི།",
    "རིགས་མ་ཚང་པའི་ཁྱད་པར་བརྗོད་པ།",
    "བྱ་བ་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པའི་དཔེ་བརྗོད་ནི།",
    "མིག་ཀྱང་སྡང་མིག་དམར་པོར་མ་གྱུར་པར།",
    "དགྲ་ཡི་རིགས་ནི་མཐའ་དག་ཉམས་པར་བྱས་ཏེ་བྲན་དུ་བཀོལ་ཞེས་ཁྲོས་པའི་རྣམ་འགྱུར་གྱི་བྱ་བ་དེ་དག་མེད་པར་དགྲ་འཇོམས་པའོ།",
    "རྫས་མ་ཚང་བའི་ཁྱད་པར་བརྗོད་པ་ནི།",
    "རྟ་མེད་ལ་རྐང་ཐང་མེད་པར་ཡང་།",
    "ལྷ་ཀླུ་མིའི་འགྲོ་བ་གསུམ་པོ་དག་ལས་རྒྱལ་པར་གྱུར་ཏོ།",
    "ཤིང་རྟ་འདྲེན་པའི་རྟ་བདུན་ཡོད་པས་གྲངས་མི་མཉམ་པར་གྱུར་པ་ནི་རྒྱུ་ཡི་ཡན་ལག་མ་ཚང་བ་དེ་ལྟར་ན་ཡང་གཟི་བྱིན་ཆེན་པོ་ཅན་གྱི་ཉི་མས་ལྷ་ཀླུ་མིའི་འགྲོ་བ་གསུམ་པོ་ཟིལ་གྱིས་མནན་པར་གྱུར་ཏོ།",
    "གཞན་ཟིལ་གྱིས་གནོན་བྱེད་ཀྱི་རྒྱུ་དེ་ཡི་འབྱོར་པའི་ཁྱད་པར་འགའ་མ་ཚང་བ་ལྟར་སྣང་ཡང་།",
    "གཟི་བྱིན་ཅན་དང་སོགས་སྒྲས་ཚ་ཟེར་ལྡན་པ་སོགས་ཡོན་ཏན་གྱི་ཁྱད་པར་ལས་རྒྱུ་ཡི་བྱེད་པ་ཕུན་སུམ་ཚོགས་པར་གྱུར་པ་འདི་ནི་རྒྱུ་ཡི་ཁྱད་པར་བརྗོད་པ་ཡིན་ནོ།",
    "བདུད་རྣམས་བྱེ་བས་བསད་པར་མི་ནུས་ཏེ།",
    "དེ་ནི་ངེས་པར་སྐྱེ་བའི་ཕ་རོལ་འགྲོ།",
    "ཞེས་གསུངས་པ་ཡང་ཚུལ་འདི་དང་མཚུངས་སོ།",
    "ཉེར་དྲུག་པ་མཚུངས་པར་སྦྱོར་བའི་རྒྱན་ལ།",
    "དཔེར་མ་བྱས་པར་དོན་གཅིག་ཏུ་མཚུངས་པར་བྱས་ནས་འགའ་ཞིག་ནི་བསྟོད་པའམ།",
    "དེས་ན་སྐྱེས་བུ་ངན་པ་དང་མི་གཙང་བའི་འདམ་རྫབ་དང་།",
    "རུལ་བའི་རོ་རྣམས་མི་སྡུག་ཅིང་སྐྱུག་བྲོ་བར་མཚུངས་པར་བརྗོད་ནའང་།",
    "སྐྱུག་བྲོ་བའི་རྣམ་པ་ཁྱད་འཕགས་མི་གཙང་བའི་འདམ་རྫབ་སོགས་དང་མཚུངས་པར་བརྗོད་པ་ཡིན་པས།",
    "མཚུངས་པར་བྱས་ནས་བསྟོད་པའམ།",
    "དེ་ནི་མཚུངས་པར་སྦྱོར་བར་བཤད།",
    "ཅེས་གཞན་པ་ཡོན་ཏན་ཁྱད་འཕགས་ཅན་དང་མཚུངས་པར་བྱས་ནས་དེ་རྣམས་ལ་མཉམ་དུ་བསྟོད་པའམ།",
    "གནས་སྐབས་གང་དུ་བརྗོད་འདོད་ཀྱི་དོན་འགའ་ཞིག་ནི་སྨད་པར་བྱ་བའི་སྐྱོན་ཅན་དང་མཚུངས་པར་བྱས་ཏེ་སྨད་པའི་དོན་དུ་བསྒྲགས་པ་གང་ཞེས་པའི་དོན་དུ་གོ་བར་བྱས་ཀྱང་རུང་ངོ།",
    "གཉིས་པ་ལ་དབྱེ་བ་གཉིས་གསུངས་པ་ལས།",
    "ཞེས་བརྒྱ་བྱིན་སོགས་དང་རྒྱལ་པོ་ལྷན་ཅིག་འཇིག་རྟེན་སྐྱོང་བ་ཡིན་པར་བསྟོད་པའོ།",
    "རང་བཞིན་གྱིས་སྐད་ཅིག་གཉིས་པར་མི་གནས་ཏེ་དེ་དག་སྐད་ཅིག་སྔ་ཕྱི་རིམ་བྱུང་ཡིན་པས་སོ།",
    "དངོས་པོ་གང་ལ་འགལ་བའི་ཟླ་བོ་ཡང་དེ་ཉིད་དུ་ཡོད་པ་གོ་བར་བྱེད་པའམ་སྒྲུབ་པར་བྱེད་པའི་སླད་དུ་ནི།",
    "སྤྲིན་དེས་ཆགས་པ་བསྐྱེད་པ་དག་ཏུ་བྱེད་པ་ཡིས་ཀྱང་འགྲོ་བ་རྣམས་ཀྱི་ཡིད་ནི་ཀུན་ཏུ་ཆགས་པར་གྱུར་ཏོ།",
    "ཡུལ་ཅན་འགྲོ་བའི་ཡིད་སྡུག་པ་ལ་ཆགས་པའི་ཆགས་ལྡན་དུ་བྱས་པའི་ཡོན་ཏན་འགལ་བས་སོ།",
    "མཆི་མ་ཟག་པར་བྱེད་པ་འགལ་ལོ།",
    "མིག་སྤྲིན་དཀར་པོ་དེའི་རྗེས་སུ་དམར་བ་ཡང་འདི་ལྟར་དཀྱུས་རིང་བའི་མཐའ་རྣ་བ་དག་ལ་བརྟེན་པ་འདི་ནི་འདི་ལ་བརྟེན་ནས་གང་ཟག་སུ་ཡི་ཡིད་བརྟན་པ་ཉིད་དུ་འགྱུར་ཏེ་མི་འགྱུར་རོ་ཞེས་འདི་མཐོང་བས་ཆགས་པས་ཡིད་མི་བརྟན་པར་གཡོའོ།",
    "འབད་པ་ཆེན་པོ་མེད་པས་རྙེད་པར་སླ་བའི་ནོར།",
    "གལ་ཏེ་རྣམ་པ་སྨད་པ་བཞིན་དུ་ཡང་དོན་ལ་བསྟོད་པ་བྱས་ནས།",
    "ཞེས་པ་དྲང་སྲོང་བྷྲི་གུ་སྟེ་ངན་སྤོང་ཤེས་པའི་རིགས་ལས་བྱུང་བ་རཱ་མ་ཞེས་པ་དེས་གཞན་གྱིས་སྤྱོད་པར་དཀའ་བའི་དཀའ་ཐུབ་དྲག་པོ་ཡུན་རིང་བྱས་པའི་མཐུས་ཚེ་དེ་ཉིད་ལ་ས་ཆེན་པོ་འདི་ལས་རྣམ་པར་རྒྱལ་བའི་གཏམ་རྒྱུད་རྒྱ་ཆེར་ཡོད་པ་དང་སྦྱར་བ་རཱ་མ་ཎ་སྔ་མ་དགྲ་སྟྭ་རཱ་མ་དང་།",
    "ཚེ་སྔོན་གྱི་དཀའ་ཐུབ་སོགས་ཀྱི་མཐུས་ས་མཐའ་དག་ལས་རྣམ་པར་རྒྱལ་བ་ཐོབ་པ་ཡིན་པས།",
    "དེ་ལྟར་རཱ་མ་སྔ་ཕྱི་གཉིས་པོ་མིང་མཐུན་པས་བསྡུས་ནས་རཱ་མ་ཎའི་མིང་ཅན་དེས་ཀྱང་ནགས་སུ་རྒྱུ་བའི་དཀའ་ཐུབ་ལྷུར་བླངས་ནས་དཔུང་གཞན་མེད་པར་ཡང་འབྱུང་པོ་འཛིན་མ་ས་ཆེན་པོ་འདི་ལས་རྒྱལ་བར་གྱུར་ན།",
    "ཞེས་ང་རྒྱལ་བྱ་རིན་མི་ཆོག་པ་སྐད་དུ་སྨད་པ་ལྟར་བྱས་བའི་ཟོལ་གྱིས་ར་མ་གཉིས་བཞིན་ས་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བའི་མཐུ་ཕུན་སུམ་ཚོགས་པའི་ཡོན་ཏན་རྒྱ་ཆེ་བའི་བསྟོད་པ་བྱས་པའོ།",
    "འདོད་ཆགས་ཀྱི་ཆགས་པར་གོ་བར་མི་བྱའོ།",
    "བརྗོད་ཚུལ་གྱི་སྒོ་ནས་ཀྱང་དབྱེ་བ་བྱས་ན་རབ་ཏུ་རྒྱ་ཆེ་མཐའ་དང་བྲལ་བ་ཡོད་དོ།",
    "སུམ་ཅུ་པ་ངེས་པར་བསྟན་པའི་རྒྱན་ལ།",
