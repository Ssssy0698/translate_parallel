    "ཉི་ཟླ་བསྟེན་པས་མུན་པ་འགོག་པར་བྱེད།",
    "དེ་བཞིན་སྔར་བསྟན་གབ་ཚིག་བཅོ་ལྔ་པོ་དེ་རྣམས་གཉིས་སམ་གསུམ་ལ་སོགས་པ་ཅི་རིགས་པ་ཡོངས་སུ་འདྲེས་པའི་རིམ་པ་ཤེས་པར་བྱའོ།",
    "ཞིབ་ཏུ་བརྟགས་ན་སོ་སོའི་མཚན་ཉིད་མ་འདྲེས་པར་ཤེས་ཤིང་།",
    "བརྡ་སྤྲོད་པའི་གཞུང་ལྟར་མ་བྱས་པས་ཡི་གེ་སྔ་ཕྱི་མཚམས་སྦྱོར་ཚུལ་བཞིན་བྱེད་པ་དང་བྲལ་བ་སྟེ་དེ་ལྟར་དགུ་དང་།",
    "གཏན་ཚིགས་ཀྱི་རིགས་པ་དག་དང་འགལ་བ་སྟེ་རྣམ་པ་དྲུག་པོ་གཅིག་ཏུ་བྱས་ནས་འགལ་པའི་སྐྱོན་ཞེས་བྱའོ།",
    "རྣམ་པ་འགལ་བ་ལྟ་བུའི་བརྗོད་ཚུལ་ཕལ་ཆེར་ལ་དམ་བཅའ་སྒྲུབ་བྱེད་དཔེ་སོགས་འགལ་པའི་རྣམ་གཞག་དཔྱད་པར་དཀའ་བ་ཉིད་སྦྱར་བ་དེ་ཡི་འབྲས་བུའམ་དགོས་པ་ཅི་ཞིག་ཡོད་དེ།",
    "གལ་ཏེ་དེ་ཡི་ཚུལ་ཤེས་པར་འདོད་ན་རྟོག་གེའི་བསྟན་བཅོས་སོགས་ལས་རྟོགས་པར་བྱའོ།",
    "དང་པོ་དོན་ཉམས་པ་ནི་རྗོད་བྱེད་ཀྱི་ཚིག་ཕན་ཚུན་ཚོགས་པའམ་འབྲེལ་བའི་དོན་གྱིས་སྟོང་པ་གང་ཡིན་པའི་ངག་འབྲེལ་མེད་དེ་ནི་དོན་ཉམས་པ་ཞེས་པར་འདོད་དེ།",
    "སྤྲིན་འདི་འབྲུག་སྒྲ་རབ་ཏུ་སྒྲོག་པར་བྱེད་དེ།",
    "སྔ་མ་ཡི་དོན་ཕྱི་མ་གཞན་གྱིས་འཇོམས་པ་ནི་རང་ཚིག་སྔ་ཕྱི་འགལ་བའི་དོན་ཅན་ཉིད་ཀྱི་སྐྱོན་ལ་དོན་འགལ་ཞེས་པར་རབ་ཏུ་བརྗོད་དེ།",
    "བརྗོད་བྱའི་དོན་ཉིད་དམ་ནི་རྗོད་བྱེད་ཀྱི་སྒྲ་ལ་ཡང་དོན་དང་དགོས་པ་ལྷག་པོར་སྟོན་པའི་ཁྱད་པར་ཅི་ཡང་མེད་པས་ན་ཡང་སྔར་བརྗོད་པ་གལ་ཏེ་སླར་ཡང་རབ་བསྒྲགས་པ་དེ་ནི་དོན་གཅིག་ཡང་ཡང་ཟློས་པར་འདོད་དེ།",
    "དམིགས་བསལ་རྗེས་སུ་བརྩེ་བ་དང་ཁྲོས་པ་དང་ངོ་མཚར་པ་དགའ་བ་སོགས་ཁྱད་པར་འཕགས་པ་ལས།",
    "གལ་ཏེ་དོན་འགའ་ཞིག་བརྗོད་པར་འདོད་ན།",
    "ཚིག་གཅིག་ལན་གཉིས་བརྗོད་པར་བྱ།",
    "ཞེས་བརྒྱད་སྟོང་འགྲེལ་ཆེན་དུ་གསུངས་པ་བཞིན་ནོ་ དེར་མ་ཟད་ཡང་ཡང་བརྗོད་པ་ཁྱད་པར་ཅན་འདི་ནི་ཚིག་ཉམས་མཛེས་པའི་རྒྱན་དུ་རིགས་པ་ཡིན་ཏེ།",
    "ཡན་ལག་ཀུན་མཛེས་བཅོམ་པར་གྱུར།",
    "འཇམ་པར་སྒྲོག་མ་བཅོམ་པར་གྱུར་ཅེས།",
    "དེ་བཅོམ་པ་ལ་རྗེས་སུ་བརྩེ་བ་ཁྱད་པར་ཅན་གྱིས་ཡང་ཡང་བརྗོད་པ་ནི།",
    "བརྗོད་བྱའི་དོན་རྟོགས་པར་བྱེད་པའམ།",
    "ངེས་པའི་འགལ་ཟླ་ཐེ་ཚོམ་སྐྱེད་པར་བྱེད་ན།",
    "གལ་ཏེ་དེ་ཡི་དོན་རྗེས་སུ་བསྟན་པར་མ་བྱས་ན།",
    "སྔ་ཕྱིའི་འབྲེལ་བ་ངེས་པར་ཤེས་པའི་རྒྱུར།",
    "གང་ཡང་གལ་ཏེ་དེ་སྟོན་བྱེད་ཀྱི་ཚིག་སྦྱོར་བ་ལ་འབད་པར་བྱས་ན།",
    "རིམ་པ་འདས་ཀྱང་སྐྱོན་མིན་པར།",
    "རོལ་པར་བསྐྱོད་པ་བྱི་རུ་ཡི།",
    "མྱུ་གུ་མཛེས་དང་ལྡན་པར་བྱེད།",
    "ཞེས་གསུངས་ཏེ།",
    "ཞེས་གསུངས་པ་འདི་འདིའི་རྒྱ་སྐད་ཀྱི་སྟེང་ནས་ཤེས་དགོས་ཀྱི།",
    "ཁ་ཅིག་དེ་འདྲའི་རོ་ཉམས་ཅི་ཡང་མེད་པ་ལ་ཞེས་འབྲུ་མནན་པར་སྣང་ངོ།",
    "མ་ཚང་མེད་པ་རྣམས་ལ་ཞེས་པའི་སྐད་དོད་ཨ་བི་ཀ་ལཱནྱཱ་ཞེས་པའི་ལཱ་ལ་སྡོད་པས་ཡ་ལྷག་མར་ལུས་པ་དེ་གཉིས་རྣམ་དབྱེ་ཤས་ཀྱི་རྗེས་ཡིན་པས་རྣམ་དབྱེའི་ལུས་འགྱུར་དེ་དག་ལྷག་མར་ལུས་ཀྱང་མིང་མཐའ་ཡར་ཐོབ་སྟེ་མིང་མཐའ་དངོས་མ་ལུས་པས་ངལ་བསོ་ཉམས་པར་མི་འགྱུར་ཞེས་སོ།",
    "འདི་ལ་དཔང་ལོས་དེ་ནི་བརྗོད་འདོད་ཙམ་དུ་བས་སོ་ཞེས་གསུངས་ཀྱང་དེ་གཉིས་ལ་ཁྱད་ཡོད་ཅེས་མཁས་པ་དག་གསུངས་པ་ལྟར་ལེགས།",
    "རླུ་གཉིས་པའི་ཐོག་མར་ཡོད་པ་འདི་ལྟ་བུའོ་ཞེས་གསུངས་ཏེ།",
    "གང་དུ་ཡི་གེ་དྲུག་པ་ལ་སོགས་པ་གང་ཡིན་པ་དེ་ལས་ཆད་པའམ་ལྷག་པར་གྱུར་པ་དང་།",
    "དགུ་པར་གྱུར་ན་ལྷག་པ་ཡིན་པའི།",
    "བོད་སྐད་དུ་ཡང་དགུ་བྱས་པ་ཡིན་ནོ།",
    "རྣམ་པར་འཕངས་ཞེས་ལྕི་བ་ཇི་བཞིན་མིན།",
    "ཡི་གེ་དང་པོ་ཡང་དགོས་ཀྱང་ཀཱ་རིང་པོར་བྱས་པས་ལྕི་བ་ཇི་ལྟ་བ་བཞིན་དུ་གནས་པ་མིན་པའི་སྐྱོན་བྱུང་ངོ།",
    "ཡི་གེ་རྣམས་མཚམས་སྦྱར་ཏེ་བསྡུས་པ་བརྗོད་པར་མི་འདོད་དེ།",
    "མཁས་པས་ཉམས་པར་རིག་མི་བྱེད།",
    "ཚིགས་བཅད་སྔ་མའི་མཐར་སྱ་སི་ཞེས་བྱུང་བ་ལ་མཚམས་མ་སྦྱར་བ་ནི་ཚིགས་བཅད་ཀྱི་མཚམས་ཡིན་པས་མཁས་པས་མཚམས་སྦྱོར་ཉམས་པར་རིག་པར་མི་བྱེད་དོ།",
    "བཅུ་པ་གོང་དུ་ཡུལ་སོགས་དང་འགལ་བ་གསུངས་པ་དེའི་དོན་ཅི་ལྟ་བུ་ཞིག་ཡིན་ཞེ་ན།",
    "ཐོས་པ་དང་བཅས་ཤིང་ཡིད་ཆེས་ཀྱི་ལུང་དུ་གསུངས་པ་ལུང་ཉིད་དེ།",
    "དྲུག་པོ་དེ་དང་དེར་ཇི་ལྟར་གྲགས་པ་བཞིན་མིན་པར་གལ་ཏེ་རབ་ཞུགས་ན།",
    "ཉིན་པར་ཀུ་མུད་ལྡན་པ་གསལ།",
    "དགུན་ནི་ཙནྡན་བསྔགས་པར་འོས།",
    "ཅུང་ཟད་བསྟན་པར་བྱ་སྟེ་དཔེར།",
    "འགལ་བ་ལེགས་པར་རྟོགས་པར་བྱ།",
    "འཕགས་ཡུལ་སོགས་སུ་ཡོངས་གྲགས་སྒྱུ་རྩལ་དྲུག་ཅུ་རྩ་བཞི་ནི་བཟོ་ལ་སོགས་པར་གཏོགས་པ་སུམ་ཅུ།",
    "སྒྲ་གྲག་པར་འཕོག་པ།",
    "གཞན་ཡང་ཤིང་སོགས་དངོས་པོ་བཅད་པ་དྲལ་བ་འབུག་པ་ལ་བྱང་བ་ཕལ་ཆེར་ཤིང་བཟོ་དང་ལྕགས་བཟོའི་ལས་ལྟ་བུ་ཡིན་རུང་འདིར་རྒྱལ་རིགས་ལ་མཁོ་བ་མཚོན་ཆའི་སྒྱུ་རྩལ་གཙོ་བོར་བྱས་པ་འདྲའོ།",
    "དེ་ནས་བསྒྲིམ་མི་དགོས་པར་ཕོག་པ་འབྱུང་ལ།",
    "སེམས་མ་ཞུམ་པར་བརྟན་པའི་དཔའ་བ་དང་།",
    "དལ་ཞིང་བག་ཕེབས་ལ་བྱམས་པའི་ཚུལ་ཅན་ཞི་བའི་ཉམས་རྣམས་ལུས་ཉམས་སུ་ཐོན་པར་བྱས་པ་ནི་གར་གྱི་འཆམ་སྟབས་ཁྱད་པར་ཅན་ཡིན་པས་དེ་ལ་བྱང་བ་ནི་སྒྱུ་རྩལ་ལོ།",
