    "གདུལ་བྱའི་ལེགས་བྱས་རྒྱ་མཚོ་གྱེན་འཕྱུར་༢༢༡ན་བར།",
    "བརྒལ་ཕྱིར་ཤོང་བའི་སྣོད་ཞིག་སླར་བསྐྲུན་པར།",
    "གཤེགས་དང་བཞུགས་ལ་མཚར་འཛིན་བྱིས་བློ་སྟེ།",
    "བཞུགས་རྟེན་རིན་ཅེན་མཆོད་སྡོང་གནྡྷོ་ལ།",
    "ཞིང་ཡིན་ཅེས་སུ་རྣམ་པར་གྲགས།",
    "གཞན་༢༢༢ན་ཡང་གདུལ་བྱའི་ལེགས་བྱས་གཞིར།",
    "ཐམས་༢༢༢བ་ཅད་མཁྱེན་པ་བཙོང་ཁ་པ།",
    "རི་བོ་ཕྲག་པར་བླངས་པར་ལྟར།",
    "རྣམ་མཁྱེན་རྒྱུར་བསྔོའི་དྲོད་ཀྱིས་བཞུ་བའི་ཆབ།",
    "རྩོམ་པར་དུས་ལ་བབ་ཕྱིར་བསིལ་ལྡན་འདིར།",
    "འདི་ཕྱི་ཀུན་ཏུ་ཕན་བདེར་སྤྱོད་པར་ཤོག།",
    "ངག་ནས་བླང་དང་དོར་བྱ་རྣམ་པར་སྟོན།",
    "འཛུམ་པའི་རྩེ་དགའ་ཁོང་ནས་དགོད་པར་ཤོག།",
    "ནམ་ཡང་གཡེལ་བ་མེད་པར་མེལ་ཚེ་མཛོད།",
    "ཁྱད་པར་འཇམ་དཔལ་རྡོ་རྗེ་བཙོང་ཁ་པའི།",
    "ལྷུན་པོ་བཞིན་ཏུ་མི་གཡོ་གནས་པར་ཤོག།",
    "རྟག་ཏུ་བདེན་པར་གསུང་བའི་ཚིག་བཙན་པོས།",
    "རྣམ་འདྲེན་གཞན་ལས་ཁྱད་པར་གྱུར་དེ་བསྔགས།",
    "བསྟོད་བསྔགས་གླུ་དབྱངས་ལེན་དང་ལྷན་ཅིག་པར།",
    "ལེགས་བྱས་མ་དྲོས་ཆུ་བོ་ལས་བབས་པ།",
    "འགྲུབ་པའི་སྐལ་བ་བཟང་པོར་སྤྱོད་པར་ཤོག།",
    "ཡིད་ཅན་ཀུན་གྱི་ཕྲག་པར་གནས་པར་ཤོག།",
    "ཅན་སྤྱི་དང་ཁྱད་པར་བོད་ཡུལ་འདིར།",
    "འཇིག་རྟེན་གསུམ་གྱི་སྒྲོན་མེ་འདེགས་པར་ཤོག།",
    "ཐུབ་གསུང་མགུར་ནས་ཚངས་དབྱངས་ཀྱིས་གསུངས་པ།",
    "ཕན་དང་བདེ་བའི་སྣང་བས་ཁྱབ་པར་ཤོག།",
    "མྱུར་དུ་རྣམ་པ་ཐམས་ཅད་མཁྱེན་འཐོབ་ཤོག།",
    "ཁྱད་པར་མགོན་ཚེ་ཡིད་འཕྲོག་རིགས་ཀྱི་བུ།",
    "སྐྱེ་རྒུའི་ལེགས་བྱས་རྒྱ་མཚོར་ཉེར་ལྷུངས་པ།",
    "སྤྱོད་མཁས་ངེས་པར་ཐམས་ཅད་མཁྱེན་དེ་རྒྱལ།",
    "མཆོག་གསུམ་རྟེན་གྱི་བཞུགས་གནས་གནྡྷོ་ལ།",
    "རྟེན་དང་བརྟེན་པར་བཅས་པའི་ངོ་མཚར་གྱིས།",
    "ལེགས་བྱས་གསེར་གྱི་གཞོང་པར་སྤུངས་པ་ཡི།",
    "མཁྱེན་བརྩེ་ནུས་པའི་འོད་མཚོན་སྣང་བྱེད་རྒྱུན།",
    "འགྲོ་ཀུན་ལེགས་བྱས་མཁའ་དབྱིངས་ལམ་དུ་ཆད་པ་མེད་པ་རྟོག་རྒྱུ་ཚེ།",
    "རྒྱལ་ཀུན་མཁྱེན་པ་འཇམ་དབྱངས་གཞོན་ནུའི་སྐུར།",
    "ལེགས་པར་རྣམ་ཕྱེ་དཀོན་བརྩེགས་ཕལ་ཆེན་སོགས།",
    "ལེགས་པར་གསུངས་འདི་ཀུན་གྱི་གཙོ་བོར་བསྔགས།",
    "མཐའ་མར་ཚལ་པ་ཀུན་མཁྱེན་བུ་སྟོན་སོགས།",
    "ཕྲག་པར་བླངས་པའི་དགེ་ཚོགས་གཟུགས་ཅན་དུ།",
    "མངོན་སུམ་མྱོང་བའི་བསྐལ་བཟང་འཐོབ་པར་ཤོག།",
    "རང་རིགས་མེས་ཀྱི་ཁྲི་ལ་ལེགས་བཞུགས་ཏེ།",
    "སད་དང་མཐུན་པར་ཞི་བདེའི་ཚ་གདུང་ཀུན།",
    "རྣ་བ་མཛེས་པའི་རྒྱན་དུ་སྤུད་པར་ཤོག།",
    "མངའ་འབངས་ཀུནྡའི་དགའ་སྟོན་བཞད་པར་ཤོག།",
    "གཟུང་འཛིན་རྣམ་པར་མི་རྟོག་སར་སྙོལ་བའི།",
    "སེམས་བསྐྱེད་ཕྲག་པར་གཞན་ཕན་ཁུར་འཁྱེར་ཤོག།",
    "ལྡོང་མི་དགོས་པར་གྲུབ་པའི་མཐའ་ཀུན་ལ།",
    "རིང་པོར་བསྟན་གནས་བྱ་བ་ལེགས་བྱས་པ།",
    "ཁྱད་པར་ལག་ན་པད་དཀར་འཆང་བའི་ལྷ།",
    "ནག་ཕྱོགས་ལྷ་སྲིན་གདུག་པ་ལྕགས་ཀྱི་ཁམས།",
    "ཀུན་མཁྱེན་བུ་སྟོན་འཇམ་མགོན་བཙོང་ཁ་པ།",
    "རྣམ་དག་ཐུབ་བསྟན་འཛིན་པར་བགྲང་བྱའི་འོས།",
    "འདྲེན་པ་འཇིག་རྟེན་བྱོན་པའི་གཤེགས་བཞུགས་ཀྱང་།",
    "ཆེར་བསྔགས་དབུགས་དབྱུང་མཛད་པར་གདོན་མི་ཟ།",
    "བྱེ་བྲག་གཙང་ཕྱོགས་གཡས་རུ་རུ་ལག་ཅེས།",
    "དགེ་སྡིག་སོ་སོར་སྤྱད་པའི་རྣམ་པར་སྨིན།",
    "ལེགས་བྱས་སྤེལ་འདིའི་ཁུར་ཆེན་འབད་པས་བླངས།",
    "གངས་ལྗོངས་འགྱུར་བའི་རྒྱལ་གསུངས་པུསྟ་ཀའི།",
    "བཞེད་ཚུལ་མི་འདྲའི་ཁྱད་པར་ཕ་མཐའ་ཡས།",
    "ངེས་པར་ཐམས་ཅད་མཁྱེན་པ་བུ་སྟོན་རྗེ།",
    "ཀུན་མཁྱེན་ཟླ་བའི་མ་མར་འདྲེན་གྱུར་ཅིག།",
    "རྟག་ཏུ་འཕེལ་འགྲིབ་མེད་པར་འཆར་བར་ཤོག།",
    "སྤྱི་དང་ཁྱད་པར་གངས་ཅན་བོད་ཡུལ་འགྲོ།",
    "ལུས་ཅན་ཀུན་གྱི་རྣམ་པ་ཐམས་ཅད་མཁྱེན།",
    "འདི་ག་ཀརང་བབིནཡམརཎཏོཤིརཱཏཱཾམལཱནྡྷོཛནབོཀྲྀཏཾཙཱཔིནོཏྲལྟརཀབྷཀཤྲབིཀཧིཙསུཙརྨབེབྷཱཥཎེཏུབྱརོཏཱཉྩམཱ་ཛཱིབཔརླབཏཀཱནྟི།",
    "རྒྱལ་རྔ་ལན་བརྒྱར་བརྡུང་དང་ལྷན་ཅིག་པར།",
    "བྱུས་ལེགས་རྡོ་རྗེའི་སྲོག་ཤིང་རབ་ཚུགས་པར།",
    "དྲག་པོ་ཡང་ནི་ལོངས་སྤྱོད་པ་སྟེ་བདུན་པར་ཛམྦུའི་མི་རྣམས་གནས་པ་དག་ནི་ལས་ཀྱིས།",
    "དངོས་གྲུབ་ས་པར་ཤེས་པར་བྱ།",
    "རྒྱལ་བའི་བསྟན་པའང་བོད་ཡུལ་ཁོ་ནར་དར་བར་གསུངས་ཤིང་།",
    "གོ་རིམ་མི་འཁྲུགས་པར་བྱེད་པའི་ཆེད་དུ་འཕགས་ཡུལ་བ་པྲ་ཝངྒར་འབོད་ཅིང་།",
    "ཁྱད་པར་གཡུལ་ལས་རྣམ་པར་རྒྱལ་བའི་ལྷས།",
    "རང་རྟགས་གོ་མཚོན་བཟང་བསྒྲིགས་འདི་ཅིག་ཤོས་ལ་རང་རྟགས་གོ་མཚོན་འཇུག་བདེ་འདི་ལྟར་རོ་ཞེས་པར་བསྒྱུར།",
    "ཚོ་ཆེན་གོ་མཚོན་རབ་མཆོར་འདི་འཇུག་བདེ་འདི་ནའོ་ཞེས་པར་འདོན་པ་བསྒྱུར།",
    "སྲུང་མ་སྤྱི་དང་ཁྱད་པར་གནམ་གྱི་ལྷ།",
    "ལེགས་བྱས་མཛོད་དུ་གཡས་སུ་འཁྱིལ་བའི་དཔྱ།",
    "རིང་མིན་གསལ་འགྲིབ་སྤངས་པའི་རྣམ་མཁྱེན་འོད།",
    "མཐོང་བའི་ལུས་ཅན་མཐའ་དག་དོན་ལྡན་པར།",
    "འབྲོམ་སྟོན་བརྒྱུད་པར་བཅས་པའི་བཀའ་གདམས་ཀྱི།",
    "གང་དེར་མཆོག་གསུམ་བཞུགས་གནས་གནྡྷོ་ལ།",
    "རྒྱ་དཔངས་ཡངས་བཟོ་བཟོ་ཡི་ཁྱད་པར་ཅན།",
    "མགོན་བརྙན་ཁྱུང་པོས་རྨོག་ཅོག་པར་གནང་བའི།",
    "རྟག་ཏུ་སྤྱོད་པའི་སྐལ་བཟང་འཐོབ་པར་ཤོག།",
