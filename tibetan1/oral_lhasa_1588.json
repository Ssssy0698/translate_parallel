    "ཡེ་ཤེས་ཀྱི་སྒོ་རྟོག་གེའི་བློས་བསམ་གྱིས་མི་ཁྱབ་པ་སྟོང་པ་ཉིད་ཀྱི་དོན་སྔར་རྟོགས་པ་རྣམས་ཀྱང་མི་བརྗེད་པར་དྲན་པར་གྱིས་ཤིག་ཅེས་བསྒོའོ།",
    "བསམ་གྱིས་མི་ཁྱབ་པའི་གསུངས་པ་ནི།",
    "དང་པོ་ནས་འཕེལ་འགྲིབ་མེད་པར་གནས་པ་ཉིད་དོ།",
    "དེ་ལྟར་ན་བྱང་སེམས་དེ་ནི་གནས་སྐབས་དེ་ཉིད་དུ་གཞན་དོན་མེད་པར་ཡོངས་སུ་མྱ་ངན་ལས་འདའ་བར་འགྱུར་ཏེ།",
    "འཇམ་དཔལ་གང་ཟག་གང་ལ་ལ་དེ་བཞིན་གཤེགས་པས་གསུངས་པའི་བཀའ་ལ་ལ་དོན་དམ་པར་སྟོན་པ་ནི་བཟང་བར་འདུ་ཤེས།",
    "ཤེས་རབ་ལ་བརྟེན་དགོས་པར་མ་ཟད།",
    "སྦྱིན་པའི་རོལ་ཏུ་ཕྱིན་པ་རྫོགས་པར་བྱེད་པ་ཡིན་པས་ཤེས་རབ་འཆལ་པ་མ་ལགས་སོ།",
    "བསྐལ་པ་ཆེན་པོ་དྲུག་ཅུར་སྦྱིན་པ་ནས་བཟུང་སྟེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་བར་དུ་གུས་པར་སྦྱོར་བ་དང་།",
    "རྟག་པར་སྦྱོར་བའི་བརྩོན་འགྲུས་གཉིས་ཀྱིས་ཡང་དག་པར་བསྒྲུབས་ན།",
    "སྟོང་པ་ཉིད་ཀྱི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚུལ་རྟོགས་པ་ཉིད་ཀྱིས་སོ་ཞེས་ཟེར་རོ་ཞེས་རྒྱས་པར་འབྱུང་ངོ།",
    "གསུམ་པ་ཐབས་ལ་ལྟོས་པར་བསྟན་པ་ལ་དོན་གསུམ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་ནི་ཐབས་དང་ཤེས་རབ་ཟུང་དུ་འཇུག་པ་ཉིད་ཀྱི་སྤྱོད་པར་བྱ་བ་སྟེ་ཞེས་གསུངས་སོ།",
    "རྒྱུ་གཞན་གྱི་དྲིང་ལ་རག་མ་ལུས་པར་བླ་ན་མེད་པའི་བྱང་སེམས་ཀྱི་རྟོགས་པ་སྐྱེ་བར་ཤེས་པར་བྱའོ་ཞེའོ།",
    "ཐབས་གཙོ་བོ་ཐོག་མཐའ་བར་གསུམ་དུ་བརྟེན་དགོས་པར་བསྟན་པ་ནི།",
    "འབྲས་བུ་ཐམས་ཅད་མཁྱེན་པའི་ཡེ་ཤེས་ནི།",
    "ལོག་པར་མི་བཟུང་ངོ་ཞེས་པའི་དོན་ནི།",
    "ཐབས་ཀྱི་ཆ་དགོས་པར་སྟོན་པའི་ལུང་སྔར་སྨོས་པ་ཐམས་ཅད་དང་ཡང་འགལ་བ་ཁོ་ནར་འགྱུར་རོ།",
    "ཐབས་ཁོ་ན་བསྒྲུབ་པར་བྱ་བ་ཡིན་གྱི་ཤེས་རབ་མི་དགོས་སྙམ་ན།",
    "ཞེས་སུན་འབྱིན་པར་མཛད་དོ།",
    "དོན་དམ་པར་ཏེ་རིགས་པས་དཔྱད་ན་སྐྱེ་བའི་རང་བཞིན་མེད་པ་ཁོ་ན་སྟེ།",
    "རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པ་དེ་ཡང་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བའི་དོན་དམ་པ་དང་སྐྱེ་བའི་སྤྲོས་པ་མེད་པར་མཐུན་པའི་ཕྱིར་སྐྱེ་བ་མེད་པ་བདེན་ནོ་ཞེས་གསུངས་ཀྱི།",
    "དོན་དམ་པར་ཏེ་རིགས་པས་དཔྱད་ན་ནི་སྐྱེ་བ་ཡང་བདེན་པ་མ་ཡིན།",
    "ཚུལ་བཞིན་འདྲི་བ་ནི་གང་ལགས།",
    "ཚུལ་བཞིན་ནི་གང་ལགས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་བརྒྱད་སྟོང་པ་ལས་ཀྱང་གསུངས་ཏེ།",
    "རྣམ་པར་ཤེས་པའི་བར་དུ་རྣམ་པར་ཤེས་པའི་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་སྟེ།",
    "ཇི་ལྟར་གསུངས་ཤེ་ན།",
    "དུས་གསུམ་དུ་རང་བཞིན་མེད་པར་མཉམ་པ་ཉིད་ཀྱིས་མཉམ་པ་དག་སྟེ།",
    "དེ་བས་ན་རིགས་པས་ཡང་དག་པ་སྐྱེ་མེད་ཀྱི་དོན་སོ་སོར་བརྟག་པར་བྱའོ།",
    "སྤྱོད་པ་བ་དག་དངོས་པོ་རྣམས་རྒྱུ་ལ་མ་ལྟོས་པར་འབྱུང་ངོ་ཞེ་ན།",
    "དུས་ཐམས་ཅད་དུ་རྒྱུ་ལ་མི་ལྟོས་པར་བྱེ་བྲག་མེད་པའི་ཕྱིར།",
    "རྟག་པ་ལ་ནི་འབྲས་བུ་བསྐྱེད་པའི་ནུས་པ་རྐྱེན་གྱིས་ཕན་གདགས་པ་ལ་ལྟོས་པར་མི་རུང་བའི་ཕྱིར་རོ།",
    "རྟག་པ་དེ་དག་ནི་ཡུལ་དུས་གང་དུའང་འབྲས་བུ་ཅིག་ཆར་མི་བསྐྱེད་པར་མ་ཟད།",
    "འདི་ལྟར་དང་པོའི་དུས་ཁོ་ནར་འབྲས་བུ་ཐམས་ཅད་ཅིག་ཆར་དུ་བསྐྱེད་པར་འདོད་ནས་ཕྱིན་ཆད་ཀྱང་གལ་ཏེ་སྔ་མའི་ནུས་པ་དེ་ཁོ་ན་བཞིན་དུ།",
    "འདུས་མ་བྱས་ཀྱི་ནམ་མཁའ་རྫས་སུ་སྒྲོ་འདོགས་པ་དང་།",
    "མྱ་ངན་ལས་འདས་པ་སོ་སོར་བརྟགས་འགོག་ལ་སོགས་པ་འདུས་མ་བྱས་པའི་དངོས་པོར་ཞེན་ཅིང་སྒྲོ་འདོགས་པ་ནི།",
    "གལ་ཏེ་རྒྱུ་དང་དུས་ཀྱིས་བར་དུ་མ་ཆོད་པར་སྐྱེ་ན་ནི།",
    "གལ་ཏེ་བདག་ཉིད་ཐམས་ཅད་ཀྱིས་བར་དུ་མ་ཆོད་པར་འདོད་ན་ནི།",
    "འབྲས་བུའི་སྐད་ཅིག་ལ་ཆ་ཤས་ཡོད་པར་འགྱུར་རོ།",
    "བདག་ཉིད་ལ་བདག་ཉིད་ཀྱིས་བསྐྱེད་པར་བྱེད་པའི་ནུས་པ་འཇུག་པ་འགལ་བའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་སྐྱེ་བ་མེད་ཅིང་།",
    "རིགས་པས་རྣམ་པར་དཔྱད་ན་རང་བཞིན་མེད་དོ།",
    "རིག་པས་རང་བཞིན་མེད་པར་གྲུབ་པ་ཡིན་ལ།",
    "དངོས་པོའི་གནས་ཚུལ་ལ་རྣམ་པར་དཔྱོད་པའི་རིགས་པའི་རྣམ་པ་གཅིག་ཏུ་ན་འདི་ལྟར།",
    "རིགས་པ་འདིས་ཤེས་བྱའི་ཚུལ་ལ་རྣམ་པར་དཔྱད་པར་བྱ་སྟེ་ཞེས་པས་མཚམས་སྦྱར་རོ།",
    "དཔྱད་པར་བྱ་བའི་དངོས་པོ་རྣམས་ནི་དོན་རྣམ་པ་གཉིས་ཏེ།",
    "ཡན་ལག་སོ་སོ་དང་འབྲེལ་བའི་ཆ་དུ་མར་ཁས་ལེན་དགོས་པས་ཆ་མེད་གཅིག་བདེན་པར་འགལ་ལོ།",
    "ཤར་དང་ནུབ་ལ་སོགས་པའི་ཕྱོགས་ཆ་དང་ལྡན་པའི་དབྱེ་བས་ཆ་དྲུག་ཏུ་རྣམ་པར་ཕྱེ་ན།",
    "དོན་དམ་པར་ངོ་བོ་ཉིད་མེད་པ་ཁོ་ན་ཡིན་ཏེ།",
    "རྨི་ལམ་ལ་སོགས་པ་ན་དམིགས་པའི་གཟུགས་ལ་སོགས་པར་སྣང་བ་བཞིན་ནོ།",
    "བདེན་པའི་གཅིག་དང་དུ་མའི་ངོ་བོ་ཉིད་ལས་མ་གཏོགས་པའི་དངོས་པོ་བདེན་པར་གྲུབ་པའི་ངོ་བོ་གཞན་མེད་པས་སོ།",
    "སྔོན་པོ་ལ་སོགས་ཕྱི་རོལ་གྱི་དོན་མེད་པར་རིགས་པའི་སྟོབས་ཀྱིས་གྲུབ་པས་ན།",
    "ཕུང་པོ་གཟུགས་ཅན་མ་ཡིན་པ་རྣམ་པར་ཤེས་པ་ལ་སོགས་པ་དེ་དག་ཉིད་སྔོན་པོ་ལ་སོགས་པའི་དངོས་པོར་སྣང་བར་ཁས་བླང་དགོས་སོ།",
    "རྣམ་པ་རྫུན་པར་འདོད་པ་སུན་དབྱུང་བའོ།",
    "སྔོ་སོགས་སུ་སྣང་བ་འདི་དག་ཕྱི་རོལ་གྱི་དོན་དུ་མ་གྲུབ་པས་ཤེས་པར་ཁས་ལེན་དགོས་པ་དེ་བས་ན།",
    "དོན་སྣ་ཚོགས་ཀྱི་རྣམ་པར་སྣང་བའི་ཕྱིར་དང་།",
    "གཟུང་བ་དང་འཛིན་པ་ཐ་དད་པའི་རྣམ་པར་སྣང་བའི་ཕྱིར།",
    "གལ་ཏེ་གཅིག་ཏུ་བདེན་པར་གྲུབ་ཀྱང་དུ་མ་ཡིན་པ་ཅི་འགལ་ཞེ་ན།",
    "གཅིག་དང་དུ་མ་མི་མཐུན་པར་གནས་པའི་ཕྱིར།",
    "རྣམ་པར་ཤེས་པ་དུ་མའི་ངོ་བོར་བདེན་པར་ཡང་མི་རུང་སྟེ།",
    "གསུམ་པ་རྣམ་པ་རྫུན་པར་འདོད་པ་སུན་དབྱུང་བ་ནི།",
    "ཡུལ་ཅན་རྣམ་པར་ཤེས་པའང་ཡུལ་གྱི་རྣམ་པ་ལྟར་མི་བདེན་པར་འགྱུར་ཏེ།",
    "ཡུལ་ཅན་རྣམ་པར་ཤེས་པའི་ངོ་བོ་དང་།",
    "རྣམ་པར་རྫུན་པའི་བདག་ཉིད་རྟོགས་པའི་ངོ་བོ་ཉིད་ལས་གུད་ནས་ཏེ་ལོགས་སུ་རྣམ་པར་ཤེས་པའི་ངོ་བོ་མེད་པའི་ཕྱིར།",
    "གལ་ཏེ་ཡུལ་གཟུགས་ལ་སོགས་པའང་བདག་ཉིད་ཀྱིས་ཡུལ་ཅན་ལ་རྣམ་པ་སྣང་བར་བྱེད་པ་སྟེ་གཏོད་པར་བྱེད་དོ་ཞེ་ན།",
    "འོ་ན་ཡུལ་ཅན་རྣམ་པར་ཤེས་པའི་ངོ་བོར་གྱུར་པ་རྣམས་ཡུལ་གཟུགས་སོགས་རྫུན་པ་ཉིད་ཀྱི་རྗེས་སུ་འཇུག་པ་ཡིན་པས།",
    "དོན་དམ་པར་བདེན་པ་མ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བའི་གཏན་ཚིགས་ཀྱིས་དངོས་པོ་དེ་དག་བདེན་པ་མེད་པར་ངེས་སོ།",
    "ཞེས་སོགས་ཚིགས་སུ་བཅད་པ་གཅིག་གསུངས་སོ།",
    "དགོས་པའི་ཁྱད་པར་དང་།",
    "ལུང་རིགས་ཀྱི་རྒྱས་པར་བསྟན་པ་དང་།",
    "བློས་ཕྱེད་པར་བྱས་པའི་དོན་དེ་མངོན་སུམ་དུ་རྟོགས་པར་བྱ་བའི་དོན་དུ།",
    "ཐོས་པ་དང་ལ་སོགས་པ་སྟེ་བསམ་བྱུང་ཙམ་གྱིས་དོན་དམ་པ་མངོན་སུམ་དུ་རྟོགས་པར་མི་འགྱུར་ལ།",
    "སྒྲུབ་པ་པོ་རྣམས་ལ་ཡང་ཐོས་བསམ་ཙམ་གྱིས་མ་ཡིན་པར།",
    "ཟད་པར་ས་དང་།",
    "གཟིངས་ལྟ་བུའི་ཞི་གནས་ཀྱི་གཞི་མེད་པར་སེམས་འཕྲོ་བ་མེད་པར་གནས་པ་མེད་དོ།",
    "འདོད་ཁམས་ཀྱི་མཉམ་པར་མ་བཞག་པའི་སེམས་ཀྱིས་ནི་ཡུལ་ཐོས་བསམ་གྱིས་གཏན་ལ་ཕབ་ཀྱང་སྤྱིའི་ཚུལ་གྱིས་ཤེས་པ་ཙམ་ཡིན་གྱི།",
    "ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཤེས་པར་མི་ནུས་ཏེ།",
    "བསམ་པའི་ཁྱད་པར་རྙེད་པ་དང་།",
    "གུས་པར་སྦྱོར་བའི་བརྩོན་འགྲུས་དང་།",
    "རྟག་པར་སྦྱོར་བའི་བརྩོན་འགྲུས་བརྩམ་ན་ཞི་གནས་ཤིན་ཏུ་སྟེ་ངེས་པར་འགྲུབ་བོ།",
    "བར་དུ་མ་ཆོད་པར་འཇུག་པ་དང་།",
    "ལྷུན་གྱིས་གྲུབ་པར་འཇུག་པའོ།",
    "ཐོགས་བཅས་ཐོགས་མེད་སོགས་ཀྱི་དངོས་པོ་མཐའ་དག་འདུ་བར་བྱ་བའི་རྟེན་གྱི་དངོས་པོ་གཟུགས་ཙམ་གང་ཡིན་པ་དེ་ལ་སེམས་བཞག་པར་བྱའོ།",
    "ཞི་གནས་ལ་སློབ་པའི་ལས་དང་པོ་པའི་སེམས་རྣམ་པར་གཡེང་བའི་ཉེས་པ་བསལ་བའི་ཕྱིར་དུའོ།",
    "ཇི་ལྟར་ན་སྒྲོ་འདོགས་དཔྱད་པར་བྱ་བའི་དངོས་པོ་དུ་མར་རྣམ་པར་ཕྱེ་ཞེ་ན།",
    "དགོས་པ་ཅིའི་ཕྱིར་དེ་ལྟར་རྣམ་པར་དབྱེ་བར་མཛད་ཅེ་ན།",
    "དམིགས་པ་ཇི་སྙེད་ཡོད་པ་དེ་ཡང་མ་ཡེངས་པར་བློ་གཏད་ནས་གྲངས་མ་འཆོལ་བར་ཡིད་ཀྱིས་བགྲང་ངོ།",
    "ཁམས་ལ་སོགས་པར་བསྡུ་བའི་སྒོ་ནས་སོ།",
    "གཉིས་པ་རྟོགས་པས་བར་ཆོད་པར་འཇུག་པ་ལ་ལྔ་སྟེ།",
    "གནས་པ་བརྟན་པར་བྱེད་པ་དང་།",
    "གཉིས་པ་གནས་པ་བརྟན་པར་བྱེད་པ་ནི།",
    "སླར་ཡང་མྱུར་དུ་སྔ་མའི་དམིགས་པ་དེ་ཉིད་ལ་སེམས་ཕྱི་ཕྱིར་གཞུག་པར་བྱའོ།",
    "ཏིང་ངེ་འཛིན་ཀྱིས་སྐྱོ་ནས་ཡུལ་དེ་ལ་སེམས་འཇོག་པ་མི་དགའ་བར་མཐོང་བ་དེའི་ཚེ་ཏིང་ངེ་འཛིན་གྱི་ཡོན་ཏན་ལ་ལྟ་བས་ཡུལ་དེ་ལ་སེམས་རྣམ་པར་འཇོག་པ་ལ་དགའ་བར་སྒོམ་ཞིང་།",
    "སླར་ཡང་ཏིང་ངེ་འཛིན་ལ་གནས་པར་བྱའོ།",
    "སེམས་གང་ལ་གཏོད་པའི་དམིགས་པ་དེ་ལས་སེམས་གཞན་དུ་རྣམ་པར་གཡེང་བ་ལ་ཉེས་པར་ལྟ་བས་ཞི་གནས་ལ་མི་དགའ་བར་རབ་ཏུ་ཞི་བར་བྱའོ།",
    "གསུམ་པ་སེམས་བར་མ་ཆད་པར་འཇུག་པ་ནི།",
    "བྱིང་རྒོད་ཞི་བར་བྱས་པའི་རྗེས་དེ་ནས་ཡང་སྔར་གྱི་ཞི་གནས་ཀྱི་དམིགས་པ་དེ་ཉིད་ལ་བྱིང་རྒོད་ཀྱི་སྐྱོན་དང་བྲལ་ཞིང་།",
    "བཞི་པ་ལྷུན་གྱིས་གྲུབ་པར་འཇུག་པ་ནི།",
    "ཞི་གནས་ཀྱི་སྐྱོན་བྱིང་བ་དང་རྒོད་པ་གཉིས་ཀ་དང་བྲལ་ཏེ་བྱིང་རྒོད་གཉིས་ཀྱི་ཕྱོགས་སུ་མ་ལྷུང་བར་སེམས་མཉམ་པར་འཇུག་ཅིང་།",
    "རྣམ་པར་ཞི་བར་བྱེད་དོ་ཞེས་པའི་ཚིག་གསུམ་གྱིས་ནི་ཞི་གནས་ཀྱི་མི་མཐུན་ཕྱོགས་བྱུང་བའི་ཚེ་ཞི་བར་བྱེད་པའི་ཚུལ་བསྟན་ནོ།",
    "མཉམ་པར་འཇོག་གོ་ཞེས་པའི་ཚིག་གཉིས་ཀྱིས་ནི་ཞི་གནས་གྲུབ་པ་དང་།",
    "ཁྱད་པར་དུ་གྱུར་པའི་གནས་སྐབས་གཉིས་བསྟན་ཏོ།",
    "དམིགས་པ་ལ་སེམས་གཏད་པ་ཙམ་གྱིས་མི་འགྲུབ་པས་གང་དམིགས་པར་བྱ་བའི་ཡུལ་ཉིད་ལ་སེམས་རྒྱུན་དུ་འཇོག་པའོ།",
    "སླར་སེམས་གཞན་དུ་རྣམ་པར་གཡེང་བ་ན་དྲན་པ་དང་ཤེས་བཞིན་གྱིས་ཤེས་པར་བྱས་ནས་སླར་དམིགས་པ་ལ་སེམས་བླན་ཏེ་གཡེང་བ་སྤོང་བའོ།",
    "ཉེ་བར་འཇོག་ཅེས་བྱ་བ་ནི་སེམས་དམིགས་པ་ལ་བླན་ནས་ཀྱང་རྣམ་པར་གཡེང་བར་གྱུར་ན་ཡང་བླན་ཏེ་གཡེང་བ་སྤངས་ནས་ཕྱི་ཕྱིར་ཏེ་ཡང་དང་ཡང་དུ་བརྟུན་པ་སྟེ།",
    "སེམས་གཞན་དུ་རྣམ་པར་གཡེང་བའི་ཉེས་པ་མཐོང་ནས་ཏིང་ངེ་འཛིན་གྱི་དམིགས་པ་ལ་མི་དགའ་བ་གཉེན་པོས་རབ་ཏུ་ཞི་བར་བྱེད་པའོ།",
    "རྣམ་པར་གཡེང་བའི་ཉེས་པ་ནི་ཏིང་ངེ་འཛིན་གྱི་མི་མཐུན་ཕྱོགས་བརྣབ་སེམས་དང་ཡིད་མི་བདེ་བ་ལ་སོགས་པའོ།",
    "རྣམ་པར་ཞི་བར་བྱེད་པ་ཞེས་བྱ་བ་ནི།",
    "དམིགས་པ་ལ་སེམས་ཡང་ཡང་གཏོད་པ་དང་ཏིང་ངེ་འཛིན་གྱི་མི་མཐུན་ཕྱོགས་གང་བྱུང་བ་སེལ་བར་བྱས་པ་ན་མཐར་ཇི་ལྟར་འགྱུར་ཞེ་ན།",
    "སེམས་རྩེ་གཅིག་ཏུ་བྱེད་པ་ནི་ཇི་སྲིད་འདོད་ཀྱི་བར་དུ་བྱིང་རྒོད་ཀྱི་གོ་སྐབས་མི་འབྱེད་པར་དམིགས་པ་ཤིན་ཏུ་གསལ་བར་འཛིན་པའོ།",
    "འོ་ན་ཏིང་ངེ་འཛིན་ཁྱད་པར་དུ་གྱུར་པ་ཐོབ་པའི་གནས་སྐབས་ཇི་ལྟ་བུ་ཞེ་ན།",
    "མཉམ་པར་འཇོག་ཅེས་བྱ་བ་ནི།",
    "སེམས་བྱིང་རྒོད་གཉིས་ཀྱི་ཕྱོགས་སུ་མ་ལྷུང་བར་སེམས་མཉམ་པར་གྱུར་པ་ཐོབ་པ་ན་སེམས་བཏང་སྙོམས་སུ་བྱེད་པ་སྟེ་བྱིང་རྒོད་གཉིས་མེད་པར་སེམས་མཉམ་པར་གྱུར་པས་དམིགས་པ་འཛིན་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཁྱད་པར་དུ་གྱུར་པའི་གནས་སྐབས་གསུམ་ལ་སྒྲིབ་སྟེ།",
    "དམིགས་པ་བརྗེད་པས་མཉམ་པར་འཇོག་མི་ནུས་པའི་ཕྱིར་དང་།",
    "བྱིང་རྒོད་གཉིས་ཀྱིས་ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་འཇོག་པའི་དུས་སུ་སེམས་མི་གསལ་བ་དང་།",
    "མི་རྩོལ་བ་དང་རྩོལ་བ་གཉིས་ཀྱིས་ཏིང་ངེ་འཛིན་ཁྱད་པར་དུ་གྱུར་པ་ལ་སྒྲིབ་སྟེ།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་ལས།",
    "ལུས་སེམས་ལས་སུ་རུང་བའི་རྗེས་དེ་ནས་ལུས་དང་སེམས་ཤིན་ཏུ་སྦྱངས་པར་གྱུར་པ་ཐོབ་པས་ཏིང་ངེ་འཛིན་ལ་མི་སྤྲོ་བའི་ལེ་ལོ་བཟློག་སྟེ།",
    "གང་ལ་མཉམ་པར་བཞག་པར་བྱ་བའི་དམིགས་རྣམ་མི་བརྗེད་པར་འཛིན་པའི་ཕྱིར།",
    "ཏིང་ངེ་འཛིན་ལ་མཉམ་པར་བཞག་པའི་དུས་སུ་བྱིང་བ་དང་རྒོད་པ་རབ་ཏུ་ཞི་སྟེ།",
    "དམིགས་པས་འོག་ས་ལས་འདའ་བ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་དང་།",
    "དཔྱོད་པ་དང་བཅས་པར་གྱུར་པས་ཏིང་ངེ་འཛིན་རྟོག་དཔྱོད་ཀྱིས་བསྐྱོད་པ་དེའི་ཚེ་མི་ལྕོགས་པ་མེད་པ་ཞེས་བྱ་སྟེ།",
    "རྣལ་འབྱོར་སྤྱོད་པ་བས་ནི་ཚོར་བ་སིམ་པར་ཉམས་སུ་མྱོང་བ་གཅིག་ཉིད་ལ་ཡིད་ཤེས་ལ་ཕན་འདོགས་པའི་ཆ་ནས་དགའ་བ་དང་།",
    "བསམ་གཏན་དང་པོའི་དངོས་གཞི་དེ་ཉིད་དུ་གཏོགས་པ་ལས་ཡན་ལག་རགས་པ་རྟོག་པ་ཙམ་ཞིག་མེད་ལ་དཔྱོད་པ་ལུས་པ་དེ་ནི་བསམ་གཏན་ཁྱད་པར་ཅན་ཞེས་བྱའོ།",
    "ཕྲ་བ་ལ་འདོད་ཆགས་དང་མ་བྲལ་བའི་ཁྱད་པར་ཡོད་པས་ཙམ་པོ་དང་ཁྱད་པར་ཅན་གཉིས་སུ་ཕྱེ་ལ།",
    "ཕྲ་བ་ལ་འདོད་ཆགས་དང་མ་བྲལ་བའི་ཁྱད་པར་མེད་པས་ཙམ་ཁྱད་གཉིས་སུ་མ་བཞག་གོ།",
    "ཕན་ཡོན་གྱི་ཡན་ལག་དགའ་བ་དང་བདེ་བ་དང་ལྡན་པར་གྱུར་པ་དེའི་ཚེ་བསམ་གཏན་གཉིས་པ་ཞེས་བྱའོ།",
    "འདི་ནི་ཏིང་ངེ་འཛིན་ལས་སྐྱེས་པའི་དགའ་བདེ་ཡིན་པས་གཉིས་པོའི་ཁྱད་པར་དེའོ།",
    "ཕན་ཡོན་གྱི་ཡན་ལག་སེམས་ཀྱི་བདེ་བའི་ཚོར་བ་དང་ལྡན་པར་གྱུར་པ་དེའི་ཚེ་བསམ་གཏན་གསུམ་པ་ཞེས་ཐ་སྙད་བྱའོ།",
    "བསམ་གཏན་དང་པོ་གཉིས་ཀྱི་དགའ་བ་དང་འདིའི་དགའ་བ་ལ་ཁྱད་པར་ཅི་ཡོད་ཅེ་ན།",
    "ཡིད་ཤེས་ཀྱི་འཁོར་དུ་བྱུང་བའི་ཚོར་བ་སིམ་པར་ཉམས་སུ་མྱོང་བ་ཙམ་དུ་གཅིག་ཀྱང་།",
    "གཉེན་པོའི་ཡན་ལག་འདུ་བྱེད་བཏང་སྙོམས་དང་དྲན་པ་དང་ལྡན་པར་གྱུར་པ་དེའི་ཚེ་བསམ་གཏན་བཞི་པ་ཞེས་བྱའོ།",
    "འདིར་ཤེས་བཞིན་ཡན་ལག་ཏུ་མ་བཞག་པ་ནི་བསམ་གཏན་གྱི་སྐྱོན་བརྒྱད་ལས་གྲོལ་བས་མི་མཐུན་ཕྱོགས་ལ་རྟོག་པར་བྱེད་མི་དགོས་པའི་ཕྱིར་རོ།",
    "བསམ་གཏན་གྱི་ཏིང་ངེ་འཛིན་ཐོབ་པ་དེ་བཞིན་དུ་གཟུགས་མེད་པའི་སྙོམས་པར་འཇུག་པ་རྣམས་ཀྱང་ཐོབ་སྟེ།",
    "ཟད་པར་བཅུ་ལ་སོགས་པ་དང་།",
    "གོང་དུ་རྒྱས་པར་བསྟན་པ་དེ་ལྟར་ཞི་གནས་ཀྱི་དམིགས་པ་ལ་སེམས་ཤིན་ཏུ་བརྟན་པར་བྱས་ནས།",
    "ཡུལ་གྱི་གནས་ཚུལ་རྟོགས་པའི་དོན་དུ་དོན་དམ་དཔྱོད་པའི་ཤེས་རབ་ཀྱིས་ཞིབ་པར་རྣམ་པར་དཔྱད་པར་བྱ་སྟེ།",
    "རྣམ་པར་དཔྱོད་པའི་དགོས་པ་ནི་འདི་ལྟ་སྟེ།",
    "ཤིན་ཏུ་ཞེས་པ་ནི་མ་ལུས་པ་སྤོང་བ་དང་མི་ལྡོག་པར་སྤོང་བའི་དོན་ནོ།",
    "ཞེས་སོགས་གསུངས་སོ།",
    "ཏིང་ངེ་འཛིན་དེ་ནི་ཕུང་པོ་ལ་བདག་ཏུ་ལྟ་བ་དང་བཅས་པའི་འདུ་ཤེས་འཇིག་པར་མི་བྱེད་པ་སྟེ།",
    "དཔེར་ན་རང་སྤྱོད་ཀྱི་བུ་ལྷག་སྤྱོད་ཀྱིས་འདིར་ཏིང་ངེ་འཛིན་བསྒོམས་པ་བཞིན་ནོ་ཞེས་གསུངས་པ་བཞིན་ནོ།",
    "བློ་ལ་དོན་དུ་སྣང་བ་སེམས་ཙམ་གྱི་བདག་ཉིད་དུ་རྟོགས་པ་ལ་ནི་རབ་ཏུ་བརྟེན་ནས་དོན་དུ་སྣང་བ་ལ་ཕྱི་རོལ་གྱི་དོན་དུ་བདེན་པར་མི་བརྟག་གོ།",
    "རྣམ་པར་རིག་པ་ཙམ་དུ་དམིགས་པ་ལས་ནི་དོན་ཐམས་ཅད་མི་དམིགས་པ་ལ་འཇུག་གོ་ཞེས་གསུངས་སོ།",
    "འོ་ན་གཟུང་འཛིན་སྣང་བ་མེད་པའི་རིག་ཙམ་ལ་གནས་པར་བྱའོ་ཞེ་ན།",
    "གཟུང་འཛིན་གཉིས་སུ་སྣང་བ་མེད་པའི་རིག་ཙམ་ཡང་མི་དམིགས་པར་རྟོགས་པ་ལ་གནས་པར་བྱ་ཞེས་པའི་དོན་ནོ།",
    "དེ་ལ་མི་དམིགས་པ་གང་ཡིན་པ་དེ་ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་སོ་ཞེས་གསུངས་སོ།",
    "རང་དོན་རྟོགས་པའི་ཁྱད་པར་ནི།",
    "ཤེས་བྱར་རྣམ་པར་ངེས་པ།",
    "གཟུང་བ་བདེན་པར་མི་དམིགས་པའི་དོན་ནི།",
    "ཅི་གཟུགས་སོགས་སུ་སྣང་བ་འདི་དག་རྣམ་པར་ཤེས་པ་ལས་དོན་གཞན་ཕྱི་རོལ་གྱི་དོན་ཞིག་ཡིན་ནམ།",
    "འོན་ཏེ་རྣམ་པར་ཤེས་པ་དེ་ཉིད་གཟུགས་སོགས་དེ་ལྟར་དུ་སྣང་སྟེ།",
    "རྣམ་པར་དཔྱད་པ་དེ་ལ་རྣམ་པར་ཤེས་པ་ལས་ཕྱི་རོལ་གྱི་དོན་དུ་གྲུབ་པ་ཞིག་ཏུ་འདོད་ན་ནི།",
    "བློས་རྡུལ་ཕྲ་རབ་ཀྱི་མཐར་ཐུག་པར་རབ་ཏུ་བཤིགས་ཏེ་རྡུལ་ཕྲ་རབ་རྣམས་ཀྱང་།",
    "ཅེས་གསུངས་ལ།",
    "ཞེས་གསུངས་པའང་དོན་འདི་ཉིད་དོ།",
    "དོན་དུ་སྣང་བ་སེམས་ཙམ་དུ་རྟོགས་ནས་ཕྱི་རོལ་གྱི་དོན་ལ་བདེན་པར་འཛིན་པའི་སྒྲོ་འདོགས་བཅད་དེ་བདེན་པར་མི་འཛིན་ཞེས་སྟོན་པ་ནི།",
    "ཏིང་ངེ་འཛིན་གྱིས་བསྒོམས་པ་ལ་རབ་ཏུ་བརྟེན་ནས་ཕྱི་རོལ་གྱི་དོན་ལ་བདེན་པར་མི་བརྟག་གོ་ཞེས་པ་སྟེ།",
    "གནས་ཚུལ་ལ་དཔྱོད་པའི་རིགས་པས་རྣམ་པར་དཔྱད་པ་ན་མི་དམིགས་པའི་ཕྱིར་གནས་ཚུལ་ལ་ཡོད་པར་བརྟག་པར་མི་བྱའོ་ཞེས་གདམས་པའོ།",
    "སེམས་དཔྱོད་པའི་རིགས་པ་དེ་ལ་དོན་དུ་སྣང་བ་ཅན་གྱི་སེམས་ཙམ་གང་ཡིན་པ་དེའང་ཡུལ་ཅན་འཛིན་པའང་བདེན་པར་མི་རུང་སྟེ།",
    "ལྟོས་པ་གཟུང་བ་བདེན་པར་མི་དམིགས་པའི་ཕྱིར་རོ།",
    "གཟུང་འཛིན་གཉིས་མ་གྲུབ་པ་དེ་ལྟ་བས་ན་སེམས་ནི་དོན་དམ་པར་གཟུང་བ་དང་འཛིན་པ་གཉིས་ལས་དབེན་ཞིང་།",
    "ཞེས་པ་སྟེ་འཛིན་པའི་རྣམ་པ་བདེན་པར་འཛིན་པ་ལས་ཀྱང་བཟླ་བར་བྱ་སྟེ།",
    "གཟུང་འཛིན་གཉིས་སུ་སྣང་བ་མེད་པའི་བློ་གཉིས་སུ་མེད་པའི་ཤེས་པ་རང་རིག་ཅིང་གསལ་བ་ཙམ་ལ་གནས་པར་བྱ་བའི་ཐ་ཚིག་གོ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟར་སེམས་ཙམ་དུ་བདེན་པར་འཛིན་པ་ལས་བཟླས་ནས་སླར་ཡང་གཟུང་འཛིན་སྣང་བ་མེད་པའི་ཤེས་པ་རང་རིག་རང་གསལ་བདེན་པར་འཛིན་པ་ལས་ཀྱང་བཟླ་བར་བྱ་སྟེ།",
    "དེ་ལ་ཡང་བདེན་པར་འཛིན་པ་སྤོང་ངོ་ཞེས་པའི་དོན་ནོ།",
    "གཟུང་འཛིན་གཉིས་མེད་ཀྱི་ཤེས་པ་ཅིའི་ཕྱིར་བདེན་པར་མ་གྲུབ་ཅེ་ན།",
    "གཟུང་འཛིན་གཉིས་སུ་མེད་པའི་ཤེས་པ་བདེན་པར་གྲུབ་པ་ཡང་སྣང་བ་མེད་པའི་ཤེས་པ་ནམ་མཁའ་ལྟ་བུར་རྟོགས་པ་ཁོ་ན་ལ་གནས་པར་བྱའོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "འདིར་ཐོག་མར་ལུང་དང་རིགས་པས་ཕྱི་རོལ་གྱི་དོན་མེད་པར་རིགས་པས་གཏན་ལ་ཕབ་ནས་བློ་ལ་དོན་དུ་སྣང་བ་ཙམ་ལ་དམིགས་ཏེ་བློ་ལ་སྣང་བ་ཙམ་དུ་ཟད་ཀྱི་གནས་ཚུལ་ལ་མ་གྲུབ་པར་ཤེས་རབ་ཀྱིས་རྟོགས་པའི་དོན་ཏིང་ངེ་འཛིན་གྱིས་རྩེ་གཅིག་ཏུ་ཡིད་ལ་བྱེད་ཅིང་།",
    "གཟུང་འཛིན་གཉིས་སུ་མེད་པའི་ཤེས་པ་རང་རིག་ཙམ་གྱི་ངོ་བོ་ཡང་སྣང་བ་མེད་པའི་ཤེས་པ་ལ་གནས་པར་གྱུར་པ་དེའི་ཚེ།",
    "གལ་ཏེ་སྣང་བ་ལ་མི་དམིགས་པར་འདོད་ན་ནི།",
    "སྦྱོར་བའི་གནས་སྐབས་སུ་སྣང་བ་ལ་དམིགས་ནས་སོ་སོར་རྟོག་པར་བྱེད་ཅིང་།",
    "ཇི་སྲིད་རྣམ་པར་དཔྱོད་པ་མ་རྫོགས་པ་དེ་སྲིད་དུ་སྣང་བ་ཡོད་ལ།",
    "དཔྱད་པ་ཡོངས་སུ་རྫོགས་ནས་བློས་གནས་ཚུལ་གྱི་དོན་རྙེད་ནས་དེའི་དོན་ལ་མཉམ་པར་འཇོག་པའི་ཚེ་ན་སྣང་བ་མི་མངའ་བ་ཡིན་ནོ།",
    "འདུ་ཤེས་མེད་པའི་སྙོམས་པར་འཇུག་པ་ལ་སོགས་པ་དང་།",
    "རྣམ་པར་མི་རྟོག་པ་ལ་འཇུག་པའི་གཟུངས་ལས།",
    "ཡིད་ལ་མི་བྱེད་པས་གཟུགས་ལ་སོགས་པ་ལ་བདེན་པར་འཛིན་པའི་མཚན་མ་སྤོང་ངོ་ཞེས་གསུངས་པ་གང་ཡིན་པ་དེའི་དགོངས་པ་ཡང་།",
    "ཐེ་ཚོམ་སྤོང་བ་ཤེས་རབ་ལ་ལྟོས་པར་བསྟན་པའོ།",
    "ཡང་དག་པའི་དོན་རིགས་པའི་སྟོབས་ཀྱིས་མ་ངེས་པས་ཡང་དག་པའི་དོན་ལ་ཐེ་ཚོམ་མ་སྤངས་པར་གྱུར་པ་ནི།",
    "མེ་མ་སྤངས་པར་ཚ་བ་སྤང་དུ་མི་རུང་བ་བཞིན་ནོ།",
    "གཉིས་པ་ཐེ་ཚོམ་སྤོང་བ་ཤེས་རབ་ལ་ལྟོས་པར་བསྟན་པ་ལ་གཉིས་ཏེ།",
    "གཟུགས་ལ་སོགས་པའི་བདེན་པའི་མཚན་མ་ཡིད་ལ་བྱེད་པ་སྤོང་ནུས་པར་འགྱུར་ཏེ།",
    "རྣལ་འབྱོར་པའང་གཟུགས་སོགས་གནས་ཚུལ་ལ་ཡོད་པའམ་མེད་པར་སོམ་ཉི་ཟ་བ་ལྡོག་པར་མི་འགྱུར་རོ།",
    "ཡེ་ཤེས་རྣམ་པར་དག་པ་ཐོབ་པ།"
  ]
}