    "ཁྱེད་རང་ངོ་མ་གཡག་ལ་དགའ་ན་གཡག་ཤ་མ་ཟ་རོགས།",
    "ཁྱེད་རང་ཇི་ལྟར་འཚོ་བཞིན་ཡོད།",
    "ཁྱེད་རང་སྤྲ་སེར་སྤྲེའུ་རིགས་ལ་འཐམས་འགྲོ་དོན་ཅི།",
    "འགྲིག་འདུག་འོ་ན།",
    "ཁྱེད་རང་ཐད་ཀར་རི་འཛེག་བྱེད་པའི་དཔའ་རྒོད་ཅིག་དང་།",
    "ཁྱེད་རང་ངོ་མ་དཔའ་རྒོད་ཅིག་ཡིན་པ་འདྲ།",
    "དྲང་བོ་ཞིག་ཡིན་ཚོད་འདུག་ད་དུང་ཤེས་དགོས་པ་ཞིག་ལ།",
    "ཁྱེད་རང་དྲག་པོའི་བློ་ཁོག་ཕལ་ཆེ་བ་དེ་ཞེ་སྡང་དང་ང་རྒྱལ།",
    "ཡག་པོ་འདུག་ང་ལ་ཉན་འདོད་འདུག་ད་ཞི་བའི་བསྟི་གནས་ཀྱི་གོ་དོན་ཆ་ཚང་ཞིག་གསུང་རོགས།",
    "ཡག་པོ་འདུག་ཞི་བའི་བསྟི་གནས་ཀྱི་དམིགས་ཡུལ་ཧ་ཅང་རྒྱ་ཆེན་པོ་འདུག་གལ་ཏེ་ཐུགས་འདུན་འདི་བཞིན་བོད་དེ་ཞི་བདེའི་རྒྱལ་ཁབ་ཅིག་ཆགས་ན་དེས་བོད་མི་དམངས་ཀྱི་སེམས་ཀྱི་རྨ་ཁ་ཚང་མ་སོས་ཐུབ་པ་དང་།",
    "དེ་དག་ཡག་པོ་འདུག་བསམ་བློ་གཏོང་ས་མང་པོ་འདུག་ཡིན་ཡང་བོད་ཞི་བདེར་གནས་པས་རྒྱལ་ཁབ་གཞན་ནམ་འཛམ་གླིང་ཡོངས་ལ་དགེ་མཚན་གང་ཡོད་དམ།",
    "གནས་ལུགས་འདུག་ཚང་མ་ལ་བདེ་བ་དགོས་ན་ཕན་ཚུན་སུ་ལ་ཡང་གནོད་པ་བྱེད་མི་ཉན་པ་འདྲ།",
    "ངས་ཁྱེད་རང་ལ་གནས་ལུགས་ཤིག་བསྟན་པ་ཡིན།",
    "ཁྱེད་རང་ལ་ཡང་སྐུ་སྲུང་དམག་མི་ཡོད།",
    "ངས་ངོ་མ་བསམ་བློ་གཏོང་ཤེས་མི་འདུག་གོ་མཚོན་རིགས་དང་དམག་དཔུང་ཆེན་པོ་མེད་པ་བཟོས་ཆོག་ཡིན་ཡང་དམག་མཚོན་ཉུང་ཤས་ཤིག་མེད་ན་ཞི་བས།",
    "མ་གཞི་ཁྱེད་རང་རང་བཙན་འཐོབ་པར་ཡིད་ཆེས་ཡོད་དམ།",
    "ང་རང་ཤི་ཡང་གྲོགས་པོ་གཞན་རྣམས་འཆི་མི་དགོས་པ་དེ་ཡང་ཡག་པོ་ཡིན།",
    "དེ་ལྟར་བསམ་ན་ཁྱེད་རང་ལ་བདེན་ཁ་ཆེ།",
    "ངའི་ཡིད་ཚིམ་གྱིན་འདུག་ད་ངས་ཁྱེད་རང་ལ་ཐ་མའི་དྲི་བ་ཞིག་ཡོད།",
    "ཁྱེད་རང་ལམ་གང་དུ་འགྲོ་མཁན་ཡིན།",
    "ཡག་པོ་འདུག་ངོ་མ་ཡག་པོ་འདུག་ཐུགས་རྗེ་ཆེ།",
    "བདེན་པའི་ཨུ་ཚུགས་དང་རང་ཐག་རང་གཅོད།",
    "ངོ་ཚ་མི་འདུག་སྙམ།",
    "ལར་བཟང་བོར་གཟེངས་བསྟོད་དང་ངན་པར་ཆད་པ་གཅོད་རྒྱ་དེ་འོས་ཤིང་དགོས་ངེས་ཤིག་ལོས་ཡིན།",
    "དེ་ཙམ་ཡང་མ་ཤེས་པར་གསར་ཤོག་ནང་བཀྲ་ཤིས་དང་མི་ཤིས་བ་ལྷན་འགོད་བྱས་འདུག་ཅེས་བློ་ཕམ་བྱེད་པ་ནི་རྨོངས་ཞེན་གྱི་བྱིས་བློའི་ན་ཚ་ཞིག་མིན་ནམ།",
    "ཁྱེད་རང་མི་དམངས་ཀྱི་ཁྲོད་ནས་འཚར་ལོང་འབྱུང་དགོས།",
    "ད་ལྟ་འུ་ཐུག་མཁན་དེ་རྒྱ་ནག་གཞུང་རང་ཡིན་ལ་ཕམ་ཁ་མྱོང་ངེས་པ་དེ་ཡང་རྒྱ་ནག་གཞུང་ཡིན།",
    "གང་ལྟར་ང་རང་ཞེ་མེར་བའི་ཟས་དུག་འདི་སྐྱགས་ཚར་ན་དེས་འགྲིགས།",
    "ངའི་མིག་ལམ་དུ་དར་ཆ་དམར་པོ་དེ་ནི་གཤིན་རྗེའི་ལྕེ་ཞགས་ལྷབ་ལྷུབ་ཏུ་བསྐྱོད་པ་ཞིག་ཏུ་སྣང་བས་ང་རང་ཁ་བཏགས་དཀར་པོ་དང་གངས་རི་དཀར་པོ་ལ་ངང་ངམ་ཤུགས་ཀྱིས་དགའ་དད་ཅིག་སྐྱེས་མྱོང་ཡ།",
    "དེས་གསར་རྩོམ་བྱེད་པའི་སེམས་ཤུགས་ལ་གནོད་ཀྱི་འདུག་ཅེས་དང་།",
    "ལོས་ཡིན།",
    "ཁོ་རང་ལ་མཚོན་ན་ངོ་མ་རྒྱ་ཡིག་ཁོ་ནར་བརྟེན་ནས་བོད་ཀྱི་འཚོ་བ་བྲིས་ཏེ་རྒྱ་ནག་རྩོམ་རིག་ལས་རིགས་ནང་ད་གྲགས་པ་རྒྱས་ཤིང་རྩོམ་པ་པོའི་མཐུན་ཚོགས་བོད་ལྗོངས་ཡན་ལག་མཐུན་ཚོགས་ཀྱི་རྒྱན་ལས་གཙོ་འཛིན་གཞོན་པ་ཞིག་ཏུ་གྱུར་ཡོད་པས།",
    "དེ་ལས་ལྡོག་ན་ཁྲུ་ཏ་སྐྱག་གཟན་དང་ཁྱད་པར་ཅི་ཞིག་གདའ།",
    "ངས་བལྟས་ན་ད་ལྟའི་དུས་འདི་ཧ་ཅང་འཚམས་པོ་འདུག་སྙམ།",
    "འོན་ཀྱང་ཞེས་པའི་ཐ་སྙད་འདི་ཅུང་མི་སྙན་པ་ཞིག་ལོས་ཡིན།",
    "དེའི་མཚུངས་ཁོ་བོའི་རྩོམ་གཤིས་དེ་རང་གཤིས་དང་རང་གཤིས་འདི་རྩོམ་གཤིས་སུ་འགྱུར་བ་བྱེད་རྒྱུ་ལས་སེམས་ལ་འདྲེ་ཞུགས་བཞིན་ལག་ནས་ལྷ་བཞེངས་མཁན་དུ་ནམ་ཡང་མི་འགྱུར་བའི་དམ་བཅའ་ཡོད།",
    "སློབ་དཔོན་བདག་དཀྱིལ་འཁོར་གྱི་སྒོ་དྲུང་དུ་འདུག་པ་དང་།",
    "གཤེགས་སུ་གསོལ་ཞིང་རང་ལ་བསྲུང་བའོ།",
    "རྟོག་པའང་རང་རིག་ལ་མི་འདོད།",
    "དེ་ཡང་རང་རིག་པས་རྟོགས་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེ་ཡང་རང་ཉིད་རྟོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བ་ཉིད་ལན་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་དང་རང་ཉིད་ཁོ་ན་གསལ་བ་ཡིན་གྱི་དེ་ལས་གཞན་ནི་མེད་དོ་ཞེས་གནས་སོ།",
    "དེས་ན་འབྲས་བུ་བཞིན་དུ་དོན་རིག་པ་ཡང་རང་རིག་པ་ཙམ་ཉིད་དོ།",
    "ཇི་ལྟར་ངས་འདི་རྟོགས་པ་དེ་བཞིན་དུ་རུང་བའི་ཡུལ་ན་འདུག་པ་གཞན་གྱིས་ཀྱང་རྟོགས་སོ་ཞེས་འཇིག་རྟེན་ན་གྲགས་པ་ཡིན་ནོ་ཞེ་ན།",
    "རྨི་ལམ་གྱི་གནས་སྐབས་ན་ཡང་རང་བཞིན་དེ་ཉིད་དོ།",
    "དངོས་སུ་བྱས་པ་ཤེས་པའི་རང་བཞིན་སྐད་ཅིག་མ་ཉིད་དེ་ཡང་རང་རིག་པ་ཉིད་ཀྱིས་མ་ཡིན་ཏེ།",
    "པོ་ཡང་རང་རྟོགས་པའི་རང་བཞིན་ཉིད་ནི་གཞན་ཡིན་ལ།",
    "འགའ་ཡང་མ་ཡིན་པའི་ཕྱིར་གཉི་ག་ཡང་རང་རིག་པ་ཉིད་དོ་ཞེས་བསྟན་ཟིན་ཏོ།",
    "སྐྲ་ལ་སོགས་པ་ལྟར་ཡུལ་ཐ་དད་ཀྱང་རང་བཞིན་གཅིག་ཏུ་འགྱུར་གྱི།",
    "མངོན་དུ་ཕྱོགས་པ་མཚུངས་ཀྱང་རང་བཞིན་འགའ་ཞིག་གསལ་བར་སྣང་བའི་ཕྱིར་གོམས་པ་ལ་སོགས་པ་ལས་ཀྱང་འགྱུར་རོ།",
    "གཞན་ཡང་ཕྱིའི་དོན་ཁས་བླངས་ཀྱང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་ནོ།",
    "དེས་ན་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་ནོ་ཞེས་སྟོན་ཏོ།",
    "རྣམ་པར་ཤེས་པའི་སྨྲ་བ་ལ་ཡང་རང་རིག་པ་ཉིད་རྣམ་པ་གཞན་མེད་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་ཕྱིའི་དོན་ལ་ཡང་རང་རིག་པ་ཉིད་འབྲས་བུ་ཡིན་གྱི་དོན་རིག་པ་ནི་མ་ཡིན་ཏེ།",
    "དོན་དམ་པ་ལ་ལྟོས་ནས་འདིའི་དོན་རིག་པ་ཡིན་ཡང་རང་རིག་པ་ཉིད་དོ།",
    "གཟུགས་ལ་སོགས་པའི་ཡུལ་གྱི་ཤེས་པ་གང་ཡིན་པ་ནི་དོན་དང་རང་སྣང་བ་ཡིན་ལ།",
    "ཡུལ་གྱི་ཤེས་པ་གང་ཡིན་པ་དེ་ནི་དོན་དང་རང་སྣང་བའི་ཡིན་ལ་ཞེས་བྱ་བ་ནི་བསྒྲུབ་པར་བྱའོ།",
    "འོན་ཏེ་དོན་ཡང་རང་རིག་པས་བསྒྲུབ་པ་ཡིན་ན།",
    "བུམ་པ་ལ་སོགས་པ་འབའ་ཞིག་པ་ཡང་རང་བཞིན་ཉིད་ཡིན་ཏེ།",
    "སོགས་པའི་ཡུལ་ནི་བློ་དང་ལྷན་ཅིག་དུས་གཅིག་ཉིད་དུ་མྱོང་བ་ཡིན་ཏེ།",
    "དེས་ན་རྣམ་པ་དུ་མའི་ཉེས་པ་དེ་ནི་སོ་ན་འདུག་པ་ཉིད་དོ་ཞེ་ན།",
    "ཤེས་པ་གཅིག་དུས་ཉིད་དུ་ཡོངས་སུ་རྫོགས་པའི་ཕྱིར་རྟག་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "ཇི་ལྟར་ལུས་ལ་ལྟོས་ནས་རྩིག་པ་མདུན་ན་འདུག་བ་དེ་བཞིན་དུ་ལུས་ཀྱང་རྩིག་པ་ལ་ལྟོས་ནས་ཡིན་པར་འགྱུར་ན།",
    "དེ་ལྟ་ན་ཡང་རང་རིག་མིན།",
    "ལུས་ཀྱི་རྣམ་པ་ཡིན་ཡང་རང་རིག་པར་ཁས་མི་ལེན་པའི་ཕྱིར།",
    "དེ་ཡང་རང་རིག་པའི་རང་བཞིན་ཡིན་པས་རང་རིག་པ་གྲུབ་བོ།",
    "གལ་ཏེ་བློ་ཡང་རང་རིག་པ་མ་ཡིན་ན་ནི་ཁྱད་པར་དང་ཁྱད་པར་ཅན་མ་ཡིན་པའི་དོན་ཉིད་རྟོགས་པ་ཡིན་ནོ་ཞེས་བྱ་བར་འགྱུར་རོ།",
    "དེས་ན་བརྗོད་པ་ལྡོག་པས་ཁ་རོག་འདུག་པར་བྱའོ།",
    "འོན་ཏེ་གཞན་གྱིས་ཀྱང་རང་བཞིན་དེ་ཉིད་རྟོགས་པ་ཡིན་ནོ།",
    "འོན་ཏེ་དེ་ཡང་རང་རིག་པ་ལ་སོགས་པ་དོན་གྱི་སྣང་བ་སྣང་བ་ཡིན་པས་ན།",
    "དེས་ན་དེ་ཡང་རང་ཉིད་རབ་ཏུ་གསལ་བ་ཉིད་ཀྱིས་གསལ་བ་ཡིན་གྱི།",
    "འོན་ཏེ་མི་གནས་ཀྱང་རང་ཉིད་གནས་སོ་ཞེ་ནམ་དེའི་ཚེ་ཡང་།",
    "མཐར་ཐུག་དུས་ཀྱང་སྐད་ཅིག་འདོད།",
    "དེའི་ཕྱིར་འགྲོ་བ་འདི་ན་བདེ་བ་ལ་སོགས་པ་དང་སྔོན་པོ་ལ་སོགས་པ་ལས་གཞན་རིག་པ་མེད་པའི་ཕྱིར་ན་བདེ་བ་ལ་སོགས་པ་བཞིན་དུ་སྔོན་པོ་ལ་སོགས་པ་ཡང་རང་རིག་པ་ཡིན་ནོ་ཞེས་རིགས་པ་འདི་ནི་གདོན་མི་ཟའོ།",
    "དེ་ཡང་རང་ཉིད་རྟོགས་པ་ཡིན་ཏེ།",
    "རིག་པ་དེ་ཡང་རང་རིག་པ་མ་ཡིན་ན་ནི།",
    "གལ་ཏེ་བློ་དེ་དག་དུས་ཀྱི་རང་བཞིན་འཛིན་པ་ཡིན་ན་ནི་དེའི་ཚེ་ཐོག་མ་དད་ཐ་མ་མེད་པ་ཉིད་དང་།",
    "འདོད་པ་དང་རང་ཉིད་ཀྱི་ཚིག་བཞིས་མ་གྲུབ་པ་དང་།",
    "དེ་ལྟ་ན་ཡང་རང་ཉིད་སྨོས་བ་ནི་ལོག་པར་རྟོག་པ་དགག་པའི་ཕྱིར་ཡིན་ནོ།",
    "ཅི་སྟེ་ཁ་རོག་ཉིད་དུ་མི་འདུག་ཅེ་ན་མ་ཡིན་ནོ།",
    "གཏན་ཚིགས་ལྟར་སྣང་བ་ཡང་རང་ཉིད་དེ་ལྟར་འགྱུར་བ་ཡིན་པའི་ཕྱིར་རྒོལ་བ་ལ་ཉེས་པ་ཅི་ཡོད།",
    "ཐག་རིང་ན་འདུག་པས་ཅི་ཕྱིར་ཐོས་ཤེ་ན།",
    "དེ་ལྟ་ན་ཤིང་ལ་སོགས་པའི་དོན་རྣམས་ཀྱང་རང་ཉིད་སྔ་མ་དང་ཕྱི་མ་ལ་སོགས་པ་ཡིན་གྱི་སྔ་མ་ཉིད་ལ་སོགས་པས་དུས་གཞན་ལ་ལྟོས་པ་ནི་མ་ཡིན་ནོ།",
    "གལ་ཏེ་མི་གནོད་དོ་ཞེན་ཡང་རང་ཉིད་འཇུག་པས་ན་རང་ཉིད་སྨོས་པས་ཅི་བྱ་ཞེ་ན།",
    "འོན་ཏེ་གཞན་མ་གྲུབ་ཀྱང་རང་ཉིད་ནི་ལུང་ལས་གྲུབ་པ་ཡིན་ནོ་ཞེ་ན།",
    "གལ་ཏེ་མེ་དང་དུ་བ་དག་ཀྱང་རང་ཡུལ་ཅན་གྱི་རྣམ་པར་ཤེས་པ་ལ་སྣང་བའི་ཕྱིར་ཅི་ལྟར་དེར་འགྱུར།",
    "འབྲས་བུའི་གཏན་ཚིགས་དང་རང་བཞིན་གྱི་གཏན་ཚིགས་ཀྱིས་རབ་ཏུ་འགྲུབ་པ་འགལ་བའི་དོན་གྱིས་གསལ་བ་དེར་ཡང་ཕྱོགས་མ་ཡིན་ནོ་ཞེས་འདི་རྗེས་སུ་དཔག་པ་ཉིད་པ་ཅི་སྟེ་མི་བརྗོད།",
    "འགའ་ཡང་འདུག་པར་ཡང་མི་བྱ་འགྲོ་བར་ཡང་མི་བྱ་བར་འགྱུར་རོ།",
    "སྦྱོར་བ་ཡང་རང་བཞིན་དང་རྐྱེན་གྱི་དོན་ལས་སྐྱེས་པ་ཡིན་པའི་ཕྱིར།",
    "དེ་ལ་ཡང་རང་ཉིད་བསྒྲུབ་པར་བྱ་བ་ཉིད་དུ་འདོད་པ་ནི་ཕྱོགས་ཡིན་ནོ་ཞེས་གསུངས་སོ།",
    "འོན་ཀྱང་རང་བཞིན་འགས་ནི་ཐ་དད་པ་ཡིན་ལ།",
    "འོན་ཏེ་ཁྱད་པར་དང་སྤྱི་ཐ་དད་པ་དག་ཀྱང་རང་བཞིན་འགས་ནི་ཐ་དད་པ་ཡིན་ལ་རང་བཞིན་འགས་ནི་ཐ་དད་པ་མ་ཡིན་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "ཡུལ་ཐག་རིང་པོ་ན་འདུག་པའི་ཐོ་ཡོར་ལ་ཐ་དད་པ་ཡོད་ཀྱང་རྟོགས་པར་མི་ནུས་ཏེ།",
    "དེ་ཡང་རང་བཞིན་གཞན་ཡིན་པའི་ཕྱིར་ཐུག་པ་མེད་པས་སྒྲའི་བདེན་པའི་བདག་ཉིད་ནི་མི་རྟག་པ་ཉིད་དོ།",
    "དེའི་ཕྱིར་འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་གཉིས་ཀ་ཡང་དཔེ་འདི་ཉིད་ཀྱིས་བསྟན་པ་ཡིན་ནོ།"
  ]
}