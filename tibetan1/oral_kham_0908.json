    "ཆེ་ཆུང་མེད་དོ་ངོ་བོ་ང་རང་ཡིན།",
    "གང་ཐོས་པ་དེ་ཡང་རང་རྒྱུད་ལ་འབྱོར་ཞིང་ལག་ལེན་ལ་འཁེལ་བའམ་རང་སྤྱོད་ལ་མཐུན་པ་ཞིག་ལ་མཁས་པར་འཇོག་དགོས་ལ།",
    "ཆུ་དྭངས་པའམ་དར་ཁ་དོག་ཐ་དད་པའི་སྟེང་དུ་བཞག་ན་དེའི་ཁ་དོག་ཏུ་འགྱུར་ཡང་རང་ངོ་ལ་དགོས་པ་མེད་པའི་དཔེ་བཞིན།",
    "སྣང་སྲིད་འཁོར་འདས་ཐམས་ཅད་རང་སེམས་ལས་ནི་འདས་པ་མི་འདུག།",
    "སེམས་ཀྱི་གནས་ལུགས་ཕྱག་རྒྱ་ཆེན་པོ་ལ་ནི་སྒྲིབ་པ་གསོག་རྒྱུ་བསག་མཁན་སྦྱང་རྒྱུ་སོགས་གདོད་ནས་མ་གྲུབ་པར་གདའ་སྙམ་ནས།",
    "དྲང་པོར་འདུག་ལ་ཡང་དག་ལྟོས།",
    "མངོན་སྤྱོད་ཀྱི་དགོངས་པ་བསྟན་དགྲ་སྒྲོལ་བ་ལ་དགོངས་པ་ལོས་ཡིན་ལ།",
    "བྱེད་པ་པོ་རང་ཉིད་ཀྱང་རང་དོན་གྱི་ཞེན་འཁྲིས་སོགས་དང་སྤུ་ཙམ་ཡང་མ་འདྲེས་པར་བསྟན་པ་བསྲུང་བའི་ཆེད་ཁོ་ནའི་ལྷག་བསམ་ཞེ་ཐག་པ་ནས་དགོས་ལ།",
    "སྔར་ཡོད་ནའང་རང་ཉིད་ཕམ་ལེན་གྱི་མཐོལ་བཤགས་བྱས་ལ་སྦྱངས་ཏེ་ཚེ་ཕྱི་མར་འབྲང་མི་དགོས་པར་བྱེད་པ་དང་།",
    "རྗེ་མར་པའི་ཚོགས་མགུར་དུ་གཡས་པ་ཌཱ་མ་རུ་དང་གཡོན་པས་ཏིང་ཤག་བསྣམས་ཚུལ་དེ་ཡང་གཡེར་ཁའི་རིགས་དེ་དག་ཡིན་པར་གདའ་བས།",
    "རྒྱ་དྲིལ་མ་འཆུག་པ་རྣམས་ལ་ངེས་དག་ཡོང་འདུག་པ།",
    "མཚམས་ཐོ་འདི་མི་གསར་པ་འོང་ས་མེད་པར་བྱེད་པའི་བརྡ་ཁོ་ན་ཡིན་བསམ་མཁན་འབའ་ཞིག་གདའ་ནའང་།",
    "དགོས་པར་གསུངས་པ་འདི་དག་ཀྱང་དགོས་པ་ཆེ་བར་གདའ་བ་དང་།",
    "ངག་མཚམས་ཀྱང་སོ་བསྡམས་ནས་ཕ་རོལ་པོས་གོ་ཐུབ་ཙམ་དུ་ལབ་པའི་ཕྱག་སྲོལ་དིང་སང་ཕལ་ཆེར་གྱིས་བྱེད་འདུག་ནའང་ཕྱེད་མཚམས་ལྟ་བུར་འགྲོ་ཤས་ནི་ཆེ།",
    "གཏོར་མ་ཉིན་ཞག་འགའ་ཞིག་བཞག་ན་འབུ་སྲིན་གྱི་གོང་བུར་གྱུར་ནས་ཅི་ཡང་བྱ་ཐབས་མི་འདུག་ཚེ།",
    "གཞུང་དོན་གཙོ་བཟུང་ཐོག་བདེ་སྡུག་ཞུ་མཁན་འབྱོར་མེད་དབུལ་ཕོངས་ཚོར་ཐུགས་འཁུར་ཆེན་པོས་བཀའ་ལན་གང་སྔ་ཐོན་ཐབས་ལ་རང་དོན་ཁྱད་མེད་འབད་བརྩོན་གནང་འདུག་ཆུ་ཕག་ཕྱི་ལོ་༡༩༢༣ ལོར།",
    "སྦྱོར་དངོས་རྗེས་གཙང་གནང་བའི་མཛད་རྗེས་མི་དམན་པ་བཞག་གནང་འདུག་ཤིང་ཁྱི།",
    "བཀའ་ཤག་ཏུ་བཀའ་དྲུང་ཞིག་དགོས་གལ་གྱིས་ལྷ་ས་གཉེར་ཚང་ཀླུ་ཁང་པ་བཀའ་དྲུང་ཆེ་བའི་མཚན་འཕར་གནང་སྟེ་བཀའ་ཤག་ཏུ་ཞབས་ཞུར་ཕེབས་དགོས་བྱུང་འདུག་མེ་གླང་ཕྱི་ལོ་༡༩༣༧ ལོར།",
    "སྐབས་དེར་སྐུ་ངོ་ཐུབ་བསྟན་བསམ་མཆོག་ལགས་འབྲུག་ཡུལ་དུ་ཕེབས་ཏེ་མཇལ་ཐུབ་པ་བྱུང་གནང་མི་འདུག་ཀྱང་།",
    "སྐབས་དེར་སྐུ་ངོ་ཐུབ་བསྟན་བསམ་མཆོག་ལགས་འབྲུག་ཡུལ་དུ་ཕེབས་ཏེ་མཇལ་ཐུབ་པ་བྱུང་གནང་མི་འདུག་ཀྱང་།",
    "སྐུ་སྲུང་གང་འཚམས་བསྡད་ན་འགྲིགས་ཞེས་བསམ་ཚུལ་རྣམས་ཞུམ་མེད་གསལ་པོར་བརྗོད་འདུག་རྒྱ་མིས་ཐོག་མའི་ཆར་ལན་འདེབས་མཁས་པོ་བྱས་ཏེ།",
    "འདོད་པར་མི་འབབ་པ་ཤུགས་ཆེར་འགྲོ་བཞིན་འདུག་ཡང་ཁོང་ནས།",
    "ཀླུ་ཁང་པས་ཡིག་ཟིན་དེ་ཀློག་སྐབས་ཁྲོམ་དཀྱིལ་དུ་གླུ་གཞས་བཏང་མི་ཆོག་ཅེས་འཁོད་ཡོད་སྟབས་ཁོང་ནས་དེ་ལ་བཟོ་བཅོས་འབྲེལ་ཆགས་པོ་ཞིག་བྱས་འདུག་ཀྱང་།",
    "དེ་སྐོར་བཀའ་ཤག་ཏུའང་བརྗོད་འདུག་བཀའ་ཤག་ནས་སྲིད་བློན་གཉིས་ཀ་དགོངས་པ་ཞུ་བཅུག་ན་ལེགས་ཚུལ་བསམ་འཆར་སྤྲད་བྱུང་ཞིང་།",
    "ཅེས་བཀའ་གསལ་པོ་གནང་འདུག་པ་ལྟར།",
    "ད་དུང་ཕྲན་ལ་སློབ་སྟོན་གནང་བཞིན་ཡོད་ཅེས་བཀའ་སྤྱི་ཕེབས་སུ་འདུག་ཞྭ་སྒབ་པའི་སྲིད་དོན་རྒྱལ་རབས་དེབ་གཉིས་པའི་ཤོགགྲངས་༥༤༣ པའི་ཡིག་ཕྲེང་༡༢༡༤ བར་ལ།",
    "ལ་དྭགས་རྡ་རམ་ས་ལར་སྐུ་བཞུགས་གནང་འདུག་པ།",
    "དེ་ནས་ཡང་བཅོམ་ལྡན་འདས་ཀྱིས་བྱུང་ཆུབ་སེམས་དཔའ་ཕྱག་འདུགནས་སུ།",
    "ཉན་ཐོས་དང་རང་སངས་རྒྱུས་དང་།",
    "ཉན་ཐོས་དང་རང་སངསརྒྱུ་འདས་ཞེས་པའོ།",
    "ཡུལ་དེའི་མདུན་དུ་ཙོག་པུར་འདུག་སྟེ།",
    "ཁྱེད་རང་ལ་ནང་འགལ་ཏེ།",
    "ཟོས་ཀྱང་རུང་ངོ་ཞེས་བསྟན་འདུག་པའི་ཕྱིར་དང་།",
    "ཕ་རྣམ་དག་ལྟ་བ་ཐ་དད་ན་ཕན་ཚུན་བྱིན་ལེན་ཆགས་པས་བསྟན་འདུག་པའི་ཕྱིར་རོ།",
    "དགེ་སློང་རྣམས་ལ་ཤིན་ཏུ་གུ་ཡངས་ཀྱི་ཕན་ཡོན་ཆེ་བར་འདུག་གོ།",
    "མ་བཏུབ་ན་དེ་ཉིད་ཟས་པས་ཆོག་གོ་ཞེས་གནང་འདུག་པའི་ཕྱིར་རོ།",
    "ཁར་མིད་པ་མ་ཡིན་པ་ཁ་གཤལ་བའི་ཆུ་ལ་བྱིན་ལེན་མི་བྱེད་ཅེས་འབྲུ་སྣོན་གནང་འདུག་ཀྱང་།",
    "གནས་གང་ན་ཁུར་རྩ་བ་འདུག་པ་དེར།",
    "དེ་ཡོལ་གང་ཞིག་དུས་མིན་ཟ་བྱེད་པ།",
    "དེ་ཡང་ཁྱེད་རང་གསོལ་ཅིག་བདག་མི་ཟའོ་ཞེས་དང་།",
    "ཙོག་པུར་འདུག་སྟེ།",
    "ཞེས་འདུག་ས་ཡང་ཡང་སྤོས་ནས་ཟོས་པའི་དགེ་སློང་དེའི་དྲུང་དུ་ལྷག་བོར་བྱ་བ་མ་ཡིན་ཏེ།",
    "དེ་ལ་བྱིན་ལེན་མཚན་ཉིད་པ་མི་ཆགས་པ་གང་ཞིག་བྱིན་ལེན་མ་བྱས་པ་ནི་རུང་བ་ཚད་ལྡན་གྱིས་ཀྱང་རང་སྟོབས་ཀྱི་ཉེས་པ་དེ་སྐྱེད་པའི་ཕྱིར་སྙམ་དུ་ཁོ་བོ་སེམས་སོ།",
    "གཅིག་པུར་འདུག་ན་སེམས་ལ་བརྟག།",
    "བཞེས་པར་གདའ་བས་གསན་པར་ཞུ།",
