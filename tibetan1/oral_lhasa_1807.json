    "བྱ་རྣམས་སྐད་འབྱིན་པར་མི་བྱེད་པ་དང་།",
    "གཅིག་ཏུ་ངེས་པར་བག་མེད་པའི་དབངདུ་གྱུར་ཏེ།",
    "གཅིག་ཏུ་ངེས་པར་ཡིདདུ་འོང་བའི་གཟུགས་རྣམ་པ་སྣ་ཚོགས་ལ་བལྟ་བ་དང་།",
    "གཅིག་ཏུ་ངེསཔར་དྲི་ཞིམ་པོའི་སྤོས་རྣམ་པ་སྣ་ཚོགས་དང་།",
    "གཅིག་ཏུ་ངེས་པརརོ་ཞིམ་པའི་རོ་རྣམ་པ་སྣ་ཚོགས་དང་།",
    "བདེ་བའི་བྱེ་བྲག་ཏུའགྱུར་བར་རིག་པར་བྱ་སྟེ།",
    "ཇི་ལྟ་ཇི་ལྟར་སོ་སོར་མབརྟགས་པ་ཤིན་ཏུ་སྟོབས་ཆེ་བའི་སེམས་དང་ལྡན་པར་གྱུར་པ་དེལྟ་དེ་ལྟར་སྡུག་བསྔལ་གྱི་བྱེ་བྲག་ཏུ།",
    "འཕགས་པ་མ་ཡིན་པའི་ནོར་ལས་བྱུང་བའི་བདེ་བལས་རྣམ་པ་བཅོལྔས་ཁྱད་པར་དུ་འཕགས་ཏེ།",
    "འཕགས་པམ་ཡིན་པའི་ནོར་ལས་བྱུང་བའི་བདེ་བ་ནི་ཉེས་པར་སྤྱོད་པ་ཀུནནས་སྤོང་བ་ཡིན་ལ།",
    "ལེགས་པརསྤྱོད་པ་ཀུན་ནས་སློང་བ་ཡིན་ནོ།",
    "ཕྱིས་འཕགས་པདང་འཕགས་པ་མ་ཡིན་པའི་ནོར་ཐོབ་པར་བྱེད་པ་མ་ཡིན་ལ།",
    "འཕགསཔའི་ནོར་ལས་བྱུང་བ་ནི་ཕྱིས་འཕགས་པའི་ནོར་ཐོབ་པར་བྱེད་པཡིན་ནོ།",
    "ལོངས་སྤྱོད་ནཡོངས་སུ་ཟད་ཅིང་མཐར་ཐུག་པར་འགྱུར་ལ།",
    "ཡངས་པརའགྱུར་རོ།",
    "དེ་ལས་བཟློག་པའི་ཚུལ་གྱིས་ཅི་རིགས་པར་རིག་པར་བྱའོ།",
    "དེས་ན་འཕགས་པ་ཤེསརབ་ཀྱིས་འཚོ་བརྣམས་ལ་བླ་ན་མེད་པའི་ཤེས་རབ་ཀྱིས་འཚོ་བས་འཚོ་བ་ཞེས་བྱསྟེ།",
    "འདོདཆགས་དང་བྲལ་པར་གྱུར་པ་རྣམས་ཀྱང་ཡང་ཕྱིར་ལྡོག་པར་འགྱུརལ།",
    "སྒྱུ་མར་བྱསཔའི་རྒྱན་ལྟ་བུ་གང་ཡིན་པ་དེ་ལ་བྱིས་པ་འདོད་པ་ལ་ལོངསསྤྱོད་པ་རྣམས་དང་།",
    "ཅིང་ལོངས་སྤྱོད་པར་བྱེད་དེ།",
    "བདུད་དང་ཕྱི་རྒོལ་བ་ངེས་པར་བཅོམ་པ་ཡིན་ལ།",
    "དེ་བས་ན་བཅོམ་ལྡན་འདས་ཀྱིས་བདེབའི་ཚོར་བ་ནི་འགྱུར་བའི་སྡུག་བསྔལ་གྱིས་སྡུག་བསྔལ་བ་ཞེསགསུངས་ལ།",
    "སྡུག་བསྔལ་ཡང་མ་ཡིན་བདེ་བ་ཡང་མ་ཡིནབའི་ཚོར་བ་ནིའདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་གྱིས་སྡུག་བསྔལ་བའོ་ཞེས་གསུངས་སོ།",
    "བདེ་བ་རྣམས་ཀྱི་མཆོག་ཏུ་རྣམ་པར་གཞགཔ་གང་ཡིན་པ་དེ་ཡང་།",
    "གཏི་མུག་དང་བྲལ་བ་ཞེསགསུངས་པའི་བདེ་བ་གསུམ་པོ་དེ་དག་ནི་ཟག་པ་མེད་པའི་དབྱིངས་ཉིདལ་ཡོད་དེ།",
    "སྡུགབསྔལ་འདྲེས་པར་ཡོད་པས་འཁྲིག་པའི་སྦྱོར་བ་ཡོད་དེ།",
    "སྤྲད་པས་གདུང་བ་མེད་པར་འགྱུར་རོ།",
    "འཐབ་བྲལ་བ་རྣམས་ནི་གཅིག་ལ་གཅིག་འཁྱུད་པ་ཙམགྱིས་གདུང་བ་མེད་པར་འགྱུར་རོ།",
    "དགའ་ལྡན་པ་རྣམས་ནི་གཅིག་ལགཅིག་ལག་པ་ནས་འཛིན་བ་ཙམ་གྱིས་གདུང་བ་མེད་པར་འགྱུར་རོ།",
    "འཕྲུལ་དགའ་བ་རྣམས་ནི་གཅིག་ལ་གཅིག་བགད་པ་ཙམ་གྱིས་གདུང་བམེད་པར་འགྱུར་རོ།",
    "དགའ་ལྡན་པརྣམས་ཀྱི་ནི་ལོ་བརྒྱད་ལོན་པ་ལྟ་བུའོ།",
    "དེ་ལ་སྐྱེ་བར་འདོགས་པ་རྣམ་པར་གཞག་པ་ནི་འདི་ཡིན་ཏེ།",
    "བདེ་བ་སྐྱེ་བ་གསུམ་དུ་རྣམ་པར་གཞག་ཅེན།",
    "ཚངས་པར་སྤྱོད་པ་ཚོལ་བའོ།",
    "དགེསྦྱོང་ངམ་བྲམ་ཟེ་ཚངས་པར་སྤྱོད་པ་ཚོལ་བ་ལ་འཇུག་པ་གངསུ་ཡང་རུང་བ་དེ་དག་ཐམས་ཅད་ནི་ཟག་པ་མེད་པའི་དབྱིངས་ཀྱིཕྱིར་རོ།",
    "འདུ་ཤེས་མེད་འདུ་ཤེས་མེདམིན་སྐྱེ་མཆེད་ཀྱི་དོན་དུ་ལོག་པའི་ཚངས་པར་སྤྱོད་པ་ཚོལ་བ་ལའཇུག་སྟེ།",
    "དེ་ནི་ཚངས་པར་སྤྱོད་པ་ཚོལ་བ་བླ་ན་ཡོད་པ་ཡིན་པརརིག་པར་བྱའོ།",
    "དེ་ལ་ལུསརྣམ་པར་གཞག་པ་ནི།",
    "བརྒྱན་པའི་གནས་ཀྱི་སྦྱོར་བ་དང་ལྡན་པར་གནས་པན།",
    "དེ་དག་དེ་ལྟར་གནས་པས་དྲན་པ་བྲྗེད་པར་འགྱུར་རོ།",
    "ལྷའི་ཡིད་འཁྲུག་པར་བྱེད་པ་ཞེས་བྱ་བ་དག་ཡོད་དེ།",
    "གཅིག་ལ་གཅིག་ཡིད་འཁྲུག་པར་བྱེད་དེ།",
    "བྱམས་པ་ལསྙོམས་པར་ཞུགས་པ་དང་།",
    "འགོག་པ་ལ་སྙོམས་པར་ཞུགས་པ་དང་།",
    "དེ་ལ་རྒྱུ་དངརྐྱེན་དང་འབྲས་བུ་རྣམ་པར་གཞག་པ་ནི་རྣམ་པ་བཞིར་རིག་པརབྱ་སྟེ།"
  ]
