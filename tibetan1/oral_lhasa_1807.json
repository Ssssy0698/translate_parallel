    "མངལ་ན་གནས་པ་ཡོངས་སུ་རྫོགས་པར་འགྱུར་བནི།",
    "དེ་དག་ནི་དེ་ལ་གནོད་པ་སྐྱེད་པར་བྱེདདོ།",
    "དེའི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ལས་བྱུང་བ།",
    "ཁ་ཟསཀྱིས་རྒྱས་པར་བྱེད་པ་དང་།",
    "ཀུན་ཏུ་ལེགས་པར་བསྲུང་བ་དང་།",
    "དེ་ནས་བཙས་པརརིག་ནས་གཞན་དགཀྱང་དེ་དང་མཐུན་པའི་ཟས་ལྡུད་པར་བྱེད།",
    "དེ་ནས་དུས་མ་ཡིན་པར་འགྲོ་བ་དང་།",
    "ཟག་པ་ཟད་པ་ཐོབ་པར་མ་གྱུར་གྱི་བར་དུ་བདེ་བ་དང་སྡུག་བསྔལབ་ལས་འདའ་བར་མི་འགྱུར་རོ།",
    "ཞེས་བྱ་བའི་ཚིག་འདི་ནི་ཤིན་ཏུ་རྟོགསཔར་དཀའསྟེ།",
    "གལ་ཏེ་འཇིག་པར་འགྱུར་བའི་ལསཉེབར་གནས་པར་གྱུར་ན་ནི།",
    "དེ་ནས་ཕྱི་རོལ་གྱི་འཇིག་པའི་རྐྱེན་གྱིསདེ་དག་འཇིག་པར་འགྱུར་གྱི།",
    "འཇིག་པའི་ལས་གང་ཡིན་པ་དེ་ནིངེས་པར་བསྐལ་པར་གནས་པར་འཕེན་པ་ཡིན་ཏེ།",
    "འདི་ལྟརའཇིག་པ་དེ་ལ་ཡང་རྣམ་པ་གསུམ་ཡོད་པར་རིག་པར་བྱ་སྟེ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུར་ནི་ཞིག་པར་གནས་སོ།",
    "བསྐལ་པ་དེའི་རྣམ་པར་གཞག་པ་གཞན་དུ་ཡང་བལྟ་བར་བྱསྟེ།",
    "བར་གྱི་བསྐལ་པ་ཉི་ཤུ་ལ་བསྐལ་པ་གཅིག་ཏུ་བཏགས་པ་ནིཚངས་རིས་རྣམས་ཀྱི་ཚེའི་ཚད་དུ་རྣམ་པར་གཞག་གོ།",
    "ཚངས་པའིམདུནན་འདོན་རྣམས་ཀྱི་ཚེའི་ཚད་དུ་རྣམ་པར་གཞག་གོ།",
    "བར་གྱི་བསྐལཔ་དྲུག་ཅུ་ལ་བསྐལ་པ་གཅིག་ཏུ་བཏགས་པ་ནི་ཚངས་ཆེན་རྣམས་ཀྱིཚེའི་ཚད་དུ་རྣམ་པར་གཞག་གོ།",
    "ཚེ་ལོ་བརྒྱད་ཁྲིལ་ཐུགཔར་འགྱུར་བ་དང་།",
    "ཡང་འགྲིབ་ནས་ཚེ་ལོ་བཅུ་པ་ལ་ཐུག་པར་འགྱུར་བདང་།",
    "ཚེ་ནུར་ནས་ཕྱིར་ཚེ་བརྒྱད་ཁྲི་ལ་ཐུག་པར་འགྱུརབ་དེའིདུས་ཀྱང་ཡོད་དེ།",
    "གྲངས་རྣམ་པར་གཞག་པསབར་གྱི་བསྐལ་པ་ཞེས་བྱའོ།",
    "ཏིལ་གྱི་འབྲུ་རྙེད་པར་གྱུར་ན།",
    "དེ་དག་རྒྱུ་དེ་དང་རྐྱེན་དེས་ཚེ་འགྲིབ་པར་མིའགྱུརལ།",
    "མུ་གེ་དེ་ཡང་མེད་པར་འགྱུར་རོ།",
    "སྐྱོ་བ་དེ་ཉིད་མེད་པར་གྱུར་ནས།",
    "རྒྱུ་དེ་དངརྐྱེན་དེས་ཚེ་འགྲིབ་པར་མི་འགྱུར་ལ།",
    "གངདང་གང་བླངས་པ་དེ་དང་དེ་དག་མཚོན་ཆ་རྣོན་པོ་ལེགས་པརབདར་བ་བཞིན་དུ་འགྱུར་ཏེ།",
    "ཡོ་བྱད་རྒུད་པར་འགྱུར་རོ།",
