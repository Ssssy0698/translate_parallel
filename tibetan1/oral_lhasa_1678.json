    "ཚོར་སྣང་ཞིག་ལ་བརྟེན་ནས་མདུན་དུ་བསླེབས་པ་དེ་ཨ་སྟག་ཡིན་པར་ཡིད་ཆེས་བྱས།",
    "ཟུང་ཟླ་བ་མ་གཏོགས་མ་སྨད་གཉིས་ཐང་རྗེན་དུ་པུས་བཙུགས་ཀྱིས་བསྡད་ཡོད།",
    "ཁོའི་སེམས་ལ་ལྷ་ས་ནི་ལྷ་ས་རང་ཡིན་སྙམ་ཡོད།",
    "ཁོ་གཉིས་ཀྱིས་དྲི་བ་འདིའི་གོ་དོན་ཡེ་ནས་རྟོགས་ཀྱིན་མེད་པར་མ་ཟད།",
    "ཁོས་དེ་ལྟར་བརྗོད་པའི་དམིགས་ཡུལ་ནི་དུག་སྡོམ་བསད་པར་སྐྱོན་མེད་ཟེར་བ་ཡིན་ནམ།",
    "ཁོས་འདྲ་པར་ཇི་ལྟར་ལེན་ནམ།",
    "ཁོས་ད་ལྟའི་བར་དུ་ལྕགས་རིའི་འདྲ་པར་མཐོང་མ་མྱོང་བར་ཡང་འདི་ལྟ་བུའི་གནས་ལུགས་གལ་ཆེན་ཞིག་ཡོད་ཅིང་།",
    "ཁོས་གྱང་ལྡེབས་དུད་དྲེག་ཅན་དེ་འདྲ་པར་དུ་ལེན་འོས་པ་སྨོས་མ་དགོས་ཏེ།",
    "མདང་ནུབ་ཅེས་ཚིག་མགོ་རྔ་མེད་པའི་འཚམས་འདྲི་ཞིག་བྱས།",
    "ཟུང་ཟླ་བས་མཚར་སྣང་དང་བཅས་དྲིས་པར།",
    "སྐྱེས་པ་ཁ་ཤས་ཚ་ཐབ་ཐོག་འདུས་ནས་བསྡད་ཡོད།",
    "དེ་ལྟར་ཡུན་རིང་ལ་ཁུ་སིམ་མེར་བསྡད།",
    "ཁོས་མུ་མཐུད་དུ་རྭ་ཙེ་མཆུ་ཏོ་དང་འབྲལ་མེད་བྱས་ནས་དུ་བ་འཐེན་པ་དང་།",
    "ཟུང་ཟླ་བས་ཁོའི་རྣམ་འགྱུར་ལ་ཡུན་རིང་བལྟས་ནས་བསྡད་པར།",
    "ཟུང་ཟླ་བས་མཁྲིག་མའི་ཆུ་ཚོད་འཁོར་ལོར་ལྟ་ཙམ་བྱས་རྗེས་བྱ་བ་ཅི་ཞིག་ཡོད་དམ་ཞེས་དྲིས།",
    "སྐྱེས་པ་སྨྲ་ར་ཅན་གྱིས་ཁོར་ལམ་བཏབ་པར་དྲི་བ་ཞིག་བཏོན་བྱུང་།",
    "སྐྱེས་པ་སྨྲ་ར་ཅན་དེས་ལན་ཅི་ཡང་འདེབས་མ་ནུས་པར་མུ་མཐུད་དུ་རྭ་ཙེ་ཡང་ཡང་བརྔུབས་ཀྱང་།",
    "གཙང་འགྲམ་ལ་ཁོ་གཉིས་མཉམ་དུ་བསླེབས་ཤིང་།",
    "གཙང་བོ་འདི་དངོས་གནས་ཁ་ཞེང་ཆེ།",
    "ཁོས་གཙང་བོའི་གཞུང་ལ་བལྟས་ནས་སྨྲས་པར།",
    "ཟུང་ཟླ་བ་གཙང་བོའི་འགྲམ་ངོགས་ཀྱི་བྱེ་ཁུག་དང་གནའ་གྲོང་།",
    "ཐག་མི་རིང་བའི་རྩྭ་སྔོན་ཐར་ཐོར་སྐྱེས་ཡོད་ས་ཞིག་ཏུ་བསྡད་ཅིང་།",
    "ན་ཆུང་དུས་སུ་ཕ་མ་གཉིས་ཀྱི་ལག་པར་འཇུས་ནས་གཙང་བོའི་འགྲམ་དུ་ཡོང་བའི་སྣང་བ་འགོག་མེད་དུ་ཡིད་ངོར་ཤར།",
    "ཁ་ཞེང་ཆེ་ལ་ཅ་ཅོའི་བཞུར་སྒྲ་མེད་པའི་ལྷིང་འཇགས་ཀྱི་གཙང་བོའི་རྔམ་བརྗིད་ཀྱིས་ཡིད་སེམས་དྲངས་པར་གྱུར།",
    "ཨ་སྟག་ཁོང་ཁྲོ་དྲག་པོ་ལངས་ནས་ཁོ་ལ་ཁུ་ཚུར་གྱིས་གཞུ་ཅི་ཐུབ་བྱས།",
    "ཁོ་ཚོ་གཙང་བོའི་འགྲམ་དང་ཁ་གྱེས་དུས།",
    "ད་དུང་པར་ཆས་དང་ལག་འཁྱེར་སྒྲ་སྡུད་འཁོར་ལོ་གཟུང་དགོས་ཤིང་།",
    "ཁོ་མུ་མཐུད་དུ་གོམ་པ་མགྱོགས་པོར་སྤོས་ནས་འགྲོ་ཐབས་མེད་པར་གྱུར།",
    "གལ་སྲིད་ང་འགྲོ་མ་ནུས་པར་ས་ལ་འགྱེལ་པ་ཡིན་ན།",
    "ད་དུང་ང་ལ་ཐེ་གཏོགས་བྱས་བྱུང་།",
    "ཟུང་ཟླ་བ་ཅུང་ཟད་ཧ་ལས་པར་གྱུར།",
    "མི་དེ་ཚོས་ཅི་ཡིན་འདི་ཡིན་ཆ་མ་འཚལ་བར་བཤོལ་འདེབས་བྱས་བྱུང་བར།",
    "གཞན་རྣམས་ཀྱིས་འུར་སྐད་རྒྱག་བཞིན་པའི་སྐྱེས་པ་གཞན་པ་དེའི་མཐའ་བསྐོར་ནས་བཤོལ་འདེབས་ཅི་ཐུབ་བྱས།",
    "ད་ལྟའི་རྐུན་ཇག་ལ་བྱོལ་བྱོལ་ལ་བསྡད་ཀྱང་ནམ་ཐུག་ཆ་མེད་ཡིན་པ་མི་ཤེས་སམ།",
    "དེ་བས་ཁོས་བཟོད་པ་ངོ་ལུག་ལ་ལག་འཇུ་བྱས་ནས་ཡུད་ཙམ་ལ་ཆས།",
    "ཁོའི་ལག་ཟུང་ཡང་དང་ཡང་དུ་གཡོ་འགུལ་བྱས་པས་གློག་སྒྲོན་གྱི་འོད་ཀོར་གནས་ངེས་མེད་དུ་ཕོག་ཅིང་།",
    "གསར་གཏོད་བྱས་ཟིན་པའི་ལས་རིགས་རྣམས་ལའང་དོ་སྣང་མེད་པ་ཆགས་ངེས།",
    "དེ་ལ་བརྟེན་ནས་མི་དང་མིའི་བར་དུ་ཁྱད་པར་འདྲ་མིན་སྣ་ཚོགས་བྱུང་བར་མ་ཟད།",
    "ཡ་ད་ལྷས་རའི་ནང་དུ་བསྡད་ནས་ཅི་བྱེད་དམ།",
    "ང་གནའ་གྲོང་དུ་སྡོད་རྒྱུར་ཆོག་མཆན་གནང་བྱུང་ངམ།",
    "ཕ་དྲིན་ཅན་ཤི་རྗེས་ཞི་ལིར་ལྟ་སྐྱོང་ཕྲན་ཙམ་ཡང་བྱས་མ་མྱོང་ཞེས་སྨྲས་ཤིང་།",
    "ཁོ་གནའ་གྲོང་དུ་ཡོང་བའི་སྟ་གོན་ལོ་ཤས་སྔོན་ནས་བྱས་ནའང་།",
    "རྒྱུ་ནོར་མེད་པས་ལམ་ཆས་མང་བོ་ཞིག་གྲ་སྒྲིག་བྱེད་མ་ཐུབ་པར་ད་ལྟའི་བར་དུ་ལུས།",
    "ཁོའི་པར་ཆས་དེར་སྒོར་སྟོང་ཕྲག་གསུམ་བྱིན་ནས་ཉོས་པ་ཡིན་ལ།",
    "ལམ་འཇུག་བྱས་མྱོང་བའི་རྒྱུས་ཡོད་ཀྱི་མིས་ཀྱང་རྟོགས་མི་སྲིད།",
    "ཟུང་ཟླ་བ་ཇི་ལྟར་གཙང་བོའི་འགྲམ་དུ་བསླེབས་པའང་མ་ཚོར།",
    "གཙང་བོའི་རླབས་སྒྲས་ཁོའི་སེམས་པ་ཕྱིར་བཀུག་པ་ན།",
    "གཙང་བོ་ནི་སེར་སྣས་བཅིངས་པའི་ཕྱུག་པོ་གཏེར་བདག་ཅིག་དང་འདྲ།",
    "ཉེ་ལོགས་སུ་འབབ་པའི་གཙང་བོ་ནི་ཆུ་མིན་པ་ལྟ་བུའི་ཉམས་སྣང་སྐྱེ་རུ་འཇུག་སྐབས་དེར་ཟུང་ཟླ་བས་རྒྱལ་པོས་མི་སེར་དང་མཉམ་དུ་སྨྱོ་ཆུ་འཐུངས་པའི་གཏམ་རྒྱུད་དྲན་ཅིང་།",
    "ཟུང་ཟླ་བས་བཟོད་བསྲན་བྱེད་མ་ནུས་པར་དེ་སྐད་སྨྲས།",
    "ཟུང་ཟླ་བས་ལག་ཟུང་མདུན་དུ་བརྐྱངས་ཙམ་བྱས་ནས་གཏིང་འདྲི་བྱས།",
    "ཁོས་གཙང་བོའི་ནང་དུ་ལག་སྙོབ་བྱས་ཤིང་།",
    "ཁོ་གཉིས་ཀྱིས་མིག་སྔའི་གཙང་བོ་དང་ཆུ་གནའ་གྲོང་།",
    "མིག་འབྲས་ནག་རིག་རིག་ཟུང་ཟླ་བའི་གདོང་ལ་བལྟས་ནས་བསྡད།",
    "དེ་ཡང་གཙང་བོ་ཆུ་ཡིན་ཀྱང་གཙང་བོ་ས་དམའ་སར་བཞུར་གྱིན་ཡོད་པ་དང་རྣང་ཞིང་ས་མཐོ་སར་གནས་པས།",
    "ཁོ་རྣང་ཞིང་དང་ཁ་བྲལ་ནས་གཙང་བོའི་འགྲམ་དུ་ཆས།",
    "རྣང་ཞིང་དང་གཙང་བོའི་བར་དུ་གོམ་པ་ལྔ་བཅུ་ཙམ་ལས་མེད་ཀྱང་།",
    "གནའ་གྲོང་དེ་བཅིངས་འགྲོལ་བྱས་ནས་ལོ་ངོ་ལྔ་བཅུ་ལྷག་འགོར་ན་ཡང་།",
    "དེ་ལས་ཀྱང་མིག་སྔར་སྒྲུབ་དགོས་པ་ནི་ཆུ་འདྲེན་འཁོར་ལོ་ཞིག་གཙང་བོའི་འགྲམ་དུ་འཛུགས་དགོས་པ་དེ་ཡིན།",
    "ཁས་འཆེ་བའི་བྱ་བཞག་ཅིག་ཡིན་ཕྱིན་ངེས་པར་སྒྲུབ་རྒྱུ་ནི་མི་དཀྱུས་མ་ཚོས་ཀྱང་བརྩི་སྲུང་བྱེད་པའི་གནས་ལུགས་ཤིག་ཡིན་ན།",
    "ཟུང་ཟླ་བའི་སེམས་ལ་རང་ཉིད་ནི་མི་དཀྱུས་མ་ལས་འཕགས་པར་བསམ་གྱིན་ཡོད།",
    "གཙང་འགྲམ་དུ་ཆུ་འདྲེན་འཁོར་ལོ་ཞིག་གནའ་གྲོང་།",
    "གཙང་བོའི་འབབ་སྒྲ་གཉོམ་ཞིང་ལྷིང་འཇགས་ལྡན།",
    "གཙང་བོའི་འབབ་སྒྲ་མཐོ་ཞིང་ངར་སྐད་ཀྱིས་ཁྱབ།",
    "པས་ཟུང་ཟླ་བ་རྐུབ་སྟེགས་ཤིག་ཏུ་བསྡད།",
    "ཨ་སྟག་སྔར་ལས་ཀྱང་ཁ་སྐྱེངས་ནས་ཅི་བྱེད་འདི་བྱེད་མི་ཤེས་པར་མགོ་བོ་དང་གར་སྨད།",
    "བཟོད་པ་ངོ་ལུག་ཀྱང་ཅུང་ཟད་ཁ་སྐྱེངས་པར་གྱུར་ནས་ལག་པས་མགོ་བོར་འཕྲུག་འཕྲུག་བྱེད།",
    "སྔོན་ལ་ངེས་པར་དེའི་སྐོར་ཐག་གཅད་དགོས།",
    "ངེད་གཉིས་ཀྱིས་མཉམ་འབྲེལ་བྱས་ཏེ།",
    "ཟུང་ཟླ་བས་དེ་འདྲའི་དོ་སྣང་མ་བྱས་པས།",
    "ཨ་སྟག་ཅུང་ཟད་ཡིད་མ་ཚིམས་པར།",
    "ཧེ་ཧེ་ཟུང་ཟླ་བ་ཁོང་དགོད་ཅིག་བྱས།",
    "གལ་སྲིད་གཙང་ཆུའི་འགྲམ་དུ་ཆུ་འདྲེན་འཁོར་ལོ་མེད་ན།",
    "བཟོད་པ་ངོ་ལུག་ཡིད་འགུལ་ཐེབས་ནས་དེ་ལྟར་སྨྲས་པར།",
    "ངས་ཉི་རྩེ་མ་ཤར་གོང་ནས་བཟུང་བྱི་དོར་བྱས་པ་ཡིན།",
    "ད་ནི་ངེས་པར་བསྒྲུབ་དགོས་པའི་ཤིང་ཆའི་ཐོག་གླད་པ་འགུལ་གྱིན་ཡོད།",
    "བཟོད་པ་ངོ་ལུག་དང་ཨ་སྟག་གཉིས་ཚིག་རྩོད་རྒྱུག་ཁོམ་མེད་པར་མ་ཟད།",
    "ལགས་སོ།",
    "དེ་ནས་བྱིས་པ་ཚོའི་རྗེས་སུ་ལག་གཡུག་བྱས་ཏེ་ཁོ་ཚོ་སྐྲག་མི་དགོས་པའི་བརྡ་བསྟན།",
    "ཆུ་འདྲེན་འཁོར་ལོ་དེ་གཙང་ཆུའི་འགྲམ་དུ་འཛུགས་ཆོག་མིན།",
    "ཁོས་དེ་ལྟར་སེམས་ཐག་གཅོད་རྒྱུ་ནི་ལས་སླ་བོ་ཞིག་གཏན་ནས་མིན་པར།",
    "འོན་ཀྱང་ཟུང་ཟླ་བ་ཞག་གང་བོར་ཕར་འཁོར་ཚུར་ལོག་བྱས་པས།",
    "ཁོ་ཐེམ་ཞིང་གོང་མ་ནས་ཞོལ་མའི་ཐོག་ཏུ་འབབ་དུས་གཙང་ཆུ་དང་བར་ཐག་ཇེ་ཉེ་ནས་ཇེ་ཉེར་འགྲོ་བ་གནའ་གྲོང་།",
    "ད་གཟོད་དམིགས་ཡུལ་དུ་སླེབ་ཐུབ་པར་ཁོས་ནམ་ཡང་ཡིད་ཆེས་བྱེད་ཀྱིན་ཡོད།",
    "གནའ་གྲོང་ང་ལ་རི་མགོ་ནས་མར་བལྟས་པ་དང་གཙང་འགྲམ་ནས་ཡར་བལྟས་པ་གཉིས་ཐ་དད་དུ་སྣང་སྟེ།",
    "གཙང་ཆུའི་འགྲམ་ནས་ཡར་བལྟས་ན།",
    "ད་སོ་མ་གཙང་བོའི་འགྲམ་དུ་བསླེབས་པ་ཡིན་ཚེ།",
    "གནའ་གྲོང་དུ་མི་བསྡད་ཡོད་པར་མ་ཟད།",
    "ཁོས་ཟུང་ཟླ་བ་ནང་དུ་བསླེབས་པ་མཐོང་མ་ཐག་ཚ་ཐབ་ཐོག་ནས་འགུལ་ཙམ་བྱས་ཏེ་ཡ།",
    "ཟུང་ཟླ་བ་གོ་ཁར་ཡུན་རིང་ལ་འགྲེང་བསྡད་པས།",
    "ཁོས་སྨ་ར་བྱིལ་བྱིལ་ཞིག་བྱས་རྗེས།",
    "ཁོས་བཟོད་བསྲན་བྱས།",
    "དེ་འདྲ་མིན་ནམ་ཞེས་དྲིས་པར།",
    "དེ་བས་རྒྱལ་ཁབ་ཀྱི་དཔྱ་ཁྲལ་ཡང་ལོ་ཁ་ཤས་ལ་འཇལ་མ་ནུས་པར་ལུས།"
  ]
