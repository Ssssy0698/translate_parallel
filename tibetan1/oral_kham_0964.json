    "མི་རུང་བ་ལ་འདུག་གམ་ཉལ་བ་སྟེ།",
    "དེ་སྟེ་མི་རུང་ན་འདི་ཉིད་ན་འདུག་གོ་སྙམ་བསམས་ནས་དེས་དེ་ལྟར་གྱུར་པ་ནས།",
    "འདོད་ཆགས་ཀྱིས་ཀུན་དུ་གཟིར་བའི་དགེ་སློང་ཞིག་དེའི་མདུན་ན་འདུག་པས་ཕོ་མཚན་དེའི་ཁར་བཅུག་ནས་དེས་ིལུས་བཏུད་དེ་ཁུ་བ་ཕྱུང་ནས་དགེ་སློང་དེ་བདག་ལ་ཕས་ཕམ་པའི་ཉེས་པ་མ་བྱུང་གྲང་ཞེས་ཐེ་ཚོམ་སྐྱེས་པ་དང་།",
    "དེས་དེའི་ནང་དུ་གཞུག་ཅེས་རྨ་ཁར་བཙུགས་པ་དང་དེའི་ནང་སྲིན་བུས་གང་ཞིང་འདུག་སྟེ།",
    "དེས་དེའི་ནང་དུ་གཞུག་ཅེས་རྨ་ཁར་བཙུགས་པ་དང་དེ་ཡང་ལངས་ཏེ་འདུག་ནས་དགེ་སློང་དེ་འཇིགས་པར་གྱུར་ཏེ།",
    "ཁྱིམ་བདག་དེས་ཤ་སྣག་གུ་དེ་དགེ་སློང་དེའི་ལྷུང་བཟེད་ན་འདུག་པ་མཐོང་བ་དང་།",
    "བླ་གབ་མེད་པར་གཅིག་པུ་འཕྲེས་ཏེ་མ་འདུག་ཤིག།",
    "འདུག་ན་ཉེས་བྱས་སུ་འགྱུར་རོ།",
    "དེ་ལངས་ཏེ་འདུག་ནས།",
    "༡༢ཤིང་དྲུང་དུ་འདུག་པ་དང་།",
    "༥༧༤ སྣར་ཞོལ་འདུག་སྣར་ཞོལ་བཙུན་པ་དགེ་སློང་ཉེས་བྱས་སོ།",
    "༦༨༢གཡུང་པེ་འཇུག་ལི་ཅོ་འདུག་གཡུང་ཐུན་ལ།",
    "༣སྣར་ཞོལ་མི་སྣང་བར་འདུག་པ་ལ་ཕྱག་མི་བྱའོ།",
    "དེས་ན་སྒྱུ་མ་ལྟ་བུའི་ལུས་རང་བཞིན་མེད་པ་ལ་ཆགས་པར་མི་རིགས་པར་བསྟན་ཚུལ་དེས་གང་ཟག་ཀྱང་རང་བཞིན་གྱིས་མ་གྲུབ་པར་བསྟན་པའོ།",
    "ཕྱོགས་ཀྱི་ཆར་དབྱེ་བ་དེ་ཡང་རང་བཞིན་གྱིས་གྲུབ་པ་མེད་དེ་རང་བཞིན་གྱིས་གྲུབ་པའི་ཆ་ཤས་དང་བྲལ་བའི་ཕྱིར་ནམ་མཁའ་བཞིན་དུ་ཅིར་ཡང་མ་གྲུབ་པ་དེས་ན།",
    "ཚོར་བ་པོ་འགའ་ཡང་རང་བཞིན་གྱིས་ཡོད་པ་མིན་ཏེ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་འདས་པ་ཡིན་པར་བརྗོད་ལ།",
    "དངུལ་ཆད་སྒོར་ཉིས་ཁྲི་མན་བཅད་ཆོག་དུས་བཀག་ལས་བརྒལ་རུང་བཤིག་མེད་ན།",
    "མཐོ་ལ་བཙན་པ་ཞིག་འདུག་པས།",
    "དོགས་པ་མེད་པ་ཁོ་ནར་བག་ཡངས་སུ་འདུག་པ་མི་རིགས་པས་དེའི་དོན་ཀློང་དུ་ཆུབ་པར་མཛོད་ཅིག་ཅེས་བརྗོད་ཀྱང་།",
    "སྦྱར་ར་བློ་གྲོས་རྒྱལ་པོ་བཅས་ཁྱིམ་སོ་སོར་དམག་མི་སུམ་བརྒྱ་ཙམ་གྱིས་བསྐོར་ཏེ་བཟང་བཙོན་དུ་བཞག་དུས་དེར་མངའ་རིས་སྐོར་གསུམ་གྱི་དམག་དང་།",
    "འཁོན་དུ་བཟུང་འདུག་པར་བརྟེན།",
    "ཨམ་བན་གཉིས་ཀྱི་བསམ་པར་དབུས་གཙང་ལ་ཉིན་གཅིག་ཀྱང་འགོ་པ་བྱེད་པའི་མི་མེད་ན་མི་རུང་བསམས་འདུག་ཀྱང་པཎྜི་ཏ་ནས་འཕྲལ་དུ་དམག་དཔུང་ཁྲིད་ནས་ཕན་གྲོགས་བྱེད་ཡོང་བསམས་ནས་སྟབས་གཅིག་ཏུ་གང་འོས་པ་དབྱེ་འབྱེད་བྱེད་ཆུག་སྙམ་དུ་ལབ་འདུག་པཎྜི་ཏ་ནས་ངེས་པར་བསམ་ཚོད་དང་མཐུན་པར་ངོ་ལོག་མི་རྣམས་ཚར་བཅད་ནས་གསོད་པ་དང་།",
    "འགྱུར་མེད་ཚེ་བརྟན་སྔར་ནས་ངོ་ལོག་པ་མེད་ཅིང་ཉེས་མེད་དུ་བསད་འདུག་པས་ངེས་པར་དག་ཚངས་བྱེད་འོས་སུ་འདུག་པཎྜི་ཏར་གཏད་ནས་འགྱུར་མེད་ཚེ་བརྟན་གྱི་བུ་བརྩད་བཅད་ནས་ངེད་ཀྱི་བཀའ་ཕབ་སྟེ།",
    "བར་གཞི་ཞལ་ངོ་བར་གཞི་བ་ཞེས་པའི་ཉེ་འགྲམ་དུ་སྔར་ཆིབས་རྭ་ཞིག་ཡོད་པ་ཕྱིས་ཞོལ་ཆིབས་རྭར་ཟླ་བསྒྲིལ་བཏང་ཡང་ཆིབས་རྭ་ཞལ་ངོའི་སྔར་མིང་རང་འཇགས་ཐོགས་པ་",
    "ལས་བྱ་རྩེ་དྲུང་ཁ་ཤས་བཅས་ཡོད་འདུག་ཀྱང་།",
    "དངོས་གཞིའི་ཆེ་འདོན་མཇལ་བཅར་སྐབས་རང་རང་གོ་བབས་ལ་གཞིགས་པའི་ཐོབ་བཟོས་གོ་རིམ་བཞིན་སྩོལ་དགོས།",
    "ངོ་འདོན་མིན་པ་འདོན་བརྒྱ་ལྷག་ཡོད་པ་རྣམས་མི་དྲག་ཁོངས་བརྩི་སྲོལ་ཞེས་གསུང་རྒྱུན་འདུག་ཕྱིས་ཆེ་བཙན་ཁག་ལ་གཞུང་ཁོངས་ནས་གཞིས་ཀ་ཞུས་སྤྲད་ཀྱིས་ཚོད་པ་མང་བས།",
    "པཱ་ཀྲུང་རང་གནོང་འགྱོད་པས་མ་བཞག་པར་རང་སྲོག་ལྕེབས།",
    "ཁོང་རང་ཉིད་ནས་གོང་མ་ཆེན་པོའི་སྐུ་ཚབ་བོད་བཞུགས་སུང་ཀུའེ་ཨམ་བན་དང་།",
    "རང་ཁོངས་ས་གནས་ཁག་ནས་འདི་གྲས་འགྲོ་འདུག་བཏང་ཤོར་ལྟ་བཞག་ཡིག་འགྲུལ་ཙམ་ཡང་གཏོང་ལེན་མི་ཆོག་པའི་དམ་དྲག་ཞུ་མུས་དེ་ལྟར་ཡིན་ན།",
    "སྣ་དཀར་རྩེ་སོགས་དམག་འཐབ་ཀྱི་འགག་རྩ་ས་གནས་ཁག་ལ་ས་སྲུང་དུ་བཞག་དུས་དེར་ཆུ་མིག་གཤོངས་ཀོ་ནས་ཕྱིར་འཐེན་བྱས་པའི་དམག་མི་ལྷག་འཕྲོས་སུམ་བརྒྱ་བཅུ་ཙམ་ལས་མེད་ཀྱང་རྒྱབ་ཕྱོགས་ཀྱི་དཔུང་རོགས་ཁག་གཅིག་རིམ་བཞིན་འབྱོར་ཏེ་དམག་གྲངས་ཉིས་སྟོང་སུམ་བརྒྱ་སྐོར་ཡོད་པ་ཞིབ་བཤེར་དང་འབྲེལ་རྫས་མདེལ་དམག་རྒྱགས་སོགས་ལ་ལེགས་སྒྲིག་འོས་མཚམས་བྱས་ཐོག་གཙང་མདའ་བཀྲས་གླིང་པ་དང་།",
    "དམག་ཕོགས་ཧམ་ཟ་སོགས་བྱ་བ་ངན་པ་ཇི་སྙེད་པ་བྱས་འདུག་པས་ཁོང་ཁྲོ་ཆེན་པོ་ལངས་ཤིང་།",
    "དེ་ནས་བོད་ཀྱི་ས་མཚམས་བརྒྱུད་ནུབ་རི་དམར་ཚུན་བཅས་ཞིབ་པ་བར་སྐབས་བོད་ཀྱི་ས་ཆ་རྒྱ་ཕྱོགས་ནས་རིམ་ཟོས་ལ་ཞིས་ཁང་ཞེས་མིང་གསར་བཏགས་ཡོད་འདུག་པ་དེའི་ཁོངས་འཁོད་ཀྱི་ས་དང་།",
    "དཔོན་རིགས་རྡོ་རྗེ་གཡིབ་སོགས་ཀྱི་དབྱེན་སྦྱོར་དཀྲུགས་ཤིང་ལ་བརྟེན་ནས་བྱུང་འདུག་གོང་ཞུས་ལྟར།",
    "གོང་གསལ་དཔྱད་མཚམས་བྱུང་རུང་ལྷ་སར་རྒྱ་ནག་དཔོན་པོ་ཆེ་བ་གཅིག་བཞག་སྲོལ་འདུག་པར་སྐུ་སྲུང་བབ་མཚུངས་དང་བཅས་པ་སུམ་བརྒྱ་ལས་ལྷག་པ་གཏན་ནས་བཞག་མི་ཆོག་པ་བྱས་ཡོད།",
