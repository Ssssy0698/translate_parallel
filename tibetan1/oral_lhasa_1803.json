    "དེ་ཉིད་བཏུང་བར་བྱ་བ་སྟེ་འོད་གསལ་དུ་བཅུག་པར་བྱའོ།",
    "རགས་པ་ཉི་ཤུ་མ་ལྷ་རིམ་གྱིས་ཐིམ་པའི་སྒོ་ནས་འོད་གསལ་དུ་འཇུག་ཚུལ་གསུངས་པའི་ཆོ་ག་བཞིན་དུའོ།",
    "ཆེན་པོའི་གོ་འཕང་ཐོབ་པར་འདོད་པས་སོ།",
    "རང་བཞིན་བརྒྱ་དྲུག་ཅུའི་རྟོག་པ་སྣང་མཆེད་ཐོབ་གསུམ་དང་བཅས་པ་ཐམས་ཅད་རང་བཞིན་གྱིས་འོད་གསལ་བའི་ངོ་བོར་བྱས་ཏེ།",
    "ཁམས་ཀྱི་སྐད་དོད་དྷ་ཏུ་ཞེས་པ་ལ་དྷ་ར་ཞེས་བྱས་ན་འཛིན་མཁས་གྲུབ་རྗེའི་གསུང་འབུམ།",
    "འགྲེལ་པས་དེ་ནས་ཞེས་པ་འབྲུ་བསྣན་པ་ལྟར་བྱས་ན།",
    "དུང་ཅན་མའི་རིགས་ཀྱི་དབྱེ་བས་མཉམ་པར་སྦྱར་བས་རབ་ཏུ་བསྒོམ་སྟེ།",
    "སྡུག་བསྔལ་སྤྱོད་པ་ཞེས་པར་འགྱུར་ཞིང་།",
    "ཐ་དད་དུ་ཞེས་པས་མི་འགྲུབ་པར་བསྟན་རྒྱུད་ཀྱི་ཟིན་བྲིས།",
    "ལེའུ་བདུན་པར་གསུངས་པའི་སྤྱོད་པ་ལ་གནས་པའི་སྒྲུབ་པ་པོས།",
    "ཞེས་བསྟན་པའི་ཕྱིར་དུ་ལེའུ་བརྒྱད་པ་འདི་གསུངས་སོ།",
    "དོན་དམ་པའི་བདེན་པས་རྣམ་པར་དག་པར་བྱས་པའི་སྤྱོད་པ་དེས།",
    "དེ་ཐོབ་པར་བྱེད་པའི་ལམ་ནི་རྒྱུད་ཀྱི་ཟིན་བྲིས།",
    "རིན་ཆེན་ནི་ཀུན་རྫོབ་བདེན་པ་སྟེ་དེ་གཉིས་ཟུང་དུ་འཇུག་པའི་ཚུལ་གྱིས་འཛིན་པར་མཛད་པའོ།",
    "ས་བརྟག་བླང་སྦྱང་བ་ལ་སོགས་པའི་སྒོ་ནས་ས་ཕྱོགས་གཙང་ཞིང་འདུ་འཛིས་རྣམ་པར་དབེན་པའམ།",
    "ཆུ་གཙང་མ་དང་དྲི་བཟང་ལ་སོགས་པས་བྱུགས་པ་དང་།",
    "རིགས་ལྔ་རྣམས་ནི་དགོད་པར་རབ་ཏུ་བྱའོ།",
    "གང་བྱས་ཀྱང་ཆོག་པའི་གདམ་ང་ཅན་ཡིན་གྱི་འགལ་བ་མ་ཡིན་ནོ།",
    "རྒྱལ་བ་རྣམ་པར་སྣང་མཛད་སོགས་ཀྱི་སྲས་ཏེ་རིགས་སྤྱན་མ་སོགས་སོ།",
    "གང་ལ་དགོད་པར་བྱ་ན།",
    "རང་དང་ཕྱག་རྒྱའི་ལུས་ལ་དགོད་པར་བྱ་ཞིང་།",
    "རྡོ་རྗེ་སྟེ་དེ་བརྟན་པར་གྱུར་པ་འཛིན་པའི་སྒྲུབ་པ་པོས་ཐུན་མཚམས་བྱ་བར་འདོད་ན།",
    "མཁས་པས་ཨུཏྤལ་སྔོ་དཀར་དམར་སེར་ལྗང་ཁུ་སྟེ་རྣམ་པ་ལྔར་ཤེས་པར་བྱས་ནས།",
    "སོགས་ལ་ཁ་དོག་དང་མཐུན་པར་རིམ་པ་བཞིན་དུ་དབུལ་བར་བྱའོ།",
    "པདྨ་ལ་ཡང་རྣམ་པ་སྔར་ཤེས་པར་བྱས་ནས།",
    "རིགས་ལྔ་ལ་ཁ་དོག་དང་མཐུན་པར་དབུལ་བར་བྱའོ།",
    "སྔོ་དཀར་དམར་གསུམ་དུ་ཤེས་པར་བྱས་ནས།",
    "ཁ་དོག་དང་མཐུན་པར་རྡོ་རྗེ་གསུམ་གྱི་ལྷ་རྣམས་ལ་ནི་དབུལ་༧༡ན་བར་བྱའོ།",
    "ལྷ་མཚན་འགོད་པ་ལ་རྣམ་པར་མཁས་པས་བརྟག་པར་ནི་ཤར་དུ་མི་བསྐྱོད་པ།",
    "རིགས་ལྔའི་རིགས་ཀྱི་ལྷ་རྣམས་རབ་ཏུ་དགོད་པར་བྱའོ།",
    "དེ་བཞིན་དུ་པདྨ་སྟེ་འོད་དཔག་མེད་ཀྱིས་གཙོ་བོ་བྱས་པའི་དཀྱིལ་འཁོར་དང་།",
    "ས་ཕྱོགས་གཙང་ཞིང་རྣམ་པར་དབེན་པའམ།",
    "བདག་པོའི་ཕྱག་རྒྱར་མཉམ་པར་འཇོག་ཚུལ་ཇི་ལྟ་བུ་ཞེ་ན།",
    "ལུས་ལ་རིགས་ལྔ་དགོད་པ་སོགས་ཀྱི་སྒོ་ནས་བྱིན་གྱིས་བརླབས་ཀྱི་གནས་བསམས་ཏེ་སྙོམས་པར་ཞུགས་པ་ལ་བརྟེན་ནས་སྟོང་པ་གསུམ་རིམ་གྱིས་ཐིམ་པའི་ཐམས་ཅད་སྟོང་པ་འོད་གསལ།",
    "དུང་ཕོར་སོགས་ཀྱི་སྣོད་དུ་བཞག་ནས་སྦྱངས་རྟོགས་སྦར་གསུམ་བྱས།",
    "སྔགས་རྣམས་ཀྱི་དངོས་གྲུབ་བསྐྱེད་པར་བྱེད་པར་གསུངས་སོ།",
    "ཞེས་བསྟན་པའི་ཕྱིར་དུ་ལེའུ་དགུ་པ་འདི་གསུངས་སོ།",
    "མངོན་བྱང་ལྔ་ལས་རྡོ་རྗེ་འཆང་དུ་བསྐྱེད་དེ་སེམས་དཔའ་སུམ་བརྩེགས་སོགས་བྱས་པའོ།",
    "དངོས་གྲུབ་ཐོབ་པར་འགྱུར་ཞིང་།",
    "དེ་ལྟར་བྱས་པའི་ཕན་ཡོན་མཇུག་སྡུད་དང་བཅས་པའོ།",
    "རྣམ་པར་སྣང་མཛད་རབ་བསྒོམ་སྟེ།",
    "དེ་ལྟར་བྱས་ན་གནས་སྐབས་སུ།",
    "དེ་ལྟར་བྱས་པའི་ཕན་ཡོན་མཇུག་སྡུད་དང་བཅས་པའོ།",
    "དེ་ལྟར་བྱས་པའི་རྒྱུད་ཀྱི་ཟིན་བྲིས།",
    "བསྟེན་ཅིང་མཉེས་པར་བྱེད་པའོ།",
    "དེ་ལྟར་བྱས་ན་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཐོབ་པར་འགྱུར་རོ།",
    "ནམ་མཁའི་དབྱིངས་ཀྱི་དབུས་གནས་པར་ཞེས་པ་དང་དཔེའི་འོད་གསལ་ལོ།",
    "དེའི་ལག་པ་ན་འོད་གསལ་དེ་ལེན་པར་བྱེད་པའི་ཉེར་ཐོབ་བོ།",
    "གང་འོད་གསལ་དུ་གཞུག་པར་བྱ་རྒྱུའི་མ་དག་པའི་སྒྱུ་ལུས་པའི་ཕུང་ཁམས་རྣམས་སོ།",
    "ནམ་མཁའི་དབྱིངས་ཀྱི་དབུས་གནས་པར་ཞེས་པ།",
    "གང་འོད་གསལ་དུ་གཞུག་པར་བྱ་རྒྱུའི་མ་དག་པའི་སྒྱུ་ལུས་པའི་ཕུང་ཁམས་རྣམས་སོ།",
    "རྡོ་རྗེའི་གཟུགས་དག་པའི་སྒྱུ་མའི་སྐུ་ནི་རབ་ཏུ་བརྟག་ཅིང་བསྐྱེད་པར་བྱའོ།",
    "ནམ་མཁའི་དབྱིངས་ཀྱི་དབུས་གནས་པར།",
    "ཟུང་འཇུག་ལ་རྟག་ཏུ་མཉམ་པར་བཞག་པའོ།",
    "ནམ་མཁའི་དབྱིངས་ཀྱི་དབུས་གནས་པར།",
    "བསྟན་ན་ཡེ་ཤེས་ཐོབ་པར་འགྱུར།",
    "བདེན་པར་གྲུབ་པས་སྟོང་པའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་གཟུགས་ཀྱི་ཁམས་ན་མི་གནས་ཏེ་དེའི་ཕྱིར་རོ།",
    "དོན་དམ་པར་གཟུགས་མེད་པའི་ཁམས་ན་མི་གནས་ཏེ་དེའི་ཕྱིར་རོ།",
    "དེ་བཞིན་གཤེགས་པ་རྣམས་ནི་བདེན་པར་གྲུབ་པས་སྟོང་པ་དང་།",
    "འདིས་སྔགས་ཀྱི་སྤྱོད་པ་སྤྱད་པས་བདེན་པར་གྲུབ་པས་སྟོང་པ་དང་དབྱེར་མེད་པའི་སྒོ་ནས་འོད་གསལ་དུ་འཇུག་པའི་ཕྱིར་མཆོག་ཏུ་སྒྲུབ་བོ།",
    "དམ་ཚིག་ནི་སྣང་བ་མཆེད་པ་རྗེས་སུ་རིག་པར་བྱ་བ་ནི་སྣང་བའི་ཡེ་ཤེས་སོ།",
    "ལུགས་ལྡོག་ཏུ་འོང་བ་ལ་སོགས་པར་དམིགས་ཀྱང་།",
    "རྡོ་རྗེའི་སྐུ་སྒྲུབ་པའི་ཆེད་དུ་ཡིན་པས་སྔགས་ཀྱི་སྤྱོད་པ་མཆོག་ཏུ་གྲུབ་པར་བསྟན་ཏོ།",
    "ངེས་དོན་གྱི་ལུང་དང་བྲལ་བའི་རྟོག་གེ་པ་རྣམས་ཀྱིས་རྟོགས་མི་ནུས་པས་ན་རྣམ་པར་མི་རྟོག་པའོ།",
    "བཞི་པ་ནི་འགྲེལ་པར་རོ།",
    "ཞེས་ཤེས་པར་བྱ་བའི་ཕྱིར་དུ་ལེའུ་བཅུ་པ་འདི་གསུངས་སོ།",
    "དབྱེར་མི་ཕྱེད་པར་བསྒོམ་ཚུལ་གྱི་ཁྱད་པར་ཇི་ལྟ་བུ་ཞེ་ན།",
    "ལུས་ངག་ཡིད་གསུམ་རང་བཞིན་གྱིས་ཐ་དད་པར་རྣམ་པར་མི་རྟོག་ཅིང་།",
    "རང་བཞིན་གྱིས་ཕན་ཚུན་རྟེན་དང་བརྟེན་པར་མི་དམིགས་པ།",
    "ཟད་པར་མི་འགྱུར་བས་ན་རྡོ་རྗེ་སྟེ་དེ་སྐད་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགས་ནས་འཁོར་གྱི་དེ་བཞིན་གཤེགས་པ་ཞེས་པ་ནས།",
    "ཞལ་ནས་ཀྱང་ཨཱ་ཞེས་ངེས་པར་བརྗོད་པ་དང་།",
    "ཞལ་ནས་ཀྱང་ཧཱུཾ་ཞེས་ངེས་པར་བརྗོད་པས་སྔགས་ཐམས་ཅད་བསྡུས་པ་འདི་ལྟ་བུ་གསུངས་སོ།",
    "བརྒྱལ་བ་སྟེ་དགའ་བ་རྒྱ་ཆེན་པོ་ཐོབ་པར་གྱུར་ནས།",
    "དེ་ནས་ཕྱག་ན་རྡོ་རྗེ་སྟེ་རྡོ་རྗེ་འཆང་ཆེན་པོ་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་བདག་པོས་སྒྲུབ་པ་པོ་རྣམས་ལ་ལྷ་རྣམས་ཀྱི་སྤྱན་རས་ཀྱིས་འཚོ་བ་ལས་མི་འདའ་བའི་དམ་ཚིག་འདི་གསུངས་སོ།",
    "༨བ་དབྱིངས་ཞེས་པ་རྒྱས་པར་འཆད་པའོ།",
    "ཐུགས་བསྡུས་པ་སྟེ་འགུགས་པར་བྱེད་པའི་ཆོ་གའོ།",
    "དེས་ལྷ་ལྷག་མ་རྣམས་མངལ་དུ་བསྐྱེད་པར་ཡང་མཚོན་པར་བྱེད་དོ།",
    "རྒྱལ་བ་རྣམས་འབྱོན་པར་བསྐུལ་ཅིག་ཅེས་བསྒོས་པས།",
    "རྡོ་རྗེ་འཆང་གཅིག་ཉིད་བསྒྲུབ་པར་བྱ་བ་དང་།",
    "རྡོ་རྗེ་སྟེ་དེ་བཞིན་གཤེགས་པ་རྣམས་འདྲེན་པར་བྱེད་པའི་ཆོ་ག་ཡི་ནི་ཚུལ་མཆོག་འདི་ཞག་བདུན་བར་དུ་བྱས་ན་ནི་ཞེས་པའོ།",
