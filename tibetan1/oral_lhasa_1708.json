    "ཡང་ན་ཀུན་གྱིས་རྣམ་པར་སྤངས།",
    "དགའ་བ་གསུམ་པོ་རྣམ་པར་སྤངས།",
    "ཉལ་དང་ལོག་པའི་ཁྱད་པར་ལས་ཏེ།",
    "རྟགས་རབ་མཉམ་རྗེས་མེད་པར་དངོས་པོ་ཐམས་ཅད་རྨི་ལམ་གྱི་སྣང་བ་བཞིན་དུ་གསལ་ལ་མ་ཞེན་པའི་རྟོགས་པ་རྒྱུད་ལ་སྐྱེ་བའོ།",
    "རྟེན་ལས་ཀྱི་ཕྱག་རྒྱ་ལ་མི་བརྟེན་པར་འབྲས་བུ་མཐར་ཐུག་ས་བཅུ་གསུམ་པ་རྟོགས་པ་མེད་པར་བཞེད་དོ།",
    "བུམ་པ་བརྒྱད་ལ་སོགས་པར་ལྡན།",
    "རྣམ་པར་རྒྱལ་བའི་བུམ་པ་དང་།",
    "སྦོམས་སུ་སྒོའི་ཉི་ཤུ་ཆར་བྱས་པའོ།",
    "སྔོན་དུ་སྲུང་བའི་འཁོར་ལོ་ཇི་ལྟར་བཅིང་པ་ལ་སོགས་པ་གཞན་ནས་གསུངས་པ་བཞིན་འདིར་ཡང་བྱ་ཞེས་བྱའོ།",
    "ཞེས་པ་གུར་ལས་གསུངས་པ་བཞིན།",
    "བསྙེན་པར་གསོལ་བ་གདབ་པ་དང་།",
    "རྡོ་རྗེ་སེམས་དཔའ་སྙེམས་བྱས་ནས།",
    "ཁྲུས་བྱས་དྲི་ཞིམ་པོས་ལུས་ལ་བྱུགས།",
    "རྣལ་འབྱོར་པས་ལམ་དུ་བྱས་པའི་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་དང་།",
    "ཁྱད་པར་ཅུང་ཟད་ཡོད་མ་ཡིན།"
  ]
}