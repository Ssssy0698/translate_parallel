    "གུང་དམག་ཁྲོད་ནས་བྲོས་བྱོལ་ཡོང་ཚུལ་སོགས་སྙན་སྙན་མང་དུ་ཤོད་ཀྱི་འདུག་ཁར།",
    "བྷི་རན་ཀན་སོགས་བཙུགས་ཏེ་སྒུག་ར་རིམ་པ་དགུ་ཙམ་བྱས་ནས་བསྒུགས་བསྡད་ཡོད་འདུག་ཀྱང་།",
    "དེ་ནས་རང་དམག་རྣམས་མེ་མདའི་ཁར་ཐེ་ཚོམ་མེད་པར་མཆོངས་ཏེ་རྒྱ་དམག་ཁ་ཤས་འདུག་པ་ཚང་མ་ཐུང་མདས་བསད།",
    "དེ་ནས་བློ་བཟང་བཀྲིས་ཀྱིས་ཅ་ན་ཏའི་མདེའུ་བརྒྱད་ཆགས་ཅིག་བརྒྱབ་ནས་བལྟས་པས་དམག་དཔོན་དེའི་ལག་ནས་མེ་མདའ་ཤོར་འདུག་པར།",
    "བློ་བཀྲ་ཡང་དེར་ཡོང་ནས་བལྟས་པས་དམག་དཔོན་དེའི་ཁ་ནས་ཁྲག་རྒྱུན་འཛག་སྟེ་ཤི་ལ་ཁད་དུ་འདུག་པར།",
    "འཁོར་ལོ་ཡོད་སའི་གྱང་གོག་ཏུ་རྒྱ་དམག་ཁ་ཤས་འདུག་པ་གཉིས་བསད།",
    "གཅིག་ཕར་ཙམ་བྲོས་ནས་ཚུར་མེ་མདའ་ཞིག་བརྒྱབ་བྱུང་བར་བརྒྱ་དཔོན་རྡོ་དགའ་རྨས་སྐྱོན་ཤོར།",
    "རྒྱ་བློ་བཀྲ་སོགས་ཀྱི་འཐབ་སའི་རྒྱབ་ཕྱོགས་སུ་རྒྱ་དམག་ཁག་གཅིག་ཡིབས་འདུག་པར་མཐོང་།",
    "དེར་གཞུང་སྒོ་བརྒྱབ་ནས་འདུག་ཅིང་གང་འཚམས་ཤིག་ནས་གྲྭ་གཟུགས་ཤིག་དང་།",
    "དངོས་རིགས་གང་འཚམ་ཤིག་ལུས་འདུག་པ་རྣམས་བླངས་ཤིང་།",
    "ཕྱོགས་དེར་བསྐྱོད་པས་རྒྱ་དམག་རྣམས་བྲོས་ཟིན་འདུག་པའི་ཤུལ།",
    "ལམ་བར་དམག་དམངས་ཁྲོད་ནས་ལམ་ཞོར་ཉ་མགོ་གྲུ་ཁར་རྒྱ་དམག་ཡོད་འདུག་པ་རྣམས་བཅོམ་དགོས་པའི་བསམ་འཆར་བཏོན་པར།",
    "དམག་འཁྲུག་དེའི་ནང་རང་ཕྱོགས་དམག་མི་བསྟན་དར་དང་།",
    "དེའི་ནང་ནས་ཚ་རོང་བརྒྱ་དཔོན་བྱམས་པ་རིན་ཆེན་གྱི་ཁ་དང་འགྲམ་པ་སོགས་རྨས་སྐྱོན་ཆེ་ཙམ་བྱུང་ཡང་རང་དམག་རྣམས་མདུན་དུ་ཤར་སྐྱོད་བྱས།",
    "རང་དམག་རྣམས་ཀྱིས་བྷི་རན་ཀན་ཁ་བསྒྲིགས་ཏེ་བརྒྱབ་པས་བརྒྱ་དམག་༧ སྐོར་བསད་རྨས་བཏང་རྗེས་ལམ་སེང་རང་དམག་རྣམས་ཕྱིར་འཐེན་བྱས་པས་རང་ཕྱོགས་ལ་སྐྱོན་ཆ་གང་ཡང་མ་བྱུང་ཞིང་།",
    "ས་སྣུམ་བླངས་ཏེ་ཁང་འོག་རྩ་ཕུང་འདུག་པར་གཏོར་ནས་མེ་སྦར་བས་ལམ་སང་ཚག་སྒྲ་དང་བཅས་ཁང་པ་བསྲེགས་པས་རྒྱ་དམག་འགའ་ཞིག་ཐོག་ཁར་དོན་བྱུང་བར་མེ་མདའ་བརྒྱབ་ནས་བསད།",
    "ད་དུང་ཞིང་ཁའི་ནང་རྒྱ་དམག་འདུག་པའི་ཐོག་ཚང་མས་ཀི་སྒྲ་དང་བཅས་གྲི་འཕྱར་ནས་མཆོངས་པས།",
    "ཁས་ལེན་པ་རྣམས་ཁང་པའི་འཁྲིས་སུ་སླེབས་ནས་རྩིག་པར་གཞབ་བསྡད་པའི་སྐབས་ཐོག་ཁ་ནས་ལག་འབོམ་གསུམ་གཡུགས་བྱུང་ཡང་ལམ་སེང་རང་སར་ཉལ་ནས་བསྡད་པས་སྐྱོན་མ་བྱུང་།",
    "གོ་ལག་གྲངས་༣ སྐོར་ཐོབ་སྟེ་ཐེངས་འདིའི་དགྲ་འཐབ་ནང་རང་ཕྱོགས་ལ་རྒྱལ་ཁ་རླབས་ཆེན་ཐོབ།",
    "མེ་མདའ་ཆིལ་ཆིལ་འདུག་ཀྱང་མེ་མདའ་རྣམས་བསྡུ་མ་ཐུབ་པར་དེ་མུར་ལུས།",
    "སྐྱེས་དམན་དང་མཉམ་དུ་བརྒྱབ་པའི་པར་བཅས་འདུག་པ་འཁྱེར་ཡོང་སྟེ་རྒྱ་བློ་བཀྲ་ལ་བསྟན་པས།",
    "དེར་སྤོ་ཐོ་བརྩེགས་པའི་ཁང་པ་ཞིག་ཏུ་ས་སྲུང་རྒྱ་དམག་སུམ་ཅུ་སྐོར་བསྡད་འདུག་པར།",
    "ཐེངས་འདིའི་དམག་འཁྲུག་ནང་རང་དམག་ལ་ཕམ་ཉེས་དེ་ཙམ་མ་བྱུང་བའི་ཐོག་རྒྱལ་ཁ་གང་འཚམ་ཐོབ།",
    "རི་རྩེར་འབྱོར་པ་ན་གྲང་ངར་ཆེ་བས་ལམ་དཀྱིལ་དུ་རྒྱ་དམག་ཁག་ཅིག་མེ་བཏང་ནས་བསྡད་འདུག་པ་མཐོང་།",
    "དེ་དག་ཏུ་རྒྱ་མིའི་ཟ་ཆས་མང་པོ་འཕངས་འདུག་པ་རྣམས་འཁྱེར།",
    "རྒྱ་དམག་ཚོས་ནམ་ཉིན་མེད་པར་དམག་གྲབས་ཀྱིས་རི་ཀླུང་ཀུན་ཏུ་འཐབ་ས་བཟུང་འདུག་པས་འདི་ནས་མར་བྱོན་ས་མི་འདུག་ཅེས་ཟེར།",
    "རྒྱ་དམག་འདུག་ཅེས་སྐད་འབོད་བྱས་བྱུང་བ་དང་།",
    "ལི་ཐང་བློ་བཟང་སོགས་ཁ་ཤས་ཆུ་འཚོལ་དུ་ཕྱིན་ནས་ཕུལ་བས་ཉུང་ཟད་ཅིག་བཞེས་ནས་སྐུ་ལུས་ཀྱི་རྨ་རྣམས་འཁྲུད་ཙམ་མཛད་དེ་ང་སྐྱོན་མི་འདུག་གསུངས།",
    "དེ་མིན་དམག་སྤྱི་རྣམས་དང་རང་དམག་ཁག་ཅིག་ལ་རྩེ་དེ་ལེན་པར་འཛེགས་ཏེ་རི་རྩེར་འབྱོར་བའི་སྐབས།",
    "དེ་འཕྲལ་རྒྱ་དམག་རྣམས་ཁག་གཉིས་སུ་གྱེས་ཏེ་ཅུས་ཀང་མང་དུ་འཕེན་བྱུང་ཡང་རང་ཕྱོགས་བསད་རྨས་གང་ཡང་མ་བྱུང་།",
    "དེ་ཉིན་རྒྱ་དམག་ཉིས་བརྒྱ་སྐོར་བསད་རྨས་བཏང་ཡོད་འདུག་དེ་ནས་རང་དམག་ཚོས་གོ་ལག་ལེན་འདོད་བྱུང་ཡང་།",
    "གོང་གསལ་དམག་འཐབ་སྔ་རྗེས་ནང་རང་དམག་མང་པོ་རྐྱེན་འདས་ཤོར་བ་སོགས་ལ་བརྟེན།",
    "སྐབས་དེར་མདའ་ཕོགས་རྒྱག་དུས་འགོ་དམག་སྡོམ་གྲངས་སུམ་བརྒྱ་ལྷག་ཙམ་ལས་མེད།",
    "ཁོ་རང་དང་ལག་དོ་གཉིས་བཅས་ཆུ་སྒང་དམག་ཁོངས་སུ་ཞུགས་པས་འགོ་དམག་ཚང་མས་དགའ་བསུ་སྣེ་ལེན་མཛད།",
    "དང་པོ་ཤིང་ནགས་ཀྱི་དཀྱིལ་དུ་རྒྱ་མིའི་ཕོགས་ཁང་ཞིག་འདུག་པར་རྒོལ་འཛིང་བྱས་ཏེ་ཕོགས་ཁང་དེ་བཅོམ།",
    "ནངས་པར་རྒྱའི་དམག་སྒར་ལྟེ་བའི་གནས་སྟངས་སོ་བལྟ་བྱས་པས་དམག་སྒར་གྱི་མཐར་ལྕགས་སྐུད་གཟེ་མ་ར་མགོས་བསྐོར་འདུག་ཚུལ་ཤེས་གསལ་བྱུང་ཡང་།",
    "འོན་ཀྱང་རང་དམག་ལྔ་བཅུ་སྐོར་ཡོད་པ་ཚང་མ་ཁ་འཐོར།",
    "སྤོ་སྟོད་གཡུ་རི་སྒང་ཟེར་བའི་ལ་རྩ་ཞིག་ཏུ་རྒྱ་དམག་ཉི་ཤུ་སྐོར་འདུག་པར་འཇབ་རྒོལ་བྱས་ཀྱང་བསད་རྨས་ཇི་བྱུང་ཤེས་ཚོར་མ་བྱུང་།",
    "སྐབས་དེར་མི་སེར་ཚོས་རྒྱ་མིའི་ལས་བྱེད་མི་ལྔ་འཇུ་བཟུང་བྱས་འདུག་པ་རྣམས་ལ་འདྲི་རྩད་བྱས་པས།",
    "བཀའ་ཤག་ནས་བཀའ་ལྟར་ཕེབས་དགོངས་སུ་ལའང་སྤྲད་མི་ཆོག་གསུངས་འདུག་རྐྱེན།",
    "རྒྱ་དམག་བསད་རྨས་བརྒྱ་དང་ལྔ་བཅུ་ཙམ་བྱུང་འདུག་རྒྱ་དཔོན་ཐིན་ཀྲང་།",
    "ལིན་ཀྲང་ཕེ་ཀྲང་བཅས་མང་པོ་བསད་པས་རང་རང་གོ་གནས་པཱ་སེ་དང་འདྲ་པར་མང་པོ་ལག་སོན་བྱུང་བ་མ་ཟད།",
    "རང་རང་འགོ་བའི་ལྷ་སྲུང་གཉན་པོ་རྣམས་དང་།",
    "རང་རང་འགོ་བའི་ལྷ་སྲུང་རྣམས་དང་།",
    "ཁྱད་པར་རང་རང་འགོ་བའི་བན་བོན་ལྷ་སྲུང་གཉན་པོ།",
    "ཁྱད་པར་རང་རང་འགོ་བའི་བན་བོན་ལྷ་སྲུང་གཉན་པོ།",
    "འཇར་མན་གྱི་མེ་མདའ་པཱ་མེ་ལིང་ཁག་ཅིག་བཅས་ཡོད་འདུག་པ་ཡོངས་རྫོངས་འདོན་ཁྱེར་བྱས་ཏེ།",
    "ཁོ་པ་ཚོ་མི་རྟ་ཧྲག་པོ་ཡོད་ལ་མཚོན་ཆ་ཡང་འདང་ངེས་ཡོད་སྟབས་ཁོ་པ་ཚོ་དང་ནང་དོན་འབྲེལ་བ་ཡོད་པའི་མི་ཉུང་ཤས་འདྲ་ཡོད་ན་མ་གཏོགས་དེ་བྱིངས་དྲག་ཞན་ཚང་མ་ཞེད་ཐག་ཆོད་ནས་བོད་དམག་སྟོང་ཕྲག་ཁ་ཤས་ཡོད་ཀྱང་དེ་ཚོ་གླག་སྙེད་པ་མི་འདུག་ཟེར་བ་དང་།",
    "ཟེར་འདུག་པ་མ་ཟད།",
    "ང་རང་བཅས་གྲོས་བསྡུར་བྱས་ཏེ།",
    "ཞེས་པའི་ཡི་གེ་ཞིག་ཤིང་བྱང་ཐོག་བཀོད་དེ་ཤིང་རྭའི་སྒོ་འཆོར་འོག་བཀལ་ན་དད་ལྡན་ཁག་ནས་གསེར་གྱི་ཞལ་འདེབས་འབུལ་ངེས་ཡིན་པའི་གྲོས་ཤིག་བཏོན་པར་ཐབས་ཤེས་ཡག་པོ་འདུག་ཅེས་གོང་གསལ་ནང་དོན་འཁོད་པའི་ཤིང་བྱང་བཀལ་བས།",
    "འདི་ཧ་ཅང་སྲབ་དྲག་འདུག་གསེར་མང་ཉུང་ག་འདྲ་འདུག་གམ།",
    "དབུ་ཆུང་ང་རང་ལ་ཁ་བཏགས་ཟུབ་ཕྱི་དང་།",
    "དབུ་ཆུང་ང་རང་ལ་ཁ་བཏགས་ཨ་ཤེ་དང་།",
    "འཕགས་པ་ལོ་ཀཱི་ཤྭ་རར་གསེར་སྲང་བརྒྱ་དང་ལྔ་བཅུ་ལས་གྲུབ་པའི་གསོལ་ལྷུང་གཅིག་བྱམས་པ་མཆེད་བཞིར་གསེར་སྲང་ལྔ་བཅུ་ཙམ་ལས་གྲུབ་པའི་གསོལ་ལྷུང་གཅིག་བཅས་བཟོས་འཕྲོས་ད་དུང་གསེར་ལྷག་གང་འཚམ་འདུག་པས།",
    "ཕྲན་ཚོས་གནས་ཚུལ་དེ་བདེན་པ་འདུག་སྙམ་སྟེ་ཁྱིམ་དུ་སྐྱོད་མ་ནུས་པར་མ་སྡོད་ཐབས་མེད་བྱུང་ནས་དེ་འཕྲལ་དམག་ཁོངས་སུ་དེབ་སྐྱེལ་བྱས་པ་ཡིན།",
    "ཕྲན་ནས་སྐད་སྒྱུར་བརྒྱུད་གནས་ལུགས་ཞིབ་ཕྲ་ཞུས་པས་ཁོ་རང་མི་བཟང་པོ་ཞིག་འདུག་འོན་ཀྱང་ཐག་མི་ཆོད།",
    "ཕྲན་གྱི་བསམ་པར་བོད་རིགས་འདི་ཚོ་ཤེས་པ་ཆེ་ཞིང་སྤྱང་གྲུང་འཛོམས་པོ་འདུག་སྙམ་པ་བྱུང་།",
    "འདུས་མ་བྱས་པ་དང་རང་རིག་པའི་ཕྱིར་རོ།",
    "ཡི་གེ་ཨོཾ་ཉིད་ཙ་ན་ཀའི་འབྲས་བུའི་ཚད་ཙམ་ཞེས་བྱ་བ་ལ་སོགས་པས་ཕྱག་རྒྱ་ཆེན་པོ་མངོན་དུ་༐",
    "སྤྱོད་ལམ་ཐམས་ཅད་དུའོ་ཞེས་པ་ནི་ལྡང་བ་༤འདུག་པ་དང་ཉལ་བའི་སྟེ་འཆག་པ་ཞེས་བྱ་བ་སྟེ་བཞི་ལའོ།",
    "རྣམ་པ་སྣ་ཚོགས་པའི་གོས་དང་ལྡན་པ་ཡིད་དགའ་བ་བྱང་དུ་ཁ་བལྟས་པ་བཟང་པོའི་འདུག་སྟངས་ཀྱིས་༡གནས་པ་༐",
    "རྡོ་རྗེ་ཧཱུཾ་མཛད་པ་༢ལ་སོགས་པའི་གཟུགས་བླངས་ཏེ་ཀླུའི་༢མཚོ་ལ་སོགས་པའི་འགྲམ་དུ་འདུག་ནས་སྔོན་གྱི་བསྙེན་པ་སྔོན་དུ་འགྲོ་བར་འོ་མ་ལ་སོགས་པའི་ལྷ་བཤོས་ད་བུལ་ཏེ།",
    "དེ་རྣམས་ཀྱི་མཆོག་ནི་ཉན་ཐོས་པ་དང་རང་རྒྱལ་བ་རྣམས་སོ་ཞེས་པ་ནི་འདོད་ཆགས་དང་བྲལ་བ་ཡིན་པས་སོ།",
    "དཔེར་ན་ས་ལ་འདུག་པ་དང་།",
    "ཤིང་རྟ་ལ་འདུག་༢པ་དང་རྫ་མར་འཚེད་པའོ།",
    "༡༧པེ་སྣར་འདུག་༡༧པེ་སྣར་ཡང་།",
    "༡དེ་ལྟ་ན་ནི་འདི་ལ་འདུག་ས་གཅིག་པ་ལ་གནོད་པ་ཅི་ཞིག་ཡོད།",
    "༦སྣང་བའི་བྲལ་ཚུལ་དང་རང་བཞིན་གང་ཞེ་ན།",
    "སྣང་བ་མཆེད་པ་ཞེས་བྱ་བ་ཡང་རང་བཞིན་གྱིས་ཡོངས་སུ་མཆེད་པར་འགྱུར་བ་སྟེ།",
    "༥ཡང་སྔ་མའི་ས་༦ན་འདུག་པ་ཉིད་དོ་ཞེ་ན་ཡང་མ་ཡིན་ཏེ།",
    "གསལ་བ་འགའ་ཞིག་དུས་ཡིན་ཏེ།",
    "འདུག་པར་གྱུར་ཏོ་ཞེས་བྱ་བ་ནི།",
    "མདུན་དུ་འདུག་སྟེ་ཞེས་བྱ་བ་ནི་མདུན་དུ་འཁོད་པའི་ཕྱག་ན་རྡོ་རྗེའོ།",
    "དེས་༦གཞན་རྣམས་འབྱེད་པར་བྱེད་ཅིང་རང་ཉིད་དབྱེར་མི་ཕྱེད་པའི་ཕྱིར་རོ། ༐",
    "དེ་ལ་ཡང་རང་ཉིད་རྩིབས་དྲུག་དང་ལྡན་པ་ཉིད་ཀྱི་ཕྱིར།",
    "གོ་འཕང་ཞེས་བྱ་བ་ནི་འདུག་པའི་གནས་སོ།",
    "ཞེས་བྱ་བ་ནི་ལུས་དང་ངག་དང་ཡིད་ཀྱི་ཕྱག་རྒྱའི་རྣམ་པ་གསུམ་གྱིས་༡རྡོ་རྗེ་བཟླས་པའི་ངོ་བོ་འདུག་པའི་གནས་སོ།",
    "བདེ་བ་ཆེན་པོའི་གོ་འཕང་ཞེས་བྱ་བ་ནི་དེ་འདུག་པའི་གནས་ཏེ།",
    "ཞེས་བྱ་བ་ནི་སྒྲིབ་པ་དང་བྲལ་བ་དང་རང་བཞིན་གྱིས་འོད་གསལ་བའི་ངོ་བོའོ།",
    "དེའི་གོ་འཕང་ནི་འདུག་པའི་གནས་ཏེ།",
    "རྟོགས་པ་ནི་མངོན་དུ་བྱེད་པའོ་། དེའི་གོ་འཕང་ནི་འདུག་པའི་གནས་སོ།",
    "གོ་འཕང་ཞེས་བྱ་བ་ནི་འདུག་པའི་གནས་སོ།",
    "དབྱངས་དང་ཞེས་བྱ་བ་ནི་དུས་གཉིས་ལ་ཡང་རང་དང་འོས་པའི་སྒྲ་བྱེད་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ཀུན་རྫོབ་ཏུ་ཡང་རང་རིག་པར་བྱ་བ་ཉིད་ཀྱི་ཕྱིར་མཐའ་གཉིས་སྤངས་པ་ནི་བྲལ་བའོ།",
    "དེ་རྣམས་ཀྱི་བརྒྱ་དང་བརྒྱད་དང་རང་བཞིན་ནི་བརྒྱ་རྩ་བརྒྱད་ད་དོ།",
    "འོད་གསལ་གོ་འཕང་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱིས་འོད་གསལ་བའི་རྣམ་པའི་འདུག་པའི་གནས་ས་སོ།",
