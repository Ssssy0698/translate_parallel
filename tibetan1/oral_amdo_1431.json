    "རྣམ་མཁྱེན་ཉིད་ཐུན་མོང་མ་ཡིན་པ་ཉིད་ས་གསུམ་དུ་བསྟན་ཏོ་ཞེས་བྱ་བ་ནི་རྣམ་གྲངས་གཞན་ཡིན་ནོ།",
    "དེ་ལྟ་མ་ཡིན་ན་རྣལ་འབྱོར་པའི་རྒྱུད་ལ་སོ་སོ་རང་གིས་རིག་པའི་སྐད་ཅིག་མ་རྣམས་ཇི་ལྟར་གཞན་ཡིད་ཆེས་པར་བྱེད་པའི་མཚན་ཉིད་དག་ཡིན།",
    "དེ་བཞིན་གཤེགས་པས་རྣམ་པ་གང་དང་རྟགས་གང་དང་མཚན་མ་གང་གིས་ཕྱིར་མི་ལྡོག་པའི་བྱང་སེམས་ཆེན་པོར་རབ་ཏུ་དབྱེ་བར་བགྱི་བ།",
    "ཕྱིར་མི་ལྡོག་པའི་བྱང་སེམས་ཆེན་པོའི་རྣམ་པ་དང་རྟགས་དང་མཚན་མ་རྣམས་བསྐལ་པ་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དུ་སྟོན་པར་སྤྱོད་ལགས་ན་བཅོམ་ལྡན་འདས།",
    "རབ་འབྱོར་ཟབ་མོ་ཞེས་བྱ་བ་འདི་ནི་སྟོང་པ་ཉིད་ཀྱི་ཚིག་བླ་དྭགས་སོ།",
    "ཅི་ཟབ་མོ་ཞེས་བགྱི་བ་འདི་མྱ་ངན་ལས་འདས་པ་འབའ་ཞིག་གི་ཚིག་བླ་དྭགས་ལགས་སམ།",
    "ཟབ་མོ་སྟོང་པ་ཉིད་ལ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊིཀ་བཞུགས། ༢༧སོགས།",
    "དེ་ལྟར་ན་སྟོང་པ་ཉིད་ལ་སོགས་པའི་དོན་གྱི་དབྱེ་བས་བརྗོད་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ཁ་ཅིག་གིའོ།",
    "འཇིག་རྟེན་པ་དང་འཇིག་རྟེན་ལས་འདས་པ་དང་ཐུན་མོང་དང་ཐུན་མོང་མ་ལགས་པ་དང་།",
    "རབ་འབྱོར་གང་གི་ཚེ་བྱང་སེམས་ཆེན་པོ་ཡུམ་ལས་ཇི་ལྟར་གསུངས་པ་བཞིན་བདག་གིས་འདི་ལྟར་གནས་པར་བྱའོ།",
    "ཡུམ་ལས་ཇི་ལྟར་ཉེ་བར་བསྟན་པ་བཞིན་བདག་གིས་འདི་ལྟར་བསླབ་པར་བྱའོ།",
    "དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས་ཇི་ལྟར་བསྟན་པའི་ཡུམ་ཟབ་མོ་འདི་ལ་གནས་ཏེ།",
    "འདི་ལྟ་སྟེ་ཡུམ་མོ།",
    "འདི་ལྟ་སྟེ་ཡུམ་མོ།",
    "བཀའ་སྩལ་དེ་བས་ཀྱང་གང་གིས་ཇི་སྐད་དུ་བསྟན་པའི་ཡུམ་ལ་གནས་ཏེ།",
    "དེ་བས་ཀྱང་གང་གིས་ཅི་ལྟར་བསྟན་པའི་ཡུམ་འདི་ལ་གནས་ཏེ་ཉི་མ་འགའ་ཞིག་གིས་དྲན་པ་ཉེ་བར་གཞག་པ་བཞི་ནས།",
    "རབ་འབྱོར་དེ་ལྟ་བས་ན་བྱང་སེམས་ཆེན་པོ་ཡུམ་དང་མ་བྲལ་བར་བྱའོ་ཞེས་པས་མི་མཐུན་པའི་ཕྱོགས་དང་གཉེན་པོ་འབྲིང་གི་འབྲིང་།",
    "ཡུམ་དང་བྲལ་བ་གང་ཞིག་གིས་བསྐལ་པ་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དུ་གནས་ཏེ།",
    "དེ་བས་ཀྱང་གང་གིས་ཇི་སྐད་བསྟན་པ་བཞིན་དུ་ཡུམ་ལ་གནས་ཏེ་ཉི་མ་འགའ་ཞིག་ཟང་ཟིང་གི་སྦྱིན་པ་དེ་དང་།",
    "གཉེན་པོའི་ཕྱོགས་འབྲིང་གི་ཆེན་པོ།",
    "ཡུམ་དང་བྲལ་བ་གང་ཞིག་གིས་བསྐལ་པ་གངྒཱའི་ཀླུང་གི་བྱེ་མ་སྙེད་དུ་གནས་ཏེ།",
    "དེ་བས་ཀྱང་གང་གིས་ཅི་སྐད་དུ་བསྟན་པའི་ཡུམ་ཟབ་མོ་འདི་ལ་གནས་ཏེ།",
    "དེ་དག་གི་གཉེན་པོ་ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོ་རྣམས་རེ་རེ་ཞིང་ཆུང་ངུ་དང་འབྲིང་དང་ཆེན་པོའི་བྱེ་བྲག་གིས་ཐ་དད་པའི་ཕྱིར།",
    "ཐོག་མ་ཁོ་ན་ལམ་ཆེན་པོ་མི་སྲིད་པས་ལམ་ཆེན་པོ་སྐྱེས་པ་ན་ཉོན་མོངས་པ་ཆེན་པོ་ཡོད་མི་སྲིད་པའི་ཕྱིར་ཏེ།",
    "གོས་ཀྱི་དྲི་མ་ཆེན་པོ་དང་པོར་བསལ་ནས་ཕྱིས་ནི་ཕྲ་མོ་དག་པར་བྱེད་པ་དང་།",
    "གང་གིས་རྣམ་གྲངས་གང་གིས་གཟུགས་དང་ཚོར་བ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧དང་།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་གསུངས་པའི་དོན་བདག་གིས་འཚལ་བ་ལྟར་ན།",
    "རབ་འབྱོར་དེས་ན་དོན་འདི་ཉིད་ཤེས་པར་བྱ་བའི་དོན་དུ་ཁྱོད་ལ་དཔེ་བསྟན་པར་བྱ་སྟེ།",
    "རང་གི་རྒྱུས་ཕན་ཚུན་གྱི་སྒོ་ནས་དུས་མཉམ་པ་ཕྲད་པ་བསྐྱེད་པས་ཁྱད་པར་ཅན་དུ་མ་བྱས་པའི་ཕྱིར།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པ་དེའི་ཕྱིར།",
    "རིགས་པ་དུ་ཞིག་གིས་རྣམ་པར་དཔྱོད་ཅེ་ན།",
    "དེའི་དོགས་པ་བསལ་བའི་ཕྱིར་ཟབ་མོ་བརྒྱད་ཡུམ་གང་ལ་ཡོང་བ་གསུངས་པ་ནི།",
    "སྐད་ཅིག་སྔ་མ་དང་ཕྱི་མ་དག་གིས་ཀྱང་མ་ཡིན།",
    "དེ་ལྟར་སྤྱོད་པ་དེ་ནི་ཡུམ་ཟབ་མོ་ལ་སྤྱོད་པ་ཡིན་ནམ།",
    "དེ་ནི་ཡུམ་ཟབ་མོ་ལ་སྤྱོད་པའོ།",
    "རང་གི་མཚན་ཉིད་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "ཀུན་ནས་ཉོན་མོངས་པའི་རྣམ་པར་རྟོག་པ་སྤང་བར་བྱ་བ་དང་།",
    "རབ་འབྱོར་བྱང་སེམས་ཆེན་པོས་རྨི་ལམ་དུ་ལས་གང་ཞིག་བྱས་པའི་ལས་དེ་ལ་སོག་པའམ་འབྲི་བར་འགྱུར་བ་ཡོད་དམ་ཞེས་པ་ནི་ལས་མེད་པར་ཐལ་བའི་ཀླན་ཀ།",
    "རབ་འབྱོར་གྱིས་སྨྲས་པ་ཉིན་པར་སྲོག་བཅད་པ་དང་རྨི་ལམ་གྱི་ནང་ན་སྲོག་བཅད་པ་དེ་ལ་འདི་སྙམ་དུ་དེ་བདག་གིས་བསད་དོ།",
    "དེ་བདག་གིས་བསད་པ་ལེགས་སོ་ཞེས་པ་དེ་རྣམ་པར་རྟོག་ན།",
    "ཤཱ་རིའི་བུ་ལས་དེ་ལ་ཁྱོད་ཇི་སྐད་ཟེར།",
    "སོགས་པ་ཧ་ཅང་ཐལ་བའི་ཀླན་ཀ།",
    "དེ་ལ་བློ་ལ་ལ་ནི་ཀུན་ནས་ཉོན་མོངས་པ་ཡོངས་འཛིན་ཏོ།",
    "ཤཱ་རིའི་བུ་བྱང་སེམས་ཆེན་པོ་བྱམས་པ་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་བཅོམ་ལྡན་འདས་ཀྱིས་ཕྱིར་མི་ལྡོག་པར་ལུང་བསྟན་པ་འདི་མངོན་དུ་གྱུར་ན་འདི་ལ་དྲིས་ཤིག་དང་།",
    "རབ་འབྱོར་འདི་ནི་འདི་སྐད་དུ་བྱམས་པ་འདི་མངོན་དུ་གྱུར་པ་ནི་སྐྱེ་བ་གཅིག་གིས་ཐོགས་པ་ཕྱིར་མི་ལྡོག་པར་བཅོམ་ལྡན་འདས་ཀྱིས་ལུང་བསྟན་པ་སྟེ་འདི་ལ་དྲིས་ཤིག་དང་འདིས་ལན་ལྡོན་པར་འགྱུར་རོ་ཞེས་ཟེར་རོ་ དེ་སྐད་ཅེས་སྨྲས་པ་དང་།",
    "འོན་ཏེ་གཟུགས་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་དང་རྣམ་པར་ཤེས་པ་ལན་ལྡོན་པར་འགྱུར་རམ།",
    "འོན་ཏེ་གཟུགས་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་དང་།",
    "གཟུགས་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་རྣམས་དང་།",
    "རྣམ་པར་ཤེས་པའི་སྟོང་པ་ཉིད་དང་དེ་བཞིན་ཉིད་གང་ཡིན་པ་དེ་ལ་ནི་ལན་ལྡོན་པའི་མཐུ་མེད་དོ་ བདག་གིས་ནི་གང་ལན་ལྡོན་པ་དང་།",
    "གང་གིས་ལན་ཀླན་པ་དང་།",
    "ཀྱེ་མ་མ་ལ་བྱང་སེམས་ཆེན་པོ་བྱམས་པ་འདི་ནི་ཤེས་རབ་ཟབ་མོ་དང་ལྡན་པ་སྟེ།",
    "དངོས་གཞི་དང་མཇུག་གིས་བསྡུས་པའི་ལས་ཉམས་པ་དང་འཕེལ་བ་མེད་པར་ཐལ་བ་ཉིད་དུ་གང་གསུངས་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧པ་ཡིན་ནོ།",
    "རྨི་ལམ་དུ་སྲོག་བཅད་པ་ཞེས་བྱ་བ་ནི་རབ་ཏུ་གྲགས་པའི་མཚན་མོ་དང་།",
    "ཚེ་དང་ལྡན་པ་རབ་འབྱོར་གང་ཡང་སྐྱེས་པའམ་བུད་མེད་དམ།",
    "དེའི་ཡང་ལས་དེ་སོག་པའམ་ཉེ་བར་སོག་པར་འགྱུར་རམ་ཞེས་པ་ནི་སོགས་པ་ཧ་ཅང་ཐལ་བའི་ཀླན་ཀ།",
    "དེ་ལ་བློ་ལ་ལ་ནི་ཀུན་ནས་ཉོན་མོངས་པ་ཡོངས་སུ་འཛིན།",
    "ཤཱ་རིའི་བུ་དེ་ལྟ་བས་ན་ལས་དང་སེམས་པ་ནི་དམིགས་པ་དང་བཅས་པར་འབྱུང་གི།",
    "གཟུགས་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་རྣམས་དང་རྣམ་པར་ཤེས་པ་ལན་ལྡོན་ཏམ།",
    "དེ་སྟེ་གཟུགས་དང་ཚོར་བ་དང་།",
    "རབ་འབྱོར་གཟུགས་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་རྣམས་དང་རྣམ་པར་ཤེས་པའི་སྟོང་པ་ཉིད་གང་ཡིན་པ་དེ་ནི་ལན་ལྡོན་མི་ནུས་སོ།",
    "ཤཱ་རིའི་བུ་ཇི་ལྟར་ཚིག་གིས་བརྗོད་པའམ།",
    "སོག་པ་ཞེས་བྱ་བ་ནི་རང་གི་ངོ་བོ་ཉེ་བར་སོག་པའི་ཕྱིར་རོ།",
    "དེའི་ཡང་ལས་ཞེས་བྱ་བ་ནི་ཉོན་མོངས་སྤོང་བར་མཛད་པའི་ཡིད་ལ་བྱེད་པའི་ཕྲིན་ལས་སོ།",
    "རང་གི་ངོ་བོ་ཉེ་བར་བསགས་པས་ན་སོག་པ་དང་འབྲས་བུ་སྐྱེད་པ་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "དམིགས་པ་ལ་ཉེ་བར་དམིགས་པ་མེད་པར་གཞན་དག་གི་ཡིད་ཀྱི་ལས་དང་སེམས་པ་ཅིའི་ཕྱིར་མི་འཇུག་ཅེ་ན།",
    "ཞེས་བྱ་བའི་ཚུལ་གྱིས་བློ་ལ་ལ་ནི་ཀུན་ནས་ཉོན་མོངས་པ་ལ་དམིགས་པས་ཀུན་ནས་ཉོན་མོངས་པ་ཡོངས་སུ་འཛིན་ལ།",
    "སེམས་པ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཤེར་ཕྱིན་མངོན་རྒྱན་གཡག་ཊཱིཀ་བཞུགས། ༢༧ཞེས་བྱ་བ་ནི་ཁ་ཅིག་ན་རེ་བློ་ཡིན་ནོ་ཞེས་ཟེར་རོ།",
    "དམིགས་པ་དང་བཅས་པའི་སེམས་ཀྱང་ཅི་ལྟར་སྐྱེ་ཞེས་སྨྲས་པ་ནི་ཚེ་དང་ལྡན་པ་རབ་འབྱོར་གང་གི་ཚེ་ཞེས་བྱ་བ་ལ་སོགས་པའོ།",
    "གཟུགས་ལ་སོགས་པར་གཏོགས་པའི་མཚན་མ་ཐུན་མོང་མ་ཡིན་པས་དེ་ཁོ་ནར་མཚན་མ་མེད་པ་ཡིན་ན་ཡང་།",
    "གདུལ་བྱ་སོ་སོའི་བྱེ་བྲག་གིས་བསྟན་ཟིན་པའི་དོན་ལ་ཡང་དོགས་པ་ཡང་ནས་ཡང་དུ་བྱུང་བ་ལ།",
    "དེ་ལ་རེ་ཞིག་སྟོང་པ་ཉིད་ནི་ལན་མི་ལྡོན་ནོ་ཞེས་བརྗོད་པ་ནི་དེ་སྟེ་གཟུགས་ཀྱི་སྟོང་པ་ཉིད་ཅེས་བྱ་བ་ལ་སོགས་པའོ།",
    "རབ་འབྱོར་གང་གི་ཚེ་བྱང་སེམས་ཆེན་པོ་རྣམ་པའི་མཆོག་ཐམས་ཅད་དང་ལྡན་པའི་སྟོང་པ་ཉིད་ལ་སོ་སོར་རྟོག་ན་མངོན་དུ་བྱའོ་སྙམ་དུ་རྟོག་པར་མི་བྱེད་ཀྱི།",
    "རབ་འབྱོར་དེ་བཞིན་དུ་གང་གི་ཚེ།",
    "ཐུན་མོང་མ་ཡིན་མཚན་ཉིད་ཅེས་པའི་དོན།",
    "དཀའ་བ་སྤྱོད་པ་ཐམས་ཅད་ཤིན་ཏུ་གོམས་པ་ཉིད་ཀྱིས་ཐུན་མོང་མ་ཡིན་པ་དང་།",
    "རབ་འབྱོར་གཞན་ཡང་བྱང་སེམས་ཆེན་པོ་གང་གི་ཚེ་འདི་ལྟ་སྟེ།",
    "བུད་མེད་དང་སྐྱེས་པའི་མཚན་མའམ་གཟུགས་ཀྱི་མཚན་མའམ་ཞེས་པ་ནས།",
    "ཁྱོད་ཀྱིས་སྟོང་པ་ཉིད་ཁོ་ན་ཡིད་ལ་བྱ།",
    "གང་གིས་སླར་མི་རྟོག་པར་འགྱུར་བའི་རྣམ་གྲངས་དེ་ལྟ་བུ་མཆིས་སམ།",
    "རྩེ་མོར་ཕྱིན་པའི་སྦྱོར་བའི་རྟགས།",
    "རབ་འབྱོར་གལ་ཏེ་ཡང་མེའི་ཕུང་པོ་དེ་བདེན་པའི་ཚིག་གིས་དེ་ལས་འདས་ཏེ་ཁྱིམ་ནས་ཁྱིམ་དུ་ཚིག།",
    "རྒྱུ་དང་རྐྱེན་དེ་དག་གིས་ཕྱིར་མི་ལྡོག་པའི་བྱང་སེམས་ཆེན་པོར་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "བུད་མེད་དམ་སྐྱེས་པ་གང་ལ་ལ་ཞིག་མི་མ་ཡིན་པས་བྱིན་གྱིས་བརླབས་ན།",
    "བདེན་པ་དང་བདེན་པ་དེའི་ཚིག་དེས་སྐྱེས་པའམ་བུད་མེད་འདི་མི་མ་ཡིན་པ་གང་གིས་བཟུང་བའམ་གཙེས་པར་གྱུར་པའི་མི་མ་ཡིན་པ་དེ་གུད་དུ་འགྲོ་བར་གྱུར་ཅིག་ཅེས་བསམ་ཏེ་སྨྲ་ན།",
    "རང་གི་དོན་དང་ལྡན་པར་འགྱུར་བ་ལ་བརྩོན་པར་བྱ་སྟེ།",
    "ཅི་ནས་ཀྱང་བདག་གི་ཉེས་པ་འདི་དག་ཐམས་ཅད་དུ་ཐམས་ཅད་མེད་ཅིང་མི་སྐྱེ་བར་འགྱུར་བ་དེ་ལྟར་བྱའོ།",
    "རབ་འབྱོར་ནམ་མཁའ་ལྟར་ཆགས་པ་མེད་པའི་མཚན་ཉིད་ནི་ཡུམ་མོ་ཞེས་སོགས་ཀྱི་དོན།",
    "གང་གིས་སྤྱད་པ་དང་།",
    "འཛམ་བུའི་གླིང་གི་སྐྱེ་བོ་སྙེད།",
    "རབ་འབྱོར་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ཡུམ་འདི་གཞན་ལ་སྟོན་པ་དང་འཆད་པ་དང་།",
    "གང་གིས་འཚང་རྒྱ་བ་དང་།",
    "རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་གང་ལ་ལ་ཞིག་ཀྱང་ཡུམ་འདི་འཛིན་ཅིང་འཆང་བ་དང་ཀློག་ཅིང་ཀུན་ཆུབ་པར་བྱེད་པར་འགྱུར་ཏེ།",
    "སྟོང་དང་བརྒྱ་ཕྲག་སྟོང་དང་བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་ཕྲག་སྟོང་གི་བར་གྱི་ཆ་དང་གྲངས་དང་ཆ་དང་བགྲང་བ་དང་དཔེ་དང་རྒྱུར་ཡང་མི་བཟོད་དོ་ཞེས་སོགས་ཀྱི་དོན།",
    "བྱང་སེམས་ཆེན་པོ་གང་ཟབ་མོ་འདི་ལ་སྤྱོད་པ་འདི་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་ཀྱིས་ཀྱང་རྟག་ཏུ་དགོངས་པ་ཡིན་ཏེ།",
    "དགེ་སློང་དེ་ནི་བྱང་སེམས་ཆེན་པོ་ཡུམ་ཟབ་མོ་འདི་ལ་སྤྱོད་བརྩེ་ཆེན་འོད་སྣང་ལས།",
    "འདི་དག་ཀྱང་བྱང་སེམས་ཆེན་པོ་ཡུམ་ཟབ་མོ་འདི་ལ་སྤྱོད་པའི་ཚེ་འདིའི་ཡོན་ཏན་དུ་རིག་པར་བྱའོ་ཞེས་པའི་དོན།",
    "ཀུན་དགའ་བོ་གཞན་ཡང་གང་གི་ཚེ་བྱང་སེམས་ཆེན་པོ་ཡུམ་དང་མ་བྲལ་བར་གྱུར་དེའི་ཚེ་བདུད་སྡིག་ཅན་མྱ་ངན་གྱི་ཟུག་རྔུས་ཟུག་པར་འགྱུར་རོ་ཞེས་སོགས་ཀྱི་དོན།",
    "འདི་ནི་བདག་གི་གྲོགས་ཏེ་གྲུ་གཅིག་ཏུ་ཞུགས་སོ།",
    "འདིས་ཇི་ལྟར་བསླབ་པར་བྱ་བ་དེ་བཞིན་དུ་བདག་གིས་ཀྱང་བསླབ་པར་བྱའོ།",
    "འདིས་སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ནས་རྣམ་མཁྱེན་ཉིད་ཀྱི་བར་ལ་གང་ལ་བསླབ་པར་བྱ་བ་དེ་ཉིད་ལ་བདག་གིས་ཀྱང་བསླབ་པར་བྱའོ་སྙམ་དུ་སེམས་བསྐྱེད་དོ་ཞེས་སོགས་ཀྱི་དོན།",
    "ཕྱིར་མི་ལྡོག་པའི་སར་ཆུད་པར་འདོད་པས་ཡུམ་ཟབ་མོའདི་ཉིད་ལ་བསླབ་པར་བྱའོ་ཞེས་པའི་དོན།",
    "རབ་འབྱོར་གཞན་ཡང་བྱང་སེམས་ཆེན་པོ་ཡུམ་ལ་སྤྱོད་པའི་ཚེ་གཟུགས་དང་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་རྣམས་དང་རྣམ་པར་ཤེས་པ་དང་ལྡན་པའི་སེམས་མི་སྐྱེའོ་ཞེས་པ་ནས།",
    "རབ་འབྱོར་དེ་ལྟར་ཡུམ་ཟབ་མོ་འདི་ལ་སློབ་པའི་བྱང་སེམས་ཆེན་པོས་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཐམས་ཅད་ཡོངས་སུ་ཟིན་པར་གྱུར་རོ།"
  ]
}