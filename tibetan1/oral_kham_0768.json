    "གཞན་ཕྱོགས་ལ་ངན་པར་སྨྲ་ཞིང་རང་ཕྱོགས་ཀྱི་ཁ་འཛིན་བྱེད་ཅིང་བཟང་པོ་སྨྲ་བ་༣།",
    "ང་རྒྱལ་ཆེ་ཞིང་རང་ཆེ་འབྱིན་པ།",
    "དེ་ལྟ་བུའི་རྫུན་དེ་ལའང་རང་འདོད་རྩ་བ་ནས་མེད་པ་ཞིག་དགོས་ཏེ།་",
    "ཕནསྨྲ་བའི་རྫུན་ཀྱང་རང་ཕྱོགས་ཞེ་འདོད་དམ་ཚེ་འདིའི་འཁྲིས་བག་ཙམ་ཞིག་འདུག་ན་སྨྲ་མི་རུང་།",
    "ཞེ་སྡང་རང་ག་མས་ཀུན་ནས་མ་བསླངས་པས་རྗེས་ཡི་རང་མེདལ།",
    "དེའང་རང་དོན་དུ་བསྲུང་ན་ཐེག་ཆེན་དུ་འགྱུར་བའི་སྐབས་མིད་དེ།",
    "སྐུ་ཉིད་བཟུང་ཞིང་རང་ལུས་ཀྱི།",
    "ལཆུ་ར་ཡང་གང་ནས་འདུག།",
    "ཤུན་པ་དར་ཟབ་ཏུ་འདུག་པ་སྐྱེས་པ་ལ།",
    "གླང་ལྤགས་དེ་མེད་ན་ཐོན་པར་འདུག་བསམ་སྟེ།",
    "རི་དམར་ཟང་ངེ་བ་ཆུང་ངུན་ཞིག་འདུག་པའི་རྩ་ན།",
    "༦ ཉིན་གཅིག་དུས་ན་མ་སླེབ་པ་ལ།",
    "ལམ་དོག་པར་བྲག་ཟུར་གྱིས་ནས་སྐྱེ་ཅུང་ཙམ་བཀྲམ་ནས་འདུག་པས།",
    "ཟེར་བའི་ཡི་གེ་རང་འབྱོན་དོད་ནས་འདུག་པར་གྲགས་སོ།",
    "ཐསྒོམ་སྒོམ་བྱེད་པ་ལ་འགྲོ་འདུག་མང་བ་མི་དགའ་བར་གདའ་འམ།",
    "ཡང་རྩ་བ་ན་འདུག་པ་མཐོང་ནས་ཐུར་ལ་འགྲོ་བས་སྟར་བཞིན་དུ་ལུས་བཤིག་གོ།་",
    "སྔས་གསུམ་ད་ནི་བདག་འཆི་བར་འདུག་པས་བོན་པོ་གཤེན་རབ་བྱིནམི་འཆི་བར།",
    "དེའི་དུས་ན་ཁོ་རང་ཡང་འགྱོད་ཅིང་ཕྱིས་དྲན་པ་རྙེད་དེ་འཕྱིས་སོ།",
    "ཞེས་སོ་གཉིས་ཞར་བྱུང་བཙུན་པའི་ཁྱིམ་དུ་བཙུན་མའམ་བུ་མེད་ཞིག་ཏུ་འདུག་པའང་གནང་བ་མེད་དེ།",
    "མེད་འདི་འཕྱིས་ནས་གདའ་བས་དོ་ནུབ་བཞག་པར་ཞུ་ཞུས་པ།",
    "སྟོན་པ་མཛད་པའི་ཞིང་ཁམས་དག་པ་ཞིག་ན་འདུག་ཙ་ན།",
    "གསར་དུ་བྱུང་བ་ཀུན་ཤེས་པར་འདུག་སྟེ།",
    "འདི་ཀ་གསར་དུ་བྱུང་བ་ཡིན་འདུག།",
    "ཤིན་ཏུ་སྐད་ངན་དྲག་པོ་འབྱིན་འདུག་པ་ལ།",
    "ཨུ་རྒྱན་གྱི་ཡུལ་དུ་ཕྱིན་ནས་འདུག།",
    "དེ་ཙམ་ངོས་མ་ཟིན་ཀྱང་ཞི་གནས་སེམས་ཟིན་པ་འདུག་པས།",
    "གཏམ་རྒྱུད་སོ་དཀུ་པདྨའི་ཁ་ཕྱེས་པའི་སྲས་སྟོང་རང་བྱུང་དུ་འཁྲུངས་པ་དང་།",
    "ཕྱིན་ཙ་ན་སྔར་གྱི་ཁྲིད་མཁན་གྱི་མི་ནག་དེ་འདུགའཇིགས་པ་དུང་ངེ་བ་ཞིག་བྱུང་ཡང་ཁོས་ཁྲིད་ནས་ཁང་པ་སྔོན་པོ་ཞིག་ཏུ་ཕྱིན་ཙམ་ན།",
    "གཞན་ཅིས་ཀྱང་མི་ཕན་པ་འདུག་ཟེར།",
    "བལྟས་པས་ཤ་ཟད་རུས་འགོ་བགས་པས་གཡོགས་ཙམ་དུ་འདུག་པ།",
    "མདངས་དགངས་ཟན་ཟོས་པ་དེ་ཀུན་ཞེ་བདུའབུ་ཟོས་པ་འདུག་ཕ་ངས་ཟ་མ་དེ་འདི་ལྟ་ཡིན།",
    "འོ་ན་མངོན་སུམ་དུ་གདའ་བ་ལགས་ཞུས་པས།",
    "ཁོ་རང་གང་ཡིན་ཞུས་པས།",
    "བྱ་བ་ཞིག་འདུག་པས།",
    "བལྟས་པས་ཨུད་དུ་འབར་བ་གཉིས་འདུག།་",
    "ཐམས་ཅད་ཀྱིས་ཀྱང་ཀུན་མཁྱེན་རང་དུ་འདུག་ཅེས་བསྔགས་པས།",
    "ས་བྱང་ལམ་བཅད་ནས་རྒྱུག་དུས།",
    "ནམ་སྟོན་ནམ་ལྟག་ཀས་འཇོག་དུས།",
    "ང་འདུག་ས་རྨ་ཆུའི་ཁ་ཡིན།",
    "ས་བྱང་ལམ་བཅད་ནས་རྒྱུག་དུས།",
    "བོའུ་བཟང་འདུག་ད་དུང་མི་ཤེས།",
    "ལབ་ལེན་སའི་གྲལ་ནས་མི་འདུག།",
    "རྟ་རྒྱུག་འདུག་རྟིང་ཐག་གཅོད་རྒྱུ་ཡིན།",
    "ང་ལེ་ལན་རྩོད་རྒྱུ་ལོས་ཡིན།་",
    "གྲོང་རྩེ་བའི་གྲས་ནས་འདུག་ཤེས་བྱོས།",
    "རི་མཐོ་འདུག་རྟིང་ཐག་གཅོད་ལ།",
    "སྡིངས་ཁ་སྒར་པ་དགོན་ནས་མན་ཐང་ད་ལྟ་མན་ཐང་ཞེས་འབྲི་ནའང་སྔོན་གནས་དེར་མ་ཎིའི་གདང་རིང་པོ་ཞིག་ཡོད་པ་ལ་ལས་མན་ཁྲིའང་ཟེར་འདུག་བར་ཕྱིན།",
    "མཁའ་འགྲོ་སྤྱན་གདོང་རང་བྱོན་ད་ལྟའང་མཇལ་རྒྱུ་ཡོད།",
    "འོན་ཀྱང་ཇུན་གར་དམག་དུས་རྩ་གཏོར་བཏང་ནས་ལྷ་ཁང་སོ་ལྟ་ཁང་དང་།",
    "དེའང་སྐྱོབ་པ་འཇིག་རྟེན་གསུམ་དགོན་གྱིས་གནས་བྱང་ཕྱོགས་རྒྱུད་དུ་གཤེགས་ཙ་ན།",
    "འོན་ཀྱང་ཇུན་གར་དམག་དུས་བཀའ་རྙིང་སྤྱི་མཚུངས་དགོན་དེའང་རྩ་གཏོར་བཏང་།",
    "རྗེས་སུ་རྟེན་རྫས་ཁ་ཤས་ལུང་དཀར་དགོན་ལ་སླར་ཡང་རང་སློག་ཏུ་བྱུང་བ་དང་ཁྱུང་ནག་རྒྱལ་བ་བསྟན་འཛིན་སོགས་ཀྱིས་སླར་ཡང་དགོན་གནས་དེ་ཉིད་བསྐྱར་འཛུགས་གནང་།",
    "ཀླུ་མཁར་དགོན་གྱི་ཁ་འཛིན་ག་དུས་གནང་བ་མི་གསལ་ཡང་ཕྱིས་རིག་འཛིན་གཡང་སྐྱོབ་དང་།",
    "སླར་ཡང་རྒད་པོ་སོས་དལ་འདུག་ཐབས་རང་མ་བྱུང་།",
    "ནོར་གླིང་ས་གཞིའི་རིན་ཐང་བརྗོད་ཐབས་རང་མིན་འདུག་རི་དྭགས་གཅན་གཟན་རང་ཁ་རང་ཉིད་ཀྱིས་གསོས་ཀྱང་།",
    "རང་རང་ཚེ་ཚད་ཇི་ཡོད་ཟད་ཟད་ལ་སྡོད་ཆོག་འོན་ཏེ་མགོ་ལ་རྭ་ཅོ་བང་རྩལ་གྱིས་ཕྱུག་ཅིང་།་",
    "འདུག་སྟངས་སྟངས་སྟབས་བཟླས་བརྗོད་དང་།",
    "འདུག་སྟངས་ནི།",
    "ཞེས་ངོར་པའི་ཟིན་བྲིས་འགའ་ཞིག་ཏུ་བྲིས་འདུག་པ་སྔོན་རྗེ་རྡོ་རྗེ་འཆང་དང་།",
    "གཉིས་ཀྱིས་གཉིས་འཁྱུད་པའི་བདེ་བ་ལམ་དུ་བྱེད་དགོས་ཙ་ན་རང་མདུན་གྱི་ལྷ་དེར་བསྒོམ་དགོས་པར་འགྱུར་ཏེ།",
    "བེ་རོ་ཙ་ན་རཀྵི་ཏས་བྱས།",
    "གཞན་དང་མི་མཐུན་ཚོད་དུ་འདུག་གསུངས།",
    "དེ་ཚོ་སྟོན་བྱེད་ཀྱི་རྒྱུད་ཅིག་དགོས་པ་འདུག་སྙམ་ནས་བརྩམས།",
    "ཁོང་པའང་མདའ་འཕེན་ཞིང་སྤྱོད་པ་མཛད་པ་ཡིན་པ་འདུག་གོ་གསུངས།",
    "མུ་གེ་བྱུང་པ་ཡིན་པ་འདུག་པ་ལ།",
    "ཚུར་ཕེབས་དུས་དེས་རྒྱལ་པོ་ཐོབ་འདུག་གོ།",
    "ད་ལྟ་ཡང་དབུ་དང་སྐུ་ལུས་གཉིས་ཇེ་ཉེ་ཇེ་ཉེར་འགྲོ་ཡི་འདུག་ཅེས་གྲགས་སོ།",
    "དེའང་པཎྜི་ཏ་གཙང་ཧྲིག་པ་ཞིག་ཡིན་པར་འདུག་ལ།",
    "དེ་ཉིད་ལ་ལེའུ་བཅོ་བརྒྱད་པའང་བྱས་པ་གཅིག་འདུག་རྒྱ་གར་མ་མིན་ཞིང་མཆན་དཀྱུས་སུ་ཤོར་བ་ལྟ་བུ་ལྷད་ཆེ་བར་འདུག་གསུངས།",
    "གཞུང་ཕྲན་ཚེགས་མང་པོ་བསླབས་ནས་ཁྱེད་ལ་མ་རྒྱུད་ཀྱི་གདམ་ངག་ཟབ་ལ་མང་བར་གདའ་བས་བདག་ལ་གནང་བར་ཞུ་བྱས་པས།",
    "དེ་དུས་ན་མཁས་པ་སྒོ་དྲུག་ནི་གྲོངས་ནས་མི་འདུག་འདུས་པ་སློབ་དགོངས་ནས་སུ་དྲག་དྲིས་པས།",
    "ཁོང་རང་བྱ་སྤྱོད་ལ་ཤིན་ཏུ་མཁས་པ་ཞིག་ཡིན་པར་འདུག་གསུངས།",
    "དེས་བོ་དོང་པ་དགེ་སློང་ནམ་མཁའ་དཔལ་བྱ་བ་གཅིག་ལ་ཞུས་པར་འདུག་དེ་མན་ཙམ་ལས་དེ་ཡན་གསལ་བར་ཟིན་བྲིས་ག་ན་ཡང་མི་འདུག་པས།",
    "རང་རང་བློ་གྲོས་དང་སྦྱར་ཏེ།",
    "གཞན་ཡང་བདེ་ཆེན་རལ་གཅིག་འདི་དོན་ལ་རྙིང་མར་འདུག་ཅིང་འདིའི་ཁ་འཛིན་བྱེད་པའི་ཁྲོ་ཕུ་བས་ནི།",
    "ལྟ་བ་སེམས་ཙམ་དུ་བཀྲལ་ཅིང་ལྷ་ཡང་ཉེར་ལྔ་བྱས་པར་སྣང་བས་འཕགས་ལུགས་དང་ཡེ་ཤེས་ཞབས་ལུགས་གང་ཡང་མིན་པར་འདུག་གོ།",
    "ཤཱཀྱ་བཤེས་གཉེན་དེ་ཀླུ་སྒྲུབ་ཀྱི་མཚན་གྱི་རྣམ་གྲངས་སུ་འདོད་པའི་ནོར་བ་རྒྱ་གར་བ་ལ་ཡང་འདུག་ཅིང་།",
    "གཉིས་མེད་རྣམ་རྒྱལ་གྱི་རྒྱུད་ཀྱི་དུམ་བུར་འདུག་སྟེ།",
    "དེ་ལྟར་དུ་བཀྲལ་པ་དེ་ཡང་རང་བཟོ་མ་ཡིན་གྱི།",
    "སློབ་དཔོན་དེ་ཡང་མཚན་བརྗོད་ཀྱི་འགྲེལ་བྱེད་འཇམ་དཔལ་སེང་ལྡན་གྱི་དཀྱིལ་ཆོག་རྩོམ་པ་པོ་ཡིན་ན་ནི་འཇམ་དབྱངས་ཀྱིས་རྗེས་སུ་བཟུང་ངེས་ཤེས་པ་གཅིག་ཡིན་པར་འདུག་པས།",
    "སྟངས་སྟབས་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "བྱ་སྤྱོད་གཉིས་ངོ་བོ་གཅིག་ཅིང་དེ་གཉིས་ལ་ཟབ་ཁྱད་མི་འདུག་པའི་ཕྱིར་དང་།",
    "གཉིས་ཀ་འཁྱུད་པའི་བདེ་བ་ལམ་དུ་བྱེད་དགོས་ཙ་ན།",
    "བདེ་མཆོག་དུས་འཁོར།",
    "དགྲ་ནག་ལ་མཁས་པ་ཞིག་ཤེས་ན་འཆད་སླ་བ་ནི་འདུག་གོ།",
    "ཁ་ཅིག་ཏུ་བེ་རོ་ཙ་ན་རཀྵི་ཏས་མཛད་ཟེར།",
    "ཁོ་རང་ལ་བལྟར་ཕྱིན་ན་གསང་ཞིང་སྦས་པ་ཞིག་འོང་ཐང་པ་ཞིག་འདུག་ཀྱང་།",
    "ཡོན་ཏན་འབུམ་བྱ་བ་དེ་ཚོ་ལ་མཁས་པ་བྱོན་འདུག་པས་དེའི་རྒྱུན་ཨེ་ཡོད་ཡིན།",
    "བཞུགས་ཙ་ན།",
    "མུ་གེ་བྱུང་པ་ཡིན་པར་འདུག་ལ།",
    "ཚུར་ཕེབས་དུས་དེས་རྒྱལ་པོ་ཐོབ་འདུག་གོ།",
    "ད་ལྟ་ཡང་དབུ་དང་ལུས་ཇེ་ཉེར་འགྲོ་ཡི་འདུག་ཟེར་གྲགས་སོ།",
    "མཛད་ངེས་ཤེས་པའི་སྦྱིན་སྲེག་ཅིག་ཡོད་པར་འདུག་སྟེ་བོད་དུ་མ་འགྱུར་རོ།",
    "དོན་བསྡུས་ཀྱི་འགྲེལ་པ་ལྟ་བུ་བཟང་པོ་ཞིག་འདུག་ཟ་ཧོར་གྱི་སློབ་དཔོན་བི་ཤྭ་མུ་ཁས་བྱས་པའི་འགྲེལ་པ་ལེའུ་བཅུ་བདུན་པ་ལ་ཚན་པ་གཉིས་སུ་བྱས།",
    "ཁྱེད་ལ་མ་རྒྱུད་ཀྱི་གདམས་ངག་ཟབ་ལ་མང་བར་གདའ་བས་བདག་ལ་གནང་བར་ཞུ་བྱས་པས།",
    "དེ་དུས་མཁས་པ་སྒོ་དྲུག་ནི་གྲོངས་ཚར་ནས་མི་འདུག་པས།",
    "འདི་བྱ་སྤྱོད་ལ་ཤིན་ཏུ་མཁས་པ་ཞིག་ཡིན་པར་འདུག་ཅིང་།",
    "སྒྱུ་ལུས་དང་འོད་གསལ་གསང་འདུས་ནས་ཕར་འབྱོན་པར་གདའ་བས་བསྲེས་པ་རང་མིན་ནམ།",
    "སྐབས་མང་པོར་ནི་མཆན་ཆེན་གྱི་ཡིན་ཚོད་དུ་འདུག་སྟེ།",
    "རྗེས་ཀྱང་བུ་ཊཱིཀ་སྟེང་ནས་ཚར་གསུམ་གསན་པས་དེའི་འབྲེལ་དང་ཞེན་པར་གདའ།",
    "ཤོག་དྲིལ་གསུམ་དང་མ་མཇལ་ཚོད་དུ་འདུག་སྟེ།",
    "རྡོ་རྗེ་གདན་རྒྱབ་ཀུ་པ་ཙ་ན་ཞེས་བྱ་བ་ཡི་ཚལ།",
    "དེ་ཡང་རང་བཞིན་རྒྱུད་ཀྱི་ཁྱད་པར་དང་།",
    "མཚན་གཞི་ངོས་མ་ཟིན་པར་འདུག་པའི་ཕྱིར།",
    "རྒྱ་དཔེ་ཡང་གཉིས་ཙམ་འདུག་པ་དང་།",
    "ལ་ལི་ཏ་བཛྲ་གྱིས་མཛད་པའི་རྒྱ་འགྲེལ་ཡང་གཉིས་ཙམ་འདུག་པའི་ཕྱིར།",
    "དེ་ཡང་རང་བཞིན་སྐྱེ་བ་མེད་པ་སྤྲོས་པའི་མཐའ་ཐམས་ཅད་དང་བྲལ་བ་ནི་དོན་དམ་འོད་གསལ་གྱི་རྣལ་འབྱོར་ཡིན་ལ།",
    "འོ་ན་ཟུང་འཇུག་དང་སྒྱུ་ལུས་ཀྱི་རྣལ་འབྱོར་གཉིས་ལ་རྡོ་རྗེ་འཆང་དུ་བསྒྱུར་ནུས་པ་ལ་ཁྱད་པར་མི་འདུག་གོ་སྙམ་ན།",
    "དེང་སང་བློ་ཆུང་རང་བློའི་རྩལ་ཞན་པས།",
    "ལན་གསུམ་བསྐོར་བ་བྱས་ནས་ཕྱོགས་གཅིག་ཏུ་འདུག་གོ།",
    "ཕྱོགས་གཅིག་ཏུའདུག་ནས་ཀྱང་དེ་བཞིན་གཤགས་པ་དགྲ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་སྤྱནསར་བབ་པར་འབར་ཞིང་འདུག་གོ།",
    "རིགས་ཀྱི་བུ་དེ་ནས་རྒྱལ་པོ་རྩིབས་ཀྱི་མུ་ཁྱུད་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུགནས།",
    "ཨའོན་དའི་ཤིང་དྲུང་ན་འདུག་པ་དང་།",
    "བྲམ་ཟརྒྱམཚོའི་རྡུལ་གྱི་མདུན་དུ་འདུག་ནས་འདི་སྐད་ཅེས་སྨསས།",
    "དེནས་རྒྱལ་བུ་གཞོན་ནུ་ཁྱུད་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུགནས་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "རྒྱལ་བུ་སྡིག་མེད་ཀྱི་མདུན་དུ་འདུག་གོ།",
    "ས་བཞི་ཐམས་ཅད་གསརགྱི་ཁ་དོག་ལྟ་བུར་གདའ་བར་གྱུར་ཅིག།",
    "འདུགནས་འདི་སྐད་ཅེས་གསོལ་ཏེ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས།",
    "རིགས་ཀྱི་བུ་དེ་ནས་བྲམ་ཟེའི་ཁྱེའུ་བགྲོད་པའི་བུ་དྲི་མ་མེད་དེ་བཞིན་གཤེགས་པ་རིན་པོ་ཆའི་སཱིད་པོའི་སྤྱན་སྔར་འདུག་སྟེ།",
    "རིགས་ཀྱི་བུ་དེ་ནས་བྲམ་ཟེའི་ཁྱེའུ་སྟོབས་ཆེན་ཤུགས་འཆང་དེ་ཡང་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་འདུགས་གསོལ་པ།",
