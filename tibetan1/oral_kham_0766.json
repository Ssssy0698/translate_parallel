    "སྤྱད་མི་དགོས་ཤུགས་འབྱུང་རང་བབ།",
    "རང་འབྱུང་རང་ཤར་དུ་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "རང་བྱུང་རང་སྒྲ་རང་གྲོལ་རང་བསྒྲོགས་སུ་ཟློས་ཤིག།",
    "ཚེ་རྒྱལ་ཙ་ཀ་ལའི་རྒྱབ་ཡིག་གསུངས་པ་འདུག་སྟེ་མང་བས་མ་དྲོངས་ལ།",
    "ཨ་ཐུང་རང་བཞིན་འགགས་པ་མེད།",
    "རང་རིག་རང་བྱུང་རང་གསལ་ཉིད།",
    "ཨ་རང་བྱུང་རང་གྲོལ་རང་གསལ་ཨ་དཀར་གསུམ།",
    "ཡེ་ནས་གཞི་ལ་རང་བྱུང་རང་གྲུབ་པའི།",
    "རང་རིག་རང་འབྱུང་རང་གསལ་དོན་རྟོགས་ནས།",
    "དེའི་ངང་རང་སར་གསལ་སྟོང་འཛིན་མེད་དུ་བཞག་གོ།",
    "ཆགས་སྡང་རང་གྲོལ་ཤེས་ན་གང་དུ་བསྡད་ཀྱང་དབེན།",
    "གཉེན་དང་རང་ཡུལ་ཟས་ནོར་གསུམ།",
    "རྟིང་བརླག་པར་བྱེད་པ་ཅིག་འདུག་ཡུ་གུར་གྱི་རྒྱལ་ཁམས་འདི་ཡང་མ་བརླག་པའི་གོང་ཕན་དུ།",
    "ཧོར་ཁོ་རང་འུ་ལག་དང་དམག་ཁྲལ་ཆུང་།",
    "དེ་དང་སྦྱར་ན་གཞན་ཚོ་ཆུང་བར་གདའ།",
    "ངོ་བལྟས་པ་རྣམས་བརྟན་ནམ་བྱས་པ་དེ་ཚོ་སྔོན་ལ་འདྲི་བར་འདུག་གསེར་ཡིག་པ་དེ་མ་མགུ་ན་གནོད་ཐུབ་པའི་གཏམ་གཏོང་བར་ངེས།",
    "མགུ་ན་ཕན་ཐོགས་ནུས་པ་ཅིག་གདའ།",
    "འདིར་མི་གང་དྲག་པ་དང་འདབ་ནོར་ཁྱེར་ནས་འོང་བ་ཚོ་བཟང་པོར་བཏང་བར་གདའ།",
    "འདི་ན་དེ་ཚོ་དགའ་བར་འདུག་སྤྱིར་ནོར་ལ་འདིར་ནོར་རྩིས་ཆུང་ཡང་།",
    "གསེར་ཡོད་ན་གང་འདོད་འོང་བར་འདུག་པས་དགོངས་མཛོད།",
    "དེ་བཞིན་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པས་མཚམས་ཀྱི་ནང་ན་འདུག་པ་ལ་བཟློག་པའང་མི་བརྩན་ནོ་་དེ་བཞིན་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པས་མཚམས་ཀྱི་ནང་ན་འདུག་པ་ལ་བཟློག་པའང་མི་བརྩན་ནོ་ཨུ་པཱ་ལི་བརྩན་པ་ནི་དགེ་ཚུལ་བསླབ་པ་སྟོན་པའི་ཚེ་བདག་ལ་བསླབ་པ་མ་སྟོན་ཅིག་ཅེས་ཟེར་ན་དེའི་བཟློག་པ་བརྩན་ནོ་་དགེ་ཚུལ་བསྙེན་པར་རྫོགས་པར་བྱ་བའི་ཚེ་བདག་ལ་༥",
    "ཧན་ཧྲང་བཟོ་གྲྭར་ལས་ཀར་འགྲོ་མཁན་ལས་ཀ་གྲོལ་རྗེས་བསུ་བར་ཡོང་མཁན་སྦག་སྦག་འཁོར་ལོ་དང་རླངས་འཁོར་སོགས་ཧ་ཅང་མགྱོགས་པོ་འདུག་པས་འགྲོ་མིར་ཉེན་ཁ་ཆེན་པོ་འདུག།",
    "ཡུལ་གྲོང་མི་ཚང་མས་རང་ཉིད་ཀྱི་བྱ་སྤྱོད་ཐོག་ནས་མི་གཞན་ལ་ཤུགས་རྐྱེན་ཐེབས་ཀྱི་ཡོད་ལ་ཡུལ་གྲོང་མི་གཞན་པའི་བྱ་སྤྱོད་ཀྱིས་ཀྱང་རང་ཉིད་ལ་ཤུགས་རྐྱེན་ཐེབས་སྲིད།",
    "༡ཕ་མ་གཉིས་ཀའམ་གཅིག་ཀྲུང་གོའི་སྤྱི་དམངས་ཡིན་ཞིང་རང་ཉིད་ཀྲུང་གོར་སྐྱེས་པར་ཀྲུང་གོའི་རྒྱལ་ཁོངས་ཡོད།",
    "ཞིང་རང་ཉིད་ཕྱི་རྒྱལ་དུ་སྐྱེས་པ་ཞིག་ཡིན་པར་ཀྲུང་གོའི་རྒྱལ་ཁོངས་ཡོད་པ་དང་།",
    "འོན་ཀྱང་ཕ་མ་གཉིས་ཀའམ་གཅིག་ཀྲུང་གོའི་སྤྱི་དམངས་ཡིན་པའི་ཐོག་ཕྱི་རྒྱལ་དུ་གཏན་སྡོད་བྱེད་པ་དང་རང་ཉིད་སྐྱེ་དུས་ཕྱི་རྒྱལ་གྱི་རྒྱལ་ཁོངས་ཡོད་པར་ཀྲུང་གོའི་རྒྱལ་ཁོངས་མེད།",
    "ཤེས་ཐུབ་ཀྱི་ཡོད་པ་དང་རང་ཉིད་ཀྱི་བྱ་སྤྱོད་ལ་འགན་འཁུར་ཐུབ་ཀྱི་ཡོད།",
    "ཕྱོགས་ཡོངས་ནས་ཕན་གནོད་ལ་དོན་དངོས་དང་མཐུན་པའི་དཔྱད་ཞིབ་བྱེད་ཐུབ་པ་དང་རང་ཉིད་ཀྱི་བྱ་སྤྱོད་ལ་འགན་འཁུར་ཐུབ་པ་བྱེད་དགོས།",
    "ད་དུང་རང་ཉིད་ཀྱི་ལས་དོན་བསྒྲུབས་ཚུལ་ཡང་སྙན་སེང་ཞུས་པ་དང་།",
    "དེས་ཁྱེད་རང་ལ་དག་ཞིང་དུ་སླེབས་པ་ལྟ་བུའི་ཚོར་སྣང་བསྟེར།",
    "ཅེས་གསུངས་ཞེས་སོགས་བྲིས་འདུག་རྩོམ་དུམ་གཉིས་པ་དེ།",
    "ཞེས་པའི་དྲི་བའི་ལན་ལྟ་བུར་བྲིས་འདུག་དེའི་ནང་དུ།",
    "ཞེས་པའི་དྲི་བའི་ལན་ལྟར་བུར་བྲིས་འདུག་ཅིང་དེའི་ནང་དུ།",
    "མི་སུ་ཡིན་ཡང་རང་ཉིད་ལ་གནས་བབ་ངེས་ཅན་དེའི་སྟེང་མུ་མཐུད་ནས་སྡོད་པའི་ནུས་པ་མེད་པ་ན།",
    "དེ་ནི་ཁོ་རང་ཉིད་ཀྱི་གནས་སྟངས་བསམ་པ་ལས་བྱུང་བ་མ་ཡིན་པར་གཞན་གྱི་སྡུག་བསྔལ་སྤྱི་དང་།",
    "ཁོ་རང་ཧ་ཅང་དད་གུས་ཆེན་པོ་ཅན་ཞིག་ཡིན་པས་སྒོམ་གྱི་སྐབས་སུ།",
    "དོན་དངོས་ཐོག་ནུས་པ་དེ་ཁོ་རང་ཉིད་ཀྱི་རྣམ་པར་དག་པའི་སེམས་ལས་བྱུང་བ་སྟེ།",
    "བློ་རྒྱ་དོག་ཅིང་རང་ཞེན་ཆེ་ལ།",
    "རྒྱུ་རྔམ་གྱི་བསམ་བློས་ཁོ་ཚོའི་འགྲོ་འདུག་སྤྱོད་གསུམ་སོགས་ཡོངས་སུ་བཅིངས་པ་ལས་མི་ལོ་མང་པོ་འདས།",
    "སྐྱེ་བ་མི་འདོད་ཀྱང་སྐྱེས་ཟིན་པས་ལས་གདའ་བྱེད་ས་མེད།",
    "སྐབས་དེར་སུ་ལ་ཐུག་ཀྱང་གསོད་གཏུབ་དང་འཕྲོག་བཅོམ་བྱེད་འདོད་ཅིང་རང་ཤི་རྒྱག་རྒྱུ་ནི་ཅིར་ཡང་མི་བསམ།",
    "སྒྱུར་རྟགས་སྣོན་རྟགས་ཙམ་སྦྱངས་ཞོར་ཕ་མ་ལ་ལས་གདའ་བྱས་ནས་སྡོད་དགོས་སམ།",
    "ད་དུང་ཕ་མ་ལ་ལས་གདའ་བྱས་ན་ས་སྡོད་རྒྱུ་ཨེ་ཡིན།",
    "ཐོག་མར་རང་ཉིད་བརྗོད་གཞིར་འཛིན་དགོས་ཤིང་རང་ཉིད་ཀྱི་ལག་ལེན་ལ་ཕྱིར་མིག་བགྲད་དགོས།",
    "དཔལ་མགོན་ཕྱག་བཞི་པ་བསྙེན་ཅིང་བསྒྲུབ་པའི་ཐབས་ཐེལ་ཚལ་སོགས་མང་པོ་འདུག་ཀྱང་དོན་ལ་གཅིག།",
    "དགའ་རློམ་འདུག་ན་བདུད་ཡིན་ནོ།",
    "རང་རང་དྲི་མས་དག་ཚེ་ཞེས་པ་སྟེ།",
    "རླན་ཞིང་གཤེར་བ་ཙམ་ཞིག་ཆུའི་ངོ་བོ་ཡིན་པས་ཆུ་ཐམས་ཅད་གཤེར་བ་ཡིན་གྱི་དེ་ལ་གཤེར་བྱེད་གཞན་ཞིག་ལ་ལྟོས་ན་དེ་དང་ཕྲད་པའི་ཚེ་གཤེར་བར་འགྱུར་གྱི་མ་ཕྲད་པའི་ཚེ་ཆུ་རླན་ཞིང་གཤེར་བ་མིན་པ་ཡིན་དགོས་པ་ལས་དེ་ལྟར་མི་དགོས་པར་མངོན་སུམ་དུ་མཐོང་བ་བཞིན་གཤེར་བའི་ངོ་བོ་ཙམ་ཞིག་འཇོག་པ་ལྟར་འདིར་ཡང་རིག་བྱ་རིག་བྱེད་གཉིས་མི་དགོས་ཀྱང་རང་དང་རིག་པར་གྲུབ་པས་ཆོག་གོ།",
    "དེ་ལྟ་བུའི་ཀུན་གཞི་དེ་ལ་རྣམ་སྨིན་གྱི་ཆ་དང་རང་འབྲས་ཕྱི་མ་བསྐྱེད་ནུས་ཀྱི་ས་བོན་གྱི་ཆ་གཉིས་ཡོད་པ་ལས་རྣམ་སྨིན་གྱི་ཆ་ཞེས་པ།",
    "དེ་ལྟ་བུའི་སྣ་ཚོགས་སུ་སྣང་ཡང་རང་བཞིན་མེད་པའི་གནས་ཚུལ་དེ་ནི།",
    "རྣམ་པར་རིག་པ་ཙམ་དེ་ཡང་རང་བཞིན་གྱིས་མ་གྲུབ་པར་བསྟན་པ་ནི།",
    "དེ་ཡང་རང་བཞིན་འོད་གསལ་བ་དེ་ནི།",
    "རྣམ་པར་རྟོག་པས་དེའི་མཚན་ཉིད་ཅི་འདྲ་ཞིག་བཞག་ཀྱང་རང་བཞིན་འོད་གསལ་དེའི་མཚན་ཉིད་ལ་དངོས་སུ་མི་རིག་པ་ཡིན་ཏེ།",
    "དེ་ཡང་དཔེར་ན་ཆུའི་ཐིག་པ་དུ་མར་རང་རང་སོ་སོའི་ཐད་ཀྱི་སར་ཡོངས་སུ་སྐམ་པར་གྱུར་ན།",
    "གནས་འདི་ལྟ་བུ་ཞིག་ན་སྐྱེས་བུ་ལྷས་བྱིན་གཅིག་པུ་འདུག་གོ་ཞེས་ལྷས་བྱིན་གྱི་ལུས་སེམས་ཀྱི་ཚོགས་པ་དུ་མ་འདུས་པའི་ཕུང་པོ་ཞིག་ལ་གཅིག་ཏུ་བློས་འཛིན་པ་ཡིན་ལ།",
    "འགག་པ་མེད་པ་དང་གཟོད་མ་ནས་ཞི་བ་དང་རང་བཞིན་གྱིས་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་སོགས།",
    "འཛིན་པ་འཁྲུལ་བའི་རྒྱུ་དང་རང་བཞིན་བསྟན་པ།",
    "ཉན་ཐོས་ལ་ཞུགས་པ་དང་འབྲས་བུ་ལ་གནས་པའི་གང་ཟག་བརྒྱད་ཡོད་ཀྱང་རང་རྒྱལ་དང་ཐེག་ཆེན་གཉིས་ལ་དེ་འདྲའི་གང་ཟག་བརྒྱད་མེད་པར་འདོད་པ་ལ་སོགས་པ་ལ་འགལ་བ་དུ་མ་འདུ་བས་སྒྲས་ཟིན་ལྟར་ཁས་ལེན་དུ་མི་རུང་བས་དྲང་དོན་ནོ།",
    "ཡུལ་སྟོང་པ་ཉིད་གཟུང་འཛིན་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ལ་ཡོད་མེད་ཡིན་མིན་འགྲོ་འོང་རྟག་ཆད་སོགས་ཀྱི་སྤྲོས་པའི་མཐའ་རྣམས་འགོག་པའི་ཤེས་རབ་དང་།",
    "ཇི་ལྟ་བ་མཁྱེན་པའི་ཡེ་ཤེས་ཀྱིས་རང་ཉིད་རང་ལ་སྣང་ཞིང་རང་རིག་པའི་ཚུལ་དུ་མཁྱེན་པ་ཡིན་ནོ།",
    "དག་པའི་གསེར་ཁ་དོག་བཟང་ཞིང་རང་བཞིན་མཉེན་པར་འགྱུར་བ་བཞིན་དུ།",
    "བདེ་འགྲོ་བ་རྣམས་ཉན་ཐོས་དང་རང་རྒྱལ་གྱི་གོ་འཕང་ལ་འགོད་པ་དང་།",
    "གྲུབ་པའི་ཁྱད་པར་འགའ་དང་བརྩོན་ལྡན་མིན་ཡང་རང་བཞིན་ལྷན་ཅིག་སྐྱེས་པས་ལུས་གཞན་ངེས་པར་བསྒྱུར།",
    "བརྩོན་ལྡན་མིན་ཡང་རང་བཞིན་ལྷན་ཅིག་སྐྱེས་པས་ལུས་གཞན་ངེས་པར་བསྒྱུར་ཞེས་པ་ནི།",
    "གང་དུ་འདུག་ཀྱང་བག་ཚ་བའམ་འཇིགས་པ་གང་ཡང་མེད་པའི་ཡེ་ཤེས་དང་།",
    "སྐལ་པ་ཇི་ལྟ་བ་བཞིན་དུ་འབྲས་བུ་ཐོབ་པར་འདུག་པས།",
    "ཤེས་རབ་ཀྱི་ལྷ་ཨ་ར་པ་ཙ་ནཱ།",
    "དེ་ལྟར་ཡང་རང་འགྲེལ་ལས།",
    "ཞེས་པའི་སྐབས་ནས་བསྟན་པའི་ཉེས་པ་དེ་ཁྱེད་རང་ལ་ཡང་མཚུངས་སོ།",
    "བ་ལང་མིན་པ་ལས་ལྡོག་པར་མཚུངས་པ་ཉིད་དག་ནི་བ་ལང་རང་མཚན་པ་ལ་ཡོད་པ་ཉིད་ཀྱིས་བ་ལང་དོན་གཉེར་གྱི་སྐྱེས་བུ་བ་ལང་རང་མཚན་པ་ལ་འཇུག་པ་ཡིན་པའི་ཕྱིར།",
    "རྔ་ཞོས་མཚོན་པའི་དངོས་པོ་ཐམས་ཅད་རང་དང་རང་མིན་པ་གཉིས་ཀའི་ངོ་བོ་ཉིད་ཡིན་པས་དེའི་ཐ་དད་པའི་ཁྱད་པར་བསལ་ཞིང་སྤངས་པའི་ཕྱིར།",
    "ཁྱེད་རང་ལ་ཡང་ཉེས་པ་དེ་མཚུངས་སོ་ཞེ་ན།",
    "ཁྱེད་རང་ལ་ཡང་སྔགས་ཡིད་ཀྱིས་བཟླས་པ་དང་།",
    "ཡིད་བློ་དེ་ཡང་རང་འབྲས་མིག་སོགས་ཀྱི་རྒྱུ་ཁྱད་པར་ཅན་མིན་ནམ་ཞེ་ན།",
    "ཕྱིས་རྒན་པོ་འཆི་ཁ་མའི་རིག་པ་སོགས་ཀྱང་རང་འབྲས་རིག་པ་ཕྱི་མ་འཚམས་སྦྱོར་བ་དེ་འདྲར་འགྱུར་བ་ཡིན་ཏེ།",
    "སྐྱེས་བུ་དང་རང་བཞིན་ཐ་དད་དུ་ཤེས་པ་གྲོལ་ལམ་མ་ཡིན་པ་དེའི་ཕྱིར།",
    "བུམ་སྤྱི་དེ་ཡིས་དུས་རྟག་ཏུ་རང་འཛིན་ཤེས་པ་སྐྱེད་ནུས་པའམ་ལན་གཅིག་ཀྱང་རང་འཛིན་ཤེས་པ་སྐྱེད་པའི་ནུས་པ་མེད་པ་ཅན་དུ་ངོ་བོ་ཉིད་ཀྱི་གང་གནས་པའི་ནུས་པ་དེ་ཟད་པར་བྱ་བའི་ཕྱིར་དུ་འགལ་རྐྱེན་གྱི་ནུས་པ་དང་།",
    "ཁྱད་པར་ཤིང་དང་རང་མཚན་པ་དེ་ལ་འཇུག་པའི་དོན་ཅན་ཡིན་པའི་ཕྱིར།",
    "སོ་སོར་རང་རང་ཉམས་སུ་མྱོང་བའི་རང་རིག་མངོན་སུམ་གྱིས་ངེས་པར་རིག་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "ཁོས་ཁོ་རང་རིགས་ཐ་དད་མིན་པར་ནི་རྟོགས་པའི་ཤེས་པ་ལ་ཕན་འདོགས་པ་དེ་བཞིན་ནོ།",
    "རྟོག་པ་ལ་ཤིང་མ་ཡིན་ལས་ལོག་པར་སྣང་བ་ནི་བརྗོད་བྱར་བྱེད་པའི་སྒོ་ནས་ཤིང་མིན་ལས་ལོག་པ་དེའི་མཐར་ཐུག་པ་ཤིང་གསལ་དང་རང་མཚན་པ་རྣམས་དང་བརྒྱུད་ནས་འབྲེལ་པ་ཡིན་པའི་ཕྱིར།",
    "ཐ་སྙད་ཀྱི་དུས་སུ་མ་ཟད་སྔར་ཤིང་བརྡ་སྦྱོར་བ་ཡི་དུས་ན་ཡང་ཤིང་རང་ཉིད་མཐོང་བའི་འབྲས་བུ་ཅན་ཤིང་འཛིན་རྟོག་པ་དོན་མཐུན་དེ་སྔར་བསྟན་པའི་དོན་ཤིང་གསལ་རང་མཚན་པ་དང་བརྒྱུད་ནས་འབྲེལ་བའི་ཕྱིར་ཏེ།",
    "རྟོག་པའང་རྗོད་བྱེད་ཀྱི་སྒྲ་དེ་དང་རང་ཡུལ་ལ་སྤྱིའི་ཚུལ་གྱིས་འཇུག་པར་དོན་གཅིག་པའི་ཕྱིར།",
    "བློ་རྣམས་དག་ནི་ཐམས་ཅད་ཀྱང་རང་ཡུལ་ལ་དུས་འཇུག་པ་མྱུར་བར་མཚུངས་པའི་ཕྱིར།",
    "དེས་ན་སྔོ་སེར་གཉིས་ཀྱིས་སོ་སོ་སོ་སོར་ལྟོས་མེད་དུ་ཡང་རང་འབྲས་མིག་ཤེས་སྐྱེད་ནུས་ལ་ཚོགས་པས་ཀྱང་སྐྱེད་ནུས་པ་འདི་བཞིན་དུ་གཟུགས་དང་བདེ་སོགས་གཉིས་ཀྱང་དེ་དང་མཚུངས་པ་ཡིན་ནོ་ཞེ་ན།",
    "རང་མྱོང་རང་རིག་མངོན་སུམ་གྱི་མྱོང་བྱ་ཉིད་ཡིན་པའི་ཕྱིར།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "སད་ལོག་གཉིས་ཀར་ཡང་རང་ཡུལ་གསལ་བར་སྣང་བ་དེ་ལྟ་མིན་པར།",
    "ཁོ་རང་སྐྱེད་པར་བྱེད་པའི་རྒྱུ་རྣམས་ཐམས་ཅད་ཀྱིས་ཕན་པ་ཉེ་བར་སྦྱོར་ན་ཡང་།",
    "སྔོན་པོ་འཛིན་པའི་དྲན་ཤེས་ཀྱི་ཚུལ་འདིས་སྔོན་པོ་དང་རང་མཚན་པ་གཟུང་དོན་དུ་བྱེད་པའི་ཕྱིར་ཞེ་ན།",
    "ཉེས་པ་དེ་ཁྱེད་རང་ལ་ཡང་མཚུངས་སོ་ཞེ་ན།",
    "བློ་མངོན་གྱུར་དུ་འདོད་ཀྱང་རང་རིག་མེད་པ་མི་འཐད།",
    "ཞེས་པའི་སྐྱོན་དེ་ཁྱེད་རང་ལའང་མཚུངས་སོ་ཞེ་ན།",
    "ཞེས་པའི་སྐྱོན་དེ་ཁྱེད་རང་ལ་ཡང་ཡོད་དེ།",
    "རང་ཚིག་རྣམ་དག་དེ་ཁོ་རང་སྨྲ་བ་པོའི་རྒོལ་བ་བདག་ཉིད་ཀྱིས་ཡིད་ཆེས་ཀྱི་གནས་སུ་ཁས་ལེན་པ་བཞིན་དུ།",
    "ལུང་ཚིག་དང་འགལ་པའི་དམ་བཅའ་ཡང་རང་ཚིག་དང་འགལ་བའི་དམ་བཅའ་ཡིན་པའི་ཕྱིར།",
    "རང་ཉིད་བསླད་པའང་རང་ཉིད་ཀྱིས་ཤེས་པ་མ་ཡིན་ཏེ།",
    "སློབ་དཔོན་ཕྱོགས་གླང་རང་བཞིན་མ་དམིགས་པའི་རྟགས་ཡང་དག་མི་བཞེད་པ་ཡིན་ནམ།",
    "སློབ་དཔོན་ཕྱོགས་གླང་རང་བཞིན་མ་དམིགས་པའི་རྟགས་ཡང་དག་བཞེད་ཀྱང་།",
    "སྤར་ཡང་རང་ཉིད་ལྷ་སྐུར་ལྡང་།",
    "ཨ་ཙ་ར་དཔོན་གཡོག་ཚོ་ལ་སྟོད་བྱང་ལ་བཞུགས་པར་འདུག་ནས།",
    "ལོང་བས་ལོང་བ་ཁྲིད་ནས་འདུག་གསུངས་པས།",
    "བསྐོར་བ་བྱེད་པ་ཡང་མང་འདུག།",
    "ཁོང་རང་ལ་ཡང་སྐོར་ནོར་གླང་ཆེན་སྟོང་དང་།"
