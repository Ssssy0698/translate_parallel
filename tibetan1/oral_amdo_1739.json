    "འདི་ལྟ་བུའི་རང་བཞིན་གྱི་འཇིག་རྟེན་གསུམ་མོ།",
    "དེ་ལྟར་ན་གཉིས་དང་རྣམ་པར་བྲལ་བ་ཉིད་ཡང་དག་པར་རིག་པ་ལ་རང་གི་སྒྲའི་ཟོལ་གྱིས་བསྟན་པ་སྟེ།",
    "འདི་ཞེས་བྱ་བ་ནི་སོ་སོ་རང་གིས་རིག་པའི་སྤྱོད་ཡུལ་ལོ།",
    "བདེ་སྡུག་ཅེས་བྱ་བ་ནི་རྟག་ཏུ་ཉོན་མོངས་པ་སྟེ།",
    "ཞི་བ་ཞེས་བྱ་བ་ནི་གཉིས་ཀྱི་འདྲིད་པ་དང་བྲལ་ཞིང་བརྫུན་པ་མ་ཡིན་པ་ཉིད་ཀྱིས་ཀུན་ནས་ཉོན་མོངས་པ་ཞི་བའོ།",
    "བློ་བཟང་གིས་འདི་ལས་གཞན་དུ་ཡོངས་སུ་རྟོག་པ་ནི་སྒྲིབ་པར་བྱེད་པ་ཉིད་ཀྱིས་ཞེས་སྟོན་པ་ཡིན་ནོ།",
    "དེ་ཡང་ཡུལ་གཞན་རྟོགས་པ་ལས་མ་ཡིན་པ་ཉིད་ཀྱིས་རང་གི་མཚན་ཉིད་ཀྱི་དོན་ལ་ཙམ་གྱི་སྒྲའོ།",
    "འདི་ནི་ཞེས་བྱ་བ་ནི་སོ་སོ་རང་གིས་མངོན་སུམ་དུ་རིག་པའོ།",
    "དེ་དག་ནི་རབ་ཏུ་གསལ་བའི་ཕུལ་དུ་གྱུར་པ་གང་གིས་སོ།",
    "ཚིགས་སུ་བཅད་པ་གཉིས་པོ་འདི་དག་གིས་ནི་དགའ་བའི་མཚན་ཉིད་གསུངས་པ་ཡིན་ལ།",
    "ཆེན་པོ་ཞེས་བྱ་བ་ནི་གང་དུ་ཉེ་བར་བསྟན་པའི་མཚན་ཉིད་བཞི་པོ་དག་གི་ནང་ནས་དེ་ཡང་དག་པར་རྟོགས་པར་བྱེད་པ་ཉིད་ཀྱིས་ཆེན་པོའོ།",
    "ནམ་མཁའི་ནང་ཁྱབ་པ་ནི་སྟོང་པ་ཉིད་བཅུ་དྲུག་གི་རང་བཞིན་ནོ།",
    "སྲིད་པ་གསུམ་ནི་འཇིག་རྟེན་དུ་གདགས་པ་གསུམ་ཉིད་དམ་ལུས་ངག་ཡིད་གསུམ་མོ།",
    "གང་གིས་ནི་རོལ་པ་གང་གིས་སོ།",
    "དེ་ལ་རྣམ་པ་མཐའ་དག་སྤངས་ནས་ནམ་མཁའ་ལ་སྟོང་པ་ཉིད་སྣང་བས་མཛེས་པ་ཉིད་ནི་ཀུན་དུ་འདོད་པའི་རང་བཞིན་གྱི་སྐད་ཅིག་མ་གསུམ་ལས་ཕུལ་དུ་བྱུང་བས་ཆེན་པོ་ཉིད་ཡིན་པ་གང་གི་ཕྱིར་བདེ་བ་ཆེན་པོའི་སྒྲས་བརྗོད་པ་ཡིན་ནོ།",
    "ད་ནི་རང་གཞན་ལྷན་ཅིག་སྐྱེས་པ་དང་རྗེས་སུ་མཐུན་པའི་མོས་པས་ཞི་གནས་སུ་བྱ་བའི་ཕྱིར་ཤིན་ཏུ་ཕྲ་བའི་གཏུམ་མོའི་སྦྱོར་བ་ཁྱད་པར་དུ་བྱ་བ་གསུངས་པ།",
    "འབར་བ་འབའ་ཞིག་གིས་མ་ཡིན་པ་རོ་འཛག་པས་ཀྱང་ངོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "དེ་ཡང་འདི་ལྟར་མོས་པའི་འབྲས་བུ་གཞི་མེད་པ་ཉིད་ཀུན་དུ་མཚུངས་པར་མངོན་དུ་གྱུར་པ་ནི་རྫོགས་པ་སྟེ་མཆོག་ཏུ་ལྷན་ཅིག་སྐྱེས་པའོ།",
    "འདི་ཉིད་ཀྱི་ཕྱིར་གང་དུ་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལྔའི་རང་གི་ངོ་བོ་ཉིད་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དང་གཉིས་སུ་མེད་པ་ཉིད་ནི་ཡོངས་སུ་དག་པའོ།",
    "ངག་གི་ཐ་སྙད་ཀྱིས་རང་དང་གཞན་ལ་ཕན་པ་ཡང་དག་པར་ཉམས་སུ་མྱོང་བར་བྱེད་པས་ལོངས་སྤྱོད་རྫོགས་པ་དང་།",
    "དེ་ལྟར་ཡང་སྣ་ཚོགས་པའི་རྩྭ་དང་ཤིང་གི་ནགས་བསྲེགས་པ་ན་ནམ་མཁའ་ལ་དབྱེ་བ་མེད་པ་དེ་བཞིན་དུ་མ་ལུས་པའི་བག་ཆགས་ནུབ་པ་ན་དེ་བཞིན་ཉིད་དུ་དབྱེ་བ་མེད་པའོ།",
    "ཕྲ་མོའི་རང་བཞིན་ཞེས་པས་ནི་དམིགས་པ་བརྗོད་པ་སྟེ།",
    "དམིགས་པས་སྟོང་པས་ན་མཆོག་གི་བདེ་བར་རོ་གཅིག་པ་སྟེ།",
    "སྣང་བ་ནི་གང་གི་སྟེ།",
    "རང་གི་འདོད་པས་འཇུག་པ་ཡིས།",
    "རྣམ་རྟོག་རྗེས་སུ་སོང་གྱུར་པ།",
    "ཀ་དམྦ་སྟེ་གླིང་བུ་གོ་ལ་ཀའི་རོལ་མོའི་སྒྲ་ལྟ་བུར།",
    "དེ་བཞིན་དུ་གཅིག་གི་དངོས་པོ་ཉིད་ལ་ཞེས་བྱ་བ་ལ་དངོས་པོ་ནི་ཡུལ་ཏེ་ཡང་ཞེས་པའི་དོན་ཅན་ནོ།",
    "རང་གི་འདོད་པས་ཉེ་བར་བཏགས་པ་ཙམ་མོ།",
    "རིགས་ཀྱི་བུ་གང་བྱིས་པར་གྱུར་པས་རང་བཞིན་ཡོངས་སུ་མ་ཤེས་པར་ཟྭ་ལྡུམ་ལ་རེག་པས་སྡུག་བསྔལ་བར་འགྱུར་རོ།",
    "དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་ཏེ་ངོ་བོ་ཉིད་རྣམ་པར་དཔྱད་པ་གང་གི་ཚེ་འདི་རྣམས་ཤེས་པའི་རྣམ་པ་ཉིད་དང་།",
    "དེའི་ཚེ་དེ་རྣམས་རང་བཞིན་མེད་པའི་དངོས་པོ་ཡིན་པ་ཉིད་ཀྱིས་རང་གི་ངོ་བོ་རང་བཞིན་མེད་པའོ།",
    "བྱ་བ་དང་བྱེད་པ་པོའི་དབྱེ་བ་ཅུང་ཟད་ཀྱང་མེད་པ་ཇི་ལྟ་བར་ཉོན་མོངས་པ་སྤོང་བ་དང་གཉེན་པོ་བསྟེན་པ་ཡང་ཡོད་པ་མ་ཡིན་པས་དེ་རབ་ཏུ་གོ་བར་བྱ་བ་གསུངས་ནས།",
    "འདི་དག་གིས་བདེ་བ་ཆེན་པོ་འབའ་ཞིག་གི་རང་བཞིན་གསལ་བར་བྱས་སོ།",
    "ལྷན་ཅིག་སྐྱེས་པ་ནི་ཀུན་ནས་ཉོན་མོངས་པ་ལ་བརྟེན་པའི་འདོད་ཆགས་ལ་སོགས་པས་སྟོང་པ་མཆོག་ཏུ་ཞི་བའི་དངོས་པོ་སྟེ།",
    "དེ་ནི་ཉོན་མོངས་པ་འཇོམས་པར་བྱེད་པ་དང་རང་བཞིན་གྱིས་དགའ་བ་ཉིད་དེ།",
    "གཉིས་པོ་འདི་དག་གི་ཆེ་བའི་བདག་ཉིད་ཀྱང་གསུངས་པ་ནི་འདི་ནི་ཞེས་བྱ་བ་སྟེ།",
    "རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ཀྱི་རང་བཞིན་ཡོངས་སུ་དག་པ་རྣམས་ནི་དཀར་མོ་ལ་སོགས་པའི་རྣལ་འབྱོར་མ་རྣམས་སོ།",
    "དེ་ཉམས་སུ་མྱོང་བའི་རང་གི་ངོ་བོ་ཉིད་ཉེ་བར་བསྟན་པ་གསུངས་པ།",
    "གང་གི་ཕྱིར་འགྲོ་བ་ལྷན་ཅིག་སྐྱེས་པའི་རྣམ་འཕྲུལ་ཡིན་པས་སོ།",
    "གང་གི་ཕྱིར་དེ་ལྟ་ཡིན་པ་དེའི་ཕྱིར་ཚོགས་ཐམས་ཅད་ཀྱང་དྲི་མ་མེད་པའི་ལྷན་ཅིག་སྐྱེས་པ་སྲིད་པ་དང་ཞི་བ་ལ་མི་གནས་ཤིང་ཉོན་མོངས་པ་མ་ལུས་པ་སྤངས་པས་རྣམ་པར་དག་པ་ཉིད་དུ་གྱུར་པ་ལ་བརྟེན་པ་ཡིན་ནོ།",
    "བཅོས་མ་མ་ཡིན་པའི་ང་རྒྱལ་རབ་ཏུ་བྱེད་པས་མཆོག་གི་བདེ་བའི་ཚོགས་ཉམས་སུ་མྱོང་བ་ལས་རྣལ་འབྱོར་པས་ཚོགས་གཉིས་པོ་རྫོགས་པར་བྱེད་པའོ།",
