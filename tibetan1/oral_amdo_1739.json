    "འབྲས་བུ་རེ་བ་སྒོམ་མ་བྱེད།",
    "འབྲས་བུ་རེ་བ་སྒོམ་མ་བྱེད།",
    "འབྲས་བུ་རེ་བ་སྒོམ་མ་བྱེད།",
    "ཨ་བ་དྷཱུ་ཏཱི་གཉིས་མེད་རྡོ་རྗེས་མཛད་པ་ཨ་མ་ར་སིང་གི་གླུ་རྫོགས་སོ། ། གང་ཡང་མི་སྐྱེ་མི་འགག་དངོས་པོ་བཅིང་བ་མེད།",
    "ཟབ་མོ་ཟབ་མོ་འཇིག་རྟེན་ཀུན་སྨྲ་ཡང་།",
    "ཀྱེ་སེམས་ཀྱི་ཟབ་མོ་ཤེས་པར་དཀའ་བས་ན།",
    "ཀྱེ་སེམས་ཀྱི་ཟབ་མོ་ཤེས་པར་དཀའ་བས་ན།",
    "ཀྱེ་སེམས་ཀྱི་ཟབ་མོ་ཤེས་པར་དཀའ་བས་ན།",
    "ཀྱེ་སེམས་ཀྱི་ཟབ་མོ་རྟོགས་པར་དཀའ་བས་ན།",
    "བདག་གིས་སྟོང་པའི་རྣལ་འབྱོར་མ་དེ་མཐོང་།",
    "བདག་གིས་སྟོང་པའི་རྣལ་འབྱོར་མ་དེ་མཐོང་།",
    "བདག་གིས་སྟོང་པའི་རྣལ་འབྱོར་མ་དེ་མཐོང་།",
    "བདག་གིས་སྟོང་པའི་རྣལ་འབྱོར་མ་དེ་མཐོང་།",
    "དེ་ཡི་འདི་ཡིན་གཉིས་མེད་སོང་།",
    "མི་གནས་རང་བཞིན་བུང་བ་ཁྱོད་ནི་བསྒོམ།",
    "རྨི་ལམ་བུད་མེད་དེ་བཞིན་མེད་པ་སྟེ།",
    "འདོད་པའི་མདུང་གིས་རང་ལ་ཅི་སྟེ་ཟུག།",
    "རྣམ་རྟོག་སྒྲོག་གིས་དམ་བཅིངས་ཏེ།",
    "རེ་དོགས་མེད་ལ་ཕྱག་རྒྱ་ཆེ།",
    "འཐུང་བའི་བེའུ་ནི་རང་གི་སེམས་ཉིད་ཡིན།",
    "བ་འཇོ་སྣོད་གསོལ་ག་རེ་མཱ་མ་ཀཱི།",
    "དགའ་དང་མི་དགའ་ཁྱོད་མ་བྱེད།",
    "ལྡན་དང་མི་ལྡན་ཁྱོད་མ་བྱེད།",
    "མཐུན་དང་མི་མཐུན་ཁྱོད་མ་བྱེད།",
    "རེ་དང་དོགས་པ་ཁྱོད་མ་བྱེད།",
    "བདག་གི་ཡིད་ལ་དོན་གཅིག་འཇུག་པ་མེད།",
    "ད་ལྟ་རེ་བ་མེད་དེ་བ་ད་སྨྲ།",
    "ད་ལྟ་རེ་བ་མེད་དེ་བ་ད་སྨྲ།",
    "ད་ལྟ་རེ་བ་མེད་དེ་བ་ད་སྨྲ།",
    "ད་ལྟ་རེ་བ་མེད་དེ་བ་ད་སྨྲ།",
    "བདག་གི་གོ་རིམས་བྱེད་པ་ཡིན།",
    "ཉོན་མོངས་ཞི་བར་བྱེད་པ་ཡིན།",
    "གཅེས་པའི་ཡོན་ཏན་དྲི་མེད་ཟབ་མོ་ཡོད།",
    "ཨུཏྤལ་ཆུ་ནང་བཏུས་ན་ཆུས་མི་རེག།",
    "ཨུཏྤལ་ཆུ་ནང་བཏུས་ན་ཆུས་མི་རེག།",
    "ཨུཏྤལ་ཆུ་ནང་བཏུས་ན་ཆུས་མི་རེག།",
    "ཨུཏྤལ་ཆུ་ནང་བཏུས་ན་ཆུས་མི་རེག།",
    "དེ་ཡི་ཚེ་ན་གང་གིས་བཅིངས་པར་སེམས།",
    "བདེ་གཤེགས་ཀུན་གྱི་བཙུན་མོ་མིང་མེད་མ།",
    "འཕགས་པའི་ནོར་ཆེན་རང་གི་སེམས་ལ་ཆོངས།",
    "ཤིན་ཏུ་ངོ་མཚར་བདག་གིས་གཏམ།",
    "ལྷན་ཅིག་སྐྱེས་པའི་གཡུང་མོ་མི་སྤང་ངོ།",
    "༡༩༢འཇམ་དཔལ་དམར་སེར་དཔའ་གཅིག་གི་སྒྲུབ་ཐབས།་",
    "༢༡༦གནོད་སྦྱིན་མོ་ཉེ་བརྒྱད་སྒྲུབ་པའི་ནང་ཚན་གནོད་སྦྱིན་གཞོན་ནུ་མ།་",
    "༢༤༡དབྱངས་ཅན་མ་དམར་མོའི་གསང་སྒྲུབ་ཛྙཱན་དརཤ།་",
    "༢༤༤བོ་དོང་ལུགས་ཀྱི་དབྱངས་ཅན་དམར་མོའི་གསང་སྒྲུབ་ལྷ་ལྔ།་",
    "༢༦༤འཕགས་པ་སྤྱན་རས་གཟིགས་སེང་གེ་སྒྲའི་སྒྲུབ་ཐབས་ཡིད་བཞིན་རེ་སྐོང་།་",
    "༢༧༣མི་འཇིགས་པ་སྦྱིན་བྱེད་མཆོག་ཏུ་ཟབ་པ་རིག་པའི་ལྷ་མོ་ལྔའི་སྒྲུབ་ཐབས།་",
    "༢༧༤གཉིས་པ་རྒྱལ་མཚན་རྩེ་མོ་དཔུང་རྒྱན་གྱི་སྒྲུབ་ཐབས།་",
    "༢༨༡ལྔ་པ་རྨ་བྱ་ཆེན་མོའི་སྒྲུབ་ཐབས།་",
    "༢༨༢རིག་པའི་རྒྱལ་མོ་གསུམ་གྱི་སྒྲུབ་ཐབས།་",
    "༢༨༣པདྨའི་རིགས་ཀྱི་རྒྱལ་མོ་གོས་དཀར་མོ་བསྒྲུབ་པར་འདོད་པས་སོགས།་",
    "༢༨༥སྤྱན་གཟིགས་ཡི་གེ་ཕྱེད་དང་བཞི་བའི་སྒོམ་བཟླས།་",
    "༢༨༧ལྷ་མོ་སྐུལ་བྱེད་མའི་སྒོ་ནས་རྨི་ལམ་བརྟགས་ཅིང་པྲ་དབབ་པའི་ཆོ་ག་༢༨༨ནོར་གྱི་རྒྱུན་མ་བསྒྲུབ་པར་འདོད་པས།་",
    "༢༩༡སྟོབས་པོ་ཆེའི་སྒྲུབ་ཐབས་ཟབ་མོ།་",
    "༢༩༩རྨ་བྱ་ཆེན་མོའི་སྒོམ་བཟླས།་",
    "༣རྒྱལ་མཚན་རྩེ་མོའི་དཔུང་བརྒྱན་གྱི་སྒོམ་བཟླས།་",
    "༣༣གདུགས་དཀར་མོ་བསྒྲུབ་པར་འདོད་པས།་",
    "༣༢༥དབྱངས་ཅན་དཀར་མོའི་སྒྲུབ་ཐབས།་",
    "༣༧༣དཔལ་ཡང་དག་གི་སྒོ་ནས་ཉམས་ཆག་སྦྱོང་ཐབས།་",
    "༤༦༡ཚེ་བདག་བསྙེན་ཡིག་གི་ལྷན་ཐབས་དངོས་གྲུབ་སྒོ་འབྱེད།་",
    "ན་མོ་མཉྫུ་ཤྲཱི་དྷརྨ་དྷཱ་ཏུ་ཝཱ་གཱི་ཤྭ་རཱ་ཡ།",
    "རང་ཉིད་མོས་པའི་ཕྱིར་དང་སྐལ་མཉམ་འགྲོ།",
    "ཐུན་མོང་དང་ཐུན་མོང་མིན་པ་གཉིས་ལས།",
    "ཐུགས་སྲོག་སྔགས་ཕྲེང་ལས་བདུད་རྩི་དཀར་པོའི་རྒྱུན་བབས་པ་རང་གི་ཚང་བུག་ནས་ཞུགས་ཏེ་སྡིག་སྒྲིབ་ཉམས་ཆག་ཐམས་ཅད་སྦྱང་བར་བསམ་ལ།",
    "གསོལ་བ་བཏབ་པས་རྡོར་སེམས་ཡབ་ཡུམ་འོད་དུ་ཞུ་ནས་རང་ལ་ཐིམས་པས་རྡོ་རྗེ་སེམས་དཔའི་སྐུ་གསུང་ཐུགས་ཡེ་ཤེས་རྡོ་རྗེ་དང་དབྱེར་མེད་དུ་གྱུར་པར་བསམ་མོ།",
    "རང་གི་གཙུག་ཏོར་གྱི་སྟེང་དུ་ཝཾ་ཡིག་ཡོངས་གྱུར་རྡོ་རྗེ་ཟླ་བའི་དཀྱིལ་འཁོར་ཆ་བཅུ་དྲུག་པ་ཡོངས་སུ་རྫོགས་པ།",
    "དེ་ཞུ་བ་རང་གི་ལུས་ལ་ཞུགས་པས་སྤྱི་གཙུག་ནས་རྐང་སེན་གྱི་བར་དུ་མ་དག་པའི་ལུས་སྦྲུལ་གྱི་ཤུན་པ་ལྟར་ལན་གསུམ་དོར་ཏེ།",
    "རྩེ་མོའི་ཚིགས་ལ།",
    "ལག་གཡས་མཐེ་བོ་ལ་སོགས་པའི་རྩེ་མོའི་ཚིགས་ལ།",
    "གུང་མོ་གཉིས་མཉམ་དུ་བརྐྱངས་པའི་རྒྱབ་ཏུ་མཛུབ་མོ་གཉིས་ཕྱེད་འཁྱོགས་པའི་ཚུལ་དུ་བཞག།",
    "སྤྱི་བོའི་གཙུག་ནས་རྐང་སེན་བར་ལུས་ཐམས་ཅད་ལ་རེག་ཅིང་།",
    "ཡན་ལག་རྣམས་ལ་རེག་སྟེ།",
    "བསྡུ་ན་ཞིང་སྐྱོང་གི་གཏོར་མ་བཤམས་ལ།",
    "རྡོ་རྗེ་འཆང་གི་བཀའ་བཞིན་མཛོད་སྭཱ་ཧཱ།",
    "དཔྲལ་བར་ཟླ་དཀྱིལ་ལ་ཨོཾ་དཀར་པོ་ལས་རྡོ་རྗེ་དཀར་པོ་རྩེ་མོ་བཅུ་བདུན་པ།",
    "ལྟེ་བར་དུས་མེའི་དཀྱིལ་འཁོར་ལ་ཧོ་སེར་པོ་ལས་རྡོ་རྗེ་སེར་པོ་རྩེ་མོ་དྲུག་ཅུ་རྩ་ལྔ་པ།",
    "གཙུག་ཏོར་དུ་ནམ་མཁའི་དཀྱིལ་འཁོར་ལ་ཧཾ་ལྗང་གུ་ལས་རྡོ་རྗེ་ལྗང་གུ་རྩེ་མོ་ལྔ་པ།",
    "གསང་བར་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་ལ་ཀྵ་སྔོན་པོ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་མོ་སུམ་ཅུ་རྩ་གསུམ་པ་རྣམས་བཀོད།",
    "ག་གི་རག་ྀ་གུ་གླྀ་གཾཁ་ཁི་ཁརྀ་ཁུ་ཁླྀ་ཁཾ།",
    "རྣམས་ལས་བྱུང་བའི་རྡོ་རྗེ་ལྗང་གུ་རྩེ་མོ་སུམ་ཅུ་རྩ་གཅིག་པ་དང་།",
    "རྩེ་མོ་བདུན་པ་རྣམས་སུ་གྱུར།",
    "རྩེ་མོ་སོ་གཅིག་པ་རྣམས་ཕྲག་པ་སོགས་ཚིགས་ཆེན་དང་།",
    "དེ་བཞིན་དུ་གཡོན་གྱི་གྲུ་མོ་དང་།",
    "འདི་ལ་ཉེ་བའི་དཔུང་ཚོགས་ཀྱང་ཟེར།",
    "དབྱངས་དྲུག་གིས་སྤེལ་བ་སུམ་ཅུ།",
    "གཡས་ཀྱི་གྲུ་མོ་དང་མཐེ་བོང་ལ་སོགས་པའི་དབུས་ཀྱི་ཚིགས་རྣམས་སུ།",
    "རྣམས་དབྱངས་དྲུག་གིས་སྤེལ་བ་སུམ་ཅུ་རྣམས།",
    "ལས་བྱུང་བའི་རྡོ་རྗེ་ནག་པོ་རྩེ་མོ་སུམ་ཅུ་རྩ་གཅིག་པ་དང་།",
    "རྩེ་མོ་བདུན་པ་རྣམས་སུ་གྱུར།",
    "དྲུག་གིས་སྤེལ་བ་སུམ་ཅུ་དང་།",
    "དྲུག་གིས་སྤེལ་བས་སུམ་ཅུ་ཡིན་ལ་དེ་ཡང་ཚིགས་ཆེན་རྣམས་ལ་ཡི་གེ་སུམ་ཅུ་དང་།",
    "ཚིགས་དང་མཐེའུ་ཆུང་ལ་སོགས་སོར་མོའི་སྟེང་གི་ཚིགས་རྣམས་སུ།",
    "གཡས་ཀྱི་མཁྲིག་ཚིགས་དང་མཐེ་བོང་ལ་སོགས་པའི་སྟེང་གི་ཚིགས་རྣམས་སུ།",
    "རྣམས་ལས་བྱུང་བའི་རྡོ་རྗེ་དམར་པོ་རྩེ་མོ་སུམ་ཅུ་རྩ་གཅིག་པ་དང་རྩེ་མོ་བདུན་པ་རྣམས་སུ་གྱུར།",
    "རྣམས་ལས་བྱུང་བའི་རྡོ་རྗེ་དཀར་པོ་རྩེ་མོ་སུམ་ཅུ་རྩ་གཅིག་པ་དང་རྩེ་མོ་བདུན་པ་རྣམས་སུ་གྱུར།",
    "རྐང་པ་གཡོན་གྱི་པུས་མོ་དང་།",
    "རྐང་པ་གཡས་ཀྱི་པུས་མོ་དང་མཐེ་བོང་ལ་སོགས་པའི་དབུས་ཀྱི་ཚིགས་རྣམས་སུ།",
    "རྣམས་ལས་བྱུང་བའི་རྡོ་རྗེ་སེར་པོ་རྩེ་མོ་སུམ་ཅུ་རྩ་གཅིག་པ་དང་རྩེ་མོ་བདུན་པ་རྣམས་སུ་གྱུར།",
    "རྣམས་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་མོ་སུམ་ཅུ་རྩ་གཅིག་པ་དང་།",
    "རྩེ་མོ་བདུན་པ་རྣམས་སུ་གྱུར།",
    "རྣ་བ་གཡོན་དང་གཡས་པར་ཨ་ཨཱ་ལྗང་གུ་ལས་རྡོ་རྗེ་ལྗང་གུ་རྩེ་མོ་གསུམ་པ།",
    "ཡིད་དང་ཁུ་བའི་རྩ་ཨ་བ་དྷུ་ཏིའི་ཡར་སྣ་མར་སྣ་ལ་ཨཾ་ཨཱ་སྔོན་པོ་ལས་རྡོ་རྗེ་སྔོན་པོ་རྩེ་མོ་གསུམ་པ་གཙུག་ཏོར་དང་མགོ་བོར་ཧ་ཧཱ་ལྗང་གུ་ལས་རྡོ་རྗེ་ལྗང་གུ་རྩེ་མོ་ལྔ་པ།",
    "སྐུ་གསུང་ཐུགས་རྣམ་པར་དག་པ་རྡོ་རྗེའི་ཁང་པ་གསུམ་བརྩེགས་པ་སྟེང་འོག་གི་ཚད་ཁྲུ་ཉིས་བརྒྱ་པའི་དབུས་སུ་འཁོར་ལོ་རྩིབས་བཅུ་པ་དང་བཅས་པ་སྟེ་དེ་ཡང་ཁང་པ་བརྩེགས་པ་བར་མའི་དབུས་སུ་ནང་སྟོང་པ་སྦུབས་ཅན་གྱི་འཁོར་ལོ་རྩིབས་བཅུ་བའི་རྩིབས་བརྒྱད་ཁང་བརྩེགས་བར་མའི་ནང་དང་།",
    "སྟེང་འོག་གི་རྩིབས་གཉིས་སྟེང་དང་འོག་གི་ཁང་པ་བརྩེགས་པའི་ནང་དུ་སོན་པའི་དབུས་ཀྱི་ལྟེ་བའི་ནང་དུ་ཁྲུ་བཅུ་གཉིས་པའི་སྣ་ཚོགས་པདྨ་འདབ་མ་བརྒྱད་པའོ།",
    "བཞི་དཀར་པོ་སྟེ་ཕྱག་གི་པདྨ་ཉི་ཤུ་རྩ་བཞི་དང་།",
    "མཛུབ་མོ་དཀར་པོ།",
    "གུང་མོ་དམར་པོ།",
    "རྩེ་མོའི་ཚིགས་རྣམས་དཀར་པོའོ།",
    "བདུད་ཀྱི་མགོ་བོ་དང་ཁྲག་གིས་གང་བའི་ཐོད་པ་བསྣམས་པ།",
    "གཡོན་པ་དཀར་པོ་བསྐུམ་པས་བདུད་དང་ཉོན་མོངས་པ་དང་ཡི་དྭགས་ཀྱི་གདན་ལ་གནས་པའོ།",
    "དབུ་རེ་རེ་ལའང་ཧ་ཧི་ཧྲྀ་ཧུ་ཧླྀ་ལས་བྱུང་བའི་ཐོད་པ་ལྔའི་དབུ་རྒྱན་དང་ལྡན་པ།",
    "ཀྵ་ལས་བྱུང་བའི་སྟག་གི་པགས་པའི་ཤམ་ཐབས་མནབ་པ།",
    "བཾ་ལས་བྱུང་བའི་སྐུ་ལ་ཐལ་ཆེན་གྱིས་བྱུགས་པའོ།",
    "བདག་གི་ཐུགས་ཀར་ཉི་མའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་རལ་གྲི་གྲི་གུག་རྩེ་གསུམ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་མེ་ཡི་མདའ་དང་།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་ཐོ་བ་མདུང་དང་རྩེ་གསུམ།",
    "ཕྱག་དྲུག་གི་གཡས་གསུམ་འཁོར་ལོ།",
    "ཕྱག་རྒྱ་དྲུག་གིས་སྤྲས་པ།",
    "སླར་ཡང་རང་གི་ཐུགས་ཀར་ཉི་མའི་སྟེང་དུ།",
    "དེ་གཉིས་རྣ་བ་གཡོན་དང་གཡས་ནས་ཕྱུངས་ཏེ་ར་བ་གསུམ་པའི་ནང་གི་ཁྱོན་གྱི་ཚད་ཀྱི་སྟེང་དུ་ངང་པ་དང་།",
    "འོག་ཏུ་མཁའ་ལྡིང་གི་གདན་ལ་འཁོད་དེ་གནས་པར་གྱུར།",
    "ལྷོ་ནུབ་ཏུ་ལུག་གི་གདན་ལ་འཁོད།",
    "བྱང་ཤར་དུ་ཁྱུ་མཆོག་གི་གདན་ལ་འཁོད།",
    "སླར་ཡང་རང་གི་ཐུགས་ཀར་ཉི་དཀྱིལ་ལ།",
    "ར་བ་གསུམ་པའི་ཕྱི་རོལ་གྱི་ཁྱོན་གྱི་ཚད་ཀྱི་སྟེང་དུ་ནམ་མཁའ་དང་།",
    "སླར་ཡང་རང་གི་ཐུགས་ཀའི་ཉི་དཀྱིལ་ལ།",
    "ར་བ་ལྔ་པའི་ནང་གི་ཁྱོན་གྱི་ཚད་ཀྱི་སྟེང་དུ་ནམ་མཁའ་དང་འོག་ཏུ་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་ལ་འཁོད།",
    "སླར་ཡང་རང་གི་ཐུགས་ཀའི་ཉི་དཀྱིལ་ལ།",
    "ར་བ་ལྔ་པའི་ཕྱི་རོལ་གྱི་ཁྱོན་གྱི་ཚད་ཀྱི་སྟེང་དུ་ནམ་མཁའ་དང་འོག་ཏུ་ཡེ་ཤེས་ཀྱི་དཀྱིལ་འཁོར་ལ་འཁོད།",
