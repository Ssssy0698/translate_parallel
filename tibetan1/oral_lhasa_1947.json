    "འདུས་བྱས་སྟོང་པ་ཉིད་མྱི་སྡུག་གོ་ཞེས་བྱ་བར་སྟོན་ཅིང་།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་བདག་མྱེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་མྱི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དེ་ལྟར་དེ་དག་འདུས་བྱས་སྟོང་པ་ཉིད་མྱི་རྟག་གོ་ཞེས་བྱ་བར་རྟོག་པ་དང་།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ལོ་ཞེས་བྱ་བར་རྟོག་པ་དང་།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་བདག་མྱེད་དོ་ཞེས་བྱ་བར་རྟོག་པ་དང་།",
    "འདུས་བྱས་སྟོང་པ་ཉིད་མྱི་སྡུག་གོ་ཞེས་བྱ་བར་རྟོག་པས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མྱི་རྟག་གོ་ཞེས་བྱ་བར་སྟོན།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ལོ་ཞེས་བྱ་བར་སྟོན།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་བདག་མྱེད་དོ་ཞེས་བྱ་བར་སྟོན།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མྱི་སྡུག་གོ་ཞེས་བྱ་བར་སྟོན་ཅིང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་བདག་མྱེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མྱི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དེ་ལྟར་དེ་དག་འདུས་མ་བྱས་སྟོང་པ་ཉིད་མྱི་རྟག་གོ་ཞེས་བྱ་བར་རྟོག་པ་དང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ལོ་ཞེས་བྱ་བར་རྟོག་པ་དང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་བདག་མྱེད་དོ་ཞེས་བྱ་བར་རྟོག་པ་དང་།",
    "འདུས་མ་བྱས་སྟོང་པ་ཉིད་མྱི་སྡུག་གོ་ཞེས་བྱ་བར་རྟོག་པས།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་བདག་མྱེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མཐའ་ལས་འདས་པ་སྟོང་པ་ཉིད་མྱི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་བདག་མྱེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཐོག་མ་དང་ཐ་མ་མྱེད་པ་སྟོང་པ་ཉིད་མྱི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་བདག་མྱེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དོར་བ་མྱེད་པ་སྟོང་པ་ཉིད་མྱི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་བདག་མྱེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "རང་བཞིན་སྟོང་པ་ཉིད་མྱི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "མྱི་མྱིག་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་བདག་མྱེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "མྱི་དམྱིགས་པ་སྟོང་པ་ཉིད་མྱི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་མྱི་རྟག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་སྡུག་བསྔལ་ཞེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་བདག་མྱེད་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "དངོས་པོ་མྱེད་པ་སྟོང་པ་ཉིད་མྱི་སྡུག་ཅེས་བྱ་བར་རྟོག་པར་འགྱུར་རོ།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་གཟུགས་བརྙན་ལ་སྤྱོད་པར་འགྱུར་རོ།",
