    "ཞེས་གསུངས་པ་སོགས་བྱུང་འདུག་ཅིང་།",
    "ཤོག་༡༤ བ་༥ རྗེ་རང་ཉིད་ཀླུ་སྒྲུབ་ཀྱི་སྤྲུལ་པར་གདོན་མི་ཟ་བ་འདུག་པས།",
    "ད་ས་སྐྱ་འདི་སུས་འཛིན་ན་ཞེས་ངུ་ཞིང་འདུག།",
    "ཕྱག་རྒྱ་པ་གཉིས་ཀ་ལ་མ་བྱུང་བར་འདུག་སྙམ་དུ།",
    "སྐྱེ་བ་ཕྱི་མ་འདི་ལྟར་འགྱུར་སྙམ་པའང་དཀོན་པར་གདའ།",
    "ཁྱེད་རང་གང་དུ་བཞུགས་པའི་ཞིང་ཁམས་དེར།",
    "རྗེ་ཉིད་ཞལ་ཤིན་ཏུ་ནས་འཛུམ་ཞིང་བཞད་ཆུང་དང་སྦྲགས་ནས་ད་ཅི་གདའ་ཞེས་ཡང་ཡང་གསུངས་ཤིང་།",
    "ཡང་རྒྱ་གར་དུ་སྐྱེས་ན་ཤཱན་ཏི་པ་དང་མཉམ་པ་ཡོང་བ་འདུག་གསུང་ངོ།",
    "ད་ས་སྐྱ་འདི་སུས་འཛིན་ན་ཞེས་ངུ་ཡིན་འདུག།",
    "བསྟན་པ་འཛིན་མཁན་གཅིག་འདུག་པ་དེ་མེད་པར་བྱས་པས་ཅི་ཙུག་བྱེད།",
    "ཐམས་ཅད་མཁྱེན་པ་བློ་བཟང་གྲགས་པ་བསྟན་པའི་སྲོག་ཤིང་དུ་འདུག་པ།",
    "འདི་མིན་པ་སུས་ཀྱང་མ་ཤེས་པར་འདུག་པས་འདི་ལ་འཁོར་གྱིན་ཡོད་ནའང་།",
    "ཕྱག་རྒྱ་པ་གཉིས་ཀ་ལ་མ་བྱུང་འདུག་པས།",
    "སྐྱེ་བ་ཕྱི་མའང་ཇི་ལྟར་འགྱུར་རམ་སྙམ་པའང་སེམས་མཁན་དཀོན་པར་གདའ།",
    "བསྟན་པའི་འཇུག་སྡུད་པའི་མགོ་ཡང་བརྩམས་འདུག།",
    "ཁྱེད་རང་གང་དུ་བཞུགས་པའི་ཞིང་ཁམས་དེར།",
    "ཕུན་སུམ་ཚོགས་པའི་རྣམ་པ་ཆེ་ཆུང་ཅི་འདུག་པ་དང་།",
    "ཁོང་པས་འགྲོ་མགོན་དཔལ་ཡེ་པ་ལས་གསན་འདུག་ཅིང་།",
    "ཚུལ་རྒྱལ་བ་གཉིས་ལ་གསན་འདུག།",
    "འདི་ལ་ཡར་ཀླུངས་པ་གྲགས་པ་རྒྱལ་མཚན་ནས་བརྒྱུད་པའི་བཀའ་ཡང་འདུག་ཅིང་།",
    "འདི་ལ་ལྷ་ཉི་ཤ་རྩ་ལྔ་འདུག་ཅིང་།",
    "བརྒྱུད་པ་འདི་འདྲ་ཞིག་ཀྱང་སྣང་སྟེ་འཕགས་ལུགས་ཀྱི་བརྒྱུད་པ་མིན་པར་འདུག།",
    "གཞན་རྣམས་གསན་པ་ཡིན་པར་འདུག།",
    "ཁོ་རང་ཀུན་རྫོབ་ཙམ་སྤྱོད་པའི་བློ་ཡིན་ཀྱང་རང་བཞིན་མེད་རྟོགས་ཀྱི་ཤེས་རབ་ཀྱིས་ཟིན་པའི་སྒོ་ནས་དེའི་ཚེའང་ཡོད་པར་མི་འགལ་ལོ་ཞེ་ན།",
    "དེ་ཡང་རང་དགར་རང་སྟོབས་ཀྱིས་སློབ་ཚུལ་ཤེས་མི་ནུས་ཤིང་།",
    "ཁྱེད་རང་ཡང་ཁས་མི་ལེན་པའི་ཕྱིར་རོ།",
    "ཤོག་༤༦ བ་༣ ཞོལ་གཙང་ཕྲེང་གསུམ་ལྷག་པོ་ཡོད་འདུག་ཞོལ།",
    "རྐུན་པོ་སླར་ནང་དུ་མི་ལྡོག་པར་བྱས་པའི་སྒོ་ནས་ཕྱུང་བ་དང་སྒོ་ཕར་བཅད་པ་དུས་མཉམ་པ་ལྟར་གཉེན་པོ་བར་ཆད་མེད་ལམ་སྐྱེ་བ་དང་མི་མཐུན་པའི་ཕྱོགས་དགག་པ་དག་དུས་མཉམ་ཞིང་།",
    "ཨ་ར་པ་ཙ་ན་ལ་སོགས་པའི་ཡི་གེ་ལ་དམིགས་ནས།",
    "མེའི་འབྲས་བུ་རྒྱུན་ཆད་དགོས་པར་འདོད་པ་དང་ཁྱད་པར་ཅི་འདུག་སོམས་ཤིག།",
    "སྐད་ཅིག་ཀྱང་རང་གྲུབ་དུས་ལས།",
    "ཡུལ་ཅན་དག་པས་ཡུལ་དག་མི་དགོས་པའང་རང་ཚིག་འགལ་བ་ཡིན་ནོ།",
    "མི་མཐུན་ཕྱོགས་ཀྱི་གཞི་ཤེས་ཞེས་བྱའི་གཞི་ཤེས་ཁོ་རང་བྱང་སེམས་ལམ་གྱི་སྤོང་བ་ག་ལ་ཡིན།",
    "ཇི་ལྟར་མི་དག་ནགས་ཀྱི་ཁྲོད་འདུག་སྟེ།",
    "དེ་ཡང་ཉན་ཐོས་དང་རང་རྒྱལ་དང་ཐེག་ཆེན་གྱི་ཐར་ཆ་གསུམ་ལ་འཆད་པ་ནི་རྣམ་པར་འཁྱམས་ཏེ།",
    "གཉིས་པ་སེམས་ཙམ་རྣམ་བདེན་པ་དང་རང་རྒྱལ་གྱི།",
    "གཟུགས་སྐུ་རང་བཞིན་དང་རང་བཞིན་ཅན་ཡིན་པས་ཁོངས་སུ་འདུ་བའི་ཕྱིར།",
    "རྟོག་པ་དང་དེ་མྱོང་རང་རིག་བཞིན་ནོ།",
    "འདུག་པ་ལྟར་མི་གཡོ་བ་དང་།",
    "ལ་ལས་དཔོན་གནས་ལམ་ལུགས་སོགས་ལ་ཞིབ་འཇུག་བགྱིས་འདུག་པ་ལས་དཔེ་ཙམ་དྲངས་ན།",
    "བཀའ་དྲིན་ཆེ་བའི་ཚོད་དུ་གདའ།་",
    "དེ་ཡང་སྒུལ་མེད་དུ་གྱུར་བའི་དཔྱད་སྡོམ་འདི་དག་ལ་བསྐྱར་དུ་སྡོམ་ཚིག་འགོད་པའི་ངལ་བ་ནི་ལས་སླ་བ་ཞིག་ཏུ་མི་འདུག་གོ།",
    "ཅེས་པའི་ཡི་གེའི་དག་ཆར་རྗེས་འཇུག་ད་དང་ས་བྱས་པ་གང་རུང་དུ་སྣང་བར་ད་ཕན་ངེས་པ་རྙེད་པའི་ཚིག་འགྲེལ་ཞིག་མི་འདུག་པ་སྐབས་འདིར་དཔྱད་གཞིའི་ཆེད་དུ་ཚིག་འགྲེལ་ཙམ་ཞུ་ན།",
    "འདིར་ཡང་མཁོ་དང་མཁོས་ཞེས་འདུག་པས་ཕལ་ཆེར་གདགས་གཞི་གཅིག་པར་འདོདགདགས་གཞི།",
    "ཞུགས་ལོང་དམར་བོ་བརྩིས་པ་སོགས་མང་རབ་ཅིག་འདུག་པར་བལྟས་ན།",
    "དེ་དང་ཚན་བཅུ་དྲུག་པོ་ཕན་ཚུན་བལྟོས་གྲུབ་ཏུ་འདུག་ཚིག་དོན་རིག་པའི་ཐད་ནས་དཔྱད་ན།",
    "ཞེས་དམག་དོན་གྱི་ཆེད་ཡིན་པ་གསལ་བོར་བཀོད་འདུག་པས།",
    "གཡོན་ཚན་དང་བོ་ནས་གཡོན་ཚན་བཅུ་བའི་བར་སོགས་ཚན་གྱི་མིང་བཏགས་འདུག་པས།",
    "རུ་ཞ་འི་འདུན་ཙ་ནས་བཀྱེའི་ཕྱག་རྒྱུ་ཕོག་སྟེ།",
    "ཞེས་པ་གཡར་པའི་ཚིག་ཡིན་པར་མི་བསྒྲུབ་ཀ་མེད་བྱུང་ཞེས་ཚར་ནི་ངེས་པར་རྒྱུའི་མིང་ཞིག་གཡར་བ་ཡིན་དགོས་རྒྱུ་འདྲ་ཞིག་བརྗོད་འདུག་རུང་།",
    "དཔོན་གནས་འདི་ཡོད་ཚེ་བདེ་བློན་གྱི་ཁམས་ཆེན་པོ་འདི་ཡང་རང་བཞིན་གྱིས་ཡོད་ངེས།",
    "དེར་བདེ་བློན་ཡོད་པའང་ཁས་བླངས་འདུག་པས།",
    "འ་ཞ་ཙོང་ཁའི་མཚོ་སྔོན་ཡན་ཆད་དུ་བྲོས་ཞེས་འ་ཞ་མཚོ་སྔོན་པོའི་བྱང་ཕྱོགས་སུ་གཞོལ་བ་ཙོང་ཁའི་མཚོ་སྔོན་ཞེས་མཚོ་སྔོན་པོའང་ཙོང་ཁའི་ཁམས་སུ་བགྲངས་འདུག་པར་བལྟས་ན།",
    "བལས་ཧུཾ་ཞེས་བློན་སྐྱེས་བཟང་རྒྱལ་ཀོང་ནི་བློན་ཆེའི་འོག་དཔོན་ཡིན་པ་ལ་འདུན་མ་བསྡུས་འདུག་རྐྱེན།",
    "ཞེས་བདེ་བློན་གྱི་འདུན་ས་བྱ་བ་ཞིག་ཀྱང་ཡོད་པའི་ཚུལ་བཀོད་འདུགའདིར་བརྗོད་པའི་འདུན་ས་ཞེས་པ་ནི་འདུན་མ་བསྡུ་པའི་ཡུལ་དངོས་དང་གྲོས་ཚོགས་དངོས་ལ་གོ་བ་ཡིན།",
    "ཞེས་ཙོང་ཁའི་ཡུལ་དུའང་ཁྲོམ་ཆེན་པོའི་འདུན་ས་ཞིག་བསྡུས་པའི་ཚུལ་བཀོད་འདུག་ཅིང་།",
    "དུ་ཞ་འི་འདུན་ཙ་ནས་བཀྱེའི་ཕྱག་རྒྱ་ཕོག་སྟེ།",
    "མནའ་བཅས་གཅིག་ཏུ་བསྡུས་ནས་བརྗོད་ཚུལ་ཡང་འདུག་གང་ལྟར་ཀྱང་མནའ་ཡི་བྱུང་བ་ནི་བོད་ཀྱི་གདོད་མའི་ཡུལ་སྲོལ་གོམས་གཤིས་ལས་དར་ཏེ་འོངས་པ་ཞིག་ཡིན་ལ།",
    "ཆབ་སྲིད་ཀྱི་ལམ་ལུགས་ཤུགས་ཆེ་བ་ཅན་དུ་གྱུར་འདུག་པ་དེའོ།",
    "ཉེ་མཚེས་རྒྱལ་ཁབ་གཞན་གྱི་དཔོན་གནས་ལམ་ལུགས་ཀྱིས་ཤན་ཐེབས་པའི་འོག་དུས་རབས་བརྒྱད་པ་དང་དགུ་བའི་དུས་སུ་ཐོན་པ་ན་བོད་བཙན་པོའི་རྒྱལ་རབས་ལ་དཔོན་གནས་ལམ་ལུགས་རྒྱས་པོ་ཞིག་བྱུང་།",
    "ཞེས་གསལ་བོར་བཀོད་འདུག་པས།",
    "ཕྱི་དང་བཙན་པོ་ཞེས་གསལ་ཁ་བཏོད་ནས་བརྗོད་འདུག་པས།",
    "དེའི་རྒྱལ་སྲིད་གཅེན་ཉ་ཁྱིས་མཛད་མེད་པར་གཅུང་ཤ་ཁྱིས་མཛད་པ་ཡིན་འདུག་པས།",
    "ཡང་ལ་ཤེས་ནི་ཁྲི་ལ་གསོལ་རྗེས་བཙན་པོའི་མིང་དངོས་སུ་གསོལ་བ་སོགས་ཀྱི་སྣང་ཚུལ་འདུག་དཔེར་ན་རྒྱལ་གཙུག་རུ་ལྟ་བུ་ནི་གཅེས་མིང་ལྟ་བུ་ཡིན་པ་དང་།",
    "གནམ་གྱི་ཁྲི་བདུན་གྱིས་སྲས་ཀྱིས་ཆིབས་ཁ་ཐུབ་ཙ་ན་རྨུ་ཐག་ལ་འཇུས་ནས་ནམ་མཁར་གཤེགས་ཚུལ་བརྗོད་པ་ལས།",
    "བཞུགས་པ་ལས་ནོངས་ཞེས་སྲས་ལྷས་བོན་བྱ་བ་ཞིག་ཡོད་པར་འདུག་རུང་ཡབ་ཀྱི་སྔོན་དུ་འདས་པས།",
    "བློན་པོའི་སྐོར་བརྗོད་སྐབས་བློན་པོ་གཉིས་གཉིས་བྱས་ནས་བརྗོད་འདུག་ཅིང་།",
    "དེ་ལ་དེང་སྐབས་ཞིབ་འཇུག་ལས་རིགས་སྟེང་དུའང་ཧ་ལམ་གཅིག་གྱུར་ཏུ་གྲུབ་པའི་ལྟ་བར་ཆགས་འདུག་ཅིང་།",
    "ཞེས་བཙན་པོ་ཁྲི་སྲོང་བཙན་གྱི་ཡབ་གནམ་རི་སྲོང་བཙན་རིང་དགུང་བློན་ནམ་གུང་བློན་བཙལ་བའི་སྐོར་འཁོད་འདུག་པས།",
    "བློན་ཆེན་པོ་དང་ཆབ་སྲིད་ཀྱི་བློན་པོ་བཀའ་ཆེན་པོ་ལ་གཏོགས་པའི་བློན་མིང་ནི་གསུམ་གྱིས་མི་ཚད་པར་བགྲངས་འདུག་ཅིང་།",
    "དེ་ལྷ་སའི་གཙུག་ལག་ཁང་མདུན་གྱི་དབོན་ཞང་འདུམ་པའི་རྡོ་རིང་སྟེང་དུ་ཞེས་ཕབ་སྒྱུར་བྱས་འདུག་པར་གསུངས།",
    "ང་རང་དེ་ལ་དོགས་པ་ཟ་འོང་།",
    "དབོན་ཞང་འདུམ་པའི་རྡོ་རིང་དུ་བོད་ལ་བློན་ཆེན་ཆ་དགུ་འདུག་ཅིང་།",
    "དོན་མེད་ཀྱི་དཔྱད་པ་འདི་རིགས་གཏོང་དགོས་དོན་མི་འདུག་གོ།",
    "བོད་བཙན་པོའི་རྒྱལ་རབས་དུས་སུ་ནི་བཙན་པོ་གདུང་རབས་བཅུ་བདུན་པ་ལྡེ་པྲ་བོ་གནམ་གཞུང་ཅན་གྱི་རིང་ལ་བྱུང་འདུག་པ་ལས་བཙན་པོ་ལྡེ་པུ་བོ་གནམ་གཞུང་ཅན་གྱི་རིང་སླན་ཆད།",
    "དབོན་ཞང་འདུམ་པའི་རྡོ་རིང་ལས་ཀྱང་ཅོག་རོ་བློན་བཙན་བཞེར་ལྟོ་གོང་ཞེས་ཞིང་དང་མིང་མཚམས་སྦྱར་མི་འདུག་པར་མ་ཟད།",
    "གུང་བློན་ཆེན་པོ་དཔོན་དམག་ཆབ་སྲིད་ཀྱི་བློན་པོ་ཆེན་པོ་བཅས་རིགས་ལྔ་འདུག་ཅིང་།",
    "ཁོང་ཆབ་སྲིད་ཀྱི་ལས་ལ་ཞུགས་འདོད་མེད་པའི་ཚུལ་ཙམ་ཡང་མངོན་འདུག་སྙམ།",
    "ཕྱི་བློན་དུ་གཏོགས་པའི་བློན་པོ་བཅུ་གསུམ་གྱི་མིང་བགྲངས་འདུག་ལ།",
    "ཐ་ན་སྤྱན་གྱིས་མཆིད་ཀྱིས་བཅད་པའི་བཀའ་རྒྱུ་དེ་རྩེ་རྗེ་དང་ཞང་བློན་ལྟ་བུས་ཀྱང་ལག་ལེན་དུ་བསྟར་དགོས་པར་འདུག་པས།",
    "ཞེས་ཉེ་མཚེས་རྒྱལ་ཁབ་འཇང་ལྟ་བུར་ཡང་སྤྱན་ཞེས་པའི་དཔོན་གནས་ཡོད་པ་བསྟན་འདུག་ལ།",
    "བཞེར་ནི་བརྩི་བཀུར་དང་སྒར་གྲ་སྒྲིག་པར་འཇུག་པའི་སྐབས་ཡོད་བོད་བཙན་པོའི་རྒྱལ་རབས་ཀྱི་ཆབ་སྲིད་ལམ་ལུགས་ཞིབ་འཇུགཡམས་ཡཔར་འདུག་པས།",
    "ནུབ་ལྗོངས་ནས་ཐོན་པའི་ཁྲམ་ཤིང་སོགས་སུ་རྩེ་རྗེ་དང་འབྲེལ་བའི་སྐོར་གྱི་གནས་ཚུལ་འདུག་ཅིང་།",
    "ཀུ་ཅུའི་ནི་དེའི་རིམ་པ་གོང་མའི་འགོ་བ་ཡིན་འདུག་ཅེས་བརྗོད།",
    "རྩེ་རྗེའམ་རྩེ་རྗེ་བློན་ཆེན་པོར་ཐབས་ར་གན་གྱི་ཡི་གེ་ཡོད་པར་འཁོད་འདུག་པས།",
    "ནུབ་ལྗོངས་ཀྱི་ཁྲམ་ཡིག་ཨང་པ་ལས་ལས་ཀྱི་ཐབ་ས་ན་རྩེ་རྗེ་འོག་དཔོན་དུ་ལསྩལད་དེ་ཡི་གེ་ཟངས་འཚལད་ཅེས་རྩེ་རྗེ་འོག་དཔོན་ལ་ཟངས་ཀྱི་ཡི་གེ་བསྩལ་བའི་གནས་ཚུལ་ཞིག་འཁོད་འདུག་པས་ཀྱང་།",
    "རུས་རྒྱུད་ཆེ་ཁག་ལ་བལྟོས་པ་ཞིག་ཀྱང་ཡིན་པའི་སྐོར་འཁོད་འདུག་རྐྱེན།",
    "སྟོང་བུ་རྗེ་ཞེས་པའི་བུ་ཡིག་ལས་ཀྱང་དཔོན་གནས་འདི་སྟོང་ཆུང་ལས་ཆུང་བ་གསལ་དུ་བསྟན་འདུག་གོ།",
    "དེའི་འགྲོ་འདུག་ལ་ཆ་རྐྱེན་མེད་པའི་སྒོ་ནས་སྟབས་བདེ་བཟོ་དགོས།",
    "དབོན་ཞང་འདུམ་པའི་རྡོ་རིང་གཉིས་སུ་སྣམ་ཕྱི་པའི་དཔོན་སྣའི་མིང་བཀོད་འདུག་པར་བལྟས་ན།",
    "བསྡད་པའི་ཚུལ་འཁོད་འདུག་ཁྱུང་པོ་སྤུང་སད་ཀྱི་ཚིག་ལ་དཔྱད་ན།",
    "དུ་རིགས་བཤེས་ཀྱི་ཡི་གེ་པ་ཞེས་ཐོན་པ་ནི་གསང་བའི་དོན་ནམ་གསང་བའི་བཀའ་རྒྱུ་ཡི་གེར་འགོད་མཁན་དྲུང་ཡིག་ཡིན་པའི་དོགས་འཆར་འདུག་སྟེ།",
    "སྐུ་གཤེན་གྱི་གོ་གནས་ཀྱང་སྔར་ལས་ཇེ་དམར་གྱུར་ཡོད་ངེས་ཀྱང་རང་འཇགས་བཞག་པར་མངོན།",
    "གོང་འོག་འགལ་བར་གྱུར་འདུག་པས།",
    "བལྟས་ན་གོ་བ་ལོན་དཀའ་བའི་ཚོད་དུ་འདུག་ལ།",
    "འདི་ལས་གཉེར་བའི་འགན་ནུས་ཀྱང་བསྟན་འདུག་སྟེ།",
    "ཟངས་ཀྱི་ཡི་གེ་བ་བཅས་རིགས་དྲུག་བགྲངས་འདུག་པ་དང་།",
    "ར་གོན་དང་འཁར་བ་གཉིས་ཡིག་ཚང་གཅིག་ལ་གོ་བར་འདུག་ཅིང་།",
    "ཡང་ཡབ་འབངས་རུས་དྲུག་ལ་སྔ་མས་འཁར་བའི་ཡི་གེ་དང་ཕྱི་མས་ར་གན་གྱི་ཡི་གེ་བཞག་འདུག་ལ།",
    "སྣ་བློན་བཀའ་ལ་གཏོགས་པ་བཅས་གྲལ་ཐབས་འདི་ལྟར་བཀོད་འདུག་འདི་དག་ཕན་ཚུན་དབྱེ་ཞིབ་བགྱིས་ཚེ།"
