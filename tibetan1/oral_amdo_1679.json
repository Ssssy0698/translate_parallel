    "སྟངས་ཐོག་ནས་རན་མ་རན་ཕྲན་བུ་ཕྲན་བུ་ཡོང་གི་ཡོད་པ་འདི་ཚོར་གཟབ་གཟབ་བྱེད།",
    "མཐུན་པོ་བྱ་རྒྱུ་ཧ་ཅང་གལ་ཆེན་པོ་རེད་ཅེས་བཀའ་སྩལ་ཏོ།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གིས་དབུ་ཁྲིད་ལམ་སྟོན་གནང་བ་ལྟར།",
    "མི་མང་སྤྱི་བྱིངས་ནས་ཀྱང་ཇི་བཞིན་བློ་མོས་མ་བྱས་པ་བཅས་ལས་སླར་ཡང་བསྒྱུར་བཅོས་གཏོང་དགོས་གྱུར་ཏེ།",
    "དོན་མེད་རྙོག་གྲ་ཆེད་བཟོ་བྱས་པ་ལྟ་བུ་ཆགས་ན་རང་ཉིད་རང་ལ་དྲིན་ཆུང་དུ་གྱུར་པ་རེད།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ནས་སྐབས་རེ་རེའི་སྤྱི་འཐུས་ཀྱི་ལོ་ཡུན་རིང་དུ་གཏོང་འོས་མཆིས་མིན་སོགས་གང་ཅིའི་ཐོག་དགོངས་བཞེད་གནང་བཞིན་དུ་བར་མཚམས་ཀྱི་དུས་རིམ་དུ་འཇོག་པར་མཛད།",
    "དུས་ངན་རྒུད་པའི་སྨག་གིས་ཁྱབ་འདིར་གཟིགས།",
    "ཞེན་ཅིང་གུས་པའི་རེ་ཐག་མི་ལྷོད་པའི།",
    "རྒུད་པའི་མཚན་མོ་ཐུན་གྱི་ཐ་མར་སོན།",
    "རྟེན་གཞི་གསར་པར་ལྷ་ཞལ་མྱུར་དུ་གཟིགས་པའི་སྨོན་ཚིག་འཕྲིན་བསྐུལ་གནས་ཆུང་གྲྭ་ཚང་གིས་ཚོགས་འདོན་བྱས་ཆོག་པ་ཞིག་དགོས་ཞེས་བཀའ་ཤག་དང་།",
    "དངོས་དོན་གསལ་པོ་རང་བྱུང་མེད་པ་ལྟ་བུར་གནས་ཡོད་སྟབས་སྔར་གྱི་བཀའ་མོལ་མཇུག་སྐྱོང་གིས་གསལ་དུ་བཟོ་འོས་ཆེ་མིན་སྐོར་ལ།",
    "རྒྱ་ཕྱོགས་ནས་རང་རེའི་དམའ་མཐའི་དགོས་འདུན་ལའང་དོན་ཕན་འབྱུང་རེ་མེད་སྟབས་ཁོང་ཚོས་ཚིག་རྩ་གཟུང་རྒྱུ་ཙམ་ལས་ཕན་ཐོགས་ཡོང་རེ་མེད་པར་མོས་མཉམ།",
    "༨༤ ལོ་ཙམ་ལ་བོད་ནང་གཟིགས་སྐོར་སྐུ་ཚབ་ཁག་ཅིག་གཏོང་ཐབས་བྱ་རྒྱུ་དང་།",
    "གོང་ས་མཆོག་བོད་དུ་ཕེབས་གནང་འཆར་གསུངས་ཟིན་པའི་སྐོར་ཡང་བཀའ་མོལ་ཞིག་བྱུང་ན་ལེགས་གནས་མོས་མཉམ།",
    "ད་ལྟའི་ཆར་ང་ཚོར་བློ་གདེངས་འཁེལ་བ་ཅི་ཡང་མེད་གནས་ལ་བརྟེན་མཁྲེགས་སུ་མ་གཏོང་ན་ཞེས་མོས་མཉམ།",
    "གོང་ས་མཆོག་བོད་ནང་གཟིགས་སྐོར་ཆིབས་བསྒྱུར་གནང་རྒྱའི་ཆ་རྐྱེན་ཚང་དཀའ་བའི་རང་བཞིན་ཞིག་ཡོད་པ་ཡིན་པས་གལ་སྲིད་ཕེབས་མ་ཐུབ་པ་ཆགས་ན་མཛད་ཕྱོགས་ཇི་འོས་སྐོར།",
    "གོང་གི་གནས་ཚུལ་རྣམས་གོང་ས་ཆེན་པོ་མཆོག་ལ་སྙན་སེང་ཞུས་པར།",
    "ཕན་ཚུན་འབྲེལ་བ་མ་ཆད་པ་བྱ་རྒྱུ་གལ་ཆེར་བརྟེན་བོད་ནང་ལྟ་སྐོར་ཚོ་ཁག་ཅིག་གཏོང་ཐུབ་ན་ཡག་པོ་རེད་ཅེས་སོགས་བཀའ་སློབ་ཕེབས།",
    "བྱེད་མིན་འབྲེལ་མོལ་གནང་ལུགས་དགོས་པའི་བཀོད་མངགས་གནང་།",
    "འབྲེལ་བ་བྱུང་ནས་མི་ལོ་ལྔ་སོང་རིང་བོད་ནང་འགྱུར་བ་ཇི་ལྟར་ཕྱིན་པ་བལྟ་ཆེད།",
    "ལྷག་པར་༨༥ ལོར་གོང་ས་མཆོག་བོད་ནང་འཚམས་འདྲིར་ཕེབས་འཆར་ཡོད་པའི་ཆ་རྐྱེན་ཉམས་ཞིབ་བྱེད་པའི་ཆེད་བཅས་སུ་ཡིན་ལུགས་བརྗོད་པ་རེད།",
    "གཞུང་ཚབ་ཁང་གི་ལྕགས་རིའི་སྒོ་ཆེན་ནས་རླངས་འཁོར་ཤར་བསྐྱོད་བྱས།",
    "སྒོ་འཆོར་འོག་ཏུ་རླངས་འཁོར་སྣེ་ལེན་གྱིས་རླངས་འཁོར་སྒོ་ཕྱེ་མཁན་མི་གཉིས་འདུག་ཤར་བསྐྱོད་ཀྱིས་གཞུང་ཚབ་ངོ་མ་མཇལ་འཕྲད་ཁང་གི་སྒོ་རྩ་དེ་རང་དུ་འདུག་སྣེ་ལེན་གྱིས་མཉམ་དུ་བསྐྱོད་དེ་མཇལ་འཕྲད་ཁང་དུ་གྲལ་ལ་འཁོད།",
    "འཚམས་འདྲི་ཞུ་རེས་བྱས།",
    "ཀྲུང་དབྱང་གིས་བཀའ་ལན་འབྱོར་གསལ་དུ་སྐུ་ཚབ་ཏུ་མི་བདུན་ནས་བཅུ་བར་གང་རུང་ཞིག་ཕྱི་ཟླ་༥ པའི་ཚེས་ཤར་རྗེས་ག་དུས་ཕེབས་ཀྱང་འགྲིགས།",
    "དེ་སྔོན་སྐུ་ཚབ་ཐེངས་ཁ་ཤས་ཕྱིན་ཡོད་ཀྱང་འགའ་རེས་ཡག་པོ་བྱུང་མེད།",
    "སྐུ་ཚབ་བཞི་པས་ཧོང་ཀོང་ནས་པེ་ཅིང་ཉེ་སྐོར་ལ་ཕེབས་ནས་གཟིགས་རྒྱུ་ལས།",
    "མ་ཕེབས་ན་འགྲིགས་ཀྱི་རེད་ཞུ་རྒྱུ་ཡིན་ཞེས་གསུངས།",
    "ཀྲུང་དབྱང་ནས་དེ་ལྟར་གསུང་གི་ཡོད་ན་ང་ཚོས་བསམ་བློ་གཏོང་དགོས་པ་རེད།",
    "ལོ་ལྔའི་དུས་ཡུན་རིང་བོད་ནང་ལ་འགྱུར་བ་དངོས་ཇི་ལྟར་བྱུང་མིན་༡༩༨༥ ལོར་གོང་ས་མཆོག་བོད་ནང་འཚམས་འདྲིར་ཕེབས་འཆར་ཡོད་པར་ཆ་རྐྱེན་སྒྲིག་ཕྱོགས་བཅས་ཀྱི་ཆེད་ལྟ་སྐོར་བཞི་པ་ཞིག་གཏོང་ཐུབ་ན་ཡག་ཏུ་འགྲོ་རེ་བྱས་པ་ཡིན།",
    "ང་ཚོས་མུ་མཐུད་འབྲེལ་ལམ་བྱ་རྒྱུར་གལ་ཆེ་བརྩི་བཞིན་ཡོད་ཅེས་བརྗོད་པར།",
    "གཞུང་ཚབ་ཆེན་མོའི་སྒོ་རྩར་བོད་མི་ཚོས་ངོ་རྒོལ་སྐད་འབོད་བྱེད་ཀྱི་ཡོད།",
    "བློ་བཟང་སྦྱིན་པ་ཁོ་རང་ངོ་མ་ཡོང་སྟེ་གཞུང་ཚབ་ཆེན་མོའི་སྒོ་རྩར་ངོ་རྒོལ་སྐད་འབོད་བྱེད་ཀྱི་འདུག་བློ་བཟང་སྦྱིན་པ་བོད་ལ་ལྟ་སྐོར་སྐུ་ཚབ་ཏུ་ཕེབས་པ་རེད།",
    "དེ་འདྲའི་གནས་ཚུལ་མ་རེད།",
    "ཁོང་ཉིད་ཁོང་ཁྲོ་ཅུང་ལྷོད་དུ་སོང་སྟེ།",
    "བོད་ནང་ལ་ཡར་རྒྱས་མགྱོགས་པོ་ཡོང་གི་རེད།",
    "ཁྱེད་རང་རྣམ་པས་གཟིགས་ན་འགྲིགས་ཀྱི་རེད།",
    "ཀྲུང་གོའི་རྒྱལ་ཁབ་ཀྱི་སྲིད་བྱུས་ཡག་ཏུ་འགྲོ་ཡི་རེད།",
    "ཀྲུང་དབྱང་དང་འབྲེལ་བ་བྱས་ན་ཡག་པོ་རེད།",
    "ཀྲུང་དབྱང་གི་བཀའ་གང་གནང་བ་དེ་ངས་ཞུ་གི་ཡོད་ཅེས་གསུངས།",
    "ཕན་ཚུན་འགྲེལ་མོལ་བྱ་རེས་ཀྱི་དུས་ཡུན་ཆུ་ཚོད་༢ ལྷག་ཙམ་ཕྱིན་སོང་བར་བཀའ་མོལ་མཇུག་བསྡུས་ཤིང་མུ་མཐུད་འབྲེལ་མོལ་བྱ་རྒྱུར་བཞག་སྟེ་ཡོང་བར།",
    "གཞུང་ཚབ་ཁོང་ཉིད་མཇལ་འཕྲད་ཁང་གི་ཕྱི་སྒོར་ཕེབས་སྐྱེལ་དུ་བྱུང་།",
    "དེ་ནས་ཕྱིར་ལོག་གིས་ཕྱི་ཉིན་ལྡི་ལི་ནས་ཕྲན་བཀའ་བློན་གཉིས་ཀ་བཞུགས་སྒར་དུ་འབྱོར།",
    "ང་ཚོ་བོད་ལ་ལྟ་སྐོར་འགྲོ་དགོས་པ་བོད་དུ་གཏོང་གི་མེད་ཚེ།",
    "དེ་རང་ལ་ཆ་བཞག་སྟེ་ཐག་གཅོད་རྒྱུ་ལས་མེད་པ་མ་རེད་དམ་ཞེས་ཕེབས་པར།",
    "འབྲེལ་བ་མ་ཆད་ཙམ་གནང་རྒྱུ་གལ་ཆེར་བརྩིས་ཏེ་ཀྲུང་དབྱང་གི་བཀའ་དེ་ལྟར་གནང་གི་ཡོད་ན་ང་ཚོས་བསམ་བློ་གཏོང་དགོས་པ་རེད་ཅེས་ཐག་མ་བཅད་པར་ནར་ཆ་ཞིག་སྟོན་པ་ཡིན་ལུགས་ཞུས།",
    "བསམ་ཚུལ་ཞུ་མོལ་བགྱིས་མཐར་སྐུ་ཚབ་གཏོང་འོས་ཆེ་མིན་སྐོར་གོ་བསྡུར་ཞིབ་གནས་བྱ་སྒོ་བཀའ་ཕེབས།",
    "ཟླ་༣ ཚེས་༦ ཉིན་ལྡི་ལིར་རྒྱ་དམར་གཞུང་ཚབ་དང་འབྲེལ་མོལ་བྱུང་གནས་དང་།",
    "གཏོང་ན་ངོ་བོ་ཇི་འདྲ་ཞིག་གི་ཐོག་ནས་གཏོང་བ་དང་།",
    "དགོངས་ཚུལ་ཐུགས་རེ་འདྲ་མིན་ཡོད་པར་བཀའ་མོལ་ཞིབ་ལྷུག་མང་དག་ཅིག་གནང་བའི་མཐར་མཛད་ཕྱོགས་དགོངས་མཉམ་བྱུང་བ་ནི།",
    "རྒྱ་ནག་ཏུ་གཏོང་བློ་མོས་མེད་བཞིན་དུ་སྐུ་ཚབ་ཚོགས་པ་ཞིག་རྒྱ་ནག་པེ་ཅིང་དུ་གཏོང་རྒྱུར་མོས་མཉམ་གནང་བ་རེད།",
    "༡༩༨༢ ལོར་འབྲེལ་མཐུད་སྐུ་ཚབ་ཚོགས་པས་བཀའ་མོལ་བྱུང་བ་དེ་ཐོག་ད་མུས་སུ་བཞག་ན་ལེགས་པ་ལས་གསལ་དུ་གཏོང་པས་ང་ཚོར་ལམ་སེང་ཕན་ཐོགས་དོན་འཁེལ་ཡོང་རེ་གཏན་ནས་མེད་ངེས་མཐོང་བས་དེ་མུར་འཇོག་ལེགས་དང་།",
    "བར་ལམ་བོད་ནང་གི་གནས་ཚུལ་རྣམས་ཀྱི་སྐོར་གསེས་བཀྲོལ་གང་ཐུབ་དང་།",
    "གོང་ས་མཆོག་གིས་རྒྱ་བོད་ཕན་ཚུན་གཅིག་ཕན་གཅིག་གྲོགས་སུ་གནས་ཐབས་དགོངས་བཞེད་ཡོད་གནས་དང་།",
    "བོད་མི་མང་གི་བདེ་སྐྱིད་འདོད་བློ་ཁེངས་མིན་ལ་ཐུག་པའི་སྐོར་གང་གསལ་བརྗོད་ཐུབ་པ་དགོས་གལ།",
    "མང་ཚོགས་སུར་ཡང་མཇལ་འཕྲད་ཀྱི་གོ་སྐབས་ཡོད་དགོས་པ།",
    "སྐུ་ཕྱྭའི་ཉེན་སྲུང་གི་འགན་ལེན་ཆ་ཚང་རྒྱ་གཞུང་ནས་རང་བྱེད་དགོས་པ།",
    "གོང་ས་མཆོག་གི་མདུན་དུ་ཆེད་བཅར་གྱིས་རྗེ་བློན་ལྷན་ཚོགས་ཞིབ་རྒྱས་གནང་བར།",
    "དོན་དངོས་བྱས་ན་རྒྱལ་ཁབ་ཅིག་དགོས་ཟེར་བ་དེ་རེད།",
    "ཤོད་ཚུལ་དེར་འགྱུར་ལྡོག་གཏོང་དགོས་པ་རེད་མ་གཏོགས་ཐུན་མོང་གིབཀའ་མོལ་གནང་རྒྱུ་ཡོད་པ་མ་རེད་ཅེས་དང་།",
    "གསལ་པོ་བཟོ་དང་མི་བཟོ་བཀའ་བསྡུར་གནང་རྒྱུ་དེ་རེད།",
    "གོང་ས་མཆོག་གི་དགོངས་བཞེད་དུ་དོན་དངོས་གསལ་པོ་བཟོ་མ་ཐུབ་ན་མི་འགྲིགས་པ་ཞིག་གཟིགས་ཀྱི་ཡོད་ནའང་།",
    "ནང་དུ་རྡོག་གྲ་འགྲིགས་ན་དགའ་ཟེར་བ་ལྟ་བུར་དགོངས་ནས་མོས་བསྡུར་ཞིབ་ཕྲ་གནང་གི་ཡོད་པ་རེད།",
    "ཕྲན་རང་གི་བསམ་ཚུལ་དུ་བྱས་ན་ཡང་།",
    "བློ་གསོན་པོ་བཀལ་ན་གསོན་པོ་ཟེར་བ་ལྟ་བུ་ཕྱོགས་ནས་ཐག་གཅོད་གསལ་པོ་ཞིག་ཡོད་ན་གསལ་པོ་བཟོ་རྒྱུ་གལ་ཆེན་པོ་རེད།",
    "འབྲེལ་མོལ་བགྱིས་པར་ངོས་ལེན་གྱིས་ཕེབས་མཁན་གྱི་མིང་ཐོ་དགོས་ལུགས་བརྗོད་པ་ལྟར།",
    "གཏོང་འཆར་བཅས་སྔ་ཕྱིའི་བཀའ་མོལ་གནང་བའི་ཚིག་ཐོ་དང་།",
    "དྲིལ་བསྒྲགས་དྲུང་ཆེ་ལས་འཕར་བཅས་ལྷན་འཛོམས་ཀྱིས་རྒྱ་ནག་པེ་ཅིང་དུ་སྐུ་ཚབ་མི་གསུམ་གཏོང་རྒྱུར་གཏན་འཁེལ་བྱུང་བ་རྣམས་ཀྱིས་རྒྱ་མི་དང་བཀའ་མོལ་གནང་ཕྱོགས་དང་།",
    "བཀའ་མོལ་གནང་སྒོའི་ཐད།",
    "ལམ་གནས་ཐབས་ཀྱི་སྲིད་བྱུས་འཛིན་ནས་བཀའ་མོལ་གནང་རྒྱུ།",
    "བཀའ་མོལ་གནང་ཕྱོགས་ཐད།",
    "གོང་ས་མཆོག་ནས་རྒྱ་ནག་གི་དཔོན་རིགས་ཚོར་འཚམས་འདྲི་དང་།",
    "རྒྱལ་ཡུམ་ཆེན་མོའི་ཞབས་འཇུག་ཆེད་བོད་ནང་མཆོད་འབུལ་ཞུ་མཁན་བསྐྱོད་འཐུས་ཞུས་ཀྱང་མོས་མཐུན་གནང་མེད།",
    "དེ་མཚུངས་གཟིགས་སྐོར་སྐུ་ཚབ་ཐེངས་བཞི་པ་ཞིག་གཏོང་རྒྱུར་ཕན་ཚུན་གཉིས་ཀས་ཐག་གཅོད་ཟིན་ནའང་།",
    "རྒྱ་ཕྱོགས་ནས་འགྱུར་ལྡོག་གིས་ཕྱིས་འགྱངས་གྱུར་པ་དང་།",
    "དེ་རྗེས་ང་ཚོས་བསྐྱར་བསྐུལ་ཐེངས་གཉིས་བྱས་ཀྱང་འགྲོ་ཐུབ་པ་བྱུང་མེད།",
    "དེ་ཚོ་ང་ཚོའི་ངོས་ནས་ཕན་ཚུན་འབྲེལ་བ་ཡག་པོ་དང་།",
    "༡༩༨༢ ལོར་ང་ཚོས་ཐོག་མར་ཏིང་དང་།",
    "ལི་གཉིས་ཀྱིས་གསུང་པ་གཞི་བཞག་གིས་ཕན་ཚུན་ཁ་བྲལ་མི་འགྲོ་བའི་ཆེད་དུ་བརྗོད་པ་ཞིག་ཡིན།",
    "དེ་ནི་དོན་དངོས་ཐོག་རྒྱལ་ཁབ་གཅིག་བཟོ་དགོས་ཟེར་བ་དེ་རེད།",
    "ཐུན་མོང་གི་སྐད་ཆ་ཡོད་པ་མ་རེད་ཅེས་གསུངས་པ་རེད།",
    "འོན་ཀྱང་ང་ཚོའི་ཕྱོགས་ནས་འགྱུར་བ་གཏོང་དགོས་བསམ་པ་མེད།",
    "ཏཱ་ལའི་སྐ་སྒེར་གྱི་ཐོག་ནས་བཀའ་མོལ་གནང་གི་ཡོད།",
    "ང་ཚོའི་ངོས་ནས་དངོས་ཡོད་གནས་ཚུལ་ལ་ཆ་བཞག་གི་ཡོད།",
    "རེ་འདུན་ག་ཚོད་ཞུ་ཡི་ཡོད་མེད་ནི།",
    "ཁྱེད་རང་རྣམ་པས་མཁྱེན་གསལ་རེད།",
    "བོད་མི་ས་ཡ་དྲུག་ཟུར་དུ་བསྡད་པ་ལས་མི་འབོར་དུང་ཕྱུར་བཅུའི་མཉམ་དུ་བསྡད་ན་ཡག་པ་ཡོང་མི་ཆོག་པ་མེད་གསུང་གི་ཡོད།",
    "བོད་མི་མང་གི་བདེ་སྐྱིད་ལ་ཐུག་ཡོད་པ་དངོས་དོན་རང་རེད་ཅེས་བརྗོད་རྒྱུ།",
    "བོད་མི་མང་གི་རེ་འདུན་དང་།",
    "གཟིགས་སྐོར་ཞིག་ཕེབས་ནས་ཕྱིར་ལོག་ཕེབས་ནའང་དགའ་བསུ་ཡོད་གསུང་བཞིན་པ་རེད།",
    "༡༩༨༥ ལོར་ཆ་རྐྱེན་ཚང་ན་གཟིགས་སྐོར་དུ་ཆིབས་བསྒྱུར་གནང་བཞེད་ཡོང་པ་རེད།",
    "དེས་ཀྱང་མ་ཚད་པར་བལ་བོད་ས་མཚམས་ནས་ཀྱང་གོང་ས་མཆོག་གི་སྐུ་པར་ཁུར་མཁན་ཚང་མ་ས་ནས་འཕྲོག་ལེན་གྱིས་དོ་པོ་ལངས་པ་གསང་སྤྱོད་ནང་བླུགས་ཡོད་པ་བོད་མི་མང་པོས་མཐོང་བ་དང་།",
    "ཡང་སྐབས་རེར་ལྷ་ས་བའི་ནང་ཁྱིམ་བསྔོགས་བཤེར་གྱིས་སྐུ་པར་ཐེངས་མང་པོར་འཕྲོག་ལེན་བྱས་འདུག་རྒྱ་ཕྱོགས་ནས་མཛད་སྟངས་དེ་རིགས་དང་།",
    "ཧ་ཅང་གི་དོགས་གནས་ཆེན་པོ་ཡོང་གི་ཡོད་པ་རེད།",
    "དེ་འདྲའི་འགྱུར་ལྡོག་གི་རྣམ་པ་ཆེན་པོ་ཐོན་དུས་སུ་ཡིན་ཡང་བློ་དོགས་ཀྱི་རང་བཞིན་ལས་ཡིད་བརྟན་མི་འཕེར་བ་བྱེད་ཀྱི་ཡོད་པ་རེད།",
    "ཕྱི་རྒྱལ་ཡུལ་ཁག་ཏུ་ཡོད་པའི་རྒྱ་རིགས་ཁ་ཤས་ནས་ཀྱང་ད་ལྟའི་སྐབས་སུ་བོད་དུ་ཕེབས་པའི་དུས་ཚོད་མ་རེད་ཅེས་བརྗོད་མཁན་འདུག་པ་དང་།",
    "ཡང་རྒྱ་ཕྱོགས་ནས་ང་ཚོར་བར་ལམ་གྱི་སྐྱོན་བརྗོད་དྲིལ་བསྒྲགས་དང་།",
    "ད་ལྟའི་སྐབས་སུ་ཁྱེད་རང་རྣམ་པས་ང་ཚོས་ཁ་བྲལ་འགྲོ་བའི་ལས་འགུལ་བྱེད་ཀྱི་འདུག་པའི་གཟིགས་ཕྱོགས་གནང་གི་ཡོད་པ་རེད་དེ།",
    "ད་ཆ་གོང་ས་མཆོག་གི་བཀའ་དྲིན་ལས་སེར་སྐྱ་རྒན་གཞོན་ཚང་མ་གང་ཅིའི་ཐོག་འགྲིགས་ངེས་སུ་དེབ་བཅུ་གཅིག་པ།",
    "འོན་ཀྱང་ཚང་མས་རང་གི་ལུང་པ་དང་།",
    "རང་ཉིད་གི་དགོས་འདུན་བརྗོད་རྒྱུར་འགོག་དཀའ་བ་ཡོད་གནས་དང་།",
    "དོན་དུ་ཐག་ཆོད་ཡོང་རེ་མེད་སྟབས་ཞི་འཇམ་གང་ཆེའི་ཐོག་མུ་མཐུད་འབྲེལ་ལམ་གནས་ཐབས།",
    "རྩ་བའི་གོང་གི་སྲིད་བྱུས་དང་།",
    "༡༩༨༤ ཟླ་༨ ཚེས་༡༤ ཉིན་བཀའ་བློན་བཞི་སྙན་བཅར་གྱིས་སྤྱན་བསྟར་ཐོག་བསམ་ཚུལ་འགྲེལ་ཞུས་ཞིབ་གཟིགས་མཛད་པའི་སྐབས་སུ་དགེ་སྐྱོན་འཁྲི་སྣོན་གནང་སྒོ་གནང་ཐོག་ཟུར་དུ་བཀའ་ཕེབས་དོན།",
    "རྒྱ་མི་ཪྙིང་པ་ཚོས་ཀྲུང་གོ་ཧྭ་ཟེར་བ་རྒྱ་ནག་གི་སྐད་ལ་ངོས་འཛིན་བྱེད་ཀྱི་འདུག།",
    "དེའི་སྔོན་དུ་བོད་མི་ས་ཡ་དྲུག་གཅིག་སྒྲིལ་བྱེད་དགོས་ཀྱི་རེད།",
    "ཚང་མར་ཁྱབ་པའི་མིང་གསར་པ་ཞིག་བཟོས་ན་ཁག་ཁག་རེད།",
    "བོད་རྒྱ་ནག་གི་ཆ་ཤས་རྩ་བ་ནས་ཆགས་ཡོད་མ་རེད།",
    "མི་འབོར་ས་ཡ་སྟོང་ཕྲག་གཅིག་གི་མཉམ་དུ་བསྡད་ནས་ཁེ་ཕན་ཆེ་བ་ཡོང་གི་ཡོད་ན་འགྲིགས་ཀྱི་རེད་ཅེས་བརྗོད་ན་འགྲིགས།",
    "དེས་མ་ཚད་རྒྱལ་མཚམས་རིས་མེད་ཀྱི་སྐོར་ནས་གླེང་ནའང་ཡག་པོ་རེད།",
    "ཕྲུ་གུས་ཕ་མའི་མཉམ་དུ་བསྡད་འདོད་བྱེད་ཀྱི་རེད།",
    "ཕྲུ་གུ་ཡིན་ནའང་ཕ་མའི་མཉམ་དུ་བསྡད་འདོད་མི་བྱེད་པ་ཡོང་གི་རེད།",
    "ཁྱེད་ཚོས་པེ་ཅིང་དུ་སྐད་ཆ་ཤོད་སྐབས་ཀྲུང་དབྱང་ཞེས་བེད་སྤྱོད་བྱས་ན་འགྲིགས་ཀྱི་རེད།",
    "ཁོང་རང་ཚོ་རྒྱ་སྐད་ཀྱི་མིང་ཚིག་རེད།",
    "དེ་ལྟར་བྱུང་ན་འདི་སྐོར་ང་ཚོར་བོད་ནས་གྲངས་ཐོ་འབྱོར་བ་ཁག་ལ་ཞིབ་འཇུག་གིས་བཟོས་པ་ཡིན་གནས་དང་།",
    "ཁྱེད་ཚོས་ངེས་གཏན་མ་རྟོགས་ན་ཕན་ཚུན་ཐུན་མོང་ཐོག་ས་གནས་ས་ཐོག་སོ་སོར་ཞིབ་འཇུག་ཚོགས་ཆུང་ལྟ་བུ་ཞིག་ཆེད་འཛུགས་ཀྱིས་དངོས་བྱུང་ཇི་ཡིན་ཞིབ་རྩད་བྱས་ན་གསལ་པོ་མཁྱེན་རྟོགས་ཡོང་རྒྱུ་བཅས་བརྗོད་ན་ཞེས་ཕེབས་པ་བཅས་སྔ་ཕྱིར་བཀའ་བསྡུར་གོ་སྒྲིག་ཞིབ་ཕྲ་བྱུང་བ་རེད།",
    "གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གི་སྐུ་ཚབ་མི་གསུམ་པེ་ཅིང་དུ་ཆེད་བསྐྱོད་ཞུས་པ།",
    "སྤྱི་ནོར་གོང་ས་སྐྱབས་མགོན་ཆེན་པོ་མཆོག་གི་དགོངས་གཞི་དང་།",
    "སྲོག་ཉེས་སུ་སོང་བ་མི་གྲངས་༡༥ བཅས་ཀྱི་མིང་གཞུང་བཅས་གནང་སྟེ།",
    "ཁོང་ཚོའི་དྲུང་ཆེ་གཉིས་པ་དེས་ང་ཚོའི་ཕེབས་ཀྲོར་སྒོ་ཕྱེ་བ་དང་།",
    "ང་ཚོས་ཕར་ཡང་རྣམ་འགྱུར་གང་བཟང་ཐོན་པ་བྱས།",
    "གཏིང་ནས་དགའ་བའི་རྣམ་འགྱུར་ཡང་ཐོན་པ་བྱས་སོང་།",
    "ནས་མི་རིགས་མཐུན་འབྲེལ་ལ་ཤུགས་སྣོན་ཡོང་རེ་ཡོད་ཅེས་ཡང་ཡང་ཟེར།",
    "ཕྲན་ནས་ང་ཚོས་གོ་ཐོས་ལ་དེང་བོད་ནང་གཉེན་འཕྲད་བསྐྱོད་མུས་རྣམས་ལ་རྒྱ་གར་ལག་འཁྱེར་ལེན་དགོས་བརྗོད་པ་དེ་བོད་དུ་གཉེན་འཕྲད་བསྐྱོད་མི་ཐུབ་པའི་ཆེད་དུ་རྡ་རམ་ས་ལ་ནས་བཟོས་པ་རེད་ཅེས་གཞུང་ཚབ་ཁང་ནས་བརྗོད་ཀྱི་ཡོད་ཚུལ་བདེན་མིན་དང་།",
    "གལ་སྲིད་བདེན་པ་ཡིན་ན་དེ་ནི་དངོས་འབྲེལ་མ་རེད།",
    "ང་ཚོའི་ངོས་ནས་བོད་མི་རྣམས་གཉེན་འཕྲད་འགྲོ་མཁན་ག་ཚོད་བྱུང་ན་དེར་དགའ་བསུ་ཞུ་ཡི་ཡོད་རེད།",
    "འོན་ཀྱང་རྒྱ་གར་ནང་སྡོད་མཁན་ཚོ་ཚུར་ཡོང་དུས་ཆོག་མཆན་ཡོད་དགོས་པ་ལས་ལག་འཁྱེར་ཞུ་དགོས་པ་རེད་བརྗོད་པར།",
    "སུ་གང་གིས་བཀག་ཐུབ་ཀྱི་མ་རེད།",
    "ང་ཚོས་ཀྱང་ལབ་ཀྱི་ཡོད་པ་མ་རེད་ཅེས་ཟེར།",
    "བྱས་ན་སྐྱོན་མི་འདུག་བརྗོད་པ་དང་ཐུག་འཕྲད་བཀའ་མོལ་གྲུབ་སྟེ་ཕྱིར་ལོག་བྱས།",
    "སོ་ར་ཟེར་བ་བཅས་དང་ལྷན་དུ་མཇལ་མོས་ཞུས།",
    "ཕྲན་རྣམས་པེ་ཅིང་དུ་བསྐྱོད་དོན་སྐོར་ཞིབ་མོལ་ཞུས།",
    "དེ་སྐོར་སྔ་ལོར་ཡང་བཀའ་མོལ་བྱུང་ཡོད་ཅིང་།",
    "ཁོང་གིས་གནས་ཚུལ་ཞིབ་ཕྲ་གསུངས་པར་དགའ་པོ་བྱུང་།",
    "ནང་ནས་སྒྲུབ་ཁྱེད་རྣམ་པས་མཁྱེན་གྱི་རེད།",
