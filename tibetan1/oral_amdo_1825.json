    "རེ་ཞིག་དངོས་པོ་དེ་ནི་འཆིང་བར་མི་འགྱུར་རོ།",
    "གང་གི་ཚེ་དེ་ལྟར་གཞིགས་པ་ན་འཆིང་བས་ཅི་ཞིག་ལྟར་ཡང་འཆིང་བར་མི་བྱེད་པ་དེའི་ཚེ་འགའ་ཡང་འཆིང་བར་མི་བྱེད་པ་ཉེ་བར་ལེན་པ་འདོད་ཆགས་ལ་སོགས་པ་འཆིང་བ་ཉིད་དུ་ག་ལ་འགྱུར།",
    "འདི་ན་འཆིང་བ་ལྕགས་ལ་སོགས་པ་བཅིང་བར་བྱ་བ་ལས་ཐ་དད་པར་ལྔར་གྲུབ་པར་གྱུར་པས་བཅིང་བར་བྱ་བ་ལྷ་སྦྱིན་འཆིང་ངོ་ཞེས་བྱ་བར་མཐོང་བ་དེ་བཞིན་དུ་བཅིང་བར་བྱ་བ་འདུ་བྱེད་རྣམས་སམ་གང་ཟག་གི་སྔ་རོལ་དུ་འཆིང་བ་འདོད་ཆགས་ལ་སོགས་པ་གྲུབ་པར་གྱུར་ན་ནི་སྔར་གྲུབ་པ་དེས་འདུ་བྱེད་རྣམས་ས་མ་གང་ཟག་འཆིང་བར་འགྱུར་ལ་རག་ན་དེ་ནི་ཡོད་པ་ཡང་མ་ཡིན་ཏེ།",
    "སོང་དང་མ་སོང་བགོམ་པས་བསྟན་པར་རིག་པར་བྱ་སྟེ།",
    "རེ་ཞིག་བཅིངས་པ་མི་འཆིང་སྟེ།",
    "གལ་ཏེ་ཁྱོད་ཀྱིས་འཆིང་བ་བཀག་མོད་ཀྱི།",
    "རེ་ཞིག་བཅིངས་པ་མི་གྲོལ་ཏེ།",
    "དེ་ལྟར་ན་རེ་ཞིག་བཅིངས་པ་མི་གྲོལ་ལོ་ཞེས་བྱ་བར་གནས་སོ།",
    "ཕྲ་རྒྱས་ཀྱི་དུག་གི་ལྗོན་ཤིང་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་སྐྱེ་བ་ལ་སོགས་པའི་སྡུག་བསྔལ།",
    "མཐའ་ཡས་པ་སྣ་ཚོགས་པ་ཤིན་ཏུ་ཡིད་དུ་མི་འོང་བ་རྒྱ་ཆེར་སྟེར་བས་དཀྲིགས་པ་འཇིག་ཚོགས་ལ་ལྟ་བའི་རི་ཆེན་པོ་རྩེ་མོ་ཉི་ཤུས་ཆེས་མཐོ་བ།",
    "སྲེད་པའི་ཆུ་ཀླུང་གི་འོབས་ཆེན་པོ།",
    "ཡུལ་གྱི་བདེ་བ་ལ་རེ་བའི་དོགས་ཤིན་ཏུ་འདྲེད་ཅིང་ཡངས་པ་དང་ལྡན་པ་རྒྱུན་མི་འཆད་པར་འབབ་པས་བསྐོར་བ་ལས་བརྒལ་བར་འདོད་པ།",
    "བདག་དང་བདག་གི་བ་དང་བྲལ་བཞིན་དུ།",
    "ཕྱིན་ཅི་ལོག་གི་རྗེས་སུ་སོང་བའི་ཕྱིར་ང་དང་ངའི་ཞེས་བདག་ཏུ་འཛིན་པ་དང་བདག་གིར་འཛིན་པ་ཀུན་དུ་སྤྱོད་པ་ཡོངས་སུ་འཛིན་པས།",
    "ཇི་སྲིད་དུ་བདག་དང་བདག་གིའོ་སྙམ་དུ་འཛིན་པར་མཐོང་བར་ཞེན་པ་དང་།",
    "གང་གི་ཕྱིར་རྣམ་པ་ཐམས་ཅད་དུ་དོན་དམ་པ།",
    "དེ་ནས་དེའི་ཚེ་འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པས་ཇི་ལྟར་བདུད་སྡིག་ཅན་སྒོ་མོའི་ཐེམ་པའི་འཆིང་བས་བཅིངས་པ་ལྟར་ས་སྟེང་དུ་འགྱེལ་ནས།",
    "སྡིག་ཅན་གང་གིས་ཁྱོད་རྟག་ཏུ་བཅིངས་ཤིང་གཟོད་བཅིངས་པ་མ་ཡིན་པ་འཆིང་བ་ཆེས་དམ་པ།",
    "ང་རྒྱལ་ཕྱིན་ཅི་ལོག་གི་འཆིང་བ་དང་།",
    "ཁྱོད་ནི་དེས་རྟག་ཏུ་བཅིངས་པ་ཡིན་གྱིས་གཟོད་བཅིངས་པ་ནི་མ་ཡིན་ནོ།",
    "གཞན་ཡང་སྡིག་ཅན་མི་ཁྱོད་གལ་ཏེ་སླར་བཀྲོལ་ན་དགའ་བར་འགྱུར་རམ།",
    "དེ་ནས་ལྷའི་བུ་རབ་འཐབ་བྲལ་པ་ཞིག་གིས།",
    "སྡིག་ཅན་གང་ཞིག་བཏང་བ་ཁྱོད་སུས་བཅིངས།",
    "སྡིག་ཅན་ཇི་ལྟར་ཁྱོད་མ་བཅིངས་པ་ལས་བཅིངས་པར་འདུ་ཤེས་པ་དེ་བཞིན་དུ་བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་ཐམས་ཅད་མི་རྟག་པ་ལ་རྟག་པར་འདུ་ཤེས་པ།",
    "གཞན་ཡང་སྡིག་ཅན་གང་ཁྱོད་གྲོལ་བར་འགྱུར་ན་གང་ལས་གྲོལ་བར་འགྱུར།",
    "རྨི་ལམ་དུ་དམིགས་པའི་མེ་འབར་བ་ཆུ་དག་གིས་བསད་པ་བཞིན་ནོ།",
    "དེ་དག་གི་རབ་ཏུ་དབྱེ་བ་བརྗོད་པར་འདོད་པས་འདི་སྐད་དུ་བརྗོད་དོ།",
    "འབྲས་བུ་དག་གི་ས་བོན་ཡིན།",
    "རང་གི་མཚན་ཉིད་འཛིན་པའི་དོན་དང་།",
    "དེ་ལྟར་རབ་ཏུ་དབྱེ་བ་བསྟན་པའི་སེམས་གང་ཡིན་པ་དེ་ནི་འབྲས་བུ་དག་གི་ས་བོན་ཡིན་ནོ།",
    "རྒྱུ་གང་ཞིག་འབྲས་བུ་འགྲུབ་པ་ལ་ཐུན་མོང་མ་ཡིན་པ་དེ་ལ་ནི་ས་བོན་ཞེས་བྱ་སྟེ།",
    "ས་ལ་སོགས་པ་ཐུན་མོང་པ་གང་ཡིན་པ་དེ་ནི་ས་བོན་མ་ཡིན་གྱི།",
    "ཡང་དུས་གང་གི་ཚེ་ས་བོན་འབྲས་བུའི་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཞེ་ན།",
    "འདི་གཞན་དུ་འབྲས་བུ་དག་གི་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དྲང་སྲོང་མཆོག་གི་ལས་རྣམས་ནི།",
    "ལས་དེ་དག་གི་བྱེ་བྲག་ནི།",
    "དེ་ནི་ལུས་དང་ངག་གིར་འདོད།",
    "ལས་གཉིས་པ་བསམས་པ་ཞེས་གང་གསུངས་པ་དེ་ནི་ལུས་དང་ངག་གི་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "ལུས་དང་ངག་དག་གིས་དེ་ལྟ་དེ་ལྟར་འཇུག་པར་བྱའོ་ཞེས་དེ་ལྟར་སེམས་ཀྱིས་བསམས་ནས་གང་ཞིག་བྱེད་པ་དེ་ནི་བསམས་པའི་ལས་ཞེས་བྱའོ།",
    "དེ་དག་གི་སྒོ་ནས་མཐར་ཐུག་པར་འགྲོ་བའི་ཕྱིར་ན་ལུས་ཀྱི་དང་ངག་གིའོ།",
    "དེ་ལྟར་ན་ལུས་ཀྱི་དང་ངག་གི་དང་ཡིད་ཀྱི་སྟེ།",
    "དེང་ནས་བཟུང་སྟེ་སྲོག་གཅོད་པ་ལ་སོགས་པ་དག་སྤོང་ངོ་ཞེས་ལུས་དང་ངག་གི་རྣམ་པར་རིག་བྱེད་ཡོངས་སུ་རྫོགས་པའི་དུས་ནས་བཟུང་སྟེ།",
    "རེ་ཞིག་གལ་ཏེ་སྨིན་པའི་དུས་བར་དུ།",
    "གལ་ཏེ་ལས་འདི་སྐྱེས་ནས་རྣམ་པར་སྨིན་པའི་དུས་ཀྱི་བར་དུ་རང་གི་ངོ་བོས་གནས་སོ་ཞེས་བྱ་བར་རྟོག་ན་ནི།",
    "འཇིག་པ་དང་བྲལ་བ་ཡང་འདུས་མ་བྱས་ཉིད་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་དང་།",
    "དེ་ལྟར་ན་རེ་ཞིག་རྟག་པ་ཉིད་ཀྱི་སྐྱོན་དུ་འགྱུར་རོ།",
    "རེ་ཞིག་ཁོ་བོ་ཅག་ལ་འདུ་བྱེད་རྣམས་རྟག་པ་ཉིད་ཀྱི་ཉེས་བར་ནི་མི་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་ས་བོན་ཆད་པ་དང་རྟག་པར་ཐལ་བར་འགྱུར་བ་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཅི་སྟེ་ཡང་མ་འོངས་པའི་རྒྱུན་གྱི་རྒྱུའི་དངོས་པོར་གྱུར་ནས་རང་གི་ངོ་བོ་ལས་མི་ཉམས་པར་གྱུར་ན་ནི།",
    "དེའི་ཕྱིར་ལས་སྐད་ཅིག་མར་ཁས་བླངས་སུ་ཟིན་ཀྱང་ཆད་པ་དང་རྟག་པར་ལྟ་བར་ཐལ་བ་ཡོད་པ་མ་ཡིན་ནོ།",
    "ངག་གི་བཞི་ནི།",
    "དེ་ལྟར་རེ་ཞིག་ཁ་ཅིག་གིས་བརྩད་པའི་ལན་བཏབ་པ་ཡིན་དང་།",
    "གཞན་དག་གིས་དེ་ལ་སྐྱོན་བརྗོད་ནས།",
    "དེ་འགགས་པས་འབྲས་བུ་མེད་པར་ཐལ་བར་འགྱུར་བ་ཡང་མ་ཡིན་ཏེ།",
    "འཕགས་པ་ཡང་སོ་སོ་སྐྱེ་བའི་ལས་དང་ལྡན་པར་འགྱུར་དུ་འོང་བས་མཐོང་བའི་། ལམ་གྱིས་སོ་སོ་སྐྱེ་བའི་ལས་དག་ཁོ་ན་སྤོང་གི་ཆུད་མི་ཟ་བ་ནི་དེའི་ལས་སྤངས་ཀྱང་མཐོང་བའི་ལམ་གྱིས་སྤོང་བ་མ་ཡིན་ཏེ།",
    "ཀྱང་གི་སྒྲས་ནི་ཁམས་ལས་ཡང་དག་པར་འདས་པས་ཀྱང་སྤང་བར་བྱ་བ་ཡིན་ནོ་ཞེས་རྣམ་པར་རྟོག་པའི་དོན་ཏོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ལས་འཇིག་ཀྱང་ཆུད་མི་ཟ་བ་མི་འཇིག་ལ།",
    "སྐྱོན་རྣམས་སུ་ནི་ཐལ་བར་འགྱུར།",
    "དེ་ལྟར་ཆུད་མི་ཟ་བས་སྤོང་བས་སྤང་བར་བྱ་བ་ཉིད་དུ་ཁས་ལེན་ན་ལས་འཇིག་པ་ལ་སོགས་པའི་སྐྱོན་རྣམས་སུ་ཐལ་བར་འགྱུར་རོ།",
    "ཚུལ་གཉིས་པོ་ཐམས་ཅད་ཀྱི་སྟེ་སེམས་པ་དང་བསམས་པའི་ལས་ཀྱི་རང་བཞིན་ཅན་གྱི་ལས་དང་ལས་ཀྱི་ཆུད་མི་ཟ་བ་རེ་རེ་སྐྱེ་བར་འགྱུར་རོ།",
    "གང་གི་ཕྱིར་ལས་ནི་བྱས་ནས་འགག་གི་རང་བཞིན་གྱིས་གནས་པ་མ་ཡིན་ལ།",
    "སྟོང་པ་ཉིད་དུ་ཐལ་བ་ཡིན་ནོ།",
    "དེ་ལྟར་ལས་མི་གནས་པས་ཆད་པར་ལྟ་བར་ཐལ་བར་འགྱུར་བ་ཡང་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་ལས་རང་གི་ངོ་བོས་མི་གནས་པར་ཁས་བླངས་པས་རྟག་པར་སྨྲ་བར་ཐལ་བ་ཡང་མ་ཡིན་ལ།",
    "ཞེས་གང་སྨྲས་པ་དེ་ཁོ་བོ་ཅག་གི་ཕྱོགས་ལ་མི་འཐད་དོ།",
    "དེའི་ཕྱིར་ཁོ་བོ་ཅག་གིས་བརྗོད་པའི་བརྟག་པ་ཁོ་ན་རིགས་སོ་ཞེའོ།",
    "འདི་ལྟར་གལ་ཏེ་ལས་རང་གི་ངོ་བོས་སྐྱེ་བར་འགྱུར་ན་ནི།",
    "གང་གི་ཚེ་རང་བཞིན་གྱིས་སྟོང་པས་ལས་སྐྱེ་བ་མེད་པ་དེའི་ཚེ་ན་གང་ལས་དཔྱད་པ་འདིར་འགྱུར་བ་དེ་ལ་གནས་པ་དང་འཇིག་པ་ཡོད་པར་ག་ལ་འགྱུར།",
    "གང་གི་ཕྱིར་ལས་རང་བཞིན་མེད་པ་དེའི་ཕྱིར་སྐྱེ་བ་མེད་དོ།",
    "གང་གི་ཕྱིར་རྟག་ལ་བྱ་བ་མེད་ཕྱིར་རོ།",
    "དེ་ལ་སྐྱོན་དུ་ཐལ་བར་འགྱུར།",
    "གང་གི་སྲོག་གཅོད་པའི་ལས་མ་བྱས་པ་དེ་ལ་ཡང་ལས་དེ་མ་བྱས་ཀྱང་ཡོད་པས་འདི་དེ་དང་འབྲེལ་བའི་ཕྱིར་མ་བྱས་པ་དང་ཕྲད་པའི་འཇིག་པར་འགྱུར་རོ།",
    "གང་དག་ཞིང་རྨོ་བ་དང་ཚོང་དང་བ་ལང་འཚོ་བ་ལ་སོགས་པའི་བྱ་བ་འབྲས་བུའི་དོན་དུ་རྩོམ་པ་དེ་དག་ཐམས་ཅད་ཀྱིས་མ་བྱས་བཞིན་དུ་ཡོད་པའི་ཕྱིར་དོན་མེད་པར་འགྱུར་ལ།",
    "རྣམ་པར་སྨིན་པ་སྨིན་པར་མ་གྱུར་བའི་གནས་སྐབས་ལྟར་རང་གི་ངོ་བོ་ལས་མ་ཉམས་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་ལས་རང་བཞིན་མེད་པ་དེའི་ཚེ་ཁོ་བོ་ཅག་དེ་སྐད་དུ་རྣམ་པར་འཆད་བདག་ལ་རྟག་པ་དང་།",
    "ཆད་པར་ལྟ་བར་ཐལ་བའི་སྐྱོན་དུ་མི་འགྱུར་རོ།",
    "ལས་ཀྱི་རྒྱུ་ཉོན་མོངས་པ་རྣམས་ནི་ཡོད་པ་ཡང་ཡིན་ཏེ།",
    "ཅིའི་ཕྱིར་ཞེ་ན་གང་གི་ཕྱིར།",
    "ལས་འདི་ཉོན་མོངས་བ་དག་ཉིད་ལ།",
    "ཉོན་མོངས་དེ་དག་ཡང་དག་མིན།",
    "གལ་ཏེ་ཉོན་མོངས་ཡང་དག་མིན།",
    "འདིར་ལས་འདི་ཉོན་མོངས་པའི་བདག་ཉིད་སྟེ་ཉོན་མོངས་པའི་རྒྱུ་ཅན་ཡིན་ལ་ཉོན་མོངས་པ་དེ་དག་ཀྱང་ཡང་དག་པར་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེ་ཕྱིར་ཉོན་མོངས་ཡང་དག་མེད།",
    "དེའི་ཕྱིར་དེ་ལྟར་ཉོན་མོངས་པ་དེ་དག་ཡང་དག་པ་མ་ཡིན་ན།",
    "དེའི་ཚེ་དེ་དག་གི་རྒྱུ་ཅན་ལས་གང་ཡིན་པ་དེ་དག་ཡང་དག་པར་ཇི་ལྟར་འགྱུར།",
    "འདིར་སྨྲས་པ་ལས་དང་ཉོན་མོངས་པ་དག་ནི་ཡོད་པ་ཉིད་དེ།",
    "འདིར་ལས་དང་ཉོན་མོངས་པ་དག་གི་འབྲས་བུ་ལུས་ཞེས་བྱ་བ་དམིགས་པ་ཡིན་ལ།",
    "གང་གི་འབྲས་བུ་དམིགས་པ་དེ་ནི་ཡོད་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་དེ་དག་གི་འབྲས་བུ་ལུས་ཞེས་བྱ་བ་ཡོད་ན་ནི།",
    "ལས་དང་ཉོན་མོངས་པ་དག་ཀྱང་ཡོད་པར་འགྱུར་ན།",
    "ལས་དང་ཉོན་མོངས་པ་དག་ནི།",
    "གལ་ཏེ་ལས་དང་ཉོན་མོངས་པ།",
    "ཇི་ལྟར་ལས་དང་ཉོན་མོངས་པ་དག་སྟོང་པ་དེ་ལྟར་ནི་བསྟན་ཟིན་ཏོ།",
    "དེའི་ཕྱིར་གང་གི་ཚེ་ལས་དང་ཉོན་མོངས་པ་དག་ཉིད་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་དེ་དག་གི་འབྲས་བུ་ལུས་རྣམས་ཡོད་པ་མ་ཡིན་པ་ལ་བརྗོད་པ་ཅི་ཞིག་ཡོད་པར་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་དེ་དག་ཡོད་པ་མ་ཡིན་པ་ཉིད་དུ་སྔར་གྲུབ་ཟིན་པ་དེའི་ཕྱིར་འདི་ལ་བརྗོད་པར་བྱ་བ་ལྷག་མ་ཅུང་ཟད་ཀྱང་ཡོད་པ་མ་ཡིན་ནོ་སྙམ་དུ་དགོངས་པ་ཡིན་ནོ།",
    "ནམ་མཁའི་ཨ་མྲའི་ཤིང་ཐོག་བཞིན་ནོ།",
    "ཇི་ལྟར་ཞེ་ན་གང་གི་ཕྱིར་ནི་ལས་འདི་ནི།",
    "རེ་ཞིག་གལ་ཏེ་རྐྱེན་ལས་བྱུང་བར་འདོད་ན་ནི།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ལས་འདི་རྐྱེན་ལས་བྱུང་བའམ།",
    "གང་གི་ཚེ་དེ་ལྟར་ལས་དང་བྱེད་པ་པོ་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་ལས་ལས་སྐྱེས་པའི་འབྲས་བུ་མེད་པ་བ་ཡོད་པར་ག་ལ་འགྱུར།",
    "གལ་ཏེ་དེ་ལྟར་ཁྱོད་ཀྱིས་དངོས་པོ་རྣམས་རང་བཞིན་མེད་པར་རྣམ་པར་གཞག་ན།",
    "འོ་ན་ནི་གང་བཅོམ་ལྡན་འདས་ཀྱིས་རང་གིས་བྱས་པའི་ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ནི་རང་ཉིད་ཀྱིས་མྱོང་བར་འགྱུར་བ་ཡིན་ནོ་ཞེས་གསུངས་པ་དེ་དག་ཐམས་ཅད་ཚུལ་འདིས་བསལ་བར་འགྱུར་ལ།",
