    "གང་གི་ཕྱིར་གཞན་དུ་བརྗོད་པ་རྙེད་པའི་དངོས་པོ་གཞན་ལ་གཞན་ཉིད་རྟོག་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ན་རེ་ཞིག་གཞན་ལ་གཞན་ཉིད་མི་སྲིད་དོ།",
    "གང་གི་ཕྱིར་གཞན་མ་ཡིན་པ་ནི་གཅིག་ཉིད་ལ་བྱ་ལ་གཞན་མ་ཡིན་པ་ལ་ཡང་གཞན་ཉིད་ཡོད་པ་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་གཞན་ཉིད་མེད་པ་དེའི་ཚེ་གཞན་ཉིད་དང་འདུ་བའི་རྒྱུ་ཅན་བློ་དང་སྒྲ་འཇུག་པའི་རྒྱུ་དངོས་པོ་གཞན་ཡང་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བར་གྲུབ་བོ།",
    "གལ་ཏེ་གཞན་ཉིད་མེད་པ་དེ་ལྟ་ན་ཡང་གཞན་ནི་རེ་ཞིག་ཡོད་པ་ཡིན་ལ།",
    "གང་གི་ཚེ་སྔར་གཞན་ཉིད་ནི་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་ཟིན་པ་དེའི་ཚེ་གཞན་ཉིད་མེད་པར་གཞན་ནམ་དེ་ཉིད་ཡོད་པར་ག་ལ་འགྱུར།",
    "འདིར་གལ་ཏེ་ཡང་ལྟ་བ་ལ་སོགས་པ་དག་ལ་གཞན་ཉིད་མེད་དོ་ཞེས་བསྟན་ཟིན་མོད་ཀྱི།",
    "དེ་ལྟ་ན་ཡང་རེག་པ་ནི་གསུམ་འདུས་ཤིང་ཚོགས་པའོ་ཞེས་བྱ་བས་ཕྲད་པ་ཡང་ཡོད་པ་ཡིན་ཏེ།",
    "མིག་གཅིག་པུ་ལ་ཡང་ཕྲད་པ་ཡོད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གཟུགས་ལ་སོགས་པ་ལས་སོ་སོར་གྱུར་པའི་མིག་གཅིག་པུ་ལ་ཡང་ཕྲད་པ་ཡོད་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གལ་ཏེ་ཡང་ཕྲད་པ་ཡོད་པ་མ་ཡིན་མོད་ཀྱི།",
    "གང་གི་ཕྱིར་གང་གི་ཚེ་ཕྲད་པ་ཉིད་མེད་དོ་ཞེས་བསྟན་པ་དེའི་ཚེ་ཕྲད་པ་མེད་པར་ཕྲད་བཞིན་པ་ལ་སོགས་པ་ཡོད་པར་ག་ལ་འགྱུར་དེ་ལ་ཕྲད་བཞིན་པ་ནི་ད་ལྟར་བ་ཕྲད་པའི་བྱ་བའི་སྒྲུབ་བྱེད་ལས་སུ་གྱུར་པའོ།",
    "ཕྲད་བཞིན་པ་ལ་སོགས་པ་མ་གཟིགས་ཤིང་།",
    "མིག་གིས་གཟུགས་རྣམས་མཐོང་བ་གང་ཡིན་པའང་།",
    "མཚན་མོ་རྐྱེན་རྣམས་མེད་ན་མཐོང་མི་འགྱུར།",
    "དེ་ཕྱིར་མིག་གིས་ནམ་ཡང་མཐོང་བ་མེད།",
    "དེའི་ཚེ་ཡོད་པར་གྱུར་པ་རྣམས་ལ་རྒྱུ་དང་རྐྱེན་དག་གིས་དགོས་པ་ཅི་ཞིག་ཡོད་དེ།",
    "བྱས་པ་ཐལ་བར་བརྩད་པ་ནི་ཁོ་བོ་ཅག་ལ་གནོད་པར་བྱེད་པ་མ་ཡིན་ནོ་སྙམ་ན།",
    "དེ་ནི་དངོས་པོ་གཞན་དང་ཕྲད་པས་མ་བསྐྱེད་པའི་ཕྱིར་དེ་དག་གི་རང་བཞིན་ཞེས་བྱའོ།",
    "གལ་ཏེ་མེའི་རང་བཞིན་ནི་ཚ་བ་ཉིད་དོ་ཞེས་སྐྱེ་བོ་བ་གླང་རྫི་དང་བུད་མེད་ཡན་ཆད་ལ་གྲགས་པ་མ་ཡིན་ནམ་ཞེ་ན།",
    "ཅི་ཁོ་བོ་ཅག་གིས་མ་གྲགས་སོ་ཞེས་སྨྲས་སམ།",
    "མ་རིག་པའི་ཕྱིན་ཅི་ལོག་གི།",
    "བདག་ཉིད་ཀྱི་མཚན་ཉིད་ནི་རང་གི་མཚན་ཉིད་དོ་ཞེས་བྱ་བའི་ཕྱིར་རོ།",
    "གང་གི་ཚེ་མ་རིག་པའི་རབ་རིབ་དང་བྲལ་བ་དྲི་མ་མེད་པའི་ཤེས་རབ་ཀྱི་སྤྱན་མངའ་བ་རྣམས་ཀྱིས་གཟིགས་པ་ལ་ལྟོས་ནས་ནི།",
    "དེའི་ཚེ་རབ་རིབ་དང་བྲལ་བ་དག་གིས་རབ་རིབ་ཅན་གྱིས་དམིགས་པའི་སྐྲ་ཤད་མ་མཐོང་བ་ལྟར་འཕགས་པ་བྱིས་པའི་སྐྱེ་བོའི་བློས་བརྟགས་པའི་རང་བཞིན་མ་གཟིགས་པ་རྣམས་ཀྱིས་འདི་ནི་དངོས་པོ་རྣམས་ཀྱི་རང་བཞིན་མ་ཡིན་ནོ་ཞེས་གསལ་བར་གསུངས་པར་མཛད་པ་ཡིན་ཏེ།",
    "ཇི་ལྟར་རབ་རིབ་ཅན་དག་གིས།",
    "ད་ནི་། དེ་དག་གི་རང་བཞིན་གྱི་མཚན་ཉིད་གང་ཡིན་ཞིང་།",
    "འདི་ནི་རང་གི་དངོས་པོ་ནི་རང་བཞིན་ནོ་ཞེས་བྱ་བས་གང་ཞིག་དངོས་པོ་གང་གི་བདག་གི་བའི་ངོ་བོ་ཡིན་པ་དེ་ནི་དེའི་རང་བཞིན་ཡིན་ནོ་ཞེས་བརྗོད་དོ།",
    "གང་ཞིག་གང་གི་བདག་གི་བ་ཡིན་ཞེ་ན།",
    "གང་གིས་གང་མ་བཅོས་པའོ།",
    "གང་ཞིག་བཅོས་མ་ཡིན་པ་དེ་ནི་དེའི་བདག་གི་བ་མ་ཡིན་ཏེ།",
    "གང་ཞིག་གང་ལ་རག་མ་ལས་པ་དེ་ཡང་དེའི་བདག་གི་བ་ཡིན་ཏེ།",
    "རང་གི་ཁོལ་པོ་དང་རང་གི་ནོར་དག་བཞིན་ནོ།",
    "གང་ཞིག་གི་གཞན་ལ་རག་ལས་པ་གང་ཡིན་པ་དེ་ནི་དེའི་བདག་གི་བ་མ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་བཅོས་མ་དང་རང་ལ་ལྟོས་པ་རང་བཞིན་ཉིད་དུ་མི་འདོད་པ་དེ་ཉིད་ཀྱི་ཕྱིར་ཚ་བ་ཉིད་མེའི་རང་བཞིན་ནོ་ཞེས་བྱ་བ་ནི་མི་རིགས་ཏེ།",
    "གང་གི་ཕྱིར་འདི་དེ་ལྟར་ཡིན་པ་དེའི་ཕྱིར།",
    "ཅི་མེའི་རང་གི་ངོ་བོ་དེ་ལྟ་བུར་གྱུར་པ་དེ་ཡོད་དམ་ཞེ་ན།",
    "དེ་ནི་རང་གི་ངོ་བོས་ཡོད་པ་ཡང་མ་ཡིན་ལ་མེད་པ་ཡང་མ་ཡིན་ནོ།",
    "དེ་ལྟ་ཡིན་མོད་ཀྱི།",
    "དངོས་པོའི་རྣམ་པ་མ་རིག་པའི་རབ་རིབ་ཀྱི་མཐུས་དམིགས་པ་ནི་མ་གཟིགས་པའི་ཚུལ་གྱིས།",
    "བདག་ཉིད་གང་གིས་འཕགས་པ་མ་རིག་པའི་རབ་རིབ་དང་བྲལ་བ་རྣམས་ཀྱི་ཡུལ་དུ་འགྱུར་ཏེ།",
    "ངོ་བོ་དེ་ཉིད་དེ་དག་གི་རང་བཞིན་དུ་རྣམ་པར་གཞག་གོ།",
    "ཞེས་བྱ་བ་འདི་ནི་སློབ་དཔོན་དག་གིས་དེའི་མཚན་ཉིད་དུ་རྣམ་པར་གཞག་གོ་ཞེས་བྱ་བར་ཤེས་པར་བྱའོ།",
    "གང་གི་དངོས་རྣམས་དངོས་མེད་ཤེས་པ་སྟེ།",
    "དེ་ནི་ཏིང་འཛིན་མཚན་མ་མེད་ལ་རེག་ཅེས་གསུངས་པ་ལྟ་བུའོ།",
    "གལ་ཏེ་ཡང་དངོས་པོ་རྣམས་ལ་རང་བཞིན་ཡོད་པ་མ་ཡིན་པ་དེ་ལྟ་ན་ཡང་རེ་ཞིག་གཞན་གྱི་དངོས་པོ་ནི་ཡོད་དེ།",
    "གང་གི་ཚེ་རྣམ་པར་དཔྱད་པ་ན་གང་ལ་ཡང་རང་བཞིན་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་ནི་གཞན་ཉིད་ཡོད་པར་ག་ལ་འགྱུར།",
