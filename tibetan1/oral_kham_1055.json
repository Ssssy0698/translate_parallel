    "ཡིན་ནའང་གཡུ་ཆེན་ནམ་མཁའ་སྒྲོལ་མའི་སྐོར་རྒས་པོ་ཚོའི་ངག་སྒྲོས་སུ་ཅུང་ཆ་ཚང་བར་གླེང་རྒྱུ་འདུག་གཡུ་ཆེན་ནམ་མཁའ་སྒྲོལ་མར་སྦ་ནག་མཁའ་འགྲོ་མ་ཞེས་འབོད་པ་དང་།",
    "ཐོག་མར་ཁྱེད་རང་འཆི་ཁར་སྨོན་ངན་འདེབས་མི་རུང་།",
    "ངའི་ཆེད་དུ་མིན་ན་ཁོ་རང་ལ་འཆི་རྐྱེན་ངན་པ་དེ་འདྲ་འཕྲད་མི་སྲིད་ལ་སྨོན་ངོན་དེ་འདྲ་འདེབས་མི་སྲིད་སྙམ་པ་དང་།",
    "དེ་ལ་མགོ་རྒྱན་ཡང་མི་འདུག་ལ་ཁུག་ཀྱོག་ཅིག་ཏུ་བཀལ་འདུག་པས།",
    "ཡང་ན་ཅི་ཡང་ཡིད་ལ་མི་ཤར་བར་ནག་འཚུབ་བེ་འདུག་པ་སོགས་ཅི་རིགས་ཡོད་པ་ཡིན་འདུག།",
    "ང་རང་རྟབ་རྟབ་པོར་གྱུར་ལ།",
    "སོག་པོ་སོགས་འབྲོག་པའི་མི་རིགས་གཞན་ལའང་ཆང་འདི་ཧ་ཅང་དར་རྒྱས་ཆེ་བ་ཡིན་འདུག་ཡིན་ནའང་།",
    "ང་རང་ན་སོ་རིམ་གྱིས་རྒྱས་ཏེ་དོན་ལ་བསམ་གཞིག་བྱེད་ཐུབ་པའི་ཚད་ལ་སླེབ་དུས།",
    "ཅུང་མཚར་སྣང་དང་ཟུར་ཟའི་རྣམ་པ་དང་བཅས་ཨ་ཙི།",
    "ངས་སྒྲ་གྲགས་པའི་ཕྱོགས་སུ་ཕར་བལྟས་ཙ་ན།",
    "ཁྱེད་རང་ག་ལེར་ཕེབས་རོགས་མཛོད།",
    "ཁྱིམ་མི་གང་བོས་མཆོད་མེ་སྒྲོན་བཞིན་འདུག་ཁྱིམ་མི་གང་བོས་མ་ཎི་བློ་བཞིན་འདུག་ང་ཁོ་ནས་ཡིག་ཕྲེང་འགའ།",
    "ང་རང་ཉིད་རིམ་བཞིན་མི་ཚེའི་ཕྱེད་ཀར་སླེབས་ལ་ཉེ་དུས།",
    "ཁྱེད་རང་བདེ་ན་ཆོག་སྡུག་ན་ཆོག་ཁྱེད་ཀྱི་དགེ་སེམས་འོ་མཚོའི་ཀློང་ན་བྱམས་བརྩེ་ཡི་ངང་མདངས་དཀར་པོའི་འོད་རླབས་ནམ་ཡང་ཆིལ་ཆིལ་འཕྲོ་ལ།",
    "འདི་ལྟ་བུའི་དགོད་གཏམ་ཞིག་ཀྱང་གང་སར་ཁྱབ་བཞིན་འདུག་སྟེ།",
    "རྣམ་པ་ཆོ་ཡོད་ནས་ཆ་མེད་དུ་ཉིན་མཚན་བར་ནས་ཀྱང་འགྲོ་བཞིན་གདའ།",
    "ས་ལག་མཐིལ་ཙམ་ཡང་རང་དགར་བསྐྱུར་བའི་དཔེ་ཡོད་མི་སྲིད།",
    "འགྲོ་འཆག་ཉལ་འདུག་ཡུལ་སྲོལ་གོམས་གཤིས་སོགས་ལ་རང་འགུལ་དང་རང་འགུལ་མ་ཡིན་པའི་སྒོ་ནས་ཕོག་ཐུག་བྱུང་བས།",
    "ཁང་ལེབ་ཏུ་བསྡད་ཡོད་པའི་མི་སེར་ཚོས་ད་ལོའི་གནམ་འདིའི་རྐུབ་བརྡོལ་འདུག་ཅེས་འཁང་ར་དང་ལེ་བདའ་བྱེད་ཀྱིན་མཆིས།",
    "གྲོག་མ་ཚང་བརྡོལ་ལྟར་ཚོང་འདུས་ཀྱི་ཕྱི་ནང་ཐམས་ཅད་དཔེ་དེབ་སྣ་ཚོགས་ཀྱིས་བཀང་འདུག་ན།",
    "ཤེས་རབ་འཕེལ་བའི་རྒྱུ་དང་རང་སོ་ཟིན་པའི་རྩིས།",
    "དོན་དམ་པས་ཐོས་པ་དོན་དུ་གཉེར་མཁན་ཞིག་ཡིན་ཙ་ན།",
    "རྣམ་སྲོལ་འདི་འུ་ཅག་དང་ཡུལ་དུས་ངོ་བོ་གསུམ་གྱིས་བསྐལ་འདུག་གཤིས་འོང་དཀའ་ཚོད་དུ་འདུག་ཀྱང་།",
    "དེའི་བརྗོད་བྱ་རྗོད་བྱེད་དང་བསམ་བློ་ལྟ་གྲུབ་རྣམས་འགལ་འཁྲུལ་ནོངས་གསུམ་གྱིས་ཁེངས་འདུག་ཚུལ་མ་ནོར་བར་གཞལ་ཕྱིར་དང་།",
    "ཕྱོགས་གཉིས་ནས་བང་སོའི་ཚོགས་ལ་དཔྱད་ཞིབ་བྱེད་མགོ་བརྩོམས་བསླེབས་རི་ལྷོ་བྱང་ལྷོ་མཚམས་སུ་བརྟན་ལྷང་ངེར་འགྱིང་འདུག་ལ།",
    "མདུན་ཕྱོགས་སུ་སྐྱེམས་སྟོང་ཆུ་ཀླུང་ལྷུང་ལྷུང་དུ་ཡར་ཀླུང་གཙང་བོར་འབབ་བཞིན་འདུག་བང་སོའི་ཚོགས་ཀྱི་ཤར་རྒྱུད་དུ་ཁང་བ་རྙིང་བའི་ཤུལ་དང་།",
    "དེ་འདྲ་རིང་བོ་འདུག་ཅེས་ཟེར་མཁན་ཡང་སྣང་།",
    "ད་ལྟ་དངོས་སུ་མཇལ་རྒྱུ་ཡོད་པའི་བང་སོ་བཅུ་གཉིས་ཙམ་ལས་མི་འདུག་བོད་ཀྱི་བཙན་པོར་བང་སོ་འདེབས་པའི་སྲོལ་ནི་སྤུ་དེ་གུང་རྒྱལ་རིང་ནས་བྱུང་བར་གྲགས་ལ།",
    "དུས་ཚོད་བཞུར་བཞིན་འདུག་མི་རྣམས་བརྗེ་བཞིན་མཆིས།",
    "གནས་དེར་འགྲོ་བའི་རླངས་འཁོར་མེད་པས་ང་རང་རྐང་ཐང་དུ་མི་འགྲོ་ཀ་མེད་བྱུང་ལ།",
    "མ་ཎི་ཁང་ཆེན་དེ་ནི་ཕྱི་རིམ་ནང་རིམ་གཉིས་སུ་ཕྱེ་ཡོད་ལ་ཕྱི་རིམ་དུ་ཆུ་འཁོར་ཧ་ཅང་ཆེན་པོ་འགའ་འཁོར་གྱིན་འདུག་པ་དང་།",
    "དེའང་ལོས་ཡིན་ཏེ།",
    "སྐད་ཆ་འདི་འདྲ་ཞིག་འདུག་སྟེ།",
    "སྔ་མས་མ་ཐུབ་པ་དང་མ་ཤེས་པར་ལུས་འདུག་པ་དག་ལ་ཕྱི་མ་ཚོས་ཀྱང་དོགས་གཞིག་དང་མནོ་བསམ་མི་གཏོང་ལ།",
    "ང་རང་གསོད་པའི་ལག་དམར་བ་བྱུང་ཡང་།",
    "ཀློག་མཁན་དེ་གནས་བརྟན་སྦེད་བྱེད་ཡིན་པ་འདུག་གསུངས་པས།",
    "རྗེའི་ཞལ་ནས་སྒྲོལ་མ་ཐུགས་རྗེ་མྱུར་ཟེར་བ་བདེན་པ་འདུག་གསུངས།",
    "རྗེ་བཙུན་བྱམས་པ་གང་ཡིན་མི་ཤེས་པ་ཞིག་བྱོན་འདུག་པ་ལ།",
    "མཚན་བྱང་དགོས་རིགས་མི་འདུག་ནའང་།",
    "ཇོ་བོ་བརྗེ་པོ་མེད་པར་ཁྱེད་རང་ལོང་ནམ་བྱུང་ཞིག་ལ་གདན་དྲོངས་ཤོག་གསུངས།",
    "སང་གདན་དྲངས་ཡོང་བའི་དོ་ནུབ་མནལ་ལམ་ཁྱད་པར་ཅན་བྱུང་འདུག་ནའང་གསལ་པོ་མི་སྣང་ལ།",
    "ད་ལྟ་ག་ན་ཕེབས་ཀྱིན་འདུག་ལགས་ཞུས་པས།",
    "ད་རུང་དུམ་ཙམ་མི་ཕེབས་པ་གདའ།",
    "ཁྱེད་རང་རྣམས་ཤམ་ཐབས་སྒྲིགས།",
    "རྗེ་བཙུན་བྱམས་པའི་སྐུ་རང་བྱོན་ཡིན་པར་འདུག་འདིའི་རྒྱུ་ཛྷི་ཀྵིམ་ལ་རང་བྱོན་དུ་བྱོན་པ་ལ།",
    "པཎྜི་ཏས་ཕྱག་གནས་མཛད་པར་འདུག་བར་སྐབས་ཤིག་ཏུ་རྒྱ་གར་ཤར་ནུབ་བཞིན་བོད་གང་རུང་ཞིག་ཏུ་མིས་ཞབས་ཏོག་སྒྲུབ་མཁན་ཡང་བྱུང་བའི་རྗེས།",
    "དེ་ནས་རང་རང་གཞིས་རྣམས་བཙོངས་པའི་རིན་གྱིས་གསེར་གཡུ་རྣམས་བཅས་ཁྱེར་ནས་རྒྱ་གར་ལ་བྱོན་པས།",
    "ལྕང་སྔ་མའི་སྔུར་བྱང་མ་ཞིག་དུས།",
    "སྔོན་ལ་ཁྱེད་རང་རྣམས་ལྟོ་ཟོ་གསུངས།",
    "བ་ཚད་ཆེན་པོ་བྱེད་པའི་རྣམ་པ་ཞིག་འདུག་པ་ལ།",
    "ཤུག་ཁྲོད་དུ་ཉེར་གཅིག་དུས་ཇའི་རྟེན་ནས་ཁལ་བརྒྱ་དང་སུམ་ཅུ།",
    "ད་ང་ན་སོ་རྒས་ནས་ཐག་རིང་དུ་མི་སླེབས་པ་འདུག་འདི་ནས་བྱེད་གསུངས་ནས།",
    "ཞལ་མཇལ་ཞིང་གསུང་འཕྲོས་མང་དུ་གནང་ཐུབ་ཀྱིན་གདའ་ཞིང་།",
    "ད་བསྟན་པ་ཤིག་པ་བྱས་རུང་འདི་ཀ་ཡིན་པ་འདུག་འདི་ལོངས་པའི་དུས་ག་ལ་ཡོང་ཟེར་ནས་སྐད་ངན་སྣ་ཚོགས་ཤོར་བ་བྱུང་ཞེས་གྲགས་ལ།",
    "བུ་འདི་མིག་རྩ་གཞན་ལས་གྲུང་བར་འདུག་པས་ཕ་ཤུལ་འཛིན་ཐུབ་ངེས་ཀྱི་སྔགས་པ་ཞིག་ཡོང་འདུག་པས་ཁྱིམ་པ་བྱེད་དགོས།",
    "རྡོ་གཅལ་གྱི་སྐས་འོག་ཏུ་ཆིབས་རྟ་བཟང་པོ་ཞིག་བཟུང་འདུག་པ་ལ།",
    "དེའི་ནང་ནས་ཊམ་གཉིས་ལས་མི་འདུག་པས་ཐུགས་ལ་ཁོང་བདེན་པར་འདུག་དགོངས་ཀྱང་།",
    "བྱེས་ཆས་ཅུང་ཟད་མ་གཏོགས་ཁྱེད་རང་ལ་བཞག་པས་ཆོག་པས་ཁྱེད་ཀྱིས་ངོར་གྱི་ཁྲི་དམར་འདི་བཟུང་ལ་གདན་ས་མཛོད་གསུང་པའི་བཀའ་ཕེབས་པ་ལ།",
    "ད་འོ་ན་ཁམས་ལ་མ་འབྱོན་པར་དགོན་གླེ་ལུང་དེ་དབེན་ཞི་མཐུན་རྐྱེན་འཛོམས་པ་སོགས་གང་ཅི་ནས་ལེགས་པ་ཞིག་འདུག་པས་དེར་བཞུགས་ལ་དབུ་ཐོད་འབོགས་པ་མཛོད་གསུངས་པ་ལ།",
    "ཕེབས་སྡོང་ལ་བདག་མི་ཐོན་པར་འདུག་ལགས།",
    "གསང་བ་འདུས་པ་ལྷ་བཅུ་དགུའི་དཀྱུལ་འཁོར་ལམ་མེ་བ་གཅིག་འདུག་པ།",
    "ད་འབྲལ་མེད་དུ་འདུག་གསུང་།",
    "ཁོད་རྣམས་ཅུང་མ་དགྱེས་པ་འདུག་པ་ལ།",
    "ཁོང་རང་ཡང་ཉམས་ཉིན་མཚན་འདས་ནས་འཁྲབ་པ་སོགས་བྱས་པ་བྱུང་སྣང་ངོ།",
    "སྲིད་པ་མི་རབས་མཆེད་དགུ་ནི་མུ་ཏིག་དར་ལ་བརྒྱུས་པ་ལྟ་བུ་ཅིག་ཡིནྡྲ་པར་འདུག་སྟེ།",
    "ཡིད་བདེ་ཉམས་དགའ་བའི་ཚེས་གཅིག་ཡིད་ལ་ཡོང་བར་འདུག་གསུངས་པས།",
    "མཚེ་མ་ཤེས་རབ་རྒྱལ་མཚན་ཡར་བཅད་སྔགས་བརྒྱུད་དུ་འདུག།",
    "མི་ཚེས་ཀྱི་རྣམ་བཞག་ཟུར་ཙམ་ལགས་པར་གདའ།",
    "རླངས་ཁམས་པ་གོ་ཆ་དང་གླངསཔདྨེ་རོ་ཙ་ན་དང་གཉིས་ཀྱིས།",
    "གྲུབ་ཐོབ་དེ་འདས་ཟིན་སྤུར་དེ་བཞུ་དགོས་ཟེར་གྱི་འདུག་དེར་ཁོང་བཞེངས་པའི་ཐུགས་ལ་ནི།",
    "བོདཔེར་ནང་ཡང་མི་ཁྲག་བཅུས་ནས་དམར་པོར་འདུག་འདི་རྣམས་ཀྱི་འཁོར་ན་མ་འདུག་བྱས་པ་ལ།",
    "ཁྱེད་རང་ཟླ་ལ་འགྲོ་ཟེར་བ་ལ།",
    "སྔར་ཡང་ཕ་ཡུལ་ད་བར་འདུག་དེའང་ཕ་ཡུལ་བྱེད་པ་ཡིན།",
    "སྒྲུབ་རྟགས་ཅི་འདུག་ཐུགས་ལ་གསལ།",
    "སེམས་མལ་དུ་འདུག་པ་རྣལ་འབྱོར་ལུགས།",
    "ལུས་མལ་དུ་འདུག་པ་རྣལ་འབྱོར་ལུགས།",
    "ལུས་དྲང་པོར་འདུག་པ་རྣལ་འབྱོར་ལུགས།",
    "ང་རྣལཾ་འབྱོར་སྨྱོས་འདུག་མ་བསམ་པར།",
    "ལ་གྱིས་ཡུལ་ལ་ཁྱེད་རང་གང་གསུངས་དུ་འདུག་སྟེ།",
    "ད་དཀར་ལྡན་ཡང་མྱུར་དུ་འཆི་བར་འདུག་བུ་ཚ་བེ་རྣམས་ཀྱང་རྣལ་འབྱོར་གསུང་བཞིན་བསྒྲུབས།",
    "སྔར་ཡང་ཕ་ཡུལ་ཁོ་ན་འདུག།",
    "སྟག་ངོས་བྱ་བ་གྲོད་པར་འདུག་སབ་ཁང་བྱ་བ་རང་ཁྱིམ་ཡིན།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "ཁང་པ་རྣམས་ཇི་ལྟ་བ་བཞིན་དུ་འདུག་པའི་སྐས་ལ་འཛེགས་བྱོན་པས།",
    "དེ་ནས་མཚམས་དེའི་ཤར་འགུག་ཅིག་ན་བཞུགས་གདན་ཅིག་མཛད་འདུག་པ་ལ་བཞུགས་ནས་འཕྲོས་གཏམ་དང་ཞུས་གནང་མང་དུ་བྱུང་ངོ།",
    "ས་སྐྱ་པའི་བསྟན་པ་ལ་ཁྱད་ཆེ་བར་གདའ་སྟེ་ཞེས་ཞུས་པས།",
    "སྒོ་རུམ་གྱི་ཕྱག་དཔེའི་དཀར་ཆག་ཏུ་འདུག་པ་ཐུགས་དགེས་ཏེ།",
    "ཁོང་ཕྱག་དཔེ་རྣམས་ལྟ་རྟོག་ཚར་གཅིག་བྱེད་འདོད་པར་འདུག་པས།",
    "དེ་ཡང་རྗེ་བཙུན་གྱི་ཕྱག་ནས་བཞུགས་པ་ཡིན་ཟེར་བ་བདེན་པར་འདུག་ཅེས་སོགས་གསུངས་པ་དང་།",
    "དེའི་དྲུང་ན་རྗེ་ཉིད་ཀྱང་བཞུགས་འདུག་པ་ལ།",
    "ཁོང་ཤིན་ཏུ་དམ་པར་བྱེད་ཀྱིན་འདུག་གསུངས།",
    "ལོ་གསུམ་ལ་ཕེབས་འབུ་དང་མཇལ་བ་གདའ་བ་བྱོན་གསུངས་པས།",
    "ཡུན་རིངས་མ་འདུག་ངས་གནོད་པ་མི་བྱེད་ཟེར་བ་ཅིག་བྱུང་གསུངས་སོ།",
    "དེ་ཡིན་པ་ལ་ཐེ་ཚོམ་མེད་ཅེས་ནན་ཏན་བྱེད་ཅིང་འདུག་པ་རྨི།",
    "ཐོབ་པ་ཙམ་དུ་ཟད་འདུག།",
    "མཚམས་བྱེད་པ་ཟླ་ཕྱེད་ཀྱི་འཕྱིས་ན་སྐྱོན་དུ་འགྲོ་བར་གདའ།",
    "བྱ་སྤྱོད་གཉིས་པོ་འདི་དེང་སང་བཀའ་མ་ཆད་ཙམ་ལས་མི་འདུག་པས།",
    "འདི་གཉིས་སོས་པ་ཅིག་བྱུང་ན་བོད་དུ་བསྟན་པ་ཡོངས་སུ་རྫོགས་པ་ལེགས་པོ་ཅིག་འོང་བ་འདུག་སྙམ་སྟེ།",
    "ཁྱེད་རང་འདིར་ཡུན་རིང་པོ་མ་སྡོད།",
    "དེ་ག་ཡིན་ཚོད་དུ་འདུག་ཅེས་གསུངས།",
    "ཞལ་ད་ཇི་ལྟར་གནང་བ་ལྟར་འདུག་ཅིང་།",
    "དེ་མིན་འདི་ག་ཡིན་ཚོད་དུ་འདུག་གསུངས།",
    "བཟང་པོ་གསུམ་འདུག་ཟེར།",
    "ཁ་དོག་དམར་སིང་བྱས་པ་རྒྱ་ཆེན་པོ་ཅིག་འདུག་པ།",
    "ད་ས་སྐྱ་པ་ལ་འདི་འདྲ་འོང་ཟེར་བ་འདུག་པ་ཚར་གཅིག་བཀླགས་པ་རྨིས་པ་དེ་མནལ་སད་ཙ་ན་བརྗེད་གསུངས།",
    "ས་སྐྱའི་གུར་མགོན་ལྕམ་དྲལ་གྱི་འཆམ་སྐུ་དེ་གཉིས་བཞུགས་འདུག་པ་ཡིན་ཏེ།",
    "ཁང་པ་ཕ་ཏ་ན་འོང་བ་ལ་བལྟ་བ་ཡིན་པར་འདུག།",
    "བྱེ་བྲག་ཏུ་ས་སྐྱ་པའི་བསྟན་པ་ལ་ཕན་པ་དང་དར་རྒྱས་ཆེན་པོ་འོང་བའི་ལྟས་སུ་འདུག་གསུང་།",
    "ཐ་ན་གྲྭ་བ་ཕལ་པ་འགྲོ་འདུག་བྱེད་པའི་ལུང་བསྟན་ཞུས་པ་ཡང་ཇི་ལྟར་ལུང་བསྟན་པ་ལྟར་ཐོག་ཏུ་བབས་པ་ལ་སོགས་པ་མ་འོངས་ལུང་བསྟན་པ་ཡང་མཐའ་ཡས་སོ།",
    "གདུགས་དཀར་པོ་བཅུ་གསུམ་གཅིག་ཞོ་ལེ་བྱས་འདུག་གསུངས།",
