    "འོ་ན་ད་ལྟར་རང་མྱོང་ལ་སྐྱེ་མཆེད་དྲུག་ཁྱད་ཅན་མིན་པའི་ཁྱད་པར་བ་དེ་རང་ཉམས་ལ་སོ་སོར་མྱོང་བས་མ་གྲུབ་བོ་ཞེ་ན།",
    "བསྐྱེད་རིམ་གྱི་རྣལ་འབྱོར་ལ་གཞུག་ནས་དེ་ལྟར་སྒོམ་ཞིང་གསལ་སྣང་ཐེབས་པའི་རྣལ་འབྱོར་པ་ལ་སྐྱེ་མཆེད་དྲུག་ཁྱད་པར་བ་དང་།",
    "ཁྱད་ཅན་མིན་པ་དེའི་ཁྱད་པར་ལེགས་པར་རྣལ་འབྱོར་གྱི་སྟོབས་ཀྱིས་སོ་སོར་ཤེས་མྱོང་དུ་འགྱུར་རོ།",
    "ཡིན་ན་གང་ཟག་རང་བདེན་པ་ཐ་སྙད་དུའང་མེད་ན་དེ་ལ་ང་རྒྱལ་འཛིན་ན་བདག་ཏུ་ལྟ་བ་ཉིད་ལ་གསལ་བཏབ་པར་འགྱུར་བས།",
    "ཕྱི་མ་དེ་ལ་དེར་རྟོག་པའི་ཐ་མལ་དུ་བཟུང་ཞིང་འཛིན་པ་དེ་བསྐྱེད་རིམ་གྱི་རྣལ་འབྱོར་གྱིས་ཟིལ་གྱིས་མི་གནོན་པར།",
    "གཙོ་བོར་བྱས་ནས་ཐ་མལ་གྱི་གཟུང་འཛིན་སྟོང་པར་སྦྱངས་ཏེ།",
    "ལམ་དང་འབྲས་བུའི་སྐུ་དག་ཐོབ་པར་འགྱུར་བ་ནི་རྟེན་ཅིང་འབྲེལ་འབྱུང་མཆོག་ཏུ་ཟབ་པའོ།",
    "བརྟན་པ་ཐོབ་ནས་རྟོག་པའི་ཁ་བརྒྱུད་མི་དགོས་པར་རྟོག་མེད་ཡེ་ཤེས་ཀྱི་ངོར་རྒྱུ་རྒྱུད་ལྷན་ཅིག་སྐྱེས་པའི་ལྷ་ཉིད་བཏགས་པའི་མཚན་སྤྲོས་སུ་མ་དམིགས་ཀྱང་།",
    "འདིར་འཇིག་རྟེན་པའི་དངོས་གྲུབ་འོག་མིན་གྱི་མཐར་ཐུག་པ་ཞེས་པ་དེའང་ལས་ཆེན་སོགས་གྲུབ་པ་ཁོ་ན་མ་ཟད་ཚོགས་སྦྱོར་གྱི་ལམ་ཡོངས་སུ་རྫོགས་པར་ནུས་ཞེས་འཆད་ལ།",
    "ཕྱིས་ཀྱི་ཁ་ཅིག་དེ་ལྟ་ན་བསྐྱེད་རིམ་ཁོ་ནས་ཚོགས་སྦྱོར་གྱི་ལམ་ཡོངས་སུ་རྫོགས་ནུས་པར་འགྱུར་ལ།",
    "དེ་ལྟ་ན་རྫོགས་རིམ་གྱི་ཡན་ལག་དང་པོ་བཞི་ཚོགས་སྦྱོར་གྱི་ལམ་སྒྲུབ་བྱེད་ལ་མེད་ཀ་མེད་དུ་གསུངས་པའང་།",
    "དེ་ལྟ་མ་ཡིན་ན་རྫོགས་རིམ་པའི་རྣལ་འབྱོར་པ་ཡིན་ན་འཕགས་པ་ཡིན་པས་ཁྱབ་པར་སྨྲ་དགོས་པར་འགྱུར་བའི་ཕྱིར་ཞེས་ཟེར་རོ།",
    "དཔེར་བ་ལང་ལས་འོ་མ་འདོད་པས་འོ་མ་གང་ནས་འབྱུང་མི་ཤེས་པར་རྭ་རྩེ་ནས་འཐེན་པ་ལྟ་བུའོ་ཞེས་པ་ནི།",
    "ཞེས་པ་ནས་མཚན་བརྗོད་ཀྱི་ཚིགས་བཅད་གསུམ་གཅིག་པུ་སྲ་མཁྲེགས་སོགས་ཀྱི་བར་གསུངས་སོ།",
    "ལེའུ་ལྔ་པར།",
    "གལ་ཏེ་གཟུགས་ཀྱི་སྐུ་ཡིན་ན་དེའི་ཚེ་རྡུལ་ཕྲ་རབ་ཀྱི་གཟུགས་ཀྱིས་ཀྱང་འདུས་པར་མི་འགྱུར་རོ་ཞེས་སོགས་རྒྱ་ཆེར་འབྱུང་ངོ།",
    "འདིར་བསྐྱེད་རིམ་གྱི་ཕྲ་གསང་རྒྱ་བོད་ཀྱི་མཁས་རྨོངས་གྲུབ་པ་ཕལ་གྱི་བློའི་ར་བར་མ་ཆུབ་པར་སྣང་ལ།",
    "ཡེ་ཤེས་ཀྱི་མཁའ་འགྲོའི་བཀས་ལེགས་པར་གནང་བར་འགྱུར་ཞེས་ངེས་པ་དང་བཅས་སྟེ།",
    "ངེས་པར་རྣམ་སྨིན་གྱི་ལུས་རྙིང་པ་སྦྲུལ་ཤུན་ལྟར་འདོར་དགོས་ཞེས་འཆད་པ་འདི།",
    "ཅི་དེའི་ཚེ་རྣམ་སྨིན་གྱི་ཕུང་པོའི་བདུད་དང་སྒྲིབ་པ་དང་བྲལ་བ་ལ་དེའི་ཚེ་ཁོག་པ་བརྗེས་པར་བསྟན་པ་ཡིན་གྱི།",
    "དེ་ལྟར་བདེན་པར་འཛིན་པ་ས་བོན་གནས་ངན་ལེན་གྱི་སྒྲིབ་རྟོག་དང་བྲལ་བ་ན།",
    "འདོད་ནུས་མི་ནུས་ལེགས་པར་བསམ་མནོ་གཞིགས་ཤིག།",
    "ལུས་ཀྱི་ཆ་རྣམ་པ་ཐམས་ཅད་དུ་སངས་མ་རྒྱས་པར་སྒྲིབ་བཅས་སྡུག་བདེན་གྱི་རོ་གོག་ཉིད་དུ་ཤུལ་མར་གནས་པར་བྱས་པ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "ཁོ་བོ་ཅག་ལྟར་ན་འདུས་པའི་ལུགས་ལ་འཚང་རྒྱ་བ་ན་རྣམ་སྨིན་གྱི་ཕུང་པོ་རང་བདེན་པ་རྫས་གྲུབ་མཚན་བཅས་སུ་མི་ལུས་པར་མཚན་མའི་དམིགས་པ་ཐམས་ཅད་བྲལ་བ་ཉེ་བར་ཞི་བ་ཆེན་པོར་འགྲོ་བ་ཡིན་ཏེ།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་མྱུར་དུ་བཟློག་པ་དང་།",
    "ཏིང་ངེ་འཛིན་དང་ཤེས་རབ་ཀྱི་སྦྱོར་བ་ཁྱད་ཅན་དེ་ཐོབ་ནས་ནི་སྔོན་ལས་ཀྱི་འབྲས་བུ་ངན་པའང་མྱུར་དུ་ལྡོག་པར་བྱེད་དེ།",
    "རྣམ་པར་སྨིན་པ་འདིར་སྨིན་པ།",
    "ཚེ་ཞེས་བྱ་བ་ནི་དེ་བཞིན་གཤེགས་པས་སྐྱེ་བ་ལ་འདུ་ཤེས་སུ་བྱ་བ་ལ་གསུངས་ཏེ།",
    "དེ་ན་བདུད་བཞི་འཇོམས་པ་ལ་ཚེགས་མེད་པར་མྱུར་དུ་འཚང་རྒྱའོ།",
    "ས་དེ་ལས་གཏན་དུ་འདོད་ཆགས་དང་བྲལ་བའི་ཕྱིར་མ་ངེས་པ་དེ་རྣམ་པར་མི་སྨིན་པ་ཉིད་དོ།",
    "རྣམ་སྨིན་ངེས་པའི་ལས་ཀྱང་མི་མྱོང་བར་བསྒྱུར་ནུས་པར་གསུངས་ལ།",
    "སྔར་བྱས་ཀྱི་ལས་ཀྱི་རྣམ་སྨིན་ཚེ་འདིར་མི་ལྡོག་པར་སྨིན་པ་མི་སྲིད་དེ།",
    "མི་ལྟ་བུ་ལ་རྩོལ་བ་བྱས་པས་བཟའ་བཏུང་མྱོང་བ་དང་།",
    "མིས་རྩོལ་བ་བྱས་ན་བཟའ་བཏུང་ལོངས་སྤྱད་བྱར་འོང་བ་དང་།",
    "སྒྲུབ་པས་མཉེས་པར་བྱས་མ་བྱས་ལ་འཆད་ན་བདེན་ཡང་།",
    "དུས་ཀྱི་འཕེལ་འགྲིབ་ད་ལྟའང་བྱར་ཡོད་ཅེས་པ་དག་པར་བཏོན་ན།",
    "ཅེས་བཏོན་ནའང་ལེགས་པར་འགྱུར་ཏེ།",
    "འདི་ལྟར་གདམས་པར་མཛད་པ་ཡང་།",
    "སྐྱེ་བོ་མང་པོ་འོག་ནས་འོག་ཏུ་འདྲེན་པར་བྱེད་པ་ལ།",
    "དེའང་སྣོད་བཅུད་ཀྱི་ཞིང་ལྷག་པར་དག་པར་སྒྲུབ་པ་དགེ་རྩ་རྒྱ་མཚོའི་སྦྱོར་བ་ནི་ས་བརྒྱད་པར་ཁྱད་པར་དུ་སྒྲུབ་པ་ཡིན་ཏེ།",
    "ཅེས་བྱ་བ་གསུངས་ཏེ།",
