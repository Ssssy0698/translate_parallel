    "རྒྱ་གར་ནང་འདུག་འདོད་ཡོད་དམ།",
    "ཁྱེད་རང་གྲྭ་ས་ནས་ཚུར་ཡོང་བ་ཡིན་ནམ།",
    "དེར་ཁ་སྔོན་ངེད་གཉིས་རྡ་རམ་ས་ལར་འགྲོ་ཁར་སྣེ་ལེན་ཁང་ནས་ཐུག་པའི་ཕ་ཡུལ་གཅིག་པ་ཡང་རྒྱལ་མཚན་དང་མཉམ་དུ་བསྡད་ཡོད་འདུག་པས་ཡང་བསྐྱར་ཁོ་ལ་འཕྲད་པ་དང་།",
    "ཁོས་ངེད་གཉིས་ལ་ཉིན་བཞིའི་ཡར་སྔོན་གྱི་མེ་འཁོར་འཛིན་བྱང་ཚང་མ་བཙོང་ཚར་འདུག་པ་དང་།",
    "ཁོ་རང་ང་ལས་ལུས་ཤུགས་ཞན་པར་འདུག་སྟབས་ང་མར་གཡུག་མ་ཐུབ་པ་དང་།",
    "སྔོན་འདིར་དགེ་སློང་སྟོང་ཕྲག་མང་པོ་བཞུགས་མྱོང་ཡོད་འདུག་སྙམ་པ་འཆར།",
    "སང་ཉིན་མཚན་ལ་རླངས་འཁོར་འགྲམ་ལ་འགྲོ་མཁན་ཞིག་འདུག་པས།",
    "ཁྱེད་རང་ལ་ཚོང་ལས་ཀྱི་མ་རྩ་ཆུང་ཆུང་ཞིག་གང་ཐུབ་ཀྱིས་གཏོང་ངེས་ཡིན།",
    "ཁྱེད་རང་ནམ་ཞིག་ལ་ཕ་ཡུལ་ཕྱོགས་སུ་སླེབས་དུས།",
    "ཁྱེད་རང་ལ་ཕོ་གསར་གྱི་མཚན་ཉིད་དང་བློ་སྟོབས་ཀྱི་སེམས་རྒྱ་ལྡན་པས་ཕ་ཡུལ་ལ་བདེ་འབྱོར་ཡོང་བའི་ཡིད་ཆེས་ཡོད།",
    "འགྲམ་ལ་འགྲོ་མཁན་གྱི་རླངས་འཁོར་འདུག་དོ་དགོང་མཚན་གྱི་ཆུ་ཚོད་གསུམ་པའི་སྟེང་ཁྱེད་གཉིས་མཆོད་རྟེན་གྱི་སྒོ་འགྲམ་འདིར་ཤོག་དང་།",
