    "ཁྱེད་རང་ལྷ་ས་ལ་འབྱོར་རྗེས་དངུལ་གྱི་དཀའ་ངལ་འདྲ་མེད་ན་དེ་གར་བསྡད་ཡོད་པའི་ཚོང་པ་མགོན་པོ་དར་རྒྱས་ཀྱི་ལག་ཏུ་འཇོག་རོགས།",
    "ངེད་གཉིས་ཀྱི་ཅ་དངོས་ཆ་ཚང་བསྔོགས་འདུག་པ་དེ་མཐོང་སྐབས།",
    "གཞན་ཕན་ཐོགས་པའི་ཅ་དངོས་གཅིག་ཀྱང་འཁྱེར་མི་འདུག་པས་སེམས་ལྷོད་ལ་བབས་བྱུང་།",
    "དེ་མིན་ཁྱེད་རང་ལ་མཚོན་ཆའི་རིགས་ཡོད་ན།",
    "ཁང་པ་དེའི་ནང་ན་ཉལ་ཁྲི་དང་གདན་གཅིག་ཀྱང་མི་འདུག་ལ།",
    "ཤོག་སྒམ་དེ་དག་ནི་གཅིན་ཆུ་གཉིས་ཀྱིས་སྦང་འདུག་པས།",
    "ཁྱེད་རང་ཕྱིར་ཡོང་དུས་བལ་ཡུལ་ནས་མགྲོན་ཁང་གང་ནས་བསྡད་པ་ཡིནཞེས་དྲིས་བྱུང་།",
    "ང་རང་མགྲོན་ཁང་ནང་ནས་བསྡད་མེད།",
    "རོགས་པ་ཚོས་འབྲས་ཐང་ཞིག་འཐུང་བཞིན་འདུག་པ་དང་།",
    "ངའི་དུས་ཚོད་འདི་ཁྱེད་རང་ལ་སྟེར་འདོད་མེད།",
    "ང་རང་གཅིག་པུས་ཤིང་སྡོང་དེ་གཅོད་སྟབས་མི་བདེ་བ་དང་།",
    "ངའི་སེམས་ལ་བཙོན་གྲོལ་འཛིན་ཡིག་ནམ་ཞིག་ལ་སྤྲོད་འདུག་མི་ཤེས་སྟབས།",
    "ཁོ་རང་ལ་བྲོས་ནས་འགྲོ་འདོད་ཀྱི་འདུན་པ་མེད་ནའང་ངའི་ཨུ་ཚུགས་དང་བསམ་ཚུལ་ལ་འགྱུར་བ་གཏོང་མི་ཐུབ་པ་རྒྱུས་ཡོད་ཡིན་སྟབས།",
    "ངས་ཁྱེད་གཉིས་ལ་ཟམ་ཆུང་དེ་བསྟན་ཆོག་ཁྱེད་རང་གཉིས་ཀྱིས་མི་གང་ཡིན་ལ་སྐད་ཆ་མ་དྲིས་ན་བཟང་།",
    "ལྷག་པར་དུ་ཉིན་འགའི་སྔོན་ནས་འདི་གར་དམག་མི་མང་པོ་ཞིག་འབྱོར་འདུག་པ་དང་།",
    "ཉེས་ཅན་ལ་གནས་ཚང་བཏང་འདུག་ཟེར་ནས་ཁྱིམ་བདག་ལ་གང་འདོད་ཀྱིས་གཅར་རྡུང་བྱེད་པ་དང་།",
    "རླངས་འཁོར་ལམ་ལའང་ཧ་ཅང་ཐག་ཉེ་བར་འདུག་༡༡ བྲོས་ཐར་གྱི་ལམ་བར་ནས་སླར་ཡང་རྒྱ་ལག་ཏུ་ཚུད་པ།",
    "ད་ཆར་བ་འབབ་མཚམས་ཆད་འདུག་པས།",
    "རྒན་པོས་ངེད་གཉིས་འདུག་འདོད་མེད་པ་ཤེས་པ་དང་།",
    "ཁོ་ཚོ་ཞིང་བར་དུ་ཡོང་རྗེས་ཆུ་རྐའི་གཡས་གཡོན་དང་ཞིང་ཚིགས་ཁ་ཤས་ལ་བཙལ་བཞིན་འདུག་པ་ལས།",
    "ང་རང་བློ་བཟང་དང་ཐག་ཅུང་རིང་བའི་ཕར་ངོས་ཤིག་ཏུ་འཁྲིད་དེ་ཁང་པ་དཀར་པོ་ཐོག་རྩེག་གཉིས་ཅན་ཞིག་ཡོད་པ་དེའི་མདུན་ན་ཨར་འདམ་གྱི་གློག་སྡོང་ཞིག་ཡོད་པ་དེ་ལ་བཏགས་པ་དང་།",
    "དེ་གར་ཉེན་རྟོག་པ་གཉིས་དང་བོད་པ་དམག་མི་གཅིག་བཅས་ཁ་མར་འཁོར་ནས་བསྡད་འདུག་པ་དང་།",
    "༤ ཞིག་འདུག་པ་ཁོས་ང་ལ་ཡང་ཡང་བལྟ་བཞིན་འདུག་པ་དང་།",
    "ང་རང་ལྷ་ས་ནས་ཡིན།",
    "བལ་ཡུལ་ནས་མི་སུའི་ལག་ཏུ་བསྐུར་ཡོད་པ་ཡང་ཤེས་ཀྱི་མེད་སྟབས་ང་རང་བློ་བདེ་པོ་ཞིག་བྱུང་།",
    "བོ་ཡིན་པ་ཁོའི་འདུག་སྟངས་ལས་ཤེས་ཐུབ་པ་དང་།",
    "གཞན་ཁྱེད་རང་གཉིས་ཀྱིས་ཉིན་གུང་ཟ་མ་ཟོས་ཡོད་དམ།",
    "ཐུག་པ་ཞིམ་པོ་ག་འདྲ་འདུག་ཟེར།",
    "ཉིན་གཉིས་པའི་ཉིན་གུང་ཙམ་ལ་ཁོས་རྩམ་པ་ཟ་ཞོར་ང་ལ་བལྟ་བཞིན་འདུག་པའི་སྐབས་དེར།",
    "ཁྱེད་རང་གཉིས་འགྲམ་ནས་བཀག་ཡོད་སྐབས་ཉེས་མེད་ཀྱི་འཛིན་ཡིག་དང་།",
    "ངའི་བཙོན་རོགས་རྟ་རྐུན་ཁོ་སྔར་ལས་ཇེ་ལྷོད་དང་ཇེ་བཟང་དུ་ཕྱིན་འདུག་སྟབས།",
    "བློ་བཟང་ཡང་དེ་གར་ཡོང་ནས་ང་ལ་སྒུག་བསྡད་འདུག་འོབ་ཆེན་འབྲུག་རིས་དང་ཕག་ཤ་བརྔོས་མ།",
    "དེ་སྔོན་འདྲི་གཅོད་བྱེད་མཁན་གྱི་འགོ་གཙོ་བོད་པ་དེ་འདུག་པ་དང་།",
    "ངའི་སེམས་ལ་དེ་རིང་དམག་མི་ཁོ་༡༦༥ ལ་ཨ་ཞང་ཧེབ་རྐྱལ་ལ་མག་པ་རྫུན་རྐྱལ་ཞིག་འཕྲད་པ་ལྟར་བྱེད་དགོས་སྙམ་སྟེ།",
    "ཁོ་རང་བློ་བདེ་པོ་དང་ཡིད་ཆེས་སླེབས་པའི་ཆེད་ངའི་ལག་མགོའི་དུས་ཚོད་ཡག་པོ་དེ་ཁོ་ལ་སྤྲད་དེ།",
    "ཁྱེད་རང་གཉིས་ལ་ཕ་ཡུལ་ལ་འགྲོ་བྱེད་ཀྱི་དངུལ་མེད་ན།",
    "ད་ཐེངས་ཁྱེད་རང་ངའི་མཉམ་དུ་མ་ཡོང་ན།",
    "ཁོམ་ལོང་ནམ་ཡོད་ཀྱི་དུས་ཚོད་མང་ཆེ་བར་ང་རང་མགྲོན་ཁང་ནང་ནས་བསྡད་དེ་ངལ་གསོ་ཡོང་ཐབས་བྱས།",
    "ངེད་གཉིས་དོ་དགོང་ཕ་ཡུལ་ལ་འགྲོ་ན་ག་འདྲ་འདུག་ཅེས་དྲིས་པར།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་ཁོང་ནང་ན་བཞུགས་འདུག་པ་དང་།",
    "བྱ་འདབ་ཀྱི་གློག་སྒྲོན་དེ་ཡང་སྦར་མི་འདུག་སྟབས།",
    "ང་རང་ཡིན་པ་ཤེས་ཏེ།",
    "གྲྭ་བ་གཞན་པ་ཁ་ཤས་རྒྱ་གར་ནས་འདུག་ངེས་ཡིན་པ་ལས།",
    "ཁོའི་ཁ་ནས་ཁྱེད་རང་གཉིས་ལྷ་ས་ལ་བདེ་ལེགས་ངང་འབྱོར་ཡོད་པའི་གནས་ཚུལ་གསལ་བོ་ཐོས་པ་ནས་བཟུང་།",
    "ང་རང་རྒྱ་གར་དུ་ཕྱིན་པ་གང་འདོད་ཀྱིས་སྤྲོ་འཁྱམ་དུ་ཕྱིན་པ་མིན་པར།",
    "ཁྱེད་རང་རྒྱལ་བ་ཐམས་༡༧༧ ཅད་མཁྱེན་པར་མཇལ་བ་དང་།",
    "དེ་མིན་ཁྱེད་རང་སླེབས་མ་ཐག་ཡིན་པས།",
    "སྐབས་དེར་ཁོའི་མིག་མཐར་མཆི་མ་ཞིག་འཁོར་འདུག་པ་དེ་མཐོང་བ་ན།",
    "སྤུན་སྲིང་ཤ་ཉེ་ཁ་ཤས་མ་གཏོགས་གཞན་ཚང་མ་རང་རང་སར་འགྲོ་ཚར་བ་དང་།",
    "ཁྱེད་རང་རྒྱ་གར་ལ་བྲོས་ནས་འགྲོ་འདོད་ཀྱི་དམིགས་ཡུལ་དང་།",
    "ང་རང་རྒྱ་གར་ལ་འགྲོ་དོན་རྒྱལ་བ་ཐམས་ཅད་མཁྱེན་པ་དང་།",
    "གཞན་ཁྱེད་རང་བོད་པ་ཞིག་ཡིན་པའི་ཆ་ནས།",
    "ང་རང་ཆེས་ནག་༡༨༣ ཉེས་ཅན་གྱི་ཁོངས་སུ་བརྩིས་ཏེ།",
    "ང་རང་ཡང་རྒྱ་གར་ལ་འགྲོ་འདོད་དུས་རྒྱུན་སེམས་ན་ཡོད།",
    "ང་རང་སྙན་རྩོམ་ལ་དགའ་བོ་ཡོད་པས།",
    "ཁྱེད་རང་རྒྱ་གར་ལ་ཕྱིན་སྐབས་ཀྱི་གནས་ཚུལ་གང་བྱུང་བ་དང་།",
    "ང་རང་ཡང་སྐབས་དེར་ཕ་ཡུལ་ནས་ཉིན་གསུམ་ལ་བསྡད་པའི་རིང་དེར་མགྲོན་འབོད་ཀྱི་བང་བསྒྲིགས་ཏེ་བྲེལ་བ་འདྲ་ཞིག་བྱུང་།",
    "ང་རང་ནི་ལྷན་སྐྱེས་དང་སྦྱངས་སྟོབས་ཀྱི་བློ་རིག་དམན་ཞིང་།",
    "ཁྱེད་རང་གང་ནས་ཡིན།",
    "ཁྱེད་རང་ལ་ཁོམ་པ་ཡོད་ན།",
    "དེ་འདྲ་ཡིན་ན་ཡག་པོ་འདུག་ང་ལ་ཁྱེད་གཉིས་ལ་ཁ་བརྡ་འགའ་བྱེད་རྒྱུ་ཡོད།",
    "ང་རང་རྒྱ་གར་ལ་ཕྱིན་ཚུལ་དང་།",
    "ཁོ་གཉིས་ཀྱིས་ཀྱང་རང་མི་རིགས་ཀྱི་ཤ་ཞེན་དང་ལ་རྒྱ།",
    "ངའི་ངོ་ཤེས་ཁོང་ལ་ཐུག་མ་ཐུབ་ཀྱང་ཁྱེད་གཉིས་ལ་ཐུག་པས་ཁྱད་པར་མི་འདུག་ཅེས་ཡིད་ཆེས་བློས་འགེལ་བྱས་ཏེ།",
    "ཁྱེད་རང་ཕ་ཡུལ་གང་ནས་ཡིན་པ་དང་།",
    "ཁྱེད་རང་འདིར་ཡོང་བ་ལེགས་པོ་བྱུང་།",
    "དེའི་སྟབས་ཀྱིས་ཉིན་ཁ་ཤས་རྗེས་སུ་ང་རང་ཡི་དམ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་བསྙེན་སྒྲུབ་ལ་འདུག་རྒྱུ་བྱས་ཡོད་པས།",
    "ཁྱེད་རང་ལ་བསྙེན་མཚམས་འདུག་རོགས་གྲོགས་པོ་འདྲ་ཡོད་ན་དེ་ལྟར་དང་།",
    "རྩ་བའི་རྨང་གཞི་སེམས་ཁོང་ན་ཡོད་ཕྱིར་གངས་ཅན་མཐོ་སྒང་དུ་བསྒྲེང་རྒྱུ་དུས་ལ་སླེབས་འདུག་པ་དང་།",
    "འདོད་བློ་ཚིམས་པ་ཞིག་བྱུང་འདུག་དགའ་སྣང་ཆེན་པོ་དང་བཅས་ཉལ།",
    "སང་ཉིན་དོན་རྐྱེན་གང་ལ་འཕྲད་ཀྱང་འགྱོད་པ་མི་འདུག་སྙམ་པ་ཞིག་བྱུང་།",
    "དར་ཆ་བསྒྲེངས་མཁན་དེ་མི་དཔའ་བོ་དང་ལ་རྒྱ་ཅན་ཞིག་ཡིན་ངེས་ཞེས་གླེང་བཞིན་འདུག་ལ།",
    "ང་རང་བློ་ཕམ་པ་ཞིག་ལ།",
    "མི་མང་གྲལ་ནས་ང་རང་མྱུར་དུ་ཡར་ལངས་ཏེ།",
    "རང་བཙན་ཡིན་ཟེར་མཁན་དེ་ང་རང་ཡིན།",
    "སྦྲ་གུར་ནང་ན་ཉལ་འདུག་པ་དང་རྨི་ལམ་ཡིན་པ་ཤེས་ཏེ།",
    "ཁྱེད་རང་གང་ནས་ཡིན་པ་ངའི་མདུན་ཅོག་སྟེང་ལ་ཡི་གེ་འབྲི་དགོས།",
    "སླེབས་འདུག་པ་དང་ཁོས།",
    "ང་རང་གྲོགས་པོ་ཡར་འཕེལ་གྱི་ཤག་ཏུ་འབྱོར་བ་དང་ངེད་གཉིས་ཀྱིས་རང་བཞིན་གྱི་ཁ་བརྡ་སྣ་ཚོགས་ཤིག་བྱས་ནས་བསྡད།",
    "དེ་གར་ཁོ་རང་འཚུབ་ཆ་ཞིག་ལངས་པ་དང་མཉམ་བཅོས་འཛུམ་ཞིག་སྟོན་བཞིན་ངའི་ལག་པ་ན་བསང་ཁུག་ཡོད་པ་དེར་བལྟས་ཏེ།",
    "ང་རང་བསང་ཕུད་དུ་ཕྱིན་པ་ཡིན།",
    "ཁྱེད་རང་འདིར་སུ་བཙལ་དུ་ཡོང་བ་ཡིན་ནམ།",
    "ངའི་འདུག་གནས་དང་རྒྱུད་པའི་འདུ་ཁང་གཉིས་ཀྱི་བར་ཐག་ཧ་ཅང་ཉེ་བ་དང་།",
    "ང་ནང་ལ་སླེབས་ནས་ཡར་བལྟ་དུས་རྒྱུད་པའི་དཀོར་གཉེར་ཁང་ཐོག་ན་ལངས་འདུག་པ་དང་།",
    "ཁོམ་ལོང་མི་འདུག་པས་རྗེས་སུ་འགྲོ་ཐག་འདྲ་ཞིག་བཅད་དེ་བསྡད།",
    "རང་སེམས་ལ་དེ་རིང་སྔ་པོ་ནས་ཚོགས་ལ་འགྲོ་དགོས་པས་གྲོགས་པོ་ཞིག་འདིར་འབོད་དུ་ཡོང་འདུག་སྙམ་བཞིན་ཉལ་ས་ནས་ཡར་ཙོག་པར།",
    "ཁྱེད་རང་བསྟན་འཛིན་ཉི་མ་ཡིན་ནམ།",
    "ངས་ཤ་བོ་ཚེ་རིང་ལ་ཁྱེད་རང་བོད་པ་ཞིག་ཡིན་ན་སྐུ་པར་སྟེང་འདི་འདྲའི་ཞེ་སྡང་ཞིག་ལངས་ཏེ་མར་གདན་ཐོག་ལ་གཡུགས་དགོས་དོན་མེད།",
    "སྐུ་པར་དེ་ཉར་མཁན་དང་དེ་ལ་བདག་པོ་རྒྱག་མཁན་ང་རང་ཡིན་པས།",
    "ཕར་ཆེར་རྒྱལ་དར་བསྒྲེངས་མཁན་ང་རང་ཡིན་པ་གསལ་རྟོགས་བྱུང་འདུག་སྙམ་བཞིན།",
    "སྟབས་ལེགས་ནས་ཇ་དེམ་ནང་ན་ཇ་འདུག་ངས་དཀར་ཡོལ་ཞིག་བླངས་ཏེ་ཇ་དང་མཉམ་དུ་བག་ལེབ་སྐམ་པོ་གང་སྦང་ནས་ཟ་བར་བརྩམས་པ་ན།",
    "ཟ་མི་ཐུབ་པའི་དཀའ་ངལ་ཞེ་དྲག་མི་འདུག་པས།",
    "ང་རང་ཆུང་དུས་ནས་ཟས་མང་ཆེ་བ་རྩམ་པ་ལ་བརྟེན་ནས་འཚར་ལོངས་བྱུང་སྟབས།",
    "ཁོ་རང་ང་ལ་རྐུབ་སྟེགས་ཁམ་ནག་ཅིག་ཡོད་པའི་སྟེང་ཙོག་པུར་བསྡད་དེ་སྔོག་བཤེར་བྱེད་སྟངས་ལ་བལྟས་ཏེ་བསྡད་འདུག་པའི་བཟོ་ལྟ་དེ་མཐོང་བྱུང་།",
    "ཕྱི་སྒོའི་འགྲམ་ན་ཡང་ཉེན་རྟོག་པ་གཉིས་ཀྱིས་སྲུང་འདུག་པས།",
    "འབྲོ་སའི་ཐར་ལམ་ནི་ཧ་ལམ་མེད་པ་ལྟ་བུར་འདུག་ཡིན་ནའང་།",
    "འདི་དངོས་ནས་ལྟོགས་འདུག་བསམ་པ་ཡིན་པ་འདྲ།",
    "སྟབས་ལེགས་པ་ཞིག་ལ་སྔོན་གྱི་ལྟ་སྲུང་བ་དེ་གཉིས་སྒོ་ཁ་ན་བསྡད་མི་འདུག་དེ་མཚམས་ཕྱིར་ཇ་ཁང་ནང་ལ་འཛུལ་སྟེ།",
    "ཁོ་རང་གཉིས་ཀྱི་ལག་ནས་ཐར་ཐབས་ལ་བསམ་བློ་བཏང་།",
    "གོ་སྐབས་འདུག་བསམ་མུར་སེམས་གཏིང་ནས་བྲེལ་ཤ་ཞིག་ཀྱང་ལངས་ཏེ་འབྲོ་རྩིས་བྱེད་སྐབས།",
    "ང་བྲོས་པ་ཡིན་ན་ང་རང་ཡིན་པ་གསལ་པོ་ར་སྤྲོད་བྱས་པ་ལྟ་བུ་ཆགས་རྒྱུ་དང་།",
    "རྣམ་འགྱུར་བཅས་ནི་ད་དུང་ཡང་ངའི་མིག་ལམ་དུ་འཁོར་འོང་ཞིང་སེམས་ནང་ཡང་ཡང་དྲན་འོང་བ་ཞིག་འདུག་ངས་ཇ་འཐུང་ཚར་བ་དང་ཕྱིར་ལག་ལྕགས་བརྒྱབ་སྟེ།",
    "ཁྱེད་རང་ཉལ་ཐུབ་ན་ཕྱིར་ཉལ་རོགས།",
    "སྔར་བཞིན་བལྟས་འདུག་པ་ལ་བལྟས་ན་ཁོ་ངུ་བཞིན་ཡོད་པ་འདྲ།",
    "འདི་ལྟར་བཙན་འོག་ནས་སྤུན་ཆུང་དང་རང་ཤག་ནས་བྲལ་དགོས་བྱུང་།",
    "ང་རང་བཙོན་པ་ཞིག་ཡིན།",
    "བཙོན་པ་འཇུག་ས་ཁང་ཤུར་གསུམ་འདུག་པ་དང་།",
    "ཁང་མིག་དེའི་ནང་ཕོ་གསར་བཙོན་པ་གསུམ་འདུག་པ་དང་།",
    "ངེད་གཉིས་ཀྱིས་ཕན་ཚུན་ལ་གོ་བརྡ་གང་འཚམ་འཕྲོད་ཐུབ་ཀྱི་འདུག་ཁོས་ང་ལ།",
    "ང་རང་རྐུན་མ་ཡིན་མིན་ལ་དོགས་པ་སྐྱེས་ཡོད་པ་འདྲ།",
    "ཟེར་ནས་ཞེད་སྣང་འདྲ་ཞིག་བྱས་ནས་ཤོད་ཀྱི་འདུག་ངས་ཁོ་གཉིས་ལ་གཅར་རྡུང་བྱས་ཡོད་མེད་དྲིས་པའི་ལན་ལ།",
    "མི་སྤྱོད་ལས་འདས་པའི་གཅར་རྡུང་བྱས་པ་ཡིན་ན་རང་ཉེས་ཁ་ནས་ཤོར་བ་ལ་ཁག་མི་འདུག་སྙམ་པ་དང་།",
    "སྐབས་དེར་ངས་སྒོ་སྲུབ་ནས་ཕྱི་ལོགས་ཀྱི་རྭ་སྐོར་ནང་བལྟས་པར་ཕལ་ཆེར་བཙོན་པ་བཅུ་གྲངས་ཤིག་འདུག་པ་དང་།",
    "གཞན་སྒེར་གྱི་སྟེང་ནས་གནོད་སེམས་ཀྱི་བསམ་བློ་མེད་པ་ཞིག་ཡིན་པ་ཤེས་ཀྱི་འདུག་དེ་ནི།",
    "ཁང་མིག་དེའི་ནང་གད་སྙིགས་ཀྱིས་ཁེངས་འདུག་པ་དང་།",
    "གཅིན་དྲི་སོགས་འཐུལ་འདུག་པ་དང་ཉལ་ཆས་སོགས་གང་ཡང་མི་འདུག་པས།",
    "ང་རང་ཉལ་གྱི་ཡིན།",
    "ཁྱེད་རང་ཕར་ཕྱོགས་ཀྱི་རྐུབ་སྟེགས་སྟེང་ནས་སྡོད།",
    "༤ ༤ གྲ་ངད་མི་གོན་དེ་ང་རང་སྒེར་གྱི་འདོད་ཚུལ་ཞིག་ཡིན་པས།",
    "ཁྱེད་རང་ལ་ནག་ཉེས་མེད་ན།",
    "ཁྱེད་རང་ཇི་ལྟར་མ་དགའ་ནའང་།",
    "ང་རང་ཁ་སྔོན་ནས་གཉིད་ལོག་ཐུབ་མེད་པས་མདང་དགོང་སྔ་བོ་ནས་གཉིད་ལོག་པ་ཡིན།",
    "རྒྱུན་ལྡན་ལས་ཞིམ་པའི་ཚོར་སྣང་བྱུང་བ་དང་དེ་འཐུང་ཚར་བ་དང་རང་སར་ཉལ་ཀྱང་རང་སེམས་འཁོར་ཕྱོགས་ཤིག་ལ།",
    "ད་ཐེངས་ཀྱང་ཁྱེད་ཀྱི་མིང་ངའི་མདུན་ཅོག་སྟེང་ལ་སླེབས་འདུག་སྟབས།",
    "ངས་ཁྱེད་རང་ད་ལྟ་འདི་ནས་བཏང་ཆོག་ལ།",
    "ཁྱེད་རང་ཉེན་རྟོག་པའི་ཁྲོད་ནས་ངའི་སྟེང་ལ་དམིགས་བསལ་གྱིས་འགན་ཞིག་འཁུར་ཡོད་པའི་རྐྱེན་གྱིས།",
    "རྭ་སྐོར་ནང་རྩྭ་ལྡུམ་སྔོ་ལྗང་ངེར་སྐྱེས་འདུག་པ་དང་ནམ་མཁའ་ཡང་ཧ་ཅང་དྭངས་པའི་ཁྲོད།",
    "ངས་ཁོ་ལ་ཁྱེད་རང་གང་ནས་ཡིན་ནམ་ཞེས་དྲིས་པའི་ལན་དུ་ཁོས་ང་རང་སོག་པོ་གསེར་ལུང་ནས་ཡིན་ལ།",
    "ཚིག་དེ་གོ་མ་ཐག་རིག་གྲོལ་དང་བློ་གྲོས་གཉིས་ཀྱང་འདིར་ཁྲིད་ཡོང་འདུག་པ་ཤེས་འཕྲལ་བློ་མ་བདེ་བའི་ངང་ཁོ་ལ།",
    "ང་རང་ཕྱིར་འདྲི་གཅོད་ཁང་ལ་འཁྲིད་པ་༢༥༤ ད་།་",
    "དེ་གར་ཤ་བོ་ཚེ་རིང་དང་མཉམ་དུ་ཉེན་རྟོག་པ་ཞིག་སླེབས་འདུག་ལ།",
    "གཞན་ཁྱེད་ཀྱི་ཕ་མ་གཉིས་ཀ་ལོ་ན་མཐོ་བ་མ་ཟད་སྤུན་སྲིང་དགུ་པོས་ཁྱེད་རང་བཟུང་ཡོད་པ་ཤེས་པ་ལས་གར་ཁྲིད་གང་ཡོད་ཀྱི་གནས་ཚུལ་གཅིག་ཀྱང་ཤེས་རྟོགས་བྱུང་མེད།",
    "ང་རང་གཉིད་ཁུག་ཡོད་མེད་ཀྱི་མཚམས་ཏེ་མཚན་གྱི་དུས་ཚོད་དང་པོ་ཙམ་ལ་ཤ་བོ་ཚེ་རིང་དང་རྒྱ་མི་ཉེན་རྟོག་པ་གཉིས་ཡོང་ནས་ང་ལ་ལག་ལྕགས་བརྒྱབ་སྟེ།",
    "ཁྱེད་རང་མི་གང་འདྲ་ཞིག་ཡིན་པ་སྔོན་མ་ནས་གསལ་པོ་ཤེས་ཡོད་ལ།",
    "ང་རང་སྤང་ཐང་འདི་ནས་ཅུང་ཙམ་རིང་ལ་སྡོད་བཅུག་དང་།",
    "ཤི་མ་གསོན་གྱི་གཅར་རྡུང་བྱེད་མི་བྱེད་ལ་ཁྱེད་རང་ཐེ་ཚོམ་སྐྱེས་མི་དགོས་པས་གང་ཐུབ་ཀྱིས་རྣམ་འགྱུར་ལེགས་པ་དང་གཟབ་གཟབ་བྱེད་དགོས་ལ།",
    "དོན་དེ་ངོས་ལེན་བྱས་ཀྱང་མ་བྱས་ཀྱང་ཁྱེད་རང་ཚབས་ཆེ་བའི་ཉེས་ཅན་ཞིག་ལ་བརྩི་བཞིན་ཡོད།",
    "ང་རང་ཧ་ལས་པ་དང་ཤུགས་ཀྱིས་ཡར་ལངས་སྐབས་གཉིད་སད་བྱུང་།",
    "ཁོ་རང་གཉིས་ཀྱིས།",
    "དོན་གྱིས་ང་རང་ངོས་ནས་མི་གསོད་པ་ཕར་ཞོག་མཐའ་ན་སྒོར་རྡོག་གཅིག་ཀྱང་བརྐུས་མ་མྱོང་བས།",
    "ལས་དོན་འདི་མགོ་ནས་མཇུག་བར་དུ་ངས་ཁོ་གཉིས་ལ་གསང་བ་བྱས་ཏེ་ང་རང་གཅིག་པུས་ལས་པ་རྐྱང་ཡིན་པས།",
    "ངས་བལྟས་ན་ཁྱེད་རང་ནི་ཕ་མ་དང་ནང་མི་ཡོངས་ལ་བསམ་བློ་གཏོང་མི་ཤེས་པའི་ཕ་རྩམ་གཟན་ཞིག་ལ་བུ་སྐྱག་གཟན་ཞིག་སྐྱེས་ཡོད་པ་དང་།",
    "ང་རང་རི་ངོས་ཤིག་ན་འགྲོ་བཞིན་པ་དང་།",
    "པགཡོན་ན་ཉེན་རྟོག་པ་ཁ་ཤས་ལངས་ནས་འདུག་པ་དང་།",
    "ངས་ཕོ་གསར་དེ་ལ་ང་རང་བྱིས་པའི་སྐབས་སུ་འབྲོག་དའ་པའི་རྩྭ་ཐང་ནས་འཚར་ལོངས་བྱུང་བའི་འབྲོག་ཕྲུག་ཅིག་ཡིན་ལ།",
    "ང་རང་མར་ས་ལ་ཙོག་པུར་བསྡད་དེ་གཅིན་པ་གཏོང་བའི་སྟངས་ཀ་བྱས་པར།",
    "ཁོས་ངས་དངོས་གནས་གཅིན་པ་གཏོང་དགོས་པ་ཡིན་པར་འདུག་སྙམ་སྟེ།",
    "སྐབས་དེར་ཉེན་རྟོག་པ་གཞན་རྣམས་ཀྱིས་ཀྱང་ངའི་གཡས་གཡོན་ནས་གཅིན་པ་གཏོང་བཞིན་འདུག་པ་དང་།",
    "ང་རང་འབྲོ་སའི་ས་ངོས་དེ་ནི་རྡོ་ཧྲུག་དང་རྩྭ་ལྡུམ་གྱིས་ཁེངས་པའི་གཡང་གཟར་ཞིག་ཡིན་པའི་སྟེང་ལ་ཤུགས་ཀྱིས་མཆོང་ལྡིང་བྱས་པར་འདྲིལ་ནས་ཐང་ལ་འགྱེལ་ཞིང་།",
    "རྐང་པ་གཡས་པའི་སྟེང་ལ་ལངས་མི་ཐུབ་པ་ཆགས་འདུག་པས།",
    "ཁྱེད་རང་འདིར་ཤོགས་ཟེར་བའི་ལན་ལ།",
    "ཁྱེད་རང་ཡར་ཤོགས་དང་།",
    "ཡར་ཡོང་རྩིས་བྱེད་ཀྱི་མི་འདུག་སྐབས་དེར།",
    "དྲན་པ་ཕྱིར་སོས་དུས་འགྲམ་པ་ཆུ་འགྲམ་ལ་གླན་ནས་འདུག་བྲོས་ཐར་རྗེས་ཀྱི་ཟུག་གཟེར་དང་སྐྱོ་ངལ།",
    "ཕར་ངོས་ཀྱི་མཚེར་ཁུག་ཅིག་ན་དུ་བ་སྔོ་ལྷོག་ལྷོག་འཕྱུར་བཞིན་པའི་འབྲོག་ཁྱིམ་ཞིག་འདུག་པ་དང་མཐའ་སྐོར་རྟ་ནོར་ལུག་གསུམ་གྱིས་ཁྱབ་འདུག་པ་ལ་བལྟས་ན།",
    "མགོ་ཡར་བཀྱགས་དུས་ཕལ་ཆེར་ས་རུབ་འདུག་པས།",
    "ཁྱེད་རང་ཚུར་ཤོགས་ཞེས་བོས་དུས།",
    "ཁྱེད་རང་གར་འགྲོ་ལ་ངེས་པ་གཏན་ནས་མེད་པ་ཞིག་འདིར་ཡོང་དགོས་དོན་མེད་ལ།",
    "རྒད་པོ་ཁྱེད་བཟའ་མི་གསུམ་པོའི་བློ་སེམས་སྔར་བཞིན་བདེ་བའི་ངང་སྡོད་དང་ཆོག་གལ་ཏེ་སྟབས་མ་ལེགས་པར་ང་རང་ཕྱིར་རྒྱ་ལག་ཏུ་ཚུད་ཀྱང་།",
    "ཁོས་ང་ལ་ཉལ་ས་ཞིག་གྲ་སྒྲིག་བྱས་ཏེ་རང་རང་ས་ནས་ཉལ་འགོ་བརྩམ།",
    "མདང་དགོང་ཁྱེད་རང་གཉིད་ལོག་ཐུབ་མ་བྱུང་།",
    "ཏག་ཏག་ཡལ་ག་མང་བའི་གསོམ་སྡོང་ཆེན་པོ་ཞིག་རྙེད་བྱུང་བ་དེའི་སྡོང་རྩར་སྡོང་པོའི་སྟེང་ནས་ཟགས་པའི་ལོ་མ་སྐམ་པོ་གདན་ལ་བཏིང་བ་ལྟ་བུ་ཞིག་འདུག་པ་དེ་སྟེང་ལ་ཉལ་སྟབས་ཀྱིས་བསྡད་པར།",
    "དེ་མིན་རི་དྭགས་ཚོས་ཀྱང་དེ་བཞིན་དུ་སྐད་སྦོམ་ཕྲ་སྣ་ཚོགས་ཤིག་འདོན་གྱི་འདུག་སྟབས།",
    "ཁོས་ཁྱེད་རང་གང་ནས་ཡིན།",
    "ང་རང་ཧ་ཅང་ལྟོགས་སྐོམ་གྱིས་མནར་ནས་ཡོད་པས།",
    "ཁོ་རང་དངངས་འཚབ་ཅིག་སྐྱེ་བཞིན།",
    "ཁྱེད་རང་འདིར་མ་སླེབས་སྔོན་ལ།",
    "དེའི་སྟབས་ཀྱིས་ཁྱེད་རང་ལ་ཉེན་ཁ་ཆེ་བ་དང་།",
    "ང་རང་འདི་ཞིག་ལ་འགྲོ་ངེས་ཟེར་བའི་ས་ཕྱོགས་ངེས་གཏན་ཅི་ཡང་མེད་པས།",
    "གཞན་པས་ཤེས་ཚེ་རྗེས་སུ་ཁྱེད་རང་ལ་དཀའ་ངལ་འཕྲད་རྒྱུ་ཡིན་པ་ཐེ་ཚོམ་མེད།",
    "གཡས་གཡོན་ན་མེ་ཏོག་འདྲ་མིན་སྣ་ཚོགས་ཁྲ་ཆིལ་ལེར་བཞད་འདུག་པའི་སྐྱིད་ས་ཞིག་ཏུ་འབྱོར་བ་དེ་གར།",
    "མཚན་ལ་སྡོད་གནས་ངེས་གཏན་མེད་པའི་རི་དྭགས་རྨས་མ་ཞིག་དང་མཚུངས་པར་འདུག་སྙམ་པ་ཞིག་སྐྱེས་ཏེ།",
    "ཁྱེད་རང་གང་ནས་ཡིན་པ་དང་ཁྱིམ་ན་ཆུང་མ་ཡོད་མེད་དང་།",
    "རི་མགོར་སླེབས་པ་དང་ཉི་མ་ཡང་ནུབ་ལ་ཉེ་བར་འདུག་བར་ཐག་ཧ་ཅང་མི་རིང་བའི་ལུང་གཞུང་ལ་བལྟས་པར།",
    "སྐབས་དེར་ངོ་ཤེས་ཁྱིམ་བདག་ཁོ་ཐབ་ཀའི་ཡར་རྒྱུད་རྩ་ན་ལྷོད་ཀྱིས་ཙོག་བསྡད་འདུག་ཅིང་།",
    "ང་རང་སུ་ཡིན་པ་ཤེས་ཀྱི་མི་འདུག་གམ་ཞེས་དྲིས་དུས།",
    "ཁྱེད་རང་ངོ་ཤེས་སུ་ཞིག་ཡིན་པ་ཤེས་དཀའ་བས།",
    "གྲོགས་པོས་ང་རང་རྟའི་འཕོང་ནས་མར་བླངས་རྗེས།",
    "གཞན་ང་དང་ཅུང་ཐག་ཉེ་སའི་ལུང་འདབས་ཤིག་ན་ཁང་ཆུང་ཞིག་འདུག་པ་དང་།",
    "ཚུར་འདིར་ཤོགས་ཟེར་ནས་ལག་པ་གཡུག་གཡུག་བྱེད་ཀྱིན་འདུག་པ་དང་།",
    "ཁྱེད་རང་གང་ནས་ཡོང་།",
    "འདུག་ས་གང་ན་ཡོད་ཅེས་དྲིས་པར།",
    "ད་འུ་གཉིས་ངེད་ཚང་ལ་འགྲོ་ཟེར་ནས་ངོ་མི་ཤེས་ཀྱང་ངའི་ལག་མགོ་ལ་འཇུས་ཏེ་འཐེན་ནས་ཨུ་ཚུགས་བྱེད་ཀྱིན་འདུག་སྟབས།",
    "ཕར་ཕྱོགས་ཀྱི་ཆུ་འགྲམ་ན་མི་ཞིག་འགྲོ་བཞིན་འདུག་པ་མཐོང་།",
    "ཞེས་བོས་མ་ཐག་ཁོས་ང་རང་ཡིན་པ་ཤེས་ཏེ།",
    "ངའི་དཀའ་ངལ་ནི་ཁྱེད་རང་ལ་བསྡུར་ཐབས་ག་ལ་ཡོད།",
    "ཡང་བསྐྱར་སྟབས་མ་ལེགས་པར་ཉེན་རྟོག་པའི་ལག་ཏུ་ཚུད་བྱུང་ན་ཁྱེད་རང་ལ་ཚེ་བཙོན་དང་ཡང་ན་སྲོག་གཅོད་བྱེད་རྒྱུ་ལས་གཞན་ལམ་ཁ་ཅི་ཡང་མེད་པ་བར་སྐབས་ཉེན་རྟོག་པས་རྩད་གཅོད་བྱེད་སྟངས་ལས་ཤེས་ཐུབ།",
    "ང་རང་ས་གནས་དེ་གར་ཉིན་འགའ་བསྡད་པའི་རིང་།",
    "ལམ་བར་ནས་བཟའ་རྒྱུའི་ཤིང་ཏོག་ཅིག་ཉོ་རུ་འགྲོ་ཁོམ་འདུག་གམ།",
    "བློས་ཐུབ་ཀྱི་གྲོགས་པོ་ལགས་སུ་ང་རང་སྐར་མ་འགའི་རྗེས་ནས་ལྷ་སར་གནས་མཇལ་བྱེད་དུ་འགྲོ་རྒྱུ་གཏན་འཁེལ་ཡོད།",
    "ཁོས་ང་རང་རྒྱ་གར་ཕྱོགས་སུ་འགྲོ་འདོད་ཡོད་པའི་དམིགས་ཡུལ་གསལ་པོར་ཤེས་ཏེ།",
