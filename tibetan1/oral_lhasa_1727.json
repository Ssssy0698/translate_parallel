    "རྐྱེན་དེ་ལྟ་བུ་དག་ཡོད་ན་ནི་རུང་ངོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཀུན་དུ་རྒྱུ་དག་ཕྱི་རོལ་དུ་བྱུང་པར་གྱུར་ན་ནི་རུང་ངོ་ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "སྤུ་ཅན་དེ་མལ་ཆ་མ་ཡིན་པའི་གོས་སུ་ལུས་ལ་བགོ་པར་མི་བྱ་སྟེ།",
    "བཞི་གང་ཞེན་དེའི་ཕྱིར་པ་ལ་ལས་བྱས་པ་དང་ཟར་མ་ལས་བྱས་པ་དང་དུ་གུ་ལ་ལས་བྱས་པ་དང་རས་བལ་ལས་བྱས་པའོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེ་དེ་བཞིན་དུ་གྱོན་པས་བཅག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ལ་བ་དེ་ཕྱི་སློག་ཏུ་དེ་བཞིན་དུ་གྱོན་པས་བཅག་པར་མི་བྱ་བ་སྟེ།",
    "བཅག་པར་མི་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "པར་ཐང་ཁྲ་པོ་ནི་བཀྲ་བའི་ཕྱིར་བཀག་སྟེ།",
    "རྙེད་པ་དང་ཐོབ་པ་ཉིད་ལ་བྱེ་ཕྲག་མེད་པར་རིག་པར་བྱའོ།",
    "རྟག་ཏུ་མལ་གཅིག་ཏུ་བཅག་པར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "ནུས་པ་ཉིད་ཡིན་ན་བརྩེམ་པ་དང་ལྷན་པ་རིང་པོ་དག་གླང་པས་ཕྱིར་བཅོས་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "མི་ནུས་པ་ཉིད་ན་འཆག་ས་དེ་ཉིད་དུ་ལྕི་བ་དང་སས་བྱུག་པར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "གལ་ཏེ་པར་ཐང་དེ་ཕྱིར་བཅོས་མི་ནུས་པ་ཉིད་ཡིན་ན་དེའི་ཚེ་འཆགས་དེ་ཉིད་དུ་ལྕི་བ་དང་སའི་བྱུག་པ་བསྲེས་པས་བྱུག་པར་བྱའོ།",
    "གདིང་བ་དང་དབྱར་གྱི་གོས་རས་ཆེན་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "གོས་འདི་བདག་དང་ཚངས་པ་མཚུངས་པར་སྤྱོད་པ་ལ་མཁོ་བའི་ཡོ་བྱད་ཀྱི་གོས་སུ་བྱིན་གྱིས་བརླབ་བོ།",
    "ལེགས་སོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གཞན་དུ་མ་ཡང་རུང་བར་བྱས་ཏེ་བཅང་བར་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "སྣམ་སྦྱར་ལ་སོགས་པ་ཡོ་བྱད་བཅུ་གསུམ་དང་ཡོ་བྱད་ཀྱི་གོས་ལས་གཞན་པའི་གོས་དུ་མ་ཡང་རུང་བར་བྱས་ཏེ་བཅང་བར་བྱ་བའོ།",
    "ལེགས་སོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "བསྙེན་པར་མ་རྫོགས་པ་ལ་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "བསྙེན་པར་རྫོགས་པ་ལ་གོས་དག་རུང་བར་མི་བྱ་བའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "ཡུལ་གཞན་དུ་གནས་པར་གྱུར་པ་ཉིད་ན་ཡང་རུང་བ་མི་ཉམས་སོ་ཞེས་བྱ་བ་ནི།",
    "གང་ལ་རུང་བར་བྱས་པ་དེ་ཤིན་རུང་བདེ་ཉམས་པའོ།",
    "སྣུམ་གྱིས་ན་རྩུབ་པར་བྱས་ཏེའོ་ཞེས་བྱ་བ་ནི།",
    "ཉེ་བ་འཁོར་སྦྱིན་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "འདོམས་པར་བྱེད་པ་དང་བཅས་པ་ལ་མི་སྦྱིན་ནོ་ཞེས་བྱ་བ་ནི།",
    "འདོམས་པར་བྱེད་པ་མ་ཡིན་པ་དང་བཅས་ཏེ་ལྷན་ཅིག་ཏུ་ལེན་དུ་འོངས་ན་བསྐུར་བར་མི་བྱ་བ་སྟེ།",
    "ཕྱིར་འགུགས་ན་སྦྱིན་པར་བྱ་བའོ་ཞེས་བྱ་བ་ནི།",
    "དུར་ཁྲོད་ནས་ཕྱིར་བཟློག་པའི་གོས་དགེ་སློང་ལ་ཕུལ་བ་དེ་དགེ་སློང་ལས་ཕྱིར་འགུགས་ན་ཕྱིར་སྦྱིན་པར་བྱ་བ་སྟེ།",
    "འདུ་བའི་སྒོ་མི་ཟད་པ་ཉིད་དུ་ངེས་པར་བྱས་པ་གཞན་དག་དང་།",
    "དེ་དག་ལས་གཞན་པ་ཟས་ཀྱི་དོན་དུ་སྦྱར་བ་གྲོ་ནས་ལ་སོགས་པ་གཙང་བག་དང་།",
    "བསྐོ་བས་ཉེ་བར་འཚོ་པར་བྱ་བ་ཞེས་བྱ་བ་ནི།",
    "ཅིའི་ཕྱིར་ཞེན་རྙེད་པ་དེ་གནས་ཀྱིས་བསྟབས་པ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རྙེད་པ་དེ་གནས་ཀྱིས་བསྟབས་པ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་གསུངས་པ་ལ།",
    "འདིར་གཞུང་ནི་གང་ལས་སྦྱིན་པར་བྱ་ཞེན།",
    "ཡུན་རིང་དུ་གནས་གནས་པ་ལས་སོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "རྫས་ཀྱིས་མནན་པར་གནས་པར་ཁས་བླངས་པ་ནི་སྐལ་བ་གཅིག་ཁོ་ནའོ་ཞེས་བྱ་བ་ནི།",
    "སྐལ་པ་གཅིག་ཁོ་ནའོ་ཞེས་སྨོས་པ་དེས་གང་ནས་སྐལ་བ་གཅིག་ཁོ་ན་དེ་ལ་སྦྱིན་པར་བྱ་ཞེ་ན་དེའི་ཕྱིར་དེ་ལ་མནན་པ་རྣམས་སུ་བདག་ཉིད་བགྲང་བའི་ཆ་ཉིད་དོ་ཞེས་བྱ་བ་སྨྲས་ཏེ།",
    "དེ་ལས་སྐལ་པ་གཅིག་སྦྱིན་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "གཞན་པ་གཅིག་ཏུ་གནས་པར་ཁས་བླངས་པ་ལ་ནི་ཡུན་རིང་བ་ཉིད་ཀྱིས་རྣམ་པར་གཞག་གོ་ཞེས་བྱ་བ་ནི།",
    "མཚམས་དུ་མ་ཁྲི་ལ་སོགས་པས་མནན་ཏེ་གནས་པར་ཁས་བླངས་པ་སྔར་བསྟན་པ་དེ་ལས་གཞན་པ་གཅིག་ཏུ་གནས་པར་ཁས་བླངས་པ་ཞེས་བྱ་བ་དབྱར་གནས་པར་ཁས་ལེན་པའི་དུས་དེ་ཉིད་ཀྱི་ཚེ་དང་བོར་གནས་གཅིག་ཏུ་གནས་པར་ཁས་བླངས་ནས་དེ་མ་ཐག་ཏུ་ཡང་གནས་གཞན་གཅིག་ཏུ་གནས་པར་ཁས་བླངས་ཤིང་།",
    "དེའི་འོག་ཏུ་ཡང་གནས་གཞན་གཅིག་ཏུ་གནས་པར་ཁས་བླངས་ཏེ།",
    "དེ་ནས་ཡང་གནས་གཞན་གཅིག་ཏུ་གནས་པར་ཁས་བླངས་པ་སྟེ།",
    "དེ་ལྟར་གནས་ཐ་དད་པ་དུ་མང་གནས་པར་ཁས་བླངས་པ་ལ་ནི།",
    "གནས་དེ་དག་གང་དུ་དབྱར་ཡུན་རིང་དུ་གནས་གནས་པ་ཉིད་ཀྱིས་དེའི་རྙེད་པ་རྣམ་པར་གཞག་སྟེ།",
    "གང་དུ་ཡུན་རིང་དུ་གནས་གནས་པའི་གནས་དེ་གཅིག་བུ་ནས་དེའི་རྙེད་པའི་སྐལ་པ་རངས་པ་གཅིག་སྦྱིན་པར་བྱའི།",
    "དེ་དག་ནས་ཆ་བསྡུ་པར་ཡང་མི་བྱའོ།",
    "འདིར་གཞུང་ནི་ཚེ་དང་ལྡན་པ་ཉེ་དགས་རྙེད་པ་འདོད་པས་གཙུག་ལག་ཁང་གཉིས་སུ་ཚུལ་ཤིང་དང་གནས་མལ་བླངས་ཏེ་གནས་པར་ཁས་བླངས་པ་ན།",
    "གང་དུ་གསོ་སྦྱོང་ལན་མང་དུ་བྱས་པ་དེ་ནས་རྙེད་བ་བླང་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "བསྙེན་པར་རྫོགས་པ་ལ་འདོད་པ་དང་དགེ་སློང་མ་དག་ཀྱང་ངོ་ཞེས་བྱ་བ་ནི།",
    "དེ་གཉིས་ཀྱང་བསྙེན་པར་རྫོགས་པ་དག་དང་རྙེད་པ་མཉམ་པ་ཉིད་ཡིན་པ་སྟེ།",
    "བསྙེན་པར་རྫོགས་པར་འདོད་པ་ཞེས་བྱ་བ་ནི།",
    "དགེ་ཚུལ་ལོ་ཡང་ཚང་ལ་བསྙེན་པར་རྫོགས་པ་ཡང་འདོད་པ་རྣམས་ལ་བྱའི་ལོ་མཚང་པ་དང་ལོ་ཚང་ཡང་བསྙེན་པར་རྫོགས་པར་མི་འདོད་པ་རྣམས་ནི་སུམ་ཆ་དབྲི་བ་སྔར་བསྟན་པ་ཉིད་ཀྱི་ཁོངས་སུ་གཏོགས་སོ།",
    "དགེ་སློང་དང་དགེ་སློང་མ་དག་ནི་སྐལ་པ་མཉམ་པར་སྦྱིན་ནོ།",
    "དགེ་སློང་དང་དགེ་སློང་མའི་རང་བཞིན་གྱི་གང་ཟག་ཇི་སྙེད་དེ་ལ་སྐལ་བ་དང་བ་དེ་སྙེད་ལ་མཉམ་པར་བྱའི།",
    "འདིར་གཞུང་ནི་མགོའི་ཤས་ཀྱིས་བགོ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "དགེ་སློང་མ་རྣམས་ཀྱི་ཚོགས་པའི་དུས་ན་རྒན་པའི་མཐའ་ལོགས་སུ་གྲལ་གྱི་སྟན་དག་ལ་གཞག་པར་བྱ་སྟེ།",
    "དང་པོར་ཟས་ལེན་པའི་དང་པོར་དེ་ལ་དེ་སྐད་མ་བསྒོ་ན་ཉེས་བྱས་སོ།",
    "སྨྲས་ན་ཡང་དེའི་འོག་ཏུ་སྨྲ་པར་བྱ་བ་ཡིན་ཏེ།",
    "དེའི་ཚེ་ཡང་མ་སྨྲས་ན་ཉེས་བྱས་གཞན་དུ་འགྱུར་རོ།",
    "འཁོར་ལ་བལྟས་ཏེ་མང་ལ་ཟས་ཉུང་བ་ཉིད་ཡིན་ན་དེའི་ཚེ་སྔ་མ་བརྗོད་ཅིང་ཁྱད་པར་ཤེས་སོ་ཞེས་བྱ་བ་ནི།",
    "དེ་ལ་དང་པོར་སྔ་མ་བརྗོད་ཅིང་ཁྱེད་པར་བྲིམས་ཤིག་ཅེས་བསྒོ་བར་བྱའོ་ཞེས་བྱ་བར་སྦྱར་རོ།",
    "རྒན་པའི་མཐར་སཾ་པྲཔྟ་ཞེས་མ་བརྗོད་པར་དང་པོར་བླང་བར་མི་བྱའོ་ཞེས་བྱ་བ་ནི།",
    "བི་ཤཾ་པྲཔྟ་ཞེས་བྱ་བ་ནི་མི་མཉམ་པར་གྱུར་ཅེས་བྱ་སྟེ།",
    "དུག་མེད་པར་གྱུར་པ་ནི་མཉམ་པར་གྱུར་པ་སྟེ་སཾ་པྲཔྟ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "ཟས་དུག་ཅན་ཡང་དུག་མེད་པར་འགྱུར་རོ།",
    "ཟས་བསྔོགས་པ་ན་བསྐོས་པ་དག་ལས་གཞན་པ་དག་ལྷགས་ན་དེ་ལ་སྦྲན་པར་བྱའོ་ཞེས་བྱ་བ་ནི།"
  ]
}