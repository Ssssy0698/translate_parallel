    "དུས་དེ་ཙ་ན་བོད་ཀྱི་སྲིད་སྐྱོང་ཝང་ཇཱ་ལས་བཀའི་གུང་བློན་གྱི་འཁུར་འཛིན་པའི་རྟོགས་བརྗོད་བུང་བའི་མགྲིན་གླུ།",
    "གང་ཞིག་བུ་རུ་གྱུར་ན་པེ་ཅིང་རྒྱལ་ཁབ་དུ་ཁྲིད་རྒྱུའི་སྟ་གོན་བགྱིས་འདུག་རུང་།",
    "ཟུར་ཁང་ངོ་བོ་ཕོན་མི་ཆུང་བའི་ཐོག་ཏུ་ཁེ་གསུམ་པའི་བུ་སྨད་ཆེས་མང་བ་དང་བཅས་མཐུན་སྦྱོར་ཡུན་རིང་དུ་མི་གནས་པ་ཁོ་ཐག་ཞེས་ཅི་རིགས་པའི་གཏམ་སྣ་ཚོགས་གླེང་བ་བྱུང་འདུག་ནའང་།",
    "སྤྱིར་རྒྱུ་འབྲས་ལ་ཡིད་རྟོན་ཞིང་རང་བཞིན་བཟང་བ།",
    "སྔོན་ཞུས་པ་བཞིན་ཡབ་རྗེ་དམ་པའི་ཡུམ་གྱི་སྐྱེ་བ་ཡིན་འདྲ་སྙམ་པ་ཤར་ཞེས་སྩལ་འདུག་པ་སོགས་བར་སྐབས་ཀྱི་ཚིགས་སུ་བཅད་པ་ནི།",
    "མེ་ཁྱི་ལོ་ལྷ་ལྡན་དུ་བཞུགས་སྐབས་ངོས་བཙས་ཚེ་འཁོས་དཔག་ཀྱིས་བཙས་སྟོན་ཡང་བགྱིས་འདུག་དེ་ཡང་མིའི་ལུས་རྟེན་རྣམ་གྲངས་མང་བའི་ནང་མཚན་ནས་རྒྱལ་བ་གོང་མ་རྣམས་ཀྱིས་མཛད་པ་ལ་རྗེས་སུ་ཞུགས་ཤིང་།",
    "ལྡན་ཁང་གསར་འདྲ་ཚད་པ་ལ་རབ་གསལ་གསུམ་བརྩེགས་ཀྱི་འོག་ན་སྒོ་འབྱོཪ་གསུམ་སྐས་སྐས་ཡུར་སྣམ་དམར་དཀྲིས་པ་ཞིག་འདུག་པར་ཡར་འཛེགས་ཕྱིན་པས།",
    "རྟེན་ཅིང་འབྲེལ་བྱུང་རང་ལ་རག་ལུས་པ།",
    "ཁ་ནུབ་དུ་ལྟས་ནས་མཎྜལ་ཞིག་གུས་གུས་ཀྱི་ཚུལ་དུ་འབུལ་གྱི་འདུག་པར།",
    "མ་འདུག་ང་ཕྱིར་འབྲང་དང་འདོད་དོན་གསལ།",
    "སླར་ཡང་རང་ཅག་ཟུར་ཁང་པ་ཞེས་པའི་མི་ནོར་ཚང་མའི་ཐད་གཞན་དག་ལྟ་བུའི་དར་གུད་ཚབ་ཆེར་མི་འགྱུར་བར་གཞུང་སའི་ལས་དོན་གྱི་འཁུར་འཛིན་རྒྱུད་བཅས་ཚང་མ་ལུང་དུ་རྒྱུག་ཅིང་།",
    "ཁྲིན་ཨམ་བན་ཆེན་པོས་ཀྱང་ཕེབས་བྱམ་གྱི་འགྲམ་ནས་བཀའ་བློན་དྲང་ཚུག་ཟིན་ཅིང་མི་སེར་ལ་བྱམས་སྐྱོང་ཆེ་བ་ཡོད་འདུག་པས་ད་དུང་མི་སེར་ཐོག་རྒྱ་བོད་ནས་ཟ་གོའི་རིགས་བྱེད་མ་འཇུག་ངོས་ཀྱི་གཡོག་རྣམས་ལའང་གྲོ་ཆས་ཀྱི་མཐུན་རྐྱེན་མ་འཚེམས་པའི་ཐོག་ནས་ཕན་ཚུན་ཚང་མ་ཉེ་སྙོམས་པ་བགྱིས་ཞེས་ཡང་ཡང་བཀའ་ཕེབས།",
    "ངོས་ལ་སྐྱེས་སྦྱངས་ཀྱི་ཤེས་བྱ་སྔོ་ཐོག་པ་ཞིག་མི་འདུག་ཀྱང་།",
    "རང་གསལ་དང་རང་སྟོང་རང་རིག་གསུམ།",
    "ནང་རང་སེམས་ཀྱི་རོལ་པར་ཐག་ཆོད་ནས།",
    "གསུངས་པའང་རང་དོན་དུ་ཡིན་གྱི།",
    "ལག་པའི་སྒྲིལ་ཕྱོགས་སྐྱེས་ལྷ་ཕོ་ལྷ་སོགས་ཀྱི་མཐུ་རྩལ་ཤུགས་ཆེ་ཆུང་རང་ལ་རག་ལུས་པ་ལས་བདེན་གྲུབ་བློས་འཁེལ་དུ་མ་མངོན།",
    "ཐེའུ་རྩི་དང་དཀར་ཡོལ་ཁེབ་སོགས་གང་ལའང་འགུལ་སྐྱོད་ཙམ་མེད་པར་སྔོན་བཞག་ལྟར་ཁྲིད་གེར་བསྡད་འདུག་པར།",
    "སང་ཉིན་སྔ་ཐོག་བལྟ་སྐབས་འགུལ་སྐྱོད་ཙམ་ཡང་མ་བཏང་འདུག་གཤིས།",
    "དེར་རྟེན་ངོས་རྣམས་ཀྱང་སེམས་ངལ་ཞིང་རྣམ་གཡེང་ཟུང་དུ་འཇུག་པའི་རྒྱུ་ཁོ་ནར་འདུག་ཅེས་ཞུས་པས།",
    "སང་ཉིན་རྣམ་སྲས་ཁོ་པའི་གཟན་གསར་པ་ཞིག་ཡོད་པ་བཅོད་ནང་དུ་སྐྱུར་འདུག་པ་ཁོ་པ་ཉལ་མི་རུང་བར་ཤེས་ནས་རང་གཅིག་པོར་སྡུག་རུས་ཀྱི་ཉལ།",
    "ད་ཆ་ཁྱེད་རང་གཞིས་རྩེ་བསྒྲལ་ནས་འགྲོ་མ་དགོས་ཤིང་།",
    "རྟ་དང་སྲོག་ཆགས་ཀྱི་རིགས་ཚང་མའི་དཔྱད་པ་ལ་ཤིན་ཏུ་ནས་ཐུགས་སུ་མངའ་བ་ཞིག་ཡིན་འདུག་རུང་།",
    "སེམས་དང་རྣམ་རྟོག་ཁོ་རང་གཉིས་ངོ་བོ་གཅིག་ཡིན་པའི་སྟབས་ཀྱིས་རིག་པ་ལ་ངན་རྐྱེན་གང་ཐུབ་བྱེད་ཀྱི་ཡོད་གསུངས།",
    "རྣམ་རྟོག་མྱུ་གུ་སྐྱེས་པ་ལྟ་བུ་ཡིན་ཞེས་ཐ་དད་དུ་ཕེབས་པ་རྣམ་རྟོག་ཀྱང་ཡུལ་དོན་བབ་ཆགས་ཀྱིས་སླས་པའི་སེམས་ཀྱི་སྩལ་སྣང་མེའི་རང་བཞིན་ཚ་བ་ལྟར་ལསམྱུ་གུ་བཞིན་དུ་ཐ་དད་ཤར་ཅིང་དེ་ལ་ངོས་འཛིན་བྱེད་ཡུལ་བྱེད་མཁན་དེ་དག་རྣམ་རྟོག་ཁོ་རང་ཡིན་ན་མ་གཏོགས་གཞན་ཞུ་མ་འཚལ།",
    "ཐབས་ཤེས་ཡ་མ་བྲལ་བའི་མཛད་པ་ད་མུས་བཞིན་གཅིག་ཕན་གཅིག་གྲོགས་རང་བཀའ་དྲིན་ཆེ་དགོས་འདུག་ཞེས་ཞུ་རྒྱུས་མཚོན་ཇི་ལྟ་ཇི་སྙེད་ཀྱི་གསུང་གླེང་མང་ཙམ་བྱུང་རུང་།",
    "བཀོད་པ་གཏོང་མ་བདེ་ཙམ་འདུག་ཞུས་པར།",
    "རྣམ་སྨིན་འབྱུང་ལུས་ཀྱི་གནས་ཚང་འདི་བཞིན་ལྟེ་བ་ཅོང་ཟོམ་ཆེ་བ་ཞིག་མི་འདུག་རུང་།",
    "སྡུག་བསྔལ་དང་ལེན་གྱི་འཕེན་པ་བཟང་པོའང་ཡོང་རིག་བཅས་འགལ་བ་ཆེར་མེད་འདུག་ཀྱང་།",
    "དེའི་དགོངས་པ་དང་མ་མཐུན་པ་གང་ཡིན་རྣམས་ཁམས་གསུམ་ཟེར་བའི་ས་འཛིན་སྡུག་བསྔལ་གྱི་སྦ་ལོང་འཁྲུག་པ་དེར་འགྲོ་དགོས་ཀྱི་ཡོད་ཚད་འདུག་པས།",
    "ཞེས་ཟེར་བར་ཞིབ་དུ་བརྟག་ན་བདེན་པ་ཙམ་འདུག་རུང་།",
    "སྲིད་པའི་མཐའ་ཆོད་པ་ཞིག་མ་བྱས་ཀ་ཐོག་ཏུ་འདུགབྱེད་པར་ཙམ་པ་ལ་གཡོག་འཁོར་དུ་བུ་ཚ་ཁྱིམ་ཐབ་ལ་སོགས་པས་སྒབ་བསྣན་ཟང་ཟིང་དངོས་པོར་འཛིན་པ་རྣམས་ཀྱི་བློ་འཁྲིད།",
    "ད་ནི་རྩམ་པ་འགམ་སམ་གླིང་བུ་བཏོང་གཅིག་མ་གཏོགས་གཉིས་མི་བཅོག་པ་འདུག་པས་ཅི་བཀའི་གུང་བློན་གྱི་འཁུར་འཛིན་པའི་རྟོགས་བརྗོད་བུང་བའི་མགྲིན་གླུ།",
    "ངོས་བཟུང་བྲལ་བར་འདུག་པ་དེ་སྤྱོད་པ་ཟེར་བ་ཡིན།",
    "མ་བཅོས་སོ་མར་འདུག་པ་ལ་ཀུན་གཞི་ཟེར་བ་ཡིན།",
    "མགོ་འཇུག་རྣམས་ལ་དཔྱད་པ་བྱས་ན་གོ་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་སྙམ་རྨི་ལམ་གྱི་སྣང་བ་ལྟར་ངོས་བཟུང་མེད་པ་བརྗོད་རྒྱུ་ཡོད་ཚད་ཚད་ལ་བརྗོད་རང་ཡང་མི་ཤེས་པ་གཅིག་བྱུང་།",
    "ཕྱག་ཞབས་ཚང་མར་ཆབ་གཡོར་ཆེ་ཙམ་སླེབ་འདུག་པ།",
    "འདི་བསམ་ན་ཐམས་ཅད་རྫུན་དུ་འདུག་རྫུན་བདེན་པར་འཁྲུལ་བའི་སྤྲོ་སྤྲོ་འདི།",
    "དྲེགས་འགྱིང་རང་མཐོང་ལ་འབྱམས་ཀླས་ཅིང་།",
    "ནང་རང་སེམས་རྫོགས་པས་རྫོགས་ཆེན་ཞེས།",
    "གསུང་ཞལ་གདམས་ལ་འདི་འདྲ་མི་འདུག་གམ།",
    "སེམས་ཉིད་ཁོ་རང་གཅིག་པོ་ལས།",
    "རང་རང་ལ་ཡོད་པའི་འདོད་བཀའི་གུང་བློན་གྱི་འཁུར་འཛིན་པའི་རྟོགས་བརྗོད་བུང་བའི་མགྲིན་གླུ།",
    "འདི་དངོས་སུ་འདུག་གམ་རྫུན་དུ་བརྡ།",
    "དེས་ན་ཞེ་སྡང་རང་སར་དག་གཉུག་མའི་ངང་ལ་འདོད་ཆགས་ཤར།",
    "དགོས་འདོད་འབྱུང་ཞིང་རང་ལ་གནས།",
    "ད་ལྟ་ཐེག་དམན་ཚིགས་སུ་འདུག་ཐེག་ཆེན་ཡིན་ནོ་བསམ་པ་དེ།",
    "སོ་སོ་ཕྱག་སྲོལ་མི་འདྲ་ཙམ་འདུག་ཀྱང་།",
    "སྨྲ་བསམ་བརྗོད་མེད་གཤིས་ལུགས་སུ་འདུག་ན།",
    "འདུག་ལྟ་བ་མཐོ་ན་རྒོད་ཀྱི་གཤོག་རྩལ་ལྟར།",
    "ལུས་ཀྱི་སྡོད་ཡུལ་སྤར་སྐབས་ཆེར་མི་འདུག་གཤིས།",
    "ཞེས་འཕྱོངས་རྒྱས་སྤུན་བདུན་དུ་ལོ་མཚམས་པ་ཀུན་བཟང་དབྱིངས་གྲོལ་ལ་བསྐུར་བ་དྲན་འཛིན་ལྕགས་ཀྱུ། ། ཡང་རང་བཞིན་སོས་དལ་སྐབས་ཉམས་འཆར་དུ་བྲིས་པ།",
    "སེམས་ཉིད་འདི་མེ་ཏོག་དྲི་མ་དང་འདྲ་སྙམ་པ་འདུག་མེ་ཏོག་འདི་རྣམས་ཀྱང་དང་པོར་མདངས་མཚར་ལ་དྲི་ཞིམ་པ་བུང་བ་མང་པོས་འཕུར་ལྡིང་གཡོ་ཞིང་།",
    "ང་མིའི་ལག་ཏུ་ཐེབས་ནས་སྦུག་ཤིན་ཏུ་ཐུམས་པ་འདུག་པས་དེ་ལས་ཐར་བའི་ཐབས་གང་བྱས་པ་དྲག་ཞེས་ནེ་ཙོ་སྨྲ་མཁན་ནས་ལན་དེ་ལྟ་བུ་སྐུར་བྱུང་ཞེས་ལབ་རོགས་བགྱིས་བྱས་དོན་ཚོང་དཔོན་ལམ་དུ་ཐོན་པའི་ཟླ་ཤས་ཀྱི་སར་སླེབས་སྟུན།",
    "ཁྱེད་རང་དེ་འདྲ་མ་མཛད་མཁན་ཞིག་ཡིན་མིན་འགྲོ་བས།",
    "ཨ་ནུ་ཏ་ར་ལ་སོགས་པའི་ངོ་སྤྲོད་ཟབ་རྒྱས་ཅན་མང་ཙམ་གསུངས་འདུག་རུང་།",
    "ཟེར་བ་སོགས་འདུག་པས་གང་ཡིན་གོ་བདེ་བ་ཞིག་དགོས་ཞེས་དྲི་བའི་ལན་དུ།",
    "ཤར་བ་ལ་མ་ཞེན་ཕྱིན་ཤར་གྲོལ་དུས་མཉམ་ཟེར་བ་བདེ་སྟོང་ཡེ་ཤེས་ཟུང་འཇུག་དུས་གཅིག་དུ་ཤར་དང་གྲོལ་བ་དུས་གཅིག་དུ་ཡོང་ཞེས་པ་ལྟ་བུ་དང་།",
    "འདུག་ཡང་འཁྲུལ་པས་མ་ཀླས་པ་ལ་ཀ་དག་གླེང་ཞིང་།",
    "རྣལ་འབྱོར་པ་བཀའ་ལས་ང་རང་བྱ་བྱེད་ཚང་མའི་གཏིང་རྟོགས་ནས་བྱ་རྒྱུ་ཟད་ཞིང་བྱེད་དུ་མ་འགྱུར་བ་ཞིག་ཡིན་པས་བརྟག་པ་མི་ཡོང་།",
    "ཡི་གེ་ཁ་ཕྱེས་ནས་ལྟས་དུས་འགོ་མཆན་ལ་འདི་ལྟར་བྲིས་འདུག་ཧྲིསྟོང་པ་ཆེན་པོའི་བཀའ།",
    "ཤོད་རྒྱུ་ཨེ་འདུག་ཟེར་བར།",
    "ཡེ་ཤེས་ལྔ་ཡི་ངོ་བོ་རང་རིག་ལ་རྫོགས་འདུག་མ་ཤེས་འགྲོ་བའི་སྣང་ངོར་དུག་ལྔ་རུ་འཆར་ཟིན།",
    "མ་སྒོམས་གདོད་མའི་མགོན་པོ་རང་གྲུབ་དུ་བྱོན་བཅོས་འདུག་ཧར་གྱིས་འཛིན་ཞེན་མེད་པའི་སྣང་ཆ་ལ་ལྟས་པས།",
    "སྲིད་ཞིའི་དངོས་ཀུན་ཡེ་ཤེས་རོལ་པ་རུ་འདུག་པས།",
    "སྣང་སྟོང་རང་ཤུགས་འདྲེས་པ་ཡེ་ཤེས་ཀྱི་རོལ་རྩལ།",
    "ཕན་ཐོགས་པོ་ཡོང་བ་འདུག།",
    "རྒྱལ་པོ་རོལ་པའི་འདུག་བཀའི་གུང་བློན་གྱི་འཁུར་འཛིན་པའི་རྟོགས་བརྗོད་བུང་བའི་མགྲིན་གླུ།",
    "ཕར་ལྟས་སྐབས་ཞལ་གཅུས་ནས་འགྲོ་བ་ཞིག་འདུག་ངས་དགེ་སློང་ལགས་ཞབས་སྐོར་ལ་ཕེབས་པ་ཨེ་ཡིན།",
    "ཁྱེད་རང་ཉམས་བཞེས་གང་མཛད་ཀྱི་ཡོད་ཞུས་པས།",
    "དེ་ནས་ཚུར་མཉམ་དུ་བྱོན་སྐབས་ཀླུ་ཁང་རྒྱབ་ཀྱི་ལམ་ཁར་སྦལ་པ་མང་པོ་སྐམ་ནས་འཆི་གྲབས་འདུག་པ་སྒྲུག་ནས་ཆུ་ལ་རིམ་བཞིན་བླུག་པར།",
    "ལར་ནས་དད་པའི་ལྕགས་རི་འདི་སྲ་ཐང་ཞིག་ཡོད་ན་སྐྱོན་མི་འདུག་ཀྱང་།",
    "འདི་ཡང་སྒྲོམ་མ་ཞིག་ཙམ་ལས་གདེང་འཁེལ་རང་མི་འདུག་སྟབས།",
    "དེའི་མཐར་འོབ་རིམ་པ་གསུམ་གྱིས་ངེས་པར་བསྐོར་དགོས་པ་འདུག་གསུངས།",
    "ད་ང་ཅག་ཡ་ང་བག་ཚ་རང་མེད་པར་རྣམ་དག་མཁའ་ཀློང་རང་དུ་ཆས་འགྲོ་བ་རང་ཡིན་གཉའ།",
    "ལག་པ་བཟུངས་ཏེ་འཐེན་གྱི་འདུག་པར།",
    "འདི་བསད་ན་ལས་དང་རྣམ་སྨིན་གཉིས་ཀ་ནག་པ་ཞིག་ཡོད་འདུག་པསཚེ་འདི་ལས་ཕྱི་མ་ཁག་སྙམ་ནས་ཁྱི་དེ་རྡོ་གཅིག་ལ་བཏགས།",
    "དེ་ནས་གླིང་སྐོར་གྲངས་གསོག་སྐྱང་སྐབས་ཐུགས་ལ་ཉམས་འཆར་སོགས་མང་དག་བྱུང་འདུག་རུང་ཁ་ཤས་གོང་དུ་འཁོད་འདུག་ཅིང་།",
    "ཧ་ཅང་རང་ནི་གང་ཡོང་ཉམས་འཆར་སེམས་ལ་གང་ཤར།",
    "སྡོད་གནས་དང་རང་ལུས་མེད་སྙམ་སོགས།",
    "ཞབས་བསྟན་སྒྲུབ་རྒྱུ་ཕྲན་བུ་འདུག་པ་རྣམས་སྒྲུབ་ཚེ་ཉེས་ངོ་མེད་ཞེས་སྩལ་འདུག་ཞུས་པར།",
