    "བདུན་པའིནངན་འདུག་པ་གང་ཡིནཔ་དེདག་ཀྱང་ཁ་ནང་དུ་བལྟས་ཏེ་འཁོད་དོ།",
    "གསོད་བྱེད་ཀྱི་གནས་རྣམསན་སུ་ཞིག་འདུག་ཅེས་འཇིག་རྟེནའདི་ཐམས་ཅདམྱུལ་ཏེ།",
    "ཆུས་འཚོ་ཞིང་འདུག་ནས་གྲོང་དང་།",
    "ད་ང་ནི་ཆ་དང་མཉམ་པར་འདུག་སྟེ།",
    "སྟེ་ནི་ཆུ་དང་མཉམ་པར་འདུག་སྟེ།",
    "འདི་ནས་དཔག་ཚད་བཞི་ཁྲིའི་སྟེང་ན་ནི་རྒྱལ་ཆེན་བཞི་པའི་ལྷརྣམསའདུག་གོ།",
    "ཤིན་ཏུ་མཐོང་བའི་ལ་རྣམས་ཡན་ཆད་ནས་དང་པོ་ཡན་ཆད་ཀྱི་ཚད་ཇིཙམ་པ་དེ་སྲིད་ན་འོག་མིན་གྱི་ལྷ་རྣམས་འདུག་གོ།",
    "ཁྲི་ལ་འདུག་གམ།",
    "གལ་ཏེ་ཁྱིམ་པར་འདུག་ཅིད་ཁྱིམ་ནགནས་ན་ནི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་མཐའ་བཞིར་རྒྱལ་ཞེས་བྱ་བ་ནས་རྒྱས་བར་སྦྱར་ཏེ།",
    "གལ་ཏེཁྱིམ་པར་འདུག་ཅིང་ཁྱིམ་ནགནས་ན་ནི་འཁོར་ལོས་སྐྱོ་བའི་རྒྱལ་པོ་མཟའབཞིང་རྒྱལ་བཞེས་བྱ་བ་ནས་རྒྱས་པར་སྦྱར་ཏེ།",
    "གལ་ཏེ་ཁྱིམ་པརའདུག་ཅིང་ཁྱིམནགནས་ནནིའཁོར་ལོས་སྐྱུར་བའི་རྒྱལ་བོ་མཐའ་བཞིར་རྒྱལ་གཞེས་བྱ་བ་ནས་རྒྱས་པར་སྦྱར་ཏེ།",
    "གལ་ཏེ་སྐྲ་དང་ཁ་སྤུ་རྣམས་ནསགདའ་བྲེག་མ་ཏེ།",
    "གལ་ཏེ་ཁྱིམ་པར་འདུག་ཅིང་ཁྱིམ་ན་གནས་ནནི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་མཐའ་བཞིང་རྒྱལ་བནས་རྒྱས་པར་སྦྱར་ཏེ།",
    "གལ་ཏེ་ཁྱིམ་པར་འདུག་ཅིང་ཁྱིམ་ན་གནས་ན་ཞི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་མཐའ་བཞིར་རྒྱལ་བ་ཞེས་བྱ་བནས་རྒྱས་པར་སྦྱར་ཏེ།",
    "གལ་ཏེ་ཁྱིམ་པར་འདུག་ཅིང་ཁྱིམ་ན་གནས་ནཞི་འཁོར་ལོས་སྤང་བའི་རྒྱལ་པོ་༴",
    "གལ་ཏེ་ཁྱིམ་པར་འདུག་ཅིང་ཁྱིམ་ན་གནས་ན་ནི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་བོ་མཐའ་བཞིར་རྒྱལ་བ་ཞེས་བྱ་བ་ནས་རྒྱས་བར་སྦྱར་ཏེ།",
    "གལ་ཏེ་ཁྱིམ་པར་འདུག་ཅིང་ཁྱིམན་གནས་ནཞི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་མཐའ་བཞིང་རྒྱལ་བ་ཞེས་བྱ་བ་ནས་རྒྱས་པར་སྦར་ཏེ་ཅི་འདོད་པ་དང་།",
    "གལ་ཏེ་ཁྱིམ་པར་འདུག་ཅིང་ཁྱིམ་ན་གནསནནི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་མཐའ་བཞིར་རྒྱལ་བ་ཞེས་བྱ་བནས་རྒྱས་པར་སྦྱར་ཏེ།",
    "གལ་ཏེ་ཁྱིམ་པར་འདུག་ཅིང་ཁྱིམ་ན་གནས་ན་ནི་འཁོར་ལོསཙ་༦ ༡༣ སྒར་བོའི་རྒྱལ་བོ་མཐའ་བཞིར་རྒྱལ་བ་ཞེས་བྱ་བ་ནས་རྒྱས་པར་སྩལ་ཏེ།་",
    "དེའི་སྔ་ལྟས་ནི་འདི་ཡིན་ཏེ་གལ་ཏེ་ཁྱིམ་པར་འདུག་ཅིར་ཁྱིམ་ན་གནས་ནནི་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་མཐའ་བཞིར་རྒྱལ་བ་ཞེས་བྱ་བ་ནས་རྒྱས་པར་སྦྱར་ཏེ།",
    "ག་ཡོས་དང་འོད་དང་མི་འདུག་དང་།",
    "གཉིས་དང་རང་རྒྱལ་ཟུང་གཉིས་དང་།",
    "གད་པོའི་༢ཁོད་ན་འདུག་པའི་མེའི་ཁམས་དང་།",
    "ཅིའི་ཕྱིར་འཚོ་ཞིང་གསོན་ལ་འདུག་ཅིད་སྡོད་པའི་ལུས་མི་འདུལ་ལ།",
    "འཚོ་ཞིང་གསོན་ཏེ་འདུག་ཅིང་སྡོད་པ་ནི་ཁོང་ན་འདུག་བའི་མེའི་ཁམས་དད།",
    "ཤི་སྟེ་ཤི་བར་འགྱུར་བའིན་ཁོང་ན་འདུག་པའི་མེའི་ཁམས་དང་།",
    "སེམ་ས་ཅན་གང་དག་སྔོན་མིར་གྱུར་ཅིང་འདུག།་",
    "དེ་ལྟར་ན་མི་སྣང་ཞིང་འདུག་པ་ལས་སྣང་བར་འགྱུར་རོ།",
    "ཅིའི་ཕྱིར་ཕུལ་པ་ནམམཁའ་ལ་འདུག་ཅེ་ན།",
    "རྒྱུ་དེས་ན་སྤྲུལ་པ་ནམ་མཁའ་ལ་འདུག་གོ།",
    "སྒོ་པན་འདུག་པ་རྣམས་དང་།",
    "མངལ་ན་འདུག་པརྣམས་དང་།",
    "གཉེན་གྱི་ཁྱིམ་གྱི་ནང་ན་འདུག་ཀྱང་རུང་།",
    "འདི་ནི་འདོད་པ་དང་ལྡན་པའི་སེམས་འདུགོ་ལའོ།",
    "ཇི་སྲིད་ཀྱི་བར་དུ་བསོནཞང་འདུག་ལ་སྡོད་ཅིང་འཚེ་བ་དེའི་སྲིད་ཀྱི་བར་དུ་སྡུག་བསྔལ་ཞིང་ཡིད་དུ་མི་འོང་བས་གནས་ལ་ལུས་དང་བྲལ།",
    "རྟ་ཅད་ཤེས་སྐྱིད་དེ་བར་འདུག་པ་ལས་དར་བ་ཁ་ལུགས་ལས་སོགས་པའིགནོད་པས་གནོད་པར་བྱ་བ་གང་ཡིན་པ་དེ་ན་གནོད་པ་དང་བཅས་པའི་ལས་ཀྱི་འབྲས་བུའོ།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པ་རྣམས་།",
    "ཉེས་སྤྱོད་ཆེན་པོའང་རང་འགགས་ཉིད་དུ་འགྱུར།",
    "ལུས་སྒྲིབས་འདར་ཞིང་༣༢ན་སྒུར་ནས་ཀུམ་ཀུམ་པོར་འདུག་པ།",
    "མ་བྱིན་ལེན་དང་རང་གཞན་གྱི།",
    "རབ་ཏུ་དོག་པ་མུན་ནག་འཐིབས་པོར་འདུག་པ་ཡི།",
    "འགྱུར་བའི་སྡུག་བསྔལ་བཞི་ཡི་སྣོད་དུ་གྱུར་ཅིང་རང་ཉིད་ནི།",
    "འཐབ་པ་མེད་ན་མི་འོང་དེ་ཙ་ན།",
    "འོ་ན་མིའི་འགྲོ་བ་མང་པོ་འདུག་པ་སྙམ་ན།",
    "དེ་རང་ལཊ་ཏེ་དལ་འབྱོར་རྙེད་དཀའ་འདི་བསམས་ཙ་ན་གཉིད་ལོག་ལོང་རང་མི་གདའ་ན་གསུང་ཟེར།",
    "དེ་ཤིན་ཏུ་མད་པར་གདའ།",
    "བདེ་བར་འདུག་པ་རིགས་མ་ཡིན།",
    "ཅི་ཕྱིར་བདག་ཡིད་བདེ་བར་འདུག།",
    "མི་རྟག་པ་གཏིང་ནས་སྐྱེས་པའི་ཚིགས་སུ་འདུག་ཤིན་ཏུ་བདེན་གསུང་།",
    "ན་བུསྶདྷི་མྨ་ཀྱིཉྩནྟ་མ་ཉེ་གནས་ཀྱིས་དབྱར་ཤིང་གྲབས་བྱེད་རིན་གདའ་ཞུས་པས།",
    "རྒྱུན་དུ་མས་བརྒྱན་པ་ཞིག་འདུག་པ་དེའི་ཁྲིའི་རྐང་པ་ལ་ཡི་དྭགས་བཞི་བཏགས་ཤིང་འདུག་གོ།",
    "ཁང་པ་དེ་ཉིད་དུ་ཉི་མ་མ་ཤར་གྱི་བར་དུ་འདུག་པ་དང་།",
    "མཐོང་ནས་ཁྲུས་བྱས་ཟན་བྱིན་ནས་ཉི་མ་ནུབ་ཀྱི་བར་དུ་འདུག་པ་དང་།",
    "བན་ཁ་༣ བ་བཐབསབབསམ་ས་ར་ནིསསཐཐབས་བས་ད་དད་ཤ་གཅིག་ཏུ་འདུག་གོ།",
    "ཅི་ཕྱིར་བདག་ཡིད་བདེ་བར་འདུག།",
    "ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག།",
    "དེར་ཕྱིན་ནས་བློན་པོ་ཞིག་ལ་གནས་ཏེ་འདུག་གོ།",
    "དེས་ཟོས་ནས་མཐའ་གཅིག་ཏུ་འདུག་གོ།",
    "དེ་ཟོས་ཏེ་མཐའ་གཅིག་ཏུ་འདུག་གོ།",
    "བ་སྐམ་པོ་བཅེར་ཏེ་གཙུག་ལག་ཁང་དེ་ལ་མེ་བཏང་ནས་དགེ་སློང་ནས་ཕྱུང་བས་བདག་ཅག་མི་བཟོད་པ་སྐྱེས་ནས་ཤིང་དང་རྩྭ་དང་ལྕི་ལག་ཁང་སྟོང་པ་ཞིག་ཏུ་འདུག་གོ།",
    "གཅིག་ཏུ་གྱུར་ཏེ་དགེ་སློང་དག་དྲི་མ་ཡོལ་གྱི་བར་དུ་བསྲེགས་ནས་དེ་ལག་ཁང་འབར་རབ་ཏུ་འབར་ཀུན་ཏུ་རབ་ཏུ་འབར་ནས་མེ་ལྕེ་འདུག་པ་དང་།",
    "འོད་བསྲུངས་ཆེན་པོས་དེའི་སེམས་ཤེས་ནས་རྩིག་དྲུང་ཞིག་ཏུ་འདུག་ནས་འཐུངས་པ་དང་།",
    "དུས་མཆོད་ལ་དམིགས་ནས་ཚོང་པ་མང་པོ་འོང་བར་འདུག་པ་དང་།",
    "བཙུན་པ་གཉེན་པོ་ཆུང་བའི་རིགས་རྣམས་ཆུད་ཟོས་འགྲོ་བར་འདུག་པས་བཅག་པ་ཡིན་གསུང་ངོ།",
