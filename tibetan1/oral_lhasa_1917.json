    "ཇི་ལྟ་ཞེ་ན་གང་ཞིག་ཡོངས་སུ་སྤྱོད་པ་དགག་ཅཔ་མཛད་པ་དེ་ལྟ་བུ་དེ་ཐོག་བསྲིངས་ཏེ་ཡོངས་སུ་སྤོང་བ་ནི་གུས་པ་དྲག་པོས་བསླབ་པའི་གནས་ཇི་ལྟར་བཅས་པ་དག་ལ་གུས་པར་བྱེད་པས་དེ་ལྟར་ཁ་ན་མ་ཐོ་བ་དང་བཅས་པའི་ཡོངས་སུ་སྤྱོད་པ་བཀག་པ་ཡིན་ནོ།",
    "ཁ་ན་མ་ཐོ་བ་མེད་པ་བཅོམ་ལྡན་འདས་ཀྱིས་ཇི་ལྟར་གནང་བ་དེ་ཡོངས་སུ་སྤྱོད་ཀྱི།",
    "གོས་འབུམ་རི་བ་ཡང་གནང་ངོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "ཟས་དེ་ཡང་ཟ་བ་ན་མ་ཆགས་ཤིང་རྒྱགས་པ་ལ་སོགས་པའི་དོན་དུ་མ་ཡིན་པར་ཟ་ན་དེ་ལྟ་ན་ཁ་ན་མ་ཐོ་བ་མེད་པའི་ཡོངས་སུ་སྤྱད་པ་བདག་ཉིད་དུབ་པ་ལ་སྦྱོར་བའི་མཐའི་གཉེན་པོར་འགྱུར་རོ།",
    "བསམས་པས་རྟོགས་པར་བྱེད་པའི་སྒོ་ནས་སོ།",
    "ཞེས་བྱ་བས་ནི་ཇི་ལྟ་ཇི་ལྟར་བསམས་པ་དེ་ལྟ་དེ་ལྟར་རྟོགས་པར་འགྱུར་རོ།",
    "དོན་དམ་པའི་བདེན་པ་ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་ལོ།",
    "རྣམ་པར་ཤེས་པའོ།",
    "ཐ་མར་བཀད་པར་བྱ་བ་དེས་བསྙེན་པར་རྫོགས་པ་རྣམས་ཁོ་ན་ལ་དྲང་བར་བྱ་བ་དང་།",
    "འཕགས་པ་འོད་སྲུངས་ཆེན་པོ་ལ་སོགས་པ་ཡང་དག་པར་སྡུད་པར་བྱེད་པ་རྣམས་ཀྱིས་གཞི་དེ་ལས་འཕགས་པ་ཀུན་དགའ་བོ་ལ།",
    "དེ་བཞིན་དུ་བསླབ་པའི་གཞི་གཞན་དག་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "དམིགས་པ་ཉེས་པར་བཟུང་ནས་དེའི་འོག་ཏུ་ཇི་ལྟར་འདི་རྙེད་པར་འགྱུར་ཞེས་དམིགས་པ་རྙེད་པ་ཡོངས་སུ་ཚོལ་བའི་སྐབས་ཡིན་ནོ།",
    "གལ་ཏེ་གཟུང་བའི་དོན་ལས་འཛིན་པའི་དོན་ཐ་མི་དད་པར་མཐོང་བའམ།",
    "ཞེས་བྱ་བ་ཇི་ལྟར་ཐ་མི་དད་པར་མཐོང་ཞེ་ན།",
    "འཛིན་པའི་དོན་ལས་གཟུང་བའི་དོན་ཐ་མི་དད་པར་མཐོང་ནའོ་ཞེས་བྱ་བ་ནི་གཟུང་བ་དང་འཛིན་པ་ནི་རྣམ་པར་ཤེས་པ་ཁོ་ནར་ཟད་ཀྱི་རྣམ་པར་ཤེས་པ་ལས་མ་གཏོགས་པ་བྱིས་པས་ཀུན་བརྟགས་པ་མིག་ལ་སོགས་པ་འཛིན་པའི་དོན་ནི་ཡོད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་སྟེ་། དེའི་ཕྱིར་དོན་དུ་སྣང་བ་ཐམས་ཅད་སེམས་ཁོ་ན་ཡིན་པར་བལྟའི།",
    "དོན་སེམས་ལས་གཞན་པར་ནི་མི་བལྟའོ།",
    "དེའི་ཚེ་ནི་འདིའི་གཟུང་བ་ལ་རྣམ་པར་གཡེང་བ་སྤངས་ལ་འཛིན་པའི་རྣམ་པར་རྟོག་པ་འབའ་ཞིག་བསྡུས་ཏེ།",
    "དེ་ནས་དེ་ནི་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་བླ་ན་མེད་པའོ་། རྣམ་པར་མི་རྟོག་ཡེ་ཤེས་དྲི་མ་མེད།",
    "ཅེས་འཆད་པར་འགྱུར་བ་ལྟ་བུ་ཡིན་ནོ།",
    "དེ་ལ་མཉམ་པར་གཞག་པའི་སེམས་ཀྱིས་ཞེས་བྱ་བ་ནི་སེམས་རྣམ་པར་གཡེང་བས་མ་ཡིན་པ་སྟེ།",
    "སེམས་མཉམ་པར་གཞག་པ་ཉིད་ནི་འདིར་རྣ་གཏོད་པ་ཡིན་ནོ།",
    "རྣ་བའི་རྣམ་པར་ཤེས་པ་རྣམ་པར་རྟོག་པ་མེད་པས་ནི་དོན་ངེས་པར་འཛིན་པར་བྱེད་ནུས་པ་མ་ཡིན་གྱི།",
    "ཞེས་བྱ་བ་ནི་གལ་ཏེ་གཟུང་བའི་དོན་ལས་འཛིན་པའི་དོན་ཐ་མི་དད་པར་མཐོང་བའམ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "བརྗོད་པ་དང་བཅས་པ་ནི་ཉེར་བསྡོགས་དང་བསམ་གཏན་དང་པོ་དང་བསམ་གཏན་ཁྱད་པར་ཅན་ལ་སོགས་པ་ནའོ།",
    "ཤེས་པ་དང་མཚུངས་པར་ལྡན་པའི་ཡིད་ལ་བྱེད་པ་ནི་རྣལ་འབྱོར་གྱི་རྒྱུ་དང་བཅས་པ་ཞེས་བྱ་བ་ནི་ཐོས་པའི་གནས་སྐབས་དང་།",
    "དེ་བཞིན་དུ་སྡོམ་གྱི་ཚིགས་སུ་བཅད་པ་ལ་སོགས་པ་ལས་དོན་རྒྱས་པར་བསྟན་པ་དག་ཀྱང་གཅིག་ཏུ་སྡོམ་པར་བྱེད་དོ།",
    "གཉེན་པོ་ཐོབ་ནས་ནི་ས་བོན་ཀུན་ནས་འཇོམས་པར་བྱེད་ལ།",
    "རྣམ་པར་གཡེང་བའི་གཉེན་པོ་ནི།",
    "དེ་ཉིད་ལ་རྣམ་པར་འབྱེད་པ་ཞེས་བྱ་བ་ནི་མ་བརྗེད་པའི་རྣམ་པར་འབྱེད་པ་གང་ཡིན་པའོ།",
    "མཐོང་བའི་ལམ་གྱི་གནས་སྐབས་ན་རྣམ་པར་འབྱེད་པ་གང་ཡིན་ཞེ་ན།",
    "དེ་ཁོ་ན་ཉིད་ཡང་དག་པར་རྟོགས་པ་གང་ཡིན་པའོ།",
    "ཚད་ཡོད་པར་གནས་པ་ནི་ཡི་གེ་རྣམས་སོ་ཞེས་བྱ་བ་ནི་འདི་ལྟར་ཡི་གེ་རྣམས་ནི།་",
    "དེ་ལྟར་ན་ཡི་གེ་རྣམས་ནི་ཚད་ཡོད་པར་གནས་པ་ཡིན་ནོ།",
    "ཡི་གེ་ནི་ཀུན་བརྟགས་པར་བྱ་བ་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་ཡི་གེ་གཅིག་ནི་མིང་མ་ཡིན་ལ།",
    "མིང་མེད་པར་ཡང་དོན་ཀུན་ཏུ་རྟོག་པར་མི་འགྱུར་བས་སོ།",
    "འཛིན་པར་སྣང་བ་དག་སྟེ།",
    "བརྗོད་པར་ནུས་ཀྱི་མ་ཡིན་ཞིང་སྤྲོས་པ་མེད་པའི་བདག་ཉིད་དེ་ཁོ་ན།",
    "དེ་དག་ནི་ཤིང་དང་བོང་བ་ལ་སོགས་པ་སྒྱུ་མའི་སྔགས་ཀྱིས་བཏབ་པ་ལྟ་བུ་ཡིན་པར་རིག་པར་བྱ་ལ།",
    "གཟུགས་ལ་སོགས་པ་ནི་སྒྱུ་མ་བྱས་པ་རྟ་དང་གླང་པོ་ཆེ་ལ་སོགས་པ་ལྟ་བུ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་གནས་གཞན་དུ་གྱུར་ན་གཉིས་སུ་འཁྲུལ་པ་མེད་པའི་ཕྱིར་ཡང་དག་པ་མ་ཡིན་པའི་ཀུན་ཏུ་རྟོག་པའི་དོན་ཡང་དག་པ་དམིགས་སོ་ཞེས་བྱ་བ་ནི་གཉིས་སུ་འཁྲུལ་པ་མེད་པའི་ཕྱིར་ཡོངས་སུ་གྲུབ་པའི་ངོ་བོ་ཉིད་དམིགས་པར་འགྱུར་རོ།་།",
    "དེ་ལྟར་ན་དེའི་དོན་ཡང་དག་པ་དམིགས་པར་འགྱུར་ལ།",
    "ཇི་ལྟར་སྒྱུ་མ་དེ་ལ་སྒྱུ་མ་བྱས་པ་གླང་པོ་ཆེ་ལ་སོགས་པའི་གཟུགས་དེའི་ངོ་བོར་ཏེ།",
    "ཇི་ལྟར་སྒྱུ་མ་ཡོངས་སུ་ཤེས་ནས་གླང་པོ་ཆེ་ལ་སོགས་པ་མི་སྣང་བའི་ཕྱིར་གླང་པོ་ཆེ་ལ་སོགས་པ་མེད་དོ་ཞེས་བྱ་བ་དེ་བཞིན་དུ་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཐོབ་ནས་གཉིས་པོ་མི་སྣང་བའི་ཕྱིར་མེད་དོ་ཞེས་བྱའོ།",
    "ཞེས་བྱ་བ་ནི་སྒྱུ་མའི་གླང་པོ་ཆེ་ལྟ་བུ་ཡོད་པ་ནི་མེད་པར་མི་འདོད་དེ།",
    "ཞེས་བྱ་བ་ནི་བྱིས་པ་རྣམས་ཀྱིས་ཡང་དག་པ་ཉིད་དུ་ཀུན་བརྟགས་པའི་གླང་པོ་ཆེ་ལ་སོགས་པ་མེད་པ་གང་ཡིན་པ་དེ་ནི་དོན་དམ་པར་དཔྱད་ན་ཡོད་པ་ཉིད་མ་ཡིན་ནོ།",
    "ཡོད་མེད་ཁྱད་པར་མེད་པའང་བརྗོད།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་ལས་ཇི་སྐད་དུ།",
    "མི་དམིགས་མཉམ་པར་ཤེས་པར་བྱ།",
    "རིམ་པ་འདིས་ན་ཡོད་པ་དང་མེད་པ་དག་ཀྱི་ཁྱད་པར་མེད་པར་མཐོང་སྟེ།",
    "ཅེས་བྱ་བ་ནི་ཡང་དག་པ་མ་ཡིན་པའི་ཀུན་ཏུ་རྟོག་པའི་ངོ་བོ་ཉིད་ལ་ཀུན་རྫོབ་ཏུ་གཟུགས་ལ་སོགས་པ་ཡོད་པ་ཉིད་དུ་བརྗོད་པར་བྱ་སྟེ།",
    "དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་ལས་ཇི་སྐད་དུ།་",
    "དོན་དམ་པར་ནི་མ་ཡིན་ནོ།",
    "གཉིས་ཀྱི་དངོས་པོ་མེད་པ་ཉིད་གང་ཡིན་པའོ་ཞེས་བྱ་བ་ནི་གཉིས་ཀྱི་དངོས་པོ་མེད་པ་གང་ཡིན་པ་དེ་ནི་དོན་དམ་པར་ཡོད་པ་ཉིད་མ་ཡིན་ནོ།",
    "ཕྱི་རོལ་གྱི་དོན་ནི་མེད་དོ་ཞེས་ཕྱི་རོལ་གྱི་དོན་རྣམ་པར་རིག་པས་སེམས་ཙམ་དུ་རྟོགས་པར་འགྱུར་ཏེ།",
    "དེའི་ཚེ་ཡོད་པ་ལ་ཡོད་པར་རིག་ནས་སྐུར་པ་འདེབས་པར་མི་བྱེད་དོ།",
    "དེ་ལྟར་ན་མེད་པ་ལ་མེད་པར་རིག་ནས་སྒྲོ་འདོགས་པར་མི་བྱེད་དོ།",
    "ཇི་ལྟར་ན་དེ་དག་ཁྱད་པར་མེད་པ་ཡིན་ཞེ་ན།",
    "ཕྱི་རོལ་གྱི་གཟུགས་ལ་སོགས་པ་ཀུན་བརྟགས་པའི་བདག་ཉིད་ཀྱིས་མེད་པ་གང་ཡིན་པ་དེ་ཉིད་རྣམ་པར་རིག་པ་ཙམ་ཡིན་ཏེ།",
    "ཞེས་བྱ་བ་ནི་བྱིས་པ་རྣམས་ཀྱི་རྣམ་པར་རིག་པ་འདི་ནི་རྣམ་པ་གཉིས་སུ་འབྱུང་སྟེ།",
    "དེ་ལ་འཁྲུལ་པའི་རྒྱུ་ནི་གཟུགས་ཀྱི་རྣམ་པར་རིག་པ་ཡིན་པར་འདོད་དེ།",
    "ཡོད་པ་དང་མེད་པ་དེ་དག་ཀྱང་ཁྱད་པར་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ིབས་ན་སྒྱུ་མ་ལྟ་བུ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་དེ་ལ་གླང་པོ་ཆེའི་གཟུགས་ཡོད་པ་གང་ཡིན་པ་དེ་ཉིད་གླང་པོ་ཆེ་ཉིད་ལ་སོགས་པར་མེད་པ་ཡིན་ལ།",
    "དེ་ལྟ་བས་ན་སྒྱུ་མ་ལ་ཡོད་པ་དང་མེད་པ་ཉིད་དུ་ཁྱད་པར་མེད་དེ།",
    "མེད་པ་ཉིད་གང་ཡིན་པ་དེ་ཉིད་དོན་དམ་པར་རོ།",
    "ཡང་དག་པ་མ་ཡིན་པའི་ཀུན་ཏུ་རྟོག་པའི་ངོ་བོ་ཉིད་དེ་ལ་རྣམ་པར་ཤེས་པའི་གཉིས་སུ་སྣང་བ་གང་ཡིན་པ་དེ་ནི་དེ་ལ་ཡོད་ལ།",
    "རྣམ་པར་ཤེས་པ་སྣང་བ་གསལ་ཏེ་ཡང་དག་པ་ཉིད་དུ་གཟུགས་ལ་སོགས་པའི་དོན་གྱིས་གཉིས་ཀྱི་ངོ་བོ་གང་ཡིན་པ་དེ་ནི་དེ་ལ་མེད་དོ།",
    "དེ་ལྟར་ན་ཡོད་པ་དང་མེད་པ་དག་ཁྱད་པར་མེད་པ་ཡིན་ནོ།",
    "དེ་བཞིན་ཉིད་ཀྱི་ཕྱིར་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པ་དང་།",
    "དེ་ལ་སྤྱིའི་རྣམ་པར་གནས་པའི་ཕྱིར་མིང་ལ་གནས་པ་ཡིན་ནོ།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་རྙེད་ནས་མིང་ལ་གནས་པར་འགྱུར་ཏེ།",
    "གནས་ཡོངས་སུ་གྱུར་པ་ལ་ཁེངས་པ་དང་ཡོན་པོ་ཉིད་དུ་བྱེད་པའི་རྣམ་པར་རྟོག་པ་དེ་དག་ཉིད་ཀྱང་གཉིས་སུ་སྣང་བར་མི་འཇུག་གོ།",
    "རྣམ་པར་རིག་པ་ཙམ་ཡོངས་སུ་ཚོལ་བ་ཞེས་བྱ་བ་ལ།",
    "སེམས་དེ་ཡང་འདིར་མཚུངས་པར་ལྡན་པ་དང་བཅས་པར་བལྟ་བར་བྱའོ་ཞེས་བྱ་བའི་ཕྱིར་འདིར་ནི་སེམས་ལས་བྱུང་བ་རྣམས་ཀྱང་གཟུང་ངོ།",
    "སེམས་ཙམ་པོ་འདི་གཟུང་བར་སྣང་བ་དང་འཛིན་པར་སྣང་བ་དང་གཉིས་སུ་སྣང་བར་འདོད་དེ།",
    "སེམས་ལ་འདོད་ཆགས་ལ་སོགས་པ་དང་མཚུངས་པར་ལྡན་པར་མི་འདོད་པ་ཡང་མ་ཡིན་ནོ།",
    "འདོད་ཆགས་ལ་སོགས་པའི་དམིགས་པས་རྣམ་གྲངས་ཀྱི་འདོད་ཆགས་ལ་སོགས་པར་སྣང་བའི་སེམས་སྐྱེ་བ་གང་ཡིན་པ་དེ་ནི་སེམས་ཉིད་སེམས་ལས་བྱུང་བ་རྣམས་དང་ལྷན་ཅིག་སྐྱེ་བ་ཡིན་གྱི་འདོད་ཆགས་ལ་སོགས་པ་ནི་མ་ཡིན་ནོ་ཇི་ལྟར་གཟུགས་ལ་སོགས་པ་དོན་གཞན་དུ་གྱུར་པ་དམིགས་པ་ཉིད་དུ་ཡོད་པ་ིམ་ཡིན་པ་ལྟར་འདོད་ཆགས་ལ་སོགས་པ་ཡང་དེ་དང་འདྲ་སྟེ།",
    "སེམས་ལས་བྱུང་བ་བདག་མེད་པར་གང་ཞིག་ཅིག་ཅར་སྣ་ཚོགས་ཀྱི་རྣམ་པ་ཉིད་དུ་འགྱུར་རོ།",
    "མཚན་གཞི་ནི་མཚོན་པར་བྱ་བ་ཡིན་པས་ན་ིམཚན་གཞིའོ།",
    "འདི་ལྟར་དེས་མཚན་གཞི་དང་མཚན་ཉིད་དེ་མཚོན་པར་བྱེད་དོ་ཞེས་འཆད་པར་འགྱུར་རོ།་།",
    "འཛིན་པར་སྣང་བ་གཟུང་བ་ིསྟེ།",
    "དེ་ལ་སེམས་ནི་རྣམ་པར་ཤེས་པ་དང་གཟུགས་སོགས་ཞེས་བྱ་ིབས་སོ།",
    "དེའི་རྣམ་པར་རིག་པ་རྟག་ཏུ་དེ་བཞིན་དུ་འཇུག་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་ནམ་མཁའ་ལ་སོགས་པའི་རྣམ་པར་རིག་པ་ལ་ཡ་འགྱུར་བ་མེད་པས་རྟག་པའོ།",
    "བརྗོད་པའི་དོན་གྱི་འདུ་ཤེས་མེད་པར་ཞེས་བྱ་བ་ནི་བྱིས་པ་ཆུང་ངུ་ལ་སོགས་པ་ལ་བུམ་པ་ཞེས་བྱ་བའི་སྒྲས་ནི་བརྗོད་པར་བྱ་བའི་དོན་ལྟོ་ཡངས་པ་དང་།",
    "བརྗོད་པའི་དོན་གྱི་འདུ་ཤེས་མེད་བཞིན་དུ་ཅི་ཞིག་ཏུ་རྣམ་པར་རྟོག་པར་བྱེད་དོ།",
    "དེ་ལྟར་ན་ཐ་སྙད་ལ་མཁས་པའམ་ཐ་སྙད་ལ་མི་མཁས་པས་བརྟག་པར་བྱ་བ་བུམ་པ་ལ་སོགས་པ་དོན་གང་ཡིན་པ་དང་རྒྱུ་གང་ལས་ཡིན་པ་༧ཞེས་བྱ་བ་ནི་བག་ཆགས་གང་ལས་ཡིན་པས་ཏེ།",
    "དེ་དག་ནི་ཀུན་བརྟགས་པའི་མཚན་ཉིད་ཡིན་པར་རིག་པར་བྱའོ།",
    "མིང་དོན་གྱི་ངོ་བོ་ཉིད་ཡིན་པར་ཀུན་རྟོག་ཀྱི་པར་བྱེད་པ་སྟེ།",
    "མིང་དོན་གྱི་རང་བཞིན་ཡིན་པར་རྟོག་པར་བྱེད་ན།",
    "གནས་སུ་སྣང་བ་ཞེས་བྱ་བ་ནི་ས་ལ་སོགས་པར་སྣང་བ་སྟེ།",
    "༢ ༢ ༥ཀུན་གཞི་རྣམ་པར་ཤེས་པ་གནས་ཀྱི་རྣམ་པར་རིག་པ་ལ་དེར་སྣང་བ་ཉིད་དུ་སྟོན་ཏོ་། དོན་དུ་སྣང་བ་ཞེས་བྱ་བ་ནི་གཟུགས་ལ་སོགས་པ་ཡུལ་རྣམས་སོ།",
    "སེམས་མིང་ལ་གནས་པའི་ཕྱིར་བསྒོམས་པ་ལས་བྱུང་བའི་ཤེས་པས་དེ་རྙེད་པར་རིག་པར་བྱ་སྟེ།",
    "རྣལ་འབྱོར་གྱི་ས་དེས་མཚན་གཞི་ལྔ་དང་མཚན་ཉིད་དེ་མཚོན་པར་བྱེད་དོ།",
    "མཚོན་པ་ཤེས་རབ་ཀྱི་ངོ་བོ་ཉིད་དེས་མཚོན་གཞི་དང་མཚན་ཉིད་དེ་མཚོན་པར་བྱེད་དེ།",
    "ཐོས་པ་དང་བསམས་པ་དང་བསྒོམས་པ་ལ་སོགས་པའི་རིམ་གྱིས་ཡང་དག་པར་ཤེས་པར་བྱེད་དོ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "མཉམ་པ་ཉིད་དུ་འགྱུར་བ་ནི་ཟག་པ་མེད་པའི་དབྱིངས་ན་ཞེས་བྱ་བ་ནི་ཟག་པ་མེད་པའི་དབྱིངས་ན་དམིགས་པར་བྱ་བ་དང་།",
    "དམིགས་པར་བྱེད་པ་མཉམ་པ་དང་མཉམ་པའི་ཡེ་ཤེས་ཐོབ་པའི་ཕྱིར་འགྱུར་རོ།",
    "གཟུགས་ལ་སོགས་པ་དོན་གྱི་རྣམ་པར་རིག་པ་དང་མིག་ལ་སོགས་པ་ལུས་ཀྱི་རྣམ་པར་རིག་པ་གཞན་དུ་གྱུར་པ་ནི་ཟག་པ་མེད་པའི་དབྱིངས་ཡིན་ནོ།",
    "ཡིད་དང་འཛིན་དང་རྣམ་པར་རྟོག།",
    "འབྱོར་པ་དམ་པ་ཐོབ་པར་འགྱུར།",
    "འབྱོར་པ་དམ་པ་ཐོབ་པར་འགྱུར།",
    "རྣམ་པར་རྟོག་པ་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའོ།",
    "འབྱོར་པ་དམ་པ་འཐོབ་པར་འགྱུར།",
    "དེ་ཁོ་ན་ཉིད་རྣམ་པར་རིག་པ་ཙམ་ཞེས་བྱ་བ་ནི་ཇི་ལྟར་རྣམ་པར་རིག་པ་ཙམ་དེ་ཁོ་ན་ཉིད་ཡིན་ཞེ་ན།",
    "འདི་ལྟར་རྣམ་པར་རིག་པ་ཙམ་ཉིད་ལ་ཞུགས་ན་བཟོད་པའི་གནས་སྐབས་ན་གཟུང་བའི་དོན་མི་དམིགས་པར་འགྱུར་ལ།",
    "དོན་མེད་ན་ནི་༧དེའི་རྣམ་པར་རིག་པ་མི་མཐོང་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་གཟུང་བའི་དོན་མེད་ན་འཛིན་པ་ཡང་མི་མཐོང་བས་སོ།",
    "ལེན་ཅེས་བྱ་བའི་སྐད་ཀྱི་ིདབྱིངས་འདི་ནི་ལེན་པར་བྱེད་པའི་དོན་ལས་འབྱུང་ངོ།",
    "༢ ༢༩གསུམ་པོ་ལ་ིའདི་དང་སྦྱར་བར་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "འདུས་བྱས་ཀྱི་མཚན་ཉིད་ནི་གསུམ་སྟེ།",
    "འདུས་བྱས་ཀྱི་མཚན་ཉིད་གསུམ་པོ་འདི་ནི།",
    "འདི་ནི་འདུས་བྱས་ཀྱི་མཚན་ཉིད་གཉིས་པ་འཇིག་པ་ཡིན་ནོ།",
    "འདི་ན་འདུས་བྱས་ཀྱི་མཚན་ཉིད་གསུམ་པ་ཡིན་ནོ།",
    "བདེ་བ་དང་གཙང་བ་དང་བདག་ཏུ་འཛིན་པའམ།",
    "དེ་དག་ཡོད་པར་གྱུར་ན་ནི།",
    "ཡོངས་སུ་གྲུབ་པ་ལ་ནི་གཞན་དུ་འགྱུར་བ་མེད་པར་བཟོད་པའི་ཕྱིར་ཏེ།",
    "འདུས་མ་བྱས་ཡིན་པའི་ཕྱིར་དེ་ལ་གཞན་དུ་འགྱུར་བར་སྐྱེ་བ་མེད་དོ།",
    "རྣམ་པར་གྲོལ་བ་མཚུངས་པའི་ཕྱིར་རོ།",
    "ཕྱོགས་ཙམ་ཐོབ་པར་བྱ་བའི་ཕྱིར་ཞེས་བྱ་བ་ནི་དེའི་ཆེད་ཀྱི་བཞི་པ་ཡིན་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་སྐྱེ་བ་དེ་ནི་བསམ་གྱིས་མི་ཁྱབ་པར་བསྒྱུར་བ་ཡིན་ནོ།",
    "ཝི་༡༣༩བའི་དོན་མ་བྱས་པ་སློབ་པ་གང་ཡིན་པ་དེ་ཞེས་བྱ་བ་ནི་སློབ་པ་དང་འདོད་ཆགས་དང་མ་བྲལ་བ་སྟེ།",
    "དེ་ནས་སྔོན་གོམས་པའི་སྟོབས་ཀྱིས་སློབ་དཔོན་མེད་པར་འཕགས་པའི་ལམ་མངོན་སུམ་དུ་བྱེད་ཅིང་བསམ་གཏན་དག་སྐྱེད་པར་བྱེད་དོ།",
    "ཚོགས་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཕྱིར་སྤྲུལ་པ་གཞན་དང་གཞན་དག་ཀྱང་སྤྲུལ་ཏེ།",
    "མཐུ་རྣམ་པ་བཞི་ཡང་དག་པར་མཐོང་ནས་དགའ་བའི་ཕྱིར་ཞེས་བྱ་བ་ལ།",
    "སྙན་པར་སྨྲ་བ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་སྟོན་པ་ཁོ་ན་ཡིན་ནོ།",
    "དོན་སྤྱོད་པ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡང་དག་པར་ལེན་དུ་འཇུག་པའོ།",
    "དོན་མཐུན་པ་ཉིད་ནི་གང་ལ་གཞན་ཡང་དག་པར་ལེན་ཏུ་འཇུག་པ་དེ་ལ་བདག་རྗེས་སུ་འཇུག་པའོ།",
    "སྦྱིན་པ་ལ་སོགས་པ་མ་བྱས་པའམ།",
    "ལོག་པར་བྱས་པ་དག་ལ་ཞེས་བྱ་བ་ནི་མི་བྱེད་པ་ནི་སྦྱིན་པ་ལ་སོགས་པ་ལ་མི་འཇུག་པ་གང་ཡིན་པའོ།",
    "གང་ལ་འཇུག་པ་དེ་ཡང་ཡོངས་སུ་རྫོགས་པར་མི་བྱེད་པའོ།",
    "ལོག་པར་བྱེད་པ་ནི་བཅོས་པ་བྱེད་པ་གང་ཡིན་པའོ།",
    "ངོ་ཚ་ནས་ནི་འཇུག་པ་དང་ལྡོག་པར་བྱ་བའི་ཕྱིར་ཡུན་མི་རིང་བར་འགྱོད་པ་བྱེད་དོ་ཞེས་བྱ་བ་ལ།་",
    "དེ་བས་ན་སྦྱིན་པ་ལ་སོགས་པ་མ་བྱས་པའམ།",
    "རྫོགས་པར་མ་བྱས་པ་གང་ཡིན་པ་དེ་ལ་ནི་རྫོགས་པར་བྱ་བའི་ཕྱིར་རྟག་ཏུ་བྱ་བ་དང་གུས་པར་བྱས་ཏེ་འཇུག་གོ།",
    "སྦྱིན་པ་ལ་སོགས་པ་ལོག་པར་བྱས་པ་དག་ལ་ནི་ཕྱིན་ཆད་ལོག་པར་མི་འཇུག་གོ་ཞེས་ལོག་པར་བྱེད་པ་ལྡོག་པར་བྱེད་དོ།",
    "སྦྱིན་པ་ལ་སོགས་པ་སེར་སྣ་ལ་སོགས་པའི་གཉེན་པོ་ལ་ནི་ཡོན་ཏན་ཉིད་དུ་སོ་སོ་ཡང་དག་པར་རིག་གོ།",
    "འདི་དང་ལྡན་པའི་ཡིད་ལ་བྱེད་པ་ནི་དོན་ཆེན་པོ་ཡིན་ནོ་། རྣམ་པར་མི་རྟོག་པ་འདོད་པ་ཡིད་ལ་བྱེད་པ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་དོན་དུ་ཐབས་ལ་མཁས་པ་འདོད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པར་བྱ་བའི་ཐབས་ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཏེ།",
    "དེ་ནས་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཐོབ་ནས་ནི་རྣམ་པར་མི་རྟོག་པ་ཁོ་ནར་སྦྱིན་པ་ལ་སོགས་པ་འཇུག་པར་འགྱུར་རོ།",
    "མེད་པ་ལ་ཡོད་པར་འཛིན་པ་ཞེས་བྱ་བ་ནི་བདག་མེད་པའམ།",
    "དེ་ལ་བྱིས་པ་རྣམས་ཆད་པའི་འཇིགས་པས་ཡོན་ཏན་དང་ལྡན་པ་མ་ཡིན་པར་འཛིན་ཏོ།",
    "ཐམས་ཅད་ཅེས་བྱ་བའི་སྒྲ་ཕྱོགས་གཅིག་བརྗོད་པ་ཡིན་པར་བལྟའོ།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་རྣམས་ཏེ།",
    "ཐམས་ཅད་ཅེས་བྱ་བའི་སྒྲ་འདིར་ནི་རིལ་བརྗོད་པ་ཡིན་པར་བལྟའོ།",
    "མ་རབས་བཀྲེན་པ་གདོལ་བའི་བུ་ལ་སོགས་པས་ལན་ཅིག་མ་ཡིན་པར་གནོད་པ་བྱས་ཀྱང་བུ་གཅིག་པ་ལ་བྱམས་པ་བཞིན་དུ་བཟོད་པ་ངོ་མཚར་ཆེའོ།",
    "བདག་ལ་བྱམས་པ་ཡིན་པས་འདི་དག་ནི་སྦྱིན་པ་ལ་སོགས་པ་རབ་ཏུ་སྦྱིན་པར་བྱའོ།",
    "བྱམས་པ་མ་ཡིན་པ་འདི་དག་ལ་ནི་རབ་ཏུ་སྦྱིན་པར་མི་བྱའོ་སྙམ་དུ་སེམས་པའི་མ་སྙོམས་པར་འགྱུར་བ་མེད་དོ།",
    "བརྩོན་འགྲུས་ཀྱིས་ནི་དོན་བྱེད་པར་འགྱུར་བ་ཉིད་ཡིན་ནོ།",
    "བསམ་གཏན་གྱིས་ནི་མཐུའི་ཁྱད་པར་དང་ལྡན་པའི་ཕྱིར་དང་བར་བྱེད་པ་ཡིན་ནོ།",
    "ས་ལ་ཁྱད་པར་འགྲོ་བ་དང་།",
    "ཡང་དག་པའི་སྦྱོར་བ་ཡིད་ལ་བྱེད་པ་ནི་ཕྱིན་ཅི་མ་ལོག་པར་བསྒྲུབ་པ་ཡིད་ལ་བྱེད་པ་དང་།",
    "ཚུ་རོལ་དུ་མི་གནས་པའི་ཡིད་ལ་བྱེད་པས་དེ་སྟོན་པར་བྱེད་དེ།",
    "ཡང་དག་པའི་སྦྱོར་བ་ཡིད་ལ་བྱེད་པ་ནི་དེ་ལྟ་བུ་ཡིན་པར་རིག་པར་བྱའོ།",
    "དང་དུ་མི་ལེན་པ་ཡིད་ལ་བྱེད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་ན་དང་དུ་ལེན་པར་མི་བྱེད་ཅེ་ན།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པ་ལུང་བསྟན་པ་ཐོབ་པར་དགའ་བ་ཡིད་ལ་བྱེད་པ་དང་ཞེས་བྱ་བ་ནི།",
    "དགའ་བ་ཡིད་ལ་བྱེད་པ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཡོངས་སུ་རྫོགས་པ་ལུང་བསྟན་པ་ཐོབ་པར་བྱ་བའི་ཆེད་དུ་སྟེ།",
    "དུས་འདི་སྲིད་༤ཅིག་ན་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་ཡོངས་སུ་རྫོགས་པར་འགྱུར་རོ་ཞེས་དེ་ལྟར་ལུང་སྟོན་པའི་ཕྱིར་རོ།",
    "ཝི་༡༣༩༢༤༨པའོ་།་ཞེས་བྱ་བ་ནི་བདག་ནམ་ཞིག་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་ངེས་པའི་ས་ལ་གནས་པ་འཐོབ་པར་འགྱུར་བ་གང་ཡིན་པ་དེར་འགྱུར་སྙམ་དུ་དེ་ལྟར་དགའ་བ་ཡིད་ལ་བྱེད་པ་བསྐྱེད་པའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་ངེས་པར་འགྱུར་བ་རྣམ་པ་དྲུག་འཆད་པར་འགྱུར་བ་ལྟ་བུ་ཡིན་ནོ།",
    "ཕུན་སུམ་ཚོགས་པ་ངེས་པར་གྱུར་པ་ནི་ཅིརྟག་ཏུ་ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པ་རྒྱ་ཆེན་པོ་ཐོབ་པའི་ཕྱིར་རོ།",
    "སྐྱེ་བ་ལ་སོགས་པ་ངེས་པར་འགྱུར་བ་ནི་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་སྐྱེ་བ་ཡོངས་སུ་འཛིན་པ་ལ་སོགས་པ་ཡིན་པར་རིག་པར་བྱའོ།",
    "གདོན་མི་ཟ་བར་ཕ་རོལ་ཏུ་ཕྱིན་པ་རྣམས་ལ་གནས་པར་བྱ་དགོས་སོ།",
    "ཁམས་ནི་བརྟས་པར་བྱེད་པ་ཡིན།",
