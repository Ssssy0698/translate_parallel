    "རྒྱ་ཆེན་པོའི་རྣམ་གྲངས་ཡིན་པར་བལྟ་བར་བྱ་སྟེ།",
    "དེས་དང་པོར་རང་དང་གཞན་གྱི་དོན་ཕུན་སུམ་ཚོགས་པ་ཐོབ་པའི་ཕྱིར་རོ་ཞེས་འཆད་པར་གྱུར་ཏེ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ས་དང་པོ་ལ་སྡུག་བསྔལ་གྱི་ཕུང་པོ་ཉེ་བར་ཞི་བས་འཇིགས་པ་ལྔ་ལས་ཡང་དག་པར་འདས་པ་ཡིན་ཏེ།",
    "སྲིད་པ་དང་ཞི་བ་དག་ལས་རྣམ་པར་གྲོལ་བ་ཞེས་བྱ་བ་ལ།",
    "སྲིད་པ་ལས་རྣམ་པར་གྲོལ་བ་ནི།",
    "ཞི་བ་ལས་རྣམ་པར་གྲོལ་བ་ནི་འདི་ལྟར་ཉན་ཐོས་བཞིན་དུ་མྱ་ངན་ལས་འདས་པ་ལ་གཞོལ་བ་མ་ཡིན་པའོ།",
    "ཕྲ་བའི་ཁྱད་པར་རོ།",
    "པས་དེ་ལས་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་ཆེན་པོ་ཞེས་བྱ་བ་ནི་སྒྲར་སྦྱར་རོ།",
    "ས་བོན་མེད་པར་ཡང་འབྲས་བུ་མ་མཐོང་སྟེ།",
    "ཀེ་རྒྱུར་ཡང་དཔག་ཚད་ཙམ་ཞིག་ཡོད་པར་གྱུར་ལ།",
    "བ་རུ་རའི་ཕུང་པོ་དེ་ནི་མྱུར་བ་ཁོ་ནར་ཟད་པ་དང་ཡོངས་སུ་གཏུགས་པར་འགྱུར་གྱི།",
    "རང་བཞིན་དུ་གནས་པའི་རིགས་ནི་ཡང་དག་པར་བསྒྲུབས་པ་གང་ཡིན་པ་སྟེ།",
    "ཡང་དག་པར་བསྒྲུབས་པ་ནི་རྟེན་པའི་ངོ་བོ་ཉིད་ཡིན་ནོ།",
    "འབྲས་བུའི་དངོས་པོར་མེད་དོ་ཞེས་བྱ་བའི་རང་བཞིན་གྱི་རིགས་དེའི་འབྲས་བུ་ནི་ཡང་དག་པར་བསྒྲུབས་པའི་རིགས་ཡིན་ནོ།",
    "འདི་ལྟར་དེ་དག་ལ་བརྟེན་ནས་འབྲས་བུར་གྱུར་པ་སྟོབས་དང་མི་འཇིགས་པ་ལ་སོགས་པ་ཡོན་ཏན་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་རོ།",
    "ཡང་ན་གསེར་འོད་གསལ་བ་ཁ་ཅིག་བསྲེགས་ན་ཁ་དོག་ངན་པར་འགྱུར་བས་གང་ལ་བསྲེགས་ཀྱང་ཁ་དོག་ངན་པར་འགྱུར་བ་མེད་པ་དེ་ནི་དྲི་མ་མེད་པ་ཞེས་བྱའོ།",
    "ལ་ལ་གཅིག་ཏུ་ཉེས་པར་སྤྱོད་ངེས་ཡོད།",
    "འོག་ནས་རིགས་དེ་རྩ་བ་ཡིན་ནོ་ཞེས་འཆད་པར་འགྱུར་རོ།",
    "འོན་ཀྱང་དེ་ནི་བདེ་བ་ཆེན་པོ་ཐོབ་པར་བྱ་བའི་ཕྱིར་དང་།",
    "སེམས་བསྐྱེད་པ་རྣམ་པར་གཏན་ལ་དབབ་པ་ཞེས་བྱ་བ་ནི།",
    "སེམས་བསྐྱེད་པ་དྲི་བ་སྔོན་དུ་བཏང་བའི་རྣམ་པར་གཏན་ལ་དབབ་པ་ལ་སེམས་བསྐྱེད་པ་རྣམ་པར་གཏན་ལ་དབབ་པ་ཞེས་བྱའོ།",
    "དེ་དང་མཚུངས་པར་ལྡན་པ་སེམས་པའི་ཁྱད་པར་གྱི་མཐར་ཐུག་པ་ནི་ས་ཡིན་པར་བརྗོད་དོ།",
    "མ་མའི་བྱེ་བྲག་ལས་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ལ།",
    "སྐྱེ་བ་ིརྒྱ་ཆེ་བ་ལ་སོགས་པ་དོན་དྲུག་སྔར་བསྟན་པ་དེ་དག་ལས་སྐྱེ་བ་བཀར་ཏེ་ས་བོན་ལ་སོགས་པའི་ཁྱད་པར་གྱིས་ཁྱད་པར་དུ་སྟོན་ཏོ།",
    "བསྙེན་བཀུར་ལེགས་པ་ཉིད་དང་ལེགས་པ་ཉིད་མ་ཡིན་པར་བྱེད་པ་དག་གོ།",
    "རྣམ་པར་ཤེས་པ་ལ་རྟོན་པར་གྱུར་ན་ཆུད་ཟ་བའི་རྒྱུ་ཡིན་ནོ།",
    "ཆུ་འཛིན་ཅིང་མི་ཟད་པར་འབྱིན་པ་དང་།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་དང་།",
    "བས་འཇིགས་པ་མེད་པའི་ཕྱིར་སེམས་བསྐྱེད་པ་བསྔགས་པར་ཚིགས་སུ་བཅད་པ་ཞེས་བྱ་བ་ནི་སེམས་བསྐྱེད་པ་དང་དུས་མཉམ་པ་ཉིད་ན་སེམས་དེ་འགྲོ་བ་ཐམས་ཅད་ཀྱིས་བསྔགས་པར་བྱ་བ་ཡིན་ཏེ།",
