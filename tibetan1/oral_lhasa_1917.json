    "ཕྱི་རོལ་པའི་ཡོངས་སུ་སྨིན་པ་ལས་ཁྱད་པར་དུ་འཕགས་པའི་ཕྱིར་མཆོག་ཏུ་སྨིན་པར་བྱེད་པ་ནི་རབ་ཏུ་སྨིན་པར་བྱེད་པའོ་ཞེས་བྱ་བ་ནི་མུ་སྟེགས་ཅན་གྱི་ཡོངས་སུ་སྨིན་པ་ལ་ཡོངས་སུ་སྨིན་པ་ཁྱད་པར་དུ་འཕགས་པ་ཡིན་ནོ།",
    "འཚམ་པར་སྨིན་པར་བྱེད་པ་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་ལ་སོགས་པ་སྤྱོད་པ་རྣམས་ལ་མི་སྡུག་པ་ལ་སོགས་པ་སྟོན་པས་སོ།",
    "རྟོགས་པས་སྨིན་པར་བྱེད་པ་ནི་རྟོགས་པ་སྨིན་པར་བྱེད་པའོ་ཞེས་བྱ་བ་ནི་ཆེད་ཀྱི་དོན་དུ་གསུངས་པ་ཡིན་ཏེ།",
    "ཡི་གེའི་ཚོགས་རྣམས་ཀྱི་དོན་ཕྱིན་ཅི་མ་ལོག་པར་སྟོན་པ་སྟེ།",
    "དེ་ལྟར་གཉེན་བཤེས་རྣམས་ཀྱང་གཉེན་པ་དག་ལ་ལེགས་པར་མི་གནས་སོ་ཞེས་དེ་སྐད་དུ་སྦྱར་བར་བྱའོ།",
    "འཇིག་རྟེན་བདག་ལ་བྱམས་པ་ནི་བདག་ཉིད་ལ་ཕན་པ་མ་ཡིན་པ་དང་བདེ་བ་མ་ཡིན་པར་སྦྱར་རོ་ཞེས་བྱ་བ་ནི་རྨོངས་པ་ནི་བདག་ཉིད་བདེ་བར་བྱའོ་སྙམ་ནས་མ་བྱིན་པར་ལེན་པ་ལ་སོགས་པ་ལ་རབ་ཏུ་སྦྱར་རོ།",
    "དེའི་མ་བྱིན་པར་ལེན་པ་ལ་སོགས་པ་དེ་ཡང་ཚེ་ཕྱི་མ་ལ་ངན་འགྲོར་ཁྲིད་པར་བྱེད་པ་ཡིན་པས་ཕན་པ་མ་ཡིན་པར་འགྱུར་ཏེ།",
    "གཉེན་བཤེས་ཀྱི་བསམ་པ་བས་ཁྱད་པར་དུ་འཕགས་པའི་བསམ་པས་བཀྲེས་པ་དང་།",
    "ཚ་བ་ལ་སོགས་པ་སྲོག་ལ་འབབ་པའི་སྡུག་བསྔལ་ཡང་བརྩིས་ལ་མ་ཆགས་པར་གོ་ཆ་དང་།",
    "མཉམ་པར་སྦྱིན་པའི་ཡོན་ཏན་ངོམས་པར་མི་འགྱུར་རོ་ཞེས་བྱ་བ་སྟེ།",
    "མི་མཉམ་པ་མེད་པར་སྦྱིན་པ་ཉིད་དང་།",
    "ངོམས་པ་མེད་པར་སྦྱིན་པ་ཉིད་གང་དག་ཡིན་པ་དེ་དག་ནི་སྦྱིན་པའི་ཡོན་ཏན་ཡིན་ནོ།",
    "ཡང་དག་པར་བླང་བ་ལེན་པ་གང་ཡིན་པ་དེ་དུས་ཐམས་ཅད་དུ་རྗེས་སུ་འཇུག་ཅིང་།",
    "པ་ཡོངས་སུ་སྨིན་པའི་འོག་ཏུ་ཐམས་ཅད་མཁྱེན་པ་ཉིད་དེ།",
    "བདག་དང་གཞན་ལ་ཕན་པར་བྱ་བའི་ཕྱིར་ཏེ།",
    "ཏི་༡༣༩ཀྱི་ཆར་ཆེན་པོ་འབེབས་པས་ན་ཞེས་བྱ་བར་འདིར་ཚིག་རྣམ་པར་སྦྱར་བར་རིག་པར་བྱའོ་ཞེས་བྱ་བ་ནི་ཚིགས་སུ་བཅད་པ་ལས།",
    "མི་ཟད་ཅེས་བྱ་བའི་ཚིག་དག་ནི་དང་པོར་རིག་པར་བྱ་ལ།",
    "ཚིག་རྣམ་པར་སྦྱར་བ་འདིས་ཁྱིམཐུན་པར་འགྱུར་རོ།",
    "མཐུའི་ཁྱད་པར་འདི་ལྟ་བུ་དང་ལྡན་པའི་བཅོམ་ལྡན་འདས་ནི་སྐྱབས་བླ་ན་མེད་པ་ཡིན་པས་བླ་ན་མེད་པའི་སྐྱབས་སོ།",
    "ཞེས་བྱ་བ་ནི་སྐྱེ་བ་མེད་པར་རྒ་བ་དང་འཆི་བ་མེད་དོ།",
    "ཅེས་བྱ་བ་ནི་འཇིག་རྟེན་ལས་འདས་པའི་ཡེ་ཤེས་ཤིན་ཏུ་རྣམ་པར་དག་པའི་ལམ་ཐོབ་པས་སོ།",
    "ཇི་ལྟར་རྔ་དག་མ་བརྡུངས་པར།",
    "འོན་ཀྱང་རྟོག་པ་མེད་པར་འོད་སྟོན་པར་འགྱུར་ལ།",
    "ཇི་ལྟར་ནམ་མཁའ་ལ་འཇིག་རྟེན་གྱི་བྱ་བ་རྒྱུན་མི་འཆད་པར་སྣང་བ་ལྟ་བུའོ།",
    "འོན་ཀྱང་གང་དག་ཆགས་པ་དེ་དག་ན་འཇིག་རྟེན་གྱི་བྱ་བ་རྣམས་རྒྱུན་མི་འཆད་པར་སྣང་ངོ།",
    "བདག་མེད་པའི་མཆོག་ནི་དེ་བཞིན་ཉིད་རྣམ་པར་དག་པའོ།",
    "བདག་མེད་པའི་མཆོག་ནི་དེ་བཞིན་ཉིད་རྣམ་པར་དག་པ་ཡིན་ལ།",
    "མེད་པར་ཡང་ནི་མི་བརྗོད་དོ།",
    "གལ་ཏེ་མེད་པ་ཙམ་ཞིག་ཡིན་པར་གྱུར་ན་ནི་གཟུགས་མེད་པའི་ཕྱིར་ལྕགས་ཀྱིས་ཀྱང་ལྕགས་ཀྱི་བྱ་བ་མི་བྱེད་ལ།",
    "སེམས་དང་ཤེས་རབ་རྣམ་པར་གྲོལ་བ་དག་ནི་དེས་རབ་ཏུ་ཕྱེ་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ནི་འདོད་ཆགས་མེད་པ་དང་།",
    "རྣམ་པར་གྲོལ་བའི་མཚན་ཉིད་དེ་ལྟ་བུར་ཡོད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་ལ།",
    "ནམ་མཁའ་ལྟར་ལུས་མེད་པས་ན་མང་པོ་ཉིད་ཀྱང་མ་ཡིན་ནོ་ཞེས་བྱ་བ་ནི་འདི་ལྟར་བདག་ཏུ་འཛིན་པ་མེད་པའི་ཕྱིར་རྟེན་ཐ་དད་པར་བརྗོད་པར་མི་ནུས་ཏེ།",
    "ཉི་མ་ཆེན་པོ་ནི་ཀུན་བརྟག་པར་བྱ་བ་ཡིན་ཏེ།",
    "གང་སྟོང་གསུམ་གྱི་སྟོང་ཆེན་པོའི་འཇིག་རྟེན་སྣང་བར་བྱེད་པའི་ཉི་མ་ཆེན་པོ་དེ་ལྟ་བུ་འགའ་ཞིག་ཡོད་པར་གྱུར་ནའོ།",
    "ལ་སོགས་པ་བསྡུ་བར་རིག་པར་བྱ་སྟེ།",
    "ཉི་མའི་འོད་ཟེར་སྟོང་པ་རྣམ་པར་རྟོག་པ་མེད་པར་འཆར་བ་ནི་འོད་ཟེར་ཁ་ཅིག་སྔར་འཆར་ལ།",
    "ཅེས་བྱ་བ་ནི་རྣམ་པར་རྟོག་པ་མེད་པའི་ཕྱིར་རོ།",
    "ལྷུན་གྱིས་གྲུབ་པར་འཇུག་པའི་ཕྱིར་རོ།",
    "ཅེས་བྱ་བ་འདིས་ནི་མཐར་ཐུག་པར་གཤེགས་པའི་ཕྲིན་ལས་བརྗོད་དོ།",
    "ཅེས་བྱ་བ་འདིས་ནི་རྣམ་པར་མི་རྟོག་པའི་ཕྲིན་ལས་བརྗོད་དོ།",
    "མཆོག་ཏུ་རྣམ་པར་དབྱེ་བས་སོ།",
    "རྣམ་པའི་རབ་ཏུ་དབྱེ་བའི་ཁྱད་པར་དང་།",
    "ཟབ་པའི་ཁྱད་པར་གྱིས་འབྱོར་པ་སྟོན་ཏོ་ཞེས་བྱ་བ་སྦྱར་ཏེ།",
    "དཔག་ཏུ་མེད་པ་ཉིད་ཀྱིས་ནི་རྣམ་པའི་རབ་ཏུ་དབྱེ་བའི་ཁྱད་པར་བསྟན་ལ།",
    "བསམ་གྱིས་མི་ཁྱབ་པ་ཉིད་ཀྱིས་ཟབ་པའི་ཁྱད་པར་བསྟན་ཏོ།",
    "ཝིཏི་༡༣༩འཇུག་པ་དེ་ཚད་གཟུང་བ་དང་བསམ་པར་མི་ནུས་སོ།",
    "རྣམ་པ་གཉིས་སུ་ཐུབ་པས་གསུངས།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་དང་མཚུངས་པར་ལྡན་པར་འཇུག་ལ།",
    "དེའི་རྗེས་ལ་འཐོབ་པའི་ཡེ་ཤེས་ལ་རག་ལས་པས་ནི་དེ་དང་མཐུན་པར་སྤྱོད་པ་ཡིན་ནོ།",
    "ཇི་ལྟར་རྣམ་པར་མ་དག་པའི་གནས་སྐབས་ན་ཡུལ་ལྔ་པོ་སྣ་ཚོགས་སུ་དམིགས་པ་དེ་བཞིན་དུ།་",
    "གཞན་དུ་གྱུར་པའི་གནས་སྐབས་ན་བེ་ཌཱུརྱ་ལ་སོགས་པའི་ཞིང་སྣ་ཚོགས་སུ་སྣང་བ་རྣམ་པར་དག་པ་ཡིན་ནོ།",
    "རྣམ་པར་རྟོག་པ་གཞན་དུ་གྱུར་ན་ཞེས་བྱ་བ་ནི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་གཞན་དུ་གྱུར་པ་སྟོན་ཏོ།",
    "དུས་ཐམས་ཅད་དུ་ཐོགས་པ་མེད་པ་ལ་འབྱོར་པའི་མཆོག་ཐོབ་པར་འགྱུར་རོ་ཞེས་བྱ་བ་ཡིན་ནོ།",
    "དེ་གཞན་དུ་གྱུར་ན་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པ་ལ་འབྱོར་པ་༧ ཐོབ་པར་འགྱུར་རོ།",
    "འདི་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པའི་དམིགས་པ་གཞན་དུ་གྱུར་པ་ཡིན་ཏེ།",
    "རྣམ་པར་རིག་པ་མི་རིག་པ།",
    "རྟེན་དེ་གཞན་དུ་གྱུར་པ་ནི་གནས་ངན་ལེན་གྱི་རྟེན་གྱི་དམིགས་པ་གཞན་དུ་གྱུར་པ་རྣམ་པར་གཞག་གོ།",
    "མ་སྨིན་པ་ནི་སྨིན་པར་འགྲོ་ལ།",
    "ཐོབ་པར་དཀའ་བ་དེའོ།",
    "དེའི་འོག་ཏུ་ཡེ་ཤེས་བཞི་སེམས་པར་འགྱུར་རོ།",
    "གང་ཞིག་རྣམ་པར་དག་ཅེ་ན།",
    "བཞེད་དགུར་མཉམ་པར་འཇོག་པའི་ཕྱིར་རོ།",
    "དེ་བཞིན་ཉིད་ཤེས་པ་ནི་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཏེ།",
    "ཐབས་དེ་མཁྱེན་པའི་ཕྱིར་དེའི་ཕྲིན་ལས་ཅན་ཞེས་བྱའོ།",
    "ཡང་ན་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་ནི་རྣམ་པར་མི་རྟོག་པའི་རྗེས་ལ་ཐོབ་པའི་ངོ་བོ་ཉིད་ཡིན་ལ།",
