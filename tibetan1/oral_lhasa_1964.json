    "རྗེས་ཁྱབ་ལྡོག་ཁྱབ་ཀྱི་མཚན་ཉིད་ཀྱི་ཟུར་དུ་ཁོ་ནའི་ཚིག་ཕྲད་དང་འབྲེལ་བའི་ངེས་པ་སྨོས་པའི་དོན་ཡང་དཔྱིས་ཕྱིན་པར་རྟོགས་པར་འགྱུར་ལ།",
    "གཞན་དུ་ན་ཚིག་ཙམ་ཞིག་སྒྲོགས་པར་ཟད་དོ།",
    "སྐྱོན་ཐམས་ཅད་ལས་གྲོལ་ཏེ་བདེ་བར་གནས་པར་འགྱུར་རོ།",
    "ཕྱོགས་གཉིས་ཀྱི་རྣམ་པར་གཞག་པ་ལ་དིང་སང་གངས་རིའི་ཁྲོད་ཀྱི་རྟོག་གེ་བ་དག་གླང་པོ་ཆེའི་གཟུགས་ལ་རྟོག་པའི་དམུས་ལོང་དང་མཚུངས་པར་གྱུར་ཀྱང་།",
    "གང་ཟག་དེ་ལྟ་བུའི་བདག་ཏུ་མེད་པར་བསྒྲུབས་ཙམ་གྱིས།",
    "བྱས་པས་སྒྲ་མི་རྟག་པར་སྒྲུབ་པ་ལ་མི་མཚུངས་ཏེ།",
    "སྒྲའི་སྒྲ་དོན་ལ་བྱས་པ་མ་གྲུབ་པའི་ཕྱིར་རོ།",
    "ཞེས་གསུངས་པས་སོ་ཞེས་ཟེར་ཏོ།",
    "ངེས་པ་སྐྱེད་པར་འདོད་པ་ཡིས།",
    "རྟགས་ཡང་དག་འགོད་དགོས་ཀྱི་རྒོལ་བ་ཡིན་ན་ཤེས་འདོད་ཡོད་དགོས་པར་སྟོན་པ་ཡིན་གྱི།",
    "བྱས་པ་དེ་སྒྲུབ་ཀྱི་རྟགས་ཡང་དག་ཡིན་པའི་ཕྱིར་ཞེ་ན།",
    "སྔ་རྒོལ་གྱིས་སྒྲ་མི་རྟག་པར་གྲུབ་པ་དེ།",
    "སྔ་རྒོལ་གྱི་ངོར་བྱས་པ་དེ་སྒྲུབ་ཀྱི་རྟགས་ཡང་དག་ཡིན་པའི་སྒྲུབ་བྱེད་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "འདི་དག་ལ་བརྗོད་པར་བྱ་བ་མེད་ཀྱང་བྱེད་པ་ཆེས་ཆུང་ཞིང་།",
    "ཡི་གེ་མངས་པར་འགྱུར་བས་མ་བྲིས་སོ།",
    "བྱས་པས་སྒྲ་མི་རྟག་པར་སྒྲུབ་པ་ལྟ་བུ་ལ་མཚོན་ན།",
    "བྱས་པ་རྟགས་སུ་རློམས་ནས་བཀོད་ཀྱང་།",
    "རང་མཚན་དུ་གྱུར་པའི་བྱས་མི་རྟག་སོགས་ནི་མ་ཡིན་ཏེ།",
    "བྱས་པ་སྒྲ་མི་རྟག་སྒྲུབ་ལ་རྟགས་ཡང་དག་ཏུ་བཀོད་པའི་ཚེ།",
    "འགོད་པ་པོའི་རློམས་ཚོད་ལ་དོན་རང་མཚན་གྱི་བྱས་པ་སྒྲ་མི་རྟག་སྒྲུབ་ཀྱི་རྟགས་སུ་བཀོད་པར་རློམས་ཀྱང་།",
    "བྱས་པ་སྒྲ་མི་རྟག་སྒྲུབ་ལ་རྟགས་སུ་འགོད་ཚུལ་དང་།",
    "བྱས་པའི་དོན་སྤྱིས་སྒྲའི་དོན་སྤྱི་མི་རྟག་པའི་དོན་སྤྱིར་སྒྲུབ་པའི་རྟགས་མ་གྲུབ་པ་དང་།",
    "སྒྲའི་དོན་སྤྱི་བྱས་པའི་དོན་སྤྱི་མ་ཡིན་པའི་ཕྱིར་དང་།",
    "བྱས་པའི་དོན་སྤྱི་ཡིན་ན་མི་རྟག་པའི་དོན་སྤྱི་ཡིན་པར་འགལ་བའི་ཕྱིར་ཏེ།",
    "བྱས་པའི་དོན་སྤྱི་དང་མི་རྟག་པའི་དོན་སྤྱི་མི་འགལ་ན།",
    "རྟག་པ་ཡིན་དགོས་པར་ཡང་མཚུངས་སོ།",
    "འདི་དག་ལ་ད་དུང་གནོད་བྱེད་བརྗོད་པར་བྱ་བ་མེད་ཀྱང་།",
    "རང་མཚན་ཡིན་ན་དཔེ་ལ་རྗེས་འགྲོ་མི་བྱེད་པར་འགྱུར་རོ་ཞེས་སྨྲ་པ་ནི།",
    "དེ་ནི་རྒྱས་པར་གོང་དུ་བཀག་ཟིན་ཏོ།",
    "བྱས་པས་སྒྲ་མི་རྟག་པར་སྒྲུབ་པའི་ཚེ།",
    "བྱས་པ་རྟགས་ཡིན་ལ།",
    "རིམ་པ་བཞིན་སྒྲ་དང་མི་རྟག་པ་དང་བྱས་པ་རྣམས་ཡིན་དགོས་པས་སྒྲོ་བཏགས་སུ་འགལ་བ་ཡིན་ནོ།",
    "སྒྲ་དང་མི་རྟག་པ་དང་བྱས་པ་གསུམ་སྒྲོ་བཏགས་མིན་ཞིང་།",
    "བྱས་པ་རྟགས་ཡིན་པ་རྣམས་ནི་སྒྲོ་བཏགས་ཡིན་ནོ།",
    "དུ་བ་དྲག་འཕྱུར་བ་དང་ལྡན་པའི་ལ་ལ་མེ་ཡོད་པར་སྒྲུབ་པ་ལ་དུ་བ་དྲག་འཕྱུར་བ་རྟགས་སུ་བཀོད་པ་ལྟ་བུ་རྒྱུ་དངོས་སྒྲུབ་པའི་འབྲས་རྟགས་དང་།",
    "ལ་མེ་ཡོད་དུ་སྒྲུབ་པ་ལྟ་བུའང་རྒྱུའི་ཁྱད་པར་སྒྲུབ་པའི་འབྲས་རྟགས་སུ་ཁས་ལེན་དགོས་པའོ།",
    "དེས་ན་དེ་ལྟ་བུའི་རྒུད་པ་འབའ་ཞིག་ཐོག་ཏུ་འབབ་པར་འགྱུར་རོ།",
    "དེ་ནས་མེ་ལྡོག་སྟོབས་ཀྱིས་དུ་བ་ལོག་པར་དམིགས་པའི་མངོན་སུམ་གཅིག་སྟེ།",
    "ཚུལ་འདིས་རྒྱུ་འབྲས་གཞན་ལ་ཡང་ཤེས་པར་བྱའོ།",
    "མེ་མེད་ན་དུ་བ་མེད་པར་ངེས་ནུས་པས།",
    "མེ་དུ་ལ་རྒྱུ་འབྲས་ཀྱི་ཐ་སྙད་མ་ཤེས་པར་ཐ་སྙད་ལ་རྨོངས་པའི་རྒོལ་བ་བླུན་པོ་འགའ་ཞིག་ཀྱང་ཡོད་གཞན་དུ་ན་རྒྱང་འཕེན་དག།",
    "ཞེས་པའི་རྟགས་ལས་མེ་དུ་རྒྱུ་འབྲས་སུ་ངེས་པར་བྱས་དགོས་སོ།",
    "ཞེས་པའི་རྟགས་ཀྱི་རྣམ་གཞག་གསུངས་པ་ཡིན་ནོ།",
    "ལ་ལ་མེ་ཡོད་པར་སྒྲུབ་པ་ལ་དུ་ཡོད་རྟགས་སུ་བཀོད་པའི་ཚེ་ན།",
    "ལ་ལ་དུ་བ་ཡོད་པའི་རྟགས་ཀྱིས་དུ་བའི་དུས་ན་མེ་ཡོད་པར་སྒྲུབ་པ་མིན་གྱི།",
    "སྒྲ་མི་རྟག་པར་སྒྲུབ་པ་ལ་དངོས་པོ་རྟགས་སུ་བཀོད་པ་ལྟ་བུའོ།",
    "སྒྲ་མི་རྟག་སྒྲུབ་ལ་བྱས་པ་རྟགས་སུ་བཀོད་པ་ལྟ་བུའོ།",
    "དེའི་ཁྱབ་པ་དཔེའི་སྟེང་དུ་མངོན་སུམ་གྱི་སྟོབས་ཀྱིས་ངེས་པར་ཕྱེད་ཅིང་།",
    "འཇིག་པ་བྱས་པའི་ངོ་བོར་གྱུར་པ་སྐྱེད་དམ།",
    "བྱས་པ་ལས་དོན་གཞན་པ་ཉིད་སྐྱེད།",
    "བྱས་པ་ལས་དོན་གཞན་པའི་འཇིག་པ་ཁོ་ན་ལ་ཕན་བྱེད་ཡིན་པའི་ཕྱིར།",
    "དཔེར་ན་འདུས་མ་བྱས་ཀྱི་ནམ་མཁའ་བཞིན།",
    "རྒྱུ་ཡང་མི་རྟག་པར་འགྱུར་གྱི་རྟག་པ་ཉམས་སོ་ཞེས་གནོད་པབསྟན་པས་འགྲུབ་བོ།",
    "འབྲེལ་བ་མེད་པར་ནི་རྗེས་སུ་འགྲོ་བ་དང་ལྡོག་པ་ངེས་པ་མེད་དེ།",
    "བྱས་པ་མི་རྟག་པ་ལས་ཐ་དད།",
    "མི་རྟག་པ་ལོག་ན་བྱས་པ་ལྡོག་པ་ནི།",
    "བྱས་པས་མི་རྟག་པ་ལ་འབྲེལ་བའི་དོན་ཡིན་ལ།",
    "མི་རྟག་པ་ལོག་པའི་གཞི་ལ་བྱས་པ་ལོག་པས་ཁྱབ་པར་སྒྲུབ་པའི་ཕྱིར་རོ།",
    "མི་རྟག་པ་ལོག་པའི་གཞི་ལ་བྱས་པ་ལོག་པས་ཁྱབ་པ་ཞེས་བྱ་བ་དེ་ཉིད་ངེས་པ་དང་།",
    "དེ་ནི་འདི་བསམ་པར་བྱ་སྟེ།",
