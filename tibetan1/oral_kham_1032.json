    "སྨ་འབེབས་སུ་འདུག་རྟོག་དཔྱོད་གྱིས་དང་།",
    "ཚེ་འདིའི་ཆེ་ཐབས་དང་འདོད་པ་བསྒྲུབ་པར་འདུག་ན།",
    "ཞེས་བྱ་བའི་རྣམ་གྲངས་ལ་རིམ་པས་བརྟག་ནས་འགལ་བར་སྤྱད་ནས་འདུག་ན།",
    "ཀོ་ལོང་གཙང་བཙན་པས་དམ་པར་འདུག་སྟེ།",
    "དབེན་པ་འདུག་འགྲེང་ལ་སོགས་པ་མཚན་མི་མཐུན་ཡན་ལག་ཏུ་དགོས་པ་ཐམས་ཅད་ལ་སྤྱིར་བསྟན་པ་ཡིན་ནོ།",
    "དགེ་སློང་མ་འདི་བདག་ལ་ཆགས་ནས་འདུག་གོ་སྙམ་དུ་ཤེས་པའི་འདུ་ཤེས་གཉིས་ཡོད་དེ།",
    "དབེན་པ་ན་འདུག་པ་ལ་ཡང་ཚུལ་དེ་བཞིན་དུ་སྦྱར་རོ།",
    "ཉལ་སར་འདུག་དང་འགྲེང་བ་དང་།",
    "ཁྱད་པར་དུའང་ཉལ་པོ་བྱེད་པར་ཤོམ་པའི་ཁྱིམ་ན་འདུག་པ་དང་འགྲེང་བ་དང་།",
    "གྲོང་ཁྱིམ་དུ་ནན་ལ་གྱིས་མཆིས་པར་བགྱིད་ན་ཅིར་འདུག་པར་བགྱིད་ན།",
    "དགག་བྱ་ནི་བྱས་ཆགས་པ་འཕེལ་བ་དང་རང་ལ་གནོད་པའོ།",
    "དགེ་སློང་མས་སྐྱེས་པ་དང་ལྷན་ཅིག་ཏུ་དབེན་པ་སྐྱབས་མཆིས་ཏེ་སྐྱབས་ཡོད་པ་ན་མཆིས་ཏེ་འདུག་ན་ཅིར་འགྱུར།",
    "སྐབས་འདི་ཉིད་ཀྱི་འགྲེལ་ཆུང་ལས་ནི་དགེ་སློང་མ་ཁྲིའི་ཐོག་ན་འདུག་ལ།",
    "སྟན་ནི་ནང་ཚངས་ཅན་དང་གླིངས་པ་ལ་སོགས་པ་ཡིན་གྱི་རྩྭ་དང་སོག་མ་ལ་སོགས་པ་། འདུག་པའི་ཆེད་དུ་ཕྱི་རོལ་ཏུ་བཤམས་པ།",
    "འདུག་ན་ནི་མ་བསྒོ་བར་སྟན་ལ་འདུག་པའི་ཉེས་བྱས་སོ།",
    "ཁྱིམ་དེར་སོག་མ་ལ་སོགས་པ་ཡིན་ཡང་རས་ཀྱིས་གཡོགས་པའི་སྟན་ལ་འདུག་པའི་དོན་དུ་ཁང་བའི་ཕྱི་རོལ་ཏུ་བཤམས་པ་ལ་ནི་མ་བསྒོ་བར་འདུག་ན་ཉེས་བྱས་སོ།",
    "དགག་བྱ་ནི་རང་རིགས་ལ་གནོད་པ་དང་རང་བཞིན་གྱིས་དགག་བྱར་ འགྱུར་བའོ།",
    "སྲིན་བལ་གྱི་སྟན་བྱེད་པ་བརྟད་པ་ལས་བྱུང་བ་དང་དབེན་པར་འདུག་པ་བཞི།",
    "ཉལ་སར་འདུག་འགྲེང་གཉིས་དང་གདེང་མེད་སྤྱོད།",
    "ཟློཁྱིམ་དུ་མ་བསྒོ་བར་སྟན་ལ་འདུག་པ་དང་།",
    "གཞན་ལུགས་དགག་པ་དང་རང་ལུགས་བཞག་པའོ།",
    "འདུག་གནས་འདུས་ཟ་ཉལ་ཤོམ་གཉིས།",
    "མི་སྨྲ་མ་གུས་དུས་མིན་འགྲོ།",
    "རིམ་གཉིས་འདུག་གནས་ཕྱེ་དང་ནི།",
    "ཉལ་ཤོམ་འདུག་འགྲེང་ལྷན་ཅིག་ཉལ།",
    "དྲུང་ན་འདུག་ཀྱང་ཟིན་པའི་མངོན་ཞེན་མི་རྫོགས་པར་མྱོང་བས་གྲུབ་བོ།",
    "སྦྱོར་བཅུག་ཡང་ཡང་འདུག་གནས་དང་།",
    "ཉལ་ཤོམ་འདུག་འགྲོང་གཉིས་ནི་གཉིས་ཀ་ཚོགས་པ་ལས་གྱུར་པའོ།",
    "འདུག་པ་མ་གཏོགས་དགུ་དག་དང་།",
    "གོས་ལ་སྤྱི་ཚད་དང་རང་ཚད་གཉིས་ལས།",
    "འདི་དག་ཀྱང་རང་དོན་ཧཱུཾ་ཡན་ལག་ཏུ་དགོས་པར་འདུས་སོ།",
    "གོས་སྟེར་དང་ནི་འདུག་གནས་ཟ།",
    "རྗེསྤྱོད་ཡུལ་དུ་ཞུགས་པས་ཞེས་པ་ནས་ཏེ་ལུང་གཞི་ལས་འདུག་པ་དང་བྱ་བ་དང་གསོ་སྦྱོད་བྱ་བར་རྗེས་སུ་གནང་ངོ།",
    "ནམ་མཁའ་ལ་འདུག་པ་དང་མཚམས་ཀོ་ཕྱི་རོལ་ཏུ་འགྲོ་བ་དང་ཆུ་ལྐོག་མ་ནུབ་ཙམ་ལ་འབོག་པ་གསུམ་གྱིས་ནི་འདུན་པ་འཇིག་སྟེ།",
    "དིར་དགེ་སློང་ལ་བརྗོད་ན་འདུག་སྟེ་ལན་གསུམ་བརྗོད།",
    "ཀརྨ་ཤ་ཏཾ་ལས་དགེ་སློང་འགའ་ཞིག་རྒྱལ་པོ་ལ་སོགས་པས་བཟུང་སྟེ་མཚམས་ཀྱི་ནང་ན་འདུག་ན་ཞེས་སོ།",
    "མཚམས་པོ་ཆེའི་ནང་ཡིན་པ་སྟེ་ལུང་གཞི་ལས་མཚམས་ཆེན་པོ་བཅད་པ་དེར་ཉིས་བརྒྱང་ལྔ་དགེ་སློང་རྣམས་ཀྱིས་འདུག་སྟེ་གསོ་སྦྱོང་དང་དགག་དབྱེ་བྱའོ་ཞེས་གསུངས་ལ།",
    "གཉིས་པ་མཚོ་རྟེན་གྱི་དམིགས་བསལ་ནི་འདུག་སྟེ་གསོ་སྦྱོད་བྱ་བ་ཡིན་ཡང་མགྲོན་པོ་མི་སྡོད་ན་འགྲོ་བཞིན་དུ་བྱའོ་ཞེས་གསུངས་སོ།",
    "གཉིས་པ་ནི་དབྱར་ས་གཞི་ལ་སྲོག་ཆགས་མང་དུ་རྒྱུ་བའི་དུས་སུ་འགྲོ་འདུག་མང་དུ་བྱས་ན་སྲོག་ཆགས་ལ་གནོད་པས།",
    "ལྔ་པ་ཚུལ་ཇི་ལྟར་བསྟབ་པ་ནི་ལྡེ་མིག་ཐོགས་ཏེ་མདུན་དུ་འདུག་ནས་ཚ་ཡོན་ཏན་ཇི་ལྟ་བ་བཞིན་དུ་བརྗོད་ཅིང་བསྟབ་པའོ།",
    "ཊཱི་ཀ་ལས་མི་གནས་པར་འདུག་པའི་ལོ་མ་ཚང་བ་དག་ནི་མི་གནས་པར་འདུག་པའི་ལོ་གྲངས་མ་ཚང་བ་སྟེ་དགེ་སློང་ཕ་བསྙེན་པར་རྫོགས་ནས་ལོ་བཅུ་མ་དགེ་སློང་མའི་རྣམ་འབྱེདལོན་པ་དང་།",
    "ལྔ་པ་གང་དུ་དགག་དབྱེ་བྱ་བའི་གཞས་ནི་མཚམས་པོ་ཆེའི་ནང་ཡིན་པ་སྟེ་ལུང་གཞི་ལས་མཚམས་ཆེན་པོ་བཅད་པ་དེར་དགེ་སློང་རྣམས་ཀྱིས་འདུག་སྟེ།",
    "གང་དུ་སྲ་བརྐྱང་བཏིང་བའི་མཚམས་དེ་ཉིད་དུ་བརྐྱང་སྟེ་མཚམས་གཞན་དུ་ནི་སྲ་བརྐྱང་རང་འཇུག་བྲལ་དུ་འགྱུར་བའི་ཕྱིར་རོ།",
    "སྲ་བརྐྱང་བཏིང་ནས་ཟླ་བ་ལྔ་ལས་འདས་ན་ཡང་རང་ཞིག་ཏུ་གྱུར་པ་སྟེ།",
    "སྲ་བརྐྱང་བཏིང་ནས་ཟླ་བ་ལྔ་ལས་འདས་ན་ཡང་རང་ཞིག་བྱས་ན་ཡང་རང་ཞིག་ཏུ་གྱུར་པ་སྟེ།",
    "ཊཱི་ཀ་ལས་སྲིད་དུ་བཏང་བའི་ཚལ་བུ་རྣམས་ཀྱི་སྣམ་ཐོན་དམན་དུ་འདུག་པས།",
    "མུ་སྟེགས་ཅན་གྱི་འདུག་གཞས་སུ་འཇུག་པ་ན་སྣམ་སྦྱར་འཁྱེར་དགོས་པར་གསུངས་ཀྱང་གོན་དགོས་པར་མ་གསུངས་སོ།",
    "ལུང་ལས་གཙུག་ལག་ཁང་དུ་ནི་ཀོ་ལྤགས་ཀྱི་སྟན་ལ་འདུག་པར་མི་བྱ།",
    "ཉལ་བར་མི་བྱ་འདུག་གམ་ཉལ་ན་འགལ་ཚབས་ཅན་དུ་འགྱུར་རོ།",
    "ཞེས་བཀག་ཀྱང་ཁྱིམ་གཞན་དུ་གཞན་མེད་ན་ཀོ་ལྤགས་ལ་འདུག་པར་བྱ་ཞེས་གནང་ངོ།",
    "ལུང་གཞི་ལས་ཤུན་ཚོད་དུ་རུང་བའི་བཏུང་བ་འདི་དག་དུས་སུ་བྱིན་གྱིས་བརླབས་ན་དུས་མ་ཡིན",
    "བདག་ནི་ལེན་པ་པོའོ་སྙམ་དུ་དྲན་པ་ཉེ་བར་བཞག་པ་སྟེ་དེ་བཞིན་དུ་སྤྱོད་ལམ་མཛེས་པས་འདུག་པར་བྱའོ།",
    "འདུན་པ་དང་ཡོངས་དག་འབུལ་བ་ཙམ་མ་ཡིན་པ་སྟེ་མི་འདུག་པར་འགྲེང་བ་ནི་ཁ་སྐོང་བ་ཉིད་མ་ཡིན་ནོ།",
    "མཐོང་བའི་ཉེན་ཀོར་བཞིན་གཞུང་འགྲེལ་ཀུན་ཏུ་ཉེན་ཀོར་ཞེས་བྱུང་ཡང་ཉེ་འཁོར་གྱིས་ཆོག་གམ་སྙམ་དུ་འདུག་ཏུ་བཅུག་ནས་གསོལ་བ་དང་བཞིའི་ལས་ཀྱིས་བསྙིལ་བར་བྱའོ་ཞེས་གསུངས་སྣ་བ་། པ་དང་།",
    "འདུན་པ་སྣ་བ་། དགེ་སློང་ལ་བརྗོད་ན་འདུག་སྟེ་ལན་གསུམ་བརྗོད་པར་གསུངས་པ་ལྟ་བུའོ།",
    "ལྷག་པོར་ཡང་མདུན་དུ་ཙོག་པུར་འདུག་སྟེའོ་ཞེས་ཏེ་ལན་གསུམ་བརྗོད་པ་དང་སྤྱོད་ལམ་ཡང་མི་འདྲའམ་སྙམ་པའི་དོགས་པ་བསལ་བའོ།",
    "མཚམས་གཅོད་པར་བྱེད་པ་ན་ཡང་ཕྱོགས་བཞིའི་མཚན་མ་བརྟན་པོའི་ས་ཁོངས་ཀྱི་ཕྱི་རོལ་ཏུ་འདུག་ནས་བཅད་དུ་མི་རུང་སྟེ།",
    "གཉིས་པ་ལྟར་ན་མ་མཐོང་བ་ལ་ནི་ཞེས་པ་ནི་གཞུང་འདི་ཉིད་ཀྱི་འགྲེལ་ཆུང་ལས་ཅི་ཡང་མི་སྨྲ་བ་ཁ་བཙུམ་སྟེ་འདུག་པ་མི་བཙུན་༧གྱི།",
    "སྤངས་པ་ཉིད་ཀྱང་དེ་དང་འདྲའོ་ཞེས་པ་དེའི་དོན་ཡིན་གྱི་གཞུང་འདིའི་དོན་ནི་ཊཱི་ཀ་དང་རང་འབྲེལ་ལས་འབྲུ་སྣོན་པ་དེ་ཡིན་ཞིང་ངེས་སོ།",
    "དེ་ཡང་ཊཱི་ཀ་ལས་དགྲ་བཅོམ་པ་ཉིད་ཐོབ་པ་ནས་སྤྲོ་བ་དང་མགུ་བར་བྱ་བ་སྤྱོད་པ་གཉིས་ཀྱིས་ཀྱང་རང་བཞིན་ཐོབ་ཅིང་།",
    "ཕྱོགས་གཉིས་ཀ་ཕ་ཟད་ཚུ་ཟད་དུ་གྲལ་མཉམ་པར་འདུག་ལ་མཐོལ་བཤགས་བྱ་ཞེས་སོ།",
    "གལ་ཏེ་སྦྱིན་པའི་ལས་ཡིན་ན་ནི་རྒན་པའི་མཐར་འདུག་སྟེ་གསོལ་བ་འདེབས་པའི་ཆོ་ག་གསུང་བར་རགས་པ་ལས།"
  ]
}