    "ལིས་ཞན་ཉན་ཧར་གྱིས་ཡར་ལངས་ཏེ་ང་རང་སྔོན་དུ་འགྲོ་ཞེས་བཤད།",
    "ལིས་ཞན་ཉན་གྱིས་མགོ་གཡུག་ཞོར་ཞུའུ་ཞང་ཆན་ལ་ལྟ་བཞིན་ནུས་ཤུགས་གང་ཡོད་ཀྱིས་ང་རང་འདི་དང་ཁ་གྱེས་མི་ཉན།",
    "ལོ་དེར་ཁོ་རང་ལོ་ཉེར་བཞིར་སོན་མ་ཐག་ཡིན།",
    "ཁོ་རང་གྱང་རའི་ཟུར་གྱི་ཆག་ཧྲུལ་དུ་གྱུར་པའི་ཐུན་རྔ་ཐོག་ཁང་ནང་དུ་འཛུལ་ནས་དགྲ་དམག་མང་པོ་ཞིག་གྱང་རའི་ཁ་ཆག་པ་དེར་ཕྱོགས་ནས་རྔམ་འདོད་ཀྱིས་མཆོང་ཡོང་བ་མཐོང་ཞིང་།",
    "སྐེད་པར་ཟ་འབྲུ་ཅུང་ཙམ་ཡང་མེད་པར་ག་དུས་ཡིན་ཡང་འཁྱགས་ཤི་དང་ལྟོགས་ཤི་ཐེབས་པའི་ཉེན་ཁ་ཆེ།",
    "ཚང་མས་གནས་སྐབས་སུ་ལྟོགས་སྐོམ་དང་གྲང་ངར་བརྗེད་འདུགའོན་ཀྱང་།",
    "ཡག་པོ་འདུག་ཁྱེད་ཀྱང་ཚུར་ཐོན་བྱུང་ཞེས་བཤད།",
    "ཁོ་རང་ཆུང་དུས་ནས་རྩེད་གྲོགས་རྣམས་དང་མཉམ་དུ་ཆུ་རགས་ཀྱི་སྟེང་ནས་ནོར་འཚོས་མྱོང་ལ།",
    "ཁོ་རང་ཁྱིམ་དང་ཁ་བྲལ་མི་འདོད།",
    "འདི་ལྟ་བུའི་བྱས་རྗེས་འཇོག་པ་དང་རང་ཉིད་བློས་གཏོང་བའི་མི་ག་ཚོད་ཡོད་དམ།",
    "འདི་དག་སེམས་སུ་དྲན་དུས་ཁོ་རང་སེམས་ཧ་ཅང་སྡུག་སྤྱི་ལོ་ལོར།",
    "འདི་དག་དྲན་དུས་ཁོ་རང་ཡར་ལངས་ཏེ་སེམས་འགུལ་ཐེབས་པོའི་ངང་།",
    "ང་རང་ལྕགས་ཕག་ལོའི་གསར་བརྗེའི་སྔོན་དུ།",
    "ང་རང་ངའི་ཁྱིམ་ཚང་ལ་དགའ་ཞིང་།",
    "དེ་ནས་བཟུང་ཁོ་རང་དུས་ཡུན་རིང་པོར་བཟའ་ཟླ་དང་མཉམ་གཅིག་ཏུ་འཚོ་བ་རོལ་ཞིང་།",
    "ཁོ་རང་ལོ་ན་གཞོན་པའི་དུས་སུ་འདྲ་མཉམ་མིན་པར་རྩོད་པ་ཆེན་པོ་བྱེད།",
    "གཞུང་ཁང་ནང་དུ་མིས་ཁེངས་འདུག་ཅིང་།",
    "ཞེ་ཅོལ་ཙེས་འདུག་ས་ཞིག་བཙལ་ཏེ་མར་བསྡད་ནས་ནན་ཏན་གྱིས་རྐུ་འཕྲོག་བྱས་པའི་མི་དྲག་གཤེད་མ་དེའི་འདྲི་གཅོད་ལ་ཉན།",
    "ཁོ་རང་ལོ་ན་མི་ཆེ་ཡང་ས་གནས་དེ་གར་མཚན་སྙན་གྲགས་ལྡན་པ་ཞིག་ཡིན།",
    "ཁོ་རང་ཁོང་ཁོ་ཆེན་པོ་ལངས་ཏེ་གཞུང་ཁང་དང་ཁ་གྱེས།",
    "ས་གནས་དེ་གའི་བྱ་འགུལ་གལ་ཆེན་ཚང་མར་ཁོ་རང་མི་ཞུགས་ལ།",
    "དེ་ནི་ཁོ་རང་འགན་བཞེས་ནས་ཅང་མ་འགོར་བའི་ཉིན་ཞིག་སྟེ།",
    "སྐབས་དེར་ཁོ་རང་ལོ་བདུན་བཅུ་ལྷག་ལ་སོན་ཡོད་ཅིང་།",
    "ད་རུང་མི་བཟང་ལ་མ་ཉེས་ཁ་གཡོགས་བྱས་ཏེ་ངས་ཁོ་ལོ་བརྒྱད་རིང་བཙོན་དུ་འདུག་པར་བཅུག་ཁྱེད་ཚོས་ངར་ཚེ་བཙོན་གྱི་དཔྱད་མཚམས་ཆོད་དང་ཞེས་བཤད།",
    "ཁོ་རང་ལོ་བརྒྱད་ལ་མ་ཉེས་ཁ་གཡོགས་ཀྱི་བཙོན་ལ་བསྡད་དེ་ད་གཟོད་ཁོར་དག་སེལ་བྱས།",
    "ཁོས་གནས་ཚུལ་འདི་དང་རང་ཉིད་ཀྱི་བསམ་ཚུལ་ཇི་མ་ཇི་བཞིན་དུ་མའོ་ཙེ་ཏུང་ལ་སྙན་སེང་ཞུས་པ་དང་།",
    "ལིན་པའོ་ཆུས་སྒེའུ་ཁུང་དང་ཉེ་བའི་རྐུབ་སྟེགས་སྟེང་དུ་བསྡད་ནས་ཉེ་མཐོང་མིག་ཤེལ་གྱོན་ཏེ་མགོ་བོ་མར་སྒུར་ཁོས་ནས་རྐང་སྣམ་རྙིང་བ་ཞིག་ལ་ལྷན་པ་རྒྱག་བཞིན་འདུག་པ་དང་།",
    "ཁོ་རང་ཐོག་དང་པོར་རྒན་ལིན་གྱི་མལ་ཁང་དུ་འཛུལ་ཏེ་ཕྱོགས་བཞིར་བལྟས་པ་ན།",
    "ང་རང་ཀྲུའུ་ཞི་བྱས་པ་ནི་བློ་མཐུན་ཚོ་དང་བྱ་བའི་ལས་རྐང་མི་གཅིག་པ་ཙམ་ཡིན།",
    "དེ་བས་ཁྱེད་རང་ལ་བརྡ་མ་བཏང་བ་ཡིན་ཞེས་བཤད།",
    "ལིན་ལགས་ཀྱང་རང་ཉིད་ཀྱི་བྱིས་པར་ཤིན་ཏུ་དགའ།",
    "མི་གཞན་པས་ཁྱེད་རང་ནར་སོན་རྗེས་ཅི་ཞིག་བྱ་རྒྱུ་འདྲི་དུས།",
    "ང་ཅུང་ཙམ་འདུག་པར་ཆུག་དང་ཞེས་བོས།",
    "ཁྱེད་རང་ང་ལེན་དུ་ཡོང་བ་ཡིན་ནམ་ཞེས་དྲིས།",
    "བསམ་ཡང་ཤེས་འདུག་ཅེས་བཤད།",
    "ཚང་མས་ང་བདམས་ནས་འདུག་ཏུ་བཅུག་ན་ང་འདུག་རྒྱུ་ལས་འོས་མེད་ཅེས་བཤད།",
    "ཁོ་རང་ཀྲུང་གུང་ཧུའུ་པེ་ཞིང་ཨུའི་ཨུ་ཡོན་པའང་ཡིན།",
    "ཁོ་རང་འཚབ་སྟེ་འཛེམ་དོགས་མེད་པའི་སྒོ་ནས་ཏུང་ལགས་ལ་ཁྱེད་ད་རུང་རྟར་མི་ཞོན་ན།",
    "ཁོ་རང་ལོ་བཅོ་བརྒྱད་ལ་སོན་པའི་ལོ་དེར་ཞུའུ་ཚའེ་རུ་རྒྱུགས་འཕྲོད་པ་དང་།",
    "ཁོ་རང་ཚེ་ལས་འདས་རྗེས།",
    "ཁོའི་ཏ་ལེན་ནང་དུ་ད་རུང་ཆེ་ཆུང་མི་གཅིག་པ་དང་ཁ་དོག་མི་གཅིག་པའི་རྐང་འབོལ་རྙིང་པ་བཞི་ལྷག་འདུགཏུང་ལགས་ཀྱི་དཀའ་སྤྱད་བབ་ཆགས་ཀྱི་སྤྱོད་བཟང་དེ་གསར་བརྗེའི་ནང་དུ་ཞུགས་པའི་དུས་ནས་བཟུང་སྙན་པའི་གྲགས་པ་ཁྱབ།",
    "ཁོ་རང་མི་ཤུགས་འཐེན་འཁོར་ལ་གཏན་ནས་མི་འདུག་པར་ཕར་འགྲོ་ཚུར་ཡོང་བྱ་དུས་རྒྱུན་པར་རྐང་ཐང་དུ་འགྲོ།",
    "ཏང་དང་རྒྱལ་ཁབ་འགོ་ཁྲིད་པས་སྔར་བཞིན་དམག་འཁྲུག་དུས་སྐབས་ཀྱི་ལྭ་བ་གྱོན་ཏེ་རྣམ་པ་གསར་པ་དང་ཤིན་ཏུ་མི་འོས།",
    "ཐེངས་གཅིག་ཏུ་མི་ཤེས་ན་ཡང་བསྐྱར་ཀློག་པའམ་ཡང་ན་གཞན་པའི་འབྲེལ་ཡོད་ནང་དོན་ཀློག་དུས་འབྲེལ་བ་བྱས་ཏེ་རྒྱུས་ལོན་བྱ་དགོས།",
    "ཁྱེད་རང་ཇི་ལྟར་འཚར་ལོངས་བྱུང་བ་ཡིན།",
    "མང་པོ་ཞིག་ཐོབ་ཀྱང་རང་བསྟོད་བྱེད་མི་ཉན་པར་ནམ་ཡང་ཁེངས་སྐྱུང་དང་གཟབ་ནན་སེམས་ཆུང་བྱ་དགོས།",
    "གསར་བརྗེའི་མདུན་ལམ་ལ་དབྱེ་ཞིབ་བྱས་པར་ཉན་བཞིན་ཀྲང་ཝིན་ཐན་དང་རང་ཉིད་སྔར་ལས་ཉེ་བར་གྱུར་པའི་ཚོར་བ་སྐྱེས།",
    "འོན་ཀྱང་རང་ཉིད་ཀྱི་ཞན་ཆ་དང་སྐྱོན་ཆ་དག་གཏན་ནས་མི་འགེབས།",
    "དེ་ནས་ཐུབ་པ་དེས་འདི་ལྟར་བསམས་ཤིངའདུག་སྟེ།",
    "དེ་བས་ན་ཁྱེད་གཅིག་པུ་འདུག་པར་འོས་སོ་ཞེསཟེར་རོ།",
    "དེས་ཀྱང་གཟུགས་ལྡན་མ་ལ་མཚོན་ཆ་གཏད་ཅིང་འདུག་གོ།",
    "རབ་ཏུ་བརྒྱད་བར་བྱས་པའི་ཆུ་འཛིན་པའི་ཚོགས་ཀྱིསཤིན་ཏུ་སྔོ་བའི་བར་སྣང་ལའདུག་སྟེ།",
    "འཆི་བ་དང་ཡང་འབྲེལབའི་གཏམ་གྱིས་ནང་མིའི་ཚོགས་དང་བཅས་པའི་ཡབ་ཀྱི་ཡིད་སྐྱོ་བབསྐྱེད་ཅིང་འདུག་གོ།",
    "ཆང་ནི་བླུགས་ཤིང་འདུག་པཉིད་དུ་གནས་པར་གྱུར།",
    "མལ་དེ་ལ་འབྲེལ་ནས་ཆང་དེ་མྱང་ཞིང་འདུགཔར་གྱུར་ཏོ།",
    "རྟ་མཆོག་ལ་ཞོན་པ་དང་རང་དང་འདྲབའི་སྐྱེ་བོས་རྗེས་སུ་འབྲེང་བ།",
    "རི་དགས་ཀྱི་ཚོགས་གཉིས་དེ་དབུགས་འབྱིན་ཞིང་གནསཔ་དམག་ཚོགས་ཀྱིས་ཀུན་ནས་བསྐོར་ཞིང་འདུག་གོ།",
    "སྐྱེས་མ་ཐག་ཙམ་འདུག་པ་ནི།",
    "རི་ཤིང་རྣམས་ཀྱང་དེལས་ཟློག་པར་བྱེད་ལྟར་འདུག།",
    "དེ་ནས་རྒྱལ་པོ་དེཡིད་རབ་ཏུ་དགའ་བས་ཚོགས་ཀྱི་བདག་པོ་དེ་སེང་གེའི་ཁྲི་ལ་འདུགཏུ་བཅུག་ནས་གུས་པ་དང་བཅས་པས་དམའ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "དེ་རྣམས་ཀྱང་འཆི་བ་ལ་འཇིགས་པས་དེ་ལྟར་བགྱིཞེས་ཁས་བླངས་ནས་ཤིན་ཏུ་མཁས་པའི་བྱ་བ་སུ་ཞིག་ལ་དོན་དུགཉེར་བར་བྱས་ཏེ་གཏོང་ཞིངའདུག་གོ།",
    "གྲོགས་པོ་སུ་ཞིག་ལ་གཏམ་དེ་དབེན་པའི་སར་སྨྲ་ཞིང་འདུག་གོ།",
    "འདུག་ཅིང་ལངས་དང་འགྲོ་བའི་རི་དགས་འགའ་ཞིགཏུ།",
    "འདུག་ཅིང་སོ་སོར་བརྐྱང་བར་གྱིས།",
    "ཅུང་ཟད་གང་ནས་ཀྱང་མྱང་ཞིང་བདག་ཉིད་ཆོགཤེས་པ་ལ་ཞུགས་ཤིང་འདུག་གོ།",
    "དབུགས་འབྱུངཞིང་འདུག་པའི་རི་དགས་ཀྱི་ཚོགས་དང་ལྡན་པ་དང་།",
    "རིངཔོ་ནས་དོར་བའི་དམག་ཚོགས་ལ་སྡོད་ཅིང་འདུག་གོ།",
    "གླང་པོའི་ཕྲུ་གུའདུག་པའི་ཚོང་པའི་ཚོགས་ནི་མཐོང་བར་གྱུར།",
    "ལྷ་ལགས་བདག་ཅག་ནི་བྱང་ཕྱོགས་ནསའོངས་ཞེས་བྱ་བ་སྨྲ་ཞིང་འདུག་གོ།",
    "དེ་ནས་བྱང་ཕྱོགས་ཀྱིགཏམ་སྐབས་སུ་བབ་པ་ལཚོང་པ་རྣམས་ཀྱི་བདག་པོ་དེ་རྡོ་རྗེ་དབྱུག་པ་ཅན་ཞེས་བྱའིརྒྱལ་པོ་ལ་ཆེ་བའི་བདག་ཉིད་བྲྗོད་ཅིང་འདུག་གོ།",
    "མཆེ་བ་གཉིསཔའི་དཔུང་པར་གླང་པོ་སྐྱོང་བ་འདུག་པ་ལ།",
    "ཡུད་ཙམ་ཡུད་ཙམ་དུ་ནི་ལུས་ནི་བསྐྱོད་ཅིང་འདུག།",
    "ཁྲོས་བྱས་འདུག་སྟེ་སྐད་ཅིག་ཙམ་གྱིས་གཡོ་མེད་མིག་ཅན་ནི།",
    "དེ་ནས་གདུག་པའི་བདག་ཉིད་བློ་གྲོས་ངན་པ་དེ་ཡོངས་ནས་བསྒོ་བཞུས་པའིཞུགས་པ་རྗེས་སུ་གནང་བ་སྟན་ཡོངས་སུ་འཛིན་པར་བྱས་པ་དབེནཔར་རྒྱལ་པོ་རི་རབ་ལ་མི་བདེན་པའི་ཚིག་རྣམས་ཀྱིས་སྦྱོར་ཞིངའདུག་གོ།",
    "ཇི་ལྟར་བུང་བ་མི་སྨྲ་བར་ནི་འདུག་པར་གྱུར།",
    "དེ་ཡིས་སེམསབཟང་རང་བཞིན་གྱིས།",
    "དེསཀྱང་དེ་མནོས་ནས་གུས་པ་དང་བཅས་པར་མགོ་བོ་ལ་བཏགས་ཏེ་འདུགགོ།",
    "མཚོ་ནས་ཀུ་མུ་ཏ་རྣམ་པར་བླངས་ནས་མཆོད་ཅིངའདུག་གོ།",
    "དེ་ནས་རི་བོའི་ནགས་ཀྱི་ནང་དུ་དེའི་འཆགཔ་མཐོང་ནས་གླང་པོ་ཆེའི་ཚོགས་དེ་དོགས་པ་དང་བཅས་པ་གླངཔོ་ཆེའི་བདག་པོ་ལ་ཞུས་ཤིང་འདུག་གོ།",
    "དེ་ནས་མཆེ་བ་མཐོང་བས་རབ་ཏུ་དགའ་བའིཡིད་ཅན་རྒྱལ་པོ་དེས་རྔོན་པ་དེ་ལ་ཇི་ལྟར་ཁས་བླངས་པའི་ནོརསྦྱར་ཞིང་འདུག་གོ།",
    "དེ་ནས་རྒྱལ་པོ་དེ་དེལྟར་སྨྲེ་སྔགས་འདོན་པ་ལ་རྩེ་གཅིག་པར་རྔོན་པ་དེས་འཛིན་ཅིངའདུག་གོ།",
    "དེ་ལྟར་བྱའོ་ཞེསཟླ་བས་ཀྱང་ཁས་བླངས་པ་ལ་དང་པོར་ཟླ་བའི་མིང་དེ་རྣམསཀྱིས་འབྲི་ཞིང་འདུག་གོ།",
    "འདིཐམས་ཅད་མཁྱེན་ལ་རྣམཔར་འཇིག་པའི་ཕྱིར་འདུག་པའི་བདག་ཉིད་ཅན་གྱི་དུམ་བུ་འཛིན་པའིགཡོའི་རྣམ་པར་སྤྱོད་པ་སྟེ།",
    "ངོ་མཚར་བའི་ཡིད་ཅན་བདགཉིད་ཆེན་པོ་དེ་དང་ཉེ་བར་འདུག་པར་གྱུར་ཏོ།",
    "དེ་ནས་རྒྱལ་པོ་དེ་གུས་པདང་བཅས་པས་ཉེ་བར་འདུག་སྟེ་བྡེའམ་ཞེས་དྲིས་ཏེ།",
    "སྟན་ལ་ཉེ་བར་འདུགསྟེ།",
    "རྒྱལ་པོ་དེ་ཡང་རང་བཞིན་གྱིས་རབ་ཏུ་དྲག་པའི་ཁྲོ་བ་ཉིདཀྱི་ཕྱིར་ཁྲོ་གཉེར་གྱིས་འབྲེལ་བའི་འགྲམ་གྱི་ཕྱོགས་མིམཉམ་པར་བྱས་པ།",
    "སསྐྱོང་རང་བཞིན་གྱིས་ནི་དྲག་པའི་གནོད་སྦྱིན་རྣམས།",
    "དེའི་བུཨཨུཏྤལ་ཅན་ཞེས་བྱ་བ་ཅིག་ཡོདདེ་དེས་ཀྱང་ཕའི་དྲུང་ནས་ཞགས་པའི་ཆེ་བའི་བདག་ཉིད་དེ་ཉེབར་ཐོབ་པ་དེ་ལྟ་བུའི་ཞགས་པ་ལ་མཆོད་ཅིང་འདུག་གོ།",
    "ཕྱིས་ཀྱང་འདི་ལྟར་བསམས་ཤིང་འདུག་གོ།",
    "རྒྱལ་པོ་དེ་ལ་མི་རྣམས་ཚོགས་པའི་དུསསུ་ཞུགས་ནས་ཤིས་པ་བྲྗོད་པར་བྱས་ཤིང་སྟན་ལ་ཉེ་བར་འདུགསྟེ།",
    "དེནས་རྒྱལ་པོ་དེས་རིགས་བཟངཔོ་མདུན་ན་འདོན་ཉིད་ལ་ཞུགས་ཤིང་འདུག་གོ།",
    "སྐྲག་པ་བྱུང་བས་སྐད་ཅིག་ཆད་ཅིང་རང་བཞིན་གྱིསནི་འཇིགས།",
    "འདུག་པའི་བདག་ཉིད་ཅན་མདུན་ནའདོན་པ་དེ་ཡང་ཡང་དག་པརའོངས་ཏེ་རྒྱལ་པོ་ལ་འདི་སྐད་ཅེས་སྨྲས་ཏེ།",
    "དཔུང་པ་ལ་ཁྲི་སྙན་སལེའི་པགས་པ་རྣམ་པར་བཀོད་པའི་དྲང་སྲོང་དེའི་གན་དུ་ཉེ་བརའོངས་ནས་དབེན་པའི་སར་འདུག་སྟེ་དྲིས་པ།",
    "བརྟན་པར་འདུག་ཤིག་དང་ཡིད་འཕྲོག་མ་ཐོབ་པར་འགྱུར་རོ་ཞེས་ཟེརརོ།",
    "རལ་པའི་ཚོགས་རྣམ་པར་བཅིངས་པའིཅོད་པན་གྱིས་མགོ་བོ་ལ་འདུག་ནས་ཅུང་ཟད་དམའ་བའི་ཚང་བརྩམཔར་བྱས་ཏེ།",
    "ཀྱེ་མ་འདོད་ཆགས་དང་ལྡན་པ་རྣམས་ཀྱིས་འདོད་ཆགས་ཀྱིབདགཉིད་དུ་འདུག་པ་སྟེ།",
