    "པར་བོད་གཞུང་རང་ནས་ཐག་གཅོད་གཏན་འཁེལ་གྲུབ་པའི་རྗེས་སུ་གཞི་ནས།",
    "ཐམ་ཀའི་ཁ་རིས་ཀྱི་པར་བཀོད་འདུག་ཐམ་ཀའི་ཁ་རིས་ལ།",
    "དཀར་ནག་བདེན་རྫུན་གྱི་རྣམ་དབྱེ་གསལ་པོར་ཆོད་ཐུབ་པ་འདུག་ཅིའི་ཕྱིར་ཞེ་ན།",
    "འདི་དག་དམར་པོའི་བཙན་ཤུགས་ངོམས་ཏེ་གྲོས་མཐུན་ནང་རང་འདོད་ལྟར་བྲིས་པ་ལམ་སེང་གསལ་པོར་མཐོང་ངེས་ཡིན།",
    "གཞུང་རང་ནས་བྱེད་རྒྱུ་དང་།",
    "ཞེས་བཀོད་འདུག་སྤྱིར་གྲོས་མཐུན་འདི་ག་དྲག་ཤུགས་ཀྱིས་སྡིགས་ར་བཙན་པོའི་འོག་འཇོག་ཏུ་བཅུག་པ་དང་།",
    "ཁྱེད་དང་སླར་ཡང་ག་དུས་མཇལ་ཡོང་ངམ།",
    "ཁྱེད་ཀྱིས་ཡིག་ཁོག་ནང་དུ་བོད་ཀྱི་མེ་ཏོག་ཅིག་ཀྱང་བཅུག་འདུག་པ་ཧ་ཅང་དགའ་པོའི་ངང་ནས་མཐོང་།",
    "༡༩༥༥ ལོ་ནང་བོད་དུ་ཕྱིར་ཕེབས་གྲུབ་རྗེས་མའོ་ཙེ་ཏུང་ལ་ཕྱག་བྲིས་ཤིག་གནང་བའི་བཀའ་ལན་ཡིན་འདུག་འོན་ཀྱང་རྒྱ་མིའི་བྱེད་སྤྱོད་ཤིན་ཏུ་ཐ་ཆད་པ་བཞིན།",
    "གལ་སྲིད་སྐུ་ཉིད་ལས་དོན་ཐོག་ལ་དཀའ་ངལ་བྱུང་ཚེ་སྐུ་ཉིད་ནས་ག་དུས་ཡིན་ཡང་ཕྱག་བྲིས་དང་།",
    "སྐུ་ཉིད་ཀྱི་ནང་མི་ཁ་ཤས་ཕྱི་རྒྱལ་དུ་འགུལ་བསྐྱོད་བྱས་པ་ལ་སྐུ་ཉིད་ནས་ཐུགས་མ་བདེ་བ་ཡོད་ལུགས་གསུང་འདུག་དེ་ནི་ངས་ཀྱང་ཤེས་ཀྱི་ཡོད།",
    "ད་ལྟའི་བཀའ་ལན་དེ་ལས་ལེགས་པ་མི་འདུག་གང་ཡིན་ཟེར་ན།",
    "ཞེས་འཁོད་འདུག་ཀྱང་།",
    "དང་པོའི་སེམས་འཕྲོ་བ་ཅུག་འདུག་ཀྱང་རྟོག་པ་བགས་ཀྱིས་ཇེ་ཆུང་ལ་འགྲོ་བ་ཡིན།",
    "སྲིད་བདེ་དུག་ལྟར་སྤངས་ཤིང་རང་གཅིག་པུའི།",
    "སྐབས་འདིའི་ས་བཅད་དུ་སྤྲོ་བ་བསྐྱེད་པ་ཅེས་སྨོས་པའང་ཐོག་མར་རང་རྒྱུད་ལ་དད་སོགས་འཕེལ་བ་དང་དེ་ནས་གཞན་ལའང་ཕན་པར་འགྱུར་བ་སོགས་གང་ལ་བསམས་ཀྱང་རང་ཉིད་བསྟན་བཅོས་རྩོམ་པ་ལ་སྤྲོ་བ་སྐྱེད་རིགས་པ་དང་གཞན་དག་ཀྱང་སྤྲོ་བ་བསྐྱེད་ནས་འཇུག་རིགས་པའི་དོན་གྱིས་དེ་སྐད་བརྗོད་པའོ།",
    "ཡོ་བྱད་དམན་པ་གོས་རིན་སོགས་ཀྱི་ཡོན་འབུལ་གྱ་ནོམ་པ་ཅི་ཡང་མེད་པར་ཟས་གཅིག་པུ་ཙམ་སྦྱིན་པར་བྱེད་པ་དང་སྦྱོར་བ་དམན་པ་གུས་པ་དང་བཀུར་སྟི་ལྟ་བུ་ཅི་ཡང་མེད་པར་བརྡུང་བརྡེག་སོགས་བཙན་ཐབས་ཀྱི་སྒོ་ནས་གྲལ་གྱི་ནང་དུ་འདུག་ཏུ་བཅུག་ནས་བརྙས་ཤིང་ཐོ་འཚམ་པར་བྱེད་པ་དང་བཅས་པས།",
    "ཡང་འདིར་གོད་ཅེས་པ་འབྲི་ཤིང་འཛད་པའི་དོན་དང་འགོད་ཅེས་པ་ཉིན་མཚན་གྱིས་ཚེ་སོ་སོར་འགོད་པའི་དོན་ཡིན་ཞེས་འཆད་པའང་སྣང་ལ་ཚེ་རིང་དུ་འཕེལ་བའི་ཐབས་ཀྱིས་སྣོན་པའང་མེད་ཅེས་པའང་འདུག་གོ།",
    "དེ་ལྟ་བུའི་སྡུག་བསྔལ་དེ་དག་ཀྱང་རང་གཅིག་བུས་ཉམས་སུ་བསྟར་བ་མ་གཏོགས་གཉེན་གྲོགས་སོགས་སུས་ཀྱང་བསྐྱབ་ཐབས་མེད་དོ་ཞེས་བསྟན་ཏེ།",
    "ཇི་ལྟར་བདག་ཡིད་བདེ་བར་འདུག།",
    "དེས་ནི་སྐྱེས་མཐའ་འཆི་བ་ལས་མ་འདས་ཤིང་སྡིག་ཅན་ངན་འགྲོར་འགྲོ་བ་ལས་ཀྱང་མ་འདས་པས་དེ་དག་ལ་འཇིགས་ཤིང་སྐྲག་མི་དགོས་ཞེས་དབུགས་འབྱིན་པ་སུའང་མེད་པར་བསྟན་ལ་དེས་ན་སོས་དལ་དུ་བག་བརྐྱང་སྟེ་ཡིད་བདེ་བར་འདུག་པ་མི་རིགས་ཞེས་ཀྱང་བསྟན་ཏོ།",
    "བདག་ནི་འདོད་ཡོན་ལ་ཅི་དགར་སྤྱོད་ནས་གཉེན་དང་ལྷན་ཅིག་ཏུ་ཡིད་བདེ་བར་ཅིའི་ཕྱིར་མི་འདུག་ཅེ་ན།",
    "འདིས་ནི་འདོད་པའི་ལོངས་སྤྱོད་ཕན་བདེའི་རྒྱུར་མི་འགྱུར་ཞིང་ཉེས་པའི་གཞིར་འགྲོ་བས་དེ་ལ་ཆགས་ནས་ཡིད་བདེ་བར་འདུག་པ་མི་རིགས་ཞེས་བསྟན་ཏོ།",
    "དེ་ལྟ་ནའང་གཉེན་བཤེས་སོགས་ཀྱིས་འཆི་དུས་སུ་ཕན་པའི་གྲོགས་བྱེད་པས་ད་ལྟ་བདེ་བར་འདུག་གོ་སྙམ་ན།",
    "སྐྱབས་དང་གྲོགས་བྱེད་པ་སུ་ཡང་མེད་ལ་ལོངས་སྤྱོད་སོགས་ཀྱིས་ཀྱང་ཅི་ཡང་མི་ཕན་པས་ན་དེ་དག་ལ་ཆགས་ཤིང་ཞེན་པར་བྱེད་པ་ནི་དོན་མེད་ཅིང་མི་རིགས་པས་ད་ནི་ལམ་སྒྲུབ་པ་ལ་ཅི་ནས་ཀྱང་འབད་པར་བྱ་རིགས་ཀྱི་དལ་བར་འདུག་པ་མི་རིགས་སོ།",
    "མདུན་དུ་འདུག་སྟེ་བཤགས་པར་བྱ།",
    "ཕ་རོལ་སྨྲ་ཞིང་འདུག་པ་དེའི་བར་དྲན་པ་ལ་གནས་བཞིན་དུ་ཅུང་ཟད་ཙམ་མཉན་པ་ནི་ཉན་མཁན་གྱི་སྒོ་ནས་དང་།",
    "གཞན་གྱི་འདོད་པ་དེ་སླར་ཁོ་རང་ལ་གནོད་པར་འགྱུར་བའམ་དེས་རང་ལ་གནོད་པ་དང་།",
    "སྤྱོད་ཀྱང་རང་རྒྱལ་དགྲ་བཅོམ་ཉིད་ལ་འདོད་བསྐྱེད་ན།",
    "ཉིན་ཞག་དུས་ནི་བསླབ་པ་གཅིག་གཟུང་བ།",
    "སྤྱོད་ན་ཡང་བདག་སྤྱོད་དོ་ཞེས་རབ་ཏུ་ཤེས་སོ་འགྲེང་ན་ཡང་བདག་འགྲེང་ངོ་སྙམ་དུ་རབ་ཏུ་ཤེས་སོ་འདུག་ན་ཡང་བདག་འདུག་གོ་སྙམ་ཏུ་རབ་ཏུ་ཤེས་སོ་ཉལ་ན་ཡང་བདག་ཉལ་ལོ་སྙམ་དུ་རབ་ཏུ་ཤེས་སོ།",
    "འགྲེལ་པ་རྣམས་སུ་བསླབ་པ་ལ་གུས་པའི་བརྩོན་པ་ལྷུར་ལེན་ཞེས་པ་ཙམ་ལས་བག་ཡོད་ལ་སྦྱར་བ་མི་འདུག་གོ།",
    "འགྲོ་འཆག་ཉལ་དང་འདུག་པར་ཤེས་བཞིན་རབ་ཏུ་ལྡན།",
    "ལུས་ཀྱིས་འདི་ལྟར་འགྲོ་བྱ་དང་འཆག་བྱ་སོགས་སྦྱར་ནས་ཤེས་པར་བྱ་དགོས་ཏེ་འདིས་དངོས་སུ་གནས་པའམ་འདུག་པའི་ཀུན་སྤྱོད་བསྟན་ནས་འགྲོ་འཆག་སོགས་ཀྱི་སྤྱོད་པའང་ཤུགས་ལ་བསྟན་པས་སོ་ཞེས་འཆད་པའམ།",
    "ཙ་ན་ཀར་ཡང་།",
