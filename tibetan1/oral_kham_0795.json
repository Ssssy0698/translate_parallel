    "མཐའ་མར་ཁོས་བར་དུ་འདུག་པའི་སྤྱོད་ཚུལ་བཟུང་བ་ལས།",
    "རང་ཉིད་ཀྱི་མཛེས་པ་དེ་བོར་བརླག་བྱེད་པ་ནི་བླུན་པོའི་འགྱོད་གདུང་ཞིག་ལས་མི་གདའ་འོ།",
    "ཡང་ན་ལོ་ཤས་ཀྱི་རྗེས་སུ་བསྐྱར་དུ་བལྟས་དུས་བཟོ་བཅོས་ཀྱི་བསམ་བློ་གསར་བ་རྙེད་ཀྱིན་འདུག་ལོའི་རྩོམ་རིག་དཔྱད་བརྗོད།",
    "ད་ཆ་ཁོའི་གསར་རྩོམ་ལ་མཐོ་རླབས་འཕྱུར་རྒྱུའི་སྔ་ལྟས་འདུག་ཁོའི་སྒྲུང་གཏམ་གསར་རྩོམ་གྱིས་བོད་ཀྱི་སྒྲུང་གཏམ་ལ་སྔར་མེད་པའི་མཛེས་པ་ཞིག་བསྣན་ཡོད་དེ།",
    "ལྷུག་རྗོད་བྱེད་སྟངས་ཀྱི་ཐད་ན་འགལ་བ་བརྗོད་བྱའི་ཆ་ཞིག་དང་གྲིམ་ཤ་ཞིག་འཐེན་འཁྱེར་ཞིག་ཡོད་པ་འདི་རྩོམ་གྱི་བསམ་བློའི་བསྟན་དོན་དུ་གྱུར་པའི་དགེ་སེམས་དང་ཁ་འཕྲོད་པ་ཞིག་ཏུ་མི་འདུག་སྙམ།",
    "གོ་ས་ཆེན་པོ་དེ་རྩོམ་གྱི་བསམ་བློའི་ནང་དོན་གཅིག་པོའི་སྟེང་བཞག་འདུག་སྙམ།",
    "རྩོམ་གྱི་གཟུ་བོའི་རང་བཞིན་ལ་དམའ་ཅུང་ཕབ་འདུག་ཀྱང་།",
    "དེ་བཞིན་སྒྲུང་གཏམ་ལ་ཐོད་བརྒལ་བཟོ་བའི་གེགས་སུའང་གཏམ་དཔེ་རང་གྱུར་འདུག་སྟེ།",
    "རྩིང་རགས་ཤིག་ཏུ་འདུག་སྙམ།",
    "རིན་ཐང་ལྟ་ཚུལ་གྱི་འགལ་འཐབ་ཀྱིས་བསྐྱེད་པའི་སྟོང་སྣང་ལྟ་བུའི་གོང་རིམ་གྱི་རྐྱེན་གྱིས་ཉོབ་ཀྱི་རྐྱེན་ཆེན་པོ་བྱས་ནས་འདུག་དེ་བས་རྩོམ་གྱི་མི་སྣ་ནི་རིན་ཐང་ལྟ་ཚུལ་གྱི་འགལ་འཐབ་ལས་བྱུང་བའི་སྐྱོ་དུབ་ཅན་ཞིག་དང་།",
    "འདིས་སྐྱོ་དུབ་ཅན་གྱི་མི་རབས་ཤིག་མཚོན་འདུག་སྙམ།",
    "མི་རབས་འདིའི་ད་ལྟ་བ་ལ་གཞན་གྱིས་ཁས་ལེན་མི་ཐོབ་ཅིང་རང་ལ་བརྩོན་ལེན་གྱི་ཤུགས་མེད་ལ།",
    "ག་དུས་ཤི་ཡང་མི་འགྱོད་དེ།",
    "ཡིན་འདུག་ཅེས་པ་ནི་དོན་དངོས་སུ་སྣང་ལ།",
    "རང་རང་སོ་སོའི་སྤྱོད་པ་བསྐྱངས་པ་ལེགས།",
    "ཁོང་རང་ཉིད་ཀྱང་དུས་སྐབས་དེའི་བོད་ལྗོངས་མི་དམངས་དང་བསམ་པ་འོ་ཆུ་བཞིན་འདྲེས་ནས་དབྱིན་ཇིའི་བཙན་འཛུལ་ལ་ངོ་རྒོལ་བྱེད་པའི་རྒྱལ་གཅེས་རིང་ལུགས་ཀྱི་བསམ་བློ་མཚོན་ཡོད།",
    "བོད་མི་བྱིངས་ཉོབ་ཅིང་རང་དོན་ཉི་ཚེ་བ་ཞིག་ལ་འདུར་བའི་རྣམ་པ་ལས་བྱུང་བ་དང་།",
    "འོན་ཀྱང་སྤྱིའི་ཆ་ནས་ད་དུང་ཚིགས་བཅད་གསར་བའི་དགེ་མཚན་འདོན་ལུགས་ལ་རང་རྟོགས་ཅན་གྱི་ངེས་ཤེས་གསལ་བོ་རྙེད་མི་འདུག་སྙམ།",
    "འདིའི་ཆ་ནས་སྙན་ངག་པ་སེང་རྡོར་ལ་དགེ་མཚན་ཅུང་ཟད་འདུག་སྙམ།",
    "ཕྱོགས་གཞན་ཞིག་ནས་སྙན་ངག་པ་ནི་མ་གཞི་ནས་བསམ་ཡན་རྒོད་ཅིང་རང་གཤིས་ཡོད་པ་ཞིག་ཡིན་པ་ལ་ཀུན་གྱིས་དེ་འདྲའི་རིགས་འདྲའི་སྙན་ངག་སྤེལ་བ་ལ་ཡ་མི་མཚན་པ་ཅི་ལ་མེད།",
    "ང་རང་ཁྲི་འདིར་བསྡད་པ་ནས།",
    "སྒྲུང་གཏམ་ནི་ཐབས་རྩལ་ཞིག་ཡིན་པ་དམངས་རབ་ཏུ་དགའ་བའི་ཟློས་གར་གྱི་རྩོམ་ཐབས་ཀྱིས་ཡོངས་སུ་ར་སྤྲད་འདུག་གོ།",
    "ཡུམ་གྱི་སྲིན་ལག་ལ་བསྟན་པའི་གཙོ་བོ་ཞིག་འདུག་པ་རྨིས་པས།",
    "འགྲོ་བར་ཕན་ཐོགས་པ་ཞིག་འོང་བར་འདུག་པས་མིང་ཡང་ཤཱཀྱ་སེང་གེར་ཐོགས་གསུང་།",
    "པདག་ཉིད་ཆེན་པོ་འདིས་དེ་ལྟར་ན་བོད་ཀྱི་བནྡེ་འདིར་འོངས་ནས་བསྡད་པ་ལ་དགོས་པ་མི་འདུག་པས་རང་ཡུལ་ལ་འགྲོ་བ་ཞུ་ཞུས་པས།",
    "སྔར་གྱི་ཚལ་བ་ལ་སོགས་པའི་བནྡེ་རྒན་པོ་རྣམས་ལ་འདིའི་ཡོན་ཏན་གྱི་ཆ་ཤས་ཙམ་ཡང་མངའ་བའི་སྔོན་གྱི་གཏམ་རྒྱུད་མི་འདུག་པས།",
    "བནྡེ་བོད་དང་མི་མཐུན་པའི་བརྫུན་ཟེར་བ་ཞིག་འདུག་གསུངས་པ་ལ།",
    "དེ་ལྟ་བུའི་དམ་ཚིག་བསྲུང་མི་ཐུབ་པར་འདུག་གསུངས་པས།",
    "བཅུ་དགུ་ནས་ཚོགས་སུ་མ་བྱོན་པར་གཟིམས་ཁང་རང་དུ་བཞུགས་པ་མཛད།",
    "བོད་འདིར་དུས་སྐབས་ངན་པ་འཆར་ཞིང་ཡུན་རིང་བསྡད་ཀྱང་མི་ལེགས་པར་མང་པོ་མཐོང་བར་འདུག་ཅེས་པ་དང་།",
    "སང་བལྟས་པས་ཉིན་པར་བྲིས་པ་དང་ཁྱད་མི་འདུག་པས།",
    "རང་རང་སོ་སོ་ཇི་ལྟར་དགའ་བ་དེའི་མཐུན་ཕྱོགས་ཁོ་ན་མཛད་དེ།",
    "རང་རང་སོ་སོ་ནས་ས་སྐྱའི་བདག་པོ་བྱ་བར་འདོད་པས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་།",
    "ཁོང་རང་ཡིད་དགའ་སྤྲོ་དང་བཅས་པ་མ་གཏོགས་པ་ཞ་སྡུག་བསྔལ་ཅུཅུང་ཟད་ཀྱང་མ་བྱུང་བ་ལ།",
    "འདི་ཀ་ཙམ་པའི་དེ་བཞིན་གཤེགས་པ་མང་བོས་ཞིང་འདི་ཐམས་ཅད་གང་འདུག་གསུངས་བ་ལ།"
  ]
}