    "རྙོག་པའི་དུས་ཉེ་བ་ན་འདུག་གོ།",
    "ཤཱ་རིའི་བུ་མི་གཞན་གྱིས་བསམ་གཏན་ན་ཧུ་འདུག་པའི་དགེ་སློང་ལ་ཡོན་ཕུལ་བས་ནི་གནམ་གྱི་ལྷས་ཡོན་ཕུལསབ་ཙམ་མི་ཕོད་དོཅི།",
    "སྤྱད་དུ་རུང་བའི་གནས་སུ་འདུག་ལ།",
    "རྐང་པ་བཀྲུས་ཏེ་འདུག་ནས་ཟས་མདུན་དུ་བཞག་སྟེ།",
    "དུས་དུས་སུ་བསམ་གཏན་ན་འདུག་པ་སྲེད་པ་དེ་ལྟ་བུའི་དགེ་སློང་ནི་ངས་ཀྱང་ཡོན་དུ་གནང་ངོ།",
    "ལམ་ངན་པར་ལྷུང་ཞིང་འདུག་པ་ནི་དཔེར་ཕག་གུས་ཁྲི་སྟན་བཟང་པོ་བཏང་བ་དང་མཚུངས་སོ།",
    "མང་པོ་ཚོགས་པའི་ནང་དུ་འདུག།",
    "འགྲོ་ལྡོག་ས་ལ་ཉལ་འདུག་གནས།",
    "༧༥གཡུང་ལི་པེ་སྣར་ཅོ་འདུག་༤༢༨ཞོལ་ན།",
    "ནམ་མཁའི་ངོས་ལ་འདུག་ཅིང་སེམས་དང་བས།",
    "ཚངས་པའི་ལྷ་གང་ལ་ལ་དག་ལུས་དང་སྲོག་ལ་ལྟ་༡་བ་དང་བཅས་པར་གནས་པ་དེ་དག་ནི་ཡོངས་སུ་ཟག་པ་བྱུང་བ་བྱུང་བ་རྣམས་ཀྱིས་སེམས་ཟིན་ནས་འདུག་གོ།",
    "ཚངས་པའི་ལྷ་གང་དག་ཁ་ཅིག་ལུས་དང་སྲོག་ལ་མི་ལྟ་༡༢བ་དེ་དག་ལ་ནི་ཡོངས་སུ་ཟག་པ་བྱུང་བ་བྱུང་བ་རྣམས་ཀྱིས་སེམས་ཀུན་ཏུ་ཟིན་ཅིང་འདུག་པར་མི་འགྱུར་རོ།",
    "ལུས་ལ་མཆིས་པའི་ཉེས་དང་ཡོན་ཏན་གདའ།",
    "སེམས་ལ་མཆིས་པའི་ཉེས་དང་ཡོན་ཏན་གདའ་༢།",
    "དེ་ཡི་ཐ་མ་འཚལ་བར་ནུས་ཀྱང་གདའ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་དགེ་སློང་རབ་ཏུ་ཞི་བའི་བློ་གྲོས་དེས་དེ་བཞིན་གཤེགས་པ་གཟི་བརྗིད་དཔག་མེད་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས་དགེ་སློང་ཞི་བའི་བློ་གྲོས་དེས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཤིན་ཏུ་ཕྲ་སེམས་དེ་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཟླ་བ་སྐར་བཅས་ས་ལ་ལྷུང་ཡང་གདའ།",
    "ནམ་མཁར་འབྲས་ཆགས་ལྷུན་པོ་རྡིབ་༡ཀྱང་གདའ།",
    "སྐད་ཅིག་ཀྱང་མི་འདུག་ཅིང་།",
    "མཆོད་རྟེན་གྱི་གནས་དེ་ཇི་སྲིད་དུ་འདུག་པ་༥",
    "༦༩༩གཡུང་ལི་པེ་སྣར་གང་རང་འབྱུང་།",
    "བྱ་ཁུས་བཏུང་དུ་རུང་བར་མུ་དང་ཁ་ད་ཆད་དུ་འདུག་པ།",
    "དེ་ལྟར་དགེ་སློང་དེ་ཡི་དགས་ཀྱི་འཇིག་རྟེན་ན་བྱ་འདུག་པ་དག་ལ་བརྟགས་ནས།",
    "མགོ་སྦྲུལ་དུ་འདུག་པ་ཁོ་ནར་ཟད་ལ།",
    "གསེར་གྱི་རྒྱལ་པོ་ལམ་མེར་འདུག་པའམ།",
    "དེ་སྟེ་དེས་༦མི་རྒལ་ན་ནི་རི་རབ་ཀྱི་ངོས་ལ་ཚལ་དང་ནགས་ཚལ་འདུག་པ་དག་ལ་ཉི་མའི་ཟེར་གྱིས་ཕོག་པའི་འོད་ཟེར་འབུམ་ཕྲག་མང་པོ་དེའི་གདོང་དུ་བབ་སྟེ།",
    "སྒྲ་གཅན་སའི་འོག་ན་འདུག་པ་ལ་ལྷ་མ་ཡིན་རྣམས་ཀྱིས་སྨྲས་པ།",
    "དུས་ཐམས་ཅད་དུ་རབ་ཏུ་དགའ་བཞིན་དུ་འདུག་པ་དག་དང་།",
    "འདོད་པ་ལ་སེམས་ཞེན་ཅིང་འདུག་གོ།",
    "ཆུའི་སྟེང་ན་ནི་ས་འདུག་སྟེ།",
    "རྟག་ཏུ་མང་བ་ཇི་ལྟར་འདུག་པ་མཐོང་སྟེ།",
    "དེ་ནས་སྒྲ་གཅན་ནི་ལྷ་མ་ཡིན་དེ་དག་ཀུན་གྱི་དང་པོ་ཁོ་ན་ལ་འདུག་སྟེ།",
    "དེ་དང་པོ་ཁོ་ནར་འདུག་སྟེ།",
    "ང་ཉིད་ཀྱིས་ཡུན་རིང་དུ་གཡུལ་འདིར་མ་འདུག་སྟེ།",
    "དེ་འདུག་ན་ནི་རྣམ་པར་རྒྱལ་བ་ཐོབ་པས་དང་ཁྱེད་རྣམས་གཞོམ་པའི་ཕྱིར་དང་།",
    "ལྷ་ལག་ན་ཡོལ་གོ་ཐོགས་པ་ག་ལ་བ་དེའི་མདུན་ཉིད་དུ་འདུག་གོ།",
    "འདི་ལྟར་རབ་དགོད་དང་ཐགས་བཟངས་རིས་དག་ལྷ་རྣམས་ཕམ་པར་བྱ་བའི་ཕྱིར་ཆ་ཞིང་འདུག་གོ།",
    "ཐགས་བཟངས་རིས་ཀྱི་གཡུལ་འགྱེད་པ་གང་ཡིན་པ་དེར་ལྷ་འདུག་པ་ནི་ངས་མ་མཐོང་ངོ།",
    "རི་རབ་གཉིས་ཀྱི་ཚད་ལྟར་འདུག་པ་ཆས་པ་འདི་གཅིག་པུས་ལྷ་འདི་དག་ཐམས་ཅད་ཆད་པས་གཅད་པར་ནུས་སུ་གཤའ་གཤའ་༤ལྟ་ཞིག་ན།",
    "འདི་ལྟར་རབ་དགོད་ནི་ད་དུང་འདུག་སྟེ།",
    "དེ་རྡོ་རྗེ་གསོར་ཏེ་ལྷ་མ་ཡིན་གྱི་དཔུང་ལ་ཀུན་དུ་ལྟ་ཞིང་འདུག་གོ།",
    "ལྷ་རྣམས་ཀྱང་རང་རང་གནས་སུ་དོང་ནས།",
    "ཡལ་ག་དམར་ལ་ལོ་མ་ལྗང་ཁུར་ནའདུག་པ་དང་།",
    "ཡལ་ག་ལྗང་ཁུ་ལ་ལོ་མ་དམར་པོར་འདུག་པ་དག་གོ།",
    "ལྷ་ཕྲེང་ཐོགས་རྣམས་ཀྱིཤེགནས་གསུམ་པ་འབྲས་བུས་༧༧ཉེ་བར་འཚོ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཡོན་ཏན་དཀར་པོ་སྤྱོད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཤིང་ཐམས་ཅད་ཀྱང་རང་ལས་འོད་འབྱུང་སྟེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་ཕྲེང་ཐོགས་རྣམས་ཀྱི་གནས་ཐམས་ཅད་དགའ་བར་གནས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷའི་འཇིག་རྟེན་གྱི་གནས་དག་ནཤེལྷའི་གནས་འགྲོ་མགྱོགས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་ཕྲེང་ཐོགས་རྣམས་ཀྱི་དུགནས་ཡུལ་ལ་ཆགས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷའི་འཇིག་རྟེན་ན་འདོད་པ་ལ་ཆགས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་ཕྲེང་ཐོགས་རྣམས་ཀྱི་གནས་གང་ན་ལྷ་འཁོད་པ་ཚལ་དང་ཉེ་བའི་ཚལ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བུང་བ་ཁ་དོག་སྣ་ཚོགས་ཅན་ཁ་ཅིག་གསེར་གྱི་བྱ་ལྟ་བུར་འདུག་ལ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་ལག་ན་ཡོལ་གོ་ཐོགས་པ་རྣམས་ཀྱི་གནས་སྒྲ་ལ་ཆགས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་༡་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་ལག་ན་ཡོལ་གོ་ཐོགས་པ་རྣམས་ཀྱི་གནས་མེ་ཏོག་ཕྲེང་དགའ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་བརྟགས་ན་ལྷ་ལག་ན་ཡོལ་གོ་ཐོགས་པ་རྣམས་ཀྱི་གནས་ཀུན་ཏུ་ལྟ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་ལག་ན་ཡོལ་གོ་ཐོགས་པ་རྣམས་ཀྱི་གནས་རྟག་ཏུ་དགའ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་ལག་ན་ཡོལ་གོ་ཐོགས་པ་རྣམས་ཀྱི་གནས་དྲི་ལ་ཆགས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "པད་མ་དཀར་སྤྱོད་ཅེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་སྣ་ཚོགས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་མཐོ་བར་གནས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་རྒྱན་ཆང་མྱོས་གནས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་ཆུ་ཝ་བསིལ་གནས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་༦རྟག་ཏུ་མྱོས་གནས་རྣམས་ཀྱི་གནས་བརྟན་དགའ་ཞེས་བྱ་བ་ཇི་༧༥ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་རྣམས་ཀྱི་གནས་སྒྲ་སྙན་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་༢ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་ལྷའི་གནས་དེ་ལ་ཆགས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་སྐྱོར་ཆུས་སྐྱེས་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ཝ་ངོ་སྐེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་པི་བང་ཅན་གསུམ་པ་རྣམས་ཀྱི་གནས་ལུས་དཀར་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བྱའི་ཚོགས་མང་པོའི་སྒྲ་འབྱིན་པའི་རི་བོ་དེ་ལ་འཛེགས་ནས་རིའི་རྒྱལ་པོ་རི་རབ་དྲུག་ཁྲིས་བསྐོར་བ་དེ་རྣམས་ཀྱི་དབུས་ན་རིའི་རྒྱལ་པོ་རི་རབ་འདུག་པ་དེ་དག་ཐམས་ཅད་མཐོང་ངོ།",
    "ལྷའི་འཇིག་རྟེན་ན་ལྷ་ཕན་ཚུན་དགའ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་པི་བང་ཅན་ཉགསུམ་པ་རྣམས་ཀྱི་གནས་ཡང་དག་ཆགས་སྤྱོད་ཅེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དབྱིབས་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པའི་སྒྲ་དང་།",
    "ཟེ་བ་རྡོ་རྗེར་འདུག་པ་རྣམས་ཀྱི་ནང་ན་དགའ་བར་བྱེད་དོ།",
    "རི་བོའི་བར་ན་གནས་པར་འགྱུར་ལ་གཉེན་ཆེ་བ་དང་འབྲེལ་པ་དང་རང་དགར་གནས་པ་དང་།",
    "ལྷ་པི་བང་ཅན་གསུམ་པའི་གནས་སྤྱོད་པ་དང་ལྡན་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཇི་ལྟར་འདུག་པ་ནི་འདི་ལྟ་སྟེ།",
    "དེ་ནས་ཡང་དེ་མཛེས་པར་འདུག་༧",
    "གཟུགས་སྣ་ཚོགས་སུ་འདུག་པ་དག་བརྒྱ་བྱིན་འབའ་ཞིག་ལྟ་ལ།",
    "བརྒྱ་བྱིན་གྱི་སྟན་ཕྱེད་ལ་འདུག་ནས།",
    "ཚལ་དེ་ན་བྱ་དངུལ་གྱི་ཁ་དོག་ཅན་དེ་དག་དེ་རྣམས་ལ་ཆགས་ཤིང་འདུག་པས་ཤིན་ཏུ་མཛེས་པར་བྱས་སོ།",
    "བེེ་ཌཱུརྱའི་ཚལ་དྲི་མ་མེད་པ་དེར་ཞུགས་ནས་ཐགས་སུ་བཏགས་པ་མ་ཡིན་པའི་ལྷའི་སྟན་ཁྲ་བོ་བཏིང་བའི་སྟེང་དུ་འདུག་གོ།",
    "འདུག་ནས་དེའི་ལེགས་པར་བྱས་པའི་ལས་དང་།",
    "འཛམ་བུ་ཆུ་བོའི་གསེར་བཟང་པོའི་སྟན་དེ་ཉིད་ལ་འདུག་པ་དང་།",
    "དེ་ནས་དེ་ལྟར་བརྒྱ་བྱིན་ལྷའི་སྟན་ལ་འདུག་ཅིང་།",
    "བརྒྱ་བྱིན་ག་ལ་བ་དེ་ལོགས་སུ་ཕྱོགས་ནས་འདུག་སྟེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་མཐོ་བ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་རི་རྩེ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བལྟ་ན་སྡུག་པ་གནས་པ་ཞེས་བྱ་བའི་གནས་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཚལ་ཆེན་པོ་དེ་དག་བུང་བ་འདབ་མ་བེེ་ཌཱུརྱ་ལ་ལུས་དངུལ་དུ་འདུག་པའི་ཚོགས་རྣམས་ཀྱིས་མཛེས་པར་བྱས་པ་ཡིན་ཏེ།",
    "དབྱིབས་སྣ་ཚོགས་སུ་འདུག་པ་བྱེ་བ་ཕྲག་སྟོང་དཀྲིགས་པ་དག་བྱུང་ངོ།",
    "འགྲོ་བ་དེ་རྣམས་ཀྱི་ཤིང་རྟ་འབུམ་ཕྲག་དུ་མའི་མུ་ཁྱུད་ཀྱིས་གསེར་གྱི་རྡུལ་བསླང་སྟེ་ནམ་མཁའ་༡ཁྱབ་པར་བྱས་ནས་འདུག་གོ།",
    "མིག་རྒྱས་པ་ལྟ་བུར་འདུག་པ།",
    "དེས་ན་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་ཕྱོགས་གཅིག་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་༩ཐོས་པ་ལས་བྱུང་ཝ་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཤིང་གསེབ་ན་གནས་པ་ཞེས་༡ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཐད་ཀུར་ལྟ་ཞིང་འདུག་པར་མི་བྱེད་པ་དང་།",
    "དེ་ནས་ཡང་ཤིང་གསེབ་ན་གནས་པའི་ལེགས་པར་བྱས་པ་རྣམས་ཀྱི་ལས་ཀྱི་མཐུ་ནི་ལྷ་དག་ལྷའི་པད་མ་ལ་འདུག་ནས་གང་དུ་འགྲོ་བ་དེར་ནམ་མཁའ་དེ་ལས་ལྷའི་བཏུང་བས་གང་བའི་ལྷའི་སྣོད་དག་ལག་ཏུ་འོང་སྟེ།",
    "དེ་ནས་ལྷའི་རྒྱལ་པོ་བརྒྱ་བྱིན་ཡང་པད་མ་འདབ་མ་སྟོང་ལ་སྡོང་བུ་ལྷའི་གསེར་དང་བེེ་ཌཱུརྱ་ལས་བྱས་པའི་སྟེང་དུ་འདུག་ནས།",
    "དེས་ཐོས་པ་ལས་བྱུང་༧བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཤིང་རྟ་སྣ་ཚོགས་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "བུང་མིབ་སྒྲ་འབྱིན་པ་ཁ་དོག་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པ་རྣམས་ཀྱིས་༥༤་པད་མའི་རྫིང་བུ་དེ་དག་ཁེབས་པ་ཡིན་ཏེ།",
    "དེ་བཞིན་དུ་གང་དངུལ་༤༧གྱི་ལྟོར་འདུག་པ་དེའི་སྒྲོ་གསེར་ལ།",
    "ཤིང་གེལ་པ་སྣ་ཚོགས་དག་ཕན་ཚུན་འཛིངས་པར་འདུག་ལ།",
    "དེས་ནཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་དགའ་བ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "སྐད་ཅིག་གཉིས་པར་མི་འདུག་སྟེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ས་རྣམ་ལམཛེས་ན་༥ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་ས་ཡོངས་ཅའདུ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་༥པ་མཐོང་ངོ་སྐེ།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་འདྲེས་པའི་འགྲམ་ན་གནས་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ནེ་ཙོ་ཁ་དོག་སྣ་ཚོགས་སུ་འདུག་པ།",
    "གཟུགས་དང་ཆ་བྱད་སྣ་ཚོགས་སུ་འདུག་པ།",
    "རིའི་རྒྱལ་པོ་རི་རབ་འདུག་པ་དེ་དག་ཐམས་ཅད་ལ་ལྟ་བར་བྱེད་དེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་ཀུན་དུ་གསལ་བར་སྤྱོད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ལྷ་ཐམས་ཅད་ཀྱང་ཟིལ་གྱིས་མནན་ནས་འོད་ཀྱི་ནང་དུ་འདུག་སྟེན།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་དམའ་བ་དང་མཐོ་བ་ན་རྒྱུ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་བཀྲ་བ་སྣ་ཚོགས་ཀྱིས་ཕྱེ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་༡ལྷ་རྣམས་ཀྱི་གནས་སྦྱོར་བ་ལ་འཇུག་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེ་དག་དུས་ཡུན་རིང་དུ་རྩེ་བར་བྱེད་ཀྱང་བག་མེད་པ་ལ་གནས་པ་དག་ཁོང་དུ་མི་ཆུད་དེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་ཞིབ་ཏུ་དཔྱོད་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "ཡིད་དུ་འོང་ལའང་འདུག་མི་བྱེད།",
    "དེ་ནས་བརྒྱ་བྱིན་གྱི་སྔོན་ན་འདུག་པའི་ལྷ་དེ་དག་ཐམས་ཅད་བཅོམ་ལྡན་འདས་ལ་ཝ་ཡིད་དད་པ་སྐྱེས་སོ།",
    "ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཟླ་བའི་གནས་ལྟར་རྒྱུ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "གྲིབ་མ་དེ་དག་ལ་བསིལ་བར་འདུག་ཅིང་དེ་དག་ཀྱང་གདུང་བས་གདུངས་ལ་ཤིན་ཏུ་སྡུག་བསྔལ་བར་གྱུར་པ་ཝ་རྣམ་པ་དེ་ལྟ་བུའི་མ་བྱིན་པར་ལེན་པ་ཡང་ཡོངས་སུ་སྤོང་ཞིང་མི་བྱེད་ལ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཤིང་སཱམཚལ་ཟུང་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "འདུག་ཁྲི་དེ་དག་ཀྱང་སྡུག་པར་བྱས་ཤིང་རྐང་པ་རྣམ་པ་སྣ་ཚོགས་ཀྱིས་མཛེས་པར་བྱས་པའི་འདུག་ཁྲིའི་རྐང་པ་དེ་ལ་ཉེ་བར་བརྒྱན་པ་འདི་ལྟ་སྟེ།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་སུམ་ཅུ་རྩ་གསུམ་པའི་༡ལྷ་རྣམས་ཀྱི་གནས་མིག་ཕྱེ་ཞིང་འགྲོ་བ་དང་བཙུམས་ནས་འགྲོ་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ་གླུ།",
    "ཁ་ཅིག་ནི་བཞོན་པ་མེད་པར་ནམ་མཁའ་ལ་འདུག་སྟེ།",
    "སུམ་ཅུ་རྩ་གསུམ་པའི་ལྷ་རྣམས་ཀྱི་གནས་ཅནོར་བུ་འཕྱང་བ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "རི་ཆེན་པོ་འགུལ་བ་ལྟ་བུར་འདུག་པའི་༡་གླང་པོ་ཆེ་དེ་ལ་ཞོན་པ་ནི།",
    "དེས་ཐོས་པ་ལས་བྱུང་བའི་ཤེས་པས་ལྷ་རྣམས་ཀྱི་གནས་རིས་དའཐུན་པ་ཞེས་བྱ་བ་ཇི་ལྟར་འདུག་པ་མཐོང་ངོ།",
    "དེ་ནས་གསར་དུ་སྐྱེས་པ་དེ་ཤིན་ཏུ་གཞོན་ལ་གཙང་གཙང་ལྟར་འདུག་པར་མཐོང་ཞིང་རྟོགས་ནས།",
    "བྱ་ཁ་དོག་དང་དབྱིབས་དང་འགྲོས་དང་གཟུགས་སྣ་ཚོགས་སུ་འདུག་པ།",
    "བྱད་གཟུགས་རྣམ་པ་སྣ་ཚོགས་སུ་འདུག་པ་དག་མཐོང་ངོ།",
    "དེ་བཞིན་དུ་ལྡུམ་བུའི་ནང་ག་ལ་བ་དེ་རྣམས་འདུག་པ་དང་དེར་ཡང་བྱ་དེ་དག་འདུག་པར་བྱེད་དོ།",
    "ངོ་བོ་ཉིད་ཀྱིས་ལུས་༡་དཀར་ཤམ་ཉིད་དུ་འདུག་པ།",
    "དེ་ནས་ལྷའི་རྒྱལ་༡༡པོ་བརྒྱ་བྱིན་ཁང་བཟངས་ཀ་བ་འབུམ་རྙེད་ནཡོད་པའི་ནང་ན་རྒྱལ་བ་ཐོབ་པ་ཞེས་བྱ་བའི་སེང་གེའི་ཁྲི་ལ་འདུག་གོ།",
    "བདེ་བར་འདུག་པ་གཟི་བརྗིད་འབར་ཞིང་ལྷ་འབུམ་སྙེད་ཀྱིས་རིབསྐོར།",
    "མི་ཤིན་ཏུ་འཇིགས་འཇིགས་ལྟར་འདུག་པ་རྣམས་ཀྱིས་དེད་པར་བྱེད་པ་ན།",
