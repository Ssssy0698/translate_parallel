    "ཐུགས་ཡིད་གཉིས་ཟ་དགོས་པར་མི་གདའ།",
    "དེ་དུས་ཀྱང་འགྲེལ་ཆེན་གསུང་པའི་ལེའུ་དང་པོ་རྫོགས་པའི་མཚམས་ལ་འདུག་བས།",
    "བསྐྱེད་རིམ་དང་མཐུན་པས་བསྐྱེད་རིམ་ཡོངས་སུ་རྫོགས་པར་འོང་བར་འདུག།",
    "དེའི་སྐུ་མདུན་ན་རྗེའི་དྲུང་ནས་བཞུགས་འདུག་པ་ལ།",
    "ཕྱིས་མཇལ་བ་ན་སྐུའི་རྣམ་པ་མནལ་ལམ་དུ་བྱུང་བ་དེ་ཉིད་རང་དུ་འདུག་གསུང་ངོ།",
    "ཞེས་གསུངས་བ་དེ་ལ་དཔྱད་རྒྱུ་ཆེན་པོ་ཞིག་འདུག་གོཞེས་གསུང་ངོ།",
    "ཁྱེད་ཀྱི་འདི་རྣམ་དག་ཅིག་ཡིན་པ་འདུག་ཅེས་གསུང་།",
    "དེ་དུས་འབར་འཇིག་གཉིས་གྲགས་པ་ཆེ་བར་འདུག་པས་སུའི་དྲུང་དུ་ཕྱིན་པ་འཐད་ཞུས་པས།",
    "ཁོང་སྐྱོ་ཤས་ཅན་ཞིག་འདུག་པས།",
    "དེ་ལ་དགོངས་པར་འདུག།",
    "བལྟས་པ་ཙམ་ནས་འདིའི་དོན་འདིར་འདུག་སྙམ་པ་འབད་མེད་དུ་ལམ་ལམ་འཆར་བ།",
    "རྫིང་ཇིའི་རབ་གནས་ལ་སྤྱན་འདྲེན་གྱིན་འདུགོ།",
    "ཅེས་གསུང་པའི་ཚེས་གྲངས་དང་རབ་གནས་མཛད་པའི་ཚེས་གྲངས་གཉིས་ཕྱིས་བརྩིས་བས་མཐུན་པར་འདུག་གོ།",
    "འཁོར་ཕལ་ཆེས་ལ་ཆེད་པ་འོང་ཞིང་མང་པོ་ཞིག་ཚའི་དུས་ཁྱད་པར་འདུག་ཟེར་བ་དང་།",
    "ཅི་བྱེད་བྱས་པས་མེའི་གནོད་པ་བསྲུང་བ་ཡིན་ཟེར་བ་ཞིག་རྨིས་འདུག།",
    "ལུགས་དེ་ཉིད་གཞིར་བྱས་པ་ལའང་རང་ཚིག་འགལ་བའི་ཉེས་པ་ལན་ཅིག་མ་ཡིན་པར་འབབ་པ་དག་མཐོང་བ་ལས་ན།",
    "གྲུབ་ཆེན་ཕལ་ཆེ་བ་དག་མཐུན་པ་ཉིད་དུ་ཡིད་ལ་བརྣགས་ཏེ་འདུག་གོ།",
    "བདག་ཅག་བཏང་སྙོམས་འདུག་པར་མི་རིགས་ཞེས།",
    "དེ་ཉིད་མ་མཐོང་རང་དགར་གྱུར་པ་ཡི།",
    "གཡོ་དང་རང་བཞིན་སྟོང་པར་མཐོང་བ་ཡི།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
