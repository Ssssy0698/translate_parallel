    "འདིའི་སེམས་རིག་གཉིས་སོ་སོར་ཕྱེ་ནས་སེམས་རྣམ་རྟོག་དག་པའི་ངོ་བོ་རིག་པ་ཐོད་རྒལ་དང་ཀ་དག་གཉིས་ལས་བློ་དམན་ཀ་དག་ཉམས་སུ་ལེན་པའི་ཐབས་ཡིན་འདུག་ཀྱང་།",
    "འདི་ལ་ལ་ནས་ཡེ་ཤེས་རྒྱུན་ཆད་ཡིན་པར་བྱས་ནས་འདུག་སྟེ",
    "བེ་རོ་ཙ་ན་ཉོན་ཅིགགནས་པ་དེ་ལྟ་བུ་གནས་ཏེ",
    "དཔེར་ན་ལྷ་ཁང་ན་ལྷ་ཡོད་ཀྱང་མ་མཐོང་ན་ལྷ་ཡོད་པར་འདུག་གམ་སྙམ་པ་ཙམ་ལས",
    "ཙ་ནི་རྒྱལ་པོ་ཨ་ནི་ལྷ",
    "རྡོར་བྲག་པད་ཕྲིན་གྱིས་མཛད་པའི་རང་བྱུང་རང་ཤར་གྱི་བསྙེན་སྒྲུབ་ཀྱི་ཡི་གེ་རྒྱུད་དོན་རབ་གསལ་དང་།",
    "ཁོང་སྐམ་རིད་རང་སོར་གནས་མི་འདུག་ནུབ་པར་གྱུར་པའི་ཞིང་ཁམས།",
    "ཁྱེད་ཀྱིས་བརྗོད་ན་ཁོང་ཅི་འདྲ་འདུག་ཁོང་ཡག་པོ་འདུག་སྒྱིད་ལུག་ཆེ་ཙམ་མ་གཏོགས་ཧ་ཅང་སྤྱང་པོ་ཡོད།",
    "དེ་ངོ་མ་མི་ཚོས་ཧང་སངས་དགོས་པ་ཞིག་འདུག་ཤའོ་པང་༡༨༤༩ལོར་གཤེགས་ཟིན།",
    "མེ་འཁོར་རྗེས་ཟིན་པ་འདུག་ཅེས་བརྗོད།",
    "གནམ་གཤིས་གྲང་ངད་ཅུང་ཟད་ཀྱང་མི་འདུག་རྒྱ་མཚོ་ཆེན་པོ་ནི་འགུལ་མེད་དུ་འགྱུར་བའི་བ་ཡི་འོ་མས་བཀང་དང་མཚུངས་པར་དཀར་ཞིང་གཙང་ལ་མཇམ་ཞིང་མཉེན་པར་མིག་མདུན་དུ་བསྲིངས།",
    "ཁོང་ཁ་ལོ་བའི་སྒྲོམ་ཁང་དུ་བསྡད་མི་འདུག་གམ།",
    "པ་རྣ་ཏེས་བརྗོད་པར་ཁྱེད་རང་དངོས་གནས་ལས་སླ་པོ་མ་བྱུང་།",
    "བཅད་བཀག་མ་གཏོར་བར་ལྟས་ངན་དེ་རྣ་ལྕོག་ནས་འཇུས་ཏེ་འཁྲིད་ཡོང་བའི་ཐབས་ཤེས་ཤིག་བསམ་བློ་འཁོར་གྱི་མི་འདུག་གམ།",
    "གནམ་གྲུ་ཤར་ཕྱོགས་སུ་འཕུར་བའི་དུས་ཚོད་ཆུ་ཚོད་ཁ་ཤས་རིང་མཁའ་དབྱིངས་མཐོན་པོར་འཕུར་བའི་རྐྱེན་གྱིས་ཁ་ཕྱོགས་རྟོགས་ཐབས་བྲལ་རུང་གནམ་གྲུ་ནི་ཁ་ཤར་ནུབ་ཅན་གྱི་ལུང་ཤུར་ཞིག་བརྒྱུད་ནས་འཕུར་གྱི་ཡོད་པའི་ཚོར་སྣང་འདུག་ཅེས་བརྗོད།",
    "འོན་ཀྱང་ད་ལྟ་ཁྱེད་རང་རྒྱ་གར་ནས་བོད་དུ་འཕུར་བཞིན་ནུབ་པར་གྱུར་པའི་ཞིང་ཁམས།",
    "ང་རང་ཉིད་རྨོངས་དད་གང་རུང་ལ་ངོ་རྒོལ་བྱེད་ཀྱི་ཡོད།",
    "དེ་ནས་གཞོན་ནུ་དེས་སྨྲས་པར་སེམས་ཁྲལ་བྱེད་དགོས་མི་འདུག་ས་ཆ་འདི་གར་ཕལ་ཆེར་གནམ་གྱི་མཐའ་ལ་འབྱོར་བ་འདྲ།",
    "ངོ་མ་ཆེས་ངོ་མཚར་ལྡན་པའི་ཡུལ་ལྗོངས་ཤིག་འདུག་ངས་བྱས་ན་རི་དེ་ལ་མིང་ཞིག་ཡོད་ངེས།",
    "དེ་ངས་རྩ་བ་ནས་ཐོས་མྱོང་མི་འདུག་ཧ་ཅང་མཐོ་པོ་ཡོད་དམ།",
    "འདི་ང་མེ་འཁོར་རྗེས་འདེད་བྱེད་དུས་འཕྲད་པའི་དཀའ་ལས་དེ་དང་འདྲ་འདུག་ཅེས་སྨྲས།",
    "ངས་བྱས་ན་ཁྱེད་ཀྱིས་ཉ་ཉུང་མཉམ་བསྲེས་ཀྱིས་བསྙོན་ཏོལ་བྱེད་ཀྱི་འདུག་ང་པ་སི་ཁུག་ཏུ་སེམས་མི་སྐྱིད་པ་འདི་འདྲ་ཐུག་མྱོང་མེད།",
    "ཁྱེད་རང་ལོ་ཉི་ཤུ་ལས་ཟིན་མེད།",
    "ཁྱེད་རང་དངོས་འབྲེལ་དེ་ལྟར་བསམ་གྱི་འདུག་གམ།",
    "ངས་བྱས་ན་ཁྱེད་རང་འདི་གར་མཉེས་ཐག་ཆོད་ཡོང་ངེས་ཡིན།",
    "ཁོང་ག་དུས་ཡིན་རུང་ཐོག་མ་ནས་བག་ཡངས་སྤྲོ་སྣང་ལྡན་པའི་དུས་ཚོད་ནང་རང་ཉིད་འཚབ་འཚུབ་ངོ་གནོང་བ་ཞིག་བཟོ་འདོད་མེད།",
    "གལ་ཏེ་ཕྱི་ཕྱོགས་སུ་འཕྲིན་ཡིག་ཅིག་འཁྱེར་རོགས་བྱས་ན་ཧ་ཅང་ཡག་པོ་ཡོང་བ་འདུག་དེ་ལྟར་བྱུང་ཚེ་གཉེན་ཉེ་དུ་ཚང་མས་སེམས་ཁྲལ་བྱེད་མི་སྲིད།",
    "ངའི་གྲོགས་པོའི་རྣམ་འགྱུར་ལྷིང་པོ་མི་འདུག་འོན་ཀྱང་ང་ཁོང་ལ་འཁང་ར་བྱེད་འདོད་མེད།",
    "ཅེས་དང་ཡང་དེའི་ཐད་ཁྱེད་རང་ཐུགས་ཁྲལ་མི་དགོས།",
    "ཁོང་ག་དུས་ཡིན་རུང་མི་གཞན་ལས་བློ་རིག་བཀྲ་བ་དང་བློ་སྟོབས་ཆེ་བ་ཡོད།",
    "འདི་ལྟར་བྱས་ནའང་དགོད་བྲོ་པོ་འདུག་དེ་ཡིན་དང་ཡིན།",
    "དཔེ་མི་སྲིད།",
    "དེ་ཡང་རང་སྣང་སྐྱིད་པོ་བྱས་པ་ཙམ་ཞིག་ཡིན་པ་ངས་ཤེས་ཀྱི་ཡོད།",
    "སྐུ་ཞབས་ཀྲང་ལགས་ཀྱིས་ག་དུས་ཡིན་རུང་ཆེས་ནན་ཏན་གྱིས་ལན་འདེབས་ཀྱི་ཡོད།",
    "ངས་བྱས་ན་གང་ལྟར་ཡུལ་འདིའི་སྐད་ཤེས་པ་བྱེད་རྒྱུ་ནི་ཁ་ཚ་དགོས་གཏུགས་སུ་འདུག་སྐུ་ཞབས་ཀྲང་ལགས།",
    "ཡིན་ནའི་ད་ཆ་གོ་སྐབས་ཤར་མི་འདུག་སྐུ་ཞབས་ཀྲང་ལགས།",
    "ངས་བྱས་ན་ངས་ཁྱེད་ཚོར་རྒྱུས་མངའ་ཆེ་རུ་ཆེ་རུ་འགྲོ་ཡི་འདུག་དོན་དངོས་ཐོག་ཁྱེད་ཚོ་ནི་མི་ཀུན་དང་༡ནུབ་པར་གྱུར་པའི་ཞིང་ཁམས།",
    "ངས་བལྟས་ན་མི་དེ་ཡ་མཚན་ཆེ་བ་ཞིག་འདུག་ཁང་ཝུའི།",
    "དྲན་གྱི་མི་འདུག་ཅི་ཞིག་ཤེས་རྟོགས་བྱུང་ངམ།",
    "གང་ཡིན་ཟེར་ན་མི་དེས་ག་དུས་ཡིན་རུང་ཁོང་ལ་ཕུན་སུམ་ཚོགས་པའི་བསམ་གཞིག་འཁོར་རྒྱ་བྱིན་པར་བྱེད་པས་ཡིན།",
    "ཇག་པ་ཞིག་ཁོ་པས་མི་མང་པོའི་རྒྱུ་ནོར་བཤུ་གཞོག་བཏང་འདུག་ཁང་ཝུའི་ཡིས་བྱ་ཐབས་ཟད་པའི་ངང་དཔུང་པ་རོང་རོང་བྱས།",
    "གནས་ཚུལ་ཏག་ཏག་བསྡད་མི་འདུག་ཁྱེད་ཚོས་གནས་ཚུལ་དེར་སྣང་བ་སྤུ་ཙམ་ཡང་མི་གཏོང་བ་ཅི་ཡིན།",
    "ངས་སྔ་ས་ནས་ཁྱེད་རང་སུ་ཡིན་པ་ཤེས་བྱུང་།",
    "ཁང་ཝུའི་ཡིས་དགོད་བཞིན་སྦ་གསང་ཡེ་ནས་མེད་པར་སྨྲས་དོན་ཁྱེད་རང་དངོས་གནས་སྤྱང་པོ་འདུག་འོན་ཀྱང་ངས་བྱས་ན་ཧཱུྃ།",
    "འོན་ཀྱང་ཁོ་ཚོས་ཁྱེད་རང་བློ་མགུ་བ་ཞིག་ཡོང་མི་ཐུབ།",
    "ངལ་གསོའི་གནས་དེ་རིགས་ནི་ག་དུས་ཡིན་རུང་འུར་ཟིང་ཟིང་དུ་སྡོད།",
    "ཁོ་ནི་དེས་རྐྱེན་པས་ངོ་མ་ཧང་སང་རུང་རང་ཉིད་སྔར་བཞིན་དཀའ་བའི་གནས་ལས་ཐར་ཐབས་མེད་པའི་སྐབས་སུ་ཉེན་རྟོག་པ་འབྱོར་ནའང་དེ་གར་སྒུག་ནས་སྡོད་དམ།",
    "འོན་ཀྱང་ད་ཆ་བསམ་བློ་མང་པོ་དེ་ཙམ་གཏོང་བའི་དགོས་པ་མ་མཆིས་པས་ཁྱད་དུ་འཕགས་པའི་སྐྱེ་བོ་དེ་ཐུག་ཚེ་ང་ཧ་ཅང་དགའ་པོ་དང་གཟི་བརྗིད་ཆེན་པོ་ཡོང་བ་འདུག་ཁོང་ག་དུས་མཇལ་ཐུབ་བམ།",
    "མཚན་ཕྱི་པོ་འདི་འདྲ་ཆགས་འདུག་དེ་ཅི་མེད།",
    "པ་ཞིག་འདུག་ཅེས་ཞུས།",
    "ཧྥེ་ལོའར་ཐེས་མཐར་ཐུག་ཏུའང་རང་ཉིད་ཀྱི་ནོར་འཁྲུལ་ལ་ངོས་འཛིན་མ་ཐོབ།",
    "ཁོང་རང་ཉིད་ཀྱང་ངལ་གསོ་ཅུང་རྒྱག་དགོས་གལ་ཡོད་པ་ཚོར།",
    "ད་ལྟ་ངས་ཁྱེད་ལ་ཁྱེད་རང་ཐུགས་བློ་མགུ་བའི་མདུན་ལྗོངས་ཤིག་བསྟན་འདོད་ཡོད།",
    "སེམས་གནས་རྒྱུ་ཕར་བཞག་ནུས་པ་ཉིན་ཕྱེད་ཀྱང་བཏོན་འདོད་མི་འདུག་ང་སྐྱེས་དུས་ནས་སྒྱིད་ལུག་ཅན་ཞིག་ཡིན།",
    "ད་ཐེངས་ཁྱེད་དང་མཇལ་བས་ངས་བྱས་ན་ཁྱེད་ལ་སྐུ་མགྲོན་གཞན་སུ་ལའང་མེད་པའི་ཡ་མཚན་གྱི་གཤིས་རྒྱུད་ཅིག་ལྡན་འདུག་པ་དེ་མི་ཚེ་སྟོང་ཟད་གཏོང་བ་མ་ཡིན་ལ་ཡིད་བྱུང་སྐྱོ་ཤས་ཡང་མིན་པར་བློ་ཕམ་ཕྲན་བུ་ཡིན་ངེས།",
    "དེ་ལྟ་བུའི་འཛེམ་དོགས་མེད་པར་སྦས་གསང་བྱེད་ཐུབ་པར་ཁོང་རང་ཉིད་ཀྱང་ཧང་སངས།",
    "ཁང་ཝུའི་ཡིས་དེ་ལྟར་བྱས་ན་ཅི་མི་འགྲིག་པ་མི་འདུག་སྙམ།",
    "ཁང་ཝུའི་ཡིས་ཆིག་ལབ་རྒྱག་བཞིན་ཁོག་རྩིས་ཤིག་བརྒྱབ་པས་བྱས་ན་ཁྱེད་རང་ད་ཆ་དགུང་ལོ་༩༧ལ་ཕེབས་སམ།",
    "དུས་ཚོད་ནི་བློ་ཁོག་ཆུང་བའི་གདོན་འདྲེ་ཞིག་ལ་འགྱུར་ནས་ལུང་ཤུར་གྱི་ཕྱི་རོལ་དུ་སྒུག་ཡོད་པ་དང་ག་དུས་ཡིན་རུང་དུས་ཚོད་ལ་ཡུན་རིང་གཡོལ་བྱོལ་བྱེད་མཁན་སྒྱིད་ལུག་ཅན་དེ་ཚོ་འཁྱུར་མིད་གཏོང་རྒྱུའི་སྟ་གོན་བྱས་འདུག་སྒྱིད་ལུག་ཅན་ལགས།",
    "ངའི་ཚོད་དཔག་དང་ཏག་ཏག་བསྡད་འདུག་ཁྱེད་ཀྱིས་འབད་པ་གང་ཡོང་གནང་བཞག་བྱ་དཀའ་བྱེད་གཏད་དང་ག་དྲ་དེ་དག་ཐམས་ཅད་གང་མགྱོགས་འདས་འགྲོ་ངེས་ཡིན།",
    "ཁོང་ད་ཆ་ལོག་རྒྱུར་བྲེལ་བ་ཆེན་པོ་བྱེད་ཀྱི་འདུག་ཁྱེད་ཁོང་ལ་དགའ་པོ་ཡོད་དམ།",
    "ང་ཁྱེད་ཀྱི་བསམ་འདུན་དེ་སྒྲུབ་ཐབས་བྲལ་བའི་སེམས་ཁྲལ་འདུག་ཁྱེད་ཀྱི་ཤེས་གསལ་ལ།",
    "འོན་ཀྱང་ཟླ་བ་དགུའམ་བཅུ་འདས་རྗེས་ཁོང་རང་བཞིན་དུ་གོམས་སྲིད།",
    "ཚིག་དེ་བེད་སྤྱོད་གཏོང་བའི་དགོས་པ་འདུག་གམ།",
    "ངས་བྱས་ན་ཁྱེད་རང་ནོར་སྒྲོལ་ལ་སེམས་ཤོར་བ་མ་ཡིན་ནམ།",
    "དེ་ནི་མི་སེམས་འགུལ་བའི་སྒྲུང་གཏམ་ཞིག་མ་ཡིན་རུང་ཁྱེད་ཀྱིས་དེ་ནས་བློ་སྒོ་ཞིག་འབྱེད་ཐུབ་ཀྱི་མི་འདུག་གམ།",
    "གྲུབ་འབྲས་དེ་ཚོ་ནི་ཁོམ་དལ་གྱི་དུས་ཚོད་ནང་རང་བཞིན་ལྷུན་དུ་གྲུབ་པ་དང་འདང་རྒྱག་དང་ཏིང་ངེ་འཛིན་པ་ནི་ཤིན་ཏུ་སྤྲོ་བའི་ལས་ཤིག་ཏུ་འགྱུར་ཡོད།",
    "ཁོས་ག་དུས་ཡིན་རུང་ངའི་སྐྱོན་ཚང་འདྲུ་བར་བྱེད།",
    "ཁྱེད་ཚོ་དབྱིན་ཇིའི་དཔོན་རིགས་ཚོས་མི་ལ་བཞག་པའི་ཐོག་མའི་བག་ཆགས་ནི་ག་དུས་ཡིན་རུང་ཧྲང་ཁོབ་ཅན་ཞིག་ཡིན།"
  ]
}