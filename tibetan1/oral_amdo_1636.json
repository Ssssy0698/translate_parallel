    "འོན་ཏེ་སྣང་བར་གྱུར་པའི་དངོས་པོ་ནི་གཅིག་པ་ཉིད་དང་དུ་མ་ཉིད་དུ་རྟོག་པ་དག་གིས་བཟློག་པར་མི་ནུས་ཤེ་ན།",
    "གཅིག་པ་ཉིད་དང་དུ་མ་ཉིད་དུ་རྟོག་པ་དག་གིས་གཞིགས་པར་གྱུར་ཀྱང་དངོས་པོར་རྟོགས་པ་ཡིན་ཏེ།",
    "རབ་རིབ་ཀྱིས་བསླད་པའི་མིག་གིས་ནམ་མཁའི་ངོས་ལ་ཟླ་བ་གཉིས་གནས་པར་མཐོང་ཡང་མེད་པར་ངེས་པའི་ཕྱིར་རོ།",
    "འགའ་ཞིག་གིས་དོན་བྱེད་པར་སྣང་བའི་ཕྱིར་ཏེ།",
    "འདི་ལྟར་དངོས་པོ་མཐོང་བར་གྱུར་པ་འགའ་ཞིག་གིས་དོན་བྱེད་པ་ཡིན་གྱི་སྣང་བ་ཙམ་གྱིས་དོན་བྱེད་པ་མ་ཡིན་ནོ།",
    "དོན་བྱེད་པ་དེ་ཡང་སྔོན་པོ་ལ་སོགས་པར་སྣང་བ་ལས་ཐ་དད་པ་དང་རེག་པ་ལ་སོགས་པར་སྣང་བ་ནི་ཐ་མི་དད་པས་ཡིན་ཏེ།",
    "སྔོན་པོ་ལ་སོགས་པའི་རང་གི་ངོ་བོ་ཉིད་སྣང་བའི་ཕྱིར་རོ།",
    "ཁམས་གསུམ་པ་འདི་ནི་སེམས་ཙམ་མོ་ཞེས་བྱ་བའི་ཚིག་གཞན་འགའ་ཞིག་ཡོད་དོ་ཞེ་ན།",
    "སྣང་བར་གྱུར་པ་ནི་ལུས་ཉིད་ཡིན་པའི་ཕྱིར་ནང་གི་བདེ་བའི་རྣམ་པ་ཅན་ནམ།",
    "ཤེས་པ་རང་རིག་པའི་ངོ་བོ་ཉིད་རང་གི་ངོ་བོ་ཙམ་ལ་གནས་པའི་ཕྱིར།",
    "རང་གི་ངོ་བོ་ཉིད་སྣང་བ་ལ།",
    "གལ་ཏེ་ཤེས་པ་གཉིས་ཀྱིས་རང་གི་ངོ་བོ་དང་གཞན་གྱི་ངོ་བོ་གསལ་བར་བྱེད་པ་ཉིད་ཡིན་ན།",
    "ཤེས་པའི་རང་གི་ངོ་བོ་ཉིད་རིག་ན་གཞན་རིག་པ་བདག་ཉིད་དུ་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "གཞན་ཡང་བདག་གིས་འདི་དག་མཐོང་ངོ་ཞེས་བྱ་བའི་ཤེས་པ་མེད་པར་འགྱུར་ཏེ།",
    "འོན་ཏེ་བདག་གིས་མཐོང་བ་ཐ་དད་པ་ལ་འགལ་བ་ཅི་ཡོད་ཅེ་ན།",
    "ཕྱོགས་དེ་ལ་ཡང་བདག་གི་རང་བཞིན།",
    "གང་གིས་བདག་རིག་པའི་རང་བཞིན་དེ་ཉིད་ཀྱིས་དོན་ནམ།",
    "བདག་གི་རང་བཞིན་ནི་བདག་གི་ངོ་བོ་ཉིད་ལ་གནས་པའི་ཕྱིར་རོ།",
    "རང་གི་ངོ་བོ་ཉིད་ལ་གནས་པའི་རང་བཞིན་གང་ཡིན་པ་ནི་བདག་ལ་མངོན་དུ་ཕྱོགས་པ་ཁོ་ན་ཡིན་པའི་ཕྱིར་རོ།",
    "འོ་ན་རང་དང་གཞན་ལ་མངོན་དུ་ཕྱོགས་པ་གཉིས་སུ་གང་གིས་ཤེས་པ་ཡིན།",
    "བདག་གིས་ཤེས་སོ་ཞེ་ན།",
    "འོན་ཏེ་མངོན་དུ་ཕྱོགས་པ་གཉིས་དང་བདག་ནི་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་འཛིན་པ་ཡིན་ནོ་ཞེ་ན།",
    "དེ་ཡང་རིག་པ་པོའི་བདག་གཞན་དགོས་པའི་ཕྱིར་དེ་ཡང་ཐུག་པ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "སྔོན་པོ་དག་གི་ནང་ནས་གཅིག་སྟེ།",
    "གཉི་ག་བདེན་མོད་ཅེ་ན།",
    "དེ་དག་གི་རྣམ་པ་དེ་ལས་ཐ་དད་པའི་ཕྱི་རོལ་གྱི་རང་གི་མཚན་ཉིད་ཤེས་པ་དག་པའི་མཚན་ཉིད་ཅན་གྱི་ངོ་བོ་ཡོད་པ་མ་ཡིན་ཏེ།",
    "རང་གི་ཡུལ་དུ་གཞན་འོང་བའི་བགེགས་བྱེད་པ་ནི་གཟུགས་ཀྱི་མཚན་ཉིད་དོ།",
    "ཁམས་ལ་སོགས་པ་ཐམསཅད་ཀྱི་བྱེ་བྲག་གི་མཚན་ཉིད་བྱ་བ་དེ་ཡང་།",
    "གླང་པོ་ཆེའི་གཟིགས་སྟངས་མཛད་ནས་འཇིག་རྟེན་པ་མ་དག་པའི་ཤེས་པ་ཅན་ཕྱིན་ཅི་ལོག་གི་ཤེས་པ་ལ་བརྟེན་ནས་ཕུང་པོ་དང་ཁམས་དང་སྐྱེ་མཆེད་ལ་སོགས་པ།",
    "དེ་དག་གིས་ནི་འདི་སྐད་དུ་སྟོན་པ་ཡིན་ཏེ།",
    "གལ་ཏེ་དབྱེ་བར་མི་ནུས་ན་གཅིག་ཉིད་ཡིན་མོད།",
    "གང་གི་ཕྱིར་ཁང་བཟངས་ཀྱི་ལྕོག་དཀར་པོ་མཚན་མོ་ཟླ་བའི་འོད་ཟེར་ལ་མཐོང་བ་དང་།",
    "མཚན་མོ་སྣང་བའི་རྣམ་པ་ནི་སྒྲོན་མ་མེད་ཀྱང་ཡོད་པར་དཔྱོད་ན་དོན་ཉིད་ཁས་བླངས་པར་འགྱུར་ཏེ།",
    "གཅིག་གི་རྣམ་པ་དང་ལྡན་པར་ཉམས་སུ་མྱོང་བར་འགྱུར་ཏེ།",
    "མྱོང་བ་ཉིད་ཀྱི་རང་གིས་ནུས་པས་བསྐྱེད་པའི་དྲན་པ་མི་མཐོང་ལ།",
    "གང་གི་ཚེ་ལུས་ཅན་གཅིག་གིས་སྣ་ཚོགས་མཐོང་བ་དེ་ཉིད་སྲོག་ཆགས་གཞན་ལ་མི་མཐུན་པར་སྣང་བས་ཕྱི་རོལ་མ་ཡིན་ནོ།",
    "དེ་ལྟ་མོད་ཀྱི་ཕྱི་རོལ་གྱི་སྣ་ཚོགས་པ་ནི་གསལ་བར་ཐ་དད་པར་བསྟན་པར་འགྱུར་རོ།",
    "སྣ་ཚོགས་གཅིག་གི་ངོ་བོར་འགྱུར།",
    "ཇི་ལྟར་ཤེས་པ་མི་གཞན་གྱིས་མཐོང་ཞིང་དུས་གཞན་དུ་སོང་བ་ཡང་མ་ཡིན་ལ།",
    "ཡན་ལག་གི་དོན་རྣམས་ཐ་མི་དད་པར་སྣང་བ་ན།",
    "ཡན་ལག་གི་གཟུགས་ཐ་དད་པ་ཅན་བོར་ན་གཞན་ཡན་ལག་ཅན་གྱི་ངོ་བོ་ཉིད་ཐ་མི་དད་པ་མཐོང་བ་མ་ཡིན་ཏེ།",
    "འོ་ན་གལ་ཏེ་ཐ་དད་པར་མཐོང་བ་དེའི་ཚེ་ཅིག་ཅར་དུ་མ་མཐོང་བར་ཁས་བླང་བར་བྱས་ན་ཐལ་བར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "ཕན་ཚུན་དུ་སྣང་དུ་རུང་བའི་མཚན་ཉིད་ཅན་གྱི་ཕུལ་དུ་བྱུང་བའི་སྐྱེ་བ་གང་ལ་ཡོད་པའི་རྡུལ་ཕྲ་རབ་མང་པོ་དེ་དག་གིས་དུས་གཅིག་ཏུ་མིག་གི་བློ་གཅིག་གི་རྒྱུར་གལ་ཏེ་འགྱུར་ན་ནི་འདི་ལ་འགལ་བ་ཅི་ཞིག་ཡོད།",
    "འོན་ཏེ་རྡུལ་ཕྲ་རབ་རྣམས་རྒྱུ་ཉིད་དུ་འགྱུར་མོད་ཀྱི།",
    "མིག་ལ་སོགས་པ་རྣམས་ཀྱང་མཐོང་བར་ཐལ་བར་འགྱུར་ཏེ།",
    "དེ་ལ་གང་གི་རྣམ་ཅན་བློ།",
    "དེ་ལ་མིག་ལ་སོགས་པའི་རྒྱུ་རྣམས་ཀྱི་ནང་ནས་རྡུལ་ཕྲ་རབ་ཀྱི་རྣམ་པ་ཅན་གྱི་བློ་གང་ཞིག་གིས་བསྐྱེད་པའི་མིག་གི་བློ་དེའི་རྒྱུ་རྡུལ་ཕྲ་རབ་རྣམས་ཁོ་ན་གཟུང་བར་བྱ་བར་བརྗོད་དོ།",
    "ཇི་ལྟར་རང་གི་ཡན་ལག་བཅས།",
    "འོ་ན་ཇི་ལྟར་རང་གི་ཡན་ལག་རྭ་ལ་སོགས་པ་དང་ལྷན་ཅིག་དུས་གཅིག་ཏུ་ཅིག་ཅར་ཡན་ལག་ཅན་བ་ལང་ཉིད་གཟུང་བར་འགྱུར།",
    "བ་ལང་གི་ཤེས་པ་ལ་དག་པའི་རྫས་སྣང་བའི་ཕྱིར་རོ་ཞེ་ན།",
    "དེའི་ཕྱིར་རྭ་དང་བཅས་པའི་བ་ལང་གི་རྫས་མཐོང་བ་ལ་ཡང་ཅིག་ཅར་དུ་མ་འཛིན་པ་གྲུབ་པར་འགྱུར་རོ།",
    "གཙོ་བོ་སྟེ་བ་ལང་གི་རྫས་ཁྱད་པར་ཅན་དང་ལྷན་ཅིག་བ་ལང་རྭ་ཅན་ནོ་སྙམ་དུ་འཛིན་པར་འདོད་ན་ཡང་རྡུལ་ཕྲ་རབ་རྣམས་ཕན་ཚུན་ཁྱད་པར་དང་ཁྱད་པར་ཅན་གྱི་དངོས་པོས་གནས་པ་མ་ཡིན་པ་དེའི་ཕྱིར་དེ་དག་ཅིག་ཅར་འཛིན་པ་མ་ཡིན་ནོ་ཞེ་ན།",
    "ཡན་ལག་རྫོགས་པ་གང་ལ་ཡོད་པའི་བ་ལང་གི་རྫས་དེ་མི་སྣང་བ་ཉིད་དུ་འགྱུར་ཞིང་།",
    "འདི་ལྟར་བ་ལང་གི་རྭ་དང་བ་ལང་རྭ་ཅན་ཞེས་ལ་ལར་འགའ་ཞིག་གི་ཁྱད་པར་ཡང་ཁྱད་པར་ཅན་གྱི་དངོས་པོར་ཤེས་པ་ཡིན་ནོ།",
    "གལ་ཏེ་ཅིག་ཅར་དུ་མ་མི་འཛིན་ན་དེ་ལྟ་ན་ནི་བ་ལང་གི་རྫས་རང་ཉིད་རྟ་ལ་སོགས་པའི་དངོས་པོ་གཞན་ལས་ཐ་དད་པ་མེད་པ་སྟེ།",
    "བློ་སྟེ་དེ་ལྟའང་དེ་དག་གི།",
    "འོན་ཏེ་དང་པོ་རྫས་གཅིག་གི་རྣམ་པ་ཅན་ཉིད་ཡིན་ལ།",
    "གཞན་ཡང་དུས་ཕྱིས་གང་གི་ཁྱད་པར་ཅན་ཞེས་ཁྱད་པར་འཛིན་མི་ཤེས་ཏེ།",
    "རེག་བྱ་དང་།",
    "རིགས་མཐུན་པ་དང་རིགས་མི་མཐུན་པ་ཐམས་ཅད་ལས་ལོག་པའི་བ་ལང་གི་གོང་བུ་མཐོང་ན་ནི།",
    "བ་ལང་གི་རྫས་མ་ཡིན་པ་དག་དང་དཀར་པོ་མ་ཡིན་པ་གང་ལས་ལྡོག་པའི་ལོག་པ་དེ་ལས་ཐ་དད་པ་དེ་ཡིས་གཞག་པའི་རྟོག་པ་གང་ལས་ཡོད་པ་དུ་མའི་ཚུལ་ཅན་དེ་ཡིན་ནོ།",
    "འོན་ཀྱང་དབྱིབས་དང་ཁ་དོག་གི་བདག་ཉིད་ཅན་གྱིས་གསེར་དུ་སྣང་བའི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར།",
    "སྣ་ཚོགས་མིན་པའི་རེས་འགའ་བ།",
    "རྟོག་པ་མེད་པ་མངོན་སུམ་གྱིས་སེམས་རེས་འགའ་བ་སྣ་ཚོགས་མ་ཡིན་པར་སྣང་བ་ནི་རྟོག་པའི་ཤེས་པའི་སྣ་ཚོགས་སྣང་བ་ནི་མཐོང་བའི་ཡུལ་མ་ཡིན་ཏེ།",
    "དོན་དང་འབྲེལ་པས་ཀྱང་མངོན་སུམ་རེས་འགའ་བ་ཉིད་ཀྱིས་བརྟགས་པའི་རང་བཞིན་ཐ་དད་པའི་རེས་འགའ་བ་ནི་མཐོང་བ་མ་ཡིན་ནོ།",
    "མངོན་སུམ་དང་སྒྲ་ལས་སྐྱེས་པའི་ཤེས་པ་དག་གི་ངོ་བོ་ཉིད་གསལ་བ་དང་མི་གསལ་བའི་བྱེ་བྲག་ཐ་དད་པ་ཡིན་པ།",
    "རབ་རིབ་ཀྱིས་བསྒྲིབས་པའི་མིག་གིས་ཀྱང་མི་གསལ་བར་མཐོང་བ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་འདིར་ཡང་མིག་གི་ཉེ་བར་ལེན་པ་ལས་སྐྱེས་པའི་ཤེས་པས་གསལ་བའི་ངོ་བོ་ཉིད་ཡོངས་སུ་གཅོད་ལ་སྒྲའི་རྗེས་སུ་འབྲང་བའི་ཤེས་པ་སྐྱེས་པས་ནི་མི་གསལ་བར་འཛིན་པ་ཡིན་ནོ་ཞེ་ན།",
    "མངོན་སུམ་གྱི་སེམས་དང་སྒྲའི་སེམས་ཀྱི་རྟེན་དེ་རྒྱུ་གཞན་དང་གཞན་ལས་སྐྱེ་བ་ཡིན་མོད་ཀྱི།",
    "དེ་ནི་སྒྲ་ཤེས་པས་གཅིག་གི་ཚུལ་དུ་འཛིན་པ་ཡིན་ཏེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་དང་དེས་དྲངས་པའི་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པས་སོ་ཞེས་གསུངས་སོ།",
    "དེ་ལྟ་མོད་ཀྱི་ཡིད་ཀྱིས་སྔར་མཐོང་བའི་དོན་འཛིན་པར་འགྱུར་རོ།",
    "གང་གི་གཟུང་ཟིན་པ་ཉིད་མཐོང་བར་བྱེད་པས་དེ་ཇི་ལྟར་འཛིན་པ་ཡིན།",
    "གང་གི་ཁྱད་པར་དང་བཅས་པའི་དངོས་པོ་འཛིན་པའི་ཕྱིར།",
    "རང་གི་ངོ་བོར་སྣང་བས་མཐོང་བ་ཡིན་ནོ།",
    "གང་གིས་ན་གཟུང་བ་འཛིན་པར་ཤེས་པ་གཞན་གྱིས་འགྱུར་བ་ཡིན།",
    "ཤེས་པ་གང་གི་དུས་ཇི་སྲིད་པ་ཅན་གྱིས་དོན་དེ་ཙམ་ཉམས་སུ་མྱོང་བར་འགྱུར་ཏེ།",
    "འདི་ལྟར་གཟུགས་ནི་ཤེས་པ་གཉིས་པོ་དག་གིས་ཤེས་པའོ་ཞེས་གསུངས་པའི་ཕྱིར།",
    "ཡིད་ཀྱི་མངོན་སུམ་ཡིན་མོད།",
    "རང་གི་ཡུལ་གྱི་སྐད་ཅིག་མ་གཉིས་པ་འཛིན་པར་བྱེད་དོ།",
    "གང་གི་ཕྱིར་རང་གི་ཤེས་པ་ཡིན་གྱི་རྣམ་པར་ཤེས་པའི་དུས་དེ་གང་ལ་ཡོད་པ་སྟེ།",
    "ཡིད་ཀྱི་རྣམ་པར་ཤེས་པའི་ཡུལ་གྱི་དོན་རང་གི་ཤེས་པ་དང་དུས་མཚུངས་པ་ཅན།",
    "ཡུལ་རང་གི་འཛིན་པར་བྱེད་པའི་བློ་དང་ལྷན་ཅིག་དུས་མཚུངས་པ་ཅན་དུ་མི་འགྱུར་རོ།",
    "ཤེས་པ་རང་གི་རྣམ་པར་གཏོད་པར་ནུས་པ་དེ་ལ་འདོད་ཀྱི།",
    "འོ་ན་རང་གི་ངོ་བོ་ཉིད་ཀྱི་རྣམ་པར་ཤེས་པ་ལ་སྣང་བ་གཟུང་བ་ཉིད་མ་ཡིན་ནམ།",
    "རང་གི་ཤེས་པ་ལ་སྣང་བ་ནི་དུས་མཚུངས་པ་ཅན་ཡིན་པ་དེའི་ཕྱིར་ཇི་ལྟར་རྒྱུ་ཉིད་གཟུང་བར་འགྱུར་ཞེ་ན།",
    "དངོས་པོའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་རྟག་ཏུ་སྣང་བར་ཐལ་བར་འགྱུར་རོ།",
    "འོན་ཏེ་ཤེས་པ་ཡོད་ན་མཐོང་གི་གཞན་དུ་མ་ཡིན་ནོ་ཞེ་ན།",
    "འོན་ཏེ་མིག་གི་རྣམ་པར་ཤེས་པ་མིག་ལ་སོགས་པ་སྣ་ཚོགས་པའི་རྒྱུའི་ཐུན་མོང་ཅན་ཡིན་ན།",
    "རྒྱུ་གང་ཞིག་གི་རྗེས་སུ་བྱེད་པ་ཅན་དུ་སྐྱེ་བའི་འབྲས་བུ་དེ་ནི་རྒྱུ་དེས་བཞག་པ་སྟེ།",
    "རང་གི་ངོ་བོ་ལ་མ་ཡིན་ན་ནི།",
    "གལ་ཏེ་དོན་ལ་རྟོག་པ་རང་གི་ངོ་བོ་ལ་ཡང་རྟོག་པར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "གང་གི་ཕྱིར་གཞན་ལ་མི་བརྟེན་པ་སྟེ་ཐུན་མོང་མ་ཡིན་པ་རང་རིག་པའི་ཡུལ་ཡིན་པས་ཏེ།",
    "གང་གི་ཕྱིར་བདེ་བ་ལ་སོགས་པའི་བདག་ཉིད་བརྡ་བྱེད་པར་མི་ནུས་པའི་ཕྱིར།",
    "རང་གི་ངོ་བོ་ཇི་ལྟར་རིག།",
    "རེ་ཞིག་ཤེས་པ་གང་ཞིག་གཞན་གྱི་རིག་པར་བྱེད་པ་དེས་ཀྱང་ཇི་སྲིད་རང་གི་ངོ་བོ་ཤེས་པ་མ་ཡིན་ན་ཡང་བདེ་བ་ལ་སོགས་པ་དེ་གཞན་གྱི་རིག་པར་བྱེད་པ་པོ་མ་ཡིན་པས་རང་གི་ངོ་བོ་སྟེ་བདག་ཉིད་ཀྱི་རང་བཞིན་ཇི་ལྟར་རིག་པར་འགྱུར།",
    "གང་གི་ཕྱིར་ཐམས་ཅད་དུ་འབྲས་བུ་ཐ་དད་པར་བྱེད་པ་ནི་རྒྱུ་ཐ་དད་པ་ཡིན་ཏེ།",
    "རྒྱུ་གཅིག་ལས་འབྲས་བུ་ཐ་དད་པར་མཐོང་བའི་ཕྱིར་ཐལ་བ་དང་དུ་བ་བཞིན་ནོ།",
    "རང་གི་དོན་ནི་རང་གི་ཡུལ་ཡིད་འཕྲོག་པ་ཡོད་ཅིང་།",
    "མིག་གི་བློ་ཡང་མ་ཡིན་ཏེ།",
    "མིག་དང་གཟུགས་དང་ཡིད་ལ་བྱེད་པ་དེ་དག་ཉིད་ནང་གི་ཁྱད་པར་ལས་རྟོགས་པའི་ངོ་བོར་མཚུངས་ཀྱང་།",
    "དཔེར་ན་བློ་དེ་ཉིད་གོམས་པའི་བྱེ་བྲག་གིས་གསལ་བ་དང་མི་གསལ་བ་དང་ཐེ་ཚོམ་ཟ་བའི་ཁྱད་པར་བཞིན་ནོ།",
    "འོན་ཏེ་བདེ་བ་ལ་སོགས་པ་རྟོགས་པའི་ངོ་བོ་ཉིད་ཡིན་མོད་ཀྱི།",
    "མིག་གིས་བདེ་བ་མྱོང་བ་སྐྱེད་པ་མ་ཡིན་ཏེ།",
    "རྗེས་སུ་དཔག་པ་ཡང་མིག་ལས་སྐྱེ་བར་ཐལ་བར་འགྱུར་རོ་ཞེས་བསྟན་ཏོ།",
    "གཅིག་གིས་གཉིས་ཤེས་མ་ཡིན་ཏེ།",
    "བདེ་བ་ལ་མིག་འཇུག་པར་ནི་འགའ་ཞིག་གིས་ཀྱང་ཤེས་པ་མ་ཡིན་པའི་ཕྱིར་རོ།",
    "འོ་ན་གང་གི་ཚེ་སེར་པོ་དང་ལྷན་ཅིག་སྔོན་པོའི་ཤེས་པ་ལ་སྣང་བ་དེའི་ཚེ་སྔོན་པོའི་ནུས་པ་མ་ཡིན་ཏེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་སྐྱེད་པ་ལ་བདེ་བ་ལ་སོགས་པ་ལ་ནུས་པ་ཅི་ཞིག་ཡོད་དེ་མེད་པ་ཉིད་དེ།",
    "གང་གི་ཕྱིར་བདེ་བ་ལ་སོགས་པ་དེ་ལས་སྐྱེས་པའི་བློ་མི་འདོད་པའི་ཕྱིར་རོ།",
    "མིག་གི་བློ་ལ་གཟུགས་ཉིད་ཕན་འདོགས་པར་ཁས་ལེན་པའི་ཕྱིར་རོ།",
    "གཟུགས་སོགས་བུད་མེད་སོགས་ཐ་དད།",
    "ནམ་ཡང་མིག་གིས་འཛིན་མི་འགྱུར།",
    "ཕྱི་རོལ་གྱི་དོན་མེད་པར་དེ་ཡིས་བསྐྱེད་པའི་བདེ་བ་ལ་སོགས་པ་མིག་ལ་སོགས་པས་མྱོང་ན་ནི་བདེ་བ་དང་སྡུག་བསྔལ་ལ་སོགས་པའི་རྒྱུ་གཟུགས་ལ་སོགས་པ་ཐ་དད་པ་རྗེས་སུ་མཐུན་པ་དང་མི་མཐུན་པའི་བུད་མེད་ལ་སོགས་པ་ཐ་དད་པར་མི་འཛིན་པ་ཡིན་ཏེ།",
    "འོ་ན་ཇི་ལྟར་བདེ་བ་ཉེ་བས་འཛིན་པ་དེ་བཞིན་དུ་ཕྱི་རོལ་ཡང་མིག་གིས་འཛིན་པར་འདོད་ཅེ་ན།",
    "ནང་གི་རྒྱུ་ཉེ་བར་གྱུར་པ་བདེ་བའི་མཚན་ཉིད་ཅན་གྱི་དོན་ནུས་པ་ཅན་དུ་གྲུབ་ན།",
    "བློ་ནི་བུད་མེད་ལ་སོགས་པ་ཐ་དད་པའི་ཕྱི་རོལ་ལ་མཐོང་བར་རིགས་པ་མ་ཡིན་ནོ།",
    "གཅིག་གིས་བདེ་བ་དང་གཟུགས་རིག་པར་བཀག་པ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་ཅིག་ཅར་བདེ་བ་དང་སྡུག་བསྔལ་སྐྱེ་བ་མ་ཡིན་ནོ།",
    "ནང་གི་ཉེར་ལེན་ཤེས་པ་ནི།",
    "གཅིག་གི་མིན་པར་འདོད་ཅེ་ན།",
    "རྣམ་པར་ཤེས་པ་ནང་གི་ཉེ་བར་ལེན་པའི་རྒྱུ་ཡོད་ན།",
    "ཉེ་བར་ལེན་པ་གཅིག་གིས་འགལ་བའི་འབྲས་བུ་ཅིག་ཅར་མི་སྐྱེད་དོ་ཞེས་བྱ་བ་འདི་ནི་རིགས་ཏེ།",
    "དཔེར་ན་སྣང་བའི་སྒྲོན་མ་གཅིག་མཚན་མོ་རྒྱུ་བའི་འུག་པས་གཟུགས་མཐོང་བ་དང་མི་མཐུན་པ་དང་།",
    "དེ་ལས་གཞན་པ་ཉིན་མོ་མཐོང་བ་ཅན་གྱིས་གཟུགས་མཐོང་བ་དང་མཐུན་པར་བྱེད་པ་བཞིན་ནོ།",
    "རང་གི་བདག་ཉིད་རིག་པ་པོ།",
    "དཔེར་ན་གཟུགས་སྣང་བ་ཡོད་ཀྱང་རེས་འགའ་ཉིད་རྟོགས་པ་སྐྱེའི།",
    "དྲན་པ་དང་ངོ་ཤེས་པ་དག་གི་བཞིན་ནོ།",
    "འོ་ན་གལ་ཏེ་དྲན་པ་ལ་དོན་སྣང་སྟེ་མངོན་སུམ་བཞིན་ཡིན་ན་དྲན་པའི་ཡུལ་དོན་རྟོགས་པར་འགྱུར་བས་དྲན་པས་དོན་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་གསལ་བར་གྱུར་ན་མངོན་སུམ་མ་ཡིན་པར་འགྱུར་བར་མི་རུང་སྟེ།",
    "རང་གི་ངོ་བོ་ཉིད་གསལ་བ་ཉིད་མངོན་སུམ་ཡིན་པའི་ཕྱིར་དང་།",
    "འོ་ན་ལྐོག་ཏུ་གྱུར་པ་ཉིད་དུ་གང་གིས་ཤེས།",
    "རང་གི་བདག་ཉིད་དེ་བདེ་བ་ལ་སོགས་པའི་རྣམ་པའི་ཡང་རིག་པ་པོ་ཡིན་ནོ།",
    "དེ་བས་ན་དེ་ལས་འདུ་བྱེད་པ་འཇུག་པར་གྱུར་པའི་དོན་ནང་གི་རེག་བྱའི་ཁྱད་པར་བདེ་བ་ལ་སོགས་པའི་རྣམ་པས་ཐ་དད་པ་རང་གི་བདག་ཉིད་དུ་གྱུར་པ་ཉིད་རིག་པ་པོ་ཡིན་པའི་ཕྱིར་རང་རིག་པ་ཁོ་ན་ཡིན་ནོ།",
    "འདི་ལྟར་འཁྱུད་པས་བདེ་བ་འདུས་བྱས་ན་ཤིན་ཏུ་བརྟན་པར་སྐྱེས་ནས་ཡང་རེག་པ་དང་ལྷན་ཅིག་སྤྱོད་པའི་གཟུགས་མཐོང་བ་ལས་སད་པར་གྱུར་པས་དེ་ལྟ་བུར་གྱུར་པ་ཉིད་ཀྱི་ནང་གི་རེག་པའི་བདེ་བ་སྐྱེ་བར་འགྱུར་བ་བཞིན་ནོ།",
    "ནང་གི་རེག་བྱའི་ཁྱད་པར་ཡིན་ཏེ།",
    "བདེ་བ་ལ་སོགས་པ་དེ་དག་གིས་ཉམས་སུ་མྱོང་བར་འགྱུར་རོ།",
    "རང་གི་ངོ་བོ་ཉམས་སུ་མྱོང་བའི་ཕྱིར།",
    "བདེ་བ་ལ་སོགས་པ་དམིགས་པ་དག་ནི་ནང་གི་རེག་བྱ་སྣང་བ་ཅན་ཉིད་དོ།",
    "སྨྲ་བར་བྱེད་པ་དེ་དག་གིའང་།",
    "སྔོན་པོ་ལ་སོགས་པ་དང་བདེ་བ་ལ་སོགས་པའི་ངོ་བོ་ཐ་དད་པར་སྣང་བ་གང་ལ་ཡོད་པའི་སེམས་དེ་དག་གི་གཟུང་བའི་ཡུལ་ནི།",
    "གོམས་པའི་བྱེ་བྲག་ལས་བུད་མེད་གཅིག་ལ་དགའ་བ་དང་ཡོངས་སུ་གདུང་བ་སྐྱེ་བར་མཐོང་བ་ཡང་ཡིན་ནོ།",
    "བདེ་བ་ཕུལ་དུ་བྱུང་བ་ཡང་འགྲོ་བ་བཟང་མོའི་མིག་དང་ནུ་མ་དང་འཛུམ་པ་ལ་སོགས་པའི་ཆ་བྱད་ཀྱི་བྱེ་བྲག་གིས་རང་བཞིན་ཐ་དད་པར་འགྱུར་བའི་ཕྱིར་བདེ་བ་ལ་སོགས་པ་ནི་སྔོན་པོ་ལ་སོགས་པའི་རང་བཞིན་ཅན་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་བློ་ཡང་བདེ་བ་ལ་སོགས་པའི་བདག་ཉིད་ཅན་ཡིན་པས་གོམས་པའི་བྱེ་བྲག་གིས་བློ་ཤིན་ཏུ་ཕུལ་དུ་བྱུང་བ་ན་དེའི་བདག་ཉིད་དུ་གྱུར་པ་རྣམས་ཕུལ་དུ་བྱུང་བར་འགྱུར་བའི་ཕྱིར།",
    "སྐྱེས་བུ་འཛིན་པར་བྱེད་པར་མེད་མོད་ཅེ་ན།",
    "གང་གི་ཕྱིར་བློ་ནི་འཛིན་པར་བྱེད་པ་ཡིན་ལ་ཕྱི་རོལ་གཟུང་བ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་བདེ་བ་ལ་སོགས་པ་ནང་གི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་གི་ངོ་བོ་མྱོང་མིན་པ།",
    "གང་ཞིག་གང་གི་ངོ་བོས་མྱོང་བ་དེ་ནི་དེ་ལྟར་ཁས་བླང་བར་བྱ་བ་ཡིན་ཏེ།",
    "གང་གི་རང་བཞིན་མ་མྱོང་བ་མྱོང་བ་དེ་ནི་དོན་དེའི་མྱོང་བར་རིགས་པ་མ་ཡིན་ཏེ།",
    "དེ་བས་ན་བདེ་བ་ལ་སོགས་པ་ཕྱི་རོལ་པར་ཐལ་བར་ནི་མ་ཡིན་ནོ།",
    "ཧ་ཅང་ཐལ་ཆེས་པའི་ཕྱིར་རོ།",
    "བདེ་བ་ལ་སོགས་པ་མྱོང་བ་མེད་པར་ཐལ་བར་འགྱུར་རོ་ཞེ་ན།",
    "འདི་དག་གིས་ནི་ཐ་མི་དད་པ་མེད་ན་ཐ་དད་པ་ཡང་མེད་དོ་ཞེས་བྱ་བར་གནས་སོ།",
    "ད་ནི་གྲངས་ཅན་གི་གཞུང་གིས་ཀྱང་ཐ་དད་པ་དང་ཐ་མི་དད་པའི་རྣམ་པར་གཞག་པ་མེད་དོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "དེའི་ཚེ་ཐ་དད་པ་དང་ཐ་མི་དད་པ་ཅི་ཞིག་གི་རྒྱུ་ཅན་ཡིན་ཏེ།",
    "དུས་རེས་འགའ་ཞིག་གི་ཚེ་གསལ་བར་མྱོང་བ་མེད་པ་དེ་ལྟ་ན་ཡང་རྒྱུན་གྱིས་འཇུག་པའི་སེམས་དང་སེམས་ལས་བྱུང་བ་རྣམ་པར་ཤེས་པ་དང་ཚོར་བ་ལ་སོགས་པ་རྣམས་དུས་གཞན་དུ་ཐ་དད་པར་མཐོང་བའི་ཕྱིར་ཐ་དད་པར་རྣམ་པར་གཞག་གྲུབ་པ་ཁོ་ན་སྟེ།",
    "མཚན་མོའི་དུས་ན་སྐར་མའི་འཁོར་ལོ་གསལ་བར་ནུས་པས་མཐོང་བ་བཞིན་ནོ།",
    "བློ་དང་སེམས་དག་འགའ་ཞིག་གི་ཚེ་ཡང་ཐ་དད་པར་གསལ་བར་སྣང་བ་མ་ཡིན་པའི་ཕྱིར།",
    "འདོད་པ་དང་མྱ་ངན་དང་འཇིགས་པ་དེ་དག་གིས་བྱས་པའི་སྨྱོ་བ་ནི་དེ་དག་དང་འབྲེལ་པ་ཅན་གྱི་འཁྲུལ་པ་སྟེ།",
    "འཆི་རྟགས་བྱུང་བའི་ཚེ་ནུབ་མོ་ཤ་ཟ་གསལ་བར་སྣང་བར་འགྱུར་ཏེ།",
    "དེ་དག་གིས་ཉེ་བར་བཅོམ་པའི་འཇིག་རྟེན་ཡང་དག་པ་མ་ཡིན་པ་མེད་པའི་བུད་མེད་བཟང་མོ་ལ་སོགས་པ་ཡང་མདུན་ན་གནས་པ་བཞིན་དུ་སྣང་བར་འགྱུར་བའི་ཕྱིར།",
    "དེ་ནི་མ་ཡིན་ཏེ་གང་གི་ཕྱིར།",
    "རྨི་ལམ་ན་ཡང་དྲན་པ་ཡོད་མོད་ཀྱི་དེ་ཉམས་སུ་མྱོང་བ་ལ་ཞེན་པ་ཡིན་ཏེ།",
    "གང་གི་ཕྱིར་རྨི་ལམ་ན་ཡོད་པའི་དྲན་པའི་དོན་ཅན་སད་པའི་ཚེ་དྲན་པར་འགྱུར་གྱི།",
    "གང་གི་ཕྱིར་ཡང་དག་པ་མ་ཡིན་པའི་ཟད་པར་ས་ལ་སོགས་པ་གོམས་པའི་སྟོབས་ཀྱིས་རྣལ་འབྱོར་པས་མཐོང་བ་བཞིན་ནོ།",
    "རང་གི་ངོ་བོ་ལ་ཡང་རྟོག་པ་གསལ་བའི་རྣམ་པ་ཅན་དུ་མི་འགྱུར་བས།",
    "འདི་ལྟར་རྟོག་པའི་རང་གི་ངོ་བོ་ཉིད་ནི་གསལ་བའི་རྣམ་པ་ཅན་ཏེ།",
    "རང་གི་ངོ་བོ་ཉིད་ལ་ནི་རྟོག་པ་མེད་པར་སྐྱེ་སྟེ།",
    "རང་གི་ངོ་བོ་སྒྲ་དོན་མིན།",
    "ཤེས་པའི་རང་གི་ངོ་བོ་ཉིད་རྟོག་པ་དང་ཅིག་ཤེས་ནི་སྒྲའི་ཡུལ་མ་ཡིན་ཞིང་།",
    "ཤེས་པ་དིའི་རང་གི་ངོ་བོ་ལ་སྒྲ་སྦྱོར་བ་མེད་པའི་ཕྱིར་ཤེས་པ་མ་ལུས་པ་མངོན་སུམ་ཡིན་ནོ།",
    "མི་གསལ་བའི་ཤེས་པ་ནི་རང་གི་ངོ་བོ་སྤངས་པ་ལས་ཡིན་ན།",
    "རང་གི་ངོ་བོ་སྤོང་བར་ཇི་ལྟར་འགྱུར།",
    "ཤེས་པས་རང་གི་ངོ་བོ་སྤོང་བར་མི་ནུས་ཏེ།",
    "རང་གི་ངོ་བོ་སྤངས་ནས་རང་རིག་པ་དང་གཞན་རིག་པ་མ་ཡིན་པའི་ཕྱིར།",
    "རྟོག་པ་མེད་པ་གཅིག་གིས་ནི།",
    "དེ་ལྟར་ན་ཧ་ཅང་ཐལ་ཆེས་སོ་སྙམ་སེམས་ན།",
    "རེས་འགའ་འཁྲུལ་པའི་རྒྱུ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་གཟུགས་དང་རེག་བྱ་སྒྲོ་འདོགས་པས་ཁོ་བོས་སྔར་མཐོང་བ་དེ་ཉིད་རེག་པ་འདི་ཡིན་ནོ་ཞེས་བྱ་བར་བུམ་པ་ལ་སོགས་པའི་རྫས་དེ་རྗེས་སུ་འགྲོ་བར་རྟོགས་པའོ།",
    "དེའི་ཕྱིར་རྟོག་པ་དང་བྲལ་བ་ཚིག་གི་མི་མཐུན་པའི་དཔེ་རབ་རིབ་ཡིན་གྱི།",
    "གལ་ཏེ་མིག་གིས་བདེན་པའི་ཟླ་བ་མཐོང་ལ།",
    "རེས་འགའ་བརྗོད་པ་དག་གིས་འཇོག།",
    "དེ་བཞིན་དུ་རེས་འགའ་གཞན་གྱི་རྒྱུད་དེ་རབ་རིབ་མེད་པའི་ལུས་ལ་བརྗོད་པ་སྟེ།",
    "སྒྲ་དག་གིས་ཟླ་བ་གཉིས་ལ་སོགས་པའི་བློ་འཇོག་པ་སྟེ་སྐྱེད་པར་བྱེད་པ་ཉིད་དུ་འགྱུར་ཏེ།",
    "གང་གི་ཕྱིར་ཡུལ་ཉམས་སུ་མྱོང་བ་ཤེས་པའི་མཚན་ཉིད་ཡིན་ན།",
    "བདག་ཉིད་དེར་འགྱུར་ན་གང་གིས།",
    "བདག་ཉིད་གང་གིས་ལས་སོ་སོར་རྣམ་པར་འབྱེད་པ་སྟེ།",
    "དེ་རྟག་པའི་ཕྱིར་དང་དོན་གྱི་རྣམ་པ་ཅན་དུ་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྣམ་པ་མེད་པ་ཉིད་ཡིན་ན་རང་གི་ངོ་བོ་ཉིད་རིགས་པར་བྱེད་པར་འགྱུར་གྱི།",
    "རྟོག་པ་ཙམ་ནི་དོན་ཐམས་ཅད་ལ་ཐུན་མོང་ཡིན་པའི་ཕྱིར་རོ།",
    "གང་གི་ཕྱིར་བདག་ཉིད་དུ་མ་གྱུར་པའི་ཐ་དད་པ་ངེས་པར་བྱེད་པ་མ་ཡིན་པ་དེའི་ཕྱིར་རོ།",
