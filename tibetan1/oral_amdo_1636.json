    "གང་གི་ཕྱིར་དེའི་དོན་ཅན་ཏེ་ཕྱི་རོལ་གྱི་དོན་རྟོགས་པ་དེ་དགོས་པའི་དོན་གང་ལ་བརྡ་བྱེད་པ་དེ་ཡོད་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་ནི་འདོད་མོད་ཀྱི་སྒྲའི་དོན་གཞན་སེལ་བ་ཡིན་ཞིང་འདི་ཕྱི་རོལ་གྱི་རང་བཞིན་མ་ཡིན་པ་དེའི་ཕྱིར་དེ་ལ་ཡང་བརྡ་སྦྱོར་བར་མི་འགྱུར་རོ་ཞེ་ན།",
    "དེ་ཡང་བློ་ཡིས་གཞག་པའི་རྣམ་པ་ནི་ཕྱི་རོལ་གྱི་རང་གི་མཚན་ཉིད་ལ་མེད་དེ།",
    "གང་གི་ཕྱིར་ཕྱི་རོལ་པ་མཐོང་བ་གོམས་པ་ཡང་དང་ཡང་དུ་འཇུག་པ་དེས་སྤྲུལ་པའི་ཕྱིར་རོ།",
    "བློའི་གཟུགས་བརྙན་ནི་རེ་ཞིག་སྒྲའི་བརྗོད་པར་བྱ་བ་མ་ཡིན་ཏེ།",
    "སྒྲའི་བརྗོད་བྱ་ཡིན་པ་དེ་ལྟ་ན་ཡང་གཟུགས་བརྙན་ནི་ཤེས་པ་བཞིན་དུ་ཐུན་མོང་མ་ཡིན་པའི་ཕྱིར།",
    "སྒྲ་ནི་དངོས་པོ་ལ་རེག་པའོ།",
    "རང་གི་མཚན་ཉིད་རྟོག་པ་མེད་ཀྱང་།",
    "འཁྲུལ་པའི་ཤེས་པས་མྱ་ངམ་གྱི་སྨིག་རྒྱུ་བ་ལ་སོགས་པ་ལ་འཇུག་གི།",
    "ཧ་ཅང་ཐལ་ཆེས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་རྟོག་པ་རྣམས་རང་གི་ངོ་བོ་ལ་བྱེད་པ་ཡིན་གྱི།",
    "རྟོག་པའི་རང་གི་ངོ་བོ་ནི་མེད་པ་མ་ཡིན་ཏེ།",
    "ཕྱི་རོལ་གྱི་དངོས་པོ་ལ་ནི་རྟོག་པ་ཕྱིན་ཅི་ལོག་གིས་རྣམ་པར་མཐོང་བའི་ཕྱིར་འཁྲུལ་པ་ཡིན་གྱི།",
    "རང་གི་ངོ་བོ་ལས་ཐ་དད་པའི་ཕྱི་རོལ་དུ་རྟོག་པའི་བྱེད་པ་མེད་པ་དེ་བས་ན་དེ་ལ་བྱེད་པ་མེད་པ་ཉིད་ཀྱིས་ཕྱི་རོལ་ལ་ལྟོས་ནས་འཁྲུལ་པ་ཉིད་ཡིན་ནོ།",
    "རང་གི་མཚན་ཉིད་ཁོ་ན་སྒྲ་ཡིས་བརྗོད་པར་བྱ་བར་འགྱུར་རོ་ཞེ་ན།",
    "རང་གི་རྟོགས་པའི་འབྲས་ཅན་གྱིས།",
    "གང་གི་ཕྱིར་གལ་ཏེ་འདི་ནི་བ་ལང་ཡིན་ནོ་ཞེས་ཕྱི་རོལ་གྱི་དོན་བསྟན་པ་དེ་ལྟ་ན་ཡང་གཟུགས་བརྙན་ཉིད་ལ་ལྟོས་པར་བྱེད་དོ།",
    "དེའི་ཕྱིར་འདི་བ་ལང་ཡིན་ནོ་ཞེས་མཛུབ་མོས་བསྟན་པའི་དོན་གསལ་བ་དང་འབྲེལ་པ་ཡིན་ལ།",
    "འོན་ཀྱང་འདིའི་རྗོད་པར་བྱེད་པ་འདི་ཡིན་ནོ་ཞེས་རང་གི་མཚན་ཉིད་ཁོ་ན་བརྡའི་ཡུལ་ཉིད་དུ་ཤེས་པ་ཡིན་གྱི།",
    "གང་གི་ཚེ་ཡོངས་སུ་གཅོད་པར་བྱེད་པ་དེའི་ཚེ་གདོན་མི་ཟ་བར་གཟུགས་བརྙན་རྟོགས་པར་འགྱུར་ལ།",
    "གང་གི་ཚེ་ཡང་ཐ་སྙད་ལ་བརྟེན་ནས་སྒྲ་དང་དོན་དག་གི་འབྲེལ་པ་ཤེས་པ་དེའི་ཚེ།",
    "རིགས་མི་མཐུན་པ་ལས་ལོག་པའི་རང་གི་རྟོགས་པའི་འབྲས་བུ་དོན་གང་ལ་ཡོད་པ་དེ་དང་འབྲེལ་པ་ནི་སྒྲ་ལ་འབྲེལ་པར་འགྱུར་གྱི།",
    "གང་གིས་བརྡ་དོན་མེད་པར་འགྱུར་བའི་རང་རྒྱུད་པ་ནི་མ་ཡིན་ནོ།",
    "རང་གི་ངོ་བོ་རྟོགས་པའི་ནི་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་རང་གི་མཚན་ཉིད་དམ་རིགས་ལ་བརྡ་མི་བྱེད་ཅེ་ན།",
    "གལ་ཏེ་ཡང་གསལ་བ་ལ་སྒྲ་སྦྱོར་བར་བྱེད་ན་རིགས་མཐུན་པ་ཐམས་ཅད་ལས་མཐོང་བ་མེད་པར་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་མོད་ཀྱང་རིགས་མི་མཐུན་པ་ལས་ལྡོག་པ་ཉིད་དུ་འགྱུར་བས་རིགས་བརྟགས་པས་ཅི་ཞིག་དག་དགོས།",
    "འོན་ཏེ་ཤེས་པ་ཉིད་ལ་དང་པོ་ནི་བ་ལང་ཙམ་ཤེས་ལ་ཕྱིས་ནི་ནག་མོ་ལ་སོགས་པར་ཤེས་པ་ཡིན་གྲང་ན།",
    "བ་ལང་གི་སྒྲར་སྣང་བ་ན་ནག་མོ་ལ་སོགས་པའི་བྱེ་བྲག་ཤེས་པ་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་རྟོགས་པ་ཉིད་དངོས་པོ་ལ་རེག་པ་མེད་པར་སྒྲས་བསྐྱེད་པ་ཡིན་ནོ།",
    "འོན་ཏེ་མིག་གི་ཤེས་པ་ལ་རྫས་དང་སྦྱོར་བ་ཡོད་དེ་དབྱུག་པ་ལ་སོགས་པའི་ཁྱད་པར་ཐ་དད་པར་མཐོང་བའི་ཕྱིར་རོ།",
    "དེ་ལྟ་ན་ནི་ལྡན་པ་དེ་ཡང་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་སྣང་བའི་ཕྱིར་ཅི་ཞིག་སྦྱོར་བ་ཡིན།",
    "འདི་ལྟར་འདི་བ་ལང་ཡིན་ནོ་ཞེས་བྱ་བ་བ་ལང་གི་སྒྲའི་བརྗོད་པར་བྱ་བ་འདི་ཡིན་ཞེས་བྱ་བའི་དོན་ཏེ།",
    "བ་ལང་གི་སྒྲས་འདི་ཤེས་པར་བྱའོ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བ་ལང་གི་སྒྲའི་བརྗོད་པར་བྱ་བ་ཡང་བརྡ་ཡིས་ཤེས་པ་ཡིན་ཏེ།",
    "བརྡའི་དུས་དང་ཐ་སྙད་ཀྱི་དུས་ན་མཐོང་བའི་འདྲེས་པ་འདི་ནི་བ་ལང་དེ་ཡིན་ན་ཞེས་གཅིག་ཏུ་བྱེད་པའི་བདག་གང་ལ་ཡོད་པ་དེ་རྫས་དང་སྒྲའི་ཁྱད་པར་ཅན་འཛིན་པ་མིག་གིས་ཤེས་པར་ཇི་ལྟར་འགྱུར་ཏེ་མ་ཡིན་ནོ།",
    "མིག་གི་ཤེས་པ་ནི་རྟོག་པ་མེད་པ་ཉིད་དེ་སྔ་མ་དང་ཕྱི་མར་རྟོག་པས་སྟོང་པའི་ཕྱིར་རོ།",
    "འོན་ཏེ་དྲན་པར་གྱུར་པས་བ་ལང་གི་སྒྲའི་བརྗོད་པར་བྱ་བ་དང་ལྷན་ཅིག་སྣང་བའི་རྣམ་པ་མངོན་སུམ་གྱིས་ཤེས་པ་ཡིན་ནོ་ཞེ་ན།",
    "བདག་གིས་ཀྱང་མཐོང་བའི་སྟོབས་ཀྱིས་དོན་ཉམས་སུ་མྱོང་བ་ཡིན་གྱི།",
    "མིག་གིས་གཟུགས་དག་མཐོང་བར་འགྱུར།",
    "བ་ལང་གི་གཟུགས་གསལ་བ་སྟེ་སྣང་བར་གྱུར་པ་བ་ལང་དེ་ལ་བརྡ་མི་འཛིན་པ་ཉིད་དུ་གསལ་བར་ཤེས་པར་བྱ་སྟེ།",
    "རྟ་རུ་རྟོག་པའི་ཚེ་ན་བ་ལང་གི་རྟོག་པ་སྐྱེ་བ་དམིགས་པ་ནི་མ་ཡིན་ལ།",
    "བ་ལང་གི་སྒྲ་ཡིས་གཞག་པའི་ངེས་པ་ནི་བ་ལང་མཐོང་བ་དེ་ལ་ཡོད་པ་མ་ཡིན་ཞིང་རྟོགས་པར་གྱུར་པ་མ་ཡིན་ལ།",
    "བ་ལང་མཐོང་བ་ན་ཁམས་གསུམ་ཐམས་ཅད་རྟོགས་པར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "གང་ཡང་གང་གི་ཚེ་བརྡ་མི་འཛིན་པ་དེའི་ཚེ་ཅི་ཡང་རུང་བའི་སྤྱི་རྟོགས་པ་ཡོད་དོ་ཞེས་གང་སྨྲས་པ།",
    "རང་གི་ངོ་བོ་ཉིད་ཙམ་ཁོ་ན་མངོན་སུམ་དུ་སྣང་གི་ཡོངས་སུ་གཅོད་པར་བྱེད་པ་ནི་མ་ཡིན་ནོ།",
    "འོན་ཏེ་ཤེས་པ་ཐམས་ཅད་ཀྱི་གྲོགས་བྱེད་པ་མིང་གི་དྲན་པ་མ་ཡིན་ཏེ།",
    "འོན་ཀྱང་མིང་གི་ཁྱད་པར་ཅན་གྱི་དོན་འཛིན་པ་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "མངོན་སུམ་གྱི་རང་གི་ངོ་བོ་ཉིད་ནི་རྟོག་པ་ཡིན་པར་འགེགས་པ་ཡིན་ནོ།",
    "དེ་ཡང་པདྨ་དྲི་ཞིམ་པོར་དྲན་པའི་གྲོགས་ཅན་གྱི་མིག་གིས་པདྨའི་གཟུགས་གསལ་བར་འཛིན་པར་བྱེད་དོ་ཞེས་ཁས་ལེན་པར་ཅི་སྟེ་མི་བྱེད་དེ།",
    "སྒྲ་ལ་སོགས་པ་དང་བྲལ་བར་མིག་གི་ཤེས་པས་དོན་འཛིན་པ་ཅན་ནོ།",
    "གང་གི་ཕྱིར་སྐྱེ་བོ་གཞན་དུ་སོན་པའི་སེམས་དང་ལྡན་པའི་སྐྱེ་བོ་ལ་གཟུགས་གསལ་བར་སྣང་བ་ཡོད་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདི་དག་ནི་བསྟན་ཟིན་ཏོ།",
    "གཞན་ཡང་འགྲོ་བ་བཟང་མོ་མཐོང་བའི་ཚེ་བདེ་བ་ལ་སོགས་པ་མྱོང་བར་འགྱུར་གྱི།",
    "དེ་ལ་གཟུགས་དེ་ཉིད་ཀྱི་བློས་ཡིན་གྱི་བློ་ཉམས་སུ་མྱོང་བར་ཁས་ལེན་ན་ནི་མཐོང་བའི་རྟོགས་པ་དང་གཟུགས་ཀྱི་རྟོག་པ་གཉིས་ཅིག་ཅར་སྐྱེ་བར་ཐལ་བར་འགྱུར་ཏེ།",
    "འོན་ཏེ་གཟུགས་མཐོང་བ་ཉིད་ཀྱིས་རང་གི་ངོ་བོ་དང་།",
    "འདི་ལྟར་རིམ་པ་ཡང་རིམ་པ་གང་གིས་མཐོང་བ་དེ་ཡང་བློ་ལས་ཐ་མི་དད་པ་ཉིད་ཀྱི་ཕྱིར།",
    "དེ་ལ་ཡང་རིམ་པ་མཐོང་བ་གཞན་བསྟན་དགོས་པར་ཐལ་བར་འགྱུར་རོ།",
    "དུས་མཚུངས་པ་ཅན་གྱི་ཤེས་པ་གཞན་གྱིས་མྱོང་ཡང་རྟོག་པ་གཉིས་ཅིག་ཅར་སྐྱེ་བར་ཐལ་བར་འགྱུར་བ་སོ་ན་འདུག་གོ།",
    "དེ་ཉིད་རྟོག་པ་གཉིས་སུ་ཐལ་བར་འགྱུར་རོ།",
    "དེ་ལྟ་ན་ནི་སྐྱེས་བུ་གཞན་གྱི་བློ་དེ་ཡོངས་སུ་གཅོད་པ་དེ་དང་ཐ་མི་དད་པ་གང་ལ་ཡོད་པའི་རང་གི་རྒྱུད་ཀྱི་བློ་རྟོགས་པ་དེ་ནི་རང་གི་བློ་འཛིན་པ་ཅན་ཏེ།",
    "མངོན་སུམ་གྱིས་དོན་སྐྱེ་བོ་ཐམས་ཅད་ཀྱི་ཐུན་མོང་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་གི་བློའི་སྒྲུབ་བྱེད་མ་ཡིན་པའི་ཕྱིར།",
    "དེས་ན་རང་གི་བློ་དང་གཞན་གྱི་བློ་མཚུངས་པ་ཉིད་ཡིན་ནོ།",
    "འོ་ན་ལྐོག་ཏུ་གྱུར་པའི་རང་གི་ནི་བདག་ཉིད་དང་འབྲེལ་པས་ཤེས་པ་ཡིན་གྱི།",
    "དེ་དག་གིས་གྲུབ་དེ་ལ་ནི།",
    "རང་གི་བློ་མངོན་དུ་བྱེད་པ་མ་ཡིན་གྱི།",
    "མངོན་སུམ་སྔོན་དུ་སོང་བའི་རྗེས་སུ་དཔག་པ་རང་གི་བློའི་སྒྲུབ་བྱེད་དུ་འགྱུར་ཏེ།",
    "བདག་དང་འབྲེལ་པ་ཅན་ཉེད་ཀྱང་གང་གིས་སྒྲུབ་པར་འགྱུར།",
    "མངོན་སུམ་མེད་པར་ཡང་རྟགས་དང་རྟགས་ཅན་འབྲེལ་པ་འཛིན་པ་མེད་པར་རང་གི་བློ་ལ་རྗེས་སུ་དཔོག་པ་ཡང་མེད་པའི་ཕྱིར།",
    "གང་གི་རང་རིག་པར་སྣང་བ་དེ་ནི་དེའི་བདག་ཉིད་མཐོང་བ་ཡིན་པའི་ཕྱིར།",
    "རང་གི་བློ་ཡོངས་སུ་གཅོད་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་དོན་མཐོང་བ་དེའི་རང་གི་ངོ་བོར་སྣང་བ་དེ་ནི་དེའི་རྣམ་པ་ཅན་ཉིད་དེ།",
    "མཐོང་བའི་རང་གི་ངོ་བོ་ཉིད་མྱོང་བ་ཅིའི་ཕྱིར་རྟོག་པ་མེད་པ་ཡིན་ཞེས་བརྩད་པའི་ལན་ནི་འདི་ཡིན་ཏེ།",
    "རང་གི་ངོ་བོ་ཉིད་སྣང་བར་གྱུར་པ་ལ་རང་གི་ངོ་བོ་དང་ལྷན་ཅིག་སྒྲ་སྦྱོར་བ་མེད་པའི་ཕྱིར་རོ།",
    "གཟུགས་ལ་སོགས་པའི་རང་གི་ངོ་བོ་ཉིད་སྣང་བར་གྱུར་པ་ལ་སྒྲའི་རྣམ་པ་མ་མཐོང་བའི་ཕྱིར་རོ།",
    "དཔྱོད་པ་པ་གང་ཞིག་གི་སྤྱི་བརྗོད་པའི་ངང་ཚུལ་གང་ལ་ཡོད་པའི་སྒྲ་རྣམས་དེ་ནི་དེ་ལྟ་བུ་དང་།",
    "གང་གི་ཕྱིར་རྒྱུ་ཐ་དད་པས་འབྲས་བུ་རྟོག་པ་མེད་པའི་ཤེས་པ་རྣམས་ཐ་དད་པའི་ཕྱིར་རོ།",
    "དེ་བས་ན་མིག་གི་བློ་ལ་རྟོག་པའི་རྒྱུ་བརྡ་དྲན་པ་མེད་པའི་ཕྱིར་སྒྲའི་རྣམ་པ་ཅན་ནི་མ་ཡིན་ཏེ།",
    "དེ་བས་བ་ལང་མཐོང་བ་ཡོད་ན་བ་ལང་གི་སྒྲ་དྲན་པར་འགྱུར་ལ་བ་ལང་གི་སྒྲ་དྲན་པར་གྱུར་ན་ཡང་བ་ལང་ངོ་སྙམ་དུ་རྟོག་པ་སྐྱེ་བར་འགྱུར་བ་དེའི་ཕྱིར་མཐོང་བའི་རྣམ་པ་ནི་རྗོད་པར་བྱེད་པ་དྲན་པའི་རྟགས་ཉིད་དུ་རིགས་ཏེ།",
    "མིག་གི་སྐྱེ་མཆེད་གྲོགས་བྱེད་པ་ཅན་གྱིས་དྲན་པ་མ་མཐོང་བ་མ་ཡིན་ནམ།",
    "འོན་ཏེ་གསལ་བའི་རྣམ་པ་ཅན་ལས་ལྷག་པར་གྱུར་པ་མིང་གིས་ཤེས་པ་སྣང་བརའགྱུར་རོ་ཞེ་ན།",
    "བརྟེན་ནས་མིག་གི་བློ་སྐྱེར་འགྱུར།",
    "དེའི་ཕྱིར་མིག་དང་གཟུགས་ལ་བརྟེན་ནས་མིག་གི་བློ་སྐྱེ་བར་འགྱུར་ཏེ།",
    "དེ་བས་ན་དྲན་པའི་སྔར་ཕྱིས་མིག་གི་རིག་པས་སྔ་མ་དང་ཕྱི་མ་འཛིན་པ་མ་ཡིན་ཏེ།",
    "དེ་ནི་སྐྱེ་བོ་ཐམས་ཅད་ཀྱི་ཐུན་མོང་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ནས་ཀྱི་མྱུ་གུ་ཞེས་བྱ་བ་ནི་ཐུན་མོང་མ་ཡིན་པའི་ཐ་སྙད་དུ་སྣང་བ་ཡིན་ནོ་ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "མངོན་སུམ་ཞེས་བྱ་བ་ཉིད་འཇིག་རྟེན་ལ་གྲགས་པས་འདི་ཉིད་ཀྱིས་ཆོག་མོད།",
    "དེ་ལྟར་ཡང་ཡུལ་ནི་ཐུན་མོང་བ་ཡིན་ཏེ།",
    "འོན་ཏེ་དོན་གྱི་སྟོབས་ཀྱིས་སྐྱེས་པ་ཕྱིན་ཅི་ལོག་གི་ཤེས་པ་ལ་མེད་དོ་ཞེ་ན།",
    "གང་གི་ཕྱིར་རྟོག་པ་སྔོན་དུ་གཏོང་བ་རྣམས་ཀྱིས་རྟོགས་པར་བྱེད་པ་དཔྱད་ནས་ཐ་སྙད་སྦྱོར་བར་བྱེད་པ་དེའི་ཕྱིར་མངོན་སུམ་གྱི་ཐ་སྙད་འདི་ལ་ནི་རྟགས་ངེས་པར་སྦྱར་བར་བྱ་སྟེ།",
    "མངོན་སུམ་གྱི་རང་གི་ངོ་བོ་ཉིད་ལ་ལྟོས་ནས་གོ་བར་བྱེད་པའི་ངོ་བོ་ཉིད་ཡིན་ནོ།",
    "རང་གི་དོན་ལ་སྤྱིའི་ཡུལ་ཅན།",
