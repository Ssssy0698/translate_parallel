    "ས་བོན་ཞེས་བྱ་བ་རྩ་བའི་རྒྱུ་གང་ཡིན་པ་དེ་ནི་རང་ཉིད་རྣམ་པར་འགྱུར་བར་གྱུར་པ་ན་མྱུ་གུའི་རྒྱུ་ཉིད་དུ་འགྱུར་ཏེ།",
    "གང་ལ་རྣམ་པར་འགྱུར་ཡོད་པ།",
    "ས་བོན་རྣམ་པར་འགྱུར་བ་ལས་སྐྱེས་པའི་མྱུ་གུ་ནི་ས་བོན་ལས་གཞན་ཉིད་དུ་མི་སྲིད་པའི་ཕྱིར་དང་།",
    "ལྷན་ཅིག་མི་གནས་པའི་ཕྱིར་གཞན་ཉིད་སྐྱེས་སོ་སྙམ་དུ་བསམ་པར་མི་བྱ་སྟེ།",
    "འབྲས་བུ་སྐྱེས་ཀྱང་དུས་རྣམ་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྒྱུ་ནི་ལོག་པར་འགྱུར་བ་སྟེ།",
    "རང་ཉིད་གྲུབ་པའི་ཕྱིར་འགྲོ་བ་འདི་ལ་རྒྱུ་དུས་ཞེས་བྱ་བ་དགོས་པ་མེད་པར་འགྱུར་ཏེ།",
    "དུས་ནི་རྟག་ལ་དེའི་འབྲས་བུ་ནི་མི་རྟག་པས་ཇི་ལྟར་དེ་གྲུབ་པར་འགྱུར།",
    "དེ་ཡང་མི་རྟག་པ་རྣམས་ཁོ་ནར་རང་ཉིད་རྣམ་པར་འགྱུར་བར་ཉེ་བར་འགྲོ་བས་རྒྱུ་ཉིད་དུ་ཁས་བླངས་པའི་ཕྱིར་མཚན་ཉིད་མི་མཐུན་པ་མེད་དེ།",
    "རྡུལ་ཕྲ་རབ་སླ་བ་ནི་ས་ལ་སོགས་པའི་རྡུལ་ཕྲ་རབ་རྟག་ཅིང་མ་མཐོང་བས་བསྐུལ་བ་ཡོན་ཏན་དང་ལྡན་པའི་གྲོགས་ཅན་རྡུལ་ཕྲ་རབ་གཉིས་པ་ལ་སོགས་པའི་རིམ་གྱིས་ཡན་ལག་ཅན་གྱི་རྫས་རྩོམ་པར་བྱེད་པ་རྣམས་ཀྱིས་འགྲོ་བ་སྣ་ཚོགས་སྐྱེད་པར་བྱེད་དོ་སྙམ་དུ་སེམས་སོ།",
    "སྣ་ཚོགས་རྟག་པར་མི་རིགས་སོ།",
    "དེའི་ཚེ་ངེས་པར།",
    "དེས་རྡུལ་རྡུལ་ཕྲན་མིན་པར་བསྙད།",
    "གལ་ཏེ་རྡུལ་ཕྲ་རབ་ཆ་ཤས་མེད་པར་གྱུར་ན་ནི་དེ་ལ་འགྲོ་བ་མེད་པས་རྡུལ་ཕྲ་རབ་གཞན་དང་སྦྱོར་བ་མེད་པ་ཡིན་དང་།",
    "ཡན་ལག་ཅན་གྱི་རྫས་རྩོམ་པར་བྱེད་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "དེ་མེད་པས་འབྲས་བུ་རྩོམ་པར་བྱེད་པ་ཉིད་མེད་པའི་ཕྱིར་རྡུལ་ཕྲ་རབ་དངོས་པོ་ཡོད་པར་སྨྲ་བར་མི་རིགས་སོ།",
    "གལ་ཏེ་རྡུལ་ཕྲ་རབ་མེད་ན་ནི་འདི་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་དམིགས་པར་མི་འགྱུར་བ་ཞིག་ན།",
    "བལྟ་བར་བྱ་བ་མ་ཡིན་པ་ནི་སུས་ཀྱང་བལྟ་བར་བྱ་བར་ནུས་པ་ཡང་མ་ཡིན་པ་འདི་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་དམིགས་པར་འོས་པ་མ་ཡིན་ནོ།",
    "གལ་ཏེ་རྡུལ་ཕྲ་རབ་རྣམས་རྒྱུ་ཉིད་དུ་གྱུར་ན་ནི་ས་བོན་གྱིས་མྱུ་གུ་བཞིན་དུ་དེ་རྣམས་རྡུལ་ཕྲ་རབ་གཉིས་ལ་སོགས་པ་ཡན་ལག་ཅན་གྱི་རྫས་ཀྱིས་འཇིག་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་འབྲས་བུ་དང་ལྷན་ཅིག་མི་གནས་པའི་ཕྱིར་ན་རྡུལ་ཕྲ་རབ་རྣམས་ས་བོན་ལྟར་མི་རྟག་པར་འགྱུར་རོ།",
    "རྡུལ་ཕྲ་རབ་རྟག་པར་བརྟགས་པ་དོན་མེད་པས་ཅི་ཞིག་དགོས་ཏེ།",
    "དེ་ཡང་བརྟགས་པར་ཡོད་པ་ཞིག་སྟེ།",
    "དེའི་ཕྱིར་དེ་བཞིན་གཤེགས་པ་རྣམས་ནམ་ཡང་རྡུལ་ཕྲ་རབ་རྟག་པ་ཉིད་སྟོན་པར་མི་མཛད་དེ།",
    "དེའི་ཕྱིར་འཇིག་རྟེན་པའི་དངོས་པོ་རྣམས་ནི་འཇིག་རྟེན་ལས་འདས་པ་ལ་ཡོངས་སུ་མཐོང་བའི་རྣམ་པར་དཔྱད་པ་མ་བཅུག་པར་འཇིག་རྟེན་ན་ཇི་ལྟར་ཡིན་པ་དེ་ལྟར་ཁས་བླང་བར་བྱ་ཞིང་།",
    "ཇི་ལྟར་རྣམ་པར་ཤེས་པ་འཇིག་རྟེན་པ་ཡིན་པ་དེ་ལྟར་རྡུལ་ཕྲ་རབ་ཀྱང་ཡིན་པས་འདིས་རིགས་པ་བཅུག་ནས་རྡུལ་ཕྲ་རབ་བསལ་བར་མི་ནུས་ཏེ།",
    "གང་ཞིག་རྟག་པ་ཉིད་དུ་གསུངས་པ་དེ་ནི་རྟག་པར་གྱུར་ཅིང་ཡོད་པ་ཡིན་ཏེ།",
    "ཇི་སྐད་དུ་བཅོམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་དག་མ་སྐྱེས་པ་དང་མ་བྱུང་བ་དང་འདུས་མ་བྱས་པ་དེ་ནི་ཡོད་དོ་ཞེས་གསུངས་ལ།",
    "དེ་བཞིན་དུ་བཟློག་པར་བྱ་བ་དང་ཟློག་པར་བྱེད་པ་མེད་པར་ནི་ཟློག་པ་ཡོད་པར་མི་འགྱུར་ཞིང་དེ་ཡོད་པ་ལས་བཟློག་པར་བྱ་བ་དང་།",
    "ཟློག་པར་བྱེད་པ་གཉིས་ཡོད་པ་ཉིད་དོ།",
    "ཟློག་པར་བྱེད་པ་ནི་ལམ་སྟེ།",
    "བདེན་པ་གསུམ་པའི་སྒྲ་བརྗོད་པར་བྱ་བ་ཉིད་ཀྱང་མི་འགལ་ཏེ།",
    "དངོས་པོ་མེད་པར་གྱུར་པ་ལ་གྲངས་ཀྱིས་ཡོངས་སུ་བགྲང་བ་ཡོད་པ་མ་ཡིན་པ་ཡང་མ་ཡིན་ཏེ།",
    "གང་ཟག་གོ་ཞེས་བྱ་བ་དེ་ལྟ་བུ་ལ་སོགས་པ་གསུངས་པའི་ཕྱིར་རོ།",
    "གང་སྡུག་བསྔལ་འདི་མ་ལུས་པར་རབ་ཏུ་སྤངས་ཤིང་།",
    "འགོག་པ་མྱ་ངན་ལས་འདས་པའོ་ཞེས་གསུངས་ཏེ།",
    "དེའི་ཕྱིར་མྱ་ངན་ལས་འདས་པ་དེ་ལ་མྱ་ངན་ལས་འདས་པར་གྱུར་པ་འགའ་ཡང་མི་དམིགས་སོ།",
    "མྱ་ངན་ལས་འདས་པ་ནི་མྱ་ངན་ལས་འདས་པ་སྟེ་དེ་ཡང་དངོས་པོའི་ངོ་བོ་ཡིན་པའི་ཕྱིར་རྟེན་ལ་རག་ལས་སོའདིའི་རྟེན་ཡང་མྱ་ངན་ལས་འདས་པར་གྱུར་པ་ཞིག་ལ།",
    "དེ་མེད་པས་རྟེན་མེད་པར་འགྱུར་ཏེ།",
    "ཕྱོགས་དེ་ལས་མྱ་ངན་ལས་འདས་པ་དེ་གང་ཞིག་ཡིན་པར་འགྱུར།",
    "རྣམ་པ་གཅིག་ཏུ་ན་མྱ་ངན་ལས་འདས་པ་དངོས་པོ་བདེན་པར་སྨྲ་བས་མྱ་ངན་ལས་འདས་པ་རྟོག་པ་ན་རྟེན་དུ་གྱུར་པ་ཞིག་གམ།",
    "བརྟེན་པར་གྱུར་པ་ཞིག་རྟོག་གྲང་།",
    "ཡང་གང་དུ་བརྟེན་པར་གྱུར་པ་ཡིན་པ་དེར་ཡང་ཉེས་པ་དེ་ཉིད་ཡིན་ཏེ།",
    "དེས་ནི་དེའི་ཚེ་དོན་འགའ་ཡང་ཡང་དག་པར་མི་མྱོང་སྟེ།",
    "རྣམ་པར་འགྱུར་བའི་ཚོགས་རྒྱུ་དང་འབྲས་བུའི་བདག་ཉིད་ཅན་མཐའ་དག་རབ་ཏུ་ཞི་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "འོ་ན་ནི་དེའི་ཚེ་སྐྱེས་བུ་ཤེས་པ་ཡོད་པ་མ་ཡིན་པར་འགྱུར་ལ་རག་གོ་ཞེ་ན།",
    "གལ་ཏེ་གྲོལ་བའི་གནས་སྐབས་སུ་བདག་བརྟག་པར་ནུས་ན་ནི་དེའི་ཚེ་བདག་ཡོད་དང་དེའི་རྟེན་ཅན་ཤེས་པ་ཡོད་པ་ཉིད་ཀྱི་ནུས་པ་ཡོད་པར་འགྱུར་བ་ཞིག་ན།",
    "མའཛེག་པར་འང་མེད་པས་དེའི་ཕྱིར་སྲིད་པ་འདི་མི་འཇིག་པར་འགྱུར་རོ་ཞེས་མི་འདོད་པ་མང་པོ་ཞིག་ཏུ་འགྱུར་བ་མ་ཡིན་ནམ་ཞེ་ན།",
    "དེའི་ནུས་པ་གཉིས་དངོས་པོ་བདེན་པར་ཡོད་ན་ནི་ཇི་སྲིད་འཇུག་པ་ཡོད་པ་ཞིག་གམ་འོན་ཏེ་མེད་པ་ཞིག་སྙམ་དུ་ཐེ་ཚོམ་ཟ་བར་འགྱུར་བ་ཞིག་ན།",
    "གཞན་ལས་ཡོད་པ་མིན་པར་ངེས།",
    "ཁྱད་པར་ཁས་ལེན་ན་ཡང་རྣམ་པར་འགྱུར་བ་ཡོད་པའི་ཕྱིར་མི་རྟག་པར་འགྱུར་ལ།",
    "དེའི་ཕྱིར་འདིས་བདག་ཁས་བླངས་པར་མི་རིགས་སོ།",
    "གང་ཞིག་གཞན་ལ་བསྟན་པར་མི་ནུས་པ་དང་།",
    "ཐམས་ཅད་མེད་པར་གྱུར་ན་ནི་བདེ་བ་ཡང་རྣམ་པ་ཐམས་ཅད་དུ་གཅད་པས་འདིས་བདག་ལ་ཕན་ཅུང་ཟད་ཀྱང་བཏགས་པར་མི་འགྱུར་རོ།",
    "གང་མུ་སྟེགས་ཅན་རྣམས་ཀྱིས་ཡང་དག་པ་མ་ཡིན་པར་སྒྲོ་བཏགས་པ་དང་།",
    "དེ་བཞིན་དུ་སྐྱེས་པ་ཉིད་དང་མ་ནིང་ཉིད་ལ་ཡང་བརྗོད་པར་བྱའོ།",
    "རྣམ་པར་དཔྱད་པ་ན་དངོས་པོ་ཡོད་པ་ལ་དེ་ལྟར་གྲུབ་པ་མེད་པའི་ཕྱིར་དེ་ལྟར་ཡོངས་སུ་རྟོགས་པ་ལ་མི་ཤེས་པ་ལས་མ་རྟོགས་པའི་རྒྱུ་གཞན་མི་རིགས་ཏེ།",
    "ཞེས་གསུངས་སོ།",
    "ནུར་ནུར་པོ་ལ་སོགས་པ་ཡང་རྟགས་དམིགས་པར་འགྱུར་ན།",
    "ཞེས་གསུངས་སོ།",
    "རྟོག་པ་སྐྱེས་པར་འགྱུར་མིན་ནམ།",
    "ཚོར་བ་པོ་ཞེས་བྱ་བ་ལ་སོགས་པ་བདག་གོ་སྙམ་དུ་ལོག་པར་རྟོག་པར་བྱེད་དོ།",
    "ཡང་ཅི་བདག་འདི་ཚེ་རབས་གཞན་དུ་ལུས་ཀྱི་ཁྱད་པར་གྱི་རྣམ་པར་འགྱུར་བའི་རྗེས་སུ་བྱེད་དམ།",
    "ལུས་བཞིན་རྣམ་པར་འགྱུར་བར་འགྱུར།",
    "ལུས་ཀྱི་རྣམ་པར་འགྱུར་བའི་རྗེས་སུ་བྱེད་པའི་ཕྱིར་ཏེ།",
    "དེའི་ཕྱིར་བདག་ཏུ་སྒྲོ་འདོགས་པར་མི་རིགས་ཏེ།",
    "ལས་ཀྱི་འབྲས་བུ་མྱོང་བར་བྱ་བའི་ཕྱིར་བདག་རྟག་པར་རྟོགས་སོ།",
    "སེམས་མ་གཏོགས་པར་འགྲོ་སོགས་ལ།",
    "ཡིད་ནི་དོན་པོར་བརྗོད་པར་བྱ།",
    "རྣམ་ཆད་མེད་པར་སྐྱེ་བ་ནི།",
    "ཅིས་ཏེ་ཁྱད་པར་འདིས་བདག་ལ་ཡང་རྟོག་ན་ནི་དེའི་ཚེ་འདི་སྐད་ཅིག་མ་ཉིད་དུ་ཁས་བླང་བར་བྱ་སྟེ།",
    "རྟག་པ་ལ་རྣམ་པར་འགྱུར་བ་མེད་པ་ཉིད་ཀྱིས་ཁྱད་པར་རྣམ་པ་དེ་ལྟ་བུ་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "ཡང་ན་རྒྱུ་གཞན་ཞིག་བརྗོད་པར་བྱ་དགོས་ན་དེ་ཡང་མ་བརྗོད་པས་འདི་ནི་མི་རིགས་སོ།",
    "འདུ་བྱེད་སྐྱེས་མ་ཐག་ཏུ་འཇིག་པའི་ངང་ཅན་རྣམས་ལ་ནི་ཚེ་རབས་གཞན་དྲན་པར་མི་རིགས་སོ།",
    "བདག་འདས་པའི་དུས་ན་སྐྱེ་བ་འདི་ལྟ་བུ་དང་འདི་ལྟ་བུ་ཞིག་ཏུ་གྱུར་ཏོ་ཞེས་སྐྱེ་བ་དྲན་པར་མི་རིགས་སོ།",
    "བདག་རྟག་པ་ཡོད་ན་ནི་དེ་ཉིད་ཚེ་རབས་གཞན་དུ་རྒྱུ་བའི་ཕྱིར་རྗེས་སུ་དྲན་པར་རིགས་སོ།",
    "སྔོན་བྱས་པ་ཡི་རྨ་མཐོང་ནས།",
    "འདི་ན་ཚེ་རབས་གཞན་དག་ཏུ་མཚོན་ལ་སོགས་པས་བསྣུན་པ་ལས་བྱུང་བའི་རྨའི་སྲོལ་རྣམས་དེ་ལྟ་བུས་ཉེ་བར་མཚོན་པའི་ལུས་ཅན་ལ་ལ་དག་རྣམ་པར་མི་འཇིག་ཅིང་།",
    "དེ་རྣམས་དོན་གཞན་དང་འབྲེལ་པ་ལས་བྱ་བའི་ཁྱད་པར་དང་ལྡན་པར་གྱུར་ན་ནི་འོན་ཏེ་དེ་རྣམས་ལ་ཁྱད་པར་སྔར་ཡོད་པ་མ་ཡིན་པར་རྣམ་པར་འགྱུར་རོ།",
    "གལ་ཏེ་བདེ་བ་དང་སྡུག་བསྔལ་གྱི་གནས་སྐབས་དག་ཏུ་འདི་ལ་ཁྱད་པར་འགའ་ཡང་མེད་ན་ནི་དེ་དག་ཕན་ཚུན་ཐ་དད་པར་མི་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་གདོན་མི་ཟ་བར་བདག་འདིས་བདེ་བ་ལ་སོགས་པ་སྣ་ཚོགས་པའི་རྗེས་སུ་བྱེད་པར་བྱ་དགོས་ལ།",
    "བྱེད་པ་ལོག་པར་འགྱུར་བ་སྟེ།",
    "དེའི་ཕྱིར་འདི་ལ་མིག་ལ་སོགས་པའི་བྱེད་པ་དགོས་པ་མེད་པའི་ཕྱིར་དོན་མེད་པར་འགྱུར་རོ།",
    "གལ་ཏེ་མིག་ལ་སོགས་པ་རྣམས་མེད་ན་དེ་རྣམས་ཀྱི་འཇུག་པ་དག་མེད་པར་འགྱུར་ལ།",
    "དེ་མེད་པས་ཀྱང་བློ་མེད་ཅིང་བློ་མེད་པས་ཀྱང་ཤེས་པ་ཉིད་མེད་པར་འགྱུར་ན་ནི་དེའི་ཚེ་དགོས་པ་དང་བཅས་པའི་ཕྱིར་དེ་ལས་བཟློག་པའི་སྒོ་ནས་མིག་ལ་སོགས་པ་བྱེད་པར་རིགས་པར་འགྱུར་ན།",
    "དེ་ལས་ཐ་དད་པའི་རྫས་ཀྱི་རང་བཞིན་མེད་པའི་ཕྱིར་ཤེས་པ་ཡོད་པ་དང་བྲལ་བའི་བདག་ཉིད་དུ་ཡང་ཡོད་པ་ཡིན་ནོ་ཞེས་བྱ་བར་བརྟག་པར་མི་ནུས་སོ།",
    "བྱེད་པ་ལོག་པར་འགྱུར་བ་སྟེ།",
    "ཤེས་པ་ཡོད་པའི་ས་བོན་ཤེས་པ་ཡོད་པའི་ནུས་པ་དང་ཤེས་པ་ཡོད་པའི་ནུས་པ་ལས་ཀྱང་གཞན་དུ་སྟེ་ཐ་དད་པར་ཤེས་པ་ཡོད་པ་མཐོང་སྟེ་དེའི་ཕྱིར་ཤེས་པ་ཡོད་པའི་ཁམས་ལས་ཤེས་པ་ཡོད་པ་འབྱུང་ན་ཁམས་དང་ཡུལ་མཚུངས་པར་འགྱུར་བ་ཞིག་གོ།",
    "ཤེས་པ་ཡོད་པའི་ནུས་པའི་ངོ་བོ་ལས་ཐ་དད་པར་སྐྱེས་བུའི་ནུས་པ་གསལ་བར་ཡོད་པ་ཡང་མ་ཡིན་ཏེ།",
    "སྐྱེས་བུ་རྣམ་པར་འགྱུར་བར་འགྱུར།",
    "རྣམ་པར་འགྱུར་བ་ཉིད་ལས་ཀྱང་ལྕགས་ཁོ་ན་བཞིན་དུ་བདག་ལ་རྟག་པ་ཉིད་མེད་དོ་ཞེས་བྱ་བར་གྲུབ་བོ།",
    "རྡུལ་ཕྲ་རབ་ཙམ་གྱི་ཕྱོགས་དང་ཤེས་པ་ཡོད་པ་དང་འབྲེལ་པས་སྐྱེས་བུ་ཤེས་པ་ཡོད་པ་དང་བཅས་པ་ཡིན་ནོ་ཞེས་བརྗོད་པར་མི་ནུས་སོ།",
    "ཤེས་པ་ཡོད་པ་མ་ཡིན་པ་དེ་ལ་ནི་བུམ་པ་ལྟར་བདག་ཉིད་དུ་རྟག་པར་རིགས་པ་ཡང་མ་ཡིན་པས་བདག་རྟག་པར་མི་འཐད་དོ།",
    "ཁྱད་པར་ཅི་ཡང་ཡོད་མ་ཡིན།",
    "ཡོན་ཏན་གསུམ་གྱི་བདག་ཉིད་ཅན་གྱི་རང་བཞིན་སྐྱེས་བུ་ཡུལ་ཉེ་བར་ལོངས་སྤྱོད་པར་འདོད་པ་རིགས་པ་དེ་ནི་དེའི་ཚེ་སེམས་པ་ཅན་མ་ཡིན་པར་གྱུར་ཀྱང་སྐྱེས་བུ་དང་ཐ་མི་དད་པར་རྟོགས་པར་བྱས་ནས་རྣམ་པར་འགྱུར་བའི་ཚོགས་མཐའ་དག་སྐྱེད་པར་བྱེད་དོ།",
    "གཉི་གའི་འཇུག་པར་བྱེད་པའོ།",
    "ཡོད་པ་མ་ཡིན་པའི་དོན་ཡང་རྡོལ་བར་བྱེད་དེ་གྲངས་ཅན་འདི་ཡང་དེ་བཞིན་དུ་ཡོན་ཏན་ཤེས་པ་ཡོད་པ་མ་ཡིན་པ་རྣམས་བསྟན་བཅོས་ཀྱི་སྒོ་ནས་བྱེད་པ་པོ་ཉིད་དུ་སྟོན་པ་ན་དོན་ཇི་ལྟར་རྣམ་པར་གནས་པ་དེ་ལྟར་མི་རྟོགས་ཤིང་ཕྱིན་ཅི་ལོག་ཏུ་ཡང་ངེས་པར་འཛིན་པར་བྱེད་ལ།",
    "གཞན་ཡང་འདིའི་སྐྱེས་བུ་འདི་ནི་རྣམ་པར་འགྱུར་བའི་ཚོགས་ཀྱི་བྱེད་པ་པོ་མ་ཡིན་ཞིང་ཟ་བ་པོ་ཡིན་ལ་ཡོན་ཏན་རྣམས་ནི་བྱེད་པ་པོ་ཡིན་གྱི་ཟ་བ་པོ་མ་ཡིན་ཏེ།",
    "ཟ་བར་རྣམ་པར་མི་ཤེས་པ།",
    "བྱ་བ་དང་ལྡན་པ་ཉིད་དུ་ཡོད་ན་ཡང་ངེས་པར་བྱ་བ་རྩོམ་པའི་དུས་ན་འདི་ལ་བྱ་བ་དེའི་སྔར་གྱི་གནས་སྐབས་ལས་ཁྱད་པར་ཁས་བླང་བར་བྱའོ།",
    "སྔ་ཕྱིའི་གནས་སྐབས་དག་ཏུ་ཁྱད་པར་མེད་པའི་བདག་ནི་སྔར་གྱི་གནས་སྐབས་བཞིན་དུ་བྱ་བ་དང་ལྡན་པ་ཉིད་དུ་མི་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་འདི་ལ་ཡང་ཡོད་པར་མི་འགྱུར་རོ།",
    "བྱ་བ་ཞེས་བྱ་བ་ནི་བྱེད་པ་པོ་བརྟེན་པའམ་ལམ་ལ་བརྟེན་པར་འགྱུར་བ་ཞིག་གོ།",
    "དེ་ནི་འགྲོ་བ་པོ་ལྷ་སྦྱིན་ལ་གནས་ཏེ།",
    "དེ་དང་འབྲེལ་པ་ལས་ལྷ་སྦྱིན་འགྲོ་ཞེས་བྱ་བར་བརྗོད་དོ།",
    "འཚེད་པ་ལ་སོགས་པ་མི་འགུལ་བའི་བདག་ཉིད་ཅན་གང་ཡིན་པ་དེ་ཡང་བྱེད་པ་པོ་ལ་གནས་པའི་བྱེད་པ་དང་དངོས་པོ་གཉིས་དང་མཚུངས་པར་རིག་པར་བྱའོ།",
    "མ་ཡིན་ནམ་དངོས་པོ་བྱ་བ་མེད་པས་ནི་ཡོད་པ་མ་ཡིན་པ་ནམ་མཁའི་མེ་ཏོག་ལ་སོགས་པ་དང་མཚུངས་པར་འགྱུར་རོ།",
    "དངོས་པོ་བྱས་པའི་རྒྱུ་ཅན་གྱི་བྱ་བ་བཀག་པས་ཀྱང་མ་ཡིན་ནོ།",
    "དེའི་ཚེ་དེ་རྣམ་པར་མི་འགྱུར་བ་ཉིད་ཀྱི་ཕྱིར་གྲོལ་བར་མི་འགྱུར་རོ།",
    "དངོས་པོ་སྐད་ཅིག་མའི་རྟེན་བདག་སྐད་ཅིག་མ་མ་ཡིན་པ་ཡོད་པས་རྣམ་པ་ཐམས་ཅད་དུ་མེད་པར་ཁས་མ་བླངས་པ་ལས་ཆད་པར་ལྟ་བ་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཡང་གལ་ཏེ་མི་རྟག་པ་ཆད་པར་འགྱུར་ན་ནི་དེའི་ཚེ་རྒྱུན་ནི་མི་འཇུག་པའི་མཚན་ཉིད་ཅན་གྱི་འཇུག་པར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་དེ་ལྟར་རྩྭ་ལ་སོགས་པ་འདི་རྣམས་ད་རུང་དུ་ཡང་དམིགས་པར་འགྱུར།",
    "མི་རྟག་པ་ཡང་ཆད་པ་ཡིན་པས་ངེས་པར་ཆད་པ་ཉིད་ཀྱི་ཕྱིར་མ་རིག་པས་འཇུག་པར་མི་བྱ་བ་ཞིག་གོ།",
    "དངོས་པོས་རྟག་པ་རྒྱུ་དང་རྐྱེན་ལ་རག་མ་ལས་པར་འགྱུར་བ་འགའ་ལ་ཡང་ཡོད་པ་ཉིད་མེད་དོ་ཞེས་སྔར་བསྟན་ཟིན་ཏོ།",
    "བདག་ནི་ཡོད་པར་འགྱུར་ནའང་གཟུགས།",
    "གཞན་ལས་གནས་པར་སྣང་འགྱུར་ཞིང་།",
    "གཞན་ལས་རྣམ་པར་འཇིག་པར་སྣང་།",
    "གལ་ཏེ་དེ་ལྟར་ན་དེའི་འབྲས་བུ་ཡང་ཐོག་མ་མེད་པར་འགྱུར་དགོས་སོ།",
    "ཅི་སྟེ་ཡོད་ཀྱང་དེ་སྔར་རྒྱུ་ཉིད་མ་ཡིན་ན་ཕྱིས་དེའི་རྒྱུ་ཉིད་སུས་བྱས།",
    "ད་ལྟར་བྱུང་བ་སྟེ་དུས་གསུམ་ན་རྣམ་པར་གནས་པའི་དངོས་པོ་ལས་ཐ་དད་པ་རྟག་པ་ཞིག་གོ་ཞེས་སྨྲའོ།",
    "འདི་ལ་བརྗོད་པར་བྱ་སྟེ།",
    "གལ་ཏེ་དུས་ཞེས་བྱ་བ་དངོས་པོ་ལས་ཐ་དད་ཅིང་བདག་ཉིད་ཀྱིས་གྲུབ་པ་ཡོད་པར་འགྱུར་ན་ནི་དེ་སྐྱེ་བ་དང་འཇིག་པའི་རྒྱུ་ཉིད་དུ་འགྱུར་ན།",
    "མ་འོངས་པའི་དུས་ཉེ་བར་མཚོན་པར་བྱ་བའི་དོན་དུ་མ་འོངས་པའི་བུམ་པ་ཉེ་བར་བཀོད་ལ།",
    "འདས་པ་དང་ད་ལྟར་གཉིས་ལ་མ་ལྟོས་པར་ནི་མ་འོངས་པའི་དུས་རྣམ་པར་གཞག་པར་མི་ནུས་ཏེ།",
    "ཇི་ལྟར་མ་འོངས་པ་ད་ལྟར་དུ་མ་འོངས་པ་ལས་མ་འོངས་པ་ཡིན་པ་དེ་བཞིན་དུ་ད་ལྟར་བ་དང་འདས་པ་གཉིས་ཀྱང་མ་འོངས་པས་མ་འོངས་པར་འགྱུར་རོ།",
    "མ་འོངས་པར་མ་འོངས་པ་ལས་ནི་མ་ཡིན་ནོ་ཞེ་ན།",
    "འདི་ལ་དགོངས་ནས་སློབ་དཔོན་མ་འོངས་པ་མེད་པར་བསྟན་པ་བཞེད་དེ།",
    "གསུམ་ཆར་ཡང་མ་འོངས་པ་ཉིད་ཡིན་ན་ཡང་ད་ལྟར་བྱུང་བ་དང་འདས་པ་གཉིས་མི་སྲིད་པའི་ཕྱིར་གང་དུ་མ་འོངས་པ་ལས་མ་འོངས་པར་རྣམ་པར་གཞག།",
    "དེའི་ཕྱིར་མ་འོངས་པ་ལ་ཡོད་པས་འདས་པ་ཐ་དད་པར་གྲུབ་པ་ཡོད་ན་ཡང་མ་འོངས་པ་ཡོད་པ་ཁོ་ནའོ་སྙམ་དུ་སེམས་ན།",
    "དེ་ནི་ཇི་ལྟར་འདས་པར་འགྱུར།",
    "གལ་ཏེ་འདས་པ་མ་བརྟག་པར་བྱ་སྟེ།",
    "གལ་ཏེ་མ་འོངས་པའི་དངོས་པོ་སྐྱེས་པར་འགྱུར་ཏེ་ཡོད་དོ་ཞེས་བྱ་བར་ཡོངས་སུ་རྟོགས་ན་ནི་དེ་སྐྱེས་པ་ཉིད་དུ་གྱུར་པས་ཡོད་པ་ཉིད་ཀྱི་ཕྱིར་དང་ད་ལྟར་བར་འགྱུར་གྱི་མ་འོངས་པར་མི་འགྱུར་རོ།",
    "ཅི་སྟེ་མ་སྐྱེས་པར་གྱུར་པ་དེ་ལ་ཡོད་པ་ཉིད་དུ་རྟོག་ན།",
    "མ་འོངས་རྟག་པར་འགྱུར་རམ་ཅི།",
    "གང་ཞིག་མ་སྐྱེས་པར་གྱུར་པ་དང་ཡོད་པ་དེ་ནི་མྱ་ངན་ལས་འདས་པ་བཞིན་དུ་རྟག་པ་ཁོ་ནར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་མྱ་ངན་ལས་འདས་པ་ཁོ་ན་ལྟར་དེའི་མ་འོངས་པ་ཉིད་ཉམས་པར་འགྱུར་རོ།",
    "དེ་ལྟར་ན་ཡང་དེ་ནི་འདུས་མ་བྱས་ལྟར་མི་འཇིག་པ་མ་ཡིན་ནོ།",
    "དེ་ནི་རྟག་པར་ཅིས་མི་རྟོག།",
    "ཡང་ན་དངོས་པོ་གང་ཞིག་མི་རྟག་པར་རྟག་ནུས་པར་འགྱུར།",
    "ཞིག་ཟིན་པ་ན་སླར་ཡང་འཇིག་པར་མི་རིགས་ཏེ་དགོས་པ་མེད་པའི་ཕྱིར་དང་།",
    "དེ་བཞིན་དུ་དངོས་པོ་རང་བཞིན་དང་བཅས་པར་སྨྲ་བ་ལ་དུས་གསུམ་མི་རིགས་སོ།",
    "དེ་མེད་པའི་ཕྱིར་འགྲོ་བ་ཐམས་ཅད་བོང་བུའི་རྭ་ལྟར་གཟུང་དུ་མེད་པར་འགྱུར་བས་གནམ་གྱིས་བསྐོས་པར་སྨྲ་བར་མི་རིགས་སོ།",
    "གལ་ཏེ་དངོས་པོ་མ་འོངས་པ་ཡོད་པར་སྨྲ་བ་འདི་རིགས་པར་འགྱུར་ན་ནི་དེའི་ཚེ་ཕྱིས་སྨྲ་བ་རྣམས་ཀྱི་སྨྲ་བ་ཡང་རིགས་པར་འགྱུར་བས་མ་འོངས་པའི་དོན་ཡོད་པར་སྨྲ་བ་མི་རིགས་སོ།",
    "དེ་ལྟར་ཡིན་ན་ནི་འདིའི་མི་རྟག་པ་ཉིད་དུ་འགྲུབ་པར་འགྱུར་རོ།",
    "གང་ཞིག་མི་རྟག་པ་ཉིད་ཀྱིས་བྱེད་པ་ཐ་མ་ཡང་ཡོད་དེ་དེའི་ཕྱིར་ཐོག་མ་དང་ཐ་མ་ཡང་ཡོད་པས་རྟག་པར་སྨྲ་བ་མེད་པ་དང་།",
    "དེའི་འབྲས་བུ་ཡོད་པར་སྨྲ་བ་མི་རིགས་སོ།",
    "གང་ཞིག་འབྲས་བུ་ཡོད་པར་སྨྲ་བ་ལ་སྐྱོན་མཐོང་བས་མ་འོངས་པ་མེད་དོ་ཞེས་བྱ་བར་རྟོགས་པ་དེའི་ལྟར་ན་ཡང་།",
    "སྒྲིམ་པ་མེད་པར་ཐར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་གྲོལ་བ་རྣམས་ལ་མ་འོངས་པ་མེད་པར་སྒྲིམ་པ་མེད་པར་སྒྲུབ་པར་བྱེད་པ་ཡིན་ཏེ་དེ་རྣམས་བཞིན་དུ་འབྲས་བུ་མ་འོངས་པ་མེད་པར་སྨྲ་བ་འདི་ཡང་སྒྲིམ་པ་མེད་པར་ཐར་བར་འགྱུར་ན།",
    "འདི་ནི་དེ་ལྟར་ཡང་མ་ཡིན་པས་འབྲས་བུ་མེད་པར་སྨྲ་བར་མི་རིགས་སོ།",
    "ཆགས་མེད་པར་ཡང་འདོད་ཆགས་ནི།",
    "མ་འོངས་པ་མེད་ན་རྣམ་པར་ཤེས་པ་སྐྱེའོ་ཞེས་བྱ་བར་མི་འགྱུར་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ནི་མ་འོངས་པ་ཉིད་ཀྱི་ཕྱིར་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཡང་ན་མ་འོངས་པ་མེད་པ་མ་ཡིན་ནོ་ཞེས་བྱ་བར་རྣམ་པར་རྟོག་པའི་དོན་ཏོ།",
    "ཡོངས་སུ་འགྱུར་བ་འདི་ཡོད་པ་ཉིད་དུ་གཞག་པར་མི་ནུས་ཏེ།",
    "ཞོ་འོ་མའི་རྣམ་པར་འགྱུར་བ་ཡིན་པར་རྣམ་པར་གཞག་པར་ནུས་པ་ཡང་མ་ཡིན་ཏེ།",
    "གལ་ཏེ་ཡོད་པར་འགྱུར་ན་ནི་འོ་མ་ཁོ་ན་ལ་ཞོ་ཞེས་བྱ་བར་འགྱུར་ན་འདི་ནི་རིགས་པ་ཡང་མ་ཡིན་ཏེ།",
    "ཆོད་པ་དང་ཕྲ་བ་དང་གཟུགས་ཅན་མ་ཡིན་པའི་དོན་ཡོངས་སུ་གཅོད་པར་ནུས་པའི་ཡིན་གྱིས་ཀྱང་མི་འཛིན་ཏོ།",
    "ཡོད་པར་མི་མཁས་རྣམས་ཀྱིས་རྟོགས།",
    "དུས་དེ་ནི་རང་ཉིད་ཀྱིས་ལུས་ཅན་མ་ཡིན་པའི་ཕྱིར་དངོས་པོ་ཁོ་ན་ཉེ་བར་བཟུང་ནས་ཡོངས་སུ་གཅད་པར་ནུས་ཀྱི།",
    "གལ་ཏེ་དེའི་རྒྱུ་དངོས་པོ་ཉིད་ཡོད་ན་ནི་དུས་འདི་ཡོད་པར་འགྱུར་བ་ཞིག་ན་སྲིད་པ་ཡང་མ་ཡིན་ནོ།",
    "གལ་ཏེ་གནས་པ་ཡོད་ན་ནི་གནས་པ་དང་ལྡན་པའི་དངོས་པོ་སླར་རྒ་བ་དང་འབྲེལ་པར་མི་འགྱུར་ཏེ།",
    "ཐ་མར་རྙིངས་པར་མི་འགྱུར་རོ།",
    "དོན་གཉིས་རྣམ་པར་མི་ཤེས་པ།",
    "དེ་བཞིན་རྣམ་པར་ཤེས་གཉིས་ཀྱིས།",
    "དོན་གཅིག་རྣམ་པར་མི་ཤེས་སོ།",
    "གལ་ཏེ་དངོས་པོ་ལ་གནས་པ་ཞེས་བྱ་བ་ཞིག་ཡོད་ན་ནི་དེའི་ཚེ་རིམ་གྱིས་རྣམ་པར་ཤེས་པ་དུ་མའི་ཤེས་བྱར་འགྱུར་རོ།",
    "འགགས་པས་ན་ཡུལ་གཞན་དམིགས་པར་མི་ནུས་སོ་ཞེས་བྱ་བ་འདི་ཁས་བླངས་པ་ཡིན་ནོ།",
    "ཕྱི་ནས་གང་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་འབྱུང་སྟེ།",
    "དེའི་ཕྱིར་རྣམ་པར་ཤེས་པ་གཉིས་ཀྱིས་དོན་གཅིག་རྣམ་པར་ཤེས་པ་མ་ཡིན་ཏེ།",
    "གཅིག་ནི་ཡུལ་གྱི་རྣམ་པ་དངོས་སུ་གཅོད་པར་བྱེད་པ་སྟེ།",
    "གཉིས་པས་ནི་དངོས་སུ་བྱེད་པ་ཉིད་དུ་རྣམ་པར་ཤེས་པ་མ་ཡིན་ཏེ།",
    "ཚུལ་འདི་གནས་པ་ལ་ཡང་རྟག་པར་ནུས་པ་ནི་མ་ཡིན་ཏེ།",
    "དེའི་ཕྱིར་ཡོངས་སུ་གཅད་པར་བྱ་བ་མ་ཡིན་པས་གནས་པ་མེད་ལ།",
    "གནས་པས་ནི་ད་ལྟར་བའི་དུས་མཚོན་པར་བྱེད་དེ་གནས་པ་དང་བྲལ་བའི་ད་ལྟར་བ་ཉིད་མི་སྲིད་པའི་ཕྱིར་རོ།",
    "འདི་ལ་བརྗོད་པར་བྱ་སྟེ།",
    "མེད་པར་མཐའ་ཡང་ཡོད་མ་ཡིན།",
    "དཔེར་ན་རྟེན་དང་བརྟེན་པ་དག་ཐ་དད་པའི་ཕྱིར་ཁྱིམ་ན་ཡོད་པའི་ལྷ་སྦྱིན་ཁྱིམ་ཉིད་དུ་མི་འགྱུར་བ་དེ་བཞིན་དུ་གནས་པ་དུས་སུ་མི་འགྱུར་ཏེ་དུས་ལ་ཡོད་པའི་ཕྱིར་རོ།",
    "ཅི་སྟེ་གནས་པ་མེད་ན་ནི་གནས་པ་དང་བྲལ་བའི་དུས་ལ་མཐའ་ཡས་ཏེ་འཇིག་པ་ཡང་ཡོད་པར་མི་འགྱུར་རོ།",
    "དེའི་ཕྱིར་ད་ལྟར་བྱུང་བའི་དུས་ཡུན་དུ་གནས་པར་འགྱུར་ལ།",
    "དུས་དེ་རྟག་པའི་ཕྱིར་ད་ལྟར་བྱུང་བའི་དངོས་པོ་ཡང་རྟག་པར་འགྱུར་ན།",
    "དངོས་པོ་ལ་མི་རྟག་པ་ཉིད་ཡོད་པའང་ཡིན་ཏེ་དེའི་ཕྱིར་དེ་ཡོད་པས་གནས་པ་ཡང་ཡོད་པར་འགྱུར་རོ།",
