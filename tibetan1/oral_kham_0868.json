    "ཁྲི་མཐོའི་སྟེང་དུ་རང་ཉིད་བེར་གྱོན་འདུག།",
    "རང་མདུན་མེ་ར་ཆེན་པོ་འདུག་པའི་ནང་།",
    "སྔགས་པ་ཞིག་ཀྱང་འདུག་པའི་ཁྱིམ་དེ་རུ།",
    "ཁང་པ་ཆེན་པོ་གཉིས་ནི་གདའ་བ་ལ།",
    "འབུ་སྲིན་འཐབ་ཐག་མང་པོ་གདའ་བ་གསལ།",
    "ཐུར་དུ་ནར་ནས་གདའ་བའི་ཁ་དེ་ནས།",
    "བཞུགས་ནས་གདའ་བ་ཉམས་རྨིས་མཚམས་སུ་མཐོང་།",
    "དེ་ལ་འཁོར་ནི་མང་པོ་འགའ་འདུག་པ།",
    "འཐུང་པས་ཤིན་ཏུ་ཞིམ་པར་གདའ་བར་རྨིས།",
    "ངོ་ལ་རྩེ་གཅིག་བལྟ་ཞིང་འདུག་པ་མཐོང་།",
    "བཞུགས་མལ་ན་བཟའ་དང་བཅས་ཁྲིག་གེར་འདུག།",
    "མདུན་དུ་ཕྱག་རྔ་ཞིག་ཀྱང་བཏགས་ནས་འདུག།",
    "སྐུ་འདྲ་གསར་པ་མང་པོ་འདུག་པ་རྨིས།",
    "སྐུ་དྲེག་ཅུང་ཟད་ཕོག་གདའ་རྨིས།",
    "དང་པོ་ཉུང་འདུག་བསམ་ན་ཡང་།",
    "ཕྱིར་ནངས་ཉམས་སྣང་རང་མདུན་ཕ་ཀི་སོགས།",
    "ཕུལ་བྱུང་རང་ཉིད་སེམས་ཀྱང་དགའ་བའང་རྨིས།",
    "ཟེར་བའི་ཡི་གེ་འདུག་པ་མཐོང་སྣང་བྱུང་།",
    "གཞོན་ནུ་ཆས་བཟང་ཞིག་ནི་གདའ་བ་དེ།",
    "ང་ཡིས་གང་སྨྲས་ཁོ་ཡིས་གོ་འདུག་པས།",
    "རང་ལ་བག་མ་ཞིག་ནི་བསུ་ཤོམ་གདའ།",
    "ཚར་ནུབ་ལྷམ་ནི་ཆེན་པོ་གཉིས་གདའ་བ།",
    "སྐེ་མན་ནུབ་ཀྱང་སྐྱོན་ནི་མི་གདའ་ཞེས།",
    "ཁྲི་མཐོའི་སྟེང་དུ་ཨ་ནུ་བཞུགས་འདུག་པ།",
    "གདུང་ཞིག་གོས་ཆེན་གྱིས་ནི་བཏུམ་ནས་འདུག།",
    "འོད་དེ་རོ་ལ་ཕོག་ནི་བཅུག་ཅིང་འདུག།",
    "གསེར་ཕྱེ་ཐུམ་པོ་གང་ཡང་གདའ་བ་རྨིས།",
    "རྡོ་ལ་རྒྱལ་པོའི་སྐུ་གཅིག་བྱོན་གདའ་བས།",
    "དེ་ལ་བྱེ་མ་ལེབ་གཅིག་འབྱར་གདའ་བས།",
    "ཁོ་རང་ཡིན་སྙམ་དེ་ལ་ཐུན་གྱིས་བྲབ།",
    "སྤུ་གྲི་ལྟ་བུར་ཤིན་ཏུ་རྣོ་བར་འདུག།",
    "སྔགས་བདག་གཏོར་མ་ཆེན་པོ་བཅས་གདའ་བ།",
    "ལྡེར་སོ་མདའ་ཚད་ཙམ་ཞིག་གདའ་བ་རྨིས།",
    "ཕོ་རོག་ཅིག་ནི་འདུག་པའི་སྣང་བ་བྱུང་།",
    "ཚེ་རིལ་འབྲུ་གསུམ་ལག་ཏུ་ཕྱིན་གདའ་བས།",
    "གསལ་པོར་གདའ་བས་གདམ་པར་ངེས་ཤེས་སྐྱེས།",
    "དེ་ཡང་རང་ལ་མངོན་ཤེས་མེད་ཕྱིར་ཡིན།",
    "སྔོན་ནས་སྐུ་སྐྱེ་ཡིན་པར་གྲགས་འདུག་པས།",
    "ཁོ་ན་འདུག་པ་བསྔོ་སྨོན་མཐའ་བཙན་ཕྱིར།",
    "ཡིན་ངེས་ཟེར་བ་འདུག་པར་མཐོང་བ་དང་།",
    "ཟེར་བ་གཅིག་ནི་གདའ་བ་དེ་ཡི་དོན།",
    "སྐུ་སྐྱེ་དེ་ལ་བཀོན་ནི་དགོས་གྱུར་འདུག།",
    "ནུབ་ཀྱི་ཕྱོགས་སུ་སེང་གེ་གཅིག་འདུག་པ།",
    "ཟེར་བ་འདུག་ཅིང་ཡང་ནི་ཉམས་སྣང་ལ།",
    "རང་ལ་མ་དགའ་འདུག་ཟེར་སྐྲག་པའི་ཚེ།",
    "དེ་འདྲ་གཅིག་ཏུ་སྐྱེ་བར་འདུག་གོ་སྨྲས།",
    "གསོན་པོ་རྣམས་ལ་སྲུང་སྐྱོབ་ནུས་པར་འདུག།",
    "ཐོག་མ་ཉིད་ནས་རིགས་བཟང་ཡིན་པར་གདའ།",
    "འཇའ་ཡི་གུར་ཁང་ཟླུམ་པོ་ཞིག་འདུག་པའི།",
    "སྟེགས་ནི་མཐོན་པོའི་ཁ་ན་འདུག་པ་སྟེ།",
    "ཕན་ཡོན་ཆེན་པོ་གདའ་བའི་ངེས་ཤེས་ཐོབ།",
    "ཤི་ཁ་ཐུགས་དམ་འདུག་ཤོམ་བྱས་འདུག་པ།",
    "རང་ཉིད་འདུག་པའི་ཡུལ་ཕྱོགས་འདི་ཉིད་ཀྱི།",
    "འདུག་ཅེས་ཡི་གེ་བསྐུར་བ་ལ།",
    "གཉོམ་ཆུང་རྣམས་ཀྱང་ལྷག་པར་འདུག་སྟབས་དཀའ།",
    "བློ་གཏད་ཕེར་བའི་སྐྱབས་གཞན་མི་འདུག་པས།",
    "རིག་པ་ཧུར་ཞིང་རང་ཉིད་ཉམས་འབར་ནས།",
    "རང་ཉིད་ལུས་ནི་གཅེར་བུར་འདུག་པ་ལ།",
    "འོང་རྒྱུ་ཡིན་པར་འདུག་གོ་སྨྲས་པ་དང་།",
    "ཡང་ཡང་བསྐུལ་བ་རྣ་ཅོ་ཚ་འདུག་ཅིང་།",
    "སྲི་མནོན་སོགས་དཀའ་ལས་ཆེ་འདུག་པས།",
    "རྣམ་སྲས་སྒབ་འདྲེ་པེ་དཀར་ཡིན་འདུག་པས།",
    "དངུལ་སྲང་དྲུག་ཅུ་ལ་སོགས་རྒྱུ་ཟོག་གདའ།",
    "སྔགས་པ་ཁོ་རང་ཞྭ་ནས་གདན་ལ་འབྱར།",
    "རྣམ་སྲས་སྒྲུབ་པ་འདོད་མཁན་མང་འདུག་སྟེ།",
    "དགོས་ཀྱང་རང་ནོར་ཅི་ཡང་མེད་པ་དེས།",
    "རང་ཉིད་ཁྲི་ལ་འདུག་དང་རྟ་ཞོན་རྨིས།",
    "གཉིས་ཀྱིས་ཁྲབ་གྱོན་ཕྱེད་དཀྱིལ་བྱས་འདུག་པ།",
    "དཔོན་ཆེན་ཕྱུག་པོ་ཆས་བཟང་རང་དྲུང་འདུག།",
    "རང་ལ་རྒྱལ་མཚན་མང་པོ་འདུག་པ་དང་།",
    "སྨྲས་ཤིང་རང་ལ་དེ་རྣམས་ཡོད་སྙམ་བྱེད།",
    "དེ་ཡི་སྟེང་དུ་ཁོ་བོ་འདུག་པའི་ཚེ།",
    "རྒྱལ་བུ་སྐྱེས་མ་ཐག་ནས་ཁྲི་མནན་འདུག།",
    "རྒྱལ་པོ་ང་རང་ཡིན་སྨྲས་ཡིན་སྣང་ཤར།",
    "གཟུགས་ནི་ཅི་ལྟར་འདུག་པ་མ་མཐོང་བར།",
    "མཇལ་སྣང་མཇལ་བ་ཡིན་ནོ་བསམས་ཤིང་འདུག།",
    "ནས་རྡུང་བྱེད་པར་སྟན་བཟང་སྟེང་དུ་འདུག།",
    "རང་དང་མཉམ་དུ་གུང་ཚིགས་མཛད་འདུག་པ།",
    "ང་ལ་མང་པོ་འདུག་པས་འབབ་ཀྱང་བྱིན།",
    "རྒྱ་དངུལ་སྲང་བཞི་འདུག་པ་ཚགས་བྱས་རྨིས།",
    "སྨྱུག་མའི་ནགས་ཚལ་ཆེན་པོ་ཞིག་འདུག་པ།"
  ]
}