    "མིང་གི་ཁོངས་ནས་ཚིག་ཕྱུང་ནས།",
    "ཚིག་གིས་དོན་རྣམས་སྟོན་པར་བྱེད།",
    "དག་ཡིག་གི་བསྟན་བྱ་གཙོ་བོ་ཅི་ཞིག་ཡིན།",
    "དེར་གཙོ་བོར་འཕུལ་རྟེན་མགོ་འདོགས་དང་མིང་གཞི་ཡང་འཇུག་དབྱངས་ཡིག་གི་ཁྱད་པར་ལས་མིང་ཇི་ལྟར་གྲུབ་ཚུལ་དང་།",
    "དོན་གྱི་གོ་བས་ཚིག་གི་དག་ཐོན་པ།",
    "གྲངས་ཀ་བརྗོད་པའི་མིང་གི་འཕེལ་གྲུབ་ལ་བརྒྱུད་རིམ་ཇི་འདྲ་ཡོད།",
    "གྲངས་ཀ་བརྗོད་པའི་མིང་གི་འཕེལ་གྲུབ་ལ་རིམ་པ་དུ་མ་བྱུང་བ་སྟེ།",
    "འདི་དུས་ཁྲི་ངོར་སྣང་བཙུན་མོང་གི་བུས།",
    "ཚོང་ཟོང་བརྗེ་རེས་བྱེད་པའི་དགོས་མཁོ་ལས།",
    "འཇལ་བྱེད་ཀྱི་མིང་འཐུས་ཇེ་ཚང་དུ་ཕྱིན་པ་རེད་དོ།",
    "ཅི་ཞིག་ལ་མིང་གི་འཕེལ་ཚུལ་ཟེར་ཞིང་དེར་འཕེལ་ལུགས་གཙོ་ཆེ་བ་གང་དག་ཡོད།",
    "བྱ་བ་བརྗོད་པའི་མིང་གི་སྔོན་འཇུག་དོར་ནས་ཁྱད་གཞི་བརྗོད་པའི་མིང་འཕེལ་པ།",
    "ཅི་ཞིག་ལ་མིང་གི་བསྟན་དོན་ཟེར།",
    "མིང་གི་དོན་ལ་སྒྲ་རང་ངོས་ཀྱི་བསྟན་དོན་སྤྱིར་བཏང་བ་དང་།",
    "སྤྱིར་སྒྲ་དང་ཐ་སྙད་གང་ལ་ཡང་སྤྱིར་བཏང་གི་མཚོན་དོན་དང་།",
    "གནས་སྐབས་ཀྱི་མཚོན་དོན་གཉིས་རེ་ཡོད།",
    "སྤྱིར་བཏང་གི་མཚོན་དོན་དེ་དག་ཡིག་བརྡ་བཀྲོལ་ཚིག་མཛོད་སོགས་ཀྱི་སྟེང་ནས་ཤེས་ཐུབ་ཀྱང་།",
    "ཅི་ཞིག་ལ་མིང་གི་སྤྱིར་བཏང་གི་བསྟན་དོན་ཟེར།",
    "མིང་མཛོད་བརྡ་བཀྲོལ་སོགས་ལས་ཤེས་ཐུབ་ཅིང་བསྟན་བྱ་བྱེ་བྲག་པ་ཞིག་དམིགས་སུ་མི་འཛིན་པར་དོན་སྤྱི་ཙམ་པ་ཞིག་སྟོན་པ་དེ་ལ་མིང་གི་སྤྱིར་བཏང་གི་བསྟན་དོན་ཞེས་བྱ་སྟེ།",
    "ལུག་ཅེས་པའི་སྒྲས་མ་མོ་དང་ལུ་གུ།",
    "ཅི་ཞིག་ལ་མིང་གི་གནས་སྐབས་ཀྱི་བསྟན་དོན་ཟེར།",
    "ཚིག་དོན་གོང་འོག་གི་འབྲེལ་བ།",
    "ཉན་གྱི་ཡུལ་སོ་སོའི་ཀུན་སློང་གི་ཁྱད་པར་ལས་ཤེས་དགོས་པའི་དོན་དེ་ལ་མིང་གི་གནས་སྐབས་ཀྱི་བསྟན་དོན་ཞེས་བྱ་ཞིང་།",
    "མིང་གི་གནས་སྐབས་ཀྱི་བསྟན་དོན་ལ་དབྱེ་ན།",
    "ཀུན་སློང་གིས་གོ་བ།",
    "སྒྲ་གདངས་ལྕི་ཡང་གིས་གོ་བ་སོགས་ཡོད་དོ།",
    "ཅི་ཞིག་ལ་མིང་གི་ངོ་བོ་འགྱུར་བ་ཟེར།",
    "མིང་གཅིག་ལ་བརྡ་སྤྲོད་ཀྱི་ནུས་པ་གཉིས་ཡན་ཡོད་ཅིང་ལྡོག་པ་ཐ་དད་པའི་དབྱེ་བ་དུ་མར་འགྱུར་བ་ནི་མིང་གི་ངོ་བོ་འགྱུར་བ་ཡིན་ཏེ།",
