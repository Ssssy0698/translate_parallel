    "ཚིག་གི་སྦྱོར་བ་སྔར་བས་ཇེ་རིང་དུ་བསྐྱེད་པ་ལ་བྱ་ཕྱིར།",
    "དེའི་ཕྱི་ལོགས་སུ་ཁ་སྐོང་གི་སྒྲ་བསྐྱེད་པ་བཅས་ཐབས་གཙོ་བོ་བཞི་ཡོད་པ།",
    "བརྡ་སྤྲོད་རིག་པ་འཕེལ་འགྲིབ་རེས་མཐུད་ཀྱི་ངང་ནས་དར།",
    "གནའ་བོའི་དུས་ནས་བརྒྱུད་པ་བར་ཆད་པའི་བོད་ཀྱི་བརྡ་སྤྲོད་རིག་པའི་མ་ལག་ཆ་ཚང་ཞིང་ཕུན་སུམ་ཚོགས་པ་འཕེལ་འགྲིབ་རེས་མཐུད་ཀྱི་ངང་ནས་དར་བཞིན་འདུག་གོ།",
    "འདིར་ཚིག་དོན་མི་འགྱུར་བ་རྩ་བར་བྱས་པ་ལ་ཆ་ཤས་གསར་བ་སྤྲས་ཏེ་སྦྱོར་བ་རིང་དུ་བསྐྱེད་པ་ལ་ཚིག་གི་སྦྱོར་བ་སྐྱེད་པ་ཟེར་བ་ལས།",
    "དེ་དག་གི་བར་ན་འབྲེལ་བ་ཅི་ཡོད།",
    "ཚིག་དག་གི་ཕྲད་དང་ཡན་ལག་སོགས་བསྡུས་ཏེ་ཚིག་གི་འབྲུ་ཉུང་ངུར་བསྡུས་པ་ལ།",
    "ཚིག་གི་སྦྱོར་བ་ཐུང་ངུར་བསྐུམ་པ་ནི།",
    "ཚིག་གི་ཆ་ཤས་ཕལ་བ་དག་ཉུང་ངུར་བསྡུས་ཏེ་སྒྲའི་སྦྱོར་བ་ཐུང་ངུར་བསྐུམ་པའི་ཐབས་ཤིག་ཡིན་ཡང་།",
    "ཚིག་ཏུ་མ་གྲུབ་པའི་མིང་གི་ཆ་ཤས་ཉུང་ངུར་སྡུད་པ།",
    "རྒྱང་དུ་བསྐྱོད་པ་ལ་རྒྱང་སྐྱོད་ཅེས་པ་ལྟ་བུ་རྣམས་ནི་མིང་གི་ཆ་ཤས་འབྲུ་ཉུང་ངུར་སྡུད་པའམ།",
    "མིང་གི་ཚོགས་པ་བསྡུས་ནས་མིང་དུ་སྒྲུབ་པ་ཡིན་པས།",
    "ཚིག་གི་འགྲུབ་བྱེད་ཀྱི་ཆ་ཡི་བསྡུ་ལུགས་ཤིག་ཡིན་གྱི།",
    "མ་བསྡུས་གོང་གི་ཚིག་གི་ཆ་ཤས་དང་བསྡུས་རྗེས་ཀྱི་ཚིག་གི་ཆ་ཤས་དག་སྔོན་གྱི་སོ་ན་གནས་ཤིང་།",
    "མིང་དང་མིང་གི་ཚོགས་པའི་ཆ་ཤས་བསྡུས་པས་ཚིག་གི་འབྲུ་ཉུང་ངུར་བསྐུམས་ཀྱང་།",
    "ཚིག་གི་གྲུབ་ཆ་ཉུང་ངུར་མི་འགྲོ་བ་ནི།",
    "སྐུང་ཡིག་ནི་བོད་དུ་ཡི་གེ་འབྲི་ཀློག་གི་སྲོལ་བྱུང་བའི་རྗེས་སུ།",
    "འདི་ལྟའི་དྲི་བ་འདོན་མཁན་བྱུང་བས་དེང་གི་ཆར་འདི་འདྲའི་ཁྱད་པར་མི་ཤེས་པའང་རེ་གཉིས་མ་ཡིན་སྙམ་སྟེ་ལན་ལྡོན་པར་བྱ་སྟེ།",
    "དེ་ཡང་ཚེག་བར་སྔ་ཕྱི་གཉིས་དང་ལྡན་པའི་མིང་གི་ཆ་ཤས་སྔ་མའི་རྗེས་འཇུག་དང་ཕྱི་མའི་སྔོན་འཇུག་སྔ་མའི་མིང་གཞི་དང་ཕྱི་མའི་སྔོན་མིང་།",
    "བཀླག་པའི་ཚེ་ནའང་སྔར་བཞིན་ཆ་ཤས་སྔ་ཕྱིའི་སྒྲ་ཟུར་ཕྱིན་པར་རེ་རེ་བཞིན་བཀླག་དགོས་ཕྱིར།",
    "ཚིག་གི་སྦྱོར་བ་ཉུང་ངུར་བསྐུམ་པའི་ཆ་དང་འབྲེལ་བ་མེད་པ་སྨོས་ཅི་དགོས།",
    "དེ་ནི་ཚིག་སྡུད་ཀྱི་ནང་གསེས་མིང་གི་ཆ་ཤས་ཟོར་ཡང་བར་སྡུད་པ་དང་ཡང་མཚུངས་པ་མ་ཡིན་ཏེ།",
    "མིང་གི་སྡུད་པ་ནི་ཆ་ཤས་གཙོ་བོ་རང་སོར་བཞག་སྟེ་ཕལ་བ་བསྡུ་བ།",
    "ཨ་ཁུ་ཨ་ཞང་ཞེས་པ་ཁུ་ཞང་ལྟ་བུར་སྡུད་པ་དང་།",
    "ཚིག་གི་བསྡུ་ཚུལ་ལ་ཚིག་ཕྲད་ཀྱིས་བསྡུ་བ་དང་།",
    "གླེང་མོལ་གྱིས་བསྡུ་བ་བཅས་ཡོད་པ་ཞིབ་ཏུ་གཞན་ལས་ཤེས་པར་བྱའོ།",
    "ཚིག་གི་བསྟན་དོན་གཡས་གཡོན་དུ་སྒྱུར་བའི་རྐྱེན་གཙོ་བོ་ནི།",
    "ཚིག་གི་བརྗོད་རིམ་གྱི་ཁྱད་པར།",
    "ཚིག་གི་བཀླག་གདངས་ཀྱི་ཁྱད་པར་བཅས་ཡོད་པཞིབ་ཏུ་བོད་ཀྱི་བརྡ་སྤྲོད་སྤྱི་རྣམ་རིག་འཕྲུལ་སྣང་མཛོད་དུ་ཤེས་པར་བྱའོ།",
    "ཚིག་གི་རྣམ་ཆ་ལ་དབྱེ་བ་གང་དག་ཡོད།",
    "བརྡ་སྤྲོད་ཀྱིས་ཚིག་གི་སྦྱོར་ལུགས་དང་།",
    "མིང་ཕྲད་ཀྱིས་ཚིག་གི་འགྲུབ་རྐྱེན་བྱེད་པ་དང་།",
    "དེ་དག་ལ་ཚིག་གི་རྣམ་ཆ་ཞེས་བྱའོ།",
    "ཅེས་པ་ལྟ་བུ་ཚིག་རྐང་རེ་ཚིག་རྐྱང་པས་གྲུབ་པ་དང་།",
    "ལྟ་བུ་ཚིག་རྐང་དུ་མ་གསལ་བྱེད་ཀྱི་སྒྲ་གཅིག་གིས་གསལ་བ་དང་།",
    "ཚིགས་བཅད་གཅིག་གིས་བརྗོད་བྱའི་དོན།",
    "རྐང་པ་གཉིས་ནས་དྲུག་གི་བར།",
    "ཚིགས་བཅད་ཀྱི་སྐབས་ནའང་ཚིག་དང་མིང་གི་ཚོགས་པ་ཅི་རིགས་ཡོད་པ་ཤེས་བར་བྱའོ།",
    "ཚིག་གི་སྦྱོར་བ་ལ་སྤྱན་ཕྱེ་བ་ལྟར་མཛེས་པའི་ཉམས་ཆེས་ཆེར་སྦྱིན་པ།",
    "བཞི་པ་ནི་ཚིག་གི་དོ་མཉམ་ཞིང་སྒྲ་ཡི་གཅོད་མཚམས་གསལ་བས་གྱེར་བདེ་བ།",
    "རང་རེའི་བོད་པ་རྣམས་ཀྱིས་གནའ་སྔ་མོ་ནས་ངག་གི་རྩལ་དང་།",
    "རྩེན་མོའི་ཀྱལ་ག་སོགས་ནི་སྐྱེས་པའི་ཡོན་ཏན་ཞིག་ཏུ་བགྲངས་ཤིང་།",
    "རང་གི་མཚན་ཉིད་ཀྱིས་གྲུབ་པའི་དངོས་པོ་དེ་རང་མཚན་གྱི་མཚན་ཉིད་ཅེས་པར་བསྟན་པ་ལྟར།",
    "དེའི་བྱེ་བྲག་རེ་རེ་བ།",
    "མིང་ནི་ཚིག་གི་འགྲུབ་རྒྱུ་གཙོ་བོ་ཡིན་ན།",
    "ཚིག་གི་དོན་ནི་མིང་འདུས་མའི་བསྟན་བྱ་དེ་ཁོ་ན་ཨེ་རེད།",
    "སྤྱིར་མིང་གི་བསྟན་དོན་ལ།",
    "མིང་གི་བསྟན་དོན་དངོས་ནི་སྐད་ཆའི་སྦྱོར་བ་དངོས་ཀྱི་ནང་དུ་མིང་སྔ་ཕྱིའི་འབྲེལ་བ་ཡིས་བསྐྱེད་པའི་བརྡ་སྤྲོད་ཀྱི་གོ་བ་དེ་ཡིན་པའི་ཁར།",
    "མིང་དུ་མ་འདུས་པའི་དོན་སྤྱི་རགས་པ་དེ་ཚིག་གི་བསྟན་དོན་དུ་གཟུང་ན།",
    "མིང་ནི་ཚིག་གི་འགྲུབ་རྒྱུ་གཙོ་བོ་ཡིན་ཡང་།",
    "མིང་རེ་རེ་བའི་དོན་གོ་བ་ཙམ་གྱིས་ཚིག་གི་བརྗོད་དོན་ཇི་བཞིན་རྟོགས་པར་མི་འགྱུར་རོ།",
    "མི་རིགས་ཤིག་གི་བསམ་བློ་གཏོང་སྟངས་གཏན་ཆགས་ན།",
    "སྐད་ཆ་ནི་ཚིག་གི་སྦྱོར་བའི་ཕུང་པོ་གཏོས་ཆེན་པོ་ཞིག་ཡིན་ཕྱིར།",
    "དེ་དག་རེ་རེ་ལའང་དོན་གྱི་བརྗོད་ལུགས་ཀྱི་སྒོ་ནས་ཚིག་གི་སྦྱོར་བ་ཐ་དད་པ་སྤེལ་བ།",
    "ཚིག་གི་སྒྲོམ་གཞི་ནི་བྱེ་བྲག་ཡིན་ནོ།",
    "ཅི་ཞིག་ལ་ཚིག་གི་གནས་འགྱུར་ཞེས་བྱ་ཞིང་དེ་ལ་རྣམ་གྲངས་གང་དག་ཡོད།",
    "བསྟན་དོན་འགྱུར་མི་འགྱུར་གང་རུང་གི་གནས་ཚུལ་འོག་ཚིག་གི་འགྲུབ་རྐྱེན་སོ་སོའི་གོ་གནས་སྔ་ཕྱིར་བརྗེ་སྣོལ་དང་།",
    "འབྲུ་ཉུང་ངུར་བསྡུ་བ་སོགས་ལ་ཚིག་གི་གནས་འགྱུར་ཞེས་བྱ་ཞིང་།",
    "སུམ་རྟགས་གཉིས་སུ་ཚིག་གི་རྣམ་གཞག་གསལ་བར་མ་བྱས་ཤིང་།",
    "དེང་གི་ཆར་རིག་པ་གཞན་དག་གི་ཤན་ཤུགས་དང་།",
    "དམིགས་གཏད་ཚིག་སྦྲགས་བཅས་ཏེ་ཁྱོན་བསྡོམས་དབྱེ་བ་དགུ་རུ་བསྡུས་པ་ཡིན་ནོ།",
    "སྐད་ཆ་གང་ཡིན་ཡང་ཚིག་རེ་རེ་བ་ནས་སྦྲགས་མ་ཅན་དུ་ཅིས་ཀྱང་འཕེལ་དགོས་པ་ཡིན་ནམ།",
    "ངག་ནས་ཐོལ་བྱུང་དུ་སྐད་རེ་བཏོན་པ།",
    "སྐད་ཐོར་རེ་བ་དེ་ཀུན་ལ་གོམས་པར་གྱུར་པའི་དུས་དེར།",
    "ངག་གི་སྐད་དང་།",
    "ངག་གི་སྦྱོར་བ་ལ་ལག་བརྡ་འཇུག་གིན་ཡོད་པ་དེ་དག་ནི་ཡིད་འགྱུར་གྱི་རང་བྱུང་མཚོན་བྱེད་ཙམ་མ་ཡིན་པར།",
    "ངག་སྦྱོར་རང་ངོས་ཀྱི་དགོས་ངེས་རྒྱུ་རྐྱེན་ཞིག་རེད།",
    "རིམ་གྱིས་མི་རང་གི་བློ་སྟོབས་ཆེར་འཕེལ་ཅིང་མཐོང་རྒྱ་ཆེར་བསྐྱེད་པའི་འབྲས་བུར་མིང་གི་རྣམ་གྲངས་ཇེ་མང་དུ་འཕེལ་པ་དང་ཆབས་ཅིག་ཤེས་བྱ་ཕན་ཚུན་གྱི་འབྲེལ་བ་དང་།"
  ]
