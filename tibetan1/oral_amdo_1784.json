    "རྗེ་ཉིད་ཀྱི་མ་ཡུམ་དེ་ཡིན་སྙམས་པའི་བུད་མེད་ཞིག་གིས་ལྟོས་དང་ཟེར།",
    "གཟིགས་པས།",
    "བུད་མེད་དེས་གསེར་གྱི་རྡོ་རྗེ་འོད་འབར་བ་ཞིག་མདུན་ཐད་ཀྱི་ནམ་མཁར་ལན་གསུམ་འཕང་བའི་མཐར་བར་སྣང་དེར་རྟེན་མེད་དུ་བསྡད་སོང་བ།",
    "སྡིགས་མཛུབ་ཀྱི་བརྡའ་ཐབས་གང་དུ་བསྟན་པའི་ཕྱོགས་དེར་ཧྲིལ་ཧྲིལ་འགྲོ་བ་ཞིག་གཟིགས་པས།",
    "དེ་ནུབ་ཀྱང་ད་དུང་ཚོལ་དང་ངེས་པར་ཡོད་ཟེར་བ་ཞིག་གསན་ནས་སླར་ཡང་བཙལ་བས་སྒྱུ་འཕྲུལ་ཕྲ་མོའི་སྐོར་སོགས་ཀྱི་པུ་སྟི་གཉིས་ཙམ་ཕྱག་ཏུ་འབྱོར།",
    "ད་དུང་ཁ་སྐོང་དགོས་པ་རྣམས་ཞལ་བཀོད་ཕྱག་རིས་བཅས་ད་ལྟའང་བཞུགས་མོད་མཛད་རྗེས་མཐར་མ་ཕྱིན།",
    "སྒྱུ་འཕྲུལ་ཕྲ་མོ་སྐོར།",
    "སྒྲ་ཐལ་འགྱུར་སོགས་རྫོགས་པ་ཆེན་པོ་རྒྱུད་བཅུ་བདུན་ནང་ད་བཞུགས་འགྲེལ་པ་དྲུག་ཙམ་རྫོགས་ཆེན་པར།",
    "ཀ་ཐོག་ལུགས་ཀྱི་མ་མོ་བེའུ་བུམ་སོགས་དཔེ་གཡར་ཐོབ།",
    "ཉག་གླུ་རབ་དགོན་ནས་སྒྱུ་འཕྲུལ་ཕྲ་མོ་ཤིང་པར་ཅན།",
    "རྫོགས་ཆེན་ནས་མཁན་གཞན་དགའི་གསང་འགྲེལ་སོགས་ལག་ཏུ་གང་འབྱོར་གྱི་དཔེ་རྣམས་ལྡེབ་ཚད་དང་འབྲུ་ཚུགས་བཅས་རྒྱ་གར་དཔེ་ལྟར་རྩིས་བྱས་མོད་ཐོག་མར་དཔེ་བཙལ་སྐབས་དང་ཡང་དུ་དངོས་སུ་བྲི་རྒྱུ་སླར་དཔེ་བསྡུར་དང་ཞུ་བཅོས་བཅས་ལ་འགྲོ་སོང་གྲོན་དངུལ་གཏོང་རྒྱུ་ལག་ཁར་མེད་པས་བྱ་ཐབས་བྲལ་བ་ལ།",
    "སྔ་འགྱུར་བཀའ་མའི་དཔེ་རྙིང་ཉུལ་བཙལ་བྱེད་རྒྱུ་དང་གསར་བྲིས་བྱས་ཏེ་འཕྲུལ་པར་རྡེབ་རྒྱུའི་འཆར་གཞི་བཅས་ལ་གྲོན་དངུལ་འགྲོ་སོང་ཞབས་འདེབས་རོགས་སྐྱོར་ཞུ་ཡིག་བཀྲམ་པས།",
    "ཡིག་མཁན་རྣམས་ཀྱང་ལག་རྩལ་བཟང་ངན་མང་བས་དཔེ་བྲིས་སྤུས་ཚད་འདྲ་མཉམ་རེད་མ་ཐུབ་པ་དང་།",
    "ཐེབས་རྩའི་ཆེད་སྒོར་༡དང་གུས་པ་གཉིས་ལ་དར་ཉིན་མོ་བདེ་ལེགས་རེ་དང་།",
    "དར་ཉིན་མོ་བདེ་ལེགས་ཤིག་བསྐུར་གནང་མཛད་དེ་བཀའ་སློབ་གནང་བ།",
    "འདི་ཉིད་ནུབ་ན་སྔ་འགྱུར་བའི་བསྟན་པ་ནུབ་པ་རེད།",
    "དེས་ན་དགོན་ཆུང་རེ་ཟུང་དང་།",
    "རྒྱུད་གཞུང་གི་མན་ངག་ཟབ་མོ་འདི་ལྟ་བུ་རྣམས་ལ་བློ་ཁ་ཙམ་ཡང་མ་ཕྱོགས་པར།",
    "རང་སྣ་རང་གིས་བསུམ་སྟེ་སྡོད་པ་འདི་དག་ནི་ཧ་ཅང་ཡིད་མུག་གི་གནས་སུ་མཆིས།",
    "ཁོ་བོས་ལྷ་ས་དང་བལ་ཡུལ་ཕྱོགས་ནས་འཚོལ་བསྡུ་བྱས་པ་ཁྱོན་པོ་ཏི་ལྔ་བཅུ་ལྷག་ཙམ་ཞིག།",
    "འོན་ཀྱང་ང་ཚོས་པར་སྐྲུན་ཞུས་པ་སྔ་ཕྱི་གཉིས་ཆར་བྲིས་པ་མང་བས་བྲིས་གཟུགས་ཆ་མི་མཉམ་པ་དང་།",
    "སླར་ཡང་རྩིས་འཕྲུལ་ནང་དུ་བླུག་སྐབས་ཀྱི་འགྲོ་སོང་ནི།",
    "གུས་པའི་ལས་གླ་སྔ་ཕྱི་ཀུན་བསྡོམས་པ་མི་དམངས་ཤོག་སྒོར་ཉིས་ཁྲི་བཅས་ཀྱིས་འགྲོ་སོང་གི་རྨང་གཞི་བྱས་པ་བརྒྱུད།",
    "ཁམས་རི་བོ་ཆེའི་བུ་མོ་འཇམ་དབྱངས་མཚོ་མོ་གསུམ་གྱིས་རྩིས་འཕྲུལ་ནང་དུ་བླུགས་སྐབས་ཀྱི་གཙོ་བོའི་ཐུགས་འགན།",
    "ཁོང་གི་འབྲེལ་ཡོད་ནས་ལག་ཐོག་རྩིས་འཕྲུལ་བཞི་དང་།",
    "གཞན་གྱི་ལྗིད་ཐེག་རླངས་འཁོར་དང་འདྲུད་འཐེན་འཁོར་ལོ་ལྕགས་རྟ་སོགས་ལ་བརྟེན་ནས་སོང་བའམ།",
    "རྐང་ལམ་ཕྲ་མོ་བརྒྱུད་ནས་བོད་ཡུལ་མཐོ་སྒང་གི་ལ་ལུང་དུ་མར་རྐང་ཐང་གོམ་འགྲོས་ཀྱིས་བསྐྱོད་དུས་ཁྲེས་པོ་རྒྱབ་ཏུ་ཁུར།",
    "ཚ་པོ་མི་རག་སར་རྩམ་ཕྱེ་འགམས་ལ་ཆུ་གྲང་མོ་བཏུང་བ་དང་།",
    "ཤིང་སྡོང་རྒན་གྱི་འོག་དང་བྲག་སྐྱིབས་ཟུར་དུ་གནས་བཅའ་དགོས་བྱུང་བ་ལྟ་བུའི་མཚོན་ཁོང་རྣམ་པར་འོ་བརྒྱལ་མང་པོ་མྱོང་ཡོད་ངེས་རེད།",
    "བསྒྲིབ་སྦྱང་དང་བསྒྲིབ་སྦྱངས་སྒྲིབ་སྦྱང་སྒྲིབ་སྦྱོང་ལྟ་བུའམ་སྒྲུབ་པ་དང་བསྒྲུབ་པ་ལྟ་བུ་བྱ་ཚིག་གམ་བྱེད་ཚིག་གི་ཚིག་ཏུ་གྲུབ་པ་སོགས་ཡིན་གཅིག་མིན་གཉིས་དེང་སང་གི་བརྡ་སྤྲོད་ལུགས་ཁོ་ནར་བསྟུན་མི་འདུག།",
    "རྩིས་འཕྲུལ་ནང་བཞག་རྗེས་ཡིག་ནོར་ཤོར་ཡོད་པར་མ་དཔེ་དང་བསྡུར་ནས་དག་བཅོས་ཐེངས་ལྔ་དང་ཡིག་སྐྱོན་ཆེ་ཤོས་རྣམས་དག་བཅོས་ཐེངས་དྲུག་ཙམ་བྱས་འདུག་པ་སོགས་བྱ་བ་ཅུང་ཞིབ་མོ་བྱུང་ཡོད་པ་འདྲ།",
    "སྤྱི་ལོ་༢༥ལོ་ནས་འགྲོ་གྲོན་ཟླ་རེ་ལ་མི་དམངས་ཤོག་སྒོར་༢༤ཙམ་རེ་བཏང་བ་དང་།",
    "འོན་ཀྱང་གདུལ་བྱའི་བྱེ་བྲག་གིས།",
    "དེ་དག་གང་ཞིག་གང་གི་ཡིན།",
    "འདི་དག་གིས་ནི་གཞུང་འདིའི་དོན།",
    "དེ་ཡོངས་སུ་མཉེས་པར་བྱ་བའི་ཆོ་ག་གང་གིས་ཇི་ལྟར་མཉེས་ཤིང་བསྒྲུབ་པར་བྱ།",
    "དེ་ལྟར་རྣམ་པར་འཕྲུལ་པའི་དཀྱིལ་འཁོར་དེ་རྣམས་མཉེས་པར་བྱ་བའི་ཆོ་ག་གང་གིས་མཉེས་པར་བྱས་ཤིང་བསྒྲུབས་པས་རང་རང་གི་དོན་གྱི་ལས་ཀྱི་འབྲས་བུ་ཅི་དང་ཅི་ཞིག་གྲུབ་པར་འགྱུར།",
    "གཡོ་བ་དང་མི་གཡོ་བའི་དངོས་པོ་ཐམས་ཅད་ཀྱི་རང་བཞིན་དུ་གནས་པ་གང་ཡིན་པ་དེ་ནི་འདིའི་རང་གི་ངོ་བོ་ཉིད་དོ།",
    "མཁའ་འགྲོ་མ་བདེ་བ་མཆོག་གི་ཕྱི་དང་ནང་གི་དཀྱིལ་འཁོར་དག་ན་རྟག་ཏུ་བདེ་བ་ཆེན་པོ་ལ་ལོངས་སྤྱོད་པའི་མཚན་ཅན་གྱི་རྣམ་པར་བཞུགས་པའོ།",
    "གདུལ་བྱའི་སྐྱེ་བོ་རྣམས་ཀྱི་བག་ལ་ཉལ་བ་དང་བསམ་པའི་ཁམས་ཀྱི་བྱེ་བྲག་གི་འཕྲུལ་པ་རྣམས་ཀྱང་མཐའ་ཡས་པ་ཡིན་མོད་ཀྱི།",
    "དཔལ་རྟ་མཆོག་གི་དཀྱིལ་འཁོར་དུ་རྣམ་པར་འཕྲུལ་པའོ།",
