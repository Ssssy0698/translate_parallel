    "ཁྱད་པར་གྱི་ཡུལ་ཐ་དད་པ་ལ་རྟོགས་པའི་རྒྱུན་ཐག་གིས་རྣམ་པ་ཐ་དད་པ་དུ་མར་རྟོག་པ་ན་དར་གྱི་སྲིན་བུ་བཞིན་དུ་བདག་ཉིད་ཀྱི་མཐུ་ཉིད་ཀུན་ནས་དཀྲིས་པར་འགྱུར་རོ།",
    "འོན་ཀྱང་དེ་དག་གི་རང་བཞིན་ནི་མྱ་ངན་ལས་འདས་པ་དང་མཚུངས་སོ་ཞེས་བྱ་བར་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "ཡང་ན་བཅོམ་ལྡན་འདས་ཀྱིས་ཉོན་མོངས་པའི་སྒྲིབ་པ་སྤང་བའི་ཕྱིར་ནང་དང་ཕྱི་རོལ་གྱི་སྐྱེ་མཆེད་བདག་དང་།",
    "བདག་གི་དང་བྲལ་བའི་མཚན་ཉིད་གཡོ་བ་མེད་པ་ཤེས་བྱར་བསྟན་པ་གང་དག་ཡིན་པ་དེ་དག་ཐམས་ཅད་ཡང་དག་ཅེས་གསུངས་སོ།",
    "རྣམ་པར་ཤེས་པའི་མཚན་ཉིད་ཀྱི་བདག་གིས་བདག་དང་བཅས་པའི་ཕྱིར་དང་།",
    "བདག་གི་ཡིན་པའི་ཕྱིར་བྱེད་པ་པོར་བརྗོད་པས་ཉན་པ་དང་།",
    "ཡང་ན་རང་དང་གཞན་གྱི་རྒྱུད་ལ་ཡོད་པའི་ཉོན་མོངས་པའི་བག་ཆགས་དང་བཅས་པའི་སྒྲ་ཐམས་ཅད་ཚར་གཅོད་པ་བསྟན་པའོ།",
    "ཐ་སྙད་དང་དོན་དམ་པའི་བདེན་པའི་ཚུལ་མཆོག་ཏུ་རྨད་དུ་བྱུང་བ་ཐོགས་པ་མེད་པར་སྨྲ་བ་གཞན་དག་དང་ཐུན་མོང་མ་ཡིན་པ་སྟེ།",
    "ཅི་སྟེ་མི་སྟོན་ན་ནི་རང་གི་ཕྱོགས་ངེས་པར་མི་འཇོག་ལ།",
    "ལུང་མེད་པར་བདག་གི་མངོན་སུམ་དུ་འགྱུར་ཞིང་བདག་ཉིད་ཀྱིས་རང་རིག་པར་བྱ་བ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "དེ་ལ་གང་གི་ཕྱིར་རྣམ་པར་རྟོག་པ་མེད་པ་དེའི་ཕྱིར་སྤྲོས་པ་རྣམས་ཀྱིས་མ་སྤྲོས་པའོ།",
    "གང་གི་ཕྱིར་སྤྲོས་པ་རྣམས་ཀྱིས་མ་སྤྲོས་པ་དེའི་ཕྱིར་ཞི་བའོ།",
    "གང་གི་ཕྱིར་ཞི་བ་དེའི་ཕྱིར་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་ལོ།",
    "གང་གི་ཕྱིར་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་ཡིན་པ་དེའི་ཕྱིར།",
    "དེའི་ཕྱིར་དེ་ཁོ་ནའི་ངོ་བོ་ཉིད་ནི་ཚིག་གིས་སྒྲོ་བཏགས་པ་ལས་ཡང་དག་པར་འདས་པ་ཡིན་ནོ།",
    "དེ་ནི་བརྗོད་པར་མི་ནུས་མོད་ཀྱི།",
    "དེ་ལྟར་རེ་ཞིག་དོན་དམ་པའི་དེ་ཁོ་ན་བསྟན་པའོ།",
    "དེ་ནི་རེ་ཞིག་དེ་ཉིད་མིན།",
    "རྒྱུ་གང་ལ་བརྟེན་ཏེ་འབྲས་བུ་གང་བྱུང་བ་དེ་ནི་རེ་ཞིག་དེ་ཉིད་མ་ཡིན་ཏེ།",
    "ཡང་ན་རྒྱུ་གང་ལ་བརྟེན་ཏེ་འབྲས་བུ་གང་བྱུང་བ་དེ་ནི་རེ་ཞིག་དེ་ཉིད་མ་ཡིན་ཏེ།",
    "རྒྱུའི་བདག་ཉིད་ལས་མི་སྐྱེ་བར་ཐལ་བར་འགྱུར་བའི་ཕྱིར་རོ།",
    "རྒྱུའི་རང་གི་བདག་ཉིད་བཞིན་ནོ་ཞེས་རྗེས་སུ་དཔག་པའི་ཕྱིར་རོ།",
    "དེ་ལས་གཞན་པ་ལ་བརྟེན་ཏེ་བྱུང་བའི་འབྲས་བུ་དག་གིས་མ་ངེས་པ་ཉིད་ཀྱང་མ་ཡིན་ནོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་རྒྱུ་ལས་འབྲས་བུ་དེ་ཉིད་ཀྱང་མ་ཡིན་ལ།",
    "འདི་ལ་གང་གི་ཕྱིར་རྒྱུ་ཞིག་ཀྱང་འབྲས་བུ་སྐྱེ་བས་རྒྱུན་གྱིས་ངེས་པར་གནས་ཤིང་རྒྱུ་ཞིག་ཀྱང་འབྲས་བུ་དེ་མི་འཇིག་པ་དེའི་ཕྱིར་གཞན་ཉིད་མ་ཡིན་པས་ཆད་པ་མ་ཡིན་ལ།",
    "གང་གི་ཕྱིར་འབྲས་བུའི་དུས་ན་རྒྱུ་འཇིག་ཅིང་རྒྱུ་དེ་ཞིག་ཀྱང་འབྲས་བུ་ནམ་ཡང་མི་འཇིག་པ་དེའི་ཕྱིར་དེ་ཉིད་མ་ཡིན་པས་རྟག་པ་ཡང་མ་ཡིན་ཏེ།",
    "དེ་ཁོ་ན་ཤེས་པ་སྐྱེ་བའི་རྐྱེན་དང་མི་ལྡན་དུ་ཟིན་ཀྱང་དེ་ལྟ་མོད་ཀྱི།",
    "བདག་གིས་སྟོང་པ་ཉིད་དུ་བསྟན་པ་ཡིན་ནོ།",
    "དེ་བཞིན་དུ་སྲིང་མོ་གཞན་ཡང་།",
    "ཁྱོད་ཀྱི་ལུས་འདི་ལ་བདག་མེད།",
    "ཐ་སྙད་ཀྱི་ཁོངས་སུ་གཏོགས་པའི་འདུ་བྱེད་། དེ་དག་གི་སྐྱེ་བ་གང་ཡིན་པ་དེ་བྱ་བ་ཞེས་བྱ་སྟེ།",
    "གལ་ཏེ་ནམ་མཁའ་ལ་སོགས་པ་དག་གིས་མ་ངེས་པ་ཉིད་ཡིན་ནོ་ཞེ་ན།",
    "ད་ལྟར་གྱི་གཟུགས་སོ་སྙམ་པའི་བློ་ནི་རང་གི་བདག་ཉིད་ལས་གཞན་པའི་དངོས་པོ་དང་འབྲེལ་བའི་ཚིག་གི་དོན་གྱི་ཡུལ་ཅན་ཡིན་ཏེ།",
    "ཡིད་ཆེས་པ་སྐྱེ་བའི་ཕྱིར་དཔེར་ན་དབྱུག་པ་ཅན་མང་པོ་དང་ཉུང་ངུ་དག་ལ་དབྱུག་པ་ཅན་དབྱུག་པ་ཅན་སྙམ་དུ་ཡིད་ཆེས་པ་སྐྱེ་བའི་བློ་དེ་ལ་ལྷས་བྱིན་ལ་སོགས་པའི་རང་གི་བདག་ཉིད་ལས་གཞན་པའི་དངོས་པོ་དབྱུག་པ་དང་འབྲེལ་བའི་ཚིག་གི་དོན་གྱི་ཡུལ་ཡོད་པར་མཐོང་བ་བཞིན་ནོ།",
    "དེའི་ཕྱིར་ད་ལྟར་གྱི་གཟུགས་སོ་སྙམ་པའི་བློ་འདི་ལ་ཡང་རང་གི་བདག་ཉིད་ལས་གཞན་པའི་དངོས་པོ་དང་འབྲེལ་བའི་ཚིག་གི་དོན་གྱི་ཡུལ་ཡོད་དེ།",
    "གཟུགས་ལས་གཞན་པའི་ཚིག་གི་དོན་གང་ཡིན་པ་དེ་ནི་དུས་ཡིན་པས་དེའི་ཕྱིར་དེ་ནི་གཞན་ཡིན་ནོ།",
    "དེ་ལ་འདིར་ཡིད་ཆེས་པ་སྐྱེ་བའི་ཕྱིར་ཞེས་བྱ་བའི་གཏན་ཚིགས་ཀྱིས་རང་གི་བདག་ཉིད་ལས་གཞན་པའི་དངོས་པོ་དང་འབྲེལ་བའི་ཚིག་གི་དོན་ལ་དུས་མ་ཡིན་པ་དང་།",
    "ཡང་ན་གལ་ཏེ་ད་ལྟར་གྱི་གཟུགས་སོ་སྙམ་པའི་བློ་དེ་ཁྱད་པར་གཞན་གང་ཡང་རུང་འགའ་ཞིག་དང་འབྲེལ་བའི་ཚིག་གི་དོན་གྱི་ཡུལ་ཅན་ཡིན་པར་སྒྲུབ་ན་ནི་གྲུབ་པ་ལ་སྒྲུབ་པ་དང་།",
    "རང་གི་གྲུབ་པའི་མཐའ་དང་འགལ་བར་འགྱུར་རོ།",
    "ཅི་སྟེ་བློ་དེ་གཟུགས་དུས་ཀྱི་མཚན་ཉིད་ཀྱི་ཚིག་གི་དོན་དང་འབྲེལ་བའི་ཡུལ་ཅན་ཡིན་པར་བསྒྲུབས་ན་ནི་དཔེ་མེད་དེ།",
    "བློ་དེ་གཟུགས་དུས་ཀྱི་མཚན་ཉིད་ཀྱི་ཚིག་གི་དོན་དང་འབྲེལ་བའི་ཡུལ་ཅན་ཡིན་པར་བསྟན་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ནི་ལན་འགའ་ཞེས་བྱ་བའི་ཚིག་གི་ལྷག་མའོ།",
    "ཁ་ཅིག་ན་རེ།",
