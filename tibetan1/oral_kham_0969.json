    "དེའི་སྟེང་རང་རྒྱལ་གྱི་གཟུང་བ་རང་བཞིན་མེད་རྟོགས་ལ་མཉམ་རྗེས་གཉིས་སུ་ཕྱེ་བའི་རྗེས་ཐོབ་ཏུ་རྨི་ལམ་དང་སྒྱུ་མ་ལྟར་རྟོགས་པ་སོགས་དཔེ་ལྔས་བསྟན་པ་དང་།",
    "དེ་ཡང་མཁྱེན་པ་གསུམ་པོས་ཀྱང་རང་ཡུལ་དེ་དག་ཐམས་ཅད་སྐྱེ་མེད་མཉམ་པར་ཤེས་པ་ལ་འདྲ་ཞིང་ཁྱད་མེད་ཀྱང་།",
    "ཡང་གཞན་དོན་ཐེག༵་གསུམ༵་གྱིས༵་ངེས་པར་འབྱུང་ཡང་རང་དོན་དེའི་འབྲས༵་བུ༵་མངོན༵་སུ༵མ་མི༵་བྱེད༵་པ་དང་བ་ན་ཡིན་ལ།",
    "བཟོད་ཆུང་རང་བདེན་བཞི་ཤེས་སྤང་མངོན་བྱེད་བརྟེན་པ་ལ་གནས་ནས་གཞན་དེ་ལ་འགོད་བསྔགས་མ་ན་པར་བྱེད་པ་དང་།",
    "བསླབ་ཀྱང་རང་དོན་ཆགས་པ་མེད་པ་དང་།",
    "སྐད་ཅིག་ཙམ་ཡང་རང་དོན་ཡིད་བྱེད་བློ།",
    "ལྷག་མཐོང་རང་བྱུང་ཡེ་ཤེས་ཀྱིས།",
    "རང་བྱུང་རང་རིག་མངོན་སུམ་སྣང་ས་ནི།",
    "དེས་ན་ལམ་ཡང་རང་ཉིད་མ་དག་པས་གཞན་དག་པར་བྱེད་མི་ནུས་སོ།",
    "རང་བཞིན་འོད་གསལ་ཁོ་རང་ས་བཞི་མཉམ་རྫོགས་བསམ་མི་ཁྱབ་པའི་རང་བཞིན་ལས་མི་གཡོ་ཡང་།",
    "རགས་ལུས་འདི་སྒྲུབ་གཞིར་བྱས་ཏེ་ཡེ་ཤེས་སྒྱུ་མའི་ལུས་ཅན་འོད་འགྲུབ་ཅེས་འདོད་འ་ག་སྙམ་པ་འདི་ཁོ་ནའི་སྐྱོན་གདའ་སྟེ།",
    "སྔགས་རང་ལམ་གྱི་སྒྱུ་འོད་གཉིས་པོ་མངོན་མཛད་ཀྱང་ཞི་གནས་ཙམ་ལས་ལྷག་མཐོང་རང་བབས་ཀྱིས་མེད་པར་ཁས་བླང་སྟེ།",
    "ངོ་བོ་ཉིད་སྟོང་རང་བཞིན་འོད་གསལ་བ།",
    "ཚོགས་བརྒྱད་འགགས་ཀྱང་རང་བྱུང་འོད་གསལ་བའི་ཡེ་ཤེས་མི་འགགས་ཏེ།",
    "གཞན་ཡང་རང་རྒྱུད་ཀྱི་བློ་རང་ལ་མངོན་མི་འགྱུར་བ་ཞིག་ཡོད་ན་རང་རྒྱུད་ལ་ཡེ་ཤེས་ཡོད་ཀྱང་དེ་དང་ཅིས་མི་འདྲ།",
    "ཤར་ན་བདེན་གྲུབ་དང་རང་མཚན་མཐོང་སོགས་གནོད།",
    "དེ་ཁོ་རང་འོད་གསལ་གྱི་ངོ་བོ་ཉིད་མིན་པར་སླར་འོད་གསལ་འགྱུར་བྱེད་རྐྱེན་གཞན་དགོས་ན།",
    "དཔེ་དེས་དོན་སྤྱི་ཤེས་ནས་གཏན་ལ་འབེབས་ཀྱི་དཔེ་ཁོ་རང་མིན།",
    "རང་བཞིན་དང་རང་བཞིན་ཅན་ཐ་དད་ན་ཚ་བ་མེད་པའི་མེར་འགྱུར་རོ།",
    "རང་བཞིན་དེ་དང་རང་བཞིན་ཅན་སེམས་གཉིས་ལྡོག་པ་ཙམ་ལས་ངོ་བོ་ཐ་དད་མེད་དགོས་ཀྱི།",
    "འཕོ་སྒྲིབ་བྱུང་བའི་འ་ས་བྱས་སེམས་ཁོ་རང་ཡོད་ལ།",
    "དམིགས་སུ་མེད་ཀྱང་རང་འོད་གསལ་བ་ཡིན་ཏེ།",
    "འཁྲུལ་སྣང་རང་ཡལ་ལ་བཏང་ནས།",
    "བྱིན་གྱིས་རློབ་སྐབས་སུ་འདུག་གོ།",
    "འདྲེན་མཆོག་ཁྱེད་རང་ལྟ་བུར་ཤོག་ཅིག།",
    "པཎ་ཆེན་ཁྱེད་རང་ལྟ་བུར་ཤོག་ཅིག།",
    "རྟོགས་ལྡན་ཁྱེད་རང་ལྟ་བུར་ཤོག་ཅིག།",
    "གྲུབ་ཐོབ་ཁྱེད་རང་ལྟ་བུར་ཤོག་ཅིག།",
    "འགྲོ་མགོན་ཁྱེད་རང་ལྟ་བུར་ཤོག་ཅིག།",
    "གང་ཞིག་དུས་སུ་འབྱིན་བྱེད་པ།",
    "འདོད་པ་སྨོས་པས་གདུངས་པར་འདུག།",
    "ལྷ་ཡི་གདན་ལ་འདུག་པ་དང་།",
    "ཞལ་ཏ་པ་བཙུན་པ་ཤེས་རབ་སྒྲོན་མེས་རྒྱལ་ཁབ་ཆེན་པོར་སྡོམ་པ་ལེན་དུ་ཕྱིན་པ་ཕྱིར་ལོག་ཙ་ན།",
    "སྐབས་ཤིག་དེའི་སྔར་གྱི་ཚིག་དོན་ལ་རྟོག་ཅིང་འདུག་པ་དང་།",
    "རང་སེམས་སྟོང་པར་ཤེས་པར་བྱས་ཏེ་ཀུན་རྟོག་སྤོངས་ཤིག་བྱས་པ་ཡིན་འདུག་དེས་ན་ཁོ་བོའི་ལུས་ཀྱང་རྩྭ་མིང་ཏིང་ཡིན་ལ།"
  ]
}