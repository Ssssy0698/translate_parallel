    "འདྲེ་གནོད་སྦྱིན་ཕོ་མོའི་ཆོ་འཕྲུལ་བྱུང་།",
    "ཁྱོད་ལེགས་པར་ཉོན་དང་མི་མ་ཡིན།",
    "མི་ང་ངོ་ཁྱོད་ཀྱི་མ་ཤེས་ན།",
    "རང་རང་གནས་སུ་དེངས་ནས་སོང་བ་ལ།",
    "ཡང་རྗེ་བཙུན་གྱིས་གཟིགས་པ་རྟོགས་ཚད་ལྟ་བའི་མགུར་འདི་གསུངས་སོ།",
    "ཁྱོད་ད་རུང་ཉོན་དང་མི་མ་ཡིན།",
    "ཉོན་མོངས་ཀྱི་འཚེ་བས་གཞན་ལ་སྡང་།",
    "ཁྱོད་རང་གི་ཁྱོད་རང་མནར་སྡང་བྱེད།",
    "ཡི་རེ་མུག་ལས་ངན་གྱིས་ནུས་པ་ལས།",
    "ཁྱོད་སྔོན་ཡང་ལས་ངན་བསགས་བསགས་ནས།",
    "རིགས་དྲུག་གི་ནང་ན་ཡི་དྭགས་ལུས།",
    "དོག་རེ་མེད་བདེ་བ་མྱུར་དུ་འཐོབ།",
    "ཞེས་གསུངས་མི་མ་ཡིན་དེ་རྣམས་ན་རེ།",
    "ཁྱོད་ལས་ཉོན་སྒྲིབ་གཡོགས་འཐུག་པོ་ཡིས།",
    "རྗེ་བྱམས་པའི་གསུང་ལ་ཁྱོད་ཀྱང་ཉོན།",
    "ཕྱི་འཁྲུལ་སྣང་གི་བགེགས་ལ་ཕར་བལྟས་པས།",
    "ཕྱི་འཁྲུལ་སྣང་གི་བགེགས་ལ་ང་མི་འཇིགས།",
    "འཁྲུལ་སྣང་གི་དྲན་པ་དབྱིངས་སུ་ཡལ།",
    "ངེད་རྣམས་ཀྱི་འཚོ་བའི་བཤོས་གཙང་རེ་འདྲེན་ཟེར་ནས།",
    "སོང་བ་དང་ནམ་ལངས་ནས་བྱུང་ངོ།",
    "བྲག་ཁ་ཞིག་ཏུ་དུམ་པ་ཞིག་གཟིགས་ནས་བཞུགས་ཙ་ན།",
    "མདང་གི་དེ་རྣམས་ངོ་ཤེས་ལྷག་གི་ཚན་པ་སུམ་ཅུ་རྩ་གཅིག་བྱས་ནས།",
    "ནུ་རུ་རུ་དེང་ནས་སོང་སྙམ་བྱེད་པ་ལ།",
    "རྗེ་བཙུན་ཡང་ཁམས་དྭངས་སེངས་ཀྱི་སོང་ནས་ཟླ་བ་གཅིག་གཉིས་ལ།",
    "དེ་ཐམས་ཅད་ལ་ཕྱི་ཆུ་བཟང་གི་སྐོར་རོ།",
    "སྙེ་ནམ་དུ་བསོད་སྙོམས་ལ་བྱོན་པས་ཡོན་བདག་གཤིན་རྡོར་མོ་དང་།",
    "སྟོན་པ་ཤཱཀ་གུ་ལ་སོགས་པ་རྣམས་དང་སྟོན་མོ་བྱེད་པ་ཞིག་ཏུ་མཇལ་བས།",
    "བདག་གཞན་འཛིན་པ་བརྗེད་དེ་ཐལ།",
    "འདུན་མ་བརྗེད་དེ་ཐལ།",
    "ཐ་མལ་གྱི་རྟོག་པ་བརྗེད་དེ་ཐལ།",
    "མ་རིག་གི་འཁྲུལ་པ་བརྗེད་དེ་ཐལ།",
    "སྐྱེ་འཆིའི་འཇིགས་པ་བརྗེད་ནས་ཐལ།",
    "ཁས་ལེན་གྱིས་ལྟ་བ་བརྗེད་ནས་ཐལ།",
    "མི་ཆེན་གྱི་རེ་བ་བརྗེད་ནས་ཐལ།",
    "ཡོན་བདག་རྣམས་ན་རེ།",
    "ངན་ཤགས་འཐབ་མོ་བྱེད་པ་ཤིན་ཏུ་གླེན།",
    "དེར་འཚོགས་པའི་ཡོན་བདག་ཕོ་མོ་རྣམས་ན་རེ།",
    "འགྲོག་ཡུན་རིང་ནས་རེ་འཁང་མང་།",
    "གཤིས་ངན་འཐབ་མོས་དམ་ཚིག་དཀྲུགས།",
    "གྲོང་ཡུལ་དུ་ལུས་པ་གྱོང་རེ་ཆེ།",
    "ཡོན་བདག་གཤིན་རྡོར་མོ་བཟའ་ཚོ་དང་།",
    "མར་ཤག་གཅིག་རྣམས་ཕུལ་ནས་རྗེ་བཙུན་ལ་ཕྱིའི་གངས་ལ་བྱོན་ནས་སོང་སོ།",
    "དེ་ཐམས་ཅད་གཤིན་རྡོར་མོའི་སྐོར་རོ། དེ་ནས་བཞི་པ་ཟས་གོས་ཀྱི་འདུན་པ་བྲལ་བའི་ཡོན་ཏན་ནི།",
    "ཡོན་བདག་གཤིན་རྡོར་མོ་ལ་སོགས་པའི་བན་སྐྱ་དྲུག་གི་བསྐྱལ་ནས།",
    "ཟླ་བ་དྲུག་གི་བར་དུ་སྙེ་ནམ་དང་ལ་ཕྱིའི་བར་འགྲུལ་ཆད་པས།",
    "དེ་ནས་ཕྱིས་དབྱུག་གུའི་ཟླ་བར་སོང་བ་ལ་ཁོང་རྣམས་གྲོས་བྱས་ནས་རྗེ་བཙུན་གདུང་ཨེ་རྙེད་བལྟ་བ་ལ།",
    "ཕ་བོང་ཞིག་གི་སྟེང་དུ་གསའ་ཆེན་པོ་ཞིག་བྱུང་བས།",
    "གསའ་རྗེས་ཡང་མི་རྗེས་སུ་སོང་འདུག་པས།",
    "མི་མ་ཡིན་གྱི་ཆོ་འཕྲུལ་རེད་བྱས་ནས་ཕྱིར་ལྡོག་རྩིས་བྱས་ཙ་ན།",
    "རྗེ་བཙུན་ནི་དབེན་གནས་དུག་གདུགས་ཕུག་མོ་ཆེ་བྱ་བ་ན་དབྱངས་ལྷང་ལྷང་གྲག་པ།",
    "ཁོང་རྣམས་དགའ་དྲགས་པས་མགྱོགས་པར་སོང་ཙ་ན།",
    "དེ་གོང་གི་རྩམ་པ་ལ་ཟན་བདུན་བྱས།",
    "ཁོང་ཚོ་ལ་དེའི་དུས་སུ་སྦྲུལ་གཉིས་རྐེད་པ་ལ་འཁྱུད་པ་དང་།",
    "སྦལ་པ་ར་ཙམ་ཅིག་ཕོ་འཁྱུད་དུ་བསྡམས་པ་ལ་སོགས་པ་མང་པོ་བྱུང་བས་དང་པོ་རེ་སྐྲག་སྟེ།",
    "ཉམས་སུ་ཤེས་པས་བདེ་ཕྱམ་ཕྱམ་སོང་སྐད་དོ།",
    "དམ་ཚིག་གི་བདུན་ཚིགས་ཕན་པ་ཆེ།",
    "བལྟ་བྱ་དང་བལྟ་བྱེད་ཀྱང་སྟོར་ནས་སོང་།",
    "སྒོམ་བྱ་སྒོམ་བྱེད་སྟོར་ནས་སོང་།",
    "སྤྱོད་བྱ་སྤྱོད་བྱེད་ཡང་སྟོང་ནས་སོང་།",
    "དམ་ཚིག་གི་ཁོང་གཟེར་ཡང་དམ་ནས་བྱུང་།",
    "བསྲུང་བྱ་དང་སྲུང་བྱེད་སྟོར་ནས་སོང་།",
    "བསྒྲུབ་བྱ་དང་སྒྲུབ་བྱེད་ཀྱང་སྟོར་ནས་སོང་།",
    "རྫ་བྲག་གི་འབབ་ཆུ་བཏུང་བའི་མཚོ།",
    "སྔར་བས་སྐུ་མདངས་ཆེར་སོང་ཟིན་པས།",
    "ཕལ་ཆེར་ཏིང་ངེ་འཛིན་རང་ལ་སོང་།",
    "རེས་འགའ་ཕྱེ་ཐུར་འགོ་རེ་ཡང་འགམ།",
    "རེས་འགའ་རྒྱ་གར་ནས་མཁའ་འགྲོ་མའི་ཚོགས་དུམ་པ་རེ་ཡང་བསྐྱལ།",
    "ཁྱེད་རང་ཚོ་སོང་གསུངས་པ་ལ།",
    "ལྷ་འདྲེ་རྣམས་སྔ་མོ་ནས་མོས་ནས་དད།",
    "ཁོང་དེར་ཚོགས་པ་རྣམས་ནས་དད་པའི་གདབ་ལན་ཁ་བའི་བབ་ཚུལ་དུ་གངས་མགུར་རིང་མོ་བྱ་བ་འདི་གསུངས་སོ།",
    "ཡང་སྟག་གི་ལོ་ཡི་ལོ་འཇུག་དང་།",
    "དགུ་ཚིགས་སྐྱ་མོ་གཏོད་ལ་མནན།",
    "མཐོ་གངས་དཀར་རྩེ་མོ་དགུང་དང་མཉམ།",
    "གཙང་ཆབ་སྔོན་མོ་སྦུབ་སུ་རུབ།",
    "ལོ་གསར་སྒང་གི་ལྷགས་པ་དང་གཉིས།",
    "གྱད་དཔེ་བཞག་གི་ཤི་སྲོག་དེ་རུ་བསྣོལ།",
    "སྒོས་གཏུམ་མོ་རས་ཀྱི་ཆེ་བ་བཏོན།",
    "ཕྱིས་ཅི་ཟེར་ཉན་པར་ཁ་ཡིས་བླངས།",
    "དུས་ད་རེས་ཀྱིས་འཁྲུག་པ་རྣལ་འབྱོར་རྒྱལ།",
    "ཤོ་ལར་ཡང་བྲེ་མོ་བགྱིས་པ་ལགས།",
    "གྲུབ་ཐོབ་འགའ་རེ་ཡང་བྱོན་ཏེ་མཆི།",
    "ཡོན་བདག་གཤིན་རྡོར་མོས་འགོ་བྱས་པ་རྣམས་ཀྱིས།",
    "ལ་ཆང་དང་སྟོན་མོ་ཚོགས་མང་དུ་བྱས་པའི་ཚོགས་གྲལ་དུ་རྗེ་བཙུན་ལགས།",
    "ཡོན་བདག་རྡོར་མོ་བཟའ་ཚོ་དང་།",
    "ནང་གི་སྐྱོན་དྲུག་གཏན་ལ་འབེབ།",
    "གཏི་མུག་ཆེ་ན་བྱོལ་སོང་སྒྲོགས།",
    "ཡང་ལུས་ལ་གཏུམ་མོ་འབར་བ་བདེ།",
    "ལར་མི་དགའ་བ་རྣམས་ཚོགས་པ་ད་རེས་ཙམ།",
    "ལམ་ལོག་པར་མ་སོང་ང་དང་འཕྲད།",
    "གྲོང་ཡུལ་དུ་ལྟད་མོ་མ་དྲན་ཞིག།",
    "ཟབ་མོའི་སྒོམ་ཁྲིད་ཞུ་དུས་སུ།",
    "འདོད་ན་ཆགས་སྡང་གི་དམ་ཚིག་འཁྲུག།",
    "ཟོལ་ཟོག་གི་མི་མགོ་མ་བསྐོར་ཅིག།",
    "གནས་གང་དུ་སོང་ཡང་ཤིན་ཏུ་སྐྱིད།",
    "རི་ཁྲོད་དུ་བསྒོམ་དུ་འགྲོ་བ་ལ་རྒྱགས་ཆུ་ན་རེ་མེད་པས་སྙེ་ནམ་ཚོང་འདུས་ན་ཚོང་པ་མང་པོ་ཡོད་པས་བསོད་སྙོམས་བྱས་ནས་གང་གསུངས་པའི་གནས་ལ་འགྲོ་ཞུས་པས།",
    "མགོ་མང་པོ་བརྩིགས་པའི་རྩར་ཡུངས་མ་སྤུངས་སྤུངས་བྱས་ནས་འདུག་པ་རྣམས་རྗེ་བཙུན་གྱིས་གཟིགས་པས།",
    "ལས་རེ་རྨོངས་མི་ཡིས་ལོད་པ་ལ།",
    "གྱོང་རེ་ཆེ་རང་ནོར་གྱི་མགོ་བོ་ལ།",
    "ཅུག་རེ་བྱེད་ཤ་ཡི་བརྩེགས་ལུགས་ལ།",
    "ཅི་རེ་བྱེད་ཁྲག་གི་མང་ལུགས་ལ།",
    "ཅི་རེ་བྱུང་ཞེ་སྡང་གི་སོ་ནམ་ལ།",
    "གང་གིས་དྲན་ཡུལ་ལུགས་ཀྱི་ངན་པ་ལས།",
    "ཅུག་རེ་བྱེད་སྐྱེ་བོ་འཕོང་པ་ལ།",
    "གང་དུ་འགྲོ་ཡི་མུག་གི་ཆེ་ལུགས་ལ།",
    "ཅུག་སོང་ཕ་ཀི་ཚོའི་བྲེལ་བ་ལ།",
    "རྣམ་རྟོགས་གི་རྐུན་མ་མང་ལ་རྒོད།",
    "ཡེངས་མེད་ཀྱི་མེལ་ཚེ་བྱེད་རེ་རན།",
    "ཡེ་ཤེས་ཀྱི་སྐྱེལ་མ་ཞིག་བཙལ་རེ་རཾན།",
    "སྐྱོན་ཀྱི་རི་བོ་སྤང་རེ་མཐོ།",
    "ཉོན་མོངས་ཀྱི་རྔོན་པ་ཁྱི་རེ་བཟང་།",
    "ཡང་དག་གི་མཐའ་ལ་འབྲོས་རེ་རན།",
    "ད་འཆི་བྲོས་ཀྱི་ཐིགས་ཚགས་བྱེད་རེ་རན།",
    "རིག་པའི་ཉ་ཆུང་རྐྱལ་རེ་ཞན།",
    "གཡོ་འཁྲུག་གི་རྦབ་ལ་གཡེང་ལས་ཆེ།",
    "ད་གཉིས་མེད་ཀྱི་ཀློང་དུ་འབྲོས་རེ་རན།",
    "ཁྱིམ་ཐབ་དུག་གི་འདམ་རྫབ་རྒྱས།",
    "རིགས་དྲུག་གི་གཡང་ལ་ལྷུང་ལས་ཆེ།",
    "ལྷོ་མོན་གྱི་རི་ཁྲོད་ཅིག་ལ་དཔོན་སློབ་གཉིས་བྱོན་ནོ།",
    "གང་སྣང་རྟོགས་པར་འཁྱེར་མ་ཤེས་ན་རེ་མེད་གསུངས་པས།",
    "ཟས་བཟང་པོ་ཟ་འདོད་སྡིག་སྤྱོད་རེམ།",
    "སེམས་གསོག་འཇོག་གི་སྣང་བ་ཞིག་ད་རུང་འདུག།",
    "ཁྱོད་རི་ཁྲོད་ཀྱི་གནས་ན།",
    "ཅུག་དྲག་དང་གང་དྲག་གི་སེམས་བརྩེ་བ་ལ།",
    "རང་ཕུང་གི་རྐུན་མ་ཞིག་ཡོང་བ་ལ་ཚེགས་མེད།",
    "ཤ་ཆང་གི་ཞིམ་ལྟོ་མ་དྲན་ཅིག།",
    "མོན་གྱི་ཤིང་རིར་སྡོད་དུས་སུ།",
    "གཞན་གྱི་ཁྱེར་ན་ཉོན་མོངས་སྐྱེ།",
    "དེ་རྣམས་ཐམས་ཅད་མོན་གྱི་ཤིང་རིའི་སྐོར་རོ།",
    "ཡོན་བདག་གཤེན་རྡོར་མོས་འགོ་བྱས་པའི་སྙེ་ནམ་གྱི་མི་བརྒྱད་ཀྱིས་རྒྱགས་དུམ་པ་རེ་ཁུར་ནས་མ་རྙེད་ནས་ཚོལ་བས་རྙེད་ཙམ་ཞིག་བྱུང་བས།",
    "མོན་གྱི་ཤིང་རི་བདེ་བའི་མཁར།",
    "སྤྲ་སྤྲེའུ་རྩེད་མོ་རྩེ་བའི་ས།",
    "ཉོན་མོངས་ཤི་འཆིའི་ཤི་འབྲས་བདེ།",
    "མཆོང་རྒྱུགས་གི་གར་སྟབས་ཤིན་ཏུ་བདེ།",
    "སེམས་ངར་དྲང་གི་སྤྲོས་པ་དབྱིངས་སུ་བདེ།"
  ]
