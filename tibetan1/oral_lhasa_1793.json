    "གསུམ་པ་དྲང་སྲོང་སྔོན་འཇུག་འབྱུང་ཤེས་པར་སྤངས་ཐོབ་པ།",
    "དགེ་སྡིག་མཐོང་འབྱེད་རིམ་པར་གསལ།",
    "རྣམ་བཞི་བྲི་གང་མེད་པར་དེར་འབྱུང་དེ་ཉིད་དོན།",
    "ངེས་ཤེས་དགེ་ལ་མཐུན་པར་བསྐུལ།",
    "དཀའ་ཐུབ་དྲག་པོས་སོ་རུ་ཚུད་པར་བྱེད།",
    "སྡུག་བསྔལ་མཚན་ཉིད་ཉམས་སུ་མྱོང་པར་བྱེད།",
    "བསམ་གཏན་འདུས་བྱས་འདུས་མ་བྱས་པ་བྲམ་ཟེའི་གཅུད།",
    "གནང་བ་ལྷུགས་པ་མ་ཡིན་གནས་སྐབས་ཤེས་ལ་སྤྱོད།",
    "བཀག་པ་བཅིང་པར་རྟག་ཏུ་སྡོམ་པར་བྱ།",
    "གནང་བཀག་སྦྱོར་བ་ཤེས་གོམས་དྲང་སྲོང་བྱེད།",
    "ཕག་པ་རྩང་གཙོག་མེད་པ་རང་ས་བསྡད།",
    "རོ་དོང་དུ་བྲུབ་པར་བྱའོ།",
    "གནང་བཀག་བྱེ་བྲག་མི་ཕྱེད་ཀུན་ན་དམ།",
    "གཡེམ་པ་བྱེ་བྲག་གནང་སྐབས་ཞུ་གནང་ཐོབ་སྲུང་བྱེད།",
    "རྟེན་གསུམ་དོན་དམ་འགྲོ་དོན་ཆགས་མེད་གནང་།",
    "སླར་ལ་སྒོ་གསུམ་ཐ་རམས་དམ་པར་གཞུགས།",
    "གཏན་དུ་ཐར་དཀའ་བསྐལ་པ་ཡུན་རིང་གྲངས་སུ་མང་པར་བྱེད།",
    "ཤེས་རབ་ཀྱིས་ནི་ཀུན་མཁྱེན་རིག་པ་ཚ་བ་དང་།",
    "ཐབས་ལམ་སྣ་ཚོགས་གཉེན་པོར་ཞེན་པར་ཆགས།",
    "གནང་བཀག་མ་ཤེས་རྨོངས་པས་འཁྲུལ།",
    "རིག་པ་ངར་ཅན་ཡུལ་གཅོད་འཁྲུལ་པར་མ་རིག་རྣོ།",
    "རང་ངར་ཆེན་པོ་འཇིག་རྟེན་ཆོད་པར་འཁྲུལ་བ་མ་རིག་རྣོ།",
    "གསལ་སྟོང་ངར་ཅན་དུ་འབར་བ་འཁྲུལ་པར་མ་རིག་རྣོ།",
    "མྱོང་བྱེད་ཉམས་རྟོགས་འཆག་པར་རྟུལ་ལ་སྤོབས།",
    "མཚམས་སྦྱོར་ཐུན་འགྱེད་གཏང་རག་འཁྲུལ་པར་མ་རིག་རྣོ།",
    "བསམ་པའི་ཁྱད་པར་ལོག་རྟོག་ལ་བརྟེན་ནས།",
    "དེ་ཉིད་སད་པར་མ་ནུས་པའི་མ་རིག་པ་བཞི།",
    "ཐབས་ཆེན་ཤེས་རབ་གནང་བཀག་འཆང་།",
    "གནང་བཀག་གནང་མེད་ལུས་ངག་གྲིམ་པར་བསྲུང་།",
    "སྲུང་སྡོམ་བྱ་བ་བྱེད་པ་དག་པར་སྡོམ།",
    "བསགས་པར་བསྐུལ།",
    "སྐྱེ་བ་ཕྱི་མའི་དོན་ཁྱད་པར་ལ་བསྐུལ།",
    "རྒྱུད་ལ་མ་ཕན་དྲང་སྲོང་ཕན་པར་བསྐུལ།",
    "ཡང་དང་ཡང་དུ་ལུས་ངག་ཡིད་ཀྱི་བཅས་པར་སྡོམ།",
    "དུས་གསུམ་འདུལ་སྐལ་གཉེར་བཞེས་པས།",
    "རྟག་བཀྲག་འཆར་རྟག་པར་སྟོན།",
    "ང་བོ་རྣམས་བྲལ་མེད་པར་མཁས་པ་གཞན་སྨོད་དུ་ལོག།",
    "བདེན་པར་མི་བསམ་ལོག་འགྱུར་བལྟ།",
    "རྣམ་པར་མི་དབེན་ཆགས་ཞེན་སྲེད་པ་དར།",
    "རྒྱུ་འབྲས་རྨོངས་པས་ལྔ་རགས་པར་ཤོར།",
    "སྐུ་འབུམ་འབྲི་གསུང་འབུམ་བཀླག་ཚ་ཚ་འབུམ་གཏེར་བྱས།",
    "རྒྱུ་འབྲས་རྨོངས་པ་ལྔ་བསྙེག་པར་བྱེད།",
    "དགེ་གེགས་ཟླ་གྲོགས་རྟེན་འཚང་དྲིན་བཟད་འཁུས་པར་ལྔ་སྟེ།",
    "ཐིགས་པ་བསགས་པར་རྒྱ་མཚོ་གང་བར་བསྙེག།",
    "ར་ལུག་བྱ་གཡག་བརྩོན་པ་དྲིན་ལན་བསད་པས་ལན་ཆགས་བུ་བྱེར་ལོག་པར་ཤ་ཟ་པགས་གོས།",
    "འདུ་ཁང་རྒྱས་པ་བཞེངས་ནས་ཆབ་ཚངས་རབ་གནས་བྱས་ནས་འདག།",
    "གཉིས་པ་ལོག་པར་འཁྲུལ་བསལ་སྤྱོད་པ་ལྕི་བ་བཀུར་བ་དཀའ།",
    "མཁྱེན་དང་སྒོམ་ཆེན་གོང་མའི་ཕྱག་ལྕི།",
    "ཐུག་ཕྲད་ལེན་དང་རྟེན་གསུམ་ལ་བསྐོར་བ་སྟོང་བྱས་ན་འདག།",
    "མཁས་པའི་གོང་མ་སྐུ་བཞུགས་ལྕི།",
    "འདག་པར་ཉི་ཁྲི་ཆུ་འབུམ་ལེའུ་ལྔ་བཅུ་བ་ན་བཤད།",
    "མཁས་པར་སྦྱངས་པའི་བློ་ཅན་ལ།",
    "བཞེངས་བྱས་ལ་ཀུན་རྫོགས་བྱས་འདག།",
    "ལྷ་གནས་ཆགས་པ་ཚེ་རིང་ལྷུང་པར་འཁྲུལ།",
    "མི་རྣམས་སྣང་འཛིན་སྐྱེ་ཤི་ལོག་པར་འཁྲུལ།",
    "ཡི་དྭགས་རྨོངས་པས་བཟའ་བཏུང་མེད་པར་འཁྲུལ།",
    "རྒྱུན་གྱི་བག་ཆགས་མང་པ་རིམ་པར་གསལ།",
    "འདུས་བྱས་གཞི་ས་མ་བརྟན་སྣང་བ་འཕོ་འགྱུར་ཆེ།",
    "གཉིས་པ་དགའ་སྐྱིད་བདེ་བ་ཐུག་ཕྲད་སྣང་ཐོབ་ལེན་པར་བྱེད།",
    "ཡོངས་སུ་གཟུང་ཕྱིར་སྒོ་གསུམ་རྣམ་པར་གཟུངས།",
    "བཞི་པ་འཇིག་རྟེན་འདུ་ཤེས་ཡོངས་པར་བཤིག་བྱེད་པ།",
    "སྣང་བ་དང་དུ་ལེན་པར་བརྩོན་འགྲུས་ཆེ།",
    "སྲིད་རྩེ་ལམ་དུ་མ་ཤེས་རྟོགས་པར་དཀའ་བ་མ་རིག་པ།",
    "སྟོང་པར་གསལ་བས་ལམ་ཞུགས་པས།",
    "ཁམས་གསུམ་དུ་འཁོར་གྱིན་རྒྱུ་དྲུག་ཏུ་འཁྱམས་པར་བྱེད།",
    "ཤ་ཁྲག་འདུ་བྱས་ལུས་ལ་རྟག་པར་བཟུང་།",
    "རང་སྨྲ་ངག་རྟག་ཏུ་མི་སྙན་པར་འགྱུར།",
    "ངག་མི་སྙན་པ་དང་སྔགས་ལ་ནུས་པ་མེད་པར་འགྱུར།",
    "བདེན་པའི་དོན་ལ་ལོག་པར་ལྟ་བ།",
    "འདུས་བྱས་བདེན་པར་ལྟ་བའོ།",
    "མ་གཟན་ལ་སྙིགས་རིང་ལ་ཕས་སྒོ་ང་གནང་།",
    "མ་གཟན་ལ་སྙོགས་པར་ཚུན་ཆད་བརྩི།",
    "མ་གཟན་ལ་སྙོགས་པར་ཕས་སྒོ་ང་མ་གནང་ནས།",
    "སྟོན་དཔྱིད་ཉིན་མཚན་མཉམ་བཞིན་པར།",
    "ཉིན་མཚན་ཆ་བགོས་ཚད་ཟིན་བྱས་ལ།",
    "དྲང་སྲོང་མ་བཀའ་གཙང་གཙུག་མན་ཆད་གཞུག་པར་བྱ།",
    "མཉམ་འདྲིས་གོམས་པར་བསླབ་པར་བྱ།",
    "རྟེན་གསུམ་ཚང་པའི་འདུ་ཁང་གསུམ་མམ་ལྔར་གནང་།",
    "དྲང་སྲོང་མར་བཞུགས་པར་བྱ་བར་བོན་པས།",
    "གཙང་གཙུག་མ་དང་དྲང་སྲོང་མའི།",
    "དྲང་སྲོང་བཅུ་གྲལ་མན་ཆད་བྱས་ན།",
    "ལྷུང་བར་དང་བཅས་པ་དྲང་སྲོང་མ་ཡང་གཙང་གཙུག་ལོག།",
    "ཉེས་བྱས་སུ་འགྱུར་བ་སྤོངས།",
    "གཅིག་གཙང་སྦྲའི་ལས་སུ་བྱ།",
    "གདེང་བ་བུམ་པ་དང་རབ་བྱུང་མི་འབྲལ་འགྲོགས་པར་བྱ།",
    "ཐམས་ཅད་འདུ་ལ་ཟླ་བའི་དུས་དྲུག་ལ་མ་ཆག་པར།",
