    "གཙང་ནས་མཁས་པ་དཔལ་ལྡན་སེང་གེ་དང་།",
    "རི་ཕུག་ཏུ་གདན་ཕབ་དཀའ་འབུམ་པོ་ཏི་སོ་གསུམ་བཞུགས།",
    "བུ་སྟོན་གྱི་ལྕགས་ཕོ་སྟག་ནས་ཉིས་བརྒྱ་དང་དོན་ལྔར་སླེབས་པ་ལགས་སོ། ། སུམ་སྟོང་བཞི་བརྒྱ་དང་ཉེར་བཞི་འདས་པའི་ཉེར་ལྔ་པ་ཆུ་ཕོ་འབྲུག་ལ་ཀུན་མཁྱེན་དོལ་བུ་ཤེས་རབ་རྒྱལ་མཚན་མངའ་རིས་དོལ་བུའི་བན་ཚང་དུ་བྱོན།",
    "དེ་ནས་སྐྱི་སྟོན་ས་སྐྱར་ཕེབས་ཏེ།",
    "ཁྱད་པར་གཞན་སྟོང་པ་ཞེས་ཕྱོགས་ཀུན་ཏུ་སྙན་པའི་བ་དན་གཡོས།",
    "ཁྲོ་ཕུ་སེམས་དཔའ་ཆེན་པོ་དང་བུ་སྟོན་སེང་གེ་འོད་ལས་བསྙེན་པར་རྫོགས།",
    "ལོ་གྱ་དགུ་ཐུབ་བཞུགས།",
    "ཀུན་མཁྱེན་དོལ་བུ་བས་ལོ་བདུན་ཅུ་བཞུགས།",
    "ཀུན་མཁྱེན་དོལ་པོ་ལས་ལོ་བཅུ་བཞིས་གཞོན།",
    "དབུས་གཙང་དུ་གྲྭ་སྐོར་མཛད་པའི་ཞར་ལ་ཇོ་ནང་དུ་ཀུན་མཁྱེན་ཆེན་པོའི་ཞབས་ཟུང་བསྟེན།",
    "བྱང་བདག་ཆེན་ཏ་དབེན་ནམ་མཁའ་བསྟན་པས་ཀུན་མཁྱེན་དང་དཔོན་སློབ་གཉིས་ངམ་རིངས་སུ་སྤྱན་དྲངས།",
    "ཕར་ཚད་ཀྱི་འཆད་ཉན་ཡང་དག་པར་མཛད།",
    "སླར་བསེ་མཁར་ཆུང་དུ་ཕེབས།",
    "དུས་འཁོར་སོགས་ཀྱི་འཆད་ཉན་གནང་བས།",
    "འདས་ལོ་ནས་སུམ་སྟོང་བཞི་བརྒྱ་དང་བདུན་ཅུ་རྩ་འདྲེན་གྱི་སྐབས་སུ་ཡིན་པར་སེམས་ལ།",
    "ཀུན་མཁྱེན་དོལ་བུ་དང་དགུང་མཉམ་ཡིན་ཞིང་མཁས་ཤིང་གྲུབ་པ་བརྙེས་པ་ཞིག་སྟེ།",
    "ལམ་འབྲས་ཀྱང་ས་ལུགས་དང་ཞྭ་ལུགས་གཉིས་ཆར་བཞུགས།",
    "དེས་ས་བཟང་མ་ཏི་པཎ་ཆེན་ལ་གནང་།",
    "དེས་འཇམ་དབྱངས་ནམ་མཁའ་རྒྱལ་མཚན་ལ་གནང་།",
    "དེའི་དབོན་པོ་ཀུན་སྤངས་གྲགས་པ་རྒྱལ་མཚན་རྣམས་ལ་བཀའི་གནང་བ་ཞུས་ཤིང་།",
    "དེས་ན་ཀུན་མཁྱེན་དོལ་བུ་དང་།",
    "ཚོར་བ་སྡུག་བསྔལ་སྲིད་པ་འགལ་བས་ལན་ཐོབ་གསུངས་པ་ལ།",
    "ཐོགས་མེད་བཟང་པོ་དཔལ་ཞེས་སྙན་པར་བསྔགས།",
    "ས་སྐྱ་སོགས་སུ་བཞུགས་པའི་སྤྱན་སྔར་འཁོད་དེ་བསླབ་སྦྱངས་མཛད།",
    "རྩིས་པས་མ་ཚང་བ་མེད་པར་རྩིས་འགྲིག་འཕྲལ་ཕུགས་ཀྱི་མཛད་པ་ལ་དགེས་པ་ཐོབ་སྟེ།",
    "དགུང་ལོ་བརྒྱད་ཅུ་རྩ་གཅིག་བཞུགས།",
    "སློབ་དཔོན་དཔལ་ལྡན་སེང་གེ་ལས་བསྙེན་པར་རྫོགས།",
    "ཉི་ཤུ་པ་ལ་བྱ་གཤོངས་རྙིང་པར་བསྙེན་པར་རྫོགས།",
    "འཆད་རྩོད་རྩོམ་གསུམ་གྱི་སྒོ་ནས་བསྟན་པའི་རིང་ལུགས་ལེགས་པར་བཟུང་།",
    "འདི་ཉིད་ཀྱི་བཀའ་འབུམ་ལ་ཡང་པུ་སྟི་ཉི་ཤུ་རྩ་ལྔ་བཞུགས།",
    "འཛམ་བུ་གླིང་འདིར་ང་ཡི་གདུལ་བྱ་མང་དུ་ཡོད་གསུངས།",
    "བླ་ཆེན་བསོད་བློས་ཏི་ཤྲི་མཛད་པའི་སྐབས་ཙམ་ཡིན་པར་སེམས།",
    "ལས་སློབ་དཔལ་ལྡན་བརྩོན་འགྲུས་ལས་བསྙེན་པར་རྫོགས།",
    "འཇམ་དབྱངས་པས་མཇལ་ཕྲད་མ་གནང་བའི་མཚམས་སྦྱར་ཏེ།",
    "ཞུ་བའི་ཚིག་འདི་ཅུང་ཟད་གསན་པར་རིགས།",
    "སུམ་ཅུ་པ་ལྕགས་ཕོ་ཁྱི་ནས་ཞེ་གཅིག་པ་བྱི་ལོའི་བར་ལོ་བཅོ་ལྔ་འཆད་ཉན་ཡང་དག་པར་མཛད།",
    "རྒན་པོའི་ལག་རྗེས་འཇོག་གསུངས།",
    "དེང་སང་རྩིས་སུ་བྱེད་པ་འདི་ཁོ་བོས་བསྟན་པ་ལ་བྱ་བ་བྱས་པ་ཡིན་ཞེས་དང་།",
    "གསུམ་པ་མིན་པའི་ངེས་ཤེས་འགྲོངས་པ་གཅིག་བྱུང་གསུངས་ཟེར་ནའང་།",
    "ཀུན་མཁྱེན་ཤེར་འོད་བློ་བཟང་གྲགས་པ་སོགས།",
    "བཀའ་བཞི་ལེགས་པར་སྨྲ་བ་བཅུ་ཕྲག་གཅིག།",
    "སྦྱངས་པའི་མཆོག་གྱུར་ཀུན་མཁྱེན་ཤེར་འོད་དང་།",
    "མཁན་ཆེན་བྱང་སེང་ལ་ནོད་པ་ཡིན་ནོ་ཞེས་རྗེ་བཙུན་དམ་པ་ཀུན་དགའ་གྲོགས་མཆོག་གསུངས་ལ།",
    "དགུང་ལོ་བཅུ་དྲུག་པ་ལ་དབུས་གཙང་དུ་བྱོན།",
    "བཅུ་དགུ་པ་ལ་གསང་ཕུ་སོགས་སུ་གྲྭ་སྐོར་གནང་།",
    "གཙང་ཕྱོགས་ཀྱི་ཞྭ་ལུ་སྣར་ཐང་ས་སྐྱ་སོགས་སུ་བྱོན།",
    "བོ་དོང་དུ་གྲྭ་སྐོར་མཛད་ནས་སྣར་ཐང་དུ་ཕྱག་ཕེབས།",
    "དེ་ཉིད་ཀྱི་ཐུགས་སྲས་དམ་པར་གྱུར།",
    "བར་སྐབས་སུ་བྱ་བྲལ་ཁོ་ན་མཛད་དེ་ཟབ་དོན་ལ་དཔྱད་སྒོམ་གྱི་སྒོ་ནས་དོན་ཉམས་སུ་བཞེས།",
    "དེ་ནས་ཁྱད་པར་བསྙེན་བཀུར་ཆེར་མཛད་པ།",
    "ལོ་བཅོ་བརྒྱད་པ་ཡན་ཆད་དུ་བོན་ལ་འཆད་རྩོད་རྩོམ་གསུམ་གནང་།",
    "དམར་སྟོན་པའི་དྲུང་དུ་རབ་ཏུ་བྱུང་ཞིང་བསྙེན་པར་རྫོགས།",
    "ཀུན་མཁྱེན་འདི་གསུམ་ལས་འཆད་པའི་རྒྱུན་དང་།",
    "གཙང་ཕྱོགས་ལ་ཡང་ལན་གསུམ་བྱོན་པའི་དང་པོ་ལོ་ཉེར་བདུན་པའི་ཚེ་མཁན་ཆེན་པའི་ཞབས་འབྲིང་མཛད་དོ།",
    "ལྔ་ཅུ་ཙམ་གྱི་ཚེ་དིང་རི་དང་མུས་སོགས་སུ་སྔགས་ཀྱི་ཟབ་དོན་བཞེས་པ་དང་།",
    "ལོ་བཅུ་བཞིར་གཞན་དོན་མཛད་ཅིང་དབུས་གཙང་དུ་གྲྭ་སྐོར་མཛད་པའི་པོ་སྟི་བཅུ་ཁོ་ན་ཡིན་ཡང་།",
    "ཀུན་མཁྱེན་ཤེར་འོད།",
    "སྣར་ཐང་པ་ཤེས་རབ་སེང་གེབཟང་ལྡན་བཀའ་བཅུ་པ་སྟེ་གཙང་པ་བཞིའོ།",
    "གཙང་རོང་བྱམས་ཆེན་ནས་དཀར་ཤཱཀྱ་གྲགས།",
    "དགུང་ལོ་ཉེར་གསུམ་པ་ལ་རྩེ་ཐང་དང་གསང་ཕུར་པོ་སྟི་བཅོ་ལྔའི་གྲྭ་སྐོར་གནང་བས་མཁས་པའི་གྲགས་པས་ཁྱབ།",
    "མཁན་ཆེན་པས་གཟུགས་སྒྲ་ཀ་བུམ་སོགས་རྟག་པར་ཁས་བླངས་པ་ལ།",
    "ཕས་རྒོལ་ཕམ་པར་གྱུར་པ་ཡང་མ་ཡིན་ནོ།",
    "ཕ་རོལ་གྱི་རྒོལ་བ་ཉིད་ཤིས་ལ་ཕམ་པར་རིགས་པ་ག་ལ་ཡིན་སྟེ།",
    "རྒྱས་པར་མི་སྲིད་ཅེས་ཁས་བླངས་པ་ལ།",
    "མཁས་གྲུབ་དགེ་ལེགས་སོགས་རིགས་པས་ཕམ་པར་བྱས་སོ་ཞེས་གྲགས་སོ།",
    "ཀུན་མཁྱེན་རོང་སྟོན་ཆེན་པོ་སློབ་བུའི་ཚོགས་དང་བཅས་པ་ལ་འབེལ་བའི་གཏམ་ཆེན་པོ་གླེང་།",
    "འཇམ་དབྱངས་ཀྱི་དཀྱིལ་འཁོར་དྲུག་ཅུའི་རྣམ་གྲངས་ལེགས་པར་བགྲངས་ཤིང་།",
    "དཔལ་དེ་ཉིད་འདུས་པ་རྩོམས་ཤིག་ཅེས་གནང་བ་ནོས་པ་དང་།",
    "བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པ་དང་།",
    "དེ་ལྟར་གནང་བ་སྩལ་བ་ལ་བརྟེན།",
    "བཀའ་བཅུ་ལེགས་པར་སྨྲ་བ་སྟོང་ཕྲག་གཅིག།",
    "ལྷག་པར་རྒྱལ་བ་ཐམས་ཅད་བརྙེས་པའི་ཡུམ།",
    "སྤྲུལ་པའི་གར་གྱིས་གསང་བ་འཛིན་པར་མཛད།",
    "ཤབ་ལྷུན་རྩེ་བ་ཀུན་མཁྱེན་འཕགས་འོད་དང་།",
    "དེས་ན་དཔང་ལོ་ཆེན་པོ་ནས་བོ་དོང་ཨེའི་གདན་སེང་གེའི་ཁྲི་ཆེན་པོ་ལ་འཁོད་པར་ཡིན་ལ།",
    "ས་བཟང་འཕགས་པས་གསང་སྟོན་བགྱིས་ཏེ་བསྙེན་པར་རྫོགས་པར་ཡང་མཛད་དེ།",
    "ཁྱད་པར་བྱ་སྤྱོད་ཀྱི་བསྟན་པ་ལ་རྗེ་འདི་ཉིད་ཁོ་ན་བཀའ་དྲིན་ཆེ་བ་ཡིན་ནོ།",
    "ཀྱི་གཙོས་པའི་སློབ་བུ་མཐའ་ཡས་པ་ཞིག་བསྐྲུན་པར་མཛད།",
    "བཅུ་པར་ཤར་པ་ཡེ་ཤེས་རྒྱལ་མཚན་ལས་དགེ་ཚུལ་ནོད་དེ་ཀུན་དགའ་རྒྱལ་མཚན་ཞེས་བཏགས།",
    "ཤར་ཡེས་སློབ་དཔོན་མཛད་དེ་བསྙེན་པར་རྫོགས།",
    "ལོ་བཅུ་གསུམ་པ་ལ་གདན་ས་ཆེན་པོར་གྲྭ་སྐོར་ཡང་གནང་།",
    "གསུང་ངག་ས་ལུགས་དང་ཞྭ་ལུགས་སོགས་གསན་པས་ཐུགས་བསྐྱེད་ཐོན་པར་བྱུང་།",
    "སོ་ལྔ་པ་སྟག་ལོ་ལྷ་སར་སྐོར་བ་འབུམ་གཏེར་མཛད།",
    "དོན་བཞི་པ་སྦྲུལ་ལོར་ངམ་རིངས་སུ་འདུས་པའི་ཚོགས་ལ་གསུང་ངག་བློ་སྦྱོང་སོགས་ཀྱི་དགའ་སྟོན་གནང་།",
    "གྲོ་པར་དམར་སྟོན་དཔལ་ལྡན་རིན་ཆེན་དང་།",
    "མེ་ཕོ་རྟ་ལ་གཙང་ལ་བྱོན་ཏེ་བྱང་སོགས་སུ་འཆད་ཉན་མཛད།",
    "ཀུན་མཁྱེན་གོ་རམས་པ་ལས་ལོ་ལྔས་བགྲེས།",
    "ནམ་མཁའ་ལྷུན་བཟང་པས་སློབ་དཔོན་མཛད་དེ་བསྙེན་པར་རྫོགས།",
    "ཞེ་དགུ་པ་ལ་དཔལ་ལྡན་ས་སྐྱར་གདན་ཕེབས།",
    "དེ་ནས་ཉི་ཐོག་དང་ཞེ་དགོན་སོགས་སུ་བཞུགས།",
    "དགུང་ལོ་དོན་ལྔ་པ་ལ་ཞི་བར་གཤེགས་ཀྱི་བར་གནས་དེ་ཉིད་དུ་ཟབ་དོན་ཉམས་བཞེས་དང་།",
    "ཆུ་རྒྱུན་རྣམ་བཞི་སོགས་བསམ་གྱིས་མི་ཁྱབ་པར་མཛད།",
    "འདིའི་རིགས་ལས་བྱོན་པ་ཡང་སད་མི་བདུན་གྱི་གཙང་དེ་ཝ་ཨིནྡྲ་རཀྵ་ཞེས་བྱ་བ་དང་།",
    "ཕྱི་དར་གྱི་རྩ་བ་གཡོ་དམར་གཙང་གསུམ་གྱི།",
    "གཙང་རབ་གསལ་ཞེས་བྱ་བ་དང་།",
    "ལམ་དུས་རྒྱས་པ་ལུང་སྦྱིན་གྱི་ཉམས་བཞེས་རྣམས་མཛད་དོ།",
    "བཅུ་གསུམ་ཙམ་ལ་གསང་ཕུ་ནེའུ་ཐོག་ཏུ་ཕྱག་ཕེབས།",
    "འོན་ཀྱང་དེ་གཉིས་གང་ཞིག་བསྟན་པ་ལ་ཕན་པར་ལུང་བསྟན་དུ་གསོལ།",
    "འབྲུག་གསུམ་འཛོམ་པས་གངས་ཅན་འདིར་སྙན་པའི་གྲགས་པས་ཁྱབ་པར་འགྱུར་ཞེས་ལུང་བསྟན།",
    "གྲྭ་ས་ཆེན་པོ་དྲུག་པོ་འདི་ཉིད་ཀྱིས་ཀྱང་འཛམ་གླིང་འདི་མཛེས་པར་བྱས་པ་མ་ཡིན་ནམ།",
    "བསྟན་པའི་སྦྱིན་བདག་གཙང་ཆེན་ཧོར་ཤཱཀ་དང་།",
    "བརྩམ་པའི་རྣམ་གྲངས་བརྗོད་པར་མི་ནུས་སོ།",
    "བློ་བཟང་བ་སོགས་བགྲང་བར་མི་ལང་པར་བྱོན་ནོ།",
    "ཅེས་བརྒྱ་འབུལ་གྱི་རྣམ་གྲངས་མང་དུ་བཀོད་པ་ལ་གཙོ་བོར་བྱས་ཏེ།",
    "སོ་གསུམ་པ་སྦྲུལ་ལོ་ནས་སྤྲེལ་ལོའི་བར་ལོ་བཞི་ཙམ་ཞིག་འབྲས་ཡུལ་ཉིད་དུ་ཟུར་ནས་འཆད་པའི་དབྱངས་ཀྱི་བློ་ལྡན་ཡིད་གསོས་པར་བྱས།",
    "ཐུབ་བསྟན་རྣམ་པར་རྒྱལ་བའི་གླིང་ཆེན་པོ་བཏབ།",
    "མེ་ཕོ་རྟའི་བར་ལོ་བཞིར་རྡོ་རྗེ་འཆང་ཡབ་སྲས་ཀྱི་དགོངས་པ་རྫོགས་པར་མཛད།",
    "ཞྭ་ལུ་བཀའ་བཅུ་པ་གསུམ་ལ་འབུམ་འཛིན་པའི་བཀའ་གནང་ཕེབས།",
    "གཙང་ཆུ་གྲུ་གསུམ་དུ་སྟག་ཡོས་འབྲུག་གསུམ།",
    "ཀུན་མཁྱེན་གོ་རམས་ཆེན་པོ་གཤེགས་པའི་ལོ་དེ་ཡིན།",
    "སུམ་ཅུ་པ་བྱམས་ཆེན་རབ་འབྱམས་རྗེ་དང་གོ་རམས་ཆེན་པོས་མཁན་སློབ་ལས་བསྙེན་པར་རྫོགས།",
    "སོ་བཞི་པ་ཁྱི་ལོ་ནས་པཎ་ཆེན་འབུམ་པ་དང་གཉིས་ཀྱིས་ཟུར་འཆད་མཛད་དེ་རྒྱལ་བའི་བསྟན་པ་ཕན་ཚུན་འགྲན་པ་བཞིན་དུ་རྒྱས་པར་མཛད།",
    "སོ་གཅིག་ནས་སོ་ལྔའི་བར་སྤྱི་ནས་བསྐོས་པའི་ཟུར་འཆད་གནང་།",
    "སོ་དགུ་པ་ཆུ་ཕོ་སྤྲེལ་ལོ་དཔལ་འབུམ་ཕྲག་གསུམ་པའི་རྒྱལ་ཚབ་དམ་པར་མངའ་གསོལ་ཏེ།",
    "ཁོ་བོ་ཅག་ཀྱང་ལོ་བཅོ་ལྔ་ལོན་པའི་ཚེ་ཀུན་མཁྱེན་ཆེན་པོས་གདན་ས་པཎ་གྲུབ་བཟང་པོ་བཀྲ་ཤིས་ལ་གཏད་ཙམ་གྱི་ལོ་དཔལ་གཉན་ཡོད་ཀྱི་གཙུག་ལག་ཁང་དུ་རྗེ་འདི་ཉིད་ཀྱི་ཞབས་པད་བསྟེན།",
    "ལྔ་ཅུ་རྩ་ལྔ་པ་ལ་གནས་བཟང་པོ་སྙག་ཕུར་གདན་ཕབས་ཏེ་ཟབ་དོན་ཉམས་སུ་བཞེས།",
    "སུམ་སྟོང་སུམ་བརྒྱ་ཞེ་བཞི་པའི་བཞི་ཅུ་རྩ་ལྔ་པ་ཆུ་ཕོ་སྤྲེལ་ལོ་པཎ་ཆེན་དེ་ཉིད་ཀྱིས་གཙོ་བྱས་ཏེ་རབ་ཏུ་གནས་པའི་མེ་ཏོག་གཏོར།",
    "འདིའི་ཞལ་བཀོད་ཀྱང་བྱང་སེམས་ཆེན་པོ་བས་གནང་ཟེར་བས་དགུང་ལོ་བརྒྱད་ཅུ་རྩ་དྲུག་པའི་ལོ་ཡིན་ནོ།",
    "རྫོགས་པར་གྲུབ་པའི་མེ་ཕོ་སྟག་ལོ་འདི་ནི་འདས་ལོ་ནས་སུམ་སྟོང་དྲུག་བརྒྱ་དགུ་ཅུ་རྩ་དགུར་སླེབས་པའི་ལོ་དེ་ཡིན་པས།",
    "ཕྱག་གཡས་ཀྱི་དང་པོ་ཆུ་སྲིན་མགོས་ཏོག་བྱས་པའི་རྒྱལ་མཚན་འཕྱར་ཞིང་།",
    "སྲོག་བདུད་དམར་པོ་ཕྱག་གཉིས་མི་རོ་ཕྲག་པར་ཁུར་བ།",
    "ས་ལྷ་སེར་པོ་ཕོ་རོག་ཞོན་པ།",
