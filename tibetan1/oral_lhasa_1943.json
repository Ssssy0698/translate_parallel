    "དྲུག་པར་ལེགས་སྤྱད་གང་ཡིན་དེ་ཀུན་ཀྱང་ཞེས་དང་།",
    "བདུན་པར་དེ་ལྟར་བཟོད་པས་བརྩོན་འགྲུས་བརྩམས་ཞེས་དང་།",
    "བརྒྱད་པར་དེ་ལྟར་བརྩོན་འགྲུས་བརྩམས་ནས་ནི་ཞེས་པ་ནི་འདས་ཚིག་ཁོ་ནར་ཟད་ལ།",
    "འདི་སྒྲ་དུས་གསུམ་སྤྱི་དང་ཁྱད་པར་མ་འོངས་པ་ལ་འཇུག་པ་ཤས་ཆེ་བས་འདི་དག་ཅེས་གོང་འོག་གཉིས་ཀ་ལ་འཇུག་པ་གདོན་མི་ཟའོ།",
    "ཞི་བར་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་དཀའ་འགྲེལ་བཞུགས།",
    "དེའང་ས་ཐོབ་འཕགས་པའི་རྗེས་ཐོབ་འདུས་བྱས་ཀུན་རྫོབ་དང་།",
    "དོན་དམ་པའི་བདེན་པ་ནི་མཚན་ཉིད་ཐམས་ཅད་ལས་འདས་པས་རྣམ་པར་རྟོག་པའི་བློ་ཡི་སྤྱོད་ཡུལ་མིན་ལ།",
    "དེས་ན་སྣང་བ་སེམས་སམ་སེམས་ཀྱི་ཆོ་འཕྲུལ་དུ་འདོད་པ་ཐེག་ཆེན་ཕལ་ཆེར་མཐུན་པར་ཤེས་པར་བྱའོ།",
    "ཞེས་གསུངས་པ་ཡང་རྣལ་འབྱོར་པ་འཕགས་པ་ལ་དགོངས་པ་ཡིན་ནོ།",
    "ཕལ་པ་འབའ་ཞིག་ལ་གནོད་པ་མ་ཟད་རྣལ་འབྱོར་པ་ཡང་བློ་སྟེ་ཤེས་རབ་ཀྱི་ཁྱད་པར་དང་ཏིང་ངེ་འཛིན་དང་སྙོམས་པར་འཇུག་པ་ལ་སོགས་ཀྱིས།",
    "འདིའི་དོན་སྐར་མ་དང་ཟླ་བའི་འོད་ཉི་མའི་འོད་དུ་འདུས་པ་བཞིན་འཕགས་པ་འོག་མའི་མཁྱེན་པ་གོང་མར་འདུབས་མི་འགལ་ཡང་འོག་མ་ལས་གོང་མ་འཕགས་པའི་དོན་ཏོ།",
    "དེས་ན་རྣམ་འབྱོར་པ་ནི་རིགས་ཅན་གསུམ་གྱི་འཕགས་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་དཀའ་འགྲེལ་བཞུགས།",
    "རྣལ་འབྱོར་པའི་བློའི་ཁྱད་པར་ལས་ཕལ་པའི་ཤེས་པ་འཁྲུལ་པ་ཡིན་ནོ་ཞེས་ཇི་ལྟར་རྟོགས་པར་ནུས་ཞེ་ན།",
    "རྩོད་པ་དངོས་རྒྱས་པར་བསྟན་པ་དང་གསུམ་ལས།",
    "ཐ་སྙད་ཁས་ནི་མ་བླངས་པར།",
    "ངེད་ཅག་འཆད་པར་མི་བྱེད་དོ།",
    "ཇི་ལྟར་གང་དུ་ལོག་པར་རྟོག་པཡོད་པར་འགྱུར་ཞེ་ན།",
    "ཡང་དག་པ་སྟེ་དོན་དམ་པ་ཉིད་དུའང་རྟོག་པར་བྱེད་ཀྱི།",
    "དོན་རྟོག་པའམ་མི་རྟག་པ་དང་བདེན་པར་གྲུབ་མ་གྲུབ་དང་།",
    "འོག་ལམ་ལ་རྩོད་སྤོང་སྐབས་བྱེ་སྨྲ་གཙོ་ཆེ་བ་ཡང་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་ཇི་ལྟར་བསྙོན་པར་ནུས།",
    "འཇིག་རྟེན་ན་གཙང་བ་དང་རྟག་པ་ལ་སོགས་སུ་གྲགས་བཞིན་དུ་རྫུན་པ་ཕྱིན་ཅི་ལོག་ཏུ་འཛིན་པ་ཡིན་ནོ།",
    "མི་གཙང་བ་སོགས་ཐ་སྙད་དུ་ཡོད་དགོས་པའི་ཕྱིར།",
    "གཉིས་པ་ལ་ཕུང་ཁམས་སྐྱེ་མཆེད་ཡོད་པར་བསྟན་པ་དང་འགལ་བ་སྤང་བ།",
    "ང་དང་ང་ཡི་ཞེས་གསུངས་ལྟར།",
    "དོན་དམ་པར་སྟོང་པ་ནམ་མཁའ་ལྟ་བུ་མཐའ་གང་དུའང་མ་གྲུབ་བོ།",
    "རྣལ་འབྱོར་པའི་རྗེས་ཐོབ་ཀུན་རྫོབ་ཙམ་ཡིན་པར་གྲུབ་བོ།",
    "ཞེས་སོགས་གསུངས་པའི་ཕྱིར་རོ།",
    "མ་རིག་པའི་གཉིད་སད་པ་ལ་ལྟོས་ན་སད་པའི་སྣང་བ་ཡང་སྒྱུ་མ་རྨི་ལམ་དང་ཁྱད་པར་ཅི་ཡོད།",
    "ལྷ་སྦྱིན་བསད་བསམ་ནས་མད་སྦྱིན་ལ་ཕོག་ན་མཆོད་སྦྱིན་ཤི་རུང་མ་ཤི་རུང་སྦྱོར་སྡིག་ཁོ་ན་སྟེ་འདུ་ཤེས་ནོར་བའི་ཕྱིར་ཏེ་མཛོད་ལས།",
    "སྔ་དང་མཉམ་དུ་ཤི་བ་ལ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་དཀའ་འགྲེལ་བཞུགས།",
    "༩དངོས་གཞི་མེད་པར་གསུངས་པའི་ཕྱིར་སྤྲོས་པ་གཞན་རྣམས་ཤེས་པར་ཟད་དོ།",
    "དཔེར་ན་ཆུ་ཟླ་ལ་བདེན་པར་བཟུང་ནས་འཁྲུལ་པ་བཞིན་ནོ།",
    "གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་དཀའ་འགྲེལ་བཞུགས།",
    "དེ་ལ་ཁྱད་པར་བསྟན་པའི་ཕྱིར་རྐྱེན་རྣམས་རྒྱུན་ནི་མ་ཆད་ཅིང་མ་ཉམས་ན།",
    "རྐྱེན་རྣམས་རྒྱུན་ཆད་པ་ཡང་དེ་ཁོ་ན་ལ་གོམས་པར་བྱས་པས་མ་རིག་པ་ལ་སོགས་པ་རིམ་གྱིས་འགག་པར་ཤེས་པར་བྱའོ།",
    "རིགས་པ་དྲུག་ཅུ་པའི་འགྲེལ་པར་བདེན་པ་གཉིས་རྣམ་པར་བཞག་པ་ཡང་ཀུན་རྫོབ་ཏུ་ཡིན་ནོ་ཞེས་གསུངས་པ་ལྟར་རོ།",
    "ད་ནི་རྣལ་འབྱོར་སྤྱོད་པའི་འོག་པར་རྟོག་པ་བསལ་བའི་ཆེད་དུ།",
    "འདིའང་བློ་ནི་ཀུན་རྫོབ་ཡིན་པར་འདོད།",
    "སྣང་བ་ཐ་སྙད་དུ་མི་འགོག་པར་བསྟན་པ་གཉིས།",
    "དེ་བས་ན་འགྲོ་བ་མཐའ་དག་ལོང་བ་ཉིད་ཐོབ་པར་འགྱུར་རོ་ཞེས་དགོངས་པ་ཡིན་ནོ།",
    "འདིར་ཐ་སྙད་སྣང་ཙམ་དགག་པ་མིན་ཏེ་དོན་དམ་པར་བེམས་ཤེས་མཐའ་དག་ཤེས་པའི་རྫ་ས་རང་རིག་གཅིག་པུར་འདོད་པ་ལ་ཁས་བླངས་ནང་འགལ་བ་བསྟན་ཏེ།",
    "ཐ་སྙད་ཙམ་དུ་སྣང་བ་སྒྱུ་མ་ལྟ་བུ་རྫུན་པར་ཁས་ལེན་པ་ལ་ནི་དངོས་སྟོབས་རིགས་པས་འགོག་མི་དགོས་སོ།",
    "བདག་ཉིད་ལ་བྱེད་པ་འགལ་བའི་ཕྱིར་སེམས་ཀྱིས་སེམས་མི་མཐོང་ཞེས་གསུངས་ཏེ།",
    "དཔེར་ན་རལ་གྲི་རྣོན་པོའི་སོ་ནི་རང་ལ་རང་ཇི་ལྟར་མི་གཅོད་པ་དེ་བཞིན་ཡིད་ཀྱང་བདག་ཉིད་ཀྱིས་བདག་ཉིད་མི་མཐོང་སྟེ་ཤེས་པ་གཅིག་པུ་དེ་ལ་རིག་པར་བྱ་བ་དང་།",
    "རིག་པར་བྱེད་པ་དང་རིག་པའི་བདག་ཉིད་གསུམ་མི་རིགས་ཏེ་ཆ་ཤས་མེད་པ་གཅིག་ལ་རང་བཞིན་གསུམ་མི་འཐད་པའི་ཕྱིར་རོ།",
    "ཁྱད་པར་གཞན་ལ་ལྟོས་པ་ཡོད་པ་མ་ཡིན་པས།",
    "རྒྱུ་རྐྱེན་གྱིས་འདུས་མ་བྱས་པའི་ཤེལ་སྔོན་པོ་མི་སྲིད་ལ།",
    "རྒྱུ་རྐྱེན་གྱིས་འདུས་བྱས་པའི་ཤེལ་ནི་དང་པོ་ཉིད་ནས་སྔོན་པོ་ཉིད་མིན་ལ་ཕྱིས་སྔོན་པོར་གྱུར་པ་དེ།",
    "ནི་བརྗོད་པར་བྱས་ཀྱང་དོན་མེད་དོ།",
    "འདི་རིགས་པས་སྟོང་ཞིང་ཚིག་ཙམ་མ་ཡིན་པར་རིགས་པ་ནི་འདི་ཡིན་ཏེ།",
    "ཡུལ་མྱོང་བ་ན་ཕྱིས་སུ་དེ་དང་དུས་གཅིག་པའི་རྣམ་པར་ཤེས་པ་དྲན་པར་ཇི་ལྟར་འགྱུར་ཏེ།",
    "རང་རིག་པའི་ཤེས་པ་ཡོད་དོ་ཞེས་དཔོག་པར་བྱའོ།",
    "དེ་ལ་བརྗོད་པར་བྱ་སྟེ།",
    "གཞན་གྱི་སེམས་ཀྱི་ཁྱད་པར་མཐོང་བའི་ཕྱིར་རྣམ་པར་ཤེས་པ་རང་ཉིད་རང་ལ་གསལ་ཞེ་ན།",
    "དེས་ན་གཞན་སེམས་མཐོང་ན་རང་སེམསཅི་སྟེ་གྲགས་ཆེན་བཅོ་བརྒྱད་ཀྱི་སྤྱོད་འཇུག་ཤེར་ལེའི་དཀའ་འགྲེལ་བཞུགས།",
    "གལ་ཏེ་ཤེས་པ་རང་རིག་པའི་ངོ་བོར་མ་གྱུར་ན་དོན་གཟུགས་སྒྲ་སོགས་གཞན་ཡང་རྟོགས་པར་མི་འགྱུར་བ་མ་ཡིན་ནམ་ཞེ་ན།",
    "ག་པར་མི་འགྱུར་གང་ཡིན་དེ་ལའོ།",
    "སེམས་ཙམ་སྐབས་ཡིན་པའི་ཕྱིར་དང་བདེན་པ་ཁོ་ན་འགོག་པ་དངོས་སུ་གསུངས་པའི་ཕྱིར་རོ།",
