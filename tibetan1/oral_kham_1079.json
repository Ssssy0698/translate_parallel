    "ཕྲན་ལྟ་བུས་ག་དུས་ཀྱང་སྡོམ་ཚིག་འཇོག་ཐབས་བྲལ།",
    "ཡང་ན་གཉེན་ཉེ་སྤུན་མཆེད་ཚོའི་ནང་ལ་ཁྱེད་རང་ནང་བཞིན་གྱི་ལྟ་བ་འཁུར་མཁན་ཡོད་དམ།",
    "ང་ལ་དམིགས་བསལ་རྩྭ་ས་བགོ་འགྲེམ་འདིར་ཕན་འབྲས་མེད་པའི་ཚོར་བ་གང་ཡང་སླེབས་ཀྱི་མི་འདུག་ཀྱང་།",
    "གང་ཡིན་ཟེར་ན་ཁོའི་གནས་སྟངས་འབྱུང་འགྱུར་ལོ་ངོ་བཅུ་གཅིག་ལ་བཙོན་དུ་འདུག་དགོས་པས་ཡིན།",
    "དེ་ནས་བཟུང་ཁོ་སྨྱོན་པ་སྨྱོ་རྐྱང་ཞིག་ཆགས་འདུག་ལ་བསྒྱར་བཀོད་ཀྱང་བྱེད་མི་དགོས་པར་ཉིན་རྟག་པར་ཉལ་ཁང་དུ་བཅུག་ནས་བཞག་ཡོད།",
    "དོན་དངོས་སུ་འཛམ་གླིང་དེང་རབས་ཅན་ལ་འགྱུར་བའི་དུས་ཚོད་ནང་རང་ཉིད་ཀྱིས་བྲན་གཡོག་ལམ་ལུགས་རྒྱུན་འཛིན་བཞིན་ཡོད།",
    "པ་ལ་ལྟ་རུ་ཕྱིན་དུས་ཁོ་ཕལ་ཆེར་ཤི་ཚར་འདུག་ཟེར།",
    "དང་ཐོག་འཕྲད་སའི་རྒྱ་མི་དེས་ཁྱེད་རང་ཞེད་སྣང་སྐྱེ་དགོས་དོན་མེད།",
    "ཁོའི་ལག་ཏུ་དཔེ་དེབ་རྒྱབ་ཤ་སེར་བོ་སྒང་དུ་ཡི་གེ་དམར་བོ་དང་འོག་ཏུ་རྒྱ་དམར་གྱི་རྒྱལ་རྟགས་འཁོད་པ་ཞིག་བཟུང་འདུག་ཁོ་ངའི་འཁྲིས་སུ་བསྡད་དེ་ཡ་གསར་བུ།",
    "ཆུ་ཚོད་ཕལ་ཆེར་དང་བོར་སླེབས་འདུག་ཅིང་ང་མལ་ཁྲིའི་སྟེང་གན་བཙོན་བསྐྱོད་ཟིན་ཐོ།",
    "སྐབས་དེར་ཕལ་ཆེར་ཆུ་ཚོད་གསུམ་ལ་སླེབས་ཡོད་ཚོད་འདུག་ང་བཙོན་བསྐྱོད་ཟིན་ཐོ།",
    "ད་ཁྱེད་རང་སེམས་ལྷོད་ལྷོད་ཀྱིས་ཉལ་ཏེ་བསམ་བློ་ཡག་པོ་ཞིག་ཐོངས།",
    "དེ་ནས་མགྱོགས་པོར་ཉལ་ཁང་དུ་ཡོང་དུས་མི་གཅིག་ཀྱང་མི་འདུག་སྟབས།",
    "ཧི་ཧེ་ཞེས་ཁྲེལ་དགོད་ཅིག་བྱས་ནས་སྣང་བ་སྐྱིད་དྲགས་འདུག་ཅེས་རྐུབ་ལ་རྡོག་རྒྱག་འགའ་བྱས་ཏེ་ལག་གཉིས་རྒྱབ་བསྣོལ་གྱི་ལྕག་བརྒྱབ་ཐོག་ཁ་གྱང་ལ་བསྐོར་ནས་འགྲེང་དུ་བཅུག་ནས།",
    "རྣམ་འགྱུར་ཡག་པོ་འདུག་ད་མུ་མཐུད་བྱས་ཉེས་གཞན་པ་རྣམས་ཡིན་ཟེར།",
    "དེ་ལྟའི་དོན་དངོས་ལག་ལེན་ལས་ལྡོག་སྟེ་ཁོ་རང་ཀྲུང་གོ་གཏོར་བར་འདོད་པའི་མ་རྩ་རང་ལུགས་ཀྱི་བེད་སྤྱོད་ཀྱི་ལག་ཆ་བྱས་བཙོན་བསྐྱོད་ཟིན་ཐོ།",
    "སྐྱིད་པོ་འདུག་གམ།",
    "ཁོས་ང་མཐོང་མ་ཐག་ཅི་འདྲ་འདུག་རང་ཉེས་ངོས་ལེན་གྱི་བསམ་བློ་ཐོབ་པ་ཡིན་ནམ་ཟེར་བཞིན།",
    "སྐད་བཏང་ནས་རྒྱ་སྐད་ཀྱིས་གནས་སྟངས་ག་འདྲ་འདུག་ཟེར།",
    "གང་ལྟར་ཀྱང་གྲོད་ཁོག་ཏུ་རྒྱུན་ལྡན་མིན་པའི་ན་ཟུག་ཅིག་སླེབས་འདུག་ཅེས་བཤད།",
    "དེ་དང་ལྷན་ངས་ནུས་ཤུགས་ཅི་ཡོད་ཀྱིས་འཕག་ཚག་བྱས་ཀྱང་རང་སྲུང་བྱེད་མི་ཐུབ་ལ།",
    "ག་དུས་ཤིག་ལ་རག་ཐུབ་ཟེར།",
    "དང་ག་དུས་ཕྱིར་ལོག་བྱེད་ཐུབ་མིན་སོགས་མིའི་བློ་ཡུལ་དུ་འཆར་དཀའ་བའི་དྲི་བ་མང་བོ་ཞིག་བཀོད་དེ་ཉིན་ལྔ་ལ་ཆོག་མཆན་ཕྱིར་འགྱངས་བྱས།",
    "སོགས་རྒྱན་རྩ་བ་དང་རང་འགྲེལ་གཉིས་སུ་རྒྱ་ཆེར་བསྟན།",
    "ཅིག་ཅར་འཇུག་པ་ནི་ས་བཅུ་པ་དང་འདྲའོ་གསུངས་འདུག།",
    "དེ་ལ་གནོད་བྱེད་ལུང་རིགས་རྒྱ་ཆེར་བསྟན་འདུག་ཀྱང་འདིར་ཡི་གེས་འཇིགས་པས་མ་བྲིས་སོ།",
    "ཆགས་སྡང་རང་གར་སྨྲ་བ་རྣམས་ལ་ཅི་འགྱུར་ཆ་མེད་པས་དོན་ཆུང་བ་དང་།",
    "ད་དུང་དཔལ་མགོན་འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱིས་རིགས་པ་རྣམ་དག་ལ་བརྟེན་ནས་རྒོལ་བའི་ལོག་རྟོག་དགག་མི་ནུས་པར་ཁས་ལོངས་དང་མཛེས་པར་འདུག་གོ།",
    "ཅེས་དངོས་པོའི་གནས་ཚུལ་མཐར་ཐུག་འཇལ་བའི་བློ་རྣམས་ལ་དྲི་མེད་ཡེ་ཤེས་སྤངས་པའི་བློས་གནོད་མི་ནུས་པར་གསུངས་པ་འདི་བློ་ལ་བབ་ན་ལན་དེས་ཆོག་པར་འདུག་པས་རྒྱས་པར་མ་སྤྲོས་སོ།",
    "དེའི་ཡུལ་རྣམས་དེའི་ངོར་གྲུབ་པ་ཙམ་ལ་ཐ་སྙད་ཚད་གྲུབ་ཅེས་འཇོག་པ་ཡིན་གྱི་དོན་དཔྱོད་ཀྱིས་དགག་མི་ནུས་པ་ཞིག་ལ་ངོས་འཛིན་རྒྱུ་ཡིན་ཚོད་མི་འདུག་གོ།",
    "རྩོད་བཞིན་པ་དེ་དང་སྒོ་ཀུན་ནས་མཚུངས་པར་འདུག་པས་རིགས་པ་སྨྲ་བའི་གཏམ་དུ་ཨེ་འགྲོ་སྙམ།",
    "དེ་ཁོ་ན་ཉིད་ཚུལ་བཞིན་དུ་དཔྱོད་པའི་རིགས་པས་གནོད་པ་མེད་པ་སྟེ་ཐ་སྙད་ཁྱད་པར་གསུམ་ལྡན་གྱི་སྒོ་ནས་ཚད་གྲུབ་ཡིན་མིན་འཇོག་དགོས་ཞེས་པ་དེ་ཡང་རང་ལུགས་ལྟར་ན་འཐད་པར་མ་མཐོང་སྟེ།",
    "དེ་དང་མཐུན་པར་བྱེད་མེད་ལས་ཚིག་དུས་ད་ལྟ་བ་ལའང་འཇུག་པའི་བྱ་ཚིག་དེ་དང་གྲངས་མཉམ་པ་ཡོད་པར་བརྟེན།",
    "གཞན་ལའང་འཇུག་དུས་གསུམ་ལས་གཙོ་བོ་མ་འོངས་པ་སྟོན་པའི་ཕྱིར་འཇུག་ལ།",
    "བཀྲ་བཀྲེས་བསྐལ་བགྲེས་བགྲོད་བརྒྱལ་བརྒྱུད་བསྔགས་བསྔལ་བརྗིད་བརྗིད་བརྙས་བརྙེས་བསྙེངས་བསྟོད་བདོ་བརྩོན་བཞད་བཞེངས་བཞེད་བཞེས་བཟི་བཟོད་བཤལ་བཤིགས་ཏེ་ལག་སྣེ་ལས་བཏུས་པའི་ཉེར་ལྔ་པོ་འདི་དག་མིང་རྐྱང་མ་ཡིན་པའི་ལས་ཚིག་དུས་གསུམ་གར་ཁྱད་མེད་དུ་འཇུག་པ་ཤ་སྟག་ཡིན་ལ།",
    "འགྲོ་བ་པོ་ཞེས་བཀོད་འདུག་ཀྱང་།",
    "བོད་ཀྱི་ལོ་ཙཱ་བ་ཆེན་པོ་བེ་རོ་ཙ་ནས་རྒྱ་གར་གྱི་སློབ་དཔོན་ཆེན་པོ་ཤྲཱི་སིངྷའི་མདུན་ནས་ཞུས་ཤིང་བསྒྱུར་པའི་རྫོགས་པ་ཆེན་པོའི་མན་ངག་སྟོན་པའི་རྒྱུད་ཅིག་ཡིན་ལ།",
    "དེ་ལ་རྗེ་ཉིད་ནས་ཀྱང་ལྷག་ཆད་ནོར་གསུམ་གྱི་སྐྱོན་དང་བྲལ་བ་ཞེས་བསྔགས་བརྗོད་ཀྱི་མེ་ཏོག་གཏོར་བར་མཛད་འདུག་པ་མ་ཟད།",
    "ཅེས་ལུང་བསྟན་གནང་འདུག་པའི་ཕྱིར།",
    "མཁས་མཆོག་བསྟན་དར་ལྷ་རམ་པ་སོགས་དགེ་ཕྱོགས་ཀྱི་མཁས་གྲུབ་གཉིས་ལྡན་གྱི་སྐྱེས་ཆེན་རྣམས་ཀྱིས་རྫོགས་ཆེན་ཉམས་ལེན་མཛད་ཅིང་དེ་ལ་བསྔགས་བརྗོད་མཛད་འདུག་པ་ལས་བཀག་པ་མི་སྣང་ངོ།",
    "འོན་ཀྱང་རང་སྟོབས་བློ་གྲོས་རབ་དབེན་ཞིང་།",
    "ལོ་ཙཱ་བ་ཡོངས་ཀྱི་གཙུག་རྒྱན་དམ་པ་པ་གོར་བི་རོ་ཙ་ན་མཆོག་དང་།",
    "རང་བྱུང་རིག་པ་དེ་གཉུག་མ་ལྷན་ཅིག་སྐྱེས་པ་ལ་བྱེད་དམ་ཞེས་དྲི་བ་དྲིས་འདུག་པ་ལ།",
    "ཞེས་སོགས་ནས་ཉི་མ་དགྲ་གཅན་གཟའ་བྲལ་ལྷང་ངེ་འདུག་པ་ལྟར་ཞེས་པའི་ལུང་དོན་དང་།",
    "སྤྱོད་པའི་སྲོག་མཁར་ཚུགས་པའི་མཁས་གྲུབ་ནམ་མཁའི་སྐར་ཚོགས་ལྟར་འདུག་པས།",
    "ཞེས་བྲིས་འདུག་པ་ནི།",
    "རང་ཉིད་ཡིན་ལོག་མིན་ལོག་ལ་མགོ་བོ་འཁོར་ནས་ཚད་ལྡན་གྱི་གཞུང་ལ་ཐོས་རྒྱ་ཆུང་བ་ཞིག་ཡིན་པ་རང་ཉིད་ཀྱིས་བསྒྲུབས་འདུག་པས།",
    "ཡང་བདེ་སྡུག་འཁྲུལ་སྣང་ཡིན་པས་སོགས་དྲི་བ་གཉིས་འདུག་པ་ལ།",
    "ཞེས་གདམས་ངག་གོ་རིམ་གྱི་ཚུལ་དུ་གསུངས་འདུག་པར་མ་ཟད།",
    "ཅེས་པའི་དཔེ་རུ་གྱུར་འདུག་ཀྱང་།",
    "སྒྱུ་རྩལ་རྩོམ་རིག་ཀྱང་སྤེལ་མྱོང་འདུག།",
    "ལག་ལེན་ལ་མུན་པ་རུབ་རུབ་ཀྱི་དཔེ་ཟླར་གྱུར་མི་འདུག་གམ།",
    "རྟོག་པའང་རང་རིག་ཉིད་དུ་འདོད།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "ཞེས་ཟེར་གྱི་འདུག་པ་དེར་ལྟོས་དང་།",
    "ཨ་ཙི་ཙི།",
    "སྔ་མའི་ཐོག་ཉེ་འབྲེལ་གྱི་རྒྱལ་ཁབ་རྒྱ་གར་དང་བལ་ཡུལ་མངའ་ཁོངས་སུ་ཡོད་པའི་བོད་རིགས་དང་རང་བཙན་གྱི་ངོ་བོར་ཡོད་པའི་འབྲུག་ཡུལ་བཅས་པར་གོ་དགོས།",
    "ཞེས་པ་ལྟར་ན་ཕྲད་དང་ཚིག་ཕྲད་རྐྱང་པ་གཉིས་ལ་ཁྱད་ཡོད་པར་དངོས་སུ་བསྟན་འདུག་པས།",
    "ཁྱེད་རང་ལྟར་ན་ཕྱི་མ་དེ་དཔེ་དོན་མི་མཚུངས་པའི་ཕྱིར་ཏེ།",
    "ཡང་རང་རྒྱུད་དུ་སྦྱོར་ཡང་རུང་སྟེ།",
    "ཕྱི་མ་ནི་ཐུགས་རྫོགས་པའི་སྐབས་ཡིན་པས་འཐད་ཅེས་གསུངས་ཀྱང་རང་ལུགས་ལ་ནི་དེ་ལྟར་མ་ཡིན་ཏེ།",
    "དམངས་སྒོར་ཁྲི་༢ ཙམ་ཞིག་ལོ་མཇུག་ལ་ད་དུང་ལྷག་འདུག་ཟེར།",
    "གཅིག་ཀྱང་མེད་པ་ཅི་རིགས་ཡིན་འདུག་ལ།",
    "ཡིན་ཡིན་འགྲིག་འགྲིག་མང་པོ་གླེང་རྒྱུ་འདུག་པ་དེ་དག་ངས་ངོ་མ་ལྷང་ངེར་དྲན་བྱུང་།",
    "ཁྱིམ་བདག་དེ་དག་ལ་ཡང་ཁྱེད་ཅག་ནོར་མི་འདུག་ཅེས་མི་འདོད་བཞིན་དུ་བདེན་ཁ་མི་སྦྱིན་ཐབས་མེད་དུ་གྱུར་པ་མ་ཡིན་ནམ།",
    "ཅེས་འཁོད་འདུག་པ་ལྟར་བྱ་བཞག་འདི་རིགས་ནི་རྒྱལ་ཁབ་ཅིག་དང་།",
    "ང་རང་ཡང་མགོ་ལོག་མིག་ཡངས་ཚོ་དགོན་གཉིས་ཀྱིས་མངགས་བཅོལ་དང་ལེན་དང་།",
    "ཟླ་༥ པའི་ཚེས་༣ ཉིན་ང་རང་སྐྱེ་དགུར་འབྱོར་ཉིན་ནས་བཟུང་ཉིན་བཅུ་གསུམ་རིང་ལ།",
    "གཞན་ཡང་༥ པའི་༩ ནས་༡༢ བར་གྱི་ཞག་གསུམ་ལ་ང་རང་རྟ་རྒྱུག་ཐང་དུ་ཁྱིམ་ཚང་ཞིག་ལ་གནས་ཚང་གཡར་ཏེ་བསྡད་པ་ཡིན།",
    "ད་དུང་རང་ཉིད་ཀྱི་རྐུབ་སྟེགས་སྲ་བརྟན་དང་ཕོར་བ་ཇེ་ཆེར་གཏོང་བ་ལའང་ཕན་ནུས་མངོན་གསལ་ཐོན་ཡོད་པར་ངེས།",
    "དེ་ལྟར་གྱུར་པ་ལ་བསྔགས་བརྗོད་དང་བྱ་དགའ་ཡང་གནང་ཡོད་རབས་འདུག་ཅིང་།",
    "ཞེས་བཀོད་འདུག་གྲོགས་པོ་ལགས་མཐོང་བ་ཙམ་གྱིས་སྐྱི་གཡའ་ཞིང་།"
  ]
}