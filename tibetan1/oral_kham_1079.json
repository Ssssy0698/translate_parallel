    "སྲིབ་ཁྲི་བཅས་རྒྱལ་རབས་བདུན་པོ་ཤི་དུས་ནམ་མཁར་གཤེགས་སྐད་འདུག་པས།",
    "ངན་པའི་གྲོས་ལ་མི་ཉན་ཞིང་རང་ཚུགས་འཛིན་པ།",
    "འཇིག་རྟེན་དྲེགས་པའི་བཀའ་བབ་རླངས་དཔལ་གྱི་སེང་གེསྟོབས་ལྡན་ནག་པོའི་བཀའ་བབ་བོ་རོ་ཙ་ན་རྣམས་སོ།",
    "བ་གོར་བི་རོ་ཙ་ན།",
    "སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ།",
    "བོརོ་ཙ་ནའི་ཡང་དག་བཅུ་གཅིག་ནི།",
    "བརྗོད་བྱའི་དོན་རྩོམ་རིག་བསྟན་བཅོས་ཀྱི་གླེགས་བམ་རྣམས་རང་ཚུགས་དང་རང་རྐྱ་ཐུབ་པར་མ་གྲུབ་སྟེའདོད་དེ།",
    "རང་འགྲོས་གཟའ་བདུན་དང་དུ་བ་མཇུག་རིང་རྣམས་རང་རང་།",
    "ཉིན་ཞག་ཕྲུགས་གཅིག་དུས་ཚོད་བཅུ་གཉིས་སུ་ཕྱེ་སྟེ།",
    "རང་རང་འཁོར་ལོ་གང་ལོངས་པ།",
    "དལ་བའི་སྟེང་ནས་མགོ་བརྩམས་ཏེ་རང་འགྲོས་ཀྱིས་རྐང་བའི་ལོངས་སྤྱོད་འཕེལ་འགྲིབ་རྣམས་ཀྱི་ནོར་དང་བུ་ལོན་སྤྱད་ཟིན་པ་དང་མཉམ་དུ་རང་རང་སྐྱེས་སྐར་དང་ཉི་མའི་སྟེང་དུ་འཛོམས་ཏེ་ལོངས་སྤྱོད་དག་པར་འགྱུར་རོ།",
    "དེ་ལས་དམིགས་བསལ་ཞིག་ཡོད་རུས་བོད་ཡིག་ཏུ་སྒྱུར་སྐབས་རྡོ་རིང་བྱང་ངོས་ཀྱི་སྒྱུར་ཚུལ་ལྟར་ཚང་མ་སྒྲ་སྒྱུར་བྱས་འདུག་པ་ནི་བློན་པོ་ཆེ་གྲས་ཀྱི་གོ་གནས་ཞེས་པ་དེ་བཀའ་ཆེན་པོ་ལ་གཏོགས་པ་ཞེས་དོན་སྒྱུར་བྱས་ཡོད།",
    "ཚང་མ་གཅིག་གྱུར་སྒོས་ཛ་དང་ཙ་ཞེས་བསྒྱུར་འདུག་དཔེར་ན།",
    "བསེ་དང་འཁོན་གཉིས་མི་འབོར་མང་ཞིང་ཁྱབ་ཁོངས་ཀྱང་གོང་དུ་བཀོད་པ་ལྟར་གནའ་རབས་ཡུན་ནན་དང་སི་ཁྲོན་གྱི་བོད་གནས་པའི་ཡུལ་གྲུ་ཀུན་ཏུ་ཁྱབ་འདུག་ཅིང་།",
    "མཐར་ཁྲི་འདུས་སྲོང་རང་ཉིད་ཀྱང་འཇང་ལ་ཆབ་སྲིད་མཛད་པར་ཕྱིན་པ་ལས་ཕྱིར་ལོག་པའི་སྐལ་བ་མ་ལྡན་ནོ།",
    "སྔོའི་ཕུང་བོ་ཞིག་ལ་ན་བཟའ་ཇི་ཙམ་ཡོད་པའི་རྒྱ་བསྐྱེད་ནས་བཀབ་འདུག་པ་དང་།",
    "ཙ་ན་ཀའི་རྒྱལ་པོ་ལུགས་ཀྱི་བསྟན་བཅོས།",
    "ལོ་ཆེན་ཡབ་སྲས་ཀྱི་དབོན་པོ་མཁས་པ་ཆེན་པོ་འགྲན་ཟླ་དང་བྲལ་བ་ཞིག་བྱུང་འདུག།",
    "དང་པོ་ས་སྐྱར་རྣམ་འགྲེལ་གྱི་གྲྭ་བསྐོར་ལ་བྱོན་ཙ་ན་འདི་ཙམ་ཞིག་འོང་བའི་ཤས་ཤིག་ཡོད།",
    "ཞེས་མཐའ་དཔྱད་ནས་སྡོམ་ཚིག་བཀོད་འདུག་པ་ནི་བདེན་གཏམ་འབའ་ཞིག་གོ།",
    "རྗེ་ཉིད་མ་བྱོན་ཀྱང་ལུང་དང་འཇའ་སའི་རིགས་ཕུལ་འདུག་འདི་ལས་ཤེས་ཐུབ་པ་ནི།",
    "ལོ་ཙཱ་བེ་རོ་ཙ་ན་འདི",
    "ཨོ་རྒྱན་ང་རང་དངོས་གཅིག་འབྱུང་",
    "རྒྱལ་པོ་བཀའ་ཆེམས་ཆུང་བ་གཅིག་ནས་བེ་རོ་ཙ་ན་ཟུར་ཚོ་བརྒྱུད་དུ་འབྱོན་པར་གསུངས་པ་དེ་ཟུར་ཆེན་ཡིན་པར་མཁས་པ་སེ་སྟོན་གྱིས་མཛད་པའི་ཡིག་ཚང་ལས་ཀྱང་འབྱུང་ངོ།",
    "དེ་ཡང་མི་ལོ་བཅུ་གསུམ་ན་མཇལ་བ་ནི་རྡོར་གླིང་རང་བྱ་ལ་གཤེགས་པའི་བཅུ་གཉིས་སྐོར་རྟིང་མའི་བྱ་དེ་ལ་ཀུན་སྐྱོང་གླིང་པ་འཁྲུངས་པ་དེ་ཡིན་ཅིང་།",
    "དེ་དག་ཀྱང་རང་གཏེར་གབ་རྒྱ་ཅན་གྱི་ལུང་བྱང་ལས།",
    "ད་ལྟ་བལྟས་ན་ངོ་མཚར་བར་འདུག་ཅེས་སྐུ་ཞང་བསོད་རབ་པ་སོགས་དེ་དུས་ཀྱི་རྒྱུས་ཅན་མང་པོ་ལས་ཐོས།",
    "གདུང་བརྒྱུད་འདི་བསྟན་འགྲོ་ལ་ཕན་ཐོགས་པ་ཞིག་ངེས་པར་འོང་བ་འདུག་གསུངས།",
    "རྗེ་ཉིད་ནས་བོན་ལུང་རང་དུ་གདན་འཇགས།",
    "འདི་སྔོན་གྱི་བག་ཆགས་སད་པ་ཞིག་ཡིན་པར་འདུག་ཅེས་གླེང་།",
    "འཕྲལ་དུ་ཡང་རྩབ་ཧྲལ་ཐུག་ཆོམ་ཁོ་ནས་ཐུགས་ཀྱི་ཚེར་མ་སྣ་ཚོགས་པ་བྱས་ཀྱང་གནོད་བྱེད་ལ་ཇི་སྙམ་དུ་ཡང་མི་དགོངས་པར་དེ་རྣམས་ལ་བྱམས་པའི་ཐུགས་རྗེས་ཁྱབ་པར་མཛད་ཅིང་བཞུགས་པ་ན་ཞབས་འབྲིང་པ་དག་འདི་འདྲའི་ཚུར་བརྒལ་ལ་ངན་ལན་མཉམ་དུ་གཞལ་བ་དྲག་གང་བྱས་ཁུར་པ་འདི་ལ་གྱོང་ལས་མི་འདུག་ཞུ་བ་ལ།",
    "ནུས་པའི་ངོ་བོ་ལ་ཁྱད་པར་མི་འདུག།",
    "རིའི་ཉི་ཚོད་སྔ་མའི་ཤུལ་ལས་ཆེར་མ་འཕོས་བར་འདུག་གསུང་དེར་ཞབས་འབྲིང་པ་རྒན་པ་ཆུ་མ་འཕྲོད་པ་དང་།",
    "གུ་རུའི་ཞབས་རྗེས་མཇལ་སྐབས་དེར་སྟག་རྩེ་ཞབས་དྲུང་བཞུགས་འདུག་པའང་མཇལ་ནས་རིམ་པར་དར་གླིང་དུ་ཕེབས།",
    "དེའི་བཞུགས་གྲལ་ཐོག་གཏེར་བཞེས་ཡོད་འདུག་ཚུལ་གྱི་དྲི་བ་ཕེབས་པར།",
    "ཐུགས་སྲས་སྤྲུལ་པའི་སྐུ་ཡང་ལྷ་སར་ཕེབས་འདུག་པ་དང་ཡང་མཇལ།",
    "བཞུགས་སའི་ནུབ་ངོས་ཀྱི་སྐྱ་ལོགས་དེ་ལ་ཐང་སྐུ་ཞིག་བཀྲམ་འདུག་པའི་ཡུལ་བཀོད་ལ་མཆོད་རྟེན་ཞིག་འདུག་པའི་དྲུང་ན།",
    "མཐོང་ཁུང་རང་གར་བྱེད་པ་འདི་མཚར་རོ།",
    "ཟླ་མཇུག་དེར་བསམ་དར་བས་རིམ་གྲོར་སྤྱན་དྲངས་ཏེ་ཁྲོ་རོལ་ཞིག་མཛད་སྤྱན་ལྟས་ཀྱང་ངན་ཞིང་གཏོར་རྒྱག་ཉིན་ཕྱག་དྲིལ་གྱི་ལྕེ་ལྷུངས་པ་དང་ཟོར་མདའ་ལོག་པ་སོགས་བྱུང་བར་སྦྱིན་བདག་དང་ཁྲོམ་པ་ཐམས་ཅད་ཀྱིས་ཧ་རྒོད་བྱས་འདུག་ཀྱང་མི་རིང་བར་ལྟས་སྣང་མངོན་དུ་གྱུར།",
    "གདུང་བརྒྱུད་དྲུང་པ་ཐུགས་རབ་ཆེན་པོ་འདུག་ཁྱེད་ཀྱི་ཡབ་དེ་ཉིད་ཀྱང་བདག་དང་ཐུགས་འདྲིས་ཆེན་པོ་ཡོད།",
    "ཁྱེད་ཀྱི་ཐུགས་རབ་ལ་མི་དོ་བར་འདུག་ཟེར་བསྔགས་བརྗོད་ཆེ་བར་བྱས།",
    "འབྲས་སྤུངས་ཀྱི་འདུ་ཁང་ལ་ཞིག་གསོ་མཛད་འདུག་པར་ལྷག་གནས་ཀྱི་མེ་ཏོག་ཀྱང་འཐོར།",
    "སྦྱིན་སྲེག་དུས་མཐའི་མེ་ཆེན།",
    "ཚེ་འཕེལ་བའི་རྟགས་སུ་འདུག་གསུང་མཉེས་མཉེས་མཛད།",
