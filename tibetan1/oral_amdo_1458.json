    "གསུམ་པོ་མཉམ་དུ་སོང་ལ་ཁྱོད་དང་བསྔགས་ིལྡན་ནི།",
    "ཉེ་བར་འོངས་པས་ཁོ་མོའི་ཡིད་ནི་གཡོས་པར་གྱུར།",
    "ཁོ་མོ་འཕགས་མིན་བརྩེ་མིན་བཤེས་མ་ཡིན་པའི་ལས།",
    "མཆི་མ་མ་འདོན་ཁྱོད་ཀྱི་སེམས་ནི་སིམ་པར་འགྱུར།",
    "ཁྱོད་ཀྱི་མཆི་མ་དང་ནི་ལས་དེ་གཏམ་མ་ཡིན།",
    "ཅི་ལྟ་བ་བཞིན་དོན་བྱེད་ཁྱོད་ཉིད་དང་འགྲོགས་ཤིང་།",
    "སླར་མི་ལྡོག་པའི་ཆེད་དུ་ཇོ་བོ་སྲས་པོ་ཐལ།",
    "ཁྱོད་ཀྱིས་ིང་ལ་འབྲས་བཅས་སེམས་ནི་དགའ་བར་གྱིས།",
    "ངེས་པར་མཛའ་བཤེས་རྣམ་པར་མི་མཁས་ཁྱོད་ཀྱིས་ནི།",
    "བུད་མེད་རྣམས་ནི་ཡུགས་ས་མོ་བཞིན་མཛེས་པ་ཉམས།",
    "མཚན་མོ་སྐྱེ་བོ་གཉིད་ཆེ་རྐུན་པོས་རིན་ཆེན་བཞིན།",
    "བདག་གི་འདི་ལྟར་འདི་ནས་ནོར་རྫས་ཐམས་ཅད་སྟོར་། མགྱོགས་འགྲོ་འདིས་ནི་མདའ་ཡི་རྨ་སྲོལ་བྱུང་རྣམས་ཀྱང་།",
    "འདིས་ནི་ལྕགས་ལྷུང་འཇིགས་ལས་སོང་བ་ཡིན་ནམ་ཅི།",
    "གང་གི་ཚེ་ན་བདག་གི་དགའ་བ་ཕྱི་རོལ་གཤེགས།",
    "དེ་ལྟར་འདིར་ནི་ལྷ་མོའི་སྨྲེ་སྔགས་ལ་བརྟེན་ཞིང་།",
    "འོག་ཏུ་གདོང་ཕྱོགས་མཆི་མ་དང་བཅས་ཐལ་སྦྱར་ཏེ།",
    "ལྷ་མོ་བསྔགས་ལྡན་ལ་ནི་སྨོད་པར་འོས་མིན་ཞིང་།",
    "ཁོ་བོ་ཅག་གི་སྐྱོན་མིན་ལྷ་མོ་མཁྱེན་པར་མཛོད།",
    "བདག་གིས་རྒྱལ་པོའི་བརྟན་པ་ཤེས་པ་ཡིན་ན་ཡང་།",
    "ལྷ་ཉིད་གང་དག་གིས་ནི་སྟོབས་ལས་བྱས་པ་བཞིན།",
    "བདག་གིས་མགྱོགས་འགྲོ་འདི་ནི་ཉེ་བར་འོངས་པ་དེ།",
    "ལམ་ན་ངལ་བ་མེད་པར་དེ་ལྟར་རྗེས་སུ་སོང་།",
    "བར་སྣང་དག་ལ་ིབཟུང་བཞིན་རྨིག་པས་མ་རེག་ཅིང་།",
    "མཚན་མོའི་མུན་པ་ཉི་མས་བཞིན་དུ་བསལ་གྱུར་ཏེ།",
    "དེ་ཕྱིར་དེ་ལྟར་ལྷ་མོ་ངེད་གཉིས་ལ་སྐྱོན་དུ།",
    "ཇི་ལྟར་སོང་བ་དེ་ལ་རྟོག་པར་འོས་མ་ཡིན།",
    "མགྱོགས་འགྲོ་འདི་དང་བདག་གི་འདོད་པ་མི་མཛད་པར།",
    "དེ་ནི་ལྷ་རྣམས་དག་གིས་རྗེས་འགྲོ་བྱས་ཤིང་གཤེགས།",
    "ལྷ་ཡི་མཚར་མང་བུད་མེད་དེ་རྣམས་ཀྱིས་ཐོས་ནས།",
    "མྱ་ངན་རབ་ཏུ་ཉམས་བཞིན་ངོ་མཚར་ལྡན་པར་ཐལ།",
    "རྨོངས་གྱུར་ཉིད་ཀྱང་མཆི་མ་དང་ལྡན་གདོང་གིས་སྨྲས།",
    "དབུས་ན་འཁོར་ལོ་དང་བཅས་ཞབས་ནི་དེ་དག་གིས།",
    "དེ་ནི་ཕ་རོལ་དག་ལ་སློང་མོ་རྒྱུ་འམ་ཅི།",
    "མཚན་མོ་སིལ་སྙན་སྒྲ་རྣམས་དག་གིས་རབ་སློང་བ།",
    "བདག་གི་བརྟུལ་ེཞུགས་ལྡན་དེ་དེ་རིང་ཇི་ལྟར་གཟིམས།",
    "བུད་མེད་དེ་རྣམས་ཕན་ཚུན་ལག་པས་ཡོངས་འཁྱུད་དེ།",
    "དེ་ནས་ངང་པ་མེད་པའི་ངང་མོ་བཞིན་དུ་ནི།",
    "སྐྱེས་རབས།་གི་༡༨༧བདག་ཉིད་ལ་ནི་སྡུད་དང་ཕན་ཚུན་ཕྲག་དོག་ཅིང་།",
    "འཇིགས་མེད་ལྷ་མོ་ལས་ནི་དགའ་བ་ལེན་པར་འདོད།",
    "དེ་ལ་ལུས་ཀྱི་ཡོན་ཏན་བཟུང་བའི་བཙུན་མོ་དེ།",
    "ཅི་འདྲ་ཞིག་གམ་འདི་ནི་བདག་གིས་བསམ་མནོ་སྟེ།",
    "བདག་གི་གུས་པ་ཉིད་དང་བུད་མེད་བོར་ནས་ནི།",
    "ངེས་པར་བདག་གི་འདོད་འདི་མཐོ་རིས་བདེ་ཕྱིར་མིན།",
    "གང་གིས་མ་སྤངས་ཞེས་ནི་བདག་གི་ཡིད་ལ་རེ།",
    "གལ་ཏེ་བདག་ནི་ཇོ་བོའི་གཟིགས་བྱེད་ཡངས་པའི་ཞལ།",
    "ངག་གི་སྐད་གྲག་རབ་ཟོས་༧དགྲ་ཡང་དགའ་བ་ཡི།",
    "བདག་གི་འདོད་པའི་སེམས་ཀྱང་ཤིན་ཏུ་སྲ་བ་སྟེ།",
    "བདེར་འོས་ཇོ་བོ་དཔལ་དོར་ནགས་སུ་སོང་བ་ལ།",
    "མགོན་མེད་ལྡན་པ་གང་ཞིག་དུམ་བུར་མ་སོང་ངོ།",
    "དེ་ལྷར་ལྷ་མོ་བདག་པོའི་མྱ་ངན་གྱིས་བརྒྱལ་ཏེ།",
    "རང་བཞིན་བརྟན་ཡང་དམ་པ་མོ་དེ་མྱ་ངན་གྱིས།",
    "གདོང་གིས་བུད་མེད་རྣམས་ནི་ཆོ་ངེས་འདེབས།",
    "བདེ་སོགས་བདག་པོའི་ལྟད་མོ་ཟིན་པའི་རྒྱལ་མཚན་བཞིན།",
    "ཆབ་ཀྱིས་ིགང་བའི་སྤྱན་གྱིས་མགྱོགས་བགྲོ་ལ་གཟིགས་ནས།",
    "ས་ཡི་ལོགས་ནས་ས་སྐྱོང་གིས་ནི་སྨྲེ་སྔགས་བཏོན།",
    "བསྔགས་ལྡན་ཁྱོད་ཀྱིས་བདག་གི་དགའ་བ་མ་ཡིན་བྱས།",
    "བདག་གི་དགའ་བ་ཡོན་ཏན་དགའ་དེ་གང་གིས་ནི།",
    "དེ་དང་བྲལ་བས་བདག་གི་འཚོ་བ་མེད་པའོ།",
    "སྲས་པོ་ནགས་སུ་སོང་ལ་གང་ཞིག་ལྷར་༧སོང་ལ།",
    "ཁྱོད་ཀྱིས་བདག་གི་ཆུ་ཡི་སྙིམ་པ་དེ་གང་དུ།",
    "དེ་ལ་བདག་གི་སྐོམ་པ་འདིས་ནི་ཡོངས་འདོད་དེ།",
    "བདག་གི་སྲོག་ནི་ཡི་དྭགས་འགྲོ་བར་འདོད།",
    "རཱ་མའི་མྱ་ངན་དག་གིས་ཤིང་རྟ་བཅུ་པ་བཞིན།",
    "ས་ན་མི་སྐྱོང་མང་པོ་ནགས་སུ་ཤིན་ཏུ་སོང་།",
    "སྣ་ཚོགས་མང་པོའི་འཐབ་མོ་དེ་རྙེད་དེར་བྱེད་ཤོག།",
    "དེ་ནས་དེ་གཉིས་ལ་ནི་མི་བདག་གིས་བསླབས་ལ།",
    "ནི་དགའ་བར་རབ་ཏུ་སོང་མ་ཡིན།",
    "མདུན་ན་འདོན་པ་དེ་གཉིས་ནགས་དེར་སོང་བར་གྱུར།",
    "བྱས་ཞེས་གནའ་ིམའི་སྐྱེ་བོ་དང་བཅས་བཙུན་མོར་བཅས།",
    "མི་སྐྱོང་གིས་ཀྱང་བྱ་བ་ལྷག་མ་རབ་ཏུ་མཛད།",
    "བསམ་པ་བཟང་པོས་སྐྱེན་པར་ནགས་དེར་སོང་བར་གྱུར།",
    "དྲང་སྲོང་ཤེས་ལྡན་བུ་ཡི་ཁང་པར་ཉེ་བར་སོང་།",
    "དེ་དག་གིས་ནི་ཚུལ་བཞིན་བྲམ་ཟེ་དེ་མཆོད་ནས།",
    "ནག་པོར་སྐྱེ་བོ་འདི་ནི་ཁྱོད་ཀྱིས་རིག་༧ པར་མཛོད།",
    "སྐྱེས་རབས། གི་༡༨༧རབ་ཏུ་ཐོབ་གྱུར་གཞོན་ནུ་ཤེས་པ་མིན་པ་མིན།",
    "དེ་ཉིད་གང་ནས་གཤེགས་པ་དེ་ནས་རབ་ཏུ་སོང་།",
    "སོང་སྟེ་དེ་ནས་དེ་དག་གི་ནི་རྔོན་པ་དང་།",
    "ལམ་ནི་ཤིང་གི་རྩ་བར་ཉེ་བར་བཞུགས་པ་མཐོང་།",
    "ཉེ་ལོགས་དག་ཏུ་སོང་བ་རྣམ་པར་མཛེས་པར་གྱུར།",
    "གཞོན་ནུ་མིག་གི་ཆུ་ཡི་ཆར་ལྟར་རྒྱལ་པོ་ཡིས།",
    "གང་ཞིག་ཁྱོད་ལ་སྨྲས་པ་འདི་ནི་མཁྱེན་པར་མཛོད།",
    "ཁྱོད་ཀྱི་དུས་མ་ཡིན་པར་ནགས་སུ་བསྙེན་ལས་བདག།",
    "དེ་ཕྱིར་རེ་ཞིག་ནོར་འཛིན་བདག་ཉིད་ལོངས་སྤྱོད་ལ།",
    "ནགས་དང་སྟག་ནི་འཇིགས་པ་དག་གི་མཚན་མའོ།",
    "དཔུང་རྒྱན་རྣམ་པར་རེངས་པའི་ཕྱག་མངའ་མི་དབབ་རྣམས།",
    "གི་༡༨༧ནོར་གྱི་བདག་པོ་དང་ནི་མི་སྐྱོང་དཔལ་དག་སྟེ།",
    "དེ་ལྟར་མཆི་མས་འདུད་པའི་ཡི་གེའི་ཚིག་གིས་ནི།",
    "ཁྱོད་ལས་བྱུང་བའི་མྱ་ངན་ཆུ་ནི་གཏིང་མེད་པའི།",
    "དྲང་སྲོང་རི་བྱི་བསྙེན་ཞིང་ཕྱོགས་སུ་མ་སོང་བ།",
    "ཡང་དག་སྐྱེད་པར་བྱེད་པའི་ལྷ་མོ་མཁྱེན་པར་མཛོད།",
    "ངང་པ་རྣམ་པར་བྲལ་བའི་ངང་མོ་ལྟ་བུ་དང་།",
    "ནགས་ན་གླང་པོ་དང་བྲལ་གླང་མོ་ལྟ་བུ་ནི།",
    "བཙུན་མོ་གཟིགས་པ་ཡིས་ནི་སྐྱོབ་པར་འོས་པ་ཡིན།",
    "ཁྱེད་དང་བྲལ་བའི་བུད་ཤིང་ཅན་གྱི་མྱ་ངན་མེ།",
    "ཕྱིར་འབྱུང་དབུགས་ནི་དུ་བ་མུན་པའི་རྩེ་མོ་ཡིས།",
    "གང་ཞིག་བདག་ལ་ས་སྐྱོང་གི་ནི་ཁྱད་པར་དུ།",
    "འཇིགས་ཏེ་ནགས་སུ་ཕྱིན་ནས་རང་གི་སྐྱེ་བོ་དོར།",
    "རང་གི་སྐྱེ་བོ་དགའ་བ་ལྟ་འདོད་ཅིས་མ་ཡིན།",
    "གང་ཡང་བདག་གི་ཆེད་དུ་མི་ཡི་བདག་པོ་ཡི།",
    "མྱ་ངན་ཁྱོད་ཀྱིས་སྨྲས་དེས་བདག་ལ་དགའ་བ་མེད།",
    "དེ་བཞིན་དུ་ཡང་ཁྱོད་ཀྱི་བློ་གྲོས་ངེས་པར་སོང་།",
    "གཞན་དུ་རང་གི་སྐྱེ་བོ་དོར་ནས་འདིར་འོངས་ལ།",
    "དེར་སོང་ནས་ཀྱང་ཕ་རོལ་གཞན་དུ་འགྲོ་འགྱུར་ལ།",
    "གི་༡༨༧གང་ཚེ་མངལ་ནས་བཟུང་སྟེ་གནས་སྐབས་ཐམས་ཅད་དུ།",
    "བདག་གི་ནགས་སུ་བརྟེན་པ་གང་ཕྱིར་དུས་མ་ཡིན།",
    "བདག་གིས་རབ་ཏུ་འཛིན་པར་ནུས་པ་མ་ཡིན་ནོ།",
    "རྒྱལ་སྲིད་དང་ནི་གསེར་དག་སྡུག་བསྔལ་དག་གི་རྟེན།",
    "རྒྱལ་སྲིད་ངེས་པར་དོར་ནས་ནགས་སུ་སོང་བར་གྱུར།",
    "རིགས་སུ་སྐྱེས་ཤིང་སེམས་པ་དང་བཅས་མི་གང་གིས།",
    "རེ་འདོད་སྤངས་ཤིང་གཏན་ཚིགས་ལྡན་པ་སྒྲོགས་པ་སྟེ།",
    "མངལ་དུ་སོང་བའི་ངོ་བོ་ངེས་པར་སྒྲུབ་བྱེད་ལ།",
    "ཁ་ཅིག་བདག་གི་མཚན་མ་ཉིད་དུ་སྨྲ་བ་སྟེ།",
    "སྐྱེས་རབས། གི་",
    "ཁྱོད་ཀྱི་སྐྱོན་གྱི་བློ་གྲོས་གང་ཞིག་རབ་ཞུགས་ཏེ།",
    "སྔ་མ་རྣམས་ཀྱང་ནགས་ནས་རང་གི་ཁང་པར་གཤེགས་། དཀའ་ཐུབ་ནགས་ན་གནས་པ་བུ་རྣམས་ཀྱིས་བསྐོར་ཏེ།",
    "རྒྱལ་པོ་ཨ་མ་༧ རི་ཥ་གྲོང་དུ་ཞུགས་གྱུར་ལ།",
    "ནགས་རྣམས་བོར་ནས་ཁང་ཁྱིམ་རྣམས་སུ་སོང་བ་སྟེ།",
    "གཞན་གྱི་ཚིག་གིས་བདག་ལ་འདི་ན་ངེས་པ་མེད།",
    "ལྟ་བ་དག་ནི་ལེན་པར་བདག་གིས་ནུས་མ་ཡིན།",
    "ཁྱིམ་ལ་འཇུག་པར་དམིགས་གང་བདག་ལ་ཁྱོད་ཀྱིས་ནི།",
    "གཏི་མུག་བཞིན་ིལྡན་རྗེས་སུ་སོང་ནས་སྡུག་བསྔལ་བ།",
    "དེ་དག་ལྟོས་བྱས་རབ་ཏུ་སོང་ཞིང་གནས་གྱུར་ལ།",
    "མཆོག་ཏུ་གཤེགས་ཏེ་གཤེགས་པ་ཤེས་ཕྱིར་དེ་དག་གིས།",
    "གི་༡༨༧ནས་། དགའ་ཞིང་སྲས་པོ་འདོད་པའི་རྒྱལ་པོ་ལ་སོང་ནས།",
    "ཇི་ལྟར་བལྟའམ་ཞེས་ནི་ཇི་ལྟར་ཡང་སོང་ངོ།",
    "རི་རྣམས་དག་གིས་ལེགས་པར་སྦས་དང་བརྒྱན་པ་དང་།",
    "ཟབ་མོར་གྱུར་པའི་མདངས་དར་དེ་ཡི་ལུགས་གསལ་བ།",
    "དེ་རབ་མཐོང་ནས་གཞན་གང་མ་སོང་དེ་གནས་ཤིང་།",
    "གང་ཞིག་སྐྱེན་པོར་སོང་སྟེ་བརྟན་པོར་སོང་གྱུར་ལ།",
    "ཁ་ཅིག་དེ་ལ་རབ་ཏུ་མཆོད་ནས་སོང་བར་གྱུར།",
    "རབ་བཀྲམ་ཚིག་ནི་ལམ་དུ་སྨྲ་བ་མེད་པར་སོང་།",
    "མཆོད་མང་བཀུར་སྟི་སྔོན་འགྲོ་བུད་མེད་རྣམས་ཀྱི་འམ།",
    "གང་གིས་དེ་ཡི་གང་ཉིད་དེར་ནི་མཐོང་གྱུར་པ།",
    "དེ་ནི་གང་དུ་སོང་ཞེས་རྣམ་པར་ཤེས་པར་མཛོད།",
    "དེ་ནས་དེ་ལྟར་བགྱི་ཞེས་སྐྱེས་བུ་རྗེས་སུ་སོང་།",
    "གཡོ་མི་སྤྱན་ནི་གཉའ་ཤིང་གང་ཙམ་གཟིགས་པ་སྟེ།",
    "གསུང་ནི་ཀུན་ནས་སྙོམས་ཤིང་ཟབ་མོའི་འགྲོས་མངའ་བ།",
    "སྐྱེས་རབས། གི་",
    "དེར་ནི་སྦས་པའི་རྗེས་སུ་འབྲང་བས་རབ་ཏུ་སོང་།",
    "དེ་ནས་དེ་ཡི་སྟེང་ན་རྩེ་མོར་གྱུར་པ་ཡི།",
    "རི་བོང་གིས་མཚན་སྤྲིན་གྱི་སྦུབས་ནས་བྱུང་བ་བཞིན།",
    "སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་ནས་རྣམ་པར་མཛེས་པ་མཐོང་།",
    "ཁམས་མཉམ་གྱུར་པ་དེ་ལ་སོང་ནས་དྲིས་པ་སྟེ།",
    "གང་ཕྱིར་བདག་ལ་རང་གི་ན་ཚོད་སྨྲ་འདོད་པ།",
    "ཁྱོད་ཀྱི་རིགས་ནི་རྣམ་རྒྱས་སྔོན་དུ་ཉི་མ་སྟེ།",
    "གང་ཕྱིར་འདི་ནི་ཁྱོད་ཀྱི་བློ་གྲོས་རིམ་མེད་པས།",
    "སློང་མོ་ཉིད་ལ་མངོན་དགའ་རྒྱལ་སྲིད་ལ་མ་ཡིན།",
    "ཁྱོད་ཀྱི་ལུས་འདི་ཙནྡན་དམར་པོ་འོས་པ་སྟེ།",
    "ངུར་སྨྲིག་གིས་དཀྲིས་དེ་ནི་འོས་པ་མ་ཡིན་ནོ།",
    "ཁྱོད་ཀྱི་ཡབ་ཀྱི་བརྩེ་ལས་སྟོབས་ཀྱིས་མི་འདོད་ཅིང་།",
    "ཁྱོད་ཀྱི་བློ་གྲོས་རིམ་པར་བཟོད་པར་མ་གྱུར་ན།",
    "དེ་ལྟ་ན་ནི་རང་གི་སྐྱེ་ལ་གནོད་མིན་ཞིང་།",
    "དེ་ཕྱིར་ཁྱོད་ཀྱིས་བདག་ལ་བརྩེ་བ་མཛོད་ཅིག་དང་།",
    "བདག་ཅག་རྣམས་ལ་ཁྱོད་ལ་བློ་གཏད་ཡོན་ཏན་མེད།",
    "སྐྱེས་རབས། གི་",
    "ཁྱོད་ཀྱིས་གཟུགས་འདི་འབྲས་བུ་བཅས་པ་ཉིད་དུ་མཛོད།",
    "མི་རྣམས་དག་གིས་དམན་མིན་སྐྱེས་བུའི་དོན་དུ་སྨྲ།",
    "བརྩེ་བས་ངེས་པར་དེ་ནི་བདག་གིས་སྨྲ་བ་སྟེ།",
    "ཁྱོད་ཀྱིས་དགེ་སློང་ཉིད་ཀྱི་ཆ་ལུགས་འདི་མཐོང་ནས།",
    "དེ་ཕྱིར་རང་རིགས་རབ་མཚུངས་ཁྱོད་ཀྱི་གཟུགས་ཇི་སྲིད།",
    "སློང་མོའི་གནས་འདོད་འདོད་པ་རྣམས་ལ་ལོངས་སྤྱོད་ལ།",
    "རྣམ་པར་འགལ་བར་གྱུར་པ་ཡིན་ཕྱིར་ལང་ཚོ་རྣམས།",
    "ཤིན་ཏུ་བརྟན་པའི་གནས་སྐབས་མཆོག་ཏུ་སོང་བ་རྣམས།",
    "ངོ་ཚ་བ་ཉིད་ཕྱིར་དང་སོང་བ་མ་ཡིན་ཕྱིར།",
    "གཡོ་སྒྱུ་མང་པོའི་ལང་ཚོ་ཤིན་ཏུ་འདས་ནས་སོ།",
    "ན་ཚོད་གསར་པ་འདི་ནི་རེ་ཞིག་རྣམ་པར་འོང་།",
    "བཟོ་སྦྱངས་སྔོན་དུ་སོང་བའི་ལེའུ་སྟེ་བཅུ་པའོ།",
    "གང་ཕྱིར་བཤེས་གཉེན་ཕྱོགས་སུ་གཤེགས་འདོད་ཁྱོད་ཀྱི་ནི།",
    "གི་༡༨༧ཡོངས་སུ་དག་པའི་སྤྱོད་པས་སྤྱོད་པ་དེ་ཡིན་ནོ།",
    "དོན་ནི་དཀའ་བ་རྣམས་སུ་མི་རྣམས་གང་ཞིག་གིས།",
    "རང་གནས་དག་ནི་འཕེལ་བར་གང་གི་ཕྱིར་མ་ཡིན།",
    "དེ་ལྟར་གང་གིས་རྫས་དག་ཐོབ་ནས་འཇིག་རྟེན་ན།",
    "ཁྱོད་ཀྱི་ངེས་པ་གང་ཞིག་བདག་ལ་དམིགས་པ་འདི།",
    "རྒོལ་བ་གཞན་མིན་འདིར་ནི་བདག་གིས་སྨྲ་བར་བགྱི།",
    "བདག་གིས་རྒ་དང་འཆི་བའི་འཇིགས་པ་རྣམ་རིག་ནས།",
    "ཡུལ་རྣམས་ལ་ནི་ངོམས་མེད་ཉམས་པར་སོང་བར་གྱུར།",
    "གང་གིས་དོན་གཞན་མ་ཡིན་ཐུབ་པ་ཡང་ཉམས་ཏེ།",
    "སྐྱེས་རབས། གི་",
    "ཞིང་གི་ལས་ལ་སོགས་པ་རྣམས་ཀྱིས་ཉམ་ཐག་ཅིང་།",
    "གང་གིས་ཟད་ཅིང་ངན་འགྲོར་ཉེ་བར་འགྲོ་བར་འགྱུར།",
    "གང་གི་རྒྱལ་པོ་རྐུན་པོ་ཆུ་དང་མེ་རྣམས་ལས།",
    "ཐུན་མོང་གྱུར་པ་ཉིད་ཕྱིར་སྡུག་བསྔལ་སྲེད་བྱེད་དེ།",
