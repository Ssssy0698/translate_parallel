    "ཁ་ལ་སྟན་ལ་མ་བརྟགས་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་མི་བྱ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "མཐོང་བ་མི་འཇུག་པས་དེ་སྟན་དེ་ཉིད་ལ་གྱ་ཚོམ་དུ་འདུག་པ་དང་།",
    "ཉེས་པ་ནི་སྟན་ལ་མ་བརྟགས་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་མི་བྱ་བར་བསླབ་པར་བྱའོ།",
    "འདུག་པ་ཉིད་དོ།",
    "ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་མི་དབབ་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "གལ་ཏེ་ཁྲིའུ་མི་སྟེར་ན་ཁྲིའུ་འདི་བཅག་པར་བྱའོ་སྙམ་ནས་དེས་ཞོའི་ཁམ་ཕོར་དང་ཕྱེའི་ཁམ་ཕོར་དེ་གཉིས་འགྲེང་སྟེ་བླངས་ནས་ཁྲིའུ་དེ་ཉིད་ལ་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་ིཕབ་སྟེ་འདུག་པར་བརྩམས་པ་དང་།",
    "ཉེས་པ་ནི་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་ཕབ་སྟེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "ཏྲིགས་ཞེས་འདུག་པར་མི་བྱ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ལུས་ཐམས་ཅད་ཀྱི་ལྗིད་ཀྱིས་འབེབས་པ་དང་འདུག་པ་ཉིད་དོ།",
    "འོ་ལ་ཀ་རྐང་པ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "རྐང་པ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་རྐང་པ་བསྣོལ་ཏེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་རྐང་པ་མི་བསྣོལ་བ་ཞེས་བྱ་བ་ནི་རྐང་པའི་སྟེང་དུ་རྐང་པ་བཞག་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་རྐང་པ་བསྣོལ་བ་དང་འདུག་པ་ཉིད་དོ།",
    "སྔ་མ་བཞིན་དུ་བརླ་མི་བསྣོལ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་བརླ་བསྣོལ་ཏེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་བརླ་མི་བསྣོལ་བ་ཞེས་བྱ་བ་ནི་བརླའི་སྟེང་དུ་བརླ་བཞག་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "འདིའི་བྱེད་པ་པོ་ནི་བརླ་བསྣོལ་བ་དང་འདུག་པ་ཉིད་དོ།",
    "དེ་ལ་དེ་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་མི་བཞག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ལོང་བུའི་སྟེང་དུ་ལོང་བུ་མི་བཞག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་བཞག་སྟེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་ལོང་བུ་མི་གཞག་པར་ཞེས་བྱ་བ་ནི་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་གཞག་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་ལོང་བུའི་སྟེང་དུ་ལོང་བུ་གཞག་པ་དང་འདུག་པ་ཉིད་དོ།",
    "ཎརྐང་པ་མི་དགུག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "བཅོམ་ལྡན་འདས་ཀྱིས་སྔ་མ་བཞིན་དུ་རྐང་པ་མི་དགུག་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་རྐང་པ་དགུག་སྟེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "དེ་ལ་རྐང་པ་མི་དགུག་པར་ཞེས་བྱ་བ་ནི་རྐང་པ་གཉིས་འགབ་ཀུང་དུ་བཞག་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་རྐང་པ་བཀུག་པ་དང་འདུག་པ་ཉིད་དོ།",
    "རྐང་པ་མི་གདང་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "ཉེས་པ་ནི་རྐང་པ་གདངས་ཏེ་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པའོ།",
    "རྐང་པ་གཉིས་བར་དག་སོ་སོར་ཕྱེ་སྟེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "འདིའི་བྱེད་པ་པོ་ནི་རྐང་པ་གདངས་པ་དང་འདུག་པ་ཉིད་དོ།",
    "ཡང་ན་ཐམས་ཅད་ཀྱང་རུང་བ་ཐད་ཀར་གདངས་ཏེ་འདུག་པར་མི་བྱ་བ་སྟེ།",
    "དེ་ལྟར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "མ་བསྒོ་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་མི་འདུག་པར་བསླབ་པར་བྱ་བ་མན་ཆད་འདི་ཡན་ཆད་ཐམས་ཅད་ནི་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱ་བའི་སྤྲོས་པ་ཡིན་པར་སྦྱར་རོ།",
    "སྟན་ལ་འདུག་པའི་རིམ་པ་བཞིན་དུ་མཐར་ཆགས་སུ་ཟས་བླང་བར་བྱ་སྟེ།",
    "ཁྱིམ་བདག་དེས་ཐོས་ནས་དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དེ་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "ཁའི་དབུགས་ཀྱིས་བསྒྲུངས་ཏེ་བཟའ་འོ་། ཁྱིམ་བདག་དེས་༧ ཐོས་ནས་སྐྱེངས་ཏེ་ཅང་མི་སྨྲ་བར་འདུག་པའི་སྐབས་དེ་དགེ་སློང་རྣམས་ཀྱིས་བཅོམ་ལྡན་འདས་ལ་གསོལ་པ་དང་།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བསླབ་པར་བྱ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་དག་ཡིན་ནོ།",
    "དྲུང་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་མཚོན་པ་ཙམ་དུ་ཟད་དེ།",
    "ཐག་རིང་པོར་འདུག་པ་ཡང་འདིར་བསྡུས་པར་རིག་པར་བྱའོ།",
    "དགོས་༧༥ ༥བ་དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་མི་གཏོར་བ་ཞེས་བྱ་བ་ནི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུས་གཏོར་བར་མི་བྱ་བ་སྟེ།",
    "འདིར་ཡང་དྲུང་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་མཚོན་པ་ཙམ་དུ་ཟད་དོ།",
    "ཀུན་ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པ་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱ་བའི་གླེང་གཞི་ནི།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བར་བསླབ་པར་བྱའོ་ཞེས་བཅའ་བ་མཛད་དེ།",
    "དེ་ལ་ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་གཞན་དུ་མི་དབོ་བ་ཞེས་བྱ་བ་ནི།",
    "མཉན་ཡོད་ན་བྲམ་ཟེ་ཞིག་འདུག་པ་དེའི་བུ་ན་བར་གྱུར་ནས།",
    "བཞོན་པའི་སྟེང་དུ་འདུག་པ་དང་།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "འདིར་སྟན་ཞེས་བྱ་བ་ནི་འདུག་པའི་ས་ཕྱོགས་ཀྱང་གཟུང་བར་རིག་པར་བྱའོ།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "བཞོན་པའི་སྟེང་ན་འདུག་པ་དང་།",
    "དེས་ིལག་པ་འགྲམ་པ་ལ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་དང་།",
    "སེམས་ཁོང་དུ་ཆུད་དེ་འདུག་པ་དང་།",
    "དེ་ལྗོན་ཤིང་དེ་ལས་བབས་ཏེ་འདུག་གོ།",
    "དགེ་སློང་དེ་ཤིང་ལྗོན་པ་ལ་མི་གང་ཙམ་དུ་འཛེགས་ཏེ་འདུག་པ་དང་།",
    "དེར་སྟན་ལ་འདུག་པ་དང་།",
    "འདུག་པ་དང་།",
    "བྱང་ར་༡ ༣འདུན་ཐམས་ཅད་འདུག་ཅིང་མཐུན་པར་གྱུར་པ་ན།",
    "མཆིལ་ལྷམ་གཉིས་ཕུད་ནས་རྒན་པའི་མཐའ་ལོགས་སུ་ཙོག་པུར་འདུག་སྟེ།",
    "མཆིལ་ལྷམ་གཉིས་ཕུད་ནས་རྒན་པའི་མཐའ་ལོགས་སུ་ཙོག་པུར་འདུག་སྟེ།",
    "འདུག་པ་དང་།",
    "འདུག་པར་ཡང་མི་འཚལ།",
    "འདུག་པ་ཡང་མི་འཚལ།",
    "དགེ་སློང་རང་བཞིན་དུ་གནས་པ་དང་ལྷན་ཅིག་གོམ་པ་བསྲི་ིབ་ཉིད་ལས་གཞན་པས་བཅག་པར་མི་བྱའོ།",
    "སྟན་ཆེས་དམའ་བ་ཉིད་ལས་གཞན་ལ་འདུག་པར་མི་བྱའོ།",
    "དེའི་འདུག་པ་ལ་སོགས་པ་ནི་བསྙེན་པར་རྫོགས་པ་ཐམས་ཅད་ཀྱི་མཐའ་ཉིད་དུའོ།",
    "དེའི་ངོ་བོ་ཉིད་ཚོལ་དུ་གཞུག་པ་བྱིན་པས་དགེ་སློང་རང་བཞིན་དུ་གནས་པ་ཉིད་མ་ཡིན་པ་དང་།",
    "ཁྱི་པེ་སྣར་འདུག་ན་ག་ཞི་༧ པེ་སྣར་ཟེ།",
    "མཆིལ་ལྷམ་གཉིས་ཕུད་ལ་ཅི་རིགས་སུ་བྱས་ནས་ཙོག་ཙོག་པོར་འདུག་སྟེ།",
    "ས་ལ་འདུག་པས་ནམ་མཁའ་ལ་འདུག་པ་ལའམ།",
    "བཤེས་པ་མེད་ན་མི་སྨྲ་བར་འདུག་པར་བྱའོ།"
