    "ཡང་ན་དོན་དག་ག་གེ་མོ་ཞེས་སྤྱི་བམ་ཙམ་ཞིག་བརྗོད་པ་ཡིན་ན་དེ་ནི་ས་སྟོང་ལ་བོའུ་སྟོང་དང་གཟུགས་བརྙན་གྱི་འབེན་ལ་བརྒྱབ་པ་ཁོ་ན་ཙམ་རེད།",
    "ཁྱེད་ཀྱིས་བལྟས་ན་དེང་སང་བོད་དུ་རིགས་གཞུང་གི་རྨང་གཞི་མཐུག་པ་དང་ལྷག་བསམ་རྣམ་དག་ཅན་གྱི་དཔྱད་བརྗོད་པ་ག་ཚོད་ཡོད་པ་རེད་དམ།",
    "རིགས་གཞུང་ཞིབ་འཇུག་གི་རྨང་གཞིའང་བརྟན་པོ་ཞིག་ཡོད་པ་རེད།",
    "བླངས་ཡོད་པ་ཞིག་རེད།",
    "གཞན་ཡང་དགའ་འོས་པ་ཞིག་ལ་ཉེ་བའི་ལོ་འགའི་རིང་ལ་བོད་དུ་འབོལ་རྩོམ་འབྲི་བའི་མཐོ་རླབས་ཤིག་འཕྱུར་འདུག་ན་གཞོན་རྣམས་ཀྱི་ཁྲོད་ན་འབོལ་རྩོམ་ལ་འཇུག་མཁན་མང་པོ་ཡོད་གི་ངས་བལྟས་ན་འདི་ནི་བཟང་ལྟས་ཤིག་རེད་སྙམ།",
    "རེད།",
    "ཁྱེད་ཀྱིས་བལྟས་ན་བོད་ཀྱི་རྩོམ་རིག་དཔྱད་བརྗོད་ཀྱི་ཁ་ཕྱོགས་འདི་ཇི་ལྟར་སོང་ན་ད་གཟོད་མཁས་བརྒྱ་འགྲན་གླེང་དང་མེ་ཏོག་མཉམ་བཞད་ཀྱི་དྲང་གཏམ་བརྗོད་པའི་སྤོབས་པ།",
    "འུ་ཅག་གི་རྩོམ་པ་པོ་རྣམས་ལ་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "དཀའ་སྡུག་གི་འདུ་ཤེས་མེད་པ་དང་།",
    "དེང་རབས་རིང་ལུགས་ཀྱི་རྩོམ་རིག་ལ་དགའ་བའི་རྩོམ་པ་པོ་མི་ཉུང་བ་ཞིག་ལ་མཚོན་ནའང་ཐབས་རྩལ་དེ་གཙོ་བོར་བཟུང་ནས་རང་གི་སྲོག་བོར་ཡོད་མཁན་ཡང་ཧ་ཅང་མང་གི་རྒྱུའི་ན་གཞོན་རྩོམ་རིག་དཔྱད་བརྗོད་མཁན་ཧོ་ཞུང་ཧྥེ་ལགས་ཀྱིས།",
    "རྩོམ་རིག་གི་ཐབས་རྩལ་ནི་ཇི་ལྟར་ཁྱད་དུ་འཕགས་ན།",
    "འུ་ཅག་གི་མི་གཞི་དམའ་འབེབ་དང་མི་གཞི་ཁྱད་གསོད་བྱེད་པའི་སྣང་ཚུལ་འདི་དང་།",
    "ཐང་མ་བརྡལ་བའི་རྩོམ་རིག་གི་སྣང་ཚུལ་འདི་མེད་པ་བཟོ་དགོས་ན།",
    "ལྟོ་སྐྱ་གོས་ཧྲུལ་གྱི་འཚོ་བ་ངན་ངོན་འདི་ལ་ངེས་ཤེས་ཟབ་མོ་ཞིག་སྐྱེ་དགོས་གི་དུས་དང་རྣམ་པ་ཀུན་ཏུ་བོད་རང་གི་ཞིང་ས་དེ་འབོར་མི་ཉན་གི་འདི་ནི་དེ་རིང་གི་གླེང་མོལ་འདིའི་གཞི་འབབ་ས་གཙོ་བོའང་ཡིན།",
    "ཉེ་བའི་ལོ་འདི་འགར་དུས་རབས་ཀྱི་འཕེལ་ཕྱོགས་དང་བསྟུན་ནས་འུ་ཅག་གིས་ཀྱང་བརྡ་འཕྲིན་དུས་རབས་ཀྱི་བག་མ་དེ་བསུ་འགོ་བརྩམས་ཤིང་།",
    "ཡང་ན་ཆེ་བ་རྒྱལ་ཁབ་ཀྱི་སྲིད་དོན་ནས་ཆུང་བ་མི་སྒེར་གྱི་དོན་ཆུང་བར་དུ་ཡང་གླེང་ཆོག་པ་རེད།",
    "བསམ་གཞིག་བཅས་ཀྱི་སྒོ་གླེགས་གསར་པ་ཞིག་ཀྱང་ཕྱེ་ཡོད་པ་རེད།",
    "དོན་གྲུབ་རྒྱལ་ལ་མི་རིགས་ཀྱི་དཔའ་བོ་དང་རྩོམ་རིག་གསར་པའི་ཤིང་རྟའི་སྲོལ་འབྱེད་པ་གངས་ལྗོངས་ཀྱི་མར་མེ་ཚེ་འབར་སོགས་ཀྱི་ཆོ་ལོ་སྩོལ་གྱིན་འདུག་ཡང་ཁོང་གཉིས་ལ་མི་དགའ་མཁན་དག་གིས་ཚིག་མཚོན་གྱི་མདའ་མོ་ཆར་བ་བཞིན་དུ་འབེབ་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "བཞིན་འདུག་དགའ་བ་རྣམས་ཀྱིས་ལུས་ངག་ཡིད་གསུམ་གྱིས་དང་རྟེན་དུ་བཀུར་བ་དང་མི་དགའ་བ་རྣམས་ཀྱིས་མཆིལ་ཞགས་འཕངས་ཏེ་སྐུར་འདེབས་བྱེད་པའི་སྣང་ཚུལ་འདི་ལ་འུ་ཅག་གིས་ངེས་པར་དུ་བསམ་གཞིག་གཏོང་རྒྱུ་འདུག་སྟེ།",
    "དོན་གྲུབ་རྒྱལ་ལ་ལད་ཟློས་བྱས་ན་བོད་མི་རིགས་ཀྱི་འགྲོ་ལམ་ཇེ་དོག་རེད།",
    "ཡང་ན་ཕ་བསད་ན་རྒྱལ་རྔ་རྡུང་མཁན་བླུན་པོ་དག་གི་རྗེས་སུ་འབྲང་དགོས་པ་ཡིན།",
    "དོན་གྲུབ་རྒྱལ་ལགས་ཀྱིས་ཁོང་གི་སྐུ་ཚེ་ཐུང་ཐུང་གི་རིང་ལ་རང་མི་རིགས་འདི་སྲོལ་རྒྱུན་གྱི་རྐང་ལམ་ཕྲ་མོ་ནས་དེང་རབས་ཀྱི་གཞུང་ལམ་ཆེན་མོའི་སྟེང་དུ་བགྲོད་པར་ཧུར་བརྩོན་ཆེན་པོ་བྱས་པ་དང་།",
    "དེའི་ཆེད་དུ་རང་གི་ཚེ་སྲོག་ཀྱང་ཕུལ་ཟིན་ན།",
    "ད་དུང་དོན་གྲུབ་རྒྱལ་ལ་ལད་ཟློས་བྱས་ན་བོད་མི་རིགས་ཀྱི་འགྲོ་ལམ་ཇེ་དོག་ཇེ་དོག་རེད་ཟེར།",
    "ཁོ་ཚོ་དུ་ཆང་དང་བུད་མེད་ཀྱི་ཆེད་དུ་ཤི་ན་མི་རིགས་ཀྱི་དོན་དུ་ཚེ་སྲོག་འདོར་ཐུབ་པའི་སྐྱེས་ཆེན་ཡིན་ནམ།",
    "བོད་མི་ཡོངས་ཀྱི་ཁ་གཏད་དུ་ལངས་པ་རེད།",
    "ཁོ་ནི་དོན་དངོས་གཞིར་འཛིན་མི་ཤེས་པའི་སྟོང་བསམ་རིང་ལུགས་པ་ཞིག་རེད།",
    "བུད་མེད་མི་འདོད་སྐྱེས་པ་སུ་ཞིག་མཆིས།",
    "སྐྱེས་པ་མི་འདོད་བུད་མེད་སུ་ཞིག་མཆིས།",
    "འདི་ནི་མི་བུའི་ལྷན་སྐྱེས་ཀྱི་འདོད་པ་དང་མི་བུའི་རང་བཞིན་དེ་ལ་ཡིན་འཇོག་བྱས་པ་ཞིག་རེད།",
    "བསྒྱུར་ཏུ་བཏུབ་ཀྱང་སྤང་དུ་མེད་པ་ལགས་ཞེས་ཀྱང་ཐལ་ལོ།",
    "གཟུགས་ཀྱི་ནང་ན་མཛེས་པའི་མཐར་ཐུག་པ་ནི་སྐྱེས་པའི་མིག་ལ་བུད་མེད་གཟུགས་མིན་པ་དང་།",
    "སྒྲ་ཡི་ནང་ན་སྙན་པའི་མཐར་ཐུག་པ་ནི་སྐྱེས་པའི་རྣ་བར་བུད་མེད་སྒྲ་མིན་ཞེས་སུས་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "གང་ཡང་བྱུང་མ་སོང་།",
    "བདག་གི་ནོར་འཁྲུལ་ཞིག་ཏུ་བརྩི་ནའང་ཐང་མོད།",
    "གལ་སྲིད་ཁྱེད་ཀྱིས་སེམས་རྣལ་ལ་ཕབ་སྟེ་ཁོ་བོའི་ཤི་རྐྱེན་འདིར་ཞིབ་འདང་རེ་བརྒྱབ་ཚེ།",
    "མྱུར་དུ་ལས་གནས་སྤོར་བའི་བརྡ་ཡིག་ཅིག་འབྱོར་བར་རེ་བ་ཆེ་བས་ཡིན།",
    "ངས་བསམ་གཞིག་ཞིབ་མོ་ཞིག་བཏང་བ་ན།",
    "ཕམ་ཁ་ནི་རང་གིས་ཉོ་དགོས་བྱུང་རྐྱེན།",
    "མི་སུ་ཞིག་ཡིན་རུང་གཞན་གྱི་ལྟ་ཚུལ་ལ་མི་འཐད་ཚེ་དེ་ལ་དོགས་སློང་དང་དགག་སྒྲུབ་ནི་བྱེད་ཆོག་ཆོག་ཡིན་པ་རེད།",
    "རང་གི་ནུས་པས་སྲི་ཞུ་ཅུང་ཟད་སྒྲུབ་ཡོད་པ་རེད།",
    "དམ་ཚིག་སྲུང་གི་འདུག་གམ།",
    "གསར་གཏོད་ཀྱི་སྤོབས་པས་ཕྱུག་པས་རེད།",
    "མདུན་སྐྱོད་ཀྱི་བློ་སྤོབས་མངའ་བས་རེད།",
    "ལང་ཚོའི་རྦབ་ཆུ་རུ་མཚར་སྡུག་འོད་སྟོང་འབར་བའི་སྔོན་ཆད་ཀྱིས་ད་ལྟའི་ཚབ་བྱེད་མི་རུང་ལ།",
    "བ་ཚྭའི་དྲི་དང་འགྲོགས་པའི་ཁ་སང་གིས་དེ་རིང་གི་སྐོམ་པ་ག་ལ་སོད།",
    "བླུན་རྨོངས་བཅས་ཀྱི་མིང་ངན་བཏགས་བྱུང་བ་རེད།",
    "རྨོངས་འཐོམ་དང་རྗེས་ལུས་སོགས་དང་ཁ་གཏད་དུ་འགྲེང་བ་ཞིག་རེད།",
    "ལྗིད་ཏིག་ཏིག་གི་གོམ་པ་ཡང་མདུན་ནས་མདུན་ནས་སྤོས་པ་རེད།",
    "ཁོང་གིས་སྐབས་དེ་གའི་མི་དང་ཕྱི་རབས་པ་རྣམས་ལ་མར་ཁེ་སི།",
    "བཞག་པའི་སྣང་བརྙན་ནི་ངེས་པ་དོན་གྱི་བསམ་བློའི་འཐབ་མོ་པ་ཞིག་གོ།",
    "དོན་གྲུབ་རྒྱལ་ཁོང་ལ་མཚོན་ན་འུ་ཅག་གི་རྙིང་ཞེན་དང་ལེ་ལོ།",
    "བརྒྱ་ལོ་པའི་ལོ་རབས་པའི་ནང་དུ་གུང་ཁྲན་ཏང་དང་མཉམ་འབྲེལ་ཡང་བྱས་འདུག་པ་རེད།",
    "གཅིག་ན་སྐབས་དེའི་ནུབ་ཕྱོགས་ཀྱི་དེང་རབས་ཅན་གྱི་ལམ་བུ་ལ་ཐེ་ཚོམ་དང་རེ་ཆད་བྱུང་ཞིང་།",
    "ལུགས་དང་ཁ་འཕྲོད་པས་རེད་སྙམ།",
    "སྐྱིད་སྡུག་ཁོ་ནའི་ཁེ་ཕན་ལ་དམིགས་པའི་རིང་ལུགས་དང་གཞུང་ལུགས་ལ་དེ་བས་ཀྱང་དགའ་དེའི་སྐོར་ནི་རྒྱའི་དེང་རབས་ཀྱི་ལུའུ་པོ་མེད་པ་ཞིག་ཀྱང་ཡིན་འདུག་ཞུན་ཞིབ་འཇུག་ཆེད་མཁས་པ་དང་མི་ཚུལ་བསམ་བློ་མཁན་ཆན་ལི་ཆུན་༧དང་ལིན་ཞན་ཀྲིིགཉིས་ཀྱིས་བྲིས་པའི་ཆེད་རྩོམ་དག་ལ་གཟིགས་ན་ཧ་ཅང་གསལ།",
    "བརྗེའི་ཆེད་དུ་ཁོང་གི་དར་ཆ་ཕྱར་པ་ནི་འཁྱོག་བསྒྱུར་བྱས་པ་ཁོ་ན་ལས་མ་འདས།",
    "མ་བསམ་ས་ནས་གཞུང་ལུགས་འདིའི་འབྲས་བུ་ནི་ནུབ་ཕྱོགས་ནས་མ་སྨིན་པར་སུའུ་ལེན་དང་ཀྲུང་གོ་སོགས་ནས་སྨིན་སོང་བ་རེད།",
    "སྐུར་འདེབས་བྱེད་རྒྱུ་ཡང་ཐལ་དྲགས་སོང་ངོ།",
    "ཡང་ན་ཁོང་ཚོ་ནི་འུ་ཅག་གི་འཕེལ་རྒྱས་ཀྱི་གེགས་རྐྱེན་ཅི་ཞིག་ཏུ་གྱུར་སོང་།",
    "གལ་སྲིད་ཁོང་ཚོས་བོད་ནང་དཀྲུགས་པའི་ནག་ཉེས་འདི་རེད་ཅེས་སྟོན་རྒྱུ་ཞིག་ཡོད་ན་སྨད་པ་དང་སྡིགས་མོ་འབབ་མོད།",
    "དེ་ནི་བསམ་བློའི་ཐད་ཀྱི་ཐོད་བརྒལ་ཆེན་པོ་ཞིག་རེད་ལ།",
    "ཡང་ན་འུ་ཅག་ལ་ད་དུང་གསོན་ཤུགས་དང་རེ་བ་ཡོད་པའི་རྟགས་ཤིག་རེད་སྙམ།",
    "རབས་ཅན་འཕེལ་རྒྱས་ཀྱི་བཀག་རྡོ་རུ་འགྱུར་བྱེད་དེ་དག་སུ་ཞིག་གིས་བསྒྲུབས་པ་རེད།",
    "འདིར་ཁོ་བོས་ལན་འདེབས་པའི་ངལ་བ་མ་བྱས་ཀྱང་ཀློག་པོ་ཚོས་ཞིབ་ཏུ་བསམ་ན་ཧ་གོ་ཡོང་གི་རེད།",
    "ནུས་པ་སོགས་དང་འབྲེལ་བ་དམ་པོ་ཡོད་པ་ཞིག་རེད།",
    "དོན་གྲུབ་རྒྱལ་ནི་གཞན་ཞེན་རང་རིང་ལུགས་པ་ཞིག་དང་ལད་ཟློས་རིང་ལུགས་པ་ཞིག་རེད།",
    "ཁོས་ལོ་དེ་རྐང་ལམ་ཕྲ་མོ་དང་ལམ་རྙིང་ཞིག་ཏུ་བརྩིས་ནས་བཤིག་མགོ་བརྩམསརྒྱུས་ཀྱི་ལམ་བུ་དེ་གཞན་གྱིས་བཤིག་བཞིན་པ་ལ་རོགས་རམ་བྱས་ཏེ་བཤིག་པ་མ་ཟད།",
    "ཁོ་ཚོའི་ནང་གི་མི་ལ་ལས་ད་ལྟ་རྐང་ལམ་ཕྲ་མོ་བསྐྱུར་ནས་གཞན་གྱི་གཞུང་ལམ་ཆེན་མོ་སྙེག་ཟིན།",
    "ལ་ལས་རྐང་ལམ་ཕྲ་མོ་དོར་ནས་མེས་མེ་འཁོར་ལ་བསྡད་ཟིན།",
    "སྟ་གོན་བྱེད་བཞིན་འདུག་ཡིན་ན་ཡང་ཁོ་ཚོས་ཕ་མེས་ཀྱི་རྐང་ལམ་ཕྲ་མོ་དེབཤིག་དགོས་དོན་ཅི་ཡིན་ནམ།",
    "འུ་ཅག་གིས་ཕྱིར་འཁོར་ཏེ་ཁོང་གི་མི་ཚེ་ལ་སྡོམ་ཚིག་བཀོད་པ་ནི་སྲོལ་རྒྱུན་གྱི་རྐང་ལམ་ཕྲ་མོ་བཤིག་མཁན་དང་།",
    "དོན་དངོས་སུ་རང་རེའི་རྐང་ལམ་ཕྲ་མོ་བཤིག་མཁན་དང་།",
    "ལག་ཏུ་སྟ་རེ་བཟུང་ནས་ལྷ་སྐུ་དུམ་བུར་གསིལ་མཁན།",
    "རང་གི་ཁེ་ཕན་བསམ་ནས་ནང་མི་ལྐོག་ཞུ་བྱེད་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "མཁན་སོགས་ཀྱི་གཏོར་བཤིག་པ་ནི་གཞན་མ་ཡིན་པར་རང་རེའི་སྤུན་ཟླ་དག་རེད།",
    "ཁོམ་ལོང་རེ་བྱུང་ཚེ་ཁྱེད་ཀྱིས་ཀྱང་གོང་གི་དཔེ་དེབ་འདི་གཉིས་ལ་གཟིགས་དང་།",
    "འཇར་མན་གྱི་ཧི་ཐི་ལིར་གྱིས་འཛམ་གླིང་འཁྲུག་ཆེན་གཉིས་པའི་སྐབས་སུ་ཡ་ཧུ་དཱ་པ་ཁྲི་དྲུག་བརྒྱ་ལྷག་དམར་གསོད་བཏང་བའི་བྱས་ཉེས་དེ་ནི་ཧི་ཐི་ལིར་འདུས་པའི་འཇར་མན་པ་ཡོད་ཚད་ཀྱི་ནག་ཉེས་ཤིག་རེད་ལ།",
    "ཀྲུང་གོའི་རིག་གསར་གྱི་ལོ་བཅུའི་ཡ་ང་བའི་ཆག་འཇིག་གི་བྱས་ཉེས་དེ་ནི་རླབས་ཆེན་གཙོ་འཛིན་ཐེ་བའི་ཀྲུང་གོ་པ་ཡོངས་ཀྱི་ནག་ཉེས་ཤིག་རེད།",
    "དེ་བཞིན་དུ་འུ་ཅག་གི་རིག་གསར་སྐབས་ཀྱི་གཏོར་ཝང་ལི་ཞུང་།",
    "བཤིག་གི་བྱས་ཉེས་དེ་ཡང་རང་རེ་བོད་མི་ཡོངས་ཀྱི་ནག་ཉེས་ཤིག་ཡིན་པ་རེད།",
    "ཨ་རིའི་བུད་མེད་ཆབ་སྲིད་མཁས་པ་ཧན་ནའ་ཨ་རེན་ཏི་ལགས་ཀྱི་དགོངས་པ་ལྟར་ན།",
    "ཡང་ན་ཐུན་མོང་གིས་འགོག་རྒོལ་མ་བྱས་པས་ལན་པར་འདོད།",
    "བྱས་ཉེས་དེའི་འགན་འཁྲི་ལ་ཕྱིར་རྟོག་བྱེད་པའི་ཚེ་ན་ཐུན་མོང་གི་འགན་འཁྲི་ལ་ཕྱིར་རྟོག་བྱེད་དགོས་པ་རེད།",
    "འུ་ཅག་གིས་འགྱོད་བཤགས་བྱེད་ཅེས་བརྗོད་པ་ཡིན།",
    "ཁོ་དོན་གྲུབ་རྒྱལ་ཤི་སོང་བ་ནི་བོད་པ་ཚང་ལ་དགྲ་བོ་ཞིག་ཚར་བཅད་པ་རེད།",
    "མི་བུ་བསམ་བློ་ཅན་ནི་ལྟ་བ་ལོག་པར་རྩི་བ་རེད།",
    "བསྟན་བཤིག་ཏུ་རྩི་བ་རེད།",
    "དགྲ་བོར་ཧན་ནའ་ཨ་རེན་ཏི།",
    "ཨ་མེ་རི་ཁའི་ཆབ་སྲིད་རིག་པའི་མཁས་པ།",
    "བསྒྲལ་བྱ་ཡིན་པ་རེད།",
    "དོན་གྲུབ་རྒྱལ་ནི་རང་རིགས་རྣམས་རྨོངས་གཉིད་ལས་སད་དུ་འཇུག་ཕྱིར་རང་གི་གཅེས་པའི་ཚེ་སྲོག་བློས་བཏང་བ་རེད།",
    "ཁོང་གཉིས་འཇིག་རྟེན་མི་ཡུལ་ནས་བཙན་གྱིས་བསྐྲད་པའི་ནག་ཉེས་དེ་རང་རེ་བོད་པ་ཚང་མའི་སྟེང་དུ་ཡོད་པ་རེད།",
    "འུ་ཅག་གིས་ཉེས་དམིགས་དེ་ལ་ངོས་ཟིན་ནས་འགྱོད་བཤགས་ཡང་ཡང་བྱེད་པ་དང་།",
    "རང་སེམས་ལ་ཚ་འདྲི་ཡང་ཡང་གཏོང་དགོས་པ་རེད།",
    "ཉིན་མོ་འདིར་འཛམ་གླིང་ན་དཀོན་པའི་བེཌཱུརྱའི་བུམ་པ་ཞིག་བོད་རང་གིས་རྡོ་ལ་བརྡབས་པ་རེད།",
    "འུ་ཅག་གི་མི་རིགས་ཀྱི་སྐྱོ་གར་ཆེན་པོ་ཞིག་ཀྱང་ཡིན་པ་རེད།",
    "འུ་ཅག་བོད་མི་ཡོངས་ཀྱིས་འགྱོད་བཤགས་བྱེད་དགོས་པ་རེད།",
    "ཆིར་ནིས་ཞེ་ཧྲི་སི་ཁེ་དང་ནེ་ཁི་ར་སོ་ཧྲི་གཉིས་ཀྱིས་དེང་རབས་ཀྱི་མི་བསྒྲུབས་པ་ལྟ་བུ་རེད།",
    "གལ་ཏེ་ཁོ་བོ་ནི་རྒྱུན་དུ་འདི་ལྟ་བུའི་བསམ་གཞིག་གི་ཀློང་དུ་འཐིམ་འགྲོའོ།",
    "ལོ་ངོ་རིང་གི་རྒྱལ་ཁམས་འགྲིམས་པའི་ཀྱག་ཀྱོག་གི་ལམ་བུ་རིང་མོ་དེ་འདི་ནས་འགོ་ཚུགས།",
    "དེབ་ཐེར་དཀར་པོ་ཀླུ་སྒྲུབ་དགོངས་རྒྱན་འདོད་པའི་བསྟན་བཅོས་སོགས་ཡོད་པ་རེད།",
    "ལྗགས་རྩོམ་འདི་ལོའི་ཟླ་པར་མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་པར་དུ་བསྐྲུན་པའི་རྗེ་བཙུན་ཤེས་རབ་རྒྱ་མཚོ་འཇམ་དཔལ་དགྱེས་པའི་བློ་གྲོས་ཀྱི་གསུང་རྩོམ་པོད་གསུམ་པ་རུ་བཀོད་འདུག་ལོར།",
    "ཚེ་ཏན་ཞབས་དྲུང་ལགས་ཀྱིས་མཛད་པའི་དེབ་དཀར་དུ་འགོས་ལོར་སྐྱོན་བསྟན་པ་མི་འཇུག་པའི་དཔྱད་པ་ཞེས་པ་མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་པར་དུ་བསྐྲུན་པའི་ཁོང་གི་བསྟན་རྩིས་ཀུན་བཏུས་ཞེས་པར་བཀོད་འདུག་ལོར།",
    "ཧྥ་རན་སིའི་བོད་རིག་པའི་བུད་མེད་མཁས་པ།",
    "དེབ་འདིའི་རྒྱ་འགྱུར་ཏུའུ་ཡུང་པིན་ལགས་ཀྱིས་བསྒྱུར་ཡོད་སྐད་མོད།",
    "རྩོམ་པ་པོས་མིའི་རིན་ཐང་གི་ལྟ་བ་དང་།",
    "སྐུ་པར་དེ་ནི་ཤིན་ཏུ་རྩ་ཆེན་ཞིག་ཡིན་པ་རེད།",
    "ཏུའུ་ཡུང་པིན་ལགས་ཀྱིས་བརྩམས་པའི་རྒྱ་ཡིག་གི་དུས་རབས་ཉི་ཤུ་པའི་བོད་ཀྱི་སེར་མོ་པ་ངོ་མཚར་ཅན་མི་ཚུལ་རིང་ལུགས་ཀྱི་སྔོན་སྐྱོད་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "འཛམ་གླིང་ན་དཀོན་པའི་བེཌཱུརྱའི་བུམ་པ་ཞེས་པའི་རྗེས་དྲན་གྱི་སྙན་ངག་གི་དེབ་ཆུང་ཞིག་ཀྱང་པར་དུ་བསྐྲུན་འདུག་ལོར།",
    "ཞིབ་འཇུག་ཁོང་གི་རི་མོ་དང་ཕྱག་བྲིས་སོགས་གཅེས་ཉར་གནང་ཡོད་མཁན་གྱི་པ།",
    "མཁྱེན་ལྡན་ཀློག་པ་པོ་རྣམས་ཀྱིས་མེད་པ་ཁ་སྐོང་དང་དགོངས་འཆར་ལྷུགས་པོར་གནང་བའི་རེ་བ་ཞུ་ལོའི་ཟླ་པའི་ཚེས་ཉིན་ཟི་ལིང་དུ།",
    "ལོ་རེ་རེའི་ལོ་མཇུག་ཏུ་བསླེབས་ཚེ།",
    "རང་ཉིད་ཀྱི་ལོ་ངོ་གཅིག་རིང་གི་བྱ་བ་ལ་སྤྱི་བསྡོམས་ཐུང་ཐུང་ཞིག་བྱས་ན་འགྲིག་སྟེ།",
    "ད་ལོའི་རང་གི་དཔེ་ཀློག་དང་བྲིས་རྩོམ་སྐོར་ལ་ཕྱི་མིག་ཅིག་བལྟས་ན།",
    "བོད་ཡིག་གི་སྐོར་ལ།",
    "མི་ཚེ་དཔའ་གདེང་གིས་བརྟས་པའི་དོན་གྲུབ་རྒྱལ་གྱི་སྣང་བརྙན་གསོན་པོ་ཞིག་ཀློག་པོའི་སྤྱན་སྔར་དུ་སྟར་ཐུབ་མི་འདུག་ཧོར་གཙང་འཇིགས་མེད་ཀྱིས་བརྩམས་པའི་ཁྲག་ཐིགས་ལས་སྐྱེས་པའི་ལྗང་མྱུག་དེང་རབས་བོད་ཀྱི་རྩོམ་རིག་དང་དེའི་རྒྱབ་ལྗོངས་ལོར་རྒྱ་གར་རྡ་རམ་ས་ལ་ནས་པར་དུ་བསྐྲུན་དེབ་དེ་རུ་སྤྱི་ལོ་ལོའི་བར་གྱི་བོད་ཀྱི་དེང་རབས་རྩོམ་རིག་སྐོར་ལ་དཔྱད་པ་སྤེལ་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "རྒྱ་ཡིག་གི་སྐོར་ལ།",
    "གཅིག་ནི་རྒྱུན་ཞའོ་ཀངིགིས་འཁྲབ་འཁྲིད་བྱས་པའི་མཚན་མོའི་གསོལ་སྟོན་༦༢ ཙྩ་ཞེས་པ་དང་།",
    "ཅིག་ཤོས་ནི་ཀྲང་དབྱི་མོའུ་ཡིས་འཁྲབ་འཁྲིད་བྱས་པའི",
    "གློག་བརྙན་འདི་གཉིས་ནི་ད་ལོའི་རྒྱ་ནང་གི་ཆེས་ཚ་འུར་ཆེ་བའི་གློག་བརྙན་གཉིས་རེད།",
    "བལྟས་རྗེས་ཀྱི་འཆར་སྣང་ནི་གནམ་འོག་གི་ཞི་བདེ་དང་རྒྱལ་ཁབ་སོགས་ཀྱི་ཕྱིར་དུ་ཁྲག་གི་རྒྱ་མཚོ་བསྐྱིལ་བ་དང་རོ་ཡི་རི་རབ་བརྩིགས་ཆོག་ཆོག་ཡིན་ལ།",
    "སྤྱིར་ན་ད་དུང་ང་རང་འབྲི་བར་མོས་པའི་རྣོ་དབལ་ཚ་བའི་འབོལ་རྩོམ་ཁ་ཤས་ཀྱང་དོ་ཚིགས་འབྲི་བའི་འཆར་གཞི་ཡོད་ནའང་།",
    "ཡིག་འབྲུ་ཁྲི་གསུམ་ལྷག་ལོངས་པའི་རང་ཉིད་ཀྱི་སྤྱི་ལོ་ལོའི་བར་གྱི་ཐོར་གྱུར་དུ་སོང་བའི་ཉིན་ཐོ་རྣམས་དག་བསྒྲིགས་བྱས་པས་རྩོམ་འབྲིའི་འདོད་པ་དེ་ཅུང་ཙམ་ཚིམ་ཐུབ་པ་བྱུང་།",
    "ལོ་ངོ་ཧྲིལ་པོ་གཅིག་གི་ཉི་མ་འདི་ལྟར་ནུབ་རིར་ཡོལ་སོང་།",
    "ལོ་ངོ་གཅིག་གི་ཉི་གཞོན་གསར་པ་སླར་ཡང་ཤར་རིའི་རྩེ་ནས་ཡར་འཕགས་བྱུང་།",
    "སྐབས་འདིར་རང་གིས་རང་ལ་འདི་ལྟར་སྨྲས།",
    "དཔེ་ཁང་ཕྱི་ཡི་གསར་བརྗེ་དང་ནང་གི་མནོ་བསམ།",
    "དེ་ལ་ཡང་མི་སྨྲའི་བརྟུལ་ཞུགས་འཛིན་མཁན་དང་སྨྲ་ལྕེ་ཁ་ལ་སྒྱུར་མཁན་གང་མང་བྱུང་དང་འབྱུང་གི་ཡོད་པ་རེད།",
    "ཡང་ལ་ཤས་ཀྱིས་རྒྱན་ལྤགས་རྣམས་ཡིན་གཅིག་མིན་གཉིས་མེ་ལ་སྲེག་དགོས་དོན་མི་འདུག་ཕྱིན་ཆད་ལུས་ལ་མ་གོན་ཚེ་འགྲིག་ཡོད་པ་རེད་ཟེར།",
    "ཡང་ལ་ཤས་ཀྱིས་གང་ལྟར་ཀྱང་ད་ཐེངས་རྒྱུན་ལྤགས་མེ་ལ་སྲེག་ཐུབ་གི་མ་རེད་ཟེར།",
    "རེབ་གོང་།",
    "བླ་བྲང་སོགས་སུ་སྲམ་ལྤགས་དང་གཟིག་སྟག་ལྤགས་སོགས་གཙོས་པའི་རྒྱན་ལྤགས་རྣམས་མེ་ལ་སྲེག་ལྤགས།",
    "ལོ་ངོ་གཅིག་འགོར་བའི་དེ་རིང་གི་ཉིན་མོར་ལས་འགུལ་དེ་ལ་ཡང་བསྐྱར་བསམ་གཞིག་རེ་བཏང་ན་དྲན་འཆར་འདི་འདྲ་ཡང་འབྱུང་སྟེ།",
    "སྲེག་སྦྱོར་གྱི་ལས་འགུལ་འདི་ལ་རྐྱེན་བྱས་ཏེ་རྔ་བ་ནས་སྐལ་བཟང་སྦྱིན་པ་དང་ཅོ་ལེབ་ཟླ་བ་སོགས་མི་བུ་བདུན་ལ་བསྙོན་འཛུགས་ཉེས་འགེལ་གྱིས་ཉིན་བཅུ་ལྷག་གི་རིང་ལ་བཀག་སྐྱིལ་བྱས་པ་རེད།",
    "འཕྲིན་ཡིག་འདི་སྤེལ་མ་ཐག་གྲོགས་ཁྲི་སེམས་དཔེ་ཁང་ཕྱི་ཡི་གསར་བརྗེ་དང་ནང་གི་མནོ་བསམ།",
    "འཕྲིན་ཡིག་འདི་སྤེལ་བའི་སྒང་ལའང་ང་ཚོས་ཉེ་འཁོར་གྱི་ལས་གྲོགས་དང་གྲོགས་པོ་དག་ལ་ངག་ཐོག་རྒྱབ་སྐྱོར་བྱེད་པར་བསྐུལ་མོད།",
    "ཚང་མས་གོང་གི་འཕྲིན་ཡིག་འདི་ལ་མྱོང་རོལ་བྱེད་པ་ཙམ་ལས་རྒྱབ་སྐྱོར་བྱེད་མི་ནི་ཉིན་མོའི་སྐར་མའི་དཔེ་རུ་གྱུར།",
    "གཟབ་ནན་དཔྱོད་ལྡན་གྱི་རྟོག་དཔྱོད་མེད་པ་དང་མིག་རྒྱང་རིང་པོའི་མནོ་བསམ་མི་གཏོང་བ་ནི་འུ་ཅག་གི་སྐྱོན་ཆེ་ཤོས་ཤིག་ཏུ་སྣང་།",
    "འདིར་ཁོ་བོས་རྒྱན་ལྕགས་སྲེག་སྦྱོར་གྱི་ལས་འགུལ་དེ་ལ་ཧོལ་རྒྱུག་གི་ཆ་ལྡན་ནོ་ཞེས་དེར་སྐྱོན་བཙལ་བ་དང་དམའ་ཕབ་པ་ནི་གཏན་ནས་མིན་ན་ཡང་།",
    "ལས་འགུལ་འདིའི་སྟེང་ནས་ཀྱང་འུ་ཅག་ལ་ཆེས་མ་མཐའ་ཡང་དཔྱོད་ཤེས་དང་གཟབ་ནན་དཔྱོད་ལྡན་གྱི་སྲོལ་རྒྱུན་མེད་པར་ཧོལ་རྒྱུག་དང་ཚིང་རགས་ཀྱི་ཆ་ལྡན་པ་ནི་ངེས་པར་དུ་ཁས་ལེན་དགོས་པ་ཞིག་རེད།",
    "བག་འཁུམ་དང་གཉའ་གནོན་གྱི་ངང་ནས་འཚོ་དགོས་བྱུང་བ་རེད།",
    "ད་ལྟ་མི་མང་པོ་ཞིག་གིས་རྩིས་འཁོར་གྱི་མདུན་དུ་འཚང་ཁ་ཤིག་ཤིག་བྱེད་ཅིང་།",
    "གཟུ་ལུམ་གྱི་དཔེ་ཁང་ཕྱི་ཡི་གསར་བརྗེ་དང་ནང་གི་མནོ་བསམ།",
    "ཉོག་གཏམ་སྨྲ་བ་སོགས་ཀྱི་ཡོ་བྱད་ཅིག་ཏུ་གྱུར་འགྲོ་གི་ཡོད་པ་རེད།",
    "ལོའི་ཟླ་པར་སྐབས་དང་པོའི་བོད་ཀྱི་སྙན་ངག་གི་མི་རབས་གསུམ་པའི་བགྲོ་གླེང་འདུ་ཚོགས་དེ་གནའ་མཁར་ཟི་ལིང་དུ་བསྡུས།",
    "གལ་ཏེ་མི་རབས་གསུམ་པ་འདྲེ་རེད་ཟེར་ན་འདྲེ་ཡིན།",
    "ད་ནི་ང་ཚོས་མི་རབས་གསུམ་པ་རུ་འབོད་པའི་ན་གཞོན་སྙན་ངག་པ་འདི་ཚོས་སྙན་ངག་ཅི་ཞིག་འབྲི་བ་དང་།",
    "གི་ཆེད་དུ་སྙན་ངག་འབྲི་བར་འཁྱུག་ཙམ་བལྟས་ན།",
    "མདའ་བཙན་པོ་ལགས་ཀྱིས་ངས་མལ་ཁྲིའི་སྒང་ནས་སྙན་ངག་གི་འཁྲིག་པ་སྤྱོད་སྲིད་ཟེར།",
    "འབྲུག་ལྗང་ལགས་ཀྱིས་ང་ཚོས་གཅེར་བུར་ཕུད་ནས་སྙན་ངག་བྲིས་ན་ཅིས་མི་ཆོག་ཟེར།",
    "ཐེའུ་རེང་ལགས་ཀྱིས་མི་རབས་གསུམ་པ་ནི་དོར་མ་མེད་པའི་གཅེར་བུ་ཡིན་ཟེར།",
    "ཁོ་ཚོའི་རྣམ་དཔྱོད་ཀྱི་ཤེས་རབ་དང་དྭངས་གཙང་གི་སྨྱུག་རྩེ་ནས་འཕྱུར་བའི་སྙན་ངག་ནི་འདི་ལྟ་སྟེ།",
    "ཆགས་སྲེད་ཀྱིས་མནར་བའི་ནམ་མཁའ་ཆེན་པོ་འདི་ནི་ལྷ་མོ་ཞིག་གི་མིག་ཡ་གཅིག་ལ་ཁྲུན་ཐག་བཅད་པས་ཁྱོད་ཀྱི་མཛེས་སྡུག་དེ་ཡང་བྱེ་ཐང་སྐྱ་བོ་དེའི་སྒལ་གཞུང་དུ་ནུབ་ངེས་ལ་ནུ་འབུར་དང་བརླ་ཤ་མཚན་མ་བཅས་ཀྱི་མཚོན་དོན་དུ་བབས་པ་བྱེ་སྒང་གི་ཉམས་འགྱུར་རེ་རེ་ཁྱོད་ཀྱི་བླ་སྲོག་རྐུ་བའི་མཛེས་པ་རེ་རེ་ཡིན་ལ་བུད་མེད་ཀྱི་གཟུགས་རིས་ལྟ་བུའི་སྒྲེན་གཟུགས་དེས་ཁྱོད་ལ་འདོད་སྲེད་ཀྱི་བསླུ་བྲིད་ཅིག་གཏོང་ངེས་གཅེར་བུར་བུད་ནས་ཁྱོད་ལ་བལྟས་པ་ཞེས་དང་།",
    "སང་ཉིན་ནི་འཁྲིག་པའི་སྒང་གི་ཕོ་མོ་གཉིས་རེད་བརྩེ་བ་དེ་ཟབ་དྲགས་པས་ངས་ཁྱོད་རྐང་ཐུང་ཞིག་གི་ཚད་དུ་བཞག་ཡོད་མཇེ་དང་རླིག་པ་གཉིས་ལྷུང་རག་བར་དུ་ངས།",
    "ཁྱོད་རང་རྐང་ཐུང་ཞིག་གི་ཚད་དུ་བཞག་ཡོད་ཞེས་དང་།",
    "དེ་ནི་ཕོ་མཚན་གྱི་ཁུ་བ་འཛར་བའི་འོད་སྣང་དང་མོ་མཚན་ཕྱི་རུ་སློག་པའི་འཇམ་མཉེན་ལས་གནའ་བོའི་ཉི་ཟླ་གཉིས་ཀ་གཏན་ནས་མིན་ཁྱོད་རང་མི་འཐད་ནའང་།",
    "ངས་འདི་ལྟར་བྲིས་ན་ཅི་རེད་ཞེས་དང་།",
    "གཞན་ཡང་རེ་རྐང་གླིང་ལགས་ཀྱི་དུས་ཚོད་སྐར་མ་བཅུའི་ཡུན་ལ་བྲིས་པའི་སྙན་ངག་ཚན་པ་བཅོ་བརྒྱུད་དང་།",
    "གཤེད་མ་ལགས་ཀྱི་མོ་མཚན་རྫུན་མ་འདི་ང་ལ་མེ་དགོས་མདའ་བཙན་པོ་ལགས་ཀྱི་སྐྱག་པ་སྐྱབས་ཆེན་བདེ་གྲོལ་ལགས་ཀྱི་གཅེར་བུར་འབུད་པ་སོགས་ཀྱང་གོང་དུ་དྲངས་པའི་སྙན་ངག་འདི་དག་དང་ཆ་མཚུངས་པར་འདུག་གོ།",
    "སྙན་ངག་དེ་དག་གིས་མཚོན་པའི་མི་རབས་གསུམ་པ་ཡི་སྙན་ངག་ནི་ངོ་ཚའི་རྫུ་བག་དང་བྲལ་བའི་ཁ་བཙོག་གི་སྙན་ངག་ཅིག་རེད་ལ།",
    "ཡི་གེའི་རོལ་རྩེད་གཉེར་བའི་གད་སྙིགས་ཀྱི་སྙན་ངག་ཅིག་ཀྱང་རེད།",
    "སྙན་ངག་དེ་དག་གིས་མཚོན་པའི་མི་རབས་གསུམ་པ་ཡི་བྱ་སྤྱོད་ནི་ཨ་གསར་གྱི་གཏམ་འདོད་ཚ་པོ་རེད་ལ།",
    "དངོས་ཡོད་ཀྱི་འགན་འཁྲི་ལ་གཡོལ་ཐབས་ཤིག་ཀྱང་རེད།",
    "བརྒྱ་ལ་སྒྱུ་རྩལ་གྱི་ཆེད་དུ་སྒྱུ་རྩལ་གཉེར་བའི་དུས་ཤིག་ཡོད་སྲིད་ཀྱང་འུ་ཅག་ལ་མཚོན་ན་ད་དུང་དེ་ནི་དཔེ་ཁང་ཕྱི་ཡི་གསར་བརྗེ་དང་ནང་གི་མནོ་བསམ།",
    "གཞན་ཡང་སྙན་ངག་འདིའི་རིགས་དར་ཁྱབ་ཏུ་སོང་ན་ཀུན་སྤྱོད་ཀྱི་ཁ་དབུགས་བཙོག་པོར་བཟོ་སྲིད་པ་དང་།",
    "སྙན་ངག་ལ་ཐོག་མར་འཇུག་མཁན་དག་གི་ལྷད་མེད་ཀྱི་བྱིས་བློ་དེའང་དྲི་མས་སྦྲགས་སྲིད།",
    "གལ་ཏེ་མི་ལོ་གང་མང་ཞིག་གི་རྗེས་སུ་མི་རབས་གསུམ་པ་ཡི་སྙན་ངག་པ་དག་གི་བུ་ཕྲུག་ཚོས་རང་གི་ཕ་མས་བྲིས་པའི་ཁ་བཙོག་གི་སྙན་ངག་འདི་དག་ལ་གདོང་གཏད་ཚེ་སེམས་ངོས་སུ་ཅི་ཞིག་འཆར་རམ།",
    "སྦྲང་ཆར་རྩོམ་རིག་བྱ་དགའ་ནི་འུ་ཅག་གི་རྩོམ་རིག་བྱ་དགའི་ཁྲོད་མཚན་སྙན་ཆེས་མཐོ་ཤོས་དང་བྱ་དགའི་དངུལ་གྲངས་ཆེས་མང་ཤོས་ཡིན་པ་རེད།",
    "ཚེ་རིང་དོན་གྲུབ་ཀྱི་བརྩམས་སྒྲུང་བཙུན་ཡག་ཡེ་ཤེས་བཟང་བོའི་སྙན་ངག་སློབ་དཔོན་ཐོན་མིའི་རྟོགས་པ་ཉུང་ངུར་བརྗོད་པའི་གཏམ་ཅོ་ནེ་ཡུམ་ཚེ་རིང་གི་བརྩམས་སྒྲུང་རྣམ་སྨིན་ཁྲི་སེམས་དཔའི་སྙན་ངག་ཞི་བདེར་སྨོན་པ་བཅས་སོ།",
    "གསར་རྩོམ་ལ་མོས་པའི་ལས་དང་པོ་དཔེ་ཁང་ཕྱི་ཡི་གསར་བརྗེ་དང་ནང་གི་མནོ་བསམ།",
    "གང་ལྟར་ཀྱང་སྦྲང་ཆར་རྩོམ་སྒྲིག་ཁང་གིས་རྩོམ་མཁན་དག་གི་ངལ་རྩོལ་གྱི་འབྲས་བུ་ལ་བརྩི་མཐོང་དང་ཡིན་འཇོག་བྱས་དང་བྱེད་བཞིན་པ་ནི་དགའ་འོས་པའི་དོན་ཞིག་རེད་སྙམ།",
    "ཡང་ན་སྦྲང་ཆར་རྩོམ་རིག་བྱ་དགའ་ལ་མཚོན་ན་ད་དུང་མི་འདང་སའམ་ཞན་ཆ་ཡང་འགའ་རེ་མཆིས་ཏེ།",
    "འདི་ལས་རྟག་པར་བྱ་དགའ་འཐོབ་འོས་པ་ལ་མི་ཐོབ་པ་དང་འཐོབ་མི་འོས་པ་ལ་བྱ་དགའ་ཐོབ་པའི་སྣང་ཚུལ་ཡ་མ་བརླ་དག་འབྱུང་གི་ཡོད་པ་རེད་གཞན་ཡང་གླེང་རྒྱུ་ཞིག་ལ་རང་རེའི་རྩོམ་སྟེགས་སུ་བྱ་དགའ་ཡི་ངོས་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "གདུག་རྩུབ་ཀྱི་ཞིང་ཁམས་ཤིག་ཡིན་པ་རེད་དེ་ལྟ་བུའི་གདུག་རྩུབ་དང་།",
    "སྐྱེ་བ་སྔ་ཕྱི་ཡོད་པར་འདོད་པ་སོགས་ནི་བླུན་རྨོངས་ཀྱི་རྟགས་ཁོ་ན་རེད་ཅེས་པ་སོགས་མང་དུ་བརྗོད་བྱུང་།",
    "ཉེ་བའི་ལོ་འདི་འགར་ཁོང་གིས་གདོང་གི་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "འདྲ་འབག་ཡུན་གྱིས་བཤུས་ཏེ་རང་གི་གདོང་རིས་ངོ་མ་བོ་དེ་ཀློག་པ་པོ་རྣམས་ཀྱི་སྤྱན་སྔར་བསྟན་བྱུང་།",
    "འདྲ་འབག་བཤུས་ཏེ་ང་ཚོའི་མདུན་ཐད་དུ་ཀྲོང་ངེར་འགྱིང་བའི་ལི་ཨའོ་ལགས་ནི་ཅི་འདྲ་ཞིག་རེད་ཅེ་ན།",
    "འགན་འཁྲི་ལ་གཡོལ་ཞིང་རྫུན་གཏམ་ལ་གོམས་པའི་ལི་ཨའོ་རེད།",
    "དེ་ནི་དུས་ཀྱི་སྔ་ཕྱི་ཞིག་ཡིན་པ་མ་གཏོགས་སྔ་རུང་འཕྱི་རུང་ནམ་ཞིག་ལ་ཁོས་བརྗོད་སྲིད་པའི་སྐད་ཆ་རེད།",
    "འཛམ་གླིང་གི་མིག་དཔེར་གྱུར་པའི་མི་རིགས་ཤིག་ལ།",
    "ཁ་མི་སོས་རྒྱུ་བོ་ང་ངོ་མ་ཁྱོད་ལ་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "བོད་ནི་ཐའེ་ཝན་དང་བསྡུར་ན་ས་རྒྱ་ཆེ་བ་ཡིན་མོད།",
    "ཞོགས་དུང་གསུམ་མོ།",
    "ཁོང་གིས་དུས་རབས་ཉི་ཤུ་པའི་སྨད་ཙམ་ལ་རྩོམ་རིག་གསར་པའི་དར་ཆ་ཐོག་མར་དགུང་ལ་ཕྱར་ཏེ་འུ་ཅག་གི་བླུན་རྨོངས་དང་རྗེས་ལུས་ཀྱི་ཆ་སོགས་མཚང་འབྱིན་ཐེར་འདོན་བྱས་ཤིང་།",
    "ཐ་ན་རང་གི་གཅེས་པའི་ཚེ་སྲོག་ཀྱང་མི་རིགས་འདིར་རྟོགས་སད་ཀྱི་ཅོང་བརྡ་རྒྱག་ཕྱིར་ཕངས་མེད་དུ་སྦྱིན།",
    "འུ་ཅག་ལ་ལོའི་དཔེ་དེབ་ཆེས་ལེགས་ཤོས་ནི་དཔེ་ཁང་ཕྱི་ཡི་གསར་བརྗེ་དང་ནང་གི་མནོ་བསམ།",
    "བསམ་བློའི་འགྲུལ་བཞུད་རིང་མོ།",
    "ལེགས་སྐྱེས་སུ་ཕུལ་པའི་དཔེ་དེབ་དེས་ཕ་རོལ་བོར་ཕན་ཞིག་ཨེ་ཐོགས་ཀྱི་རེ་བ་ཡང་བྱེད་བཞིན་ཡོད།",
    "རྒྱའི་དེང་རབས་ཀྱི་མི་ཚུལ་མཁས་པ་ཀྲུའུ་ཞུའེ་ཆིན་ལགས་ན་རེ།",
    "ཇི་ལྟ་བུའི་ལྟ་ཀློག་གི་བྱུང་བ་ཀྲུའུ་ཞུའེ་ཆིན།",
    "རང་གི་དཔེ་ཀློག་གི་འགྲུལ་བཞུད་རིང་མོའི་ཁྲོད་དུ་རང་ཉིད་ཆེས་ཀློག་པར་སྤྲོ་བའི་དཔེ་དེབ་ཁ་ཤས་རིམ་པ་བཞིན་དུ་ཟིན་ཐོར་བཀོད་ནས་ཁོང་རྣམ་པར་དཔྱད་གཞི་ཞིག་གི་ཚུལ་དུ་ཕུལ་ན་མི་ཆོག་པ་མེད་དོ།",
    "སྤྱི་ལོ་ལོའི་དགུན་གཞུང་གི་གྲང་ངར་ཧ་ཅང་ཆེ་བའི་མཚན་མོ་ཞིག་ལ་ཁོ་བོས་དཔེ་དེབ་འདི་ཐོག་མར་བཀླགས་ཤིང་།",
    "རྣོ་དབལ་ཚ་བའི་ཡིག་འབྲུ་རེ་རེའི་རྒྱབ་ཏུ་དཔྱོད་ཤེས་དང་རྒྱུ་འབྲས་བློ་མིག་སོགས་ཀྱིས་ཡོངས་སུ་བརྒྱན་འདུག་དེ་བཞིན་དུ་ཆབ་སྲིད་སྒེར་གཅོད་ལ་སྡང་བའི་ཁོང་ཁྲོ་དང་།",
    "རྩོམ་པ་པོས་འཇིག་རྟེན་སྟེང་ཆེས་བཟོད་སྒོམ་བྱེད་མི་རུང་བ་ནི་ཡི་གེའི་གད་སྙིགས་རེད།",
    "བསམ་བློའི་འགྲུལ་བཞུད་རིང་མོ།"
  ]
}