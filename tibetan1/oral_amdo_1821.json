    "མོ་རྩིས་ཀྱི་སྤང་བླང་སྤྱི་དང་།",
    "བརྩེ་ཆེན་ལྷ་ཁང་བཅས་ཀྱི་རྒྱ་སྐར་སྟེང་དུ་བྱ་རོག་གི་ཚང་བསགས་པས་གཡས་རུ་བྱང་གི་སྤྱི་མཚོ་སྐྱ་མོའི་མཚོ་སྒོ་ཡང་སྐྱ་བོ་ཁ་གདངས་ལ་ཞུགས་པ།",
    "གླིང་གི་མུན་ནག་གཡོགས་མོ་རྩེ་མ་འཐོན་པ་སོགས་རྗེ་ཉིད་དགོངས་པ་གཞན་དོན་དུ་གཏད་པའི་སྔ་ལྟས་ཤར་བའི་ཞབས་བརྟན་སྐུ་རིམ་དམིགས་བསལ་རྣམས་ལ་འབད་འབུངས་ངོས།",
    "དབོ་ཟླའི་ཟླ་མཇུག་སྐུ་རིམ་ཆེན་མོར་ཡང་མ་ཕེབས་ན་ཇི་ལྟར་ལགས།",
    "ཕུར་བཟློག་གི་ཚོགས་དབུ་རྡོ་རྗེ་སློབ་དཔོན་གནང་སྐབས་ཀྱང་ངོ་མཚར་རྫུ་འཕྲུལ་གྱི་མཛད་པ་འདི་ལྟར་མཐོང་སྟེ་སྙུན་གཞི་དེ་ལྟ་བུ་ལ་ནི།",
    "འཇིག་རྟེན་ན་སྐྱེ་བོ་ཕལ་མོ་ཆེ་དྲག་གཞན་ཇི་སྙེད་པ་དག་རྔ་རོལ་མེ་ཉི་སོགས་སྤང་བྱ་དང་།",
    "གདུལ་བྱ་མཐའ་དག་ལ་བརྩོན་འགྲུས་ཀྱི་ལྕག་གིས་བསྐུལ་བ་འདི་ལས་གཞན་དུ་མ་དམིགས་ལགས།",
    "འོན་ཀྱང་ལྗགས་བསྙེན་དེའི་སྐབས་ཤིག་མི་དཀར་པོ་ཞིག་གཟིགས་སྐར་ནས་འོངས་ཏེ་རྗེ་ཉིད་ལ་མཐོ་མཚམས་བྱེད་ཉམས་འདི་ནི་སྔ་མོ་ཞིག་ནས་རེས་མེ་ཕུང་དུ་སྤྲུལ།",
    "མགུལ་ལ་བཀྲ་ཤིས་པའི་ལྷའི་རེག་བྱ་ཁྱད་མཚར་ཅན་དག་གིས་སྤྲས་ནས།",
    "རེས་ནི་སྐུ་ཁམས་ཀྱང་བསྟར་ཆགས་དང་།",
    "རེས་ནི་ཇེ་ཞན་བཅས་སྐུ་བྱུག།",
    "སྐལ་ལྡན་རྣམས་ལ་རྗེས་གནང་ཟབ་མོའི་རིགས་སུམ་ཅུ་ཁ་ཡར།",
    "ལས་བཞིའི་སྦྱིན་སྲེག་ཕྱག་རྡོར་གཏུམ་མོའི་དུག་དབྱུང་རྒྱུན་རིང་བར།",
    "རིང་མོའི་དུས་ནས་རྗེ་ཉིད་ཀྱི་ཐུགས་དགོངས་ཐུན་མོང་མ་ཡིན་པ་གྲོ་བཞིན་བཛྲ་ཀཱི་ལ་ཡའི་སྒྲུབ་མཆོད་ཐོགས་འགྲེམས་པར་མཛད་རྒྱུའི་ནོར་ཕྲེང་ཕྱེ་ཕུར་སོགས་གོས་བཟང་དགུ་ལས་གྲུབ་པའི།",
    "མཆོད་རྫས་འདི་རྣམས་བཀས་འདོམས་ཤིང་སྤྱན་ལམ་དུའང་གཟིགས་སུ་གསོལ་བ།",
    "སྙུན་བབས་ལྕི་མོ་དེ་ལྟའི་གནས་སྐབས་སུའང་།",
    "མ་འོངས་མངོན་སུམ་དུ་གཟིགས་ཏེ།",
    "ཁ་འུར་དགའ་བོ་ཆུ་ཚན་ཆབ་བདུགས་སྐབས་ཀྱང་སྐུ་ཁམས་རེས་འཇོག་ཁོ་ན་དང་།",
    "སྣྲོན་ཟླའི་ལྷ་མོ་མཆོད་ཀྱང་རྡོ་ཆུའི་སྟེང་དུ་ཇི་བཞིན་གནང་རྒྱུའི་ཐོ་རེངས།",
    "དཔལ་ལྡན་ལྷ་མོ་ཉིད་ཀྱི་དངོས་སུ་ཞལ་བསྟན་ནས་ལུང་བསྟན་མང་དུ་སྩལ་མཐར།",
    "མེ་ཏོག་གི་ཆར་ཉིལ་བ་སོགས་ཀུན་གྱི་མིག་གི་བདུད་རྩིར་བྱུང་བ་དང་།",
    "དེའི་སང་ཐུབ་བསྟན་དགེ་འཕེལ་དར་གླིང་སོགས་ནས་སེར་ཕྲེང་གིས་སྔོན་བསུས་ཏེ།",
    "རིམ་གྱིས་ཆབ་གདུགས་སྐབས་ཀྱང་སྐུ་ཁམས་ཐོག་མར་རེས་འཇོག་དང་།",
    "གནས་དེར་ཡང་གདུལ་བྱ་སྤྱི་བྱེ་བྲག་གི་སྐལ་བ་དང་འཚམས་པའི་མཛད་པ་ནི་སུས་ཀྱང་བཟློག་མེད་དུ་བཀའ་དྲིན་བསྐྱངས་ཤིང་།",
    "ཆབ་ཀླུ་སོགས་ཉིན་རེ་བཞིན་རྟག་པར་མཛད་པས་དེ་ལོ་ཡུལ་ཕྱོགས་དེར་ལོ་ལེགས་པ་དང་།",
    "ཕྱི་ལོ་ཆུ་བཟང་བ་སོགས་རྒྱལ་བའི་མཛད་པ་ཉི་ཤར་སྤར་མོས་མི་ཁེབས་པའི་དཔེ་བཞིན་ཀུན་གྱིས་གླེང་པ་འདི་བཞིན་དང་སེང་གེ་སྒྲ་སོགས་གནང་བའི་ཚེ་ཉིན་རེ་བཞིན་སྦྲུལ་མང་པོ་སྐུའི་གམ་དུ་འོང་བ་དང་།",
    "རྩིག་པའི་སེང་ནས་སྦྲུལ་ཆུང་ངུ་མང་པོ་རྗེ་ཉིད་ཀྱི་ཕྱོགས་སུ་མགོ་བཏེག་ནས་འདུག་སྟེ་སླར་གསུང་ཆོག་གྲོལ་ནས་གར་སོང་མེད་པ་ལྟར་ཉིན་ལྟར་གྱུར་བའང་དེར་ཡོད་ཀུན་ལ་རྒྱུས་ཡོད་ཅིང་དེ་དུས་བླ་བྲང་ཞབས་པད།",
    "དེའི་ནུབ་མོ་ནི་སྐུ་ཁམས་ཆེས་ཆེར་ཉོག་ཅིང་།",
    "དེ་ནས་གཞི་བདག་ཤོ་དམར་བར་གསོལ་མཆོད་དང་བཅས་སྔར་གྱི་རྒན་མོ་ཁ་དྲོན་དུ་བཞུགས།",
    "ཁྱད་འཕགས་བྱང་གི་ཐེམ་སྐས་ལ་འཆེལ་བཞུགས་ཡུན་རིང་ཙམ་མཛད་ནས།",
    "ཞེས་ཀྱང་སྨྲས་སོ། རྩ་བའི་ས་བཅད་ལྔ་པ་ཞིང་འདིའི་གདུལ་བྱ་རེ་ཞིག་རྫོགས་ནས་མཐར་སྐུ་ཞི་བ་མཆོག་གི་དབྱིངས་སུ་ཐིམ་སྟེ་དགོངས་པ་ཟབ་མོ་རྫོགས་ཐབས་རྣམས་མཛད་ཚུལ་ནི།",
    "རེ་རེ་ནས་ཕྱག་བཞེས་ཀྱི་སྔོན་བྱོན་དང་རྗེ་ཉིད་ཀྱི་ཕྱག་བབས་རྣམས་སོ་སོར་ངོ་སྦྲོད་དང་།",
    "ཚེས་གཅིག་གི་ཉིན་རྗེ་རྡོ་རྗེ་འཆང་ཆེན་པོ་ཉིད་ཀྱི་དབུ་བླ་རྣམས་ལ་མཆོད་བཤམས་རྒྱས་པ་དང་།",
    "ཚེས་གཉིས་ཀྱི་ཐོ་རེངས་ཀྱི་ཆར་སྔར་མུ་བཞིན་བཞེས་ཐུག་ཞུས་པ་ཡང་གསོལ་བར་མ་གནང་ནས།",
    "སྣང་སྟོང་མ་ཞེན་མ་འགགས་མགོན་ཁྱོད་ཀྱི།",
    "གསུང་གིས་གདམས་པའི་ངེས་ཤེས་ད་ནི་གོ།",
    "རྒྱལ་བའི་ཕྲིན་ལས་ཤར་བའི་མགོན་པོ་ཁྱོད།",
    "དམིགས་མེད་ཐུགས་རྗེས་གཟིགས་ཤིག་དྲིན་ཅན་རྗེ།",
    "ཧྲིག་ཧྲིག་མིག་གི་བུང་བ་ཆུས་བརྣངས་ནས།",
    "ཧད་ཧད་འདྲེ་ཞིང་ལྡོག་ལ་ཐུགས་རྗེས་གཟིགས།",
    "དེ་ལྟར་བདག་སོགས་ལྷ་དང་བཅས་པའི་འགྲོ་བ་ཡོངས་ཀྱི་སྐྱབས་མགོན་སྐུ་དྲིན་ནམ་མཁའི་མཐའ་དང་མཉམ་པ་དེ་ཉིད་ཀྱིས་དགུང་གྲངས་ལྔ་བཅུ་རྩ་ལྔའི་སྣྲོན་ཟླ་ཕྱི་མའི་ཚེས་གཅིག་གི་བར་དུ།",
    "མཛེས་བྱེད་ཆུ་མོ་ཡོས་ཀྱི་ལོའི་སྤྲེའུའི་ཟླ་བ་ཉིས་བརྩེགས་ཀྱི་ཕྱི་མའི་ཡར་ངོའི་བཟང་པོ་དང་པོར་རེས་གཟའ་མིག་དམར།",
    "མེ་ཏོག་གི་ཆར་མང་པོ་རྒྱུན་རིང་བབས་ཤིང་།",
    "ཐུགས་དམ་ཟབ་མོའི་ཉམས་བཞེས་གསལ་འདེབས་སོགས་མཛད་སྒོ་རྣམས་ཀྱང་ཇི་བཞིན་འཇམ་མགོན་གོང་མ་མཆོག་གི་བཀའ་འདོམས་ཀྱིས་མཛད་ནས།",
    "ནམ་ལངས་ནས་དྲི་བཟང་གི་ཕྱེ་མས་བྱུགས་པའི་སྐུ་སྤུར་ཟངས་ནང་དུ་སྤྱན་དྲངས་པ་དེ་མཆོད་ཕྲེང་།",
    "ཞུགས་རང་བཞེས་ལྟ་བུའི་ངོ་མཚར་གྱི་ཚེའང་ནམ་མཁར་འཇའ་དང་མེ་ཏོག་གི་ཆར་སོགས་ནི་ཀུན་གྱི་མིག་ལམ་དུ་གསལ་ཞིང་དེ་ཉིད་སྐུ་གདུང་བཞུ་སྦྱངས་ཟིན་འཕྲལ་ནས་བཟུང་ཀླུ་རྣམས་ཀྱང་ཟིམ་ཆར་རྟག་པོར་འབེབས་པར་བྱེད།",
    "དེ་ནས་དགུང་ཞག་ནམ་རྫོགས་པར་འཇམ་མགོན་ཞལ་རྣམ་པ་གཉིས་ནས་འཁོར་ལོ་བདེ་མཆོག་ནག་པོ་ལུགས་རྡུལ་དཀྱིལ་གྱི་སྟེང་ནས་བདུན་ཕྲག་རེའི་མཚམས་སུ་དཀྱིལ་འཁོར་གཤིགས་གསོལ་དང་བཅས་ཞལ་ཕྱེ་བར་མཛད།",
    "བདེ་མཆོག་ཏུ་ཨ་ཎི་དྲུང་དང་བཙུན་མོ་ཀུན་སྐྱིད་ལགས་ནས་ཀྱང་དགོངས་རྫོགས་སྒྲུབ་མཆོད་དང་།",
    "རྗེ་བཙུན་དྲུང་འཆི་མེད་བསྟན་པའི་ཉི་མ་ནས་མཁའ་སྤྱོད་རྡོ་རྗེ་བཙུན་མོའི་སྒྲུབ་མཆོད་ཀྱང་དེ་བཞིན།",
    "གཞན་ཡང་འདུས་ཚོགས་རྣམས་རེས་བསྐོར་གྱིས།",
    "གུར་དྲག་སོགས་ཐུགས་དགོངས་ཟབ་མོ་རྫོགས་ཐབས་སྤྱི་དང་བྱེ་བྲག་ཐམས་ཅད་འཇམ་མགོན་གོང་མ་མཆོག་གི་བཀའ་གསང་གིས་འདོམས་པར་མཛད་ཅིང་།",
    "བཅོ་བརྒྱད་སྐུ་མཆེད་ནས་ཀུན་རིག་སོགས་དགོངས་པ་ཟབ་མོ་རྫོགས་ཐབས་རྒྱ་ཆེ་རྒྱུན་ཁྱོངས་སུ་མཛད་སྐབས་སྤྱི་སྒེར་ནས་མཆོད་འབུལ་བསྙེན་བཀུར་གཟབས་མས་དུས་འདས་ཤིང་།",
    "མེ་ཏོག་གི་ཆར་ནི་རྟག་པར་ཁོར་མོ་ཡུག་དང་ལོ་ལྟར་དུས་དྲན་གྱི་ཐོག་ཏུའང་འབབ་པར་བྱེད་དོ།",
    "བསམ་སྡིང་ས་རྗེ་བཙུན་སོགས་ལ་རེ་རེ།",
    "དངུལ་སྲང་ཆིག་སྟོང་ཆིག་བརྒྱ་རེ་བདུན་ཞོ་དྲུག།",
    "དེ་དག་གིས་ནི་རིགས་དང་དཀྱིལ་འཁོར་རྒྱ་མཚོའི་ཁྱབ་བདག།",
    "དེ་ཕྱིར་གང་གི་མཛད་ཕྲིན་རྒྱ་མཚོ་ཆེ།",
    "མཐོང་ཐོས་དྲན་རེག་རྗེས་འཛིན་ལྕགས་ཀྱུ་ཡིས།",
    "མགོན་པོ་ཁྱོད་ཀྱི་ཆེ་བའི་ཡོན་ཏན་ཏེ།",
    "དེ་ཕྱིར་གང་གི་གསང་གསུམ་དྲན་པ་དང་།",
    "སྐྱབས་གཅིག་འཁོན་སྟོན་ཉི་ཟླའི་བཀའ་ལུང་གི།",
    "ལས་ཉོན་ལང་ཚོ་བདོ་བའི་བཞིན་རས་ཀྱི།",
    "གང་གི་མཛད་ཕྲིན་དྲི་བསུང་མངར་པོའི་རྒྱུན།",
    "གང་གི་གསུང་གི་གདམས་པས་རྒྱུད་བརླན་ཞིང་།",
    "རྣམ་ཀུན་ཐུགས་རྗེས་འཚོ་བའི་དབུགས་དབྱུང་གིས།",
    "སྐྱབས་གཅིག་འཁོན་སྟོན་ཉི་ཟླའི་འོད་སྣང་གིས།",
    "འཛམ་གླིང་གཞི་ཆེན་ཁྱོན་ལ་ཉེར་དཀྲིགས་ཏེ།",
    "གང་གི་ཐུགས་རྗེ་དང་འཇམ་མགོན་གོང་མ་བདག་པོ་ཆེན་པོའི་བཀའི་ཕྲིན་ལས་པ་དང་བཅས་པའི་བཀའ་སྩལ་གསེར་གྱི་ཅོད་པན་སྤྱི་བོར་བཅིངས་ཏེ།",
    "བློ་གྲོས་ཅན་རྣམས་ཀྱིས་མགོ་མཇུག་ཚང་བ་ཞིབ་མོའི་བློས་རྟོག་དཔྱོད་མཛད་པས་ངོ་མཚར་ཆེ་ཆུང་དགོངས་པ་དྭངས་པར་ཡོད་ཅིང་།",
    "གཞན་དུ་གཟུ་ལུམས་ཅན་དག་གིས་ཤོག་བུ་ཁ་ཤས་བཀླགས་ཏེ་སྨྲ་བ་པོར་གཤེ་བའི་ཚུལ་གྱིས།",
    "འཇམ་མགོན་གོང་མ་བདག་པོ་ཆེན་པོ་ཞལ་རྣམ་གཉིས་བཀའི་ཕྲིན་ལས་པ་དང་བཅས་པའི་གསུང་གིས་གནང་བ་སྩལ་མ་ཐག་ནས་འགོ་བརྩམས་ཏེ་ཁྲོ་མོ་ཤིང་འབྲུག་ལོའི།",
    "རྗེ་རྡོ་རྗེ་འཆང་ཉིད་ཀྱི་འཁྲུངས་ཚེས་སུའང་གྱུར་པ་ལྷག་པ་ལྷ་མཚམས་ཀྱི་འགྲུབ་སྦྱོར་ཉིན་དབུས་གཙང་རུ་བཞི་ལས་རུ་ལག་གི་སའི་ཆ།",
    "སྟོབས་བཅུའི་དཔུང་གིས་བདུད་བཞིའི་གཡུལ་ཕམ་པས།",
    "དྲི་བྲལ་དུ་ཀཱུ་ལ་ཡི་གོས་གཅིག་གིས།",
    "གསང་གསུམ་སྒྱུ་མའི་རོལ་པ་ཐུན་མོང་དང་།",
    "ཐུན་མོང་མ་ཡིན་དག་དང་མ་དག་པའི།",
    "སྐལ་བར་ཆེ་བའི་རྟོག་བརྗོད་ཨ་མྲྀ་ཏ།",
    "སྲས་ལྕམ་ཡུམ་དང་བཙུན་མོར་བཅས་པ་ཡིས།",
    "མ་ལུས་མིང་གི་ལྷག་མ་ཉིད་གྱུར་ཅིག་༡།",
    "དམ་པ་མཆོག་གིས་རྗེས་བཟུང་རྣམ་གྲོལ་ནས།",
    "དངོས་ཉམས་འོད་གསལ་གཟིགས་སྣང་ངོ་མཚར་གྱིས།",
    "བལྟམས་ཚེ་གཟིམ་སྤྱིལ་བཙུན་མོར་འཇའ་འོད་དང་།",
    "སྒོམ་སྒྲུབ་ཉིན་ཞག་ཕྲུག་རེར་ཉེར་བདུན་བརྩམས།",
    "གཟིགས་པ་ཙམ་གྱིས་ཚིག་དོན་ཐུགས་ཆུད་དེ།",
    "དངོས་ཉམས་འོད་གསལ་གཟིགས་སྣང་དང་འགྲོགས་ནས།",
    "དུས་གསུམ་ཤེས་བྱ་གཟིགས་ལ་གསོལ་བ་འདེབས།",
    "ཕག་མོ་མིག་ལམ་སྩལ་དང་བིར་བསྲུངས་དུས།",
    "རྗེས་འབྲངས་མཁས་རྣམས་རེ་ཞིག་བཟོད་མཛོད་ལ།",
    "ཞིབ་མོའི་གཟུར་གནས་གོ་མྱོང་མཛད་འཚལ་ལོ།",
    "སྦྱངས་སྟོབས་རང་བཞིན་བརྗོད་ཀྱི་ངག་ཚིག་གི།",
    "དཔེ་ཁང་ཕྱི་ཡི་གསར་བརྗེ་དང་ནང་གི་མནོ་བསམ།",
    "བསམ་བློའི་འགྲུལ་བཞུད་རིང་མོ།",
    "དཔའ་དར་རིང་མོ།",
    "ས་ཞིང་ལ་ཆ་བཞག་ན་ཆར་ཆུ་ལྟ་བུ་དང་ལོ་ཏོག་ལ་ཆ་བཞག་ན་ས་བོན་ལྟ་བུ་ཡིན་པ་རེད།",
    "མི་བུའི་རྩིས་ཐང་བཅས་ནི་མི་ཡུལ་གྱི་གཙུག་རྒྱན་དུ་འགྱུར་ངེས་རེད།",
    "སྡིགས་དམོད།",
    "འབུར་འཇོམས་སོགས་ཀྱི་རྡོ་འཇོང་གིས་ལམ་བུའི་སྲིད་ཞེང་ཀུན་ཏུ་ཡོངས་སུ་ཁེབས་འདུག་པ་རེད།",
    "ཁོང་རྣམ་པ་གཉིས་ཀྱིས་རང་གི་གཅེས་པའི་ཚེ་སྲོག་འབེན་དུ་བཞག་སྟེ་བགྲོད་དཀའ་བའི་ལམ་བུ་གཉིས་བདམས་པ་དང་།",
    "རང་ཉིད་ཀྱི་མི་ཚེ་དེའང་རང་གིས་བདམས་པའི་ལམ་བུའི་སྟེང་དུ་མཇུག་རྫོགས་པ་རེད།",
    "དཔྱད་བརྗོད་པ་སོགས་ལྟ་བུ་རེད།",
    "དུས་ཀྱི་འགྱུར་ལྡོག་དང་མི་རང་གི་གནས་བབ།",
    "མཁྱེན་རབ་འོད་གསལ་སོགས་ཀྱིས་བརྡ་སྤྲོད་ཞིབ་འཇུག་གི་ལམ་བུ་བདམས་པ།",
    "འབྲོང་བུ་ཚེ་རིང་རྡོ་རྗེ་སོགས་ཀྱིས་ནུབ་ཕྱོགས་མཚན་ཉིད་རིག་པའི་ཁོས་ཤེར་རྟོགས་རིག་པ་ཞེས་འབོད་ཀྱིན་འདུག་ཞིབ་འཇུག་གི་ལམ་བུ་བདམས་པ།",
    "གཅོད་པ་དོན་གྲུབ་སོགས་ཀྱིས་གེ་སར་ཞིབ་འཇུག་གི་ལམ་བུ་བདམས་པ་སོགས་ལྟ་བུ་རེད།",
    "བག་ཆགས་དོང་སྤྲུག་སོགས་མི་རང་ཉིད་ནས་ཅི་ལྟར་འགོ་རྩོམ་དགོས་པའི་བླང་བྱ་ཡང་ཡང་འདོན་གྱི་ཡོད་པ་རེད།",
    "ཡིན་ནའང་ཁོང་ཚོ་ནི་སྤྱི་ལ་ཕན་ཞིང་སྒེར་ལ་གནོད་པའི་ལམ་བུ་རུ་ཞུགས་མེད་ལ།",
    "དེ་བས་ཁོང་ཚོ་ནི་ནམ་ཡང་ལག་པ་ཕུ་རུང་དུ་བཏང་སྟེ་ཟུར་ནས་ལྟ་མཁན་ཡིན་པ་ལས།",
    "བྱ་སྤྱོད་འདི་དག་གི་ཤུགས་ནས་ཅི་ཞིག་མཐོང་ཐུབ་ཅེ་ན།",
    "གཙོ་བོ་རང་བདེ་ན་སྐལ་མེད་སར་སྐེ་མི་སྲིང་ཞེས་པའི་འདོད་ཚུལ་དེ་རེད།",
    "དགག་སྒྲུབ་དང་སྐྱོན་བརྗོད་ཀྱི་བགྱི་བ་དོན་དུ་གཉེར་རྒྱུ་ནི་སླ་མོ་ཞིག་གཏན་ནས་མ་ཡིན།",
    "དེ་ལྟ་ནའང་བདག་གིས་མིང་ནས་འཛིན་པའི་འབྲི་སྟངས་དེ་བདམས་པ་ནི།",
    "འོན་ཀྱང་བདག་གིས་དེའི་ལན་དུ་ཁོ་བོ་ལ་སྤྱི་དགྲ་མ་གཏོགས་སྒེར་དགྲ་མེད་པས་ང་ལ་ནོངས་འགྱོད་ཅི་ཡང་མེད་ཅེས་འདིར།་",
    "ཡང་གཅིག་བརྗོད་ན་མིང་ནས་མ་བཟུང་བར་དགག་སྒྲུབ་དང་སྐྱོན་བརྗོད་བྱེད་པ་ནི་འགན་མ་ཁུར་བའི་རིགས་གཞུང་གཉེར་སྟངས་ཤིག་རེད་ལ།",
    "རྣམ་འགྱུར་མི་དྲང་བའི་བྱེད་སྟངས་ཤིག་ཀྱང་རེད།",
    "དེ་ལས་ཅི་ཡང་མ་བྲིས་པར་ཁ་ཁུ་སིམ་པོར་བསྡད་ན་ལེགས་པ་རེད།",
    "དེང་སང་འུ་ཅག་གི་རྩོམ་པ་པོ་མི་ཉུང་བ་ཞིག་གིས་ཟེར་དོན།",
    "ལོ་ངོ་ཉི་ཤུ་ལྷག་གི་རིང་ལ་བོད་ཀྱི་དེང་རབས་རྩོམ་རིག་གིས་གྲུབ་འབྲས་ཆེན་པོ་བླངས་ཤིང་།",
    "འཛམ་གླིང་རྩོམ་རིག་གི་རྗེས་ཀྱང་ཆོད་བཞིན་འདུག་ཅེས་རང་སྣང་སྐྱིད་པའི་འུར་སྒྲོག་གིན་ཡོད་པ་རེད།",
    "ཧྥ་རན་སིའི་ཡི་གེའཇར་མན་གྱི་ཡི་གེ་སོགས་སུའང་བསྒྱུར་འདུག་ཅེས་ངོམ་སོ་ཡང་ཡང་བྱེད་ཀྱིན་མཆིས་མོད།",
    "རིག་གི་རྗེས་ཆོད་པ་ཡིན་ན་དེ་ནི་འཛམ་གླིང་རྩོམ་རིག་གི་ཆུ་ཚད་ལ་དམའ་ཝང་ཁའེ་ཡིང་།",
    "ད་ལྟའི་འུ་ཅག་གི་རྩོམ་རིག་གི་གནས་བབ་འདི་ལ་གཞིགས་ཚེ།",
    "འུ་ཅག་གི་རྩོམ་པ་པོ་རྣམས་ལ་འགན་འཁྲིའི་འདུ་ཤེས་དང་གདུང་སེམས་ཆེན་པོ།",
    "རྒྱུ་འབྲས་བློ་མིག་སོགས་རྩོམ་མཁན་ཞིག་ལ་ངེས་པར་དུ་ཚང་དགོས་པའི་ཆ་རྐྱེན་དག་ཡེ་ནས་མེད་པས་འུ་ཅག་གི་མི་ཕལ་མོ་ཆེ་ཡིས་བོད་པ་ཚོ་ནི་གོམ་པ་སྤོ་ཤེས་ན་བྲོ་གར་འཁྲབ་ཤེས་ལ།",
    "ད་ལྟ་གོང་གི་ཡོན་ཏན་འདི་གཉིས་ཀྱི་སྟེང་ལ་ད་དུང་ཤེས་པ་གཅིག་ཁ་སྣོན་བྱེད་ཆོག་སྟེ།",
    "དེ་ནི་ཀ་ཁ་འདོན་ཤེས་ན་སྙན་ངག་འབྲི་ཤེས་ཞེས་པ་དེ་རེད།",
    "སྙན་ངག་ལ་འཇུག་མཁན་ཧ་ཅང་མང་ཞིང་སྙན་ངག་གི་བསྟན་པ་ཤིན་ཏུ་དར་བ་འདིས་ཅི་ཞིག་ཚེར་མའི་ལམ་གྱི་ང་རོ།",
    "འུ་ཅག་གི་རྩོམ་རིག་ལ་འཇུག་མཁན་གང་མང་ཞིག་གིས་སྒྱུ་རྩལ་གྱི་མཐའ་སོགས་ཀྱི་དར་ཆ་དགུང་ལ་ཕྱར་ཏེ་མི་ཚེའི་འདུན་མ་རྩོམ་རིག་ལ་བཅོལ་བ་དང་།",
    "རྩོམ་རིག་ནི་ནོར་བུ་དགོས་འདོད་དཔུང་འཇོམས་ཤིག་ཏུ་མཐོང་ནས་དེ་ལས་ཟས་དགོས་ན་ཟས་དང་གོས་དགོས་ན་གོས་སྟེར་བ་ལྟ་བུར་ངོས་འཛིན་གྱིན་འདུག་རྩོམ་རིག་གི་མཛེས་སྡུག་ལ་རབ་ཏུ་དུངས་ཤིང་།",
    "སྙན་ངག་འབྲི་མཁན་ཀུན་གྱི་སེམས་ཁོང་དུ་དགའ་སྐྱོ་ཆགས་སྡང་གི་ཚོར་པ་སྐྱེན་པོ་ཞིག་ཡོད་ལས་ཆེ་ནའང་།",
    "དཀའ་སྡུག་གི་འཚོ་བ་སོགས་མཐོང་ཚེ།",
    "ད་དུང་སྙན་ངག་ཐན་ཐུན་རེ་བྲིས་ཏེ་སྡོད་པ་ནི་ངོ་ཚ་ཞིག་མ་ཡིན་ནམ།",
    "རྩོམ་རིག་ལ་འཇུག་མཁན་ཀུན་གྱིས་སྒྱུ་རྩལ་གྱི་ཆེད་དུ་སྒྱུ་རྩལ་བྱེད་དོ་ཞེས་མཛེས་སྡུག་གི་བསླུ་བྲིད་ཅིག་ལ་ཁ་གཡར་ཆོག་ནའང་།",
    "ཡིན་པས་དོན་གྱིས་ཁོ་ཚོ་ནི་སྒྱུ་རྩལ་གྱི་དགྲ་བོ་རེད།",
    "སྒྱུ་རྩལ་རྣལ་མའི་རྫུན་གཏམ་གྱིས་དངོས་ཡོད་ཀྱི་བདེན་དོན་སྦས་པར་བྱེད་པ་རེད།",
    "ཨུ་རུ་སུའི་རྩོམ་མཁན་ཆེན་མོ་ཐོལ་སི་ཏོའེ་ལགས་ཀྱིས།",
    "འུ་ཅག་ནི་ཏག་ཏག་ཐོལ་སི་ཏོའེ་ཡིས་གསུངས་པའི་ཉེན་ཁ་འདི་ལ་ཐུག་འདུག་པ་རེད།",
    "རྒྱའི་ན་གཞོན་རྩོམ་རིག་དཔྱད་བརྗོད་མཁན་ཧོ་ཞུང་ཧྥེ་ལགས་ན་རེ།",
    "རྩོམ་རིག་གི་ཐབས་རྩལ་ནི་ཇི་ལྟར་ཁྱད་དུ་འཕགས་ན།",
    "ཀློག་པ་པོ་རྣམས་ཀྱིས་ཁོ་བོའི་རྩོམ་ཐུང་འདིའི་ཁ་བྱང་ལ་སྒྱུ་རྩལ་གྱི་དགྲ་བོ་ཞེས་འདོགས་པའི་དགོས་པ་དང་དམིགས་ཡུལ་ཡང་ཞོར་ལ་རྟོགས་འོང་གི་རེད།",
    "ཁྱེད་རྣམ་པ་བདེ་མོ་ཡིན་ནམ།",
    "ཁྱེད་བདེ་མོ་ཡིན་ནམ།",
    "ང་བདེ་མོ་ཡིན།",
    "མགོ་འཛིན་པ་ཁྱེད་རང་བདེ་མོ་ཡིན་ནམ།",
    "བདེ་མོ་ཡིན།",
