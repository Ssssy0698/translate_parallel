    "རྟེན་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བུ་ཕོ་འདོད་པ་ལ་ནི་བུ་ཕོ་ཡོངས་སུ་གཏོང་བུ་མོ་འདོད་པ་ལ་ནི་བུ་མོ།",
    "ཅིའི་ཕྱིར་འཇིག་རྟེན་པའི་སྦྱིན་པའི་ཕ་རོལ་དུ་ཕྱིན་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་ར་དྭ་ཏིའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བརྩོན་འགྲུས་རྩོམ་མོ།",
    "དེ་འདི་སྙམ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གཟུགས་མེད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འཚོ་སྐྱོང་བ་དེ་དག་གིས་ཀྱང་།",
    "ཚེ་དང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཚེ་དང་ལྡན་པ་ཤཱ་ར་དྭ་ཏིའི་བུ་ཚོར་བ་དང་འདུ་ཤེས་དང་འདུ་བྱེད་དང་རྣམ་པར་ཤེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྦྱིན་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དབེན་པའི་ཕྱིར་ཡིད་ལ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཡིད་ལ་བྱེད་པ་མེད་པར་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "འཕགས་པའི་ལམ་ཡན་ལག་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རབ་འབྱོར་ཁྱོད་ཇི་ལྟར་སྟོན་པ་དེ་བཞིན་དུ།",
    "རབ་ཏུ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གནས་གཙང་མའི་བར་གྱི་ལྷའི་བུ་ཇི་སྙེད་ཡོད་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ལས་ཀྱི་རྣམ་པར་སྨིན་པ་ལས་སྐྱེས་པའི་ལུས་ཀྱི་འོད་གང་ཡིན་པ་དེ་དག་གིས།",
    "བརྒྱའི་ཆར་ཡང་ཉེ་བར་མ་སོང་།",
    "སྟོང་གི་ཆར་ཡང་ཉེ་བར་མ་སོང་།",
    "བརྒྱ་སྟོང་གི་ཆར་ཡང་ཉེ་བར་མ་སོང་།",
    "བྱེ་བ་ཁྲག་ཁྲིག་བརྒྱ་སྟོང་གི་ཆར་ཡང་ཉེ་བར་མ་སོང་།",
    "དེ་བཞིན་གཤེགས་པའི་འོད་འབའ་ཤིག་དེ་དག་གི་ནང་ན་དམ་པར་སྣང་ངོ།",
    "བཙུན་པ་རབ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཐུགས་རྗེའི་ཕྱག་གིས་མི་གཏོང་བར།",
    "ཅེས་པའང་གཞོན་ནུ་དྷརྨ་མ་ཏིས་དད་མོས་དྲག་པོས་གསོལ་བ་བཏབ་པ་སིདྡྷི་བྷ་ཝ་ཏུ།",
    "འཁོར་གྱིས་ཞུས་པ་སྟོན་པས་གནང་ཚུལ་། ན་མོ་ཤྲཱི་བཛྲ་ས་ཏྲ་ཡེ།",
    "དངོས་པོ་ངེས་པར་བསྟན་པའི་ངག་གིས་ལམ་ཡངས་པོར་བྱས་ནས།",
    "གསུང་གི་གསང་བ་ལམ་དུ་བྱེད་པ་དང་།",
    "དེ་ལ་བརྟེན་པའི་ཀུན་རྫོབ་ཕུང་ཁམས་སྐྱེ་མཆེད་ཐམས་ཅད་སྤང་བླང་མེད་པར་ལྷ་དང་གཞལ་ཡས་ཁང་གི་བཀོད་པར་གཏན་ལ་འབེབས་པས་ཟབ་པ་དང་རྒྱ་ཆེ་བའི་དོན་ལ་རྨོངས་པ་མེད་པ་ཡིན་ནོ།",
    "བསྒྲུབ་བྱ་ཐུན་མོང་གི་ཡོ་བྱེད་ལྟ་བུ་གཅིག་ལ་ཡང་།",
    "འོ་ན་གང་གི་སྒོ་ནས་ཁྱད་པར་འཕགས་སྙམ་ན་ཡུལ་ཅན་ལྟ་བའི་སྒོ་ནས་ཁྱད་པར་དུ་འཔགས་ཏེ།",
    "བཙུན་མོའི་ཚོགས་དང་ལྡན་པར་གནས་ ཞེས་གསུངས་པ་ལྟར་རོ།",
    "དུར་ཁྲོད་རབ་ཀྱི་སྟེང་ལ་སོགས་པའི་གནས་གཙང་མར་མོས་པ་བྱེད་པ་ནི་ཕྱི་པ་དང་།",
    "བཞི་པ་བྱ་རིམ་སྤྱོད་ལ་སོགས་པའི་གནས་སུ་མོས་པ་བྱེད་པ་ནི་སྔགས་ནང་པ་ཡིན་ནོཁྲུས་དང་གཙང་སྦྲ་སོགས་གཙོ་བོར་སྤྱོད་ན་ཕྱི་པ་སྟེ།",
    "བཅུ་གཉིས་བཅུ་བཞི་བཅུ་དྲུག་གིས།",
    "དཔྱལ་ལོ་ཀུན་རྡོར་ཡང་ངེས་ཚིག་གི་ཁྱད་པར་འདི་ལེགས་པར་བཞད་དོ།",
    "བསྐྱེད་ཆོག་གི་སྤྲོས་པ་ཉེ་བར་བསྡུས་ཀྱང་དབྱིངས་དང་ཡེ་ཤེས་ལམ་བྱེད་ཀྱི་ཕྱོགས་གཉིས་ལ་རིམ་གྱིས་སློབ་པ་དང་།",
    "བཅོས་མའི་བསྐྱེད་ཆོག་ལ་མི་ལྟོས་པར་རྩོལ་མེད་རང་བཞག་གི་ཐབས་ཀྱིས་ཡེ་ཤེས་མངོན་དུ་བྱེད་པའོ།",
    "གཉིས་པ་དང་གསུམ་པ་གཙོར་སྟོན་པ་རིམ་བཞིན་མཧཱ་སོགས་གསུམ་དུ་བཞག་པར་ཁས་བླངས་ན་རེ་ཞིག་འཆད་བདེ་ཞིང་རོག་གི་བཞེད་པ་དང་ཡང་མཐུན་ནོ།",
    "རྩོལ་མེད་ཟུང་འཇུག་གི་ཡེ་ཤེས་གཙོ་བོར་སྟོན་པ་ཨ་ཏི་སྟེ།",
    "གནུབས་ཀྱིས་ཀྱང་རྣལ་འབྱོར་མིག་གི་བསམ་གཏན་གྱི་འགྲེལ་པར་མཧཱའི་འདོད་གཞུང་དུ་འཆད་པའི་ཚེའང་རྒྱུད་འདི་ལ་བརྟེན་ནས་འཆདཔར་མཛད་དོ།",
    "དེ་བཞིན་དུ་ཟུར་ལུགས་པ་དག་གི་རྒྱུད་འདི་མཧཱའི་རང་གཞུང་དུ་འཆད་པ་ཡང་རྒྱུད་ཀྱི་དངོས་བསྟན་ལྟར་དུ་བཀྲལ་བ་ཡིན་པས།",
    "རྒྱུད་ཀྱི་དངོས་བསྟན་ཙམ་ལ་ནི་ཀུན་མཁྱེན་ཆེན་པོས་ཀྱང་མཧཱའི་རང་གཞུང་དུ་མི་བཞེད་པ་ག་ལ་འོང་སྙམ་མོ།",
    "རྒྱུད་དོན་གླེང་བའི་གཞི་གྱུར་པའི་གླེང་གཞི་ལ་དབྱེ་ན་ཐུན་མོང་དང་ཐུན་མོང་མིན་པའི་གླེང་གཞི་གཉིས་ཕྱིར་རོ།",
    "སོ་། དང་པོ་ཐུན་མོང་གི་གླེང་གཞི་ལའང་གསུམ་ལས།",
    "རྟགས་ཀྱི་འོག་མིན་དབྱིངས་དང་ཡེ་ཤེས་དབྱེར་མེད་ཀྱི་རྟགས་གཞལ་ཡས་ཁང་གི་དབྱིབས་དང་ཁ་ནི་དོག་ཏུ་སྣང་བ་སྟེ།",
    "མཐའ་དབུས་ཕྱོགས་ཆ་གང་དུའང་གཞག་ཏུ་མེད་ཅིང་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བའི་ངོ་བོ་མཐར་ཐུག་གི་བགྲོད་བྱ་དམ་པ་གང་ཞིག།",
    "སྐད་ཅིག་གཅིག་གིས་སྣང་བར་མཛད་ ཅེས་སོ།",
    "གཉིས་པ་འདྲེས་མའི་ཚུལ་དུ་གཙང་མའི་རིས་ཀྱི་འོག་མིན་བསྟན་པ་ནི་དེ་ཡང་འགྲོ་བ་རང་རང་གི་སྣང་བ་དང་མཐུན་པའི་གནས་ཀྱི་མཆོག་གཟུགས་ཁམས་བསམ་གཏན་བཞི་པའི་གནས་གཙང་མའི་རིས་ཀྱི་འོག་མིན་རགས་པའི་དངོས་པོ་མ་ཡིན་པ།",
    "དབྱིབས་དང་གློ་འབུར་རྩེ་མོ་དང་།",
    "གཞལ་ཡས་ཁང་གི་གཞི་ནི་དབྱིངས་དང་ཡེ་ཤེས་གཉིས་སུ་མེད་པའི་འཁོར་ལོ་རྩིབས་བཞི་ལྟེ་བར།",
    "རྒྱ་ཁྱོན་ནི་ཕྱོགས་ལྷུང་བྲལ་བའི་ཕྱིར་མཐའ་དབུས་མེད་པ།",
    "དེ་དག་ཀྱང་ཟུར་པའི་བཀའ་སྲོལ་འཛིན་པ་དག་གིས་གདུལ་བྱ་རང་རྒྱུད་པ་དང་།",
    "དབུས་སུ་རྣམ་པར་སྣང་མཛད་གཙོ་ ཞེས་སོགས་ཀྱི་ལུང་གིས་སྒྲུབ་པར་མཛད་དོ།",
    "གླང་ཆེན་རབ་འབོག་གི་རྒྱུད་དང་།",
    "ཐུན་མོང་གི་རྒྱུད་ལྟར་ན་ཐུགས་ཀྱི་རིགས་མི་བསྐྱོད་པ་ཡིན་པར་ཀུན་མཁྱེན་ཆེན་པོས་ཀྱང་བཞེད་པའི་ཕྱིར་རོ།",
    "ཀུན་གཟིགས་ཀུན་བཟང་སྐུ་ལ་རྒྱབ་མདུན་མེད།",
    "ཕྱོགས་བཅུ་གང་བར་སྤྱན་གྱིས་རྣམ་པར་གཟིགས།",
    "ཐུན་མོང་དང་ཐུན་མིན་གྱི་མཚན་དཔེའི་བདག་ཉིད་དུ་སྣང་བ་ཡིན་ཏེ།",
    "དེ་ཡང་ཐུན་མོང་གི་མཚན་བཟང་ནི།",
    "སེམས་དཔའ་བཅུ་དྲུག་ལ་དབུ་རྒྱན་གྱི་ལྷ་ལྔ་རེ་བརྩིས་པས་དབུ་རྒྱན་གྱི་ལྷ་བརྒྱད་བཅུ་ནི་སྐབས་འདིར་དཔེ་བྱད་བརྒྱད་བཅུ་སྟེ།",
    "མཚན་གྱི་མེ་ཏོག་གིས་མཛེས་ཤིང་དཔེ་བྱད་ཀྱི་འབྲས་བུ་སྤྲས་པའི་ཕྱིར་སྲས་ཀྱི་ཚོགས་ཀུན་ནས་བསྐོར་བའོ།",
    "མཚན་དཔེ་འདི་དག་ལོངས་སྐུ་ཁོ་ན་ལ་ཡོད་པའི་ཕྱིར་ཐུན་མོང་མ་ཡིན་པའོ།",
    "ཡབ་ཡུམ་གཉིས་ལ་དགའ་བ་བཅུ་དྲུག་རེ་ལྡན་པ་ནི་མཚན་བཟང་སོ་གཉིས་དང་།",
    "ཡབ་ཀྱི་དགའ་བ་བཅུ་དྲུག་རེ་རེ་ལའང་ཡེ་ཤེས་ལྔ་རེ་ལྡན་པ་ནི་དཔེ་བྱད་བརྒྱད་ཅུའོ།",
    "ཡུམ་གྱི་དགའ་བ་བཅུ་དྲུག་ལ་ཡེ་ཤེས་ལྔ་རེ་ལྡན་ཡང་དཔེ་བྱད་དུ་མ་བགྲངས་པ་ནི།",
    "ཡུམ་ཞབས་མཐིལ་གཉིས་སྤྲད་པའི་སེམས་མའི་སྐྱིལ་ཀྲུང་གིས་འཁྲིལ་ནས་བཞུགས་པའོ།",
    "ཡེ་ཤེས་ལྔ་དང་རང་བྱུང་གི་ཡེ་ཤེས་བཅས་ཡེ་ཤེས་དྲུག་བརྙེས་པའི་རྟགས་སུ་ཕྱག་དྲུག་དང་།",
    "ཐམས་ཅད་དུ་ཞལ་ཐལ་ལེ་བར་གསལ་ཞིང་མཚན་དང་དཔེ་བྱད་ལྡན་པ་སོགས་ནས།",
    "དེ་དག་གི་དོན་ལ་ཁ་ཅིག་གིས་དགའ་བ་བཞིའི་ཡེ་ཤེས་སོ་ཞེས་སྦྱོར་བ་ཡང་སྐབས་དང་འབྲེལ་བར་མ་མཐོང་སྟེ།",
    "དེ་ལ་རྟོག་པ་དང་ལྡན་པ་ན་རེ།",
    "འོག་མིན་དུ་རྒྱུད་གསུངས་མི་དགོས་པར་ཐལ།",
    "དེར་ཐལ་འོག་མིན་དུ་སྟོན་པས་རང་སྣང་གི་འཁོར་ལ་རྒྱུད་མ་གསུངས་ན།",
    "ཡང་ཁ་ཅིག་ན་རེ།",
    "འབྲས་བུ་ངན་སོང་གི་སྡུག་བསྔལ་དཔག་ཏུ་མེད་པ་མྱོང་ནས།",
    "བུད་མེད་སྒྱུ་མ་ཁྱད་པར་ཆེ།",
    "གང་གིས་དམ་པའི་བདེ་བས་ཁྱོད་། སྐྱེ་བ་འདིར་ནི་འཐོབ་པར་འགྱུར།",
    "ཡས་མན་གྱི་འཇིག་རྟེན་དྲུག་གི་ཕྱོགས་བཅུ་མཐའ་ཡས་མུ་མེད་པ།",
    "ཞེས་གསུངས་པ་ལྟར་འགྲོ་བ་དྲུག་གི་སྣང་ཚུལ་དང་མཐུན་པའི་སྤྱི་ལྡོག་ནས་བཟུང་བར་བྱའོ།",
    "ཐུབ་པ་དྲུག་གིས་སྤྲུལ་པ་གྲངས་མེད་པ་དང་ཞེས་སོགས་གསུངས་པས་སོ།",
    "ཁྲག་གི་དྭང་མ་མཚལ་ཁུ་ལྟ་བུ་དང་།",
    "མངོན་བྱང་གི་སྐུའོ།",
    "ཁྲག་གི་དྭང་མ་ཆུ་སྟེ་ཡུམ་མཱ་མ་ཀཱི།",
    "གོས་དཀར་མོ།"
  ]
}