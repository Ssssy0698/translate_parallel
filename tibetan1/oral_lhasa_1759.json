    "དེ་རྣམས་ཀྱང་མེད་པར་འགྱུར་ལ།",
    "ཐ་སྙད་ལ་ནི་མ་བརྟེན་པར།",
    "ཞེས་གསུངས་པ་ཡིན་ནོ།",
    "པ་ཞེས་པ་ཇི་ལྟ་བུ་ཞེ་ན་ཡུལ་གང་དང་གང་ཡིན་པའི་དོན་དེའི་རྣམ་པ་སྤྱི་ཙམ་ཡིད་བློར་སྣང་བ་ལ་དེ་དང་དེའི་མིང་དང་བསྲེས་ཏེ་འཛིན་པ་དཔེར་ན་ཀ་བ་དང་བུམ་པ་ཞེས་སུ་རྣམ་པར་རྟོག་པའམ་ཡིད་ཀྱིས་བརྗོད་པ་ནི་ཡིད་རྟོག་བཅས་ཞེས་བྱའོ།",
    "ཆུ་ཤག་ཤག་འབབ་པའི་སྒྲ་ཐོས་པ་ན།",
    "རྒྱང་རིང་པོའི་ཆུ་ཡི་རྗེས་སུ་སྙོགས་ཤེས་པ་ལྟ་བུས་དེ་ཡི་ཚུལ་ཤེས་པར་བྱེད་དོ།",
    "རྗེས་སུ་དཔག་པ་དང་བསླབ་པའི་གནས་གང་ཡང་བསྟན་པར་མི་ནུས་ཏེ།",
    "མངོན་སུམ་ལ་ནི་རང་དུས་ཀྱི་རང་ཡུལ་དེའི་ཆ་ཤས་རྣམས་དང་སྐད་ཅིག་མའི་རང་མཚན་སིལ་བུ་ཕན་ཚུན་མ་འདྲེས་པར་གནས་པ་ཙམ་སྣང་བ་དེ་ནི་མིང་དང་འདྲེས་སུ་མི་རུང་པས་དེ་ཁོ་ན་ལ་ཐ་སྙད་ཀྱི་དོན་སྦྱར་བ་མེད་དོ།",
    "རྟོག་པ་འདིས་ནི་ད་ལྟ་མཐོང་བའི་ཡུལ་ལ་མིང་དང་རིགས་སོགས་སྦྱར་ནས་འཛིན་པ་ཀུན་རྫོབ་ཀྱི་རྟོག་པའམ་བརྡ་རྟེན་ཅན་གྱི་རྟོག་པ་ཞེས་བརྗོད་པ་དེ་ཙམ་ཁོ་ན་བྱེད་པར་མ་ཟད་ཀྱི།",
    "བླང་དོར་འཇུག་ལྡོག་གང་ཡང་མི་བྱེད་པར་འགྱུར་རོ།",
    "རྟོག་བཅས་ཀྱི་ཡིད་འདི་ལ་ཡང་ཐག་པ་ལ་ཐག་པར་རྟོག་པ་དང་།",
    "མ་འཁྲུལ་པའི་རྟོག་པ་ལ་བརྟེན་ནས་དུས་གསུམ་ཤེས་བྱའི་ཐ་སྙད་ཐམས་ཅད་མ་ནོར་བར་འབྱེད་པར་བྱེད་པ་ཡིན་ནོ།",
    "རྟགས་བྱས་པ་ལྟ་བུ་དེ་ཡོད་མེད་དཔྱད་པར་བྱའོ།",
    "རྟགས་བྱས་པའི་རྗེས་སུ་མི་རྟག་པ་འགྲོ་བ་ལྟ་བུའོ།",
    "དོན་དུ་བུར་རོ་ད་ལྟ་བ་ལས་སྔ་མ་དང་ད་ལྟའི་རོ་གཟུགས་གཉིས་ཚོགས་པ་གཅིག་པར་རྒྱུ་སྔ་མས་བསྐྱེད་པ་དཔོགས་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ལྟར་འབྲས་བུས་རྒྱུ་སྒྲུབ་ཚུལ་དུ་མ་ཡོད་པའི་སྤུ་རིས་ཕྱེས་པ་འདིས་ཆུ་མི་གཡོ་བ་ལས་རྟེན་བརྟེན་པ་སོགས་འབྲས་བུས་རྒྱུ་དཔོགས་པའི་རིགས་མཐུན་ཐམས་ཅད་འབྲས་རྟགས་ཀྱི་ཁོངས་སུ་བསྡུ་ཤེས་པར་བྱའོ།",
    "བྱས་པའི་ཕྱིར་རམ་སྐེས་པའི་ཕྱིར་ལྟ་བུ།",
    "ཁྱད་པར་ལྟོས་པ་པ་དང་།",
    "ཁྱད་པར་དག་པ་པའི་རང་བཞིན་གྱི་རྟགས་སྦྱོར་ཞེས་བྱ་སྟེ།",
    "མེས་ཁྱབ་པའི་ཕྱིར་ཞེས་པ་རྟགས་སུ་བྱས་ནས།",
    "སྤྱིར་མེའི་དངོས་རྒྱུ་ནུས་པ་མཐུ་ཅན་ཡོད་པར།",
    "རྟགས་གསུམ་གྱི་རིགས་ཅན་གྱི་སྦྱོར་བ་གཞན་རྣམས་ཀྱང་འདི་གསུམ་ཁོངས་སུ་སྡུད་པར་བྱ་སྟེ།",
    "དེ་ལ་བརྟེན་ནས་གང་ཟག་གཞན་ལ་ཡང་རིགས་པ་དང་མཐུན་པར་དོན་གང་ཡིན་པ་སྒྲུབ་པ་དང་།",
    "དོན་དང་མི་མཐུན་པར་སྨྲ་བ་ལ་སུན་འབྱིན་བརྗོད་པ་ནི་གཞན་དོན་གྱི་རྗེས་དཔག་ཅེས་བྱའོ།",
    "སྒྲ་རྟག་པར་འདོད་པའི་ཕྱི་རོལ་པ་སུན་འབྱིན་ཕྱིར།",
    "སྒྲ་མི་རྟག་སྟེ་བྱས་པའི་ཕྱིར་ལྟ་བུ་རང་རྒྱུད་དུ་འགོད་པ་དང་།",
    "གང་ཞིག་འབེལ་བའི་གཏམ་རྣམ་པར་ངེས་པས་གཞན་དང་རྩོད་པར་བྱ་བ་ལ།",
    "དམ་བཅའ་བའི་དོན་ཡོངས་སུ་གྲུབ་པའི་སྨྲ་བ་དེའི་རྨེད་ཕྱོགས་སུ་ཁྱེར་ནས་གྲགས་པར་འགྱུར་བ་ཡིན་ལ།",
    "ཕྱོགས་ངན་པར་ཞེན་པའི་ཉེས་པས་མཁས་པའི་འཇུག་སྒོ།",
    "མཉམ་པར་བཞག་ཀྱང་རྣམ་པར་གྲོལ་བ་དཀོན་པའོ།",
    "བརྗོད་འདོད་ཀྱི་རྣམ་པར་བཞག་པའི་ཚིག་ལས་སྐབས་ཀྱི་དོན་གོ་ན།",
    "དོན་དམ་པ་ལ་དགོངས་ནས་ངོ་བོ་ཉིད་མེད་པ་དང་གདོད་ནས་མྱ་ངན་ལས་འདས་པ་སོགས་སུ་གསུངས་པ་ལྟ་བུའོ།",
    "རིགས་གཟུགས་འབྱོར་པ་སོགས་ཀྱི་ང་རྒྱལ་ཅན་ལ་ཞིང་གཞན་དང་གང་ཟག་གཞན་གྱི་བསྔགས་པ་བརྗོད་པས་རང་ལ་དམན་པར་འདུ་ཤེས་པར་མཛད་པ་དང་།",
    "ཟག་བཅས་ཀྱི་ཡུལ་ལ་འདོད་ཆགས་པའི་གཉེན་པོར་འཇིག་རྟེན་ལས་འདས་པའི་འབྱོར་པ་ཁྱད་པར་དུ་བསྔགས་པ་དང་།",
    "བཤགས་པའམ་ཉེས་པ་ཟད་ནས་ནམ་ཞིག་བདེ་བ་བྱེད་པ་ལ་དགོངས་པ་དང་།",
    "གང་ཞིག་ཚིག་བློ་ལ་འཛིན་པའམ་དེའི་དོན་ཡིད་ལ་བྱེད་པར་རབ་ཏུ་སྦྱོར་བའི་སྒོ་ནས་ཚིགས་སུ་བཅད་པ་གཉིས་པའི་གཟུངས་ལས་གསུངས་པ་ལྟ་བུ།",
    "རིགས་ཀྱི་ཁམས་རྫོགས་པར་བརྟས་པ་དང་།",
    "ཞེས་གསུངས་པ་ལྟ་བུ་སྟེ།",
    "དེ་ལས་བཟློག་པ་མཐར་ཐུག་དཔྱོད་པའི་རིགས་པས་གྲུབ་པ་རྣམས་ངེས་དོན་དུ་ཤེས་པར་བྱ་ཞིང་།",
    "དོན་དེ་ལྟ་བུའི་ཕྱིར་ན་དྲང་དོན་ལ་མི་རྟོན་ངེས་དོན་ལ་རྟོན་པར་བྱའོ།",
    "ངེས་པའི་དོན་དེ་ལའང་དོན་གྱི་སྤྱི་ཙམ་འཛིན་པ་རྣམ་པར་རྟོག་པའི་སྤྱོད་ཡུལ་དུ་གྱུར་པ་དང་།",
    "རང་མཚན་བརྗོད་དུ་མེད་པ་སོ་སོ་རང་རིག་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱི་སྤྱོད་ཡུལ་དུ་གྱུར་པ་གཉིས་ཡོད་པ་ལས།",
    "རྒྱས་པར་དོན་རྣམ་པར་ངེས་པ་ཤེས་རབ་རལ་གྲི་ལས་རྟོགས་པར་བྱའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞིའི་སྐབས་སོ།",
    "འདི་ཉིད་ལེགས་པར་རྟོགས་ན།",
    "མུ་མཐའ་མེད་པར་རོལ་ཞིང་དགའ་བར་འགྱུར།",
    "རྙེད་བཀུར་གྲགས་འདོད་སོགས་ཀྱི་མ་བསླད་པར།",
    "ལེགས་པར་སྦྱར་འདིས་བསྟན་འགྲོར་ཕན་གྱུར་ཅིག།",
    "མཁྱེན་རབ་བདག་པོའི་གོ་འཕང་འགྲུབ་གྱུར་ཅིག།"
  ]
}