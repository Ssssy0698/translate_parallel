    "བསྐལ་པ་གྲངས་མེད་པར་རྫོགས་སྨིན་སྦྱང་བ་རྒྱ་མཚོ་ལྟ་བུ་ལ་འཇུག་པར་འདོད་པ་དེས།",
    "བདག་མེད་གཉིས་ཀ་ཡོངས་སུ་རྫོགས་པར་རྟོགས་པའི་ཟབ་པ་དང་།",
    "བརྩོན་འགྲུས་ཆེན་པོ་བསྐལ་པ་གྲངས་མེད་པ་གསུམ་ལ་སོགས་པར་རྫོགས་སྨིན་སྦྱང་བ་ལ་འཇུག་པ་དང་།",
    "རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱིས་བཟུང་བས་ཡོངས་སུ་དག་པ་དང་།",
    "ས་བཅུར་གོང་ནས་གོང་དུ་འཕགས་པར་སྒྲུབ་པའོ།",
    "དེ་གཉིས་ཟུང་འཇུག་ཏུ་སྒྲུབ་པར་བྱེད་པའི་ལམ་ལ་དམིགས་ནས་ལམ་དང་ས་གོང་ནས་གོང་དུ་ཁྱད་པར་དུ་འཕགས་པའི་སྒོ་ནས་དམིགས་པར་བྱེད་པའོ།",
    "ཡང་ཁྱད་པར་གསུམ་གྱིས་འཕགས་ཏེ།",
    "དེ་ཡང་འབད་མེད་ལྷུན་གྲུབ་ཏུ་མཛད་པ་གསུམ་ནི་སེམས་ཆེན་པོའི་ཁྱད་པར་རོ།",
    "ཤེས་བྱའི་རྣམ་པ་ཐམས་ཅད་མངོན་སུམ་མཁྱེན་པ་རྟོགས་པ་ཆེན་པོ་སྟེ།",
    "དེ་ཡང་གོང་དུ་འཕེལ་ཏེ་གཞན་དོན་ཁུར་ཁྱེར་དང་ལམ་ལ་ལྷག་པར་སློབ་པ་ནི་ལྷག་བསམ་ཞེས་བྱ་སྟེ།",
    "གཞན་ཡང་ཤེས་རབ་ཁྱད་པར་ཅན་གྱི་གནས་སྐབས་ལས།",
    "ཡེ་ཤེས་ནི་རྟག་པའོ་ཞེས་གསུངས་པ་ལ་སོགས་པ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དམིགས་པ་མེད་པ་གསུམ་གྱི་རྣམ་གྲངས་གསུངས་པ་ལས།",
    "ལས་ཁྱད་པར་དུ་འཕགས་པ་ཡིན་ནོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་བཞིའི།",
    "ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པ་ནི།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པ་ནི།",
    "གདུལ་བྱ་དང་འཚམས་པར་རྒྱས་བསྡུས་དང་ཀླ་ཀྲ་པ་དང་རྒྱ་ཆེ་ཁ་སོགས་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་འཆད་ནུས་པའི་སྤོབས་པ་མི་ཟད་ཅིང་ཐོགས་པ་མེད་པའོ།",
    "ངེས་པའི་དོན་ལ་ཡིད་འཇུག་ཅིང་གཏོད་པར་བྱེད་པའོ།",
    "ཚོགས་གཉིས་པོ་འདི་ནི་ཐེག་ཆེན་ལམ་དང་འབྲས་བུའི་ཡོན་ཏན་ཐམས་ཅད་ཀྱི་རྒྱུ་ཡིན་པས་འདི་དང་མཚུངས་པར་ལྡན་པའི་སེམས་བསྐྱེད་ལ་བང་མཛོད་ལྟ་བུ་ཞེས་བྱའོ།",
    "འོག་མ་རྣམས་ཀྱི་སྐབས་སུའང་གྲོགས་དེ་ལྟར་ཤེས་པར་བྱའོ།",
    "དོན་དམ་པར་མཐའ་ཀུན་དང་བྲལ་བའི་སྤྲོས་བྲལ་དུ་ལྟ་ཞིང་དེ་ལས་མ་ཡེངས་པར་གོམས་པར་བྱེད་པའོ།",
    "ཡང་དག་པར་སྤོང་བ་བཞི་ནི།",
    "སྐྱེས་པ་མི་ཉམས་པར་བྱེད་པའོ།",
    "དེ་ཡང་འདུན་པའི་ཏིང་ངེ་འཛིན་ནི་དམིགས་པ་ལ་སེམས་འཇོག་པར་འདུན་པའི་གུས་སྦྱོར་ཡིན་ཞིང་།",
    "དེ་དག་ནི་སྤོང་བའི་འདུ་བྱེད་བརྒྱད་བརྟེན་ནས་གོང་ནས་གོང་དུ་གོམས་པར་བྱེད་ལ།",
    "མི་བརྗེད་པར་གནས་པ་དང་།",
    "ངག་དང་ལས་མཐའ་འཚོ་བ་གསུམ་ནི་གཞན་ཡིད་ཆེས་པར་བྱེད་པའི་ཡན་ལག་སྟེ།",
    "འཚོ་བ་རྣམ་པར་དག་པར་ཡིད་ཆེས་པར་བྱེད་པའོ།",
    "མཐོང་སྒོམ་གྱིས་སྤང་བྱའི་རྟོག་པ་ཡུམ་དང་མངོན་རྟོགས་རྒྱན་ལས་གསུངས་པ་ལྟ་བུ་སྟེ་རྫས་སུ་འཛིན་པ་ནི་བྱང་འཕགས་ལ་རྗེས་ཐོབ་ཏུ་ཡང་མེད་ལ།",
    "གཉེན་པོས་ཞི་ན་ཡང་ཧ་ཅང་འདུ་བྱེད་པ་གཉིས་ཀྱིས་ཏིང་ངེ་འཛིན་ཁྱད་པར་དུ་འཕེལ་བར་བྱེད་པ་ལ་སྒྲིབ་བོ།",
    "དམིགས་པ་མ་བརྗེད་པར་དྲན་པས་གདམས་ངག་བརྗེད་པ་སྤོང་ཤེས་བཞིན་གྱིས་བྱིང་རྒོད་བྱུང་བ་རྟོགས་ནས།",
    "བཏང་སྙོམས་ཀྱིས་བྱིང་རྒོད་ཞི་ཚེ་གཉེན་པོ་འདུ་བྱེད་པ་སྤངས་ནས་རྣལ་དུ་འཇུག་པར་བྱེད་དོ།",
    "དེ་ལྟར་བཞག་པས་གོང་ནས་གོང་དུ་སེམས་དམིགས་པ་ལ་ནང་དུ་སྡུད་པ་ཇེ་ཆེར་བྱས་པ་ཉེ་བར་འཇོག་པ།",
    "དེ་ནས་གཡེང་བའི་རྒྱུ་ཅན་གྱི་ཉེ་ཉོན་བརྣབ་སེམས་རྨུགས་གཉིད་ཡིད་མི་བདེ་སོགས་ལྡང་བ་རྣམ་པར་ཞི་བར་བྱེད༵།",
    "བརྒྱད་པ་ལ་རྩོལ་བ་མ་བཏང་ན་བྱིང་རྒོད་ཀྱི་བར་ཆད་མི་ནུས་པས་ཐུན་གྱི་རྒྱུན་རིང་པོར་སྐྱོང་ཐུབ་པ་ལ་ཆད་པ་མེད་པར་འཇུག་པའི་ཡིད་བྱེད།",
    "དགུ་པར་འབད་མེད་དུ་རྒྱུན་འཇུག་པས་རྩོལ་བ་མེད་པར་འཇུག་པའི་ཡིད་བྱེད་ཅེས་བྱའོ།",
    "ཞི་གནས་དང་བསམ་གཟུགས་ཀྱི་ཏིང་ངེ་འཛིན་ལ་བརྟེན་ནས་བདེན་པའི་རྣམ་ཅན་གྱི་འདས་ལམ་སྒྲུབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "ལས་འཕགས་པར་འཛིན་པ་གནས་ངན་ལེན་གྱི་གཡེང་བ།",
    "འདི་ལ་བརྟེན་ནས་གང་འདོད་པའི་དོན་གྱི་གནས་སུ་ཕྱིན་པར་བྱེད་པ་ཡིན་ནོ།",
    "དྲན་པ་དང་ཤེས་རབ་མཚུངས་པར་ལྡན་པས་ཚིག་དང་དོན་མི་བརྗེད་པར་འཛིན་པ་སྟེ།",
    "དོན་དམ་པར་བརྗོད་དུ་མེད་པའི་བདེན་གཉིས་མཉམ་པ་ཉིད་ལ་དམིགས་པས་སྐྱེ་མེད་ཀྱི་དོན་ལ་བཟོད་པ་ཐོབ་ཅིང་།",
    "དེ་ལས་མི་བརྗེད་པའི་གཟུངས་ཐོབ་པར་འགྱུར་རོ།",
    "བསྟན་བྱའི་དོན་གང་ཡིན་པ་ཉམས་པ་མེད་པར་ནམ་ཡང་མི་བརྗེད་པའོ།",
    "གཟུངས་འདི་ལ་གནས་པས་སྒོ་གསུམ་དང་ཕྱིན་དྲུག་སོགས་ཡོངས་སུ་དག་པའི་ཡོན་ཏན་བསམ་གྱིས་མི་ཁྱབ་པར་གསུངས་སོ།",
    "ཆགས་པ་མེད་པར་སྙོམས་པར་འཇུག་པའི་གཟུངས་ནི།",
    "དེ་ཡང་དོན་དང་ངེས་ཚིག་ལྡན་པར་སྟོན་ཀྱང་དེ་ལ་ཆགས་པ་མེད་ཅིང་སྟོན་པ་རྒྱུན་ཆད་མེད་པའོ།",
    "སོ་སོ་ཡང་དག་པར་རིག་པ་རྣམ་པར་ངེས་པའམ།",
    "རྣམ་པར་གདོན་མི་ཟ་བའི་གཟུངས་ནི།",
    "མི་འཇིགས་པའི་སྤོབས་པ་ནི་ཚིག་དང་དོན་གྱི་གནས་མ་ལུས་པ་སོ་སོ་ཡང་དག་པར་རིག་པའི་ཤེས་རབ་ཀྱི་མཐུ་ལས་ཟབ་ཅིང་རྒྱ་ཆེ་བའི་གནས་ལ་ཐོགས་པ་མེད་པའི་སྤོབས་པ་སྟེ།",
    "སྐྱེ་མེད་ཀྱི་དོན་ལ་བཟོད་པ་ཐོབ་པར་བྱེད་དོ།",
    "ཐབས་ལ་མཁས་པ་ནི་ཤེས་རབ་ཁྱད་པར་ཅན་གཙོ་བོར་གྱུར་པའི་སྟོབས་ཀྱིས་ཚེགས་ཆུང་ངུས་དོན་ཆེན་པོ་དང་བྱ་དཀའ་བ་རྣམས་བདེ་བླག་ཏུ་འགྲུབ་པ་སོགས་ངོ་མཚར་བའི་ཚུལ་ཅན་ཏེ།",
    "སྦྱོར་བ་གུས་ཤིང་སྤྲོ་བ་སོགས་ཀྱིས་ཕ་རོལ་གྱི་བསམ་པ་རྫོགས་པར་བྱེད་པ་དང་།",
    "གྲོགས་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་ཀྱིས་ཟིན་པ་དང་།",
    "ཤིན་ཏུ་ཡུན་རིང་པོ་ན་རྟོགས་པར་བྱ་བ་ཡང་ཐབས་ལ་མཁས་པས་བདེ་བླག་ཏུ་རྟོགས་ཏེ་མངོན་ཤེས་མྱུར་བར་བྱེད་པ་དང་།",
    "ས་བདུན་པར་ཐབས་མཁས་ལྔ་སྟེ།",
    "ངེས་པར་འབྱིན་པ་བྱང་ཕྱོགས་སོ་བདུན།",
    "དེ་ལྟར་དག་པའི་ས་གསུམ་རྣམ་པར་སྨིན་པའི་གནས་སྐབས་དང་སྦྱར་བའོ།",
    "ཞེས་གསུངས་པ་ལྟར།",
    "སྤང་བྱའི་སྐྱོན་མེད་པ༵་འཇིག་རྟེན་ལས་འདས་པའི་ལམ་གྱི་དང་པོ་མཐོང་ལམ་འཕགས་པའི་ས་ལྭ་འཇུག་པར་འགྱུར་རོ།",
    "དེའི་ཕྱིར་འཁོར་གསུམ་དུ་རྣམ་པར་རྟོག་པ་ཤེས་སྒྲིབ་ཏུ་མགོན་པོ་བྱམས་པས་གསུངས་སོ།",
    "དངོས་པོའི་རང་བཞིན་དང་མི་མཐུན་པར་འཛིན་པའི་རྨོངས་པས་སེམས་བསླད་པ་དེ་ཉིད་སྤང་ན་དངོས་པོ་ཕྱིན་ཅི་མ་ལོག་པར་རྟོགས་པའི་ཡེ་ཤེས་དེས་ཇི་སྙེད་པའི་དོན་ཐམས་ཅད་འབད་མེད་དུ་རྟོགས་པར་འགྱུར་ཏེ།",
    "ས་གོང་མ་གོང་མའི་སྤྱོད་ཡུལ་ལ་འཇུག་པར་རུང་བ་ཉིད་དུ་སྒྲུབ་པའི་ཕྱིར་ས་རྣམས་ཀྱི་ཡོངས་སྦྱོང་ལ་བརྩོན་པར་བྱེད་པ་ཡིན་ནོ།",
    "སུས་ཀྱང་མ་བྱས་པའི་འདུས་མ་བྱས་ཏེ།",
    "དེ་ཡང་དངོས་དངོས་མེད་གཉིས་ཀའི་མཐའ་ལ་མི་གནས་པའི་འདུས་མ་བྱས་ཆེན་པོ་ཡིན་ནོ།",
    "འདི་ཡོད་པ་དང་རྟོགས་ཤིང་ལམ་དུ་བྱས་པ་ལས་མཐར་འབྲས་ཐོབ་པ་ཡིན་པལས་ན་རང་བཞིན་གྱིས་གནས་པའི་རིགས་དང་།",
    "མ་དག་པའི་གདུལ་བྱ་ལ་གཟུགས་སྐུར་སྣང་བ་སྤྲུལ་པའི་སྐུ་སྟེ་སྐུ་བཞིར་གསུངས་སོ།",
    "ནང་བྱེད་པ་པོ་རང་ཉིད་ལ་གཟུགས་ཡོད་པ་དང་མེད་པར་འདུ་ཤེས་བཞག་ནས་ཕྱི་རོལ་གྱི་གཟུགས་རྣམས་ལ་མི་སྡུག་པར་ལྟ་བའོ།",
    "ནང་གཟུགས་མེད་པར་འདུ་ཤེས་པས་དེ་གཉིས་ཏེ་དབྱིབས་ཟིལ་གནོན་བཞིའོ།",
    "འདི་དག་ཏིང་ངེ་འཛིན་ལ་བརྟེན་ནས་བསྒྲུབས་པས་དབྱིབས་དང་ཁ་དོག་ཇི་ལྟར་དམིགས་པ་ལྟར་སྣང་བས་གཞན་ཟིལ་གྱིས་མནན་ནས་རང་ཡིད་མི་འཕྲོག་པར་བྱེད་པ་སྟེ།",
    "དེ་ཡང་ཏིང་ངེ་འཛིན་ལ་བརྟེན་ནས་ཟད་པར་བསྒྲུབས་པས།",
    "དེའི་ཕྱིར་སར་དམིགས་ན་ཐམས་ཅད་དུ་སར་སྣང་བ་སོགས་སུ་ཤེས་པར་བྱའོ།",
    "གཏན་ལ་བརྟེན་ནས་ཏིང་འཛིན་དང་ཤེས་རབ་ཀྱི་ངོ་བོ་ཡིན་ལ་དེ་དང་མཚུངས་ལྡན་རྣམས་དང་བཅས་པ་སྟེ་གཞན་རྣམས་ལའང་དེ་བཞིན་ཤེས་པར་བྱའོ།",
    "བརྒྱད་པ་སྨོན་ནས་མཁྱེན་པ་ཞེས་པ་ཉན་ཐོས་རྣམས་ཀྱིས་གཞལ་བྱ་ལྐོག་གྱུར་དང་།",
    "གཞན་གྱིས་དྲིས་པའི་དོན་གང་དང་གང་ཡིན་པ་དེ་ལ་འདི་ཤེས་པར་བྱའོ་ཞེས་སྨོན་ནས།",
    "བསམ་གཏན་ལ་མཉམ་པར་བཞག་པས་དོན་དེ་ཤེས་པར་བྱེད་པ།",
    "མཉམ་པར་བཞག་ན་ཤེས་ཀྱི་མ་བཞག་ན་མི་ཤེས་མཁས་པའི་འཇུག་སྒོ།",
    "པ་ལྟ་བུ་མེད་པར་རྟག་ཏུ་མཉམ་བཞག་ལ་གནས་བཞིན་པ་ཡིན་པའི་ཕྱིར།",
    "མ་ཡིན་པའི་ཤེས་བྱ་ཇི་སྙེད་ཡོད་པ་ཐམས་ཅད་ཆགས་ཐོགས་མེད་པར་སྐད་ཅིག་ལ་མཁྱེན་པ་ནི།",
    "དེ་བཞིན་དུ་གདུལ་བྱའི་རིགས་ཀྱི་ཁམས་དང་ཁམས་བཅོ་བརྒྱད་སོགས་ཁམས་ཇི་སྙེད་པ་སྣ་ཚོགས་མཁྱེན་པ༵་དང་།",
    "དབ༵ང་པོ་རྣོ་རྟུལ་རྣམ་པ་སྣ་ཚོགས་མཁྱེན་པ་དང་།",
    "ཟག་བཅས་དང་ཟག་མེད་ཀྱིས་བསྡུས་པའི་བསམ་གཏན་གྱི་བཀོད་པ་སྣ་ཚོགས་ཇི་སྙེད་པ་མཁྱེན་པ༵་དང་།",
    "རང་གཞན་གྱི་སྔོན་གྱི་གནས་སྣ་ཚོགས་པ་ཇི་སྙེད་མཁྱེན་པ༵་དང་།",
    "ཟག་པ༵་ཐམས་ཅད་ཟད་པ་ཉིད་དུ་གྱུར་པའི་ལམ་དང་འབྲས་བུ་མཁྱེན་པའོ།",
    "ཟག་ཟད་མཁྱེན་པའི་སྟོབས་ཀྱིས་བག་ཆགས་ཀྱི་སྒྲིབ་པ་ཤིང་ལྟ་བུ་གཅོད་པའི་ཕྱིར་དང་།",
    "ལས་མཁྱེན་པའི་སྟོབས་ཀྱིས་སྐྱབས་ལ་བསླུ་བའི་བདུད་འཇོམས་ཏེ།",
    "ཁམས་མཁྱེན་པས་རིགས།",
    "སྔོན་གནས་འཆི་འཕོ་མཁྱེན་པའི་སྟོབས་ཀྱིས་ལམ་གྱི་རྟེན་དང་།",
    "ཐམས་ཅད་དུ་འགྲོ་བའི་ལམ་མཁྱེན་པས་ལམ་གྱི་ངོ་བོ་དང་།",
    "རང་དོན་རྟོགས་པ་ཕུན་ཚོགས་ཞལ་གྱིས་བཞེས་པ༵་ལཱུ་མི་འཇིགས་པ་ནི།",
    "རང་དོན་སྤང་བ་ཕུན་ཚོགས་ཞལ་གྱིས་བཞེས་པ་ལ་མི་འཇིགས་པ༵་ནི།",
    "དེ་གཉིས་གཞན་དོན་དུ་བདེན་པར་གསུངས་པའོ།",
    "མཉམ་པར་མ་བཞག་པའི་ཐུགས་མི་མངའ་བ།",
    "དེ་ཐམས་ཅད་ཀྱི་མཐར་ཉམས་པ་མི་མངའ་བ་ཞེས་སྦྱར་ནས་ཤེས་པར་བྱ་སྟེ།",
    "ཅད་ནས་ཐམས་ཅད་དུ་མཁྱེན་པའོ།",
    "དེ་བཞིན་དུ་མ་གུས་ཤིང་མི་ཉན་པ་ལ་སྡང་བ་མེད་པར་དྲན་པ་ཉེར་བཞག་དང་།",
    "ཉན་མི་ཉན་གཉིས་ཀ་ལ་ཆགས་སྡང་གཉིས་ཀ་མེད་པར་དྲན་པ་ཉེ་བར་བཞག་པའོ།",
    "བཅུ་དགུ་པ་བག་ཆགས་ཡང་དག་པར་བཅོམ་པ་ནི།",
    "སྔོན་དང་ད་ལྟ་ཕྱི་མའི་མཐའ་མཁྱེན་པའི་རིག་པ་གསུམ་དང་།",
    "ཐུགས་རྗེས་བསྟན་གྱི་ཆོ་འཕྲུལ་གསུམ་སོགས་རྣམ་གྲངས་མང་པོ་གཞན་ལས་ཤེས་པར་བྱའོ།",
