    "འཕུལ་བྱེད་དང་མགོ་ཅན་དག་གིས་མིང་གཞི་ལ་འཐོན་པའི་སྒྲ་གདངས་གཅིག་ཁ་གཅིག་གིས་གསབ་པ་བཞིན་དུ།",
    "མ་ནིང་ཁ་ཆ་ཐ་ཕ་ཚ་རྣམས་ལ་མགོ་ཅན་གསུམ་གྱི་གང་ཡང་མི་འཐོབ་པ་ལ་མས་འཕུལ་དང་འས་འཕུལ་གཉིས་སྦྱར་ཏེ་མིང་གཞི་དག་གི་ནུས་པ་ཆེར་བསྐྱེད་པ་དང་།",
    "མོ་ཡིག་ག་ཇ་ད་བ་ཛ་དང་།",
    "ཤིན་ཏུ་མོ་ང་ཉ་ན་གསུམ་བཅས་ལ་ར་མགོ་སྦྱར་ཏེ་ལྕེ་རྩེ་འདར་བའི་བྱེད་པ་ཅན་དུ་སྒྲུབ་པ་ལ་མས་འཕུལ་དང་།",
    "ཅེས་པས་བསྟན་པ་བཞིན་ལུས་ཀྱི་ཡི་གེའམ་མིང་གཞི་དག་གི་ཟུར་ཕྱིན་པར་འཐོན་ཡང་།",
    "རྗེས་འཇུག་གིས་མ་ཐོན་པའི་སྒྲ་དག་སྐྱེད་པའོ།",
    "སྔོན་འཇུག་དང་མགོ་ཅན་གྱི་རྣམ་གཞག་ནི་མིང་གཞི་དག་གི་སྒྲ་གདངས་འཕུལ་བྱེད་དུ་བྱས་ཕྱིར།",
    "དེང་སང་ནུབ་ཕྱོགས་སྐད་ཆ་རིག་པའི་ལུགས་ལ་མགོ་ཅན་ཡང་སྔོན་འཇུག་གི་གྲས་སུ་སྡུད་པ་དང་།",
    "འདོགས་ཅན་ནི་མིང་གཞི་དག་གི་སྒྲ་དང་འཕྲལ་ཞིང་བཀླག་པའི་ཕྱིར་དུ་སྦྱོར་ཡང་།",
    "དེ་ལས་ཀྱང་ཕོ་དང་མོ་དང་ཤིན་ཏུ་མོ་ཡིག་བཅས་སུ་འདུ་ཕྱིར།",
    "སྒྲ་ཡིག་ནི་སྐར་མ་སྣྲེལ་ཞི་ལྟ་བུ་འཇུག་ཡུལ་རེ་གཉིས་མ་གཏོགས་མེད་ཕྱིར་གསེར་ཏོག་སུམ་རྟགས་སོགས་སུ་བགྲངས་མེད་དོ།",
    "ཎ་དག་གི་སྒྲ་དང་ཕྱོགས་མཚུངས་ཤིང་།",
    "སྒྲ་སྦྱོར་ཡི་གེ་དག་གི་སྒྲིག་རིམ་གཉིས་ཀ་བོད་ཡིག་གཅིག་པུའི་སྟེང་ལ་གྲུབ་པ་འདི་ནི་ཡི་གེའི་བཟོ་རྩལ་ཁྱད་པར་བ་ཞིག་ཏུ་བལྟ་བར་བྱའོ།",
    "ཚེག་གི་ངོ་བོ་ནི་ཡི་གེའི་བཀླག་ཐབས་བྱིས་པ་བདེ་འཇུག་ཏུ་འདི་ལྟར་བསྟན་འདུག་པ་སྟེ།",
    "དེ་ལ་ཚེག་ཉིད་སྲོག་གི་ཨ།",
    "སྲོག་གི་ཡི་གེ་ནི་དབྱངས་བཞི་དང་ཚེག་ཡིན་ཏེ།",
    "བོད་ཡིག་ཚེག་གིས་མ་བཅད་ན་ཚེག་ཁྱིམ་མི་འགྲུབ་ཅིང་།",
    "ཞེས་པ་བཞིན་རང་རེའི་ཡི་གེ་ནི་སྐད་ཆའི་སྦྱོར་བ་ལྟར་ཡིག་འབྲུ་རེ་རེ་བཞིན་ཡས་ནས་མས་སུ་བསྟར་ཏེ་འབྲི་བའི་ཚེ།",
    "བར་ཚེག་གི་བྱེད་ཐབས་སྤྱད་པ་འདིའང་བློ་གྲོས་ཅན་གྱི་མཛངས་པའི་ལས་སུ་འཁུམས་པའོ།",
    "དེ་དག་གི་འབྱུང་རྐྱེན་གཙོ་བོ་ཅི་རེད།",
    "བོད་ཡིག་གི་རྐྱེན་གྱི་ཡི་གེ་ནི་དབུ་ཁྱུད་དང་ཤད་གཉིས་སུ་འདུ་བ་དང་།",
    "དབུ་ཁྱུད་ནི་སྔགས་ཀྱི་གཟུངས་མང་པོར་ཨོཾ་ཡིག་གིས་མགོ་འདྲེན་པ་བཞིན།",
    "ཝརྟུའི་ཨོཾ་ཡིག་གི་གཟུགས་འདི",
    "ལྡེབ་དང་པོའི་ཉིན་ཤོག་གི་ཐིག་མགོར་སྦྱར་ཏེ་མགོ་འདྲེན་པ་མཚོན་ཞིང་།",
    "ཡིག་མགོའི་དང་ཀྱོག་འདི་ཡང་ཨོཾ་ཡིག་གི་གཟུགས་རིམ་གྱིས་འགྱུར་བ་ཤེས་ཏེ།",
    "རྒྱ་དཔེ་རྣམས་ཀྱི་ལྡེབ་དང་པོ་ལ་ཨོཾ་ཡིག་རེ་འབྲི་སྲོལ་འདུག་ཅིང་།",
    "རྒྱ་ཡིག་གི་ཨོཾ་གཟུགས་ནི་ད་ལྟའི་བར་འདི་ལྟར་སྣང་ལ།",
    "ཞེས་པས་གསུངས་པ་ལྟར་དབུ་ཁྱུད་ཀྱི་ངོ་བོ་ཨོཾ་ཡིག་ཏུ་ངེས་པ་ཡིག་མགོར་བྱུང་བ་རེད་ལ།",
    "ཚིག་བཅད་ལྷུག་གི་སྤུ་རིས་འབྱེད་པ་དང་།",
    "བོད་ཡིག་གི་གཟུགས་རིས་ཐོག་མར་གཏན་ལ་འབེབས་དུས་ཡི་གེ་སོ་སོའི་སྐྱེ་གནས་སྒྱུར་ལུགས་ལྟར་བྱས་ཏེ།",
    "རྟ་ཕོ་དཀྱུས་སུ་རྒྱུག་པ་ལྟ་བུའི་འབྲི་ལུགས་བྱུང་བའི་ཆ་ན་དང་ཐོག་གི་ཡི་གེའི་སྐྱེ་གནས་ཀྱི་རྣམ་པ་མངོན་གསལ་དུ་མི་སྣང་ཡང་།",
    "བོད་ཡིག་གི་འབྲི་ལུགས་གསར་བའི་སྲོལ་ཕྱེ།",
    "མཁས་པ་རང་གི་བློ་གྲོས་ཀྱི་རྩལ་བཏོན་ཏེ།",
    "ཡིག་གསར་སྣ་ཚོགས་གསར་དུ་བྱས་པ་ནི་རང་རེའི་ཡི་གེ་འདིའི་འཕྲིན་ལས་ཆེར་འཕེལ་པའི་རྟགས་སུ་འཁུམས་ཀྱང་།",
    "ཡིག་གསར་དེ་དག་གིས་བཞེངས་པའི་གླེགས་བམ་ཕར་ཞོག་བཀའ་གསུང་ཤོག་ལྡེབ་འགའ་རེའང་མཁས་ཆེན་དག་གི་སྤྱན་གཟིགས་སུ་མ་བྱོན་པར་གསུངས་པས།",
    "བོད་ཡིག་ཏུ་སྤྱོད་པའི་སྔགས་ཡིག་ཅེས་པ་ནི་ཇི་འདྲ་ཞིག་རེད།",
    "དེ་དང་བོད་ཡིག་གི་ཁྱད་པར་ཇི་ལྟར་འབྱེད།",
    "སྣ་གྲངས་མང་བ་ཞིག་ཏུ་སྙེགས་ལ་བསྒྱུར་བ་རྣམས་གཅིག་གི་ནང་དུ་ནི་སྣ་གྲངས་དེ་ཀུན་འདུར་ཡང་མི་བཏུབ་སྟེ།",
    "མན་ངག་ཟབ་མོའི་གསང་རྒྱ་མི་འགྲོལ་བ་དང་།",
    "བོད་ཡིག་གི་གཟུགས་རིས་ཀྱིས་རྒྱ་གར་གྱི་སྐད་གདངས་འགོད་པའི་ཡི་གེ་བཏགས་པ་བ་ཞིག་ཡིན་པས།",
    "དེ་དང་བོད་ཡིག་གི་ཁྱད་པར་གཙོ་བོ་འདི་ལྟ་སྟེ།",
    "སྔགས་ཡིག་དག་གི་སྒྲ་གདངས་ནི་རྒྱ་གར་སྐད་ཀྱི་གདངས་བཞིནབཀླག་པ་དང་།",
    "སྔགས་ཡིག་ལ་དེ་ལྟའི་རྣམ་གཞག་མེད་པར་རྒྱ་གར་གྱི་ཡི་གེ་དག་གི་སྦྱོར་བ་ལྟར་བྱེད་པ་དང་།",
    "དྲུག་ནི་བོད་ཡིག་དབྱངས་གསལ་སྤྱི་དང་བྱེ་བྲག་གསལ་བྱེད་ཀྱི་ཡི་གེར་ནང་གསེས་ཕོ་མོ་སོགས་ཀྱི་རྟགས་འབྱེད་པ་ལ།",
    "སྔགས་ཡིག་ལ་ཕོ་མོ་མ་ནིང་གི་རྟགས་ཀྱི་དབྱེ་བ་མེད་པར་མིང་གི་སྦྱོར་བ་རྒྱ་གར་ལྟར་བྱེད་པའོ།",
    "སི་དང་ལ་ཏིང་སྐད་ཀྱི་ཡིག་མཁན་དག་གིས་ཐ་སྙད་དག་གི་བར་ལའང་སྟོང་ཆ་གང་ཡང་བཞག་མེད་ཅིང་།",
    "རྡོ་བརྐོས་ཡི་གེ་དང་རྩྭ་ཤོག་ཏུ་བྲིས་པའི་བྲིས་དཔེ་དག་ཏུ་ཚེག་ཆུང་གིས་ཐ་སྙད་ཀྱི་བར་མཚམས་ཕྱེ་ཞིང་།",
    "དུས་རབས་ཉི་ཤུ་པའི་མགོ་ཙམ་ལ་སྒྲ་སྦྱོར་ཡི་གེ་མ་ཡིན་པ་དག་གིས་ཀྱང་ཚིག་རྟགས་བཀོལ་པ་སྟེ།",
    "ཐ་ན་ཡོ་རོབ་ཕྱོགས་ཀྱི་ཡི་གེ་དག་གི་ནང་དུའང་ད་ལྟར་སྤྱོད་མུས་ཀྱི་ཚིག་རྟགས་དག་ནི་དུས་རབས་མང་པོའི་ནང་དུ་རིམ་གྱིས་བྱུང་སྟེ།",
    "རང་རེ་བོད་པའི་ཡི་གེ་འདིར་ཡི་གེ་དང་སྒྲའི་བསྟན་བཅོས་དག་སློབ་དཔོན་ཐོན་མི་མཆོག་གིས་ཐོག་མར་མཛད་པའི་དུས་ནས་བཟུང་།",
    "རྣམ་དབྱེའི་ཚིག་ཕྲད་དག་མིང་དག་གི་བར་ལ་སྦྱར་ཏེ་བསྒྲུབས་པའི་ཚིག་དག་ལ་དོན་ཐོབ་ལྟར་ཚིག་ཕྲད་ཕལ་བ་དག་གཙོ་ཆེར་མཐའ་མར་སྦྱོར་བ་ནི།",
    "བོད་སྐད་ཀྱི་ཚིག་ཕྲད་ཕལ་བ་དག་ལ་དེང་གི་ཡི་གེ་གཞན་དུ་སྤྱོད་པའི་ཚིག་རྟགས་ཀྱི་བྱེད་པ་ལྡན་ཞིང་།",
    "ཚིག་གི་གཅོད་མཚམས་དང་སྒྲའི་ལྕི་ཡང་གི་འདེགས་འཇོག་གསལ་བར་བྱེད་པ་ལས།",
    "ཚིག་ཕྲད་རྣམ་གྲངས་གཅིག་གིས་སྐབས་དོན་དུ་མ་དུས་གཅིག་ལ་གསལ་བར་བྱེད་ཕྱིར།",
    "ད་ལྟ་སྤྱོད་མཚམས་ཡོངས་སུ་བཞག་པ་རེད་དོ།",
    "དེས་ན་སྲུང་འཁོར་གྱི་སྟེང་ལ་བྲི་བའི་རི་མོ་དེ་རིགས་ལ་བསྟན་དོན་གསལ་པོ་ཞིག་ཨེ་ཡོད།",
    "ཅེས་བྱུང་བའི་ཤིང་གི་རྟགས་བུ་ཞེས་པ་ནི་ཡི་གེའི་དོད་ཡིན་ཏེ།",
    "གནའ་བོའི་མི་རྣམས་ཀྱིས་སྐད་ཆའི་སྦྱོར་བ་ཐབས་ཆག་པ་ལ་བརྟེན་ནས་གོ་བརྡ་སྤྲོད་པ་དང་ཆབས་ཅིག་མཐོང་སྣང་དུ་བྱུང་བའི་དངོས་པོ་དག་གི་གཟུགས་རིས་འབྲི་བ་དང་།",
    "ཡིད་ཀྱི་དྲན་འཆར་རྟགས་སུ་འདེབས་པ་ལས་རི་མོའི་བརྡ་རྟགས་མང་དུ་བྱུང་བར་མ་ཟད།",
    "ཅེས་པར་བསྟན་བྱ་བོད་མིའི་འཚོ་བ་དང་འབྲེལ་བའི་ཕྱོགས་ཐམས་ཅད་ལ་ཁྱབ་འདུག་པར་བསྟན་པ་ནི་རི་མོའི་བརྡ་ཐབས་ཤིག་མ་ཡིན་པས་ཡི་གེ་མིན་དུ་མཆི་ཡང་།",
    "མོ།",
    "ནས་བཅས་དང་མཐུན་པ་ཡིན་པར་རྒྱ་རིགས་མཁས་པ་དག་གི་གསུང་ན་མང་དུ་འདུག་པར་མ་ཟད།",
    "སྒྲ་ཡངས་འཇུག་གི་ཡི་གེ་ཞིབ་འཇུག་ཅེས་པའི་གླེགས་བམ་དུ།",
    "དེང་གི་རྒྱ་ཡིག་གི་ཐོག་མའི་གྲས་ཀྱི་ཡི་གེ་དག་ནི་བོད་པའི་ཡབ་མེས་དག་གིས་ཀྱང་བྱས་པ་གདོན་མི་ཟ་ཞིང་།",
    "རང་རེའི་སྲིད་པའི་ཕྱག་རྒྱ་དང་།",
    "གཞན་ཡང་བསྲུང་བའི་བྱང་བུ་མང་པོ་ཞིག་གི་སྟེང་ན་ཐོ་བརྩེགས་སུ་ཡོད་པའི་གཟུགས་བྲིས་སྣ་ཚོགས་ཤིག་ཡོད་པ་འདི་དག་ཀྱང་གནའ་དུས་ཀྱི་ཡི་གེའམ་སྔགས་ཀྱི་གཟུགས་ལ་སོགས་པ་ཡིན་ནམ་སྙམ།",
    "བྱེ་བྲག་མི་རིགས་གཅིག་གི་སྐད་ཆའི་སྲོལ།",
    "མི་རིགས་ཤིག་གི་སྐད་ཆའི་སྦྱོར་བ་རུ།",
    "མིང་དང་ཚིག་གི་སྦྱོར་བར་སྦྱོར་བའི་ཚུལ།",
    "རང་རེ་བོད་པའི་བརྡ་སྤྲོད་རིག་པའི་ཁུངས།",
    "མིང་གི་སྲོག་ཏུ་སྦྱར་པའི་མཐའ་རྟེན་ལ།",
    "བསྐྱར་བ་ཟློག་པའི་ཚིག་གི་གསོས་སུ་བྱས།",
    "འཇུག་ཡུལ་མིང་གིས་བཏགས་པས་ཁྱད་པར་ཆེ།",
    "ཚིག་གི་གྲུབ་ཆ་གཙོར་བྱེད་སྦྱོར་ཐབས་སྐྱེད།",
    "མིང་གི་བར་སྦྱོར་ཚིག་སྒྲུབ་ནུས་པ་ཆེ།",
    "ཕྲད་རེར་སྦྱོར་ལུགས་ལུགས་རེར་གཏན་ཚིགས་རེ།",
    "མིང་གི་བྱེ་བྲག་སྒྲིག་པས་ཚིག་སྒྲུབ་པ།",
    "མིང་གི་བྱུང་འཕེལ་སྔ་ཕྱིའི་ཁྱད་པར་དང་།",
    "ཚིག་གི་སྦྱོར་བ་དངོས་སུ་ཞུགས་པས་ཤེས།",
    "མིང་གི་སྦྱོར་བ་དོན་གྱི་དགོས་མཁོར་བསྟུན།",
    "དོན་ལ་མི་མཁོ་མིང་གི་སྦྱོར་བ་མེད།",
    "ཚིག་གིས་སྐབས་ཀྱི་བརྗོད་དོན་གསལ་བར་བྱེད།",
    "མཐར་སྦྱར་འོག་མའི་མིང་གི་དོན་ལས་རྟོགས།",
    "ཚིག་གི་རྣམ་གྲངས་སུས་ཀྱང་དཔོག་དཀའ་ཡང་།",
    "ཚིག་གི་བསྟན་དོན་མིང་ཕྲད་སྤུངས་ཙམ་མིན།",
    "ཚིག་དོན་གོལ་ས་ཅན་ཡང་རེ་འགར་འབྱུང་།",
    "ཚིག་གིས་བརྗོད་དོན་སྣ་ཚོགས་སྟོན་པའི་ཕྱིར།",
    "ཡུལ་རེར་འཆད་ལུགས་རེ་ཅི་འཐོན་ལ་འབད་པའི་སྐབས་སུ།",
    "མི་ཕན་ཚུན་བར་ལ་སྐད་ཆའི་བརྗོད་ལུགས་ཐུན་མོང་པ་ཞིག་གྲུབ་འདུག་པ་དེ་ནི་བརྡ་སྤྲོད་དང་སྐད་སྲོལ་ཡིན་པས།",
    "སྐད་ཆ་བྱེ་བྲག་པ་ཞིག་བརྗོད་ཤེས་པའི་མི་སུ་དང་གང་གིས་ཀྱང་སྐད་ཆ་དེའི་བརྗོད་སྲོལ་ཤེས་ཀྱང་།",
    "མི་དེ་རིགས་ཀྱི་སེམས་སུ་སྐད་ཆ་ཞིག་གི་བརྡ་སྤྲོད་སྲོལ་ཡོད་ཀྱང་བརྡ་སྤྲོད་རིག་པ་མེད་དེ།",
    "ཚིག་གི་བཟོ་ལུགས་སོགས་རིགས་པས་གཏན་ལ་ཕབ་སྟེ་གཞུང་ལུགས་སུ་བྱས་པ་ལ་བྱ་ཕྱིར།",
    "སྐད་ཆ་ཞིག་གི་སྒྲོམ་གཞི་ནི་བརྡ་སྤྲོད་ཡིན་ཞིང་།",
    "སྐད་ཆའི་སྦྱོར་སྲོལ་གཏན་ཆགས་པ་མེད་ན་ཐུན་མོང་གི་བསམ་བློའི་འདུ་ཤེས་འཛིན་སྟངས་ཤིག་ཀྱང་ཆགས་ཐབས་མེད་པས།",
    "ཐ་སྙད་འདི་ལ་སྒྲ་ལྕི་ཡང་གི་གཅོད་མཚམས་ཀྱིས་གོ་བརྡ་སྤྲོད་པ་དང་།",
    "མཇུག་འབྲས་ལ་དམིགས་པའི་ཐ་སྙད་ཅིག་རེད་དོ།",
    "བརྡ་སྤྲོད་རིག་པའི་གནའ་དེང་གི་བསྟན་བྱ་ལ་ཁྱད་པར་ཨེ་ཡོད།",
    "རིག་པའི་གཞུང་ལུགས་གང་ཡིན་ཡང་ཡུན་རིང་གི་ཉམས་མྱོང་སྤྱི་བསྡོམས་བྱས་པ་ལས་བྱུང་ཞིང་།",
    "དེ་ཡང་ཐོག་མར་དོན་ཕྱོགས་རེ་བ་ཞིག་གཞིར་བཟུང་སྟེ་རིམ་གྱིས་འཐུས་ཇེ་ཚང་དུ་བཏང་བ་བཞིན།",
    "བརྡ་སྤྲོད་པའི་བསྟན་བཅོས་ཀུན་གྱི་ཕྱི་མོ་སློབ་དཔོན་པཱ་ཎི་ཎིའི་སྒྲ་གཞུང་སྐབས་བརྒྱད་པའི་བསྟན་བྱ་གཙོ་བོ་ནི་བྱིངས་ཀྱི་རྣམ་འགྱུར་དང་།",
    "མིང་གི་བྱུང་འཕེལ་ཡིན་ཞིང་།",
    "ཚིག་གི་སྐོར་ནི་ཕལ་ཆེར་བཏང་སྙོམས་སུ་བཞག་འདུག་པས།",
    "བརྡ་སྤྲོད་ནི་མིང་གི་འགྱུར་བའི་གཏན་སྲོལ་དང་མིང་གིས་ཚིག་སྒྲུབ་ཚུལ་གྱི་ཕུང་པོ་ཞིག་གོ།",
    "ཞེས་པར་བསྟན་པ་ཡིས་ད་ལྟའི་བར་རྒྱ་ཡིག་གི་བརྡ་སྤྲོད་རིག་པའི་ཞིབ་འཇུག་བྱ་ཡུལ་ལ་ཤན་ཤུགས་ཆེན་པོ་ཐེབས་ཡོད།",
    "རང་རེའི་སྲོལ་རྒྱུན་གྱི་བརྡ་སྤྲོད་རིག་པ་ནི་སུམ་ཅུ་པ་དང་རྟགས་ཀྱི་འཇུག་པ་གཉིས་ཀྱི་བསྟན་བྱ་གཙོར་བྱས་པའི་མིང་ཚིག་ཡི་གེའི་ཚོགས་གསུམ་དུ་འདུ་བའི་ཁར།",
    "ད་དུང་ཡང་ཚིག་གི་ཚོགས་ནི་བཏང་སྙོམས་སུ་བཞག་འདུག་གོ།",
    "སྐད་ཆ་རིག་པ་དང་བརྡ་སྤྲོད་རིག་པ་གཉིས་ཀྱི་འབྲེལ་བ་དང་ཁྱད་པར་ཇི་འདྲ་རེད།",
    "ཚིག་གིས་སྐབས་ཀྱི་དོན་རྣམས་གསལ་བར་བྱེད།",
    "སྒྲ་ཡངས་འཇུག་གི་བརྡ་སྤྲོད་རིག་པ་ནི་སྐད་ཆ་རིག་པ་དང་དོན་མཚུངས་ལ།",
    "སྒྲ་དོག་འཇུག་གི་བརྡ་སྤྲོད་རིག་པ་ནི་སྐད་ཆ་རིག་པའི་བྱེ་བྲག་གལ་ཆེ་བ་ཞིག་རེད་དོ།",
    "དེ་དག་བར་གྱི་འབྲེལ་བ་ཇི་འདྲ་རེད།",
    "མིང་གི་སྦྱོར་ལུགས་ལ་བརྟེན་ནས་བརྡ་སྤྲོད་ཀྱི་བསྟན་དོན་སྣ་ཚོགས་སྐྱེད་པ་ནི་སྔ་མ་དང་།",
    "ཚིག་གི་སྦྱོར་ལུགས་ལ་བརྟེན་ནས་བརྡ་སྤྲོད་ཀྱི་བསྟན་དོན་སྣ་ཚོགས་སྐྱེད་པ་ནི་ཕྱི་མ་སྟེ།",
    "མིང་གི་འགྱུར་བ་དང་།",
    "སྒྲ་ལྕི་ཡང་གི་ཁྱད་པར།",
    "མིང་གི་སྦྱོར་རིམ།",
    "མིང་གི་ཁོངས་ནས་ཚིག་ཕྱུང་ནས།",
    "ཚིག་གིས་དོན་རྣམས་སྟོན་པར་བྱེད།",
    "ཅེས་པས་བསྟན་པ་ལྟར་ཚིག་གི་འགྲུབ་རྒྱུ་ནི་མིང་ཡིན་ཡང་།",
    "ཚིག་དེ་སྒྲུབ་བྱེད་ཀྱི་མིང་གི་ཁྱད་པར་དང་།",
    "མིང་གི་བརྗོད་རིམ་གྱི་ཁྱད་པར།",
    "མིང་ངམ་ཚིག་གི་རིགས་མཚུངས་སྤྱི་ལ་ཁྱབ་པའི་སྦྱོར་ཐབས་གཏན་ཆགས་པའི་སྒོ་ནས་བསྟན་དོན་རིགས་མཚུངས་པ་སྐྱེད་པ་ནི།",
    "དམིགས་བསལ་གྱི་བརྗོད་ཐབས་བྱེ་བྲག་པ་གཅིག་གིས་བསྟན་དོན་ཁྱད་པར་པ་གཅིག་སྟོན་པ་ནི།",
    "མཐར་ཐུག་གི་དགོས་པ་བསྟན་དོན་གྱི་ཆ་ལ་འདུ་ཕྱིར།",
    "སྐད་ཆ་གཅིག་གི་བརྡ་སྤྲོད་ཀྱི་ཐབས་ལམ་དང་བསྟན་དོན་གཉིས་ནི་ནམ་བརྡ་སྤྲོད་སྤྱི་དོན་སྐོར་གྱི་དྲི་བ།",
    "བརྡ་སྤྲོད་ཅེས་པ་ནི་རྩིས་འཁོར་གྱི་མཐེབ་གཞོང་དང་འདྲ་ཟེར་བའི་དོན་ཅི་རེད།",
    "མཐེབ་གཞོང་གི་ངོས་སུ་བཀོད་པའི་ཡི་གེའི་བརྡ་རྟགས་ཀྱི་གྲངས་ཀ་ཚད་ལྡན་རྣམས་གཏག་ཐབས་ངེས་ཅན་ཞིག་ལ་བརྟེན་ནས།",
    "ཚིག་གི་སྦྱོར་བ་གྲངས་མེད་པ་དང་བརྗོད་དོན་སྣ་ཚོགས་པ་སྤེལ་བར་བྱེད་པ་མཐར་གཏུགས་ན།",
    "བརྡ་སྤྲོད་ནི་མཐེབ་གཞོང་དང་མཚུངས་པར་སྐད་ཆའི་སྦྱོར་བ་སྒྲུབ་བྱེད་ཀྱི་མིང་གི་ལྷ་ལག་རེ་རེ་ཡང་ཡང་སྤྱད་དེ་ཚིག་སྦྱོར་སྣ་ཚོགས་པ་སྤེལ་བའི་ཕྱིར་ན།",
    "བཟོ་བཀོད་གཏན་ཆགས་པའི་མཐེབ་གཞོང་གི་ངོས་སུ་བཀོད་པའི་ཡི་གེའམ་བརྡ་རྟགས་དག་རྩིས་འཁོར་དེ་ཡི་རིགས་ཀུན་ལ་མཐུན་པར་བསྒྲིགས་པའི་བྱ་རིམ་ལྟར་གཏག་པར་བྱེད་པ་ལས།",
    "བརྡ་སྤྲོད་བསླབ་པའི་དགོས་པ་ཅི་རེད།",
    "སུམ་རྟགས་ལ་སོགས་གཞུང་གིས་ཅི་ཞིག་བགྱིད།",
    "དེ་དག་གིས་ངག་ནས་སྨྲ་བའི་གྲོང་པའི་ཚིག་དག་ཀྱང་ཆུང་དུས་སུ་ཕ་མ་ཉེ་དུ་དྲུང་འཁོར་དག་ལས་བསླབས་ཤིང་ལོབས་ཏེ།",
    "དེ་ནི་སྐད་ཆ་དེ་མཚུངས་སྨྲ་བ་དག་གི་བརྗོད་པ་སྤྱི་མཐུན་གྱི་བརྡ་སྤྲོདལུགས་དང་ཡང་མཐུན་མོད།",
    "བརྡ་སྤྲོད་ཀྱི་བསྟན་བཅོས་དག་གི་བསྟན་བྱའང་གྲོང་པ་དག་གི་ངག་ནས་བརྗོད་པའི་སྐད་ཆའི་སྤྱི་སྲོལ་ལས་ཟུར་ལོགས་པ་ཞིག་མ་ཡིན་པས།",
    "བརྒྱད་དུ་ན་སྐད་རིགས་གང་ཞིག་གི་བརྗོད་སྟོབས་འཐུས་ཚང་དུ་གཏོང་བ་ལ།",
    "དག་སྦྱོར་ལའང་དེ་བཞིན་ཡོད་པ་ཨེ་རེད།",
    "ཡི་གེ་གང་ཡིན་ཡང་རང་གི་མཚོན་བྱར་གྱུར་པའི་ངག་ཐོག་གི་སྐད་ཆ་མེད་པ་ཞིག་གཏན་ནས་མི་སྲིད་ཅིང་།",
    "ངག་ཐོག་གི་སྐད་ཆ་ལ་བལྟོས་པས་ཡིག་ཐོག་ལ་གཟབ་གཟབ་བྱེད་པའི་གོམས་སྲོལ་ངང་གིས་ཆགས་པའི་ཁར།",
    "ཡི་གེ་འབྲི་ཀློག་ཤེས་པ་ཙམ་གྱིས་དེ་དག་གི་བརྗོད་བྱ་བདེ་བླག་ཏུ་རྟོགས་ཐབས་བྲལ་པས།",
    "བསྟན་བཅོས་དེ་དག་གི་འགྲེལ་པའམ་གཞན་གྱིས་གསེད་འགྲོལ་བྱེད་པ་ལ་བརྟེན་དགོས་པར་གྱུར་ཏེ།",
    "ཡིག་ཐོག་གི་སྐད་ཆའི་གོ་བ་བདེ་བླག་ཏུ་རྙེད་པའི་ཐབས་ལ་བརྡ་བཀྲོལ་མིང་མཛོད་དང་།",
    "བརྡ་སྤྲོད་ཀྱི་བསྟན་བཅོས་ནི་ཡིག་ཐོག་གི་སྐད་ཆའི་དགོས་མཁོ་ལས་བྱུང་བ་ཡིན་ཡང་།",
    "ངག་ཐོག་གི་སྐད་ཆ་ལ་མ་བརྟེན་པའི་ཡིག་ཐོག་གི་སྐད་ཆ་ཞིག་གཞི་མ་གྲུབ་པས།",
    "ངག་ཐོག་གི་སྐད་ཆར་དཔྱད་པའི་འབྲས་བུ་ཅིས་ཀྱང་ཡི་གེར་དགོད་དགོས་ཤིང་།",
    "ཡི་གེར་བཀོད་པའི་བརྡ་སྤྲོད་དེ་ནི་ངག་ཐོག་གི་སྐད་ཆའི་རྨང་ལ་བརྟེན་པའི་ཡིག་ཐོག་གི་སྐད་ཆ་དང་ཐུན་མོང་གི་སྦྱོར་སྲོལ་གཞུང་ལུགས་སུ་བྱས་པ་ལས་མ་འདས་པས།",
    "ཡིག་ཐོག་དང་ངག་ཐོག་གི་སྐད་ཆའི་སྦྱོར་བ་གང་ཞིག་རྩལ་དུ་བཏོན་ནས་ཞིབ་འཇུག་བྱེད་པ་ལ་རྒྱལ་ཁམས་དང་མི་སྒེར་གྱི་ཐད་དུ་ཁྱད་པར་ཡོད་ཀྱང་།",
    "ཡིག་ཐོག་གི་སྐད་ཆའི་བརྡ་སྤྲོད་ཀྱིས་ངག་སྦྱོར་ལ་ཕན་མི་ཐོགས་པ་དང་།",
    "ངག་ཐོག་གི་སྐད་ཆའི་བརྡ་སྤྲོད་ཀྱིས་ཡི་གེ་ཡོད་པའི་སྐད་ཆ་བརྡ་སྤྲོད་སྤྱི་དོན་སྐོར་གྱི་དྲི་བ།",
    "དེ་དག་ལས་བོད་ལ་དར་མྱོང་བ་གང་དག་རེད།",
    "མོན་ཏ་གུའི་བརྡ་སྤྲོད།",
    "རང་རེའི་ཡུལ་འདིར་ནི་ཁ་བ་རི་བོའི་མུ་ཁྱུད་མཐོན་པོར་བརྒལ་དཀའ་བའམ།",
    "སྐྱེད་སྒྲུབ་འཕེལ་འགྱུར་བརྡ་སྤྲོད་རིག་པའི་སྲོལ་གཏོད་པ་པོ་སུ་རེད།",
    "ནི་ཨ་མེ་རི་ཀའི་མཁས་པ་ཆེན་པོ་ནོར་མན་ཆོམ་སི་ཀེ་ཞུ་བས་དུས་རབས་སྔོན་མའི་ལོ་རབས་ལྔ་བཅུའི་ནང་དུ་སྲོལ་བཏོད་རྗེས།",
    "གོང་གི་སྐད་ཆ་རིག་པ་གཉིས་དང་འདི་གསུམ་ནི་དེང་རབས་སྐད་ཆའི་ཚན་རིག་གི་འཕེལ་རིམ་ཆེན་པོ་གསུམ་དུ་ལྟ་ཞིང་།",
    "སྐད་ཆ་ནི་གྲངས་ལྡན་གྱི་ཡི་གེས་གྲུབ་པའི་རིང་ཐུང་ངེས་ལྡན་གྱི་ཚིག་གི་ཕུང་པོ་ཞིག་ཡིན་པར་མ་ཟད།",
    "ཚད་ཡོད་ཀྱི་སྐྱེ་ལྡན་གྱི་ཕུང་པོ་ཞིག་གི་དཔག་འོས་པའི་ཡོན་ཏན་ལ་བརྟེན་ནས།",
    "མི་རྣམས་ཀྱིས་ཚིག་གསར་བ་མང་པོ་གསར་དུ་བསྐྲུན་ཏེ་རང་གི་བསམ་བློ་སྟོན་པ་ལ།",
    "ཉན་མཁན་གྱིས་ཀྱང་སྐད་ཆའི་ཤེས་བྱ་གསར་བ་སྦྱང་མི་དགོས་པར་ངག་སྦྱོར་དེ་རིགས་བདེ་བླག་ཏུ་རྟོགས་ཐུབ་པ་ཡིས་མི་རྣམས་ཀྱིས་བརྗོད་ཤེས་ཤིང་གོ་ཐུབ་པའི་ཚིག་གི་རྣམ་གྲངས་ལ་མཐའ་མེད་པ་དངོས་ར་སྤྲོད་ཐུབ་པར་བཞེད་པར་མ་ཟད།",
    "མི་རྣམས་ཀྱིས་རང་གི་སྐད་ཆའི་ནུས་པ་དོན་དངོས་སུ་བཀོལ་སྤྱོད་བྱེད་པ་ནི་ཕྱི་མའི་དོན་དུ་བཞག་ཅིང་།",
    "མི་ལ་མངའ་བའི་ཚིག་གི་བརྡ་སྤྲོད་དང་།",
    "མཐར་ཐུག་གི་དམིགས་ཡུལ་གཉིས་ཏེ།",
    "སྐད་རིགས་གཞན་གྱི་ཚིག་གི་གྲུབ་ཆའི་དབྱེ་བ་དྲུག་པོ་དེ་དག་བོད་སྐད་ལ་སྦྱར་ཨེ་རུང་།",
    "སྐད་ཆའི་སྦྱོར་བ་སྤྱི་དང་བྱེ་བྲག་ཚིག་གི་སྦྱོར་བའི་གྲུབ་ཆ་ལ་དབྱེ་ཞིབ་དང་ངོས་འཛིན་བྱེད་པའང་གཞན་མྱོང་རང་སྤྱོད་དང་།",
    "སྦྱར་ན་འབྱོར་མི་འབྱོར་གྱི་ཐད་གནའ་དེང་གི་ལྟ་བ་རྐྱ་འཐབ་ཀྱང་།",
    "གཞུང་ལུགས་བྱེ་བྲག་པ་དག་ཏུ་ཚིག་དོན་དང་སྐབས་འབྲེལ་གྱི་མིང་ཐོར་རེ་བ་བྱུང་བ་ཚིག་གི་གྲུབ་ཆ་སོ་སོ་ལ་ཚང་བར་མ་སྦྱར་བ་མ་གཏོགས་པར།",
    "བྱ་བ་དང་མ་འབྲེལ་བའི་ཚིག་གི་སྦྱོར་བ་གཞན་དག་ལའང་གྲུབ་ཆ་ངོས་འཛིན་གྱི་རིག་པ་སྔ་མོ་ནས་བྱུང་ཞིང་འབྱུང་གིན་ཡོད་པར་བརྟེན།",
    "བུ་ཆུང་གིས་ཕ་མ་གཉིས་ལ་སློབ་སྦྱོང་གི་གནས་ཚུལ་གུས་པས་ཞུ་འབུལ་བྱས་ཟིན།",
    "འདི་ནི་ཚིག་གི་སྦྱོར་བ་གང་ཡང་རུང་བའི་གྲུབ་ཆ་ངོས་གཟུང་ལ་ཕན་པའི་དབྱེ་སྒོ་གཞན་ཡིན་པས།",
    "མིང་གི་བརྡ་སྤྲོད་ཀྱི་བྱེད་ལས་དང་ལྟོས་བཅས་སུ་གྲུབ་པའི་ཚིག་གི་གྲུབ་ཆ་དབྱེ་བ་ལ་ཀུན་ནས་འབྱོར་ཞིང་ཡོངས་སུ་མཐུན་པར་གདའ་འོ།",
    "མི་རིགས་ཤིག་གི་སྐད་ཆའི་ནང་དུ་ཡང་ཡང་བསྐྱར་དུ་ཟློ་ཞིང་བརྗོད་དོན་སྟོན་པ་ལ་ཕན་སྐྱེད་པའི་བརྡ་སྤྲོད་ཀྱི་སྤྱི་འགྲོས་གྲངས་ངེས་ཅན་དང་ལྡན་པ་ཞིག་ལ་བྱ་ཞིང་།",
    "དེ་ནི་སྐད་ཆ་དེ་ཉིད་སྤྱོད་མཁན་གྱི་མི་རིགས་ཤིག་ལ་ཐུན་མོང་དུ་གྲུབ་པའི་བསམ་བློ་གཏོང་སྟངས་ཡིན་ལ།",
    "སྐད་ཆ་རི་མོའི་མཚོན་རྟགས་སུ་བརྒྱུས་པ་ནི་ཡི་གེ་ཡིན་པས།",
    "ཚིག་གི་སྒྲིག་རིམ་ལ་ངེས་པ་གཏན་ཆགས་པ་ནི།",
    "མི་རིགས་ཤིག་གི་ཁོངས་མི་ཐུན་མོང་གི་བསམ་བློ་གཏོང་སྟངས་གཏན་ཆགས་པ་ལ་ཐུག་ཕྱིར།",
    "རང་རེ་བོད་པའི་སྐད་ཆ་འདི་ནི།",
    "ཁ་གསབ་ཀྱི་སྒྲ་ནི་གསལ་བྱེད་ཀྱི་སྒྲ་ཡི་རྗེས་སུ་འབྱུང་མོད།",
    "ཁོང་གིས་སྨྱུ་གུ་སེར་པོ་སྤར་བ་གང་འཕྲལ་དུ་ཅོག་ཙེའི་སྟེང་ལ་གཡུགས་སོང་།",
    "ཁོང་གིས་སྨྱུ་གུ་གཡུགས་སོང་།",
    "ཚིག་གི་གྲུབ་ཆ་ནི་བརྗོད་དོན་གྱི་གནས་སྐབས་ལ་ལྟོས་ཕྱིར།",
    "ཚིག་གི་གྲུབ་ཆ་ལ་མིང་གང་ཞིག་སྦྱོར་བ་ལ་ངེས་པ་ཡོད་ཀྱང་།",
    "ཚིག་ཅིག་གི་གྲུབ་ཆ་ཐམས་ཅད་ངེས་པར་ཚང་དགོས་པ་མ་ཡིན་ནོ།",
    "སྐད་རིགས་སོ་སོའི་ཚིག་གི་གོ་དོན་འཇོག་ལུགས་ཨེ་འདྲ།",
    "ཚིག་གི་གྲུབ་ཆ་གཙོ་བོ་མིང་གང་དག་གིས་བྱེད་པ་ཡིན།",
    "མིང་དུ་མ་ལྷན་དུ་སྦྱར་ཀྱང་བྱ་བ་བརྗོད་པའི་མིང་ཞིག་མེད་ན་ཚིག་ཏུ་མི་འགྲོ་བར་ད་དུང་མིང་གི་ཚོགས་པའི་གནས་སྐབས་ན་ཡོད་པར་བཞེད་པ་དང་།",
    "རྒྱ་ཡིག་གི་བརྡ་སྤྲོད་ཀྱི་བསྟན་བཅོས་དག་ཏུ།",
    "ཚིག་ནི་མིང་ངམ་མིང་གི་ཚོགས་པས་གྲུབ་ཅིང་སྒྲའི་འདེགས་འཇོག་གི་ཁྱད་པར་གསལ་པོ་ལྡན་པའི་སྤྱི་ལྡོག་ནས་བསྟན་བྱ་གང་ཞིག་རྫོགས་པར་སྟོན་པའི་སྐད་ཆའི་སྦྱོར་བ་ཞིག་ཡིན།",
