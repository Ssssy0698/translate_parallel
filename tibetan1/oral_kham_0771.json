    "བོན་སྒོམ་དེ་པ་ཞེས་བྲིས་སྲོལ་འདུག་ལྟ་གུར་མི་གཉིས་ནི།",
    "ངའི་བུ་འདི་བསྟན་པའི་གཙོ་བོ་དང་ཚུལ་མཐུན་པ་འགྲོ་བར་ཕན་ཐོགས་པ་ཅིག་འོང་བར་འདུག་པས།",
    "དེ་ཡི་དྲུང་ནས་བེ་རོ་ཙ་ནས་གསན་ཏེ་ཁམས་ཕྱོགས་སུ་བྱོན་ནས་རྒྱ་ཆེར་གསུངས།",
    "དེ་ལྟར་བེ་རོ་ཙ་ན་དང་།",
    "བེ་རོ་ཙ་ནའི་སྐུ་དུས་སུ་བཀའ་བསྟན་མང་པོ་གཏེཪ་དུ་སྦས་སྟབས་ཕྱིས་ཉེ་བརྒྱུད་གཏེཪ་མའི་ཁོངས་སུ་གསུངས་པ་མང་།",
    "དེ་ཤིན་ཏུ་ཡིན་པ་འདུག་ཅེས་གསུངས།",
    "དེས་ན་བཀའ་གདམས་པ་ཕྱི་མ་ཕལ་པོ་ཆེས་རྒྱ་གར་གྱི་གཞུང་དེ་རྣམས་ཀྱི་དོན་དང་མ་འདྲེས་འཆད་ཤེས་པ་དཀོན་པར་བྱུང་འདུག་ཅེས་གསུངས།",
    "ས་ཁྱེམ་གང་ཡང་སྐྱེལ་རོགས་མེད་པར་མི་ལ་ཐོས་པ་དགའ་བ་ཁོང་རང་གཅིག་པུས་བཞེངས་པས།",
    "དྭགས་པོ་བཀའ་བརྒྱུད་ཀྱི་ཕྱག་ཆེན་དང་གནས་གཅིག་པར་མཁས་གྲུབ་ཁྱུང་པོས་མཛད་པའི་གཞུང་ཆེ་རིགས་མི་འདུག་པས།",
    "མཆི་མ་རྩིག་རྩིག་འདུག་དེར་སྔར་ནས་དད་པའི་ཁ་ལ་ལྷག་པར་དྲུང་དུ་འགྲོ་འདོད་པ་བྱུང་།",
    "གཞན་ལ་ཕན་ཐོགས་པར་འདུག་གསུངས་ནས་སླར་ཡང་གཞི་སྨད་ལྷ་རི་རྒྱལ་པོ་ལ་ཟླ་བ་གསུམ་བཞུགས།",
    "རྡོ་རྗེ་གདན་པ་ནི་ཤྐ་ལངྒ་དེ་ཝས་གསུངས་པའི་འཆིང་བ་རྣམ་གྲོལ་གྱི་བསྟན་བཅོས་སོགས་ཀྱི་ལྟ་བའི་འགྲོས་ཀྱང་ཕྱག་རྒྱ་བ་དང་མཐུན་པར་འདུག་གོ་ཤོག་གྲངས་༡༣༧ཞེས་གསུངས་པ་ལྟར་ན།",
    "དེ་ནས་ཉང་པོ་བརྒྱུད་དེ་ནག་ཤོད་དུ་བྱོན་པས་ཁྱེད་སྙེད་ཚུལ་བ་ཞིག་འདུག་པས་ཅི་ཤེས་ཟེར་བ་ལ།",
    "སྒྱུ་ལུས་ཆགས་སྡང་རང་གྲོལ།",
    "དེ་ལྟར་འབད་པས་ཕྱི་རོལ་ཡུལ་སྣང་འདི་དག་སེམས་ཀྱི་འཕྲུལ་ངོ་ཙམ་ལས་ཕྱི་རོལ་ན་བདེན་པར་མི་འདུག་སྙམ་པའི་དོན་ལ་ཡིད་ཆེས་ཀྱི་གསལ་སྣང་ཅུང་ཟད་འབྱུང་སྟེ།",
    "དེ་ནས་དགུང་ལོ་དོན་གཉིས་སུ་ཕེབས་ཏེ་འགྲོ་འདུག་དཀའ་བས་མཁའ་ལྡིང་ཕུང་པོའི་རི་ཁྲོད་དུ་གདན་འདྲེན་ནས་བཞུགས།",
    "གོང་གསལ་དེ་རྣམས་ཀྱི་ཐོག་ནས་གངས་ཅན་བོད་ཀྱི་སྔོན་བྱོན་མཁས་གྲུབ་དུ་མས་རང་རང་སོ་སོའི་ལྟ་བའི་བཞེད་པ་མང་དུ་གསུངས་ཤིང་།",
    "ཁྱིམ་དུ་སྟེན་ལས་མ་བསྟབས་འདུག་པ་དང་།",
    "ལམ་དུ་འདུག་ནས་བདག་ནི་ལམ་གནས་ཞེས།",
    "བརྩེ་ཕྱིར་མི་སྨྲ་བར་ནི་འདུག་མི་བྱ།",
    "འདབ་ཆལ་གསུམ་དང་གོས་ལ་འདུག་བྱེད་དང་།",
    "སྡོམ་བརྩོན་འདུག་ནའང་ཉེས་པ་མེད་པ་ཡིན།",
    "དེ་ཡོལ་གང་ཞིག་དུས་རུང་ཟ་བྱེད་དེ།",
    "དེ་བཞིན་ཙོག་ཙོག་པོར་ཡང་འདུག་མི་བྱ།",
    "ཡན་ལག་ལྔ་དང་སྒྱིད་བཟུང་རང་བཞིན་ནོ།",
    "རྗེ་འགྲོ་བའི་སྐྱབས་ལ་བྱོན་ཙ་ན།",
    "སུས་ཀྱང་མ་བྱས་ཤིང་རང་བྱུང་བ།",
    "ཡེ་ཤེས་དྲུག་དང་སྐུ་དྲུག་རང་བྱུང་དུ་ཤར་ཞིང་རང་བྱུང་དུ་གྲོལ་བ་ཡིན་ནོ།",
    "བདེ་གཤེགས་སྲས་ཀྱི་སྡོམ་ལ་འདུག་པན།",
    "དེ་ཡང་རང་ལ་འབྱོར་པ་ཆེ་བར་ཡོད་ན་ཆེ་བར་བཏང་དགོས་ཏེ།",
    "སྟོང་ཉིང་རང་བཞིན་དུ་བརྗོད་པས།",
    "འདུག་པའི་སྙན་ནི་སྦྱིན་འཁྲབ་པའམ་ཡང་ན་སྦྱིན་གྱེན་དུ་འགྲོ་བ་ལྟ་བུར་འཕྱུར་བའོ་ཞེས་སོ།",
    "བདག་ནིམ་ལན་འདུག་བཞིན་དུ།",
    "གཞན་གཟེངས་བསྟོད་པ་གཉིས་ཀྱི་དང་པོ་ལ་ཡང་རང་དོན་གྲུབ་པས་དང་།",
    "ཅེས་ཉན་ཐོས་ཀྱི་བརྩོན་འགྲུས་ཐ་མ་དང་རང་རྒྱལ་གྱི་འབྲིང་ཐེག་ཆེན་གྱི་མཆོག་ཡིན་ལ།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "ངོ་བོ་ཉིད་སྟོང་རང་བཞིན་འོད་གསལ་བ།",
    "གོམས་པའང་རང་ལ་རག་ལས་པས།",
    "སྤྱོདན་ཡང་བདག་སྤྱོད་ཏོ་ཞེས་རག་ཏུ་ཤེས་སོ་འགྲེང་ན་ཡང་བདག་འགྲེང་པོ་འདུག་ན་ཡང་བདག་འདུག་གོ་ཉ་ལན་ཡང་བདག་ཉལ་ལོ་ཞེས་རགཏུ་ཤེས་སོ།",
    "ཞེས་པའི་འབྲུར་སྣང་ཞིང་གོང་མའི་མཚན་ཉིད་ཀྱཱ་ནུས་པའི་ཟུར་ལ་བརྟགས་ནའང་ངོ་ཚ་ཤེས་པ་འཐོབ་པར་འདུག་ཞིང་ངོ་ཚ་ཤེས་པན་གུས་འཇིགས་གཞི་ཀར་དུ་མ་འདུ་བས་རྒྱ་དཔེ་ལ་ངེས་པར་ཡོད་པ་ཞིག་ལོཙཱ་བས་ཟུར་ཆད་པར་སྣང་ངོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་རྟག་པ་དང་གྲནས་སྐབས་ཀྱི་སྐྱེ་བ་དང་འཇིག་པ་དག་དང་ཡང་མ་འབྲེལ་བར་འདོད་ཏེ།",
    "ཞེས་པའི་གཞུང་རྐང་བ་གཉིསལྷག་པོར་ཡོད་པའི་འབྲུ་འདུག་ལ་འགྲེལ་པ་གཞན་ལ་ང་མ་སྣང་ཡང་དེའི་ཚེ་ན་བདག་རྟག་པས་གནོད་པ་བྱེད་པ་དང་དེའི་སྐྱོན་སེམ་པ་སོགས་ལ་དངོས་མེད་ཏུ་གྱུར་པའི་འབྲེལ་པ་དང་དངོས་པོར་གྱུར་པའི་འབྲེལ་པ་གང་ཡང་མེདངོ་ཞེས་འཆད་པར་སྣང་ངོ།",
    "ཅེས་རང་ལ་ཁྲེལ་གདའ་བ་སྟེ་འདི་ལྟར་འབྲས་བུ་འདོད་ལ་བརྩོན་འགྲུས་མི་མིརྩོམ་པ་ནི་འགལ་ལོ་ཞེས་སོསོགས་ཀྱི་དོན་ཅན་ནོ།",
    "རྔོན་པ་ཞིག་རྟག་དུ་རྔོན་གྱི་ཕྱིར་ནགས་སུ་འགྲོ་བ་ལས་བསམ་གཏན་པ་དགམཐོང་ཞིང་རང་ཉིད་ཀྱང་ནགས་སུ་གོམས་པས་བསམ་གཏན་པར་གྱུར་པ་ལྟན་དབེན་པར་གོམས་སུ་གཞུག།",
    "ཚིགས་བཅད་གཉིས་ཀྱིས་སྔག་སྣལ་ཡིན་ཡང་རང་གཞན་ལ་ཕན་ན་བསྟན་རིགཉེས་པར་བསྟན་ཏོ།",
    "དེ་འདུག་པན་མུན་པ་མེད།",
    "ཏིང་ངེ་འཛིན་ལ་སོགས་པའི་རྐྱེན་ག་ན་དག་དང་ལྡན་པ་ན་གཞན་གྱི་སེམས་ཤེས་པ་དྲང་རང་གཞན་གྱི་སྔོན་གནས་རྗེས་སུ་དྲན་པ་མཐོང་བའི་ཕྱིར་རང་རིག་སླད་གསལ་བ་ཡོད་ཏོ་ོན།",
    "དེའིརྩོད་པ་སྤོང་བར་འདོད་ནས་ཇི་ལྟར་ན་སུ་མ་བདེན་པ་མིན་ཡང་འཇིག་རྟེན་གྱི་བལྟ་བྱ་ཙམ་དུ་གྲགས་པའོ་ཞེན་འོན་ལེགས་ཏེ་ལྟ་བྱེད་ཀྱི་ཡིད་ཀྱང་རང་རིག་སོགས་གང་དུ་ཡང་མ་བདེན་པ་ལྟ་བྱེད་ཏུ་གྲགས་བ་ཙམ་དུ་ཤེས་བར་ཀྱིས་ཅིག།",
    "ལུང་གཞན་ལ་ཡང་རང་གཞན་དག།",
    "འོ་ནར་ཞིག་ལམ་གྱི་རྟེན་དུ་འབྲས་བུའི་རྨོངས་པ་མ་ལྡོག་པ་ལྟར་བདག་འཛིན་ཡང་བསྟན་བར་འོས་སོ་ཙ་ན།",
    "ཡང་མི་ཞིག་དངོས་སུ་སྦྱིན་པ་སོགས་མི་བྱེད་པར་གཉུག་མར་གནས་ཀྱང་རང་བཞིན་གྱིས་རྒྱུད་དྲང་ཞིང་ཀུན་ལ་གཉེན་ག་ཤིན་བཞིགན་མིའི་འདི་ནི་རང་བཞིན་གྱིས་དགེ་འོ་འོས་འཇོག་པ་ལྟ་བུ་ཡིནནོ།",
    "རང་རང་བློ་གྲོས་ཉི་འོད་འབུམ་བརྡལ་ཡང་།",
    "རིག་པའི་རང་གྲོལ་གཤིས་ཀྱི་འདུག་ཚུལ་ཡིན།",
    "ལྷ་རིས་བས་ཐང་ཁའི་རས་གཞི་བརྒྱངས་པ་ཞིག་བཟུང་འདུག་པར།",
    "ཞལ་ཐང་བཞུགས་པའི་སྒམ་བུ་ལ་ཟླ་བའི་འོད་ཀྱིས་ཁྱབ་འདུག་པ་མངོན་སུམ་མཐོང་ནས་ལངས་ཏེ་རབ་རྒྱས་ལ་ནམ་ལངས་འདུག་པས་འགྲོ་རན་བྱས་པས།",
    "སླར་ང་ལ་ཇི་ལྟར་གསུངས་པ་དེ་ལྟར་བྱས་པས་རྟགས་ཀྱང་དེ་ལྟ་བུ་བྱུང་བས་མཁྱེན་པ་དངོས་སུ་གདའ་ཞེས་ཟེར་གྱིན་མཆིས།",
    "ཁྱེད་ཀྱིས་མཛད་པའི་ཚེམ་བུ་ལུགས་ཀྱི་ཐུགས་རྗེ་ཆེན་པོའི་སྒྲུབ་ཐབས་ཉུང་ངུ་དོན་ཚང་ཞེས་བྱ་བ་དེ་ང་ལ་བསྟན་བྱུང་བ་དང་དེའི་ལུང་ཡང་ཞུས་པ་ཡིན་པས་ཁྱེད་ཉིད་མཁན་ཆེན་ཞི་བ་འཚོས་རྣམ་འཕྲུལ་ཞིག་ཡིན་ངེས་འདུག་པས།",
    "ང་རང་མཇལ་དུ་འོང་བ་ཡིན་ཞེས་གསུང་ཞིང་ཉམས་བཞེས་ཀྱི་རྟོགས་འབུལ་ཞིག་ཀྱང་མཛད་བྱུང་།",
    "དྲག་ཏུ་མི་འདུག་པས་ཁོང་རང་ནས་འཚོ་ཐུབ་མིན་བྱུང་ན་རྗེ་ཤུལ་གྱི་བྱ་བ་འདི་ལྟར་དགོས་ཚུལ་ཟེར་བ།",
    "ཁྱད་པར་རྩིས་སྐོར་ལ་བརྒྱུད་ཐག་ཉེ་བ་ཁུངས་བཙུན་པ་དཔྱོད་ལྡན་མགུ་བ་བསྐྱེད་པའི་མཁས་པ་ཞིག་འདུག་པ་ལས།",
    "གཏོར་མ་ལ་སྤུ་ནག་སྐྱེ་བ་ཅུང་ཟད་སྐྱོན་དུ་འཛིན་མཁན་ཀྱང་ཡོད་འདུག་ཀྱང་།",
    "སྐུ་ཚབ་གཟུངས་སྲུང་ལ་རིགས་སྲས་ཁྱད་འཕགས་ཞིག་སྦྲུམ་འདུག་པར་ངེས་ཀྱང་འགྱུར་ལྟས་ཡིན་ནམ་ཅི་ཡིན་མ་ངེས་པས་རིམ་གྲོ་དགོས་ཚུལ་སོགས་ས་སྐྱོང་ཆེན་པོར་གཏིང་བསྐུལ་ཞུ་བཅུག་པས།",
    "བདག་ལ་བཀའ་ལུང་ཕེབས་ནང་འདི་ལོར་མི་དྭོགས་ཀྱང་སླར་དོན་བརྒྱད་སྟེང་འཚུབས་ཚུལ་དང་རིམ་གྲོ་ཉུང་ཤས་འདུག་པས་ཁོ་བོའི་རྐང་འབམ་ཟླ་ནང་ཅུང་འཕར་བས།",
    "དེ་བས་ཁྱེད་རང་ཅི་སྔ་ཡིད་ལྷུང་ལ་འབྱོན་ཚུར་ལམ་ཁྲོ་སོགས་ནས་འདིར་མི་བཏང་གྱིས་དང་ཆབ་ཚན་ལ་བཏེག་འགབ་མིན་གསལ་འོང་ཚུལ་བཀོད་པ་བགྱིས།",
    "དབུགས་ཁ་རྒོད་པ་སོགས་ཡང་འདུག་པ།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་ཕན་བསྐྱེད་མེད་པའི་ཁམས་ཇི་ལྗི་ལས་མི་འདུག་པས།",
    "རང་རྩར་ཐུག་དུས་རོགས་ཅེས་པའི་དཔེ་ལྟར་གང་གཟན་དགོས་པ་མེད་ཚུལ་དང་།",
    "ཁོང་རང་ནས་ཀྱང་ལམ་འབྲས་དུས་ཐང་བྲི་རྒྱུའི་ཁས་ལེན་བྱེད་འདུག་བྲིས་པ་བུ་ཆུང་ལའང་སྟེར་ཆ་ཕྲན་བུ་ཞིག་དགོས་ཚུལ་སྨྲས།",
    "རང་རང་གནས་དང་སྣ་ལས་འབྱུང་།",
    "གཞན་ཐོ་ཡིག་སོགས་མི་འདུག་པས་རགས་རིམ་དེ་ཙམ་ལས་ཞིབ་བཀོད་རྔོ་མ་ཐོག་ཅིང་།",
    "ཁོང་རང་ལ་དར་ཁ་ཞིག་གནང་བའི་མནལ་ལྟས་བྱུང་འདུག་པ་ཡང་དཔོན་སློབ་དམ་ཚིག་སེལ་མེད་ཀྱིས་དག་པ་ཡེ་ཤེས་ཀྱི་སྐུས་སྐུ་ཞབས་ཀྱི་བར་གཅོད་སོགས་སེལ་བའི་རྟགས་སུ་ངེས་ཤིང་།",
    "ཉེ་གནས་ལྷུན་གྲུབ་ཕུན་ཚོགས་ལ་ཡང་སྔ་ཕྱིར་ཡང་སྲིད་ཀྱི་བརྡ་རྟགས་རྨི་ལམ་ཁ་ཤས་བྱུང་འདུག་པ།",
    "མིའུ་ཐུང་གེལ་བའི་འདུག་སྟངས་ཀྱིས་རོའི་གདན་ལ་བཞུགས་པ།",
    "ནཱི་ལ་ཀ་ནི་ཀ་ཞེས་གསེར་གྱི་སྐད་དོད་འདུག་པ་དང་།",
    "འཇིག་རྟེན་གསུམ་པོ་ཞབས་ཀྱི་མནན་ཏེ་ཞེས་དྲངས་འདུག་པ་ནི།",
    "འབྲེལ་བ་ཐམས་ཅད་དུ་ཕྱོགས་སྐྱོང་ལ་མ་སྦྱར་འདུག་ཀྱང་།",
    "གྲུབ་ཆེན་གྱིས་འདི་ལ་རབ་གནས་སྦྱར་འདུག་པ་ཕྱོགས་ཀྱི་འཁོར་ལོ་ཀུན་སྐུའི་འོད་ཀྱིས་འགེངས་པར་གསུངས་པའི་རྒྱུད་ཚིག་འདི་ལ་བརྟེན་པ་སྟེ།",
    "ཉིན་ཞི་མཚན་ཁྲོའི་སྔགས་བཀོད་པ་ཙམ་ལས་མི་འདུག་ཀྱང་།",
    "འགྲེལ་བ་གཞན་དུ་ཚིག་ཊིཀ་ཙམ་ལས་མི་འདུག་ཀྱང་།",
    "རྐང་བ་དང་པོ་གཉིས་ཀྱི་དགོངས་པར་བྱས་པ་ཡིན་འདུག་སྟེ་ཞིབ་ཏུ་དཔྱད་པར་བྱའོ།",
    "འདབ་མ་སྟོང་དང་ལྡན་པ་སྣ་ཚོགས་སུ་འདུག་པ་བལྟ་ན་སྡུག་པ།",
    "མཛེས་ཤིང་ལྷམ་མེ་ལྷན་ནེ་ལྷང་ངེར་འདུག་གོ།",
    "མཛེས་ཤིང་ལྷམ་མེ་ལྷནནེ་ལྷང་ངེར་འདུགགེ།",
    "མཛེས་ཤིང་ལྟམམ་ལྷནནལྷང་ངེར་འདུག་གོ།",
    "དེ་བཞིན་གཤེགས་པའི་སྐུ་བལྟ་བས་ཆོགམི་ཤེས་པ་གདའའདིའི་རྒྱུ་གང་ལགས།",
    "ཕྱོགས་གཅིག་ཏུ་འདུག་ནས།",
    "འཇམ་དཔལ་གཞོན་ནུར་གྱུར་པ་འདུག་པ་དང་།",
    "འདུག་པ་དང་།",
    "འདི་འདུག་པར་མི་འགྱུར་རོ།",
    "ཡུན་ནི་འདི་སྲིད་གཅིག་ཏུ་འདུག་འདུག།",
    "ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དེ་ཡང་རང་བཞིན་གྱིས་སྟོང་པའི་སླད་དུ་ཡོངས་སུ་གཟུང་བ་མ་མཆིས་པ་ལགས་སོ།",
    "ཚདང་ལྡན་པ་རབ་འབྱོར་བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་སེམས་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཀྱི་ཕུར་བྲག་པ་མེད་ཅིང་ཁོངས་སུ་གཏོག་བ་མ་ཡིན་པ་ཡིན་ནམ།",
    "སས་རྒྱས་བཅོམ་ལྡན་འདས་རྣམསཀྱི་ཐུགས་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་བྲག་པམེད་ཅིང་ཁོངས་གཏོགཔ་མ་ཡིན་པ་ཡིན་ནམ།",
    "ཆོདང་ལྡན་པ་རབ་འབྱོར་གཟུགས་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་༢ཟག་པ་མེད་ཅིང་ཁོངས་སུ་གཏོགས་པ་མ་ཡིན་པ་ཡིན་ནམ།",
    "རྣམ་པར་ཤེས་པ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་བྲག་པམདཅིང་ཁོངས་སུ་གཏོགས་པ་མ་ཡིན་པ་ཡིནནམ།",
    "བྱིས་པ་སོ་སོའི་སྐྱེ་བོ་རྣམས་ཀྱི་སེམས་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པམེད་ཅིང་ཁོངས་སུ་གཏོགས་པ་མ་ཡིནནོ།",
    "གཟུགས་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་གཏོགས་པ་མ་ཡིནནོ།",
    "རྣམ་པར་ཤེས་པའི་བར་དུ་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་ཉིད་ཀྱི་ཕྱིར་ཟག་པ་མེད་ཅིང་ཁོངས་སུ་གཏོགས་པ་མ་ཡིན་ནོ།",
    "འདུག་པ་དང་།",
    "གཟུགས་བཞིར་ཕྱེ་ནས་འགྲེང་ངམ་འདུག་སྟེ་སོ་སོར་རྟོག་པ་དེ་བཞིན་དུ།",
    "བུ་ག་རྣམས་ཟ་ཞིང་འདུག་པ་འམ།",
    "སྲོག་ཆགས་ཀྱི་རིགས་གང་ཡང་རུང་བ་རྣམ་པ་སྣ་ཚོགས་དག་ཟཞིང་འདུག་པ་དག་མཐོང་ན།",
    "མགོ་བོའི་ཐོད་པ་རྣམས་ཀྱང་གཞནན་འདུག་བདགམཐོང་བ་ན།",
    "སྤྱོད་བའི་འགྲོས་ཡིག་ཕྲེང་ལྔ་འདུག་ཀྱང་ཡི་གེ་ཟུབ་ནས་མི་མཐོང་འདུག་ཞེས་པ་སྤྱོད་པའི་ཆོ་གའོ།",
    "དེ་དག་རང་རང་སོ་སོའི་གཟུགས་མ་འདྲེས་པས་ཀུན་ཏུ་མཐོང་བ་དེ་སྲིད་དུ་བཟླས་པར་བྱའོ།",
    "དམག་དཔུང་བཏང་ན་ནུབ་བྱང་གཅིག་པུ་མ་ཡིན་པར་ལྷོ་ནུབ་ནས་བཏང་དགོས་པ་ལོས་ཡིན།",
    "ད་དུང་རང་དམག་བོད་དུ་སྡོད་རྒྱུའི་འཆར་གཞི་ནི་སྲ་བརྟན་འགྱུར་མེད་ཡིན།",
    "རྟ་དྲེལ་བརྒྱད་སྟོང་བཅས་ནུབ་བྱང་ཅུས་ནས་བོད་དུ་བསྐྱོད་དགོས་པའི་ཐག་གཅོད་བྱས་འདུག།",
    "རྒྱ་ནག་བཙན་འཛུལ་དམག་ལ་འགོག་རྒོལ་བྱེད་པའི་དམག་འཐབ་ཉིན་བཅུ་གཅིག་བྱས་འདུག།",
    "ཅེས་བཏང་འདུག་ཀྲུང་དབྱང་བོད་སྡོད་ངོ་ཚབ་ཀྲང་ཅིང་ཨུའུ་ཞེས་པའི་རྒྱ་ཡིག་དེབ་ཤོག་གྲངས་༡༥ ནང་དུ་གསལ།",
    "གནས་ཚུལ་འདི་༧གོང་ས་མཆོག་ལ་ཟུར་ཟ་བྱས་ཏེ་འཕྲིན་བཟང་གཏམ་སྙན་ཡིན་ཅེས་བརྗོད་འདུག།",
    "བོད་རང་བཙན་བྱེད་རྒྱུ་བཅས་ཀྱི་འབོད་ཚིག་སྒྲོག་པ་དང་ལྷ་སའི་ཁྲོམ་སྲང་གང་སར་སྦྱར་ཚིག་དང་དྲིལ་བསྒྲགས་ཡི་གེ་འགྲེམས་སྤེལ་བྱས་འདུག་ཀྲུང་དབྱང་བོད་ལས་དོན་གསང་དེབ་ཤོག་གྲངས་༦༡ ནང་འཁོད་ཡོད།",
    "ཅེས་ཆོག་མཆན་སྤྲད་འདུག་འདི་ནི་ཀྲུང་གུང་བོད་དོན་ཆེན་ཟིན་བྲིས་རྒྱ་ཡིག་དེབ་ཤོག་གྲངས་༧༡ ནང་དུ་གསལ།",
    "བཅོས་བསྒྱུར་བྱེད་པར་ངོ་རྒོལ་གནང་དགོས་རྒྱུའི་འདུན་པ་བཅས་བྲིས་ཡོད་འདུག་ཀྲུང་གུང་བོད་དོན་ཆེན་ཟིན་ཐོ་གསང་དེབ་༧༦ ནང་དུ་གསལ།",
    "སྤྱིའི་བྱེད་ཕྱོགས་ནི་བཀའ་ཤག་དང་ཆུ་བཞི་སྒང་དྲུག་དྭང་བླང་དམག་བཅས་ཀྱི་དབར་ཁ་བྲལ་གྱི་བྱ་ཐབས་སྣ་ཚོགས་བེད་སྤྱོད་བྱས་ཏེ་ཁོ་པ་ཚོ་གཅིག་གྱུར་མི་ཡོང་བའི་ཐབས་ཤེས་བཏོན་དགོས་ཞེས་བྲིས་འདུག་ཀྲུང་གུང་བོད་དོན་ཆེན་ཟིན་ཐོ་གསང་དེབ་ཤོག་གྲངས་༨༥ ནང་དུ་གསལ།",
    "བསྟན་སྲུང་དམག་ཚོས་རས་གྲུའུ་ཙི་སྔོན་པོ་དང་ལྗང་ཁུ་སོགས་ཀྱི་རང་རང་སོ་སོའི་མེ་མདའ་ཕྱིས་རྒྱབ་པ་དང་སྣ་ཐ་འཐེན་པ།",
    "ལན་ཤོག་སོ་སོའི་དམག་འཐབ་ལས་འགན་གསལ་པོ་ཤེས་དགོས་པ་བཅས་ཀྱི་བཀག་རྒྱ་བཏང་འདུག།",
    "དམག་འཐབ་འདིའི་ནང་རྒྱལ་སྲུང་དྭང་བླང་དམག་ཉིས་སྟོང་ཙམ་རང་སྲོག་དོར་འདུག་འདི་ནི་ཀྲུང་གུང་བོད་ལས་དོན་ཟིན་ཐོ་གསང་དེབ་རྒྱ་ཡིག་ཤོག་གྲངས་༩༩ ནང་གསལ།",
    "ནང་སོག་ཤིན་ཅང་བཅས་ཀྱི་ཏང་ཨུད་ལ་ལག་བལྟར་བྱེད་དགོས་ཞེས་པའི་བཀའ་བཏང་འདུག།",
    "ལྔ་གཅིག་དུས་ཆེན་དུ་བསྡད་པ་ནས་གྲོས་མཐུན་ཆིངས་ཡིག་བཞག་པའི་དུས་ཚོད་རིང་པེ་ཅིང་དུ་ཉར་ནས་བསྡད་པ་དང་།",
    "རྒྱལ་བ་བྱམས་པའི་སྐུ་ཆེན་པོ་འདི་ལྕགས་ཐག་གཡོགས་ཏེ་འཐེན་སྐབས་ལྕགས་ཐག་ཆད་པའི་གནས་ཚུལ་བྱུང་འདུག།",
    "ཚལ་ཞིང་དུ་ལུད་རྒྱབ་རྒྱུ་སོགས་ཀྱི་ལས་ཀ་སྐུལ་གྱི་འདུག་རྒྱ་མིས་གསང་བ་བྱས་སྟབས་ངའི་ཁྱིམ་ཚང་ནས་ང་ག་པར་ཡོད་མེད་རྩ་བ་ནས་མི་ཤེས་ཁར་ང་ལ་གྱོན་ཆས་མེད་པའི་རྐྱེན་གྱིས་བཙོན་རོགས་ཚོར་ཡོད་པའི་འབྲོག་པའི་ལྤགས་ཆེན་གྱོན་ནས་བསྡད་པ་ཡིན།",
    "དེ་མིན་རླངས་འཁོར་༣༢ གཏོར་བསྐྱོན་བཏང་བའི་གྲངས་འབོར་སྐོར་རྗེས་སུ་རྒྱ་དམར་གྱི་གསང་དེབ་ནང་འཁོད་འདུག་སྐབས་དེར་རྒྱལ་སའི་ནང་དུ་ཡུལ་སྐོར་སྤྲོ་འཆམ་དུ་ཡོང་བའི་ཕྱི་རྒྱལ་སྤུན་ཟླ་མང་པོས་རྒྱ་དམར་གྱིས་བོད་མི་ཞི་རྒོལ་བར་དེ་ལྟ་བུའི་དྲག་གནོན་བྱེད་པའི་ཡ་ང་བའི་གནས་ཚུལ་མཐོང་འཕྲལ་ཁོ་ཚོས་ཀྱང་རྒྱ་དམག་ལ་རྡོ་བཞུ་བ་དང་།",
    "༧གོང་ས་མཆོག་སྐུ་ཚེ་ཁྲི་ལོ་བརྟན་པ་ཤོག་སོགས་ཀྱི་འབོད་ཚིག་སྒྲོགས་གནང་ཡོད་འདུག།",
    "ལ་ལ་ན་ནི་ལྷའི་གནས་ན་འདུག།",
    "ལ་ལ་ན་ནི་ཀླུའི་གནས་ན་འདུག།",
    "ལ་ལ་ན་ནི་གནོད་སྦྱིན་གྱི་གནས་ན་འདུག།",
    "ལ་ལ་ན་ནི་ལྷ་མ་ཡིན་གྱི་གནས་ན་འདུག།",
    "ལ་ལ་ན་ནི་མིའམ་ཅིའི་གནས་ན་འདུག།",
    "ལ་ལ་ན་ནི་ལྟོ་འཕྱེ་ཆེན་པོའི་གནས་ན་འདུག།",
    "མ་ནོན་སྨྱོ་བ་ང་རང་ཤེས།",
    "ཇྱི་བཞྱིན་ཚངས་ཆྗེན་བོས་ཀང་དཔོག་པར་དཀའ། འདུག་རྗེས་འདུག་རྗེས་ལྗེབ་ཀྱི་འདུགའག་ོ་རྗེས་འགོ་རྗེས་ཟུར་ག་ྱི་འགོ།",
    "ལཱུ་དྲྱིལ་གྱི་དཀྱིལ་ཆོག་ཏུ་སྱིག་པ་རྭ་ཅན་བྱས་འདུག་པས་དྗེ་ལའང་ཁུངས་ཡོད་པར་གསལ་ཞྗེས་རྒྱལ་མཆོག་ག་ྱིས་གསུངས་པས་ཁུངས་གོང་མ་ཅང་མ་གཟྱིགས་འདྲ།",
    "ལམ་རྱིམ་མཇུག་དང་སྔགས་རྱིམ་སོད་དུ་ཕན་ཚུན་མཚམས་སྦར་འདུག་པ་བཞྱིན་གང་ཟག་གཅྱིག་འཚང་རྒྱ་བའྱི་ཉམས་ལྗེན་སོན་པའྱི་གདམས་ངག་ཏུ་གོ་དགོས་པས།",
    "དབྗེན་སའྱི་བརྒྱུད་རྱིམ་མྱི་དག་པའྱི་བདྗེན་ཁ་ཕུལ་འདུག་འདྲ།",
    "ཞུགས་ཤ་ྱིང་མཐོང་བའྱི་དམ་ཚིག་བརོད་པ་དྲུག་རྣམས་རང་རང་ག་ྱི་ཐད་དུ་མཚམས་ཕྗེ་ངྗེས་ངོ་འབྱོར་བ་ཤ་ྱིན་ཏུ་གལ་ཆྗེ།",
    "མཐའ་རྟྗེན་འདབས་ཐྱིས་ལྟ་བུ་ཟྗེར་བའྱི་གསུང་རྒྱན་འདུག་གསོལ་འདྗེབས་སྣ་ཚོགས་རོ་རྗེའྱི་རྭ་སྗེང་ནས་བྱྗེད་དགོས་པས་ཡོལ་བའྱི་ཕྱི་འཇུག་ཅྗེས་པའྱི་ཡོལ་བ་དཀྱིལ་འཁོར་གྱི་རྱིག་པ་ལ་ཟྗེར།",
    "ལྗེགས་ཆ་བཀོད་འདུག་པ་ལ་གསུངས།",
    "དཀྱིལ་འཁོར་རོགས་པར་མཐོང་དུ་མྱི་རུང་བས་མྱིག་རས་འཆྱིང་ཞྗེས་པའྱི་རོགས་ཀྱི་ནུས་པ་མ་ཐོན་འདུགདཀྱིལ་ཆོག་ལས་ཨ་ཁཾ་སོགས་ས་བོན་དང་མྱིང་ཡྱིག་ཅྱི་རྱིགས་པར་སྦར་བ་ཞྱིབ་ཆ་ཆྗེ།",
    "རྣམ་པའྱི་བྱི་ཐུང་ངུ་ཡྱིན་ཡང་འདྱི་ལ་རྱིང་ཆ་ཞྱིག་འདུགདྲྱི་ལན་དོན།",
    "རྱིག་མ་སྤྱིར་ཉྗེར་རྒྱུར་གསུངས་འདུག་པས།",
    "ཕྲྗེང་བར་སྤྱི་འག་ོའྱི་བདུད་རྱི་སྒྲུབ་སྐབས་ཁ་ཊྭཱཾ་ག་ཞུ་བ་ལས་སྒྲུབ་གསུངས་འདུག་པ་འདྱི་ཕ་རྒྱུད་ལ་ཡང་རུང་ཟྗེར་དགོས་སམ་དཔད།",
    "ལྔ་བ་རང་ནས་གཞན་ཚོར་ཉྱིན་བཅོ་བརྒྱད་མའྱི་ལགས་བཀོད་མཛད་འདུག་པས་དཀྱིལ་འཁོར་སྦྲགས་མ་མྱི་བཞྗེད་པ་མྱིན་འདྲ།",
    "གཅྱིག་པུ་ལ་བྱས་པས་ཆོག་པར་མཛད་འདུག་པས་འདྱིས་མྱི་ཏྲའྱི་གངས་ཕན་གྱི་དཀྱིལ་འཁོར་ལྔའྱི་གོ་ཆོད་ཚུལ་མྱི་ཤྗེས།",
    "ཞྗེས་ཚིགས་བཅད་གསུམ་སྔགས་བཅས་ཀྱིས་ཀུ་རུ་ཀུལྗེ་འདྱི་གསལ་བར་བསན་འདུགདག་ནག་ལྗེའུ་བཅོ་ལྔ་བར་ཡང་རྱིགས་བྱྗེད་མ་ཞལ་བཞྱི་བ་ཞྱིག་བསན།",
    "ཕག་དྲུག་པ་དྗེ་ཀུན་ལ་སྦོར་རྒྱུ་བྱས་འདུགཀ་ྗེ་རོར་ཡྱིག་སྣའྱི་རྱིགས་སོགས་རོག་ཟྱིན་ལྟར་གསུངས།",
    "བདྗེ་གསང་ཀ་ྗེ་རོར་སོགས་རང་རང་རྱིགས་གཅྱིག་པ་རྣམས་སྦྲགས་ན་ལྗེགས་པ་ལ་བསམ།",
    "བུམ་པ་གཅྱིག་ལས་མྗེད་ན་མཚན་མ་གཅྱིག་གམ་གཉྱིས་ཀྱིས་ཆོག་པར་སྔགས་རྱིམ་ལས་གསུངས་པ་འདྱིས་བུམ་མཚན་ནྱི་བུམ་པ་མང་ཚེ་ལྷ་གང་ག་ྱི་བུམ་པ་ཡྱིན་མྱི་ནོར་ཆྗེད་ཡྱིན་པས་རྣམ་བུམ་ལས་བུམ་གཉྱིས་ལས་མྗེད་ན་བུམ་མཚན་མྗེད་ཀང་ཆོག་པར་བསན་འདུག་པས་བརྗེད་མྱི་ཉན།",
    "ཞྗེས་སྒྲུབ་ཐབས་སུ་གསུངས་པ་འདྱིས་དམྱིགས་ཕྗེ་འདུགབྱ་སྤོད་ཀྱི་ལམ་ལ།",
    "དགདའ་བདའ་བར་ལྡ་ཡོད་གདའ་དང་།",
    "སང་རང་ཆགས་སང་འདོགས་ཐག་རང་།",
    "དམངས་དང་རང་དང་སྨྲྗེང་རྣམས་ནྱི།",
    "གཙང་དང་རངས་དང་རང་རྣམས་ནྱི།",
    "རྱིངས་དང་རངས་དང་རྗེངས་རྣམས་ནྱི།",
    "ཐ་སྙད་བཏགས་པ་རུ་འདུག་པ་དོན་དུ་བཟུང་།",
    "བར་ཆད་རང་སེམས་སུ་འདུག་པ་འདྲེ་རུ་བཟུང་།",
    "རྣམ་རྟོག་ཡེ་ཤེས་སུ་འདུག་པ་སྐྱོན་དུ་བཟུང་།",
    "ལྕི་ལྕི་ལྟར་འདུག་ཁྱབ་འཇུག་བྱིན་ཡང་སྟོབས་ཆེན་སྡུག་བསྔལ་གནས་སྐབས་གྱུར།",
    "གནག་རྗེས་ལྟ་བུར་གསལ་ལེར་གདའ།",
    "རང་རང་སྐལ་པ་ཇི་བཞིན་བསྟན་ཐོས་ནས།",
    "ཕུན་ཚོགས་བདོག་པ་བཏང་ཡང་རང་མཐུ་ལ།",
    "མངར་པོར་འཐུལ་དང་རང་ཤ་སྟེར་དགྱེས་པ།",
    "དམན་པར་གྱུར་ནའང་རང་ལས་གཞན་གཅེས་ཤིང་།",
    "འདི་ལྟར་ཤེས་པ་འཐིབས་པོའི་ནང་འདུག་ཀྱང་།",
    "ཐམས་ཅད་མར་གྱུར་ཤེས་ནས་འགྱོད་ཙ་ན།",
    "དེ་འདྲའི་རྣམ་སྨིན་ངན་འགྲོར་ལྷུང་ཙ་ན།",
    "བྱིས་བློའི་མཚོར་ཡང་རང་ཉམས་བཞིན་འཆར་ལ།",
    "ཐོབ་ནས་ཁྱེད་རང་ལྟ་བུར་བྱིན་གྱིས་རློབས། ཇོ་བོ་རྗེ་ལ་བསྟོད་པ།",
    "རང་རང་བསམ་པ་ཇི་ལྟ་བར།",
