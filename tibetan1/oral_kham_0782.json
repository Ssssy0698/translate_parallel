    "དེ་ལྟའི་དོན་བྱེད་པ་དེའང་རང་བདེན་པ་ཡིན་ཅིང་།",
    "དེ་དག་ལ་རང་རང་སོ་སོར་རྣམ་རྟོག་གཏིང་ཚུགས་མི་འདུག་པའི་ཕྱིར།",
    "དེ་ཡང་རང་རྒྱུད་དུ་ཇི་ལྟར་བཀོད་ཅེ་ན།",
    "དེ་ལྟར་དོན་བྱེད་པས་དངོས་པོ་དེའང་རང་བདེན་པ་ཡིན་ཅིང་།",
    "འོ་ན་རང་ལུགས་དང་རང་ཕྱོགས་ཅུང་ཟད་ཀྱང་མ་བཞག་བཞིན་གཞན་ཁོ་ན་སུན་འབྱིན་པ་ནི་དགོས་པ་མེད་དེ།",
    "ཁོ་བོས་བདག་སྐྱེ་ཡོད་པར་རང་ལུགས་ཚད་གྲུབ་ཏུ་འདོད་པ་དེ་དགག་པར་བྱ་བའི་ཆེད་དུ་སུན་འབྱིན་གྱི་བདག་སྐྱེ་མེད་ཅེས་སྨོས་ཀྱང་རང་ལུགས་ཚད་གྲུབ་ཀྱི་བདག་སྐྱེ་མེད་པར་མ་བཞག་པའི་ཕྱིར།",
    "འདིར་ནི་རྩོད་པའི་ཆེད་དུ་ངག་ཀྱང་རང་ལུགས་ཀྱི་དེར་གྲུབ་པ་ཞིག་འགོད་པ་མ་ཡིན་ཏེ།",
    "དེ་ལྟར་སྒྲུབ་པའི་ངག་འགོད་ཀྱང་རང་བཞིན་མེད་པར་སྒྲུབ་པའི་སྒྲུབ་ངག་འགོད་པ་ནི་གཏན་མིན་ཏེ།",
    "རྩོད་པ་བཟློག་པའི་འགྲེལ་པ་མཛད་པ་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱིས་ཀྱང་རང་རྒྱུད་ཀྱི་སྦྱོར་བའི་ངག་མ་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་དངོས་སུ་བྲིས་གདའ་བས་དེའི་ཤུགས་ལ་ལྟ་བས་ཡེ་ཤེས་ཚོགས་སོགས་ལ་འཇུག་པ་ན།",
    "རང་ལུགས་ཀྱི་ཕྱོགས་གང་ཡང་མི་འཛིན་པའི་སྐབས་སུ་ལེགས་ལྡན་བྱེད་སྒྲུབ་བྱེད་ཐ་སྙད་དུའང་རང་བདེན་པའམ་རང་རྒྱུད་དེ་ལྟར་སྦྱོར་བར་བྱེད་དོ།",
    "ཁྱེད་རང་ཉན་ཐོས་པ་ལ་དོན་དམ་གཏན་ཚིགས་སུ་བྱེད་ན་མ་གྲུབ་པའི་དོན་ཉིད་དང་།",
    "ཡང་ས་མྱུག་དུས་མཉམ་དུ་མེད་དོ་ཞེས་པ་དེ་མི་རིགས་ཏེ།",
    "ས་མྱུག་དུས་མཉམ་གཞན་དུ་གྲུབ་སྟེ།",
    "དཔེ་སྲང་མདའི་མཐོ་དམན་དུས་གཅིག་ཅར་གྱི་ཚེ་བྱེད་པ་ཡིན་ན་ཡང་འདིར་དོན་རྒྱུ་འབྲས་ཀྱི་སྐྱེ་འགག་དུས་གཅིག་པ་མེད་པའི་ཕྱིར་དཔེ་དེས་དོན་དེ་ཡོད་ཅེས་ལན་འདེབས་བྱེད་པ་ནི་བཟང་པོ་མ་ཡིན་ནོ།",
    "དོན་རྒྱུ་འབྲས་ཀྱི་སྐྱེ་འགག་དུས་གཅིག་པ་ཡོད་པ་མིན་ཅིང་ཞེས་དུས་མཉམ་ཡོད་པ་མིན་ཏེ།",
    "ཁོ་ཁོ་རང་མ་ཡིན་པར་འགྱུར་ལ།",
    "འཁོར་འདས་གཉིས་སུ་མེད་པར་འདུག།",
    "སྣང་སེམས་གཉིས་སུ་མེད་པར་འདུག།",
    "རང་གསལ་ཅིར་ཡང་སྣང་ཞིང་གདའ།",
    "དེ་ཡང་དངོས་སྨྲ་བའི་དོན་དམ་གྱི་མཚན་གཞི་འདིར་ཀུན་རྫོབ་ཏུ་འགྱུར་བ་ཡང་རང་རྒྱུད་ཀྱི་གཞུང་ལས།",
    "སྔོན་པོ་སོགས་ནི་བདེན་པར་སྣང་ཞིང་རང་བཞིན་སྟོང་པ་ཉིད་ནི་དེ་ལ་སྒྲིབ་བྲལ་དུ་མི་སྣང་བས་དོན་དམ་པའི་རང་བཞིན་དང་ལོག་པའི་ཀུན་རྫོབ་ནི་ཀུན་རྫོབ་བདེན་པ་མིན་ཅིང་།",
    "དེར་ཡོད་པས་ཡོད་པར་མ་གྲུབ་ཅིང་རང་ལུགས་ལ་ཡོད་པར་བཞག་མ་ཐུབ་པ་ལ་དོན་དམ་པར་མེད་ཅེས་མིང་དུ་གདགས་པའི་ཡོད་པ་མ་ཡིན་པ་དེ་ལ་ནི་མེད་པར་དགག་ཙམ་ལས་དེ་ལ་རིགས་པས་དཔྱད་བཟོད་པར་གྱུར་ནས་སླར་ཡོད་པར་གྲུབ་སྟེ།",
    "དགོས་ནའང་ཁྱེད་རང་ལ་ནང་འགལ་དུ་འགྱུར་རོ་ཞེས་སྐྱོན་རྒྱས་པར་བརྗོད་ཟིན་པའི་ཕྱིར་མི་འཐད་ལ།",
    "ཡོད་པར་སྣང་ཡང་རང་བཞིན་གྱིས་སྐྱེ་བ་མེད་པའི་ཕྱིར།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
    "འཇིག་པའི་འགགས་པ་དངོས་པོ་བ་ལ་དེ་ལྟའི་ཚེ་སྐྱེ་འགག་དུས་མཉམ་གྲུབ་ཏུ་ཆུག་ཀྱང་ཞིག་པའི་འགགས་པ་དངོས་མེད་ལ་དུས་མཉམ་མི་རུང་སྟེ།",
    "འཇིག་པ་ལ་འཇིག་རྒྱུ་དོན་གཞན་མེད་ཀྱང་རང་ཉིད་སྐྱེད་བྱེད་ཀྱི་རྒྱུ་ལས་འཇིག་བྱེད་ཀྱི་རྒྱུར་ཡང་བལྟོས་མེད་དུ་གྲུབ་བོ་ཞེས་དཔལ་ལྡན་ས་སྐྱ་པཎྜི་ཏས་རིགས་གཏེར་རྩ་འགྲེལ་ལས།",
    "དཔྱད་ན་སྐྱེ་འགག་དུས་མཉམ་ལ་སྐྱེ་བ་མི་འགྲུབ་སྟེ།",
    "འགགས་ཞིག་དུས་ཀྱིས་མ་བསྡུས་པའི་ཕྱིར།",
    "དེ་བཞིན་འགགས་ཤིང་རང་བཞིན་ཡོད་མིན་པའི།",
    "འདི་འང་རང་ལུགས་ལ་སྒྲུབ་པ་ནི་མ་ཡིན་གྱི།",
    "རྣག་འབབ་པའི་ཀླུང་སོགས་དངོས་པོ་གསར་སྐྱེ་འགྲོ་བ་ཕན་ཚུན་ལ་སྒྲིབ་ཀྱང་འགྲོ་བ་རང་རང་ལ་མི་སྒྲིབ་པར་དོན་བྱེད་པ་ཅན་གྱི་དངོས་པོ་རང་བདེན་པར་ཡོད་ཅེས་སྨྲ་དགོས་པར་འགྱུར་ན།",
    "དགོངས་འགྲེལ་གྱི་བསྟན་བཅོས་བརྩམས་པ་ཐམས་ཅད་མིའི་རྟེན་ལ་མཛད་ཅེས་ཐག་ཆོད་ཆེན་པོ་ཞིག་བྱས་འདུག་པ།",
    "གཞན་གྱིས་གཞན་འཛིན་པ་མེད་ཀྱང་རང་རིག་པ་ནི་ཡོད་དེ།",
    "ཡང་རང་རིག་མེད་ན་དེ་ཉིད་ཀྱིས་དེ་མ་མྱོང་བར་ཡང་འགྱུར་བ་དང་།",
    "དོན་དམ་དུ་གྲུབ་པ་འགོག་པ་ཡིན་ན་ཀུན་གཞི་དང་རང་རིག་ལ་ཆེད་དུ་བཀར་ནས་འདི་ཙམ་གྱི་དགག་པ་བྱེད་མི་རིགས་པར་འགྱུར་ཏེ།",
    "དངོས་སྨྲ་བ་དང་རང་རྒྱུད་པའི་བདེན་གཉིས་ཀྱི་འཇོག་ཚུལ་བཀག་ནས།",
    "རབ་རིབ་ཅན་གྱི་སྐྲ་ཤད་ཀྱི་བདེན་འཛིན་བཟློག་པའི་ཆེད་དུ་སྐྲ་ཤད་སྣང་ཡང་རང་བཞིན་མེད་དོ་ཞེས་སྨྲ་བ་ལྟར།",
    "ཀུན་རྫོབ་ཐ་སྙད་དུའང་རང་ལུགས་ཀྱི་ཡོད་མེད་གང་དུ་ཡང་ཁས་མ་བླངས་པའི་ཕྱིར།",
    "དངོས་འཛིན་གྱི་འགལ་འདུ་ཅིར་ཡང་གདའོ།",
    "དེ་ཚེ་འབྲས་བུ་མཐའ་དག་དུས་རྟག་ཏུ་རྒྱུ་ཡིན་མིན་ཐམས་ཅད་ལས་ཀྱང་སྐྱེ་བར་འགྱུར་ཏེ།",
    "༡༩རབ་རིབ་ཅན་ལ་བརྒལ་ཞིང་བརྟག་པ་ཕར་འདུག་ཅིག།",
    "འཁོར་འདས་འཆིང་གྲོལ་གྱི་རྒྱུ་འབྲས་འདི་ཐམས་ཅད་ལ་ངོ་བོ་ཉིད་དང་རང་བཞིན་ཡོད་ན་དེ་ལྟར་དེ་བཅོས་མིན་དང་།",
    "ད་འཇིག་རྟེན་སྤྲོས་དང་བྲལ་ཙ་ན།",
    "གཞན་ལུགས་ཀྱང་འགོག་དོན་མི་འདུག་པས།",
    "དེས་ན་དངོས་པོ་འགའ་ཡང་རང་བཞིན་གྱིས་ཁས་མ་བླངས་ཏེ་རྐྱེན་འདི་པ་ཙམ་གྱི་རྟེན་འབྱུང་རྣམ་པར་བཞག་པའི་ཕྱིར།",
    "དཔྱོད་བྱེད་དཔྱད་བྱ་ཉིད་ཀྱང་རང་བཞིན་གྱི།",
    "ཁམས་དང་རང་བཞིན་གཅིག་པ་ཡིན།",
    "ན་དུ་འདག་ཆལ་རང་རང་སྐབས།",
    "པཎྞཾབསད་འདུག་བགེགས་བསྐྲད་སྔོན་འགྲོ་བསལྔལ་ཡང་ཨོ་པཉྩ་གནྡྷེ་ཨཱ་ཧཱུཾ།",
    "འགྲོ་རྣམས་རྡོ་རྗེའི་གདན་ལ་འདུག་གྱུར་ཅིག།",
    "དེས་ན་གཞུང་རྣམས་སུ་བདེན་གྲུབ་དང་རང་མཚན་གྱིས་གྲུབ་པ་སོགས་ལ་ཁྱད་མེད་དགག་པ་དང་།",
    "དེ་ལྟར་ཐ་སྙད་སེམས་ཉིད་སྣང་བ་སྣ་ཚོགས་པར་སྣང་ཡང་སེམས་ཀྱང་རང་བཞིན་གྱིས་བདེན་པར་མེད་པས་ན།",
    "རང་རང་ལ་གྲགས་ཤིང་གྲུབ་པའི་སྣང་ཚུལ་སྣ་ཚོགས་ཡོད་པའི་རང་ངོའི་སྣང་བ་དེ་དག་ཐད་ཀ་རང་སར་སྤྲོས་བྲལ་གཏན་ལ་འབེབས་པ་ཡིན་གྱི།",
    "རང་རྒྱུད་པས་ཀྱང་རང་མཚན་གྱིས་གྲུབ་པ་དོན་དམ་དཔྱད་བཟོད་བསྒྲུབ་པ་མིན་པས།",
    "དེ་སྐད་འང་རང་འགྲེལ་ལས།",
    "གཞུང་འདིར་ཡང་རང་འགྲེལ་ལས།",
    "ཡང་རང་རྒྱུད་སྦྱོར་ཡང་རུང་སྟེ།",
    "རིལ་པོ་གཅིག་མིན་ཀྱང་རུང་རང་བཞིན་ནམ་རྒྱུད་ལྟ་བུ་གཅིག་ཡིན་པས་གནས་སྐབས་ཐ་དད་ནའང་རྟག་པ་ཡིན་པ་ཅི་འགལ་སྙམ་སེམས་པ་སྟེ།",
    "སོ་སོར་བརྟགས་པའི་སྟོབས་ཀྱིས་ཁེགས་པ་མིན་ཡང་རང་བཞིན་གྱི་རྐྱེན་མ་ཚང་བས་གང་སྐྱེ་བ་མིན་པ་ལ་དེ་མ་སྐྱེས་པའི་ཆ་དེ་ག་ལ་དངོས་པོ་དེ་སྐྱེ་བའི་གེགས་བྱེད་པའི་འ་ས་མ་བྱས་སོ་སོར་བརྟགས་མིན་ཞེས་རྫས་སུ་རློམ་པ་དང་།",
    "འབྲས་བུ་མི་བསྐྱེད་ཀྱང་རང་བཞིན་གྱིས་རྟག་པར་འདོད་པ་བྱེ་སྨྲའི་ལུགས་ལའང་མི་འཐད་པ་ཡོད་ཅེས་གོང་མ་དང་ཕྱོགས་སྦྱར་ཏེ།",
    "ཡུལ་ཁོ་རང་རྟག་པ་ཡིན་པའམ་གཅིག་བདེན་ཡིན་ན།",
    "ཤེས་པ་མིན་པ་བུམ་པ་མིན་པ་སོགས་ཁོ་རང་མིན་པའི་ཤེས་བྱའི་ཆ་ཇི་སྙེད་ཡོད་པ་དེ་སྙེད་ཀྱི་གྲངས་སུ་དབྱེར་རུང་ལ།",
    "དངོས་མེད་ཁོ་རང་རང་རྐྱ་བ་པར་གཞིར་བཞག་ལ་དགག་སྒྲུབ་མི་བྱེད་པར་བསྟན་ན་དོན་དམ་པར་མ་གྲུབ་པ་ལྟ་ཅི་སྨོས།",
    "དེ་ལ་བློས་དམིགས་ནས་བདག་དང་སྐྱེས་བུ་ལ་སོགས་པའི་རྣམ་གྲངས་ཀྱིས་བརྗོད་ཅིང་རང་རྒྱུད་གཏོགས་པ་གང་ཡིན་པ་དེ་ལ།",
    "སེམས་པ་ལ་སོགས་པའི་སེམས་བྱུང་རྣམས་ཀྱང་རང་བཞིན་མེད་པར་བདེ་བླག་ཏུ་ཤེས་ནུས་སོ།",
    "དེས་ན་དོན་བུམ་པ་ལྟ་བུ་མངོན་སུམ་མཐོང་བ་ལས་ཀྱང་རང་བློ་རང་ལ་ལྐོག་ཏུ་མ་གྱུར་པ་འདི་རང་རིག་པའི་བདག་ཉིད་མིན་ན་བློས་ཡུལ་རིག་པའམ་མྱོང་བ་ཐམས་ཅད་མི་སྲིད་པས་རང་རིག་ཆེས་འཐད་དོ།",
    "ཡུལ་ཁྲ་བོས་ཀྱང་རང་འཛིན་མིག་ཤེས་ལ་སྔོ་སེར་སོགས་ཡུལ་ལ་ཇི་སྙེད་ཡོད་པའི་རྣམ་པ་གཏད་ལ་ཤེས་པའང་དེ་སྙེད་ཀྱི་རྣམ་ལྡན་སྐྱེ་བར་འདོད་པ་སྟེ།",
    "ཅིག་ཅར་ཁོ་རང་བརྗོད་ཀྱང་རུང་སྟེ་དོན་དངོས་པོའི་རང་བཞིན་གཅིག་དེ་ལས་མ་འདས་སོ།",
    "ལམ་སྦྱོང་དཀའ་བ་ཀྱིས་གྲོལ་བ་མེད་ཀྱང་རང་བཞིན་ཤི་བ་ན་ཐམས་ཅད་གྲོལ་བ་གཅིག་པའི་དབྱིངས་སུ་གནས་པའི་རྒྱུ་འབྲས་མེད་པའི་ཚུལ་ཤེས་ན་གྲོལ་བའི་ཆེད་ངལ་བ་སོགས་ལ་མི་བརྟེན་པའི་རྒྱང་འཕེན་གྱི་གཞུང་བསྟན་པ་དོན་མེད་མིན་པའི་ཚུལ་ཏེ་དེ་ལྟར་འདོད་དོ།",
    "ཁོ་རང་རང་ལུགས་ཙམ་གྱི་དབར་གོ་རྒྱུ་ཡང་ལེགས་པོ་ཡོད་པ་ཡིན་ནོ།",
    "ཡུལ་ཅན་གྱི་ཤེས་པས་ཀྱང་རང་སྟོབས་ཀྱི་ཡུལ་དེ་ལ་མེད་པའི་དངོས་པོ་དེ་ཤེས་པར་བྱར་ཡོད་པ་མ་ཡིན་ཏེ།",
    "དེའང་རྟའི་རྭ་ཅོ་ལ་ཁོ་རང་སྣང་བའི་ཤེས་པ་བསྐྱེད་པའི་ནུས་པ་མེད་པས།",
    "གཉིས་སྟོང་རང་གསལ་གྱི་རྣམ་པ་ཅན་འདོད་པ་ཁོ་རང་རྣམ་པ་མེད་པ་ཡི་ཚུལ་ཉིད་ཀྱིས་མྱོང་བར་འགྱུར་རིགས་ནའང་།",
    "དེའང་མིག་ཤེས་ལྟ་བུ་ལའང་གཟུགས་ཀྱི་རྣམ་པ་མཐའ་དག་མ་དམིགས་ན་མིག་ཤེས་ཁོ་རང་འདིའོ་ཞེས་གཟུང་བར་མི་ནུས་པ་དེ་བཞིན་རྣམ་པ་མེད་པའི་ཤེས་པ་རྐྱང་པ་ཉམས་སུ་མྱོང་བ་མེད་དེ།",
    "ཞིག་པ་ཁོ་རང་རྒྱུ་ལས་མ་བྱུང་བའི་དངོས་པོར་འགྱུར་བ་སོགས་གནོད་པ་མཐའ་ཡས་པ་དེས་ན་རྒྱུ་ཞིག་ནས་མེད་པའི་ཆ་ལ་ཞིག་པ་ཞེས་བཏགས་པ་ཡིན་གྱི།",
    "རྣམ་པ་སྣ་ཚོགས་སུ་སྣང་ཡང་རང་བཞིན་མེད་པ་ཞིག་ཡིན་ནོ།",
    "དེའང་རང་མིན་པ་བསལ་བའི་ཚུལ་གྱིས་དེའི་ངོ་བོ་ཤེས་པར་བྱ་བ་རྣམ་བཅད་དང་།",
    "ཁོ་རང་ལའང་དེ་གཏན་མེད་ཤེས་པར་བྱ་བ་ཡིན་པའི་ཕྱིར།",
    "འདས་པའི་ས་ནའང་རང་བཞིན་གྱིས་མྱ་ངན་ལས་འདས་པ་སྟེ་ངོ་བོ་མེད་པའི་སླད་འོ།",
    "དེ་སྐད་འང་རང་འགྲེལ་གྱི་མཇུག་རྩོམ།",
    "རྒྱན་དྲུག་རྗེས་འབྲངས་དང་བཅས་པའི་གཞུང་བཟང་པོ་སྔ་འགྱུར་འདི་ཙམ་གདའ་བས།",
    "དེའང་རང་འགྲེལ་ལས།",
    "སླར་ཡང་རང་འགྲེལ་དང་དཀའ་འགྲེལ་གཉིས་ལའང་བལྟ་བར་བྱས་ན་ལེགས་སོ།",
    "དེ་ཁོ་རང་དེ་ལྟར་མིན་ནོ་སྙམ་ན།",
    "བདེན་པ་གཉིས་སུའང་རང་བཞིན་མེད་པའི་ཕྱིར།",
