    "ཁྱོད་ཀྱིས་སྦྱིན་པའི་ཕ་རོལ་དུ་ཕྱིན་པ་བསྒོམས་དང་།",
    "རིགས་ཀྱི་བུ་མོ་དག་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་འདི་ལྟར་སྟོན་ཏེ།",
    "ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་སྒོམས་ཤིག།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྒོམས་ན།",
    "ཀོ་ཤི་ཀ་དེ་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་སྒོམས་ཤིག།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་བསྒོམས་དང་།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་དག།",
    "དེ་ལྟར་སྟོན་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་དག་ནི།",
    "ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་འདས་པ་དང་།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་དག་དེ་ལྟར་སྟོན་ཅིང་།",
    "ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་སྒོམས་ཤིག།",
    "ཀོ་ཤི་ཀ་དེ་ལྟར་སྟོན་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་དག་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པའི་གཟུགས་བརྙན་མི་སྟོན་ཏོ།",
    "རིགས་ཀྱི་བུ་མོ་དེ་དག་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་འདི་ལྟར་སྟོན་ཏེ།",
    "ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་སྒོམས་ཤིག།",
    "རྣམ་པར་ཤེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རིགས་ཀྱི་བུ་མོ་དེ་དག་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པའི་གཟུགས་བརྙན་མི་སྟོན་ཏོ།",
    "ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་སྒོམས་ཤིག།",
    "ཀོ་ཤི་ཀ་དེ་ལྟར་སྟོན་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་དག་ནི་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པའི་གཟུགས་བརྙན་མི་སྟོན་ཏོ།",
    "ཀོ་ཤི་ཀ་གཞན་ཡང་རིགས་ཀྱི་བུ་དང་རིགས་ཀྱི་བུ་མོ་དེ་དག་ཀྱང་།",
    "དེ་ནི་འདི་ལྟར་ཤེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཀོ་ཤི་ཀ་དེ་ལྟར་སྟོན་པའི་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་དེ་དག་ནི།",
    "ཀོ་ཤི་ཀ་དེ་བས་ན་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོས་དེ་ལྟར་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པའི་དོན་བསྟན་པར་བྱ་སྟེ།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་སྔ་མ་དག་གི་ནི་མ་ཡིན་ནོ།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ལ་ལ་ཞིག་གིས།",
    "ཀོ་ཤི་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་འདི་དོན་དང་ལྡན་ཡི་གེ་དང་ལྡན་པར་གཞན་ལ་རྒྱ་ཆེར་བརྗོད་དེ་བསྟན་པ་དང་།",
    "འདི་སྐད་དུ་ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟུང་ཤིག།",
    "ཚུལ་བཞིན་དུ་ཡིད་ལ་གྱིས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཀོ་ཤི་ཀ་ཕྱོགས་བཅུའི་ཕྱོགས་རེ་རེ་ཞིང་།",
    "ཀོ་ཤི་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས།",
    "འདི་སྐད་དུ་ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟུང་ཤིག།",
    "ལན་ཅིག་ཕྱིར་འོང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཀོ་ཤི་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་འདི་དོན་དང་ལྡན་ཡི་གེ་དང་ལྡན་པར་གཞན་ལ་རྒྱ་ཆེར་བརྗོད་དེ་བསྟན་པ་དང་།",
    "འདི་སྐད་དུ་ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟུང་ཤིག།",
    "རིགས་ཀྱི་བུའམ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རིགས་ཀྱི་བུ་མོ་ལ་ལ་ཞིག་གིས།",
    "ཀོ་ཤི་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས།",
    "འདི་སྐད་དུ་ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟུང་ཤིག།",
    "ཀོ་ཤི་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས།",
    "འདི་སྐད་དུ་ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟུང་ཤིག།",
    "རིགས་ཀྱི་བུ་ཁྱོད་གང་གི་ཚེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཇི་ལྟར་བསྟན་པ་ལ་ནན་ཏན་བྱེད་པ་དེའི་ཚེ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སློབ་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་གང་གི་ཚེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སློབ་པར་གྱུར་པ་དེའི་ཚེ།",
    "ཀོ་ཤི་ཀ་ཕྱོགས་བཅུའི་ཕྱོགས་རེ་རེ་ཞིང་།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ལ་ལ་ཞིག་གིས།",
    "ཀོ་ཤི་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས།",
    "འདི་སྐད་དུ་ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་འདི་ཟུང་ཤིག།",
    "རིགས་ཀྱི་བུ་ཁྱོད་གང་གི་ཚེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཇི་ལྟར་བསྟན་པ་ལ་ནན་ཏན་བྱེད་པ་དེའི་ཚེ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སློབ་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་གང་གི་ཚེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སློབ་པར་གྱུར་པ་དེའི་ཚེ།",
    "ཀོ་ཤི་ཀ་གཞན་ཡང་འཛམ་བུའི་གླིང་གི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "ཀོ་ཤི་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས།",
    "འདི་སྐད་དུ་ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟུང་ཤིག།",
    "རིགས་ཀྱི་བུ་ཁྱོད་གང་གི་ཚེ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སློབ་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་གང་གི་ཚེ།",
    "གླིང་ཆེན་པོ་བཞིའི་འཇིག་རྟེན་གྱི་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ལ་ལ་ཞིག་གིས་ཕྱིར་མི་ལྡོག་པའི་ས་ལ་བཀོད་ན།",
    "ཀོ་ཤི་ཀ་དེ་བས་ཀྱང་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་གང་གིས།",
    "འདི་སྐད་དུ་ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟུང་ཤིག།",
    "རིགས་ཀྱི་བུ་ཁྱོད་གང་གི་ཚེ་ཇི་ལྟར་བསྟན་པའི་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་ནན་ཏན་དུ་བྱེད་པ་དེའི་ཚེ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སློབ་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་གང་གི་ཚེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སློབ་པར་གྱུར་པ་དེའི་ཚེ།",
    "དེ་དག་ལ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ལ་ལ་ཞིག་གིས།",
    "འདི་སྐད་དུ་ཚུར་རིགས་ཀྱི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ཟུང་ཤིག།",
    "རིགས་ཀྱི་བུ་ཁྱོད་གང་གི་ཚེ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སློབ་པར་འགྱུར་རོ།",
    "རིགས་ཀྱི་བུ་ཁྱོད་གང་གི་ཚེ་ཤེས་རབ་ཀྱི་ཕ་རོལ་དུ་ཕྱིན་པ་ལ་སློབ་པར་གྱུར་པ་དེའི་ཚེ།",
    "སྟོང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེ་དག་ལ་རིགས་ཀྱི་བུའམ་རིགས་ཀྱི་བུ་མོ་ལ་ལ་ཞིག་གིས།",
