    "ཉན་ཐོས་ལ་སྡོམ་པ་མ་ཐོབ་པར་དགེ་སློང་ཡིན་ནམ་དགེ་ཚུལ་ཡིན་བྱ་བ་ཁས་ལེན་མི་ནུས་པར་འདུག་ཁས་བླངས་ཀྱང་གཞན་ཐམས་ཅད་ཀྱིས་སྲད་མ་ཅན་དུ་བྱེད།",
    "འོན་ཀྱང་རང་སྔགས་པ་ཡིན་པར་བསྒོམ།",
    "གྲོང་དགྲ་མཐར་དབྱར་གནས་པ་ན་ཟས་སྐོམ་མང་པོ་སྦྱོར་ཞིང་སུ་ལ་ཡང་མི་སྟེར་རྒྱལ་པོ་དེ་མཚམས་ལ་འདུག།",
    "སྟན་གྱི་ཐོག་མ་ཁྲི་ཆེན་པོ་ལ་འདུག་པའི་བྲམ་ཟེ་དེས་སྦྱིན་སྲེག་བྱེད་པ།",
    "སོག་དུས་རབས་བཅུ་བཞི་པར་བྱུང་བའི་ཡོན་རྒྱལ་རབས་ཀྱི་རྒྱལ་པོ་ཐའི་ཏིང་ཡེ་སོན་ཐེ་མུར་གྱི་མཚན།",
    "བེ་རོ་ཙ་ནས་བསྒྱུར་བ།",
    "འཁྱགས་ནས་ཀུམ་ཀུམ་དུ་བསྡད་འདུག་ཀུམ་པོ།",
    "ཀེག་དུས་ངེས་ཅན་གྱི་བར་ཆད་ཀྱི་དོན་དུ་གོ་བའི་སྐག་དང་འདྲ།",
    "རྒྱ་ཨ་ཇོ།",
    "ཀྱག་ཀྱག་བྱས་ནས་མགོ་རྙོག་བཟོས་འདུག་ཀྱག་ཀྱོག་ཀྱག་གེ་ཀྱོག་གེའི་བསྡུས་ཚིག་སྔར་རྒྱ་གར་དུ་དར་བའི་གྲངས་གནས་ཆེན་པོ་ཞིག་ཀྱག་གེ་ཀྱོག་གེ།",
    "ཤིང་ཀྱག་ཀྱོག་མ་གཏོགས་དྲང་པོ་མི་འདུག་ལས་དོན་ཀྱག་ཀྱོག་ཁོ་ན་བྱེད།",
    "ས་གཞི་ཀྱང་ཀྱོང་ལ་འགྲོ་འདུག་མི་བདེ།",
    "ས་ཆ་ཀྱོང་ཀྱོང་ནང་དུ་ཆུ་འཁྱིལ་འདུག་ཀྱོང་ཁ།",
    "ལུད་མ་བརྒྱབ་པས་ཚལ་རིགས་ཚང་མ་ཀྲང་ལ་རྒྱུགས་འདུག་ཀྲད།",
    "མཐེ་བོང་ལ་བ་སོའི་ཀྲད་ཀོར་ཞིག་གྱོན་འདུག་ཀྲད་འཁོར།",
    "འོད་ཀྲིག་ཀྲིག་ཅིག་འདུག་གཟུང་བྱ་ནན་ཏན་དུ་འཛིན་སྟངས།",
    "ཙ་ནས་ཉ་བར་གྱི་ཀླད་ཀོར་ལ་ཉ་སྒྲ།",
    "སློབ་དཔོན་ཤྲཱི་སེངྷ་དང་ལོ་ཆེན་བེ་རོ་ཙ་ན་ལས་བརྒྱུད་ཅིང་།",
    "རི་བོ་དཀན་གཟར་འཛེག་དུས་དབུགས་ཀྱང་སྔངས།",
    "དཀའ་ངལ་ཐུག་དུས་ཕྱིར་ཤིག་རྒྱག་མི་ཉན།",
    "ལས་དོན་དཀའ་ཚད་ཇི་འདྲ་འདུག་དཀའ་ཚེགས།",
    "དཀར་མདངས་འཕྲོ་ཚུལ་ཞིག་གོས་གསར་དཀར་ཆབ་ཆབ་ཅིག་གྱོན་འདུག་དཀར་ཆལ།",
    "ས་གཞི་ཀུན་སྨུག་པས་དཀར་འབྱམས་སུ་ཁྱབ་འདུག་དཀར་མི།",
    "གྲངས་གནས་ཤིག་སྣམ་བུ་འདིའི་བཀད་རིས་མཛེས་པོ་འདུག་བཀད་ས།",
    "འདུག་གྲལ་དང་འཚོག་ས་སྟེ་འཛོམས་ས།",
    "རྩ་བ་དང་རང་བཞིན་ནམ་སྤུས་ཀ།",
    "བྱེ་མའི་ནང་དུ་མིའི་རྐང་རྗེས་འདུག་གངས་ཀྱི་སྟེང་དུ་རྐང་རྗེས་ལུས།",
    "ཁོ་རང་རྐང་པ་ཡང་པོ་ཡིན་པས་དེ་རིང་ཚུར་འཁོར་ཐུབ།",
    "ཕྲུ་གུ་དེ་ལྐུགས་འདུག་ལྐུགས་སེ།",
    "ཁོའི་སྐད་གཉའ་ཆག་འདུག་སྐད་གཉིས་པ།",
    "ཕན་ཚུན་སྐད་བརྡ་འཕྲོད་ཀྱི་མི་འདུག་སྐད་པ།",
    "ཁྱེད་ཀྱི་གཟུགས་པོ་སྐམ་ཀྲོག་གེ་བར་ལུས་འདུག་སེམས་རྒྱུད་གྱོང་པོ་སྐམ་གྲོག་གེར་ལུས།",
    "ཚེར་མ་ཟུག་དུས་ཀྱི་རྡོག་པ།",
    "ཁོང་སྐུ་རྐྱང་བཞུགས་འདུག་སྐུ་སྐལ།",
    "ཡབ་ཆེན་ཁྱེད་ལ་སྐུ་གྲིབ་ཕོག་འདུག་སྐུ་གྲིམས་པ།",
    "དགུང་ལོ་མཐོན་པོ་ཡིན་ཡང་སྐུ་ལུས་ཐང་པོ་འདུག་སྐུ་ཤ།",
    "བརྐྱང་བསྐུམ་བདེ་པོ་འདུག་སྦ་བ།",
    "གསུང་སྐད་གསང་ཞིང་སྐུའི་རྣམ་འགྱུར་སྤམ་པོ་ཞིག་འདུག་སྐུའི་ཕྱལ།",
    "སྐེ་འཆུས་འདུག་སྐེ་འཚིར་བཏང་ནས་བསད།",
    "སྒོ་ཁྱི་ལ་སྐེ་ཐག་བརྒྱབ་ནས་བཏགས་འདུག་སྐེ་ཐིག་ཁྱི་དང་ཕྱུགས་སོགས་ཀྱི་སྐེ་ལ་མཛེས་རྒྱུན་དུ་འདོགས་རྒྱུ་ཞིག་སྐེ་འདོགས།",
    "སྐེག་དུས་ངེས་ཅན་གྱི་བར་ཆད་ཀྱི་དོན་དུ་གོ་བའི་སྐག་དང་འདྲ།",
    "རི་སྐེད་ལ་ལམ་ཕྲན་ཞིག་འདུག་སྐེད་པ་རྒྱག་པ།",
    "ཆུ་སྐོལ་གྱིན་འདུག་ཇ་སྐོལ་འབྲས་འཚོད།",
    "གྲོད་མར་གྱི་བཅད་ཁ་སྐྱ་ཁྲིག་གེར་བསྡད་འདུག་ཁང་པའི་སྒོ་གསར་པ་སྐྱ་ཁྲིག་གེ་བར་འདུག་སྐྱ་ཁྲོམ་ཁྲོམ།",
    "དཀར་པོས་གང་ཚུལ་ཞིག་དཀར་ཡོལ་འོ་མས་སྐྱ་ལྟེམ་མེར་གང་འདུག་སྐྱ་ཐ་ལ་ལ།",
    "དབུ་སྐྲ་སྐྱ་ཕྱེད་སྔོ་ཕྱེད་དུ་གྱུར་འདུག་སྨ་ར་སྐྱ་ཕྱེད་སྔོ་ཕྱེད།",
    "འབྲོག་པ་ཞིག་བསྐྱས་པའི་ཤུལ་ན་ཁྱི་གུ་གསུམ་ལུས་ནས་འདུག་རྙིངསྐྱེལ་བ།",
    "གྱོན་པ་སྐྱ་ལོག་སྔོ་ལོག་ཅིག་གྱོན་འདུག་སྐྱ་ལོག་པ།",
    "དབྱར་གོས་སྐྱ་སང་ངེ་བ་ཞིག་གྱོན་འདུག་སྐྱ་སང་སང་།",
    "འབྲོག་དུད་ཚང་མ་སྐྱས་བཏེག་པས་ས་ཕྱོགས་དེ་དག་མི་མེད་ལུང་སྟོང་དུ་ལུས་འདུག་སྐྱི་དཀར།",
    "གཟིམས་སྒོ་བསྐྱོན་འདུག་སྐྱོན་སྤངས་དགེ་སྒྲུབ།",
    "མ་དག་པའི་སྐྱོན་སླད་ཞུགས་འདུག་སྐྱོབ།",
    "རྐང་པ་སྐྲངས་འདུག་གདོང་ཡང་སྐྲངས་འདུག་རྨ་ཁ་སྐྲང་དོགས་འདུག་སྐྲངས་པ།",
    "ཡུལ་དུས་རང་བཞིན་གང་རུང་རང་དང་བསྐལ་པ་སྟེ་བར་དུ་ཆོད་པའམ་རྒྱང་རིང་བའི་རྐྱེན་གྱིས་མཐོང་མི་ནུས་པའོ།",
    "ཕྱི་སྣོད་ཀྱི་འཇིག་རྟེན་ཚང་མ་བསྐལ་པ་མཐར་འཇིག་དུས་ཀྱི་མེ།",
    "ད་ནང་ང་ལ་ཁ་ཁུ་མེད་པར་ཁོ་རང་ཕྱིན་འདུག་ཕྱིར་ནམ་ཡོང་ཡང་ཁ་ཁུ་མི་འདུག་ཁ་ཁུ་སིམ་པོ།",
    "ཁོ་མ་དགའ་ནས་ཁ་འཁྱགས་ངོ་འཁྱགས་ཀྱི་རྣམ་པ་བསྟན་འདུག་ཁ་འཁྱེར།",
