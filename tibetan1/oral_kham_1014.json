    "འདིའི་ཕྱོགས་ནས་ཁྱེད་ཀྱིས་ནོར་འཁྲུལ་ཆེན་པོ་ཞིག་བཟོས་འདུགཉེ་ལམ།",
    "སྐད་ཆའི་ནང་དུ་སྐྱོན་བརྗོད་དང་འཁང་ར་ཡིས་ཁེངས་འདུག་ཐ་ན་སློབ་གཙོ་ཡང་ཁོའི་སྐྱོན་བརྗོད་བྱ་ཡུལ་གྱི་ཁྱབ་ཁོངས་ལས་ཐར་ཐུབ་ཀྱི་མི་འདུག་ཁོས་དོན་དངོས་རབ་དང་རིམ་པ་དང་།",
    "དམའ་འབེབས་ཀྱིས་ཁེངས་འདུག་པ་མཐོང་ཐུབ།",
    "ཞི་ལྷོད་ཀྱི་རྣམ་འགྱུར་གྱིས་རང་ཉིད་ཀྱི་སྦྱིན་བདག་ལ་ཁོ་མི་ཨུ་ཚུགས་ཅན་ཞིག་ཡིན་པ་དང་ཁོའི་དོ་དམ་གྱི་ཕྱོགས་ལ་སྐྱོན་ཆ་འདུག་ཟེར་བ་ལས།",
    "ཟླ་ཕོགས་ཀྱང་རང་བཞིན་གྱིས་མཐོ་མི་སྲིད།",
    "རྨས་སྐྱོན་ཆེས་ཟབ་པའི་མི་དེའང་གཞན་པ་མ་ཡིན་པར་ཁོ་རང་ཉིད་ཡིན་ནོ།",
    "དངོས་ཡོད་ཀྱི་འཚོ་བ་ལས་རང་ཉིད་ཀྱི་གོ་ས་ཞིག་རྙེད་ཐུབ་ཅིང་རང་ཉིད་ཀྱི་རིན་ཐང་ཡང་རྟོགས་སྲིད།",
    "ནུས་པ་གང་ཡོད་དང་རང་འགན་གཙང་སྒྲུབ་ཀྱིས་ལེགས་འགྲུབ་ཡོང་བར་བྱ་དགོས།",
    "མི་རྣམས་ཀྱིས་དུས་རྟག་ཏུ་ནུས་ཤུགས་འབྲིང་ཙམ་ལས་མེད་ནའང་རང་འགན་གཙང་སྒྲུབ་བྱེད་མཁན་གྱི་མི་དེར་བརྩི་བཀུར་བྱེད་པ་ལས།",
    "གཞན་གྱིས་རང་ལ་བརྩི་བཀུར་བྱས་ན་རང་བརྩིའི་བསམ་པ་དང་རང་ལ་ཡིད་ཆེས་པའི་བསམ་པ་ཇེ་ཆེར་འགྲོ་བ་ཡིན།",
    "བློ་གཅིག་སེམས་གཅིག་དང་རང་འགན་གཙང་སྒྲུབ་བྱ་དགོས།",
    "ལས་ཀ་གང་དང་གང་ཞིག་ལ་གདོང་གཏད་ཀྱང་བློ་གཅིག་སེམས་གཅིག་དང་རང་འགན་གཙང་སྒྲུབ་བྱས་ན་ད་གཟོད་ལེགས་འགྲུབ་ཡོང་སྲིད་ལ།",
    "ལས་དོན་ཇི་འདྲའི་ཕལ་བ་ཞིག་སྒྲུབ་ཀྱིན་ཡོད་ནའང་རང་ཉིད་ཀྱི་གཟི་བརྗིད་མངོན་ཐུབ་བོ།",
    "རང་ལ་དོ་སྣང་བྱེད་མཁན་མི་འདུག་མ་འདོད།",
    "སླེ་བོ་སོགས་འདུགའགྲུལ་བ་འདིས་ཉིན་འགའི་རྗེས་སུ་གཉེན་སྟོན་བྱ་རྒྱུ་ཡིན་ལ།",
    "བོང་བུས་དྲུད་ན་ཅུང་ཟད་ཁག་པོ་འདུག་ཚོང་ཟོག་སྐྱེལ་རྒྱུ་དེ་ངའི་འགན་འཁྲི་མ་ཡིན་པར།",
    "འུ་ཚོས་ཚེ་གང་བོར་འདི་ལྟ་བུའི་ལས་གནས་སུ་བྱ་བ་གཉེར་ནས་འདུག་གམ།",
    "ད་སྐབས་ལས་བཟོ་བ་རྣམས་ཤིན་ཏུ་གཡོ་སྒྱུ་ཆེ་བ་དང་རང་འགུལ་རང་བཞིན་ཡང་མེད་པར་འདོད།",
    "ལུས་སེམས་ཡོངས་རྫོགས་སྤྱི་གཉེར་ཁང་ལ་འབུལ་ཞིང་རང་འགན་གཙང་སྒྲུབ་བྱས་ནས།",
    "སྤྱི་གཉེར་ཁང་རང་ཉིད་ཀྱི་ལས་ཀར་བལྟས་ནས།",
    "ཤེས་མེད་ཚོར་མེད་ངང་རང་ཉིད་ལ་དེ་འདྲའི་གོམས་གཤིས་ཤིག་ཆགས་འདུག་པ་ཚོར་ཡོང་།",
    "རང་སྐྱོན་རང་བརྟག་དང་རང་ཉིད་ཀྱི་སེམས་པར་མཐོང་ཆེན་བྱེད་པའི་སྤོབས་སེམས་ཡོད་དགོས།",
    "ཞེས་ནན་སྐུལ་བྱེད་ཀྱིན་འདུགངས་ཕྱོགས་གཅིག་ནས་ལམ་ལ་ཆས་རྒྱུར་གྲ་སྒྲིག་བྱས་ཤིང་།",
    "དོན་དག་དེ་འདྲ་མང་བོ་ཞིག་ལ་བསམ་བློ་གཏོང་ཁོམ་མི་འདུག་དེའི་ཕྱིར།",
    "ངས་ཡང་དང་བསྐྱར་དུ་ཁོར་ངའི་སྐད་ཆར་ཉན་དུ་བཅུག་ནའང་ཕན་འབྲས་མི་འདུག་དེ་བས།",
    "མཐར་རི་བོང་ཅལ་འདྲོགས་ཙམ་ཞིག་ཡིན་འདུག་ལོ་ན་བགྲེས་པའི་མི་ནག་ཅིག་རྐང་བ་འཐེང་ཞོར་དུ་ཤིང་རྟ་འཁོར་ལོའི་རྩར་ཐོན་ཏེ་སྒོ་ཕྱེ་ཞིང་།",
    "ཁང་མིག་ཏུ་གསལ་ལ་མི་གསལ་བའི་འོད་སྣང་ཞིག་འཚེར་གྱིན་འདུག་ཕུན་སུམ་ཚོགས་པའི་ནུབ་ཟས་ཀྱིས་ངེད་གཉིས་ལ་བསྒུགས་ནས་བསྡད་ཡོད།",
    "ཡ་ང་བའི་ཉ་དེ་དག་དེ་རིང་ཉ་རྒྱ་རུ་ཚུད་ཀྱིན་མི་འདུག་ཅེས་ལན་བཏབ།",
    "ང་ལ་མཛེས་ལྗོངས་དེར་རྒྱང་ལྟ་བྱས་ནས་འདུག་ཁོམ་མེད།",
    "དགྲ་བོར་གཡོལ་ཐབས་ཀྱིས་ནུས་ཤུགས་ཉར་ནས་འདུག་དགོས།",
    "གྲུ་བ་ཚོ་མཚོ་ཁར་ཅ་དངོས་རྣམས་སྤོ་བར་བྲེལ་གྱིན་འདུག་ལ་ང་ལྷིང་འཇགས་ངང་གནས་དེར་ངལ་དུབ་ཀྱི་ཉམས་འགྱུར་གྱིས་འགྲེང་ནས་བསྡད་ཡོད་པས།",
    "ཁོ་ཚོའི་ལུས་ཐོག་ཏུ་དམག་མི་བྱས་མྱོང་པའི་རྟགས་མཚོན་འདུག་ལ།",
    "གནས་འདིར་ཡུན་རིང་འདུག་མི་རུང་ལ།",
    "སི་ཕེན་གྱི་དམག་དཔུང་ལ་ཨ་རིའི་མི་ཁུ་པ་བརྒལ་ནས་སྤྱི་ཆེའི་དམག་དཔོན་གྷར་སེ་ཡཱའི་དམག་སྒར་དུ་སྐྱོད་ཀྱིན་འདུག་ཅེས་སྙན་སེང་མི་ཞུ་བར་བདེན་དཔང་བྱེད་མི་ཐུབ།",
    "དོན་དངོས་སུ་ངའི་བསམ་ཚུལ་དེ་འགྲིག་འདུག་པ་བདེན་དཔང་བྱས།",
    "ང་ཐོན་པ་དེས་བགྲེས་པོ་དང་བྱིས་པ་ཚོར་དགའ་སྤྲོ་ཆེན་པོ་སྐྱེས་སུ་བཅུག་འདུགཡཱ་རཱ་སྒར་ཁར་གཙང་པོ་ཞིག་རི་རྩ་བརྒྱུད་ནས་གནས་འདིར་བཞུར་གྱིན་འདུག་ལ།",
    "ང་ཐོན་པའི་བརྡ་འཕྲིན་དེ་གནས་འདིའི་ཟུར་སོ་སོར་ཁྱབ་འདུགགཟབ་རྒྱས་ལྡན་པའི་ཁ་ལག་དེ་ཟོས་ཚར་རྗེས།",
    "སི་ཕེན་གྱི་དམག་མིས་ད་དུང་གནས་གང་སར་ཉེན་ཟོན་སྐོར་ཞིབ་བྱེད་ཀྱིན་འདུག་ཁོ་ཚོས་མཚོ་འགྲམ་དང་མཚོ་ཁུག་ཐ་ན་གྲུ་གཅིག་ཀྱང་མི་གཏོང་བར་ཉེན་ཟོན་སྐོར་ཞིབ་བྱེད་ཀྱིན་འདུག་ཁོ་ཚོས་དུས་ངེས་མེད་དུ་ང་གསང་མྱུལ་བ་རུ་ངོས་འཛིན་སྲིད་ལ།",
    "གཅིག་གྱུར་གྱི་ནུས་ཤུགས་བཅས་ཚད་གང་འདྲ་ཞིག་དང་གནས་སྟངས་ཅི་འདྲ་ཞིག་ལ་སླེབས་འདུག་གམ།",
    "ངས་མཐོང་བསྡད་ཀྱི་འདུག་དེ་ལྟར་ཡོང་དོན་ནི།",
    "རང་དོན་ཆ་ཚང་བློས་གཏོང་མ་ཐུབ་རུང་རང་དོན་དང་གཞུང་དོན་གཉིས་གདམ་ཁ་བརྒྱབ་དགོས་པའི་དུས་ཚོད་ཅིག་དང་འཕྲད་སྐབས།",
    "དེ་ལ་བྱེད་རྒྱུ་ཞིག་མི་འདུག་དེ་ནས་བཟུང་ང་ཁ་རོག་ལ་བསྡད་པ་ཡིན།",
