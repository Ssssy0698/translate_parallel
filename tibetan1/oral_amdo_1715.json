    "གཉེན་པོའི་རིགས་ཀྱི་མིང་གིས་སྤང་བྱ་ལ་བཏགས་པ་སྟེ།",
    "བསྡུ་ཕྱིར་རང་གི་འཁོར་ལོ་ལ།",
    "དེ་ཡང་རེ་ཞིག་ངེས་འགྲུབ་འགྱུར།",
    "གང་གི་དམ་པའི་བདེ་བས་ཁྱོད།",
    "བདག་མེད་མ་ལ་སྔོན་དུ་བསྙེན་པ་སོང་བས།",
    "དམན་པ་ལ་མོས་པ་རྣམས་རྗེས་སུ་གཟུང་བའི་ཕྱིར་ལས་ཀྱི་ཚོགས་རབ་འབྱམས་དང་འབྲེལ་ལོ།",
    "དུས་ཀྱི་བསྙེན་པ་ཟླ་བ་དྲུག་མཚན་མའི་བསྙེན་པ་ནམ་མཚན་མ་ཐོབ་ཐོབ་ཏུ་བསྐྱལ་བ་ཅིག་གིས།",
    "བདག་གི་མིག་འབྲས་རྣམ་པ་གཉིས་ཧཱུྃ་ལས་བྱིན་གྱིས་བརླབས་ཏེ།",
    "ཞེས་པ་ནི་བདག་གི་གཡོན་ངོས་སུ་དགུག་པར་བྱ་རྒྱུ་དེ་བསམས་ལ།",
    "སྟེང་དུ་བཟློག་པ་ལས་སྟེང་དུ་གཟུགས་བརྙན་གཉིས་མིག་གི་ནང་དུ་འཆར་བའོ།",
    "སྣ་ཡི་རྩེ་མོའི་དབུས་སུ་གཉིས།",
    "སྔོན་དུ་བསྙེན་པ་ཟླ་བ་དྲུག་སོང་ན་ངེས་པར་འགྲུབ་ཅེས་པའོ།",
    "བདག་ལ་བསྒྲལ་བའི་ནུས་པ་ཡོད་པ་ཅིག་གིས་སྦྱོར་བའི་ཐབས་ལ་མཁས་པས།",
    "ཞེས་པ་དེ་ལྟར་བདག་ལ་སྒྲོལ་བའི་ནུས་པ་ཡོད་པ་ཅིག་གིས།",
    "ནང་གི་དོན་དུ་བྱ་བ་མ་ཡིན་པ་དེའི་དོན་དུ་འགྱུར་བས་ན་དེ་བསྒྲལ་བར་མི་བྱའོ།",
    "ཧེ་རུ་ཀ་བཞིའམ་བདག་མེད་མ་ལ་སྔོན་དུ་བསྙེན་པ་སོང་བ་ཅིག་གིས།",
    "ཧྲཱི་ལས་བྱུང་བའི་ལྷ་མོ་ནི།",
    "ཞེས་པ་ཧེ་རུ་ཀ་བཞི་ལ་བསྙེན་པ་སྔོན་དུ་སོང་བས་སྒྲོལ་མ་ཡན་ལག་བཞི་རྫོགས་སུ་བསྐྱེད་དེ།",
    "དྲྭ་བ་ནི་པཉྫར་སྟེ་བུད་མེད་དམ་སྒྱུ་མའི་རྣམ་གྲངས་སོ།",
    "དེ་ལ་ཚིག་གི་དོན་ནི་ཞུས་པའི་སྐབས་ན།",
    "ལྷ་བཟོའམ་རི་མོ་མཁན་གྱིས་བྱ་བ་ཐམས་ཅད་རྫོགས་པའོ།",
    "ཞེས་པ་ནི་རབ་གནས་ཀྱི་སྔོན་དུ་སྦྱིན་སྲེག་གིས་ས་སྦྱང་བའོ།",
    "པུ་སྟི་ལ་སོགས་པ་ནི་གསུང་གི་རིགས་འོད་དཔག་ཏུ་མེད་པར་བསྐྱེད་དོ།",
    "རང་གི་ལྷ་གང་ཡིན་དེ་སྲུང་མའི་ཚུལ་དུ་བསྐོས་ལ་བཞག་གསུངས་སོ།",
    "སྦྱིན་སྲེག་གི་དོན་ནི་ཡི་གེ་ལོགས་སུ་བཀོད་པས་འདིར་མ་བྲིས་སོ།",
    "ལྷག་མ་ནི་བསྐྲད་པ་དང་རེངས་པར་བྱ་བ་ལ་སོགས་པ་ཡང་ཐབས་དེ་ཉིད་ཀྱིས་འགྲུབ་སྟེ།",
    "ལྷ་གང་གིས་རྣལ་འབྱོར་གྱིས་གྲོལ་བ།",
    "མཆོག་གི་དངོས་གྲུབ་ཇི་ལྟར་འགྲུབ་པར་འགྱུར།",
    "ཞལ་བརྒྱད་ཕྱག་བཅུ་དྲུག་པ་མིན་པའི་ཕྱག་གཉིས་པ་ལ་སོགས་པའི་ཐབས་ཀྱི་རྣལ་འབྱོར་གཞན་གྱིས་མཆོག་གི་དངོས་གྲུབ་མི་རྟོགས་ཏེ།",
    "ཐ་མལ་གྱི་སེམས་ཀྱིས་སྐད་ཅིག་ཀྱང་མཆོག་གི་དངོས་གྲུབ་འདོད་པས་མི་གནས་ཞེས་བྱའོ།",
    "འོ་ན་ལྷ་གཞན་གྱི་རྣལ་འབྱོར་གྱིས་མཆོག་གི་དངོས་གྲུབ་མི་འཐོབ་ཀྱི་ཞལ་བརྒྱད་ཕྱག་བཅུ་དྲུག་པ་ཡབ་ཡུམ་ཁོ་ནས་ཐོབ་པ་རང་ཅིས་སྙམ་པ་ལ།",
    "གཞན་དག་གིས་མི་འཐོབ་སྟེ།",
    "ལྷ་གཞན་གྱི་རྣལ་འབྱོར་གྱིས་མཆོག་གི་དངོས་གྲུབ་མི་འཐོབ་ཅེས་བྱའོ།",
    "གནས་ནི་བཟང་པོ་ཞེས་པ་གནས་གང་དུ་གནས་ན་གདོན་དང་མི་མ་ཡིན་པའི་གནོད་པས་མི་ཚུགས་ཤིང་སྲོག་གི་བར་ཆད་དུ་མི་འགྱུར་བ་དང་།",
    "བརྟན་པ་མ་ཐོབ་པས་ནི་མཚན་མོ་རྣམ་རྟོག་ཤས་ཆུང་བས་བསྒོམས་ལ།",
    "ཞེས་པ་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་འདོད་པའི་བསམ་པས་སོ།",
    "གཞན་ཐ་མལ་གྱི་རྣམ་རྟོག་གིས་སོ།",
    "གདུག་པ་སྟེ་ཞེ་སྡང་གི་སེམས་ཀྱིས་དངོས་གྲུབ་འདོད་པས་དངོས་གྲུབ་ཀྱི་ཕྱིར་རམ།",
    "དྲོད་ཐོབ་པའི་དུས་དང་ཐབས་གང་གིས་དྲོད་ཐོབ་པར་བྱེད་པ་གསལ་བར་མ་གསུངས་པས།",
    "བསམ་གཏན་ཉོན་མོངས་འཇིག་བྱེད་པ།",
    "ཀུན་ནས་ཉོན་མོངས་པ་རྣམ་པ་གསུམ་སྤོང་ཞིང་འཇིག་པར་བྱེད་པའམ།",
    "བསམ་གཏན་ཉོན་མོངས་འཇིག་བྱེད་དོ།",
    "མཐར་དུས་ཇི་སྲིད་ཅིག་གིས་གྲོལ་བར་འགྱུར་བ་དང་།",
    "ཡང་ན་ཐབས་ལ་བཟའ་བསྲུང་གི་དམ་ཚིག་ཇི་སྙེད་ཡོད་པ་དེ།",
    "ཟླ་བ་གཅིག་གིས་སྐལ་ལྡན་པར།",
    "འདི་ནི་ཀུན་བཟང་གི་སྤྱོད་པའི་དུས་སོ།",
    "སྙོམས་འཇུག་གི་མཐའ་ནི་ཞག་རྣམ་པ་ལྔ་ཡིན་ཞིང་།",
    "དུས་ཀྱི་མཐའ་ནི་སྐྱ་རེངས་འཆར་ཀ་སྟེ།",
    "ཉི་མ་གཅིག་གི་སྦྱོར་བ་དང་།",
    "སྐྱ་རེངས་འཆར་ཀའི་དུས་སུ་ནི།",
    "དེ་ལྟར་ལུང་བསྟན་པའི་བུ་མོ་མ་རྙེད་ན།",
    "མཆོག་ཐོབ་པ་ཡི་བུད་མེད་གང་།",
    "ཡང་ན་བདག་གི་ནུས་པའི་མཐུས་ལྷ་དང་སྟེ།",
    "ལྷ་མིན་གྱི་བུ་མོ་ལེགས་སྨིན་དང་།",
    "མི་རྣམས་ཏེ་མིའི་བུ་མོ་རྒྱུད་ཡོངས་སུ་སྦྱངས་པ་མཐུས་བཀུག་ལ་སྤྱོད་པ་བྱ་བར་འབྲེལ་ལོ།",
    "བདག་གི་དལ་བ་མངོན་དུའི་ཕྱིར།",
    "དལ་བ་ནི་རང་གི་སེམས་བརྟན་གཡོ་བརྟག་པའི་ཕྱིར་རོ།",
    "ཕྱག་རྒྱ་ཕྱག་རྒྱ་གཉིས་དག་གིས།",
    "རྟེན་བུད་མེད་ཀྱིས་བདག་མེད་མའི་དཀྱིལ་འཁོར་དུ་རིམ་པ་གཉིས་ཀྱིས་དྲོད་ཐོབ་པ་གཅིག་གིས་སྤྱོད་པ་བྱེད་པ་ན།",
    "གྲོགས་གང་དང་སྤྱོད་པ་བྱེད་དེ་བུད་མེད་ནང་ན་ཕྱག་རྒྱ་མ་བསྟེན་པ་ནི་མི་འཐད་ལ།",
    "ལན་བུད་མེད་དང་རྟོགས་པ་མཉམ་པའི་ཐབས་སྒྲུབ་པ་པོ་དང་ཕྲད་ན་ནི་རྒྱུད་གཉིས་དུས་གཅིག་ཏུ་གྲོལ་བར་ཡང་རུང་ལ།",
    "དེ་ལྟ་བུའི་ཐབས་སྒྲུབ་པ་པོ་མ་རྙེད་ན་དྲོད་ཐོབ་པ་དེས་རང་གི་ལུས་སྐད་ཅིག་གིས་སྐྱེས་པར་བསྒྱུར་ནུས་པས་ན།",
