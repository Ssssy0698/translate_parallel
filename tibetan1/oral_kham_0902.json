    "ཧོ་ཆེན་སོགས་སུ་དབོར་འདྲེན་བྱེད་ཀྱི་འདུག་པས་ངས་དེའི་སྐོར་གོང་ལ་སྙན་སེང་ཞུས་པ་ཡིན།",
    "ང་ལ་དེ་སྔ་མཚོ་བོད་ལམ་བར་ཁོ་རང་ལ་རྨི་ལམ་རྨིས་ཚུལ་བརྗོད་པར།",
    "དུས་བབས་ནི་མི་རྣམས་བློ་ཕོམ་ཡིད་ཆད་སྐྱེ་བ་ཞིག་འདུག་ཅེས་པའི་ཚིག་དོན་འཁོད་འདུག་དམག་དོན་སྡོམ་རྩིས་ཅུས་ཀྱི་ལྷ་སར་བཅའ་སྡོད་འགོ་པ་ཤའོ་ཙུང་ཆིང་སྤྱང་རིག་འཇོན་ཐང་ཆེ་ལ་ཞེ་གནག་སྦྱོར་རྩུབ་ཡིན་པ་ནི་གཤམ་གསལ་གྱི་དོན་ད་ངོས་ལས་ར་འཕྲོད་ཐུབ་པ་སྟེ།",
    "གོང་རིམ་གྱིས་ཤའོ་ལ་དེ་དོན་བཀག་འདོམས་བྱེད་དགོས་པའི་མཛུབ་སྟོན་ཡོད་མེད་ཆ་མི་འཚལ་ཡང་བོད་མེ་ཕག་ལོའི་དགའ་ལྡན་ལྔ་མཆོད་ཉིན་ཟླ་བཅུ་པའི་ཚེས་ཉེར་ལྔ་བློ་བཟང་དོན་ཡོད་ཉིད་ཅང་ཤིན་ཤིས་ཀྱི་ཁྱིམ་དུ་མགྲོན་པོར་བསྐྱོད་ནས་མཚན་གུང་རང་གནས་སུ་ལོག་པའི་སྐབས།",
    "ཧའུ་ཡིས་རྭ་སྒྲེང་ལ་སྲིད་སྐྱོང་རང་འཇགས་གནང་དགོས།",
    "དེ་གར་ངའི་གཉེར་པ་ནས་གྱོན་པ་འབོག་སྒྲིལ་འཁྱེར་ནས་ང་སྒུག་བསྡད་འདུག་གཉེར་པས་ང་མཐོང་བ་དང་ཨ་རྩི་མགྱོགས་པོ་ན་བཟའ་བཞེས་དང་།",
    "ང་ག་ཉིས་ལམ་སེང་ཤར་ཆེན་ལྕོག་ཏུ་མར་ཕྱིན་པར་ཞིབ་པ་ལགས་སྡོད་སའི་འོག་དེར་སྒེའུ་ཁུང་ཉིས་ཧྲལ་ཆུང་དུ་ཡོད་པའི་ཁང་པ་ཞིག་འདུག་པ་དེར་གད་འཕྱིས་ཚར་བསྟུན་རྩེ་ཕྱག་ནས་འབོལ་གདན་གདན་ཁྲི་རང་འགྲིགས་ཆ་གཅིག་དང་།",
    "བླ་བྲང་རང་འཇགས་གནས་པ་ཡོང་བའི་རོགས་རམ་ཡོད་པ་ཞེས་གཙོ་བོའི་ཚིག་ཏུ་གསལ་ཞིང་།",
    "ང་གཉིས་ནས་བཞུ་མར་སྤར་ཏེ་ཡར་ལངས་ནས་གང་འདུག་ཞུས་པར་སྤྲེའུ་ཐང་ཞུ་གྱོན་པ་འཇིགས་རུང་ཞིག་སྒེའུ་ཁུང་ནས་ཡར་འཛུལ་ཏེ་སླེབས་བྱུང་།",
    "གང་ཡང་མི་འདུག་ཞེད་སྣང་མ་མཛད་ཞུས་པ་ཡིན།",
    "ཁོང་ཆུང་དུས་མཚན་དེ་རང་འབོད་ཀྱི་འདུག་ཁོང་བྱིས་པའི་དུས་སུ་སྤྱང་གྲུང་འཛོམས་ཤིང་ཕ་མར་བརྩི་བཀུར་ཆེ་བ།",
    "ཁྱེད་རང་ནས་བཀའ་ཤག་ལ་བདེ་སྡུག་དང་།",
    "ང་རང་སྒེར་གྱི་འབྲུ་ཁལ་དྲུག་བརྒྱ་ཡང་སྤྲད་ཡོད།",
    "བཟོ་ལས་སོགས་ཕྱོགས་གང་ཅིར་དཔྱིད་ཀྱི་དཔལ་ཡོན་བཞད་པ་ལྟ་བུ་བྱུང་འདུག་པས་རང་ཉིད་ལ་སྐུལ་འདེད་ཆེན་པོ་བྱུང་།",
    "ང་རང་ལོ་ན་དྲུག་ཅུ་ལྷག་ཙམ་ལ་སླེབས་པའི་རྒས་ཁོག་ཞིག་ཆབ་སྲིད་ཐོག་བློ་བདེ་བག་ཕེབས་དང་།",
    "དེ་མིན་གྱི་མི་ཁག་གཅིག་ད་དུང་རྒྱ་གར་གྱི་ཀ་ལི་ཀ་ཏ་དང་ཀ་ལོན་སྦུག་གཞན་ཡང་རང་རྒྱལ་གྱི་ཕག་རི་སོགས་ས་གནས་སུ་དངོས་ཟོག་བརྒྱུད་འདྲེན་གྱི་ཞིབ་ཕྲའི་ལས་དོན་གྱི་འགན་ཁུར་ནས་སྡོད་ཀྱི་ཡོད།",
    "གཉིས་ནས་ཇ་ཆུ་འོག་ཏུ་ཟམ་པ་དང་ལམ་བཟོས་འདུག་དེ་དུས་ཐུའུ་པིང་དེ་ཚོའི་ཆས་གོས་དབྱིན་ཇིའི་དམག་ཆས་ཡིན་པ་དང་།",
    "ང་རང་བཅས་མི་གསུམ་ཡོད་ཅིང་།",
    "ལོག་སྤྱོད་ཤོག་ཁས་ཆེད་དུ་བཟོས་པའི་རྒྱ་བོད་མི་རིགས་བར་གྱི་འགལ་ཆའི་བསམ་བློར་ཐོག་མའི་འགྱུར་ལྡོག་ཡོང་རྒྱུར་ཕན་འབྲས་ཧ་ཅང་ཆེན་པོ་ཞིག་བྱུང་བ་ཚོར་གྱིན་འདུག་རྙོག་འཛིངས་ཀྱི་འཐབ་རྩོད་སྣ་ཚོགས།",
    "ཀློན་ཡོན་མི་གཉིས་སུ་ཡིན་དྲན་གྱི་མི་འདུག་ཁོང་གཉིས་གཞུང་ལམ་ཅུས་ཀྱི་གུང་ཁྲེང་ཧྲི་ཡིན་པ་དང་བོད་དུ་བཏང་སྟེ་ཁམས་བོད་གཞུང་ལམ་གྱི་ལམ་ཐིག་ལ་བརྟག་དཔྱད་བྱེད་མཁན་ཡིན་པ།",
    "སྐབས་དེར་ལྷ་ས་ནས་ཁྲུའུ་ཀྲང་གསར་པ་བསུ་བ་ཞུ་མི་ལི་གོ་ལིང་ཡང་ཀ་སྦུག་ཏུ་འབྱོར་ཟིན་འདུག་པ་ཚང་མ་མཉམ་འཛོམས་བྱུང་ཞིང་ཟླ་བ་བདུན་པའི་ཟླ་དཀྱིལ་ལ་སྒང་ཐོག་ཏུ་བསྐྱོད་པར་འབྲས་ལྗོངས་རྒྱལ་པོས་གསོལ་སྟོན་བཤམས་ནས་སྣེ་ལེན་གནང་བྱུང་།",
    "སྲིད་སྐྱོང་ལ་རྒྱ་མིས་དར་ཆ་མང་པོ་བཀལ་འདུག་པས་བསམ་ཡུལ་ལས་འདས་པའི་བྱ་སྤྱོད་གང་ཞིག་སྤེལ་རྩིས་ཡོད་དམ་ཞེས་སྙན་སེང་ཞུས།",
    "སྐབས་དེར་རང་ཉིད་ཀྱང་རང་མཚམས་ཀྱིས་ལས་གནས་ཐོག་ནས་ཁ་བྲལ་འདོད་མ་བྱུང་།",
    "ཁང་པ་འདིའི་ནང་ཁྱེད་རང་བཞུགས་པ་གནང་།",
    "ང་བཀའ་ཤག་ནས་ལོག་ཡོང་སྐབས་ས་རུབ་ལ་ཉེ་བར་འདུག་ཅིང་།",
    "མདའ་དཔོན་གྱིས་མི་རྩིས་སྤྲོད་རྒྱུ་ཡིན་པས་དེ་དོན་གནང་དག་མེད་པ་ཞུས་ཆོག་ཅེས་ཟེར་གྱི་འདུག་པས་ཚང་མས་ཉན་རྗེས་གཞི་ནས་སོ་སོར་ཕྱིར་ལོག་བྱས།",
    "སྐབས་དེར་ཀ་ལི་ཀ་ཏར་བཅའ་སྡོད་སྤྱི་ཁྱབ་ལིང་ཧྲི་ཁང་ལ་སྤྱི་ཁྱབ་ལིང་ཧྲི་མི་འདུག་པས་ཧོ་མན་ཧྲན་གྱིས་སྤྱི་ཁྱབ་ལིང་ཧྲིའི་ལས་ཚབ་ བྱེད་ཀྱི་ཡོད།",
    "རྒྱལ་ཡོངས་ཀྱི་ས་ཆ་ཁག་ཚང་མ་བཅིངས་འགྲོལ་བཏང་ཟིན་རྗེས་ཁྱིམ་དུ་མཉམ་འཛོམ་བྱེད་པར་ཡོང་རྒྱུ་ཡིན་ལུགས་འཁོད་འདུག་ཀྲུང་ཧྭ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་དབུ་བརྙེས་རྗེས།",
    "ང་རང་གཉིས་ཀྱང་ཚད་ཙམ་བྱེད་དོ་ཞེས་བཤད།",
    "དགྲ་བོའི་གནས་ཚུལ་ཡོད་མ་ཐག་ག་དུས་ཡིན་ནའང་དམག་འཐོབ་ནང་གཞུག་ན་འགྲིག་ས་འདིར་རྐང་པ་འཛུགས་ཐུབ་པའི་ཆེད་ཁང་པ་རྒྱག་པར་ཤིང་ཆ་མེད་རུང་ས་སྦུག་བྲུས་ཏེ་གནས་སྐབས་སྡོད་ས་བཟོས་ཡོད།",
    "ཁོང་རང་ཉིད་ནས་རྐང་ཀློག་གནང་ཡོད།",
    "ཞོགས་པ་གློག་འཕྲིན་སྒྱུར་པ་པོས་ཁོང་ལ་དཔུང་ཆེན་གྱིས་དཔུང་སྐྱོད་བྱེད་པའི་གནས་ཚུལ་ག་དུས་སྙན་སེང་ཞུས་ནའང་།",
    "སྒུལ་བསྐྱོད་བྱེད་སྐབས་བྲང་ཁོག་བསྡམས་ནས་དབུགས་རྔུབ་གཏོང་བྱེད་རྒྱུར་དཀའ་ངལ་ཆེན་པོ་འདུག་དམག་དཔུང་ལ་ས་མཐོའི་ཐོག་རི་བོ་འཛེགས་པའི་ཉམས་མྱོང་མེད་པ་དང་།",
    "ལུག་ཤ་བཅས་ཟ་བ་དེ་ཡང་ཧ་ཅང་ཉུང་ཉུང་ལས་མི་འདུག་བོད་རིགས་ཀྱི་སྡོད་ཁང་ནི་རྡོ་ཤིང་ལས་གྲུབ་པའི་ཁང་པ་ཡིན་པ་དང་།",
    "འབྲས་ཉམས་མེད་དམག་དཔུང་ལ་སྐྱེལ་བ་སོགས་བྱེད་ཀྱི་འདུག་ཁྱེད་ཚོས་དེ་དག་འཁྲབ་ཚན་ཆུང་ཆུང་ཞིག་བརྩམས་ནས་འཁྲབ་དགོས།",
    "རང་དོན་ཡིད་བྱེད་ཀྱི་བསམ་པ་དང་ནི་བསམ་པ་དེ་དང་མཐུན་པར་དེའི་ལམ་ཡང་རང་དོན་ཞི་བ་ཙམ་ཐོབ་པའི་ཆེད་དུ་བསྟན་པ་དང་།",
    "འབྲིང་རང་རྒྱལ་གྱི་རིགས་ཅན་དང་།",
    "བློ་བརྟན་འགྲེལ་ལས་འབྲས་བུ་སྐྱེ་བའི་རྟེན་དུ་རུང་བའི་མཆོག་ཅེས་འདུག་རྟེན་ནི་འཕགས་ལམ་ཐོབ་པའི་ལུས་རྟེན་ལ་བྱ་བའོ་གསུངས།",
    "དེ་ལྔ་པོ་རྒྱུ་དང་རང་བཞིན་བྱེད་ལས་ཀྱི་རྣམ་པས་ཡོངས་སུ་སྨིན་པའི་ཚུལ་ནི།",
    "དེ་ལྟར་ལྷ་ཚེ་རིང་པོའི་ནང་དུ་འདུག་འདུག་པ་ལས།",
    "མི་དགའ་བ་དང་རང་དགའ་བའོ།",
    "ཞེས་འདུག་གོ།",
    "མགོ་སྨྲོས་པས་གོ་བ་ལ་སེར་སྣ་མེད་པར་སྟོན་ཞེས་སྦྱར་བ་ཡོད་དེ་དོན་ལ་འབྱོར་པར་འདུག།",
    "བློ་བརྟན་འགྲེལ་ལྟར་ན་སོ་སོའི་ནང་རང་རིགས་པས་ཚུལ་བཞིན་དུ་ཞེས་འབྲུ་མནན་དགོས་འདུག།",
    "དེ་ལྟར་ན་གཞན་དོན་འགྲུབ་བྱེད་གསུམ་དང་རང་དོན་འགྲུབ་བྱེད་གསུམ་སྟེ་དྲུག་ཏུ་བཞག་གོ།",
    "བྱེད་ལས་གཞན་ལ་ཕན་བཏགས་པ་དང་རང་སྐྱེ་བ་གཞན་དུ་ལོངས་སྤྱོད་ཆེན་པོ་ཐོབ་པས་རང་གཞན་གཉིས་ཀ་རྗེས་སུ་འཛིན་པ་དང་།",
    "ཕྱི་ནས་གོས་སོགས་ཀྱིས་དགབ་བ་མེད་ཀྱང་རང་བཞིན་གྱིས་ཉེས་པའི་དྲི་མ་དང་བྲལ་བ་ཡིན་ནོ།",
    "གཉིས་པ་ཆེད་དུ་བྱ་བ་ནི་ཉན་རང་རྣམས་ཀྱི་བསླབ་པ་ཇི་སྙེད་པའང་རང་དོན་གཙོ་བོར་བྱེད་པའི་ཆེད་དུ་ཡིན་ལ།",
    "དེ་བཞིན་དགྲ་བཅོམ་དང་རང་རྒྱལ་གྱི་གང་ཟག་ཞེས་དང་།",
    "ཞག་དུས་ཚོད་དང་།",
    "བསྐུ་མཉེ་སོགས་ལེགས་པར་བྱ་བའི་སྒོ་ནས་ལུས་རྒྱས་པའི་ཚབ་ཏུ་ཚངས་སྤྱོད་ཅེས་འགྲེལ་པར་འདུག།",
    "བཞོན་པ་རྟ་སོགས་མི་འདུག་ན།",
    "བུམ་སོགས་མི་གཡོ་བར་འདུག་ནས་ཆུ་བླུགས་པ་སོགས་ཀྱི་བྱ་བ་བྱེད་པ་དང་།",
    "འདི་ལ་བདག་རྟག་མི་རྟག་ཅེས་དཔྱད་པ་འདུག་ཀྱང་།",
    "དེ་བཞིན་དུ་བདག་ཉིད་འདུག་པ་བུམ་སོགས་ཀྱི་དངོས་པོ་ཐམས་ཅད་ཀྱང་སེམས་དང་སེམས་བྱུང་ལ་སྣང་བར་ཟད་ཀྱི།",
    "བཅས་པ་དང་རང་བཞིན་གྱི་ཁ་ན་མ་ཐོ་བ་མི་བསྲུང་བ་ནི་བག་མེད་པ་ཡིན་ལ།"
  ]
}