    "ཚོང་པ་མང་པོ་དབུས་ནས་འཁོར་འདུག་པ་རྣམས་ཀྱིས་དེ་རིང་གང་ནས་བྱོན་ཟེར་བར།",
    "དེ་ལ་བརྫུན་བཏང་དགོས་མི་འདུག་གསུངས་པས་ཁོང་རྣམས་ཡ་མཚན་དུ་གླེང་།",
    "ཁྱེད་རྣམས་ང་ལ་ངུ་རྒྱུ་ཅི་འདུག་ང་རྡོ་རྗེ་འཆང་ལྷ་རྩེ་པ་ཆེན་པོ་དང་མཇལ།",
    "ངེད་འཇིག་རྟེན་པ་འདི་སྣང་བ་མ་དག་པ་ཚབས་ཆེ་བས་དེ་ལས་འོས་མི་འདུག་ཟེར།",
    "ན་བཟའ་རས་རྐྱང་ལས་མེད་པར་འཇམ་ཕྲུག་འདྲ་འཚེམ་དགོས་འདུག་པས་བཞུགས་ཞེས་གསོལ་ཀྱང་།",
    "གནས་མཐིལ་དུ་རྡོ་རྗེའི་སྤུན་གསོལ་དཔོན་རྣམ་སྲས་སྒྲུབ་པ་ལོ་གསུམ་པར་བཞུགས་པ་རྗེ་རྒོད་ཚང་པ་དངོས་བྱོན་ལྟ་བུའི་སྒྲུབ་ཚུགས་མི་དམན་པར་འདུག་བུག་སྒོར་མཇལ་བས་ཡིད་རབ་ཏུ་དང་བ་བྱུང་གསུང་།",
    "གཞོན་པ་རྣམས་ལ་བློ་བསྐྱེད་ཡོང་འདུག་པས་གསུང་པ་ལེགས།",
    "ཁྱེད་རང་རྣམས་ལོ་གསུམ་སྡོད།",
    "ལྐོག་གྱུར་གྱི་བྱ་བ་གྱ་ཚོམ་ཁོ་ན་བྱེད་པ་འདི་ལྷ་མི་དམ་པ་ཀུན་ཐུགས་ཁྲེལ་ཞིང་རང་གཞན་ཐམས་ཅད་ཕུངས་ལ་སྦྱོར་བ་འདུག་དགོངས་རང་ཉིད་ཀྱི་གོ་ཆའི་གདེངས་ཚད་ཀྱང་ཇེ་བརྟན་དུ་གྱུར།",
    "དེ་ཀ་ཡིན་ཁྱེད་ཀྱིས་དོན་ཤེས་འདུག་གསུང་ཤིན་ཏུ་མཉེས།",
    "ཤ་ཝ་རི་ལ་ཡིད་ཆེས་ཤིང་རང་སེམས་རྟོགས་ན་མཐོང་མ་མཐོང་གཉིས་ཀས་གྲོལ་བ་དང་།",
    "བློས་བཏང་དང་གནས་ལུགས་ཀྱི་སྟེང་དུ་མཉམ་པར་འཇོག་པ་རང་ཟབ་པར་འདུག་གསུངས།",
    "ལྷག་པར་སྟག་ཚང་འདིར་ལོ་སྦྲེལ་ནས་བཞུགས་མཁན་མཐར་ཐོན་པ་སྔོན་ཆད་ཆེར་མ་བྱུང་འདུག་རུང་།",
    "རྒན་པོ་འཁར་བ་ལ་བརྟེན་བརྟེན་སྡོད་ཟེར་བར་འདུག་པས་སྦ་འཁར་དེ་དྲ་ཕད་དང་ལྷན་དུ་བཞོག་གསུངས།",
    "བེ་རོ་ཙ་ནས་བསྒྲུབ་པ་ལ་བཞུགས་དུས།",
    "མི་གཅིག་ཀྱང་མི་ཐར་བ་གསོད་པར་འདུག་དགོངས།",
    "འདིར་བསྡད་ཀྱང་རྣམ་གཡིང་ཁོ་ནར་འགྲོ་བའི་འདུག་ནོར་འཕྲོག་རྒྱུ་ནི་མེད།",
    "སྐོར་ཅིག་ལོག་ཤོག་དེ་རྗེས་ཁྱེད་རང་གང་འདོད་བྱས་ཆོག་གསུང་བའི་བཀའ་སྩལ་ཕེབས་པ་ལྟར་དབུས་སུ་ལོག་དུས་ཕེབས་སྒོ་ལ།",
    "གནས་སྒོ་འགག་རིང་མཚམས་རང་བཅད་དུ་འདུག་གཡེང་བ་ཆུང་ཞིང་དགེ་སྦྱོར་འཕེལ་བར་ཡོང་འདུག་པས་བསླབ་སྟོན་ཞུ་རྒྱུ་ལགས་ཞུས་པས།",
    "ད་ཙ་རི་ལ་དེ་ཙམ་གྱིས་ཆོག་ཡུན་རིང་ན་ཙ་རི་བ་སྤྱི་པ་དང་འདྲེས་འགྲོ་ཁྱེད་རང་རྐང་པ་མགྱོགས་པ་དང་བློ་སྟོབས་ཀྱང་མི་ཆུང་བ་འདུག་པས།",
    "གནས་ཆེན་གྱི་ཕྱོགས་སུ་བདེ་བར་འདུག།",
    "གཞན་མ་བདེ་བ་ཞུ་རྒྱུ་རང་མི་འདུག་ལགས་ཞུས་པས།",
    "ཨོ་རྒྱན་ལ་འགྲོ་བར་བསྙེན་བསྒྲུབ་ཅིས་ཀྱང་དགོས་པ་ཡིན་འདུག་དེའི་ནང་ནས་བཅོམ་ལྡན་འདས་བདེན་གཉིས་ཞལ་ལ་བཟླས་པ་བྱས་ན་ལེགས་པས།",
    "སང་ཉིན་རྗེ་འདི་པ་ལྷུན་གྲུབ་རབ་བརྟན་པས་གདན་དྲངས་པའི་ནུབ་མཚན་སྣང་ལ་བསྐང་གཏོར་ཆེན་པོ་ཞིག་བཤམས་ཏེ་ཆོ་ག་མཛད་འདུག་པས།",
    "ལྷག་པར་ཁོ་རང་ལ་དེ་ལོ་ཇོ་ཇོའི་སྲི་ཡོད་པས་ལོ་གཅིག་བར་རིམ་གྲོར་ཅིས་ཀྱང་བཞུགས་པར་གསོལ་ཞིང་།",
    "ཉིད་རང་གཅིག་པུར་འདུག་བརྩིས་ལ་གྲོགས་པོ་གསུམ་གྱིས་མ་ཉན་པར་མཉམ་དུ་སྡོད་ཏ་།",
    "གལ་ཏེ་འོང་གྲབས་འདུག་ཀྱང་དེའི་གཉེན་པོར་བཟློག་བསྒོམ་ཆིག་ཆོག་ཟེར་བ་ཅིག་ཡོད།",
    "ཉེ་བའི་གྲོགས་དང་འབྲལ་དགོས་འདུག་པས་གྲོགས་མེད་གཅིག་པུར་ཕྱིན།",
    "དེར་ལྷ་ཁང་བཞི་ཙམ་འདུག་པ་རྣལ་འབྱོར་རྒྱུད་ཀྱི་ལྷ་དཀྱིལ་འབའ་ཞིག་ཏུ་འདུག་གསུང་ནས་བ་མགོར་ཕེབས།",
    "བྱམས་པའི་དཀོན་གཉེར་ལ་འབྲུག་པའི་དགེ་སློང་ཁ་ཅིག་འདུག་བར་ཞག་བཞུགས་མཛད།",
    "མདུན་ན་བྱད་མའི་ལིངྒ་ཅིག་འདུག་པར་སྔགས་པ་ནག་པོ་དྲག་པོའི་ཆས་སུ་ཞུགས་པ་ཤིན་ཏུ་འཇིགས་པ་བཞི་བྱུང་སྟེ།",
    "དེར་རྒྱལ་མཁར་རྩེའི་ཞལ་ངོ་རྣམས་བཞུགས་འདུག་པ།",
    "ཡོན་བདག་དཔོན་སྐྱ་ཆེ་ཕྲའི་མཇལ་མི་མང་དུ་འདུག་པས་ཚོགས་ཀྱི་འཁོར་ལོ་སོགས་བཟང་དུ་བསྒྲུབས།",
    "སྟོད་ཕྱོགས་སུ་རྒྱལ་པོ་སྐུ་མཆེད་ནང་མ་འགྲིག་པ་ཡོད་འདུག་པར་ཉིད་ལ་འབྱོན་དགོས་ཚུལ་དང་།",
    "གཞན་ཅིག་བཏང་ཡང་ཕན་ཨེ་ཐོགས་མི་ཤེས་པས་བསྟན་དོན་དུ་བསམ་ནས་ཁྱེད་འབྱོན་དགོས་པ་འདུག་གསུང་བར།",
    "ད་རུང་གཏན་གྱི་བཟང་ཞིག་ཁྱེད་ཀྱིས་མཛད་དགོས་གསུང་འདུག་པར་ཞུ་ལན་དུ།",
    "མི་ཀུན་ཟེར་ལུགས་ལ་གུ་གེ་རུ་ཐོག་གཉིས་ཀྱིས་མི་ཚོ་ལ་མང་ཡུལ་བ་ཐུབ་ཀྱིན་མེད་ཟེར་འདུག་ཞུས་མཛད་པར།",
    "སྔོན་དུ་མང་ཡུལ་ནས་བུ་རིག་སྤྱི་བཏན་བར་དམག་མཛད་དུས་ག་ག་བསྟན་པ་སོགས་མི་བརྒྱད་ཅུ་ཙམ་ཡལ་དུ་ཚུད་ཅིང་སྤྱི་བཏན་༦༢པའི་བུ་ཚ་མིང་སྲིང་བཅས་མང་ཡུལ་དུ་འདུག་བར།",
    "དེ་མིན་ནོར་གྱི་བླུ་དགོས་འདུག་གསུངས་པར།",
    "དེ་མིན་ཆུ་མུར་ཏི་པའི་བཙོན་བརྒྱད་ཅུ་གྱ་བརྒྱད་ལ་ཐགས་སུ་ཡལ་བ་རྒྱལ་པོར་ཞུས་ནས་སློག་པ་ཁྱེད་རང་གུ་གེ་བ་ཀུན་ལ་རྒྱུས་མེད་དམ།",
    "དེ་སྤོང་མཁན་ཡང་ངོས་སུ་མ་གཏོགས་ལྐོག་ཏུ་འདི་འཆི་མེད་ཀྱི་བདུད་རྩི་ལྟ་བུ་ལས་ཀྱང་གཙིགས་ཆེ་བ་བྱེད་ཀྱི་འདུག་རྒྱལ་བའི་བཀའ་ལ་མི་བརྩི་བའི་ཁོ་བོ་ལ་ག་ནས་བརྩི།",
    "ད་དུང་ཡང་རང་དོན་དུརིམ་གྲོ་ཚེ་བསྒྲུབ་སོགས་སྔར་ཡང་བྱེད་མ་མྱོང་།",
    "དེ་བས་དགེ་སྦྱོར་ཆག་རྒྱུར་འདུག་གསུང་མ་བཞེད་པར།",
    "ཁྱེད་རང་རྣམས་རྐྱེན་ངན་དགེ་སྦྱོར་གྱི་བསྐུལ་མར་ཤེས་པས།",
    "བློན་པོས་ཟང་དགས་ཁན་ཅང་གེས་ཁན་ལ་སྐར་པ་འདེབས་ཀྱིན་འདུག་ཟེར་བ་ཐོས་ནས་ཡོངས་པ་ཡིན་ཟེར་བར།",
    "པིར་ཡགས་པོ་འདུག་ཁྱེད་ཡར་ཀྱེན་ཁན་གྱི་ཐུགས་ལ་བབས་པོ་ཡོང་།"
  ]
