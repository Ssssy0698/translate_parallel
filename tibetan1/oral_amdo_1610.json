    "བདག་ཅག་འཁོར་མང་པོ་རྣམས་ཤིན་ཏུ་ཐོས་པར་མོས་སོ།",
    "བདག་ཀྱང་དེའི་ཚེ་མིག་སྟོང་གིས་དེ་ལ་ལྟ་བར་བྱེད།",
    "ལག་པ་སྟོང་གིས་ནི་དེ་ལ་ཡོངས་སུ་སྲུང་༧ཞིང་བྱིན་གྱིས་རློབ་པར་བྱེད་པས་འཇིག་རྟེན་པའི་གཙུག་༨ལག་ཇི་སྙེད་པ་དེ་དག་ཀྱང་ཡོངས་སུ་འཛིན་པར་འགྱུར།",
    "དེའི་ཉེ་ལའཁོར་ན་གནས་ནས་མིག་གི་འབྲས་བུ་བཞིན་དུ་ཡོངས་སུ་སྲུངས་ཤིག།",
    "བདག་གིས་གསང་བའི་བདག་པོ་རྡོ་རྗེ་འཆང་།",
    "བདག་གིས་ནོར་སྲུང་དང་ནི་ཆུ་ལྷ་དང་།",
    "བདག་གིས་པི་པ་ཀ་ལའི་རྒྱལ་པོ་དང་།",
    "བདག་གིས་ཚངས་པ་དང་ནི་སམ་བ་ར།",
    "བདག་གིས་བརྒྱ་བྱིན་སུམ་ཅུ་ནརྩ་གསུམ་ལྷ།",
    "བདག་གིས་རྒྱལ་པོ་ཡུལ་འཁོར་སྲུང་རི་དང་ནི།",
    "བདག་གིས་རྒྱལ་པོ་འཕགས་སྐྱེས་པོ་དང་ནི།",
    "བདག་གིས་ནོར་བུ་བཟང་པོ་དག་དང་ནི།",
    "བདག་གིས་དགའ་བོ་དང་ནི་བསྙེན་དགའ་བོ།",
    "བདག་གིས་ལྷ་མ་ཡིན་དང་དྲི་ཟ་དང་།",
    "བདག་གིས་ཆུ་དང་མེ་དང་གློག་གི་ལྷ།",
    "མཐུ་ཆེན་པོ་དང་ལྡན་པའི་གནོད་སྦྱིན་དག་གིས་ཀྱང་རྟག་པར་ཐུགས་རྗེ་ཆེན་པོའི་རིག་སྔགས་འདོན་ཅིང་ཡོངས་སུ་འཛིན་པ་དེ་ལ་ཡོངས་སུ་སྲུང་༦ཞིང་སྐྱོབ་པར་བྱེད་པས།",
    "གང་ཞིག་རི་དང་འབྲོག་དགོན་སོང་བ་ལས།",
    "བུད་མེད་སྦྲུམ་མ་བུ་ནི་བཙའ་བའི་ཚེ།",
    "ཁྱོ་༧ཤུག་སོ་སོར་གཞན་ལ་འདོད་ཞེན་ནས།",
    "བདག་གིས་གཟུངས་འདིའི་མཐུ་སྟོབས་རྒྱས་བརྗོད་ན།",
    "གཟུངས་འདི་ནི་འདས་པའི་དེ་བཞིན་གཤེགས་པ་གང་གཱའི་ཀླུང་གི་བྱེ་བ་ཕྲག་དགུ་བཅུ་རྩ་དགུའི་བྱེ་མ་སྙེད་ཀྱིས་གསུངས་པ་ཡིན་ཏེ།",
    "བདག་གིས་ཐབས་མཁས་པ་དང་།",
    "དཔེ་བྱད་བརྒྱད་ཅུ་༥ཡང་རང་གི་ངང་གིས་འཐོབ་པར་འགྱུར་རོ།",
    "དགེ་སྦྱོང་གི་འབྲས་བུ་བཞི་པོ་དག་མ་བཙལ་བར་རང་གི་ངང་གིས་ཐོབ་པར་འགྱུར་རོ།",
    "ཡང་ངན་འགྲོ་གསུམ་པོ་དག་གི་རྣམ་པར་སྨིན་པ་མྱོང་བར་མི་འགྱུར་ཞིང་།",
    "གང་ཟག་དེ་ནི་དམ་པའི་ཚིག་གི་མཛོད་ཡིན་པར་རིག་པར་བྱ་སྟེ།",
    "འཇིག་པ་གསུམ་གྱི་བསྐལ་པ་ཅདག་གིས་གཞིག་པར་༥མི་ནུས་པའི་ཕྱིར་རོ།",
    "ས་ལ་རི་མོ་བྲིས་ནས་མཚམས་གཅད་༥པར་བྱའོ།",
    "ཡང་ན་ཐལ་བ་གཙང་མ་ལ་ལན་ཉི་ཤུ་རྩ་གཅིག་སྔགས་ཀྱིས་བཏབ་སྟེ་མཚམས་གཅད་པར་བྱའོ།",
    "དགེ་སྦྱོང་གི་འབྲས་བུ་བཞི་པོ་དེ་དག་ཚེ་འདི་ཉིད་ལ་འཐོབ་པར་འགྱུར་རོ།",
    "བཙུན་མོ་དང་སྲས་ཕྱིརརྣམས་ཀྱང་རྒྱལ་པོ་ལ་སྲི་༧ཞུ་དང་བསྙེན་བཀུར་བྱེད་པར་འགྱུར།",
    "མི་མ་རུངས་པ་དག་གིས་ཀླན་༧སྐུར་བཏབ་ནས་རྐུ་༡༡བཤམས་ཏེ་གནོད་པ་བྱས་པར་གྱུར་ཏམ།",
    "ཀུན་དགའ་བོ་ཁྱོད་ཀྱིས་ཤིན་ཏུ་ཡོངས་སུ་དང་བའི་སེམས་ཀྱིས་གཟུངས་འདི་ཟུང་ལ་འཛམ་བུའི་གླིང་དུ་རྒྱ་ཆེར་ཡོངས་སུ་སྤེལ་ནས་རྒྱུན་མི་འཆད་པར་བྱའོ།",
    "ན་མོ་བུདྡྷ་གུ་ལར་བེ།",
    "ན་མོ་དྷརྨ་མ་ཧ་༥",
    "དེང་བདག་གིས་ཀྱང་རྣལ་འབྱོར་པ་དག་ཡོངས་སུ་བསྲུང་བའི་ཕྱིར་དང་།",
    "གང་ལ་ལ་ཞིག་བྱི་ལའི་གདོན་གྱིས་ཟིན་པར་གྱུར་ན་བྱི་ལའི་མགོ་རུས་བསྲེགས་པའི་ཐལ་བ་ས་གཙང་མ་དང་བསྲེས་ཏེ།",
    "མིག་སྟོང་པའི་གཟུགས་ཀྱི་༡མདུན་དུ་ཨུར་མོའི་གྲི་གཙང་མ་ལ་བརྒྱ་རྩ་བརྒྱད་སྔགས་ཀྱིས་བཏབ་སྟེ་༡༡།",
    "དུམ་བུ་བརྒྱ་རྩ་བརྒྱད་དུ་བཅད་ནས་སྔགས་ལན་རེ་གདོན་ཅིང་དེའི་མིང་ནས་ལན་རེ་བརྗོད་ན་གཏན་༡༢དུ་འཚོ་བར་འགྱུར་རོ།",
    "གལ་ཏེ་མི་མ་རུངས་པ་དག་གིས་རྐུ་བཤམས་ནས་གནོད་པ་བྱས་པར་གྱུར་ན་ས་གཙང་མའམ།",
    "སྤྲ་ཅིཚིལ་ལ་ཕ་རོལ་པོའི་གཟུགས་བྱས་ཏེ་མིག་སྟོང་པའི་གཟུགས་ཀྱི་མདུན་དུ་ཨུར་མོའི་གྲི་ལ་ལན་བརྒྱ་རྩ་བརྒྱད་སྔགས་ཀྱིས་བཏབ་ནས་༤སྔགས་ལན་རེ་བརྗོད་དེ་ལན་རེ་གཏུབས་ནས་ཕ་རོལ་གྱི་མིང་ནས་བརྗོད་དེ།",
    "མིག་གི་འབྲས་བུ་ཉམས་པར་གྱུར་ཏམ།",
    "དམར་པོ་དག་གིས་ཁེབས་ཏེ་འོད་དང་མི་ལྡན་པར་གྱུར་ན།",
    "འཐག་པའི་ཚེ་གཙང་སྦྲ་བྱ་དགོས་པས་བུད་མེད་གསར་དུ་བུ་བཙས་པ་དང་ཁྱི་དང་ཕག་རྣམས་བསྙེན་པར་མི་བྱའོ།",
    "འོ་མ་དེ་ཡང་བུ་ཁྱེའུ་བཙས་པའི་ནུ་ཞོ་རུང་གི་བུ་མོ་བཙས་པའི་ནུ་ཞོ་ནི་མི་རུང་ངོ།",
    "མིག་གི་འབྲས་བུ་སྐྱེ་བར་འགྱུར་བས་ལིང་ཏོག་སྔོན་པོ་དང་དཀར་པོ་བསལ་ཏེ་གསལ་བ་རྒྱས་པར་འགྱུར་རོ།",
    "བུད་མེད་སྦྲུམ་མའི་ལྟེ་བ་དང་མོ་མཚན་ལ་བསྐུས་ན་མྱུར་དུ་བཙའ་བར་འགྱུར་རོ།",
    "བུད་མེད་སྦྲུམ་མ་གང་དག་མངལ་དུ་བུ་ཤི་བར་གྱུར་ན་གིའུ་༢མི་སུང་གཅིག་ཆུ་ཕུལ་དོའི་ནང་དུ་བསྐོལ་ཏེ་ཕུལ་གང་ལུས་པ་ལ་ལན་ཉི་ཤུ་རྩ་གཅིག་སྔགས་ཀྱིས་བཏབ་ནས་བླུད་ན།",
    "མེས་ཚིག་པར་གྱུར་ན་བ་ལང་གི་ལྕི་བ་དྲོན་པོ་ལ་ལན་ཉི་ཤུ་རྩ་གཅིག་སྔགས་ཀྱིས་བཏབ་སྟེ་རྨ་ཁར་༥༧་བསྐུས་ན་འཚོ་བར་འགྱུར་རོ།",
    "ཤུ་ཆེན་བྱུང་བ་ལ་ལེང་སེའུ་ཧྭ་ཛོ་༩བརྡུངས་པའི་ཁུ་བ་ལ་ལན་ཉི་ཤུ་རྩ་གཅིག་སྔགས་ཀྱིས་བཏབ་སྟེ་ཤུ་བའི་སྟེང་དུ་བླུགས་ན་རྩ་བར་དབྱུང་༡་བར་འགྱུར་བས་མོད་ལ་འཚོ་བར་འགྱུར་རོ།",
    "མིག་ཏུ་སྦྲང་མ་ཞུགས་ཏེ་ན་བར་གྱུར་ན་བོང་བུའི་རྟུག་པ་བཙིར་བའི་ཁུ་བ་ལ་ལན་ཉི་ཤུ་རྩ་གཅིག་སྔགས་ཀྱིས་བཏབ་སྟེ་མཚན་མོ་མིག་ཏུ་བླུགས་ན་འཚོ་བར་འགྱུར་རོ།",
    "ལིང་ཏོག་བྱུང་བར་གྱུར་ན་ཀེའུ་ཁི་༦༧ཆེའི་ཤིང་གི་ལོ་མ་བརྡུངས་ཏེ་བཙིར་བའི་ཁུ་བ་ལ་ལན་བདུན་སྔགས་ཀྱིས་བཏབ་སྟེ།",
    "གལ་ཏེ་མཚན་མོ་འབྱུང་འཇུག་གི་ཚེ་འཇིགས་དངངས་༤ནས་མི་བདེ་བར་གྱུར་ན་སྐུད་པ་དཀར་པོ་ལ་ལན་ཉི་ཤུ་རྩ་གཅིག་སྔགས་ཀྱིས་བཏབ་སྟེ།",
    "གལ་ཏེ་ཁྱིམ་འཁོར་དུ་ལྟས་ངན་བྱུང་བར་གྱུར་ན་བལ་པོ་༥༦སེའུའི་ཤིང་གི་ཡལ་ག་བླངས་ནས་དུམ་བུ་སྟོང་རྩ་བརྒྱད་དུ་གཏུབས་ཏེ།",
    "མགོ་མཇུག་༧གཉི་གར་མར་དང་ཞོ་བསྐུས་ནས་སྔགས་ལན་རེ་བཟླ་ཞིང་རེ་རེ་བསྲེགས་ཏེ་སྟོང་རྩ་བརྒྱད་ཚང་བར་བྱས་ན་གདོན་བགེགས་ཐམས་ཅད་རབ་ཏུ་ཞི་བར་འགྱུར་ཏེ་ཚོ།",
    "ཀེའུ་ཁི་ཚེའི་ཤིང་གི་ལོ་མའམ་ཡལ་ག་ཡང་རུང་༡་སྟེ་དུམ་བུར་གཏུབས་ནས་མགོ་མཇུག་༡༡གཉི་གར་བ་མར་ཡང་དག་པ་དང་།",
    "སྦྲང་རྩི་༡༢དཀར་པོ་དང་བ་ཞོ་བསྐུས་ཏེ་སྔགས་ལན་རེ་བཟླ་ཞིང་དུམ་བུ་རེ་རེ་སྲེག་༡་པ་སྟོང་རྩ་བརྒྱད་ཚང་བར་བྱའོ།",
    "གིའུ་ནསཝང་སུང་གཅིག་བེེ་ཌཱུརྱའི་བུམ་པའི་ནང་དུ་བཅུག་སྟེ།",
