    "སྤྱི་ལོ་ལོར་ཐོག་མར་པར་དུ་བསྐྲུན་པའི་སུ་སུར་ལགས་ཀྱི་སྤྱིར་བཏང་སྐད་ཆ་རིག་པའི་ཁྲིད་ཡིག་ཅེས་པ་རུ།",
    "ཐ་ན་ཡི་གེ་དང་བཅས་པར་ཞིབ་འཇུག་བྱེད་པ་བཞིན།",
    "དེང་རབས་སྐད་ཆ་རིག་པར་གྲགས་པའི་རིག་པ་གསར་བ་འདི་ནི།",
    "སྐད་ཆའི་རིགས་དབྱེ་སོགས་རིག་པའི་ཡན་ལག་མང་དུ་འདུས་པར་མ་ཟད།",
    "བསྟན་དོན་མེད་པའི་ཐབས་ལམ་ཞིག་ཡོད་པར་མ་དམིགས་པས།",
    "མིང་དུ་མ་རགས་པར་སྤུངས་པ་ཙམ་གྱིས་ཚིག་དོན་མི་འགྲུབ་པར།",
    "ཁོ་ཚོ་ད་ཕེབས་བྱུང་།",
    "ཞེས་པར་ཁོ་ཚོ་ད་ལྟ་ཉིད་དུ་ཕེབས་བྱུང་ཞེས་པ་དང་།",
    "ཁོ་ཚོ་ཡུན་རིང་འགོར་ནས་ད་གཟོད་ཕེབས་བྱུང་ཞེས་པར་གོ་བ་ནི་གཙོ་བོ་སྒྲའི་རིང་ཐུང་ལས་བྱུང་བ་དང་།",
    "གང་ཞིག་དབབ་བྱའི་ཡི་གེ་ལ་དོན་མཚོན་དང་སྒྲ་སྦྱོར་གྱི་ཁྱད་པར་ཡོད་ཀྱང་།",
    "བརྡ་སྤྲོད་ཀྱི་ཐབས་ལམ་ནི་མཐེབ་གཞོང་དང་མཐུན་པར་སྒྲོམ་གཞི་གཏན་ཆགས་ཤིང་།",
    "རྩ་བའི་སྒྲིག་ཐབས་ཡང་ཡང་བསྐྱར་དུ་བཟླ་ཆོག་པ་གཞིར་བྱས་ཏེ།",
    "ཚིག་གསར་སྒྲིག་སྦྱོར་བྱེད་པ་ལ་ཀུན་ལ་ངེས་ཤིང་སྤྱི་ལ་ཁྱབ་པའི་གཏན་སྲོལ་དག་ངེས་པར་བརྩི་དགོས་པ་ནི།",
    "ཞེས་པར་བསྟན་པ་ལྟར་ཁ་རྒྱབ་འགྲངས་ཐབས་ཙམ་དོན་དུ་གཉེར་པ་རྣམས་ལ་དེ་བཞིན་ཡིན་མཆི་ཡང་།",
    "མཐའ་འཁོར་གྱི་མི་རྣམས་ཀྱི་བརྗོད་ལུགས་དང་མཐུན་པར་བརྗོད་པ་ཡིན་ལ།",
    "བརྡ་སྤྲོད་ཀྱི་གནས་ལུགས་གཏན་ཆགས་པ་ཞིག་ཡོད་པར་མ་ཟད།",
    "འཁྲིད་བྱའི་ནང་དོན་དཔྱིས་ཕྱིན་པར་ངོ་སྤྲོད་ཞུ་ཐུབ་པ་དང་།",
    "ལྔ་རུ་ན་སྐད་རིགས་ཐ་དད་པའི་སྦྱོར་ལུགས་ཀྱི་ཁྱད་པར་དང་།",
    "བསྒྱུར་བྱ་སྒྱུར་བྱེད་ཀྱི་བསྟན་བྱ་མཐུན་ཞིང་རྨ་མེད་པར་བསྒྱུར་བ་དང་།",
    "ཕྱོགས་གང་དང་ཅི་ལ་འབད་འབུངས་བྱེད་པ་ཤེས་པར་འགྱུར་བ་བཅས་སུ་འདུ་ཕྱིར།",
    "གཞུང་ལུགས་གསར་བཞེངས་ཀྱི་ལས་ལ་འབད་ཅིང་འབད་བཞིན་པ་འདི་ལགས་སོ།",
    "སྔར་ནས་ཡོད་པའི་སྐད་ཆ་དེ་ཉིད་ཡུལ་དང་དུས་ཀྱི་བསྐལ་པའི་ཆར་ཉར་ཞིང་བརྒྱུད་པར་བྱེད་པའི་ཐབས་ལམ་ཉག་གཅིག་སྟེ་ཡི་གེ་གསར་དུ་བཟོ་བའི་ལས་ལ་འབད་པའི་ཚེའང་།",
    "རྒྱ་གར་གྱི་སྒྲ་གཞུང་ཆེན་པོ་གཞན་རྣམས་མ་དར་པར་མངོན་ནོ།",
    "སྐད་ཆའི་ནུས་པ་དང་སྐད་ཆའི་བཀོལ་སྤྱོད་ཅེས་པའི་ཁྱད་པར་ཕྱེ་སྟེ།",
    "སྒྲ་གདངས་བཅས་ཀྱི་ཤེས་བྱ་ནི་བརྡ་སྤྲོད་ཀྱི་ནུས་པར་བསྡུས་ཏེ།",
    "སྐད་ཆའི་ཤེས་བྱ་མ་ཡིན་པར།",
    "ཤེས་བློའི་རྩ་བའི་འབྲེལ་པ་ནི་མི་དང་བརྡ་སྤྲོད་ཀྱི་བར་དུ་གནས་ཡོད་པར་གསུངས་ཤིང་།",
    "བརྡ་སྤྲོད་ནི་སྒྲིག་ཆས་ཤིག་དང་མཚུངས་པར་སྐད་ཆ་དེའི་ཚིག་སྦྱོར་ཡོད་ཚད་བསྐྱེད་ཐུབ་པའི་རིགས་པ་གསལ་བར་བསྟན་པའི་ཕྱིར་གྱིས།",
    "རང་མྱོང་འཐུས་ཚང་དུ་གཏོང་བ་སྤྱི་མཐུན་གྱི་གོམས་སྲོལ་དུ་གྲུབ་པར་བརྟེན།",
    "བསམ་བློ་གཏོང་ལུགས་མིང་ཕྲད་ཀྱི་རིམ་པ་ཅན་དུ་བྱས་པ་ནི་སྐད་ཆའི་སྦྱོར་བ་ཡིན་པས།",
    "བསམ་བློ་བརྗོད་རུང་ཅན་དུ་བྱས་པ་ནི་སྐད་ཆ་དང་།",
    "བརྗོད་གཞི་གསལ་བྱེད་བྱ་ཡུལ་བཅས་ཀྱི་རིམ་པར་སྣང་བ་དང་།",
    "ཞེས་པར་བསྟན་པ་དང་།",
    "དོན་གྱི་ཁྱད་པར་བརྗོད་བྱེད་པ།",
    "སྐབས་དོན་རྫོགས་པར་སྟོན་ཞིང་སྒྲའི་འདེགས་འཇོག་གསལ་པའི་རྗོད་བྱེད་ཀྱི་སྒྲ་ཞིག་ལ་ཚིག་ཟེར་བ་བོད་སྐད་དུའང་སྦྱོར་བཏུབ་ཀྱང་།",
    "པ་བ་སོགས་ཀྱི་མིང་མཐའ་དང་བྲལ་བའི་སྐབས་བབ་ཀྱི་བསྟན་བྱ་རྫོགས་པར་སྟོན་པའི་གདངས་ཀྱི་འཇོག་མཚམས་གསལ་བའི་རྗོད་བྱེད་ཀྱི་སྒྲ་ཞིག་ལ་བྱའོ།",
    "ཞེས་པར་བསྟན་ཅིང་།",
    "ཚིག་ཅིག་ལ་གྲུབ་ཆ་ཐམས་ཅད་ངེས་པར་ཚང་དགོས་པས་མ་ཁྱབ་བོ།",
    "སྲིད་ངོས་ཀྱི་ཆ་གཉིས་ནས་བྱས་པ་སྟེ།",
    "མི་ཕན་ཚུན་བར་གོ་བརྡ་སྤྲད་པར་མི་ནུས་པས།",
    "ཞེས་པར་བརྗོད་པ་དང་གཉིས་སུ་མ་མཆིས་པས།",
    "དེ་ཡང་མིང་ཅི་དང་གང་ཡིན་གྱིས་བྱེད་པ་མ་ཡིན་པར།",
    "མིང་གང་དག་ལ་མི་སྦྱོར་བའི་ཁྱད་པར་ཡོད་པ་གསལ་བར་ངེས་ན།",
    "བཅད་ཅེས་པར་གཅད་དང་།",
    "ཆོད་ཅེས་པའི་དུས་ཀྱི་ཁྱད་པར་གསལ་བའི་ཁར།",
    "སྐད་ཆའི་སྦྱོར་བ་ཧྲིལ་པོ་དུས་ཡུན་ཐུང་ངུའི་ནང་ལ་ཁོང་དུ་ཆུད་པར་བྱ་བ་ལ་ཤིན་ཏུ་ཕན་པས།",
    "མིང་ལ་བརྟེན་ནས་ཤེས་བྱ་དེ་ཉིད་ཡིད་ལ་འཛིན་པར་བྱེད་པས།",
    "མིང་ནི་སྐད་ཆའི་ཁང་བཟང་སྒྲུབ་བྱེད་ཀྱི་རྩ་བར་གྱུར་པར་མ་ཟད།",
    "ཚིག་ཕྲད་ཀྱི་འབྱུང་གཞི་མིང་ལ་བྱེད་པར་མ་ཟད།",
    "མིང་སྔ་ཕྱིའི་བརྗོད་དོན་གྱི་གནས་ལུགས་གསལ་བྱེད་ལ་ཚིག་ཕྲད་སྦྱོར་བ་མ་གཏོགས་པར།",
    "སྐད་ཆའི་སྦྱོར་ལུགས་དམངས་སྤྱིའི་བསམ་བློ་གཏོང་ལུགས་དང་མཐུན་ན་བརྡ་སྤྲོད་དང་མཐུན་ཡང་གཏན་ཚིགས་དང་མཐུན་པར་མ་ངེས་པ་ནི།",
    "བརྡ་སྤྲོད་དང་གཏན་ཚིགས་ཡ་བྲལ་དུ་བྱས་པའི་རིགས་པ་ཞིག་མ་ཡིན་ནོ།",
    "འགྲུབ་རྒྱུའི་ཆ་ཤས་དག་རིང་ཐུང་ལྷུག་པར་གྲོལ་བའི་ཚིག་ལྷུག་དང་།",
