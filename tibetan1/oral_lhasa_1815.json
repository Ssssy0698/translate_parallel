    "བོད་ཀྱི་བརྡ་སྤྲོད་སྤྱི་རྣམ་རིག་འཕྲུལ་སྣང་མཛོད་ཅེས་པར།",
    "སྐད་གཅིག་དོན་བརྒྱའི་རྣམ་པར་སྤྱོད་ཅིང་།",
    "ལུས་ཀྱི་ཉམས་བཅས་ཟུང་དུ་སྦྲེལ་ཏེ་བརྗོད་དོན་རགས་ཙམ་པ་བརྗོད་ཚུལ་ཐབས་ཆག་པའི་སྒོ་ནས་སྟོན་པར་བྱེད་ཕྱིར།",
    "དངོས་པོའི་རྒྱུ་འབྲས་ཀྱི་ཁྱད་པར་ལས་མིང་དུ་མ་ལྷན་དུ་སྦྱར་ཏེ།",
    "སྐད་ཆའི་བརྗོད་དོན་གྱི་ཁྱད་པར་མི་གསལ་ཞིང་།",
    "གང་ཞིག་བརྗོད་པར་འདོད་པའི་དོན་གྱི་འབྲེལ་བ་དང་།",
    "བརྗོད་དོན་སྔ་ཕྱིའི་གཏན་ཚིགས་ཀྱི་ཁྱད་པར་ཇི་བཞིན་བསྟན་མི་ནུས་པའི་ཁར།",
    "དེ་ལས་ས་བཅད་དང་ལེའུ་སོགས་བྱས་སྟབས།",
    "ཅེས་པར་བསྟན་པ་ནི་ཚིག་ལྷུག་ལའང་དེ་བཞིན་ཡིན་པས།",
    "སྐད་ཆའི་སྦྱོར་བའི་འཕེལ་རིམ་གྱིས་དོན་གྱི་བརྗོད་རིམ་གྱི་ཁྱད་པར་ཤེས་ཤིང་།",
