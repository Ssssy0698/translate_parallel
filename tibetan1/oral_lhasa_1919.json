    "ཡང་དག་པར་སྤྱོད་པ་ལ་ཡང་སློབ་པོ་ཞེས་གསུངས་པ་ལྟ་བུའོ།",
    "རྣམ་པར་བྱང་བའི་མཚན་ཉིད་ལ་མཁས་པར་བྱ་བ་བསྐྱེད་པའི་ཕྱིར་ཐོག་མར་མཚན་ཉིད་དོ།",
    "རྣམ་པར་བྱང་བ་གང་ཡིན་པ་དེ་ནི་དེ་ཁོ་ནའོ་། དེ་ཁོ་ན་ཉིད་ཁོང་དུ་ཆུད་པས་སྒྲིབ་པ་སྤོང་བར་འགྱུར་ཏེ།",
    "གནས་སྐབས་དང་མཐུན་པའི་འབྲས་བུ་ཐོབ་པར་བྱེད་པས།",
    "དེའི་འབྲིང་དང་མཆོག་ནི་གནས་སྐབས་ཀྱི་ཁྱད་པར་རོ།",
    "དེས་སྤང་བར་བྱ་བ་ནི་༥ ༥དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "རྨོངས་པ་སྤངས་ནས་སྒྲིབ་པ་ལ་མཁས་པར་བྱ་བའི་ཕྱིར་སྒྲིབ་པའོ།",
    "དེས་དེ་ཁོ་ན་བསྒྲིབས་པས་དེ་ཁོ་ན་ལ་མཁས་པར་བྱ་བའི་ཕྱིར་དེའི་འོག་ཏུ་དེ་ཁོ་ནའོ།",
    "དེའི་དབྱེ་བ་ལ་མཁས་པར་བྱ་བའི་ཕྱིར་གནས་སྐབས་སོ།",
    "གནས་སྐབས་ཀྱིས་འབྲས་བུ་རབ་ཏུ་ཕྱེ་བས་དེ་ལ་མཁས་པར་བྱ་བ་བསྐྱེད་པའི་ཕྱིར་གནས་སྐབས་ཀྱི་འོག་ཏུ་འབྲས་བུའོ།",
    "ཞེས་བྱ་བར་གསུངས་སོ་ཞེས་བྱ་བ་ལ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཅེས་བྱ་བར་གསུངས་ཏེ།",
    "དོན་དམ་པར་རང་བཞིན་གྱིས་ཡོད་ན།",
    "དེ་ལྟ་ན་ནི་སྟོང་པ་ཉིད་མེད་པར་འགྱུར་རོ་ཞེ་ན།",
    "ཡང་དག་མ་ཡིན་པ་ཀུན་རྟོག་པ་ལ་གཟུང་བ་དང་འཛིན་པ་མེད་པ་ཉིད་གང་ཡིན་པ་དེ་སྟོང་པ་ཉིད་ཡིན་པས་སྟོང་པ་ཉིད་མེད་པར་མི་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "དེ་བས་ན་དྲི་མ་དང་བཅས་པས་ཆུའི་ཁམས་དྭངས་པ་ིབཞིན་རྟོགས་པར་མི་རུང་ངོ།",
    "གཟུགས་དང་རྫས་ཉིད་དུ་ཡོད་པར་གང་དག་ལྟ་བ་དེ་དགག་པའི་ཕྱིར།",
    "ཅེས་གསུངས་ཏེ་དེ་ཉིད་རྫས་སུ་ཡོད་དོ།",
    "གཟུང་བ་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "འདི་ལྟར་རྣམ་པར་ཤེས་པ་ལས་ཕྱི་རོལ་ན་གཟུགས་ལ་སོགས་པ་གཟུང་བ་མེད་པར་རྨི་ལམ་ལ་སོགས་པ་བཞིན་དུ་་གཟུགས་ལ་སོགས་པར་སྣང་བའི་རྣམ་པར་ཤེས་པ་འབྱུང་ངོ།",
    "གཟུང་བ་མེད་ན་འཛིན་པ་མེད་པར་འགྱུར་བས་གཟུང་བ་མེད་ན་འཛིན་པ་ཡོད་པར་མི་རུང་སྟེ།",
    "སྟོང་པ་ཉིད་ནི་རྣམ་པར་དག་པའི་དམིགས་པ་སྟེ།",
    "དེ་ལ་ཡང་ནི་དེ་ཡོད་དོ་ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཅེས་བྱ་བ་གསུངས་ཏེ།",
    "རྣམ་པར་ཤེས་པ་གྱུར་པའི་བདག་ཉིད་ཡོད་པས།",
    "དེ་ལ་གཉིས་པོ་ཡོད་མ་ཡིན་། ཞེས་བྱ་བ་གསུངས་སོ།",
    "ཡང་དག་པ་མ་ཡིན་པ་ཀུན་རྟོག་པ་ཙམ་ཡོད་པར་དགོངས་པའོ།",
    "བདག་མེད་པ་ཡང་དག་པར་བསྟན་པའི་ཕྱིར།",
    "སྟོང་པ་ཉིད་ནི་འདི་ལ་ཡོད་ཅེས་བྱ་བ་གསུངས་སོ།",
    "བསྒྲིམ་མི་དགོས་པར་སྲོག་ཆགས་ཐམས་ཅད་ཐར་བར་འགྱུར་རོ་ཞེ་ན།",
    "རྣམ་པར་བྱང་བའི་མཚན་ཉིད་བསྟན་པའི་དོན་དུ།",
    "ཅེས་རྒྱ་ཆེར་གསུངས་སོ།",
    "འདི་འཁྲུལ་པའི་མཚན་ཉིད་དུ་ཇི་ལྟར་ཤེས་པར་བྱ་ཞེ་ན་འདི་ལྟར་དེ་ལ་གཉིས་པོ་ཡོད་མ་ཡིན།",
    "བདག་ཉིད་དུ་མེད་པར་གཟུང་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "༥༩བ་དང་འཛིན་པའི་རྣམ་པར་སྣང་བས་འཁྲུལ་པའི་ངོ་བོ་ཉིད་དུ་མངོན་ནོ།",
    "ད་ནི་རྣམ་པར་བྱང་བའི་ངོ་བོ་བརྟག་པའི་ཕྱིར།",
    "ཅེས་བྱ་བ་གསུངས་སོ།",
    "སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་ནི་རྣམ་པར་བྱང་བའོ།",
    "སྟོང་པ་ཉིད་ཀྱིས་རབ་ཏུ་ཕྱེ་བས་ལམ་དང་འགོག་པ་དག་ཀྱང་འདིར་བསྡུ་བར་རིག་པར་བྱའོ།",
    "གལ་ཏེ་གཉིས་པོ་མེད་ན་ཅིའི་ཕྱིར་དེ་ཡོད་པར་འཇིག་རྟེན་འཁྲུལ་པར་གྱུར་ཞེས་དྲིས་པ་དང་།",
    "དེའི་ཕྱིར་དེ་ལ་ཡང་ནི་དེ་ཡོད་དོ་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པའོ།",
    "གླང་པོ་ཆེ་ལ་སོགས་པར་སྣང་བ་ལྟ་བུའོ།",
    "ཇི་ལྟར་འདི་ལ་གཟུང་བ་དང་འཛིན་པར་ཀུན་རྟོག་པ་དེ་བཞིན་དུ་མེད་པར་སྟོན་ཏོ།",
    "ཁྱད་པར་ནི་གཟུང་བ་དང་འཛིན་པར་རྣམ་པར་རྟོག་པའོ།",
    "དེ་ལ་གཟུང་བར་རྣམ་པར་རྟོག་པ་ནི།",
    "འཛིན་པར་རྣམ་པར་རྟོག་པ་ནི་བདག་དང་རྣམ་པར་རིག་པར་སྣང་བའོ་། གཉིས་པོ་ནི་གཟུང་བ་དང་འཛིན་པའོ་ཞེས་བྱ་བ་དེ་ལ་ིགཟུང་བ་ནི་གཟུགས་ལ་སོགས་པའོ།",
    "དེ་ཆུ་ཁམས་ལ་སོགས་པ་བཞིན་དུ་རྟོགས་པར་མི་རུང་ངོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དེས་སྟོང་པར་ཡང་དག་པར་རྗེས་སུ་མཐོང་ངོ་ཞེས་བྱ་བ་ལ།",
    "དེའི་ཕྱིར་ཡང་དག་པ་མ་ཡིན་པ་ཀུན་རྟོག་པ་ལ་གཉིས་ཀྱིས་སྟོང་པར་མཐོང་ངོ།",
    "དེ་གཉི་ག་ཡང་འདིར་ཡོད་པར་མ་སྐུར་བ་དང་།",
    "སྒྲོ་བཏགས་པ་མེད་པར་མཐོང་ན་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་རབ་ཏུ་ཤེས་སོ།",
    "དེ་ལ་ཡང་དག་པ་མ་ཡིན་པ་ཀུན་རྟོག་པ་ལ་གཉིས་པོ་མེད་པར་མཐོང་བའི་ཕྱིར་སྒྲོ་མི་འདོགས་སོ།",
    "ཡང་དག་པ་མ་ཡིན་པ་ཀུན་རྟོག་པ་དང་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "༥༡༡སྟོང་པ་ཉིད་ཡོད་པར་མཐོང་བའི་ཕྱིར་ཏེ།",
    "སྟོང་པ་ཉིད་ཀྱི་མཚན་ཉིད་ཕྱིན་ཅི་མ་ལོག་པར་བསྟན་པ་ཡིན་ནོ།",
    "སྟོང་པ་ཉིད་མེད་པར་འགྱུར་རོ།",
    "སྟོང་པ་ཉིད་མེད་པར་འགྱུར་རོ།",
    "དཔེར་ན་དགེ་སློང་རྣམས་ཀྱིས་གཙུག་ལག་ཁང་བཞིན་དུ་གཞན་གྱིས་གཞན་སྟོང་པར་མཐོང་ཞེ་ན།",
    "དཔེར་ན་ཐག་པ་ལའམ་སྒྱུ་མ་ལ་ིབདག་ཉིད་ཀྱིས་མེད་པར་སྦྲུལ་གྱི་རྣམ་པ་དང་སྐྱེས་བུ་ལ་སོགས་པ་ལྟ་བུར་སྣང་བ་དེ་ལ་ཁ་ཅིག་འཛིན་པ་བཟློག་པའི་ཕྱིར།",
