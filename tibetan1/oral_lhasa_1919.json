    "དེ་ཉིད་རབ་ཏུ་བསྟན་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "ལོག་པར་སྣང་བའི་ཕྱིར་ཇི་ལྟར་མཐུན་པར་འཛིན་པ་ཉིད་དུ་མེད་དོ།",
    "རྣམ་པར་རིག་པ་གཞན་གྱིས་ཀུན་བརྟགས་པའི་བདག་ཉིད་ཀྱིས་ཐམས་ཅད་སྟོང་པས་གཟུང་བ་ཉིད་དུ་མེད་དོ།",
    "རྣམ་པར་སྣང་བ་གང་ཡིན་པ་དེ་ནི་འཁྲུལ་པ་ཞེས་བྱ་སྟེ་སྒྱུ་མ་བཞིན་ནོ།",
    "ཙམ་ཞེས་བྱ་བའི་སྒྲ་ནི་དེ་ལས་ིལྷག་མ་རྣམ་པར་གཅད་པའི་ཐ་ཚིག་སྟེ།",
    "དེ་ནི་འདི་སྐད་དུ་འཁྲུལ་པའི་རྣམ་པར་ཤེས་པ་ཡོད་དོ།",
    "ཡེ་མེད་པ་མ་ཡིན་ནོ་ཞེས་བསྟན་པར་འགྱུར་རོ།",
    "འཁྲུལ་པའི་རྣམ་པར་ཤེས་པ་དེ་གཟུང་བ་དང་འཛིན་པ་མེད་པ་བཞིན་དུ་མེད་པ་ཉིད་དུ་ཅིའི་ཕྱིར་མི་འདོད།",
    "རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ཀྱི་ཡུལ་ལས་འདས་པའི་ཕྱིར།",
    "སུས་ཀྱང་དེ་ཡོད་པ་ཉིད་དུ་བརྟག་པར་མི་ིནུས་སོ་ཞེས་བསམས་པའོ་ཞེ་ན་འདི་ལྟར།",
    "སྔར་བཅིངས་པ་ལས་གྲོལ་ལོ་ཞེས་བྱ་ིན་གྲོལ་བ་ཡང་མེད་པར་འགྱུར།",
    "ཡང་ན་ཡེ་མེད་པར་ཅིའི་ཕྱིར་མི་འདོད་ཅེས་གཞན་དེ་སྙམ་དུ་སེམས་པ་བསལ་བའི་ཕྱིར།",
    "ཅེས་གསུངས་ཏེ།",
    "གལ་ཏེ་ཇི་ལྟར་གཟུང་བ་དང་འཛིན་པ་ཉིད་དུ་ཕྱུགས་ཡན་ཆད་ལ་སྣང་བ་ཡང་གལ་ཏེ་དེ་བཞིན་དུ་དོན་དམ་པར་འགྱུར་ན་ནི།",
    "དེ་ལྟར་ན་མྱ་ངན་ལས་འདས་པ་ཡང་མེད་པར་འགྱུར་རོ།",
    "རྟག་ཏུ་རྣམ་པར་བྱང་བར་འགྱུར་རོ།",
    "གཟུང་བ་དང་འཛིན་པ་རང་བཞིན་གྱིས་སྟོང་པ་ལས་ཡང་དག་པ་མ་ས་༥ ༢ ༡དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "ཡིན་པར་ཡང་ཡོད་པར་ཡོངས་སུ་རྟོག་པས་ཀུན་བརྟགས་པ་ཞེས་བྱའོ།",
    "དེ་ནི་འདུས་མ་བྱས་པས་མི་འགྱུར་བར་ཡོངས་སུ་གྲུབ་པའོ།",
    "དེ་ལྟར་ཡང་དག་པ་མ་ཡིན་པ་ཀུན་རྟོག་པའི་ཕྱིར་དང་གཉིས་པོ་མེད་པའི་ཕྱིར་རོ་ཞེས་བརྗོད་པར་བྱའོ།",
    "བདག་དང་རྣམ་པར་རིག་པ་རྣམས་ཏེ།",
    "དེ་ཡང་རྣམ་པར་བརྟགས་པའི་རང་བཞིན་དུ་ཡང་དག་པ་མ་ཡིན་པ་ཀུན་རྟོག་པ་ལ་མེད་པས།",
    "རྣམ་རྟོག་རྣམ་པར་མི་རྟོག་ནི།",
    "ཕྱིན་ཅི་མ་ལོག་པར་ཡོངས་སུ་གྲུབ་པས་ཡོངས་སུ་གྲུབ་པའི་ཕྱིར།",
    "འདིར་ནི་ཡང་དག་པ་མ་ཡིན་པ་ཀུན་རྟོག་པ་གཉིས་དང་བྲལ་བ་ཉིད་གཟུང་བ་དང་འཛིན་པ་མེད་པར་བསྟན་པ་ཡིན་གྱི།",
    "དེ་ལྟར་བྱས་ན་ཡང་དག་པ་མ་ཡིན་པ་ཀུན་རྟོག་པ་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "ཡོངས་སུ་ཤེས་པར་བྱ་བ་མངོན་དུ་བྱ་བའི་དངོས་པོ་ཡང་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ལྟ་བས་ན་མེད་པའི་མཚན་ཉིད་ཡོངས་སུ་ཤེས་པར་བྱ་བ་དང་།",
    "ཞེས་རྒྱ་ཆེར་གསུངས་སོ།",
    "གནས་ཀྱི་ཁྱད་པར་མཁས་པ་རྣམ་པ་གཉིས་སོ།",
    "དེ་ཉེ་བར་མཚོན་པའི་དོན་དུ་ཚིགས་སུ་བཅད་པ་འདི་གསུངས་སོ།",
    "རྣམ་པར་རིག་པ་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "དམིགས་པའི་དོན་དང་བྲལ་བ་འདི་ནི་རྣམ་པར་རིག་པ་ཙམ་ཉིད་དེ།",
    "གཟུང་བ་མི་དམིགས་པར་རབ་ཏུ་འཇུག་གོ།",
    "རྣམ་པར་ཤེས་པ་སྐྱེ་བའི་ཚེའམ།",
    "སྐྱེས་ཟིན་པས་ཡུལ་ལ་དམིགས་པར་འགྱུར་གྲང་ཅིན།",
    "དེ་ལ་སྐྱེ་བའི་ཚེ་ནི་མེད་པས་སྐྱེ་བའི་ཚེ་ཡུལ་ལ་དམིགས་པར་མི་རུང་ངོ།",
    "ཡུལ་དུ་སྣང་བའི་བདག་ཉིད་དུ་སྐྱེ་བ་མ་གཏོགས་པར།་",
    "གང་བྱེད་ན་རྣམ་པར་ཤེས་པ་ཡུལ་ལ་དམིགས་པའོ་ཞེས་བྱའོ་ཞེས་བྱ་བའི་རྣམ་པར་ཤེས་པའི་བྱ་བ་གཞན་མེད་དོ།",
    "གལ་ཏེ་ཡང་ད་ལྟར་གྱི་རྣམ་པར་ཤེས་པ་ཉིད་ཀྱི་དམིགས་པ་བྱེད་པ་ཡིན་གྱི།",
    "ཡུ་དེ་ལྟ་ན་ནི་དམིགས་པའི་རྐྱེན་རྣམ་པར་ཤེས་པའི་སྐྱེ་བ་མ་ཡིན་ཏེ།",
    "ད་ལྟར་གྱི་དམིགས་པ་འཛིན་ན་ནི་སྐད་ཅིག་པ་འཇིག་པའི་གནོད་པར་འགྱུར་རོ།",
    "རྣམ་པར་ཤེས་པས་དམིགས་པ་འཛིན་པར་མི་རུང་ངོ།",
    "དེ་ལ་རང་བཞིན་བྱེ་བྲག་ཏུ་གྱུར་པར་འདོད་ན།",
    "གཞན་ནི་འགག་པའི་ཚེའི་དོན་ཉིད་སྐྱེ་བའི་ཚེའི་རྣམ་པར་ཤེས་པའི་དམིགས་པའི་རྐྱེན་ཉིད་ཡིན་ཏེ།",
    "༧ ཝིའི་༡༣༩རྐྱེན་ལྷག་མ་རྣམས་ལས་ཁྱད་པར་ཅན་ནོ་སྙམ་དུ་སེམས་ཏེ།",
    "དེ་གཉི་ག་ཡང་དམིགས་པར་མི་འགྱུར་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ཐམས་ཅད་ནི་བུམ་པ་དང་།",
    "དོན་གྱི་རྣམ་པ་གཞན་དུ་སྣང་བའི་རྣམ་པར་ཤེས་པའི་དམིགས་པ་ནི་གཞན་མ་ཡིན་ཏེ།",
    "སིལ་བུ་དེ་ནི་དེ་དག་སོ་སོ་ཉིད་ལ་དམིགས་པར་འདོད་ཀྱི།",
    "བརྟགས་པར་ཡོད་པ་ནི་རྒྱུར་མི་སྲིད་པའི་ཕྱིར།",
    "དེ་མ་ཐག་པ་ལ་སོགས་པའི་རྐྱེན་ལྟར་དམིགས་པའི་རྐྱེན་ཡང་དག་པར་ཤེས་པའི་རྒྱུར་འདོད་དེ།",
    "རྨི་ལམ་ལ་སོགས་པ་ལ་ཡང་རྣམ་པར་ཤེས་པ་དམིགས་པ་མེད་པར་གྲུབ་པོ།",
    "བཞིན་ལ་སོགས་པ་མེད་པར་དེའི་གཟུགས་དབུས་དང་མཐའ་རྣམ་པར་འབྱེད་པའི་འགྲེལ་བཤད།",
    "རྣམ་པར་ཤེས་པ་ཉིད་དོན་དུ་སྣང་བ་ོདོན་གྱི་གཟུགས་བརྙན་ཏེ།",
    "རྣམ་པར་ཤེས་པ་ཉིད་དོན་གྱི་རྣམ་པར་གདོན་མི་ཟ་བར་ཁས་བླང་དགོས་སོ།",
    "རྣལ་འབྱོར་པ་རྣམས་ཀྱི་མི་སྡུག་པ་ལ་སོགས་པར་དམིགས་པའོ་སྙམ་དུ་སེམས་ཏེ།",
    "དོན་མྱོང་བ་ནི་རྨི་ལམ་གྱི་རྣམ་པར་ཤེས་པའི་ཡུལ་ཉིད་དུ་འདོད་དོ།",
    "བརྡ་མི་ཤེས་པས་མིང་རྣམ་པར་མི་ཤེས་པའི་ཕྱིར་གཞན་ལ་བསྙད་མི་ནུས་སོ།",
    "འདས་པ་དང་མ་འོངས་པ་དང་ད་ལྟར་གྱི་འཛིན་པར་ཡང་རྨི་ལམ་དང་གཉིད་ཀྱིས་མ་ལོག་པར་ཁྱད་པར་མེད་དོ།",
    "རྣམ་པར་རིག་པ་ཙམ་ཡང་མི་དམིགས་པ་སྐྱེ་སྟེ་ཞེས་བྱ་བ་ནི།",
    "ཇི་ལྟར་རྣམ་པར་ཤེས་པ་ལས་ཕྱི་རོལ་ན་ཀུན་བརྟགས་པའི་གཟུང་བ་མེད་པས་རྣམ་པར་རིག་པ་ཙམ་ཉིད་ཀྱི་སྟོབས་ཀྱིས་གཟུང་བ་མེད་པར་འཇུག་པ་དེ་ལྟར་གཟུང་བ་མེད་པའི་སྟོབས་ཀྱིས་རྣམ་པར་རིག་པ་ཙམ་ཡང་མེད་པར་ཁོང་དུ་ཆུད་དོ།",
    "གཟུང་བ་ཉིད་ལ་ལྟོས་ཏེ་དེ་འཛིན་པར་རྣམ་པར་གཞག་པའི་ཕྱིར།",
    "གཟུང་བ་མེད་ན་འཛིན་པར་མི་རུང་ངོ།",
    "ཅིའི་ཕྱིར་ཐོག་མ་ཉིད་དུ་རྣམ་པར་རིག་པ་ཙམ་ཉིད་མེད་པར་རྣམ་པར་མི་གཞག་ཅེ་ན།",
    "འཛིན་པ་ནི་གཟུང་བ་ལ་རག་ལས་པའི་ཕྱིར་དམིགས་པར་བྱ་བའི་དོན་མེད་ན།",
    "དམིགས་པའི་ངོ་བོའི་དངོས་པོ་འཇིག་པས་བདེ་བླག་ཏུ་འཇུག་པར་འགྱུར་གྱི།",
    "རྒྱུན་མི་འཆད་པར་ཚོགས་རྣམས་ལ་ཞུགས་ཏེ།",
    "གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་ལས་འདས་པའི་ཡེ་ཤེས་ཀྱིས་འདིར་ཆུད་དེ།",
    "འདི་ལྟར་རྣམ་པར་རིག་པ་ཙམ་འདི་ལ་བརྟེན་ནས།་",
    "དེའི་འོག་ཏུ་གཟུང་བ་མ་ལུས་པར་མི་དམིགས་པས་འཛིན་པ་མི་དམིགས་པ་དང་མཐུན་པ་བཟོད་པ་ཞེས་བྱ་བའི་ཏིང་ངེ་འཛིན་ཏོ།",
    "ཅེས་བྱ་བ་གསུངས་སོ།",
    "ཅེས་བྱ་བ་གསུངས་སོ།",
    "དམིགས་པར་བྱ་བའི་དོན་གྱི་དངོས་པོ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་འགྲེལ་པ་མཛད་པས་དམིགས་པར་བྱ་བའི་དོན་མེད་ན་དམིགས་པར་མི་རུང་བའི་ཕྱིར་རོ་ཞེས་བྱ་བ་སྨོས་སོ།",
    "དེ་ལྟ་བས་ན་དམིགས་པ་དང་མི་དམིགས་པ་མཉམ་པར་ཤེས་པར་བྱ།",
    "དོན་མི་དམིགས་པ་དང་རྣམ་པར་རིག་པ་ཙམ་དུ་དམིགས་པ་ཡང་མེད་པར་བྱེ་བྲག་མེད་པའི་ཕྱིར་མཚུངས་པ་ཉིད་དུ་ཤེས་པར་བྱའོ།",
    "དེའི་ཕྱིར་དོན་དམ་པར་མི་དམིགས་པའི་ངོ་བོ་ཉིད་ཀྱང་ཡིན་པས་འགལ་བ་མེད་དོ།"
  ]
}