    "ཚོ་ལགས་ག་འ་༡༧། རྒྱ་གར་སྐད་དུ།",
    "སྟོན་པ་འགྲོ་བ་རྣམས་ཀྱི་མིག་གཅིག་ཏུ་གྱུར་པ་ཡོངས་སུ་མྱ་ངན་ལས་འདས་པ་ན་བདག་ཅག་ལྟ་བུའི་གདུལ་བྱའི་སྐྱེ་བོ་ཡོངས་སུ་གཟུང་བར་བཞེད་ནས་ཡུན་རིང་པོར་གནས་པའི་དོན་དུ་གང་སྡུད་པ་པོས་ཡང་དག་པར་བསྡུས་པ་ཡིན་ནོ།",
    "གང་ལ་དོན་དང་ལྡན་པའི་མིང་རྣམ་པར་ཤེས་པར་བྱ་བའི་དོན་དུ་ཚིགས་སུ་བཅད་པ་ཉེ་བར་བཀོད་དེ།",
    "དོན་དང་ལྡན་པའི་མིང་རྣམ་པར་ཤེས་པས་ནི་བསྟན་བཅོས་ཉན་པ་པོ་རྣམས་ཀྱིས་གུས་པ་དང་བཅས་པས་འཇུག་པའི་ཡུལ་དུ་ཉེ་བར་འགྲོ་བར་བྱེད་དོ།",
    "འདི་ལྟར་ཡང་འདིར་དོན་གྱི་རྗེས་སུ་འགྲོ་བར་ཁོང་དུ་ཆུད་པར་བྱ་སྟེ།",
    "དཔུང་པའི་ཡན་ལག་ལ་སོགས་པ་མཛེས་པར་བྱེད་པ་ན་འཇིག་རྟེན་ལ་མཆོག་ཏུ་དགའ་བ་ཉེ་བར་སྐྱེད་པ་དེ་བཞིན་དུ།",
    "འཇུག་པ་ན་ཅི་ཡོད་པར་གྱུར་པའམ།",
    "ཡོད་པར་གྱུར་པ་མ་ཡིན་ནམ།",
    "༩ བསྟན་བཅོས་མཛད་པས་དབྱངས་ཀྱིང་བསྙད་པ་ལ་སོགས་པ་རྣམ་པར་གཅད་པའི་ཕྱིར་འདིར་བསྒྲུབ་པའི་སྒྲ་ལྷག་པར་བརྗོད་པ་མཛད་པ་ཡིན་ནོ།",
    "སེམས་ཙམ། ཕིའི་༡༣༩ ཤེས་པ་ཤེས་པའི་དོན་ཁོང་དུ་ཆུད་པར་བྱའོ།",
    "བསྒྲུབ་པར་བྱ་བ་ཡིན་པས་བསྒྲུབ་པ་ཞེས་ལས་སུ་སྒྲུབ་པ་ནི་ཤེས་པར་བྱ་བའི་ངོ་བོ་ཡིན་ནོ།",
    "དེ་བསྟན་པ་སྟེ་བསྟན་པར་ཤེས་པར་བྱའོ།",
    "གང་ཞིག་གང་ལ་ཐེ་ཚོམ་ཟ་བ་དེ་ལ་དེ་དོན་ངེས་པར་བྱ་བའི་ཕྱིར་བསྟན་པའི་ཕྱིར་རོ།",
    "༤༥༧བརྒྱན་པར་བྱ་བ་ཉིད་ཡིན་ཞེ་ན།",
    "དེས་མཁས་པ་རྣམས་ལ་དགའ་བ་སྐྱེད་པར་བྱེད་པའི་ཕྱིར།",
    "བརྒྱན་པར་བྱེད་པ་དེའི་ཡུལ་ཉིད་དུ་གྱུར་པའི་དོན་ཇི་ལྟར་ན་བརྒྱན་པར་བྱ་བའི་བདག་ཉིད་དུ་འགྱུར་བ་མ་ཡིན།",
    "དོན་འདི་ཉིད་བསྟན་བཅོས་མཛད་པས་གསེར་ལས་བརྡུངས་བྱས་འདྲ་ཞིང་ཞེས་བྱ་བ་ལ་སོགས་པས་དཔེ་ཉེ་བར་བཀོད་པ་སྔོན་དུ་འགྲོ་བས།",
    "དེ་ལྟ་བས་ན་དོན་སྟོན་རབ་ཏུ་བྱེད་པ་ཞེས་བྱ་བ་ནི་འདིར་དོན་བརྒྱན་པར་བྱེད་པའི་དོན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་ལྟར་ན་སུ་ཞིག་བརྒྱན་པར་བྱེད།",
    "ཅི་ཞིག་བརྒྱན་པར་བྱེད་ཅེས་བྱ་བའི་དོགས་པ་གཉིས་བསལ་ནས།",
    "ཅི་ཞིག་བྱེད་ཅེས་གདོན་པར་རྣམ་པར་བརྟགས་པ་དེས་ནི།",
    "རྟོག་པ་མེད་པ་ཉིད་དུ་ཁོང་དུ་ཆུད་པར་བྱེད་དོ།",
    "སྒྲ་ཇི་བཞིན་པར་ཤེས་པ་ཉིད་ཀྱང་།",
    "དེ་ལྟ་བུས་སུ་ཞིག་བརྒྱན་པར་བྱེད་ཅེས་བྱ་བ་ལ་སོགས་པ་དག་རྣམས་ནི་ཇི་ལྟར་རྣམ་པར་གཞག་པར་ཉེ་བར་བསྟན་པ་ཉིད་བཟང་བ་དང་།",
    "བརྒྱན་ཉིད་ནི་དེ་ཉེ་བར་སྟོན་པར་གྱུར་པའི་བསྟན་བཅོས་འདི་ཡིན་པར་བརྗོད་པ་ཡིན་ནོ།",
    "༤༥༩པར་ཅན་གྱིས་བྱེད་པ་ངེས་པར་སྒྲུབ་པ་འདི་ལ།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པ་དག་མ་ཚང་ན་རྣམ་པ་གཞན་དུ་ཉེ་བར་སྟོན་པ་སྲིད་པའི་ཕྱིར།",
    "དེ་ཚང་བར་ཡོད་པ་ཡིན་པས་ཇི་ལྟར་ན་ཕྱིན་ཅི་ལོག་ཏུ་ཉེ་བར་སྟོན་པར་འགྱུར།",
    "ངེས་པའི་ཚིག་སོ་སོ་ཡང་དག་པར་རིག་པ་ཚང་བ་ཉིད་དོ།",
    "སྤོབས་པ་སོ་སོ་ཡང་དག་པར་རིག་པ་ཚང་བ་ཉིད་དུ་བསྟན་ཏོ།",
    "དེའི་ཕྱིར་གང་ཡང་རུང་བ་བསྟན་པར་བྱ་བ་ཉིད་ཡིན་ན།",
    "ཅིག་ཅར་གཉི་གར་སྟོན་པར་བྱེད་ཅེ་ན།",
    "འདིར་ཚོགས་ནི་བརྗོད་པའི་ཚོགས་ཡིན་པར་རིག་པར་བྱའོ།",
    "༡༣༩ཀྱང་ཁོངས་སུ་གཏོགས་པའི་ངག་ཡང་དག་པར་བསྡུས་པའི་བདག་ཉིད་ཡིན་པའི་ཕྱིར་དང་།",
    "དོན་རྟོགས་པའི་སྒྲུབ་པར་བྱེད་པ་ཉིད་ཀྱི་ཅིངག་ཉིད་ནི་འདིར་ཚིག་ཡིན་པའི་ཕྱིར་རོ།",
    "རྣམ་པར་རིག་པར་བྱེད་པ་ནི།",
