    "སྤོས་དཀར་ཐལ་ཀ་རྡོ་རྗེ་སོ་མ་ར།",
    "ཤུ་དག་ཐལ་ཀ་རྡོ་རྗེ་སོ་མ་ར།",
    "རྒྱ་ཚྭ་སྦྱར་ལ་ཆུ་སྐོལ་ཚན་མོས་དབུལ།",
    "གུ་གུལ་གི་ཝཾ་ལུག་མིག་ནག་པོ་དུར་བྱིད་ཆུ་རྩ་མ་ནུ་པུཥྐར་སྟག་ཤ།",
    "ལྷེན་སྐྲན་བུད་མེད་མངལ་སྐྲན་འཇིག་པར་བྱེད།",
    "ཀ་པེད་མོན་ཆ་ར་དང་ཙི་ཏྲ་ཀ།",
    "མོར་གསར་སྦྲང་རྩི་སྦྱར་བའི་ལྡེ་གུ་ཡིས།",
    "ཛཱ་ཏི་ལྕགས་ཕྱེ་སྟར་བུ་ཕུར་མོ་གསར།",
    "མཚལ་དང་ཡུང་བ་གི་ཝང་རྒྱ་སྐྱེགས་ཤིང་།",
    "ཚོས་པའི་ཚད་ཡིན་ཐལ་ན་ནུས་བ་འཚིག།",
    "ཆོད་བར་དཀྲུགས་ལ་ཐོ་རངས་ཁམ་རེ་གཏང་།",
    "ཙནྡན་ག་བུར་གི་ཝང་ཚད་པ་སྦྱོང་།",
    "དུང་ཐལ་རྒྱ་ཚྭ་སྦྲུལ་ཤས་སྦོས་པ་སྦྱོང་།",
    "སྤོས་དཀར་ཐལ་ཀ་རྡོ་རྗེ་སོ་མ་ར།",
    "ཐར་ནུ་ཆུ་རྩ་ཧོང་ལེན་རེ་ལྕག་བཞི།",
    "ཆུ་སྐོལ་ལྕག་གིས་བསྐུལ་ལ་སྦྱང་བར་བྱ།",
    "འབྲས་སམ་ཕྱེ་ཐུག་སླ་མོ་རྐྱང་རྐྱང་བོ།",
    "དེ་ནས་མགོ་དཔྱང་པུས་མོས་ཕོ་ཁར་ལྟེམ།",
    "བསྐུ་མཉེ་གསུར་དང་སྲེ་ལོང་ཐང་གིས་ལྡོག།",
    "རྩེ་མོར་མར་བྱུགས་གྲོད་པའི་དབུགས་བཏོན་ལ།",
    "དུར་བྱིད་གོང་སྟེང་བསྣན་པ་བཀྲུ་འཇམ་མོ།",
    "གཏང་ཐབས་ཁྱོར་གང་ཕུལ་ཕྱེད་ཕུལ་གང་གཏང་།",
    "སྔོན་འགྲོ་ཐང་གིས་ཁྲག་ངན་ཕྱེད་ལ་གཏར།",
    "ལག་པ་གྲེ་མོ་གོང་དུ་སོར་གསུམ་བསྙལ།",
    "སྔོ་དམར་རི་མོ་བྱུང་ན་ཐང་རྗེས་གཏར།",
    "གཉའ་རེངས་ལྟག་དགྱེ་འགྱུར་དཀའ་ལྟག་རྩ་གཏར།",
    "མ་ཐུབ་ཨ་ས་མོ་ཡི་སྣུམ་དུགས་བྱ།",
    "རྩ་བ་བརྟན་ལ་རྩེ་མོ་མེ་ལེན་མྱུར།",
    "ཚིགས་པའི་མཁར་ལ་མཛུབ་མོའི་རྩེ་མོ་ཙམ།",
    "མི་རུང་ཁྲག་མཁྲིས་ཕོ་མོའི་སྲིད་རྩར་སྤང་།",
    "ལྟེ་བའི་གཡས་གཡོན་མཚོན་རེ་ལོང་གི་ཐེར།",
    "དེ་ནས་གཡས་གཡོན་མཚོན་རེ་ལོང་སྐྲན་ལ།",
    "ནང་ལོང་ཐད་དྲང་སྟེང་གི་ཆུ་བར་བསྲེག།",
    "གུང་མོས་གར་སླེབས་བརླ་ཡི་ཕྱི་སུལ་བསྲེག།",
    "ལྟག་རེངས་རླིག་སྐྲངས་སྨྱོ་འབོག་སྤུ་འབོག་སྤུ་སྐྱེས་བསྲེག།",
    "བྱིས་པའི་མེ་ལ་སྤྲ་བ་རེ་རེ་གདབ།",
    "བསྲེག་ལེགས་ཁོད་སྙོམས་ཆུ་ལྦུར་ཕྲ་མོས་བསྐོར།",
    "རེངས་འཁུམས་རྨ་ཡི་སྐྲངས་དང་སྐམ་སྦོས་ལའོ།",
    "རྨ་རྣན་སྐྲངས་དང་ཞ་རེངས་འཁུམས་པ་སེལ།",
    "གྲང་སེལ་ར་དུག་རེའུ་ལྕག་སྤྱང་ཚེར་བ།",
    "ཆུ་རྒྱུས་རེངས་འཁུམས་ལུག་གི་སློ་ཡི་ལུམས།",
    "རེའུ་ལྕག་དྲི་ཆུར་བཙོས་པས་འབྲས་ལ་ཕན།",
    "མཚོན་ཁྲག་འཁྱོགས་ལ་ཆུ་རྡོ་བསྲོས་ལ་བདུག།",
    "ཚིལ་འབྲི་མོག་བྱུག།",
    "སྨྱོ་འབོག་གཉིད་ཡེར་རེངས་ལ་འབྲུ་མར་བྱུག།",
    "རྣག་གི་སྣ་འདྲེན་ཟུག་གཟེར་ཐམས་ཅད་གཅོགཡུངས་ཀར་ཤུ་དག་རྒྱམ་ཚྭ་སེང་ཕྲོམ་སྦྱར།",
    "རུ་རྟ་ཆུ་མ་རྩི་དང་རེའུ་ལྕག་ཐལ།",
    "ཁྱོར་རེ་གསུམ་ཡར་ལྟོ་སྟོང་དག་ལ་གཏང་།",
    "ཉེ་བའི་སྔོན་འགྲོ་གཏོང་བའི་ནུབ་མོ་དེ།",
    "གྲང་ཤས་ཆེ་ན་ཆང་གིས་ཕུལ་ལ་གཏང་།",
    "ཚིགས་པ་བཅུ་བཞིའི་གཡས་གཡོན་མཚོན་རེའི་སར།",
    "ལྟེ་བའི་གཡས་གཡོན་མཚོན་རེ་ལོང་གི་ཐེར།",
    "དེ་ནས་གཡས་གཡོན་མཚོན་རེ་ལོང་སྐྲན་གསང་།",
    "སྐྱིལ་ཀྲུང་བཅས་ལ་ལག་མཐིལ་པུས་མོར་གླན།",
    "དེ་ནས་ཕུན་རེ་ཆ་ལག་བཅོ་བརྒྱད།",
    "བལྟ་རེག་དྲི་བས་མི་འགྱུར་ངོས་བཟུང་ལ།",
    "རེག་པ་རྩ་དང་ཤ་དྲོད་སྲ་སྙི་བརྟག།",
    "དྲི་བ་རྒྱུ་རྐྱེན་གང་གིས་བསླང་བ་དང་།",
    "ཤིང་ཚྭ་སྒོག་སྐྱའི་ཐལ་བ་ཨ་རུ་ར།",
    "གི་ཝང་ཨུཏྤལ་ཏིག་ཏ་ལི་ག་དུར།",
    "འཕྱི་བ་གོང་མོའི་ཤ་དང་འབྲུ་རྙིང་ཟན།",
    "ཚྭ་དང་བོང་བ་གྱོ་མོག་བསྲོས་པས་བདུག།",
    "རིགས་ཀྱི་དབྱེ་ན་རེངས་འཁུམས་སྐམས་དང་སྦོས།",
    "པགས་ཞུགས་གས་སྙམ་བྱེད་ཅིང་རེག་པ་རྩུབ།",
    "རྩར་ཞུགས་སྟོང་སྦོས་ཆུ་རྒྱུས་ཞ་རེངས་འཐེང་།",
    "རིགས་རྟགས་རེངས་འཁུམས་དགྱེ་དགུ་བསྐུམས་པ་ཉམས།",
    "རེངས་འཁུམས་སྣུམ་བཅོས་བྱ་ཞིང་ལུམས་ཀྱིས་བདུག།",
    "རྒྱམ་ཚྭ་དུར་བྱིད་པི་པི་ལིང་གིས་དྲང་།",
    "ཏིག་ཏུ་གསེར་གྱི་མེ་ཏོག་དུག་མོ་ཉུང་།",
    "མི་དང་ཕག་བྲུན་བསྲེགས་ཐལ་ཀ་ཪ་སྦྱར།",
    "ཟོ་མར་སྒོག་སྐྱ་བྲེ་ཕྱེད་ཚྭ་ཁྱོར་གང་།",
    "སྦྱར་བྱུག་སེན་མོས་ཕྲུག་ཅིང་མེ་ཉིས་བསྲེག།",
    "ཚིམ་བྱེད་མགོ་འཁྱོམ་མིག་ཟི་སྨྲ་མི་ཐོས།",
    "རྒྱམ་ཚྭ་པི་པི་ལིང་གི་སྐྱུགས་ཀྱིས་དྲང་།",
    "པུ་ཤེལ་ཙེ་རྣམས་བསྐོལ་གྲང་ཐང་གིས་འཇོམས།",
    "ཨ་རུ་ར་དང་ཙནྡན་གི་ཝང་དང་།",
    "ད་ཏྲིག་རེ་སྐོན་ཀ་ར་བཏབ་གཏང་གཅོད།",
    "གི་ཝང་དོམ་མཁྲིས་མི་རུས་བཙའ་ཅན་དང་།",
    "ཐལ་བ་པི་པི་ལིང་དང་སྟར་བུ་སྦྱར།",
    "གོང་གི་རྟགས་ལྡན་གསར་བའི་དུས་ཞེས་བྱ།",
    "སྔོ་ངད་མ་ཞུ་ཟྭ་དང་དབྱི་མོང་བསྣན།",
    "ཁ་ཟས་འཇུ་དཀའ་བསིལ་ཕྱོགས་ཚད་ལས་ཐལ།",
    "གྲང་མོ་འཇུ་དཀའ་བཟའ་བ་དྲགས་པ་སྤང་།",
    "ཟས་ཚོད་མ་ཟིན་ཚད་ལས་ཐལ་བར་ཟོས།",
    "དར་བར་ངད་བསད་ཐལ་བར་བྱ་རྒོད་བྲུན།",
    "མ་ཞུ་ལྷེན་སྐྲན་ཐལ་བར་རློག་པར་བྱེད།",
    "བོང་ང་གསེར་གྱི་མེ་ཏོག་དུག་མོ་ཉུང་།",
    "ཟངས་ཐལ་བསེ་རུ་ཛཱ་ཏི་དོམ་མཁྲིས་དང་།",
    "ཤ་རུ་དུར་ཐོད་འགྲོན་ཐལ་སྦྲང་སྦྱར་བསྐམ།",
    "དུ་བ་མ་ཤོར་བསྲེགས་ཐལ་པི་པི་ལིང་།",
    "ལོང་གི་ཁྲག་སྐྲན་སྟར་བུ་ཞོ་བཞི་དང་།",
    "རྟ་སྦངས་ཕུར་མོ་སྒོག་སྐྱ་བསྲེགས་པས་བདུག།",
    "ལ་ཆང་གིས་དབུལ།",
    "དེ་བཞིན་མེ་དྲོད་ཉམས་པ་ཕོ་ལོང་གི།",
    "གསུམ་པ་རྫིང་གི་འོར་ཁུང་བསལ་བ་དང་།",
    "བཞི་བ་མཚོ་མོ་ཡུར་དུ་དྲོང་བའོ།",
    "རྫིང་གི་སྐྱེ་ཆུ་བཞིན་དུ་ཞོར་ལ་སྣོན།",
    "ཤ་རུ་དུར་ཐོད་འགྲོན་བུའི་ཐལ་བ་དང་།",
    "འགྲོན་བུ་དུར་ཐོད་ཤ་ཪུའི་ཐལ་བ་དང་།",
    "རྡོ་དྲེག་དབྱི་མོང་དཀར་བོ་ཨ་རུ་ར།",
    "གསུམ་པ་རྫིང་གི་འོར་ཁུང་བརྟོལ་བ་ནི།",
    "ཡུང་སྐྱེར་དབྱི་མོང་སྲུབ་ཀ་ལྕེ་ཚ་དང་།",
    "བཙོད་དང་རྒྱ་སྐྱེགས་འབྲི་མོག་འབྲས་བུ་གསུམ།",
    "ཚ་ལ་ལི་ཤི་ཤིང་མངར་མོན་ཆ་ར།",
    "ཆང་གིས་ཕུལ་ལ་རྩ་ལྟོ་གཉིས་ནས་སྦྱང་།",
    "བཞི་བ་མཚོ་མོ་ཡུར་དུ་དྲང་བ་ནི།",
    "འགྲོན་ཐལ་ཟངས་ཐལ་བུལ་ཏོག་དན་ཁྲའོ།",
    "པུས་མོ་མན་ཚད་བྱུགས་ལ་དེ་སྟེང་བཅིང་།",
    "མཐེ་བོང་བོར་བའི་སོར་མོ་གསུམ་གྱི་བར།",
    "ཕུག་ཤུལ་དུང་ཐལ་འགྲོན་ཐལ་རྩིབ་བསྲེགས་གླན།",
    "ནས་རེས་ཇེ་དམའ་ཇེ་དམའ་དབུག་པར་བྱ།",
    "ལྕེ་མཆུ་རྙིལ་དང་སེན་མོ་བཞིན་བཀྲག་འཆོར།",
    "ཁྱད་པར་ལྕེ་མཆུ་སེན་མོ་སྐྱ་བ་ཡིན།",
    "ཤ་རུའི་ཐལ་བ་བུར་དཀར་ཆུ་སྐོལ་དབུལ།",
    "གྲང་ཞུམ་རེས་ཡོད་རེས་མེད་ཉི་མ་སྙེག།",
    "འགྲམས་འཁྲུགས་འབྲས་བུ་གསུམ་གྱི་ཐང་གིས་དབྱེ།",
    "འདི་དུས་མི་བསྟེན་ཚ་བ་ལམ་ནས་འཁྱོགས།",
    "ཡུན་དུ་སྨིན་དཀའ་པིག་པན་ཐལ་བ་དང་།",
    "གྲེ་མོ་པུས་མོ་མན་ཆད་ཆུ་ཡིས་བྲན།",
    "དེ་ལ་རྒྱུ་རྐྱེན་མ་མོ་མཁའ་འགྲོ་འཁྲུགས།",
    "ཙནྡན་དཀར་དམར་གི་ཝཾ་གུར་ཀུམ་དང་།",
    "ཀ་ར་སྦྱར་བའི་ཕྱེ་མ་ཐང་གིས་དབུལ།",
    "ཆུ་གྲང་ལྕག་གིས་བྲན་ལ་དག་པར་སྦྱང་།",
    "ཁ་ནང་མཛུབ་མོ་བཅུག་པས་གྲང་མོར་འོང་།",
    "པིག་པན་ཐལ་བ་སེ་འབྲུ་པི་པི་ལིང་།",
    "ཤིང་ཀུན་ཛཱ་ཏི་བིག་པན་ཐལ་བ་དང་།",
    "ཕུགས་ཚོལ་གཙོ་བོ་ཙནྡན་གི་ཝཾ་དང་།",
    "བར་དུ་གྲང་བ་ཐལ་ནས་གནོད་པ་མེད།",
    "ལྕེ་རྙིལ་སེན་མོ་བཀྲག་ཤོར་གློ",
    "ནང་གི་སྣོད་འགྲམས་པ་དང་རྣམ་པ་གཉིས།",
    "བཟང་དྲུག་ག་དུར་ཤིང་ཚ་མོན་ཆ་ར།",
    "བཙོད་ཞུན་འབྲི་མོག་ཨ་རུའི་གདུས་ཐང་གཏང་།",
    "གཟེར་སྟེང་ཚན་དང་ཞོ་སྦྱར་གྲང་མོས་བདུག།",
    "ཅུ་གང་ཀ་ར་སྐྱུ་རུའི་ཐང་གིས་དབུལ།",
    "སེར་དུགས་དོམ་མཁྲིས་ལི་ཤི་དུག་མོ་ཉུང་།",
    "སེར་ལ་དྭངས་ན་ཏིག་ཏ་དུག་མོ་ཉུང་།",
    "ཀ་ར་གི་ཝཾ་ཁུས་དབུལ་གཤའ་རིངས་གཏར།",
    "མོན་ལུག་གླ་སྒང་བྲག་ཞུན་ཨ་རུ་ར།",
    "ག་བུར་གི་ཝཾ་བསེ་རུ་ཁུ་བས་སྦྱང་།",
    "མ་མོ་མཁའ་འགྲོ་འཁྲུགས་དང་ཟས་སྤྱོད་ལོག།",
    "ཛཱ་ཏི་ཞོ་ཤ་སྒོག་སྐྱའི་ཐལ་བ་གསུམ།",
    "སྨིན་ནས་བཟང་དྲུག་སླེ་ཏྲེས་སྒོག་སྐྱའི་ཐལ།",
    "སྨིན་ནས་ག་བུར་ཙནྡན་གི་ཝང་དང་།",
    "དུག་མོ་ཉུང་དང་ཀ་ར་སྦྱར་ལ་གཏང་།",
    "གྲང་བས་འཁྲུ་ན་ད་ཏྲིག་མོན་ཆ་ར།",
    "དྲི་མ་འགགས་ན་ལ་ཕུག་ཐལ་བ་དང་།",
    "ཕག་རིལ་ཐལ་བ་དོམ་མཁྲིས་སྦྱར་ལ་གཏང་།",
    "དེ་རྗེས་གོང་གི་ཕྱེ་མ་གཏང་བར་བྱ།",
    "ཀ་པེད་ད་ཏྲིག་སྨུག་དང་མོན་ཆ་ར།",
    "ཐར་ནུ་ཆུ་རྩ་རེ་ལྕག་རྩ་བ་གསུམ།",
    "དེ་ནས་དུག་མོ་ཉུང་དང་བོང་ང་དཀར།",
    "དེ་ཕྱིར་དཀར་དང་མངར་གནོད་དུག་གིས་འཇོམས།",
    "མོ་གག་རྒྱ་ཕོར་ཁ་བུབ་ལྟ་བུ་སྟེ།",
    "གཅད་པ་རྒྱ་ཚྭ་རུ་རྟ་ཤུ་དག་གིདབ།",
    "དེ་ལ་སྣ་བཤལ་གཏང་ལ་ཆུར་རེ་སྦྱོང་།",
    "ཡམ་བུ་ཡུ་མོ་ཞེས་བྱ་རྣམ་པ་བཞི།",
    "རེག་ཆ་ལག་བཅོ་བརྒྱད།",
    "ཡུ་མོ་སྲ་བརྟན་ན་ཟུག་ཆུང་བའམ།",
    "གྀ་བུར་གི་ཝང་བསྣན་ལ་གཏང་བར་བྱ།",
    "དེ་རྗེས་ཐར་ནུ་ཆུ་རྩ་རེ་ལྕག་རྩ།",
    "སྐྱི་བྱེར་སྐྱི་བུད་སླང་དྲེག་མར་དཀར་བྱུག།",
    "གདུས་ཐང་དྲོན་མོ་གཏང་ཞིང་རྔུལ་དུ་གདོན།",
    "གླ་རྩི་ཀ་ར་སྦྱར་ལ་ཆང་གིས་དབུལ།",
    "གི་ཝང་ཙནྡན་དཀར་བོ་ཨ་རུ་ར།",
    "སྔ་དྲོ་དགོངས་མོ་ལྟག་པ་སྤྲད་ལ་གཏང་།",
    "གྲེ་བར་བབས་ན་ནས་ཐུག་ཚ་མོས་བདུག།",
    "ཟུངས་དང་ཆེན་པོ་ཟབ་མོ་ལྔ།",
    "ཕྲན་ཚེགས་ཟས་ཟོས་རྗེས་འབྱུང་མོད་ལ་འཆག།",
    "ཟབ་མོ་ལྟེ་བའི་འོག་ནས་བསྟུད་འབྱུང་གསང་།",
    "དུག་གིས་མདངས་ཉམས་སྟོབས་ཆུང་སེམས་འཁྲུལ་བྱེད།",
    "ཕུལ་དགུར་སོང་ནས་མར་བྲེ་གང་སྦྱར་གདུ།",
    "དུག་གྱུར་དཔའ་བོ་སེར་བོ་བོང་ང་དཀར། ། ལྡུམ་བུ་རེ་རལ་ཡུང་བ་དྲི་ཆུར་བཙོ།",
    "སྲེ་མོང་སྤྲེ་འུ་ཁྱི་དང་རྟའི།",
    "ཙནྡན་གི་ཝང་བོང་ང་དཀར།",
    "སྨད་ན་གནས་ན་སྟར་བུ་དུང་ཐལ་དང་།",
    "སྐེད་པ་སྟག་གིས་བཅད་ཅིང་སྣེ་བཞི་བཅོས།",
    "ལྟེ་ཟུར་གཡས་གཡོན་མཚོན་རེ་བཅལ་བར་སྲེག།",
    "ར་ཡི་གློ་ཁྲག་དྲོན་མོ་གྲོད་པས་གཏུམས།",
    "དེ་སྟེང་ལྟོ་ཚིལ་པགས་པ་དྲོན་མོས་གཡོགས།",
    "སྦང་མའི་འཇིབས་བྱ་གོང་གི་དུ་བས་བདུག།",
    "ཚ་བ་གསུམ་དང་ཟོ་མར་རེང་བུ་གཞུག།",
    "མཁྲིས་གྱུར་བཤལ་བཏང་རྗེས་ལ་དུག་མོ་ཉུང་།",
    "བད་གྱུར་ཐལ་བ་སྦྱར་ལ་སྐྱུགས་ཀྱིས་སྦྱང་།",
    "ཆང་གིས་ཕུལ་ནས་ནང་ནུབ་གཏང་བར་བྱ།",
    "འཕོངས་སུ་མཛུབ་མོ་བཅུག་ལ་ཁ་འཆུས་བསྲུང་།",
    "ཀུན་ལ་གླ་སྒང་མོན་ཆ་ར།",
