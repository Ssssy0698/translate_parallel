    "སྦྱིན་པ་དང་སྙན་པར་སྨྲ་བས་འཁོར་དུ་བསྡུས་པ་རྣམས་དོན་བཟང་པོ་ལ་འགོད་ཅིང་རང་ཡང་དེ་ལ་གནས་པ་དང་།",
    "འུད་དང་གྲགས་སྐམ་ལ་མི་དགྱེས་པས་ཆེ་ཕྲ་སུས་ཀྱང་རང་གཞན་ལ་བསྟོད་སྨད་ཀྱི་ཚིག་དོན་མེད་ཞུས་པ་དང་ལེན་མི་མཛད་པ་དང་།",
    "རྗེ་འདི་ལ་པཎ་ཞྭ་སྣེ་རིང་མནབ་བཞིན་པ་ཞིག་གནང་བ་ཡིན་འདུག་དེ་དུས་ཞལ་ནས།",
    "དེ་དག་ལ་རང་རང་སོ་སོར་བརྩེ་སེམས་དང་།",
    "སྐྱོན་མི་འདུགག་ལེ་བྱས་ནས་མདུན་དུ་འོང་ཆོག་གསུངས།",
    "དེའི་ཕྱི་ཉིན་ཡང་སྐུ་མདུན་དུ་ཡོང་ཆོག་གསུངས་ཀྱང་ཕྱོགས་གཞན་གྱི་འགྲུལ་བ་མང་འདུག་པས་ངེད་རང་ལ་བྲེལ་བ་མེད་ཞུས་པར།",
    "ང་མྱ་ངན་ལས་མི་འདའ་བར་ཧ་ཅང་ཡུན་རིང་འདུག་ཅིང་རྒྱུ་དུ་མཐོང་ན།",
    "དེའི་ནང་ནས་ཉི་མ་འདི་དང་ཐུན་འདི་ཉིད་སྐབས་སུ་བབས་འདུག་པས།",
    "ཟག་བཅས་ཀྱི་བདེ་བ་ཙམ་ཡང་མི་འདུག།",
    "ཡང་དག་པའི་བདེ་བ་གཏན་ནས་མི་འདུག།",
    "བསྒུར་ཙམ་བྱས་ནས་ཅུང་ཟད་འདུག་པ་དང་།",
    "ཧ་ཅང་བྲང་དང་ཉེ་བ་དང་གུམ་གུམ་པོར་འདུག་པ་ལྟ་བུ་མིན་པ།",
    "རྣམ་འགྱུར་གྱི་སྐབས་ལུས་ཀྱི་ཁོག་དྲང་བོར་འདུག་པ་གལ་ཆེ།",
    "ཁོག་སྟོད་སྒུང་བོར་འདུག་པ་དང་།",
    "ངར་བོ་མི་བྱེད་པར་ཞུམ་ཞུམ་པོར་འདུག་པ་སོགས་མི་བྱེད།",
    "དམ་བཅའ་བས་ལུང་དྲང་བོར་འདུག་ཅིང་།",
    "ཁ་ཅིག་དུས་མིན་ཟས་སྤོང་བ་དེ་བསྙེན་གནས་དང་བྱུག་པ་ལ་གཉིས་བྱས་པ་ཡན་ལག་བརྒྱད་ཟེར།",
    "ཁ་ནང་དུ་ཧྲིལ་གྱིས་བཅུག་ཆོག་པ་དགོས་ཞེས་བྲིས་འདུག་པས།",
    "ཀླུ་སྒྲུབ་ལྟ་བུས་ལེགས་ལྡན་ལྟ་བུ་ལ་རྩ་ཤེས་ཚར་གཅིག་གསུངས་ན་ཡང་རང་མཚན་མི་བཞེད་པ་ཅིའི་ཕྱིར་མི་དགོངས།",
    "ཚོགས་པ་ཐམས་ཅད་བཞེངས་པའམ་འདུག་ལ།",
    "ཡོན་བདག་རྣམས་ཐོག་མར་འོང་བ་ནས་ཤིས་བརྗོད་པར་འདུག་དགོས།",
    "ཨོཾ་གནྔྷེ་སྣན་༝༝སྤོས་དཀར་གྱིས་འདུག་པར་བྱའོ།",
    "རྒྱ་མཚོ་འདོམ་འདུན་སོགས་ལས་མི་འཁྲུགས་པ་འདི་ཡང་རང་ལ་སྦྱར་དགོས་གསུངས།",
    "དཀར་པོ་༝༝་རང་རང་རིགས་བདག་བརྒྱན།",
    "འགྲོ་ན་དོན་འགྲུབ་འདུག་ན་བདེ་སྐྱིད་ལྡན།",
    "ཕྱོགས་མཚམས་གར་འགྲོ་གར་འདུག་ཀྱང་།",
    "དགའ་བས་ཚིམ་ནས་རང་རང་གནས་སུ་གཤེགས།",
    "གནོད་མེད་ལོ་ཏོག་དུས་སུ་སྨིན་པར་མཛོད།",
    "ཅེས་པ་འདི་ནི་སྤྱིར་ད་ལྟར་བསང་གྱི་ཆོ་ག་པོ་ཏི་བརྒྱ་ཕྲག་ལོངས་བ་འདུག་པས།",
    "བདེར་འདུག་ནས་ནི་སྒྲ་བསམ་འམ་མི་འགྱུར་བ་ལ་ཡིགེ་བཞག།",
    "དེའི་དབུས་ནའདུག་པར་བྱའོ།",
    "འ་གྲེང་དང་འདུག་དང་མ་ལོག་ཉལ་བ་དང་།",
    "བརྩེ་མེད་རང་རང་རིགས་ལ་བགེགས་ཀྱ་དབྱེད།",
    "དགེ་སློང་དགེ་སློང་མ་དང་རངལྟདགེ་སྙེན་དང་།",
    "ལ་འདུག་པར་བྱེད།",
    "འགྲེང་དང་འདུག་དང་མལོག་ཉལ་བ་དང་།",
    "དེ་དག་འདུག་པ་གསུམ་ཡིན་ནོ།",
    "ཤར་ཕྱོགས་ཁ་བལྟས་ཀུ་ཤའི་སྟན་སྟེར་དུ་འདུག་ནས་ཞེས་བྱ་བ་ནི་སྒྲུབ་པ་བ་ཉིར་དོ།",
    "དེ་དག་འདུག་བ་གསུམ་ཡིན་ནོ་ཞེས་གསུངས་ཏེ།",
    "དེའི་རྗེས་ལ་མལ་ན་འདུག་གཙམ་གྱིས་ཀྱང་ཐམས་ཅང་བསྲུང་བར་འགྱུར་རོ།",
    "མཆོད་རྟེན་ལ་སོགས་པའི་མདུན་དུ་འདུག་པ་དང་།",
    "སེམསཙ་ནཐམསཅད་སྐྲག་པར་བྱེད་པ།",
    "རྨུགས་པར་བྱེད་པའི་ཐབས་ཀྱིས་འདུག་ཏུ་མི་སྟོད་ནས་གསང་སྔགས་ཀྱི་མཐ་ཆེན་བོབསྟན་ནས་མི་གནས་པར་བྱེད་པའི་དོན་ཏོ།",
    "དེ་ཡང་རང་དར་གཞན་གྱི་དོན་བསྟན་པའི་སྒོ་ནས།",
    "ས་དག་གཅད་པར་མི་ནུས་པར་འདུག་སྟེ།",
    "དེ་གཉིས་ཀྱིས་ཀྱང་གནོད་པར་བྱ་བརམི་ནུས་པར་འདུག་སྟེ།",
    "དེ་གསུམ་གྱིས་ཀྱད་གནོད་པར་བྱ་བར་མི་ནུས་པར་འདུག་སྟེ།",
    "དེ་བཞིན་ད་ལྟར་གནོད་པར་བྱ་བར་མི་ནུས་པར་འདུག་སྟེ།",
    "སྐྱེ་བའི་སྡུག་བསྔལ་གྱི་བར་དུ་ཆོད་ཅིང་འདུག་པ་ན།",
    "གནས་པའི་སྡུག་བསྔལ་གྱིས་བར་དུ་ཆོད་ཅིང་འདུག་པ་ལ།",
    "འཚི་བའི་སྡུག་བསྔལ་གྱིས་ཆོད་ཅིང་འདུག་པ་ལ།",
    "བཞི་པོ་དེས་མི་གནོད་པར་འདུག་པ་ལ།",
    "དེ་ལྟར་བསྡུས་ནས་འདུག་པས་བསྒུབསན་འབྲས་བུ་ཡང་འབྱུང་ལ།",
    "སྟོན་པས་ཀྱང་ལན་གཅིག་ལས་མ་གསུངས་པར་འདུག་ལ།",
    "གཟུངས་འདི་བསྡུས་ནས་འདུག་པས་གང་ཟག་འདི་ནི་མི་རྗེད་པའི་གཟུངས་ཐོབ་པདང་ལྡན་པའི་གང་ཟག་གཅི་གཏུ་འདུག་པར་ཤེས་སོ།",
    "འདུག་ཐབས་དང་གསོལ་བ་བཏབ་སྟེ།",
    "ཀུ་ཤའི་སྟེར་དུ་སྙན་བདེ་བ་ལ་ཉེ་བར་འདུག་སྟེ།",
    "སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བར་འདུག་ན།",
    "ལྷའི་དེ་ཁོ་ན་ཉི་ད་དེ་ཡང་དོན་དང་པངར་སྤྲོས་པ་ཐམས་ཅད་དང་བྲལ་བར་འདུག་པར་ཤེས་སོ།"
  ]
}