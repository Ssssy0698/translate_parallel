    "དགའི་སྒོ་ལ་སྦས་ན་འཁོར་དང་བཅས་བ་སྐྱེད་པར་བྱེད་དོ།",
    "སྐྱེ་བས་དབེན་པའི་ས་ཕྱོགས་སུ་གཅིག་པུར་གྱུར་པས་རྗེ་བཙུན་གྱི་ཐང་ཀ་གསལ་བར་བྱས་ཏེ།",
    "མང་ནང་དུ་བྱས་ཏེ་དགྲའི་སྒོ་ལ་སྦས་ན་འཁར་དང་བཅས་བ་ངེས་པར་སྤྲོད་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་འཁོར་ལོ་རྩིབས་བཅུ་གཉིས་པའི་དབུས་སུ་ཚ་བ་གསུམ་དང་དུག་དང་སྐྱེཚེ་རྣམས་རུས་པ་ཆེན་པོའི་སྨྱུ་གུས་མའི་ས་བོན་གྱི་དབུས་སུ་ཚེག་དྲག་དང་བཅས་ཤིང་གྷ་ཡག་གཉིས་ཡང་དག་པར་སྦྱར་ཏེ།",
    "རྒྱལ་པོ་སྒྲུབ་པ་སྟེ་རིམ་པར་ཕྱེ་བ་ལྔ་པའོ།",
    "བ་དན་སྟེང་དུ་བཟུང་བྱས་ན།",
    "ཕ་རོལ་དམག་རྣམས་རྣམ་པར་འཇིག།",
    "སྔོན་བསྙེན་འབུམ་ཕྲག་གཅིག་བྱས་ནས།",
    "བ་རོལ་དམག་རྣམས་རྣམ་པར་འཇིག།",
    "དེ་རྣམས་ཀྱང་ནི་འབྲེས་པར་འགྱུར།",
    "གཡས་ན་རལ་གྲི་བཟུང་བྱས་ནས།",
    "ཕ་རོལ་ཀྱི་དམག་ཉམ་པར་བྱ་བ་སྟེ་རིམ་པར་ཕྱེ་བ་དྲུག་པའོ།",
    "རྒྱལ་གྱི་ཉི་མའི་ཉི་མ་ལ་བརྩམ་པར་བྱའོ།",
    "ཉི་མ་གསུམ་བསྒོམས་ནས་རི་བྱས་ཏེ་ཁར་བཅུག་པས་མི་མཐོང་བར་འགྱུར་རོ།",
    "དེ་ནས་གཞན་ཡང་ཞིམ་བཟས་བཟུང་བའི་དུསུ་ཨུལྟ་མུ་ཁཾ་དང་དངུལ་ཆུ་དང་གསར་དྷ་སྟ་ར་ཞེས་པ་རྣམས་རྟ་རྒོད་མའི་ཆུ་དང་ཡང་དག་པར་སྦྱར་ནས་རི་ལུ་བྱས་ཏེ་ཁར་བཅུག་ན་མཆོག་ཏམི་སྣང་ངོ།",
    "བྷ་ཏྲཔ་ཀིའི་མིག་དང་དེ་རྣམས་ར་ལུར་བྱས་ནས་ཁར་བཅུག་ན་མི་སྣང་བར་འགྱུར་རོ།",
    "དེ་ནས་གཞན་ཡང་བྷ་ཏྲཔ་ཀཱ་ཎཾ་བཟུང་སྟེ་ཉིམ་བདུན་གྱི་མཐར་ཐུག་པ་དངུལ་ཆུ་ནཱས་གཅིག་ཟས་སུ་བྱས་ནས་དེའི་བྲུན་གང་ཡིན་པ་དང་།",
    "དེ་ཡིས་བདག་ཉིད་ཀྱི་ཁུ་བ་དང་ལྷན་གཅིག་ཏུ་བྱས་ནས་ཐིག་ལ་བྱས་ན་མི་སྣང་བར་འགྱུར།",
    "འདིར་དངུལ་ཆུ་ཞག་ཆེན་པ་ལ་མཉེས་ནས་ལྷང་ཚེར་དང་མུ་ཟི་ཞིག་ཆེན་བ་ལ་ཉི་མ་གསུམ་དུ་བཙོ་ཞིང་ཡང་ཇི་སྲིད་སྔོན་པར་མ་གྱུར་གྱི་བར་དུའོ།",
    "ཕྱིནས་ལྕི་བའི་མེ་ལ་བསྲེག་པས་རྡོག་པར་འགྱུར་རོ།",
    "ལྕགས་བརྒྱད་ལ་བྱུགས་ན་ངེས་པར་གསེར་དུ་འགྱུརོ།",
    "ཟོས་ན་མཁའ་སྤྱད་ཐབ་པར་འགྱུར་རོ།",
    "ཐུན་ཚོད་གཉིས་ཀྱིས་རྡོག་པར་འགྱུར་རོ།",
    "ཟེགས་མ་ཟོས་པ་ཙམ་གྱིས་ས་གསུམ་ལ་ངེས་པར་འགེ་བར་གསུས་ས།",
    "མུ་ཟི་དང་མཉམ་དུ་ཟངས་ཀྱི་སྣོད་དུ་བ་རའི་ཁུ་བས་མཉེས་ཏེ་ཉི་མ་ལ་སྐམ་པར་བྱས་ན་རྡོག་པོར་འགྱུར་རོ།",
    "རྩབས་དང་རྣམ་པར་སྣང་མཛད་ཀྱི་ཁུ་བས་སླར་ཡང་མཉེ་བར་བྱའོ།",
    "ལུས་ལ་ཡང་ར་ཏིའི་ཚད་ཀྱིས་ཉེས་པ་གསུམ་འཛོམས་པར་འགྱུར།",
    "གླང་པོ་ཆེའི་རྐང་པའི་ཚད་ལས་དེ་ལས་ཕྱུང་སྟེ་མཉམ་དུ་བླངས་ནས་ར་ཏིའི་ཚད་དུ་གཞུག་པར་བྱའོ།",
    "ཟས་མ་ལ་བསྣུན་ན་མ་ལུས་པ་ངེས་པར་གསར་དུ་འགྱུར་རོ།",
    "དེ་ནས་གཞན་ཡང་ལྷང་ཚེར་ནག་པ་སྲང་གཅིག་དང་སྦལ་པའི་ལོ་མའི་ཁུ་བ་ཡས་སྦྱོར་བའི་དངོས་པོ་ཟླ་བ་ཕྱེད་འཚལ་དང་རོ་མཉམ་པར་བྱས་ཏེ།",
    "ཀ་ཤིའི་ཁུ་བ་དང་མཉམ་དུ་སྦྱར་ཏེ་ཉི་མའི་འོད་ཟེར་ལ་སྐམ་པར་བྱ།",
    "ཐམས་ཅད་གཅིག་ཏུ་བྱས་ཏེ་ལྕགས་དང་མཉེ་བར་བ་སྟེ་རྡོ་བརྟན་པའོ།",
    "དེ་ནས་རྡོ་རྗེ་འཛིན་པའི་རྒྱལ་པོ་གྲིབ་གནོན་གྱི་རབ་ཏུ་བྱེད་པ་གསུངས་པ་འདི་ལྟ་སྟེ།",
    "ཆད་པའི་རབ་ཏུ་སྦྱོར་བ་འདི་གསུངས་ཏེ།",
    "སྤྱནགསུམ་ཤིན་ཏུ་འཇིགས་པར་བྱེད།",
    "ཐམས་ཅད་རྨོངས་པར་ཐེ་ཚོམ་མེད།",
    "བྱས་ན་དེ་ནི་བརྒྱལ་བར་འགྱུར།",
    "མི་དེ་ཁྲག་དུ་སྐྱག་པར་འགྱུར།",
    "དེ་ནི་ངེས་པར་རྨོངས་པར་འགྱུར།",
    "རི་ལུ་ཁྲི་ཕྲག་ལྔ་བྱས་ནས།",
    "འཇིག་རྟེན་གསུམ་ན་རྨོངས་པར་འགྱུར།",
    "སྔགས་འདིས་རི་ལུ་ཐམས་ཅད་ལ་བྱིན་གྱིས་བརླབ་པར་བྱའོ།",
    "གྲིབ་གནོན་བསྒྲུབ་པ་སྟེ་རིམ་པར་ཕྱེ་བ་བརྒྱད་པའོ།",
    "གཞན་གྱིས་མི་ཐུབ་པའི་སྒྲུབ་པར་གྱུར་ན།",
    "ཤིན་ཏུ་སྔ་བ་ན་ངེས་པར་འོད་བར་འགྱུར་རོ།",
    "འས་ནས་གནང་བ་ཞུ་བར་བྱེད་དེ།",
    "དགྲ་རྣམས་ལ་ཆད་པས་གཅོད་པར་བྱེད་དོ།",
    "དེ་ནས་ཨ་ཛི་ཏ་སྒྲུབ་པར་གྱུར་ན།",
    "བཟླས་པའི་མཐའ་ལ་དེས་པར་འོང་བར་འགྱུར་ཏེ།",
    "རྡོ་རྗེ་འཛིན་པའི་ཁང་པར་ཞུགས་ཏེ་སྟོང་ཕྲག་བརྒྱད་བཟླས་པ་བྱའོ།",
    "འདོད་པ་ཐམས་ཅད་ཡངོས་སུ་རྫོགས་པར་བྱེད་དེ།",
    "དེ་ནས་མ་གང་བ་སྒྲུབ་པར་གྱུར་ན།",
    "བསྙེན་པ་བྱས་པར་གྱུར་པས།",
    "དེ་ནས་དུར་ཁྲོད་ཀྱི་བདག་པ་བསྒྲུབ་པར་གྱུར་ན།",
    "ཇི་སྐད་གསུངས་བའི་གཏོར་མ་བྱིན་ཏེ།",
    "དེའི་ནམ་བྱེད་ན་ཧ་ཧ་སྒྲོགས་པ་ཐོས་པར་འགྱུར་ཏེ།",
    "འོངས་པ་དང་གཏོར་མ་བྱིན་པས་ཚིམ་པར་འགྱུར།",
    "དེ་ལ་འཇིགས་པར་མི་བྱ་སྟེ།",
    "རྡོ་རྗེ་འཛིན་པའི་ཁང་པར་ཞུགས་ནས།",
    "སྔོན་དུ་བསྙེན་པ་བྱས་ནས་ཉི་མ་བདུན་པ་ལ་དེ་ནས་སྒྲུབ་པ་བརྩམ་པར་བྱའོ།",
    "འོས་པ་ན་ཙན་དན་གྱི་མཆོད་ཡོན་ཕུལ་བས་ཚིམ་པར་བྱའོ།",
    "འདོད་པའི་དོན་ཐམས་ཅད་ཕུན་སུམ་ཚོགས་པར་བྱ།",
    "རང་གཅིག་བུ་ཉལ་སའི་སྟེང་དུ་བསྡད་ལ་སྟོང་ཕྲག་གཅིག་བཟླས་ས།",
    "དེའིནམ་ཕྱེད་ན་ངེས་པར་འོང་བར་འགྱུར།",
    "གཞན་དུ་ན་རྣམ་པར་འཇིགས་པར་བྱེད་དོ།",
    "དེ་བཞིན་དུ་ཉི་མ་བདུན་པའི་མཚན་མ་བདག་ཉིད་འདས་པར་འགྱུར་རོ།",
    "འོངས་པ་ན་འདོད་པ་བྱས་པས་ཆུང་མར་འགྱུར་རོ།",
    "འོངས་པ་ན་མི་སྨྲ་བར་བསྒོམ་ཞིང་འདོད་པ་བྱས་པས་ཆུང་མར་འགྱུར་རོ།",
    "དེ་ནས་པད་མ་ནི་སྒྲིབ་པར་གྱུར་ན།",
    "འབུམ་ཕྲག་བཞི་ནི་བཟླས་བྱས་ཏེ།",
    "རོ་ནི་མདུན་དུ་ཕྱོགས་བྱས་ནས།",
    "ཕུཅེས་པའི་སྔགས་ཀྱི་ཡི་གེས་མགོ་བོ་ནས་བརྩམས་ནས་རྐང་པའི་མཐར་ཐུག་པ་སྔགས་ཀྱིས་བབ་པར་བྱའོ།",
    "བདུད་རྩིའི་ཆར་རྒྱུན་འབབ་པར་བསྒོམ།",
    "ཀྱེ་མ་འཁོད་པ་སུ་ཞིག་ལགས།",
    "ཡལ་བ་ཡི་ནི་ནང་བྱས་ནས།",
    "ལྷག་པ་ལ་སོགས་པ་དང་ཡང་དག་པར་ལྡན་པའི་དྲ་དང་།",
    "དེ་སྟེང་པར་དམིགས་ཏེ་བརྩམ་པར་བྱའོ།",
    "ཨ་ཡིག་ལས་སྐྱེས་པའི་པདྨའི་སྣོད་ཕྱི་དཀར་ལ་ནང་དམར་བ་དེ་ལ་ཆུས་སྐྱེས་འདབ་མ་བརྒྱད་པའི་རྣམ་པ་བསམ་པར་བྱའོ།",
    "དེའི་ཤར་ལ་སོགས་པའི་འདབ་མ་ལ་ཧཱུྃ་ཨཱ་ཛཾ་ཁཾ་ཧཱུྃག་ཡི་གེ་རྣམས་ལ་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་རང་གཟུགས་རྣམས།",
    "ཧཱུྃ་ལན་བདུན་བཟློ་ཞིང་བརྗོད་པར་བསྒོམས་ཏེ།",
    "རྡོ་དབྱུག་པས་དཀྲུག་པར་བལྟའོ།",
    "དེ་ཡང་དོཛདབྱག་པས་བདུད་རྩི་ཞུ་སྟེ་ཉི་མ་གསར་པའི་ཁ་དོག་གམ་དངུལ་ཆུའི་རྣམ་པར་བསམ་པར་བྱའོ།",
    "དེ་ལ་རབ་ཏུ་བཞུགས་པར་བྱའོ།",
    "དེ་རབ་ཏུ་ཞུགས་པས་ཟླ་བའི་འོད་ཟེར་ཚོགས་པ་བཞིན་དུ་ལྷག་པ་ཡས་སུ་གྱུར་པ་ལས་ཁ་བ་ལྟ་བུ་སྦྲང་རྩིའི་ཚོགས་པའི་གཟུགས་ཀྱིས་གནས་པར་བྱའོ།",
    "ཕྱི་ནས་ཡི་གེ་གསུམ་གྱིས་བྱིན་གྱིས་བརླབ་པར་བྱ་སྟེ།",
    "རོ་བཅུད་དང་ལྡན་པ་སྟོན་ཁའི་ཟླ་བ་དྲིམ་མེད་པའི་འོད་ལྟ་བུ་ཡེ་ཤེས་ཀྱི་བདུད་རྩི་སྦྱོར་བས་གཏོར་མ་གྲུབ་པར་འདུན་པ་བྱའོ།",
    "ལག་པ་གཡས་པ་དང་གཡོན་པ་ན་རྡོ་རྗེ་དོད་སྡུག་འཛུབ་ཅན་བཀུག་སྟེ་ཤར་དུ་རྣམ་པར་དགོད་པར་བྱའོ།",
    "བྱང་དུ་རྣམ་པར་གནས་པའོ།",
    "ཁ་དོག་སྔོན་པོ་ཁྲོ་ཞིང་གཏུམ་པ་གདེན་བྲལ་གྱི་ཕྱོགས་སུ་རྣམ་པར་གནས་པའོ།",
    "དེ་བཞིན་གྲུབ་པར་བསམ་པར་བྱའོ།",
    "སླར་ཡང་འདིར་ནི་བྱོན་པར་ཞུ།"
  ]
