    "ཁ་བ་ལ་འདབས་དམག་གིས་བསོ་སྒྲ་སྒྲོགས",
    "ཤེས་ཡུལ་ལྕགས་ཀྱི་མདའ་མོ་ལན་གཅིག་འཕེན",
    "བྱང་གི་ཕྱོགས་ནས་བརྡའ་ཐན་འབྱུང་ཡང་ཉེ",
    "དཔལ་སྤུང་ཁུ་བྱུག་སྙན་པའི་ངག་གིས་བསླུ",
    "ཁྲོ་ལྕགས་གཉིས་ཀྱིས་མདའ་མོ་བྲག་ལ་གཟེར",
    "བོ་ཆུང་ལ་ནི་འཐབ་རེ་རྩོད་རེ་འབྱུང་",
    "པདྨ་ཐུགས་སྲས་བདེ་མཆོག་གི་ཛ་འ",
    "ལུག་གི་ལོ་ནས་དབུས་གཙང་བསྟན་པ་རྒྱས",
    "ཉོན་མོངས་རགས་པའི་རྐྱེན་གྱིས་བློ་སྣ་མང་",
    "ཨེ་མ་བདག་འདྲ་གུ་རུ་པད་འབྱུང་གིས",
    "སྐྱེས་པ་བུད་མེད་གཟུགས་སུ་སྤྲུལ་ནས་སུ",
    "དེ་དུས་བདུད་མོ་ཀོང་བཙུན་སྤྲུལ་པ་ནི",
    "དཔྲལ་བར་མོ་མཚན་རྒྱབ་ཏུ་མིག་གཟུགས་ཡོདམིང་ནི་ཤེར་མཚོ་འམ་སྐྱིད་ལོ་མིང་ཅན་དང་",
    "སྔོན་མོའི་གཡུ་རལ་ནུབ་བྱང་མཚམས་ནས་རྒྱས་རིན་ཆེན་རི་བཞི་ཙི་ནའི་ཞབས་སུ་ཤོར",
    "མ་ཟི་ཉག་གི་བློ་འཕྲུལ་ངོམ་པའི་སྟོབས",
    "ཁང་གི་པདྨ་ཙི་ནས་གཤེགས་གསོལ་བྱེད",
