    "དེའི་ཚེ་ཕྱོགས་སུ་སྔར་མ་འགྱུར་བའི་རྒྱུད་བསྒྱུར་གྱིས་གདའ་ཟེར་བ་དང་།",
    "ཉིད་ལོ་ཙཱ་བ་ཆེན་པོར་གདའ་གསུངས།",
    "དྲུང་པ་སྔར་ནས་སྙན་པ་ཆེ་བར་འདུག་དེ་བས་ཀྱང་མཇལ་ནས་ཡིད་ཆེས་ཤིང་ཡ་མཚན་པ་ཞིག་བྱུང་གསུངས་ནས་ཐུགས་དགྱེས་པ་ཆེན་པོས་སྲི་ཞུ་ཆེན་པོ་མཛད་ཅིང་།",
    "ཁྱེད་རང་ལོ་ཙཱ་བ་ཆེན་པོར་སྣང་གསུངས་ནས་དགེས་པ་ཆེན་པོ་བྱུང་སྲི་ཞུ་བླ་བྷག་ཏུ་མཛད་དེ།",
    "སྒྲ་ལ་བརྟེན་པའི་དོགས་པ་མང་པོ་གདའ་བ་རྣམས་སེལ་ནུས་པ་བྱུང་ཞིང་།",
    "ཉིད་ལོ་ཙཱ་བ་ཆེན་པོར་འདུག་གསུངས་ནས་བསྙེན་བཀུར་གྱ་ནོམ་པ་མཛད་ཅིང་།",
    "ཞེས་པ་དེ་ཁྱེད་ཁོ་ནར་འདུག་པ་ཞེས་གསུངས་ཤིང་དད་གུས་དང་བསྙེན་བཀུར་མཐའ་ཡས་པ་མཛད་དོ།",
    "དེ་དུས་རྒྱ་དཔེ་ཁ་ཅིག་འདུག་པ་ལ་བསྒྱུར་འགྲེལ་ཡང་མཛད།",
    "ཞལ་ལུ་བ་རྣམས་སེམས་འཐེང་པར་འདུག་ནའང་།",
    "མཆོད་མེ་ཁ་བྲི་བ་ཙམ་ཡང་མི་འདུག་པས་ཡ་མཚན་པའི་གནས་སུ་བྱས།",
    "སྔར་ལས་ཅུང་ཟད་བྲི་གསག་བ་ཙམ་མ་གཏོགས་མི་འདུག་པ་ལ།",
    "གཞན་ལ་འཆད་པ་དང་རང་ཉིད་ཉམས་སུ་ལེན་པ་སོགས་གང་ལ་ཡང་ཐོགས་པ་མེད་ལ་སས་བས་པའི་བློ་གྲོས་མངའ་བ་ཞིག་སྟེ།",
    "འདི་ནི་དཀར་པོར་འདུག་གསུངས་བ་ལ་སོགས་པ་དང་།",
    "སེམས་དཔའ་ཆེན་པོ་ལས་འཇིགས་པ་འདུག་ཅེས་རྗེ་ཉིད་ཀྱིས་གསུངས་ཞེས་ཀྱང་གྲགས་ཤིང་།",
    "ནམ་མཁའ་ཤིན་ཏུ་དྭངས་པ་ལ་འཇའ་འོད་ཟླུམ་པོ་ཤིན་ཏུ་ལེགས་པ་གཅིག་འདུག་ནས།",
    "འདི་བཞིན་གསར་བབསགཡསམ་འདུག་གཞན་ནི་མ་མཐོང་ཞུས་པས།",
    "འབུལ་བསྡུ་པས་བཏང་པ་ཡིན་ཟེར་བའི་སླེའུ་གྱོན་པ་གཉིས་སྒོ་དྲུང་ན་སླེབས་འདུག་ཅེས་གླེང་བ་བྱུང་།",
    "ཅུང་དམའ་བ་དེར་གཞན་ཞིག་ཕེབས་རྒྱུ་ཡིན་པའི་མཚན་དོན་བྱུང་བ་བརྗེད་འདུག་གསུངས།",
    "ཁ་སང་བདེ་བ་ཅན་གྱི་ཞིང་ཁམས་ན་ཡོད་པའི་ཁྲི་སྟོང་པ་དེ་མཁན་ཆེན་ཐམས་ཅད་མཁྱེན་པ་ཉིད་འབྱོན་པའི་ལྟས་སུ་འདུག་ཅེས་གསུངས་པར་གྲགས་ལ།",
    "འདི་ལྟར་འདུག་ལགས་པ་ཅི་འདྲ་ལགས་སམ་ཞུས་པས།",
    "དེ་ཙམ་འདུག་ལོང་མེད་ཅེས་གསུངས་ཤིང་།",
    "པོ་སྟོན་གྱིན་འདུག་ཀྱང་།",
    "དེ་གྲུབ་རྟགས་སུ་ཤེས་པ་ངེད་གཟུགས་མེད་རྣམས་མིན་པ་མི་འདུག་གསུངས་པ་སོགས་བསྔགས་བརྗོད་དུ་མ་མཛད་པ་དང་།",
    "བེ་རོ་ཙ་ན་དང་ཀུན་དགའ་བོ་ཐུགས་རྒྱུད་གཅིག་པ་ནི།",
    "ཀུན་ཀྱང་རང་སྣང་ལྷག་པའི་ལྷ་ཉིད་དང་།",
    "སྔར་ནི་གསོལ་བ་བཏབ་པས་རྗེ་ཉིད་ཀྱིས་གནང་བ་ཡིན་ཟེར་བའི་ཡི་གེའི་རྣམ་པ་ཞིག་འདུག་པ་བཀླགས་པའི་ཉམས་སྣང་བྱུང་བས་དེ་མ་ཐག་ཕན་འདུག་བསམ་སམས་ལས་ནས་མ་མས་མས་མས་མས་མས་མསས་བས་ལམ་པས་སངས་ས་མ་ས་མ་མས་མ་སས་བབ་ཅེས་དེ་ཉིད་ཀྱིས་བསྒྲགས་པ་དང་།",
    "མཉམ་རྗེས་ཀྱི་དམ་ཚིག་གསོ་ཚུལ་ལ་ཐུགས་དོགས་འཁྲུངས་འདུག་པའི་མ་སས་ལས་ས་གསས་ཡས་མས་བསམ་ལག་ལ་བསམ་ཡས་བསམ་ས་ས་སམ་མ་བསགས་ས་མ་ས་ཁམས་གནས་བབ་བསམ་ས་ས་ས་ས་མ་ག་ཏགས་བསལ་ས་སམ་། སང་ཉིན།",
    "འདི་ལྟར་ཡིན་པ་འདུག་ཅེས་ངེས་པ་བསྐྱེད་པའི་གཏན་ཚིགས་དང་བཅས་གསུངས་པའི་རྗེས་ཅུང་ཟད་ནས།",
    "རྗེ་འདི་ཉིད་ཕེབས་ན་བཀའ་ལུང་བཞིན་བགྱིད་ཅེས་ཕྱོགས་གཉིས་ཀས་ཁས་ལེན་པར་འདུག་པ་བཞིན།",
    "བཞེངས་གྲུབ་པའི་ཚེ་རབ་གནས་ལ་ཕེབས་དགོས་ཞུ་བའི་བང་ཆེན་འདུག་པས།",
    "སྐུ་གསལ་པོ་མི་མངོན་འདུག་པས།",
    "ད་སང་ནས་མཚམས་བྱེད་པས་བལྟ་བ་མ་ཡོང་གསུངས་ཏེ་མི་བཞུགས་པའི་བརྡར་འདུག་དེ་ནུབ་ནས་སྐུ་མཚམས་གནང་།",
    "ད་དུང་ལོ་ཤས་མ་ཤི་ན་ས་སྐྱ་པའི་བསྟན་པ་ལ་ཕན་ཐོགས་པ་འདུག་སྟེ།",
    "ང་རང་ལ་བདག་ཏུ་བཟུང་བའི་དངོས་པོ་གང་ཡང་མེད་པས།",
    "ཁོང་རང་བཀའ་དྲིན་ཆེ་བ་ལགས།",
    "ཧྲིཤྲཱིའི་གསང་སྔགས་རང་རང་བཞིན།",
    "བྱས་པས་སྐྱབས་གནས་མ་ནོར་གདའ་། བཅུ་གཅིག་ཞལ་གཉིས་ལྷ་ལྔ་དང་།",
    "དད་པ་དེ་རྣམས་མ་ནོར་གདའ།",
    "དྲིན་ལན་འཇལ་ལུགས་མ་ནོར་གདའ།",
    "བསྟན་པ་སྤྱི་དང་བྱེ་བྲག་དུས་འཁོར་གྱི།",
    "བུ་སློབ་འགའ་ཞིག་ལ་ངེད་ལ་ཉམས་བ་བསམ་གམ་དམ་པ་གསལ་བ་བ་ས་མས་མ་གསལ་ས་ཡམས་བསམས་མ་སམཡས་བསམ་ས་ནས་མསམ་ཡསམཡས་མས་མས་མས་ཡང་ཡས་ཡས་མས་མདང་མས་མ་རྟོགས་ཆེན་པོ་མེད་ཀྱང་ཡེ་ཤེས་འཇུག་ལྡོག་དུ་མ་ཡོང་ཀྱི་འདུག་ཅེས་ཀྱང་གསུངས་འདུག་གོ།",
    "ད་དུང་ཁོག་པའི་ནང་ན་སྲིན་འབུ་ཅུང་ཟད་ཡོད་ཚོད་དུ་འདུག་ཅེས་སྒྲིབ་གཡོག་དང་བཅས་གསུངས་པ་དང་།",
    "གཞན་གྱིས་སྦྱངས་ནའང་འདི་ལྟར་འོང་ཞེས་རྗེའི་དབོན་པོ་འགའ་ཞིག་ལ་གསུངས་འདུག་པ་བརྒྱུད་ས་སམ་ནས་ས་ལམ་བགམསམ་ཙམ་ལས་ནས་ཐོས་སོ།",
    "དེ་མཚོན་བྱེད་དཔེའི་ཡེ་ཤེས་རྟགས་རུང་ཙམ་དུ་གདའ།",
    "ཡང་ལན་གཅིག་སྐུ་མདུན་ན་ཨ་ཙ་ར་མང་པོ་བྲོ་བྱེད་ཀྱིན་འདུག་གསུངས།",
    "ཆེན་པོའི་མཆོད་གནས་སོགས་བློ་ལ་གཏན་མེད་ཀྱང་ད་ལམ་ནི་ཕྱིན་ན་ལེགས་པ་འདུག་སྟེ།",
    "མདང་ནུབ་རྨི་ལམ་དུ་བྱུང་བའི་མི་ནག་པོ་དེ་གུར་གྱི་མགོན་པོ་ཡིན་ཚོད་དུ་འདུག་ལ།",
    "བན་ཆུང་དེ་ཞལ་བཞི་པའི་སྤྲུལ་པར་འདུག་གསུངས་ཤིང་།",
    "འདིར་དཀོར་ཆེས་པས་འགྲིབ་འགྲོ་ཡི་འདུག་ཅེས་གསུངས་འདུག་ཅིང་།",
    "ད་ཕྱིན་བཙུན་པ་ཡིན་པས་ངང་བློ་རིང་དགོས་ཞེས་སོགས་གསུངས་འདུག་པ་དང་།",
    "མར་རིལ་གསུམ་འདུག་པ་ལ་ཆུང་ཤོས་འདི་ཁྱེར་བ་ཡིན་ནམ་གསུངས་བྱུང་ཟློབས་དགེ་སློང་བ་ཕྱག་འབུལ་ཞིང་།",
    "ད་ཕྱི་ཁྱེད་གཅེར་བུར་འདུག་པ།",
    "ཡང་ན་ནོར་གོད་ཆེན་པོ་ཞིག་ཡོང་བ་འདྲ་གསུངས་ཤིང་ཅུང་ཟད་ཐུགས་འཚབ་པའི་རྣམ་པ་མཛད་ཀྱིན་འདུག་པ་ལ།",
    "ཁྱེད་ཀྱི་རྨི་ལམ་འདིའི་རྗེས་སུ་འདི་བྱུང་འདུག་པ་ཞེས་གོ་རིམ་རྣམས་མ་འཁྲུགས་པར་གསུངས་ཤིང་ལེགས་ཉེས་ཀྱི་ལུང་བསྟན་གནང་བྱུང་བས།",
    "སླར་འབྲོག་པ་དེ་རྗེའི་ཞབས་དྲུང་དུ་ལོག་བྱུང་ནས་སྨེ་སྔགས་དུ་མ་ཞུ་ཡི་འདུག་པ་ལ།",
    "རྗེ་འདི་ཉིད་ལྟ་སྟངས་ཀྱི་ངང་ལ་ཅུང་ཟད་ཀྱང་མི་གཡོ་བར་བཞུགས་འདུག་པས།",
    "དེ་མ་བྱས་པར་འདིའི་ལུང་བྱས་པས་ཁོ་མ་དགའ་ཟེར་བ་འདུག་གསུངས་བྱུང་པས།",
    "མུས་སྟོང་དཔོན་སོགས་སྐུ་གཞོགས་ན་ཡོད་པ་ཐམས་ཅད་ལ་མཐུན་པར་ལུས་ཟི་བུན་བྱེད་པ་བྱུང་ཞེས་ཁོ་རང་རྣམས་ལས་དངོས་སུ་ཐོས་པས་འདི་ནི་ལས་ཀྱི་གཤིན་རྗེ་ནག་པོ་ཡབ་ཡུམ་ཀྱི་གདུག་རྩུབ་ཀྱི་ཆོ་འཕྲུལ་རྗེ་འདིའི་ཏིང་ངེ་འཛིན་གྱི་ཟིལ་གྱིས་མནན་ནས་བྲན་དུ་བཀོལ་བ་ལ་ཐེ་ཚོམ་མི་དགོས་པར་མངོན་ཞིང་འདི་ཐུགས་ཤིན་ཏཚཚན་གྱི་ཟིལ་གྱིས་དཔོན་སོགས་སྐུ།",
    "བསམསཨར་ས་།་། འཁྱར་མེད་དུ་ཕྱག་ཏུ་འབྱོར་འདུག་པ་འདི་ལྟ་བུའི་མཐུ་རྩལ་ནི།",
    "དེ་རྣམས་ཡེ་ཤེས་ཀྱི་མགོན་པོ་ཕྱག་དྲུག་པའི་སྤྲུལ་པའི་འཁོར་དུ་འདུག་གསུངས་ལ།",
    "ངེད་ལ་ལུང་བསྟན་ཕལ་ཆེར་ཡེ་ཤེས་ཀྱི་མགོན་པོ་འདིས་བྱེད་ཀྱིན་འདུག་ཅེས་ཀྱང་དད་ལྡན་ཀྱི་བུ་སློབ་འགའ་ལ་གསུངས་པ་ལས་བརྒྱུད་དེ་ཐོས་སོ།",
    "ཉིན་གཅིག་མཚམས་གཡོག་པ་དེ་ལ་ཁྱེད་གང་འདོད་ཀྱིན་འདུག་དྲིས་པས།",
    "རྣལ་འབྱོར་པའི་གཟི་བརྗིད་གདུག་འདྲེ་ཚོས་མ་བཟོད་ཚོད་དུ་གདའ་ཞེས་གསུངས་ཤིང་།",
    "རྩ་བརྒྱད་པ་དྲུང་འཚོ་ལྷ་འབྱོར་གདན་ས་ཆེན་པོར་འབྱོར་བྱུང་པའི་ལག་པར་དཔུང་སྐུད་ཅིག་འདུག་པ་ལ།",
    "བདག་ཚེ་ཧ་ཅང་མི་རིང་བ་ཞིག་བྱུང་ན་ཐོས་བསམ་རྒྱ་ཆེར་བྱས་པ་དོན་མི་འདུག་པས་ཚེ་རིང་ཐུང་དང་།",
    "སྐུ་ཕྲུ་བཏབ་པས་སྐུ་ཚེ་རིང་པོ་ཡོང་བ་གདའསྐེ་ཕུ་བཏབ་པས་སྐུ་ཚེ་རིང་པོ་ཡོང་བ་གདལ།",
    "མ་ནོར་ལམ་ལ་འབུངས་ཤིག་ཅེས་གསུངས་པ་སོགས་མང་དག་གདའ་ནའང་ཡི་གེ་མང་དོགས་མ་བྲིས་ལགས།",
    "ཞེས་པ་ལ་སོགས་པ་གསུངས་པ་ལྟར་འདུས་བྱས་ཐམས་ཅད་མི་རྟག་པ་གདའ་བ།",
    "ཞེས་གསུངས་པ་འདུག་པ་མཐོང་བས་སེམས་དགའ་དང་སྤྲོ་བ་ཚད་ལས་འདས་པ་རབ་དགའི་ས་ཐོབ་པ་ལྟ་བུར་གྱུར་ཅིང་།",
    "དེ་ཙམ་གྱི་སྡུག་བསྔལ་རང་མི་འདུག་ཅིང་།",
    "ངེད་འདིར་གདན་ས་བྱས་ན་ནི་འདུ་འཛིའི་གཡེངས་པས་མི་ཚེ་སྟོང་ཟད་དུ་འགྲོ་བ་འདུག་ཅིང་།",
    "རྗེ་བཙུན་ཉིད་གང་ཡང་མི་གསུང་བ་ཡུན་རིང་དུ་བཞད་ཀྱིན་འདུག་པས།",
    "སྐབས་འགར་སྐུ་འདར་ཤིག་ཤིག་མཛད་ཀྱིན་འདུག་པ་ལ།",
    "ཞབས་དྲུང་ན་གནས་པ་རྣམས་ཀྱིས་སྐུ་མི་བདེ་བ་མི་འདུག་ལགས་སམ་ཞུས་པས།",
    "རྩ་མདུད་རྣམས་གྲོལ་བར་འདུག་གསུངས་ཤིང་ཐུགས་བདེ་ཉམས་ཆེན་པོ་མཛད་པ་ནི་དུས་དེར་ལྷན་ཅིག་སྐྱེས་པའི་ཡེ་ཤེས་ཟུང་འཇུག་བདེ་བ་ཆེན་པོ་ཐུགས་རྒྱུད་ལ་འཁྲུངས་པའི་རྟགས་ལས་གཞན་དུ་མ་གསས་མནམམ་བས་སམཉམ་མམ་ཡངས་པས་མ།",
    "ཟླ་བ་ཤར་བར་འདུག་གམ་ཐམས་ཅད་འོད་དཀར་པོས་གང་འདུག་གསུང་པ་དང་།",
    "མི་འདུག་ལགས་ཞུས་པས།",
    "ཡང་ཅུང་ཟད་ནས་ཌཱ་ཀི་མ་འོད་གསལ་མ་བུ་ངོ་འཕྲོད་བྱུང་ཞེས་གསུངས་ཤིང་དགེས་སྤྲོ་དཔག་ཏུ་༡ མེད་པའི་ཐུགས་ཉམས་མཛད་ཀྱིན་འདུག་ཅེས་ཐོས་ལ།",
    "ཡི་དྭགས་ལ་སུ་རུ་པའི་གཏོར་མ་མ་སྦྱིན་པར་ཚོད་མ་འཐུང་བས་ཡོང་བ་ཨེ་ཡིན་ཞེས་སོགས་གསུངས་ཤིང་ཐུགས་ཅུང་ཟད་མ་མཉེས་པའི་རྣམ་པ་མཛད་ཀྱིན་འདུག་པས།",
    "དེ་དུས་ཀྱང་དབུ་བྱིན་ལ་ཡང་དྲོད་ཚ་ཆིལ་ལེ་བ་རླངས་པ་དང་བཅས་འདུག་གོ་ཞེས་ཐོས་ལ།",
    "ཨ་བྷ་ཡ་ལས་ཀྱང་ཙ་མི་ཆེ་བར་འདུག་པས།",
    "དུར་ཁྲོད་འདི་ནི་ཤིན་ཏུ་གཉན་པ་ཞིག་འདུག་པས།",
    "རྒྱ་གཞུང་ཡང་གཉིས་འདུག་གོ་༣ ༣༡།",
    "གང་ཟག་དུས་དང་གནས་དང་བསམ་པ་དང་།",
    "རྫོགས་རིམ་འདི་ཡིན་རང་མེད་པའི་འགྲེལ་པ་འོས་ཙམ་འདུག་གོ་ཞེས་གསུངས།",
    "གྲངས་འདི་རྣམས་ནི་ཡི་གེ་རྙིང་པ་རྣམས་ན་མཆན་བུ་དང་གྲངས་ཡིག་བཏབ་འདུག་པ་ཇི་ལྟ་བར་བྲིས་པའོ།",
    "སམྦུ་ཊི་ན་འདུག་པའི་རྡོ་རྗེ་དྲིལ་བུའི་རྒྱུད་དང་།",
    "ཨ་བྷ་ཡ་ཀ་ར་ས་ཆེན་དང་དུས་མཉམ་ཡིན་ཚོད་འདུག་པས།",
    "གཞི་དང་རང་བཞིན་འབྲས་བུའོ།"
  ]
}