    "གང་གི་བཟོད་པ་དེ་ཡིས་སྟོབས་དང་བརྟན་པ་སྟེ།",
    "གང་རྣམས་ཕ་རོལ་རྣམས་ལས་རྩུབ་མོ་མི་བཟོད་པ།",
    "ཡོངས་སུ་བསིལ་བའི་ཆུ་ལས་གློག་གི་མེ་བཞིན་དུ།",
    "མཛེས་པའི་སྐྲ་ནི་རྒྱང་རིང་མགོ་ལ་རེག་ནས་དང་།",
    "སློང་མོ་ཟ་བས་བདག་ཉིད་ཡོངས་སུ་རྟོག་པ་པོ།",
    "གང་ཕྱིར་འདི་ལས་འཁྱོག་པོ་ཉིད་ནི་བསྙེན་མི་བྱ།",
    "བརྒྱ་བྱིན་ལ་སོགས་ལྷ་རྣམས་ཀྱིས་ཀྱང་རེ་འདོད་བྱེད།",
    "རང་གི་སྐྱེ་བོ་ལ་འམ་སྐྱེ་ལ་ཆགས་པ་སྤངས།",
    "དེ་ཕྱིར་ལུས་ལ་སོང་བའི་དྲན་པ་སྤང་མི་བྱ།",
    "འཇིག་རྟེན་དག་གི་སྐྱེ་དང་འགོད་པ་ཤེས་པ་སྟེ།",
    "ཉོན་མོངས་ལྗོན་ཤིང་འཇོམས་བྱེད་མཚོན་ཆ་རྣོན་པོ་ཡིན།",
    "གང་གི་ཤེས་རབ་རང་བཞིན་ལྟ་བྱེད་མིག་ཡོད་པ།",
    "དེ་ནི་བདག་གིས་བྱས་ཤིང་དང་ནི་རབ་བསྡམས་པ།",
    "བསྟན་པ་རྣམས་ལ་འདི་ནི་གང་གི་༧ འདོད་པ་ཡོད།",
    "སྐྱེས་རབས། ག་༡༨༧གློག་གི་འོད་ཀྱིས་ལམ་བཞིན་ཡང་དག་མཐོང་བར་གྱུར།",
    "གང་གི་དོན་གྱི་ལྷག་མ་ཡོད་པ་མ་ཡིན་ཞིང་།",
    "གང་རྣམས་མཁར་དང་ས་ན་བདག་གི་གདུལ་བྱ་རྣམས།",
    "ཁྱེད་ཅག་མ་སྨྲ་འདི་ནི་བདག་གི་ཕྱི་མའི་ཚིག།",
    "དེ་ནས་བསམ་གཏན་རིག་པ་རྣམས་ཀྱི་མཆོག་གིས་ནི།",
    "འཛིན་པ་འཛིན་པ་རྣམས་ཀྱི་རྩེ་མོ་རྣམས་ལྷུང་ཞིང་།",
    "སྐྱེས་རབས། གི་",
    "དེ་ནས་ཉེ་སར་སྐྱེས་པའི་ཤ་ལའི་ཤིང་དག་གིས།",
    "རང་གིས་མེ་ཏོག་མཛེས་པ་འཇུག་པ་དུས་མིན་ལ།",
    "ནང་དུ་སོང་བའི་ཀུན་ནས་གདུང་བ་རྣམས།",
    "རང་གནས་གྱུར་ཞིང་རྣམ་པར་འགྱུར་བ་མ་སོང་སྟེ།",
    "དེ་ནས་རྡོ་རྗེ་རྩེ་མོ་བཅོམ་པའི་རི་བོ་བཞིན།",
    "ནོག་གིས་རྣམ་པར་དམན་པའི་དབྱིབས་ཅན་ཁྱུ་མཆོག་བཞིན།",
    "ཉིན་མོར་བྱེད་པས་རབ་ཏུ་དམན་པའི་ནམ་མཁའ་བཞིན།",
    "བ་མོས་བསྲེགས་པའི་པདྨ་དང་ལྡན་རྫིང་བུ་བཞིན།",
    "ལྷ་ན་གནས་པ་ཆེན་པོ་གཞན་ཞིག་གིས་སྨྲས་པའོ།",
    "དེ་ནས་མཆོག་གི་དྲང་སྲོང་དང་མཚུངས་དྲང་སྲོང་གཞན།",
    "དེ་ལྟར་འགྲོ་བ་མེད་ཅིང་སོང་བ་མེད་པ་སྟེ།",
    "མཆོག་དང་མཆོག་མིན་མཁྱེན་པ་མཆོག་གི་དོན་རིག་པ།",
    "ཤེས་རབ་རྣམ་པར་དག་ཅིང་མཆོག་གི་སྤྱན་མངའ་བ།",
    "ཐུན་མོང་ལས་ནི་གང་དུ་དེ་བཞིན་གཤེགས་པ་ཡང་།",
    "མགྱོགས་འགྲོ་རྟ་བཞིན་དུ་ནི་རྣམ་རྒྱལ་ལམ་སོང་བ།",
    "སྡུག་བསྔལ་དག་གི་གཏེར་ནི་ལུས་ཡིན་ཞེས་སྤངས་སོ།",
    "གང་ཞིག་འོད་ཟེར་མཆོག་གིས་སྐྱེ་རྣམ་པར་གསལ་བ་དང་།",
    "གང་གིས་སྐྱེ་དགུ་རྣམས་ནི་དགེ་ལེགས་ལ་བཅུག་སྟེ།",
    "གང་གིས་མཁྱེན་ཞིང་སྨོད་པས་འོ་དོད་མ་བོས་ཤིང་།",
    "གང་གིས་སྔར་མ་བྱིན་པའི་སྦྱིན་པ་བྱིན་པ་སྟེ།",
    "ཁྱབ་བདག་ཡེ་ཤེས་ནོར་ཅན་དེ་ཡང་སྲོག་སོང་ངོ།",
    "གསུམ་གཟིགས་སྤྱོད་པ་གསུམ་ནི་ཟད་བྱེད་སྤྱན་གསུམ་པ།",
    "གང་གི་༧ཞི་བའི་ཆེད་དུ་ལམ་ནི་གསལ་མཛད་དེ།",
    "ཉོན་མོངས་ལྗོན་ཤིང་རབ་ཏུ་ཆགས་པ་བཅད་པ་སྟེ།",
    "གསུང་གི་བདུད་རྩིས་འཇིག་རྟེན་ཤིན་ཏུ་ཚིམ་མཛད་ཅིང་།",
    "དགེ་ལེགས་དོན་དུ་གཉེར་རྣམས་ཕྲ་མོ་རྟོགས་སུ་བཅུག།",
    "སྨད་ཀྱང་རང་གི་ཐུགས་ནི་བསྐྱོད་པ་མ་ཡིན་ཞིང་།",
    "སྐྱེས་རབས། གི་",
    "འཇིག་རྟེན་དག་གི་ལྟ་བྱེད་བཅོམ་ནས་འཇིག་རྟེན་གྱི་། ལྟ་བྱེད་ཉེ་བར་ཕྲོགས་ནས་འགྲོས་སུ་འདི་གཤེགས་སོ།",
    "གང་གིས་མཆོག་ཏུ་ཞི་བའི་ལམ་ནི་བརྙེས་པ་སྟེ།",
    "སྐྱེ་དགུ་ིརྣམས་ཀྱི་སྣང་མཛད་གང་གིས་འཇིག་རྟེན་ནི།",
    "གང་གིས་སྐྱེ་བ་དུ་མ་རྣམས་ཀྱང་དྲན་པ་སྟེ།",
    "ཡེ་ཤེས་ཀྱིས་ནི་ཉོན་མོངས་ཐམས་ཅད་རྣམ་ིསྤངས་ནས།",
    "ཐུགས་རྗེའི་བདག་ཉིད་ལྡན་ལ་རང་གི་དོན་མཛད་ནས།",
    "ཤེས་པ་མེད་པར་གཞོལ་བའི་འཇིག་རྟེན་དག་གི་ནི།",
    "ཇི་ལྟར་ཉིན་མོར་བྱེད་པ་འོད་ཟེར་མེད་པ་དང་།",
    "དེ་བཞིན་སྐྱེས་བུ་མཆོག་གིས་རྣམ་པར་དམན་པ་ནི།",
    "སྐྱེས་རབས། གི་",
    "བརྟན་པ་བཏང་ནས་དགེ་སློང་ཚོགས་ནི་མྱ་ངན་དང་།",
    "འདས་དང་མ་འོངས་པ་དང་ད་ལྟར་གཟིགས་ནས་སུ་། ད་ནི་ངེས་པར་འཇིག་རྟེན་མིག་ནི་སྒྲིབ་པ་སྟེ།",
    "མཆེ་བ་རིན་ཐང་ཆེན་པོ་ལོངས་མ་སྤྱད་པའི་ཁྱོགས།",
    "གློག་གི་འཕན་རྣམས་དག་གིས་སྤྲིན་ནི་དཀར་པོ་བཞིན།",
    "འདི་ལ་རིན་ཐང་མཆོག་གི་བླ་རེ་བཟུང་བའོ།",
    "དེ་བཞིན་མི་རྣམས་ཁ་ཅིག་དག་གིས་གདུགས་རྣམས་ནི།",
    "ཁ་ཅིག་དག་གིས་གསེར་གྱི་ཡོ་བྱད་དང་ལྡན་པའི།",
    "མིག་དམར་གྱད་རྣམས་དག་གིས་ཁྱོགས་ནི་བཟུང་བ་སྟེ།",
    "དྲི་ཟའི་བུ་མོ་རྣམས་ཀྱིས་ཡང་དག་འཐོར་བའོ།",
    "ཞི་བའི་ཆེད་དུ་ཞི་བའི་ལམ་ལས་ཁྱོགས་ཏེ་དྲངས།",
    "གང་གི་མཐུ་ལས་མེ་ཡི་འབར་བ་མ་ཡིན་ནོ།",
    "དེར་ནི་དགེ་སློང་སྐྱེན་པར་ཉེ་བར་སོང་བ་ན་། ཐུབ་པ་མཆོག་ལ་རབ་ཏུ་བཏུད་པ་བྱས་པ་ན།",
    "ཉོན་མོངས་རྣམས་ཀྱིས་མ་ཚིག་ཐུབ་པའི་སྐུ་གདུང་ལ།",
    "ཆུ་མཆོག་གིས་ནི་དང་བར་བྱས་ནས་དུས་སུ་ནི།",
    "སྲེད་པ་འཇོམས་མཛད་གང་གི་མཐུ་ལས་ཁྱབ་འཇུག་གི།",
    "མཁའ་ལྡིང་གིས་ཀྱང་ཁུར་བར་ནུས་པ་མ་ཡིན་པ།",
    "སྐྱེས་རབས། གི་",
    "གང་ཞིག་བདག་གི་སྣང་བས་ཉི་མ་གཞན་ེསྣང་ཞིང་།",
    "གང་གིས་ཉོན་མོངས་རི་བོ་རྒྱས་པ་རྣམས་ཕྱེ་སྟེ།",
    "གྱད་རྣམས་འཐབ་མོ་ལ་ཡང་ངེས་པར་སོང་བ་སྟེ།",
    "དཔུང་པའི་ཁྱོགས་ནི་བཏེག་པ་ཉམ་ཐག་པར་གྱུར་ཏོ།",
    "མིག་རྣམས་དཔུང་གིས་བསྣུན་པའི་རྡུལ་རྣམས་དག་གིས་དང་།",
    "མི་མོའི་སྐྱེ་བོ་ཡི་ཡང་དེར་ནི་བཅོམ་པར་གྱུར།",
    "སྐྱེས་རབས། གི་",
    "གཡུལ་འགྱེད་ཡན་ལག་མ་རྣམས་དག་གི་སེམས་རྣམས་དང་།",
    "སེམས་ཁྲལ་གདོང་ལས་གཞན་རྣམས་རི་དྭགས་མོ་བཞིན་དུ།",
    "གང་གི་གདོང་ནི་འཐབ་ལ་དཔའ་བ་དེ་མཐོང་ནས།",
    "བཅིངས་པའི་འཕྲོ་སྤོང་སོང་བ་མ་ཡིན་གནས་མ་ཡིན།",
    "གྲོང་གི་ནང་དུ་བཀག་པའི་གཏད་རྣམས་ཞུགས་པ་རྣམས།",
    "བོར་ནས་ནོར་འཛིན་བདག་པོ་དེ་རྣམས་ས་ལ་སོང་།",
    "སྐྱེས་རབས། གི་",
    "ཕལ་ཆེ་བར་ནི་བྱ་བར་སོང་ཞིང་འགྲོ་བ་སྟེ།",
    "བྱིས་པ་སྐྱོང་དང་དྲག་པོ་དག་གིས་ཁྱབ་འཇུག་བྱུང་།",
    "བུ་མོ་ལ་ནི་ས་སྐྱོང་དག་གི་རྒྱལ་པོ་རྣམས།",
    "གཏུམ་པོ་ལོང་བྱེད་རྣམས་ནི་རྩོད་པར་སོང་བ་སྟེ།",
    "ལྷ་མོ་སཱི་ཏར་མངོན་བརྗོད་འཆི་བ་ཡོངས་བཟུང་ནས།",
    "དེ་སྐད་ཅེས་སོགས་འཇིག་རྟེན་དག་ན་འཐབ་མོ་ནི།",
    "བཅས་པ་ཡིན་ཀྱང་ིའཐབ་མོ་མི་བགྱིད་གང་ལས་ཡིན།",
    "ཇི་ལྟར་དོན་ནི་འཐབ་མོ་མིན་པས་འགྲུབ་པ་ཅིག།",
    "སྐྱེས་རབས། གི་",
    "ཐུབ་པ་དེ་ལ་ཁྱེད་ཅག་གི་དང་ངེད་ཅག་གི།",
    "བདག་གི་སྨྲ་འདོད་གང་ཡང་རང་གིས་རྟོགས་ནས་སུ།",
    "དགའ་ལས་བདག་གི་༤དེ་ནི་ཁྱེད་ཅག་རྣམས་ཀྱིས་ཉོན།",
    "གང་གིས་གུས་པས་མེ་ནི་ཀུན་ནས་འཕེལ་བར་འགྱུར།",
    "ནོར་དང་འདོད་པ་དག་གི་གཅིག་གི་ཆེད་དུ་ནི།",
    "འཚེ་བ་བྱས་ནས་བདག་གི་ལུགས་དང་མཚུངས་མ་ཡིན།",
    "ཨེ་མ་མཛའ་བོའི་དགེ་ལ་ཁྱོད་ཀྱིས་ངེས་པ་སྟེ།",
    "གང་གིས་ལེགས་པར་བསྙེན་པའི་ལམ་ལ་བཀོད་པར་འགྱུར།",
    "གྱད་རྣམས་དག་གིས་མངོན་མཆོད་ས་སྐྱོང་དེ་རྣམས་ཀྱང་།",
    "དེ་ནས་དྲང་སྲོང་གིས་གདུང་དེ་རྣམས་ཆོ་ག་བཞིན།",
    "སྐྱེས་རབས། གི་",
    "དེ་ནས་རང་གི་ཡུལ་དུ་ཐུབ་པའི་མཆོད་རྟེན་ནི།",
    "ཏི་སེའི་གངས་རིའི་རྩེ་མོ་དང་མཚུངས་དེ་རྣམས་ལ།",
    "རང་གི་སྐྱེ་བོ་དང་བཅས་མི་སྐྱོང་དེ་རྣམས་དང་།",
    "སྨྲ་བ་རྣམས་ཀྱི་མཆོག་གིས་ཇི་ལྟར་གསུངས་པའི་ཚིག།",
    "གང་དུ་གང་ལ་གང་གི་ཚེ་ན་གང་ཞིག་དང་།",
    "འདི་སྐད་བདག་གིས་འདི་ནི་ཐོས་ཞེས་གསུངས་པར་གྱུར།",
    "འཕགས་པ་མོ་རྒྱའི་དཔལ་དེས་སྐྱེ་དགུར་ཕན་དོན་དུ།",
    "དྲང་སྲོང་དེ་ཡི་གདུང་རྣམས་མོ་རྒྱ་ིདེས་བླངས་ནས།",
    "སྟོང་ཕྲག་བརྒྱད་ཅུར་བབས་པ་དུས་སུ་ཞག་གིས་བྱས།",
    "གང་གིས་བྱས་ཤིང་བྱེད་ལ་བྱེད་པར་འགྱུར་བ་སྟེ།",
    "མཆོག་ཏུ་ཐུགས་རྗེ་དང་ལྡན་མཆོག་གི་ཐུགས་མཁྱེན་པ།",
    "དེ་ནི་བརྙེས་ཤིང་གང་གིས་འགྲོ་ལ་བྱིན་པ་སྟེ།",
    "ཐུབ་པའི་ལུང་གི་རྗེས་སུ་འབྲངས་ནས་འདི་བརྩམས་ཏེ།",
    "མི་རྗེ་ལྷ་སྲས་གུང་ཐང་རྒྱལ་མོ་ཡུམ་སྲས་དང་།"
  ]
