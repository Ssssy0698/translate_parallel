    "དཔེ་བཞག་ན་འདྲ་མ་འདི་འདྲ་གདའ།",
    "ཉེར་གཅིག་དུས་རབས་གསར་བའི་དགའ་སྟོན་ལ།",
    "རང་རང་སྟེང་དུ་བྱུང་བ་ཡིན།",
    "བེ་རོ་ཙ་ན་མཁས་པ་མི་དགུ་སོགས།",
    "ཞེས་འཁོད་འདུག་འདིའི་བཅོས་ཐབས་ལ་གཙགས་བུས་མཛེར་བ་བཞར་བའམ།",
    "སྦྲུམ་མའི་ན་ཚོད་དང་རང་བཞིན།",
    "དལ་བར་འདུག་དང་མྱ་ངན་སེམས་ལས་དུབ།",
    "བྱིས་པ་མ་བཙས་སྔོན་གྱི་ཟླ་བ་གསུམ་ལ་འཁྲིག་སྤྱོད་དང་འགྲོ་འདུག་དྲགས་པ།",
    "དེ་ཡང་རང་ཅག་བོད་ཁམས་སུ་རང་བྱུང་ཆུ་ཚན་གྱི་ཐོན་ཁུངས་མང་པོ་ཞིག་ཡོད་པས།",
    "ཞེས་འགྲེལ་བར་མཛད་འདུག་ན།",
    "བཅས་ཡིན་པ་འཁོད་འདུག་པས་སོ།",
    "ཞེས་འཁོད་འདུག་པ་དེ།",
    "ཛ་སག་ཐའེ་ཇིའི་གོ་གནས་ཡོད་པའང་ཁ་ཤས་བྱུང་འདུག་དོ་དམ་པ་ཚོར་གཞུང་ཡིག་ནང་ཞོལ་གཉེར་ཞེས་འཁོད་པ་དང་།",
    "འཇང་བཅས་ལ་ལྗགས་གྲོ་འཁྲི་རྟེན་ས་ཞིང་རང་ཁུངས་སོ་སོར་ཡོད་མུས་ལྟར།",
    "ལྷ་སའི་དབོན་ཞང་རྡོ་རིང་སོགས་སུ་ལྷ་ས་ཞེས་འཁོད་པར་གཞིགས་ན་སྔོན་དུས་ནས་སྤྱོད་སྲོལ་ཡོད་འདུག་ཀྱང་།",
    "ལྷ་ས་དང་ལྷ་སའི་གཙུག་ལག་ཁང་བྱ་བའི་མིང་ཡེ་མི་རྙེད་འདུག་པས།",
    "ད་དུང་རང་བཞིན་བཟའ་བཅའི་རིགས་ལ།",
    "ཤོད་དྲུང་དགའ་བཞི་བ་གཉིས་བཏང་འདུག་ལ།",
    "རྒྱལ་ཐོག་སོག་དུས་བཅས་ནས་དེབ་གཏན་ཡིག་ཪིགས་ཀྱིས་ཆོད་པ་མ་ཚད།",
    "ཀུན་གླིང་བླ་བྲང་ལ་ནང་སྦྱོཪ་གྱི་འཛིན་བདག་བྱེད་མུས་ཡིན་འདུག་པ་བཅས།",
    "ཁྲལ་ཆེན་གསུམ་གྱིས་མཚོན་པའི་ལག་འབབ་དེབ་གསལ་ཆེ་ཕྲ་རྣམས་སྒྲུབ་འབུལ་ཞུ་དགོས་ཞིབ་གཞུང་མཆན་དོན་བཞིན་སྒྲུབ་ཆག་གཏན་ཁེལ་གླེང་མེད་ཞུ་མུས་ཡིན་འདུག་རུང་།",
    "ཕུ་ཐང་ཪིན་སྡིང་པའི་ཐ་རྩི་རྐང་གཉིས་པོ་དགའ་ལྡན་གྲྭ་ཪིགས་ཪེ་གཉིས་ནས་གསཪ་སྦོལ་བྱས་འཐུས་ཀྱིས་ཞོལ་ལས་ཁུང་ནས་འཛིན་དམ་ཐོན་ཚོད་འདུག་པ།",
    "ལག་འབབ་དེབ་གསལ་གྱི་ཁྲལ་ཪིགས་ལ་ཞ་ཆག་མེད་པ་ཀུན་གླིང་བླ་བྲང་ཪང་ནས་ལག་འདོན་གྱི་སྒྲུབ་མུས་ཡིན་འདུག་པ་བཅས།",
    "བྱང་དུ་འཕན་པོ་དང་སྟག་རྩེའི་ཁོངས་ལྕང་ར་ཤར་བཅས་ལ་སྐྱེལ་འདྲེན་ཞུ་དགོས་འདུག་དེ་མཚུངས་ས་ཚིགས་ཡིན་ཚེ་གོང་གསལ་འགྲུལ་ལམ་དུ་རྒོད་འཁར་ལ་དང་།",
    "ཕྱི་ལོ་༡༨༡༧ ལོར་ཨམ་བན་གྱི་སྐད་སྒྱུར་གྱི་ཐབ་འཛིན་དུ་སྩལ་འདུག་པ་དང་།",
    "བཀའ་ཤག་ནས་སོར་གནས་དགོས་རྒྱུའི་འགོ་མཆན་ཐམ་འབྱར་གནང་འདུག་ཀྱང་།",
    "དུ་གནམ་ལ་བརྟེན་པའི་མི་ཁྲལ་མལ་འདུ་སྤྱི་ཚུངས་མཚུངས་དགོས་རྒྱུ་བསུན་སུན་གཙེར་བསྡབས་བསིགས་བརྡབ་གསིག་བྱུང་འདུག་པ་རྐུ་ཐར་དཀར་རུའི་ཤེ་རྫི་གལ་འགངས་ཆེ་ཐོག་དུད་ཆུང་རྣམས་ལ་ཁྲལ་རྟེན་སྦར་མཐིལ་ཙམ་མེད་གཤིས་མལ་འདུ་སྤྱི་འགྲེའི་རག་རྒྱག་ཤིང་འདྲེན་སོགས་བསྐུལ་རྒྱུགས་བྱ་འོས་མ་ཆེ་བས།",
    "ཕྱིས་དོས་རྟ་སོགས་གུང་མཁར་ཕྱོགས་སུ་ཟླ་སྒྲིལ་ཡང་ཡང་བྱེད་དགོས་བྱུང་འདུག་པར་མ་ཟད།",
    "སྒེར་གཞིས་ཀྱི་ནང་ནས་ཆེ་ཤོས་སྒེར་ཧོར་ཁང་ཡིན་འདུག་པ་བཅས་སོ།",
    "རི་འདབས་སུ་ཞིང་ཁ་དང་རང་བྱུང་འབྲོག་ས་ཡོད།",
    "ད་དུང་རང་བཞིན་བཟའ་བཅའི་རིགས་ལ།",
    "ཞེས་ཅི་རིགས་སུ་འཁོད་འདུག་གཉིས་པ།",
    "ཕྱི་ལོ་༡༩༥༨ ལ་མཉེས་ཐང་སེ་ཁང་གཞིས་བོད་གཞུང་ནས་ཁྲི་བྱང་བླ་བྲང་དུ་རྒྱལ་བའི་ཡོངས་འཛིན་གྱི་ལེགས་གསོལ་དུ་སྦྱོར་འཇགས་སྩལ་འདུག་གོ།",
    "དེ་བྱིངས་བརྒྱ་ཆ་ལྔ་ཙམ་གཞུང་རྒྱུག་མི་སེར་ཡིན་འདུག་ཀྱང་།",
    "ཞོལ་ཁང་གསར་བ་བཅས་དྲག་བཙན་བྱིངས་འགྲེ་ལྟར་དྲུང་སྤྱིའི་ཁོངས་སུ་བསྡུ་འབྲེལ་དགོས་གྲས་ཡིན་འདུག་པས་ཡིད་འཇགས་གྱིས།",
    "དྲག་བཙན་པ་སོགས་ཁུམ་ལུས་འདུག་མིན་སྩལ་བ་བཅད་པའི་སྤར་བཅོགས་གཅོག་བྱེད་དགོས་ཕེབས་པར།",
    "ཞི་དྲག་བཙན་གྲས་ཡིན་འདུག་ལགས་ནའང་།",
    "ད་དུང་རང་བཞིན་བཟའ་བཅའི་རིགས་ལ།",
    "ལོའི་ཉི་ཕོག་དུས་ཡུན་ཆུ་ཚོད་༣ ཡས་མས་དང་།",
    "ཞང་གྲོང་འདི་ནས་བདེ་གླིང་བླ་དཔོན་ལ་ཡན་སོ་ལུང་བཞི་པོ་རྒྱ་དེས་སུ་ལྟས་བ་ལས་སྟོང་རྙིང་ཕུད་མེད་ཡིན་ཞུ་བ་ལྟར་དར་མའི་ཁྲལ་གཞུང་ཁག་ལའང་གསལ་བ་བཅས་སྟོང་རྙིང་མིན་འདུག་པའི་ཁྲི་སྒྲུབ་བཅས།",
    "དམའ་ས་སྲང་༡ སྐོར་སྣ་ཚོགས་བཞིན་ཡོད་འདུག་པ་མ་ཟད།",
    "གཞུང་འབུལ་ཕྱག་འབྱོཪ་ཡོང་བསྡུད་ཪིམ་ཅན་གྱི་ལེན་དེབ་སུ་འབུལ་དན་མ་བྱུང་འདུག་པཪ་བརྟེན།",
    "སྒེར་ལྷ་ཀླུ་དགའ་ཚལ་བའི་ཁོངས་ཡབ་མདའ་སྨོན་མཁར་བཅས་ཡོད་འདུག་ཅིང་།",
    "འབྲས་སྒོ་མང་གྲྭ་ཚང་སོགས་ལ་ས་ཞིང་བོགས་མར་བླངས་པའི་བོགས་འབྲུ་ཁལ་༡ སྐོར་སྤྲོད་ཀྱི་ཡོད་འདུག་དེ་མིན་ནམ་མཁའ་དངོས་གཞིར་དམག་རྐང་༢ ལ་སྐུ་སྲུང་གཅིག་དང་།",
    "བཟང་གྲོང་ཀོག་དུས་རོ་ར།",
    "གྲོལ་ཉིན་མ་གཏོགས་འདུ་ཁང་ནང་དུ་ཚོགས་ལ་ཡོང་མི་དགོས་པར་ཇ་ཐུག་འགྱེད་སྐལ་རྣམས་སྒོ་འགྲམ་ནས་བཞེས་སྲོལ་འདུག་ས་བཅད་བདུན་པ།",
    "ཞེས་པ་ཁོང་ཡིན་འདུག་པ་བཅས་སོ།",
    "དུས་རབས་ཉི་ཤུ་པའི་ལོ་རབས་སུམ་ཅུ་པའི་ནང་མཐིང་ཁུང་བརྡིབས་ནས་མི་གྲངས་ཉི་ཤུ་སྐོར་ཤི་སྐད་འདུག་ཐོན་པའི་ཁོངས་ལུག་ར་སོགས་ནས་ཤུག་པ་ཐོན་གྱི་ཡོད་པ་སྤོས་བཟོའི་རྒྱུ་ཆ་གཙོ་བོ་ཞིག་ཡིན།",
    "བཀར་སྐྱིན་ཞེས་པའི་སྐྱེད་འབྲུ་བཅས་བསྡོམས་འབྲུ་རུའི་ཁལ་༧ སྐོར་ཡོད་འདུག་པ་ནས།",
    "ལོ་གཅིག་དུས་བཞིར་གཟི་མདངས་མི་འགྱུར་བའི་གངས་རི་ཆེན་པོ་ཞིག་ཡོད།",
    "ད་དུང་རང་བཞིན་བཟའ་བཅའི་རིགས་ལ་སེར་ཤ་དཀར་ཤ།",
    "དགོང་དྲོ་ཆུ་དཔོན་གྱིས་འཇམ་ཤགས་རྒྱག་དགོས་ཞེས་བཀའ་ཕབ་འཕྲལ་བསྟོད་ཚིག་ཁོ་ན་མ་གཏོགས་རྒྱག་སྲོལ་མི་འདུག་ས་བཅད་བརྒྱད་པ།",
    "རྒྱུན་མཐོང་རང་བྱུང་གནོད་སྐྱོན་ཆུ་ལོག་དང་།",
    "སྔོན་གྱི་གདན་ས་ལྷ་ས་ལས་ཀྱང་ཕྱོགས་དེ་ན་མང་བ་ཙམ་འདུག་འཕན་སྟོད་ནི་འབྲོག་ས་ལྟ་བུ་ཁ་ཞེང་ཆེ་ཞིང་ཉམས་དགའ་བ་ཞིག་སྣང་།",
    "བྲག་རྒྱབ་སོགས་བཀའ་གདམས་པའི་གདན་ས་མིང་ཆེ་ཆེ་ཕལ་ཆེར་ལུང་པ་དེའི་མགོ་མཇུག་ཙམ་ལ་འདུག་བཀའ་གདམས་པའི་དགོན་རྙིང་དེ་ཀུན་ཕལ་ཆེར་མཆོད་རྟེན་གྱིས་གང་བསྡད་པ་ལྟ་བུར་འདུག་ཅེས་དང་།",
    "ཞུ་བ་སོགས་བཀོད་གནང་འདུག་ལ།",
    "སྒེར་འདོན་བཅུ་བཞི་དང་བཞི་ཆ་གཅིག་གཞུང་རྒྱུག་འདོན་ཕྱེད་སུམ་བཅུ་སོ་བཞི་དང་ཉི་ཤུ་རྩ་བཞི་ཆ་གཅིག་བཅས་ཡོད་འདུག་འདིར་དམིགས་བསལ་གཞུང་རྒྱུག་ལ་རྐང་ཞེས་མི་འབོད་པར་འདོན་ཞེས་འབྲི་དགོས་དོན་ནི།",
    "ཅེས་གསལ་འདུག་དེ་ལྟར་ནའང་།",
    "ཟེར་བ་སྔ་སོར་ནས་བཅོ་བརྒྱད་པར་མགོ་བརྟགས་བཏགས་ནས་འདུག་པས།",
    "ཨར་པོ་རག་རྒྱག་གཞན་ཡང་ལས་གཡོར་གར་དགོས་སོགས་རྐང་འགྲོའི་ཁྲལ་རིགས་ཆག་པའི་བཀའ་གཏན་བཙན་དམིགས་ཆེ་བ་ཡོད་འདུག་ཀྱང་།",
    "ཆུ་གླང་མཁར་རྩེ་བཀའ་བཞིས་སུ་ཆོད་པ་ནས་བཟུང་ད་བར་ཁོ་པའི་ཟལ་ཇོ་ན་རྒན་པོའི་ལས་འཁུར་འཕེར་བཀོད་བྱས་པའི་རྒན་གཡོག་བབས་མཚུངས་བཀོད་དེ་ཁྲལ་རིགས་དེ་ཁོས་སུ་ཆག་འདུག་ཀྱང་།",
    "ལམ་ཐོག་བཅས་སྒྲུབ་རྟེན་དེ་ཕྱིན་གཞུང་ཆིབས་རིའི་མི་གྲ་རྟ་ཁག་ལས་ཐོག་ངོ་ཆག་བཀའ་གཏན་གྱི་ཡང་འདུག་པ་ལྟར་འཇགས་གནས་བྱས་ཡོད་པ།",
    "ལམ་ཐོག་བཅས་ཀྱི་ཁྲལ་རིགས་ངོ་ཆག་བཏང་འདུག་པ་ལས།",
    "ཪང་ཁོངས་ཀྱི་བསྟན་སྲུང་ལ་གསོལ་མཆོད་སྤྱི་དགེཪ་བདེ་ཪིམ་གང་འགྲུབ་དམ་དོན་ཐོག་དུས་བཟང་ཉ་སྟོང་བརྒྱད་གསུམ་ལ་ཚེས་བཅུ་མ་ཎི་སྙུང་གནས་ཀྱི་ཀྱིས་མཚོན་འདི་ཕྱིའི་བདེ་འབྲས་ལ་བརྩོན་པ་ཇི་ཆེཪ་ཞུ་བ་ལས།",
    "མལ་གྲོལ་སོགས་ལ་ཡོངས་གྲགས་སུ་གཏོང་སྲོལ་དར་འདུག་གཉིས་པ།",
    "རྗེ་བདག་དུས་ཆེན།",
    "ས་གནས་སྤྱི་ཁྱབ་མེད་སར་ས་གནས་སྤྱི་ཁྱབ་གསར་འཛུགས་གནང་བ་ཡིན་བཟོ་འདུག་དེར་བརྟེན།",
    "ཞེས་ཀྱང་འཁོད་འདུག་ན་བརྟག་པར་མཛོད།",
    "གཞོགས་གཉིས་ལ་ཞིང་ས་དང་རང་བྱུང་འབྲོག་ས་ཡོད།",
    "ད་དུང་རང་བཞིན་བཟའ་བཅའི་རིགས་ལ།",
    "ལོའི་ཉི་ཕོག་དུས་ཡུན་ཆུ་ཚོད་༣༡༨༩༨ དང་ལོའི་སད་མེད་དུས་ཡུན་ཉིན་༡༡ ཡས་མས་ཡིན།",
    "ལོ་ཤས་ཀྱི་རིང་ཆབ་སྲིད་བསྐྱངས་མཐར་གྲོམ་པ་ལྷ་རྩེ་ཕྱོགས་སུ་གནས་སྤོ་བྱས་འདུག་པར་སེམས།",
    "ཅེས་འབོད་སྲོལ་ཡོད་བཟོ་འདུག་པ་ནི།",
    "རྩ་ཐག་སོགས་འཁྲི་སྒྲུབ་བྱེད་དགོས་འདུག་པར་རིས།",
    "ད་དུང་རང་བཞིན་བཟའ་བཅའི་རིགས་ལ།",
    "ཁྲོལ་མ་སོགས་ཤིང་ལས་བྱས་པའི་ཞིང་ལས་ཡོ་ཆས་སྣ་ཚོགས་ཤིག་བཟོ་སྐྲུན་བྱེད་ཀྱི་ཡོད་འདུགགྲགས་ཅན་གྱི་ཁྱད་ལྡན་ཐོན་ལས་གཙོ་བོ་གདོང་དཀར་བོད་ལྷམ་དང་།",
    "བྱེད་སྒོའི་དུས་ཆེན་དེར་མགོ་རྩིས་ཞེས་འབོད་སྲོལ་འདུག་དགའ་གདོང་གར་འཆམ་ནི་ཧོར་ཟླ་བདུན་པའི་ཚེས་ཉེར་དགུ་ཉིན་པ་སྣམ་དགའ་སྡོང་མཚན་སྒྲོག་དགོན་གྱི་གར་འཆམ་བསྐྱོན་སྲོལ་ཡོད།",
    "ལྗང་རྩྭ་དེ་དག་ཕག་རིའི་ཚོང་འདུས་སྐབས་སུ་རིན་གོང་མཐོན་པོའི་ཚོང་སྒྱུར་བྱེད་ཐུབ་ཀྱི་ཡོད་འདུག།",
    "གོང་གསལ་ཁྲལ་རྐང་རྣམས་ལ་ཆ་གསེས་ཀྱིས་རྒྱགས་རང་འཁུར་གྱི་སྐྱེལ་གཏོང་ཞུ་དགོས་ཡོད་འདུགའོན་ཀྱང་།",
    "སྟོན་མཚམས་བཙས་མ་བརྔ་སྐབས་བསྡུ་ལེན་ཆོག་པའི་བཀའ་རྩ་གསོལ་རས་གནང་བ་ལྟར་སྤྲོད་ལེན་བྱེད་སྲོལ་འདུག་དེ་མིན་ཁྲལ་སྐྱོར་དུ་དབུས་གཙང་ཕྱོགས་ནས་སྐྱེལ་འདྲེན་གཡག་པ་དང་།",
    "ཕ་ཇོ་ལྷ་ཁང་བཅས་ལ་རྟ་ཁལ་དོས་སྐྱེལ་གྱི་འུ་ལག་རྒྱུག་དགོས་ཡོད་འདུགཕག་རི་ཚོ་ལྔའི་ནང་ཁྲལ་པ་མིན་པའི་གཏན་སྡོད་ཚོང་རིགས་ཆེ་ཁག་གཅིག་ཡོད་པ་ནི།",
    "ཞིང་པ་ཁྲལ་རྒྱུག་པ་ལྟར་ཁྲལ་རྟེན་ས་ཞིང་མེད་པས་ཁྲལ་རིགས་རྒྱུག་སྲོལ་མི་འདུག་དེ་ལས་ཡ་མཚན་པར་བཟོ་རིགས་ལག་རྩལ་མི་སྣ་ལའང་ལས་ཁྲལ་ཟུར་དུ་འགེལ་རིགས་མེད།",
    "ཐང་ཁག་ལ་ཡུལ་ཇི་ནས་སྒྲ་སྦྲ་རྩེ་གནང་བ་ཡོད་དོན་ཁྱེད་རང་ནས།",
    "བྱ་རྐང་པ་བཅས་ལ་དབྱེ་ནས་བརྩི་སྲོལ་ཡོད་འདུག་ལ།",
    "སྔ་སོར་གམ་པར་མ་རྟ་ཕོན་ཆེ་བཙུགས་པའི་ལོ་ལྟར་དྲེལ་གསར་ཕོན་མི་ཉུང་བ་བྱུང་འདུག་རུང་།",
    "གཞན་ལས་ཁྲལ་རིགས་གསལ་གསར་འགེལ་རིགས་བྱས་མི་ཆོག་པའི་གཏན་ཚིགས་རིམ་པར་ཡོད་འདུག་པར་མ་ཟད།",
    "དརྒོས་ད་དགོས་ཁྲལ་དུས་རྐང་ཕྱེད་དང་དམག་དུས་རྐང་གཅིག་བཅས་ཀྱི་སྒྲུབ་བླངས་ཞ་ཆག་མེད་པ་བྱུང་ཕྱིན།",
    "བར་སྐབས་ཚེ་ཐར་གྱི་ཡོད་ན་ཉུང་ཤས་བརྒྱད་ཅུ་ཚུན་དམག་ཁྲལ་གསར་འགེལ་སོགས་ཀྱི་མཚོན་གཙེར་བ་ཞིག་བྱུང་ཡོད་འདུག་པར།",
    "མཆོད་ཐེབས་དུད་ཆུང་གཉིས་ཙམ་ཞིག་ཡོད་འདུག་པར་ཁྲལ་རིགས་སོགས་གང་ཡང་འཁྲི་རྒྱུན་མེད་པ་ཤ་ལམ་གྲི་ཆོད་ཡིན་འདུག་ཀྱང་།",
    "ཕུག་སྡོད་པས་དུད་ཆུང་ཡིན་ཚུལ་གྱི་འགེལ་གཙེར་བྱས་འདུག་པ་འདི་ཐད།",
    "དགོན་གནས་དེའི་མཚན་ལ་བྲག་སྐྱ་བོ་དེའི་མིང་རང་འཇགས་སུ་ཐོགས་པའམ་བཏགས་པས་ས་སྐྱ་ཞེས་བྱུང་།",
    "རྩེ་གདོང་དང་གེར་གཉིས་སུ་ས་འཛིན་ཁྲལ་རྐང་༡༧ གྲོང་དུད་བསྡོམས་ཐེམ་བཞི་བརྒྱ་སྐོར་ཡོད་འདུག་ཅིང་།",
    "ཨམ་བན་ས་སྐོར་སྐབས་ལས་དོད་ཕྲན་བུ་བཅས་སྒྲུབ་བྱང་བྱས་རྗེས་དེ་ལྷག་རྐང་འགྲོ་ལག་འདོན་གྱི་ཁྲལ་རིགས་ཆེ་ཕྲ་འཁྲི་མེད་ཡིན་འདུག་ཀྱང་།",
    "སྨད་གོས་མཐིང་ནག་ལྷུག་ལྷུག་ནི་ཐུགས་ཀྱི་སྤྲུལ་བ་ཕྱག་ན་རྡོ་རྗེའི་མཚོན་རྟགས་ཞེས་རིགས་གསུམ་མགོན་པོ་མཚོན་དོན་ཡོད་འདུག་པ་བཅས་སོ།",
    "ཉིན་མཚན་དྲོ་ཁྱད་ཆེ་བ་དང་ཉི་ཕོག་དུས་ཡུན་རིང་བ།",
    "ཁྲལ་པ་ཚོས་ཁྲལ་གཞིས་ཐོབ་རྒྱུ་ནི་ལས་སླ་པོ་ཞིག་མིན་པར་དཀའ་ཚེགས་ཅན་གྱི་བརྒྱུད་རིམ་མང་པོ་བརྒྱུད་དགོས་ཀྱི་ཡོད་འདུག་དེ་ཡང་།",
    "རྗེ་དབོན་འོག་དུས་མཆོད་སྲུང་བརྩི་དང་རྩིས་རྒྱག་སྤྲོ་སྐྱིད་སོགས་ལ་རྒྱུ་སྦྱོར་གཏོང་སྒོ་དང་གོ་སྒྲིག་བྱེད་མཁན་གཉེར་པ་ཁག་གསུམ་ཡོད་པ་ནི།",
    "ཆུ་དྲུག་ཕ་དྲུག་བཅས་སུ་འདྲེན་ཚུལ་ཡོད་འདུག་དེ་ཡང་ཤེལ་དཀར།",
    "ལོའི་ཉི་ཕོག་དུས་ཡུན་ཆུ་ཚོད་༢༦༣༨༩ དང་སད་མེད་དུས་ཡུན་ཉིན་༡༧ ཡས་མས་ཡིན།",
    "དེ་ནི་ཕྱི་ལོ་༡༨༥༦ ཟླ་༣ ཚེས་༡༨ ཉིན་གོར་བོད་བར་དམག་དོན་ཆིངས་ཡིག་བཞག་པ་ལས་བྱུང་བ་ཞིག་ཡིན་འདུག་ཅིང་།",
    "བ་འདུག་ས་དགའ།",
    "གཡའ་རི་མགོར་མཚོ་བཅས་ཀྱི་མིང་རྣམས་འཁོད་འདུག་དེ་བཞིན་ལ་ཕྱིའི་བཀྲ་ཤིས་ཚེ་རིང་མ།",
    "སྐམ་རློན་དུས་ཚིགས་རྣམ་པར་གསལ་ཞིང་ཉི་ཕོག་དུས་ཚོད་རིང་བ།",
    "དྲུང་འཁོར་ངོ་མ་ས་གནས་ས་ཐོག་ཏུ་འགྲོ་མཁན་བྱུང་མི་འདུག་ཀྱང་།",
    "ཡམ་གད་ཅེས་པ་གཉིས་འདུག་ཅིང་།",
    "མགྲོན་ཁང་བཅས་ལྟོས་སོ་ཅོག་ལ་སྔར་ཡང་གྲོགས་ཕན་ལེགས་འགྱུར་བྱུང་འདུག་པ་བཅས།",
    "དེ་དག་ལ་ཟ་ཉལ་གུར་བཅས་བཀལ་ཏེ་ལུང་སྟོང་ནང་རི་དྭགས་ཁོ་ན་རྔོན་བརྒྱབ་སྟེ་འཚོ་བ་སྐྱེལ་བཞིན་འདུག་ཅེས་གསལ།",
    "ངམ་རིང་དང་ངང་རིང་ཞེས་ཅི་རིགས་སུ་བཀོལ་འདུག་པས་གང་ཞིག་ཁུངས་བཙན་མིན་མཐའ་གཅིག་ཏུ་ཁ་ཚོན་གཅོད་དཀའ།",
    "ཚོ་དཔོན་སོ་སོའི་ཞི་དྲག་ཁྲལ་བསྐུལ་གྱི་སྐུལ་ཡིག་དུས་སྐྱེལ་དང་།",
    "མེ་སྟག་བཀའ་ཁྲར་ཟུར་བཀོད་དོན་སྨིན་གནང་འོས་མི་འདུག་ཀྱང་།",
    "དར་ཅོག་སོགས་མཚོ་རྫས་སྨོན་འཕྲིན་གྱིས་བརྒྱན་ཏེ་བསྐུར་སྲོལ་འདུག་ཡུལ་དེའི་གཙང་ཆུར་གཅི་ཆུ་དང་།",
    "ཉི་ཕོག་དུས་ཡུན་རིང་ཞིང་འཕྲོ་ཤུགས་ཆེ།",
    "སྒར་དཔོན་བཞི་འགོ་འཛིན་དུ་གསར་བསྐོས་གནང་འདུག་དོལ་བ་རུ་ཤོག་བཞི་ནི་ཤར་མ་དང་།",
    "གཉེར་པ་བཅས་ཀྱི་གླ་ཕོགས་ནི་དམིགས་བསལ་ཟུར་དུ་གཞུང་ནས་གནང་སྲོལ་མི་འདུག་ཀྱང་།",
    "ཁྲལ་ཆད་བྱུང་ན་གསེར་ཟེར་དོན་དེ་ལྟར་ཡིན་འདུག་དེ་མིན་ལྷག་ན་ལོ་རྗེས་མར་ཡང་གྲངས་འབོར་དེ་མཚུངས་སྤྲོད་དགོས་པའི་འཛིན་ཡིག་བཟོ་སྲོལ་ཡོད་པས།",
    "ཞེས་པ་ཕེབས་མྱོང་འདུག་ཅིང་།",
    "དུད་ཚང་༢༦ ལ་མི་གྲངས་༡༧ ཡོད་འདུག་པ་དང་།",
    "ཞ་ཀ་གཞིས་ཀ་ཙ་ནས་གཞིས་ཀ་སོགས་དང་།",
    "ཞེས་པ་སོགས་རིམ་པར་མངག་གཏོང་གནང་འདུག་ལ།",
    "སྟག་ལ་དང་ལུང་བཟང་ལ་གཉིས་ལྷོ་ཤར་དུ་གནས་ཤིང་རི་འདབས་གཡས་གཡོན་ལ་ཞིང་ཁ་དང་རང་བྱུང་འབྲོག་ས་ཡོད།",
    "ད་དུང་རང་བཞིན་བཟའ་བཅའི་རིགས་ལ་སེར་ཤ་དང་།",
    "དེ་རྗེས་དགེ་ལུགས་བཅས་ལ་བསྒྱུར་འདུག་ལ།",
    "ཤོག་༢༡༨ སྟེང་འཁོད་འདུག་ཅིང་།",
    "ས་གནས་སྤྱི་ཁྱབ་མེད་སར་ས་གནས་སྤྱི་ཁྱབ་གསར་འཛུགས་གནང་བ་ཡིན་བཟོ་འདུག་དེར་བརྟེན།",
    "ཞེས་ཀྱང་འཁོད་འདུག་ན་བརྟག་པར་མཛོད།",
    "གཞོགས་གཉིས་ལ་ཞིང་ས་དང་རང་བྱུང་འབྲོག་ས་ཡོད།",
    "ད་དུང་རང་བཞིན་བཟའ་བཅའི་རིགས་ལ།",
    "ལོའི་ཉི་ཕོག་དུས་ཡུན་ཆུ་ཚོད་༣༡༨༩༨ དང་ལོའི་སད་མེད་དུས་ཡུན་ཉིན་༡༡ ཡས་མས་ཡིན།",
    "ལོ་ཤས་ཀྱི་རིང་ཆབ་སྲིད་བསྐྱངས་མཐར་གྲོམ་པ་ལྷ་རྩེ་ཕྱོགས་སུ་གནས་སྤོ་བྱས་འདུག་པར་སེམས།",
    "ཅེས་འབོད་སྲོལ་ཡོད་བཟོ་འདུག་པ་ནི།",
    "རྩ་ཐག་སོགས་འཁྲི་སྒྲུབ་བྱེད་དགོས་འདུག་པར་རིས།",
    "ད་དུང་རང་བཞིན་བཟའ་བཅའི་རིགས་ལ།",
    "ཁྲོལ་མ་སོགས་ཤིང་ལས་བྱས་པའི་ཞིང་ལས་ཡོ་ཆས་སྣ་ཚོགས་ཤིག་བཟོ་སྐྲུན་བྱེད་ཀྱི་ཡོད་འདུགགྲགས་ཅན་གྱི་ཁྱད་ལྡན་ཐོན་ལས་གཙོ་བོ་གདོང་དཀར་བོད་ལྷམ་དང་།",
    "བྱེད་སྒོའི་དུས་ཆེན་དེར་མགོ་རྩིས་ཞེས་འབོད་སྲོལ་འདུག་དགའ་གདོང་གར་འཆམ་ནི་ཧོར་ཟླ་བདུན་པའི་ཚེས་ཉེར་དགུ་ཉིན་པ་སྣམ་དགའ་སྡོང་མཚན་སྒྲོག་དགོན་གྱི་གར་འཆམ་བསྐྱོན་སྲོལ་ཡོད།",
    "ལྗང་རྩྭ་དེ་དག་ཕག་རིའི་ཚོང་འདུས་སྐབས་སུ་རིན་གོང་མཐོན་པོའི་ཚོང་སྒྱུར་བྱེད་ཐུབ་ཀྱི་ཡོད་འདུག།",
    "གོང་གསལ་ཁྲལ་རྐང་རྣམས་ལ་ཆ་གསེས་ཀྱིས་རྒྱགས་རང་འཁུར་གྱི་སྐྱེལ་གཏོང་ཞུ་དགོས་ཡོད་འདུགའོན་ཀྱང་།",
    "སྟོན་མཚམས་བཙས་མ་བརྔ་སྐབས་བསྡུ་ལེན་ཆོག་པའི་བཀའ་རྩ་གསོལ་རས་གནང་བ་ལྟར་སྤྲོད་ལེན་བྱེད་སྲོལ་འདུག་དེ་མིན་ཁྲལ་སྐྱོར་དུ་དབུས་གཙང་ཕྱོགས་ནས་སྐྱེལ་འདྲེན་གཡག་པ་དང་།",
    "ཕ་ཇོ་ལྷ་ཁང་བཅས་ལ་རྟ་ཁལ་དོས་སྐྱེལ་གྱི་འུ་ལག་རྒྱུག་དགོས་ཡོད་འདུགཕག་རི་ཚོ་ལྔའི་ནང་ཁྲལ་པ་མིན་པའི་གཏན་སྡོད་ཚོང་རིགས་ཆེ་ཁག་གཅིག་ཡོད་པ་ནི།",
    "ཞིང་པ་ཁྲལ་རྒྱུག་པ་ལྟར་ཁྲལ་རྟེན་ས་ཞིང་མེད་པས་ཁྲལ་རིགས་རྒྱུག་སྲོལ་མི་འདུག་དེ་ལས་ཡ་མཚན་པར་བཟོ་རིགས་ལག་རྩལ་མི་སྣ་ལའང་ལས་ཁྲལ་ཟུར་དུ་འགེལ་རིགས་མེད།",
    "ཐང་ཁག་ལ་ཡུལ་ཇི་ནས་སྒྲ་སྦྲ་རྩེ་གནང་བ་ཡོད་དོན་ཁྱེད་རང་ནས།",
    "བྱ་རྐང་པ་བཅས་ལ་དབྱེ་ནས་བརྩི་སྲོལ་ཡོད་འདུག་ལ།",
    "སྔ་སོར་གམ་པར་མ་རྟ་ཕོན་ཆེ་བཙུགས་པའི་ལོ་ལྟར་དྲེལ་གསར་ཕོན་མི་ཉུང་བ་བྱུང་འདུག་རུང་།",
    "གཞན་ལས་ཁྲལ་རིགས་གསལ་གསར་འགེལ་རིགས་བྱས་མི་ཆོག་པའི་གཏན་ཚིགས་རིམ་པར་ཡོད་འདུག་པར་མ་ཟད།",
    "དརྒོས་ད་དགོས་ཁྲལ་དུས་རྐང་ཕྱེད་དང་དམག་དུས་རྐང་གཅིག་བཅས་ཀྱི་སྒྲུབ་བླངས་ཞ་ཆག་མེད་པ་བྱུང་ཕྱིན།",
    "བར་སྐབས་ཚེ་ཐར་གྱི་ཡོད་ན་ཉུང་ཤས་བརྒྱད་ཅུ་ཚུན་དམག་ཁྲལ་གསར་འགེལ་སོགས་ཀྱི་མཚོན་གཙེར་བ་ཞིག་བྱུང་ཡོད་འདུག་པར།",
    "མཆོད་ཐེབས་དུད་ཆུང་གཉིས་ཙམ་ཞིག་ཡོད་འདུག་པར་ཁྲལ་རིགས་སོགས་གང་ཡང་འཁྲི་རྒྱུན་མེད་པ་ཤ་ལམ་གྲི་ཆོད་ཡིན་འདུག་ཀྱང་།",
    "ཕུག་སྡོད་པས་དུད་ཆུང་ཡིན་ཚུལ་གྱི་འགེལ་གཙེར་བྱས་འདུག་པ་འདི་ཐད།",
    "དགོན་གནས་དེའི་མཚན་ལ་བྲག་སྐྱ་བོ་དེའི་མིང་རང་འཇགས་སུ་ཐོགས་པའམ་བཏགས་པས་ས་སྐྱ་ཞེས་བྱུང་།",
    "རྩེ་གདོང་དང་གེར་གཉིས་སུ་ས་འཛིན་ཁྲལ་རྐང་༡༧ གྲོང་དུད་བསྡོམས་ཐེམ་བཞི་བརྒྱ་སྐོར་ཡོད་འདུག་ཅིང་།",
    "ཨམ་བན་ས་སྐོར་སྐབས་ལས་དོད་ཕྲན་བུ་བཅས་སྒྲུབ་བྱང་བྱས་རྗེས་དེ་ལྷག་རྐང་འགྲོ་ལག་འདོན་གྱི་ཁྲལ་རིགས་ཆེ་ཕྲ་འཁྲི་མེད་ཡིན་འདུག་ཀྱང་།",
    "སྨད་གོས་མཐིང་ནག་ལྷུག་ལྷུག་ནི་ཐུགས་ཀྱི་སྤྲུལ་བ་ཕྱག་ན་རྡོ་རྗེའི་མཚོན་རྟགས་ཞེས་རིགས་གསུམ་མགོན་པོ་མཚོན་དོན་ཡོད་འདུག་པ་བཅས་སོ།",
    "ཉིན་མཚན་དྲོ་ཁྱད་ཆེ་བ་དང་ཉི་ཕོག་དུས་ཡུན་རིང་བ།",
    "ཁྲལ་པ་ཚོས་ཁྲལ་གཞིས་ཐོབ་རྒྱུ་ནི་ལས་སླ་པོ་ཞིག་མིན་པར་དཀའ་ཚེགས་ཅན་གྱི་བརྒྱུད་རིམ་མང་པོ་བརྒྱུད་དགོས་ཀྱི་ཡོད་འདུག་དེ་ཡང་།",
    "རྗེ་དབོན་འོག་དུས་མཆོད་སྲུང་བརྩི་དང་རྩིས་རྒྱག་སྤྲོ་སྐྱིད་སོགས་ལ་རྒྱུ་སྦྱོར་གཏོང་སྒོ་དང་གོ་སྒྲིག་བྱེད་མཁན་གཉེར་པ་ཁག་གསུམ་ཡོད་པ་ནི།",
    "ཆུ་དྲུག་ཕ་དྲུག་བཅས་སུ་འདྲེན་ཚུལ་ཡོད་འདུག་དེ་ཡང་ཤེལ་དཀར།",
    "ལོའི་ཉི་ཕོག་དུས་ཡུན་ཆུ་ཚོད་༢༦༣༨༩ དང་སད་མེད་དུས་ཡུན་ཉིན་༡༧ ཡས་མས་ཡིན།",
    "དེ་ནི་ཕྱི་ལོ་༡༨༥༦ ཟླ་༣ ཚེས་༡༨ ཉིན་གོར་བོད་བར་དམག་དོན་ཆིངས་ཡིག་བཞག་པ་ལས་བྱུང་བ་ཞིག་ཡིན་འདུག་ཅིང་།",
    "བ་འདུག་ས་དགའ།",
    "གཡའ་རི་མགོར་མཚོ་བཅས་ཀྱི་མིང་རྣམས་འཁོད་འདུག་དེ་བཞིན་ལ་ཕྱིའི་བཀྲ་ཤིས་ཚེ་རིང་མ།",
    "སྐམ་རློན་དུས་ཚིགས་རྣམ་པར་གསལ་ཞིང་ཉི་ཕོག་དུས་ཚོད་རིང་བ།",
    "དྲུང་འཁོར་ངོ་མ་ས་གནས་ས་ཐོག་ཏུ་འགྲོ་མཁན་བྱུང་མི་འདུག་ཀྱང་།",
    "ཡམ་གད་ཅེས་པ་གཉིས་འདུག་ཅིང་།",
    "མགྲོན་ཁང་བཅས་ལྟོས་སོ་ཅོག་ལ་སྔར་ཡང་གྲོགས་ཕན་ལེགས་འགྱུར་བྱུང་འདུག་པ་བཅས།",
    "དེ་དག་ལ་ཟ་ཉལ་གུར་བཅས་བཀལ་ཏེ་ལུང་སྟོང་ནང་རི་དྭགས་ཁོ་ན་རྔོན་བརྒྱབ་སྟེ་འཚོ་བ་སྐྱེལ་བཞིན་འདུག་ཅེས་གསལ།",
    "ངམ་རིང་དང་ངང་རིང་ཞེས་ཅི་རིགས་སུ་བཀོལ་འདུག་པས་གང་ཞིག་ཁུངས་བཙན་མིན་མཐའ་གཅིག་ཏུ་ཁ་ཚོན་གཅོད་དཀའ།",
    "ཚོ་དཔོན་སོ་སོའི་ཞི་དྲག་ཁྲལ་བསྐུལ་གྱི་སྐུལ་ཡིག་དུས་སྐྱེལ་དང་།",
    "མེ་སྟག་བཀའ་ཁྲར་ཟུར་བཀོད་དོན་སྨིན་གནང་འོས་མི་འདུག་ཀྱང་།",
    "དར་ཅོག་སོགས་མཚོ་རྫས་སྨོན་འཕྲིན་གྱིས་བརྒྱན་ཏེ་བསྐུར་སྲོལ་འདུག་ཡུལ་དེའི་གཙང་ཆུར་གཅི་ཆུ་དང་།",
    "ཉི་ཕོག་དུས་ཡུན་རིང་ཞིང་འཕྲོ་ཤུགས་ཆེ།",
    "སྒར་དཔོན་བཞི་འགོ་འཛིན་དུ་གསར་བསྐོས་གནང་འདུག་དོལ་བ་རུ་ཤོག་བཞི་ནི་ཤར་མ་དང་།",
    "གཉེར་པ་བཅས་ཀྱི་གླ་ཕོགས་ནི་དམིགས་བསལ་ཟུར་དུ་གཞུང་ནས་གནང་སྲོལ་མི་འདུག་ཀྱང་།",
    "ཁྲལ་ཆད་བྱུང་ན་གསེར་ཟེར་དོན་དེ་ལྟར་ཡིན་འདུག་དེ་མིན་ལྷག་ན་ལོ་རྗེས་མར་ཡང་གྲངས་འབོར་དེ་མཚུངས་སྤྲོད་དགོས་པའི་འཛིན་ཡིག་བཟོ་སྲོལ་ཡོད་པས།",
    "ཞེས་པ་ཕེབས་མྱོང་འདུག་ཅིང་།",
    "དུད་ཚང་༢༦ ལ་མི་གྲངས་༡༧ ཡོད་འདུག་པ་དང་།",
    "ཞ་ཀ་གཞིས་ཀ་ཙ་ནས་གཞིས་ཀ་སོགས་དང་།",
    "ཞེས་པ་སོགས་རིམ་པར་མངག་གཏོང་གནང་འདུག་ལ།",
    "སྟག་ལ་དང་ལུང་བཟང་ལ་གཉིས་ལྷོ་ཤར་དུ་གནས་ཤིང་རི་འདབས་གཡས་གཡོན་ལ་ཞིང་ཁ་དང་རང་བྱུང་འབྲོག་ས་ཡོད།",
    "ད་དུང་རང་བཞིན་བཟའ་བཅའི་རིགས་ལ་སེར་ཤ་དང་།",
    "དེ་རྗེས་དགེ་ལུགས་བཅས་ལ་བསྒྱུར་འདུག་ལ།",
    "ཤོག་༢༡༨ སྟེང་འཁོད་འདུག་ཅིང་།",
    "ལྷོ་ཁ་ཕྱོགས་ཀྱི་དྲུང་འཁོར་འདྲ་ཡང་ཁ་ཤས་འདུག་པ་འབེམ་ལ་ས་པ་གྲུ་པའི་དམག་དཔོན་བཀྲ་ཤིས་འབྲུག་མ་གཏོགས་ཕེབས་མཁན་མ་བྱུང་བས།",
