    "ཚོར་བ་སོ་སོར་བྱ་སྟེ་ཐམས་ཅད་དུ་འདུག་གོ།",
    "ཕྱོགས་མཐོན་པོར་འདུག་ལ་ཕྱོགས་བཞིར་བལྟ།",
    "དགེ་སློང་བཞིར་མ་ཚང་སྟེ་གསུམ་མན་ཆད་ཅིག་འདུག་ནའང་གཅིག་ལ་གཅིག་ཉེས་པ་ཅི་ཡོད་པ་བརྟགས་ཏེ་དཔང་བཙུགས་ིཏེ་གཞག་གོ།",
    "འབའ་ཞིག་ན་འདུག་སྟེའོ།",
    "དགེ་སློང་མང་དུ་མེད་དེ་གཉིས་སུ་འདུག་ན་ཉེ་བར་ཙོག་ཙོག་པོར་ཕས་འདུག་ཚུས་ིའདུག་སྟེ་གཅིག་ལ་གཅིག་བརྟག་གོ།",
    "བྲག་༡༢ ༧ ༡བར་དུ་བསྡད་དེ་མ་འོངས་ན་གསུམ་ཆར་ཁྲིའུའི་སྟེང་དུ་འཁོད་དེ་འདུག་ལ་བརྟགས་ཏེ་གཞག།",
    "ཡང་དག་པར་བྱས་པ་དེར་འདུག་པར་འདོད་ནའོ།",
    "མུར་འདུག་བར་དུ་གཅོད་ན་ཆད་པས་རབ་ཏུ་བཅད་དེ་ཁྲོས་པ་དང་འཁྲུགས་པས་ནི་མི་བསྟན།",
    "དགེ་སློང་ཀུན་མུར་འདུག་ཏུ་ཞུགས་པ་དང་།",
    "ཤིང་གཅིག་འདུག་པའི་མཚམས་ཀྱིས་དུ་མ་བཞིའི་མཚམས་སོ།",
    "སྒྱུ་མར་སྤྲུལ་ཅིང་འདུག་པ་ལྟ་བུ་ལ་མཚན་མར་མི་གཟུགས།",
    "གྲལ་ཐོག་མ་པས་ཁ་དོན་ཀློག་མི་ནུས་ན་དེའི་འོག་ནས་འདུག་པ་ལ་མེ་ཏོག་བྱིན་ཏེ་བྱེད་དུ་གཞུག་གོ།",
    "དེས་ཀྱང་མ་ིནུས་ན་གཉིས་ཀྱི་འོག་ནས་དགེ་སློང་སུ་འདུག་པ་ལ་མེ་ཏོག་བྱིན་ཏེ་ཀློག་ཏུ་གཞུག་གོ།",
    "མི་འདུག་པར་འགྲོགས་ཏེ་དོང་བ་ན་ཡང་བྱ།",
    "ལུ་༡༨༡༢༩༦ཐ་མར་ས་དང་ཟུང་ང་བླངས་ཏེ་མདུན་དུ་འདུག་ལ།",
    "དགུན་ནི་དྲོ་བ་འདིར་འདུག་གོ།",
    "ཞག་ལྔ་ཞིག་འདིར་འདུག་ཞག་དྲུག་ཅིག་འདིར་འདུག་གོ་ཞེས་ཟེར་ཞིང་གནས་གཅིག་ཏུ་མ་བཅད་པར་མནོད་པར་མི་བྱའོ།",
    "༡༨༡༣  ༢བརྟགས་པ་ཡིན་པས་བདག་ཀྱང་འདིར་མི་འདུག་གོ།",
    "འདུག་པའི་ཁྲི་ཆེན་པོ་རྒྱབ་རྟེན་ཅན་དང་ཁྲི་ཆུང་དུ་ཡང་བགོའོ་། གདིང་བ་ཡང་ངོ།",
    "བྱིས་པའི་སྐྲ་རལ་བུར་འདུག་འདུག་པ་ལས་འདྲེག་པའི་ཚེ་བཀྲ་ཤིས་ཀྱི་ཕྱིར་འབོད་པ་དང་།",
    "མུར་འདུག་ཏུ་ལྟ་བ་དབྱེ་བའི་ཕྱིར་དང་།",
    "གྱི་ན་མི་སྨྲ་བར་འདུག་པར་བསམས་པ་ནི་ཉེས་བྱས་སོ།",
    "ཟས་དང་ཁང་བུ་ལ་སོགས་པ་ཅི་འདོད་པ་ངེད་ལ་ནོས་ལ་༧ ཅི་དགོས་པ་ལ་སོགས་པ་ལོང་ལ་འདུག་ཤིག་ཅེས་བསྒོ།",
    "འདོམ་གང་ཙམ་དུ་འདུག་ལ་དགུས་ཏེ་བཟོད་པ་བགྱིར་ཅི་གནང་ཞེས་གསོལ་ལོ།",
    "རས་སང་སེང་དུ་འདུག་ཅིང་ཐགས་བཟང་ངན་དུ་འདུག་པ་དང་།",
    "དགེ་སློང་སོ་སོའི་མདུན་དུ་འདུག་སྟེ་གདིང་ངོ་ཞེས་བྱའོ།",
    "དེ་བས་ན་དད་པ་མ་བྱིན་པ་ཉལ་ལམ་བསམ་གཏན་དུ་ཞུགས་ཤིང་འདུག་ན་གདིང་བའམ་དབྱུང་བ་མི་སྐྱེ་སྟེ་བརྙན་ཚུན་ཆད་དུའོ།",
    "ཉེས་མེད་པ་ནི་བཏིང་བ་དྲུབས་ནས་སྦྱར་མ་མེད་པར་གྲོང་དུ་འཇུག་པ་ལ་སོགས་ཏེ་མངོན་སུམ་དུ་འདུག་པས་ཡང་ངོ།",
    "གཡོགས་མའི་ཡིན་པའི་ཁྲི་དང་ཁྲིའུ་ལ་དེའི་མ་ཡིན་པའི་གདིང་བ་དང་འདུག་པའི་བར་དུ་བགོ་བའི་ནང་དུ་མ་ཡིན་ལ།",
    "གཙུག་ལག་ཁང་གཅིག་ན་དགེ་སློང་གཅིག་པུ་འདུག་པ་ལས་ཡོན་བདག་དད་པས་ཡོན་མང་ཞིག་ཕུལ་ན་དགེ་སློང་གཅིག་པུ་དེས་ཁྱེར་ཡང་ཉེས་མེད།",
    "མཚམས་ཀྱི་བར་ན་འདུག་པ་ལུས་ལ་ཆགས་པའམ་གཞན་ཡང་ཇི་སྙེད་དུ་ཆུད་པ་དེ་གཏོགས་སོ།",
    "༡༨༡ ༣ ༥ ༢པ་ལ་གཏམས་ཤིང་འདུག་པ་ལས་དགེ་སློང་ཕོངས་པས་ིབླངས་ཏེ་བྱིན་ན་ནི་ཉེས་མེད་དོ།",
    "དགེ་སློང་གུད་དུ་འགྲོ་ན་བདག་འདུག་འདུག་པའི་གནས་ཕྱག་དར་དང་ཆག་ཆག་ལ་སོགས་པ་བྱས་ཏེ་འགྲོ།",
    "གསང་ིབའི་ཕྱོགས་སུ་སྒྲ་བསྐྱུངས་ཏེ་མཛེས་ཤིང་རབ་ཏུ་བསྡམ་པའི་སྤྱོད་པས་སོ་།་འགྲེངས་ཏེ་འདུག་པ་ནི་ཀུན་གྱིས་མཐོང་ཞིང་གསལ་བའི་ཕྱོགས་སུ་སྒྲ་བསྐྱུངས་ལ་མཛེས་ཤིང་ཚུལ་བསྡམས་ཏེ་གཏོགས་འདོད་དང་ཤེས་འདོད་མི་བྱ་བར་འདུག་གོ།",
    "མུར་འདུག་ངོ་ཤེས་ཤིང་གཡོ་མི་བྱེད་པ་ཞིག་འོངས་ན་འང་ངལ་སོར་གཞུག།",
    "སྟོད་ཏྲ་ིབྱ་བ་ནི་དགའ་བར་བྱ་བའི་ཕྱིར་ཀུན་གྱིས་མཐོང་བར་ས་མཐོན་པོར་འདུག་སྟེ་བྱའོ།",
    "དེ་ལྟ་བུའི་རྐྱེན་མེད་ན་མ་བཅད་པར་གྲོང་དང་ཁྱིམ་དུ་འཇུག་པ་དང་འདུག་པ་མ་ཡིན།",
    "ཡོད་ན་འདུག་པར་མ་ཡིན།",
    "ཡུལ་གཞན་དུ་འདུག་པ་ལ་བརྟགས་ན་མི་འཇིག།",
    "དེའི་ཕྱིར་བསྙུང་བུ་དང་གླ་ིརྒྱུན་བཅངས་ཡན་མན་ཡུལ་རྒྱུ་བའམ་གནས་ན་འདུག་པའང་ིརང་ལྷམ་རལ་ན་བཙེམ་པའི་ཕྱིར་གླ་༧རྒྱུན་དང་བསྙུང་བུ་བཅང་བཟོ་གྲི་མ་ཡིན།",
    "གྲོང་དུ་གཞན་མེད་ན་པགས་པ་ལ་འདུག།",
    "གྲོང་དུ་སྤྱན་དྲངས་ཏེ་པགས་པ་སྟན་དུ་བཏིང་ན་སྟན་གཞན་མེད་དམ་ཞེས་སྨྲོས་ཏེ་སྟན་གཞན་མེད་ཅེས་ཟེར་ན་པགས་སྟན་ལ་འདུག་ཀྱང་ཉེས་མེད་དོ།",
    "མཐོ་རིས་ཀྱི་ཁམས་ན་འདུག་པ་ཞིག་སྟེ་འདི་ཡང་མར་དུ་གཏོགས་ཏེ་ཞག་བདུན་པའོ།",
    "གཏར་ག་ལྕགདོད་ལ་བྱ་ན་རྩ་ག་ལ་འདུག་པའི་སྟེང་དུ་བྱས་པ་ནི་ཉེས་མེད་དོ།",
    "གནས་བརྟན་གྱིས་བརྗེད་ན་དྲུང་ན་སུ་འདུག་པས་ཀྱང་དྲི།",
    "ལྟག་ཏུ་ཤ་བཟར་མི་རུང་བའི་རྣམས་དང་འོ་མ་རྣམ་གཉིས་ཟོས་ན་ཉེས་བྱས་སུ་འགྱུར་གྱི་མི་བཟའ་བར་འབྲས་སམ་སྣ་ལ་ཕན་པའི་ཕྱིར་གླན་པ་དང་སྲབ་ཅིང་འདུག་པ་ལ་སོགས་པ་ལུས་ཀྱི་ཕྱིར་ལོགས་སུ་སྤྱད་པ་ནི་ཉེས་མེད་དོ།",
    "ཟན་བཟའ་བར་ས་ལ་འདུག་སྟེ་ཟོས་ན་དེ་ཆོག་གོ་ཞེས་ིབྱས་ཏེ་སླར་གཏོང་ིབ་ལས་ཡང་སླར་འོན་ཅིག་ཅེས་བྱས་ཏེ་ཟོས་ཀྱང་རུང་ལངས་ཏེ་ཡང་སླར་འདུག་ན་ཟོས་ཀྱང་ཉེས་མེད་དོ།",
    "གྲོང་དུ་སློང་བའི་ཚེ་ལམ་སྲང་གྱ་གྱུ་མང་དུ་འདུག་ན་ཐོག་མའི་ལམ་སྲང་མི་ནོར་བར་བསམ་ཞིང་།",
    "རྩྭའི་༧ ཐུམ་པོ་ལ་འདུག་ཀྱང་རུང་དགེ་སློང་སྟན་མེད་ན་རྩྭའི་ཐུམ་པོ་ལ་འདུག་ཀྱང་ཉེས་མེད་དོ།",
    "དགེ་སློང་རྒན་པོ་དང་གཞོན་ནུ་དང་དགེ་སློང་ཞིག་ིའདུག་ན་འདྲིམ་པ་ལ་མཉམ་པའི་ཕྱིར་སོ་སོར་བཀང་དུ་བཅུག་ལ་ཞལ་ཏ་བ་མང་དུ་བསྐོས།",
    "དགེ་སློང་མ་ཚར་གཅིག་ཏུ་བཀང་ན་ལྟག་ཏུ་སྟན་རིམ་པ་གཉིས་གསུམ་བོར་ལ་འདུག་པར་བྱའོ།",
    "༡༨༡༤༢ ༢སྟེ་ཅ་ཅོ་མེད་པར་སྒྲ་བསྐྱུངས་ཏེ་འདུག།",
    "སྟན་ལ་འདུག་པའི་ཚེ་གོང་མ་རྣམས་བཞུགས་ལ་འདུག་གོ།",
    "དེར་ཆུད་པ་བཞིན་དུ་གཞན་གྱིས་སྤྱན་དྲངས་ཏེ་འདུག་པ་ལས་དེས་གནང་ནས་གཞན་གྱིས་བྱིན་ནའོ།",
    "ཟ་བའི་ཕྱིར་འདུག་པ་ལ་འདི་དང་འོ་ན་བྱིན་ལེན་ཞེས་འདྲིམ་པ་ལ་མི་བསྒོ།",
    "ཐོས་ན་དེར་ཞུགས་པས་ཀྱང་ངོ་། ཕྱི་ལོགས་ནས་འོངས་པས་སྐྲ་བྱས་ན་ནང་ན་འདུག་པས་ཡོད་པར་༧གོ་བར་བྱ་བའི་ཕྱིར་སྒྲ་ཡང་ིབྱ།",
    "ཉེས་མེད་པ་ནི་ཟ་གུ་སྟེ་ཐ་མར་ཕྱིས་མཚམས་ཏེ་འདུག་ཀྱང་ངོ།",
    "དེ་ལས་གཞན་གྱི་ཆུ་ཡོད་ན་མ་བཀྲུས་པར་མི་འདུག།",
    "ཁ་རོག་ཏུ་འདུག་ཅེས་པ་ཡན་ཆད་དོ།",
    "འཁོར་དུ་མ་འདུག་ན་མ་རྫོགས་པའོ།",
    "འདུག་པ་ལས་ལས་ཀྱི་མགོ་བརྩམས་ཏེ་མ་ཟིན་པར་གྲལ་ན་ཉི་ཤུ་ནི་ལུས་དོང་བ་རྣམས་ཀྱིས་དད་པ་མ་སྦྱིན་ིནའང་ལས་སུ་མི་རུང་།",
    "གང་ཟག་ལ་འབུལ་བ་ན་ཚིག་ལན་གསུམ་བཟླས་ཏེ་སྨྲ་མདུན་དུ་ཙོག་ཙོག་པོར་འདུག་པ་ལས་ཏེ་བཏང་བ་ཡང་ངོ།",
    "ལུ་༡༨༡༤༥ ༢འདུག་པ་ལ་གསོལ་བ་དང་ཞུ་བ་དང་བར་ཆད་དྲི་བ་བྱ།",
    "ལས་ནི་འདུག་སྟེའོ།",
    "བསྔོ་བ་དང་བརྟག་པ་གཉིས་གུད་ན་བཞག་ལ་བདག་འདི་ན་འདུག་པས་སྔགས་གདབ་ཏུ་མི་རུང་ངོ།",
    "ཚུལ་ནས་འབྱུང་འཇུག་དང་བརྟག་པ་དང་བསྔོ་བ་ལ་སོགས་པའི་སྔགས་གྲོགས་གཅིག་དང་གཉིས་འདུག་ལ་སྔགས་གདབ་པའི་ཚེ་བདག་པས་ན་རྒན་པ་ཞིག་ཡིན་ན་ཕྲག་པ་གཡས་པ་ཕྱུང་ལ་གུས་པའི་ཚུལ་དུ་ལས་བྱའོ།",
    "དགེ་སློང་གོས་བདག་པོས་ནི་དྲུང་ན་འདུག་པས་ཨོ་པ་ཡི་ཀ་ཞེས་སྨྲས་པའི་རྗེས་ལས་དུ་ཞེས་ལན་གསུམ་དུ་བརྗོད་དོ།",
    "མཚམས་བཅད་པ་གང་ཚུན་ཆད་བཅད་པའི་ཕྱི་རོལ་དུ་འདུག་སྟེ།",
    "དེ་བཞིན་དུ་གང་ཟག་བཅུ་གཉིས་ཀྱི་ལས་སུ་བསྐོས་པ་ཡང་མཚམས་ཀྱི་ནང་དུ་འདུག་ལ་བྱའོ།",
    "འདུག་པར་བྱེད་པས་འདུག་པར་བསྒོ་སྟེ་གཎྜི་བརྡུངས་པ་དང་དྲིས་སྨྲོས་ཤིག་བསྒོ།",
    "མཚམས་གཞན་དུ་འདུག་པ་ནི་གང་དུ་ཡང་ཡན་ལག་མ་ཡིན་ནོ།",
    "གཉིས་སུ་འདུག་པ་ནི་ཚུ་ལོགས་སུ་རྐང་པ་གཅིག་ཕ་ལོགས་སུ་རྐང་པ་གཅིག་ནའོ།",
    "ཀུན་སྤྱོད་མི་ནུས་ན་བདག་གར་དགའ་བར་འདུག་ལ་སྤྱོད་ཅིག།",
    "མུར་འདུག་དང་བསྟེན་པ་དང་།",
    "མུར་འདུག་དང་བསྟེན་པ་༧འདི་གཉིས་ལ་ཡན་ལག་གཅིག།",
    "མཚམས་གཞན་དུ་འདུག་པ་ལ་ཡང་ངོ།",
    "དགེ་སློང་གྲོགས་ལ་བསྔོ་བ་གྲོགས་ནམ་མཁའ་ལ་འདུག་གམ་མཚམས་ཀྱི་ཕྱི་རོལ་ན་འདུག་པ་ལ་བདག་མཚམས་ཀྱི་ནང་ངམ་ས་ལ་འདུག་པས་བསྔོ་ན་ིབསྔོས་པར་ནི་ཆུད་ཀྱི་ཉེས་བྱས་སོ།",
    "འདུག་ན་བཅང་།",
    "ལྷུང་བཟེད་ཁས་ཕུབ་ཨེཔའི་ཁྱིམ་དུ་ནོར་ཏེ་ཕྱིན་ནས་སྟན་ལ་འདུག་ཅེས་ཟེར་ཀྱང་མི་འདུག།",
    "དགེ་སློང་རང་བཞིན་ཉམས་ཏེ་སྨོས་པའི་ཚེ།",
    "ལྷག་མ་བྱས་ནས་བདག་འཁོར་དུ་མཐོལ་དུ་དགེ་སློང་གྲོགས་མེད་དེ་རྒྱང་གྲགས་གཅིག་གཉིས་ཕན་ཆད་གཅིག་ན་དགེ་སློང་འདུག་ལ་གཅིག་ལ་མཐོལ་དུ་འགྲོར་ལམ་དུ་ཆུས་ཆོད་དེ།",
    "ལུ་༡༨གྲགས་གཉིས་གསུམ་ཙམ་གྱི་དགེ་སློང་འདུག་པ་ལ་ནམ་ཕྲད་པ་ན་མཐོལ་བར་བསམས་ཏེ་སེམས་ལ་བཅབས་པའི་སེམས་མེད་ིན་ལེ་ལོ་བྱས་ཏེ་མྱུར་དུ་མ་མཐོལ་ཀྱང་བཅབས་པར་མི་འགྱུར།",
    "ཆད་པ་པ་སྟན་མཐོན་པོ་ལ་བཞག་སྟེ་ཆད་པ་མེད་པ་སྟན་དམའ་བ་ལ་མི་འདུག།",
    "མུར་འདུག་སེམས་བརྟག་༧ པའི་ཕྱིར་ཟ་ཅིབ་གཅིག་ཏུ་གཞག་པའང་ལྷན་ཅིག་ཏུ་ཉལ་ན་ཉེས་མེད་དོ་ཞེས་བྱི་ཛ་ཡས་བཤད།",
    "ལམ་སྲང་ངམ་གྲོང་བར་ན་འདུག་ན་བྱོལ་ཏེ་འགྲོ།",
    "སྟན་གཅིག་ལ་འདུག་པ་དང་འཆགས་གཅིག་ཏུ་འཆག་པ་དང་གཏམ་དང་གཏམ་ཀུན་ཀྱང་ངོ།",
    "དགེ་སློང་གཉིས་ཤིག་རྩོད་ཅིང་འདུག་འདུག་པ་ལས་རྩོད་པའི་འཕྲོ་ལས་ཤིའམ་ཁྱིམ་པར་བབས་ཏེ་ལམ་རིང་པོར་བབས་ིན་ཞི་བར་འགྱུར་རོ།་",
    "གཞན་གྱི་གྲོང་ན་འདུག་པ་དང་།",
    "ཟན་ལ་འདུག་པ་མ་གཏོགས་སོ།",
    "འདུག་གམ་འཕྲེས་ན་འདུག་སྟེའོ།",
    "༡༥ ༣ ༣ལས་ཁ་ཏོན་ནོད་པའི་ཚེ་བདག་སྟན་དམའ་བ་ལ་འདུག་སྟེ་མནོད།",
    "གཙུག་ལག་ཁང་སློང་བའི་དགེ་སློང་བསོད་སྙོམས་པ་ཡིན་པ་ཞིག་དུས་ལས་སྔར་བསོད་སྙོམས་ལ་འགྲོ།",
    "ལྟག་མའི་ཁྲི་འདུག་པའི་གཞི་རྐང་པ་སེང་གེ་བཞིའི་གཟུགས་བྱའོ།",
    "སེང་གེའི་ཁྲི་ལ་འདུག་པའི་ཚེ་རྐང་པ་གཞག་པའི་ཁྲིའུ་གཅིག་གཞག།",
    "མཆོད་སེང་གེའི་ཁྲི་ལ་འདུག་པའི་མདུན་དུ་མེ་ཏོག་དང་།",
    "ཁྲི་ལ་དགེ་སློང་གསུམ་ལས་མང་དུ་ལྷན་ཅིག་མི་འདུག་འཆག་པའི་ཕྱིར་རོ།",
    "ཐ་མལ་པ་ལ་ཁྲིའུ་ཆུང་དུ་གྲུ་བཞི་ལ་མི་གཅིག་ལས་ལྷག་པར་མི་འདུག་པར་ལོ་དུ་མ་མ་ཡིན།",
    "དགེ་སློང་ནང་ལོ་མ་ལོན་པ་དང་ལོ་གསུམ་ལོན་པ་མན་ཆད་ནི་སྟན་གཅིག་ལ་འདུག་ཏུ་རུང་ངོ།",
    "བར་དུ་ལོ་གསུམ་གྱིས་ཆོད་ན་གནས་བརྟན་མན་ཆད་གང་ཡང་སྟན་གཅིག་ལ་འདུག་ཏུ་རུང་ངོ།",
    "ལོ་བཞི་ལོན་ན་ལྷན་ཅིག་ཏུ་འདུག་ཏུ་མི་རུང་ངོ།",
    "དགེ་སློང་དང་སྟན་གཅིག་ཏུ་མི་འདུག་།",
    "མ་ནིང་དང་ཟ་མ་དང་མ་བསད་པ་ལ་སོགས་པ་དང་མུར་འདུག་དང་མུར་འདུག་ཏུ་འཇུག་པ་དང་།",
