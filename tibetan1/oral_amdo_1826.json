    "གང་གི་ཕྱིར་དེ་ལྟར་ན་སྡུག་པར་གདགས་པ་ལ།",
    "གདགས་པར་བྱ་བ་ཞེས་བྱ་བ་ནི་གོང་གི་མི་སྡུག་པ་དང་སྦྱར་རོ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་ན་མི་སྡུག་པར་གདགས་པ་ལ་སྡུག་པ་ཞེས་བྱ་བ་ལྟོས་པར་བྱ་བ་དངོས་པོ་འབྲེལ་པ་ཅན་གཞན་ཡོད་པ་མ་ཡིན་པ།",
    "གང་གི་ཕྱིར་དེ་ལྟར་། སྡུག་པ་དང་མི་སྡུག་པ་དག་ཡོད་པ་མ་ཡིན་པ་དེའི་ཕྱིར།",
    "འདི་ལྟ་སྟེ་ཕུང་པོ་ལྔ་པོ་སྐད་ཅིག་རེ་རེ་ལ་འཇིག་ཅིང་མི་རྟག་པ་ལ་རྟག་གོ་སྙམ་དུ་འཛིན་པ་གང་ཡིན་པ་དེ་ནི་ཕྱིན་ཅི་ལོག་ཡིན་ནོ།",
    "འདོད་པ་གང་གིས་དེ་ལ་ཆགས།",
    "དེ་བཞིན་དུ་ཕུང་པོ་ལྔ་པོ་བདག་གི་མཚན་ཉིད་དང་མི་མཐུན་པ་མི་རྟག་པའི་ཕྱིར་དང་།",
    "བདག་མེད་ཅིང་བདག་གི་རང་བཞིན་གྱིས་སྟོང་བཞིན་དུ།",
    "དེ་ལྟར་ན་ཕྱིན་ཅི་ལོག་བཞི་པོ་དེ་དག་ནི་གཏི་མུག་གི་རྒྱུར་གྱུར་པ་ཡིན་ད་ནི་འདིར་འདི་དཔྱད་པར་བྱ་སྟེ།",
    "གང་གི་ཚེ་སྟོང་པ་ལ་མི་རྟག་པ་ཉིད་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་མི་རྟག་པ་ཉིད་མེད་པས་དེ་དང་འགལ་བའི་རྟག་པ་ཉིད་ཕྱིན་ཅི་ལོག་ཏུ་ག་ལ་འགྱུར།",
    "གང་གི་ཚེ་རང་བཞིན་གྱིས་སྟོང་པས་སྡུག་བསྔལ་ལ་སོགས་པ་མེད་པ་དེའི་ཚེ་དེ་དག་གི་མི་མཐུན་པའི་ཕྱོགས་སུ་གྱུར་པའི་རྟག་པ་དང་བདེ་བ་དང་གཙང་བ་དང་བདག་ཀྱང་ཕྱིན་ཅི་ལོག་ཏུ་ལྟ་ག་ལ་འགྱུར།",
    "གང་གི་ཚེ་རྟག་པ་ཉིད་དང་མི་རྟག་པ་ཉིད་གཉི་ག་ཡང་ཕྱིན་ཅི་ལོག་ཡིན་པ་དེའི་ཚེ།",
    "གང་གི་ཚེ་ཕྱིན་ཅི་མ་ལོག་པར་འགྱུར་བ།",
    "གང་གི་ཚེ་ཕྱིན་ཅི་མ་ལོག་པ་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་ཅི་ལ་ལྟོས་ནས་ཕྱིན་ཅི་ལོག་ཏུ་འགྱུར།",
    "བདག་གིས་འདོད་ཆགས་སྤང་བར་བྱའོ་སྙམ་པ་འདི་ནི་གཉིས་སོ།",
    "བདག་གིས་ཞེ་སྡང་སྤང་པར་བྱའོ།",
    "བདག་གིས་གཏི་མུག་སྤང་བར་བྱའོ་སྙམ་པ་འདི་ནི་གཉིས་སོ།",
    "དཔེར་ན་མི་ལ་ལ་ཞིག་གིས་སྒྱུ་མ་མཁན་གྱི་རོལ་མོ་བྱུང་བའི་ཚེ།",
    "སྒྱུ་མ་མཁན་གྱིས་སྤྲུལ་པའི་བུད་མེད་མཐོང་ནས་འདོད་ཆགས་ཀྱི་སེམས་བསྐྱེད་དེ།",
    "སྟན་ལས་ལངས་ནས་སོང་སྟེ་དེ་སོང་ནས་བུད་མེད་དེ་ཉིད་ལ་མི་སྡུག་པར་ཡིད་ལ་བྱེད་ཅིང་།",
    "བཅོམ་ལྡན་འདས་གང་བུད་མེད་མ་མཆིས་པ་ལ་མི་སྡུག་པར་ཡིད་ལ་བགྱིད་ཅིང་།",
    "དཔེར་ན་མི་ལ་ལ་ཞིག་གཉིད་ལོག་པའི་རྨི་ལམ་དུ་བདག་གི་ཁྱིམ་དུ་རྒྱལ་པོའི་བཙུན་མོ་འོང་བ་མཐོང་ནས་དེ་དང་ལྷན་ཅིག་ཉལ་བར་བྱེད་དེ།",
    "ཅི་མི་དེ་འཇིགས་ཤིང་སྐྲག་སྟེ་བྲོས་པས་རྒྱལ་པོའི་བཙུན་མོའི་འཇིགས་པ་དེ་ལས་ཐར་བར་འགྱུར་རམ།",
    "བཅོམ་ལྡན་འདས་འདི་ལྟར་མི་དེས་བུད་མེད་མ་མཆིས་པར་བུད་མེད་ཀྱི་འདུ་ཤེས་བསྐྱེད་དེ་ཡང་དག་པ་མ་ལགས་པར་ཀུན་བརྟགས་པའི་སླད་དུའོ།",
    "དེ་བཞིན་དུ་ཞེ་སྡང་མེད་པར་ཞེ་སྡང་གི་འདུ་ཤེས་བསྐྱེད་གཏི་མུག་མེད་པར་གཏི་མུག་གི་འདུ་ཤེས་བསྐྱེད་ནས་གཏི་མུག་གི་འཇིགས་པས་སྐྲག་སྟེ།",
    "གཏི་མུག་གི་མཐའ་སྟོང་པ་ཉིད་ཀྱི་མཐའ་མ་ཤེས་ནས་གཏི་མུག་གི་མཐའི་འཇིགས་པས་སྐྲག་སྟེ།",
    "གལ་ཏེ་ཡང་རྟག་པའོ་ཞེས་བྱ་བ་དེ་ལྟར་འཛིན་པའི་ཕྱིན་ཅི་ལོག་ཡོད་པ་མ་ཡིན་པ་དེ་ལྟར་ན་ཡང་རེ་ཞིག་འཛིན་པ་དེ་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "བྱེད་པ་པོ་དང་ལས་རྣམས་གྲུབ་པ་ཡིན་ན་ནི་ཐམས་ཅད་གྲུབ་པས་ཁོ་བོ་ཅག་གི་འདོད་པ་གྲུབ་བོ།",
    "ཁྱོད་ཀྱི་རེག་པ་འདི་ནི་བརྫུན་པ་ཡིན་ཏེ།",
    "གང་གིས་འཛིན་དང་འཛིན་གང་དང་།",
    "བདག་གི་ཡོད་ཉིད་མེད་ཉིད་ནི།",
    "གཟུགས་སྒྲ་རོ་དང་རེག་པ་དང་།",
    "གང་གིས་འཛིན་དང་འཛིན་གང་དང་།",
    "གང་གི་ཕྱིར་འདི་དེ་ལྟར་ཡིན་པ།",
    "རྣམ་པ་གཅིག་ཏུ་ན་གང་གི་ཕྱིར་རྐྱེན་བརྟག་པ་ལ་སོགས་པའི་རབ་ཏུ་བྱེད་པ་རྣམས་ཀྱི་བྱེད་པ་དང་དངོས་པོ་དང་བྱེད་པ་པོ་དང་ལས་ཐམས་ཅད་རྣམ་པ་ཐམས་ཅད་དུ་མ་སྐྱེས་པར་བསྟན་པ་དེའི་ཕྱིར།",
    "རེ་ཞིག་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པ་ལ།",
    "དེ་ལ་འདིའི་ཅུང་ཟད་ཅིག་ཕྱིན་ཅི་ལོག་ཏུ་གྱུར་པ་གང་ཡིན་པ་དེ་ལ་ནི་ཕྱིན་ཅི་ལོག་གིས་ཕྱིན་ཅི་ལོག་ཏུ་བྱེད་པ་མ་ཡིན་ཏེ།",
    "འདིའི་ཅུང་ཟད་ཅིག་ཕྱིན་ཅི་ལོག་ཏུ་མ་གྱུར་པ་གང་ཡིན་པ་དེ་ཡང་ཕྱིན་ཅི་ལོག་གིས་ཕྱིན་ཅི་ལོག་ཏུ་བྱེད་པ་མ་ཡིན་ཏེ།",
    "གང་གི་ཚེ་དེ་ལྟར་བདག་མེད་པ་ལ་སོགས་པ་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་དེ་ཡང་རང་གི་ངོ་བོས་གྲུབ་པ་མེད་པའི་ཕྱིར་བདག་ལ་སོགས་པ་ལྟར་ཇི་ལྟར་ཕྱིན་ཅི་ལོག་ཏུ་མི་འགྱུར།",
    "མ་རིག་པ་ནི་ཉོན་མོངས་པའི་ཚོགས་མཐའ་དག་དང་།",
    "ནམ་མཁའི་ཨ་མྲའི་ལྕུག་མ་ཡོད་པ་མ་ཡིན་པ་སྤང་བའི་ཐབས་ཚོལ་བ་ནི་ཡོད་པ་མ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་དེའི་རྒྱུ་ཅན་རྣམས་ཡོད་པ་ཡིན་ལ།",
    "ཉོན་མོངས་པ་ཡོད་པའི་ཕྱིར་སྲིད་པའི་རྒྱུན་ཡང་ཡོད་པ་ཉིད་དོ།",
    "སྟོབས་འདེབས་པར་མི་གནས་པ་འབའ་ཞིག་ཏུ་མ་ཟད་ཀྱི་འོན་ཀྱང་དེ་དྲུངས་འབྱིན་པར་མཛད་པ་རྣམས་དང་ཤིན་ཏུ་འགལ་བར་གནས་ཤིང་གཟུ་ལུམས་ཀྱི་ཉོན་མོངས་པའི་དུག་གི་ལྗོན་ཤིང་ཆེན་པོ་དེ་འཛུགས་པ་ལ་ཆེས་ཤིན་ཏུ་གུས་པ་ནི།",
    "གཞན་ཡང་གལ་ཏེ་ཉོན་མོངས་པ་མ་རིག་པ་ལ་སོགས་པ་རྣམས་སྤོང་བ་ཡོད་ན་ནི།",
    "དེའི་ཚེ་རང་གི་ངོ་བོས་ཡོད་པ་རྣམས་ལ་འམ།",
    "གལ་ཏེ་ཉོན་མོངས་པ་རང་བཞིན་ངོ་བོས་ཡོད་པར་གྱུར་བ་རྣམས་སྤོང་བར་འདོད་ན་ནི།",
    "གལ་ཏེ་ལ་ལའི་ཉོན་མོངས་པ།",
    "དངོས་པོ་རང་གི་ངོ་བོས་ཡོད་པ་རྣམས་ཀྱི་རང་བཞིན་ནི་བཟློག་པར་མི་ནུས་ཏེ།",
    "དེ་བཞིན་དུ་གལ་ཏེ་ལ་ལ་སྟེ་གང་ཟག་གི་གང་དག་སྟེ་མ་རིག་པ་ལ་སོགས་པའི་ཉོན་མོངས་པ་འདི་དག་ཀྱང་རང་བཞིན་གྱིས་ཡོད་ན་ནི་ཇི་ལྟ་བུར་ན་སྤོང་བར་འགྱུར་ཏེ།",
    "གང་གིས་ཀྱང་སྤོང་བར་མི་འགྱུར་བ་ཉིད་དོ་ ཡང་ཅིའི་ཕྱིར་དེ་དག་ནི་སྤོང་ཞེ་ན།",
    "གལ་ཏེ་ལ་ལའི་ཉོན་མོངས་པ།",
    "ཉོན་མོངས་པ་རང་བཞིན་གྱིས་མེད་པ་སྟེ་མི་བདོག་པ་རྣམས་ཀྱང་སྤང་བར་མི་ནུས་པ་ཉིད་དོ།",
    "དེ་བཞིན་དུ་ཉོན་མོངས་པ་འདི་དག་ཀྱང་སུ་ལ་ཡང་གང་དག་ཀྱང་རང་བཞིན་གྱིས་མེད་པས།",
    "དེའི་ཕྱིར་དེ་ལྟར་ཕྱོགས་གཉི་ག་ལྟར་ཡང་སྤོང་བ་ཡོད་པ་མ་ཡིན་པས་ཉོན་མོངས་པ་རྣམས་སྤོང་བ་མེད་དོ།",
    "སྤོང་བ་མེད་པའི་ཕྱིར་ན་ཉོན་མོངས་པ་སྤོང་བའི་ཐབས་ཚོལ་བ་ལྟ་ཡོད་པར་ག་ལ་འགྱུར།",
    "མཁྱེན་ནས་ཉོན་མོངས་རྣམས་དང་མི་འགྲོགས་ཏེ་ བརྗོད་པ་ཙམ་གྱི་སྒོ་ནས་བརྗོད་བྱ་ཞིང་།",
    "ཁྱེད་ལ་མེད་པར་ཐལ་བར་འགྱུར།",
    "གལ་ཏེ་རིགས་པས་མི་འཐད་པའི་ཕྱིར་ཕྱི་དང་ནང་གི་དངོས་པོའི་རྣམ་པ་འདི་དག་ཐམས་ཅད་སྟོང་པ་ཉིད་དོ་ཞེས་སྒྲུབ་ན།",
    "དེ་ལྟ་ན་ཁྱོད་ལ་ཉེས་པ་ཆེན་པོ་དང་མང་པོར་འགྱུར་བ་མ་ཡིན་ནམ།",
    "ཇི་ལྟར་མཐོང་བ་བཞིན་དངོས་པོའི་རང་བཞིན་རྣམ་པར་འཇོག་པའི་ཕྱིར་འཕགས་པ་མ་ཡིན་པ་དག་གིས་ནི་མ་ཡིན་ནོ།",
    "མངར་བ་ཉིད་དུ་ནི་མ་ཡིན་པ་དེ་བཞིན་དུ་འདིར་ཡང་ཉེ་བར་ལེན་པའི་ཕུང་པོ་ལྔ་སྡུག་བསྔལ་གྱི་རང་བཞིན་ཡིན་མོད་ཀྱི།",
    "དེ་ལྟ་ན་ཡང་གང་དག་གིས་འདི་དག་སྡུག་བསྔལ་གྱི་བདག་ཉིད་དུ་མཐོང་བ་དེ་དག་ཉིད་ལ་དེ་དག་སྡུག་བསྔལ་ཡིན་པར་བཞག་གི།",
    "གལ་ཏེ་འཕགས་པ་མ་ཡིན་པ་རྣམས་ཀྱིས་ཀྱང་ཚོར་བ་སྡུག་བསྔལ་ལ་སྡུག་བསྔལ་ལོ་ཞེས་བྱ་བར་ཡོངས་སུ་གཅོད་པ་ཉིད་མ་ཡིན་ནམ་དེའི་ཕྱིར་ཇི་ལྟར་སྡུག་བསྔལ་འཕགས་པ་རྣམས་ཁོ་ན་ལ་བདེན་པ་ཡིན་ཞེ་ན།",
    "དེ་ཉིད་མིག་ཏུ་སོང་ན་ཡང་།",
    "ནམ་ཞིག་གི་ཚེ་ན་འདི་སྡུག་བསྔལ་འཕགས་པའི་བདེན་པར་རིགས་ཤེ་ན།",
    "གང་གི་ཚེ་སྟོང་པའི་ཕྱིར་ཅུང་ཟད་ཀྱང་སྐྱེ་བ་མེད་ཅིང་ཅུང་ཟད་ཀྱང་འགག་པ་མེད་པ་དེའི་ཚེ་ནི་སྡུག་བསྔལ་ཡོད་པ་མ་ཡིན་ནོ།",
    "སྡུག་བསྔལ་མེད་པ་ན་ཡང་ཀུན་འབྱུང་གི་བདེན་པ་ཡོད་པར་ག་ལ་འགྱུར།",
    "འདི་ལྟར་རྒྱུ་གང་ལས་སྡུག་བསྔལ་ཀུན་འབྱུང་ཞིང་སྐྱེ་བ་སྲེད་པ་དང་ལས་དང་ཉོན་མོངས་པའི་མཚན་ཉིད་ཅན་གྱི་རྒྱུ་དེ་ལ་ནི་ཀུན་འབྱུང་ཞེས་བྱ་ན།",
    "གང་གི་ཚེ་འབྲས་བུར་གྱུར་པ་སྡུག་བསྔལ་གྱི་བདེན་པ་ཡོད་པ་མ་ཡིན་པ་དེའི་ཚེ་འབྲས་བུ་དང་བྲལ་བ་རྒྱུ་ཉིད་དུ་མི་འཐད་པའི་ཕྱིར་ཀུན་འབྱུང་ཡང་མེད་དོ།",
    "གང་གི་ཚེ་སྡུག་བསྔལ་ཉིད་མེད་པ་དེའི་ཚེ་གང་གང་གིས་འགོག་པར་འགྱུར།",
    "མི་རྟག་པ་ལ་སོགས་པ་ནི་རྣམ་པ་དག་གིས་སྡུག་བསྔལ་གྱི་བདེན་པ་ཡོངས་སུ་ཤེས་པ་དེ་དང་།",
    "སྡུག་བསྔལ་ཀུན་འབྱུང་གི་བདེན་པ་སྤང་བ་དང་།",
    "གང་གི་ཚེ་དེ་ལྟར་སྡུག་བསྔལ་ཡོངས་སུ་ཤེས་པ་ལ་སོགས་པ་མེད་པ་དེའི་ཚེ།",
    "འདིར་ཉོན་མོངས་པ་རྣམས་ཀྱི་སྤངས་པ་བསྡོམས་པས་ནི།",
    "ཀུན་ཏུ་སྦྱོར་བ་གསུམ་སྤངས་པས་སྐད་ཅིག་མ་བཅུ་དྲུག་པ་ལམ་ལ་རྗེས་སུ་ཤེས་པ་ལ་སོགས་པ་ཉོན་མོངས་པའི་སྤངས་པ་གང་ཡོད་པ་དེ་ནི་རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུའོ།",
    "འདོད་པ་ན་སྤྱོད་པའི་ཉོན་མོངས་པ་དེ་དག་གི་ཉོན་མོངས་པ་རྣམ་པ་དགུ་པ་ཟད་པས་རྣམ་པར་གྲོལ་བའི་ལམ་ལ་སྤངས་བ་གང་ཞིག་ཡོད་པ་དེ་ནི་ཕྱིར་མི་འོང་བའི་འབྲས་བུའོ།",
    "ས་དང་ས་ལ་རྣམ་པ་དགུའི་དབྱེ་བས་ཕྱེ་བ་རྣམས་ལས་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་འདུ་ཤེས་མེད་མིན་སྐྱེ་མཆེད་ཀྱིས་པའི་ཉོན་མོངས་པ་རྣམ་པ་དགུ་ཟད་པར་ཟད་པས་རྣམ་པར་གྲོལ་བའི་ལམ་ལ་སྤངས་པ་གང་ཞིག་ཡོད་པ་དེ་ནི་དགྲ་བཅོམ་པའི་འབྲས་བུ་ཞེས་འདི་དག་ནི་འབྲས་བུ་བཞིའོ།",
    "གང་གི་ཚེ་སྡུག་བསྔལ་ལ་སོགས་པ་འཕགས་པའི་བདེན་པ་རྣམས་མེད་པས་སྡུག་བསྔལ་ཡོངས་སུ་ཤེས་པ་ལ་སོགས་པ་མེད་པ་དེའི་ཚེ་ནི་འབྲས་བུ་བཞི་པོ་དེ་དག་ཡོད་པ་མ་ཡིན་ནོ།",
    "ཀུན་འབྱུང་གི་བདེན་པའི་རྣམ་པར་སྐྱེས་པ།",
    "ཉོན་མོངས་པའི་རྣམ་པ་རེ་རེ་སྤང་བར་བྱ་བའི་ཕྱིར།",
    "རྣམ་པར་གྲོལ་བའི་དབྱེ་བས་ཤེས་པའི་སྐད་ཅིག་མ་གཉིས་གཉིས་ཉོན་མོངས་པའི་སྐད་ཅིག་ལས་བཟློག་ནས་རྣམ་པར་གཞག་གོ།",
    "འདི་ལྟར་ཉོན་མོངས་པའི་རྣམ་པ་ཆེན་པོའི་ཆེན་པོ་ནི།",
    "བར་ཆད་མེད་པ་དང་རྣམ་པར་གྲོལ་བའི་ལམ་ཆུང་ངུའི་ཆུང་ངུ་དག་གིས་སྤོང་བ་ནས་ཉོན་མོངས་པའི་རྣམ་པ་ཆུང་ངུའི་ཆུང་ངུ་ནི་ཤེས་པའི་སྐད་ཅིག་མ་ཆེན་པོའི་ཆེན་པོའི་བར་དག་གིས་སྤོང་སྟེ།",
    "དྲི་མ་རགས་པ་ནི་ཕྲ་མོ་ནི་འབད་པ་ཆེན་པོས་བསྒྲུབ་པར་བྱ་བ་ཡིན་ཏེ།",
