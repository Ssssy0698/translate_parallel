    "ད་དུང་གླ་འཁོར་དེ་ཡང་ཁོ་རང་སྒེར་གྱི་མིན་པར་གླ་འཁོར་ཚོགས་པའི་ཡིན་པ་དང་།",
    "ད་དུང་ཤར་བསྡད་འདུག་སྟབས་མུ་མཐུད་དུ་བསྒུགས་པ་ཡིན།",
    "བར་མཚམས་མི་ཆད་པར་ཁྱུ་དང་ཁྱུ་བྱས་ཏེ་ཡོང་བཞིན་འདུག་ངས་སྔ་ས་ནས་གྲ་སྒྲིག་བྱས་པའི་ཁ་པར་དེ་ལག་ཏུ་བཟུང་བཞིན་མི་ཚོགས་ཀྱི་མདུན་དུ་སྒུག་པར་ཕྱིན།",
    "ཁ་པར་ཐེངས་བཅུ་གྲངས་ཤིག་ལ་ཡོང་འདུག་ཀྱང་།",
    "འདྲ་པར་ཙམ་ཡང་ལེན་མ་ཐུབ་པར་ནང་ལོགས་སུ་ལུས་པ་ཡིན་འདུག་ངས་ཁ་པར་ལ་ཉན་བཞིན་མི་ཚོགས་ཀྱི་ཟུར་ཞིག་ཏུ་ཕྱིན་པས།",
    "ཞེས་སྐུ་བརྙན་འདི་ལ་བསྟོད་བསྔགས་ཆེན་པོ་མཛད་འདུག་པས།",
    "ཡང་སྐུ་བརྙན་གཞན་ཞིག་འདུག་པ་ལ་སམ་ཕུ་ཏ་ཕ་ནེ་བྷུདྡྷ་ཞུ་བ་དང་།",
    "མཚོ་གནས་སྲོག་ཆགས་སྣ་ཚོགས་སོགས་འདུག་པ་ལས།",
    "ཐེངས་ཤིག་སྲོག་ཆགས་གླིང་གར་མཚོ་ཆུང་ངུ་འདུག་པ་དེའི་ནང་།",
    "མཚོ་ཆུང་དེའི་དཀྱིལ་དུ་གནམ་ནས་མར་ཆུ་འབབ་ས་ཞིག་བཟོས་འདུག་པ་དེར་ཕྱིན་སྐབས།",
    "ངེད་གཉིས་ཀྱི་གྱོན་གོས་ཕྱི་ནང་ཡོངས་རྫོགས་རློན་པར་གྱུར་བ་དེ་ལས་དགོད་བྲོ་བ་མ་བྱུང་ཞིང་རྩེད་གྲུ་གཏོང་མཁན་མང་པོ་འདུག་སྟབས་ངོ་ཡང་ཅུང་ཚ་བ་བྱུང་།",
    "རྒྱན་ཆ་ཉོ་ས་ཞིག་ལ་པདྨ་ར་ག་དམར་པོའི་ཕྲ་རྒྱན་ཅན་གྱི་མཛུབ་དཀྲིས་གོང་ཆེན་འདུག་པ་ངས་ཉོ་འདོད་བྱས་ཀྱང་།",
    "ཆུ་དགུན་འབུམ་དམར་པོ་དེ་མང་ཙམ་ཟ་བཞིན་འདུག་ཅིང་།",
    "དེའི་བར་ལ་ངས་ངེད་གཉིས་ཀྱི་གནམ་གྲུའི་འཛིན་བྱང་གྲ་སྒྲིག་བྱས་ཏེ་ངལ་གསོས་ནས་འདུག་རྒྱུ།",
    "འོན་ཀྱང་ངེད་གཉིས་གཞུང་ཚབ་ཁང་དུ་སླེབས་སྐབས་ཧ་ཅང་སྔ་དྲགས་འདུག་པས།",
    "སྒོ་འདི་ཀ་རང་ནས་སྒུག་འདུག་རོགས་བྱོས་ཟེར།",
    "ཞལ་རས་ནི་སྔར་རྒྱུན་ལྟར་འཛུམ་མདངས་ཀྱིས་ཁེངས་འདུག་སྟབས།",
    "བྷེང་ཀོག་གནམ་ཐང་ནས་ཧ་ནེས་ལ་ཉིན་བཅོ་ལྔའི་མཐོང་མཆན་མ་གཏོགས་སྤྲད་མི་འདུག་པས།",
    "ངོས་རོགས་པ་བྱ་ཐུབ་རྒྱུ་ཅི་ཞིག་འདུག་ངས་གོ་ཚོད་ལ།",
    "ང་རང་གཉིས་ཀ་མ་འགྱུར་བར་བསྡད་ན།",
    "ཁྱད་པར་དུ་ང་རང་གཉིས་ལ་བྱིས་པ་ཞིག་ཡོད་ན།",
    "སེམས་སྡུག་གནང་དགོས་དོན་མི་འདུག་ང་ལ་གང་མགྱོགས་བྱིས་པ་ཞིག་འཁོར་རོགས་བྱས་ན།",
    "བཟུང་ན་ལག་པ་ཚིག་བཏང་ན་རྫ་མ་བཅག་པའི་ཚད་དུ་སླེབས་འདུག་པས་ད་ཅི་ཞིག་བྱ་དགོས་སམ།",
    "ཅ་ལག་རྩིས་སྤྲོད་བྱེད་སའི་བར་དུ་གྲལ་རིང་པོ་ཞིག་བསྒྲིགས་བསྡད་འདུག་སྟབས།",
    "ད་དུང་ཅུང་ཙམ་བསྒུག་དགོས་པར་འདུག་པས།",
    "ཧ་ནེས་ཀྱི་དབུ་སྔས་ལ་ད་དུང་ཧ་ནེས་ཀྱི་སྐུ་ལུས་ཀྱི་དྲི་ཞིམ་འཐུལ་གྱིན་འདུག་སྟབས།",
    "དེར་བརྟེན་གསང་སྤྱོད་ནང་དུ་ཕྱིན་རྗེས་ཧ་ནེས་ཞེས་འབོད་བཞིན་སྐད་ཤུགས་ཆེན་པོས་ཡིད་ཚིམས་པ་ཞིག་དུས་པས།",
    "དེ་རིང་རྗེས་དྲན་བྱེད་ཡུལ་ཙམ་ལས་མི་འདུག་པས།",
    "ཉིན་གུང་ལ་སླེབས་སྐབས་འཁྱག་སྒམ་ནང་དུ་ཟས་ལྷག་ཅུང་ཙམ་འདུག་པ་དེ་ཟོས།",
    "སུར་པན་དམར་པོ་ཉུང་ངུ་ཞིག་ལས་ཅི་ཡང་མི་འདུག་ཀྱང་།",
    "ཁྲུས་ཡང་ཡང་བརྒྱབ་ནས་ཆུ་མང་པོ་བེད་སྤྱོད་བཏང་བ་སོགས་ཀྱི་རིན་གོང་ལ་ཨ་རིའི་སྒྲོ་ལར་ལྔ་བརྒྱ་ཙམ་ཞིག་བབ་འདུག་པ།",
    "ལག་ཐོག་ཏུ་དངུལ་དམར་འདང་ངེས་ཤིག་ལྷག་མི་འདུག་པ་དང་།",
    "ཐ་ན་ལག་སྒམ་ཡང་ཆེ་དྲགས་འདུག་ཅེས་གནམ་གྲུའི་འོག་ཏུ་བསྐུར་བ་ལས་ནང་དུ་ཁྱེར་མ་བཅུག་པར་མ་ཟད།",
    "རྒྱ་གར་བ་རྣམས་ཀྱིས་ངའི་ལག་སྒམ་ལས་ཀྱང་ཆེ་བའི་ལག་སྒམ་མང་པོ་གནམ་གྲུའི་ནང་དུ་ཁྱེར་འདུག་དྷི་ལི་ནས་བྷག་ཌོག་རའི་བར་དུ་གནམ་གྲུའི་ཆུ་ཚོད་གཉིས་དང་ཕྱེད་ལས་འཕུར་མི་དགོས་པས།",
    "ཧ་ནེས་བསུ་བར་སླེབས་ཏེ་སྒུག་འདུག་པ་དང་འཕྲད་ནས་སྐེ་འཇུ་བྱས་པ་དང་།",
    "ཁོས་ང་རང་ཉེན་རྟོག་པའི་སར་ཕྱིན་པ་ཡིན།",
    "ང་རང་མཐོང་མཆན་གྱི་དུས་བཅད་ལྟར་ཕྱིར་ཨ་རི་ལ་འགྲོ་རྒྱུའི་སེམས་ཐག་བཅད་ཅིང་།",
    "གཞན་ལྷ་ཁང་ཆུང་ངུ་འགའ་དང་རྡོ་འབུམ་སོགས་འདུག་ཅིང་།",
    "གནས་སྐོར་གྱི་རིང་ཅིས་ཀྱང་འདིར་འདུག་དགོས་ཞེས་གསུངས་པ་ལ་ལགས་སོ་ཞུས།",
    "བཟའ་ཟླ་དང་མཉམ་དུ་བུམ་ཐང་གྲོང་བརྡལ་དུ་ཡོང་འདུག་པས་ཁོང་བཟའ་མི་གཉིས་དང་མཇལ་འཛོམས་བྱུང་།",
    "རིམ་པར་གཏེར་སྲས་གྲགས་པ་རྒྱལ་པོ་སོགས་གདུང་སྲས་ལྔ་གཏམ་ཞིང་རང་དུ་འཁྲུངས་པས།",
    "གལ་ཏེ་མེད་ན་ངའི་ལུང་པ་ཟོག་པོས་གང་ཉེན་འདུག་པས།",
    "དེར་མི་ཀུན་གྱིས་ཁོ་རང་ངོ་ཚ་ནས་ཆུ་ནང་དུ་མཆོངས་སོ་ཞེས་འུར་ཟིང་ཆེན་པོ་བྱུང་བ་དང་།",
    "དེ་ལས་གཞན་པའི་དུས་ཚོད་རྣམས་ལ་དམིགས་བསལ་གྱི་བཀའ་རྒྱ་མེད་ན་མཇལ་ཁ་མེད་ཚུལ་གྱི་སྦྱར་བྱང་བསླངས་འདུག་ཀྱང་།",
    "སྐུ་རྗེས་ལྷ་ཁང་གཉིས་བར་གྱི་ལམ་ཟུར་ཞིག་ཏུ་འདུག་འབྲུག་པ་ཚོས་ལྷ་ཁང་འདི་ལ་དོ་སྣང་ཆེན་པོ་མི་བྱེད་པས་དེ་ཙམ་གྲགས་མི་ཆེ་ཡང་།",
    "ས་རུབ་ཁར་དགེ་གནས་ལྷ་ཁང་མཇལ་དུ་ཕྱིན་ཀྱང་ཡང་བསྐྱར་སྒོ་བརྒྱབ་འདུག་པ་དང་།",
    "བུམ་ཐང་དགེ་རྒྱས་ལྷ་ཁང་དང་ཐག་ཉེ་བའི་ཆུའི་ཕར་ཕྱོགས་སུ་འདུག་ལྷ་ཁང་འདི་མངའ་བདག་ཉང་ཉི་མ་འོད་ཟེར་ཡབ་སྲས་ཀྱིས་བཞེངས་པར་གྲགས་ཤིང་།",
    "པར་བླངས་ན་ང་ལ་ཅང་མི་ཟེར་བར་འདུག་སྟེ།",
    "ཤི་ལི་རྒུ་རུ་ནས་ཇི་ལིར་འགྲོ་བའི་མེ་འཁོར་ལ་ད་དུང་ཉིན་གཉིས་སྒུག་དགོས་ཀྱི་འདུག་སྟབས།",
    "ས་སྐྱ་གོང་མ་སོགས་ཀྱི་སྐུ་པར་གྱང་ངོས་སུ་བཀལ་འདུག་ནང་གཡོག་རྒྱ་གར་གྱི་རྒད་པོ་ཞིག་ལ་༢༡༡ ལོར་ངས་ཧིན་སྒོར་༢ སྤྲད་མྱོང་ཡོད་སྟབས།",
    "ཧ་ནེས་རྣམས་ཀྱང་ཅ་ལག་བཟུང་ནས་ཡར་རྒྱུག་མར་རྒྱུག་མང་པོ་བྱས་སྟབས་ཐང་ཆད་ནས་དབུགས་ཧལ་བཞིན་འདུག་ད་ནི་མེ་འཁོར་འགྲོ་རྒྱུ་ལ་དུས་ཚོད་མང་པོ་ལྷག་མེད་ཅིང་།",
    "ངའི་གཡས་གཡོན་གྱི་རྐུབ་སྟེགས་ཚང་མ་མིས་གང་འདུག་སྟབས།",
    "ང་རང་དྷེ་ལིར་འགྲོ་བའི་ལམ་དུ་ཞུགས།",
    "སྔར་ཕྱི་ཟླ་༩ པའི་ཚེས་༡༤ ལ་ཕྱིར་འཕུར་རྒྱུ་བྱས་ནས་འཛིན་བྱང་ཉོས་པ་ཟླ་འདིའི་ཚེས་༢༢ ལ་བརྗེས་འདུག་པ་པར་འདོན་བྱས་ཤིང་།",
    "ཁྱེད་རང་ཕྱིར་བདེ་བར་འབྱོར་ཟིན་ནམ།",
    "ངས་ཁྱེད་ཧ་ཅང་དྲན་བཞིན་ཡོད་ཅེས་བྲིས་འདུག་པ་ལ།",
    "དེང་སང་ཧ་ཅང་ན་བཞིན་འདུག་པས།",
    "ང་རང་བལ་ཡུལ་དུ་འགྲོ་རྒྱུའི་མཐོང་མཆན་བཟོས་པ་དང་།",
    "ཕྱོགས་སོ་སོར་གངས་ཀྱི་ཕུང་པོ་གཏོས་ཆེ་བ་དག་དེའུ་འབུར་བསྒྲིགས་པ་ལྟར་ཏུ་སྤུངས་འདུག་ཁ་བ་ཇི་ལྟར་འབབ་ཀྱང་ངོ་བོ་དཀར་ཞིང་གཙང་བ་ལྟར།",
    "མཁའ་འགྲུལ་ཞབས་ཕྱི་མས་འཐུང་ཆུ་དང་ཟས་རིགས་སྤྱད་པ་ཡང་ལེན་ཁོམ་མེད་པར་བྱེད་ཀྱི་འདུག་པ་ལྟར་ངས་ཀྱང་པར་མང་པོ་བླངས་ཤིང་།",
    "དེ་རིང་མཁའ་ཐོག་ནས་མར་བལྟ་ཐུབ་ཀྱི་འདུག་ཨང་བསམ་ནས་སེམས་ལ་སྤོབས་པ་ཞིག་ཀྱང་སྐྱེས།",
    "ང་རང་ཐིམ་ཕུག་ཏུ་སླེབས་རྗེས་གླ་འཁོར་ལ་བསྡད་ནས་ཀུ་རུ་ཐང་དུ་ཡོང་རྒྱུ་དང་།",
    "ཧ་ནེས་ཀྱིས་མགྲོན་ཁང་འདི་ཕྱི་རྒྱལ་གྱི་ཡུལ་སྐོར་བ་སྡོད་ས་ཡིན་པས་གོང་ཆེ་དྲགས་འདུག་གསུངས་པ་ལྟར་ངེད་གཉིས་ནོར་གླིང་མགྲོན་ཁང་དུ་སྤོར།",
    "གཏན་སྡོད་ས་གནས་ཀྱི་ཁ་བྱང་སོགས་ཧ་ཅང་ཞིབ་ཚགས་དང་ལྡན་པ་ཞིག་དགོས་ཀྱི་འདུག་སྟབས།",
    "འབྲི་སྟངས་ཀྱི་ཐད་ལ་ཡང་སྒྲིག་ལམ་མང་པོ་འདུག་པས།",
    "ཧ་ནེས་ཀྱི་གཟིམ་ཤག་ཏུ་སླེབས་ཏེ་ནུབ་ཇ་འཐུང་རྗེས་ང་རང་ཅུང་ཙམ་ཐང་ཆད་ཡོད་སྟབས།",
    "ཕྱི་ལོ་༢༡ ལོར་ང་རང་གཉིས་ངོ་ཤེས་པ་ནས་བཟུང་།",
    "ཕྱོགས་གང་ཐད་ནས་ཡ་རབ་དམ་པའི་ཡོན་ཏན་གྱིས་ཀུན་ནས་བརྒྱན་པ་ལ་ཕན་ཚུན་འགྲན་པ་ལྟ་བུར་འདུག་པས།",
    "ཡང་འདུལ་གྱི་གཙུག་ལག་ཁང་སྤ་གྲོ་སྐྱེར་ཆུའི་ལྷ་ཁང་ཡང་ཕྱིར་ཡོང་སྐབས་ལམ་བར་ནས་མཇལ་རྒྱུ་བྱེད་བཞིན་འདུག་ཀྱང་།",
    "ད་ལྟ་རང་གསུང་འབྱོན་ནམ་སྙམ་པ་ཞིག་འདུག་པ་དེ་ནི།",
    "དབུ་ལ་པད་ཞྭ་མནབས་པ་ཞིག་ཏུ་འདུག་ཅིང་།",
    "སྤ་གྲོ་སྟག་ཚང་ཞེས་གནས་བདག་སེང་གེ་བསམ་གྲུབ་ཀྱིས་བདག་ཏུ་བཟུང་བའི་ཀེའུ་ཚང་ངམ་བྲག་ཕུག་ཏུ་ཞེས་པའི་དོན་ཡིན་པར་འདུག་སྟེ།",
    "དེ་བས་ཀྱང་མདུན་ངོས་གཡོན་ཕྱོགས་ཀྱི་མཐོ་ས་ནས་བལྟས་ན་ཁྲོ་ཞལ་དེ་མངོན་སུམ་གྱི་མིག་ལ་མཐོང་ངེས་སུ་འདུག།",
    "གནམ་གཤིས་འཐིབས་ཡོད་པས་ཡིན་ནམ་དེ་རིང་ནི་མགྲོན་པོ་གཞན་ཚོས་ཀྱང་སྔོན་མ་ལྟ་བུའི་དོ་སྣང་བྱེད་ཀྱི་མི་འདུག་བལ་ཡུལ་དུ་འབྱོར་རྗེས་སླར་ཡང་མཆོད་རྟེན་ཉེ་འཁོར་དུ་སྡོད་འདོད་བྱུང་བས་དེར་ཕྱིན།",
    "ཡང་བསྐྱར་ང་རང་ལ་འཇོན་ཐང་དེ་ལྟ་བུ་མེད་པར་ཡི་ཆད་ཆེན་པོ་བྱུང་།",
    "ཧ་ནེས་ཀྱི་མཐོང་མཆན་ལ་ད་དུང་ལོ་གཅིག་དང་ཕྱེད་ཙམ་འགོར་ངེས་ཡིན་འདུག་པས།",
    "དེའི་རྗེས་སུ་མཛུབ་ཐེལ་རྒྱག་རྒྱུའི་ཉི་མ་དེར་ང་རང་ཨ་རི་ལ་ཡོད་དགོས་པ་དང་།",
    "དྲི་བ་དྲིས་ལན་གྱི་དུས་ཚོད་དང་མཛད་སྒོའི་དུས་ཚོད་གཉིས་ལ་ང་རང་ཨ་རིར་ཕྱིར་ཡོང་།",
    "ཧ་ནེས་ཀྱིས་བཟའ་ཚང་གཉིས་ཡུན་རིང་པོར་སོ་སོར་སྡོད་རྒྱུ་འདི་ལས་སུན་ཅིག་མི་འདུག་པས།",
    "ངས་ཁྱེད་ལ་དཀའ་ལས་མང་པོ་གཏོད་ཀྱི་འདུག་པ་སེམས་ཀྱིས་བཟོད་ཐུབ་ཀྱི་མི་འདུག་གང་ལྟར་མགྱོགས་པོར་ཐུག་ཏུ་ཤོག་དང་།",
    "ང་རང་ཉིད་ལ་མཚོན་ན།",
    "དེ་ལ་ཡང་ཁ་སྡུག་ངོ་གནག་གང་མང་བྱས་འདུག་པ་དང་།",
    "དེའི་ཆེད་དུ་ལས་ཀ་མང་པོ་ཞིག་ཀྱང་སྔོན་ལ་ཚར་བ་བྱེད་དགོས་བྱུང་འདུག་པས།",
    "ཧ་ནེས་གནམ་ཐང་དུ་འབྱོར་སྐབས་ང་རང་དངོས་སུ་གནམ་ཐང་དུ་བསུ་བར་འགྲོ་ཐུབ་པ་བྱེད་དགོས།",
    "དེ་ནི་དཀྱིལ་ཤར་ཨེ་ཤ་ཡའི་ནང་དུ་ཡོད་པའི་ཏུར་ཀི་རྒྱལ་ཁབ་ཀྱི་གནམ་གྲུ་ཡིན་འདུག་ཅིང་།",
    "དེར་བརྟེན་བལ་ཡུལ་གྱི་ཕྱི་ཚེས་༢༧ མ་གཏོགས་བལ་ཡུལ་དུ་སླེབས་ཐུབ་ཀྱི་མི་འདུག་སྟབས།",
    "མཁའ་འགྲོས་སྡོད་ཁང་གོང་ཆེ་ཆུང་གཉིས་རྙེད་འདུག་ན་ཡང་།",
    "མཐར་ལས་ཀ་ཆ་ཚང་གྲུབ་རྗེས་ཆུ་ཚོད་བདུན་དང་ཕྱེད་ཙམ་ལ་སླེབས་འདུག།",
    "ཕྱི་ལོགས་སུ་མ་ཕྱིན་པར་ཅ་ལག་ལེན་ས་རང་དུ་རྐུབ་སྟེགས་མང་པོ་འདུག་པས་དེ་ནས་བསྒུགས་པ་ཡིན།",
    "ཁོང་གཉིས་ཀྱིས་ཧ་ནེས་མཐོང་མི་འདུག།",
    "ཕྱོགས་མཚམས་ཐམས་ཅད་ས་ཞིང་དུ་འདུག་ཀྱང་།",
    "འབྲུག་པའི་སུ་པན་དམར་པོ་སོགས་མང་ཙམ་བསྣམས་འདུག་སྟབས།",
