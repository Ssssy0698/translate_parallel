    "གང་ཞིག་དུས་གསུམ་གྱི་རྒྱལ་བ་ཐམས་ཅད་ཀྱི་ཕྲིན་ལས་གཅིག་ཏུ་བསྡུས་པའི་བདག་ཉིད་དཔལ་མགོན་གྱི་སློབ་དཔོན་པདྨ་འབྱུང་གནས་ཉིད་གདུལ་དཀའ་སྙིགས་མའི་འགྲོ་ངོར་སླར་ཡང་ས་སྤྲུལ་པའི་རོལ་གར་གཉིས་པར་བསྟན་པ།",
    "དེ་བཞིན་མི་རབས་གསར་པ་གང་ཙམ་ཞིག་ཕེབས་འདུག་པས་ཚང་མར་འཚམས་འདྲི་དང་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན།",
    "ཚན་རིག་དང་ཁག་ཁག་ཕྱེ་ནས་ཐག་རིང་པོ་སྡོད་ཀྱི་འདུག་འདས་པའི་ལོ་སུམ་ཅུ་ཙམ་གྱི་རིང་ལ་ངོས་རང་ཚན་རིག་པ་དང་མཉམ་དུ་འབྲེལ་བ་དང་གོ་བསྡུར་བྱ་རྒྱུའི་གནས་ཚུལ་གང་ཙམ་བྱུང་བར་བརྟེན།",
    "ངོས་ཀྱིས་ཧ་ཅང་ཡག་པོ་འདུག་ཅེས་བརྗོད་པ་ཡིན།",
    "གསང་འདུས་ཡེ་ཤེས་ཞབས་ལུགས་ཀྱི་རྫོགས་རིམ་སོགས་མང་པོ་ཞིག་འདུག་དེ་དག་ཉམས་ལེན་པ་སོ་སོའི་འདོད་པ་དང་བསྟུན་ནས་ཉམས་ལེན་བྱས་ཏེ་གང་ལྟར་རྟོགས་པ་རྙེད་རྒྱུ་ཡིན་པ་འདྲ།",
    "དེ་ལྟ་བུ་ཧ་ཅང་གལ་ཆེན་པོ་འདུག་སྔགས་བགྲངས་པ་ཙམ་མིན་པར་ཟླ་དྲུག་དང་།",
    "སྔོན་མ་ཐེངས་གཅིག་རིགས་གཅིག་རྐང་འཛིན་བྱུང་ན་ཡག་པོ་འདུག་ཅེས་བསམ་ཚུལ་ཞུས་ཡོད།",
    "ཚུར་ཕྱོགས་དེར་མཆོད་ཁང་ཞིག་བཟོས་འདུག་དེའི་ནང་མཆོད་རྫས་དང་སྐུ་ཐང་ཁ་ཤས་ཤིག་དང་།",
    "འདི་རྩ་བ་ནས་ཡག་པོ་མི་འདུག་པས་ཡར་བསྡུས་ཞེས་བརྗོད་པ་ཡིན།",
    "དེ་ནས་ལོ་ཤས་ཕྱིན་པའི་རྗེས་ལོ་ཏག་ཏག་དྲན་གྱི་མི་འདུག་ཀྱང་།",
    "སུས་ཟེར་གྱི་འདུག་གམ་དེ་འདྲ་རྩ་བ་ནས་མེད།",
    "སྐུ་ཚེའི་སྨད་ལ་གོང་ས་ལྔ་པ་ཆེན་པོའི་ཕྱག་བཞེས་གཙོ་བོ་གནང་འདུག་རྩེའི་ཉི་འོད་ནང་རྒྱལ་བ་ལྔ་པ་ཆེན་པོའི་འདྲ་སྐུ་ཞིག་ཡོད།",
    "ངོས་ཀྱི་གདོང་ལ་ལྟོས་དང་ཡང་སྲིད་བྲེལ་བ་འདུག་གམ་མི་འདུག་བརྗོད་པས།",
    "བྲེལ་བ་མི་འདུག་བརྗོད་བྱུང་།",
    "བོན་གཞུང་དེ་འདྲ་འདྲེས་འདུག་བོན་གཞུང་ལ་ཆ་བཞག་ན།",
    "ཡག་པོ་མི་འདུག་གམ་དེར་བསམ་བློ་ཞིག་བཏང་ན།",
    "ཞེས་གསུངས་པ་དེ་ཡག་པོ་འདུག་རང་སྟོང་གཞན་སྟོང་ཡར་ཙམ་བཞག་ནས་སྔོན་ལ་སོ་སོ་ཁ་ཐུག་དེར་སེམས་ལ་ཕན་པ་དང་སྒོ་གསུམ་ཞི་ཞིང་དུལ་བ་ཞིག་བྱུང་ན་ཡག་པོ་ཡོད།",
    "འདི་གར་ནང་པའི་གནས་ཐོག་མར་རྙེད་མཁན་དང་བར་སྐབས་དེའི་ཐོག་དམིགས་བསལ་གྱི་ཐུགས་སྣང་གནང་མཁན་ཚོས་མུ་མཐུད་ནས་ས་ཆ་སྔོག་རྒྱུ་དང་ཅ་དངོས་སྒྲིག་ཤོམ་གནང་རྒྱུ་དེ་དག་ཧ་ཅང་ཡག་པོ་གནང་འདུག་པས་ཐུགས་རྗེ་ཆེ་ཟེར་གྱི་ཡིན།",
    "ཅེས་སོགས་ཀྱང་གསུངས་འདུག་པ་བཅས།",
    "རྩོལ་བ་དེ་ཆོད་སེམས་བརྟན་པོས་ཐོག་ནས་བྱམས་བརྩེའི་བསམ་པ་དང་རང་ལས་གཞན་གཅེས་པར་འཛིན་པའི་བསམ་བློར་གཞི་བཅོལ་དགོས།",
    "སོག་པོ་གཙོ་བོར་གྱུར་བའི་ཕྱི་རྒྱལ་དད་ལྡན་པ་ཁག་གཅིག་དེ་བཞིན་སྦེལ་ཀོབ་གཞིས་ཆགས་སོགས་ནས་བཅར་བའི་དད་ལྡན་མི་མང་རྣམས་ཀྱིས་ལག་ཏུ་མཆོད་རྫས་སྣ་ཚོགས་ཐོགས་ཏེ་རུ་བསྟར་བསྒྲིགས་ནས་སྤྲོ་སེམས་རབ་ཏུ་འཁོལ་བའི་ངང་རང་ལུགས་སྲི་ཞུ་ཕུན་ཚོགས་ཀྱི་ཕེབས་བསུ་གཟབ་རྒྱས་དང་འབྲེལ་སྐུའི་བྱམས་བརྩེའི་མཐོང་གྲོལ་གྱི་དཀྱིལ་འཁོར་མཇལ་ཁ་ཞུས་ཏེ་ཕེབས་བསུ་གཟབ་རྒྱས་ཞུས་ཡོད།",
    "གཞན་ཡང་དཔལ་དོན་དམ་གྱི་རྣམ་གྲངས་གཞན་མང་པོ་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པའོ།",
    "སྤྱོད་བསྡུས་སྒྲོན་མར་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ།",
    "དེ་བཞིན་དུ་སློབ་དཔོན་དོན་དམ་གྱི་མཚན་བརྗོད་དུ་གསུངས་པ་ཡང་རང་སྟོང་ལས་གཞན་དུ་བསྟན་པ།",
    "དེ་བཞིན་དུ་བདག་དང་རང་བཞིན་འོད་གསལ་གྱི་གཟུགས་སོགས་ཀྱང་སྔར་བསྟན་པ་རྣམས་དང་དོན་ཅིག་ཚུལ།",
    "དེ་བཞིན་དུ་མཚན་སྟོང་པ་ཆེན་པོ་ཡི་གེ་ལྔས་ཀྱང་རང་བྱུང་ཡེ་ཤེས་ལྔ་གསལ་བར་བསྟན་ཚུལ།",
    "རྫི་མ་འདུག་པའི་ཕྱག་རྒྱས།",
    "རང་རང་ཕྱོགས་སུ་ལེགས་པར་བཞུགས་ནས་སུ།",
    "རང་རང་མཐུན་རྫས་འདི་བཞེས་ལ།",
    "ཚེ་དཔག་མེད་ལྷ་དགུ་ལ་སོགས་ཀྱི་སྐབས་སུ་རིགས་ལྔའི་སྡོམ་བཟུང་བྱས་འདུག་པ་འདི་མ་དག་པ་ཆེན་པོ་ཡིན་ནོ།",
    "ཨོཾ་རུ་རུ་སྥུ་རུ་ཛྭ་ལ་ཏིཥྛ་སིདྡྷི་ལོ་ཙ་ནི་སརྦ་ཨརྠ་ས་དྷ་ནི་སྭཱཧཱ།",
    "དེ་དེ་ལྟར་ལྷ་བརྒྱ་སྟོང་ལ་གསོལ་བ་འདེབས་པ་ལྷུར་ལེན་ཅིང་འདུག་པ་ལས།",
    "གལ་ཏེ་ཁྱེའུ་ཡིན་ན་དཀུ་གཡས་པར་རྟེན་ཅིང་འདུག་པ་ལ།",
    "དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་པ་དང་།",
    "ཁྱིམ་ཤིན་ཏུ་ཕུན་སུམ་ཚོགས་པར་འདུག་པ་དང་།",
    "དེ་དག་མཐོང་ནས་བྲམ་ཟེ་ཤིང་སཱ་ལ་ཆེན་པོ་ནྱ་གྲོ་དྷནི་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "ཁྱིམ་ཤིན་ཏུ་ཕུན་སུམ་ཚོགས་པར་འདུག་པ་དང་།",
    "ཁྱིམ་ཤིན་ཏུ་ཕུན་སུམ་ཚོགས་པར་འདུག་པ་དང་།",
    "འོན་ཀྱང་ཡུལ་ཐག་རིང་པོ་ན་འདུག་པས་ཇི་ལྟར་དེ་དང་ལྷན་ཅིག་གཉེན་བྱ།",
    "གཞན་ཡང་རིང་པོ་ན་འདུག་པ་ཁོ་ན་དང་གཉེན་བཤེས་བྱ་བ་དེ་ནི་བརྟན་པ་ཡིན་ནོ།",
    "ཉེ་དུའི་ཚོགས་དང་ལྷན་ཅིག་ཏུ་འདུག་ནས་དེས་དེ་རྣམས་ལ་དོན་དེ་སྨྲས་པ་དང་།",
    "དེ་རྣམས་ཐག་རིང་པོ་ན་འདུག་པ་བྲམ་ཟེའི་ཁྱེའུ་ནྱ་གྲོ་དྷསྐྱེས་ཀྱིས་མཐོང་ངོ།",
    "བྲམ་ཟེའི་ཁྱེའུ་ནྱ་གྲོ་དྷསྐྱེས་ཆུང་མ་དང་ལྷན་ཅིག་ཇི་ལྟར་འདུག།",
    "ནྱ་གྲོ་དྷསྐྱེས་ནི་ཁྲིའུ་ལ་གནས་ཤིང་འདུག་གོ།",
