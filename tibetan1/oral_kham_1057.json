    "བསམ་གཏན་སྤེལ་ནས་འོག་མིན་འགྲོ།",
    "མྱ་ངན་ལས་འདའ་བ་བཞི་སྟེ་བཅུ་གཅིག་འོག་མིན་འགྲོ་བ་ལ་འཕར་བ་གསུམ་དུ་ཕྱེ་བས་བཅུ་བཞི།",
    "འདི་ཡང་འོག་མིན་འགྲོ་སྲིད་རྩེར་འགྲོ་གཟུགས་ཀྱི་ཆགས་བཅོམ་དང་གསུམ་ཡོད་པ་མ་བགྲངས་ལ་ཁ་བསྐང་བྱ་གསུམ་མེད་པ་བགྲངས་པས་གྲངས་མི་འཐད་པ་དང་།",
    "འོག་མིན་འགྲོ་བ་ནི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ལ་སྤྱོད་པ་གང་དག་འཁོར་ལོས་བསྒྱུར་བའི་རྒྱལ་པོར་གྱུར་ནས་ཞེས་ཏེ།",
    "དངོས་པོ་ལ་བརྒྱད་ཡིན་པ་དང་འགྲེལ་པ་དང་གྲངས་མཐུན་པའི་ཕྱིར་རོ་ བརྒྱད་རྣམས་ཞེས་པར་རྒྱ་དཔེ་ལ་འདུག་གོ་ཞེས་སྤོང་ཞེས་ཟེར་རོ།",
    "སེམས་རྣལ་དུ་འདུག་པའི་གནས་སྐབས་དང་ལྔ་བར་དུ་གཅོད་དོ།",
    "རང་དོན་དུ་སྤངས་པ་ཞལ་གྱིས་བཞེས་པ་ནི་བདག་ཉིད་ཀྱི་ཟག་པ་ཟད་ཞེས་ཏེ་གནས་ངན་ལེན་ལྟ་བུའི་འདི་མ་སྤངས་པར་འདུག་པ་བྱ་བ་དང་།",
    "གཞན་ཡང་རང་རྒྱུད་ལ་མངོན་སུམ་གྱིས་རྟོགས་ནས་གཞན་ལ་དཔོག་པར་བཞེད་པ་དང་ས་བརྒྱད་པ་ཡན་ཆད་ན་བསམ་བྱུང་གཏན་མེད་པར་བཞེད་པས་ཁས་བླངས་དང་འགལ་ལོ།",
    "སྔར་གྱི་རྣམས་ཀྱང་རང་ཉིད་ཀྱིས་རང་ཉིད་ལ་དཔོག་པའི་རྟགས་ཡིན་ནོ་ཞེས་མཚུངས་སོ།",
    "ཕྱི་མ་གཉིས་འཇུག་པའི་གནས་སྐབས་ཀྱིས་སྤང་བྱ་ཞེས་གཉེན་པོ་བཅོ་བརྒྱད་ངོ་བོ་གཅིག་པར་འདུག་གོ་ཞེས་སོ།",
    "དེ་དག་ཀྱང་རང་བཞིན་གྱིས་སྟོང་པའི་མཚན་ཉིད་དོ།",
    "བདག་མེད་པ་གང་ཡིན་པ་དེ་ཡང་རང་དགས་འཇུག་པ་ཅན་མ་ཡིན་པ་དེ་བས་ན།",
    "ཁྱབ་པར་བྱེད་པ་མི་དམིགས་པ་ཡང་རང་བཞིན་མི་དམིགས་པ་དེ་དང་ལྡན་པ་ཞེས་བྱ་བས་བསྟན་ཏོ།",
    "ཁྱབ་བྱེད་ནི་རྒྱུ་དང་རང་བཞིན་གཉི་ག་ཡང་ཡིན་ཏེ།",
    "འབྲས་བུ་དང་རང་བཞིན་གྱི་རྟགས་དག་ལ་ཁྱབ་པར་བྱེད་པ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཉམས་སུ་མྱོང་བ་ཡང་རང་རིག་པས་ཡིན་གྱི།",
    "དེ་བཞིན་དུ་སྔོན་པོ་ལ་སོགས་པ་ཡང་རང་ཉིད་རྟོགས་པའི་བདག་ཉིད་ཅན་ཡིན་གྱི་གཞན་གྱི་ཆར་གྱུར་པ་ནི་མ་ཡིན་ཏེ།",
    "རྟོག་པ་ཡང་རང་རིག་པའི་ངོ་བོ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "འོན་ཀྱང་རང་ལ་དམིགས་པ་ཁོ་ན་སྔོན་པོ་ལ་སོགས་པ་ཡིན་ཞིང་།",
    "དོན་དུ་སྣང་བ་དང་རང་སྣང་བ་ཞེས་བྱ་བ་ནི་བསྡུས་པའི་དོན་ཡིན་ནོ།",
    "ཡུལ་དུ་སྣང་བ་དང་རང་སྣང་བའི་མཚན་ཉིད་ཅན་དག་ནི་ཞེས་བྱ་བ་ན་གཟུང་པ་དང་འཛིན་པའི་རྣམ་པའི་མཚན་ཉིད་ཅན་དག་གོ།",
    "ནང་མངོན་ཕྱོགས་འཛིན་པའི་རྣམ་པ་ཉིད་ཀྱིས་ཞེས་བྱ་བ་ནི་ནང་རང་རིག་པའི་ངོ་བོ་ཉིད་དུ་རུང་བ་ཉིད་ཀྱི་མཚན་ཉིད་དུ་ཡིན་གྱི།",
    "ཡུལ་ལ་དམིགས་པའི་དམིགས་པ་ཞེས་བྱ་བ་ནི་ཡུལ་ལ་དམིགས་པའི་དམིགས་པ་ཤེས་པ་གཉིས་པ་གང་ཡིན་པ་དེ་ཡང་རང་རིག་པ་ཁས་མི་ལེན་པའི་ཕྱིར་བདག་ཉིད་གསལ་བ་མ་ཡིན་ནོ།",
    "སོགས་པའི་སྒྲ་དང་པོས་ནི་མ་ཆོད་པ་དང་རང་བཞིན་ཁྱད་པར་ཅན་དང་།",
    "ཆོད་པ་མེད་པ་དང་རང་བཞིན་ཁྱད་པར་ཅན་མངོན་དུ་ཕྱོགས་པ་དང་རྐྱེན་གཞན་ཚོགས་པའི་ཕྱིར་རོ་ཞེས་བྱ་བ་འདི་ཡིན་ནོ།",
    "གསལ་བ་འགའ་ཞིག་དུས་ཡིན་ཏེ།",
    "དོན་དམ་པའི་བདེན་པ་གཞན་གྱི་རྒྱུ་དང་རང་ལས་ཀྱང་མ་གྲུབ་པ་ཉིད་དེ་ལྟ་བུ་མཁྱེན་ཅིང་ཐུགས་སུ་ཆུད་ནས།",
    "གནོད་མཛེས་རྒྱལ་པོ་མདུན་དུ་འདུག་སྟེ།",
    "ཡིད་དང་རྗེས་སུ་མཐུན་པའི་གནས་སུ་འདུག་པའི་སྒྲུབ་པ་པོ་གང་ཡིན་པས།",
    "གང་རང་ཉིད་སློབ་པ་དེ་ཡང་རྡོ་རྗེ་འཛིན་འདྲར་འགྱུར་ཏེ།",
    "དེ་བླངས་ནས་འདུག་པའི་རྣལ་འབྱོར་པ་གང་ཡིན་པ་དེ་ནི།",
    "དེ་སྔ་མ་བཞིན་མདུན་དུ་འདུག་པ་ལ་དགྱེས་པའི་བདག་ཉིད་ཅན་ཏེ།",
    "སིདྡྷ་ལོ་ཙ་ནེ་ཞེས་པ་ནི་ཐོགས་པ་མེད་པར་གྲུབ་པའི་ལོ་ཙ་ན་སྟེ།",
    "སྤྱན་གང་ལ་ཡོད་པ་དེ་ནི་སིདྡྷ་ལོ་ཙ་ནི་ཞེས་བྱའོ།",
    "བཞི་དང་རང་བཞིན་རྒྱུ་ཡིན་ཏེ།",
    "སེམས་དཔའ་ཆེན་པོ་འགྲོ་དང་འདུག།",
    "མི་དད་ཅན་གྱི་ཡོན་བདག་མང་འདུག་སྟེ།",
    "གཡུ་རལ་གནམ་ལ་སྤྲུགས་འདུག།",
    "སྨྲ་བརྗོད་བློ་ཡི་བསམ་། ཡུལ་བྲལ་ནས་གདའ།",
    "གོལ་ཤོར་ཞིག་མི་གདའ་ཡེང་མེད་དུ།",
    "ཡང་ཤེལ་བྲག་གུ་རུའི་གཟིམ་ཕུག་ཏུ་བཅད་རྒྱ་ལ་འདུག་པའི་སྐབས།",
    "ཚེ་འདིའི་བྱ་བ་གཏོང་ན་རན་ནས་གདའ།",
    "ཀུན་དགའ་བི་རོ་ཙ་ན་དངོས་ཇི་བཞིན།",
    "ནམ་ཞིག་རང་རང་རྒྱུ་འབྲས་ལ་ལྟོས་ནས།",
    "རང་སྣང་རང་རྩལ་ངོ་མཚར་ཆེ།",
    "འབྲི་གུང་དབལ་འཛིན་སོགས་ཀྱིས་ཀྱང་སྡོགས་ཡོག་སུན་འབྱིན་མཛད་འདུག་ཟེར་བ་སྣང་ཡང་།",
    "མན་ངག་རྫོགས་པ་ཆེན་པོ་ནི་རྡོ་རྗེ་གདན་གྱི་ཀའུ་ཚང་དུ་རྒྱ་རིམ་པ་དགུས་བཏབ་སྟེ་ཤྲཱི་སེང་ཧའི་དྲུང་དུ་དཔོན་སློབ་གཉིསཀས་རྫུ་འཕྲུལ་གྱི་བཀོད་པ་བསམ་གྱི་མི་ཁྱབ་པའི་སྒོ་ནས་གསན་དགོས་བ་བྱུང་འདུག་པས།",
    "རྣལ་འབྱོར་རྣམ་བཞིའི་གོ་རིམ་བགྲོད་ཚུལ་སོགས་འདུག་བས།",
    "འདུག་ཚུལ་དེ་ལྟར་ཡེ་ནས་ཡིན།",
    "རང་སྣང་རང་ལ་ཤར་བ་ལ།",
    "དེ་རྣམས་ཀྱི་དོན་ལ་གྲོལ་བ་ཐོབ་པ་མི་འདུག་པའི་ཕྱིར་དང་།",
    "བཏགས་གྲོལ་ཅེས་བའི་མདེ་མི་འདུག་ཅེས་སྨྲས།",
    "མིག་སྔར་རྡོ་རྗེ་ལུ་རྒྱུ་བརྒྱུད་དུ་གྲགས་པ་ཞིག་འཆར་ཡོང་ཡོད་འདུག་པ།",
    "བསྒྱུར་བྱང་ན་གསལ་བར་འདུག་ཅིང་།",
    "བི་རོ་ཙ་ནའི་གླིང་དུ་འབྱོན་པའི་ཚེ།",
