    "རྒྱལ་པོ་ལྕགས་ཕོ་རྟ་ལོ་ལ་ལྔ་བཅུ་རྩ་དྲུག་ལ་འདས་པས་བསམ་ཡས་ལྕགས་ཕོ་སྟག་ལ་རྨང་གཏིང་ཟེར་འབང་འདུག་གོ།",
    "པ་གོར་བེ་རོ་ཙ་ན།",
    "སྡོམ་པ་སློང་གསུམ་ཀློང་ཐང་དུ་འདུག་པ་མཐོང་བས་བཙལ་ཏེ་དཔལ་གྱི་རྡོ་རྗེ་དང་སྲུང་ཟེར་ནས་དབྱར་ཟླ་གསུམ་རྩ་བཞི་སྣ་ཡུད་ལ་སྲུང་།",
    "སུམ་པ་ཡེ་བྱོན་པས་ཚོང་པ་རྣམས་སུམ་འཕྲང་དུ་ཚོང་བྱ་སྙམ་ནས་ལྡོག་པར་འདུག་པ་ལ་ཤེས་བློ་དང་ལྔ།",
    "འོ་ན་ཁྱེད་དྭ་ཕྲུག་ཏུ་འདུག་བྱས་པས་མིང་དྭ་ཚོར།",
    "༡༩བྲན་ཀ་མུ་ཏི་ཀ་༢པ་གོར་བེ་རོ་ཙ་ན་རཀྴི་ཏ།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན་རཀྵི་ཏས་མཛད་པའི་སྤྱོད་འཇུག་འགྲེལ་པ།",
    "དེའི་འགྲེལ་པ་སློབ་དཔོན་སློབ་དཔོན་རྒྱ་མཚོ་སྤྲིན་གྱིས་མཛད་པ་བམ་པོ་ཉི་ཤུ་སྔར་ཀ་ཅོག་དུས་སུ་འགྱུར་ཐོགས་མེད་ཀྱིས་མཛད་པ་གཉིས་བློ་ལྡན་ཤེས་རབ་ཀྱི་འགྱུར།",
    "སློབ་དཔོན་བེ་རོ་ཙ་ན་རཀྵི་ཏས་མཛད་པའི་དཔོན་དཔའ་བོས་མཛད་པའི་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་བསྡུས་པ་ཚིག་ལེའུར་བསླབ་པ་མེ་ཏོག་སྙེ་མ་སེང་གེ་རྒྱལ་མཚན་ལ་སོགས་པའི་འགྱུར།",
    "སློབ་དཔོན་བྱས་པ་བམ་པོ་གཉིས་བེ་རོ་ཙ་ན་རཀྴི་ཏའི་འགྱུར།",
    "སྦྱིན་པའི་འགྲེལ་སློབ་དཔོན་བེ་རོ་ཙ་ན་རཀྵི་ཏས་མཛད་པ་ཤོ་ལོ་ཀ་བརྒྱ་ནག་ཚོའི་འགྱུརགཏམ།",
    "སྤྱི་ཐ་དད་མེད་པ་དགག་པ་ཤོ་ལོ་ཀ་ཉི་ཤུ་རྩ་གཅིག་སྤྱི་ཐ་མིས་མཛད་པའི་རིགས་པ་གྲུབ་པའི་སྒྲོན་མ་བེ་རོ་ཙ་ནའི་འགྱུར།",
    "ཙ་ན་ཀ་ལུགས་ཀྱི་སྦྱོར་བའི་སྒོ་རྩ་འགྲེལ།",
    "ནག་པོ་རྡོ་རྗེའི་དོ་ཧ་མཛོད་རྩ་འགྲེལ་རྣམས་བེ་རོ་ཙ་ན་ངན་སེལ་རྩ་འགྲེལ་ཡེ་ཤེས་འབྱུང་གནས་ཀྱི་འགྱུར།",
    "སློབ་དཔོན་ཤེས་རབ་རྣམས་བེ་རོ་ཙ་ན་བཛྲའི་རང་འགྱུར།",
    "བིརླ་པའི་དོ་ཧ་མཛོད་བི་ཛཱ་རོ་ཙ་ནའི་རང་འགྱུར།",
    "སེམས་ཉམས་སྨྲས་པ་ཤོ་ལོ་ཀ་བེ་རོ་ཙ་ན་རཀྵི་ཏས་མཛད་པའི་སྣང་བ་མཐའ་ལྔ་ཕུང་འགྲེལ་པའི་མི་བརྗེད་པའི་ཚིག་བམ་པོ།",
    "འདི་དག་ཐམས་ཅད་ཀྱང་སྤྱིའི་མཚན་ཉིད་ལས་བརྩམས་ནས་གཏན་དུ་དྲི་མ་མེད་ཅིང་རང་བཞིན་གྱིས་ཡོངས་སུ་དག་པའི་ཕྱིར་ཡིད་བཞིན་གྱི་ནོར་བུ་རིན་ཆེན་དང་།",
    "དཔེར་ན་མི་བརྟན་ཞིང་རང་བཞིན་མེད་པ་སྤྲིན་གྱི་རྣམ་པ་ཇི་ལྟ་བ་བཞིན་དང་།",
    "ལོངས་སྤྱད་ཅིང་ཉམས་སུ་མྱོང་ཡང་རང་བཞིན་མེད་པ་རྨི་ལམ་གྱི་སྣང་བ་ཇི་ལྟ་བ་བཞིན་དུ།",
    "སྣ་ཚོགས་སུ་སྣང་ཡང་རང་བཞིན་མེད་པ་སྒྱུ་མའི་གཟུགས་བརྙན་ཇི་ལྟ་བ་བཞིན་དུ།",
    "སྤྲིན་དང་རྨི་ལམ་དང་སྒྱུ་མ་བཞིན་དུ་སྣང་ཡང་རང་བཞིན་མེད་པའོ།",
    "མ་འདྲེས་པ་བཅོ་བརྒྱད་པོ་དག་དྲི་མ་དང་བྲལ་བའི་འབྲས་བུའི་ཡོན་ཏན་སུམ་ཅུ་ནི་རྩ་གཉིས་ཞེས་བྱ་བ་ཡིན་པ་འདི་རྣམས་ཀྱང་རང་དོན་དོན་དམ་པ་༧༢ན་",
    "དེ་ལྟར་ན་ཡང་རང་ཉིད་ཉམས་པའི་རྒྱུ་ཡིན་པས་མཁས་པ་རྣམས་ཀྱིས་དེ་ལྟར་བྱ་བ་མ་ཡིན་ནོ།",
    "སྣང་ཡང་རང་བཞིན་མེད་པ་ཆུ་ཟླ་བཞིན།",
    "ནམ་མཁའ་བཞོས་ཤིང་བཞོས་ཤིང་འཐུང་ཞིང་འདུག་ནམ་མཁའ་ནམ་མཁར་སྦྱོར་བདེ་མ་མཐོང་།",
    "ནམ་མཁའ་བཞོས་ཤིང་བཞོས་ཤིང་འཐུང་ཞིང་འདུག་དེ་འདྲའི་རྣལ་འབྱོར་རྩ་བའི་ཁྱིམ་ལས་གཡོ།",
    "ནམ་མཁའ་བཞོས་ཤིང་བཞོས་ཤིང་འཐུང་ཞིང་འདུག་ས་ར་ཧ་ས་བརྗོད་གང་གཞན་ཅི་ཕྱིར་བྱེད།",
    "ཌོ་མབི་གཞུ་བ་ཀང་གཟུང་ནས་རྣམ་པར་འདུག།",
    "རང་བྱུང་རང་བཞིན་གཡོ་བ་མེད།",
    "གང་ཞིག་སྤྲིན་ལྟར་རྟོག་པ་སེལ་ཅིང་རང་བཞིན་དྲི་མ་མེད།",
    "བདེ་བར་སྟན་ལ་འདུག་བྱས་ལ།",
    "བདེ་བར་སྟན་ལ་འདུག་ནས་སུ།",
    "བྱིན་གྱིས་བརླབ་བྱ་ཆུ་དང་རང་ཉིད་ལ།",
    "གང་ཡང་རང་བཞིན་རྟོགས་པ་དེ།",
    "ཕྲ་ཞིང་རང་རྒྱུད་ཡེ་ཤེས་ཀྱི།",
    "སྐྱེ་བ་དྲན་ཞིང་རང་སེམས་རྟོགས།",
    "ཉི་ཟླ་གཉིས་ཀྱང་སྐྱབས་སུ་གཞུག་གར་བྱེད་དཔལ་གྱི་ཨ་ཙི་ན་ཐོད་པ་ཅན།",
    "གར་བྱེད་དཔལ་གྱི་ཨ་ཙ་ན་ཐོད་པ་ཅན།",
    "གར་བྱེད་དཔལ་ནི་ཨ་ཙིན་ཐོད་པ་ཅན།",
    "ནགས་སུ་གནས་ན་བདེ་བར་འདུག་དེ་ནས་བྱུང་ནས་གསོད་པར་བྱེད།",
    "ཨ་ཙིནྟ་བྷ་བ་ཏི་པ་རི་བྷཱ་བ་ན་ནཱ་མ།",
    "ཙ་ན་ཀ་ཡི་འབྲས་བུ་སྟེ།",
    "ཞག་དུས་སྐྱུ་རུ་བཞི་དག་ཟ།",
    "ནམ་ཡང་རང་བཞིན་ཡེ་ཤེས་ཏེ།",
    "ཕྲ་ཞིང་རང་བཞིན་བ་རྒྱུ་བ།",
    "སེམས་ལ་ཐེ་ཚོམ་མ་བྱེད་ཅིག་ཀྱེ་མ་གླང་ཆེན་ཁྲི་ལ་འདུག་སྦྲང་བུ་གཉིས་ཀྱིས་འདེགས་པར་བྱེད།",
    "པདྨས་ཁྲག་ངོམས་ཆུ་ཡི་ནང་འདུག་ཤ་ཡི་ཕྱིར་མི་འབྲང་།",
    "ཚོང་ཁང་དུ་ཚོགས་འགྲོན་བོ་ཐད་ཀར་མི་འགྲོགས་རང་རང་གུད་དུ་འགྲོ།",
    "འཛའ་བོའི་བརྩེ་གདུང་གྲོགས་ཀྱིས་བསླུས་ཚེ་ཞིག་ངལ་བར་མི་འདུག་གསེར་ཚོན་རྙེད་པའི་མི།",
    "འདི་ལ་བདེ་བའི་བར་མཚམས་འདུག་གམ་ཅི།",
    "འདབ་གཤོག་རྒྱས་ཚེ་ཚང་ན་འདུག་ཀྱང་མཁའ།",
    "བཤལ་རྗེས་མི་སྲུང་རང་ལ་གནོད་པར་བས།",
