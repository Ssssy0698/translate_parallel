    "ནོར་ཅན་པདྨ་ཅན་ཞེས་པར།",
    "རིགས་བརྒྱུད་བཅས་པར་ཚེ་འཕོས་པའི།",
    "ད་ལྟའི་ཕུན་སུམ་ཚོགས་པ་གསུངས། ༩༡།",
    "མེད་ཅེས་བདེན་པར་རང་ལུས་བསོས།",
    "ཡིན་པར་འཁོར་ལ་བཀའ་སྩལ་ཏོ། ༩༢།",
    "བཀག་པར་རྡོག་པས་བསྣུན་ནས་ཕྱིན།",
    "དེ་ནས་ལྕགས་ཀྱི་ཁང་པར་སླེབས།",
    "རྒྱལ་བས་མཁྱེན་ནས་ཀུན་དགའ་བོར།",
    "ནང་པར་ཤིང་རྟ་རི་སེང་གླང་།",
    "བྱ་བ་བྱས་པའི་འབྲས་བུ་རུ།",
    "བུ་གཉིས་ཆོམ་རྐུན་བྱེད་པར་གྱུར།",
    "གཤེད་མ་བསྐོས་ཏེ་གསོད་པར་བརྩམས།",
    "འོངས་ནས་སྟོན་པར་མཚོན་ཆར་ཕབ།",
    "མཚོན་རྣམས་མེ་ཏོག་ཆར་པར་གྱུར།",
    "དེ་རྣམས་ཚོང་པར་སྐྱེས་པའི་ཚེ།",
    "དེ་ཉིད་གསོད་འདོད་རྡོ་འཕངས་པར།",
    "མངོན་ཤེས་ལྔ་དང་ལྡན་པར་གསུངས།",
    "དེ་ལ་ཐབས་གཞན་གྱིས་རྡུགས་པར།",
    "གླེང་ཡང་རྙེད་པར་མ་གྱུར་ཚེ།",
    "ཟས་གཙང་མྱ་ངན་འདས་པ་ལ།",
    "ཐུབ་པས་མཆོད་རྟེན་བཞེངས་པར་མཛད།",
    "ཚངས་བྱིན་རྔོན་པར་རྒྱུ་དང་ཕྲད།",
    "རྒྱལ་པོ་འགྱོད་ནས་བཟོད་པར་གསོལ།",
    "དུག་སྦྲུལ་ལྷས་བྱིན་ཡིན་པར་གསུངས། ༡༣",
    "རྒྱལ་པོ་འགྱོད་པ་སྐྱེས་པར་གྱུར།",
    "སྔོན་ཚེ་ཁྱིམ་བདག་ཟས་གཙང་ཞེས།",
    "ཁྱིམ་བདག་ཟས་གཙང་ཞེས་བགྱི་བར།",
    "རྒྱལ་པོ་སྤྲིན་གྱི་ཏོག་གྲོགས་པར།",
    "གསེར་གྱི་ལྗོན་པར་ལོངས་སྤྱོད་བྱུང་།",
    "ཕན་ཚུན་ཡིད་ནི་ཆགས་པར་གྱུར།",
    "བག་ཕེབས་གཏམ་གྱི་སྦྱོར་བའི་སྐབས།",
    "ཐེ་ཚོམ་མེད་པར་ཀླུ་ཡི་ཚབ།",
    "ཚིག་ཉུང་དོན་ཚང་བུམ་པར་ལེགས་གཏམས་འདི།",
    "དབྱངས་ཅན་རྒྱུད་མངས་མགྲིན་པར་འཁྲོལ་ལས་སོ།",
    "མཁྱེན་སྤྱོད་བདུད་རྩིས་གངས་ཅན་ཕན་བདེའི་སྲོག།",
    "མཁྱེན་ཡངས་སྒམ་པའི་ཐུགས་ཀྱིས་ལེགས་གནོན་པ།",
    "ལེགས་བརྡར་གོང་བུར་བྱས་པའི་སྐུ་རྒྱུ་ལ།",
    "རྣམ་དཔྱོད་ཕྲག་པར་ལེན་པའི་ལྕང་ར་བ།",
    "པར་རྐོས་བློ་གྲོས་བཟང་པོའི་མཆོག་གྱུར་པ།",
    "ལེགས་བྱས་རིན་ཅེན་ཐེམ་སྐས་ལ་འཛེགས་ནས།",
    "གསེར་སོགས་ཀྱི་འདོན་ཆའི་རྐངས་བྱས།",
    "ས་ཧོར་མཆོད་ཡོན་ཟླ་བ་བཅུ་གཅིག་པར།",
    "གཡུལ་ལས་རྣམ་པར་རྒྱལ་བའི་དམར་ཕྱོགས་ཀྱི།",
    "གསུངས་པས་སླུ་མེད་དཀའ་ལས་ཅི་ཕྱིར་འགོང་།",
    "ཡིན་ཞེས་འཇམ་དཔལ་རྒྱུད་ལས་ལེགས་པར་གསུངས།",
    "དགེ་ཚོགས་འབྲས་བུ་འབྱིན་ལ་འབད་པར་རིགས།",
    "ཇ་ཡུན་གཉིས་པར་ཤེས་བཞིན་བྱ་ར་མཛོད།",
    "བཞི་ལ་འཐབ་རྩོད་ལྔ་པར་མུ་གེ་འབྱུང་།",
    "བླུན་པོ་དམ་པར་སྒྲོ་བཏགས་བསྟན་འཛིན་མིང་།",
    "སྲིད་ཞིའི་ལེགས་ཚོགས་མ་ལུས་འགྲུབ་པར་མཛོད།",
    "བླུན་པོ་འདྲེན་པར་རློམ་པའི་གཅན་གཟན་མདུན།",
    "རབ་ཏུ་གནས་པ་རྒྱ་ཆེར་གསུངས་པ་ཡི།",
    "གནོད་སྦྱིན་བང་མཛོད་བཅས་པའི་བཞུགས་ཚུལ་ལ།",
    "ཟས་གཙང་སྲས་ཀྱི་འཕེལ་གདུང་མ་སྐྱེས་དགྲའི།",
    "སྤྱན་དྲངས་ཡར་འབྲོག་ཁྲི་སྐོར་ལེགས་བྱས་ཀྱི།",
    "ཞིང་དུ་བཞུགས་པའི་འཁྲུལ་མེད་གྲགས་ཅན་དང་།",
    "གནང་བའི་ངོ་མཚར་རྡོ་ཡི་པུས་འཁྱུད་དང་།",
    "བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པའི་དབུ་ཞྭ་དང་།",
    "སྐུ་བེམ་གདུང་རུས་བཞུགས་འདིང་ཞབས་སྒྲོག་བཅས།",
    "མཉམ་མེད་དགའ་ལྡན་པར་གྲགས་དད་རྟེན་ལ།",
    "ཐམས་ཅད་མཁྱེན་པ་ཡོན་ཏན་རྒྱ་མཚོ་ཡི།",
    "བཞེས་པའི་ན་བཟའ་དང་ནི་གར་ཕོད་བཅས།",
    "མཁྱེན་པའི་སྤྱན་སྔ་རང་བྱུང་རྡོ་རྗེའི་གདུང་།",
    "དེ་ལས་གསུངས་པའི་ཁྲོ་བོ་བཅུ་ཡི་སྔགས།",
    "གུར་ལས་གསུངས་པའི་ཡི་གེ་བརྒྱ་པ་དང་།",
    "རབ་ཏུ་གནས་པར་བྱེད་པའི་གསང་སྔགས་དང་།",
    "སྦྱོང་རྒྱུད་རྣམས་ལས་གསུངས་པའི་ཚེ་ཡི་གཟུངས།",
    "གོང་འོག་མ་འཁྲུགས་དཔྱད་བཟོད་ཁོ་ནར་བཞུགས།",
    "ཚེ་དཔག་མེད་མགོན་སྒྲོལ་དཀར་རྣམ་པར་རྒྱལ།",
    "རིན་ཅེན་གསེར་སྦྱངས་ཁུ་བས་དག་པར་བྲིས།",
    "འཁྲུལ་པ་མེད་པའི་མན་ངག་ཇི་བཞིན་བཞུགས།",
    "ཀུན་ཀྱང་བཞུགས་གནས་འཁྲུལ་པ་མེད་པ་ལ།",
    "ལྷ་ས་བསམ་ཡས་ཁྲ་འབྲུག་ཡེར་པ་དང་།",
    "བཞུགས་ཁྲི་དང་ནི་མཁའ་འགྲོའི་ཟས་ཀྱི་ཕྱེ།",
    "ལེགས་པར་སྦངས་པའི་འཇམ་མཉེན་རས་དཀར་ཏེ།"
  ]
}