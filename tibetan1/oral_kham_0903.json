    "དྲན་བསམ་ཐམས་ཅད་རང་བྱུང་རང་ཞི་ན།",
    "རྩལ་རྒྱ་ཡནཾ་དུ་ཤོར་ཡང་རང་ཤར་རང་གྲོལ་ཏེ་ངོ་བོའི་ངང་ལ་རང་ཡལ་དུ་འགྲོ་བས་ན།",
    "རྩལ་དང་རོལ་བ་དྲན་བསམ་ཐམས་ཅད་རིག་པའི་ངང་ནས་རང་བྱུང་རང་ཤར་རང་ཡལ་རང་སར་ཞི་ནས་འགྲོ་བ་ན།",
    "ཀུན་ཀྱང་རང་བྱུང་རང་སར་གྲོལ་བ་ཡིན།",
    "ཞེས་རིག་པའི་ངོ་བོ་དེ་ཉིད་སྟོང་ཞིང་རང་བཞིན་གསལ་བའི་བདག་ཉིད་ཅན་ལ།",
    "ཀུན་གཞི་ནི་རིག་པ་ཟང་ཀར་མ་རྟོགས་པའི་རྟོག་མེད་ལུང་མ་བསྟན་འཐིབ་ཆ་ཅན་ཧན་ནེ་ཧོན་ནེ་ཐོམ་མེ་བ་རྣམ་རྟོག་འགགས་ནས་འདུག་པ་དེ་ཡིན་ཏེ།",
    "རང་ཉིད་འདུག་པའི་གནས་ཁང་ཕུན་ཚོགས་འབྱོར་བ་དང་།",
    "རང་བཞིན་བར་མ་འགྲོ་འདུག་གྱིན་འདར་གནས།",
    "གཉིད་ཀྱང་རང་བྱུང་གདོད་མའི་ཀློང་ཆེན་ཏེ།",
    "ཕྱི་རོལ་ཏུ་གཞན་གྱིས་འགྲོ་འདུག་བྱེད་པ་སོགས་ཀྱང་ཤེས་བཞིན་མཐོང་རྒྱ་ཆུང་ཞིང་།",
    "དེས་ན་སྒྲོ་འདོགས་སྐུར་འདེབས་བྱེད་མཁན་དེ་ཉིད་ངན་འགྲོ་མཐའ་མེད་དུ་འདུག་དགོས་པར་མ་ཟད།",
    "རྟོག་པ་ཆུང་ཞིང་རང་བཞིན་དལ།",
    "སེམས་ནང་དུའང་མ་གྲུབ་པས་སྟང་པ་བྱ་ལམ་རྗེས་མེད་ཙམ་དུ་འདུག་པས་རང་ཡལ་རང་གྲོལ་སྟོང་པ་ཟང་མའི་ངོར་མཉམ་པ་དང་།",
    "དག་དང་མ་དག་ཞེས་པའི་དགུ་གཞིའི་ངོ་བོ་སྟོང་པར་རང་གྲོལ་ཉིད་དུ་འདུག་གོ།",
    "རྣམ་སྨིན་མེད་ཅིང་རྣམ་སྨིན་མྱོང་བའི་གཞི་མེད་པར་ཡེ་གྲོལ་དུ་འདུག་སྟེ།",
    "དེའང་གཉེན་པོ་ཞེས་བྱ་བ་དེ་ཡེ་གྲོལ་དུ་འདུག་སྟེ།",
    "སྤྱིར་གྲོལ་བ་ནི་བཅིང་པ་ལ་ལྟོས་ནས་བཅིང་པ་དེ་ལས་གྲོལ་བས་ན་གྲོལ་བ་ཞེས་འཇོག་དགོས་ཀྱང་འདིར་བཅུང་པུ་མེད་པར་རང་གྲོལ་དུ་འདུག་ན།",
    "གློད་དང་མ་གློད་ཟེར་བའི་གློད་རྒྱུ་དེ་གཞི་ནས་ཡོད་མ་མྱོང་པས་མེད་པ་སྟོང་པ་ཉིད་རིག་པ་རང་གྲོལ་ཆེན་པོའི་ངང་དུ་རང་ཡལ་དུ་འདུག་གོ།",
    "ཅོག་གཞག་ཅེས་པའང་ཡེ་གྲོལ་དུ་འདུག་སྟེ་ཅོག་གེར་གཞག་ཟེར་བའི་འཇོག་ས་དང་།",
    "འཆིང་བྱེད་འཛིན་པ་སེམས་ཞེས་བྱ་བ་གཉིས་ཡེ་ནས་ཡོད་མ་མྱོང་བར་ཡེ་གྲོལ་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུག་གོ།",
    "ཁྱེད་ཅག་ཅི་བྱ་ང་ནི་གང་ན་འདུག།",
    "ངའི་འདུག་ས་དང་འདུག་གནས་ཀྱང་གཞི་རྩ་བྲལ་བས་ཟང་ཀ་མ་བྱ་སངས་སྟོང་ཡལ་དུ་འདུག་གོ།",
    "བདག་པོ་རང་ཁྱིམ་དུ་བདེ་བར་འདུག་ཆོག་པ་བཞིན།",
    "དེའང་རང་བྱུང་རིག་པའི་ཡེ་ཤེས་རྒྱ་ཆད་ཕྱོགས་ལྷུང་དང་བྲལ་བ།",
    "རྒྱ་ཆད་ཕྱོགས་ལྷུང་ཞེས་པ་ཡེ་ནས་མི་སྲིད་པས་ཀ་དག་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུག་པ་ནི་རིང་བཞིན་གྱི་བབས་ཡིན།",
    "རྩལ་རྒྱ་གྲོལ་ཏུ་འདུག་པས་ན་རྩལ་དང་།",
    "རོལ་པ་ལས་འཆར་བ་མི་སྲིད་པར་ཀུན་བཟང་ཐིག་ལེ་ཉག་གཅིག་ཏུ་འདུག་པ་ནི་རང་བཞིན་བབས་ཀྱི་གནས་ལུགས་ཡིན་ནོ།",
    "དེའང་རང་བྱུང་ཡེ་ཤེས་ཞེས་པ་དེ་ལ་བརྟགས་ཤིང་དཔྱད་ན་རང་བྱུང་ཡེ་ཤེས་ཀྱི་དོན་ནི་ངོ་བོ་མེད་པའི་སྟོང་པ་ཡིན་ལ།",
    "དྲི་རུ་ཚོར་བ་དེ་སྣང་ཤེས་གཉིས་ཀ་ཡེ་ནས་ཡོད་མ་མྱོང་པའི་ངོ་བོ་སྟོང་པའི་དབྱིངས་སུ་རང་གྲོལ་དུ་འདུག་གོ།",
    "ཇི་ལྟར་ན་ཕྱོགས་མེད་ཀྱི་སྣང་བ་འདི་དག་མ་བཅོས་རང་བྱུང་རིག་པ་ལྷུན་གྲུབ་དང་དབྱེར་མེད་ཟུང་འཇུག་ཆེན་པོའི་ཀློང་དུ་ཡེ་གྲོལ་དུ་འདུག་གོ།",
    "མེད་པར་བརྗོད་ཀྱང་རང་བཞིན་མ་འགགས་པའི་རྩལ་སྣང་ཐམས་ཅད་མཚོ་ལ་གཟའ་སྐར་ལྟར་བཀྲ་ལམ་མེར་གསལ་པ།",
    "ཏིང་ངེ་འཛིན་འགག་མེད་རང་གསལ་དུ་འདུག་པ།",
    "བསྟན་བཅོས་འདི་ཡང་རང་བྱུང་ཡེ་ཤེས་ཀྱི་ཀློང་ལས་། མེད་སྣང་སྟོང་བའི་རང་གཟུགས་རང་ལ་ཤར་བ་མ་གཏོགས་དོན་ལ་རིག་པ་འཕོ་འགྱུར་མེད་པའི་ཀློང་ལས་གཞན་དུ་ཅི་ཡང་མེད་ཀྱང་རྩལ་དང་རོལ་བར་ཤར་བ་ཡིན་ནོ། གཉིས་པ་བརྗོད་བྱ་རྟོགས་པའི་དོན་ངོས་བཟུང་བ་ནི།",
    "ལུང་ལས་མ་བྱུང་རང་བྱུང་རིག་པའི་དོན།",
    "དུས་རབས་ཉེར་གཅིག་པའི་འཛམ་གླིང་རང་བཞིན་ཅན།",
    "དེའི་སྐབས་སུ་ང་རང་ལོ་༨ཅན་གྱི་སྐྱེས་པ་ཆུང་ཆུང་ཞིག་ཡིན།",
    "གལ་ཏེ་ཚོང་དོན་འཚམས་བཞག་པ་ཡིན་ན་དམག་འཁྲུག་ཡོང་བར་ང་རང་ཡིད་ཆེས་བརྟན་པོ་ཡོད།",
    "འོན་ཀྱང་ཀྲུང་གོ་མི་རིང་བར་རྩིས་རྒྱག་རྒྱལ་ཁབ་ཅིག་ཏུ་འགྱུར་ཐུབ་པར་ང་རང་ཡིད་ཆེས་ཡོད།",
    "ཉིན་འགའ་ཡི་སྔོན་དུ་ང་རང་ཨ་རིའི་འཕྲིན་སྦྱོར་རྩེ་གྲས་དོ་དམ་པ་འགའ་དང་མཉམ་དུ་ཤར་ནུབ་རྒྱལ་ཁབ་ཀྱི་ཁྱད་པར་ཕྱོགས་ཀྱི་ཁ་བརྡ་བྱས་པ་ཡིན།",
    "དཔེར་ན་སྤོམ་ཤོན་དང་འདྲ་འདུག་ཟེར།",
    "འདི་ནི་ང་རང་སྤྲོ་སྣང་ཡོད་སའི་རྨི་ལམ་ཡིན།",
    "ཁོ་རང་ཧ་ཅང་ཕུལ་བྱུང་ཡིན་ཟེར།",
    "གཙོ་ཤུགས་རུ་ཁག་དུས་རབས་༨དང་༩ནང་སྐྱེས་པའི་མི་ཡིན་དགོས།",
    "ཨ་ལས་པ་པ་ཀྲུང་གོ་ནས་སྐྱེས་ཀྱང་འདི་ནི་འཛམ་གླིང་རང་བཞིན་ཅན་གྱི་སྤྱི་གཉེར་ཁང་ཞིག་ཡིན་ཞེས་ལན་བཏབ།",
    "མེད་པ་དང་གཏིང་ལམ་དུ་འདུག་པ།",
    "སྤྱི་སྤྱོད་རླངས་འཁོར་དུ་འདུག་པ།",
    "མི་ཚང་མས་འགྲིག་འདུག་ཟེར་སྐབས་སྐར་མ་འགའ་ལ་སྒུག་དང་།",
    "མི་ཚང་མས་འགྲིག་མི་འདུག་ཟེར་ཡང་ཅུང་ཙམ་སྒུག་རོགས་དང་།",
    "ཚན་རྩལ་གྱིས་འཇིག་རྟེན་ལ་བསྒྱུར་བཅོས་བྱས་པ་མ་ཡིན་པར་ཚན་རྩལརྒྱབ་ལྗོངས་ཀྱི་རྨི་ལམ་གྱིས་འཇིག་རྟེན་ལ་བཅོས་བསྒྱུར་གཏོང་བ་ཡིན་པ་ང་རང་ཡིད་ཆེས་བརྟན་པོ་ཡོད།",
    "འོན་ཀྱང་ངས་རྒྱུས་ལོན་བྱུང་བ་ལྟར་ན་འབྲེལ་དྲྭས་དོན་དངོས་ཀྱི་འདྲ་མཉམ་བསྐྲུན་འདུག་ཨ་ལས་ཀྱི་ལས་བཟོ་བ་ཚང་མས་ཁེ་ལས་ཆུང་ཆུང་དག་ལ་རྒྱབ་སྐྱོར་བྱེད་ངེས།",
    "དེར་འབྲེལ་དྲྭའི་སྟེང་དུ་ཀྲུང་གོའི་ཆ་འཕྲིན་གཅིག་ཀྱང་མི་འདུག་དེ་བཞིན་ངས་འབྲེལ་དྲྭའི་འཕྲོག་ཤུགས་ལ་སེམས་ཚོར་བྱུང་བ་དང་བསྟུན་ཁྲོམ་རའི་གོ་སྐབས་གང་དུ་ཡོད་ཀྱང་རྟོགས་བྱུང་།",
    "གནོན་ཤུགས་སོགས་ཆེ་འདུག་ནོར་འཐར་བ་གདམས།་",
    "དགོད་བྲོ་བ་ཞིག་ལ་ཕྱི་རྒྱལ་པ་ཚོ་ཧང་གྲོས་སུ་ལྗོངས་རྒྱུར་ཡོང་བ་ཡིན་པས་ང་ལ་ཁ་ཡ་བྱེད་ཁོམ་ཡོད་མི་འདུག་ཐབས་ཤེས་གཞན་མེད་པས་ངས་བསམ་བཞིན་དུ་ཟས་ཁང་སྒོ་ནས་སྐད་སང་མཐོན་པོའི་ངང་དབྱིན་ཡིག་གྱེར་བ་ཡིན།",
    "སྔོན་ཆད་ངས་ང་རང་དེ་འདྲའི་སྤྲོ་སྣང་ལྡན་པ་ཤེས་ཀྱི་མེད།",
    "གང་ལྟར་ཆུང་ནས་བཟུང་ཕམ་ཁ་བརྒྱུད་པ་མང་དྲག་པས་གོམས་འདྲིས་སུ་གྱུར་འདུག་པས་ལས་ཀ་བསྡུ་ལེན་ལེགས་འགྲུབ་མ་བྱུང་ཡང་ཕྱིར་ཁྱིམ་དུ་ལོག་སྐབས་སེམས་པ་དེ་ཙམ་སྐྱོ་མི་འདུག་ལག་གཡོན་གྱིས་ལག་གཡས་ལ་དྲོད་སྦྱིན་ཏེ་སང་ཉིན་སྔར་ལས་བཟང་བ་ཡིད་ཆེས་བྱས་པ་ཡིན།",
    "ན་གཞོན་ཚོས་ཏག་ཏག་འགྲིག་འདུག་སྙམ་བཞིན་ཡོད་ངེས།",
    "ད་ལྟའི་དུས་རབས་ལྟ་བུ་ཞིག་དུས་རབས་གང་དུ་ཡོད་མྱོང་མེད།",
    "གལ་ཏེ་མི་འདི་ཡག་པོ་འདུག་སྙམ་ཚེ།",
    "སྙི་ཆས་སོགས་ཀྱིས་འཕྲོག་ཟིན་འདུག་སྙམ་མྱོང་།",
    "དཔེ་མི་སྲིད་པའི་ཁེ་ལས་པ་འགའ་བཟོ་སྐྲུན་ཐུབ་པར་གདོད་མི་ཟ།",
    "ངས་བསམ་ན་འགྲུབ་ཚད་ཧ་ཅང་ཆེ་འདུག་གྲོག་མའི་གསེར་གོས་ལ་འཛམ་གླིང་ཧྲིལ་པོས་ལྟ་སྐུལ་དང་ལེན་བྱེད་དུ་འཇུག་འདོད།",
    "ང་རང་སྐུ་ཞབས་ཡོན་ལོང་ཕེན་ལགས་པ་གུས་བརྩི་ཆེན་པོ་ཡོད།",
    "ལྡབ་གཅིག་འཕར་བ་ལ་བཟོ་ལས་བ་ག་ཚོད་དགོས་འདུག་སྔོན་རྩིས་བརྒྱབ་རྗེས་གལ་ཏེ་ལྡབ་གཅིག་འཕར་དགོས་ན་ད་དུང་མི་གྲངས་༧༨སྣོན་དགོས་འདུག་ཟེར།",
    "ནམ་རྒྱུན་ངས་འདི་དག་དྲན་སྐབས་ང་རང་ཕྱི་སྐར་པ་ཞིག་ཡིན་ན་འདོད།",
    "མཚེའུ་དེ་ཕལ་ཆེར་སྐམ་ཟིན་འདུག་ཁྱེད་ཚོས་ཀྲུང་གོའི་མི་རྣམས་སྤྱི་འབྲེལ་འཕྲིན་སྦྱོར་ཐོག་ཏུ་པར་ཅི་ཞིག་མཉམ་སྤྱོད་བྱེད་རྒྱུར་དགའ་པོ་ཡོད་པ་ཤེས་སམ།",
    "མཐར་ལོ་དྲུག་ལ་དགེ་རྗེས་ངས་ང་རང་འགྱུར་གྱི་ཡོད་པ་ཤེས་བྱུང་།",
    "འབྱུང་འགྱུར་གྱི་གོ་སྐབས་གང་དུ་འདུག་ཨ་ལས་པ་པ་ནམ་ཡང་གོ་སྐབས་ནི་ནམ་ཡང་གོ་སྐབས་ནི་དཀའ་ངལ་གྱི་གསེབ་ཏུ་ཡོད་པ་ཡིད་ཆེས་ཡོད།",
    "ཀྲུང་གོ་ལོ་༡དང་༡༥ནང་དུ་སྔར་ལས་བཟང་ང་རང་མ་ཡོན་གྱིས་འབྱུང་འགྱུར་གླེང་བ།",
    "གོ་ལའི་ཆེད་དུ་འདི་འདྲའི་མཛེས་སྡུག་ལྡན་པའི་ས་གནས་ཤིག་སོར་བཞག་ངང་སྲུང་སྐྱོབ་བྱས་འདུག་ཡེ་ཤེས་བསྟན་འཛིན་གྱིས་བསྒྱུར།",
    "ངའི་སེམས་སུ་ཁོ་ཧ་ཅང་མི་ཡག་པོ་འདུག་སྙམ་བྱུང་།",
    "ང་རང་བཟོ་བཀོད་པ་དང་མཐོ་རིམ་ལག་རྩལ་པ་ཡང་མིན།",
    "མ་ཡོན་གྱི་ལྟ་ཚུལ་མང་ཕྱོགས་ཤིག་ལ་ང་རང་འཐད་པ་ཡོད།",
    "ང་རང་མིས་བཟོས་རིག་ནུས་ལ་སྤྲོ་ཡེ་ཤེས་བསྟན་འཛིན་གྱིས་བསྒྱུར།",
    "ང་ཀྲུང་གོར་སྤྲོ་སྣང་ཡོད་ས་ནི་ཀྲུང་གོའི་མི་རྣམས་ཀྱིས་ལག་རྩལ་དོ་སྣང་ཆེན་པོ་བྱེད་ཀྱི་འདུག་འཛམ་གླིང་ཧྲིལ་པོ།",
    "གཅིག་བྱས་ན་ང་རང་ལག་རྩལ་ལས་མཁན་ཡིན་པས་ལག་རྩལ་ལ་དོ་སྣང་ཆེན་པོ་བྱས་པ་ཡིན་སྲིད།",
    "ངས་ལག་རྩལ་མི་ཤེས་པས་གཏན་ཚིགས་ལ་བསམ་བློ་གཏོང་བ་ལས་ཐབས་གཞན་མི་འདུག་ལག་རྩལ་གྱི་སྟེང་ནས་ངས་བཀྲ་ཆུང་ལ་གུས་བཀུར་ཆེན་པོ་ཡོད།",
    "ད་ལྟ་ལོ་༡ཙམ་འགྲོ་འདུག་གསར་གཏོད་བྱས་ནས་ཀྱང་ལོ་༥ཙམ་ཡིན།",
    "འདི་དང་དེ་མི་འགྲིག་མི་འདུག་ཟེར་བ་སོགས་མང་པོ་ལབ་རྒྱུ་འདུག་ངས་ནམ་ཡང་མི་གཅིག་ལ་ཡང་འཁང་ར་བྱེད་མྱོང་མེད།",
    "ང་ཆབ་གཞོང་སྟེང་དུ་བསྡད་ཀྱང་བློ་སྒོ་འབྱེད་ཐུབ་འདུག་ངས་རྒྱུན་པར་རི་རྩེར་འཛེགས་པ་དང་རི་སྐོར་སོགས་བྱེད་ཀྱིན་ཡོད།",
    "འགྲན་རྩོད་བྱེད་པའི་དམིགས་ཡུལ་ཡང་ཁྲོམ་ར་དང་རང་ཉིད་སྔར་ལས་བདེ་ཐང་ཡོང་ཆེད་དང་།",
    "དུས་ཚོད་གཉིས་ཙམ་གྱི་ལམ་ཐག་འདུག་ལམ་བར་ནས་བདེ་བཤེར་མང་པོ་ཞིག་དང་འཕྲད་བྱུང་།",
    "ད་དུང་མེ་མདའ་ཕྲག་པར་ཁུར་ཞིང་མདེལ་ཤུབས་རྐེད་པར་དཀྲིས་པའི་དམག་མི་དང་ཉེར་རྟོག་པ་མང་པོ་འདུགངའི་སེམས་སུ་འདི་གླེང་སྟེགས་སུ་ཞུགས་པ་ཡིན་ནམ་སྙམ།",
    "ཅི་ཞིག་ལ་འཛམ་གླིང་རང་བཞིན་ཅན་དང་གང་ལ་ཁེ་ལས་སྤྱི་དམངས་ཟེར་བ་ཡིན།",
    "ད་ལྟ་ངས་དྲིན་ལན་ལྡོན་པའི་སྐབས་སུ་ཐོན་འདུག་སྙམ།",
    "དངུལ་བསྒྲུབ་ཐུབ་མི་འདུག་ཡ་མ་ཤོན་དང་དགོས་དགུ་སོགས་ལེགས་པོ་འདུག་ཟེར་སྐབས།",
