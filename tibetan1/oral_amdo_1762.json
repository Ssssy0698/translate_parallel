    "འབྱར་ལ་མ་རེག་པ་ཞེས་སུ་འདོད།",
    "དེ་ལ་བརྟེན་ནས་མིག་ཤེས་སོགས་སྐེ་བས་རྗེས་སུ་འགྲོ་ལྡོག་གི་ངེས་པས་གྲུབ་བོ་ཞེས་འདོད།",
    "རང་སྐྱེ་སོགས་མཐའ་བཞི་པོ་གང་གི་ཚུལ་དུ་སྐྱེ་དཔྱད་ན་དོན་དམ་པར་རྐྱེན་ལས་སྐྱེ་ཁ་མ་གྲུབ་ཅིང་།",
    "ཡུལ་ལྐོག་ན་མོ་མེད་པར་ཡང་སྣང་རིགས་པའི་ཕྱིར་ཕྱི་དོན་བདེན་པར་མི་འགྲུབ་བོ།",
    "གཞན་ཡང་རྡུལ་ཕྲ་རབ་ལ་བར་མེད་ན་གཅིག་ཏུ་འབྱར་བར་ཐལ་ལ།",
    "མ་རེག་པའམ་མ་འབྱར་ན་ནི་བར་དང་བཅས་པར་ཐལ་བ་ལས་ཕུང་གསུམ་པ་མི་སྲིད་ལ།",
    "མི་རྟག་པ་ཤེས་བྱ་ལ་མི་གནས་པས་ན་རྟག་པར་སྨྲ་བ་གསང་བ་པའི་གྲུབ་མཐར་ཐལ་བའི་ཕྱིར་དང་།",
    "གང་ཟག་གི་བདག་དང་།",
    "མ་རིག་པ་དང་སྲེད་པ་དང་ལེན་པ་གསུམ་ཉོན་མོངས།",
    "དེ་ལྟར་ཉོན་མོངས་ལས་ལས་དང་།",
    "གཅིག་པུར་དབེན་པར་དགའ་བའང་མཆོག་གི་སྤྱོད་པ་མ་ཡིན་ཏེ།",
    "ཐལ་འགྱུར་པ་ཞེས་སུ་གྲགས་པ་ལས།",
    "ཐུན་མོང་སྤྱིའི་འདོད་པ་ནི་གཟུང་འཛིན་གྱི་ཆར་མེད་པའི་ཤེས་པ་རང་རིག་རང་གསལ་དོན་དམ་དུ་འདོད་ལ།",
    "འཁོར་རེག་སོགས་ཀུན་འགྲོ་ལྔ།",
    "རིགས་འདྲ་ཕྱི་མ་གྲུབ་པའི་བག་ཆགས་ཀུན་གཞི་ལ་བསྒོས་ཏེ་བུམ་པའི་གྲིབ་མ་ལྟར་ཀུན་གཞིའི་སྐད་ཅིག་རེ་རེ་ལ་སྐྱེའོ།",
    "དེ་བཞིན་ཉིད་ལ་ཚོགས་བདུན་མ་སྐྱེས་པའི་གནས་སྐབས་ལ་འདུ་ཤེས་དང་ཚོར་བ་འགོག་པ་ཞེས་གསུམ་བསྣན་པས་འགོག་པ་དྲུག་སྟེ།",
    "མེད་བཞིན་སྣང་བ་གཟུགས་དང་དོན་སྤྱི་དང་མིང་གིས་གདགས་པ་ཐམས་ཅད་དེའི་རང་བཞིན་ནོ།",
    "དེ་ལ་གཟུགས་དང་སེམས་བྱུང་རེག་པ་སོགས་ཉི་ཤུ་རྩ་གསུམ་དང་དེ་བཞིན་ཉིད་ནི་རྫས་ཡོད་དོ།",
    "གང་ཟག་གི་བདག་དང་།",
    "ནང་གི་ཤེས་པའང་བདེན་པར་མ་གྲུབ་པས་ན་ཐ་སྙད་དུ་སྣང་ངོས་ན་ཡོད་མཉམ་དང་།",
    "དྲི་མ་ཟད་པའི་གཉེན་པོ་མཆོག་གསུམ་ལ་བརྟེན་པ་ཕྲ་མོ་ཡང་ཆུད་མི་ཟ་བས་ན་རིགས་ཆད་པའང་མེད་དོ།",
    "དོན་དུ་སྣང་བ་འདི་དག་ནང་གི་ཤེས་པ་ཉིད་དུ་བདེན་པར་འདོད་པ་རྣམ་བདེན་པ་དང་།",
    "རི་ལ་སོགས་པའི་དོན་སྣང་ཤེས་པ་ཡིན་མོད་ཀྱི།",
    "རྣམ་པ་ལ་ཇི་ཙམ་དབྱེ་ནུས་པ་ལྟར་འཛིན་པའི་ཤེས་པ་ལའང་ནུས་པས་ན་སོར་མོ་ལྔ་ཤེས་པའི་རྫས་ལྔར་བདེན་གྱི་གཅིག་ཏུ་མི་བདེན་ཙ་",
    "སྔོ་སེར་སོགས་སྣང་བ་སྣ་ཚོགས་པ་ཤེས་པ་གཅིག་ལ་སྣང་ཡང་ཤེས་པ་གཅིག་གི་རང་བཞིན་དུ་བདེན་པའོ་ཞེས་འདོད་དོ།",
    "དེ་གསལ་རིག་གི་ཤེས་པ་ཡིན་པ་ནི་བསྒྲུབ་བྱ་ཡིན་པམར་མི་འགྲུབ་ཅིང་།",
    "གཞན་ཡང་སྒོ་ང་ཕྱེད་ཚལ་བལྟར་ན་ཕྱི་དོན་རྫུན་ན་དེ་དང་གཅིག་པའི་ཤེས་པའང་རྫུན་པར་ཐལ་ལ།",
    "བདེན་ན་སྣང་བ་ལྟར་དོན་དུའང་གྲུབ་པར་ཐལ་ཞིང་།",
    "རི་སོགས་ཀྱིས་ཚུར་རིག་པར་ཐལ་བ་དང་།",
    "སྣང་བ་སྣ་ཚོགས་ཀྱི་གྲངས་བཞིན་དུས་གཅིག་ལ་ཤེས་པ་ཤིན་ཏུ་མང་པོ་རྒྱུད་གཅིག་ལ་སྲིད་པར་ཐལ་བས་གནོད་དེ།",
    "ཁྲ་བོ་མཐོང་བ་ལྟ་བུ་སོགས་སྣ་ཚོགས་དུས་གཅིག་མཐོང་བའི་རགས་སྣང་རྒྱུན་ཆད་པ་༢ཏེ་ཤེས་པ་རེ་རེ་བཞིན་ཐ་དད་པ་ཡིན་ཞིང་དེ་བདེན་གྲུབ་ཡིན་པའི་ཕྱིར།",
    "རེ་རེའི་ངོ་བོ་ལ་གཞན་མེད་པས་ན་མི་དུ་མའི་རྒྱུད་ཀྱི་རྟོག་པ་བཞིན།",
    "དུ་མར་སྣང་བཞིན་དུ་གཅིག་གི་ཡིད་བཞིན་མཛོད་གྲུབ་བསྡུས།",
    "ཁ་དོག་ལྔ་ལ་སོགས་པ་དུ་མའི་ཐ་སྙད་རྒྱུན་ཆད་པར་ཐལ་ཏེ།",
    "དེས་ན་ཁྲ་བོ་མཐོང་བའི་མིག་ཤེས་ལ་ཤེས་པ་གཅིག་གི་ཐ་སྙད་ཙམ་རུང་ནའང་།",
    "གཞན་དུ་སྣང་ཡང་གཞན་དུ་བདེན་ན་མེ་འབར་བའང་ཆུར་བདེན་པ་སོགས་ཐམས་ཅད་ཐམས་ཅད་དུ་ཐལ་བས་ཧ་ཅང་ཐལ་ཆེས་སོ།",
    "དེ་ལ་དེ་དག་གིས་དོན་སྣང་གང་དུའང་མི་བདེན་པ་འཐད་མོད་ཀྱི།",
    "ཤིང་རེ་རེ་ནས་བསལ་བའི་ནགས་བཞིན་ནོ།",
    "ཁྱད་པར་ཐ་སྙད་ཀྱིས་གཞལ་ནས་སྣང་བའི་རྣམ་གཞག་ཞིབ་མོར་བྱེད་པ་དེ་ལའང་།",
    "ཀུན་རྫོབ་མི་རྟག་པ་ལྟར་དོན་དམ་མི་རྟག་པར་ཐལ་བ་དང་།",
    "དོན་དམ་སྐྱེ་འགག་མེད་པ་ལྟར་ཀུན་རྫོབ་ཀྱང་སྐྱེ་འགག་མེད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "སུ་ལའང་སྣང་བ་མེད་ན་དེའི་རྣམ་པ་གཏན་མེད་པའི་ཕྱིར་ཀུན་རྫོབ་ཏུའང་མེད་པར་ཐལ་ཏེ་རི་བོང་གི་རྭ་བཞིན་ནོ།",
    "སྣང་སྟོང་ཕྱོགས་རེ་བའི་མཐའ་ལས་འདས་པའི་ཕྱིར་རོ།",
    "ཕྱོགས་དུས་ཀྱི་ཤེས་པ་གང་གི་ཡུལ་ཡིན་ཀྱང་དེའི་རྣམ་པ་སྣང་བ་དང་བཅས་པའི་ཕྱིར་རོ།",
    "དོན་དམ་སྒྱུ་མ་དང་སྟོང་པ་ཁོ་ནར་རིགས་པས་དཔྱད་བཟོད་པ་མེད་པས་གནས་ལུགས་མཐར་ཐུག་གི་དོན་ལ་སྤྲོས་པ་ཀུན་ལས་འདས་པ་ཡིན་ནའང་།",
    "གནས་སྐབས་སུ་ཀུན་རྫོབ་ཐ་སྙད་ཀྱི་དངོས་པོ་རང་རང་གི་མཚན་ཉིད་འཛིན་ཅིང་མི་བསླུ་བར་གནས་པ་འདི་ལ།",
    "ཡང་དག་པའི་དོན་དུ་ཡང་ལོག་གི་ཀུན་རྫོབ་མཉམ་སྟེ།",
    "གཞན་ཡང་སྣང་ཚོད་པ་འདི་ལ་དཔྱད་ནས་མ་གྲུབ་པའི་དོན་དམ་ཀྱང་མེད་དེ།",
    "ཕ་རོལ་ཁས་ལེན་དང་བཅས་པ་ལ་རང་གི་ཁས་བླང་གི་ཐལ་བ་འཕེན་པ་ལས་དངོས་ཞེན་གྱི་དམ་བཅའ་ཐམས་ཅད་འཇིག་པར་མཛད་པ་སྟེ།",
    "དངོས་དངོས་མེད་གང་དུའང་མ་གྲུབ་པར་ཐལ་ཏེ།",
    "ངོ་བོ་མེད་པར་ཐལ།",
    "བདག་ལས་སྐྱེ་ན་སྐྱེ་བ་དོན་མེད་དང་ཐུག་མེད་དུ་ཐལ་བ་དང་།",
    "གཞན་ལས་སྐྱེ་ན་ཐམས་ཅད་ལས་ཐམས་ཅད་སྐྱེ་བར་ཐལ་བ་དང་།",
    "འབྲས་བུའི་ཆེད་དུ་རྩོམ་པ་རྒྱུན་ཆད་པར་ཐལ་བས་ན།",
    "དངོས་པོར་མ་གྲུབ་པར་ཐལ།",
    "དངོས་པོར་མ་གྲུབ་པར་ཐལ།",
    "དེ་ཡང་དངོས་པོ་གནས་སྐབས་འགྱུར་ན་རྒན་པོ་ལས་ཀྱང་གཞོན་ནུར་འགྱུར་བར་ཐལ་ཞིང་འགྱུར་བ་ཉིད་ཀྱང་རྟག་མི་རྟག་གང་ལ་ཡོད་ཚུལ་དང་།",
    "མི་འགྱུར་ན་གཞོན་ནུ་ལས་རྒན་པོར་འགྱུར་བ་མི་སྲིད་པར་ཐལ་ལོ།",
    "དོན་དམ་པ་བློ་བྲལ་སོ་སོ་རང་རིག་གི་ཡུལ་གཉིས་ཀའང་ངོ་བོ་རང་བཞིན་མ་གྲུབ་པ་ཙམ་ཡིན་ལ།",
    "དེ་ཡང་མཉམ་བཞག་གི་ཉམས་ལེན་སྐབས་སུ་བཞག་ཐབས་ནི།",
    "དེ་ལ་སྐབས་འདིར་ཐལ་འགྱུར་བ་ལ་ཁས་ལེན་གཏན་མེད་པ་དང་།",
    "དང་པོ་བྱ་བའི་རྒྱུད་དུ་ཕྱིའི་ཁྲུས་དང་གཙང་སྦྲ་ལ་སོགས་པ་ལུས་ངག་གི་བྱ་བ་ལ་འབད་པ་ཆེ་ཐང་ཀུན་ཏུ་སྤྱོད་པ་གཙོ་བོར་བྱེད་ཅིང་།",
    "བདག་དམ་ཚིག་པ་ཁོལ་པོ་ལྟ་བུ་དངོས་གྲུབ་ནོད་པ་པོར་ལྟ་བས་གནས་སྐབས་དང་མཐར་ཐུག་གི་དངོས་གྲུབ་ཐོབ་པར་འདོད་པའོ།",
    "ཀུན་རྫོབ་ཏུ་སྐྱོན་ཀུན་ཟད་ཡོན་ཏན་ཀུན་རྫོགས་ཀྱི་བདག་ཉིད་དབྱིངས་འོད་གསལ་བའི་རང་བཞིན་མངོན་དུ་གྱུར་པའི་ཡེ་ཤེས་ཀྱི་སྐུ་ཅན་ལྷག་པའི་ལྷ་དེ་ཉིད་རང་ལ་གནས་སྐབས་དང་མཐར་ཐུག་གི་དངོས་གྲུབ་སྩོལ་བ་པོ་ཡིན་པས་རྗེ་བོ་ལྟ་བུ་དང་།",
    "བཞི་པ་དེ་ལྟར་བརྩོན་པས་གནས་སྐབས་སུ་འདོད་གཟུགས་ཀྱི་ལྷ་དང་སྐལ་བ་མཉམ་པའི་རིག་འཛིན་གྱི་ལུས་ལ་སོགས་པ་ཐུན་མོང་གི་གྲུབ་པ་ཅི་རིགས་དང་།",
    "མཐར་ཐུག་གི་འབྲས་བུ་རིགས་གསུམ་ལྷ་ཡི་ངོ་བོར་མི་ཚེ་བཅུ་དྲུག་ན་འགྲུབ་པའོ།",
    "གཉིས་པ་སྤྱོད་པའི་རྒྱུད་དུ་ནི་ཕྱིའི་ཁྲུས་སོགས་གཙང་སྦྲ་བྱེད་པ་དག་དང་ནང་གི་ཏིང་ངེ་འཛིན་གཙོ་ཆེ་ཆུང་མེད་པར་བྱས་ཏེ་བདག་དང་ལྷ་སྤུན་གྲོགས་ཀྱི་ཚུལ་དུ་ལྟ་བས་དངོས་གྲུབ་ཐོབ་པར་འདོད་པ་ཡིན་ནོ་ དེ་ལའང་ལྟ་སྒོམ་སྤྱོད་འབྲས་བཞི་ལས།",
    "བདེན་གཉིས་ཟབ་མོའི་ཚུལ་ལ་ཡིད་ཆེས་ཀྱི་ལྟ་བ་དང་ལྡན་པའོ།",
    "སྐྱབས་སེམས་སོགས་སྔོན་དུ་སོང་ནས་སྟོང་པའི་ངང་ལས།",
    "རྣམ་པ་དམ་ཚིག་གི་ཕྱག་རྒྱ།",
    "གསུམ་པ་སྤྱོད་པ་ནི་གཙང་སྦྲ་ལ་སོགས་པ་ཡང་དུས་སྐབས་དང་འཚམས་པར་ཅི་རིགས་པར་དང་དུ་ལེན་ན་ཡང་གཙོ་བོར་ནང་གི་རྣལ་འབྱོར་གྱི་ཉམས་དང་བསྟུན་ཏེ་གོང་མ་ལས་བག་ཡངས་སུ་སྤྱོད་པའོ།",
    "དེ་ལྟར་སྔགས་ཕྱི་རྒྱུད་གསུམ་པོ་དེ་དག་ཀུན་ཀྱང་བདེན་གཉིས་རེས་འཇོག་ཏུ་འཛིན་པར་བྱེད་དེ།",
    "ཟབ་མོ་རྫོགས་པའི་རིམ་པ་གཉིས་ཡེ་ནས་འདུ་འབྲལ་མེད་པར་ཟུང་དུ་འཇུག་པའི་དོན་བདེན་པ་དབྱེར་མེད་རང་བྱུང་གི་ཡེ་ཤེས་ཆེན་པོ་ཉིད་དུ་བསྒོམས་པས་ཚེ་འདིར་ཕྱག་རྒྱ་ཆེན་པོ་མཆོག་གི་དངོས་གྲུབ་ཟུང་འཇུག་རྡོ་རྗེ་འཆང་གི་གོ་འཕང་ཐོབ་པར་བཞེད་པ་ཡིན་ནོ།",
    "དེ་ལ་བྱེ་བྲག་ཏུ་དབྱེ་ན་ཉོན་མོངས་དུག་གསུམ་གྱི་གཉེན་པོ་དང་།",
    "དཀྱིལ་འཁོར་གང་དུ་ལྷ་ཕོ་མོ་ཤས་ཆེ་ཆུང་།",
    "གཙོ་བོ་དང་གཙོ་མོ་གོ་འཕོ་ལུགས།",
    "ཡང་གསར་མ་ལྟར་ན་ཡང་གསང་སྔགས་ནང་གི་རྒྱུད་ལ་གསུམ་དུ་ཕྱེ་སྟེ།",
    "དེ་ཡང་ཐབས་ཤེས་རབ་གཉིས་ཀའི་ཕྱོགས་སུ་མ་ལྷུང་པས་རྡོ་རྗེ་སེམས་དཔའ་མ་ནིང་གི་གོ་འཕང་ཞེས།",
    "དེའི་རང་བཞིན་མཐའ་ཀུན་དང་བྲལ་བའི་སྟོང་པ་ཉིད་ཀུན་ཏུ་བཟང་མོ་ཡེ་ཇི་བཞིན་པའི་དཀྱིལ་འཁོར་ཏེ།",
    "དེ་ལའང་རྩོལ་མེད་རང་བྱུང་གི་ཡེ་ཤེས་ལམ་དུ་བྱེད་པར་འདྲ་ཡང་།",
    "རྣམ་མེད་ཀ་དག་གི་ཉམས་ལེན་ཅོག་བཞག་བཞི་ལ་སོགས་པ་དང་།",
    "དོན་ལ་ཀ་དག་དང་ལྷུན་གྲུབ་ཟུང་དུ་ཞུགས་པའི་རང་བྱུང་གི་ཡེ་ཤེས་ཉིད།",
    "བསྟན་པ་མེད་མོད་དང་པོའི་ལས་ཅན་རྣམས།",
    "གཞུང་གི་དགོངས་དོན་ཚུལ་བཞིན་བལྟ་བར་བྱོས།",
    "རང་བཟོ་མེད་པར་ཉུང་ངུའི་ངག་གིས་གསལ་པོར་བཀོད་པ་པོ་ནི་མི་ཕམ་རྣམ་རྒྱལ་ལོ།",
    "བཀོད་པ་ཡིད་བཞིན་མཆོག་གི་རྒྱུད་དང་།",
    "དེའི་སྟེང་གི་བག་ཆགས་ཕྲ་བའང་འཕོ་མེད་ཀྱི་སྐུ་མཐར་ཐུག་མ་གྲུབ་བར་དུ་མི་ལྡོག་པས་གཟུགས་མེད་ལའང་ཏིང་འཛིན་གྱི་ལུས་ཡོད་ཅིང་།",
    "སྟོང་གསུམ་དར་ཡུག་གི་དཔེའི་སྐབས་སུ།",
    "གཟུགས་མེད་པའི་གཞལ་ཡས་ཁང་གི་ཚད་དུ་ནི་གཟུགས་མེད་པའི་གཞལ་ཡས་ཁང་བྲིས་ཞེས་སོགས་གསུངས་པའི་དོན་རྣམས་ཀྱང་བདེ་བླག་ཏུ་འཆད་ནུས་སོ།",
    "མཐའ་བསྐོར་གྱི་ཕྱོགས་གཅིག་གི་ཞེང་མཉམ་པས་ན།",
    "རོལ་མཚོ་དང་པོ་ལ་ནི་རང་གི་ཁ་ཞེང་དཔག་ཚད་བརྒྱད་ཁྲི་ཡོད་པ་སུམ་འགྱུར་བྱས་པ་གཉིས་འབུམ་བཞི་ཁྲི་ཕྱོགས་རེ་རེའི་མཐའ་ཚད་དུ་ཡོད་པ་མ་གཏོགས།",
    "གཞན་ལ་རང་གི་ཁ་ཞེང་གིས་ནི་མི་འགྲིག་ལ།",
    "གྲུ་བཞི་སྤྱིའི་མཐའ་ཚད་ཀྱི་སུམ་ཆ་བཟུང་ན་འགྲིག་མོད།",
    "རྒྱ་མཚོ་རང་རང་གི་ནང་གི་རི་བདུན་པོ་ཙ་",
    "སྟེང་འོག་གི་བར་ཐད་དཔག་ཚད་ཉིས་སྟོང་ཉིས་སྟོང་གིས་ཆོད་པར་གསུངས་ཏེ།",
    "གང་གི་ཕྱིར་འདི་ནི་རྣམ་པར་བཞག་ལ་གཞན་ཁོ་ན་སྟེ།",
    "སྒྲ་མི་སྙན་སོགས་ཀྱི་ལུས་ཚད་རང་ཁྲུ་ཞེས་པ་འདི་ཁོ་རང་གི་ཁྲུ་ཞེས་པའི་དོན་མིན་ཏེ།",
    "འཕེལ་འགྲིབ་ཀྱི་བསྐལ་པ་འཇོག་ཚུལ་མཛོད་སོགས་དང་ཅུང་མི་འདྲ་སྟེ་མཛོད་ལྟར་ན་ཆགས་པའི་ཚེ་བསྐལ་པ་དཔག་མེད་ནས་མར་འགྲིབ་སྟེ་བརྒྱད་ཁྲི་ལ་ཐུག་གི་བར་ཆགས་པའི་བསྐལ་པར་གཏོགས་ལ།",
    "དེ་ལྟར་ན་ཡ་ཐོག་མ་ཐོག་རྐྱང་པ་རེ་རེ་དང་།",
    "བར་ཁུག་པ་རེ་ཡུན་མཉམ་པས་དོན་དུ་བར་བསྐལ་ཉི་ཤུ་གནས་པའི་བསྐལ་པ་ཡིན་ལ།",
    "མ་ཐོག་གི་བརྒྱད་ཁྲི་ཡན་ཆད་འཇིག་པའི་བསྐལ་པར་གཏོགས་སོ།",
    "དེ་ཡང་དཔག་མེད་ནས་བརྒྱད་ཁྲིའི་བར་དུ་ལོ་ཉིས་བརྒྱ་ན་ལོ་རེ་འགྲིབ་པ་དང་།",
    "བརྒྱད་ཁྲི་ནས་བཅུ་པའི་བར་ལོ་བརྒྱ་རེའི་མཚམས་ནས་ལོ་རེ་ཕྲི་བའི་ཚུལ་གྱིས་མར་འགྲིབ་པ་རྐྱང་པ་ནི་ཡ་ཐོག་རིང་མོ་འགྲིབ་པའི་བསྐལ་པ་ཞེས་བྱ་ལ།",
    "དེ་ནས་ཡར་བརྒྱད་ཁྲིའི་བར་དང་མར་བཅུ་པའི་བར་ལ་འཕེལ་འགྲིབ་ཟུང་རེ་གཅིག་ཏུ་བརྩིས་པའི་ལན་བཅོ་བརྒྱད་ནི་བར་ཁུག་བཅོ་བརྒྱད་ཅེས་བྱ་སྟེ།",
    "དཔག་མེད་ནས་མར་བཅུ་པ་བར་དུ་ཡ་ཐོག་ལྟར་འགྲིབ་པའི་ཁུག་དེ་ལ་མ་ཐོག་རིང་མོ་ཞེས་ཙ་",
    "ཡ་ཐོག་མ་ཐོག་གི་ཡུན་བསྡོམས་པ་དང་།",
    "ཕྱིན་ཅི་ལོག་གི་ལྷག་མདགུའི་སྐབས་སུ།",
    "གྱི་མིང་སྟེ་རྒྱལ་པོའམ་ཁྱིམ་བདག་སོགས་ཀྱི་ཁྱིམ་ན་དེ་དག་གི་དྲིན་ལ་བརྟེན་ནས་གནས་པ་ལའང་ཞོ་ཤས་འཚོ་བ་ཞེས་ཡོངས་སུ་བཟུང་བའི་དངོས་པོར་བགྲང་ངོ།",
    "སྣག་གི་གཉེན་མཚམས་ནི་མ་ཡི་ཕྱོགས་ནས་ཉེ་བ།",
    "བཞད་གད་ནི་རྩེད་མོ་སོགས་ཀྱིས་དགོད་པར་བྱེད་པ།",
    "ཉེས་པ་རྩོམ་པའི་སྨྲ་བ་དང་སླར་སྨྲ་བ་ཙམ་འཐབ་མོ།",
    "ཁྱོད་གསོད་དོ་བརྡུང་ངོ་ཞེས་སོགས་ལུས་ངག་གིས་སྡིགས་པ།",
    "གནོད་པའི་བསམ་པས་ཐལ་མོ་དང་དབྱུག་པ་སོགས་ཀྱིས་བརྡེག་པ།",
    "མི་བདེན་པའི་ཚིག་གིས་རྫུན་དུ་སྨྲ་བ་རྣམས་སོ།",
    "སྐྱེས་ནས་རྩེད་མོ་མི་ནུས་པའི་སྐབས་བྱིས་པ།",
    "རྩེད་མོ་ནུས་པ་གཞོན་ནུ།",
    "འདོད་པ་སྤྱོད་ནུས་པ་ལང་ཚོ།",
    "འཚོ་བ་དྲུག་གི།",
    "ཞིང་ལས་ཕྱུགས་འཚོ་སྐྱོང་ཚོང་གསུམ་གོ་བར་ཟད།",
    "ཉེར་ལེན་ཕུང་ལྔ་ལ་བདག་དང་བདག་གིར་བཟུང་སྟེ་སེམས་ཁེངས་པ་ངའོ་སྙམ་པའི་ང་རྒྱལ།",
    "རང་རྒྱུད་ཀྱི་ལང་ཚོ་ཐོས་སོགས་ལ་ཡིད་མགུ་ནས་འཐིག་པའམ་སེམས་གཏུག་པའོ།",
    "ཐ་སྙད་ཀྱི་གཞི་མང་པོ་རྣམས་ནི་སྤྱིར་ཚོགས་དྲུག་གི་ཡུལ་ལ་དགག་སྒྲུབ་ཀྱི་ཐ་སྙད་སྣ་ཚོགས་རྣམ་པར་བཞག་པ་སྟེ།",
    "ཤེས་བརྗོད་འཇུག་གསུམ་གྱི་ཐ་སྙད་རྣམས་གང་ལ་འཇུག་པའི་གཞི་དེར་ངེས་པའི་ཚིག་གི་གཞི་དང་།",
    "སྔར་བསྲེག་པའི་ཐལ་བ་ཆུ་དང་འདྲེས་པར་གནས་སོ།",
    "ཡང་ཆགས་ནས་མེས་འཇིག་བདུན་གྱི་རྗེས་ཆུ་འཇིག་གཅིག་སོགས་དེ་འདྲའི་ཚུལ་དུ་ཆུ་བདུན་ཐལ་བ་ན།",
    "དེ་ལྟར་ཆུ་བདུན་ཐལ་ནས་ཀྱང་།",
    "རྒན་པོ་དག་གིས་སྔོན་ཡང་བྱུང་ཞེས་སྒྲོག་ཅེས་པ་ནི་མཛོད་སོགས་ལྟར་ན་གོང་མའི་ལྷ་རེ་རེའི་ཚེ་ལ་འཇིག་པ་དུ་མ་བྱུང་བ་ཉམས་སུ་མྱོང་བའི་དོན་དུ་འཆད།",
    "འདིར་འཇིག་རྟེན་ཆགས་འཇིག་གི་རྒྱུས་ཤེས་པ་དག་གིས་གཏམ་སྨྲ་བ་ཙམ་ལས་རང་གིས་སྔར་མཐོང་བར་མི་འཆད་དོ།",
    "འོ་ན་འདི་རང་གི་དགེ་རྒྱས་པའི་ཚེ་ཚད་བར་བསྐལ་དྲུག་ཅུ་རྩ་བཞི་དེ་རྫོགས་མི་ནུས་ཏེ།",
    "འོད་གསལ་དང་དགེ་རྒྱས་པའི་ཚེ་ཚད་ལས་བར་བསྐལ་གཉིས་རེ་ཆད་ཀྱང་དེ་དང་ཉེ་བའི་སྒོ་ནས་བཞག་པས་མི་འགལ་ཞེས་འདོག་པ་བཞིན་ཡིན་ལ།",
    "འདིའི་བར་ཁུག་དང་ཡ་ཐོག་མ་ཐོག་ཡུན་མི་མཉམ་པས་གནས་རིས་རྣམས་ཀྱི་ཚེ་ཚད་དེ་བར་ཁུག་གིས་བཞག་ན་ནི་ཤིན་ཏུ་རྫོགས་ཀྱང་ཞིབ་པར་གཞུང་འདིར་གསལ་ཁ་མེད་པས་ད་རུང་བརྟག་པར་བྱའོ།",
    "ལྔ་པ་ནི་བཞི་ཚན་སོ་བདུན་པའི་ལྟ་བ་བཞིས་མཚོན་པའི་གོང་འོག་ཏུ་བསྟན་པ་ཕལ་མོ་ཆེ་འདིར་འདུས་ཤིང་།",
    "གོང་འོག་གི་དོན་ཕལ་ཆེ་བའང་འདིར་འདུས་སོ།",
    "ལོག་པར་འཁྱོགས་པའི་སྐྱོན་དྲུག་ནི།",
    "ངལ་དུབ་འགྲོ་ལས་ནི་སྡིག་སྦྲུལ་གྱི་རེག་པ་སོགས་ལྔ་དང་།",
    "མདུང་ཐུང་གིས་མི་བཟློག་པར་ཐོས་པ་བསགས་སོགས་དྲུག་དངོས་སུ་ཡོད།",
    "འདིར་མན་ངག་གིས་དྲུག་ཏུ་བསྡུས་ནས་བསྟན་པའོ།",
    "ཉོན་མོངས་པའི་གཉེན་པོའི་རྣམ་པ་གསུམ་ཡོད་པ་འདིར་མེད་ཅིང་།",
    "དེ་ལ་སེམས་བསྐྱེད་དང་བཅས་ཏེ་ཉན་པར་མོས་པ་ནི་འདུན་པའི་རྣམ་པ།",
    "ཕྱི་ནང་གི་རྣམ་གཡེངས་སྤངས་ནས་ཉན་པ་མི་གཡེང་བའི་རྣམ་པ།",
    "བློ་ནི་སྒོམ་བྱུང་གི་ཤེས་རབ་ཡིན་ལ་དེ་ལ་གོམས་ཤིང་འཇུག་པས་ན་བློ་ལ་འཇུག་པའི་རྣམ་པ།",
    "ཡུལ་ལ་མི་གཡེང་ཞིང་རྣམ་རྟོག་གི་གཡེན་སྤྱོ་བ་མེད་པས་སེམས་བདེ་ལ་སེམས་བདེ་ན་ལུས་ཀྱང་བདེ་བས་ན་ལུས་བདེ་བའི་རྣམ་པ།",
    "དེས་ངག་གི་ཉེས་པ་སྤང་ཞིང་ལེགས་པར་སྨྲ་བ་དང་འཇམ་པོར་སྨྲ་བས་ངག་ཞི་བའང་འབྱུང་ངོ།",
    "དེ་ལྟར་བསྡུ་དངོས་ལ་སོགས་པ་དེ་དག་ཐོས་པ་ལས་འབྱུང་ཞིང་ཁོང་དུ་ཆུད་པར་བྱེད་པས་ན་དེ་དག་གི་རྣམ་པ་ཞེས་འབྲས་མིང་རྒྱུ་ལ་བཏགས་པའི་ཚུལ་དུ་གསུངས་པ་ཡིན་ལ།",
    "བྱ་བ་མ་ཡིན་པ་ལ་མི་འཇུག་པ་བདག་གི་སེམས་སྲུང་བའི་རྣམ་པ།",
    "དེ་དག་གིས་ཀྱང་ཐོས་པ་འདི་ཉེས་ཀུན་སྤོང་ཞིང་ཡོན་ཏན་མཆོག་ཐོབ་པའི་རྒྱུ་ཡིན་པའི་ཕྱིར་བསྔགས་པར་བྱེད་པས་ན་མཁས་པས་བསྔགས་པའི་རྣམ་པ།",
    "དེ་གཉིས་གཅིག་ཏུ་བརྩི་ན་རྒྱུ་འབྲས་ལ་ཡིད་ཆེས་པས་ལེགས་བྱས་ལ་མི་འགྱོད་ཅིང་སླར་ཡང་འཇུག་པར་མོས་པའོ།",
    "བློན་པོ་དྲུག་གི་སྐབས་ནས་གྲུབ་པའི་གནས་དྲུག་པོ་གསུམ་དུ་བསྡུ་བ་ན།",
    "རིག་ཤེས་ཞེས་པའང་རིག་པ་ཤེས་པ་སྟེ་ཡོན་ཏན་མཁན་གྱི་མིང་གི་རྣམ་གྲངས་སོ་  བདག་དང་འཇིག་རྟེན་རྟག་ཆད་དུ་རྟོག་པ་བཞི་དང་།",
    "དང་པོ་ལྟར་ན་ཚོར་བ་གསུམ་ལ་གཙོ་བོ་གཅིག་གིས་ཁྱབ་པ་མེད་དེ་གཙོ་བོ་ཉིད་མེད་པའི་ཕྱིར་ཞེས་པ་དང་།",
    "སྔ་མ་ཁོ་རང་གིས་ཁས་བླངས་དང་།",
    "བློ་སོགས་བདག་གི་ཡོན་ཏན་ཅན།",
    "བློ་སོགས་བདག་གི་ཡོན་ཏན་བཅད་ཞེས་དང་།",
    "རང་གིས་རང་མི་བྱེད་དེ།",
    "ཆ་མེད་ལ་ཕྲད་པ་མེད་དེ་ཕྱོགས་ཐམས་ཅད་དང་གཅིག་གིས་ཕྲད་པ་གང་ལྟར་ཀྱང་མི་འཐད་པའི་ཕྱིར་དང་།",
    "དང་པོ་ལྟར་མཚམས་སྟོང་པར་གྲི་ཡོད་པར་ཐལ་ལ་དེ་ལྟ་ན་གྲིའི་སོས་མ་རེག་པར་གཅོད་པར་ཐལ་ཞིང་།",
    "ཤ་དང་གྲི་ཕན་ཚུན་བསྣོལ་ནས་གཅིག་གི་གོ་སར་གཅིག་ཞུགས་པའི་ཚེ།",
    "ཕན་ཚུན་བསྣོལ་བས་ན་ཤས་གྲི་གཅོད་པར་ཐལ་ལ།",
    "ཤ་ནང་དུ་གྲི་བཅུག་པ་གོང་བུ་གཅིག་གི་དངོས་པོ་བཞིན་དུ་རོ་གཅིག་ཏུ་གྱུར་ནས་སོ་སོར་ཡོད་པར་མི་འགྱུར་ལ།",
    "ཁ་ཅིག་གི་སྒྲིབ་བྱེད་བསལ་དུས་དེར་གནས་ཀུན་ཀྱང་ཐོས་པར་ཐལ་ཏེ་ཁྱད་མེད་དོ།",
    "དེ་ནི་ཐོགས་རེག་གི་སྒྲིབ་པ་མེད་པ་ཙམ་ལ་གསུངས་ཏེ།",
    "ཐོགས་རེག་མེད་ཙམ་ལ་འཇིག་རྟེན་ན་ནམ་མཁའ་ཞེས་གདགས་པ་དེ་དང་སྒོ་བསྟུན་གྱི་ཁྱོད་ལྟར་དངོས་པོར་འདོད་པ་མིན་ནོ།",
    "ལུས་ཡན་ལག་ཐ་དད་ན་སྣང་རུང་མ་དམིགས་པས་གནོད་པ་སྟེ་རིགས་པ་དང་འགལ་བ་གསུམ་མོ།",
    "ཡང་ན་ཁྱད་པར་ཞེས་ཁྱབ་བྱ་དུ་མ་ཉིད་པས་ཁྱད་པར་ཡང་མཐར་མི་གྲུབ་ཚུལ་དཔྱད་པ་གང་ཡིན་ཀྱང་འགལ་བ་མེད་མོད་བརྟག་པར་བྱའོ།",
    "འདིར་དུས་དང་སྐད་ཅིག་གི་བརྟག་པས་ལྷ་མ་གྲུབ་པས་ལྷ་ལ་ནུས་པ་མེད་པར་ཁེགས་ན་རང་གི་ལྷ་ལའང་མཚུངས་སོ་ཞེ་ན་མི་མཚུངས་ཏེ།",
    "རང་གི་ལྷ་བདེན་གྲུབ་ཏུ་མི་འདོད་ལ།",
    "ཇི་ལྟར་སྣང་བཞིན་པའི་ཤེས་བྱ་ལས་ལྐོག་གྱུར་གྱི་ཟབ་མོའི་དོན་མི་འཐད་དེ་ཞེས་སོགས་དོན།",
    "མུ་སྟེགས་རྣམས་ན་རེ།",
    "རང་གི་ཟབ་མོ་ཚུར་མཐོང་ལས་འདས་པར་འདོད་པ་ནི་དེ་དང་མི་འདྲ་སྟེ་ཚུར་མཐོང་ལ་བརྟེན་ནས་ཚུར་མཐོང་ལས་འདས་པར་རིམ་གྱིས་ངེས་པར་བྱར་ཡོད་ཀྱི།",
    "ཚུར་མཐོང་གིས་ཡུལ་ལ་ཚུར་མཐོང་དང་འགལ་བའི་དོན་སྨྲ་བ་ཡིན་ནོ།",
    "གཅིག་གིས་སྒྲ་ཐམས་ཅད་བརྗོད་མི་ནུས་པར་གསལ་ལོ་ཞེས་པའི།",
    "འབྲུ་རེ་རེ་བཞིན་སྔགས་ཡིན་ན་རིག་བྱེད་ཀྱི་གཞུང་གི་སྔགས་ཁྱད་པར་བ་བདེན་པར་འདོད་པ་དོན་མེད་པ་སོགས་སུ་ཐལ་ལོ་ཞེས་སོ།",
    "གང་གིས་མིག་ཟུར་གྱིས་བལྟས་པའང་།",
    "ཁྲུས་ཀྱིས་དག་པ་དགག་པའི་སྐབས་མུ་སྟེགས་པ་ཁོ་རང་གི་ལུང་རྒྱལ་བྱེད་དྲང་བ་ལས།",
    "སྣམ་བུར་ཡང་ཡོད་པར་ཐལ་ཏེ་སྣམ་བུ་དང་བུམ་པའི་རྣམ་པའི་ཁྱད་པར་གཉིས་ཀའི་རྒྱུ་སོ་སོར་མེད་པར་ངོ་བོས་བྱུང་བས་སོ།",
    "ཡང་ན་རྟོག་པ་མེད་པར་ཐལ་ཏེ།",
    "འདི་ལ་སོགས་པའི་སྐབས་འགའ་ཞིག་དུ་ཡི་གེ་ཅུང་ཟད་ཉམས་པ་ཡིན་ནམ་སྙམ་སྟེ་བརྗོད་སྒྲོས་མི་གསལ་བ་ལྟ་བུ་རེ་འདུག་ཀྱང་དོན་ལ་འགལ་བ་མེད་ཅིང་།",
    "བྱ་བ་འཆར་བ་འབྲས་བུ་ཡིན་དགོས་ན་དེ་ཆ་གཉིས་སུ་ཐལ་བ་དང་།",
    "མ་ཁྱབ་པར་རྟོག་པ་མེད་པ་བདེན་མོད་ཀྱི་ཞེས་པའི་དོན།",
    "ཤིང་སྡོང་གི་རྩེ་མོ་ལྟ་བུ་ལ་རིས་མ་ཁྱབ་བཞིན་དུ་སྐྱེ་བ་ཡོད་པས་ན།",
    "བདག་གིས་ཁྱབ་བཞིན་ཏུ་སྐྱེད་པའི་དཔེར་མི་རུང་ངོ།",
    "དེ་ཡང་ཟོལ་སྦྱོར་གྱི་སྒོ་ནས་གྲུབ་པར་རེ་བས་འདི་སྐད་དུ།",
    "བུམ་པ་གང་རུང་གི་གཉིས་དང་བཅས་པ་ཡིན་ཏེ།",
    "དཔེ་བུམ་པ་རྩིག་རྩར་བཞག་པ་ན་རྩིག་པ་དེ་ལ་གང་རུང་གི་གཉིས་བཅས་ཀྱི་ཁྱབ་པ་གྲུབ་སྟེ་རྩིག་པ་དེ་ཨུཏྤལ་མིན་པའི་དངོས་པོ་ཡིན་ལ།",
    "ལུས་སེམས་རྫ་ས་གཅིག་པའི་སྐྱེས་བུའི་གཉིས་བཅས་ལས་འོས་མེད་པས་དེ་སྒྱུ་ཐབས་ཀྱིས་འགྲུབ་པར་རེ་བའོ།",
    "གལ་ཏེ་ལུས་བུམ་མ་ཕྱེ་བར་དེ་གཉིས་ཐུན་མོང་གི་སྤྱི་ཙམ་ལ་བཟུང་ན་རུང་སྙམ་ན་མི་རུང་སྟེ་ལུས་བུམ་གཉིས་མིན་པའི་གང་རུང་ཞེས་པ་དོན་གཞན་ཅི་ཡང་མེད་པས་སོ།",
    "ལུས་བུམ་གང་རུང་གི་སྤྱི་ཞེས་པ་དོན་གཞན་ཞིག་ཡོད་པར་གྱུར་ན།",
    "ཉན་ཐོས་པའི་ཐུན་མོང་གི་འདོད་པ་བདུན་གྱི་རྩོམ་བྱེད་རྡུལ་ཕྲན་དོན་དམ་དུ་འདོད་པ་བཀག་པའི་སྐབས་སུ་ཕྲད་མ་ཕྲད་བརྟག་པ་སོགས་རིགས་པ་ལྔ་གསུངས་པའི་གསུམ་པ་གྲིབ་མ་དང་ཉི་ལོགས་ཀྱིས་བརྟག་པ་ནི།",
    "ཆ་གཉིས་མེད་པར་ཆ་ཐམས་ཅད་ལ་ཉི་མ་ཕོག་ན་གྲིབ་མ་གཏན་ནས་མེད་པས་ཤར་ངོས་མའི་གྲིབ་མ་ནུབ་ངོས་མ་ལ་འཕོག་པ་མེད་ཅིང་དེའི་ཚུལ་གྱིས་རྡུལ་ཐམས་ཅད་ལ་གྲིབ་མ་མེད་པར་སྣང་བ་བསྒྲིབ་པ་མི་སྲིད་པས་རི་རབ་ཀྱི་ཤར་དུ་ཉི་མ་ཤར་བ་ནུབ་ཏུ་མི་བསྒྲིབ་པར་ཐལ་ཏེ་ཤེལ་གོང་བཞིན་དུ་འགྱུར་རོ།",
    "ཡང་ཆ་ཐམས་ཅད་གྲིབ་མ་ཡིན་ན་ཉིན་པར་ཡང་མུན་ནག་ཏུ་ཐལ་ཏེ།",
    "དེས་ན་གོང་བུ་ལྟ་བུ་ལ་ཉི་འོད་འཕོག་ཚེ་རྡུལ་ཕྲ་རབ་ལ་ཕོག་དགོས་པས་དེ་ལ་ཉི་འོད་ཕོག་མ་ཕོག་གི་ཆ་ལ་དཔྱད་པ་དེ་ལྟར་བྱའོ།",
    "ཉི་འོད་ཕོག་མ་ཕོག་གི་ལོགས་ཐ་དད་དུ་ཡོད་ན་ཆ་མེད་ཡིན་པ་ཉམས་སོ།",
    "འཕང་བ་མྱུར་དུ་འགྲོ་བ་གཉིས་ཀས་ཀྱང་ཅུང་ཟད་ཀྱང་མི་སྡོད་པར་ས་གཞིའི་ཁྱོན་རིམ་བཞིན་འདའ་དགོས་ལ།",
    "མདའ་དང་ཉི་ཟེར་མགྱོགས་བུལ་མཉམ་པར་ཐལ་ལ་མི་མཉམ་པར་ཉི་ཟེར་གྱིས་ས་ནས་གང་ཙམ་གཅོད་པའི་ཡུན་ལ་མདའ་ཡི་ས་ནས་སྟོང་ཕྲག་མང་པོའི་ས་ཁྱོན་གཅོད་ནུས་ན་ནི་ཉི་ཟེར་ནུར་བས་འདའ་བྱ་ཆ་མེད་གཅིག་གི་ཁྱོན་ལ་མདའ་འགྲོ་བས་ཆ་མེད་སྟོང་གི་ཁྱོན་འདའ་རུ་ཡོད་པར་འགྱུར་ཏེ།",
    "ཇི་ལྟར་མགྱོགས་ཀྱང་ཆ་མེད་རེ་རེ་ནས་འདའ་དགོས་ལ།",
    "ཉི་ཟེར་གྱི་ཆ་གཅིག་གཅོད་ཡུན་ལ་མདས་དེ་འདྲ་སྟོང་ཙམ་ཆོད་ཐུབ་པས་མདའི་དུས་ཆ་སྟོང་ལྟ་བུ་དེ་རིམ་ཅན་དུ་འབྱུང་ཞིང་དུས་ཆ་རེ་རེ་ལ་ས་ཁྱོན་རེ་རེ་ཆོད་རྒྱུ་ཡོད་དགོས་པས་སོ།",
    "སྔ་མའི་ས་ཁྱོན་བཏང་ནས་ཕྱི་མ་ཕྱི་མའི་གཞིར་རིམ་བཞིན་འཇུག་པ་མིན་པར་ཅིག་ཆར་གཅོད་ན་ལམ་གྱི་ཆ་རྣམས་ཐམས་ཅད་ཀྱི་སྟེང་ན་རེས་འཇོག་མེད་པར་ཅིག་ཆར་སྣང་བ་དཔེར་ན་འཇའ་ཚོན་ཡུལ་གྱི་ཆ་གང་ན་སྣང་བ་དེ་ཕྱོགས་གཅིག་ཏུ་ངེས་པ་མེད་པར་ཕ་ཀི་ནས་བལྟས་ན་ཚུར་ཁར་དང་།",
    "ལྔ་པ་རིང་ཐུང་གིས་བརྟགས་པ་ནི་རྡུལ་གཉིས་གཤིབ་པའི་སྲུབ་ནོན་དུ་རྡུལ་གཅིག་བཞག་དུས་འོག་གི་གཉིས་དང་སྟེང་གི་གཅིག་པོ་ལ་ས་ཁྱོན་ཆེ་ཆུང་ངམ་རིང་ཐུང་ཡོད་དམ་མེད།",
    "ཡོད་ན་སྟེང་འོག་གི་རྡུལ་གསུམ་ཀ་ཆ་བཅས་སུ་འགྱུར་ཏེ།",
    "ཕྱེད་ནུབ་ངོས་བ་ནོན་པའི་ཆ་ཡིན་པས་གཉིས་སུ་ཐལ་ལོ།",
    "སྐྱེད་ཚུལ་མི་འཐད་དེ་ཤེས་པའི་སྐྱེ་འཇིག་གཉིས་ཤེས་པ་ལས་རྫས་ཐ་དད་དུ་ཐལ་ཏེ།",
    "འདོད་ན་ཤེས་པ་འདུས་བྱས་རྟག་པར་ཐལ་ཏེ།",
    "དེ་དག་གིས་བསྐྱེད་བྱ་ཤེས་པ་ཙམ་གྱི་རང་བཞིན་དུ་གཅིག་པ་འགལ་བས་ཤེས་པ་ལས་ཐ་དད་པར་འགྱུར་ཞིང་།",
    "སྐྱེ་འཇིག་མེད་པའི་རྟག་པར་ཡང་ཐལ་ཕྱིར།",
    "འདུས་བྱས་རྟག་པར་ཐལ་བའི་འགལ་བ་གནས་སོ་ཞེས་པ་ཙམ་དུ་གོ་བ་བསླང་ནའང་རུང་སྟེ་ཡིག་སྐྱོན་ཅུང་བྱུང་བ་འདྲ་སྟེ་དོན་གྱིས་དཔྱད་པར་གྱིས་ཤིག།",
    "ཡུལ་ལྐོག་གྱུར་དགག་པའི་ཐད་ལྐོག་གི་བུམ་པ་མཐོང་མི་སྲིད་ཅེས་པ།",
    "དོན་དམ་པར་དཔྱད་ན་ཡུལ་རྗེན་ཅེར་དུ་མཐོང་མི་སྲིད་པ་བཞིན་ལྐོག་གི་བུམ་པའང་བློ་དང་འབྲེལ་བ་མེད་པས་མཐོང་མི་སྲིད་པས་ན་དེ་མཐོང་བར་སྒྲུབ་བྱེད་མེད་པ་དང་།",
    "ཐལ་འགྱུར་བ་ལ་དོན་དམ་དུ་ཁས་ལེན་མི་ལེན་གྱི་དཔྱད་པར་མེད་པས་ན།",
    "ན་ཐལ་འགྱུར་བས་དོན་དམ་དཔྱོད་བྱེད་ཀྱིས་དཔྱད་ནས་ཁས་བླངས་མི་བླངས་ཀྱི་དཔྱད་ར་སུས་ཀྱང་གཏོང་དོན་མེད་ཅེས་པའོ།",
    "རྡུལ་ཕྲན་མེད་པར་རྟོགས་ཀྱང་སྣང་ཚོད་དམ་ཐ་སྙད་འཇོག་ཚོད་དུ།",
    "ཁྱོད་དང་འཇིག་རྟེན་འདིར་ནི་རྩོད་ཀྱིས་དང་།",
    "འདིར་དབྱེར་བྱེད་ལ་དབྱེར་མེད་དུ་བཅོས་ནས་ཕུག་གི་གོ་བ་གཏིང་མ་ཕྱིན་པའི་ཞུ་བྱེད་པས་བཅོས་ཉེས་འདྲ་སྟེ།",
    "དོན་དམ་རང་བཞིན་མ་གྲུབ་པའི་དགག་ཆ་ཙམ་དུ་དབྱེར་མེད་པ་ཙམ་ཞིག་གིས་འཁོར་འདས་དབྱེར་མེད་ཆེན་པོ་རྟོགས་པ་མིན་ཚུལ་གསུངས་ཤིང་།",
    "འཁོར་འདས་དབྱེར་སྣང་ན་སྣང་བ་ཐ་དད་ལ་ལྟོས་པའི་སྟོང་པའམ་རང་བཞིན་མེད་པའང་དབྱེར་ཡོད་ཁོ་ན་འམ་ཐ་དད་དེ་ཀ་བའི་སྟེང་གི་དངོས་པོ་དང་།",
    "བུམ་པའི་སྟེང་གི་དངོས་པོ་བཞིན་ནོ།",
    "ཞེས་པའི་དོན་ཏེ་གཞན་ཡང་དགོངས་པའི་དོན་ཟབ་པ་དུ་མ་ཡོད་པས་བློ་ལྡན་རྣམས་ཀྱིས་ཞིབ་མོར་ཕྱེ་བར་བྱའོ།",
    "ཞེས་སོགས་ཀྱི་དོན་ཡང་ཐུན་མོང་དུ་གྲགས་པའི་བདེན་པ་དབྱེར་མེད་དོ།",
    "དེ་གཉིས་ཀའི་རང་བཞིན་ནམ་གནས་ལུགས་མཐར་ཐུག་ཀྱང་མིན་ཏེ་སྟོང་པ་ཚིག་རྐྱང་གི་ཕྱོགས་སུ་ལྷུང་བའི་ཕྱིར་རོ།",
    "མཐར་ཐུག་གི་དོན་ལ་ཡེ་ནས་མ་གྲུབ་པའི་ཕྱིར་ན།",
    "མོད་ཀྱང་སོ་སོའི་ཞེ་འདོད་ཀྱིས་ཕྱོགས་སུ་འཐེན་པར་སྣང་སྟེ་ཕན་པར་མི་སྣང་ངོ།",
    "བྲལ་གཞི་མེད་ན་གང་གི་སྟེང་དུ་སངས་པ་དང་རྒྱས་པ་དང་ཞེས་སོགས་ཀྱི་དོན།",
    "སྔ་རབས་པ་འགའ་ཞིག་གི་ལུགས་དེ་ནི།",
    "སྨིན་གླིང་ཕྱག་དཔེ་དང་རོང་པོ་རྫོགས་ཆེན་པའི་དཔེ་སོགས་དབུས་གཙང་ཁམས་གསུམ་གྱི་ཡིད་བཞིན་མཛོད་ཀྱི་དཔེ་ཅི་རིགས་གཟིགས་རྟོག་དཔེ་བསྡུར་མཛད་དེ་འབྲུ་བཅོས་ཞིབ་པར་མཛད།",
    "ས་བཅད་ཀྱི་ཁོང་འགའ་སོགས་ཧོར་ཁོང་དུ་ཆད་པ་རྣམས་དཔེ་གཟིགས་རྒྱུ་དེ་རྣམས་གང་དུ་ཡང་མི་འདུག།",
    "ད་རུང་དཔེ་རྙིང་དག་པ་ཅི་རྙེད་གཟིགས་ནས་ཆད་པ་སོགས་དེར་སྣང་ན་བསབ་ཅིང་།",
    "ཤེས་པས་རང་མི་རིག་པ་བཀག་སྐབས་བློ་འཁྲུལ་བར་ཐལ་བ་ཆད།",
    "འདི་དག་གི་དོན་འཕགས་ཡུལ་ཤིང་རྟ་ཆེན་པོ་རྣམས་ཀྱི་རིགས་པ་དྲི་མེད་ཤ་སྟག་ཡིན་པས་འགལ་བ་མེད་པར་གདིང་ཐོབ་ཀྱང་།",
    "ཚིག་ཀུན་མཁྱེན་ཆེན་པོའི་གསུང་དངོས་མིན་པས་གཞུང་དུ་དཀྱུས་ལ་མ་བཙུད་པར་ཟུར་དུ་ཀ་ཁང་ཞིག་བསྒྲིག་ན་ལེགས་སྙམ་པ་རང་གི་ཡིད་ལ་ཡོད་དེ།",
    "གཞན་ཡང་རང་ཚིག་གསར་བསྣན་རིགས་རེ་ཟུང་ལའང་ཐོག་མཐར་གཡུང་དྲུང་གི་མཚན་མ་བཏབ་ནས་མི་ནོར་བར་བྱས་ཡོད་པ་འདི་བཞིན་ལགས།",
    "གཞུང་གི་ས་བཅད་དང་བཅས་པ་འདི་ཙམ་ལ་བརྟེན་ན་བློ་ལྡན་རྣམས་ཀྱིས་གཞུང་མམཐར་ཆགས་སུ་འཆད་ནུས་པས་ན་ལྷག་བསམ་བཟང་པོས་རརང་ནུས་གང་ཡོད་དུ་འབད་པ་ཡིན་ན་ཡང་།",
    "བརྟེན་ནས་རྙིང་བསྟན་ཉིན་མོར་བྱས་པའི་ཚེ།",
    "གཞན་ཟེར་ཚིག་གི་གཡམ་ལ་རྟག་རྒྱུ་བ།",
    "བདེན་དོན་ཇི་བཞིན་གཟིགས་པའི་དྲང་སྲོང་གི།",
    "མུ་སྟེགས་ཕྱོགས་སུ་བླན་ལ་རང་གི་བློ་ འཁུ་འཕྲིག་ཙམ་ཡང་མེད་པར་ངའི་འདི་ནི།",
    "དེ་ལ་ཀུན་ནས་བརྩོན་པས་གཟིགས་འཚལ་ལོ།",
    "མཐའ་ཡས་འགྲོ་ཀུན་གནས་སྐབས་མཐར་ཐུག་གི།",
    "ན་མོ་གུ་ར་ཝེ།",
    "འོད་གསལ་ཞེས་པའི་མིང་གིས་ནི།",
    "འཁོར་འདས་སྣང་སྟོང་སྐྱོན་ཡོན་སོགས་སུ་སྒྲ་རྟོག་གིས་གང་གཞལ་བ་ཐམས་ཅད་དཔྱད་བཟོད་དུ་མི་འགྲུབ་པའི་ཕྱིར་ཀུན་རྫོབ་པ་ཡིན་ཅིང་དེའི་རྒྱུ་བ་ཐམས་ཅད་ཉེ་བར་ཞི་བའོ།",
    "སྐྱེ་བ་མེད་བར་གནས་པ་དོན་དམ་མོ་ཞེས་པ་ལྟ་བུར་བཏགས་ཤིང་ཞེན་པའི་བདེན་པ་གཉིས་སུའང་བཞག་པ་མེད་པའི་ཕྱིར་དེ་ལས་འདས་ཏེ་ཡོད་མེད་དུ་འཛིན་པ་ལ་སོགས་པའི་སྤྲོས་ཀུན་ཉེ་བར་ཞི་བ་ཡིན་ཏེ།",
    "ཀུན་རྫོབ་དང་དོན་དམ་གྱི་བདེན་པ་དེ་ཡང་དབྱེར་མེད་ཅེས་སུ་སྒྲ་དང་ཚིག་གིས་བརྗོད་པ་ཙམ་མོ།",
    "དཔེ་ཅི་ལྟར་ན་དྷ་དུ་ར་ཟོས་པ་ཡི་གང་ཟག་གི་མིག་ལམ་དུ་གླང་པོ་ལ་སོགས་བར་སྣང་བ་བཞིན་ནོ།",
    "དེ་ཡང་རིག་པ་རང་བྱུང་གི་ཡེ་ཤེས་ཉིད་ལ་ལྡོག་ཆས་དབྱེ་བ་ལྔ་དང་།",
    "དེ་ལྟར་མ་རྟོགས་བཞིན་དུ་ཐ་སྙད་འཁྲུལ་བའི་སྣང་ཚུལ་ཙམ་དུའང་འཁོར་འདས་དབྱེར་མེད་ཅེས་ཁ་འབྱམས་ཚིག་གི་ལྟ་བས་དགེ་སྡིག་སྐྱོན་ཡོན་འདྲ་པར་འཛིན་པ་ནི་མི་རུང་སྟེ།",
    "དགེ་སྡིག་གི་བླང་དོར་ཕྲ་མོ་ཡང་མ་ནོར་བར་ཤེས་པ་གཅེས་སོ།",
    "དབྱིངས་དེ་ཉིད་ཟབ་མོ་སྐུ་དང་རྣམ་རྟོག་ཞི་བའི་ཡེ་ཤེས་དང་གདོད་ནས་འདུ་འབྲལ་མེད་པའི་རྟོགས་པ་ཆེན་པོ་དང་ལྡན་པའི་ཕྱིར་རོ།",
    "མགྲིན་པར་འོ་མའི་རྒྱ་མཚོ་ཁྱོན་ཡངས་པར།",
    "དབྱངས་ཅན་ངང་པའི་བུ་མོ་རྣམ་རོལ་པ།",
    "ཞེན་པས་ཞུགས་ཀྱང་ངེས་པས་དབུལ་མོད་ཀྱི།",
    "ངེས་པའི་ཡིད་ཆེས་ལྷག་པའི་ལྷ་ཡིས་བྱིན། ། རེ་བས་བསྒྲིམས་ཏེ་བརྩམས་པའི་གཞུང་ལུགས་ཕལ།",
    "གྲགས་སྙེམས་རེ་བའི་འཇུར་མདུད་ཞིག་པ་ཡི།",
    "ཚིག་གི་རྗོད་པ་གཙོ་བོར་མ་བྱས་ཕྱིར།",
    "འབད་པས་བརྟགས་ཀྱང་ཉེས་པ་ཕྲ་མོའི་ཁུར།",
    "སྨད་པ་རྣམས་ལ་ཚིག་གིས་གཞར་ཡང་འདེབས།",
    "གང་གི་གསུང་ཀུན་ཕྱལ་ཡངས་ནམ་མཁའི་ཚུལ།",
    "རེ་དོགས་འདོར་ལེན་གོམས་པའི་སྟངས་སྟབས་ཀྱིས།",
    "བྱམས་པའི་ལྟ་སྟངས་གཅིག་གིས་ཁྱབ་མཛད་ནས།",
    "གཅིག་ཆར་གཅོད་བྱེད་ནང་གི་ཤེས་རབ་སྤྱན།",
    "མོས་པའི་བློ་མཆོག་ངང་གིས་རྣམ་པར་འཕེལ།",
    "ཤུགས་ཀྱིས་འཕངས་པའི་བཅོས་མིན་ཚིག་གི་རླབས།",
    "འདས་ནས་རྟོག་མེད་དཔའ་བོ་ཁྱོད་བཞིན་དུ།",
    "མཚོ་བྱུང་བཞད་པའི་གེ་སར་བདག་གིས་ནི།",
    "གང་གི་ཁྱིམ་གྱི་དཔལ་དུ་ཉེར་གནས་པ།",
    "གནས་སྐབས་རེ་བ་ཡིད་བཞིན་འགྲུབ་པ་དང་།",
    "ཚུལ་འདི་མཐོང་ཐོས་དྲན་རེག་སྐྱེ་བོ་ཀུན།",
    "པཱ་གི་ཉི་ཨོ་ནི་། མདྷྱམཱདིཤཱསྟཛཱཏཱིནཱཾདུ་མརྨནིཀཱཡཡོ",
    "ན་མོ་གུ་རུ་མཉྫུ་ཤྲཱི་ཡེ།",
    "གང་གི་ཞབས་སེན་ལྷ་བརྒྱའི་གཙུག་གི་ནོར་བུས་ལན་སྟོང་ཕྱིས་གྱུར་ཅིང་།",
    "ལུས་ཅན་ཀུན་ལ་ཕན་པ་སྦྱིན་ཞེས་འཇིག་རྟེན་འདི་ན་གྲགས་མོད་ཀྱི།",
    "སྣང་བ་མེད་པ་རི་བོང་གི་རྭ་ལ་སོགས་པ་ནི་སྟོང་པ་ཉིད་ཀྱི་དོན་མ་ཡིན་ཏེ།",
    "རི་བོང་གི་རྭ་རྭ་སྟོང་གི་ཐ་སྙད་སྦྱར་ཡང་གཏན་མེད་ཀྱི་དོན་ཡིན་ནོ།",
    "སྟོང་ན་མི་སྣང་བ་རི་བོང་གི་རྭ་སྟོང་པ་ལྟ་བུ་མ་ཡིན་ནོ།",
    "འོན་ཀྱང་ཐ་སྙད་དུ་མེད་པ་ངེས་ཟིན་པའི་རི་རྭ་སོགས་མེད་པའི་དཔེར་ངག་གིས་བརྗོད་པ་ཙམ་ལས།",
    "དེ་མཉམ་བཞག་གི་ཡུལ་ཡིན།",
    "དེའི་ཕྱིར་མ་རིག་པའི་གཉེན་པོ་ཡེ་ཤེས་སྐྱེས་པས་མ་རིག་པ་ལོག་གི།",
