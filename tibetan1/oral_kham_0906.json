    "གུས་འབངས་ཞབས་འབྲིང་རྒན་གྲས་ཁོངས་གཏོགས་དང་བཅས་པས་རང་རང་མ་ཤེས་རྨོངས་སྒྲིབ་ཀྱིས་སྐུ་གསུང་ཐུགས་དང་འགལ་བའི་སྐྱོན་དང་།",
    "དེ་མིན་རང་རང་སོ་སོའི་སྐབས་སུ་གང་བབས་ཀྱི་ཞུ་བྱ་བཀའ་སྲུང་དང་བླངས་ཞུ་རྒྱུའི་དམ་བཅའ་འབུལ་ལམ་ཞུས་པ་ཡིན་ན།",
    "བོད་ནང་དུ་འགུལ་སྤྱོད་བྱེད་པའི་ནུས་པ་ཡོད་གནས་བཅས་བརྗོད་པ་དང་ཆབས་ཅིག་བཙན་བྱོལ་དུ་ཡོད་པ་རྣམས་ལ་ཆབ་སྲིད་ལྟ་བ་མི་འདུག་ཟེར་བ་དང་།",
    "༥ ཐོག་རྒྱ་གར་གྱི་རྒྱལ་ས་ལྡི་ལིར་དགོངས་པ་གཞན་དོན་དུ་གཏད་པའི་ཡིད་སྐྱོའི་རང་བཞིན་དུ་གྱུར་འདུགདམ་པ་གང་ཉིད་ནི།",
    "བོད་གཞུང་ལ་ཆེ་མཐོང་རང་བཞིན་དུ་ཡོད་པའི་འོག་ནས་དཔལ་ལྡན་འབྲུག་པ་དཀར་བརྒྱུད་དང་།",
    "ཁོང་རང་འབྲུག་པ་ཡིན།",
    "ཁོ་རང་ཧ་ཅང་སྐྱོ་པོ་ཞིག་འདུག་ཀྱང་།",
    "ཁྱེད་རང་ལ་དེབ་བཅུ་པ།",
    "འདི་རིགས་ལ་དོ་སྣང་བྱེད་དགོས་ཀྱི་འདུགལྷག་དོན་ཕྱོགས་མཐའི་སྡོད་སྒར་ཁག་ཏུ་ལས་ཀ་བྱེད་མཁན་ཡོངས་ཀྱི་ཆ་ནས་ཧུར་ཐག་བྱེད་ཀྱི་ཡོད་པས་ད་དུང་ཡང་ཧུར་ཐག་བྱ་དགོས།",
    "ད་དུང་ཡང་བརྗོད་བཞིན་པ་དེ་ལ་དགོས་པ་མི་འདུག་འོག་བཀའ་བློན་བྱེ་བྲག་པ་ཞིག་དང་།",
    "དེ་བཞིན་ང་རང་ཡིན་ནའང་དཔེར་ན།",
    "བྱ་དགོས་གཏོང་དགོས་ཟེར་ཁ་སྦར་བ་གང་བརྗོད་ནས་སོ་སོ་ཚུར་ཙམ་དེར་ཁ་ཕྱོགས་ལོག་ཏེ།",
    "ཁ་ཤས་དཀྲོག་གཏམ་ཡིན་འགྲོ།",
    "མིས་སྒྲིག་འཛུགས་བཟོས་པ་དེ་ལ་མིས་བསྐར་བཅོས་གཏོང་རྒྱུར་ང་རང་ལ་ཡིད་ཆེས་གཙང་མ་ཡོད་པ་ལས།",
    "སྒྲིག་འཛུགས་ཡག་པོ་ཡོང་མིན་རང་རང་སོ་སོར་རག་ལུས་པ་ལྟར།",
    "སྤུན་ཟླར་རང་ཉིད་ཀྱིས་མི་ལོ་༢ བརྒལ་བའི་རིང་དུ་གང་ཞིག་བྱས་འདུག་པ་རང་བློ་རང་ལྐོག་ཏུ་མ་གྱུར་སྟབས་རང་སེམས་ནང་དུ་བཀུག་སྟེ་དཔྱད་པར་འོས།",
    "ཞལ་འདེབས་སོགས་གང་ཐུབ་གནང་འདུག་པ་དང་།",
    "སྒོ་ཕྱུགས་བོད་མི་སྤྱི་མཚུངས་ལྟར་སྤྲད་འདུག་འོན་ཀྱང་གཏན་ལོག་བྱེད་མཁན་དེ་དག་ནི།",
    "འཛམ་གླིང་ནང་བོད་མི་ཞེས་མཐོང་ཆེན་ཡོད་ལུགས་སོགས་དེ་ཕྱོགས་གཉེན་འཕྲད་འགྲོ་མི་བསམ་ཡོད་དོ་སྣང་ཅན་མང་ཆེ་བས་དགེ་མཚན་མང་པོ་བརྗོད་ཀྱི་འདུག་པས།",
    "སླེབས་ས་ཚང་མར་ལྟོ་སློང་མཁན་མང་པོ་འདུག་ཅེས་དང་།",
    "ཁྲིད་འདུག་པར།",
    "དེ་ལས་ཁྱེད་རང་བགྲེས་པ་རྣམས་དཀྱིལ་བར་དུ་ཡར་ཤོག་གསུང་ཏེ་ཕེབས།",
    "ང་ཕྲན་བུ་བདེ་པོ་མི་འདུག་གསུང་སྟེ་གསོལ་དཔོན་གཞོན་པར་ཕྱག་འཆང་སྟེ་བཞུགས།",
    "ཕྲན་བུ་བཤལ་བ་གནང་འདུག་དེ་ནས་གཟིམ་མལ་དུ་ཕེབས།",
    "ཆ་གསུམ་ཞིག་གནང་ཡོད་འདུག་ཚེས་༨ ཉིན་པུར་ཁང་ནས་གདུང་རུས་དང་།",
    "སྐབས་དེར་ཞིང་སྐྱོང་ནས་ང་རང་མི་བཞི་བྱས་པའི་སྐུ་ཚབ་ཚོགས་པའི་འགོ་ཁྲིད་ཡིན་ལུགས་དང་།",
    "ཀེམ་སི་སོགས་ཀྱི་གསར་ཤོག་ནང་བཀོད་ཐོན་བྱུང་འདུག་དངོས་ཡོད་གནས་ཚུལ་ལས་ལྡོག་པའི་བྱ་སྤྱོད་དང་།",
    "རྒྱ་འོག་ཏུ་མགོ་འཁོར་ནས་ཚུད་ཚར་དུས་ཅི་བྱ་འདི་བྱེད་མེད་པ་ཞིག་བྱུང་འདུག་དཔེར་ན།",
    "ཕྱི་རྒྱལ་དུ་ཡུལ་གྱར་ཕྱིན་པའི་མཐོ་རིམ་མི་སྣ་ལྟ་སྐོར་ཚོགས་པ་ཞེས་སྨད་ཕྱོགས་ངོ་མར་མི་གྲངས་༡༡ ཙམ་ཕྱིན་ཡོད་ཚོད་འདུགདང་པོའི་ཆར་གཞིས་ལུས་བོད་མི་ཚང་མས་གནས་ཚུལ་ངོ་མ་ཧ་གོ་མ་བྱུང་བ་དང་།",
    "དེ་སྐོར་ལ་གཞུང་མང་ཡོངས་ནས་ངོ་རྒོལ་ཐེར་འདོན་བྱ་རྒྱུའི་ལས་འགུལ་སྤེལ་རྒྱུར་ཐག་གཅོད་གནང་འདུག་པ་ལྟར།",
    "གླིང་ཚང་བདེ་ཆེན་ཕྱིར་ལོག་སྟེ་དེ་དོན་ཞུས་འདུག་ཀྱང་བོད་ནང་མི་འགྲོ་གཏོང་རྒྱུ་དང་།",
    "བྱེད་ཕྱོགས་གཏན་འཁེལ་བྱ་རྒྱུ་ཚོད་མ་ཐིག་པ་ལྟ་བུས་ཟ་ཟིར་ཆེ་ཙམ་བྱུང་སྐབས་བདེ་ཆེན་ནས་ཁོང་རང་རྡ་རམ་ས་ལར་ཕྱིན་པ་ཡིན།",
    "ནང་སྲིད་དྲུང་ཆེ་བཅས་དང་ཁྱེད་རང་མཇལ་འཕྲད་གནང་གལ་ཆེ་བ་དང་།",
    "ནས་བཙོན་ལས་ཐར་ཐབས་ཅི་ནས་ཀྱང་བཀའ་དྲིན་མ་ཆུང་ཞེས་སོགས་བརྗོད་འདུག་པ་དང་།",
    "དོན་དངོས་སུ་བསམ་ན་ཕལ་ཆེར་བཙོན་པ་ཚོར་ཡོང་རྒྱུ་གཅིག་ལས་མེད་པ་མཐོང་ཐུབ་པ་ལྟ་བུ་འདུག་འོན་ཀྱང་བསམ་བློ་མང་པོ་གཏོང་དགོས་བྱུང་སྟེ།",
    "ཡང་འགའ་ཤས་ཀྱིས་རྒྱ་གར་ནང་ལམ་སེང་གཏོང་དགོས་བརྗོད་འདུག་ཅེས་གསུང་བྱུང་བར།",
    "བུ་ལུག་གཉིས་ནས་བལ་གཞུང་ལ་ཞུ་འབོད་ཐབས་ཤེས་གང་ཡོང་བྱས་འདུག་པ་བཅས་དང་།",
    "ད་ཆ་བཙོན་ཤག་བྱས་ན་བསམ་གྱི་འདུག་ཟེར།",
    "འོན་ཀྱང་བྱ་ཐབས་ཟད་ནས་འདུག་འདྲ་པར་འདི་མཚམས་སུ་བཀོད།",
    "ད་ནི་འཆི་བའི་དུས་ལ་བབས་འདུག་བློ་ཕམ་མ་བྱེད།",
    "ཁྱེད་རང་ནས་བོད་མི་རིགས་དང་།",
    "ང་རང་ཤི་ན་ཤུལ་ནས་སེམས་ཁྲལ་བྱེད་མཁན་སུ་ཡང་མེད།",
    "དེ་རྗེས་ཁོ་རང་ཟུར་འདོན་གྱིས་སྒེར་སློབ་འཛུགས་འཆར་སྐོར་དོན་གཅོད་དང་།",
    "དེ་ཉིན་སློབ་ཕྲུག་༩ སྐོར་ཡོད་པའི་ཕ་མ་རྣམས་འཛོམས་འདུག་ཅིང་།",
    "རང་ཡུལ་དང་རང་མི་ཁ་བྲལ་ཏེ་ཕྱི་ཕྱོགས་ཀྱི་ཆ་རྐྱེན་ཁོ་ནར་བསྟེན་ནས་རྒྱུན་རིང་གནས་དགོས་པ་བྱུང་ན།",
    "དང་རང་གཞན་གཉིས་ཕུང་།",
    "ཕྲན་ནས་ཀྱང་རང་དོན་རང་གཅེས་བྱ་རྒྱུའི་ཁས་ལེན་བྱས་པ་ཡིན།",
