    "རྨོངས་པ་དག་གིས་ཇི་ལྟར་ཡོངས་སུ་ཤེས།",
    "གང་གིས་བཅིངས་པ་དེ་ཉིད་གྲོལ་ཞེས་ཟེར།",
    "ཨེ་བཾ་ཡི་གེར་རང་གིས་གོ་བར་བྱེད།",
    "དེ་ཉིད་ཡོངས་སུ་གྱུར་པ་མཆོག་གི་མཆོག།",
    "མཆོག་གི་དམ་པ་གྲོགས་དག་ཤེས་པར་གྱིས།",
    "ཉོན་མོངས་ཡོངས་སུ་དག་པའང་དེ་ཉིད་དོ།",
    "མཆོག་གི་འདབ་མ་སྐྱེད་པ་སྟེ།",
    "གང་གིས་གང་དུ་གང་ལ་དེ་དག་མེད།",
    "གང་ཡང་དག་གིས་མ་གོས་པ།",
    "མི་ཟད་པའི་གཏེར་མཛོད་མན་ངག་གི་གླུ་ཞེས་བྱ་བ།",
    "བླུན་པོ་རྣམས་ཀྱི་བློ་ལ་རང་གིས་དཔྱད་བྱས་ན།",
    "ཉོན་མོངས་གཉེན་པོ་གཉིས་སུ་འབྱེད་པ་ག་ལ་ཡོད།",
    "ཀྱེ་མ་རང་ལ་རང་གིས་དེ་ཉིད་མཚོན་ཏེ་ལྟོས།",
    "ཀྱེ་མ་འདོད་པའི་དངོས་པོ་གང་ལའང་ཁྱོད་ཉིད་ཆགས་མ་བྱེད།",
    "རེ་དང་དོགས་པའི་དུག་གིས་རྣལ་འབྱོར་སེམས་མྱོས་ན།",
    "གདོལ་པ་དམན་པ་ཞིག་གིས་རྒྱལ་པོར་རེ་སྨོན་བཞིན།",
    "ཀྱེ་མ་སྤྲོས་པ་རྣམས་དང་བྲལ་བའི་རང་གི་སེམས་མཐོང་ནས།",
    "ཞི་བ་དང་བཅས་མན་ངག་གིས་ནི་ཤེས་པར་བྱ།",
    "གང་གིས་མི་བསམ་གང་ལ་ཡང་ནི་སེམས་མ་ཡིན།",
    "རང་བཞིན་གནས་པ་རྡོ་རྗེ་རྩེ་མོར་གླུ་བླངས་པ།",
    "རེ་དོགས་མེད་པའི་མཐར་ཐུག་པ་ནི་རྡོ་རྗེའི་སེམས།",
    "གཅིག་གིས་གོ་བར་ནུས་པ་རིན་ཆེན་བརྡ་ཡི་མཆོག།",
    "མ་སྐྱེས་པ་ལ་མཁས་པའི་སྐལ་ལྡན་དེ་དག་གིས།",
    "རྙེད་དང་ལེན་པའི་བྱ་བ་གང་གིས་གོས་པ་མེད།",
    "སྣང་བ་སྣ་ཚོགས་ཕྱག་རྒྱ་འདི་ནི་གཟིགས་མོར་ཆེ།",
    "བར་སྣང་མཛུབ་མོས་མཚོན་པས་བར་སྣང་མཐོང་བ་མེད།",
    "བདག་གིར་མེད་པའི་སེམས་ཀྱིས་དེ་ལ་གཏད་པར་བྱ།",
    "རང་གི་བུ་མོ་མ་དང་སྲིང་མོ་ཚ་མོ་དང་།",
    "གཡུང་མོ་ཚོས་མ་སྨད་འཚོང་གསོ་རས་ཀྱིས་འཚོ་བ།",
    "ཡོན་ཏན་བཟུང་ན་རང་གིས་རིག་པའི་ཡེ་ཤེས་སྦྱིན།",
    "བཙུན་མོའི་ཤུ་ཀྲ་དགུག་པའི་ཕྱག་རྒྱ་ཆེན་མོ་ནི།",
    "རེས་འགའ་ཚོང་དུས་གནས་ན་ཇི་ལྟར་འདུག།",
    "རེས་འགའ་དུར་ཁྲོད་ཞུགས་ནས་སྒྲོན་མ་དག་ལ་སྤྱོད།",
    "གླུ་གར་གླིང་བུ་རྩེད་འཇོ་རོལ་མོའི་ཚོགས་སུ་འཇུག།",
    "གླང་ཆེན་སྟག་གི་པགས་པས་སྟོད་དང་སྨད་དཀྲིས་ཏེ།",
    "ཉོན་མོངས་ཐམས་ཅད་ཐབས་ཀྱིས་མཆོག་ཏུ་སྒྱུར་བྱེད་དང་།",
    "རྟོག་པའི་ཟུག་རྔུ་གང་གིས་སྒྱུར་བར་མི་ནུས་པ།",
    "གང་གིས་བཟུང་བ་མེད་པའི་སྐུ་ནི་རབ་ཏུ་མཛེས།",
    "གྲོལ་བ་ཆེན་པོ་ལས་སྦྱངས་རེ་བ་མེད་པའི་སེམས།",
    "སེངྒེ་གླང་ཆེན་སྨྱོན་དང་སྟག་དང་དྲེད་མོ་དང་།",
    "གང་ཟག་གིས་སྤྱོད་དེ་ནི་རང་གིས་རང་བཅིངས་པའོ།",
    "དེ་ཕྱིར་རེ་དང་དོགས་པའི་གཉེན་པོས་འཆིང་མི་དགོས།",
    "ཕན་ངེས་སྔོན་དུ་སོང་ནས་བརྟུལ་ཞུགས་གང་སྤྱོད་པ།",
    "དངོས་པོར་འཛིན་པའི་དུག་གིས་རང་གི་སེམས་ལ་ཁྱབ།",
    "ཟབ་མོའི་དོན་སྟོན་དོ་ཧའི་དོན་འགྲེལ་འདི།",
    "བདག་གིས་གདམས་པ་འདི་བརྩམ་མི་རིགས་ཏེ།",
    "མཚན་ཉིད་རྟོགས་པས་མདའ་མཁན་མོ་དང་འགྲོགས།",
    "གཞུང་གི་ཚད་ནི་ཚིགས་བཅད་བཞི་བཅུ་ཡིན།",
    "དེ་ལ་རེ་ཞིག་རྒྱལ་པོའི་དོན་དུ་མགུར་དུ་བཞེངས་པའི་ཚིགས་སུ་བཅད་པ་བཞི་བཅུ་པ་འདི་ལ་དོན་རྣམ་པ་གཉིས་ཏེ།",
    "ཉོན་མོངས་པའི་བདུད་དང་།",
    "འཆི་བདག་གི་བདུད་དང་།",
    "མ་སྐྱེ་བ་མེད་པ་ལས་རྐྱེན་སྣང་གི་ཕུང་པོར་གྲུབ་ཀྱང་།",
    "དེ་འཇོམས་པ་ནི་ཉོན་མོངས་ཉིད་དྲན་པས་ཆགས་སྡང་སྐྱེས་པ་ཡིན་ལ།",
    "དྲན་མ་དྲན་གཉིས་ཉོན་མོངས་པའི་རྩ་བ་ཡིན་པས།",
    "ལོངས་སྐུ་ལ་ཉོན་མོངས་པ་ཅི་སྐྱེས་ཀྱང་ལོངས་སྤྱོད་པ་ཡིན་ཏེ།",
    "ཉོན་མོངས་པའི་འདམ་གྱིས་སྐྱེ་མེད་ལ་མ་གོས་པས།",
    "ཟག་བཅས་ཀྱི་བདེ་བ་ལ་རེ་བ་ལ་རེ་བ་བྱས་ནས།",
    "གཞུང་གི་དོན་གསལ་བར་བསྟན་པ་ལ་དཔེ་ཉི་ཤུ་རྩ་གསུམ་སྟེ།",
    "དྲན་པ་མེད་པ་ལ་དྲན་རིག་གིས་གཡོ་མི་ནུས་ཏེ།",
    "དབྱིངས་རྣམ་པར་དག་པ་རྐྱེན་གང་གིས་ཀྱང་མ་བསླད་པ་དེའི་བྱེ་བྲག་གོ།",
    "ནམ་མཁའ་ཉིད་ཀྱང་སྤྲིན་པར་སོང་བ་མ་ཡིན་ཏེ།",
    "དྲན་རིག་ལ་དྲན་རིག་གིས་བརྟགས་པས་དེའི་མཚན་ཉིད་སྟོང་པ་ཙམ་ལ་ལྟ་བ་ཟེར་ཏེ།",
    "མིག་གི་ཡ་ཕུགས་མནན་ནས་ལྟ་བའི་ཕྱིར།",
    "མར་མེའི་དངོས་པོ་གཅིག་ལ་མིག་གི་རྐྱེན་གྱིས་མར་མེ་གཉིས་སུ་མཐོང་བ་བཞིན་དུ།",
    "མ་རྟོགས་པའི་གང་ཟག་གིས་ཟག་བཅས་ཀྱི་ཕུང་པོ་ལྔ་དང་།",
    "ནང་གི་ཁྱིམ་ནི་ཕུང་པོ་ལྔ་སྟེ།",
    "བརྒྱུད་པ་དང་ལྡན་པའི་དྲན་པ་མེད་པས་ཡེ་ཤེས་ཀྱི་མིག་གིས་དྲན་པའི་མུན་ནག་ཉོན་མོངས་པ་ཐམས་ཅད་སེལ་བར་བྱེད་པ་ཡིན་ལ།",
    "དོན་དམ་པའི་བདེན་པ་གཅིག་གིས་འཇོམས་པ་ཆུ་བོ་དང་མུན་པའི་དཔེས་བསྟན་ཏེ།",
    "ཡིད་ལ་མ་བྱས་ཤིང་བློས་མ་རེག་པ་དེ།",
    "དཔེར་ན་བརྫུན་པོ་ཆེ་ཅིག་གིས་བརྫུན་མང་པོ་བྱས་ཀྱང་།",
    "རྒྱུས་ཡོད་པ་ཅིག་གིས་རངས་པ་མི་བདེན་པར་ཚོར་བས།",
    "བརྫུན་པ་དུ་མ་དག་ཀྱང་བདེན་པ་ཅིག་གིས་འཇོམས།",
    "རླངས་པ་སྤྲིན་དུ་སོང་།",
    "འདི་ནི་མྱ་ངན་ལས་འདས་པ་ལ་སོགས་པ་དང་རང་རང་རྣམ་རྟོག་གི་ཁྱད་པར་གྱིས་སོ་སོར་བཟུང་བའོ།",
    "དཔེར་ན་ཆར་པ་དེ་རྒྱ་མཚོ་ལས་བྱུང་ཡང་རྒྱ་མཚོ་དེ་ཉུང་དུ་མ་སོང་བས་རྒྱ་མཚོ་ལ་གནོད་པ་མེད།",
    "ལྷན་ཅིག་སྐྱེས་པ་གཅིག་གི་རང་བཞིན་ཉིད།",
    "ད་ནི་འགལ་བའི་དཔེ་རྐྱེན་ལས་སྐྱེས་པའི་བདེ་བ་ལ་རེ་བ་མེད་པའི་སྐྱེས་བུས་བྲག་གི་སྦྲང་རྩི་འཐུང་བའི་དཔེས་སྟོན་ཏེ།",
    "དམ་ཚིག་ཕྱག་རྒྱའི་བདེ་བ་ལྷ་དང་ལྷ་མོའི་དཀྱིལ་འཁོར་ལ་ཞེན་པས་གཟུགས་ཁམས་སུ་འགྲོ།",
    "དེ་རྣམས་ལ་རེ་བ་བྱེད་ན་ཁམས་གསུམ་ལས་མི་ཐར་ཞིང་གྲོལ་བ་མི་ཐོབ་པར།",
    "རྐྱེན་ལས་སྐྱེས་པའི་བདེ་ལ་རེ་བ་བྱེད།",
    "དེའི་སྟེང་ན་གླང་པོ་ཆེ་གཉིས་འཐབ་འོག་ན་མཚོ་ཆེན་པོ་ཡོད་པ་དེའི་བར་ན་འཇག་མའི་ཕུང་པོ་ཅིག་ལ་སྐྱེས་བུ་སྦྲང་རྩི་འདོད་པ་ཅིག་གིས་ལག་པ་འཇུས་ནས་སྦྲང་རྩི་འཐུང་ཏེ།",
    "རྐྱེན་ལས་སྐྱེས་པའི་བདེ་བ་ལོགས་ན་ཡོད་པ་ལ་རེ་བ་བྱེད་པ་དེ་ནི་སྦྲང་རྩི་བྲག་ལ་ཡོད་པ་ལྟ་བུ།",
    "འོག་གི་མཚོ་ནི་འདོད་པའི་ཁམས་ཏེ།",
    "དེ་ཡང་དཔེར་ན་བྱོལ་སོང་རྣམས་ཁལ་དང་ཁུར་ལ་སྡུག་བསྔལ་དུ་མི་མཐོང་བར།",
    "དེ་བཞིན་དུ་སོ་སོའི་སྐྱེ་བོ་རྣམས་འདོད་ཆགས་དང་ཞེ་སྡང་དང་གཏི་མུག་ལ་སོགས་པ་ཉོན་མོངས་པ་ལ་བདེ་བར་མཐོང་བས་ལོངས་སྤྱོད།",
    "དྲན་མེད་སྐྱེ་མེད་ལ་མཁས་པའི་གང་ཟག་གིས།",
    "སྐམས་པ་བ་ལང་གི་རྐང་རྗེས་ཀྱི་ཆུ་ལྟ་བུས་བསྟན་པ་ནི།",
    "དཔེར་ན་རྒྱ་མཚོ་མ་མཐོང་བའི་གང་ཟག་གིས།",
    "བ་ལང་གི་རྐང་རྗེས་ཀྱི་ཆུ་ལ།",
    "རྒྱ་མཚོ་ལས་རླབས་བྱུང་དེ་སྤྲིན་དུ་སོང་།",
    "དེ་ཡང་སྣོད་ཀྱི་ཁྱད་པར་གྱིས་ཉ་ཕྱིས་ཀྱི་ཁར་སོང་བས་མུ་ཏིག་ཏུ་འགྲོ།",
    "པདྨའི་ཁར་སོང་བས་དངུལ་ཆུར་འགྲོ།",
    "ཉ་ཕྱིས་པདྨའི་མུ་ཏིག་གམ་དངུལ་ཆུ་བཞིན་དུ་སྣོད་དང་ལྡན་པ་དང་མི་ལྡན་པ་བྱེ་བྲག་གིས་འཁོར་འདས་གཉིས་བྱེད་པས།",
    "སྐྱེ་བ་མེད་པའི་དོན་རྟོགས་ན་ཕྱི་ནང་གི་ཡུལ་ཐམས་ཅད་ཀྱི་སྐྱེ་ས་གནས་ས་ཐིམ་ས་དང་གསུམ་རྟོགས་པས།",
    "དྲན་པ་མེད་པ་ཀུན་འབྱུང་གི་བདེན་པའོ།",
    "ངག་གིས་ཀྱང་བརྗོད་དུ་མེད་པའོ།",
    "མ་བཅོས་པའི་སྟོང་པ་ནི་དྲན་མེད་རྟོགས་པ་ཙམ་མོ།",
    "རྨོངས་པ་དག་གིས་ཇི་ལྟར་ཡོངས་སུ་ཤེས།",
    "རང་གི་གཟུགས་བརྙན་མཐོང་ནས་དེ་ལ་འཛིན་དུ་འགྲོ།",
    "དེ་བཞིན་དུ་མ་རྟོགས་པ་རྣམས་དྲན་རིག་གི་མཚན་བཅས་ཀྱི་བདེ་བ་ལ་དོན་དུ་ཞེན་ནས་གནས་པ་ནི།",
    "ཁོ་ཞེ་སྡང་གིས་ཁྲོས་པས་མཆོངས་པ་བཞིན་དུ།",
    "མ་རྟོགས་པས་དྲན་པའི་གཟུགས་བརྙན་ལྷ་དང་ལྷ་མོའི་དལ་ལ་ཆགས་པས།",
    "དེ་རང་གིས་འཆིང་བའི་ཕྱིར།",
    "གདུལ་བྱའི་བསམ་པ་ནི་ཕྱི་ནང་གི་དཀྱིལ་འཁོར་ཐམས་ཅད་ཡིད་ལ་མ་བྱས་པའི་དབྱིངས་ལས་ཤར་ཞིང་དབྱིངས་སུ་ནུབ་ལ།",
    "ཉོན་མོངས་པའི་ཟུག་རྔུ་མེད་ལ།",
    "དེ་དངོས་པོ་ཐེར་ཟུག་ཏུ་བཟུང་བས་ཉོན་མོངས་པ་ཇེ་ཆེ་ཇེ་ཆེ་ལ།",
    "འདམ་གང་གིས་ཀྱང་མ་གོས་པའི་ཕྱིར།",
    "རྟག་མི་རྟག་གི་ཐ་སྙད་མེད་དེ།",
    "ཡིད་ཉོན་མོངས་པ་ལ་ཐིམ།",
    "ཉོན་མོངས་པ་ཀུན་གཞི་ལ་ཐིམ་ནས།",
    "ཁ་ཅིག་གིས་ཨོཾ་ཨཱ་ཧཱུཾ་གཟིགས་ལ་གཅིག་ལ་གཅིག་ཐིམ་ནས།",
    "ཕྲ་མོ་དང་སྦོམ་པོ་དང་བཅོས་པའི་སྟོང་པ་གང་སྒོམ་ཡང་།",
    "ཐིག་ལེ་དཀར་པོ་བ་ཐག་ཙམ་ཅིག་གིས་འཁོར་ལོ་བཞི་རིམ་གྱིས་གང་ནས།",
    "དཔེར་ན་སྐྱེས་བུ་ཤིན་དུ་གཡེམ་པ་ཅིག་གིས།",
    "གྲོགས་མོ་ནི་མ་རྙེད།",
    "སྒོར་སོང་གྲོགས་པོ་ཀུན་ལ་གཡེམ་པའི་གཏམ་བྱས་པས་བདེ་བ་སྐྱེས་ནས།",
    "དེ་ལ་འདོད་ཆགས་ཀྱི་རེ་བ་བྱེད་པ་བཞིན་དུ།",
    "ཉམས་མྱོང་གི་བདེ་བ་སྐྱེ་བ་ནི།",
    "ཟག་པ་དང་བཅས་པའི་བདེ་བ་ལ་གདུང་བ་བསྐྱེད་ནས་རེ་བ་བྱས་ཏེ།",
    "ད་ནི་འདྲེས་པའི་དཔེ་འགལ་བ་རེ་བ་དང་བཅས་པའི་དཔེ་བྲམ་ཟེའི་སྦྱིན་སྲེག་དང་མི་འགལ་བ་དོན་གྱི་སྦྱིན་སྲེག་བསྟན་ཏེ།",
    "ཕྱིའི་སྦྱིན་སྲེག་ཡིན་ལ་ལྟེ་བར་གཏུམ་མོའི་རང་བཞིན་སྦར་ནས།",
    "རྣམ་པར་རྟོག་པ་སྲེག་པར་འདོད་པ་ནི་ནང་གི་སྦྱིན་སྲེག་གོ།",
    "དེའི་དུས་སུ་རང་གི་ལྕེ་རྐན་ལ་བྲུད་པ་གཡའ་བའམ་ཟ་བའི་བདེ་བ་ཅིག་འབྱུང་སྟེ།",
    "གཏུམ་མོ་དང་ལྷ་དང་ལྷ་མོའི་དལ་ལ་སོགས་པའི་ཉམས་སུ་མྱོང་བའི་བདེ་བ་དེ་ལ།",
    "རང་གིས་དོན་དམ་པར་བྱས་ནས།",
    "རང་གི་ཉམས་མྱོང་དེ་རིག་པ་དང་སྦྱར་ནས།",
    "དེ་ནི་རང་གིས་རང་བཅིངས་པ་ཡིན་ཏེ།",
    "དཔེར་ན་དར་གྱི་སྲིན་བུ་རང་གི་ཁ་ཆུས་བཅིངས་པ་བཞིན་ནོ།",
    "དེའི་ཕྱིར་གང་གིས་བཅིངས་པ་དེ་ཉིད་གྲོལ་ཞེས་ཟེར།",
    "རྩ་དང་གཏུམ་མོ་ལ་སོགས་པའི་བདེ་བ་ལ་ཆགས།",
    "དེ་ནི་འགལ་བ་དཔེའི་ཨེ་ཝཾ་མོ།",
    "སྐྱེ་མེད་ཀྱི་ངོ་བོ་དྲན་མ་དྲན་གཉིས་མི་སྐྱེ་བ་ལས་མི་འདའ་བས་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "བརྒྱུད་པ་དང་མི་ལྡན་པའི་གང་ཟག་གིས།",
    "དེའི་ཕྱིར་ཉམས་མྱོང་གི་ལྷན་ཅིག་སྐྱེས་པ་ནི།",
    "དྲན་རིག་གི་གདུང་བ་བྱས་ཀྱང་ཐོབ་པར་མི་འགྱུར་རོ།",
    "དེ་ནི་ཡོངས་སུ་གྱུར་པ་མཆོག་གི་མཆོག་དེ་ལྟར་སྐུ་གསུམ་པོ་ཡང་རྐྱེན་གྱིས་ཐ་དད་དུ་སྣང་ཡང་ངོ་བོ་ཐ་དད་མེད་དེ།",
    "དཔེར་ན་བུམ་པ་ནང་གི་ནམ་མཁའ་དང་།",
    "ཐ་དད་མེད་པའི་དབྱིངས་དེ་ལས་འདམ་གང་གིས་ཀྱང་མ་གོས་ཏེ།",
    "མཆོག་གི་དམ་པ་གྲོགས་དག་ཤེས་པར་གྱིས།"
  ]
