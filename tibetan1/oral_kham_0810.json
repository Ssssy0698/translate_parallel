    "ཨམ་ཅོག་རྒྱབ་ཀྱི་ལྷགས་པར་བཏང་སྟེ་གོ་མིན་ཏང་རང་ཉིད་ཀྱིས་སྔོན་གཏན་གང་འཁེལ་དེ་རང་ལས་འགལ་ས་མེད་གཤིས།",
    "བཟོ་གྲྭ་ཉུང་ཤས་ལས་མེད་པ་དེ་ཚོའང་དམག་འཁྲུག་སྐབས་གཏོར་སྐྱོན་ཕོག་པ་དེ་མུར་ཉམས་གསོ་མ་ཐུབ་པར་ལུས་འདུག་པ་དཔེར་ན།",
    "དེར་ཕྱི་རྒྱལ་དང་རང་རྒྱལ་གྱིས་གཉེར་བའི་མགྲོན་ཁང་ལེགས་གྲས་མང་པོ་ཡོད་རུང་།",
    "རྒྱ་གར་གཞུང་ནས་གསུང་དོན་ད་ལམ་འདི་སྐོར་ཀྲུང་གོའི་གཞུང་ནས་དེ་ལྟར་གསུང་དོན་མི་འདུག་གང་ཡིན་ཟེར་ན།",
    "བོད་ཀྱི་སྐུ་ཚབ་ལ་གྲལ་གནས་བཞི་སྤྲད་འདུག་ཅིང་།",
    "ཏ་ར་ཡིག་དེའི་མཇུག་ཏུ་པཎ་ཆེན་འོས་སྤྲུལ་གྱི་བྱད་བཞིན་གཟུགས་དབྱིབས་སྐོར་འཁོད་འདུག་ཏར་ཡིག་བལྟས་རྗེས་ཝང་ཧྲུའུ་ཅིས་ང་གཉིས་ལ་སོ་སོའི་བསམ་ཚུལ་ དང་དེ་སྐོར་གང་འགབ་ཅི་ལེགས་བསམ་འཆར་ཤོད་དུ་བཅུག་ཅིང་།",
    "ལན་འདེབས་བྱེད་སྐབས་བག་ཁུམ་འཚེར་སྣང་ཆེ་བ་ཞིག་འདུག་དེའི་མཇུག་ཏུ་རོགས་ཟླ་ལྟ་བུ་མི་གཉིས་ཡོད་པ་ལས་གཅིག་ནི་ལོ་ངོ་ལྔ་བཅུ་ཡས་མས་སོན་པ་དང་།",
    "རྒྱའུ་ཨ་སོབ་ཅན་འགྱུར་བག་ཅུང་ཟད་བརླིང་བ་དེས་གཏམ་ཤོད་པ་དང་ལན་འདེབས་བྱེད་ཀྱི་འདུག་གཞན་གཅིག་ཤོས་ནི་ལོ་ན་བཅུ་བདུན་བཅོ་བརྒྱད་ཙམ་སོན་པའི་བྱིས་རྟགས་དོད་པོ་ཞིག་མཆིས་པ་དེ་ཁ་རོག་བསྡད་དེ་ཅི་ཡང་མི་སྨྲ།",
    "ག་དུས་ཕྱིར་ལོག་རྒྱུ་སོགས་ཚུད་ཡོད།",
    "ཉ་སྨོན་བུ་རྣམ་རྒྱལ་གྲགས་བཟང་རང་ལོ་༡༡ བཅས་མི་གྲངས་༣༡ དང་།",
    "དྲུང་དཀྱུས་བཅས་ལ་སྔར་སྲོལ་གདན་ཐོབ་སྒྲོན་རྒྱག་གནང་འདུག་པ་དང་།",
    "ཡིག་ལྕོག་ཐབ་ཚང་རང་བན་སོགས་བཟོ་རྒྱུའི་རྒྱུ་ཆ་དང་དགོས་དངུལ་ཞུས་ཏེ་གསར་བཟོ་བྱས་པའི་ཐོག་གདན་ལྕོག་དང་ས་གདན་སོགས་རྒྱ་དཔོན་ངོ་ལས་ཀྱི་སྡོད་སྒྲིག་དགོས་མཁོ་གཞུང་ཕྱག་མཛོད་ཡས་མས་བླ་ཕྱག་དང་རྩེ་ཕྱག་ནས་ཐོན་མིན་རིགས་སྔར་ལམ་ལྟར་བླ་བྲང་ཁག་དང་།",
    "བྱམས་འདེགས་པ་རྒྱ་རིགས་མི་གྲངས་བཅུ་སྐོར་ཞིག་མཉམ་ཁྲིད་བྱས་འདུག་ལྷན་དུ་ཚའོ་ཀུ་འུན་དང་།",
    "སྔོན་ཕུལ་གསེར་གྱི་རྟགས་མ་དེ་ཡང་འདོགས་གནང་མཛད་འདུག་གཟིམ་ཆུང་དུ་མགྲོན་སྐྱོང་ཞུ་མཁན་རྭ་སྒྲེང་ཛ་སག་དང་།",
    "འུ་ཀྲུང་ཤིན་བཞུགས་གནས་སྒེར་ཟས་ཞིམ་པའི་ཁྱིམ་འཛིན་ནས་འུ་ཀྲུང་ཤིན་བརྒྱུད་ཞུས་དོན་ལྟར་ཕྱིན་ཆད་ཟས་ཞིམ་གྱི་ཁང་པར་ཚེར་འབེབས་མི་གནང་བའི་ལག་ཁྱེར་བཀའ་ཐོ་འབྱར་མ་ཞིག་ཀྱང་སྩལ་ཐོན་བྱུང་འདུག་དེ་རྗེས་ཁྲི་འབུལ་སོགས་ཀྱི་བྱེད་སྒོ་ཟིན་ཏེ་འུ་ཀྲུང་ཤིན་ཆུ་ཐོག་བརྒྱུད་ཕྱིར་ལོག་གནང་སྐབས་སྔོན་དུ་ཕེབས་བསུའི་སྐབས་ལྟར་ཕེབས་སྐྱེལ་གཟབ་རྒྱས་ཞུས་ནས་མཛད་མཇུག་བསྒྲིལ།",
    "ཁོང་དགུང་ལོ་བརྒྱད་ཙམ་ལ་སླེབས་དུས་ཡབ་གཤེགས་འདུག་ཀྱང་།",
    "འཇོན་ཐང་ཆེན་པོ་ཡོད་མཁན་ཞིག་ཡིན་འདུག་བ།",
    "ཡིན་ནའང་ནང་དོན་གལ་ཆེའི་ཕྱག་བྲིས་ཞབས་ཞུ་སོགས་སྔར་བཞིན་གནང་བ་མ་ཟད་ལས་དོན་སྐོར་གྱི་བཀའ་སམ་ཡང་ཆིབས་གཡོག་གདོང་རྟག་ཏུ་ཕེབས་ཀྱི་འདུག་༡།",
    "ང་རང་ཡང་དགའ་ཐག་ཆོད་ནས་ནང་དུ་ལོག་ཕྱིན་ཏེ་གནས་ཚུལ་རྣམས་པཱ་ལགས་ལ་ཞུས་པ་ཡིན།",
    "ཞེས་སོགས་འཁོད་འདུག།",
    "དེ་རྗེས་ང་རང་སླར་ཡང་ཞབས་སྡོད་ཞུ་ཐུབ་པ་མ་ཟད་བཀའ་ཤག་ནང་བཀའ་མགྲོན་ཡང་བྱེད་ཐུབ་གཤིས།",
    "ང་རང་ཡང་རྒྱལ་ཟུར་རྭ་སྒྲེང་ལ་འཁོན་འཛིན་ཡོད།",
    "གལ་ཏེ་ཁྱེད་རང་ཐར་བ་ཡིན་ནའང་ལྷ་སར་ཁྱེད་ཀྱི་སྐུ་མཆེད་ཛ་སག་སོགས་སྡུག་པོ་མྱང་རྒྱུ་ལས་མེད་ཟེར་བྱུང་།",
    "ཕེབས་གྲ་སྒྲིག་རྒྱུའི་ཐད་ཁྱེད་རང་དང་སྐུ་འཁོར་གཉིས་ཙམ་མཉམ་ཁྲིད་གནང་ན་འགྲིག་ཆིབས་རྟ་གསུམ་དང་ཁལ་རྟ་གཅིག་འཁྲིད་ཕེབས།",
    "དེ་འཕྲལ་ཆིབས་དཔོན་ལ་རྟ་སྒ་རྒྱོབས་ཤོག་ལབ་པ་ལྟར་ངའི་རྟ་སྒ་རྟ་གཡུ་འབྲུག་ལ་བརྒྱབ་འདུག་ངས་གྲ་ཆས་ལེགས་པ་ཆ་ཚང་གྱོན་ཐོག་ཁ་འདོན་ཡོ་ཆས་དང་།",
    "རྟ་ཞོན་ཁར་ངའི་རྟ་སྒ་ཞོན་རྟ་གཡུ་འབྲུག་ཟེར་བ་དེར་བརྒྱབ་འདུག་རུང་།",
    "གསོལ་གཟིམ་ག་ཉིས་མིག་ཆུ་གཏོང་བཞིན་འདུག་ངས་བརྒྱ་ལོར་རས་སྒྲིལ་དེ་ནས་ཕྱེད་ཀ་ཙམ་གསོལ་གཟིམ་གཉིས་ལ་སྤྲད་པ་ཡིན།",
    "གལ་ཏེ་ང་ལ་བཙོན་འཇུག་མནར་གཅོད་མུ་མཐུད་བཏང་ན་ཉ་དང་ཆུ་ཚང་མ་མི་བདེ་བ་ཡོང་རྒྱུ་ལས་མི་འདུག་དེ་ལུགས་དགོངས་འཇགས་ཞུ།",
    "རྭ་སྒྲེང་རྒྱལ་ཟུར་གྱིས་ཡི་གེ་དེ་གསུམ་ཨོ་རྒྱན་རྣམ་གྲོལ་དང་ང་རང་ལ་གསང་བའི་སྒོ་ནས་ཁུངས་སོ་སོར་འཕྲོད་ཐབས་བྱེད་རོགས་གསུངས་བྱུང་།",
    "ཁོང་རང་ཉིད་གཟུགས་གཞི་ཐང་པོ་མེད་པས་ལྷ་སར་ཇོ་བོ་མཇལ་བ་དང་།",
    "ཁྱེད་རང་ཕུ་ལ་རུ་བ་དང་།",
    "ང་རང་ནི་དེའི་བུ་གསུམ་པ་ཡིན་པ་མ་ཟད།",
    "༡༩༦༢ ལོར་ཀྲུང་ཉིན་མཐའ་མཚམས་ཀྱི་རང་སྲུང་རྒོལ་ལན་སློག་སྐབས་ ཀྱང་བོད་དངུལ་འགྲོ་རྒྱུག་བྱེད་མུས་སུ་འདུག།",
    "གནམ་གཤིས་དྲོ་པོ་ཡོད་པས་ལོ་གཅིག་དུས་བཞིར་ལོ་ཏོག་སྐྱེ་ཐུབ་པ་དང་།",
    "བཀྲས་ལྷུན་ནང་སྒང་ཁོངས་ནས་ཀྱང་འུལ་མི་ཁག་གཅིག་དུས་འབྱོར་ཡོང་རྒྱུར་འཁུར་མཉམ་ལེན་དགོས་རྒྱུ་བཅས་བཀོད་མངགས་ཐོག་རྒྱ་ཁྱབ་ལྗོང་གཞིས་ཁག་ལ་འུལ་མི་ཆ་གསེས་བྱས་པའི་མི་གྲངས་ཐོ་གཞུང་དང་།",
    "ལས་གྲའི་གྲ་སྒྲིག་ཀྱང་གང་ལེགས་གནང་ཟིན་འདུག་ལས་མིའི་གཞི་རྩའི་གནས་ཚུལ།",
    "ང་རང་བཅས་ལ་བསྐོ་གཞག་གནང་ཞིང་།",
    "ཁྱེད་རང་ལ་གནམ་གྲུ་འབབ་ཐང་ལས་གྲའི་འགོ་འདོམས་བསྐོ་བཞག་གནང་བ་ལས་དེ་མིན་བཀོད་མངགས་མེད་རུང་།",
    "མི་དམངས་བཅིངས་འགྲོལ་དམག་འཁྲུག་དེ་རྒྱལ་ཡོངས་ལ་རྒྱལ་ཁའི་ཕྱོགས་སུ་ཁྱབ་གདལ་འགྲོ་བའི་སྐབས་ལོ་བརྒྱ་ཕྲག་ནང་རང་རྒྱལ་གྱི་བོད་ལྗོངས་སྟངས་འཛིན་བྱེད་མཁན་བཙན་རྒྱལ་རིང་ལུགས་ཀྱི་སྟོབས་ཤུགས་དང་།",
    "གྲོད་པ་ལྟོགས་པ་དེ་དམག་ཕམ་པ་ལས་དཀའ་ལས་ཆེ་བ་མི་འདུག་གམ་ཞེས་ཟེར་བྱུང་།",
    "ཀོ་བ་དང་སྡོང་རྫིང་ཕར་འགྲོ་ཚུར་འོང་བྱེད་ཀྱི་འདུག་རི་འདེབས་དང་རི་ཤུར་རྣམས་ཤིང་ནགས་སྟུག་པོས་ཁེབས་ཤིང་།",
    "ཁོ་ཚོས་གོ་བ་ལོན་པའི་རྣམ་འགྱུར་དང་བཅས་ཐེ་བོང་ཀེར་ཏེ་བཅིངས་འགྲོལ་དམག་མི་ཡག་པོ་འདུག་ཡག་པོ་འདུག་ཟེར་བ་དང་།",
    "ཁྱེད་ཚོ་ག་དུས་ལོག་ཕེབས་སམ་ཞེས་འདྲི་བརྩད་བྱེད་པར།",
    "མེ་ཤིང་ལའང་རིན་དངུལ་རྩྭཡང་མང་པོ་སྤྲོད་ཀྱི་འདུག་ཟེར་བའི་གནས་ཚུལ་གོ་ཐོས་བྱུང་ཞིང་།",
    "སྐབས་དེར་མི་མང་པོ་ཞིག་བསད་རྨས་ཀྱང་བྱུང་སྐད་འདུག།",
    "ལྟོགས་སྐོམ་དང་ན་ཚ་སོགས་འཇིགས་སྐྲག་ཡིད་མུག་དང་སྐྱོ་ཤས་ཀྱི་ཁེངས་ནས་བསྡད་འདུག་སྐབས་དེར་ཀུན་བཟང་རྩེ་དང་།",
    "ཏཱ་ལ་རུ་ཚོགས་མཉམ་འབྲེལ་གྱིས་ལམ་ཡིག་སྤྲོད་ཀྱི་འདུག་པས་འགན་འཁུར་ཕ་ལྷ་ཐུབ་བསྟན་འོད་ལྡན་དང་།",
    "ཤེས་བྱའི་འདུག་ཚུལ་ཤེས་བྱེད་ཐབས་དང་།",
    "གཞི་དང་རང་བཞིན་རྒྱུ་ཡིན་ཏེ།",
    "གཉེན་པོས་བཅོས་སུ་མེད་པར་གདའ།",
    "རིག་པ་གསལ་བའི་ངང་དུ་གདའ།",
    "ཡང་རང་བཞིན་རྒྱུན་ཆད་མེད་པ།",
    "བཙལ་ཡང་མ་རྙེད་འདུག་ཀྱང་དེ་མ་ཤེས།",
    "དེ་ཡང་རང་བཞིན་གྱི་ཡོན་ཏན་བཞིས་ཁྱད་པར་དུ་བྱས་པ་སྟེ།",
    "ཤེས་བྱའི་འདུག་ཚུལ་ཤེས་བྱེད་ཐབས་དང་།",
    "ཐོག་མར་ཤེས་བྱའི་འདུག་ཚུལ་ལམ་ཡིན་ལུགས་བསྟན་པར་འདོད་ནས།",
    "དེ་ཡང་རང་རིག་པའི་ཡེ་ཤེས་རྟོག་གེའི་ཡུལ་ལས་འདས་པ་ཞེས་གསུངས་ཏེ།",
    "ང་རྒྱལ་གྱི་སྒོ་འཕར་དམ་པོར་བཅད་ནས་ཐར་ཐབས་མེད་པ་ལྟ་བུར་འདུག་གོ།",
    "མདུན་ན་འདུག་པ་ནི།",
    "དབྱར་གྱི་ཟླ་བ་ནམ་གྱི་གུང་ན་འདུག་པའི་དུས་ལྟ་བུའོ།",
    "སེམས་ཀྱང་རང་བཞིན་གྱིས་འོད་གསལ་སྟོང་པ་ཉིད།",
    "དེ་ཡང་ཤེས་བྱ་དངོས་པོ་གཤིས་ཀྱི་གནས་ལུགས་སམ་འདུག་ཚུལ་ལམ་ཡིན་ལུགས་དེ་ལྟར་ཤེས་ནས།",
    "དེ་ཁོ་ན་ཉིད་དུ་ན་སེམས་ཀྱང་རང་བཞིན་གྱིས་འོད་གསལ་ཞིང་སྐྱེ་འགག་མེད་པ་སྤྲོས་བྲལ་ནམ་མཁའི་ངོས་ལྟར་བློ་ལ་ངེས་པར་བྱས་ཏེ།",
    "ཡུལ་དང་དུས་དང་རང་བཞིན་གྱི་ངེས་པར་ཡོང་བའི་ཕྱིར་རོ།",
    "ཡི་གེ་སྐུང་ཚུལ་དམིགས་བསལ་ཅན་དཔེར་ན་༡ཅར་དུ་ཞེས་བྱུང་བ་སོགས་ཀྱང་རང་འཇགས་སུ་བཞག་ཡོད།",
    "ལྕིད་ཀྱིས་ངལ་བ་ཙོག་བུའི་འདུག་སྟངས་ཅན།",
    "སྔགས་ཀྱི་རྒྱལ་བོ་ཨ་ར་པ་ཙ་ན།",
    "ལྗིད་ཀྱིས་ངལ་བ་ཙོག་བུ་པུ་འི་འདུག་སྟངས་ཅན།",
    "ཨ་ར་པ་ཙ་ན་དང་ནག་པོ་ཆེ།",
    "གྱི་ནར་འདུག་པ་བདག་ལ་མི་རིགས་ཞེས།",
    "དགའ་དང་རངས་པས་འཛུམ་ཞིང་མཁས་དེ་ལ།",
    "འཁྲུག་ལོང་མང་དུ་འདུག་པས་ཐུགས་སུན་ནས།",
    "ཙོག་པུའི་འདུག་སྟངས་སྒེག་པའི་ཉམས་ཀྱིས་མཛེས།",
    "འཐུངས་པ་ཙམ་གྱིས་ཆེས་ཆེར་སྐོམ་པར་གདའ།",
    "མངོན་སུམ་ལྟ་བུ་དེ་ན་འདུག་པ་མཐོང་།",
    "བདེན་པར་འཛིན་ལ་བདེན་སྣང་རང་བཞིན་མེད།",
    "བསྐྱེད་རིམ་ཡོངས་སུ་རྫོགས་པར་འོང་བར་འདུག།",
    "བཟང་པོའི་འདུག་སྟངས་མཛད་ཀྱང་མཉམ་པར་བཞག།",
    "དེ་ཡི་མདུན་ན་བདག་ཉིད་འདུག་པ་ལས།",
    "དེ་ཡི་ཁོང་ནས་ཨ་ར་པ་ཙ་ན།",
    "མ་བསྒྲགས་པར་ཡང་རང་ཉིད་ཅ་ཅོར་གྱུར།",
    "ཕ་རོལ་ཕམ་ཞིང་རང་ཉིད་རྒྱལ་བ་དང་།",
    "བཟང་པོའི་འདུག་སྟངས་མཛད་པའི་མ་ཕམ་པ།",
    "དྲི་མེད་གཞུང་ནི་རང་རང་དགོངས་པ་ལྟར།",
    "ཐ་དད་བྱ་བ་མཚན་ཙམ་ཁོ་ནར་གདའ།",
    "དགའ་དང་རངས་དང་དད་པ་འགྲན་པ་བཞིན།",
    "འཇིགས་རུང་མ་བྱུང་འོན་ཀྱང་རང་རྒྱུད་ལ།",
    "རྒྱ་ཆེར་བསྔགས་པའང་རང་བཞིན་བརྗོད་པ་ཉིད།",
    "རང་རང་བསམ་པའི་བྱེ་བྲག་གང་དང་གང་།",
    "ཚིག་ཙམ་འཐུངས་པ་ཚིམ་ཞིང་རངས་གྱུར་ནས།",
    "ཕན་པ་མཐའ་དག་དུས་གཅིག་བགྱིས་པ་བཞིན།",
    "མཁས་པ་དེ་ཡིད་ཚིམ་ཞིང་རངས་པར་དགའ།",
    "མཁས་མང་དབུས་ན་ལྷམ་མེར་འདུག་པ་ཡིན།",
    "བག་དང་ལྡན་པར་ཞི་བའི་གནས་སུ་འདུག།",
    "དེ་འདྲ་འདུག་ཅེས་རྗེ་ཉིད་ཞལ་གྱིས་འཆེས།",
    "འདི་མཐོང་ཁེངས་པ་ཐུང་ངུར་འདུག་པ་ཡི་ཡིན།",
    "མགུ་དང་རངས་པ་ཆེན་པོས་ཁྱབ་པར་གྱུར།",
    "དེ་བས་བདག་ནི་བས་མཐར་འདུག་པར་བྱ།",
    "སྔགས་ཀྱི་ཆེད་དུ་བྱ་བའི་གདུལ་བྱར་འདུག།",
    "གདུགས་དར་ལ་སོགས་རང་རང་ཆོ་ག་བཞིན།",
    "བཀོད་པ་གཉིས་ཀྱི་མཛེས་པར་འདུག་པའམ།",
    "མཚན་ཡང་ཉིན་བཞིན་བསྐོར་བ་བྱེད་པར་གདའ།",
    "གབ་རྩེའི་ནང་དུ་འདུག་པའི་ནོར་བུ་བཞིན།",
    "རྒྱལ་བའི་སྐུ་དང་རང་ཉིད་དབྱེར་མེད་གྱུར།",
    "བཟང་པོའི་འདུག་སྟངས་ཀྱིས་བཞུགས་དེ་ཡི་དྲུང་།",
    "བརྗིད་པའི་སྐུ་ནི་མཛེས་ཤིང་ལྷམ་མེར་གདའ།",
    "རིགས་ཀྱི་ཁྱབ་བདག་ཆེན་པོར་འདུག་པ་ཡིན།",
    "དེ་ལྟ་ན་ཡང་རང་ལ་གཏོགས་པ་ཡི།",
    "དེ་ནས་རང་རང་སྐལ་བ་ཇི་ལྟ་བར།",
    "ཙོག་བུའི་པུ་འདུག་སྟངས་ཡིད་ལ་དྲན་པས་ཀྱང་།",
    "ཇོ་བོ་མཆེད་དང་རང་བྱུང་ལྔ་ལྡན་དང་།",
    "དེ་སླད་དད་པའི་ཆུ་གཏེར་ཁོལ་ཞིང་གདའ།",
    "རྩྭ་དང་ལོ་མ་མེ་ཏོག་དུས་མིན་འབར།",
    "འདུག་ལ་ང་བཞིན་བདེ་བར་སྟོན།",
    "སྒྲོལ་མ་ཁྱེད་རང་སྐུ་གདུང་དང་།",
    "སྐུ་བསིལ་གྱི་འདུག་གམ།",
    "དེའི་སྐབས་སུ་ཧྥེ་ཙིས་སྣང་མེད་ངང་ཁཱ་ལའོ་ལ་ལྟ་ཙམ་བྱས་པས་ཁོས་ཀྱང་རང་ལ་ལྟ་བ་དང་སྟབས་འཁེལ།",
    "ཁ་ལོ་བ་བློ་རྩེ་གཅིག་ཏུ་བསྒྲིམས་ནས་རླངས་འཁོར་གཏོང་བཞིན་ཡོད་པས་གཏམ་དེར་ཉན་འཇོག་བྱེད་མཁན་ཧྥེ་ཙི་ཁོ་རང་གཅིག་པོ་ཡིན།",
    "ཡིན་ནའང་ཁོ་ད་དུང་རིག་པ་དྭངས་དྭངས་སུ་འདུག་པས་ཁཱ་ལའོའི་སེམས་ཁམས་འཐབ་རྩལ་ཞིག་ཀྱང་ཡིན་སྲིད།",
    "ངེས་པར་དུ་འཕྱུགས་པ་མེད་པའི་ཐབས་ཤིག་བཏོན་དགོས་པ་འདུག་སྙམ།",
    "རླངས་འཁོར་གྱི་སྒོ་ཕྱེ་རྗེས་མིག་བཙུམས་ནས་ཁ་ཚུར་བསྐོར་ཏེ་འདུག་སྟེགས་མདུན་གྱི་ཉེན་འགོག་ལྕགས་ཏྲར་ཤུགས་ཀྱིས་བརྡབས་པས་དེ་མུར་དྲན་པ་ཐོར།",
    "དེའི་ཐད་ལ་ཁྱེད་རང་ཐུགས་ཁྲལ་གནང་མི་དགོས།",
    "ཁོས་ཁྱེད་རང་བརྡབས་ནས་དྲན་པ་ཐོར་དུ་བཅུག་རྗེས་ཨམ་ཕྲག་ནས་ལྡེ་མིག་བཏོན་ནས་ལག་ལྕགས་བཀྲོལ་བ་དང་།",
    "ལོ་རབས་ག་དུས་ནས་འགོ་བཙུགས་ཏེ་བྱུང་བ་མི་ཤེས་ནའང་པད་མའི་ལུང་ཤུར་ཉེ་འཁོར་གྱི་མི་སེར་དང་དམག་སྒར་འདིའི་ནང་བསྡད་མྱོང་བའི་འཐབ་འཛིང་པའི་ཁྲོད་དུ་འཇིགས་སུ་རུང་བའི་ཤོད་རྒྱུན་ཞིག་ཡོད་པ་ནི།",
    "དེ་འདྲའི་དངངས་འཚབ་བྱེད་རིན་འདུག་གམ།",
    "འཐབ་འཛིང་པ་ཞིག་དང་འདྲ་པོ་འདུག་གམ།",
    "དེ་དུས་ཆུ་ཚོད་བཞི་པར་སླེབས་འདུག་སྟབས་ནམ་ཡང་ལངས་ལ་ཉེ།",
    "ཉེ་འཁོར་གྱི་མི་རྣམས་ཀྱང་གོམ་པ་སྤོ་མཚམས་བཞག་སྟེ་ཁོང་གཉིས་ཀྱི་རྒྱབ་ཏུ་ལྟ་བཞིན་འདུག་ཁྱི་མགྱོགས་པས་ཁྱི་འདྲོགས་པ་ཟིན་མི་ཐུབ་ཅེས་པའི་ཁ་དཔེ་ལྟར་གཞོན་ནུ་དེས་བྲོས་ཐར་ཆེད་སྲོག་འབེན་བཙུགས་ཀྱིས་མདུན་དུ་རྒྱུགས་ཤིང་ཨ་འཕེལ་མི་གཉིས་ཀྱིས་གསེར་གྱི་ཆུ་ཚོད་ཚུར་འཕྲོག་ཕྱིར་དུ་རྒྱུགས་པས་དཀའ་ནས་རྔུལ་ལེན་ལུས་ལ་འབྱར།",
    "ཨ་འཕེལ་ཉིའུ་ཀ་དང་ཁ་གྱེས་རྗེས་བླ་ཆད་ཧོན་ཐོར་དང་ཉབ་བེ་ཉོབ་བེས་ཁྱིམ་དུ་ལོག་དུས་ཅུང་ཙམ་མིན་ན་རླངས་འཁོར་གྱིས་བརྫི་གྲབས་བྱས།",
    "གལ་སྲིད་ཁྱེད་རང་འཇིག་རྟེན་དུ་བསྡད་ནས་དགའ་དགའ་སྤྲོ་སྤྲོ་དང་།",
    "ཡིན་ནའང་ཞའོ་ཁོན་གྱིས་ཁམ་གང་བཏུངས་རྗེས་སླར་ཡང་ཆུ་བསྲེས་པ་མང་དྲགས་འདུག་ཅེས་ཟེར།",
    "ལེ་མེང་ཏེ་ནི་ཆུང་དུས་ནས་སྐྱིད་པོར་རོལ་མཁན་ཞིག་ཡིན་པས་ཁོས་ངལ་རྩོལ་བྱེད་ཐུབ་ཨེ་ཡོང་སྙམ་པའི་ཐེ་ཚོམ་འདུག་ཟེར།",
    "ངས་ཁྱེད་རང་སྐྱོབ་པའི་ཆེད་དུ་ལོས་ཡིན།",
    "ངས་རྒྱུས་མེད་ཀྱི་ཕའི་གདོང་ལ་ལྟ་བཞིན་རྣམ་འགྱུར་གྲང་ཤུར་ཤུར་གྱིས་ང་ལ་ཁྱེད་རང་དགོས་གལ་ཆེ་བའི་སྐབས་སུ་ཁྱེད་རང་གང་དུ་ཡོད་དམ།",
    "རྒྱང་རིང་དུ་སླེབས་རྗེས་ཕྱིར་ལྟས་ཤིག་སློག་དུས་རྗེས་འདེད་བྱེད་མཁན་མེད་པ་ཤེས་རྗེས་ཁོས་གཞི་ནས་གོམ་པའི་འདེགས་འཇོག་ཇེ་དལ་དུ་བཏང་།་",
    "བསམ་ཡུལ་ལས་འདས་པ་ཞིག་ལ་ཆུང་མས་རང་ཉིད་ལ་ཡིད་རྩ་བ་ནས་མི་ཆེས་པ་མ་ཟད་ད་དུང་རང་ཉིད་ཀྱིས་འཆལ་སྤྱོད་བྱས་པར་གོ་བ་ལོག་སྒྲུབ་བྱས་འདུག་ཁོ་བཟོད་སྒོམ་བྱ་ཐབས་བྲལ་ཏེ་སྐེད་རགས་གཞོགས་ཤིག་ཏུ་གཡུགས་རྗེས་ཡིད་ཆེས་ནའང་འདྲ་མ་ཆེས་ནའང་འདྲ་དེ་རང་ཡིན།",
    "ལོ་གསུམ་གྱི་རིང་ཧན་པའོ་ཡིས་ལས་རོགས་ཚོ་དང་མཉམ་དུ་ཧྲེང་ཀྲེང་མི་དམངས་ལ་དྲོ་སྐྱིད་ལྡན་པའི་ཁྱིམ་གཞིས་ཅི་ཙམ་བསྐྲུན་ཡོད་པ་ཁོ་རང་ཉིད་ཀྱིས་ཀྱང་བརྗོད་མི་ནུས།",
    "མི་མང་པོས་བལྟས་ནས་བསྡད་འདུག་མཚན་ལ་གཞི་ནས།",
    "ཁང་པ་དེ་རྒྱ་ཆུང་ཟཞིང་ནང་དུ་ཉལ་ཁྲི་གཅིག་དང་སྒྲོག་ཙེ་གཅིག་རྐུབ་སྟེགས་ཁ་ཤས་ལས་གཞན་ཅིའང་མི་འདུག་ཧན་པའོ་དང་ཀུའེ་ཧྭ་ཕན་ཚུན་ལྟ་བཞིན་སེམས་ནང་འདི་ཕལ་ཆེར་མངག་གཏོང་ཁང་ཡིན་པ་འདྲ་སྙམ།་",
    "དེ་དང་ཆབས་ཅིག་དུས་ཚོད་དམ་འཛིན་གྱིས་དཔང་རྟགས་བསྡུ་རུབ་བྱས་པ་སྟེ།",
    "གོ་ཐོས་ལ་ཤིན་ཏུ་ཐིག་པོ་འདུག་ཟེར།",
    "མཛེས་མ་དེ་འདྲ་ཞིག་ཐོབ་པར་སེམས་ནང་དུའང་རང་ཉིད་ལ་གྲུབ་འབྲས་ཐོབ་ཅིང་སྙན་གྲགས་ཁྱབ་པའི་ཚོར་བའང་བྱུང་།",
    "པའེ་ལན་གྱི་འཆིང་ཐག་ལས་ཡོངས་སུ་ཐར་བའི་ཆེད་དུ་མུའུ་ཏུང་ལིན་གྱིས་ཀུང་སིའི་དོན་དག་ཡོད་ཚད་ལི་ཐེན་པའོ་ཡིས་འགན་འཁུར་ཏེ་ཐག་གཅོད་བྱེད་དུ་བཅུག་ཅིང་རང་ཉིད་ཉིན་ལྟར་ཁྱིམ་གྱི་ཆུང་མའི་གམ་དུ་བསྡད་ནས་སྐྱོ་བསང་བྱེད་བཞིན་ཡོད།",
    "དེ་ལོས་ཡིན།",
    "མ་ཉེས་ཁག་གཡོགས་སོགས་ཀྱི་རྙོག་དྲའི་རྣམ་འགྱུར་དེ་དག་ཡང་སྐོར་བསྐྱར་སྐོར་གྱིས་ཇི་ཙམ་སྦྱངས་ཡོད་པ་ཁོང་རང་ཉིད་ཀྱིས་ཀྱང་ཤོད་པར་དཀའ།",
    "མིའི་སྲོག་ལ་ལག་ཉེས་ཤོར་གྲབས་འདུག་ཅེས་འབོད་པས་ས་སྟེང་དུ་བསྒྱེལ་ནས་ཡོད་པའི་སྐྱེས་པ་དེས་རང་ཉིད་ཀྱི་ཚབ་ཏུ་སྐད་ཆ་ཤོད་མཁན་དང་།",
    "དཔུང་པ་དང་རྐང་པར་ཡང་རྨས་སྐྱོན་ཕོག་འདུག་ཉེན་རྟོག་པ་འབྱོར་རྗེས་གཞི་ནས་ང་དང་སྤྱི་གཉེར་ཁན་ལགས་མི་ཚོགས་ཀྱི་ཁྲོད་ནས་ཐར་ཐུབ་ཙམ་བྱུང་།",
    "ཁོའི་ལག་ཏུ་ད་དུང་ཤོག་བུ་ཞིག་ཁྱེར་འདུག་ངས་འདི་ནི་ང་འགོ་ཁྲིད་ལ་བསྐོ་བཞག་བྱ་རྒྱུའི་བརྡ་ཐོ་ཡིན་པའི་ཚོད་དཔག་བྱས་པ་ཡིན།",
    "བསམ་ཡུལ་ལས་འདས་པ་ཞིག་པ་སེ་ཉོ་རྩིས་བྱེད་སྐབས་དངུལ་ཁུག་མཐོང་མི་འདུགངས་ཨམ་ཕྲག་གཞན་དག་ཡོད་ཚད་ཨ་ལོག་བརྒྱབ་སྟེ་བསྔོགས་ཀྱང་དངུལ་སྐར་ལི་ཙམ་ཡང་མཐོང་སར་བསྡད་མི་འདུག་ངས་ཤིག་འཚོལ་བ་བཞིན་མགོ་ནས་མཇུག་བར་ཡང་བསྐྱར་ཞིབ་བཤེར་ཐེངས་གཅིག་བྱས་རྗེས་རྐུབ་རྒྱབ་ཀྱི་ཨམ་ཕྲག་ལ་རྐུན་པོས་བྲེགས་ཟིན་པ་ཚོར་བྱུང་།",
    "དེ་ལྟར་ནའང་ངས་ད་དུང་ཨུ་ཚུགས་བྱ་དགོས་པ་འདུག་སྟེ།",
    "དང་ཐོག་ཁྱེད་ཀྱིས་མི་རྒྱུས་མེད་ཅིག་ལ་སྒོར་ཉིས་བརྒྱ་སྟེར་བ་ནས་བཟུང་སེམས་ཀྱི་གཏིང་ནས་ཁྱེད་རང་ལ་དགའ་བ་ཡིན།",
    "ལུས་ལ་ཆིང་རྒྱལ་རབས་ཀྱི་ཆས་གོས་གྱོན་འདུག་པ་མཐོང་།",
    "ཁྱེད་ཚོས་སླར་ཡང་ལིའུ་ཀྲུང་ཞེས་པའི་མིང་དེ་མ་འབོད་ན་འགྲིག་པ་འདུག་གམ།",
    "ཅིན་འོད་དངངས་འཚབ་ཀྱིས་ཧར་ལངས་ཏེ་ཞིབ་པར་ཉན་ཡང་འཇམ་ཐིང་ངེར་འདུག་འོ་ན།",
    "དངོས་གནས་སྤུན་མཆེད་ཡིན་རིན་ཆོག་འདུག་ཅེས་ཟེར།",
    "ལ་རྒྱ་བརྩི་ཆེ་ཤོས་ཡིན་པའི་སྤུན་མཆེད་ཀྱིས་རང་ཉིད་བཙོངས་འདུག་སྙམ།",
    "ཁྱེད་རང་འདིར་ཕེབས་དོན་ཅི་ཡིན།",
    "ད་ཨ་ཞང་རང་གྲོད་ཁོག་ལྟོགས་ནས་འདི་འདྲས་ཆགས་འདུ་ག་འགྲོ།",
    "ཨ་ཞང་བཟའ་བྱ་ཞིག་ཉོས་ཏེ་གྲོད་ཁོག་རྒྱགས་རྗེས་ཁྱིམ་དུ་ལོག་འགྲོ་རྒྱུ་ཡིན།",
    "ཨ་ཞང་འདིར་སླེབས་ནས་འབོལ་སྟེགས་ལ་དྲོད་ཀྱང་ཁུག་ལོང་མེད་པར་ཁྱེད་ཀྱིས་ལས་ཀ་བཀོད་སྒྲིག་བྱེད་རུང་ངམ།",
    "མུ་ཏིག་དང་ཕ་ལམ་སོགས་ཀྱི་ཁང་ཞིག་ཀྱང་ཡོད་འདུག་ས་ཆ་འདིར་ཡོད་པའི་ཚོང་ཁང་དེ་ཆེད་མངག་ཆིན་ཆིན་ལ་ཚོང་གཉེར་བྱེད་དུ་བཅུག་ཡོད་པ་དང་།",
    "ད་ལྟ་ཚོང་གཉེར་གྱི་ལས་ཀ་ཤེས་ཀྱི་མེད་རུང་རང་ཉིད་ཀྱི་སྤྱང་གྲུང་ལ་བལྟས་ན་སེམས་ཁྲལ་བྱ་མི་དགོས།",
    "ཆིན་ཆིན་གྱིས་ལག་ལྕགས་འཁུར་བཞིན་སྔོན་ཆད་ཀྱི་གཟི་རྔམ་དང་དྲེགས་ཉམས་དེ་རྦད་དེ་ཡལ་འདུག་ལ།",
    "ད་དུང་གོ་ཐོས་ལ་ངའི་འདྲ་པར་ཞིག་ཀྱང་འཁྱེར་རྒྱུ་འདུག་ཟེར།",
    "ཉིན་ཤས་འདིའི་རིང་ལ་ང་དང་ཆའོ་ཀྲེང་བཟའ་ཚང་འཁྲབ་སྟངས་ཁོ་ན་སྦྱངས་ནས་ལི་ལི་རྦད་དེ་བརྗེད་འདུག་ངས་མིག་ཟུར་གྱིས་སྦྱིན་བདག་ལ་བལྟས་པས་ཁོང་ཡང་དངངས་འཚབ་ཀྱི་རྐྱེན་པས་གདོང་གཤིས་འགྱུར་འདུག་ལི་ལི་ཡིས་མིག་བཙུམ་ཙམ་བཙུམ་ཙམ་གྱིས་པ་ཕ་ཞེས་སྨྲས་པར་ད་གཟོད་སྦྱིན་བདག་མའི་བཞིན་ལས་འཛུམ་མདངས་ཤིག་མངོན་བྱུང་།",
    "ད་དུང་རང་ཉིད་ལ་རིན་གོང་མཐོ་བའི་རླངས་འཁོར་དང་།",
    "ད་བྱེད་དུས་དེ་སྔོན་ཁང་པ་གསར་པར་སྤོ་དུས་བོར་བརླགས་ཟིན་པ་འདྲ་འདུག་ཅི་བྱ་གཏོལ་མེད་དུ་གྱུར་པའི་སྦྱིན་བདག་ཝང་ལགས་ཀྱིས་མཇུག་མཐར་ཆུང་མའི་བསམ་འཆར་ཉན་ཏེ་འཐབ་རྩལ་སུམ་ཅུ་སོ་དྲུག་ལས།",
    "ལས་ཀ་ཤོར་བའི་བཟོ་པ་ཀྲང་ཆོན་ཅུན་བཟའ་མི་གཉིས་ཀྱི་སྲན་ཞོ་ལས་སྣོན་ཁང་དེའི་ཚོང་ཤིན་ཏུ་བྲིན་པོ་འདུག་འདིའི་ནང་དུ་ད་དུང་མི་སེམས་འགུལ་བའི་སྒྲུང་འདི་འདྲ་ཞིག་ཡོད་པ་ཁྱེད་ཀྱིས་ཤེས་སམ།",
    "ཕྱིས་སུ་འཛད་སྤྱོད་པས་རང་ཉིད་ཀྱི་ལག་རྩལ་ཀྲུའུ་ལའོ་ཧན་དང་ཁྱད་པར་མི་འདུག་ཅེས་བསྔགས་ཤིང་།",
    "དེ་མིན་ན་ཤ་རིགས་ལས་སྣོན་བཟོ་གྲྭས་པིན་ཧོ་ཤར་ལམ་གྱི་སྒོ་བསྟེན་ཚོང་ཁང་གནས་སྤོ་བྱས་ཏེ་དེར་ཚོང་ཁང་ཁང་མིག་གཅིག་སྟོང་པར་ལུས་ཡོད་སྟབས་ཕྱིར་བོགས་མ་གཏོང་རྩིས་བྱེད་ཀྱིན་འདུག་དེ་གར་འདུ་འཛི་ཆེ་བའི་གནས་ཤིག་ཡིན་པས་ཚོང་ཤིན་ཏུ་བྲིན་པོ་ཡོད་པར་བརྟེན།",
    "ཞེས་ཡིག་འབྲུ་ཆེན་པོ་འགའ་བྲིས་འདུག་ཝང་ཞིན་རུའེ་ཡི་མིག་ཟུང་ལས་སྐད་ཅིག་ཉིད་དུ་མིག་ཆུ་བཞུར་ཡོང་ཞིང་།",
    "ཁོས་གྱོན་པའི་ལྷམ་དེ་གད་སྙིགས་ནང་ནས་སྒྲུག་པ་འདྲ་པོ་འདུག་ཅེས་པའི་སྐད་ཆ་དག་ལས་ཁོ་ནི་སྤྱོད་པ་འཚུབ་པོ་ཞིག་ལ་གྱུར་ཡོད་པའང་མཐོང་ཐུབ།",
    "ཡིན་ནའང་ཁྱེད་ཀྱིས་ཁ་དན་ཚིག་ལ་གནས་ཀྱི་མི་འདུག་ཁྱེད་ཀྱིས་ང་ལ་སྤོ་ལོ་རྒྱག་བྱེད་ཀྱི་ལྷམ་ཞིག་ཉོ་རྒྱུ་ཡིན་ཞེས་ཁས་ལེན་བྱེད་མྱོང་ཡོད་པས་ཁྱེད་ཀྱིས་ཉོས་ཡོད་དམ།",
    "འོན་ཀྱང་ཁོའི་སེམས་ལ་ནམ་ཡིན་ཡང་བཏང་སྙོམས་ཡེ་ནས་མི་འདུག་སྙམ་གྱི་ཡོད།",
    "རྣ་གཟན་པའི་སྒྲ་ཞིག་གྲགས་པ་དང་ཆབས་ཅིག་ཏུ་དགུན་གྱི་ལུས་ཡོངས་ཁྲག་དྲོན་དམར་ཆིལ་ལེར་གཞུང་ལམ་གྱི་དཀྱིལ་དུ་སྒྱེལ་འདུག་དགུན་གྱིས་བག་ཕེབས་པོའི་ངང་གཞུང་ལམ་གྱི་དཀྱིལ་དུ་འཕྲེད་ཉལ་བྱེད་ཀྱིན་ཁོའི་ངོ་གདོང་སྟེང་ནས་ད་དུང་རྒྱུན་དུ་མཐོང་བར་དཀའ་བའི་འཛུམ་མདངས་ཤིག་ཀྱང་མངོན་འདུག་པ་དེ།",
    "ཞེས་བྲིས་འདུག་ང་སླར་སྒལ་པར་ཐེངས་གཅིག་འཁུར་རོགས།",
    "ཁྱེད་ཀྱིས་ལོ་དེར་ང་སྒལ་པར་འཁུར་ནས་གཙང་པོ་བརྒལ་བ་དེར་འགྱོད་པ་སྐྱེས་ཀྱི་འདུག་གམ།",
    "ང་འགྱོད་པ་སྐྱེས་ཀྱི་མི་འདུགཚེ་ཕྱི་མར་ངས་ད་དུང་ཁྱེད་རང་སྒལ་པར་འཁུར་རྒྱུ་དང་།",
    "ང་ཁྱེད་རང་ལ་དགའ་པོ་ཡོད།",
    "ཚེ་ཕྱི་མར་ངས་ད་དུང་ཁྱེད་རང་ལ་དགའ་ངེས་ཡིན།",
    "ཁྱེད་རང་འདིར་ལེན་པར་ཕེབས་རྩིས་ཡོད་དམ།",
    "ག་འདྲ་འདུག་ཅེས་ཤོད་ཀྱིན་དུ་ཕ་རྒན་གྱིས་ཁང་པའི་སྦུག་ནས་བཅོལ་དངུལ་འཛིན་ཤོག་བླངས་ནས་སྒྲོག་ཙེའི་ཐོག་ཏུ་གཡུགས་བྱུང་།",
    "ཕར་བལྟས་ན་ཕ་རྒན་གྱིས་ལྐུགས་པས་ཨུ་ཚུགས་ཀྱིས་མག་པར་འགྲོ་རྒྱུར་སེམས་ཐག་རྦད་དེ་བཅད་ཟིན་འདུག་པས་སུས་ཀྱང་ཁ་ཏ་བྱེད་མི་ཐུབ།",
    "དེར་བརྟེན་ངས་བསམ་བཞིན་དུ་ཧུང་ཧྥུང་རང་རྐྱ་འཕེར་དུ་བཅུག་པ་ཡིན།",
    "ཡོང་བ་འདུག་གམ།",
    "འོན་ཀྱང་བདག་ཀའོ་ཏ་ལིན་དང་ཁ་བྲལ་ཐུབ་པའི་སྤྲོ་སྣང་མ་ཡལ་གོང་ཁྲེན་ཀྲང་ཞིན་གྱིས་བདག་ལ་ངས་ཁྱེད་ལ་བཟའ་ཚང་ཁ་བྲལ་བྱ་རྒྱུའི་དཔང་རྟགས་ཀྱི་དངོས་པོ་མཁོ་འདོན་བྱས་པ་དེ་ཀའོ་ཏ་ལིན་གྱིས་ཤེས་འདུག་ཁོས་ཁོ་ཡི་ལག་ནང་དུ་ངེད་གཉིས་གབ་མཐུན་བྱས་པའི་འདྲ་པར་དང་།",
    "ཀའོ་ཏ་ལིན་ལ་མི་གཞན་གྱིས་གྲི་བརྒྱབ་འདུག་ཅེས་པ་ཞིག་གོ་ཐོས་བྱུང་།",
    "ཁོས་དེ་སྔོན་ཁྱེད་རང་ལ་སྡུག་པོ་བཏང་ཡོད་པས་ཁྱེད་ཀྱི་གཅེན་པོས་འཁོན་ལན་སློག་པ་ཞིག་མིན་ནམ།",
    "དངུལ་ལག་ཏུ་འབྱོར་བའང་མགྱོགས་པོ་ཡོད་ཟེར་སྲོལ་འདུག་པས།",
    "རྒྱུགས་ཤིག་ལམ་སེང་འདི་ནས་རྒྱུགས་ཤིག་ཅེས་ངན་སྨྲས་བྱས་པར་ཏིང་ལེ་གཞི་ནས་དྲན་པ་སོས་ཏེ་ངོ་ཚ་ཁ་སྐྱེངས་ངང་རང་ཉིད་ཀྱི་ཁུག་མ་ཁྱེར་ནས་འཕུར་བ་ལྟ་བུའི་སྒོའི་ཕྱིར་ཐོན།",
    "བཟོ་གྲྭའི་ནང་ལས་བཟོའི་ཉལ་ཁང་རྒྱ་ཆེ་རུ་གཏོང་བའི་ལས་གྲྭ་འགོ་ཚུགས་གྲབས་ཡོད་པས་ཉིན་ཁ་ཤས་ནང་ག་ས་ག་ནས་ལས་གྲྭ་འདྲི་རྩད་བྱེད་མཁན་མི་མི་ཉུང་བ་ཞིག་འདུག་པས།",
    "དཔའ་བོར་གྱུར་རྗེས་གང་ཅིར་ལེགས་སུ་ཕྱིན་འདུག་ཡཱ།",
    "ཅེས་པར་སྦྱིན་བདག་ཧོ་ཡིས་མགོ་བོ་གཡུག་གཡུག་བྱེད་བཞིན་ངས་བལྟས་ན་ད་ལྟ་ཁྱེད་ཀྱི་ཁྱིམ་ཚང་འདི་ཆ་རྐྱེན་ཡོངས་སུ་ཚང་བའི་ཁྱིམ་ཚང་ཞིག་ཏུ་རྩིས་རིན་མི་འདུག་ད་དུང་ཅི་ཞིག་འཛོམས་མེད་པ་ཁྱེད་ཀྱིས་ཤེས་སམ།",
    "ཁྱེད་ཀྱིས་བལྟས་ན་ག་འདྲ་འདུག་ཅེས་དྲིས།",
    "ངས་ཁྱེད་རང་ལ་ཤོད་རྒྱུར།",
    "ཁྱེད་རང་རྒས་རྗེས་བདེ་སྐྱིད་ལོངས་སུ་སྤྱོད་རྒྱུར་སྒུག་རྐྱང་བྱོས་ཤིག་ཅེས་སྨྲས།",
    "དེའི་རྗེས་སུ་བཟའ་མི་གཉིས་ཀས་མིག་ཧྲིག་ཧྲིག་ངང་བུ་ཡོང་རྒྱུ་བསྒུགས་ནས་བསྡད་འདུགསྒུག་སྒུག་ངང་དུ་དགུན་དུས་ཟིན་གྲབས་ཡོད་ནའང་བུ་མ་སླེབས་པས།",
    "ཡུམ་ལ་ཁོ་ཚོར་ཡིག་རྒྱུགས་མ་ལོན་པའི་མི་དགོས་ཀྱི་མི་འདུག་ཞེས་གསུངས།་",
    "ང་རང་གཅིག་པོ་ཡབ་ཆེན་གྱི་སྐུ་གདུང་བང་སོར་འཇུག་པའི་མཛད་སྒོར་ཞུགས་པར་ཡོང་བ་ཡིན།",
    "ཨེམ་རྗེ་ཀོ་ལི་ལགས་ཀྱིས་ཁོང་རང་ཉིད་ཀྱང་ཡིད་ཤིན་ཏུ་སྐྱོ་པོ་བྱུང་ཞེས་དང་།",
    "ཡག་པོ་འདུག་ཅེས་ཙུའོ་ཙུའོ་མུའུ་ཡིས་ཐུག་པའི་དཀར་ཡོལ་ལིའུ་ཀན་གྱི་མདུན་དུ་བཞག་སྟེ་གྲོད་ཁོག་ལྟོགས་ཡོད་འགྲོ།",
    "གྲེ་བ་བཅད་ཟིན་པའི་ཙུའོ་ཙུའོ་མུའུ་ཡིས་ངས་ཕའི་གྲི་བསྡུས་ཟིན་རུང་བསམ་ཡུལ་ལས་འདས་པ་ཞིག་ལ་བུ་ལའང་གྲི་ཞིག་འདུག་ཅེས་དང་།",
    "ཀུན་སློང་དེ་དག་དེ་རིང་གཞི་ནས་ཀླད་པའི་ནང་འཁོར་ཡོང་བ་ཞིག་མིན་པ་ལོས་ཡིན།",
    "ཁྱེད་རང་སེམས་སྡུག་མ་བྱེད།",
    "ཁྱེད་རང་ཏོག་ཙམ་སྒུགས་དང་།",
    "ངས་བལྟས་ན་ཁྱེད་རང་ལ་བྱེད་ཁག་པོ་ཞིག་ཐུག་པ་འདྲ།་",
    "ཁོ་སེམས་འཚབ་ལངས་ནས་ངོ་གདོང་ཡང་སྐྱ་བོར་གྱུར་འདུག་ཁོས་ལོའུ་མའེ་ལ་ཀོ་བའི་དངུལ་ཁུག་ཅིག་མཐོང་བྱུང་ངམ།",
    "མི་དང་མ་འགྲོག་པར་འདུག་མི་ཐུབསུ་དང་འགྲོག་ཀྱང་སྐྱོན་ཡེ་མེད་པ་ཞིག་གཏན་མི་སྲིད།",
    "ཡོན་ཏན་ཅན་གྱི་གྲགས་སྐམ་ཞིག་ཀྱང་མེད་པས་ཀུན་གྱིས་འཕྱ་བ་ལས་མི་འོངས་སྙམ་སྦྱར་བྱང་མ་བཞག་པར་ཕུལ་བ་བཞིན་ཉིད་ནས་གསུང་འབུམ་ཁྲོད་དེ་བཞིན་བཞག་འདུག་ཅེས་གསུངས།",
    "འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན།",
    "ན་ཚོད་ཅི་འདྲ་འདུག་གསུངས་པར།",
    "དེའི་གཟུགས་བརྙན་ནུབ་རིའི་མཁའི་མཐོངས་སུ་ཤར་བ་ལ་དེ་ཡང་ཉི་མ་ཇི་བཞིན་འདུག་གསུངས་པ་ནི།",
    "སེམས་སུན་སྣང་སྐྱེས་ནས་ངུས་པ་ཞིག་མིན་ངེས་ཤར་ཞེས་དོན་གྱིས་རྟོགས་པ་ཞིག་སྐྱེས་པ་ཞལ་ཀྱིས་བཞེས་འདུག་ལ།",
    "ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཕུག་ཏུ་བཞུགས་སྐབས་ཨ་རང་བྱོན་ཞིག་ཀྱང་བྱུང་།",
    "རྒན་པོ་འགས་བཟང་བོའི་བག་ཆགས་ཅན་དུ་འདུག་ཟེར།",
    "བསྙེན་པ་གྲོལ་ཚེ་ཁམས་ཀྱང་རང་སར་ཅུང་བབས།",
    "ཐམས་ཅད་སྡུག་བསྔལ་བསྐྱེད་པའི་སྣོན་པ་རུ་འདུག་པ།",
    "ཞེས་གསུངས་པས་དད་པ་དང་དག་པའི་སྣང་བ་མ་སྐྱེས་པས་ལན་པར་གོ་ཞེས་གསུངས་འདུག་གོ།",
    "གཞན་ཡིག་བསྐུར་ཅིག་འདུག་པ་བལྟས་པས།",
    "མཆོད་ཁང་དུ་གསོལ་ཇ་བཞེས་རྗེས་འདུག་མལ་དུ་བྱོན་ནས་བཞུགས་ཏེ་ཞལ་ནས།",
    "ཡོན་ཏན་ཅན་གྱི་གྲགས་སྐམ་ཞིག་ཀྱང་མེད་པས་ཀུན་གྱིས་འཕྱ་བ་ལས་མི་ཡོང་སྙམ་ནས་སྦྱར་བྱང་མ་བཞག་པར་ཕུལ་བ་བཞིན་ཉིད་ནས་གསུང་འབུམ་ཁྲོད་དུ་དེ་བཞིན་བཞག་འདུག་ཡང་ཞལ་ནས་ང་རྒྱལ་མ་ཆེ་ན་བཟང་སོགས་སྐབས་སྐབས་ཀྱི་སྐྱོན་གང་ཤུགས་ཆེ་ན་དེ་ཉིད་བུར་འཇོམས་ཀྱི་བསླབ་སྟོན་ཞལ་ཏ་རུས་པ་ཅན་སྩོལ་བ་སོགས་མ་མཛངས་ཀྱིས་བུ་བཞིན་ལུགས་གཉིས་ཆར་ནས་བསྐྱངས་པའི་བཀའ་དྲིན་བསབསམ་མཐའ་མེད།",
    "ཁོང་རང་ཉིད་ལ་བབ་ཀྱང་ལོ་ཤས་ལས་མ་ནུས།",
    "ཁོང་རང་ཉིད་ཀྱི་གསུང་སྒྲོལ་དཀར་བསྟོད་པ་ཨུཏྤལ་འོད་ཀྱི་ལྕགས་ཀྱུ་སོགས་ལུང་མང་དུ་གནང་།",
    "མཐུན་གསུམ་ལ་གང་ངོས་འཛིན་ཞུས་པར་ཁུ་བོ་ཕུ་ནུ་སོགས་རྩིར་འདུག་གསུངས་ནས་ཚེ་རིང་དུ་གནས་དགོས་ཚུལ་སོགས་གསུངས།",
    "ཟླ་བ་དགུ་བའི་ཚེས་ནས་ཁོང་རང་ཉིད་ཀྱི་སྐྱེད་མ་འཆི་བ་ལ་པ་ངོ་འཕྲད་པའི་ཆེད་ཀྭ་རིང་དུ་ཕྱག་ཕེབས་གནང་།",
    "ཁོང་རང་ཉིད་ཀྱི་ཐུགས་དམ་གྱི་རྟེན་ཞལ་གྱི་བྲིས་ཐང་ཡུམ་བཞི་སོགས་འཁོར་གྱིས་བསྐོར་བ་གནང་སྟེ་འབྲལ་མེད་བྱེད་དགོས་གསུང་བ་དང་།",
    "གྲོལ་འཕྲལ་མར་ལམ་ཀུན་ས་དེར་འཁོད་འདུག་པས་ཐམས་ཅད་ལྷན་ཅིག་ཏུ་རྒྱུན་ཆགས་གསུམ་པ་བབཏོན་ནས་ཤིས་བརྗོད་བསྟན་འབར་མས་གནང་།",
    "ཁོང་རང་ཉིད་ནས་རྒྱ་དངུལ་རྡོ་ཚད་ཉི་ཤུ་ལྷ་ཁང་བཞེངས་རྒྱུའི་རྒྱུར་གནང་སྟེ་རིམ་གྱིས་སེར་སྐྱ་ཐམས་ཅད་ལ་དེ་ལུགས་བཀོད་ཁྱབ་གནང་བས་ཐམས་ཅད་ཀྱིས་ཁུར་ལེན་བྱས།",
    "འདུག་གནས་སུ་འཁོད་ནས་བསམ་བློ་ཞིག་བཏང་བར་དུས་ཕུན་སུམ་ཚོགས་པ་སྟོན་པ་བཅོམ་ལྡན་འདས་ལྷ་ལས་བབ་པའི་དུས་ཆེན་དང་།་",
    "གཞན་ཡང་ཞག་ཞེ་དགུའི་བར་དུ་ཁོང་རང་ཉིད་ཀྱིས་བཅད་རྒྱའི་ངང་ནས་མི་འཁྲུགས་པའི་ཆོ་ག་དང་འབྲེལ་བར་སྔགས་བཟླ་བ།",
    "ཁོང་རང་ཉིད་ཀྱི་གསུང་རྩོམ་འགའི་ལུང་རྣམས་གནང་།",
    "འོན་ཀྱང་རང་སྐལ་ཆུ་ཐིགས་ཙམ་ཞིག་བརྗོད།",
    "དེ་ནས་ཨ་ར་པ་ཙ་ནའི་སྒྲུབ་ཕུག་ཏུ་ཞག་དྲུག་ཙམ་བཞུགས།",
    "བྲག་དེ་ཕྱིས་ཤེལ་དགོན་ན་ཡོད་འདུག་དེའི་སྟབས་མཇལ་མ་ཐུབ་གསུངས།",
    "ཁོང་རང་ཉིད་ཀྱི་ཕྱག་ཚ་སྟོན་པའི་སྐུ་བཅས་རྟེན་སྣ་མང་བོ་བཞུགས་སུ་གསོལ།",
    "ཟླ་བ་བདུན་པའི་ཚེས་གགཅིག་ལ་ཁོང་རང་ཉིད་ཀྱི་ཕྱག་དཔེ་བཀའ་བསྟན་བཅོས་ཡོངས་རྫོགསརྗེ་ཡབ་སྲས་གསུམ་གྱི་གསུང་འབུམ་ཚར་གཅིག་བཅས་ཀུན་མཁྱེན་གོང་མའི་སྐུ་གདུང་མཆོད་རྟེན་གྱི་ཁྲི་ནང་དུ་བཞུགས།",
    "ཁོ་རང་མཐོང་ཆེ་བ་མ་ལགས་ཏེ།",
    "དེ་འཕྲལ་ཁོ་བོའི་སེམས་ལ་སྔོན་སྐུ་གོང་མ་དེ་ཉིད་ནས་ང་རང་ལ་སྒོ་མང་རྣམ་འགྲེལ་ལ་དེ་ཙམ་རྩོད་པ་མེད་སྟབས།",
    "ཡོངས་འཛིན་ཚང་ལ་ཟ་མ་འདི་འདྲ་མང་བོ་དྲངས་པར་ཟ་མཁན་ཞིག་འོང་ངེས་ཚོད་འདུག་ན།",
    "རང་ཉིད་ཀྱིས་ནུས་ཚོད་ཀྱི་འབུལ་བ་ཕུལ་བ་རྣམས་དངུལ་དཀར་ཁལ་བཅུ་གཅིག་ལྷག་ཙམ་འདུགདམུ་དགེ་ནོར་བས་གདན་འདྲེན་ཞུས་པ་ལྟར།",
    "ནམ་ལངས་པའི་བར་དུ་བདག་འཇུག་ཚར་བདུན་འགྲོ་གྱིན་འདུག་གསུངས།",
    "བོད་ཡུལ་འདི་མུན་པའི་གླིང་དུ་འདུག་མི་རྣམས་ཕྱུགས་ལས་བླུན།",
    "མཁས་པ་མཐོང་བ་དོན་ལྡན་ལ་གཡུའི་ཐོག་འདུག་གོ་ཞེས་བསྒྲགས་པས།",
    "གནོད་ལན་དུ་ཕན་འདོགས་དགོས་པར་འདུག་སྙམ་ནས།",
    "རྒྱལ་བོའི་སྤྱན་བསྙུང་བ་ལས་ཚབ་ཆེ་བ་ཞིག་ཡོང་བ་འདུག་སྟེ་འཕོངས་ལ་རྭ་སྐྱེ་བར་གདའ་ཞུས་པས།",
    "བལ་བོ་དང་རྒྱ་གར་གྱི་མཚམས་རི་ཀུན་ཏུ་རྒྱུ་བར་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ན་རྒྱ་གར་ནས་ཚུར་ཕེབས་པ་དང་མཇལ།",
    "དེ་ནས་གཡུ་ཐོག་པ་ཆེན་པོ་ཀློ་ཁ་ཁྲ་ལ་རྒྱལ་བོ་མེ་རྩ་ཡོ་ཁུར་ཟེར་བ་ཞིག་འདུག་པའི་གམ་དུ་སླེབསཀློ་ཁ་ཁྲ་ལ་མི་ཤ་ཟ་བའི་སྲོལ་ཡོད་པས།",
    "མི་འཁྱམས་འདིའི་གཟུགས་ཕུང་རྒྱས་འདུག་པས་བསད་ནས་ཤ་ཟ་དགོས་བསམས་ཏེ།",
    "གཡུ་ཐོག་པ་ལྷའི་སྤྲུལ་བར་འདུག་སྐུ་གསུང་ཐུགས་དང་འགལ་བ་མཐོལ་ཞིང་བཤགས།",
    "བང་ཆེན་པ་དགོས་པར་གདའ།",
    "འདོད་ཆགས་དང་རང་འདོད་མ་ཆེ་བར།",
    "ཁྱེད་རང་རྣམས་ལ་བྱིན་ཚར་བའི་ལུགས་ཡིན།",
    "བྱེམ་ཚང་ཕྱུག་པོ་མིན་ལ་ཧ་ཅང་དབུལ་བོ་ཡང་མིན་འདུག་དཔལ་མགོན་འཕགས་པ་ཀླུ་སྒྲུབ་ཀྱིས།",
    "འཆད་ཉན་སྒོམ་སྒྲུབ་བྱེད་པ་ཤ་སྟག་བརྩེས་པ་དྲན་འདུག་ཅུང་ཟད་ནར་སོན་ནས་ཕྱུགས་འཚོ་བ་དང་།",
