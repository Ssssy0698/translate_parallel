    "སྐྱེ་བ་ཡོད་པར་ཁྱེད་རང་ཡང་འདོད་དགོས་པར་མཚུངས་པའི་ཕྱིར་དང་།",
    "ཉན་ཐོས་རྣམས་དང་རང་རྒྱལ་གྱིས།",
    "སུ་ལ་བསྟན་ཀྱང་གོ་བ་མི་འདུག་པས།",
    "མཁས་པའི་མཁས་མཆོག་བྷེ་རོ་ཙ་ན་ཡི།",
    "དྲིན་ལན་གསབ་དང་རང་གཞན་དོན་ཕྱིར་དུ།",
    "རང་རང་སུག་རྗེས་མིང་ཡིག་སོ་སོར་གསལ།",
    "འཇིགས་རུང་ངན་འགྲོའི་གཡང་སར་འཆོར་ཉེན་གདའོ།",
    "མི་འབུམ་ཚོ་གཉིས་ཙམ་གྱི་ཚེ་སྲོག་དུས་གཅིག་ལ་བརླགས།",
    "དེ་ལྟ་བུའི་ཀླད་ཆེན་མེད་པའི་མི་ད་སྔོན་དངོས་སུ་མཐོང་ཟིན་པ་ཡང་བཅུ་ཕྲག་འགའ་ཞིག་བྱུང་ཡོད་འདུག་གོ།",
    "དམུས་ལོང་རྣམས་ཀྱིས་གླང་ཆེན་གྱི་གཟུགས་སྨྲས་ཚུལ་གསུངས་པ་ཇི་བཞིན་དུ་བྱུང་འདུག་སྟེ།",
    "སྔོན་གནས་རྗེས་དྲན་གྱིས་བྱུང་བ་རྣམས་གྲངས་དང་སྤུས་ཚད་གཉིས་ཀ་ཇེ་མང་ཇེ་བཟང་དུ་འགྲོ་བར་འདུག་པས་མི་རྣམས་ལ་སྐྱེ་བ་སྔ་ཕྱི་འདི་ཡོད་ལས་ཆེ་སྙམ་བྱེད་དུ་འཇུག་པ་ཙམ་ཡིན་ནོ།",
    "རྒྱུན་མི་འཆད་པའི་ཚེ་སྲོག་དེ་ཡོད་པ་ད་དུང་འགོག་ཐབས་མི་འདུག་གོ།",
    "མིང་འདི་ཡི་གེ་སོ་སོ་ལས་སྒྲ་གདངས་བསྒྱུར་ཚུལ་མི་འདྲ་པ་མང་པོ་བྱས་འདུག་ཀྱང་ཕྱི་ཡིག་ཏུ་འདི་ལྟར་བྲིས་སྣང་།",
    "འདུག་པ་རྨས་སྐྱོན་ཕོག་པ་ཡིན་རྒྱུར་འདུག་ཟེར།",
    "མཚོན་རྟགས་ཅི་ཡང་མི་འདུག་ཀྱང་ཁོས་མ་ནོར་མ་འཆུག་པར་དེར་ཕྱིན་ཏེ།",
    "ཡུལ་དེ་གའི་མི་རྣམས་ལ་དེ་འདྲའི་སྲོལ་མི་འདུག་ཀྱང་།",
    "ཐེན་སན་ཉོས་སྒོ་དྲུང་དུ་འདམ་མང་པོ་བསགས་འདུག་པ་ཕྱིར་དབོ་བའི་ཆེད་དུ་ཕྱིན་ཚེ་ཆར་གྱིས་རླན་པའི་ཕུག་པ་རྡིབ་སྟེ་རྡིབ་འོག་ཏུ་ཤི་དེ་ལྟ་ནའང་ཁོས་རང་ཉིད་ཤི་བ་མ་ཤེས་ཏེ།",
    "དེ་འཕྲལ་ཡང་ཨ་ཙི་ངའི་ལག་པ་ཅིའི་ཕྱིར་འདི་འདྲའི་ཆུང་ངུར་གྱུར་ཅེས་ཟེར་བས་དེར་ཡོད་ཐམས་ཅད་ཤིན་ཏུ་སྐྲག་ཅིང་ཧ་ལས་ཏེ།",
    "གད་འོག་ཏུ་ཤི་འདུག་པས།",
    "ཁང་བའི་སྒོ་ནི་ཕྱེ་སྟེ་བཞག་འདུག་ནང་དུ་ཕྱིན་པས་མི་གཅིག་ཀྱང་མི་འདུག་ཁང་བའི་གྱང་ལོགས་སུ་གོས་ནག་པོ་འགའ་ཞིག་བཀལ་བ་མཐོང་ནས་རྐུ་སེམས་སྐྱེས་ཏེ།",
    "མི་ཁྱིམ་ཞིག་ཏུ་སྐྱེས་ཏེ་ལུས་ཀྱང་བྱིས་པ་ཆུང་ངུ་འོན་ཀྱང་ལག་ཞིག་ཏུ་གྱུར་ཏེ་གཏམ་སྨྲ་བར་འདོད་ཀྱང་སྨྲ་མི་ནུས་པ་ཞིག་ཏུ་འདུག་མགོ་གཡོན་པ་འདི་ནི་འདི་ལྟར་ཕག་སུག་ཏུ་གྱུར་འདུག་ཟེར་རོ།",
    "ཕྱི་ཉིན་བལྟས་པས་ཇི་ལྟ་བ་བཞིན་འདུག་པ་ཧྲང་ཧེའི་ཏ་ཁྲང་པའོ་ཧཱ་དགོན་གྱི་ཚེ་ཐར་ར་བར་བཏང་སྟེ་ཚེ་ཐར་བྱས།",
    "བརྙན་པར་དེ་ད་དུང་དུའང་འདུག་གོ།",
    "ཚེ་འདིའི་བག་ཆགས་མཐུ་བརྟས་པས་མི་གསལ་བའམ་བརྗེད་འགྲོ་བར་འདུག་གོ།",
    "དེའི་ཚེ་ཇི་འདྲ་འདུག་པ་དྲིས་ན།",
    "དེ་ལ་གཉིད་འབེབས་བྱས་པས་འཛམ་གླིང་གཡུལ་ཆེན་གཉིས་པའི་སྐབས་སུ་ཁོང་རང་འཇར་མན་གྱི་གནམ་དམག་འཕུར་བསྐྱོད་པ་ཡིན།",
    "ཀྲན་ཧྲིན་ལ་དེང་རབས་སུའེ་ཏེན་གྱི་དངོས་རྫས་ལ་ཆ་རྒྱུས་ཡེ་མི་འདུག་འོན་ཀྱང་།",
    "ཞེས་ཡང་ཡང་གསུངས་པ་ཇི་ལྟ་བ་བཞིན་དུ་བྱུང་འདུག་གོ།",
    "ང་རང་དང་གསུམ་ཀ་འདུས་པ་ལ་འབོད་ནས།",
    "ཁྱེད་རང་གསུམ་ཀ་ཆབ་ནག་འདི་རུ་མ་བསྡད་པར་ཆབ་དཀར་དུ་ཕྱིན་པ་དྲག་ད་ང་མགྱོགས་པར་རྩི་དཀར་དུ་འགྲོ་དགོས་པ་ཡོད།",
    "གོ་ཆོད་པར་ཨེ་སྣང་ལྟ་འགྲོརྡོ་རྗེ་རྒྱལ་མཚན་སྡུག་གེ་ཡང་གནས་ཁང་བཟང་པོ་དཀོན་དྲགས་ནས་ད་རུང་མ་རྙེད་པར་འདུག་སྡིག་ཅན་གྱི་ཁྱིམ་དུ་ནི་ངས་མ་བཏང་།",
    "ད་ང་རང་སྡིག་ཅན་ཡིན་ཡང་ཡིན།",
    "ཡང་ཤིང་ཁུར་དེ་ཁུར་ནས་ཡུད་དེ་ཡུད་དེ་འཕྲང་ལ་འགྲོ་ཞིང་འདུག་གོཡང་ངས་བོས་ནས།",
    "ཁ་འཆམས་ཤིང་མཉམ་པོར་འགྲོགས་རྒྱུ་འདུག་པས་ཁྱེད་རྣམས་ལ་སྨོན་པ་ཡིན།",
    "ཡུད་དེ་ཡུད་དེ་འགྲོ་འདུག་པ་ལ།",
    "ཡང་ཁོས་མི་ཡུལ་དུ་འདུག་ཡུན་ཐུང་བས་ཞེ་མ་ཚིམ་ང་མི་ཡུལ་དུ་དེ་བས་རིང་བ་གཅིག་འདུག་རྒྱུ་ཡིན་པ་ལ།",
    "ང་རང་མི་ལུས་ཐོབ།",
    "བཏགས་གྲོལ་སྤྲུགས་མ་དེས་ང་རང་ལ་ཤིན་ཏུ་ཕན་པ་བྱུང་།",
    "ཆུ་དེ་ལ་བསྒྲལ་བ་ཙམ་དུ་འདུག་དེ་ནས་རྡོ་རྗེ་སྲི་ཐར་དང་།",
    "ཁོ་ཞེད་ནས་འདར་ཡོད་མེད་བྱེད་འདུག་པ་དང་།",
    "རི་བོ་ཁར་བཅུག་པའི་མི་གཅིག་འདུག་ཟེར།",
    "ངས་བུ་ཚ་ལ་ང་རང་རྣམས་ཆབ་དཀར་དུ་འགྲོ་བྱས་པས།",
    "ལག་པ་ནས་བཟུང་བས་གཟུང་རྒྱུ་འདུག་ངེས་པ་མི་འདེན་ནམ་བསམ་ངེས་པར་ཨེ་བདེན་ནམ་བསམས་ནས།",
    "འོ་ན་ཁྱིམ་འདིའི་ནང་ན་འདུག་ཉན་ཨི་སྣང་ལྟོས།",
    "ཁོ་མར་བབས་མི་འོང་བར་སྟེང་ནས་མར་མིག་གཅིག་བལྟས་མ་ངོམ་པ་འདྲ་གཅིག་བྱས་ནས་འགྱེད་དེ་ལོང་འདུག་ང་མར་བབས་ནས་བར་ཁང་དེར་ཕྱིན་པས།",
    "མི་འདུག་པའི་རྗེས་མེད་པ་ཧང་ལ་རྒོག་པ།",
    "ཀ་བའང་གས་ནས་ཞིག་ལ་ཁད་པ་གཅིག་འདུག་འོག་ཁང་དེར་ཕྱིན་པ་དང་།",
    "ཕྱིར་སྒོ་ཆུང་གཅིག་འདུག་པ་ལ་འགྲོ་བར་བརྩམས་པ་ནས་ཁོ་སྡུག་པ།",
    "ལབ་ལབ་ཡིད་ཆེས་པ་གཅིག་བྱེད་རྒྱུ་ཡིན་པར་འདུག་པ་ལ།",
    "༡༩༥༩ལོར་ང་རང་ཐེ་ཝན་ནུབ་ཕྱོགས་ཀྱི་ཧེ་སྦྱོང་གླིང་ཕྲན་དུ་བྱ་བ་བསྒྲུབས་ཏེ་བསྡད།",
    "དྲན་ཡང་ཐམས་ཅད་འདས་ཟིན་པས་སླར་གླེང་བ་ལ་དགོས་པ་མི་འདུག་གོ།",
