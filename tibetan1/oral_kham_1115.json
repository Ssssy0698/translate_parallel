    "ཐོལ་སྐྱེས་རྦད་གཅོད་ཀྱི་སྐྱོང་ཐབས་འདི་གནས་པ་བསྒྲུབ་པའི་ཐབས་ནི་ལོས་ཡིན་ནམ།",
    "གནས་པ་བསྒྲུབ་བྱེད་ཀྱི་དྲན་ཤེས་ཀྱིས་འགྱུ་རྐྱེན་བྱེད་པ་དོགས་གནས་སུ་འདུག་པ་ལ་བསམ་ཏེའོ།",
    "དཔེར་ན་དྲི་མ་བཀྲུ་བའི་རྫས་བུལ་ཏོག་གམ་སུག་པ་དེ་ཡང་དྲི་མ་ཀ་ལོས་ཡིན་ནའང་།",
    "གང་ཤར་བཟོ་མེད་ཀྱི་སྐབས་སུ་རྣམ་རྟོག་ཁོ་རང་གང་བྱེད་དུ་བཞག་ཅེས་སོགས་གསུངས་པས་ན་འདི་ནི་ཞི་གནས་རང་ལ་དཔག་པའི་ཁ་ཡན་དུ་སྐྱོང་པ་སྟེ།",
    "གསུང་པ་དེར་གདའ་བས་ཁྱད་པར་དེས་དབྱེའོ།",
    "ཐ་མལ་པ་དག་ཀྱང་སེམས་བྱིང་བ་ཞིག་འདུག་ཟེར་བ་ལྟ་བུ།",
    "གང་ཟག་ལ་ལར་གནས་པ་དང་པོ་ནས་རྟགས་སྣང་འཆར་གྱི་འདུག་པ་ལ།",
    "རྟགས་སྣང་འཆར་ཚུལ་སྔ་ཕྱི་སོགས་སྣ་ཚོགས་མ་ངེས་པ་ཞིག་འདུག་པའི་དོགས་པ་སྤོང་ཕྱིར་རོ།",
    "ཕྱི་མ་ཡིད་ལ་མི་བྱེད་པར་བཞག་འདུག་པ་ཅི།",
    "སྤྲོས་བྲལ་དུ་བསྡུ་ན་ད་གཟོད་སྤྲོས་བྲལ་གྱི་དཔྱད་པ་སྟོན་གྱི་འདུག་པ་ཅི།",
    "དེ་ཡང་འཁོར་གསུམ་ཡོངས་སུ་དག་ཏུ་སྟོན་རྒྱུར་འདུག་པ་ལ།",
    "དེ་གནས་འགྱུ་རང་བཞིན་མེད་པར་སྦྱངས་མཐར་ཤེས་རབ་ཁོ་རང་ཡང་དམིགས་སུ་མེད་དེ།",
    "གཞན་དག་པ་དང་མ་དག་པའི་སྣང་བ་འཆར་དུ་མེད་པ་ལ་དགོངས་ནས་དེ་སྐད་གསུངས་པར་གདའ་བ་ལ་ཅུང་ཟད་ཀླན་ཀར་བྱས་པའོ།",
    "ཤར་དུས་དེར་ཡང་རང་བཞིན་གྱི་འོད་གསལ་བ་ལས་མི་གཡོ་བས་སྣང་བ་ཡོད་མེད་ཀྱི་གླེང་སྒོ་མི་དགོས་ལགས།",
    "སྣང་མེད་ནི་གཤིས་ཀྱི་འདུག་ཚུལ་ཡིན་པས་འགལ་བར་མི་བཟུང་ངོ།",
    "ཅེས་སེམས་ལ་མི་དཔྱདཔར་ལྷག་འཇོག་ཁོ་ན་དགོས་པའི་གསུང་རིགས་འདྲ་ཞིག་འདུག་དེའི་ཚེ་ན་དཔྱད་པ་དེ་དག་ཇི་ལྟར་རིགས།",
    "ངན་པ་བདག་ཅག་ལའང་མི་འཆར་བ་འདུག་འོན་ཀྱང་ཤེས་རབ་ཅན་མདུན་དུ་སླེབ་ཚེ།",
    "ཚིག་དང་བསྟུན་པའི་གོ་བ་ལེན་ལུགས་ལ་མ་གཟབ་ན་མེ་ཕར་བུས་པས་སྨ་ར་ཚུར་ལ་ཚིག་པ་ཡང་ཡོང་བ་ཞིག་འདུག་པས་དོགས་པ་ཁོང་ནས་བསུས་པ་ལ་ཁམས་འདུས་མི་ལྡང་བ་ཞུ།",
    "འོ་ན་སྤྲོས་བྲལ་གྱི་རྣལ་འབྱོར་ལ་རྗེས་ཐོབ་བཟོ་བ་དང་མི་བཟོ་བ་གཉིས་འདུག་པ་འཐད་དམ་མི་འཐད།",
    "བརྟན་པ་ཐོབ་པའི་དོན་ཡང་རང་ཐད་ཀྱི་སྒོམ་ལ་བར་ལག་མེད་པ་ཞིག་ལ་ཟེར་དགོས་སམ།",
    "དེ་ནས་རྗེས་ཀྱི་བྱ་བ་ཕྱག་རྒྱ་ཆེན་པོ་ངོས་བཟུང་ཞིང་རང་ངོ་སྤྲོད་པའི་སྐབས་སུ།",
    "དེ་སྒོམ་གེགས་མིན་པར་འདུག་ཀྱང་སེལ་བ་ཤར་ཚེ་ཇི་འདྲས་སེལ།",
    "ཐ་མ་དཀར་པོ་འབའ་ཞིག་བྱུང་བའི་གཏམ་རྒྱུད་འདུག་པ་དེ་བཞིན་དུ།",
    "རྟོགས་པའི་རོམི་བྲོ་བར་ཡང་རྟོགས་ལྡན་དཔེ་བྲལ་ཡིན་ཟེར་བ་ཡོད་འདུག་པ་འདི་ངེས་པར་བདེན་ལགས་སམ།",
    "ལུགས་འདི་པའི་ཁྲོད་ཀྱི་སྒམ་སྒོམ་མགོ་ལྟག་མ་ཕྱེད་པ་འགའ་ལའང་དེ་ལྟར་ཡིན་ནམ་སྙམ་པའི་ལོག་ཤེས་སྐྱེས་འདུག་པ་སོགས་ལ་བསམ་ནས།",
    "ཁྲེལ་ཞིང་རང་ལུས་དམ་པར་འཛིན།",
    "ལྐུག་པ་མགོ་ཡོན་མཛད་ཁྱེད་རང་ལ་རག་ཅིང་།",
    "ཞེས་བཀོད་པ་ལ་སྨྲ་བར་འདུག་ཀྱང་།",
    "གསུང་བ་དེར་གདའོ།",
    "ཞེས་སོགས་ཕལ་ཆེ་བའི་རྣམ་དབྱེ་གོ་བ་ཕྱིན་ཅི་ལོག་པ་ཞིག་སྨྲས་འདུག་པ་ཡ་ཆ།",
    "ཞེས་བཀའ་བཀྱོན་མཛད་འདུག་ཀྱང་།",
    "རྒོད་པའི་དབྱངས་ཀྱིས་ཞེས་བྱེད་ཚིག་སྦྱར་འདུག་པས་སྐྱོན་ཞུགས་ཤིང་།",
    "དབྱངས་ཀྱི་འགོ་འདྲེན་ཐམས་ཅད་ལ་ཨེ་མ་ཧོ་ཞེས་ཟེར་གྱིན་འདུག་པ་ལྟར།",
    "ལུང་གཉིས་སུ་ཨེ་མ་ཧོ་སྨོས་པ་ལ་དགོངས་པ་འདུག་སྟེ།",
    "ཟེར་བ་བྱས་འདུག་པ་ལྟར་བསམ་པས།",
    "ལ་སྟོང་རློན་པའི་བུ་ཆུང་སྤྱི་བརྟོལ་གྱིས་ཐང་སྐམ་པོ་ལ་འཁྱམ་གྱིན་འདུག་པ་དེ་ཡིན་པར་གཏན་ཚིགས་དང་བཅས་ངེས་བྱུང་ལགས་སོ།",
    "ཚིག་ལྷག་མ་རྣམས་གོང་བཞིན་བརྗོད་ནས་ཁྱེད་ལ་སློག་ན་ཁྱེད་རང་ལ་གནོད་པར་འགྱུར་བས་སོ། རྗེ་ཀླུ་སྒྲུབ་ཀྱིས།",
    "དེ་ཁོ་ན་ཉིད་དམིགས་པ་གར་གཏད་ཀྱི་སྟེང་དུ་སྤང་ལ་བེ་ཕུར་བཏབ་པ་ལྟར་སྒྲུབ་པའི་རྒྱལ་མཚན་འཛུགས་ཀྱིན་གདའ།",
    "དམིགས་མེད་བཟང་བར་བྱས་པས་ཕྱོགས་གཅིག་པའི་ཨ་འཐས་ཀྱི་ཐོག་ཏུ་ཀོ་འཐས་ཀྱང་བརྩེགས་པར་འདུག་གོ།",
    "ཅེས་སོགས་ལ་ཁྱེད་རང་བསམ་དགོས་པར་གདའ་སྟེ།",
    "ཁྱེད་ཀྱི་རྩོད་སྤོང་ཉི་མའི་འོད་ཟེར་གྱི་ཚིགས་བཅད་ཁྱད་པར་བ་བོར་ནས་ཡར་མར་མཆོངས་འདུག་པ་དེ།",
    "སྐྱུར་རྗེས་སྐམ་གནོན་དང་རྐུན་རྒྱབ་རྫུན་གནོན་གཉིས་ཀ་སྟབས་གཅིག་མཛད་དགོས་བྱུང་འདུག་པས་ཐུགས་བསུན་པ་ཙམ་འོང་ཉེན་གདའ།",
    "ཧོབ་སྤྱོད་ལ་གོམས་པས་ལྗགས་ཀློག་དག་པོ་མ་མཛད་པའི་སྐྱོན་གྱིས་སྨྲ་བ་མང་དུ་བྱུང་འདུག་པ་ནི།",
    "ཟེར་བ་དེར་གདའོ། ཡང་ཁྱེད་ཀྱིས།",
    "ཞེས་སོགས་དཔེ་དོན་མང་པོར་འགོད་པར་མཛད་འདུག་པ་དེ་ནི།",
    "ཟེར་བ་བྱས་འདུག་པ།",
    "སྤྱི་བབ་གོ་བ་བཟང་པོ་བྱུང་འདུག་པས།",
    "ཞེས་པ་འདི་ནི་ཁུངས་དང་འབྲེལ་པོ་འདུག་པས།",
