    "རབ་ཏུ་མི་གནས་པ་ཞེས་པ་ཁས་ལེན་དང་བྲལ་བའི་དོན་ཡིན་འདུག་པས།",
    "གཉིས་པ་ལྟར་ན་གནས་ལུགས་མ་ཡེངས་པར་འཇོག་དུས་དྲན་ཤེས་བཞིན་བརྟེན་པ་དགོས་སམ་མི་དགོས།",
    "ལས་འདིས་ཡང་རང་ཉིད་ཀྱི་ཀུན་དུ་བརྟགས་པའི་དངོས་པོ་མེད་པས།",
    "བྱས་པས་ཡོང་བར་བདོག་ཐུབ་པའི་མངལ་ཟླ་མེད་པར་གདའ་བས་ལུང་ལྟར་ན།",
    "ཁྲ་ཟླའི་སྐར་མ་རྒྱལ་ལ་བབ་པ་ལ་བལྟམས་ཟེར་དགོས་པར་གདའ་ལགས།",
    "དྲུག་བརྒྱ་དང་གཅིག་འདས་པ་ཟེར་དགོས་པ་གདའ་ལགས།",
    "ཤེས་རབ་བསྐྱེད་པའི་ལྷ་འཇམ་དཔལ་ཨ་ར་པ་ཙ་ན།",
    "དེ་འདྲའི་བྱ་བ་ལ་དགོས་པ་མི་འདུག།",
    "འདིས་དཔག་ན་ཉིན་ཞག་གཅིག་ལ་ཤོ་ལོ་ཀ་སྟོང་ཕྲག་གཉིས་གསུམ་ཡང་ཐུགས་སུ་ཆུད་ནུས་པའི་ཚད་ཡིན་པར་འདུག་གསུངས།",
    "འདི་ནས་ཀྱང་དེ་ཙམ་ཞིག་དུས་གཅིག་ཏུ་གསུང་འཚལ་ཞུས་པས།",
    "ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཡང་དག་མཐའ་མངོན་དུ་བྱེད་ཚུལ་དཔྱིས་ཕྱིན་པ་ཞིག་གོ་བ་སྔགས་ཀྱི་སྤྱོད་པའི་སྐབས་ཤིག་ལེགས་པར་གོ་བ་ལ་རག་ལས་འདུག།",
    "ཨ་ར་པ་ཙ་ན་བདུན་སྟོང་།",
    "ཕྱིས་རྟིང་མཇལ་བ་ན་རྨི་ལམ་དུ་བྱུང་བའི་དབྱིབས་དེ་ཀ་རང་དུ་འདུག་གསུང་ངོ། ཧ་",
    "ཁྱད་པར་དུ་གཙང་རང་ནས་བདུན་འབྱུང་ཞིང་།",
    "དེ་ལྟར་གསན་པར་འདུག་གོ།",
    "དེ་དུས་ཀྱང་དུས་འཁོར་གསུང་བར་འདུག་པའི་སྐབས།",
    "འོལ་ཁར་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ན་དང་།",
    "འདི་དག་ཀྱང་རང་ཅག་རྣམས་ཀྱི་སྣང་ངོ་ཙམ་ཡིན་གྱི་ཕྱོགས་བཅུའི་ཞིང་ཁམས་ཀུན་ཏུ་མཛད་ཚུལ་ནི་བསམ་གྱིས་མི་ཁྱབ་པར་གོར་མ་ཆག་གོ།",
    "ཚུལ་འདི་བསམས་ན་མདུན་མ་ལེགས་ནས་གདའ།",
    "དོན་ཡོད་རྡོ་རྗེ་ལས་ཀྱི་རིགས་ཡིན་པས་རྗེས་སོར་རྗེའི་མནལ་ལམ་དུ་ཉ་དབོན་གྱིས་ཀརྨ་བཛྲ་ཞེས་འབོད་པ་བྱུང་བས་སྔགས་ཀྱི་གསང་མཚན་དང་རིགས་གཅིག་པར་འདུག་གསུངས་པ་དང་མཐུན།",
    "ཚུལ་འདི་བསམས་ནས་མདུན་མ་ལེགས་ནས་གདའ།",
    "མ་ཏི་བྷ་དྲ་ཀིརྟི་ཞེས་པའང་འདུག་སྟེ།",
    "དེ་སྐད་བྱས་ན་ཤེས་པས་འདྲ་འདུག་སྟེ།",
    "འདི་ལ་ཇི་ལྟར་འབྱུང་དང་ཕྱི་མར་ཅིར་འགྱུར་བའི་ལུང་བསྟན་གསུམ་འདུག་པས།",
    "སྐུ་ཚེ་གཏིང་མ་དགའ་ལྡན་དུ་གཤེགས་པ་ལ་མི་མཐུན་པ་མི་འདུག་པས།",
    "ད་ལྟ་ལུང་དྲངས་པ་འདི་རྣམས་ལ་བར་ལྟ་བུ་བཏོན་འདུག་པས་ཐེ་ཚོམ་ཟོས་ལ།",
    "རྗེའི་དྲུང་ནས་ཀྱང་བཞུགས་འདུག་པ་ལ།",
    "ཚུལ་འདི་བསམས་ཤིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "ཐམས་ཅད་མཁྱེན་པ་བློ་བཟང་གྲགས་པ་འདི་སྔགས་མཚན་ཉིད་ཐམས་ཅད་ཀྱི་བསྟན་པའི་སྲོག་ཤིང་དུ་འདུག་ཅིང་།",
    "སྔར་ཀྱང་མཛད་པས་འགྲོ་ཕན་ཆེ་བར་བྱུང་འདུག།",
    "ཤར་དུ་བལྟམས་པ་བྱས་ན་ནི་མི་འགྲིག་འདུག་པས་ཡི་གེ་མ་དག་གམ་སྙམ་ནས་མ་བཅོས་པའི་ངེས་པ་མེད།",
    "དགའ་ལྡན་པའི་རྨོངས་ཞེན་ཐེན་ནས་ལན་མང་པོ་ཞིག་བཀོད་འདུག་པར་བརྟེན།",
    "ཁྱེད་རང་གང་དགོས་ཡི་དམ་ལ་ཞུས་པས་ཡོང་བར་སྣང་ཞེས་སོ།",
    "ཡུན་རིང་རང་དུ་མ་བྱུང་བར་མངོན་སྟེ།",
    "བསྟན་པའི་མཇུག་བསྡུད་པའི་མགོ་ཡང་བརྩམས་འདུག།",
    "ཁྱེད་རང་མཁའ་སྤྱོད་འོང་བའི་མདུན་པ་ཐོང་གསུངས་ཅེས་སོ།",
    "འདི་རྗེ་བཙུན་མའི་ཕྱག་མཚན་དུ་འདུག་པས་དེས་རྗེས་སུ་འཛིན་པའི་ལྟས་ཡིན་ནམ་དགོངས་པ་ན།",
    "རབ་ཏུ་གདའ་ཡི་འདི་གཉིས་ཀྱི་ཡོན་ཏན་བརྗོད་ན་ཕར་མཐར་རྙེད་པ་ནི་དཀའ་བར་འདུག་གོ།",
    "ཞིང་དེར་སྐྱེ་བའི་རྒྱུ་ཚོགས་བསྒྲུབ་ཚུལ་གཅིག་གསུངས་པའི་ཡི་གེ་ལོགས་ན་འདུག་པས་དེར་བལྟ་བར་བྱའོ།",
    "བར་ཆད་བཟློག་ཐབས་དང་བསྒྲུབ་པ་བྱེད་དགོས་གང་ཡང་མི་འདུག་པས་གླེན་པའི་གཏམ་དེ་རིས་ནི་མི་སྨྲ་ཡི།",
    "ཁྱད་པར་ཡང་སྙིགས་དུས་བསྟན་པ་ལ་བྱ་བ་བྱེད་པར་ནུས་པའི་དགེ་སློང་དེའི་དྲི་བ་ལ་ནན་ཆེར་གདའ་སྟེ་ལེགས་སོ།",
    "ཚིག་ཕྲལ་པ་མང་བ་ཞིག་འདུག་པས་བདེན་རྫུན་གང་ཡིན་བརྟག་དགོས་ཏེ།",
    "བུ་སྟོན་ཐམས་ཅད་མཁྱེན་པས་སྔོན་གྱི་དཀར་ཆག་རྣམས་ལ་དཔྱད་པ་མཛད་འདུག་པ་དང་།",
