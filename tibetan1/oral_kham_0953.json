    "ཁྱེད་རང་ལ་ཡོད་ཙང་ངས་ལབ་པ་ཡིན།",
    "ག་པར་འདུག་ཡོད་ན་བསྣམས་རོགས་གནང་།",
    "སེམས་པ་བཟང་ལ་ཕ་མར་གུས་བརྩི་ཆེ་བ་བཅས་ཡང་པོ་ཞིག་འདུག།",
    "ཁྱེད་རང་ཁེ་ས་དྷ་རམ་ས་ལར་ཡོད་དུས་དེ་འདྲའི་རྫི་འདྲ་ཐོས་རྒྱུ་འདུག་གམ།",
    "ཡང་ན་བཀྲིས་ཁོ་རང་ངོས་ནས་སྐད་ཆ་འདྲ་ཤོད་ཀྱི་འདུག་གམ།",
    "ངོ་ཤེས་ཚང་མས་ཁྱེད་རང་ལ་བསྔགས་བརྗོད་ཤུགས་ཆེ་བྱེད་བ་ཐོས་པ་ཙམ་གྱིས་ངེད་ཕ་མ་གཉིས་བློ་བདེ་པོ་དང་དགའ་པོ་བྱུང་།",
    "ད་ཆ་ཁྱེད་རང་ཕོ་ལོ་ཉེར་གསུམ་ལ་སླེབས་པས་ཕྲུ་གུའི་མི་ཚེའི་འགྲོ་སྟངས་བཟོ་རྒྱུ་དེ་ཕ་མའི་གཡོལ་དུ་མེད་པའི་ལས་འགན་ལ་བསམས་ཏེ།",
    "ཞེས་པ་ལྟར་ཁ་གསང་དགོས་པའི་དུས་ལ་བབས་འདུག་བསམས་ཏེ།",
    "ཕྲན་ལ་བག་མ་ཞིག་བསུ་ལེན་གནང་འཆར་ཡོད་སྐོར་བཅས་འཁོད་འདུག་པ་དགའ་པོ་བྱུང་།",
    "ག་དུས་ཡིན་ནའང་བཀྲིས་ལགས་དང་བཀྲིས་ལགས།",
    "མི་གཞན་གྱིས་ང་ཡག་པོ་འདུག་བརྗོད་དེ་ཡག་ཏུ་འགྲོ་རྒྱུ་དང་།",
    "སློབ་སྦྱོང་ཕྲན་བུ་ཞིག་ཡོད་པ་དང་འཇུར་ཏ་རྟིང་པ་ཙོག་ཙོག་གྱོན་ནས་འགྲོ་ཤེས་པ་ཙམ་གྱི་དགའ་རབ་ཡིན་བསམ་གྱི་འདུག་གམ།",
    "ཁོ་རང་མི་ག་འདྲ་ཞིག་ཡོད་མེད་ང་ལ་ཆ་རྒྱུས་ཡོད།",
    "མི་གཞན་དག་ཚོས་ཀྱང་བསྟོད་བསྔགས་བྱེད་པ་མ་གཏོགས་སྨད་ར་གཏོང་མཁན་སུ་ཡང་མི་འདུག།",
    "མ་གཞི་ནས་སུ་ནིལ་མི་ཡག་པོ་ཞིག་འདུག་ང་དང་ཐུག་འཕྲད་ཐེངས་འགའ་ཤས་བྱུང་།",
    "ཁྱེད་རང་ཕ་མ་གཉིས་དང་ང་ནུབ་ཀྱི་གྲང་ངར་དང་ཤར་གྱི་དྲོད་འཇམ།",
    "ད་ཁྱེད་རང་ཕ་མ་གཉིས་སེམས་ཁྲལ་མ་བྱེད།",
    "ཡིད་ཆེས་བརྟན་པོ་དེ་འདྲ་ཡང་མང་པོ་འདུག་བོད་པ་འགའ་ཤས་ནི་ཁྱི་ལས་ཀྱང་ལོད་པ།",
    "བྱས་ཙང་སྐྱུང་ཀ་ཡག་དང་ཕོ་རོག་ཉེས་ཟེར་རྒྱུ་དེ་ཁག་པོ་འདུག་ཅེས་ཡིད་ཐང་ཆད་པའི་རྣམ་འགྱུར་དང་བཅས་སྨྲས།",
    "འགྲིག་འདུག་བསམ་གྱི་ཡོད།",
    "ཚན་རིག་པ་ཚོས་དེ་འདྲ་ཡོད་པ་ཅང་ཤོད་ཀྱི་མི་འདུག་ག་ལྷག་པར་དུ་ངས་རྒྱ་གར་བ་ལ་བསྟོད་བསྔགས་དང་མགོ་སེར་པོ་ལ་སྨད་ར་བྱེད་དགོས་དོན་མི་འདུག་སྟེ།",
    "ད་ལྟ་ཁྱེད་རང་གཉིས་ལ་ཕྲུ་གུ་གཅིག་ལས་མེད་ཀྱང་ཕྲུ་གུ་གཉིས།",
    "དེ་ངས་ཁྱེད་རང་གཉིས་ལ་སྤྱི་རྫས་སྒེར་སྤྱོད་བྱོས་ཟེར་གྱི་མེད།",
    "སྐྱེད་ཀ་ཡང་མི་དགོས་ཟེར་གྱི་འདུག་བྱས་ཙང་ངས་ཀྱང་གོ་ནུབ་ཀྱི་གྲང་ངར་དང་ཤར་གྱི་དྲོད་འཇམ།",
    "སྐབས་འདི་བཟུང་སྟེ་ཁྱེད་རང་གཉིས་ལ་ཁ་ཏ་བྱེད་ཀྱི་ཡོད།",
    "བྱས་ཙང་མ་འོངས་པར་ང་རང་གཉིས་ཀྱི་ཕྲུ་གུ་ལ་དེ་ལྟར་མི་ཡོང་བ་ཞིག་ད་ལྟ་ནས་བྱེད་དགོས།",
    "དེ་འདྲ་ཡིན་དུས་ངས་གནས་སྐབས་ལོ་གཉིས་དགོངས་པ་ཞུས་ཏེ་ཚོང་རྒྱག་རྒྱུ་བྱས་ན་ག་འདྲ་འདུག་ཅེས་བརྗོད་པར།",
    "ཅེས་པ་ལྟར་བསམ་བློ་གཏོང་ས་ཞིག་ཏན་ཏན་འདུག་ལར་ནས་གཏམ་གྱི་དཔེ་ལ།",
    "གཞན་སྐྱོན་གྱི་ཁབ་རྙེད་ཀྱང་རང་སྐྱོན་གྱི་རི་བོ་མི་མཐོང་བ།",
    "ད་ཨ་རིར་ཕེབས་ནས་སྤྲོ་ལོས་འདུག་གམ།",
    "དངོས་གནས་ང་ཡང་རྒྱ་གར་ཞེ་པོ་ཞིག་དྲན་གྱི་འདུག་ས་གནས་འདིའི་ཁ་ལག་དང་ཤིང་ཏོག་སོགས་ཀྱང་ལྟ་དུས་དངོས་གཙང་མ་དང་།",
    "གསུམ་ནས་བཟའ་ཚང་དང་ཕྲུ་གུ་སོགས་རྒྱ་མཚོའི་ཕ་རོལ་ཏུ་བཞག་སྟེ་སྡོད་དགོས་དུས་གང་ཅིའི་དཀའ་ངལ་འདུག་སྟེ་ལུང་པའི་མཐུན་རྐྱེན་དང་།",
    "སྤྲོ་སྣང་ཡོད་པ་དེ་འདི་གར་རྩ་བ་ནས་མི་འདུག་ག་དཔེར་ན།",
    "བློ་གྲོས་འདུག་གམ་ཞེས་དྲིས་པས་དཔལ་ལྡན་གྱིས་ལགས་བཞུགས་འདུག་ཅེས་ཁ་པར་བློ་གྲོས་ལ་སྤྲད།",
    "དེར་སྐལ་ལྡན་གྱིས་ཨ་ནི་ཁྱེད་རང་སུཝི་སི་ལ་མ་ཕེབས་པ་གང་ཡིན་ནམ།",
    "བོད་སྐད་རྒྱག་དུས་ད་ལྟ་ངམ་རིང་ནས་སླེབས་པ་ལྟ་བུའི་སྟོད་སྐད་དྭངས་མ་རྒྱག་མཁན་ཞིག་ཡོད།",
    "ཁྱེད་རང་བདེ་པོ་ཡིན་པས།",
    "གཞན་ལས་ཀ་བྱེད་ས་ཐག་རིང་པོ་ཡོད་པ་མ་ཟད་བོད་མི་གཅིག་ཀྱང་མཐོང་ས་མེད་པའི་ས་ཆ་ཞིག་ཏུ་དབྱིན་ཇིའི་མཉམ་དུ་སྡོད་རྒྱུ་དེ་སེམས་པ་སྐྱིད་པོ་རྩ་ནས་མི་འདུག་ཅེས་བཤད།",
    "ལས་ཀ་དཀའ་ལས་ཁག་པོ་འདུག་སྟེ་བཟོད་བསྲན་བྱེད་ཀྱི་ཡོད།",
    "ཁྱེད་རང་གཟུགས་པོར་བཅགས་པོ་གྱིས།",
    "བ་པར་གཏོང་ཤོར་གྱི་འདུག་ཅེས་བརྗོད།",
    "གཞན་པ་ཞུ་ཡག་དྲན་གྱི་མི་འདུག་ཅེས་བརྗོད།",
    "ཐུགས་རྗེ་ལ་ཆུང་བྱིས་པའི་དུས་ནས་བཟུང་སྟེ་ང་ལ་ད་ལྟ་ནང་བཞིན་གྱི་དཀའ་ངལ་འཕྲད་བྱུང་བསམ་པ་རྩེ་ནས་དྲན་གྱི་མི་འདུག་བལ་ཡུལ་དུ་སྡོད་སྐབས་ལས་མི་བརྒྱ་ལྷག་ཙམ་ལ་མར་བཀའ་བཏང་ནས་སྡོད་ཀྱི་ཡོད།",
    "ག་འདྲ་རྡོག་སྒྲིལ་པོ་མི་འདུག་གམ།",
    "ཆུང་ས་ནས་ང་རང་སྒེར་གྱི་བསམ་བློ་བཏང་བ་ཡིན་ན།",
    "ཞེས་གསུངས་པའི་ཚིགས་བཅད་འདིས་རྩ་བས་སྦྱིན་པ་གཏོང་དགོས་པ་གལ་ཆེ་ཚུལ་བསྟན་པ་དང་མཉམ་དུ་ལོངས་སྤྱོད་ཡོད་ན་མི་ལ་གནས་སྐབས་ཀྱི་བདེ་བ་སྤྲོད་ཀྱི་ཡོད་པའང་གསལ་པོ་བསྟན་འདུག་ག་བྱས་ཙང་ངའི་བསམ་ཚུལ་ལ་མི་སྒེར་ཡར་རྒྱས་ཕྱིན་ན།",
    "རྒྱ་ཆེ་ཙམ་ཞིག་གཏོང་དགོས་ཀྱི་མེད་དམ་སྙམ་གྱི་འདུག་ཅེས་བརྗོད།",
    "དེ་བཞིན་བློ་སྐྱེད་ཆེ་ཆུང་ལ་ཁྱད་པར་ཆེན་པོ་འདུག་སྙམ་པ་ཞིག་བྱུང་།",
