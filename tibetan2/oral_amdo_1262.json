    "དེ་ནས་དབུས་ཀྱི་གཏོར་མ་ལྷར་བསྐྱེད་པ་ཁྱེད་རང་རྣམས་ཀྱི་ལག་ཏུ་གཏད་ཅིང་བྱིན་གྱིས་བརླབས་པའི་མོས་པ་མཛོད།",
    "གོང་གི་བུམ་པ་དང་ཟངས་གཞོང་སློབ་དཔོན་གྱི་ལག་ཏུ་བཟུང་།",
    "སྐད་ཅིག་གིས་ཛམྦྷ་ལ་དམར་པོ་ཞལ་གསུམ་ཞེས་པ་ནས།",
    "མེད་ན་འབུལ་བར་མོས་ལ།",
    "ཞབས་ཀྱིས་གནོད་སྦྱིན་ཆེར་མནན་པས་ནོར་བུ་བསམ་གྱིས་མི་ཁྱབ་པ་རྣམས་སྐྱུགས་པས་དབུལ་ཕོངས་ཐམས་ཅད་བསལ་བའི་མོས་པ་མཛོད།",
    "དེ་དག་གིས་རྗེས་སུ་གནང་བ་ལེགས་པར་སོང་ནས།",
    "དེ་དག་གི་སྐབས་སུ་ཞལ་གྱིས་བཞེས་པའི་དམ་ཚིག་དང་སྡོམ་པའི་ཚོགས་རྣམས་ལ་སྲུང་སྡོམ་ཚུལ་བཞིན་དུ་བགྱིའོ་སྙམ་པས་འདིའི་རྗེས་ཟློས་མཛོད།",
    "དེ་རྣམས་ཀྱིས་རྗེས་གནང་ཟབ་མོ་ཐོབ་པའི་གཏང་རག་ཏུ་མཎྜལ་ཞིག་འབུལ་བར་ཞུ།",
    "ཐ་མ་གཉིས་ན་གཏེར་གྱི་ནེའུ་ལེ་རེ་རེ་བསྣམས་ནས་བཙིར་བས་ནོར་བུ་སྐྱུགས་པ།",
    "དེའི་ཐུགས་ཀར་ཡི་གེ་ཧྲཱི་དམར་པོ་ལས་ལྷ་མོ་ཀུ་རུ་ཀུལླེ་དམར་མོ་ཞལ་གཅིག་ཕྱག་བཞི་མ།",
    "གཡོན་ཞགས་པ་བསྣམས་པའི་ཐུགས་ཀར་ཧི་དམར་པོ་ལས་འོད་འཕྲོས་པས་ལྷ་མོ་དམར་མོ་ཞལ་གཅིག་ཕྱག་གཉིས་མ་གཡས་ལྕགས་ཀྱུ་གཡོན་ཞགས་པ་བསྣམས་པ་གྲངས་མེད་པ་སྤྲོས་ཏེ།",
    "འཇིག་རྟེན་ཁམས་ཀྱི་ནོར་རྫས་ཀྱི་རྣམ་པ་གང་འདོད་པ་ལ་ལྕགས་ཀྱུས་བཟུང་ཞགས་པས་བཅིངས་ནས་རང་གི་ཁྱིམ་དུ་དྲངས།",
    "གནོད་སྦྱིན་ནོར་སྐྱུགས་གཉིས་པོའི་ཞལ་རྣམས་ནས་གསེར་གཡུ་མུ་ཏིག་བྱེ་རུ་ལ་སོགས་པ་ཟད་མི་ཤེས་པ་བྲུལ་ནས་བདག་གི་ཁང་པ་ཁེངས་པར་གྱུར་ཨོཾ་ཛམྦྷ་ལ་ཛ་ལེནྡྲ་ཡ་དྷ་ན་མེ་དྷི་ཧྲཱི་སྭཱ་ཧཱ",
    "མདུན་དུ་ཟངས་གཞོང་གི་ནང་དུ་བྲིས་འབུར་གྱི་རྟེན་ཡོད་ན་དེ་ཉིད་ལྷར་བསམ།",
    "ནེའུ་ལེ་གཉིས་ཀྱང་ཕྱག་གིས་བཙིར་བས་ནོར་བུ་སྐྱགས།",
    "ཞབས་འོག་གི་ནོར་བདག་གཉིས་ལ་ཞབས་ཀྱིས་ཆེར་མནན་པས་ཀྱང་ནོར་བུ་སྐྱུགས་ཤིང་།་",
    "ཛམྦྷ་ལའི་ཞལ་དང་ནོར་བདག་ནེའུ་ལེ་གཉིས་ལ་རང་གི་ལག་པས་རེག་པས་དངོས་གྲུབ་བདུད་རྩི་དམར་པོའི་རྣམ་པ་དེ་ཉིད་ལྕེ་ལ་མྱོང་བར་བསམས་ཏེ།",
    "ཨོཾ་ཨཱ་ཧཱུྃ་ཞེས་ཆུ་ལ་རེག་ཅིང་བཏུངས་པའི་ལྷག་ཀྱང་རང་གིས་ལོངས་སྤྱད་པར་བྱའོ།",
    "འགྲོ་བའི་རེ་སྐོང་ཡིད་བཞིན་རིན་ཆེན་དང་",
    "མངྒ་ལཾ། ། དཔལ་དུས་ཀྱི་འཁོར་ལོའི་རྒྱུད་ལས་གསུངས་པའི་ཛམྦྷ་ལ་ལྗང་གུའི་སྒྲུབ་ཐབས་རྗེས་གནང་མན་ངག་དང་བཅས་པ་བཞུགས་སོ། ། ན་མོ་གུ་རུ་ཤྲཱི་ཛཾ་བྷ་ལཱ་ཡ།",
    "འདབ་མ་རྣམས་ལ་གསེར་ལས་སྐྱེས་པའམ་དངུལ་ལས་སྐྱེས་པའི་ལྷ་མོ་བརྒྱད་དེ་ཆུ་སྐྱེས་མཆོག་སྦྱིན་ཕྱག།",
    "རྒྱལ་པོ་རབ་དགའི་ཡིད་ཀྱིས་གསེར་འགྱུར་མཁན་རྣམས་དག་གིས་སྲུང་བའི་དོན་དུ་ཆུ་ནི་རབ་སྦྱིན་བྱ།",
    "དེ་བཞིན་དུ་འདབ་མ་རྣམས་ལ་གསེར་ལས་སྐྱེས་པའམ་དངུལ་ལས་སྐྱེས་པའི་གནོད་སྦྱིན་མོ་བརྒྱད་རྣམས་ཏེ་པདྨ་དང་མཆོག་སྦྱིན་གྱི་ཕྱག་གོ།",
    "འདིར་གལ་ཏེ་ཛམྦྷ་ལ་དངུལ་ལས་སྐྱེས་པ་ཡིན་ན་དེའི་ཚེ་གནོད་སྦྱིན་མོ་རྣམས་གསེར་ལས་སྐྱེས་པའོ།",
    "གང་གི་ཚེ་ཛམྦྷ་ལ་གསེར་ལས་སྐྱེས་པ་ཡིན་ན་དེའི་ཚེ་གནོད་ཡིན་མོ་རྣམས་དངུལ་ལས་སྐྱེས་པའོ།",
    "དེ་བཞིན་དུ་གང་གི་ཚེ་གསེར་གྱི་པདྨ་ཡིན་པ་དེའི་ཚེ་དངུལ་གྱི་སྣོད་དོ།",
    "གནོད་སྦྱིན་མོ་རྣམས་དེ་བཞིན་ཉིད་དོ།",
    "གར་གྱི་སྟབས་སམ་རོལ་པའི་སྟབས་ཀྱིས་བཞུགས་པའི་བརླ་གཡོན་པའི་སྟེང་དུ་ལྷ་མོ་སྒེག་མོ་ཕྱག་གཡས་པས་ཡབ་ལ་འཁྱུད་པའི་ནུ་མ་ལ།",
    "ལྟེ་བ་ལ་ཛམྦྷ་ལ་དང་ནོར་རྒྱུན་མ་དག་གི་ས་བོན་ཧཾ་ཧའོ།",
    "དེ་བཞིན་དུ་ཤར་གྱི་ལྷ་མོའི་ཧི་དང་།",
    "རེག་བྱ་རྡོ་རྗེ་མ་དང་།",
    "གོས་དཀར་མོ་དང་།",
    "དེ་ནས་ཨོཾ་ཛམྦྷ་ལ་ཛ་ལེནྡྲ་ཡ་སྭཱ་ཧཱ་ཞེས་པའི་སྔགས་འདིས་ཆུ་ཁྱོར་བ་བརྒྱ་རྩ་། བརྒྱད་སྦྱིན་པར་བྱའོ།",
    "རབ་དགའི་ཡིད་ཀྱིས་གསེར་འགྱུར་མཁན་རྣམས་དག་གིས་ནི་རོ་བསྲུང་བའི་དོན་དུ་ཆུ་སྦྱིན་པར་བྱ་སྟེ་སྲུང་བའི་ཆོ་ག་འདི་ཡིས་འབྱུང་པོའི་མགོན་པོ་དང་ཀླུའི་མགོན་པོ་སྟེ་ཀླུའི་རྒྱལ་པོས་རོ་ནི་འཕྲོག་པར་མི་འགྱུར་རོ།",
    "རི་མོར་བྲིས་པས་ཀྱང་རུང་སྟེ།",
    "ལས་ལྷ་མོ་ནོར་རྒྱུན་མ་སྔོན་མོ་ཕྱག་གཡས་མཆོག་སྦྱིན་གྱི་ཕྱག་རྒྱ་དང་ལྷན་ཅིག་ཡབ་ལ་འཁྱུད་པ།",
    "འདབ་མ་བརྒྱད་ལ་ཤར་དུ་ཧིཾ་ལས་ཟླ་ཤེལ་མ་མེར་ཧཱིལས་རབ་བཟང་མ་གཉིས་ནག་མོ།",
    "བདེན་བྲལ་དུ་ས་་ལས་སྦས་མ་གཉིས་དམར་མོ།",
    "བྱང་ཤར་དུ་ཧཱུྃ་ལས་དབྱངས་ཅན་མ་གཉིས་དཀར་མོ།",
    "ནུབ་ཏུ་ཧླྀཾ་ལས་སྦྱིན་བཟང་མོ་། ནུབ་བྱང་དུ་ཧླཱྀཾལས་ལྷ་མོ་དཔལ་གཉིས་སེར་མོ།",
    "དེ་ལྟར་གནོད་སྦྱིན་མོ་དགུ་ཆར་ཡང་གཡས་མཆོག་སྦྱིན་གྱི་མཐིལ་ནས་འདོད་རྒུའི་ཆར་འབེབས་ཤིང་།",
    "རིགས་དྲུག་གིས་སོ་སོར་རྒྱས་གདབ།",
    "གཏོར་མ་ཡང་གསོལ་བར་མོས་ལ།",
    "སྒྲོལ་མ་རེག་བྱ་རྡོ་རྗེ་མ།",
    "གོས་དཀར་མོ་དང་མཱམ་ཀཱི།",
