    "རྒྱལ་པོའི་ཕྱག་རྒྱ་མཆོག་གི་རྟགས།",
    "རྒྱལ་པོའི་ཕྱག་རྒྱ་མཆོག་གི་རྟགས།",
    "དེ་དག་གི་དོན་སླར་དགྲོལ་བ་ནི།",
    "ཞེས་པ་ནི་གང་གིས་ཀྱང་འདའ་བར་བྱ་བའི་ཡུལ་མ་ཡིན་པའོ།",
    "དེ་དག་གི་དོན་སླར་དགྲོལ་བ་འདིར་བསྔགས་ཤིང་གསང་སྟེ་སྨྲས་པས་ངེས་པའི་ཚིག་དང་སྦྱར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "གང་གི་རིག་མཆོག་སྒྲུབ་པའི་ཕྱིར།",
    "གང་གི་རིག་མཆོག་བསྒྲུབ་པའི་ཕྱིར།",
    "འཇིག་རྟེན་དང་འཇིག་རྟེན་ལས་འདས་པའི་དངོས་གྲུབ་ནི་དམ་པ་སྟེ་སྐུ་མཆོག་གི་དངོས་གྲུབ་མི་གནས་པའི་མྱ་ངན་ལས་འདས་པའི་གོ་འཕང་ཐོབ་པ་དེ་ཡོད་པའོ།",
    "རིག་པ་སོ་སོའི་བྱེ་བྲག་གི་སྒོ་ནས་ཆོ་གའི་ལྷག་མ་ཡན་ལག་གི་ཆོ་ག་རྣམས་ཀྱང་སོ་སོར་ཕྱེ་ནས་བསྟན་ཏེ།",
    "གང་གི་ངོ་བོར་ཡང་མ་གྲུབ་ཅིང་གང་ལྟར་ཡང་མི་དམིགས་པར་གཏན་ལ་ཕབ་ནས།",
    "དེ་དག་གི་རང་གི་མཚན་ཉིད་མི་རྟག་པ་དང་།",
    "དེའི་སྒྲུབ་ཐབས་སུ་གྱུར་པ་གཞུང་འདི་ཉིད་ལས་ཇི་སྐད་དུ་བསྟན་པའི་དོན་དེ་དག་ལ་མོས་ཤིང་ཉམས་སུ་ལེན་པ་ནི་ཐབས་ཀྱི་ཆོ་ག་སྟེ།",
    "རྒྱལ་བའི་སྲས་རྣམས་ཀྱི་སྐུ་དང་གསུང་དང་ཐུགས་ཀྱི་ཕྲིན་ལས་རྒྱ་ཆེན་པོ་ལ་མོས་པར་བྱས་པ་ཡིན་ཏེ།",
    "སྔགས་དང་རིགས་སུ་བརྗོད་པའི་ལྷ་རྣམས་སྒྲུབ་པའི་རྒྱུ་ཡན་ལག་གི་ཆོ་ག་ཚོགས་དང་།",
    "ད་ནི་ཞི་བ་ལ་སོགས་པའི་སྦྱིན་སྲེག་གི་ལས་ཀྱི་དངོས་གྲུབ་སྒྲུབ་པའི་ཐབས་བསྟན་ཏོ།",
    "འདིར་ནི་ཞི་བ་ལ་སོགས་པའི་ལས་གྲུབ་པའི་སྦྱིན་སྲེག་གི་ཆོ་ག་ཞེས་པ་ནི།",
    "རྒྱུད་གཞན་རྣམས་ལས་སོ་སོའི་སྦྱིན་སྲེག་གི་མཚན་ཉིད་རྒྱས་པར་སྟོན་པའོ།",
    "དེ་བས་དེ་དག་ཐམས་ཅད་ལས་བྱུང་བའི་སྦྱིན་སྲེག་གི་ལས་རྣམས་འདིར་བསྡུས་ན།",
    "སྔགས་སྤྱོད་པའི་རྣལ་འབྱོར་པ་རྣམས་སྦྱིན་སྲེག་གི་ལས་ལ་མགོ་རྨོངས་པར་མི་འགྱུར་བའི་ཕྱིར་རོ།",
    "མོད་ཀྱི་ཞེས་པའི་སྒྲས་དེ་ཁོ་ན་ཉིད་བསྡུས་པའི་རྒྱུད་འདིར།",
    "འདིས་འདི་ལྟར་བྱས་པས་འགྲུབ་པར་འགྱུར་བ་བསྟན་མོད་ཀྱི།",
    "གཅིག་གིས་ཀྱང་བྱར་རུང་བར་སྟོན་པ་སྟེ་མཁས་པ་རྣམས་འཆད་དོ་ཞེས་པ་ནི་རྒྱུད་ཀྱི་དོན་དང་ལས་ཀྱི་བྱེ་བྲག་ལ་མཁས་པའི་སློབ་དཔོན་རྣམས་ཀྱིས་དེ་ལྟར་གསུངས་པས་ན།",
    "གང་གི་ཕྱིར་དེའི་ཕྱིར་རམ།",
    "བདག་གི་ཐོར་ཚུགས་དེ་བཞིན་གཤེགས།",
    "བདག་གི་གཙུག་ཏོར་དེ་བཞིན་གཤེགས།",
    "བུད་མེད་སྡུག་དང་ལྷན་ཅིག་ཏུ།",
    "རང་གི་བསྙེན་པར་བྱེད་པའི་ལྷའི་ཕྱག་རྒྱར་གནས་པ་ལ་བྱའོ།",
    "སྦྱིན་སྲེག་གི་ལས་བརྩམ་པར་བྱའོ།",
    "དེ་ལྟར་མ་གྱུར་པའི་ཁ་ལག་ཙམ་པ་དག་གིས་རང་འདོད་༴",
    "རང་གི་ལྷ་སེམས་དཔའ་ཆེན་པོ་གང་ཡང་རུང་བ་བསྒོམས་ནས་སྦྱིན་སྲེག་བྱ་བ་ཡང་རིགས་པར་༦གསུངས་ཏེ།",
    "གདུལ་བ་རྣམས་ཁ་ཅིག་གིས་དེའི་དོན་ཇི་ལྟ་བ་དེ་བཞིན་དུ་རྟོགས་པ་གཟིགས་ནས་ཞེས་པ་ནི།",
    "དེ་དག་གི་དོན་ནི་བཀྲོལ་ཟིན་པས་དེ་ལས་རིག་པར་བྱའོ།",
    "རང་གི་ལྷ་མཉེས་པར་བྱ་བའི་ཕྱིར།",
    "ཞེས་པ་ནི་དེ་ལྟར་འདིར་ཆགས་པ་ཞེས་སྨོས་པའི་དོན་དེ་ལྟར་རིག་པར་བྱ་བའི་ཕྱིན་ཅི་ལོག་གི་འདོད་ཆགས་ཡིན་པར་མ་བཟུང་ངོ་ཞེའོ།",
    "བུད་མེད་ལ་ནི་ཆགས་ནས་སུ།",
    "རང་གི་ལྷ་མཉེས་པར་བྱེད་པའི་ལྷའི་ཕྱག་རྒྱ་ཆེན་པོ་ལ་ཆགས་པ་སྟེ།",
    "དངོས་སུ་བུད་མེད་ལ་ཆགས་པ་མ་ཡིན་པས་ན།",
    "ཕ་རོལ་ཕྱིན་པ་དྲུག་གི་མཚན།",
    "སྦྱིན་པ་ལ་སོགས་པ་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་གི་མཚན་ཉིད་ཇི་ལྟ་བ་བཞིན་དུ་སྤྱོད་པའོ།",
    "གང་རྣལ་འབྱོར་པ་དེ་སྒྲུབ་པར་བྱེད་པའི་རང་གི་ལྷའོ།",
    "ཆགས་པ་ཆེན་པོ་ནི་རང་གི་ལྷ་བསྟེན་ཅིང་གོམས་པ་དང་འདྲིས་པར་བྱེད་པའོ།",
    "སྦྱིན་སྲེག་གི་ལས་ནི་ཆོ་ག་ཇི་ལྟ་བ་བཞིན་དུ་ཤར་ཕྱོགས་སུ་བལྟས་ལ་སྦྱིན་སྲེག་བྱ་བ་ལ་སོགས་པ་བཅོམ་ལྡན་འདས་ཀྱིས་རྒྱུད་ལས་ཇི་སྐད་གསུངས་པ་བཞིན་དུ་སློབ་དཔོན་གྱིས་ཞེས་སྟོན་ཏོ།",
    "ནམ་གང་འདོད་པའི་དངོས་གྲུབ་སྒྲུབ་པ་དེའི་ཚེ་རྡོ་རྗེ་སློབ་དཔོན་གྱིས་སྦྱིན་སྲེག་གི་ལས་སྤྱད་དམ་བརྩམ་པར་བྱ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "གོང་དུ་གང་གི་ཕྱིར་ཞེས་གསུངས་པ་དེའི་ཕྱིར་ཞེས་པའི་དོན་དུ་དགོངས་པའི་ཚིག་གོ།",
    "དེ་ལ་སྦྱིན་སྲེག་གི་ཡན་ལག་རྣམས་ནི་ཞེས་པ་ནི།",
    "ཞི་བ་ལ་སོགས་པའི་སྦྱིན་སྲེག་གི་སྒོ་ནས་གང་དང་གང་འདོད་པའི་ལས་དེ་དང་དེ་སྒྲུབ་པ་ལ་འགྲུབ་པར་འགྱུར་བའི་རྒྱུ་རྣམས་ལ་ནི་སྦྱིན་སྲེག་གི་ཡན་ལག་ཅེས་བྱ་སྟེ།",
    "མར་དང་བུད་ཤིང་ལ་སོགས་པའི་། ཞེས་གསུངས་པ་ཡིན་ཏེ།",
    "དེ་ལ་སྦྱིན་སྲེག་གི་ལྷ་ནི་རྣམ་པ་གསུམ་སྟེ་ཞེས་པ་ནི་སྦྱིན་སྲེག་བྱ་བའི་ལྷ་རྣམས་ཀྱི་གྲངས་ནི་སྤྱིར་རྣམ་པ་གསུམ་ཡོད་པར་རིག་པར་བྱ་ཞེས་བྱའོ།",
    "གསུམ་པ་ནི་སྦྱིན་སྲེག་གི་ལྷ་གསུམ་པ་སྟེ་འཇིག་རྟེན་པའི་མེ་ལྷ་རྣམས་ཀྱི་ནང་ན་མིང་མི་ཏ་ཞེས་བྱ་བ་དེ་ཡིན་ཏེ།",
    "གཞན་དག་ན་རེ་འོ་ན་སྦྱིན་སྲེག་གི་དཀྱིལ་འཁོར་དུ་ནི་ཡེ་ཤེས་ཀྱི་ལྷ་དང་འཇིག་རྟེན་པའི་ལྷ་ལ་འདིར་སོགས་པ་འགྲོ་བ་རིགས་དྲུག་གིས་བསྡུས་པ་ཐམས་ཅད་ཀྱང་འབྱུང་ན།",
    "སྦྱིན་སྲེག་གི་དགང་གཟར་ལ་སོགས་པ་ཞེས་པ་ནི།",
    "ཟབས་སུ་སོར་གཅིག་ཅེས་པ་མཐེ་བོའི་སེན་མོ་ནུབ་པ་ཙམ་དུ་བྱའོ།",
    "རྣམ་གཅིག་བྱ་རོག་གི་མཇུག་སྒྲོ་བཞིན་དུ་བྱས་པའི་དཀྱིལ་འཁོར་དུ་ཁ་ཕྲ་སྦོམ་རན་པར་བཏོད་པ་ལས་མཆུ་ཕྲ་མོའི་སྲིད་དུ་ཚད་སོར་གཅིག་ཡོད་པར་བྱའོ།",
    "ཞི་བའི་སྦྱིན་སྲེག་གི་དགང་གཟར་ཟླུམ་པོ་སྟེ་ཞེས་པ་ནི།",
    "དེ་ལྟར་བསྟན་པའི་དགང་གཟར་ཆེ་ཆུང་གི་ཚད་རབ་འབྲིང་རྣམ་གསུམ་དུ་ཕྱེ་ནས་བསྟན་པ་འདི་དག་གོ།",
    "མཛུབ་མོའི་སོར་ཏེ་མཛུབ་མོའི་བབ་ཙམ་མོ།",
    "ཡམ་ཤིང་དང་བསྲེག་ཤིང་གི་ཁྱད་པར་དང་།",
    "སྲེག་རྫས་དང་མཆོད་རྫས་ཀྱི་སོ་སོའི་བྱེ་བྲག་གིས་བསག་ཅིང་བྱིན་གྱིས་བརླབས་པ་དང་།",
    "མངོན་སྤྱོད་ཀྱི་ལས་ནི་ཚེས་ཉི་ཤུ་གསུམ་དང་ཉི་ཤུ་དགུ་ལ་མགོ་གཟུགས་ལ་བརྩམ་མོ།",
    "རྒྱས་པའི་ལས་བྱ་བའི་གནས་ནི་རིའི་རྩེ་མོའམ།",
    "འབྲས་བུ་དང་ལྡན་པའི་ནགས་ཚལ་ལམ་བ་ལང་གི་ལྷས་སམ།",
    "ལྷ་ཁང་གི་གནས་སམ།",
    "ཞིང་གི་ལྷ་ཁང་ངམ།",
    "མ་མོའི་གནས་སམ།",
    "གུ་ལང་གི་གནས་ལ་སོགས་པར་བྱ་བར་ཤིས་སོ།",
    "གཟའ་ལག་གི་ཉིན་པར་བརྩམ་མོ།",
    "རྒྱུ་སྐར་གྲོ་བཞིན་དང་མོན་གྲུ་དང་།",
    "མིག་དམར་གྱི་ཉིན་པར་བརྩམ་མོ།",
    "མིག་དམར་གྱི་ཉིན་པར་བརྩམ་མོ་། འམ་ཞེས་པའི་སྒྲས་ནི་དེར་མ་བཅད་པ་ཡིན་ལ།",
    "གནས་དེ་དག་གི་ཚོགས་པ་དང་ལྡན་པ་ཡང་ཉེས་པ་མེད་ལ།",
    "དེ་ལ་རེ་ཞིག་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོར་གསུངས་པ་ཞེས་པ།",
    "དེ་ལ་རེ་ཞིག་སྔར་སྨོས་པ་ཉིད་ཀྱིས་ཞེས་པ་ནི།",
    "ལས་རྣམ་པ་བཞི་བཛྲ་དྷརྨ་ཧྲཱི་ཞེས་གསུང་གི་བདག་ཉིད་པདྨའི་རིགས་ཀྱི་སྔགས་བཟླས་བརྗོད་བྱས་པས་བཏབ་པའི་ཆུས་མེ་ལ་བསང་གཏོར་བྱས་པ་ཐབ་ཏུ་བཅུག་ལ།",
    "རྡོ་རྗེ་མེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ནི།",
    "གཟུང་བ་འདི་ནི་མེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་སྟེ།",
    "རྡོ་རྗེ་མེའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་བཅིང་བར་བྱའོ་། རྡོ་རྗེའི་དམ་ཚིག་གི་སྔགས་ཧཱུཾ་གི་བར་དུ་བཅུག་པས་ཞེས་པ་ནི།",
    "སྐྲའི་ཐོར་ཚུགས་སེར་པོར་འདུག་པ་ལུས་ཡོན་པོ་ལ་ལས་རྣམ་པ་གང་བྱེད་པ་དང་རྗེས་སུ་མཐུན་པའི་ཁ་དོག་དང་ལྡན་པར་བསྒོམ་མོ།",
    "ཡམ་སྲེག་ཤིང་གི་ཐོར་ཏོ་གཉིས་མར་ལ་བཏགས་པ་ཞེས་པ།",
    "བེ་ཏང་༤ཀ་ཏ་ཨ་མྲ་དང་།",
    "མཆོད་སྦྱིན་དག་གིས་ལྗོན་ཤིང་ངམ།",
    "ཡམ་ཤིང་སྐྱེད་མོས་ལས་སྐྱེས་རློན།",
    "ཞེས་གསུངས་པའི་ཡམ་ཤིང་ཚད་དང་ལྡན་པ་ལ་ཤིང་གི་ཐོར་ཏོ་གཉིས་མར་ལས་བཏགས་པ་གསུམ་བསྲེས་ལ།",
    "གུང་མོ་དང་སྲིན་ལག་དང་མཐེ་བོས་སམ་ཞེས་པ་དེའི་རྟིང་ལ་ཏིང་དང་སྤྲུས་པའི་སྲེག་བླུགས་དག་གུང་མོ་དང་སྲིན་ལག་དང་མཐེ་བོང་གསུམ་བསྡུས་པས་སམ།",
    "བདག་ལ་ཇི་ལྟར་བྱིན་གྱིས་བརླབ་པ་རང་གི་ལྷའི་དམ་ཚིག་སེམས་དཔའ་ཞེས་པ་ནི།",
    "སྭཱ་ཧཱའི་མཐར་དབུལ་ལོ་ཞེས་པ་སྔགས་ཀྱི་མཇུག་ལ་སྭཱ་ཧཱ་ཞེས་བརྗོད་པ་དང་ལྡན་པའི་ཚིག་གིས་དབུལ་བ་སྟེ།",
    "ཕྱག་རྒྱ་བཞི་པའམ་ཕྱག་རྒྱ་གཅིག་པའི་ལྷའི་སྦྱིན་སྲེག་གི་ཚུལ་ནི་སྦྱིན་སྲེག་ཐམས་ཅད་ཀྱི་ཆོ་ག་ཞེས་བྱའོ།",
    "མཛུབ་མོ་བསྒྲེང་བའོ།",
    "དེ་ལྟར་ཉི་མ་རེ་རེ་ཞིང་མཚམས་ཀྱི་རིམ་པ་ཉིད་ཀྱིས་ཞེས་པ་ནི་ཉིན་པར་བཟླས་བརྗོད་ཀྱི་མཚམས་ཏེ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་དག་གི་མཚན་མ་བྱུང་ན།",
    "ཚེ་འདི་ཉིད་ལ་བྱུང་གི་བར་དུ་སྦྱིན་སྲེག་བྱའོ་ཞེས་པ་ནི་ཕྱིའི་དུས་སུ་མི་བསྡད་དེ་ཅི་སྲིད་མཚན་མ་དེ་ལྟ་བུ་དག་བྱུང་གི་བར་དུ་སྦྱིན་སྲེག་གི་ཆོ་ག་འདི་དག་ཅེས་པ་ནི།",
    "བུ་དང་བུ་མོ་དང་ནོར་དང་འབྲུ་རྣམས་རྒྱས་ཤིང་འཕེལ་བར་བྱེད་པའོ།",
    "བསྟན་པའི་སྦྱིན་སྲེག་གི་ཐབ་འདི་དག་ནི།",
    "རྡོ་རྗེ་རྩེ་མོའི་རྒྱུད་ལས་ཕལ་ཆེར་དེ་རྣམས་ཀྱི་ཆེ་ཆུང་ཇི་ཙམ་དུ་བྱ་བའི་ཚད་དེས་གསལ་པོར་མི་འབྱུང་སྟེམི་སྣང་བའི་ཕྱིར་ནི་ཚད་ངེས་པར་བསྟན་པས་ཇི་ཙམ་འདོད་པ་བཞིན་བྱ་བར་བསྟན་ཏོ།",
    "ཐབ་དེ་དག་གི་དབྱིབས་ཀྱི་ཁྱད་པར་ཞེས་པ་ནི།",
    "བུ་དང་བུ་མོ་དང་ནོར་ལ་སོགས་པ་རྒྱས་ཤིང་འཕེལ་བར་བྱེད་པ་ནི་རིགས་རྒྱས་པ་སྟེ།",
    "སྔ་མ་ལྟ་བུའི་ཤིང་གིས་མེ་སྦར་རོ།",
    "སྲེག་རྫས་ཀུ་ཤའི་ཆུན་པོ་དག་རེ་རེ་ནས་ཡུངས་ཀར་གྱི་མར་ལ་སྦགས་ཤིང་སྦྱིན་སྲེག་བྱ་བའོ།",
    "དེ་ལ་སྦྱིན་སྲེག་གི་ལས་བཅུ་དྲུག་པོ་འདི་ཞེས་པ་ནི།",
