    "མདུནགཡོ་བྱད་ཤར་དུ་སྟོབས་ལྡན་ནག་པོ་ལ་དམོད་པ་དྲག་སྔགས་ཀྱི་ཚོགས་ཀྱིས་བསྐོར་བ།",
    "རེས་འགའ་ཅི་ཡང་མི་དྲན་པ་འདུག་བ་ལྷགནསཔ་ཟེར་རོ།",
    "རེས་འགའགསལ་ཞིང་ངེས་ཤེས་སྐྱེ།",
    "རྣམསྣང་མངོན་བྱང་གི་རྒྱུད་ལས།",
    "སེམས་ལ་ང་རྒྱལ་སྐྱེས་པ་དེ་ལྷ་ཕམ་ལྟུང་གི་རྒྱུ་ཡིན།",
    "འདི་ལྟར་མིག་གི་ཡུལ་དུ་ཕྱུང་བ་ཡི",
    "ཚིག་གི་དོན།",
    "ཐུགས་རྗེས་གཟིགས་ལ་བྱིན་གྱིས་བརླབཏུ་གསོལ",
    "ཕྱག་གཉིས་མཉམ་གཞག་གི་སྟེང་དུ་ཚོའི་བུམ་པ་འཛིནཔ་རྡོ་རྗེ་སྐྱིལ་ཀྲུང་གིས་བཞུགས་པའི་པང་དུ་ཡུམ་མནར་བདམར་མོ་གཅེར་བུ་མདའ་ཚོ་དུས་འཛིན་པས་འཁྱུད་པ།",
    "ཁའ་འགྲོ་དམར་མོ་ལ་འཁྱུད་པ།",
    "གསུང་གི་དམ་ཚིག་ཉམས་ཆག་བསྐང་ནས་འདུ་ཤེས་ཀྱི་ཕུང་པོ་དང་དོད་ཀྱི་ཁམས་པདྨ་ཐོད་ཕྲེང་ཚུལ་ཡབ་ཡུམ་གྱི་ངོ་བོར་གྱུར།",
    "ཡན་ལག་གི་ངམ་ཚིག་ཉམས་ཆག་བསྐང་།",
    "རངགི་དཔྲལ་བརཐིམ་པས་གཏི་མུག་གི་སྒྲིབ་པ་དག་ནས་དུད་འགྲོའི་སྐྱེ་སྒོ་ཆོད།",
    "རང་གི་མགྲིན་པར་ཐིམ་པས་འདོད་ཆགས་ཀྱི་སྒྲིབ་པ་དག་ནས་ཕྱི་བགས་ཀྱི་སྐྱེ་སྒོ་ཆོད།",
    "ལྟེ་བ་ནས་འོད་ཐེར་སེར་པོ་བྱུང་ནས་རངགི་ལྟེ་བར་ཐིམ།",
    "རང་གི་གསང་གནས་སུ་ཐིམ་པས་ཕྲག་དོག་གི་སྒྲིབ་པ་དག་དུས་ཡིན་གྱི་སྐྱེ་སྒོ་ཆོད།",
    "འདིརམིག་གི་ཡུལ་དུ་སྣང་བ་ཡི",
    "མཆོག་དང་ཐུནམོང་དངོས་གྲུབ་ཐོབ།",
    "མཆོག་དང་ཐུནམོང་དངོས་གྲུབ་ཏུ།",
    "དེལ་བདག་གིས་དངོས་གྲུབ་སྟེར།",
    "རེ་འགྲེའབ་པ།་",
    "༡༦༥རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་དུ་བསྒྲུབ་པའི་ཡོ་བྱད་དང་ཆོ་ག་བ་།",
    "༡༦༡༤རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་གི་དངོས་གྲུབ་ཀྱི་ཆོ་ག་རྒྱས་པའི།",
    "༡༦ཞེང་༣རིགས་ཐམས་ཅད་ཀྱི་ཐུན་མོང་པའི་སྐུ་དང་གསུང་དང་ཐུགས་རྡོ་རྗེའི་ཕྱག་རྒྱ་བསྒྲུབ་པའི་རྒྱུད་ཀྱི་འགྲེལ་པ།་",
    "༡༦༤༦དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པའི་རིགས་ཐམས་ཅད་ཀྱི་གསུང་གི་གསང་བའི་ཕྱག་རྒྱ་བསྒྲུབ་པའི་རྒྱུད་ཀྱི་འགྲེལ་པ།",
    "༡༦༩བསྡུར་འབྲས་རེའུ་མིག་༡༧༥ཚེདཀར་ཆག་གི་ཟུར་མཆན།",
    "འདི་སྐད་བདག་གིས་ཐོས་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་འདིའི་བརྗོད་པར་བྱ་བ་དང་།",
    "འདིའི་འདི་སྐད་བདག་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་རྣམ་པར་སྣང་མཛད་དང་།",
    "གང་གི་མིང་བརྗོད་པ་དེར་ཀྱེ་ཞེས་བརྗོད་པ་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་སློབ་དཔོན་གྱི་ལས་རྣམས་དང་།",
    "དོན་གྲུབ་པ་ལ་སོགས་པ་ཡང་སྒྲུབ་པ་པོས་བདག་ལ་བྱིན་གྱིས་བརླབས་པ་ལ་སོགས་པས་རང་གི་ལྷའི་རྣལ་འབྱོར་བསྐྱེད་ལ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བ་དང་།",
    "རྡོ་རྗེ་དྲིལ་བུ་བསྐྱོད་པའོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་བསྟན་༧ཏོ།",
    "དེ་བསྒྲུབ་པར་བྱ་བའི་ཆོ་ག་རྒྱས་པའོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་༩་བསྟན་ཏོ།",
    "ཆོ་ག་ཇི་ལྟ་བས་རང་གི་ལྷའི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིངས་ལ་མདུན་དུ་རྡོ་རྗེ་དབབ་པ་ཡང་དག་པར་བསྐྱེད་དེ།",
    "རང་གི་ལྷའི་ཕྱག་རྒྱ་ཆེན་པོའི་ང་རྒྱལ་རྣམ་པར་བསྒོམས་ནས་ཕྱག་རྒྱ་དེ་ཡང་རང་གི་ལྷའི་སྐུར་བསམས་ལ།",
    "དེ་ལས་རང་གི་ལྷའི་ང་རྒྱལ་བསྐྱེད་ལ་ཡེ་ཤེས་སེམས་དཔའ་རང་གི་ལུས་ལ་ཇི་ལྟ་བ་བཞིན་དུ་བཅུག་སྟེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེ་སེམས་དཔས་གསུངས་སོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ཆོ་ག་བསྟན་པ་ཡིན་ནོ།",
    "དངོས་གྲུབ་འཐོབ་ཅེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་འདིའི་ཅི་འདོད་པའི་བཟླས་པའི་ཆོ་ག་སྟོན་ཏོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་གཞུང་གིས་སྟོན་ཏོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ནས་རྡོ་རྗེ་འབེབས་པའི་བར་གྱིས་ཐུརང་གི་ཕྱག་རྒྱ་བཞི་པོ་དགྲོལ་བ་ཛྭནི་རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱས་གནས་ཇི་ལྟ་བ་བཞིན་དུ་བྱའོ་ཞེས་བྱ་བའི་དོན་འདི་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་གཙོ་བོར་གྱུར་པ་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་བསྡུས་པའི་དོན་བསྟན་པར་བྱའོ།",
    "ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་དཀྱིལ་འཁོར་གྱི་ཀྱེརྒྱལ་པོ་མཆོག་གི་ཏིང་ངེ་འཛིན་ཏོ།",
    "རྡོ་རྗེ་གསང་བའི་ཕྱག་རྒྱའི་ཡེ་ཤེས་བསླབ་བོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་སློབ་དཔོན་གྱི་ལས་རྣམས་དང་།",
    "བཛྲ་གུ་ཧྲ་ས་མ་ཡ་ཧཾ་ཞེས་བྱ་བའི་བར་གྱི་མེགཞུང་གིས་སྟོན་ཏོ།",
    "ཞེས་བྱ་བའི་བར་ཀྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "རྟག་པའི་བདག་པོས་གཏང་ང་རེ།",
    "ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "དེ་བཞིན་དུ་དེ་རྣམས་ཀྱི་གོ་ཆ་བཅིང་བར་བྱས་ལ་ཨོཾ་བཛྲ་གུ་ཁྱ་ས་མ་༥ཡ་ཏ་ལ་ས་ཞེས་བྱ་བས་དེ་རྣམས་མཉམ་པའི་ཐལ་མོ་གསུམ་གྱིས་མཉེས་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཨོཾ་གུ་ཏྱ་ས་མ་ཡ་༦ཏ་ལ་ས་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རྡོ་རྗེ་ཕྲ་མོའི་ཡེ་ཤེས་ཀྱི་ངང་ཞེས་བྱ་བ་ནས་བརྩམས་ཏེ།",
    "རང་གི་སེམས་ལས་སུ་རུང་བར་༡བྱ་བའི་ཕྱིར་ཕྱག་རྒྱ་ཆེན་པོའི་ཡེ་ཤེས་བསླབ་པོ་ཞེས་བྱ་བ་ནས་བརྩམས་ཏེ།",
    "ལས་རྣམས་ཐམས་ཅད་དེས་གྲུབ་བོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "གཞན་གྱིས་ལྟ་སྨོས་༢ཀྱང་ཅི་དགོས་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་དང་།",
    "ཀརྨ་བཛྲ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་བསྟན་ཏོ།",
    "ལས་ཀྱི་མཆོག་གི་ཏིང་ངེ་འཛིན་ལྔ་པོ་གསུངས་པ་ཡིན་ནོ།",
    "དཀྱིལ་འཁོར་སྟོན་ཏོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་དང་།",
    "དངོས་གྲུབ་ཐམས་ཅད་ཀྱང་འགྲུབ་བོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་བསྟན་པ་ཡིན་ནོ།",
    "ལོ་གཅིག་གིས་མཆོག་འགྲུབ་བོ་ཞེས་བྱ་བའི་༦བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "བཛྲ་སཏྭ་ཞེས་བྱ་བའི་བར་ཀྱི་གཞུང་གིས་ནི།",
    "འི་དཀྱིལ་འཁོར་གྱི་རྒྱལ་པོ་མཆོག་གི་ཏིང་ངེ་འཛིན་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་ཐམས་ཅད་ཀྱི་གསང་བའི་དམ་ཚིག་ཅེས་བྱ་བ་ནས་དམ་ཚིག་གི་སྡོམ་པ་སྦྱིན་པར་༥བྱའོ་ཞེས་བྱ་བའི་གཞུང་གིས་སྟོན་ཏོ།",
    "རྡོ་རྗེ་དབྱེངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་ཇི་སྐད་གསུངས་པའི་དངོས་གྲུབ་རྣམས་ཀྱང་རང་གི་ལྷའི་ཕྱག་རྒྱ་བཞི་དང་ལྡན་པའི་ལྷའི་རྣལ་འབྱོར་བྱས་ནས་བསྒྲུབ་པར་བྱའོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།་",
    "དེ་ནས་རྡོ་རྗེ་སེམས་དཔའི་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་བཞི་བཅིང་བ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བའི་གཞུང་གིས་སྟོན་ཏོ།",
    "དངོས་གྲུབ་ཀྱང་དེ་བཞིན་ནོ་ཞེས་བྱ་བ་ལ་སོགས་པའི་གཞུང་གི་དོན་ནི་སྔ་མ་ཁོ་ན་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་༤བཀའ་བསྒོ་བའི་རྗེས་སུ་འཇུག་པའི་མཚན་ཉིད་དམ་ཚིག་གི་ཕྱག་རྒྱའི་རང་བཞིན་རྡོ་རྗེ་རིགས་ཀྱི་བསྡུས་པའི་དོན་བརྗོད་པར་བྱ་སྟེ།",
    "ཅེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི།",
    "འདིའི་རབ་ཏུ་དབྱེ་བ་དེའི་རྗེས་སུ་འཇུག་པའི་མཚན་ཉིད་དམ་ཚིག་གི་ཕྱག་རྒྱའི་དབྱེ་བ་བཞི་བརྗོད་པར་བྱ་སྟེ།",
    "ཞེས་༧བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་རྡོ་རྗེའི་རིགས་སྤྲུལ་པའི་ཕྱིར་དང་།",
    "ཡང་བཀའ་ནོད་ཅིང་བཞུགས་སོ་ཞེས་བྱ་བའི་བར་གྱེ་གཞུང་གིས་ནི་རྡོ་རྗེ་རིགས་ཀྱི་བདག་པོ་སྤྲུལ་པ་དང་།",
    "དམ་ཚིག་ཀྱང་ལོང་ཤིག་ཅེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི།",
    "དེ་ནས་ཕྱག་ན་རྡོ་རྗེ་ཁྲོ་བོ་ཆེན་པོའི་རྒྱལ་པོ་ཞེས་བྱ་བ་ནས་ལྟ་ཞིང་ལངས་སོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་ཁམས་གསུམ་ཀྱི་འཁོར་ལོ་བཏུལ་བ་དང་།",
    "ཅེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི།",
    "རང་གི་བཀའ་བསྒོ་བ་ལ་ངེས་པར་སྦྱར་བ་གསུངས་པ་ཡིན་ནོ།",
    "རྒྱ་མཚོ་ཆེན་པོར་ལྟུང་ངོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི།",
    "ངན་སོང་དེ་རྣམས་རང་གི་གནས་སུ་དོང་ངོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི།",
    "རང་གི་བསྒོ་བ་ལ་ངེས་པར་སྦྱར་བར་གསུངས་པ་ཡིན་ནོ།",
    "ངན་སོང་དེ་རྣམས་རྒྱ་མཚོ་ཆེན་པོར་བོར་རོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་ངན་སོང་གསུམ་པོ་དགུག་ཅིང་བཀའ་བསྒོ་བ་དང་།",
    "གཞུང་འདི་དག་གིས་༧རྡོ་རྗེ་ཁྲོ་བོའི་དཀྱིལ་འཁོར་ཆེན་པོའི་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གཉིས་པ་བསྟན་ཏོ།",
    "ཧཱུཾ་ཧཾ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་བསྟན་ཏོ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་དངོས་གྲུབ་རྣམས་ནི་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་དངོས་གྲུབ་རང་གི་ལྷའི་ཕྱག་རྒྱ་བཞིས་རང་གི་ལྷའི་རྣལ་འབྱོར་ཇི་ལྟ་བ་བཞིན་དུ་བསྐྱེད་ལ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བ་དང་།",
    "དེ་ནས་འཇིག་རྟེན་གསུམ་ལས་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོའི་དམ་ཚིག་གི་དེ་ཁོ་ན་ཉིད་ཀྱི་ཕྱག་རྒྱའི་ཡེ་ཤེས་བསླབ་པའོ་ཞེས་བྱ་བ་ནས་བརྩམས་ཏེ།",
    "ཕྱག་རྒྱ་ཐམས་ཅད་ཀྱི་ཆོ་གའོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "སྐད་ཅིག་གིས་ནི་སྡིག་དྲལ་ལོ།",
    "ཞེས་བྱ་བའི་བར་ཀྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "སྒོ་དབྱེ་བའི་མཆོག་ཡིན་ནོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གཉིས་པ་བསྟན་པ་ཡིན་ནོ།",
    "བཛྲ་བནྡྷ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི།",
    "ཧཱུཾ་མ་ནུ་བཛྲ་ཐཱ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "ཁྲོ་བོའི་ལྟ་བས་ཁྲོ་བོ་དང་ལྡན་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "རྡོ་རྗེ་ཇི་ལྟ་བ་བཞིན་དུ་ལག་པ་གཉིས་སུ་བྱིན་ནོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་འདིར་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་དང་།",
    "དེ་ནས་རྡོ་རྗེ་ཁྲོ་བོའི་ཡེ་ཤེས་ཕྲ་མོ་རྣམས་སློབས་ཤིག་ཅེས་བྱ་བ་ནས།",
    "ཧཱུཾ་ཟྀ་༥ད་ཡ་ཨཱ་ཀཱཪྵ་ན་གྲོ་དྷ་པྲ་བེ་ཤ་ཀཱ་ཡོ་ཟྀ་༧ད་ཡ་སྩོནྡ་བིནྡྷ་ཀརྗ་ཀནྟ་༩ཧཱུཾ་ཕཊ་ཅེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "ཆོ་ག་ཇི་ལྟ་བ་བཞིན་དུ་འགྲུབ་པར་འགྱུར་རོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་རྡོ་རྗེ་ལས་ཀྱི་ཞེས་བྱ་བ་ནས་ཟླ་བའི་དཀྱིལ་འཁོར་ལ་༡གནས་ཏེ་འཁོད་དོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ལས་ཀྱི་དཀྱིལ་འཁོར་གྱི་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གཉིས་པ་བསྟན་པ་ཡིན་ནོ།",
    "ལས་ཀྱི་དཀྱིལ་འཁོར་འདིར་ཆོ་ག་རྒྱས་པ་ཇི་ལྟ་བ་བཞིན་དུ་བྱས་ཏེ་ཞེས་བྱ་བའི་གཞུང་གིས་ནི་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་དང་།",
    "ཨོཾ་བཛྲ་དྷཱ་ར་གུ་ཧྲ་སིདྡྷཱ་༥ཧཱུཾ་ཞེས་བྱ་བའི་བར་གྱི་༦གཞུང་གིས་སྟོན་ཏོ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ལས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་དངོས་གྲུབ་ནི་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ལས་ཀྱི་༧དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་ཕྱག་རྒྱ་བཞིས་རང་གི་ལྷའི་རྣལ་འབྱོར་ཇི་ལྟ་བ་བཞིན་དུ་བསྐྱེད་ནས།",
    "རྡོ་རྗེ་ལས་ཀྱི་ཚུལ་གྱིས་སོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "ཧཱུཾ་བཛྲ་ཀརྨ་ཤྲཱི་ཀི་ཏ་༤ཅེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་བཞི་པའི་དཀྱིལ་འཁོར་གྱི་༥དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་གི་ཏིང་ངེ་འཛིན་ལྔ་པོ་གསུངས་པ་ཡིན་ནོ།",
    "སྔ་མ་བཞིན་དུ་བསྡུ་བ་དང་བྱིན་གྱིས་བརླབས་པ་ནས་བརྩམས་ཏེ་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་བཞི་པའི་དཀྱིལ་འཁོར་གྱི་ལས་ཀྱི་མཆོག་གི་ཏིང་ངེ་འཛིན་ཀྱང་གསུངས་པ་ཡིན་ནོ།",
    "ཆོ་ག་རྒྱས་པར་བྱ་སྟེ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་བཞི་པའི་དཀྱིལ་འཁོར་དུ་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་དང་འཇུག་པའི་༡ཆོ་ག་རྒྱས་པར་སྟོན་ཏོ།",
    "ཧོ་བཛྲ་ཀརྨ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་དུམ་བུ་ལས་གསུངས་པའི་དངོས་གྲུབ་ནི་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་ཕྱག་རྒྱ་བཞིས་རང་གི་ལྷའི་རྣལ་འབྱོར་དེ་ལས་གསུངས་པས་བྱས་ལ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བ་བསྟན་པའི་ཕྱིར་དེ་ནས་ཇི་ལྟ་བ་བཞིན་དུ་རྡོ་རྗེ་མནན་པའི་རྩེ་གསུམ་པའི་ཕྱག་རྒྱ་ལ་སོགས་པ་ཞེ་ཞེས་བྱ་བ་ནས།",
    "མཛུབ་མོའི་རྩེ་མོ་གཞག་པའོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "ཆོ་ག་རྒྱས་པ་ཟིཐམས་ཅད་བྱས་ཏེ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་རྡོ་རྗེ་ཧཱུཾ་མཛད་ཀྱི་ཕྱག་རྒྱ་གཅིག་པའི་དཀྱིལ་འཁོར་གྱི་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་དང་།",
    "ཧཱུཾ་བཛྲ་ས་མ་ཡ་ཧཱུཾ་ཞེས་བྱ་བའི་བར་གྱི་སྩོ་གཞུང་གིས་བསྟན་ཏོ།",
    "ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་རང་གི་ལྷའི་ཕྱག་རྒྱ་བཞིས་རྣལ་འབྱོར་ཇི་ལྟ་བ་བཞིན་དུ་བསྐྱེད་ལ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་འདི་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དཀྱིལ་འཁོར་དུ་ཇི་ལྟ་བ་བཞིན་དུ་རས་ལ་སོགས་པ་བྲིས་པ་དང་ལུགས་མ་ལ་སོགས་པའི་གཟུགས་ཐམས་ཅད་ལ་ཡང་དངོས་གྲུབ་ནི་ཐུན་མོང་ངོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་༡དོན་འདི་སྔ་མ་བཞིན་དུ་ཤེས་པར་བྱའོ།",
    "ཨོཾ་བཛྲ་ཀནྡྲ་༦སཱ་དྷ་ཡ་ཀྲྀཏ་༧ཅེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་འཇིག་རྟེན་གསུམ་གྱི་འཁོར་ལོའི་དཀྱིལ་འཁོར་ཆེན་པོའི་དཀྱིལ་འཁོར་གྱི་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གཉིས་པ་སྟོན་པ་ཡིན་ནོ།",
    "དེ་ནས་བཅོམ་ལྡན་འདས་ཕྱག་ན་རྡོ་རྗེ་ཞེས་བྱ་བ་ནས་ཇི་ལྟར་རྡོ་རྗེ་དམ་ཚིག་གི་དཀྱིལ་འཁོར་ཆེན་པོ་བཞིན་དུ་བྱའོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་འཇིག་རྟེན་གསུམ་གྱི་འཁོར་ལོའི་དཀྱིལ་འཁོར་ཆེན་པོའི་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་དང་།",
    "དེ་ནས་ཕྱག་རྒྱ་ཆེན་པོ་བཅིང་བ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་ནས་བྲན་གྱི་ཕྱག་རྒྱ་རྣམས་སོ་ཞེས་བྱ་བའི་བར་ཀྱི་གཞུང་གིས་སྟོན་ཏོ།་།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་གཙོ་བོར་གྱུར་པའི་འཇིག་རྟེན་གསུམ་གྱི་འཁོར་ལོའི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་བསྡུས་པའི་དོན་བརྗོད་པར་བྱ་སྟེ་དེ་ལ་དང་པོ་སྤྱོར་བའི་ཏིང་ངེ་འཛིན་ནི་འཇིག་རྟེན་གསུམ་ཀྱི་འཁོར་ལོ་བྱེ་དཀྱིལ་འཁོར་ཆེན་པོ་གསུངས་པ་ཉིད་འདིར་གཟུང་བར་བྱའོ།",
    "ཨོཾ་བཛྲ་ཧ་རི་ནི་ཧཾ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་འཇིག་རྟེན་གསུམ་གྱི་འཁོར་ལོའི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་དཀྱིལ་འཁོར་རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གཉིས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དཀྱིལ་འཁོར་རིམ་པ་བཞིན་དུ་བསྟན་ཏེ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་ནི་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་དང་།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་གསང་བ་སྨྲོས་ཤིག་ཅེས་བྱ་བ་ནས།",
    "རྡོ་རྗེ་འཆང་བས་གསུངས་སོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "འཇིག་རྟེན་གསུམ་གྱི་འཁོར་ལོའི་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་གྱི་སྒྲུབ་པ་པོས་ཀྱང་འཇིག་རྟེན་གསུམ་གྱི་འཁོར་ལོའི་དཀྱིལ་འཁོར་ཆེན་པོ་ལས་གསུངས་པའི་རང་གི་ལྷའི་རྣལ་འབྱོར་བྱས་ལ་བསྒྲུབ་པར་བྱའོ་ཞེས་བྱ་བའི་དོན་འདི་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱ་བསླབ་པར་བྱའོ་ཞེས་བྱ་བ་ནས།",
    "མྱུར་དུ་སྤྲོས་པ་ཡང་དེ་བཞིན་ནོ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "ཅེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སྟོན་ཏོ།",
    "རྡོ་རྗེ་བྲན་མོ་རྣམས་ཀྱིའོ་ཞེས་བྱ་བའི་བར་གྱེ་གཞུང་གིས་ནི་འཇིག་རྟེན་གསུམ་གྱི་འཁོར་ལོའི་ལས་ཀྱི་དཀྱིལ་འཁོར་གྱི་དཀྱིལ་འཁོར་༡རྒྱལ་པོ་མཆོག་ཅེས་བྱ་བའི་ཏིང་ངེ་འཛིན་གཉིས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནས་ཕྱག་ན་རྡོ་རྗེས་ཡང་ཞེས་བྱ་བ་ནས་གདོང་གཡོགས་བགྲོལ་ཏེ་ཞེས་བྱ་བའི་བར་གྱི་གཞུང་གིས་སློབ་དཔོན་གྱི་ལས་ཀྱི་ཆོ་ག་དང་།"
  ]
}