    "བརྗོད་ཀྱིན་འདི་ལ་བརྟག་པར་དཀའ།",
    "རྟོག་མེད་རྣམ་དག་ཀུན་མཁྱེན་སྐུ།",
    "དགག་སྒྲུབ་མེད་པར་རྩོལ་དང་བྲལ།",
    "སྤངས་པ་མེད་པར་རང་གྲོལ་འགྱུར།",
    "བོན་ཉིད་དབྱིངས་ནས་གསལ་བའི་སྐུ་བཞུགས་པ།",
    "བོན་སྐུ་གཟུགས་སུ་སྣང་བ་སྟེ།",
    "རྣམ་པར་གྲོལ་བའི་ལེའུ་སྟེ་གསུམ་པའོ།",
    "མ་འདྲེས་སོ་སོའི་སྤྱོད་པར་སྣང་བ་ཡང་།",
    "ཇི་སྙེད་སྤྱད་ཀྱང་འབྲས་བུ་སྨིན་པར་འགྱུར།",
    "དྲི་མེད་ཤེས་རབ་སྤྱོད་པར་གྲོལ།",
    "ཆགས་མེད་ཀློང་དུ་བདེ་ཆེན་སྤྱོད་པར་རོལ།",
    "ཡེ་ནས་འདུ་འབྲལ་མེད་པར་གནས་པ་ཡིས།",
    "བླང་དོར་རྩང་གཙང་།",
    "ཐམས་ཅད་ལྷ་སྐུ་ཕྱག་རྒྱ་ཆེན་པོར་གྲུབ།",
    "ཁྱད་པར་སྤྱད་དོ་རྩོལ་ལས་འདས།",
    "མ་བྱས་མ་བརྩལ་མི་སྣང་སྤྱོད་ལས་འདས།",
    "སྲིན་པོའི་ཆ་ལུགས་ཞི་ཁྲོ་རྟག་པར་བཟུང་།",
    "དེ་ནི་འབྲས་བུ་རགས་ཤར་ངེས་པར་སྨིན།",
    "འབྲས་བུ་མེད་ཅིང་བརླག་པར་འགྱུར།",
    "བསྐལ་བ་ཆེན་པོའི་མཐའ་བརླག་པར།",
    "སྤྱད་པར་བྱ་བའི་དམ་ཚིག་ཡིན།",
    "ཐམས་ཅད་ལྷ་སྐུའི་ཕྱག་རྒྱ་ཡིས།",
    "དབྱེར་མེད་གཅིག་ཏུ་ཤེས་པར་བྱ།",
    "འདི་དག་ཉམས་པར་གྱུར་པ་ན།"
  ]
}