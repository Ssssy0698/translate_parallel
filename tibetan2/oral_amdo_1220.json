    "བདེ་འབྱུང་ལྷ་ཡི་ཟུར་ཕུད་རྩེ་མོར་བསྟེན།",
    "མཚུངས་ཞེས་བརྗོད་འདོད་བདག་གི་ཡིད་ལ་བསམས།",
    "མི་བདག་ཁྱོད་ནི་ཉེར་སྤྱོད་བདོག་པས་མཚན།",
    "ཟླ་བ་མ་ཡིན་ཚངས་སྲས་ལྷ་མོའི་ཞལ།",
    "མ་ཡིན་ཁྱོད་གདོང་མཛེས་བྱེད་མིག་ཏུ་ངེས།",
    "ཉེར་གསུམ་པ་ཐུན་མོང་མ་ཡིན་པའི་དཔེ།",
    "ལྔ་རིག་ཤེས་བྱའི་གནས་ཀུན་གཟིགས་པའི་དཔལ།",
    "ཟླ་བས་བདེ་འབྱུང་ཟུར་ཕུད་རྩེ་མོ་སྟེ།",
    "དབྱངས་ཅན་ཁྱོད་ཞལ་ཡིད་འོང་མིག་གཡོ་ཞིང་།",
    "ཁྱོད་གདོང་ཡིད་འོང་པདྨའི་བཞིན་རས་བཞིན།",
    "བདག་མིག་ཁྱོད་ཞལ་བདུད་རྩི་འཐུང་ཞིང་རྩེ།",
    "རྒྱལ་བའི་དགོངས་འགྲེལ་འཆད་པོ་མང་མོད་ཀྱང་།",
    "དྲི་མེད་འོད་ཟེར་ཁྱོད་འདྲ་ལྗོངས་འདིར་མེད།",
    "དབྱངས་ཅན་ཁྱོད་སྐུ་མཛེས་པས་ཀུནྡ་དང་།",
    "ཁྱོད་གསུང་སྙན་པས་ལྷ་ཡི་དུདྡྷ་བྷི།",
    "ཁྱོད་ཐུགས་བརྟན་ཅིང་ཟབ་པས་ཆུ་གཏེར་དང་།",
    "ལ་ལ་མཛའ་མོ་སྲོག་རྣམས་ཇི་བཞིན་བལྟ།",
    "མང་ཐོས་བློ་གྲོས་ལྡན་པ་ཁྱོད་ཇི་བཞིན།",
    "གཟི་ལྡན་ཉིན་མོར་བྱེད་པའི་འོད་ལྡན་པ།",
    "གང་ཁྱོད་མཁྱེན་པའི་སྣང་བས་འགྲན་པར་ནུས།",
    "གཡུལ་བཀྱེའི་ལས་ཐབས་མཁས་བཞིན་ཇོ་མོ་མཁས།",
    "ཉི་མའི་འོད་སྣང་ཇི་བཞིན་བ་མོ་དཀར།",
    "གང་གི་ཡོན་ཏན་གཞན་གྲོགས་སྙན་འཇེབས་གླུ།",
    "ཐར་འདོད་མ་ལུས་ཁྱོད་ཀྱི་རྗེས་སུ་སྨྲ།",
    "འཇམ་མགོན་ཁྱོད་ཞལ་སྟོན་ཟླའི་གཟུགས་བརྙན་ཅན།",
    "དུནྡྷ་བྷི་དང་མཚན་ཉིད་འདྲ་གསུང་གིས།",
    "ཉིན་མོའི་མགོན་འདི་ཁྱོད་སྐུའི་གཟི་མདངས་དཔེ།",
    "པདྨ་ཁྱོད་ཞལ་ལས་དམན་འདམ་ཁྲོད་རྒྱུ།",
    "ཁྱོད་དང་ཉི་མ་མུན་སྨག་གཞོམ་ལ་དཔའ།",
    "ཁྱོད་སྐུ་མཛེས་པ་ཐིག་ལེ་མཆོག་མར་འགྲན།",
    "མཚར་སྡུག་ལང་ཚོ་པདྨའི་དཔལ་ལ་སྡང་།",
    "སོར་གདུབ་འོད་ཀྱིས་ཉིན་བྱེད་སྣང་བར་དམོད།",
    "སྙན་འགྱུར་གསུང་གིས་ཚངས་དབྱངས་མཛེས་པ་འགོག།",
    "རྒྱུད་མངས་གླུ་ཡིས་དྲི་ཟའི་རོལ་མོར་རྒོད།",
    "རེག་ཕམ་སྙེག་དང་འཛེག་སེམས་སོགས།",
    "དྲི་ཟའི་རྒྱུད་མངས་གང་གི་ངག་ལས་ཐོས།",
    "ཁྱོད་གདོང་བསྟན་པས་ལྷ་མིའི་བཞད་སྒྲ་དབྱརང་ངང་ཚུལ་འཛིན།",
    "ལུས་ལྡེམ་པདྨའི་སྡོང་པོའི་དཔལ་ལ་རེག།",
    "ནུ་འབུར་ཟུང་གིས་ཉི་ཟླའི་མཛེས་པ་ཕམ།",
    "ཁྱོད་ལུས་དྲི་བསུང་ཨུཏྤལ་རྗེས་སུ་སྙེག།",
    "དེ་ཕྱིར་མིག་གི་བདུད་རྩི་ཁོ་ནར་སེམས།",
    "དེ་སོགས་མང་མོད་འདིར་ནི་བརྗོད་མི་ལང་།",
    "ཁྱོད་ཞལ་ཟླ་བ་ཉིད་གསུང་འཆི་མེད་རྗེ།",
    "གང་གི་ཞལ་རས་ཟླ་བ་ཚེས་པའི་དཔལ།",
    "མཚར་སྡུག་མིག་གི་རི་བོང་རྣམ་པར་གཡོ།",
    "དགྱེས་པའི་འཛུམ་མདངས་བསིལ་ཟེར་འོད་སྣང་གིས།",
    "སྨིན་འཁྱོག་འཁྲི་ཤིང་འདྲེན་བྱེད་ཟེའུ་འབྲུ་གཡོ།",
    "དབྱངས་ཅན་ཁྱོད་ཞལ་ཟླ་བའི་དཀྱིལ་འཁོར་ལས།",
    "འཇམ་མགོན་ཁྱོད་ཞལ་ཉི་མའི་མཛེས་པ་ལ།",
    "རྒྱལ་སྲས་ཁྱོད་སྐུ་ཡིད་འོང་མཚར་སྡུག་གང་།",
    "གང་འདུལ་མོས་ངོར་སྟོན་མཁས་འཇམ་དཔལ་དབྱངས།",
    "ཡིད་འཕྲོག་ལང་ཚོའི་འདབ་མ་དགོད་པ་ནི།",
    "ལྷན་ཅིག་འགྲོགས་པའི་དཔལ་འདི་ཚངས་སྲས་མོ།",
    "གཟི་ལྡན་འོད་ཆགས་ཁྱོད་ཞལ་ཉི་མ་ནི།",
    "འགྲོ་ལ་རྟག་པར་གཟིགས་མཛད་བཅོམ་ལྡན་འདས།",
    "ཁྱོད་གདོང་ཟླ་བའི་ཐིག་ཕྲེང་གར་སྟབས་བསྒྱུར།",
    "མགོན་ཁྱོད་ཞབས་ཟུང་ནོར་བུའི་གདེངས་ཀ་ནི།",
    "རྣམ་འདྲེན་ཁྱེད་སྐུ་ཉིན་མོར་བྱེད་པའི་གཟིས།",
    "སྐྱེ་རྒུའི་ཡིད་ཀྱི་རེ་བ་མ་ལུས་པ།",
    "མཛེས་མ་ཁྱོད་གདོང་ཞལ་སྒོའི་པདྨོ་ལ།",
    "བཀོད་པའི་ཁྱོད་ཞབས་སེན་མོའི་དམར་འོད་དག།",
    "ཉིན་མོར་བྱེད་པའི་འོད་ལ་འགྲན་པར་བྱེད།",
    "བདག་གིས་ཉིད་ཞལ་ཆུ་སྐྱེས་མཚར་སྡུག་འཐུང་།",
    "དབྱངས་ཅན་ཁྱོད་ཞལ་སྣང་སྟོང་སྒྱུ་མའི་འཕྲུལ།",
    "རྣམ་འདྲེན་མཆོག་ཁྱོད་ཞབས་སེན་ཉི་མ་ནི།",
    "ཉི་མའི་དངོས་པོ་ཡིན་པར་གང་གིས་གྲུབ།",
    "མཛེས་མ་ཁྱོད་གདོང་ཀུནྡའི་མཛའ་ན་མོ།",
    "བདག་ཡིད་སྲེག་འདི་ཁྱོད་ཀྱི་སྐྱོན་ཁོ་ནར།",
    "འདི་ནི་ཁྱོད་གདོང་མ་ཡིན་འོད་དཀར་ཅན།",
    "ཁྱོད་ཀྱི་ཐུགས་མིན་ཟབ་རླིངས་ལྷ་ཡི་ལམ།",
    "དམར་སེར་ཉིད་དོ་ཀུན་གསལ་མཁའ་ཡི་ཁྱོན།",
    "བདེ་གཤེགས་ཁྱོད་ཀྱིས་སྒྲིབ་གསུམ་མུན་པ་ཡི།",
    "འཇིགས་མེད་ཕྱོགས་རྣམས་ཀུན་ཏུ་རྣམ་པར་གཟིགས།",
    "བཟང་པོ་དཔལ་གྱིས་རང་གི་བདེ་བ་དང་།",
    "ཆེན་པོའང་རང་གི་ནོར་རྫས་ཆུང་ངུས་སོ།",
    "གཞན་དག་གཅེར་བུ་གཏུམ་མོའི་བདེ་དྲོད་སྤོར།",
    "རྒ་བའི་ཞགས་པས་དེ་བཞིན་ལང་ཚོ་ཉིད།",
    "མེ་ཏོག་གཞུ་ཅན་ཡིད་ཀྱི་རེ་བའང་འཇོམས།",
    "དྷརྨ་བྷ་དྲའི་རྣམ་དཔྱོད་ཧུབ་གཅིག་གིས།",
    "གང་སྐུའི་ཟེར་ཕྲེང་གཅིག་གིས་འགུགས་པར་ནུས།",
    "བརྒྱད་པ་རྗེས་གནང་གིས་འགོག་པ་ནི།",
    "ཁྱོད་བྲལ་གདུངས་པས་ཡུན་རིང་མནར་མི་འགྱུར།",
    "ཤེས་བྱ་ཀུན་གཟིགས་དཔལ་ལྡན་རྒྱལ་བའི་སྲས།",
    "མགོན་ཁྱོད་ཞི་བདེར་གཤེགས་སམ་བཞུགས་ལགས་ཀྱང་།",
    "རང་གི་བསམ་པའི་གནས་སྐབས་གསོལ་བར་ཟད།",
    "ཁྱོད་ལ་ཟུར་འགྲོས་སྟབས་ཀྱིས་འབྲལ་བར་སྨོན།",
    "བཅུ་གཉིས་པ་རྩུབ་མོས་འགོག་པ་ནི།",
    "མགོན་ཁྱོད་དག་པའི་ཞིང་གཞན་ལ་དགྱེས་ན།",
    "གྲོགས་ཁྱོད་བསམ་གཏན་བསྟེན་ཕྱིར་ནགས་ནང་དུ།",
    "བྲལ་བའི་གདུང་བས་ཁྱོད་ལམ་འགོག་པར་འགྱུར།",
    "དེ་དང་དཔྱོད་ལྡན་ཁྱོད་ཅག་གླེང་མོ་མཛོད།",
    "སྐྱེ་རྒུའི་མགོན་ཁྱོད་འོག་མིན་ཞིང་ཁམས་སུ།",
    "གཤེགས་པའི་མྱ་ངན་བདག་གིས་བཟོད་པར་བགྱི།",
    "མི་སྨྲ་ནགས་ཁྲོད་འགྲོ་ཞེས་ཁྱོད་ཞལ་ནས།",
    "རང་གིས་མ་བསྒོམས་སུ་ལའང་མ་ཕན་པར།",
    "ན་ཚོད་ཕལ་ཆེར་སོང་བ་དེ་རིང་ཚོར།",
    "ཡང་ན་སྤུ་ལྡན་ལྷ་མོའི་ཞལ་ལམ་ཅི།",
    "ཐམས་ཅད་གཟིགས་པའི་རྒྱལ་བ་གཞན་གྱིས་ཅི།",
    "སློང་མོ་པ་དག་རང་ནོར་རང་ཉིད་ཀྱིས།",
    "སྐྱེས་མཆོག་ཁྱོད་ལ་གཞན་གྱིས་མ་གསོལ་ཀྱང་།",
    "ཐུགས་རྗེའི་སྤྱན་གྱིས་རྟག་པར་བུ་བཞིན་གཟིགས།",
    "ཉིན་མོར་བྱེད་འདི་ལེགས་ལྡན་སྐྱེ་རྒུ་ཡི།",
    "ལྡན་ཁྱོད་ཀྱི་མཛད་པ་འདིས།",
    "མོས་སེམས་དྲག་དེ་སྲེག་བྱེད་ཞུགས་འབར་དང་།",
    "འདུ་འཛིའི་གཡེངས་བས་རང་རྒྱུད་གདུང་མོད་ཀྱི།",
    "མི་བདག་ཁྱོད་ཀྱི་ཐུགས་དང་ཆུ་༥ཡི་གཏེར།",
    "མཚུངས་མོད་དེ་ལྟ་ན་ཡང་ཐ་དད་པའི།",
    "རི་བོང་ཅན་དང་སྒྲ་དབྱངས་ལྷ་མོའི་སྐུ།",
    "སྨྲ་མཁས་ཁྱོད་དང་ཉིན་མོར་བྱེད་པ་གཉིས།",
    "འཕགས་པར་མཚུངས་མོད་ཉི་མ་འཆར་ནུབ་ཅན།",
    "ཁྱོད་ནི་འཆར་ནུབ་བྲལ་བས་ཐ་དད་དོ།",
    "ཐོགས་མེད་སྩོལ་བའི་མཛད་པ་འདྲ་མོད་ཀྱང་།",
    "མགོན་ཁྱོད་རྣམ་རྒྱལ་ཐུགས་རྗེར་འགྲན་ནུས་མིན།",
    "བླུན་ཞིང་འཆར་ནུབ་རེས་འཇོག་བྱེད་པའི་ཕྱིར།",
    "རྟ་ལྗང་ཅན་དེ་མི་བདག་ཁྱོད་ལས་དམན།",
    "ཉིན་མོར་བྱེད་དེ་ལྷ་ལམ་གནས་པས་དབྱེ།",
    "ཀུནྡའི་ཕུང་པོར་རབ་མཛེས་སྨིན་འཁྱོག་དང་།",
    "ཚངས་སྲས་བུ་མོ་ཁྱོད་གདོང་དཀྱིལ་འཁོར་ནི།",
    "དབྱངས་ཀྱི་རྒྱལ་མོའི་ཞལ་དང་རྒྱུ་སྐར་བདག།",
    "དཀར་གསལ་རབ་ཏུ་མཛེས་པའི་དཔལ་འཛིན་མོད།",
    "ཁྱོད་ཞལ་ཚེམས་ཕྲེང་གཡོ་བས་རྣམ་པར་མཛེས།",
    "ངང་པའི་བུ་མོ་འདི་ནི་ཆུ་ཡི་རྒྱན།",
    "དབྱངས་ཅན་ཁྱོད་ཞལ་འཇིག་རྟེན་མཁས་རྣམས་རྒྱན།",
    "ཐབས་ཤེས་ནང་པའི་འགྲོས་བཟང་ངང་གིས་བསྡམས།",
    "གཉིས་པ་ལང་ཚོ་ལ་སྦྱར་བ་ནི།",
    "བྲིས་པ་མེད་པར་གཉེར་མའི་རི་མོ་བཀྲ།",
    "འདི་གསུམ་བཞི་པའི་ལང་ཚོ་རྫོགས་པའི་རྟགས།",
    "ཕྱིས་པ་མེད་པར་དྲི་བྲལ་ཁྱོད་ཀྱི་གདོང་།",
    "འཇིག་རྟེན་སྣང་བྱེད་ཉིན་མོར་བྱེད་པའི་འོད།",
    "འགའ་ཞིག་སྣང་བར་རེ་བ་འཁྲུལ་པའི་བློ།",
    "ཀྱེ་མ་དུས་ཀྱི་ལང་ཚོས་བསྐམ་པར་འགྱུར།",
    "རྫོབཅུ་གཅིག་པ་ཕུལ་བྱུང་གི་རྒྱན་གྱི་མཚན་ཉིད།",
    "སྒྲ་དབྱངས་ལྷ་མོ་ཁྱོད་ཀྱི་མཛེས་སྡུག་གདོང་།",
    "ཟླ་དཀྱིལ་ཡིན་ནམ་མིན་ཞེས་རིང་མོ་ནས།",
    "རབ་དཀར་དབྱངས་ཅན་ལྷ་མོའི་ཞལ་རས་འདི།",
    "སྲིད་འདིར་འཚལ་ཏོ་ཅོག་གི་རིག་པ་རྣམས།",
    "ནོར་འཛིན་མ་ཁྱོད་ཨེ་མ་ཤིན་ཏུ་མཚར།",
    "གང་གི་ཚེམ་ཕྲེང་མཛེས་པའི་རྒྱན་གྱི་མཆོག།",
    "བརྐུས་པས་སྐྲག་སྟེ་མུ་ཏིག་ཕྲེང་ཚོགས་ཀྱང་།",
    "རེས་ཀྱིས་གླིང་བཞིར་ཉུལ་ཡང་མ་རྙེད་པར།",
    "སྣང་བའི་དཔལ་སྟེར་ཉིན་མོའི་བློ་ལྡན་མཁན།",
    "རྟ་ལྗང་ཅན་དེ་སྐྱ་རེངས་ཞགས་པ་ཡིས།",
    "སྒྲ་དབྱངས་ལྷ་མོའི་རབ་སྙན་གསུང་མཆོག་འདིས།",
    "ཉིན་མོར་བྱེད་པ་ནུབ་རིའི་ཕག་ཉལ་ཞིང་།",
    "མཛའ་བཤེས་སྙན་པའི་སྒྲུང་གིས་མི་བྲིད་པའི།",
    "ངོ་མཚར་རིག་པའི་གླེང་མོས་འཚོ་འདི་ཤེས།",
    "ལང་ཚོའི་རིམ་པ་ཕལ་ཆེར་ཐལ་གྱུར་ལ།",
    "ཉོན་མོངས་ཤེས་བྱ་སྙོམས་འཇུག་སྒྲིབ་པ་གསུམ།",
    "མཁྱེན་པའི་ཡེ་ཤེས་གཅིག་གིས་ས་ལེར་གཟིགས།",
    "ཁྱོད་ཀྱི་ལོག་སྨྲ་ཚར་གཅོད་གཏན་ཚིགས་ཀྱིས།",
    "ཕྱིས་ནས་རང་གིས་ལོངས་སུ་སྤྱད་བྱར་བྱས།",
    "རྒྱལ་བསྟན་རྩེ་མོ་གསང་ཆེན་རྒྱུད་ཀྱི་དོན།",
    "རྟོག་གེའི་རིག་པས་འཁྱོག་པོར་འཆད་པའི་འགྲོས།",
    "བཅུ་བཞི་པ་ཕྲ་མོའི་རྒྱན་གྱི་མཚན་ཉིད་ནི།",
    "ངག་གི་རྣམ་རིག་མེད་པར་ལུས་ཀྱི་རྣམ་རིག་གི་ཟུར་གྱི་བརྡ་དང་རྣམ་འགྱུར་ལས་འདོད་དོན་གཞན་གོ་བར་བྱེད་པ་སྟེ།",
    "དང་པོ་ཟུར་གྱི་ཕྲ་མོ་ནི།",
    "ཚིག་གིས་མཚོན་ཏེ་བརྗོད་པར་ནུས་མིན་ཞེས།",
    "གཉིས་པ་རྣམ་པའི་ཕྲ་མོ་ནི།",
    "དངོས་པོའི་རང་བཞིན་གསལ་པོ་དེ་ཟོལ་གྱི་ཚིག་གིས་སྒྲིབ་ཅིང་སྦེད་པ་སྟེ།",
    "རིང་ནས་སྦྱངས་པའི་མཁས་མང་ཚོགས་དབུས་སུ།",
    "ལང་ཚོས་རབ་སྒེག་མཛེས་མ་ཚོགས་དབུས་སུ།",
    "དབྱངས་ཅན་ཁྱོད་གདོང་དབུ་སྐྲ་འདྲེན་བྱེད་དཔལ།",
    "ཐམས་ཅད་མཁྱེན་གཟིགས་བློ་བཟང་རྒྱ་མཚོ་སྟེ།",
    "ཁྱོད་ཞལ་བསྟན་འགྲོའི་ཉེར་འཚོར་གསལ་བ་འདི།",
    "ལེགས་བྱས་ཡངས་པའི་མིག་གིས་མཐོང་བར་གྱུར།",
    "རླབས་ཆེན་ཚོགས་གཉིས་སྤྱོད་པས་རིང་མོ་ནས།",
    "རབ་གཏུམ་སྲིན་མོའི་གཟུགས་འཆང་ངན་ནེ་མ།",
    "སེན་མོའི་ལྕགས་ཀྱུས་ཉམས་པའི་མགོ་སྐྱེས་ནས།",
    "ཡན་ལག་བཞི་བའི་དཔུང་ཚོགས་མ་བཤམས་ཤིང་།",
    "འཁྱོམས་ཤིང་འཁྱོམས་ཤིང་གར་བྱེད་འགྱེལ་བར་གྱུར།",
    "རབ་བྱུང་ཁྱོད་ནི་དབེན་པར་མཛེས་མ་དང་།",
    "བདུན་པ་རྨད་བྱུང་གི་ཉམས་ནི།",
    "བརྒྱད་པ་འཇིགས་རུང་གི་ཉམས་ནི།",
    "གཞོན་ནུ་ལང་ཚོ་ལྡན་པ་ཁྱེད་ཅག་གཉིས།",
    "གློག་གི་ཞགས་པས་དྲངས་པའི་ཆུ་ཁུར་ལས།",
    "རིན་ཆེན་ལས་གྲུབ་སུམ་རྩེན་ཁང་བཟང་གི།",
    "དངོས་པོ་རང་གི་ངོ་བོ་གང་ཡིན་པ་དེ་ལ་མ་ཡིན་ཞེས་བསྙོན་ནས།",
    "གང་གི་གཟུགས་སྐུ་གཅིག་པུ་འདི་ཁོ་ན།",
    "མ་ཡིན་སྣ་ཚོགས་མོས་དགེའི་རྗེས་སོང་བའི།",
    "མཚར་སྡུག་མཚན་མོའི་མགོན་གྱུར་ཀུནྡའི་གཉེན།",
    "མི་བརྟན་གྱ་གྱུའི་འགྲོས་ལྡན་ཐུན་མོང་དུ།",
    "རྫོགས་པའི་རིམ་པ་ཟབ་མོས་སྐྱེ་བོ་དག།",
    "ཉིན་མོར་བྱེད་པའི་འོད་ཟེར་ནུབ་གྱུར་ཏེ།",
    "གང་གི་རལ་པའི་ཅོད་པན་རྩེར།",
    "པདྨ་ཅན་བུད་མེད་དང་མཚོ།",
    "ལེགས་ལྡན་འགྲོ་ལ་མིག་གི་དཔལ་སྟེར་རྒྱལ་པོ་དང་ཉི་མ།",
    "བྷ་ག་ཝན་ཁྱོད་གཡུལ་ལས་རྣམ་པར་རྒྱལ།",
    "རྒྱལ་བའི་སྲས་པོ་ཁྱོད་ཀྱི་བཟོད་པ་ཡི།",
    "དེ་ལྟ་ན་ཡང་ཞེ་སྡང་ཚིག་གི་མདའ།",
    "རིག་པ་འཛིན་ཁྱོད་ཨོ་ཌི་ཡ་ན་དང་།",
    "ཡན་ལག་བཞི་ཡི་དཔུང་ཚོགས་མི་ལྡན་ཞིང་།",
    "འཁོར་གཡོག་གིས་དོར་དབེན་པར་དཀའ་ཐུབ་ཀྱིས།",
    "ནོར་འཛིན་དཔལ་མོའི་གཞི་ལ་ཀུན་དགའ་བའི།",
    "སྣང་བ་མཆོག་གི་མཛེས་པ་འཕེལ་བར་གྱུར།",
    "གཉེར་མའི་རི་མོ་རབ་འཕེལ་སོ་རྣམས་དེངས།",
    "ལུས་འཁྱོག་རང་སེམས་དྲང་པོ་མདའ་ལྟ་བུར།",
    "སོང་བ་རྒན་པོའི་ལང་ཚོས་མ་བཅོམ་སུ།",
    "བདག་ཡིད་མོས་ཤུགས་མེ་ཡིས་གདུངས་མིན་ནམ།",
    "ལྔ་པ་གཞི་གཅིག་གི་བྱ་བ་འགལ་བ་ནི།",
    "མ་འདྲེས་སོ་སོར་གཟིགས་པའི་འགྲོ་ཀུན་ལ།",
    "འགའ་ཞིག་ལ་སྨད་པ་སྐྱོན་ལྟར་བརྗོད་པའི་ཚུལ་གྱིས་ཕུགས་སུ་ཡོན་ཏན་བརྗོད་པར་སོང་བའི་ཟོལ་གྱིས་བསྟོད་པ་སྟེ།",
    "དེ་ཉིད་ཞིག་པོ་ཉི་སེང་ཁྱོད་ཀྱིས་ཀྱང་།",
    "ཆོམ་རྐུན་མི་བཟད་རྩུབ་མོ་དེས།",
    "ཁྱོད་ཀྱིས་འདི་འདྲ་མཛད་རིགས་སམ།",
    "གང་གི་རིང་ལུགས་སྨྲ་བའི་དབྱངས་མཁན་གྱིས།",
    "ཁྱོད་ལ་བརྟེན་པའི་སྨྲ་བའི་སྤོབས་པ་གང་།",
    "ཐོབ་ཅེས་ཅི་ཕྱིར་མཆོག་གི་ང་རྒྱལ་མཛད།",
    "རང་གི་བསྟན་བྱའི་དོན་དེ་ལས་གཞན་ཞིག་དཔེའི་འཇུག་པས་བསྟན་ན་དེ་ཡང་དེ་དང་མཚུངས་པར་གོ་བའི་ངག་ཞིག་སྟེ།",
    "དང་པོ་མཆོག་གི་ངེས་བསྟན་ནི།",
    "ཟླ་བ་ཤར་བའི་ཟེར་གྱིས་རེག་པ་ན།",
    "མཚན་མོའི་མུན་ཚོགས་འཇོམས་འདི་ངེས་པར་བསྟན།",
    "འགྲོ་བ་རྣམས་ཀྱི་རེ་བཅས་མོས་པ་དང་།",
    "བློ་ཆེན་ཁྱོད་ཀྱིས་ཕན་བདེའི་དངོས་པོ་ཀུན།",
    "ཁྱོད་ཀྱིས་ལྷག་མ་མེད་པར་ཅིག་ཅར་འཕྲོག།",
    "ཁྱོད་ལ་དགེ་ལེགས་གཡོ་མེད་མཛད་གྱུར་ཅིག།",
    "རྒྱན་ཐ་དད་པ་གཉིས་སམ་གསུམ་ལ་སོགས་པ་བསྲེས་ཏེ་ཚིགས་བཅད་རེར་རྒྱན་དུ་མ་ཚོགས་པའོ།",
    "མཛེས་སྐུ་མ་བྲིས་མཚར་སྡུག་རི་མོ་ཅན།",
    "དབྱངས་ཅན་ཁྱོད་ཞལ་རང་བཞིན་མཛེས་པའི་སྐུ།",
    "བློ་དང་ངག་གི་ཕུན་ཚོགས་མཉམ་དུ་སྩོལ།",
    "ངག་རྣམས་གཅིག་གིས་གཅིག་ཕན་ཚུན་འབྲེལ་ཆགས་ཤིང་ཕན་པར་བྱེད་པ།",
    "ཚིག་སྦྱོར་གང་བརྗོད་པའི་ཤུགས་ཀྱིས་བརྗོད་བྱའི་དངོས་པོ་ཟབ་མོ་དག་བདེ་བླག་ཏུ་རྟོགས་ནུས་པ་སྟེ།",
    "ཡི་གེ་རེ་རེའམ་འགའ་ཟུང་ཟློས་ནས་རྗོད་པར་བྱེད་པའོ།",
    "ཐུབ་པ་ཐུབ་པར་གྲགས་འབར་དེ་དག་གི།",
    "རལ་པའི་ཅོད་པཎ་རྩེ་མོར་མངོན་འཕགས་པ།",
    "བརྒྱ་ཕྲག་བརྒྱ་ཕྲག་སྟོང་གི་ཐུགས་རྗེའི་འོད།",
    "མགོན་ཁྱོད་ཐུགས་རྗེ་ཆད་མེད་གངྒཱའི་རྒྱུན།",
    "ཡུར་ཡུར་མ་རིག་གིས་མྱོས་གཉིད་མཐུག་ལས།",
