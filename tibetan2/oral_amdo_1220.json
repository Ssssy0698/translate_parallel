    "འགྲོ་ལ་སྙན་འགྱུར་ངག་གི་དཔལ།",
    "ཤེས་རབ་གསལ་བྱེད་རྡོ་རྗེ་ཕག་མོས་སྐྱོངས།",
    "ཡིད་བཞིན་རེ་བ་འགྲུབ་པར་མཛོད་ཅིག།",
    "རབ་མཛེས་ཁྱོད་སྐུ་མརྒད་མདངས་འཕྲོག།",
    "ཨུཏྤལ་སྔོན་པོའི་ཕྱག་གི་པདྨ།",
    "གཉིས་པ་གནས་གཞན་ན་ཡོད་པའི་ཟུང་ལྡན་ལ་དྲུག་གི།",
    "དེ་ཕྱིར་མགོན་ཁྱོད་བསླུ་མེད་སྐྱབས་མཆོག་དཔལ།",
    "ཚངས་སྲས་མ་དཀར་དཀར་མོ་ཁྱོད་དཀར་དཀར།",
    "རབ་མཛེས་སྤྱན་ཟུར་རབ་གཡོ་སྨིན་འཁྱོག་མ།",
    "ཟུང་གི་ཐོག་བར་ན་ཆོད་ཅིང་མ་ཆོད་པ་ནི།",
    "ཀུན་ཏུ་ས་ལེར་རབ་གཟིགས་རྒྱལ་བ་ཀུན།",
    "ཐུབ་གང་ཉོན་མོངས་དགྲ་ཐུབ་གདུལ་དཀའ་ཐུབ།",
    "ལེགས་ལྡན་འགྲོ་བའི་ཉིན་མོའི་མིག་ཏུ་གྱུར།",
    "ལེགས་ལྡན་འགྲོ་བའི་མཚན་མོའི་མིག་ཏུ་གྱུར།",
    "འཇམ་མགོན་ཐུགས་རྗེའི་འོད་སྣང་གིས་ཕྱེ་བའི།",
    "ཇི་ལྟ་ཇི་སྙེད་ཤེས་བྱ་ཀུན་གཟིགས་པ།",
    "ཇི་ལྟ་ཇི་སྙེད་ཤེས་བྱ་ཀུན་གཟིགས་པ།",
    "ཇི་ལྟ་ཇི་སྙེད་ཤེས་བྱ་ཀུན་གཟིགས་པ།",
    "འགྲོ་བའི་གཙོ་བོ་འཁོར་ལོས་སྒྱུར་བའི་རྒྱལ་པོ་སྐལ་བཟང་མིག་གིས་མཐོང་།",
    "གནས་ཀུན་ཤེས་གཟིགས་ཀུན་གནསཀུནརྒྱུགནསརྒྱུརིགགཟིགས།",
    "སདོན་གཟིགསཀུནཤེས་ཀུན་གནས་ཀུན་གནསརིགགནས་གསུམ་པ་དབྱངས་སོགས་ངེས་པའི་བྱ་དཀའ་ལ་བཞི་ཚན་གསུམ་གྱི།",
    "ཡིད་གཉིས་སྤྲིན་གྱིས་མི་སྒྲིབ་ཡིད་གཅིག་གི།",
    "མོས་བློས་གསོལ་ཐོབ་མཆོད་ཡོན་སོ་སོར་སྟོབ།",
    "རྟག་ཏུ་ཐལ་ལེར་སྟོན་ལ་དད་ནས་སོ་འདུད།",
    "པཱ་དར་བར་མེད་མོས་བློས་ཕྱག་འབུལ་བས།",
    "གསུམ་པ་གབ་ཚིག་གི་རྒྱན་ལ།",
    "གབ་བྱེད་བུད་མེད་ཀྱིས་མཐོ་རིས་ཀྱི་རྟེན་འཆིང་བ་དང་།",
    "སྙན་འགྱུར་དབྱངས་ཅན་སྐྱེད་བྱེད་འཁོར་ལྡིང་གིས།",
    "དམའ་༡ བའི་སར་བཞག་པུས་བཙུགས་༨ ཐལ་མོ་སྦྱར།",
    "འདར་༥ ཞིང་ཞུམ་པས་སྒྲ་༦ དབྱངས་ལྷ་མོའི་ཞབས།",
    "སྙན་སྒྲོག་བུང་བ་སྟོང་གི་འཕུར་ལྡིང་ཅན།",
    "དྲུག་པ་རྩུབ་མོ།",
    "མུན་པས་ཕྱོགས་བཅིངས་འཇིགས་རུང་གཡང་སའི་ངན་སོང་ཁར།",
    "གབ་བྱེད་རྒན་མོར་བརྟགས་པའོ།",
    "གབ་བྱེད་རྣམ་གྲངས་ཀྱི་མིང་གིས་གབ།",
    "རྩུབ་པའི་རེག་བྱ་བྱིན་པས་སྲེད་བྲལ་ནས།",
    "དཀར་འཇམ་ལང་ཚོ་རབ་རྒྱས་པ།",
    "ཚངས་སྲས་ལྷ་མོའི་ནུ་མའི་འཁུར།",
    "རིང་མོ་ཉིད་ནས་འགྲོགས་གྱུར་བཅོམ་པ་ན།",
    "བཞི་པ་སྔོན་འགྲོའི་མ་མོ་གསུམ་ལྡན་ནོ།",
    "ཆུ་ཀླུང་ཚོགས་རྣམས་ཐུར་དུ་གོམ་རྩལ་འགྲན།",
    "བདག་ཉིད་དེ་རིང་ཁོ་ནར་ལང་ཚོ་ཡོལ།",
    "མི་བདག་ཁྱོད་ནི་ཆོག་ཤེས་ལྡན་པའི་བློས།",
    "སྨིན་ལེགས་སྒེག་མོ་པདྨའི་སྡོང་པོ་ལྟར།",
    "མིག་གི་བདུད་རྩི་སྟེར་སླད་ད་ཚུར་བྱོན།",
    "སྲིད་ལམ་དག་གིས་ལ་བགྲོད་པས་བའི་སྐྱེ་འགྲོ་ཁྱོད།",
    "སྨིན་ལེགས་ཁྱོད་ཀྱི་མཚར་སྡུག་རབ་འཕེལ་བ།",
    "མཐོང་བའི་མིག་ལ་ངོ་མཚར་ལྟད་མོ་བསྐྱེད།",
    "མང་ཚོགས་ཞང་བློན་གྱི་འདུན་ས་ནང་དུ།",
    "མཚོ་བྱུང་ལྷ་མོ་དབྱངས་ཅན་མའི།",
    "ཆད་ལྷག་གི་དཔེ།",
    "དུའཤཱནྟསཾབུདྡྷ།",
    "སྒྲ་ལྕི་ཡང་གི་རྟགས་འདུགར་༤",
    "གང་གི་གཙུག་ཏུ་བཅིངས་པའི་གཟི་བྱིན་འོད།",
    "སྣང་བ་མི་བཟད་ཕན་བདེའི་སྲོག་ཏུ་སོང་།",
    "ཨུཏྤལ་ལུས་ཕྲ་མ་ཁྱོད་རྣ་བའི་རྒྱན།",
    "ཐུབ་ཆེན་སྟོན་པས་གསུངས་པ་བདེན་མོད་ཀྱང་།",
    "ཆུ་ལ་འབད་པས་འཁྲུད་མོདཀྱི།",
    "འདུ་འཛིར་ཡིད་རབ་བྱུང་བའི་དགེ་སྦྱོང་གིས།",
    "རེག་ཙམ་ཉིད་ནས་དགའ་མ་སྟི་བྱས་པའི།",
    "༦ ཞེས་སྙན་ངག་གི་དཔེར་བརྗོད་གཞུང་བཞིན་ཚང་ལ་མཚན་ཉིད་བསྡུས་པས་བརྒྱན་པ་སྣ་ཚོགས་ཨུཏྤ་ལའི་ཆུན་པོ་འདིའང་སྨྱོས་བཙུན་རྨོངས་པ་དྷརྨ་ཤྲཱིའི་བློ་མཚོ་ལས་འཐོན་པའོ།",
    "། སྙན་ངག་གི་དཔེར་བརྗོད་རབ་གསལ་སྣང་བ་བཞུགས་སོ།་",
    "མཛེས་མཛེས་ལྟ་ན་སྡུག་པའི་ལང་ཚོ་ཅན།",
    "མཁའ་ལ་རྒྱུ་བའི་ཉིན་མོར་བྱེད་པ་འདིས།",
    "རབ་བརྗིད་དཀར་ཞིང་གསལ་བའི་ལང་ཚོ་ཅན།",
    "བློ་སྟེར་ལྷ་མོ་གང་ཁྱོད་རྒྱལ་གྱུར་ཅིག།",
    "མཚོ་ལྡན་གང་ཁྱོད་འཇིག་རྟེན་རྒྱན་དུ་གྱུར།",
    "གསལ་གསལ་ཉིན་མོར་བྱེད་པའི་གཟི་མདངས་ཅན།",
    "ཐོགས་མེད་བློ་གྲོས་མཆོག་གི་དངོས་གྲུབ་སྩོལ།",
    "གསལ་གསལ་ཉིན་མོར་བྱེད་པས་བཞད་བྱས་པའི།",
    "བརྗིད་བརྗིད་ཤར་གྱི་ས་འཛིན་རྩེ་མོ་ནས།",
    "ཀྱེ་ཀྱེ་མིང་གི་མཐའ་མཛོད་མཚོ་བྱུང་མ།",
    "འཇིགས་འཇིགས་གཉིས་འཐུང་ཚོགས་རྣམས་ཕྱོགས་སུ་བྱེད།",
    "མཛེས་མཛེས་མཚོ་ལྡན་ཁྱོད་སྐུ་གསལ་བསྒོམས་ནས།",
    "ཡང་ཡང་བཟླས་ཀྱང་ཁྱོད་ཞལ་མི་སྟོན་པ།",
    "དམར་སེར་ཡིད་དུ་འོང་བའི་ལང་ཚོ་ཅན།",
    "ལྷག་པའི་ལྷ་མཆོག་ཟུར་ཕུད་ལྔ་པ་ཁྱོད།",
    "རྒྱལ་བ་ཀུན་ཡུམ་དབྱངས་ཀྱི་ལྷ་མོའི་སྐུ།",
    "རབ་མཛེས་ཡིད་དུ་འོང་བའི་ལང་ཚོ་ལྡན།",
    "ཡིད་འོང་ལྟ་ན་སྡུག་པའི་ལང་ཚོ་ཅན།",
    "ལྷབ་ལྷུབ་རྒྱལ་མཚན་གཡོ་བའི་རྩེ་མོ་ན།",
    "ཡིད་ལ་འདོད་པའི་རེ་བ་སྐོང་བར་བྱེད།",
    "རིན་ཆེན་རྒྱལ་མཚན་རྩེ་མོར་འཕྱར་བ་ལས།"
  ]
