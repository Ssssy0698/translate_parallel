    "ཅིས་ཀྱང་གཞོམས་གཞིག་ཐམས་ཅད་དང་བྲལ་བའི་རྡོ་རྗེའི་གོ་ཁྲབ་ཆེན་པོས་བགོས་པར་གྱུར།",
    "ལྷ་རྣམས་བདེན་པར་གནས་པ་ལ།",
    "བདེན་པ་རྒྱལ་གྱུར་རྫུན་མ་ལགས།",
    "བདེ་དགའ་རྒྱ་མཚོ་ཐོབ་པར་ཤོག།",
    "ལུས་ཅན་ཀུན་ལ་གནོད་པར་མ་གྱུར་ཅིག།",
    "དེ་ཡི་ས་ལ་འགོད་པར་ཤོག།",
    "ཐོབ་ནས་ཉོས་པའི་དགྲ་རྣམས་ཕམ་བྱས་ནས།",
    "བར་ཆད་སེལ་ཞིང་སྐྱོང་བར་ཞལ་བཞེས་པའི།",
    "ཅེས་སོགས་ཤིས་པ་བརྗོད་པ་ཅི་རིགས་ཀྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "དོན་གཉིས་ལྷུན་གྱིས་འགྲུབ་པའི་ཐབས་མཆོག་ལགས།",
    "ཉམ་ཐག་འགྲོ་བ་ཡོངས་ལ་ལེགས་པར་སྦྱིན།",
    "རོལ་བའི་དབེན་གནས་མཁའ་སྤྱོད་གླིང་ནས་གང་ཤར་མགྱོགས་པར་སོར་རྩེས་འདུ་བྱེད་བགྱིས་པའོ།",
    "ཡོངས་ལ་དགེ་ཞིང་བཀྲ་ཤིས་པར་གྱུར་ཅིག།",
    "ཕྱོགས་བཅུ་དུས་གསུམ་ན་བཞུགས་པའི་རྒྱལ་བ་སྲས་དང་བཅས་པ་ཐམས་ཅད་ཀྱི་གསང་གསུམ་ཡེ་ཤེས་སྒྱུ་མའི་སྤྱི་གཟུགས།",
    "སྐྱབས་འོག་དམ་པ་ན་ཚུད་པར་མཛད་དུ་གསོལ།",
    "སྒོ་སྒོ་གསུམ་སྒྲིབ་ཚོགས་ཐམས་ཅད་བྱང་ཞིང་དག་པར་གྱུར་ཅིག།",
    "དགྱེས་བཞིན་དུ་བཞེས་ནས་ཚོགས་གཉིས་རླབས་པོ་ཆེ་ཡོངས་སུ་རྫོགས་པ་གྱུར་ཅིག།",
    "ཉེས་ལྟུང་སྒྲིབ་པ་བག་ཆགས་དང་བཅས་པོདཔ་མཐའ་དག་ལྷག་མ་མ་ལུས་པར་བྱང་ཞིང་སོར་ཆུད་པར་གྱུར་ཅིག།",
    "མགོན་པོ་མྱ་ངན་ལས་འདའ་བར་བཞེད་ཀུན་དེ་དག་ཐམས་ཅད་བརྩེ་བ་ཆེན་པོས་འགྲོ་དོན་མྱ་ངན་ལས་མི་འདའ་བར་བའི་རྡོ་རྟོག་པར་བཞུགས་སུ་གསོལ་ལོ།",
    "མཐར་ཐུག་འབྲེལ་ཚད་རྣམ་འདྲེན་སྟོབས་བཅུ་མངའ་བའི་གོ་འཕང་མཆོག་ལ་མངའ་བརྙེས་པར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "བར་ཆད་བདུད་བཞིའི་གཡུལ་ངོ་ཐམས་ཅད་འཕྲིན་ལས་རྣམ་པ་བཞིའི་སྒོ་ནས་ཚར་བཅད་དེ་ཕྱོགས་ཐམས་ཅད་ལས་རྣམ་པར་རྒྱལ་བར་བྱིན་གྱིས་བརླབ་ཏུ་གསོལ།",
    "དེ་ལྟར་དུ་གསོལ་ཞིང་སྨོན་གསུང་འབུམཔའི་དོན་ཐམས་ཅད་གེགས་མེད་ཡིད་བཞིན་དུ་རྒྱལ་བ་སྲས་དང་བཅས་པའི་བདེན་པ་ཆེན་པོའི་བྱིན་གྱི་རླབས་ཀྱིས་དེ་དེ་བཞིན་དུ་འགྲུབ་པར་གྱུར་ཅིག།",
    "རྣམ་དག་སྨོན་པའི་གནས་ཀུན་འགྲུབ་པར་ཤོག།",
    "སརྦ་མངྒ་ལཾ། ། ཡན་ལག་བདུན་པ་བཞུགས།",
    "གནོང་འགྱོད་དྲག་པོས་བཤགས་ཤིང་སླན་ཆད་སྡོམ།",
    "སྲིད་མཐའི་བར་དུ་འགྲོ་ངོར་རྟག་བཞུགས་གསོལ།",
    "ལྷན་ཅིག་ཀུན་མཁྱེན་རྒྱ་མཚོར་ཡོངས་སུ་བསྔོ།",
    "དགེ་སེམས་ཁྱད་པར་ཅན་གྱི་རྩིས་ཟིན་པའི་ངང་ནས་སྐྱབས་སེམས་སྔོན་དུ་བཏང་སྟེ།",
    "ཇི་ལྟར་འོས་པའི་གདན་ལ་བཞུགས།",
    "ཐོབ་ནས་ཉེས་པའི་ཚོགས་རྣམས་ཕམ་བྱས་ནས།",
    "དེ་ལ་འདིར་བསངས་སྐྱེམས་གསུར་དང་ཆབ་གཏོར་ལན་ཆགས་ཀླུ་གཏོར་སོགས་གང་དགོས་ཐ་། འདུ་བྱས་ལ།",
    "དགེ་སྦྱོང་ཆེན་པོ་འདི་སྐད་གསུངས།",
    "རབ་བརྗིད་ཁ་ཊ་བེ་ཅོན་ལེགས་པར་བསྣམས།",
    "ལེགས་པར་ཕུལ་བས་དབུལ་བ་ཀུན་སེལ་ཞིང་།",
    "བསྔོ་སྨོན་བཀྲ་ཤིས་ཀྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "པོད་། སཙྪ་ཆུ་ཀླུང་དུ་སྤྱན་དྲངས་ཚུལ་བསྡུས་པ་བཞུགས་སོ།",
    "སྤོས་དང་མེ་རོལ་ཏོག་ལ་སོགས་མཆོད་རྫས་དུ་མ་དང་བཅས་བཀུར་སྟི་ཆེན་པོས་སྤྱན་དྲངས་ནས་ཆུ་ཀླུང་ཆེན་པོའི་འགྲམ་དུ་བཞུགས་སུ་གསོལ་ལ།",
    "ཞེས་སོགས་ཡན་ལག་བདུན་རྗེའི་པ་རྒྱས་བསྡུས་ཅི་རིགས་བྱས་ཏེ།",
    "མཆོད་སྦྱིན་རྒྱ་ཆེན་པོས་རྟག་ཏུ་མཉེས་ཤིང་དགྱེས་པར་མཛད་དུ་གསོལ།",
    "གུས་པ་ཆེན་པོས་གཤེགས་སུ་གསོལ་བར་བྱས་ལ་བསྔོ་སྨོན་ཤིས་བརྗོད་ཀྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "རྨོངས་པ་ཝ་གཱིནྡྲའམ་རོལ་རྡོར་བས་པཎ་ཆེན་དཔལ་ལྡན་ཡེ་ཤེས་དང་རྒྱལ་རོལ་སྲས་གཞན་ཕན་པ་སོགས་དམ་པའི་གསུང་ལ་གཞི་བྱས་ནས་དབེན་གནས་མཁའ་སྤྱོད་གླིང་དུ་སུག་ལས་བགྱིས་པའོ།",
    "བའི་རྡོ་། ཀླུ་གཏོར་བསྡུས་པ་བཞུགས་སོ།",
    "ཆུ་གཙང་འོ་མ་དང་སྦྱར་བ།",
    "ཤ་ཆང་སྒོག་རྗེའི་གསུང་ཙོང་སོགས་འབག་བཙོག་དང་བྲལ་ཞིང་གཙང་སྦྲ་དང་ལྡན་པར་བྱས་ལ།",
    "ཆུ་གཙང་འོ་མའི་བཏུང་བ་ཕུན་སུམ་ཚོགས།",
    "ཀླུ་རྒྱལ་འཁོར་དང་བཅས་ལ་བསྟོད་པར་བགྱི།",
    "ཆུ་གཙང་འོ་མའི་བཏུང་བ་མཚོ་ལྟར་འཁྱིལ།",
    "བསྔོ་སྨོན་ཤིས་བརྗོད་ཅི་རིགས་ཀྱི་མཐའ་བརྒྱན་པར་བྱའོ།",
    "ཞེས་ཀླུ་གཏོར་བསྡུས་པ་འདི་ཡང་དཔྱོད་ལྡན་རྒྱ་རོང་པ་ཤེས་རབ་རྡོ་རྗེ་ནས་བསྐུལ་བཞེད་མ་ལྡོག་པར།",
    "དགེའོ། ། བླ་འགུགས་བསྡུས་པ་བཞུགས་སོ།",
    "གཡོ་མེད་རྡོ་རྗེའི་ཁམས་ལྟར་བརྟན་བྱས་ནས།",
    "ཡིད་ལ་སྨོན་པ་ཅི་བཞིན་འགྲུབ་པར་ཤོག།",
    "འདི་ལ་ཚིག་ཕྲད་ཅུང་ཟད་བསྒྱུར་ནས་ཚེ་འགུགས་བྱས་ཀྱང་ཆོག་གོ།",
    "བདག་རྨོངས་ཝ་རོལ་གཱིནྡྲའམ་རོལ་རྡོར་བས་འཕྲལ་དུ་ས་སྒང་རི་སུལ་ལས་གང་ཤར་ཤར་མར་སུག་ལས་འགྱིས་པ་དགེ་ཞིང་བཀྲ་ཤིས་པར་གྱུར་ཅིག།",
    "བའི་རྡོ་། ཚེ་འགུགས་འཆི་མེད་དཔལ་སྟེར་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "འཆི་མེད་གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མ་ཡི།",
    "རལ་བ་སྲུབ་ལ་ཆད་པ་ལེགས་པར་མཐུད།",
    "འཆི་མེད་ཚེ་ལྷ་རྣམ་གསུམ་གྱི་ཚེ་འགུག་ཅིག་བྲི་དགོས་ཀྱི་བཀའ་གསུང་གནང་བ་ལྡོག་མིན་ཙམ་དུ།",
    "བརྒྱུད་། ལུས་སྦྱིན་བསྡུས་པ་གཟུང་འཛིན་རང་གྲོལ་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "ལུས་སྦྱིན་བསྡུས་པ་བྱེད་པར་འདོད་པས་ལྟ་བའི་གདེང་དང་ལྡན་པའི་ངང་ནས།",
    "མ་ངེས་ཆོ་འཕྲུལ་སྣ་དགུ་རབ་ལྡན་པར།",
    "རྗེའི་། གཡང་འབོད་འདོད་དགུའི་ཆར་འབེབས་ཞེས་བྱ་བཞུགས་སོ།",
    "ཁྱད་པར་དགོས་འདོད་ཀུན་འབྱུང་གཏེར་གྱི་ལྷ།",
    "སྔོན་བསགས་རྒྱུ་དང་ལས་ལ་མ་ལྟོས་པར།",
    "འབད་དང་རྩོལ་བ་མི་དགོས་པར།",
    "མ་འབྱོར་ཚེ་ཚར་དུ་དངར་བའམ་བཀོད་ལེགས་པར་གཅལ་དུ་བཀྲམ་ནས།",
    "ལྷུང་བཟེད་བདུད་རྩིར་ས་གང་བ་ལེགས་པར་བསྣམས།",
    "རང་གཞན་ཀུན་གྱི་སྡིག་ལྟུང་མ་ལུས་བཤགས།",
    "སྲིད་མཐའི་བར་དུ་བཞུགས་པར་གསོལ་བ་འདེབས།",
    "ཕྱོགས་བཅུའི་རྒྱལ་བ་སྲས་དང་བཅས་པ་ཐམས་ཅད་ཀྱི་སྐུ་གསུང་ཐུགས་ལ་པའི་སྤྲིན་བསམ་གྱི་མི་ཁྱབ་པ་ཕུལ་བས་མཉེས་པར་བྱས།",
    "རྒྱལ་བ་སྲས་དང་བཅས་པ་ཐམས་ཅད་ཀྱི་མཁྱེན་བརྩེ་ནུས་གསུམ་གྱི་ཡོན་ཏན།",
    "སྟོང་ཕྲག་བརྒྱད་ཅུའི་བགེགས་འཇོམས་པ་ལ་མཐུ་སྟོབས་ནུས་པ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་བྱིན་གྱིས་བཅུ་གསུམ་བརླབ་པར་གྱུར།",
    "ཡུན་གྱི་སྒྲིབ་པ་བག་ཆགས་དང་བཅས་པ་ཐམས་ཅད་བྱང་ཞིང་དག་པར་བྱེད་ནུས་པའི་རང་བཞིན་དང་ལྡན་པར་བྱིན་གྱིས་བརླབ་པར་གྱུར།",
    "བསྔོ་སྨོན་ཤིས་བརྗོད་ཅི་རིགས་ཀྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "རྨོངས་པ་འདུ་གསུམ་པ་ཤཱ་ས་ན་བྲི་ཏིའམ་རོལ་རྡོར་བས་དབེན་གནས་མཁའ་སྤྱོད་གླིང་ནས་རིན་ཆེན་རིལ་སྒྲུབ་ལ་གཞི་བྱས་ནས་གང་ཤར་སུག་ལས་བགྱིས་པའོ།",
    "ལུས་ནི་ཞིང་རྡུལ་མཉམ་པར་རབ་སྤྲུལ་ནས།",
    "འགྲོ་ཀུན་རྣམ་དག་ཞིང་ལ་སྤྱོད་པར་ཤོག།",
    "དགེ་ཞིང་བཀྲ་ཤིས་པར་གྱུར་ཅིག།",
    "སྡིག་བཤགས་དགེ་ལ་རྗེས་ཡི་རང་།",
    "བཞེས་ནས་ཚོགས་གཉིས་མྱུར་རྫོགས་ནས།",
    "སྡིག་བཤགས་དགེ་ལ་རྗེས་ཡི་རང་།",
    "བཞེས་ནས་ཚོགས་གཉིས་མྱུར་རྫོགས་ནས།",
    "སྡིག་བཤགས་དགེ་ལ་རྗེས་ཡི་རང་།",
    "བཞེས་རོལ་ནས་ཚོགས་གཉིས་མྱུར་རྫོགས་ནས།",
    "སྡིག་རྗེའི་བཤགས་དགེ་ལ་རྗེས་ཡི་རང་།",
    "བཞེས་ནས་ཚོགས་གཉིས་མྱུར་རྫོགས་ནས།",
    "ལྔ་ཕྲག་ལྔའི་རྫས་དང་གཏེར་རྫས་སམ་གཡང་རྫས་སུ་འོས་པ་ཐམས་ཅད་ཚོགས་པར་བྱས་ལ་ཁ་ལེགས་པར་བཀང་བའི་དབུས་སམ་སྟོད་དུ།",
    "ཞེས་པ་གསེར་དངུལ་མཚལ་སྣག་གང་འབྱོར་གྱིས་བྲིས་ལ་ཞལ་ནང་བསྟན་དབུ་ནས་ལེགས་པར་དྲིལ་ཏྲེ་ན་བཟའ་ཕུལ་ནས་རབ་གནསརོལ་དང་ལྡན་པར་བྱས་ལ་གཞུག།",
    "འོད་འཕྲོས་འཕགས་མཆོག་འགྲོ་དོན་བྱས།",
    "ལྷ་སྐུ་འོད་གསལ་དབྱིངས་སུ་བསྡུས།",
    "མཚན་དཔེ་གསལ་རྫོགས་འོད་ཀྱིས་བཞུགས།",
    "སྤྱན་དྲངས་གཉིས་སུ་མེད་པར་བསྟིམས།",
    "དོན་གཉིས་དཔལ་ལ་སྤྱོད་པར་ཤོག།",
    "འོད་དམར་རྣམ་པར་ལྟེམ་གྱིས་བསྡུས།",
    "ནོངས་བཤགས་བརྟན་བཞུགས་བསྔོ་སྨོན་ཤིས་པ་བརྗོད་པ་སོགས་ཀྱི་དེ་ལྟར་གྲུབ་པར་བྱའོ།",
    "། སྒྲོལ་མའི་མཎྜལ་བཞི་ཆོག་ཤིན་བསྡུས་དོན་གཉིས་ལྷུན་འགྲུབ་ཅེས་བྱ་བ་བཞུགས་སོ།",
    "རོལ་འོག་ཏུ་དགོས་པའི་མཎྜལ་ཞིག་ཀྱང་སྟ་གོན་བྱས་ལ།",
    "ཀུན་སློང་གཞན་ཕན་དོན་གཉེར་གྱི་བསམ་པ་རྣམ་པར་དག་པའི་ངང་ནས།",
    "ཅེས་སྐྱབས་སེམས་བྱས་ནས།",
    "དངོས་རྣམས་མ་ལུས་ཇི་བཞིན་མཁྱེན་གྱུར་པའི།",
    "འགྲོ་བའི་དོན་དུ་བཞུགས་ནས་ཀྱང་།",
    "མཆོག་རྣམས་ལེགས་པར་བསྩལ་ཏུ་གསོལ།",
    "ཞེས་སྤྱན་དྲངས་ཤིང་རྟེན་ལ་བཞུགས་སུ་གསོལ།",
    "འགྲོ་ཀུན་རྣམ་དག་ཞིང་ལ་སྤྱོད་པར་ཤོག།",
    "འགྲོ་ཀུན་རྣམ་དག་ཞིང་ལ་སྤྱོད་པར་ཤོག།",
    "འགྲོ་ཀུན་རྣམ་དག་ཞིང་ལ་སྤྱོད་པར་ཤོག།",
    "འགྲོ་ཀུན་རྣམ་དག་ཞིང་ལ་སྤྱོད་པར་ཤོག།",
    "འགྲོ་བའི་དོན་དུ་བཞུགས་ནས་ཀྱང་།",
    "ལྟ་མཆོག་རྣམས་ལེགས་པར་བསྩལ་ཏུ་གསོལ།",
    "ཞེས་རྟེན་ལ་མེ་ཏོག་འཐོར་ཞིང་བརྟེན་བཞུགས་བྱ།",
    "བཞེས་ཏེ་རང་གཞན་ཚོགས་གཉིས་མྱུར་རྫོགས་ཤོག།",
    "བཞེས་ཏེ་རང་གཞན་ཚོགས་གཉིས་མྱུར་རྫོགས་ཤོག།",
    "འདུ་གསུམ་པ་རོལ་རྡོར་བས་མཁའ་སྤྱོད་གླིང་ནས་མགྱོགས་པར་བྲིས་པ་དགེ།",
    "བའི་རྗེའི་རྡོ་། སྒྲོལ་མའི་ཚེ་འགུགས་བསྡུས་པ་བཞུགས།",
    "འོད་ལྔའི་རྣམ་པར་ཚུར་བསྡུས་ནས།",
    "ཤ་། ། སྒྲོལ་མའི་གཡང་འབོད་བསྡུས་པ་བཞུགས།",
    "ཁྱད་པར་འཕགས་མ་སྒྲོལ་མའི་ལྷ་ཚོགས་ཀྱི།",
    "རོལ་། སྒྲོལ་མའི་དགྲ་མནན་བསྡུས་པ་བཞུགས།",
    "དགེའོ། ། སྒྲོལ་མའི་བཟློག་བསྒྱུར་བསྡུས་པ་བཞུགས།",
    "དེའི་སྟེང་དུ་འབོའམ་ཀ་ཏོར་སོགས་སྣོད་ཆེ་ལེགས་གས་ཆག་བུག་རྡོར་མེད་པ་དག་གཙང་ཡིད་དུ་འོང་བའི་ནང་གྲོའམ་ནས་དཀར་གང་རིགས་ཀྱིས་བཀང་བའི་ཁར་ལྷུང་བཟེད་ཚད་ལྡན་འབྲས་སམ་འབྲུ་དཀར་གྱི་བཀང་བ་བཞག།",
    "སང་ཞོགས་ཐོ་རངས་དུས་སྔ་བར་ལངས་ནས་ཁྲུས་དང་གཙང་སྦྲ་ལེགས་པར་བྱས།",
    "གོས་གསར་བ་མཛེས་པར་གྱོན་ལ།",
    "སྭ་བྷཱ་ཝའི་སྔགས་ཀྱིས་ཐམས་ཅད་སྟོང་པར་སྦྱངས།",
    "མགྲིན་པར་གསུང་རྡོ་རྗེའི་ངོ་བོར་དམར་པོ།",
    "མཐར་གོང་བཞིན་མཆོད་བསྟོད་བྱས་ལ།",
    "རྐྱེན་ངན་སྡིག་སྒྲིབ་བག་ཆགས་དང་བཅས་པ་ཐམས་ཅད་ལྷག་མེད་དུ་བྱང་ཞིང་དག་སྟེ་ལུས་དྭངས་གསལ་ཤེལ་གྱི་གོང་བུ་གཡའ་དག་པ་ལྟ་བུར་གྱུར་པར་བསམ།",
    "མི་ནུབ་པའི་རྒྱལ་མཚན་ལྟ་བུ་གཞོམ་གཞིག་བགྲེས་རྒུད་སྐྱེ་འཆི་འཕོ་འགྱུར་ཐམས་ཅད་དང་བྲལ་བའི་འཆི་མེད་རྡོ་རྗེའི་སྐུ་མཆོག་དམ་པ་ཐོབ་པར་གྱུར་པར་བསམ།",
    "རྔུལ་བ་སོགས་ངེས་པར་སྤང་བ་གལ་ཆེའོ་གསུངས།",
    "སྐུ་ཚེ་དཔག་མེད་བཞུགས་པའི་སྟོན་འཁོར་ཚོགས།",
    "གནོང་འགྱོད་དཔག་མེད་ལྡན་པས་མཐོལ་ཞིང་བཤགས།",
    "མྱ་ངན་མི་འདར་བཞུགས་གསོལ་དཔག་མེད་འདེབས།",
    "སྐྱེས་ཏེ་བདེ་དགའ་དཔག་མེད་ལྡན་པར་ཤོག།",
    "ཐམས་ཅད་བདེ་བ་ཅན་དུ་ངོ་མཚར་བའི་ལྟས་བཟང་དཔག་ཏུ་མེད་པ་དང་བཅས་ཏེ་དྲངས་ནས་ཞིང་ཁམས་ཀྱི་དཔལ་ལོངས་སུ་སྤྱོད་ཅིང་ས་ལམ་གྱི་ཡོན་ཏན་ཐམས་ཅད་སྐད་ཅིག་ལ་རྫོགས་ནས་འཕགས་པའི་གོ་འཕང་མྱུར་ཏུ་ཐོབ་པར་གྱུར།",
    "ཅེས་སོགས་བདེ་སྨོན་རྒྱས་བསྡུས་ཅི་རིགས་དང་ཤིས་བརྗོད་ཀྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "རྨོངས་རྟུལ་འཆིང་བ་ཀུན་ལྡན་ཝ་གཱིནྡྲའམ་རོལ་རྡོར་བས་གང་ཤར་མགྱོགས་པར་དབེན་གནས་མཁའ་སྤྱོད་གླིང་ནས་སུག་ལས་བགྱིས་པའོ།",
    "ཀུན་སློང་ལེགས་པར་བཅོས་ལ།",
    "བདག་མདུན་ལྷ་ཚོགས་རྣམས་ལ་བསྟོད་པར་བགྱི།",
    "ལེགས་པར་བཞེངས་ལ་ཕྱི་ནང་བར་ཆད་ཀུན།",
    "གཙང་ལ་དྲི་རབ་བའི་རྡོ་བསྒོས་པས་སྐུ་ཕྱིའོ།",
    "ཞེས་ཁྲུས་གསོལ་དང་སྐུ་བྱི་སོགས་བྱས་ལ།",
    "སྒོ་གསུམ་དང་བའི་ཀུན་ནས་བསྟོད་པར་བགྱི།",
    "ཀུན་མཁྱེན་ཡེ་ཤེས་སྤྱན་ལྡན་སྐྱོན་བྲལ་ཡང་།",
    "ཞེས་སྤྱན་དབྱེ་བྱས་ལ།",
    "ཕྱོགས་བཅུར་བཞུགས་པའི་རྒྱལ་བ་སྲས་བཅས་དགོངས།",
    "མྱ་ངན་མི་འདའ་རྟེན་ལ་བརྟན་བཞུགས་ནས།",
    "རྣམ་སྣང་འོད་དུ་ཞུ་བ་ལས་སྐུ་རྟེན་སོ་སོའི་རྣམ་པར་གྱུར་པར་བསམ་ལ།",
    "རྒྱལ་སྲས་དཔའ་བོའི་སྤྱོད་དང་མཚུངས་པར་ཤོག།",
    "རྣམ་གྲོལ་བདེ་ཆེན་གླིང་དུ་འདྲེན་པར་ཤོག།",
    "ཅེས་སོགས་བསྔོ་སྨོན་ཤིས་བརྗོད་ཅི་རིགས་ཀྱིས་མཐའ་བརྒྱན་པར་བྱའོ།",
    "དགེ་ཞིང་བཀྲ་ཤིས་པར་གྱུར་ཅིག།",
    "འབུམ་། གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མའི་གཟུངས་བཀླག་ཐབས་འཆི་མེད་གྲུབ་པ་མཆོག་སྦྱིན་ཞེས་བྱ་བ་བཞུགས་སོ།",
    "འདིར་གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མའི་གཟུངས་འདོན་ཐབས་བདག་མདུན་གང་ལྟར་བྱེད་ཅིང་།",
    "རྣམ་པར་རྒྱལ་བའི་མཆོད་རྟེན་བང་རིམ་གསུམ་པ་བུམ་རྟེན་དང་བཅས་པའི་བུམ་པ་ཟླུམ་པོ་ཡངས་ཤིང་རྒྱ་ཆེ་བ་སྒོ་དང་བཅས་པའི་སྟེང་དུ་བྲེ།",
    "གཉིས་པས་སྐྱབས་སྦྱིན་གྱི་ཕྱག་རྒྱས་རྒྱུད་ལྔའི་འགྲོ་བ་རྣམས་འཇིགས་པ་ཐམས་ཅད་ལས་སྐྱོབ་པར་རྗེའི་གསུང་མཛད་པ།",
    "པདྨ་དང་ཟླ་བའི་གདན་ལ་ས་གཉིས་བཞེངས་པའི་སྟབས་ཀྱིས་བཞུགས་པ།",
    "ཡེ་ཤེས་ཀྱི་མེ་འབར་བའི་དབུས་ན་པདྨ་དང་ཉི་མའི་གདན་ལ་ཞབས་གཡས་བསྐུམ་ཞིང་གཡོན་བརྐྱང་བའི་སྟབས་ཀྱིས་བཞུགས་པའོ།",
    "ཕྱོགས་བཅུའི་རྒྱལ་བ་སྲས་དང་བཅས་པ་ཐམས་ཅད་གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མའི་ལྷ་ཚོགས་ཀྱི་རྣམ་པར་སྤྱན་དྲངས་ཏེ་ཁ་ཆར་བུ་ཡུག་འཚུབ་པ་བཞིན་བྱིན་ཐིབ་ཀྱིས་བྱོན་ནས་མདུན་གྱི་ལྷ་ཚོགས་རྣམས་ལ་སིབ་ཀྱིས་ཐིམ་པས།",
    "དེ་ཉིད་བསླུ་མེད་སྐྱབས་གནས་ཐམས་ཅད་འདུས་རོལ་པའི་བདག་ཉིད་ཅན་དུ་གྱུར་པར་བསམ།",
    "མགྲིན་པར་ཨཱ་དམར་པོ།",
    "གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མའི་གོ་འཕང་ལ་བཀོད།",
    "ལྷ་ཚོགས་རྟེན་དང་བརྟེན་པར་བཅས་པ་ཐམས་ཅད་འོད་དུ་ཞུ་ནས་རང་ལ་ཐིམ་ཞིང་།",
    "༧ ཞེས་གཙུག་ཏོར་རྣམ་པར་རྒྱལ་མའི་གཟུངས་བཀླག་ཐབས་འཆི་མེད་གྲུབ་པ་མཆོག་སྦྱིན་ཞེས་བྱ་བ་འདི་ཡང་།",
    "པོད་། གནམ་ལྕགས་ཐོག་སྲུང་འཇིགས་པ་ཀུན་སྐྱོབ་བཞུགས།",
    "༡། སེར་ལམ་ལ་བསྒྱུར་རྟོགས་ལྡན་རྒན་པོའི་མན་ངག་བཞུགས།",
    "མཆོད་སྦྱིན་གསེར་སྐྱེམས་འདི་བཞེས་ལ།",
    "འདི་རུ་མ་གནོད་བྱམས་པར་མཛོད།",
    "སྔངས་སྐྲག་འཇིགས་པར་མ་མཛད་ལ།",
    "གསེར་སྐྱེམས་གཡུ་སྐྱེམས་བསང་མཆོད་བཞེས།",
    "བྱོན་བཞུགས་རྫུ་འཕྲུལ་ཐོགས་མེད་ལྡན་རྣམས་ལ།",
    "སརྦ་མངྒ་ལཾ། ། ཐོག་སྲུང་རྡོ་རྗེའི་གོ་ཆ་བཞུགས།",
    "མཆོད་སྦྱིན་གཏོར་མ་འདི་བཞེས་ལ།",
    "མཆོད་སྦྱིན་གཏོར་མ་འདི་བཞེས་ལ།",
    "མཆོད་སྦྱིན་གཏོར་མ་འདི་བཞེས་ལ།",
    "ཅེས་པས་བགེགས་བསྐྲད་པར་བྱའོ།",
    "རོལ་། རྒྱལ་ཐོ་བསྐྱེད་ཆོག་བཞུགས་སོ།",
    "ཕྱག་གཉིས་དྲི་ཟའི་རྒྱུད་མངས་སྙན་པར་བརྡུངས།",
    "ཞབས་ལ་སག་ལྷམ་གྱིས་མཛེས་རོལ་སྟབས་བཞུགས།",
    "ཆུ་ལ་ཆུ་བཞིན་དབྱེར་མེད་ཐིམ་པར་གྱུར།",
    "བའི་རྡོ་མཆོད་སྦྱིན་གཏོར་མ་འདི་བཞེས་ལ།",
    "ཁྱད་པར་རྣལ་འབྱོར་སྒྲུབ་པ་པོའི།",
    "རྒྱལ་བ་སྲས་བཅས་དགྱེས་བཞིན་བརྟན་པར་བཞུགས།",
    "ཐོ་འདིར་དབྱེར་མེད་བརྟན་པར་བཞུགས་སུ་གསོལ།",
    "བཞུགས་ནས་བར་ཆད་ནང་དུ་མི་གཏོང་ཞིང་།",
    "ཞེས་བརྗོད་ཅིང་མེ་ཏོག་འཐོར་ལ་བརྟན་བཞུགས་བྱ།",
    "ཡིག་བརྒྱ་བཟོད་གསོལ་བྱས་ནས།",
