    "རྒྱལ་བ་རབ་འབྱམས་ཀྱི་སྤྱི་དཔལ་ཆེན་པོ་ཡིན་པར་ངེས་པ་གཅིག་རྗེའི་འདྲོང་དགོས་ཏེ།",
    "ཏིལ་གྱི་གོང་བུ་ཕྱེ་བཞིན་མ་འདྲེས་པར།",
    "དགྱེས་བརྩེས་བདག་ལ་དགོངས་བཞིན་བཞུགས་པ་གྱུར།",
    "མ་རིག་འཁྲུལ་རྟོག་གཉིས་འཛིན་རང་སར་བཤགས།",
    "ཀ་དག་གནས་ལུགས་རྟོགས་པར་བྱིན་གྱིས་རྗེའི་གླུ་རློབས།",
    "ཅེས་པའི་མཐའ་བརྒྱན་པར་བྱའོ།",
    "ལྟ་ལོག་མུ་སྟེགས་ཚོགས་བཅས་ཕམ་པར་བྱས།",
    "ད་ལྟ་རྔ་ཡབ་པདྨ་འོད་དུ་བཞུགས།",
    "བསམ་དོན་ཐམས་ཅད་ལྷུན་གྱིས་འགྲུབ་པར་མཛོད།",
    "གཞོན་ནུ་བུམ་སྐུར་གཏན་སྲིད་ཟིན་པར་ཤོག།",
    "རང་རྒྱུད་རྒྱལ་བའི་བཀའ་དང་རྒྱབ་འགལ་བྱས།",
    "གསོད་པར་འཁྲིད་པའི་འཇིགས་པ་ཆེན་པོ་ལྟར།",
    "མིང་ཙམ་མེད་པར་དབྱིངས་སུ་ཞི་བར་མཛོད།",
    "དཔལ་རི་པདྨ་འོད་དུ་འཁྲིད་པར་ཤོག།",
    "སྲོག་ཆགས་འཚེ་བའི་རིགས་ཀུན་མེད་པར་མཛོད།",
    "དབུལ་ཕོངས་སེལ་ཞིང་བཅུད་གཡང་དབབ་པར་མཛོད།",
    "ནམ་ཡང་རྗེས་ཤུལ་ཙམ་ཡང་མེད་པར་མཛོད།",
    "ཕྱོགས་དུས་ཀུན་ཏུ་དར་ཞིང་རྒྱས་པར་མཛོད།",
    "ཞབས་པད་བརྟན་ཅིང་མཛད་འཕྲིན་རྒྱས་པར་མཛོད།",
    "བདེ་སྐྱིད་ཉི་མ་གསལ་བས་ཁྱབ་པར་མཛོད།",
    "བཀྲ་ཤིས་དཔལ་གྱིས་རྟག་ཏུ་ཕྱུག་པར་ཤོག།",
    "རོལ་ན་གུ་ཎ་པ་ཝ་གཱིནྡྲའམ་རོལ་རྡོར་བས་མི་འགྱུར་ལྷ་མཐོ་གོང་མ་ནས་གང་ཤར་མགྱོགས་པར་སུག་ལས་བགྱིས་པའོ།",
    "རྡོ་རྗེའི་མཆེད་ལ་ཞེ་འགྲེས་ངན་ཤག་འགྱེད།",
    "རང་བྱས་ལས་ཀྱི་ལ་ཡོག་རང་སྟེང་ལ།",
    "གསོལ་བ་གསུང་འབུམའདེབས་སོ་ཨོ་རྒྱན་ཆེན་པོ་མཁྱེན།",
    "ཐུགས་རྗེས་ཟུངས་ཤིག་རྔ་ཡབ་གླིང་པ་མཁྱེན།",
    "དངོས་གྲུབ་སྩོལ་ཅིག་པདྨ་འོད་འབར་མཁྱེན།",
    "ཐ་ཤལ་བ་ཝ་གཱིནྡྲའམ་རོལ་རྡོར་བས་བཀྲ་ཤིས་ལྷ་སྒང་ནས་ཤར་མར་སོར་རྩེའི་འདུ་བྱེད་བགྱིས་པའོ།",
    "མཁའ་ཁྱབ་ཡིད་ཅན་སྤྱི་དང་ཁྱད་པར་གྱི་གདུལ་ཞིང་།",
    "གངས་ཅན་གདོང་དམར་སྤྲེའུའི་ཚ་བུ་རྣམས་ཡིན་པར།",
    "ལན་གཅིག་མིན་པར་རྡོ་རྗེའི་གསུང་དབྱངས་ཀྱི་ལམ་ནས།",
    "ཡང་དང་ཡང་དུ་ཞལ་བཞེས་དམ་བཅའ་རང་གནང་ལ།",
    "ནམ་ཡང་གཡེལ་བ་མེད་པར་འགྲོ་བའི་དོན་མཛད་ན།",
    "ལེགས་པར་བསགས་ནབའི་རྡོ་པའི་ནོར་རྫས་པདྨོའི་ཚལ་ཡངས་པོ།",
    "རྗེས་ཤུལ་མེད་པར་བརྩེ་བའི་ངང་ཚུལ་ནི་འདི་དག།",
    "བརྩེ་ཆེན་ཐུགས་རྗེ་དམ་པར་ཕྱི་བཤོལ་དེ་བྱུང་ངམ།",
    "ཀྱེ་ཧོ་མཁྱེན་ནུས་རྩལ་གྱིས་འཇུག་ཡུལ་ནི་མིན་ན།",
    "མཚོ་སྐྱེས་རྒྱལ་བའི་ཐུགས་རྗེས་དགོངས་ཡུལ་དེ་གང་ལགས།",
    "ཅི་བྱ་འདི་བྱེད་མེད་པར་ཐབས་སྡུག་ཏུ་གྱུར་ན།",
    "འགྱེལ་བས་འགྱེལ་བར་བོས་དང་ཁྱད་པར་ནི་ཅི་བདོག།",
    "ནམ་ཡང་བསླུ་བར་མི་འགྱུར་གསུངས་པས་ཚུལ་རྗེའི་རྫུན་ནམ།",
    "གསུངས་པའི་པད་འབྱུང་རྣམས་ནི་གང་ཞིག་ན་བཞུད་དམ།",
    "གསུངས་པའི་མཐུ་རྩལ་སྟོབས་ནུས་གསུང་འབུམབོར་སྟོར་དེ་བྱུང་ངམ།",
    "གབ་སྐུང་བཙན་པོར་གཟུགས་སྐུ་ར་སྦས་ནས་རང་བཞུགས་སམ།",
    "དགོད་གཤེ་དྲག་ཤུལ་ང་རོས་སྟོང་གསུམ་ཀུན་ཁྱབ་པར།",
    "མཁའ་ཁྱབ་འགྲོ་བ་སྤྱི་དང་ཁྱད་པར་དུ།",
    "བསམ་པའི་དོན་ཀུན་མྱུར་ཏུ་འགྲུབ་པར་མཛོད།",
    "བར་ཆད་ཀུན་སོལ་མཐུན་རྐྱེན་འགྲུབ་པར་མཛོད།",
    "མྱུར་ཏུ་བཟློག་ཅིང་བསྒྱུར་ཅིག་ཨོ་རྒྱན་མཁྱེན།",
    "བཟློག་བསྒྱུར་པོདཞི་བར་མཛོད་ཅིག་ཨོ་རྒྱན་མཁྱེན།",
    "ཞི་བཟློག་རྨག་མེད་མཛོད་ཅིག་ཨོ་རྒྱན་མཁྱེན།",
    "དོན་གཉིས་དཔལ་ལ་སྦྱོར་ཅིག་ཨོ་རྒྱན་མཁྱེན།",
    "བསྒྲལ་ནས་གདོད་མའི་རྒྱལ་སར་འགོད་པར་ཤོག།",
    "ཕན་པར་སྨྲ་ཞིང་གནོད་ལ་སྦྱོར་བྱེད་པའི།",
    "མ་ལུས་རྗེས་ཤུལ་ཙམ་ཡང་མེད་པར་མཛོད།",
    "ཇི་ལྟར་གསོལ་བ་བཏབ་བཞིན་འགྲུབ་པར་ཤོག།",
    "འཕྲིན་ལས་རབ་འབྱམས་ལྷུན་གྱིས་འགྲུབ་པར་གསོལ།",
    "བདེ་ཆེན་ཞིང་དུ་འདྲེན་པར་མཛད་དུ་གསོལ།",
    "དུས་ཀུན་ལོངས་སུ་སྤྱོད་པར་མཛད་དུ་གསོལ།",
    "གདོད་མའི་གནས་ལུགས་རྟོགས་པར་བྱིན་གྱིས་རློབས།",
    "འོད་གསལ་རྒྱུན་ཆད་མེད་པར་བྱིན་གྱིས་རློབས།",
    "མཆོག་ཐུན་དངོས་གྲུབ་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "ལས་བཞི་ལྷུན་གྱིས་འགྲུབ་པར་བྱིན་དགྱིས་རློབས།",
    "ལས་བཞིའི་འཕྲིན་ལས་ཐོགས་མེད་སྒྲུབ་པར་མཛོད།",
    "བསམ་དོན་འབད་མེད་ལྷུན་གྱིས་འགྲུབ་པར་མཛོད།",
    "རྡོ་རྗེའི་སྐུ་མཆོག་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "རྡོ་རྗེའི་གསུང་མཆོག་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "རྡོ་རྗེའི་ཐུགས་མཆོག་ཐོབ་པར་བྱིན་གྱིས་རློབས།",
    "གང་འདུལ་ཐབས་ལ་མཁས་པར་བྱིན་གྱིས་རློབས།",
    "གནོད་ཅིང་འཚེ་བྱེད་གདུག་ཅན་མ་ལུས་པར།",
    "ཀུན་བཟང་དགོངས་ཀློང་ཡངས་པར་གྲོལ་གྱུར་ཅིགརྗེའི་༧ ཅེས་པ་འདི་ཡང་འགྱུར་མེད་དད་པའི་རྒྱུན་ལྡན་བཙུན་མ་ཐུབ་བསྟན་མཚོའི་ངོར།",
    "ཡང་དག་ལམ་ལ་གོལ་འཆུག་མེད་པར་གསོལ།",
    "རང་རིག་ཡེ་ཤེས་མངོན་དུ་སད་པར་གསོལ།",
    "བོད་འབངས་འགྲོ་བ་སྐྱོབ་ཅིག་མཆོག་གསུམ་མཁྱེན།",
    "མཁྱེན་ནོ་རྩ་གསུམ་རྒྱལ་བ་རབ་འབྱམས་མཁྱེན།",
