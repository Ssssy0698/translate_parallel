    "ཕར་ཕྱེ་ན་དྲུག་དྲུག་སུམ་ཅུ་རྩ་དྲུག་ལ་སོགས་པ་དཔག་ཏུ་མེད་པ་མཛད་པར་འདུག་དེ་ཡང་བཅོམ་ལྡན་འདས་མགོན་པོ་བྱམས་པས་ཕ་རོལ་ཏུ་ཕྱིན་པ་དྲུག་ལ་དྲུག་དྲུག་སུམ་ཅུ་སོ་དྲུག་ཏུ་མཛད་པ་དང་གོ་བསྟུན་ནས།",
    "དེས་འདའ་བར་འདོད་པ་ཡང་མང་བར་འདུག།",
    "དེ་ཡང་རང་ལ་ངེས་པའི་ཤེས་པ་ཞིག་གཏིང་ནས་སྐྱེ་བར་འོང་།",
    "སྒོམ་བྱེད་པ་ལ་ངེད་རང་ཀུན་དྲག་པར་འདུག་ཟེར་བ་ལ།",
    "སྤྱན་སྔ་ནས་དེ་ཁོ་ཤིན་ཏུ་བདེན་པར་འདུག་གསུངས།",
    "ཨོྃ་བཛྲ་བེ་རོ་ཙ་ནཱི་ཡེ་ཧུཾ་ཧཱུྃ་ཕཊ།",
    "འགྲོ་འདུག་ལ་སོགས་པའི་སྤྱོད་ལམ་ཐམས་ཅད་ཀྱང་གོ་ལེ་བྱས་ཏེ།",
    "གནས་འགྱུ་གཉིས་ལ་ཁྱད་པར་འདུག་གམ་མི་འདུག་ལེགས་པར་ལྟོས།",
    "ཡང་སྔར་བཞིན་བསྒོམ་ཞིང་ལེགས་པར་ཐག་བཅད་པས་རྟོག་པ་ལ་མ་འགགས་པ་དེ་རང་གསལ་སྟོང་དུ་རྗེན་རྗེན་འདུག།",
    "འདོད་ཆགས་གཞི་མེད་རྩ་བྲལ་དུ་ཤར་ཙ་ན་འདོད་ཆགས་མ་སྤངས་པར་རང་སར་དག།",
    "རང་བྱུང་རང་ཞི་རང་དགར་བཞག།",
    "མུ་དྲའི་ཕྱག་རྒྱ་སླང་ང་ཙམ་གཅིག་དང་གསུམ་བྱོན་པ་ཡིན་པར་གདའ།",
    "ཕྱིས་ཡབ་ཡུལ་དུ་བྱོན་ནས་ཉེ་དུ་གཉེན་འབྲེལ་གང་ཡང་མི་གདའ།",
    "ཞིང་ལ་འཇག་མ་འཕྱུར་ནས་ཉམས་ཤིན་ཏུ་མི་དགའ་བར་གདའ་སྐད།",
    "ལུང་བསྟན་བྱུང་བ་ལགས་པར་གདའ།",
    "དེས་སྐྱོ་ཞིང་དུབ་ན་ཚར་གཅད་པ་དང་རྗེས་སུ་བཟུང་བ་དང་རང་སོར་བཞག་པ་དང་གསུམ་གྱིས་ཉམས་སུ་བླང་བར་བྱའོ།",
    "ཕྱིས་ཐོང་ནུབ་ཆེས་ནས་ཡར་མ་ཐོན་པ་ལ་སོགས་རྨི་ལམ་བྱུང་བ་ལེགས་པར་གདའ།",
    "འོ་སྐོལ་བོད་ན་སྒོམ་ཆེན་ཤིན་ཏུ་མང་བར་འདུག་པ་ལ།",
    "གྲུབ་ཐོབ་ཉུང་བ་དེ་ཅིས་ལན་སྙམ་དུ་དགོངས་ཙ་ན།",
    "འདུག་ན་ཡང་ཡི་དམ་གྱི་ལྷ།",
    "གདོད་ནས་གྲུབ་མ་མྱོང་ཙ་ན་གནས་པ་དང་འགག་པ་ཡང་མེད་དེ།",
    "ཁྱེད་སྒྱུ་ལུས་འབྱོངས་པའི་ཁ་པོ་གཏོང་བར་འདུག་པས་དེ་སྐད་བྱས་པ་ཡིན་གསུངས་པས།",
    "ཁོང་སྐྱེངས་པ་ལགས་པར་གདའ་བས་དེ་ལ་དགོངས་ནས་ཆེད་དུ་གསུངས་པ་ནགས་ཤོད་མར་གྲགས་སོ།",
    "འཇིག་རྟེན་གྱི་བྱ་བཞག་ཀྱང་རྫུན་པོར་གདའ།",
    "ཀྭ་བློ་གཏད་གྲོགས་འདུས་ནས་འབྲལ་བ་མཐོང་ཙ་ན།",
    "གཉེན་ཉེ་དུའི་གདུང་སེམས་ཀྱང་རྫུན་པོར་གདའ།",
    "སྒྱུ་ཤེད་དང་དཔའ་རྩལ་ཡང་རྫུན་པོར་གདའ།",
    "ནོར་བསགས་ནས་འཛད་པ་མཐོང་ཙ་ན།",
    "སེར་སྣ་དང་སྡུག་གསོག་ཀྱང་རྫུན་པོར་གདའ།",
    "ཀྭ་བློ་གཏད་ཅིག་སྐྱེ་འཆིའི་སྡུག་བསྔལ་མཐོང་ཙ་ན།",
    "ཁྲོམ་ལྷ་མིའི་བདེ་སྐྱིད་ཀྱང་རྫུན་པོར་གདའ།",
    "ཀྭ་བློ་གཏད་ཅིག་འདུག་གམ་མི་འདུག་སོམས།",
    "གདུལ་བྱའི་ཕྱོགས་རིས་ཀྱང་རྫུན་པོར་གདའ།",
    "རང་གཅེས་འཛིན་གྱི་ཞེ་འདོད་ཀྱང་རྫུན་པོར་གདའ།",
    "བདུད་བར་ཆད་དང་གོལ་ས་ཡང་རྫུན་པོར་གདའ།",
    "རང་སེམས་མངོན་དུ་གྱུར་ཙ་ན།",
    "གྲངས་མེད་གསུམ་ཡང་རྫུན་པོར་གདའ།",
    "འདིར་མི་ཚུགས་པ་འདུག་སྙམ་པའམ།",
    "སྤྱིར་གནས་གང་དུ་ཡང་ཡུན་རིང་པོ་འདུག་པའི་བསམ་པ་བཞག་ན་མི་ཟུག་པ་ཡིན་པས།",
    "དེ་དག་རང་རང་གང་འདོད་ཀྱི་འདོད་ཡོན་དང་ལྡན་ཏེ།",
    "ལྟས་བཟང་བ་ཀུན་འགྲོར་འཇུག་པ་ཡིན་པར་གདའ།",
    "འདོད་ཕྱོགས་སུ་རྒྱུ་བར་འདུག།",
    "འདིས་ཀྱང་བདེ་བ་སྐྱེད་པར་འདུག་སྟེ།",
    "བག་ཁུམ་ལྡོག་དོགས་ཤིག་འདུག་པས་སྔ་མ་གཉིས་པོ་རང་གཙོ་ཆེར་བྱའོ།",
    "འདི་ལ་ཁྱེད་ཀྱི་འཕྲིག་ཨེན་ཙམ་ཚུད་པར་འདུག།",
    "རང་རང་སོ་སོའི་གནས་ནས་འདིར་གཤེགས་ལ།",
    "རང་རང་མཐུན་པའི་གདན་ལ་བཞུགས།",
    "མགྲོན་རྣམས་རང་རང་སོ་སོའི་གནས་སུ་གཤེགས།",
    "རང་རང་མཐུན་པའི་གདན་ལ་དགྱེས་པར་བཞུགས།",
    "རང་རང་བློ་དང་མཚམས་པའི་གདན་ལ་བཞུགས།",
    "དུར་ཁྲོད་བརྒྱད་དང་རང་ལུས་ཀྱི།",
    "ཡ་ང་བག་ཚ་མི་འདུག་ཀྱང་།",
    "འགྲོ་འདུག་མང་པོའི་ཁ་ན་མེད།",
    "བདག་ཅག་ཉེ་དུ་གཉེན་འབྲེལ་ཤུལ་ན་འདུག་པ་རྣམས་ཀྱིས།",
    "འདུག་སྟེ་ཉན་པར་མ་གྱུར་ན།",
    "དེ་ནས་ཐུབ་པ་དེས་འདི་ལྟར་བསམས་ཤིང་འདུག་སྟེ།",
    "དེ་བས་ན་ཁྱེད་གཅིག་པུ་འདུག་པར་འོས་སོ་ཞེས་ཟེར་རོ།",
    "དེས་ཀྱང་གཟུགས་ལྡན་མ་ལ་མཚོན་ཆ་གཏད་ཅིང་འདུག་གོ།",
    "རབ་ཏུ་བརྐྱང་བར་བྱས་པའི་ཆུ་འཛིན་པའི་ཚོགས་ཀྱིས་ཤིན་ཏུ་སྔོ་བའི་བར་སྣང་ལ་འདུག་སྟེ།",
    "འཆི་བ་དང་ཡང་འབྲེལ་པའི་གཏམ་གྱིས་ནང་མིའི་ཚོགས་དང་བཅས་པའི་ཡབ་ཀྱི་ཡིད་སྐྱོ་བ་བསྐྱེད་ཅིང་འདུག་གོ།",
    "ཆང་ནི་བླུགས་ཤིང་འདུག་པ་ཉིད་དུ་གནས་པར་གྱུར།",
    "མལ་དེ་ལ་འབྲེལ་ནས་ཆང་དེ་མྱང་ཞིང་འདུག་པར་གྱུར་ཏོ།",
    "རི་དྭགས་ཀྱི་ཚོགས་གཉིས་དེ་དབུགས་འབྱིན་ཞིང་གནས་པ་དམག་ཚོགས་ཀྱིས་ཀུན་ནས་བསྐོར་ཞིང་འདུག་གོ།",
    "སྐྱེས་མ་ཐག་ཙམ་འདུག་པ་ནི།",
    "རི་ཤིང་རྣམས་ཀྱང་དེ་ལས་ཟློག་པར་བྱེད་ལྟར་འདུག།",
    "དེ་ནས་རྒྱལ་པོ་དེ་ཡིད་རབ་ཏུ་དགའ་བས་ཚོགས་ཀྱི་བདག་པོ་དེ་སེང་གེའི་ཁྲི་ལ་འདུག་ཏུ་བཅུག་ནས་གུས་པ་དང་བཅས་པས་དམའ་བའི་སྟན་ལ་འདུག་སྟེ།",
    "དེ་རྣམས་ཀྱང་འཆི་བ་ལ་འཇིགས་པས་དེ་ལྟར་བགྱི་ཞེས་ཁས་བླངས་ནས་ཤིན་ཏུ་མཁས་པའི་བྱ་བ་སུ་ཞིག་ལ་དོན་དུ་གཉེར་བར་བྱས་ཏེ་གཏོང་ཞིང་འདུག་གོ།",
    "གྲོགས་པོ་སུ་ཞིག་ལ་གཏམ་དེ་དབེན་པའི་སར་སྨྲ་ཞིང་འདུག་གོ།",
    "འདུག་ཅིང་ལངས་དང་འགྲོ་བའི་རི་དྭགས་འགའ་ཞིག་ཏུ།",
    "འདུག་ཅིང་སོ་སོར་བརྐྱང་བར་གྱིས།",
    "ཅུང་ཟད་གང་ནས་ཀྱང་མྱང་ཞིང་བདག་ཉིད་ཆོག་ཤེས་པ་ལ་ཞུགས་ཤིང་འདུག་གོ།",
    "དེ་བཞིན་སྐྱེ་བོ་འདིས་ཡང་རང་ཉིད་བྱས་པའི་ལས་། སྡུག་བསྔལ་མང་བས་རབ་ཏུ་གནོད་བྱས་འཇིགས་པར་འགྱུར།",
    "དབུགས་འབྱུང་ཞིང་འདུག་པའི་རི་དྭགས་ཀྱི་ཚོགས་དང་ལྡན་པ་དང་།",
    "རིང་པོ་ནས་དོར་བའི་དམག་ཚོགས་ལ་སྡོད་ཅིང་འདུག་གོ།",
    "གླང་པོའི་ཕྲུ་གུ་འདུག་པའི་ཚོང་པའི་ཚོགས་ནི་མཐོང་བར་གྱུར།",
    "ལྷ་ལགས་བདག་ཅག་ནི་བྱང་ཕྱོགས་ནས་འོངས་ཞེས་བྱ་བ་སྨྲ་ཞིང་འདུག་གོ།",
    "དེ་ནས་བྱང་ཕྱོགས་ཀྱི་གཏམ་སྐབས་སུ་བབ་པ་ལ་ཚོང་པ་རྣམས་ཀྱི་བདག་པོ་དེ་རྡོ་རྗེ་དབྱུག་པ་ཅན་ཞེས་བྱའི་རྒྱལ་པོ་ལ་ཆེ་བའི་བདག་ཉིད་བརྗོད་ཅིང་འདུག་གོ།",
    "མཆེ་བ་གཉིས་པའི་དཔུང་པར་གླང་པོ་སྐྱོང་བ་འདུག་པ་ལ།",
    "ཡུད་ཙམ་ཡུད་ཙམ་དུ་ནི་ལུས་ནི་བསྐྱོད་ཅིང་འདུག།",
    "དེ་ནས་གདུག་པའི་བདག་ཉིད་བློ་གྲོས་ངན་པ་དེ་ཡོངས་ནས་བསྒོ་བ་ཞུས་པའི་ཞུགས་པ་རྗེས་སུ་གནང་བ་སྟན་ཡོངས་སུ་འཛིན་པར་བྱས་པ་དབེན་པར་རྒྱལ་པོ་རི་རབ་ལ་མི་བདེན་པའི་ཚིག་རྣམས་ཀྱིས་སྦྱོར་ཞིང་འདུག་གོ།",
    "ཇི་ལྟར་བུང་བ་མི་སྨྲ་བར་ནི་འདུག་པར་གྱུར།",
    "དེ་ཡིས་སེམས་བཟང་རང་བཞིན་གྱིས།",
    "དེས་ཀྱང་དེ་མནོས་ནས་གུས་པ་དང་བཅས་པར་མགོ་བོ་ལ་བཏགས་ཏེ་འདུག་གོ།",
    "མཚོ་ནས་ཀུ་མུ་ཏ་རྣམ་པར་བླངས་ནས་མཆོད་ཅིང་འདུག་གོ།",
    "དེ་ནས་རི་བོའི་ནགས་ཀྱི་ནང་དུ་དེའི་འཆག་པ་མཐོང་ནས་གླང་པོ་ཆེའི་ཚོགས་དེ་དོགས་པ་དང་བཅས་པ་གླང་པོ་ཆེའི་བདག་པོ་ལ་ཞུས་ཤིང་འདུག་གོ།",
    "དེ་ནས་མཆེ་བ་མཐོང་བས་རབ་ཏུ་དགའ་བའི་ཡིད་ཅན་རྒྱལ་པོ་དེས་རྔོན་པ་དེ་ལ་ཇི་ལྟར་ཁས་བླངས་པའི་ནོར་སྦྱར་ཞིང་འདུག་གོ།",
    "དེ་ནས་རྒྱལ་པོ་དེ་དེ་ལྟར་སྨྲེ་སྔགས་འདོན་པ་ལ་རྩེ་གཅིག་པར་རྔོན་པ་དེས་འཛིན་ཅིང་འདུག་གོ།",
    "དེ་ལྟར་བྱའོ་ཞེས་ཟླ་བས་ཀྱང་ཁས་བླངས་པ་ལ་དང་པོར་ཟླ་བའི་མིང་དེ་རྣམས་ཀྱིས་འབྲི་ཞིང་འདུག་གོ།",
    "འདི་ཐམས་ཅད་མཁྱེན་ལ་རྣམ་པར་འཇིག་པའི་ཕྱིར་འདུག་པའི་བདག་ཉིད་ཅན་གྱི་དུམ་བུ་འཛིན་པའི་གཡོའི་རྣམ་པར་སྤྱོད་པ་སྟེ།",
    "ངོ་མཚར་བའི་ཡིད་ཅན་བདག་ཉིད་ཆེན་པོ་དེ་དང་ཉེ་བར་འདུག་པར་གྱུར་ཏོ།",
    "དེ་ནས་རྒྱལ་པོ་དེ་གུས་པ་དང་བཅས་པས་ཉེ་བར་འདུག་སྟེ་བདེ་འམ་ཞེས་དྲིས་ཏེ།",
    "སྟན་ལ་ཉེ་བར་འདུག་སྟེ།",
    "རྒྱལ་པོ་དེ་ཡང་རང་བཞིན་གྱིས་རབ་ཏུ་དྲག་པའི་ཁྲོ་བ་ཉིད་ཀྱི་ཕྱིར་ཁྲོ་གཉེར་གྱིས་འབྲེལ་བའི་འགྲམ་གྱི་ཕྱོགས་མི་མཉམ་པར་བྱས་པ།",
    "ས་སྐྱོང་རང་བཞིན་གྱིས་ནི་དྲག་པའི་གནོད་སྦྱིན་རྣམས།",
    "དེའི་བུ་ཨུཏྤལ་ཅན་ཞེས་བྱ་བ་ཅིག་ཡོད་དེ་དེས་ཀྱང་ཕའི་དྲུང་ནས་ཞགས་པའི་ཆེ་བའི་བདག་ཉིད་དེ་ཉེ་བར་ཐོབ་པ་དེ་ལྟ་བུའི་ཞགས་པ་ལ་མཆོད་ཅིང་འདུག་གོ།",
    "ཕྱིས་ཀྱང་འདི་ལྟར་བསམས་ཤིང་འདུག་གོ།",
    "རྒྱལ་པོ་དེ་ལ་མི་རྣམས་ཚོགས་པའི་དུས་སུ་ཞུགས་ནས་ཤིས་པ་བརྗོད་པར་བྱས་ཤིང་སྟན་ལ་ཉེ་བར་འདུག་སྟེ།",
    "དེ་ནས་རྒྱལ་པོ་དེས་རིགས་བཟང་པོ་མདུན་ན་འདོན་ཉིད་ལ་ཞུགས་ཤིང་འདུག་གོ།",
    "སྐྲག་པ་བྱུང་བས་སྐད་ཅིག་ཆད་ཅིང་རང་བཞིན་གྱིས་ནི་འཇིགས།",
    "འདུག་པའི་བདག་ཉིད་ཅན་མདུན་ན་འདོན་པ་དེ་ཡང་ཡང་དག་པར་འོངས་ཏེ་རྒྱལ་པོ་ལ་འདི་སྐད་ཅེས་སྨྲས་ཏེ།",
    "དཔུང་པ་ལ་ཁྲི་སྙན་ས་ལེའི་པགས་པ་རྣམ་པར་བཀོད་པའི་དྲང་སྲོང་དེའི་གན་དུ་ཉེ་བར་འོངས་ནས་དབེན་པའི་སར་འདུག་སྟེ་དྲིས་པ།",
    "བརྟན་པར་འདུག་ཤིག་དང་ཡིད་འཕྲོག་མ་ཐོབ་པར་འགྱུར་རོ་ཞེས་ཟེར་རོ།",
    "རལ་པའི་ཚོགས་རྣམ་པར་བཅིངས་པའི་ཅོད་པན་གྱིས་མགོ་བོ་ལ་འདུག་ནས་ཅུང་ཟད་དམའ་བའི་ཚང་བརྩམ་པར་བྱས་ཏེ།",
    "ཀྱེ་མ་འདོད་ཆགས་དང་ལྡན་པ་རྣམས་ཀྱིས་འདོད་ཆགས་ཀྱི་བདག་ཉིད་དུ་འདུག་པ་སྟེ།",
    "གོས་ཀྱིས་བཀབ་པ་གཉིད་ལོག་པའི་བྱིས་པའི་མལ་གྱི་སྟེང་དུ་འདུག་པར་གྱུར་ཏེ།",
    "ཡུལ་འདུག་པ་ལ་དགའ་ཡི་དུད་འགྲོ་ལ།",
    "འདུག་པའི་བདག་ཉིད་འཆི་བདག་འདི་ནི་མི་ལྟོས་ཏེ།",
    "ཡང་སྐྱོན་གཅིག་འདུག་ཟེར།",
    "མཱ་དྷ་བཱི་ནས་ཨ་ཙི་རཾ་ཨཾ་བིདྱ་དྷཱ་རི་ནས་ཅིའི་ཕྱིར་འདི་ངོ་མཚར་ཆེ།",
    "ཡང་དག་གནས་ཀྱིས་རབ་དབྱེ་འདུག་སྟངས་ལྟ་ཚུལ་དང་།",
    "དེ་ནི་ནམ་ཡང་རང་དོན་མ་ཡིན་དེ་ཡི་རང་བཞིན་ཉིད།",
    "ལེགས་ལྡན་མེ་ཏོག་མཚོན་ཅན་གྱིས་ཀྱང་རང་ལུས་སྲེག་པའི་ཚོར་བ་ཇི་ལྟར་ཤེས་པར་མ་གྱུར་ཏེ།",
