    "ནམ་ཚོད་རིང་དུ་ཡོད་པས་དེའི་སེམས་ཀྱང་བསྲུང་བར་ནུས་སོ་སྙམ་ནས་དེས་ཡང་བུ་མོ་དེ་ལ་བསྒོ་བ་པད་མའི་རྩ་ལག་གི་གན་དུ་སོང་ལ་ཇོ་མོའི་མཆིད་ནས་སྟ་གོན་བགྱིས་ལགས་ན་སྐྱེད་མོས་ཚལ་གང་དུ་མཆི་ཞེས་སྨྲོས་ཤིག།",
    "དེས་དེའི་གན་དུ་སོང་ནས་སྨྲས་པ་དང་།",
    "ཁྱོད་ཀྱི་སྐད་ཅིག་ལ་སྐབས་མེད།",
    "བུ་མོ་དེ་དེ་དང་རེགས་མི་འཕྲོད་པ་ཞིག་པས།",
    "དེས་སྨྲས་པ་རྗེའི་སྲས་སྐབས་མ་མཆིས་པ་ནི་མ་ལགས་མོད་ཀྱི།",
    "དེ་ཁྱོད་ཀྱི་གོས་དང་རྒྱན་དག་གིས་སྐྱེས་པ་གཞན་དང་ལྷན་ཅིག་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བུ་མོ་སོང་ལ་བཟང་མོ་པད་མའི་རྩ་ལག་ན་རེ་སྐྱེད་མོས་ཚལ་ག་གེ་མོ་ཞིག་ཏུ་ཤོག་ཤིག་ཅེས་བྱོས་ཤིག།",
    "དེས་སོང་ནས་བཟང་མོ་ལ་སྨྲས་ནས།",
    "དེ་ནས་དེ་སྐྱེད་མོས་ཚལ་དུ་སོང་བ་དང་།",
    "སྐྱེས་བུ་གཡོན་ཅན་པད་མའི་རྩ་ལག་གིས་སྨྲས་པ།",
    "ཁྱོད་ཁོ་བོའི་གོས་དང་རྒྱན་གྱིས་སྐྱེས་པ་གཞན་དང་ལྷན་ཅིག་དགའ་མགུར་སྤྱོད་པ་རིགས་སམ།",
    "རྗེའི་སྲས་དེ་ནི་བདག་གིས་ནོངས་ཏེ་འོན་ཀྱང་བུད་མེད་ནི་རྟག་ཏུ་སྐྱོན་ཅན་ལགས་པས་བཟོད་པར་མཛོད་ཅིག།",
    "དེ་ནས་བུ་མོ་མངག་གཞུག་མས་ཇོ་མོ་བསད་དོ།",
    "རབ་ཏུ་བྱུང་བ་འདིས་བཟང་མོ་གསད་དོ་ཞེས་དེ་ནས་དྲང་སྲོང་གོ་ཏ་མ་དེ་བསྐོར་ཏེ།",
    "བཟང་མོ་དང་ཁྱོད་ལྷན་ཅིག་དགའ་མགུར་སྤྱད་ནས་དེ་བསད་དོ།",
    "ལྷ་རབ་ཏུ་བྱུང་བ་འདིས་བཟང་མོ་དང་ལྷན་ཅིག་དགའ་མགུར་སྤྱད་ནས་དེ་བཀུམ་ལགས་སོ།",
    "དེ་རབ་ཏུ་བྱུང་བ་དེ་མེ་ཏོག་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "བདེན་པའི་ཚིག་གང་གིས་བདག་གི་ལུས་ཀྱིས་རྨ་ཕྱུང་གི་སེམས་ཀྱིས་མ་ཡིན་ན།",
    "བུ་བྲམ་ཟེ་རྣམས་ཁྱེའུ་མེད་པ་ལ་འགྲོ་བ་མེད་དོ་ཞེས་ཟེར་ན་ཁྱོད་ཀྱིས་བུ་འགའ་བ་སྐྱེད་པ་ལྟ་ཡོད་དམ།",
    "ཀྱི་སླད་དུ་སྤྲོ་བ་བསྐྱེད་པ་ན་བདག་གཞོན་ནུ་ཉིད་དུ་རབ་ཏུ་བྱུང་བས་བུད་མེད་ཀྱི་རྒྱུས་ཀྱང་མ་འཚལ་ན།",
    "བདག་གི་བུ་སྐྱེ་བ་ལྟ་ག་ལ་མཆིས།",
    "གང་གི་ཚེ་དེས་འཁྲིག་པའི་འདོད་ཆགས་རྗེས་སུ་དྲན་པར་བྱས་པ་ལས་ཁུ་བའི་ཐིགས་པ་གཉིས་ཁྲག་དང་ལྷན་ཅིག་ལྷུང་ངོ།",
    "ཁྱེའུ་གཉིས་ཤིག་བྱུང་ནས་དེ་དང་ཧ་ཅང་ཡང་མི་རིང་བའི་བུ་རམ་ཤིང་གི་ཚལ་གསེབ་དེར་དེ་གཉིས་ཞུགས་སོ།",
    "དེ་ཕན་ཚུན་རྗེས་གཅོད་ཅིང་བུ་རམ་ཤིང་གི་ཚལ་གསེབ་ཏུ་ཞུགས་པ་ལས་ཇི་ཙམ་ན་ཁྱེའུ་གཉིས་ཤིག་མཐོང་ངོ།",
    "དེ་དེ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རང་གི་ཡན་ལག་ལས་སྐྱེས་པས་མིང་གསུམ་པ་ཡན་ལག་སྐྱེས་ཡན་ལག་སྐྱེས་བྱ་བར་གྱུར་ཏོ།",
    "བུ་རམ་ཤིང་གི་ཚལ་གསེབ་ནས་རྙེད་པས་མིང་བཞི་པ་བུ་རམ་ཤིང་པ་བུ་རམ་ཤིང་པ་ཞེས་བྱ་བར་གྱུར་ཏོ།",
    "གཞན་དག་གིས་སྨྲས་པ།",
    "དྲང་སྲོང་ཆེན་པོ་བདག་ཅག་གིས་དེ་མཐོང་བར་ཡང་མི་དྲན་ན་ཇི་ལྟར་བསད།",
    "ཁྱེའུ་དེ་གཉིས་ཀྱང་དྲང་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "སྲོང་གི་དྲུང་དུ་འོངས་སོ།",
    "དུས་གཞན་ཞིག་ན་དེའི་བཙུན་མོ་དམ་པ་ཤི་ནས་དེ་ལག་པ་འགྲམ་པ་ལ་གཏད་དེ་སེམས་ཁོང་དུ་ཆུད་ཅིང་འདུག་གོ།",
    "ངའི་བཙུན་མོ་དམ་པ་ཤི་ན་ཅིའི་ཕྱིར་སེམས་ཁོང་དུ་ཆུད་ཅིང་མི་འདུག།",
    "ལྷ་གལ་ཏེ་དེ་ལྟ་ན་ཉི་འོག་གི་རྒྱལ་པོ་རྣམས་ལ་བུ་མོ་མཆིས་ན།",
    "ཅིའི་སླད་དུ་ལྷའི་བཙུན་མོ་དམ་པ་མི་བཙལ།",
    "བདག་ཅག་གིས་བཙལ་ལོ།",
    "ཇི་ཙམ་ན་རྒྱལ་པོ་གཞན་ཞིག་གི་བུ་མོ་གཟུགས་བཟང་བ།",
    "མཛེས་པ་བཙུན་མོ་དམ་པར་འཚམ་པ་ཡོད་པ་དེ་མི་རྣམས་ཀྱིས་བརྟགས་ཏེ།",
    "མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "རྒྱལ་པོ་བུ་རམ་ཤིང་པ་འཕགས་སྐྱེས་པོའི་བཙུན་མོ་དམ་པ་གུམ་ནས་དེའི་ཆེད་དུ་སྲས་མོ་སླང་ངོ།",
    "རེ་ཞིག་བཙུན་མོ་བླངས་ལ་ལྷ་དེ་དང་ལྷན་ཅིག་རྩེད་མོ་དང་།",
    "འོན་ཏེ་བུ་མོར་འགྱུར་རམ།",
    "མཛེས་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "གལ་ཏེ་དེ་ལྟར་མ་བྱས་ན་ཁྱོད་ཀྱི་མཐུ་དང་བརྩོན་འགྲུས་ཀྱི་ཕ་རོལ་གནོན་པ་གང་ཡིན་པ་དེས་སྡོད་ཅིག།",
    "ནོངས་པ་མ་མཆིས་པ་མ་དཔེ་གཟིགས་ན་འདིར་གནོན།",
    "དེས་ན་རྒྱལ་པོ་གཞོན་ནུ་རྣམས་ལ་ཐུགས་བྱུང་བར་འགྱུར་བ་ཞིག་བྱའོ་ཞེས་དེ་ནས་དེ་རྣམས་ཀྱིས་སྐྱེད་མོས་ཚལ་བྱི་དོར་བྱས་པ།",
    "རི་མོ་སྣ་ཚོགས་བྲིས་པར་ཤིན་ཏུ་དྲི་ཞིམ་པའི་པོག་པོར་ཉེ་བར་བཞག།",
    "དེ་ནས་དེ་རྣམས་ཀྱིས་བློན་པོ་རྣམས་ཀྱིས་སྐྱེད་མོས་ཚལ་དེའི་བྱི་དོར་བྱེད་པ་རྒྱང་རིང་པོ་ནས་མཐོང་ནས་གཞོན་ནུ་རྒོད་བག་ཅན་དེ་རྣམས་སྐྱེད་མོས་ཚལ་གྱི་ཕྱོགས་སུ་དོང་ངོ།",
    "བློན་པོ་རྣམས་སྐྱེད་མོས་ཚལ་གྱི་བྱི་དོར་བྱས་ནས་སྒོར་བྱུང་བ་དང་གཞོན་ནུ་རྣམས་ཀྱིས་དྲིས་པ།",
    "འདི་སུའི་སྐྱེད་མོས་ཚལ་དེ་རྣམས་ཀྱིས་སྨྲས་པ།",
    "ལྷའི་སྐྱེད་མོས་ཚལ་ཡིན་ན་འདིར་འཇུག་ཏུ་ག་ལ་རུང་།",
    "ལྷ་སྐྱེད་མོས་ཚལ་ལེགས་པར་བྱི་དོར་བགྱིས་ལགས་ཀྱིས་ལྷ་གཟིགས་པའི་དུས་ལ་བབ་ལགས་སོ།",
    "རྒྱལ་པོ་ཆས་པ་དང་སྐྱེད་མོས་ཚལ་ན་ཀུ་ཅོའི་སྒྲ་ཐོས་སོ།",
