    "དེ་ནས་མིག་དར་གྱི་འོག་ནས་དཀྱིལ་འཁོར་གྱི་ཐད་ཀྱི་བར་སྣང་ལ་ལྟོས་ལ་ཁ་དོག་ཇི་ལྟར་འདུག་པ་སྨོས་ཤིག།",
    "། པོར་འདུག་ན་ཞི་བ་སོགས་ལས་སོ་སོ་འགྲུབ་པར་འགྱུར་རོ།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་དཀྱིལ་འཁོར་ལ་ལྟ་བཞིན་དུ་འདིའི་རྗེས་ཟློས།",
    "ཕྱག་ན་རྡོ་རྗེའི་ཕྱག་ན་འདུག།",
    "ཁྱེད་རང་རྣམས་ཐབས་སམ་ཤེས་རབ་དང་།",
    "དེ་ནས་ཁྱེད་རང་རྣམས་སྤྱན་དམིགས་འདི་བཞིན་དུ་མཛོད།",
    "ནི་འོ་ཁྱེད་རང་རྣམས་ཁ་ཤར་ཕྱོགས་སུ་ལྟོས་ལ།",
    "འོ་ན་སྐུ་འདི་བདེན་པར་འདུག་གམ།",
    "འོ་ན་སྐུ་འདི་མི་བདེན་པར་འདུག་གམ།",
    "ལག་པ་འདི་ལ་སྒྲ་འདུག་གམ་མི་འདུག།",
    "མི་འདུག་ན་འདི་ཅི་ཡིན།",
    "གཉན་འོད་སྲུང་མགོན་པོས་ངག་སྣ་བསྲིངས་ནས་རྔོག་པའི་གསུང་སྒྲོས་ཅི་རིགས་པ་བསྲེས་འདུག་ནའང་།",
    "བརྒྱུད་ཁུངས་བཟང་ཞིང་བརྒྱུད་ཐག་ཉེ་ལ་བརྒྱུད་པ་མ་ཆད་པ་རྩོད་མེད་དུ་འདུག་པས།",
    "འདི་ནི་གྲུབ་པའི་སློབ་དཔོན་ཆེན་པོ་བེ་རོ་ཙ་ན་རཀྵི་ཏ་སྟེ་རྣམ་སྣང་སྲུང་བ་ཞེས་གྲགས་པ་དེ་ཉིད་ཀྱིས།",
    "མལ་སྟན་འདུག་དང་སྔོན་འགྲོ་དང་།",
    "ཉལ་དང་འདུག་པར་མི་བྱའོ།",
    "གུས་པ་ཡིས་ནི་འདུག་པར་བྱ།",
    "མདུན་དུ་དུལ་བར་འདུག་པ་དང་།",
    "དེ་ལྟར་མཛད་པས་གཉིད་སད་ཙམ་ན་རྒྱ་མཚོའི་ཕར་འགྲམ་ན་བསྐྱལ་ནས་འདུག་སྟེ།",
    "འདིའི་བཀའ་བཞིན་བགྱིས་པས་མི་གནས་མྱ་ངན་ལས་འདས་པའི་ཕ་རོལ་དུ་བགྲོད་པ་ལ་ཚེགས་ཆུང་བར་འདུག།",
    "སྟང་སྟབས་འདུག་སྟངས་བཟླས་བརྗོད་དང་།",
    "དང་པོ་ནི་རབ་ཏུ་དང་བས་བཏུད་དེ་སྟན་ལས་ལྡང་བ་དང་གུས་པ་ཡི་ནི་ཚུལ་དང་བཅས་པའི་འདུག་པར་བྱའོ་ཞེས་སྤྱིར་བཏང་ནས།",
    "དེ་ལྟར་མ་བྱེད་པར་འདུག་ཅིག་ཅེས་བཟློག་པར་བྱ་སྟེ།",
    "བདེན་ན་ཁྱེད་རང་ཉིད་ཀྱིས་མ་ཤེས་ཏེ།",
    "ཐོས་བསམ་ལ་མེད་ཐབས་མི་གདའ་སྟེ།",
    "དེ་གང་ན་འདུག་ཀྱང་ཐེ་ལེ་ལེ།",
    "འགྱུར་བའི་སྡུག་བསྔལ་བསམས་ཙ་ན།",
    "མི་ཕྱུག་པོ་སྤྲང་པོར་འགྲོ་ཡིན་འདུག།",
    "ཁ་དྲག་པོ་ཞན་པོར་འགྲོ་ཡིན་འདུག།",
    "མི་མང་པོ་གཅིག་ཏུ་འགྲོ་ཡིན་འདུག།",
    "འདུ་བྱེད་ཀྱི་སྡུག་བསྔལ་བསམས་ཙ་ན།",
    "དེ་ལྟར་ཚེ་འདི་ལ་ཞེན་པ་ལ་ཉེས་པ་དེ་ལྟར་འདུག་ཀྱང་།",
    "ཁམས་གསུམ་སྡུག་བསྔལ་གྱི་རང་བཞིན་ལས་མ་འདས་པར་འདུག་པས།",
    "དེ་ལ་ཤེས་རབ་དགོས་པས་རྗེ་བཙུན་འཇམ་པའི་དབྱངས་ཀྱི་སྒྲུབ་པ་གྱིས་གསུངས་ནས་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་རྗེས་གནང་དང་ལུང་གནང་ཞིང་།",
    "བཟང་པོའི་འདུག་སྟངས་ཀྱིས་བཞུགས་པ།",
    "ཆུའི་རྒྱལ་ཁམས་ཆེན་པོ་འདུག་སྙམ་ནས་ཕྱིན་པ་དང་།",
    "ལས་དེ་མ་ཟད་ཀྱི་བར་དུ་སྡུག་བསྔལ་དྲག་པོ་མྱོང་དགོས་པ་འདུག།",
    "དེའང་རང་དོན་མ་རྫོགས་ཤིང་གཞན་དོན་རྒྱ་ཆེན་པོ་མི་ནུས་ལ།",
    "སྒྲའི་ཀླག་ཅོར་སོགས་བསམ་གཏན་༧ གྱི་ཚེར་མ་མེད་པར་སྟན་བདེ་བ་ལ་འདུག་ནས།",
    "རབ་ཏུ་དམའ་བའི་སྟན་ལ་འདུག།",
    "བདག་ཇི་ལྟར་འདུག་ཀྱང་ཞེ་པ་ནས།",
    "གནས་པ་དང་པོ་རི་གཟར་གྱི་འབབ་ཆུ་ལྟ་བུ་རྣམ་རྟོག་གཅིག་རྗེས་ལ་གཅིག་རྒྱུན་མི་འཆད་པས་སྒོམ་ཆེན་བློ་ཆུང་དག་སྒོམ་མི་སྐྱེ་བར་འདུག་སྙམ་ཞིང་སྐྱིད་ལུག་པ་འབྱུང་སྟེ།",
    "བདེན་པར་གྲུབ་པ་སྐད་ཅིག་ཀྱང་མི་འདུག་སྙམ་དུ་ཐག་རྦད་ཀྱིས་བཅད་དེ།",
    "དེ་ལྟར་འབད་པས་ཕྱི་རོལ་ཡུལ་སྣང་འདི་དག་སེམས་ཀྱི་འཁྲུལ་འཁོར་ཙམ་ལས་ཕྱི་རོལ་ན་བདེན་པར་མི་འདུག་སྙམ་པའི་དོན་ལ་ཡིད་ཆེས་། ཀྱི་གསལ་སྣང་ཅུང་ཟད་ཐོན་པ་འབྱུང་སྟེ་རྒྱན་ལས།",
    "འགྲོ་དང་འདུག་དང་ཉལ་དང་ཟ།",
    "བདེ་བའི་སྟན་ལ་བསམ་གཏན་གྱི་འདུག་སྟངས་དང་།",
    "སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "སྐད་ཅིག་དང་པོ་ལ་སྣང་བའི་ཡེ་ཤེས་མངོན་དུ་གྱུར་ཅིང་རང་བཞིན་སུམ་ཅུ་རྩ་གསུམ་འགག།",
    "གནས་དབེན་པར་སྟན་བདེ་བ་ལ་འདུག་སྟེ།",
    "དེ་ལྟར་མཉམ་གཞག་སྒྱུ་མ་ལ་བརྟེན་པ་ཐོབ་ཅིང་རང་ས་ཟིན་པར་བྱས་ནས།",
    "གཡོན་ནས་སྐྱོན་བརྗོད་སྣ་ཚོགས་ཀྱིས་སྨད་པར་བསམས་ལ་དགའ་མི་དགའ་འདུག་གམ་མི་འདུག་བརྟག།",
    "བླང་དོར་དུ་འདུན་པ་འདུག་ན་གཉེན་པོས་ཚར་གཅད་དོ།",
    "དགའ་མི་དགའི་བླང་དོར་འདུག་མི་འདུག་བལྟས་ལ།",
    "བསྒོམས་པས་བླང་དོར་དུ་འདུག་པའི་ཡུལ་བརྫུན་པ།",
    "ཁྱད་པར་འགྲོ་འཆག་ཉལ་འདུག་ལ་སོགས་སྤྱོད་ལམ་ཅི་བྱེད་ཀྱང་རྨི་ལམ་རྨི་བ་ཡིན་པར་འདུག།",
    "འགྲོ་བ་འདི་རྨི་ལམ་ཡིན་པར་འདུག།",
    "འཆག་པ་རྨི་ལམ་ཡིན་པར་འདུག་སྙམ་པ་ལ་སོགས་པའི་དྲན་འདུན་ཐུར་ཐུར་བ་རྒྱུན་ཆགས་སུ་བྱའོ།",
    "འདི་རྨི་ལམ་ཡིན་པར་འདུག།",
    "མདང་སྲོད་གུང་ལ་རྨི་ལམ་འདི་དང་འདི་ལྟ་བུ་རྨིས་ཀྱང་རྨི་ལམ་དུ་ངོ་མ་ཤེས་པར་འདུག་སྙམ་དུ་ཕྱི་བལྟས་བྱ་ཞིང་སྒྱུ་མར་བསྒོམ།",
    "སྨིན་མཚམས་སུ་ཐིག་ལེ་དམར་པོ་ཙ་ན་ཀའི་འབྲུ་ཚད་ཙམ་ལ་སེམས་གཏད་དེ་ཅི་ནས་ཀྱང་རྨི་ལམ་ལ་རྨི་ལམ་དུ་ངོ་ཤེས་པར་བྱའོ།",
    "རྨི་ལམ་ལྟ་བུར་ངོ་མ་ཤེས་པར་འདུག།",
    "ཕྱི་དྲོའི་དུས་ནས་ང་རྨི་ལམ་རྨི་ཡིན་འདུག།",
    "འདི་རྨི་ལམ་ཡིན་པར་འདུག་སྙམ་པའི་དྲན་པ་རྒྱུན་ཆགས་དྲག་ཏུ་གཟུང་།",
    "སྡུར་བ་ལ་སོགས་མེད་ཅིང་བྱེད་ཀྱི་ཤ་མ་ཞིག་བར་འདུག་ན་ཟིན་པའི་རྟགས་དེ་ལས་ལྡོག་ན་མ་ཟིན་པར་ཤེས་པར་བྱས་ལ།",
    "དུས་དེ་ཙ་ན་དབྲལ་བའི་ཐིག་ལེ་དཀར་པོ་མང་མར་བབས།",
    "དོན་ལ་གདམས་ངག་རབས་ཆད་དུ་འཇུག་པ་ཞིག་འདུག།",
    "འགྲེལ་པ་བྱུང་ཡང་རང་ལུགས་སུ་མི་མཛད་པས་འདིར་མ་སྨོས་ལ།",
    "འདི་ལ་བུ་སྟོན་གྱིས་མཛད་པའི་འགྲེལ་པ་ལེགས་ཆ་བསྡུས་པའི་ཆེན་པོ་ཞིག་ཡོད་ཀྱང་རང་ལུགས་མ་ཡིན་ནོ།",
    "འདས་ཞེས་བྱ་བ་རྒྱ་སྐད་ལ་མེད་ཀྱང་འཇིག་རྟེན་གྱི་ལག་ལྡན་སོགས་ལས་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར་དུ་བོད་ཀྱི་ལོ་ཙཱ་བས་བསྣན་པར་གདའ།",
    "ཁ་དོག་དང་དབྱིབས་ཀྱི་དངོས་པོ་མེད་པ་རྫོགས་པའི་རིམ་པའི་ཡེ་ཤེས་རང་ཡང་རང་བཞིན་མེད་པར་ཤེས་པས་གྲོལ་བར་འགྱུར།",
    "འོན་ཀྱང་ཡེ་ཤེས་ཀྱི་ཉེ་བའི་རྒྱུ་དཀྱིལ་འཁོར་འཁོར་ལོ་ཡིན་པས་དེ་ལའང་སྦྱར་བ་ཡིན་ཚོད་དུ་གདའ།",
    "ཉེར་གསུམ་པ་འདིའི་དོན་ཀུན་ཚང་བར་གདའ།",
    "ཞེས་ཞུ་བ་པོའི་ལུས་ཀྱི་འདུག་ཚུལ་ལོ།",
    "སྤྱན་སྔར་འདུག་སྟེ་འདི་སྐད་གསོལ།",
    "ཅེས་པའི་འགྲེལ་པ་བཅས་དཔེར་མི་འདུག།",
    "ཨ་ར་པ་ཙ་ནཱ་ཡ་ཏེ་ན་མ་འདི་ལྟར་ཞེས་པ་གཞིའི་ཡོན་ཏན་ལས་སྐུ་དང་ཡེ་ཤེས་འབྱུང་ལུགས་བསྟན་པའོ།",
    "ཞེས་པའི་འགྲེལ་བ་བཅས་དཔེར་མི་འདུག།",
    "འགྲོ་བ་འདི་བཀའ་བཅོ་བརྒྱད་དག་ཐམས་ཅད་རང་སྣང་ཡིན་ཞིང་རང་ཤར་བས་སླར་ཡང་གྲོལ་བའོ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "སུ་མེད་པར་བཞད་ཅིང་རང་བྱུང་མ་འགགས་པའོ།",
    "འཇམ་དེ་ཡང་རང་གསལ་རྟོག་མེད་དེསོ་སོར་མ་འདྲེས་པ་ལ་མི་འབྱེད་པའོ།",
    "ཞེས་པའི་འགྲེལ་བ་བཅས་དཔེར་མི་འདུག།",
    "ཅེས་པའི་འགྲེལ་པ་བཅས་དཔེར་མི་འདུག།",
    "ཅེས་པའི་འགྲེལ་པ་བཅས་དཔལ་བསྟན་བཅོས་དཔེར་མི་འདུག།",
    "ཞེས་པ་དགར་རྡོརའཇིག་རྟེན་པའི་བསམ་གཏན་ལས་འདས་ཏེངང་དང་རང་བཞིན་བདག་ཉིད་ཆེན་པོར་ལྷུན་གྱིས་གྲུབ་པའོ།",
    "དེ་ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པ་དབྱེར་མི་ཕྱེད་པའི་སྐུ་གསུམ་དུ་བསྟན་པའོ།",
    "ཞེས་པ་རིག་པ་དང་ཡེ་ཤེས་ཀྱི་འདུག་ཚུལ་མཞེ་ལོ་ འདི་ནི་རྣམ་དག་ལེགས་པའི་ལམ།",
    "རང་སྣང་རང་གྲོལ་གྱི་འཇམ་དཔལ་དང་ནི།",
    "རང་བྱུང་རང་མདངས་ཀྱི་འཇམ་དཔལ་དང་འཕགས་ཏེ།",
    "སྤྱན་སྔར་འདུག་སྟེ་འདི་སྐད་གསོལ།",
    "སྟོན་པའི་སྤྱན་སྔར་རྒྱུད་ཞུ་བའི་སྦྱོར་བ་དང་ལྡན་པར་གུས་པས་འདུག་པའོ།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བ།",
    "རང་སྣང་རང་གྲོལ་ལོ།",
    "འབྱུང་རང་རྒྱལ་གྱིས་ང་རྒྱལ་སྤངས་པ་དང་སེམས་ཙམ་གྱིས་གཟུང་འཛིན་སྤངས་པ་དང་།",
    "ལུས་བཏུད་ནས་ནི་སྤྱན་སྔར་འདུག།",
    "ཨ་ར་པ་ཙ་ནཱ་ཡ་ཏེ་ན་མནི་ངང་དྭངས་གསལ་དག་གོ།",
    "དེར་ཅུང་ཞིག་ལོན་ཙ་ན།"
  ]
}