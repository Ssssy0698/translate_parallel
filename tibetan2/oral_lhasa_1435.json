    "ཇི་ལྟར་སྣང་བ་དེ་ལྟར་དོན་དམ་པར་རྫས་སུ་ཡོད་དོ་ཞེས་ཟེར།",
    "རྣམ་པ་བརྫུན་པར་སྨྲ་བ་ནི།",
    "ཡང་དག་པ་མ་ཡིན་པའི་ཀུན་དུ་རྟོག་པ་གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་སྣང་བ་དང་བཅས་པར་སྐྱེ་བ་ཡོད་པ་ནི་བདེན་ན།",
    "ཡང་དག་པར་ནི་གཉིས་ཀྱིས་སྟོང་པ་རང་རིག་པའི་མཚན་ཉིད་འདི་དོན་དམ་པར་རྫས་སུ་ཡོད་དོ་ཞེས་ཟེར་རོ།",
    "རྣམ་པ་མེད་པར་སྨྲ་བ་ནི།",
    "གཟུང་འཛིན་གྱི་རྣམ་པ་དང་བཅས་པར་སྐད་ཅིག་ཀྱང་སྐྱེ་མ་མྱོང་སྟེ།",
    "མཐའ་བསྡུས་ན་ཐམས་ཅད་ཀྱང་རྣམ་པར་མི་རྟོག་པའི་ཡེ་ཤེས་གཉིས་པོས་སྟོང་བའི་དེ་བཞིན་ཉིད་དང་བཅས་པ།",
    "དོན་དམ་པར་རྫས་སུ་ཡོད་དོ་ཞེས་ཟེར་རོ།",
    "ཇི་ལྟར་རྣལ་འབྱོར་སྤྱོད་པ་རྣམས་ཀྱིས་དོན་དམ་པའི་མཚན་ཉིད་དུ་ཡོད་པ་དང་ཡིན་པར་ལྟ་བ་དེ་དག་ནི།",
    "ཀུན་དུ་བརྟགས་པ་སྟེ་གཏན་མེད་དོ་ཞེས་མེད་པར་འགེགས་པར་བྱེད།",
    "དོན་དམ་པར་དངོས་པོར་མ་གྲུབ་པ་ཀུན་རྫོབ་འཁྲུལ་པའི་ཤེས་པའི་སྣང་བ་ཙམ་ལ།",
    "བྱ་བ་བྱེད་པར་སྣང་བའང་དེ་ཉིད་ཀྱང་ཡིན་ནོ།",
    "གཞན་ཡང་རྨི་ལམ་གྱི་བུམ་པའི་གཟུགས་ཀྱིས་ནི་ཆུ་འཛིན་པའི་བྱ་བ་བྱེད་ནུས་པར་སྣང་ལ།",
    "བུམ་པའི་གཟུགས་བརྙན་ཀྱིས་ནི་ཆུ་འཛིན་པའི་བྱ་བ་བྱེད་མི་ནུས་པར་སྣང་ངོ།",
    "དོན་བྱེད་ནུས་པ་དང་མི་ནུས་པར་སྣང་བའི་བྱེ་བྲག་འདི་དག་ཀྱང་།",
    "ལས་ཀྱི་བསྒོ་སྐལ་ལ་སྤྱོད་པ་མཐུན་པར་སྣང་བ་དང་།",
    "མཚན་ཉིད་སྣ་ཚོགས་རྣམ་པར་འཇོག་པའི་མཚན་གཞི་ཡིན་ནོ།",
    "ཡོད་པ་དང་ཡིན་པར་བསྒྲུབ་དུ་རུང་བར་མེད་པར་དགག་པས་བསྟན་པའི་གཞིར་གྱུར་པ་འགའ་འང་ལྷག་མ་མི་ལུས་སོ།",
    "སྣང་བ་ཙམ་ནི་ལས་གྱི་བསྒོ་སྐལ་ལ་སྤྱོད་པ་མི་མཐུན་པ་རྣམས་ལ་མཚན་ཉིད་པར་བཞག་པ་རྣམས་ཀྱང་མི་སྣང་ངོ།",
    "ཀུན་དུ་བརྟགས་པར་བཞག་པ་རྣམས་ཀྱང་རྟོག་པ་ཅུང་ཟད་རྟས་པ་རྣམས་ལའང་སྣང་ངོ།",
    "འདི་ཀུན་རྟེན་ཅིང་འབྲེལ་འབྱུང་ཚུལ་ཏེ་སྐྱེ་དང་འགག་པར་འགྱུར་ཞེས་པ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་གསུངས་སོ།",
    "ཆད་པར་སྨྲ་བ་ཉིད་དང་བྱེ་བྲག་མེད་དེ།",
    "འགྲོ་བའི་རྒྱུད་ཆུད་གསོན་པར་འགྱུར་ཏེ།",
    "རྣམ་པར་དཀར་བའི་རྩོལ་བ་ཐམས་ཅད་ཟློག་པར་བྱེད་དོ།",
    "དེ་བས་ན་ཀུན་ལ་བསྟན་པར་བྱ་བ་མ་ཡིན་པ་དང་།",
    "རྟོགས་པར་དཀའ་བའི་ཕྱིར་གསང་སྔགས་ཀྱི་ཚུལ་ཞེས་བྱའོ།",
    "ལ་ལ་ནི་སྐྱ་བར་བྱས་ཏེ་འགྲོ་བར་བསམས་ནས།",
    "ཀུན་དུ་བརྟགས་པའ་ཙམ་ལ་སྤྱོད་པར་མཐོང་ནས།",
    "ཡང་དག་པར་བརྟགས་པ་ཐམས་ཅད་དྲུངས་བྱུང་དུ་མ་གྲུབ་པར་མཐོང་ངོ།",
    "དོན་དམ་པར་བཟུང་བ་ལྟ་ཨ་ཅང་ཡང་ཆེས།",
    "ཡང་དག་པར་ལྟ་བ་ཐམས་ཅད་ཤེས་རབ་ཀྱི་མཚོན་ཀྱིས་བཅད་ནས།",
    "ཐབས་མཁས་པའི་སྤྱོད་པ་ཇི་ལྟར་འདོད་པ་བཞིན་རོལ་ཅིང་བརྩེན་པས་དེ་བཞིན་དུ་འགྲུབ་པར་འགྱུར་བ་ནི།",
    "དེ་དག་གང་སྒྲུབ་པར་བྱེད་པ་དེའི་ཚེ་གཅིག་ཤོས་འགེགས་པར་བྱེད་དོ།",
    "མར་མེ་སྣང་བར་བྱེད་པ་ལྟ་བུ་ལ་སྒྲུབ་པར་བྱེད་པའི་ཚེ།",
    "གསལ་བར་བྱས་པ་ནི་ས་ཕྱོགས་མུན་པ་དང་བྲལ་བར་བྱས་པའོ།",
    "གསལ་བར་བྱས་པའང་མར་མེ་ཉིད་རྒྱུན་མུན་པ་དང་བྲལ་བར་སྐྱེས་པའོ་ཞེས་སྒྲུབ་པར་བྱེད་དོ།",
    "གཅིག་ཤོས་དགག་པ་མ་ཡིན་པ་བྱེད་པ་ཡོད་ལ་བྱས་པ་མེད་དོ་ཞེས་ནི་དགག་དུ་མི་རུང་སྟེ།",
    "འདི་ལྟར་ཤིང་གཅོད་པར་བྱེད་པ་ནི་ཡོད་ལ་ཤིང་བཅད་པ་ནི་མེད་དོ་ཞེའམ།",
    "མུན་པ་གསལ་བར་བྱེད་པ་ནི་ཡོད་ལ་བྱས་པ་ནི་མེད་དོ་ཞེས་ནི་བསྒྲུབ་དུ་མི་རུང་ངོ།",
    "རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་བློའི་བྱེ་བྲག་ཐ་སྙད་འདོགས་པར་ནུས་པའི་ལས་ཅན།",
    "བྱས་པ་ནི་མེད་དོ་ཞེས་བསྒྲུབ་དུ་མི་རུང་བ་བཞིན་དུ།",
    "ཀུན་དུ་བརྟག་པར་བྱ་བའང་སེམས་དང་སེམས་ལས་བྱུང་བ་ལས་གཞན་ན་མེད་དོ།",
    "རྣམ་པར་རྟོག་པ་བྱེ་བྲག་ཅན་ཀྱིས་ནན་གྱིས་བརྟགས་པ་ཙམ་ལ་འཇུག་པ་མཐོང་བས།",
    "རྣམ་པར་རྟོག་པའོ།",
    "རྣམ་པར་རྟོག་པ་ནི་སེམས་པ་དང་ཤེས་རབ་ཀྱི་བྱེ་བྲག་ཐ་སྙད་འདོགས་པའི་ལས་ཅན་ཕྱོགས་འགའ་ལ་འཇུག་གོ།",
    "སྐབས་ལ་ལར་ནི་ཀུན་དུ་རྟོག་པ་ཉིད་ལ་རྣམ་པར་རྟོག་པའི་སྒྲས་ཀྱང་སྟོན་ཏོ།",
    "རྟོག་པའང་ཡིན་ལ་བརྟགས་པའང་ཡིན་པར་རྒྱ་ཆེར་འབྱུང་ངོ།",
    "རྣམ་པར་རྟོག་པས་བརྟགས་པ་ནི།",
    "དངོས་གྲུབ་ཐོབ་པ་རྣམས་ཀྱིས་རྣམ་པར་སྨིན་པའི་ལུས་འདི་མ་བོར་བར།",
    "ཚེ་སྐལ་པའི་ཚད་ཙམ་དུ་གནས་པར་ནུས་པ་ལ་སོགས་པའོ།",
    "ཁམས་གསུམ་པའི་ལུས་དང་གནས་དང་ལོངས་སྤྱོད་དུ་བཅས་པར་སྣང་ཞིང་སྨིན་པ་ཐམས་ཅད་དོ།",
    "རྣམ་པར་རྟོག་པའི་བརྟགས་སྣང་ནི།",
    "ཡི་གེ་དང་ཕྱག་རྒྱ་ལ་སོགས་པ་བསྒོམས་ཀྱང་མངོན་དུ་སྨིན་པར་མ་ནུས་པ་རྣམས་སོ།",
    "རྣམ་པར་རྟོག་པས་བརྟགས་ཀྱང་སྣང་བར་མ་ནུས་པ་ནི།",
    "རྣམ་པར་རྟོག་པས་མ་བརྟགས་པ་ནི།",
    "སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱིས་སོ་སོར་བརྟགས་ནས་སྟོང་པ་དང་བདག་མེད་པར་རྟོགས་ཏེ།",
    "ལམ་བསྒོམས་པས་འདུས་མ་བྱས་ཐོབ་པའོ།",
    "དེའི་རྒྱུད་ལ་རྭ་སྐྱེ་བའི་ལས་མ་བསགས་པར་ཟད་དོ།",
    "དེ་ལ་རྣམ་པར་རྟོག་པས་བརྟགས་པ་དང་རྟོགས་པ་ཞེས་བྱ་བའི་ཐ་སྙད་འཇུག་པ་ནི།",
    "འདི་ལྟར་མ་རྟོགས་པ་དང་ལོག་པར་རྟོགས་ཞེས་བྱ་བ་ལྟ་བུའོ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་མཐོང་བ་ལའང་བརྟགས་པའི་སྒྲ་འཇུག་སྟེ།",
    "འདི་ལྟར་སོ་སོར་རྟོག་པའི་ཤེས་རབ་ཀྱིས་ལེགས་པར་བརྟགས་ན་ཞེའམ།",
    "དེ་ཡང་ཀ་ལ་པི་ཏ་ཞེས་བྱ་བའི་སྒྲ་ནི་བརྟགས་པར་སྟོན་པ་སྟེ།",
    "གོང་དུ་སྨོས་པའི་རྟག་པར་ལྟ་བའི་གཞི་ལྔ་ལྟ་བུའོ།",
    "ཡོན་ཏན་ཁྱད་པར་ཅན་མེད་ཅེས་ཟེར་བ་ལྟ་བུའོ།",
    "དེ་ལ་རྣམ་པར་རྟོག་པ་དང་བཅས་པའི་བློ་ཕྱིན་ཅི་མ་ལོག་པས་མཐོང་བ་ལ་རྟོགས་པ་ཞེས་བྱ་བའི་ཐ་སྙད་གདགས་པ་ནི།",
    "ཡོན་ཏན་ཁྱད་པར་ཅན་ཡོད་དེ།",
    "འདི་བཞིན་དུ་ཇི་སྲིད་དུ་ཀུན་དུ་བརྟགས་པར་གཞག་པ་དང་མཚན་ཉིད་པར་གཞག་པ་ཐམས་ཅད་ཀྱང་།",
    "རྣམ་པར་རྟོག་པའི་བློ་ཕྱིན་ཅི་ལོག་དུ་མཐོང་བས་བརྟགས་པར་བཞག་པ་དང་།",
    "རྣམ་པར་རྟོག་པའི་བློ་ཕྱིན་ཅི་མ་ལོག་པར་མཐོང་བས་རྟོགས་པ་མཚན་ཉིད་པར་གཞག་པ་རྣམ་པ་གཉིས་ཡིན་ནོ།",
    "རྣམ་པར་རྟོག་པའི་བརྟགས་སྣང་ཡིན་ནོ་ཞེས་བརྗོད་པ་དོན་འདྲ་སྟེ།",
    "དེ་ལྟར་ན་བདེན་པ་རྣམ་པ་གཉིས་དབྱེར་མེད་པར་འགྱུར་རོ།",
    "འདི་ལྟར་ཉན་ཐོས་ཀྱིས་གང་ཟག་པ་མེད་པར་རྟོགས།",
    "རྣལ་འབྱོར་སྤྱོད་པས་གཟུང་འཛིན་གཉི་ག་མེད་པར་རྟོགས།",
    "དེ་ལ་ཉན་ཐོས་ཀྱིས་གང་ཟག་མེད་པར་རྟོགས་པས།",
    "བདག་དུ་རྟོག་པ་དང་གཟུང་བར་རྟོག་པ་གཉིས་གའང་ཉམས་པར་བྱས་ཤིང་།",
    "དེ་ལ་ཉན་ཐོས་རྣམས་ཀྱི་རྣམ་པར་གྲོལ་བ་ནི།",
    "གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་དང་བྲལ་བའི་ཡེ་ཤེས་ལས་སྐྱེས་པ།",
    "རྣམ་པར་གྲོལ་བ་དང་ཏིང་ངེ་འཛིན་གཉིས་ག་དབྱེར་མེད་པར།",
    "དེ་ལྟ་བུའི་བཀའ་ཐམས་ཅད་ཀྱིས་ཀྱང་རྫོགས་པ་ཆེན་པོའི་ཚུལ་སྟོན་པར་བྱེད་ཀྱང་མི་ནུས།",
    "གནོད་པ་སྒྲུབ་པར་བྱེད་ཀྱང་མི་ནུས་ཏེ།",
    "ཐམས་ཅད་སུན་འབྱིན་པར་བྱེད་ཀྱང་ནུས་ཏེ།",
    "པྲ་ནི་ཉེ་བར་བསྒྱུར་བ་དོན་ལྷག་པར་སྟོན་པའི་ཚིག་སྟེ།",
    "ཀུ་ནི་ངན་པར་སྟོན་པའི་ཚིག་གོ།",
    "དེ་རྣམས་ལས་བསྟན་པར་བྱ་བའི་དོན་ནི།",
    "གཞུང་གཅིག་ལ་ཡང་དྲང་བའི་དོན་དང་ངེས་པའི་དོན་གཉིས་ག་ལྡན་པར་སྟོན་པའང་ཡོད་ན།",
    "དྲང་བའི་དོན་དུ་སྟོན་པར་བྱེད་པའི་བཀའ་གཞན་གང་ཡང་མེད་ཅིང་།",
    "རྫོགས་པ་ཆེན་པོའི་དོན་ཀྱིས་མ་ཟིན་ན་མཚན་མའི་འཆིང་བས་ཟིན་པར་འགྱུར་ལ།",
    "ཚིག་གཞན་དང་གཞན་གྱིས་དོན་གཞན་དང་གཞན་བསྟན་པར་བྱ་བ་ཡོད་པ་ལ་བྱ་སྟེ།",
    "ངོ་བོ་ཉིད་རྣམ་པ་གསུམ་གྱི་མཚན་ཉིད་ལ་དགོངས་ཏེ་གསུངས་པ་ཡིན་ནོ་ཞེའོ།",
    "དོན་དམ་པ་དང་ཀུན་རྫོབ་ཀྱི་བདེན་པའི་མཚན་ཉིད་ལ་དགོངས་ཏེ་གསུངས་པ་ཡིན་ནོ་ཞེའོ།",
    "གཉིས་སུ་མེད་པར་གཏན་ལ་ཕབ་བོ་ཞེས་ཤེས་པར་བྱ་སྟེ།",
    "བདག་མེད་པར་གཏན་ལ་ཕབ་པ་ཞེས་བྱ་སྟེ།",
    "རང་བཞིན་མེད་པར་གཏན་ལ་ཕབ་པ་ཞེས་བྱ་བའི་གྲངས་སུ་ནི་མི་ཆུད་དོ་ཞེའོ།",
    "རྣལ་འབྱོར་སྤྱོད་པའི་ཚུལ་ལས་གཟུང་བ་དང་འཛིན་པའི་ངོ་བོ་ཉིད་མེད་པར་འདོད་པས།",
    "རང་བཞིན་མེད་པར་གཏན་ལ་ཕབ་པ་ཞེས་བྱ་སྟེ།",
    "སྐྱེ་བ་མེད་པར་གཏན་ལ་ཕབ་པ་ཞེས་བྱ་བའི་གྲངས་སུ་ནི་མི་ཆུད་དོ་ཞེའོ།",
    "སྐྱེ་བ་མེད་པར་གཏན་ལ་ཕབ་པ་ཞེས་བྱ་སྟེ།",
    "གསང་སྔགས་ཀྱི་ཚུལ་ལས་བདེན་པ་གཉིས་དབྱེར་མེད་པར་འདོད་པས།",
    "ཉམ་ང་བ་དེ་ཉིད་མྱུར་དུ་མེད་པར་བྱ་བའི་ཕྱིར་ཆེད་དུ་བརྟུལ་ཞུགས་དང་དུ་ལེན་པ་ལྟ་བུའང་ཡོད་པས།",
    "ཤེས་ཏེ་བཏང་སྙོམས་སུ་བཞག་པར་བྱ་བའམ།",
    "བསྟན་པར་བྱ་བ་ནི་འདི་ཙམ་ལས་མེད་ལ།",
    "འདི་ཉིད་བསྟན་པ་ཙམ་གྱིས་རྟོགས་ཤིང་འཇུག་པར་འགྱུར་བ་ཡིན་ན།",
    "དྲི་མ་ཐམས་ཅད་ཡོངས་སུ་དག་པར་གྱུརད་པའམ།",
    "ཕྱིན་ཅི་མ་ལོག་པར་ཁོང་དུ་ཆུད་པའམ།",
    "མ་ལུས་པར་ཀུན་ཆུབ་པ་ལ་བྱ།",
    "དམིགས་པ་སྣ་ཚོགས་རྣམ་པར་རིག་པའམ།",
    "སེམས་པར་བྱེད་པས་སེམས་ཏེ།",
    "བྱ་བ་སྣ་ཚོགས་ལ་སེམས་པར་བྱེད་གཡོ་བར་བྱེད་འཇུག་པར་བྱེད་པས་སེམས་ཞེས་བྱའོ།",
    "དེ་ལ་དམིགས་པ་ནི་འདུ་ཤེས་ཀྱིས་བྱེ་བྲག་དུ་བྱས་པའི་བློའི་སྤྱོད་ཡུལ་ལོ།",
    "སྣང་བ་ནི་ཚོར་བས་བྱེ་བྲག་དུ་བྱས་པའི་བློའི་སྤྱོད་ཡུལ་ལོ།",
    "ངོ་བོ་ཉིད་ཀྱི་མཚན་ཉིད་ནི་ཤེས་རབ་དྲི་མ་མེད་པས་བྱེ་བྲག་དུ་བྱས་པའི་བློའི་སྤྱོད་ཡུལ་ལོ།",
    "ཡོད་པ་དང་མེད་པ་ལ་སོགས་པའི་ཐ་སྙད་འདོགས་པར་བྱེད་དོ།",
    "སྣང་བའི་སྒོ་ནས་ནི་ཡང་དག་པ་དང་ཡང་དག་པ་མ་ཡིན་པའི་ཐ་སྙད་འདོགས་པར་བྱེད་དོ།",
    "ངོ་བོ་ཉིད་ཀྱི་སྒོ་ནས་ནི་གྲུབ་པ་དང་མ་གྲུབ་པའི་ཐ་སྙད་འདོགས་པར་བྱེད་དོ།",
    "སྣང་བའི་སྒོ་ནས་ནི་སྒྲོ་སྐུར་ནི་ཡོངས་སུ་གཅོད་པར་ནུས་ལ་འཁྲུལ་པ་ནི་སེལ་བར་མི་ནུས་སོ།",
    "ངོ་བོ་ཉིད་ཀྱི་སྒོ་ནས་ནི་འཁྲུལ་བའང་ཡོངས་སུ་གཅོད་པར་བྱེད་དེ།",
    "འགལ་མེ་དང་འཁོར་ལོ་གཉིས་ག་འགོ་མཉམ་དུ་སོ་སོར་ཡོད་པར་དམིགས།",
    "འགལ་མེ་གཏན་མེད་པར་འགྱུར་རོ།",
    "འཁོར་ལོ་གཏན་མེད་པར་འགྱུར་ཏེ།",
    "འཁོར་ལོའི་ངོ་བོ་ཉིད་ནི་གཏན་མ་གྲུབ་པར་ཤེས་པར་བྱའོ།",
    "དེ་ལ་རྣམ་པར་གྲོལ་བ་དང་།",
    "གཉིས་གའང་བྱས་པའོ་ཞེས་བརྗོད་པ་ན།",
    "བྱས་པ་ཉིད་ལའང་ཐ་དད་མི་དམིགས་སོ།",
    "བྱས་པ་ཐ་དད་མི་དམིགས་ཀྱང་དེ་ཀ་བའང་བུམ་པར་མི་ལྡོག།",
    "ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པ་ཡིན་པར་མ་གྲུབ་ན།",
    "དེ་བཞིན་དུ་གཉིས་པོ་ནི་མེད་རང་རིག་པ་ནི་ཡོད་ཅེས་བྱ་བ་ལ་སོགས་པ་ཀུན་དུ་བརྟགས་པ་བསལ་ནས་མཚན་ཉིད་པ་ཡོད་པར་སྒྲུབ་པ་དང་།",
    "ད་ནི་སྐབས་འདིར་གཅིག་པ་དང་ཐ་དད་པར་སྒྲུབ་པ་དང་དགག་པ་ལ་སོགས་པའི་སྤྱིའི་ཚུལ་ཅུང་ཟད་ཙམ་བརྗོད་དེ།",
    "གཞན་གྱི་གྲུབ་པའི་མཐའ་དགག་པར་འདོད་པ་རྣམས།",
    "མེད་པར་དགག་པ་དང་མ་ཡིན་པར་དགག་པ་གཉིས་སུ་འདུས་སོ།",
    "དེ་ལ་མེད་པར་དགག་པ་ཞེས་བྱ་བ་ནི།",
    "གཞན་བསྒྲུབ་པར་བྱ་བའི་དོན་མེད་དེ།",
    "འདི་ལྟར་མ་རྟོགས་པ་དང་ལོག་པར་རྟོག་པ་དང་ཐེ་ཚོམ་ཟ་བ་ཙམ་སེལ་བར་བྱེད་པ་ཀུན་དུ་བརྟགས་པ་ཙམ་འགོག་པར་བྱེད་པ་ཡིན་ཏེ།",
    "བུམ་པ་ཡོད་པར་རྟོག་པ་བཟློག་པ་ཙམ་དུ་ཟད་དེ།",
    "བུམ་པ་མེད་པའི་ས་ཕྱོགས་ལ་སོགས་པ་ནི་སྟོན་པར་མི་བྱེད་དོ།",
    "གང་ཟག་ཡོད་པར་རྟོག་པ་ཙམ་བཟློག་པར་ཟད་དེ།",
    "མ་ཡིན་པར་དགག་པ་གང་ཞེ་ན།",
    "དེ་ལྟ་བས་ན་མེད་པར་དགག་པ་ནི་གཞན་གྱི་གྲུབ་པའི་མཐའ་སེལ་བ་ཙམ་ཡིན་ལ།",
    "མ་ཡིན་པར་དགག་པ་ནི་དེ་ཙམ་གྱིས་མི་ཆོག་སྟེ།",
    "འདི་ལྟར་ཡོད་པར་སྒྲུབ་པ་དང་།",
    "དམིགས་པར་སྒྲུབ་པའོ།",
    "ངོ་བོ་ཉིད་དང་ཁྱད་པར་རོ།",
    "ཁྱེད་ཀྱི་གྲུབ་མཐས་མི་ཕྱེད་པར་བྱེད་དོ།",
    "དེ་ལ་དངོས་པོ་སྒྲུབ་པ་ཐམས་ཅད་ཀྱི་གཞི་ངོ་བོ་ཉིད་དང་ཁྱད་པར་ཡིན་པས།",
    "དེ་མཚོན་པར་བྱེད་པ་ནི་མིང་ཡིན་ཏེ།",
    "ན་ཡ་ནི་ཞེས་བྱ་སྟེ་ཁྲིད་པར་བྱེད་པས་མིང་སྟེ།",
    "བློ་གང་དོན་གྱི་ངོ་བོ་ཉིད་ལ་ཁྲིད་པར་བྱེད་སྦྱོར་བར་བྱེད་པས་མིང་ཞེས་བྱ་སྟེ།",
    "འདུས་བྱས་དང་འདུས་མ་བྱས་ཞེས་བྱ་བ་ལྟ་བུ་ངོ་བོ་ཉིད་རྒྱ་ཆེ་བ་ལ་སྦྱོར་བར་བྱེད་ཀྱང་རུང་སྟེ།",
    "མཚན་མའམ་རྟགས་སུ་བྱས་པའོ།",
    "དེ་ལ་དོན་གྱི་ཁྱད་པར་གང་ཞེ་ན།",
    "མཚོན་པར་བྱ་བའམ་བྱེད་པའི་དངོས་པོ་ཡིན་པའི་ཕྱིར་རོ།",
    "དེ་ཡང་འདིས་འཛིན་པར་བྱེད་པའམ།",
    "རིགས་པ་འཛིན་པར་བྱེད་པ་དང་།",
    "ལ་ལར་ནི་ཁྱད་པར་འདི་ངོ་བོ་ཉིད་ཀྱིས་བཟུང་བ་ཡིན་ཞིང་ངོ་བོ་ཉིད་ལ་རྟེན་པ་ཡིན་པས།",
    "ཁྱད་པར་གང་ལ་ཡོད་པ་དེ་ནི་ཁྱད་པར་གྱི་གཞི་ཡིན་ཏེ།",
    "ངོ་བོ་ཉིད་དང་ཁྱད་པར་དུ་གཞག་པའང་།",
    "ངོ་བོ་ཉིད་ནི་ཁྱད་པར་ལ་མ་རྟེན་པར་གྲུབ་པའོ།",
    "ཁྱད་པར་ནི་ངོ་བོ་ཉིད་ལ་རྟེན་ནས་བྱེ་བྲག་སོ་སོར་རྣམ་པར་ཕྱེ་བའོ།",
    "དེ་ལ་ཁྱད་པར་དེ་སྟོན་པར་བྱེད་པ་ནི་ཚིག་ཡིན་ཏེ།",
    "མཚན་སྤྱི་དཔེ་བྱད་ཀྱིས་འབྱེས་པར་བྱེད་པ་བཞིན་དུ།",
    "ཇི་ལྟར་ཚོད་མས་ཟན་གྱི་རོ་བྱེ་བྲག་ཏུ་འབྱེད་ཅིང་ཁྲིད་པར་བྱེད་པ་ལྟར།",
    "ཕྱོགས་གཅིག་དུ་འདྲེན་པར་བྱེད་པས་ཚིག་འབྲུ་ཞེས་བྱའོ།",
    "དེ་ལྟར་ངོ་བོ་ཉིད་དང་ཁྱད་པར་དེ་གཞིར་བྱས་ནས།",
    "གཅིག་དང་ཐ་དད་དུ་སྒྲུབ་པར་བྱེད་དེ།",
    "ཞེས་སྒྲུབ་པར་བྱེད་དོ།",
