    "ལུས་ཀྱི་སྨད་ནས་མེ་འབར་བར་བྱེད་ལ་ལུས་ཀྱི་སྟོདནས་སྨུགང་མོའི་རྒྱནའབེབས་པར་བྱེད་པ་དེ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་ཞུགསས།",
    "བཅོམ་ལྡན་འདས་གངན་བ་དེར་སོང་སྟེ་ཕྱིན་ནསམོད་གཡགྱི་བུ་ཆེན་བོདང་ནང་དུ་ཞུགས་པ་དང་།",
    "དེ་ནས་རྒྱལ་པོ་ཟས་གཙང་ལྷོ་སྒོར་སོང་བ་དང་།",
    "དེནས་རྒྱལ་པོ་ཟས་གཙང་བྱང་སྒོར་སོང་བ་དང་།",
    "རྒྱལ་པོ་ཟས་གཙང་གིའུག་འཉི་མ་མཐོང་ན་ཁྲག་དྲོན་མོ་སྐྱུགས་ནས་འཆི་འགྱུར།",
    "དེའང་བཅོམ་ལྡན་འདསས་རྒྱལ་པོ་ཟས་གཙང་གི་བསམ་པ་དང་།",
    "རངགི་སྐྱེ་བོ་དང་གཉེན་གྱི་ཚོགས་ཀྱིསམའགས་པ་གང་ལགས་པ་བཅོམལྡན་འདས་བདག་ལ་མཛད་དེ།",
    "མགོན་པོ་བྱམས་པ་ཁྱོདཀྱིས་ནི།",
    "དེནས་རྒྱལ་བོ་ཟས་གཙང་སྟན་ལས་ལངས་ཏེ་བླ་གོས་ཕྲག་པ་གཅིག་ཏུ་གཟར་ནས་བཅོམལྡན་འདས་གང་ན་བ་དེ་ལེགས་སུཝལམོ་སྦྱར་བ་བཏུད་དེ་བཅོམལྡན་འདས་ལ་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "ཟས་དཀར་བ་ངན་བ་དེར་སོང་སྟེ་ཕྱིན་ནས་ཟས་དཀར་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ།",
    "གཞོན་ནུ་ཁྱོད་རྒྱལ་སྲིདིཐོབ་ཀྱིས་རྒྱལ་སྲིད་ཁྱེར་ཅིག།",
    "ཅིའི་སླད་དུ་ངས་བཅོམ་ལྡན་འདས་ཀྱི་སྤྱན་སྔར་བདེན་བམཐོང་བས་སྒྱུ་གང་གི་གདུགས་ལ་ལགས།",
    "རྣམ་གྲངས་དུ་མར་གཙང་ཞིང་བསོདཔའི་བཟའ་བ་དང་བཅའ་བ་རང་གི་ལག་ནས་བསྟབས་ཤིང་ཚིམ་པར་བྱས་ཏེ།",
    "ཡིད་ལ་རེ་བ་རྫོགས་ནས་ནི།",
    "རྒྱལ་པོ་ཟས་གཙང་གསི་རལཙནལས་རབ་ཏུ་བྱུང་བའི་དགེ་སློང་རྣམས་སྤྱོད་ལམ་ཞི་ཞིང་སེམས་དང་བ་ཡིན་ན་དཀའཐུ་བ་དྲག་པོའི་བརྟུལ་ཞུགས་ཀྱི་ཁྱད་པར་དག་གིས་ལུས་གདུངས་བས་ལུས་མིམཛེས་པར་ཀ་མཐོང་དམཐོང་ནས་ཀྱང་འདིསྙམ་དུསེམས་ཏེ།",
    "འདི་ལྟར་རལཔ་ཅན་འདི་དག་སྤྱོད་ལམ་ཞིངེསེམས་དང་བ་ཡིན་མོད་ཀྱི།",
    "བུ་རྒྱལ་པོས་དྲིལ་སྒྲོགས་སུ་བཅུག་པ་ཤཱཀྱརྣམས་ལས་ཁྱིམ་རེ་ནས་རེ་རེ་རབ་ཏུ་བྱུང་ཤིག་ཅེས་བསྒོས་ཁྱོད་རབ་ཏུ་བྱུང་ཤིག།",
    "བདག་ནི་རབ་ཏུམ་འབྱུང་གིས་ཁྱོད་ཀྱི་བུ་སྡུག་པ་བདེ་བ་དང་ལྡན་པར་གནས་པ་གང་ཡིན་པ་དེ་རབ་རུ་ཕྱུངཤག།",
    "སྐྱེད་མོས་ཚལ་དེ་ཐམས་ཅད་ཟསཀྱིདཱིའམ་བོས་གང་བར་གྱུར་ཏེ།",
    "ཡུམ་གདུགས་རོ་རེ་འང་ཟས་ཅི་ཡང་མ་ཡིན་པ་ཞེས་བགྱི་བ་འདི་ལྟ་བུ་ཤ་སྟག་བསྐུར་བའི་རིགས་སོ།",
    "བུ་བུ་རྒྱལ་རྒྱལ་པོར་པོས་དྲིལ་སྒྲོགས་སུ་བཅུག་པ་ཤཱཀྱ་རྣམས་ལས་ཁྱིམ་རེ་ནས་རེ་རེ་རབ་ཏུ་བྱུང་ཤིག་ཅེས་བསྒྲོན་ཁྱོད་འབྱུང་ངམ།",
    "སོསུད་སོང་ནས་ཤཱཀྱའི་རྒྱལ་པོ་བཟང་ལྡན་ལ་སྐྱེས་པ།",
    "ཁྱོད་འོངས་ནས་ཇི་སྲིད་ལོན།",
    "སབརྩམས་པ་ན་མེ་ཏོག་གི་རྩ་བ་ཞིག་མཐོང་ནས་དེ་རྣམསམཆོག་ངོ་མཚར་སྐྱེས་སོ།",
    "གཞོན་ནུ་ཁྱོད་ཀྱིས་ཇི་ལྟར་། ཤེས་",
    "ཚ་བའི་རེག་པ་ཉམས་སུ་མྱོང་བས་རིམས་བག་གི་དྲིལགས་སོ།",
    "ལྷ་སྦྱིན་ལ་སོགས་དརྣམས་སྐྱེད་མོསཚལ་དུ་དུས་སྟོན་ལ་འགྲོ་བ་བཞིན་དུ་བཅད་རེ་ཡའགྲན་མིད་བཅོམ་ལྡན་འདས་གང་ན་བདེར་དོང་ངོ།",
    "ཁ་ཅིག་གིས་མཉེས་པར་བྱེད་པར།",
    "གིས་མཉེས་པར་བྱེད་པར་མི་འགྱུར་ཏེ།",
    "ལྷ་བདག་འཛམ་བུའི་གླིང་གི་སྐྱེས་བུ་གཙོ་བོ་རྣམས་ལ་བསྙེན་བཀུར་བགྱིད་མི་ཡུལ་པ་རྣམས་ལ་ཡང་བསྙེན་བཀུར་བགྱིད་པར་འགྱུར་བ་ལྟ་ཞིག།",
    "ཁྱོད་བཅོམ་ལྡནའདས་ཀྱིས་གཏའབྱིན་པར་འགྱུར་རོ།",
    "བསྙེན་པར་རྫོགས་པ་དགེ་སློང་ང་གིདངོས་པོ་འཚལ་ལགས་ན་ཐུགས་བརྩེ་བ་ཉེ་བར་གཟུང་སྟེ།",
    "འདི་རྒན་གྱིས་ཁྱོད་ཀྱིས་ང་རྒྱལ་གྱི་རིགས་པ་ཆོགའ་ཐུང་ཅིག།",
    "བཙུན་པ་ཤཱཀྱ་ཀྱའི་རྒྱལ་པོ་བཅུད་ལྡན་གྱིས་ཉེ་བའའིཀ་ལ་ཕྱག་བགྱིས་པ་དང་ས་ཆེན་པོ་འདི་རྣམ་པ་དྲུག་ཏུ་གཡོས་པར་གྱུར་ལ་གཟིགས།",
    "བཟང་མོདགའམགུར་སྤྱད་ཀྱིས་ཚུར་ཤོག།",
    "དེ་ཤིབ་ལས་སས་པ་བཞིན་དུ་དགའ་བས་སེམས་ཀྱི་རྒྱུད་ངོམཚར་གྱིས་བསླུས་ནས་སོང་ངོ།",
    "གཡེར་བའི་ཡོན་ཏན་བརྟགས་ནས་མོས་ཤིང་ཞེན་པས་ཉིདེམལོག་པསནམནང་གཉིད་གྱིས་ཤིན་ཏུ་ལྕི་བར་གྱུར་ནས།",
    "དེས་ཤིང་སྐྱི་ཞེས་བྱ་བའི་མེ་ཏོག་ཅིག་ཁྱེར་ནས་དེའི་དྲུད་དུ་སོང་སྙཚིགསསུ་བཅད་དེ་སྨྲས་པ།",
    "གླུ་ལེན་ཁྱོད་ཀྱི་ལུས་ལ།",
    "མལ་བདག་གིས་དེ་སྲོག་དང་དབུ་བརྒྱུད་བར་བྱའོ་སྙམམོ།",
    "ཤེས་ལྡན་དགཁྲམ་ཟེའི་ཁྱེའུ་དེ་ཁུག་ཤགི།",
    "མཐོང་ནས་ཀྱངམ་དང་པོ་བསྐྱེད་དེ་རྒྱལ་པོའི་གན་དུ་སོང་ནས་སྨྲས་པ།",
    "ཀྱེ་བྲམ་ཟེའི་ཁྱེའུ་ཁྱོད་ཅིའི་ཕྱིའི་མལ་ཆེན་པོ་ནས་བབས་ཏེ་གཡང་གཞི་ལ་བཏིང་ནས་ཉལ།",
    "བདག་གིས་རྒྱལ་པོ་དེ་ལ་སྔོན་ཁས་བླངས་པས་སོང་ལ།",
    "ལྟ་བདག་གིས་བསྙེན་བཀུར་བགྱིས་ལགས་ཀྱིས་ཁྱིམ་ནས་ཁྱིམ་མ་མཆིས་པར་པརརབ་རབ་ཏུ་ཏུ་འབྱུང་འབྱུང་ངོ་ངོ།",
    "མ་ལ་བདག་ཅག་གིས་བརྩོན་འགྲུསབརྩམཔར་བྱའོ་ཞེས་པས་ནུས་ཚིགས་སུ་བཅད་དེསྨྲསར།",
    "བདགཅག་གི་ནི་ཟག་པ་ཡང་།",
    "རི་བོ་རལ་བའི་དབྱིབས་གང་ན་བ་དེར་སོང་ནས་སྨོན་པ་དེ་ནི་དགེ་སློང་ཀུན་ཤེས་ཀོཚེ་འདི་ཡཞེ་ཏེ།",
