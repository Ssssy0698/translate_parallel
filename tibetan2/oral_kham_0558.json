    "འོན་ཀྱང་གཙང་མ་ཆུང་དུས་ནས་རབ་ཏུ་བྱུང་ཞིང་བླང་དོར་ལ་ཡང་རང་སྟོབས་ཀྱིས་འཇུག་པས་ལག་ཏུ་ལེན་མ་བདེ་བར་ཚར་གཅོད་བྱས།",
    "དེ་བས་སྦས་སོགས་ཀྱིས་ཁོ་རང་ལག་གཡོར་ས་བྱས་ཤིང་།",
    "ཕྱོགས་གང་ཐད་ནས་ཉམས་མྱོང་མེད་པས་ང་རང་གཙོ་སྒྲིག་པར་གདན་ཞུ་བྱས་པ་ཡིན་ཟེར་ནས་ཅུང་ཟད་ཚད་གཞི་ལས་བརྒལ་བའི་བརྩི་མཐོང་གནང་བྱུང་།",
    "ང་རང་ལོ་ངོ་ཉི་ཤུའི་ཡར་སྔོན་ནས་ལྷུག་རྩོམ་ལ་འཇུག་མཁན་ཞིག་ཡིན་པའི་ཆ་ནས།",
    "ཞེས་བསྒྱུར་ན་ཅུང་འཚམ་པོ་འདུག་སྙམ།",
    "ཡིན་པ་མངོན་གསལ་དོད་པོ་འདུག་ཅེས་བཤད།",
    "བོད་ཀྱི་དཔེ་རྙིང་ཁག་ཏུ་ཁ་གདན་གྱི་སྐོར་འཁོད་ཡོད་པ་འདུག་ཅེས་གོ་ཐོས་བྱུང་བས།",
    "ཞེས་འཁོད་ཡོད་པ་དེ་ཕྱོགས་ཙམ་སྟོན་འདུག་དོན་དུ་དེའི་དོན་ནི།",
    "སྐུ་བླ་སོགས་ཀྱི་སྲོག་རྟེན་བཙུགས་ཡོད་པ་དེ་ལ་ཟེར་སྲོལ་ཡང་འདུག་གང་ལྟར་གནའ་བོའི་དུས་སུ་བོད་མི་ཚོས་དབུ་རྨོག་ནི་སྟོབས་ཤུགས་དང་མངའ་ཐང་མཚོན་པའི་གོམས་གཤིས་དང་བག་ཆགས་ནི་ཤིན་ཏུ་མཐུག་ཅིང་།",
    "དེ་རྒྱ་གར་ནས་དར་བ་ཡིན་མིན་ད་དུང་བརྟག་དགོས་པ་ཞིག་འདུག་རྨོག་སྟན་ནི།",
    "ཅེས་འཁོད་འདུག་པ་དེར་བརྟགས་ན།",
    "འཁྲུག་དུས་བོར་ཚེ་བཙད་པོའི་གོ་ཆ་དང་།",
    "སྒང་ལ་གསེར་མིག་འདུག་ན་གསེར་མིག་ཟེར།",
    "ལྡེབས་ན་ལྕགས་འབུར་འདུག་ན་དཀར་ཐ་ཟེར།",
    "སྦྲེལ་རྒྱུན་ལོགས་ན་འདུག་ན་ཟུར་རྒྱུན་ཟེར།",
    "ངས་ཁོ་ལ་ང་རང་ནི་གནའ་དཔྱོད་ལ་དགའ་བ་ཙམ་ལས་མིང་བཏགས་བསྩལ་བའི་མཁྱེན་དཔྱོད་དང་།",
    "ནགས་གསེབ་ཀྱི་སྤྱིལ་པོ་ཞིག་ལ་དེ་གཉིས་འཁོར་ཞིང་འདུག་གོ།",
    "རྟ་མགྱོགས་པའི་དཔའ་དར་ཐོབ་ནི་འདུག།",
    "འུར་རྡོ་ཟེར་སྐབས་འུར་མཐིལ་གྱི་རྡོ་ལ་གོ་བར་འདུག་དབུས་གཙང་དང་ཁམས་པས་འུར་རྡོ་བྱ་བ་ལས་འུར་ཆ་ཞེས་མི་སྨྲ་སྟེ།",
    "བའི་བ་རི་བརྒྱ་ཚར་གྲགས་པའི་ལྷའི་གྲས་ཡིན་པར་གསུངས་འདུག།",
    "ཞེས་དེང་སང་ཇི་ལྟར་ཡོད་པ་དེ་ལྟར་དུ་གསུངས་འདུག་ཅེས་གསལ།",
    "དེའི་ཙ་ན།",
    "མ་ཤི་བར་ཟིལ་པ་ཁྲོམ་མེ་འདུག་པས།",
    "དབུལ་བོ་ཉིད་ཀྱི་ཕྱིར་ན་གཞན་ཞིག་གོ་ཞེས་ཕྱིར་ཕྱོགས་ཏེ་འདུག་པ་ལས་སླར་ཡང་དགྲ་བཅོམ་པ་གྲགས་པས་བསྐུལ་ཏེ།",
    "ས་འོག་ནས་ཐོན་པའི་གནའ་རྫས་མང་ཤོས་འཕྲོ་བརླག་ཏུ་བཏང་འདུག་ལ།",
    "མང་ཤོས་འཕྲོ་བརླག་ཏུ་བཏང་འདུག་གོ།",
    "ཚད་ངེས་ཅན་ཞིག་ལ་བསླེབས་འདུག་ཀྱང་།",
    "ཞལ་འབག་ཀྱང་འདྲ་མིན་དུ་མ་ཞིག་འདུག་རྒྱུ་ཆ་འདྲ་མིན་དང་།",
    "དབྱིན་ཡིག་ཉི་ཧོང་ཡི་གེརྒྱ་ཡིག་བཅས་ཀྱི་ཐོག་ནས་ཞིབ་འཇུག་བྱས་དང་བྱེད་བཞིན་པ་ལས་བོད་ཀྱི་ཡིག་ཚང་སྐོར་ལ་དོ་སྣང་བྱས་མི་འདུག་དེའི་རྐྱེན་གྱིས་ཕྱི་གླིང་བ་ཚོས་གདོད་མའི་སྐབས་ཀྱི་དྲི་ཟའི་ཡུལ་དང་དེའི་མི་རྒྱུད་དང་བོད་ཀྱི་འབྲེལ་བ་སོགས་གང་དག་ཡིན་པ་དང་།",
    "ཡ་ཧུ་དཱ་བའི་བྷོ་ལིས་ཧེན་ན་འདུག་ཅེས་པ་དང་།",
    "ང་རང་སྐུ་དངོས་སུ་བུ་དེར་བལྟ་རུ་འགྲོ་དགོས་ཟེར་བས།",
    "ཡིག་ཚང་འགའ་ཞིག་ཏུ་ནོར་ལྷའི་ཁ་ལོ་བ་མཁར་བ་ཡིན་ཞེས་ཀྱང་བྲིས་འདུག་གང་ལྟར་འདིའི་སྐབས་ཀྱི་ཁ་ལོ་བ་བྱ་བ་ནི།",
    "སྒོ་བྱང་ད་དུང་ཡང་ལྷ་ཁང་འདིའི་རྒྱལ་སྒོའི་སྟེང་ལ་བཀལ་འདུགའཇམ་དབྱངས་ལྷ་ཁང་།",
    "ང་རང་ཡུལ་དེར་གཟའ་འཁོར་གཅིག་ལྷག་ཅིག་བསྡད་མྱོང་ལ།",
    "དེ་སེལ་ཐབས་སུ་ང་རང་ཡུལ་འདིར་བཞུར་བའི་གཙང་པོ་ཞིག་ཡོད་པ་དེའི་གཟི་དམར།",
    "ངའི་སེམས་ལ་མི་འདིས་ཅི་ཞིག་ལབ་ཀིན་འདུག་སྙམ་སྟེ།",
    "གོམས་སྲོལ་ཡང་མང་པོ་ཞིག་རྒྱ་གར་གྱི་ཤན་ཤུགས་ཐེབས་འདུག་པར་བཤད།",
    "ཞེང་ཚད་ལ་ཚུན་དྲུག་འདུག་ཅན་སོགས་མང་ཞིང་།",
    "གོས་ཆེན་སོགས་རིན་ཐང་བྲལ་བའི་གནའ་རྫས་མང་བོ་ཞིག་འདུག་པ་དེ་དག་ལ་དཔྱད་གཞིའི་རིན་ཐང་ཤིན་ཏུ་ཆེ་ཞིང་།",
    "ང་རང་བཅས་ཀྱིས་གསེར་ཁང་རི་ཁྲོད་དང་ཁ་ཤ་མཐིལ།",
    "རྩྭ་མེད་པའི་གཡའ་ཆུང་སྔོ་སི་ལེ་བ་ཞིག་འདུག་རྩེ་དེ་ན་ཁང་བ་ཀ་གཉིས་པ་ཞིག་འདུག་པའི་ནང་ན།",
    "གནས་དེར་བན་བོན་གཉིས་ཀས་བསྐོར་བ་བྱེད་པ་ཞིག་འདུག་རི་དེའི་རྩེ་ནས་རྩ་བའི་བར་དུ།",
    "ཞེས་རི་བོ་རྩེ་ལྔ་བྱ་བ་གསུམ་ཙམ་ཞིག་ཡོད་པར་གསུངས་འདུག་པས།",
    "ལ་ལ་ནི་རུས་མིང་ས་མིང་དུ་གྱུར་བའང་གདའ།",
    "གནའ་ནས་བཟུང་སྟེ་དེ་ལྟར་འབོད་ཀྱིན་འདུག་ཟེར།",
    "བོད་དམག་ཅེས་བྲིས་འདུག་ལ་ལས་པེ་མཱ་སོགས་ཅི་རིགས་བྲིས་ཡོད་པའང་མཐོང་བྱུང་།",
    "དེར་དོན་དག་ཚབས་ཆེན་གཅིག་ལ་བརྩི་བཞིན་འདུག་ཞྭ་དཀར་གྱི་སྟེང་ལ་བྱ་སྤུ་གཉིས་ཡིན་ན་གཉེན་སྒྲིག་བྱས་ཟིན་པ་དང་།",
    "ཡེ་སེ་ལྷ་མའི་སྐུ་བརྙན་སོགས་གང་ཡང་མི་འདུག་ངས་ཐང་ག་འདྲ་ཨེ་ཡོད་ཅེས་དྲིས་པ་ན།",
    "མངོན་གསལ་གྱི་ཕན་འབྲས་ནི་གང་ཡང་ཐོབ་མི་འདུག་གོ།",
    "ཞེང་དུ་ཡས་མས་ཤིག་འདུག་གོ།",
    "གསེར་ཁོག་སྨད་ཕྱོགས་སུ་བེ་རོ་ཙ་ན་དང་འབྲེལ་བའི་གཏམ་རྒྱུད་མང་ཞིང་།",
