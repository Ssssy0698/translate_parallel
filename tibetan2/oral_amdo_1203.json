    "གཉིས་པ་དེ་དགག་པ་ལ་བརྒྱད་ལས་དང་པོ་རང་བཞིན་གཅིག་གིས་བསྐྱེད་པ་དགག་པ་ནི།",
    "ཁྱོད་བསྐྱེད་པ་ལ་ལྷན་ཅིག་བྱེད་པས་སོགས་དོན་མེད་དུ་གྱུར།",
    "ས་སོགས་དང་བྲལ་བའི་ས་བོན་རྐྱང་པས་ཀྱང་ཁྱོད་དངོས་སུ་བསྐྱེད་པའི་ཕྱིར་རོ།",
    "ས་སོགས་རྐྱེན་གཞན་གྱི་ཁྱད་པར་རྣམས་དང་བྲལ་བའི་ས་བོན་གཅིག་ཉེ་བ་ལས་ཀྱང་ཁྱོད་དངོས་སུ་བྱེད་པར་ཐལ།",
    "ས་ཆུ་དང་བྲལ་བའི་ས་བོན་གཅིག་ལའང་ཁྱོད་ཀྱི་རྒྱུ་ཚོགས་ཀྱི་ཐ་དད་མེད་པའི་ངོ་བོ་གཙོ་བོ་དེ་གནས་པའི་ཕྱིར་རོ།",
    "ས་ཆུ་སོགས་རྐྱེན་གྱི་བྱེ་བྲག་རྣམས་ཚོགས་པ་ལས་འབྱུང་གི་གཙོ་བོ་ལས་བྱུང་བ་མིན་པར་ཐལ།",
    "གཅིག་གི་འབྲས་བུ་གཞན་གྱི་མིན།",
    "གཅིག་ཅར་སྐྱེ་འཇིག་བྱེད་པར་ཐལ།",
    "སྔར་གྱི་དེ་ལྟར་ཐལ་བར་མི་འགྱུར་ཞེ་ན།",
    "ཁྱད་པར་དེའི་རང་བཞིན་མིན་པར་ཐལ།",
    "ཁྱད་པར་གཅིག་འཇིག་པའི་ཚེ་ན་ཁྱོད་མི་འཇིག་པར་གནས་ན་ནིའོ།",
    "འདི་འདིའི་སྤྱིའོ་འདི་འདིའི་ཁྱད་པར་རོ་ཞེས་སྤྱི་དང་ཁྱད་པར་ཕན་ཚུན་འབྲེལ་པར་བློ་མ་འཁྲུལ་བས་འཛིན་པར་མི་འགྱུར་ཞིང་སྒྲས་དོན་མཐུན་དུ་བརྗོད་པ་མི་སྲིད་པར་ཐལ།",
    "དེ་མིན་བཅད་ལྡོག་གི་སྤྱི་དང་།",
    "དེ་དག་གིས་ནི་གཞན་སེལ་པའི་དང་།",
    "འགྱུར་ཞེས་པའི་ཐལ་བ་འཕེན་པར་རིགས་པ་མིན་ཏེ།",
    "དེ་ཡིས་མྱུ་གུ་སྐྱེད་པར་བྱེད་པའི་ངོ་བོ་གང་ཡིན་པ་དེ་ས་ཆུ་ལ་མེད་པའི་ཕྱིར་ཞེས་ཁྱོད་ཀྱིས་བཀོད་པ་དེ་ཐལ།",
    "དེས་ན་རང་གི་ངོ་བོ་ཐ་ས་བོན་གྱི་ངོ་བོས་མི་བསྐྱེད་ཀྱང་རང་རང་གི་ངོ་བོ་ཉིད་ཀྱིས་དེ་སྐྱེད་བྱེད་ཡིན་པའི་ཕྱིརདད་པ་དང་འབྲས་བུ་གཅིག་བསྐྱེད་པ་ལ་འགལ་བ་མེད་དོ།",
    "དེས་བསྐྱེད་ནས་དེ་ས་བོན་གཅིག་ལ་གནས་པས་ཀྱང་མྱུ་གུ་བསྐྱེད་པར་ཐལ་བའི་འཇིག་པ་མེད་པའི་ཕྱིར།",
    "རྫས་ཐ་དད་དུ་ཐལ།",
    "འང་གིས་སྐྱེ་འཇིག་ཐ་དད་དུ་བྱེད་པས་ཀྱང་ཐ་དད་པར་བསྒྲུབས་པ་བསྡུས་པ་ཡིན་ནོ།",
    "དེ་ནི་རང་གི་མཚན་ཉིད་དུའང་འདོད་པར་རིགས་ཏེ།",
    "རང་གི་ངོ་བོས་ས་ལུ་མི་སྐྱེད་པའི་ཕྱིར།",
    "མ་གྲུབ་སྟེ་ཡོན་ཏན་གསུམ་ལའང་ས་ལུ་དང་ནས་ཀྱི་ས་བོན་སོགས་དེ་དང་དེའི་བདག་ཉིད་དེས་གནས་སྐབས་ཐ་དད་པའང་ཡོད་པས་དེའི་ཕྱིར་ཕན་ཚུན་ས་ལུ་དང་ནས་ཀྱི་ས་བོན་སོགས་ཀྱི་བདག་ཉིད་གཅིག་གཅིག་གི་འབྲས་བུ་བསྐྱེད་པའི་བྱ་བ་མེད་ཅེ་ན།",
    "ས་ལུ་མི་བྱེད་པར་ཐལ།",
    "གཙོ་བོ་དེས་ལུའི་ས་བོན་ནས་ཀྱི་མྱུ་གུ་མ་བསྐྱེད་པའི་བདག་ཉིད་དུ་གྱུར་པ་ཉིད་དུས་གཞན་དུ་ཡོངས་སུ་འགྱུར་ནས་མྱུ་གུ་བྱེད་པ་པོར་འགྱུར་བ་ལ་ནུས་པ་ཉེ་བར་སྦྱོར་བའི་ཕྱིར་བྱེད་དང་མི་བྱེད་འགལ་བར་ཐལ་བ་འདོད་ཅེ་ན།",
    "རྣམ་དབྱེ་ཐ་དད་མེད་པའི་རྟག་པ་གཅིག་མིན་པར་ཐལ།",
    "ཤིན་ཏུ་ཐ་དད་ནས་སྤྱི་གཅིག་གི་བདག་ཉིད་དུ་མི་འགྱུར།",
    "གལ་ཏེ་སྤྱི་དང་ཁྱད་པར་ནུས་པ་དང་གནས་སྐབས་ཡིན་པས་རྣམ་པ་འགའ་ཞིག་གིས་ཐ་དད་དུ་འདོད་ཅེ་ན།",
    "སྤྱི་དང་ཁྱད་པར་དེ་དག་གི་ནང་ནས་རང་བཞིན་ནུས་པ་འདི་ནི་སྤྱིའོ་ཞེས་བྱ་བའི་སྒོ་ནས་ཐ་དད་དུ་བཞག་པའི་གསལ་བ་འདི་ནི་ཁྱད་པར་ཡིན་ལ།",
    "ཁྱབ་པ་ཡོད་གལ་རྟག་པ་དང་གསལ་བ་མི་རྟག་པའི་བདག་ཉིད་ཀྱི་རང་བཞིན་ཐ་དད་ཡིན་པ་གང་གིས་སོཏེ་ནུས་པ་དང་གསལ་བ་དེར་བཞག་པའི་བདག་ཉིད་དེས་སྤྱི་དང་ཁྱད་པར་བདག་ཉིད་ཐ་དད་དུ་འཇོག་པའི་ཕྱིར་ནའོ།",
    "སྤྱི་དང་ཁྱད་པར་ཅན་དང་ཁྱད་པར་སྤྱི་ཅན་དུ་མ་འགྱུར་བར་ཐལ།",
    "རྨོ་སོགས་ཀྱི་དོན་བྱེད་པའི་བ་ལང་རང་མཚན་གྱི་བདག་ཉིད་གང་གི་མདུན་དུ་དམིགས་པར་བར་རིགས་ཏེ།",
    "ཁྱབ་པ་ཡོད་རྨོ་སོགས་ཀྱི་དོན་བྱེད་པ་དེའི་རྟེན་ཁྱད་པར་རང་མཚན་ཁོ་ན་རང་གི་ངོ་བོས་ནང་ཕན་ཚུན་ཤིན་ཏུ་བདག་ཉིད་ཐ་དད་ཅིང་བ་ལང་ཉིད་དང་རྫས་ཉིད་ལ་སོགས་པར་ལྡོག་པ་མཚུངས་པ་ཉིད་དག་ནི་རྟོག་ངོར་ཡོད་པ་ཉིད་ཀྱི་ཕྱིར་དེ་ཙམ་གྱིས་ཐ་དད་དང་ཐ་དད་མེད་པའི་སྤྱོད་པ་ཡོངས་སུ་རྫོགས་པ་ཡིན་ནོ།",
    "ཇི་སྐད་དུ་རྔ་མོ་འདི་ཞོར་འགྱུར་ཏེ།",
    "རང་བཞིན་གཅིག་མིན་པར་ཐལ།",
    "དེ་རྔ་མོ་ཡིན་ལ་ཞོ་མིན་པའི་ཁྱད་པར་བསལ་བར་ཐལ།",
    "ཞོ་ཡང་ཡིན་ལ་རྔ་མོ་ཡང་ཡིན་པའི་ཕྱིར་ཏེ།",
    "རྔ་ཞོ་སོགས་དངོས་པོ་ཐམས་ཅད་རང་གཞན་གཉིས་ཀའི་ངོ་བོར་ཐུན་མོང་བ་ཉིད་ཡིན་པའི་ཕྱིར་རོ།",
    "ཅིའི་ཕྱིར་རྔ་མོ་འཐུང་བ་ལ་མི་རྒྱུག་སྟེ་རྒྱུག་པར་རིག་པར་ཐལ།",
    "ཞོ་ནི་འོ་མ་ལས་གྱུར་པ་རྔ་མོ་ལ་མེད་པའི་ཁྱད་པར་ཅན་ཡིན་པ་གང་གིས་ཏེ་དེའི་ཁྱད་པར་གྱིས་རྔ་མོ་སྤངས་ནས་ཞོ་འཐུང་བ་ལ་འཇུག་པར་འགྱུར་ཞེ་ན།",
    "རྔ་ཞོ་གཉིས་ཀའི་ངོ་བོ་མིན་པར་ཞོ་དེ་རྔ་མོ་ལས་རང་བཞིན་གཞན་ཡིན་པར་ཐལ།",
    "དེ་ཉིད་ཞོ་ཡིན་ཞིང་གཞན་རྔ་མོ་ལ་མེད་པའི་ཕྱིར།",
    "དོན་སོ་སོར་ངེས་པའི་བློ་སྒྲ་ཐ་དད་དོན་མཐུན་འཇུག་པར་མི་འགྱུར་བར་ཐལ།",
    "རྔ་མོ་ནི་ཞོར་མི་འགྱུར་ཞིང་ཞོར་འགྱུར་ཞེས་ཐ་དད་གཅིག་ཏུ་སྨྲ་བ་དེ་ནི་རིགས་མི་སྲིད་པར་འགྱུར།",
    "དེའི་མིང་གིས་དེའི་ངོ་བོ་སྒྲུབ་པའི་སྒོ་ནས་བརྗོད་དམ་སེལ་པས་བརྗོད་ཅེས་དཔྱད་པར་བྱ་དགོས་ཀྱི་དོགས་པ་སྐྱེ་བའི་གནས་ཉིད་མ་ཡིན་ཏེ།",
    "ཅུསགྲངས་ཅན་ན་རེ་གལ་ཏེ་ཡོད་པའི་རང་བཞིན་དེ་གཏན་ཚིགས་སུ་རུང་ན་ཇི་ལྟར་ཡོད་པ་བསྒྲུབ་བྱེད་ཡང་རུང་འདོད་ན་ཡོད་པའི་སྤྱི་སྒྲུབ་ན་གྲུབ་ཟིན་པའི་སྐྱོན་དུ་འགྱུར་བས་ཁྱད་པར་གཙོ་བ་མིན་ཏེ་རུང་བར་མཚུངས་ལ།",
    "ག་ལས་ཉམས་པར་ཐལ།",
    "དེས་ན་རང་ཀྱང་འགྲུབ་པར་མི་འགྱུར་བར་ཐལ།",
    "མི་རྟག་པ་དེ་ཙམ་རང་གི་ཁྱབ་བྱེད་དུ་ངེས་པའི་རྟགས་ཡང་དག་ཡིན་པའི་ཕྱིར་རོ།",
    "གཙོ་བོ་ཡོད་པར་སྒྲུབ་པའི་རྟགས་ཡང་དག་ཏུ་མེད་པར་ཐལ།",
    "གཙོ་བོ་དངོས་པོར་ཡོད་པ་ལ་འཁྲུལ་པ་ཅན་དུ་ཐལ།",
    "གཙོ་བོར་དངོས་པོར་སྒྲུབ་པ་ལ་འགལ་བའི་གཏན་ཚིགས་སུ་ཐལ།",
    "གཙོ་བོ་དངོས་པོ་ཡོད་པ་དེ་ཇི་ལྟར་བསྒྲུབ་བྱ་སྐྱོན་མེད་དུ་འགྱུར་བ་མིན་པར་ཐལ།",
    "བྱས་པས་སྒྲ་མི་རྟག་པར་གྲུབ་ཏུ་ཆུག་མོད་སྐད་ཅིག་མར་ནི་མི་འགྲུབ་ཞེ་ན།",
    "རང་གྲུབ་ཙམ་གྱིས་འཇིག་པ་ནི་རང་གི་ངོ་བོས་རྗེས་སུ་འབྲེལ་པ་སྟེ་རང་བཞིན་གྱིས་འཇིག་པར་ངེས་ཏེ།",
    "རང་གི་རྒྱུ་ལས་རྒྱུ་དོན་གཞན་ལ་ལྟོས་པ་མེད་པར་འཇིག་པ་དེ་ཁྱོད་ཀྱི་རང་བཞིན་དུ་བྱུང་བའི་ཕྱིར་ནའོ།",
    "ངེས་པར་འཇིག་པར་འགྱུར་བར་མཐོང་བ་མེད་པར་ཐལ།",
    "གང་གི་ཕྱིར་ན་རང་གྲུབ་ཙམ་གྱིས་མི་འཇིག་རང་འཇིག་པར་འགྱུར་བ་རང་རྒྱུ་ལས་དོན་གཞན་ཕྱིས་ཀྱི་རྒྱུ་ལ་ལྟོས་པ་དང་བཅས་པའི་ཕྱིར།",
    "དེ་ལ་བུམ་པ་འཇིག་པས་ཁྱབ་པ་འཁྲུལ་པ་ཉིད་དུ་ཐལ།",
    "རང་གི་འབྲས་བུར་འདོད་པའི་འཇིག་པ་དེ་ཁྱོད་ལ་ལྟོས་པར་ངེས་པ་མིན་པར་ཐལ།",
    "ཐ་དད་ན་བུམ་པ་འཇིག་པར་མ་བྱས་པར་ཐལ་ལོ།",
    "ཡང་གིས་འཇིག་པ་དངོས་མེད་ཡིན་པར་ནུསམྨ་འདོད་པ་ལྟར་ན།",
    "བུམ་པའི་འཇིག་པ་བསྐྱེད་པར་མི་འཐད་པར་ཐལ།",
    "རང་གྲུབ་ཙམ་གྱི་ངོ་བོ་ཉིད་ཀྱིས་སྐད་ཅིག་གིས་སུ་པུཀ་འཇིག་པར་འགྱུར།",
    "བསྐལ་དོན་ལུང་ལ་བརྟེན་པའི་ཡིད་ཆེས་རྗེས་དཔག་གིས་མ་དམིགས་པས་མེད་ངེས་སུ་མི་འགྲུབ་པར་ཐལ།",
    "བསྐལ་དོན་གྱི་འབྲས་བུ་དམིགས་པའི་རྟགས་ལ་བརྟེན་པ་ཅན་གྱི་རྗེས་དཔག་གི་བསྐལ་དོན་གཞལ་བྱར་མེད་དེ།",
    "ཡོད་ན་སྣང་རུང་གི་བུམ་པའི་དངོས་པོ་མ་དམིགས་པ་ལས་བུམ་མེད་ཀྱི་གཞི་ལ་སྣང་རུང་བུམ་པའི་དངོས་པོ་མེད་པར་རྟོགས་པར་འགྱུར་ཏེ།",
    "དེས་གྲང་རེག་དེ་ཡོད་པ་ལ་གནོད་པར་བྱེད་པའི་ཚུལ་གྱིས་གྲང་རེག་དང་ལྷན་ཅིག་མི་གནས་པའི་འགལ་བར་ངེས་པའི་ཕྱིར་རོ།",
    "སློབ་དཔོན་ཕྱོགས་གླང་གིས་གཙོ་བོ་ལ་སོགས་པ་ནི་ཡོད་པ་མིན་ཏེ།",
    "ཇི་ལྟར་ན་དངོས་པོ་དངོས་མེད་དེ་གཉིས་ཀའི་རྣམ་༣ རྟོག་གི་བག་ཆགས་ལས་བྱུང་བའི་ཡོད་པ་དང་མེད་པ་དང་དེ་གཉིས་ཀ་ལ་བརྟེན་པའི་སྒྲ་དོན་གསུམ་སྟེ།",
    "ས་ལརལེན་ཅན་དུ་མེད་པར་སྒྲུབ་དགོས་པའི་བློ་ངོར་མ་དམིགས་པའི་རྟགས་བསྒྲུབ་བྱ་མིན་པར་ཐལ།",
    "དེ་ལ་དོན་བྱེད་པ་དོན་གཉེར་གྱིས་བརྟགས་པས་ཅི་ཞིག་བྱ་སྟེ་དཔྱད་བྱའི་རང་མཚན་མ་ཡིན་པར་ཐལ།",
    "ལུང་གིས་མ་ཁྱབ་པའི་ཤེས་བྱ་མེད་པས་དེ་ལོག་པས་ཇི་ལྟར་མེད་ངེས་གོ་བྱེད་མིན་ཞེ་ན།",
    "ངག་སྔ་ཕྱི་རྣམས་བླང་དོར་བཏང་སྙོམས་སུ་བྱ་བ་ལྟ་བུའི་དོན་གཅིག་ལ་བསྡུར་བཏུབ་པས་ཚིག་གི་དོན་ཕན་ཚུན་འབྲེལ་ཆགས་པས་འབྲེལ་པ་དང་ནི་སྐྱེས་བུའི་འདོད་བྱའི་འབྲས་བུ་དང་རྗེས་སུ་འཐུན་པའི་ཐབས་ནུས་པ་ཅན་སྟོན་པ་དང་སྐྱེས་བུའི་དོན་མངོན་མཐོ་ངེས་ལེགས་ནི་བརྗོད་པར་བྱེད་པ་ལ་དཔྱད་པ་གསུམ་གྱིས་ཡོངས་སུ་དག་པའི་ངག་ཡིན་པ་གཅིག་ཤིན་ཏུ་ལྐོག་གྱུར་གྱི་དོན་ལ་མི་སླུའི་དེ་ལས་གཞན་པའི་ངག་ནི་དེ་ལ་སླུ་བའི་ཕྱིར་རོ།",
    "སྐྱེས་བུའི་དོན་གྱི་ནུས་པ་མེད་པ་བྱ་རོག་གིས་བརྟགས་པ་ལྟ་བུ་ལུང་ཡང་དག་ཡིན་པ་གཅོད་དོ།",
    "ཇི་ལྟར་མངོན་སུམ་དང་དངོས་པོ་སྟོབས་ཞུགས་རྗེས་དཔག་གི་ཡུལ་ལ་མི་སླ་བ་དེ་ལྟར་ཤིན་ཏུ་ལྐོག་གྱུར་ལའང་མི་སླུ་བར་སྤྱི་ལས་ཏེ་མཚུངས་ཏེ།",
    "དཔེར་ན་མངོན་སུམ་རྗེས་དཔག་གི་ཡུལ་ལུང་ལས་རྟོགས་པ་ལྟ་བུའོ།",
    "གལ་ཏེ་དོན་ཇི་ལྟར་གནས་པ་བཞིན་ཤེས་ཤིང་ཉེས་པ་ཟད་པའི་སྐྱེས་བུ་གཞན་ལས་ཕུལ་དུ་བྱུང་བ་ལ་ལྟོས་པ་སྟེ་དེས་བྱས་པའི་ཚིག་ནི་རང་གིས་བསྟན་པ་ཇི་ལྟ་བ་བཞིན་གྱི་བརྗོད་བྱའི་དོན་ལ་མི་སླུ་བ་ཉིད་དུ་རྒོལ་བ་གཞན་གྱིས་རབ་ཏུ་ཤེས་པར་འགྱུར་རོ་ཞེ་ན།",
    "གལ་ཏེ་སྐྱེས་བུ་ཕུལ་དུ་བྱུང་བ་དེ་སྐྱེས་བུས་ངེས་པར་ཤེས་པར་ནུས་ན་དེས་བྱས་པའི་ལུང་བརྗོད་བྱའི་དོན་ལ་མི་བསླུ་བའི་དོན་འདི་ཁོ་བོ་ཅག་འདོད་པ་ཁོ་ན་ཡིན་གྱི་དེ་ལྟ་བུ་སྤོང་བར་མི་བྱེད་མོད།",
    "ཉེས་པ་བསྐྱེད་པའི་ཕྱིར་འབད་རྩོལ་ཡོད་དུ་ཟིན་ཡང་འཚེ་བ་མེད་སོགས་གསུམ་ལས་ཕྱིན་ཅི་ལོག་འཚེ་བ་ཅན་དང་ཕྱིན་ཅི་ལོག་གི་དོན་ཅན་སེམས་ཀྱི་རང་བཞིན་མ་ཡིན་པའི་ཉེས་པ་དག་གིས་རྒྱུན་མི་བཟློགས་ཏེ།",
    "སྐད་ཅིག་གིས་འཇིག་པ་དུ་མ་ཚོགས་པ་ལ་རྟག་གཅིག་ཏུ་ལྟ་བ་ལས་ཀ་ཨ་ཀ་ནཾསྐྱེ་བ་ཡིན་ཏེ།",
    "བདག་དང་བདག་གིར་ཞེན་པ་ལས་བྱུང་བའི་ཕྱིར།",
    "སྐྱེ་བའི་གོ་རིམ་ཡང་ཐོག་མེད་ནས་གོམས་པ་ལས་བདག་གིར་ལྟ་བ་སྐྱེ་ཞིང་།",
    "དེས་བདག་དང་བདག་གིར་ཞེན་པའི་ཡུལ་དེ་ལ་བདག་གི་བ་དེར་ཆགས་པ་སྐྱེ་ལ།",
    "བདག་དང་བདག་གིར་ཆགས་པ་དེ་ལས་བདག་དང་བདག་གི་བའི་མི་མཐུན་ཕྱོགས་ལ་ཞེ་སྡང་ལ་སོགས་པས་ང་རྒྱལ་དང་ཐེ་ཚོམ་འབྱུང་ངོ།",
    "ཉོན་མོངས་པ་ཐམས་ཅད་ནི་མ་རིག་པའི་རྒྱུ་ཅན་ཡིན་ཞེས་སོ།",
    "བདེན་པའི་དོན་ཅན་དུ་ཐལ།",
    "ལོག་པའི་དོན་ཅན་ཅིའི་ཕྱིར་མིན་ཏེ་ཡིན་པར་ཐལ།",
    "དང་པོ་ལ་གཉིས་ཀྱི་དང་པོ་བརྡ་ལ་ལྟོས་པས་ལོག་པ་སྟོན་པར་ཐལ་བ་ནི།",
    "སྐྱེས་བུས་བྱས་པ་མིན་དུ་ཆུག་ན་ཡང་དོན་ཕྱིན་ཅི་ལོག་སྟོན་པ་ཉིད་དུ་སྲིད་པར་ཐལ།",
    "དེས་དོན་གོ་ཞིང་ཤེས་པར་བྱེད་པ་དག་གི་རྒྱུ་བརྡ་ནི་སྐྱེས་བུས་བྱས་པ་ལ་བརྟེན་པའི་ཕྱིར།",
    "གཉིས་པ་སྒྲ་དོན་ངོ་བོ་ཉིད་ཀྱིས་འབྲེལ་པ་དགག་པ་ལ་གཉིས་ཀྱི་དང་པོ་ཧ་ཅང་ཐལ་བས་དགག་པ་ནི།",
    "འདོད་པ་དང་འགལ་བའི་དོན་གསལ་བར་བྱེད་པ་ཡིན་སྲིད་པར་ཐལ།",
    "བྱིབས་དེ་རྣམ་པར་གཞག་པའི་ཕྱིར་གཏན་ཚིགས་བརྗོད་དགོས་པར་ཐལ།",
    "གི་ངོ་བོ་མིན་པས་བདག་མི་གཅིག་ཅིང་རྟག་པའི་ཕྱིར་བརྗོད་འདོད་དང་ཕྱི་རོལ་གྱི་དོན་གང་དང་ཡང་དེ་བྱུང་དུ་མ་འབྲེལ་བའི་ཕྱིར་རོ།",
    "དེ་ལ་བརྟེན་པའི་འབྲེལ་པ་ལ་རྟག་པ་ཡོད་པ་མ་ཡིན་པར་ཐལ།",
    "སྐྱེས་བུའི་བློ་ཡིས་ལེགས་པར་བཞག་པར་བྱས་པར་ཐལ།",
    "ཐལ་བ་སྔ་མ་འདོད་ན་སྒྲ་དོན་སྔ་མ་ཞིག་པའི་ཚེ་ན་འབྲེལ་པའང་ཞིག་པས་དོན་སྔར་མེད་ལ་འབྲེལ་པ་མེད་པས་དེ་མི་གོ་བར་འགྱུར་རོ།",
    "གསལ་བྱེད་གསལ་སོགས་རང་གི་ཕན་འདོགས་པའི་དོན་ཅི་བྱས་ཏེ་མ་བྱས་པའི་ཕྱིར་ཏེ།",
    "དམིགས་རུང་གི་རྫས་ཐ་དད་གསུམ་ཡིན་པའི་ཕྱིར།",
    "སྒྲ་དོན་མ་འབྲེལ་པ་དེའི་བདག་ཉིད་དུ་ཐལ།",
    "འདོད་ན་སྒྲ་དོན་རྫས་ཐ་དད་དེའི་འབྲེལ་པ་མིན་པར་ཐལ་ལོ།",
    "དངོས་པོར་ཡོད་པ་མ་ཡིན་པར་ཐལ།",
    "པ་པ་མ་ཡིན་པར་ཐལ།",
    "དེ་ཡོད་དུ་ཟིན་ཀྱང་རྗོད་བྱེད་མིན་པར་ཐལ།",
    "རང་གི་བརྗོད་བྱ་དང་རྗོད་བྱེད་ཀྱི་དངོས་པོ་ཡི་ནི་རང་བཞིན་གྱི་འབྲེལ་པ་འདི་ཇི་ལྟ་བུར་ནི་འཇུག་པར་འགྱུར་ཏེ་མི་འགྱུར་བར་ཐལ།",
    "དོན་དམ་པར་བརྗོད་བྱ་དང་རྗོད་བྱེད་ཀྱི་འབྲེལ་པ་དངོས་པོ་བ་མེད་པར་ཐལ།",
    "དཔྱོད་པ་པ་ན་རེ།",
    "འདི་ལྟ་བུའི་རྣམ་པའི་གཞུང་གི་དངོས་པོ་ལའང་རྗེས་སུ་འབྲངས་ནས་འདི་ལྟར་ཡིན་ནོ་ཞེས་བརྗོད་པར་བྱེད་པ་ཡོད་པ་དེས་ན་རྟོག་པ་དང་ལྡན་པར་སེམས་པ་དེ་ལྟར་སྨྲ་བའི་རྒྱལ་དཔོག་པ་དེ་ཉིད་འགྲོ་བ་ལ་བརྩེ་བ་མེད་པས་གནོད་པ་བྱེད་པ་ཅན་གྱི་ངན་པའི་སྟེ་མ་རིག་པ་ཉིད་འཆིང་བ་བརྟན་པའི་མུན་པ་ཆེན་པོས་ཁྱབ་པར་བྱེད་པ་ཡིན་ནོ།",
    "མ་བྱས་པར་ཐལ།",
    "རིག་བྱེད་འདོན་པར་བྱེད་པ་གཞན་སྔོན་དུ་སོང་བ་ཡིན་ཏེ།",
    "ཚིག་གི་བཀོད་པ་ངག་ནི་བརྗོད་པའི་ནུས་པ་མེད་པ་དེ་ལྟར་རོ།",
    "དེའང་རིག་བྱེད་དེ་ལྟར་སྐྱེས་བུས་མ་བྱས་པར་རྗེས་མི་དཔོག་སྟེ་དཔོག་པར་རིག་པར་ཐལ།",
    "འདོན་པ་གཞན་སྔོན་དུ་སོང་བས་ཐོག་མ་མེད་པའི་དུས་ཅན་དུ་གྲུབ་པའི་ཕྱིར་ཏེ།",
    "དེ་སྐྱེས་བུས་མ་བྱས་ལ་འཇིག་རྟེན་པའི་ངག་སྐྱེས་བུས་བྱས་པའི་ཁྱད་པར་དག་ནི་མ་བསྟན་པར་ཏེ་བསྟན་པར་མི་ནུས་པར་ཐལ།",
    "མ་བྱས་པར་སྒྲུབ་པའི་གཏན་ཚིགས་རབ་ཏུ་རྒྱ་ཆེར་སྤྲོས་པ་གང་ཡིན་པ་དེ་དག་ཐམས་ཅད་ཁྱབ་པ་འཁྲུལ་པ་ཅན་དུ་ཐལ་ལོ།",
    "ཅད་ཟཆསུསྔོན་དུ་སོང་བར་གྲུབ་པས་རིག་བྱེད་རྣམ་པ་ཀུན་ཏུ་ཐོག་མེད་དུ་གྲུབ་པར་གྱུར་དུ་ཆུག་མོད།",
    "ཐོག་མ་མེད་པར་གྲུབ་པ་དེ་ལྟར་ནའང་སྐྱེས་མིན་རྟེན་ཅན་ཏེ་སྐྱེས་བུས་མ་བྱས་པར་གྲུབ་པ་མིན་པར་ཐལ།",
    "སྐྱེས་བུས་བྱས་པའི་སྒོ་ནས་དེའི་སྒྲ་སྒྲོགས་ཀྱི་སྐྱེས་བུའི་བྱེད་པ་ལ་མ་ལྟོས་པར་རང་ཉིད་ཀྱིས་རང་གི་སྒྲ་ཟའ་པ་སྒྲོགས་པ་མེད་པའི་ཕྱིར།",
    "རང་གི་རིགས་ཀྱི་རིམ་པ་ལས་འོངས་པ་པ་ཤི་ནས་བུ་ཐུ་བོས་མ་བག་མར་བླང་བར་བྱའོ་ཞེས་བྱ་བའི་ཀླ་ཀློའི་ཐ་སྙད་དང་།",
    "རིག་བྱེད་མི་སླུ་བར་འགྲུབ་པའི་ཡོན་ཏན་ཅི་ཞིག་ཡོད་དེ་མེད་པར་ཐལ།",
    "དོན་བདེན་པ་མཐའ་གཅིག་ཏུ་ངེས་པ་མི་སྟོན་པར་དེས་རང་གི་བརྗོད་བྱའི་དོན་ལ་ཐེ་ཚོམ་དག་ཀྱང་བསྐྱེད་པར་ཡིན་པར་ཐལ།",
    "སྐྱེས་བུས་མ་བྱས་པར་སྒྲུབ་པར་བྱེད་ན་འབྲས་བུ་ཅིར་འགྱུར་ཏེ་མི་ནུས་པར་ཐལ།",
    "ཡན་ལག་དུ་མའི་བདག་ཉིད་ཡིན་ནའང་ཡན་ལག་རེ་རེའང་དོན་དང་མི་ལྡན་ནམ་ལྡན།",
    "ཡན་ལག་དེ་རྣམས་ཐ་དད་རེ་རེ་ལ་དོན་སྟོན་པའི་ནུས་པ་མེད་པ་ཉིད་དོ་ཞེ་ན།",
    "སྐྱེས་བུས་བྱས་པར་ཐལ།",
    "བརྗོད་བྱ་དེའི་དངོས་པོ་སྟེ་དོན་ཅན་མིན་པའི་ཡི་གེའི་བཀོད་པ་ལ་ཁྱོད་ཡིན་པར་རྟོག་པས་སྒོ་བཏགས་པའི་ངག་ཡིན་པའི་ཕྱིར།",
    "དེའི་བརྗོད་བྱ་གོ་བའི་དོན་དུ་ཡི་གེ་དུ་མ་ཉིད་ཚོགས་པ་ཡིན་པར་རྟོག་པས་བརྟགས་པ་ལོག་པ་ཡིན་ཏེ་དོན་མེད་པར་ཐལ།",
    "ཡི་གེ་རེ་རེ་རྐྱང་པས་ཀྱང་བརྗོད་བྱའི་དོན་རྫོགས་པར་སྟོན་པ་དང་བཅས་པ་ཉིད་ཡིན་པའི་ཕྱིར་ནའོ།",
    "དེའི་ཡན་ལག་སོ་སོ་རེ་རེ་བ་ཡི་གེ་དེ་དག་ངག་ཡིན་པར་ཐལ།",
    "ཡན་ལག་ཡི་གེ་གཅིག་རྐྱང་པ་ནི་ཐོས་ཤིང་རྟོགས་པས་ཀྱང་ངག་གི་བརྗོད་བྱའི་དོན་དག་རྫོགས་པར་རྟོགས་པར་འགྱུར་བའི་ཕྱིར་རོ།",
    "དེའི་ཡན་ལག་རྣམས་ཐོས་པ་དུས་ལ་སྡོད་པའི་སྒོ་ནས་དུས་ཀྱི་ཁྱད་པར་སྔ་ཕྱིར་ཐོས་པ་མི་རུང་བར་ཐལ།",
    "གཉིས་པ་ངག་ལ་ཆ་ཤས་མེད་པ་ལ་དགག་པ་ལ་བཞིའི་དང་པོ་རིམ་གྱིས་རྟོགས་པ་མིན་པར་ཐལ་བ་ནི།",
    "དེའི་ཆ་ཤས་རྣམས་རིམ་གྱིས་རྟོགས་པ་མི་སྲིད་པར་ཐལ།",
    "སྐྱེས་བུའི་འབད་རྩོལ་ལས་བྱུང་བར་ཐལ།",
    "མཅི་སྐྱེས་བུས་བྱས་པ་མིན་ཏེ་མིན་པར་ཐལ་ལོ།",
    "མ་ངེས་ཏེ་རེས་འགའ་སྒྲིབ་བྱེད་ཀྱིས་སྒྲིབ་པའི་ཕྱིར་ཞེ་ན།",
    "དེས་ཉན་ཤེས་བསྐྱེད་པའི་གེགས་སྒྲིབ་བྱེད་ཀྱིས་མི་བྱེད་པར་ཐལ།",
    "དེ་འགའ་ཞིག་གི་ཚེའང་སྒྲིབ་པར་བྱེད་པ་མེད་པའི་ཕྱིར་ཏེ་རྟག་པས་སོ།",
    "འགའ་ཞིག་གི་ཚེ་ཡུལ་འགའ་ཞིག་ཏུ་ལྷན་ཅིག་བྱེད་པས་ཐོས་རུང་དུ་བྱེད་པས་ཐོས་པ་ཡིན་ནོ་ཞེ་ན།",
    "སྔར་གྱི་རང་བཞིན་དུ་ངེས་པའི་རྟག་པ་དག་ནི་འགལ་བ་ཡིན་པར་ཐལ།",
    "ཡུལ་གཅིག་གི་རིག་བྱེད་ཀྱི་སྒྲ་མ་དམིགས་པ་གང་ཞིག་སྒྲ་ཐམས་ཅད་ཆ་མེད་རྫས་གཅིག་ཡིན་པའི་ཕྱིར།",
    "བཞི་པ་དེའི་ཉེས་སྤོང་གི་ལན་དགག་པ་ནི།",
    "རྐྱེན་གྱིས་འདུས་བྱས་པ་ཉན་ཤེས་ཀྱིས་དམིགས་པ་མིན་པར་ཐལ།",
    "རྐྱེན་གང་གིས་ཀྱང་ཐོས་རུང་དུ་འདུ་བྱེད་པར་མི་འགྱུར་བའི་ཕྱིར་ཏེ་འགྱུར་བ་མེད་པས་སོ།",
    "གིས་དོན་སྒྲ་གཅིག་ཁོ་ན་འཛིན་པར་ངེས་པ་ཡིན་པས་ཐམས་ཅད་ཅིག་ཅར་མི་ཐོས་ཞེ་ན།",
    "སྒྲ་ཙམ་ལས་རྫས་ཐ་དད་པའི་རྗོད་བྱེད་ཀྱི་སྒྲ་ཡོད་དོ་ཞེས་སྒྲུབ་མི་ནུས་པར་ཐལ།",
    "རྗོད་བྱེད་རྐྱང་པ་གཅིག་ཇི་ལྟར་ཐོས་པ་ཡིན་ཏེ་མིན་པར་སྒྲ་ཙམ་དོན་གཞན་ཡང་ཐོས་པར་ཐལ།",
    "མ་གྲུབ་ན་མང་པོས་སྨྲས་པའི་ཚེ་ནའང་སྒྲ་ཙམ་ཐོས་རུང་དུ་མེད་པར་ཐལ་བའི་ཕྱིར་རོ།",
    "དེས་ཅིག་ཅར་སྒྲ་ཙམ་དུ་མ་ཐོས་པ་ན་དེ་ལས་ཐ་དད་པའི་རྗོད་བྱེད་ཀྱི་སྒྲ་རྟོགས་པར་ཇི་ལྟར་མི་འགྱུར་ཏེ་འགྱུར་བར་ཐལ།",
    "རྗོད་བྱེད་ཀྱི་སྒྲ་རེ་རེ་འཛིན་པ་ལ་ནུས་པ་ངེས་པའི་ཕྱིར་རོ།",
    "རྗོད་བྱེད་མིན་པར་ཐལ།",
    "སྔ་མ་ལ་ཁྱབ་པ་ཡོད་སྔ་ཕྱིའི་ཆ་དང་བཅས་པའི་ཉེས་པ་གང་དང་གང་གིས་སྒྲ་ཙམ་རྗོད་བྱེད་དུ་དཔྱོད་པ་པ་མི་འདོད་པས་སོ།",
    "ཡི་གེ་དང་རྫས་གཅིག་གི་རིམ་པ་མ་བྱས་པ་དགག་ཐ་དད་ཀྱི་རིམ་པ་བཀག་ཟིན་ཏུ་བསྟན་པའོ།",
    "སྐྱེས་བུས་མ་བྱས་པ་མིན་པར་ཐལ།",
    "དེར་ཐལ།",
    "མ་གྲུབ་ན་རིག་བྱེད་ཀྱི་ཡི་གེ་ལ་ཁྱོད་ངེས་པ་ཅན་དུ་འགྱུར་ཞིང་།",
    "འཇིག་རྟེན་པས་རང་གི་འདོད་པ་ལྟར་གཞན་དུ་འགྱུར་བ་ནི་འགལ་བར་ཐལ།",
    "ཡང་གཅིག་ཡིན་པའི་ཚེ་ན་གཅིག་མིན་པ་ས་བོན་དང་མྱུ་གུ་དང་སྡོང་བུ་ལྟ་བུའི་དུས་ཀྱི་གོ་རིམ་མེད་པར་ཐལ།",
    "ལྕེ་རྐན་སོགས་ཀྱིས་གསལ་བར་བྱས་པའི་རིམ་པའང་ངག་མིན་པར་ཐལ།",
    "གྲུབ་ཟིན་བྱེད་པས་གསལ་བྱ་མིན་གྱི་བྱེད་པ་ལྕེ་རྐན་སོགས་ཀྱིས་བསྐྱེད་བྱའི་འབྲས་བུ་ཉིད་ཡིན་པར་ཐལ།",
    "ཡི་གེ་ངོ་བོ་སྐྱེད་པར་བྱེད་པ་པོའི་རྒྱུ་ལས་ཁྱད་པར་ཅི་ཡོད་དེ་མེད་པར་ཐལ།",
    "དེའི་ངོ་བོ་བྱེད་པ་ལྕེ་རྐན་ལ་སོགས་པས་བསྐྱེད་བྱའི་འབྲས་ཉིད་ཡིན་གྱི་གསལ་བྱ་མིན་པར་ཐལ་ཏེ།",
    "དེའི་བྱ་བ་ལས་རིག་བྱེད་ཀྱི་སྒྲའི་ངོ་བོ་ཤེས་པའི་ཡུལ་དུ་སྔར་མེད་གསལ་བ་དམིགས་པ་དེ་མི་སྲིད་པར་ཐལ།",
    "རིགས་བྱེད་ཀྱི་སྒྲ་རང་གི་སྔར་གྲུབ་ཟིན་གསལ་བྱེད་ཙམ་ཡིན་པའི་ཕྱིར་རོ།",
    "སྒྲ་མི་རྟག་པར་ཐལ་བའི་ཕྱིར་རོ།",
