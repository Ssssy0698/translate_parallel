    "བདེན་པའི་དོན་ཅན་ལ་རྗེས་འགྲོ་ཅན་དུ་ཐལ།",
    "སྐྱེས་བུས་བྱས་པར་ཐལ།",
    "གཉིས་པ་དངོས་པོའི་ནུས་པས་འགྲུབ་པ་དགག་པ་ལ་ལྔའི་དང་པོ་གོ་རིམ་ལོག་པས་འགྲུབ་པར་ཐལ་བ་ནི།",
    "ལས་བཟློག་པའི་སློག་པ་ལ་སོགས་པས་ཀྱང་འདོད་པའི་འབྲས་བུ་སྟེར་བར་ཐལ།",
    "ཐལ་བ་ལས་བཀོད་པ་ཆུང་ངུ་ཉམས་པ་ལས་རྣམ་པར་འཚེ་བ་མཐོང་བས་སོ།",
    "དེ་ཡང་ཆགས་བཅས་ཀྱི་ལྷ་རང་གིས་འཚེ་ལ།",
    "ཆགས་བྲལ་གྱི་རང་གིས་མི་འཚེ་ཡང་དེ་ལ་དད་པའི་ལྷ་སོགས་ཀྱིས་བྱེད་དོ།",
    "གཉིས་པ་འདོད་དོན་རྟག་ཏུ་སྟེར་བར་ཐལ་བ་ནི།",
    "ཆོ་ག་སོགས་རྐྱེན་གང་གིས་ཀྱང་རང་བཞིན་ཕུལ་བྱུང་སྐབས་དུ་བསྐྱེད་པའི་ནུས་པ་མེད་པའི་ཕྱིར་ཏེ་རྟག་པས་སོ།",
    "མས་གསུམ་པ་ཀུན་གྱི་འབྲས་བུ་སྒྲུབ་པར་ཐལ་བ་ནི།",
    "སྒྲུབ་པར་བྱེད་པ་པོའི་ཁྱད་པར་མཆོད་སྦྱིན་བྱེད་པ་ལ་ཡང་ལྟོས་པ་མི་རུང་བར་ཐལ།",
    "དེ་སྦྱོར་བྱེད་བྲམ་ཟེས་འབྲས་བུ་ཐོབ་ལ་དམངས་རིགས་ཀྱིས་མི་ཐོབ་པའི་ཁྱད་པར་མི་འཐད་པར་ཐལ།",
    "བྲམ་ཟེས་སྔར་མེད་ཀྱི་ཁྱད་པར་ཅི་ཞིག་བྱེད་ནས་བྲམ་ཟེ་སྦྱོར་བར་བྱེད་པ་པོར་འགྱུར་བ་མིན་པར་ཐལ།",
    "ཁྱབ་པ་ཁས་བླངས་ཏེ་སྨྲ་བ་པོའི་བློ་ལ་སྔགས་གསལ་བའི་རྒྱུ་ཡིན་པས་ན་སྔགས་ཀྱི་འབྲས་བུ་དང་ལྡན་པར་ཁྱོད་འདོད་པའི་ཕྱིར།",
    "སྐྱེས་བུ་སྦྱོར་བར་བྱེད་པ་པོར་ཐལ།",
    "སྔགས་ཀྱི་འབྲས་བུ་འབྱིན་པ་མ་ཡིན་པར་ཐལ།",
    "གལ་ཏེ་སྔ་མ་ས་དེས་དེ་ཁྱད་པར་དུ་བྱས་པར་འཛིན་པར་མི་འགྱུར་བར་ཐལ་ཏེ།",
    "ས་འཛིན་ཉན་ཤེས་དེས་བསྐྱེད་པའི་ཨ་འཛིན་ཤེས་པ་དེ་རང་གི་ཡུལ་ཅན་དུ་ཡོད་པ་ཅན་ཡིན་པའི་ཕྱིར་རོ།",
    "ཡི་གེ་རྣམས་ཀྱི་རྒྱུ་དང་འབྲས་བུ་ཉིད་ཀྱི་གོ་རིམ་དག་ནི་ཡིན་ཞེས་བརྗོད་དེ།",
    "དཔེར་ན་མེ་གཅིག་ལ་ཤིང་གིས་ཕན་བཏགས་པས་ཤིང་གི་རྗེས་སུ་བྱེད་པར་མཐོང་བའི་རིགས་པས་རྒྱུ་ཤིང་མ་མཐོང་བའི་མེ་ཡང་ཤིང་དང་རྒྱུ་འབྲས་སུ་གྲུབ་པ་བཞིན་ནོ།",
    "འདོད་པ་ལྟར་འབྲས་བུ་སྒྲུབ་བྱེད་ཀྱི་ཡི་གེའི་གོ་རིམ་ཤེས་ཤིང་འདོད་པ་ལྟར་དོན་སྒྲུབ་ནུས་ཀྱི་མཐུ་དག་གིས་སྔགས་བྱེད་པའི་ཕྱིར།",
    "མ་ངེས་ཏེ་ཐ་མལ་པ་ནམ་མཁའ་ལྡིང་གི་རྒྱུད་ཤེས་པ་རང་གིས་བྱས་པའི་སྔགས་ཀྱིས་དུག་ཞི་བ་ལ་སོགས་བྱེད་པར་མཐོང་ལ།",
    "ཤེས་པ་མཐུ་མེད་པའི་ཐ་མལ་པ་དེའི་ནུས་པ་པནྟིལས་དུག་ཞི་བྱེད་མ་ཡིན་པར་ཐལ།",
    "གང་གིས་ན་སྔགས་བྱེད་པ་པོ་ཤེས་མཐུ་ཕུལ་དུ་བྱུང་བ་བསྒྲུབ་བྱེད་འདི་ཉིད་ཀྱིས་ནའོ།",
    "དེའི་དོན་ངེས་པ་དེ་རྟོགས་མི་སྲིད་པར་ཐལ།",
    "ཁོ་བོས་ཏེ་རང་ཉིད་ཀྱི་བྲམ་ཟེ་ཁྱོད་ཚུར་ཤོག་འདི་དོན་ཡིན་པར་ཁྱེད་ཅག་གིས་ཟུང་ཤིག་དང་།",
    "དེ་གཅིག་པུས་རིག་བྱེད་དེའི་དོན་ཉིད་རིག་ལ་གཞན་གྱིས་རིག་པ་མིན་པའི་ཁྱད་པར་ཡང་ནི་སུ་ཡིས་བྱས་ཏེ་ཁྱད་པར་མི་འཐད་པར་ཐལ།",
    "སྐྱེས་བུ་བདག་ཉིད་དང་རིག་བྱེད་ཀྱི་དོན་མཐའ་གཅིག་ཏུ་ངེས་པ་ནི་གང་ལས་རྟོགས་ཏེ་མི་རྟོགས་པར་ཐལབབགཞན་ལས་ཀྱང་རིག་བྱེད་ཀྱི་དོན་རིག་པ་མིན་ལ་སྐྱེས་བུའི་བྱེད་པ་ལ་མ་ལྟོས་པར་རིག་བྱེད་རང་ཉིད་ལས་ས་༡ ནས་ནིཀྱང་རིག་པར་བྱེད་པ་མིན་པའི་ཕྱིར་ཏེ།",
    "མཐོ་རིས་འདོད་པས་མེ་ལ་སྦྱིན་སྲེག་དཔོག་པས་འཆད་པ་དགོས་ནུས་མེད་དུ་ཐལ་བའི་ཕྱིར་རོ་བཏབ་ཅབསྦྱིན།",
    "བས་བསམ་བསམས་ནསབསཨབཟམ་སྐྱེས་བུ་གང་གིས་ཨག་ནི་ཞེས་པའི་རིག་བྱེད་ཀྱི་སྒྲའི་དོན་མེ་འདི་ཡིན་གྱིས་ཁྱི་མིན་ཞེས་རྣམ་པར་དབྱེ་མི་ནུས་པར་ཐལ།",
    "མཐོ་རིས་དང་ལྷ་མོ་ལ་སོགས་པའི་སྒྲ་གྲགས་པ་མིན་པའི་དོན་བརྗོད་པར་མཐོང་བའི་ཕྱིར་ཏེ།",
    "དེར་གནས་པའི་ལྷའི་བུ་མོ་ལ་ལྷ་མོ་ཞེས་གྲགས་པ་ལ།",
    "དེ་ལས་ནི་གྲགས་པ་ལ་མི་བརྟེན་པར་འདོད་པའི་དགའ་བ་མི་དག་གི་ནང་ནས་ཁྱད་པར་དུ་འཕགས་པ་མཐོ་རིས་དང་།",
    "དེ་ལས་ཨག་ནེ་ལ་སོགས་པའི་རིག་བྱེད་ཀྱི་སྒྲའི་དོན་མཐའ་གཅིག་ཏུ་ངེས་པ་མིན་པར་ཐལ།",
    "གང་གི་ཕྱིར་ན་དེ་ལ་ཨག་ནེ་ལ་སོགས་པའི་སྒྲ་རྣམས་དོན་སྣ་ཚོགས་ལ་འཇུག་པ་ཅན་ཉིད་དུ་མཐོང་བའི་ཕྱིར་རོ།",
    "གཉིས་པ་ལ་གསུམ་གྱི་དང་པོ་རང་གིས་སྟོན་པ་བརྫུན་པར་བསྟན་པ་ནི།",
    "སྐྱེས་བུ་འགའ་ཞིག་བདག་གིས་མི་ཤེས་ཀྱིས་འོན་ཀྱང་ལམ་ནི་འདི་འགཏིཡིན་ཞེས་སྡོང་དུམ་འདི་ནི་སྨྲ་འགྱུར་ཞེས་ལམ་སྟོན་པའི་ནུས་པས་སྟོན་པའི་སྡོང་དུམ་གྱི་ཟིལ་གྱིས་ལམ་སྟོན་ཀྱི་པར་བྱེད་པ་དང་།",
    "གཞན་དག་ནི་སྡོང་དུམ་ལ་སྨྲ་བའི་ནུས་པ་མེད་ཀྱི་བདག་ཉིད་ཀྱིས་ཤེས་པས་ལམ་ནི་འདིའི་ཞེས་སྨྲ་བ་དེ་ལྟར་ན་སྐྱེས་བུ་གཉིས་པོ་དེ་དག་གིས་དེ་སྐད་དུ་སྨྲས་པའི་རང་གི་ཚིག་ལ་བྱེ་བྲག་ཡོད་ན་བརྟག་ཀཚ་པར་གྱིས་ཤིག་བྱེ་བྲག་མེད་ཀྱང་ཉན་པ་པོ་བླུན་པོ་རྟོགས་པ་དམན་པ་དག་སྡོང་དུམ་དེ་སྐད་དུ་སྨྲ་ཞེས་ཁོང་དུ་འིཆུད་པར་འགྱུར་བ་བཞིན།",
    "རྒྱལ་དཔོག་པ་རིག་བྱེད་ཀྱི་ཟོལ་གྱི་སྒོ་ནས་རང་གི་འདོད་པ་སྨྲ་བ་ན།",
    "དོན་གཅིག་ཁོ་ན་དག་གི་ཤམསགསལ་བྱེད་དུ་ངོ་བོ་ཉིད་ཀྱིས་གྲུབ་པའི་ངེས་པ་ཡོད་པ་གང་ལས་ཡིན་ཏེ་མིན་པར་ཐལ།",
