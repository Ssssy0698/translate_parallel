    "གནས་བྱེད་རྟེན་གཞན་གྱིས་གནས་པར་མི་བྱ་མི་དགོས་པ་མ་ཡིན་པར་ཐལ།",
    "ལུས་ཀྱི་ཡོན་ཏན་སེར་པོ་སོགས་ཕུལ་དུ་བྱུང་བ་དང་འགྲིབ་པའི་རྗེས་སུ་འཕེལ་འགྲིབ་མེད་པར་བློ་ཡིད་ཤེས་ཀྱི་འདུ་བྱེད་པའི་ཁྱད་པར་ཐོས་བསམ་བསྒོམ་སོགས་འཕེལ་འགྲིབ་ཀྱི་རྗེས་སུ་ཁྱོད་ཕུལ་དུ་བྱུང་བ་དང་འགྲིབ་པ་དག་ཏུ་འགྱུར་བ་མཐོང་བ་ཡིན་པའི་ཕྱིར་རོ།",
    "རང་གི་ཉེ་ལེན་སྒྲོན་མེ་འཕེལ་འགྲིབ་ཀྱི་རྗེས་སུ་འགྲོ་བར་མཐོང་བའི་ཕྱིར་རོ།",
    "ཁམས་སྙོམས་པ་དང་ལ་སོགས་པས་མ་སྙོམས་པ་ལས་ནང་གི་དོན་རེག་བྱའི་ཁྱད་པར་དག་ནི་ཉེ་བ་ལས་དེའི་དམིགས་རྐྱེན་གྱི་སྒོ་ནས་ལུས་ཤེས་དང་མཚུངས་ལྡན་དུ་སྐྱེ་བའི་ཕྱིར་རོ།",
    "དྲུག་པ་ལ་གསུམ་གྱི་དང་པོ་རྫས་གཅིག་ན་ཧ་ཅང་ཐལ་བ་ནི།",
    "བདག་ལ་ཆགས་པ་དང་ལྡན་པས་བདེ་སྡུག་ཐོབ་དོར་འདོད་པ་རྟེན་དུ་སོང་སྟེ།",
    "ལུས་གཞན་ལ་སྒྲིབ་ཅིང་ཐོགས་པར་ཐལ།",
    "དེ་ལྟ་ནའང་ཡན་ལག་གཡོའི་ཡན་ལག་ཅན་མི་གཡོ་བས་ཐལ་རྟགས་མ་གྲུབ་ཅིང་རང་རྒྱུད་གྲུབ་པ་ལ་སྒྲུབས་པའོ་ཞེ་ན།",
    "ཆ་ཐམས་ཅད་ཚོན་གྱིས་ཁ་བསྒྱུར་བར་ཐལ།",
    "ཐལ་བ་གསུམ་པ་ནི།",
    "ཁྱོད་ཀྱི་འདོད་པས་མ་ངེས་ཏེ།",
    "ཚོགས་ཀྱང་གཟུགས་རྟོགས་པའི་མིག་ཤེས་དག་ནི་སྐྱེད་པ་ཇི་ལྟར་ཡིན་ཏེ་མིན་པར་ཐལ།",
    "གསུམ་པ་ཉེས་སྤོང་གི་ལན་དགག་པ་ལ་གཉིས་ཀྱི་དང་པོ་ལྡན་པ་ལས་སྣང་བ་དགག་པ་ནི།",
    "གསེར་དངུལ་གྱི་རྡུལ་ཕྲ་རབ་ཕྲད་པའི་ལྡན་པ་གང་ལས་རྟོགས་ཏེ་མི་རྟོགས་པར་ཐལ།",
    "སོགས་པས་དྲི་དང་རེག་བྱ་སོགས་གཟུང་ངོ།",
    "ཁྱོད་གྲངས་ཀྱི་མཚན་ཉིད་ཅན་གྱི་ཡོན་ཏན་ཡིན་པས་ཚད་ཀྱི་མིང་ཅན་རིང་པོ་མེད་ཅིང་།",
    "དེ་གང་ལ་འདུ་བའི་བྱ་རེ་རེ་བ་རྣམས་ལའང་རིང་པོ་འདུ་བ་མེད་པའི་ཕྱིར་རོ།",
    "དེ་དག་དང་ལྡན་པའི་རྫས་བུམ་སོགས་རང་གི་ངོ་བོ་དང་བརྗོད་པའི་སྒྲ་དག་ལས་རྫས་ཐ་དད་དུ་བློ་མ་འཁྲུལ་བ་མི་སྣང་བའི་ཕྱིར་རོ།",
    "གཉིས་པ་ཐ་དད་པའི་སྒྲུབ་བྱེད་དགག་པ་ལ་གཉིས་ཀྱི་དང་པོ་ཐལ་བ་དགོད་པ་ནི།",
    "པ་ཡིན་ཞེས་བྱ་བ་ཉིད་ཀྱང་འཐད་པ་གང་ལས་ཡིན་ཏེ་མིན་པར་ཐལ།",
    "འདོད་རྒྱལ་གྲགས་པས་བཀོད་པས་མིང་གི་ཡུལ་དེ་དངོས་དང་།",
    "དང་པོ་སྒྲ་རྣམ་གྲངས་པར་ཐལ་བ་སྤང་བ་ནི།",
    "རྣམ་གྲངས་པར་ཐལ།",
    "དོན་ཐ་དད་མེད་པ་སྟེ་དོན་གཅིག་གི་ཡུལ་ཅན་ཡིན་པའི་ཕྱིར་དང་།",
    "བརྗོད་བྱ་ཐ་དད་པའི་དོན་ཅན་དུ་མེད་པར་ཐལ།",
    "རྣམ་དབྱེ་ལ་སོགས་པ་གཅིག་ཅེས་གྲོངས་དང་ལ་སོགས་པས་དཀར་པོ་ཡང་དག་པར་ལྡན་པ་ཞེས་དང་བརྗོད་པའི་སྒྲ་ནི་རྣམ་གྲངས་པ་མིན་པར་ཁྱོད་རང་འདོད་པས་སོ།",
    "འདིས་ཐལ་བ་སྔ་མ་མ་གྲུབ་པ་དང་ཕྱི་མ་མ་ངེས་པ་བསྟན་ཏོ།",
    "ཁྱད་པར་གཞན་སྤོང་གི་སྒོ་ནས་སྟོན་པ་ལྟ་བུའོ།",
    "དཔེར་ན་སོར་མོ་ལྡན་གྱུར་ཞེས་པས་སོར་མོའི་ཁྱད་པར་མི་སྤོང་བ་ཅན་སྤོང་པ་བཞིན་ནོ།",
    "རང་གི་ཚོགས་པ་ཅན་བུམ་པའི་གཟུགས་ཀྱིས་གཟུགས་འཛིན་བསྐྱེད་པ་སོགས་ནུས་པའི་ཁྱད་པར་ནི་སྤོང་བའི་སྒོ་ནས་རྗོད་བྱེད་དུ་འཇུག་པར་འགྱུར་ཏེ།",
    "རང་གི་ཚོགས་པ་ཅན་བུམ་པའི་གཟུགས་དྲི་རོ་ཞེས་སོགས་བརྗོད་པའི་སྒྲ་དང་གཞི་གཅིག་པ་སྟེ་གཞི་མཐུན་པ་ཅན་གྱི་སྒྲ་མ་ཡིན་ཏེ།",
    "རང་གི་ཚོགས་པ་ཅན་གཟུགས་ལ་ལྟོས་ནས་ཚོགས་པ་བརྗོད་པར་བྱེད་པའི་སྒྲ་ཡིན་པའི་ཕྱིར།",
    "རིགས་དང་ཚོགས་པ་རྗོད་བྱེད་པའི།",
    "ཚོགས་སྒྲ་ལ་ཡང་ཚོགས་པ་དུ་མ་ལ་འཇུག་པ་བུམ་པ་དང་ཤིང་ཞེས་པ་ལྟ་བུ་དང་།",
    "བུམ་པའི་གཟུགས་དང་རོ་ཞེས་སོགས་ཚོགས་པ་ཅན་བརྗོད་པའི་སྒྲའི་བརྗོད་བྱ་བུམ་པའི་གཟུགས་སོགས་ཀྱིས་མིག་ཤེས་སོགས་བསྐྱེད་པའི་སོ་སོར་ངེས་པའི་ནུས་པའི་ཁྱད་པར་ཅན་ནས་རང་གི་ཚོགས་པ་ཅན་གཟུགས་སོགས་དེ་དག་གི་ཐུན་མོང་གི་ནུས་པའི་ཁྱད་པར་ཆུ་འཛིན་པའི་རང་བཞིན་ཅན་སྟོན་པར་བྱེད་པའི་ཕྱིར་རོ།",
    "བརྗོད་བྱ་ཙན་དན་དང་དེའི་དྲི་ཡན་ལག་ཅན་དང་ཡན་ལག་གི་རྫས་ཐ་དད་དུ་མེད་ཀྱང་དེ་ལྟར་བརྡ་བྱས་པ་དོན་མེད་མིན་ཏེ།",
    "ལུས་རྡུལ་དུ་མར་འགྱུར་ན་རྡུལ་དུ་མ་ཚོགས་པའམ་རེ་རེ་བློའི་རྒྱུ་ཡིན།",
    "གཉིས་པ་རེ་རེ་རྒྱུར་མི་འཐད་པ་ལ་གཉིས་ཀྱི་དང་པོ་ལ།",
    "ཐལ་བ་དགོད་པ་ནི།",
    "དབུགས་གཅིག་གིས་སེམས་གཅིག་གསལ་བར་བྱེད་པས་ཅིག་ཅར་མང་པོ་མི་འབྱུང་ཞེ་ན།",
    "གཅིག་ཏུ་ངེས་པས་ཡིད་བློ་རེ་རེ་སྐྱེ་བར་ངེས་བྱེད་མིན་པར་ཐལ།",
    "ཡིད་བློ་མང་པོ་རིམ་གྱིས་ཀྱང་སྐྱེད་པར་མིན་པར་ཅིག་ཅར་སྐྱེད་པར་ཐལ།",
    "དེ་གཅིག་ཏུ་ངེས་པ་ལས་བློ་རེ་རེ་སྐྱེ་བར་ངེས་པ་མ་ཡིན་པར་ཐལ།",
    "གལ་ཏེ་དེའི་ཚེ་བློ་རིམ་ལྡན་མང་པོ་མེད་ཀྱི་གཅིག་ཡིན་ལ་དེ་དག་གིས་དོན་དུ་མ་རིམ་ཅན་དུ་ཤེས་སོ་ཞེ་ན།",
    "རྒྱུ་གཅིག་ལ་རག་ལུས་པའི་དབུགས་རང་གི་རིགས་མིན་པའི་དུས་ཅན་ཏེ་རང་རིགས་ལས་དུས་གཞན་པའི་ཟ་དབུགས་སྔ་མ་མེད་པའི་ཕྱིར་ཏེ།",
    "སྐད་ཅིག་སྔ་ཕྱི་རེ་རེ་བར་སཨིནྟཾཔ་སྐྱེ་བ་དེ་འདྲའི་སེམས་དུ་མ་ཉིད་ཀྱི་རྒྱུ་ཡིན་པར་ནི་རྟོག་པར་བྱེད་ན།",
    "དབུགས་དེའི་རྒྱུ་རིགས་འདྲ་སྔ་ཀགི་ཀོད་ཚམ་དེ་འདྲ་ཡོད་པ་མ་ཡིན་པའི་ཕྱིར་ཏེ།",
    "སྐད་ཅིག་༩ གཅིག་ལ་ཆ་དུ་མ་ཡོད་པ་ཉིད་དུ་ངེས་པར་ཐལ།",
    "ཡིད་བློ་དུ་མ་ནི་༩༩དུས་ཅིག་ཅར་དུ་སྐྱེ་བ་ཡོད་པར་ཐལ།",
    "གལ་ཏེ་དབུགས་འབྱུང་དེའི་ཆ་དུ་མའང་གཅིག་གི་དུས་སུ་ཡོད་པ་ཅན་ཐམས་ཅད་སེམས་གཅིག་གི་ནི་རྒྱུ་ཡིན་པས་གཅིག་ཅར་མང་པོ་མི་འབྱུང་ཞེ་ན།",
    "གང་ཞིག་དབུགས་གསལ་མི་གསལ་གང་གི་ཁྱད་པར་ཐ་དད་པ་ལས་གསལ་མི་གསལ་གྱི་ཁྱད་པར་ཐ་དད་དུ་འགྱུར་བ་མིན་པའི་ཕྱིར་རོ།",
    "ཁྱེད་ཅག་གི་ཡང་ཅིའི་ཕྱིར་ཅིག་ཅར་ཤེས་པ་མང་པོ་མི་འབྱུང་ཞེ་ན།",
    "རིགས་འདྲ་ཕྱི་མ་གཅིག་གི་རྒྱུ་ཡིན་གྱི་རིགས་འདྲ་དུ་མ་ཅིག་ཅར་སྐྱེད་པ་མིན་ཏེ།",
    "སྔོན་པོ་ལས་དོན་གཞན་སེར་པོ་ལ་ཆགས་པ་ཡིས་ཁྱོད་ཀྱིས་སྔོན་པོ་འཛིན་པའི་དེ་མ་ཐག་རྐྱེན་བྱེད་པའི་ནུས་པ་མེད་པར་བྱས་པས།",
    "སེར་པོ་ལས་དོན་གཞན་སྔོན་པོ་མ་འཛིན་པ་སྟེ་འཛིན་པའི་ཤེས་པར་ཁྱོད་མི་སྐྱེ་ལ་ཡིད་སྔ་མ་ནུས་པ་ཅན་གྱི་རྗེས་སུ་བྱེད་པའི་ཕྱིར་རོ།",
    "བཞི་པ་རེ་རེ་སྐྱེ་བར་འདོད་པ་དགག་པ་ནི།",
    "དེ་ལས་ཕྱིས་ནི་རང་རིགས་བློ་སྔ་མ་རེ་རེ་ལས་ཕྱི་མ་རེ་རེ་སྐྱེ་བར་ངེས་པས་ལུས་ལས་ཅིག་ཅར་སེམས་མང་པོ་མི་སྐྱེ་ཞེ་ན།",
    "ཕྱིས་ཀྱང་བློ་སྐྱེད་པར་བྱེད་པར་ཐལ།",
    "མ་གྲུབ་ན་སྔར་ཡང་མི་བསྐྱེད་པར་ཐལ་ཏེ།",
    "གལ་ཏེ་ལུས་ཕྱི་མ་དེའི་ཉེར་ལེན་གྱི་རྒྱུ་རང་དང་ཚོགས་པ་གཅིག་པའི་ལུས་ཐ་མ་དེ་ལུས་ཕྱི་མ་བསྐྱེད་པ་ལ་འཇུག་པ་སྟེ་མཚམས་སྦྱོར་བ་ཐོབ་པའི་ཕྱིར་དུ་ཁྱོད་ཀྱི་སེམས་རྒྱུན་ཕྱི་མ་གནས་པའི་རྒྱུ་སེམས་ཕྱི་མ་ལ་ཉིང་མཚམས་སྦྱོར་ནུས་ཀྱི།",
    "གཅིག་ཉིད་ན་ཡང་མང་གསལ་འགྱུར་ཞེས་པའི་སྐྱོན་སྔ་མ་ལུས་ལས་སེམས་སྐྱེ་བར་འདོད་པ་ལ་བཀོད་པ་བཞིན་དུ་འདིར་ཡང་ཐལ་བར་འགྱུར་བ་ཡིན་ནོ།",
    "གོམས་པ་རང་གི་ངང་གིས་ཁྱད་པར་དུ་འགྱུར་བའི་ཡིད་ཀྱི་ཡོན་ཏན་ཡིན་པའི་ཕྱིར་རོ།",
    "གཞོན་ནུ་མ་ལེན་ན་རེ།",
    "གོམས་པ་འབའ་ཞིག་གིས་གོམས་བྱ་ལ་ཁྱད་པར་སྔར་ལས་ལྷག་པོ་བྱས་པ་དེ་གལ་ཏེ་རང་གིས་ངང་གིས་མི་འགྱུར་བར་སླར་ཡང་ནི་ཁྱད་པར་དུ་བྱ་བའི་ཕྱིར།"
  ]
}