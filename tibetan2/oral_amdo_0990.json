    "རྫས་དྲིཞིམ་པོ་དག་གིས་རང་གི་ལུས་སྐུད་པ་ལའོ།",
    "དགེ་སྦྱོང་གི་གོས་ཁྱིམ་པ་ལ་བགོ་བའི་ཕྱིར་སྦྱིན་བ་ལའོ།",
    "ལྷའི་གནས་ལ་སོགས་པ་དང་མུ་སྟེགས་ཅན་གྱི་གནས་སུ་སོང་སྟེ་རྩོད་པར་བྱེད་པ་ལའོ།",
    "གཞན་གྱི་ཁྱིམ་ནས་བདག་གི་དོན་དུའོམ་བ་སླཏཱཏེ་མཁྲུངས་པ་ལའོ།",
    "དེ་ལ་རེ་ཞིག་མིཚངས་པར་སྤྱོད་པའི་གང་ཞེན།",
    "བཙེམ་ལྡན་འདས་ཀྱིས་དགེ་སློང་གིས་མ་ཤ་ཀ་ལྔ་བརྐུས་༣ མཐར་གྱུར་རོ།",
    "བསྟེན་བར་བྱ་བའི་ལུས་རེག་པར་བྱ་བ་ཉིད་ནི་མཉམས་པའོ།",
    "མཚན་དང་ལྕབ་ཉེལ་པ་ཁས་བླངས་པ་དག་གིས་ནི་རང་གི་ཕྱོགས་ཉིད་ཀྱི་ཁེངས་སུ་གཏོགས་སོ།",
    "ལས་བྱ་བའི་དོན་དུ་ནརྒྱུད་གཅིག་དང་ཏོག་གསུམམོ།",
    "གསོ་སྦྱོང་གི་གནསལ་བློ་མཐུན་པར་བྱའོ།",
    "ཚིག་གཅིག་གིས་མཚམས་གཉིས་བཅད་པ་དང་དགྲོལ་དུསུང་ངོ།",
    "དེལ་དགེ་སློང་གི་འདུ་ཤེས་ཉེ་བར་བཞག་པ་ལའོ།",
    "ོ་ས་ོལ་པ་དགེ་སློངམཆས་སྟེང་དར་པང་ན་། ལ་དགེ་སློང་འདི་བདག་ཅག་གི་ཚངས་པ་མཚུངས་པར་སྤྱོདཔ་ཡིན་གྱིས་ཐོངས་ཤིགཅེས་བརྗོད་པར་བྱའོའདུལ།",
    "མོ་ལ་གླགས་ལྟ་གི་གེགས་གྱིས་བརླབ་པར་བྱའོ།",
    "མལ་ཆ་དང་སྟན་དངབདོ་བ་ལ་སོགས་པ་དང་ལས་ལ་མི་བསྐོ་བ་ཡིད་དལ་དུ་གཞུག་བ་དང་རྙེདཔ་ཚོས་རེས་ལ་སོགས་པ་དང་།",
    "མི་ཕལ་མོ་ཆེའཁོདཔ་ལ་རྦདྨ།",
    "གཙུག་ལག་ཁང་གི་བདག་པོསདཧཱུྃབ་ཀུན་འདྲེན་པཚིག་ཀྱང་བརྗོད་པར་བྱའོ།",
    "གཙོད་ཁང་བྱུར་བུ་དང་འཁོར་ས་དང་། གསོ་སྦྱོང་གི་གནས་དག་ཏུ་ཕྱག་དར་བྱ་བ་ཉིད་དོ།",
    "དགེསྐོས་ཀྱིས་གསོ་སྦྱོངགི་ཚེ་ཚུལ་ཤད་བྲིམ་པས་དགེ་སློང་རྣམས་བགྲང་བར་བྱའོ།",
    "དེས་ཀྱང་མི་ནུསན་རེས་ཀྱིས་སོ།",
    "རེག་བབ་པའི་ཚོ་འདོནམི་ནུས་ན་གཞན་ལ་བཅོལ་བར་བྱའོ།",
    "དུམ་བུ་འཛིན་པ་ཉིད་ཡིན་ན་ཇི་སྙེད་ཀྱིས་འདོན་འགྲུབ་པ་དེ་དག་གིས་བསྒྲུབས་པས་སོ།",
    "གསོ་སྦྱོང་གི་གཞི་དང་འབྲེལཱ་པ་རྣམ་པར་འབྱེད་པ་ལ་སོགས་པའི་སྐབས་སོ།",
    "གསོ་སྦྱོང་གི་ག་རྫོགས་སོ།",
    "ཟླ་བ་དང་གི་ཞེན་དབྱར་ཟླ་འབྲིང་པོའིཉའི་ཕྱི་དེ་ཉིན་པད་ཉིའོ།",
    "ཚུལ་ཤིང་བྲིམམོ།",
    "སྒོ་ཁང་ལ་སོགས་པ་རེལ་གྱིས་བསྐོར་བར་བྱའོ།",
    "དེ་ཉིད་བསྟན་པའི་ཕྱིར་འདི་ལ་སེ་གོག་ལག་ཁང་དང་ཁང་ཁྱིམ་དག་གི་ཉེ་འཁོར་ཡང་ངོ།",
    "མཆོད་རྟེན་སོགས་ལ་ཁྱོནྣཾ་དད་ངན་དད་གུར་གུམ་གྱི་བྱུག་པ་དག་གིས་སྐུད་པ་དང་།",
    "ཁྱིམ་པ་དང་ཁྱིམ་པ་མོ་བཟོད་པ་གསོལ་བའི་ལྷུང་བཟེད་ཁ་སྒྲུབ་བདག་ཁབསྲད་བའོ།",
    "གལ་ཏེ་དེར་སོང་ནས་ཞག་བདུན་ལས་འདས་སུ་ཟིན་ཀྱང་བྱ་བ་དེ་ཉིད་ཀྱིས་དགེ་སློང་དབྱལ་བའིཁྱུང་བ་ཡི་༢་བྱུང་རོ་ཞེས་པ་རུས་པས་སོ།",
    "དགེ་སློང་མེད་པར་དགེ་ཚུལ་དག་འཊའ་ཞིག་གིས་གནས་པ་མ་ཡིན་ནོ།",
    "དེ་དག་གིས་ཀྱང་གནས་མལ་མི་མནོད་པར་བྱ་བ་ཉིད་མ་ཡིན་ནོ།",
    "དགེ་སློང་གི་མདུན་དུ་བྱིན་གྱིས་བརླབས་ན་འཆག་པའོ།",
    "བཅོམོ་ལྡན་འདས་ཀྱིས་དམ་བཅས་པ་བསྒྲུབ་པར་མི་བགྱིད་པ་ལས་ཉེས་བྱས་སུ་གསུསན་བཉྩི་པ་དམ་བཅང་བ་དུ་མཆིས།",
    "དུས་གང་གི་ཚེ་ཡིན།",
    "དགག་དབྱེའི་ལས་སྐྱ་རེངས་འཆར་པའི་མདུན་དུ་སྟེ་སྦྱངས་དད་པོ་མ་ཤར་ཤར་ལས་ཐམས་ཅད་ཟིན་པ་དེ་ལྟར་དགག་དབྱེའི་ལས་བྱའོ།",
    "ཕུལ་བུད་མེད་དེ་དགེ་སློང་མ་ལ་ནི་གཞན་གྱིས་དགགདབྱེ་བྱེདཔ་མ་ཡིན་ནོ།",
    "དགེ་སློང་བུད་མེད་དུ་གྱུར་བ་ལ་ཡང་དེ།",
    "ཀྲོལ་བྱེད་པ་དག་འོང་བར་ཐོས་པར་གྱུར་ན་གལ་ཏེ་གསོ་སྦྱོང་གཉིས་སམ་གསུམ་ཐལ་བར་གྱུར་ཏེ་དགག་དབྱེ་བྱའོ་༧།",
    "དོན་འདི་གཉུག་མར་གནས་དགག་དབྱེའི་གཞི་ལྡན་དག་སྡོདཅིགཔ་དག་གིས་ཤེས་པ་ཡིན་ནོ་ཞེས་ལན་གདབ་པ་རབྱའོ།",
    "ཟིན་པ་ཞིག་གྲུབ་ནས་བརྐྱངང་དིང་བ་བོརང་གིས་ཁང་སྤུབས་གཉིས་སམ་གསུམ་དྲུབ་པར་བྱའོ།",
    "དུས་གང་གི་ཡིན་ཚེས་བཅུ་དྲུག་ལའོ།",
    "འདི་པ་རྙེད་པ་དང་ཕན་ཡོན་གང་ཡོད་པ་དེ་བདག་གིའང་ཡིན་ནོ་ཞེས་སོ།",
    "གང་གིས་དེའི་ཙྪེས་སུ་ཡི་རང་བར་བྱ་ཞེ་ན།",
    "གསོ་སྦྱོང་གི་མཐའ་མ་ཡིན་པ་ལ་གདེང་བར་མི་བྱའོ།",
    "སྔར་རང་གིས་མི་བཏིང་བ་ཉིད་ཀྱིས་བྱུང་བར་མི་རུང་བ་ཉིད་ཡིན་ནོ།",
    "ད་པར་འགྱུར་གྱིས་དེར་ཁྱེད་ཅག་གིས་ཚོགས་པར་བྱའོ་",
    "སྤང་བ་དེའི་ཤི་བའི་ཕྱད་དེ་མ་སྤང་བ་དག་གིས་མནོད་པར་བྱ་བ་ཉིད་ལ་ཤི་བའི་ཡོ་བྱད་ཀྱི་བདག་པོ་སྤངབདེ་ནི་མུ་སྤུདསུཔ་དང་ཐ་དད་པ་བདུལ་ཉིང་མམནན།",
    "བསིལ་ཡབ་མཁན་གྱི་ལག་ཆ་དང་བྲན་དང་བྲན་མོ་དང་ས་སྤྱོད་པ་དང་ཞོ་ཤས་འཚོ་བ་དང་།"
  ]
