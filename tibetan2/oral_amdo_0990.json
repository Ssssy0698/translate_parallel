    "དེ་དག་བྱིས་པའི་གནས་སྐབས་ན་བདག་གིར་བྱས་པའམ།",
    "ཉེ་དུས་ཡིན་ལྷུང་བཟེད་ཡོད་བཞིན་དུ་རང་གི་ཡོ་བྱད་དག་གིས་ལྷུང་བཟེད་ལྷག་པ་ཞིག་ཉོས་པས་སོམཆག་སྟེ་མེད་པ་ཉིད་ལ་དང་པོ་ཡོད་པའི་བློས་སློང་བ་༦ནལ་ནི་ན་སྨད་དོ།",
    "དབྲོག་པར་བྱ་བ་དེ་རང་ང་མ་གཞན་གྱིས་ས་མེད་དོ་ན་གསུམ་དུ་ཕྱིན་པས་རང་གི་ཉིད་མ་ཡིན་ནའོ།",
    "ས་ངག་ཐ་དད་པ་དག་གིས་དཔོག་པའི་དོན་དུ་ཞུགས་པ་ལྟ་བུའི་བྱེད་པ་པོ་དག་ཡིན་ནོ།",
    "ཚགེ་མོ་ཞིག་ལ་ཉེས་བསྐྱེས་པ་མི་སྦྱིན་ན་ཉེས་བྱས་སོ།",
    "གང་གི་ཕྱིར་འདིར་དེ་ལྟར་ལོངས་སྤྱད་བར་བྱ་བས་ལེན་པ་རྣམས་ལ་ལོངས་སྤྱོད་པའི་དོན་དུ་འཆང་བས་ཉེས་པ་འདི་མེད་པར་འགྱུར་བའམན་སྨང་པར་འགྱུར་བ་མེད་པ་ཉིད་དོ།",
    "དེའི་ཕྱིར་བཟའ་བར་ཀྱཱ་བ་ནང་དུ་ཞག་ལོན་པ་དང་ནང་དུ་བཙོས་པ་སོགས་རུང་བ་མ་ཡིན་པ་ཉིན་མཚན་འདས་པ་ནི་འདི་ཙཕྲོས་པ་དང་དྲུ་བཅུ་རྣམ་པར་གཞག་གི།",
    "སོག་འཇོག་གི་སྤུང་པའོ།",
    "བུད་མེད་མཁས་པས་གོང་ནས་ཡོད་དུདྲིས་པ་གཏན་ལ་དབབ་པར་བྱས་པ་དང་།",
    "གཙུག་ལག་ཁང་གི་གཞས་རྣམས་སུ་གནག་སུན་པར་བྱེད་པ་འདི་ལྟ་སྟེ།",
    "རྒྱ་ཤུག་གི་ཚིག་གུ་ལ་བུ་མ་བཅོས་པར་རིལམིད་བྱེད་པ་ནི་ཕྱེད་དེ་ཉེས་བྱས་ཉིད་དོ།",
    "བ་ཞུསཡི་དགེ་སློང་དག་ས་བོན་གྱི་རིགས་མཚོས་པ་ཞེས་བྱ་བ་ཡོད་པས་དེའི་ཕྱིར་བླངས་པས་བརླན་པ་དེ་བཟའ་བད་རྗེས་བུ་བན་གིས་འདི་ལ་འགྱོད་པར་མི་བྱའོ་ཞེས་གསུངས་སོ་ས་ལ།",
    "དགེ་སློང་གི།",
    "ང་བ་གླེང་བར་གཏོགས་པའི་བསྒོ་བ་ཚིག་གིས་རྣལ་གཟེན་པ་སྟེ་ལནལོག་པར་འདེབས་པ་དང་།",
    "གང་དུ་བདག་གིས་ཆེ་གཞི་ཉིད་བྱ་དགས་པའི་གནས་དེར་བརྟེན་པར་མི་བྱའོ།",
    "ཁྱོལ་ཡད་མ་ཐུག་ན་གཞན་ལ་བསད་པ་དང་བཅིང་བ་ལ་སོགས་པ་གནོད།",
    "གཙུག་ལག་ཁང་འདི་རེཞོའམ་ལྟོསཤིག་ཙེའམ།",
    "དུང་ངམ་ཤིང་ལྗོན་པའི་དྲུང་དུ་རང་གི་སྟན་བཞག་སྟེ་དེ་དག་གང་དུ་གནས་པའི་ཁྱིམ་དེར་འཇུག་པར་བྱའོ།",
    "དེ་སླར་དགེ་སློང་རང་གིས་བསྐུ་རྣལ་བ་ཡི་བྱའོ།",
    "དེ་ནི་ཁྱིམ་པ་དང་དགེ་ཚུལ་དག་གིས་སོ།",
    "དེ་དག་གིས་མ་བསྐྱལ་ན་གནས་པར་བྱེད་པ་དང་ཉེར་གནས་དག་གིས་བླང་བར་བྱ།",
    "གནས་པར་བྱེད་པ་དག་མེད་ན་རང་གིས་སོ།",
    "སྲུང་མ་བཞག་པ་དེས་ཁྱིམ་པ་གཏམ་བྱེད་པའི་ནང་དུ་འདུས་པར་ཁྱོགསབ་ཅིག་ཏུ་བསྡད་པར་བྱའོ།",
    "རང་གིས་ཀློག་སྤོངསམི་ཉམས་པར་བྱའོ།",
    "ཁྱིམ་པ་འདུག་འདུག་པའི་སྟན་མ་བསྡུས་པ་དགེ་སློང་དག་ཞིག་གིསམཐོང་ན་བསྡུ་བར་བྱའོ།",
    "རྫས་ངན་པ་གཅིག་གིས་སྟེང་ནས་གཡོགས་པར་བྱའོ།",
    "འདིར་གཞུངུན་བཙུན་པ་གལ་ཏེ་དགེ་སློང་དག་གིས།",
    "ཡོན་བདག་གིས་བྱས་སམཟིནནས་བལྟའོ་ཞེསམ་སྨྲས་པ་ལའོ།",
    "བརྐོས་ཏེ་གླིང་གི་རྩ་བ་མ་བཙུགས་བཉིད་ཀྱང་རིམ་པ་གསུམ་ལས་ལྷག་པ་ཡང་ངོ།",
    "ཁྱེད་ཅག་ལ་དགེ་སློང་འགའ་ཡངམོས་སྟོན་པར་མི་སྤྲོ།",
    "སྲིང་ཡོདོག་གིས་བག་ཡོད་པར་སྒྲུབས་ཤིག་ཅེས་བྱ་བ་དེ་སྟོན་ནུས་པའོ།",
    "དགེ་སློང་གིས་དགེ་སློང་མས་དེ་དག་འདུལ་ན་བླང་བར་བྱའོ།",
    "དགེ་སློང་དང་དགེ་སློང་མ་རྣམས་ག་ཅི་གི་ལམ་རྒྱགས་གཅིག་གིས་བསྐུར་དུ་རུང་ངོ་གཅིག་གིས།",
    "གཅིག་གི་བྱིན་ལེན་ཡང་ངོ།",
    "གྲོད་དུ་ཕྱིན་པ་ཉིད་ན་ཡོགས་སུ་སོང་ཡང་ཉེས་པ་མེད་དོ།",
    "དེའི་བྱེད་རེ་རེ་ནི་ཉེས་བྱས་སོ།",
    "ཇི་ལྟར་སྦྱོར་དུ་བཅུག་པ་ཡིནཞེན་ཡང་དག་པ་མ་ཡིན་པའི་ཡོན་ཏན་དག་གིས་བསྔག་པས་སོ།",
    "མགྲོན་དུ་འོས་པ་དེའིཕྱིན་ག་ཎྜི་བརྡུངས་ཏེ་རང་གི་འཁོར་ལ་བལྟ་བར་བྱའོ།",
    "ཡོན་བདག་གཉིས་ཤིག་གིས་ཆོད་སྐལ་སོ་སོད་ལྷན་ཅིག་ཏུ་སྤྱན་དྲངས་ན་བཏི་ཀ་ལ་འོང་ངོ་ཞེས་ཁས་བླངས་ན་ཉེས་བྱས་ཉིན་གཅིག་ལ་ཕྱིད་སྤྱན་དྲངས་པ་ལས་གཉིས་ཀ་ལ་ཁས་བླངས་ན་འང་ཉེས་བྱས།",
    "སྤྱན་འདྲེན་པ་དེ་གཉི་ཀ་ན་རེ།",
    "འདིར་གོས་ཀྱི་མཐར་གྱུར་པའི་ཁྲུ་གང་གི་ཁྱོནནེ།",
    "ཐངགི་ལམ་འདིར་རམ་གྲུར་འགྲོ་བ་ལ་ཡང་ངོ།",
    "མུ་གེ་བྱུང་ན་མགྲོན་དུ་བོས་པ་ཇི་སྙེད་བྱུང་བ་དག་བདག་གིར་བྱའོ།",
    "དེ་གསུམ་ལ་རེ་ཞིག་ཅེས་བྱ་བའི་སྒྲེ་པར་སྦྱར་ནནི་སྤང་བ་མ་ཡིན་ནོ།",
    "ལྷག་པོར་བྱེད་པའི་དགེ་སློང་གིས་ཁྱོད་ཀྱིར་གྱུར་གྱིས་བཞུད་ཅིག་སྐྱེས་བྱ་བའི་ཚིག་གིས་སོ།",
    "ཟས་ཀྱི་བྱ་བ་བཏར་བས་རང་གིས་བཟའ་བར་མི་བྱའོ།",
    "དགེ་སློང་པ་ཅིག་གིས་ལྷག་པོར་བྱས་པ་དེ་གཞན་ཀུན་གྱིས་ཀྱང་བཟའ་བར་བྱའོ།",
    "དེར་འོང་བར་བྱ་བ་ཉིད་དུ་གནས་པ་མཚམས་ཀྱི་ནང་ན་འཁོད་བ་དག་གིས་ང་བ་ཉིད་མ་དྲིས་པར་བྲ་ལྷ་ཐམས་ཅད་ལ་འདའ་བའི་བྱེད་དེ་ཉེས་བྱས་ད་དོ།",
    "གསོག་འཇོག་གི་ངོ་བོ་བསྟན་པའི་ཕྱིར་སྔ་དྲོ་བའི་ཟས་བྱིན་ལེན་བྱས་བ་ཕྱི་དྲོ་བའི་བྲས་སུ་དང་།",
    "དགེ་སློང་གིས་བཅོས་པ་ཡང་ངོ།",
    "འདིར་རྗེན་པ་བཅོས་པ་གང་ཡིན་པ་ནི་དགེ་སློང་གིས་བཅོས་པ་དེའོ།",
    "སྟེང་གི་ཡང་ཐོག་ཁ་ཁྱེར་གཞན་ཡང་འོག་ཁང་དེ་ཉིད་ཡིནནོ།",
    "ལྷུང་བཟེད་འབགས་པ་ེད་པར་བྱས་ལ་རེག་པ་ལ་ཡང་ངོ།",
    "བསྲེགས་པས་ཀྱང་མ་མེད་པ་ཁྱོད་དུ་འགྱུར་རོ།",
