    "གཞན་མ་ཤེས་རྒྱུད་རྭ་ཅོ་ལྟར་གྱོང་བའི་སྟོན་མཁན་སྨྲ་བའི་སེང་གེ་ལྟ་བུར་གྱུར་ཀྱང་དགོས་ཚོགས་ཆེར་མི་འདུག་དགོང་ས་ཏེ།",
    "ཨའཇིག་རྟེན་ཕྱོགས་ལ་ཡང་རང་ཕྱོགས་དང་གཞན་ཕྱོགས་ཀྱི་མངོན་ཞེན་དམ་པོ་མེད་པར་ཆེ་བ་གྲྭ་ས་ནས་ཆུང་བ་རི་ཁྲོད་ཀྱི་བར་ཐམས་ཅད་ལ་ཆགས་སྡང་གང་ཆུང་སམ།",
    "རྣམ་དཔྱོད་ཅན་གཞན་གྱིས་ལོ་ཟླའི་བར་དུ་བྱེད་དགོས་ཀྱི་བྱ་བ་མང་པོ་ཞིག་དུས་སྐད་ཅིག་མ་དེ་ག་རང་ལ་གྲུབ་འགྲོ་བའི་མཛད་པ་ངོ་མཚར་ཅན་ནས་ཕལ་དང་ཕལ་གྱི་བློ་ཡུལ་དུ་ཤོང་བར་དཀའ་བ་ཞིག་ཡོད་པར་སྣང་ཞིང་།",
    "འུ་ཅག་བ་ཚོའི་གྲགས་པ་མཁས་གྲུབ་ཀྱིས་ལྷ་རམས་པ་ཐོན་འདུག་པས་གོས་ཁ་བཟང་བ་ཞིག་རྒྱོབ་ཅེས་གསོལ་ཇའི་ཐོག།",
    "དེ་བས་ཁེ་ཆེ་ལ་ཉེན་ཆུང་བའི་རི་ཁྲོད་ཞིག་རང་ལ་ཕྱིན་པ་ལེགས་ཚོད་འདུག་རུང་།",
    "་དམ་ནསཞན་པའི་རིགས་ལ་ནི་ཐུབ་ཆེན་གདན་སའི་གནས་ཚུལ་གྱིས་ཀྱང་དཔེར་མི་སསན་ལམ་ཕོད་པ་དེ་བཞིན་ལགས་ན་ཁྱེད་རྣམས་ཀྱིས་ཤ་ཚ་ཡིན་བརྩིས་ཀྱིས་སྣ་ཚོགས་༣གསུངས་པ་ནི་མངོན་ཤེས་མེད་པས་ལན་པར་འདུག།",
    "དང་སྡིག་ཚབས་ཆུང་བར་འདུག།",
    "དེ་མ་ཐག་ཐམས་ཅད་དེབ་ལངས་ཀྱི་༧སྐྱབས་མགོན་ཆེན་པོར་ཁ་བཏགས་འབུལ་བརྩིས་འདུག་པར་རྗེ་ཉིད་ཀྱི་ཐུགས་དགོངས་ལ།",
    "ངེད་གཙོ་བོ་ཡིན་པས་ཁ་བཏགས་སྔོན་ལ་འབུལ་དགོས་དགོངས་ཏེ་ཐམས་ཅད་ཀྱི་སྔོན་ལ་ཕེབས་ནས་ཁ་བཏགས་ལེགས་པ་ཞིག་འབུལ་བརྩིས་མཛད་པའི་མུར་མནལ་ལས་སད་པ་དང་སེ་ར་ཕུར་མཇལ་གྱི་ཕུར་པ་རྩེ་ལ་ཕེབས་རན་པའི་ས་ན་ས་དུང་རྒྱ་གླིང་གཏོང་བའི་སྐབས་སུ་འདུག་པར་ཐུགས་བརྟག་དང་མནལ་ལམ་༦ བ་མཐུན་པར་བྱུང་བས་ད་ཆ་འོས་ཐོ་རང་བབ་འཇོག་པ་ལས་འོས་མི་འདུག་ཅིང་།",
    "དགུ་ཐམ་པ་འདུག་ཅེས་ཕར་གཡུག་ཚུལ་གཡུག་བྱེད་པ་ཞིག་བྱུང་འདུག་པའང་གནས་སྐབས་སུ་ཁམས་ཚན་དགུའི་འོས་མཐོ་འགྲིལ་འདུག་པ་དེ་དང་།",
    "དེ་ལ་བརྟེན་ནས་བློ་ཆུང་རྣམས་ཤིན་ཏུ་འཚེར་ཏེ་ཕ་ཡུལ་དུ་འགྲོ་བའི་འཕེན་པ་དང་པོ་འདི་ནས་འ་གཏོང་བ་ཞིག་འདུག་པར་ཐུགས་བསྐྱེད་བཟང་པོས་ཀུན་ནས་བསླངས་ཏེ།",
    "དེའི་རྐྱེན་གྱིས་གསོལ་དཔོན་རཔ་པ་༡དང་ཁང་གཉེར་སོགས་ཡང་ཡང་བརྗེ་དགོས་བྱུང་འདུག་པ་ནི་ཁོ་པ་རྣམས་གང་འདོད་དུ་མ་བཏང་བ་བག་ཡོད་ཀྱི་རྭ་བར་བཅུག་པ་ན།",
    "འདི་རིགས་འཇིག་རྟེན་པའི་ཁ་ཙམ་ལ་ཆ་འཇོག་བྱེད་༣༣་རྒྱུ་གང་ཡང་མི་འདུག།",
    "ད་ཆ་ལོ་གཅིག་གཉིས་ཙམ་ལ་ཚབ་ཁྱད་བྱེད་རྒྱུ་ནི་མི་འདུག།",
    "རྒྱུན་པར་མི་སུ་ཡང་ཕྱིན་མི་ཆོག་པའི་སྦུགས་མ་དེར་བཞུགས་འདུག་པར་གང་ཅིའི་གནས་ཚུལ་ཞིབ་ལྷོང་ཞུས་པར་བཀའ་ལས།",
    "ཁྱེད་རང་ལ་ད་ལྟ་༨༦ན་བླ་དཔོན།",
    "དེས་ན་རབ་ལོ་ལྔ་དེ་མིན་ལོ་གསུམ་རང་བྱས་ན་བསམ་པ་འདུག།",
    "དེ་མིན་ཁོ་རང་རྣམས་མ་༧སྐྱབས་མགོན་རྒྱལ་བ་མཆོད་ཡོན་གྱི་གཟིམས་ཆུང་འགག་ཏུ་ཕྱིན་ཏེ་ཕྱག་དང་བཅས་ཏེ་ཞུས་ཆོག་པ་མཁྱེན་མཁྱེན།",
    "ད་ལྟ་ཁྱེད་རང་རྣམས་ནས་གང་གསུངས་པ་ལྟར་ཞུས་ཆོག་པ་ཡོད་དམ་༨༩ བ་ཞེས་རྡོ་ཁ་བཀག་པར་ཐམས་ཅད་ཀྱིས་ཡང་བསྐྱར་ཕྱག་དང་བཅས་ཏེ།",
    "དེ་༥ ཆས་གས་ས་མིན་ཁོ་རང་རྣམས་གཟིམས་ཆུང་འགག་ཏུ་ཕྱིན་ཆོག་པ་དགོས་ཞེས་གསུངས་པར།",
    "ཞེས་གསུངས་པ་ལྟར་རྩིས་སྤྲོད་རན་སྐབས་བསྐྱར་དུ་སྐམ་སྒྲིག་སོགས་དགོས་པ་ཞིག་མིན་འདུག་རུང་།",
    "མི་ཡོང་བ་རྣམས་སྡོད་རོགས་མི་བྱེད་པ་ཞིག་འདུག་ཅེས་བཀའ་ཕེབས་འདུག་ཅིང་།",
    "ས་དེར་བརྟེན་ཤག་རྣམས་ཀྱང་ཕལ་ཆེ་བ་འགྱེལ་ཞིག་དང་གཅོང་ཟོམས་ཆེ་བར་སྔ་འཕྲོས་བཞུགས་ཡུལ་གཟིམས་ཤག་བབ་མཚུངས་ཞིག་གསར་རྒྱག་མི་མཛད་ཁ་མེད་ལ་དེ་བར་སེ་ར་གཞུང་པ་ཁམས་ཚན་གྱི་གཟིམས་ཤག་ཏུ་བཞུགས་འཇགས་ཐོག་ལོ་དེ་ཁའི་ནང་རང་ལ་ཆུ་བཟང་དུ་གཟིམས་ཤག་གསར་རྒྱག་མཛད་ཅིང་།",
    "ངའི་སྐྱེས་རབས་ཀྱི་བྲིས་ཐང་འདི་རྣམས་ལེགས་རབ་བྱུང་འདུག།",
    "ཏཏིགྲགས་པ་མཁས་གྲུབ་དེ་ངེད་ནས་རྨི་ལམ་གྱི་རོལ་པ་སོགས་གང་ནས་བསམ་བློ་བཏང་རུང་ཚུལ་པ་ཁྲིད་དཔོན་དགའ་བདེ་དཔལ་བ་རང་ཨེ་ཡིན་བསམ་པ་འདུག་ཅེས་ཡང་ཡང་དངོས་སུ་བཀའ་སྩལ་པ་ཐོས་པ་སོགས་བདག་ཉིད་འ་ཆེན་པོ་དུ་མ་དང་།",
    "དེ་ཉིན་གསོལ་ཆས་སོགས་ཀྱང་དུས་རྒྱུན་ལྟར་བཞེས་ཚུལ་སོགས་མཛད་འདུག་ཀྱང་།",
    "༤ ནག་ས་ནབརྟེན་ད་ལྟའི་བར་སྡོད་རྒྱུ་བྱུང་བ་ཡིན་འདུག།",
    "ངའི་གཟུགས་གཞི་འདི་བབ་ལྕི་ཙམ་འདུག་པས་དབྱེ་བ་མ་ཆོད་པར་གཏན་སྡོད་བྱེད་དགོས་ཀྱི་བཀའ་དང་།",
    "ངེད་ཀྱིས་མི་ཐུབ་འདུག་ཅེས་གསུངས་ཤིང་།",
    "ད་དོ་ནུབ་ཧ་ཅང་ཕྱིས་པ་བཅས་མཇལ་མི་ཐུབ་པ་འདུག་པས་དགོངས་པ་ཞུ་མ་གདགོས་དང་།",
    "དགོས་དོན་ལག་ཏུ་ལོན་དུས་ཤིག་མི་འདུག།",
    "གཏན་དུ་འབྲལ་མེད་བྱ་རྒྱུ་ནི་སུ་ལ་ཡང་མི་འདུག་དེས་ན་ག་ཕ་མའི་བཀའ་དང་འགལ་བ་ནི་ནམ་ཡང་མི་ཞུ་བས་ཕ་བཀའ་དྲིན་ཅན་རང་བདེ་བར་རང་ཡུལ་དུ་ཕེབས་དགོས་སོགས་ལེགས་པར་གསུངས་ཏེ་ཕེབས་རྫོངས་དང་ཕེབས་སྐྱེས་སོགས་སྲི་ཞུ་བླ་ན་མེད་པ་མཛད།",
    "གཟུངས་འབུལ་སོགས་ལ་དམིགས་བསལ་གྱི་གདན་ཞུ་བྱེད་པ་མང་ཙམ་བྱུང་འདུག།",
    "ཡང་དེང་སང་ཞྭ་སེར་གྱི་ལ་བསྟན་པ་འདི་ལ་ཕྱོགས་ཐམས་ཅད་ནས་བགེགས་བྱེད་པ་མང་དུ་འདུག་།",
    "དེང་སང་དེ་འདྲའི་༣མིང་ཙམ་ཡང་དཀའ་བར་འདུག་གསུངས་ནས་དགྱེས་དགྱེས་མཛད།",
    "རཏི་གདན་འདྲེན་ཞུ་བ་ལས་ཐབས་མི་འདུག་ཟེར་ནས་དབྱུག་གཅིག་མ་བྱས་པར།",
    "ད་ཆ་ནན་ཞུ་ཇི་ཙམ་བྱས་ཀྱང་དོན་ཕིག་པར་མི་འདུག་ཚུལ་གསུང་ནའང་།",
    "ཉེན་ཤིན་ཏུ་ཆེ་བར་འདུག་ཀྱང་ད་ཆ་གདན་འདྲེན་ཞུ་བ་ལས་འོས་མི་འདུག་ཟེར་བར།",
    "ཁོང་རང་ནས་བཞུགས་གསུང་ན་བཞུགས་རྒྱུ་དང་།",
    "བོད་གངས་ཅན་གྱི་བདེ་སྡུག་འདི་ལྟ་བུ་ལ་ཐུག་དུས་འདིར།",
    "ངེད་ཀྱི་ཨམ་པོབན་གཉིས་ནས་ལྷུས་མ་ཐིངས་པས་བཀྲས་ལྷུན་ཤོར་འདུག་པར་ཨམ་བན་༣གཉིས་གནས་ཕབ་སྟེ་ལུས་སྟེང་ལ་ཆད་པ་ཕབ་པ་ཡིན།",
    "དེ་ལ་བརྟེན་ནས་ཐུགས་ཀྱི་བཞེད་པ་བླ་ན་མེད་པ་དག་དས་ཀྱང་ཚེགས་ཆུང་ངུས་འགྲུབ་པ་ཞིག་འདུག་གོ་ཞེས་རབ་བཏགས་ཙམ་མ་ཡིན་ད་ས་པར་བས་པ་པར་རང་བཞིན་གྱིས་བརྗོད་པའི་སྙན་པའི་རྒྱལ་རྔ་བརྡུང་པ་ལ་བརྩོན་པར་གརྟ་ན་༣ ཟླབག་ལ་པ་དེ་ཉིད་ནས་བློ་བཟང་ཐུགས་རྗེ་འདི་སྔ་སོར་ནས་ནི་གང་ཡང་མི་ཡོང་བའི་ལྐུགས་པ་འདྲ་༤༩ན་བ་ཞིག་རང་ཡིན་ཞེས་གྲགས་ན་ཡང་།",
    "དེ་ནི་པ་ས་ཙ་ནརྒྱུན་པར་འཇིག་རྟེན་བློས་བཏང་བའི་རྟགས་སུ་འདུག།",
    "དེ་ལྟར་ཡང་རང་རང་ལ་རྣམཔར་དཔྱོད་པའི་བློ་དང་ལྡན་ན་ནི།",
    "བྱས་ཙང་བོད་ཀྲུང་གོའི་འོག་མིན་པར་དེས་ཀྱང་ར་འཕྲོད་པར་འདུག་དམག་ཆེན་གཉིས་པའི་སྐབས་རྒྱའི་མཐུན་ཕྱོགས་ཨ་རི་དང་དབྱིན་ཇི་སོགས་ནས་བོད་གཞུང་ལ་བོད་ཀྱི་ས་ཐོག་བརྒྱུད་དམག་མཁོ་འོར་འདྲེན་ཆོག་པར་བསྐུལ་ནའང་བོད་ནི་དབར་གནས་རྒྱལ་ཁབ་ཏུ་གནས་པས་དེ་ལ་ངོས་ལེན་མཛད་མེད།",
    "བཀའ་གནང་རང་ཟེར་ནས་སྡོད་པ་དང་།",
    "འཇོན་དགོས་པའི་དུས་ལ་བབས་འདུག་གོ།",
    "གསུང་ལས་སྤྲུལ་པའི་དྲང་སྲོང་ཡིད་ལས་སྐྱེས་ཞེས་བྱ་བ་ཞིག་བྱུང་སྟེ་སྟོན་པ་ལ་ཕྱག་དང་སྐོར་བ་བྱས་ནས་སེང་གེའི་ལྟ་སྟངས་ཀྱིས་སྟོན་པའི་མདུན་དུ་འདུག་སྟེ་འཁོར་གྱི་དྲང་སྲོང་རྣམས་ཀྱི་དོན་དུ་ཞུ་བའི་ཚིག་འདི་སྐད་ཅེས་གསོལ་ཏོ།",
    "འཛམ་གླིང་རང་ལུས་འདོམ་གང་གྲུ་བཞི་སྟེ།",
    "དྭངས་མ་ལུས་ཟུངས་རང་རང་མེ་དྲོད་ཀྱིས།",
    "ཞེ་སྡང་འདམ་རིང་རང་བཞིན་ངང་རྒྱུད་བཟང་།",
    "གཅེར་བུར་འདུག་དང་སྐྲ་དང་ཁ་སྤུ་བྲེགས།",
    "ཚད་དགུང་གཉིད་ལོག་འདུག་རྗེས་དྲག་ཤུལ་བྱས།",
    "འགྲངས་རྗེས་དལ་བར་འདུག་དང་ཉིན་གཉིད་ལོག།",
    "རང་རང་གནས་སུ་འཕེལ་ཞིང་གསོག་པར་བྱེད།",
    "གཉིས་པ་ལུས་ཀྱི་མེ་དྲོད་རང་གནས་འདུག།",
    "རྒྱུ་ནི་རང་རང་སྐྱེད་པའི་རྐྱེན་ཡིན་ཏེ།",
    "གོས་བགོ་ཁང་པ་ཆག་ཆག་བཏབ་བར་འདུག།",
    "དེ་རྟགས་བཅོས་ཐབས་རང་རང་ལེའུར་བལྟ།",
    "ཡིད་འོང་སྙན་ཚིག་བསིལ་གནས་དལ་བར་འདུག།",
    "ཀ་ར་སྦྱར་བཏང་རང་རང་རྩ་ལ་གཏར།",
    "ཚིགས་ཁ་གཡོ་ཞིང་བརྐྱང་བསྐུམ་འགྲོ་འདུག་གྱོང་།",
    "འོན་ཀྱང་རང་བཞིན་རྒྱུ་ཡིས་འདུས་པ་དང་།",
    "དང་པོ་འཇུག་དུས་ཆུ་ཚན་ཆུ་སྐྱུར་སྐྱུག།",
    "མེ་ཏོག་དང་པོ་ཆུ་སྐྱུར་སྐྱུག་དུས་སུ།",
    "རྒྱ་བཤལ་སྐྱུག་དུས་ཙན་དན་གུར་ཀུམ་དང་།",
    "ཁྲག་རུལ་དུད་ཁུ་སྐྱུག་དུས་སེ་འབྲུ་དང་།",
    "དོན་ལྔ་རང་རང་རྩ་ལ་གཏར་བ་སྟེ།",
    "དལ་བར་འདུག་དང་མྱ་ངན་སེམས་ལས་དུབ།",
    "ལྕེ་མཆུ་རྙིལ་དཀར་འགྲོ་འདུག་གསུས་པ་ལྡིག།",
    "དྲོ་བའི་གནས་འདུག་མི་རྔུལ་བག་ཙམ་བཅག།",
    "འཇིག་ཟས་རྟ་ཞོན་ཉལ་པོ་འགྲོ་འདུག་དང་།",
    "སྤྱོད་ལམ་འདུག་རྗེས་དྲག་པོའི་ལས་བྱས་ཤིང་།",
    "རླན་སྟེང་ཁ་ཡེང་མ་ཡིན་དབེན་པར་འདུག།",
    "དེ་རྣམས་རིགས་ལ་ཚད་གཉའ་ཆག་དུས་སུ།",
    "ཉལ་དང་སྙེས་དང་ཙོག་པུར་འདུག་ལ་སོགས།",
    "སྨྲ་བརྗོད་སེམས་ལས་འགྲོ་འདུག་སྤངས་ཏེ་བརྟག།",
    "མ་དང་རང་རྩ་དར་ན་རབ་ཏུ་བཟང་།",
    "དེ་དག་གང་ཡང་རང་རྩ་དར་དུས་སུ།",
    "ཡང་ན་མ་དང་རང་རྩ་གཞི་ལ་གནས།",
    "འགྲོ་འདུག་སེམས་ལས་ཆུ་འཁྲུགས་སྤང་བར་བྱ།",
    "གྲང་ནས་ལྡོག་དུས་ལྡོག་ཚུལ་ལོག་རྗེས་བརྟག།",
    "ལྡོག་དུས་རླངས་མ་ཡལ་བར་ལྡོག་པ་ཚ།",
    "ཞག་དུས་བསྲོས་ཀྱིན་ཞག་གསུམ་བར་དུ་བཞག།",
    "བརྟ་བྱ་བྱིས་པ་རྒས་དང་སྐྱིད་པར་འདུག།",
    "འགྲུལ་བསྲུང་མི་སྨྲ་མི་ཉལ་ཙོག་པུར་འདུག།",
    "མི་སྨྲ་མི་འགུལ་ཙོག་པུར་འདུག་པ་དང་།",
    "མི་སྨྲ་མི་གྲང་ཙོག་པུར་འདུག་པར་བྱ།",
    "སྐྱེ་རྒ་ན་འཆིའི་སྡུག་བསྔལ་ལ་གདོང་ལེན་བྱེད་ཐབས་མི་འདུག་མི་ན།",
    "ལུས་ཁོ་རང་ཅི་འདྲ་སྐྱིད་རུང་སྐྱིད་པའི་སྣང་བ་ཞིག་ཡོད་པ་མིན།",
    "ཕྱིའི་མཐུན་རྐྱེན་ཚོགས་དང་མ་ཚོགས་ལ་མ་ལྟོས་པའི་སྐྱིད་པོ་ཞེས་པ་དེ་དེ་ཡིན་འདུག་སྙམ་པའི་ར་འཕྲོད་ཡོང་རྒྱུ་ཡོད་པ་ཡིན།",
    "སྡུག་པའི་དུས་སུ་སྡུག་པ་རང་ག་པ་མ་ཡིན་པ་རྔ་མ་སྒྱིད་ཁུང་ལ་དྲངས་ནས་མ་སྒྱེད་ཀྱི་སྒྱེད་ཁུང་ནང་དུ་འཛུལ་འགྲོ་ས་འདུག་སྙམ་པ་དེ་འདྲའི་ཅོལ་ཆུང་ཞིག་ཡིན་ལ།",
    "དེ་ལ་ཡང་ཕན་ཐོགས་ཆེ་ཞིག་མི་འདུག་སྟེ།",
    "ཕུ་གཡའ་མ་ཆགས་ཆགས་རྫ་ནས་ཆགས་འདུག།",
    "རྫ་མེད་ན་གཡའ་མ་ཆགས་དོན་མི་འདུག།",
    "མདའ་སྨུག་པ་ལང་ལང་མཚོ་ནས་ལངས་འདུག།",
    "འོན་ཀྱང་དེས་འཚེངས་ནས་མི་འདུག་སྟེ།",
    "ང་རང་ཉིད་སྡུག་བསྔལ་གྱི་ནང་ནས་ཐར་དུ་ཡོད་ཀྱང་།"
  ]
}