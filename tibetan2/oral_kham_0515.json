    "དེ་ལྟར་སྙུན་གསོལ་ཞིང་རང་ཉིད་ཀྱི་ངང་ཚུལ་ཅུང་ཟད་བརྗོད་ནས།",
    "བདེ་བར་འཚོ་ཞིང་རང་ཁྱིམ་ཁོ་ན་ན།",
    "ཅེས་པའི་དོན་ལུས་སེམས་བཏགས་པའི་ཚོགས་པ་ལྷན་ཅིག་ཏུ་འདུས་པ་ལ་སྲོག་ཆགས་ཞེས་པའི་ཐ་སྙད་འཇིག་རྟེན་ལ་འདུག་པ་ལྟར།",
    "ཏི་ཤྲཱིའི་ལས་ཁ་ཁྱད་པར་ཅན་གནང་འདུག་པ་བཞིན།",
    "རང་རང་སོ་སོའི་གང་འོས་ཀྱི་བསྒྲུབ་ལུགས་བྱས་པས།",
    "རྗེས་སུ་བརྟག་དཔྱད་བྱ་དགོས་པ་གདའ།",
    "དེ་ལས་གཞན་པའི་སྨིན་བྱེད་གཞུང་སོ་སོའི་སྲོལ་ལ་མ་བྱུང་གདའ་བ་དགོངས།",
    "སེམས་གྱ་གྱུ་མ་མང་རང་ཚུགས་ཟུང་།",
    "ལྷ་མིན་གྱི་གནས་ནའང་རང་བཞིན་གྱི།",
    "བདེ་མཆོག་དུས་འཁོར།",
    "འཆི་བའི་ཚེ་ན་ཡང་བདག་ཉིད་ཀྱི་མལ་དུ་འདུག་པ་བཞིན་དུའམ།",
    "མེད་དོ་ཞེས་བདེ་བར་འདུག་པའི་རིགས་མ་ཡིན།",
    "ཅི་ཕྱིར་བདག་ཉིད་བདེ་བར་འདུག།",
    "འདུག་པར་འགྱུར་ན།",
    "བྲན་གཡོག་བཀོལ་དུ་མི་བཏུབ་ལའང་། མི་འདུག་གོ་ཞེས་ངེས་པར་བྱས་ནས།",
    "རྐང་པ་ན་ཡང་ཁ་གདངས་རྐང་པ་རབ་ཏུ་བརྐྱང་བ་ཉིད་ཀྱིས་མི་འདུག་ཅིང་གནས་པར་མི་བྱའོབརྐྱང་སྟེ།",
    "འོན་ཀྱང་རང་ངམ་གཞན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་སོ།",
    "སྐྱེ་བོ་མིག་རྒྱང་རིང་པོ་དག་དུས་རིང་པོར་མཐོང་བ་ལ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "འདུག་ནས་ཡོངས་འཛིན་སྲུང་བའི་སྡུག་བསྔལ་སྤངས།",
    "ནུས་པའི་དངོས་པོ་བཟང་པོ་གཞན་དག་ལ་འཛིན་པའམ་ཞེན་པར་མི་འགྱུར་ན་ཡང་རང་བཞིན་གྱི་ལུས་ལ་ཡང་ཅིའི་ཕྱིར་མི་འཛིན་ཞེ་ན།",
    "ཡང་གྲངས་ཅན་གྱིས་དེ་ཤེས་པ་དང་རང་བཞིན་ནི་ཡོད་པ་ཉིད་དུ་མཉམ་ཞིང་མཚུངས་ཏེ།",
    "གཟུགས་ཅན་གྱི་ལུས་མེད་ཅིང་རང་རིག་པར་འདོད་པ་དེ་ལ་འདུ་བར་མི་འཐད་དོ།",
    "རྣམ་པར་དཔྱོད་པ་ཡང་རང་བཞིན་གྱིས་མ་སྐྱེས་པ་ཡིན་ལ།",
    "འདི་ཞེས་བྱ་བ་ལ་དེ་སུ་གང་འདི་ལྟར་ཤིན་ཏུ་སྡུག་བསྔལ་བར་གནས་ཀྱང་རང་སྡུག་བསྔལ་ཞིག་ཅེ་ན།",
    "འདུག་པ་ནི་གནས་པའོ།",
    "འདིའི་ཕྱིར་ན་ཡང་བདེ་བར་འདུག་པར་མི་རིགས་སོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "རྩོལ་གོ་སྙམ་དུ་ཡིད་ཀྱིས་རིགས་པར་བྱའི་རང་ཁེངས་ཤིང་རང་བ་ནི་གང་དུ་ཡང་རུང་བའོ།",
    "མཉམ་པ་ནི་གཉི་ག་དུས་གཅིག་ཏུའོ།",
    "མྱུར་དུ་ལྡང་བ་ནི་དབྱལ་ིབ་དང་ལུས་བསྙུང་བ་ལ་སོགས་པ་དང་བྲལ་ཞིང་མྱུར་བ་ཉིད་དུ་ཙོག་ཙོག་འདུག་པའོ།",
    "དྲུང་ན་འདུག་པ་ནི་ཉེ་དུ་ལ་སོགས་པའོ།",
    "གནས་སྐབས་ཁ་ཅིག་ནི་མི་བདེ་བའི་རྒྱུར་འདུག་པ་དེ་ཉིད་གནས་སྐབས་གཞན་དུ་གྱུར་པ་དེའི་ཚེ་བདེ་བའི་རྒྱུར་འགྱུར་བ་ཡིན་ནོ།",
    "གསངབ་དགེ་སློང་བི་རོ་ཙ་ན་ཡིས།",
    "ཁོ་བོ་ཤིན་ཏུ་ཡང་མི་འཐད་པས་ཕན་ཚུན་འགལ་བའི་ཉེས་པ་སོ་ན་གནས་ལཅག་ནི་ཡུལ་སྒྱུ་མ་ཙམ་འདི་མེད་ཀྱང་རང་རིག་པའི་སྒོ་ནས་ཤེས་པ་ཉིད་དུ་ཁས་ལེན་པས་དམ་བཅས་པ་ལ་ཕན་ཚུན་འགལ་བའི་ཉེས་པ་མི་མཚུངས་སོ་ཞེ་ན།",
    "དང་པོ་ནས་སྔོན་པོ་ཉིད་དུ་འདུག་པ་ཡིན་པའི་ཕྱིར།",
    "འོན་ཏེ་གང་ལས་ཀྱང་མ་སྐྱེས་ཀྱང་རང་བཞིན་གྱིས་གནས་སོ་སྙམ་ན།",
    "སྦྱིན་རྒྱུ་ས་གཞི་རྟ་ཡི་སྦྱིན་སྲེག་དུས།",
    "ངེས་པར་འཆི་བར་འགྱུར་ན་བདེ་བར་འདུག་པ་མི་རིགས་སོ།",
    "རྐང་པ་བརྐྱང་སྟེ་ཤིང་སྟན་ལ་སོགས་པར་འདུག་པར་མི་བྱའོ།",
    "སྦྱིན་སོགས་ཀྱང་རང་བཞིན་མེད་པའི་ཕྱིར་རོ།",
    "ཇི་ལྟར་མར་མེས་བུམ་པ་ལ་སོགས་པ་མུན་པ་ལ་ཡོད་པ་སྣང་བར་བྱས་ཤིང་རང་ཡང་སྣང་བར་བྱེད་པ་དེ་བཞིན་དུ་རང་རིག་ཀྱང་སྣང་ཞེ་ན།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་དེས་ཀྱང་རང་རིག་ཏུ་མི་འགྲུབ་སྟེ།",
    "དེ་ལྟ་ཡིན་ཀྱང་རང་རིག་བསྒྲུབ་པའི་དོན་དུ།",
    "སེམས་ཀྱང་རང་བཞིན་གྱིས་འོད་གསལ་བས་རྣམ་པར་བྱང་བའི་རང་བཞིན་ཏེ།",
    "དེ་ཡང་རང་རིག་མ་ཡིན་པས་དེ་དང་མཚུངས་པའི་ཕྱིར་རོ།",
    "སྣང་བ་རྣམས་ཀྱང་རང་བཞིན་མེད་པའི་ཕྱིར་རོ།",
    "གཞན་ཡང་རང་དང་གཞན་གཉི་གའི་བདག་ཉིད་རྒྱུས་དངོས་པོ་ཡོད་པའམ།་",
    "གང་ཡང་རང་བཞིན་གྱིས་སྟོང་པ་དེ་ལ་ནི་སྐྱེ་བ་མེད་འཇིག་པ་མེད་དོ།",
    "དེ་ལྟ་ན་ཡང་རང་སྣང་བར་ཁས་ལེན་ན་ནི་ཐ་དད་པར་འགྱུར་རོ་ཞེས་སྐྱོན་སྔར་བསྟན་ཟིན་ཏོ།",
    "༡༢༢དུས་ན་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་དང་འདུག་པའི་དངོས་པོ་གང་ཡིན་པ་དེ་ཉིད་ལྷན་ཅིག་བྱེད་པའི་རྒྱུ་དང་བྲལ་བའི་དུས་ན་ཡང་འདོད་ན་ནི་དེའི་རྗེས་སུ་འཇུག་པ་ཉིད་ཀྱི་ཕྱིར་དེའི་ཚེ་ལྷན་ཅིག་བྱེད་པའི་རྐྱེན་རྣམས་ཀྱང་མགུལ་ནས་བཏགས་པ་བཞིན་དུ་སྟོབས་ཀྱིས་དྲངས་ནས་གནས་ཏེ།་",
    "༩ ༡༥དང་འདུ་ཤེས་དང་སེམས་པ་ལ་སོགས་སེམས་ལས་བྱུང་བ་རྣམས་ཀྱང་རང་བཞིན་མེད་པར་བདེ་བླག་ཏུ་ཤེས་སོ།",
    "དེ་བས་ན་འབྲེལ་༧པ་ཅན་མེད་པའི་ཕྱིར་འདུ་བ་ཡང་རང་བཞིན་མེད་པ་ཁོ་ནའོ།",
    "དྲན་པ་ནི་མདུན་ན་འདུག་པའི་དངོས་པོ་ལ་ཡང་ཤིན་ཏུ་གསལ་བར་རྟོགས་པ་མ་ཡིན་ནོ།་།",
    "དེ་གཉིས་ཀྱང་འདུག་པའི་ཕྱིར་རོ།་།",
    "འདས་པའི་དུས་ན་ཡང་རང་བཞིན་གྱི་ངོ་བོ་ཉིད་ཀྱིས་མྱ་ངན་ལས་འདས་པ་སྟེ།",
    "ཕྱོགས་གཉིས་པ་ལ་ཡང་རང་བཞིན་གཞན་དང་གཞན་སྐྱེ་བའི་ཕྱིར་དང་།",
    "དཔེར་ན་གཞོང་བུ་སྣ་ཚོགས་ན་འདུག་པའི་རྒྱ་ཤུག་ལྟ་བུ་སྟེ།",
    "མདུན་ན་འདུག་པ་ཞེས་བྱ་བ་ནི་ད་ལྟར་ཞེས་བྱ་བའི་ཐ་ཚིག་སྟེ།",
    "འགལ་བ་གཉིས་ཀྱང་རང་བཞིན་གཅིག་པ་ཉིད་ཡིན་ན་ནི་འགྲོ་བ་མཐའ་དག་རྫས་གཅིག་ཏུ་འགྱུར་ཏེ།",
    "བརྟགས་པའི་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པ་ཡོངས་སུ་གྲུབ་པའི་ངོ་བོ་ཉིད་ཅེས་བྱ་བའི་དངོས་པོ་གང་ཡིན་པ་དེ་བཅོམ་ལྡན་འདས་ཀྱིས་བདག་ལ་ཀུན་བརྟགས་པའི་ངོ་བོ་ཉིད་ཀྱིས་སྟོང་པར་བསྟན་ཏོ་སྙམ་དུ་སེམས་ན་དེ་ཡང་རང་བཞིན་སྟོང་པ་ཉིད་དུ་ཤེས་པར་གྱིས་ཤིག་ཅེས་བྱ་བར་སྦྱར་ཏེ།",
    "གང་དག་ལ་རྟག་ཏུ་ཉེ་བར་གནས་པའི་རྒྱུ་དང་རང་བཞིན་ཡོད་པ་ཞེས་བྱ་བར་ཚིག་རྣམ་པར་སྦྱར་ཏེ།",
    "ཚེ་པེ་སྣར་འདུག་པེ་སྣར་མ།",
    "གང་རང་བཞིན་གྱིས་སྟོང་པ་དེ་ལ་ནི་སྐྱེ་བ་ཡང་མེད།",
    "གང་རང་བཞིན་ཡིན་པ་དེ་ནི་ཉེ་བར་མི་དམིགས་སོ།",
    "དེ་སྐྱེ་ན་ཡང་འདི་དག་དུས་གཅིག་ཏུ་དེའི་བདག་ཉིད་དུ་སྣང་བར་ནི་མི་འགྱུར་ཏེ།",
    "དེ་ཡང་ངོ་བོ་ཉིད་མེད་པ་ཉིད་དུ་རབ་ཏུ་སྒྲུབ་ན་ནི་གཞི་མ་གྲུབ་པ་ཉིད་ལ་སོགས་པའི་ཉེས་པ་དེ་ཡང་དེའི་སོ་ན་འདུག་པ་ཁོ་ན་ཡིན་ལ།",
    "ཁྱད་པར་གདའ་བ་ལ་སོགས་པ་གང་དག་ཡིན་པ་དེ་དག་ཀྱང་ཕྱི་རོལ་གྱི་དོན་གྱི་ངོ་བོ་ཡང་མ་ཡིན་ལ།",
    "འཁྲུལ་པ་དོན་གཞན་ཡིན་ཡང་དེ་དང་རང་རིག་པའི་མཐར་ཐུག་པ་ཉིད་ཡིན་པས་དེས་གཉིས་མེད་པ་དེ་ལྟར་ཤེས་པ་ནི་མ་ཡིན་ནོ།",
    "འོན་ཏེ་ཐ་དད་པ་མ་ཡིན་ན་ནི་དེའི་ཚེ་རྒྱུ་དང་འབྲས་བུ་དག་འཆོལ་པའི་ཉེས་པ་དེའི་༧སོན་འདུག་པ་ཉིད་དོ།",
    "དེའི་ཕྱིར་བྱེད་པ་རྣམས་ཁོ་ན་ཕན་ཚུན་སྦྱོར་བའི་ཕྱིར་དངོས་པོ་ནི་གྱི་ནར་འདུག་པ་ཉིད་དུ་འགྱུར་རོ།",
    "འོན་ཏེ་འདི་དག་དུས་མཉམ་པར་འགལ་བ་ཉིད་ཡིན་ན་ནི་དེའི་ཚེ་རིམ་གྱིས་ཀྱང་ཅིའི་ཕྱིར་མི་འགྱུར་ཏེ།",
    "རིགས་གང་དག་དེ་ཁོ་ན་ཉིད་དཔྱོད་པ་ལ་ཞུགས་པའི་བློ་གྲོས་ཅན་དེ་དག་ནི་དེ་ལྟར་འདུག་པར་རིགས་པ་མ་ཡིན་ནོ།",
    "བརྫུན་པ་གང་དག་ནམ་ཡང་རང་དང་གཞན་གྱི་དོན་དུ་ཉེ་བར་སྦྱོར་བར་མི་འགྱུར་བ་དེ་དག་ནི་རྣལ་འབྱོར་པ་རྣམས་ཀྱིས་ཐམས་ཅད་དུ་ཡོངས་སུ་དོར་བའི་མཚན་ཉིད་ཀྱི་སྤང་བར་བརྗོད་དོ་ཞེས་བྱ་བར་རིགས་ཀྱི།",
    "འདི་དངོས་པོ་མེད་པའི་ངོ་བོ་ཉིད་ཡིན་ན་ནི་ས་བོན་ཡང་རང་དང་མཐུན་པ་དང་དངོས་པོར་གྱུར་པ་མ་ཡིན་པ་ཁོ་ནར་རིགས་ཀྱི།",
    "དེ་བཞིན་གཤེགས་དང་རང་རྒྱལ་གྱི།",
    "ང་༡ ༣ ར་༣སྐྱེ་བོ་ཉེ་བ་ལ་ལྟོས་ཏེ་དགོངས་པ་ཡིན་ནོ་ཞེས་བྱ་བར་རྣམ་པར་འཆད་པར་བྱེད་པ་དེ་ཡང་རང་དགའ་ཙམ་གྱིས་ཉེ་བར་བརྟགས་པ་ཡིན་པའི་ཕྱིར་རིགས་པ་མ་ཡིན་པ་ཉིད་དེ།",
    "ཅེས་སོགས་འདུག་པས་ལེགས་པར་བརྟག་པར་རིགས་སོ། པེ་སྣར་བསྩལ།",
    "ཡུལ་ན་བཀྲམ་སྟེ་འདུག་པ་མེད།",
    "ཐར་འདོད་རྐང་སྨྱུང་འདུག་ལ་རག།",
    "གཞན་ཡང་རང་བཞིན་འབྲས་བུ་ཡི།",
    "ཡུལ་ལ་བཀྲམ་པ་ལྟར་འདུག་པར་ཡོངས་སུ་འཛིན་པར་སྣང་བའི་རྣམ་པ་སྣ་ཚོགས་ཉིད་ཡིན་པར་གཞུང་གཟུགས་པའི་ཕྱིར་ཤེས་པ་དུ་མ་སྐྱེ་བར་རྟོགས་པ་ཡང་ལེགས་པ་མ་ཡིན་ཏེ།",
    "ཤེས་པ་རྣམས་ནི་ལུས་མེད་པ་ཉིད་ཀྱི་ཕྱིར་ཡུལ་ལ་བཀྲམ་པ་ལྟར་འདུག་པར་ཡོངས་སུ་འཛིན་པ་མེད་པའི་ཕྱིར་རོ།",
    "དེའི་ཕྱིར་ཉེས་པ་སོ་ིན་འདུག་པ་ཁོ་ན་ཡིན་ནོ།",
    "དེའི་ཚེ་བྱེད་པ་རྣམས་ཁོ་ན་རྒྱུད་མར་སྦྱོར་བའི་ཕྱིར་དངོས་པོ་ནི་གྱི་ན་འདུག་པ་ཉིད་དུ་འགྱུར་རོ།",
    "ལ་གསལ་བར་མ་བྱས་པར་ཡང་མི་འདུག་སྟེ།",
    "དེར་ཡང་གནས་བཅསནས་ནི་འདུག་པར་བྱེད།",
    "འགྲོ་བ་དང་ནི་འགྲེང་དང་འདུག་པ་དང་།",
    "བཅོམ་ལྡན་འདས་ལ་ལྟ་ཤིང་འདུགནས་བསམས་པ་འདི་ཉིད་འདི་ལྟ་སྟེ།",
    "གང་ཞིག་ང་ཡི་མདུན་འདུགནས།",
    "དགའ་བ་སྐྱེས་ཤིང་མགུ་བ་དང་རངས་པ་དང་མཆོག་ཏུ་དགའབར་གྱུར་ཏེ།",
    "ཚད་ཤིང་རྟའི་འཕང་ལོཙམ་ལ་འདུག་སྟེ།",
    "རྒོད་ཅིང་འདུག་བར་མི་བྱའོ།",
    "རྐང་རྟེན་བཅས་པའི་ཁྲིལ་རབ་འདུག་ཅིང་།",
    "གློངན་འདུག་ཀྱང་རུང་གཙུག་ལག་དེའི་དྲུང་དུ་འདོང་བར་འགྱུར།",
    "དེང་ཞིན་བདག་ལུས་སེང་གེའི་ཁྲི་ལ་འདུག།",
    "འདིན་ང་འདུག་པ་ཡང་མཐོང་ངོ།",
    "འདི་ལྟ་སྟེ་ང་བྱ་རྒོད་ཀྱི་ཕུང་པོའི་རི་ལ་འདུག་སྟེ།",
    "གངན་འགྲེང་ངམ་འོན་ཏེ་འདུག་པ་འམ།",
    "གཙུག་ལག་ཁངན་དུག་གམའདུག་གམ་གྲོང་ན་འདུག་གམ་ལྗོངས་ན་འཇུག་པང་རུང་སྟེ།",
    "དེ་ནི་འཁོར་གྱི་ནང་དེར་འདུགནས་སུ།",
    "དེ་ནི་འདིན་འདུག་བཞིན་དེ་དག་ཐོས།",
    "དེ་བཞིན་འགྲེང་དང་འདུག་དང་ཉལ་པདང་།",
    "དཔའ་བོ་འདིན་འདུག་བཞིན་དེ་དག་ཚོར།",
    "འདིན་འདུག་བཞིན་སྣ་ཡི་སྟོབས་ཀྱིས་ཚིར།",
    "རྣམངོནབར་བརྩོན་པ་འཆག་ཅིང་འདུག་པ་དང་།",
    "བཙོམ་ལྡནའདས་འདི་དཀའ་བ་བགྱིད་པ་བྱེབ་ཁྲག་ཁྲིག་བརྒྱ་སྟོངམང་པོ་དག་གདའ།",
    "༡ ན་ཐོས་དང་རང་སངས་ཆས་དང་།",
