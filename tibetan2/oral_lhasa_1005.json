    "དེ་ལྟར་བྱས་ན་ཡེ་ཤེས་དབབ་པར་འགྱུར་ཏེ།",
    "རྒྱུད་༥༤ཞེས་པ་ཡེ་ཤེས་དབབ་པར་འགྱུར་བས་ན་དེའི་རྟགས་ནི་ལུས་དང་ངག་དང་སེམས་མཉམ་པར་གནས་པ་དང་།",
    "གང་ཡང་རུང་བའི་ངོགས་སུ་གནས་ལ་དེ་དག་ཏུ་ཡང་གནས་རབ་ཏུ་དབེན་པར་བྱས་སམ་ཏིང་ངེ་འཛིན་གྱི་རྣལ་འབྱོར་རབ་ཏུ་དབེན་པར་བྱས་ཀྱང་རུང་།",
    "གནས་དེར་ཁམ་པ་དང་ཟངས་མ་ལ་སོགས་པ་ལས་བྱས་པའི་སྣོད་ཁ་ཡངས་པ་དག་ན་ཆུས་བཀང་བ་བཞག་སྟེ།",
    "རིགས་གང་ཡང་རུང་བ་བསྒྲུབ་པ་དེའི་དཀྱིལ་འཁོར་གང་ཡང་རུང་བ་ཅིག་ཆུ་དེའི་སྟེང་དུ་བྲིས་ཏེ་སྔོན་གྱི་དུས་སུ་བྱ་བའི་ཆོ་ག་རྣམས་བྱས་ནས་ཞེས་པ་ནི།",
    "ཆུ་དེའི་དྲུང་དུ་ཏིང་ངེ་འཛིན་འདིའི་ཆོ་ག་བཞིན་དུ་མངོན་དུ་བྱས་ཏེ།",
    "དེ་བཞིན་དུ་མཉམ་པར་གཞག་པའི་ཏིང་ངེ་འཛིན་དེ་ཉིད་ཀྱིས་ལངས་ནས།",
    "འདོད་པའི་གཟུགས་སྟོན་པའི་སྦྱོར་བ་ནི་ཞེས་པ་འགྲོ་བ་གང་ལ་གཟུགས་ཇི་ལྟར་འདོད་པ་བཞིན་དུ་སྟོན་པར་ནུས་པའི་ཏིང་ངེ་འཛིན་ནི་འདོད་པའི་གཟུགས་སྟོན་པར་ནུས་པའི་སྦྱོར་བ་སྟེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་སྟེ།",
    "དེ་དག་དེ་བཞིན་དུ་བྱས་ནས་བདག་ཉིད་གང་འདོད་པའི་གཟུགས་སུ་བརྟགས་ནས།",
    "དེ་ལྟར་བསྒོམས་ན་གང་ལྷར་འདོད་པའི་གཟུགས་སྟོན་ནུས་པར་འགྱུར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་གྱུར་པ་དང་དེའི་ངང་ལས་སེམས་མཉམ་པར་བཞག་ན་ཐད་ན་འཁོད་པ་རྣམས་ཀྱིས་ཀྱང་མི་མཐོང་བར་གྱུར་ཏོ།",
    "དེ་ནས་ཏིང་ངེ་འཛིན་དེ་ལ་གནས་ནས་སུས་ཀྱང་མཐོང་བར་མི་འགྱུར་བ་དེ་སྲིད་དུ་རྣལ་འབྱོར་ལ་གནས་པར་བྱ་སྟེ།",
    "བདག་རང་རྡོ་རྗེ་དབབ་བྱས་ནས།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཟུགས་རྣམ་པར་མ་བཤིག་པ་ཉིད་དུ་ཞེས་པ་ནི།",
    "རྒྱུད་༥༤འཛིན་མ་བཏང་བ་དེ་སྲིད་དུ་ནམ་མཁའི་དཀྱིལ་ན་གནས་ནུས་པར་འགྱུར་རོ།",
    "ཡེ་ཤེས་དབབ་པ་ལ་སོགས་པ་བྱས་ནས།",
    "ནམ་མཁའ་ལ་གནས་ནུས་པར་བརྟག་གོ།",
    "དེ་ལྟར་ནུས་པར་གྱུར་པ་དང་།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སོགས་པ་བྱས་ནསབཛྲ་ཛྭ་ལ་ཛྭ་ལ་ཞེས་བརྗོད་པས།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དཀྱིལ་འཁོར་ལ་སོགས་པ་བྱས་ནས་ནུབ་གཅིག་དེ་བཞིན་དུ་མཉམ་པར་གཞག་ནས་ལྷའི་མིག་ལ་སོགས་པའི་སྦྱོར་བ་བྱའོ།",
    "ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "མཚན་གཅིག་ཏིང་ངེ་འཛིན་དེའི་ངང་ལ་མཉམ་པར་བཞག་ནས་དུས་ཕྱིས་ཇི་ལྟར་འདོད་པར་ཏིང་ངེ་འཛིན་ཡིད་ལ་བྱས་ནས།",
    "གཞན་ལ་བསྟན་དུ་བཏུབ་པ་ནས་རྡོ་རྗེ་འཛིན་གྱི་གོ་འཕང་འཐོབ་ཀྱི་བར་དུ་ཏིང་ངེ་འཛིན་གོམས་པར་བྱའོ།",
    "སྔ་མ་བཞིན་སྦྱོར་བ་བྱས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནི་ལས་རྣམ་པ་བཞིའི་ཏིང་ངེ་འཛིན་བསྒྲུབ་པ་གསུངས་པ།",
    "བསྒྲུབ་པར་བྱ་བའི་གདུལ་བྱ་དེ་སྐྱེས་པ་དང་།",
    "དེ་ཉིད་ཀྱི་ཚུལ་གྱིས་དེའི་ལུས་ལ་ཁྱབ་པར་བྱ་བའི་ཚུལ་དུ་སྤྲོ་བ་དང་།",
    "ནུབ་གཅིག་སྔ་མ་ཁོ་བཞིན་དུ་ཏིང་ངེ་འཛིན་དུ་གནས་པར་བྱའོ།",
    "དེ་ལྟར་བྱས་ནས་སྐྱེས་པ་དང་།",
    "བུ་ག་ནས་ནང་དུ་འཇུག་པ་ལ་སོགས་པའི་ལས་སྔ་མ་བཞིན་དུ་བྱས་ཏེ།",
    "ད་ནི་དབབ་པ་བྱས་པ་ཡང་རྒྱུད་ལས་འདི་སྐད་དུ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བས་ན་ཚུལ་དེས་རིགས་བརྒྱ་ཁོ་ནར་རིག་པར་བྱའོ།",
    "སྡུག་བསྔལ་ཐམས་ཅད་བསལ་བའི་ཁྱད་པར་ནི་ཞེས་བྱ་བ་འདི་ལྟ་སྟེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ཉིད་ཏིང་ངེ་འཛིན་དང་ལྡན་པར་བྱ་བ་དང་།",
    "དེ་ནི་ཚངས་པའི་གནས་བཞི་ཐོབ་པར་བྱེད་པའི་རྒྱུ་ཡང་ཡིན་ལ།",
    "དེ་ལྟར་གྱུར་པར་ནུས་པ་དང་།",
    "འདུ་བའི་ཚུལ་གྱིས་ཇི་ལྟར་འདོད་པར་བདག་དང་མི་གཉིས་པར་གྱུར་པ་དང་།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་ཡེ་ཤེས་བསླབ་བོ་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་གསུངས་པ་དང་།",
    "མ་ཧཱ་མེརྱ་སྤ་ར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ནས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་རྗེས་སུ་དྲན་པ་ལ་སོགས་པའི་ཡེ་ཤེས་བསླབ་པར་བྱ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པ་ཡིན་ཏེ་ནམ་མཁའ་འམ་ཡང་ན་ཕྱོགས་གཞན་དུ།",
    "འདི་ཉིད་དུ་བསྟན་པའི་རིམ་པ་ལས་རིག་པར་བྱའོ།",
    "སྔར་བསྟན་པའི་དོན་དེ་ལྟར་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་ཕྱག་རྒྱ་བཞི་པོ་དག་བསྒྲུབ་པར་བྱ་བའི་ཕྱིར།",
    "དེ་ནས་གདོད་ཕྱག་རྒྱ་ཆེན་པོ་ལ་སོགས་པ་བསྒྲུབ་པར་བྱ་བ་དེའི་དོན་ལ་ནན་ཏན་བྱའོ།",
    "དེ་ནས་སྔར་གསུངས་པའི་ཚུལ་གྱིས་བདག་དམ་ཚིག་སེམས་དཔའི་རྣལ་འབྱོར་ཇི་ལྟར་བྱས་པ་དེ་བཞིན་དུ་འདིར་ཡང་གསལ་བར་མངོན་དུ་བྱས་ཏེ།",
    "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུ་རྣམ་པར་སྣང་མཛད་དམ་སྤྲུལ་པའི་སྐུ་ཤཱཀྱ་ཐུབ་པས་ནམ་མཁའི་ཁམས་ཐམས་ཅད་ཏིལ་འབྲུས་ཏིལ་གྱི་གང་བུ་གང་བའམ།",
    "ཏིལ་མར་གྱིས་ཏིལ་འབྲས་ལ་ཁྱབ་པ་བཞིན་དུ་ནམ་མཁའི་ཁམས་ཐམས་ཅད་ཁྱབ་ལ་གཅིག་ལ་གཅིག་ཀྱང་སྒྲིབ་པ་མེད་པར་གང་བར་བསམས་ལ་དེ་ལྟར་བཞུགས་པའི་དེ་བཞིན་གཤེགས་པའི་ཚོགས་དེ་རྣམས་དང་པོར་རྡོ་རྗེ་ལྕགས་ཀྱུའི་ལས་ཀྱི་ཕྱག་རྒྱས་སྤྱན་དྲངས་པའི་ཚུལ་དུ་བཀུག་སྟེ།",
    "ཕྱག་རྒྱ་ལྷག་མ་རྣམས་ཀྱིས་ཀྱང་འདི་བཞིན་དུ་བྱས་ཏེ།",
    "ཞེས་བརྗོད་པར་བྱའོ།",
    "ཡིད་ཀྱིས་བྱ་བ་དེ་ནི་སེམས་མཉམ་པར་གཞག་པའི་ཏིང་ངེ་འཛིན་ལས་མི་ཉམས་པར་བྱ་བའི་ཕྱིར་ན་སྒྲུབ་པ་ཆེན་པོ་ཞེས་བྱ་སྟེ།",
    "ཐབས་གོང་མ་ལས་གཞན་ཡིན་ནོ་བར་གསུངས་སོ།",
    "དེ་ལྟར་དེ་བཞིན་གཤེགས་པའི་ཕྱག་རྒྱ་ཆེན་པོའི་བྱིན་གྱིས་བརླབ་པའི་ཐབས་བསྟན་ནས་དེ་བཞིན་གཤེགས་པའི་རིགས་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོར་བྱིན་གྱིས་བརླབ་པའི་ཐབས་བསྟན་པའི་ཕྱིར་ན་དེ་ལ་འདི་ནི་དེ་བཞིན་གཤེགས་པའི་རིགས་རྡོ་རྗེ་སེམས་དཔའ་ལ་སོགས་པའི་སེམས་དཔའ་ཆེན་པོ་རྣམས་ཀྱི་ཕྱག་རྒྱ་ཆེན་པོར་བྱིན་གྱིས་བརླབས་པ་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སྔར་གོང་དུ་གསུངས་པའི་རིམ་གྱིས།",
    "སེམས་མ་རྡོ་རྗེ་མའི་ཕྱག་རྒྱ་དྲལ་བ་སྔར་བྱས་ཏེ།",
    "སྐུ་རྣམ་པར་དག་པ་ཟླ་བ་ལྟར་གསལ་ཞིང་འོད་འཕྲོ་བ།"
  ]
}