    "བློ་ཞན་པ་དེ་དག་ལ་མི་རིགས་པར་གསུངས་སོ།",
    "ཇི་ལྟར་འདོད་པར་བྱེད་པས་ཞེས་པ།",
    "ཇི་ལྟར་ལྷའི་དངོས་གྲུབ་འདོད་པར་བྱེད་པ་ཅི་ནུས་ཚད་དུ་བཟླས་བརྗོད་བྱ་སྟེ།",
    "མང་དུ་བརྗོད་པར་མི་ནུས་ན་ཡང་།",
    "ཀུན་གྱི་དོན་དུ་ན་ནི་ཆ་ཤས་སུ་ཕྱེ་བས་འདི་ལྟར་སྟོན་པར་བྱེད་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "སྨྲས་པ་འདི་ཡང་ཉེ་བའི་མཚན་ཉིད་ཀྱི་ཚིག་ཏུ་ཟད་དེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་དག་བརྗོད་པས་ཀུན་བརྗོད་པར་འགྱུར་བས་གཟུང་བར་ཟད་ཀྱི།",
    "འོ་ན་ཚུལ་འདིས་འདི་ལྟར་བྱ་བས་ཆོག་པར་ཟད་ཀྱིས།",
    "ཇི་སྐད་དུ་གསུངས་པའི།",
    "དེས་དོན་འདི་ལྟར་འགྱུར་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འོ་ན་འདི་ལྟ་བུའི་རྣམ་པས་དེ་བཞིན་དུ་འགྲུབ་པར་འགྱུར་ན།",
    "ཤིན་ཏུ་རིགས་པ་ཡིན་ན་འདི་ཁོ་ནའི་ཐབས་དང་རིམ་པ་སྟོན་པར་མི་བྱེད་ནས།",
    "དམ་ཚིག་སེམས་དཔའ་བསྒྲུབ་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཕྱོགས་གཉིས་པ་འདི་ཡང་ཞེས་པ་བསྡུས་པ་དང་རྒྱས་པར་བསྟན་པ་ལས་རྒྱས་པར་བྱ་བའི་རིམ་པ་གོང་དུ་བསྟན་ནས།",
    "རྒྱུདསཀྑི་༥༤འདི་ཡང་ཤེས་རབ་ཞན་པ་འདི་དག་ལ་བསྟན་པར་ཟད་ཀྱི།",
    "ཕྱི་མའི་ཡང་ཕྱི་མའི་རྒྱུད་ལས་འདི་ཁོ་ན་བཞིན་དུ་གསུངས་པའི་ཕྱིར་རོ།",
    "འདི་ལྟར་ཕྱོགས་གཉིས་པ་འདི་ཕྱི་མའི་ཡང་ཕྱི་མའི་རྒྱུད་འབའ་ཞིག་པས་གསུངས་པར་ཟད་ཀྱི།",
    "དུས་བསྟན་པ་ཁོ་ནར་རིགས་པར་ཟད་ཀྱི།",
    "འདིར་རིགས་པ་སྟེང་དུ་འབབ་པར་ཡང་ངེས་པ་མེད་ན།",
    "དག་བརྗོད་པས་ཁོང་དུ་ཆུད་པར་བྱ་དགོས་ན།",
    "ཇི་ལྟར་ཤེས་པར་བྱ་བ་ཡིན་ཞེ་ནསྨྲས་པ།",
    "གསང་སྔགས་རང་བཞིན་གྱིས་གྲུབ་པའི་མཐུ་དང་ཡོན་ཏན་ཁྱད་པར་ཅན་ཡོད་པར་འདོད་པས་དེ་བཞིན་དུ་བསྟན་པའོ།",
    "བདེ་བ་ཆེན་པོ་ཞེས་པ་འདིར་ཡང་དེ་ཉིད་ཀྱི་མཚན་ཉིད་དུ་རིག་པར་བྱ་སྟེ།",
    "མཐུ་བསྟན་པའི་སྒོ་ནས་ཞེས་པ་དེ་ལྟ་བུའི་དོན་དང་ལྡན་པ་དེའི་མཐུ་བསྟན་པ་སྟེ་རྒྱུད་ལས་དེ་ལྟར་གསུངས་པའོ།",
    "དེ་ལྟར་དོན་རྣམ་པ་གཉིས་ཀྱི་རིམ་པའི་རྣམ་པས་དམ་ཚིག་སེམས་དཔའ་བདག་ཉིད་ལྷའི་རང་བཞིན་དུ་བྱིན་གྱིས་བརླབ་པ་ལ་སོགས་པའི་ཆོ་ག་ཚང་བར་བྱས་ནས།",
    "འདིར་ཡང་དེ་ཁོ་ནས་སེམས་ཡོངས་སུ་སྦྱང་བར་གསུངས་སོ།",
    "གནས་སྐབས་སམ་རིམ་པ་ཇི་ལྟར་རྣམ་པར་གཞག་པར་འདོད་ཅེ་ན་སྨྲས་པ།",
    "སྣ་ནས་དབུགས་འབྱུང་ཞིང་འཇུག་པའི་མཚན་ཉིད་དུ་འདོད་དེ་ཞེས་གསུངས་སོ།",
    "འོ་ན་དབྱིབས་ཇི་ལྟ་བུར་བརྟག་པར་བྱ་ཞེ་ན།",
    "འོ་ན་ཁ་དོག་ཇི་ལྟ་བུར་ཤེས་པར་བྱ་ཞེ་ན་སྨྲས་པ།",
    "སྣའི་ཐོག་མར་ཞེས་གསུངས་སོ།",
    "ཇི་ཙམ་གྱི་བར་དུ་བསམ་༤པར་བྱ་བ་ཡིན་ཞེ་ན།",
    "དབུགས་དལ་བུས་ཕྱུང་ལ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ལ་སེམས་མཉམ་པར་གནས་པའོ་ཞེས་པ་ནི།",
    "མཉམ་པར་གནས་པ་དང་རྗེས་སུ་མཐུན་པ་ཞེས་བྱའོ།",
    "ཕྱག་རྒྱ་ཆེན་པོའི་སྦྱོར་ངགོམས་པར་བྱས་པ་ལས་བྱུང་བའི་དངོས་གྲུབ་བོ།",
    "ཏིང་ངེ་འཛིན་འདི་གོམས་པར་བྱ་བའི་ཐབས་ཀྱི་རིམ་པ་མངོན་དུ་བསྒྲུབ་པར་བྱ་བའོ་། ཡེ་ཤེས་ཕྱག་རྒྱ་བཅིང་བར་བྱ།",
    "རྒྱུད་༥༤༡༥༨བྱ་དགོས་པར་སྟོན་པས་དོན་དེ་བརྟག་པར་བྱ་ཞེས་སྟོན་ཏེ།",
    "ཇི་ལྟར་བསྒྲུབ་པ་རྗེས་སུ་དྲན་པར་བྱས་ལ་ཞེས་པ་ནི།",
    "མཉམ་པར་གཞག་པའི་རིམ་པ་ཞེས་པ་ནི།",
    "སེམས་རྩེ་གཅིག་པའི་ངང་དུ་གནས་པར་བྱ་བ་དང་།",
    "རྟགས་དེ་ཉིད་དང་ལྡན་པར་གྱུར་པའི་ཚོར་བའོ།",
    "སེམས་ཁུགས་པར་གྱུར་པའི་མཚན་མ་བྱུང་བའོ།",
    "སེམས་དེ་ཀུན་དུ་འཕྲོས་པར་བྱ།",
    "དེའི་རྗེས་སུ་སེམས་འཇུག་པར་བྱ་ཞེས་སྨོས་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "སྥ་ར་ཎ་བཛྲ་ཞེས་པ་རྡོ་རྗེ་འཕྲོས་ཤིག་ཅེས་པའོ་། འོ་ན་དེ་ལྟར་བྱ་བ་དེ་ཚད་ཇི་ཙམ་དུ་བསམ་པར་བྱ་ཞེ་ནསྨྲས་པ།",
    "དེ་ནས་དེ་ལྟར་ཡུན་རིང་དུ་བསམས་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "མི་གཙང་བ་ཞེས་པ་ནི།",
    "འདོད་ཆགས་ཅན་གང་དག་གཙང་བར་ལྟ་བའི་གཉེན་པོའོ།",
    "ཕྱོགས་གཅིག་ཏུ་རྣམ་པར་བཅད་པ་རྣམས་ཀྱི་གཉེན་པོར་བསྟན་པའོ།",
    "འདིར་བརྗོད་པ་འདི་དག་མི་མཐུན་པར་སྣང་བ་ལ་ཅིའི་ཕྱིར་མི་མཚུངས་པར་འདོད་ཅེ་ན།",
    "དེ་རྣམས་ཀྱིས་ཀྱང་སེམས་མཉམ་པར་གནས་པར་བྱ་བཇི་ལྟར་འདོད་པར་བྱས་ན་འགལ་བ་མེད་དོ་ཞེས་གསུངས་ཏེ།",
    "སེམས་མཉམ་པར་གནས་པའི་རྒྱུར་ཡང་འགྱུར་རོ་ཞེས་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ཉིད་བསམ་པ་ཤེས་རབ་ཀྱི་རང་བཞིན་ཅན་བདག་ཉིད་ལ་གཞག་ཅིང་བསམ་པར་བྱ་བའོ།",
    "དེའི་ཞོར་ལ་ཕྱིའི་ཡུལ་རྣམས་ཀྱང་མ་གྲུབ་པར་རྟོག་པ་སྟེ།",
    "མི་གཙང་རྐྱེན་ལས་བྱུང་བས་ན།",
    "རྐྱེན་ཕ་མ་ལས་བྱུང་བའི་ཁུ་ཁྲག་རབ་ཏུ་མི་གཙང་བ་ལས་བྱུང་བས་ན།",
    "རྐང་མཐིལ་བར་དུ་ཁྱབ་པར་བསམ་། ཞེས་བྱ་སྟེ།",
    "རྣལ་འབྱོར་པས་ཞེས་པ་ནི་རྣལ་འབྱོར་པའི་ཤེས་རབ་ཀྱིས་དེ་ལྟར་རྟོགས་པར་བྱ་ཞེས་པའི་ཐ་ཚིག་གོ།",
