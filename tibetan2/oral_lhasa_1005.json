    "སོ་སོའི་ལས་ཀྱི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་སོ་སོའི་གནས་སུ་བཞུགས་པར་བྱའོ།",
    "ཕྱག་མཚན་གྱི་མཚན་མས་ལེགས་པར་མཚོན་པ།",
    "ད་ནི་དེ་ལྟར་བསྒོམས་པའི་བསམ་གཏན་གྱི་སྦྱོར་བ་ལ་གནས་པ་དེ་དག་ཕྱག་རྒྱ་བཞི་དང་མ་ལྡན་ན་མངོན་དུ་སྣང་བའི་གཟུགས་འགྲུབ་པར་མི་འགྱུར་བས།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་ལས་མཐོང་བ་དག་མཚན་ཉིད་མི་མཐུན་པར་འགྱུར་བ་ཡོད་ན།",
    "དེ་བས་ན་མཚན་ཉིད་གཞན་དུ་སྲིད་ཅེས་པ་ནི་ཕྱག་རྒྱ་དེ་དག་མཚན་ཉིད་མི་མཐུན་པར་སྟོན་ནམ་འབྱུང་སྲིད་ཀྱང་རྣམ་པར་བརྟག་པར་མི་བྱ་ཞེས་པ་ནི་ཐེ་ཚོམ་གྱི་རྣམ་པར་རྟོག་པ་ཟ་བར་མི་བྱ་སྟེ།",
    "བྱས་པར་འགྱུར་ན་རྣམ་པར་རྟོག་པ་ལ།",
    "མཐའ་ཐུག་པ་མེད་པའི་ཕྱིར་རོ་ཞེས་ཏེ་རྣམ་པ་རྟོག་པ་ལ་ཟད་པ་དང་ཐུག་པ་མེད་པར་འགྱུར་བས་ན།",
    "ལྷའི་རྣལ་འབྱོར་ལ་གནས་པའི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཉིས་སུ་མེད་པར་སེམས་པའོ།",
    "སྒོ་གསུམ་ལྷའི་རང་བཞིན་ལས་མི་ཞན་པར་བྱས་སོ།",
    "ཕྱག་རྒྱ་ལ་སོགས་པའི་རང་བཞིན་དུ་འགྱུར་ཞེས་པ་ནི་སྒོ་གསུམ་ཕྱག་རྒྱ་བཞིའི་རང་བཞིན་དུ་གནས་པར་གྱུར་པས།",
    "ལུས་ཀྱི་སྒོ་ནས་བསྒུལ་བསྐྱོད་བྱས་སོ་ཅོག་ཐམས་ཅད་ནི་ཕྱག་རྒྱ་ལ།",
    "དེ་བས་ན་མཚན་ཉིད་ཉེས་པའི་དོགས་པ་མི་བསྐྱོད་དོ་ཞེས་པ་ནི་མི་མཐུན་པ་ལྟར་སྣང་བ་དེ་ལ་འགལ་བར་འགྱུར་བའི་དོགས་པ་བསྐྱེད་པར་མི་བྱའོ་ཞེས་སྟོན་ཏོ།",
    "བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ནི་ཐམས་ཅད་རྟག་པ་དང་ལྡན་པའི་ངོ་བོ་བས་ན།",
    "རྩ་བའི་རྒྱུད་དེ་ཁོ་ན་བསྡུས་པ་ལས་གསུངས་ཏེ།",
    "རྣམ་པར་སྣང་མཛད་དང་པོར་སྨོས་པའི་འོག་ཏུ་བྱུང་བའོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཇི་ལྟར་འདི་ལྟར་སྟོན་པར་བྱེད་ཅེ་ན།",
    "འདི་ཉིད་ལས་གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ལ་སོགས་པར་ཞེསབྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པའི་ཚིག་གསུངས་ཏེ།",
    "གལ་ཏེ་འདིར་རྟག་༤པའི་ཕྱག་རྒྱ་ཕྱི་མའི་ལྔ་པར་དགོངས་པར་གྱུར་ན་ཞེས་པ་གལ་ཏེ་སྒྲུབ་ཐབས་འདིར་རྟག་པའི་ཕྱག་རྒྱ་ཕྱི་ནང་གསུངས་པ་དེ་ཡིན་པར་འདོད་ན།",
    "ཕྱག་རྒྱའི་མིང་རྡོ་རྗེ་ལས་མ་ཞེས་གདགས་པར་མི་རིགས་ཏེ།",
    "དང་པོར་རྡོ་རྗེ་སེམས་མ་ཉིད་ལས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པའོ།",
    "རྡོ་རྗེ་བཅིངས་པ་ཁ་ཐུར་དུ་བསྟན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པའོ།",
    "དེ་ལ་ལས་ཀྱི་ཕྱག་རྒྱ་ཞེས་པ་ནི་དེ་བཞིན་གཤེགས་པ་ལ་སོགས་པ་མཉེས་པར་བྱ་བ་དང་།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གློ་གཡོན་པར་།",
    "བྱང་ཕྱོགས་ཀྱི་སེམས་དཔའ་བཞིའི་ལས་ཀྱི་ཕྱག་རྒྱ་ནི་། རྡོ་རྗེ་ཁུ་ཚུར་གཡོན་པ་མདུན་དུ་བཀན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་མཐའ་ལྟག་གཉིས་སུ་གཞག་ཅེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པའོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཁ་ཐུར་དུ་བསྟན་ཏེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་པའོ།",
    "ཞེས་བྱ་བའི་ཚིག་གསུངས་ཏེ།",
    "ཀུན་རྫོབ་ཏུ་རྣམ་པར་སྣང་མཛད་དང་།",
    "ཐུགས་རྗེས་སུ་ེའགྲོ་བ་ལ་ཆགས་པའི་བདེ་བ་ཆེན་པོ་དེ་ལ་དམ་པར་བྱེད་པ་རྡོ་རྗེ་ཆགས་པའོ།",
    "ཤེས་རབ་ཀྱི་རལ་གྲིས་སྡུག་བསྔལ་ཐམས་ཅད་གཅོད་པར་བྱེད་པ་སྟེ།",
    "ཟོ་ཤིག་ཅེས་པའི་དོན་ཏེ་ཟོས་པ་ཉིད་ཟད་པར་བྱེད་པ་ཡིན་པའི་ཕྱིར་རོ།",
    "རྒྱུད་༥༤༡༥༤༢པ་ནི་རྣམ་པར་དག་བྱེད་ཅེས་འབྱུང་སྟེ་གང་ཞེ་ན།",
    "སྒྲུབ་པ་དང་བསྒྲུབ་བྱ་གཉིས་སུ་མེད་པར་འཆིང་བ་སྟེ་རྡོ་རྗེ་ལྕགས་ཀྱུ་མའོ།",
    "སེམས་དཔའ་ཆེན་པོ་བཅུ་དྲུག་ལ་སོགས་པ་མ་ལུས་པ་སྡུད་པར་བྱེད་དོ།",
    "ལྷ་དེ་དག་ལ་སོ་སོར་ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་བྱིན་གྱིས་བརླབ་དགོས་པས་ན།",
    "འོ་ན་གཞན་དག་ལ་ནི་འདི་ལྟར་གསུངས་པའི་ཕྱག་རྒྱ་འདི་དག་སྦྱར་དགོས་སམ་ཞེ་ན།",
    "གང་ཡང་ཕྱག་རྒྱ་བཞིའི་དཀྱིལ་འཁོར་ལ་སོགས་པར་བཀོད་པ་ཞེས་བྱ་བ་ལ་སོགས་པ་དག་སྟེ་སོགས་ཀྱི་སྒྲས་ནི།",
    "ཁྱད་པར་དུ་ནི་ཕྱག་རྒྱ་བཞི་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་དག་གསུངས་ཏེ།",
    "དེའི་ཁྱད་པར་ནི་ཕྱག་རྒྱ་བཞི་པ་དང་།",
    "ཅིའི་ཕྱིར་དེ་ལྟར་བསམ་པར་བྱེད་ཅེ་ན།",
    "སོགས་པའི་སྒྲས་ནི་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བ་ལ་སོགས་པའི་དཀྱིལ་འཁོར་ལྷག་མ་རྣམས་ཀྱང་དེ་བཞིན་དུ་ཤེས་པར་བྱ་བར་སྟོན་པའོ།",
    "དེ་ལྟར་བྱས་ན་ཞེས་པ་ནི་གོང་དུ་བསྟན་པ་སྟེ།",
    "དེ་བཞིན་གཤེགས་པས་འཁོར་ལ་གསུངས་པའི་ཚིག་སྟེ།",
    "བདག་དབུལ་བ་སྟེ་བཅུ་དྲུག་པོ་འདི་རྣམས་བྱའོ་ཞེས་ལས་ཀྱི་དཀྱིལ་འཁོར་ལས་གསུངས་པའི་དོན་དེ་འདིར་བྱས་པར་འགྱུར་བ་ཡིན་ནོ།",
    "གཙོ་བོར་གྱུར་པ་མཉེས་པར་བྱེད་པའི་ལྷ་ཞེས་པ་ནི་དེ་བཞིན་གཤེགས་པའི་གཙོ་བོའོ།",
    "བྱིན་གྱིས་བརླབ་པ་སྔར་བྱས་ཏེ་ཞེས་པ་ནི་ལྷ་གང་དམིགས་པ་དེ་ལ་སྔར་ཕྱག་རྒྱ་བཞིས་བྱིན་གྱིས་བརླབ་པ་བྱས་ལ།",
    "བཟླས་བརྗོད་ཀྱིས་མཉེས་པར་བྱ་བའི་ཆོ་ག་བྱའོ།",
    "ཞེས་གསུངས་ཏེ།",
    "དེ་ཁོ་ན་ཉིད་བསྡུས་པའི་རྒྱུད་འདི་ཉིད་དུ་ཤེས་པར་བྱའོ།",
    "ཉན་ཐོས་དག་ཡིན་ན་དེ་དག་ནི་དམན་པར་གྱུར་པ་དང་།",
    "འདིར་ནི་དེ་ཁོ་ན་ཉིད་བསྡུས་པ་ལས་གསུངས་པའི་རིམ་པས་ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་བསྒོམ་མི་ནུས་པ་དེ་དག་ལྟ་བ་ངན་ཞིང་ཆགས་པ་མེད་པར་དགོངས་པ་སྟེ།",
    "བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "སེམས་བརྟན་པར་བྱ་བའི་ཕྱིར་ཡང་ནས་མ་མ་ཡང་དུ་མནོད་པར་བྱ་སྟེ།",
    "དེ་ལ་སེམས་བརྟན་པར་བྱ་བ་ནི་སྡོམ་པ་མནོས་པའི་སེམས་དེ་མི་རྙིངས་ཤིང་དྲན་པ་རྩེ་གཅིག་པར་འགྱུར་བར་བྱའོ།",
    "དེ་ལ་སྡོམ་པ་མནོད་པའི་རིམ་པ་ནི་འདིའོ་ཞེས་པ་ནི་དེ་བཞིན་གཤེགས་པ་ལྔ་པོ་རྣམས་ཀྱི་སྡོམ་པ་རིམ་པར་གཟུང་བའི་ཚིག་༧བརྗོད་པ་སྟེ།",
    "འཁྲ་ས་མེད་པ་རྣམས་ཀྱི་འཁྲ་ས་ཞེས་བྱ་བ་ལ་སོགས་པ་རྒྱ་ཆེར་གསུངས་པའི་ཕྱིར་རོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ནས་སྡོམ་པ་ཇི་ལྟར་མནོས་པའི་དོན་གྲུབ་པར་བྱ་བའི་ཕྱིར་ཞེས་པ་ནི།",
    "སོགས་ཀྱིས་བཟླས་བརྗོད་ལ་སོགས་པའི་ལས་གཞན་སྡུད་པར་བྱེད་དེ།",
    "དེ་ལྟར་རིགས་སོ་ཞེས་སློབ་དཔོན་སྔར་བྱུང་བའི་མཁས་པ་རྣམས་ཀྱིས་གསུངས་སོ།",
    "འདི་དག་པས་ལྷག་པས་ཀྱང་ངེས་པར་དབུལ་ལོ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཁྱད་པར་དུ་ཡང་ཕྱི་མའི་ཡང་ཕྱི་མའི་རྒྱུད་ལས་གསུངས་པའི་མཚན་བརྒྱ་རྩ་བརྒྱད་པས་ནི་དེ་བཞིན་གཤེགས་པ་རྣམས་ལ་བསྟོད་པར་བྱའོ།",
    "དེ་བཞིན་གཤེགས་པ་གཙོ་བོར་བྱས།",
    "དེའི་འཁོར་དུ་གྱུར་པ་རྣམས་ལ་བསྟོད་པར་བྱའོ།",
    "འགྱུར་བ་ཞིག་ཡིན་ན་ནི་དེའི་དོན་ཀུན་དུ་བརྗོད་པར་བྱས་ཟིན་ལ།",
    "གལ་ཏེ་དེ་ལྟར་མ་ཟིན་ན་ནི་ཀུན་གྱིས་འབྱ་བར་མི་ནུས་པ་དེ་འདི་དག་ཁོ་ནས་འགྲུབ་པར་འགྱུར་རམ་ཞེ་ན།",
    "བདག་ཉིད་དམ་ཚིག་སེམས་དཔར་བསྒྱུར་བ་ལ་བྱ་སྟེ།",
    "ཟིལ་གྱིས་མི་ནོན་ཅིང་ཞེས་པ་ནི་བདག་ཉིད་དམ་ཚིག་སེམས་དཔའ་དེ་གཞན་གྱི་ཟིལ་གྱིས་མི་ནོན་པར་བྱ་བའི་ཕྱིར།",
    "འི་༥༤༡༥༥༢དོན་བསམ་པ་དེ་གྲུབ་པར་གསོལ་བ་གདབ་པོ།",
    "ཇི་ཕྱག་རྒྱ་ཆེན་པོ་དག་གོང་དུ་བསྟན་པའི་རིམ་པར་བསྟན་ཅིང་ཡོན་ཏན་གྱི་ནུས་པ་ཡང་བརྗོད་པར་བྱས་ཟིན་ན།",
    "ཡང་འདིར་སྟོན་པར་བྱེད་པ་ཅི་ལ་དགོས་པའི་ཕྱིར་སྟོན་པར་བྱེད་ཅེ་ནསྨྲས་པ།",
    "འདིར་ཕྱག་རྒྱ་བཞིའི་སྦྱོར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལག་པ་གཡས་གཡོན་གཉིས་ལ་ཟླ་བའི་དཀྱིལ་འཁོར་གནས་པའི་སྦྱོར་བ་བྱས་ལ།",
    "དེ་ཉིད་སྦྱར་བ་ནི་དབྱིངས་དང་ཡེ་ཤེས་སམ་ཐབས་དང་ཤེས་རབ་ཀྱི་རང་བཞིན་དུ་རིག་པར་བྱའོ།",
    "བདག་ལྷག་པར་བརྟན་པར་བྱིན་གྱིས་རློབས་ཤིག་པ་སྟེ།",
    "འདིར་དེ་དང་མཐུན་པར་མི་སྟོན་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "སྔགས་བཞི་པོ་འདི་དག་ཀྱང་སྒྲུབ་ཐབས་གཞན་གྱི་གཞུང་ལས་དང་པོར་ཏིང་ངེ་འཛིན་གྱིས་བསྒྲུབ་པར་བྱ་བའི་དགོས་པ་དེ་ཡོངས་སུ་རྫོགས་པ་ཐོབ་པར་བྱ་བའི་ཕྱིར་དང་པོར་བྱ་དགོས་ཞེས་ཟེར་ན་འདིར་འདིའི་སྐབས་སུ་སྟོན་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "གཉིས་སུ་ན་གོང་དུ་ཏིང་ངེ་འཛིན་གྱི་བསམ་གཏན་མངོན་དུ་བྱས་པའི་དུས་དེ་ནི་འདིའི་བསྒྲུབ་པར་བྱ་བའི་དོན་ཏེ།",
    "དེའི་སྐབས་སུ་ཐོབ་པར་གྱུར་ན་ལེགས།",
    "གལ་ཏེ་དེར་སྔོན་ཐོབ་པར་མ་གྱུར་ན་འདི་ལྟར་བྱས་པས་ཐོབ་པར་འགྱུར་ལ།",
    "གལ་ཏེ་གོང་དུ་ཐོབ་པར་གྱུར་དུ་ཟིན་ཀྱང་།",
    "འདི་ལྟར་ཕྱི་ནས་བྱས་པས་དེ་ཉིད་བརྟན་ཞིང་བྱིན་དང་ལྡན་པའི་ནུས་མཐུ་ཅན་དུ་མཛད་པའི་ཕྱིར་འདི་ལྟར་བསྟན་ཞེས་སོ།",
    "འབྲས་བུ་མངོན་དུ་གྱུར་པ་ཐོབ་པ་ཅི་ཡང་ཡོད་པར་འགྱུར་བ་ཡིན་ནམ་ཞེ་ན།",
    "དེ་ལྟར་བྱས་ན་ཇི་ལྟར་སྤྱན་དྲངས་པའི་བཅོམ་ལྡན་འདས་དང་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ར་པ་བདག་ཉིད་དམ་ཚིག་སེམས་དཔའི་བསམ་གཏན་གྱི་རྣལ་འབྱོར་མངོན་དུ་བྱས་པ་གཉིས་ཡུལ་གཅིག་ལ་སྤྱོད་པ་ཡིན་པར་དགོས་པ་ཉེ་བར་བཞག་ནས་སེམས་མཐུན་པའི་སྒོ་ནས་དངོས་གྲུབ་འདོད་པ་སྩོལ་བར་མཛད་དོ།",
    "རྡོ་རྗེ་སེམས་དཔའ་བསྒྲུབ་པར་བྱ།",
    "ཞེས་པ་ནི་ཡུལ་དེ་བཞིན་དང་ལྡན་པས་དེ་བསྒྲུབ་པར་བྱས་ན་འགྲུབ་པར་འགྱུར་བས་དེ་ལྟར་བྱ་བ་ཡིན་གྱིས།",
    "གཞན་གྱིས་མི་འགྲུབ་པར་སྟོན་ཏོ།",
    "ཡུལ་བཞི་པོ་དེ་ཉིད་ཀྱིས་བསྐུལ་ནསགདན་དུ་བབ་པ་བཞིན་དུ་གྱུར་ནས་མྱུར་བར་རྗེས་སུ་ཆགས་པར་བྱས་ནས་མྱུར་དུ་འགྲུབ་པར་འགྱུར་བས།",
    "ཅེས་གསུངས་སོ།",
    "གཞན་རྣམས་ཀྱིས་ནི་འགྲུབ་པར་མི་འགྱུར་རམ།",
    "དེ་ལྟ་ན་ནི་གཞན་རྣམས་ཀྱིས་ཐབས་ཇི་ལྟར་བྱས་པས་འགྲུབ་པར་འགྱུར།",
    "དེ་ལྟར་མ་ཡིན་ན་ནི་འདི་ཁོ་ན་རྗོད་པར་བྱེད་ཀྱིགཞན་རྣམས་ཀྱིས་མི་བརྗོད་པ་ཅིའི་ཕྱིར་ཞེ་ན།",
    "རྡོ་རྗེ་སེམས་དཔའ་ཞེས་བྱ་བ་འདི་ནི་ཉེ་བའི་མཚན་ཉིད་ཀྱི་ཚིག་སྟེ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཟུངས་ལ་སོགས་པ་རྣམ་པར་གྲོལ།",
    "སོགས་ཀྱི་སྒྲས་ནི་དཔའ་བར་འགྲོ་བའི་ཏིང་ངེ་འཛིན་ལ་སོགས་པའི་སྒོ་རྣམས་སྡུད་པར་བྱེད་པའོ།",
    "ཇི་སྐད་དུ་གསུངས་ཤེ་ན།",
    "དེའི་རིགས་ཡོངས་སུ་འཛིན་པར་བྱེད་པས་དེ་སྐད་བྱ་སྟེ།",
    "གཙང་ཞིང་གོས་ཀྱང་གཙང་བ་ཡིན།",
    "རྣམ་པར་མི་རྟོག་པའི་ཏིང་ངེ་འཛིན་དང་ལྡན་པས་རྟོག་པ་ལས་དབེན་པ་དང་།",
    "དྲི་ལ་སོགས་པ་ཕྱི་རོལ་གྱི་ཁྲུས་ཀྱིས་ཡིད་མི་འདག་པར་གྱུར་པ་གསལ་བའོ།",
    "གཙང་མའི་གྲོགས་ཞེས་པ་ཡང་དོན་དེ་ལྟ་བུ་དང་ལྡན་པའམ།",
    "སྡོམ་པ་ཐམས་ཅད་ཀྱི་ནང་ན་དམ་པར་གྱུར་པས་སོ།",
    "ཕྱག་རྒྱ་བཞིའི་སྦྱོར་བ་ལ་རྟག་པར་གནས་པར་བྱ་བའོ།",
    "བཤགས་དང་གསོལ་བ་ལ་སོགས་པ།",
    "དང་པོར་ཕྱག་རྒྱ་བཞི་དང་ལྡན་པར་བསྒོམས་ནས།",
    "ཇི་སྐད་གསུངས་པའི་སྡོམ་པ་གསུམ་པོ་དག་དང་མི་འབྲལ་བར་བྱའོ།",
    "མི་བཟའ་བ་རྣམས་སྤངས་ཞེས་པ་ནི་གཞུང་རྣམས་ནས་མ་གནང་བའི་ཁ་ཟས་དང་བཏུང་བ་རྣམས་དང་།",
    "དྲི་མི་ཞིམ་དང་མི་གཙང་བ།",
