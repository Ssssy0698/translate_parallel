    "དེ་ལྟ་མོད་ཀྱི་གནས་དང་འཁོར་ལ་སོགས་པ་རྣམ་པར་གཞག་པ་ཅི་ལྟར་ཞེ་ན་གསུངས་པ།",
    "གང་གིས་ཡོངས་སུ་འཆིང་འགྱུར་བ།",
    "གསུངས་པ་རང་གི་ས་བོན་ཞེས་པ་ལ་སོགས་པ་སྟེ།",
    "ཉིད་ཀྱི་སྐུ་ནི་རང་གི་ཕུང་པོའོ།",
    "གནས་སྐབས་སྔ་མ་ཞེས་པ་ནི་བུད་མེད་དང་།",
    "བུད་མེད་ཀྱི་གཟུགས་ཞེས་པ་ནི་བུད་མེད་ཀྱི་གཟུགས་ཉིད་དུ་དེ་རྣམས་ཉིད་ཕྱུང་བའོ་ཞེས་འཆད་པར་འགྱུར་བ་ཉིད་ཀྱི་ཕྱིར་རོ།",
    "མི་བསྐྱོད་པ་ནི་རེག་བྱའི་ངོ་བོ་ལྟ་བུའོ་ཞེས་པའི་གསུང་ལས་སོ།",
    "གཟུངས་ཀྱི་དཀྱིལ་འཁོར་ཞེས་པ་ནི་ལྷ་མོའི་འཁོར་ལའོ།",
    "ཤེས་རབ་ནི་བཙུན་མོའོ།",
    "ལྷ་རིང་དུ་སོང་བ་དང་།",
    "སྤྱོད་བསྡུས་ལེའུ་དང་པོར་ཡང་གང་གི་ཚེ་སྒྱུ་མ་ལྟ་བུའི་ཏིང་ངེ་འཛིན་ལ་སྙོམས་པར་འཇུག་པ་དེའི་ཚེ།",
    "སྔར་བསགས་པའི་ཉོན་མོངས་པ་མ་ལུས་པ་འཇིག་པའི་ཕྱིར་དང་།",
    "དྲི་མ་མེད་པ་ནི་ཉོན་མོངས་པའི་རྡུལ་མ་ལུས་པ་དང་།",
    "འདོད་ཆགས་ལ་སོགས་པའི་ཉོན་མོངས་པ་ལ་ཕྱིར་ཕྱོགས་པ་ལས་སོ།",
    "ཀྲུང་གོའི་བོད་རིག་པ་ཞིབ་འཇུག་ལྟེ་གནས་ཀྱི་བཀའ་བསྟན་དཔེ་སྡུར་ཁང་གིས་དཔེ་བསྡུར་ཞུས།",
    "ཨ་མྲ་སྐྱོང་མའི་ན་གས་གཟིགས་པའི་ལེའུ།་",
    "ལོ་ཙཱ་བ་དགི་སློང་ཀླུའི་རྒྱལ་མཚན་གྱིས་བསྐྱུར་ཅིང་ཞུས་ཏེ་གཏན་ལ་ཕབ།",
    "༣༣༥བསྡུར་འབྲས་རེའུ་མིག་༣༣༩༣༣༨",
    "༤༢༦བསྡུར་འབྲས་རེའུ་མིག་༤༤༦༣༣༩ རྨི་ལམ་ཡིད་བཞིན་ནོར་བུའི་ག་ཏམ།་",
    "༤ས་བསྡུར་འབྲས་རེའུ་མིག་༤སཞ་༣༣༩༡ སྦྱིནོ་པའི་གཏམ།་",
    "༤༧༢བསྡུར་འབྲས་རེའུ་མིག་༤༧༢༣༣ ༢ སྲིད་པ་ལས་འད་ས་པའི་གཏམ།་",
    "༤༧༥བསྡུར་འབྲས་རེའུ་མིག་༤༧༥༣༣༩༣ ཡོན་ཏན་བདུན་ཡོང་ས་སུ་བརྗོད་པའི་གཏམ།་",
    "བསྡུར་འབྲས་རེའུ་མིག་༤༧",
    "༤༡༣བསྡུར་འབྲས་རེའུ་མིག་༤༤༣༣ ༦ ཚོགས་ཀྱི་གཏམ།་",
    "༤༨བསྡུར་འབྲས་རེའུ་མིག་༤༨༣༣ཞ་༢ མི་ཁོམ་པ་བརྒྱད་ཀྱི་གཏམ།་",
    "ཞུ་ཆེན་གྱི་ལོ་ཙཱ་བ་དགི་སློང་ཤཱཀྱ་འོད་ཀྱིས་བསྒྱུར།",
    "༤༨ཞ་བསྡུར་འབྲས་རེའུ་མིག་༤",
    "ཕྱག་གི་གཏམ།་",
    "ཞིང་གི་གཏམ།་",
    "༥༢༢བསྡུར་འབྲས་རེའུ་མིག་༥༢༤་༣༣༩",
    "༥༣༡བསྡུར་འབྲས་རེའུ་མིག་༥༣༢༣༤ ཅིད་པ་འདུས་༤ གཏམ།་",
    "༥༣༦བསྡུར་འབྲས་རེའུ་མིག་༥༣༦༣༤༡ དོཔནོཔ་འགཏམ།་",
    "༥༤༤ བསྡུར་འབྲས་རེའུ་མིག་༥༤༧བ་",
    "༥༥བསྡུར་འབྲས་རེའུ་མིག་༥༥",
    "༦༢༣བསྡུར་འབྲས་རེའུ་མིག་༦༢༨༣༤༦ ད་གེ་བ་བཅུ་འི་ལས་ཀྱི་ལམ་བསྟནོ་པ།་",
    "བོད་ཀྱི་ལོ་ཙ་བ་ད་གེ་སློང་ཚོས་ཀྱི་ཤེས་རབ་ཀྱིས་བསྐྱུར་ཅིང་ཞུས་ཏེ་གཏན་ལ་ཕབ།",
    "༦༤༤ བསྡུར་འབྲས་རེའུ་མིག་༦༤༧༣༤༨ མི་དོག་བ་བཅུའི་ལས་ཀྱི་ལམ་བསྟནོ་པ།་",
    "༦༤བསྡུར་འབྲས་རེའུ་མིག་༦༤",
    "༦༦༣བསྡུར་འབྲས་རེའུ་མིག་༦༦༤ད་གེ་སློང་ད་གོན་པ་པས་མཛད།",
    "༧༤༧བསྡུར་འབྲས་རེའུ་མིག་༧༤༨༣༤༡༧ བུལསྤྲངབ་༧༤ཞཔཅི་ཏ་མཁས་པ་ཆེན་པོ་སད་ཛ་ན་ཆེན་པོས་མཛད།",
    "༧༦༣བསྡུར་འབྲས་རེའུ་མིག་༧༦༣༣༤༡",
    "༢༤ བསྡུར་འབྲས་རེའུ་མིག",
    "༤༢བསྡུར་འབྲས་རེའུ་མིག",
    "༥༣བསྡུར་འབྲས་རེའུ་མིག་༥༥༣༤༢་༥ ད་ད་སྐྱེད་སྒྲོན་མ་བཞུགས་སོ།་",
    "༦༢བསྡུར་འབྲས་རེའུ་མིག",
    "ཞ་༧༧བསྡུར་འབྲས་རེའུ་མིག",
    "བསྡུར་འབྲས་རེའུ་མིག",
    "བསྡུར་འབྲས་རེའུ་མིག་༡༣༤༢",
    "༡༢༢བསྡུར་འབྲས་རེའུ་མིག་༡༢༥༣༤༣ བསྟན་པའི་གཏད་རབས་བཞུགས་ས་སོ།་",
    "༡༢ཞ་བསྡུར་འབྲས་རེའུ་མིག་༡༢་",
    "༡༤༢བསྡུར་འབྲས་རེའུ་མིག་༡༤",
    "བསྡུར་འབྲས་རེའུ་མིག་༡༡༦སྟོ་༣༣༨༦། ར།",
    "བུདྡྷ་ཙ་རི་ཏ་༢མ་ཧཱ་ཀཱ་༢བྱ་ནཱ་མ།",
    "ནུས་མཐུ་རྗེས་མཚུང་ས་གཟི་བརྗིད་ལྷ་མོ་བདེ་སོགས་དང་།",
    "ལྷ་དང་རབ་ཏུ་མཚུངས་པ་དེ་ཡི་ལྷ་མོ་དེ།",
    "རབ་ཏུ་བལྟམ་༤པའི་དུས་ནི་ཡང་དག་མངོན་གཟིགས་ཤིང་།",
    "བླ་རེ་ཉེ་བར་ཕུལ་བའི་གཟིམས་མལ་རབ་ཐོབ་སྟེ།",
    "བརྟུལ་ཞུགས་ལེགས་པར་འདུས་བྱས་ལྷ་མོ་དེ་ཡི་ནི།",
    "རི་བོང་གིས་མཚན་ཇི་ལྟར་མིག་དག་འཕྲོགས་༤པར་གྱུར།",
    "དེ་ནི་རང་གི་ལུས་ཀྱི་འོད་རབ་འབར་བ་ཡིས།",
    "འདི་ནི་བད་ག་གི་སྲིད་པའི་སྐྱེ་བ་ཐ་མ་ཞེས།",
    "སེང་གེའི་འགྲོས་འདྲ་ཕྱོགས་བཞི་དག་ཏུ་རྣམ་གཟིགས་ནས།",
    "གང་གི་མཐུ་ལས་མགོ་བོ་ཡིས་ནི་རབ་བཏུད་ཅི་ང་།",
    "གང་གིས་རབ་ཏུ་བལྟམས་ཚེ་རི་རྒྱལ་ཕུར་བུ་ཉིད།",
    "ཤར་ད་ང་བྱང་གི་མཚམས་ཀྱི་ཁང་པའི་ཕྱོགས་གཅིག་ན།",
    "མི་བདག་བརྟན་པ་ཡིན་ཡང་རྣམ་པར་འགྱུར་ནས་ས་སོང་།",
    "ལྷ་མོ་འཇིགས་པ་དང་ནི་དགའ་བས་གང་བར་འགྱུར་༢།",
    "བུད་མེད་རྒན་མོ་རྣམས་ཀྱིས་༤བདེ་ལེགས་གྱུར་བྱས་ཤིང་།",
    "ཁྱོད་ཀྱི་སྒྲོན་མ་འདི་ནི་རིགས་ཀྱི་སྒྲན་མ་སྟེ།",
    "འདི་༢ནི་ཁྱོད་ཀྱི་བུ་ཞེས་སྐྱེས་པར་གྱུར་པ་སྟེ།"
  ]
}