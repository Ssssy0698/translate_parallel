    "འགྲོ་བ་རིགས་དྲུག་གི་སྤྱོད་ཡུལ་དུ་འཁྲུལ་ལོ་གསུངས།",
    "ཡང་གཡུང་དྲུང་ལྷ་ཡི་རྨུ་ཐག་རིང་མོ་འདིས།",
    "མ་རིག་པས་རྒྱུ་བྱས་ནས་གཞི་ཡི་གནས་ཚུལ་ལ་ཕྱིན་ཅི་ལོག་ཏུ་ཞུགས་ནས་སེམས་རྣམ་རྟོག་གིས་ཀུན་ནས་བསྒྲོགས་པ་ཡིན་ནོ།",
    "ལྷ་མོའི་ཕ་ཡུལ་འཇིག་རྟེན་འདི་མིན་མོད།",
    "ལྷ་མོའི་ཕ་ཡུལ་བདེ་སྡུག་རེ་དོགས་སྤྲོས་པ་མང་བའི་འཇིག་རྟེན་འདི་མ་ཡིན་མོད་ཀྱང་།",
    "དཔེ་འདིས་ངོ་བོ་ལ་ཚ་བ་མ་གྲུབ་ཀྱང་སྡུག་བདེན་ལུས་ཀྱི་ཕུང་པོ་འདི་ཉིད་མ་དོར་བར་སེམས་ཀྱི་མྱོང་ཚོར་ལའང་ཟད་མཐའ་མེད་པར་ལུས་ཀྱིས་མྱོང་བར་བསྟན་སྙམ།",
    "ཐག་པ་འདི་དེ་ཉིད་དུ་ཆད་ན་མྱ་ངན་ལས་འདས་པས་ཤིན་ཏུ་ལེགས་ཏེ་སྡུག་བསྔལ་མཐའ་དག་ཟད་མོད་ཀྱང་།",
    "གསུངས་པ་འདི་ལ་ཡང་ཡིད་ཆེས་སྐྱེ་དགོས་པ་ཞིག་རེད།",
    "རང་གི་འདོད་པ་དང་དུ་བླང་བར་བྱ།",
    "དེ་བཞིན་དུ་ཕྱི་རོལ་གྱི་བྱ་དངོས་མཐའ་དག་འཕེལ་རིམ་ལ་ལྟོས་པའི་རྣམ་པར་ཤེས་པ་ཡང་ཉིན་བཞིན་ཇེ་རྒྱས་སོང་ཡོད།",
    "འཇིག་རྟེན་པ་དག་གིས་ཐོག་མར་ཉོན་མོངས་པའི་ཚེར་མ་རྣམས་སྐྱེད་བསྲིང་བྱས།",
    "སླར་ཡང་འདི་དག་གིས་སྡུག་བསྔལ་སྐྱེད་སྐབས་ཚེར་མའི་རྩེ་མོ་རེ་རེ་བཞིན་དུ་འགོག་པའི་སླད་དུ་ཤེས་བྱ་རིག་པའི་ལས་ཀྱི་རྣམ་གྲངས་རེ་རེ་བསླབ་ཀྱི་ཡོད།",
    "ནང་སེམས་རྒྱུད་ཀྱི་ཉོན་མོངས་འདི་དག་མ་ཞི་བར་བདེ་བ་མི་ཐོབ་གསུངས་པ་བཞིན་ནོ།",
    "དེས་ན་འདོད་ཆགས་ཞེ་སྡང་གཏི་མུག་གི་སྡུག་བསྔལ་གྱི་ཚེར་མ་འགོག་པའི་ཕྱིར་འཇིག་རྟེན་པ་རྣམས་ཀྱིས་མི་འདོད་བཞིན་ཁྲལ་ལྟར་བསྟེན་པའི་ལས་འདི།",
    "དེ་ཡང་དཔེ་གོ་བདེ་བ་ཞིག་བཀོད་ན་འཇིག་རྟེན་པ་རྣམས་ཀྱི་ཞེ་སྡང་གི་སྡུག་བསྔལ་སེལ་ཕྱིར་གཞན་ཉམས་རྒུད་སོང་ནས་རང་ཉིད་རྒྱལ་ཁ་ཐོབ་པ་དེ་ཡིན་པས་དེའི་ལས་ལ་འབད་པ་བཞིན་ནོ།",
    "མྱུར་མགྱོགས་ཀྱི་ཤུགས་དང་ལྡན་པ་རི་བྲག་སོགས་ལ་ཐོགས་མེད་དུ་རྒྱུ་བ་མཁའ་དང་མཉམ་པའི་གསལ་རིག་སེམས་ཀྱི་ཆ་ཤས་གཅིག་སྟེ་ཉོན་མོངས་པ་རྩ་ཉོན་སོགས་ཀྱི་ངོ་བོར་གྱུར་བ་ཞིག་ཤ་དང་ཁྲག་ལས་གྲུབ་པའི་ལུས་ཀྱི་འདམ་དུ་ཚུད་པ་ན།",
    "གཟོད་ཚ་གྲང་བཀྲེས་སྐོམ་རེ་དོགས་འཇིགས་སྐྲག་གི་སྡུག་བསྔལ་འདི་ལ་ཟད་མཐའ་མེད་པ་སྙམ།",
    "རེ་དོགས་སྤྲོས་དང་བྲལ་བ་ཕ་རྒན་པོའི།",
    "མདུན་ལམ་སྣང་བར་བྱེད་པ་ཁྱོད་ཁོ་ན།",
    "དཀོར་དང་ནོར་གྱིས་དབུལ་བའི་སློང་མོ་བ།",
    "ཡ་ཡོ་འཁྱོག་པོའི་འཕེལ་འགྲིབ་མེད་སྙམ་ཡང་།",
    "ལྷ་རེག་དཀར་པོས་ཞུ་སྣ་བྱེད་ལས་ཅི།་",
    "དེ་ལ་ཕྱིས་ཀྱི་མཁས་པ་ཁ་ཅིག་གིས།",
    "མཚན་དང་དཔེ་བྱད་ཞིང་གི་བཀོད་པ་སོགས་ཀྱང་།",
    "ཞེས་གསུངས་མི་རིགས་པར་ཐལ་བ་དང་།",
    "ངེས་དོན་ནི་འཆད་ཐབས་དང་བྲལ་བ་སྒྲ་རྟོག་གི་ཡུལ་ལས་འདས་པ་ཞིག་ཡིན་སྙམ།",
    "ཇི་ལྟར་སེམས་ནི་གང་གི་རྣམ་པ་ཅན་དུ་གྱུར་པ་དེ་ཡིས་ཡུལ།",
    "བཞག་མི་ཆོག་པར་ཐལ།",
    "འོ་ཅག་གི་རིག་པ་ཅོལ་ཆུང་འདི་ལྟ་བུ་ཞིག་གིས་ཚོད་ག་ལ་འཛིན་ཐུབ།",
    "འོན་ཀྱང་ཁྱོད་ཀྱི་གསང་བ་འདི་ནི་བསྙད་བགྱིད་མ་ལགས་སོ།",
    "དོན་གྱིས་སྟོང་པའི་བྱིས་པ་བདག་གིས་བྱས།",
    "གཟིགས་བྱང་འབྲི་མཁན།",
    "སི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་གིས་བསྐྲུན་ནས་བཀྲམ།",
    "ཤ་པ་ཏ་ཤཱ་ལྟ་བ་ཙ་ན་ཨ་ལམ་ཀ་ར་པུཥ་བ་གི་ཤྭ་ར་སིདྡྷི་ནཱ་མ།",
    "ཚིག་གི་རྗེས་སུ་མི་འབྲང་དོན་གྱི་རྗེས་སུ་འབྲང་བར་བྱའོ་ཞེས་གསུངས་པའི་ཕྱིར་རོ་ཞེ་ན།",
    "སྐད་གདངས་བྱེ་བྲག་འགའ་ཞིག་གིས།",
    "རེ་ཞིག་ལེགས་པར་སྦྱར་བའི་སྒྲ་ནི་ཚོགས་གསུམ་ཀ་སྐྱོན་མེད་པ་ཡིན་ནོ།",
    "རེ་ཞིག་ཡི་གེ་ལ་ནི་ལུས་དང་ཡན་ལག་དང་མ་བུ་དང་ཕ་མ་དང་།",
    "ཕོ་མོ་མ་ནིང་དང་ཚེག་དང་ཤད་དང་དབུ་སྒྱུར་མར་ཤད་པ་ལ་སོགས་ཀ་༡༣ པ་མང་པོ་སྣང་ངོ།",
    "གསུམ་ཟླའི་ཡི་གེ་ལ་གང་ཞིག་གང་གི་ལུས་ཡིན་ལ་གང་གི་ཡན་ལག་ཡིན།",
    "ཕོ་མོ་མ་ནིང་དུ་འབྱེད་ན་ཟ་མ་དང་མཚན་གཉིས་པ་དང་མོ་ཤམ་ལ་སོགས་པ་ཡང་ཅི་སྟེ་མི་འབྱེད།",
    "སྨྱུ་གུ་འབྲི་བའི་ཨ་ལ་སོགས་པར་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "ངག་གི་འདུ་བྱེད་ཀུན་ཏུ་སྐྱེད།",
    "སྟོད་ཀྱི་འདོགས་གསུམ་ནི་ཨི་དང་ཨེ་དང་མོ་ཡིན་ལ།",
    "ཡང་ན་ག་ད་བ་མ་འ་ལྔ་ནི་སྔོན་འཇུག་གི་ཡི་གེ་ཡིན་ལ།",
    "བྱེ་བྲག་གིས་རེ་རེ་ལའང་གསུམ་དུ་འགྱུར་ཏེ་དེ་ལྟར་ན་ཡི་གེའི་དབྱེ་བ་རྒྱས་པ་ནི་དགུ་བཅུར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་དེ་ཚོགས་པས་མིང་ཚིག་གསལ་ཞིང་ཚོགས་པས་དོན་རྗོད་པ་ཡིན་ནོ།",
    "ཁ་ད་ས་དང་ཉ་ལ་སོགས་པ་རེ་རེས་ཀྱང་དོན་སྟོན་པ་དེ་ནི་མིང་དང་ཡི་གེ་གཉིས་ཀ་ཡིན་པར་གཟུང་ངོ།",
    "ཡང་ན་ཡི་གེ་རེ་རེས་དོན་སྟོན་པ་ཤས་ཆུང་བས་ཡི་གེ་དོན་མེད་པ་ཞེས་ཀྱང་བྱ་སྟེ་ལྷ་མོ་སྐྱེད་མེད་མ་ཀ་ཙ་ག་ཟཤཀ་པ་ཕམི་མཙ་༧ ཐམཆཆ་མ་བཀའཆ་ས་སམ་བཞིན་ནོ།",
    "མིང་གི་བྱེ་བྲག་གི་རྒྱུ་ནི་ཡི་གེ་ཡིན་ལ་འབྲས་བུ་ནི་ཚིག་འགྲུབ་པར་བྱེད་དོ།",
    "རེ་ཞིག་སྒྲ་ལས་ནི་ཐོག་མ་གྲུབ་པའི་མིང་དང་།",
