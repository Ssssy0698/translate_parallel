    "ནམ་སྐྱ་བཏང་བ་དང་ཨ་ཕོ་དགྲ་འདུལ་གྱིས་ལུག་གཅིག་ཐག་པས་བརྐུམས་ཏེ་ཉལ་གཟན་རལ་ཧྲུལ་ཞིག་གི་ནང་དུ་དམ་དུ་བསྒྲིལ་ནས་བསྡམས་ཏེ་བོང་བུར་བཀལ་ཏེ་དལ་བུས་མདུན་དུ་སྐྱོད།",
    "དེ་ནས་བཟུང་རི་བོ་པད་མཚོ་དེར་དུར་ཁྲོད་གཤིན་རྗེའི་ཐར་ལམ་ཞེས་པ་འདི་བྱུང་ནས་ཡུལ་དེའི་སྐྱེ་བོ་ཚེ་ལས་འཕོས་པ་རྣམས་ཀྱི་དུར་མཆོད་བྱེད་ཡུལ་གྱི་གནས་ཤིག་ཏུ་གྱུར་པའི་ཤོད་སྲོལ་ཡོད་ཅེས་སྨྲས་པས་མ་རྒན་འཛོམས་དགའ་དད་པའི་སེམས་ཀྱིས་བསྐུལ་ཏེ་བགྲོད་པའི་གོམ་སྟབས་ཀྱང་མགྱོགས་སུ་སོང་ངོ།",
    "ྀབལྟ་བར་སྐྱི་གཡའ་བ་བག་ཁུམས་པའི་དུར་ཁྲོད་དུ་སླེབས་རྗེས་ཨ་ཕོ་དགྲ་འདུལ་གྱིས་དུར་ལས་ཀྱི་གྲབས་བཤམས་ཏེ་ལག་པར་བཤས་གྲི་རྣོན་པོ་ཞིག་ཐོགས་ཏེ་བཤས་ལས་སུ་བྲེལ་གྱིས་འཇུག་སྟེ་ཐོག་མར་ལུག་གི་པགས་པ་དམར་མཚལ་ལེ་བ་བཤུས།",
    "རུས་པ་རྣམས་ཆུ་རྡོ་སྣུམ་གྱིས་འཚོད་པ་ཞིག་གིས་ཞིབ་ཏུ་བརྡུངས་ཏེ་ཞོག་གཅིག་ཏུ་བསགས།",
    "དེ་ཐམས་ཅད་བྱས་ཚར་བ་ན་ཨ་ཕོ་དགྲ་འདུལ་གྱིས་འཛོམས་དགའ་ལ་ད་ཁྱོད་ལྷ་མཛེས་མ་བུ་བཙའ་བའི་གཡོག་ཏུ་མགྱོགས་པར་སོང་ཞིག་ཞེས་ཁྱིམ་དུ་ལོག་བཏང་།",
    "ས་རང་ཁེར་རེ་མ་བྲག་རྡོ་ཞིག་གི་ཐོག་ཏུ་སྣ་ཐ་འཐེན་ནི་ལྷོད་ལྷོད་པོར་གནས་སོ།་",
    "དུར་ཁྲོད་གཤིན་རྗེའི་ཐར་ལམ་གྱི་ཕྱོགས་སུ་ཤ་མིག་ལྡིར་ལྡིར་གྱིས་བཤར་རེར་འཕུར་འོངས་ཏེ་བྲག་རྡོའི་ཐོག་ཏུ་བབས་ཏེ་མགྲིན་པ་གཟེངས་ཤིང་མི་ཟས་ལ་རོལ་བའི་བྲེལ་བས་འཕག་པ་དང་འུར་སྒྲ་སྒྲོག་པའི་མཚམས་དེར་ཨ་ཕོ་དགྲ་འདུལ་གྱིས་རྒྱུས་མངའ་ཤིན་ཏུ་ཆེ་བའི་རྣམ་འགྱུར་གྱིས་ལག་པས་གཡབ་མོ་ཞིག་བྱས་ཏེ་ཀ་ལ་མ་དང་།",
    "དེ་ནས་དམར་སྲུང་དམག་ཚོ་གཅིག་ཁྲིད་དེ་དུར་ཁྲོད་གཤིན་རྗེའི་ཐར་ལམ་དུ་ཕྱོགས་ཏེ་གཅན་གཟན་གཏུམ་པོ་ཤ་ཁྲིག་ལ་རྔམས་པ་ལྟར་མགྱོགས་པར་སོང་ནནས་བལྟས་པས།",
    "ཨ་ཕོ་དགྲ་འདུལ་གྱིས་དུར་ལས་བྱས་པའི་ཚུལ་དེ་དག་མིག་ལམ་དུ་འཆར་བ་ཙམ་གྱིས་ཆེས་ཆེར་སྐྲག་སྟེ།",
    "འཊ་ལཀྱེ་མ་བླུན་ཞེས་ཀུན་གྱིས་དམོད་མོ་བྱ།",
    "ཡ་མཚན་མེད་པར་རང་རེའི་ཡང་དག་ལུགས།",
    "འཐབ་རྩོད་བྱེད་པའི་ཉིན་དེར་ཚོགས་ཁང་ནང་དུ་ཞིང་འབྲོག་མང་ཚོགས་བརྒྱ་སྐོར་ལ་ཉེ་བ་བསྐོང་བའི་མདུན་ཕྱོགས་སུ་མགོ་འཇགས་མས་གཙོས་པའི་དམར་སྲུང་དམག་གི་འགོ་པ་ཆེ་ཆུང་རང་རང་སོ་སོའི་གནས་ཐོབ་ལ་གཞིགས་ཏེ་མཐོ་དམའ་ལེགས་ཉེས་ཅི་རུང་གི་གདན་དུ་འཁོད།",
    "མངའ་ཚབ་ཏུ་བརྩིས་པའི་ཁྱིམ་གྱི་བད་ག་པོ་ཡར་གྲོང་ཚང་གི་ལི་བེ་ཨ་ཚེ་དང་།",
    "སྤྲ་དཀར་ཚང་གི་འཛོམས་དགའ་ལ་སོགས་པ་གཞོགས་ཤིག་ཏུ་དགུར་རེར་བསླངས་ནས་བཞག་སྟེ་ར་བསད་ནས་ལུག་འདར་བའི་དཔེ་ལྟར་འདར་སིག་སིག་ཏུ་སྣང་ངོ།",
    "ཁོ་ཁ་སོང་ཤི་ཚར་ལེ་རེད།",
    "དེར་གྲལ་རིམ་འཐབ་རྩོད་ཀྱིས་རབ་ཏུ་མྱོས་པའི་དཔའ་ཚེས་མང་ཚོགས་ཀྱི་གསེབ་ནས་ཧོབ་སྟེ་ལངས་ཏེ་ཕུ་ཐུང་དཔུང་པ་བར་བརྫེས་ཤིང་ལག་ངར་གྱེན་དུ་ཀྱི་འབོད་ཚིག་སྒྲོག་པས་མགྲིན་པའི་རྩའང་བསྒྲེངས་ཏེ་འཐབ་རྩོད་ཁྲག་གིས་བརྒྱངས་ཏེ་འབུ་དམར་དུ་མ་མགྲིན་པར་འཁྱུད་པ་ལྟར་སྣང་ཡང་དེར་རམ་འདེགས་ཀྱི་འབོད་ཚིག་སྒྲོག་མི་དེ་ཙམ་མ་བྱུང་།",
    "དེར་མགོ་འཇགས་མ་རབ་ཏུ་ཁྲོས་ནས་མང་ཚོགས་ལ་སྡིགས་མོ་བསྐུལ་ནས་འཐབ་རྩོད་ཀྱི་ངར་སློང་བར་འདོད་པ་བཞིན་མ་བྱུང་བས།",
    "ཅོག་ཙེའི་སྟེང་དུ་ཁུ་ཚུར་ལྡིར་སྒྲ་གྲགས་པ་ཞིག་ཤུགས་ཀྱིས་བྲབས་ཏེ་དོམ་ནག་གི་གོམ་འགྲོས་ལྟར་བགྲད་བགྲད་དུ་ནམ་མཁའ་ནོར་བུའི་མདུན་དུ་བཤར་ཏེ་འགྲམ་ལྕག་ཅིག་བསྣུན་རྗེས་མཛུབ་མོ་སྣ་ལ་བཙུགས་ནས།",
    "ཁོ་རེ་ནམ་མཁའ་ནོར་བུ།",
    "མྱི་ཁྱོད་རྫོ་རྒྱུ་ནི་ནམ་ཡིན་ཡང་ཞབས་རེའི་ཞབས་ལ་དུག་ཆུ་འདྲེན།",
    "བྱ་ཤི་ཡང་མིག་མི་འཛུམ་ཞེས་གཏམ་དཔེ་ཡོད་ལེ་རེད།",
    "མྱི་ཁྱོད་རྫོ་རྒྱུ་དེ་ལུག་ཚང་ནང་གི་སྤྱང་ཁྱི།",
    "ཉི་མ་ད་རེས་རྫོ་དུས་ཁྱོད་ཀྱིས་ནག་ཉེས་ཚང་མ་མ་བསྐུངས་པར་ཁ་གསལ་དྲང་པོ་ངོས་ལེན་མ་ཞུས་ན་ལས་སླ་མོར་འཇོག་ལེ་མིན་ཞེས་སྨྲས་རྗེས་རང་གི་ཁ་སྤུ་ལ་དཀྱིལ་མཛུབ་ཀྱིས་བྱིལ་བྱིལ་ལན་འགའ་བྱས་ནས་འཐབ་རྩོད་འདི་ལྟར་བྱ་དགོས་པའི་ཚུལ་སྟོན།",
    "ངོ་ཡོངས་ལ་སྟོད་ཅ་སྨུག་པོ་བཀུས་པའི་སྐྱེས་དམན་མིང་དུ་ཚེ་ལྷ་མོ་ཞེས་བྱ་བས་ནམ་མཁའ་ནོར་བུ་ལ་འགྲམ་ལྕག་སྐར་མ་ཤར་བ་ཞིག་གཞུས་ཏེ་འགྱེལ་བ་བྱས་རྗེས་གཉའ་ཐོག་ཏུ་ཅམ་སྟེ་བཅིབས་ནས།",
    "ཁོ་རེ།",
    "བླ་རྒན་ཁོ་རེ།",
    "ཉིན་མོ་སང་ཉིན་ཁྱོད་ཀྱིས་ལམ་སྣ་དྲངས་ཏེ་མཉམ་དུ་བསྐྱོད་དགོས་པའི་བཀའ་ཕབ་རྗེས་ཧ་ཧ་ཟེར་གད་མོ་དགོད་བཞིན་དཔའ་བོ་གཡུལ་ལས་རྣམ་པར་རྒྱལ་བའི་ཉམས་འགྱུར་གྱིས་རང་གནས་སུ་ཆང་རག་ལམུ་མཐུད་ལོངས་སུ་སྤྱོད་པར་ཆས་སོ།",
    "རྩ་བ་ཡན་ལག་གི་སྤར་མོས་ས་འཛིན་གྱི་བྲང་ཁ་དམ་པར་བཟུང་སྟེ་བརྟན་ཞིང་གཡོ་བ་མེད་པར་འགྱིངས་ཀྱིས་གནས་པར་དཀར་དམར་སེར་གསུམ་གྱི་དཪ་ལྡིར་སྐུད་པར་སྤེལ་ནས་བསྒྲོན་པ་ཞིག་ཡོད་པ་དེར་སྐྱེ་བོ་ཀུན་གྱིས་ལྷ་ཀླུ་གཞི་བདག་ཏུ་བཀུར་ནས་ལོ་རེར་གཏེར་བུམ་སྦས་ཏེ་ཆར་ཆུ་དུས་འབེབས་དང་ལོ་ལེགས་གྲ་རྒྱས།",
    "མགོ་འཇགས་མ་སོགས་ཀྱིས་སྡོང་རྒན་དེ་མཐོང་འཕྲལ་ཡིད་བདེ་བར་གྱུར་ནས་རེ་ཞིག་ངལ་གསོསངལ་བ་ལས་གསོས་རྗེས་ནམ་མཁའ་ནོར་བུས་ངོས་ལེན་ཞུས་པ་ལྟར་སྡོང་རྒན་གྱི་འདབས་སུ་ས་རྐོ་རྡོ་སློག་གི་སྔོག་འཚོལ་བྱས་ཀྱང་རྫ་བུམ་ཆག་རོ་འགའ་ཞིག་ཙམ་ལས་གཞན་གང་ཡང་མེད་པས།",
    "བླ་རྒན་ཁོ་རེ།",
    "བསྐུངས་ས་ངོ་མ་དེ་ག་ན་རེད།",
    "ཁྱོད་ཀྱིས་དྲང་པོ་མ་རྫོ་ན་ཁྱོད་རང་ས་དོང་འདི་ནང་སྐུང་ངོ་མ་སྐུང་གི་ཡིན་ཞེས་སྨྲས།",
    "ོ་ནམ་མཁའ་ནོར་བུའི་བསམ་པར་འཁྱོག་ཚིག་རྫུན་གཏམ་གྱིས་རང་སྲོག་ནི་སྐྱོབ་མི་ཐུབ།",
    "ཁ་སོང་མཚན་མོ་ང་སྐྲག་དྲགས་ཏེ་གནས་འདི་ན་བསྐུངས་ཡོད་ཅེས་ངོས་ལེན་ཞུ་དགོས་ཐལ་སོང་ཞེས་སྨྲས་པས་སྐོམ་པ་ཆུ་འདོད་ལྟར་སྒུག་པའི་རེ་བའི་མེ་ཏོག་བཞད་ལ་ཉེ་བ་དེ་ནམ་མཁའ་ནོར་བུའི་དྲང་གཏམ་གྱི་སེར་བས་ཡོངས་སུ་བཅོམ་སྟེ་ལྷག་འཕྲོ་ཙམ་ཡང་མ་ལུས་པར་གྱུར་ཅིང་།",
    "དབུ་རིལ་རིལ་འོ་བརྒྱལ་རང་གིས་བཟོས།",
    "ནམ་མཁའ་ནོར་བུར་འཐབ་རྩོད་བྱས་པའི་ལེའུ་སྟེ་བཅུ་གསུམ་མོ།་",
    "དྲེད་མོང་།",
    "བྲག་ཕུག་གི་ནང་དུ་རི་དྭགས་གཅན་གཟན་གྱི་ལྤགས་པ་དང་།",
    "དེ་ལྟ་བུའི་གནས་ཀྱི་ཟུར་ཞིག་ན་དྲེད་ལྤགས་མཁྲེགས་ཤིང་སྲ་བའི་སྟེང་དུ་མི་རྒྱ་བོ་ཞིག་ཁ་ངོ་སྣུམ་ཚིལ་ལེར་གཉིད་དུ་ཡུར་ནི་འདུགཤར་རི་བོའི་རྩེ་ནས་ཉི་གཞོན་གྱི་བཞིན་མདངས་འཛུམ་པའི་འོད་ཟེར་ནགས་གསེབ་ཏུ་འཁྱུད་དེ་འོད་མདའ་ཁྲི་སྟོང་མང་པོ་ལྷུངས་པའི་ཚེ་ན་འདབ་ཆགས་རྣམས་ཚང་ནས་ཐོན་ཏེ་ལྗོན་ཤིང་གི་རྩེ་མོ་གཅིག་ནས་གཅིག་ཏུ་ཕར་ཚུར་འཕུར་ལྡིང་གི་རྩེད་དགར་རོལ་ཞིང་།་",
    "དེས་ཁྱི་ཕྲུག་མིག་ཁ་འབྱེད་པ་ལྟར་མིག་ཟུང་དལགྱིས་གདངས་ཏེ་བྲག་ཕུག་གི་སྒོ་ཙར་ལྟ་ཙམ་བྱས་པས་ཞོགས་པ་ཟས་ཟ་བའི་དུས་སུ་སླེབས་པ་རྟོགས་འཕྲལ་ལེ་ལོ་སྒྱིད་ལུག་གིས་རྐང་ལག་ཤུགས་ཀྱིས་ཐང་ཐང་པོར་བརྐྱངས་ཏེ་ཉོབ་པ་ལས་ཅུང་སངས་རྗེས་སྟན་ལས་ག་ལེར་ལངས་ཏེ་རྡོ་ཐབ་ཏུ་བསྲེགས་པའི་རི་དྭགས་ཤ་ཟ་འཕྲོས་ཨེ་གདའ་བལྟས་པས་ཟ་ལོ་བ་ཆེར་མེད་པས།",
    "ལག་ཏུ་འགྲེང་ཐག་རིང་བ་ཞིག་ཐོགས་ཏེ་བྲག་ཕུག་གི་ཁ་སྒོ་ནས་རི་དྭགས་གླ་བ་ལྟར་བདེ་རྩལ་འཁྱུག་པོས་ནགས་ཀྱི་ཁྲོད་དུ་སོང་།",
    "དེ་མ་ཐག་གཡས་གཡོན་དུ་ཞིབ་པར་བལྟས་ཏེ་བྱ་ར་བྱེད་མི་མེད་པ་ཤེས་མཚམས་འགྲེང་ཐག་གིས་རྒྱབ་ཏུ་ལིང་སྟེ་ཁུར་ཏེ་ནགས་ཁྲོད་བྲག་ཕུག་གི་ཕྱོགས་སུ་མྱུར་མྱུར་པོས་བསྐྱོད།",
    "དོགས་པ་དང་ཐེ་ཚོམ་ཟ་བ་ལྷན་ཅིག་ཏུ་བྱུང་ནས་ཤིང་གི་ཡལ་ག་རེངས་པ་ལྟ་བུའི་ཕྱག་འདར་སིག་སིག་གིས་གོང་དུ་ངལ་ངལ་པོས་བསྒྲེངས་ཏེ་མཆུ་སྒྲོས་པད་མའི་འདབ་ལྟར་གཡོ་ཞིང་མགྲིན་པའི་གཏིང་ཀོང་ནས་འཛེར་འཛེར་པོས་ང་གང་དུ་སླེབས་པ་རེད།",
    "ཁྱོད་སུ་ཡིན་ཞེས་བཀའ་འདྲི་གནང་པར་མི་དེས་བརྩེ་སེམས་ཤིན་ཏུ་ཆེན་པོས་ཀུན་མཁྱེན་ནམ་མཁའ་ནོར་བུའི་ཕྱག་ནས་ག་ལེར་འཇུས་ཏེ།",
    "ཉིན་ཞིག་ནམ་མཁའི་མཐོངས་ནས་ས་གཞིར་ཆུ་འབོ་བ་ལྟ་བུའི་དྲག་ཆར་ཉིན་མཚན་ལྔ་དྲུག་སྟུད་མར་བབས་ཏེ་བྲག་ཕུག་གི་ཕྱོགས་མཚམས་ཀུན་ཏུ་ཆུས་ཁེངས་ཏེ་རྒྱ་མཚོའི་དབུས་སུ་ཆགས་པའི་གླིང་ཕྲན་ལྟ་བུར་གྱུར་ཏེ་ཕྱི་ལ་ཟས་འཚོལ་དུ་འགྲོ་བའི་ཐབས་ནི་ཟད།",
    "སྤྱན་སྔ་བློ་གྲོས་རྒྱལ་མཚན་གྱིས་ལོ་མང་པོའི་སྔོན་དུ་བདེ་སྐྱིད་ཡོང་བའི་ཐབས་ཤིག་ག་སུངས་པ་དེ་ནི་ང་རང་ལ་གསུངས་པ་ནང་བཞིན་ད་ལྟ་རང་གི་ཐོག་ལ་སྨིན་པ་བྱུང་སོང་།",
    "ཉོན་མོངས་ཚ་གདུང་སེལ་བའི་ཟླ་བའི་འོད།",
    "ལེགས་སོ་ཞེས་གསུངས་ཏེ་དེ་མ་ཉིད་དུ་སྦྲུལ་སྤྱན་ཪས་གཡོ་བ་མེད་པར་གཟིགས་ནི་བཞུགས་སོ།",
    "དམ་པ་འདི་ཉིད་ཀྱིས་བརྩམས་པའི་ཚིག་ལྷུག་གི་རྩོམ་དང་།",
    "རྒྱ་གར་གྱི་སྙན་དངགས་མཁས་པ་སློབ་དཔོན་ནག་མོཁོལ་གྱིས་མཛད་པའི་སྤྲིན་གྱི་ཕོ་ཉ་ནི་ཚིག་འདུས་ཤིང་གོ་བདེ་བ།",
    "དེའི་འགྲམ་གྱི་སྟེགས་པུའི་ཐོག་ཏུ་ཞྭ་མོ་ཀེབ་ཞྭ་གྱོན་པ།",
    "ཝང་ཧྲུའུ་ཅིའི་ཕྱོགས་སུ་ངོ་གདོང་བསྒྱུར་ཏེ་ལག་ཏུ་ཐོགས་པའི་མའོ་ཀྲུའུ་ཞིའི་གསུང་བཏུས་ཀྱི་རྒྱབ་ཤ་དམར་པོ་ཕུ་ཐུང་གིས་ཕྱིས་ཕྱིས་ནས་ཤིན་ཏུ་ནན་པོའི་རྣམ་འགྱུར་གྱིས་མུ་མཐུད་སྨྲས་པ།",
    "དེར་ཨ་ཕོ་དགྲ་འདུལ་གྱིས་གཏམལན་གང་ཡང་མ་བཏབ་པར་མཐེ་བོང་གི་སེན་ཐོག་ཏུ་སྤུངས་པའི་སྣ་ཐ་འཐེན་ནི་མིག་གཞན་དུ་བལྟས་ནས་གཡེངས་པའི་ཚུལ་གྱི་བསྡད།",
    "དེར་བསམ་ཤོད་ཆུས་ཀྲང་ཤིན་ཏུ་མི་དགའ་བར་གྱུར་ཏེ་སྒལ་པ་གྱང་དུ་བསྙེས་པ་ལས་བྲལ་ཏེ་ལྟག་པ་དགྱེ་དགྱེ་གིས་བསྡད་དེ་བཟི་བེ་བེར་ཁ་ལྡབ་ལྡིབ་ཀྱི་ངང་ནས།",
    "དགྲ་འདུལ་གྱིས་མངའ་བདག་མངའ་ཚབ་སྲུང་སྐྱོབ་བྱས་པ་ཁེ་རེ་མ་ཡིན།",
    "དེའི་སྐབས་སུ་མཐོང་སྨོན་ཆུས་ཀྱི་ལི་ཧྲུའུ་ཅིས་དལ་དལ་པོས་སྟོད་ཕད་སེར་པོ་ཞིག་གི་ནང་ནས་བརྗེད་ཐོ་འགོད་དེབ་ཞིག་བཏོན་ཏེ་དེ་ལ་ལྟ་ཙམ་བྱས་ནས།",
    "ིཁྱོད་ཀྱིས་ནག་ཉེས་ངོས་ལེན་མ་བྱས་ནའང་སྐྱོན་ཅི་མེད།",
    "ང་ཚོས་བརྟག་དཔྱད་ཞིབ་འཇུག་བྱས་དང་པོ།",
    "ཁྱོད་སྦྲ་དཀར་ཚང་གི་བྲན་གཡོག་ཡིན་ཟེ་ནའང་དོན་དངོས་འཛོམསདགའི་འདུག་རོགས་རེད་འདུག་བཞི་པ།",
    "ལྷ་མཛེས་མ་ཁྱོད་ཀྱི་བུ་མོ་ཡིན་ས་རེད།",
    "ཁོ་རེ་དགྲ་འདུལ།",
    "དེའི་ཚེ་དགྲ་འདུལ་གྱིས་སེནཐོག་གི་སྣ་ཐ་དེ་སྣ་བུག་ཏུ་ཅབ་སྟེ་འཐེན་རྗེས།",
    "ཕུ་ཐུང་གིས་སྣ་བུག་ག་ཕྱིས་ཕྱིས་བྱས།",
    "ལས་དོན་རུ་ཁག་གི་འགོ་ཁྲིད་རྣམ་གཉིས་ལ་ལོགས་སུ་ཞུས་ཆོག་ཅེས་སྨྲས་པས།",
    "ཚང་མ་ཡར་ལངས་ཏེ་བློ་འཕྱང་བཞིན་དུ་རང་རང་སོ་སོའི་གནས་སུ་སོང་ངོ།",
    "རཱུཤིང་སྡོང་དུམ་བུར་བཅད་དེ་བང་རིམ་དུ་བརྩེགས་པའི་ཁང་ཆུང་ཞིག་གི་ནང་དུ་སྒྲོན་མེ་ཡང་ལཱ་སྤར་ནས་འོད་སྣང་ཆེམ་ཆེམ་དུ་འཕྲོ་ནི་འདུག་ཁང་པའི་ཟུར་ཞིག་གི་ཉལ་ཁྲིའི་སྒང་དུ་ལས་དོན་རུ་ཁག་གི་འཇིགས་མེད་ཚེ་བརྟན་དང་ཝང་ཧྲུའུ་ཅི་རྣམ་གཉིས་དཔུང་པ་གཤེབ་གཤིབ་ཀྱིས་ཞི་ཞིང་ལྷོད་ལྷོད་པོར་གནས་ཤིང་།",
    "ག་གནས་གསར་བརྗེ་ཆེན་པོའི་ནང་མང་ཚོགས་ལ་ཞྭ་མོ་གང་བྱུང་གཡོགས་པ་དང་།",
    "ཁྱོད་བློ་དོགས་གང་ཡང་མ་བཅངས་པར་གནས་ཚུལ་གང་ཡོད་ང་ཚོར་གསལ་པོ་ཤོད་དང་།",
    "ཝང་ཧྲུའུ་ཅིས་དེ་མ་ཉིད་དུ་དལ་དལ་ལྷོད་ལྷོད་ཀྱིས་སྤྱན་ཤེལ་ཡུ་བ་རྣ་གཤོང་གི་ཧྲག་ཏུ་བསྐོན་ཏེ་ཐུགས་གཤིས་ཤིན་ཏུ་འཇམ་པོས།",
    "ཾ་གནས་བབ་ཇི་ཡིན་བརྟག་དཔྱད་ཞིབ་འཇུག་གིས་གནས་ཚུལ་ཇི་མ་ཇི་བཞིན་སྙན་སེང་ཞུ་དགོས་པ་བཀའ་ཕེབས་པ་དང་།",
    "ང་ལ་དགྲ་འདུལ་ཞེས་འབོད་དེ་སྟག་རོང་ཚང་གི་དགྲ་ལྷ་རྣམ་གསུམ་ཞེས་ཡུལ་དེར་གྲགས་ཆེ་བ་ཡིན།",
    "ཕར་བཅོམ་ཚུར་འཕྲོག་ཁོ་ན་བྱེད་ལེ་རེད།",
    "བོད་ཀྱི་རབ་བྱུང་བཅོ་ལྔ་པའི་ཤིང་མོ་བྱ་ཡི་ལོའི་དགུན་ཟླ་འབྲིང་པོའི་ནམ་ཕྱེད་ཡོལ་ཙམ་དུ་ཀོང་རོང་ས་ངན་ཨ་འབྲུག་ཚང་གི་ཕ་འབྲུག་གྲགས་རྣམརྒྱལ་དང་།",
    "ངའི་ཤ་ཉེ་གཉིས་ཀྱིས་ཧབ་ཧོབ་ངང་མལ་ལས་ལངས་ཏེ་ལག་འཛིང་བཏང་ཡང་ཁོ་ཚོ་མི་ཧྲག་དྲགས་ནས་གླགས་མི་རྙེད་པར་མཚོན་འོག་ཏུ་སོང་།",
    "དེའི་སྐབས་ང་ནི་ལོ་བཅུ་ཙམ་ལས་སོན་མེད་པས་སྐྲག་ཆེས་ཏེ་ལྟ་བ་རྟབ་པོར་ཆུ་ཟོམ་ཞིག་རང་གི་མགོ་ཐོག་ཏུ་ཁ་སྦུབས་ནས་བཀབ་སྟེ་དེའི་འོག་ཏུ་དབུགས་ཀྱང་འབྱིན་པར་མ་ནུས་པར་ཡིབ་སྟེ་བསྡད་པས།",
    "ཁོ་ཚོས་དགྲ་འདུལ་མི་གདའ་ཟེར་ནས་འུར་སྒྲ་ལྷང་ལྷང་གིས་ཁང་པའི་ཕྱི་དང་ནང་།",
    "ཁུག་ཀྱོག་ཡོད་རྒུར་ཡུན་རིང་བཙལ་ཡང་མ་རྙེད་པར་ཐབས་ཟད་དེ་ཟོག་འདེད་ཐུབ་པ་གང་ཡོད་འདེད་དེ་སོང་འདུག་སྐྱ་རེངས་ཤར་བ་དང་ངས་ཆུ་ཟོམ་གྱི་འོག་ནས་ག་ལེར་འོངས་ཏེ་ཕར་ལྟ་ཚུར་ལྟ་བྱས་པས་ངའི་ཁྱིམ་ནི་གཡུལ་ས་འཁྲུག་པ་ལྟར་ཟང་ངེ་ཟིང་ངེར་གྱུར་འདུག།",
    "ཁྱོད་ཡུལ་འདི་ལ་བསྡད་ན་ཁོ་ཚོར་དགྲ་ཤ་ལེན་པར་འོངས་ནས་ཁྱོད་གསོད་ཐག་ཚོད་གསོད་ཀྱི་རེད།",
    "དེ་ལས་ཐབས་གཞན་ཞིག་བཏོན་ན་དགའ་ཞེས་ཟེར་ནས་བ་ཚང་གི་ཟུར་ཞིག་ཏུ་ས་དོང་གཏིང་རིང་བ་ཞིག་འདྲུས་ནས་དེའི་ནང་དུ་ང་བསྙུངས་ནི་བཞག་བྱུང་།",
    "ཨ་འབྲུག་ཚང་གི་བསམ་པར་སྟག་རོང་ཚང་གི་མི་རབས་ཆད་པ་ཞིག་མ་བཟོས་ན་ཚུར་དགྲ་ཤ་ལེན་ཐག་ཚོད་ལེན་ལེ་རེད་སྙམ་ནས་ག་ང་སྟབས་ཀྱིས་མི་ཕྱིད།",
    "བཏང་སྟེ་ང་གསོད་རྩིས་བྱས་ཀྱང་མ་རྙེད་སྟབས་བྱ་ཐབས་ཟད་དེ་རིམ་ནས་རིམ་གྱིས་བརྗེད་དེ་སྣང་མེད་དུ་སོང་ལེ་རེད།",
    "ང་ལོ་ན་བཅོ་བརྒྱད་ཙམ་དུ་སླེབས་སྐབས་ཚྭ་གཡག་གུས་འཁྱོག་ན་འཁྱོག་ལེཡིན།",
    "ཕོ་རང་གི་འཇོན་ན་འཇོན་ལེ་ཡིན།",
    "གཏམ་དཔེ་ལ་ཕོ་རང་མགོ་ཐོན་ནས་གཞན་མགོ་འདྲེན་ཟེར་བས་ཁྱོད་རང་མགོ་ནི་ཐོན་ཟིན།",
    "སོང་སྟེ་ནོར་ཐམས་ཅད་རྩྭ་ཆུ་ག་ན་བཟང་བ་དེར་འདེད་དེ་ཤ་ཤེད་རྒྱས་པ་བཟོས།",
    "དགུན་ཀླུང་ལ་བབ་སྟེ་ཕྱུགས་ཚང་མ་རང་གི་བུ་ལྟར་སྐྱོངས་ཏེ་མང་དུ་འཕེལ་བ་བྱས།",
    "ཉིན་ཞིག་ང་རུ་བ་ནས་ཁྱིམ་དུ་རྒྱགས་ལེན་དུ་ཡོང་བའི་ལམ་བར་དུ་ན་གའི་སྟེང་དུ་འཕྱི་བ་དུ་མ་རང་འགར་རྩེད་མོ་ལ་འདུག་པས།",
    "དེའི་ནང་ནས་འཕྱི་བ་མ་བུ་གསུམ་འཕྱི་ཚང་ནས་ཕྱིར་ཐོན་ཏེ་ན་གའི་ཐོག་ཏུ་དགའ་སྐྱིད་ངང་རྩེད་མོར་འདུག་པས།",
    "ང་ནི་ཕོ་ལོ་ཉི་ཤུ་ལྷག་ཙམ་དུ་སོན་ནའང་ད་རུང་ཕ་མའི་དགྲ་ཤ་ལེན་ཐུབ་མ་སོང་ཨང་སྙམ་ཏེ་ངོ་ཚ་སྟེ་ཁ་ངོ་ཚ་ཤུར་ཤུར་གྱུར་ནསཕྲག་པ་གློད།",
    "སྒྱིད་ལུག་གི་གོམ་སྟབས་ཀྱིས་ཡོང་ནས་ཡོང་བ་དེ་ཨ་ཕོ་དགྲ་ལྷ་བསྟན་འཛིན་གྱིས་རིག་སྟེ་ཅི་རེད་དེ་ཞེས་དྲིས་བྱུང་བས།",
    "ད་ཁྱོད་ལ་རོགས་རམ་ཅི་བྱེད་དགོས་ས་གདའ་ཤོད་ཅིག་ཟེར་བྱུང་བས།",
    "གོ་ལག་ཆའི་རོགས་རམ་བྱེད་རོགས་ཞེས་རེ་བ་བཏོན་པས།",
    "ཨ་ཕོ་དགྲ་ལྷ་བསྟན་འཛིན་གྱིས་ང་ལ་མེ་མདའ་པཱ་མ་ལེབ་གཉིས་དང་།",
    "ཁྱོད་ལ་རོགས་པ་སུ་ཡོད་ཅེས་དྲིས་བྱུང་བས།",
    "ཡག་མོ་བྱུང་འདུག་ཟེར་བྱུང་།",
    "མུན་རུབ་པ་དང་ཨ་ཕོ་དགྲ་ལྷ་བསྟན་འཛིན་དང་འཛོམས་དགས་ང་གཉིས་རི་གདོང་དུ་མ་སླེབས་བར་སྐྱེལ་མ་བྱས་ནས་སྐྱེམས་༴",
    "ང་གསུམ་སྒྲོན་རེ་བླུད།",
    "སྐེ་ལ་དར་དཀར་བདེ་ལེགས་ཛར་ལོ་མ་ཉམས་པ་རེ་བསྐོན།",
    "ལྷག་པར་དུ་འཛོམས་དགས་ང་རང་ཟུར་དུ་བཀར་ནས་བརྩེ་བ་ཟབ་མོས་ངའི་ལག་པ་ནས་བཟུང་སྟེ་བཅང་བཅང་བྱས་ཤིང་།",
    "གདོང་མཆི་མས་གང་བའི་ངུ་ངག་གིས་ཕོ་མ་འཕྱུག་ཨང་ཟེར་ནས་ཁ་ཏ་མང་དུ་བྱས་བྱུང་།",
    "ཉིན་མཚན་དྲུག་ཆས་པའི་མཚན་མོར་ང་གཉིས་ཀོང་རོང་ས་ངན་གྱི་ཉེ་འདབས་སུ་འབྱོར་ཏེ་འབྲོག་པ་ཨ་ཁྲའི་ཁྱིམ་དུ་གནས་བཅའ་སྟེ་བསྡད།",
    "དེར་ང་གཉིས་ཀྱིས་ཚོང་པའི་ཚུལ་བྱས་ཏེ་ཡུལ་མི་འགའ་ལ་རྔན་པ་བྱིན་ཏེ་ཨ་འབྲུག་ཚང་གི་གནས་ཚུལ་དྲིས་པས།",
    "དེ་སྔ་ཨ་འབྲུག་ཚང་གི་ལག་དོ་ལྷ་རྒྱལ་གྱིས་ཤོད་རྒྱུར།",
    "དེ་བས་གནངས་ད་ཉིན་གླང་རི་ས་སྐྱ་དགོན་ལ་ལོ་གཅིག་དུས་གཅིག་གི་འཆམ་ཡོད་གཔས།"
  ]
}