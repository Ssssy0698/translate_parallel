    "གཞན་ཡང་ཞིང་འབྲོག་ལས་ཀྱི་ཐོན་རྫས་འཚོང་འབུལ་ཞུ་བའི་ལས་ཀྱིས་རབ་ཏུ་བསྐུལ་བས་རེས་འགའ་ཁལ་ལ་མཪ་དང་འབྲུ་བཀལ་ནས་སྤྲོ་བའི་འཛུམ་དང་བཅས་ཏེ་ཁལ་མའི་མཇུག་ཏུ་གླུ་ལེན་བཞིན་དུ་ཡོང་བ་དང་།",
    "རེས་འགའ་ཁུར་པོ་རྒྱབ་ཏུ་ཁུར་ཏེ་ཕྲག་པ་གློད་ཅིང་གོམ་སྟབས་འཁྱོར་ཏེ་ངལ་ཌ་ངལ་གྱིས་འོང་བ།",
    "རེས་འགའ་སྤྲོ་བ་ཉམས་ཏེ་སྒྱིད་ཅིང་ལེ་ལོའི་གོམ་འགྲོས་ཀྱིས་ཡོང་བརེས་འགའ་ཚུལ་མིན་གྱི་བྱ་བར་འཇུག་པའི་གནོང་གིས་ཡིད་འཚབ་པའི་ངང་དུ་མགོ་བོ་དུད་ཅིང་འོང་བ།",
    "དེ་ནས་རེ་ཞིག་སོང་བའི་ཚེ་ན་ལྕགས་རི་མཐུག་པོས་ཡོངས་སུ་བསྐོརབའི་ཆུས་ཀྱི་དོ་རའི་ནང་ལང་ཚོ་དར་ལ་བབ་པའི་ཞིང་འབྲོག་ཕོ་གཞོན་མོ་གཞོན་དང་།",
    "དེ་བཞིན་ཁོང་ཚོས་འདེད་ནས་ཡོང་བའི་ཁལ་དང་རྟ་བོང་བུ་སོགས་ཀྱིས་ཡོངས་སུ་གང་བའི་ཚེ་ན་ཚོང་འདུས་སུ་མི་ཚོགས་ཚོང་གི་ལས་ལ་འཁོད་པ་ལྟར་ཕན་ཚུན་དཀའ་ཨེ་སྟེ།",
    "ོགཡས་པར་ལྕགས་སྙུག་ཐོགས་ཏེ་ཟུར་བཞི་ལ་འཁོར་སུག་བསྒར་བའི་འདེགས་བྱེད་ཁྲོ་ལྕགས་རྒྱ་མའི་གམ་ན་ལྷོད་ལྷོད་པོར་ལངས་ཏེ་ཁྱིམ་དུད་རེ་རེ་བྱས་ནས་འབྲུ་དང་མར་རྒྱ་མར་འདེགས་འགོ་འཛུགས།",
    "༢དྲིན་ཆེན་གུང་ཁྲན་ཏང་ལ་ཕུལ་ལེ་ཡིན་ཞེས་སྐད་གསང་མཐོན་པོས་སྨྲས་རྗེས་མར་ལྟང་དེ་འདེགས་རྒྱའི་སྒང་ལ་ག་ལེར་བཞག་རྗེས་ཁ་སྤུ་ཐ་རེ་ཐོ་རེ་དེ་ཕར་བྱུར་ཚུར་བྱུར་བྱསགདོང་པ་གོང་དུ་བཏེགས།",
    "མར་ཡག་ཉེས་ཡག་མོ་ལྟ་དགོས་ཞེས་དྲན་པ་བསྐུལ།",
    "སེམས་ཆུང་ཆུང་སེམས་ཁྲེལ་དགོས་ཨ་ཕོ་ལེ་མེད།",
    "མར་ཡག་ཉེས་བལྟས་ན་ཆོག་ལེ་རེད།",
    "ཞི་ཞིང་དུལ་བའི་ངང་ནས་ན་རེ།",
    "ངས་ཁྱོད་ཁེར་རེ་ལ་རྫོ་ལེ་མིན།",
    "ཁྱོད་ངར་ངར་བྱེད་དགོས་ལེ་མ་རེད་ཅེས་འཇམ་གྱིས་སྨྲས་ཀྱང་ཁོའི་རྣ་བར་མ་སོང་བར་ད་དུང་ངར་ཆེ་ཆེ་ཞེ་ལྡང་ལྡང་སྐད་འཛེར་འཛེར་གྱིས་བབ་ཅོལ་གྱི་ཚིག་མང་དུ་སྨྲས་པར་ཁ་ཡ་བྱེད་མཁན་ནི་མ་བྱུང་།",
    "བློ་བསོད་ནམནམས་ཀྱིས་མར་དེ་ནས་སྲན་རྡོག་ཙམ་ཞིག་འཛུམ་མོས་འདྲུད་དེ་སྣས་དྲི་སྣོམ།",
    "གནོང་ཆེན་པོས་གདོང་པ་དུད་དེ་རེ་ཞིག་ག་བྱེད་འདི་བྱེད་མེད་པའི་གནས་སུ་གྱར།",
    "ཆག་སྒོ་ཉི་མ་ད་རེས་བྱུང་།",
    "ཡིན་བདེན་པ་གྲལ་རིམ་དགྲ་བོས་ལྐོག་ཏུ་བརྗེ་ལེ་རེད།",
    "མའོ་ཀྲུའུ་ཞིས་དཔའ་བོ་ངོ་མ་མང་ཚོགས་ཡིན་གསུངས་ཡོད་པས།",
    "ད་མང་ཚོགས་རྣམས་ཀྱིས་དཔའ་བོའི་དཔའ་གཏམ་ཞིག་དྲང་པོ་ཤོད་རོགས་ཞེས་སྤྲེལ་ལད་དང་འཇིགས་སྐུལ་ཟུང་དུ་སྦྲེལ་ནས་བཤད།",
    "མང་ཚོགས་ལ་སྡང་སེམས་ཆེ་བ།",
    "དྲན་རྒྱུ་རྒོད་ལ་མགོ་བདེ་བཀྲབ་བླག་ཚ་ལ་གཡོ་སྨྱུ་ཆེ་བས་གང་ཞིག་གིས་ཀྱང་ཡ་ཁུ་མ་བྱས་པར་ཁ་ཅིག་ནི་རྣ་བ་གཞན་དུ་ཡེངས་པའི་ཚུལ་དུ་གནས།",
    "ཁ་ཅིག་ནི་ཕན་ཚུན་གླེང་མོར་མགོ་སྦྲིད་པའི་ཚུལ་གྱིས་གནས།",
    "ཁ་ཅིག་ནི་མིག་ཅེ་རེར་བལྟས་ནས་ཁོང་དུ་འཛུམ་ཤོར་ནི་བསྡད།",
    "མི་མང་ཆེ་བ་ནི་མགོ་འཇགས་མས་སྔོ་ལོ་དེ་ལྟར་འཕྱར་བར་ལྟད་མོ་ཞིག་བལྟ་དགོས་སྙམ་སྟེ་མིག་ལྡིར་ལྡིར།",
    "ལྷ་མཛེས་མ་ཡིན་པ་མཐོང་འཕྲལ་དགའ་བའི་རྣམ་འགྱུར་དང་བརྩེ་བའི་འདུ་ཤེས་དང་བཅས་ཏེ་ཁྱོད་དཀའ་ཨ་སྟེ་ཞེས་དྲིས།",
    "གོས་ཀྱི་ཐལ་བ་རྣམས་སྤྲུགས་པའི་ཚེ་ན་ལྷ་མཛེས་མས།",
    "ཨ་མ་དང་ཨ་ཞང་གིས་ཁྱོད་དེ་རིང་དགོང་མོ་ཁྱིམ་དུ་ཡོང་རོགས་ཞེས་པའི་ལན་དེ་གསང་སྟབས་ཀྱིས་སྤྲད་པས།",
    "ལྷ་མཛེས་མས་རེ་ཞིག་ལན་གང་ཡང་མ་བཏབ་པར་མགོ་བོ་དུད་དེ་རྐང་པ་གཡས་པའི་ལྷམ་མཐིལ་ས་ལ་ཕར་བགྲད་ཚུར་བགྲད་བྱེད་བཞིན་ཅུང་སྐྱེངས་བའི་འཛུམ་མདངས་ཀྱིས་ང་རང་གཉིས་ཀྱི་དོན་དག་གྲོས་ཁ་བཟོ་དགོས་བརྗོད་ཀྱི་འདུག་ཅེས་སྨྲས་ཏེ་ངོ་ཚའི་རྣམ་འགྱུར་གྱི་མིག་གཉིས་ཀེམ་ཀེམ་གཡོ་བཞིན་དུ་བསྡད།",
    "ད་རེས་ལས་ཀ་འདི་ཚར་སོང་སང་ཉིན་ཁོམ་པ་གཏན་ནས་མི་གདའ།",
    "ལྷ་མཛེས་མས་མགོ་བོ་ལྕོག་ལྕོག་བྱས་ཏེ་ཤིན་ཏུ་མོས་པའི་རྣམ་འགྱུར་བསྟན་པ་དེ་ཚང་མ་གནོང་གིས་ཁ་སྐྱེངས་ཏེ་ག་བྱེད་འདི་བྱེད་མེད་པར་གྱུར་པའི་མགོ་འཇགས་མས་གསལ་ཞིང་གསལ་བ་མཐོང་ངོ།",
    "ལས་སྡུག་དགུ་འཚོ་རྫི་གཡོག་གིས་བྱེད།",
    "གྱོད་སྣ་དགུའི་རྩ་བ་ནག་མོས་གཡོ།",
    "ཁྱོད་ཀྱི་ཨོང་ཏོ་དེ་མངའ་བདག་གི་ཨོང་བཀྱག་ཐོག་ཏུ་བཞག་ལེ་རེད་དམ།",
    "ཡང་ན་དབུལ་ཕོངས་ཀྱི་ཨོང་བཀྱག་སྒང་ལ་བཞག་ལེ་རེད།",
    "སུ་མངའ་བདག་གི་ཕྱོགས་སུ་ལངས་ན་དེ་ནི་གསར་བརྗེར་ངོ་རྒོལ་པ་ཞིག་ཡིན་ཞེས་མའོ་ཀྲུའུ་ཞིས་ང་ཚོར་བཀའ་སློབ་གནང་ཡོད།",
    "ཁྱོད་ཀྱི་བྱེད་ལུགས་བྱེད་སྟངས་ལ་བལྟས་ན།",
    "མངའ་བདག་གི་ཕྱོགས་སུ་ལངས་འདུག་ཅེས་སྨྲས་རྗེས་རྐུབ་སུལ་ལིང་ལིང་དུ་གཡུག་བཞིན་མི་ཚོགས་ཀྱི་དཀྱིལ་གཤགས་ཏེ་ཐོག་བརྩེགས་གསུམ་པའི་གྲོས་ཚོགས་ཁང་དུ་ཡོད་པའི་ཆུས་ཀྲང་བསམ་ཤོད་ཀྱི་མདུན་དུ་སོང་ནས།",
    "སྡུག་ཞུ་ས་རང་གི་འགོ་ཁྲིད་ཡིན།",
    "དེར་ཞི་ཡོད་མང་ཚོགས་རྣམས་ནི་མགོ་འཇགས་མ་ཁོའི་སྤྱོད་ཚུལ་ལ་ཤིན་ཏུ་མི་འདོད་པར་གཏམ་ཅི་དང་ཅི་གླེང་བའི་ཤུབ་ཤུབ་སྒྲ་ཡིས་དོ་ར་དེའི་ཚེ་བསམ་ཤོད་ཆུས་ཀྲང་བཟི་བེར་བེར་འཁྱར་ཁེངས།",
