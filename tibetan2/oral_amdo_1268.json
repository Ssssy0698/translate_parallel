    "ཁོང་ཚོས་ཁྱེད་ཕེབས་རྐྱང་གནང་རོགས་གང་ཡང་བྱེད་ཀྱི་མ་རེད།",
    "ང་ཚོ་གནམ་ཐང་དུ་སླེབས་ཡོང་ཞེས་ལན་བཏང་འདུག་པར་ཆ་འཛིན་བྱས།",
    "ཕྱི་ཉིན་བསྐྱོད་རྐྱང་བྱས་པར་རྒྱ་ནག་གཞུང་ཚབ་ཁང་གི་མི་སྣ་གནམ་ཐང་དུ་སླེབས་འདུག་ངན་བྱུས་རྩོམ་མཁན་ཚོ་འཇའ་ལྟར་ཡལ་འདུགདེ་ཉིན་ཐོན་ནས་ཕྱི་ལོ་༡༩༩༦ ཟླ་༨ ཚེས་༡༩ ཉིན་ལྷ་སའི་གོང་དཀར་གནམ་ཐང་དུ་སླེབས།",
    "མཇལ་དར་བཏང་རེས་བྱས།",
    "ཁམས་རིགས་མི་གྲངས་༤ སྐོར་གནམ་ཐང་གསང་སྒོ་ནས་བཏང་བྱུང་བ་རྣམས་དང་ངོ་སྤྲོད་མཇལ་དར་བཏང་རེས་ཀྱང་བྱས་ཏེ་དགའ་སྐྱོ་ཟུང་འབྲེལ་དུ་གྱུར།",
    "ཕན་ཚུན་ཐོས་མྱོང་ཙམ་གྱི་མི་རབས་གསར་པ་ཤ་སྟག་རེད་འདུག་དེ་ནས་ཐོན་ཏེ་ལྷ་སའི་མགྲོན་ཁང་ཆེན་མོར་གོ་སྒྲིག་བྱས་འདུག་པར་བསྡད།",
    "རྭ་མོ་ཆེའི་ཇོ་བོར་ཞལ་གསེར་ཙམ་ལས་ཕུལ་ས་མ་ཐོབ།",
    "སྨར་ཁམས་པ་རེད་ཟེར་བའི་གྲྭ་ཆས་ཅན་ལོ་ཆུང་གཉིས་འདུག་པར་དེས་དོལ་རྒྱལ་བསྟེན་མཁན་ནམ།",
    "ཕྲན་ནས་ཞལ་གསེར་ཕུལ་ས་མ་རག་པར་དེར་བློ་ཕམ་ཆེ་ཡང་ད་ལན་གཉེན་འཕྲད་ཐེངས་གཅིག་ཡོང་སྐབས་འདིར་རྭ་མོ་ཆེའི་ཇོ་བོའི་མདུན་རྙོག་གྲ་ཞིག་ཆགས་པ་རེད་ཟེར་བའི་སྐད་ཆ་མི་ཡོང་བ་གནང་རོགས་ཞེས་བརྗོད་པ་ཡིན།",
    "རྭ་ས་འཕྲུལ་སྣང་གཙུག་ལག་ཁང་གི་དཀོར་གཉེར་རྣམས་དང་།",
    "བོའི་ན་བཟའི་འོག་ཏུ་གོང་ས་མཆོག་གི་སྐུ་པར་སྦས་བཤམ་གནང་མཁན་དེ་འདྲ་རེད།",
    "བཟའ་ཟླ་དབྱངས་ཅན་ལྷ་མོའི་གཉེན་ཉེ་དིལ་མགོ་ཚང་སོགས་ཁམས་རིགས་མང་པོ་དང་འབྲེལ་གཏུགས་གླེང་མོལ་ཇི་སྙེད་བྱ་སྐབས་བྱུང་།",
    "འཇུ་ཆེན་ཐུབ་བསྟན་གཏན་ལོག་རེད་ཟེར་བ་དང་།",
    "རྒྱ་མིས་ལྷ་སར་ཁང་པ་སྤྲད་ཡོད་པ་རེད་ཟེར་བའི་སྐད་ཅོར་མང་པོ་རྒྱག་གི་ཡོད་པའི་གནས་ཚུལ་ཤེས་བྱུང་།",
    "རྒྱ་མིས་ཁྱེད་ལ་ལྷ་སར་ཁང་པ་སྤྲད་འདུག་ཟེར་གྱི་ཡོད་རེད།",
    "ང་རང་ལ་རྒྱ་མིས་ལྷ་སར་ཁང་པ་ཞིག་སྤྲད་ན་ཡག་པོ་རེད།",
    "གང་དུ་ཡོད་པ་རེད་ཅེས་དྲི་བ་བྱས།",
    "ཁང་པ་ཟེར་བ་དེ་ས་རྡོ་གཉིས་ལས་བཟོས་པ་ཞིག་ཡིན་དུས་མི་སུ་ཞིག་གིས་རུམ་ནང་སྦས་ཐབས་ནི་མེད།",
    "ཁང་པ་ཡོད་པ་རེད་ཟེར་མཁན་ལ་དྲིས་ན་ལོས་ཤེས།",
    "གཏན་ལོག་གི་ཐད་ལ།",
    "ཁྱེད་རང་ཚོས་བསམ་བློ་ཡག་པོ་འཁོར་དགོས་པ་རེད།",
    "ངོས་རང་ནི་རྒྱ་གུང་ཁྲན་གྱི་འོག་ཏུ་བསྡད་མ་ཕོད་ནས་མི་ཡུལ་དུ་གྱར་དགོས་གྱུར་སོང་།",
    "མི་ཡུལ་དུ་གྱར་ནས་བཟུང་མི་ཚེའི་རིང་དུ་ཕ་ཡུལ་དུ་ལོག་ཐུབ་པ་ཞིག་ཡོང་རྒྱུའི་རེ་བ་ནི་ཉི་མ་གཅིག་ལ་བརྗེད་མ་མྱོང་།",
    "ང་ཚོས་ཕ་ཡུལ་དུ་ལོག་མི་ཐུབ་པའི་ཐབས་ཤེས་ནམ་ཡང་བྱེད་མ་མྱོང་།",
    "ང་ཚོ་ཕ་ཡུལ་དུ་གཏན་ལོག་ཐུབ་པ་ཞིག་བྱུང་ན།",
    "ཁྱེད་ཚོས་བློ་ཕམ་བྱེད་ཤེས་ཀྱི་རེད་བསམ་པ་གཏན་ནས་མེད་ལ།",
    "བྱེད་དགོས་ཀྱི་མ་རེད་ཅེས་བརྗོད་པ་ལས་གཏན་ལོག་མིན་ཟེར་བ་དང་།",
    "སྲིད་ཚབ་བློ་བཟང་བཀྲ་ཤིས་ཀྱི་སྲིང་མོ།",
    "ཁོང་རྣམས་ཀྱིས་གོང་གི་དཀྲོག་གཏམ་དཀྲུག་ཤིང་དེ་དག་གོ་ཐོས་བྱུང་ཡོད་བཟོ་མཐོང་ཡང་གསལ་བརྗོད་མི་བྱེད།",
    "ཁོང་རྣམས་ཐོན་ཁར་རེ་རེ་བཞིན་ལག་པ་བཏང་སྟེ་རང་རེ་རྒས་འཁོགས་རྣམས་ངོ་ཐུག་གི་མཐའ་མ་དེ་ཡིན་སྲིད།",
    "སྐྱེ་བ་ཕྱི་མར་རང་རེ་རྣམས་ལས་དོན་མཉམ་དུ་བྱེད་པའི་ལས་སྨོན་ཡོད་སྲིད།",
    "ད་དུང་ངོ་མཇལ་ཡོང་བའི་རེ་སྨོན་ཡོད།",
    "ང་ཚོ་བོད་མི་རྣམས་སེམས་ཤུགས་ཆག་གི་མ་རེད་ཅེས་བརྗོད་ཀྱི་འདུག་དེབ་དང་པོ།",
    "ཡང་གསང་བའི་ལས་དོན་བྱེད་མཁན་ཡིན་ཟེར་བའི་དེ་སྔ་ཐུག་མ་མྱོང་བའི་སྔ་རྗེས་མི་གྲངས་བཞི་ཙམ་མཚན་མོར་སྡོད་སར་ཡོང་སྟེ།",
    "ལྷག་པར་དེང་སྐབས་གོང་ས་མཆོག་གི་སྐུ་པར་ཉར་མི་ཆོག་པའི་དམ་བསྒྲགས་དང་།",
    "འབྲས་སྤུངས་སུ་ལས་དོན་རུ་ཁག་ཏུ་མི་གྲངས་༧༧ ཡོད་པའི་ནང་རྒྱ་རིགས་མི་གྲངས་བརྒྱད་ལས་མེད་ལུགས་སོགས་འབྲས་སྤུངས་ལས་དོན་རུ་ཁག་གི་འགོ་ཁྲིད་བརྒྱད་ཡོད་པའི་གྲས་སུ་ཡོད་པ་ལས་བྱེད་བགྲེས་ཡོལ་པ་སྤེན་པ་ཚེ་རིང་ངོ་མས་བརྗོད་འདུག་དེ་འདྲར་བརྟེན་འཐབ་འཛིང་བྱས་ན་ནི།",
    "བཅིངས་འགྲོལ་དམག་མི་ཟེར་བས་དྲག་གནོན་བྱེད་ཆོག་ཏུ་ཡོད་སྟབས་བོད་རིགས་ཚང་མ་ཤི་རྒྱུ་རེད་ཅེས་བརྗོད་ཀྱི་འདུག་པ་ནི་བོད་མི་མང་གི་གནས་སྟངས་དངོས་ཡིན།",
    "ཁོང་ཉིད་ལ་དྭགས་ཏུ་བཞུགས་སྐབས་རང་གིས་ཞབས་ཕྱི་གང་དགོས་ཞུས་པའི་འབྲེལ་འདྲིས་ཆེ་བས་ངོ་ཐུག་སྐབས་ཕན་ཚུན་དགའ་པོ་བྱུང་།",
    "ཁོང་གིས་ནང་མོལ་ཞུ་འདོད་གནང་འདུག་ཀྱང་།",
    "རྒྱལ་བ་ཀརྨ་པའི་མ་ཡུམ་དང་ཡང་མཇལ་མོལ་བྱུང་།",
    "རང་ཉིད་ཀྱི་རེ་བ་ནི་མར་ཕྱོགས་འཁོར་ལམ་བརྒྱུད་བསྐྱོད་ཞོར་སོག་ཙན་དན་དགོན་མཇལ་འདོད་དང་།",
    "བུ་མོ་གདུགས་དཀར་ལྷ་མོ་མ་བུ།",
    "བྱ་མོ་སྒྲོན་དབྱངས་མ་བུ།",
    "བཀྲ་ལྷ་བཅས་མ་ཤི་བར་བསྡད་ཡོད་པར་ངོ་ཐུག་ཡོང་རེ།",
    "ཕྱི་ཟླ་༨ ཚེས་༢༦ ཉིན་ཁྲེན་ཏུའུ་ནས་རླངས་འཁོར་ནང་ཁྲི་མོན་ཤན་དུ་ཡོང་།",
    "སྦག་སྦག་གཉིས་བཅས་ཁྱོན་སྣེ་ཤན་པ་མི་གྲངས་༢༤ རྒྱ་རིགས་ཞེ་ཅིག་རྟག་ཏུ་མཉམ་བསྐྱོད་བྱེད་ཀྱི་ཡོད།",
    "སྐུ་འགྱེད་རྒྱ་སྒོར་༥ རེ།",
    "རྩེ་ལྷ་ཁང་གསར་རྙིང་སྟེང་ཤོད་ཕྱི་ནང་གི་ཤུལ་དང་།",
    "འོན་ཀྱང་བསྐྱར་གསོ་ཐུབ་རེ་ལ་འབད་བཞིན་རེད།",
    "ང་ཚོའི་ལྷ་ཁང་གཅིག་གི་ནང་རྟེན་ཡང་སྐྱེ་བ་ནས་ཚེ་རབས་ཏུ་བསྐྱར་གསོ་ཐུབ་ཐབས་མེད་པ་ལྟར།",
    "སྐབས་རེར་བགད་མོ་བཅས་སྣ་ཚོགས་སུ་བསྡད།",
    "ཡང་དོགས་ཟོན་བྱེད་མཁན་ཡང་རེ་གཉིས་ཡོད་ཚོད་འདུག་རང་ཁྱིམ་དང་།",
    "དགོན་ཡུལ་གང་སར་རྒྱུན་རིང་ཙམ་བསྡད་ཐུབ་རེ་ཐོག་མ་ནས་ཡོད་ཀྱང་།",
    "ཁོང་ཚོས་རྒྱང་ནས་ལྟ་བཞིན་ཡོད་པ་དང་།",
    "ངུ་རེས་བྱས་ཏེ་བསྡད།",
    "སྐུ་འགྱེད་རྒྱ་སྒོར་༥ རེ་ཕུལ།",
    "སྲུ་མོ་རང་ལོ་༨༦ ཅན་སྲས་ཚ་ནིས་ལུ་དང་།",
    "སྟོང་མིན་ལག་རྟགས་སྤྲོད་རེས་དགའ་སྐྱོ་ཟུང་འབྲེལ་རྨི་ལམ་ལྟ་བུ་བྱུང་།",
    "དེ་ཉིན་འཁྲུག་འཛིང་ཤོར་མ་སོང་ཡང་།",
    "གོང་ས་མཆོག་གི་སྐུ་པར་ལྐོག་ནས་ཚང་མར་སྤྲད་པ་ལྟར་བྱས།",
    "མི་ཉག་ར་རྔ་ཁར་ད་དུང་བཙོན་པ་མང་པོ་ལས་མིར་ཡོད་པ་རྣམས་དང་ངོ་ཐུག་རེ་ལམ་ཟུར་ནས་བྱ་རྒྱུ་བྱུང་།",
    "ཁང་སར་བུ་བཀྲ་གཅེས་གཉིས་ཀྱི་བུ་མོ་ཞིག་འདུག་པར།",
    "དེ་དགོང་གསོལ་སྟོན་རྒྱ་ཆེ་བཏེགས་སྐབས་ཞབས་ཞུ་བ་རྒྱལ་རོང་འགུ་ཐང་རྒྱལ་པོའི་མངའ་ཞབས་ཀྱི་ཆས་གོས་ཅན་གྱི་བུ་མོ་ཞེ་གཅིག་རེད།",
    "མི་རྣམས་ཀྱང་རྒྱ་ལུགས་ཆ་ཚང་ཡོད་པ་དེ་འདྲ་རེད་མི་འདུག་ཅིང་།",
    "ཕྱི་ཉིན་ཁྲེན་ཏུའུ་བརྒྱུད་གནམ་ཐོག་ནས་ཕྱི་ཟླ་༩ ཚེས་༡༨ ཉིན་པེ་ཅིང་དུ་སླེབས་སྟེ་མགྲོན་ཁང་ཆེན་མོར་གྲ་སྒྲིག་འདུག་པར་བསྡད།",
    "ཕྲན་གྱི་ཁ་ལོ་པ་དེས་མཐོང་ཡོད་འདུག་པར་གཡའ་ཨན་ནས་འགྲོ་བའི་ལམ་བར་ཞིག་ཏུ་ཕྲན་ལ་ཁོང་རང་གི་ཨ་མ་ལོ་མཐོན་པོ་ཡིན།",
    "དེ་ཉིན་ཐོག་མར་ནས་ཀྲའོ་ལགས་ཀྱིས་ཐུབ་བསྟན་རྣམ་རྒྱལ་ཁྱེད་རང་ཀྲུང་དབྱང་གོང་རིམ་ཆབ་སྲིད་ཅུས་ནས་འཁོར་ཞག་གདན་ཞུ་གནང་བ་ཞིག་རེད།",
    "ངས་ཀྲུང་དབྱང་གི་ཚབ་བྱས་ཏེ་ཉན་གྱི་ཡིན།",
    "ཕྲན་རང་གཉེན་འཕྲད་དུ་ཡོང་ཆོག་པའི་རེ་འདུན་ལྟར་གོང་རིམ་ནས་ཐུགས་འཁུར་བཞེས་པར་དགའ་སྤྲོ་ཆེ།",
    "དེ་ལ་བརྟེན་ནས་ང་ཚོ་མི་ཡུལ་དུ་གྱར་བའི་བོད་མི་རྣམས་རང་ཡུལ་དུ་ལོག་ཐུབ་པ་རེད་བསམ་པའི་རེ་བ་དང་ཡིད་ཆེས་བྱས་ནས་ཡོད།",
    "དེ་སྔ་ཀྲུང་དབྱང་གི་དཔོན་རིགས་མང་པོ་ཞིག་དང་འབྲེལ་འདྲིས་ངོ་ཤེས་ཡོད་པ་རྣམས་དང་ངོ་ཐུག་བྱུང་ན་བསམ་པ་ཡིན།",
    "རྒྱ་བོད་ཕན་ཚུན་གཅིག་ཕན་གཅིག་གྲོགས་སུ་མཉམ་གནས་ཡོང་ཐབས་བྱ་རྒྱུ་ཡིན་ལུགས་བཀའ་གནང་བཞིན་པ་རེད།",
    "ང་ཚོས་ཀྱང་མོས་མཐུན་ཞུ་ཡི་ཡོད།",
    "རྒྱ་ནག་ལ་ལྟོས་ཏེ་བོད་ཡར་རྒྱས་འགྲོ་དགོས་པ་ཡིན་དུས་ནམ་ཞིག་ན་ཀྲུང་དབྱང་གིས་ད་ཆ་བོད་རང་ཉིད་ཟུར་དུ་བསྡད་ན་ལས་ཀྲུང་དབྱང་ནས་ལྟ་རྟོག་བྱེད་ཐུབ་ཀྱི་མི་འདུག་ཅེས་ཟེར་དགོས་པ་ཆགས་སྲིད་ཀྱི་རེད་ཅེས་ཀྱང་གསུང་གནང་གི་ཡོད་ཅེས་བརྗོད།",
    "ལས་འགུལ་དེའི་ནུས་པ་ག་དུས་ཀྱང་ཡལ་གྱི་མ་རེད་གསུངས་པ་རེད།",
    "ལས་འགུལ་དེའི་ནུས་པ་ཡལ་ཚར་བ་རེད།",
    "ཁྱེད་རང་གིས་བལྟས་ན་ཤེས་ཀྱི་རེད།",
    "ཚོད་དཔག་མི་ཐུབ་པར་རང་གི་འདོད་ཚུལ་ལྟར་གསུང་མི་ཉན་པ་རེད།",
    "བདུན་དགུའི་གནས་ཚུལ་འཇར་མན་ཤར་ནུབ་སྦལ་ཀྲིག་ལྕགས་རི་ཆེན་མོ་གཏོར།",
    "ཡིན་ནའང་དངོས་ཡོད་དེ་འདྲ་མ་རེད།",
    "ཐོག་མར་རྒྱལ་ཁབ་མང་པོ་ཞིག་ཨུ་རུ་སུའི་ཁོངས་སུ་འདུས་པ་ཡིན་སྟབས་ཁ་འཐོར་བའི་སྐབས་སུའང་རང་རང་སྔར་རྒྱུན་སོ་སོ་བྱེད་ཆོག་ཏུ་ཡོད་པས་དཀའ་ངལ་མེད་པ་རེད།",
    "དེ་སྔ་མི་བཞི་ཤོག་ཁག་གིས་སྨྱོ་བསྡད་པའི་སྲིད་བྱུས་འོག་བཟོ་ཞིང་མང་ཚོགས་ལ་དཀའ་ངལ་ཆེན་པོ་བྱུང་ཡོད།",
    "ཆབ་སྲིད་ལམ་ལུགས་ཀྱི་སྲིད་བྱུས་དམ་དུ་བཏང་གི་ཡོད་པ་རེད།",
    "བཟོ་ཞིང་མི་དམངས་ནས་ཀྱང་ད་ལྟའི་སྲིད་བྱུས་འདི་བརྟན་པོར་གནས་ཐུབ་ན་བསམ་པའི་བསམ་ཚུལ་འཛིན་ཏེ་རང་གི་ལས་དོན་རང་གི་བྱེད།",
    "རང་གི་ཡོང་འབབ་རང་གིས་སྤྱོད་བཞིན་བློ་བདེ་པོར་གནས་ཡོད་པ་རེད།",
    "ཁ་འཐོར་སྟངས་མི་ཤེས་པའི་དཀའ་ངལ་ཡོད་པ་རེད།",
    "རང་ཉིད་ཀྱི་ཆེ་མཐོང་བརླག་གཞི་ཆགས་ཀྱི་རེད།",
    "རང་འདོད་ཀྱི་བཀའ་མོལ་དེ་འདྲ་མང་པོ་གསུང་ན།",
    "ཀྲུང་གོའི་མི་མང་ཁོང་ཁྲོ་བྱེད་ཀྱི་རེད།",
    "ཀྲུང་གོའི་རྒྱལ་ཁབ་ཁ་འཐོར་གྱི་མ་རེད།",
    "ཀྲུང་གོའི་རྒྱལ་ཁབ་ནི་ཡར་རྒྱས་འགྲོ་བཞིན་པ་ཡིན་སྟབས་འཛམ་གླིང་རྒྱལ་ཁབ་ཚོས་ཚོང་འབྲེལ་བྱེད་མཁན་འཚང་ཁ་ཡོད་པ་རེད།",
    "མཁྱེན་བཞིན་དུ་རང་གི་འདོད་ཚུལ་གསུང་བསྡད་ཀྱི་ཡོད་པ་དེས་རང་ཉིད་ཀྱི་ཆེ་མཐོང་ལ་གནོད་ཀྱི་རེད་ལ།",
    "ཀྲུང་གོའི་རྒྱལ་ཁབ་ཀྱི་དབུ་དམངས་ཚང་མ་ཁོང་ཁྲོ་ལང་གི་ཡོད་པ་རེད།",
    "ཕྱི་རྒྱལ་ནས་ཡུལ་གྱར་བོད་མི་ལྔ་བརྒྱ་རྒྱ་གར་ནས་ལྷ་ས་བར་གོམ་བགྲོད་ཀྱིས་ཡོང་གི་ཡིན་ཞེས་ལབ་སྟེ་རྙོག་གྲའི་ལས་འགུལ་སྤེལ་གྱི་ཡོད་པ་རེད།",
    "འགྲོ་ས་ཡོད་པ་མ་རེད་ཅེས་གསུང་དགོས་ཀྱི་རེད་དེ་གསུང་གི་ཡོད་པ་མ་རེད།",
    "བོད་དོན་དེ་འོས་བསྡུས་ཐག་གཅོད་བྱེད་ཀྱི་ཡིན་ཟེར་གྱི་ཡོད་རེད།",
    "མི་མང་གི་དཀའ་ངལ་སེལ་ཐབས།",
    "མི་མང་ལ་དཀའ་ངལ་ཡོང་སྐབས་རོགས་པ་གནང་བར་དགའ་བསུ་ཞུ་དགོས་ཀྱི་ཡང་རེད།",
    "འོན་ཀྱང་དགའ་བསུ་ཞུ་འོས་པའི་རོགས་རམ་གནང་བ་དང་སྦྲགས་གུང་ཁྲན་ཏང་གི་བྱས་ཉེས་ཀྱིས་བྱུང་བ་རེད་གསུང་གི་ཡོད་པ་རེད།",
    "ཐུབ་བསྟན་རྣམ་རྒྱལ་ཁྱེད་ཀྱིས་ཤེས་ཀྱི་རེད།",
    "དེ་འདྲ་མ་རེད།",
    "ཁྱེད་རང་ནས་ཀྱང་ཤེས་ཀྱི་རེད།",
    "བཀའ་མོལ་མང་པོ་བྱུང་ཡོད་ཀྱང་ཕན་འབྲས་བྱུང་མེད།",
    "༡༩༩༢ ལོ་ནས་འབྲེལ་བ་ཆད་པ་རེད།",
    "དེ་ལ་ཁྱེད་རང་གི་བསམ་ཚུལ་གང་འདྲ་ཡོད་དམ་ཞེས་དྲི་བ་བྱེད།",
    "དེ་ནས་ཁོང་གི་གསུང་པའི་ལན་དུ།",
    "ཕྲན་གྱིས་ཀྲུང་དབྱང་ལ་རེ་འདུན་ཞུས་པ་ལྟར་ཀྲུང་དབྱང་གི་གཟིགས་ཚུལ་རྣམས་གསལ་པོར་གསུང་པར་དགའ་བསུ་ཞུ་རྒྱུ་ཡིན།",
    "སྐུ་ཞབས་ཀྲའོ་ལགས་ཀྱིས་ཀྲུང་དབྱང་གི་ཚབ་གནང་སྟེ་བཀའ་གནང་བ་དེ་ཚོའི་ཐད།",
    "འཛམ་གླིང་གི་སྐྱེ་བོ་ཐམས་ཅད་བདེ་བ་འདོད་པ་དང་།",
    "བདུན་དགུའི་འཇར་མན་ཤར་ནུབ་སྦལ་ཀྲིག་ལྕགས་རི་ཆེན་མོ་གཏོར།",
    "སྐབས་དེར་རང་ཉིད་ཀྱི་བསམ་ཚུལ་ལའང་ཨུ་རུ་སུ་རྒྱལ་ཁབ་ནི་གུང་ཁྲན་རིང་ལུགས་ཀྱི་ཕ་མ་ལྟ་བུ་དེ་རེད།",
    "ང་ཚོའི་གནས་ཡུལ་རྒྱལ་ཁབ་ནི།",
    "མང་ཚོགས་ཀྱིས་དེ་འདྲའི་ལས་འགུལ་འདྲ་མིན་བྱེད་སྐབས་འགོ་ཁྲིད་སུ་ཡིན་དེས་འགྲིག་མིན་སྐོར་ལམ་འཕྲལ་བརྗོད་སྲོལ་མེད་པ་ཞིག་ཡིན་འདུག་ཕར།",
    "བོད་རིགས་ཐེ་བའི་ཀྲུང་གོའི་རྒྱལ་ཡོངས་མི་མང་དུང་ཕྱུར་༡༢ ཀྱི་ཐག་གཅོད་བྱེད་ཀྱི་ཡིན་ཟེར་བ་དེ་འདྲ་ཡིན་གྱི་མ་རེད།",
    "དུ་ཡོད་པ་དེའི་བསམ་བློའི་མོས་པ་ཇི་ཡོད་འདོན་ཆོག་པ་དང་།",
    "མོས་པ་གང་ཡོད་ཉམས་ཞིབ་བྱེད་པ་ལྟ་བུར་དགེ་སྐྱོན་མེད་པ་རེད།",
    "དེ་མིན་གསུང་ཕྱོགས་གབ་ཕྱི་ལོག་པ་ཞིག་མཐོང་གི་རེད་ཅེས་སོགས་བརྗོད་པར།",
    "དེ་ནས་བསྐྱར་དུ་རང་རེ་རྣམས་ལྷན་འཛོམས་གནང་དགོས།",
    "དེ་རིང་གི་གནས་ཚུལ་རྣམས་གོང་རིམ་ལ་ཞུ་རྒྱུ་ཡིན་ཞེས་གསུངས་ནས་དེ་དགོང་གསོལ་སྟོན་དང་བཅས་གྲོས་མོལ་གྲོལ།",
    "པཎ་ཆེན་སྐུ་གོང་མའི་ཡང་སྲིད་ཐད་ལ་ཀྲུང་དབྱང་གི་ཕྱོགས་ནས་གང་ཡོང་ཞུས་ཡོད།",
    "ཕྲུ་གུ་ཞིག་པཎ་ཆེན་ཡང་སྲིད་ཡིན་ཞེས་འཛམ་གླིང་དུ་བསྒྲགས་པ་རེད།",
    "ཆབ་སྲིད་ཀྱི་ཆོ་གའི་ནང་དུ་ཡོད་རེད་དམ།",
    "མ་འཚམས་པའི་གནང་སྟངས་དེ་འདྲ་རེད་ཅེས་སོགས་མང་དག་ཅིག་གསུངས།",
    "ལམ་ལུགས་དང་མཐུན་པར་ཇོ་བོ་ཤཱཀྱ་མུ་ནེས་ཐག་གཅོད་གནང་བ་དེ་པཎ་ཆེན་མ་རེད་སུས་ཟེར་གྱི་རེད།",
    "ཁྱེད་རང་གིས་མཇལ་འཕྲད་ཞུས་ན་ཤེས་ཐུབ་ཀྱི་རེད་ཅེས་སོགས་མང་པོ་གསུངས།",
    "རང་ཉིད་ནས་ཀུན་གཟིགས་པཎ་ཆེན་སྐུ་གོང་མ་ཐེངས་དྲུག་མཇལ་མྱོང་།",
    "བཀའ་མོལ་རྒྱུན་ལྡན་ལྟར་གནང་རྗེས་དགོང་མོའི་གསོལ་སྟོན་ཟབ་རྒྱས་གནང་སྟེ་གྲོལ།",
    "རྒྱ་ནག་གི་རྒྱལ་ཕྲན་ནང་ཕན་ཚུན་འཐབ་རྩོད་རང་བཞིན་ཅན་དུ་གནས་རིང་བོད་ཀྱི་སྟོབས་ཤུགས་རྩེ་མོར་སོན་ཏེ་ཡོད་པའི་སྐོར།",
    "སོག་པོ་ཡོན་གོང་མས་རྒྱ་ནག་ལྷོ་བྱང་ཡོངས་རྫོགས་གཅིག་གྱུར་བཟོས་ནས་ལོ་མང་སོང་རྗེས་ཡོན་གོང་མའི་དུས་རབས་རྫོགས།",
    "ཕྲན་བུ་ཕྲན་བུའི་ཁྱད་པར་ཙམ་རེད།",
    "དེང་སང་བོད་རིགས་ཡོངས་རྫོགས་ལམ་ལུགས་ལྟར་མི་རྩིས་གྲངས་བཤེར་ལོ་ལྟར་བྱེད་ཀྱི་ཡོད་པ་རེད་ཀྱང་།",
    "ཕྲན་གྱིས་སྤྱན་རས་གཟིགས་ཀྱི་རྣམ་སྤྲུལ་སྟོན་པ་རྒྱལ་བའི་འབྱུང་གནས་ཀྱི་དུས་སུ་རྒྱ་གར་གྱི་རྒྱལ་པོ་ས་ལ་ཡི་ས་ག་ཟེར་བ་དེ་བོད་ལ་ཡོང་སྟེ།",
    "ཁོང་གིས་ཡིད་ཆེས་གནང་སྟེ་ཁུངས་གཏུགས་ས་ཡག་པོ་འདུག་ཅེས་ཟེར།",
    "ཡང་ཁོང་གིས་འཛམ་གླིང་གི་མི་འབོར་ཧ་ཅང་མང་དུ་འགྲོ་བཞིན་པ་རེད།",
    "ཕྱི་ལོ་༡༩༥ ནང་མི་འབོར་དུང་ཕྱུར་དྲུག་དང་ས་ཡ་བདུན་ཙམ་རེད།",
    "ད་ཆ་དུང་ཕྱུར་བཅུ་བརྒལ་འགྲོ་ཡི་ཡོད་པ་རེད།",
    "དལ་འབྱོར་བཅོ་བརྒྱད་ཚང་བའི་མི་ལུས་ཀྱང་ཐོབ་དཀའ་བས་ཡིན་འགྲོདེ་ནི་སེམས་གཙོ་སྨྲ་བའི་ལྟ་སྟངས་ཤིག་རེད།",
    "ཀྱིས་སྐྱེ་འགོག་ཡོང་གི་རེད།",
    "དེ་དག་གི་ཁོངས་སུ་ཡོད་པ་རྣམས་དེང་སང་གི་མི་འབོར་གྲངས་བཤེར་ཁོངས་སུ་ཚུད་ཀྱི་མེད་པས་ཀྱང་ཡིན་འགྲོ།",
    "མོན་པ་རིགས།",
    "ཁོང་ཚོས་ངོས་ལེན་བྱེད་པ་སོགས་ཉིན་ཧྲིལ་པོར་བགྲོ་གླེང་བྱས་ནས་དགོང་མོའི་གསོལ་ཚིགས་རྒྱས་སྤྲོས་བྱས་འདུག་དེབ་དང་པོ།",
    "སྣེ་ལེན་ཡག་པོ་ཞུས་གསུང་གི་འདུག་པར་ཁྱེད་ནས་སྣེ་ལེན་མ་འགྲིགས་པ་ཇི་ཡོད་གསུང་རོགས་གནང་།",
    "ལོ་རབས་བདུན་བཅུ་དང་བརྒྱད་བཅུའི་ནང་ང་ཚོའི་དབུ་འཁྲིད་གོང་མ་རྣམས་དང་མཇལ་འཕྲད་བཀའ་མོལ་ཇི་བྱུང་ཞིབ་འཇུག་བྱས་པ་ཡིན།",
    "ཁྱེད་ཀྱིས་གསུང་དོན་རྣམས་ང་ཚོས་ཤེས་སོང་།",
    "གླིས་ཙོ་མིན་བཅས་དང་བཀའ་མོལ་བྱུང་།",
    "ཁྱེད་རང་གི་དགོངས་ཚུལ་གསལ་པོ་དང་།",
    "ནུབ་ཕྱོགས་རྒྱལ་ཁབ་ཚོའི་མི་སྣའི་དབར་ནས་ཁོང་གི་དགོངས་ཚུལ་ལམ་དུ་གཏོང་གི་རེད་བསམ་གྱི་མི་འདུག་ལམ་དུ་གཏོང་གི་རེད་དམ།",
    "ཐག་རིང་པོ་རེད།",
    "རྒྱུན་རིང་པོ་རེད།",
    "དེ་ལྟར་བྱུང་ནའང་འགྲིགས་ཀྱི་རེད།",
    "འགྲིག་པ་གང་ཡང་ཡོང་གི་མ་རེད།",
    "གཞན་ཡང་ཁྱེད་རང་གིས་ཐབས་ལམ་འདོན་རྒྱུ་ཡོད་ན་ཡག་པོ་འདུག་ཅེས་ཟེར།",
    "ངས་ཀྲུང་དབྱང་གི་ཚབ་ཞུས་ཏེ་ཉན་གྱི་ཡིན།",
    "ལྷ་ས་བ་བོད་རིགས་བསྟན་པ་ལགས་ཀྱང་གུང་ཁྲན་ཏང་མི་ངོ་མ་རེད་ཀྱང་བོད་ཞེན་ཡོད་མཁན་ཞིག་རེད།",
    "སྐབས་དེ་དག་ཏུ་གང་ཞུས་པ་རྣམས་ཕྲན་སྒེར་གྱི་བསམ་ཚུལ་མིན་པར་བཀའ་ལག་འཁྱེར་གཞིར་བཟུང་བ་རེད།",
    "ཀྲུང་དབྱང་གི་ཕྱོགས་ནས་ཀྱང་བཀའ་གང་གནང་བ་མ་ནོར་བར་ཕར་སྙན་སེང་ཞུས་ཏེ་ཧེ་བག་མེད་པ་བྱུང་ཡོད།",
    "རང་ཉིད་ནི་རྒྱ་བོད་དབར་གྱི་བང་ཆེན་ཞིག་ཡིན་སྟབས་བང་ཆེན་བཟང་པོ་ཞིག་ཡོང་བའི་རེ་བ་ཆེན་པོས་ལྷག་བསམ་རྣམ་དག་བྱས་ཡོད།",
    "ཡག་པོ་འདུག་སྐབས་དང་དུས་ཀྱི་གནས་སྟངས་ལ་ལྟོས་ཏེ་བཙན་བྱོལ་བོད་མི་རྣམས་རང་ཡུལ་དུ་ལོག་ཐུབ་པ་ཞིག་ཡོང་བའི་རེ་བ་ཆེན་པོ་ཡོད།",
    "ཀྲུང་དབྱང་ནས་དེ་སྔ་ཕན་ཚུན་གབ་རེས་འུབ་རེས་མ་བྱེད།",
    "ཕན་ཚུན་ཚོང་རྒྱག་གི་མ་རེད་གསུང་མྱོང་།",
    "སྐབས་རེ་དེ་འདྲ་ཡོང་གྲབས་ཆགས་ཀྱི་འདུག་དེ་ཚོ་ནི་ནོར་འཁྲུལ་ཡིན་སྟབས་ཡོ་བསྲང་བྱེད་མི་ཐུབ་པ་མ་རེད།",
    "ད་ལྟ་ལོ་ལྔ་བཅུ་རེད་མི་ལོ་སུམ་ཅུ་ཡུན་རིང་པོ་མ་རེད་གསུངས་མྱོང་།",
    "དེ་འདྲའི་དགོངས་པ་བཞེས་ན་ནོར་འཁྲུལ་རེད་སྙམ་པ་ཡོད།",
    "བོད་རེ་བས་ཕུང་ཟེར་བའི་དཔེ་དོན་བརྗོད་སྲོལ་ཡོད་པ་ལྟར་རེད་མ་ཤོར་ན་སྙམ་པ་ནི་རང་ཉིད་སྒེར་གྱི་བསམ་ཚུལ་ཡིན།",
    "ད་དུང་ཁྱེད་ཀྱིས་མུ་མཐུད་ནས་ལས་ཀ་བྱེད་ཐུབ་པ་བྱུང་ན་ཀྲུང་དབྱང་ནས་དགའ་བསུ་གནང་ངེས་རེད།",
    "ཀྲུང་དབྱང་གིས་སྒོ་ཕྱེས་ནས་ཡོད་པ་རེད།",
    "སོག་ནས་ཡིན་པ་འགའ་རེ་འདུག་དེ་སྔ་ལས་ཅུང་དྲག་ཏུ་ཕྱིན་འདུག་ཀྱང་དེ་སྔོན་གྱི་བླ་རྒན་ཁ་ཤས་ཡོད་པ་རྣམས་ནི་དགོངས་པ་རྫོགས་ཟིན་སྟབས་སེམས་སྐྱོ་བའི་རང་བཞིན་དུ་གྱུར།",
    "ཕྱི་ཚེས་༡༩ ནས་༢༣ བར་ཉིན་བཞིའི་རིང་བཟའ་ཟླ་དབྱངས་ཅན་ལྷ་མོ་ཅན་ཁོང་རྣམས་རྒྱ་ནག་ལྕགས་རི་ལ་སོགས་པར་ལྟ་སྐོར་གང་འཁྲིད་དུ་ཕྱིན་སྟབས་པེ་ཅིང་དུ་ཡོད་པའི་མཆོད་རྟེན་ཆེན་པོ་དེ་མཇལ་ནས་མགྲོན་ཁང་ཆེན་མོར་ཕྱིར་ལོག་གིས་ངལ་གསོས་ཏེ་བསྡད།",
    "ཁོང་ཉིད་བཞུགས་གནས་ཐོག་རྩེག་གསུམ་གྱི་གོང་དུ་རེད་འདུག་པར་སྒོ་རྩར་བབས་ཏེ་སྒུག་ནས་བཞུགས་འདུག་གློག་གི་བགྲོད་ལམ་ནས་ཐོག་ཁར་ཕྱིན།",
    "སྐུ་ཟླ་དེས་ཕྲན་གྱི་སྣེ་ཤན་པར་ངོ་ལེན་གླེང་མོལ་སྐད་སྒྲ་ཆེན་པོ་བྱས་པས།",
    "ངེད་གཉིས་གང་འདོད་ལྟར་གྱི་གླེང་མོལ་བྱ་སྐབས་ཐོབ།",
    "བོད་མི་རིགས་ལ་ཕན་སེམས་ཀྱི་རེ་སྟོང་དེབ་དང་པོ།",
    "ཁོང་བཞུགས་པའི་སྐབས་སུ་ཕྲན་ལའང་ལས་ཀ་ཡོད་ལ་རེ་བ་ཞིག་ཀྱང་ཡོད།",
    "ལས་ཀ་བྱས་པས་ཕན་པ་ཡོང་རེ་ཡང་མི་འདུག་གསུང་པ་དང་།",
    "དེ་རྗེས་ཁོང་ཉིད་སུད་སིར་ཕེབས་ཐུབ་པ་ཞིག་བྱུང་བའི་སྐབས་སུ་གོང་ས་མཆོག་ཀྱང་སུད་སིར་ཞབས་སོར་འཁོད་སྐབས་དང་འཁེལ་བས་ཁོང་རྣམ་གཉིས་ཞལ་པར་ཐོག་འཚམས་ཞུ་གནང་རེས་ཀྱི་གོ་སྐབས་ཤིག་བྱུང་བ་རེད།",
    "ལོ་ཆུང་དུས་ནས་རེ་བ་གཞན་ཞིག་བརྒྱབ་སྟེ་གུང་ཁྲན་ཏང་གི་ཁོངས་སུ་ཞུགས་ཚར་བ་ནས་བཟུང་།",
    "དཀའ་ངལ་ཇི་འདྲ་ཞིག་འཕྲད་ནའང་གུང་ཁྲན་ཏང་གི་ལྟ་བ་མི་འགྱུར་བ་དེ་འདྲ་རེད།",
    "དམིགས་བསལ་གྱི་ཁང་ཁུངས་ཤིག་ཏུ་མཐའ་མའི་གསོལ་སྟོན་རྒྱས་པ་མཛད་སོང་བ་བཅས།",
    "ཧོང་ཀོང་གི་ས་ཁྱོན་རྒྱ་ཆེ་མཐོང་ཐུབ།",
    "ཧོང་ཀོང་གི་ཆེད་དུ།",
    "ནང་གི་འཛིན་ཆས་ཀྱང་འབྱོར་ལྡན་དུ་ཆགས་པ།",
    "ཕལ་ཆེར་ས་ཆའི་རྣམ་པའང་མཚོན་ཐབས་བཟོས་པ་སོགས་ལུང་ཕྱོགས་གཅིག་ལ་རིམ་པ་བཞིན་གནས་གཞི་བཟོས་ཡོད་སར་རེ་རེ་བཞིན་ལྟ་སྐོར་དུ་ངེད་རྣམས་ཚང་མ་ཁྲིད་བྱུང་།",
    "བོད་སོགས་ཀྱི་ངོ་བོ་མཚོན་ཚུལ་བཀོད་སྒྲིག་བྱས་འདུག་ང་ཚོ་རིམ་པ་ལྟར་ཕྱིན་པས་ཁོང་ཚོས་སོ་སོའི་རིག་གཞུང་གི་ཟློས་གར།",
    "འབྲེལ་མོལ་གྱིས་རྒྱུན་རིང་ཙམ་བསྡད།",
    "དེ་དགོང་སྤྱི་ཡོངས་ཀྱི་ཟློས་གར་རྒྱས་པ་ཞིག་འཁྲབ་སྟོན་བྱས་སོང་།",
    "ས་ཆ་དེ་ཕྱོགས་སུ་ཞིང་སྐྱོང་སྐོར་པ་ཡོད་རེད།",
    "མེ་མདའ་སྒྲ་སྐད་ཆེན་པོ་མིན་པ་དེ་འདྲ་ཁུར་རྒྱུ་ཡོད་པ་མི་གྲངས་༤ སྐོར་ཡོད་རེད་ཅེས་ཟེར།",
    "འཛམ་གླིང་གང་དུའང་མེད་པའི་མི་བྱེ་བྲག་པ་དེ་འདྲ་ག་ནས་བྱུང་བ་རེད་ཅེས་དྲིས།",
    "ཐ་ན་རྒྱའི་རོ་ཁང་མང་པོ་བཏོན་ནས་ནག་ཚོང་རྒྱག་གི་ཡོད་པར།",
    "བཅའ་དངོས་ཕོན་ཆེན་འཕྲོག་པ་རེད་ཀྱང་།",
    "ནག་ཚོང་གི་བཅའ་དངོས་ཚང་མ་ཕྱིར་སྤྲོད་དགོས་བྱུང་བ་རེད་ཟེར།",
    "གཞན་ཡང་ཁམས་པ་ཚོང་ལས་པ་འགའ་རེ་བཅས་དང་ལྷོད་མཇལ་བྱུང་བ་དང་།",
    "སྲས་འཇིགས་མེད་ལགས་ཀྱང་མཇལ་ན་རང་རེ་སྒེར་ཕན་ཚུན་གྱི་འགལ་ཟླ་སྤུ་ཙམ་མེད་སྟབས་རང་ཉིད་དགའ་སྤྲོ་ཡོང་ངེས་ལ་ཞལ་པར་ཞིག་ཕུལ་བར།",
    "སྲས་འཇིགས་མེད་ཀྱིས་བླངས་སོང་།",
    "ཁོང་གི་ཐུགས་ལ་མ་བབས་པས་རྒྱལ་མོ་ལའང་འབྲེལ་མོལ་མ་ཐུབ།",
    "དེ་དགོང་ལྷ་སའི་མགྲོན་ཁང་ཆེན་མོར་སླར་ཡང་འབྱོར།",
    "ཟླ་བ་ཕུན་ཚོགས་ཅན་ཁམས་རིགས་མང་པོ་ཚོགས་ཏེ་བསྒུག་ནས་འཛོམས་ཡོད་སར་བསྐྱོད་དེ་ཉིན་དེའི་རིང་གཞིས་བྱེས་བདེ་སྡུག་གི་བསམ་ཚུལ་ཤོད་རེས་ཀྱིས་ཚང་མ་བློ་བདེར་གྱུར།",
    "ཚང་མས་ངོས་ལེན་བྱས་སོང་།",
    "དེ་ལྟར་ཡོད་ན་དཀྲོག་གཏམ་ལ་ཡིད་ཆེས་བྱེད་མི་རུང་བ་རེད།",
    "ང་ལ་ཁང་པ་དགོས་ཀྱི་འདུག་གར་ཡོད་རྩད་གཅོད་རོགས་ལབ་པ་དེས་ཁྱེད་ཚོས་རྩད་གཅོད་བྱས་མིན་ལ་མ་ལྟོས་པར་ཡིད་ཆེས་འཕེར་བ་ཞིག་བྱུང་ཡོད་པ་དེ་ལྟར་རེད།",
    "ཁྱེད་ཚོའི་ལྷག་བསམ་དང་སེམས་ཤུགས་འཛིན་སྟངས་ནི་གཞི་རྩ་དང་འགལ་བའི་ཉེན་ཁ་ཡོད་པ་རེད།",
    "མིའི་ཟེར་སྐད་ལ་ཉན་ནས་སེགས་ཤུགས་བྱེད་པ་དེ་རེད།",
    "ཁོང་ཚོས་དོ་སྣང་ཆེན་པོ་བྱས་ཏེ་ཉན་པ་དང་འགའ་རེས་མིག་ཆུ་ཡང་ཤོར་བའི་ཚོར་བ་བླངས་སོང་།",
    "ཁོང་གིས་བོད་ཕན་ཚུན་གཅིག་གྱུར་ཡིན་ཚུལ་དང་།",
    "གོང་ས་མཆོག་གིས་བོད་རྒྱ་གཉིས་གཅིག་ཕན་གཅིག་གྲོགས་སུ་གནས་ཐབས་བྱ་རྒྱུ་ལས།",
    "འདས་པའི་བཙན་གནོན་དཀའ་སྡུག་གི་ཞེ་འཁོན་མི་ཡོང་བ་དགོས་ཞེས་བཀའ་ཕེབས་ཀྱི་ཡོད་ལུགས་ཙམ་དང་།",
    "༡༩༥༦ ལོ་ནས་བཟུང་གི་དུས་འགྱུར་ཐམས་ཅད་ཀྱི་ཉམས་མྱོང་ཡང་ཡོད།",
    "༡༩༥༩ ལོ་ནས་རང་ཡུལ་དང་བྲལ་ཏེ་མི་ཡུལ་དུ་གྱར་བའི་ཉམས་མྱོང་དང་འབྲེལ་ཕྱི་ལོ་༡༩༧༩ ལོར་སླར་ཡང་རང་ཡུལ་གྱི་གནས་སྟངས་ལྟ་སྐོར་དུ་ཡོང་བས་མི་ལོ་༢ ཐམ་པའི་རིང་གི་བོད་མིའི་དཀའ་སྡུག་ཇི་བྱུང་གི་གནས་སྟངས་ཤེས་རྟོགས་བྱུང་།",
    "དེ་ནས་ད་བར་གྱི་དུས་ཡུན་མི་ལོ་༡༧རིང་གི་གནས་ཚུལ་ད་ལན་མཐོང་བའི་སྐབས་ཁྱེད་ཀྱིས་གསུང་པ་ལྟར་བོད་མི་མང་གི་བདེ་སྡུག་གནས་སྟངས་ནི་གནམ་ས་མགོ་རྟིང་སློག་པ་ལྟ་བུ་ཟེར་བ་དངོས་འབྲེལ་རེད།",
    "ཞིང་པ་ཉམ་ཆུང་དམའ་རིམ་ཁག་གི་སྡོད་ཁང་ཐོག་གཅིག་མ།",
    "བད་ཁའི་སྣེ་མོར་ཚེར་མའི་རིབ་མ་བྱས་པའི་ཁྱིམ་ཚང་མང་པོ་ནི་རང་འཇགས་སུ་བསྡད་འདུག་ཡིན་ནའང་དེ་འདྲ་ཡོང་མི་སྲིད་པ་མ་རེད།",
    "སྟོབས་ཆེན་ཨ་རིའི་རྒྱལ་ཁབ་ལའང་སྤྱང་པོ་མེད་པ་མ་རེད་ཅེས་སོགས་བརྗོད་པར།",
    "ཁོང་གི་ཐུགས་ལ་བབས་པོ་རང་བྱུང་མ་སོང་།",
    "རྗེས་རྗེས་སུ་ང་ཚོ་ཡང་མགྲོན་ཁང་དུ་ལོག་པ་ཡིན།",
    "ཁྱོན་བསྡོམས་ཞག་གྲངས་༤༢ ལས་སྡོད་དུ་བཅུག་མ་བྱུང་།",
    "གོང་ས་མཆོག་ནས་ཁོང་ཚོས་སྐྱོན་བརྗོད་བྱས་པ་རྣམས་ཚིག་ཐོ་ཞིག་བྲིས་ཞེས་ཕེབས་པ་ལྟར།",
    "ཁོང་ཚོས་སྐྱོན་བརྗོད་བྱས་པ་རྣམས་ཀྱི་ཚིག་ཐོ་སྙན་འབུལ་དགོས་སྐོར་གོང་ས་མཆོག་གི་བཀའ་ཕེབས་ལྟར་ཕུལ་བ།",
    "ཚེས་༡༩ ཉིན་པེ་ཅིང་ཕིན་དེ་ཞེས་པའི་མགྲོན་ཁང་ཆེན་མོ་དེའི་ནང་དུ་བསྡད།",
    "ཁོང་གིས་བརྗོད་དོན།",
    "ཕྲན་ཀྲུང་དབྱང་གི་སྐུ་ཚབ་ཡིན་པའི་ཐོག་ནས་ཉན་གྱི་ཡིན།",
    "དེ་སྔ་ཏིང་ཞའོ་ཕིང་གིས་བོད་རང་བཙན་དང་།",
    "དེ་མིན་ག་རེ་གསུང་ནའི་མི་འགྲིགས་པ་མེད་གསུངས་ཡོད་པ་གཞི་གཞག་ཐོག་ཕྲན་རང་པེ་ཅིང་དུ་ཐེངས་གསུམ་བཏང་གནང་བ་ཞིག་རེད།",
    "མི་ཡག་སྡུག་གི་ལྟ་སྟངས་དེ་ལོས་ཡོད།",
    "ཉམས་མྱོང་གིས་ལྡེང་གི་ཡོད།",
    "མགོ་དཀར་པོ་མ་རེད་བར་སྐུའི་འཁྲིས་སུ་བསྡད་པ་ཡིན།",
    "ཁྱེད་རང་རྣམ་པས་མི་ཡག་པོ་མ་རེད་གསུངས་པས་དོན་དུ་གནས་ཐུབ་ཀྱི་མེད་པ་མ་ཟད།",
    "ཀྲུང་གོའི་རྒྱལ་ཁབ་ལ་མཚན་ཤས་ཆགས་རྒྱུ་ལས་གཞན་གྱི་ཕན་ཐོགས་གང་ཡང་ཡོང་གི་མ་རེད།",
    "ལྷ་བརྩི་ནས་སྐུ་པར་ཉར་གྱི་ཡོད་པ་དེ་ཉར་མ་ཆོག་པ་བྱས་ན་ཕན་ཐོགས་མེད་ཐོག་ངོ་ཚ་བའི་རང་བཞིན་ལས་གཞན་གང་ཡང་མེད་པ་རེད་ལ།",
    "ཀྲུང་དབྱང་གི་དཔོན་པོ་ཚོའི་དབར་འབྲེལ་ལམ་ཡག་པོ་ཞིག་བྱུང་ཕྱིན་རྨང་གཞིའི་ཐོག་གི་མཐུན་འབྲེལ་ཞིག་ཆགས་པ་རེད།",
    "བོད་མི་མང་གིས་གྱེན་ལོག་མ་ཐུབ་ཀྱང་།",
    "མི་དགའ་བའི་རྒྱང་ཐག་རིང་དུ་འགྲོ་རྒྱུ་ལས་མི་རིགས་མཐུན་འབྲེལ་གྱི་ཐག་གཅོད་ཐུབ་ཀྱི་མ་རེད།",
    "བཙོན་འཇུག་བྱེད་དགོས་པ་ཆགས་ཀྱི་ཡོད་རེད།",
    "བོད་ལ་རང་བཙན་མ་བྱུང་ན་མི་འགྲིགས་གསུང་གི་ཡོད་པ་མ་རེད།",
    "འོན་ཀྱང་ཀྲུང་དབྱང་ནས་གོམ་པ་མདུན་སྤོས་ཀྱི་དགོངས་བཞེས་སྣེ་གཅིག་མ་གནང་བ་རེད།",
    "གཉིས་ཕན་དོན་ལྡན་ཞིག་འབྱུང་ཐུབ་ཀྱི་རེད་བསམ་གྱི་ཡོད།",
    "ཕན་ཚུན་གཉིས་ཀའི་དངོས་ཡོད་གནས་ཚུལ་ཞིག་མཁྱེན་རྟོགས་གསལ་པོ་ཡོང་གི་རེད་སྙམ་པ་ཡིན།",
    "ངེས་མེད་ཀྱི་དུས་ཤིག་ལ་བོད་མི་ཚོས་རང་འགོ་ཐོན་པ་བྱ་དགོས་པ་ལས་པེ་ཅིང་གཞུང་གིས་འགན་ཁུར་བྱ་ཚོད་མི་འདུག་གསུངས་པ་ལྟ་བུ་ཡོང་མི་སྲིད་མ་རེད།",
    "འོན་ཀྱང་དེ་ཚོ་དེ་དུས་ཀྱི་གནས་ཚུལ་ད་ལྟ་བརྗོད་དགོས་དོན་མི་འདུག་ཁྱེད་རང་རྣམ་པས་བོད་ལ་རང་བཙན་སྤྲོད་ཀྱི་མིན་གསུང་གི་ཡོད་པ་དེ་ལ་དོན་དག་ཅིག་ལོས་ཡོད།",
    "མཚན་སྨད་ཞུས་པ་ཡིན་ན་དེ་ལ་དོན་དག་གང་ཡང་མཐོང་གི་མེད་ལ།",
    "ཆོ་ཡོད་པ་ཞིག་མ་རེད།",
    "ཀྲུང་དབྱང་གི་དབུ་འཁྲིད་ཚོའི་དབར་ཕན་ཚུན་བཀའ་མངགས་དགོས་དོན་རྣམས་མི་ནོར་བ་བྱ་རྒྱུའི་འགན་ཁུར་ཞུ་རྒྱུ་ལས་རང་ཉིད་ཀྱི་བསམ་ཚུལ་འདོན་རྒྱུའི་གོ་སྐབས་མེད་པ་རེད།",
    "ད་ལན་རང་ཉིད་སྒེར་གྱི་བསམ་ཚུལ་འདོན་རྒྱུའི་གོ་སྐབས་བླངས་ཏེ་ལྷག་བསམ་རྣམ་དག་གི་ཐོག་ནས་གང་བསམ་པ་རྣམས་ཞུ་ཡི་ཡོད།",
    "གིས་གསལ་པོ་བརྗོད་དགོས་ཟེར་གྱི་ཡོད་པ་རེད།",
    "ལས་འགུལ་དེའི་ནུས་པ་ཡལ་ཚར་བ་རེད།",
    "ཀྲུང་གོའི་རྒྱལ་ཁབ་ཁ་འཐོར་ཡོད་པ་མ་རེད།",
    "དེ་འདྲ་མང་པོ་ཆགས་ན་མཚན་ཤས་འགྲོ་ཡི་རེད།",
    "ཀྲུང་གོའི་རྒྱལ་ཁབ་ལ་གནོན་ཤུགས་སྤྲོད་ཐུབ་མཁན་མེད་པ་རེད།",
    "ཨ་མི་རི་ཀ་ནས་ཀྱང་གནོན་ཤུགས་སྤྲོད་ཐུབ་ཀྱི་ཡོད་པ་མ་རེད།",
    "དེ་འདྲ་གསུང་ན་མི་མང་པོ་སེམས་སྡུག་བཅུག་གི་ཡོད་རེད།",
    "གསུང་མི་ཉན་པ་རེད།",
    "ཕྱི་རྒྱལ་དུ་ཡོད་པའི་བོད་མི་ཁག་ཅིག་གིས་ཞི་བའི་གོམ་བགྲོད་བྱས་ཏེ་འགྲོ་ཡི་ཡིན་ཟེར་གྱི་ཡོད་རེད།",
    "དངོས་འབྲེལ་བྱས་ན་དེ་མ་བྱེད་གསུང་ན་ཡག་པོ་རེད་དེ་གསུངས་ཡོད་པ་མ་རེད།",
    "བོད་དོན་དེ་འོས་བསྡུའི་ཐག་གཅོད་བྱེད་ཀྱི་ཡིན་ཟེར་གྱི་ཡོད་རེད།",
    "ང་ཚོས་དགའ་བསུ་ཞུས་པ་ཡིན།",
    "དགའ་བསུ་ཞུ་འོས་པ་རེད།",
    "མི་མང་ལ་དཀའ་ངལ་འཕྲད་སྐབས་ཕན་གྲོགས་མཉམ་རུབ་གནང་བ་རེད།",
    "ཕྱོགས་གཅིག་ནས་སྡུག་བཅུག་གི་ཡོད་རེད།",
    "ཀྲུང་གོའི་རྒྱལ་ཁབ་ལ་མི་མང་པོ་ཡོད་པ་རེད།",
    "དེ་འདྲ་གསུང་མི་ཉན་པ་རེད།",
    "ཀྲུང་དབྱང་གི་རོགས་ཕན་ཆེད་བཅིངས་འགྲོལ་དམག་མི་ཁྲི་གསུམ་ཙམ་བཏང་བ་དང་།",
    "བཀའ་མོལ་མང་པོ་བྱུང་ཡོད་ཀྱང་ཕན་འབྲས་བྱུང་མེད།",
    "༡༩༩༢ ལོ་ནས་འབྲེལ་བ་ཆད་པ་རེད།",
    "གུང་ཁྲན་རིང་ལུགས་ཀྱི་ཨ་ཕ་དང་།",
    "ཨ་མ་ལྟ་བུ་ཞིག་ཡིན་པར་བརྟེན་མི་ཚང་མས་གུང་ཁྲན་རྒྱལ་ཁབ་ཚང་མ་དེ་ལྟར་ཆགས་རྒྱུ་ཡིན་པར་ངོས་འཛིན་བྱས་ཡོད།",
    "ཀྲུང་གོའི་རྒྱལ་ཁབ་ཀྱི་མི་མང་དུང་ཕྱུར་༡༢ ཀྱི་ཐག་གཅོད་བྱེད་ཀྱི་ཡིན་ཟེར་བ་དེ་འདྲ་ཡིན་གྱི་མ་རེད།",
    "མོས་པ་གང་ཡོད་ཉམས་ཞིབ་བྱེད་པ་ལྟ་བུ་ལ་དགེ་སྐྱོན་མེད་པ་༥རེད།",
    "ལོག་པ་ཞིག་མཐོང་གི་རེད་ཅེས་སོགས་བརྗོད་རེས་བྱས་པར།",
    "དེར་ལན་འདེབས་བྱས་མ་སོང་།",
    "༡༩༩༢ ལོ་ནས་འབྲེལ་བ་ཆད་པ་རེད།",
    "དངུལ་ཐག་སྣ་མང་པོ་ཞུ་རྟེན་དང་སྦྲགས་ཡང་སྲིད་སྐོར་ཐུགས་འཁུར་བཞེས་རོགས་ཞེས་ཞུས་ཡོད་པ་རེད།",
    "ང་ཚོས་མ་ཞུས་པ་མེད་ཀྱང་།",
    "དེ་ལ་ཀྲུང་དབྱང་ནས་ངོས་ལེན་ཐབས་ཡོད་པ་མ་རེད།",
    "ཤཱཀྱ་མུ་ནེས་ཐག་བཅད་པ་དེ་པཎ་ཆེན་མ་རེད་སུས་ཟེར་གྱི་རེད།",
    "རང་བཞིན་གྱི་ཕྲུ་གུ་ཞིག་མིན་པར་གསལ་པོར་ཤེས་ཐུབ་པ་རེད།",
    "གང་འདྲ་ཞིག་གནང་མིན་ཁྱེད་རང་རྣམ་པའི་ཐུགས་འདོད་རེད།",
    "རྒྱ་བོད་གཉིས་ཀས་རྙོག་གྲ་འདི་ལྟ་བུ་ཞིག་མི་ཆགས་པ་བཟོ་འོས་པ་རེད།",
    "ང་རང་གིས་ཐེངས་༦ མཇལ་མྱོང་།",
    "ཐོག་མ་ནས་ཀྲུང་གོའི་གཞུང་ཚབ་ཆེན་མོར་གཉེན་འཕྲད་ཀྱི་རིང་དུ་སྲིད་དོན་ལས་ཀ་གང་ཡང་བྱེད་མི་ཡོང་ཞུས་ཡོད་ཅེས་སོགས་བརྗོད་པ་ཡིན།",
    "ཕན་ཚུན་ཐུག་འཕྲད་གླེང་མོལ་བྱ་རྒྱུའི་དུས་ཚོད་བཟོས་འདུག་བོད་སྐད་ཐོག་ཐད་ཀར་བརྗོད་རེས་བྱ་རྒྱར་བརྟེན་སྟབས་བདེ་པོ་བྱུང་།",
    "ཏག་ཏག་བསྡད་ཀྱི་མ་རེད།",
    "༢ ཧི་མ་ལ་ཡའི་རི་བརྒྱུད་ས་མཚམས་གཏན་འཁེལ་ཡིན་ལུགས་གསུང་མི་ཉན་པ་རེད།",
    "༣ བོད་ནང་གཏོར་རྒོལ་གཏོང་མཁན་ལས་འགུལ་སྤེལ་མི་རུང་བ་རེད་ཅེས་ཞུས་པ་ཡིན།"
  ]
}