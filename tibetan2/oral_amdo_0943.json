    "འདྲེན་པ་མཆོག་གིས་བརྩེ་བས་གནང་བ་སྩོལ།",
    "མཚན་དཔེའི་ལང་ཚོས་བརྒྱན་པའི་བྱིས་པ་ཞིག།",
    "གཟུར་གནས་བློ་ལྡན་ངང་མོ་འབུམ་ཕྲག་གིས།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་ཕྱོགས་བཅུའི་མཁའ་ལ་བསྒྲགས།",
    "ཁྱོད་ཞབས་པད་མོར་ཡན་ལག་མཆོག་གིས་གཏུགས།",
    "རྒོལ་ངན་དཔུང་ཚོཊ་དམིཊ་མེད་དབྱིངས་སུ་བསྐྲད།",
    "ཡང་དར་བསྟན་པའི་སྐྱ་རེངསརྒྱས་དང་ལྷན།",
    "ཐོན་མི་ཨ་ནུའི་མཛད་བཟང་བདག་གིར་བཞེས།",
    "ངུར་སྨྲིག་ཟོལ་གྱིས་རྣམ་རོལ་འདྲེན་མཆོག་གིས།",
    "རྗེ་བཙུན་བསམ་གཏན་རྒྱ་མཚོར་གཙུག་གིས་མཆོད།",
    "སྲིད་གསུམ་འཁྲི་ཤིང་རྒྱས་པའི་རྩེ་མོ་རུ།",
    "མགོན་ཁྱོད་བགྲང་ཡས་བསྐལ་བའི་སྔོན་རོལ་ནས།",
    "འཇིགས་མེད་སྟོབས་བཅུ་མངའ་བ་ཁྱོད་མཐུ་ལས།",
    "མིང་གི་ལྷག་མར་བྱས་འདི་སུས་མི་བསྟོད།",
    "རེ་ཞིག་མི་བསྲུན་སྒྲ་གཅན་གཏུམ་མོ་མའི།",
    "བརྡ་སྤྲོད་གཞུང་ལུགས་མཚར་སྡུག་སྒེག་པ་མོ།",
    "ཁྱོད་མཐུ་མེས་པོའི་འཕྲུལ་ལས་བྱུང་བ་ཉིད།",
    "སི་ཏའི་ལང་ཚོ་གསར་བ་བརླག་འདོད་ཀྱང་།",
    "ཨ་ཧོ་དེ་ལྟའི་མཛད་བཟང་རི་མོའི་གཟུགས།",
    "ཌབསིལ་ལྗོངས་ཉམས་དགའི་སྐྱེད་མོས་ཚལ་ཡངས་སུ།",
    "ལེགས་ཉེས་རེ་ཁཱ་གསལ་བའི་རི་མོ་འབུམ།",
    "བདེན་གཉིས་ལ་སོགས་གཟིགས་པའི་བློ་གྲོས་ཀྱིས།",
    "གུས་རྟག་སྦྱོར་བའི་རྣམ་དཔྱོད་དྲི་བསུང་གིས།",
    "ཀྱས་པ་རྡོ་རྗེ་འཆང་གི་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "མཚོ་ཡི་རླབས་བཞིན་འཕྱུར་བ་ཁྱོད་གཅིག་རྒྱལ།",
    "ཁྱེད་ཀྱི་མཛད་འཕྲིན་ཟེགས་མ་རེ་རེས་ཀྱང་།",
    "ཁྱེད་ནི་དུས་རབས་ཤིག་གི་སྒྲོན་མེ་ཡིན།",
    "ཁྱེད་ནི་རིགས་རྒྱུད་ཅིག་གི་སྤོབས་པ་ཡིན།",
    "མཚོ་ཆེན་སྔོན་མོའི་རླབས་སྒྲ་རྒྱང་ལ་འཁོར།",
    "ཁྱོད་ཉིད་སྤྲིན་པའི་ཧྲག་བར་ནས།",
    "མཐོང་ཐེངས་རེ་རེར་ཁྱོད་ཉིད་དྲན།",
    "ཁྱོད་ལ་ངོ་མཚར་སྐྱེ་བཞིན་འདུག་༢༡ལོའི་ཧོར་ཟླ་ཚེས་༢ཉིན་རྩེ་ཐང་མགོན་པོ་རི་དུས་ཀྱི་སྤྲིན་པ་འགྱུ་བའི་ཚེ། ཡི་ཉེ་འདབས་ནས།",
    "ཆཌ་གངས་ལྗོངས་ཟ་མ་ཏོག་གི་བཅུད་ལེན་ལྷག་བསམ་གཙང་མའི་འོད་མདངས་འཚེར།",
    "དབྱངས་ཅན་དགའ་བའི་བློ་གྲོས་མཆོག་གི་མེ་ཏོག་ཞལ་འཛུམ་དུས་རྟག་དྲན།",
    "གདུང་བས་མནར་བའི་བོད་པ་ཚང་ལ་བྱམས་བརྩེའི་འོད་སྣང་ཡང་ཡང་གཟིགས།",
    "རིག་པའི་དཔའ་བོ་ཞིག་གི་མཛད་རྣམ་དྲན།",
    "བརྩེ་ཆེན་ཟླ་བའི་ལང་ཚོ་གར་ཏུ་རྩེན།",
    "རྩོད་པའི་ལང་ཚོ་རབ་དཀར་གཟི་མདངས་བཀྲ།",
    "རྨོངས་སད་བློ་སྤོབས་ཤིག་གི་འཁྲི་ཤིང་ལ།",
    "མཚན་བཅུ་ལྡན་པའི་རླབས་ཆེན་སློབ་དཔོན་ཉིན་མོའི་མགོན་པོ་ཁྱོད་མིན་སུ།",
    "གངས་ལྗོངས་སྲོག་གི་དབུགས་སྒོ་འགགས་པའི་དུས།",
    "གངས་ལྗོངས་རིག་པའི་སྒོ་མོ་སླར་ཕྱེ་བའི།",
    "གང་གི་ཐུགས་བསྐྱེད་དཔྱིད་ཀྱི་རྫིང་བུ་ལས།",
    "རྒྱུན་འཁྱོངས་བརྩོན་འགྲུས་ལྕག་གིས་མྱུར་བསྐུལ་ཕྱིར།",
    "འཇིག་རྟེན་དཀར་ངོགས་མཐོང་མྱོང་མེད་པའི་དམུས་ལོང་འཁྲིད་པའི་དམིགས་བུ་ཁྱོད།",
    "བླང་དོར་འབྱེད་ལ་བློ་མིག་ལྡོང་བའི་མི་རིགས་ཤིག་གི་དེད་དཔོན་ཁྱོད།",
    "ཕ་ཡུལ་ལོ་དགུར་མིག་གིས་མ་མཐོང་ཨ་མས་དྲན་པའི་མིག་ཆུ་བཞུར།",
    "འགྲོ་བའི་སྡུག་བསྔལ་གནམ་གྱིས་མི་ཁེབས་དོག་མོ་ས་གཞིས་ཐེག་མ་ཡིན།",
    "ཆད་ལ་ཉེ་བའི་སྐད་དང་ཡི་གེའི་སྡོམ་ཐག་ཕྲ་མོ་དམ་པོར་བཟུང་།",
    "འགའ་ཞིག་རང་གི་ལྟོ་གོས་ཆེད་དུ་མི་ཚེ་གྲོང་ཆོག་ཁྲོད་ནས་སྐྱེལ།",
    "ཁྱོད་ཀྱི་གཟི་ཡིས་ཆོལ་གསུམ་བླ་སྲོག་མ་ཉམས་སྔར་བཞིན་བརྟན་པོར་གནས།",
    "ཁྱོད་ཀྱི་འོད་ཀྱིས་ཐུབ་པའི་བསྟན་པ་མ་རྒུད་སྔར་བཞིན་དར་ཞིང་རྒྱས།",
    "ཀྱེ་མ་ཁྱོད་ཀྱི་འོད་ཟེར་མེད་ན་ང་ཚོའི་མུན་པ་སུ་ཡིས་སེལ།",
    "ཀྱི་ཧུད་ཁྱོད་ཀྱི་ལམ་སྟོན་མེད་ན་ང་ཚོ་ལམ་ཁ་གང་ལ་འགྲོ།",
    "ཁྱད་པར་འཕགས་སོ་མཁས་མཆོག་དམ་པ་དེ་རིང་བདག་གིས་ཁྱོད་ཉིད་དྲན།",
    "བཀའ་དྲིན་ཆེའོ་སྐྱབས་མཆོག་དམ་པ་དེ་རིང་བདག་གིས་ཁྱོད་ཉིད་དྲན།",
    "རབ་མཛེས་སྒེག་མོ་མུ་ཏིག་དོ་ཤལ་ཅན།",
    "དམར་སྨྲིག་ལང་ཚོ་གསར་བའི་འཁྲི་ཤིང་ལ།",
    "གདུང་བའི་མཚོ་མོ་ཀློང་ནས་དེང་ཡང་དྲན།",
    "འཁྲུངས་པའི་གཟའ་སྐར་ཉིན་མོ་སླར་ཡང་དྲན།",
    "ཤེས་བྱའི་བདུད་རྩིའི་ཐིགས་ཕྲེང་རེ་རེ་རྣ་བའི་ལམ་ལ་འཐོར་བའི་དུས།",
    "གང་གི་ཞལ་གསུང་ཨ་མྲྀ་ཏ་ཡིས་མྱོས་པའི་ཅོལ་ཆུང་བུ་ལོ་ཡིས།",
    "ཁྲག་གིས་ས་གཞིར་ཆག་ཆག་བཏབ་པའི་ཡུལ་གྲུ་ཞིག་ནས་ཁྱེད་རང་དྲན།",
    "རི་གང་གི་ཞལ་གསུང་དྲན་ཐེངས་མང་བས་ད་དུང་དྲན་པའི་གདུང་བ་ལྕི།",
    "ཅག་བོད་པའི་སློབ་དཔོན་ཆེན་མོ་བསམ་གཏན་རྒྱ་མཚོར་གུས་པས་འདུད།",
    "ཆ་རྐྱེན་བཟང་ངན་གནས་ལ་མི་གཟིགས་འཆད་རྩོད་རྩོམ་པས་བུ་སློབ་བསྐྱངས།",
    "བསྟན་འགྲོའི་རྒུད་སེལ་མགོན་ཁྱོད་ལྷག་ཏུ་དྲན།",
    "མི་འཇིཊ་ལུང་དང་རིགས་པའི་བརྒལ་བརྟག་གིས།",
    "གང་གིས་ཡུན་རིང་སྦྱངས་པའི་ཤེས་རབ་བཅུད།",
    "ཐུན་མོང་ཐུན་མིན་ལུགས་ཀྱི་བསྟན་བཅོས་ཀྱིས།",
    "ཤེས་རབ་དབྱངས་ཀྱི་རྒྱལ་མོས་ཤིས་པ་སྩོལ།",
    "རླབས་ཆེན་མཛད་རྗེས་རི་མོ་འདི་མཐོང་ཚེ།",
    "གང་ལ་ཅི་འདོད་རེ་བའི་དངོས་གྲུབ་བསྙིལ།",
    "བཤེས་གཉེན་མཆོག་གི་བཀའ་དྲིན་ལེགས་བསམ་ནས།",
    "སོར་བཅུའི་ཐལ་མོ་སྦྱར་ནས་གུས་པས་ཕུལ།",
    "ཕས་རྒོལ་ཀླུ་རིགས་དཔུང་ཚོགས་ཀླད་འགེམས་ཤིང་།",
    "གངས་རིའི་ཡབ་ཆེན་དམར་ཡག་སྟག་གི་ཟླ།",
    "ཁྱེད་ཉིད་བཞུཊ་པའི་བསྟི་གནས་འཁྱག་གིས་བསྡམས།",
    "ཁྱེད་ཉིད་གང་དུ་བཞུད་ཅེས་མཁས་མང་གིས།"
  ]
