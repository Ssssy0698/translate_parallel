    "རག་ཁྲོམ་ལུང་བའི་ནང་རླངས་འཁོར་ལས་བབས་ཏེ་གད་པ་ཞིག་གི་ཁ་ནས་ཆབ་གསང་གནང་སྐབས་སྐུ་ཡོལ་ནས་ཐུར་དུ་ལྷུང་།",
    "ཁོང་གི་སྐུ་ལ་ཉེས་སྐྱོན་ཅི་ཡང་མ་བྱུང་བར་ཕབས་ཐུབ་སོང་།",
    "ང་རང་གི་ལྷམ་འགྲམ་ངོས་ནས་ཡར་ལོའི་གུར་ཀུམ་ཆུན་པོ།",
    "དགོན་དེ་ཀར་བདག་གིས་ཞུས་ངོར་སྣར་ཐང་བའི་སྔགས་བཀླག་ཐབས་རྩ་འགྲེལ་དང་།",
    "བདག་མཚན་ཐུན་གྲོལ་ནས་སྐུ་མདུན་དུ་མཇལ་ཞུར་སོང་།",
    "ཚངས་པ་དྲག་པོ་བསེ་ཁྲབ་པའི་རྗེས་གནང་གི་མཇུག་ཏུ་ལག་ལེན་འགྲིག་ན་ཚངས་པ་ཞི་བའི་རྗེས་གནང་ཀྱང་ཞུས་གསུངས།",
    "མཚམས་གྲོལ་ནས་རས་ཆུང་བ་ཁོང་ཨ་ཁུ་ཤེས་རབ་ཚང་ལ་སོགས་པས་གྲོགས་བྱས་ནས་སྦྱིན་སྲེག་དང་བཅས་པ་ལེགས་པར་གྲུབ།",
    "ཁོང་གི་ཞལ་ནས་ཁྱེད་རང་ལ་སྲུང་མ་ཁྱད་པར་ཅན་ཞིག་ཡོད་ཚེ་སང་ཉིན་རླངས་འཁོར་རྙེད་སྲིད་གསུངས།",
    "བདག་ལ་གདེང་ཚོད་ཅི་ཡང་མེད་པས་དེ་ལ་སུམ་རྐང་སྒྲིག་མི་ཕོད་ཞུས་མོད།",
    "རིགས་གྲྭ་ཚང་གིས་གནང་མི་ཐུབ།",
    "མཚམས་ཤིག་ཁོང་གིས་གཟིགས་ནས་བཀའ་བཀྱོན་གནང་བྱུང་།",
    "སྐྲག་ཐག་ཆོད་སོང་།",
    "ཟླ་དགུ་བའི་ཚེས་བཅོ་ལྔའི་ཉིན་བསྒྲུབ་བྱ་བདུན་ཅུ་བརྒྱད་ཅུ་ལྷག་དགེ་ཚུལ་སློང་གི་བསླབ་པ་ལ་བཀོད་སྐབས་ཕྲན་གྱིས་དགེ་ཚུལ་གྱི་དུས་གོ་བ་བྱས།",
    "ཁྱོད་ཀྱིས་ང་ལ་འདང་ཞིག་རྒྱག་གིན་འཇུག་གམ་གསུངས་བྱུང་།",
    "ཡིན་ན་ཡང་ཅུང་ཙམ་ནས་འཐོག་ཙམ་བྱས་ན་ཡང་ཡར་ཞུ་གིན་འདུག་ཨ་ཁུ་བློ་བཟང་རྒྱ་མཚོ་ཚང་གིས་ན་བཟའ་ནས་འཐེན་ཙམ་བྱེད་ཞོར་ཁ་རོག་བཞུགས་པར་ཞུ་གིན་འདུག་ཡིན་ན་ཡང་ཁོང་སྔར་བཞིན་རེད།",
    "གཙུག་ལག་ཁང་ཚ་དྲོད་ཆེ་བ་དང་ཡུན་རིང་བོ་འགོར་བས་མཚམས་ཤིག་ནས་ཁོང་ཨ་ཁུ་བློ་བཟང་ཚང་ལ་གཟིམས་བབ་བྱུང་།",
    "ཡང་དང་ཡང་དུ་ཕྱག་གིས་དབུ་ལ་རེག་གིན་འདུག་བདག་ལ་སྔོན་ཉམས་མྱོང་ཡོད་པས་འགྲིག་མ་སོང་བསམ་ཀྱང་ཞུ་སྟབས་མི་འགྲིག་ག་ལེར་ཁོང་ལ་བལྟས་པས་གཟིགས་ཀྱིན་འདུག་བློ་བཟང་རྒྱ་མཚོ།",
    "ཁོང་ལྷབ་བེར་བཏང་ནས་འགུལ་ཙམ་ཡང་མི་གནང་བར་བཞུགས་སོང་།",
    "བདག་གི་གྲྭ་ཤག་གསར་བའི་ནང་དུ་ཞག་གཉིས་ལ་བཞུགས།",
    "ཕྱི་དྲོ་ཕྱི་དྲོ་རས་ཆུང་བ་ཤེས་རབ་ཚང་དང་ངེད་གཉིས་རེས་མོས་ཀྱིས་ཟུར་ཁྲིད་བྱས།",
    "ཕྱི་ཉིན་ཞོགས་སྔ་བོར་ངེད་ཅག་མདུན་དུ་མཇལ་སྐབས་སྔོན་དེ་འདྲའི་སྐུ་གཟུགས་བརྗིད་ཉམས་ཆེ་བ་ཞིག་ལགས་མོད།",
    "གསུང་གདངས་དམའ་མོས་མདུན་དུ་སྡོད་གསུངས།",
    "རང་ཉིད་ཀྱང་ཀུར་གུམ་ཆུན་པོའི་ཨ་མ་རུ་གྱུར་བ་རྗེས་དྲན་སྙན་རྩོམ་ཕྱོགས་བསྒྲིགས་ཀྱི་དེབ་དབུ་བརྙེས་པ་ནས་བཟུང་སྟེ་ད་ལོའི་བར།",
    "ལོ་ཟླའི་འགག་ཕྲེང་མང་བོ་བརྒྱུད་པའི་ནམ་ཟླ་རིང་མོའི་ནང་།",
    "ད་དུང་འདིར་མ་འདུས་པ་གཞན་དང་ཊེཁོང་གི་ཞལ་ནས་དངོས་སུ་ཐོས་པའི་གསུང་གླེང་བརྗེད་དུ་ཕངས་པ་གང་མང་ཞིག་ཡོད་ཀྱང་འབྲིར་མི་ལངས་ལ།",
    "གང་ཞིག་བསྟེན་ན་ལེགས་ཚོགས་སྒོ་མོ་འབུམ་འབྱེད་པའི།",
    "བཤེས་གཉེན་ཚུལ་བཞིན་བསྟེན་པས་འཕགས་ཚོགས་རྒྱུ་སྐར་དབུས་ན་མཚན་མོའི་མགོན་པོ་བཞིན།",
    "དད་མོས་མྱུ་གུ་རྒྱས་ཕྱིར་ཆུ་ཐིགས་འདྲེན།",
    "འོན་ཀྱང་ཁྱོད་ཀྱི་གསང་བ་འདི་ནི་བསྙད་བགྱི་མ་ལགས་སོ།",
    "རྒྱུ་དམ་པ་ཚོགས་གཉིས་ཡོངས་སུ་རྫོགས་ཤིང་འབྲས་བུ་སྐུ་བཞི་མངོན་དུ་གྱུར་སྟོབས་ཀྱིས་འགྲོ་བའི་འདྲེན་པོར་གྱུར་བ་ཞིག་གི་ཡོན་ཏན་གྱི་ཆ་ཤས་ཕྲ་མོ་ཙམ་ཡང་།",
    "ཉན་རང་འཕགས་པ་དང་ས་མཐོན་པོ་བས་ཀྱང་སྤྱོད་ཡུལ་མ་ཡིན་མོད།",
    "ཐོས་ལོ་དང་ཤེས་ལོ་ཙམ་མ་ཡིན་པ་ནི་ཁོང་གི་སྦྱངས་འབྲས་ལས་དཔག་ཐུབ་ལ།",
    "ངས་ཁོང་ལ་ཞུས་ནས་དེང་སང་ཡིན་ན་དུས་ཚོད་ཇི་ཙམ་གྱི་བར་ལ་དཔེ་གཟིགས་བྱས་ནས་གཟིམ་པ་ཡིན་ཞེས་ཞུས་སྐབས།",
    "ཁོང་གིས་འོ་དེང་སང་ཡིན་ན་རྒྱུན་ལྡན་དུ་དུས་ཚོད་གསུམ་བཞི་ཡར་མར་བར་ལ་དཔེ་བལྟས་བྱས་ནས་ཉལ་བ་ཡིན།",
    "དང་བོར་དཀའ་ཐལ་དེ་རིང་གི་བརྩི་བཞག་སྔ་མོར་བཟུང་བ་ཡིན།",
    "དེ་ལ་བསམ་བྱུང་གིས་ངེས་པ་རྙེད་པར་བྱས་ཏེ་སྒྲོ་འདོགས་མ་ལུས་པ་བཅད་པ་ནི་འཆད་རྩོད་རྩོམ་གསུམ་གྱི་ཕྱག་རྗེས་ལས་དཔག་ཐུབ་པ་གཟུར་གནས་བློ་ལྡན་ལ་སྨོས་མ་དགོས་ལ།",
    "གང་ཐོས་ལ་བསམ་བྱུང་གིས་སྒྲོ་འདོགས་གཅོད་པ་ནི་མིང་དོན་མཚུངས་པའི་མཁས་པ་སྤྱིའི་ལུགས་སོ།",
    "སྡོམ་གསུམ་རྣམ་པར་དག་པ་མིག་གི་འབྲས་བུ་བཞིན་དུ་སྲུང་བ་ནི་ཐམས་ཅད་མཁྱེན་པ་ཐོབ་པའི་སྒོར་དགོངས་ནས།",
    "རིའི་རྩེ་ལ་སླེབས་ཏེ་ལམ་གྱི་བགྲོད་པ་མཐར་ཐུག་པ་མི་སློབ་པའི་ཟུང་འཇུག་གི་སྐུ་མཉེས་པ།",
    "སྟོབས་ཀྱིས་བདེན་པ་གཉིས་གཅིག་ཅར་དུ་མངོན་སུམ་དུ་གཟིགས་པ་དང་།",
    "ཞིང་དེ་ན་བུད་མེད་གཏན་ནས་མེད་པའི་ཞིང་ཁྱད་པར་ཅན་ཞིག་རེད་གསུང་ཞེས་གསུངས།",
    "གང་གིས་སྲིད་པ་ཇི་སྲིད་པར།",
    "བདག་གི་མིང་ཙམ་བརྗོད་དང་དྲན་པས་ཀྱང་།",
    "ཁོང་ཁྲོ་བྲལ་ཞིང་སླར་ཡང་དེ་དག་གི།",
    "པ་ཡོད་ནའང་རེ་ཞིག་དེ་ཙམ་གྱིས་འཐུས་ལ།",
    "སྔགས་རིམ་ཆེན་མོ་ལས།",
    "དེ་ནས་དེ་ལྟར་གཏན་ལ་ཕབ་པའི་དོན་ཉམས་སུ་ལེན་པ་ཡིན་མོད་ཀྱང་།",
    "མི་བར་འདྲེས་མ་ཆོད་པའི་གདམས་པ་བསྲེ་ལྷད་དང་མ་རྟོགས་ལོག་རྟོག་སོགས་ཀྱི་སྐྱོན་ཕྲ་མོ་ཙམ་ཡང་མ་མཆིས་སོ།",
    "དེ་ལ་ཐད་གར་ངོ་རྒོལ་བྱེད་མཁན་ཡང་བྱུང་མོད་མི་རིགས་གཞན་པའི་མཁས་པ་མང་བོ་ཁོང་གི་ཕྱོགས་རེད།",
    "དེ་དག་རེ་རེའི་མདུན་དུའང་དེ་སྙེད་ཀྱི།",
    "སྐུ་དང་གསུང་གི་བཀོད་པ་དུས་གཅིག་ཏུ།",
    "ཁྱོད་ཀྱིས་ཇི་སྙེད་བཀའ་བསྩལ་པ།",
    "ཞི་གྱུར་མིན་མཛད་ཁྱོད་ལ་མེད།",
    "ཁོང་གིས་རྒྱུན་པར་ཁྱེད་ན་གཞོན་མི་སྐྱ་ཕོ་མོ་ཚོས་གནའ་དེང་རིག་གཞུང་ཟུང་དུ་སྦྲེལ་ཏེ་གཞན་གྱི་རིག་གཞུང་གསར་བ་བོད་རང་གི་ཡི་གེའི་སྟེང་དུ་བསྒྱུར་བ་དང་།",
    "ཁྱོད་ཀྱི་ཡོན་ཏན་སྨོས་མ་དགོས།",
    "སྐྱ་རེངས་ཤར་བའི་གཟི་བརྗིད་ལོའི་གུར་ཀུམ་ཆུན་པོ།",
    "མཆོག་གསུམ་བྱིན་མཐུ་འགྲོ་བའི་དད་མོས་དང་།",
    "མགོན་པོ་གང་གི་ཐུགས་བསྐྱེད་བརྟན་པོ་ཡིས།",
    "གང་གི་མཛད་རྣམ་ཆུ་གཏེར་ཆེན་པོ་ལས།",
    "འགྲོ་བ་འདི་དག་ལ་ཐུགས་རྗེས་གཟིགས་ཤིག།",
    "དོན་ལྡན་བི་ཝང་གི་སྙན་སྒྲ་བསྒྲགས་པ།",
    "དཔང་གྱུར་སྐྱེས་མཆོག་རྣམས་དབྱིངས་སུ་བཞུཊ་མོད།",
    "ཨོཾ་ཁ་ཀ་ངན་རྟོག་དབྱུག་བཙོག་གིས་ཐུབ་བསྟན་དཀྲུཊ་ནས།",
    "རྙེད་གྲགས་༩ཁེ་འདོད་ཀྱི་འཆིང་བུར་རེ་ནས།",
    "གནས་ལྔའི་འོད་སྟོང་སྤྲོ་བའི་ཉིན་མོའི་མགོན།",
    "ལོངས་སུ་སྤྱོད་པའི་སྐབས་གསུམ་བུ་བུ་མོས།",
    "མ་རིག་སྨག་གིས་ཡོངས་སུ་ཁྱབ་པའི་དུས།",
    "ཐུན་མོང་ཐུན་མིན་གྲུབ་པའི་ནོར་ཆེན་ལ།",
    "ཚིག་གི་ལྕི་ཡང་ངལ་གསོའི་གོམ་འགྲོས་ཀྱིས།",
    "གར་སྟབས་བསྒྱུར་བའི་སྒེག་མོའི་འཆོར་སྒེག་གིས།",
    "སོར་མོའི་འཕྲུལ་གྱི་རི་མོས་འོད་སྣང་གིས།",
    "ལོག་སྨྲ་ཚར་གཅོད་བརྡ་སྤྲོད་སྒྲ་རིག་གིས།",
    "ཡང་དག་སྨྲ་བའི་དོན་ལྡན་རྩོམ་རིག་གི།",
    "ོ་སྐལ་ལྡན་རྗེས་སུ་འཛིན་པའི་བཟོ་རིག་གིས།",
    "ངོ་མཚར་གཟིགས་མོ་འཛམ་གླིང་མཛེས་པའི་རྒྱན།",
    "སྣ་ཚོགས་དངོས་པོས་དམངས་ཀྱི་རེ་བ་བསྐངས།",
    "དབྱངས་ཅན་ངག་གི་མཚོ་ལས་དྲངས་པ་བཞིན།",
    "དུས་མིན་འཆི་བའི་སྲིན་པོ་སྐྱ་རེངས་མ།",
    "དེ་ལྟར་སྙན་པའི་རྒྱུད་མང་གིས།",
    "ལུས་ཀྱི་འཁྲི་ཤིང་འཁྱོག་ན་ཡང་།",
    "དཔྱོད་ལྡན་ཡིད་ཀྱི་ནོར་འཛིན་དཔལ་མོའི་གཞིར།",
    "དྲན་པའི་མོད་ལ་དད་པའི་སྤུ་ལོང་གཡོ།",
    "གཟུགས་སྐུའི་བཀོད་པ་རེ་ཞིག་བསྡུས་ན་ཡང་།",
    "ཎ་ཅེས་པ་འདི་ནི་དམ་པ་གང་གི་ཞབས་རྡུལ་གུས་པས་སྤྱི་བོར་ལེན་པ་དཔལ་ལྡན་བཀྲ་ཤིས་འཁྱིལ་གྱི་འཇམ་དབྱངས་མིང་ཅན་གྱིས་བྲིས་པའོ།",
    "གང་གང་མོས་པའི་རྗེས་འགྲོའི་གསུང་གི་དབྱངས།",
    "ཕྱག་རྗེས་རླབས་ཀྱི་རི་མོའི་གཟི་དཔལ་འབར།",
    "དྲི་བྲལ་ལང་ཚོ་རྫོགས་པའི་མཚར་སྡུག་སྐུ།",
    "བྷོ་ཊའི་དཀྱིལ་འཁོར་ཁྱོན་ལ་ཡོངས་བཅིངས་པས།",
    "མཚན་དཔེའི་ལང་ཚོའི་མྱུ་གུ་ཆེས་ཕྲ་ཡང་།",
    "རྗེས་དྲན་དཔལ་དུ་དབྱངས་ལྡན་ངག་གིས་སྤེལ།",
    "གང་གིས་ཀུན་ཕན་ཕྱག་རྗེས་བཞག་པ་དེ།",
    "བསྟན་པ་ཡང་དར་ཁུར་ཆེན་ཕྲག་གིས་བཏེགས།",
    "ཕྱི་ཡི་མཛད་སྤྱོད་ནང་གི་ཡོན་ཏན་སོགས།",
    "ཇི་བཞིན་ཨ་ཁུའི་ཐུན་མོང་མཛད་པ་ལས།",
    "དམ་པ་གང་གི་རྗེས་དྲན་མཚོན་བྱེད་ཡིན།",
    "བློ་གསལ་སྐལ་བཟང་ཡིད་ཀྱི་ས་མོས་ལ།",
    "པདྨོ་བཞད་པའི་བདེན་གཏམ་ཉི་མ་གཞོན་ནུ་ཞེས་བྱ་དན་འདུག་སོགས་སུ་མཇལ་སྐོར་སོང་།",
    "མཐའ་དཔྱོད་བརྩམས་ནས་ཐལ་བའི་རྡུལ་དུ་བརླག་བྱས་ཏེ།",
    "རྡོ་རྗེ་འཆང་གི་གོ་འཕང་མྱུར་ཐོབ་ཤོག།",
    "བཤེས་གཉེན་བྱམས་བརྩེའི་ཟླ་བ་བདག་གི་མགོན།",
    "བཤེས་གཉེན་ལྷ་རིགས་གཞོན་ནུ་ཁྱོད་མིན་སུ།",
    "ཁྱོད་ཀྱིས་ཐབས་འཕྲུལ་དུ་མས་ཡང་དག་བསལ།",
    "ཡང་དར་བསྟན་པའི་བདག་པོར་རེ་འཆའ་ན།",
    "བློ་གསལ་དོན་གཉེར་ངང་མོའི་ཁྱུ་ཚོགས་ཀྱིས།",
    "ལས་དང་ཉོན་མོངས་དྲག་པོས་མཐུ་བརྟས་པས།",
    "དམ་ཉམས་བསྟན་དགྲ་དག་ལ་ཐུགས་རྗེས་གཟིགས།",
    "གཞན་རྗེས་ཁྱི་བཞིན་བསྙེགས་པ་འདི་ལ་གཟིགས།",
    "སྤྱན་རས་གཟིགས་ཀྱི་གདུལ་ཞིང་གསུང་ལགས་ཀྱང་།",
    "དུས་ཀྱི་འཕོ་འགྱུར་སྲིན་མོའི་འཛུམ་བག་འདྲ།",
    "སྒྲ་ཚད་བཟོ་གསོ་ཐུན་མོང་རིག་པ་དང་།",
    "རྣམ་དག་མཐའ་དཔྱད་ང་རོ་བསྒྲགས་པའི་མོད།",
    "བརྩེ་བའི་བདག་ཉིད་ཕྱག་ན་པད་མོའི་གསུང་།",
    "ལྷག་བསམ་རྣམ་དག་སྤྲིན་བྲལ་ཉིན་མོར་བྱེད།",
    "འོན་ཏང་གསུང་གི་སྒྲོན་མེ་འདི་དག་གིས།",
    "ཐ་དད་འགྲོ་ཁམས་མོས་པའི་རྫིང་བུ་རུ།",
    "མི་མཇེད་འཇིག་རྟེན་བྱང་གི་རྒྱལ་ཁམས་འདིར།",
    "བསླུ་མེད་གཟིགས་པ་རྣམ་ལྔས་སྣང་བ་བཞིན།",
    "མགོན་ཁྱོད་གང་དུ་བཞུགས་པའི་ཞིང་མཆོག་དེར།",
    "ཟབ་མོའི་དོན་རྣམས་དཔྱད་འཇོག་ཡུལ་དུ་བྱས།",
    "༞ བསྟན་པ་རིན་ཆེན་མིང་གི་ལྷག་མར་གྱུར།",
    "ཊཥཎཌཧྰུཾ། ། གངས་རིའི་ལྗོངས་ཀྱི་འཇམ་མགོན་ཐོན་མི་གཉིས་པ་༧རྗེ་བཙུན་བསམ་གཏན་རྒྱ་མཚོ་དཔལ་བཟང་བོའི་བཀའ་དྲིན་རྗེས་སུ་དྲན་པའི་གཏམ་གཡས་འཁྱིལ་དུང་གི་སྒྲ་དབྱངས།",
    "མགོན་པོ་ཁྱོད་ཀྱི་རྨད་བྱུང་ཐུགས་བསྐྱེད་ལས།",
    "ཁྱོད་ཡོན་བརྗོད་ལ་ཐུགས་ཀྱིས་གནང་བ་སྩོལ།",
    "ན་ཚོད་མ་རྒས་མགོན་པོ་ཁྱོད་ཀྱིས་དྲིན།",
    "མ་འོངས་ཁྱོད་ཀྱི་བཀའ་དྲིན་ཇི་ལྟར་གཞལ།",
    "གངས་ཅན་ས་ལཱའི་ལྗོངས་སུ་ཡ་མཚན་ཕྱི་ཕྱིར་རྒྱས་པ་ཁྱོད་ཀྱི་དྲིན།",
    "འཛམ་གླིང་ཟམཐའ་དབུས་མེད་པའི་ནོར་འཛིན་ཁྱོན་ལ་ཁྱབ་གྱུར་ར་བ་གངས་རིས་བསྐོར་བའི་འཇིག་རྟེན་འདིའི།",
    "ས་གསུམ་མགོན་ཁྱོད་བཀའ་དྲིན་བརྗེད་མེད་མཛོད།",
    "ཅེས་པ་འདི་ནི་མགོན་པོ་གང་དེ་རང་ཅག་ཐ་མལ་བའི་སྣང་ངོར་ཞིང་ཁམས་གཞན་དུ་སྐུ་འཕོས་ཧ་ཅང་སྙན་མོའི་ངག་ནི་མ་ཡིན་ཀྱང་།",
    "འདིར་དམ་པ་གང་གི་བཀའ་དྲིན་རྗེས་སུ་དྲན་པའི་ཧ་ལོའི་མདངས་ལས་མཛེས་པའི་ཀུན་སློང་གིས།",
    "འཇམ་དབྱངས་འཕྲིན་ལས་སུ་འབོད་པས་བྲིས་པ་མ་འོངས་སྐྱེ་བའི་སྐྱེ་བ་ཐམས་ཅད་དུ་བཤེས་གཉེན་དམ་དེ་ལྟར་མགོན་པོ་ཁྱོད་ཀྱི་རྨད་བྱུང་གསང་གསུམ་རྒྱ་པས་རྗེས་སུ་འཛིན་པའི་རྒྱུར་གྱུར་ཅིག་དེ་རང་ཨ་ཌ་ཨོཾ་ཌ།",
    "མི་ཤིགས་རྡོ་རྗེའི་རྒྱ་ཡིས་ཁྱོད་ཀྱིས་བསྲུངས།",
    "ཕྱོགས་ལྷུང་མུ་ཅོར་སྒྲོག་པའི་བློ་ཆུང་ཚོགས།",
    "གང་འཚམ་གདུལ་བྱའི་ཁམས་དང་མོས་པ་བཞིན།",
    "མྱ་ངན་མུན་པའི་གཅོང་རོང་ཟབ་མོར་ལྷུང་།",
    "མ་ཐེག་ནོར་འཛིན་བུ་མོ་གཡོ་ཞིང་འདར།",
    "ཉི་མ་རེ་ཞིག་ནུབ་པས་སྐྱོ།",
    "རྒྱས་པ་གང་གི་སློབ་བུའི་ཚོགས།",
    "བཅུ་དྲུག་ལང་ཚོས་སྒེག་པའི་གཞོན་ནུ་དེས།",
    "གང་ལ་རེ་བའི་མིག་ཡངས་ནི།",
    "གང་གི་ཞལ་གསུང་བདུད་རྩིའི་ཐིགས་པ་ཙམ།",
    "མགོན་དེས་རྗེས་སུ་འཛིན་གྱུར་ཅིགཆོལ་གསུམ་འཛིན་མའི་ཁྱོན་ལ་ཁྱབ་པ་ན།",
    "རྒྱ་བོད་མཁས་མང་གཙུག་གི་རྒྱན་གཅིག་བུ།",
    "ཚོགས་གཉིས་སྐྱ་རེངས་ཤིང་རྟས་དྲངས་པ་ཡི།",
    "གང་སྐུ་ཉི་གཞོན་མཚན་བཟང་གིས་བརྒྱན་པ།",
    "གང་གི་ཐུགས་བསྐྱེད་རྒྱ་མཚོ་འཁྱིལ་བ་ལ།",
    "ཎཀྵཧྲྰི་ཎཀྲོཌ་ཌ་། ཁོ་། ཁྱོད་ཀྱི་མཛད་པ་བརྗེད་ཐབས་བྲལ། ། རྗེས་དྲན་དུང་ཟླའི་འོད་སྣང་།",
    "རབ་དཀར་ལང་ཚོའི་མཛེས་སྡུག་ཀུན་རྫོགས་པའི།",
    "གཞུང་ལུགས་རབ་འབྱམས་སྨྲ་བའི་ཚིག་གི་གཏེར།",
    "ས་གསུམ་དཀྱིལ་འཁོར་ཁྱོན་ལ་འཚོལ་དུ་མེད།",
    "ཁྱོད་ནི་དུས་རབས་སྒྲོན་མེ་འོད་ཆེན་ཞིག།",
    "རེ་ཞིག་མཚན་དཔེའི་ཉི་མ་ནུབ་ཀྱི་རིར།",
    "རང་གི་ནུས་པས་མ་ལྕོགས་ཀྱང་།",
    "མགོན་ཁྱོད་གང་དུ་བཞུགས་ཀྱང་རུང་།",
    "མགོན་པོ་གང་གི་གཅེས་པའི་སྐུ་སྲོག་ཀྱང་།",
    "ཡང་དར་བསྟན་པའི་ཤིང་རྟ་ཁྱོད་ཉིད་ནི།",
    "རིམ་གཉིས་ཏིང་འཛིན་ཟབ་མོའི་ཉམས་ལེན་གྱིས།",
    "མགོན་པོ་ཁྱོད་ཀྱིས་རྨང་ནས་གསོས་པའི་དྲིན།",
    "རྡོ་ལ་རི་མོ་བྲིས་པ་བཞིན་དུ་ནི།",
    "གངས་ཅན་བོད་མི་རེ་རེའི་ཡིད་ལ་ཉལ།",
    "སྦྱངས་ཏེ་ལག་ལེན་ཕྲ་མོའང་སྲོག་བསྡོས་མཛད།",
    "ཐུན་མོང་རིག་པའི་གནས་ལ་འགྲན་བྲལ་བརྙེས།",
    "རྒྱུད་དོན་འཁྲུལ་མེད་རྟོགས་པ་ཁྱོད་མིན་སུ།",
    "ཁྱོད་བློའི་ཉི་མ་གཞོན་ནུའི་དུས་ཀྱི་ཚེ།",
    "ཆུ་སྐྱེས་གསར་བས་འཛིན་མའི་ཁྱོན་བཀང་ཡང་།",
    "སྒྲིབ་གཉིས་དྲི་མའི་སྐྱོན་རག་བྲལ་བ་ཚངས་ཆེན་ལྷ་ཡི་སྲས་མོ་ཀྱེ།",
    "རྨད་བྱུང་མཛད་པའི་ཅོད་པན་རིང་མོའི་ཟུར་ཙམ་བདག་གིས་བྲི་ལགས་ན།",
    "ལུང་དང་རྟོགས་པའི་འཁྲུལ་མེད་གཏན་ཚིགས་དཔྱད་འཇོག་ཟབ་མོའི་ཀློང་ན་འཛུམ།",
    "མགོན་པོ་གང་གི་གསང་གསུམ་མཛད་པར་བསྔགས་པའི་རོལ་མོ་ཅུང་ཙམ་དཀྲོལ།",
    "གཞན་ཕན་འོད་ཀྱིས་རྨོངས་མུན་སེལ་བ་བྱེད་པོ་གང་གི་མཛད་པའོ།",
    "རྣམ་དཔྱོད་རིག་པའི་མེ་སྟག་ཕྲ་མོས་རྒན་དང་གཞོན་ལ་འགྲམ་ཆུ་འཛག།",
    "ཐོས་བརྩོན་ཟུང་གི་གཤོག་པ་བརྐྱངས་ཏེ་བྱང་རྒྱུད་བཀྲ་ཤིས་འཁྱིལ་བ་རུ།",
    "རྒྱ་རྩིས་རི་མོའི་ཟབ་གཞུང་རིག་མཛོད་བློ་གསལ་གཞོན་ནུའི་མགུལ་དུ་བསྟར།",
    "སྐྱབས་མགོན་བཀའ་ཡིས་ཞལ་གསུང་དྲོན་མོ་སྤྱི་བོའི་རྒྱན་དུ་ལེགས་བཀོད་དེ།",
    "ངེས་དོན་སྨྲ་བའི་བཤེས་གཉེན་ཆེན་མོའི་མཛད་པའི་འཕྲིན་ལས་མཁའ་ལ་ཁྱབ།",
    "བསམ་པའི་དོན་ལ་དཔྱད་གསུམ་ལུང་གིས་ཚིག་གི་འཁྲི་བའི་སྒྲོ་འདོགས་བཅད།",
    "འཆད་པའི་ལྗགས་ཡངས་གློག་གི་གར་གྱིས་ཉན་པོ་སྟོང་ལ་རྒྱགས་ཕྱེ་བསྩལ།",
    "རྩོམ་པའི་དཔལ་གྱི་ཆུ་གཏེར་འཕྱོ་བས་བློ་ལྡན་ངང་མོའི་འབབ་སྟེགས་སུ།",
    "དབྱངས་ཅན་ཞལ་ལུང་ཉི་མའི་འོད་ཟེར་སྨྲ་བ་ངག་གིས་འབུམ་དུ་འགྱེད།",
    "སྔར་མེད་སྙན་འཇེབས་ངག་གི་སྨྱུག་རྩལ་རྣམ་དཔྱོད་སྨྱུ་གུའི་རྩེ་ནས་འཁྱུགས།",
    "ཚོགས་དང་གྲོས་མོལ་གདན་ལ་བཞུགས་ཏེ་རང་རིགས་ཚེ་སྲོག་སྐྱོབ་པའི་ཆེད།",
    "བཞུད་པ་སྔ་སོང་ཉམ་ཐག་བདག་འདྲ་ཁྱེད་གམ་བཅར་བའི་ལས་ཀྱིས་ཕོངས།",
    "ཉི་མ་སེར་བོ་རི་ལ་ལྷུང་ཚེ་སྲིན་བྱ་འུག་པའི་གད་མོ་མཐོ།",
    "ཁྱེད་སྐུ་པད་མོའི་འདབ་མ་ཟུམ་པས་གངས་རིའི་ཁ་དོག་ནག་པོར་གྱུར།",
    "མྱངས་དང་མྱོང་བའི་ལས་འདིར་དགོངས་ལ་ཡེ་ཤེས་སྤྱན་གྱིས་གཟིགས་ཤིག་ཀྱེ།",
    "སེམས་ལྡན་མི་དང་སེམས་མེད་ལྗོན་པ་ལ་དང་ལུང་ན་འཁྱར་འཁྱོར་ངང་།",
    "མགོན་པོ་གང་གི་བཀའ་དྲིན་དྲན་ཏེ་སྐྱོ་ངག་གདུང་བ་དབྱིངས་སུ་གྱེར།",
    "ཡང་བསྐྱར་ཟླ་གཞོན་གསར་བའི་ལང་ཚོའི་འཛུམ་མདངས་ཤར་རིར་འཕགས་ཡོད་ན།",
