    "དམན་པའི་ལས་ལ་ཡང་ལྡོག་པར་མི་བྱའོ་ཞེས་པ།",
    "གཞན་དག་དམན་པའི་ལས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ལ་ང་རྒྱལ་གྱིས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ང་རྒྱལ་དོན་ཆེན་པོ་ཉམས་པར་བྱེད་པ་འདིས་བདག་ལ་ཅི་ཞིག་བྱ།",
    "དམན་པའི་ལས་ལ་འཇུག་པར་མི་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "སྦྲུལ་ནི་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལྟ་བུའི་སྦྲུལ་རྙེད་པར་གྱུར་པ་ན་དཔེར་ན་ནམ་མཁའ་ལྡིང་ལྟ་བུར་སྤྱོད་དོ།",
    "ཞུམ་བྱས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སེམས་ཀྱི་དཔངས་མཐོ་བ་བོར་ཏེ་ཞུམ་པར་བྱས་པས་ལུས་དང་སེམས་ཀྱིས་འཇུག་པ་དམན་པ་ན་ལེ་ལོས་བཅོམ་པ་དང་།",
    "མ་ཞུམ་པ་ནི་སེམས་དེ་སྐྱེས་པས་སླར་ཡང་སྤྲོ་བ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་འགྱུར་སྟེ།",
    "ཆེན་པོ་ཡིས་ཀྱང་ཐུབ་པར་དཀའ་སྟེ་རྒྱལ་བར་མི་འགྱུར་རོ།",
    "གཞོམ་པར་བྱའོ།",
    "དེ་རྣམས་ཀྱི་སྲས་བདག་ཀྱང་ཅི་ལྟར་གཞན་གྱིས་ཕམ་པ་ཞེས་བྱ་བ་འཐོབ་པར་བྱེད།",
    "དཔེར་ན་སེང་གེའི་ཕྲུ་གུ་མི་འཇིགས་པ་ཐོབ་ནས་རི་དགས་གཞན་ཐམས་ཅད་ཀྱིས་ཟིལ་གྱིས་མི་ནོན་པ་ཉིད་ཀྱིས་ནགས་སུ་སྤྱོད་པར་བྱེད་པ་དེ་བཞིན་དུ་བདག་ཀྱང་བརྟན་པར་གནས་པར་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "གལ་ཏེ་དེ་ལྟར་ན་དེའི་ཚེ་གང་ཡང་དགྲ་ལ་སོགས་པ་ལས་རྒྱལ་བའི་ང་རྒྱལ་ཅན་ང་རྒྱལ་ཡོད་པ་དེ་རྣམས་ཀྱང་བསྔགས་པར་བྱ་བར་ཅིའི་ཕྱིར་མི་འགྱུར་ཞེ་ན།",
    "གྲོང་ངམ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "འདི་ཉིད་ཚིགས་སུ་བཅད་པ་གཉིས་ཀྱིས་བསྒྲུབ་པར་འདོད་ནས།",
    "ང་རྒྱལ་གྱིས་ནི་ཞེས་པ་ལ་སོགས་པ་གསུངས་པ།",
    "གང་ཞིག་ང་རྒྱལ་ཞེས་པ་ལ་སོགས་པ་གསུངས་སྟེ་ཏེ།",
    "བདེ་བ་ཡང་ཡིན་ལ་སྟོབས་དང་ལྡན་པའང་ཡིན་ཞིང་ང་རྒྱལ་གྱི་དགྲ་བཅོམ་སྟེ་བསལ་ནས་འདོད་བཞིན་ཏེ་ཅི་བདེར་འདོད་པར་སྐྱེའོ།",
    "དེ་ཉིད་ནི་རྣམ་པར་རྒྱལ་བ་ཡིན་ཏེ་རྒྱལ་བ་ཐོབ་པ་དང་།",
    "ཚིག་གཉིས་པོ་འདི་ནི་ཇི་ལྟར་རིགས་པར་བྱའོ།",
    "ཞེས་ཏེ་ཇི་ལྟར་རི་དགས་ཀྱི་རྒྱལ་པོ་སེང་གེ་རི་དགས་འཁྲུགས་པའི་དབུས་ན་གཟི་བརྗིད་ཆེན་པོ་ཅན་སྟོབས་དང་ལྡན་པར་གྱུར་པས་ནགས་སུ་གནས་པ་ན་རི་དགས་ཐམས་ཅད་རྣམ་པར་གནོན་ལ།",
    "ཉམ་ང་ཆེ་དང་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གང་གྱུར་པ་ནི་རིམ་གྱིས་བྱེད་པ་ལ་སྦྱོར་བས་ཐོབ་པར་གྱུར་པའོ།",
    "ལས་དེ་ཉིད་ལ་ཞེན་པར་བྱ་སྟེ།",
    "ལས་དེ་དགའ་བར་བྱ་བ་ནི་དེ་ལ་ཤིན་ཏུ་འཇུག་པར་འདོད་པའོ།",
    "རྣམ་པར་དཔྱད་པ་འདིས་ཀྱང་ལས་ལ་དགའ་བ་བསྐྱེད་པར་བྱའོ་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "བདེ་བའི་དོན་དུ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཐམས་ཅད་ཀྱིས་ཀྱང་ལས་ཀྱི་འབྲས་བུའི་བདེ་བ་ཐོབ་པར་འདོད་པས་བྱེད་དེ།",
    "གཞན་དུ་ན་དེ་ལ་འཇུག་པར་མི་འགྱུར་ཏེ།",
    "འབྲས་བུ་མེད་པར་རྩོམ་པ་ཡང་སྲིད་པའི་ཕྱིར་ལ།",
    "དེ་ལྟར་ན་ཡང་སྐྱེ་བོས་ལས་བརྩམས་པ་ལས་ཡང་འབྲས་བུ་སྲིད་པའི་ཕྱིར་ལྡོག་པར་འགྱུར་བ་མ་ཡིན་པ་ཉིད་དོ།",
    "ཁྱད་པར་ཇི་ལྟ་བུས་ཤེ་ན།",
    "ངེས་པར་ལེགས་པ་སྐྱེད་པར་བྱེད་པས་སྐྱེ་ཤི་མེད་པའི་འབྲས་བུ་འབྱིན་པར་བྱེད་པའི་ཕྱིར་སྡུག་བསྔལ་ཐམས་ཅད་ཞི་བར་བྱེད་པས་སོ་ཞེས་པའི་དོན་ཏོ།",
    "ད་ནི་དོར་བའི་སྟོབས་སྟོན་པར་འདོད་ནས།",
    "སྟོབས་ཟད་ཅེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བསམས་པའི་ལས་རྫོགས་པར་བྱ་བ་ལ་བདག་ཉིད་ནུས་པ་ཟད་པར་རིག་བྱས་ནས།",
    "དེ་སྲིད་དུ་འདིར་རྣམ་པར་གཡེང་བར་འགྱུར་བ་ནི་མ་ཡིན་ལ།",
    "གཞན་དུ་ན་ཞེན་པས་དེ་ལ་ཞུགས་ནས་སླར་ཡང་བྱ་བ་ལ་རྣམ་པར་གཡེང་བར་འགྱུར་རོ།",
    "དེ་ལྟ་བས་ན་ཕྱི་ཕྱིར་ཁྱད་པར་འདོད་པས་སྤང་སྟེ་དོར་བར་བྱའོ།",
    "ཞེས་པ་ལ་སོགས་པ་གསུངས་པ་སྤྱིར་བསྟན་པ་དེའི་དམིགས་ཀྱིས་བསལ་བ་བསྟན་པ་ཡིན་ནོ།",
    "འཇེབས་པར་ནི་ཤིན་ཏུ་བསྣུན་པས་ཏེ་ཇི་ལྟར་སླར་སྐབས་རྙེད་པར་མི་འགྱུར་བར་རོ།",
    "འདིར་དཔེ་བསྟན་པ་ནི་གཡུལ་ངོར་རལ་ཁ་ཞེས་པ་སྟེ་དཔེར་ན་བསླབས་པ་སྟེ་མཚོན་ཆའི་རིགས་པ་ལ་མཁས་པ་དང་ལྡན་པའི་དགྲ་དང་ལྷན་ཅིག་ཏུ་ཤིན་ཏུ་བརྩོན་པས་རལ་གྲིའི་གཡུལ་ངོར་དེ་ལ་རྡེག་པར་བྱེད་དེ།",
    "དེ་ནི་ཇི་ལྟར་མི་ཕོག་པར་གྱུར་པ་དེ་ལྟར་རོ།",
    "དེ་ལ་ཞེས་པ་ལ་སོགས་པས་འབད་པ་ལ་བསླབ་པར་བྱ་བ་གསུངས་ཏེ།",
    "དཔེར་ན་རལ་གྲི་ལག་པ་ནས་བརྒྱ་ལ་ལྷུང་བར་གྱུར་ན་དགྲས་བདག་ལ་གླགས་འདི་རྙེད་པར་མ་གྱུར་ཅིག་ཅེས་པས་མྱུར་དུ་སྟེ་རིངས་པ་ཉིད་དུ་ལེན་ཅིང་འཛིན་ཏེ་དུས་ལ་སྡོད་པ་ནི་མ་ཡིན་ནོ་ཞེས་པའི་ཐ་ཚིག་གོ།",
    "ཇི་ལྟར་ཁྲག་ལ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "གཞན་དུ་ན་དེ་ཙམ་ལ་ཡང་སེམས་ལ་རྗེས་སུ་ཞུགས་ན་དེ་འཕེལ་བ་དགག་པར་མི་ནུས་པའི་ཕྱིར་རོ།",
    "ཡང་ཇི་ལྟར་འབད་པ་ལ་བརྟེན་པར་བྱ་བར་ཉུངས་མར་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་བས་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ལྡང་བ་དེ་བཞིན་གཉིད་དང་སྙོམ་འོངས་ན་སྟེ་གཉིད་དང་རྨུགས་པ་འོངས་ནས་བཟློག་པར་བྱ་བ་ནི་དེའི་གཉེན་པོ་མི་རྟག་པ་ལ་སོགས་པ་བསྒོམས་པས་ཕྱིར་བཅོས་པར་བྱའོ།",
    "ཉེས་པ་བྱུང་བ་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "སླར་ལྷོད་པར་འགྱུར་བར་མི་བྱའོ་ཞེས་པའི་དོན་ཏོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་རྣམ་པར་དབེན་པ་འདོད་པ་རྣམས་ཀྱིས་དགག་པ་ལ་ཡང་སྣང་བ་ཕྲད་པ་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དེ་ལ་བརྟེན་པ་ཉིད་ཀྱིས་གནས་པར་བྱའོ་ཞེས་དགོངས་སོ།",
    "ཇི་ལྟར་ཞེས་གསུངས་ཏེ།",
    "དྲན་པ་གོམས་པར་འགྱུར་བ་ནི་འབད་པ་མེད་པ་ཉིད་ལ་བརྟེན་ནས་བདག་ལ་བརྗེད་པ་མེད་པར་འགྱུར་བའོ་ཞེས་པ་ནི་བསམས་པ་འདིས་སོ།",
    "བག་ཡོད་ཅེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "བདག་ཉིད་ཀྱི་ལུས་དང་ངག་དང་ཡིད་ཀྱི་མཚན་ཉིད་ལས་ཐམས་ཅད་རྒྱས་པར་དེ་བཞིན་བྱ་སྟེ།",
    "ཇི་ལྟར་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ནམ་མཁའ་ལ་འགྲོ་བ་ལ་སོགས་པ་ཐོབ་པར་འགྱུར་རོ།",
    "བདག་དང་གཞན་དུ་མཉམ་པ་དང་བདག་དང་གཞན་དུ་བརྗེ་བ་གཉིས་ཀར་ཡང་མཁོ་བ་བསམ་གཏན་གྱི་ལེའུར་འཆད་པར་འགྱུར་རོ།",
