    "དབེན་པའི་དགའ་ཚལ་ཉམས་སུ་དགའ་བ་རྣམས་སུ་རྟོགས་པ་ཀློང་དུ་གྱུར་པ་དང་རང་ཉིད་མི་ཉམས་པའི་གདེང་དང་ལྡན་པ་ན་འཕྲིན་ལས་ཀྱི་སྒོ་ཐོག་མར་དབྱེ་བའི་རབ་ཏུ་ཕྱེ་བ་སྟེ་ལྔ་བའོ།",
    "ཡུལ་ནས་ཡུན་རིང་འདུག་དོན།",
    "དེ་དག་དུས་དང་དུས་སུ་བདག་ཉིད་ཆེའི།",
    "བློ་བཟང་རང་ལུགས་འཛིན་པའི་སྲས་ཀྱི་ཕུལ།",
    "དྲུག་ཅུ་མ་སོགས་ལོ་མཇུག་དུས་རིམ་རྒྱ་ཆེར་གནང་།",
    "རོང་རང་ཡུལ་ལ་ཕྱིར་འདུན་པ་མེད།",
    "མཐུན་རྐྱེན་གྱི་བཤེས་གཉེན་འཛོམས་ཡོད་ཙ་ན།",
    "སྐུ་གདུང་མཆོད་རྟེན་གྱི་དོན་ལའང་རང་རྫས་གཏོང་མ་བྲ་བའམ།",
    "རྟེན་བཞེངས་སེམས་ལ་དྲན་ཡང་བྱ་ཐབས་རང་མི་འདུག།",
    "རང་རང་མཚན་སྙན་མ་ཟིན་འདི་ཡིས་ཕྲོགས།",
    "རང་རང་ཐབས་ཀྱི་གདོང་པའི་སྣོད།",
    "འདུག་པའི་ཆེད་དུ་སའི་སྟེགས་བུ་དག་དང་ཁྲིའུ་ཡང་ངོ།",
    "འདུག་ས་འདི་ཉིད་དུ་བྱིན་གྱིས་རློབས་ཤིག་སོགས་ཕྱི་ནང་གསང་པའི་བར་ཆད་མ་ལུས་པ་འཇོམས་པ་ལ་དཔལ་ཕྱག་ན་རྡོ་རྗེ་དབྱངས་ལྟ་བུ་དང་།",
    "གྲངས་ཀྱི་བསྙེན་པ་འབུམ་དྲུག་གམ་བཞི་འམ་གསུམ་དང་མ་མཐའ་འབུམ་གཅིག་དུས་ཀྱི་བསྙེན་པ་ཟླ་བ་དྲུག་སོགས་དང་།",
    "གྲུབ་པའི་གནས་མཆོག་བཀྲ་ཤིས་འཁྱིལ་གྱི་ཡང་དབེན་ཤར་རབ་དགའི་གཟིམས་ཆུང་ནས་ཆུ་བྱི་ལོའི་བདུན་པའི་ཚེས་དྲུག་དུས་མཆོད་ཆེན་པོའི་ཉིན།",
    "དེ་མཁྱེན་པར་འདུག་གསུངས།",
    "བདག་ཅག་ལྷན་ཅིག་ཏུ་འཇམ་དབྱངས་ཨ་ར་པ་ཙ་ནའི་བསྙེན་པ་ལ་བཞུགས།",
    "དེ་ནི་ངེས་པར་སྔོན་གྱི་དམ་པ་གོང་མ་རྣམས་བཞིན་སྐུ་ལུས་མ་སྤངས་པར་དག་པ་མཁའ་སྤྱོད་དུ་འབྱོན་བཞེད་པ་ཡིན་འདྲ་ཡང་ཉེ་གནས་བློ་དམན་པས་ལན་འདུགདེ་སྐབས་སྐུ་མཚམས་ཤིན་ཏུ་དམ་ཡང་།",
    "དེ་ཀུན་གྱིས་ལབ་ཀྱི་སྒྲོན་མ་རང་དུ་འདུག་ཅེས་སྨྲས་པས།",
    "འདི་ལ་མཁའ་འགྲོ་མའི་མཚན་རྟགས་ཚང་བར་མ་ཟད་ཤེས་རབ་མེ་འབར་བ་ལྟ་བུ་ཞིག་འདུག་མིང་ལ་ཤེས་རབ་སྒྲོན་མེ་ཞེས་བཏགས་ན་ལེགས་ཞེས་བསྔགས་བརྗོད་མཛད།",
    "ཁྱེད་ཕ་རོལ་ཏུ་ཕྱིན་པའི་ཚིག་ལ་མཁས་པར་འདུག་སྟེ་དོན་ཤེས་སམ་གསུངས་ཤིང་།",
    "གང་ནས་འོང་གསུངས་པར་ང་རང་དུང་སྐྱོང་མ་ཡིན།",
    "ཁྱེད་རང་སྒྲུབ་པ་མྱུར་དུ་གྱིས་ལ་གཤེགས་ཤིག་གསུངས།",
    "ཡས་མས་ཀྱི་འགྲོ་འདུག་སོགས་འ་འུར་ཟང་ཟིང་ཆེ་བས་ཉམས་ལེན་སྦྱོར་དངོས་རྗེས་གསུམ་གང་ངོས་ནས་ཡིད་ཚིམ་པ་ཞིག་མི་འོང་ཞིང་།",
    "འགྲོ་འདུག་སྤྱོད་ལམ་ཀུན་ཏུ་ཕྱིར་ཚུལ་འདི་འཆད།",
    "ཕྱི་མའི་དོན་ཆེན་སྒོམ་སྒྲུབ་བྱེད་རན་ནི་འདུག་གོ།",
    "བསྟན་པར་འདུག་གོ་སྙམ་དུ་ཚེགས་མེད་པར།",
    "ཕལ་ཆེར་ཚང་བར་འདུག་ན་དགའ་བ་བསྒོམ།",
    "གཉིད་དང་བཟའ་བཏུང་འགྲོ་འདུག་ན་ཚ་དང་།",
    "འདུག་ཚེ་ས་སྐྱེ་ཐག་པ་ཆད་པ་དང་།",
    "ངག་ནས་སྨྲེ་སྔགས་འདོན་ཞིང་རང་ལུས་ལོ།",
    "འཁྱག་དུས་གོས་དང་བཀྲེས་སྐོམ་གྱིས་མནར་ཚེ།",
    "སྦྱིན་དུ་མི་རུང་རང་གཞན་ལ་གནོད་ཕྱིར།",
    "སྤྱོད་ལམ་ལ་བརྟེན་འཆག་དང་འདུག་པ་ཡིས།",
    "ཕུང་བོ་གང་ཡིན་དེ་དང་ངོ་བོ་གཅིག་ངོ་བོ་ཐ་དད་གང་དུ་འང་རང་ངོས་ནས།",
    "གྲུབ་པ་ཡིན་ལ་རང་རང་འདོགས་བྱེད་ཀྱི།",
    "ཉལ་ནས་མ་འདུག་ཁ་དོན་ཕྲན་བུ་ཐོན།",
    "སུམ་རྩེན་ལྷ་ཡི་གྲོང་ན་མེད་ངེས་སུ་འདུག་སྙམ།",
    "མཐོན་མཐིང་རང་འོད་འཚེར་བའི་དགོང་སྔོན་གྱི་དབྱིངས་སུ།",
    "སྤྲིན་དཀར་འཁྲིགས་པ་ཆར་བ་འབེབ་འདོད་ནི་མིན་གདའ།",
    "མི་རིང་དབྱིངས་སུ་ཡལ་ནས་འགྲོ་བ་ཞིག་འདུག་པས།",
    "ཨེ་རནྡྲ་དེ་འབྲས་བུ་སྨིན་འདོད་ནི་མིན་གདའ།",
    "རང་ལ་ཉམས་མྱོང་མེད་པས་གནོང་བཞིན་དུ་འདུག་པས།",
    "བསྐྲད་པས་འབྲས་མེད་མི་འགྱུར་བློ་རྩེ་ཞིག་གདའ་འམ།",
    "སོན་པས་འབྲས་མེད་མི་འགྱུར་བློ་རྩེ་ཞིག་གདའ་འམ།",
    "འཆེལ་བས་འབྲས་མེད་མི་འགྱུར་བློ་རྩེ་ཞིག་གདའ་འམ།",
    "ཟིན་པས་འབྲས་མེད་མི་འགྱུར་བློ་རྩེ་ཞིག་གདའ་འམ།",
    "དྲོད་ལྡན་དབྱར་གྱི་ནམ་ཟླའི་ལྷག་མ་ཞིག་འདུག་པས།",
    "མ་བསྒོམས་བྱུང་རྒྱལ་ཐར་བ་གནས་མིན་དུ་འདུག་པས།",
    "ཡང་སྒོས་སུ་ཨ་ཇོ་རྣམ་རྒྱལ་༡༨༩༤ ༡༩༤༢ལགས་ཀྱིས་རྣམ་དཔྱོད་ཀྱི་རྩལ་ཡངས་པའི་སྒོ་ནས་ནང་མ་དང་སྟོད་གཞས་ཀྱི་རིག་རྩལ་དེ་ཉིད་དར་སྤེལ་རྒྱ་ཆེར་མཛད།",
    "དེ་ཉིད་ཐོག་མར་ག་དུས་དར་འཕེལ་བྱུང་བའི་ལོ་ཚིགས་བང་རྣ་ནང་མ་དང་སྟོད་གཞས་གཉིས་ཀྱི་བྱུང་བ་བརྗོད་པ།",
    "འཛམ་གླིང་གཞན་ལ་མི་འདུག།",
    "ནང་མའི་གསུང་གཞས་ཁག་གཏོང་སྐབས་གཙོ་ཆེར་དབུས་ཆས་དང་དབུས་རྒྱུན་གསོལ་དགོས་པ་སྨོས་མེད་ཐོག་སྟོད་གཞས་ཀྱི་ཁོངས་ནས་ཀྱང་དགྲ་འདུལ་གཉེན་སྐྱོང་དང་ཨ་ཇོའི་བདེ་ལ་སོགས་པའི་གསུང་གཞས་ཁག་གཏོང་སྐབས་གཞས་པ་དང་།",
    "ཟླ་ང་ས་༣ཨ་ཇོ་རྣམ་རྒྱལ་ལགས།",
    "ལེ་ལན་ཐམས་ཅད་གཅིག་ལ་གདའ།",
    "སྤེལ་འདུག་པས་དེར་གསལ་པོར་བཀོད་གནང་མཛད་འདུག་གོ།",
    "ཨབ་ཏུ་ར་མ་ལགས་ནི་ཨ་ཇོ་རྣམ་རྒྱལ་ལགས་ཀྱི་རོལ་དབྱངས་ཀྱི་སློབ་དཔོན་ཡང་ཡིན་ལགས།",
    "མ་བསྡུས་པར་ཡང་རང་ཉིད་འདུ།",
    "ཨ་ཇོ་རྣམ་རྒྱལ་ལགས་གང་ཉིད་སྐུ་ཚེའི་སྟོད་ལ་གང་ཡང་མེད་པའི་ཉམ་ཐག་དབུལ་པོ་ཞིག་ཡིན་རུང་།",
    "དུས་དེ་ནས་བཟུང་བོད་མི་ཚང་མས་ཁོང་ལ་ཨ་ཇོ་རྣམ་རྒྱལ་ལགས་ཞེས་འབོད་སྲོལ་ཡོད་དང་ཡོད་མུས་སུ་མཆིས།",
    "ཡང་དུས་སྐབས་དེར་བོད་མི་ལ་ལས་ཁོང་ལ་རྣམ་རྒྱལ་ཀོ་དོང་ཞེས་མིང་འདོགས་ཁྱད་གསོད་བྱེད་ཀྱི་ཡོད་འདུག་ཅིང་།",
    "སྤྱིར་ཁོང་ནང་སྟོད་གཉིས་ཀ་གཏོང་རྒྱུར་མཉེས་པོ་ཡོད་འདུག་ཅིང་།",
    "ཡང་ཁོང་ལྷ་སར་བཞུགས་སྐབས་ལྷ་ས་བ་ཚོས་ཁོང་ལ་སྐུ་ཞབས་བཀྲ་ཤིས་ལགས་ཞེས་ཞུ་ཡི་ཡོད་འདུགདེ་ལྟར་ཡིན་པའི་ཁུངས་སྐྱེལ་གསལ་པོ་སྟོན་ཐུབ་པའི་དན་རྟགས་ནི་རྒྱ་གླིང་སྲས་ཀྱི་གཞས་ཚིག་ཏུའང་།",
    "ཡིན་འགྲོ་བསམ་པ་མ་བྱུང་།",
