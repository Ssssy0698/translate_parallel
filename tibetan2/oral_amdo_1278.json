    "འདི་དག་གི་འགྲོ་སྟངས་ཡ་མཚན་ལ།",
    "ཁྲག་དམར་འཛག་གིན་པའི་རྣ་ཅོག་ཅིག་ལག་གཡས་ཀྱིས་མཐོ་རུ་སྒྲེང་བཞིན།",
    "བདག་གིས་འཇིག་རྟེན་གྱི་རྣ་བ་བཅད་ཟིན་ཞེས།",
    "ལོ་ངོ་སྟོང་གི་རྫ་བུམ་སྐྱ་བོ་ཞིག་སྟེ།",
    "མཆོད་ཆུ་བསིལ་ཞིང་དག་གཙང་གི་བཅུད་དང་ལྡན།",
    "ཇོ་མོ་གླང་མའི་འཁྱག་རོམ་གྱི་སྦུབས་སུ་སྐྱེས་པའི།",
    "བཙན་པོ་སྲོང་བཙན་གྱི་ཆིབས་རྟའི་བང་གིས་གཞལ་བའི།",
    "རྩིབས་རུས་ཀྱི་སྨྱུ་གུ་ལེབ་མོ་དེ་ཡིན།",
    "ཁྱེད་ནི་རྨོ་མོའི་ལག་བསྐོར་འཐག་རྡོ་ལས་ཉིལ་བའི།",
    "ངའི་རྐང་ཆུང་གི་འདེགས་འཇོག་ལེན་སའི།",
    "ཁྱེད་ནི་ཨ་མའི་དགོ་དགོ་ཡི་དབྱངས་དང་འགྲོགས་པའི།",
    "ཟེའུ་ཆུང་གི་འབྲི་མར་སེར་པོ་དེ་ཡིན་ལ།",
    "ངའི་བྱིས་སྒྲུང་གི་བློ་སྤོབས་མཚོན་བྱེད།",
    "ཨ་ལ་ཐ་ལའི་འགྱུར་ཁུགས་སྙན་མོ་དེ་ཡིན།",
    "ཁྱེད་ནི་ཨ་ཕའི་ཇག་རྒྱབ་ཀྱི་ར་མདར་འཁུར་བའི།",
    "ལུས་སྲུང་གི་མེ་བོའུ་རྭ་རིང་དེ་ཡིན་ལ།",
    "ལྕང་ལྕག་གི་སྐྱ་ཙེ་ཕྲ་མོ་དེ་ཡིན།",
    "འཇམ་མཉེན་གྱི་ལག་སོར་དྲོན་མོ་དེ་ཡིན་ལ།",
    "ངའི་ཚེ་གང་གི་རྨི་ལམ་གཏོང་སའི།",
    "སྦྲ་ནག་ལེབ་མོ་འདིའི་ཆོན་ཐག་དཀར་པོ་དེ་ཡིན།",
    "ཁྱེད་ནི་ཐང་ཤིང་གི་ཡལ་གར་བབས་པའི་བྱེའུ་ཆུང་ཅོ་ཀ་ཞིག་སྟེ།",
    "ཁྱེད་ནི་འགྲུལ་ཁང་གི་སྒེའུ་ཁུང་ལས་འཕྲོས་པའི་ཆེར་སིལ་སྐུ་བོ།",
    "འཁྱག་གྲང་གི་ཉིན་གུང་།",
    "དངངས་སྟབས་ཀྱིས་འབྲོ་བའི་གླ་དང་ཡུ་མོའི་ཚོགས།",
    "ཉན་གྱིན་ཉན་གྱིན་སྨག་གིས་བཏུམས་པ་དག་གསལ་བར་བྱེད་དགོས།",
    "ཁྱོད་ཀྱིས་རྒྱང་བཞུད་ཀྱི་སྟ་གོན་བྱེད་དགོས།",
    "ཞུ་ལ་ཉེ་བའི་འཁྱག་རོམ་གྱི་དྭངས་མ་དག་རང་གི་མེ་ལྕེ་གཞོམ་པའི་བདུད་རྩི་རུ་བསྒོམ་དགོས།",
    "གཙང་ཁང་ཡང་སྡུག་གི་མཆོད་སྟེགས་སྟེང་མར་མེ་སྒྲོན་རོགས།",
    "ཉི་འོད་ལྟ་བུའི་མཚར་སྡུག་གི་དད་མོས་ཅིས་ཀྱང་ལྡན་པར་བྱ།",
    "མུན་ནག་ཁྲོད་དབེན་སིམ་དུ་གནས་པ་དག་གི་རྡོའི་ཀླད་སྒྲོམ་དག་གི་འཕུར་འདོད་ཀྱི་གཤོག་སྒྲོ་སྒུལ་མི་ནུས།",
    "ལུང་བསྟན་དང་བཀའ་ཆེམས་མག་མོག་ཏུ་ལྷུང་བའི།",
    "ཟེའུ་འབྲུ་བཏོགས་ཚར་བའི་མེ་ཏོག་གི་བེམ་པོས།",
    "མངའ་ཐང་གཞན་ཞིག་གི་ལོ་མ་འབུས་པའི་བདེན་དཔང་ཅི་ཞིག་ཡོད།",
    "དབྱར་གཞུང་ཉིན་གུང་གི་རྫི་ལྷ་ཇི་བཞིན།",
    "གྲོང་ཚོའི་ལྡུམ་ར་ན་ཁ་མ་ཕྱེས་པའི་མྱུ་གུ་ཚོགས་ཀྱི་སྐྱེས་སྟོབས་ལ།",
    "གོ་ཐལ་དང་མཆིལ་ཞགས་རྣམས་སྤྲུགས་སྤྲུགས་བཏང་ནས།",
    "བསླེབས་སྔ་བའི་དཔྱིད་ཀ་ཞིག་གི་བྲོ་བ་མྱོང་བཞིན།",
    "མི་གཅིག་གི་མེ་ཕུང་གིས་ལོ་ངོ་སྟོང་གི་དགུན་འཁྱག་སྐྱེལ་ནུས་མིན་ལ།",
    "གྲུ་གཟིངས་ཆེན་མོའི་ནང་རོལ་དུ་བསྡད་ནས།",
    "རྒྱ་ཕིབས་སྟེང་གི་འོད་མདངས་མ་སྣོག་པར་བསྲུང་དགོས།",
    "མ་རྨོས་ལོ་ཏོག་གིས་སྣུམ་བཅུད་སྩོལ་བར་གྱིས།",
    "ཐེངས་རེ་རེའི་སྐྱུག་ལྡད་ཀྱི་རྩི་ཁུ་ཁ་དོག་འགྱུར་གྱིན་འདུག་ཁ་མ་གྲགས་གོང་ལ།",
    "རང་གི་སྡོང་རྐང་ལས་མཐོ་རུ་བཏེགས་ནས།",
    "སེམས་ཆུང་གི་རྡེའུ་དག་གི་ནང་རིམ་ནས།",
    "བྱ་རྒོད་དང་གླག་མོ།",
    "སྒྲོ་གཤོག་གི་སྐྱོང་སྐུམ་བར་གྱི་ཁྲག་ཤུལ་དྲན་པར་གྱིས་ཤིག་ཁ་མ་གྲགས་གོང་ལ།",
    "ངས་ཐོ་རངས་ཁའི་བོང་བུའི་སྐད་ཅོར་ལ་བཟོད་བསྲན་བྱས་ཆོག་བྱ་ཕོ་མལ་ལས་མ་ལྡང་གོང་གི་མུན་ནག་གི་སྨྱོ་འབོག་ལ་བཟོད་བསྲན་བྱས་ཆོག་ངས་ལག་བསྐོར་འཐག་རྡོ་ལས་ཉིལ་བའི་རྡུལ་ཕྲན་གྱི་བསམ་བློ་ལ་བཟོད་སྒོམ་བྱས་ཆོག་ངས་ཡིད་དུ་མི་འོང་བ་ཡོད་ཚད་ཀྱི་སྨྲེ་སྔགས་ལ་བཟོད་སྒོམ་བྱས་ཆོག་མཁས་པ་ཡ་རལ་བརྡོལ་གྱི་སེམས་པ།",
    "ཨ་ཤི་རེ་ཁོ།",
    "སྙན་ངག་ནི་སྐབས་ལན་རེར་མིང་ཚིག་ཅིག་རེད།",
    "སྙན་ངག་ཤར་ཤར་དུ་ཀློག་ནུས་པ་འདུག་སྙན་ངག་ནི་སྐབས་ལན་རེར་བྱ་ཚིག་ཅིག་རེད།",
    "བྱ་ཚིག་གི་ཀློང་དུ་སིམ་པའི་སྙན་ངག་དེ།",
    "ལ་ཁའི་རྫི་བོ་ཕོ་མོ་དག་གིས་ཀྱང་།",
    "སྙན་ངག་སང་སང་དུ་ལེན་ནུས་པར་འདུག་སྙན་ངག་ནི་ཤིང་གིས་བཟོས་པའི་སྒེའུ་ཁུང་ཞིག་སྟེ།",
    "སྒེའུ་ཁུང་གི་གླེགས་ཤིང་དག་གི་བར་བར་དུ།",
    "སྦྲ་ནག་གི་འདབས་ཚར་ཡང་མོ་དག་ཀྱང་།",
    "སྙན་ངག་འདི་སྐབས་ལན་རེར་ལས་ཚིག་ཅིག་ཀྱང་ཡིན་འདུག་སྟེ།",
    "སྙན་ངག་གི་གཟུགས་འགྱུར་གཉུག་གཤིས་ལ་གོ་བ་མ་ལོན་པ།",
    "ཨ་ཤི་རེ་ཁོ།",
    "དང་ཐོག་ཁྱོད་ནི་ས་སེར་སྤར་མོ་གང་ཡིན།",
    "དད་ལྡན་དྲན་སྣང་གི་མིག་ཆུ་ཁྱོར་གང་བསྣན་པས།",
    "འདམ་གྱི་གཏིང་རིམ་དུ་འགགས་པའི་ཁྱོད་རང་ཡར་བསླངས་ཤིང་།",
    "ཁྱོད་ཀྱི་མིག་དང་རྣ་བ་ཡོངས་སུ་བསྐྱུར་དུ་བཟོས།",
    "ཁ་དོག་འབར་བའི་དར་གོས་ཤིག་གིས་འདམ་ལུས་གཡོགས་ཏེ།",
    "རང་སེམས་དག་གཙང་གི་མཆོད་ཁྲིའི་སྒང་ལ།",
    "དང་ཐོག་ཁྱོད་ཀྱང་མི་ཞིག་ཡིན།",
    "ཆུང་ཆུང་བེའུ་རྫི་ནས་ལ་གཞས་རེ་གཉིས་བསླབས་ཤིང་།",
    "ཨ་མཆོད་ཀྱི་དྲིལ་བུ་རྡུང་བཞིན་སྡོམ་པ་ཤོར་བས།",
    "ཁྱོད་ཀྱིས་ཁང་ལེབ་སྐྱ་བོ་ཞིག་ནས།",
