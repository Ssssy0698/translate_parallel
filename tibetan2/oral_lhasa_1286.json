    "རིགས་ལ་ལེགས་པར་གནས་པ་རྣམས་སས་མ།",
    "དེའི་རྗེས་སུ་འབྲང་བ་དྲི་མ་གཞན་རྣམས་ནི་དབྱིབས་ལེགས་པ་ལ་རྗེས་སུ་ཆ་གས་པར་འགྱུར་ཞིང་མི་མཉམ་པར་གནས་པ་རྣམས་སྤོང་བའོ།",
    "དེའི་རྗེས་སུ་འགྲོ་བ་དྲི་མ་གཞན་རྣམས་ནི་རྟག་ཏུ་འབྱེད་པའི་སྤྱོད་པ་ལ་ངེས་པར་སྤྲོ་བའོ།",
    "དེའི་རྗེས་སུ་འགྲོགས་པའི་དྲི་མ་རྣམས་ནི་བགྲོད་པར་བྱ་བ་མ་ཡིན་པ་བགྲོད་པའོ།",
    "དེའི་རྗེས་སུ་འཇུག་པའི་དྲི་མ་གཞན་རྣམས་ནི་གསུས་པ་བསྐྱོད་༢པར་བྱེད་པའོ།",
    "དེའི་རྗེས་སུ་འཇུག་པའི་དྲི་མ་གཞན་རྣམས་ནི་ཡུལ་ལ་ྗོངས་རྣམས་འཇིག་པར་བྱེད་པའོ།",
    "ད་ད་པས་རབ་ཏུ་བྱུང་བས་ལེགས་པར་སྦྲེལ་བར་གྱུར་པས་ད་གེ་བ་བསྒོམས་པའི་རྒྱུད་ཀྱི་ངོ་བོར་གྱུར་པའམ།",
    "༢༧ མ་རྣམས་ན་གནས་པ་རྣམས་འཇོམས་པར་འགྱུར་རོ།",
    "ད་གེ་སྦྱོང་མ་རྣམས་ཀྱིས་༢དང་པོ་ཁོ་ན་ར་སྐྱེས་བུ་ད་མ་པ་མ་ཡིན་པ་རྣམས་ལ་བསྟེན་པར་མི་བྱའོ།",
    "ལམ་དམ་པར་ར་བ་ཏུ་འཇོག་པར་ཡང་བྱེད་དོ།",
    "སྡུག་བསྔལ་རྣམས་ལས་རྣམ་པར་གྲོལ་བར་བྱས་ན་ས་བདེ་བ་ལ་འཇོག་པར་བྱེད་ད་དོ།",
    "ལེགས་པའི་ལམ་ཡང་ར་བ་ཏུ་སྟོན་པར་བྱེད་དོ།",
    "ཐོག་མ་མེད་པའི་དུས་ནས་འཇུག་པ་ཅན་གྱི་མུན་པ་རྣམས་ཀྱང་འཇོམས་པར་བྱེད་དོ།",
    "དུས་རིང་པོ་ན་ས་རང་ཉིད་དམ་པར་༤ཟུག་པའི་འདོད་ཆ་གས་ལ་སོགས་པའི་ཟུག་རྔུ་རྣམས་གཏན་ནས་འདོན་ནོ།",
    "སྔ་ཕྱིའི་རིམ་པ་ཇི་ལྟ་བ་བཞིན་དུ་ཡོངས་སུ་བསྒྲགས་པ་རྣམས་གོ་རིམས་༥ཇི་ལྟ་བ་བཞིན་དུ་དྲི་མ་༦རྣམས་དེ་ལས་བཟློག་པ་རྣམས་ཀྱིས་༧རབ་ཏུ་འཇོམས་པར་འགྱུར་རོ།",
    "དེས་ཀྱང་ལུས་གཟུགས་ངན་པ་དང་མི་གཙང་བ་སྟེ།",
    "དེས་ཡང་ལུས་དེ་ཉིད་ལ་སོ་སོར་རྟོག་པར་བྱེད་དོ།",
    "གཞན་ཡང་དེས་དེ་ཁོ་ན་ཉིད་ཚོལ་ཞིང་ལྟ་བར་བྱེད་པ་ན་ལུས་འདི་ནི་རྨ་ད་གུ་ནས་མི་གཙང་བ་རྣམས་ཡོངས་སུ་འཛག་པ་ཡིན་ནོ།",
    "བ་༢༧༨ ཅུང་ཟད་དམ་བག་ཙམ་ཡང་མི་འབབ་ན་དེ་ལ་སུ་ཞིག་ལུས་འདི་ལེགས་པར་འཛིན་པར་བྱེད།",
    "དཔེར་ན་གལ་ཏེ་འདིས་ཟས་དང་སྐོམ་བསོ་ད་པ་རྣམས་ཐམས་ཅད་མེད་པར་གྱུར་ལ།",
    "སྤྲད་པ་༥ལས་གཙང་བ་དེ་རྣམས་འདིས་མི་གཙང་བར་བྱེད་ད་དེ།",
    "དཔེར་ན་དྲིས་སྒོབར་བྱེད་པའི་དྲི་རྣམས་ཐམས་ཅད་ཀྱང་ལུས་དང་བརྟེན་པ་ན་རྔུལ་གྱི་སྐྱོན་གྱིས་དྲི་མི་ཞིམ་པར་འགྱུར་རོ།",
    "དེ་བཞིན་དུ་དྲི་ཞིམ་པོའི་མེ་ཏོག་རྣམས་༧ཐམས་ཅད་ཀྱང་ལུས་དང་བརྟེན་པས་རྙིངས་༨པ་དང་དྲི་མི་ཞིམ་པར་ཡང་འགྱུར་རོ།",
    "ཅི་སྟེ་མི་གཙང་བ་ཞིག་ཡིན།",
    "དེ་ན་ས་ད་གེ་སློང་མ་སོ་སོར་དཔྱད་པར་གྱུར་པ་ན་རིགས་རྒྱུད་རྣམས་ཀྱི་མ་གང་ཡིན་པ་དེ་ཡང་ལུས་སྤྱིར་མི་གཙང་བ་ཡིན་པར་མཐོང་ངོ།",
    "མི་གཙང་བ་ཡིན་ཞེས་ལུས་དེ་ཉིད་ལ་སོ་སོར་རྟོག་པར་བྱེད་དོ།",
    "གསོན་པ་ཡང་རུང་སྟེ་བཞག་པར་གྱུར་པ་ན་སྲིན་བུ་དང་།",
    "རུས་པ་དང་བཅས་པ་ཡིན་པས་ཡུལ་ཕྱོགས་ཐམས་ཅད་ཀྱང་དྲི་མི་ཞིམ་པར་ལུས་དང་འབྲེལ་པས་འགྱུར་བར་ཡང་དག་པ་ཇི་ལྟ་བ་བཞིན་དུ་མཐོང་།",
    "གཞན་ཡང་ལུས་དེ་ཉིད་ལ་དགེ་སློང་མ་དེས་འདོད་ཆགས་སྤང་བར་བྱ་བའི་ཆེད་དུ་སོ་སོར་རྟོག་པར་བྱེད་དེ།",
    "ཀཱ་རཎྜ་བ་དང་ངང་ངུར་པད་མ་གཙང་མ་ལ་སྟེན་༤པ་རྣམས་ཀྱིས་ནི་མ་ཡིན་ནོ།",
    "དེས་དེ་ལྟར་ངེས་པར་རྟོགས་ནས་ཚུལ་བཞིན་ཡིད་ལ་བྱེད་པས་༥ས་སོར་རྟོག་པར་བྱེད་དོ།",
    "རྩ་བ་ནས་རླག་པར་འགྱུར་ཏེ།",
    "དྲི་མ་དེ་བཅོམ་པ་ལས་ཀྱང་དྲི་མ་གཞན་༡རྣམས་ཀྱང་ར་བ་ཏུ་བཅོམ་པར་འགྱུར་རོ།",
    "དེ་ལ་གང་ཡང་དགེ་སློང་མ་འདིས་ལམ་འདི་ནས་འདོད་ཆ་གས་རབ་ཏུ་འཇོམས་པར་བྱེད་དོ།",
    "དེ་ཡང་འདོད་ཆགས་རབ་ཏུ་སྤངས་པའམ་བསྲབས་པར་བྱས་པས་ཀྱང་དེ་དག་གཉིས་ཀྱང་བསྲབས་པར་འགྱུར་རོ།",
    "དེ་དག་མེད་པར་གྱུར་ན་དེ་ཡང་མེད་པར་འགྱུར་རོ།",
    "ཕྲག་དོག་དང་སེར་སྣ་མེད་པར་གྱུར་ན་སླུ་བར་མི་བྱེད་པར་འགྱུར་རོ།",
    "སྲེད་པར་གན་ས་པའོ།",
    "དེ་བཅོམ་པར་གྱུར་ན་མི་འབྱུང་སྟེ།",
    "དེ་ལས་སྲེདཔར་གནས་པ་ཉིད་མི་འབྱུང་ངོ།",
    "མི་མཉམ་པར་གནས་པ་རྣམས་སྤོང་བར་བྱེད་པ་མི་འབྱུང་ངོ།",
    "མེད་པས་མེད་པར་གྱུར་པ་ནི་འདི་ལྟ་སྟེ།",
    "རྩོད་པ་དང་རྣམ་པར་འབྱེད་པ་རྣམས་ཏེ།",
    "༢༦༡༢ ༡སུ་འབྲང་བ་ཡང་མེད་པར་འགྱུར་རོ།",
    "དེ་མེད་པར་གྱུར་པས་གཞན་ཕྱིའི་༤བཞིན་རྗེས་སུ་འབྲེལ་བ་ཡང་མེད་པརའགྱུར་རོ།",
    "གསུས་པ་སྐྱོད་པར་བྱེད་པའོ།",
