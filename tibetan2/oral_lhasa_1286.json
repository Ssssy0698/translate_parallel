    "གསུས་པ་འགེངས་པའི་དྲི་མ་རབ་ཏུ་ཞི་བར་གྱུར་པ་ན་དེའི་ཚེ་བགྲོད་པར་བྱ་བ་མ་ཡིན་པ་བགྲོད་པའི་དྲི་མ་རབ་ཏུ་སྤངས་པར་འགྱུར་རོ།",
    "དེའི་ཆེ་བགྲོད་༨པར་བྱ་བ་མ་ཡིན་པའི་དྲི་མ་དེ་ཡང་རབ་ཏུ་ཞི་བར་འགྱུར་རོ།",
    "དེ་མེད་པས་ཀྱང་དྲི་མ་གཞན་ཡང་མེད་པར་འགྱུར་བ་ནི་འདི་ལྟ་སྟེ།",
    "བགྲོད་པར་བྱ་བ་མ་ཡིན་པ་དེའི་རྗེས་སུ་འབྲེལ་པའི་དྲི་མ་ལྷན་ཅིག་སྐྱེས་པར་ཕྱི་བཞིན་རྗེས་སུ་སྦྲིལ་༩བ་གཞན་ནི་སྤྱད་པ་འབྱེད་པའོ།",
    "སྤྱོད་པ་འབྱེད་པ་ཡང་གཞན་མེད་པས་མེད་པར་འགྱུར་རོ།",
    "ཀི་༢ ༢ མེད་པར་འགྱུར་བ་ནི་འདི་ལྟ་སྟེ།",
    "རྩོད་པ་ལ་ད་གའ་བ་དང་བྲལ་བས་ཡུལ་ལ་ྗོངས་འཇིག་པ་རྣམས་ཀྱངདེ་མེད་པས་མེད་པར་འགྱུར་རོ།",
    "དེའི་ཚེ་ཁྱིམ་གྱི་གནས་ཤིན་ཏུ་སྤང་བར་ད་ཀའ་བ་སྤངས་ནས་དད་པས་ཁྱིམ་ན་ས་ཁྱིམ་མེད་པར་རབ་ཏུ་འབྱུང་སྟེ།",
    "མ་བྱིན་པར་ལེན་པ་དང་།",
    "མི་ཚངས་པར་སྤྱོད་པ་དང་།",
    "དེ་རྣམ་པ་དེ་ལྟ་བུའི་སྐྱེ་བ་ཐོབ་པའི་ལྷ་གང་ཡིན་པ་དེ་ཡང་བག་མེད་པས་བག་མེད་པར་སྤྱོད་པར་འགྱུར་རོ།",
    "དེ་ནས་དེའི་ཚེ་བཅོམ་ལྡན་འད་ས་དེས་ཚིགས་སུ་བཅད་པ་གསུངས་པ།",
    "མཚོན་ཆ་མེ་དང་མཚུངས་པར་རྣོ་བ་རྣམས།",
    "ཟབ་པར་མཚུངས་པའི་སེམས་ད་ང་ལྡན་པ་ཡི།",
    "འོད་ཟེར་རྣམས་ཀྱིས་རྣམ་པར་མཛེས་པ་ཡིན།",
    "ལྷར་གྱུར་པ་ན་ཡང་བག་མེད་པས་ཟད་པར་བྱེད་པའི་ལྷ་དེ་རྣམས་ནི་ཤིན་ཏུ་བསླུས་པར་གྱུར་པ་ཡིན་ནོ།",
    "དེས་ན་༡རིངས་པ་རིངས་པར་བག་མེད་པར་མ་བྱེད་ཅེས་བཅོམ་ལྡན་འད་ས་དེས་ལྷ་རྣམས་ལ་ཕན་པར་བཞེད་པས་དེ་ལྟར་རྗེས་སུ་གདམས་པར་འགྱུར་རོ།",
    "༢༦༥༢ ༧བར་གྱུར་པའི་རང་བཞིན་གྱིས་མིག་གཏོད་པར་བྱེད་དོ།",
    "དེ་ལ་སྨད་པར་གྱུར་པ་ན་ཀུན་ཏུ་ཞེ་སྡང་བསྐྱེའོ།",
    "འདི་ན་དགེ་སློང་ལམ་དུ་འགྲོ་བ་ན་ལུས་སུ་གཏོགས་པ་ལ་འགྲོ་བའི་དུས་སུ་དྲན་པ་བསྐྱེད་པར་བྱ་སྟེ།",
    "བཟུང་ན་སལུས་མ་ལུས་པ་ལ་དཔྱོད་པར་བྱེད་དོ།",
    "དེས་ལུས་འདི་འཆ་ག་པར་གྱུར་པ་ན་རབ་ཏུ་གཡོ་བར་གྱུར་པ་༢དེ་དག་རྣམས་རིམ་པ་སོ་སོར་རྟོག་པར་བྱེད་ད་དེ།",
    "བྱིན་པར་གཏོགས་པའི་ཆུ་རྒྱུས་དང་།",
    "རུས་པ་ལ་ཡང་སོ་སོར་རྟོག་པར་བྱེད་དོ།",
    "གཞན་ཡང་ལུས་དེ་ཉིད་ཀྱི་འདུ་ཤེས་ཅན་གྱིས་ཇི་སྲིད་དུ་སྟེང་ནས་ད་མྱལ་བའི་བར་དུ་སོ་སོར་རྟོག་པར་བྱེད་དེ།",
    "མདངས་འབའ་ཞིག་ཙམ་གྱིས་ཡིད་འཕྲོག་༥པ་རྣམས་དེས་རྣམ་པར་ད་པྱོད་པར་གྱུར་པས་རྩསྦུབས་གཅིག་ལ་ཡང་དག་པ་ཇི་ལྟ་བར་སོ་སོར་རྟོག་པར་བྱེད་དོ།",
    "བཏེག་པར་གྱུར་པ་ན་གཞན་ཡང་དེ་ཁོ་ན་ལྟར་སོ་སོར་ལྷ་༧རབ་ཏུ་རིག་པར་༐",
    "འགྲོ་བར་གྱུར་པ་ན་ཡང་ལུས་ལ་སོ་སོར་རྟོག་པར་བྱེད་དོ།",
    "གཞན་ཡང་ལུས་དེ་ཉིད་ར་བ་ཏུ་གཡོ་བར་གྱུར་པ་ན་ཡང་སོ་སོར་རྟག་པར་བྱེད་དོ།",
    "ལུས་ཀྱི་གོངབུའི་ཁོག་ཙེ་སྦྲུལ་དུག་ཅན་གྱི་ཁོག་པ་ཉིད་གཅེས་པར་འཛིན་པ་ཡིན་པས་རྒྱགས་པས་རྒྱུ་བར་མ་བྱེད།",
    "ཟས་ཀྱི་དོན་དུ་ཀུན་ཏུ་འཆུམས་པར་མི་བྱ་བ་དང་།",
    "གྲོང་ཆུང་རྣམས་སུ་བསོད་སྙོམས་ལ་ཞུགས་པར་གྱུར་པ་ལ་ཇི་ལྟ་བ་བཞིན་དུ་བདག་ཉིད་ཀྱི་ལུས་ལས་སོ་སོར་དཔྱོད་པར་བྱེད་ད་དེ།",
    "དེ་ལྟར་དེ་ལུས་ལེགས་པར་བསྒོམས་པ་དང་།",
    "རྣམ་པ་འདི་རྣམས་ནི་དགེ་སློང་ངེས་པར་ལེགས་པར་འདོད་པ་རྣམས་ཀྱིས་རྒལ་བར་མི་བྱའོ།",
    "དགེ་སློང་རྣམས་ཀྱི་ནི་རྟག་པ་ཉིད་དུ་དྲན་པ་ཉེ་བར་གནས་པར་བྱའོ།",
    "དྲ་ན་པ་ཉེ་བར་གན་ས་པ་ལས་ཀྱང་ད་གེ་སློང་ཤེས་བཞིན་དང་ལྡན་པར་འགྱུར་རོ།",
    "༢༦༢རྟག་པར་ཡང་ལྷ་རྣམས་ཕྱི་བཞིན་ཉེ་བར་གནས་པར་༐"
  ]
}