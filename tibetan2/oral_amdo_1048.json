    "རེག་བལ་སོགས་པ་གདོན་མི་ཟ་བར་འབྱུང་ངོ།",
    "ཁ་ཅིག་ན་རེ་ཞེས་བྱ་བ་ལ་སེགས་པས་ནི་གཞན་དག་གིས་ཐལ་བ་དེའི་ལན་གདབ་པ་ཡིན་ནོ།",
    "མ་རིག་པ་དང་མཚུངས་པའྀ་ལྡན་པོའི་རེག་པ་ནི་མ་རིག་པའི་འདུས་ཏེ་རེག་པའོ།",
    "དེ་ལས་སྐྱེས་པ་ནི་མ་རིག་པའི་འདུས་ཏེ་རེ་ག་པལས་སྐྱེས་པའི་ཞེས་བྱའོ།",
    "རེག་པ་ནི་ཞེས་བྱ་བལ་སོགས་པ་གསུངས་སོ།",
    "འདི་སྐད་དུ་གལ་ཏེ་རེག་པ་གད་དུ་ཡད།",
    "འོགི་ལུང་དུ་མ་བསྟན་པགཉིས་མེད་པར་འགྱུར་རོ་ཞེས་བསྟན་པ་ཡིན་ནོ།",
    "དེ་ནི་མི་དག་པ་ལ་ཡང་ཐལ་བར་འགྱུར་རོ།",
    "ཅི་སྟེ་གཞན་གལ་ཏེ་ཉོན་མོངས་བ་ཅན་མ་ཡིན་བར་གྱུར་ན།",
    "རེ་འདོད་པ་ཡོད་པར་འགྱུར་ཏེ།",
    "དེའི་ཕྱིར་སྲིད་པའི་རྩེ་མོའི་སེམས་ཀྱི་མཇུག་ཐོགས་སུ་བསམ་གཏན་དད་བོལ་སོགས་པས་འགོ་མ་བརྒྱད་ཀྱིས་བརྡ་དུ་ཆོན་པའི་སེམས་དེ་རྣལ་འབྱོར་པས་ཇི་ལྟར་མངོན་སུམ་དུ་བྱེད་དེ།",
    "འདི་ལྟར་ཐོད་རྒལ་དུ་སྙོམས་པར་འཇུག་པར་བྱེད་པ་ད་གཀྱར་རེ་ཞིག་སྙོམས་པང་འཇུག་པའི་སེམས་ཀྱི་མཇུག་ཐོགས་སུ་བཞི་པ་ཡང་མངོན་སུམ་དུ་བྱ་བར་མི་ནུས་ན།",
    "ལུང་གིས་སྒྲུབ་པའི་ཕྱིར།",
    "རེ་ག་པདུ་ཞིག་ལ་རེག་ཅེས་བྱ་བ་ནི་མངོན་དུ་བྱེད་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ་དེ་ལ་མི་གཡོ་བ་ནི་བསམ་གཏན་བཞི་པའི་ས་པའོ།",
    "སྲིད་པའི་རྩ་མོ་ཡིན་པར་རིག་པར་བྱའོ།",
    "འདི་སྐད་དུ་རྣམ་པར་སྨིན་པ་ནི་རང་གི་དང་གིས་འབྱུད་ཞུ་བ་ཡིན་ན།",
    "གང་གིས་ན་དེས་ལྡང་བའི་དུས་ཀྱི་དུས་ཚིགས་བསམས་པལས་འདའ་བར་མི་བྱེད་པར་རྣལ་འབྱོར་པའི་སེམས་ཀྱི་རྗེས་སུ་འབྲང་ཞེས་བསྟན་པ་གོ་འཆད་ཡིན་ནོ་ མི་འཐད་པ་གཞན་འདི་ཡང་ཡོད་དོ་ཞེས་བསྟན་པའི་ཕྱིར།",
    "རེ་ཞི་གཇི་ལྟར་ན་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རེ་ཞིག་ཅིལ་ཕྱིར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཅི་སྟེ་གཞན་དོ་ལྟ་རྣམ་པར་སྨིན་པ་མ་ཡིན་ཀྱང་རུང་འོན་ཀྱང་སྤྱོད་ལམ་པ་ལ་སོགས་པས་འགྱུར་མོད་སྙམ་དུ་སེམས་སུ་དོགས་ནས།",
    "གཞན་ཡང་རེག་པ་མེད་པར་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་༡།",
    "༣ གོ་་དེ་དག་གི་ནང་ནས་འགོག་པའི་སྙོམས་པར་འཇུག་པ་ཡང་འབྱུང་སྟེ།",
    "རེ་ཞི་ག་ཇ་ལྟང་འགོག་པའི་སྙོམས་པར་འཇུག་བ་མངོན་སུམ་དུ་བྱེད་པ་དེ་ལྟ་བུལ་ཚལ་སྟོན་ཏོ།",
    "ཚུལ་འདི་གཉིས་ཇི་སྐད་དུ་ཞེས་བྱ་བལ་སོགས་པའི་ལུང་གིས་གྲུབ་པོ།",
    "འགོག་པའི་སྣ་མོས་བར་འཇུག་པ་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "བའི་རྩ་མོའི་སེམས་པར་འཇུག་པ་ལ་རྟེན་ནས་ཞེས་གསུངས་པའི་ཕྱིར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ཀྱེ་ཁྱོད་ཀྱིས་ཀྱང་དེ་སམས་དང་བཅས་པ་ཇི་ལྟ་བུ་ཡིན་པར་བརྗོད་དགོས་སོ་ཞེས་བྱ་བའི་ཐཚིག་གོ་འདིས་གདེན་མི་ཟ་བར་གཉེར་གསད་དགོས་སམ།",
    "དེའི་ཕྱིར་རྣམ་པར་ཤེསཔ་དག་གིས་བོན་ཉམས་པའི་ཕྱིར་ཞེས་བྱ་བ་གསུངས་ཏེ།",
    "གང་གིས་ན་དེ་མངོན་སུམ་དུ་བྱེད་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པལ་སོགས་པ་ཆད་པས་ས།",
    "དེའི་ས་བོན་རྣམས་ཞེས་བྱབ་ནི་མིག་གི་རྣམ་པར་ཤེས་པལ་སོགས་པའི་ས་བོན་རྣམས་སོ།",
    "བསགས་པ་ཞེས་བྱ་བ་ནི་ཀུན་ཏུ་བསྩགས་བ་སྟེ་དེས་པའི་ཚིག་གི་ཚུལ་གྱིས་ན་བསགས་པའི་ཕྱིར་སེམས་ཡིན་ནོ།",
    "བྱེ་བྲག་ཐ་དད་པ་ནི་སྔོན་པོལ་སོགས་པ་དེ་དག་གི་ནང་གི་བྱེ་བྲག་སྟེ།",
    "མིག་གི་རྣམ་པར་ཤེས་པལ་སོགས་པ་མིཁ་བྱུང་ན།",
    "མངའ་འཕངས་པའི་ཤུགས་འབྲི་བའི་ཚུལ་དུ་ཞེས་རེ་རེ་ལ་སྦྱར་བར་བྱ་སྟེ།",
    "གར་གི་རྐྱེན་གང་ཡིན་པ་ཞེས་བྱ་བའི་ཐ་ཚིག།",
    "རྣམ་པར་སྐྲུན་པའི་རྣམ་པར་ཤེས་པ་གང་གིས་རིམ་གྱིས་འཇུག་པ་རྙེད་ན་འབྲས་བུ་ཡང་འབྱིན་བ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "མ་ཊུ་ལུང་བའི་ནང་གི་ཤ་ལའོ་ ཅི་ཞེན།",
    "ལེན་བའི་རྣམཔར་ཤེས་པ་དེའི་མིང་གི་རྣམ་གྲངས་རྣམས་བསྟན་ཏོ།",
    "དེ་ལས་གཞན་བའི་རྣམ་པར་ཤེས་པ་ནི་ཞེས་བྱ་བ་ནི་མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགས་པའོ།",
    "སེ་རེ་ཞིག་རྣམ་པར་ཤེས་པའི་ཆོ་གས་ལྔ་བོ་རྣམས་ནི་ཕྱི་རོལ་ཏུ་རྣམ་པར་གཡེངས་པའི་ཕྱིར་དེའི་ཚེ་མི་སྲིད་པས་ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་ཁོ་ན་འདུས་ལ།",
    "ཅི་སྟེ་གཞན་དག་དེ་ནི་གཉེན་པོའི་སེམས་ལ་གནས་པ་ཉིད་སྤོང་བར་འགྱུར་རེ་སྙམ་དུ་སེམས་སུ་དོགས་ནས།",
    "ཇི་ལྟར་ན་གང་གིས་ན་གཞ་ན་འགྱུར་བར་དེ་དེ་དང་འཐུན་པར་འགྱུར་ཏེ།",
    "གང་དག་ལ་སེམས་ཀྱི་རྒྱུད་ཉོན་མོངས་པ་ཅ་ན་དང་།",
    "དེ་ཡང་གང་གི་ཚེ་ཉོན་མོངས་པ་ཅ་ན་ལ་སོ་གས་པའི་ངོ་བོ་ཡིན་པ་དེའི་ཚེ།",
    "སྲིད་པའི་རྩེ་མོ་ལས་མ་གཏོགས་པའི་གཟུགས་མེད་པ་ན་ནི་གལ་ཏེ་ཞིག་ན་རྣམ་པངསྟེནཔ་མ་ཡིན་པ་ཡང་འགྲོ་བ་ཡིན་པར་འགྱུར་གྲང་ན།",
    "དེ་དག་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་ཁོ་ན་ལ་སྲིད་པའི་ཡནལག་གི་རྣམ་བར་ཤེས་བའི་སྒྲས་ཐ་སྐད་རྗོད་པར་བྱེད་དོ།",
    "གལ་ཏེ་མིག་གི་རྣམ་བར་ཤེསཔ་ལ་སོགས་པ་ལས་མ་གཏོགས་པའི།",
    "དོན་གྱིས་ནརྣམ་པར་ཤེས་པའི་ཉེ་བར་ལེན་པའི་ཕུང་བོར་རེ།",
    "རེ་ཞིག་བཅོམ་ལྡན་འདས་ཀྱིས་ཞེས་བྱ་བལ་སོགས་པས་ནི།",
    "ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "དེའི་ཕྱིར་ཉོ་ན་མོངས་པ་དང་།",
    "ཉོན་མོངས་བའི་གཉེན་པོ་དང་མཚུངས་པར་ལྡན་པའི་ཕྱིར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "གང་གིས་ཞེས་བྱ་བ་ནི་མིག་གི་རྣམ་པར་ཤེས་བ་ལ་སོགས་པའོ།",
    "མིག་གི་རྣམ་པར་ཤེས་པ་ལ་སོགསཔ་དེ་དག་གི་ས་བན་ནི་དེའི་ས་བོན་ནོ།",
    "རག་པ་ལ་སོགས་པ་ཇི་སྐད་བསྟན་པ་ཐམས་ཅད་ལ་རགས་པ་གང་ཡིན་པ་དེ་ཉིད་འདིར་རྣམ་པར་ཤེས་པར་བསྟན་གྱི་ཞེས་བྱ་བ་ལ་སོགས་བ་རེ་རེ་ལ་སྦྱར་རོ།",
    "དེ་ལ་ནི་ཉོན་མོངས་པ་དང་།",
    "དེའི་གཤེན་༤བོ་དང་མཚུངས་པར་ལྡན་པའི་བྱའི་ཀུན་ནས་ཉོན་མོངས་པ་དང་།",
    "སློབ་དཔོན་གྱི་སྐྱོན་མ་གཟིགས་ནས་གསུངས་པ་ཡིན་ནོ།",
    "དེ་ལྟེམ་འདོད་ན་ཞེས་བྱ་བ་ནི་ཀུན་གཞི་རྣམ་པར་ཤེས་པ་གཞན་ཡོད་པར་རེ།",
    "འོ་ན་ཅིའི་ཕྱིར་བདག་གིས་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི།",
    "དེ་ཞེས་བྱ་བནི་བདག་གི་རྫས་སོ།",
    "དེ་ལ་ཞེས་བྱ་བ་ནི་བདག་གི་རྫས་ལའོ།",
    "བདག་གི་རྫས་ལ་ནི་འགྱུར་བ་མེད་པའི་ཕྱིར་དེ་ཡང་མི་སྲིད་དོ།",
    "དེ་ལྟར་རེ་ཞིག་བ་དག།",
    "བདག་ནི་གང་གིས་ན་ལྷན་ཅིག་བྱེད་པའི་རྒྱ་གཞན་ལ་བལྟོས་པའི་ཕྱིར་རིམ་གྱིས་སྐྱེ་བར་འགྱུར་བ་ལྷན་ཅིག་བྱེད།",
    "དེ་ལྟར་ན་རེ་ཞིག་སྐྱེ་བའི་ཕྱོགས་མི་འཐད་དོ།",
    "དེ་ལྟར་རིགས་པས་མེད་པར་བསྒྲུབ་ནས་ལུང་གིས་ཀྱང་བསྒྲུབ་པའི་ཕྱིར།",
    "འདི་སྐད་དུ་རེ་ཞིག་བསྟན་པ་འདི་ཅིའི་ཕྱིར་ཡིན་ཞེས་བྱ་བ་ལ་སོགས་པ་འདི་ཉིད་ཐོག་མ་ཁོ་ནར་བརྗོད་པར་བྱ་བ་ལ་ཕྱིས་ནི་ལུས་ལགསོགས་པའི་ལས་ཇི་ལྟར་བསྟན་པ་དེ་ལྟ་བུར་དགོངས་པ་འབྱུང་ངོ་ཞེས་བསྟནཔ་ཡིན་ནོ།",
    "རྒྱ་ག་ང་གི་ས་ན་དེ་ལ་ལུསལ་སོགས་པའི་སྒྲ་འཇུག་ཅེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "ལསགསུམ་དག་གིས་བསྡུས་པ་བསྟན་པའི་ཕྱིར་ཏེ་ཞེས་བྱ་བ་ནི་ལུས་ལ་སོགས་པའི་ལས་རྣམས་ཀྱིས་བསྡུ་བརབ་ཏུ་བ་སྟ་ན་པའི་ཕྱིར་ཏེ།",
    "གད་དག་དན་པའི་དོན་གྱིས་ལུས་ཡིན་པར་འདོད་པ་དེ་དག་གི་ལྟར་ན་ལྷའི་ལུས་ནི་ལུས་སུ་མི་འགྱུར་ཏེ།",
    "འདིས་ཀྱང་རེ་ཞིག་སེམས་པ་ཁོ་ན་རྣམ་པར་འབྱེད་དེ།",
    "འགྲོ་བར་བྱེད་པ་ཞེས་བྱ་བ་ནི་གདགིས་འགྲོ་བར་བྱེད་པ་སྟེ་འདི་དང་འདིས་འགྲོ་བར་བྱེད་དོ་ཞེས་སེམས་པ་གང་ཡིན་པའོ།",
    "དེ་ཉིད་གང་གིས་ཞེས་བྱ་བལ་སོགས་པས་བསྟན་ཏོ།",
    "སེམས་པ་དེ་དང་འབྲེལ་བའི་རྒྱུད་གང་ཡིན་པ་དེ་ནི་དེ་དང་ལྡན་པའི་རྒྱུད་རེ་གང་ཡོད་ན་དེ་སྐྱེ་བའོ།",
    "ལན་འདི་ནི་ཕྱི་མ་ངག་གི་ལསལ་ཡང་བལྟ་བར་བྱའོ།",
    "ཁྱོད་ཀྱི་ལུགས་ཀྱིས་ནི་ལུས་ཀྱི་ལས་ཀྱང་སེམས་པལ་བྱ་བས་དེའི་ཕྱིད་ཇི་ལྟར་ན་ད་ལ་དེ་ལྟར་ཐ་སྙད་གདགས་ཏེ།",
    "འདོད་པ་བུད་མེད་རྣམས་ལ་ལག་པར་གཡེམ་པར་མི་བྱེད་ཀྱི།",
    "གང་གི་ལྟར་ན་སེམས་པ་ཉིད་ལུས་ལ་སཱིཊེ་ཨི་༦ ཛཱ་༣༣ ར་སོགས་པའི་ལས་ཡིན་པ་དེའི་ལྟར་ན་ལས་ཀྱི་ལམ་དུ་མི་རིགས་སོ་ཞེས་བྱ་བ་འདི་ཡིན་ནོ།",
    "ལས་ཀྱང་ཡིན་ལ་ཞེས་བྱ་བ་ནི་སེམས་པ་ནི་རང་གི་ལས་ཀྱི་དད་བཞིན་ཡིན་པའི་ཕྱིར་རོ།",
    "འཇིག་རྟེན་དག་གི་རྗེས་སུ་མཐུན་བར་ཞེས་བྱ་བགསུདསཏེ་འཇིག་རྟེན་རྣམས་ལ་ཇི་ལྟར་སྣང་བ་དང་བསྟུན་པར་ཡིན་གྱི་དོན་དམ་བར་ནི་མ་ཡིན་ཏེ།",
    "དགཞན་ཞིག་མེད་པ་མ་ཡིན་པ་དེའི་ལྟར་ན་སེམས་པས་ལུས་དང་ངག་གི་ལསཀྱི་རང་བཞི་ན་དུ་བྱས་པའི་ཕྱིརབསམས་པའི་ཞེསབྱ་བར་རིགས་ཀྱི།",
    "གང་གི་ལྟར་ན་སེམས་པ་ཉིད་ལུས་ལ་སོགས་པའི་ལས་ཡིན་པ་དེའི་ལྟར་ན་སེམས་པར་བྱེད་པར་མི་རིགས་ཏེ།",
    "དབྱངས་ཀྱི་ཁྱད་པར་གང་གིས་དོན་གོ་བར་བྱེད་པའེ་ཞེས་བྱ་བ་ནི་ཀྱེ་མ་འདུ་བྱེད་རྣམས་མི་རྟག་ཅེས་བྱ་བ་ལ་སོགས་པའོ།",
    "ཡི་གེའི་རྣམ་པ་ཡིན་པའི་ཕྱིར་ཞེས་བྱ་བ་ནི་ཡི་སྙགའི་རང་བཞིན་ཡིན་པའི་ཕྱིར་ངེས་པའི་ཚིག་གི་ཚུལ་གྱི་ས་དབྱངས་ལ་དག་ཅེས་བྱའོ་འདོད་པའི་དོན་བརྗོད་པར་བྱེད་པས་ན་ཞེས་བྱ་བནིའདོད་པའི་དོན་ཏེ་བརྗོད་པར་འདོད་པའི་དོན་གཞན་ལ་བརྗོད་པར་བྱེད་རབ་ཏུ་སྟོན་པར་བྱེདཔས་སོ།",
    "འདིར་ཡང་དེས་པའི་ཚིག་གི་ཚུལ་ཉིད་ཀྱིས་དབྱངས་ལ་དག་ཅེས་བྱའོ།",
    "ངག་གི་ལས་བྱེ་བྲག་ཏུ་བ་སྒྲུབ་ས་ནས་ད་ནི་ཡིད་ཀྱི་ལས་སྒྲུབ་པར་རྣམ་པར་ཤེས་པ་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་སོ།",
    "རང་གིར་བྱས་པའི་ཕྱིར་ཞེས་བྱ་བའི་ཐ་ཚིག་གོ།",
    "སམས་པ་དམེད་ན་ཞེས་བྱ་བ་ནི་ལུས་དང་ངག་གི་ལས་ཀྱི་རང་བཞིན་གྱིས་སེམས་པ་མེད་པའོ།",
    "གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་ནི་གཞནབརྩོམ་པའི་རྒྱུ་འདི་འདྲི་བ་ཡིན་ནོ།",
    "དེའི་ཕྱིར་ཚུལ་གང་གིས་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "རྣལ་འབྱོར་སྤྱོད་པ་རྣམས་ཀྱི་ལུགས་འདི་ཡང་རངགི་བློས་དཔྱད་པ་ཡིན་པརགོ་བར་མི་བྱའོ་ཞེས་ཀུན་བཀའ་སྩལ་པའི་ཞེས་བྱ་རྒྱ་བ་གསུངས་ཏེ།",
    "གཞན་དག་གི་ནི་ཡོད་པའི་ཕྱིར་རོ།",
    "འགའ་ཞིག་གིས་ནི་ཡོད་ལ།",
    "འོན་རད་བཞིན་དེ་དག་གི་མིང་ཅི་ཞེས་བྱ།",
