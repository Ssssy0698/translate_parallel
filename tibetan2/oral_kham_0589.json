    "རང་མཚན་ལ་མ་སྦྱར་ན་སྤྱི་ལ་སྦྱར་ཡང་རང་མཚན་གོ་མི་ནུས་པས་ལམ་གང་ཡིན་སྡོང་དུམ་ལ་འདྲི་བ་ལྟར།",
    "གཉིས་ཀའང་རང་མཚན་ལས་ཐ་དད་པའི་ཕྱོགས་གཅིག་ཏུ་དགག་པ་ནི།",
    "གལ་ཏེ་ཁྱེ་ཀྱིས་སེལ་བའི་བདག་ཉིད་ཅན་གྱི་སྤྱི་ལ་བརྡ་སྦྱོར་ན་སེལ་བ་དང་རང་མཚན་ཐ་དད་ཡིན་པས་ལྡན་པ་མིན་པ་ལ་བརྡ་སྦྱར་བ་དང་མཚུངས་ཤེ་ན།",
    "ལེགས་པར་དཔྱད་ན་སྒྲ་ཡི་དངོས་ཀྱི་བརྗོ་་བྱ་མེ་་ལ་ཞེན་པའི་བརྗོ་་བྱ་ནི་དོན་རང་མཚན་ཡིན་ཞིང་སྒྲ་དོན་གྱི་འབྲེལ་པ་འཁྲུལ་ས་བྱས་ན་ཡང་འཁྲུལ་ནས་འཇུག་པའི་སྐྱེས་བུ་བསླུ་བ་མེད་དེ་འཁྲུལ་བའི་ངོར་སྣང་བའང་རང་མཚན་གྱི་རྣམ་པ་དེ་ལས་འཆོལ་བར་མི་སྣང་བས་རྒྱང་རིང་པོའི་གཟུགས་མཐོང་བའི་ཤེལ་གྱི་ཁང་བུ་ནས་བལྟས་པ་བཞིན་ནོ།",
    "ོ་བ་སོགས་ཀྱིས་བུམ་པ་འཇིག་པར་བྱེད་ན་ཡང་འཇིག་པ་དེ་དངོས་མེ་་ནི་ཅི་ཡང་མེད་ཙམ་ཡིན་པས་རྒྱུ་ལ་མི་ལྟོས་ལ་ལྟོས་ན་དངོས་ོར་འགྱུར་ཞིང་དངོས་པོ་ཡིན་ནའང་རང་གཞན་གཉིས་ལས་བུམ་པ་རང་ཡིན་ན་དེ་རྫ་མཁན་གྱིས་བྱས་ནས་རང་ཉི་གྲུབ་ཟིན་པས་རྒྱུ་ཅི་དགོས།",
    "འཇིག་དུས་ཀྱི་བར་དུ་བྱས་པ་མི་འགྱུར་ན་ངོ་བོ་ལ་ཁྱད་མེད་པས་སྔར་བཞིན་ཕྱིས་ཀྱང་འཇིག་མེ་་དུ་གནས་ཏེ་དང་པོ་མི་འཇིག་མཐར་མི་འགྱུར་ཞེས་པའི་རིགས་པས་སོ།",
    "འགལ་བ་མཚན་ཉིད་པ་མིན་པར་བཏགས་པ་བ་ཡིན་ཏེ་དཀར་པོ་དང་འབྲེལ་བའི་སེར་པོའམ་རྟ་དང་འབྲེལ་བའི་བ་ལང་ཞེས་ལྷན་ཅིག་འདུག་པ་ལ་འབྲེལ་་ཞེས་འདོགས་པ་བཞིན་ནོ།",
    "ེ་གསུམ་པོའང་རང་མཚན་གྱི་ཆ་ནས་མིན་ཏེ་གཞན་སེལ་བས་ཕྱེ་བའོ།",
    "དབྱེ་ཚུལ་ཡང་ཡུལ་གཞན་མཐོང་དོན་རིག་གཉིས་རང་མཐོང་རང་རིག་གཉིས་ཀ་མཐོང་བ་རྣལ་མངོན་ཡིན་པ་དང།",
    "ེ་ཁོ་རང་རྟགས་ཀྱི་མཚན་གཞིར་འདོད་དོ།",
    "ེ་ཡི་ཆ་མཐུན་རྒྱུ་ཚོགས་གྲངས་ཚང་སོགས་ཀྱང་རང་བཞིན་གྱི་རྟགས་དེ་ཡི་ཁོངས་སུ་བསྡུ་དགོས་པ་ཡིན་ཏེ་གཞན་དུ་རིགས་པས་མི་འཐད་པས་སོ།",
    "ཞེ་འདོ་ང་ནི་སྨྲས་པ་གཉིས་ོ་གང་ཡིན་ཀྱང་རང་འདོད་པ་དེ་བསྒྲུབ་བྱ་ཡིན་པ་ཉིད་དུ་མཚུངས་པའི་ཕྱིར།",
    "ེ་ལ་དབྱེ་ན་རིགས་སྒོར་ཁས་བླངས་དང་རང་ཚིག་གཉིས་སུ་འདུ་གསུངས་པ་དེ་གཉིས་ཀྱི་ཁྱད་པར་ལ་སྔ་རབས་པ་གཞན་དག་ཡིད་ཆེས་ཀྱི་ལུང་དང་འགལ་བ་དང་།",
    "རྒོལ་བའི་ཁ་ནས་སྨྲས་ཚད་ཀྱི་ངག་ཀུན་དང་པོར་བརྗོད་དགོས་ངེས་མེད་པས་དེ་མ་བརྗོད་པ་སྐྱོན་མིན་ལ་དགོས་ངེས་པ་སུན་འབྱིན་མ་བརྗོད་ན་ཕྱིར་རྒོལ་ཁོ་རང་སྤོབས་པ་མེད་པའི་ནང་དུ་འདུས་སོ།",
    "མ་གསུམ་བས་ཀྱང་ནན་ཏན་གྱིས་སྒྲུབ་འང་ཤིན་ཏུ་རྙེ་་ར་དཀའ་སྟེ་བསྐལ་པར་ཡང་རང་གཞན་གྱི་འབྱོར་པ་རྙེད་དཀའ་བས་སོ་ གཉིས་པ་ནི།",
    "དབེན་པ་སྐྱབས་ཡོ་་ན་འདོད་པ་བྱར་རུང་བར་དང་མི་རུང་བར་འདུག་པས་མ་ངེས་པ་གཉིས་ལས།",
    "མཆོ་་སྟོན་ཏེ་ཁྱིམ་པ་འདུག་པ་ལ་མི་བསྒོ་བར་འགྲོ་བ་ལ་སོགས་པའོ།",
    "བརྒྱད་པ་རྩ་བར་དབྱུང་བ་ལ་འདུག་པ་ནི།",
    "བརྒྱད་པ་སྟན་ལ་འདུག་པ་ནི།",
    "ཡང་ཡང་ཟ་བ་དང་ནི་འདུག་གནས་གཅིག་ཏུ་ཟ་བ་དང་།",
    "གཉིས་པ་འདུག་གནས་གཅིག་ཏུ་ཟ་བ་ནི།",
    "ཉལ་པོ་བྱེད་པར་གཤོམ་པའི་སར་འདུག་པ་དང་།",
    "མགྲོན་དུ་གཉེར་བ་ལས་རིང་དུ་འདུག་པ་དང་།",
    "མི་སྨྲ་བར་སྟན་ལས་ལངས་ཏེ་ཐོས་པའི་ཉེ་འཁོར་ལས་འདས་པར་འགྲོ་ཞིང་དགེ་སློང་འདུག་པ་ལ་བདག་འགྲོ་སོགས་མི་སྨྲ་ན།",
    "སྟན་ལ་འདུག་པར་མི་བྱ་བ་ལ་སོགས་པ་རྣམ་པ་དགུ་དག་དང།",
    "ཁྱིམ་བདག་སོགས་ཀྱིས་མ་བསྒོས་པར་ཁྱིམ་གཞན་དུ་སྟན་ལ་མི་འདུག་པར་བསླབ་པར་བྱ།",
    "རྐང་པ་གཉིས་ཐད་ཀར་གདང་ཏེ་འདོམས་མི་སྣང་བར་ཁྱིམ་གཞན་དུ་སྟན་ལ་འདུག་པར་བསླབ་པར་བྱའོ།",
    "དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབག་པའི་ཆུས་མི་གཏོར་བར་བསླབ་པར་བྱ།",
    "ཁྱིམ་པ་འདུག་པ་ལ་མ་དྲིས་པར་ཆུ་ཟས་དང་འབགས་པ་ཁྱིམ་པའི་ཁྱིམ་གཞན་དུ་མི་དཔོ་བར་བསླབ་པར་བྱའོ།",
    "གཡག་སོགས་བཞོན་པའི་སྟེང་ན་འདུག་པ་དང།",
    "པདྨའི་སྟེང་འདུག་པ་དང་།",
    "ས་སྐྱོང་དེསེང་གེའི་ཁྲིལ་འདུག།",
    "སག་དགས་ཤིག་ན་འདུག་པ་དེར་རྒྱན་གྱིས་བརྒྱན་པ་བཞིན་དུ་མཐོང་ནས།",
    "འདུག་གོ།",
    "དངོས་རྣམས་ཀུན་གྱི་རང་བཞིན་མེད་ཀྱང་རང་བཞིན་འོད་གསལ་ལ་བཏུད་ནས།",
    "ཀྱེ་མི་ང་ནི་གཏེར་ཆེན་པོ་སྟེ་སས་གཡོགས་ཤིང་འདུག་གོ་ཞེས་མི་སྨྲ་སྟེ།",
    "ཡང་རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་རིགས་ཡོད་པའི་ཕྱིར་འགའ་ཡང་།",
    "འདི་དག་ཀྱང་རང་བཞིན་གྱི་རིགས་སོ།",
    "ཅི་རྫ་མའི་ནང་ན་རྫ་མ་འདུག་པ་ལྟ་བུ་ཞིག་གམ།",
    "འོན་ཏེ་རླན་ལྟ་བུར་ཁྱབ་པར་འདུག་གམ།",
    "གྱད་རྨོངས་པའི་སྨིན་མཚམས་ཀྱི་རྒྱན་ལྟ་བུར་འདུག་གམ་སྙམ་པ་ལ།",
    "འདིར་ཡང་རང་བཞིན་སྦྱང་ཕྱིར་ཞེས་པ་ལ་རང་བཞིན་ནི་རང་བཞིན་གྱི་སྐུ་སྟེ།",
    "དེ་བཞིན་དུ་སྟོང་པ་ཆེན་པོ་ཡི་གེ་ལྔ་དང་ཐིག་ལེ་སྟོང་པ་ཡི་གེ་དྲུག་ཅེས་གསུངས་པ་ཡང་རང་སྟོང་མ་ཡིན་ཏེ།",
    "ཕྱིན་ཅི་མ་ལོག་པ་ཡིན་ནོ་ཞེས་པ་འདིས་ནི་ཐམས་ཅད་རང་རང་ངོ་བོས་སྟོང་པའི་སྟོང་པ་ཉིད་ལ་འཇུག་པ་རྣམས་ཡང་དག་པ་མ་ཡིན་པར་དོན་གྱིས་བསྟན་ཏོ།",
    "དེ་ཉིད་ཀྱི་ཕྱིར་ན་གནས་ལུགས་ལ་ཡོད་མེད་དང་རང་སྟོང་གཞན་སྟོང་དང་མེད་དགག་མ་ཡིན་དགག་དང་རྣམ་གཅོད་དང་ཡོངས་གཅོད་དང་སྤངས་པ་དང་ཡེ་ཤེས་དང་སྟོང་པའི་སྟོང་པ་དང་།",
    "དེ་བཞིན་དུ་ཡང་དག་པའི་མཐའ་ལ་སོགས་པ་གཞན་རྣམས་ཀྱང་རང་སྟོང་དང་རྣམ་གྲངས་མ་ཡིན་པ་ཉིད་དུ་རིག་པར་བྱའོ།",
    "མཚན་མ་མ་འགགས་པའི་དངོས་པོ་རྣམས་ཀྱང་རང་སྟོང་ཡིན་པའི་ཕྱིར་མཚན་མ་མེད་པའི་དབྱིངས་ཡིན་པར་འགྱུར་ལ།",
    "སྒྲིབ་པ་གཉིས་ཀྱང་རང་སྟོང་ཡིན་པའི་ཕྱིར་དོན་དམ་པའི་བདེན་པར་འགྱུར་ལ།",
    "རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར་རོ།",
    "ཨ་ར་པ་ཙ་ན་དང་།",
    "ནམ་མཁའ་ལས་བྱུང་རང་བྱུང་བའི་མཆོག་དང་།",
    "ཉེས་པ་ཐམས་ཅད་གདོད་ནས་སྤངས་པའི་མཆོག་དང་རང་བཞིན་གྱིས་སྐྱོན་མེད་པའི་མཆོག་དང་།",
    "ཕྱི་མ་འདི་གཉིས་ཀྱིས་ཀྱང་རང་སྟོང་དང་གཞན་སྟོང་བསྟན་པ་ཡིན་ལ།",
    "དེ་ལ་ཟ་བ་དང་བཟའ་བ་ལ་སོགས་པ་ནི་རང་རང་ངོ་བོས་སྟོང་པའི་ཕྱིར་གང་ཞིག་གང་ན་མེད་པ་སྟེ་ཅིར་ཡང་མ་གྲུབ་ཅིང་ཅུང་ཟད་ཀྱང་མེད་པའོ།",
    "སྒྲིབ་པ་གཉིས་ཀྱི་བདག་ཉིད་གཟུང་འཛིན་གྱི་དངོས་པོ་ཐམས་ཅད་རང་རང་ངོ་བོས་སྟོང་ཡང་རྣམ་པར་དག་པ་མ་ཡིན་པར་གསུངས་པའི་ཕྱིར་རོ།",
    "དེ་ལྟ་བས་ན་རང་སྟོང་དུ་གནས་པ་རྣམས་རང་སྟོང་དུ་སྟོན་པ་ལ་ནི་འགལ་བ་ཅུང་ཟད་ཀྱང་མེད་ཅིང་རང་སྟོང་མ་ཡིན་པ་ལ་རང་སྟོང་དུ་གསུངས་པ་ཇི་སྙེད་ཡོད་པ་རྣམས་ནི་སྔར་བསྟན་པ་བཞིན་དུ་དྲང་དོན་དགོངས་པ་ཅན་ཉིད་དུ་རིག་པར་བྱའོ།",
    "ཞེས་རྒྱུ་འབྲས་ཀྱིས་བསྡུས་པའི་ཕུང་པོ་རང་སྟོང་དུ་གནས་པ་འདི་རྣམས་འགགས་པས་ཕུང་པོ་གཞན་ལ་སོགས་པ་ཐོབ་པར་གསུངས་པ་འདིས་ཀྱང་རང་སྟོང་ལས་གཞན་པའི་ཕུང་པོ་ཁམས་སོགས་ཡོད་པར་གསུངས་ལ།",
    "ཞེས་གསུངས་པའི་ཕྱིར་གཟུགས་སོགས་རང་རང་ངོ་བོས་སྟོང་པ་གང་ཡིན་པའམ།",
    "དེ་བཞིན་དུ་རང་སྟོང་གཞན་སྟོང་དང་རང་བྱུང་གཞན་བྱུང་དང་རང་རིག་གཞན་རིག་དང་།",
    "སྐལ་མཆོག་དུས་རིང་འགྲོ་བའི་སྒྲིབ་ཀུན་ཟད།",
    "གཞན་བྱུང་ཡེ་ཤེས་བཞི་དང་རང་བྱུང་ཡེ་ཤེས་ལྔ་སྟེ།",
    "ཡེ་ཤེས་དགུར་ཡང་འགྱུར་ཞིང་རང་བྱུང་ཡེ་ཤེས་ལྔ་པོ་ཉིད་ལ་ཐབས་དང་ཤེས་རབ་ཀྱིས་དབྱེ་བས་གནས་ལུགས་ཀྱི་ཤེས་པའམ་ཡེ་ཤེས་བཅུར་གསུངས་པའི་ཕྱིར་ཡེ་ཤེས་འདུས་བྱས་བཞི་དང་བསྡོམས་ན།",
    "ཇི་ལྟར་ཉིད་ཀྱི་སྤྱོད་པ་དང་དེ་བཞིན་གཤེགས་པ་གཞན་གྱི་སྤྱོད་པ་དག་དུས་གཅིག་ཏུ་རང་ཉིད་ཀྱི་བ་སྤུའི་ཁུང་བུར་སྟོན་པར་མཛད་པ།",
    "དོན་དམ་པའི་མཚན་བརྗོད་ཀྱིས་རང་བྱུང་ཡེ་ཤེས་ལྔ་རྒྱས་པར་བསྟན་ཚུལསྟོང་པ་ཆེན་པོ་ཡི་གེ་ལྔས་ཀྱང་རང་བྱུང་ཡེ་ཤེས་ལྔ་གསལ་བར་བསྟན་ཚུལཐིག་ལེ་སྟོང་པ་འགྱུར་མེད་དྲུག་ཀྱང་དེ་དང་དབྱེར་མེད་པར་བསྟན་པ།",
    "རྒྱུ་ཡི་མིང་ཡང་རང་བཞིན་ཉིད་ལ་འདོགས།",
    "སོ་སོ་ལ་ཡང་རང་ངོ་ཐ་དད་ཕྱིར།",
    "འདི་ཡིན་གཏད་སོ་མེད་རྣམས་འགྲོ་འདུག་རྒོད།",
    "འཇིགས་སྐུལ་ལས་དང་ཁྱད་པར་ཨེ་འདུག་སོམས།",
    "གདམས་པའི་ཚུལ་འདིར་དྲག་སྤྱོད་མི་འདུག་པས།",
    "གནམ་གང་བར་གྱི་བྱ་བ་འཕྱུག་ཉེན་གདའ།",
    "རང་སེམས་ན་དགའ་བ་འབུམ་ཕྲག་བཞད་ཆོག་པར་གདའ།",
    "ངོ་གདོང་བརྟན་པོས་ཅི་གསུང་བཀའ་བཞིན་བསྒྲུབ་རྒྱུ་ཟེར་བ་སོགས་ཁ་ནས་མ་ཎི་བཞིན་སྐྱོར་བ་ལ་ངེས་བཟུང་ཅི་ཡང་མི་འདུག།",
    "གཞིས་བྱེས་གཉིས་ཀྱི་མི་རབས་སྔ་ཕྱིའི་མཚམས་འདི་ན་འགྱུར་ལྡོག་ཅི་འདྲ་འགྲོ་བཞིན་ཡོད་མི་མཐོང་བའམ་མཐོང་ཡང་རང་གནོང་མི་བཟོད་པར།",
    "དང་ན་གྲུང་ད་དུང་རང་ཁྱིམ་སྣེ་ལེན་ཟབ་ལ་ཁད།",
    "ཡང་ཡང་བཅར་ནས་ཆ་རྒྱུས་ལོན་ཙ་ན།",
    "ཎ་ཀུདྲང་པོ་མི་འདུག་མ་ཟེར་ཏེ།",
    "སྐྱིད་པོ་མི་འདུག་མ་ཟེར་ཏེ།",
    "ཞིམ་པོ་མི་འདུག་མ་ཟེར་ཏེ།",
    "ཤེས་ཀྱི་མི་འདུག་མ་ཟེར་ཏེ།",
    "རྒྱུགས་འབྲས་ཨང་ཐོབ་ཀྱང་གང་ལེགས་བྱུང་འདུག་པས་ཤིན་ཏུ་སྤྲོ་བས་བཀྲ་ཤིས་བདེ་ལེགས་ཞུ་བས་མི་ཚད།",
    "མ་ལ་བུ་སྐྱེས་པའི་དན་རྟགས་ལོས་ཡིན།",
    "རོང་འབྲོག་གཉིས་ཀ་ཁྱད་མེད་བྲེལ་བཞིན་འདུག།",
    "རིག་པའི་བུ་ཆུང་རང་ཡུལ་དུ་འགུག་པའི་ཕོ་ཉར་གླུ་གཞས་སྒྲ་འཁོར་དུ་བྲིས་པ་ཡིག་སྐྱེལ་ཁང་བརྒྱུད་བསྲིངས་པ་ལག་མཐིལ་དུ་འཕྲོད་པར་གཏམ་ལན་གྱི་ཚུལ་དུ།",
    "སེམས་ཀྱི་བུ་ཆུང་རང་ཡུལ་དུ་འགུག་པའི།",
    "རྣམ་དག་རྒྱུན་དང་བརྒྱུད་པ་དང་བྲལ་རང་རང་རིགས་མཐུན་མགོ་བོ་བསྐོར།",
    "གྲགས་ཀྱི་གསན་ཡིག་ན་འདི་མི་འདུག་པ་ཆད་དམ་སྙམ།",
    "ཀུན་མཁྱེན་བུ་དང་རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་འདི་གཉིས་གོ་ལྡོག་ཏུ་འདུག་པས་དཔྱད།",
    "ལོ་ཆེན་བེ་རོ་ཙ་ན།",
    "ཚུལ་འདི་བསམ་ཞིང་མདུན་མ་ལེགས་ནས་གདའ།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་དང་རྡོ་རྗེ་གདན་པས་སྟག་ཚང་ལོ་ཙཱ་བར་གསན་པའི་ཐོར་འདི་མི་འདུག།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་འདི་མི་འདུག་པ་ཆད་དམ་དཔྱད།",
    "འདི་གཉིས་གསན་ཡིག་གཞན་ཚོར་མི་གསལ་ཡང་རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་དང་སྟག་ཚང་ལོ་ཙཱ་བར་རྡོ་རྗེ་གདན་པས་གསན་པའི་བརྒྱུད་པར་འདུག་པས་ཁུངས་བཙུན་པར་མངོན།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་མི་འདུག།",
    "གསན་ཡིག་ལ་ལར་འདི་གཉིས་གོ་ལྡོག་ཏུ་འདུག་པ་རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་དེས་དཱ་ན་ཤཱི་ལ་དང་ཛི་ན་མི་ཏྲ་༢༢ན་གཉིས་ལ་ཞེས་དང་།",
    "སྟག་ཚང་པར་གོང་དཀར་བས་གསན་པའི་བརྒྱུདཡིག་ན་འདུག་པས་ཡིད་ཆེས་སུ་མངོན།",
    "བུའི་གསན་ཡིག་ན་ར་སྟོན་ཁྲི་བཟང་ཞེས་སྣང་ཞིང་འདི་དང་ཕྱི་མ་གཉིས་གོ་ལྡོག་ཏུ་འདུག་པ་བརྟག།",
    "རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་ཐེར་མགོ་བ་ཟེར་བ་འདུག།",
    "ངོར་ཆེན་གྱི་གསན་ཡིག་ན་འདི་གཉིས་ཀ་མི་འདུག་པ་དཔྱད།",
    "གསོ་དང་བཅས་ཅི་འདུག་བཙལ་བས་ཏཱ་ལའི་འདབ་མར་བྲིས་པའི་བསྟན་བཅོས་གཉིས་ཀྱི་དཔེ་རྙེད་ཀྱང་རྒྱུན་མ་རྙེད་པར་བརྟེན་རྗེ་བཙུན་བྱམས་པ་ལ་གསོལ་བ་རྩེ་གཅིག་ཏུ་བཏབ་པས་སྤྲིན་གྱི་གསེབ་ནས་ཞལ་དངོས་སུ་བསྟན་ནས་གནང་བའི་ལུང་རྒྱུན་འཕེལ་བ་ཡིན་པས།",
    "འདྲ་མིན་ལ་འགྲེལ་པ་དང་བཅས་པ་གསུང་བར་གདའ་འོའི་མཐའ་ཅན།",
    "ལོ་པ་སྤྱན་སྔའི་གསན་ཡིག་ན་འདི་གཉིས་གཅིག་ཏུ་བརྩིས་པའི་ཤཱི་ལ་པྲཛྙཱ་ཟེར་བ་འདུག།",
    "ལོ་པའི་གསན་ཡིག་ན་བར་འདིར་འབྲོམ་སྟོན་འདུག།",
    "ལོ་པའི་གསན་ཡིག་ན་འདི་གཉིས་འདུག་ཀྱང་རྗེ་མཁྱེན་བརྩེའི་དེར་མི་སྣང་བས་བརྟག།",
    "འདི་ལོ་པ་སྤྱན་སྔའི་གསན་ཡིག་ན་ཙན་ཁ་པོ་ཆེ་དང་གཅིག་པར་མཛད་འདུག་པ་དཔྱད།",
    "རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ཏུ་འདི་ལྟར་སྣང་ལ་ལོ་༞གསན་ཡིག་ན་འདི་དང་གོང་མ་གཅིག་ཏུ་མཛད་འདུག་པས་བརྟག།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་གྲོའི་རྗེས་སུ་མཆིམས་བྱས་པའང་སྣང་ཟེར་བའི་མཆན་བུ་ཞིག་འདུག།",
    "དཔེ་རྙིང་པ་འདྲ་ན་དགྲ་ལས་རྒྱལ་ཞེས་པ་ལས་རྣམ་མི་འདུག་པ་རྒྱ་སྐད་སོར་བཞག་བསྒྱུར་བ་འདྲ་སྟེ་སློབ་དཔོན་ཛེ་ཏཱ་རི་ཡིན་པར་མཇུག་ཏུ།",
    "འདི་གཉིས་ཀྱི་བར་ན་སྒྲུབ་པའི་ཆོ་ག་ལོགས་པ་ཞེས་པའི་གཅིག་སའི་གསན་ཡིག་ན་འདུག་ཀྱང་བཤགས་པ་སྒྲུབ་པ་ཞེས་གཅིག་ཏུ་བྱས་པ་ལས་དཔེ་སོ་སོར་མེད།",
    "སྒྲུབ་ཁང་པའི་གསན་ཡིག་ན་ཟར་བ་དར་མ་རྒྱལ་མཚན་ཟེར་བའང་འདུག་པ་དཔྱད།",
    "ཤར་པའི་གསན་ཡིག་ན་འདི་བཞིན་འདུག་ཅིང་ལོ་པ་སྤྱན་སྔའི་གསན་ཡིག་ན་འདི་གཉིས་སྦྲེལ་འདུག་པ་དཔྱད།",
    "གསན་ཡིག་གཞན་བཞི་པོར་འདིའི་གོང་དུ་གྲ་ཐང་བ་ཟེར་བ་ཞིག་འདུག་པ་བྲག་སྟེང་པ་དང་ནོར་བའི་ཡིག་སྐྱོན་གྱིས་ཟུར་དུ་བྱས་པ་ཡིན་ནམ་བརྟག།",
    "བུ་སྟོན་དང་ས་ལུགས་ཀྱི་གསན་ཡིག་ཕལ་ཆེར་ན་འདི་གཉིས་མི་ཡོང་འདུག་པ་ཉེ་བརྒྱུད་ཡིན་ནམ་སྙམ།",
    "གོང་དཀར་བའི་གསན་ཡིག་ན་འདིའི་སྔོན་དུ་ལོ་བཙུན་ཆུང་ཟེར་བ་ཞིག་འདུག་པ་ཆད་དམ་དཔྱད།",
    "གོང་དཀར་བའི་གསན་ཡིག་ན་ཀུན་བསོད་འདུག་པས་བརྟག།",
    "པཎྜི་ཏ་བེ་རོ་ཙ་ན་རཀྵི་ཏ།",
    "འདིས་འབྲི་ཁུང་དཔལ་འཛིན་རྩོད་པའི་སྒོ་ནས་རྨེག་མེད་དུ་བཅོམ་སྟེ་དཔལ་འཛིན་ལ་ཀློག་གོ་ཆོད་ཅིག་ལས་མི་འདུག་གསུང་སྐད།",
    "ཤར་པའི་གསན་ཡིག་ན་དོན་རི་གྲགས་པ་དཔལ་ཞེས་འདུག།",
    "འདི་གོང་དཀར་བའི་གསན་ཡིག་ན་འདུག་ཀྱང་གཞན་ཚོར་མི་སྣང་བ་ཆད་འདྲ།",
    "རྗེ་བཙུན་བཙོང་ཁ་པ་དང་གོང་དཀར་བའི་གསན་ཡིག་ན་ཤེར་རིན་ཟེར་བ་འདུག།",
    "ཐར་རྩེ་སྒྲུབ་ཁང་ཤར་པ་གསུམ་གྱི་གསན་ཡིག་ན་འདི་མི་འདུག་ཀྱང་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་བརྒྱུད་ལུགས་གཉིས་ཀར་འདུག་པས་ཆད་འདྲ།",
    "ཐར་རྩེ་པ་དང་ཤར་པའི་གསན་ཡིག་ན་གཏུམ་པོ་བདེ་ཆེན་ཞེས་འདི་གཉིས་གཅིག་ཏུ་མཛད་འདུག་ཀྱང་ངོར་ཆེན་དང་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་སོ་སོར་སྣང་ངོ།",
    "ཐར་རྩེ་པ་དང་ཤར་པའི་གསན་ཡིག་ན་འདི་གཉིས་གཅིག་ཏུ་འདུག་ཀྱང་ངོར་ཆེན་དང་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་ལྟར་སྣང་ངོ།",
    "གེ་ཟེར་བ་འདུག་པ་ཡིག་སྐྱོན་ཤོར་རམ་སྙམ།",
    "ཐར་རྩེ་པ་དང་ཤར་པའི་གསན་ཡིག་ན་དཔེ་མེད་རྒྱ་མཚོ་ཆེན་པོ་སོ་སོར་ཕྲལ་འདུག་པ་ཡིག་ནོར་བྱུང་ངམ་སྙམ།",
    "ངོར་ཆེན་གོང་དཀར་བ་མཁྱེན་བརྩེ་གསུམ་གྱི་གསན་ཡིག་ན་འདུག་རུང་ཐར་རྩེ་པ་དང་ཤར་པའི་གསན་ཡིག་ཏུ་མི་སྣང་བ་ཆད་པ་འདྲ།",
    "འཕགས་མཆོག་བྱམས་པ་སྐལ་བཟང་ལ་གསན་འདུག་ཀྱང་།",
    "གྲ་དོལ་གྱི་མཚམས་ན་བཅུར་ཟེར་བ་ཞིག་འདུག་པ་དེ་ནས་ཡིན་པ་ཆོག་ཁྲིགས་དངོས་གྲུབ་འདོད་འཇོར་གསལ།",
    "སྦྱིན་སྲེག་རྣམས་ཀྱི་ཊཱིཀྐ་འདུག་ཀྱང་དཔེ་མ་འབྱོར་བས་ལུང་མ་ཐོབ།",
    "རྗེ་མཁྱེན་བརྩེས་སྒོ་རུམ་པར་གསན་པའི་ཐོར་སྟོན་གྲགས་ཞོར་བ་ཞེས་འདུག་པ་འདི་དང་གཅིག་མི་གཅིག་བརྟག།",
    "བ་སོགས་གོ་རིམ་མི་མཐུན་ཙམ་སྣང་བའི་ལུགས་གཉིས་གང་བྱས་ཀྱང་འགལ་བ་ཆེར་མི་འདུག་༩༤བ་ཅིང་།",
    "ཆོག་སྒྲིགས་གཉིས་ཀ་ན་འདུག་ཅིང་ཕྱག་ལེན་ལའང་མཛད།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་གཉིས་ཀྱི་བར་དུ་བདེ་བྱེད་ཀྱི་ཆོ་ག་སྣ་ཚོགས་པའི་མཛོད་དང་དཔའ་བོ་རྡོ་རྗེས་མཛད་པའི་ལུས་ངན་པོའི་སྒྲུབ་ཐབས་ཐར་ལོའི་འགྱུར་གཉིས་འདུག་པ་དཔེ་མ་འབྱོར་བས་མ་ཐོབ།",
    "འདི་གཉིས་ཀྱི་བར་ན་རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་གནོད་སྦྱིན་བེལ་ཕོངས་ཀྱིས་མནན་ཐབས་གུར་ག་དེ་ཝས་མཛད་པ་འདུག་ཀྱང་དཔེ་མ་འབྱོར་པས་མ་ཐོབ།",
    "རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ཏུ་འདི་གཉིས་ཀྱི་བར་ན་ཕྱག་རྡོར་གསང་བའི་མཚན་བརྒྱད་ཀྱི་བསྟོད་པ་ཞེས་པ་འདུག་པ་དཔེ་མ་འབྱོར་བས་མ་ཐོབ།",
    "གཡོན་ནེའུ་ལེའི་རྐྱལ་པ་དང་མཆན་ཁུང་ན་བེ་ཅོན་བསྣམས་པ་ཞིག་འདུག།",
    "རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་བར་འདིར་འགྲེལ་པ་འདུག་པ་དཔེ་མ་བྱུང་བས་ལུང་མ་ཐོབ།",
    "འདིའི་མཇུག་ན་རྣམ་སྲས་སྤྲིན་གསེབ་མ་གཏེར་མ་རྫོགས་སོ་ཟེར་བ་འདུག་ཀྱང་དེང་སང་འདི་རྙིང་མ་བཀའ་མར་ངོས་འཛིན་མཛད་པ་ཡིན།",
    "ལི་ཡུལ་དུ་སློབ་དཔོན་བི་མ་ལ་མི་ཏྲ་དང་ལོ་ཙཱ་བ་བེ་རོ་ཙ་ནས་བསྒྱུར་བ་དང་།",
    "མཁྱེན་བརྩེའི་གསན་ཡིག་ན་གསང་ཡུམ་གྱི་ཞལ་གདམས་ཞེས་པ་ལས་སོ་སོའི་གསལ་ཁ་མི་འདུག།",
    "མཁྱེན་བརྩེའི་གསན་ཡིག་ཏུ་འདི་གཉིས་ཀྱི་བར་ན་སྔགས་ཀྱི་ཐེམས་ཡིག་འདུག་པ་དཔེ་མ་འབྱོར་པས་མ་ཐོབ།",
    "གསན་ཡིག་ན་སྟག་མདའི་སྒྲུབ་ཐབས་དང་ནོར་རྟེན་འཛུགས་པ་འདུག་པ་དཔེ་མ་འབྱོར་བས་མ་ཐོབ།",
    "འདི་རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་གཤམ་གྱི་བསྟོད་པའི་མཛད་བྱང་ལ་བརྟེན་ནས་ཐུགས་སྲས་ལོ་ཙཱ་བས་མཛད་གསུངས་པ་འདུག་ཀྱང་འདི་ཙནྡྲ་ཤྲཱིས་མཛད་ངེས་ཡིན་པ་ཁྱབ་བདག་ཞ་ལུ་པ་གསུང་།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་པ་འདྲ།",
    "མཁས་པ་བེ་རོ་ཙ་ན།",
    "༦ཐར་རྩེ་དང་སྒྲུབ་ཁང་པའི་གསན་ཡིག་ན་མི་འདུག་ཀྱང་བུ་སྟོན་ངོར་ཆེན་གོང་དཀར་བ་མཁྱེན་བརྩེ་བཞིའི་གསན་ཡིག་ན་འདུག།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་བརྟག།",
    "གསན་ཡིག་ན་མཁན་ཆེན་གྲགས་གཞོན་པས་བུ་སྟོན་ལ་ཐུག་འདུག་པ་དཔྱད།",
    "རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་མི་འདུག།",
    "རྗེ་མཁྱེན་བརྩེ་གསུམ་གྱི་གསན་ཡིག་ན་ཟངས་དཀར་ལུགས་ཀྱི་བརྒྱུད་པར་ངོས་འཛིན་མཛད་འདུག་ཅིང་སྒྲུབ་ཁང་པའི་གསན་ཡིག་ན་སྨད་ལུགས་སུ་བཞེད་དོ།",
    "སྒྲུབ་ཁང་པ་གསུམ་གྱི་གསན་ཡིག་ནའང་ཁ་ཆེའི་བརྒྱུད་པར་མཛད་འདུག།",
    "གོང་དཀར་བའི་གསན་ཡིག་ནའང་སྟོད་ལུགས་སུ་བགྲངས་འདུག་ཅིང་རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་སྨད་ལུགས་ཟེར་བ་འདུག་པ་ཕྱག་བྲིས་ནོཪ་ཪམ་སྙམ་པ་དཔྱད།",
    "༨འདི་ཐར་རྩེ་པའི་གསན་ཡིག་ན་རྡོར་དབྱིངས་འབྲེལ་ལུགས་ཀྱི་བརྒྱུད་པར་ངོས་བཟུང་འདུག།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་གྲུབ་ཐོབ་དང་པཎྜི་ཏ་གཉིས་ཀའི་བརྒྱུད་པར་མ་ཕྱེ་བའི་མར་ལུགས་སྤྱི་ཙམ་པ་ཞིག་ཏུ་མཛད་འདུག་པ་དཔྱད།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་མི་འདྲེན་པ་འདྲ་ཞིག་འདུག་ཀྱང་ཆུ་བོ་གཉིས་འདྲེས་ཡིན་པས་སྐྱོན་དུ་མི་འགྱུར།",
    "རྡོ་རྗེ་འཆང་སྔགས་རམ་པའི་གསན་ཡིག་ན་བར་འདིར་རིག་པའི་ཁུ་བྱུག་འདུག་པ་ཆད་དམ་དཔྱད།",
    "ཀུན་མཁྱེན་བུ་དང་སྔགས་རམ་པའི་གསན་ཡིག་ན་འདི་ལྟར་སྣང་བ་ཐར་རྩེ་སྒྲུབ་ཁང་པའི་གསན་ཡིག་ན་ཤེས་རབ་རྒྱལ་མཚན་ཟེར་བ་འདུག་པ་ནོར་རམ་དཔྱད།",
    "སྔགས་རམ་པའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་བརྟག།",
    "རྗེ་བཙོང་ཁ་པའི་གསན་ཡིག་ན་ང་མཐའ་མི་འདུག་པ་བརྟག།",
    "སྔགས་རམ་པའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་འདྲ།",
    "༣འདི་གསུམ་སྔགས་རམ་པའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་སྙམ།",
    "གོང་དཀར་བའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་སྙམ།",
    "ལས་མཁན་པ་ཇོ་ཆེན་པོའི་ཐུགས་དམ་བསྐང་ཟེར་བ་འཇུག་སྲོལ་ཀྱང་འདུག་ཅིང་།",
    "རྡོ་རྗེ་འཆང་སྔགས་རམ་པའི་གསན་ཡིག་ཏུ་ཤ་བ་རི་པ་ཞེས་འདུག།",
    "ཤར་པ་གསུམ་གྱི་གསན་ཡིག་ན་འདི་གཉིས་གོ་ལྡོག་ཏུ་འདུག་ཀྱང་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ལྟར་བྲིས་པ་ཡིན་པདྨ་བཛྲ་འདི་སློབ་དཔོན་མཚོ་སྐྱེས་དང་གཅིག་གམ་སྙམ་ཨོ་རྒྱན་ཆེན་པོ་ནི་མིན་ནོ།",
    "རྗེ་མཁྱེན་བརྩེའི་བརྒྱུད་ཡིག་གཅིག་ལ་རྒྱལ་པོ་དང་གཅིག་ལ་རྒྱ་མཚོ་ཞེས་འདུག་པས་དཔྱད་དོ།",
    "ཐར་རྩེ་སྒྲུབ་ཁང་པ་ཤར་པ་གསུམ་གྱི་གསན་ཡིག་ཏུ་དོན་ཡོད་རྡོ་རྗེ་ཡིན་ཚུལ་འདུག་པ་གསང་མཚན་དང་འཁྲུལ་ལམ་དཔྱད།",
    "རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་ལྟར་འདུག་ཀྱང་ཀུན་མཁྱེན་བུའི་གསན་ཡིག་ན་དྷརྨ་ཀ་ར་མ་ཏི་དང་རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་ཨ་ཀ་ར་མ་ཏི་ཞེས་སྣང་།",
    "ཐར་རྩེ་སྒྲུབ་ཁང་ཤར་པ་གསུམ་གྱི་གསན་ཡིག་ན་དྷརྨ་ཨཱ་ཀཱ་ཤ་མ་ཏི་ཞེས་འདུག་པ་བརྟག།",
    "བུའི་གསན་ཡིག་ན་འདི་མི་འདུག་པས་བརྟག།",
    "གསན་ཡིག་ཏུ་པེནྟ་པ་ཟེར་བ་འདུག་པ་ཆད་དམ་སྙམ།",
    "ས་ཕྱོགས་འདི་ན་བྲིན་སྒོ་མི་འདུག་པས།",
    "རྭ་ཚོ་ཤར་པ་ཡིན་ཟེར་བ་འདུག།",
    "འདི་ལ་ཕྱག་ལེན་ཀྱང་རིགས་མི་གཅིག་པ་འགའ་ཞིག་འདུག་པ་དང་།",
    "མངའ་རིས་པ་རྗེ་བཙུན་བཙོང་ཁ་པ་ཆེན་པོའི་གསན་ཡིག་ཏུ་འདི་གཉིས་སོ་སོར་འཕྲལ་འདུག་པ་ཡིག་སྐྱོན་བྱུང་འདྲ།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་འདི་མི་འདུག།",
    "ཀྱི་ལུང་བརྒྱུད་ལས་བརྒྱུད་པ་མི་གཅིག་ཙམ་འདྲེན་པ་གནང་འདུག་པ་རྣམ་གྲངས་ཞིག་ཡིན་པ་འདྲ།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེས་འཁྲིད་ཀྱི་ཟིན་བྲིས་ཚར་ཆེན་ལ་སྤྱན་འབེབས་ཞུས་པས་ངེད་ཀྱིས་གང་དཔོད་དེ་ག་ཚིག་ཟུར་མ་ཉམས་པར་བྱུང་འདུག།",
    "བློ་ཁོགས་བྱས་པ་རྣམས་མ་ཐེབས་འདུག་གསུང་ཀྱལ་ཀ་མཛད་སྐད།",
    "བར་སྐབས་ཀྱི་ཚིགས་བཅད་རྣམས་ཀྱང་སྙན་པོ་འདུག་པས་ཀློག་གཏོང་གསུངས་ནས་ལུང་དང་ལྷན་དུ་གནང་ངོ།",
    "འདིའི་རྗེས་སུ་རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་ཁྲོ་ལོས་མཛད་པའི་སྤྱི་ཆིངས་ནང་ཆིངས་གཉིས་མི་འདུག་པ་མ་ཐོབ།",
    "དེའི་དོན་འགྲེལ་གྱི་སྒྲུབ་ཐབས་རྒྱས་པ་སྔགས་འཆང་དཔལ་གྱི་མིང་ཅན་ཁྲོ་ཕུ་ལོ་ཙཱ་བ་མི་ཕམ་བཤེས་གཉེན་གྱིས་མཛད་པའི་ལྷ་བཅུ་བདུན་མའི་སྒྲུབ་ཐབས་དང་ལུས་དཀྱིལ་མངོན་རྟོགས་གཉིས་གསན་ཡིག་ན་འདུག་པ་རྒྱུན་མ་བྱུང་།",
    "གསན་ཡིག་ན་མངོན་རྟོགས་ཆེ་ཆུང་གསུམ་འདུག་ཀྱང་གཉིས་ཀྱི་རྒྱུན་མ་རྙེད།",
    "འདིའི་རྗེས་སུ་གསན་ཡིག་ཏུ་མི་ཕམ་ཟླ་བའི་བསྔོ་བ་ནོར་བུའི་སྒྲོན་མེ་འདུག་ཀྱང་རྒྱུན་མ་བྱུང་།",
    "འབྲུ་དགུ་ཞེས་པ་རྣམས་གསན་ཡིག་ན་འདུག་ཀྱང་རྒྱུན་མ་བྱུང་།",
    "ཏིང་ངེ་འཛིན་གྱི་རྩལ་འཁྲིད་རྣམས་གསན་ཡིག་ན་འདུག་ཀྱང་རྒྱུན་མ་རྙེད།",
    "ཕྱག་མཚན་གྱི་སྒྲུབ་ཐབས་བཞི་ལས་ཚོགས་ཀྱི་མཐའ་བསྡུ་བ་རྣམས་གསན་ཡིག་ན་འདུག་ཀྱང་རྒྱུན་མ་རྙེད།",
    "བ་ཧུ་ཏ་དང་མུས་ཏོ་བ་ཞེས་སོ་སོར་འདུག་ཅིང་།",
    "རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་འདི་གཉིས་ཀས་རྨ་ལ་ཐུག་ཅིང་འགོ་འོམ་གྱིས་གཉིས་ཀ་ལ་ཞུས་ཚུལ་འདུག་པ་རྙིང་མ་དང་མཐུན།",
    "ངོར་ཆེན་དང་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་བཀའ་བབས་བདུན་ལས་མི་འདུག་ཀྱང་ཇོ་བོ་ལུགས་གཉིས་སོ་སོར་བགྲངས་གཉོས་ལུགས་བསྣན་པས་དགུ་བྱུང་ངོ།",
    "བྷེ་ཀི་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ཏུ་ལཱུ་ཧི་པ་དང་འདི་གཉིས་གཅིག་པར་མཛད་འདུག།",
    "ཛྙཱ་ན་ཞེས་འདུག་པ་ཡིག་སྐྱོན་བྱུང་ངམ་སྙམ།",
    "ཐར་རྩེ་པའི་གསན་ཡིག་ན་འདི་ཇོ་བོའི་རྗེས་སུ་འདུག་པ་ཡིག་ནོར་བྱུང་འདྲ།",
    "འདི་གོང་དཀར་བའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་དཔྱད།",
    "གསན་ཡིག་ཚོར་འདི་བཞིན་འདུག་ཀྱང་མར་ལོ་སོགས་མ་བྱུང་བས་དམར་ལུགས་ཟེར་རྒྱུ་ཡིན་ནམ་དཔྱད།",
    "གོང་དཀར་བའི་གསན་ཡིག་ན་འདི་ཇོ་ལུགས་བརྒྱུད་པའི་རྣམ་གྲངས་སུ་མཛད་འདུག་ཅིང་ཐར་རྩེ་ཤར་པའི་གསན་ཡིག་ན་དཀྱུས་བཞིན་དུ་སོ་སོར་སྣང་།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ཏུ་འདིའི་རྗེས་སུ་ནག་པོ་པ་འདུག།",
    "གོང་དཀར་བའི་གསན་ཡིག་ནའང་མཚན་གསལ་མི་འདུག།",
    "ཞེས་གཅིག་ཏུ་བསྡོམས་འདུག་ཀྱང་གོང་དཀར་བ་དང་ཐར་རྩེ་པའི་གསན་ཡིག་ན་དཀྱུས་ལྟར་སྣང་ངོ།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་མི་འདུག་པ་བརྟག།",
    "གྲུབ་ཆེན་བེ་རོ་ཙ་ན་བཛྲ།",
    "འདི་གོང་དཀར་བའི་གསན་ཡིག་ན་མི་འདུག་ཀྱང་ཐར་རྩེ་པའི་གསན་ཡིག་ན་སྣང་བས་ཆད་དམ་སྙམ།",
    "ཐར་རྩེ་པའི་གསན་ཡིག་ན་སྣང་བས་གོང་དཀར་བའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་སྙམ།",
    "རྗེ་བཙུན་བཙོང་ཁ་པའི་གསན་ཡིག་ན་འདི་གཉིས་ཀྱི་ཚབ་ཏུ་འཁོན་དཀོན་ཅོག་རྒྱལ་པོ་སྣང་ཞིང་ཕྱི་མ་འདི་མཁྱེན་བརྩེ་དང་ཐར་རྩེའི་གསན་ཡིག་ན་དཀྱུས་ལྟར་འདུག་པ་དགྲ་ལྷ་འབར་མིན་ནམ་དཔྱད།",
    "ཐར་རྩེ་པའི་གསན་ཡིག་ཏུ་མི་འདུག་ཀྱང་མཁྱེན་བརྩེའི་དེར་སྣང་བས་ཆད་དམ་སྙམ།",
    "ཐར་རྩེ་དང་ཤར་བའི་གསན་ཡིག་ན་འདིའི་ཚབ་ཏུ་རི་སུལ་གྱི་རྣལ་འབྱོར་མ་འདུག་པ་ཞལ་གྱི་བརྒྱུད་པ་དཀྱུས་ཤོར་བྱུང་འདྲ།",
    "ཐར་རྩེ་དང་ཤར་པའི་གསན་ཡིག་ན་མི་འདུག་པ་ཆད་དམ་སྙམ།",
    "འདིའི་མཇུག་ཏུ་མཁས་གྲུབ་རྗེས་སྒྲུབ་ཐབས་རྒྱ་གཞུང་འདི་ལ་ཡི་གེ་རྙིང་པ་ན་མཆན་ཆུང་ཉག་ཉོག་མང་པོ་བཏབ་འདུག་ནའང་དགོས་པ་ལྷག་པོ་ཅི་ཡང་མི་སྣང་བས་མ་བྲིས་སོ།",
    "ཞེས་གསུངས་འདུག་གོ།",
    "ཞེས་པ་འདུག་ཅིང་ཤོག་དྲིལ་ཕྱི་མ་ཕལ་ཆེར་ལའང་དེ་ལྟར་སྣང་ངོ།",
    "རྡོར་བཟླས་ཀྱི་ཤོག་དྲིལ་གཞན་དུ་གསལ་ཞེས་ཁ་འཕངས་འདུག་ཀྱང་དཔེ་ཟུར་པ་མ་རྙེད།",
    "ལ་རྡོ་རྗེ་འཆང་ཕ་བོང་ཁ་པས་གསན་འདུག་ཀྱང་ཁོང་ལ་མཚན་ཉིད་པའི་རྟགས་ཀྱི་གསན་ཡིག་སོགས་མེད་འདུག་པས་བརྒྱུད་པ་འདྲི་བའི་བློ་འཚབ་འཚུབ་མི་དགོས་པར་རང་མལ་དུ་གནས་ཆོག་པའོ།",
    "དེས་མཛད་པའི་ཁོག་འབུབས་སུ་དཀར་ཆག་དང་མཐུན་པར་འདུག་པ་ཐེ་ཚོམ་མི་བྱའོ།",
    "སྒྲིབ་སེལ་དང་གནས་སྦྱོང་འབྱམས་གཅོད་ཀྱི་ཟ་བྱེད་མཁའ་འགྲོའི་སྦྱིན་སྲེག་ཀླུ་སྒྲུབ་པའི་ཁོག་འབུབས་སུ་འདི་སཱཙྪའི་འཇུག་ཏུ་འདུག།",
    "ཀླུ་སྒྲུབ་པའི་ཁོག་འབུབས་ན་འདི་གཉིས་གོ་ལྡོག་འདུག་ནའང་དཀར་ཆག་དང་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་ཁོག་འབུབས་ན་འདི་ལྟར་བྱུང་ངོ།",
    "དཀར་ཆག་ཏུ་ཡི་གེ་ཚན་པ་ཉི་ཤུ་རྩ་གཉིས་ཡོད་གསུངས་ཀྱང་ས་ཐོར་ཡ་ཡན་གྱི་ཉེར་བཞི་འདུག་པ་དཔྱད།",
    "འདི་གསུང་ཡིན་མིན་ལ་རྩོད་པ་བྱུང་ནའང་བཀའ་སྒྲུབ་བསྟན་པའི་སྐབས་བསྒྲུབས་ཟིན་ཞེས་པ་དཀར་ཆག་ཏུ་འདུག་གོ།",
    "ཐོག་མར་རྩོམ་པའི་དུས་འདི་རྣམས་འཁོར་འདས་དབྱེར་མེད་ཀྱི་འགོར་བྲིས་ཡོད་འདུག།",
    "མཛད་བྱང་ན་ཧྲེ་ད་ཧྰ་ཛ་ཞེས་རྒྱ་སྐད་དུ་བྲིས་འདུག།",
    "པོད་དམར་ན་འདིའི་མཇུག་ཏུ་བརྟག་གཉིས་ཀྱི་ལུང་སོགས་འགའ་ཞིག་དྲངས་པའི་མཐར་ཞང་འཕགས་པ་ལྷས་བསྐུལ་ནས་རྗེ་བཙུན་གྱིས་མཛད་ཚུལ་འདུག།",
    "པོད་དམར་ན་གཉུག་མ་དྲན་གསལ་དངོས་འདི་ལ་ངོས་བཟུང་འདུག།",
    "ཡན་ལས་མི་འདུག།",
    "འདི་བརྒྱུད་པ་འགངས་ཆེ་བ་གཅིག་ཏུ་འདུག།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་མི་འདུག་པ་བརྟག།",
    "འཛམ་དབྱངམཁྱེན་བརྩེའི་གསན་ཡིག་ན་དྷརྨ་ཡེ་ཤེས་ཞེས་འདུག་པ་བརྟག།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་ལྟར་འདུག་ཀྱང་རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་བི་ན་པ་ཏི་དང་ཐར་རྩེ་པའི་དེར་བཱི་ན་པ་ཞེས་པི་ཝཾ་འཛིན་པ་ཡིན་ཞེས་སྣང་ངོ།",
    "མཁྱེན་བརྩེའི་གསན་ཡིག་ན་ཟུར་ཆག་འདི་བཞིན་འདུག་རྡོ་རྗེ་གདན་པའི་དེར་ལཀྵི་དང་ཐར་རྩེ་པའི་དེར་ཕུན་ཚོགས་ཞབས་ཞེས་བསྒྱུར་འདུག་གོ།",
    "གོང་དཀར་བ་དང་ཐར་རྩེ་པའི་དེར་བཟང་པོའི་ཞབས་སུ་བསྒྱུར་འདུག།",
    "གོང་དཀར་བའི་དེར་བྷུ་ཤ་ན་དང་ཐར་རྩེ་པའི་དེར་བྷུ་ཥ་ཎ་འདུག།",
    "དཀར་བའི་དེར་པདྨ་པ་ཟེར་བ་འདུག།",
    "ཐར་རྩེ་པའི་གསན་ཡིག་ན་འདིས་གོང་མ་གཉིས་ཀ་ལ་གསན་ཟེར་བ་འདུག།",
    "གོང་དཀར་བའི་གསན་ཡིག་ན་གྷ་ཡ་དྷ་ར་ཟེར་བ་འདུག་པ་བླ་ཆེན་གྱིས་རྒྱ་གར་དུ་དཔའ་བོ་རྡོ་རྗེ་དང་བོད་དུ་གྷ་ཡ་དྷ་ར་ལ་གསན་པའི་ཁུངས་མཛད་འདུག།",
    "རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་འདི་ལྟར་འདུག་ཀྱང་རྡོ་རྗེ་གདན་པ་དང་ཐར་རྩེ་པའི་དེར་འདི་གཤམ་དུ་ཨིནྡྲ་བྷུ་ཏི་འདུག་པས་ཚིགས་བཅད་ལྟར་ན་དཔལ་བདེ་བ་དང་ཨིནྡྲ་བྷུ་ཏི་ཆེ་བ་གཉིས་གཅིག་པ་འདྲ།",
    "གསན་ཡིག་གཞན་གཉིས་ན་ཚངས་པའི་ཞབས་ཞེས་བསྒྱུར་འདུག།",
    "རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་ཨུ་པ་ལ་ཟེར་བ་འདུག་པ་དཔྱད།",
    "ཐར་རྩེ་པའི་དེར་ལེགས་སྨིན་ཞེས་ཟུར་ཆག་འདུག་གོ།",
    "རྡོ་རྗེ་གདན་པའི་དེར་བཱི་ར་བཛྲ་དང་ཐར་རྩེ་པའི་དེར་དཔའ་བོ་རྡོ་རྗེ་ཞེས་འདུག་པར་དཔྱད།",
    "རྡོ་རྗེ་གདན་པའི་དེར་བོད་དུ་ཡང་ཤེས་རབ་གསང་བར་གསན་ཟེར་བ་འདུག།",
    "དཀར་ཆག་ན་མི་གསལ་ཡང་འཇམ་དབྱངས་མཁྱེན་བརྩེས་སྒོ་རུམ་པར་གསན་པའི་ཡི་གེར་བསྟོད་པ་དང་བཅས་ཟེར་བ་འདུག་པས་བརྩེ་བས་རྗེས་ཆགས་མ་ཞེས་པའི་བློ་ཀ་གཅིག་པུ་དེའོ།",
    "བརྒྱུད་པ་སྒྲུབ་པ་ཆར་དབབ་པ་སྟེ་དོན་གསུམ་གྱིས་བསྟན་པའི་ཀླུའི་རྒྱལ་པོ་ཝ་རུ་ཎའི་ཆར་འབེབས་རྒྱ་གར་བེ་རོ་ཙ་ནའི་རང་འགྱུར་དུ་མཛད་པ།",
    "རྡོ་རྗེ་གདན་པའི་༢༧༦བ་གསན་ཡིག་ན་རིག་པའི་སེང་གེ་ཟེར་བ་འདུག།",
    "རྡོ་རྗེ་གདན་པའི་ཕྱག་བྲིས་ན་འདི་མི་འདུག་པ་ཆད་དམ་དཔྱད།",
    "རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་བར་འདིར་ལུང་མང་པོ་ཟེར་བ་ཞིག་འདུག་ཀྱང་རྗེ་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་མི་འདུག་པ་བརྟག།",
    "དཀར་ཆག་ན་བར་འདིར་ཚོགས་བདག་དཀར་པོ་ཤ་བའི་གདོང་ཅན་གྱི་སྒྲུབ་ཐབས་ཟེར་བ་ཞིག་འདུག་ཀྱང་དཔེ་མ་འབྱོར་བས་ལུང་མ་ཐོབ།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ན་ཧཱུཾ་ཀ་ར་ཟེར་བ་འདུག།",
    "རྡོ་རྗེ་གདན་པ་དང་ཐར་རྩེ་པའི་གསན་ཡིག་ན་འདི་དང་ས་པཎ་གྱི་བར་ན་འཕགས་པ་མི་འདུག།",
    "འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ནའང་འདི་ཉིད་ལ་གྲགས་པས་དངོས་སུ་གསན་འདུག།",
    "འགོར་རྒྱ་གར་སྐད་དུ་ཙཀྲ་སཾ་བྷ་ར་མ་ཧཱ་ཡ་ན་སཱུ་ཏྲ་ཞེས་ཡོད་པའི་བ་རི་བས་གཏེར་བཏོན་ནས་མུ་སྟེགས་སྐལ་ལྡན་རྒྱལ་པོ་བཏུལ་བའི་ལོ་མུ་སྟེགས་གསད་པས་ལོ་བཅུ་གཉིས་ཀྱི་བར་རྡོ་རྗེ་གདན་པས་ལོ་ཙཱ་བ་མཇལ་ཁར་མ་བཏང་ཟེར་བ་འདུག།",
    "འདུག་སྟངས།",
    "ཞེས་ཆེད་དུ་བརྗོད་པའང་རང་བཞིན་བརྗོད་པའི་རྒྱན་ཁོ་ན་ཡིན་ལ།",
    "འགའ་ཞིག་བུ་ལུང་ཀུན་རྡོར་གྱིས་མཛད་གསུང་ཡང་རང་ལུགས་ལ་མི་བཞེད།",
    "འདི་མལ་དང་འཕགས་པའི་དུས་གང་དུ་བྱུང་དཔྱད་དགོས་འདུག་གོ།",
    "མུས་སྲད་པ་སོགས་ལ་ལ་དམ་པས་མཛད་པར་བཞེད་ཅིང་སེར་པོད་ན་གཟུངས་པས་མཛད་ཟེར་བ་འདུག་ཀྱང་བླ་ཆེན་བསོད་བློའི་མན་ངག་ཚིགས་བཅད་ཀྱིས་མིན་པར་ཤེས་ནུས་སོ།",
    "སེར་པོད་ཀྱི་དེར་མཛད་བྱང་ཆད་འདུག།",
    "དཀར་ཆག་དང་གསན་ཡིག་ན་མཛད་ཅེས་སྣང་ཡང་ཡི་གེ་ན་བཤུས་ཟེར་བ་འདུག།",
    "འདུག་གོ།",
    "དཀར་ཆག་ན་གཞན་གྱི་རྦོད་གཏོང་ཟློག་པ་ཙམ་ལས་མི་འདུག་ཀྱང་བརྗོད་བྱ་ལ་དཔགས་ན་འདི་བཞིན་ཚང་ངམ་སྙམ་ཞིང་།",
    "དཀར་ཆག་ན་གཉིས་ཡོད་གསུངས་ཀྱང་གཅིག་མ་རྙེད་མལ་ལོའི་དབོན་པོས་མཛད་ཟེར་བ་བྱུང་འདུག་རུང་དེ་ལྟར་མིན་ཚུལ་ཡར་ཀླུངས་པ་གསུང་།",
    "རྦོད་ཁ་འདོམ་པ་རྣམས་སོ་སོར་ཕྲལ་འདུག་གོ།",
    "དཀར་ཆག་ན་འདི་ལྟར་འདུག་པ་ཡུམ་བཞིའི་བསྐུལ་ལ་དགོངས་སམ་སྙམ་བཀའ་གཏེར་གང་ཡིན་མ་ངེས།",
    "ཁ་སྐོང་ན་ཡོད་པའི་འཕགས་པས་མཛད་པ་དེ་འདི་ལས་རྒྱས་སུ་བཏང་འདུག།",
    "མེ་འབར་གླེགས་བམ་ལ་ལར་བསྟོད་པ་བདེ་དགའ་རྒྱ་མཚོ་སོགས་བསྣན་པའི་མང་ཙམ་འདུག་པ་ལྷད་ཡིན་མིན་བརྟག།",
    "འདི་རྒྱ་བོད་སུ་ཡིན་ལ་དཔྱད་གཞི་མཛད་མཁན་མང་ཡང་རང་ལུགས་རྒྱ་གར་བར་བཞེད།",
    "འདི་ཐོག་མར་བཞུགས་རིགས་པ་འདྲ་ཞིག་འདུག་ནའང་།",
    "སེར་པོད་ན་གཉན་ཕུལ་བྱུང་པ་པུནྱ་བཛྲ་གྱིས་མཛད་ཟེར་བ་འདུག།",
    "བསྟན་པ་དྲི་མེད་མ་ཟེར་བ་ཞིག་སྣང་བ་དཀར་ཆག་ཏུ་མི་འདུག་པ་ཆད་དམ་སྙམ།",
    "མེ་འབར་མའི་ས་པཎ་གྱིས་མཛད་པ་དེ་འདི་ལས་ཉུང་བ་འདུག་ནག་པོ་ཆེན་པོའི་མཆོད་རྟེན་མུ་",
    "སེར་པོད་ན་ཨི་དཾ་དུ་ཡན་རྡོ་རྗེ་འཆང་ཀུན་དགའ་བཟང་པོས་འགྲོལ་བར་མཛད་དེ་མན་ཞབས་ཏོག་ཏུ་བྲིས་ཟེར་བ་འདུག།",
    "དཀར་ཆག་ན་གུར་ཞལ་ལས་མཁན་དང་བཅས་པའི་སྔགས་བྱང་ཟེར་བ་ལས་ངོར་པ་དང་ས་བཟང་པ་སོགས་ནང་གསེས་ཀྱི་དབྱེ་གསལ་མི་འདུག།",
    "འདིའི་མཇུག་ན་དེ་ལྟ་བུའི་མན་ངག་གླེགས་བམ་འདི་ཞེས་སོགས་ཀྱི་ཤོ་ལོ་ཀ་དྲུག་ཙམ་ཞིག་ས་སྐྱའི་ཕྱག་དཔེར་བྲིས་འདུག་ཀྱང་གནས་གསར་དང་བོད་མཁར་བ་གཉིས་ཀའི་ཕྱག་དཔེར་མི་འདུག་ཅིང་ལུང་ཡང་མ་ཐོབ།",
    "འདི་དྷརྨཱ་གཟི་བརྗིད་ཀྱིས་མཛད་ཅེས་དཀར་ཆག་ན་འདུག་གོ།",
    "འབར་མའི་དེ་དང་ཞུས་དག་ཕེར་བ་ཞིག་འདུག།",
    "པས་ཆོལ་པར་མི་སྟོན་པའི་བཀའ་རྒྱ་དམ་པོ་དཀར་ཆག་ཏུ་གསལ་བར་འདུག་གོ།",
    "འདིའི་རྗེས་སུ་ནག་པོ་ཆེན་པོའི་བསྙེན་སྒྲུབ་རྦད་གསད་ཀྱི་ཡི་གེ་རྙིང་པ་ཞེས་པ་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་གསན་ཡིག་ནའང་མི་འདུག་ཅིང་རྒྱུན་ཆད་མ་ཆད་ཇི་ལྟར་ཡང་མ་ཐོབ།",
    "འདི་དང་མེ་འབར་མའི་ཕྱི་པ་ལྟར་སྒྲུབ་པ་གཉིས་ཁྱད་པར་མེད་ཅེས་དཀར་ཆག་ཏུ་གསུང་པ་ལྟར་ཞུས་དག་ཀྱང་ཕེར་བ་འདུག་གོ།",
    "གདམས་བསྙེན་སྒྲུབ་ལས་གསུམ་གྱི་ཡི་གེ་ཞེས་པ་འདུག།",
    "འདིའི་རྗེས་སུ་རྔོག་ཞེ་སྡང་རྡོ་རྗེས་མཛད་པའི་དུད་སོལ་མའི་གཏོར་ཆོག་ལག་ལེན་དུ་བསྒྲིགས་པ་ཞིག་ཡོད་འདུག་པ་ནི་མ་ཐོབ།",
    "འདིའི་འོག་ཏུ་ཟོར་དང་གཏོར་མནན་གྱི་ཡི་གེ་ཞིག་ཡོད་འདུག་པ་ནི་མ་ཐོབ།",
    "གོང་དཀར་བའི་གསན་ཡིག་ཏུ་ཞེ་སྡང་རྡོ་རྗེ་ཞེས་གསང་མཚན་བྲིས་འདུག།",
    "མཆོགགསན་ཡིག་ན་དབུགས་ཟེར་བ་འདུག་པ་དཔྱད།",
    "འདི་གཉིས་ལ་བར་ཐང་པ་ཡབ་སྲས་ཟེར་བ་དཀར་ཆག་དང་རྡོ་རྗེ་གདན་པའི་གསན་ཡིག་ན་འདུག།",
    "རྗེས་གནང་འགའ་ཞིག་ཚར་ཆེན་རང་ལའང་གསན་འདུག་གོ།",
    "མཁན་ཆེན་དཔལ་ལྡན་བཀྲ་ཤིས་པའི་ཟིན་བྲིས་ན་པུ་ཏྲ་རྐྱང་པ་ཡིན་པ་འདྲ་ཞིག་འདུག་པ་གསུང་སྒྲོས་མ་ཟིན་པར་མངོན།",
    "ལྷག་བསམ་རབ་དཀར་གྱི་དྲི་ལན་དུ་འདིའི་བརྒྱུད་པ་འཁྲིད་ཀྱི་བརྒྱུད་པ་དང་གཅིག་པའི་ཕྱོགས་མཛད་འདུག་ཀྱང་ཅུང་ཟད་ཐུགས་སྣང་ལ་མ་ངེས་པ་ཞིག་བྱུང་བར་སེམས་སོ།",
    "སྒོ་རུམ་པར་གསན་པ་དེར་མི་གཅིག་པར་བགྲངས་འདུག་པ་འདིར་གཉི་གའི་དོན་ལ་དཔྱད་ནས་གསལ་བར་བགྱིས་ཡོད་དོ།",
    "སྙན་བརྒྱུད་ཀྱི་ནོར་ཕྱིར་གཏོང་བ་དང་བཤན་པ་རོ་འཁུར་གཉིས་ནི་མི་འདུག།",
    "ཅུང་ཟད་ཡོད་པ་ཞིག་འདུག།",
    "ཕལ་ཆེར་སྙན་བརྒྱུད་ཀྱི་ཞལ་བཞེས་ལ་རག་ལས་ཞེས་དཀར་ཆག་ན་སྣང་བས་ཡི་གེ་འདི་ལས་མང་བ་ཞིག་ཐོག་མ་ནས་མེད་ཚོད་དུ་འདུག།",
    "༣༧༩ན་སློབ་དཔོན་པདྨས་མཛད་པའི་ཁ་གསལ་མི་འདུག།",
    "སྔགས་བྱང་གསུམ་པོ་དཀར་ཆག་ཏུ་སྔགས་བྱང་ཞེས་པ་ལས་སོ་སོའི་གསལ་ཁ་མི་འདུག།",
    "ངོར་ལུགས་ལ་འདི་ས་ཆེན་གྱིས་མཛད་པའི་སྒྲུབ་ཁྲིགས་དང་སྦྲེལ་འདུག།",
    "འགོར་མན་ངག་འདིའི་འཁོར་ལོ་བྲི་བར་འདོད་ན་ཞེས་ཡོད་པའི་འཁོར་ལོའི་བྲི་ཐབས་འདི་གོང་དཀར་བའི་གླེགས་བམ་དུ་ཉིས་ལྡབ་འདུག། སྒོ་ཉིཡྰ་",
    "ཞལ་ངོར་པའི་དེར་བར་འདིར་བསྐྲད་འཁོར་འདྲི་ཚུལ་ཞིག་འདུག།",
    "ངོར་ལུགས་ལ་སྒབ་འདྲེ་གནོན་ཐབས་ཞེས་སྣང་བ་ནོར་བར་འདུག་གོ།",
    "པོའི་གཏོར་ཆེན་གྱི་མན་གོང་དཀར་བའི་གླེགས་བམ་ན་ཚང་བ་གཅིག་དང་བསྐལ་མེ་མ་མན་མེད་པ་ཞིག་དང་བཅས་འདུག།",
    "དེང་སང་འདི་དང་ཡུམ་གྱི་བསྟོད་པ་གཡས་ཕྱོགས་མ་གཉིས་སོར་སོར་བྲིས་པ་མང་ཡང་འདི་ཁའི་མུར་འཐུད་ནས་མཛད་བྱང་བྲིས་འདུག་གོ།"
  ]
}