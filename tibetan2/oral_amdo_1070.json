    "པདྨ་ཆེ་ཞེས་བྱ་བ་ནི་རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་གཟུགས་དེ་ཉིད་ཀྱིས་༥་ཐམས་ཅད་དུ་སོང་བའི་ཕྱིར།",
    "པདྨའི་ཏིང་ངེ་འཛིན་དེས་རང་དང་གཞན་གྱི་ཁྱེབག་ཆགས་དང་བཅས་པའི་ཉོན་མོངས་པའི་དྲི་མ་འཁྲུད་པར་པྱབྱེད་པའི་ཕྱིར་རོ།་།",
    "ཐམས་ཅད་རེ་རེའང་བདག་ཡིན་པར།",
    "རང་བཞིན་གྱིས་རྣམ་པར་དག་པའི་སོ་སོར་རྟོག་པར་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱིས་གཟིགས་པའི་ཕྱིར་སྤྱན་རས་གཟིགས་སོ།",
    "རྣམ་པར་གཟིགས་ཞེས་བྱ་བ་ནི་བྱེ་བྲག་ཏུ་གཟིགས་པ་ན་རྣམ་པར་གཟིགས་སོ།",
    "འཇིག་རྟེན་མགོན་ཁྱོད་ཅེས་བྱ་བ་ནི།",
    "མིང་གི་སྒོ་ནས་འདི་སྐད་བཏགས་ཆོཔ་ཡིན་ནོ།",
    "འཇིག་རྟེན་པ་འགའ་ཞིག་ཡི་གེ་འགའ་ཞིག་འདོད་པ་དེ་དག་གི་ནང་ན་མཆོག་ཡིན་པས་ན་མཛེས་པའོ།",
    "ཡི་གེ་དེ་དག་གི་ཡི་གེ་ནི་ལོངས་སྤྱོད་རྫོགས་པའི་སྐུས་རྟག་ཏུ་གནས་པའི་ཕྱིར་རོ།",
    "ནམ་མཁའི་ཁམས་ཀྱང་ཕྱག་གིས་ཁྱབ་པའོ།",
    "ངན་སོང་དུ་སོང་བ་དང་།",
    "རྣམ་པར་སྣང་མཛད་ཆེན་པོའི་གཟུགས་ཀྱིས་ཐམས་ཅད་དུ་སོང་བས་ན།",
    "གཙུག་གི་མཆོག་ཅེས་བྱ་བ་ནི་པདྨའི་རིགས་ཀྱི་ལྷ་རྣམས་ཀྱི་གཟུགས་ཀྱི་སྤྱི་གཙུག་ན།",
    "གཙུག་གི་མཆོག་གོ།",
    "གཟིགས་པ་ཆེན་པོ་ཞེས་བྱ་བ་ནི།",
    "ཤེས་རབ་ཀྱི་སྤྱན་གྱིས་ངོ་བོ་ལ་གཟིགས་པ་ཆེན་པོ་འདི་ལ་མངའ་བས་ན་གཟིགས་པ་ཆེན་པོའོ་༡།",
    "ཁྱོད་ཀྱི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་རྣམས་ནི་ཁྱོད་ཀྱི་མཚན་བརྒྱ་རྩ་བརྒྱད་པ་ཡང་དག་པར་བརྗོད་པའོ།",
    "རང་གི་རིགས་ནི་བསྐྱེད་ནས་ཀྱང་།",
    "ངག་གི་ལས་ཀྱི་ལམ་རྣམ་པ་བཞི་དང་བྲལ་བས་ན་ངག་ཐུབ་པའོ་༡།",
    "རྡོ་རྗེ་པདྨོ་དེ་རང་གི་ཐུགས་ཀར་བཞག་སྟེ།",
    "དེ་ནས་རང་གི་ཐུགས་ཀའི་ཕྱོགས་སུ་ཕྱག་གཡོན་པ་བརྐྱང་༥བའི་ཚུལ་གྱིས་བཟུང་ནས་གནས་པ་ལ།",
    "གང་གི་ཕྱིར་དྲི་མ་ཐམས་ཅད་དང་བྲལ་བས་ན་དག་པའི་ཐ་ཚིག་གོ།",
    "རྡོ་རྗེ་པདྨོ་འདི་དག་གི།",
    "ཕ་ཡིན་བདག་གི་བུ་ཡང་ཡིན།",
    "རིགས་འདི་ནི་ཞེས་བྱ་བ་ནི་རང་གི་ཐུགས་ཀར་བཞག་པ་གང་ཡིན་པ་འདིའོ།",
    "འདི་ལྟར་བཅོམ་ལྡན་འདས་ཁྱེད་ཀྱི་༤ཐུགས་ལ་རྡོ་རྗེ་འཆང་ཆེན་པོའི་༥གཟུགས་ཀྱིས་པདྨའི་རིགས་སུ་རྣམ་པར་གནས་པ་གང་ཡིན་པ་དེ་བདག་ཅག་གི་རིགས་ཀྱི་ནུས་པ་བསྐྱེད་པའི་ཕྱིར།",
    "དེའི་ཕྱིར་རང་གི་རིགས་འདི་བྱིན་གྱིས་བརླབ་པར་མཛོད་ཅེས་བྱ་བ་ཡིན་ནོ།",
    "གཟུང་བ་དང་འཛིན་པའི་རྣམ་པར་རྟོག་པ་ཐམས་ཅད་ལས་འཕགས་ཤིང་རིང་དུ་སོང་བས་ན་འཕགས་པའོ།",
    "རང་གི་རིགས་ལ་གཟིགས་པས་ན་སྦྱན་རས་གཟིགས་སོ།",
    "ལས་དང་ཉོན་མོངས་པ་བག་ཆགས་དང་བཅས་པ་སྤངས་སུ་ཟིན་ཀྱང་ལྷ་ཆེན་པོ་ལ་སོགས་པ་ལྷའི་གཟུགས་སུ་ཡང་འགྱུར་བ་འདི་ནི་ངོ་མཚར་བའོ།",
    "རང་གི་རིགས་ཀྱི་དཀྱིལ་འཁོར་སྤྲུལ་པའི་ཕྱིར།",
    "ཞེས་བྱ་བ་ནི་ཕྱིའི་དཀྱིལ་འཁོར་དེ་ཉིད་ཀྱི་ནང་དུ་ནང་གི་སྲད་བུ་གྲུ་བཞི་པར་དེ་ལྟར་བྲི་བར་བྱའོ།",
    "འབྱེན་པ་ནི་རང་གི་གཟུགས་ཀྱི་སྤྱི་གཙུག་ལ་སོགས་པའི་གནས་རྣམས་ནསསྣ།",
    "སེམས་དཔའ་ཆེན་པོ་སྙོམས་ཞུགས་པའི་ཏིང་ངེ་འཛིན་མཆོག་གི་ཕྱག་རྒྱས་བཞུགས་པ་ནི།",
    "ཞེས་བསྒོམས་ལ་ནང་གི་བདག་ཉིད་ཅན་གྱིས་ཁྲུས་བྱས་ཏེ།",
    "འདི་ལྟར་ཤར་ཕྱོགས་ནས་རྡོ་རྗེ་ཐལ་མོ་བརྐྱང་ལ་ལུས་ཐམས་ཅད་ཕབ་སྟེ།",
    "དཔྲལ་བ་ས་ལ་རེག་པར་བྱས་ལ།",
    "ཇི་ལྟ་བའི་རྡོ་རྗེ་ཐལ་མོ་སྤྱི་བོར་བཞག་སྟེ་ཁ་ས་ལ་རེག་པ་དང་ས།",
    "དེ་ནས་བྱང་ཕྱོགས་ནས་དེ་བཞིན་དུ་གནས་པ་ལས་རྡོ་རྗེ་ཐལ་མོ་སྤྱི་བོ་ནས་མཕབ་སྟེ།",
    "པུས་མོ་གཡས་པའི་ལྷ་ང་ས་ལ་བཙུགས་མུཏེ།",
    "བདག་མིང་རྡོ་རྗེ་ཆེ་གེ་མོ་ཞེས་བྱ་བ།",
    "འཕགས་པ་ཉན་ཐོས་ཡང་དག་པར་སོང་བ་རྣམས་དང་།",
    "གང་ཡང་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་ཐམས་ཅད་ན་༥ལྷ་དང་མི་རྣམས་ཀྱི་མེ་ཏོག་གི་བྱེ་བྲག།",
    "ཐལ་མོ་ཁོང་སྟོང་དུ་སྦྱར་བ་བཅིངས་ལ།",
    "དེ་ནས་སྒེག་མོའི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "མེ་ཏོག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་འདི་སྐད་ཅེས་བརྗོད་པར་བྱ་སྟེ་༥།",
    "ཉོན་མོངས་པ་དང་།",
    "བདག་ཉིད་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་ཁམས་མ་ལུས་པའི་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་ཞབས་ཀྱི་༦དྲུང་དུ་ཕྱིན་པར་ལྷག་པར་མོས་པར་བྱས་ལ།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "བདག་གིས་བརྟན་པོར་གཟུང་བར་བགྱི།",
    "དམ་པ་བདག་གིས་བསྐྱེད་བགྱིས་༥ནས།",
    "བདག་གིས་སྡོམ་པ་མ་ལུས་གཟུང་།",
    "དེ་ནས་བཛྲ་ཨཉྩ་ཛྭལི་ཞེས་བྱ་བས་རྡོ་རྗེ་ཐལ་མོ་བཅིང་བར་བྱའོ།",
    "ཞེས་བྱ་བས་རྡོ་རྗེ་འབེེབས་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཞེས་བྱ་བས་རྡོ་རྗེ་དབྱིངས་ལས་གསུངས་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "མཛུབ་མོ་གཉིས་ནི་བཅིངས་ནས་ཀྱང་།",
    "ཞེས་བྱ་བའི་ཕྱག་རྒྱས་ངན་སོང་རྣམས།",
    "བརྙ་ཎི་པྲ་མོ་ཀྵ་ཡ།",
    "གུང་མོ་གཉིས་ཀ་སྦྱར་ནས་ནི།",
    "ཐ་མ་བཞི་ཡི་རྩེ་མོ་སྦྱར།",
    "པདྨ་འབེབས་པའི་མཐར་ཐུག་པ་རྣམས་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།་",
    "དེ་ནས་སྙེང་པོ་དེ་ཉིད་དབྱངས་ཡིག་བཅུ་དྲུག་དང་བཅས་པའི་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་རྣམ་པར་རང་གི་སེམས་བསམ་པར་བྱའོ།",
    "ཀྵའི་མཐར་ཐུག་པ་དང་བཅས་པ་ལས་ཟླ་བའི་དཀྱིལ་འཁོར་གཉིས་པར་བསམ་མོ།",
    "རང་གི་ལུས་ལ་ལྷ་ཐམས་ཅད་ཀྱི་གནས་རྣམས་སུ་ཡི་གེ་ཏྲཱི་མེལས་པདྨའི་གདན་བསྐྱེད་ལ།",
    "ཡིད་ཀྱིས་རང་གི་ལུས་ཀྱི་གནས་སུ་འདུག་ལ།",
    "རང་གི་ལུས་ལས་ཕྱི་རོལ་གྱི་མདུན་དུ།",
    "བཅོམ་ལྡན་འདས་ཀྱི་༩དམ་ཚིག་གི་ཕྱག་རྒྱས་བཅོམ་ལྡན་འདས་ལ་བལྟས་ཏེ།",
    "ཞེས་ཁུབརྗོད་པ་དེ་ཉིད་ཀྱིས་རང་གི་ལུས་ཀྱི་གནས་སུ་གནས་པ་༧ལ་གཞུག་པར་བྱའོ།",
    "དེ་བཞིན་དུ་རྡོ་རྗེ་འབེབས་པའི་བར་གྱི་ཕྱག་རྒྱ་ཆེན་པོ་བཅིངས་ལ་ཡིད་ཀྱིས་རང་གི་ལུས་ཀྱི་གནས་སུ་འདུག་སྟེ།",
    "རང་གི་ལུས་ལས་ཕྱི་རོལ་གྱི་མདུན་དུ་པདྨ་འབེེབས་པའི་ཡི་གེ་ཨའི་མཐའ་ཅན་གྱི་སྔགས་ཀྱིས་ཟླ་བའི་དཀྱིལ་འཁོར་གྱི་སྟེང་དུ་པདྨའི་དྲིལ་བུ་བསྐྱེད་ལ་པདྨོ་གྷཥྚ།",
    "རང་གི་དམ་ཚིག་གི་ཕྱག་རྒྱས་བལྟས་ལ།",
    "དེ་ནས་དམ་ཚིག་གི་ཕྱག་རྒྱ་དེ་ཉིད་དང་།",
    "ཛ་ཧཱུཾ་བཾ་ཧོ་ཞེས་བརྗོད་པས་རང་གི་ལུས་ལ་བཅུག་ལ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་གཞུག་ཅིང་བསྒྲུབ་པར་བྱའོ།",
    "དམ་ཚིག་གི་ནི་ཕྱག་རྒྱ་ཆེ།",
    "ཞེས་བྱ་བས་གཟུགས་བརྙན་དང་མཚུངས་པའི་སྟོང་པ་ཉིད་ཀྱི་རང་བཞིན་དུ་མོས་པ་དང་།",
    "ཨོཾ་སརྦ་ས་མོ་ཧཾ་ཞེས་བྱ་བས་བདག་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་སུ་བསྐྱེད་པར་བྱའོ།",
    "ཉིན་རེ་ཞིང་རྣལ་འབྱོར་ཆེན་པོ་ལན་རེ་བསྒྲུབ་པར་བྱའོ།",
    "ཉིན་རེ་ཞིང་ཐུན་བཞིའི་སྤྱོར་བ་ཟླ་བ་གཅིག་གམ།",
    "དཀྱིལ་འཁོར་གྱི་སའི་དབུས་སུ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་འདུག་སྟེ་བདག་ཉིད་སྤྲོ་བ་བསྐྱེད་པར་བྱའོ།་།",
    "བདག་གི་གསོན་པའང་འབྲས་བུར་བཅས།",
    "ལྷ་དང་དམ་ཚིག་གིས་མཉམ་པར།",
    "བདག་གི་མཆོག་སྦྱིན་བླ་ན་མེད།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་ཀྱི་༤མཛུབ་མོ་དང་མཐེ་བོ་གཉིས་རྡོ་རྗེར་བྱས་ལ།",
    "དེ་ནས་ལག་པ་གཡས་པའི་མཐེ་བོས་རང་གི་མཐེ་ཆུང་གི་སེན་མོ་མནན་ལ།",
    "སོར་མོ་ལྷག་མ་རྣམས་རྩེ་གསུམ་པ་ལྟར་བྱས་ལ་གཡོན་པའི་རྡོ་རྗེ་ཁུ་ཚུར་གྱིས་རྡོ་རྗེ་རྩེ་ལྔ་པ་བླངས་ཏེ།",
    "དེ་ལ་རྡོ་རྗེ་སྟེ་མོ་ལ་སོགས་པའི་ཕྱག་རྒྱ་དང་སྔགས་ནི་འདི་ཡིན་ཏེ།",
    "ཨོཾ་བཛྲ་ཤི་ཁ་རེ་རུ་ཊ་མ་ཊ།",
    "རྡོ་རྗེ་རྩེ་མོའི་སྔགས་སོ།",
    "བཛྲ་པུཥྤེ་ཧཱུཾ་ཞེས་བྱ་བ་མེ་ཏོག་གི་སྔགས་སོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་རི་བོ་འདེགས་པའི་ཚུལ་དུ་བྱེད་པ་ནི་རྡོ་རྗེ་རྩེ་མོའི་འོ།",
    "རྡོ་རྗེ་བསྡམས་པ་ནང་དུ་བཅིངས་ལ་སོར་མོ་འབར་བ་ལྟ་བུ་ལས་མཐེ་བོ་གཉིས་རྡོ་རྗེར་བསྒྲེང་བ་ནི་རྡོ་རྗེ་ཁྲོ་བོ་ཏི་རཱིརྙི་སྲེ་རིའི་ཕྱག་རྒྱ་ཞེས་བྱ་བ་འདི་རྡོ་རྗེ་མེའི་ཕྱག་རྒྱ་ཡིན་ནོ།",
    "རྡོ་རྗེ་ཁུ་ཚུར་གཉིས་བཅིངས་ལ་གྱེན་དུ་འཐོར་བའི་ཚུལ་དུ་བྱེད་པ་ནི་མེ་ཏོག་གི་ཕྱག་རྒྱའོ།",
    "ཨོཾ་ཧཱུཾ་དྷཱི་ཧོ་རི་༡ཞེས་བྱ་བ་མེ་ཏོག་གི་རྡོ་རྗེ་ཐལ་མོ་བཅིངས་ལ།",
    "མཐེ་བོ་གཉིས་བརྐྱང་སྟེ་ཐལ་མོ་འབྱེད་པའི་ཚུལ་གྱིས་ཡོན་ཆབ་ལ་སྔགས་ལན་བདུན་ནམ་ཉི་ཤུ་རྩ་གབྱུག་ཏུ་བཟླས་ལ་གཞག་པར་བྱའོ།",
    "དེ་ནས་དཀྱིལ་འཁོར་གྱི་གནས་ཐམས་ཅད་རྡོ་རྗེ་རྩེ་མོ་ཡོངས་སུ་བཟླས་པའི་དྲི་ཆུ་དང་།",
    "རང་རང་གི་སྔགས་ཀྱིས་གཞག་པར་བྱའོ།",
    "བསྐལ་པ་བཟང་པོ་པ་རྣམས་ཀྱང་རང་གི་གནས་རྣམས་སུ།",
    "མ་ཧཱ་ན་ཡ་པ་རི་བཱ་རེ་སྭཱ་ཧཱ།",
    "མཆོད་ཡོན་གྱི་སྔགས་དང་རེ་རེ་ཞིང་མཆོད་ཡོན་ཕུལ་ལ།",
    "དེ་ལ་དང་པོར་རེ་ཞིག་ཚོན་རྩི་སྔོན་པོ་དང་སེར་པོ་དང་།",
    "མིག་གི་རྫི་མ་འདྲེན་པ་ནི།",
    "དེ་ནས་རང་གི་ས་བོན་གྱི་འོད་ཀྱིས་བསྐུལ་བའི་མི་བསྐྱོད་པ་ལ་སོགས་པའི་དེ་བཞིན་གཤེགས་པས་བཏང་བའི་སྲད་བུ་འབར་བའི་ལྕགས་ཀྱུས་བཀུག་སྟེ།",
    "རང་གི་ལག་ན་གནས་པའི་སྲད་བུ་དེ་གང་བར་བྱས་ལ།",
    "རྡོ་རྗེ་གནོད་སྦྱིན་བཟླས་པའི་དྲིས་དཀྱིལ་འཁོར་གྱི་ས་གཞི་ཡང་བྱུགས་ལ་མེ་ཏོག་གིས་མཛེས་པར་བྱས་ནས་བར་སྣང་ན་བཞུགས་པའི་ལྷ་ཐམས་ཅད་ལ་ཕྱག་བྱས་ཏེ།",
    "སྒེག་མོ་ལ་སོགས་པས་ཡང་དག་པར་མཆོད་ལ།",
    "དེ་ཉིད་དུ་འདུག་སྟེ་ཤར་དུ་བལྟས་ནས་བྱང་གི་ཕྱོགས་ཀྱི་ཐིག་གདབ་བོ།",
    "དེ་ལ་རེ་ཞིག་སྲད་བུའི་སྔགས་ནི།",
    "སློབ་དཔོན་དང་བསྒྲུབ་པའི་གྲོགས་མཆོག་བསྒྱིངས་ཛྭཔའི་ཚུལ་གྱིས་བསྐོར་ཕྱོགས་སུ་འགྲོ་བར་བྱ་བ་ནི་ཐིག་གི་ཆོ་གའོ།",
    "ཨོཾ་བཛྲ་ཙི་ཏྲ་ས་མ་ཡ་ཧཱུཾ་ཞེས་བྱ་བ་འདི་ཕྱག་རྒྱ་དང་ལྡན་པས་རེ་རེ་ལ་ཡང་ལན་བདུན་བདུན་བཟླ་བར་བྱའོ།",
    "མཛུབ་མོའི་རྩེ་མོ་མཉམ་སྦྱར་བ།",
    "ནང་གི་དཀྱིལ་འཁོར་ནི་ཟུར་བཞི་བསྣོལ་བའི་རི་མོ་གཉིས་པ་བྲིས་ལ།",
    "ཟླ་བའི་གདན་ལ་སེམས་དཔའི་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ་བྲི་བར་བྱའོ།",
    "ཞལ་དང་པོ་ཤར་དུ་གཟིགས་པའོ།",
    "རྡོ་རྗེ་རིན་ཆེན་མའི་གནས་སུ་ཡིད་བཞིན་གྱི་ནོར་བུའི་རྩེ་མོ་པདྨ་ཅན།",
    "ཕྱག་གཡས་པ་ཏིང་ངེ་འཛིན་མཆོག་གིས་བཞུགས་པ།",
    "གཉིས་པ་གཉིས་ནི་མེ་ཏོག་གི་ཐལ་མོ་མཛད་པ།",
    "པདྨའི་རྒྱུ་ཁྱབ་འཇུག་གི་གཟུགས་ཅན།",
    "སྟག་གི་པགས་པའི་ཤམ་ཐབས་ཅན་སྦྲུལ་ནག་པོའི་མཆོད་ཕྱིར་ཐོགས་འཆང་བ།",
    "ཕྱག་གཡོན་པས་པདྨའི་མེ་ཏོག་གི་སྒོད་བསྣམས་པ།",
    "དོན་ཡོད་པའི་ཞགས་པ་ནི་ཕྱུགས་བདག་གི་གཟུགས་ཅན་སྤྱན་གསུམ་པ།",
    "ཏིང་ངེ་འཛིན་པདྨའི་རྡོ་རྗེ་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པའོ།",
    "པདྨའི་ཏིང་ངེ་འཛིན་ནི་ཞི་བའི་གཟིགས་པའོ།",
    "རྡོ་རྗེ་གར་བྱས་ལ་བླངས་ནས་རང་གི་མགོ་ལ་བཅིང་བར་བྱའོ།",
    "རྡོ་རྗེ་མཛུབ་མོ་གཉིས་ལེགས་པར།",
    "རྣམ་པར་སྣང་མཛད་ལ་སོགས་པའི་བུམ་པ་ཡང་སོ་སོ་རང་རང་གི་མཚན་མས་མཚན་པ།",
    "དེ་རྣམས་ཀྱི་རང་རང་གི་སྔགས་བརྒྱ་རྩ་བརྒྱད་ཡོངས་སུ་བཟླས་ལ་དཀྱིལ་འཁོར་གྱི་ཕྱི་རོལ་གྱི་ཁྱམས་རྣམས་སུ་གཞག་པ་དང་།",
    "དབབ་པ་ལ་སོགས་པའི་སྔོན་དུ་སོང་བའོ།",
    "རྡོ་རྗེ་དམ་ཚིག་གི་་བྱེཕྱག་རྒྱ་བཅིངས་ལ་ཇི་ལྟ་བ་བཞིན་དུ་བཞུགས་ཏེ་ཞེས་བྱ་བ་ནི་གདོང་གཡོགས་བཅིངས་ལ།",
    "རྡོ་རྗེ་པདྨའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་གཉིས་སུ་བྱས་ནས།",
    "ཐལ་མོ་སྦྱར་ནས་ལན་བརྒྱའི་བར་དུ་བཟླས་པར་བྱའོ།",
    "རྒྱའི་གུང་མོ་ལན་བརྒྱའི་བར་དུ་དྲལ་ཞིང་ཨ་ཞེས་བརྗོད་དོ།",
    "འོག་གི་ཆའི་འདབ་མ་བརྒྱད་ཁ་གྱེས་པ།",
    "སྟེང་གི་ཆའི་ཅུང་ཟད་ཁ་མ་༡བྱེ་བར་གྱུར་པའི་པདྨའི་དབྱིབས་དང་།",
    "རང་གི་པདྨོའི་མིང་ནས་བརྗོད་ལ་ཞེས་བྱ་བ་ནི།",
    "གཞན་གང་ཡང་རུང་བ་ཇི་ལྟར་ཐོབ་པ་རང་གི་པདྨའི་མིང་གྲགས་པས་ན་བརྗོད་པར་བྱའོ།",
    "པདྨའི་ཁུ་ཚུར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱས་སྒོ་བཅད་༧ལ།",
    "པདྨའི་བསྲུང་བའི་དམ་ཚིག་གི་ཕྱག་རྒྱས་བསྲུང་བ་ཐམས་ཅད་ཡང་དག་པར་བསྲུངས་ཏེ།",
    "རྡོ་རྗེ་རིགས་ཀྱི་ཕྱག་རྒྱ་རྣམས་ལ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཞེས་བྱ་ལ།",
    "ཇི་ལྟར་རྡོ་རྗེ་དབྱིངས་ཀྱི་དཀྱིལ་འཁོར་ཆེན་པོར་དམ་ཚིག་གི་གྱེ་ཕྱག་རྒྱ་དང་།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "དེ་ནས་མེ་ཏོག་དོར་ལ་རང་གི་སྤྱི་བོར་བསྦུངས་ཏེ།",
    "ཨོཾ་པྲ་ཝ་ར་སཊྭཱ་རེ་པྲ་ཏཱིཙྪ་སྭཱ་ཧཱ།",
    "གཡས་པའི་ཁུ་ཚུར་གྱིས་སོར་མོ་ཐམས་ཅད་བསྐུམ་ལ་མཛུབ་མོ་དང་མཐེ་བོ་གཉིས་བསྐུམ་པ་ལྟར་བྱས་ནས་མེ་ཏོག་བླངས་ཏེ།",
    "འབུལ་བའི་ཚེ་ཧཱུཾ་སོར་མོ་དེ་རྣམས་བརྐྱང་བར་བྱ་སྟེ།",
    "དེ་ནས་རྣམ་པར་སྣང་མཛད་ཀྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "ཨ་ཧཾ་བུདྷེ་ཧཱུཾ་ཞེས་བྱ་བ་ལན་གསུམ་བརྗོད་ལ་རྣམ་པར་སྣང་མཛད་བསྒྲུབ་པར་བྱའོ།",
    "དེ་བཞིན་དུ་བསྐལ་པ་བཟང་པོའི་མཐར་ཐུག་པའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ།",
    "པདྨ་འབེེབས་པའི་བར་གྱི་དམ་ཚིག་གི་ཕྱག་རྒྱ་འཆད་པར་འགྱུར་བ་དང་།",
    "བྱམས་པ་ལ་སོགས་པ་བསྐལ་པ་བཟང་པོ་པ་རྣམས་ཀྱི་གཡོན་པ་དེ་བཞིན་གཤེགས་པའི་ཁུ་ཚུར་བཀན་ལ་གཡས་པའི་མཛུབ་མོ་དང་མཐེ་བོང་གཉིས་ཀྱིས་༡མཐེའུ་ཆུང་ནས་བརྩམས་ཏེ་ཕྱེ་ལ།",
    "ཐལ་མོ་ཁོང་སྟོང་དུ་བྱས་པ་ནི་དམ་ཚིག་གི་ཕྱག་རྒྱའོ།",
    "དེ་ལྟར་དམ་ཚིག་གི་ཕྱག་རྒྱ་རྣམས་ཀྱིས་རྣམ་པར་སྣང་མཛད་ལ་སོགས་པ་བསྒྲུབས་ནས།",
    "བླ་རེ་སྣ་ཚོགས་པ་ལ་ཡང་པདྨ་གནོད་སྤྱིན་དང་།",
    "དེ་ནས་མེ་ཏོག་གི་ཤིང་བརྒྱའམ་བཞིའམ་མེ་ཏོག་གི་ཤིང་རྣམས་ལ་མེ་ཏོག་གི་རིག་པ་དང་།",
    "རོལ་མོའི་ཆ་བྱད་ཐམས་ཅད་ལ་རོལ་མོའི་རིག་པ་རྣམས་དང་།",
    "བ་གླང་གི་ཁྱུ་ཤིན་ཏུ་བརྟགས་པ་རྣམས་ཀྱང་དབུལ་བར་བྱའོ།",
    "བཛྲ་སྤ་ར་ཎ་ཁཾ་དེ་ནས་པདྨོའི་སྒེག་མོ་ལ་སོགས་པ་རྣམ་པ་བརྒྱད་ཀྱིས་མཆོད་ལ།",
    "དམ་ཚིག་སྐད་ཅིག་གིས་འགྲུབ་འགྱུར།",
    "ཇི་ལྟར་པདྨ་ཁ་དོག་དམར་པོ་འདི་ཁྱོད་ཀྱིས་ཟུང་ཤིགཁྱེ།",
    "དགེ་སྦྱོང་དང་དགེ་སློང་གི་སྡོམ་པ་ཡོངས་སུ་བླངས་པ།",
    "དགའ་ཆེན་ཁྱོད་བདག་སྟོན་པ་པས།",
    "སློབ་དཔོན་ཁྱོད་ནི་དགོངས་སུ་གསོལ།",
    "བདག་ཉིད་ཆེན་པོར་ཁྱོད་འདོད་དམ།",
    "བློ་ཆེན་ཁྱོད་ཀྱིས་གཟུང་བར་གྱིས།",
    "ཉིན་དང་མཚན་མོ་ལན་གསུམ་དུ།",
    "ཉིན་དང་མཚན་མོ་ལན་གསུམ་དུ།",
    "ཉིན་རེ་ཞིང་ནི་བཟླ་བར་བྱ།",
    "ཁྱོད་ཀྱིས་སྲོག་ཆགས་བསད་མི་བྱ།",
    "ངག་གི་རྣམ་པ་བཞི་རྣམས་དང་།",
    "ཁྱོད་ཀྱིས་བརྙས་པར་མི་བྱ་ཞིང་།",
    "ཁྱོད་ཀྱིས་ཀྱང་ནི་རྟག་ཏུ་བསྲུངས།",
    "དམ་པ་བདག་གིས་བསྐྱེད་པར་བགྱི།",
    "དེང་ཁྱོད་ཅེས་བྱ་བ་ལ་སོགས་པ་བརྗོད་པར་མི་བྱ་སྟེ།",
    "དམ་པ་བདག་གིས་བསྐྱེད་ནས་སུ།",
    "དེ་ལ་དང་པོ་རེ་ཞིག་སློབ་དཔོན་གྱིས།",
    "ཡང་ནུབ་ཕྱོགས་ཀྱི་སྒོར་བཅུག་ལ་པདྨའི་ལྕགས་སྒྲོག་གི་ལས་ཀྱི་ཕྱག་རྒྱས་བཅིང་བར་བྱའོ།",
    "དེང་ཁྱོད་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་ཀྱི་པདྨའི་རིགས་སུ་ཞུགས་ཀྱིས།",
    "ངས་ཁྱོད་ལ་ཡེ་ཤེས་གང་གིས་དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་གྲུབ་པ་ཡང་ཐོབ་ན།",
    "ཁྱོད་ཀྱིས་དཀྱིལ་འཁོར་ཆེན་པོ་མ་མཐོང་བ་རྣམས་ལ་སྨྲ་བར་མ་བྱེད་ཅིག།",
    "ཁྱོད་དམ་ཚིག་ཉམས་པར་གྱུར་ཏ་རེ།",
    "དེ་ནས་སློབ་དཔོན་རང་ཉིད་ཀྱིས་རྡོ་རྗེ་པདྨའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་ཁ་ཐུར་དུ་བསྟན་པ་དང་།",
    "འདི་ནི་ཁྱོད་ཀྱི་རྡོ་རྗེ་དམ་ཚིག་ཡིན་གྱིས་༧།",
    "པདྨའི་སེམས་དཔའ་དེང་ཁྱོད་ཀྱི།",
    "དེང་ནས་བརྩམས་ཏེ་ཁྱོད་ཀྱིས་ཕྱེཕྱག་ན་པདྨོ་ང་ཡིན་གྱིས།",
    "ཁྱོད་ཀྱིས་ང་ལ་བརྙས་པར་མ་བྱེད་ཅིག།",
    "དེ་ནས་མྱུར་དུ་སློབ་དཔོན་གྱིས་རྡོ་རྗེ་པདྨའི་དམ་ཚིག་གི་ཕྱག་རྒྱ་བཅིངས་ལ་འདི་སྐད་ཅེས་བརྗོད་དུ་གཞུག་གོ།",
    "དམ་ཚིག་གི་ཕྱག་རྒྱ་དྲལ་བར་བྱ་ཞིང་།",
    "གང་གི་ཚེ་དེ་ལྟར་བབས་པས་པདྨ།",
    "གང་གི་ཚེ་པདྨ་རྒྱལ་པོའི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་པདྨ་ཆགས་པའི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་པདྨ་ལེགས་པའི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་པདྨ་ཁྲོ་གཉེར་གྱི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་པདྨ་ཉི་མའི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་པདྨ་རྒྱལ་མཚན་གྱི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "གང་གི་ཚེ་པདྨ་བཞད་པའི་ཕྱག་རྒྱ་འཆིང་བ་དེའི་ཚེ།",
    "པདྨའི་སེམས་དཔའ་དེང་ཁྱོད་ཀྱིས།",
    "དེ་ནས་གང་ལ་མེ་ཏོག་བབས་པའི་ལྷ་དེ་སྐུ་དམ་ཚིག་གི་ཕྱག་རྒྱས་དེ་སྤྲུལ་ལཛོ།",
    "སྒེག་མོ་ལ་སོགས་པ་རྣམས་ཀྱིས་ཡང་དག་པར་མཆོད་ལ།",
    "རྡོ་རྗེ་ཐལ་མོ་བསྡམས་ནས་ཀྱང་།",
    "གུང་མོ་རྡོ་རྗེ་མཉམ་སྦྱར་བ།",
    "དེ་རིང་ཁྱོད་ལ་བསྐུར་བར་བྱ།",
    "རྡོ་རྗེ་འདི་ནི་ཁྱོད་ཀྱིས་ལོང་།",
    "དེའི་སྟེང་དུ་བླ་རེ་བྱེ་བ་དང་།",
    "སྲིང་མོ་བཞི་དང་བཅས་པ་དགོད་པར་བྱའོ།",
    "དཔལ་མཆོག་དང་པོ་ལས་གསུངས་པའི་རོལ་མོ་བརྒྱ་ཕྲག་སྙེད་ལས་དུང་དང་།",
