    "ཉིན་པར་ནི་སྟག་གི་པགས་པ་གོན་པའོ།",
    "དཔའ་བོ་ནི་ཤུ་རྩ་བཞི་དཔའ་མོ་དེ་དག་དང་ལྷན་ཅིག་གི་ཆ་གཉིས་དང་ལྡནཔ་ཞེས་བྱ་བའི་དོན།",
    "སྟག་གི་པགས་པ་བགོ་བར་བྱའོ།",
    "གདོང་བ་ཚམ་ངམ་ནི་གདོང་གི་འགྱུར་བའོ།",
    "ཞི་བ་འདུས་པལ་གནས་པ་དེར་གཅིག་ཏུ་རེད་པར་འགྱུར་ཞེས་བྱ་པའི་དོན་ཏོ།",
    "དཔའ་བོ་དང་དཔའ་མོ་རྣམས་བླ་བརཐིམ་པར་གྱུར་ན།",
    "འོན་ཀྱང་ཡེ་ཤེས་གང་གིས་ཐོབ།",
    "བུ་དང་བུ་མོ་ནི་དཔའ་བོ་དང་དཔའམོ་རྣམས་སོ།",
    "དེ་དག་གི་གཟུགས་གཅིག་ནི་སྟུན་དང་བུ་རྣམས་ལྷན་ཅིག་གོ།",
    "སྦྱིན་སྲེག་གི་རྒྱུ་བསྟནནས།",
    "ཕོ་ཉ་ཞེ་བར་སྤྱོད་པ་ཡིན་ན་ཕོ་ཉ་མོ་ཡིན་པ་ལ་མི་སྤྱོད་དམ་སྙམ་ན།",
    "ཉེ་བར་ལོངས་སྤྱོད་པ་རེ་ཞིག་གཞན་ལ་བསྙེན་བཀུར་ཏེ་ད་ཀྱང་བྱ་བ་མིན་པར་བསྟན་ཏོ།",
    "ཆུང་མ་ཕོ་ཉ་མོ་ཉིད་གནས་ཞེས་བྱ་བ་ལ་སོགས་པ་སྨོས་པ་ལ།",
    "བུ་མོ་ནི་རང་གི་མན་ངག་བྱིན་པའོ།",
    "མཆོག་གི་ལྷན་ཅིག་འགུགས་པར་བྱེད།",
    "དེ་དག་གི་འཁོར་ལོ་ནི་ཟུར་གསུམ་གྱི་དཀྱིལ་ལ་ཁོའ་དེར་ནི་སྤྱིན་སྲེག་བྱའོ།",
    "སངས་རྒྱུས་ནི་ཉོན་མོངས་པ་ལྔ་སྟེ།",
    "རིགས་ལ་བརྟེན་པ་གཅིག་གི་མཐའ་ཅུན་དུ་བྱས་སོ།",
    "དེའི་རྗེས་སུ་སོང་བ་རྟོག་པ་གཞན་དག་སྨོས་ཀྱང་ཅི་ད་གེ་པ་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "སྦྱིན་སྲེག་གི་སྤྱོད་པའི་རྒྱུད་གཞན་གྱི་རྣལ་འབྱོར་པ་དག་གི་སྤྱོད་ཡུལ་མིན་ཞེས་བསྟན་པར་བྱ་བའི་ཕྱིར།",
    "ཡང་ན་ཡི་གེ་ཐམས་ཅད་ཀྱི་ངོ་བོ་དེའི་ཆོག་ནི་ཡི་གེ་གཅིག་གི་ཆོ་གའོ།",
    "ནང་གི་སྦྱིན་སྲེག་དང་ཡི་གེ་གཅིགཔུའི་ཆོགའི་ལེའུ་སྟེཉི་ཤུ་རྩ་བརྒྱད་པའོ།",
    "ནང་གི་སྦྱིན་སྲེག་བརྗོད་ནས།",
    "དེ་ལ་ནག་པོ་དང་དཀར་པོ་དང་ལྗང་གུ་ཞེས་བྱ་བའི་ཁ་དོག་གི་སྒོ་ནས།",
    "མང་པོ་ལྡན་པའི་ཕོ་ཉ་མོ།",
    "རྟག་པ་ནི་དགའང་རྨད་དུ་བྱུང་བའི་ཚཕོ་ཉམོལ་རྣལ་༣ བྱོར་མ་དང་མཁའ་འགྲོ་མའི་སྒྲ་བརྗོད་པ་ནི་དྲན་པ་དང་ལྡནནོ།",
    "དེ་རྣམས་ཀྱིནི་མཆོག་གི་མཆོག།",
    "ལྷ་མོ་བཅུ་གཉིས་ཕྲག་གཉིས་ཏེ།",
    "དཔའ་བོ་དང་དཔའ་མོཉི་ཤུ་རྩ་བཞིལས་གཞནམ་ཡིན་པའི་སྔགས་བཟླ་བར་བྱ་ཞེས་བསྟན་ཏེ།",
    "སྔགས་ནི་རང་གི་ས་བོན་ནོ།",
    "བཀོད་པ་ནི་ཡི་གེ་དང་ཕྱི་མོ་བཀྲམ་པའི།",
    "རྡོ་རྗེ་ཕག་མོ་དང་དཔའ་བོ་གཅིག་པུད་བདེ་མཆོག་ཉིད་གྱུར་ཞེས་བྱ་བའི་དོན་ཏོ།",
    "ཕྱི་མོ་ནི་ཨ་ལ་སོགས་པ་བཅུ་དྲུག་པ་དེ་དག་རྫ་རྔབཉིད་བ་ལ་སློབ་དཔོན་གྱིས་དགོད་པར་བྱའོ།",
    "རེའུ་མིག་གསུམ་པ་ནི་ཡི་གེ་ཡིདད་ཡང་དག་པར་ལྡན་པ།",
    "རེའུ་མིག་གསུམ་པར་ཕྱེ་ཞེས་བྱ་བ་ནི་ཡིགེ་མི་དང་ལྡན་པའོ།",
    "རེའུ་མིག་ཉི་ཤུ་རྩ་གཅིག་པ་ཞེས་བྱ་བ་ནི་ཡི་གེ་པའོ།",
    "རེའུ་མིག་དང་པོ་ནི་ཡི་གེ་ཧའོ།",
    "རེའུ་མིག་གཉིས་བའི་ས་བོན་ཞེས་བྱ་བ་ནི་དབྱངས་ཡིག་གཉིས་པའོ།",
    "ཡི་གེ་ཧཱུཾ་དང་ཕཊ་ཀྱི་ཚིག་གི་ཁྱད་པར་གང་ལ་ཡོད་པ་དེ་ལ་དེ་སྐད་ཅེས་བྱའོ།",
    "སྔགས་འདི་གང་གི་ཡིན་ཞེ་ན།",
    "འོད་ཟེར་འཕྲོ་བའི་འབརབས་འཁྲུག་པ་རང་གི་འོད་ཀྱི་རིག་པས་འཁྱུད་ཅིང་།",
    "དེ་དག་གིས་འདུས་པ་ནི་མ་ལུས་པ་མེད་པར་འགྲུབ་པར་འགྱུར་རོ་ རྒྱལ་སྲིད་ཐམས་རུད་ནི།",
    "དེ་དག་གི་བདགཔོ་ཉིད་ནི་རྒྱལ་སྲིད་ཐམས་ཅད་དོ།",
    "ཞེས་རེད་དུ་སོང་ཞིང་བཅོམ་ལྡན་འདས་དེ་ཉིད་ཁམས་གསུམ་རྣམ་པར་རྒྱལ་བའི་ཕྱག་རྒྱ་འཛད་པ།",
    "ཀྱེ་མ་གིན་ཏུ་སྐྱེད་པར་བྱེད་པའི་ཐོད་པ་མི་གཙང་ཞིངགཙང་མ་རྣམས་ཀྱིས།",
    "དཔའ་བོ་དག་གི་ཟླ་བ་རྒྱས་པའི་རྒྱན་ཞེས་བྱ་བ་ཡིན་གྱི།"
  ]
}