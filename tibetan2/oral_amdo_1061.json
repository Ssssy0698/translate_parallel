    "བདེན་པ་ཞེས་བྱ་བ་ལ་སོགས་པས་ནི་རྣལ་འབྱོར་མགཞན་ཁ་ཅིག་གིས་དེ་ལ་བུ་གརཔའི་སྒྲུབ་པ་པོས་མཐོང་ནས་བཞད་དོ།",
    "༢ཚན་མོ་ཞེས་པ་ནི་ཕྱི་རོལ་གྱི་ཡུལ་གྱི་རྣམ་པར་རྟོག་པའི་ངོ་ནུབ་པའི་རང་བཞིན་ནི།",
    "ཉིན་མོ་ནི་རང་རིག་པ་ཙམ་དེའི་དད་བཞིན་༧ན་ཅིག་སྐྱེས་པའོ།",
    "ཡི་གེ་བདུན་པའི་ནུས་པ་ནི་སྙིམ་པ་མེ་ཏོག་གིས་བཀང་སྟེ།",
    "དག་གི་དབད་ཕྱུག་ནི་གཟའ་ཕུར་བུའོ།",
    "སྐྱེ་ནི་རིའི་རྩེ་མོའོ།",
    "བདག་གི་ལུས་ལ་ཞེས་པ་ནི་མིག་དང་།",
    "འཆབས་བསྙེམ་ནི་འཆི་བས་བཅོམ་པ་སྟིའཆི་བའི་གམ་དུ་སོང་ཞེས་པའི་དོན་ཏོ།",
    "གསུམ་པ་དག་ཉིད་ཅེས་པ་ནི་ངག་གི་འདས་གྲུབ་པོ་ཞེས་དགོངས་སོ།",
    "དེ་ནས་ཞེས་པ་ནི་རྣལ་འབྱེརམ་དྲུགགི་སྔགས་ཀྱི་ལས་ཀྱི་ཚོགས་སྟོན་པར་རྩོམ་སྟེ།",
    "ཡང་དག་པརབྱེབྲག་ཏུ་བདག་གིས་བསྒྲུབ་བྱ་བསྒྲུབ་པ་གང་ཡིན་པ་དེའི་རྣལ་འབྱོར་མ་དྲུག་གི་སྔགས་སོ།",
    "ད་ནི་རྣལ་འབྱེལ་མ་དྲུག་གི་གོ་ཆའི་སྔགས་ཀྱི་ལུག་མ་ཡི་གེ་དྲུག་གི་བདག་ཉིད་ཀྱི་སྔགསནི་ལས་ཀྱི་ཚོགས་ཀྱི་ལེའུ་ནི་དེ་ནས་ཞེས་པ་ལ་སོགས་པ་གསུངས་སོ།",
    "དེ་ནས་ཞེས་པ་ནི་བྱེད་པ་དྲུག་གི་གོ་ཆའི་སྔགས་དང་།",
    "རྒྱུའོ་ཞེས་པ་ཐུན་མོང་གི་ལས་སོ།",
    "ཁྱད་པར་ནི་མེ་ཏོག་དག་གིས་ཤེས་གསུངས་ཏེ།",
    "རྣལ་འབྱོརམའི་རྣལ་འབྱེད་ཕྱག་རྒྱནི་སྐྱིལ་དཀྲུང་བཅས་ལ་དོགས་བཅིངས་པར་བྱས་ནས་གུང་མོ་གཉིས་ཀྱི་ཁ་དང་མཐེ་བོང་གཉིས་ཁ་སྦྱརནས་མཛུབ་མོ་གཉིས་གླེང་སྟེ།",
    "གཟུགས་བརྙན་དུ་གཏོགས་པ་བསྲེ་བཞིན་པ་ནི་དུར་ཁྲོད་དུ་བོར་བའི་བོལ་བའམཐལ་བལ་གདུང་བའི།",
    "གད་གི་ལས་ཞེས་པ་ནི་སྐྱེས་པའམ་བུད་མེད་དོ།",
    "བཟློག་སྟེ་རྣལ་འབྱོར་མདྲུག་གི་གོ་ཆ་ཕྱི་མའི་ཡི་གེའི་བསྔགས་སོ།",
    "དེའམ་ཞེས་པ་ནི་བུད་མེད་དོ།",
    "དག་གི་དངོས་གྲུབ་ཀྱི་སྦྱོར་བགཞན་ནི་ཀ་ར་བཱ་རའི་མེ་ཏོག་དམར་ཞེས་པ་ལ་སོགསཔ་གསུངས་ཏེ།",
    "ཆུ་ནི་ཞེས་པ་ནི་གང་ལ་མེ་ཏོག་དེ་སྒྲུབ་པའི་གྲོགས་ཀྱི་ཐལ་མོ་ཁ་སྦྱར་དུ་གནས་པར་གྱུར་པ་རང་གི་ལག་པ་གཉིས་སུ་བྱའོ།",
    "རྣལ་འབྱོར་མ་དྲུག་གི་གོ་ཆའི་སྔགས་ཀྱི་ཕྱི་མའི་ཡི་གེ་དྲུག་གི་བདག་ཉིད་ཀྱི་སྔགས་དེའི་ལས་དང་།",
    "རྣལ་འབྱོར་མ་དྲུག་གི་ལས་དེ་ཡང་ངག་གི་དངོས་གྲུབ་ཚིག་གྲུབ་པས་འགུགས་པ་དེ་བརྗོད་བ་གང་ཡིན་པའི་ལེའུ་ཡིན་པས་དེ་དེ་བཞིན་ནོ།",
    "དབྱངས་དྲུག་ངེགང་ཡིན་པའི་དཔའ་བོ་དྲུག་གི་གོ་ཆའི་སྔགས་བཏུ་བའི་ལྷག་མ་དབྱངས་ལྔ་ནི་ཧ་ར།",
    "སྦྱོར་བ་གཞནནི་རང་གི་ཁྲག་ནི་ཞེས་བྱ་བ་ལ་སོགས་པ་གསུངས་དོ།",
    "སེང་ལྡེང་གི་འདབ་མའམ་མེ་ལ་བསྒྲུབ་བྱའི་རྐང་པའི་ཚུལལག་པ་གཉིས་ཀྱིས་མཉེ་བ་ནི་ཡང་དག་པར་མཉེསོ་ནས་མིང་གཟུང་བ་སྔོན་བཞིན་དུ་འགྲོ་བས་དེ་ཉིད་ལུགས་ཀྱི་སྤྱིན་སྲེག་བྱསནོལ་ནས་ཁྲག་སྐྱགས་ཏེ་དགྲ་བོ་འཆི་བར་འགྱུར་རོ།",
    "སྦྱིན་སྲེག་གི་སྦྱོར་བ་ནི་བྱི་ལ་དང་ནི་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "ཤ་དེ་དག་གིས་མཁའ་འགྲོམ་རྣམས་ལ་གཏོར་མ་སྔོན་དུ་འགྲོབས་སྦྱིན་སྲེག་བྱའོ།",
    "ཡང་དག་སྦྱརཞེས་པ་ནི་འབུམ་ཕྲག་ལྔ་བཟླས་པའི་རྗེས་སུ་དེ་ནས་ལས་ལ་སྦྱོར་རེ་ཞེས་དགོངས་སོ།",
    "རྣལ་འབྱོར་མ་དྲུག་གི་གོ་ཆའི་སྔགས་ཀྱི་སྦྱོརབ་རྣམས་དང་དེཛོ་པག་མོའི་སྦྱོརབདང་གཞན་དུ་ཡང་དཔལ་ཧེ་རུ་ཀའི་རྣལ་འབྱོར་པས་ཧལྔའི་ལས་ལག་པ་མཉེ་བ་ལ་སོགས་པ་དེ་བརྗོད་པ་གང་ཡིན་པ་དེ་ཡིན་ལེའུ་ཡངཡིན་པསདོད་བཞིན་ནོ།",
    "གང་གི་ཕྱིར་དངོས་གྲུབཐམས་ཅད་ཀྱི་འབྲས་བུ་སྟེར་བར་རྒྱལ།",
    "ཨོཾ་སརྦ་བུདྡྷ་ཌཱ་ཀི་ཡེ་བཛྲ་ཝརཱ་ནཱི་ཡེ་ཧཱུྃ་ཕཊ་སྭཱཧཱ།",
    "གང་གི་ཕྱིར་སྔགས་འདིལསཐམས་ཅད་སྒྲུབ་པར་བྱེད་པའོ་ཞེས་པལ།",
    "དཔའ་བོ་རྣམས་ཤེས་པ་ནི་དཔའ་བོཟེད་པའི་དུམ་བུ་ལ་སོགས་པ་དང་བཅས་པའི་རྣལ་འབྱོར་མ་རབ་ཏུ་གཏུམ་མོ་ལ་སོབ།",
    "ཐོདཔའི་དུམབུདང་པོ་ཞེས་པ་ནི་དང་པོ་ནི་ཐོག་མར་རོ།",
    "དེ་ཡི་མོད་ལ་གྲུབ་པ་ནི།",
    "གིའུཝང་ཞེས་པ་ལ་སོགས་པ་གསུངས་ཏེ།",
    "དོ་དག་གི་གཟུགས།",
    "ཡི་གི་ས་བོན་དེ་ཉིད་ཀྱིས་འགུགས་པའོ།",
    "མཐོ་རིས་ཞེས་བྱ་བ་སོགས་པ་ནི་འཁོར་ལོ་གསུམ་མོ།",
    "གོས་ནི་སྟག་གི་པགས་པ་དད་གླུད་དེ་ཆུའི་པགས་པའོ།",
    "ཧཱགི་སྤྱི་བོའི་མ་ནི་འདིར་སྲོག་མེད་པར་གཟུང་བའོ།",
    "ཐབས་ཀྱི་ཁྱད་པརགང་གིས་དེའི་འབྲས་བུར་མི་འགྱུར་རོ།",
    "ཚིག་གི་དོན་ནོ།",
    "ཀློག་པ་ནི་ཐུན་མོང་དུ་སྤྲོ།",
    "དཔལ་ཉེ་དུ་ལ་སོགས་པའི་དཔའ་བོ་དང་དཔའ་མོ་རྣ་མ་ཞིག།",
    "དེའི་མིས་གིས་མཐོང་བར་དཀའ་བའོ།",
    "དཔལ་འཁོར་ལོ་སྡོམ་པའི་རྒྱུད་ཆེན་པོ་གང་གིས་ཤེས་པ་ནི་རྟོགས་པ་ཡདོ།",
    "སུམ་ཞེས་པ་ནི་ལྷན་ཅིག་གི་སྒྲའི་དོན་ཏེ་པ་སུམ་པའོ།",
